hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"5011","(۵۰۱۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ سَلْم بْنِ أَبِی الذَّیَّالِ ، عَنِ الْحَسَنِ ، قَالَ : یَقْتُلُہَا وَہُوَ یُصَلِّی ، قَالَ : وَقَالَ قَتَادَۃُ : إذَا لَمْ تَعْرِضْ لَکَ فَلاَ تَقْتُلْہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5011","","","كتاب الصلوات"
"5012","(۵۰۱۲) حَدَّثَنَا عَبَّادٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : اقْتُلْہَا وَأَنْتَ فِی الصَّلاَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5012","","","كتاب الصلوات"
"5013","(۵۰۱۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ قَالَ فِی الْعَقْرَبِ یَرَاہَا الرَّجُلُ فِی الصَّلاَۃ ، قَالَ : اصْرِفْہَا عَنْک ، قُلْتُ : فَإِنْ أَبَتْ ؟ قَالَ : اصْرِفْہَا عَنْک ، قُلْتُ : فَإِنْ أَبَتْ ؟ قَالَ : فَاقْتُلْہَا ، وَاغْسِلْ مَکَانَہَا الَّذِی قَتَلْتہَا فِیہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5013","","","كتاب الصلوات"
"5014","(۵۰۱۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ؛ أَنَّ مُوَرِّقًا قَتَلَہَا وَہُوَ یُصَلِّی۔","No Data Available","Musannaf Ibn Abi Shaybah 5014","","","كتاب الصلوات"
"5015","(۵۰۱۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ سُئِلَ عَنْ قَتْلِ الْعَقْرَبِ فِی الصَّلاَۃ ؟ فَقَالَ : إنَّ فِی الصَّلاَۃ لَشُغْلاً۔","No Data Available","Musannaf Ibn Abi Shaybah 5015","","","كتاب الصلوات"
"5016","(۵۰۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ تَمِیمِ بْنِ مَحْمُودٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ شِبْلٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُوَطِّنَ الرَّجُلُ الْمَکَانَ یُصَلِّی فِیہِ کَمَا یُوَطِّنُ الْبَعِیرُ۔","Da'if","Musannaf Ibn Abi Shaybah 5016","","","كتاب الصلوات"
"5017","(۵۰۱۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ لاَ یَتَّخِذُ فِی بَیْتِہِ مَکَانًا یُصَلِّی فِیہِ۔","Sahih","Musannaf Ibn Abi Shaybah 5017","","","كتاب الصلوات"
"5018","(۵۰۱۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُمَرَ بْنِ نَبِیہٍ ، عَنْ جُمْہَانَ ، قَالَ : رَأَیْتُ سَعْدًا جَائَ مِرَارًا وَالنَّاسُ فِی الصَّلاَۃ ، فَمَشَی بَیْنَ الصَّفِّ وَالْجِدَارِ حَتَّی انْتَہَی إلَی مُصَلاَّہُ ، وَکَانَ یُصَلِّی عِنْدَ الاسْطُوَانَۃِ الْخَامِسَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 5018","","","كتاب الصلوات"
"5019","(۵۰۱۹) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، قَالَ : رَأَیْتُ الْمِسْوَرَ بْنَ مَخْرَمَۃَ بَعْدَ مَا تُقَامُ الصَّلاَۃُ یَتَخَلَّلُ الصُّفُوفَ حَتَّی یَنْتَہِیَ إلَی الثَّانِی ، أَوِ الأَوَّلِ۔","Sahih","Musannaf Ibn Abi Shaybah 5019","","","كتاب الصلوات"
"5020","(۵۰۲۰) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ مُحَمَّدِ بْنِ صَالِحٍ التَّمَّارِ ، قَالَ : رَأَیْتُ الْقَاسِمَ بْنَ مُحَمَّدٍ یَلْزَمُ مُصَلًّی وَاحِدًا فِی الْمَسْجِدِ یُصَلِّی فِیہِ ، وَلاَ یُصَلِّی فِی غَیْرِہِ ، وَرَأَیْت سَعِیدَ بْنَ الْمُسَیَّبِ یَفْعَلُ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5020","","","كتاب الصلوات"
"5021","(۵۰۲۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ سُئِلَ عَنْ قَوْمٍ انْکَسَرَتْ بِہِمْ سَفِینَتُہُمْ ، فَأَدْرَکَتْہُمُ الصَّلاَۃ وَہُمْ فِی الْمَائِ ؟ قَالَ : یُومِئُونَ إِیمَائً ، فَإِنْ خَرَجُوا عُرَاۃً ؟ قَالَ : یُصَلُّونَ قُعُودًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5021","","","كتاب الصلوات"
"5022","(۵۰۲۲) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ وَاصِلٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ سَأَلَہُ عَنْ قَوْمٍ انْکَسَرَتْ بِہِمْ سَفِینَتُہُمْ ، فَخَرَجُوا ، فَحَضَرَتِ الصَّلاَۃُ ؟ فَقَالَ : یَکُونُ إِمَامُہُمْ مَیْسَرَتَہُمْ ، وَیَصُفُّونَ صَفًّا وَاحِدًا ، وَیَسْتَتِرُ کُلُّ رَجُلٍ مِنْہُمْ بِیَدِہِ الْیُسْرَی عَلَی فَرْجِہِ مِنْ غَیْرِ أَنْ یَمَسَّ الْفَرْجَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5022","","","كتاب الصلوات"
"5023","(۵۰۲۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الْقَوْمِ تَنْکَسِرُ بِہِمُ السَّفِینَۃُ فَیَخْرُجُونَ عُرَاۃً ، کَیْفَ یُصَلُّونَ ؟ قَالَ : جُلُوسًا ، وَإِمَامُہُمْ وَسَطُہُمْ ، وَیَسْجُدُونَ وَیَغُضُّونَ أَبْصَارَہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 5023","","","كتاب الصلوات"
"5024","(۵۰۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إِبْرَاہِیمَ بْنِ یَزِیدَ ، عَنْ عَطَائٍ ؛ فِی الْعُرَاۃِ ، قَالَ : یُصَلُّونَ قُعُودًا ، یُومِئُونَ إِیمَائً ، یَقُومُ إِمَامُہُمْ وَسَطَہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 5024","","","كتاب الصلوات"
"5025","(۵۰۲۵) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ حُمْرَانَ ، عَنِ الْحَسَنِ ، قَالَ : الْغَرِیقُ یَسْجُدُ عَلَی مَتْنِ الْمَائِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5025","","","كتاب الصلوات"
"5026","(۵۰۲۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ صَفْوَانَ بْنِ سُلَیْمٍ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْغُسْلُ یَوْمَ الْجُمُعَۃِ وَاجِبٌ عَلَی کُلِّ مُحْتَلِمٍ۔ (بخاری ۲۶۶۵۔ ابن ماجہ ۱۰۸۹)","Sahih","Musannaf Ibn Abi Shaybah 5026","","","كتاب الجمعة"
"5027","(۵۰۲۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یَزِیدُ بْنُ أَبِی زِیَادٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ مِنَ الْحَقِّ عَلَی الْمُسْلِمِینَ ؛ أَنْ یَغْتَسِلَ أَحَدُہُمْ یَوْمَ الْجُمُعَۃِ ، وَأَنْ یَمَسَّ مِنْ طِیبٍ إِنْ کَانَ عِنْدَ أَہْلِہِ ، فَإِنْ لَمْ یَکُنْ عِنْدَہُ طِیبٌ ، فَالْمَائُ لَہُ طِیبٌ۔ (ترمذی ۵۲۸۔ احمد ۴/۲۸۲)","Da'if","Musannaf Ibn Abi Shaybah 5027","","","كتاب الجمعة"
"5028","(۵۰۲۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنِ الأَوْزَاعِیِّ ، قَالَ : حدَّثَنَا حَسَّانُ بْنُ عَطِیَّۃَ ، قَالَ : حَدَّثَنَا أَبُو الأَشْعَثِ ، قَالَ : حَدَّثَنِی أَوْسُ بْنُ أَوْسٍ الثَّقَفِیُّ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ غَسَّلَ یَوْمَ الْجُمُعَۃِ وَاغْتَسَلَ ، وَبَکَّرَ وَابْتَکَرَ ، وَمَشَی وَلَمْ یَرْکَبْ ، فَدَنَا مِنَ الإِمَام وَاسْتَمَعَ وَلَمْ یَلْغُ کَانَ لَہُ بِکُلِّ خُطْوَۃٍ عَمَلُ سَنَۃٍ ، أَجْرُ صِیَامِہَا وَقِیَامِہَا۔ (ترمذی ۴۹۶۔ ابوداؤد ۳۴۹)","Sahih","Musannaf Ibn Abi Shaybah 5028","","","كتاب الجمعة"
"5029","(۵۰۲۹) حَدَّثَنَا شَرِیکٌ ، وَأَبُو الأَحْوَص ، عَنْ أَبِی إِسْحَاقَ ، عَنْ یَحْیَی بْنِ وَثَّابٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَتَی الْجُمُعَۃَ فَلْیَغْتَسِلْ۔ (نسائی ۱۶۸۰)","Sahih","Musannaf Ibn Abi Shaybah 5029","","","كتاب الجمعة"
"5030","(۵۰۳۰) حَدَّثَنَا ابْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ بِمِثْلِہِ۔ (بخاری ۸۷۷۔ مسلم ۵۷۹)","Sahih","Musannaf Ibn Abi Shaybah 5030","","","كتاب الجمعة"
"5031","(۵۰۳۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ دَاوُدَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : حَقٌّ عَلَی کُلِّ مُسْلِمٍ فِی کُلِّ سَبْعٍ غُسْلُ یَوْمٍ ، وَذَلِکَ یَوْمُ الْجُمُعَۃِ۔ (نسائی ۱۶۶۹۔ احمد ۳/۳۰۴)","Hasan","Musannaf Ibn Abi Shaybah 5031","","","كتاب الجمعة"
"5032","(۵۰۳۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا زَکَرِیَّا بْنُ أَبِی زَائِدَۃَ ، عَنْ مُصْعَبِ بْنِ شَیْبَۃَ ، عَنْ طَلْقٍ ، عَنِ ابْنِ الزُّبَیْرِ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْغُسْلُ مِنْ أَرْبَعٍ ؛ مِنَ الْجَنَابَۃِ ، وَالْحِجَامَۃِ ، وَغُسْلِ الْمَیِّتِ ، وَغُسْلِ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5032","","","كتاب الجمعة"
"5033","(۵۰۳۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أَوْصَانِی خَلِیلِی بِالْغُسْلِ یَوْمَ الْجُمُعَۃِ۔ (ابویعلی ۶۱۹۸)","Hasan","Musannaf Ibn Abi Shaybah 5033","","","كتاب الجمعة"
"5034","(۵۰۳۴) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ شَیْبَانَ ، عَنْ یَحْیَی ، عن أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ بَیْنَمَا ہُوَ یَخْطُبُ یَوْمَ الْجُمُعَۃِ إِذْ جَائَ رَجُلٌ ، فَقَالَ عُمَرُ : لِمَ تَحْتَبِسُونَ عَنِ الصَّلاَۃ ؟ فَقَالَ الرَّجُلُ : مَا ہُوَ إِلاَّ أَنْ سَمِعْتُ النِّدَائَ فَتَوَضَّأْتُ ، فَقَالَ : وَالْوُضُوئُ أَیْضًا ، أَوَلَمْ تَسْمَعُوا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ: إِذَا رَاحَ أَحَدُکُمْ إِلَی الْجُمُعَۃِ فَلْیَغْتَسِلْ۔ (بخاری ۸۸۲۔ مسلم ۵۸۰)","Sahih","Musannaf Ibn Abi Shaybah 5034","","","كتاب الجمعة"
"5035","(۵۰۳۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ ، یُحَدِّثُ عَنْ رَجُلٍ مِنَ الأَنْصَارِ ، عَنْ رَجُلٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ قَالَ : ثَلاَثٌ حَقٌّ عَلَی کُلِّ مُسْلِمٍ ؛ الْغُسْلُ یَوْمَ الْجُمُعَۃِ ، وَالسِّوَاکُ ، وَیَمَسُّ مِنْ طِیبٍ إِنْ کَانَ۔ (بخاری ۸۸۰۔ احمد ۴/۳۴)","Sahih","Musannaf Ibn Abi Shaybah 5035","","","كتاب الجمعة"
"5036","(۵۰۳۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یَزِیدُ بْنُ أَبِی زِیَادٍ ، عَنْ عبد اللہِ بْنِ الْحَارِثِ ، قَالَ : کُنْتُ مَعَ ابْن سَعْدٍ فَجَائَ ابْنٌ لَہُ ، فَقَالَ لَہُ : ہَلِ اغْتَسَلْتَ ؟ قَالَ : لاَ ، تَوَضَّأْتُ ، ثُمَّ جِئْتُ ، فَقَالَ لَہُ سَعْدٌ : مَا کُنْتُ أَحْسَبُ أَنَّ أَحَدًا یَدَعُ الْغُسْلَ یَوْمَ الْجُمُعَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 5036","","","كتاب الجمعة"
"5037","(۵۰۳۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : أَقْبَلَ رَجُلٌ مِنَ الْمُہَاجِرِینَ یَوْمَ الْجُمُعَۃِ ، فَقَالَ لَہُ عُمَرُ : ہَلِ اغْتَسَلْتَ ؟ قَالَ : لاَ ، قَالَ : لَقَدْ عَلِمْتَ أَنَّا أُمِرْنَا بِغَیْرِ ذَلِکَ ، قَالَ الرَّجُلُ : بِمَ أُمِرْتُمْ ؟ قَالَ : بِالْغُسْلِ، قَالَ : أَنْتُمْ مَعْشَرَ الْمُہَاجِرِینَ ، أُمُّ النَّاسِ ؟ قَالَ : لاَ أَدْرِی۔ (عبدالرزاق ۵۲۹۳)","No Data Available","Musannaf Ibn Abi Shaybah 5037","","","كتاب الجمعة"
"5038","(۵۰۳۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : بَیْنَمَا عُمَرُ بْنُ الْخَطَّابِ یَخْطُبُ ، ثُمَّ ذَکَرَ نَحْوَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5038","","","كتاب الجمعة"
"5039","(۵۰۳۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی الْبَخْتَرِیِّ ، قَالَ ، قَاوَلَ عَمَّارٌ رَجُلاً فَاسْتَطَالَ عَلَیْہِ ، فَقَالَ : أَنَا إِذَن أَنْتَنُ مِنَ الَّذِی لاَ یَغْتَسِلُ یَوْمَ الْجُمُعَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 5039","","","كتاب الجمعة"
"5040","(۵۰۴۰) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ مُرَّۃٍ ، عَنْ زَاذَانَ ، قَالَ : سُئِلَ عَلِیٌّ عَنْ غُسْلِ یَوْمَ الْجُمُعَۃِ ؟ فَقَالَ : الْغُسْلُ یَوْمَ الْجُمُعَۃِ ، وَفِی الْعِیدَیْنِ ، وَیَوْمَ عَرَفَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5040","","","كتاب الجمعة"
"5041","(۵۰۴۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یَحْیَی بْنِ أَبِی إِسْحَاقَ ، قَالَ : سَمِعْتُ أَبَا الْوَلِیدِ عَبْدَ اللہِ بْنَ الْحَارِثِ ؛ أَنَّہُ سَمِعَ ابْنَ عَبَّاسٍ یَقُولُ : مَا شَعَرْتُ أَنْ أَحَدًا یَرَی أَنَّ لَہُ طَہُورًا یَوْمَ الْجُمُعَۃِ غَیْرَ الْغُسْلِ۔","Sahih","Musannaf Ibn Abi Shaybah 5041","","","كتاب الجمعة"
"5042","(۵۰۴۲) حَدَّثَنَا وَکِیعٌ، عَنْ ثَوْرٍ، عَنْ زِیَادٍ النُّمَیْرِیِّ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: لأَغْتَسِلَنَّ یَوْمَ الْجُمُعَۃِ وَلَوْ کَأْسٌ بِدِینَارٍ۔","Da'if","Musannaf Ibn Abi Shaybah 5042","","","كتاب الجمعة"
"5043","(۵۰۴۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو بِشْرٍ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ کَعْبٌ : یَفْزَعُ لِیَوْمِ الْجُمُعَۃِ کُلُّ شَیْئٍ إِلاَّ الثَّقَلَیْنِ ، وَعَلَی کُلِّ حَالِمٍ فِیہِ الْغُسْلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5043","","","كتاب الجمعة"
"5044","(۵۰۴۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یَحْیَی بن سَعِیدٍ ، عَنْ عَمْرَۃَ بِنْتِ عَبْدِ الرَّحْمَنِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ النَّاسُ یَخْدُمُونَ أَنْفُسَہُمْ ، فَکَانَ أَحَدُہُمْ یَرُوحُ بِہَیْئَتِہِ إِلَی الْجُمُعَۃِ ، فَقِیلَ لَہُمْ : لَوِ اغْتَسَلْتُمْ۔ (بخاری ۹۰۳۔ مسلم ۶)","Sahih","Musannaf Ibn Abi Shaybah 5044","","","كتاب الجمعة"
"5045","(۵۰۴۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ دَاوُدَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : حقٌّ عَلَی کُلِّ مُسْلِمٍ غُسْلُ یَوْمٍ بَیْنَ سَبْعَۃِ أَیَّامٍ ، وَہُوَ یَوْمُ الْجُمُعَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 5045","","","كتاب الجمعة"
"5046","(۵۰۴۶) حَدَّثَنَا ہُشَیْمٌ، عَنْ عُبَیْدَۃَ، عَنْ إِبْرَاہِیمَ، قَالَ: قَالَ عُمَرُ فِی شَیْئٍ: لأَنْتَ أَشَرُّ مِمَّنْ لاَ یَغْتَسِلُ یَوْمَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5046","","","كتاب الجمعة"
"5047","(۵۰۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ غُسْلَ یَوْمِ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5047","","","كتاب الجمعة"
"5048","(۵۰۴۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنِ النُّعْمَانِ بْنِ سَعْدٍ ، عَنْ أَخِیہِ عَبْدِ اللہِ بْنِ سَعْدٍ ، قَالَ : کَانَ عُمَرَ إِذَا حَلَفَ ، قَالَ : أَنَا إِذَن شَرٌّ مِنَ الَّذی لاَ یَغْتَسِلُ یَوْمَ الْجُمُعَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 5048","","","كتاب الجمعة"
"5049","(۵۰۴۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ یَحْیَی بْنِ مَیْسَرَۃَ ، قَالَ : سَأَلْتُ ) عَنْ غُسْلِ یَوْمِ الْجُمُعَۃِ ، سُنَّۃٌ ؟ فَقَالَ : کَانَ الْمُسْلِمُونَ یَغْتَسِلُونَ ، فَأَعَدْتُ عَلَیْہِ ، فَلَمْ یَزِدْنِی عَلَی أَنْ قَالَ : کَانَ الْمُسْلِمُونَ یَغْتَسِلُونَ ، فَعَرَفْتُ أَنَّہُ شَیْئٌ اسْتَحَبَّہُ الْمُسْلِمُونَ ، وَلَیْسَ بِسُنَّۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5049","","","كتاب الجمعة"
"5050","(۵۰۵۰) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ یَزِیدَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : الْغُسْلُ یَوْمَ الْجُمُعَۃِ ، وَیَوْمَ الأَضْحَی ، وَیَوْمَ الْفِطْرِ ، وَیَوْمَ عَرَفَۃَ ، وَیَوْمَ دُخُولِ مَکَّۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5050","","","كتاب الجمعة"
"5051","(۵۰۵۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یُحِبُّونَ إِذَا شَہِدُوا الأَمْصَارَ أَنْ لاَ یَدَعُوا الْغُسْلَ یَوْمَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5051","","","كتاب الجمعة"
"5052","(۵۰۵۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ رَاحَ إِلَی الْجُمُعَۃِ فَلْیَغْتَسِلْ۔ (احمد ۲/۵۵۔ طبرانی ۱۳۳۹۲)","Sahih","Musannaf Ibn Abi Shaybah 5052","","","كتاب الجمعة"
"5053","(۵۰۵۳) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ لَیْثٍ ، عَنْ مَغْرَائَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ یَغْتَسِلُ وَہُوَ فِی الْحَدِیدِ یَوْمَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5053","","","كتاب الجمعة"
"5054","(۵۰۵۴) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : أَخْبَرَنِی مَالِکُ بْنُ أَنَسٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : أَخْبَرَنِی ابْنُ سَبَّاقٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ فِی جُمُعَۃٍ مِنَ الْجُمَعِ : إِنَّ ہَذَا یَوْمُ عِیدٍ فَاغْتَسِلُوا ، وَمَنْ کَانَ عِنْدَہُ طِیبٌ فَلاَ یَضُرُّہُ أَنْ یَمَسَّ مِنْہُ ، وَعَلَیْکُمْ بِالسِّوَاکِ۔","","Musannaf Ibn Abi Shaybah 5054","","","كتاب الجمعة"
"5055","(۵۰۵۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، وَالْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی بَکْرِ بْنِ عَمْرِو بْنِ عُتْبَۃَ ، عَنِ ابْنِ مُغَفَّلٍ ، قَالَ : لَہَا غُسْلٌ وَطِیبٌ إِنْ کَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 5055","","","كتاب الجمعة"
"5056","(۵۰۵۶) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ یَزِیدَ ، قَالَ : قُلْتُ لِعَبْدِ الرَّحْمَنِ : ہَلْ مِنْ غُسْلٍ غَیْرَ یَوْمِ الْجُمُعَۃِ ؟ قَالَ : نَعَمْ ، یَوْمَ الأَضْحَی ، وَیَوْمَ الْفِطْرِ ، وَیَوْمَ عَرَفَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5056","","","كتاب الجمعة"
"5057","(۵۰۵۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، وَوَکِیعٌ ، عَنْ عُمَر بْنِ ذَرٍّ ، عَنْ إِبْرَاہِیمَ التَّیْمِیِّ ، عَنْ أَبِیِہِ ؛ أَنَّہُ کَانَ یَسْتَحِبُّ الْغُسْلَ فِی الْعِیدَیْنِ وَالْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5057","","","كتاب الجمعة"
"5058","(۵۰۵۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، وَابْنُ فُضَیْلٍ ، قَالاَ : حدَّثَنَا مِسْعَرٌ ، عَنْ وَبَرَۃَ ، عَنْ ہَمَّامِ بْنِ الْحَارِثِ ، قَالَ : قَالَ عَبْدُ اللہِ : إِنَّ مِنَ السُّنَّۃِ الْغُسْلَ یَوْمَ الْجُمُعَۃِ۔ (عبدالرزاق ۵۳۱۶۔ طیالسی ۳۹۱)","Sahih","Musannaf Ibn Abi Shaybah 5058","","","كتاب الجمعة"
"5059","(۵۰۵۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَطَبَ یَوْمَ الْجُمُعَۃِ ، فَقَالَ : مَنْ رَاحَ إِلَی الْجُمُعَۃِ فَلْیَغْتَسِلْ۔","Sahih","Musannaf Ibn Abi Shaybah 5059","","","كتاب الجمعة"
"5060","(۵۰۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ عَلِیِّ بْنِ رِفَاعَۃَ ، عَنْ حَیَّانَ الأَعْرَجِ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : رُبَّمَا وَجَدْتُ الْبَرْدَ یَوْمَ الْجُمُعَۃِ فَلاَ أَغْتَسِلُ۔ (نسائی ۱۴۰۵)","No Data Available","Musannaf Ibn Abi Shaybah 5060","","","كتاب الجمعة"
"5061","(۵۰۶۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا إِسْمَاعِیلُ ، عَنِ الشَّعْبِیِّ (ح) وَأَخْبَرَنَا عُبَیْدَۃُ ، وَمُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ (ح) وَعَبْدُ الْمَلِکِ ، عَنْ عَطَائٍ ؛ أَنَّہُمْ قَالُوا : مَنْ تَوَضَّأَ یَوْمَ الْجُمُعَۃِ فَحَسَنٌ ، وَمَنِ اغْتَسَلَ فَالْغُسْلُ أَفْضَلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5061","","","كتاب الجمعة"
"5062","(۵۰۶۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عُبَیْدَۃُ ، عَنْ أَبِی وَائِلٍ ، قَالَ : ذَکَرُوا غُسْلَ یَوْمِ الْجُمُعَۃِ عِنْدَہُ ، فَقَالَ أَبُو وَائِلٍ : إِنَّہُ لَیْسَ بِوَاجِبٍ ، رُبَّ شَیْخٍ کَبِیرٍ لَوِ اغْتَسَلَ فِی الْبَرْدِ الشَّدِیدِ یَوْمَ الْجُمُعَۃِ لَمَاتَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5062","","","كتاب الجمعة"
"5063","(۵۰۶۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا إِسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ کَانَ لاَ یَرَی غُسْلاً وَاجِبًا ، إِلاَّ الْغُسْلَ مِنَ الْجَنَابَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5063","","","كتاب الجمعة"
"5064","(۵۰۶۴) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا ہَمَّامٌ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ سَمُرَۃََ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ : مَنْ تَوَضَّأَ یَوْمَ الْجُمُعَۃِ فَبِہَا وَنَعِمَتْ ، وَمَنَ اغْتَسَلَ فَذَلِکَ أَفْضَلُ۔ (ابوداؤد ۳۵۸۔ احمد ۵/۱۶)","Hasan","Musannaf Ibn Abi Shaybah 5064","","","كتاب الجمعة"
"5065","(۵۰۶۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ تَوَضَّأَ فَأَحْسَنَ الْوُضُوئَ ، ثُمَّ أَتَی الْجُمُعَۃَ ، فَدَنَا وَأَنْصَتَ وَاسْتَمَعَ ، غُفِرَ لَہُ مَا بَیْنَہُ وَبَیْنَ الْجُمُعَۃِ الأُخْرَی ، وَزِیَادَۃُ ثَلاَثَۃِ أَیَّامٍ ، وَمَنْ مَسَّ الْحَصَی فَقَدْ لَغَا۔ (مسلم ۲۷۔ ابوداؤد ۱۰۴۳)","Sahih","Musannaf Ibn Abi Shaybah 5065","","","كتاب الجمعة"
"5066","(۵۰۶۶) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : سَأَلْتُُہُ عَنْ غُسْلِ الْجُمُعَۃِ؟ فَقَالَ: لَیْسَ غُسْلٌ وَاجِبٌ إِلاَّ مِنَ الْجَنَابَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5066","","","كتاب الجمعة"
"5067","(۵۰۶۷) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطِیَّۃَ ، عَنْ أَبِی سَعِیدٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ تَطَہَّرَ فَأَحْسَنَ الطُّہُورَ ، ثُمَّ أَتَی الْجُمُعَۃَ ، فَلَمْ یَلْہُ وَلَمْ یَجْہَلْ ، کَانَ کَفَّارَۃً لِمَا بَیْنَہَا وَبَیْنَ الْجُمُعَۃِ الأُخْرَی ، وَالصَّلَوَاتُ الْخَمْسُ کَفَّارَاتٌ لِمَا بَیْنَہُنَّ ، وَفِی الْجُمُعَۃِ سَاعَۃٌ لاَ یُوَافِقُہَا عَبْدٌ مُسْلِمٌ فَیَسْأَلُ اللَّہَ خَیْرًا إِلاَّ أَعْطَاہُ۔ (عبد بن حمید ۹۰۱)","Da'if","Musannaf Ibn Abi Shaybah 5067","","","كتاب الجمعة"
"5068","(۵۰۶۸) حَدَّثَنَا ہُشَیْمٌ، قَالَ: أَخْبَرَنَا الأَعْمَش، عَنْ إِبْرَاہِیمَ، عَن عَلْقَمَۃَ؛ أَنَّہُ کَانَ لاَ یَغْتَسِلُ یَوْمَ الْجُمُعَۃِ فِی السَّفَرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5068","","","كتاب الجمعة"
"5069","(۵۰۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَر (ح) وَعَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ لاَ یَغْتَسِلُ یَوْمَ الْجُمُعَۃِ فِی السَّفَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 5069","","","كتاب الجمعة"
"5070","(۵۰۷۰) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ خَالِہِ الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنِ ابْنِ جُبَیْرِ بْنِ مُطْعِمٍ ؛ أَنَّہُ کَانَ لاَ یَغْتَسِلُ یَوْمَ الْجُمُعَۃِ فِی السَّفَرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5070","","","كتاب الجمعة"
"5071","(۵۰۷۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ؛ أَنَّ مُجَاہِدًا ، وَطَاوُوسا کَانَا لاَ یَغْتَسِلاَنِ فِی السَّفَرِ یَوْمَ الْجُمُعَۃِ ، وَکَانَ سَعِیدُ بْنُ جُبَیْرٍ یَغْتَسِلُ حِینَ جِیئَ بِہِ أَسِیرًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5071","","","كتاب الجمعة"
"5072","(۵۰۷۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ جَابِرٍ ، قَالَ : سَأَلْتُ الْقَاسِمَ عَنِ الْغُسْلِ یَوْمَ الْجُمُعَۃِ فِی السَّفَرِ ؟ فَقَالَ : کَانَ ابْنُ عُمَرَ لاَ یَغْتَسِلُ ، وَأَنَا أَرَی لَکَ أَنْ لاَ تَغْتَسِلَ۔","Da'if","Musannaf Ibn Abi Shaybah 5072","","","كتاب الجمعة"
"5073","(۵۰۷۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ؛ أَنَّ الأَسْوَدَ ، وَعَلْقَمَۃَ کَانَا لاَ یَغْتَسِلاَنِ یَوْمَ الْجُمُعَۃِ فِی السَّفَرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5073","","","كتاب الجمعة"
"5074","(۵۰۷۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ إِیَاسِ بْنِ مُعَاوِیَۃَ ، قَالَ : إِنَّمَا الْغُسْلُ عَلَی مَنْ حَضَرَ الْجُمُعَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5074","","","كتاب الجمعة"
"5075","(۵۰۷۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرُ ، عَنْ عُقْبَۃَ بْنِ أَبِی جَسْرَۃ ، قَالَ : سَأَلْتُ إِسْحَاقَ بْنَ عَبْدِ اللہِ بْنِ الْحَارِثِ عَنِ الْغُسْلِ یَوْمَ الْجُمُعَۃِ ؟ فَقَالَ : کَانَ عَبْدُ اللہِ بْنُ الْحَارِثِ یَغْتَسِلُ یَوْمَ الْجُمُعَۃِ فِی السَّفَرِ وَالْحَضَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 5075","","","كتاب الجمعة"
"5076","(۵۰۷۶) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنْ عَبْدِ اللہِ بْنِ مَعْدَانَ ، قَالَ : سَمِعْتُ حَبِیبًا وَسَأَلَہُ رَجُلٌ : مَا تَقُولُ فِی غُسْلِ الْجُمُعَۃِ ، أَوَاجِبٌ ہُوَ ؟ فَقَالَ : قَدْ رَأَیْتُ طَلْقًا أَقْبَلَ مِنْ مَکَّۃَ إِلَی الْحَجَّاجِ أَسِیرًا ، فَمَا تَرَکَ الْغُسْلَ یَوْمَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5076","","","كتاب الجمعة"
"5077","(۵۰۷۷) حَدَّثَنَا عُبَیْدُاللہِ بْنُ مُوسَی، عَنْ إِسْرَائِیلَ، عَنْ جَابِرٍ، عَنْ أَبِی جَعْفَرٍ؛ أَنَّہُ کَانَ یَغْتَسِلُ فِی السَّفَرِ کُلَّ جُمُعَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5077","","","كتاب الجمعة"
"5078","(۵۰۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْحَاقَ بْنِ یَحْیَی ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ زِیَادِ بْنِ حُدَیْرٍ ، قَالَ : سَتَرْتُ طَلْحَۃَ فِی سَفَرٍ یَوْمَ جُمُعَۃٍ فَاغْتَسَلَ۔","Da'if","Musannaf Ibn Abi Shaybah 5078","","","كتاب الجمعة"
"5079","(۵۰۷۹) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إِذَا اغْتَسَلَ یَوْمَ الْجُمُعَۃِ بَعْدَ طُلُوعِ الْفَجْرِ مِنَ الْجَنَابَۃِ ، أَجْزَأَہُ مِنْ غُسْلِ یَوْمِ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5079","","","كتاب الجمعة"
"5080","(۵۰۸۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَن??ا یُونُسُ ، عَنِ الْحَسَنِ (ح) وَمُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ (ح) وَعَبْدُ الْمَلِکِ ، عَنْ عَطَائٍ ؛ أَنَّہُمْ قَالُوا : إِذَا اغْتَسَلَ الرَّجُلُ یَوْمَ الْجُمُعَۃِ بَعْدَ طُلُوعِ الْفَجْرِ أَجْزَأَہُ مِنْ غُسْلِ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5080","","","كتاب الجمعة"
"5081","(۵۰۸۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حَبِیبُ بْنُ أَبِی الْعَالِیَۃِ ، عَنْ مُجَاہِدٍ ؛ مِثْلَ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5081","","","كتاب الجمعة"
"5082","(۵۰۸۲) حَدَّثَنَا وَکِیعٌ، عَنْ مَعْمَرٍ، عَنْ أَبِی جَعْفَرٍ، قَالَ: إِذَا اغْتَسَلَ بَعْدَ طُلُوعِ الْفَجْرِ أَجْزَأَہُ مِنْ غُسْلِ یَوْمِ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5082","","","كتاب الجمعة"
"5083","(۵۰۸۳) حَدَّثَنَا ابْنُ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، قَالَ : مَنِ اغْتَسَلَ یَوْمَ الْجُمُعَۃِ بَعْدَ طُلُوعِ الْفَجْرِ أَجْزَأَہُ مِنْ غُسْلِ الْجُمُعُۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5083","","","كتاب الجمعة"
"5084","(۵۰۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ بشیر ، عَنِ الشَّعْبِیِّ ، قَالَ : سُئِلَ عَنْ رَجُلٍ اغْتَسَلَ یَوْمَ الْجُمُعَۃِ بِسَحَرٍ ؟ قَالَ : یُجْزِئُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5084","","","كتاب الجمعة"
"5085","(۵۰۸۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الْعَوَّامُ ، عَنْ إِبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : کَانُوا یُحِبُّونَ لِمَنِ اغْتَسَلَ یَوْمَ الْجُمُعَۃِ أَنْ لاَ یَکُونَ بَیْنَہُ وَبَیْنَ الْجُمُعَۃِ حَدَثٌ ، قَالَ : وَکَانُوا یَقُولُونَ : إِذَا أَحْدَثَ بَعْدَ الْغُسْلِ ، عَادَ إِلَی حَالِہِ الَّتِی کَانَ عَلَیْہَا قَبْلَ أَنْ یَغْتَسِلَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5085","","","كتاب الجمعة"
"5086","(۵۰۸۶) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ إِبْرَاہِیمَ بن نَافِعٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ؛ فِی الرَّجُلِ یَغْتَسِلُ یَوْمَ الْجُمُعَۃِ ، ثُمَّ یُحْدِثُ ، قَالَ : یُعِیدُ الْغُسْلَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5086","","","كتاب الجمعة"
"5087","(۵۰۸۷) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَبْدَۃَ بْنِ أَبِی لُبَابَۃَ ، عَنْ سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَغْتَسِلُ یَوْمَ الْجُمُعَۃِ ، ثُمَّ یُحْدِثُ بَعْدَ الْغُسْلِ ، ثُمَّ لاَ یُعِیدُ غُسْلاً۔","Sahih","Musannaf Ibn Abi Shaybah 5087","","","كتاب الجمعة"
"5088","(۵۰۸۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ ہِشَامٍ ، قَالَ : کَانَ مُحَمَّدٌ یَسْتَحِبُّ أَنْ لاَ یَکُونَ بَیْنَہُ وَبَیْنَ الْجُمُعَۃِ حَدَثٌ ۔ وَقَالَ الْحَسَنُ : إِذَا أَحْدَثَ تَوَضَّأَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5088","","","كتاب الجمعة"
"5089","(۵۰۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مُبَارَکٍ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا اغْتَسَلَ یَوْمَ الْجُمُعَۃِ ، ثُمَّ أَحْدَثَ أَجْزَأَہُ الْوُضُوئُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5089","","","كتاب الجمعة"
"5090","(۵۰۹۰) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ عُبَیْدَۃَ ابْنَۃِ نَابِلٍ ، قَالَتْ : سَمِعْتُ ابْنَ عُمَرَ ، وَابْنَۃَ سَعْدِ بْنِ أَبِی وَقَّاصٍ ، یَقُولاَنِ لِلنِّسَائِ : مَنْ جَائَ مِنْکُنَّ الْجُمُعَۃَ فَلْتَغْتَسِلْ۔","Hasan","Musannaf Ibn Abi Shaybah 5090","","","كتاب الجمعة"
"5091","(۵۰۹۱) حَدَّثَنَا یَحْیَی بْنُ أَبِی کَثِیرٍ ، عَنْ إِبْرَاہِیمَ بْنِ نَافِعٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَأْمُرُ نِسَائَہُ یَغْتَسِلْنَ یَوْمَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5091","","","كتاب الجمعة"
"5092","(۵۰۹۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ عَنْ إِبْرَاہِیمَ بْنِ نَافِعٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ؛ بِمِثْلِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5092","","","كتاب الجمعة"
"5093","(۵۰۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لَیْسَ عَلَی النِّسَائِ غُسْلٌ یَوْمَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5093","","","كتاب الجمعة"
"5094","(۵۰۹۴) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ زُفَرَ بْن مُہَاجِرِ الْغَاضِرِیِّ ، قَالَ : کَانَ شَقِیقٌ یَأْمُرُ أَہْلَہُ ، الرِّجَالَ وَالنِّسَائَ ، بِالْغُسْلِ یَوْمَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5094","","","كتاب الجمعة"
"5095","(۵۰۹۵) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَغْتَسِلُ لِلْجَنَابَۃِ وَالْجُمُعَۃِ غُسْلاً وَاحِدًا۔","Da'if","Musannaf Ibn Abi Shaybah 5095","","","كتاب الجمعة"
"5096","(۵۰۹۶) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی الْمَوَالِی ، عَنْ عُمَرَ بْنِ أَبِی مُسْلِمٍ ، قَالَ : کَانَ بَنُو أَخِی عُرْوَۃَ بْنِ الزُّبَیْرِ یَغْتَسِلُونَ فِی الْحَمَّامِ یَوْمَ الْجُمُعَۃِ ، فَیَقُولُ عُرْوَۃُ : یَا بَنِی أَخِی ، إِنَّمَا اغْتَسَلْتُمْ فِی الْحَمَّامِ مِنَ الْوَسَخِ ، فَاغْتَسِلُوا لِلْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5096","","","كتاب الجمعة"
"5097","(۵۰۹۷) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنِی یَحْیَی بْنُ عَبْدِ اللہِ بْنِ أَبِی قَتَادَۃَ ، قَالَ : حَدَّثَتْنِی أُمِّیْ، أَنَّ أَبَاہَا حَدَّثَہَا ، أَنَّ بَعْضَ وَلَدِ أَبِی قَتَادَۃَ دَخَلَ عَلَیْہِ یَوْمَ الْجُمُعَۃِ یَنْفُضُ رَأْسَہُ مُغْتَسِلاً ، فَقَالَ : لِلْجُمُعَۃِ اغْتَسَلْتَ ؟ قَالَ: لاَ ، وَلَکِنْ مِنَ جَنَابَۃٍ ، قَالَ : فَأَعِدْ غُسْلاً لِلْجُمُعَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 5097","","","كتاب الجمعة"
"5098","(۵۰۹۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ طَلْحَۃَ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : قَالَ عَلِیٌّ : لاَ جُمُعَۃَ ، وَلاَ تَشْرِیقَ إِلاَّ فِی مِصْرٍ جَامِعٍ۔","Sahih","Musannaf Ibn Abi Shaybah 5098","","","كتاب الجمعة"
"5099","(۵۰۹۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقٍ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : لاَ جُمُعَۃَ ، وَلاَ تَشْرِیقَ ، وَلاَ صَلاَۃَ فِطْرٍ ، وَلاَ أَضْحَی ، إِلاَّ فِی مِصْرٍ جَامِعٍ ، أَوْ مَدِینَۃٍ عَظِیمَۃٍ۔nقَالَ حَجَّاجٌ : وَسَمِعْتُ عَطَائً یَقُولُ مِثْلَ ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 5099","","","كتاب الجمعة"
"5100","(۵۱۰۰) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عُمَرَ بْنِ عَامِرٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَن حُذَیْفَۃَ ، قَالَ : لَیْسَ عَلَی أَہْلِ الْقُرَی جُمُعَۃٌ ، إِنَّمَا الْجُمُعَۃُ عَلَی أَہْلِ الأَمْصَارِ ، مِثْلِ الْمَدَائِنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5100","","","كتاب الجمعة"
"5101","(۵۱۰۱) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ؛ أَنَّہُمَا قَالاَ : الْجُمُعَۃُ فِی الأَمْصَارِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5101","","","كتاب الجمعة"
"5102","(۵۱۰۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ؛ أَنَّہُ سُئِلَ : عَلَی أَہْلِ الأُبُلَّۃ جُمُعَۃٌ ؟ قَالَ : لاَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5102","","","كتاب الجمعة"
"5103","(۵۱۰۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَبِی بَکْرِ بْنِ مُحَمَّدٍ ؛ أَنَّہُ أَرْسَلَ إِلَی أَہْلِ ذِی الْحُلَیْفَۃِ: أَنْ لاَ تُجَمِّعُوا بِہَا ، وَأَنْ تَدْخُلُوا إِلَی الْمَسْجِدِ ، مَسْجِدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5103","","","كتاب الجمعة"
"5104","(۵۱۰۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا لاَ یُجَمِّعُونَ فِی الْعَسَاکِرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5104","","","كتاب الجمعة"
"5105","(۵۱۰۵) حَدَّثَنَا غُنْدَرٌ ، عن شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ جُمُعَۃَ ، وَلاَ تَشْرِیقَ إِلاَّ فِی مِصْرٍ جَامِعٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5105","","","كتاب الجمعة"
"5106","(۵۱۰۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ السُّلَمِیِّ ، عَنْ عَلِیٍّ ، قَالَ: لاَ تَشْرِیقَ ، وَلاَ جُمُعَۃَ إِلاَّ فِی مِصْرٍ جَامِعٍ۔","Sahih","Musannaf Ibn Abi Shaybah 5106","","","كتاب الجمعة"
"5107","(۵۱۰۷) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : الرَّیُّ مِصْرٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5107","","","كتاب الجمعة"
"5108","(۵۱۰۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ عَطَائِ بْنِ أَبِی مَیْمُونَۃَ ، عَنْ أَبِی رَ??فِعٍ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّہُمْ کَتَبُوا إِلَی عُمَرَ یَسْأَلُونَہُ عَنِ الْجُمُعَۃِ ؟ فَکَتَبَ : جَمِّعُوا حَیْثُمَا کُنْتُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 5108","","","كتاب الجمعة"
"5109","(۵۱۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ إِلَی عَدِیِّ بْنِ عَدِیٍّ ، أَیُّمَا أَہْلِ قَرْیَۃٍ لَیْسُوا بِأَہْلِ عَمُودٍ یَنْتَقِلُونَ ، فَأَمِّرْ عَلَیْہِمْ أَمِیرًا یُجَمِّعُ بِہِمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 5109","","","كتاب الجمعة"
"5110","(۵۱۱۰) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ مَعْقِلٍ ، عَنْ عَطَائٍ ، قَالَ : إِذَا کَانَتْ قَرْیَۃٌ لاَزِقَۃٌ بَعْضُہَا بِبَعْضٍ ، جَمَّعُوا۔","No Data Available","Musannaf Ibn Abi Shaybah 5110","","","كتاب الجمعة"
"5111","(۵۱۱۱) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ مَالِکٍ ، قَالَ : کَانَ أَصْحَابُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی ہَذِہِ الْمِیَاہِ بَیْنَ مَکَّۃَ وَالْمَدِینَۃِ یُجَمِّعُونَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5111","","","كتاب الجمعة"
"5112","(۵۱۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : أَرْسَلْتُ إِلَی عَائِشَۃَ ابْنَۃِ سَعْدٍ ، أَسْأَلُہَا عَنِ الْجُمُعَۃِ ؟ فَقَالَتْ : کَانَ سَعْدٌ عَلَی رَأْسِ سَبْعَۃِ أَمْیَالٍ ، أَوْ ثَمَانِیَۃٍ ، فَکَانَ أَحْیَانَا یَأْتِیہَا ، وَأَحْیَانَا لاَ یَأْتِیہَا۔","Sahih","Musannaf Ibn Abi Shaybah 5112","","","كتاب الجمعة"
"5113","(۵۱۱۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو عَامِرٍ الْمُزَنِیُّ ، قَالَ : سَمِعْتُ نَافِعًا ، یُحَدِّثُ عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ قَالَ : الْجُمُعَۃُ عَلَی مَنْ آوَاہُ الْمَرَاحُ۔","Da'if","Musannaf Ibn Abi Shaybah 5113","","","كتاب الجمعة"
"5114","(۵۱۱۴) حَدَّثَنَا شَرِیکٌ ، عَنْ سَعِیدِ بْنِ مَسْرُوقٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : تُؤْتَی الْجُمُعَۃُ مِنْ فَرْسَخَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5114","","","كتاب الجمعة"
"5115","(۵۱۱۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : سَأَلْتُُہُ : عَلَی مَنْ تَجِبُ الْجُمُعَۃُ ؟ فَقَالَ : عَلَی مَنْ سَمِعَ النِّدَائَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5115","","","كتاب الجمعة"
"5116","(۵۱۱۶) حَدَّثَنَا وَکِیعٌ، عَنْ أَبِی الْبَخْتَرِیِّ، قَالَ: رَأَیْتُ أَنَسًا شَہِدَ الْجُمُعَۃَ مِنَ الزَّاوِیَۃِ، وَہِیَ فَرْسَخَانِ مِنَ الْبَصْرَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 5116","","","كتاب الجمعة"
"5117","(۵۱۱۷) حَدَّثَنَا أَزْہَرُ، عَنِ ابْنِ عَوْنٍ، قَالَ: کَانَ أَبُو الْمَلِیحِ عَامِلاً عَلَی الأُبُلَّۃ، فَکَانَتْ إِذَا أَتَتِ الْجُمُعَۃُ جَمَّعَ مِنْہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5117","","","كتاب الجمعة"
"5118","(۵۱۱۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ إِسْمَاعِیلَ بْنِ مُسْلِمٍ الْعَبْدِیِّ ، عَنْ مَالِکِ بْنِ دِینَارٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : تُؤْتَی الْجُمُعَۃُ مِنْ أَرْبَعَۃِ فَرَاسِخَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5118","","","كتاب الجمعة"
"5119","(۵۱۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ، عَنْ عَطَائِ بْنِ السَّائِبِ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ: کُنَّا نَأْتِیہَا مِنْ فَرْسَخَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5119","","","كتاب الجمعة"
"5120","(۵۱۲۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنِ الْحَسَنِ ، قَالَ : الْجُمُعَۃُ عَلَی کُلِّ مَنْ آوَاہُ اللَّیْلُ إِلَی أَہْلِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5120","","","كتاب الجمعة"
"5121","(۵۱۲۱) حَدَّثَنَا ابْنُ مَہْدِی ، عَنْ وُہَیْبٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : إِنَّمَا الْجُمُعَۃُ عَلَی مَنْ آوَاہُ اللَّیْلُ إِلَی أَہْلِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5121","","","كتاب الجمعة"
"5122","(۵۱۲۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ: کَانَ أَبِی یَکُونُ بِبِئْرِ عُرْوَۃَ ثَلاَثَۃِ أَمْیَالٍ مِنَ الْمَدِینَۃِ، فَلاَ یَشْہَدُ جُمُعَۃً ، وَلاَ جَمَاعَۃً۔","Hasan","Musannaf Ibn Abi Shaybah 5122","","","كتاب الجمعة"
"5123","(۵۱۲۳) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ قُرَّۃَ بْنِ خَالِدٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ سِیرِینَ ، عَنْ أَفْلَحَ مَوْلَی أَبِی أَیُّوبَ ، قَالَ : کَانَ ابْنُ سَلاَمٍ یَأْتِینَا یَوْمَ الْجُمُعَۃِ ، فَیُعَلِّقُ مَعَہُ إِدَاوَۃً مِنْ مَائٍ ، وَیُجَمِّعُ مِنَ الْعَوَالِی۔","Sahih","Musannaf Ibn Abi Shaybah 5123","","","كتاب الجمعة"
"5124","(۵۱۲۴) حَدَّثَنَا رَوَّادُ بْنُ الْجَرَّاحِ ، عَنِ الأَوْزَاعِیِّ ، عَنْ وَاصِلٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَتِ الْعُصْبَۃُ مِنَ الرِّجَالِ وَالنِّسَائِ یُجَمِّعُونَ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَمَا یَأْتُونَ رِحَالَہُمْ إِلاَّ مِنَ الْغَدِ۔ (ابوداؤد ۵۲)","","Musannaf Ibn Abi Shaybah 5124","","","كتاب الجمعة"
"5125","(۵۱۲۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، قَالَ : الْجُمُعَۃُ عَلَی مَنْ آوَاہُ اللَّیْلُ إِلَی أَہْلِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5125","","","كتاب الجمعة"
"5126","(۵۱۲۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَنْ أَبِیہِ ؛ أَنَّ عَبْدَ اللہِ بْنَ رَوَاحَۃَ کَانَ یَأْتِی الْجُمُعَۃَ مَاشِیًا ، فَقُلْتُ لِعَبْدِ الْحَمِیدِ : کَمْ کَانَ بَیْنَ مَنْزِلِہِ وَبَیْنَ الْجُمُعَۃِ ؟ قَالَ : مِیلَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5126","","","كتاب الجمعة"
"5127","(۵۱۲۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّہُمْ کَانُوا یَشْہَدُونَ الْجُمُعَۃَ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ ذِی الْحُلَیْفَۃِ۔ (عبدالرزاق ۵۱۵۱)","","Musannaf Ibn Abi Shaybah 5127","","","كتاب الجمعة"
"5128","(۵۱۲۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَوْشَبُ بْنُ عَقِیلٍ الْعَبْدِیُّ ، قَالَ : سَأَلْتُ عَطَائً : مِنْ کَمْ تُؤْتَی الْجُمُعَۃُ ؟ قَالَ : مِنْ سَبْعَۃِ أَمْیَالٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5128","","","كتاب الجمعة"
"5129","(۵۱۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : قُلْتُ لِلزُّہْرِیِّ : عَلَی مَنْ تَجِبُ الْجُمُعَۃُ مِمَّنْ کَانَ ہُوَ قُرْبَ الْمَدِینَۃِ ؟ قَالَ : کَانَ أَہْلُ ذِی الْحُلَیْفَۃِ یَشْہَدُونَ الْجُمُعَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5129","","","كتاب الجمعة"
"5130","(۵۱۳۰) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یُسْأَلُ عَنِ الرَّجُلِ ، یُجَمِّعُ مِنْ ہَذِہِ الْمَزَالِفِ ؟ فَیَقُولُ : قَدْ کَانَتِ الأَنْصَارُ یُجَمِّعُونَ مِنَ الْمَزَالِفِ حَوْلَ الْمَدِینَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5130","","","كتاب الجمعة"
"5131","(۵۱۳۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ حَمَّادًا عَنِ الرَّجُلِ یُجَمِّعُ مِنْ فَرْسَخَیْنِ ؟ فَقَالَ : لاَ ۔ وَسَأَلْتُ الْحَکَمَ ؟ فَقَالَ : إِذَا کَانَ یَجِیئُ وَیَذْہَبُ فِی یَوْمٍ فَعَلَیْہِ الْجُمُعَۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5131","","","كتاب الجمعة"
"5132","(۵۱۳۲) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ أَیُّوبَ بْنِ عُتْبَۃَ ، عَنْ یَحْیَی ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : تُؤْتََی الْجُمُعَۃُ مِنْ فَرْسَخَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 5132","","","كتاب الجمعة"
"5133","(۵۱۳۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عُمَرَ بْنِ عَامِرٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَن حُذَیْفَۃَ ، قَالَ : لَیْسَ عَلَی مَنْ عَلَی رَأْسِ مِیلٍ جُمُعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5133","","","كتاب الجمعة"
"5134","(۵۱۳۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ؛ أَنَّہُ کَانَ یَشْہَدُ الْجُمُعَۃَ فِی الطَّائِفِ وَہُوَ فِی قَرْیَۃٍ ، یُقَالُ لَہَا : الْوَہْطُ ، عَلَی رَأْسِ ثَلاَثَۃِ أَمْیَالٍ۔","Da'if","Musannaf Ibn Abi Shaybah 5134","","","كتاب الجمعة"
"5135","(۵۱۳۵) حَدَّثَنَا وَکِیعُ ، عَنْ دَاوُد بْنِ قَیْسٍ الْفَرَّائُ ، قَالَ : سَمِعْتُ عَمْرَو بْنَ شُعَیْبٍ ، قِیلَ لَہُ : یَا أَبَا إِبْرَاہِیمَ ، عَلَی مَنْ یَجِبُ الْجُمُعَۃُ ؟ قَالَ : عَلَی مَنْ سَمِعَ الصَّوْتَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5135","","","كتاب الجمعة"
"5136","(۵۱۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ، عَنْ عَلِیٍّ، قَالَ: لَیْسَ عَلَی الْمُسَافِرِ جُمُعَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 5136","","","كتاب الجمعة"
"5137","(۵۱۳۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ لاَ یُجَمِّعُ فِی السَّفَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 5137","","","كتاب الجمعة"
"5138","(۵۱۳۸) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : لَیْسَ عَلَی الْمُسَافِرِ أَضْحَی ، وَلاَ فِطْرٌ ، وَلاَ جُمُعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5138","","","كتاب الجمعة"
"5139","(۵۱۳۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ ، قَالَ : خَرَجَ مَسْرُوقٌ ، وَعُرْوَۃُ بْنُ الْمُغِیرَۃَ ، وَنَفَرٌ مِنْ أَصْحَابِ عَبْدِ اللہِ ، فَحَضَرَتِ الْجُمُعَۃُ فَلَمْ یُجَمِّعُوا ، وَحَضَرَ الْفِطْرُ فَلَمْ یُفْطِرُوا۔","No Data Available","Musannaf Ibn Abi Shaybah 5139","","","كتاب الجمعة"
"5140","(۵۱۴۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّ عَبْدَ الرَّحْمَن بْنَ سَمُرَۃَ شَتَا بِکَابُلَ شَتْوَۃً ، أَوْ شَتْوَتَیْنِ لاَ یُجَمِّعُ ، وَیُصَلِّی رَکْعَتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5140","","","كتاب الجمعة"
"5141","(۵۱۴۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّ أَنَسَ بْنَ مَالِکٍ أَقَامَ بِنَیْسَابُورَ سَنَۃً ، أَوْ سَنَتَیْنِ ، فَکَانَ یُصَلِّی رَکْعَتَیْنِ ، ثُمَّ یُسَلِّمُ ، ثُمَّ یُصَلِّی رَکْعتَیْنِ ، ثُمَّ یُسَلِّمُ ، وَلاَ یُجَمِّعُ۔","Sahih","Musannaf Ibn Abi Shaybah 5141","","","كتاب الجمعة"
"5142","(۵۱۴۲) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنِ الْمُغِیرَۃ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ أَصْحَابُنَا یَغْزُونَ ، فَیُقِیمُونَ السَّنَۃَ ، أَوْ نَحْوَ ذَلِکَ ، یُقَصِّرُونَ الصَّلاَۃ ، وَلاَ یُجَمِّعُونَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5142","","","كتاب الجمعة"
"5143","(۵۱۴۳) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ ہِشَامِ بْنِ الْغَازِ ، عَنْ عُبَادَۃَ بْنِ نُسَیٍّ ، قَالَ : خَرَجَ عَبْدُ الْمَلِکِ بْنُ مَرْوَانَ یُرِیدُ الصَّلاَۃَ فِی بَیْتِ الْمُقَدَّسِ ، فَضَرَبَ حُجْرَتَہُ عَلَی فَاثُورِ إِبْرَاہِیمَ ، فَلَقِیتُہُ وَمَعِی الْجُنْدُ ، فَدَخَلْتُ عَلَیْہِ ، فَقَالَ : یَا عُبَادَۃُ ، إِنَّا قَوْمٌ سَفْرٌ لَیْسَتْ عَلَیْنَا جُمُعَۃٌ ، فَجَمِّعْ بِأَصْحَابِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5143","","","كتاب الجمعة"
"5144","(۵۱۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إِبْرَاہِیمَ بن یَزِیدَ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : لَیْسَ عَلَی الْمُسْلِمِینَ جُمُعَۃٌ فِی سَفَرِہِمْ ، وَلاَ یَوْمَ نَفْرِہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 5144","","","كتاب الجمعة"
"5145","(۵۱۴۵) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَیْسَ عَلَی الْمُسَافِرِ جُمُعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5145","","","كتاب الجمعة"
"5146","(۵۱۴۶) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنَا رَجَائُ بْنُ أَبِی سَلَمَۃَ ، قَالَ : حَدَّثَنِی أَبُو عُبَیْدٍ مَوْلَی سُلَیْمَانَ بْنِ عَبْدِ الْمَلِکِ ، قَالَ : خَرَجَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ مِنْ دَابَقَ ، وَہُوَ یَوْمئِذٍ أَمِیرُ الْمُؤْمِنِینَ ، فَمَرَّ بِحَلَبٍ یَوْمَ الْجُمُعَۃِ ، فَقَالَ لأَمِیرِہَا : جَمِّعْ فَإِنَّا سَفْرٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5146","","","كتاب الجمعة"
"5147","(۵۱۴۷) حَدَّثَنَا شَرِیکٌ ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عُمَرُ : الْجُمُعَۃُ لاَ تَمْنَعُ مِنْ سَفَرٍ۔","Hasan","Musannaf Ibn Abi Shaybah 5147","","","كتاب الجمعة"
"5148","(۵۱۴۸) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ صَالِحِ بْنِ کَیْسَانَ ؛ أَنَّ أَبَا عُبَیْدَۃَ خَرَجَ یَوْمَ الْجُمُعَۃِ فِی بَعْضِ أَسْفَارِہِ ، وَلَمْ یَنْتَظِرِ الْجُمُعَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5148","","","كتاب الجمعة"
"5149","(۵۱۴۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ نَافِعٍ ؛ أَنَّ ابْنًا لِسَعِیدِ بْنِ زَیْدِ بْنِ نُفَیْلٍ کَانَ بِأَرْضٍ لَہُ بِالْعَقِیقِ ، عَلَی رَأْسِ أَمْیَالٍ مِنَ الْمَدِینَۃِ ، فَلَقِیَ ابْنَ عُمَرَ غَدَاۃَ الْجُمُعَۃِ فَأَخْبَرَہُ بِشَکْوَاہُ ، فَانْطَلَقَ إِلَیْہِ وَتَرَکَ الْجُمُعَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 5149","","","كتاب الجمعة"
"5150","(۵۱۵۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِالسَّفَرِ یَوْمَ الْجُمُعَۃِ ، مَا لَمْ یَحْضُرْ وَقْتُ الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 5150","","","كتاب الجمعة"
"5151","(۵۱۵۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا خَالِدٌ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ یَقُولُ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5151","","","كتاب الجمعة"
"5152","(۵۱۵۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ خَالِدٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : لاَ بَأْسَ بِالسَّفَرِ یَوْمَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5152","","","كتاب الجمعة"
"5153","(۵۱۵۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْوَلِیدِ بْنِ کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی ذَؤیبٍ ، قَالَ : خَرَجْتُ مَعَ الزُّبَیْرِ مَخْرَجًا یَوْمَ الْجُمُعَۃِ ، فَصَلَّی الْجُمُعَۃَ أَرْبَعًا۔","Da'if","Musannaf Ibn Abi Shaybah 5153","","","كتاب الجمعة"
"5154","(۵۱۵۴) حَدَّثَنَا الْفَضْلُ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، قَالَ : رَأَیْتُ ابْنَ شِہَابٍ یُرِیدُ أَنْ یُسَافِرَ یَوْمَ الْجُمُعَۃِ ضَحْوَۃً ، فَقُلْتُ لَہُ : تُسَافِرُ یَوْمَ الْجُمُعَۃِ ؟ فَقَالَ : إِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَافَرَ یَوْمَ الْجُمُعَۃِ۔ (ابوداؤد ۳۱۰۔ عبدالرزاق ۵۵۴۰)","","Musannaf Ibn Abi Shaybah 5154","","","كتاب الجمعة"
"5155","(۵۱۵۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : إِذَا أَدْرَکَتْکَ الْجُمُعَۃُ ، فَلاَ تَخْرُجْ حَتَّی تُصَلِّی الْجُمُعَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5155","","","كتاب الجمعة"
"5156","(۵۱۵۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یُسَافِرُ لَیْلَۃَ الْجُمُعَۃِ ، فَإِذَا طَلَعَ الْفَجْرُ لَمْ یُسَافِرْ۔","No Data Available","Musannaf Ibn Abi Shaybah 5156","","","كتاب الجمعة"
"5157","(۵۱۵۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ إِذَا حَضَرَتِ الْجُمُعَۃُ أَنْ لاَ یَخْرُجُوا حَتَّی یُجَمِّعُوا۔","No Data Available","Musannaf Ibn Abi Shaybah 5157","","","كتاب الجمعة"
"5158","(۵۱۵۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ حَسَّانَ بْنِ عَطِیَّۃَ ، قَالَ : إِذَا سَافَرَ یَوْمَ الْجُمُعَۃِ دُعِیَ عَلَیْہِ؛ أَنْ لاَ یُصَاحَبَ ، وَلاَ یُعَانَ عَلَی سَفَرِہِ۔ (عبدالرزاق ۵۵۴۲)","No Data Available","Musannaf Ibn Abi Shaybah 5158","","","كتاب الجمعة"
"5159","(۵۱۵۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَمَّنْ سَمِعَ سَعِیدَ بْنَ الْمُسَیَّبِ یَقُولُ : السَّفَرُ یَوْمَ الْجُمُعَۃِ بَعْدَ الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 5159","","","كتاب الجمعة"
"5160","(۵۱۶۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : خَرَجَ قَوْمٌ وَقَدْ حَضَرَتِ الْجُمُعَۃُ ، فَاضْطَرَمَ عَلَیْہِمْ خِبَاؤُہُمْ نَارًا مِنْ غَیْرِ نَارٍ یَرَوْنَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5160","","","كتاب الجمعة"
"5161","(۵۱۶۱) حَدَّثَنَا شَاذَانُ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ؛ أَنَّ عُرْوَۃَ کَانَ یُسَافِرُ لَیْلَۃَ الْجُمُعَۃِ ، وَلاَ یَنْتَظِرُ الْجُمُعَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5161","","","كتاب الجمعة"
"5162","(۵۱۶۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، قَالَ : کَانَ سَعْدٌ یَقِیلُ بَعْدَ الْجُمُعَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 5162","","","كتاب الجمعة"
"5163","(۵۱۶۳) حَدَّثَنَا بِشْرُ بْنُ مُفَضَّلٍ ، عَنْ أَبِی حَازِمٍ ، عَنْ سَہْلِ بْنِ سَعْدٍ ، قَالَ : کُنَّا نَتَغَدَّی وَنَقِیلُ بَعْدَ الْجُمُعَۃِ۔ (بخاری ۹۳۹۔ مسلم ۵۸۸)","Sahih","Musannaf Ibn Abi Shaybah 5163","","","كتاب الجمعة"
"5164","(۵۱۶۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ سَعْدٍ الأَنْصَارِیُّ ، عَنْ أَبِیہِ ، قَالَ : کُنَّا نُجَمِّعُ مَعَ عُثْمَانَ بْنِ عَفَّانَ ، ثُمَّ نَرْجِعُ فَنَقِیلُ۔","Da'if","Musannaf Ibn Abi Shaybah 5164","","","كتاب الجمعة"
"5165","(۵۱۶۵) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : کُنَّا نُجَمِّعُ فَنَرْجِعُ فَنَقِیلُ۔ (بخاری ۹۴۰)","Sahih","Musannaf Ibn Abi Shaybah 5165","","","كتاب الجمعة"
"5166","(۵۱۶۶) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : حدَّثَنِی ثَابِتُ بْنُ الْحَجَّاجِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کُنَّا نُجَمِّعُ ، ثُمَّ نَرْجِعُ فَنَقِیلُ۔","Sahih","Musannaf Ibn Abi Shaybah 5166","","","كتاب الجمعة"
"5167","(۵۱۶۷) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ بُدَیْلِ بْنِ مَیْسَرَۃَ ، عَنِ امْرَأَۃٍ ، قَالَتْ : جَاوَرْتُ مَعَ عُمَرَ سَنَۃً ، فَکَانَتِ الْقَائِلَۃُ بَعْدَ الْجُمُعَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 5167","","","كتاب الجمعة"
"5168","(۵۱۶۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ الزِّبْرِقَانِ ، قَالَ : کُنَّا نُجَمِّعُ مَعَ أَبِی وَائِلٍ ، ثُمَّ نَرْجِعُ فَنَقِیلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5168","","","كتاب الجمعة"
"5169","(۵۱۶۹) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ عِمْرَان بْنِ مُسْلِمٍ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : کُنَّا نُصَلِّی الْجُمُعَۃَ ، ثُمَّ نَرْجِعُ فَنَقِیلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5169","","","كتاب الجمعة"
"5170","(۵۱۷۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، قَالَ : کُنَّا نُصَلِّی مَعَ عَبْدِ اللہِ الْجُمُعَۃَ ، ثُمَّ نَرْجِعُ فَنَقِیلُ۔","Sahih","Musannaf Ibn Abi Shaybah 5170","","","كتاب الجمعة"
"5171","(۵۱۷۱) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، قَالَ : حدَّثَنَا أَشْیَاخُنَا مِنْہُمْ : أَبُو سَلَمَۃَ، قَالَ : کُنَّا نَقِیلُ بَعْدَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5171","","","كتاب الجمعة"
"5172","(۵۱۷۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ الأَجْلَحِ ، عَنِ الْحَسَنِ بْنِ عُبَیدِ اللہِ ، قَالَ : سَمِعْتُ ابْنَ أَبِی الْہُذَیْلِ یَقُولُ : کُنَّا نُصَلِّی الْجُمُعَۃَ ، ثُمَّ نَرْجِعُ فَنَقِیلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5172","","","كتاب الجمعة"
"5173","(۵۱۷۳) حَدَّثَنَا شَرِیکٌ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، قَالَ : مَا کَانَ لِلنَّاسِ عِیدٌ إِلاَّ فِی أَوَّلِ النَّہَارِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5173","","","كتاب الجمعة"
"5174","(۵۱۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ ثَابِتِ بْنِ الْحَجَّاجِ الْکِلاَبِیِّ ، عَنْ عَبْدِ اللہِ بْنِ سِیدَانَ السُّلَمِیِّ، قَالَ : شَہِدْتُ الْجُمُعَۃَ مَعَ أَبِی بَکْرٍ الصِّدِّیقِ ، فَکَانَتْ خُطْبَتُہُ وَصَلاَتُہُ قَبْلَ نِصْفِ النَّہَارِ ، ثُمَّ شَہِدْنَا مَعَ عُمَرَ ، فَکَانَتْ خُطْبَتُہُ وَصَلاَتُہُ إِلَی أَنْ أَقُولَ : انْتَصَفَ النَّہَارُ ، ثُمَّ شَہِدْنَا مَعَ عُثْمَانَ ، فَکَانَتْ صَلاَتُہُ وَخُطْبَتُہُ إِلَی أَنْ أَقُولَ : زَالَ النَّہَارُ ، فَمَا رَأَیْتُ أَحَدًا عَابَ ذَلِکَ ، وَلاَ أَنْکَرَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 5174","","","كتاب الجمعة"
"5175","(۵۱۷۵) حَدَّثَنَا جَرِیرٌ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ عَطَائٍ ، قَالَ : کَانَ مَنْ قَبْلَکُمْ یُصَلُّونَ الْجُمُعَۃَ ، وَإِنَّ ظِلَّ الْکَعْبَۃِ کَمَا ہُوَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5175","","","كتاب الجمعة"
"5176","(۵۱۷۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃٍ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، قَالَ : صَلَّی بِنَا عَبْدُ اللہِ الْجُمُعَۃَ ضُحًی ، وَقَالَ : خَشِیتُ عَلَیْکُمُ الْحَرَّ۔","Hasan","Musannaf Ibn Abi Shaybah 5176","","","كتاب الجمعة"
"5177","(۵۱۷۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃٍ ، عَنْ سَعِیدِ بْنِ سُوَیْد ، قَالَ : صَلَّی بِنَا مُعَاوِیَۃُ الْجُمُعَۃَ ضُحًی۔","Hasan","Musannaf Ibn Abi Shaybah 5177","","","كتاب الجمعة"
"5178","(۵۱۷۸) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنَا فُلَیْحُ بْنُ سُلَیْمَانَ ، قَالَ : أَخْبَرَنِی عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ؛ أَنَّہُ سَمِعَ أَنَسَ بْنَ مَالِکٍ ، یَقُولُ : کُنَّا نُصَلِّی مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْجُمُعَۃَ إِذَا مَالَتِ الشَّمْسُ۔ (بخاری ۹۰۴۔ ابوداؤد ۱۰۷۷)","Hasan","Musannaf Ibn Abi Shaybah 5178","","","كتاب الجمعة"
"5179","(۵۱۷۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حَسَنُ بْنُ عَیَّاشٍ ، عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : کُنَّا نُصَلِّی مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْجُمُعَۃَ ، ثُمَّ نَرْجِعُ فَنُرِیحُ نَوَاضِحَنَا۔ قَالَ حَسَنٌ : فَقُلْتُ لِجَعْفَرٍ : وَأَیُّ سَاعَۃٍ تِیکَ ؟ قَالَ : زَوَالُ الشَّمْسِ۔ (مسلم ۲۹)","Sahih","Musannaf Ibn Abi Shaybah 5179","","","كتاب الجمعة"
"5180","(۵۱۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ یَعْلَی بْنِ الْحَارِثِ ، عَنْ إِیَاسِ بْنِ سَلَمَۃَ بْنِ الأَکْوَعِ ، عَنْ أَبِیہِ ، قَالَ : کُنَّا نُصَلِّی مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْجُمُعَۃَ إِذَا زَالَتِ الشَّمْسُ ، ثُمَّ نَرْجِعُ نَتَّبِعُ الْفَیْئَ۔ (بخار ی۴۱۶۸۔ مسلم ۳۲)","Sahih","Musannaf Ibn Abi Shaybah 5180","","","كتاب الجمعة"
"5181","(۵۱۸۱) حَدَّثَنَا وَکِیعٌ، عَنْ أَبِی الْعَنْبَسِ عَمْرِو بْنِ مَرْوَانَ، عَنْ أَبِیہِ، قَالَ: کُنَّا نُجَمِّعُ مَعَ عَلِیٍّ إِذَا زَالَتِ الشَّمْسُ۔","Da'if","Musannaf Ibn Abi Shaybah 5181","","","كتاب الجمعة"
"5182","(۵۱۸۲) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَنْ إِسْمَاعِیلَ بْنِ سُمَیْعٍ ، عَنْ بِلاَلٍ الْعَبْسِیِّ ؛ أَنَّ عَمَّارًا صَلَّی بِالنَّاسِ الْجُمُعَۃَ ، وَالنَّاسُ فَرِیقَانِ : بَعْضُہُمْ یَقُولُ : زَالَتِ الشَّمْسُ ، وَبَعْضُہُمْ یَقُولُ : لَمْ تَزَلْ۔","Hasan","Musannaf Ibn Abi Shaybah 5182","","","كتاب الجمعة"
"5183","(۵۱۸۳) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ یُوسُفَ بْنِ مَاہَکَ ، قَالَ : قدِمَ مُعَاذٌ مَکَّۃَ وَہُمْ یُجَمِّعُونَ فِی الْحِجْرِ ، فَقَالَ : لاَ تُجَمِّعُوا حَتَّی تَفِیئَ الْکَعْبَۃُ مِنْ وَجْہِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 5183","","","كتاب الجمعة"
"5184","(۵۱۸۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانُوا یُصَلُّونَ الْجُمُعَۃَ فِی عَہْدِ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ وَالْفَیْئُ ہُنَیْہَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5184","","","كتاب الجمعة"
"5185","(۵۱۸۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : حدَّثَنَا مَنْصُورٌ ، عَنِ الْحَسَنِ ، قَالَ : وَقْتُ الْجُمُعَۃِ عِنْدَ زَوَالِ الشَّمْسِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5185","","","كتاب الجمعة"
"5186","(۵۱۸۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ إِسْمَاعِیلَ بْنِ سُمَیْعٍ ، عَنْ أَبِی رَزِینٍ ، قَالَ : کُنَّا نُصَلِّی مَعَ عَلِیٍّ الْجُمُعَۃَ ، فَأَحْیَانًا نَجِدُ فَیْئًا ، وَأَحْیَانًا لاَ نَجِدُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 5186","","","كتاب الجمعة"
"5187","(۵۱۸۷) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا الْحَسَنُ ، عَنْ سِمَاکٍ ، قَالَ : کَانَ النُّعْمَانُ بْنُ بَشِیرٍ یُصَلِّی بِنَا الْجُمُعَۃَ بَعْدَ مَا تَزُولُ الشَّمْسُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5187","","","كتاب الجمعة"
"5188","(۵۱۸۸) حَدَّثَتَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِیِّ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ الْوَلِیدِ ، عَنِ الْوَلِیدِ بْنِ الْعَیْزَارِ ، قَالَ : مَا رَأَیْتُ إِمَامًا کَانَ أَحْسَنَ صَلاَۃً لِلْجُمُعَۃِ مِنْ عَمْرِو بْنِ حُرَیْثٍ ، کَانَ یُصَلِّیہَا إِذَا زَالَتِ الشَّمْسُ۔","Sahih","Musannaf Ibn Abi Shaybah 5188","","","كتاب الجمعة"
"5189","(۵۱۸۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : وَقْتُ الْجُمُعَۃِ ، وَقْتُ الظُّہْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5189","","","كتاب الجمعة"
"5190","(۵۱۹۰) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ الرُّؤَاسِیُّ ، عَنِ حَسَنٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی حَازِمٍ ، عن مَوْلًی لآلِ الزُّبَیْرِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْجُمُعَۃُ وَاجِبَۃٌ عَلَی کُلِّ حَالِمٍ ، إِلاَّ أَرْبَعَۃً : الصَّبِیُّ ، وَالْعَبْدُ ، وَالْمَرْأَۃُ ، وَالْمَرِیضُ۔ (بیہقی ۱۸۴)","Da'if","Musannaf Ibn Abi Shaybah 5190","","","كتاب الجمعة"
"5191","(۵۱۹۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ لَیْثٍ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ الْقُرَظِیِّ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ کَانَ یُؤْمِنُ بِاللَّہِ وَالْیَوْمِ الأَخِرِ ، فَعَلَیْہِ الْجُمُعَۃُ یَوْمَ الْجُمُعَۃِ ، إِلاَّ عَلَی امْرَأَۃٍ ، أَوْ صَبِیٍّ ، أَوْ مَمْلُوکٍ ، أَوْ مَرِیضٍ۔","Da'if","Musannaf Ibn Abi Shaybah 5191","","","كتاب الجمعة"
"5192","(۵۱۹۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : لَیْسَ عَلَی النِّسَائِ جُمُعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5192","","","كتاب الجمعة"
"5193","(۵۱۹۳) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ أَبِی فَرْوَۃَ ، قَالَ : سَمِعْتُ الشَّعْبِیُّ یَقُولُ : الْجُمُعَۃ حَقٌ عَلَی کُلِّ مُؤْمِنٍ ، إِلاَّ ثَلاَثَۃٌ : عَبْدٌ مَمْلُوک ، أَوْ مَرِیضٌ ، أَوْ امْرَأَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5193","","","كتاب الجمعة"
"5194","(۵۱۹۴) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنِ الْوَصَّافِیِّ ، قَالَ : کُنْتُ عِنْدَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ فَکَتَبَ إِلَی عَبْدِ الْحَمِیدِ : اُنْظُرْ مَنْ قِبَلَکَ مِنَ النِّسَائِ ، فَلاَ یَحْضُرْنَ جَمَاعَۃً ، وَلاَ جِنَازَۃً ، فَإِنَّہُ لاَ حَقَّ لَہُنَّ فِی جُمُعَۃٍ ، وَلاَ جِنَازَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5194","","","كتاب الجمعة"
"5195","(۵۱۹۵) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لَیْسَ عَلَی الْعَبْدِ جُمُعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5195","","","كتاب الجمعة"
"5196","(۵۱۹۶) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لَیْسَ عَلَی الْعَبْدِ جُمُعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5196","","","كتاب الجمعة"
"5197","(۵۱۹۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ مُسْلِمِ بْنِ نَجِیحٍ ، عَنْ عَبْدِ اللہِ بْنِ مَعْدَانَ ، عَنْ جَدَّتِہِ ، قَالَتْ : قَالَ لَنَا عَبْدُ اللہِ بْنُ مَسْعُودٍ : إِذَا صَلَّیْتُنَّ یَوْمَ الْجُمُعَۃِ مَعَ الإِمَامِ ، فَصَلِّینَ بِصَلاَتِہِ ، وَإذَا صَلَّیْتُنَّ فِی بُیُوتِکُنَّ فَصَلِّینَ أَرْبَعًا۔","Da'if","Musannaf Ibn Abi Shaybah 5197","","","كتاب الجمعة"
"5198","(۵۱۹۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی امْرَأَۃٍ تَحْضُرُ الْمَسْجِدَ یَوْمَ الْجُمُعَۃِ ، أَنَّہَا تُصَلِّی بِصَلاَۃِ الإِمَام وَیُجْزِئُہَا ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5198","","","كتاب الجمعة"
"5199","(۵۱۹۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إِنْ جَمَّعَنْ مَعَ الإِمَامِ ، أَجْزَأَہُنَّ مِنْ صَلاَۃِ الإِمَام۔","No Data Available","Musannaf Ibn Abi Shaybah 5199","","","كتاب الجمعة"
"5200","(۵۲۰۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : کُنَّ النِّسَائُ یُجَمِّعْنَ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَکَانَ یُقَالُ : لاَ تَخْرُجْنَ إِلاَّ تَفِلاَتٍ ، لاَ یُوجَدُ مِنْکُنَّ رِیحُ طِیبٍ۔","","Musannaf Ibn Abi Shaybah 5200","","","كتاب الجمعة"
"5201","(۵۲۰۱) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی الْمَرْأَۃِ تَأْتِی الْجُمُعَۃَ ، قَالَ : تُصَلِّی رَکْعَتَیْنِ یُجْزِئُ عَنْہَا ، وَلَکِنَّہُ لَیْسَ لَہَا أَنْ تَأْتِیَ الْجُمُعَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5201","","","كتاب الجمعة"
"5202","(۵۲۰۲) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : کُنَّ نِسَائُ الْمُہَاجِرِینَ یُصَلِّینَ الْجُمُعَۃَ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ یَحْتَسِبْنَ بِہَا مِنَ الظُّہْرِ۔","","Musannaf Ibn Abi Shaybah 5202","","","كتاب الجمعة"
"5203","(۵۲۰۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، قَالَ : إِنْ صَلَّتْ مَعَ الإِمَامِ أَجْزَأَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5203","","","كتاب الجمعة"
"5204","(۵۲۰۴) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : جَائَ سُلَیْکٌ الْغَطَفَانِیُّ وَالنَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَخْطُبُ یَوْمَ الْجُمُعَۃِ ، فَقَالَ : صَلِّ رَکْعَتَیْنِ تَجَوَّزْ فِیہِمَا۔ (بخاری ۱۱۶۶۔ ترمذی ۵۱۰)","Hasan","Musannaf Ibn Abi Shaybah 5204","","","كتاب الجمعة"
"5205","(۵۲۰۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، وَأَبُو حُرَّۃَ ، وَیُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : جَائَ سُلَیْکٌ الْغَطَفَانِیُّ وَالنَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَخْطُبُ یَوْمَ الْجُمُعَۃِ ، وَلَمْ یَکُنْ صَلَّی الرَّکْعَتَیْنِ ، فَأَمَرَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُصَلِّیَ رَکْعَتَیْنِ یَتَجَوَّزُ فِیہِمَا۔","Da'if","Musannaf Ibn Abi Shaybah 5205","","","كتاب الجمعة"
"5206","(۵۲۰۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو مَعْشَرٍ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَیْثُ أَمَرَہُ أَنْ یُصَلِّیَ رَکْعَتَیْنِ ، أَمْسَکَ عَنِ الْخُطْبَۃِ حَتَّی فَرَغَ مِنْ رَکْعَتَیْہِ ، ثُمَّ عَادَ إِلَی خُطْبَتِہِ۔ (دارقطنی ۱۳)","No Data Available","Musannaf Ibn Abi Shaybah 5206","","","كتاب الجمعة"
"5207","(۵۲۰۷) حَدَّثَنَا حَفْصٌ ، عَنْ حَمَّادِ بْنِ أَبِی الدَّرْدَائِ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یُصَلِّی رَکْعَتَیْنِ وَالإِمَام یَخْطُبُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5207","","","كتاب الجمعة"
"5208","(۵۲۰۸) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ الْحَسَنُ یَجِیئُ وَالإِمَام یَخْطُبُ فَیُصَلِّی رَکْعَتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5208","","","كتاب الجمعة"
"5209","(۵۲۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : إِذَا جِئْتَ وَالإِمَام یَخْطُبُ یَوْمَ الْجُمُعَۃِ ، فَإِنْ شِئْتَ رَکَعْتَ رَکْعَتَیْنِ ، وَإِنْ شِئْتَ جَلَسْتَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5209","","","كتاب الجمعة"
"5210","(۵۲۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ (ح) وَعَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ (ح) وَعَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُمْ کَرِہُوا الصَّلاَۃ وَالإِمَام یَخْطُبُ یَوْمَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5210","","","كتاب الجمعة"
"5211","(۵۲۱۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ یَقُولُ : إِذَا خَرَجَ الإِمَامُ فَلاَ یُصَلِّ أَحَدٌ حَتَّی یَفْرُغَ الإِمَام۔","No Data Available","Musannaf Ibn Abi Shaybah 5211","","","كتاب الجمعة"
"5212","(۵۲۱۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا إِسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، قَالَ : رَأَیْتُ شُرَیْحًا دَخَلَ یَوْمَ الْجُمُعَۃِ مِنْ أَبْوَابِ کِنْدَۃَ فَجَلَسَ ، وَلَمْ یُصَلِّ۔","No Data Available","Musannaf Ibn Abi Shaybah 5212","","","كتاب الجمعة"
"5213","(۵۲۱۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : إِذَا قَعَدَ الإِمَام عَلَی الْمِنْبَرِ فَلاَ صَلاَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5213","","","كتاب الجمعة"
"5214","(۵۲۱۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ فِی الرَّجُلِ یَجِیئُ یَوْمَ الْجُمُعَۃِ وَالإِمَامُ یَخْطُبُ یَجْلِسُ ، وَلاَ یُصَلِّی۔","No Data Available","Musannaf Ibn Abi Shaybah 5214","","","كتاب الجمعة"
"5215","(۵۲۱۵) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ ابْنُ سِیرِینَ یَجْلِسُ ، وَلاَ یُصَلِّی۔","No Data Available","Musannaf Ibn Abi Shaybah 5215","","","كتاب الجمعة"
"5216","(۵۲۱۶) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ ، عَنْ ثَعْلَبَۃَ بْنِ أَبِی مَالِکٍ الْقُرَظِیِّ ، قَالَ : أَدْرَکْتُ عُمَرَ ، وَعُثْمَانَ ، فَکَانَ الإِمَام إِذَا خَرَجَ یَوْمَ الْجُمُعَۃِ تَرَکْنَا الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 5216","","","كتاب الجمعة"
"5217","(۵۲۱۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : خُرُوجُ الإِمَامِ یَقْطَعُ الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 5217","","","كتاب الجمعة"
"5218","(۵۲۱۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، وَابْنِ عُمَرَ ؛ أَنَّہُمَا کَانَا یَکْرَہَانِ الصَّلاَۃ وَالْکَلاَمَ بَعْدَ خُرُوجِ الإِمَام۔","No Data Available","Musannaf Ibn Abi Shaybah 5218","","","كتاب الجمعة"
"5219","(۵۲۱۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ تَوْبَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ شُرَیْحٌ إِذَا أَتَی الْجُمُعَۃَ ، فَإِنْ لَمْ یَکُنْ خَرَجَ الإِمَامُ صَلَّی رَکْعَتَیْنِ ، وَإِنْ کَانَ خَرَجَ جَلَسَ وَاحْتَبَی ، وَاسْتَقْبَلَ الإِمَام ، فَلَمْ یَلْتَفِتْ یَمِینًا ، وَلاَ شِمَالاً۔","No Data Available","Musannaf Ibn Abi Shaybah 5219","","","كتاب الجمعة"
"5220","(۵۲۲۰) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ سِمَاکٍ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : کَانَتْ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خُطْبَتَانِ یَجْلِسُ بَیْنَہُمَا ، یَقْرَأُ الْقُرْآنَ وَیُذَکِّرُ النَّاسَ۔ (مسلم ۳۵۔ ابوداؤد ۱۰۸۷)","Hasan","Musannaf Ibn Abi Shaybah 5220","","","كتاب الجمعة"
"5221","(۵۲۲۱) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَخْطُبُ قَائِمًا ، ثُمَّ یَجْلِسُ ، ثُمَّ یَقُومُ ، یَخْطُبُ خُطْبَتَیْنِ۔ (بیہقی ۱۹۸)","","Musannaf Ibn Abi Shaybah 5221","","","كتاب الجمعة"
"5222","(۵۲۲۲) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : لَمْ یَکُنْ أَبُو بَکْرٍ ، وَلاَ عُمَرُ یَقْعُدَانِ عَلَی الْمِنْبَرِ یَوْمَ الْجُمُعَۃِ ، وَأَوَّلُ مَنْ قَعَدَ مُعَاوِیَۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 5222","","","كتاب الجمعة"
"5223","(۵۲۲۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : خَطَبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَائِمًا ، وَأَبُو بَکْرٍ قَائِمًا ، وَعُثْمَانَ قَائِمًا ، وَإِنَّ أَوَّلَ مَنْ جَلَسَ عَلَی الْمِنْبَرِ مُعَاوِیَۃُ بْنُ أَبِی سُفْیَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 5223","","","كتاب الجمعة"
"5224","(۵۲۲۴) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنِ الْحَسَنِ ، عَنْ إِسْحَاقَ ، قَالَ : رَأَیْتُ عَلِیًّا یَخْطُبُ عَلَی الْمِنْبَرِ ، فَلَمْ یَجْلِسْ حَتَّی فَرَغَ۔","Sahih","Musannaf Ibn Abi Shaybah 5224","","","كتاب الجمعة"
"5225","(۵۲۲۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ کَعْبِ بْنِ عُجْرَۃَ ، قَالَ: دَخَلَ الْمَسْجِدَ وَعَبْدُ الرَّحْمَن بْنُ أُمِّ الْحَکَمِ یَخْطُبُ قَاعِدًا ، فَقَالَ : اُنْظُرُوا إِلَی ہَذَا الْحَدَثِ یَخْطُبُ قَاعِدًا ، قَالَ اللَّہُ تَعَالَی : (وَإِذَا رَأَوْا تِجَارَۃً ، أَوْ لَہْوَا نِانْفَضُّوا إِلَیْہَا وَتَرَکُوکَ قَائِمًا)۔","Sahih","Musannaf Ibn Abi Shaybah 5225","","","كتاب الجمعة"
"5226","(۵۲۲۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : سَأَلَہُ رَجُلٌ ، أَکَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَخْطُبُ قَائِمًا ، أَوْ قَاعِدًا ؟ قَالَ : أَلَسْتَ تَقْرَأُ : {وَتَرَکُوک قَائِمًا}۔","No Data Available","Musannaf Ibn Abi Shaybah 5226","","","كتاب الجمعة"
"5227","(۵۲۲۷) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ سَالِمٍ ، عَنْ جَابِرٍ ، قَالَ : أَقْبَلَتْ عِیرٌ بِتِجَارَۃٍ یَوْمَ جُمُعَۃِ ، وَرَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَخْطُبُ ، فَانْصَرَفَ النَّاسُ یَنْظُرُونَ ، وَبَقِیَ رَسُولُ اللہِ فِی اثْنَیْ عَشَرَ رَجُلاً ، فَنَزَلَتْ ہَذِہِ الأَیَۃُ : { وَإِذَا رَأَوْا تِجَارَۃً ، أَوْ لَہْوَا نِانْفَضُّوا إِلَیْہَا ، وَتَرَکُوکَ قَائِمًا }۔ (بخار ی۴۸۹۹۔ مسلم ۳۸)","Sahih","Musannaf Ibn Abi Shaybah 5227","","","كتاب الجمعة"
"5228","(۵۲۲۸) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : الْجُلُوسُ عَلَی الْمِنْبَرِ یَوْمَ الْجُمُعَۃِ بِدْعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5228","","","كتاب الجمعة"
"5229","(۵۲۲۹) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللہِ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ : کَانَ الْمُغِیرَۃُ یَخْطُبُ فِی الْجُمُعَۃِ قَائِمًا ، وَلَمْ یَکُنْ لَہُ إِلاَّ مُؤَذِّنٌ وَاحِدٌ۔","Sahih","Musannaf Ibn Abi Shaybah 5229","","","كتاب الجمعة"
"5230","(۵۲۳۰) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا حَسَنُ بْنُ صَالِحٍ ، عَنْ سِمَاکٍ ، قَالَ : رَأَیْتُ النُّعْمَانَ یَخْطُبُ قَائِمًا۔","Hasan","Musannaf Ibn Abi Shaybah 5230","","","كتاب الجمعة"
"5231","(۵۲۳۱) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حَدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ صَالِحٍ ، قَالَ : رَأَیْتُ أَبَا ہُرَیْرَۃَ ، وَکَانَ مَرْوَانُ اسْتَخْلَفَہُ عَلَی الْمَدِینَۃِ ، فَکَانَ یَخْطُبُ خُطْبَتَیْنِ ، وَیَجْلِسُ جِلْسَتَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 5231","","","كتاب الجمعة"
"5232","(۵۲۳۲) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ کَانَ یَخْطُبُ یَوْمَ الْجُمُعَۃِ قَائِمًا ، ثُمَّ یَقْعُدُ ، ثُمَّ یَقُومُ فَیَخْطُبُ۔ (احمد ۱/۲۵۷۔ بزار ۶۴۰)","No Data Available","Musannaf Ibn Abi Shaybah 5232","","","كتاب الجمعة"
"5233","(۵۲۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : سُئِلَ عَبْدُ اللہِ عَنِ الْخُطْبَۃِ یَوْمَ الْجُمُعَۃِ ؟ فَقَرَأَ : {وَتَرَکُوک قَائِمًا}۔","No Data Available","Musannaf Ibn Abi Shaybah 5233","","","كتاب الجمعة"
"5234","(۵۲۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی سِنَانٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ : سَأَلْتُ أَبَا عُبَیْدَۃَ عَنِ الْخُطْبَۃِ یَوْمَ الْجُمُعَۃِ ؟ فَقَرَأَ : {وَتَرَکُوک قَائِمًا}۔","No Data Available","Musannaf Ibn Abi Shaybah 5234","","","كتاب الجمعة"
"5235","(۵۲۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ ، عَنِ ابْنِ سِیرِینَ ؛ سُئِلَ عَنْ خُطْبَۃِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ الْجُمُعَۃِ ؟ فَقَرَأَ : {وَتَرَکُوک قَائِمًا}۔","No Data Available","Musannaf Ibn Abi Shaybah 5235","","","كتاب الجمعة"
"5236","(۵۲۳۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ، عَنِ الشَّعْبِیِّ، قَالَ: إِنَّمَا خَطَبَ مُعَاوِیَۃُ قَاعِدًا، حِیْنَ کَثُرَ شَحْمُ بَطْنِہِ وَلَحْمُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 5236","","","كتاب الجمعة"
"5237","(۵۲۳۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْعُمَرِیُّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَخْطُبُ خُطْبَتَیْنِ ، یَجْلِسُ بَیْنَہُمَا۔ (بخاری ۹۲۸۔ مسلم ۵۸۹)","Da'if","Musannaf Ibn Abi Shaybah 5237","","","كتاب الجمعة"
"5238","(۵۲۳۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا مُجَالِدٌ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِذَا صَعِدَ الْمِنْبَرَ یَوْمَ الْجُمُعَۃِ اسْتَقْبَلَ النَّاسَ بِوَجْہِہِ ، فَقَالَ : السَّلاَمُ عَلَیْکُمْ ، وَیَحْمَدُ اللَّہَ وَیُثْنِی عَلَیْہِ وَیَقْرَأُ سُورَۃً، ثُمَّ یَجْلِسُ ، ثُمَّ یَقُومُ فَیَخْطُبُ ، ثُمَّ یَنْزِلُ ۔ وَکَانَ أَبُو بَکْرٍ ، وَعُمَرُ یَفْعَلاَنِہِ۔ (عبدالرزاق ۵۲۸۱)","Da'if","Musannaf Ibn Abi Shaybah 5238","","","كتاب الجمعة"
"5239","(۵۲۳۹) حَدَّثَنَا غَسَّانُ بْنُ مُضَرَ ، عَنْ سَعِیدِ بْنِ یَزِیدَ ، عَنْ أَبِی نَضْرَۃَ ، قَالَ : کَانَ عُثْمَانُ قَدْ کَبُرَ ، فَإِذَا صَعِدَ الْمِنْبَرَ ، سَلَّمَ فَأَطَالَ قَدْرَ مَا یَقْرَأُ إِنْسَانٌ أُمَّ الْکِتَابِ۔","Sahih","Musannaf Ibn Abi Shaybah 5239","","","كتاب الجمعة"
"5240","(۵۲۴۰) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَمْرِو بْنِ مُہَاجِرٍ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَانَ إِذَا اسْتَوَی عَلَی الْمِنْبَرِ سَلَّمَ عَلَی النَّاسِ ، وَرَدُّوا عَلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5240","","","كتاب الجمعة"
"5241","(۵۲۴۱) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ سِمَاکٍ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : کَانَتْ خُطْبَۃُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَصْدًا ، وَصَلاَتُہُ قَصْدًا۔","Hasan","Musannaf Ibn Abi Shaybah 5241","","","كتاب الجمعة"
"5242","(۵۲۴۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، قَالَ : قَالَ : عَبْدُ اللہِ : إِنَّ قِصَرَ الْخُطْبَۃِ وَطُولَ الصَّلاَۃ مَئِنَّۃٌ مِنْ فِقْہِ الرَّجُلِ۔ (بزار ۶۳۸)","Sahih","Musannaf Ibn Abi Shaybah 5242","","","كتاب الجمعة"
"5243","(۵۲۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ ، عَنْ قَیْسٍ ، قَالَ : قَالَ : عَبْدُ اللہِ : أَحْسِنُوا ہَذِہِ الصَّلاَۃ ، وَاقْصِرُوا ہَذِہِ الْخُطْبَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 5243","","","كتاب الجمعة"
"5244","(۵۲۴۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الْعَلاَئِ بْنِ صَالِحٍ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، قَالَ : حدَّثَنَا أَبُو رَاشِدٍ ، قَالَ : خَطَبَنَا عَمَّارٌ ، فَتَجَوَّزَ فِی الْخُطْبَۃِ ، فَقَالَ رَجُلٌ : قَدْ قُلْتَ قَوْلاً شِفَائً لَوْ أَنَّک أَطَلْتَ ، فَقَالَ : إِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی أَنْ نُطِیلَ الْخُطْبَۃَ۔ (ابوداؤد ۱۰۹۹۔ حاکم ۲۸۹)","Da'if","Musannaf Ibn Abi Shaybah 5244","","","كتاب الجمعة"
"5245","(۵۲۴۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ ، عَنْ یَحْیَی بْنِ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ سَعْدِ بْن زُرَارَۃَ ، عَنْ أُمِّ ہِشَامٍ ابْنَۃِ جَارِیَۃَ ، أَوْ حَارِثَۃَ ، قَالَتْ : مَا أَخَذْتُ (ق وَالْقُرْآنِ الْمَجِیدِ) إِلاَّ عَلَی لِسَانِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، یَقْرَؤُہَا عَلَی النَّاسِ فِی کُلِّ یَوْمِ جُمُعَۃٍ إِذَا خَطَبَہُمْ۔ (مسلم ۵۱۔ ابوداؤد ۱۰۹۳)","Hasan","Musannaf Ibn Abi Shaybah 5245","","","كتاب الجمعة"
"5246","(۵۲۴۶) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ عُمَرُ یُعْجِبُہُ أَنْ یَقْرَأَ بِسُورَۃِ آلِ عِمْرَانَ فِی الْجُمُعَۃِ إِذَا خَطَبَ۔","Hasan","Musannaf Ibn Abi Shaybah 5246","","","كتاب الجمعة"
"5247","(۵۲۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ ہَارُونَ بْنِ عَنْتَرَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا قَرَأَ وَہُوَ عَلَی الْمِنْبَرِ : {قُلْ یَا أَیُّہَا الْکَافِرُونَ} وَ {قُلْ ہُوَ اللَّہُ أَحَدٌ}۔","Sahih","Musannaf Ibn Abi Shaybah 5247","","","كتاب الجمعة"
"5248","(۵۲۴۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : نَزَلْنَا الْمَدَائِنَ ، فَکُنَّا مِنْہَا عَلَی رَأْسِ فَرْسَخٍ ، فَجَائَتِ الْجُمُعَۃُ ، فَحَضَرَ أَبِی وَحَضَرْتُ مَعَہُ ، فَخَطَبَنَا حُذَیْفَۃُ ، فَقَالَ : إِنَّ اللَّہَ تَبَارَکَ وَتَعَالَی یَقُولُ : {اقْتَرَبَتِ السَّاعَۃُ وَانْشَقَّ الْقَمَرُ}۔","Da'if","Musannaf Ibn Abi Shaybah 5248","","","كتاب الجمعة"
"5249","(۵۲۴۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ ، عَنْ صَفْوَانَ بْنِ مُحْرِزٍ ، قَالَ : بَیْنَا الأَشْعَرِیُّ یَخْطُبُ یَوْمَ الْجُمُعَۃِ ، إِذْ قَرَأَ السَّجْدَۃَ الآخِرَۃَ فِی سُورَۃِ الْحَجِّ۔","No Data Available","Musannaf Ibn Abi Shaybah 5249","","","كتاب الجمعة"
"5250","(۵۲۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ بْنِ یَحْیَی ، قَالَ : سَمِعْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَقْرَأُ وَہُوَ عَلَی الْمِنْبَرِ : {وَأَنِیبُوا إِلَی رَبِّکُمْ وَأَسْلِمُوا لَہُ} ، وَفِی یَدِہِ عَصًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5250","","","كتاب الجمعة"
"5251","(۵۲۵۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سِمَاکِ بْنِ حَرْبٍ ، قَالَ : قُلْتُ لَہُ : کَیْفَ کَانَ یَخْطُبُ النُّعْمَانُ ؟ قَالَ : کَانَ یَلْمَعُ بِیَدَیْہِ ۔ قَالَ : وَکَانَ الضَّحَّاکُ بْنُ قَیْسٍ إِذَا خَطَبَ ضَمَّ یَدَہُ عَلَی فِیہِ۔","Hasan","Musannaf Ibn Abi Shaybah 5251","","","كتاب الجمعة"
"5252","(۵۲۵۲) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ عُمَارَۃَ بْنِ رُوَیْبَۃَ ؛ رَأَی بِشْرَ بْنَ مَرْوَانَ یَرْفَعُ یَدَیْہِ عَلَی الْمِنْبَرِ ، فَقَالَ : قبَّحَ اللَّہُ ہَاتَیْنِ الْیَدَیْنِ ، لَقَدْ رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَا یَزِیدُ عَلَی أَنْ یَقُولَ بِیَدِہِ ہَکَذَا ، وَأَشَارَ بِإِصْبَعِہِ الْمُسَبِّحَۃِ۔ (ترمذی ۵۱۵۔ ابوداؤد ۱۰۹۷)","Sahih","Musannaf Ibn Abi Shaybah 5252","","","كتاب الجمعة"
"5253","(۵۲۵۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إِذْنُ الإِمَام یَوْمَ الْجُمُعَۃِ أَنْ یُشِیرَ بِیَدِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5253","","","كتاب الجمعة"
"5254","(۵۲۵۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ خَالِدٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانُوا یَسْتَأْذِنُونَ الإِمَام وَہُوَ عَلَی الْمِنْبَرِ ، فَلَمَّا کَانَ زِیَادٌ وَکَثُرَ ذَلِکَ ، قَالَ : مَنْ وَضَعَ یَدَہُ عَلَی أَنْفِہِ فَہُوَ إِذْنُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5254","","","كتاب الجمعة"
"5255","(۵۲۵۵) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : جَائَ سُلَیْکٌ الْغَطَفَانِیُّ وَالنَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَخْطُبُ یَوْمَ الْجُمُعَۃِ ، فَقَالَ لَہُ : صَلَّیْتَ ؟ قَالَ : لاَ ، قَالَ : صَلِّ رَکْعَتَیْنِ ، تَجَوَّزْ فِیہِمَا۔","Hasan","Musannaf Ibn Abi Shaybah 5255","","","كتاب الجمعة"
"5256","(۵۲۵۶) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَخْطُبُ ، فَقَالَ لِلنَّاسِ : اجْلِسُوا ، فَسَمِعَہُ عَبْدُ اللہِ بْنُ مَسْعُودٍ وَہُوَ عَلَی الْبَابِ فَجَلَسَ ، فَقَالَ لَہُ : یَا عَبْدَ اللہِ ، اُدْخُلْ۔ (عبدالرزاق ۵۳۶۸۔ بیہقی ۲۱۸)","","Musannaf Ibn Abi Shaybah 5256","","","كتاب الجمعة"
"5257","(۵۲۵۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، وَابْنُ نُمَیْرٍ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ قَیْسٍ ، قَالَ : جَائَ أَبِی وَالنَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَخْطُبُ ، فَقَامَ بَیْنَ یَدَیْہِ فِی الشَّمْسِ ، فَأَمَرَ بِہِ ، فَحُوِّلَ إِلَی الظِّلِّ۔ (احمد ۳/۴۲۶۔ حاکم ۱۷۱)","","Musannaf Ibn Abi Shaybah 5257","","","كتاب الجمعة"
"5258","(۵۲۵۸) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : إِنْ کَانُوا لَیُسْلِّمُونَ عَلَی الإِمَام وَہُوَ عَلَی الْمِنْبَرِ فَیَرُدُّ۔","No Data Available","Musannaf Ibn Abi Shaybah 5258","","","كتاب الجمعة"
"5259","(۵۲۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہِلاَلِ بْنِ قَیْسٍ ، عَنْ زَیْدِ بْنِ صُوحَانَ ، قَالَ : إِذَا سَمِعْتُ الرَّجُلَ وَالإِمَام یَخْطُبُ یَوْمَ الْجُمُعَۃِ یَتَکَلَّمُ ، فَإِنْ کَانَ قَرِیبًا مِنْک فَاغْمِزْہُ ، وَإِنْ کَانَ بَعِیدًا فَأَشِرْ إِلَیْہِ ، وَلاَ تَرْمِہِ بِالْحَصَی۔","No Data Available","Musannaf Ibn Abi Shaybah 5259","","","كتاب الجمعة"
"5260","(۵۲۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی فَرْوَۃَ ، قَالَ : رَأَیْتُ ابْنَ أَبِی لَیْلَی وَأَشَارَ إِلَی مُحَمَّدِ بْنِ سَعْدٍ ، وَتَکَلَّمَ : أَنِ اسْکُتْ۔","No Data Available","Musannaf Ibn Abi Shaybah 5260","","","كتاب الجمعة"
"5261","(۵۲۶۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ رَأَی رَجُلاً یَتَکَلَّمُ وَالإِمَام یَخْطُبُ یَوْمَ الْجُمُعَۃِ ، فَرَمَاہُ بِحَصًی ، فَلَمَّا نَظَرَ إِلَیْہِ وَضَعَ یَدَہُ عَلَی فِیہِ۔","Sahih","Musannaf Ibn Abi Shaybah 5261","","","كتاب الجمعة"
"5262","(۵۲۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ بُکَیْرِ بْنِ عَامِرٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ؛ فِی الرَّجُلِ یَتَکَلَّمُ وَالإِمَام یَخْطُبُ یَوْمَ الْجُمُعَۃِ ، فَقَالَ : یَضَعُ یَدَہُ عَلَی فِیہِ ، وَلاَ یَرْمِیہِ بِالْحَصَی۔","No Data Available","Musannaf Ibn Abi Shaybah 5262","","","كتاب الجمعة"
"5263","(۵۲۶۳) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یَضَعُ یَدَہُ عَلَی فِیہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5263","","","كتاب الجمعة"
"5264","(۵۲۶۴) حَدَّثَنَا عَبْدُ الْوَہَّابُ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ؛ أَنَّہُ کَانَ یُشِیرُ إِلَی الرَّجُلِ الَّذِی یَتَکَلَّمُ أَنْ یَسْکُتَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5264","","","كتاب الجمعة"
"5265","(۵۲۶۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا بَعْضُ أَشْیَاخِنَا ، عَنِ الْحَسَنِ ؛ أَنَّہُ رَأَی إِنْسَانًا یَتَکَلَّمُ یَوْمَ الْجُمُعَۃِ وَالإِمَام یَخْطُبُ ، فَرَمَاہُ بِالْحَصَی۔","No Data Available","Musannaf Ibn Abi Shaybah 5265","","","كتاب الجمعة"
"5266","(۵۲۶۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ طَاوُوسٍ ، قَالَ : لاَ تُشِرْ إِلَی أَحَدٍ یَوْمَ الْجُمُعَۃِ ، وَلاَ تَنْہَہُ عَنْ شَیْئٍ ، وَلاَ تَدْعُ إِلاَّ أَنْ یَدْعُوَ الإِمَامُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5266","","","كتاب الجمعة"
"5267","(۵۲۶۷) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ إِسْرَائِیلَ ، عَنْ مَجْزَأَۃَ بْنِ زَاہِرٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ رَأَی رَجُلاً یَتَکَلَّمُ یَوْمَ الْجُمُعَۃِ ، فَأَشَارَ إِلَیْہِ أَنِ اُسْکُتْ۔","No Data Available","Musannaf Ibn Abi Shaybah 5267","","","كتاب الجمعة"
"5268","(۵۲۶۸) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ خَالِدِ بْنِ أَبِی عُثْمَانَ ، عَنْ سَعِیدِ بْنِ عَبْدِ اللہِ بْنِ یَسَارٍ ، قَالَ : کُنْتُ مَعَ سَعِیدِ بْنِ جُبَیْرٍ یَوْمَ جُمُعَۃِ وَالإِمَام یَخْطُبُ ، فَمَسِسْتُ الْحَصَی ، فَضَرَبَ یَدِی۔","No Data Available","Musannaf Ibn Abi Shaybah 5268","","","كتاب الجمعة"
"5269","(۵۲۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبَانَ بْنِ عَبْدِ اللہِ الْبَجَلِیِّ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِذَا خَطَبَ اسْتَقْبَلَہُ أَصْحَابُہُ بِوُجُوہِہِمْ۔ (ابن ماجہ ۱۱۳۶)","","Musannaf Ibn Abi Shaybah 5269","","","كتاب الجمعة"
"5270","(۵۲۷۰) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الشَّعْبِیِّ، عَنْ شُرَیْحٍ؛ أَنَّہُ کَانَ یَسْتَقْبِلُ الإِمَامَ یَوْمَ الْجُمُعَۃِ إِذَا خَطَبَ، وَلاَ یَقُولُ ہَکَذَا ، وَلاَ ہَکَذَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5270","","","كتاب الجمعة"
"5271","(۵۲۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ؛ عَمَّنْ رَأَی صَعْصَعَۃَ یَسْتَقْبِلُ الإِمَامَ یَوْمَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5271","","","كتاب الجمعة"
"5272","(۵۲۷۲) حَدَّثَنَا وَکِیعٌ ، عَنْ یُونُسَ ، عَنِ الشَّعْبِیِّ ، قَالَ : مِنَ السُّنَّۃِ أَنْ یُسْتَقْبَلَ الإِمَام یَوْمَ الْجُمُعَۃِ۔","","Musannaf Ibn Abi Shaybah 5272","","","كتاب الجمعة"
"5273","(۵۲۷۳) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ حُمَیْدٍ ، قَالَ : رَأَیْتُ النَّضْرَ بْنَ أَنَسٍ یَسْتَقْبِلُ الإِمَامَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5273","","","كتاب الجمعة"
"5274","(۵۲۷۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، قَالَ : رَأَیْتُ إِبْرَاہِیمَ یَوْمَ الْجُمُعَۃِ دَخَلَ مِمَّا یَلِی أَبْوَابَ کِنْدَۃَ ، فَجَلَسَ وَجَعَلَ وَجْہَہُ قِبَلَ الْمِنْبَرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5274","","","كتاب الجمعة"
"5275","(۵۲۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ وَاصِلِ بْنِ السَّائِبِ الرَّقَاشِیِّ ، قَالَ : رَأَیْتُ عَطَائً ، وَطَاوُوسًا ، وَمُجَاہِدًا یَسْتَقْبِلُونَ الإِمَامَ یَوْمَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5275","","","كتاب الجمعة"
"5276","(۵۲۷۶) حَدَّثَنَا عَبْدُ الصَّمَدِ ، عَنِ الْمُسْتَمِرِّ بْنِ الرَّیَّانِ ، قَالَ : رَأَیْتُ أَنَسًا عِنْدَ الْبَابِ الأَوَّلِ یَوْمَ الْجُمُعَۃِ ، قَدِ اسْتَقْبَلَ الْمِنْبَرَ۔","Sahih","Musannaf Ibn Abi Shaybah 5276","","","كتاب الجمعة"
"5277","(۵۲۷۷) حَدَّثَنَا الْمُحَارِبِیُّ، عَنْ سُفْیَانَ، عَنْ جَابِرٍ، عَنْ سَالِمٍ، وَالْقَاسِمِ؛ أَنَّہُمَا کَانَا یَسْتَقْبِلاَنِ الإِمَام یَوْمَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5277","","","كتاب الجمعة"
"5278","(۵۲۷۸) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ حَکِیمِ بْنِ الدَّیْلَمِ ، عَنْ زَاذَانَ ؛ أَنَّہُ کَانَ یَسْتَقْبِلُ الإِمَام یَوْمَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5278","","","كتاب الجمعة"
"5279","(۵۲۷۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَبْدُ الْحَمِیدِ بْنُ جَعْفَرٍ الأَنْصَارِیُّ ، بِإِسْنَادٍ لاَ أَحْفَظُہُ ، قَالَ : کَانُوا یَجِیئُونَ یَوْمَ الْجُمُعَۃِ فَیَجْلِسُونَ حَوْلَ الْمِنْبَرِ ، ثُمَّ یُقْبِلُونَ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِوُجُوہِہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 5279","","","كتاب الجمعة"
"5280","(۵۲۸۰) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عَمْرِو بْنِ مُہَاجِرٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : الْوَاعِظُ قِبْلَۃٌ ، یَعْنِی الإِمَامُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5280","","","كتاب الجمعة"
"5281","(۵۲۸۱) حَدَّثَنَا أَبُوخَالِدٍ الأَحْمَرِِ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ کَانَ یَحْتَبِی وَالإِمَام یَخْطُبُ۔","Hasan","Musannaf Ibn Abi Shaybah 5281","","","كتاب الجمعة"
