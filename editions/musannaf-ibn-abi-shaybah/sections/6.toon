"5330","(۵۳۳۰) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَمْرِو بْنِ مُہَاجِرٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ؛ أَنَّہُ مَنَعَ الصُّحُفَ أَنْ تُقْرَأَ یَوْمَ الْجُمُعَۃِ ، حَتَّی یَفْرُغَ مِنَ الْخُطْبَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5330","","","كتاب الجمعة"
"5331","(۵۳۳۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی حَیَّانَ ، عَنْ حَمَّادٍ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : إِنَّ الْکُتُبَ تَجِیئُ مِنْ قِبَلِ قُتَیْبَۃَ فِیہَا الْبَاطِلُ وَالْکَذِبُ ، فَإِذَا أَرَدْتُ أُکَلِّمُ صَاحِبِی ، أَوْ أُنْصِتُ ؟ قَالَ : لاَ ، بَلْ أَنْصِتْ ، یَعْنِی فِی الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5331","","","كتاب الجمعة"
"5332","(۵۳۳۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : لَقِیَنِی حَمَّادُ بْنُ أَبِی سُلَیْمَانَ وَالْمُؤَذِّنُونَ یُؤَذِّنُونَ یَوْمَ الْجُمُعَۃِ ، وَقَدْ خَرَجَ الإِمَام ، فَکَلَّمَنِی فَلَمْ أُکَلِّمْہُ ۔ ثُمَّ اجْتَمَعْنَا فِی جُمُعَۃٍ أُخْرَی ، فَکَلَّمَنِی وَالصُّحُفُ تُقْرَأُ ، فَجَعَلَ یُکَلِّمُنِی ، وَلاَ أُکَلِّمُہُ ، فَقَالَ : یَابْنَ أَخِی ، إِنَّمَا کَانَ السُّکُوتُ قَبْلَ الْیَوْمِ إِذَا وَعَظُوا بِکِتَابِ اللہِ ، وَقَالُوا فِیہِ ، فَنَسْکُتُ لِصُحُفِہِمْ ہَذِہِ ؟ ۔ قَالَ ابْنُ عَوْنٍ : فَذَکَرْتُہُ لإِبْرَاہِیمَ ، فَقَالَ إِبْرَاہِیمُ : إِنَّ الشَّیْطَانَ یَأْتِی أَحَدَہُمَ ، اللہُمَّ ، أَوْ نَفْسَہُ ، إِنَّمَا کَانَ السُّکُوتُ قَبْلُ إِذَا وَعَظُوا بِکِتَابِ اللہِ ، وَقَالُوا فِیہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5332","","","كتاب الجمعة"
"5333","(۵۳۳۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یُکْرَہُ الْکَلاَمُ وَالصُّحُفُ تُقْرَأُ ، وَقَالَ الْحَسَنُ : کَانَتِ الصُّحُفُ تُقْرَأُ قَبْلَ الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 5333","","","كتاب الجمعة"
"5334","(۵۳۳۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ خَالِدِ بْنِ عِیسَی ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدَ الْعَزِیزِ یُحَدِّثُ الْوَلِیدَ بْنَ ہِشَامٍ ، وَسُلَیْمَانُ أَمِیرُ الْمُؤْمِنِینَ عَلَی الْمِنْبَرِ ، وَصُحُفٌ تُقْرَأُ فِی یَوْمِ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5334","","","كتاب الجمعة"
"5335","(۵۳۳۵) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنِ الرُّکَیْنِ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ ، قَالَ : کَفَی لَغْوًا إِذَا صَعِدَ الإِمَام الْمِنْبَرَ أَنْ تَقُولَ لِصَاحِبِکَ أَنْصِتْ۔","Sahih","Musannaf Ibn Abi Shaybah 5335","","","كتاب الجمعة"
"5336","(۵۳۳۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : قًلْتُ لِعَلْقَمَۃَ : مَتَی یُکْرَہُ الْکَلاَمُ یَوْمَ الْجُمُعَۃِ ؟ قَالَ : إِذَا صَعِدَ الإِمَامُ الْمِنْبَرَ ، وَإِذَا خَطَبَ الإِمَامُ ، وَإِذَا تَکَلَّمَ الإِمَامُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5336","","","كتاب الجمعة"
"5337","(۵۳۳۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ قَالَ لِصَاحِبِہِ یَوْمَ الْجُمُعَۃِ أَنْصِتْ ، وَالإِمَام یَخْطُبُ ، فَقَدْ لَغَا۔ (عبدالرزاق ۵۴۱۷)","","Musannaf Ibn Abi Shaybah 5337","","","كتاب الجمعة"
"5338","(۵۳۳۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ أَبِی الزِّنَادِ ، عَنِ الأَعْرَجِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : إِذَا قُلْتَ لِصَاحِبِکَ أَنْصِتْ ، فَقَدْ لَغَوْتَ۔","Sahih","Musannaf Ibn Abi Shaybah 5338","","","كتاب الجمعة"
"5339","(۵۳۳۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ ، عَنْ ثَعْلَبَۃَ بْنِ أَبِی مَالِکٍ الْقُرَظِیِّ ، قَالَ: أَدْرَکْتُ عُمَرَ ، وَعُثْمَانَ ، فَکَانَ الإِمَامُ إِذَا خَرَجَ یَوْمَ الْجُمُعَۃِ تَرَکْنَا الصَّلاَۃ، فَإِذَا تَکَلَّمَ تَرَکْنَا الْکَلاَمَ۔","Sahih","Musannaf Ibn Abi Shaybah 5339","","","كتاب الجمعة"
"5340","(۵۳۴۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، وَابْنِ عُمَرَ ؛ أَنَّہُمَا کَانَا یَکْرَہَانِ الصَّلاَۃ وَالْکَلاَمَ یَوْمَ الْجُمُعَۃِ بَعْدَ خُرُوجِ الإِمَامِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5340","","","كتاب الجمعة"
"5341","(۵۳۴۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُصَلِّی یَوْمَ الْجُمُعَۃِ ،فَإِذَا خَرَجَ الإِمَامُ لَمْ یُصَلِّ۔","No Data Available","Musannaf Ibn Abi Shaybah 5341","","","كتاب الجمعة"
"5342","(۵۳۴۲) حَدَّثَنَا ابْنُ عُلَیَّۃُ ، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ: خُرُوجُ الإِمَامِ یَقْطَعُ الصَّلاَۃَ، وَکَلاَمُہُ یَقْطَعُ الْکَلاَمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5342","","","كتاب الجمعة"
"5343","(۵۳۴۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ؛ أَنَّہُ کَرِہَ الْکَلاَمَ وَالإِمَام یَخْطُبُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5343","","","كتاب الجمعة"
"5344","(۵۳۴۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَشْعَثَ ، عَنِ الزُّہْرِیِّ ، قَالَ : خُرُوجُ الإِمَام یَقْطَعُ الصَّلاَۃَ ، وَکَلاَمُہُ یَقْطَعُ الْکَلاَمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5344","","","كتاب الجمعة"
"5345","(۵۳۴۵) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ إِبْرَاہِیمَ ، عَن نَافِعٍ ، عَنْ سَعِیدِ بْنِ أَبِی ہِنْدٍ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : إِذَا قَالَ الرَّجُلُ یَوْمَ الْجُمُعَۃِ وَالإِمَام یَخْطُبُ أَنْصِتْ ، فَقَدْ لَغَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5345","","","كتاب الجمعة"
"5346","(۵۳۴۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ ، عَنْ عَلْقَمَۃَ بْنِ عَبْدِ اللہِ ، قَالَ : قدِمْنَا الْمَدِینَۃَ یَوْمَ الْجُمُعَۃِ ، فَأَمَرْتُ أَصْحَابِی أَنْ یَرْتَحِلُوا ، ثُمَّ أَتَیْتُ الْمَسْجِدَ ، فَجَلَسْتُ قَرِیبًا مِنِ ابْنِ عُمَرَ ، فَجَائَ رَجُلٌ مِنْ أَصْحَابِی ، فَجَعَلَ یُحَدِّثُنِی وَالإِمَامُ یَخْطُبُ ، فَعلْنَا کَذَا وَکَذَا ، فَلَمَّا أَکْثَرَ قُلْتُ لَہُ : اُسْکُتْ ، فَلَمَّا قَضَیْنَا الصَّلاَۃ ذَکَرْتُ ذَلِکَ لْاِبْنِ عُمَرَ ، فَقَالَ : أَمَّا أَنْتَ فَلاَ جُمُعَۃَ لَکَ ، وَأَمَّا صَاحِبُک فَحِمَارٌ۔","Sahih","Musannaf Ibn Abi Shaybah 5346","","","كتاب الجمعة"
"5347","(۵۳۴۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا دَاوُد بْنُ أَبِی ہِنْدٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ أَبَا ذَرٍّ ، أَوِ الزُّبَیْرَ بْنَ الْعَوَّامِ ، سَمِعَ أَحَدُہُمَا مِنَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ آیَۃً یَقْرَؤُہَا وَہُوَ عَلَی الْمِنْبَرِ یَوْمَ الْجُمُعَۃِ ، قَالَ : فَقَالَ لِصَاحِبِہِ : مَتَی أُنْزِلَتْ ہَذِہِ الأَیَۃُ ؟ قَالَ : فَلَمَّا قَضَی صَلاَتَہُ ، قَالَ لَہُ عُمَرُ بْنُ الْخَطَّابِ : لاَ جُمُعَۃَ لَکَ ، فَأَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَذَکَرَ ذَلِکَ لَہُ ، قَالَ : فَقَالَ : صَدَقَ عُمَرُ۔","","Musannaf Ibn Abi Shaybah 5347","","","كتاب الجمعة"
"5348","(۵۳۴۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُجَالِدٍ ، عَنْ عَامِرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ تَکَلَّمَ یَوْمَ الْجُمُعَۃِ وَالإِمَامُ یَخْطُبُ فَہُوَ کَالْحِمَارِ یَحْمِلُ أَسْفَارًا ، وَالَّذِی یَقُولُ لَہُ أَنْصِتْ لَیْسَتْ لَہُ جُمُعَۃٌ۔ (احمد ۱/۲۳۰)","Da'if","Musannaf Ibn Abi Shaybah 5348","","","كتاب الجمعة"
"5349","(۵۳۴۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، عَنْ عَامِرٍ ، عَنْ جَابِرٍ ، قَالَ : قَالَ سَعْدٌ لِرَجُلٍ یَوْمَ الْجُمُعَۃِ : لاَ صَلاَۃَ لَکَ، قَالَ : فَذَکَرَ ذَلِکَ الرَّجُلُ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، إِنَّ سَعْدًا قَالَ : لاَ صَلاَۃَ لَکَ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لِمَ یَا سَعْدُ ؟ قَالَ : إِنَّہُ تَکَلَّمَ وَأَنْتَ تَخْطُبُ ، فَقَالَ : صَدَقَ سَعْدٌ۔ (بزار ۶۴۲۔ ابو یعلی ۷۰۸)","Da'if","Musannaf Ibn Abi Shaybah 5349","","","كتاب الجمعة"
"5350","(۵۳۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ إِبْرَاہِیمَ السَّکْسَکِیِّ ، قَالَ : سَمِعْتُ ابْنَ أَبِی أَوْفَی ، قَالَ : ثَلاَثَۃٌ مَنْ سَلِمَ مِنْہُنَّ غُفِرَ لَہُ مَا بَیْنَہُ وَبَیْنَ الْجُمُعَۃِ الأُخْرَی ؛ مِنْ أَنْ یُحْدِثَ حَدَثًا لاَ یَعْنِی أَذًی مِنْ بَطْنِہِ ، أَوْ أَنْ یَتَکَلَّمَ ، أَوْ یَقُولَ : صَہْ۔","Hasan","Musannaf Ibn Abi Shaybah 5350","","","كتاب الجمعة"
"5351","(۵۳۵۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : إِذَا قَالَ یَوْمَ الْجُمُعَۃِ وَالإِمَام یَخْطُبُ : صَہٍ ، فَقَدْ لَغَا۔","Sahih","Musannaf Ibn Abi Shaybah 5351","","","كتاب الجمعة"
"5352","(۵۳۵۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : أَخْبَرَنَا إِسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، قَالَ : رَأَیْتُ إِبْرَاہِیمَ یُکَلِّمُ رَجُلاً وَالإِمَام یَخْطُبُ یَوْمَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5352","","","كتاب الجمعة"
"5353","(۵۳۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أَیْمَنَ بْنِ نَابِلٍ ، عَنْ إِسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ عُرْوَۃَ بْنِ الزُّبَیْرِ ، قَالَ : کَانَ لاَ یَرَی بَأْسًا بِالْکَلاَمِ إِذَا لَمْ یَسْمَعِ الْخُطْبَۃَ یَوْمَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5353","","","كتاب الجمعة"
"5354","(۵۳۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ بْنِ إِبْرَاہِیمَ ، عَن أَبِیہِ ، قَالَ : رَأَیْتُ إِبْرَاہِیمَ ، وَسَعِیدَ بْنَ جُبَیْرٍ یَتَکَلَّمَانِ وَالْحَجَّاجُ یَخْطُبُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5354","","","كتاب الجمعة"
"5355","(۵۳۵۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ بُرْدِ بْنِ سِنَانٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رُبَّمَا کُلِّمَ فِی الْحَاجَۃِ یَوْمَ الْجُمُعَۃِ فِیمَا بَیْنَ نُزُولِہِ مِنْ مِنْبَرِہِ إِلَی مُصَلاَّہُ۔ (ابوداؤد ۶۳)","","Musannaf Ibn Abi Shaybah 5355","","","كتاب الجمعة"
"5356","(۵۳۵۶) حَدَّثَنَا یَحْیَی بْنُ سُلَیْمٍ الطَّائِفِیُّ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : أَدْرَکْتُ أَبِی وَمَنْ مَضَی مِمَّنْ یَرْضَاہُ وَنَأْخُذُ عَنْہُمْ ، لاَ یَرَوْنَ بَأْسًا بِالْکَلاَمِ حِینَ یَنْزِلُ الإِمَامُ مِنَ الْمِنْبَرِ إِلَی أَنْ یَدْخُلَ فِی الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 5356","","","كتاب الجمعة"
"5357","(۵۳۵۷) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ، عَنْ إِبْرَاہِیمَ بْنِ مَیْسَرَۃَ، قَالَ: کَلَّمَنِی طَاوُوسٌ بَعْدَ مَا نَزَلَ سُلَیْمَانُ مِنَ الْمِنْبَرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5357","","","كتاب الجمعة"
"5358","(۵۳۵۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ؛ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا أَنْ یَتَکَلَّمَ فِیمَا بَیْنَ نُزُولِہِ إِلَی أَنْ یُکَبِّرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5358","","","كتاب الجمعة"
"5359","(۵۳۵۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حَجَّاجٌ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالْکَلاَمِ حَتَّی یَخْطُبَ ، وَإِذَا فَرَغَ مِنَ الْخُطْبَۃِ حَتَّی یَدْخُلَ فِی الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 5359","","","كتاب الجمعة"
"5360","(۵۳۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنِ الْکَلاَمِ إِذَا خَرَجَ الإِمَام حَتَّی یَتَکَلَّمَ ، وَإِذَا نَزَلَ قَبْلَ أَنْ یُصَلِّیَ ؟ فَکَرِہَہُ الْحَکَمُ ، وَقَالَ حَمَّادٌ : لاَ بَأْسَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5360","","","كتاب الجمعة"
"5361","(۵۳۶۱) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ قَتَادَۃَ ، قَالَ : یَتَکَلَّمُ مَا لَمْ یَجْلِسْ۔","No Data Available","Musannaf Ibn Abi Shaybah 5361","","","كتاب الجمعة"
"5362","(۵۳۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْزِلُ یَوْمَ الْجُمُعَۃِ مِنَ الْمِنْبَرِ ، فَیَقُومُ مَعَہُ الرَّجُلُ فَیُکَلِّمُہُ فِی الْحَاجَۃِ ، ثُمَّ یَنْتَہِی إِلَی مُصَلاَّہُ فَیُصَلِّی۔ (ترمذی ۵۱۷۔ ابوداؤد ۱۱۱۳)","Sahih","Musannaf Ibn Abi Shaybah 5362","","","كتاب الجمعة"
"5363","(۵۳۶۳) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ : رَأَیْتُ إِبْرَاہِیمَ ، وَإِبْرَاہِیمَ بْنَ مُہَاجِرٍ یَتَکَلَّمَانِ یَوْمَ الْجُمُعَۃِ وَالإِمَامُ یَخْطُبُ ، فَلَقِیتُ إِبْرَاہِیمَ بْنَ مُہَاجِرٍ بَعْدَ ذَلِکَ ، فَذَکَرْتُ ذَلِکَ لَہُ ، فَقَالَ : إِنَّا کُنَّا صَلَّیْنَا ۔ وَکَانَ الإِمَامُ الْحَجَّاجَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5363","","","كتاب الجمعة"
"5364","(۵۳۶۴) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ: کَانَ یُقَالُ: لاَ کَلاَمَ بَعْدَ أَنْ یَنْزِلَ الإِمَام مِنَ الْمِنْبَرِ حَتَّی یَقْضِیَ الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 5364","","","كتاب الجمعة"
"5365","(۵۳۶۵) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : نُبِّئْتُ عَنْ إِبْرَاہِیمَ أَنَّہُ کَرِہَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5365","","","كتاب الجمعة"
"5366","(۵۳۶۶) حَدَّثَنَا عَبْدُاللہِ بْنُ مُبَارَکٍ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ (ح) وَعَنِ ابْنِ الْمُبَارَکِ ، عَنِ الْحَسَنِ (ح) وَعَنِ ابْنِ عُلاَثَۃَ ، عَنِ الزُّہْرِیِّ ؛ فِی الَّذِی یَتَکَلَّمُ وَالإِمَامُ یَخْطُبُ یَوْمَ الْجُمُعَۃِ ، قَالُوا : یُصَلِّی رَکْعَتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5366","","","كتاب الجمعة"
"5367","(۵۳۶۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ہِشَامُ بْنُ أَبِی عَبْدِ اللہِ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، قَالَ : حُدِّثْتُ عَنْ عُمَرَ بْنِ الْخَطَّابِ أَنَّہُ قَالَ : إِنَّمَا جُعِلَتِ الْخُطْبَۃُ مَکَانَ الرَّکْعَتَیْنِ ، فَإِنْ لَمْ یُدْرِکِ الْخُطْبَۃَ فَلْیُصَلِّ أَرْبَعًا۔","Da'if","Musannaf Ibn Abi Shaybah 5367","","","كتاب الجمعة"
"5368","(۵۳۶۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا دَاودُ بْنُ أَبِی ہِنْدٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ یَقُولُ : إِذَا لَمْ یُدْرِکِ الْخُطْبَۃَ فَلْیُصَلِّ أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5368","","","كتاب الجمعة"
"5369","(۵۳۶۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ ؛ قَالُوا : إِذَا فَاتَتْہُ الْخُطْبَۃُ یَوْمَ الْجُمُعَۃِ صَلَّی أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5369","","","كتاب الجمعة"
"5370","(۵۳۷۰) حَدَّثَنَا مُعْتَمِرٌ، عَنْ أَبِیہِ ، قَالَ: بَلَغَنِی عَنْ عَطَائٍ، وَطَاوُوسٍ ، قَالاَ: مَنْ فَاتَہُ الْقَصَصُ یَوْمَ الْجُمُعَۃِ فَلْیُصَلِّ أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5370","","","كتاب الجمعة"
"5371","(۵۳۷۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : إِذَا فَاتَتْہُ الْخُطْبَۃُ صَلَّی أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5371","","","كتاب الجمعة"
"5372","(۵۳۷۲) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ مُوسَی بْنِ عَبْدِ الْوَاحِدِ الرَّمْلِیِّ ، قَالَ : سَمِعْتُ عَطَائَ بْنَ یَزِیدَ اللَّیْثِیَّ ، قَالَ : إِذَا فَاتَتْہُ الْخُطْبَۃُ فَلْیُصَلِّ أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5372","","","كتاب الجمعة"
"5373","(۵۳۷۳) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : ذُکِرَ لِمُحَمَّدٍ قَوْلُ أَہْلِ مَکَّۃَ ، إِذَا لَمْ یُدْرِکِ الْخُطْبَۃَ صَلَّی أَرْبَعًا ، فَقَالَ : لَسَ(۳ ہَذَا بِشَیْئٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5373","","","كتاب الجمعة"
"5374","(۵۳۷۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ ، قَالَ : کَانَتِ الْجُمُعَۃُ أَرْبَعًا ، فَجُعِلَتْ رَکْعَتَیْنِ مِنْ أَجْلِ الْخُطْبَۃِ ، فَمَنْ فَاتَتْہُ الْخُطْبَۃُ فَلْیُصَلِّ أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5374","","","كتاب الجمعة"
"5375","(۵۳۷۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا زَکَرِیَّا بْنُ أَبِی زَائِدَۃَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَص ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ أَدْرَکَ رَکْعَۃً مِنَ الْجُمُعَۃِ فَلْیُصَلِّ إِلَیْہَا أُخْرَی ، وَمَنْ لَمْ یُدْرِکِ الرُّکُوعَ فَلْیُصَلِّ أَرْبَعًا۔","Sahih","Musannaf Ibn Abi Shaybah 5375","","","كتاب الجمعة"
"5376","(۵۳۷۶) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَص ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ أََدْرَکَ الْجُمُعَۃَ فَہِیَ رَکْعَتَانِ ، وَمَنْ لَمْ یُدْرِکْ فَلْیُصَلِّ أَرْبَعًا۔","Sahih","Musannaf Ibn Abi Shaybah 5376","","","كتاب الجمعة"
"5377","(۵۳۷۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَنْ أَدْرَکَ مِنَ الْجُمُعَۃِ رَکْعَۃً فَلْیُضِفْ إِلَیْہَا أُخْرَی۔","No Data Available","Musannaf Ibn Abi Shaybah 5377","","","كتاب الجمعة"
"5378","(۵۳۷۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ ، قَالَ : قَالَ أَبُو مَعْمَرٍ : شَیْئٌ وَدِدْتُ أَنِّی کُنْتُ سَأَلْتُ عَنْہُ الأَسْوَدَ ، قَالَ : قَالَ إِبْرَاہِیمُ : وَمَا ہُوَ ؟ فَلَعَلَّک قَدْ کُفِیتَہُ ، قَالَ : الرَّجُلُ یُدْرِکُ مِنَ الْجُمُعَۃِ رَکْعَۃً ؟ قَالَ : قَالَ الأَسْوَدُ : مَنْ أَدْرَکَ مِنَ الْجُمُعَۃِ رَکْعَۃً فَلْیُصَلِّ رَکْعَۃً أُخْرَی ، وَمَنْ لَمْ یُدْرِکِ الرُّکُوعَ فَلْیُصَلِّ أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5378","","","كتاب الجمعة"
"5379","(۵۳۷۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ (ح) وَمُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ (ح) وَإِسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالُوا : مَنْ أَدْرَکَ رَکْعَۃً مِنَ الْجُمُعَۃِ فَلْیُضِفْ إِلَیْہَا أُخْرَی ، وَمَنْ لَمْ یُدْرِکِ الرُّکُوعَ فَلْیُصَلِّ أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5379","","","كتاب الجمعة"
"5380","(۵۳۸۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا إِسْمَاعِیلُ بْنُ سَالِمٍ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یَقُولُ : مَنْ أَدْرَکَ الْخُطْبَۃَ فَہِیَ الْجُمُعَۃُ ، وَمَنْ أَدْرَکَ رَکْعَتَیْنِ فَہِیَ الْجُمُعَۃُ ، وَمَنْ أَدْرَکَ رَکْعَۃً فَقَدْ أَدْرَکَ الْجُمُعَۃَ ، فَلْیُصَلِّ رَکْعَۃً أُخْرَی ، وَمَنْ لَمْ یُدْرِکِ الرُّکُوعَ فَلْیُصَلِّ أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5380","","","كتاب الجمعة"
"5381","(۵۳۸۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ لَمْ یُدْرِکِ الرُّکُوعَ یَوْمَ الْجُمُعَۃِ فَلْیُصَلِّ أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5381","","","كتاب الجمعة"
"5382","(۵۳۸۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، وَسَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّہُمَا قَالاَ : مَنْ أَدْرَکَ مِنَ الْجُمُعَۃِ رَکْعَۃً فَلْیُصَلِّ إِلَیْہَا أُخْرَی۔","Da'if","Musannaf Ibn Abi Shaybah 5382","","","كتاب الجمعة"
"5383","(۵۳۸۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ حُسَیْنِ بْنِ ذَکْوَانَ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ، قَالاَ : إِذَا أَدْرَکَ رَکْعَۃً مِنَ الْجُمُعَۃِ أَضَافَ إِلَیْہَا أُخْرَی۔","No Data Available","Musannaf Ibn Abi Shaybah 5383","","","كتاب الجمعة"
"5384","(۵۳۸۴) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ ، وَعَلْقَمَۃَ ، قَالاَ : إِذَا أَدْرَکْتَ مِنْ الْجُمُعَۃِ رَکْعَۃً فَأَضِفْ إِلَیْہَا أُخْرَی۔","No Data Available","Musannaf Ibn Abi Shaybah 5384","","","كتاب الجمعة"
