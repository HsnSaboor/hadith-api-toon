hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"1801","36 - (  1803  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  يَعْقُوبُ ،  أَخْبَرَنَا  عِيسَى بْنُ جَارِيَةَ ،  عَنْ  جَابِرٍ ، قَالَ :  جَاءَ  ابْنُ أُمِّ مَكْتُومٍ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي مَكْفُوفُ الْبَصَرِ شَاسِعُ الْمَنْزِلِ ، فَكَلَّمَهُ فِي الصَّلَاةِ أَنْ يُرَخِّصَ لَهُ أَنْ يُصَلِّيَ فِي مَنْزِلِهِ ، قَالَ :  أَتَسْمَعُ الْأَذَانَ ؟ قَالَ : نَعَمْ ، قَالَ : ائْتِهَا وَلَوْ  حَبْوًا  .         [3/338]             [3/339]","","Musnad Abi Ya'la al-Mawsili 1803","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عيسى بن جارية الأنصاري عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند جابر"
"1802","37 - (  1804  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  يَعْقُوبُ ،  حَدَّثَنَا  عِيسَى بْنُ جَارِيَةَ ،  عَنْ  جَابِرٍ ، قَالَ :  أَمَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِقَتْلِ الْكِلَابِ  ، فَجَاءَ  ابْنُ أُمِّ مَكْتُومٍ  ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّ مَنْزِلِي شَاسِعٌ ، وَلِي كَلْبٌ ، فَرَخَّصَ لَهُ أَيَّامًا ، ثُمَّ أَمَرَ بِقَتْلِهِ  .","","Musnad Abi Ya'la al-Mawsili 1804","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عيسى بن جارية الأنصاري عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند جابر"
"1803","38 - (  1805  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  أَبِي الزُّبَيْرِ ،         [3/340]      عَنْ  جَابِرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  مَنْ  أَحْيَا  أَرْضًا مَيِّتَةً فَلَهُ فِيهَا أَجْرٌ ، وَمَا أَكَلَتِ  الْعَافِيَةُ  يَعْنِي الطَّيْرَ وَالسِّبَاعَ  ، فَهُوَ لَهُ صَدَقَةٌ  .         [3/341]","","Musnad Abi Ya'la al-Mawsili 1805","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند جابر"
"1804","39 - (  1806  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ  الْمُحَاقَلَةِ  ،  وَالْمُزَابَنَةِ  ،  وَالْمُخَابَرَةِ  ،  وَالْمُعَاوَمَةِ  ،  وَالثُّنْيَا  .         [3/342]             [3/343]","","Musnad Abi Ya'la al-Mawsili 1806","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن أيوب السختياني عن حماد بن زيد عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند جابر"
"1805","40 - (  1807  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  حَمَّادُ بْنُ شُعَيْبٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يُدْخَلَ الْمَاءُ إِلَّا بِمِئْزَرٍ  .","","Musnad Abi Ya'la al-Mawsili 1807","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حماد بن شعيب الحماني عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند جابر"
"1806","41 - (  1808  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  حَمَّادُ بْنُ شُعَيْبٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  ذَكَاةُ  الْجَنِينِ  ذَكَاةُ  أُمِّهِ إِذَا أَشْعَرَ  .         [3/344]","","Musnad Abi Ya'la al-Mawsili 1808","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حماد بن شعيب الحماني عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند جابر"
"1807","42 - (  1809  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  مُعْتَمِرٌ ،  حَدَّثَنَا  أَبُو إِسْمَاعِيلَ ،  عَنْ  أَبِي الزُّبَيْرِ ، وَالْوَلِيدِ بْنِ عَبْدِ اللهِ بْنِ أَبِي مُغِيثٍ ،  عَنْ  جَابِرٍ ، أَنَّ نَبِيَّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَا تَأْذَنُوا لِمَنْ لَمْ يَبْدَأْ بِالسَّلَامِ  .         [3/345]","","Musnad Abi Ya'la al-Mawsili 1809","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الوليد بن عبد الله بن أبي مغيث العبدري عن إبراهيم بن يزيد الخوزي عن معتمر بن سليمان عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند جابر"
"1808","43 - (  1810  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  مَالِكٍ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  رَمَلَ  مِنَ الْحَجَرِ الْأَسْوَدِ  حَتَّى انْتَهَى إِلَى الْحَجَرِ الْأَسْوَدِ الثَّلَاثَةَ أَطْوَافٍ  .","","Musnad Abi Ya'la al-Mawsili 1810","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن مالك بن أنس عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند جابر"
"1809","44 - (  1811  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  حَفْصُ بْنُ أَبِي دَاوُدَ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ :  عَادَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَرِيضًا وَأَنَا مَعَهُ فَرَآهُ يُصَلِّي وَيَسْجُدُ عَلَى وِسَادَةٍ ، فَنَهَاهُ  ، وَقَالَ : إِنِ اسْتَطَعْتَ أَنْ         [3/346]      تَسْجُدَ عَلَى الْأَرْضِ فَاسْجُدْ ، وَإِلَّا فَأَوْمِئْ إِيمَاءً ، وَاجْعَلِ السُّجُودَ أَخْفَضَ مِنَ الرُّكُوعِ  .","","Musnad Abi Ya'la al-Mawsili 1811","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن حفيص الأسدي عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند جابر"
"1810","45 - (  1812  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  سَلَّامٌ يَعْنِي ابْنَ سُلَيْمٍ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي حُمَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَلَا أَدُلُّكُمْ عَلَى مَا يُنْجِيكُمْ مِنْ عَدُوِّكُمْ وَيَدِرُّ لَكُمْ أَرْزَاقَكُمْ ؟  تَدْعُونَ اللهَ فِي لَيْلِكُمْ وَنَهَارِكُمْ ، فَإِنَّ الدُّعَاءَ سِلَاحُ الْمُؤْمِنِ  .","","Musnad Abi Ya'la al-Mawsili 1812","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن محمد بن أبي حميد الزرقي عن سلام بن سليم الحنفي عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند جابر"
"1811","46 - (  1813  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَنْصَارِيُّ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ مُسْلِمٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  يَزِيدَ الرَّقَاشِيِّ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  حَدَّثَنَا  جَابِرُ بْنُ عَبْدِ اللهِ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  عَسَى أَنْ         [3/347]      يُكَذِّبَنِي رَجُلٌ وَهُوَ مُتَّكِئٌ عَلَى  أَرِيكَتِهِ  يَبْلُغُهُ الْحَدِيثُ عَنِّي ، فَيَقُولُ : مَا قَالَ ذَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، دَعْ هَذَا وَهَاتِ مَا فِي الْقُرْآنِ  .  47 - (  1814  ) - قَالَ  إِسْمَاعِيلُ  : فَحَدَّثْتُ بِهِ  عَمْرَو بْنَ عُبَيْدٍ  ، فَقَالَ : لَا ، حَدَّثَنَا  الْحَسَنُ  ، عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ  ، قَالَ : قُلْتُ : فَانْطَلِقْ بِنَا إِلَى  الْحَسَنِ ،  فَأَتَيْنَا  الْحَسَنَ  فَسَأَلْنَاهُ عَنِ الْحَدِيثِ ، فَقَالَ حَدَّثَنِي  يَزِيدُ الرَّقَاشِيُّ  ، عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ  ، عَنْ  جَابِرٍ  ...","","Musnad Abi Ya'la al-Mawsili 1813","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن يزيد بن أبان الرقاشي عن الحسن البصري عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن محمد بن عبد الله بن المثنى الخزرجي عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند جابر"
"1812","48 - (  1815  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو خَالِدٍ الْأَحْمَرُ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ارْكَبُوا الْهَدْيَ بِالْمَعْرُوفِ حَتَّى تَجِدُوا ظَهْرًا  .         [3/348]","","Musnad Abi Ya'la al-Mawsili 1815","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن سليمان بن حيان الأحمر عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1813","49 - (  1816  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ : أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ طَرْقِ الْفَحْلِ  .","","Musnad Abi Ya'la al-Mawsili 1816","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1814","50 - (  1817  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،         [3/349]      عَنْ  جَابِرٍ : أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ مَنْعِ  فَضْلِ  الْمَاءِ لِيُمْنَعَ بِهِ  الْكَلَأُ  .","","Musnad Abi Ya'la al-Mawsili 1817","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1815","51 - (  1818  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنِ  الْأَجْلَحِ ،  عَنِ  الذَّيَّالِ بْنِ حَرْمَلَةَ الْأَسَدِيِّ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ :  اجْتَمَعَتْ  قُرَيْشٌ  لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمًا ، فَقَالُوا : انْظُرُوا أَعْلَمَكُمْ بِالسِّحْرِ وَالْكَهَانَةِ وَالشِّعْرِ  ، فَلْيَأْتِ هَذَا الرَّجُلَ الَّذِي قَدْ فَرَّقَ جَمَاعَتَنَا ، وَشَتَّتَ أَمْرَنَا ، وَعَابَ دِينَنَا ، فَلْيُكَلِّمْهُ وَلْيَنْظُرْ مَا يَرُدُّ عَلَيْهِ ، قَالُوا : مَا نَعْلَمُ أَحَدًا غَيْرَ  عُتْبَةَ بْنِ رَبِيعَةَ  ، قَالُوا : أَنْتَ يَا  أَبَا الْوَلِيدِ  ، فَأَتَاهُ  عُتْبَةُ  ، فَقَالَ : يَا  مُحَمَّدُ  ، أَنْتَ خَيْرٌ أَمْ  عَبْدُ اللهِ  ؟ فَسَكَتَ رَسُولُ اللهِ ، ثُمَّ قَالَ : أَنْتَ خَيْرٌ أَمْ  عَبْدُ الْمُطَّلِبِ  ؟ فَسَكَتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،         [3/350]      قَالَ : فَإِنْ كُنْتَ تَزْعُمُ أَنَّ هَؤُلَاءِ خَيْرٌ مِنْكَ فَقَدْ عَبَدُوا الْآلِهَةَ الَّتِي عِبْتَ ، وَإِنْ كُنْتَ تَزْعُمُ أَنَّكَ خَيْرٌ مِنْهُمْ فَتَكَلَّمْ حَتَّى نَسْمَعَ قَوْلَكَ ، إِنَّا وَاللهِ مَا رَأَيْنَا سَخْلَةً قَطُّ أَشْأَمَ عَلَى قَوْمِكَ مِنْكَ ، فَرَّقْتَ جَمَاعَتَنَا ، وَشَتَّتَّ أَمْرَنَا ، وَعِبْتَ دِينَنَا ، فَفَضَحْتَنَا فِي الْعَرَبِ ، حَتَّى لَقَدْ طَارَ فِيهِمْ أَنَّ فِي  قُرَيْشٍ  سَاحِرًا ، وَأَنَّ فِي  قُرَيْشٍ  كَاهِنًا  ، وَاللهِ مَا نَنْتَظِرُ إِلَّا مِثْلَ صَيْحَةِ الْحُبْلَى بِأَنْ يَقُومَ بَعْضُنَا إِلَى بَعْضٍ بِالسُّيُوفِ حَتَّى نَتَفَانَى ، أَيُّهَا الرَّجُلُ ، إِنْ كَانَ إِنَّمَا بِكَ الْحَاجَةُ جَمَعْنَا حَتَّى تَكُونَ أَغْنَى  قُرَيْشٍ  رَجُلًا ، وَإِنْ كَانَ إِنَّمَا بِكَ  الْبَاءَةُ  فَاخْتَرْ أَيَّ نِسَاءِ  قُرَيْشٍ  شِئْتَ فَنُزَوِّجُكَ عَشْرًا .  قَالَ لَهُ رَسُولُ اللهِ : أَفَرَغْتَ ؟ قَالَ : نَعَمْ ، قَالَ : فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ         {      حم             *          تَنْـزِيلٌ مِنَ الرَّحْمَنِ الرَّحِيمِ         }      ، حَتَّى بَلَغَ :         {      فَإِنْ أَعْرَضُوا فَقُلْ أَنْذَرْتُكُمْ صَاعِقَةً مِثْلَ صَاعِقَةِ عَادٍ وَثَمُودَ         }      .  فَقَالَ  عُتْبَةُ  : حَسْبُكَ حَسْبُكَ ، مَا عِنْدَكَ غَيْرُ هَذَا ؟ قَالَ : لَا ، فَرَجَعَ إِلَى  قُرَيْشٍ  ، فَقَالُوا : مَا وَرَاءَكَ ؟ قَالَ : مَا تَرَكْتُ شَيْئًا أَرَى أَنَّكُمْ تُكَلِّمُونَهُ بِهِ إِلَّا كَلَّمْتُهُ ، قَالُوا : هَلْ أَجَابَكَ ؟ قَالَ : نَعَمْ ، وَالَّذِي نَصَبَهَا بَنِيَّةً ، مَا فَهِمْتُ شَيْئًا مِمَّا قَالَ غَيْرَ أَنَّهُ قَالَ :         {      أَنْذَرْتُكُمْ صَاعِقَةً مِثْلَ صَاعِقَةِ عَادٍ وَثَمُودَ         }      .         [3/351]      قَالُوا : وَيْلَكَ يُكَلِّمُكَ رَجُلٌ بِالْعَرَبِيَّةِ لَا تَدْرِي مَا قَالَ ؟ قَالَ : لَا ، وَاللهِ مَا فَهِمْتُ شَيْئًا مِمَّا قَالَ غَيْرَ ذِكْرِ الصَّاعِقَةِ  .         [3/352]","","Musnad Abi Ya'la al-Mawsili 1818","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الذيال بن حرملة الأسدي عن أجلح بن عبد الله الكندي عن علي بن مسهر القرشي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1816","52 - (  1819  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنِ  الْأَجْلَحِ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، قَالَ :  لَمَّا قَدِمَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  مَكَّةَ  أُتِيَ  بِأَبِي قُحَافَةَ  وَرَأْسُهُ وَلِحْيَتُهُ كَأَنَّهُمَا  ثَغَامَةٌ  ، فَقَالَ :  غَيِّرُوا الشَّيْبَ ، وَاجْتَنِبُوا السَّوَادَ  .","","Musnad Abi Ya'la al-Mawsili 1819","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن أجلح بن عبد الله الكندي عن شريك بن عبد الله النخعي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1817","53 - (  1820  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  حُسَيْنُ بْنُ عَلِيٍّ ،  عَنْ  زَائِدَةَ ،  عَنِ  ابْنِ عَقِيلٍ ،  عَنْ  جَابِرٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  نَادِ يَا  عُمَرُ  فِي النَّاسِ : أَنَّهُ مَنْ مَاتَ يَعْبُدُ اللهَ مُخْلِصًا مِنْ قَلْبِهِ أَدْخَلَهُ اللهُ الْجَنَّةَ  ، وَحَرَّمَ عَلَيْهِ النَّارَ ، قَالَ : فَقَالَ  عُمَرُ  : يَا رَسُولَ اللهِ ، أَفَلَا أُبَشِّرُ النَّاسَ ؟ قَالَ :         [3/353]      لَا ، لَا يَتَّكِلُوا  .","","Musnad Abi Ya'la al-Mawsili 1820","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن زائدة بن قدامة عن الحسين بن علي الجعفي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1818","54 - (  1821  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  حُسَيْنُ بْنُ عَلِيٍّ ،  عَنْ  زَائِدَةَ ،  عَنِ  ابْنِ عَقِيلٍ ،  عَنْ  جَابِرٍ ،  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِأَبِي بَكْرٍ  :  مَتَى تُوتِرُ ؟ قَالَ : مِنْ أَوَّلِ اللَّيْلِ بَعْدَ  الْعَتَمَةِ  ، ثُمَّ قَالَ  لِعُمَرَ  : مَتَى تُوتِرُ ؟  قَالَ : مِنْ آخِرِ اللَّيْلِ ، قَالَ  لِأَبِي بَكْرٍ  : أَخَذْتَ  بِالْحَزْمِ ،  وَقَالَ  لِعُمَرَ  : أَخَذْتَ بِالْقُوَّةِ  .         [3/354]","","Musnad Abi Ya'la al-Mawsili 1821","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن زائدة بن قدامة عن الحسين بن علي الجعفي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1819","55 - (  1822  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  يُونُسُ بْنُ مُحَمَّدٍ ،  عَنْ  مُفَضَّلِ بْنِ فَضَالَةَ ،  عَنْ  حَبِيبِ بْنِ الشَّهِيدِ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ :  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَخَذَ بِيَدِ  مَجْذُومٍ  فَوَضَعَهَا مَعَهُ فِي الْقَصْعَةِ  ، فَقَالَ : كُلْ بِاسْمِ اللهِ ثِقَةً بِاللهِ ، وَتَوَكُّلًا عَلَيْهِ  .         [3/355]","","Musnad Abi Ya'la al-Mawsili 1822","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن حبيب بن الشهيد عن المفضل بن فضالة بن أبي أمية العمري عن يونس بن محمد بن مسلم البغدادي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1820","56 - (  1823  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  يُونُسُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  حَدَّثَنَا  مُجَالِدُ بْنُ سَعِيدٍ ،  حَدَّثَنِي  الشَّعْبِيُّ ،  عَنْ  جَابِرٍ ،  أَنَّ امْرَأَتَيْنِ مِنْ  هُذَيْلٍ  قَتَلَتْ إِحْدَاهُمَا الْأُخْرَى ، وَلِكُلِّ وَاحِدَةٍ مِنْهُمَا زَوْجٌ وَوَلَدٌ ،  فَجَعَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دِيَةَ الْمَقْتُولِ عَلَى عَاقِلَةِ الْقَاتِلَةِ  ، وَبَرَّأَ زَوْجَهَا وَوَلَدَهَا ، قَالَ : فَقَالَ عَاقِلَةُ الْمَقْتُولِ : مِيرَاثُهَا لَنَا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : لَا ، مِيرَاثُهَا لِزَوْجِهَا وَوَلَدِهَا ، قَالَ : وَكَانَتْ حُبْلَى ، فَقَالَتْ عَاقِلَةُ الْمَقْتُولَةِ : إِنَّهَا كَانَتْ حُبْلَى ، وَأَلْقَتْ جَنِينًا ، قَالَ : فَخَافَ عَاقِلَةُ الْقَاتِلَةِ أَنْ يُضَمِّنَهُمْ ، قَالَ : فَقَالُوا : يَا رَسُولَ اللهِ ، لَا شَرِبَ ، وَلَا أَكَلَ ، وَلَا صَاحَ ، فَاسْتَهَلَّ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَسَجْعُ الْجَاهِلِيَّةِ ؟ فَقَضَى فِي الْجَنِينِ  غُرَّةً  : عَبْدٌ أَوْ أَمَةٌ  .         [3/356]","","Musnad Abi Ya'la al-Mawsili 1823","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن مجالد بن سعيد عن عبد الواحد بن زياد عن يونس بن محمد بن مسلم البغدادي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1821","57 - (  1824  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  سَمِعَ  عَمْرٌو جَابِرَ بْنَ عَبْدِ اللهِ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي غَزَاةٍ ،  فَكَسَعَ  رَجُلٌ مِنَ الْمُهَاجِرِينَ  رَجُلًا مِنَ الْأَنْصَارِ  ، فَقَالَ الْأَنْصَارِيُّ : يَا         [3/357]      لَلْأَنْصَارِ  ، فَقَالَ الْمُهَاجِرِيُّ : يَا  لَلْمُهَاجِرِينَ  ، فَسَمِعَ ذَلِكَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : مَا بَالُ  دَعْوَى  الْجَاهِلِيَّةِ ؟ قِيلَ : يَا رَسُولَ اللهِ ،  كَسَعَ  رَجُلٌ مِنَ  الْمُهَاجِرِينَ  رَجُلًا مِنَ  الْأَنْصَارِ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  دَعُوهَا  فَإِنَّهَا  مُنْتِنَةٌ  .","","Musnad Abi Ya'la al-Mawsili 1824","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1822","58 - (  1825  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،         [3/358]      سَمِعَ  عَمْرٌو جَابِرَ بْنَ عَبْدِ اللهِ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَاعَ مُدَبَّرًا  .         [3/359]","","Musnad Abi Ya'la al-Mawsili 1825","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1823","59 - (  1826  ) -  وَبِهِ  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْحَرْبُ  خَدْعَةٌ  .","","Musnad Abi Ya'la al-Mawsili 1826","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1824","60 - (  1827  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  سَمِعَ  عَمْرٌو ،  عَنْ  جَابِرٍ ، قَالَ :  كَانَ  مُعَاذٌ  يُصَلِّي مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، ثُمَّ يَرْجِعُ فَيَؤُمُّ         [3/360]      قَوْمَهُ ، فَأَخَّرَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَيْلَةً الصَّلَاةَ ، فَجَاءَ فَقَرَأَ سُورَةَ الْبَقَرَةِ ، فَقَالَ لَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَفَتَّانٌ  يَا  مُعَاذُ  ؟  .         [3/361]","","Musnad Abi Ya'la al-Mawsili 1827","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1825","61 - (  1828  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ ،  سَمِعَ  عَمْرٌو ، جَابِرًا ، قَالَ :  أَتَاهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَعْنِي  عَبْدَ اللهِ بْنَ أُبَيٍّ  - بَعْدَمَا أُدْخِلَ حُفْرَتَهُ  فَأَمَرَ بِهِ فَأُخْرِجَ ، فَنَفَثَ عَلَيْهِ مِنْ رِيقِهِ وَأَلْبَسَهُ قَمِيصَهُ ، وَاللهُ أَعْلَمُ  .         [3/362]","","Musnad Abi Ya'la al-Mawsili 1828","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1826","62 - (  1829  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  سُفْيَانُ ،  سَمِعَ  عَمْرٌو ، جَابِرًا ، قَالَ :  لَمَّا أُنْزِلَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :         {      قُلْ هُوَ الْقَادِرُ عَلَى أَنْ يَبْعَثَ عَلَيْكُمْ عَذَابًا مِنْ فَوْقِكُمْ         }      ، قَالَ : أَعُوذُ بِوَجْهِكَ  ،         {      أَوْ مِنْ تَحْتِ أَرْجُلِكُمْ         }      ، قَالَ : أَعُوذُ بِوَجْهِكَ ،         {      أَوْ يَلْبِسَكُمْ شِيَعًا وَيُذِيقَ بَعْضَكُمْ بَأْسَ بَعْضٍ         }      ، قَالَ : هَاتَانِ أَهْوَنُ أَوْ أَيْسَرُ  .","","Musnad Abi Ya'la al-Mawsili 1829","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1827","63 - (  1830  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ ،  سَمِعَ  عَمْرٌو جَابِرًا ،  دَخَلَ رَجُلٌ الْمَسْجِدَ وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ ،         [3/363]      فَقَالَ :  أَصَلَّيْتَ ؟ قَالَ : لَا : قَالَ : فَصَلِّ رَكْعَتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 1830","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1828","64 - (  1831  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ ،  سَمِعَ  عَمْرٌو ،         [3/364]      عَنْ  جَابِرٍ ، سَمِعَ أُذُنَايَ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  :  يَخْرُجُ أَقْوَامٌ مِنَ النَّارِ فَيَدْخُلُونَ الْجَنَّةَ  .","","Musnad Abi Ya'la al-Mawsili 1831","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1829","65 - (  1832  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ ،  سَمِعَ  عَمْرٌو ،  عَنْ  جَابِرٍ ، قَالَ :  أَطْعَمَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَحْمَ الْخَيْلِ ، وَنَهَانَا عَنْ لُحُومِ الْحُمُرِ  الْأَهْلِيَّةِ  .         [3/365]","","Musnad Abi Ya'la al-Mawsili 1832","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1830","66 - (  1833  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ ، قَالَ : قُلْتُ لِعَمْرٍو :  أَسَمِعْتَ  جَابِرًا يَقُولُ :  مَرَّ  رَجُلٌ  بِسِهَامٍ فِي الْمَسْجِدِ ، فَأَمَرَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يُمْسِكَ بِنِصَالِهَا ؟  قَالَ : نَعَمْ  .","","Musnad Abi Ya'la al-Mawsili 1833","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1831","67 - (  1834  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ ،  سَمِعَ  عَمْرٌو ، جَابِرًا :  نَهَى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ  الْمُخَابَرَةِ  .         [3/366]","","Musnad Abi Ya'la al-Mawsili 1834","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1832","68 - (  1835  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ  أَنَّ  طَارِقًا  قَضَى  بِالْعُمْرَى  لِلْوَارِثِ  ،  عَنْ  قَوْلِ جَابِرٍ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .         [3/367]","","Musnad Abi Ya'la al-Mawsili 1835","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سليمان بن يسار مولى ميمونة زوج رسول الله عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1833","68 - (  1835  - مُكَرَّرٌ ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  سَمِعَ  جَابِرًا يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَيُّكُمْ كَانَتْ لَهُ أَرْضٌ أَوْ نَخْلٌ فَلَا يَبِعْهَا حَتَّى يَعْرِضَهَا عَلَى شَرِيكِهِ  .","","Musnad Abi Ya'la al-Mawsili 1835","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1834","69 - (  1836  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَمَرَ  بِلَعْقِ  الصَّحْفَةِ  وَلَعْقِ  الْأَصَابِعِ  ،         [3/368]      فَإِنَّهُ لَا يُدْرَى فِي أَيِّ ذَلِكَ الْبَرَكَةُ  .","","Musnad Abi Ya'la al-Mawsili 1836","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1835","70 - (  1837  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  أَطْفِئُوا الْمَصَابِيحَ  .         [3/369]","","Musnad Abi Ya'la al-Mawsili 1837","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1836","71 - (  1838  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  لَمْ  نُبَايِعِ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى الْمَوْتِ ، إِنَّمَا بَايَعْنَاهُ عَلَى أَنْ لَا نَفِرَّ  .","","Musnad Abi Ya'la al-Mawsili 1838","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1837","72 - (  1839  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي الزُّبَيْرِ ،         [3/370]      عَنْ  جَابِرٍ قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَبِيعَ  حَاضِرٌ  لِبَادٍ  .","","Musnad Abi Ya'la al-Mawsili 1839","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1838","73 - (  1840  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ،  أَنَّ  رَجُلًا  قَالَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : رَأَيْتُ كَأَنَّ عُنُقِي ضُرِبَتْ ، أَوْ رَأْسِي انْقَطَعَ ، قَالَ :  لِمَ يُخْبِرُ أَحَدُكُمْ بِتَلَعُّبِ الشَّيْطَانِ  ؟  .         [3/371]","","Musnad Abi Ya'la al-Mawsili 1840","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1839","74 - (  1841  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ بَيْعِ  الثَّمَرِ  حَتَّى يَبْدُوَ صَلَاحُهُ  .         [3/372]","","Musnad Abi Ya'la al-Mawsili 1841","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1840","75 - (  1842  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الْأَسْوَدِ بْنِ قَيْسٍ ،  عَنْ  نُبَيْحٍ الْعَنَزِيِّ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَمَرَ بِالْقَتْلَى :  قَتْلَى أُحُدٍ  أَنْ يُرَدُّوا إِلَى مَصَارِعِهِمْ  ، وَكَانَ قَدْ نُقِلَ بَعْضُهُمْ إِلَى  الْمَدِينَةِ  ، أَوْ مَنْ شَاءَ اللهُ مِنْهُمْ  .","","Musnad Abi Ya'la al-Mawsili 1842","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن نبيح بن عبد الله العنزي عن الأسود بن قيس العبدي عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1841","76 - (  1843  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الْأَسْوَدِ بْنِ         [3/373]      قَيْسٍ ،  عَنْ  نُبَيْحٍ الْعَنَزِيِّ ،  عَنْ  جَابِرٍ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى أَنْ تَطْرُقُوا النِّسَاءَ لَيْلًا  ، قَالَ  جَابِرٌ  : ثُمَّ طَرَقْنَاهُنَّ بَعْدُ  .         [3/374]","","Musnad Abi Ya'la al-Mawsili 1843","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن نبيح بن عبد الله العنزي عن الأسود بن قيس العبدي عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1842","77 - (  1844  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  حُمَيْدٍ الْأَعْرَجِ ،  عَنْ  سُلَيْمَانَ بْنِ عَتِيقٍ ،  عَنْ  جَابِرٍ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ بَيْعِ  السِّنِينَ  .","","Musnad Abi Ya'la al-Mawsili 1844","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سليمان بن عتيق المحاربي عن حميد بن قيس الأعرج عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1843","78 - (  1845  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ  الْمُحَاقَلَةِ ،  وَالْمُزَابَنَةِ  ،  وَالْمُخَابَرَةِ  ، وَعَنْ بَيْعِ  الثَّمَرِ  حَتَّى يَبْدُوَ صَلَاحُهُ ،         [3/375]      وَأَنْ لَا يُبَاعَ إِلَّا بِالدَّنَانِيرِ وَالدَّرَاهِمِ ، إِلَّا الْعَرَايَا  .","","Musnad Abi Ya'la al-Mawsili 1845","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن ابن جريج عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1844","79 - (  1846  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ، قَالَ :  سَمِعَ  جَعْفَرٌ أَبَاهُ  يُحَدِّثُهُ ، عَنْ  جَابِرٍ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَغْرِفُ عَلَى رَأْسِهِ ثَلَاثًا ،  يَعْنِي : فِي الْغُسْلِ  .         [3/376]","","Musnad Abi Ya'la al-Mawsili 1846","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1845","80 - (  1847  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  هُشَيْمُ بْنُ بَشِيرٍ ،  حَدَّثَنَا  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 1847","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن هشيم بن بشير عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1846","81 - (  1848  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  هُشَيْمٌ ،  حَدَّثَنَا  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَلَا لَا يَبِيتَنَّ رَجُلٌ عِنْدَ امْرَأَةٍ فِي بَيْتٍ ، إِلَّا أَنْ يَكُونَ نَاكِحًا أَوْ ذَا  مَحْرَمٍ  .         [3/377]","","Musnad Abi Ya'la al-Mawsili 1848","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن هشيم بن بشير عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1847","82 - (  1849  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  هُشَيْمُ بْنُ بَشِيرٍ ،  حَدَّثَنَا  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  لَعَنَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  آكِلَ  الرِّبَا ، وَمُوكِلَهُ ، وَكَاتِبَهُ  ، وَشَاهِدَيْهِ ، وَقَالَ : هُمْ سَوَاءٌ  .","","Musnad Abi Ya'la al-Mawsili 1849","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن هشيم بن بشير عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1848","83 - (  1850  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  هُشَيْمٌ ،  أَخْبَرَنَا  سَيَّارٌ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  خَرَجْنَا فِي غَزَاةٍ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : فَلَمَّا قَفَلْنَا تَعَجَّلْتُ عَلَى بَعِيرٍ لِي  قَطُوفٍ  ، قَالَ : فَلَحِقَنِي رَاكِبٌ مِنْ خَلْفِي  فَنَخَسَ  بَعِيرِي  بِعَنَزَةٍ  كَانَتْ مَعَهُ ، فَسَارَ بَعِيرِي كَأَجْوَدِ مَا أَنْتَ رَاءٍ مِنَ الْإِبِلِ ، فَالْتَفَتُّ ، فَإِذَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : مَا يُعْجِلُكَ ؟ قَالَ : قُلْتُ : إِنِّي حَدِيثُ عَهْدٍ  بِعُرْسٍ  ، قَالَ : بِكْرًا تَزَوَّجْتَ أَمْ  ثَيِّبًا  ؟ قَالَ : قُلْتُ :  ثَيِّبًا  ، قَالَ : فَهَلَّا جَارِيَةً تُلَاعِبُهَا وَتُلَاعِبُكَ ، قَالَ : فَلَمَّا رَجَعُوا ، قَالَ :         [3/378]      أَمْهِلُوا حَتَّى نَدْخُلَ لَيْلًا عِشَاءً ، كَيْ تَمْتَشِطَ الشَّعِثَةُ ،  وَتَسْتَحِدَّ  الْمُغِيبَةُ  .","","Musnad Abi Ya'la al-Mawsili 1850","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن سيار بن أبي سيار العنزي عن هشيم بن بشير عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1849","84 - (  1851  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  هُشَيْمٌ ،  أَخْبَرَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْعُمْرَى  جَائِزَةٌ لِأَهْلِهَا  .         [3/379]","","Musnad Abi Ya'la al-Mawsili 1851","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن داود بن أبي هند عن هشيم بن بشير عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1850","85 - (  1852  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  هُشَيْمٌ ،  أَخْبَرَنَا  لَيْثٌ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ حَيْثُ  أَفَاضَ  مِنْ  عَرَفَاتٍ  :  أَيُّهَا النَّاسُ عَلَيْكُمُ  السَّكِينَةَ  وَالْوَقَارَ  ، وَلَا يَقْتُلْ بَعْضُكُمْ بَعْضًا  .","","Musnad Abi Ya'la al-Mawsili 1852","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن الليث بن سعد عن هشيم بن بشير عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1851","86 - (  1853  ) -  حَدَّثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ الزُّبَيْرِيُّ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  أَلَا أُخْبِرُكُمْ عَلَى مَنْ         [3/380]      تَحْرُمُ النَّارُ غَدًا ؟ عَلَى كُلِّ هَيِّنٍ لَيِّنٍ قَرِيبٍ سَهْلٍ  .","","Musnad Abi Ya'la al-Mawsili 1853","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن هشام بن عروة بن الزبير عن عبد الله بن مصعب بن ثابت الزبيري عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","مسند جابر"
"1852","87 - (  1854  ) -  حَدَّثَنَا  عُبَيْدُ بْنُ جَنَّادٍ الْحَلَبِيُّ ،  حَدَّثَنَا  يُوسُفُ بْنُ مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  سُئِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، عَنِ الْإِيمَانِ ؟ قَالَ : الصَّبْرُ وَالسَّمَاحَةُ  .         [3/381]","","Musnad Abi Ya'la al-Mawsili 1854","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن يوسف بن محمد بن المنكدر القرشي عن عبيد بن جناد الرقي عن أبو يعلى الموصلي","مسند جابر"
"1853","88 - (  1855  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ ،  حَدَّثَنَا  الْمُغِيرَةُ بْنُ سِقْلَابٍ ،  أَخْبَرَنَا  مَعْقِلُ بْنُ عُبَيْدِ اللهِ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ ضَمِنَ لِي مَا بَيْنَ لَحْيَيْهِ ، وَمَا بَيْنَ رِجْلَيْهِ ، ضَمِنْتُ لَهُ الْجَنَّةَ  .","","Musnad Abi Ya'la al-Mawsili 1855","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن معقل بن عبيد الله الجزري عن مغيرة بن سقلاب الحراني عن الوليد بن شجاع عن أبو يعلى الموصلي","مسند جابر"
"1854","89 - (  1856  ) -  حَدَّثَنَا  عَبْدُ الْغَفَّارِ بْنُ عَبْدِ اللهِ ،  حَدَّثَنَا  الْمُعَافَى بْنُ عِمْرَانَ ،  حَدَّثَنَا  الْفُضَيْلُ بْنُ مَرْزُوقٍ ،  حَدَّثَنِي  الْوَلِيدُ رَجُلٌ         [3/382]      مِنْ أَهْلِ الْخَيْرِ وَالصَّلَاحِ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ وَهُوَ عَلَى مِنْبَرِهِ يَوْمَ جُمُعَةٍ :  يَا أَيُّهَا النَّاسُ تُوبُوا إِلَى اللهِ قَبْلَ أَنْ تَمُوتُوا ، وَبَادِرُوا بِالْأَعْمَالِ الصَّالِحَةِ  ، وَصِلُوا الَّذِي بَيْنَكُمْ وَبَيْنَ رَبِّكُمْ بِكَثْرَةِ ذِكْرِكُمْ إِيَّاهُ ، وَبِكَثْرَةِ صَدَقَتِكُمْ فِي السِّرِّ وَالْعَلَانِيَةِ ، تُؤْجَرُوا ، وَتُنْصَرُوا ، وَتُرْزَقُوا ، وَاعْلَمُوا أَنَّ اللهَ قَدِ افْتَرَضَ عَلَيْكُمُ الْجُمُعَةَ فَرِيضَةً مَفْرُوضَةً فِي يَوْمِي هَذَا ، وَمَقَامِي هَذَا ، فِي شَهْرِي هَذَا ، فِي عَامِي هَذَا ، إِلَى يَوْمِ الْقِيَامَةِ ، فَمَنْ تَرَكَهَا ، فِي حَيَاتِي أَوْ بَعْدَ مَوْتِي ، جُحُودًا بِهَا ، أَوِ اسْتِخْفَافًا بِهَا ، فَلَا جَمَعَ اللهُ لَهُ شَمْلَهُ ، وَلَا بَارَكَ لَهُ فِي أَمْرِهِ ، أَلَا وَلَا صَلَاةَ لَهُ ، أَلَا وَلَا زَكَاةَ لَهُ ، أَلَا وَلَا حَجَّ لَهُ ، وَلَا صَوْمَ لَهُ ، أَلَا وَلَا بِرَّ لَهُ ، فَمَنْ تَابَ ، تَابَ اللهُ عَلَيْهِ ، وَلَا تَؤُمَّنَّ امْرَأَةٌ رَجُلًا ، وَلَا يَؤُمَّنَّ أَعْرَابِيٌّ مُهَاجِرًا ، وَلَا يَؤُمَّنَّ فَاجِرٌ بَرًّا إِلَّا سُلْطَانٌ يَخَافُ سَيْفَهُ وَسَوْطَهُ  .         [3/383]","","Musnad Abi Ya'la al-Mawsili 1856","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سعيد بن المسيب عن أبو جعفر الباقر عن الوليد عن فضيل بن مرزوق الأغر عن المعافى بن عمران عن عبد الغفار بن عبد الله بن الزبير الزبيري عن أبو يعلى الموصلي","مسند جابر"
"1855","90 - (  1857  ) -  حَدَّثَنَا  عِيسَى بْنُ سَالِمٍ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنِ  ابْنِ عَقِيلٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  جَاءَ رَجُلٌ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  يَا رَسُولَ اللهِ ، أَرَأَيْتَ إِنْ جَاهَدْتُ فِي  سَبِيلِ  اللهِ صَابِرًا ، مُحْتَسِبًا ، مُقْبِلًا غَيْرَ مُدْبِرٍ ، حَتَّى أُقْتَلَ ، أَدْخُلُ الْجَنَّةَ ؟ قَالَ : نَعَمْ  ، إِلَّا أَنْ يَكُونَ عَلَيْكَ دَيْنٌ ، لَيْسَ عِنْدَكَ لَهُ وَفَاءٌ  .         [3/384]","","Musnad Abi Ya'la al-Mawsili 1857","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن عبيد الله بن عمرو بن أبي الوليد عن عيسى بن سالم الشاشي عن أبو يعلى الموصلي","مسند جابر"
"1856","91 - (  1858  ) -  حَدَّثَنَا  دَاوُدُ بْنُ عَمْرِو بْنِ زُهَيْرٍ الضَّبِّيُّ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ،  أَنَّ  رَجُلًا  قَالَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنِّي رَأَيْتُ كَأَنَّ رَأْسِي قُطِعَتْ ، أَوْ عُنُقِي ضُرِبَتْ ، فَقَالَ : لِمَ يُخْبِرُ أَحَدُكُمْ بِتَلَعُّبِ الشَّيْطَانِ  ؟  .","","Musnad Abi Ya'la al-Mawsili 1858","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان بن عيينة عن داود بن عمرو المسيبي عن أبو يعلى الموصلي","مسند جابر"
"1857","92 - (  1859  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ،  حَدَّثَنَا  هُشَيْمُ بْنُ بَشِيرٍ ،  أَخْبَرَنَا  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، قَالَ رَسُولُ اللهِ :  لَا يَبِيتَنَّ رَجُلٌ عِنْدَ امْرَأَةٍ فِي بَيْتٍ إِلَّا أَنْ يَكُونَ نَاكِحًا ، أَوْ ذَا  مَحْرَمٍ  .","","Musnad Abi Ya'la al-Mawsili 1859","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن هشيم بن بشير عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند جابر"
"1858","93 - (  1860  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ مِهْرَانَ السَّبَّاكُ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  حَرَامِ بْنِ عُثْمَانَ ،  عَنْ  مَحْمُودِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَمْرِو بْنِ الْجَمُوحِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  ابْتَعْنَا بَقَرَةً فِي عَهْدِ نَبِيِّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِنَشْتَرِكَ عَلَيْهَا ، فَانْفَلَتَتْ مِنَّا ، فَامْتَنَعَتْ عَلَيْنَا ، فَعَرَضَ لَهَا مَوْلًى لَنَا يُقَالُ لَهُ :  ذَكْوَانُ  بِسَيْفٍ فِي يَدِهِ وَهِيَ تَجُولُ بِالصِّمَادِ ، فَضَبَا إِلَى         [3/385]      تَلٍّ ، فَلَمَّا مَرَّتْ بِهِ ضَرَبَهَا بِالسَّيْفِ فِي أَصْلِ عُنُقِهَا ، أَوْ عَلَى عُنُقِهَا ، فَخَرَقَهَا بِالسَّيْفِ وَوَقَعَتْ ، فَلَمْ يُدْرِكْ ذَكَاتَهَا ، فَخَرَجْتُ أَنَا  وَعَبْدُ اللهِ بْنُ ثَابِتِ بْنِ الْجِذْعِ  ، فَلَقِيَنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرْنَا لَهُ شَأْنَهَا ، فَقَالَ : كُلُوا ،  إِذَا فَاتَكُمْ مِنْ هَذِهِ الْبَهَائِمِ شَيْءٌ ، فَاحْبِسُوهُ بِمَا تَحْبِسُونَ بِهِ الْوَحْشَ  .","","Musnad Abi Ya'la al-Mawsili 1860","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمود بن عبد الرحمن بن عمرو بن الجموح الأنصاري عن حرام بن عثمان الأنصاري عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن جعفر بن مهران السباك عن أبو يعلى الموصلي","مسند جابر"
"1859","94 - (  1861  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ مِهْرَانَ قَالَ :  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَبْدِ اللهِ بْنِ سَهْلٍ أَبِي لَيْلَى ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  خَرَجَ  مَرْحَبُ بْنُ الْحَارِثِ  الْيَهُودِيُّ وَهُوَ يَقُولُ :         [3/386]      هَلْ مِنْ مُبَارِزٍ ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ لِهَذَا ؟ قَالَ  مُحَمَّدُ بْنُ مَسْلَمَةَ  : أَنَا يَا رَسُولَ اللهِ أَنَا وَاللهِ  الْمَوْتُورُ  الثَّائِرُ  ، قَتَلُوا أَخِي بِالْأَمْسِ ، فَقَالَ : قُمْ إِلَيْهِ ، اللَّهُمَّ أَعِنْهُ . فَلَمَّا دَنَا أَحَدُهُمَا مِنْ صَاحِبِهِ عَرَضَتْ بَيْنَهُمَا شَجَرَةٌ ، فَطَفِقَ أَحَدُهُمَا  يَلُوذُ  بِهَا مِنْ صَاحِبِهِ ، فَكُلَّمَا لَاذَ بِهَا مِنْهُ اقْتَطَعَ بِسَيْفِهِ مَا دُونَهُ حَتَّى رَأَيْتُهَا وَإِنَّهَا كَالرَّجُلِ الْقَائِمِ حَتَّى  خَلُصَ  كُلُّ وَاحِدٍ مِنْهُمَا إِلَى صَاحِبِهِ ، فَشَدَّ عَلَيْهِ  مَرْحَبٌ  فَضَرَبَهُ وَاتَّقَاهُ بِالدَّرَقَةِ ، فَوَقَعَ سَيْفُهُ فِيهَا فَنَشَبَ ، وَعَضَّتْ لَهُ الدَّرَقَةُ فَأَمْسَكَتْهُ ، فَضَرَبَهُ  مُحَمَّدُ بْنُ مَسْلَمَةَ  فَقَتَلَهُ  .         [3/387]","","Musnad Abi Ya'la al-Mawsili 1861","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن سهل بن عبد الرحمن الحارثي عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن جعفر بن مهران السباك عن أبو يعلى الموصلي","مسند جابر"
"1860","95 - (  1862  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ مِهْرَانَ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ قَالَ :  حَدَّثَنِي  عَاصِمُ بْنُ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ جَابِرٍ ،  عَنْ  أَبِيهِ جَابِرِ بْنِ عَبْدِ اللهِ ،  قَالَ :  أَقْبَلْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَا نَعْلَمُ بِخَبْءِ  الْقَوْمِ  الَّذِي خَبَّئُوا لَنَا ، فَاسْتَقْبَلْنَا  وَادِيَ حُنَيْنٍ  فِي  عَمَايَةِ  الصُّبْحِ ، وَهُوَ وَادٍ أَجْوَفُ مِنْ أَوْدِيَةِ  تِهَامَةَ  ، حَطُوطٌ ، إِنَّمَا يَنْحَدِرُونَ         [3/388]      فِيهِ انْحِدَارًا ، قَالَ : فَوَاللهِ إِنَّ النَّاسَ لَيَتَتَابَعُونَ لَا يَعْلَمُونَ بِشَيْءٍ ، إِذْ فَجِئَهُمُ الْكَتَائِبُ مِنْ كُلِّ نَاحِيَةٍ ، فَلَمْ يَتَنَاظَرِ النَّاسُ أَنِ انْهَزَمُوا رَاجِعِينَ ، قَالَ : وَانْحَازَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ الْيَمِينِ ، قَالَ :  أَيْنَ أَيُّهَا النَّاسُ ؟ أَنَا رَسُولُ اللهِ ، أَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ  .","","Musnad Abi Ya'la al-Mawsili 1862","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الرحمن بن جابر السلمي عن عاصم بن عمر الظفري عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن جعفر بن مهران السباك عن أبو يعلى الموصلي","مسند جابر"
"1861","96 - (  1863  ) -  حَدَّثَنَا  جَعْفَرٌ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ         [3/389]      مُحَمَّدِ بْنِ إِسْحَاقَ ،  حَدَّثَنِي  عَاصِمُ بْنُ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ جَابِرٍ ،  عَنْ  أَبِيهِ جَابِرٍ  قَالَ :  كَانَ أَمَامَ  هَوَازِنَ  رَجُلٌ جَسِيمٌ عَلَى جَمَلٍ أَحْمَرَ فِي يَدِهِ رَايَةٌ سَوْدَاءُ ، إِذَا أُدْرِكَ طَعَنَ بِهَا  ، وَإِذَا فَاتَهُ شَيْءٌ مِنْ بَيْنِ يَدَيْهِ دَفَعَهَا مِنْ خَلْفِهِ فَأَنْفَذَهُ ، فَصَمَدَ لَهُ  عَلِيُّ بْنُ أَبِي طَالِبٍ  وَرَجُلٌ مِنَ الْأَنْصَارِ  كِلَاهُمَا يُرِيدُهُ ، قَالَ : فَضَرَبَهُ  عَلِيٌّ  عَلَى عُرْقُوبَيِ الْجَمَلِ فَوَقَعَ عَلَى عَجُزِهِ ، قَالَ : وَضَرَبَ الْأَنْصَارِيُّ سَاقَهُ قَالَ : فَطَرَحَ قَدَمَهُ بِنِصْفِ سَاقِهِ فَوَقَعَ ، وَاقْتَتَلَ النَّاسُ .  وَخَرَجَ حِينَ كَانَتِ الْهَزِيمَةُ  كَلَدَةُ  - وَكَانَ أَخَا  صَفْوَانَ بْنِ أُمَيَّةَ  - يَوْمَئِذٍ مُشْرِكًا فِي الْمُدَّةِ الَّتِي ضَرَبَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَلَا بَطَلَ السِّحْرُ الْيَوْمَ ، فَقَالَ لَهُ  صَفْوَانُ  : اسْكُتْ فَضَّ اللهُ فَاكَ ، فَوَاللهِ لَأَنْ  يَرُبَّنِي  رَجُلٌ مِنْ  قُرَيْشٍ  أَحَبُّ إِلَيَّ مِنْ أَنْ  يَرُبَّنِي  رَجُلٌ مِنْ  هَوَازِنَ  .         [3/390]","","Musnad Abi Ya'la al-Mawsili 1863","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الرحمن بن جابر السلمي عن عاصم بن عمر الظفري عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن جعفر بن مهران السباك عن أبو يعلى الموصلي","مسند جابر"
"1862","97 - (  1864  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ الْعَنْبَرِيُّ ،  حَدَّثَنَا  أَبِي  ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  صَلَّى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى  النَّجَاشِيِّ  ، فَكُنْتُ فِي الصَّفِّ الثَّانِي  .","","Musnad Abi Ya'la al-Mawsili 1864","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن أبو يعلى الموصلي","مسند جابر"
"1863","98 - (  1865  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ ،  حَدَّثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  حَدَّثَنَا  عُمَرُ بْنُ عَبْدِ اللهِ ، مَوْلَى غُفْرَةَ ، قَالَ :  سَمِعْتُ  أَيُّوبَ بْنَ خَالِدِ بْنِ صَفْوَانَ يَقُولُ :  قَالَ  جَابِرٌ :  خَرَجَ عَلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ :  يَا أَيُّهَا النَّاسُ ، إِنَّ لِلهِ سَرَايَا مِنَ الْمَلَائِكَةِ تَحِلُّ وَتَقِفُ عَلَى مَجَالِسِ الذِّكْرِ فِي الْأَرْضِ ،  فَارْتَعُوا  فِي رِيَاضِ الْجَنَّةِ  ، قَالُوا : وَأَيْنَ رِيَاضُ الْجَنَّةِ يَا رَسُولَ اللهِ ؟ قَالَ : مَجَالِسُ الذِّكْرِ ، فَاغْدُوا وَرُوحُوا فِي ذِكْرِ اللهِ ، وَذَكِّرُوهُ بِأَنْفُسِكُمْ ، مَنْ كَانَ يُحِبُّ أَنْ يَعْلَمَ مَنْزِلَتَهُ عِنْدَ اللهِ فَلْيَنْظُرْ         [3/391]      كَيْفَ مَنْزِلَةُ اللهِ عِنْدَهُ ، فَإِنَّ اللهَ يُنْزِلُ الْعَبْدَ مِنْهُ حَيْثُ أَنْزَلَهُ مِنْ نَفْسِهِ  .","","Musnad Abi Ya'la al-Mawsili 1865","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أيوب بن خالد بن صفوان النجاري عن عمر بن عبد الله مولى غفرة بنت رباح عن بشر بن المفضل عن عبيد الله بن معاذ بن معاذ عن أبو يعلى الموصلي","مسند جابر"
"1864","99 - (  1866  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  عَنْ  عُمَرَ مَوْلَى غُفْرَةَ ،  عَنْ  أَيُّوبَ بْنِ خَالِدٍ ،  عَنْ  جَابِرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Musnad Abi Ya'la al-Mawsili 1866","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أيوب بن خالد بن صفوان النجاري عن عمر بن عبد الله مولى غفرة بنت رباح عن بشر بن المفضل عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"1865","100 - (  1867  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ، قَالَ :  ذَكَرَ  أَبِي  ،  عَنْ  يُوسُفَ بْنِ مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ اللهَ تَعَالَى حَيِيٌّ كَرِيمٌ يَسْتَحْيِي مِنْ عَبْدِهِ أَنْ يَرْفَعَ إِلَيْهِ يَدَيْهِ فَيَرُدَّهُمَا صِفْرًا         [3/392]      لَيْسَ فِيهِمَا شَيْءٌ  .","","Musnad Abi Ya'la al-Mawsili 1867","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن يوسف بن محمد بن المنكدر القرشي عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن أبو يعلى الموصلي","مسند جابر"
"1866","101 - (  1868  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ، قَالَ :  ذَكَرَ  أَبِي  ،  عَنْ  يُوسُفَ بْنِ مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرٍ قَالَ :  بَيْنَمَا نَحْنُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي السُّوقِ إِذَا امْرَأَةٌ قَدْ أَخَذَتْ بِعِنَانِ دَابَّتِهِ وَهُوَ عَلَى حِمَارٍ ، فَقَالَتْ :  يَا رَسُولَ اللهِ ، إِنَّ زَوْجِي لَا يَقْرَبُنِي فَفَرِّقْ بَيْنِي وَبَيْنَهُ  ، وَمَرَّ زَوْجُهَا فَدَعَاهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : مَا لَكَ وَلَهَا ، جَاءَتْ تَشْكُو مِنْكَ جَفَاءً ، تَشْكُو مِنْكَ أَنَّكَ لَا تَقْرَبُهَا ؟ قَالَ : يَا رَسُولَ اللهِ ، وَالَّذِي أَكْرَمَكَ إِنَّ عَهْدِي بِهَا لَهَذِهِ اللَّيْلَةُ ، وَبَكَتِ الْمَرْأَةُ ، فَقَالَتْ : كَذَبَ ، فَرِّقْ بَيْنِي وَبَيْنَهُ ، فَإِنَّهُ مِنْ أَبْغَضِ خَلْقِ اللهِ إِلَيَّ ، فَتَبَسَّمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ أَخَذَ بِرَأْسِهِ وَرَأْسِهَا فَجَمَعَ بَيْنَهُمَا ، وَقَالَ : اللَّهُمَّ أَدْنِ كُلَّ وَاحِدٍ مِنْ صَاحِبِهِ ، قَالَ  جَابِرٌ  : فَلَبِثْنَا مَا شَاءَ اللهُ أَنْ نَلْبَثَ ، ثُمَّ مَرَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِالسُّوقِ ، فَإِذَا         [3/393]      نَحْنُ بِامْرَأَةٍ تَحْمِلُ أُدْمًا ، فَلَمَّا رَأَتْهُ طَرَحَتِ الْأُدْمَ ، وَأَقْبَلَتْ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَتْ : يَا رَسُولَ اللهِ ، وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا خَلَقَ اللهُ مِنْ بَشَرٍ أَحَبَّ إِلَيَّ مِنْهُ إِلَّا أَنْتَ  .  قَالَ  عُبَيْدُ اللهِ  : وَلَا أَرَانِي سَمِعْتُهُ مِنْ أَبِي  .","","Musnad Abi Ya'la al-Mawsili 1868","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن يوسف بن محمد بن المنكدر القرشي عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن أبو يعلى الموصلي","مسند جابر"
"1867","102 - (  1869  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ ،  حَدَّثَنَا  أَبِي  ،  حَدَّثَنَا  قُرَّةُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  دَعَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِصَحِيفَةٍ عِنْدَ مَوْتِهِ يَكْتُبُ فِيهَا كِتَابًا لِأُمَّتِهِ قَالَ : لَا يَضِلُّونَ وَلَا يُضَلُّونَ  ، فَكَانَ فِي الْبَيْتِ لَغَطٌ ، فَتَكَلَّمَ  عُمَرُ بْنُ الْخَطَّابِ  ، فَرَفَضَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .         [3/394]","","Musnad Abi Ya'la al-Mawsili 1869","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن قرة بن خالد السدوسي عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن أبو يعلى الموصلي","مسند جابر"
"1868","103 - (  1870  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ ،  حَدَّثَنَا  أَبِي  ،  حَدَّثَنَا  قُرَّةُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ يَصْعَدِ  الثَّنِيَّةَ  ثَنِيَّةَ الْمُرَارِ  فَإِنَّهُ يُحَطُّ عَنْهُ مَا حُطَّ عَنْ  بَنِي إِسْرَائِيلَ  ، فَكَانَ أَوَّلَ مَنْ صَعِدَهَا خَيْلُنَا خَيْلُ  بَنِي الْخَزْرَجِ  ، قَالَ : فَتَتَابَعَ النَّاسُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : كُلُّكُمْ مَغْفُورٌ لَهُ إِلَّا صَاحِبَ الْجَمَلِ الْأَحْمَرِ ، فَقُلْنَا : تَعَالَ يَسْتَغْفِرْ لَكَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : وَاللهِ لَأَنْ أَجِدَ ضَالَّتِي أَحَبُّ إِلَيَّ مِنْ أَنْ يَسْتَغْفِرَ لِي صَاحِبُكُمْ ، وَإِذَا هُوَ رَجُلٌ  يَنْشُدُ  ضَالَّةً  .","","Musnad Abi Ya'la al-Mawsili 1870","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن قرة بن خالد السدوسي عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن أبو يعلى الموصلي","مسند جابر"
"1869","104 - (  1871  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  سَعِيدُ بْنُ الرَّبِيعِ ،  حَدَّثَنَا  قُرَّةُ بْنُ خَالِدٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَعَا عِنْدَ مَوْتِهِ بِصَحِيفَةٍ لِيَكْتُبَ فِيهَا         [3/395]      كِتَابًا لَا يَضِلُّونَ بَعْدَهُ وَلَا يُضَلُّونَ  ، وَكَانَ فِي الْبَيْتِ لَغَطٌ ، وَتَكَلَّمَ  عُمَرُ بْنُ الْخَطَّابِ  فَرَفَضَهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Musnad Abi Ya'la al-Mawsili 1871","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن قرة بن خالد السدوسي عن سعيد بن الربيع الحرشي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"1870","105 - (  1872  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  حَفْصٌ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى أَنْ يُخْلَطَ التَّمْرُ وَالزَّبِيبُ جَمِيعًا  .","","Musnad Abi Ya'la al-Mawsili 1872","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن ابن جريج عن حفص بن غياث النخعي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"1871","106 - (  1873  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  عَبْدِ الْحَمِيدِ بْنِ جَعْفَرٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ فَتْحِ مَكَّةَ  يَقُولُ :  إِنَّ اللهَ وَرَسُولَهُ حَرَّمَ بَيْعَ الْخَمْرِ ، وَبَيْعَ الْخَنَازِيرِ ، وَبَيْعَ الْمَيْتَةِ ، وَبَيْعَ الْأَصْنَامِ  ، فَقَالَ رَجُلٌ : يَا رَسُولَ اللهِ ، فَمَا تَرَى         [3/396]      فِي شَحْمِ الْمَيْتَةِ ، فَإِنَّا نَدْهُنُ بِهِ السُّفُنَ ، وَنَدْهُنُ بِهِ الْجُلُودَ ،  وَنَسْتَصْبِحُ  بِهِ ؟ فَقَالَ :  قَاتَلَ  اللهُ الْيَهُودَ ، إِنَّ اللهَ حَرَّمَ عَلَيْهِمْ  شُحُومَهَا  ، أَخَذُوا  فَجَمَلُوهَا  ، ثُمَّ بَاعُوهَا وَأَكَلُوا أَثْمَانَهَا  .         [3/397]","","Musnad Abi Ya'la al-Mawsili 1873","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن يزيد بن أبي حبيب الأزدي عن عبد الحميد بن جعفر الأوسي عن حماد بن أسامة القرشي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"1872","107 - (  1874  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبِي  ،  حَدَّثَنَا  الرَّبِيعُ بْنُ سَعْدٍ الْجُعْفِيُّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ،  عَنْ  جَابِرٍ قَالَ :  مَنْ سَرَّهُ أَنْ يَنْظُرَ إِلَى رَجُلٍ مِنْ أَهْلِ الْجَنَّةِ فَلْيَنْظُرْ إِلَى  الْحُسَيْنِ بْنِ عَلِيٍّ  ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُهُ  .","","Musnad Abi Ya'la al-Mawsili 1874","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الرحمن بن سابط الجمحي عن الربيع بن سعيد الجعفي عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"1873","108 - (  1875  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو خَالِدٍ الْأَحْمَرُ سُلَيْمَانُ بْنُ حَيَّانَ ،  عَنْ  ثَوْرِ بْنِ يَزِيدَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَسْلِيمٌ بِإِصْبَعٍ وَاحِدَةٍ         [3/398]      تُشِيرُ بِهَا فِعْلُ الْيَهُودِ  .","","Musnad Abi Ya'la al-Mawsili 1875","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ثور بن يزيد الكلاعي عن سليمان بن حيان الأحمر عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1874","109 - (  1876  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ مُجَالِدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَامِرٍ ،  عَنْ  جَابِرٍ قَالَ :  لَمَّا قَدِمَ  جَعْفَرٌ  مِنَ  الْحَبَشَةِ  عَانَقَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  .","","Musnad Abi Ya'la al-Mawsili 1876","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن مجالد بن سعيد عن إسماعيل بن مجالد بن سعيد الهمداني عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1875","110 - (  1877  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ الضَّبِّيُّ ،  عَنْ  سُفْيَانَ الثَّوْرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَشْهَدُ مَعَ الْمُشْرِكِينَ مَشَاهِدَهُمْ  ، قَالَ : فَسَمِعَ مَلَكَيْنِ خَلْفَهُ وَأَحَدُهُمَا يَقُولُ لِصَاحِبِهِ : اذْهَبْ بِنَا حَتَّى نَقُومَ خَلْفَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ : فَقَالَ : كَيْفَ نَقُومُ خَلْفَهُ وَإِنَّمَا عَهْدُهُ بِاسْتِلَامِ الْأَصْنَامِ قَبْلُ ؟ قَالَ : فَلَمْ يَعُدْ بَعْدَ ذَلِكَ أَنْ يَشْهَدَ مَعَ الْمُشْرِكِينَ مَشَاهِدَهُمْ  .         [3/399]","","Musnad Abi Ya'la al-Mawsili 1877","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن سفيان الثوري عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1876","111 - (  1878  ) -  حَدَّثَنَا  عُثْمَانُ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  سُفْيَانَ  ،         [3/400]      عَنْ عَبْدِ اللهِ بْنِ زِيَادِ بْنِ حُدَيْرٍ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .  كذا في طبعة دار المأمون للتراث ونسخة السليمانية ، وفي طبعة إرشاد الحق : (سفيان بن عبد الله بن زياد بن حدير) وأشار إلى خلاف النسخ ، ولعل ذلك هو الصواب وينظر مصادر ترجمته ، والله أعلم .  في النص تصحيف حيث تصحفت كلمة [بن] إلى [عن] فجاء السند: حدثنا جرير ، عن سفيان ، عن عبد الله بن زياد بن حدير . هكذا في طبعة دار المأمون ، والصواب: سفيان بن عبد الله بن زياد بن حدير؛ لما جاء في ترجمته من لسان الميزان ( 3 / 53 ، رقم 208 ) : سفيان بن عبد الله بن زياد بن حدير ، عن عبد الله بن محمد بن عقيل ، عن جابر رضي الله عنه قال كان رسول الله صلى الله عليه وسلم يشهد مع المشركين مشاهدهم ، فسمع ملكين خلفه ، وإحدهما يقول لصاحبه الا تقوم خلفه ، فقال كيف نقوم خلفه ، وإنما عهده باستلام الأصنام ، قيل: رواه أبو زرعة الرازي ، عن عثمان ابن أبي شيبة ، عن جرير بن عبد الحميد ، عن سفيان هذا ، وسفيان هذا لا يعرف وقد تكلم أحمد بن حنبل ، وغيره في عثمان ابن أبي شيبة بسبب رواية هذا الحديث ، قال الطبراني في الأوسط ، والأزدي في الضعفاء تفرد به عثمان ابن أبي شيبة ، عن جرير لكن وقع عندهما عن سفيان الثوري. قال الخطيب: ورواية أبي زرعة أشبه بالصواب. قال الطبراني: وقوله وإنما عهده باستلام الأصنام - يعني أنه حضر مع من استلم لا أنه هو استلم - قال: وكان ذلك قبل أن يوحى إلي ، والله أعلم","","Musnad Abi Ya'la al-Mawsili 1878","","سفيان بن عبد الله بن زياد عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1877","112 - (  1879  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  حَدَّثَنَا  الْحَجَّاجُ بْنُ أَرْطَاةَ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ، وَأَبِي الزُّبَيْرِ الْمَكِّيِّ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ الْأَنْصَارِيِّ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى أَنْ يُبَاعَ النَّخْلُ سَنَتَيْنِ أَوْ ثَلَاثًا ، وَنَهَى أَنْ يُشْتَرَى مَا فِي رُءُوسِ النَّخْلِ بِكَيْلٍ مِنْ تَمْرٍ  ، وَنَهَى أَنْ تُبَاعَ  الثَّمَرَةُ  حَتَّى يَبْدُوَ صَلَاحُهَا  .","","Musnad Abi Ya'la al-Mawsili 1879","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حجاج بن أرطاة عن عبد الرحيم بن سليمان الأشل عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند جابر"
"1878","113 - (  1880  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا  عَبْدُ الْوَهَّابِ بْنُ عَبْدِ الْمَجِيدِ يَعْنِي الثَّقَفِيَّ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَرَجَ عَامَ الْفَتْحِ إِلَى  مَكَّةَ  فِي رَمَضَانَ ، فَصَامَ حَتَّى بَلَغَ  كُرَاعَ  الْغَمِيمِ  ، قَالَ : فَصَامَ النَّاسُ ، وَهُمْ مُشَاةٌ وَرُكْبَانٌ ، فَقِيلَ لَهُ :  إِنَّ النَّاسَ قَدْ شَقَّ عَلَيْهِمُ         [3/401]      الصَّوْمُ ، إِنَّمَا يَنْظُرُونَ مَا تَفْعَلُ أَنْتَ ، فَدَعَا بِقَدَحٍ فَرَفَعَهُ إِلَيْهِ حَتَّى نَظَرَ النَّاسُ ، ثُمَّ شَرِبَ  ، فَأَفْطَرَ بَعْضُ النَّاسِ ، وَصَامَ بَعْضٌ ، فَقِيلَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِنَّ بَعْضَهُمْ صَامَ ، فَقَالَ : أُولَئِكَ الْعُصَاةُ ، وَاجْتَمَعَ إِلَيْهِ الْمُشَاةُ مِنْ أَصْحَابِهِ ، فَصَفُّوا إِلَيْهِ ، فَقَالُوا : نَتَعَرَّضُ لِدَعَوَاتِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَقَدِ اشْتَدَّ السَّفَرُ ، وَطَالَتِ الشُّقَّةُ ، فَقَالَ لَهُمُ : اسْتَعِينُوا  بِالنَّسْلِ  ، فَإِنَّهُ يَقْطَعُ عَنْكُمُ الْأَرْضَ وَتَخِفُّونَ لَهُ ، قَالَ : فَفَعَلْنَا ، فَخَفَفْنَا لَهُ  .         [3/402]","","Musnad Abi Ya'la al-Mawsili 1880","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن عبد الوهاب بن عبد المجيد الثقفي عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند جابر"
"1879","114 - (  1881  ) -  حَدَّثَنَا  مَنْصُورُ بْنُ أَبِي مُزَاحِمٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَطَّابٍ الْبَصْرِيُّ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا ذَلَّتِ الْعَرَبُ ذَلَّ الْإِسْلَامُ  .","","Musnad Abi Ya'la al-Mawsili 1881","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن علي بن زيد بن جدعان عن محمد بن الخطاب بن جبير الجبيري عن منصور بن أبي مزاحم عن أبو يعلى الموصلي","مسند جابر"
"1880","115 - (  1882  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَالِمٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ مُحَمَّدِ بْنِ عَلِيِّ بْنِ حُسَيْنٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  جَابِرٍ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  رَمَلَ  مِنَ الْحَجَرِ إِلَى الْحَجَرِ  .","","Musnad Abi Ya'la al-Mawsili 1882","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن محمد بن جعفر ابن علي بن الحسين العلوي عن عبد الله بن سالم المفلوج عن أبو يعلى الموصلي","مسند جابر"
"1881","116 - (  1883  ) -  حَدَّثَنَا  سُفْيَانُ بْنُ وَكِيعِ بْنِ الْجَرَّاحِ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  إِبْرَاهِيمَ بْنِ يَزِيدَ الْمَكِّيِّ ،  عَنْ  أَبِي الزُّبَيْرِ ،         [3/403]      عَنْ  جَابِرٍ قَالَ :  كُنَّا فِي سَفَرٍ ، فَصَامَ رَجُلٌ ، فَغُشِيَ عَلَيْهِ ، فَوَقَفَ عَلَيْهِ أَصْحَابُهُ ، فَمَرَّ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالُوا : صَامَ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَيْسَ مِنَ  الْبِرِّ  الصَّوْمُ فِي السَّفَرِ  .         [3/404]","","Musnad Abi Ya'la al-Mawsili 1883","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن إبراهيم بن يزيد الخوزي عن وكيع بن الجراح عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","مسند جابر"
"1882","117 - (  1884  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ حُمَيْدٍ الْكُوفِيُّ ،  حَدَّثَنَا  يَعْقُوبُ يَعْنِي الْقُمِّيَّ ،  عَنْ  عِيسَى بْنِ جَارِيَةَ ،  عَنْ  جَابِرٍ قَالَ :  كَانَ رَجُلٌ يَحْمِلُ الْخَمْرَ مِنْ  خَيْبَرَ  إِلَى  الْمَدِينَةِ  فَيَبِيعُهَا مِنَ الْمُسْلِمِينَ ، فَحَمَلَ مِنْهَا بِمَالٍ ، فَقَدِمَ بِهِ  الْمَدِينَةَ  ، فَلَقِيَهُ رَجُلٌ مِنَ الْمُسْلِمِينَ ، فَقَالَ : يَا فُلَانُ ، إِنَّ الْخَمْرَ قَدْ حُرِّمَتْ ، فَوَضَعَهَا حَيْثُ انْتَهَى عَلَى تَلٍّ وَسَجَّى عَلَيْهَا بِالْأَكْسِيَةِ ، ثُمَّ أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ :  يَا رَسُولَ اللهِ ، بَلَغَنِي أَنَّ الْخَمْرَ قَدْ حُرِّمَتْ ، قَالَ : أَجَلْ ، قَالَ : إِلَى أَنْ أَرُدَّهَا عَلَى مَنِ ابْتَعْتُهَا مِنْهُ  ، قَالَ : لَا يَصْلُحُ رَدُّهَا ، قَالَ : إِلَى أَنْ أُهْدِيَهَا لِمَنْ يُكَافِئُنِي مِنْهَا ، قَالَ : لَا ، قَالَ : إِنَّ فِيهَا مَالًا لِيَتَامَى فِي  حِجْرِي  ، قَالَ : إِذَا أَتَانَا مَالُ  الْبَحْرَيْنِ  فَأْتِنَا نُعَوِّضْ أَيْتَامَكَ مِنْ مَالِهِمْ ، ثُمَّ نَادَى  بِالْمَدِينَةِ  ، قَالَ : فَقَالَ الرَّجُلُ : يَا رَسُولَ اللهِ ، الْأَوْعِيَةُ نَنْتَفِعُ بِهَا ؟ قَالَ : فَحُلُّوا أَوْكِيَتَهَا ،  فَانْصَبَّتْ  حَتَّى اسْتَقَرَّتْ فِي بَطْنِ الْوَادِي  .         [3/405]","","Musnad Abi Ya'la al-Mawsili 1884","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عيسى بن جارية الأنصاري عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن جعفر بن حميد زنبقة عن أبو يعلى الموصلي","مسند جابر"
"1883","118 - (  1885  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ حُمَيْدٍ ،  حَدَّثَنَا  يَعْقُوبُ ،  عَنْ  عِيسَى ،  عَنْ  جَابِرٍ ، نَحْوَ حَدِيثِ  أَبِي الرَّبِيعِ  فِي قِصَّةِ  ابْنِ أُمِّ مَكْتُومٍ  قَالَ :  أَجِبْ وَلَوْ  حَبْوًا  ، أَوْ زَحْفًا  .","","Musnad Abi Ya'la al-Mawsili 1885","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عيسى بن جارية الأنصاري عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن جعفر بن حميد زنبقة عن أبو يعلى الموصلي","مسند جابر"
"1884","119 - (  1886  ) -  حَدَّثَنَا  جَعْفَرٌ ،  حَدَّثَنَا  يَعْقُوبُ ،  عَنْ  عِيسَى ،  عَنْ  جَابِرٍ ، نَحْوَ حَدِيثِ  ابْنِ أُمِّ مَكْتُومٍ  فِي الْكِلَابِ .","","Musnad Abi Ya'la al-Mawsili 1886","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عيسى بن جارية الأنصاري عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن جعفر بن حميد زنبقة عن أبو يعلى الموصلي","مسند جابر"
"1885","120 - (  1887  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  دَاوُدَ ،  عَنْ  عَامِرٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  لَمَّا لَقِيَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - النُّقَبَاءَ مِنَ  الْأَنْصَارِ  قَالَ لَهُمْ :  تُؤْوُنِي وَتَمْنَعُونِي ، قَالُوا : فَمَا لَنَا ؟ قَالَ : لَكُمُ الْجَنَّةُ  .","","Musnad Abi Ya'la al-Mawsili 1887","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن داود بن أبي هند عن سفيان الثوري عن معاوية بن هشام القصار عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1886","121 - (  1888  ) -  حَدَّثَنَا  زُهَيْرُ بْنُ حَرْبٍ ،  حَدَّثَنَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  حُصَيْنٍ ،  عَنْ  سَالِمٍ ،         [3/406]      عَنْ  جَابِرٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَخْطُبُ قَائِمًا يَوْمَ الْجُمُعَةِ فَجَاءَتْ  عِيرٌ  مِنَ  الشَّامِ  ، فَانْفَتَلَ النَّاسُ حَتَّى لَمْ يَبْقَ إِلَّا اثْنَا عَشَرَ رَجُلًا  ، فَأُنْزِلَتْ هَذِهِ الْآيَةُ الَّتِي فِي الْجُمُعَةِ :         {      وَإِذَا رَأَوْا تِجَارَةً أَوْ لَهْوًا انْفَضُّوا إِلَيْهَا وَتَرَكُوكَ قَائِمًا         }      .         [3/407]","","Musnad Abi Ya'la al-Mawsili 1888","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سالم بن أبي الجعد الغطفاني عن حصين بن عبد الرحمن السلمي عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1887","122 - (  1889  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  لَيْثٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَكَلَ مِنْ هَذَا الثُّومِ ، وَالْبَصَلِ ، وَالْكُرَّاثِ ، فَلَا يَقْرَبْنَا  .         [3/408]","","Musnad Abi Ya'la al-Mawsili 1889","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن ليث بن أبي سليم عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1888","123 - (  1890  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  عَاصِمٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ تُنْكَحَ الْمَرْأَةُ عَلَى عَمَّتِهَا أَوْ عَلَى خَالَتِهَا  .","","Musnad Abi Ya'la al-Mawsili 1890","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن عاصم بن سليمان الأحول عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1889","124 - (  1891  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  عَاصِمٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَابِرٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا طَالَتْ غَيْبَةُ أَحَدِكُمْ فَلَا يَأْتِ أَهْلَهُ  طُرُوقًا  .","","Musnad Abi Ya'la al-Mawsili 1891","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن عاصم بن سليمان الأحول عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1890","125 - (  1892  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،         [3/409]      عَنْ  جَابِرٍ قَالَ :  أَتَتِ الْحُمَّى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَاسْتَأْذَنَتْ عَلَيْهِ ، قَالَ : مَنْ أَنْتِ ؟ قَالَتْ : أَنَا أُمُّ  مِلْدَمٍ  ، قَالَ : أَتَهْتَدِينَ إِلَى  أَهْلِ قُبَاءٍ  ؟ قَالَتْ : نَعَمْ ، قَالَ : فَأَتَتْهُمْ فَحُمُّوا ، وَلَقُوا مِنْهَا شِدَّةً فَاشْتَكَوْا إِلَيْهِ ، وَقَالُوا :  يَا رَسُولَ اللهِ ، مَا لَقِينَا مِنَ الْحُمَّى ، قَالَ : إِنْ شِئْتُمْ دَعَوْتُ اللهَ فَكَشَفَهَا عَنْكُمْ  ، وَإِنْ شِئْتُمْ كَانَتْ طَهُورًا ، قَالُوا : لَا ، بَلْ تَكُونُ لَنَا طَهُورًا أَوْ عَرْفًا  .","","Musnad Abi Ya'la al-Mawsili 1892","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1891","126 - (  1893  ) -  أَخْبَرَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  الْقَسْوَةُ وَغِلَظُ الْقُلُوبِ قِبَلِ الْمَشْرِقِ فِي  رَبِيعَةَ  ،  وَمُضَرَ  ، وَالْإِيمَانُ فِي  أَهْلِ الْحِجَازِ  .         [3/410]","","Musnad Abi Ya'la al-Mawsili 1893","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1892","127 - (  1894  ) -  وَعَنْ  جَابِرٍ ، قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  النَّاسُ تَبَعٌ  لِقُرَيْشٍ  فِي الْخَيْرِ وَالشَّرِّ  .","","Musnad Abi Ya'la al-Mawsili 1894","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1893","128 - (  1895  ) -  وَعَنْ  جَابِرٍ ، قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ الشَّيْطَانَ إِذَا سَمِعَ  النِّدَاءَ  بِالصَّلَاةِ ذَهَبَ حَتَّى يَكُونَ مَكَانَ  الرَّوْحَاءِ  .         [3/411]      قَالَ  سُلَيْمَانُ  :  فَسَأَلْتُهُ عَنِ  الرَّوْحَاءِ  ؟ فَقَالَ : هِيَ مِنَ  الْمَدِينَةِ  سَبْعَةً وَثَلَاثِينَ مِيلًا  .","","Musnad Abi Ya'la al-Mawsili 1895","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1894","129 - (  1896  ) -  وَعَنْ  جَابِرٍ قَالَ :  رَكِبَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَسًا  بِالْمَدِينَةِ  فَصَرَعَهُ عَلَى  جِذْمِ  نَخْلَةٍ ،  فَانْفَكَّتْ  قَدَمُهُ ، فَأَتَيْنَاهُ نَعُودُهُ ، فَوَجَدْنَاهُ فِي  مَشْرُبَةٍ  لِعَائِشَةَ  يُسَبِّحُ جَالِسًا ، فَقُمْنَا خَلْفَهُ فَسَكَتَ عَنَّا ، ثُمَّ أَتَيْنَاهُ مَرَّةً أُخْرَى فَوَجَدْنَاهُ يُصَلِّي الْمَكْتُوبَةَ ، فَقُمْنَا خَلْفَهُ فَأَشَارَ إِلَيْنَا فَقَعَدْنَا ، فَلَمَّا قَضَى الصَّلَاةَ قَالَ :  إِذَا صَلَّى الْإِمَامُ جَالِسًا فَصَلُّوا جُلُوسًا ، وَإِذَا صَلَّى قَائِمًا فَصَلُّوا قِيَامًا  ، وَلَا تَفْعَلُوا كَمَا يَفْعَلُ  أَهْلُ فَارِسَ  بِعُظَمَائِهَا  .         [3/412]","","Musnad Abi Ya'la al-Mawsili 1896","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1895","130 - (  1897  ) -  وَعَنْ  جَابِرٍ ، قَالَ :  قَدِمْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَتَطَوَّفْنَا بِالْبَيْتِ وَأَحْلَلْنَا ، فَلَمَّا أَتَيْنَا  الْبَطْحَاءَ  أَمَرَنَا أَنْ نُهِلَّ بِالْحَجِّ ، قَالَ : فَقَالَ بَعْضُ  الْقَوْمِ  : أَنُهِلُّ بِالْحَجِّ وَإِنَّمَا عَهْدُنَا بِالنِّسَاءِ أَمْسِ ؟ قَالَ : فَكَانَ مِنْهُمْ فِي ذَلِكَ كَلَامٌ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَوْ عَلِمْتُ أَنَّهُمْ يَفْعَلُونَ هَذَا مَا سُقْتُ الْهَدْيَ ، قَالَ : وَقَالَ لَنَا : لِيَشْتَرِكِ النَّفَرُ فِي الْهَدْيِ  .         [3/413]","","Musnad Abi Ya'la al-Mawsili 1897","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1896","131 - (  1898  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  أَقْبَلْنَا مِنْ  مَكَّةَ  إِلَى  الْمَدِينَةِ  مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : فَأَعْيَا جَمَلِي فَتَخَلَّفْتُ عَلَيْهِ أَسُوقُهُ ، قَالَ : وَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي حَاجَةٍ مُتَخَلِّفًا فَلَحِقَنِي فَقَالَ لِي : مَا لَكَ مُتَخَلِّفًا ؟ قَالَ : قُلْتُ : لَا يَا رَسُولَ اللهِ ، إِلَّا أَنَّ جَمَلِي ضَلَعَ عَلَيَّ فَأَرَدْتُ أَنْ أُلْحِقَهُ بِالْقَوْمِ ، قَالَ :  فَأَخَذَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِذَنَبِهِ فَضَرَبَهُ ، ثُمَّ  زَجَرَهُ  ، فَقَالَ : ارْكَبْ ، فَلَقَدْ رَأَيْتُنِي بَعْدُ وَإِنِّي لَأَكُفُّهُ عَنِ  الْقَوْمِ  .  قَالَ : فَنَزَلْنَا مَنْزِلًا دُونَ  الْمَدِينَةِ  فَأَرَدْتُ أَنْ أَتَعَجَّلَ إِلَى أَهْلِي ، فَقَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَأْتِ أَهْلَكَ  طُرُوقًا  ، قَالَ : قُلْتُ : يَا رَسُولَ اللهِ ، إِنِّي حَدِيثُ عَهْدٍ  بِعُرْسٍ  ، قَالَ : فَمَا تَزَوَّجْتَ ؟ قُلْتُ : امْرَأَةً  ثَيِّبًا  ، قَالَ : فَهَلَّا بِكْرًا تُلَاعِبُهَا وَتُلَاعِبُكَ ؟ قَالَ : فَقُلْتُ : يَا رَسُولَ اللهِ ، إِنَّ  عَبْدَ اللهِ  تُوُفِّيَ أَوِ اسْتُشْهِدَ ، وَتَرَكَ جَوَارِيَ ، فَكَرِهْتُ أَنْ أَتَزَوَّجَ إِلَيْهِنَّ مِثْلَهُنَّ ، قَالَ : فَسَكَتْ وَلَمْ يَقُلْ لِي أَحْسَنْتَ وَلَا أَسَأْتَ .         [3/414]      قَالَ : ثُمَّ قَالَ لِي : بِعْنِي جَمَلَكَ هَذَا ، قَالَ : قُلْتُ : لَا ، بَلْ هُوَ لَكَ يَا رَسُولَ اللهِ ، قَالَ : لَا ، بَلْ بِعْنِيهِ ، قَالَ : قُلْتُ : لَا ، بَلْ هُوَ لَكَ يَا رَسُولَ اللهِ ، قَالَ : لَا ، بَلْ بِعْنِيهِ ، قَالَ : قُلْتُ : فَإِنَّ لِرَجُلٍ عَلَيَّ أُوقِيَّةَ ذَهَبٍ فَهُوَ لَكَ بِهَا ، قَالَ : قَدْ أَخَذْتُ ، فَتَبَلَّغْ عَلَيْهِ  الْمَدِينَةَ  ، قَالَ : فَلَمَّا قَدِمْتُ  الْمَدِينَةَ  ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِبِلَالٍ  : أَعْطِهِ أُوقِيَّةَ ذَهَبٍ وَزِدْهُ ، قَالَ : فَأَعْطَانِي أُوقِيَّةَ ذَهَبٍ وَزَادَنِي قِيرَاطًا ، قَالَ : فَقُلْتُ : لَا تُفَارِقُنِي زِيَادَةُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ : فَكَانَ فِي كِيسٍ لِي فَأَخَذَهُ  أَهْلُ الشَّامِ  يَوْمَ  الْحَرَّةِ  .","","Musnad Abi Ya'la al-Mawsili 1898","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سالم بن أبي الجعد الغطفاني عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1897","132 - (  1899  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَوْ كَانَ لِابْنِ آدَمَ نَخْلٌ لَتَمَنَّى إِلَيْهِ مِثْلَهُ  ، وَلَا يَمْلَأُ جَوْفَ ابْنِ آدَمَ إِلَّا التُّرَابُ  .         [3/415]","","Musnad Abi Ya'la al-Mawsili 1899","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1898","133 - (  1900  ) -  وَعَنْ  جَابِرٍ :  جَاءَ غُلَامٌ  لِحَاطِبٍ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  يَا رَسُولَ اللهِ ، دَخَلَ  حَاطِبٌ  النَّارَ ، فَقَالَ : كَذَبْتَ أَلَيْسَ قَدْ شَهِدَ  بَدْرًا  وَالْحُدَيْبِيَةَ  ؟","","Musnad Abi Ya'la al-Mawsili 1900","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1899","134 - (  1901  ) -  وَعَنْ  جَابِرٍ ، سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  يُبْعَثُ كُلُّ عَبْدٍ عَلَى مَا مَاتَ عَلَيْهِ  .         [3/416]","","Musnad Abi Ya'la al-Mawsili 1901","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1900","135 - (  1902  ) -  وَعَنْ  جَابِرٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  طَعَامُ رَجُلٍ يَكْفِي رَجُلَيْنِ ، وَطَعَامُ رَجُلَيْنِ يَكْفِي أَرْبَعَةً  ، وَطَعَامُ أَرْبَعَةٍ يَكْفِي ثَمَانِيَةً  .","","Musnad Abi Ya'la al-Mawsili 1902","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1901","136 - (  1903  ) -  وَعَنْ  جَابِرٍ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا أَكَلَ أَحَدُكُمْ فَلْيَلْعَقْ أَصَابِعَهُ ، فَإِنَّكُمْ لَا تَدْرُونَ فِي أَيِّهِ تَنْزِلُ الْبَرَكَةُ  .","","Musnad Abi Ya'la al-Mawsili 1903","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1902","137 - (  1904  ) -  وَعَنْ  جَابِرٍ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ الشَّيْطَانَ لَيَحْضُرُ أَحَدَكُمْ عِنْدَ كُلِّ شَيْءٍ ، حَتَّى يَحْضُرَهُ عِنْدَ طَعَامِهِ وَشَرَابِهِ  ، فَإِذَا وَقَعَتْ لُقْمَةُ أَحَدِكُمْ فَلْيَرْفَعْهَا ، وَلْيُمِطْ مَا أَصَابَهَا مِنَ الْأَذَى ، ثُمَّ لِيَأْكُلْهَا وَلَا يَدَعْهَا لِلشَّيْطَانِ  .         [3/417]","","Musnad Abi Ya'la al-Mawsili 1904","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1903","138 - (  1905  ) -  وَعَنْ  جَابِرٍ ، سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ خَافَ أَنْ لَا يَسْتَيْقِظَ آخِرَ اللَّيْلِ فَلْيُوتِرْ أَوَّلَ اللَّيْلِ ، ثُمَّ لْيَرْقُدْ  ، وَمَنْ طَمِعَ أَنْ يَسْتَيْقِظَ آخِرَ اللَّيْلِ ، فَلْيُوتِرْ مِنْ آخِرِ اللَّيْلِ ، فَإِنَّ الْقِرَاءَةَ مَحْضُورَةٌ مِنْ آخِرِ اللَّيْلِ ، وَذَلِكَ أَفْضَلُ  .         [3/418]","","Musnad Abi Ya'la al-Mawsili 1905","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1904","139 - (  1906  ) -  وَعَنْ  جَابِرٍ ، قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ أَهْلَ الْجَنَّةِ يَأْكُلُونَ فِيهَا وَيَشْرَبُونَ ، وَلَا يَتْفُلُونَ ، وَلَا يَبُولُونَ  ، وَلَا يَتَمَخَّطُونَ وَلَا يَتَغَوَّطُونَ ، قَالَ : فَمَا بَالُ الطَّعَامِ ؟ قَالَ : جُشَاءً وَرَشْحًا كَرَشْحِ الْمِسْكِ يُلْهَمُونَ التَّسْبِيحَ وَالتَّحْمِيدَ كَمَا تُلْهَمُونَ النَّفَسَ  .         [3/419]","","Musnad Abi Ya'la al-Mawsili 1906","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1905","140 - (  1907  ) -  وَعَنْ  جَابِرٍ ،  سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَقُولُ قَبْلَ مَوْتِهِ بِثَلَاثٍ : لَا يَمُوتَنَّ أَحَدٌ مِنْكُمْ إِلَّا وَهُوَ يُحْسِنُ الظَّنَّ بِاللهِ عَزَّ وَجَلَّ  .         [3/420]","","Musnad Abi Ya'la al-Mawsili 1907","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1906","141 - (  1908  ) -  وَعَنْ  جَابِرٍ ، قَالَ :  مَا بَايَعْنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  زَمَنَ الْحُدَيْبِيَةِ  عَلَى الْمَوْتِ ، وَلَكِنْ بَايَعْنَاهُ عَلَى أَنْ لَا نَفِرَّ  غَيْرَ  جَدِّ بْنِ قَيْسٍ  اخْتَبَأَ فِي إِبْطِ بَعِيرِهِ  .","","Musnad Abi Ya'la al-Mawsili 1908","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1907","142 - (  1909  ) -  وَعَنْ  جَابِرٍ ، سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ عَرْشَ إِبْلِيسَ عَلَى الْبَحْرِ فَيَبْعَثُ سَرَايَاهُ يَفْتِنُونَ النَّاسَ فَأَعْظَمُهُ عِنْدَهُ         [3/421]      أَعْظَمُهُ فِتْنَةً  .","","Musnad Abi Ya'la al-Mawsili 1909","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1908","143 - (  1910  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  جَابِرٍ ،  جَاءَ رَجُلٌ مِنَ  الْأَنْصَارِ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  يَا رَسُولَ اللهِ ، إِنَّ لِي جَارِيَةً فَإِنِّي  أَعْزِلُ  عَنْهَا  ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : سَيَأْتِيهَا مَا قُدِّرَ لَهَا ، ثُمَّ أَتَاهُ بَعْدَ ذَلِكَ ، فَقَالَ : يَا رَسُولَ اللهِ ، قَدْ حَمَلَتِ الْجَارِيَةُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : مَا قَدَّرَ اللهُ مِنْ نَفْسٍ تَخْرُجُ إِلَّا وَهِيَ كَائِنَةٌ  .         [3/422]","","Musnad Abi Ya'la al-Mawsili 1910","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سالم بن أبي الجعد الغطفاني عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1909","144 - (  1911  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ ، سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ فِي اللَّيْلِ سَاعَةً لَا يُوَافِقُهَا رَجُلٌ مُسْلِمٌ يَسْأَلُ اللهَ خَيْرًا مِنَ الدُّنْيَا وَالْآخِرَةِ إِلَّا أَعْطَاهُ إِيَّاهُ  .","","Musnad Abi Ya'la al-Mawsili 1911","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1910","145 - (  1912  ) -  وَعَنْ  جَابِرٍ قَالَ :  كَانَتْ عِنْدَ أُمِّ الْمُؤْمِنِينَ  عَائِشَةُ  امْرَأَةٌ مَعَهَا صَبِيٌّ يَقْطُرُ  مَنْخِرَاهُ  دَمًا ، فَدَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : مَا  شَأْنُ  هَذَا الصَّبِيِّ ؟ قَالَتْ : بِهِ  الْعُذْرَةُ  ، قَالَ : وَيْحَكُنَّ يَا مَعْشَرَ النِّسَاءِ ، لَا تَقْتُلْنَ أَوْلَادَكُنَّ ،  وَأَيُّ امْرَأَةٍ كَانَ بِصَبِيِّهَا  عُذْرَةٌ  أَوْ وَجَعٌ بِرَأْسِهِ ، فَلْتَأْخُذْ قُسْطًا هِنْدِيًّا فَلْتَحُكَّهُ ، ثُمَّ لِتُسْعِطْهُ  ،         [3/423]      ثُمَّ أَمَرَ  عَائِشَةَ  ، فَفَعَلَتْ ذَلِكَ بِالصَّبِيِّ ، فَبَرَأَ  .","","Musnad Abi Ya'la al-Mawsili 1912","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1911","146 - (  1913  ) -  وَعَنْ  جَابِرٍ قَالَ :  كَانَ خَالٌ لِي مِنَ  الْأَنْصَارِ  يَرْقِي مِنَ الْحَيَّةِ ، فَنَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الرُّقَى ، فَأَتَاهُ خَالِي فَقَالَ :  يَا رَسُولَ اللهِ ، إِنَّكَ نَهَيْتَ عَنِ الرُّقَى ، وَإِنِّي أَرْقِي مِنَ الْحَيَّةِ  ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : اعْرِضْهَا عَلَيَّ ، قَالَ : فَعَرَضَهَا عَلَيْهِ ، قَالَ : لَا بَأْسَ بِهَذِهِ ، هَذِهِ مِنَ الْمَوَاثِيقِ  .         [3/424]","","Musnad Abi Ya'la al-Mawsili 1913","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1912","147 - (  1914  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  كَانَ رَجُلٌ مِنَ  الْأَنْصَارِ  يَرْقِي مِنَ الْعَقْرَبِ ، فَنَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الرُّقَى ، قَالَ : فَقَالَ :  يَا رَسُولَ اللهِ ، إِنَّكَ نَهَيْتَ عَنِ الرُّقَى ، وَإِنِّي كُنْتُ أَرْقِي مِنَ الْعَقْرَبِ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : مَنِ اسْتَطَاعَ مِنْكُمْ أَنْ يَنْفَعَ أَخَاهُ فَلْيَفْعَلْ  .","","Musnad Abi Ya'la al-Mawsili 1914","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1913","148 - (  1915  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  جَابِرٍ قَالَ :  وُلِدَ لِرَجُلٍ مِنَّا غُلَامٌ فَسَمَّاهُ  مُحَمَّدًا  ، فَقَالَ لَهُ قَوْمُهُ : لَا نَدَعُكَ تُسَمِّيهِ بِاسْمِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَانْطَلَقَ بِابْنِهِ حَامِلَهُ عَلَى ظَهْرِهِ ، فَأَتَى بِهِ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : يَا رَسُولَ اللهِ ، وُلِدَ لِي غُلَامٌ فَسَمَّيْتُهُ  مُحَمَّدًا  ، فَقَالَ لِي قَوْمِي : لَا نَدَعُكَ تُسَمِّيهِ بِاسْمِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ :  تَسَمَّوْا بِاسْمِي ، وَلَا تَكْتَنُوا بِكُنْيَتِي ، فَإِنَّمَا أَنَا         [3/425]      قَاسِمٌ أَقْسِمُ بَيْنَكُمْ  .         [3/426]","","Musnad Abi Ya'la al-Mawsili 1915","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سالم بن أبي الجعد الغطفاني عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1914","149 - (  1916  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  أَخْبَرَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  سَعِيدِ بْنِ الْحَارِثِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  كُنْتُ أُصَلِّي مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الظُّهْرَ ، وَآخُذُ قَبْضَةً مِنَ الْحَصَا فَأَجْعَلُهَا فِي كَفِّي  ، ثُمَّ أُحَوِّلُهَا إِلَى الْكَفِّ الْأُخْرَى حَتَّى تَبْرُدَ ، ثُمَّ أَضَعُهَا لِجَبِينِي حَتَّى أَسْجُدَ مِنْ شِدَّةِ الْحَرِّ  .         [3/427]","","Musnad Abi Ya'la al-Mawsili 1916","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سعيد بن الحارث بن أبي سعيد الأنصاري عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عباد بن العوام الكلابي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1915","150 - (  1917  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  أَخْبَرَنَا  حَجَّاجٌ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  كُنَّا لَا نَقْتُلُ تُجَّارَ الْمُشْرِكِينَ عَلَى عَهْدِ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .","","Musnad Abi Ya'la al-Mawsili 1917","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حجاج بن أرطاة عن عباد بن العوام الكلابي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1916","151 - (  1918  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  عَنْ  سُفْيَانَ بْنِ حُسَيْنٍ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرٍ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ  الثُّنْيَا  إِلَّا أَنْ تُعْلَمَ  .","","Musnad Abi Ya'la al-Mawsili 1918","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن يونس بن عبيد عن سفيان بن حسين المعلم عن عباد بن العوام الكلابي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1917","152 - (  1919  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبَّادٌ ،  عَنِ  الْحَسَنِ بْنِ أَبِي جَعْفَرٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ ثَمَنِ الْكَلْبِ  وَالْهِرِّ  إِلَّا         [3/428]      الْمُعَلَّمَ  .         [3/429]             [3/430]","","Musnad Abi Ya'la al-Mawsili 1919","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن الحسن بن أبي جعفر الجفري عن عباد بن العوام الكلابي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1918","153 - (  1920  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  لَيْثٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  بَعَثَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سِتَّمِائَةِ رَجُلٍ مَعَ  أَبِي عُبَيْدَةَ بْنِ الْجَرَّاحِ  وَمَا مَعَنَا إِلَّا جِرَابٌ مِنْ تَمْرٍ ، قَالَ : فَاقْتَسَمْنَاهُ ، فَأَصَابَ كُلُّ رَجُلٍ مِنَّا  خَمْسَ تَمَرَاتٍ ، أَوْ سَبْعَ تَمَرَاتٍ  ، فَأَكَلْنَا حَتَّى بَلَغَنَا الْجُوعُ ، قَالَ : فَجَعَلْنَا نَمُصُّ نَوَاهُ ،  فَلَمَّا بَلَغَنَا الْجُوعُ سَاحَلْنَا الْبَحْرَ ، فَإِذَا حُبَابٌ مِثْلُ الْكَثِيبِ الضَّخْمِ قَدْ  نَضَبَ  عَنْهُ الْمَاءُ ، فَقَالَ بَعْضُنَا : أَنَأْكُلُ هَذَا وَهُوَ مَيْتَةٌ  ؟ فَقَالَ  أَبُو عُبَيْدَةَ  : أَنْتُمْ غُزَاةٌ فِي  سَبِيلِ  اللهِ ، كُلُوا فَلَا بَأْسَ ، فَأَكَلْنَا مِنْهُ وَمَلَحْنَا مِنْهُ وَتَزَوَّدْنَا ، فَلَمَّا انْتَهَيْنَا إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَكَرْنَا لَهُ ذَلِكَ ، فَقَالَ : لَا بَأْسَ بِهِ ، هَلْ مَعَ أَحَدٍ مِنْكُمْ         [3/431]      شَيْءٌ مِنْهُ يُطْعِمْنِيهِ ؟ قَالَ : فَقَالَ بَعْضُنَا لِبَعْضٍ : نَعَمْ ، فَبَعَثْنَا إِلَيْهِ مِنْهُ  .","","Musnad Abi Ya'la al-Mawsili 1920","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ليث بن أبي سليم عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1919","154 - (  1921  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  تُوُفِّيَ أَوِ اسْتُشْهِدَ  عَبْدُ اللهِ بْنُ عَمْرِو بْنِ حَرَامٍ  وَعَلَيْهِ دَيْنٌ ، فَاسْتَعْدَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى غُرَمَائِهِ  أَنْ يَضَعُوا مِنْ دَيْنِهِ ، فَطَلَبْتُ إِلَيْهِمْ فَلَمْ يَفْعَلُوا ، فَقَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : اذْهَبْ فَصَنِّفْ تَمْرَكَ أَصْنَافًا :  الْعَجْوَةَ  عَلَى  حِدَةٍ  ،  وَعَذْقَ  زَيْدٍ عَلَى  حِدَةٍ  ، أَصْنَافًا ، ثُمَّ أَرْسِلْ إِلَيَّ ، قَالَ : فَفَعَلْتُ ، ثُمَّ أَرْسَلْتُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَاءَ فَجَلَسَ عَلَى أَعْلَاهُ أَوْ فِي وَسَطِهِ ،         [3/432]      ثُمَّ قَالَ : كِلْ لِلْقَوْمِ ، قَالَ : فَكِلْتُ لَهُمْ حَتَّى أَوْفَيْتُهُمُ الَّذِي لَهُمْ ثُمَّ بَقِيَ تَمْرِي كَأَنَّهُ لَمْ يَنْقُصْ مِنْهُ شَيْءٌ  .         [3/433]","","Musnad Abi Ya'la al-Mawsili 1921","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1920","155 - (  1922  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا فِي الْأَرْضِ نَفْسٌ  مَنْفُوسَةٌ  تَأْتِي عَلَيْهَا مِائَةُ سَنَةٍ  .         [3/434]","","Musnad Abi Ya'la al-Mawsili 1922","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1921","156 - (  1923  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَسَمَّوْا بِاسْمِي وَلَا تَكْتَنُوا بِكُنْيَتِي ، فَإِنَّمَا جُعِلْتُ قَاسِمًا أَقْسِمُ بَيْنَكُمْ  .","","Musnad Abi Ya'la al-Mawsili 1923","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1922","156 - (  1923  - مُكَرَّرٌ ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَسَمَّوْا بِاسْمِي وَلَا تَكْتَنُوا بِكُنْيَتِي  ، فَإِنَّمَا جُعِلْتُ قَاسِمًا أَقْسِمُ بَيْنَكُمْ  .","","Musnad Abi Ya'la al-Mawsili 1923","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سالم بن أبي الجعد الغطفاني عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1923","157 - (  1924  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ آدَمَ ،  حَدَّثَنَا  حَسَنُ بْنُ عَيَّاشٍ ،  عَنْ  جَعْفَرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرٍ :  كُنَّا نُصَلِّي مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْجُمُعَةَ  ، ثُمَّ نَرْجِعُ فَنُرِيحُ  نَوَاضِحَنَا  .         [3/435]      قَالَ  حَسَنٌ  :  فَقُلْتُ  لِجَعْفَرٍ  :  أَيُّ سَاعَةٍ تِيكَ ؟ قَالَ : زَوَالُ الشَّمْسِ  .","","Musnad Abi Ya'la al-Mawsili 1924","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن الحسن بن عياش الأسدي عن يحيى بن آدم عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1924","158 - (  1925  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  مُصْعَبٌ ،  حَدَّثَنَا  حَسَنُ بْنُ صَالِحٍ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنْ  جَابِرٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ فَلَا يَدْخُلِ الْحَمَّامَ بِغَيْرِ إِزَارٍ  ، وَمَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ فَلَا يُدْخِلْ حَلِيلَتَهُ الْحَمَّامَ ، وَمَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ فَلَا يَأْكُلْ عَلَى مَائِدَةٍ تُشْرَبُ عَلَيْهَا الْخَمْرُ  .         [3/436]","","Musnad Abi Ya'la al-Mawsili 1925","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طاوس بن كيسان عن ليث بن أبي سليم عن الحسن بن صالح بن صالح بن حي عن مصعب بن المقدام الخثعمي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1925","159 - (  1926  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  جَعْفَرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرٍ قَالَ :  كَانَتِ الْعَرَبُ يُفِيضُ بِهِمُ الرَّجُلُ يُقَالُ لَهُ  أَبُو سَيَّارَةَ  عَلَى حِمَارٍ  ، فَلَمَّا حَجَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَقَفَتْ  قُرَيْشٌ  مَوَاقِفَهَا ، فَكَانَتْ تَقُولُ : نَحْنُ الْحُمْسُ ، فَخَرَجَ حَتَّى وَقَفَ  بِعَرَفَاتٍ  فَهُوَ قَوْلُهُ :         {      ثُمَّ أَفِيضُوا مِنْ حَيْثُ أَفَاضَ النَّاسُ         }      .         [3/437]","","Musnad Abi Ya'la al-Mawsili 1926","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن حفص بن غياث النخعي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1926","160 - (  1927  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  أُسَامَةَ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  سَلُوا اللهَ عِلْمًا نَافِعًا  ، وَتَعَوَّذُوا بِاللهِ مِنْ عِلْمٍ لَا يَنْفَعُ  .","","Musnad Abi Ya'la al-Mawsili 1927","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن أسامة بن زيد الليثي المدني عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1927","161 - (  1928  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  مُجَالِدٍ ،  عَنْ  عَامِرٍ ،  عَنْ  جَابِرٍ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  رَجَمَ يَهُودِيًّا وَيَهُودِيَّةً  .         [3/438]","","Musnad Abi Ya'la al-Mawsili 1928","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن مجالد بن سعيد عن عبد الرحيم بن سليمان الأشل عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1928","162 - (  1929  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  حُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ،  أَنَّ  أَبَا بَكْرٍ  كَانَ يُصَلِّي بِصَلَاةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - وَالنَّاسُ يُصَلُّونَ بِصَلَاةِ  أَبِي بَكْرٍ  .","","Musnad Abi Ya'la al-Mawsili 1929","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد الرحمن بن حميد الرؤاسي عن حميد بن عبد الرحمن الرؤاسي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1929","163 - (  1930  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  أَبُو أَحْمَدَ ،  عَنْ  شَرِيكٍ ،  عَنِ  ابْنِ عَقِيلٍ ،  عَنْ  جَابِرٍ : أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ أَرَادَ أَنْ يَصُومَ فَلْيَتَسَحَّرْ وَلَوْ         [3/439]      بِشَيْءٍ  .","","Musnad Abi Ya'la al-Mawsili 1930","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن شريك بن عبد الله النخعي عن محمد بن عبد الله بن الزبير عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1930","164 - (  1931  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  ابْنُ إِدْرِيسَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَقَدِ  اهْتَزَّ  الْعَرْشُ  لِمَوْتِ  سَعْدِ بْنِ مُعَاذٍ  .         [3/440]","","Musnad Abi Ya'la al-Mawsili 1931","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن عبد الله بن إدريس الأودي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1931","165 - (  1932  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  عَطَاءٍ ، وَأَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَاعَ مُدَبَّرًا  .         [3/441]","","Musnad Abi Ya'la al-Mawsili 1932","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سلمة بن كهيل الحضرمي عن شريك بن عبد الله النخعي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1932","166 - (  1933  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  شَبَابَةُ ،  عَنِ  الْمُغِيرَةِ بْنِ مُسْلِمٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَقَّ  عَنِ  الْحَسَنِ  وَالْحُسَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 1933","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن المغيرة بن مسلم القسملي عن شبابة بن سوار المدائني عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1933","167 - (  1934  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي صَالِحٍ ، وَأَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا فَرَغَ أَحَدُكُمْ مِنْ طَعَامِهِ فَلْيَلْعَقْ أَصَابِعَهُ  ، فَإِنَّهُ لَا يَدْرِي فِي أَيِّ طَعَامِهِ تَكُونُ الْبَرَكَةُ  .","","Musnad Abi Ya'la al-Mawsili 1934","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن محمد بن فضيل بن غزوان عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1934","168 - (  1935  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  يَحْيَى بْنُ آدَمَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،         [3/442]      عَنْ  جَابِرٍ ، سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  الْإِيمَانُ فِي  أَهْلِ الْحِجَازِ  ، وَالْقَسْوَةُ وَغِلَظُ الْقُلُوبِ قِبَلِ الْمَشْرِقِ ، فِي  رَبِيعَةَ  وَمُضَرَ  .","","Musnad Abi Ya'la al-Mawsili 1935","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن سلام بن سليم الحنفي عن يحيى بن آدم عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1935","169 - (  1936  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  حُسَيْنُ بْنُ عَلِيٍّ ،  عَنْ  زَائِدَةَ ،  عَنْ  سُلَيْمَانَ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  جَهَّزَ  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَيْشًا حَتَّى انْتَصَفَ اللَّيْلُ أَوْ بَلَغَ ذَلِكَ ، ثُمَّ خَرَجَ إِلَيْنَا فَقَالَ :  قَدْ صَلَّى النَّاسُ وَرَقَدُوا وَأَنْتُمْ تَنْتَظِرُونَ هَذِهِ الصَّلَاةَ ، أَمَا إِنَّكُمْ لَنْ تَزَالُوا فِي صَلَاةٍ مَا انْتَظَرْتُمُوهَا  .         [3/443]","","Musnad Abi Ya'la al-Mawsili 1936","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن زائدة بن قدامة عن الحسين بن علي الجعفي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1936","170 - (  1937  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  عَبْدِ اللهِ بْنِ مُسْلِمٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ،  عَنْ  جَابِرٍ قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، كَيْفَ أَصْبَحْتَ ؟ قَالَ :  بِخَيْرٍ مِنْ رَجُلٍ لَمْ يُصْبِحْ صَائِمًا  ، وَلَمْ يَعُدْ سَقِيمًا  .","","Musnad Abi Ya'la al-Mawsili 1937","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الرحمن بن سابط الجمحي عن عبد الله بن مسلم بن هرمز الفدكي عن عيسى بن يونس بن أبي إسحاق عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"1937","171 - (  1938  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  عَنْ  حَجَّاجٍ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَعْرَابِيٌّ ، فَقَالَ : أَخْبِرْنِي عَنِ الْعُمْرَةِ أَوَاجِبَةٌ هِيَ ؟ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا ، وَأَنْ تَعْتَمِرَ خَيْرٌ لَكَ  .         [3/444]","","Musnad Abi Ya'la al-Mawsili 1938","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن حجاج بن أرطاة عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1938","172 - (  1939  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  حَدَّثَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى أَصْحَابِهِ ذَاتَ لَيْلَةٍ ، وَهُمْ يَنْتَظِرُونَ الْعِشَاءَ ، فَقَالَ :  صَلَّى النَّاسُ وَرَقَدُوا وَأَنْتُمْ تَنْتَظِرُونَهَا ، أَمَا إِنَّكُمْ فِي صَلَاةٍ مَا انْتَظَرْتُمُوهَا  ، ثُمَّ قَالَ : لَوْلَا ضَعْفُ الضَّعِيفِ وَكِبَرُ الْكَبِيرِ لَأَخَّرْتُ هَذِهِ الصَّلَاةَ إِلَى  شَطْرِ         [3/445]      اللَّيْلِ  .","","Musnad Abi Ya'la al-Mawsili 1939","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن المنذر بن مالك العوقي عن داود بن أبي هند عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1939","173 - (  1940  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  النُّعْمَانُ بْنُ قَوْقَلٍ  فَقَالَ :  يَا رَسُولَ اللهِ ، إِذَا أَحْلَلْتُ الْحَلَالَ ، وَحَرَّمْتُ الْحَرَامَ ، وَصَلَّيْتُ الْمَكْتُوبَاتِ ، أَأَدْخُلُ الْجَنَّةَ ؟ قَالَ : قَالَ : نَعَمْ  .","","Musnad Abi Ya'la al-Mawsili 1940","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1940","174 - (  1941  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي سُفْيَانَ ،         [3/446]      عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَثَلُ الصَّلَوَاتِ الْخَمْسِ كَمَثَلِ نَهَرٍ جَارٍ  غَمْرٍ  عَلَى بَابِ أَحَدِكُمْ يَغْتَسِلُ كُلَّ يَوْمٍ خَمْسَ مَرَّاتٍ  .","","Musnad Abi Ya'la al-Mawsili 1941","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1941","175 - (  1942  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ ،  سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ قَبْلَ مَوْتِهِ بِثَلَاثٍ :  لَا يَمُوتَنَّ أَحَدٌ مِنْكُمْ إِلَّا وَهُوَ يُحْسِنُ بِاللهِ الظَّنَّ  .","","Musnad Abi Ya'la al-Mawsili 1942","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1942","176 - (  1943  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا قَضَى أَحَدُكُمُ الصَّلَاةَ فِي مَسْجِدِهِ فَلْيَجْعَلْ لِبَيْتِهِ نَصِيبًا مِنْ صَلَاتِهِ  ، فَإِنَّ اللهَ جَاعِلٌ         [3/447]      فِي بَيْتِهِ مِنْ صَلَاتِهِ خَيْرًا  .","","Musnad Abi Ya'la al-Mawsili 1943","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1943","177 - (  1944  ) -  وَبِهِ  ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  إِنَّمَا أَهَلَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِالْحَجِّ  .         [3/448]","","Musnad Abi Ya'la al-Mawsili 1944","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"1944","178 - (  1945  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  بَقِيَّةُ ،  عَنْ  جَرِيرِ بْنِ يَزِيدَ الْحِمْيَرِيِّ ،  حَدَّثَنِي  الْمُنْذِرُ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  مَرَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِرَجُلٍ  يَتَوَضَّأُ وَهُوَ يَغْسِلُ خُفَّيْهِ ،  فَنَخَسَهُ  بِيَدِهِ وَقَالَ : إِنَّا لَمْ نُؤْمَرْ بِهَذَا  ، قَالَ : فَأَرَاهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ بِيَدِهِ مِنْ مَقْدَمِ الْخُفَّيْنِ إِلَى السَّاقِ وَفَرَّقَ بَيْنَ         [3/449]      أَصَابِعِهِ مَرَّةً وَاحِدَةً  .","","Musnad Abi Ya'la al-Mawsili 1945","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن أبو يحيى المنذر عن ابن المنكدر عن جرير بن يزيد عن بقية بن الوليد عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","مسند جابر"
"1945","179 - (  1946  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ","","Musnad Abi Ya'la al-Mawsili 1946","","أبو هريرة الدوسي عن ذكوان السمان عن الأعمش عن حفص بن غياث النخعي عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","مسند جابر"
"1946","179 - (  1946  ) - ( م ) -  وَعَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  جَاءَ  سُلَيْكٌ الْغَطَفَانِيُّ  وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ فِي يَوْمِ الْجُمُعَةِ ، فَقَالَ لَهُ :  أَصَلَّيْتَ قَبْلَ أَنْ تَجِيءَ  ؟ قَالَ : لَا ، قَالَ : فَصَلِّ رَكْعَتَيْنِ ، وَتَجَوَّزْ فِيهِمَا  .         [3/450]","","Musnad Abi Ya'la al-Mawsili 1946","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن حفص بن غياث النخعي عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","مسند جابر"
"1947","180 - (  1947  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  عَنْبَسَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  مُحَمَّدِ بْنِ زَاذَانَ ،         [3/451]      عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا وَقَعَتْ كَبِيرَةٌ ، أَوْ هَاجَتْ رِيحٌ مُظْلِمَةٌ ، فَعَلَيْكُمْ بِالتَّكْبِيرِ  ، فَإِنَّهُ يُجَلِّي الْعَجَاجَ الْأَسْوَدَ  .","","Musnad Abi Ya'la al-Mawsili 1947","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن زاذان المدني عن عنبسة بن عبد الرحمن بن عنبسة الأموي عن الوليد بن مسلم القرشي عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","مسند جابر"
"1948","181 - (  1948  ) -  حَدَّثَنَا  أَبُو عَبْدِ اللهِ أَحْمَدُ بْنُ إِبْرَاهِيمَ النُّكْرِيُّ ،  حَدَّثَنَا  مُبَشِّرٌ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ قَالَ :  سَأَلْتُ  أَبَا سَلَمَةَ بْنَ عَبْدِ الرَّحْمَنِ : أَيُّ الْقُرْآنِ أُنْزِلَ قَبْلُ ؟ فَقَالَ :         {      يَا أَيُّهَا الْمُدَّثِّرُ         }      ، فَقُلْتُ : أَوِ         {      اقْرَأْ بِاسْمِ رَبِّكَ الَّذِي خَلَقَ         }      . قَالَ :  سَأَلْتُ  جَابِرَ بْنَ عَبْدِ اللهِ أَيُّ الْقُرْآنِ أُنْزِلَ قَبْلُ ؟ فَقَالَ :         {      يَا أَيُّهَا الْمُدَّثِّرُ         }      ، فَقُلْتُ : أَوِ         {      اقْرَأْ بِاسْمِ رَبِّكَ الَّذِي خَلَقَ         }      ، قَالَ  جَابِرٌ  : لَا أُخْبِرُكَ إِلَّا مَا حَدَّثَنَا رَسُولُ اللهِ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  جَاوَرْتُ  بِحِرَاءٍ  شَهْرًا ، فَلَمَّا قَضَيْتُ جِوَارِي ، نَزَلْتُ فَاسْتَبْطَنْتُ بَطْنَ الْوَادِي ، قَالَ : فَنُودِيتُ ، فَنَظَرْتُ أَمَامِي وَخَلْفِي  ، وَعَنْ يَمِينِي وَعَنْ شِمَالِي ، فَلَمْ أَرَ أَحَدًا ، ثُمَّ نُودِيتُ ، فَنَظَرْتُ أَمَامِي وَخَلْفِي ، وَعَنْ         [3/452]      يَمِينِي وَعَنْ شِمَالِي ، فَلَمْ أَرَ أَحَدًا ، ثُمَّ نَظَرْتُ إِلَى السَّمَاءِ ، فَإِذَا هُوَ عَلَى الْعَرْشِ فِي الْهَوَاءِ - قَالَ مُبَشِّرٌ :  يَعْنِي  جِبْرِيلَ  -  فَجُئِثْتُ  ، فَأَتَيْتُ  خَدِيجَةَ  ، فَأَمَرْتُهُمْ ،  فَدَثَّرُونِي  ، فَأَنْزَلَ اللهُ :         {      يَا أَيُّهَا الْمُدَّثِّرُ             *          قُمْ فَأَنْذِرْ             *          وَرَبَّكَ فَكَبِّرْ             *          وَثِيَابَكَ فَطَهِّرْ         }      .         [3/453]","","Musnad Abi Ya'la al-Mawsili 1948","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن مبشر بن إسماعيل الحلبي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند جابر"
"1949","182 - (  1949  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  أَبَانُ بْنُ يَزِيدَ ،  حَدَّثَنَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ، قَالَ :  سَأَلْتُ  أَبَا سَلَمَةَ : أَيُّ الْقُرْآنِ أُنْزِلَ أَوَّلُ ؟ قَالَ :         {      يَا أَيُّهَا الْمُدَّثِّرُ         }      ، قَالَ : فَقُلْتُ : إِنِّي أُنْبِئْتُ أَنَّ أَوَّلَ سُورَةٍ نَزَلَتْ مِنَ الْقُرْآنِ :         {      اقْرَأْ بِاسْمِ رَبِّكَ الَّذِي خَلَقَ         }      ، قَالَ  أَبُو سَلَمَةَ  :  سَأَلْتُ  جَابِرَ بْنَ عَبْدِ اللهِ : أَيُّ الْقُرْآنِ أُنْزِلَ أَوَّلُ ؟ قَالَ :         {      يَا أَيُّهَا الْمُدَّثِّرُ         }      فَقُلْتُ لَهُ : إِنِّي أُنْبِئْتُ أَنَّ أَوَّلَ سُورَةٍ نَزَلَتْ مِنَ الْقُرْآنِ :         {      اقْرَأْ بِاسْمِ رَبِّكَ الَّذِي خَلَقَ         }      .         [3/454]      قَالَ  جَابِرٌ  : لَا أُحَدِّثُكَ إِلَّا مَا حَدَّثَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  جَاوَرْتُ فِي  حِرَاءٍ  ، فَلَمَّا قَضَيْتُ جِوَارِي فَاسْتَبْطَنْتُ الْوَادِيَ ، فَنُودِيتُ ، فَنَظَرْتُ أَمَامِي وَخَلْفِي  ، وَعَنْ يَمِينِي وَعَنْ شِمَالِي ، فَلَمْ أَرَ شَيْئًا ، فَنُودِيتُ فَنَظَرْتُ فَوْقِي ، فَإِذَا أَنَا بِهِ قَاعِدٌ عَلَى عَرْشٍ بَيْنَ السَّمَاءِ وَالْأَرْضِ ، قَالَ :  فَجُثِثْتُ  مِنْهُ ، فَانْطَلَقْتُ إِلَى  خَدِيجَةَ  فَقُلْتُ :  دَثِّرُونِي  فَدَثَّرُونِي  ، وَصُبُّوا عَلَيَّ مَاءً بَارِدًا ، فَأُنْزِلَتْ عَلَيَّ :         {      يَا أَيُّهَا الْمُدَّثِّرُ             *          قُمْ فَأَنْذِرْ             *          وَرَبَّكَ فَكَبِّرْ         }      .","","Musnad Abi Ya'la al-Mawsili 1949","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبان بن يزيد العطار عن هدبة بن خالد عن أبو يعلى الموصلي","مسند جابر"
"1950","183 - (  1950  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ ،  حَدَّثَنَا  مُبَشِّرٌ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  حَدَّثَنِي  ابْنُ مِقْسَمٍ ، قَالَ :  حَدَّثَنِي  جَابِرُ بْنُ عَبْدِ اللهِ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَمَرَّتْ بِنَا جِنَازَةٌ ، فَقَامَ لَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَلَمَّا ذَهَبْنَا لِنَحْمِلَ إِذَا هِيَ جِنَازَةُ يَهُودِيَّةٍ ، فَقُلْنَا : يَا رَسُولَ اللهِ ، إِنَّهَا جِنَازَةُ يَهُودِيَّةٍ ، قَالَ :  إِنَّ الْمَوْتَ فَزَعٌ  ، فَإِذَا رَأَيْتُمْ جِنَازَةً فَقُومُوا  .         [3/455]","","Musnad Abi Ya'la al-Mawsili 1950","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبيد الله بن مقسم القرشي عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن مبشر بن إسماعيل الحلبي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند جابر"
"1951","184 - (  1951  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ،  أَخْبَرَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنِ  ابْنِ أَبِي صُعَيْرٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  لَمَّا كَانَ  يَوْمُ  أُحُدٍ  أَشْرَفَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى الشُّهَدَاءِ الَّذِينَ اسْتُشْهِدُوا يَوْمَئِذٍ فَقَالَ :  زَمِّلُوهُمْ  بِدِمَائِهِمْ ، فَإِنِّي قَدْ شَهِدْتُ عَلَى هَؤُلَاءِ  ، فَكَانَ يُدْفَنُ الرَّجُلَانِ وَالثَّلَاثَةُ فِي الْقَبْرِ الْوَاحِدِ ، وَيَسْأَلُ : أَيُّهُمْ كَانَ أَقْرَأَ لِلْقُرْآنِ ؟ فَيُقَدِّمُهُ . قَالَ  جَابِرٌ  : فَدُفِنَ أَبِي وَعَمِّي يَوْمَئِذٍ فِي قَبْرٍ وَاحِدٍ  .         [3/456]","","Musnad Abi Ya'la al-Mawsili 1951","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن ثعلبة بن صعير عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"1952","185 - (  1952  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى الْوَاسِطِيُّ ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 1952","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند جابر"
"1953","186 - (  1953  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَيْسَ بَيْنَ الْعَبْدِ وَبَيْنَ تَرْكِهِ الْإِيمَانَ إِلَّا تَرْكُهُ الصَّلَاةَ  .","","Musnad Abi Ya'la al-Mawsili 1953","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن إسماعيل بن زكريا شقوصا عن محمد بن الصباح الدولابي عن أبو يعلى الموصلي","مسند جابر"
"1954","187 - (  1954  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  كُنَّا مَعَ  أَبِي عُبَيْدَةَ بْنِ الْجَرَّاحِ  فِي  سَرِيَّةٍ أَوْ جَيْشٍ  ، فَنَفِدَ زَادُنَا ، فَبَصُرْنَا بِحُوتٍ قَذَفَهُ الْبَحْرُ فَأَرَدْنَا أَنْ نَأْكُلَ مِنْهُ ، فَنَهَانَا  أَبُو عُبَيْدَةَ  ، ثُمَّ قَالَ : نَحْنُ رُسُلُ رَسُولِ اللهِ ، وَفِي  سَبِيلِ  اللهِ         [3/457]      كُلُوا ، فَأَكَلْنَا مِنْهُ ، فَلَمَّا رَجَعْنَا ذَكَرْنَا ذَلِكَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  إِنْ كَانَ مَعَكُمْ مِنْهُ شَيْءٌ فَابْعَثُوا بِهِ إِلَيْنَا  .","","Musnad Abi Ya'la al-Mawsili 1954","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند جابر"
"1955","188 - (  1955  ) -  حَدَّثَنَا  عَمْرٌو النَّاقِدُ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرٍو ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، يَقُولُ :  بَعَثَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي ثَلَاثِمِائَةِ رَاكِبٍ  ، وَأَمِيرُنَا  أَبُو عُبَيْدَةَ بْنُ الْجَرَّاحِ  نَرْصُدُ  عِيرًا  لِقُرَيْشٍ  ، فَأَقَمْنَا بِالسَّاحِلِ نِصْفَ شَهْرٍ ، فَأَصَابَنَا جُوعٌ شَدِيدٌ حَتَّى أَكَلْنَا الْخَبَطَ ، قَالَ : فَسُمِّيَ ذَلِكَ الْجَيْشُ جَيْشَ  الْخَبَطِ  ، ثُمَّ أَلْقَى الْبَحْرُ لَنَا دَابَّةً يُقَالُ لَهَا :  الْعَنْبَرُ  ، فَأَكَلْنَا مِنْهُ نِصْفَ شَهْرٍ حَتَّى ثَابَتْ أَجْسَامُنَا ، وَادَّهَنَّا بِوَدَكِهِ ، فَأَخَذَ  أَبُو عُبَيْدَةَ  ضِلَعًا مِنْ أَضْلَاعِهِ فَنَظَرَ إِلَى أَطْوَلِ جَمَلٍ فِي الْجَيْشِ فَحَمَلَهُ عَلَيْهِ فَمَرَّ تَحْتَهُ  .","","Musnad Abi Ya'la al-Mawsili 1955","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند جابر"
"1956","189 - (  1956  ) -  قَالَ  أَبُو عُثْمَانَ ،  قَالَ لَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  قَالَ  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ :  أَعْطَانَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جِرَابًا فِيهِ تَمْرٌ  ، فَلَمَّا نَفِدَ وَجَدْنَا فَقْدَهُ ، فَجَعَلَ الرَّجُلُ يَجِيءُ بِالشَّيْءِ ، قَالَ : وَأَخْرَجْنَا مِنْ عَيْنَيْهِ كَذَا وَكَذَا جَرَّةً مِنْ وَدَكٍ ، قَالَ : فَلَمَّا قَدِمْنَا عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَأَلَنَا هَلْ         [3/458]      مَعَكُمْ مِنْهُ شَيْءٌ ؟  .","","Musnad Abi Ya'la al-Mawsili 1956","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند جابر"
"1957","190 - (  1957  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  عَنْ  جَابِرٍ قَالَ :  كَسَعَ  رَجُلٌ مِنَ الْمُهَاجِرِينَ  رَجُلًا مِنَ الْأَنْصَارِ  ، فَقَالَ الْأَنْصَارِيُّ : يَا  لَلْأَنْصَارِ  وَقَالَ الْمُهَاجِرِيُّ : يَا  لَلْمُهَاجِرِينَ  ، فَلَمَّا سَمِعَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاكَ ، قَالَ : مَا بَالُ  دَعْوَى  الْجَاهِلِيَّةِ ؟ قَالُوا : يَا رَسُولَ اللهِ ، رَجُلٌ مِنَ  الْمُهَاجِرِينَ  كَسَعَ  رَجُلًا مِنَ  الْأَنْصَارِ  ، فَقَالَ :  دَعُوهَا  فَإِنَّهَا  مُنْتِنَةٌ  ، فَقَالَ  عَبْدُ اللهِ بْنُ أُبَيٍّ ابْنِ سَلُولَ  : أَقَدْ فَعَلُوهَا ؟ لَئِنْ رَجَعْنَا إِلَى  الْمَدِينَةِ  لَيُخْرِجَنَّ الْأَعَزُّ مِنْهَا الْأَذَلَّ ، فَقَالَ  عُمَرُ  : دَعْنِي يَا رَسُولَ اللهِ أَضْرِبْ عُنُقَ هَذَا الْمُنَافِقِ ، فَقَالَ : دَعْهُ إِنَّهُ لَا يَتَحَدَّثُ النَّاسُ أَنَّ  مُحَمَّدًا  يَقْتُلُ أَصْحَابَهُ  .","","Musnad Abi Ya'la al-Mawsili 1957","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند جابر"
"1958","191 - (  1958  ) -  حَدَّثَنَا  عَمْرٌو النَّاقِدُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  عَنْ  جَابِرٍ قَالَ :  أَتَى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَبْدَ اللهِ بْنَ أُبَيٍّ  بَعْدَمَا أُدْخِلَ حُفْرَتَهُ فَأَمَرَ بِهِ ، فَأُخْرِجَ ، فَوُضِعَ عَلَى رُكْبَتَيْهِ  ، وَنَفَثَ عَلَيْهِ مِنْ رِيقِهِ ، وَأَلْبَسَهُ قَمِيصَهُ ، وَاللهُ أَعْلَمُ  .         [3/459]","","Musnad Abi Ya'la al-Mawsili 1958","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند جابر"
"1959","192 - (  1959  ) -  حَدَّثَنَا  خَلَفُ بْنُ هِشَامٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرٍو ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  كَسَعَ  رَجُلٌ مِنَ الْمُهَاجِرِينَ  رَجُلًا مِنَ الْأَنْصَارِ  ، قَالَ : فَجَاءَ قَوْمُ ذَا ، وَقَوْمُ ذَا ، فَقَالَ هَؤُلَاءِ : يَا  لَلْمُهَاجِرِينَ  وَقَالَ هَؤُلَاءِ : يَا  لَلْأَنْصَارِ  ، فَبَلَغَ ذَلِكَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ :  دَعُوهَا  فَإِنَّهَا  مُنْتِنَةٌ  ، ثُمَّ قَالَ : أَلَا مَا  بَالُ  دَعْوَى  الْجَاهِلِيَّةِ ؟ أَلَا مَا  بَالُ  دَعْوَى  الْجَاهِلِيَّةِ ؟  .","","Musnad Abi Ya'la al-Mawsili 1959","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن حماد بن زيد عن خلف بن هشام البزار عن أبو يعلى الموصلي","مسند جابر"
"1960","193 - (  1960  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى الْوَاسِطِيُّ ،  حَدَّثَنَا  هُشَيْمٌ ،  حَدَّثَنَا  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  لَعَنَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  آكِلَ  الرِّبَا وَمُوكِلَهُ  ، وَشَاهِدَيْهِ ، وَكَاتِبَهُ ، وَقَالَ : هُمْ سَوَاءٌ  .","","Musnad Abi Ya'la al-Mawsili 1960","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند جابر"
"1961","194 - (  1961  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  خَالِدٍ قَالَ :  حَدَّثَنَا  بَعْضُ أَشْيَاخِنَا ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ  أَنَّ  أَبَا بَكْرٍ  قَالَ :  مَنْ كَانَتْ لَهُ عِنْدَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِدَةٌ فَلْيَقُمْ .  قَالَ فَقُلْتُ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعَدَنِي أَنْ يُعْطِيَنِي كَذَا وَكَذَا ، وَحَفَنَ بِيَدِهِ ثَلَاثَ حَفَنَاتٍ ، قَالَ فَقَالَ  أَبُو بَكْرٍ  : إِذَا أَتَانَا مَالٌ فَأْتِنَا . قَالَ فَجَاءَهُ مَالٌ فَأَتَيْتُهُ ، قَالَ : فَحَفَنْتُهُ         [3/460]      بِيَدَيَّ ، فَقَالَ : اعْدُدْهَا فَإِذَا هِيَ خَمْسُمِائَةٍ ، قَالَ : فَأَعْطَانِي أَلْفًا أُخْرَى ، قَالَ وَقَالَ : أَلَكَ مَالٌ سِوَاهُ ؟ قَالَ قُلْتُ : لَا . قَالَ : فَإِذَا حَالَ عَلَيْهِ الْحَوْلُ فَأَدِّ زَكَاتَهُ  .","","Musnad Abi Ya'la al-Mawsili 1961","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن بعض أشياخ خالد الحذاء عن خالد الحذاء عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند جابر"
"1962","195 - (  1962  ) -  حَدَّثَنَا  زَكَرِيَّا ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَابِرٍ ، أَنَّ أَبَا بَكْرٍ  قَالَ  :  مَنْ كَانَ لَهُ عِدَةٌ فَلْيَقُمْ  . فَذَكَرَ نَحْوَهُ إِلَّا أَنَّهُ لَمْ يَذْكُرْ فِيهِ قَوْلَ  أَبِي بَكْرٍ  : إِذَا حَالَ عَلَيْهِ الْحَوْلُ         [3/461]      وَلَا قَوْلَهُ : لَكَ مَالٌ غَيْرُهُ .","","Musnad Abi Ya'la al-Mawsili 1962","","أبو  بكر الصديق عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن مجالد بن سعيد عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند جابر"
"1963","196 - (  1963  ) -  حَدَّثَنَا  زَكَرِيَّا ،  حَدَّثَنَا  هُشَيْمٌ ،  أَخْبَرَنَا  عَلِيُّ بْنُ زَيْدٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ قَالَ :  أَكَلْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  وَأَبِي بَكْرٍ  ،  وَعُمَرَ  ،  وَعُثْمَانَ  ، خُبْزًا وَلَحْمًا  ، فَصَلَّوْا وَلَمْ يَتَوَضَّئُوا  .         [3/462]","","Musnad Abi Ya'la al-Mawsili 1963","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن علي بن زيد بن جدعان عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند جابر"
"1964","197 - (  1964  ) -  حَدَّثَنَا  زَكَرِيَّا ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا بَيْنَ مِنْبَرِي إِلَى حُجْرَتِي رَوْضَةٌ مِنْ رِيَاضِ الْجَنَّةِ  ، وَإِنَّ مِنْبَرِي عَلَى  تُرْعَةٍ  مِنْ تُرَعِ الْجَنَّةِ  .","","Musnad Abi Ya'la al-Mawsili 1964","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن علي بن زيد بن جدعان عن هشيم بن بشير عن زكريا بن عدي بن رزيق عن أبو يعلى الموصلي","مسند جابر"
"1965","198 - (  1965  ) -  حَدَّثَنَا  زَكَرِيَّا ،  حَدَّثَنَا  هُشَيْمٌ ،  أَخْبَرَنَا  سَيَّارٌ ،  عَنْ  أَبِي هُبَيْرَةَ الْأَنْصَارِيِّ ،  عَنْ  جَابِرٍ قَالَ :  اشْتَرَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنِّي بَعِيرًا كَانَ لِي وَنَحْنُ فِي سَفَرٍ ،  قَالَ : وَجَعَلَ لِي ظَهْرَهُ إِلَى أَنْ نَقْدَمَ ، فَلَمَّا قَدِمْنَا أَتَيْتُهُ         [3/463]      بِالْبَعِيرِ ، فَدَفَعْتُ إِلَيْهِ ، فَأَمَرَ لِي بِثَمَنِهِ : أُوقِيَّتَيْنِ ، فَانْصَرَفْتُ ، فَإِذَا رَسُولُهُ قَدِ اتَّبَعَنِي ، فَقَالَ : هَلُمَّ يَدْعُوكَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَظَنَنْتُ أَنَّهُ قَدْ بَدَا لَهُ ، فَلَمَّا أَتَيْتُهُ ، قَالَ لِي : خُذْ بَعِيرَكَ ، فَهُوَ لَكَ ، قَالَ : فَانْصَرَفْتُ ، فَلَقِيتُ  رَجُلًا مِنَ الْيَهُودِ  ، فَأَخْبَرْتُهُ بِالَّذِي كَانَ ، فَجَعَلَ يَعْجَبُ ، وَقَالَ : أَعْطَاكَ الثَّمَنَ وَرَدَّ عَلَيْكَ الْبَعِيرَ ؟  .","","Musnad Abi Ya'la al-Mawsili 1965","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن يحيى بن عباد بن شيبان الأنصاري عن سيار بن أبي سيار العنزي عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند جابر"
"1966","199 - (  1966  ) -  حَدَّثَنَا  عَمْرٌو النَّاقِدُ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرٍو ،  سَمِعَ  جَابِرًا ، يَقُولُ :  قَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا جَاءَ مَالُ  الْبَحْرَيْنِ  أَعْطَيْنَاكَ هَكَذَا وَهَكَذَا  ،  وَحَفَنَ  سُفْيَانُ  بِيَدِهِ ثَلَاثَ حَفَنَاتٍ  .","","Musnad Abi Ya'la al-Mawsili 1966","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند جابر"
"1967","200 - (  1967  ) -  حَدَّثَنَا  عَمْرٌو ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  عَنْ  جَابِرٍ قَالَ :  لَمَّا أُنْزِلَ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :         {      قُلْ هُوَ الْقَادِرُ عَلَى أَنْ يَبْعَثَ عَلَيْكُمْ عَذَابًا مِنْ فَوْقِكُمْ         }      ، قَالَ : أَعُوذُ بِوَجْهِكَ  ،         {      أَوْ مِنْ تَحْتِ أَرْجُلِكُمْ         }      ، قَالَ : أَعُوذُ بِوَجْهِكَ ،         {      أَوْ يَلْبِسَكُمْ شِيَعًا وَيُذِيقَ بَعْضَكُمْ بَأْسَ بَعْضٍ         }      ، قَالَ :  هَاتَانِ أَهْوَنُ أَوْ هَاتَانِ أَيْسَرُ  .         [3/464]","","Musnad Abi Ya'la al-Mawsili 1967","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند جابر"
"1968","201 - (  1968  ) -  حَدَّثَنَا  عَمْرٌو ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  حَدَّثَنَا  جَابِرٌ ، قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْحَرْبُ  خَدْعَةٌ  .  قَالَ  أَبُو عُثْمَانَ  : قَالَ لِي بَعْضُ أَصْحَابِنَا : كَثِيرٌ مِنْهُمْ كَانَ يَقُولُ : الْحَرْبُ  خَدْعَةٌ ،  وَلَمْ أَسْمَعْهُ أَنَا إِلَّا بِالرَّفْعِ :  خَدْعَةٌ  .","","Musnad Abi Ya'la al-Mawsili 1968","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند جابر"
"1969","202 - (  1969  ) -  حَدَّثَنَا  عَمْرٌو ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  عَنْ  جَابِرٍ قَالَ :  دَخَلَ  رَجُلٌ  الْمَسْجِدَ وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ يَوْمَ الْجُمُعَةِ ، قَالَ :  صَلَّيْتَ ؟ قَالَ : لَا ، قَالَ : فَصَلِّ رَكْعَتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 1969","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند جابر"
"1970","203 - (  1970  ) -  حَدَّثَنَا  عَمْرٌو ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  دَخَلَ  سُلَيْكٌ الْغَطَفَانِيُّ  الْمَسْجِدَ وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ يَوْمَ الْجُمُعَةِ ، قَالَ :  أَصَلَّيْتَ ؟ قَالَ : لَا ، قَالَ : فَصَلِّ رَكْعَتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 1970","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند جابر"
"1971","204 - (  1971  ) -  حَدَّثَنَا  عَمْرٌو النَّاقِدُ ،  حَدَّثَنَا  سُفْيَانُ ، قَالَ :         [3/465]      قُلْتُ  لِعَمْرٍو :  أَسَمِعْتَ  جَابِرَ بْنَ عَبْدِ اللهِ يَقُولُ : مَرَّ  رَجُلٌ  بِسِهَامٍ فِي الْمَسْجِدِ ، فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَمْسِكْ بِنِصَالِهَا  ؟  .","","Musnad Abi Ya'la al-Mawsili 1971","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند جابر"
"1972","205 - (  1972  ) -  حَدَّثَنَا  عَمْرٌو النَّاقِدُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  عَنْ  جَابِرٍ قَالَ :  قَالَ  رَجُلٌ  يَوْمَ  أُحُدٍ  : يَا رَسُولَ اللهِ ، إِنْ قُتِلْتُ فَأَيْنَ أَنَا ؟ قَالَ :  فِي الْجَنَّةِ ، فَأَلْقَى تَمَرَاتٍ فِي يَدِهِ ، وَقَاتَلَ حَتَّى قُتِلَ  .         [3/466]","","Musnad Abi Ya'la al-Mawsili 1972","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند جابر"
"1973","206 - (  1973  ) -  حَدَّثَنَا  عَمْرٌو ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  سَمِعْتُ  جَابِرَ بْنَ عَبْدِ اللهِ ، يُشِيرُ إِلَى أُذُنَيْهِ ، سَمِعَ أُذُنَيَّ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَنَّ قَوْمًا يَخْرُجُونَ مِنَ النَّارِ فَيَدْخُلُونَ الْجَنَّةَ  .","","Musnad Abi Ya'la al-Mawsili 1973","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند جابر"
"1974","207 - (  1974  ) -  حَدَّثَنَا  عَمْرٌو ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  عَنْ  جَابِرٍ قَالَ :  قَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا  جَابِرُ  ، أَتَزَوَّجْتَ  ؟ قُلْتُ : نَعَمْ ، قَالَ : بِكْرًا أَوْ  ثَيِّبًا  ؟ قَالَ : قُلْتُ : لَا ، بَلْ  ثَيِّبًا  ، قَالَ : فَهَلَّا جَارِيَةً تُلَاعِبُكَ وَتُلَاعِبُهَا ؟ قُلْتُ : يَا رَسُولَ اللهِ ، إِنَّ أَبِي قُتِلَ  يَوْمَ  أُحُدٍ  وَتَرَكَ تِسْعَ بَنَاتٍ ، وَهُنَّ لِي تِسْعُ أَخَوَاتٍ ، فَلَمْ أُحِبَّ أَنْ أَجْمَعَ إِلَيْهِنَّ جَارِيَةً  خَرْقَاءَ  مِثْلَهُنَّ ، وَلَكِنِ امْرَأَةً تَمْشُطُهُنَّ وَتَقُومُ عَلَيْهِنَّ ، قَالَ : أَصَبْتَ  .","","Musnad Abi Ya'la al-Mawsili 1974","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند جابر"
"1975","208 - (  1975  ) -  حَدَّثَنَا  عَمْرٌو ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  عَنْ  جَابِرٍ :  أَطْعَمَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لُحُومَ الْخَيْلِ  ، وَنَهَانَا عَنْ لُحُومِ الْحُمُرِ  .         [3/467]","","Musnad Abi Ya'la al-Mawsili 1975","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند جابر"
"1976","209 - (  1976  ) -  حَدَّثَنَا  عَمْرٌو ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  عَنْ  جَابِرٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  دَخَلْتُ الْجَنَّةَ فَرَأَيْتُ فِيهَا دَارًا  ، فَسَمِعْتُ فِيهَا ضَوْضَاءَ ، فَقُلْتُ : لِمَنْ هَذَا ؟ قَالُوا :  لِرَجُلٍ مِنْ قُرَيْشٍ  ، قُلْتُ : مَنْ هُوَ ؟ قَالُوا :  عُمَرُ بْنُ الْخَطَّابِ  ، فَأَرَدْتُ أَنْ أَدْخُلَهَا ، فَذَكَرْتُ غَيْرَتَكَ يَا  أَبَا حَفْصٍ  ، فَبَكَى ، وَقَالَ : أَعَلَيْكَ أَغَارُ يَا رَسُولَ اللهِ . ؟!","","Musnad Abi Ya'la al-Mawsili 1976","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند جابر"
"1977","210 - (  1977  ) -  حَدَّثَنَا  عَمْرٌو ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  عَنْ  جَابِرٍ قَالَ :  إِنَّ  رَجُلًا  دَبَّرَ غُلَامًا لَهُ وَلَمْ يَكُنْ لَهُ مَالٌ غَيْرُهُ ، فَبَاعَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - ، فَاشْتَرَاهُ  ابْنُ النَّحَّامِ  مِنْهُ  .         [3/468]","","Musnad Abi Ya'la al-Mawsili 1977","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند جابر"
"1978","211 - (  1978  ) -  حَدَّثَنَا  عَمْرٌو ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ الْمُنْكَدِرِ ،  سَمِعَ  جَابِرَ بْنَ عَبْدِ اللهِ قَالَ :  قَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ تَزَوَّجْتُ : هَلِ اتَّخَذْتُمْ  أَنْمَاطًا  ؟ قُلْتُ : أَنَّى لَنَا  أَنْمَاطٌ  ؟ قَالَ :  أَمَا إِنَّهَا سَتَكُونُ  .","","Musnad Abi Ya'la al-Mawsili 1978","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن سفيان بن عيينة عن عمرو بن العباس الأهوازي عن أبو يعلى الموصلي","مسند جابر"
"1979","212 - (  1979  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى ، قَالَ :  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  حُصَيْنٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ، وَأَبِي سُفْيَانَ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  بَيْنَمَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ يَوْمَ الْجُمُعَةِ ، وَقَدِمَتْ  عِيرٌ  إِلَى  الْمَدِينَةِ  ، فَابْتَدَرَهَا أَصْحَابُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى لَمْ يَبْقَ مَعَهُ إِلَّا اثْنَا عَشَرَ رَجُلًا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  وَالَّذِي نَفْسِي         [3/469]      بِيَدِهِ لَوْ تَتَابَعْتُمْ حَتَّى لَا يَبْقَى مِنْكُمْ أَحَدٌ لَسَالَ بِكُمُ الْوَادِي النَّارَ  ، فَنَزَلَتْ هَذِهِ الْآيَةُ :         {      وَإِذَا رَأَوْا تِجَارَةً أَوْ لَهْوًا انْفَضُّوا إِلَيْهَا وَتَرَكُوكَ قَائِمًا         }      ، وَقَالَ : فِي الِاثْنَيْ عَشَرَ الَّذِينَ ثَبَتُوا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَبُو بَكْرٍ  ،  وَعُمَرُ  .","","Musnad Abi Ya'la al-Mawsili 1979","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن حصين بن عبد الرحمن السلمي عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند جابر"
"1980","213 - (  1980  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا  مَحْبُوبٌ ،  عَنْ  أُسَامَةَ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى الْمِنْبَرِ :  سَلُوا اللهَ عِلْمًا نَافِعًا  ، وَتَعَوَّذُوا بِاللهِ مِنْ عِلْمٍ لَا يَنْفَعُ  .","","Musnad Abi Ya'la al-Mawsili 1980","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن أسامة بن زيد الليثي المدني عن محبوب بن محرز القواريري عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند جابر"
"1981","214 - (  1981  ) -  حَدَّثَنَا  عَبْدُ اللهِ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عُيَيْنَةَ ،  عَنْ  أَبِي طَالِبٍ الْقَاصِّ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  نِعْمَ  الْإِدَامُ  الْخَلُّ  ، وَكَفَى بِالْمَرْءِ شَرًّا أَنْ  يَسْخَطَ  مَا قُرِّبَ إِلَيْهِ  .         [3/470]","","Musnad Abi Ya'la al-Mawsili 1981","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محارب بن دثار عن يحيى بن يعقوب بن مدرك عن إبراهيم بن عيينة الهلالي عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند جابر"
"1982","215 - (  1982  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ أَبُو سَعِيدٍ ،  حَدَّثَنَا  حَمَّادٌ ،  أَخْبَرَنَا  عَمْرٌو ،         [3/471]      عَنْ  جَابِرٍ قَالَ :  لَمَّا نَزَلَتْ :         {      قُلْ هُوَ الْقَادِرُ عَلَى أَنْ يَبْعَثَ عَلَيْكُمْ عَذَابًا مِنْ فَوْقِكُمْ أَوْ مِنْ تَحْتِ أَرْجُلِكُمْ         }      ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَعُوذُ بِوَجْهِكَ .         {      أَوْ يَلْبِسَكُمْ شِيَعًا وَيُذِيقَ بَعْضَكُمْ بَأْسَ بَعْضٍ         }      ، قَالَ :  هَذَا أَهْوَنُ أَوْ هَذَا أَيْسَرُ  .","","Musnad Abi Ya'la al-Mawsili 1982","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن حماد بن زيد عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"1983","216 - (  1983  ) -  حَدَّثَنَاهُ  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَمْرٍو ،  عَنْ  جَابِرٍ قَالَ  :  لَمَّا نَزَلَتْ :         {      هُوَ الْقَادِرُ عَلَى أَنْ يَبْعَثَ عَلَيْكُمْ عَذَابًا مِنْ فَوْقِكُمْ         }      ، قَالَ : أَعُوذُ بِوَجْهِكَ  ،         {      أَوْ مِنْ تَحْتِ أَرْجُلِكُمْ         }      ، قَالَ : أَعُوذُ بِوَجْهِكَ ،         {      أَوْ يَلْبِسَكُمْ شِيَعًا         }      ، قَالَ : هَذَا أَهْوَنُ  .","","Musnad Abi Ya'la al-Mawsili 1983","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن حماد بن زيد عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"1984","217 - (  1984  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَمْرٍو ،  عَنْ  جَابِرٍ ،  أَنَّ  رَجُلًا مِنَ الْأَنْصَارِ  أَعْتَقَ غُلَامًا لَهُ ، لَمْ يَكُنْ لَهُ مَالٌ غَيْرُهُ  ، قَالَ : فَبَلَغَ ذَلِكَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : مَنْ يَشْتَرِيهِ مِنِّي ؟ فَاشْتَرَاهُ  نُعَيْمُ بْنُ عَبْدِ اللهِ  بِثَمَانِمِائَةٍ ، فَدَفَعَهَا إِلَيْهِ ، قَالَ : سَمِعْتُ  جَابِرًا  يَقُولُ : عَبْدًا قِبْطِيًّا مَاتَ عَامَ أَوَّلَ  .         [3/472]","","Musnad Abi Ya'la al-Mawsili 1984","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن حماد بن زيد عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"1985","218 - (  1985  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  حَمَّادٌ ،  بِإِسْنَادِهِ  ، مِثْلَهُ .","","Musnad Abi Ya'la al-Mawsili 1985","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن حماد بن زيد عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"1986","219 - (  1986  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  عَمْرُو بْنُ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ،  أَنَّ  رَجُلًا مِنَ الْمُهَاجِرِينَ  كَسَعَ  رَجُلًا مِنَ الْأَنْصَارِ  ، تَجَمَّعَ قَوْمُ هَذَا وَقَوْمُ هَذَا ، فَقَالَ هَذَا : يَا  لَلْمُهَاجِرِينَ  ، وَقَالَ هَذَا : يَا  لَلْأَنْصَارِ  ، فَبَلَغَ ذَلِكَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  دَعُوهَا  فَإِنَّهَا  مُنْتِنَةٌ  ، ثُمَّ قَالَ : أَلَا مَا  بَالُ  دَعْوَى  الْجَاهِلِيَّةِ ؟ أَلَا مَا  بَالُ  دَعْوَى  الْجَاهِلِيَّةِ ؟  .","","Musnad Abi Ya'la al-Mawsili 1986","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن حماد بن زيد عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"1987","220 - (  1987  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  حَمَّادٌ ،  بِإِسْنَادِهِ  نَحْوَهُ .","","Musnad Abi Ya'la al-Mawsili 1987","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن حماد بن زيد عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"1988","221 - (  1988  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَمْرٍو ،  عَنْ  جَابِرٍ :  أَنَّ  رَجُلًا  دَخَلَ وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ يَوْمَ الْجُمُعَةِ ، فَقَالَ :  صَلَّيْتَ يَا فُلَانُ ؟ قَالَ : لَا ، قَالَ : فَقُمْ فَارْكَعْ  .","","Musnad Abi Ya'la al-Mawsili 1988","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن حماد بن زيد عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"1989","222 - (  1989  ) -  حَدَّثَنَاهُ  إِسْحَاقُ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،         [3/473]      عَنْ  جَابِرٍ ، قَالَ : بَيْنَمَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ النَّاسَ يَوْمَ الْجُمُعَةِ ، فَذَكَرَ نَحْوَهُ .","","Musnad Abi Ya'la al-Mawsili 1989","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن حماد بن زيد عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"1990","223 - (  1990  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَمْرٍو ،  عَنْ  جَابِرٍ قَالَ :  هَلَكَ أَبِي فَتَرَكَ  سَبْعَ بَنَاتٍ أَوْ تِسْعَ بَنَاتٍ  - قَالَ  حَمَّادٌ  : وَلَا أَعْلَمُهُ إِلَّا قَالَ : تِسْعَ .. - فَتَزَوَّجْتُ امْرَأَةً  ثَيِّبًا  ، فَقَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَزَوَّجْتَ يَا  جَابِرُ  ؟ قُلْتُ : نَعَمْ ، قَالَ : بِكْرًا أَمْ  ثَيِّبًا  ؟ قُلْتُ :  ثَيِّبًا  ، قَالَ : فَهَلَّا  جَارِيَةً تُلَاعِبُهَا وَتُلَاعِبُكَ ، أَوْ قَالَ : تُضَاحِكُهَا وَتُضَاحِكُكَ  ؟ قَالَ : قُلْتُ : إِنَّ  عَبْدَ اللهِ  هَلَكَ وَتَرَكَ تِسْعَ بَنَاتٍ ، وَإِنِّي كَرِهْتُ أَنْ أَجِيئَهُنَّ بِمِثْلِهِنَّ ، فَأَرَدْتُ امْرَأَةً تَقُومُ عَلَيْهِنَّ ، فَقَالَ لِي : بَارَكَ اللهُ لَكَ ، أَوْ قَالَ خَيْرًا  .","","Musnad Abi Ya'la al-Mawsili 1990","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن حماد بن زيد عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"1991","224 - (  1991  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَمْرٍو ،  سَمِعْتُ  جَابِرًا ، يَقُولُ :  هَلَكَ أَبِي وَتَرَكَ  تِسْعَ - أَوْ سَبْعَ  .. - فَذَكَرَ نَحْوَهُ ، إِلَّا أَنَّهُ قَالَ : فَقَالَ لِي :  فَبَارَكَ اللهُ لَكَ ، وَدَعَا لِي  .","","Musnad Abi Ya'la al-Mawsili 1991","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن حماد بن زيد عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"1992","225 - (  1992  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  حَمَّادٌ ، قَالَ :  قُلْتُ  لِعَمْرِو بْنِ دِينَارٍ :  يَا  أَبَا مُحَمَّدٍ  ،  أَسَمِعْتَ  جَابِرَ بْنَ عَبْدِ اللهِ يُحَدِّثُ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَنَّ اللهَ         [3/474]      يُخْرِجُ مِنَ النَّارِ قَوْمًا بِالشَّفَاعَةِ ؟ قَالَ : نَعَمْ  .","","Musnad Abi Ya'la al-Mawsili 1992","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن حماد بن زيد عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"1993","226 - (  1993  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  حَمَّادٌ  بِإِسْنَادِهِ  مِثْلَهُ .","","Musnad Abi Ya'la al-Mawsili 1993","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن حماد بن زيد عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"1994","227 - (  1994  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  عَمْرٌو ،  عَنْ  جَابِرٍ :  أَنَّ  رَجُلًا  مَرَّ بِأَسْهُمٍ فِي الْمَسْجِدِ قَدْ أَبْدَى نُصُولَهَا  ، فَأُمِرَ أَنْ يَأْخُذَ بِنُصُولِهَا لَا يَخْدِشُ مُسْلِمًا  .","","Musnad Abi Ya'la al-Mawsili 1994","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن حماد بن زيد عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"1995","228 - (  1994  (م)  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَمْرٍو ،  عَنْ  جَابِرٍ ، مِثْلَهُ .","","Musnad Abi Ya'la al-Mawsili 1994","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن حماد بن زيد عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"1996","229 - (  1995  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ، قَالَ :  قُلْتُ  لِعَمْرٍو :  أَسَمِعْتَ  جَابِرًا يُحَدِّثُ أَنَّ  رَجُلًا  دَخَلَ الْمَسْجِدَ بِسِهَامٍ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  خُذْ بِأَنْصَالِهَا  ؟ قَالَ : نَعَمْ  .","","Musnad Abi Ya'la al-Mawsili 1995","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"1997","230 - (  1996  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَمْرٍو ،  عَنْ  جَابِرٍ - قَالَ  حَمَّادٌ  : وَلَا أَعْلَمُهُ إِلَّا قَدْ  رَفَعَهُ  - أَنَّهُ  نَهَى عَنْ كِرَاءِ الْأَرْضِ  .         [3/475]","","Musnad Abi Ya'la al-Mawsili 1996","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن حماد بن زيد عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"1998","231 - (  1997  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  مَطَرٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرٍ  يَرْفَعُهُ  قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ كِرَاءِ الْأَرْضِ  .","","Musnad Abi Ya'la al-Mawsili 1997","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن مطر بن طهمان الوراق عن حماد بن زيد عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"1999","232 - (  1998  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  عَمْرٌو ،  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى  يَوْمَ  خَيْبَرَ  عَنْ لُحُومِ الْحُمُرِ  الْأَهْلِيَّةِ  ، وَأَذِنَ فِي لُحُومِ الْخَيْلِ  .","","Musnad Abi Ya'la al-Mawsili 1998","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن عمرو بن دينار الأثرم عن حماد بن زيد عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"2000","233 - (  1999  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  يَحْيَى بْنُ سُلَيْمٍ ،  عَنِ  ابْنِ خُثَيْمٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ أَنَّهُ         [3/476]      حَدَّثَهُ  جَابِرُ بْنُ عَبْدِ اللهِ ،  سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ  لِكَعْبِ بْنِ عُجْرَةَ  :  يَا  كَعْبُ بْنُ عُجْرَةَ  ، الصَّلَاةُ  قُرْبَانٌ  ، وَالصِّيَامُ  جُنَّةٌ  ، وَالصَّدَقَةُ تُطْفِئُ الْخَطِيئَةَ كَمَا يُطْفِئُ الْمَاءُ النَّارَ ، يَا  كَعْبُ بْنَ عُجْرَةَ  ، النَّاسُ غَادِيَانِ : فَبَائِعٌ نَفْسَهُ فَمُوبِقٌ رَقَبَتَهُ ، وَمُبْتَاعٌ نَفْسَهُ فَمُعْتِقٌ رَقَبَتَهُ  .","","Musnad Abi Ya'la al-Mawsili 1999","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الرحمن بن سابط الجمحي عن عبد الله بن عثمان بن خثيم عن يحيى بن سليم الطائفي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"2001","[4/5]      234 - (  2000  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبْدُ الْوَارِثِ بْنُ سَعِيدٍ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الْوَاحِدِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  سَمِعَ  جَابِرًا قَالَ : قَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الْعَبْدَ إِذَا تَزَوَّجَ بِغَيْرِ إِذْنِ سَيِّدِهِ كَانَ عَاهِرًا  .         [4/6]","","Musnad Abi Ya'la al-Mawsili 2000","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن القاسم بن عبد الواحد بن أيمن المخزومي عن عبد الوارث بن سعيد بن ذكوان عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"2002","235 - (  2001  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ قَالَ :  مَا سُئِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - شَيْئًا قَطُّ فَقَالَ : لَا  .","","Musnad Abi Ya'la al-Mawsili 2001","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"2003","236 - (  2002  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنَا  مُحَمَّدٌ السُّلَمِيُّ قَالَ  سُفْيَانُ  :  أُرَاهُ ابْنَ عَلِيٍّ ابْنَ عَمِّ الْمَنْصُورِ  ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  سَمِعَ  جَابِرًا قَالَ :  قَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا  جَابِرُ  ، عَلِمْتُ أَنَّ اللهَ أَحْيَا أَبَاكَ  فَقَالَ لَهُ : تَمَنَّ عَلَى اللهِ ، فَقَالَ : أَرْجِعُ إِلَى الدُّنْيَا فَأُقْتَلُ مَرَّةً أُخْرَى ، قَالَ : إِنِّي قَضَيْتُ أَنَّهُمْ لَا يَرْجِعُونَ  .         [4/7]","","Musnad Abi Ya'la al-Mawsili 2002","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن محمد بن علي بن ربيعة السلمي عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"2004","237 - (  2003  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  يَحْيَى بْنُ سُلَيْمٍ ،  عَنِ  ابْنِ خُثَيْمٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  لَمَّا رَجَعَتْ مُهَاجِرَةُ الْبَحْرِ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  أَلَا تُحَدِّثُونَ بِأَعَاجِيبَ مَا رَأَيْتُمْ بِأَرْضِ الْحَبَشَةِ ؟  قَالَ فِتْيَةٌ مِنْهَا : يَا رَسُولَ اللهِ ، بَيْنَمَا نَحْنُ جُلُوسٌ إِذْ مَرَّتْ عَلَيْنَا عَجُوزٌ مِنْ عَجَائِزِهَا تَحْمِلُ عَلَى رَأْسِهَا قُلَّةً مِنْ مَاءٍ ، فَمَرَّتْ بِفَتًى مِنْهُمْ ، فَجَعَلَ إِحْدَى يَدَيْهِ بَيْنَ كَتِفَيْهَا فَدَفَعَهَا ، فَخَرَّتْ عَلَى رُكْبَتِهَا ، فَانْكَسَرَتْ قُلَّتُهَا ، فَلَمَّا ارْتَفَعَتِ الْتَفَتَتْ إِلَيْهِ فَقَالَتْ : سَوْفَ تَعْلَمُ يَا  غُدَرُ  ، إِذَا وَضَعَ اللهُ الْكُرْسِيَّ ، وَجَمَعَ الْأَوَّلِينَ وَالْآخِرِينَ ، وَتَكَلَّمَتِ الْأَيْدِي وَالْأَرْجُلُ بِمَا كَانُوا يَكْسِبُونَ ، فَسَوْفَ تَعْلَمُ كَيْفَ أَمْرُكَ وَأَمْرِي عِنْدَهُ غَدًا ،         [4/8]      قَالَ : يَقُولُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : صَدَقَتْ ثُمَّ صَدَقَتْ ، كَيْفَ يُقَدِّسُ اللهُ قَوْمًا لَا يُؤْخَذُ لِضَعِيفِهِمْ مِنْ شَدِيدِهِمْ  .","","Musnad Abi Ya'la al-Mawsili 2003","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد الله بن عثمان بن خثيم عن يحيى بن سليم الطائفي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"2005","238 - (  2004  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  مَالِكُ بْنُ سُعَيْرِ بْنِ الْخِمْسِ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عَبْدِ الْمَلِكِ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  لَمَّا كَانَ  الْخَنْدَقُ  نَظَرْتُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَوَجَدْتُهُ قَدْ وَضَعَ حَجَرًا بَيْنَهُ وَبَيْنَ إِزَارِهِ  يُقِيمُ بِهِ صُلْبَهُ مِنَ الْجُوعِ  .","","Musnad Abi Ya'la al-Mawsili 2004","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن إسماعيل بن عبد الملك بن أبي الصفير الأسدي عن مالك بن سعير التميمي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"2006","239 - (  2005  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ         [4/9]      الْأَعْمَشِ ،  عَنْ  أَبِي صَالِحٍ ، وَأَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  جَاءَ رَجُلٌ يُقَالُ لَهُ :  أَبُو حُمَيْدٍ  بِقَدَحٍ مِنْ لَبَنٍ مِنَ النَّقِيعِ ، فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَلَا  خَمَّرْتَهُ  وَلَوْ بِعُودٍ  تَعْرِضُهُ  عَلَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 2005","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2007","240 - (  2006  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  كَانَ  رَجُلٌ  يَرْقِي مِنَ الْعَقْرَبِ ، فَنَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الرُّقَى  ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّكَ نَهَيْتَ عَنِ الرُّقَى وَإِنِّي كُنْتُ أَرْقِي مِنَ الْعَقْرَبِ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : مَنِ اسْتَطَاعَ مِنْكُمْ أَنْ يَنْفَعَ أَخَاهُ فَلْيَفْعَلْ  .","","Musnad Abi Ya'la al-Mawsili 2006","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2008","241 - (  2007  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  كَانَ خَالِي مِنَ  الْأَنْصَارِ  يَرْقِي مِنَ الْحُمَةِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : اعْرِضْهَا عَلَيَّ  ، فَعَرَضَهَا عَلَيْهِ ، فَقَالَ         [4/10]      رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : لَا بَأْسَ بِهَذِهِ ، هَذِهِ مِنَ الْمَوَاثِيقِ .","","Musnad Abi Ya'la al-Mawsili 2007","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن إسحاق بن إسماعيل الطالقاني عن أبو يعلى الموصلي","مسند جابر"
"2009","242 - (  2008  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا سَجَدَ أَحَدُكُمْ فَلْيَعْتَدِلْ  ، وَلَا يَفْتَرِشْ ذِرَاعَيْهِ  افْتِرَاشَ  الْكَلْبِ  .","","Musnad Abi Ya'la al-Mawsili 2008","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2010","243 - (  2009  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  كَانَتْ عِنْدَ  عَائِشَةَ  امْرَأَةٌ ، قَالَ أَبُو يَعْلَى : تَصُبُّ عَلَى صَبِيٍّ يَقْطُرُ  مَنْخِرَاهُ  دَمًا ، فَدَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [4/11]      فَقَالَ : مَا  شَأْنُ  هَذَا الصَّبِيِّ ؟ فَقَالُوا : بِهِ  الْعُذْرَةُ  ، فَقَالَ :  وَيْحَكُنَّ يَا مَعْشَرَ النِّسَاءِ ، لَا تَقْتُلْنَ أَوْلَادَكُنَّ  ، أَيُّمَا امْرَأَةٍ كَانَ بِصَبِيِّهَا  عُذْرَةٌ  أَوْ وَجَعٌ بِرَأْسِهِ ، فَلْتَأْخُذْ قُسْطًا هِنْدِيًّا فَلْتَحُكَّهُ ، ثُمَّ لِتُسْعِطْ ، ثُمَّ أَمَرَ  عَائِشَةَ  فَفَعَلَتْ ذَلِكَ بِالصَّبِيِّ فَبَرَأَ  .","","Musnad Abi Ya'la al-Mawsili 2009","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2011","244 - (  2010  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  جَابِرٍ قَالَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا سَجَدَ جَافَى حَتَّى يُرَى بَيَاضُ إِبْطَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 2010","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سالم بن أبي الجعد الغطفاني عن منصور بن المعتمر عن عبد الرزاق الصنعاني عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"2012","245 - (  2011  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ ،  أَنَّ وَفْدَ  ثَقِيفَ  سَأَلُوا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالُوا : إِنَّ أَرْضَنَا أَرْضٌ بَارِدَةٌ ، فَكَيْفَ بِالْغُسْلِ ؟  فَقَالَ : أَمَّا أَنَا فَأَحْثِي عَلَى رَأْسِي ثَلَاثًا  .         [4/12]","","Musnad Abi Ya'la al-Mawsili 2011","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن جعفر بن إياس اليشكري عن هشيم بن بشير عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2013","246 - (  2012  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  هِشَامُ بْنُ يُوسُفَ ،  عَنِ  ابْنِ جُرَيْجٍ قَالَ :  حَدَّثَنِي  أَبُو الزُّبَيْرِ  أَنَّهُ سَمِعَ  جَابِرَ بْنَ عَبْدِ اللهِ يَقُولُ :  لَمْ يَطُفِ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَا أَصْحَابُهُ بَيْنَ  الصَّفَا  وَالْمَرْوَةِ  إِلَّا طَوَافًا وَاحِدًا  : طَوَافَهُ الْأَوَّلَ  .         [4/13]","","Musnad Abi Ya'la al-Mawsili 2012","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن هشام بن يوسف الأبناوي عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2014","247 - (  2013  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ،  أَخْبَرَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنِ  ابْنِ أَبِي صُعَيْرٍ ،  عَنْ  جَابِرٍ قَالَ :  لَمَّا كَانَ  يَوْمُ أُحُدٍ  أَشْرَفَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى الشُّهَدَاءِ الَّذِينَ اسْتُشْهِدُوا يَوْمَئِذٍ ، فَقَالَ :  زَمِّلُوهُمْ  بِدِمَائِهِمْ  ، فَإِنِّي قَدْ شَهِدْتُ عَلَى هَؤُلَاءِ ، فَكَانَ يُدْفَنُ الرَّجُلَانِ وَالثَّلَاثَةُ فِي الْقَبْرِ الْوَاحِدِ ، وَيَسْأَلُ أَيُّهُمْ كَانَ أَقْرَأَ لِلْقُرْآنِ فَيُقَدِّمُهُ .  قَالَ  جَابِرٌ  : فَدُفِنَ أَبِي وَعَمِّي يَوْمَئِذٍ فِي قَبْرٍ وَاحِدٍ  .","","Musnad Abi Ya'la al-Mawsili 2013","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن ثعلبة بن صعير عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"2015","248 - (  2014  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  سَمِعَهُ مِنْ  جَابِرٍ ، وَعَمْرِو بْنِ دِينَارٍ ،  سَمِعَ  جَابِرَ بْنَ عَبْدِ اللهِ يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  دَخَلْتُ الْجَنَّةَ فَرَأَيْتُ فِيهَا  دَارًا ، أَوْ قَصْرًا  ، فَسَمِعْتُ فِيهِ  صَوْتًا ، أَوْ ضَوْضَاءَ  ، فَقُلْتُ : لِمَنْ هَذَا ؟ قِيلَ : هُوَ  لِابْنِ الْخَطَّابِ  ، قَالَ  سُفْيَانُ  : زَادَ  ابْنُ الْمُنْكَدِرِ  : فَأَرَدْتُ أَنْ أَدْخُلَهُ ، فَذَكَرْتُ غَيْرَتَكَ ، فَبَكَى  عُمَرُ  ، قَالَ : يَا نَبِيَّ اللهِ ، أَوَ أَغَارُ عَلَيْكَ . ؟         [4/14]","","Musnad Abi Ya'la al-Mawsili 2014","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2016","249 - (  2015  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  سَمِعَ  جَابِرَ بْنَ عَبْدِ اللهِ ، يَقُولُ : قَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا  جَابِرُ  ، هَلِ اتَّخَذْتُمْ  أَنْمَاطًا  ؟  قُلْتُ : أَيْ رَسُولَ اللهِ ، وَأَنَّى لَنَا  أَنْمَاطٌ ،  قَالَ : أَمَا إِنَّهَا سَتَكُونُ  .","","Musnad Abi Ya'la al-Mawsili 2015","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن سفيان بن عيينة عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2017","250 - (  2016  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  سَمِعَ  جَابِرَ بْنَ عَبْدِ اللهِ يَقُولُ :  وُلِدَ  لِرَجُلٍ  مِنَّا غُلَامٌ فَسَمَّاهُ  الْقَاسِمَ  ، فَقُلْنَا : لَا نَكْنِيكَ  أَبَا الْقَاسِمِ  ، وَلَا نُنْعِمُكَ عَيْنًا ، فَأَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرَ ذَلِكَ لَهُ ، فَقَالَ :  سَمِّهِ  عَبْدَ الرَّحْمَنِ  .","","Musnad Abi Ya'la al-Mawsili 2016","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن سفيان بن عيينة عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2018","251 - (  2017  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ، وَمُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ :  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَكَلَ لَحْمًا ثُمَّ صَلَّى وَلَمْ يَتَوَضَّأْ  ، وَأَنَّ  أَبَا بَكْرٍ  أَكَلَ لَحْمًا ثُمَّ صَلَّى وَلَمْ يَتَوَضَّأْ ، وَأَنَّ  عُمَرَ بْنَ الْخَطَّابِ  أَكَلَ لَحْمًا ثُمَّ صَلَّى وَلَمْ يَتَوَضَّأْ  .         [4/15]","","Musnad Abi Ya'la al-Mawsili 2017","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن سفيان الثوري عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"2019","252 - (  2018  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  سَمِعَ  مِنْ جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  مَرِضْتُ فَأَتَانِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأَبُو بَكْرٍ  وَهُمَا يَمْشِيَانِ  فَوَجَدَانِي قَدْ غُشِيَ عَلَيَّ ، فَتَوَضَّأَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَصَبَّ عَلَيَّ وَضُوءَهُ ،  فَأَفَقْتُ  ، فَسَأَلْتُهُ ، فَقُلْتُ : يَا رَسُولَ اللهِ ، كَيْفَ أَصْنَعُ فِي مَالِي ؟ فَلَمْ يُجِبْنِي ، حَتَّى نَزَلَتْ آيَةُ الْمِيرَاثِ ، يَعْنِي قَوْلَهُ :         {      يُوصِيكُمُ اللهُ فِي أَوْلادِكُمْ         }      .         [4/16]             [4/17]","","Musnad Abi Ya'la al-Mawsili 2018","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"2020","253 - (  2019  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ قَالَ :  قَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَوْ قَدْ جَاءَ مَالُ  الْبَحْرَيْنِ  أَعْطَيْتُكَ هَكَذَا وَهَكَذَا وَهَكَذَا  ، وَحَثَا  سُفْيَانُ  يُرِينَا بِيَدِهِ ثَلَاثَ  حَثَيَاتٍ  نَحْوَ رَأْسِهِ ، فَلَمْ يَقْدَمْ مَالُ  الْبَحْرَيْنِ  حَتَّى قُبِضَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فَلَمَّا أَنْ قَدِمَ مَالُ  الْبَحْرَيْنِ  قَامَ  أَبُو بَكْرٍ  ، فَقَالَ : مَنْ كَانَتْ لَهُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِدَةٌ أَوْ دَيْنٌ فَلْيَأْتِ ، قَالَ  جَابِرٌ  : فَأَتَيْتُهُ ، فَقُلْتُ : إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعَدَنِي ، قَالَ : فَأَعْطَانِي ، ثُمَّ أَتَيْتُهُ بَعْدَ ذَلِكَ أَسْأَلُهُ ، فَلَمْ يُعْطِنِي ، ثُمَّ أَتَيْتُهُ الثَّالِثَةَ ، فَقُلْتُ : قَدْ سَأَلْتُكَ فَلَمْ تُعْطِنِي وَسَأَلْتُ فَلَمْ تُعْطِنِي ، فَإِمَّا أَنْ تُعْطِيَ ، وَإِمَّا أَنْ تَبْخَلَ عَلَيَّ ، فَقَالَ : وَأَيُّ الدَّاءِ أَدْوَأُ مِنَ الْبُخْلِ ! مَا مَنَعْتُكَ مِنْ مَرَّةٍ إِلَّا وَأَنَا أُرِيدُ أَنْ أُعْطِيَكَ .","","Musnad Abi Ya'la al-Mawsili 2019","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن سفيان بن عيينة عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2021","254 - (  2020  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ         [4/18]      عَمْرِو بْنِ دِينَارٍ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  جَابِرٍ ، مِثْلَهُ ، إِلَّا أَنَّهُ قَالَ :  حَثَا لِي حَثْيَةً فَعَدَدْتُهَا ، فَوَجَدْتُهَا خَمْسَمِائَةٍ  ، قَالَ : فَقَالَ : خُذْ مِثْلَهَا مَرَّتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 2020","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2022","255 - (  2021  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  سَمِعَ  جَابِرًا يَقُولُ :  قُتِلَ أَبِي  يَوْمَ أُحُدٍ  ، فَجِيءَ بِهِ وَقَدْ مُثِّلَ بِهِ ، فَوُضِعَ بَيْنَ يَدَيْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَعَلْتُ أُرِيدُ أَنْ أَكْشِفَ عَنْهُ وَيَنْهَانِي قَوْمِي مَرَّتَيْنِ ، فَأَمَرَ بِهِ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرُفِعَ ، قَالَ  سُفْيَانُ  : كَأَنَّهُمْ رُدُّوا إِلَى مَصَارِعِهِمْ ، قَالَ : سَمِعَ صَوْتَ صَائِحَةٍ ، فَقَالَ : مَنْ هَذِهِ ؟ فَقَالُوا :  ابْنَةُ  عَمْرٍو  أَوْ أُخْتُ  عَمْرٍو  ، قَالَ :  فَلِمَ تَبْكِي ؟ أَوْ لَا تَبْكِي  فَمَا زَالَتِ الْمَلَائِكَةُ تُظِلُّهُ بِأَجْنِحَتِهَا حَتَّى رُفِعَ  .         [4/19]","","Musnad Abi Ya'la al-Mawsili 2021","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن سفيان الثوري عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2023","256 - (  2022  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ الْمُنْكَدِرِ ،  سَمِعَ  جَابِرًا يَقُولُ :  نَدَبَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - النَّاسَ  يَوْمَ الْخَنْدَقِ  فَانْتَدَبَ  الزُّبَيْرُ  ، ثُمَّ نَدَبَ النَّاسَ  فَانْتَدَبَ  الزُّبَيْرُ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لِكُلِّ نَبِيٍّ حَوَارِيٌّ  وَحَوَارِيَّ  الزُّبَيْرُ  .         [4/20]","","Musnad Abi Ya'la al-Mawsili 2022","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن سفيان الثوري عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2024","257 - (  2023  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  سَمِعَ  جَابِرًا يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْمَدِينَةُ  كَالْكِيرِ  تَنْفِي  خَبَثَهَا  ،  وَيَنْصَعُ  طِيبُهَا  .         [4/21]","","Musnad Abi Ya'la al-Mawsili 2023","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن سفيان بن عيينة عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2025","258 - (  2024  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  سَمِعَ  جَابِرًا يَقُولُ :  كَانَتْ يَهُودُ تَقُولُ : مَنْ أَتَى امْرَأَتَهُ فِي  قُبُلِهَا  مِنْ دُبُرِهَا كَانَ الْوَلَدُ أَحْوَلَ  فَنَزَلَتْ :         {      نِسَاؤُكُمْ حَرْثٌ لَكُمْ فَأْتُوا حَرْثَكُمْ أَنَّى شِئْتُمْ         }      .         [4/22]","","Musnad Abi Ya'la al-Mawsili 2024","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن سفيان بن عيينة عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2026","259 - (  2025  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  أَخْبَرَنَا  حَجَّاجٌ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا بَأْسَ بِالْحَيَوَانِ اثْنَيْنِ بِوَاحِدٍ يَدًا بِيَدٍ  ، وَلَا خَيْرَ فِيهِ نَسَاءً  .         [4/23]","","Musnad Abi Ya'la al-Mawsili 2025","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حجاج بن أرطاة عن عباد بن العوام الكلابي عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2027","260 - (  2026  ) -  حَدَّثَنَا  إِسْحَاقُ ، وَزُهَيْرٌ قَالَا :  حَدَّثَنَا  وَكِيعٌ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  حَسَّانَ بْنِ عَطِيَّةَ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَأَى  رَجُلًا  وَسِخَةً ثِيَابُهُ ، فَقَالَ : أَمَا وَجَدَ هَذَا مَا يُنَقِّي ثِيَابَهُ ؟  وَرَأَى رَجُلًا  ثَائِرَ  الشَّعَرِ ، فَقَالَ : مَا وَجَدَ هَذَا مَا يُسَكِّنُ بِهِ شَعَرَهُ ؟  .","","Musnad Abi Ya'la al-Mawsili 2026","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن حسان بن عطية المحاربي عن أبو عمرو الأوزاعي عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2028","261 - (  2027  ) -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  حَدَّثَنَا  وُهَيْبٌ ،  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  أَقَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تِسْعًا  بِالْمَدِينَةِ  لَمْ يَحُجَّ ثُمَّ أَذَّنَ فِي النَّاسِ بِالْخُرُوجِ  ، فَلَمَّا جَاءَ  ذَا الْحُلَيْفَةِ         [4/24]      صَلَّى  بِذِي الْحُلَيْفَةِ  ، وَوَلَدَتْ  أَسْمَاءُ بِنْتُ عُمَيْسٍ  مُحَمَّدَ بْنَ أَبِي بَكْرٍ  ، فَأَرْسَلَتْ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : اغْتَسِلِي وَاسْتَثْفِرِي بِثَوْبٍ وَأَهِلِّي ، قَالَ : فَفَعَلَتْ ، فَلَمَّا اطْمَأَنَّ صَدْرُ رَاحِلَةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى ظَهْرِ  الْبَيْدَاءِ  أَهَلَّ ، وَأَهْلَلْنَا لَا نَعْرِفُهُ إِلَّا  الْحَجَّ  وَلَهُ خَرَجْنَا ، وَرَسُولُ اللهِ بَيْنَ أَظْهُرِنَا ، وَالْقُرْآنُ يَنْزِلُ عَلَيْهِ ، وَهُوَ يَعْرِفُ تَأْوِيلَهُ ، وَإِنَّمَا يَفْعَلُ مَا أُمِرَ بِهِ .  قَالَ  جَابِرٌ  : فَنَظَرْتُ بَيْنَ يَدَيَّ ، وَمِنْ خَلْفِي ، وَعَنْ يَمِينِي ، وَعَنْ شِمَالِي مَدَّ بَصَرِي ، وَالنَّاسُ مُشَاةٌ وَرُكْبَانٌ ، فَجَعَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُلَبِّي :  لَبَّيْكَ  اللَّهُمَّ  لَبَّيْكَ ،  لَا شَرِيكَ لَكَ  لَبَّيْكَ ،  إِنَّ الْحَمْدَ وَالنِّعْمَةَ لَكَ وَالْمُلْكَ ، لَا شَرِيكَ لَكَ ، فَلَمَّا قَدِمْنَا مَكَّةَ بَدَأَ  فَاسْتَلَمَ  الرُّكْنَ فَسَعَى ثَلَاثَةَ أَطْوَافٍ وَمَشَى أَرْبَعَةً ، فَلَمَّا فَرَغَ مِنْ طَوَافِهِ انْطَلَقَ إِلَى الْمَقَامِ فَقَالَ : قَالَ اللهُ :         {      وَاتَّخِذُوا مِنْ مَقَامِ إِبْرَاهِيمَ مُصَلًّى         }      فَصَلَّى خَلْفَ  مَقَامِ إِبْرَاهِيمَ  رَكْعَتَيْنِ ، قَالَ  جَعْفَرٌ  : قَالَ أَبِي : كَانَ يَقْرَأُ فِيهِمَا بِالتَّوْحِيدِ :         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      قَالَ : وَلَمْ يَذْكُرْ ذَلِكَ عَنْ  جَابِرٍ  ثُمَّ انْطَلَقَ إِلَى الرُّكْنِ ،  فَاسْتَلَمَهُ  ثُمَّ انْطَلَقَ إِلَى  الصَّفَا  ، فَقَالَ :         [4/25]      نَبْدَأُ بِمَا بَدَأَ اللهُ بِهِ :         {      إِنَّ الصَّفَا وَالْمَرْوَةَ مِنْ شَعَائِرِ اللهِ         }      فَرَقِيَ عَلَى  الصَّفَا  حَتَّى بَدَا لَهُ  الْبَيْتُ  ، فَكَبَّرَ ثَلَاثًا ، وَقَالَ : لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ ، يُحْيِي وَيُمِيتُ ، بِيَدِهِ الْخَيْرُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ثَلَاثًا ، ثُمَّ دَعَا فِي ذَلِكَ ، ثُمَّ هَبَطَ مِنَ  الصَّفَا  ، فَمَشَى حَتَّى إِذَا  انْصَبَّتْ  قَدَمَاهُ فِي بَطْنِ الْمَسِيلِ سَعَى ، حَتَّى إِذَا صَعِدَتْ قَدَمَاهُ مِنْ بَطْنِ الْمَسِيلِ مَشَى إِلَى  الْمَرْوَةِ  ، فَرَقِيَ عَلَى  الْمَرْوَةِ  حَتَّى بَدَا لَهُ  الْبَيْتُ  فَقَالَ مِثْلَ مَا قَالَ عَلَى  الصَّفَا  ، فَطَافَ سَبْعًا ، وَقَالَ : مَنْ لَمْ يَكُنْ مَعَهُ هَدْيٌ فَلْيَحِلَّ ، وَمَنْ كَانَ مَعَهُ هَدْيٌ فَلْيُقِمْ عَلَى إِحْرَامِهِ ، فَإِنِّي لَوْلَا أَنَّ مَعِيَ هَدْيًا لَحَلَلْتُ ، وَلَوْ أَنِّي  اسْتَقْبَلْتُ  مِنْ أَمْرِي مَا اسْتَدْبَرْتُ لَأَهْلَلْتُ بِعُمْرَةٍ .  قَالَ : وَقَدِمَ  عَلِيٌّ  مِنَ  الْيَمَنِ  ، فَقَالَ لَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : بِأَيِّ شَيْءٍ أَهْلَلْتَ يَا  عَلِيُّ  ؟ قَالَ : قُلْتُ : اللَّهُمَّ إِنِّي أُهِلُّ بِمَا أَهَلَّ بِهِ رَسُولُكَ ، قَالَ : فَإِنَّ مَعِيَ هَدْيًا فَلَا تَحِلَّ .  قَالَ  عَلِيٌّ  : فَدَخَلْتُ عَلَى  فَاطِمَةَ  وَقَدِ اكْتَحَلَتْ وَلَبِسَتْ ثِيَابًا  صَبِيغًا  فَقُلْتُ : مَنْ أَمَرَكِ بِهَذَا ؟ فَقَالَتْ : أَبِي أَمَرَنِي .  قَالَ : وَكَانَ  عَلِيٌّ  يَقُولُ  بِالْعِرَاقِ  : فَانْطَلَقْتُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  مُحَرِّشًا  عَلَى  فَاطِمَةَ  مُسْتَثْبِتًا فِي الَّذِي قَالَتْ ، فَقَالَ : صَدَقَتْ ، أَنَا أَمَرْتُهَا .         [4/26]      قَالَ : وَنَحَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِائَةَ بَدَنَةٍ ، مِنْ ذَلِكَ بِيَدِهِ ثَلَاثًا وَسِتِّينَ ، وَنَحَرَ عَلِيٌّ مَا غَبَرَ ، ثُمَّ أَخَذَ مِنْ كُلِّ بَدَنَةٍ قِطْعَةً فَطَبَخَ جَمِيعًا ، فَأَكَلَا مِنَ اللَّحْمِ وَشَرِبَا مِنَ الْمَرَقَةِ .  فَقَالَ  سُرَاقَةُ بْنُ مَالِكِ بْنِ جُعْشُمٍ  : يَا رَسُولَ اللهِ ، أَلِعَامِنَا هَذَا أَمْ  لِلْأَبَدِ  ؟ قَالَ : لَا ، بَلْ  لِلْأَبَدِ  ،  دَخَلَتِ  الْعُمْرَةُ فِي  الْحَجِّ  ،  وَشَبَّكَ  بَيْنَ أَصَابِعِهِ  .","","Musnad Abi Ya'la al-Mawsili 2027","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن وهيب بن خالد الكرابيسي عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","مسند جابر"
"2029","262 - (  2028  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ الْقَطَّانُ ،  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  أَبِي  قَالَ : أَتَيْنَا جَابِرَ بْنَ عَبْدِ اللهِ ثُمَّ ، فَذَكَرَ نَحْوَهُ .         [4/27]","","Musnad Abi Ya'la al-Mawsili 2028","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2030","263 - (  2029  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  نَضْرٌ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  سَعْدٍ قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَمْرٍو قَالَ :  قَدِمَ  الْحَجَّاجُ  فَكَانَ يُؤَخِّرُ الصَّلَاةَ ، فَسَأَلْنَا جَابِرَ بْنَ عَبْدِ اللهِ عَنْ ذَلِكَ ، فَقَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي الظُّهْرَ بِالْهَاجِرَةِ حِينَ تَزُولُ الشَّمْسُ  ، وَالْعَصْرَ وَالشَّمْسُ نَقِيَّةٌ ، وَالْمَغْرِبَ حِينَ تَغْرُبُ الشَّمْسُ ، وَالْعِشَاءَ أَحْيَانًا يُؤَخِّرُ وَأَحْيَانًا يُعَجِّلُ ، فَكَانَ إِذَا رَأَى النَّاسَ قَدِ اجْتَمَعُوا عَجَّلَ ، وَإِذَا رَآهُمْ قَدْ تَأَخَّرُوا أَخَّرَ ،  وَكَانُوا أَوْ كَانَ  يُصَلِّي الصُّبْحَ  بِغَلَسٍ  .","","Musnad Abi Ya'la al-Mawsili 2029","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن عمرو بن الحسن بن علي بن أبي طالب عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن شعبة بن الحجاج عن النضر بن شميل عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"2031","264 - (  2030  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  يَحْيَى بْنُ سُلَيْمٍ ،  عَنِ  ابْنِ خُثَيْمٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،         [4/28]      عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ لَمْ يَذَرِ  الْمُخَابَرَةَ  ، فَلْيَأْذَنْ بِحَرْبٍ مِنَ اللهِ وَرَسُولِهِ  .","","Musnad Abi Ya'la al-Mawsili 2030","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد الله بن عثمان بن خثيم عن يحيى بن سليم الطائفي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"2032","265 - (  2031  ) -  حَدَّثَنَا  إِسْحَاقُ قَالَ :  سَمِعْتُ  مُعْتَمِرًا يَقُولُ :  حَدَّثَ  أَبِي  ،  عَنْ  خِدَاشٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا اسْتَلْقَى أَحَدُكُمْ فَلَا يَضَعْ إِحْدَى رِجْلَيْهِ عَلَى الْأُخْرَى  .         [4/29]","","Musnad Abi Ya'la al-Mawsili 2031","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن خداش بن عياش العبدي عن سليمان بن طرخان عن معتمر بن سليمان عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2033","266 - (  2032  ) -  حَدَّثَنَا  زَكَرِيَّا ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَابِرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  :  أَنَّهُ اسْتَحْلَفَ ابْنَيْ  صُورِيَا  حَيْثُ سَأَلَهُمَا عَنِ الرَّجْمِ ، فَاسْتَحْلَفَهُمَا  ، كَيْفَ تَجِدَانِهِ فِي كِتَابِ اللهِ فِي كِتَابِكُمْ ؟ قَالَ : فَاسْتَحْلَفَهُمَا بِاللهِ الَّذِي لَا إِلَهَ إِلَّا هُوَ الَّذِي أَنْزَلَ التَّوْرَاةَ عَلَى  مُوسَى  ، كَيْفَ تَجِدُونَ حَدَّ الزَّانِي فِي كِتَابِكُمْ  ؟ .","","Musnad Abi Ya'la al-Mawsili 2032","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن هشيم بن بشير عن زكريا بن عدي بن رزيق عن أبو يعلى الموصلي","مسند جابر"
"2034","267 - (  2033  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى ،  حَدَّثَنَا  هُشَيْمٌ ،  حَدَّثَنَا  عَبْدُ الْمَلِكِ ،  عَنْ  عَطَاءٍ ،         [4/30]      عَنْ  جَابِرٍ قَالَ :  شَهِدْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْعِيدَ ، صَلَّى قَبْلَ أَنْ يَخْطُبَ بِغَيْرِ أَذَانٍ وَلَا إِقَامَةٍ  ، ثُمَّ خَطَبَ بَعْدَمَا صَلَّى ، فَوَعَظَ النَّاسَ وَذَكَّرَهُمْ ، ثُمَّ أَتَى النِّسَاءَ فَوَعَظَهُنَّ ، وَمَعَهُ  بِلَالٌ  ، فَذَكَّرَهُنَّ ، وَأَمَرَهُنَّ بِالصَّدَقَةِ ، قَالَ : فَجَعَلَتِ الْمَرْأَةُ تُلْقِي خَاتَمَهَا ،  وَخُرْصَهَا  ، وَالشَّيْءَ كَذَلِكَ ، فَأَمَرَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِلَالًا  فَجَمَعَ مَا هُنَاكَ ، فَقَالَ : إِنَّ مِنْكُنَّ فِي الْجَنَّةِ لَيَسِيرًا ، فَقَالَتِ امْرَأَةٌ : يَا رَسُولَ اللهِ ، لِمَ ؟ قَالَ : إِنَّكُنَّ تُكْثِرْنَ اللَّعْنَ وَتَكْفُرْنَ  الْعَشِيرَ  .         [4/31]","","Musnad Abi Ya'la al-Mawsili 2033","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند جابر"
"2035","268 - (  2034  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  عَبْدِ الْمَلِكِ قَالَ :  سَمِعْتُ  عَطَاءً  يُحَدِّثُ ، عَنْ  جَابِرٍ قَالَ :  كُنَّا نَتَمَتَّعُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَنَذْبَحُ الْبَقَرَةَ عَنْ سَبْعَةٍ  ، وَنَشْتَرِكُ فِيهَا  .         [4/32]","","Musnad Abi Ya'la al-Mawsili 2034","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند جابر"
"2036","269 - (  2035  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  حَجَّاجٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرٍ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ كَانَتْ لَهُ أَرْضٌ فَلْيَزْرَعْهَا  ، فَإِنْ عَجَزَ عَنْهَا ،  فَلْيَمْنَحْهَا  أَخَاهُ الْمُسْلِمَ وَلَا يُكْرِهَا  .","","Musnad Abi Ya'la al-Mawsili 2035","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن حجاج بن أرطاة عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند جابر"
"2037","270 - (  2036  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ قَالَ :  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  عَبْدِ رَبِّهِ بْنِ سَعِيدٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لِكُلِّ دَاءٍ دَوَاءٌ  ، فَإِذَا         [4/33]      أُصِيبَ ،  يَعْنِي : دَوَاءُ الدَّاءِ  ، بَرَأَ بِإِذْنِ اللهِ  .","","Musnad Abi Ya'la al-Mawsili 2036","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد ربه بن سعيد النجاري عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","مسند جابر"
"2038","271 - (  2037  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ قَالَ :  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ، أَنَّ بُكَيْرًا  حَدَّثَهُ  ، أَنَّ عَاصِمَ بْنَ عُمَرَ بْنِ قَتَادَةَ  حَدَّثَهُ  ،  أَنَّ  جَابِرَ بْنَ عَبْدِ اللهِ عَادَ الْمُقَنَّعَ ، ثُمَّ قَالَ : لَا أَبْرَحُ حَتَّى تَحْتَجِمَ ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ فِيهِ شِفَاءً  .         [4/34]","","Musnad Abi Ya'la al-Mawsili 2037","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عاصم بن عمر الظفري عن بكير بن عبد الله بن الأشج القرشي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند جابر"
"2039","272 - (  2038  ) -  حَدَّثَنَا  هَارُونُ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ الْحَرَّانِيُّ قَالَ :  أَخْبَرَنِي  أَوْ  أَخْبَرَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  عَمِّهِ وَاسِعِ بْنِ حَبَّانَ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ  أَمَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ كُلِّ  جَادٍّ  عَشَرَةِ  أَوْسُقٍ  مِنَ التَّمْرِ  بِقِنْوٍ  يُعَلَّقُ فِي الْمَسْجِدِ لِلْمَسَاكِينِ  .","","Musnad Abi Ya'la al-Mawsili 2038","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن واسع بن حبان بن منقذ المازني عن محمد بن يحيى بن حبان عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند جابر"
"2040","273 - (  2039  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ قَالَ :  أَخْبَرَنِي  عَبْدُ اللهِ بْنُ وَهْبٍ قَالَ :  أَخْبَرَنِي  دَاوُدُ بْنُ قَيْسٍ الْمَدَنِيُّ ، وَغَيْرُهُ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلِ بْنِ أَبِي طَالِبٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ،  أَنَّ امْرَأَةَ  سَعْدِ بْنِ الرَّبِيعِ  ، قَالَتْ : يَا رَسُولَ اللهِ ، إِنَّ  سَعْدًا  هَلَكَ وَتَرَكَ ابْنَتَيْنِ وَأَخَاهُ ، فَعَمَدَ أَخُوهُ فَقَبَضَ مَا         [4/35]      تَرَكَ  سَعْدٌ  ، وَإِنَّمَا تُنْكَحُ النِّسَاءُ عَلَى أَمْوَالِهِنَّ ، فَلَمْ يُجِبْهَا فِي مَجْلِسِهِ ذَلِكَ ، ثُمَّ جَاءَتْ فَقَالَتْ : يَا رَسُولَ اللهِ ، ابْنَتَا  سَعْدٍ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ادْعُ لِيَ أَخَاهُ ، فَجَاءَهُ ، فَقَالَ :  ادْفَعْ إِلَى ابْنَتَيْهِ الثُّلُثَيْنِ ، وَإِلَى امْرَأَتِهِ الثُّمُنَ ، وَلَكَ مَا بَقِيَ  .         [4/36]","","Musnad Abi Ya'la al-Mawsili 2039","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن وغيره عن عبد الله بن وهب المصري عن الوليد بن شجاع عن أبو يعلى الموصلي","مسند جابر"
"2041","274 - (  2040  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ الْكِنْدِيُّ ،  حَدَّثَنَا  مِسْوَرُ بْنُ الصَّلْتِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ :  كُلُّ مَعْرُوفٍ صَدَقَةٌ  ، وَمَا أَنْفَقَ الرَّجُلُ عَلَى أَهْلِهِ وَمَالِهِ كُتِبَ لَهُ صَدَقَةٌ ، وَمَا وَقَى بِهِ عِرْضَهُ فَهُوَ لَهُ صَدَقَةٌ قَالَ : وَكُلُّ نَفَقَةِ مُؤْمِنٍ فِي غَيْرِ مَعْصِيَةٍ فَعَلَى اللهِ خَلَفُهُ ضَامِنًا إِلَّا نَفَقَتَهُ فِي بُنْيَانٍ  ، قَالَ  مِسْوَرٌ  : قَالَ مُحَمَّدُ بْنُ الْمُنْكَدِرِ : فَقُلْنَا لِجَابِرِ بْنِ عَبْدِ اللهِ :  مَا أَرَادَ بِقَوْلِهِ : وَمَا وَقَى بِهِ الْمَرْءُ عِرْضَهُ ؟  قَالَ : يُعْطِي الشَّاعِرَ ، وَذَا اللِّسَانِ ، قَالَ  جَابِرٌ  : كَأَنَّهُ يَقُولُ : الَّذِي يُتَّقَى لِسَانُهُ  .         [4/37]","","Musnad Abi Ya'la al-Mawsili 2040","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن مسور بن الصلت الكوفي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند جابر"
"2042","275 - (  2041  ) -  حَدَّثَنَا  أَبُو عَلِيٍّ الشَّيْلَمَانِيُّ ،  حَدَّثَنَا  خَالِدُ بْنُ إِسْمَاعِيلَ الْمَخْزُومِيُّ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  صَالِحٍ مَوْلَى التَّوْأَمَةِ ،  عَنْ  جَابِرٍ قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَيُّمَا شَابٍّ تَزَوَّجَ فِي حَدَاثَةِ سِنِّهِ  عَجَّ  شَيْطَانُهُ : يَا  وَيْلَهُ  يَا  وَيْلَهُ  ،  عَصَمَ  مِنِّي دِينَهُ  .","","Musnad Abi Ya'la al-Mawsili 2041","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن صالح بن نبهان الجمحي عن عبيد الله بن عمر العمري عن خالد بن إسماعيل بن الوليد المخزومي عن الحسين بن الحسن بن بشار الشيلماني عن أبو يعلى الموصلي","مسند جابر"
"2043","276 - (  2042  ) -  حَدَّثَنَا  الشَّيْلَمَانِيُّ ، بِهَذَا  الْإِسْنَادِ  ،  عَنْ  صَالِحٍ ،         [4/38]      عَنْ  أَبِي هُرَيْرَةَ قَالَ :  لَوْ لَمْ يَبْقَ مِنْ أَجَلِي إِلَّا يَوْمٌ وَاحِدٌ لَقِيتُ اللهَ بِزَوْجَةٍ ، إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  شِرَارُكُمْ عُزَّابُكُمْ  .","","Musnad Abi Ya'la al-Mawsili 2042","","أبو هريرة الدوسي عن صالح بن نبهان الجمحي عن عبيد الله بن عمر العمري عن خالد بن إسماعيل بن الوليد المخزومي عن الحسين بن الحسن بن بشار الشيلماني عن أبو يعلى الموصلي","مسند جابر"
"2044","277 - (  2043  ) -  حَدَّثَنَا  أَبُو يُوسُفَ الْجِيزِيُّ ،  حَدَّثَنَا  مُؤَمَّلٌ ،  حَدَّثَنَا  عَبْدُ اللهِ الْعُمَرِيُّ ،  حَدَّثَنَا  رَبِيعَةُ بْنُ عَطَاءٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كَيْفَ أَنْتُمْ إِذَا غُدِيَ عَلَيْكُمْ بِجَفْنَةٍ  ، وَرِيحَ عَلَيْكُمْ بِأُخْرَى ؟ قَالُوا : يَا رَسُولَ اللهِ ، إِنَّا يَوْمَئِذٍ لَبِخَيْرٍ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : بَلْ أَنْتُمُ الْيَوْمَ خَيْرٌ  .","","Musnad Abi Ya'la al-Mawsili 2043","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن ربيعة بن عطاء السباعي عن عبد الله بن عمر العمري عن مؤمل بن إسماعيل العدوي عن يعقوب بن إسحاق الجيزي عن أبو يعلى الموصلي","مسند جابر"
"2045","278 - (  2044  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ مُجَالِدٍ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،         [4/39]      عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ،  أَنَّ  أَعْرَابِيًّا  أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : انْسُبِ اللهَ ، فَأَنْزَلَ اللهُ :         {      قُلْ هُوَ اللهُ أَحَدٌ         }      إِلَى آخِرِهَا  .","","Musnad Abi Ya'la al-Mawsili 2044","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن مجالد بن سعيد عن إسماعيل بن مجالد بن سعيد الهمداني عن سريج بن يونس المروزي عن أبو يعلى الموصلي","مسند جابر"
"2046","279 - (  2045  ) -  حَدَّثَنَا  خَلَّادُ بْنُ أَسْلَمَ ،  حَدَّثَنَا  عَبْدُ الْمَجِيدِ بْنُ أَبِي رَوَّادٍ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ أَحَبَّ الطَّعَامِ إِلَى اللهِ مَا كَثُرَتْ عَلَيْهِ الْأَيْدِي  .         [4/40]","","Musnad Abi Ya'la al-Mawsili 2045","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن عبد المجيد بن عبد العزيز بن أبي رواد عن خلاد بن أسلم الصفار عن أبو يعلى الموصلي","مسند جابر"
"2047","280 - (  2046  ) -  حَدَّثَنَا  أَبُو الْحَارِثِ سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ مُجَالِدٍ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَابِرٍ قَالَ :  جَاءَ  أَعْرَابِيٌّ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : ثِيَابُنَا فِي الْجَنَّةِ نَنْسِجُهَا بِأَيْدِينَا ؟ فَضَحِكَ أَصْحَابُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ الْأَعْرَابِيُّ : لِمَ تَضْحَكُونَ مِنْ جَافٍ يَسْأَلُ عَالِمًا ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  صَدَقْتَ يَا أَعْرَابِيُّ ، وَلَكِنَّهَا  ثَمَرَاتٌ  .         [4/41]","","Musnad Abi Ya'la al-Mawsili 2046","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن مجالد بن سعيد عن إسماعيل بن مجالد بن سعيد الهمداني عن سريج بن يونس المروزي عن أبو يعلى الموصلي","مسند جابر"
"2048","281 - (  2047  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  إِسْمَاعِيلُ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  سُئِلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ  أَبِي طَالِبٍ  ، هَلْ تَنْفَعُهُ نُبُوَّتُكَ ؟ قَالَ : نَعَمْ ، أَخْرَجْتُهُ مِنْ غَمْرَةِ  جَهَنَّمَ  إِلَى  ضَحْضَاحٍ  مِنْهَا  ، وَسُئِلَ عَنْ  خَدِيجَةَ  لِأَنَّهَا مَاتَتْ قَبْلَ الْفَرَائِضِ وَأَحْكَامِ الْقُرْآنِ ، فَقَالَ : أَبْصَرْتُهَا عَلَى نَهَرٍ مِنْ أَنْهَارِ الْجَنَّةِ ، فِي بَيْتٍ مِنْ  قَصَبٍ  لَا  صَخَبَ  فِيهِ وَلَا  نَصَبَ  ، وَسُئِلَ عَنْ  وَرَقَةَ بْنِ نَوْفَلٍ  قَالَ : أَبْصَرْتُهُ فِي  بُطْنَانِ  الْجَنَّةِ عَلَيْهِ  سُنْدُسٌ  ، وَسُئِلَ عَنْ  زَيْدِ بْنِ عَمْرِو بْنِ نُفَيْلٍ  ، فَقَالَ : يُبْعَثُ يَوْمَ الْقِيَامَةِ  أُمَّةً  وَحْدَهُ بَيْنِي وَبَيْنَ  عِيسَى  عَلَيْهِمَا السَّلَامُ  .         [4/42]","","Musnad Abi Ya'la al-Mawsili 2047","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن مجالد بن سعيد عن إسماعيل بن مجالد بن سعيد الهمداني عن سريج بن يونس المروزي عن أبو يعلى الموصلي","مسند جابر"
"2049","282 - (  2048  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ عِيسَى بْنِ مَاسَرْجِسْ مَوْلَى ابْنِ الْمُبَارَكِ ،  أَخْبَرَنَا  ابْنُ الْمُبَارَكِ ،  أَخْبَرَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  جَابِرٍ قَالَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي الظُّهْرَ إِذَا زَالَتِ الشَّمْسُ  .","","Musnad Abi Ya'la al-Mawsili 2048","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن سفيان الثوري عن عبد الله بن المبارك عن الحسن بن عيسى الماسرجسي عن أبو يعلى الموصلي","مسند جابر"
"2050","283 - (  2049  ) -  حَدَّثَنَا  عَبْدُ الْغَفَّارِ بْنُ عَبْدِ اللهِ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  كُنَّا عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذْ أَقْبَلَ  سَعْدُ بْنُ أَبِي وَقَّاصٍ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  هَذَا خَالِي  .         [4/43]","","Musnad Abi Ya'la al-Mawsili 2049","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن مجالد بن سعيد عن علي بن مسهر القرشي عن عبد الغفار بن عبد الله بن الزبير الزبيري عن أبو يعلى الموصلي","مسند جابر"
"2051","284 - (  2050  ) -  حَدَّثَنَا  خَلَّادُ بْنُ أَسْلَمَ ،  أَخْبَرَنَا  النَّضْرُ ،  أَخْبَرَنَا  أَبُو الْعَوَّامِ عَبْدُ الْعَزِيزِ بْنُ رَبِيعٍ الْبَاهِلِيُّ ، وَكَانَ مَنْزِلُهُ فِي دَارِ  زِيَادٍ  قَالَ :  سَمِعْتُ  أَبَا الزُّبَيْرِ وَاسْمُهُ : مُحَمَّدٌ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  كُنَّا مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي مَسِيرٍ ، فَأَتَى عَلَى قَبْرَيْنِ يُعَذَّبُ صَاحِبَاهُمَا ، فَقَالَ : أَمَا إِنَّهُمَا لَا يُعَذَّبَانِ فِي  كَبِيرٍ  ، أَمَّا أَحَدُهُمَا كَانَ يَغْتَابُ النَّاسَ ، وَأَمَّا الْآخَرُ فَكَانَ لَا يَتَأَذَّى مِنْ بَوْلِهِ ، فَدَعَا  بِجَرِيدَةٍ  رَطْبَةٍ أَوْ  جَرِيدَتَيْنِ  فَكَسَرَهُمَا ، ثُمَّ أَمَرَ بِكُلِّ كِسْرَةٍ فَغُرِسَتْ عَلَى قَبْرٍ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَمَا إِنَّهُ سَيُهَوَّنُ مِنْ عَذَابِهِمَا  مَا كَانَتَا رَطْبَتَيْنِ ، أَوْ مَا لَمْ تَيْبَسَا  .         [4/44]","","Musnad Abi Ya'la al-Mawsili 2050","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد العزيز بن الربيع الباهلي عن النضر بن شميل عن خلاد بن أسلم الصفار عن أبو يعلى الموصلي","مسند جابر"
"2052","285 - (  2051  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  طَلْحَةُ بْنُ زَيْدٍ ،  عَنْ  عُبَيْدَةَ بْنِ حَسَّانَ ،  عَنْ  عَطَاءٍ الْكَيْخَارَانِيِّ ،  عَنْ  جَابِرٍ قَالَ :  بَيْنَا نَحْنُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي بَيْتٍ فِي نَفَرٍ مِنَ  الْمُهَاجِرِينَ  فِيهِمْ  أَبُو بَكْرٍ  ،  وَعُمَرُ  ،  وَعُثْمَانُ  ،  وَعَلِيٌّ  ،  وَطَلْحَةُ  ،  وَالزُّبَيْرُ  ،  وَعَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  ،  وَسَعْدُ بْنُ أَبِي وَقَّاصٍ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لِيَنْهَضْ كُلُّ رَجُلٍ إِلَى كُفْئِهِ  ، وَنَهَضَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى  عُثْمَانَ  فَاعْتَنَقَهُ ، قَالَ : أَنْتَ وَلِيِّي فِي الدُّنْيَا ، وَأَنْتَ وَلِيِّي فِي الْآخِرَةِ  .         [4/45]","","Musnad Abi Ya'la al-Mawsili 2051","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن نافع الكيخاراني عن عبيدة بن حسان السنجاري عن طلحة بن زيد الرقي عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند جابر"
"2053","286 - (  2052  ) -  أَخْبَرَنَا  أَبُو يَعْلَى أَحْمَدُ بْنُ عَلِيِّ بْنِ الْمُثَنَّى الْمَوْصِلِيُّ ،  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ أَهْلَ الْجَنَّةِ يَأْكُلُونَ فِيهَا وَيَشْرَبُونَ ، وَلَا يَتْفُلُونَ  ، وَلَا يَبُولُونَ ، وَلَا يَمْتَخِطُونَ ، وَلَا يَتَغَوَّطُونَ ، قَالَ : فَمَا بَالُ الطَّعَامِ ؟ قَالَ : جُشَاءٌ وَرَشْحٌ كَرَشْحِ الْمِسْكِ ، يُلْهَمُونَ التَّسْبِيحَ وَالتَّحْمِيدَ كَمَا تُلْهَمُونَ النَّفَسَ  .","","Musnad Abi Ya'la al-Mawsili 2052","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2054","287 - (  2053  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ قَبْلَ مَوْتِهِ بِثَلَاثٍ :  أَلَا لَا يَمُوتَنَّ أَحَدٌ مِنْكُمْ إِلَّا وَهُوَ يُحْسِنُ الظَّنَّ بِاللهِ  .","","Musnad Abi Ya'la al-Mawsili 2053","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2055","288 - (  2054  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ ،  حَدَّثَنَا  ابْنُ وَهْبٍ قَالَ :         [4/46]      أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ،  أَنَّهُ قَالَ : يَا رَسُولَ اللهِ ، نَعْمَلُ لِأَمْرٍ قَدْ فُرِغَ مِنْهُ أَوْ لِأَمْرٍ نَأْتَنِفُهُ ؟ قَالَ : لِأَمْرٍ قَدْ فُرِغَ مِنْهُ ، فَقَالَ  سُرَاقَةُ بْنُ مَالِكٍ  : فَفِيمَ الْعَمَلُ إِذًا ؟ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كُلٌّ  مُيَسَّرٌ  لِعَمَلِهِ  .","","Musnad Abi Ya'la al-Mawsili 2054","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن الوليد بن شجاع عن أبو يعلى الموصلي","مسند جابر"
"2056","289 - (  2055  ) -  حَدَّثَنَا  الْجَرَّاحُ بْنُ مَخْلَدٍ ،  حَدَّثَنَا  يَحْيَى بْنُ كَثِيرِ بْنِ دِرْهَمٍ الْعَنْبَرِيُّ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ رَبِيعٍ الْبَاهِلِيُّ ،  عَنْ  عَطَاءِ بْنِ رَبَاحٍ  ،  عَنْ  جَابِرٍ قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي سَفَرٍ ، فَأَتَى عَلَى قَبْرَيْنِ يُعَذَّبَانِ فَقَالَ :  أَمَا إِنَّهُمَا يُعَذَّبَانِ فِي غَيْرِ  كَبِيرٍ  : الْغِيبَةُ ، وَالْبَوْلُ ، ثُمَّ دَعَا  بِجَرِيدَةٍ  فَكَسَرَهَا ، فَوَضَعَ عَلَى كُلِّ وَاحِدٍ مِنْهُمَا         [4/47]      قِطْعَةً ، وَقَالَ : أَرْجُو أَنْ يُخَفَّفَ عَنْهُمَا مَا لَمْ يَيْبَسَا  .  كذا في طبعة دار المأمون للتراث ، ولعل الصواب: (عطاء بن أبي رباح) .","","Musnad Abi Ya'la al-Mawsili 2055","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن عبد العزيز بن الربيع الباهلي عن يحيى بن كثير العنبري عن الجراح بن مخلد عن أبو يعلى الموصلي","مسند جابر"
"2057","290 - (  2056  ) -  حَدَّثَنَا  الْجَرَّاحُ ،  حَدَّثَنَا  أَحْمَدُ بْنُ سُلَيْمَانَ الْخُرَاسَانِيُّ ،  حَدَّثَنَا  أَحْمَدُ  بْنُ مُحْرِزٍ الْأَزْدِيُّ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَأَنْ يَمْتَلِئَ جَوْفُ أَحَدِكُمْ  قَيْحًا  أَوْ دَمًا  ، خَيْرٌ لَهُ مِنْ أَنْ يَمْتَلِئَ شِعْرًا هُجِيتُ بِهِ  .  كذا في طبعة دار المأمون للتراث ، ولعل الصواب : ( النضر بن محرز ) ، وقد ذكر الأئمة أحاديث أحمد بن محرز في ترجمة النضر بن محرز ، وقد قال الحافظ ابن حجر في ترجمة أحمد بن محرز من اللسان (782) في النضر بن محرز يأتي.","","Musnad Abi Ya'la al-Mawsili 2056","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن النضر بن محرز عن أحمد بن أبي الطيب عن الجراح بن مخلد عن أبو يعلى الموصلي","مسند جابر"
"2058","291 - (  2057  ) -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  سُلَيْمَانَ بْنِ قَيْسٍ ،         [4/48]      عَنْ  جَابِرٍ قَالَ :  بَعَثَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى  أَبِي طَيْبَةَ  فَحَجَمَهُ  ، فَسَأَلَهُ : كَمْ  ضَرِيبَتُكَ  ؟ قَالَ : ثَلَاثَةُ آصُعٍ فَوَضَعَ عَنْهُ صَاعًا  .","","Musnad Abi Ya'la al-Mawsili 2057","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سليمان بن قيس اليشكري عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن عبد الواحد بن غياث عن أبو يعلى الموصلي","مسند جابر"
"2059","292 - (  2058  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنِيعٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ يَزِيدَ الْوَاسِطِيُّ ،  عَنْ  مَحْمُودِ بْنِ إِسْحَاقَ  ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  عَلَيْكُمْ بِالْإِثْمِدِ عِنْدَ النَّوْمِ  ، فَإِنَّهُ يَجْلُو الْبَصَرَ وَيُنْبِتُ الشَّعَرَ  .  كذا في طبعة دار المأمون للتراث ، والصواب : ( محمد بن إسحاق )","","Musnad Abi Ya'la al-Mawsili 2058","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن محمد بن إسحاق عن محمد بن يزيد الكلاعي عن أحمد بن منيع البغوي عن أبو يعلى الموصلي","مسند جابر"
"2060","293 - (  2059  ) -  حَدَّثَنَا  الْفَضْلُ بْنُ الصَّبَّاحِ ،  حَدَّثَنَا  سَعِيدُ بْنُ زَكَرِيَّا ،  عَنْ  عَنْبَسَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  السَّلَامُ قَبْلَ الْكَلَامِ  .         [4/49]","","Musnad Abi Ya'la al-Mawsili 2059","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن عنبسة بن عبد الرحمن بن عنبسة الأموي عن سعيد بن زكريا القرشي عن الفضل بن الصباح النهاوندي عن أبو يعلى الموصلي","مسند جابر"
"2061","294 - (  2059  ) -  مُكَرَّرٌ - وَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  وَلَا تَدْعُوا أَحَدًا إِلَى الطَّعَامِ  ، حَتَّى يُسَلِّمَ .","","Musnad Abi Ya'la al-Mawsili 2059","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن عنبسة بن عبد الرحمن بن عنبسة الأموي عن سعيد بن زكريا القرشي عن الفضل بن الصباح النهاوندي عن أبو يعلى الموصلي","مسند جابر"
"2062","295 - (  2060  ) -  حَدَّثَنَا  عَمْرٌو النَّاقِدُ ،  حَدَّثَنَا  عَلِيُّ بْنُ ثَابِتٍ الْجَزَرِيُّ ،  حَدَّثَنَا  الْوَازِعُ بْنُ نَافِعٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  جَابِرٍ قَالَ :  كُنَّا نُصَلِّي مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي  غَزْوَةِ بَدْرٍ  إِذْ تَبَسَّمَ فِي صَلَاتِهِ  ، فَلَمَّا قَضَى الصَّلَاةَ ، قُلْنَا : يَا رَسُولَ اللهِ ، رَأَيْنَاكَ تَبَسَّمْتَ ؟ قَالَ : مَرَّ بِي  مِيكَائِيلُ  ، وَعَلَى جَنَاحِهِ أَثَرُ غُبَارٍ وَهُوَ رَاجِعٌ مِنْ طَلَبِ  الْقَوْمِ  ، فَضَحِكَ إِلَيَّ فَتَبَسَّمْتُ إِلَيْهِ  .         [4/50]","","Musnad Abi Ya'la al-Mawsili 2060","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو سلمة بن عبد الرحمن عن الوازع بن نافع العقيلي عن علي بن ثابت الجزري عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند جابر"
"2063","296 - (  2061  ) -  حَدَّثَنَا  عَمْرٌو ،  حَدَّثَنَا  عَمْرُو بْنُ عُثْمَانَ الْكِلَابِيُّ ،  حَدَّثَنَا  هَارُونُ بْنُ حَيَّانَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُنْكَدِرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ قُتِلَ دُونَ مَالِهِ ، فَهُوَ  شَهِيدٌ  .","","Musnad Abi Ya'la al-Mawsili 2061","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن هارون بن حيان العقيلي عن عمرو بن عثمان بن سيار الرقي عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند جابر"
"2064","297 - (  2062  ) -  حَدَّثَنَا  حَجَّاجُ بْنُ يُوسُفَ الَّذِي يُعْرَفُ : بِابْنِ الشَّاعِرِ ،  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  حَدَّثَنَا  يُونُسُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  جَابِرٍ قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَجْتَنِي  الْكَبَاثَ  ، فَقَالَ : عَلَيْكُمْ بِالْأَسْوَدِ مِنْهُ فَإِنَّهُ أَطْيَبُهُ فَقُلْنَا : وَكُنْتَ تَرْعَى الْغَنَمَ ؟ قَالَ : نَعَمْ ، وَهَلْ مِنْ نَبِيٍّ إِلَّا وَقَدْ رَعَاهَا . ؟         [4/51]","","Musnad Abi Ya'la al-Mawsili 2062","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو سلمة بن عبد الرحمن عن الزهري عن يونس بن يزيدالأيلي عن عثمان بن عمر بن فارس عن حجاج يوسف الثقفي عن أبو يعلى الموصلي","مسند جابر"
"2065","298 - (  2063  ) -  حَدَّثَنَا  صَالِحُ بْنُ مَالِكٍ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ عَبْدِ اللهِ بْنِ أَبِي سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أُرِيتُ أَنِّي أُدْخِلْتُ الْجَنَّةَ ، فَإِذَا أَنَا  بِالرُّمَيْصَاءِ امْرَأَةِ أَبِي طَلْحَةَ  ، قَالَ : وَسَمِعْتُ خَشْفًا أَمَامِي ، فَقُلْتُ : مَنْ هَذَا يَا  جِبْرِيلُ  ؟ قَالَ : هَذَا  بِلَالٌ  قَالَ : وَرَأَيْتُ قَصْرًا أَبْيَضَ بِفِنَائِهِ جَارِيَةٌ ، فَقُلْتُ : لِمَنْ هَذَا الْقَصْرُ ؟ فَقَالَتْ :  لِعُمَرَ بْنِ الْخَطَّابِ  ، فَأَرَدْتُ أَنْ أَدْخُلَهُ فَأَنْظُرَ إِلَيْهِ ، فَذَكَرْتُ غَيْرَتَكَ  يَا عُمَرُ  ، فَقَالَ  عُمَرُ  : بِأَبِي أَنْتَ وَأُمِّي يَا رَسُولَ اللهِ ، أَوَعَلَيْكَ أَغَارُ ؟  .         [4/52]","","Musnad Abi Ya'la al-Mawsili 2063","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن عبد العزيز بن عبد الله الماجشون عن صالح بن مالك الخوارزمي عن أبو يعلى الموصلي","مسند جابر"
"2066","299 - (  2064  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  عَمْرٍو ،  عَنْ  جَابِرٍ قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ  الْمُخَابَرَةِ  .","","Musnad Abi Ya'la al-Mawsili 2064","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"2067","300 - (  2065  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سَعِيدِ بْنِ أَبِي كَرِبٍ ،  عَنْ  جَابِرٍ ، سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  وَيْلٌ لِلْعَرَاقِيبِ مِنَ النَّارِ  .         [4/53]","","Musnad Abi Ya'la al-Mawsili 2065","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سعيد بن أبي كرب عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"2068","301 - (  2066  ) -  حَدَّثَنَا  قَاسِمُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو دَاوُدَ الطَّيَالِسِيُّ ،  عَنْ  أَبِي الْعَوَّامِ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَرَّ بِقَبْرَيْنِ ، فَقَالَ : إِنَّهُمَا لَيُعَذَّبَانِ ، وَمَا يُعَذَّبَانِ فِي  كَبِيرٍ  ، أَمَّا أَحَدُهُمَا فَإِنَّهُ كَانَ لَا يَتَأَذَّى مِنْ بَوْلِهِ ، وَأَمَّا الْآخَرُ فَإِنَّهُ كَانَ يَغْتَابُ النَّاسَ  .","","Musnad Abi Ya'la al-Mawsili 2066","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد العزيز بن الربيع الباهلي عن أبو داود الطيالسي عن قاسم بن محمد بن أبي شيبة العبسي عن أبو يعلى الموصلي","مسند جابر"
"2069","302 - (  2067  ) -  حَدَّثَنَا  قَاسِمُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  بُرَيْدٍ ،  عَنْ  أَبِي بُرْدَةَ ،         [4/54]      عَنْ  أَبِي مُوسَى ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْمُؤْمِنُ يَأْكُلُ فِي  مِعًى  وَاحِدٍ  ، وَالْكَافِرُ يَأْكُلُ فِي سَبْعَةِ أَمْعَاءٍ  .","","Musnad Abi Ya'la al-Mawsili 2067","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن قاسم بن محمد بن أبي شيبة العبسي عن أبو يعلى الموصلي","مسند جابر"
"2070","303 - (  2068  ) -  حَدَّثَنَا  قَاسِمٌ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  مُجَالِدٍ ،  عَنْ  أَبِي الْوَدَّاكِ ،  عَنْ  أَبِي سَعِيدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Musnad Abi Ya'la al-Mawsili 2068","","أبو سعيد الخدري عن جبر بن نوف البكالي عن مجالد بن سعيد عن عباد بن عباد بن حبيب عن قاسم بن محمد بن أبي شيبة العبسي عن أبو يعلى الموصلي","مسند جابر"
"2071","304 - (  2069  ) -  حَدَّثَنَا  قَاسِمٌ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ         [4/55]      مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Musnad Abi Ya'la al-Mawsili 2069","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن حماد بن أسامة القرشي عن قاسم بن محمد بن أبي شيبة العبسي عن أبو يعلى الموصلي","مسند جابر"
"2072","305 - (  2070  ) -  حَدَّثَنَا  قَاسِمُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .         [4/56]","","Musnad Abi Ya'la al-Mawsili 2070","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن أبو عاصم النبيل عن قاسم بن محمد بن أبي شيبة العبسي عن أبو يعلى الموصلي","مسند جابر"
"2073","306 - (  2071  ) -  حَدَّثَنَا  عَمْرُو بْنُ الضَّحَّاكِ ،  حَدَّثَنَا  أَبِي ،  حَدَّثَنَا  عِمْرَانُ الْقَطَّانُ ،  حَدَّثَنَا  مَطَرٌ ،  عَنْ  طَلْحَةَ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنِ  ادَّعَى  لِغَيْرِ أَبِيهِ ، أَوِ  انْتَمَى  إِلَى غَيْرِ مَوَالِيهِ رَغْبَةً عَنْهُمْ ، فَعَلَيْهِ لَعْنَةُ اللهِ  ، وَمَنْ سَبَّ  وَالِدَيْهِ أَوْ وَالِدَهُ  فَكَذَلِكَ ، وَمَنْ أَهَلَّ لِغَيْرِ اللهِ فَكَذَلِكَ ، وَمَنِ اسْتَحَلَّ شَيْئًا مِنْ حُدُودِ  مَكَّةَ  فَكَذَلِكَ ، وَمَنْ قَالَ عَلَيَّ مَا لَمْ أَقُلْ فَكَذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 2071","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن مطر بن طهمان الوراق عن عمران بن داور القطان عن أبو عاصم النبيل عن عمرو بن الضحاك بن مخلد عن أبو يعلى الموصلي","مسند جابر"
"2074","307 - (  2072  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ حُمَيْدٍ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ عَبْدِ اللهِ ،  عَنْ  عِيسَى بْنِ جَارِيَةَ ،  عَنْ  جَابِرٍ قَالَ :  أَمَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِقَتْلِ كِلَابِ  الْمَدِينَةِ  ، فَجَاءَهُ  ابْنُ أُمِّ مَكْتُومٍ  فَقَالَ : يَا رَسُولَ اللهِ ، أَنَا مَكْفُوفُ الْبَصَرِ ، وَمَنْزِلِي شَاسِعٌ ، وَلِي كَلْبٌ ، فَرَخَّصَ لَهُ أَيَّامًا ، ثُمَّ أَمَرَ بِقَتْلِ كَلْبِهِ ، فَقُتِلَ  .         [4/57]","","Musnad Abi Ya'la al-Mawsili 2072","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عيسى بن جارية الأنصاري عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن جعفر بن حميد زنبقة عن أبو يعلى الموصلي","مسند جابر"
"2075","308 - (  2073  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ حُمَيْدٍ ،  حَدَّثَنَا  يَعْقُوبُ ،  عَنْ  عِيسَى بْنِ جَارِيَةَ ،  عَنْ  جَابِرٍ قَالَ :  جَاءَ  ابْنُ أُمِّ مَكْتُومٍ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي مَكْفُوفُ الْبَصَرِ وَمَنْزِلِي شَاسِعٌ ، وَأَنَا أَسْمَعُ الْأَذَانَ قَالَ :  فَإِنْ سَمِعْتَ الْأَذَانَ فَأَجِبْ ، وَلَوْ  حَبْوًا  وَلَوْ زَحْفًا  .","","Musnad Abi Ya'la al-Mawsili 2073","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عيسى بن جارية الأنصاري عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن جعفر بن حميد زنبقة عن أبو يعلى الموصلي","مسند جابر"
"2076","309 - (  2074  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ حُمَيْدٍ ،  حَدَّثَنَا  يَعْقُوبُ ،  عَنْ  عِيسَى بْنِ جَارِيَةَ ،  عَنْ  جَابِرٍ قَالَ :  كَانَ  رَجُلٌ  يَحْمِلُ الْخَمْرَ مِنْ  خَيْبَرَ  إِلَى  الْمَدِينَةِ  فَيَبِيعُهَا مِنَ الْمُسْلِمِينَ ، فَحَمَلَ مِنْهَا بِمَالٍ ، فَقَدِمَ بِهِ  الْمَدِينَةَ  ، فَلَقِيَهُ  رَجُلٌ  مِنَ الْمُسْلِمِينَ ، فَقَالَ : يَا فُلَانُ ، إِنَّ الْخَمْرَ قَدْ حُرِّمَتْ فَوَضَعَهَا حَيْثُ انْتَهَى عَلَى تَلٍّ ، وَسَجَّى عَلَيْهِ بِأَكْسِيَةٍ ، ثُمَّ أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  يَا رَسُولَ اللهِ ، بَلَغَنِي أَنَّ الْخَمْرَ قَدْ حُرِّمَتْ ؟ قَالَ : أَجَلْ  ، قَالَ : إِنِّي أَرُدُّهَا عَلَى مَنِ ابْتَعْتُهَا مِنْهُ ؟ قَالَ : لَا يَصْلُحُ رَدُّهَا ، قَالَ : لِيَ أَنْ أُهْدِيَهَا ؟ ... وَذَكَرَ الْحَدِيثَ  .","","Musnad Abi Ya'la al-Mawsili 2074","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عيسى بن جارية الأنصاري عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن جعفر بن حميد زنبقة عن أبو يعلى الموصلي","مسند جابر"
"2077","310 - (  2075  ) -  حَدَّثَنَا  جَعْفَرٌ ،  حَدَّثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  عُتْبَةَ بْنِ أَبِي حَكِيمٍ ،  عَنْ  حُصَيْنِ بْنِ حَرْمَلَةَ ،  عَنْ  أَبِي الْمُصَبِّحِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا اغْبَرَّتْ قَدَمَا         [4/58]      عَبْدٍ فِي  سَبِيلِ  اللهِ سَاعَةً مِنْ نَهَارٍ  ، فَهُمَا حَرَامٌ عَلَى النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 2075","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو مصبح الردماني عن حصين بن حرملة المهري عن عتبة بن أبي حكيم عن عبد الله بن المبارك عن جعفر بن حميد زنبقة عن أبو يعلى الموصلي","مسند جابر"
"2078","311 - (  2076  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ قُدَامَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  حَدَّثَنَا  سَعِيدُ بْنُ حَسَّانَ ،  عَنْ  عُرْوَةَ بْنِ عِيَاضٍ ،  عَنْ  جَابِرٍ قَالَ :  أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  رَجُلٌ  ، فَقَالَ : إِنَّ عِنْدِي أَمَةً ، وَإِنِّي  أَعْزِلُ  عَنْهَا  ، فَقَالَ : أَمَا إِنَّ ذَلِكَ لَيْسَ يَمْنَعُ أَمْرًا أَرَادَهُ اللهُ ،         [4/59]      فَلَمْ يَلْبَثْ أَنْ جَاءَ فَقَالَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِنَّهَا قَدْ حَمَلَتْ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَنَا عَبْدُ اللهِ وَرَسُولُهُ  .","","Musnad Abi Ya'la al-Mawsili 2076","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عروة بن عياض النوفلي عن سعيد بن حسان المخزومي عن سفيان بن عيينة عن محمد بن قدامة الجوهري عن أبو يعلى الموصلي","مسند جابر"
"2079","312 - (  2077  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ بْنِ حِسَابٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنِ  الْأَسْوَدِ بْنِ قَيْسٍ ،  عَنْ  نُبَيْحٍ الْعَنَزِيِّ ،  عَنْ  جَابِرٍ ،  أَنَّ  امْرَأَةً  ، قَالَتْ : يَا رَسُولَ اللهِ ، صَلِّ عَلَيَّ وَعَلَى زَوْجِي ، فَقَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  صَلَّى اللهُ عَلَيْكِ وَعَلَى زَوْجِكِ  .","","Musnad Abi Ya'la al-Mawsili 2077","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن نبيح بن عبد الله العنزي عن الأسود بن قيس العبدي عن الوضاح بن عبد الله اليشكري عن محمد بن عبيد بن حساب الغبري عن أبو يعلى الموصلي","مسند جابر"
"2080","313 - (  2078  ) -  حَدَّثَنَا  حَفْصٌ الْحُلْوَانِيُّ ،  حَدَّثَنَا  بُهْلُولُ بْنُ مُوَرِّقٍ الشَّامِيُّ ،  عَنْ  مُوسَى بْنِ عُبَيْدَةَ ،  عَنْ  أَخِيهِ  ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَزَالُ أُمَّتِي         [4/60]      ظَاهِرِينَ عَلَى الْحَقِّ  ، حَتَّى يَنْزِلَ  عِيسَى ابْنُ مَرْيَمَ  ، فَيَقُولُ إِمَامُهُمْ : تَقَدَّمْ ، فَيَقُولُ : أَنْتُمْ أَحَقُّ بَعْضُكُمْ أُمَرَاءُ بَعْضٍ ، أَمْرٌ أَكْرَمَ اللهُ بِهِ هَذِهِ الْأُمَّةَ  .","","Musnad Abi Ya'la al-Mawsili 2078","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن عبيدة بن نشيط الحميري عن موسى بن عبيدة بن نشيط الحميري عن بهلول بن مورق الشامى عن حفص بن عبد الله الحلواني عن أبو يعلى الموصلي","مسند جابر"
"2081","314 - (  2079  ) -  حَدَّثَنَا  ابْنُ أَبِي سَمِينَةَ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ حَبِيبِ بْنِ الشَّهِيدِ قَالَ :  قَالَ  أَبِي  ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  أَمَرَ أَبِي بِخَزِيرَةٍ ، فَصُنِعَتْ ، ثُمَّ أَمَرَنِي فَأَتَيْتُ بِهَا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : فَأَتَيْتُهُ وَهُوَ فِي مَنْزِلِهِ قَالَ : فَقَالَ لِي :  مَاذَا مَعَكَ يَا  جَابِرُ  ، أَلَحْمٌ ذِي ؟  قَالَ : قُلْتُ : لَا ، قَالَ : فَأَتَيْتُ أَبِي ، فَقَالَ لِي : هَلْ رَأَيْتَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قُلْتُ : نَعَمْ قَالَ : فَهَلَّا سَمِعْتَهُ يَقُولُ شَيْئًا ؟ قَالَ : قُلْتُ : نَعَمْ ، قَالَ لِي : مَاذَا مَعَكَ يَا  جَابِرُ  ، أَلَحْمٌ ذِي ؟ قَالَ : لَعَلَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَكُونَ         [4/61]      اشْتَهَى ، فَأَمَرَ بِشَاةٍ لَنَا  دَاجِنٍ  ، فَذُبِحَتْ ، ثُمَّ أَمَرَ بِهَا فَشُوِيَتْ ، ثُمَّ أَمَرَنِي فَأَتَيْتُ بِهَا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ لِي : مَاذَا مَعَكَ يَا  جَابِرُ  ؟ فَأَخْبَرْتُهُ ، فَقَالَ : جَزَى اللهُ  الْأَنْصَارَ  عَنَّا خَيْرًا ، وَلَا سِيَّمَا  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ حَرَامٍ  ،  وَسَعْدَ بْنَ عُبَادَةَ  .","","Musnad Abi Ya'la al-Mawsili 2079","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن حبيب بن الشهيد عن إبراهيم بن حبيب بن الشهيد عن محمد بن يحيى بن أبي سمينة التمار عن أبو يعلى الموصلي","مسند جابر"
"2082","315 - (  2080  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ الدَّوْرَقِيِّ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ حَبِيبِ بْنِ الشَّهِيدِ قَالَ :  قَالَ  أَبِي  ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،         [4/62]      عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ : أَمَرَ أَبِي بِحَرِيرَةٍ فَصُنِعَتْ ، ثُمَّ أَمَرَنِي فَأَتَيْتُ بِهَا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَذَكَرَ نَحْوَهُ .","","Musnad Abi Ya'la al-Mawsili 2080","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن حبيب بن الشهيد عن إبراهيم بن حبيب بن الشهيد عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند جابر"
"2083","316 - (  2081  ) -  حَدَّثَنَا  هَارُونُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ،  يُبَلِّغُ بِهِ  قَالَ :  أَفْضَلُ  الْجِهَادِ  : مَنْ عُقِرَ جَوَادُهُ ، وَأُهْرِيقَ دَمُهُ  .         [4/63]","","Musnad Abi Ya'la al-Mawsili 2081","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان بن عيينة عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند جابر"
"2084","317 - (  2082  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ الْكِنْدِيُّ ،  حَدَّثَنَا  فُلَيْحُ بْنُ سُلَيْمَانَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ قَالَ :  نَدَبَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ الْخَنْدَقِ  النَّاسَ ، مَنْ يَأْتِيِهِ بِخَبَرِ  بَنِي قُرَيْظَةَ  ،  فَانْتَدَبَ  الزُّبَيْرُ  ، ثُمَّ نَدَبَهُمْ  فَانْتَدَبَ  الزُّبَيْرُ  ثَلَاثًا ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ لِكُلِّ نَبِيٍّ حَوَارِيًّا  ،  وَحَوَارِيَّ  الزُّبَيْرُ  .         [4/64]","","Musnad Abi Ya'la al-Mawsili 2082","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن فليح بن سليمان عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند جابر"
"2085","318 - (  2083  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  الْحَجَّاجُ الصَّوَّافُ ،  عَنْ  أَبِي الزُّبَيْرِ قَالَ :  حَدَّثَنِي  جَابِرُ بْنُ عَبْدِ اللهِ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَخَلَ عَلَى  أُمِّ السَّائِبِ  ، أَوْ  أُمِّ الْمُسَيِّبِ  وَهِيَ  تُزَفْزِفُ  ، فَقَالَ :  مَالَكِ  يَا  أُمَّ السَّائِبِ  ، أَوْ يَا  أُمَّ الْمُسَيِّبِ  تُزَفْزِفِينَ  ؟  قَالَتِ : الْحُمَّى ، لَا بَارَكَ اللهُ فِيهَا ، فَقَالَ : لَا تَسُبِّي الْحُمَّى ، فَإِنَّهَا تُذْهِبُ خَطَايَا ابْنِ آدَمَ كَمَا يُذْهِبُ  الْكِيرُ  خَبَثَ  الْحَدِيدِ  .         [4/65]","","Musnad Abi Ya'la al-Mawsili 2083","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حجاج بن أبى عثمان الصواف الكندي عن يزيد بن زريع العيشي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"2086","319 - (  2084  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  جَابِرٍ قَالَ :  بَيْنَا نَحْنُ عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذْ جَاءَهُ  رَجُلٌ  بِمِثْلِ الْبَيْضَةِ مِنْ ذَهَبٍ أَصَابَهَا بِبَعْضِ الْمَغَازِي ، قَالَ : فَقَامَ بِهَا عَنْ شِقِّهِ الْأَيْسَرِ ، فَقَالَ لَهُ : يَا رَسُولَ اللهِ ، خُذْ هَذِهِ مِنِّي صَدَقَةً ، فَوَاللهِ مَا أَصْبَحْتُ أَمْلِكُ مَالًا غَيْرَهَا ، فَأَعْرَضَ عَنْهُ ، ثُمَّ جَاءَهُ عَنْ شِقِّهِ الْأَيْمَنِ ، فَقَالَ لَهُ مِثْلَ ذَلِكَ ، فَأَعْرَضَ عَنْهُ ، ثُمَّ جَاءَهُ مِنْ بَيْنِ يَدَيْهِ ، فَقَالَ لَهُ مِثْلَ ذَلِكَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : هَاتِهَا ، مُغْضَبًا ، قَالَ : فَلَمَّا أَعْطَاهُ         [4/66]      إِيَّاهَا خَذَفَهُ بِهَا لَوْ أَصَابَهُ  أَوْجَعَهُ أَوْ عَقَرَهُ  ، ثُمَّ قَالَ : يَجِيءُ أَحَدُكُمْ  بِمَالِهِ أَوْ كَمَا قَالَ  لَا يَمْلِكُ غَيْرَهُ يَتَصَدَّقُ بِهِ ، ثُمَّ يَقْعُدُ بَعْدَ ذَلِكَ  يَتَكَفَّفُ  النَّاسَ ؟  إِنَّمَا الصَّدَقَةُ عَنْ  ظَهْرِ  غِنًى  ، خُذْ عَنَّا مَالَكَ لَا حَاجَةَ لَنَا بِهِ  .","","Musnad Abi Ya'la al-Mawsili 2084","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن محمد بن إسحاق عن يزيد بن زريع العيشي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"2087","320 - (  2085  ) -  حَدَّثَنَا  أَبُو مُوسَى الْهَرَوِيُّ ،  حَدَّثَنَا  الْمُعَافَى ،  عَنْ  إِبْرَاهِيمَ بْنِ يَزِيدَ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرٍ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كُلُّ مَعْرُوفٍ يَصْنَعُهُ أَحَدُكُمْ إِلَى غَنِيٍّ أَوْ فَقِيرٍ فَهُوَ صَدَقَةٌ لَهُ يَوْمَ الْقِيَامَةِ  .         [4/67]","","Musnad Abi Ya'la al-Mawsili 2085","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن إبراهيم بن يزيد الخوزي عن المعافى بن عمران عن إسحاق بن إبراهيم الهروي عن أبو يعلى الموصلي","مسند جابر"
"2088","321 - (  2086  ) -  حَدَّثَنَا  مَنْصُورُ بْنُ أَبِي مُزَاحِمٍ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الْمَوَالِ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُعَلِّمُنَا  الِاسْتِخَارَةَ  كَمَا يُعَلِّمُنَا  ... وَذَكَرَ الْحَدِيثَ  .         [4/68]","","Musnad Abi Ya'la al-Mawsili 2086","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن عبد الرحمن بن أبي الموال مولى علي بن أبي طالب عن منصور بن أبي مزاحم عن أبو يعلى الموصلي","مسند جابر"
"2089","322 - (  2087  ) -  حَدَّثَنَا  أَبُو إِبْرَاهِيمَ التَّرْجُمَانِيُّ ،  حَدَّثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  عُمَرَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ :  أَنَّ بَقَرَةً انْقَلَبَتْ عَلَى خَمْرٍ فَشَرِبَتْ ، فَخَافُوا عَلَيْهَا ، فَأَتَوُا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : كُلُوا ، وَلَا بَأْسَ بِأَكْلِهَا  .","","Musnad Abi Ya'la al-Mawsili 2087","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عمر بن موسى بن الوجيه الميثمي عن بقية بن الوليد عن إسماعيل بن إبراهيم الترجماني عن أبو يعلى الموصلي","مسند جابر"
"2090","323 - (  2088  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  أَبُو أَحْمَدَ ،  عَنْ  شَرِيكٍ ،  عَنِ  ابْنِ عَقِيلٍ ،  عَنْ  جَابِرٍ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ أَرَادَ أَنْ يَصُومَ ، فَلْيَتَسَحَّرْ وَلَوْ بِشَيْءٍ  .         [4/69]","","Musnad Abi Ya'la al-Mawsili 2088","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن شريك بن عبد الله النخعي عن محمد بن عبد الله بن الزبير عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند جابر"
"2091","324 - (  2089  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  الْفُرَاتُ بْنُ أَبِي الْفُرَاتِ الْقُرَشِيُّ قَالَ :  سَمِعْتُ  عَطَاءَ بْنَ أَبِي رَبَاحٍ  يُحَدِّثُ عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَنِمْتُ ثُمَّ اسْتَيْقَظْتُ ، ثُمَّ نِمْتُ ثُمَّ اسْتَيْقَظْتُ ، فَقَامَ  رَجُلٌ  مِنَ الْمُسْلِمِينَ فَقَالَ : الصَّلَاةَ الصَّلَاةَ ، قَالَ : فَخَرَجَ إِلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَرَأْسُهُ يَقْطُرُ ، فَصَلَّى بِنَا ، ثُمَّ قَالَ :  لَوْلَا أَنْ أَشُقَّ عَلَى أُمَّتِي لَأَحْبَبْتُ أَنْ يُصَلُّوا هَذِهِ الصَّلَاةَ هَذِهِ السَّاعَةَ  .  قَالَ  الْفُرَاتُ  :  أَظُنُّهَا الْعِشَاءَ  .","","Musnad Abi Ya'la al-Mawsili 2089","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن فرات بن أبي الفرات البصري عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند جابر"
"2092","325 - (  2090  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ جَبَلَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ مَرْوَانَ ،  عَنْ  هِشَامٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا مِنْ أَيَّامٍ أَفْضَلُ عِنْدَ اللهِ مِنْ أَيَّامِ عَشْرِ ذِي الْحِجَّةِ ، قَالَ : فَقَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، هِيَ أَفْضَلُ أَمْ عِدَّتُهُنَّ  جِهَادًا  فِي  سَبِيلِ  اللهِ ؟ فَقَالَ : هِيَ أَفْضَلُ مِنْ عِدَّتِهِنَّ  جِهَادًا  فِي  سَبِيلِ  اللهِ ، إِلَّا عَفِيرًا  يُعَفِّرُ  وَجْهَهُ فِي التُّرَابِ ، وَمَا مِنْ يَوْمٍ أَفْضَلُ عِنْدَ اللهِ مِنْ يَوْمِ عَرَفَةَ ،  يَنْزِلُ  اللهُ إِلَى السَّمَاءِ الدُّنْيَا  فَيُبَاهِي  بِأَهْلِ الْأَرْضِ أَهْلَ السَّمَاءِ ، فَيَقُولُ :  انْظُرُوا إِلَى         [4/70]      عِبَادِي شُعْثًا غُبْرًا ضَاحِينَ جَاؤُوا مِنْ كُلِّ  فَجٍّ  عَمِيقٍ ، لَمْ يَرَوْا رَحْمَتِي ، وَلَمْ يَرَوْا عَذَابِي ،  فَلَمْ أَرَ يَوْمًا أَكْثَرَ عَتِيقًا مِنَ النَّارِ مِنْ يَوْمِ عَرَفَةَ  .","","Musnad Abi Ya'la al-Mawsili 2090","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن هشام الدستوائي عن محمد بن مروان بن قدامة العجلي عن محمد بن عمرو بن عباد العتكي عن أبو يعلى الموصلي","مسند جابر"
"2093","326 - (  2091  ) -  حَدَّثَنَا  حَجَّاجُ بْنُ يُوسُفَ ،  حَدَّثَنَا  يَعْقُوبُ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  صَالِحٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  أَبِي سَلَمَةَ قَالَ :  سَمِعْتُ  جَابِرًا ، يُحَدِّثُ أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَمَّا كَذَّبَتْنِي  قُرَيْشٌ  حِينَ أُسْرِيَ بِي إِلَى  بَيْتِ الْمَقْدِسِ  ، قُمْتُ فِي الْحِجْرِ فَجَلَّى اللهُ لِي  بَيْتَ الْمَقْدِسِ  ، وَطَفِقْتُ أُخْبِرُهُمْ عَنْ آيَاتِهِ وَأَنَا أَنْظُرُ إِلَيْهِ  .         [4/71]","","Musnad Abi Ya'la al-Mawsili 2091","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو سلمة بن عبد الرحمن عن الزهري عن صالح بن كيسان الدوسي عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن حجاج يوسف الثقفي عن أبو يعلى الموصلي","مسند جابر"
"2094","327 - (  2092  ) -  حَدَّثَنَا  حَجَّاجٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  جَابِرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ  أُعْمِرَ  عُمْرَى  لَهُ وَلِعَقِبِهِ  ، فَهِيَ لَهُ بَتًّا لَا يَجُوزُ لِلْمُعْطِي فِيهَا شَرْطٌ وَلَا مَثْنَوِيَّةٌ  .         [4/72]","","Musnad Abi Ya'la al-Mawsili 2092","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو سلمة بن عبد الرحمن عن الزهري عن محمد بن عبد الرحمن بن المغيرة عن يزيد بن هارون عن حجاج يوسف الثقفي عن أبو يعلى الموصلي","مسند جابر"
"2095","328 - (  2093  ) -  حَدَّثَنَا  حَجَّاجٌ ،  حَدَّثَنَا  يَعْقُوبُ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  صَالِحٍ ،  عَنِ  ابْنِ شِهَابٍ أَنَّ أَبَا سَلَمَةَ بْنَ عَبْدِ الرَّحْمَنِ  أَخْبَرَهُ  ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَضَى : أَيُّمَا رَجُلٍ  أَعْمَرَ  رَجُلًا  عُمْرَى  لَهُ وَلِعَقِبِهِ  ، فَقَالَ : أُعْطِيكَهَا وَعَقِبَكَ مَا بَقِيَ مِنْكُمْ أَحَدٌ فَإِنَّهَا لِمَنْ أُعْطِيَهَا ، وَإِنَّهَا لَا تَرْجِعُ إِلَى صَاحِبِهَا مِنْ أَجْلِ أَنَّهُ أَعْطَى عَطَاءً وَقَعَتْ فِيهِ الْمَوَارِيثُ  .","","Musnad Abi Ya'la al-Mawsili 2093","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو سلمة بن عبد الرحمن عن الزهري عن صالح بن كيسان الدوسي عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن حجاج يوسف الثقفي عن أبو يعلى الموصلي","مسند جابر"
"2096","329 - (  2094  ) -  قَالَ :  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ سَهْمٍ الْأَنْطَاكِيُّ ،  حَدَّثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  مُبَشِّرُ بْنُ عُبَيْدٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تُنْكَحُ النِّسَاءُ إِلَّا مِنَ         [4/73]      الْأَكْفَاءِ  ، وَلَا يُزَوِّجُهُنَّ إِلَّا الْأَوْلِيَاءُ ، وَلَا مَهْرَ دُونَ عَشَرَةِ دَرَاهِمَ  .","","Musnad Abi Ya'la al-Mawsili 2094","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن مبشر بن عبيد الحمصي عن بقية بن الوليد عن محمد بن عبد الرحمن بن حكيم الأنطاكي عن أبو يعلى الموصلي","مسند جابر"
"2097","330 - (  2095  ) -  حَدَّثَنَا  أَبُو بَسِيطٍ  ،  حَدَّثَنَا  أَبُو الْيَمَانِ ،  حَدَّثَنَا  صَفْوَانُ ،  عَنْ  مَاعِزٍ التَّمِيمِيِّ ،  عَنْ  جَابِرٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ الشَّيْطَانَ قَدْ يَئِسَ أَنْ يَعْبُدَهُ الْمُصَلُّونَ  ، وَلَكِنْ فِي  التَّحْرِيشِ  بَيْنَهُمْ  .         [4/74]      كذا في طبعة دار المأمون للتراث وطبعة إرشاد الحق ، والذي في نسخة السليمانية غير منقوطة سوى الياء المثناة ، والصواب : (نشيط) ، والله أعلم .","","Musnad Abi Ya'la al-Mawsili 2095","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن ماعز التميمي عن صفوان بن عمرو السكسكي عن أبو اليمان الحكم بن نافع عن أبو نشيط الربعي عن أبو يعلى الموصلي","مسند جابر"
"2098","331 - (  2096  ) -  حَدَّثَنَا  مَنْصُورُ بْنُ أَبِي مُزَاحِمٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الْخَطَّابِ الْبَصْرِيُّ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ فِي حَدِيثٍ لَهُ :  إِذَا ذَلَّتِ الْعَرَبُ ذَلَّ الْإِسْلَامُ  .","","Musnad Abi Ya'la al-Mawsili 2096","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن علي بن زيد بن جدعان عن محمد بن الخطاب بن جبير الجبيري عن منصور بن أبي مزاحم عن أبو يعلى الموصلي","مسند جابر"
"2099","332 - (  2097  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  فُلَيْحُ بْنُ سُلَيْمَانَ ،  عَنْ  سَعِيدِ بْنِ الْحَارِثِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  دَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَرَجُلٌ مِنْ أَصْحَابِهِ  عَلَى  رَجُلٍ مِنَ الْأَنْصَارِ  ، وَهُوَ يُحَوِّلُ الْمَاءَ فِي حَائِطِهِ ،         [4/75]      فَقَالَ :  إِنْ كَانَ عِنْدَكَ مَاءٌ بَاتَ هَذِهِ اللَّيْلَةَ فِي  شَنٍّ  ، وَإِلَّا  كَرَعْنَا  ؟  قَالَ : بَلَى ، عِنْدِي يَا رَسُولَ اللهِ مَاءٌ بَاتَ فِي سِقَاءٍ ، قَالَ : فَانْطَلَقْنَا إِلَى الْعَرِيشِ ، فَانْطَلَقَ ، فَحَلَبَ شَاةً عَلَى مَاءٍ بَاتَ فِي  شَنٍّ  ، قَالَ : فَشَرِبَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ عُدْتُ بِمِثْلِ ذَلِكَ فَشَرِبَ صَاحِبُهُ  .","","Musnad Abi Ya'la al-Mawsili 2097","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سعيد بن الحارث بن أبي سعيد الأنصاري عن فليح بن سليمان عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند جابر"
"2100","333 - (  2098  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  حَدَّثَنَا  أَبُو مَعْشَرٍ قَالَ :  سَأَلْتُ  مُحَمَّدَ بْنَ الْمُنْكَدِرِ ، عَنِ الْوُضُوءِ مِمَّا مَسَّتِ النَّارُ ، فَقَالَ :  حَدَّثَنِي  جَابِرُ بْنُ عَبْدِ اللهِ قَالَ :  أَكَلْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَصَلَّى         [4/76]      وَلَمْ يَتَوَضَّأْ  بَعْدَ وُضُوئِهِ الْأَوَّلِ ، ثُمَّ أَكَلْتُ مَعَ  أَبِي بَكْرٍ  فَصَلَّى وَلَمْ يَتَوَضَّأْ ، ثُمَّ أَكَلْتُ مَعَ  عُمَرَ  فَصَلَّى وَلَمْ يَتَوَضَّأْ ، ثُمَّ أَكَلْتُ مَعَ  عُثْمَانَ  فَصَلَّى وَلَمْ يَتَوَضَّأْ  .","","Musnad Abi Ya'la al-Mawsili 2098","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن نجيح بن عبد الرحمن السندي عن محمد بن بكار الرصافي عن أبو يعلى الموصلي","مسند جابر"
"2101","334 - (  2099  ) -  حَدَّثَنَا  غَسَّانُ ،  عَنْ  حَمَّادٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَأَى حِمَارًا قَدْ وُسِمَ فِي وَجْهِهِ ، قَالَ :  أَلَمْ أَنْهَ عَنْ هَذَا ؟ لَعَنَ اللهُ مَنْ فَعَلَهُ ، وَنَهَى عَنْ ضَرْبِ الْوَجْهِ  .         [4/77]","","Musnad Abi Ya'la al-Mawsili 2099","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حماد بن سلمة عن غسان بن الربيع الأزدي عن أبو يعلى الموصلي","مسند جابر"
"2102","335 - (  2100  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سُلَيْمَانَ بْنِ عَبْدِ اللهِ بْنِ حَنْظَلَةَ بْنِ أَبِي عَامِرٍ الْغِسِّيلِ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  جَابِرٍ قَالَ :  جَاءَ يَعُودُ  الْمُقَنَّعَ بْنَ سِنَانٍ  ، وَكَانَ خَالَ  عَاصِمٍ  أَخَا أُمِّهِ ، فَسَلَّمَ عَلَيْهِ وَهُوَ فِي رِدَاءٍ وَإِزَارٍ ، وَقَدْ أُصِيبَ بَصَرُهُ فَقَالَ : مَاذَا تَشْتَكِي ، وَقَدْ مَسَّ رَأْسَهُ وَلِحْيَتَهُ بِشَيْءٍ مِنْ صُفْرَةٍ ، قَالَ : خُرَّاجٌ مَنَعَنِي النَّوْمَ وَأَسْهَرَنِي ، قَالَ  جَابِرٌ  : يَا غُلَامُ ادْعُ لَنَا حَجَّامًا ، قَالَ  الْمُقَنَّعُ  : وَمَا تَصْنَعُ بِالْحَجَّامِ يَا  أَبَا عَبْدِ اللهِ  ؟ قَالَ : أُرِيدُ أَنْ أُعَلِّقَ فِيهِ  مِحْجَمًا ،  قَالَ : غَفَرَ اللهُ لَكَ ، وَاللهِ إِنَّ الثَّوْبَ لَيُصِيبُنِي ، أَوِ         [4/78]      الذُّبَابُ  يَقَعُ عَلَيَّ يُؤْذِينِي ، فَلَمَّا رَأَى جَزَعَهُ مِنْ ذَلِكَ أَنْشَأَ يُحَدِّثُنَا عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنْ كَانَ فِي شَيْءٍ مِنْ أَدْوِيَتِكُمْ خَيْرٌ  ، أَوْ إِنْ يَكُنْ ، فَفِي شَرْطَةِ  مِحْجَمٍ  ، أَوْ شَرْبَةٍ مِنْ عَسَلٍ ، أَوْ  لَذْعَةٍ  بِنَارٍ تُوَافِقُ دَاءً ، وَمَا أُحِبُّ أَنْ  أَكْتَوِيَ  ، فَدَعَا الْحَجَّامَ فَأَعْلَقَ  الْمِحْجَمَ  فِي خُرَّاجِهِ ، فَلَمَّا بَلَغَ حَلُوءَ حَاجِبِهِ ، شَرَطَهُ بِمِشْرَطَةٍ مَعَهُ ، فَأَخْرَجَ اللهُ تَبَارَكَ وَتَعَالَى مَا كَانَ فِيهِ مِنْ ضُرِّهِ وَعُوفِيَ  .","","Musnad Abi Ya'la al-Mawsili 2100","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عاصم بن عمر الظفري عن عبد الرحمن بن سليمان الأوسي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند جابر"
"2103","336 - (  2101  ) -  حَدَّثَنَا  عَبْدُ الْغَفَّارِ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  كُنَّا عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذْ أَقْبَلَ  سَعْدُ بْنُ أَبِي وَقَّاصٍ  ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : هَذَا خَالِي  .         [4/79]","","Musnad Abi Ya'la al-Mawsili 2101","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن مجالد بن سعيد عن علي بن مسهر القرشي عن عبد الغفار بن عبد الله بن الزبير الزبيري عن أبو يعلى الموصلي","مسند جابر"
"2104","337 - (  2102  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْخَطَّابِ ،  حَدَّثَنَا  مُؤَمَّلُ بْنُ إِسْمَاعِيلَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  بَيْنَ الْعَبْدِ وَبَيْنَ الْكُفْرِ تَرْكُ الصَّلَاةِ  .","","Musnad Abi Ya'la al-Mawsili 2102","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن سفيان الثوري عن مؤمل بن إسماعيل العدوي عن محمد بن الخطاب البلدي عن أبو يعلى الموصلي","مسند جابر"
"2105","338 - (  2103  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْخَطَّابِ ،  حَدَّثَنَا  مُؤَمَّلٌ ،  حَدَّثَنَا  شُعْبَةُ ،  حَدَّثَنَا  سَعْدُ بْنُ إِبْرَاهِيمَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو قَالَ :  لَمَّا قَدِمَ  الْحَجَّاجُ  جَعَلَ يُوَخِّرُ الصَّلَاةَ ،  فَسَأَلْتُ جَابِرًا - أَوْ سُئِلَ  - فَقَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي الظُّهْرَ بِالْهَاجِرَةِ  ، وَيُصَلِّي الْعَصْرَ وَالشَّمْسُ  حَيَّةٌ ،  وَيُصَلِّي الْمَغْرِبَ إِذَا وَجَبَتِ الشَّمْسُ ، وَالْعِشَاءُ كَانَ إِذَا اجْتَمَعَ النَّاسُ عَجَّلَ ، وَإِذَا قَلَّ النَّاسُ أَخَّرَ ، وَيُصَلِّي الصُّبْحَ  بِغَلَسٍ  .","","Musnad Abi Ya'la al-Mawsili 2103","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن عمرو بن الحسن بن علي بن أبي طالب عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن شعبة بن الحجاج عن مؤمل بن إسماعيل العدوي عن محمد بن الخطاب البلدي عن أبو يعلى الموصلي","مسند جابر"
"2106","339 - (  2104  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْخَطَّابِ ،  حَدَّثَنَا  مُؤَمَّلٌ ،  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَقِيلٍ قَالَ :  سَمِعْتُ  جَابِرَ بْنَ عَبْدِ اللهِ يَقُولُ :  كُنْتُ أُصَلِّي مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْمَغْرِبَ ، ثُمَّ أَرْجِعُ إِلَى أَهْلِي فِي  بَنِي سَلِمَةَ  ، وَهُمْ عَلَى مِيلٍ  مِنَ  الْمَدِينَةِ  ، أَوْ قَالَ : مِنَ الْمَسْجِدِ  ، وَأَنَا أَرَى مَوَاقِعَ         [4/80]      النَّبْلِ ، ثُمَّ قَالَ : الظُّهْرُ كَاسْمِهَا ظُهْرًا ، وَالْعَصْرُ وَالشَّمْسُ بَيْضَاءُ نَقِيَّةٌ ، وَالْمَغْرِبُ كَاسْمِهَا ، وَالْعِشَاءُ كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُؤَخِّرُهَا أَحْيَانًا وَيُعَجِّلُهَا أَحْيَانًا .","","Musnad Abi Ya'la al-Mawsili 2104","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن سفيان الثوري عن مؤمل بن إسماعيل العدوي عن محمد بن الخطاب البلدي عن أبو يعلى الموصلي","مسند جابر"
"2107","340 - (  2105  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْخَطَّابِ ،  حَدَّثَنَا  مُؤَمَّلٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  دَخَلْتُ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يُصَلِّي فِي ثَوْبٍ وَاحِدٍ  مُتَوَشِّحًا بِهِ ،         [4/81]      فَقَالَ أَبُو الزُّبَيْرِ :  رَأَيْتُ  جَابِرًا  يُصَلِّي فِي ثَوْبٍ وَاحِدٍ مُتَوَشِّحًا بِهِ .","","Musnad Abi Ya'la al-Mawsili 2105","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان الثوري عن مؤمل بن إسماعيل العدوي عن محمد بن الخطاب البلدي عن أبو يعلى الموصلي","مسند جابر"
"2108","341 - (  2106  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْخَطَّابِ ،  حَدَّثَنَا  مُؤَمَّلٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،         [4/82]      عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ خَافَ أَنْ لَا يَسْتَيْقِظَ مِنْ آخِرِ اللَّيْلِ فَلْيُوتِرْ أَوَّلَ اللَّيْلِ  ، وَمَنْ طَمِعَ مِنْكُمْ أَنْ يَسْتَيْقِظَ مِنْ آخِرِ اللَّيْلِ فَلْيُوتِرْ مِنْ آخِرِ اللَّيْلِ ، فَإِنَّ الصَّلَاةَ مِنْ آخِرِ اللَّيْلِ  مَشْهُودَةٌ  وَذَلِكَ أَفْضَلُ  .","","Musnad Abi Ya'la al-Mawsili 2106","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن سفيان الثوري عن مؤمل بن إسماعيل العدوي عن محمد بن الخطاب البلدي عن أبو يعلى الموصلي","مسند جابر"
"2109","342 - (  2107  ) -  حَدَّثَنَا  عَمَّارٌ أَبُو يَاسِرٍ ،  حَدَّثَنَا  جَعْفَرٌ ،  أَخْبَرَنَا  الْجَعْدُ ،  حَدَّثَنَا  أَنَسُ بْنُ مَالِكٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  شَكَا النَّاسُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمًا الْعَطَشَ ، فَدَعَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِعُسٍّ  قَالَ : وَقَالَ :  عِنْدَ أَحَدٍ مِنْكُمْ مَاءٌ ؟  قَالَ : فَأُتِيَ بِمِيضَأَةٍ فَصَبَّ فِيهِ ، قَالَ : ثُمَّ وَضَعَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَدَهُ فِي  الْعُسِّ  ، قَالَ  جَابِرٌ  : فَكُنْتُ أَنْظُرُ إِلَى الْعُيُونِ تَنْبُعُ بَيْنَ أَصَابِعِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَالنَّاسُ يَسْتَقُونَ  .         [4/83]","","Musnad Abi Ya'la al-Mawsili 2107","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أنس بن مالك عن الجعد بن دينار اليشكري عن جعفر بن سليمان الضبعي عن عمار بن هارون المستملي عن أبو يعلى الموصلي","مسند جابر"
"2110","343 - (  2108  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  يَحْيَى بْنِ أَبِي أُنَيْسَةَ ، وَعُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ :  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَمَى الْجَمْرَةَ بِمِثْلِ حَصَى  الْخَذْفِ  .         [4/84]","","Musnad Abi Ya'la al-Mawsili 2108","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن يحيى بن أبي أنيسة الرهاوي عن عبد الرحيم بن سليمان الأشل عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند جابر"
"2111","344 - (  2109  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ قَالَ :  حَدَّثَنِي  الْمُغِيرَةُ بْنُ سِقْلَابٍ ،  أَخْبَرَنَا  مَعْقِلُ بْنُ عُبَيْدِ اللهِ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ ضَمِنَ لِي مَا بَيْنَ لَحْيَيْهِ  وَرِجْلَيْهِ ضَمِنْتُ لَهُ الْجَنَّةَ  .","","Musnad Abi Ya'la al-Mawsili 2109","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن معقل بن عبيد الله الجزري عن مغيرة بن سقلاب الحراني عن الوليد بن شجاع عن أبو يعلى الموصلي","مسند جابر"
"2112","345 - (  2110  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ قَالَ :  حَدَّثَنِي  ابْنُ وَهْبٍ قَالَ :  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  أَبِي الزُّبَيْرِ ،         [4/85]      عَنْ  جَابِرٍ ، أَنَّهُ قَالَ :  يَا رَسُولَ اللهِ ، أَنَعْمَلُ لِأَمْرٍ قَدْ فُرِغَ مِنْهُ أَمْ لِأَمْرٍ نَأْتَنِفُهُ ؟  قَالَ : لِأَمْرٍ قَدْ فُرِغَ مِنْهُ ، فَقَالَ  سُرَاقَةُ  : فَفِيمَ الْعَمَلُ إِذًا ؟ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : كُلٌّ  مُيَسَّرٌ  لِعَمَلِهِ  .","","Musnad Abi Ya'la al-Mawsili 2110","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن الوليد بن شجاع عن أبو يعلى الموصلي","مسند جابر"
"2113","346 - (  2111  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الْمَوْصِلِيُّ ،  حَدَّثَنَا  عَبْدُ الْوَهَّابِ الثَّقَفِيُّ ،  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرٍ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا خَطَبَ احْمَرَّتْ عَيْنَاهُ ، وَعَلَا صَوْتُهُ ، وَاشْتَدَّ غَضَبُهُ حَتَّى كَأَنَّهُ  مُنْذِرُ  جَيْشٍ يَقُولُ : صَبَّحَكُمْ وَمَسَّاكُمْ ، وَيَقُولُ :  بُعِثْتُ أَنَا وَالسَّاعَةُ كَهَاتَيْنِ  - يَقْرِنُ بَيْنَ السَّبَّابَةِ وَالْوُسْطَى - وَيَقُولُ : أَمَّا بَعْدُ فَإِنَّ خَيْرَ الْحَدِيثِ كِتَابُ اللهِ ، وَخَيْرَ  الْهَدْيِ  هَدْيُ  مُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَإِنَّ شَرَّ الْأُمُورِ  مُحْدَثَاتُهَا  ، وَكُلُّ بِدْعَةٍ ضَلَالَةٌ ، ثُمَّ يَقُولُ : أَنَا أَوْلَى بِكُلِّ مُؤْمِنٍ مِنْ نَفْسِهِ ، مَنْ تَرَكَ مَالًا فَلِأَهْلِهِ ، وَمَنْ تَرَكَ دَيْنًا وَضَيْعَةً إِلَيَّ وَعَلَيَّ  .         [4/86]","","Musnad Abi Ya'la al-Mawsili 2111","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن عبد الوهاب بن عبد المجيد الثقفي عن أحمد بن إبراهيم بن خالد عن أبو يعلى الموصلي","مسند جابر"
"2114","347 - (  2112  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الْمَوْصِلِيُّ ،  حَدَّثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  أَشْعَثَ ،  عَنِ  ابْنِ سِيرِينَ ،  عَنْ  أَبِي بَكْرَةَ :  سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ  يَوْمَ النَّحْرِ  عَلَى رَاحِلَتِهِ  بِمِنًى  .","","Musnad Abi Ya'la al-Mawsili 2112","","أبو بكرة الثقفي عن محمد بن سيرين عن أشعث الحمراني عن حفص بن غياث النخعي عن أحمد بن إبراهيم بن خالد عن أبو يعلى الموصلي","مسند جابر"
"2115","[4/87]      348 - (  2113  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  حَفْصٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ، وَأَبِي صَالِحٍ ، أَوْ أَحَدِهِمَا ،  عَنْ  جَابِرٍ قَالَ :  خَطَبَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ النَّحْرِ  بِمِنًى  ، بِنَحْوٍ مِنْ حَدِيثِ  أَبِي بَكْرَةَ  .","","Musnad Abi Ya'la al-Mawsili 2113","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن حفص بن غياث النخعي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند جابر"
"2116","349 - (  2114  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  أَبِي الزُّبَيْرِ ،         [4/88]      عَنْ  جَابِرٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سُئِلَ عَنْ كَسْبِ الْحَجَّامِ ، فَقَالَ :  أَحْسَبُهُ قَالَ : اعْلِفْهُ  نَاضِحَكُمْ  .","","Musnad Abi Ya'la al-Mawsili 2114","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان بن عيينة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند جابر"
"2117","350 - (  2115  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ  حَدَّثَنَا  سُفْيَانُ  عَنْ  أَبِي الزُّبَيْرِ :  عَنْ  جَابِرٍ قَالَ :  لَمْ نَكُنْ نُسَمِّي الْمُنَافِقِينَ كُفَّارًا  عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .","","Musnad Abi Ya'la al-Mawsili 2115","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان بن عيينة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند جابر"
"2118","351 - (  2116  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  حَبِيبٍ الْمُعَلِّمِ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرٍ ،  أَنَّ  رَجُلًا  قَالَ  يَوْمَ الْفَتْحِ  : يَا رَسُولَ اللهِ ، إِنِّي نَذَرْتُ إِنْ فَتَحَ اللهُ عَلَيْكَ أَنْ أُصَلِّيَ فِي  بَيْتِ الْمَقْدِسِ  ، فَقَالَ         [4/89]      رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  صَلِّ هَاهُنَا ، فَأَعَادَهَا الرَّجُلُ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  مَرَّتَيْنِ أَوْ ثَلَاثًا  ، كُلَّ ذَلِكَ يَقُولُ : صَلِّ هَاهُنَا ، فَلَمَّا أَكْثَرَ عَلَيْهِ قَالَ : فَشَأْنَكَ إِذًا  .","","Musnad Abi Ya'la al-Mawsili 2116","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن حبيب المعلم مولى معقل بن يسار عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند جابر"
"2119","352 - (  2117  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  عَمْرِو بْنِ سُلَيْمٍ الزُّرَقِيِّ ،  عَنْ  جَابِرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا دَخَلَ أَحَدُكُمْ إِلَى الْمَسْجِدِ فَلْيُصَلِّ رَكْعَتَيْنِ  قَبْلَ أَنْ يَجْلِسَ  .","","Musnad Abi Ya'la al-Mawsili 2117","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن سليم بن خلدة الزرقي عن عامر بن عبد الله بن الزبير بن العوام عن سهيل بن أبي صالح السمان عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند جابر"
"2120","353 - (  2118  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ :  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمَّا بَلَغَهُ مَوْتُ  النَّجَاشِيِّ  قَامَ بِأَصْحَابِهِ  فَصَفُّوا خَلْفَهُ صَفَّيْنِ ، فَصَلَّى عَلَيْهِ  .         [4/90]","","Musnad Abi Ya'la al-Mawsili 2118","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن أيوب السختياني عن حماد بن زيد عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند جابر"
"2121","354 - (  2119  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  وُهَيْبٌ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ إِذَا خَطَبَ احْمَرَّتْ عَيْنَاهُ ، وَاشْتَدَّ غَضَبُهُ ، وَعَلَا صَوْتُهُ حَتَّى كَأَنَّهُ  مُنْذِرُ  جَيْشٍ ، ثُمَّ قَالَ :  صَبَّحَتْكُمُ السَّاعَةُ وَمَسَّتْكُمْ ، بُعِثْتُ أَنَا وَالسَّاعَةُ كَهَاتَيْنِ  : السَّبَّابَةِ وَالْوُسْطَى ، أَمَّا بَعْدُ فَإِنَّ خَيْرَ  الْهَدْيِ  هَدْيُ  مُحَمَّدٍ  ، وَشَرَّ الْأُمُورِ  مُحْدَثَاتُهَا  ، وَكُلَّ بِدْعَةٍ ضَلَالَةٌ  .","","Musnad Abi Ya'la al-Mawsili 2119","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن وهيب بن خالد الكرابيسي عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند جابر"
"2122","355 - (  2120  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  وُهَيْبٌ ،  عَنِ  ابْنِ أَبِي ذِئْبٍ ،  عَنْ  عُثْمَانَ بْنِ عَبْدِ اللهِ بْنِ سُرَاقَةَ ،  عَنْ  جَابِرٍ :  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يُصَلِّي عَلَى رَاحِلَتِهِ  حَيْثُ وُجِّهَتْ فِي  غَزْوَةِ أَنْمَارٍ  .         [4/91]","","Musnad Abi Ya'la al-Mawsili 2120","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عثمان بن عبد الله بن سراقة القرشي عن محمد بن عبد الرحمن بن المغيرة عن وهيب بن خالد الكرابيسي عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند جابر"
"2123","356 - (  2121  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  سَمِعَ  جَابِرَ بْنَ عَبْدِ اللهِ يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْحَرْبُ  خَدْعَةٌ  .","","Musnad Abi Ya'la al-Mawsili 2121","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"2124","357 - (  2122  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  حُمَيْدٍ ،  عَنْ  أَبِي الْمُتَوَكِّلِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ :  أَنَّهُمْ كَانُوا لَا يَضَعُونَ أَيْدِيَهُمْ فِي الطَّعَامِ حَتَّى يَكُونَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَبْدَأُ  .         [4/92]","","Musnad Abi Ya'la al-Mawsili 2122","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن علي بن داود الناجي عن حميد الطويل عن حماد بن سلمة عن عفان بن مسلم الصفار عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2125","358 - (  2123  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  هُشَيْمٌ ،  أَخْبَرَنَا  سَيَّارٌ ، وَمُغِيرَةُ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَابِرٍ قَالَ :  بِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعِيرًا ، عَلَى أَنَّ لِي ظَهْرَهُ حَتَّى أَرْجِعَ إِلَى  الْمَدِينَةِ  .","","Musnad Abi Ya'la al-Mawsili 2123","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن إسحاق عن أبو يعلى الموصلي","مسند جابر"
"2126","359 - (  2124  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  زَكَرِيَّا ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَابِرٍ :  أَنَّهُ بَاعَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعِيرًا ، وَاشْتَرَطَ ظَهْرَهُ إِلَى أَهْلِهِ  .","","Musnad Abi Ya'la al-Mawsili 2124","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن زكريا بن أبي زائدة الوادعي عن وكيع بن الجراح عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2127","360 - (  2125  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  هُشَيْمٌ ،  أَخْبَرَنَا  سَيَّارٌ ،  عَنْ  أَبِي هُبَيْرَةَ ،  عَنْ  جَابِرٍ قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي سَفَرٍ وَاشْتَرَى مِنِّي بَعِيرًا  ، وَجَعَلَ لِي ظَهْرَهُ حَتَّى أَقْدَمَ  الْمَدِينَةَ  ، فَلَمَّا قَدِمْنَا أَتَيْتُهُ بِالْبَعِيرِ فَدَفَعْتُهُ إِلَيْهِ وَأَمَرَ لِي بِالثَّمَنِ ، ثُمَّ انْصَرَفْتُ ، وَإِذَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَدْ لَحِقَنِي ، قَالَ : قُلْتُ : لَعَلَّهُ بَدَا لَهُ فِيهِ ، قَالَ : فَلَمَّا أَتَيْتُهُ دَفَعَ إِلَيَّ الْبَعِيرَ قَالَ : هُوَ لَكَ ، قَالَ : فَمَرَرْتُ  بِرَجُلٍ مِنَ الْيَهُودِ  فَأَخْبَرْتُهُ ، قَالَ : فَجَعَلَ يَعْجَبُ ، قَالَ : وَاشْتَرَى مِنْكَ الْبَعِيرَ فَدَفَعَ إِلَيْكَ الثَّمَنَ ، ثُمَّ وَهَبَهُ لَكَ ؟ قَالَ : قُلْتُ : نَعَمْ .         [4/93]","","Musnad Abi Ya'la al-Mawsili 2125","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن يحيى بن عباد بن شيبان الأنصاري عن سيار بن أبي سيار العنزي عن هشيم بن بشير عن إسحاق بن إبراهيم الهروي عن أبو يعلى الموصلي","مسند جابر"
"2128","361 - (  2126  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  قَالَ :  أَتَيْنَا جَابِرَ بْنَ عَبْدِ اللهِ وَهُوَ  بِبَنِي سَلِمَةَ  ، فَسَأَلْنَاهُ عَنْ حَجَّةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فَحَدَّثَنَا  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَقَامَ  بِالْمَدِينَةِ  تِسْعَ سِنِينَ لَمْ يَحُجَّ ، ثُمَّ أُذِّنَ فِي النَّاسِ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَاجٌّ فِي هَذَا الْعَامِ ، فَنَزَلَ  الْمَدِينَةَ  بَشَرٌ كَثِيرٌ كُلُّهُمْ يَلْتَمِسُ أَنْ يَأْتَمَّ بِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَيَفْعَلَ مَا يَفْعَلُ ، فَخَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِخَمْسٍ بَقِينَ مِنْ ذِي الْقِعْدَةِ ، وَخَرَجْنَا حَتَّى أَتَيْنَا  ذَا الْحُلَيْفَةِ  نَفِسَتْ  أَسْمَاءُ  بِمُحَمَّدِ بْنِ أَبِي بَكْرٍ  ، فَأَرْسَلَتْ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَيْفَ أَصْنَعُ ؟ فَقَالَ :  اغْتَسِلِي وَاسْتَثْفِرِي بِثَوْبٍ ، ثُمَّ أَهِلِّي  ، فَخَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى إِذَا اسْتَوَتْ بِهِ نَاقَتُهُ عَلَى الْبَيْدَاءِ أَهَلَّ بِالتَّوْحِيدِ :  لَبَّيْكَ  اللَّهُمَّ  لَبَّيْكَ ،  لَبَّيْكَ  لَا شَرِيكَ لَكَ  لَبَّيْكَ ،  إِنَّ الْحَمْدَ وَالنِّعْمَةَ لَكَ وَالْمُلْكَ ، لَا شَرِيكَ لَكَ ، وَلَبَّى النَّاسُ ، وَالنَّاسُ يَزِيدُونَ ذَا الْمَعَارِجِ وَنَحْوَهُ مِنَ الْكَلَامِ ، وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَسْمَعُ فَلَا يَقُولُ لَهُمْ شَيْئًا ، فَنَظَرْتُ مَدَّ بَصَرِي بَيْنَ يَدَيْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ رَاكِبٍ وَمَاشٍ ، وَمِنْ خَلْفِهِ مِثْلُ ذَلِكَ ، وَعَنْ يَمِينِهِ مِثْلُ ذَلِكَ ، وَعَنْ يَسَارِهِ مِثْلُ ذَلِكَ ، قَالَ  جَابِرٌ  : وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَيْنَ أَظْهُرِنَا يَنْزِلُ الْقُرْآنُ وَهُوَ يَعْرِفُ تَأْوِيلَهُ ، وَمَا عَمِلَ بِهِ مِنْ شَيْءٍ عَمِلْنَاهُ ، قَالَ : فَخَرَجْنَا لَا نَنْوِي إِلَّا  الْحَجَّ  ، حَتَّى         [4/94]      إِذَا أَتَيْنَا  الْكَعْبَةَ  اسْتَلَمَ  نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْحَجَرَ الْأَسْوَدَ ، ثُمَّ  رَمَلَ  ثَلَاثَةً ، وَمَشَى أَرْبَعَةً ، حَتَّى إِذَا فَرَغَ عَمَدَ إِلَى  مَقَامِ إِبْرَاهِيمَ  ، فَصَلَّى خَلْفَهُ رَكْعَتَيْنِ ، وَقَرَأَ :         {      وَاتَّخِذُوا مِنْ مَقَامِ إِبْرَاهِيمَ مُصَلًّى         }      قَالَ : أَيْ فَقَرَأَ فِيهِمَا بِالتَّوْحِيدِ وَ         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      ، ثُمَّ  اسْتَلَمَ  الْحَجَرَ ، ثُمَّ خَرَجَ إِلَى  الصَّفَا  ، ثُمَّ قَالَ : نَبْدَأُ بِمَا بَدَأَ اللهُ بِهِ وَقَرَأَ :         {      إِنَّ الصَّفَا وَالْمَرْوَةَ مِنْ شَعَائِرِ اللهِ         }      ، فَرَقَى عَلَى  الصَّفَا  ، حَتَّى إِذَا نَظَرَ إِلَى  الْبَيْتِ  كَبَّرَ ، ثُمَّ قَالَ : لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ ، وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ ، أَنْجَزَ وَعْدَهُ ، وَصَدَقَ عَبْدَهُ ،  وَهَزَمَ أَوْ غَلَبَ  الْأَحْزَابَ  وَحْدَهُ ، ثُمَّ دَعَا وَرَجَعَ إِلَى هَذَا الْكَلَامِ ، ثُمَّ نَزَلَ حَتَّى إِذَا  انْصَبَّتْ  قَدَمَاهُ فِي الْوَادِي  رَمَلَ  ، حَتَّى إِذَا صَعِدَ مَشَى ، حَتَّى إِذَا أَتَى  الْمَرْوَةَ  فَرَقَى عَلَيْهَا ، حَتَّى إِذَا نَظَرَ إِلَى  الْبَيْتِ  قَالَ عَلَيْهَا كَمَا قَالَ عَلَى  الصَّفَا  ، وَلَمَّا كَانَ السَّابِعُ  بِالْمَرْوَةِ  قَالَ : يَا أَيُّهَا النَّاسُ ، إِنِّي لَوِ  اسْتَقْبَلْتُ  مِنْ أَمْرِي مَا اسْتَدْبَرْتُ لَمْ أَسُقِ الْهَدْيَ وَجَعَلْتُهَا عُمْرَةً ، فَمَنْ لَمْ يَكُنْ مَعَهُ هَدْيٌ فَلْيَحْلِلْ ، وَلْيَجْعَلْهَا عُمْرَةً ، فَحَلَّ النَّاسُ كُلُّهُمْ ، فَقَالَ  سُرَاقَةُ بْنُ جُعْشُمٍ  : يَا رَسُولَ اللهِ ، أَلِعَامِنَا هَذَا أَمْ  لِلْأَبَدِ  ؟ قَالَ :  فَشَبَّكَ  النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَيْنَ أَصَابِعِهِ قَالَ : بَلْ  لِلْأَبَدِ  ، ثَلَاثَ مَرَّاتٍ ،  دَخَلَتِ         [4/95]      الْعُمْرَةُ فِي  الْحَجِّ  إِلَى يَوْمِ الْقِيَامَةِ .  وَقَدِمَ عَلِيٌّ مِنَ  الْيَمَنِ  ، فَقَدِمَ مَعَهُ بِهَدْيٍ ، وَسَاقَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَعَهُ هَدْيًا مِنَ  الْمَدِينَةِ  ، فَإِذَا  فَاطِمَةُ  قَدْ حَلَّتْ وَلَبِسَتْ ثِيَابًا  صَبِيغًا  ، وَاكْتَحَلَتْ ، وَقَالَتْ : أَمَرَنِي أَبِي ، فَأَنْكَرَ ذَلِكَ عَلِيٌّ عَلَيْهَا .  قَالَ : قَالَ  جَعْفَرٌ  : هَذَا الْحَرْفُ لَمْ يَذْكُرْهُ  جَابِرُ بْنُ عَبْدِ اللهِ  قَالَ عَلِيٌّ  بِالْكُوفَةِ  : فَانْطَلَقْتُ  مُحَرِّشًا  أَسْتَثْبِتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الَّذِي ذَكَرَتْ  فَاطِمَةُ  ، فَقُلْتُ : يَا رَسُولَ اللهِ ، إِنَّ  فَاطِمَةَ  قَدْ حَلَّتْ وَلَبِسَتْ ثِيَابًا  صَبِيغًا  ، وَاكْتَحَلَتْ ، وَقَالَتْ : أَمَرَنِي بِهِ أَبِي ، قَالَ : صَدَقَتْ صَدَقَتْ صَدَقَتْ ، أَنَا أَمَرْتُهَا بِهِ .  ثُمَّ رَجَعَ إِلَى حَدِيثِ  جَابِرٍ  ، فَقَالَ  لِعَلِيٍّ  : بِمَ أَهْلَلْتَ ؟ قَالَ : قُلْتُ : اللَّهُمَّ إِنِّي أُهِلُّ بِمَا أَهَلَّ بِهِ رَسُولُكَ ، وَمَعِيَ الْهَدْيُ ، قَالَ : فَلَا تَحِلَّ ، قَالَ : وَكَانَ جَمَاعَةُ الْهَدْيِ الَّذِي أَتَى بِهِ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَالَّذِي أَتَى بِهِ  عَلِيٌّ  مِائَةً ، فَنَحَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِيَدِهِ ثَلَاثَةً وَسِتِّينَ ، وَأَعْطَى  عَلِيًّا  ، فَنَحَرَ مَا غَبَرَ ، وَأَشْرَكَهُ فِي هَدْيِهِ ، وَأَمَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ كُلِّ بَدَنَةٍ بِبَضْعَةٍ ، فَجُعِلَتْ فِي قِدْرٍ ، فَأَكَلَا مِنْ لَحْمِهَا وَشَرِبَا مِنْ مَرَقِهَا .  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : قَدْ نَحَرْتُ هَاهُنَا ،  وَمِنًى  كُلُّهَا مَنْحَرٌ ، وَوَقَفَ ثُمَّ قَالَ : قَدْ وَقَفْتُ هَاهُنَا ،  وَعَرَفَةُ  كُلُّهَا مَوْقِفٌ ، وَوَقَفَ  بِالْمُزْدَلِفَةِ  فَقَالَ : قَدْ وَقَفْتُ هَاهُنَا ،  وَالْمُزْدَلِفَةُ  كُلُّهَا مَوْقِفٌ .         [4/96]","","Musnad Abi Ya'la al-Mawsili 2126","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2129","362 - (  2127  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  يَحْيَى بْنُ سُلَيْمٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أُمَيَّةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عُمَيْرٍ ، أَنَّ عَبْدَ الرَّحْمَنِ بْنَ أَبِي عَمَّارٍ ،  أَخْبَرَهُ  قَالَ :  سَأَلْتُ  جَابِرَ بْنَ عَبْدِ اللهِ : أَيُؤْكَلُ الضَّبُعُ ؟  قَالَ : نَعَمْ ، قُلْتُ : أَصَيْدٌ هِيَ ؟ قَالَ : نَعَمْ ، قُلْتُ : سَمِعْتَ ذَلِكَ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ : نَعَمْ  .         [4/97]","","Musnad Abi Ya'la al-Mawsili 2127","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الرحمن بن عبد الله بن أبي عمار الجشمي عن عبد الله بن عبيد بن عمير الجندعي عن إسماعيل بن أمية الأموي عن يحيى بن سليم الطائفي عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2130","363 - (  2128  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبْدُ الْوَارِثِ بْنُ سَعِيدٍ ،  حَدَّثَنَا  الْقَاسِمُ بْنُ عَبْدِ الْوَاحِدِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  جَابِرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ أَخْوَفَ مَا أَخَافُ عَلَى أُمَّتِي مِنْ بَعْدِي لَعَمَلُ  قَوْمِ لُوطٍ  .         [4/98]","","Musnad Abi Ya'la al-Mawsili 2128","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن القاسم بن عبد الواحد بن أيمن المخزومي عن عبد الوارث بن سعيد بن ذكوان عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"2131","364 - (  2129  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَرَجَ إِلَى  مَكَّةَ  عَامَ الْفَتْحِ  فِي رَمَضَانَ ، فَصَامَ حَتَّى بَلَغَ  كُرَاعَ  الْغَمِيمِ  ، فَصَامَ رَمَضَانَ ، وَصَامَ النَّاسُ مَعَهُ ، فَقِيلَ لَهُ :  إِنَّ النَّاسَ قَدْ شَقَّ عَلَيْهِمُ الصِّيَامُ ، وَإِنَّمَا يَنْظُرُونَ إِلَى مَا فَعَلْتَ ، فَدَعَا بِقَدَحٍ مِنْ مَاءٍ بَعْدَ الْعَصْرِ ، فَشَرِبَ  ، وَالنَّاسُ يَنْظُرُونَ ، فَصَامَ بَعْضُ النَّاسِ ، وَأَفْطَرَ بَعْضٌ ، فَبَلَغَهُ أَنَّ نَاسًا صَامُوا ، فَقَالَ : أُولَئِكَ الْعُصَاةُ  .","","Musnad Abi Ya'la al-Mawsili 2129","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن عبد العزيز بن محمد الدراوردي عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2132","365 - (  2130  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  كَثِيرِ بْنِ شِنْطِيرٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  خَمِّرُوا  الْآنِيَةَ ، وَأَوْكُوا الْأَسْقِيَةَ  ،  وَأَجِيفُوا  الْأَبْوَابَ ، وَكُفُّوا صِبْيَانَكُمْ عِنْدَ الْمَسَاءِ ، فَإِنَّ لِلْجِنِّ انْتِشَارًا وَخَطْفَةً ، وَأَطْفِئُوا الْمِصْبَاحَ عِنْدَ الرُّقَادِ ، فَإِنَّ الْفُوَيْسِقَةَ رُبَّمَا اجْتَرَّتِ الْفَتِيلَةَ فَأَحْرَقَتْ أَهْلَ الْبَيْتِ  .","","Musnad Abi Ya'la al-Mawsili 2130","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن كثير بن شنظير المازني عن حماد بن زيد عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"2133","366 - (  2131  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي سُفْيَانَ ،         [4/99]      عَنْ  جَابِرٍ قَالَ :  سُئِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَيُّ الصَّلَاةِ أَفْضَلُ ؟ قَالَ : طُولُ  الْقُنُوتِ  .","","Musnad Abi Ya'la al-Mawsili 2131","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن أبو معاوية الضرير عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2134","367 - (  2132  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  حُمَيْدٍ الْأَعْرَجِ ،  عَنْ  سُلَيْمَانَ ،  عَنْ  جَابِرٍ :  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَفَعَ  الْجَوَائِحَ  .         [4/100]","","Musnad Abi Ya'la al-Mawsili 2132","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سليمان بن عتيق المحاربي عن حميد بن قيس الأعرج عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"2135","368 - (  2133  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  مُجَالِدٌ ،  عَنْ  عَامِرٍ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَيْسَ مِنَّا مَنْ  سَلَقَ  ، وَلَا  حَلَقَ  ، وَلَا خَرَقَ  .         [4/101]","","Musnad Abi Ya'la al-Mawsili 2133","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن مجالد بن سعيد عن حماد بن زيد عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"2136","369 - (  2133  ) - مُكَرَّرٌ  وَعَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّكُمُ الْيَوْمَ عَلَى دِينٍ  ، وَإِنِّي مُكَاثِرٌ بِكُمُ الْأُمَمَ ، فَلَا تَمْشُوا  الْقَهْقَرَى  بَعْدِي  .","","Musnad Abi Ya'la al-Mawsili 2133","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن مجالد بن سعيد عن حماد بن أسامة القرشي عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند جابر"
"2137","370 - (  2134  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  السَّائِمَةُ  جُبَارٌ ،  وَالْبِئْرُ  جُبَارٌ  ، وَالْمَعْدِنُ جُبَارٌ ، وَفِي  الرِّكَازِ  الْخُمُسُ  .         [4/102]","","Musnad Abi Ya'la al-Mawsili 2134","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن مجالد بن سعيد عن حماد بن زيد عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"2138","371 - (  2135  ) -  وَعَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَسْأَلُوا أَهْلَ الْكِتَابِ عَنْ شَيْءٍ  ، فَإِنَّهُمْ لَنْ يَهْدُوكُمْ وَقَدْ ضَلُّوا ، وَإِنَّكُمْ إِمَّا أَنْ تُصَدِّقُوا بِبَاطِلٍ ، وَإِمَّا أَنْ تُكَذِّبُوا بِحَقٍّ ، وَإِنَّهُ وَاللهِ لَوْ كَانَ  مُوسَى  حَيًّا بَيْنَ أَظْهُرِكُمْ مَا حَلَّ لَهُ إِلَّا أَنْ يَتَّبِعَنِي  .         [4/103]","","Musnad Abi Ya'la al-Mawsili 2135","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن مجالد بن سعيد عن حماد بن أسامة القرشي عن إسحاق عن أبو يعلى الموصلي","مسند جابر"
"2139","372 - (  2136  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَابِرٍ :         {      إِنْ أُوتِيتُمْ هَذَا فَخُذُوهُ وَإِنْ لَمْ تُؤْتَوْهُ فَاحْذَرُوا         }      فَذَكَرَ ابْنَيْ صُورِيَا حَتَّى أَتَاهُمُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ لَهُمَا :  بِالَّذِي أَنْزَلَ التَّوْرَاةَ عَلَى  مُوسَى  ، وَالَّذِي فَلَقَ الْبَحْرَ ، وَالَّذِي أَنْزَلَ عَلَيْكُمُ الْمَنَّ وَالسَّلْوَى أَنْتُمْ أَعْلَمُ ؟  قَالَا : قَدْ نَحَلَنَا قَوْمُنَا ذَاكَ ، قَالَ : فَقَالَ أَحَدُهُمَا : يُنَاشِدُنَا بِمِثْلِ هَذِهِ ، قَالَ : تَجِدُونَ النَّظَرَ زَنْيَةً ، وَالِاعْتِنَاقَ زَنْيَةً ، وَالْقُبَلَ زَنْيَةً ، فَإِذَا شَهِدَ أَرْبَعَةٌ أَنَّهُمْ رَأَوْهُ يُبْدِئُ وَيُعِيدُ كَمَا يَدْخُلُ الْمِيلُ فِي الْمُكْحُلَةِ فَالرَّجْمُ .  ؟         [4/104]","","Musnad Abi Ya'la al-Mawsili 2136","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن مجالد بن سعيد عن سفيان بن عيينة عن إسحاق بن إسماعيل الطالقاني عن أبو يعلى الموصلي","مسند جابر"
"2140","373 - (  2137  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  حَدَّثَنَا  عَمَّارُ بْنُ غَزِيَّةَ ،  حَدَّثَنَا  رَجُلٌ مِنْ قَوْمِي  ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أُعْطِيَ عَطَاءً         [4/105]      فَوَجَدَ ، فَلْيَجْزِ بِهِ  ، فَإِنْ لَمْ يَجِدْ فَلْيُثْنِ بِهِ ، فَمَنْ أَثْنَى بِهِ فَقَدْ شَكَرَهُ ، وَمَنْ كَتَمَهُ فَقَدْ كَفَرَ ، وَمَنْ تَحَلَّى بِمَا لَمْ يُعْطَ كَانَ كَلَابِسِ  ثَوْبَيْ  زُورٍ ،  قَالَ بِإِصْبَعِهِ هَكَذَا ، السَّبَّابَةِ وَالْوُسْطَى  .         [4/106]","","Musnad Abi Ya'la al-Mawsili 2137","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن شرحبيل بن سعد الخطمي عن عمارة بن غزية عن بشر بن المفضل عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند جابر"
"2141","374 - (  2138  ) -  حَدَّثَنَا  إِسْحَاقُ ، وَالْقَوَارِيرِيُّ ، قَالَا :  حَدَّثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  حَدَّثَنَا  عُمَرُ بْنُ عَبْدِ اللهِ مَوْلَى غُفْرَةَ قَالَ :  سَمِعْتُ  أَيُّوبَ بْنَ خَالِدِ بْنِ صَفْوَانَ  يَذْكُرُ ، عَنْ  جَابِرٍ قَالَ :  خَرَجَ عَلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  يَا أَيُّهَا النَّاسُ ، إِنَّ لِلهِ سَرَايَا مِنَ الْمَلَائِكَةِ  ، تَحِلُّ وَتَقِفُ عَلَى مَجَالِسِ الذِّكْرِ فِي الْأَرْضِ ،  فَارْتَعُوا  فِي رِيَاضِ الْجَنَّةِ ، قَالُوا : وَمَا رِيَاضُ الْجَنَّةِ يَا رَسُولَ اللهِ ؟ قَالَ : مَجَالِسُ الذِّكْرِ ، فَاغْدُوا وَرُوحُوا فِي ذِكْرِ اللهِ ، وَاذْكُرُوهُ بِأَنْفُسِكُمْ ، مَنْ كَانَ يُحِبُّ أَنْ يَعْلَمَ مَنْزِلَتَهُ عِنْدَ اللهِ ، فَإِنَّ اللهَ يُنْزِلُ الْعَبْدَ مِنْهُ حَيْثُ أَنْزَلَهُ مِنْ نَفْسِهِ  .         [4/107]","","Musnad Abi Ya'la al-Mawsili 2138","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أيوب بن خالد بن صفوان النجاري عن عمر بن عبد الله مولى غفرة بنت رباح عن بشر بن المفضل عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"2142","375 - (  2139  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  سُفْيَانَ ،  عَنْ  سَلَمَةَ ،  أَخْبَرَنِي  مَنْ  سَمِعَ  جَابِرًا قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ بَاعَ عَبْدًا وَلَهُ مَالٌ ، فَمَالُهُ لِلْبَائِعِ  ، إِلَّا أَنْ يَشْتَرِطَ الْمُبْتَاعُ  .","","Musnad Abi Ya'la al-Mawsili 2139","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن من عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن عبد الرحمن بن مهدي عن إبراهيم بن محمد بن عرعرة عن أبو يعلى الموصلي","مسند جابر"
"2143","376 - (  2140  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  سُفْيَانَ ،  عَنِ  ابْنِ الْمُنْكَدِرِ ،         [4/108]      عَنْ  جَابِرٍ قَالَ :  جَاءَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَعُودُنِي لَيْسَ بِرَاكِبِ بَغْلٍ  ، وَلَا بِرْذَوْنٍ  .","","Musnad Abi Ya'la al-Mawsili 2140","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2144","377 - (  2141  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  سَلِيمِ بْنِ حَيَّانَ ،  عَنْ  سَعِيدِ بْنِ مِينَا ،  حَدَّثَنَا  جَابِرُ بْنُ عَبْدِ اللهِ قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ  الْمُحَاقَلَةِ  ،  وَالْمُزَابَنَةِ  ،  وَالْمُخَابَرَةِ  : كِرَاءُ الْأَرْضِ عَلَى النِّصْفِ  .         [4/109]","","Musnad Abi Ya'la al-Mawsili 2141","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سعيد بن مينا الحجازي عن سليم بن حيان بن بسطام الهذلي عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2145","378 - (  2142  ) -  وَحَدَّثَنَا  جَابِرُ بْنُ عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ كَانَ لَهُ  فَضْلُ  مَاءٍ أَوْ أَرْضٍ فَلْيَزْرَعْهَا  ، أَوْ يُزْرِعْهَا أَخَاهُ ، وَلَا  تَبِيعُوهَا  ،  قَالَ  سُلَيْمٌ  :  قُلْتُ : يَا  سَعِيدُ  ، مَا يَعْنِي بِالْبَيْعِ ؟ الْكِرَاءُ ؟ قَالَ : نَعَمْ  .","","Musnad Abi Ya'la al-Mawsili 2142","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سعيد بن مينا الحجازي عن سليم بن حيان بن بسطام الهذلي عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2146","379 - (  2143  ) -  وَقَالَ  :  سَمِعْتُ  جَابِرَ بْنَ عَبْدِ اللهِ يَقُولُ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ بَيْعِ  الثَّمَرَةِ  حَتَّى  تُشَقِّحَ  قُلْتُ  لِجَابِرٍ  : مَا  تُشْقِحُ  ؟ قَالَ : تَحْمَرُّ ، وَتَصْفَرُّ ، وَتُؤْكَلُ  .","","Musnad Abi Ya'la al-Mawsili 2143","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سعيد بن مينا الحجازي عن سليم بن حيان بن بسطام الهذلي عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2147","380 - (  2144  ) -  حَدَّثَنَا  جَابِرٌ :  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى عَلَى  النَّجَاشِيِّ  وَكَبَّرَ أَرْبَعَ تَكْبِيرَاتٍ  .         [4/110]","","Musnad Abi Ya'la al-Mawsili 2144","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سعيد بن مينا الحجازي عن سليم بن حيان بن بسطام الهذلي عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2148","381 - (  2145  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  سُفْيَانَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سَعِيدِ بْنِ أَبِي كَرِبٍ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  وَيْلٌ لِلْعَرَاقِيبِ مِنَ النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 2145","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سعيد بن أبي كرب عن أبو إسحاق السبيعي عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2149","382 - (  2146  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ :  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَخَلَ  يَوْمَ الْفَتْحِ  مَكَّةَ  وَعَلَيْهِ عِمَامَةٌ سَوْدَاءُ  .         [4/111]","","Musnad Abi Ya'la al-Mawsili 2146","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حماد بن سلمة عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2150","383 - (  2147  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  سُفْيَانَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  أَفَاضَ  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ  عَرَفَةَ  وَعَلَيْهِ  السَّكِينَةُ  ، وَأَمَرَ  بِالسَّكِينَةِ  ، وَأَوْضَحَ فِي  وَادِي مُحَسِّرٍ  ، وَقَالَ :  خُذُوا مَنَاسِكَكُمْ ، فَإِنِّي لَا أَدْرِي لَعَلَّكُمْ لَا تَلْقَوْنِي بَعْدَ  عَامِكُمْ أَوْ يَوْمِكُمْ  هَذَا ،  وَرَمَى بِمِثْلِ حَصَى  الْخَذْفِ  .","","Musnad Abi Ya'la al-Mawsili 2147","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2151","384 - (  2148  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  سُفْيَانَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَرَّ بِحِمَارٍ يُدَخِّنُ  مَنْخِرَاهُ  ، قَدْ وُسِمَ فِي         [4/112]      وَجْهِهِ ، فَقَالَ :  أَلَمْ أَلْعَنْ مَنْ فَعَلَ هَذَا ؟ أَلَا لَا يُوسَمَنَّ فِي الْوَجْهِ  ، وَلَا يُضْرَبَنَّ فِي الْوَجْهِ  .","","Musnad Abi Ya'la al-Mawsili 2148","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2152","385 - (  2149  ) -  وَعَنْ  جَابِرٍ قَالَ :  دَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى  بَنِي النَّجَّارِ  ، فَسَمِعَ صَوْتًا ، فَخَرَجَ مَذْعُورًا ، فَقَالَ :  اسْتَعِيذُوا بِاللهِ مِنْ عَذَابِ الْقَبْرِ  .","","Musnad Abi Ya'la al-Mawsili 2149","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2153","386 - (  2150  ) -  وَعَنْ  جَابِرٍ قَالَ :  نَحَرْنَا  يَوْمَ الْحُدَيْبِيَةِ  سَبْعِينَ بَدَنَةً ، الْبَدَنَةُ عَنْ سَبْعَةٍ ، وَقَالَ :  لِيَشْتَرِكِ النَّفَرُ فِي الْهَدْيِ  .         [4/113]","","Musnad Abi Ya'la al-Mawsili 2150","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2154","387 - (  2151  ) -  وَعَنْ  جَابِرٍ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ  إِبْرَاهِيمَ  حَرَّمَ بَيْتَ اللهِ وَأَمَّنَهُ  ، وَإِنِّي حَرَّمْتُ  الْمَدِينَةَ  ، فَحَرَامٌ مَا بَيْنَ  لَابَتَيْهَا  ، لَا يُصَادُ صَيْدُهَا ، وَلَا يُقْطَعُ  عِضَاهُهَا  .","","Musnad Abi Ya'la al-Mawsili 2151","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2155","388 - (  2152  ) -  وَعَنْ  جَابِرٍ ، وَابْنِ عُمَرَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْمُؤْمِنُ يَأْكُلُ فِي  مِعًى  وَاحِدٍ  ، وَالْكَافِرُ يَأْكُلُ فِي سَبْعَةِ أَمْعَاءٍ  .         [4/114]","","Musnad Abi Ya'la al-Mawsili 2152","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2156","389 - (  2153  ) -  وَعَنْ  جَابِرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  عَرْشُ إِبْلِيسَ عَلَى الْبَحْرِ  ، فَيَبْعَثُ سَرَايَا ، فَأَعْظَمُهُمْ عِنْدَهُ أَعْظَمُهُمْ فِتْنَةً  .","","Musnad Abi Ya'la al-Mawsili 2153","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2157","390 - (  2154  ) -  وَعَنْ  جَابِرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ إِبْلِيسَ قَدْ يَئِسَ أَنْ يَعْبُدَهُ الْمُصَلُّونَ  ، وَلَكِنْ فِي  التَّحْرِيشِ  بَيْنَكُمْ  .","","Musnad Abi Ya'la al-Mawsili 2154","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2158","391 - (  2155  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  جَابِرٍ : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى  يَوْمَ خَيْبَرَ  عَنْ لُحُومِ الْحُمُرِ  الْأَهْلِيَّةِ  ، وَأَذِنَ فِي لُحُومِ الْخَيْلِ  .","","Musnad Abi Ya'la al-Mawsili 2155","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن عمرو بن دينار الأثرم عن حماد بن زيد عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2159","392 - (  2156  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ قَالَ :  سَمِعْتُ  جَابِرًا ، يَقُولُ :  الظُّهْرُ كَاسْمِهَا ، وَالْعَصْرُ وَالشَّمْسُ حَيَّةٌ بَيْضَاءُ  ، وَالْمَغْرِبُ كَاسْمِهَا ، كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي بِنَا ، وَإِنَّا نَرَى مَوَاقِعَ النَّبْلِ ، وَكَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُعَجِّلُ الْعِشَاءَ ، وَالْفَجْرُ كَاسْمِهَا  .         [4/115]","","Musnad Abi Ya'la al-Mawsili 2156","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2160","393 - (  2157  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  شُعْبَةَ ،  عَنْ  سَعِيدٍ الْجُرَيْرِيِّ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  جَابِرٍ ،  أَنَّ  بَنِي سَلِمَةَ  ، ذَكَرُوا لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بُعْدَ مَنَازِلِهِمْ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا  بَنِي سَلِمَةَ  ، دِيَارَكُمْ فَإِنَّمَا تُكْتَبُ آثَارُكُمْ  .","","Musnad Abi Ya'la al-Mawsili 2157","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن المنذر بن مالك العوقي عن سعيد بن إياس الجريري عن شعبة بن الحجاج عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2161","394 - (  2158  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  سُفْيَانَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ :  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَوَى  رَجُلًا  فِي  أَكْحَلِهِ  مَرَّتَيْنِ  .         [4/116]","","Musnad Abi Ya'la al-Mawsili 2158","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2162","395 - (  2159  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُبَيْدِ بْنِ عُمَيْرٍ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي عَمَّارٍ ،  عَنْ  جَابِرٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سُئِلَ عَنِ الضَّبُعِ ، فَقَالَ :  هِيَ صَيْدٌ ، يُجْعَلُ فِيهَا كَبْشًا إِذَا أَصَابَهَا الْمُحْرِمُ  .","","Musnad Abi Ya'la al-Mawsili 2159","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الرحمن بن عبد الله بن أبي عمار الجشمي عن عبد الله بن عبيد بن عمير الجندعي عن أبو معاوية الضرير عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند جابر"
"2163","396 - (  2160  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  جَرِيرٌ قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ :  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَتَى  امْرَأَةً مِنَ الْأَنْصَارِ  ، فَبَسَطَتْ لَهُ عِنْدَ  صَوْرٍ  وَرَشَّتْ حَوْلَهُ  ، وَذَبَحَتْ شَاةً ، وَصَنَعَتْ لَهُ طَعَامًا ، فَأَكَلَ وَأَكَلْنَا مَعَهُ ، ثُمَّ تَوَضَّأَ لِصَلَاةِ الظُّهْرِ فَصَلَّى ، فَقَالَتِ الْمَرْأَةُ : يَا رَسُولَ اللهِ ، قَدْ فَضَلَتْ عِنْدَنَا مِنْ شَاتِنَا فَضْلَةٌ ، فَهَلْ لَكَ فِي الْعَشَاءِ ؟ قَالَ : نَعَمْ ، فَأَكَلَ وَأَكَلْنَا ثُمَّ صَلَّى الْعَصْرَ وَلَمْ يَتَوَضَّأْ  .         [4/117]","","Musnad Abi Ya'la al-Mawsili 2160","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن جرير بن حازم عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند جابر"
"2164","397 - (  2161  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمَّارِ بْنِ أَبِي عَمَّارٍ ،  عَنْ  جَابِرٍ قَالَ :  كَانَ لِيَهُودِيٍّ عَلَى أَبِي دَيْنُ تَمْرٍ ، وَتَرَكَ أَبِي  حَدِيقَتَيْنِ  ، وَتَمْرُ الْيَهُودِيِّ يَسْتَوْعِبُ  الْحَدِيقَتَيْنِ  ، فَقَالَ لَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  هَلْ لَكَ أَنْ تَأْخُذَ الْعَامَ بَعْضًا ، وَتُؤَخِّرَ بَعْضًا إِلَى قَابِلٍ ؟  فَأَبَى الْيَهُودِيُّ ، فَقَالَ لِيَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : يَا  جَابِرُ  ، إِذَا حَضَرَ  الْجِدَادُ         [4/118]      فَآذِنِّي فَآذَنْتُهُ ، فَجَاءَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأَبُو بَكْرٍ  وَعُمَرُ  ، فَجُعِلَ يُكَالُ لَهُ مِنْ أَسْفَلِ النَّخْلِ ، وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَدْعُو بِالْبَرَكَةِ ، فَوَفَّيْنَاهُ حَقَّهُ ، قَالَ عَمَّارٌ :  أُرَاهُ مِنْ أَصْغَرِ  الْحَدِيقَتَيْنِ  قَالَ : ثُمَّ أَتَيْنَاهُمْ بِرُطَبٍ ، فَأَكَلُوا وَشَرِبُوا ، ثُمَّ قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : هَذَا مِنَ النَّعِيمِ الَّذِي تُسْأَلُونَ عَنْهُ  .","","Musnad Abi Ya'la al-Mawsili 2161","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمار بن أبي عمار الحارثي عن حماد بن سلمة عن هدبة بن خالد عن أبو يعلى الموصلي","مسند جابر"
"2165","398 - (  2162  ) -  حَدَّثَنَا  أَبُو هِشَامٍ الرِّفَاعِيُّ ،  حَدَّثَنَا  يَحْيَى بْنُ يَمَانٍ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  جَابِرٍ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَنْتُمُ  الْغُرُّ  الْمُحَجَّلُونَ  .","","Musnad Abi Ya'la al-Mawsili 2162","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن ذكوان السمان عن الأعمش عن يحيى بن يمان العجلي عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند جابر"
"2166","399 - (  2163  ) -  حَدَّثَنَا  أَبُو هِشَامٍ ،  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  حَدَّثَنَا  الْأَجْلَحُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  لَمَّا كَانَ  يَوْمُ الطَّائِفِ  ، نَاجَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَلِيًّا  ، فَأَطَالَ  نَجْوَاهُ  ، فَقَالَ بَعْضُ أَصْحَابِهِ : لَقَدْ أَطَالَ  نَجْوَى  ابْنِ عَمِّهِ         [4/119]      فَبَلَغَهُ ذَلِكَ ، فَقَالَ :  مَا أَنَا أَنْجَيْتُهُ بَلِ اللهُ  انْتَجَاهُ  .","","Musnad Abi Ya'la al-Mawsili 2163","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن أجلح بن عبد الله الكندي عن محمد بن فضيل بن غزوان عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند جابر"
"2167","400 - (  2164  ) -  حَدَّثَنَا  أَبُو هِشَامٍ الرِّفَاعِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ جُمَيْعٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  جَابِرٍ قَالَ :  قَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ يَوْمٍ عَلَى الْمِنْبَرِ فَقَالَ :  يَا أَيُّهَا النَّاسُ إِنِّي لَمْ أَقُمْ فِيكُمْ بِخَبَرٍ جَاءَنِي مِنَ السَّمَاءِ  ، وَلَكِنْ بَلَغَنِي خَبَرٌ فَفَرِحْتُ بِهِ ، فَأَحْبَبْتُ أَنْ تَفْرَحُوا بِفَرَحِ نَبِيِّكُمْ ، إِنَّهُ بَيْنَا رَكْبٌ يَسِيرُونَ فِي الْبَحْرِ إِذْ نَفِدَ طَعَامُهُمْ ، فَرُفِعَتْ لَهُمْ جَزِيرَةٌ ، فَخَرَجُوا يُرِيدُونَ الْخُبْزَ ، فَلَقِيَتْهُمُ  الْجَسَّاسَةُ  ، فَقُلْتُ  لِأَبِي سَلَمَةَ  :  وَمَا  الْجَسَّاسَةُ  ؟ قَالَ : امْرَأَةٌ تَجُرُّ شَعَرَ جِلْدِهَا وَرَأْسِهَا  فَقَالَتْ : فِي هَذَا الْقَصْرِ خَبَرُ مَا تُرِيدُونَ ، فَأَتَوْهُ فَإِذَا هُمْ بِرَجُلٍ  مُوثَقٌ  ، فَقَالَ : أَخْبِرُونِي أَوْ سَلُونِي أُخْبِرْكُمْ ، فَسَكَتَ  الْقَوْمُ  ، فَقَالَ : أَخْبِرُونِي عَنْ  نَخْلِ بَيْسَانَ  أَطْعَمَ  ؟ قَالُوا : نَعَمْ         [4/120]      قَالَ : أَخْبِرُونِي عَنْ  حَمْأَةِ زُغَرَ  فِيهَا مَاءٌ ؟ قَالُوا : نَعَمْ ، قَالُوا : هُوَ  الْمَسِيحُ  تُطْوَى لَهُ الْأَرْضُ فِي أَرْبَعِينَ يَوْمًا ، إِلَّا مَا كَانَ مِنْ  طَيْبَةَ  .  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  وَطَيْبَةُ : الْمَدِينَةُ  ، مَا بَابٌ مِنْ أَبْوَابِهَا إِلَّا مَلَكٌ مُصْلِتٌ سَيْفَهُ يَمْنَعُهُ  وَبِمَكَّةَ  مِثْلُ ذَلِكَ ، ثُمَّ قَالَ : فِي  بَحْرِ فَارِسَ  مَا هُوَ ، فِي  بَحْرِ الرُّومِ  مَا هُوَ ، ثَلَاثًا ، ثُمَّ ضَرَبَ بِكَفِّهِ الْيُمْنَى عَلَى الْيُسْرَى ثَلَاثًا  ، فَقَالَ لِيَ  ابْنُ أَبِي سَلَمَةَ  : فِي هَذَا الْحَدِيثِ شَيْءٌ مَا حَفِظْتُهُ ، قُلْنَا : مَا هُوَ ؟ قَالَ : شَهِدَ  جَابِرٌ  أَنَّهُ  ابْنُ صَائِدٍ  ، قُلْتُ : لَا ، فَإِنَّ  ابْنَ صَائِدٍ  قَدْ مَاتَ ، قَالَ : وَإِنْ مَاتَ ، قُلْتُ : قَدْ أَسْلَمَ ، قَالَ : وَإِنْ أَسْلَمَ ، قُلْتُ : فَإِنَّهُ قَدْ دَخَلَ  الْمَدِينَةَ  ، قَالَ : وَإِنْ دَخَلَ  الْمَدِينَةَ  .         [4/121]","","Musnad Abi Ya'la al-Mawsili 2164","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو سلمة بن عبد الرحمن عن الوليد بن عبد الله بن جميع الخزاعي عن محمد بن فضيل بن غزوان عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند جابر"
"2168","401 - (  2165  ) -  حَدَّثَنَا  أَبُو هِشَامٍ ،  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي صَالِحٍ ، وَأَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا فَرَغَ أَحَدُكُمْ مِنْ طَعَامِهِ ، فَلْيَلْعَقْ أَصَابِعَهُ  فَإِنَّهُ لَا يَدْرِي فِي أَيِّ طَعَامِهِ تَكُونُ الْبَرَكَةُ  .","","Musnad Abi Ya'la al-Mawsili 2165","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن محمد بن فضيل بن غزوان عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند جابر"
"2169","402 - (  2166  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ عُمَرَ بْنِ شَقِيقٍ ،  حَدَّثَنَا  يَزِيدُ ،  عَنْ  حُسَيْنٍ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنْ  جَابِرٍ ،  أَنَّ  رَجُلًا  أَعْتَقَ غُلَامًا لَهُ عَنْ  دُبُرٍ  مِنْهُ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ يَشْتَرِيهِ مِنِّي ؟ قَالَ : فَاشْتَرَاهُ  نُعَيْمُ بْنُ عَبْدِ اللهِ  ، فَأَخَذَ ثَمَنَهُ فَدَفَعَهُ إِلَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 2166","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن حسين المعلم عن يزيد بن زريع العيشي عن الحسن بن عمر بن شقيق الجرمي عن أبو يعلى الموصلي","مسند جابر"
"2170","403 - (  2167  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ عُمَرَ بْنِ شَقِيقٍ ،  حَدَّثَنَا  يَزِيدُ ،  عَنْ  حَبِيبٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،         [4/122]      عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، بِمِثْلِ حَدِيثِ  حُسَيْنٍ  ، عَنْ  عَطَاءٍ  ، وَزَادَ فِيهِ : قَالَ : قَالَ نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا كَانَ أَحَدُكُمْ فَقِيرًا ، فَلْيَبْدَأْ بِنَفْسِهِ  .","","Musnad Abi Ya'la al-Mawsili 2167","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حبيب المعلم مولى معقل بن يسار عن يزيد بن زريع العيشي عن الحسن بن عمر بن شقيق الجرمي عن أبو يعلى الموصلي","مسند جابر"
"2171","404 - (  2168  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ زَنْجُوَيْهِ ،  حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ،  أَخْبَرَنَا  مَعْمَرٌ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  جَابِرٍ قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مِنْ تَمَامِ الصَّلَاةِ ، إِقَامَةُ الصَّفِّ  .         [4/123]","","Musnad Abi Ya'la al-Mawsili 2168","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن معمر بن راشد عن عبد الرزاق الصنعاني عن محمد بن عبد الملك بن زنجويه الغزال عن أبو يعلى الموصلي","مسند جابر"
"2172","405 - (  2169  ) -  حَدَّثَنَا  أَبُو عَلِيٍّ مُجَاهِدُ بْنُ مُوسَى ،  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ يُونُسَ ،  حَدَّثَنَا  زُهَيْرٌ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا يَبِيعُ  حَاضِرٌ  لِبَادٍ  ، دَعُوا النَّاسَ يَرْزُقُ اللهُ بَعْضَهُمْ مِنْ بَعْضٍ  .","","Musnad Abi Ya'la al-Mawsili 2169","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زهير بن معاوية بن حديج عن أحمد بن عبد الله اليربوعي عن مجاهد بن موسى عن أبو يعلى الموصلي","مسند جابر"
"2173","406 - (  2170  ) -  وَبِإِسْنَادِهِ  قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ بَيْعِ  الثَّمَرِ  حَتَّى يَطِيبَ  .","","Musnad Abi Ya'la al-Mawsili 2170","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زهير بن معاوية بن حديج عن أحمد بن عبد الله اليربوعي عن مجاهد بن موسى عن أبو يعلى الموصلي","مسند جابر"
"2174","407 - (  2171  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ ،  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ كَانَ شَرِيكًا فِي رَبْعَةٍ أَوْ نَخْلٍ فَلَيْسَ لَهُ أَنْ يَبِيعَهُ  حَتَّى يُؤْذِنَ شَرِيكَهُ ، فَإِنْ رَضِيَ أَخَذَ ، وَإِنْ كَرِهَ تَرَكَ  .","","Musnad Abi Ya'la al-Mawsili 2171","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زهير بن معاوية بن حديج عن أحمد بن عبد الله اليربوعي عن مجاهد بن موسى عن أبو يعلى الموصلي","مسند جابر"
"2175","408 - (  2172  ) -  حَدَّثَنَا  أَبُو إِسْحَاقَ إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ الْهَرَوِيُّ ،  حَدَّثَنَا  إِسْمَاعِيلُ ابْنُ عُلَيَّةَ ،  حَدَّثَنَا  الْحَجَّاجُ بْنُ أَبِي عُثْمَانَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ :  انْطَلَقَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِيُصْلِحَ بَيْنَ  بَنِي عَمْرِو بْنِ عَوْفٍ  مِنَ  الْأَنْصَارِ  قَالَ : وَحَضَرَتِ الصَّلَاةُ ، فَقَالَ  بِلَالٌ  لِأَبِي بَكْرٍ  : أَأُؤَذِّنُ         [4/124]      فَتُصَلِّيَ بِالنَّاسِ ؟ قَالَ : نَعَمْ ، فَأَقَامَ  بِلَالٌ  ، فَتَقَدَّمَ  أَبُو بَكْرٍ  فَصَلَّى بِالنَّاسِ ، وَجَاءَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَعَلُوا يُصَفِّقُونَ بِأَيْدِيهِمْ  لِأَبِي بَكْرٍ  ، وَكَانَ  أَبُو بَكْرٍ  لَا يَكَادُ يَلْتَفِتُ إِذَا كَانَ فِي الصَّلَاةِ ، فَلَمَّا صَفَّقُوا الْتَفَتَ ، فَرَأَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَتَأَخَّرَ ، فَأَوْمَأَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِيَدِهِ إِلَيْهِ أَنْ يُصَلِّيَ فَأَبَى ، فَتَقَدَّمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَصَلَّى ، فَلَمَّا قَضَى صَلَاتَهُ قَالَ  لِأَبِي بَكْرٍ  : مَا مَنَعَكَ أَنْ تُصَلِّيَ ؟ قَالَ : مَا كَانَ  لِابْنِ أَبِي قُحَافَةَ  أَنْ يَؤُمَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَقْبَلَ عَلَى  الْقَوْمِ  ، فَقَالَ :  مَا بَالُ التَّصْفِيقِ ؟ إِنَّمَا التَّصْفِيقُ فِي الصَّلَاةِ لِلنِّسَاءِ ، فَإِذَا كَانَ لِأَحَدِكُمْ حَاجَةٌ فَلْيُسَبِّحْ  .         [4/125]","","Musnad Abi Ya'la al-Mawsili 2172","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حجاج بن أبى عثمان الصواف الكندي عن إسماعيل ابن علية عن إبراهيم بن عبد الله الهروي عن أبو يعلى الموصلي","مسند جابر"
"2176","409 - (  2173  ) -  حَدَّثَنَا  إِبْرَاهِيمُ الْهَرَوِيُّ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  الْحَجَّاجُ بْنُ أَبِي عُثْمَانَ ،  حَدَّثَنِي  أَبُو الزُّبَيْرِ ، أَنَّ جَابِرًا ،  حَدَّثَهُمْ  قَالَ :  مَرَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِأُمِّ السَّائِبِ  ، أَوْ  أُمِّ الْمُسَيِّبِ  وَهِيَ  تُزَفْزِفُ  مِنَ الْحُمَّى ، فَقَالَ لَهَا : مَا شَأْنُكِ يَا  أُمَّ السَّائِبِ  تُزَفْزِفِينَ  ؟ قَالَتِ : الْحُمَّى ، لَا بَارَكَ اللهُ فِيهَا ، قَالَ :  لَا تَسُبِّيهَا ، فَإِنَّهَا تُذْهِبُ خَطَايَا بَنِي آدَمَ كَمَا يُذْهِبُ  الْكِيرُ  خَبَثَ  الْحَدِيدِ  .","","Musnad Abi Ya'la al-Mawsili 2173","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حجاج بن أبى عثمان الصواف الكندي عن إسماعيل ابن علية عن إبراهيم بن عبد الله الهروي عن أبو يعلى الموصلي","مسند جابر"
"2177","410 - (  2174  ) -  حَدَّثَنَا  إِبْرَاهِيمُ الْهَرَوِيُّ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  الْحَجَّاجُ بْنُ أَبِي عُثْمَانَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  قَدِمَ  رَجُلٌ  الْمَدِينَةَ  مُهَاجِرًا ، قَالَ : فَحُمَّ حُمَّى شَدِيدَةً ، فَأَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ أَقِلْنِي الْهِجْرَةَ ، فَقَالَ : لَا وَاللهِ لَا أُقِيلُكَ ، إِنَّ الْإِسْلَامَ لَا يُقَالُ ، قَالَ  الْحَجَّاجُ  : وَذَكَرَ أَنَّهُ غَيْرَ مَرَّةٍ كُلَّ ذَلِكَ يَأْبَى عَلَيْهِ فَخَرَجَ بِغَيْرِ إِذْنِهِ ، فَأُخْبِرَ بِهِ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  إِنَّهَا طَيْبَةُ  تَنْفِي  خَبَثَ الرِّجَالِ كَمَا يَنْفِي  الْكِيرُ  خَبَثَ  الْحَدِيدِ  .         [4/126]","","Musnad Abi Ya'la al-Mawsili 2174","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حجاج بن أبى عثمان الصواف الكندي عن إسماعيل ابن علية عن إبراهيم بن عبد الله الهروي عن أبو يعلى الموصلي","مسند جابر"
"2178","411 - (  2175  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  الْحَجَّاجُ بْنُ أَبِي عُثْمَانَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  قَدِمَ  الطُّفَيْلُ بْنُ عَمْرٍو الدَّوْسِيُّ  عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِمَكَّةَ  ، فَقَالَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : هَلُمَّ إِلَى حِصْنٍ حَصِينٍ ، وَعَدَدٍ وَعُدَّةٍ قَالَ  أَبُو الزُّبَيْرِ  :  الدَّوْسُ  : حِصْنٌ فِي رَأْسِ جَبَلٍ لَا يُؤْتَى إِلَّا فِي مِثْلِ  الشِّرَاكِ  ، فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَمَعَكَ مَنْ وَرَاءَكَ ؟  قَالَ : لَا أَدْرِي ، قَالَ : فَأَعْرَضَ عَنْهُ لِمَا ذَخَرَ اللهُ  لِلْأَنْصَارِ  ، قَالَ : فَلَمَّا قَدِمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْمَدِينَةَ  ، قَدِمَ  الطُّفَيْلُ بْنُ عَمْرٍو  مُهَاجِرًا إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَعَهُ  رَجُلٌ  مِنْ رَهْطِهِ ، فَحُمَّ ذَلِكَ الرَّجُلُ حُمَّى شَدِيدَةً فَخَرَجَ ، فَأَخَذَ  شَفْرَةً  فَقَطَعَ بِهَا دَوَاحِلَهُ  فَشَخَبَ  حَتَّى مَاتَ ، فَدُفِنَ فَجَاءَ فِيمَا يَرَى النَّائِمُ فِي اللَّيْلِ إِلَى  الطُّفَيْلِ بْنِ عَمْرٍو  فِي  شَارَةٍ  حَسَنَةٍ ، وَهُوَ مُخَمِّرٌ يَدَهُ ، فَقَالَ لَهُ  الطُّفَيْلُ  : أَفُلَانٌ ؟ قَالَ : نَعَمْ ، قَالَ : كَيْفَ فَعَلْتَ ؟ قَالَ : صَنَعَ بِي رَبِّي خَيْرًا ، غَفَرَ لِي بِهِجْرَتِي إِلَى نَبِيِّهِ ، قَالَ : فَمَا فَعَلَتْ يَدَاكَ ؟ قَالَ : قَالَ رَبِّي : لَنْ نُصْلِحَ مِنْكَ مَا أَفْسَدْتَ مِنْ نَفْسِكَ ، فَقَصَّ  الطُّفَيْلُ  رُؤْيَاهُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَفَعَ يَدَهُ ، فَقَالَ : اللَّهُمَّ وَلِيَدَيْهِ فَاغْفِرِ ، اللَّهُمَّ وَلِيَدَيْهِ فَاغْفِرِ ، اللَّهُمَّ وَلِيَدَيْهِ فَاغْفِرْ  .         [4/127]","","Musnad Abi Ya'la al-Mawsili 2175","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حجاج بن أبى عثمان الصواف الكندي عن إسماعيل ابن علية عن إبراهيم بن عبد الله الهروي عن أبو يعلى الموصلي","مسند جابر"
"2179","412 - (  2176  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي سَمِينَةَ ،  حَدَّثَنَا  مُبَشِّرُ بْنُ إِسْمَاعِيلَ ،  حَدَّثَنَا  أَبُو بَكْرٍ الْغَسَّانِيُّ ،  عَنْ  حَكِيمِ بْنِ عُمَيْرٍ ،  عَنْ  جَابِرٍ : أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَسْجُدُ فِي أَعْلَى جَبْهَتِهِ مَعَ  قِصَاصِ  الشَّعَرِ  .         [4/128]","","Musnad Abi Ya'la al-Mawsili 2176","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن حكيم بن عمير بن الأحوص العنسي عن أبو بكر الغساني عن مبشر بن إسماعيل الحلبي عن محمد بن إسماعيل بن أبي سمينة عن أبو يعلى الموصلي","مسند جابر"
"2180","413 - (  2177  ) -  حَدَّثَنَا  مَسْرُوقُ بْنُ الْمَرْزُبَانِ ،  حَدَّثَنَا  ابْنُ أَبِي زَائِدَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سَعِيدٍ ،  عَنْ  جَابِرٍ قَالَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُومُ إِلَى خَشَبَةٍ يَتَوَكَّأُ عَلَيْهَا  يَخْطُبُ كُلَّ جُمُعَةٍ ، حَتَّى أَتَاهُ  رَجُلٌ مِنَ الرُّومِ  ، وَقَالَ : إِنْ شِئْتَ جَعَلْتُ لَكَ شَيْئًا إِذَا قَعَدْتَ عَلَيْهِ كُنْتَ كَأَنَّكَ قَائِمٌ ؟ قَالَ : نَعَمْ ، قَالَ : فَجَعَلَ لَهُ الْمِنْبَرَ ، فَلَمَّا جَلَسَ عَلَيْهِ حَنَّتِ الْخَشَبَةُ حَنِينَ النَّاقَةِ عَلَى وَلَدِهَا ، حَتَّى نَزَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَوَضَعَ يَدَهُ عَلَيْهَا ، فَلَمَّا كَانَ مِنَ الْغَدِ ، فَرَأَيْتُهَا قَدْ حُوِّلَتْ ، فَقُلْنَا : مَا هَذَا ؟ قَالَ : جَاءَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأَبُو بَكْرٍ  وَعُمَرُ  فَحَوَّلُوهَا  .         [4/129]","","Musnad Abi Ya'la al-Mawsili 2177","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سعيد بن أبي كرب عن أبو إسحاق السبيعي عن يحيى بن زكريا بن أبي زائدة عن مسروق بن المرزبان الكندي عن أبو يعلى الموصلي","مسند جابر"
"2181","414 - (  2178  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنِ  الْوَلِيدِ بْنِ جُمَيْعٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  جَابِرٍ قَالَ :  قَامَ فِينَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ يَوْمٍ عَلَى الْمِنْبَرِ ، فَقَالَ :  بَيْنَمَا نَاسٌ يَسِيرُونَ فِي الْبَحْرِ فَلَقِيَتْهُمُ  الْجَسَّاسَةُ  ، فَقُلْتُ : وَمَا  الْجَسَّاسَةُ  ؟ فَقَالَ : امْرَأَةٌ تَجُرُّ شَعَرَ جِلْدِهَا وَرَأْسِهَا ،         [4/130]      فَقَالَتْ : فِي هَذَا الْقَصْرِ خَبَرُ مَا تُرِيدُونَ فَأَتَوْهُ فَإِذَا هُمْ بِرَجُلٍ  مُوثَقٍ  قَالَ :  أَخْبِرُونِي ، أَوْ سَلُونِي  أُخْبِرْكُمْ ، فَسَكَتَ  الْقَوْمُ  ، فَقَالَ : أَخْبِرُونِي عَنْ نَخْلِ  بَيْسَانَ  ،  وَعَيْنِ  زُغَرَ  وَعُمَانَ  ، هَلْ  أَطْعَمَ  ؟ قَالُوا : نَعَمْ ، قَالَ : فَأَخْبِرُونِي عَنْ  حَمْأَةِ  زُغَرَ  هَلْ فِيهَا مَاءٌ ؟ قَالُوا : نَعَمْ ، هِيَ مَلْأَى تَدَفَّقَ جَانِبُهَا ، قَالَ : فَقَالَ : وَهُوَ  الْمَسِيحُ  تُطْوَى لَهُ الْأَرْضُ فَيَسْلُكُهَا فِي أَرْبَعِينَ إِلَّا مَا كَانَ مِنْ طَيْبَةَ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : هِيَ  الْمَدِينَةُ  ، مَا بَابٌ مِنْ أَبْوَابِهَا إِلَّا عَلَيْهِ مَلَكٌ صَالِتٌ سَيْفَهُ يَمْنَعُهُ مِنْهَا ،  وَبِمَكَّةَ  مِثْلُ ذَلِكَ ، ثُمَّ قَالَ : فِي  بَحْرِ فَارِسَ  مَا هُوَ ، فِي  بَحْرِ الرُّومِ  مَا هُوَ ، ثَلَاثًا ، قَالَ : فَقَالَ  ابْنُ أَبِي سَلَمَةَ  : إِنَّ فِي هَذَا الْحَدِيثِ شَيْئًا مَا حَفِظْتُهُ قَالَ : فَشَهِدَ  جَابِرٌ  أَنَّهُ  ابْنُ صَيَّادٍ  ، قَالَ : فَقُلْتُ : إِنَّ  ابْنَ صَيَّادٍ  قَدْ مَاتَ ، قَالَ : وَإِنْ مَاتَ ، قَالَ : فَقُلْتُ : فَإِنَّهُ قَدْ أَسْلَمَ ، قَالَ : وَإِنْ كَانَ قَدْ أَسْلَمَ ، قَالَ : فَإِنَّهُ قَدْ دَخَلَ  الْمَدِينَةَ  قَالَ : وَإِنْ كَانَ قَدْ دَخَلَ  الْمَدِينَةَ  .","","Musnad Abi Ya'la al-Mawsili 2178","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو سلمة بن عبد الرحمن عن الوليد بن عبد الله بن جميع الخزاعي عن محمد بن فضيل بن غزوان عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند جابر"
"2182","415 - (  2179  ) -  حَدَّثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ الْهِلَالِيُّ  حَدَّثَنَا  يُونُسُ بْنُ بُكَيْرٍ  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ إِسْمَاعِيلَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ  مَا سَمِعْنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَاحَ لَنَا بِشَيْءٍ مِنَ الدُّعَاءِ عَلَى الْجَنَائِزِ وَلَا  أَبُو بَكْرٍ  وَلَا  عُمَرُ  .         [4/131]","","Musnad Abi Ya'la al-Mawsili 2179","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن إبراهيم بن إسماعيل بن مجمع عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","مسند جابر"
"2183","416 - (  2180  ) -  حَدَّثَنَا  عُقْبَةُ ،  حَدَّثَنَا  يُونُسُ ،  حَدَّثَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  اشْتَكَيْتُ  ، فَدَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَنَفَخَ فِي وَجْهِي ،  فَأَفَقْتُ  .","","Musnad Abi Ya'la al-Mawsili 2180","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن هشام الدستوائي عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","مسند جابر"
"2184","417 - (  2181  ) -  حَدَّثَنَا  عُقْبَةُ ،  حَدَّثَنَا  يُونُسُ قَالَ :  أَخْبَرَنِي  إِبْرَاهِيمُ بْنُ إِسْمَاعِيلَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَضْطَجِعَ أَحَدُنَا يَضَعُ         [4/132]      إِحْدَى رِجْلَيْهِ عَلَى الْأُخْرَى  .","","Musnad Abi Ya'la al-Mawsili 2181","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن إبراهيم بن إسماعيل بن مجمع عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","مسند جابر"
"2185","418 - (  2182  ) -  حَدَّثَنَا  عُقْبَةُ ،  حَدَّثَنَا  يُونُسُ ،  حَدَّثَنَا  سُلَيْمَانُ الْأَعْمَشُ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَيَأْتِيَنَّ عَلَى النَّاسِ زَمَانٌ يَخْرُجُ الْجَيْشُ مِنْ جُيُوشِهِمْ  فَيُقَالُ : هَلْ فِيكُمْ أَحَدٌ صَحِبَ  مُحَمَّدًا  فَتَسْتَنْصِرُونَ بِهِ فَتُنْصَرُوا ؟ ثُمَّ يُقَالُ : هَلْ فِيكُمْ مَنْ صَحِبَ  مُحَمَّدًا  ؟ فَيُقَالُ : لَا ، فَمَنْ صَحِبَ أَصْحَابَهُ ؟ فَيُقَالُ : لَا ، فَيُقَالُ : مَنْ رَأَى مَنْ صَحِبَ أَصْحَابَهُ ؟ فَلَوُ سَمِعُوا بِهِ مِنْ وَرَاءِ الْبَحْرِ لَأَتَوْهُ  .","","Musnad Abi Ya'la al-Mawsili 2182","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","مسند جابر"
"2186","419 - (  2183  ) -  حَدَّثَنَا  عُقْبَةُ ،  حَدَّثَنَا  مَسْعَدَةُ بْنُ الْيَسَعِ ،  عَنْ  شِبْلِ بْنِ عَبَّادٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ،  أَنَّ  رَجُلًا  جَاءَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : أَيُّ النَّاسِ أَعْلَمُ ؟ قَالَ :  مَنْ يَجْمَعُ عِلْمَ النَّاسِ إِلَى عِلْمِهِ  ، وَكُلُّ صَاحِبِ عِلْمٍ  غَرْثَانُ  .         [4/133]","","Musnad Abi Ya'la al-Mawsili 2183","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن شبل بن عباد المكي عن مسعدة بن اليسع اليشكري عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","مسند جابر"
"2187","420 - (  2184  ) -  حَدَّثَنَا  الْأَزْرَقُ بْنُ عَلِيٍّ ،  حَدَّثَنَا  حَسَّانُ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ النَّاسَ يَكْثُرُونَ وَأَصْحَابِي يَقِلُّونَ  ، فَلَا تَسُبُّوهُمْ ، لَعَنَ اللهُ مَنْ سَبَّهُمْ  .","","Musnad Abi Ya'la al-Mawsili 2184","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن محمد بن الفضل بن عطية العبسي عن حسان بن إبراهيم الكرماني عن الأزرق بن علي بن مسلم الحنفي عن أبو يعلى الموصلي","مسند جابر"
"2188","421 - (  2185  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  سَعِيدٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنْ  جَابِرٍ ، قَالَ :  كُنْتُ فِي الصَّفِّ  الثَّانِي أَوِ الثَّالِثِ  حَيْثُ صَلَّى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى  النَّجَاشِيِّ  .         [4/134]","","Musnad Abi Ya'la al-Mawsili 2185","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن محمد بن المنهال عن أبو يعلى الموصلي","مسند جابر"
"2189","422 - (  2186  ) -  حَدَّثَنَا  مَسْرُوقٌ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  جَاءَ  سُلَيْكٌ  إِلَى الْمَسْجِدِ ، وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ ، فَأَمَرَهُ أَنْ يُصَلِّيَ رَكْعَتَيْنِ خَفِيفَتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 2186","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن شريك بن عبد الله النخعي عن مسروق بن المرزبان الكندي عن أبو يعلى الموصلي","مسند جابر"
"2190","423 - (  2187  ) -  حَدَّثَنَا  مَسْرُوقٌ ،  حَدَّثَنَا  ابْنُ أَبِي زَائِدَةَ قَالَ :  حَدَّثَنِي  أَبُو أَيُّوبَ الْأَفْرِيقِيُّ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أُرِيتُ الْأَنْبِيَاءَ ، فَأَنَا شَبِيهُ  إِبْرَاهِيمَ  .","","Musnad Abi Ya'la al-Mawsili 2187","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن عبد الله بن علي الأزرق عن يحيى بن زكريا بن أبي زائدة عن مسروق بن المرزبان الكندي عن أبو يعلى الموصلي","مسند جابر"
"2191","424 - (  2188  ) -  حَدَّثَنَا  مَسْرُوقُ بْنُ الْمَرْزُبَانِ ،  حَدَّثَنَا  حَفْصٌ ،  عَنْ  جَعْفَرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرٍ :  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَمَعَ بَيْنَ الظُّهْرِ وَالْعَصْرِ  بِعَرَفَاتٍ  بِأَذَانٍ وَإِقَامَتَيْنِ  ، وَالْمَغْرِبِ وَالْعِشَاءِ بِأَذَانٍ وَإِقَامَتَيْنِ  .         [4/135]","","Musnad Abi Ya'la al-Mawsili 2188","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن حفص بن غياث النخعي عن مسروق بن المرزبان الكندي عن أبو يعلى الموصلي","مسند جابر"
"2192","425 - (  2189  ) -  حَدَّثَنَا  سُفْيَانُ بْنُ وَكِيعٍ ،  حَدَّثَنَا  حَفْصٌ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  سُلَيْمَانَ بْنِ مُوسَى ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  رَخَّصَ لَهُمْ فِي قَطْعِ النَّخْلِ ثُمَّ شَدَّدَ عَلَيْهِمْ  ، فَأَتَوُا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالُوا : يَا رَسُولَ اللهِ ، عَلَيْنَا إِثْمٌ فِيمَا قَطَعْنَا ، أَوْ عَلَيْنَا فِيمَا تَرَكْنَا ؟ فَأَنْزَلَ اللهُ :         {      مَا قَطَعْتُمْ مِنْ لِينَةٍ أَوْ تَرَكْتُمُوهَا قَائِمَةً عَلَى أُصُولِهَا فَبِإِذْنِ اللهِ         }      .","","Musnad Abi Ya'la al-Mawsili 2189","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سليمان بن موسى الأشدق عن ابن جريج عن حفص بن غياث النخعي عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","مسند جابر"
"2193","426 - (  2190  ) -  حَدَّثَنَا  سُفْيَانُ بْنُ وَكِيعٍ ،  حَدَّثَنَا  أَبِي ،  عَنْ  عُبَيْدِ اللهِ  عَنْ  أَبِي مَلِيحٍ ،  حَدَّثَنَا  جَابِرُ بْنُ عَبْدِ اللهِ قَالَ :  أَنْزَلَ اللهُ صُحُفَ  إِبْرَاهِيمَ  فِي أَوَّلِ لَيْلَةٍ مِنْ رَمَضَانَ ، وَأُنْزِلَتِ التَّوْرَاةُ عَلَى  مُوسَى  لِسِتٍّ خَلَوْنَ مِنْ رَمَضَانَ  ، وَأُنْزِلَ الزَّبُورُ عَلَى  دَاوُدَ  فِي إِحْدَى عَشْرَةَ لَيْلَةً خَلَتْ مِنْ         [4/136]      رَمَضَانَ ، وَأُنْزِلَ الْقُرْآنُ عَلَى  مُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي أَرْبَعٍ وَعِشْرِينَ خَلَتْ مِنْ رَمَضَانَ  .         [4/137]","","Musnad Abi Ya'la al-Mawsili 2190","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو المليح بن أسامة الهذلي عن عبيد الله بن أبي حميد الهذلي عن وكيع بن الجراح عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","مسند جابر"
"2194","427 - (  2191  ) -  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنَا  أَبُو أُسَامَةَ  عَنْ  هِشَامٍ  عَنِ  الْحَسَنِ ،  عَنْ  جَابِرٍ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  بَيْنَ الرَّجُلِ أَوْ قَالَ بَيْنَ الْعَبْدِ  وَبَيْنَ الْكُفْرِ تَرْكُ الصَّلَاةِ  .","","Musnad Abi Ya'la al-Mawsili 2191","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الحسن البصري عن هشام بن عروة بن الزبير عن حماد بن أسامة القرشي عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","مسند جابر"
"2195","428 - (  2192  ) -  حَدَّثَنَا  سُفْيَانُ بْنُ وَكِيعٍ ،  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ قَالَ :  أَخْبَرَنِي  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  طُلِّقَتْ خَالَتِي ، فَأَرَادَتْ أَنْ تَجُدَّ نَخْلَهَا ،  فَزَجَرَهَا  رَجُلٌ  أَنْ تَخْرُجَ إِلَيْهِ ، فَأَتَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  بَلَى فَجُدِّي ذَلِكَ ، فَإِنَّكِ عَسَى أَنْ تَصَدَّقِي فَتَفْعَلِي مَعْرُوفًا  .         [4/138]","","Musnad Abi Ya'la al-Mawsili 2192","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن روح بن عبادة القيسي عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","مسند جابر"
"2196","429 - (  2193  ) -  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ قَالَ :  أَخْبَرَنِي  عَطَاءٌ ،  أَنَّهُ سَمِعَ  جَابِرَ بْنَ عَبْدِ اللهِ ، وَذَكَرَ  الْعَزْلَ  ، فَقَالَ :  قَدْ كُنَّا نَفْعَلُهُ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  .","","Musnad Abi Ya'la al-Mawsili 2193","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن ابن جريج عن روح بن عبادة القيسي عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","مسند جابر"
"2197","430 - (  2194  ) -  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  أَبِي الزُّبَيْرِ ،         [4/139]      عَنْ  جَابِرٍ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا  تَسُبُّوا  اللَّيْلَ وَالنَّهَارَ ، وَلَا الشَّمْسَ وَالْقَمَرَ  ، وَلَا الرِّيَاحَ ، فَإِنَّهَا تُرْسَلُ رَحْمَةً لِقَوْمٍ ، وَعَذَابًا لِقَوْمٍ  .","","Musnad Abi Ya'la al-Mawsili 2194","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن محمد بن عبد الرحمن بن أبي ليلى عن وكيع بن الجراح عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","مسند جابر"
"2198","431 - (  2195  ) -  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنَا  عَبْدُ الْوَهَّابِ الثَّقَفِيُّ ،  عَنْ  أَيُّوبَ ،  عَنْ  هِشَامٍ ،  عَنْ  وَهْبِ بْنِ كَيْسَانَ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ  أَحْيَا  أَرْضًا مَيْتَةً فَلَهُ فِيهَا أَجْرٌ  ، وَمَا أَكَلَتِ الْعَوَافِي فَهُوَ لَهُ صَدَقَةٌ  .","","Musnad Abi Ya'la al-Mawsili 2195","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن وهب بن كيسان القرشي عن هشام بن عروة بن الزبير عن أيوب السختياني عن عبد الوهاب بن عبد المجيد الثقفي عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","مسند جابر"
"2199","432 - (  2196  ) -  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  عَنِ  ابْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  سَلُوا اللهَ عِلْمًا نَافِعًا  ،         [4/140]      وَتَعَوَّذُوا بِاللهِ مِنْ عِلْمٍ لَا يَنْفَعُ  .","","Musnad Abi Ya'la al-Mawsili 2196","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن أسامة بن زيد الليثي المدني عن وكيع بن الجراح عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","مسند جابر"
"2200","433 - (  2197  ) -  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  أُسَامَةَ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ قَالَ :  مَرَّ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِقَوْمٍ يَقْرَؤُونَ الْقُرْآنَ فِي الْمَسْجِدِ ، فَقَالَ :  اقْرَؤُوا الْقُرْآنَ قَبْلَ أَنْ يَجِيءَ قَوْمٌ يُقِيمُونَهُ إِقَامَةَ الْقِدْحِ  ، يَتَعَجَّلُونَهُ وَلَا  يَتَأَجَّلُونَهُ  .","","Musnad Abi Ya'la al-Mawsili 2197","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن أسامة بن زيد الليثي المدني عن وكيع بن الجراح عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","مسند جابر"
"2201","434 - (  2198  ) -  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  سَعِيدِ بْنِ عُبَيْدٍ الْأَزْدِيِّ ،  حَدَّثَنَا  الْفَضْلُ الرَّقَاشِيُّ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ ، قَالَ :  قَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَطِيبًا يَوْمَ الْجُمُعَةِ ، فَقَالَ :  عَسَى رَجُلٌ تَحْضُرُهُ الْجُمُعَةُ ، وَهُوَ عَلَى قَدْرِ مِيلٍ مِنَ  الْمَدِينَةِ  فَلَا يَحْضُرُ الْجُمُعَةَ  ، قَالَ : ثُمَّ قَالَ فِي الثَّانِيَةِ : عَسَى رَجُلٌ تَحْضُرُهُ         [4/141]      الْجُمُعَةُ ، وَهُوَ عَلَى قَدْرِ مِيلَيْنِ مِنَ  الْمَدِينَةِ  فَلَا يَحْضُرُهَا ، وَقَالَ فِي الثَّالِثَةِ : عَسَى يَكُونُ عَلَى قَدْرِ ثَلَاثَةِ أَمْيَالٍ مِنَ  الْمَدِينَةِ  فَلَا يَحْضُرُ الْجُمُعَةَ وَيَطْبَعُ اللهُ عَلَى قَلْبِهِ  .","","Musnad Abi Ya'la al-Mawsili 2198","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن الفضل بن عيسى الواعظ عن سعيد بن عبيد الطائي عن وكيع بن الجراح عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","مسند جابر"
"2202","435 - (  2199  ) -  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُنْكَدِرِ ،  عَنِ  ابْنِ جُرَيْجٍ قَالَ :  أَخْبَرَنِي  أَبُو الزُّبَيْرِ ،         [4/142]      أَنَّهُ سَمِعَ  جَابِرَ بْنَ عَبْدِ اللهِ ، يُسْأَلُ عَنْ رُكُوبِ الْبُدْنِ ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  ارْكَبْهَا بِالْمَعْرُوفِ إِذَا أُلْجِئْتَ إِلَيْهَا حَتَّى تَجِدَ ظَهْرًا  .","","Musnad Abi Ya'la al-Mawsili 2199","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن محمد بن المنكدر عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","مسند جابر"
"2203","436 - (  2200  ) -  حَدَّثَنَا  وَاصِلُ بْنُ عَبْدِ الْأَعْلَى ،  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  عَنِ  الْوَلِيدِ بْنِ جُمَيْعٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  جَابِرٍ قَالَ :  قَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ يَوْمٍ عَلَى الْمِنْبَرِ ، فَقَالَ :  إِنَّهُ بَيْنَمَا أُنَاسٌ يَسِيرُونَ فِي الْبَحْرِ فَنَفَدَ طَعَامُهُمْ ، فَرُفِعَتْ لَهُمْ جَزِيرَةٌ ، فَخَرَجُوا يُرِيدُونَ الْخُبْزَ  ، فَلَقِيَتْهُمُ  الْجَسَّاسَةُ ،  قُلْتُ  لِأَبِي سَلَمَةَ  :  وَمَا  الْجَسَّاسَةُ  ؟ قَالَ : امْرَأَةٌ تَجُرُّ شَعَرَ رَأْسِهَا  ، قَالَتْ لَهُمْ : فِي هَذَا الْقَصْرِ خَبَرُ مَا تُرِيدُونَ ، فَأَتَوْهُ ، فَإِذَا هُمْ بِرَجُلٍ  مُوثَقٍ  ، فَقَالَ :  أَخْبِرُونِي ، أَوْ سَلُونِي أُخْبِرْكُمْ  ، فَسَكَتَ  الْقَوْمُ  ، فَقَالَ : أَخْبِرُونِي عَنْ نَخْلِ  بَيْسَانَ  وَأَرِيحِيَا  أَوْ  أَرِيحَا  أَأَطْعَمَ ؟ قَالُوا : نَعَمْ ، قَالَ : فَأَخْبِرُونِي عَنْ  حَمْأَةِ  زُغَرَ  هَلْ فِيهَا مَاءٌ ؟ قَالُوا : نَعَمْ ، قَالُوا : هُوَ  الْمَسِيحُ  تُطْوَى لَهُ الْأَرْضُ فَيَسْلُكُهَا فِي أَرْبَعِينَ يَوْمًا إِلَّا مَا كَانَ مِنْ طَيْبَةَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَلَا وَإِنَّ طَيْبَةَ هِيَ  الْمَدِينَةُ  ، مَا مِنْ بَابٍ مِنْ أَبْوَابِهَا إِلَّا مَلَكٌ صَالِتٌ سَيْفَهُ يَمْنَعُهُ مِنْهَا ،  وَبِمَكَّةَ  مِثْلُ ذَلِكَ ، ثُمَّ قَالَ : فِي  بَحْرِ فَارِسَ  مَا هُوَ ، فِي  بَحْرِ الرُّومِ  مَا هُوَ ، فَقَالَ لِي  أَبُو سَلَمَةَ  : إِنَّ فِي هَذَا الْحَدِيثِ شَيْئًا مَا حَفِظْتُ ، قَالَ : شَهِدَ  جَابِرُ بْنُ عَبْدِ اللهِ  أَنَّهُ  ابْنُ صَيَّادٍ  ، قُلْتُ : فَإِنَّهُ قَدْ مَاتَ ، قَالَ : وَإِنْ         [4/143]      مَاتَ ، قُلْتُ : فَإِنَّهُ أَسْلَمَ ، قَالَ : وَإِنْ أَسْلَمَ ، قُلْتُ : فَإِنَّهُ قَدْ دَخَلَ  الْمَدِينَةَ  ، قَالَ : وَإِنْ دَخَلَ  الْمَدِينَةَ  .","","Musnad Abi Ya'la al-Mawsili 2200","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو سلمة بن عبد الرحمن عن الوليد بن عبد الله بن جميع الخزاعي عن محمد بن فضيل بن غزوان عن واصل بن عبد الأعلى الأسدي عن أبو يعلى الموصلي","مسند جابر"
"2204","437 - (  2201  ) -  حَدَّثَنَا  الْحُسَيْنُ بْنُ يَزِيدَ الطَّحَّانُ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عُيَيْنَةَ ،  عَنْ  أَبِي طَالِبٍ ،  عَنْ  مُحَارِبٍ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  نِعْمَ  الْإِدَامُ  الْخَلُّ  ، وَكَفَى بِالْمَرْءِ شَرًّا أَنْ يَتَسَخَّطَ مَا قُرِّبَ إِلَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 2201","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محارب بن دثار عن يحيى بن يعقوب بن مدرك عن إبراهيم بن عيينة الهلالي عن الحسين بن يزيد بن يحيى الطحان عن أبو يعلى الموصلي","مسند جابر"
"2205","438 - (  2202  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَالِمٍ الْمَفْلُوجُ  ثِقَةٌ  ،  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ مُحَمَّدِ بْنِ عَلِيِّ بْنِ حُسَيْنٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  جَابِرٍ :  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  رَمَلَ  مِنَ  الْحَجَرِ  إِلَى  الْحَجَرِ  .","","Musnad Abi Ya'la al-Mawsili 2202","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن محمد بن جعفر ابن علي بن الحسين العلوي عن عبد الله بن سالم المفلوج عن أبو يعلى الموصلي","مسند جابر"
"2206","439 - (  2203  ) -  حَدَّثَنَا  سُفْيَانُ بْنُ وَكِيعٍ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  إِبْرَاهِيمَ بْنِ يَزِيدَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  كُنَّا فِي سَفَرٍ ، فَصَامَ  رَجُلٌ  فَغُشِيَ عَلَيْهِ ، فَوَقَفَ عَلَيْهِ أَصْحَابُهُ ، فَمَرَّ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالُوا : صَامَ ، قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَيْسَ         [4/144]      مِنَ  الْبِرِّ  الصَّوْمُ فِي السَّفَرِ  .","","Musnad Abi Ya'la al-Mawsili 2203","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن إبراهيم بن يزيد الخوزي عن وكيع بن الجراح عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","مسند جابر"
"2207","440 - (  2204  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَامِرِ بْنِ زُرَارَةَ ،  حَدَّثَنَا  ابْنُ أَبِي زَائِدَةَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  ارْكَبْهَا بِالْمَعْرُوفِ إِذَا أُلْجِئْتَ إِلَيْهَا حَتَّى تَجِدَ ظَهْرًا  -  يَعْنِي بِهِ : الْبَدَنَةَ  .","","Musnad Abi Ya'la al-Mawsili 2204","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن يحيى بن زكريا بن أبي زائدة عن عبد الله بن عامر بن زرارة الحضرمي عن أبو يعلى الموصلي","مسند جابر"
"2208","441 - (  2205  ) -  حَدَّثَنَا  جُبَارَةُ بْنُ مُغَلِّسٍ ،  حَدَّثَنَا  أَبُو بَكْرٍ النَّهْشَلِيُّ ،  حَدَّثَنَا  الْهَيْثَمُ بْنُ أَبِي الْهَيْثَمِ ،  عَنْ  جَابِرٍ :  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  احْتَجَمَ فِي  الْأَخْدَعَيْنِ  ، وَبَيْنَ الْكَتِفَيْنِ  ، وَأَعْطَى الْحَجَّامَ أَجْرَهُ ، وَلَوْ كَانَ حَرَامًا لَمْ يُعْطِهِ  .         [4/145]","","Musnad Abi Ya'la al-Mawsili 2205","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الهيثم بن حبيب عن أبو بكر النهشلي عن جبارة بن المغلس عن أبو يعلى الموصلي","مسند جابر"
"2209","442 - (  2206  ) -  حَدَّثَنَا  مَسْرُوقُ بْنُ الْمَرْزُبَانِ ،  حَدَّثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبَّادِ بْنِ جَعْفَرٍ ،  عَنْ  جَابِرٍ قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ صِيَامِ يَوْمِ الْجُمُعَةِ مُفْرَدًا  .","","Musnad Abi Ya'la al-Mawsili 2206","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن عباد بن جعفر المخزومي عن ابن جريج عن حفص بن غياث النخعي عن مسروق بن المرزبان الكندي عن أبو يعلى الموصلي","مسند جابر"
"2210","443 - (  2207  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ  حَدَّثَنَا  أَشْعَثُ ،  عَنْ  أَبِي الزُّبَيْرِ الْمَكِّيِّ قَالَ :  سَأَلْتُ  جَابِرَ بْنَ عَبْدِ اللهِ عَنِ الْحِنْطَةِ بِالتَّمْرِ وَفَضْلٍ يَدًا بِيَدٍ ، فَقَالَ :  قَدْ كُنَّا عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَشْتَرِي الصَّاعَ الْحِنْطَةَ بِسِتَّةِ         [4/146]      آصُعٍ مِنْ تَمْرٍ يَدًا بِيَدٍ  فَإِنْ كَانَ نَوْعًا وَاحِدًا فَلَا خَيْرَ فِيهِ إِلَّا مِثْلًا بِمِثْلٍ  .","","Musnad Abi Ya'la al-Mawsili 2207","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن أشعث بن سوار عن عبد الرحيم بن سليمان الأشل عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند جابر"
"2211","444 - (  2208  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  سَعِيدٍ الْجُرَيْرِيِّ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  جَابِرٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ فِي سَفَرٍ فِي رَمَضَانَ ، فَأَتَى هُوَ وَأَصْحَابُهُ عَلَى غَدِيرٍ ، فَقَالَ لِلْقَوْمِ : اشْرَبُوا ، قَالُوا : نَشْرَبُ وَلَا تَشْرَبُ ؟ فَقَالَ :  إِنِّي أَيْسَرُكُمْ إِنِّي رَاكِبٌ ، فَنَزَلَ فَشَرِبَ وَشَرِبُوا  .","","Musnad Abi Ya'la al-Mawsili 2208","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن المنذر بن مالك العوقي عن سعيد بن إياس الجريري عن حماد بن أسامة القرشي عن عبد الأعلى بن واصل الأسدي عن أبو يعلى الموصلي","مسند جابر"
"2212","445 - (  2209  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرٍ قَالَ :  لَمَّا قَدِمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  مَكَّةَ  ، أَتَاهُ أَصْحَابُ         [4/147]      الصَّلِيبِ الَّذِي يَجْمَعُونَ الْأَوْدَاكَ ، فَقَالُوا : يَا رَسُولَ اللهِ إِنَّا نَجْمَعُ هَذِهِ الْأَوْدَاكَ مِنَ الْمَيْتَةِ وَغَيْرِهَا ، وَإِنَّمَا هِيَ لِلْأُدُمِ وَالسُّفُنِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قَاتَلَ  اللهُ الْيَهُودَ ، حُرِّمَتْ عَلَيْهِمُ  الشُّحُومُ  فَبَاعُوهَا وَأَكَلُوا أَثْمَانَهَا ، فَنَهَاهُمْ عَنْ ذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 2209","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن محمد بن إسحاق عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2213","446 - (  2210  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  سُفْيَانُ بْنُ حُسَيْنٍ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ  عَالَ  ثَلَاثًا مِنْ بَنَاتٍ يَكْفِيهِنَّ وَيَرْحَمُهُنَّ وَيَرْفُقُ بِهِنَّ ، فَهُوَ فِي الْجَنَّةِ  ، فَقَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، وَاثْنَتَيْنِ ؟ قَالَ : وَاثْنَتَيْنِ ، حَتَّى قُلْنَا : إِنَّ إِنْسَانًا لَوْ قَالَ : وَاحِدَةً لَقَالَ : وَاحِدَةً  .","","Musnad Abi Ya'la al-Mawsili 2210","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن سفيان بن حسين المعلم عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2214","447 - (  2211  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،         [4/148]      حَدَّثَنَا  الْمُثَنَّى بْنُ سَعِيدٍ الْقَسَّامُ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  أَخَذَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ يَوْمٍ بِيَدِي حَتَّى أَتَى بَعْضَ حُجَرِ نِسَائِهِ فَدَخَلَ ، ثُمَّ أَذِنَ لِي فَدَخَلْتُ ، فَقَالَ :  هَلْ مِنْ غَدَاءٍ ، أَوْ هَلْ مِنْ عَشَاءٍ ؟  فَقَالُوا : نَعَمْ ، فَأُتِيَ بِثَلَاثَةِ أَقْرِصَةٍ ، فَقَالَ : هَلْ مِنْ أُدُمٍ ؟ فَقَالُوا : لَا ، إِلَّا شَيْئًا مِنْ خَلٍّ قَالَ : هَاتُوهُ ،  فَنِعْمَ  الْإِدَامُ  الْخَلُّ  .  قَالَ  جَابِرٌ  : فَمَا زِلْتُ أُحِبُّهُ مُذْ سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ فِيهِ .  قَالَ  أَبُو سُفْيَانَ  :  وَمَا زِلْتُ أُحِبُّهُ مُذْ سَمِعْتُ  جَابِرًا  يَقُولُ مَا يَقُولُ  .","","Musnad Abi Ya'la al-Mawsili 2211","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن المثنى بن سعيد القسام عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2215","448 - (  2212  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ ،  أَخْبَرَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَطَاءٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ جَابِرِ بْنِ عَتِيكٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا حَدَّثَ الرَّجُلُ  الْقَوْمَ  ثُمَّ الْتَفَتَ فَهِيَ أَمَانَةٌ  .         [4/149]","","Musnad Abi Ya'la al-Mawsili 2212","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الملك بن جابر بن عتيك الأنصاري عن عبد الرحمن بن عطاء الذارع عن محمد بن عبد الرحمن بن المغيرة عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2216","449 - (  2213  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا مِنْ مُسْلِمٍ يَغْرِسُ غَرْسًا إِلَّا كَانَ لَهُ صَدَقَةً  : مَا أُكِلَ مِنْهُ ، وَمَا سُرِقَ مِنْهُ ، وَمَا أَكَلَتِ الطَّيْرُ مِنْهُ ، وَمَا أَكَلَتِ الْوَحْشُ مِنْهُ  .         [4/150]","","Musnad Abi Ya'la al-Mawsili 2213","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2217","450 - (  2214  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  دَاوُدُ بْنُ أَبِي هِنْدَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْعُمْرَى  جَائِزَةٌ لِمَنْ أُعْمِرَهَا  ، وَالرُّقْبَى جَائِزَةٌ لِمَنْ أُرْقِبَهَا  .","","Musnad Abi Ya'la al-Mawsili 2214","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن داود بن أبي هند عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2218","451 - (  2215  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  الْعَوَّامُ بْنُ حَوْشَبٍ قَالَ :  حَدَّثَنِي  طَلْحَةُ بْنُ نَافِعٍ ،  عَنْ  جَابِرٍ قَالَ :  مَرَّ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  رَجُلٌ  ، فَقَالُوا فِيهِ وَأَثْنَوْا عَلَيْهِ فَقَالَ : مَنْ يَقْتُلُهُ ؟ قَالَ  أَبُو بَكْرٍ  : أَنَا ، فَانْطَلَقَ فَوَجَدَهُ قَدْ خَطَّ عَلَى نَفْسِهِ خِطَّةً فَهُوَ قَائِمٌ يُصَلِّي فِيهَا ، فَلَمَّا رَآهُ عَلَى ذَلِكَ الْحَالِ رَجَعَ وَلَمْ يَقْتُلْهُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : مَنْ يَقْتُلُهُ ؟ فَقَالَ  عُمَرُ  : أَنَا ، فَذَهَبَ فَرَآهُ يُصَلِّي فِي خِطَّةٍ قَائِمًا يُصَلِّي فَرَجَعَ وَلَمْ يَقْتُلْهُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ لَهُ ، أَوْ مَنْ يَقْتُلُهُ ؟  فَقَالَ  عَلِيٌّ  : أَنَا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَنْتَ وَلَا أَرَاكَ تُدْرِكُهُ ، فَانْطَلَقَ فَوَجَدَهُ قَدْ ذَهَبَ  .         [4/151]","","Musnad Abi Ya'la al-Mawsili 2215","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن العوام بن حوشب عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2219","452 - (  2216  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  يَحْيَى بْنُ سَعِيدٍ ، أَنَّ شُرَحْبِيلَ بْنَ سَعْدٍ ،  أَخْبَرَهُ  ،  عَنْ  جَابِرٍ قَالَ :  أَقْبَلْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  زَمَنَ الْحُدَيْبِيَةِ  فَنَزَلْنَا بِالسُّقْيَا ، فَقَالَ  مُعَاذُ بْنُ جَبَلٍ  : مَنْ يَسْقِينَا فِي أَسْقِيَتِنَا ؟ قَالَ  جَابِرٌ  : فَقُلْتُ : أَنَا ، فَخَرَجْتُ فِي فِتْيَةٍ مَعِي حَتَّى أَتَيْنَا الْمَاءَ الَّذِي بِالْأُثَايَةِ وَبَيْنَهُمَا قَرِيبًا مِنْ ثَلَاثَةٍ وَعِشْرِينَ مِيلًا ، قَالَ : فَأَتَيْنَا الْمَاءَ الَّذِي بِالْأُثَايَةِ فَسَقَيْنَا فِي حَوْضِنَا وَسَقَيْنَا فِي أَسْقِيَتِنَا حَتَّى إِذَا كَانَ بَعْدَ عَتَمَةٍ إِذَا أَنَا بِرَجُلٍ  يُنَازِعُهُ  بَعِيرُهُ عَلَى الْحَوْضِ ، فَقَالَ :  أَوْرِدُوا ، وَإِذَا هُوَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَوْرَدَ وَأَخَذَ بِزِمَامِ رَاحِلَتِهِ  ، فَقَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَصَلَّى الْعِشَاءَ ،  وَجَابِرٌ  فِيمَا ذَكَرَ إِلَى جَنْبِهِ ، ثُمَّ صَلَّى بَعْدَ الْعِشَاءِ ثَلَاثَ عَشْرَةَ رَكْعَةً  .         [4/152]","","Musnad Abi Ya'la al-Mawsili 2216","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن شرحبيل بن سعد الخطمي عن يحيى بن سعيد الأنصاري عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2220","453 - (  2217  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  سُلَيْمَانُ التَّيْمِيُّ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَا مِنْكُمْ مِنْ نَفْسٍ  مَنْفُوسَةٍ  يَأْتِي عَلَيْهَا مِائَةُ سَنَةٍ وَهِيَ حَيَّةٌ  .","","Musnad Abi Ya'la al-Mawsili 2217","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن المنذر بن مالك العوقي عن سليمان بن طرخان عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2221","454 - (  2218  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  الْحَجَّاجُ بْنُ أَبِي زَيْنَبَ ،  حَدَّثَنَا  أَبُو سُفْيَانَ طَلْحَةُ بْنُ نَافِعٍ قَالَ :  سَمِعْتُ  جَابِرَ بْنَ عَبْدِ اللهِ قَالَ :  كُنْتُ جَالِسًا فِي دَارِي فَمَرَّ بِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَشَارَ إِلَيَّ فَقُمْتُ إِلَيْهِ ، فَأَخَذَ بِيَدِي فَانْطَلَقْنَا حَتَّى أَتَى بَعْضَ حُجَرِ نِسَائِهِ فَدَخَلَ ، ثُمَّ أَذِنَ لِي فَدَخَلْتُ ، وَالْحِجَابُ عَلَيْهَا ، فَقَالَ : هَلْ مِنْ غَدَاءٍ ؟ فَقَالُوا : نَعَمْ ، فَأُتِيَ بِثَلَاثَةِ أَقْرَاصٍ فَوَضَعَهُنَّ ، فَأَخَذَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قُرْصَةً فَوَضَعَهُ بَيْنَ يَدَيْهِ ، وَأَخَذَ قُرْصَةً آخَرَ فَوَضَعَهُ بَيْنَ يَدَيَّ ، ثُمَّ أَخَذَ الثَّالِثَ فَكَسَرَهُ         [4/153]      بَابَتَيْنِ فَجَعَلَ نِصْفَهُ بَيْنَ يَدَيْهِ وَنِصْفَهُ بَيْنَ يَدَيَّ ، ثُمَّ قَالَ : هَلْ مِنْ أُدُمٍ ؟ قَالُوا : لَا ، إِلَّا شَيْئًا مِنْ خَلٍّ ، قَالَ : هَاتُوا ،  فَنِعْمَ الْأُدُمُ هُوَ  .","","Musnad Abi Ya'la al-Mawsili 2218","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن حجاج  بن أبي زينب الصيقل عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2222","455 - (  2219  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  هِشَامٌ ،  عَنِ  الْحَسَنِ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا كُنْتُمْ فِي الْخِصْبِ فَأَمْكِنُوا  الرَّكْبَ  أَسِنَّتَهَا  ، وَلَا تَعْدُوا الْمَنَازِلَ وَإِذَا كُنْتُمْ فِي الْجَدْبِ  فَاسْتَنْجُوا  ، وَعَلَيْكُمْ  بِالدُّلْجَةِ  ، فَإِنَّ الْأَرْضَ  تُطْوَى  بِاللَّيْلِ ، فَإِذَا  تَغَوَّلَتْ  لَكُمُ الْغِيلَانُ فَبَادِرُوا بِالْأَذَانِ ، وَلَا تُصَلُّوا عَلَى  جَوَادِّ  الطَّرِيقِ ، وَلَا تَنْزِلُوا عَلَيْهَا فَإِنَّهَا مَأْوَى الْحَيَّاتِ وَالسِّبَاعِ ، وَلَا تَقْضُوا عَلَيْهَا الْحَوَائِجَ فَإِنَّهَا  الْمَلَاعِنُ  .         [4/154]","","Musnad Abi Ya'la al-Mawsili 2219","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الحسن البصري عن هشام بن حسان العتكي عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2223","456 - (  2220  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ ،  أَخْبَرَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،         [4/155]      عَنْ  جَابِرٍ قَالَ :  جَاءَ  رَجُلٌ  بِبَيْضَةٍ مِنْ ذَهَبٍ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَصَابَهَا فِي بَعْضِ الْمَغَازِي ، فَقَالَ : خُذْهَا يَا رَسُولَ اللهِ صَدَقَةً ، فَوَاللهِ مَا أَصْبَحْتُ أَمْلِكُ غَيْرَهَا ، فَأَعْرَضَ عَنْهُ ، ثُمَّ أَتَاهُ عَنْ شِمَالِهِ فَقَالَ مِثْلَ ذَلِكَ ، ثُمَّ أَتَاهُ مِنْ بَيْنِ يَدَيْهِ فَقَالَ مِثْلَ ذَلِكَ ، فَقَالَ : هَاتِهَا ، مُغْضَبًا ، فَأَخَذَهَا فَخَذَفَهُ بِهَا خَذْفَةً لَوْ أَصَابَهُ  لَشَجَّهُ  أَوْ عَقَرَهُ  ، ثُمَّ قَالَ :  يَأْتِي أَحَدُكُمْ بِمَالِهِ كُلِّهِ فَيَتَصَدَّقُ بِهِ ثُمَّ يَجْلِسُ  فَيَتَكَفَّفُ  النَّاسَ ، أَلَا إِنَّهُ لَا صَدَقَةَ إِلَّا عَنْ  ظَهْرِ  غِنًى  .","","Musnad Abi Ya'la al-Mawsili 2220","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن محمد بن إسحاق عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2224","457 - (  2221  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ ،  أَخْبَرَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا سَمِعْتُمْ نُبَاحَ الْكِلَابِ وَنَهِيقَ الْحُمُرِ فَتَعَوَّذُوا بِاللهِ مِنَ الشَّيْطَانِ  ، فَإِنَّهُنَّ يَرَوْنَ مَا لَا تَرَوْنَ ، وَأَقِلُّوا الْخُرُوجَ إِذَا هَدَأَتِ الرِّجْلُ ، فَإِنَّ اللهَ يَبُثُّ فِي خَلْقِهِ فِي لَيْلِهِ مَا شَاءَ ،  وَأَجِيفُوا  الْأَبْوَابَ فَإِنَّ الشَّيْطَانَ لَا يَفْتَحُ بَابًا إِذَا أُجِيفَ ، وَأَوْكُوا الْأَسْقِيَةَ ،  وَخَمِّرُوا  الْآنِيَةَ ، وَأَطْفِئُوا السُّرُجَ  .         [4/156]","","Musnad Abi Ya'la al-Mawsili 2221","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن يسار الهلالي عن محمد بن إبراهيم بن الحارث التيمي عن محمد بن إسحاق عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2225","458 - (  2222  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ ،  أَخْبَرَنَا  الْحَجَّاجُ ،  عَنْ  عَطَاءٍ ،  وَعَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  وَقَّتَ  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِأَهْلِ الْمَدِينَةِ  مِنْ  ذِي الْحُلَيْفَةِ  ،  وَلِأَهْلِ الشَّامِ  الْجُحْفَةَ  ،  وَلِأَهْلِ الْيَمَنِ  أَلَمْلَمَ  ،         [4/157]      وَلِأَهْلِ طَائِفٍ  قَرْنَ  ،  وَلِأَهْلِ الْعِرَاقِ  ذَاتَ عِرْقٍ  .         [4/158]","","Musnad Abi Ya'la al-Mawsili 2222","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن حجاج بن أرطاة عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2226","459 - (  2223  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ ،  أَخْبَرَنَا  الْحَجَّاجُ بْنُ أَرْطَاةَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  فِي الْحَيَوَانِ اثْنَانِ بِوَاحِدٍ لَا بَأْسَ بِهِ  ، وَلَا يَصْلُحُ  نَسِيئَةً  .","","Musnad Abi Ya'la al-Mawsili 2223","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حجاج بن أرطاة عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2227","460 - (  2224  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  حَبِيبٍ الْمُعَلِّمِ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرٍ ،  أَنَّ  رَجُلًا  نَذَرَ أَنْ يُصَلِّيَ فِي  بَيْتِ الْمَقْدِسِ  ، فَسَأَلَ عَنْ ذَلِكَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ لَهُ :  صَلِّ هَاهُنَا  ، يَعْنِي  الْمَسْجِدَ الْحَرَامَ  ، قَالَ : يَا رَسُولَ اللهِ ، إِنِّي إِنَّمَا نَذَرْتُ أَنْ أُصَلِّيَ فِي  بَيْتِ الْمَقْدِسِ  ، قَالَ : صَلِّ هَاهُنَا ، قَالَ :  وَأَظُنُّهُ قَالَ فِي الثَّالِثَةِ : صَلِّ حَيْثُ قُلْتَ  .         [4/159]","","Musnad Abi Ya'la al-Mawsili 2224","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن حبيب المعلم مولى معقل بن يسار عن حماد بن سلمة عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2228","461 - (  2225  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  الْوَلِيدُ قَالَ :  حَدَّثَنِي  أَبُو عَمْرٍو الْأَوْزَاعِيُّ قَالَ :  سَمِعْتُ  يَحْيَى ، يَقُولُ :  سَأَلْتُ  أَبَا سَلَمَةَ ، أَيُّ الْقُرْآنِ أُنْزِلَ قَبْلُ ؟ فَقَالَ :         {      يَا أَيُّهَا الْمُدَّثِّرُ         }      فَقُلْتُ : أَوِ         {      اقْرَأْ         }      .  فَقَالَ جَابِرٌ :  أُحَدِّثُكُمْ  مَا حَدَّثَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  جَاوَرْتُ  بِحِرَاءٍ  شَهْرًا فَلَمَّا قَضَيْتُ جِوَارِي ، نَزَلْتُ فَاسْتَبْطَنْتُ الْوَادِي ، فَنُودِيتُ  ، فَنَظَرْتُ أَمَامِي وَخَلْفِي ، وَعَنْ يَمِينِي وَعَنْ شِمَالِي ، فَلَمْ أَرَ أَحَدًا ، ثُمَّ نُودِيتُ فَنَظَرْتُ فَلَمْ أَرَ أَحَدًا ، ثُمَّ نُودِيتُ فَنَظَرْتُ فَلَمْ أَرَ أَحَدًا ، فَرَفَعْتُ رَأْسِي فَإِذَا هُوَ عَلَى الْعَرْشِ فِي الْهَوَاءِ يَعْنِي  جِبْرِيلَ  ، فَأَخَذَتْنِي رَجْفَةٌ شَدِيدَةٌ ، فَأَتَيْتُ  خَدِيجَةَ  ، فَقُلْتُ :  دَثِّرُونِي  ،  فَدَثَّرُونِي  وَصَبُّوا عَلَيَّ الْمَاءَ ، فَأَنْزَلَ اللهُ :         {      يَا أَيُّهَا الْمُدَّثِّرُ             *          قُمْ فَأَنْذِرْ             *          وَرَبَّكَ فَكَبِّرْ             *          وَثِيَابَكَ فَطَهِّرْ         }      .","","Musnad Abi Ya'la al-Mawsili 2225","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2229","462 - (  2226  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سَعِيدُ بْنُ عَامِرٍ ،  حَدَّثَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الْبَصَلِ وَالْكُرَّاثِ قَالَ : فَغَلَبَتْنَا الْحَاجَةُ ، فَأَكَلْنَا مِنْهَا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَكَلَ مِنْ هَذِهِ الشَّجَرَةِ  الْخَبِيثَةِ ،  فَلَا يَقْرَبَنَّ مَسْجِدَنَا  ، فَإِنَّ الْمَلَائِكَةَ         [4/160]      تَأَذَّى بِمَا يَتَأَذَّى بِهِ  الْإِنْسُ أَوْ قَالَ : بَنُو آدَمَ  .","","Musnad Abi Ya'la al-Mawsili 2226","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن هشام الدستوائي عن سعيد بن عامر الضبعي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2230","463 - (  2227  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سَعِيدُ بْنُ عَامِرٍ ،  عَنْ  شُعْبَةَ ،  عَنْ  مُخَوَّلٍ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا اغْتَسَلَ أَفْرَغَ عَلَى رَأْسِهِ ثَلَاثًا  ، فَقَالَ  رَجُلٌ مِنْ بَنِي هَاشِمٍ  : إِنَّ شَعَرِي كَثِيرٌ ، فَقَالَ : كَانَ شَعَرُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَكْثَرَ مِنْ شَعَرِكَ وَأَطْيَبَ  .","","Musnad Abi Ya'la al-Mawsili 2227","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن مخول بن راشد النهدي عن شعبة بن الحجاج عن سعيد بن عامر الضبعي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2231","464 - (  2228  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ قَالَ :  أَخْبَرَنِي  أَبُو الزُّبَيْرِ ،  أَنَّهُ سَمِعَ  جَابِرَ بْنَ عَبْدِ اللهِ ، يَقُولُ :  كَتَبَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى كُلِّ  بَطْنٍ  عُقُولَهُ  ، ثُمَّ كَتَبَ أَنَّهُ لَا يَحِلُّ أَنْ يَتَوَلَّى مَوْلَى رَجُلٍ مُسْلِمٍ بِغَيْرِ إِذْنِهِ  .         [4/161]","","Musnad Abi Ya'la al-Mawsili 2228","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2232","465 - (  2229  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ قَالَ :  أَخْبَرَنِي  أَبُو الزُّبَيْرِ ،  أَنَّهُ سَمِعَ  جَابِرًا يَقُولُ :  كُنَّا نَبِيعُ سَرَارِيَّنَا أُمَّهَاتِ الْأَوْلَادِ ، وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَيٌّ فِينَا لَا يَرَى بِذَلِكَ بَأْسًا  .","","Musnad Abi Ya'la al-Mawsili 2229","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2233","466 - (  2230  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  زَكَرِيَّا ، وَهِشَامُ بْنُ أَبِي عَبْدِ اللهِ قَالَا :  أَخْبَرَنَا  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  بَعَثَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِحَاجَةٍ ، فَرَجَعْتُ وَهُوَ عَلَى         [4/162]      رَاحِلَتِهِ ، فَسَلَّمْتُ عَلَيْهِ فَلَمْ يَرُدَّ عَلَيَّ شَيْئًا ، وَزَادَ  زَكَرِيَّا  : ثُمَّ سَلَّمْتُ عَلَيْهِ فَلَمْ يَرُدَّ عَلَيَّ شَيْئًا ، ثُمَّ اتَّفَقَ حَدِيثُهُمَا بَعْدُ ، فَرَأَيْتُهُ يَرْفَعُ وَيَسْجُدُ فَتَنَحَّيْتُ عَنْهُ ، ثُمَّ قَالَ : مَا صَنَعْتَ فِي حَاجَتِكَ ؟ فَقُلْتُ : صَنَعْتُ كَذَا وَكَذَا ، فَقَالَ : مَا مَنَعَنِي أَنْ أَرُدَّ عَلَيْكَ إِلَّا أَنِّي كُنْتُ أُصَلِّي ، وَزَادَ  زَكَرِيَّا  ، فَلَمَّا قَضَى صَلَاتَهُ نَادَانِي ، فَرَدَّ عَلَيَّ السَّلَامَ ، وَقَالَ :  إِنِّي كُنْتُ أُصَلِّي  .         [4/163]","","Musnad Abi Ya'la al-Mawsili 2230","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن هشام الدستوائي عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2234","467 - (  2231  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ قَالَ :  أَخْبَرَنِي  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يُقْتَلَ شَيْءٌ مِنَ الدَّوَابِّ  صَبْرًا  .","","Musnad Abi Ya'la al-Mawsili 2231","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2235","468 - (  2232  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  أَيْمَنُ بْنُ نَابِلٍ قَالَ :  سَمِعْتُ  أَبَا الزُّبَيْرِ ،  يُحَدِّثُ عَنْ  جَابِرٍ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُعَلِّمُنَا  التَّشَهُّدَ  كَمَا يُعَلِّمُنَا السُّورَةَ مِنَ الْقُرْآنِ :  بِسْمِ اللهِ ،  التَّحِيَّاتُ  وَالصَّلَوَاتُ  وَالطَّيِّبَاتُ  لِلهِ ، السَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ  ، السَّلَامُ عَلَيْنَا وَعَلَى عِبَادِ اللهِ الصَّالِحِينَ ، أَسْأَلُ اللهَ الْجَنَّةَ ، وَأَعُوذُ بِاللهِ مِنَ النَّارِ  .         [4/164]             [4/165]","","Musnad Abi Ya'la al-Mawsili 2232","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن أيمن بن نابل عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2236","469 - (  2233  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  حَجَّاجٌ الصَّوَّافُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ قَالَ : سُبْحَانَ اللهِ الْعَظِيمِ وَبِحَمْدِهِ ، غُرِسَتْ لَهُ نَخْلَةٌ فِي الْجَنَّةِ  .","","Musnad Abi Ya'la al-Mawsili 2233","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حجاج بن أبى عثمان الصواف الكندي عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2237","470 - (  2234  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  زَكَرِيَّا بْنُ إِسْحَاقَ ،  حَدَّثَنَا  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا وَلِيَ أَحَدُكُمْ أَخَاهُ فَلْيُحْسِنْ  كَفَنَهُ  .         [4/166]","","Musnad Abi Ya'la al-Mawsili 2234","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زكريا بن إسحاق المكي عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2238","471 - (  2235  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ قَالَ :  أَخْبَرَنِي  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الْوَسْمِ فِي الْوَجْهِ ، وَالضَّرْبِ فِي الْوَجْهِ  .","","Musnad Abi Ya'la al-Mawsili 2235","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2239","472 - (  2236  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  حُسَيْنٌ الْمُعَلِّمُ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرٍ ،  أَنَّ  رَجُلًا  أَعْتَقَ غُلَامًا لَهُ عَنْ  دُبُرٍ  مِنْهُ ، وَأَنَّ الرَّجُلَ احْتَاجَ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ يَشْتَرِيهِ مِنِّي ؟ فَاشْتَرَاهُ  نُعَيْمُ بْنُ عَبْدِ اللهِ  ، فَأَخَذَ ثَمَنَهُ فَدَفَعَهُ إِلَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 2236","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن حسين المعلم عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2240","473 - (  2237  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا         [4/167]      ابْنُ جُرَيْجٍ قَالَ :  أَخْبَرَنِي  أَبُو الزُّبَيْرِ ،  أَنَّهُ سَمِعَ  جَابِرًا ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لِكُلِّ نَبِيٍّ دَعْوَةٌ قَدْ دَعَا بِهَا فِي أُمَّتِهِ ، وَخَبَّأْتُ دَعْوَتِي شَفَاعَةً لِأُمَّتِي يَوْمَ الْقِيَامَةِ  .","","Musnad Abi Ya'la al-Mawsili 2237","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2241","474 - (  2238  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ قَالَ :  قَالَ  عَطَاءٌ ،  سَمِعْتُ  جَابِرًا يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَجْمَعُوا بَيْنَ الرُّطَبِ وَالْبُسْرِ  ، وَبَيْنَ الزَّبِيبِ وَالتَّمْرِ  .","","Musnad Abi Ya'la al-Mawsili 2238","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن ابن جريج عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2242","475 - (  2239  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  زَكَرِيَّا بْنُ إِسْحَاقَ ،  حَدَّثَنَا  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  غَزَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِحْدَى وَعِشْرِينَ غَزْوَةً  .         [4/168]","","Musnad Abi Ya'la al-Mawsili 2239","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زكريا بن إسحاق المكي عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2243","476 - (  2240  ) -  قَالَ  أَبُو الزُّبَيْرِ  قَالَ  جَابِرٌ :  شَهِدْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ الْعَقَبَةِ  .","","Musnad Abi Ya'la al-Mawsili 2240","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زكريا بن إسحاق المكي عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2244","477 - (  2241  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  زَكَرِيَّا ،  حَدَّثَنَا  أَبُو الزُّبَيْرِ ،  أَنَّهُ سَمِعَ  جَابِرًا  يَقُولُ :  غَزَوْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تِسْعَ عَشْرَةَ غَزْوَةً  ، قَالَ جَابِرٌ : لَمْ أَشْهَدْ  بَدْرًا  وَلَا  أُحُدًا  ، مَنَعَنِي أَبِي ، قَالَ : فَلَمَّا قُتِلَ  عَبْدُ اللهِ  يَوْمَ أُحُدٍ  لَمْ  أَتَخَلَّفْ  عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي غَزْوَةٍ قَطُّ  .","","Musnad Abi Ya'la al-Mawsili 2241","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زكريا بن إسحاق المكي عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2245","478 - (  2242  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  زَكَرِيَّا بْنُ إِسْحَاقَ ،  حَدَّثَنَا  أَبُو الزُّبَيْرِ ،  أَنَّهُ سَمِعَ  جَابِرَ بْنَ عَبْدِ اللهِ يَقُولُ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يُتَمَسَّحَ بِعَظْمٍ أَوْ بِبَعْرٍ  .         [4/169]","","Musnad Abi Ya'la al-Mawsili 2242","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زكريا بن إسحاق المكي عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2246","479 - (  2243  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  زَكَرِيَّا ،  حَدَّثَنَا  عَمْرُو بْنُ دِينَارٍ قَالَ :  سَمِعْتُ  جَابِرَ بْنَ عَبْدِ اللهِ يُحَدِّثُ :  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَنْقُلُ مَعَهُمُ الْحِجَارَةَ  لِلْكَعْبَةِ  وَعَلَيْهِ إِزَارُهُ  ، فَقَالَ لَهُ  الْعَبَّاسُ  عَمُّهُ : يَا ابْنَ أَخِي ، لَوْ حَلَلْتَ إِزَارَكَ فَجَعَلْتَهُ عَلَى مَنْكِبِكَ دُونَ الْحِجَارَةِ ؟ قَالَ : فَحَلَّهُ فَجَعَلَهُ عَلَى مَنْكِبِهِ قَالَ : فَسَقَطَ مَغْشِيًّا ، قَالَ : فَمَا رُئِيَ بَعْدَ ذَلِكَ الْيَوْمِ عُرْيَانًا  .","","Musnad Abi Ya'la al-Mawsili 2243","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن زكريا بن إسحاق المكي عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2247","480 - (  2244  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ،  أَخْبَرَنَا  أَبُو الزُّبَيْرِ ،  أَنَّهُ سَمِعَ  جَابِرَ بْنَ عَبْدِ اللهِ يَزْعُمُ : أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ الصُّوَرِ فِي الْبَيْتِ  ، وَنَهَى الرَّجُلَ أَنْ يَصْنَعَ ذَلِكَ  .         [4/170]","","Musnad Abi Ya'la al-Mawsili 2244","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2248","481 - (  2245  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ قَالَ :  أَخْبَرَنِي  أَبُو الزُّبَيْرِ ،  أَنَّهُ سَمِعَ  جَابِرًا يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا يَغْرِسُ رَجُلٌ مُسْلِمٌ غِرَاسًا وَلَا زَرْعًا فَيَأْكُلُ مِنْهُ سَبُعٌ أَوْ طَائِرٌ أَوْ شَيْءٌ إِلَّا كَانَ لَهُ فِيهِ أَجْرٌ  .","","Musnad Abi Ya'la al-Mawsili 2245","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2249","482 - (  2246  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ قَالَ :  أَخْبَرَنِي  أَبُو الزُّبَيْرِ ،  أَنَّهُ سَمِعَ  جَابِرًا ، أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا يَمْسَحْ أَحَدُكُمْ بِالْمِنْدِيلِ حَتَّى يَلْعَقَ يَدَهُ ، إِنَّهُ لَا يَدْرِي فِي أَيِّ طَعَامِهِ يُبَارَكُ لَهُ  ، وَإِنَّ الشَّيْطَانَ يَرْصُدُ النَّاسَ عِنْدَ كُلِّ شَيْءٍ حَتَّى عِنْدَ طَعَامِهِمْ ، وَلَا يَرْفَعِ الْقَصْعَةَ حَتَّى يَلْعَقَهَا ، فَإِنَّ آخِرَ الطَّعَامِ فِيهِ الْبَرَكَةُ  .         [4/171]","","Musnad Abi Ya'la al-Mawsili 2246","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2250","483 - (  2247  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ قَالَ :  أَخْبَرَنِي  أَبُو الزُّبَيْرِ ،  أَنَّهُ سَمِعَ  جَابِرًا ، أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا طَعِمَ أَحَدُكُمْ فَسَقَطَتْ لُقْمَتُهُ مِنْ يَدِهِ ،  فَلْيُمِطْ  مَا أَرَابَهُ ، ثُمَّ لِيَطْعَمْهَا  ، وَلَا يَدَعْهَا لِلشَّيْطَانِ ، فَإِنَّ الرَّجُلَ لَا يَدْرِي فِي أَيِّ طَعَامِهِ يُبَارَكُ لَهُ فِيهِ  .","","Musnad Abi Ya'la al-Mawsili 2247","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2251","484 - (  2248  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  زَكَرِيَّا بْنُ إِسْحَاقَ ،  حَدَّثَنَا  أَبُو الزُّبَيْرِ ،  أَنَّهُ سَمِعَ  جَابِرًا يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا رَأَيْتُمُ الْهِلَالَ فَصُومُوا  ، وَإِذَا رَأَيْتُمُوهُ فَأَفْطِرُوا ، فَإِنْ  غُمَّ  عَلَيْكُمْ فَعُدُّوا ثَلَاثِينَ يَوْمًا  .","","Musnad Abi Ya'la al-Mawsili 2248","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زكريا بن إسحاق المكي عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2252","485 - (  2249  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ قَالَ :  أَخْبَرَنِي  أَبُو الزُّبَيْرِ ،         [4/172]      أَنَّهُ سَمِعَ  جَابِرًا يَقُولُ :  اعْتَزَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نِسَاءَهُ شَهْرًا ، فَخَرَجَ صُبْحَ تِسْعٍ وَعِشْرِينَ ، فَقَالَ بَعْضُ  الْقَوْمِ  : يَا رَسُولَ اللهِ ، أَصْبَحْنَا مِنْ تِسْعٍ وَعِشْرِينَ ؟ فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ  الشَّهْرَ  تِسْعٌ وَعِشْرُونَ  ، ثُمَّ صَفَّقَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِيَدَيْهِ ثَلَاثًا ، مَرَّتَيْنِ بِالْأَصَابِعِ كُلِّهَا وَالثَّالِثَةَ بِتِسْعٍ مِنْهَا  .","","Musnad Abi Ya'la al-Mawsili 2249","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2253","486 - (  2250  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ قَالَ :  أَخْبَرَنِي  أَبُو الزُّبَيْرِ ،  أَنَّهُ سَمِعَ  جَابِرًا يَقُولُ :  أَرَادَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَنْهَى أَنْ يُسَمَّى بِبَرَكَةَ ، وَأَفْلَحَ ، وَبِيَسَارٍ ، وَبِنَافِعٍ  ، وَبِنَحْوِ ذَلِكَ ثُمَّ رَأَيْتُهُ سَكَتَ بَعْدُ عَنْهَا فَلَمْ يَقُلْ شَيْئًا ، ثُمَّ قُبِضَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَمْ يَنْهَ عَنْ ذَلِكَ ، ثُمَّ أَرَادَ  عُمَرُ  أَنْ يَنْهَى عَنْ ذَلِكَ ثُمَّ تَرَكَهُ  .         [4/173]","","Musnad Abi Ya'la al-Mawsili 2250","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2254","487 - (  2251  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ قَالَ :  أَخْبَرَنِي  زِيَادُ بْنُ إِسْمَاعِيلَ ،  عَنْ  سُلَيْمَانَ بْنِ عَتِيقٍ ،  عَنْ  جَابِرٍ قَالَ :  لَمَّا دَخَلَتْ  صَفِيَّةُ بِنْتُ حُيَيٍّ  عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فُسْطَاطَهُ  ، حَضَرَهُ نَاسٌ وَحَضَرْتُ مَعَهُمْ لِيَكُونَ لِي فِيهَا قَسْمٌ ، فَخَرَجَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  قُومُوا عَنْ أُمِّكُمْ  ، فَلَمَّا كَانَ مِنَ الْعَشِيِّ حَضَرْنَا ، فَخَرَجَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي رِدَائِهِ نَحْوٌ مِنْ مُدٍّ وَنِصْفٍ مِنْ تَمْرٍ  عَجْوَةٍ  ، قَالَ : كُلُوا مِنْ وَلِيمَةِ أُمِّكُمْ  .         [4/174]","","Musnad Abi Ya'la al-Mawsili 2251","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سليمان بن عتيق المحاربي عن زياد بن إسماعيل المخزومي عن ابن جريج عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2255","488 - (  2252  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  زَكَرِيَّا بْنُ إِسْحَاقَ ،  حَدَّثَنَا  أَبُو الزُّبَيْرِ ،  أَنَّهُ سَمِعَ  جَابِرَ بْنَ عَبْدِ اللهِ قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي غَزْوَةٍ غَزَاهَا وَذَلِكَ فِي رَمَضَانَ ، فَصَامَ  رَجُلٌ مِنْ أَصْحَابِ النَّبِيِّ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَضَعُفَ ضَعْفًا شَدِيدًا ، وَكَادَ الْعَطَشُ يَقْتُلُهُ ، وَجَعَلَتْ نَاقَتُهُ تَدْخُلُ  الْعِضَاهَ  ، فَأُخْبِرَ بِهِ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  ائْتُونِي بِهِ ، فَأُتِيَ بِهِ ، فَقَالَ : أَلَسْتَ فِي  سَبِيلِ  اللهِ ، وَمَعَ رَسُولِ اللهِ ؟ أَفْطِرْ ، فَأَفْطَرَ  .","","Musnad Abi Ya'la al-Mawsili 2252","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زكريا بن إسحاق المكي عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2256","489 - (  2253  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  زَكَرِيَّا بْنُ إِسْحَاقَ ،  حَدَّثَنَا  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  دَخَلَ  أَبُو بَكْرٍ الصِّدِّيقُ  يَسْتَأْذِنُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَوَجَدَ النَّاسَ جُلُوسًا بِبَابِهِ لَمْ يُؤْذَنْ لِأَحَدٍ مِنْهُمْ ، قَالَ : فَأُذِنَ  لِأَبِي بَكْرٍ  فَدَخَلَ ، ثُمَّ أَقْبَلَ  عُمَرُ  فَاسْتَأْذَنَ فَأُذِنَ لَهُ ، فَوَجَدَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَالِسًا حَوْلَهُ نِسَاؤُهُ  وَاجِمًا  سَاكِتًا ، فَقَالَ : لَأَقُولَنَّ شَيْئًا أُضْحِكُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ، لَوْ رَأَيْتُ بِنْتَ  خَارِجَةَ  سَأَلَتْنِي النَّفَقَةَ ، فَقُمْتُ إِلَيْهَا  فَوَجَأْتُ  عُنُقَهَا ، فَضَحِكَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [4/175]      وَقَالَ : هُنَّ حَوْلِي كَمَا تَرَى يَسْأَلْنَنِي النَّفَقَةَ ، فَقَامَ  أَبُو بَكْرٍ  إِلَى  عَائِشَةَ  يَجَأُ عُنُقَهَا ، وَقَامَ  عُمَرُ  إِلَى  حَفْصَةَ  يَجَأُ عُنُقَهَا ، كِلَاهُمَا يَقُولُ : تَسْأَلْنَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَا لَيْسَ عِنْدَهُ ؟ فَقُلْنَ : وَاللهِ لَا نَسْأَلُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - شَيْئًا أَبَدًا لَيْسَ عِنْدَهُ ، ثُمَّ اعْتَزَلَهُنَّ  شَهْرًا أَوْ تِسْعًا وَعِشْرِينَ  ، ثُمَّ نَزَلَ عَلَيْهِ هَذِهِ الْآيَةُ :         {      يَا أَيُّهَا النَّبِيُّ قُلْ لأَزْوَاجِكَ         }      حَتَّى بَلَغَ         {      لِلْمُحْسِنَاتِ مِنْكُنَّ أَجْرًا عَظِيمًا         }      قَالَ : فَبَدَأَ  بِعَائِشَةَ  ، فَقَالَ :  يَا  عَائِشَةُ  ، إِنِّي أُرِيدُ أَنْ أَعْرِضَ عَلَيْكِ أَمْرًا لَا أُحِبُّ أَنْ تَعْجَلِي فِيهِ بِشَيْءٍ حَتَّى تَسْتَشِيرِي أَبَوَيْكِ  ، قَالَتْ : وَمَا هُوَ يَا رَسُولَ اللهِ ؟ فَتَلَا عَلَيْهَا الْآيَةَ ، فَقَالَتْ : أَفِيكَ يَا رَسُولَ اللهِ أَسْتَشِيرُ أَبَوَيَّ ؟ بَلْ أَخْتَارُ اللهَ وَرَسُولَهُ وَالدَّارَ الْآخِرَةَ ، وَأَسْأَلُكَ أَنْ لَا تُخْبِرَ امْرَأَةً مِنْ نِسَائِكَ بِالَّذِي قُلْتُ ، قَالَ : لَا تَسْأَلُنِي امْرَأَةٌ مِنْهُنَّ إِلَّا أَخْبَرْتُهَا ، إِنَّ اللهَ لَمْ يَبْعَثْنِي مُعَنِّتًا ، وَلَكِنْ بَعَثَنِي مُعَلِّمًا مُيَسِّرًا  .         [4/176]","","Musnad Abi Ya'la al-Mawsili 2253","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زكريا بن إسحاق المكي عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2257","490 - (  2254  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  حَدَّثَنَا  هِشَامٌ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَرْتَدُوا  الصَّمَّاءَ  فِي ثَوْبٍ وَاحِدٍ  ، وَلَا يَأْكُلْ أَحَدُكُمْ بِشِمَالِهِ ، وَلَا يَمْشِيَنَّ فِي نَعْلٍ وَاحِدٍ ، وَلَا يَحْتَبِيَنَّ فِي ثَوْبٍ وَاحِدٍ  .         [4/177]","","Musnad Abi Ya'la al-Mawsili 2254","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن هشام الدستوائي عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2258","491 - (  2255  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ ،  حَدَّثَنَا  هِشَامٌ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  كُنَّا  نَعْزِلُ  عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمْ يَنْهَنَا عَنْهُ  .","","Musnad Abi Ya'la al-Mawsili 2255","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن هشام الدستوائي عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2259","492 - (  2256  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ ،  حَدَّثَنَا  أَبِي  ،  حَدَّثَنَا  الْقَاسِمُ بْنُ عَبْدِ الْوَاحِدِ الْمَكِّيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَقِيلٍ قَالَ :  سَمِعْتُ  جَابِرًا يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الْعَبْدَ إِذَا تَزَوَّجَ بِغَيْرِ إِذْنِ سَيِّدِهِ كَانَ عَاهِرًا  .","","Musnad Abi Ya'la al-Mawsili 2256","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن القاسم بن عبد الواحد بن أيمن المخزومي عن عبد الوارث بن سعيد بن ذكوان عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2260","493 - (  2257  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ ،  حَدَّثَنَا  كَثِيرٌ ،  حَدَّثَنَا  عَطَاءٌ ،  عَنْ  جَابِرٍ قَالَ :  أَرْسَلَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَانْطَلَقْتُ ثُمَّ رَجَعْتُ وَقَدْ قَضَيْتُهَا ، فَأَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَلَّمْتُ عَلَيْهِ ، فَلَمْ يَرُدَّ عَلَيَّ فَوَقَعَ فِي نَفْسِي مَا اللهُ أَعْلَمُ بِهِ ، قَالَ : قُلْتُ : لَعَلَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَجَدَ عَلَيَّ أَنِّي أَبْطَأْتُ ، فَسَلَّمْتُ عَلَيْهِ ، فَلَمْ يَرُدَّ عَلَيَّ ، فَوَقَعَ فِي نَفْسِي أَشَدُّ مِنَ الْأُولَى ، ثُمَّ سَلَّمْتُ عَلَيْهِ فَرَدَّ عَلَيَّ ، وَقَالَ :  إِنَّهُ لَمْ يَمْنَعْنِي أَنْ أَرُدَّ         [4/178]      عَلَيْكَ إِلَّا أَنِّي كُنْتُ أُصَلِّي  ، وَكَانَ عَلَى رَاحِلَتِهِ مُتَوَجِّهًا لِغَيْرِ الْقِبْلَةِ  .","","Musnad Abi Ya'la al-Mawsili 2257","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن كثير بن شنظير المازني عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","مسند جابر"
"2261","494 - (  2258  ) -  حَدَّثَنَا  كَامِلُ بْنُ طَلْحَةَ ،  حَدَّثَنَا  اللَّيْثُ بْنُ سَعْدٍ ،  حَدَّثَنَا  أَبُو الزُّبَيْرِ ،  أَنَّ  جَابِرَ بْنَ عَبْدِ اللهِ قَالَ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  غَطُّوا الْإِنَاءَ ، وَأَوْكُوا السِّقَاءَ ، وَأَطْفِئُوا السِّرَاجَ  ، فَإِنَّ الشَّيْطَانَ لَا يَحُلُّ سِقَاءً ، وَلَا يَفْتَحُ بَابًا ، وَلَا يَكْشِفُ إِنَاءً ، وَإِنْ لَمْ يَجِدْ أَحَدُكُمْ إِلَّا أَنْ يَعْرُضَ عَلَى إِنَائِهِ عُودًا وَيَذْكُرَ اللهَ فَلْيَفْعَلْ ، فَإِنَّ الْفُوَيْسِقَةَ تُضْرِمُ عَلَى أَهْلِ الْبَيْتِ بَيْتَهُمْ  .","","Musnad Abi Ya'la al-Mawsili 2258","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن الليث بن سعد عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند جابر"
"2262","495 - (  2259  ) -  حَدَّثَنَا  كَامِلٌ ،  حَدَّثَنَا  لَيْثُ بْنُ سَعْدٍ قَالَ :  وَقَالَ  أَبُو الزُّبَيْرِ :         [4/179]      إِنَّ جَابِرًا  قَالَ  : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تَأْكُلُوا بِالشِّمَالِ  ، فَإِنَّ الشَّيْطَانَ يَأْكُلُ بِالشِّمَالِ  .","","Musnad Abi Ya'la al-Mawsili 2259","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن الليث بن سعد عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند جابر"
"2263","496 - (  2260  ) -  حَدَّثَنَا  كَامِلٌ ،  حَدَّثَنَا  لَيْثُ بْنُ سَعْدٍ ،  حَدَّثَنَا  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ  نَهَى عَنِ  اشْتِمَالِ  الصَّمَّاءِ  ،  وَالِاحْتِبَاءِ  فِي ثَوْبٍ وَاحِدٍ  ، وَأَنْ يَرْفَعَ الرَّجُلُ إِحْدَى رِجْلَيْهِ عَلَى الْأُخْرَى وَهُوَ مُسْتَلْقٍ عَلَى ظَهْرِهِ  .","","Musnad Abi Ya'la al-Mawsili 2260","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن الليث بن سعد عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند جابر"
"2264","497 - (  2261  ) -  حَدَّثَنَا  كَامِلٌ ،  حَدَّثَنَا  لَيْثٌ ،  حَدَّثَنَا  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  عُرِضَ عَلَيَّ الْأَنْبِيَاءُ جَمِيعًا ، فَإِذَا  مُوسَى  ضَرْبٌ مِنَ الرِّجَالِ كَأَنَّهُ مِنْ  رِجَالِ شَنُوءَةَ  ، وَرَأَيْتُ  عِيسَى  فَإِذَا أَقْرَبُ مَنْ رَأَيْتُ بِهِ شَبَهًا  عُرْوَةُ بْنُ مَسْعُودٍ  ، وَرَأَيْتُ  إِبْرَاهِيمَ  فَإِذَا أَقْرَبُ مَنْ رَأَيْتُ بِهِ شَبَهًا صَاحِبُكُمْ ، يَعْنِي نَفْسَهُ ، وَرَأَيْتُ  جِبْرِيلَ  فَأَقْرَبُ مَنْ رَأَيْتُ بِهِ شَبَهًا  دِحْيَةُ  .         [4/180]","","Musnad Abi Ya'la al-Mawsili 2261","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن الليث بن سعد عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند جابر"
"2265","498 - (  2262  ) -  حَدَّثَنَا  كَامِلٌ ،  حَدَّثَنَا  لَيْثٌ قَالَ :  حَدَّثَنِي  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ رَآنِي فِي النَّوْمِ فَقَدْ رَآنِي  ، فَإِنَّهُ لَا يَنْبَغِي لِلشَّيْطَانِ أَنْ يَتَمَثَّلَ صُورَتِي وَقَالَ : إِذَا حَلَمَ أَحَدُكُمْ فَلَا يُخْبِرِ النَّاسَ بِتَلَعُّبِ الشَّيْطَانِ بِهِ فِي الْمَنَامِ .","","Musnad Abi Ya'la al-Mawsili 2262","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن الليث بن سعد عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند جابر"
"2266","499 - (  2263  ) -  حَدَّثَنَا  كَامِلٌ ،  حَدَّثَنَا  لَيْثُ بْنُ سَعْدٍ ،  حَدَّثَنَا  أَبُو الزُّبَيْرِ ،         [4/181]      عَنْ  جَابِرٍ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ :  إِذَا رَأَى أَحَدُكُمُ الرُّؤْيَا يَكْرَهُهَا ، فَلْيَبْصُقْ عَنْ يَسَارِهِ ثَلَاثًا  ، وَلْيَسْتَعِذْ بِاللهِ مِنَ الشَّيْطَانِ ثَلَاثًا ، وَلْيَتَحَوَّلْ عَنْ شِقِّهِ الَّذِي كَانَ عَلَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 2263","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن الليث بن سعد عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند جابر"
"2267","500 - (  2264  ) -  حَدَّثَنَا  كَامِلٌ ،  حَدَّثَنَا  لَيْثٌ قَالَ :  حَدَّثَنِي  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اعْتَزَلَ نِسَاءَهُ شَهْرًا ، فَخَرَجَ لَيْلَةَ تِسْعٍ وَعِشْرِينَ فَقُلْنَا : إِنَّمَا مَضَى تِسْعٌ وَعِشْرُونَ فَقَالَ :  إِنَّمَا  الشَّهْرُ  هَكَذَا  ، وَصَفَّقَ ثَلَاثَ مَرَّاتٍ ،  وَخَنَسَ  إِصْبَعًا وَاحِدًا فِي الْآخِرَةِ  .         [4/182]","","Musnad Abi Ya'la al-Mawsili 2264","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن الليث بن سعد عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند جابر"
"2268","501 - (  2265  ) -  حَدَّثَنَا  كَامِلٌ ،  حَدَّثَنَا  لَيْثُ بْنُ سَعْدٍ قَالَ :  حَدَّثَنِي  أَبُو الزُّبَيْرِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللهِ ،  أَنَّهُ أَخْبَرَهُ  ،  أَنَّ  حَاطِبَ بْنَ أَبِي بَلْتَعَةَ  كَتَبَ إِلَى  أَهْلِ مَكَّةَ  يَذْكُرُ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَرَادَ غَزْوَهُمْ ، فَدُلَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى الْمَرْأَةِ الَّتِي كَانَ مَعَهَا الْكِتَابُ ، فَأَرْسَلَ إِلَيْهَا ، فَأُخِذَ كِتَابُهَا مِنْ رَأْسِهَا ، فَقَالَ : يَا  حَاطِبُ  أَفَعَلْتَ ؟ قَالَ : نَعَمْ ، أَمَا إِنِّي لَمْ أَفْعَلْهُ غِشًّا لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَا نِفَاقًا ، قَدْ عَلِمْتُ أَنَّ اللهَ مُظْهِرٌ رَسُولَهُ وَمُتَمِّمٌ لَهُ أَمْرَهُ ، غَيْرَ أَنِّي كُنْتُ بَيْنَ  ظَهْرَانَيْهِمْ  ، وَكَانَتْ وَالِدَتِي مَعَهُمْ ، فَأَرَدْتُ أَنْ أَتَّخِذَهَا عِنْدَهُمْ ، فَقَالَ لَهُ  عُمَرُ  : أَلَا أَضْرِبُ عُنُقَ هَذَا ؟ فَقَالَ :  تَقْتُلُ رَجُلًا مِنْ  أَهْلِ بَدْرٍ  ؟ وَمَا يُدْرِيكَ لَعَلَّ اللهَ قَدِ اطَّلَعَ عَلَى  أَهْلِ بَدْرٍ  فَقَالَ : اعْمَلُوا مَا شِئْتُمْ  ؟ .","","Musnad Abi Ya'la al-Mawsili 2265","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن الليث بن سعد عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند جابر"
"2269","502 - (  2266  ) -  حَدَّثَنَا  كَامِلٌ ،  حَدَّثَنَا  لَيْثٌ ،  حَدَّثَنَا  أَبُو الزُّبَيْرِ ،         [4/183]      عَنْ  جَابِرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ خَيْرَ مَا رُكِبَتْ إِلَيْهِ الرَّوَاحِلُ مَسْجِدِي هَذَا  وَالْبَيْتُ الْعَتِيقُ  .","","Musnad Abi Ya'la al-Mawsili 2266","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ليث بن أبي سليم عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند جابر"
"2270","503 - (  2267  ) -  حَدَّثَنَا  كَامِلٌ ،  حَدَّثَنَا  لَيْثٌ قَالَ :  حَدَّثَنِي  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ :  أَنَّ  أُمَّ سَلَمَةَ  اسْتَأْذَنَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْحِجَامَةِ ، فَأَمَرَ  أَبَا طَيْبَةَ  فَحَجَمَهَا  .  قَالَ أَبُو يَعْلَى :  حَسِبْتُ أَنَّهُ قَالَ : كَانَ أَخَاهَا مِنَ الرَّضَاعَةِ  .","","Musnad Abi Ya'la al-Mawsili 2267","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن الليث بن سعد عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند جابر"
"2271","504 - (  2268  ) -  حَدَّثَنَا  كَامِلٌ ،  حَدَّثَنَا  لَيْثٌ قَالَ :  حَدَّثَنِي  أَبُو الزُّبَيْرِ مَوْلَى حَكِيمِ بْنِ حِزَامٍ ،         [4/184]      عَنْ  جَابِرٍ :  أَنَّهُمْ كَانُوا إِذَا كَانُوا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَاضِرِينَ يَبْعَثُ بِالْهَدْيِ  ، فَمَنْ شَاءَ مِنَّا أَحْرَمَ ، وَمَنْ شَاءَ مِنَّا تَرَكَ  .","","Musnad Abi Ya'la al-Mawsili 2268","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ليث بن أبي سليم عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند جابر"
"2272","505 - (  2269  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ مَاتَ عَلَى شَيْءٍ بَعَثَهُ اللهُ عَلَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 2269","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن أبو معاوية الضرير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2273","506 - (  2270  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَهْلُ الْجَنَّةِ يَأْكُلُونَ وَيَشْرَبُونَ فِيهَا ، وَلَا يَتَغَوَّطُونَ  ، وَلَا يَبُولُونَ ، وَلَا يَمْتَخِطُونَ ، وَلَكِنْ رَشْحُ الْمِسْكِ  .","","Musnad Abi Ya'la al-Mawsili 2270","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن أبو معاوية الضرير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2274","507 - (  2271  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ، وَأَبِي  ، قَالَا :  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي سُفْيَانَ         [4/185]      ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَيُّمَا مُؤْمِنٍ سَبَبْتُهُ ، أَوْ لَعَنْتُهُ ، فَاجْعَلْهَا لَهُ زَكَاةً وَأَجْرًا  .","","Musnad Abi Ya'la al-Mawsili 2271","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن أبو معاوية الضرير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2275","508 - (  2272  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا         [4/186]      الْأَعْمَشُ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  النَّاسُ تَبَعٌ  لِقُرَيْشٍ  فِي الْخَيْرِ وَالشَّرِّ  .","","Musnad Abi Ya'la al-Mawsili 2272","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن وكيع بن الجراح عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2276","509 - (  2273  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : أَيُّ الْمُسْلِمِينَ أَفْضَلُ ؟ قَالَ :  مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  .","","Musnad Abi Ya'la al-Mawsili 2273","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن وكيع بن الجراح عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2277","510 - (  2274  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : إِنِّي رَأَيْتُ فِي الْمَنَامِ كَأَنَّ رَأْسِي قُطِعَ ، فَضَحِكَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  إِذَا لَعِبَ الشَّيْطَانُ بِأَحَدِكُمْ فِي مَنَامِهِ ، فَلَا يُحَدِّثْ بِهِ النَّاسَ  .         [4/187]","","Musnad Abi Ya'la al-Mawsili 2274","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن وكيع بن الجراح عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2278","511 - (  2275  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنِ  الْأَعْمَشِ قَالَ :  قَالَ  جَابِرٌ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ ثَمَنِ الْكَلْبِ وَالسِّنَّوْرِ  ،  قَالَ  الْأَعْمَشُ  : أَظُنُّ أَبَا سُفْيَانَ ذَكَرَهُ  .","","Musnad Abi Ya'la al-Mawsili 2275","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الأعمش عن وكيع بن الجراح عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2279","512 - (  2276  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  حَفْصٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  جَاءَ  سُلَيْكٌ الْغَطَفَانِيُّ  وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا جَاءَ أَحَدُكُمْ وَالْإِمَامُ يَخْطُبُ ، فَلْيُصَلِّ رَكْعَتَيْنِ  يَتَجَوَّزُ  فِيهِمَا  .","","Musnad Abi Ya'la al-Mawsili 2276","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن حفص بن غياث النخعي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2280","513 - (  2277  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنْ عِشْتُ إِنْ شَاءَ اللهُ آمُرُ ، أَوْ أَنْهَى أُمَّتِي أَنْ لَا يُسَمُّوا أَفْلَحَ ، وَلَا نَافِعًا ، وَلَا بَرَكَةَ  ، قَالَ         [4/188]      الْأَعْمَشُ  : لَا أَدْرِي أَذَكَرَ نَافِعًا أَمْ لَا ،  لِأَنَّ الرَّجُلَ إِذَا جَاءَ قَالَ : ثَمَّ بَرَكَةٌ ؟ قَالُوا : لَا  .","","Musnad Abi Ya'la al-Mawsili 2277","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن محمد بن عبيد بن أبي أمية عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2281","514 - (  2278  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : مَا الْمُوجِبَتَانِ ؟ فَقَالَ :  مَنْ مَاتَ لَا يُشْرِكُ بِاللهِ شَيْئًا دَخَلَ الْجَنَّةَ ، وَمَنْ مَاتَ يُشْرِكُ بِاللهِ شَيْئًا دَخَلَ النَّارَ  .","","Musnad Abi Ya'la al-Mawsili 2278","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن محمد بن عبيد بن أبي أمية عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2282","515 - (  2279  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ، وَيَعْلَى ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ خَافَ مِنْكُمْ أَنْ لَا يُوتِرَ         [4/189]      آخِرَ اللَّيْلِ فَلْيُوتِرْ أَوَّلَهُ  ، فَإِنَّ قِرَاءَةَ آخِرِ اللَّيْلِ مَحْضُورَةٌ ، وَهُوَ أَفْضَلُ  .","","Musnad Abi Ya'la al-Mawsili 2279","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن محمد بن عبيد بن أبي أمية عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2283","516 - (  2280  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  يَعْلَى ، وَمُحَمَّدٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  دَخَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى  عَائِشَةَ  وَعِنْدَهَا صَبِيٌّ يَقْطُرُ  مَنْخِرَاهُ  دَمًا ، فَقَالَتْ : بِهِ  الْعُذْرَةُ  ، فَقَالَ :  لَا تَقْتُلُوا أَوْلَادَكُمْ ، وَلَكِنْ أَيَّةُ امْرَأَةٍ بِصَبِيِّهَا  الْعُذْرَةُ  ، أَوْ وَجَعٌ فِي رَأْسِهِ ، فَلْتَأْخُذْ قُسْطًا هِنْدِيًّا  ، ثُمَّ لِتَحُتَّهُ بِالْمَاءِ ، ثُمَّ لِتُسْعِطْهُ إِيَّاهُ ، ثُمَّ أَمَرَ  عَائِشَةَ  فَفَعَلَتْ ذَلِكَ فَبَرَأَ  .","","Musnad Abi Ya'la al-Mawsili 2280","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن محمد بن عبيد بن أبي أمية عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2284","517 - (  2281  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  ابْنُ إِدْرِيسَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ فِي اللَّيْلِ سَاعَةً لَا يُوَافِقُهَا مُسْلِمٌ يَسْأَلُ اللهَ خَيْرًا إِلَّا أَعْطَاهُ إِيَّاهُ ، وَذَلِكَ كُلَّ لَيْلَةٍ  .","","Musnad Abi Ya'la al-Mawsili 2281","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن عبد الله بن إدريس الأودي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2285","518 - (  2282  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  يَعْلَى ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،         [4/190]      عَنْ  جَابِرٍ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أُمِرْتُ أَنْ أُقَاتِلَ النَّاسَ حَتَّى يَقُولُوا : لَا إِلَهَ إِلَّا اللهُ  ، فَإِذَا قَالُوهَا  عَصَمُوا  مِنِّي دِمَاءَهُمْ وَأَمْوَالَهُمْ إِلَّا بِحَقِّهَا ، وَحِسَابُهُمْ عَلَى اللهِ .","","Musnad Abi Ya'la al-Mawsili 2282","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن يعلى بن عبيد الطنافسي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2286","519 - (  2283  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  يَعْلَى ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا أَكَلَ أَحَدُكُمْ فَلْيَلْعَقْ أَصَابِعَهُ  ، فَإِنَّهُ لَا يَدْرِي فِي أَيِّ طَعَامِهِ تَكُونُ الْبَرَكَةُ  .","","Musnad Abi Ya'la al-Mawsili 2283","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن يعلى بن عبيد الطنافسي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2287","520 - (  2284  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  يَعْلَى ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،         [4/191]      عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا سَقَطَتْ لُقْمَةُ أَحَدِكُمْ ، فَلْيَأْخُذْهَا وَلَا يَدَعْهَا لِلشَّيْطَانِ  .","","Musnad Abi Ya'la al-Mawsili 2284","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن يعلى بن عبيد الطنافسي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2288","521 - (  2285  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا سَجَدَ أَحَدُكُمْ فَلْيَعْتَدِلْ  ، وَلَا يَفْتَرِشْ ذِرَاعَيْهِ  افْتِرَاشَ  الْكَلْبِ  .","","Musnad Abi Ya'la al-Mawsili 2285","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2289","522 - (  2286  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا قَضَى أَحَدُكُمُ الصَّلَاةَ فِي الْمَسْجِدِ ، فَلْيَجْعَلْ لِبَيْتِهِ جُزْءًا مِنْ صَلَاتِهِ  ، فَإِنَّ اللهَ جَاعِلٌ فِي بَيْتِهِ مِنْ صَلَاتِهِ خَيْرًا  .","","Musnad Abi Ya'la al-Mawsili 2286","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2290","523 - (  2287  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  اشْتَكَى  أُبَيُّ بْنُ كَعْبٍ  فَبَعَثَ إِلَيْهِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  طَبِيبًا  ،  فَكَوَاهُ  عَلَى  أَكْحَلِهِ  .         [4/192]","","Musnad Abi Ya'la al-Mawsili 2287","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2291","524 - (  2288  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  قَطَعَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ  أُبَيِّ بْنِ كَعْبٍ  عِرْقًا  وَكَوَاهُ  عَلَى  أَكْحَلِهِ  .","","Musnad Abi Ya'la al-Mawsili 2288","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن أبو معاوية الضرير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2292","525 - (  2289  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  طَعَامُ الرَّجُلِ يَكْفِي اثْنَيْنِ  ، وَطَعَامُ الرَّجُلَيْنِ يَكْفِي الْأَرْبَعَةَ ، وَطَعَامُ الْأَرْبَعَةِ يَكْفِي الثَّمَانِيَةَ  .","","Musnad Abi Ya'la al-Mawsili 2289","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2293","526 - (  2290  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبِي  ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي سُفْيَانَ ،         [4/193]      عَنْ  جَابِرٍ قَالَ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ  قَبْلَ وَفَاتِهِ بِثَلَاثٍ  ، يَقُولُ :  لَا يَمُوتَنَّ أَحَدُكُمْ إِلَّا وَهُوَ يُحْسِنُ بِاللهِ الظَّنَّ  .","","Musnad Abi Ya'la al-Mawsili 2290","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2294","527 - (  2291  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ  بِالْمَدِينَةِ  لَرِجَالًا مَا سِرْتُمْ مِنْ مَسِيرٍ وَلَا قَطَعْتُمْ وَادِيًا إِلَّا كَانُوا مَعَكُمْ  ، حَبَسَهُمُ الْعُذْرُ  .","","Musnad Abi Ya'la al-Mawsili 2291","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن أبو بكر بن عياش عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2295","528 - (  2292  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَثَلُ الصَّلَوَاتِ مَثَلُ نَهَرٍ         [4/194]      جَارٍ عَلَى بَابِ أَحَدِكُمْ يَغْتَسِلُ مِنْهُ  كُلَّ يَوْمٍ خَمْسَ مَرَّاتٍ  .","","Musnad Abi Ya'la al-Mawsili 2292","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2296","529 - (  2293  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبُو رَبِيعَةَ ،  عَنْ  أَبِي عَوَانَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا سَمِعَ الشَّيْطَانُ ذِكْرَ اللهِ ذَهَبَ  حَتَّى يَكُونَ مَكَانَ الرَّوْحَاءِ  .","","Musnad Abi Ya'la al-Mawsili 2293","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن الوضاح بن عبد الله اليشكري عن زيد بن عوف القطعي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2297","530 - (  2294  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ الشَّيْطَانَ أَيِسَ أَنْ يَعْبُدَهُ الْمُصَلُّونَ  ، وَلَكِنْ بِالتَّحْرِيشِ بَيْنَهُمْ  .","","Musnad Abi Ya'la al-Mawsili 2294","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2298","531 - (  2295  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبِي  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَجُلٌ مِنَ  الْأَنْصَارِ  يُقَالُ لَهُ :  النُّعْمَانُ بْنُ قَوْقَلٍ  ،  فَقَالَ : يَا رَسُولَ اللهِ ، أَرَأَيْتَ إِنْ صَلَّيْتُ الصَّلَوَاتِ         [4/195]      الْمَكْتُوبَةَ ، وَأَحْلَلْتُ وَحَرَّمْتُ الْحَرَامَ ، وَلَمْ أَزِدْ عَلَى ذَلِكَ ، أَدْخُلُ الْجَنَّةَ ؟ قَالَ : نَعَمْ  .","","Musnad Abi Ya'la al-Mawsili 2295","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2299","532 - (  2296  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبِي  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  سَأَلَهُ  رَجُلٌ  : أَيُّ الصَّلَاةِ أَفْضَلُ ؟ قَالَ :  طُولُ  الْقُنُوتِ  .","","Musnad Abi Ya'la al-Mawsili 2296","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2300","533 - (  2297  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  صُرِعَ  النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ فَرَسٍ ، فَرَثِيَتْ رِجْلُهُ ، فَدَخَلْنَا عَلَيْهِ وَهُوَ يُصَلِّي ، فَأَشَارَ إِلَيْنَا بِيَدِهِ ، ثُمَّ دَخَلْنَا مِنَ الْغَدِ وَهُوَ يُصَلِّي الْمَكْتُوبَةَ قَاعِدًا ، فَأَشَارَ إِلَيْنَا بِيَدِهِ أَنِ اقْعُدُوا ، ثُمَّ انْصَرَفَ ، فَقَالَ :  إِذَا كَانَ الْإِمَامُ قَاعِدًا فَصَلُّوا قُعُودًا ، وَإِذَا صَلَّى قَائِمًا فَصَلُّوا قِيَامًا  .","","Musnad Abi Ya'la al-Mawsili 2297","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2301","534 - (  2298  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،         [4/196]      عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا مِنْ مُسْلِمٍ وَلَا مُسْلِمَةٍ : ذَكَرٍ وَلَا أُنْثَى يَنَامُ بِاللَّيْلِ إِلَّا عَلَى رَأْسِهِ  جَرِيرٌ  مَعْقُودٌ  ، فَإِنْ هُوَ اسْتَيْقَظَ فَذَكَرَ اللهَ انْحَلَّتْ عُقْدَةٌ ، فَإِنْ قَامَ تَوَضَّأَ وَصَلَّى انْحَلَّتْ عُقَدُهُ كُلُّهَا ، وَأَصْبَحَ نَشِيطًا قَدْ أَصَابَ خَيْرًا ، وَإِنْ هُوَ نَامَ لَا يَذْكُرُ اللهَ أَصْبَحَ عَلَيْهِ عُقَدُهُ ثَقِيلًا  .","","Musnad Abi Ya'la al-Mawsili 2298","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2302","535 - (  2299  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الرُّقَى ، فَأَتَاهُ خَالِي وَكَانَ         [4/197]      يَرْقِي مِنَ الْعَقْرَبِ ، فَقَالَ : إِنَّكَ نَهَيْتَ عَنِ الرُّقَى وَأَنَا أَرْقِي مِنَ الْعَقْرَبِ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنِ اسْتَطَاعَ أَنْ يَنْفَعَ أَخَاهُ فَلْيَفْعَلْ  .","","Musnad Abi Ya'la al-Mawsili 2299","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2303","536 - (  2300  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  يَحْيَى بْنُ آدَمَ ،  عَنْ  قُطْبَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا  أَجْمَرْتُمُ  الْمَيِّتَ  فَأَوْتِرُوا  .","","Musnad Abi Ya'la al-Mawsili 2300","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن قطبة بن عبد العزيز بن سياه الحماني عن يحيى بن آدم عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2304","537 - (  2301  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبُو الْجَوَّابِ ،  عَنْ  عَمَّارِ بْنِ رُزَيْقٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،         [4/198]      عَنْ  جَابِرٍ قَالَ :  بَايَعْنَا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَحْتَ الشَّجَرَةِ عَلَى أَنْ لَا نَفِرَّ  .","","Musnad Abi Ya'la al-Mawsili 2301","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن عمار بن رزيق الضبي عن أحوص بن جواب الضبي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2305","538 - (  2302  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  مُحَاضِرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  أَتَيْنَا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : جِئْتُمْ تَسْأَلُونِي عَنْ كَذَا وَكَذَا ؟ قُلْنَا : نَعَمْ ، قَالَ :  تَسَمَّوْا بِاسْمِي ، وَلَا تَكَنَّوْا بِكُنْيَتِي  .  قَالَ : وَذَكَرْتُمُ السَّاعَةَ ؟ قُلْنَا : قَدْ كَانَ ذَلِكَ ، قَالَ : فَمَا مِنْ نَفْسٍ  مَنْفُوسَةٍ  يَأْتِي عَلَيْهَا مِائَةُ سَنَةٍ  .","","Musnad Abi Ya'la al-Mawsili 2302","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن محاضر بن المورع الهمداني عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2306","539 - (  2303  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  ابْنُ أَبِي عُبَيْدَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَوْ أَنَّ لِابْنِ آدَمَ نَخْلًا لَتَمَنَّى إِلَيْهِ مِثْلَهُ  ، وَلَا يَمْلَأُ جَوْفَهُ إِلَّا التُّرَابُ  .         [4/199]","","Musnad Abi Ya'la al-Mawsili 2303","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن عبد الملك بن معن المسعودي عن محمد بن أبي عبيدة المسعودي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2307","540 - (  2304  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  ابْنُ أَبِي عُبَيْدَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  كَانَتْ جَارِيَةٌ  لِعَبْدِ اللهِ بْنِ أُبَيٍّ  يُقَالُ لَهَا :  مُسَيْكَةُ  ، فَأَكْرَهَهَا ، فَأَتَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَشَكَتْ ذَلِكَ إِلَيْهِ  فَأَنْزَلَ اللهُ :         {      وَلا تُكْرِهُوا فَتَيَاتِكُمْ عَلَى الْبِغَاءِ إِنْ أَرَدْنَ تَحَصُّنًا لِتَبْتَغُوا عَرَضَ الْحَيَاةِ الدُّنْيَا         }      .         [4/200]","","Musnad Abi Ya'la al-Mawsili 2304","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن عبد الملك بن معن المسعودي عن محمد بن أبي عبيدة المسعودي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2308","541 - (  2305  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  مُحَاضِرٌ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَمْرَضُ مُؤْمِنٌ وَلَا مُؤْمِنَةٌ  ، وَلَا مُسْلِمٌ وَلَا مُسْلِمَةٌ إِلَّا حَطَّ اللهُ بِهِ خَطَايَاهُ  .","","Musnad Abi Ya'la al-Mawsili 2305","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن محاضر بن المورع الهمداني عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2309","542 - (  2306  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  مُحَاضِرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  يُبْعَثُ بَعْثٌ فَيُقَالُ لَهُمْ : هَلْ فِيكُمْ أَحَدٌ صَحِبَ  مُحَمَّدًا  ؟ فَيُقَالُ : نَعَمْ ، فَيُلْتَمَسُ فَيُوجَدُ الرَّجُلُ فَيُسْتَفْتَحُ فَيُفْتَحُ عَلَيْهِمْ  ، ثُمَّ يُبْعَثُ بَعْثٌ فَيُقَالُ : هَلْ فِيكُمْ مَنْ رَأَى أَصْحَابَ  مُحَمَّدٍ  ؟ فَيُلْتَمَسُ فَلَا يُوجَدُ حَتَّى         [4/201]      لَوْ كَانَ مِنْ وَرَاءِ الْبَحْرِ لَأَتَيْتُمُوهُ ، ثُمَّ يَبْقَى قَوْمٌ يَقْرَؤُونَ الْقُرْآنَ لَا يَدْرُونَ مَا هُوَ  .","","Musnad Abi Ya'la al-Mawsili 2306","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن محاضر بن المورع الهمداني عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2310","543 - (  2307  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  مُحَاضِرٌ ،  حَدَّثَنَا  الْأَعْمَشُ ،  حَدَّثَنَا  أَبُو سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  خَرَجْنَا مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي سَفَرِهِ ، فَهَاجَتْ رِيحٌ تَكَادُ تَدْفِنُ الرَّاكِبَ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  بُعِثَتْ هَذِهِ الرِّيحُ لِمَوْتِ مُنَافِقٍ  ، فَلَمَّا قَدِمْنَا  الْمَدِينَةَ  إِذَا هُوَ قَدْ مَاتَ فِي ذَلِكَ الْيَوْمِ عَظِيمٌ مِنْ عُظَمَاءِ الْمُنَافِقِينَ  .","","Musnad Abi Ya'la al-Mawsili 2307","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن محاضر بن المورع الهمداني عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2311","544 - (  2308  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  مُحَاضِرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  رَأَى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  رَجُلًا  تَوَضَّأَ فَلَمْ يُصِبْ عَقِبَهُ مَاءٌ ، فَقَالَ :  وَيْلٌ لِلْعَرَاقِيبِ مِنَ النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 2308","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن محاضر بن المورع الهمداني عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2312","545 - (  2309  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ ،         [4/202]      عَنْ  أَبِي بَكْرِ بْنِ عَيَّاشٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْإِيمَانُ فِي  أَهْلِ الْحِجَازِ  ، وَالْقَسْوَةُ وَالْغِلْظَةُ فِي  رَبِيعَةَ  وَمُضَرَ  .","","Musnad Abi Ya'la al-Mawsili 2309","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن أبو بكر بن عياش عن أحمد بن عبد الله اليربوعي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2313","546 - (  2310  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ مَنْصُورٍ ،  حَدَّثَنَا  إِسْرَائِيلُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي غَزَاةٍ ، فَهَاجَتْ رِيحٌ مُنْتِنَةٌ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  هَؤُلَاءِ قَوْمٌ مِنَ الْمُنَافِقِينَ ذَكَرُوا أُنَاسًا فَاغْتَابُوهُمْ  .         [4/203]","","Musnad Abi Ya'la al-Mawsili 2310","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن إسرائيل بن يونس بن أبي إسحاق عن إسحاق بن منصور السلولي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2314","547 - (  2311  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ، وَيَعْلَى ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ ،  عَنْ  أَبِي سَعِيدٍ قَالَ :  دَخَلْتُ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يُصَلِّي عَلَى حَصِيرٍ وَيَسْجُدُ عَلَيْهِ  ، وَدَخَلْتُ عَلَيْهِ وَهُوَ يُصَلِّي مُتَوَشِّحًا  .","","Musnad Abi Ya'la al-Mawsili 2311","","أبو سعيد الخدري عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن يعلى بن عبيد الطنافسي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2315","548 - (  2312  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ  أَنَّ  عُمَرَ رَأَى رَجُلًا تَوَضَّأَ فَتَرَكَ مَوْضِعَ الظُّفُرِ عَلَى قَدَمِهِ فَأَمَرَهُ بِالْإِعَادَةِ  .         [4/204]","","Musnad Abi Ya'la al-Mawsili 2312","","عمر بن الخطاب عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن محمد بن عبيد بن أبي أمية عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2316","549 - (  2313  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ  أَنَّهُ سُئِلَ عَنِ الرَّجُلِ يَضْحَكُ فِي الصَّلَاةِ ، فَقَالَ :  يُعِيدُ الصَّلَاةَ ، وَلَا يُعِيدُ الْوُضُوءَ  .         [4/205]","","Musnad Abi Ya'la al-Mawsili 2313","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن وكيع بن الجراح عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2317","550 - (  2314  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  لَوْ دَخَلْتُ عَلَى قَوْمٍ يُصَلُّونَ مَا سَلَّمْتُ عَلَيْهِمْ  .","","Musnad Abi Ya'la al-Mawsili 2314","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن سفيان الثوري عن وكيع بن الجراح عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2318","551 - (  2315  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ ، قَالَ :  كُنْتُ أَمِيحُ لِأَصْحَابِي  يَوْمَ بَدْرٍ  .         [4/206]","","Musnad Abi Ya'la al-Mawsili 2315","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن سفيان الثوري عن وكيع بن الجراح عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2319","552 - (  2316  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ  حَدَّثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  إِذَا دَخَلَ قَبْرَهُ -  يَعْنِي الْمَيِّتَ  - فَجَاءَهُ الْمَلَكُ ، قَامَ يَهُبُّ كَمَا يَهُبُّ النَّائِمُ  ، فَيَسْأَلَانِهِ فَيُجِيبُهُمْ ، فَيَقُولَانِ : مَا دِينُكَ ؟ فَيَقُولُ : الْإِسْلَامُ ، دَعُونِي حَتَّى أَخْرُجَ ، فَيَقُولَانِ لَهُ اسْكُتْ  .         [4/207]","","Musnad Abi Ya'la al-Mawsili 2316","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن أبو بكر بن عياش عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2320","553 - (  2317  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبِي  ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي سُفْيَانَ قَالَ :  سَأَلْتُ  جَابِرًا وَهُوَ  مُجَاوِرٌ  بِمَكَّةَ  وَكَانَ نَازِلًا فِي  بَنِي فِهْرٍ  ، فَسَأَلَهُ رَجُلٌ : هَلْ كُنْتُمْ تَدْعُونَ أَحَدًا مِنْ أَهْلِ الْقِبْلَةِ مُشْرِكًا ؟ قَالَ :  مَعَاذَ اللهِ ، فَفَزِعَ لِذَلِكَ ، قَالَ : هَلْ كُنْتُمْ تَدْعُونَ أَحَدًا مِنْكُمْ كَافِرًا ؟ قَالَ : لَا  .","","Musnad Abi Ya'la al-Mawsili 2317","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2321","554 - (  2318  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  قَبِيصَةُ ،  عَنْ  سُفْيَانَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ  رَفَعَهُ  قَالَ : كَانَ يَقُولُ :  يَا مُقَلِّبَ الْقُلُوبِ ثَبِّتْ قَلْبِي عَلَى دِينِكَ  ، فَقُلْنَا : يَا رَسُولَ اللهِ ، تَخَافُ عَلَيْنَا ، وَقَدْ آمَنَّا بِمَا جِئْتَ بِهِ ؟ فَقَالَ : إِنَّ الْقُلُوبَ بَيْنَ ، وَأَشَارَ الْأَعْمَشُ بِإِصْبَعَيْنِ  .         [4/208]","","Musnad Abi Ya'la al-Mawsili 2318","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن سفيان الثوري عن قبيصة بن عقبة السوائي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2322","555 - (  2319  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  يَعْلَى ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ قَالَ :  أُتِيَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقِيلَ لَهُ : إِنَّ الْحُمَّى قَدْ أَلَحَّتْ عَلَيْنَا ، فَقَالَ :  إِنْ شِئْتُمْ أَنْ تُرْفَعَ عَنْكُمْ رُفِعَتْ ، وَإِنْ شِئْتُمْ أَنْ تَكُونَ لَكُمْ طَهُورًا ؟  قَالُوا : تَكُونُ لَنَا طَهُورًا  .","","Musnad Abi Ya'la al-Mawsili 2319","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن يعلى بن عبيد الطنافسي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند جابر"
"2323","556 - (  2320  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  أَبِي  قَالَ :  قَالَ لِي  جَابِرُ بْنُ عَبْدِ اللهِ : سَأَلَنِي ابْنُ عَمِّكَ  الْحَسَنُ بْنُ مُحَمَّدٍ  عَنْ  غُسْلِ  الْجَنَابَةِ ، فَقُلْتُ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَصُبُّ بِيَدِهِ         [4/209]      عَلَى رَأْسِهِ ثَلَاثًا  قَالَ : إِنَّ شَعَرِي كَثِيرٌ ، قَالَ : قُلْتُ : يَا ابْنَ أَخِي ، كَانَ شَعَرُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَكْثَرَ مِنْ شَعَرِكَ وَأَطْيَبَ  .","","Musnad Abi Ya'la al-Mawsili 2320","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن يحيى القطان عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"2324","557 - (  2321  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  حَدَّثَنَا  أَيُّوبُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَكَرَ  الثُّومَ وَالْبَصَلَ أَوْ أَحَدَهُمَا  ، فَقَالَ :  إِنَّ الْمَلَائِكَةَ تَتَأَذَّى مِمَّا يَتَأَذَّى مِنْهُ ابْنُ آدَمَ  .","","Musnad Abi Ya'la al-Mawsili 2321","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن أيوب السختياني عن حماد بن زيد عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"2325","558 - (  2322  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  حَدَّثَنَا  مُعْتَمِرٌ قَالَ :  سَمِعْتُ  لَيْثًا  يَذْكُرُ ، عَنْ  عَطَاءٍ ،  عَنْ  جَابِرٍ ، أَنَّ نَبِيَّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ أَكَلَ الثُّومَ وَالْبَصَلَ وَالْكُرَّاثَ ، فَلَا يَقْرَبَنَّ مَسْجِدَنَا  .","","Musnad Abi Ya'la al-Mawsili 2322","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن ليث بن أبي سليم عن معتمر بن سليمان عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"2326","559 - (  2323  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ الْقُرَشِيُّ ،  حَدَّثَنَا  سُلَيْمَانُ ،  حَدَّثَنَا  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا عَزَّ عَلَيْكَ الْمَسَانُّ مِنَ الضَّأْنِ أَجْزَأَ  الْجَذَعُ  مِنَ الضَّأْنِ  .         [4/210]","","Musnad Abi Ya'la al-Mawsili 2323","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن الأعمش عن محمد بن عثمان بن صفوان الجمحي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"2327","560 - (  2324  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  حَدَّثَنَا  هِشَامُ بْنُ عَبْدِ الْمَلِكِ ،  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَذْبَحُوا إِلَّا  مُسِنَّةً  ، إِلَّا أَنْ يَعْسُرَ عَلَيْكُمْ ، فَتَذْبَحُوا  جَذَعَةً  مِنَ الضَّأْنِ  .","","Musnad Abi Ya'la al-Mawsili 2324","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زهير بن معاوية بن حديج عن أبو الوليد الطيالسي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"2328","561 - (  2325  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  مِسْعَرٍ ،  سَمِعَهُ مِنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنْ  جَابِرٍ قَالَ :  نَهَى عَنِ الْبُسْرِ وَالتَّمْرِ  ، وَالزَّبِيبِ وَالتَّمْرِ  .","","Musnad Abi Ya'la al-Mawsili 2325","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن مسعر بن كدام عن وكيع بن الجراح عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"2329","562 - (  2326  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْمُؤْمِنُ يَأْكُلُ فِي  مِعًى  وَاحِدٍ  ، وَالْكَافِرُ فِي سَبْعَةِ أَمْعَاءٍ  .","","Musnad Abi Ya'la al-Mawsili 2326","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان الثوري عن عبد الرحمن بن مهدي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"2330","563 - (  2327  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  حَدَّثَنَا  يَزِيدُ بْنُ         [4/211]      زُرَيْعٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ قَالَ :  حَدَّثَنِي  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ الْحَارِثِ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا سَمِعْتُمْ نُبَاحَ الْكَلْبِ بِاللَّيْلِ أَوْ نُهَاقَ الْحَمِيرِ فَتَعَوَّذُوا بِاللهِ ، فَإِنَّهُمْ يَرَوْنَ مَا لَا تَرَوْنَ  ، وَأَقِلُّوا الْخُرُوجَ إِذَا هَدَأَتِ الرِّجْلُ ، فَإِنَّ اللهَ يَبُثُّ فِي لَيْلِهِ مِنْ خَلْقِهِ مَا يَشَاءُ ،  وَأَجِيفُوا  الْأَبْوَابَ وَاذْكُرُوا اسْمَ اللهِ عَلَيْهَا ، فَإِنَّ الشَّيْطَانَ لَا يَفْتَحُ بَابًا أُجِيفَ وَذُكِرَ اسْمُ اللهِ عَلَيْهِ ، وَغَطُّوا الْجِرَارَ وَاكْفَؤُوا الْآنِيَةَ وَأَوْكُوا الْقِرَبَ  .","","Musnad Abi Ya'la al-Mawsili 2327","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن يسار الهلالي عن محمد بن إبراهيم بن الحارث التيمي عن محمد بن إسحاق عن يزيد بن زريع العيشي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند جابر"
"2331","[4/212]             [4/213]      أَوَّلُ  مُسْنَدِ  ابْنِ عَبَّاسٍ  1 - (  2328  ) -  أَخْبَرَنَا  أَبُو يَعْلَى أَحْمَدُ بْنُ عَلِيِّ بْنِ الْمُثَنَّى         [4/214]      الْمَوْصِلِيُّ ،  حَدَّثَنَا  هُدْبَةُ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  أَبِي نَضْرَةَ قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ ، يَخْطُبُ عَلَى مِنْبَرِ  الْبَصْرَةِ  قَالَ : قَالَ         [4/215]      رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّهُ لَمْ يَكُنْ نَبِيٌّ إِلَّا وَلَهُ دَعْوَةٌ يَتَنَجَّزُهَا فِي الدُّنْيَا ، وَإِنِّي خَبَّأْتُ دَعْوَتِي شَفَاعَةً لِأُمَّتِي يَوْمَ الْقِيَامَةِ  ، وَأَنَا  سَيِّدُ  وَلَدِ آدَمَ وَلَا  فَخْرَ ،  وَأَوَّلُ مَنْ تَنْشَقُّ عَنْهُ الْأَرْضُ وَلَا  فَخْرَ ،  بِيَدِي  لِوَاءُ  الْحَمْدِ  ، وَآدَمُ وَمَنْ دُونَهُ تَحْتَ  لِوَائِي  وَلَا  فَخْرَ ،  وَيَطُولُ يَوْمُ الْقِيَامَةِ عَلَى النَّاسِ وَيَشْتَدُّ ، حَتَّى يَقُولَ بَعْضُهُمْ لِبَعْضٍ : انْطَلِقُوا بِنَا إِلَى  آدَمَ  أَبِي الْبَشَرِ فَيَشْفَعَ لَنَا إِلَى رَبِّكُمْ فَيَقْضِي بَيْنَنَا ، فَيَنْطَلِقُونَ إِلَى  آدَمَ  فَيَقُولُونَ : يَا  آدَمُ  ، اشْفَعْ لَنَا إِلَى رَبِّكَ فَلْيَقْضِ بَيْنَنَا ، فَيَقُولُ  آدَمُ  : لَسْتُ هُنَاكَ إِنِّي أُخْرِجْتُ مِنَ الْجَنَّةِ بِخَطِيئَتِي ، وَإِنَّهُ لَا يُهِمُّنِي الْيَوْمَ إِلَّا نَفْسِي ، وَلَكِنِ ائْتُوا نُوحًا فَيَقُولُونَ : يَا  نُوحُ  ، اشْفَعْ لَنَا إِلَى رَبِّكَ فَيَقْضِي بَيْنَنَا فَيَقُولُ : لَسْتُ هُنَاكُمْ ، إِنِّي دَعَوْتُ دَعْوَةً أَغْرَقَتْ أَهْلَ الْأَرْضِ ، وَإِنَّهُ لَا يُهِمُّنِي الْيَوْمَ إِلَّا نَفْسِي ، وَلَكِنِ ائْتُوا  إِبْرَاهِيمَ  خَلِيلَ  الرَّحْمَنِ فَيَأْتُونَ  إِبْرَاهِيمَ  عَلَيْهِ السَّلَامُ ، فَيَقُولُونَ : يَا  إِبْرَاهِيمُ  ، اشْفَعْ لَنَا إِلَى رَبِّكَ فَلْيَقْضِ بَيْنَنَا فَيَقُولُ : لَسْتُ هُنَاكُمْ ، إِنِّي كَذَبْتُ فِي الْإِسْلَامِ ثَلَاثَ كِذْبَاتٍ : قَوْلُهُ :         {      إِنِّي سَقِيمٌ         }      ، وَقَوْلُهُ :         {      بَلْ فَعَلَهُ كَبِيرُهُمْ هَذَا         }      ، وَقَوْلُهُ لِلْمَلِكِ حِينَ مَرَّ بِهِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : وَاللهِ مَا أَرَادَ بِهِمْ إِلَّا عِزَّةً لِدِينِ اللهِ ، فَإِنَّهُ لَا يُهِمُّنِي الْيَوْمَ إِلَّا نَفْسِي ، وَلَكِنِ ائْتُوا  مُوسَى  عَبْدًا اصْطَفَاهُ         [4/216]      اللهُ بِرِسَالَتِهِ وَكَلَّمَهُ ، فَيَأْتُونَ  مُوسَى  ، فَيَقُولُونَ : يَا  مُوسَى  ، اشْفَعْ لَنَا إِلَى رَبِّكَ فَلْيَقْضِ بَيْنَنَا ، فَيَقُولُ : إِنِّي لَسْتُ هُنَاكُمْ ، إِنِّي قَتَلْتُ نَفْسًا وَإِنَّهُ لَا يُهِمُّنِي الْيَوْمَ إِلَّا نَفْسِي ، وَلَكِنِ ائْتُوا  عِيسَى  رُوحَ اللهِ وَكَلِمَتَهُ فَيَأْتُونَ  عِيسَى  ، فَيَقُولُونَ : يَا  عِيسَى  ، اشْفَعْ لَنَا إِلَى رَبِّكَ فَلْيَقْضِ بَيْنَنَا فَيَقُولُ : لَسْتُ هُنَاكُمْ ، إِنِّي اتُّخِذْتُ إِلَهًا مِنْ دُونِ اللهِ ، وَإِنَّهُ لَا يُهِمُّنِي الْيَوْمَ إِلَّا نَفْسِي ، أَرَأَيْتُمْ لَوْ كَانَ مَتَاعٌ فِي وِعَاءٍ مَخْتُومٍ أَكَانَ يُقْدَرُ عَلَى مَا فِيهِ حَتَّى يُفَضَّ الْخَاتَمُ ؟ فَيَقُولُونَ : لَا ، فَيَقُولُ : فَإِنَّ  مُحَمَّدًا  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَاتَمُ النَّبِيِّينَ ، وَقَدْ حَضَرَ ، وَقَدْ غَفَرَ اللهُ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ وَمَا تَأَخَّرَ ، فَيَأْتُونَنِي ، فَيَقُولُونَ : يَا  مُحَمَّدُ  ، اشْفَعْ لَنَا إِلَى رَبِّكَ فَلْيَقْضِ بَيْنَنَا ، فَأَقُولُ : أَنَا لَهَا ، حَتَّى يَأْذَنَ اللهُ لِمَنْ يَشَاءُ وَيَرْضَى ، فَإِذَا أَرَادَ اللهُ أَنْ يَقْضِيَ بَيْنَ خَلْقِهِ نَادَى مُنَادٍ : أَيْنَ  أَحْمَدُ  وَأُمَّتُهُ ؟ أَيْنَ  أَحْمَدُ  وَأُمَّتُهُ ؟ فَيَجِيئُونَ ، فَنَحْنُ الْأَوَّلُونَ وَالْآخِرُونَ : آخِرُ مَنْ يُبْعَثُ ، وَأَوَّلُ مَنْ يُحَاسَبُ فَتُفْرَجُ لَنَا الْأُمَمُ عَنْ طَرِيقِنَا ، فَنَمْضِي  غُرًّا  مُحَجَّلِينَ  مِنْ آثَارِ الطُّهُورِ ، فَتَقُولُ الْأُمَمُ : كَادَتْ هَذِهِ الْأُمَّةُ أَنْ تَكُونَ أَنْبِيَاءَ كُلُّهَا  .         [4/217]","","Musnad Abi Ya'la al-Mawsili 2328","","عبد الله بن عباس عن المنذر بن مالك العوقي عن علي بن زيد بن جدعان عن حماد بن سلمة عن هدبة بن خالد عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2332","2 - (  2329  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ جَمِيلٍ الْمَرْوَزِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  أَخْبَرَنَا  رَبَاحُ بْنُ زَيْدٍ ،  عَنْ  عُمَرَ بْنِ حَبِيبٍ ،  عَنِ  الْقَاسِمِ بْنِ أَبِي بَزَّةَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّهُ يُحَدِّثُ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ أَوَّلَ شَيْءٍ خَلَقَهُ اللهُ الْقَلَمَ وَأَمَرَهُ فَكَتَبَ كُلَّ شَيْءٍ  .         [4/218]","","Musnad Abi Ya'la al-Mawsili 2329","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن القاسم بن أبي بزة عن عمر بن حبيب المكي عن رباح بن زيد الصنعاني عن عبد الله بن المبارك عن أحمد بن جميل المروزي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2333","3 - (  2330  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  التَّمِيمِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَقَدْ أُمِرْتُ بِالسِّوَاكِ حَتَّى ظَنَنْتُ أَنَّهُ سَيَنْزِلُ عَلَيَّ بِهِ قُرْآنٌ أَوْ وَحْيٌ  .         [4/219]","","Musnad Abi Ya'la al-Mawsili 2330","","عبد الله بن عباس عن أربدة التميمي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2334","4 - (  2331  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ الْأَوْدِيُّ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أُمَيَّةَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَمَّا أُصِيبَ إِخْوَانُكُمْ  بِأُحُدٍ  جَعَلَ اللهُ أَرْوَاحَهُمْ فِي أَجْوَافِ طَيْرٍ خُضْرٍ ، تَرِدُ أَنْهَارَ الْجَنَّةِ وَتَأْكُلُ مِنْ ثِمَارِهَا  ، وَتَأْوِي إِلَى قَنَادِيلَ مِنْ ذَهَبٍ مُعَلَّقَةٍ فِي ظِلِّ الْعَرْشِ ، فَلَمَّا وَجَدُوا طِيبَ مَأْكَلِهِمْ وَمَشْرَبِهِمْ وَمَقِيلِهِمْ ، قَالُوا : مَنْ يُبَلِّغُ إِخْوَانَنَا عَنَّا أَنَّا أَحْيَاءٌ فِي الْجَنَّةِ نُرْزَقُ لِئَلَّا يَنْكُلُوا عِنْدَ الْحَرْبِ ، وَلَا يَزْهَدُوا فِي  الْجِهَادِ  ؟ قَالَ : فَقَالَ اللهُ : أَنَا أُبَلِّغُهُمْ عَنْكُمْ ، فَأَنْزَلَ اللهُ تَبَارَكَ وَتَعَالَى :         {      وَلا تَحْسَبَنَّ الَّذِينَ قُتِلُوا فِي سَبِيلِ اللهِ أَمْوَاتًا بَلْ أَحْيَاءٌ عِنْدَ رَبِّهِمْ         }      ... الْآيَةَ  .         [4/220]","","Musnad Abi Ya'la al-Mawsili 2331","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن أبو الزبير المكي عن إسماعيل بن أمية الأموي عن محمد بن إسحاق عن عبد الله بن إدريس الأودي عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2335","5 - (  2332  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  جَاءَ  أَعْرَابِيٌّ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَعَلَ يَتَكَلَّمُ بِكَلَامٍ بَيِّنٍ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ مِنَ  الْبَيَانِ  سِحْرًا  ، وَإِنَّ مِنَ الشِّعْرِ  حُكْمًا  .         [4/221]","","Musnad Abi Ya'la al-Mawsili 2332","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2336","6 - (  2333  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  :  لَا  عَدْوَى  وَلَا  طِيَرَةَ  وَلَا  هَامَةَ  وَلَا  صَفَرَ  ، فَقَالَ لَهُ  رَجُلٌ  : إِنَّا لَنَأْخُذُ الشَّاةَ الْجَرْبَاءَ ، فَنَطْرَحُهَا فِي الْغَنَمِ فَتَجْرَبُ ، قَالَ : فَمَنْ  أَعْدَى  الْأَوَّلَ . ؟         [4/222]","","Musnad Abi Ya'la al-Mawsili 2333","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2337","7 - (  2334  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَاتَتْ شَاةٌ  لِسَوْدَةَ بِنْتِ زَمْعَةَ  ، فَقَالَتْ : يَا رَسُولَ اللهِ ، مَاتَتْ فُلَانَةُ ،  تَعْنِي الشَّاةَ  ، قَالَ : فَلَوْلَا أَخَذْتُمْ مَسْكَهَا ، فَقَالَتْ : نَأْخُذُ  مَسْكَ  شَاةٍ قَدْ مَاتَتْ ؟ فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّمَا قَالَ :         {      قُلْ لا أَجِدُ فِي مَا أُوحِيَ إِلَيَّ مُحَرَّمًا عَلَى طَاعِمٍ يَطْعَمُهُ         }      الْآيَةَ ، لَا بَأْسَ أَنْ تَدْبُغُوهُ تَنْتَفِعُونَ بِهِ  ، قَالَتْ : فَأَرْسَلَتْ إِلَيْهَا ، فَسَلَخَتْ مَسْكَهَا ، فَاتَّخَذَتْ مِنْهُ قِرْبَةً حَتَّى تَخَرَّقَتْ  .         [4/223]","","Musnad Abi Ya'la al-Mawsili 2334","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2338","8 - (  2335  ) -  حَدَّثَنَا  الْمُعَلَّى بْنُ مَهْدِيٍّ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  أَهْدَتْ  أُمُّ حُفَيْدٍ خَالَتِي ابْنَةُ الْحَارِثِ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَمْنًا ، وَأَقِطًا  ، وَأَضُبًّا ، فَدَعَا بِهِنَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأُكِلْنَ عَلَى مَائِدَتِهِ ، وَتَرَكَهُنَّ كَالْمُتَقَذِّرِ لَهُنَّ ، وَلَوْ كُنَّ حَرَامًا مَا أُكِلْنَ عَلَى مَائِدَةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَا أَمَرَ بِأَكْلِهِنَّ  .         [4/224]             [4/225]","","Musnad Abi Ya'la al-Mawsili 2335","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن معلى بن مهدي الموصلي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2339","9 - (  2336  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ حُمَيْدٍ الْكُوفِيُّ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا  حِلْفَ  فِي الْإِسْلَامِ  ، وَمَا كَانَ فِي الْجَاهِلِيَّةِ لَمْ يَزِدْهُ الْإِسْلَامُ إِلَّا شِدَّةً أَوْ حِدَّةً  .","","Musnad Abi Ya'la al-Mawsili 2336","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن جعفر بن حميد زنبقة عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2340","10 - (  2337  ) -  حَدَّثَنَا  الْمُعَلَّى ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ  رَجُلًا  وَقَصَهُ  بَعِيرُهُ ، فَأَمَرَ بِهِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [4/226]      أَنْ يُغَسَّلَ بِمَاءٍ وَسِدْرٍ ، وَلَا يُمَسَّ طِيِبًا ، وَلَا يُكَفَّنَ ، وَلَا يُخَمَّرَ رَأْسُهُ ، وَقَالَ :  إِنَّهُ يُبْعَثُ يَوْمَ الْقِيَامَةِ  مُلَبِّدًا  .         [4/227]             [4/228]","","Musnad Abi Ya'la al-Mawsili 2337","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن معلى بن مهدي الموصلي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2341","11 - (  2338  ) -  حَدَّثَنَا  الْمُعَلَّى ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ الْأَعْلَى الثَّعْلَبِيِّ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اتَّقُوا الْحَدِيثَ عَلَيَّ إِلَّا مَا عَلِمْتُمْ ، فَإِنَّهُ مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  ، وَمَنْ كَذَبَ عَلَى الْقُرْآنِ بِغَيْرِ عِلْمٍ  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .         [4/229]","","Musnad Abi Ya'la al-Mawsili 2338","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن عبد الأعلى بن عامر الثعلبي عن الوضاح بن عبد الله اليشكري عن معلى بن مهدي الموصلي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2342","12 - (  2339  ) -  حَدَّثَنَا  مُحْرِزُ بْنُ عَوْنٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  إِنَّمَا سَعَى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِالْبَيْتِ  ، وَبَيْنَ  الصَّفَا  وَالْمَرْوَةِ  لِيُرِيَ النَّاسَ قُوَّتَهُ  .         [4/230]","","Musnad Abi Ya'la al-Mawsili 2339","","عبد الله بن عباس عن عطاء بن أبي رباح عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن محرز بن عون الهلالي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2343","13 - (  2340  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  ابْنُ أَبِي زَائِدَةَ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  لَمْ يَعْتَمِرِ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عُمْرَةً ، إِلَّا فِي ذِي الْقَعْدَةِ  .","","Musnad Abi Ya'la al-Mawsili 2340","","عبد الله بن عباس عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن يحيى بن زكريا بن أبي زائدة عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2344","14 - (  2341  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنِ  الْحَكَمِ ،  عَنْ  مِقْسَمٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  لَمَّا قَدِمَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  خَيْبَرَ  ، دَفَعَ أَرْضِيهَا وَنَخْلَهَا مُقَاسَمَةً عَلَى النِّصْفِ  .         [4/231]","","Musnad Abi Ya'la al-Mawsili 2341","","عبد الله بن عباس عن مقسم بن بجرة عن الحكم بن عتيبة الكندي عن محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2345","15 - (  2342  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدَةُ ، وَحُمَيْدٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  قَالَ :  حَدَّثَتْنِي  عَائِشَةُ :  أَنَّ يَدَ سَارِقٍ لَمْ تُقْطَعْ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا فِي ثَمَنِ  حَجَفَةٍ أَوْ تُرْسٍ  .","","Musnad Abi Ya'la al-Mawsili 2342","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حميد بن عبد الرحمن الرؤاسي عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2346","16 - (  2343  ) -  حَدَّثَنَا  عُثْمَانُ ،  حَدَّثَنَا  حُسَيْنُ بْنُ عِيسَى         [4/232]      الْحَنَفِيُّ ،  حَدَّثَنَا  الْحَكَمُ بْنُ أَبَانَ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لِيُؤَذِّنْ خِيَارُكُمْ  ، وَلْيَؤُمَّكُمْ قُرَّاؤُكُمْ  .","","Musnad Abi Ya'la al-Mawsili 2343","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن الحكم بن أبان العدني عن الحسين بن عيسى الحنفي عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2347","17 - (  2344  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  غَسَّانُ بْنُ مُضَرَ ،  عَنْ  سَعِيدِ بْنِ يَزِيدَ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  مَنْ سَرَّهُ أَنْ يُحَرِّمَ مَا حَرَّمَ اللهُ وَرَسُولُهُ  ، فَلْيُحَرِّمْ نَبِيذَ  الْجَرِّ  .         [4/233]","","Musnad Abi Ya'la al-Mawsili 2344","","عبد الله بن عباس عن المنذر بن مالك العوقي عن سعيد بن يزيد الطاحي عن غسان بن مضر عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2348","18 - (  2345  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَسْتَقْبِلُوا ، وَلَا تُحَفِّلُوا  ، وَلَا  يُنَفِّقْ  بَعْضُكُمْ لِبَعْضٍ  .         [4/234]","","Musnad Abi Ya'la al-Mawsili 2345","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2349","19 - (  2346  ) -  حَدَّثَنَا  خَلَفُ بْنُ هِشَامٍ الْبَزَّارُ ، وَأَبُو عَبْدِ الرَّحْمَنِ الْعَلَّافُ ، وَغَيْرُهُمَا ، قَالُوا :  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  بُكَيْرِ بْنِ الْأَخْنَسِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  فَرَضَ  اللهُ الصَّلَاةَ عَلَى لِسَانِ نَبِيِّكُمْ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْحَضَرِ أَرْبَعًا  ، وَفِي السَّفَرِ رَكْعَتَيْنِ ، وَفِي الْخَوْفِ رَكْعَةً  .","","Musnad Abi Ya'la al-Mawsili 2346","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن بكير بن الأخنس السدوسي عن الوضاح بن عبد الله اليشكري عن وغيرهما عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2350","20 - (  2347  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  حَدَّثَنَا  الْجَعْدُ أَبُو عُثْمَانَ الْيَشْكُرِيُّ ،  عَنْ  أَبِي رَجَاءٍ الْعُطَارِدِيِّ ،         [4/235]      عَنِ  ابْنِ عَبَّاسٍ  يَرْوِيهِ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ رَأَى مِنْ أَمِيرِهِ شَيْئًا يَكْرَهُهُ فَلْيَصْبِرْ  ، فَإِنَّهُ مَنْ يُفَارِقُ الْجَمَاعَةَ شِبْرًا فَيَمُوتُ ، مَاتَ  مِيتَةً  جَاهِلِيَّةً  .","","Musnad Abi Ya'la al-Mawsili 2347","","عبد الله بن عباس عن أبو رجاء العطاردي عن الجعد بن دينار اليشكري عن حماد بن زيد عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2351","21 - (  2348  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  حَدَّثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  حَنَشٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ شَرِبَ شَرَابًا حَتَّى يُذْهِبَ بِعَقْلِهِ الَّذِي أَعْطَاهُ اللهُ  ، فَقَدْ أَتَى بَابًا مِنْ أَبْوَابِ الْكَبَائِرِ  .         [4/236]","","Musnad Abi Ya'la al-Mawsili 2348","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن الحسين بن قيس الرحبي عن سليمان بن طرخان عن معتمر بن سليمان عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2352","22 - (  2349  ) -  حَدَّثَنَا  أَبُو يُوسُفَ الْجِيزِيُّ ،  حَدَّثَنَا  مُؤَمَّلٌ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  حَدَّثَنَا  عَمْرُو بْنُ مَالِكٍ النُّكْرِيُّ ،  عَنْ  أَبِي الْجَوْزَاءِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ  حَمَّادٌ  : وَلَا أَعْلَمُهُ إِلَّا قَدْ  رَفَعَهُ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  عُرَى الْإِسْلَامِ وَقَوَاعِدُ الدِّينِ ثَلَاثَةٌ عَلَيْهِنَّ أُسِّسَ الْإِسْلَامُ ، مَنْ تَرَكَ مِنْهُنَّ وَاحِدَةً فَهُوَ بِهَا كَافِرٌ حَلَالُ الدَّمِ  : شَهَادَةُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَالصَّلَاةُ الْمَكْتُوبَةُ ، وَصَوْمُ رَمَضَانَ ، ثُمَّ قَالَ  ابْنُ عَبَّاسٍ  : تَجِدُهُ كَثِيرَ الْمَالِ لَا يُزَكِّي ، فَلَا يَزَالُ بِذَاكَ كَافِرًا يَحِلُّ دَمُهُ ، وَتَجِدُهُ كَثِيرَ الْمَالِ لَمْ يَحُجَّ فَلَا يَزَالُ بِذَاكَ كَافِرًا ، وَلَا يَحِلُّ دَمُهُ  .","","Musnad Abi Ya'la al-Mawsili 2349","","عبد الله بن عباس عن أوس بن عبد الله الربعي عن عمرو بن مالك النكري عن حماد بن زيد عن مؤمل بن إسماعيل العدوي عن يعقوب بن إسحاق الجيزي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2353","23 - (  2350  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  حَدَّثَنَا  عَبْدُ الْوَاحِدِ         [4/237]      بْنُ زِيَادٍ ،  حَدَّثَنَا  سُلَيْمَانُ الْأَعْمَشُ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  جَاءَ رَجُلٌ مِنْ  بَنِي عَامِرٍ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يُدَاوِي  وَيُعَالِجُ  ، فَقَالَ لَهُ : يَا  مُحَمَّدُ  ، إِنَّكَ تَقُولُ أَشْيَاءَ ، فَهَلْ لَكَ أَنْ أُدَاوِيَكَ ؟ قَالَ : فَدَعَاهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ قَالَ لَهُ :  هَلْ لَكَ أَنْ أُرِيَكَ آيَةً ؟  وَعِنْدَهُ نَخْلٌ وَشَجَرٌ ، قَالَ : فَدَعَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عِذْقًا  مِنْهَا ، فَأَقْبَلَ إِلَيْهِ وَهُوَ يَسْجُدُ وَيَرْفَعُ ، وَيَسْجُدُ وَيَرْفَعُ رَأْسَهُ حَتَّى انْتَهَى إِلَيْهِ فَقَامَ بَيْنَ يَدَيْهِ ، ثُمَّ قَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ارْجِعْ إِلَى مَكَانِكَ ، فَرَجَعَ إِلَى مَكَانِهِ ، فَقَالَ : وَاللهِ لَا أُكَذِّبُكَ بِشَيْءٍ تَقُولُهُ بَعْدَهَا أَبَدًا ، ثُمَّ قَالَ : يَا  عَامِرُ بْنُ صَعْصَعَةَ  ، إِنِّي وَاللهِ لَا أُكَذِّبُهُ بِشَيْءٍ يَقُولُهُ بَعْدَهَا أَبَدًا ، قَالَ :  وَالْعَذْقُ  : النَّخْلَةُ  .         [4/238]","","Musnad Abi Ya'la al-Mawsili 2350","","عبد الله بن عباس عن سالم بن أبي الجعد الغطفاني عن الأعمش عن عبد الواحد بن زياد عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2354","24 - (  2351  ) -  حَدَّثَنَا  خَلَفُ بْنُ هِشَامٍ الْبَزَّارُ ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّ أَبِي شَيْخٌ كَبِيرٌ لَا يَسْتَطِيعُ  الْحَجَّ  ، أَفَأَحُجُّ عَنْهُ ؟ قَالَ : فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  نَعَمْ ، فَحُجَّ مَكَانَ أَبِيكَ  .         [4/239]","","Musnad Abi Ya'la al-Mawsili 2351","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن خلف بن هشام البزار عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2355","25 - (  2352  ) -  حَدَّثَنَا  خَلَفٌ ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،         [4/240]      عَنِ  ابْنِ عَبَّاسٍ قَالَ :  أَكَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَتِفًا ، ثُمَّ مَسَحَ يَدَهُ بِمِسْحٍ كَانَ تَحْتَهُ ، ثُمَّ قَامَ فَصَلَّى  .         [4/241]","","Musnad Abi Ya'la al-Mawsili 2352","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن خلف بن هشام البزار عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2356","26 - (  2353  ) -  حَدَّثَنَا  خَلَفٌ ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا أَرَادَ أَنْ يَخْرُجَ فِي سَفَرٍ قَالَ :  اللَّهُمَّ أَنْتَ الصَّاحِبُ فِي السَّفَرِ ، وَالْخَلِيفَةُ فِي الْأَهْلِ  ، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ  الضُّبْنَةِ  فِي السَّفَرِ ،  وَالْكَآبَةِ  فِي  الْمُنْقَلَبِ ،  اللَّهُمَّ اقْبِضْ لَنَا الْأَرْضَ ، وَهَوِّنْ عَلَيْنَا السَّفَرَ ، فَإِذَا أَرَادَ الرُّجُوعَ قَالَ : آيِبُونَ عَابِدُونَ لِرَبِّنَا حَامِدُونَ ، فَإِذَا دَخَلَ أَهْلَهُ قَالَ : تَوْبًا تَوْبًا ، لِرَبِّنَا  أَوْبًا ،  لَا يُغَادِرُ عَلَيْنَا  حَوْبًا  .         [4/242]","","Musnad Abi Ya'la al-Mawsili 2353","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن خلف بن هشام البزار عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2357","27 - (  2354  ) -  حَدَّثَنَا  خَلَفٌ ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَيَقْرَأَنَّ الْقُرْآنَ أَقْوَامٌ مِنْ أُمَّتِي  يَمْرُقُونَ  مِنَ الْإِسْلَامِ كَمَا  يَمْرُقُ  السَّهْمُ مِنَ  الرَّمِيَّةِ  .         [4/243]","","Musnad Abi Ya'la al-Mawsili 2354","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن خلف بن هشام البزار عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2358","28 - (  2355  ) -  حَدَّثَنَا  خَلَفُ بْنُ هِشَامٍ ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَصُومُوا قَبْلَ رَمَضَانَ  ، صُومُوا لِرُؤْيَتِهِ وَأَفْطِرُوا لِرُؤْيَتِهِ ، فَإِنْ حَالَ دُونَهُ غَيَايَةٌ فَأَكْمِلُوا ثَلَاثِينَ  .         [4/244]","","Musnad Abi Ya'la al-Mawsili 2355","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن خلف بن هشام البزار عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2359","29 - (  2356  ) -  وَبِإِسْنَادِهِ  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَسْتَقْبِلُوا السُّوقَ  ، وَلَا تُحَفِّلُوا ، وَلَا  يُنَفِّقْ  بَعْضُكُمْ لِبَعْضٍ  .","","Musnad Abi Ya'la al-Mawsili 2356","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن خلف بن هشام البزار عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2360","30 - (  2357  ) -  وَعَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [4/245]      يُصَلِّي عَلَى  الْخُمْرَةِ  .         [4/246]","","Musnad Abi Ya'la al-Mawsili 2357","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن خلف بن هشام البزار عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2361","31 - (  2358  ) -  حَدَّثَنِي  مُحَمَّدُ بْنُ مَنْصُورٍ الطُّوسِيُّ ،  حَدَّثَنَا  أَبُو أَحْمَدَ الزُّبَيْرِيُّ ،  حَدَّثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  لَمَّا نَزَلَتْ :         {      تَبَّتْ يَدَا أَبِي لَهَبٍ         }      جَاءَتِ  امْرَأَةُ أَبِي لَهَبٍ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَعَهُ  أَبُو بَكْرٍ  ، فَلَمَّا رَآهَا  أَبُو بَكْرٍ  قَالَ : يَا رَسُولَ اللهِ ، إِنَّهَا امْرَأَةٌ بَذِيَّةٌ وَأَخَافُ أَنْ تُؤْذِيَكَ ، فَلَوْ قُمْتَ ، فَقَالَ : إِنَّهَا لَنْ تَرَانِي ، فَقَالَتْ : يَا  أَبَا بَكْرٍ  ، صَاحِبُكَ هَجَانِي ، قَالَ : وَمَا يَقُولُ الشِّعْرَ ، قَالَتْ : أَنْتَ عِنْدِي مُصَدَّقٌ وَانْصَرَفَتْ ، فَقُلْتُ : يَا رَسُولَ اللهِ ، لَمْ تَرَكَ ، قَالَ :  لَمْ يَزَلْ مَلَكٌ يَسْتُرُنِي مِنْهَا بِجَنَاحِهِ  .         [4/247]","","Musnad Abi Ya'la al-Mawsili 2358","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن عطاء بن السائب عن عبد السلام بن حرب الملائي عن محمد بن عبد الله بن الزبير عن محمد بن منصور الطوسي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2362","32 - (  2359  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَنْصُورٍ الطُّوسِيُّ ،  حَدَّثَنَا  مُوسَى بْنُ دَاوُدَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  أَبِي الشَّعْثَاءِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كُلُّ قَسْمٍ قُسِمَ فَهُوَ عَلَى مَا قُسِمَ  ، وَكُلُّ قَسْمٍ أَدْرَكَهُ الْإِسْلَامُ فَهُوَ عَلَى مَا قُسِمَ  .","","Musnad Abi Ya'la al-Mawsili 2359","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن محمد بن مسلم بن سوسن الطائفي عن موسى بن داود الخلقاني عن محمد بن منصور الطوسي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2363","33 - (  2360  ) -  حَدَّثَنَا  زِيَادُ بْنُ أَيُّوبَ أَبُو هَاشِمٍ يُعْرَفُ بِدَلُّوَيْهِ ،  حَدَّثَنَا  يَحْيَى بْنُ يَمَانٍ ،  عَنْ  سُفْيَانَ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مِقْسَمٍ ،         [4/248]      عَنِ  ابْنِ عَبَّاسٍ قَالَ :  احْتَجَمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ مُحْرِمٌ  فِي  الْأَخْدَعَيْنِ  وَالْكَاهِلِ ، وَأَعْطَى الْحَجَّامَ أَجْرَهُ ، وَلَوْ كَانَ حَرَامًا لَمْ يُعْطِهِ  .         [4/249]","","Musnad Abi Ya'la al-Mawsili 2360","","عبد الله بن عباس عن مقسم بن بجرة عن يزيد بن أبي زياد القرشي عن سفيان الثوري عن يحيى بن يمان العجلي عن دلويه زياد بن أيوب عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2364","34 - (  2361  ) -  حَدَّثَنَا  سَعِيدُ بْنُ يَحْيَى بْنِ سَعِيدٍ الْأُمَوِيُّ قَالَ :  حَدَّثَنِي  أَبِي  ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ،  عَنْ  عُمَرَ بْنِ أَبِي حُسَيْنٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الرُّؤْيَا الصَّالِحَةُ  جُزْءٌ  - أَحْسَبُهُ قَالَ - : مِنْ سِتَّةٍ وَأَرْبَعِينَ  جُزْءًا  مِنَ النُّبُوَّةِ  .         [4/250]","","Musnad Abi Ya'la al-Mawsili 2361","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن عمر بن سعيد النوفلي عن ابن جريج عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2365","35 - (  2362  ) -  حَدَّثَنَا  زِيَادُ بْنُ أَيُّوبَ ،  عَنِ  ابْنِ أَبِي غَنِيَّةَ ،  عَنْ  سُفْيَانَ ،  عَنْ  جَابِرٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ :  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - احْتَجَمَ  ، وَأَعْطَى الْحَجَّامَ أَجْرَهُ  .","","Musnad Abi Ya'la al-Mawsili 2362","","عبد الله بن عباس عن الشعبي عن جابر الجعفي عن سفيان الثوري عن يحيى بن عبد الملك بن حميد عن دلويه زياد بن أيوب عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2366","36 - (  2363  ) -  حَدَّثَنَا  سَعِيدُ بْنُ يَحْيَى بْنِ سَعِيدٍ الْأُمَوِيُّ ،  حَدَّثَنَا  أَبِي  ،  حَدَّثَنَا  مُحَمَّدُ بْنُ قَيْسٍ الْأَسَدِيُّ ،  عَنْ  مُحَمَّدِ بْنِ عُبَيْدِ اللهِ الثَّقَفِيِّ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  قَدِمَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَفْدُ  بَنِي أَسَدٍ         [4/251]      فَتَكَلَّمُوا فَأَبَانُوا  ، فَقَالُوا : يَا رَسُولَ اللهِ ، قَاتَلَتْكَ  مُضَرُ  كُلُّهَا وَلَمْ نُقَاتِلْكَ ، وَلَسْنَا بِأَقَلِّهِمْ عَدَدًا وَلَا أَكَلِّهِمْ شَوْكَةً ، وَصَلْنَا رَحِمَكَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِأَبِي بَكْرٍ  وَعُمَرَ  حَيْثُ سَمِعَ كَلَامَهُمْ : أَيَتَكَلَّمُونَ هَكَذَا ؟ قَالَ : يَا رَسُولَ اللهِ إِنَّ فِقْهَهُمْ لَقَلِيلٌ ، وَإِنَّ الشَّيْطَانَ لَيَنْطِقُ عَلَى لِسَانِهِمْ  .","","Musnad Abi Ya'la al-Mawsili 2363","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن محمد بن عبيد الله بن سعيد الثقفي عن محمد بن قيس الوالبي عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2367","37 - (  2364  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  مَاتَتْ شَاةٌ  لِسَوْدَةَ بِنْتِ زَمْعَةَ  ، فَقَالَتْ : يَا رَسُولَ اللهِ ، مَاتَتْ فُلَانَةٌ ،  تَعْنِي الشَّاةَ  قَالَتْ : فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  فَهَلَّا أَخَذْتُمْ مَسْكَهَا ؟  قَالَتْ : نَأْخُذُ  مَسْكَ  شَاةٍ قَدْ مَاتَتْ ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :         {      قُلْ لا أَجِدُ فِي مَا أُوحِيَ إِلَيَّ مُحَرَّمًا         }      إِلَى         {      أَوْ لَحْمَ خِنْـزِيرٍ         }      أَيُّكُمْ يَطْعَمُهُ ؟ أَيْ :         [4/252]      تَدْبُغُونَهُ فَتَنْتَفِعُونَ بِهِ ، قَالَ : فَأَرْسَلَتْ إِلَيْهَا فَسَلَخَتْهَا فَدَبَغَتْهَا ، وَاتَّخَذَتْ مِنْهُ قِرْبَةً حَتَّى تَخَرَّقَتْ عِنْدَهَا  .","","Musnad Abi Ya'la al-Mawsili 2364","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2368","38 - (  2365  ) -  حَدَّثَنَا  يَعْقُوبُ بْنُ مَاهَانَ ،  حَدَّثَنَا  هُشَيْمٌ ،  حَدَّثَنَا  أَبُو بِشْرٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَقُولُ اللهُ : إِذَا أَخَذْتُ كَرِيمَتَيْ عَبْدِي فَصَبَرَ  وَاحْتَسَبَ  ، لَمْ أَرْضَ لَهُ ثَوَابًا دُونَ الْجَنَّةِ  .","","Musnad Abi Ya'la al-Mawsili 2365","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن جعفر بن إياس اليشكري عن هشيم بن بشير عن يعقوب بن ماهان البغدادي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2369","39 - (  2366  ) -  حَدَّثَنَا  سَعِيدُ بْنُ يَحْيَى بْنِ سَعِيدٍ الْأُمَوِيُّ قَالَ :  حَدَّثَنِي  أَبِي  ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  اشْتَدَّ غَضَبُ اللهِ عَلَى مَنْ قَتَلَهُ نَبِيُّ اللهِ         [4/253]      فِي  سَبِيلِ  اللهِ  ، وَاشْتَدَّ غَضَبُ اللهِ عَلَى قَوْمٍ دَمَّوْا وَجْهَ نَبِيِّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Musnad Abi Ya'la al-Mawsili 2366","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن عمرو بن دينار الأثرم عن ابن جريج عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2370","40 - (  2367  ) -  حَدَّثَنَا  سَعِيدُ بْنُ يَحْيَى ، قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ  عَنِ  الشَّعْبِيِّ قَالَ ،  أَخْبَرَنِي  ابْنُ عَبَّاسٍ  أَنَّهُ دَخَلَ قَبْرَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَلِيٌّ  وَالْفَضْلُ  وَأُسَامَةُ         [4/254]      قَالَ : وَأَخْبَرَنِي  مَرْحَبٌ  أَنَّهُمْ أَدْخَلُوا  عَبْدَ الرَّحْمَنِ بْنَ عَوْفٍ  فَكَأَنِّي أَنْظُرُ إِلَيْهِمْ فِي الْقَبْرِ أَرْبَعَةٌ ،  قَالَ  الشَّعْبِيُّ  :  وَمَنْ يَلِي الرَّجُلَ إِلَّا أَهْلُهُ  .","","Musnad Abi Ya'la al-Mawsili 2367","","عبد الله بن عباس عن الشعبي عن إسماعيل بن أبي خالد عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2371","41 - (  2368  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَاصِمٍ الْأَحْوَلِ ، وَحُصَيْنِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ :  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَافَرَ ، فَأَقَامَ تِسْعَ عَشْرَةَ يَقْصُرُ الصَّلَاةَ  ، قَالَ : فَنَحْنُ إِذَا سَافَرْنَا فَأَقَمْنَا تِسْعَ عَشْرَةَ قَصَرْنَا الصَّلَاةَ ، فَإِذَا زِدْنَا عَلَى ذَلِكَ أَتْمَمْنَا  .         [4/255]","","Musnad Abi Ya'la al-Mawsili 2368","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن حصين بن عبد الرحمن السلمي عن الوضاح بن عبد الله اليشكري عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2372","42 - (  2369  ) -  وَعَنْ  أَبِي عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  مَا قَرَأَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى الْجِنِّ وَمَا رَآهُمُ  ، انْطَلَقَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي طَائِفَةٍ مِنْ أَصْحَابِهِ عَامِدِينَ إِلَى  سُوقِ عُكَاظٍ  ، وَقَدْ حِيلَ بَيْنَ الشَّيَاطِينِ وَبَيْنَ خَبَرِ السَّمَاءِ ، وَأُرْسِلَتْ عَلَيْهَا الشُّهُبُ ، فَرَجَعَتِ الشَّيَاطِينُ إِلَى قَوْمِهِمْ ، فَقَالُوا : مَا لَكُمْ ؟ قَالُوا : حِيلَ بَيْنَنَا وَبَيْنَ خَبَرِ السَّمَاءِ ، وَأُرْسِلَتْ عَلَيْنَا الشُّهُبُ ، قَالَ : وَمَا ذَاكَ إِلَّا مِنْ شَيْءٍ حَدَثَ ، فَاضْرِبُوا مَشَارِقَ الْأَرْضِ وَمَغَارِبَهَا ، فَمَرَّ النَّفَرُ الَّذِينَ أَخَذُوا نَحْوَ  تِهَامَةَ  ، وَهُوَ  بِنَخْلَةَ  ، عَامِدِينَ إِلَى  سُوقِ عُكَاظٍ         [4/256]      وَهُوَ يُصَلِّي بِأَصْحَابِهِ صَلَاةَ الْفَجْرِ ، فَلَمَّا سَمِعُوا الْقُرْآنَ اسْتَمَعُوا لَهُ ، وَقَالُوا : هَذَا الَّذِي حَالَ بَيْنَنَا وَبَيْنَ خَبَرِ السَّمَاءِ ، فَرَجَعُوا إِلَى قَوْمِهِمْ ، فَقَالُوا : يَا قَوْمَنَا ، إِنَّا سَمِعْنَا قُرْآنًا عَجَبًا يَهْدِي إِلَى الرُّشْدِ فَآمَنَّا بِهِ ، فَأَوْحَى اللهُ إِلَى نَبِيِّهِ :         {      قُلْ أُوحِيَ إِلَيَّ أَنَّهُ اسْتَمَعَ نَفَرٌ مِنَ الْجِنِّ         }      .         [4/257]","","Musnad Abi Ya'la al-Mawsili 2369","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2373","43 - (  2370  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  حَدَّثَنَا  حَيَّانُ بْنُ عُبَيْدِ اللهِ بْنِ حَيَّانَ أَبُو زُهَيْرٍ الْعَدَوِيُّ ،  حَدَّثَنَا  أَبُو مِجْلَزٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  :  أَنَّ رَايَةَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَتْ سَوْدَاءَ  وَلِوَاؤُهُ أَبْيَضَ  .         [4/258]","","Musnad Abi Ya'la al-Mawsili 2370","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن حيان بن عبيد الله بن حيان البصري عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2374","44 - (  2371  ) -  حَدَّثَنَا  إِبْرَاهِيمُ قَالَ :  حَدَّثَنَا  وُهَيْبٌ ،  عَنْ  عَبْدِ اللهِ بْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَلْحِقُوا الْفَرَائِضَ بِأَهْلِهَا  فَمَا بَقِيَ فَهُوَ لِأَوْلَى رَجُلٍ  ذَكَرٍ  .         [4/259]","","Musnad Abi Ya'la al-Mawsili 2371","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن وهيب بن خالد الكرابيسي عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2375","45 - (  2372  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الدِّينُ  النَّصِيحَةُ  ، قَالُوا : لِمَنْ يَا رَسُولَ اللهِ ؟ قَالَ : لِكِتَابِ اللهِ ، وَلِنَبِيِّهِ ، وَلِأَئِمَّةِ الْمُسْلِمِينَ  .         [4/260]             [4/261]","","Musnad Abi Ya'la al-Mawsili 2372","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن محمد بن مسلم بن سوسن الطائفي عن زيد بن الحباب العكلي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2376","46 - (  2373  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  قِيلَ : يَا رَسُولَ اللهِ -  حِينَ فَرَغَ مِنْ  بَدْرٍ  - عَلَيْكَ  بِالْعِيرِ  لَيْسَ دُونَهَا شَيْءٌ  ، قَالَ : فَنَادَاهُ  الْعَبَّاسُ  : لَا يَصْلُحُ ، قَالَ : فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : لِمَ ؟ قَالَ : لِأَنَّ اللهَ وَعَدَكَ إِحْدَى الطَّائِفَتَيْنِ ، وَقَدْ أَعْطَاكَ مَا وَعَدَكَ  .","","Musnad Abi Ya'la al-Mawsili 2373","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرحيم بن سليمان الأشل عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2377","47 - (  2374  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ ،         [4/262]      حَدَّثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  عُتْبَةَ مَوْلَى ابْنِ عَبَّاسٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  لَمَّا قَدِمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ  الطَّائِفِ  نَزَلَ  الْجِعْرَانَةَ  ، فَقَسَّمَ بِهَا الْغَنَائِمَ  ، ثُمَّ اعْتَمَرَ مِنْهَا ، وَذَلِكَ لِلَيْلَتَيْنِ بَقِيَتَا مِنْ شَوَّالٍ  .         [4/263]","","Musnad Abi Ya'la al-Mawsili 2374","","عبد الله بن عباس عن عتبة مولى ابن عباس عن أبو الزبير المكي عن إبراهيم بن طهمان عن محمد بن الحسن بن الزبير التل عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2378","48 - (  2375  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  عَبِيدَةُ بْنُ حُمَيْدٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  تَمِيمِ بْنِ سَلَمَةَ ،  عَنْ  مَسْرُوقٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَعْرَسَ مِنَ اللَّيْلِ  ، فَرَقَدَ فَلَمْ يَسْتَيْقِظْ إِلَّا بِالشَّمْسِ ، فَأَمَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِلَالًا  ، فَأَذَّنَ ثُمَّ صَلَّى رَكْعَتَيْنِ  .  قَالَ  ابْنُ عَبَّاسٍ  :  فَمَا يَسُرُّنِي بِهِ الدُّنْيَا وَمَا فِيهَا ، يَعْنِي الرُّخْصَةَ  .         [4/264]","","Musnad Abi Ya'la al-Mawsili 2375","","عبد الله بن عباس عن مسروق بن الأجدع عن تميم بن سلمة السلمي عن يزيد بن أبي زياد القرشي عن عبيدة بن حميد بن صهيب التيمي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2379","49 - (  2376  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنْ  أَبِي حَاضِرَةَ الْأَزْدِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  قَلَّتِ الْبُدْنُ عَلَى عَهْدِ رَسُولِ اللهِ ، فَأَمَرَ النَّاسَ بِالْبَقَرَةِ  .","","Musnad Abi Ya'la al-Mawsili 2376","","عبد الله بن عباس عن عثمان بن حاضر الحميري عن عمرو بن ميمون بن مهران عن أبو بكر بن عياش عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2380","50 - (  2377  ) -  حَدَّثَنَا  حَجَّاجُ بْنُ يُوسُفَ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ أَهْلُ الْكِتَابِ يَسْدِلُونَ أَشْعَارَهُمْ وَكَانَ الْمُشْرِكُونَ يَفْرُقُونَ رُؤُوسَهُمْ ،  وَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُعْجِبُهُ مُوَافَقَةُ         [4/265]      أَهْلِ الْكِتَابِ فِي بَعْضِ مَا لَمْ يُؤْمَرْ فِيهِ  ،  فَسَدَلَ  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَاصِيَتَهُ ، ثُمَّ فَرَقَ بَعْدُ  .         [4/266]","","Musnad Abi Ya'la al-Mawsili 2377","","عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن حجاج يوسف الثقفي عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2381","51 - (  2378  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو خَالِدٍ الْأَحْمَرُ ،  عَنِ  الضَّحَّاكِ بْنِ عُثْمَانَ ،  عَنْ  مَخْرَمَةَ بْنِ سُلَيْمَانَ ،  عَنْ  كُرَيْبٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَنْظُرُ اللهُ إِلَى رَجُلٍ أَتَى رَجُلًا أَوِ امْرَأَةً فِي دُبُرِهَا  .","","Musnad Abi Ya'la al-Mawsili 2378","","عبد الله بن عباس عن كريب بن أبي مسلم الحجازي عن مخرمة بن سليمان الوالبي عن الضحاك بن عثمان الحزامي عن سليمان بن حيان الأحمر عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2382","52 - (  2379  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  عَنْ  حَجَّاجٍ ،  عَنِ  الْحَكَمِ ،  عَنْ  مِقْسَمٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  لَمَّا خَرَجَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ  مَكَّةَ  أَخْرَجَ  عَلِيٌّ  ابْنَةَ حَمْزَةَ  ، فَاخْتَصَمَ فِيهَا  عَلِيٌّ  ،  وَزَيْدٌ  ،  وَجَعْفَرٌ  ، فَقَالَ  عَلِيٌّ  : ابْنَةُ أَخِي وَأَنَا أَحَقُّ بِهَا ، وَقَالَ  جَعْفَرٌ  : ابْنَةُ عَمِّي وَخَالَتُهَا عِنْدِي ، وَقَالَ  زَيْدٌ  : بِنْتُ أَخِي  لِحَمْزَةَ  ، آخَى بَيْنَهُمَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : يَا  زَيْدُ  ، أَنْتَ مَوْلَايَ وَمَوْلَاهُمَا ، وَقَالَ  لِعَلِيٍّ  :         [4/267]      أَنْتَ أَخِي وَصَاحِبِي ، وَقَالَ  لِجَعْفَرٍ  : شَبِيهُ خَلْقِي  وَخُلُقِي  ، وَهِيَ إِلَى خَالَتِهَا  .","","Musnad Abi Ya'la al-Mawsili 2379","","عبد الله بن عباس عن مقسم بن بجرة عن الحكم بن عتيبة الكندي عن حجاج بن أرطاة عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2383","53 - (  2380  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  عَنْ  إِبْرَاهِيمَ بْنِ إِسْمَاعِيلَ ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يُشْرَبَ مِنَ الْإِنَاءِ الْمَخْنُوثِ  .         [4/268]             [4/269]","","Musnad Abi Ya'la al-Mawsili 2380","","عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن صالح بن كيسان الدوسي عن إبراهيم بن إسماعيل بن مجمع عن عبيد الله بن موسى عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2384","54 - (  2381  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  الْهُذَيْلُ بْنُ الْحَكَمِ ،  عَنِ  ابْنِ أَبِي رَوَّادٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَوْتُ الْغَرِيبِ شَهَادَةٌ  .","","Musnad Abi Ya'la al-Mawsili 2381","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن عبد العزيز بن أبي رواد الخراساني عن هذيل بن الحكم الأزدي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2385","55 - (  2382  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ قَالَ :  حَدَّثَنِي  الزُّهْرِيُّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،         [4/270]      عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كُنْتُ أَنَا  وَالْفَضْلُ  عَلَى  أَتَانٍ  ، وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي  بِعَرَفَةَ  ، فَمَرَرْنَا عَلَى بَعْضِ الصَّفِّ ، فَنَزَلْنَا عَنْهَا ، وَتَرَكْنَاهَا تَرْتَعُ فِي الصَّفِّ ، فَلَمْ يَقُلْ لَنَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - شَيْئًا  .         [4/271]","","Musnad Abi Ya'la al-Mawsili 2382","","عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2386","56 - (  2383  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  اسْتَفْتَى  سَعْدُ بْنُ عُبَادَةَ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فِي نَذْرٍ كَانَ عَلَى أُمِّهِ تُوُفِّيَتْ قَبْلَ أَنْ تَقْضِيَهُ ، فَقَالَ : اقْضِهِ عَنْهَا  .         [4/272]","","Musnad Abi Ya'la al-Mawsili 2383","","عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2387","57 - (  2384  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنَا  الزُّهْرِيُّ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ :  أَنَّ  امْرَأَةً مِنْ خَثْعَمَ  سَأَلَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - غَدَاةَ النَّحْرِ ، فَقَالَتْ :  إِنَّ فَرِيضَةَ اللهِ فِي  الْحَجِّ  أَدْرَكَتْ أَبِي وَهُوَ شَيْخٌ كَبِيرٌ لَا يَسْتَطِيعُ أَنْ يَسْتَمْسِكَ عَلَى الرَّحْلِ  ، أَفَهَلْ تَرَى أَنْ نَحُجَّ عَنْهُ ؟ قَالَ : نَعَمْ  .         [4/273]","","Musnad Abi Ya'la al-Mawsili 2384","","عبد الله بن عباس عن سليمان بن يسار مولى ميمونة زوج رسول الله عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2388","58 - (  2385  ) -  وَعَنِ  ابْنِ عُيَيْنَةَ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنِ  ابْنِ وَعْلَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  أَيُّمَا  إِهَابٍ  دُبِغَ فَقَدْ طَهُرَ  .         [4/274]","","Musnad Abi Ya'la al-Mawsili 2385","","عبد الله بن عباس عن عبد الرحمن بن وعلة السبائي عن زيد بن أسلم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2389","59 - (  2386  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ أَبِي يَزِيدَ قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ يَقُولُ :  كُنْتُ مِمَّنْ قَدَّمَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي ضَعَفَةِ أَهْلِهِ مِنَ  الْمُزْدَلِفَةِ  إِلَى  مِنًى  .         [4/275]","","Musnad Abi Ya'la al-Mawsili 2386","","عبد الله بن عباس عن عبيد الله بن أبي يزيد الكناني عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2390","60 - (  2387  ) -  وَعَنِ  ابْنِ عُيَيْنَةَ قَالَ :  حَدَّثَنِي  سُلَيْمَانُ بْنُ سُحَيْمٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ عَبْدِ اللهِ بْنِ مَعْبَدِ بْنِ عَبَّاسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَشَفَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - السِّتَارَةَ وَالنَّاسُ صُفُوفٌ خَلْفَ  أَبِي بَكْرٍ  ، فَقَالَ :  يَا أَيُّهَا النَّاسُ ، إِنَّهُ لَمْ يَبْقَ مِنْ مُبَشِّرَاتِ النُّبُوَّةِ إِلَّا الرُّؤْيَا الصَّالِحَةَ يَرَاهَا الْمُسْلِمُ ، أَوْ تُرَى لَهُ  ، أَلَا وَإِنِّي نُهِيتُ أَنْ أَقْرَأَ  رَاكِعًا  أَوْ سَاجِدًا ، فَأَمَّا الرُّكُوعُ فَعَظِّمُوا فِيهِ الرَّبَّ ، وَأَمَّا السُّجُودُ فَاجْتَهِدُوا فِي الدُّعَاءِ ، فَقَمِنٌ أَنْ يُسْتَجَابَ لَكُمْ  .         [4/276]","","Musnad Abi Ya'la al-Mawsili 2387","","عبد الله بن عباس عن عبد الله بن معبد بن العباس بن عبد المطلب عن إبراهيم بن عبد الله بن معبد بن عباس بن عبد المطلب عن سليمان بن سحيم  الحجازي عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2391","61 - (  2388  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  عَمْرٍو ،  عَنْ  مُحَمَّدِ بْنِ جُبَيْرٍ ،         [4/277]      عَنِ  ابْنِ عَبَّاسٍ قَالَ :  تَعَجَّبْتُ مِمَّنْ يَتَقَدَّمُ  الشَّهْرَ  ، وَقَدْ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا رَأَيْتُمُوهُ فَصُومُوا ، وَإِذَا رَأَيْتُمُوهُ فَأَفْطِرُوا  ، فَإِنْ  غُمَّ  عَلَيْكُمْ فَأَكْمِلُوا الْعِدَّةَ ثَلَاثِينَ  .","","Musnad Abi Ya'la al-Mawsili 2388","","عبد الله بن عباس عن محمد بن جبير بن مطعم النوفلي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2392","62 - (  2389  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  عَمْرٍو ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ :  أُمِرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَسْجُدَ عَلَى سَبْعٍ  ، وَنُهِيَ أَنْ  يَكُفَّ  شَعَرَهُ وَثِيَابَهُ  .         [4/278]","","Musnad Abi Ya'la al-Mawsili 2389","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2393","63 - (  2390  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  عَمْرٍو ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ :  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - احْتَجَمَ وَهُوَ مُحْرِمٌ  .         [4/279]","","Musnad Abi Ya'la al-Mawsili 2390","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2394","64 - (  2391  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  عَمْرٍو ،  سَمِعَ  أَبَا مَعْبَدٍ ،  سَمِعَ  ابْنَ عَبَّاسٍ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَقُولُ :  لَا يَخْلُوَنَّ رَجُلٌ بِامْرَأَةٍ ، وَلَا تُسَافِرِ امْرَأَةٌ إِلَّا وَمَعَهَا ذُو  مَحْرَمٍ  ، فَقَامَ  رَجُلٌ  ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي  اكْتُتِبْتُ  فِي غَزْوَةِ كَذَا وَكَذَا ، وَانْطَلَقَتِ امْرَأَتِي حَاجَّةً ، قَالَ : فَانْطَلِقْ ، فَاحْجُجْ مَعَ امْرَأَتِكَ  .","","Musnad Abi Ya'la al-Mawsili 2391","","عبد الله بن عباس عن نافذ المكي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2395","65 - (  2392  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  عَمْرٍو قَالَ :  أَخْبَرَنِي  بِذَا أَبُو مَعْبَدٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : ثُمَّ أَنْكَرَهُ بَعْدُ عَنِ  ابْنِ عَبَّاسٍ         [4/280]      قَالَ :  كُنَّا نَعْرِفُ انْقِضَاءَ صَلَاةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِالتَّكْبِيرِ  .","","Musnad Abi Ya'la al-Mawsili 2392","","عبد الله بن عباس عن نافذ المكي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2396","66 - (  2393  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  عَمْرٍو ،  عَنْ  جَابِرٍ ،         [4/281]      عَنِ  ابْنِ عَبَّاسٍ :  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَكَحَ  مَيْمُونَةَ  وَهُوَ مُحْرِمٌ  .         [4/282]","","Musnad Abi Ya'la al-Mawsili 2393","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2397","67 - (  2394  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  عَمْرٍو ،  عَنْ  أَبِي الشَّعْثَاءِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  صَلَّيْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِالْمَدِينَةِ  ثَمَانِيًا جَمِيعًا  وَسَبْعًا جَمِيعًا  .         [4/283]","","Musnad Abi Ya'la al-Mawsili 2394","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2398","68 - (  2395  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  عَمْرٍو قَالَ :  أَخْبَرَنِي  أَبُو الشَّعْثَاءِ ،  أَنَّهُ سَمِعَ  ابْنَ عَبَّاسٍ ،  سَمِعَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَخْطُبُ :  مَنْ لَمْ         [4/284]      يَجِدْ نَعْلَيْنِ لَبِسَ خُفَّيْنِ  ، وَمَنْ لَمْ يَجِدْ إِزَارًا لَبِسَ سَرَاوِيلَ  .         [4/285]","","Musnad Abi Ya'la al-Mawsili 2395","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2399","69 - (  2396  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  عَمْرٍو ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَخْطُبُ ، وَهُوَ يَقُولُ :  إِنَّكُمْ مُلَاقُو اللهِ حُفَاةً عُرَاةً مُشَاةً  غُرْلًا  .         [4/286]","","Musnad Abi Ya'la al-Mawsili 2396","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","أول مسند ابن عباس"
"2400","70 - (  2397  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  أَخْبَرَنَا  عَمْرٌو ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  لَيْسَ  الْمُحَصَّبُ  بِشَيْءٍ  ، إِنَّمَا هُوَ مَنْزِلٌ         [4/287]      نَزَلَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Musnad Abi Ya'la al-Mawsili 2397","","عبد الله بن عباس عن عطاء بن أبي رباح عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","أول مسند ابن عباس"
