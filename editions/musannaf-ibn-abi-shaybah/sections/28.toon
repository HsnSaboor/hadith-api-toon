hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"27055","(۲۷۰۵۵) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی السَّفَرِ ، قَالَ : سَمِعْتُ أَبَا بَکْرِ بْنَ أَبِی مُوسَی یُحَدِّثُ عَنِ الْبَرَائِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا اسْتَیْقَظَ قَالَ : الْحَمْدُ لِلَّہِ الَّذِی أَحْیَانَا بَعْدَ مَا أَمَاتَنَا وَإِلَیْہِ النُّشُورُ ، قَالَ شُعْبَۃُ : ہَذَا ، أَوْ نَحْوَ ہَذَا وَإِذَا نَامَ قَالَ : اللَّہُمَّ بِاسْمِکَ أَحْیَا وَبِاسْمِکَ أَمُوتُ۔ (مسلم ۲۰۸۳۔ احمد ۳۰۲)","Sahih","Musannaf Ibn Abi Shaybah 27055","","","كتاب الأدب"
"27056","(۲۷۰۵۶) حَدَّثَنَا ابْنُ نُمَیْرٍ قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَن سَعِیدِ بْنِ أَبِی سَعِیدٍ الْمَقْبُرِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إذَا أَرَادَ أَحَدُکُمْ أَنْ یَضْطَجِعَ عَلَی فِرَاشِہِ فَلْیَنْزِعْ دَاخِلَۃَ إزَارِہِ ، ثُمَّ لِیَنْفُضْ بِہَا فِرَاشَہُ فَإِنَّہُ لاَ یَدْرِی مَا خَلَّفَہُ عَلَیْہِ ، ثُمَّ لِیَضْطَجِعْ عَلَی شِقِّہِ الأَیْمَنِ ، ثُمَّ لِیَقُلْ ، بِاسْمِکَ رَبِّی وَضَعْت جَنْبِی وَبِکَ أَرْفَعُہُ ، فَإِنْ أَمْسَکْت نَفْسِی فَارْحَمْہَا ، وَإِنْ أَرْسَلْتَہَا فَاحْفَظْہَا بِمَا تَحْفَظُ بِہِ عِبَادَک الصَّالِحِینَ۔ (بخاری ۷۳۹۳۔ ترمذی ۳۴۰۱)","Sahih","Musannaf Ibn Abi Shaybah 27056","","","كتاب الأدب"
"27057","(۲۷۰۵۷) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَن سَعْدِ بْنِ عُبَیْدَۃَ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ قَالَ لِرَجُلٍ : إذَا أَخَذْت مَضْجَعَک فَقُلْ : اللَّہُمَّ أَسْلَمْت نَفْسِی إلَیْک ، وَوَجَّہْت وَجْہِی إلَیْک ، وَفَوَّضْت أَمْرِی إلَیْک ، وَأَلْجَأْت ظَہْرِی إلَیْک رَغْبَۃً وَرَہْبَۃً إلَیْک ، لاَ مَنْجَی ، وَلاَ مَلْجَأَ مِنْک إلاَّ إلَیْک ، آمَنْت بِکِتَابِکَ الَّذِی أَنْزَلْت ، وَنَبِیِّکَ الَّذِی أَرْسَلْت ، فَإِنْ مُتَّ ، مُتَّ عَلَی الْفِطْرَۃِ۔n(بخاری ۲۴۷۔ مسلم ۲۰۸۱)","Sahih","Musannaf Ibn Abi Shaybah 27057","","","كتاب الأدب"
"27058","(۲۷۰۵۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن حَبِیبٍ ، عَنْ عَبْدِ اللہِ بْنِ بَابَاہُ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : مَنْ قَالَ حِینَ یَأْوِی إلَی فِرَاشِہِ، لاَ إلَہَ إلاَّ اللَّہُ وَحْدَہُ، لاَ شَرِیکَ لَہُ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ، سُبْحَانَ اللہِ وَبِحَمْدِہِ الحَمدُ للہ ، لاَ إلَہَ إلاَّ اللَّہُ ، اللَّہُ أَکْبَرُ ، غُفِرْت ذُنُوبُہُ ، وَإِنْ کَانَتْ مِثْلَ زَبَدِ الْبَحْرِ۔n(ابن حبان ۵۵۲۸)","Sahih","Musannaf Ibn Abi Shaybah 27058","","","كتاب الأدب"
"27059","(۲۷۰۵۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ قَالَ: حدَّثَنَا زُہَیْرٌ ، عَنْ أَبِی إِسْحَاقَ، عَن فَرْوَۃَ بْنِ نَوْفَلٍ، عَنْ أَبِیہِ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لَہُ : مَجِیئٌ مَا جَائَ بِکَ ؟ قَالَ : جِئْت یَا رَسُولَ اللہِ تُعَلِّمُنِی شَیْئًا عِنْدَ مَنَامِی، قَالَ: إذَا أَخَذْت مَضْجَعَک فَاقْرَأْ {قُلْ یَا أَیُّہَا الْکَافِرُونَ} ثُمَّ نَمْ عَلَی خَاتِمَتِہَا فَإِنَّہَا بَرَائَۃٌ مِنَ الشِّرْکِ۔n(ابوداؤد ۵۰۱۶۔ دارمی ۳۴۲۷)","","Musannaf Ibn Abi Shaybah 27059","","","كتاب الأدب"
"27060","(۲۷۰۶۰) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ نَوْفَلٍ الأَشْجَعِیِّ ، عَنْ أَبِیہِ قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، أَخْبِرْنِی بِشَیْئٍ أَقُولُہُ إذَا أَصْبَحْتُ وَإِذَا أَمْسَیْتُ ؟ قَالَ : اقْرَأْ {قُلْ یَا أَیُّہَا الْکَافِرُونَ} ثُمَّ نَمْ عَلَی خَاتِمَتِہَا فَإِنَّہَا بَرَائَۃٌ مِنَ الشِّرْکِ۔","Da'if","Musannaf Ibn Abi Shaybah 27060","","","كتاب الأدب"
"27061","(۲۷۰۶۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ قَالَ : حدَّثَنَا زُہَیْرٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمٍ ، عَنْ عَلِیٍّ قَالَ : إذَا أَخَذْتَ مَضْجَعَک فَقُلْ : بِسْمِ اللہِ وَفِی سَبِیلِ اللہِ وَعَلَی مِلَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَحِینَ تُدْخِلُ الْمَیِّتَ قَبْرَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 27061","","","كتاب الأدب"
"27062","(۲۷۰۶۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَاصِمٍ ، عَن سَوَائٍ ، عَن حَفْصَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا أَخَذَ مَضْجَعَہُ قَالَ : رَبِّ قِنِی عَذَابَک یَوْمَ تَبْعَثُ عِبَادَک۔n(ابوداؤد ۵۰۰۶۔ احمد ۲۸۸)","Da'if","Musannaf Ibn Abi Shaybah 27062","","","كتاب الأدب"
"27063","(۲۷۰۶۳) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِرَجُلٍ : یَا فُلاَنُ ، إذَا أَوَیْت إلَی فِرَاشِکَ فَقُلْ : اللَّہُمَّ أَسْلَمْت نَفْسِی إلَیْک ، وَوَجَّہْت وَجْہِی إلَیْک وَوَلَّیْت ظَہْرِی إلَیْک ، لاَ مَلْجَأَ وَلاَ مَنْجَی مِنْک إلاَّ إلَیْک ، آمَنْتُ بِکِتَابِکَ الَّذِی أَنْزَلْت ، وَنَبِیِّکَ الَّذِی أَرْسَلْت فَإِنَّک مِتَّ مِنْ لَیْلَتِکَ مِتَّ عَلَی الْفِطْرَۃِ ، فَإِنْ أَصْبَحْت أَصَبْتَ خَیْرًا۔ (بخاری ۷۴۸۸۔ احمد ۲۹۹)","Sahih","Musannaf Ibn Abi Shaybah 27063","","","كتاب الأدب"
"27064","(۲۷۰۶۴) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنِ الأَفْرِیقِیِّ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لِرَجُلٍ مِنَ الأَنْصَارِ : کَیْفَ تَقُولُ حِینَ تُرِیدُ أَنْ تَنَامَ ؟ قَالَ : أَقُولُ بِاسْمِکَ وَضَعْت جَنْبِی فَاغْفِرْ لِی قَالَ : قَدْ غُفِرَ لَک۔ (نسائی ۱۰۶۰۶۔ احمد ۱۷۳)","Da'if","Musannaf Ibn Abi Shaybah 27064","","","كتاب الأدب"
"27065","(۲۷۰۶۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن زَائِدَۃَ ، عَن مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ : کَانَ أَصْحَابُنَا یَأْمُرُونَنَا وَنَحْنُ غِلْمَانٌ إذَا أَوَیْنَا إلَی فِرَاشِنَا أَنْ نُسَبِّحَ ثَلاَثًا وثَلاَثِینَ ، وَنَحْمَدَ ثَلاَثًا وَثَلاَثِینَ ، وَنُکَبِّرَ أَرْبَعًا وَثَلاَثِینَ۔","","Musannaf Ibn Abi Shaybah 27065","","","كتاب الأدب"
"27066","(۲۷۰۶۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَنِ الْمُسَیَّبِ ، عَن حَفْصَۃَ قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا أَخَذَ مَضْجَعَہُ وَضَعَ یَدَہُ الْیُمْنَی تَحْتَ خَدِّہِ الأَیْمَنِ۔","","Musannaf Ibn Abi Shaybah 27066","","","كتاب الأدب"
"27067","(۲۷۰۶۷) حَدَّثَنَا عُبَیْدُ بْنُ سَعِیدٍ ، عَن شُعْبَۃَ ، عَنْ أَبِی المُؤَمِّلِ ، عَنِ الزُّہْرِیِّ ، عَن عُرْوَۃَ ، عَنْ عَائِشَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا صَلَّی رَکْعَتَیِ الْفَجْرِ اضْطَجَعَ وَوَضَعَ یَدَہُ الْیُمْنَی تَحْتَ خَدِّہِ الأَیْمَنِ۔n(بخاری ۶۲۶۔ مسلم ۱۲۱)","Da'if","Musannaf Ibn Abi Shaybah 27067","","","كتاب الأدب"
"27068","(۲۷۰۶۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا نَامَ تَوَسَّدَ یَمِینَہُ تَحْتَ خَدِّہِ وَیَقُولُ : قِنِی عَذَابَک یَوْمَ تَبْعَثُ عِبَادَک۔ (احمد ۲۹۰)","","Musannaf Ibn Abi Shaybah 27068","","","كتاب الأدب"
"27069","(۲۷۰۶۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ کَانَ إذَا نَامَ قَالَ : اللَّہُمَّ قِنِی عَذَابَک یَوْمَ تَجْمَعُ عِبَادَک ، وَکَانَ یَضَعُ یَمِینَہُ تَحْتَ خَدِّہِ۔ (ترمذی ۲۵۵۔ احمد ۳۹۴)","","Musannaf Ibn Abi Shaybah 27069","","","كتاب الأدب"
"27070","(۲۷۰۷۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ قَالَ : حدَّثَنَا عُبَیْدُ اللہِ ، عَن سَعِیدِ بْنِ أَبِی سَعِیدٍ الْمَقْبُرِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إذَا أَرَادَ أَحَدُکُمْ أَنْ یَضْطَجِعَ عَلَی فِرَاشِہِ فَلْیَضْطَجِعْ عَلَی شِقِّہِ الأَیْمَنِ۔","Sahih","Musannaf Ibn Abi Shaybah 27070","","","كتاب الأدب"
"27071","(۲۷۰۷۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَن سُفْیَانَ ، عَن سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ أَبِیہِ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا أَصْبَحَ قَالَ : أَصْبَحْنَا عَلَی فِطْرَۃِ الإِسْلاَمِ ، وَکَلِمَۃِ الإِخْلاَصِ ، وَدِینِ نَبِیِّنَا مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَمِلَّۃِ أَبِینَا إبْرَاہِیمَ حَنِیفًا مُسْلِمًا وَمَا کَانَ مِنَ الْمُشْرِکِینَ۔ (احمد ۴۰۷۔ دارمی ۲۶۸۸)","Hasan","Musannaf Ibn Abi Shaybah 27071","","","كتاب الأدب"
"27072","(۲۷۰۷۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ قَالَ : حدَّثَنَا مِسْعَرٌ قَالَ : حَدَّثَنِی أَبُو عَقِیلٍ ، عَن سَابِقٍ ، عَنْ أَبِی سَلاَّمٍ خَادِمِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : مَا مِنْ مُسْلِمٍ ، أَوْ إنْسَانٍ ، أَوْ عَبْدٍ یَقُولُ حِینَ یُمْسِی وَیُصْبِحُ ثَلاَثَ مَرَّاتٍ : رَضِیت بِاللَّہِ رَبًّا وَبِالإِسْلاَمِ دِینًا وَبِمُحَمَّدٍ نَبِیًّا إلاَّ کَانَ حَقًّا عَلَی اللہِ أَنْ یُرْضِیَہُ یَوْمَ الْقِیَامَۃِ۔n(ابن ماجہ ۳۸۷۰)","Da'if","Musannaf Ibn Abi Shaybah 27072","","","كتاب الأدب"
"27073","(۲۷۰۷۳) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَن مَنْصُورٍ ، عَن رِبْعِیِّ بْنِ حِرَاشٍ ، عَن رَجُلٍ مِنَ النَّخْعِ ، عَن سَلْمَانَ قَالَ : مَنْ قَالَ إذَا أَصْبَحَ : اللَّہُمَّ أَنْتَ رَبِّی لاَ شَرِیکَ لَکَ ، أَصْبَحْنَا وَأَصْبَحَ الْمُلْکُ لِلَّہِ ، وَالْحَمْدُ لِلَّہِ لاَ شَرِیکَ لَہُ وَإِذَا أَمْسَی مِثْلُ ذَلِکَ ، کَانَ کَفَّارَۃً لِمَا أحْدَثَ بَیْنَہُمَا۔","Da'if","Musannaf Ibn Abi Shaybah 27073","","","كتاب الأدب"
"27074","(۲۷۰۷۴) حَدَّثَنَا ابْنُ إدْرِیسَ، عَن حُصَیْنٍ، عَن تَمِیمِ بْنِ سَلَمَۃَ، عَنْ عَبْدِاللہِ بْنِ سَبْرَۃَ، عَنِ ابْنِ عُمَرَ، أَنَّہُ کَانَ یَقُولُ إذَا أَصْبَحَ وَأَمْسَی : اللَّہُمَّ اجْعَلْنِی مِنْ أَفْضَلِ عِبَادِکَ الْغَدَاۃَ ، أَوِ الْعَشِیَّۃَ نَصِیبًا مِنْ خَیْرٍ تَقْسِمُہُ ، أو نُورًا تَہْدِی بِہِ، أو رَحْمَۃً تَنْشُرُہَا، أو رِزْقًا تَبْسُطُہُ، أو ضر تَکْشِفُہُ، أو بَلاَئً تدْفَعُہُ، أو فِتْنَۃً تَصْرِفُہَا، أو شَرًّا تَدْفَعُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 27074","","","كتاب الأدب"
"27075","(۲۷۰۷۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن حُصَیْنٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ قَالَ : قُلْتُ لِسَعِیدِ بْنِ الْمُسَیَّبِ : مَا تَقُولُون إذَا أَصْبَحْتُمْ وَأَمْسَیْتُمْ مِمَّا تَدْعُونَ بِہِ ؟ قَالَ : تَقُولُ : أَعُوذُ بوجہ اللہِ الْکَرِیمِ ، وَبِسْمِ اللہِ الْعَظِیمِ ، وَکَلِمَۃِ اللہِ التَّامَّۃِ ، مِنْ شَرِّ السَّآمَّۃِ وَالْعامَّۃِ ، وَمِنْ شَرِّ مَا خَلَقْت أَیْ رَبِّی ، وَشَرِّ مَا أَنْتَ آخِذٌ بِنَاصِیَتِہِ ، وَمِنْ شَرِّ ہَذَا الْیَوْمِ ، وَمِنْ شَرِّ مَا بَعْدَہُ ، وَشَرِّ الدُّنْیَا وَالآخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 27075","","","كتاب الأدب"
"27076","(۲۷۰۷۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَن مُوسَی الْجُہَنِیِّ قَالَ : حدَّثَنِی رَجُلٌ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّہُ قَالَ : مَنْ قَالَ (فَسُبْحَانَ اللہِ حِینَ تُمْسُونَ وَحِینَ تُصْبِحُونَ) حَتَّی یَفْرُغَ مِنَ الآیَۃِ ثَلاَثَ مَرَّاتٍ ، أَدْرَکَ مَا فَاتَہُ مِنْ یَوْمِہِ ، وَمَنْ قَالَہَا لَیلاً أَدْرَکَ مَا فَاتَہُ مِنْ یَوْمِہِ۔ (ابوداؤد ۵۰۳۷)","","Musannaf Ibn Abi Shaybah 27076","","","كتاب الأدب"
"27077","(۲۷۰۷۷) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ سُہَیْل بن أبی صالح ، عَنْ أَبِیہِ ، عَنِ أبی عیاش قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَالَ حِینَ یُصْبِحُ لاَ إلَہَ إلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ کَانَ لَہُ کَعَدْلِ رَقَبَۃٍ مِنْ وَلَدِ إسْمَاعِیلَ ، وَکُتِبَ لَہُ بہا عَشْرُ حَسَنَاتٍ ، وَحُطَّ عَنہُ بِہَا عَشْرُ سَیِّئَاتٍ ، وَرُفِعَتْ لَہُ بِہَا عَشْرُ دَرَجَاتٍ ، وَکَانَ فِی حِرْزٍ مِنَ الشَّیْطَانِ حَتَّی یُمْسِیَ ، وَإِذَا أَمْسَی مِثْلَ ذَلِکَ حَتَّی یُصْبِحَ۔ (ابن ماجہ ۳۸۶۷۔ احمد ۶۰)","Sahih","Musannaf Ibn Abi Shaybah 27077","","","كتاب الأدب"
"27078","(۲۷۰۷۸) حَدَّثَنَا وَکِیعٌ ، عَن سَعِیدِ بْنِ صَالِحٍ ، عَن رَجُلٍ لَمْ یُسَمِّہِ ، أَنَّ عُمَرَ کَتَبَ : لاَ تُخَلِّلُوا بِالْقَصَبِ۔","Da'if","Musannaf Ibn Abi Shaybah 27078","","","كتاب الأدب"
"27079","(۲۷۰۷۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ أَبِی بَکْرٍ الغسََّانِیِّ ، عَن ضَمُرَۃَ بْنِ حَبِیبٍ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ السِّوَاکِ بِعُودِ الرَّیْحَانِ وَالرُّمَّانِ ، وَقَالَ یُحَرِّکُ عِرْقَ الْجُذَامِ۔","Da'if","Musannaf Ibn Abi Shaybah 27079","","","كتاب الأدب"
"27080","(۲۷۰۸۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ قَالَ : مَرَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی مَجْلِسٍ لِلأََنْصَارِ فَقَالَ : إِنْ أَبَیْتُمْ أَنْ لاَ تَجْلِسُوا فَاہْدُوا السَّبِیلَ ، وَردوا السَّلام ، وَأَعِینُوا الْمَظْلُومَ۔ (ترمذی ۲۷۲۶۔ احمد ۲۸۲)","","Musannaf Ibn Abi Shaybah 27080","","","كتاب الأدب"
"27081","(۲۷۰۸۱) حَدَّثَنَا ابْنُ نُمَیْرٍ قَالَ : حدَّثَنَا مُوسَی بْنُ عُبَیْدَۃ ، عَنْ أَیُّوبَ بْنِ خَالِدٍ ، عَن مَالِکِ بْنِ التَّیْہَانِ قَالَ : اجْتَمَعَتْ جَمَاعَۃٌ مِنَّا عِنْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقُلْنَا : یَا رَسُولَ اللہِ ، إنَّا أَہْلُ سَافِلَۃٍ وَأَہْلُ عَالِیَۃٍ ، نَجْلِسُ ہَذِہِ الْمَجَالِسَ فَمَا تَأْمُرُنَا ؟ قَالَ : أَعْطُوا الْمَجَالِسَ حَقَّہَا ، قُلْنَا وَمَا حَقہَا : قَالَ : غُضُّوا أَبْصَارَکُمْ ، وَرُدُّوا السَّلاَمَ ، وَأَرْشِدُوا الأَعْمَی ، وَأْمُرُوا بِالْمَعْرُوفِ ، وَانْہَوْا عَنِ الْمُنْکَرِ۔ (مسند ۶۸۵)","Da'if","Musannaf Ibn Abi Shaybah 27081","","","كتاب الأدب"
"27082","(۲۷۰۸۲) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِیَادٍ قَالَ : حَدَّثَنَا عُثْمَانُ بْنُ حَکِیمٍ قَالَ : حَدَّثَنَی إِسْحَاقُ بْنُ عَبْدِ اللہِ بْنِ أَبِی طَلْحَۃَ قَالَ : حَدَّثَنِی أَبِی قَالَ : قَالَ أَبُو طَلْحَۃَ : کُنَّا جُلُوسًا بِالأَفْنِیَۃِ ، فَمَرَّ بِنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : مَا لَکُمْ وَلِمَجَالِسِ الصُّعُدَاتِ اجتنبوا مجالس الصُّعُدَاتِ ؟ قَالَ : قُلْنَا : یَا رَسُولَ اللہِ ، إنَّا جَلَسْنَا بِغَیْرِ مَا بَأْسٍ نَتَذَاکَرُ وَنَتَحَدَّثُ ، قَالَ : فأَعْطُوا الْمَجَالِسَ حَقَّہَا ، قَالَ : قُلْنَا : وَمَا حَقُّہَا یَا رَسُولَ اللہِ ؟ قَالَ : غَضُّ الْبَصَرِ ، وَرَدُّ السَّلاَمِ ، وَحُسْنُ الْکَلاَمِ۔ (احمد ۳۰۔ ابویعلی ۱۴۱۷)","Sahih","Musannaf Ibn Abi Shaybah 27082","","","كتاب الأدب"
"27083","(۲۷۰۸۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَن مَالِکِ بْنِ مِغْوَلٍ ، عَنِ الشَّعْبِیِّ قَالَ : مَا جَلَسَ الرَّبِیعُ بْنُ خُثَیْمٍ مَجْلِسًا مُنْذُ تَأَزَّرَ بِإِزَارٍ ، قَالَ : أَخَافُ أَنْ یُظْلَمَ رَجُلٌ فَلاَ أنصرہ ، أَوْ یَفْتَرِی رَجُلٌ عَلَی رَجُلٍ فَأُکَلَّفُ الشَّہَادَۃَ عَلَیْہِ ، وَلاَ أَغُضُّ الْبَصَرَ ، وَلاَ أَہْدِی السَّبِیلَ ، أَوْ تَقَعُ الْحَامِلَۃُ فَلاَ أَحْمِلُ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 27083","","","كتاب الأدب"
"27084","(۲۷۰۸۴) حَدَّثَنَا ہُشَیم ، عَنِ الْعَوَّامِ ، عَنِ ابْنِ أَبِی الْہُذَیْلِ قَالَ : کَانُوا یَکْرَہُونَ إذَا اتَّخَذُوا الْمَجَالِسَ أَنْ یعروہا لِلسُّفَہَائِ۔","","Musannaf Ibn Abi Shaybah 27084","","","كتاب الأدب"
"27085","(۲۷۰۸۵) حَدَّثَنَا مَحْبُوبُ الْقَوَارِیرِیُّ ، عَنِ الصَّعْبِ بْنِ حَکِیمٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ قَالَ : أَتَیْتُ عُمَرَ بْنَ الْخَطَّابِ فَجَعَلَ یَقُولُ : یَا ابْنَ أَخِی ، ثُمَّ سَأَلَنِی فَانْتَسَبْت لَہُ ، فَعَرَفَ ، أَنَّ أَبِی لَمْ یُدْرِکِ الإِسْلاَمَ ، فَجَعَلَ یَقُولُ : یَا بُنَیَّ یَا بُنَیَّ۔","Da'if","Musannaf Ibn Abi Shaybah 27085","","","كتاب الأدب"
"27086","(۲۷۰۸۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : حدَّثَنَا إسْمَاعِیلُ ، عَن قَیْسٍ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ قَالَ : مَا سَأَلَ أَحَدٌ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الدَّجَّالِ ، أَکْثَرَ مِمَّا سَأَلْتُہُ ، فَقَالَ : أَیْ بُنَیَّ ، وَمَا یُصِیبُک مِنْہُ۔n(مسلم ۱۶۹۳۔ ابن ماجہ ۴۰۷۳)","Sahih","Musannaf Ibn Abi Shaybah 27086","","","كتاب الأدب"
"27087","(۲۷۰۸۷) حَدَّثَنَا وَکِیعٌ ، عَن ہِشَامٍ ، عَنْ أَبِی وَجْزَۃَ السَّعْدِیِّ ، عَن رَجُلٍ مِنْ مُزَیْنَۃَ ، عَن عُمَرَ بْنِ أَبِی سَلَمَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أُتِیَ بِطَعَامٍ فَقَالَ : یَا عُمَرُ یَا بُنَیَّ ، سَمِّ اللَّہَ وَکُلْ بِیَمِینِکَ وَکُلْ مِمَّا یَلِیک۔n(ابوداؤد ۳۷۷۱۔ احمد ۲۶)","Da'if","Musannaf Ibn Abi Shaybah 27087","","","كتاب الأدب"
"27088","(۲۷۰۸۸) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، عَنِ الْجَعْدِ أَبِی عُثْمَانَ ، عَنْ أَنَسٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لَہُ : یَا بُنَیَّ۔ (مسلم ۱۶۹۳۔ ابوداؤد ۴۹۲۵)","Sahih","Musannaf Ibn Abi Shaybah 27088","","","كتاب الأدب"
"27089","(۲۷۰۸۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَن عُمَارَۃَ بْنِ زَاذَانَ ، عَن مَکْحُولٍ الأَزْدِیِّ قَالَ : سُئِلَ ابْنُ عُمَرَ عَنِ الرَّجُلِ یُحْرِمُ مِنْ سَمَرْقَنْدَ ، أَوْ مِنْ خُرَاسَانَ ، أَوْ مِنَ الْکُوفَۃِ فَقَالَ : یَا لَیْتَنَا نَنْفَلِتُ مِنْ وَقْتِنَا یَا بُنَیَّ۔","Da'if","Musannaf Ibn Abi Shaybah 27089","","","كتاب الأدب"
"27090","(۲۷۰۹۰) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ أَبِی جَمْرَۃَ قَالَ : حدَّثَنَا إیَاسٌ عن قَتَادَۃَ ، عَن قَیْسِ بْنِ عُبَادٍ ، أَنَّ أُبَیَّ بْنَ کَعْبٍ قَالَ لَہُ : یَا بُنَیَّ ، لاَ یَسُوئُک اللَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 27090","","","كتاب الأدب"
"27091","(۲۷۰۹۱) حَدَّثَنَا جَرِیرٌ ، عَن قَابُوسَ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، أَنَّہُ قَالَ : یَا بُنَیَّ۔","Da'if","Musannaf Ibn Abi Shaybah 27091","","","كتاب الأدب"
"27092","(۲۷۰۹۲) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ الرَّازِیّ ، عَن نُعَیْمٍ قَالَ : سَأَلْتُ عَاصِمًا ، عَن قَوْلِ اللہِ : {فَنَادَاہَا مِنْ تَحْتِہَا} قَالَ : {مِنْ تَحْتَہَا} مَفْتُوحَۃً ، قُلْتُ : عَمَّنْ تَرْوِی ؟ قَالَ : عَن زِرٍّ یَا بُنَیَّ۔","","Musannaf Ibn Abi Shaybah 27092","","","كتاب الأدب"
"27093","(۲۷۰۹۳) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ الزِّبْرِقَانِ ، قَالَ : قَالَ لِی أَبُو وَائل یَا بُنَیَّ۔","","Musannaf Ibn Abi Shaybah 27093","","","كتاب الأدب"
"27094","(۲۷۰۹۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ قَالَ : قُلْتُ لابْنِ صَاحِبٍ لِی : یَا بُنَیَّ ، فَکَرِہَ ذَلِکَ إبْرَاہِیمُ۔","","Musannaf Ibn Abi Shaybah 27094","","","كتاب الأدب"
"27095","(۲۷۰۹۵) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِیہِ ، عَن مُحَارِبٍ ، عَنِ شُتَیر بن شَکَل أَنَ امْرَأَۃً قَالَتْ لَہُ : یَا بُنَیَّ ، فَقَالَ : وَلَدْتنِی ، قَالَتْ : لاَ ، قَالَ : فَأَرْضَعْتنِی ؟ قَالَتْ : لاَ ، قَالَ : فَلِمَ تَکْذِبِینَ ؟۔","","Musannaf Ibn Abi Shaybah 27095","","","كتاب الأدب"
"27096","(۲۷۰۹۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : حدَّثَنَا سُفْیَانُ بْنُ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَن حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَن أُمِّہِ قَالَتْ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لَمْ یَکْذِبْ مَنْ قَالَ خَیْرًا، أَوْ نَمَی خَیْرًا، أَوْ أَصْلَحَ بَیْنَ اثْنَیْنِ۔ (بخاری ۲۶۹۲۔ مسلم ۲۰۱۱)","Da'if","Musannaf Ibn Abi Shaybah 27096","","","كتاب الأدب"
"27097","(۲۷۰۹۷) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَن سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ بْنِ خُثَیْمٍ ، عَن شَہْرٍ ، عَنْ أَسْمَائِ بِنْتِ یَزِیدَ قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَصْلُحُ الْکَذِبُ إلاَّ فِی ثَلاَثٍ : کذب الرَّجُلِ امْرَأَتَہُ لِیُرْضِیَہَا ، أَوْ إصْلاَحٌ بَیْنَ النَّاسِ ، أَوْ کَذِبٌ فِی الْحَرْبِ۔ (ترمذی ۱۹۳۹۔ احمد ۴۶۱)","Hasan","Musannaf Ibn Abi Shaybah 27097","","","كتاب الأدب"
"27098","(۲۷۰۹۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا ہِشَامُ بْنُ حَسَّانَ ، عَن مُحَمَّدِ بْنِ وَاسِعٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ سَتَرَ أَخَاہُ الْمُسْلِمَ فِی الدُّنْیَا سَتَرَہُ اللَّہُ فِی الدُّنْیَا وَالآخِرَۃِ ، وَمَنْ نَفَّسَ عَنْ أَخِیہِ کُرْبَۃً مِنْ کُرَبِ الدُّنْیَا نَفَّسَ اللَّہُ عَنہُ کُرْبَۃً مِنْ کُرَبِ یَوْمِ الْقِیَامَۃِ ، وَاللَّہُ فِی عَوْنِ الْعَبْدِ مَا کَانَ الْعَبْدُ فِی عَوْنِ أَخِیہِ۔ (عبدالرزاق ۱۸۹۳۳۔ احمد ۵۱۴)","Sahih","Musannaf Ibn Abi Shaybah 27098","","","كتاب الأدب"
"27099","(۲۷۰۹۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ نَفَّسَ عَن مُسْلِمٍ کُرْبَۃً مِنْ کُرَبِ الدُّنْیَا نَفَّسَ اللَّہُ عَنہُ کُرْبَۃً مِنْ کُرَبِ الآخِرَۃِ یَوْمَ الْقِیَامَۃِ، وَمَنْ سَتَرَ مُسْلِمًا سَتَرَہُ اللَّہُ فِی الدُّنْیَا وَالآخِرَۃِ ، وَمَنْ یَسَّرَ عَلَی مُعْسِرٍ یَسَّرَ اللَّہُ عَلَیْہِ فِی الدُّنْیَا وَالآخِرَۃِ ، وَاللَّہُ فِی عَوْنِ الْعَبْدِ مَا کَانَ الْعَبْدُ فِی عَوْنِ أَخِیہِ۔ (ابوداؤد ۴۸۵۴۔ حاکم ۳۷۷)","Sahih","Musannaf Ibn Abi Shaybah 27099","","","كتاب الأدب"
"27100","(۲۷۱۰۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن زَیْدِ بْنِ وَہْبٍ قَالَ أُتِیَ ابْنُ مَسْعُودٍ فَقِیلَ لَہُ : ہَذَا فُلاَنٌ تَقْطُرُ لِحْیَتُہُ خَمْرًا ، فَقَالَ عَبْدُ اللہِ : إنَّا قَدْ نُہِینَا عَنِ التَّجَسُّسِ ، وَلَکِنْ إِنْ یَظْہَرَ لَنَا مِنْہُ شَیْئٌ نَأْخُذْہُ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 27100","","","كتاب الأدب"
"27101","(۲۷۱۰۱) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی إدْرِیسَ قَالَ : لاَ یَہْتِکُ اللَّہُ سِتْرَ عَبْدٍ فِی قَلْبِہِ مِثْقَالُ ذَرَّۃٍ مِنْ خَیْرٍ۔","","Musannaf Ibn Abi Shaybah 27101","","","كتاب الأدب"
"27102","(۲۷۱۰۲) حَدَّثَنَا عَفَّانُ قَالَ : حَدَّثَنَا ہَمَّامٌ ، قَالَ : سَمِعْتُ إِسْحَاقَ بْنَ عَبْدِ اللہِ بْنِ أَبِی طَلْحَۃَ قَالَ : حدَّثَنِی شَیْبَۃُ الْخُضْرِی ، أَنَّہُ شَہِدَ عُرْوَۃَ یُحَدِّثُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ، عَنْ عَائِشَۃَ رضی اللہ عنہا ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : لاَ یَسْتُرُ اللَّہُ عَلَی عَبْدٍ فِی الدُّنْیَا إلاَّ سَتَرَ اللہ عَلَیْہِ فِی الآخِرَۃِ۔ (مسلم ۲۰۰۲۔ احمد ۱۴۵)","Da'if","Musannaf Ibn Abi Shaybah 27102","","","كتاب الأدب"
"27103","(۲۷۱۰۳) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ قَیْسٍ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : مَنْ أَطْفَأَ عَن مُؤْمِنٍ سیئۃ فَکَأَنَّمَا أَحْیَا مَوْؤُودَۃً ۔","Da'if","Musannaf Ibn Abi Shaybah 27103","","","كتاب الأدب"
"27104","(۲۷۱۰۴) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن سَعِیدٍ الْجَرِیرِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَن أُسَیْرِ بْنِ جَابِرٍ ، أَنَّ أُوَیْسًا الْقَرَنِیَّ کَانَ إذَا حَدَّثَ وَقَعَ حَدِیثُہُ مِنْ قُلُوبِنَا مَوْقِعًا لاَ یَقَعُہُ حَدِیثُ غَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 27104","","","كتاب الأدب"
"27105","(۲۷۱۰۵) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن یسار بْنِ سَلاَمَۃَ ، عَن شَہْرِ بْنِ حَوْشَبٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ قَالَ : إذَا حَدَّثَ الرَّجُلُ الْقَوْمَ فإن حدیثہ یَقَعُ مِنْ قُلُوبِہِمْ مَوْقِعَہُ مِنْ قَلْبِہِ۔","","Musannaf Ibn Abi Shaybah 27105","","","كتاب الأدب"
"27106","(۲۷۱۰۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ أَبِی غَفَّارٍ ، عَنْ أَبِی تَمِیمَۃَ الْہُجَیْمِیِّ ، عَنْ أَبِی جُرَیٍّ الْہُجَیْمِیِّ قَالَ : أَتَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : قُلْتُ : أَنْتَ رَسُولُ اللہِ ؟ قَالَ : نَعَمْ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، اعْہَدْ إلَیَّ ، قَالَ : لاَ تَسُبَّ أَحَدًا ، قَالَ : فَمَا سَبَبْت أَحَدًا عَبْدًا ، وَلاَ حُرًّا ، وَلاَ شَاۃً ، وَلاَ بَعِیرًا۔","Hasan","Musannaf Ibn Abi Shaybah 27106","","","كتاب الأدب"
"27107","(۲۷۱۰۷) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن سَعْدِ بْنِ إبْرَاہِیمَ ، عَن حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عبْدِ اللہِ بْنِ عَمْرٍو ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إنَّ أَکْبَرَ الذَّنْبِ عِنْدَ اللہِ أَنْ یَسُبَّ الرَّجُلُ وَالِدَیْہِ ، قَالُوا : وَکَیْفَ یَسُبُّ الرَّجُلُ وَالِدَیْہِ ؟ قَالَ : یَسُبُّ أَبَا الرَّجُلِ فَیَسُبُّ أَبَاہُ ، وَیَسُبُّ أُمَّہُ فَیَسُبُّ أُمَّہُ۔n(بخاری ۵۹۷۳۔ ابوداؤد ۵۰۹۸)","Sahih","Musannaf Ibn Abi Shaybah 27107","","","كتاب الأدب"
"27108","(۲۷۱۰۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ أَبِیہِ قَالَ : یَبْلُغُ بِہِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إنَّ من أَرْبَی الرِّبَا تَفَضُّلُ الرَّجُلِ فِی عَرْضِ أَخِیہِ بِالشَّتْمِ ، وَإِنَّ أَکْبَرَ الْکَبَائِرِ شَتْمُ الرَّجُلِ وَالِدَیْہِ ، قِیلَ : یَا رَسُولَ اللہِ ، وَکَیْفَ یَشْتُمُ وَالِدَیْہِ ؟ قَالَ : یَسُبُّ النَّاسَ فَیَسْتَسِبُّ النَّاسُ بِہِمَا۔ (طبرانی ۸۹۹)","","Musannaf Ibn Abi Shaybah 27108","","","كتاب الأدب"
"27109","(۲۷۱۰۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ قَالَ : مَا رَأَیْت أَبَا وَائِلٍ سَابَّ شَیْئًا قَطُّ إلاَّ أَنَّہُ ذَکَرَ الْحَجَّاجَ مَرَّۃً فَقَالَ : اللَّہُمَّ أَطْعِمْہُ طَعَامًا مِنْ ضَرِیعٍ لاَ یُسْمِنُ ، وَلاَ یُغْنِی مِنْ جُوعٍ ، ثُمَّ قَالَ : إِنْ کَانَ أَحَبَّ إلَیْک۔","","Musannaf Ibn Abi Shaybah 27109","","","كتاب الأدب"
"27110","(۲۷۱۱۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَن فُضَیْلٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ قَالَ : لاَ یَدْخُلُ الْجَنَّۃَ مَنْ کَانَ فِی قَلْبِہِ مِثْقَالُ حَبَّۃِ خَرْدَلٍ مِنْ کِبْرٍ۔","","Musannaf Ibn Abi Shaybah 27110","","","كتاب الأدب"
"27111","(۲۷۱۱۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ الأَغَرِّ أَبِی مُسْلِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَقُولُ اللَّہُ : الْعَظَمَۃُ إزَارِی ، وَالْکِبْرِیَائُ رِدَائِی ، فَمَنْ نَازَعَنی وَاحِدًا مِنْہُمَا أَلْقَیْتہ فِی النَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 27111","","","كتاب الأدب"
"27112","(۲۷۱۱۲) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ مُسْلِمٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَدْخُلُ الْجَنَّۃَ أَحَدٌ فِی قَلْبِہِ مِثْقَالُ حَبَّۃِ خَرْدَلٍ مِنْ کِبْرٍ ، وَلاَ یَدْخُلُ النَّارَ أَحَدٌ فِی قَلْبِہِ مِثْقَالُ حَبَّۃِ خَرْدَلٍ مِنْ إیمَانٍ۔ (مسلم ۹۳۔ ابوداؤد ۴۰۸۸)","Sahih","Musannaf Ibn Abi Shaybah 27112","","","كتاب الأدب"
"27113","(۲۷۱۱۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ أَبِی حَیَّانَ ، عَنْ أَبِیہِ قَالَ : الْتَقَی عَبْدُ اللہِ بْنُ عَمْرٍو ، وَابْنُ عُمَرَ فَانْتَجَیَا بَیْنَہُمَا ، ثُمَّ انْصَرَفَ کُلُّ وَاحِدٍ مِنْہُمَا إلَی أَصْحَابِہِ فَانْصَرَفَ ابْنُ عُمَرَ وَہُوَ یَبْکِی ، فَقَالُوا لَہُ : مَا یُبْکِیک ؟ قَالَ : أَبْکَانِی الَّذِی زَعَمَ ہَذَا ، أَنَّہُ سَمِعَہُ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَدْخُلُ الْجَنَّۃَ أَحَدٌ فِی قَلْبِہِ مِثْقَالُ حَبَّۃِ خَرْدَلٍ مِنْ کِبْرٍ۔ (احمد ۱۶۴)","Da'if","Musannaf Ibn Abi Shaybah 27113","","","كتاب الأدب"
"27114","(۲۷۱۱۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَجِیئُ الْمُتَکَبِّرُونَ یَوْمَ الْقِیَامَۃِ ذَرًّا مِثْلَ صُوَرِ الرِّجَالِ ، یَعْلُوہُمْ کُلُّ شَیْئٍ مِنَ الصَّغَارِ ، قَالَ : ثُمَّ یُسَاقُونَ إلَی سِجْنِ فی جَہَنَّمَ یُقَالُ لَہُ بُولَسَ ، تَعْلُوہُمْ نَارُ الأَنْیَارِ ، یُسْقَوْنَ مِنْ طِینَۃِ الْخَبَالِ ، عُصَارَۃِ أَہْلِ النَّارِ۔ (ترمذی ۲۴۹۲۔ احمد ۱۷۹)","Hasan","Musannaf Ibn Abi Shaybah 27114","","","كتاب الأدب"
"27115","(۲۷۱۱۵) ابْنُ إدْرِیسَ ، وَابْنُ عُیَیْنَۃَ ، وَأَبُو خَالِدٍ الأَحْمَرَِِ ، عَنِ ابْنِ عَجْلاَنَ ، عَن بُکَیْر بْنِ عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَن مَعْمَرِ بْنِ أَبِی حُیَیَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ عَدِیِّ بْنِ الْخِیَارِ قَالَ : قَالَ عُمَرُ : إنَّ الْعَبْدَ إذَا تَعَظَّمَ وَعَدَا طَوْرَہُ وَہَصَہُ اللَّہُ إلَی الأَرْضِ ، وَقَالَ : اخْسَأْ أَخْسَأَکَ اللَّہُ ، فَہُوَ فِی نَفْسِہِ کَبِیرٌ ، وَفِی أَنْفُسِ النَّاسِ صغیر حتی لہو أحقر عند الناس من خنزیر۔","Hasan","Musannaf Ibn Abi Shaybah 27115","","","كتاب الأدب"
"27116","(۲۷۱۱۶) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن یَعْلَی بْنِ عَطَائٍ ، قَالَ : سَمِعْتُ نَافِعَ بْنَ عَاصِمٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : لاَ یَدْخُلُ حَظِیرَۃَ الْقُدْسِ مُتَکَبِّرٌ۔","Hasan","Musannaf Ibn Abi Shaybah 27116","","","كتاب الأدب"
"27117","(۲۷۱۱۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَن ہَمَّامِ بْنِ الْحَارِثِ ، عَن حُذَیْفَۃَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَدْخُلُ الْجَنَّۃَ قَتَّاتٌ۔ (بخاری ۶۰۵۶۔ مسلم ۱۶۹)","Sahih","Musannaf Ibn Abi Shaybah 27117","","","كتاب الأدب"
"27118","(۲۷۱۱۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَن وَاصِلٍ ، عَن شَقِیقٍ ، عَن حُذَیْفَۃَ قَالَ : کُنَّا نَتَحَدَّثُ : أنہ لاَ یَدْخُلُ الْجَنَّۃَ قَتَّاتٌ۔ (مسلم ۱۰۱۔ احمد ۱۶۸)","Sahih","Musannaf Ibn Abi Shaybah 27118","","","كتاب الأدب"
"27119","(۲۷۱۱۹) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ قَالَ : لَمَّا رَفَعَ اللَّہُ مُوسَی نَجِیًّا رَأَی رَجُلاً مُتَعَلِّقًا بِالْعَرْشِ فَقَالَ : یَا رَبِّ ، مَنْ ہَذَا ؟ فَقَالَ : عَبْدٌ مِنْ عِبَادِی صَالِحٌ ، إِنْ شِئْتَ أَخْبَرْتُک بِعَمَلِہِ ، قَالَ : یَا رَبِّ ، أَخْبِرْنِی ، قَالَ : کَانَ لاَ یَمْشِی بِالنَّمِیمَۃِ۔","","Musannaf Ibn Abi Shaybah 27119","","","كتاب الأدب"
"27120","(۲۷۱۲۰) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ قَالَ : کَانَتْ لَنَا جَارِیَۃٌ أَعْجَمِیَّۃٌ ، فَمَرِضَتْ فَجَعَلَتْ تَقُولُ عِنْدَ الْمَوْتِ : ہَذَا فُلاَنٌ تَمَرَّغَ فِی الْحَمْأَۃِ ، فَلَمَّا أَنْ مَاتَتْ سَأَلْنَا عَنِ الرَّجُلِ ، قَالَ : فَقَالَ : مَا کَانَ بِہِ بَأْسٌ إلاَّ أَنَّہُ کَانَ یَمْشِی بِالنَّمِیمَۃِ۔","","Musannaf Ibn Abi Shaybah 27120","","","كتاب الأدب"
"27121","(۲۷۱۲۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَن یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَن مُجَاہِدٍ وَسَالِمِ بْنِ أَبِی الْجَعْدَ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَدْخُلُ الْجَنَّۃَ مَنَّانٌ۔","Da'if","Musannaf Ibn Abi Shaybah 27121","","","كتاب الأدب"
"27122","(۲۷۱۲۲) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن یَعْلَی بْنِ عَطَائٍ ، قَالَ : سَمِعْتُ نَافِعَ بْنَ عَاصِمٍ یُحَدِّثُ عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : لاَ یَدْخُلُ حَظِیرَۃَ الْقُدْسِ مَنَّانٌ۔","Hasan","Musannaf Ibn Abi Shaybah 27122","","","كتاب الأدب"
"27123","(۲۷۱۲۳) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ عَلِیِّ بْنِ مُدْرِکٍ ، عَنْ أَبِی زُرْعَۃَ ، عَن خَرَشَۃَ بْنِ الْحُرِّ ، عَنْ أَبِی ذَرٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : ثَلاَثَۃٌ لاَ یُکَلِّمُہُمُ اللَّہُ یَوْمَ الْقِیَامَۃِ ، وَلاَ یَنْظُرُ إلَیْہِمْ ، وَلاَ یُزَکِّیہِمْ وَلَہُمْ عَذَابٌ أَلِیمٌ ، قَالَ : فَقَرَأَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ثَلاَثَ مَرَّاتٍ ، فَقَالَ أَبُو ذَرٍّ : خَابُوا وَخَسِرُوا ، مَنْ ہُمْ یَا رَسُولَ اللہِ ؟ قَالَ : الْمُسْبِلُ وَالْمَنَّانُ وَالْمُنْفِقُ سِلْعَتَہُ بِالْحَلِفِ الْکَاذِبِ۔n(مسلم ۱۷۱۔ ابوداؤد ۴۰۸۵۔ احمد ۱۴۸)","Sahih","Musannaf Ibn Abi Shaybah 27123","","","كتاب الأدب"
"27124","(۲۷۱۲۴) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن مَنْصُورٍ ، عَن سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَن نُبَیْطِ بْنِ شَرِیطٍ ، عَنْ جَابَانَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَدْخُلُ الْجَنَّۃَ مَنَّانٌ۔","Da'if","Musannaf Ibn Abi Shaybah 27124","","","كتاب الأدب"
"27125","(۲۷۱۲۵) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ قَالَ : لَمَّا رَفَعَ اللَّہُ مُوسَی نَجِیًّا رَأَی رَجُلاً مُتَعَلِّقًا بِالْعَرْشِ فَقَالَ : یَا رَبِّ ، مَنْ ہَذَا ؟ قَالَ : عَبْدٌ مِنْ عِبَادِی صَالِحٌ ، إِنْ شِئْتَ أَخْبَرْتُک بِعَمَلِہِ، قَالَ : یَا رَبِّ ، أَخْبِرْنِی ، قَالَ : کَانَ لاَ یَحْسُدُ النَّاسَ مَا آتَاہُمُ اللَّہُ مِنْ فَضْلِہِ۔","","Musannaf Ibn Abi Shaybah 27125","","","كتاب الأدب"
"27126","(۲۷۱۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن یَزِیدَ الرَّقَاشِیِّ ، عَنْ أَنَسٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ الْحَسَدَ لَیَأْکُلُ الْحَسَنَاتِ کَمَا تَأْکُلُ النَّارُ الْحَطَبَ۔ (ابن ماجہ ۴۲۱۰۔ ابویعلی ۳۶۴۴)","Da'if","Musannaf Ibn Abi Shaybah 27126","","","كتاب الأدب"
"27127","(۲۷۱۲۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن یَزِیدَ الرَّقَاشِیِّ ، عَنِ الْحَسَنِ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَادَ الْحَسَدُ أَنْ یَغْلِبَ الْقَدَرَ ، وَکَادَتِ الْفَاقَۃُ أَنْ تَکُونَ کُفْرًا۔","Hasan","Musannaf Ibn Abi Shaybah 27127","","","كتاب الأدب"
"27128","(۲۷۱۲۸) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ أَبِی رَجَائٍ ، عَنِ الْحَسَنِ ، {وَلاَ یَجِدُونَ فِی صُدُورِہِمْ حَاجَۃً مِمَّا أُوتُوا} قَالَ : الْحَسَدُ۔","","Musannaf Ibn Abi Shaybah 27128","","","كتاب الأدب"
"27129","(۲۷۱۲۹) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی قَوْلِہِ تَعَالَی : {وَالَّذِینَ إذَا أَنْفَقُوا لَمْ یُسْرِفُوا وَلَمْ یَقْتُرُوا وَکَانَ بَیْنَ ذَلِکَ قَوَامًا} قَالَ: لاَ یُجِیعُہُمْ، وَلاَ یُعَرِّیہِمْ، وَلاَ یُنْفِقُ نَفَقَۃً یَقُولُ النَّاسُ: إِنَّہ أَسْرَفَ فِیہَا۔","","Musannaf Ibn Abi Shaybah 27129","","","كتاب الأدب"
"27130","(۲۷۱۳۰) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ عَمْرِو بْنِ قَیْسٍ ، عَنِ الْمِنْہَالِ ، عَن سَعِیدِ بْنِ جُبَیْرٍ : {وَمَا أَنْفَقْتُمْ مِنْ شَیْئٍ فَہُوَ یُخْلِفُہُ وَہُوَ خَیْرُ الرَّازِقِینَ} قَالَ : فِی غَیْرِ إسْرَافٍ ، وَلاَ تَقْتِیرٍ۔","","Musannaf Ibn Abi Shaybah 27130","","","كتاب الأدب"
"27131","(۲۷۱۳۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنِ الْحَکَمِ ، عَن یَحْیَی بْنِ الْجَزَّارِ ، عَنْ أَبِی الْعُبَیْدَیْنِ ، أَنَّہُ سَأَلَ ابْنَ مَسْعُودٍ عَنِ التَّبْذِیرِ فَقَالَ : إنْفَاقُ الْمَالِ فِی غَیْرِ حَقِّہِ۔","Sahih","Musannaf Ibn Abi Shaybah 27131","","","كتاب الأدب"
"27132","(۲۷۱۳۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن حَمَّادِ بْنِ سَلَمَۃَ ، عَن دَاوُد قَالَ : قُلْتُ لِلْحَسَنِ : أَشْتَرِی لامْرَأَتِی فِی السَّنَۃِ طِیبًا بِعِشْرِینَ دِرْہَمًا أَسَرَفٌ ہَذَا ؟ قَالَ : لَیْسَ ہَذَا بِسَرَفٍ۔","","Musannaf Ibn Abi Shaybah 27132","","","كتاب الأدب"
"27133","(۲۷۱۳۳) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ إبْرَاہِیمَ بْنَ مَیْسَرَۃَ ، عَن طَاوُوس ، عَنِ ابْنِ عَبَّاسٍ قَالَ : الْبَسْ مَا شِئْت وَکُلْ مَا شِئْت مَا أَخْطَأَتْک خِلَّتَانِ : سَرَفٌ ، أَوْ مَخِیلَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 27133","","","كتاب الأدب"
"27134","(۲۷۱۳۴) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَن مُحَمَّدِ بْنِ سُوقَۃَ ، عَن سَعِیدِ بْنِ جُبَیْرٍ قَالَ : سَأَلَہُ رَجُلٌ ، عَنْ إضَاعَۃِ الْمَالِ ، قَالَ : أَنْ یَرْزُقَک اللَّہُ رِزْقًا فَتُنْفِقُہُ فِیمَا حَرَّمَ عَلَیْک۔","","Musannaf Ibn Abi Shaybah 27134","","","كتاب الأدب"
"27135","(۲۷۱۳۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْعَوَّامِ قَالَ : قَالَ کَعْبٌ : أَنْفِقُوا لِخَلْفٍ یَأْتِیکُمْ۔","","Musannaf Ibn Abi Shaybah 27135","","","كتاب الأدب"
"27136","(۲۷۱۳۶) حَدَّثَنَا عَفَّانُ ، عَن سُکَیْنِ بْنِ عَبْدِ الْعَزِیزِ ، عَنِ الْہَجَرِیِّ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا عَالَ مَنِ اقْتَصَدَ۔ (احمد ۴۴۷۔ طبرانی ۱۰۱۱۸)","Da'if","Musannaf Ibn Abi Shaybah 27136","","","كتاب الأدب"
"27137","(۲۷۱۳۷) حَدَّثَنَا وَکِیعٌ ، عَن یُوسُفَ ، عَنْ أَبِی السَّرِیَّۃِ بن الْحَسَنِ قَالَ : لَیْسَ فِی الطَّعَامِ إسْرَافٌ۔","","Musannaf Ibn Abi Shaybah 27137","","","كتاب الأدب"
"27138","(۲۷۱۳۸) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنْ أَبِی الْعُمَیْسِ ، عَن زِیَادٍ مَوْلَی مُصْعَبٍ ، عَنِ الْحَسَنِ ، أَنَّ أَصْحَابَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَأَلُوہُ : مَا نَفَقَتنَا عَلَی أَہْلِینَا ؟ فَقَالَ : مَا أَنْفَقْتُمْ عَلَی أَہْلِیکُمْ فِی غَیْرِ إسْرَافٍ ، وَلاَ تَقْتِیرٍ ، فَہُوَ فِی سَبِیلِ اللہِ۔ (بیہقی ۶۵۵۴)","Hasan","Musannaf Ibn Abi Shaybah 27138","","","كتاب الأدب"
"27139","(۲۷۱۳۹) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنْ أَبِی کَثِیرٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إیَّاکُمْ وَالشُّحَّ فَإِنَّہُ أَہْلَکَ مَنْ قَبْلَکُمْ أَمَرَہُمْ بِالْقَطِیعَۃِ فَقَطَعُوا ، وَبِالْبُخْلِ فَبَخِلُوا ، وَبِالْفُجُورِ فَفَجَرُوا۔ (ابوداؤد ۱۶۹۵۔ احمد ۱۹۱)","Sahih","Musannaf Ibn Abi Shaybah 27139","","","كتاب الأدب"
"27140","(۲۷۱۴۰) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن مُحَمَّدِ بْنِ عَمْرٍو ، عَن صَفْوَانَ بْنِ سُلَیْمٍ ، عَن حُصَیْنِ بْنِ اللَّجْلاَجِ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَجْتَمِعُ الشُّحُّ وَالإِیمَانُ فِی جَوْفِ رَجُلِ مُسْلِمٍ۔","Da'if","Musannaf Ibn Abi Shaybah 27140","","","كتاب الأدب"
"27141","(۲۷۱۴۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن مُوسَی بْنِ عُلَیٍّ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ مَرْوَانَ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : شَرُّ مَا فِی الرَّجُلِ شُحٌّ ہَالِعٌ وَجُبْنٌ خَالِعٌ۔n(ابوداؤد ۲۵۰۳۔ احمد ۳۰۲)","Sahih","Musannaf Ibn Abi Shaybah 27141","","","كتاب الأدب"
"27142","(۲۷۱۴۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَن مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، عَنْ جَابِرٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْ قَدْ جَائَ مَالُ الْبَحْرَیْنِ لَقَدْ أَعْطَیْتُک کَذَا وَکَذَا فَأَتَیْت أَبَا بَکْرٍ فَقُلْت : تَبْخَلُ عَنی ، قَالَ : وَأَیُّ دَائٍ أَدْوَأُ مِنَ الْبُخْلِ ؟ مَا سَأَلْتِی مِنْ مَرَّۃٍ إلاَّ وَأَنَا أُرِیدُ أَنْ أُعْطِیَک۔ (بخاری ۲۵۹۸۔ مسلم ۱۸۰۶)","Sahih","Musannaf Ibn Abi Shaybah 27142","","","كتاب الأدب"
"27143","(۲۷۱۴۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ جَامِعِ بْنِ شَدَّادٍ ، عَنِ الأَسْوَدِ بْنِ ہِلاَلٍ قَالَ : جَائَ رَجُلٌ إلَی عَبْدِ اللہِ فَقَالَ : خَشِیَتْ أَنْ تُصِیبَنِی ہَذِہِ الآیَۃُ {وَمَنْ یُوقَ شُحَّ نَفْسِہِ} الآیَۃَ ، مَا أَسْتَطِیعُ أَنْ أُعْطِیَ شَیْئًا أُطِیقُ مَنْعَہُ ، قَالَ عَبْدُ اللہِ : ذَاکَ الْبُخْلُ ، وَبِئْسَ الشَّیْئُ الْبُخْلُ۔","Sahih","Musannaf Ibn Abi Shaybah 27143","","","كتاب الأدب"
"27144","(۲۷۱۴۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن کَہْمَسٍ ، عَنْ أَبِی الْعَلاَئِ ، عَنِ ابْنِ الأَحْمَسِ قَالَ : قلْت لأَبِی ذَرٍّ : حَدِیثٌ بَلَغَنِی عَنک تُحَدِّثُہ عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ ، قَالَ : سَمِعْتُہُ مِنْہُ وَقُلْتہ ، فَذَکَرَ ثَلاَثَۃً یَشْنَؤُہُمُ اللَّہُ : الْبَخِیلُ وَالْمَنَّانُ وَالْمُخْتَالُ۔","Da'if","Musannaf Ibn Abi Shaybah 27144","","","كتاب الأدب"
"27145","(۲۷۱۴۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمِ ، عَنْ أَبِی عُثْمَانَ ، وَعَبْدِ اللہِ بْنِ الْحَارِثِ ، عَن زَیْدِ بْنِ أَرْقَمَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الْبُخْلِ۔","Sahih","Musannaf Ibn Abi Shaybah 27145","","","كتاب الأدب"
"27146","(۲۷۱۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، عَن عُمَرَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَتَعَوَّذُ مِنَ الْبُخْلِ۔","Sahih","Musannaf Ibn Abi Shaybah 27146","","","كتاب الأدب"
"27147","(۲۷۱۴۷) حَدَّثَنَا شَبَابَۃُ قَالَ : حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، عَن عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، مِثْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 27147","","","كتاب الأدب"
"27148","(۲۷۱۴۸) حَدَّثَنَا وَکِیعٌ، عَن ہِشَامَ، عَن قَتَادَۃَ ، عَنْ أَنَسٍ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَتَعَوَّذُ مِنَ الْبُخْلِ۔","Sahih","Musannaf Ibn Abi Shaybah 27148","","","كتاب الأدب"
"27149","(۲۷۱۴۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عن حجاج ، عَن سُلَیْمَانَ بْنِ سُحَیْمٍ ، عَن طَلْحَۃَ بْنِ عُبَیْدِ اللہِ بْنِ کَرِیزٍ قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إنَّ اللَّہَ جَوَادٌ یُحِبُّ الْجُود، وَیُحِبُّ مَعَالِیَ الأَخْلاَقِ وَیَکْرَہُ سَفْسَافَہَا۔n(عبدالرزاق ۲۰۱۵۰۔ حاکم ۶۲۸)","","Musannaf Ibn Abi Shaybah 27149","","","كتاب الأدب"
"27150","(۲۷۱۵۰) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَن یَحْیَی بْنِ أَبِی کَثِیرٍ قَالَ : کَانَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ من سَعْدِ بْنِ عُبَادَۃَ جَفْنَۃٌ تَدُورُ مَعَہُ حَیْثُمَا دَارَ مِنْ نِسَائِہِ ، وَکَانَ یَقُولُ فِی دُعَائِہِ : اللَّہُمَّ ارْزُقْنِی مَالاً فَإِنَّہُ لاَ یُصْلِحُ الْفِعَالَ إلاَّ الْمَالُ۔","","Musannaf Ibn Abi Shaybah 27150","","","كتاب الأدب"
"27151","(۲۷۱۵۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن ہِشَامٍ ، عَنْ أَبِیہِ ، أَنَّ سَعْدَ بْنَ عُبَادَۃَ کَانَ یَدْعُو اللَّہُمَّ ہَبْ لِی حَمْدًا وَہَبْ لِی مَجْدًا ، ولاَ مَجْدَ إلاَّ بِفِعَالٍ ، وَلاَ فِعَالَ إلاَّ بِمَالٍ ، اللَّہُمَّ لاَ یُصْلِحُنِی الْقَلِیلُ ، وَلاَ أَصْلُحُ عَلَیْہِ۔n(ابن سعد ۶۱۴۔ حاکم ۲۵۳)","Sahih","Musannaf Ibn Abi Shaybah 27151","","","كتاب الأدب"
"27152","(۲۷۱۵۲) حَدَّثَنَا أَبُو أُسَامَۃَ قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ قَالَ : أَدْرَکْت سَعْدَ بْنَ عُبَادَۃَ وَہُوَ یُنَادِی عَلَی أُطُمِہِ : مَنْ أَحَبَّ شَحْمًا ، ولَحْمًا فَلْیَأْتِ سَعْدَ بْنَ عُبَادَۃَ ، ثُمَّ أَدْرَکْت ابْنَہُ بَعْدَ ذَلِکَ یَدْعُو بِہِ ، وَلَقَدْ کُنْت أَمْشِی فِی طَرِیقِ الْمَدِینَۃِ وَأَنَا شَابٌّ فَمَرَّ عَلَیَّ عَبْدُ اللہِ بْنُ عُمَرَ مُنْطَلِقًا إلَی أَرْضِہِ بالغابۃ ، فَقَالَ : یَا فَتَی ، انْظُرْ ہَلْ تَرَی عَلَی أُطُمِ سَعْدِ بْنِ عُبَادَۃَ أَحَدًا یُنَادِی ، فَنَظَرْت فَقُلْت : لاَ ، فَقَالَ : صَدَقْت۔","Sahih","Musannaf Ibn Abi Shaybah 27152","","","كتاب الأدب"
"27153","(۲۷۱۵۳) حَدَّثَنَا أَبُو أُسَامَۃَ قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ قَالَ : کَانَ قَیْسُ بْنُ سَعْدِ بْنِ عُبَادَۃَ ارْتَحَلَ نَحْوَ الْمَدِینَۃِ وَمَعَہُ أَصْحَابٌ ، فَجَعَلَ یَنْحَرُ کُلَّ یَوْمٍ جَزُورًا حَتَّی بَلَغَ صِرَارَ۔","Sahih","Musannaf Ibn Abi Shaybah 27153","","","كتاب الأدب"
"27154","(۲۷۱۵۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنِ ابْنِ سِیرِینَ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا أَمْسَی قَسَمَ نَاسًا مِنْ أَہْلِ الصُّفَّۃِ بَیْنَ أُنَاسٍ مِنْ أَصْحَابِہِ ، فَکَانَ الرَّجُلُ یَذْہَبُ بِالرَّجُلِ ، وَالرَّجُلُ بِالرَّجُلَیْنِ ، وَالرَّجُلُ بِالثَّلاَثَۃِ حَتَّی ذَکَرَ عَشَرَۃً ، قَالَ : وَکَانَ سَعْدُ بْنُ عُبَادَۃَ یَرْجِعُ إلَی أَہْلِہِ کل لیلۃ بِثَمَانِینَ منہم یُعَشِّیہِمْ۔","","Musannaf Ibn Abi Shaybah 27154","","","كتاب الأدب"
"27155","(۲۷۱۵۵) حَدَّثَنَا یَعْلَی ، عَن مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، عَن عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَجْوَدَ مِنَ الرِّیحِ الْمُرْسَلَۃِ۔ (بخار ی۳۲۲۰۔ احمد ۲۳۰)","Hasan","Musannaf Ibn Abi Shaybah 27155","","","كتاب الأدب"
"27156","(۲۷۱۵۶) حَدَّثَنَا یَحْیَی بْنُ آدَمَ قَالَ : حدَّثَنَا إبْرَاہِیمُ بْنُ سَعْدٍ ، عَنِ الزُّہْرِیِّ ، عَن عُبَیْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَجْوَدَ النَّاسِ بِالْخَیْرِ ، وَکَانَ أَجْوَدَ مَا یَکُونُ حِینَ یَلْقَاہُ جِبْرِیلُ۔n(بخاری ۱۹۰۲۔ مسلم ۱۸۰۳)","Sahih","Musannaf Ibn Abi Shaybah 27156","","","كتاب الأدب"
"27157","(۲۷۱۵۷) حَدَّثَنَا مَعْنُ بْنُ عِیسَی، عَن سَلَمَۃَ بْنِ أَبِی یَحْیَی الأَنْصَارِیِّ قَالَ: رَأَیْتُ أَنَسَ بْنَ مَالِکٍ یَجْلِسُ إلَی سَارِیَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 27157","","","كتاب الأدب"
"27158","(۲۷۱۵۸) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ الْمُخْتَارِ بْنِ سَعْدٍ قَالَ : رَأَیْتُ الْقَاسِمَ بْنَ مُحَمَّدٍ یَجْلِسُ إلَی سَارِیَۃٍ۔","","Musannaf Ibn Abi Shaybah 27158","","","كتاب الأدب"
"27159","(۲۷۱۵۹) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَن ثَابِتِ بْنِ قَیْسٍ قَالَ : رَأَیْتُ نَافِعَ بْنَ جُبَیْرٍ یَجْلِسُ إلَی سَارِیَۃٍ۔","","Musannaf Ibn Abi Shaybah 27159","","","كتاب الأدب"
"27160","(۲۷۱۶۰) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَن خَالِدِ بْنِ أَبِی بَکْرٍ قَالَ : رَأَیْتُ عُبَیْدَ اللہِ بْنَ عَبْدِ اللہِ یَجْلِسُ إلَی سَارِیَۃٍ۔","","Musannaf Ibn Abi Shaybah 27160","","","كتاب الأدب"
"27161","(۲۷۱۶۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَعْمَشِ قَالَ : کَانَ إبْرَاہِیمُ لاَ یَجْلِسُ إلَی أُسْطُوَانَۃٍ۔","","Musannaf Ibn Abi Shaybah 27161","","","كتاب الأدب"
"27162","(۲۷۱۶۲) حَدَّثَنَا مَعَن ، عَن خَالِدِ بْنِ أَبِی بَکْرٍ قَالَ : لَمْ أَرَ سَالِمَ بْنَ عَبْدِ اللہِ یَجْلِسُ إلَی سَارِیَۃٍ۔","","Musannaf Ibn Abi Shaybah 27162","","","كتاب الأدب"
"27163","(۲۷۱۶۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ قَالَ : نَزَلَ عَلَیْنَا أَبُو قَتَادَۃَ الأَنْصَارِیُّ ، فَانْقَضَّ کَوْکَبٌ ، فَأَتْبَعْناہُ أَبْصَارَنَا ، فَنَہَانَا عَن ذَلِکَ۔ (احمد ۲۹۹۔ حاکم ۲۸۶)","Sahih","Musannaf Ibn Abi Shaybah 27163","","","كتاب الأدب"
"27164","(۲۷۱۶۴) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُتْبَعَ الرَّجُلُ بَصَرَہُ الْکَوْکَبَ إذَا رمی بِہِ۔","","Musannaf Ibn Abi Shaybah 27164","","","كتاب الأدب"
"27165","(۲۷۱۶۵) حَدَّثَنَا قَبِیصَۃُ ، عَن سُفْیَانَ ، عَن ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنْ أَبِی قَتَادَۃَ مِثْلُ حَدِیثِ عَبْدِ الرَّحِیمِ ، عَنْ عَاصِمٍ۔","Sahih","Musannaf Ibn Abi Shaybah 27165","","","كتاب الأدب"
"27166","(۲۷۱۶۶) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، قَالَ : حدَّثَنَا أَبُو عَقِیلٍ قَالَ : حَدَّثَنَا عَمْرُو بْنُ خَالِدٍ الْقُرَشِیُّ ، قَالَ : سَمِعْتُ زَیْدَ بْنَ عَلِیٍّ یُحَدِّثُ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَنْ عَلِیٍّ ، أَنَّہُ کَانَ إذَا رَأَی الْکَوْکَبَ مُنْقَضًّا قَالَ : اللَّہُمَّ صَوِّبْہُ وَأَصِبْ بِہِ ، وَقِنَا شَرَّ مَا یَتْبَعُ۔","Da'if","Musannaf Ibn Abi Shaybah 27166","","","كتاب الأدب"
"27167","(۲۷۱۶۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : حدَّثَنَا شُعْبَۃُ ، عَن خَالِدٍ الْحَذَّائِ ، عَن غَیْلاَنَ بْنِ جَرِیرٍ ، عَن مُطَرِّفٍ قَالَ : لاَ یَکْذِبَن أَحَدُکُمْ مَرَّتَیْنِ ، یَقُولُ لِلشَیْئٍ : لاَ شَیْئَ ، لَیْسَ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 27167","","","كتاب الأدب"
"27168","(۲۷۱۶۸) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، عَن مُحَمَّدٍ قَالَ : کَانَ یَقُولُ : إنَّ ہَذَا الْعِلْمَ دِینٌ فَانْظُرُوا عَمَّنْ تَأْخُذُونَہُ۔ (دارمی ۴۱۹)","","Musannaf Ibn Abi Shaybah 27168","","","كتاب الأدب"
"27169","(۲۷۱۶۹) حَدَّثَنَا جَرِیرٌ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : کَانَ یَکْرَہ أَنْ یَقُولُ : لَیْسَ فِی الْبَیْتِ أَحَدٌ ، وَلاَ بَأْسَ أَنْ یَقُولَ : لَیْسَ فِی الْبَیْتِ أَحَدٌ مِنَ النَّاسِ۔","","Musannaf Ibn Abi Shaybah 27169","","","كتاب الأدب"
"27170","(۲۷۱۷۰) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ قَالَ : أَیُّوبُ قَالَ : حَدَّثَنَا سَعِیدُ بْنُ جُبَیْرٍ ذَاتَ یَوْمٍ حَدِیثًا فَقُمْت إلَیْہِ فَقُلْت : أَعِدْہُ ، فَقَالَ : إِنِّی مَا کُلُّ سَاعَۃٍ أَحْلِبُ فَأَشْرَبُ۔","","Musannaf Ibn Abi Shaybah 27170","","","كتاب الأدب"
"27171","(۲۷۱۷۱) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْجَبَّارِ ، قَالَ : سَمِعْتُ ابْنَ شِہَابٍ یَقُولُ : تَرْدَادُ الْحَدِیثِ أَشَدُّ مِنْ نَقْلِ الْحِجَارَۃِ۔","","Musannaf Ibn Abi Shaybah 27171","","","كتاب الأدب"
"27172","(۲۷۱۷۲) حَدَّثَنَا یَعْلَی قَالَ: حدَّثَنَا أَبُو حَیَّانَ، عَنْ عَبَایَۃَ قَالَ: وَضَّأْت ابْنَ عُمَرَ فَقُمْت، عَن یَمِینِہِ أُفْرِغُ عَلَیْہِ الْمَائَ، فَلَمَّا فَرَغَ صَعَّدَ فِیَّ بَصَرَہُ فَقَالَ: مِنْ أَیْنَ أَخَذَتْ ہَذَا الأَدَبَ؟ فَقُلْت: مِنْ جَدِّی رَافِعٍ، قَالَ: قَالَ: ہنیئا لک۔","Sahih","Musannaf Ibn Abi Shaybah 27172","","","كتاب الأدب"
"27173","(۲۷۱۷۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن حَمَّادِ بْنِ زَیْدٍ ، عَن لَیْثٍ ، عَن مُجَاہِدٍ قَالَ : إذَا لَقِیْتَ أَخَاک فَلاَ تَسْأَلْہُ مِنْ أَیْنَ جِئْت ؟ وَلاَ أَیْنَ تَذْہَبُ ؟ وَلاَ تَحُدُّ النَّظَرَ إلَی أَخِیک۔","","Musannaf Ibn Abi Shaybah 27173","","","كتاب الأدب"
"27174","(۲۷۱۷۴) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَن حَجَّاجِ الصَّوَافِّ قَالَ : حدَّثَنَی یَحْیَی بْنُ أَبِی کَثِیرٍ قَالَ : بَلَغَنِی ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ : إذَا مَرَّ أَحَدُکُمْ بِہَدَفٍ مَائِلٍ ، أَوْ صَدَفٍ ہَائِلٍ فَلْیُسْرِعِ الْمَشْیَ وَلْیَسْأَلِ اللَّہَ الْمُعَافَاۃَ۔","","Musannaf Ibn Abi Shaybah 27174","","","كتاب الأدب"
"27175","(۲۷۱۷۵) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَن عِمْرَانَ الْقَصِیرِ قَالَ : أَخْبَرَنِی سَعِیدُ بْنُ سُلَیْمَانَ ، عَن یَزِیدَ بْنِ نَعَامَۃَ الضَّبِّیِّ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا آخَی الرَّجُلُ الرَّجُلَ فَلْیَسْأَلْہُ ، عَنِ اسْمِہِ وَاسْمِ أَبِیہِ وَمِمَّنْ ہُوَ ، فَإِنَّہُ أَوْصَلُ لِلْمَوَدَّۃِ۔ (ابو نعیم ۱۸۱)","Da'if","Musannaf Ibn Abi Shaybah 27175","","","كتاب الأدب"
"27176","(۲۷۱۷۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی رَجُلاً فَسَأَلَ عَنہُ ، فَقَالَ رَجُلٌ : أَنَا أَعْرِفُ وَجْہَہُ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ تِلْکَ بِمَعْرِفَۃٍ۔","","Musannaf Ibn Abi Shaybah 27176","","","كتاب الأدب"
"27177","(۲۷۱۷۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَیَزِیدُ ، عَنْ مِسْعَرٍ ، عَنْ عُبَیْدِ بْنِ الْحَسَنِ ، عَنِ ابْنِ مَعْقِلٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : نَفَقَۃُ الرَّجُلِ عَلَی أَہْلِہِ صَدَقَۃٌ۔","","Musannaf Ibn Abi Shaybah 27177","","","كتاب الأدب"
"27178","(۲۷۱۷۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ قَالَ : إنَّ مِنَ النَّفَقَۃِ الَّتِی تُضَاعَفُ بِسَبْعِمِئَۃِ ضِعْفِ نَفَقَۃِ الرَّجُلِ عَلَی نَفْسِہِ وَأَہْلِ بَیْتِہِ۔","","Musannaf Ibn Abi Shaybah 27178","","","كتاب الأدب"
"27179","(۲۷۱۷۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا شُعْبَۃُ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، عَنْ أَبِی مَسْعُودٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : نَفَقَۃُ الرَّجُلِ عَلَی أَہْلِہِ صَدَقَۃٌ۔ (بخاری ۵۵۔ مسلم ۶۹۵)","Sahih","Musannaf Ibn Abi Shaybah 27179","","","كتاب الأدب"
"27180","(۲۷۱۸۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا جَرِیرُ بْنُ حَازِمٍ قَالَ : حَدَّثَنَا بَشَّارُ بْنُ أَبِی سَیْفٍ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَن عِیَاضِ بْنِ غُطَیْفٍ قَالَ : دَخَلْنَا عَلَی أَبِی عُبَیْدَۃَ بْنِ الْجَرَّاحِ فَقَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ أَنْفَقَ عَلَی أَہْلِہِ ، أَوْ مَازَ أَذًی عَن طَرِیقٍ فَہی حَسَنَۃٌ بِعَشْرِ أَمْثَالِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 27180","","","كتاب الأدب"
"27181","(۲۷۱۸۱) حَدَّثَنَا ابْنُ نُمَیْرٍ قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ أَبِی مُرَاوِحَ ، عَنْ أَبِی ذَرٍّ قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، أَیُّ الأَعْمَالِ أَفْضَلُ ؟ قَالَ : إیمَانٌ بِاللَّہِ وَجِہَادٌ فِی سَبِیلِہِ ، قَالَ : قُلْتُ : أَیُّ الرِّقَابِ أَفْضَلُ ؟ قَالَ : أَنْفَسُہَا عِنْدَ أَہْلِہَا وَأَغْلاَہَا ، ثَمَنًا ، قُلْتُ : فَإِنْ لَمْ أَطِقْ ذَلِکَ ؟ قَالَ : تُعِینُ صَانِعًا ، أَوْ تَصْنَعُ لأَخْرَقَ ، قَالَ : فَإِنْ لَمْ أَسْتَطِعْ ؟ قَالَ : فَدَعِ النَّاسَ مِنَ الشَّرِّ ، فَإِنَّہَا صَدَقَۃٌ تَصَدَّقُ بِہَا عَلَی نَفْسِک۔","Sahih","Musannaf Ibn Abi Shaybah 27181","","","كتاب الأدب"
"27182","(۲۷۱۸۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن شُعْبَۃَ ، عَن سَعِیدِ بْنِ أَبِی بُرْدَۃَ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : عَلَی کُلِّ مُسْلِمٍ صَدَقَۃٌ ، قَالَ : قِیلَ أَرَأَیْت إِنْ لَمْ یَجِدْ ؟ قَالَ : یَعْمَلُ بِیَدَیْہِ فَیَنْفَعُ نَفْسَہُ وَیَتَصَدَّقُ ، قَالَ : أَرَأَیْت إِنْ لَمْ یَسْتَطِعْ ؟ قَالَ : یُعِینُ ذَا الْحَاجَۃِ الْمَلْہُوفَ ، قَالَ : أَرَأَیْت إِنْ لَمْ یَسْتَطِعْ ؟ قَالَ: یَأْمُرُ بِالْمَعْرُوفِ أو الخیر ، قَالَ : أَرَأَیْت إِنْ لَمْ یَفْعَلْ ؟ قَالَ : یُمْسِکُ عَنِ الشَّرِّ فَإِنَّہَا صَدَقَۃٌ۔n(بخاری ۱۴۴۵۔ مسلم ۶۹۹)","Sahih","Musannaf Ibn Abi Shaybah 27182","","","كتاب الأدب"
"27183","(۲۷۱۸۳) حَدَّثَنَا أَبُو أُسَامَۃَ قَالَ : حدَّثَنَا سُفْیَانُ ، عَن دِینَارٍ التَّمَّارِ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ قَالَ : کَانَ عَبْدُ اللہِ یَمْشِی مَعَ نَاسٍ مِن أَصْحَابِہِ ذَاتَ یَوْمٍ فَانْقَطَعَ شِسْعُ نَعْلِہِ فَاسْتَرْجَعَ ، فَقَالَ لَہُ بَعْضُ الْقَوْمِ : یَا أَبَا عَبْدِ الرَّحْمَنِ ، تَسْتَرْجِعُ عَلَی سَیْرٍ ؟ قَالَ : مَا بِی أن لاَ تَکُونَ السُّیُورُ کَثِیرًا وَلَکِنَّہَا مُصِیبَۃٌ۔","","Musannaf Ibn Abi Shaybah 27183","","","كتاب الأدب"
"27184","(۲۷۱۸۴) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ خَلِیفَۃَ ، عَن عُمَرَ بْنِ الْخَطَّابِ ، أَنَّہُ انْقَطَعَ شِسْعُہُ فَاسْتَرْجَعَ ، وَقَالَ : کُلُّ مَا سَائَک ، فَہُوَ مُصِیبَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 27184","","","كتاب الأدب"
"27185","(۲۷۱۸۵) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی قَالَ : أَخْبَرَنَا شَیْبَانُ ، عَن مَنْصُورٍ ، عَن مُجَاہِدٍ ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : انْقَطَعَ قُبَالُ نَعْلِ عُمَرَ فَقَالَ : إنَّا لِلَّہِ وَإِنَّا إلَیْہِ رَاجِعُونَ ، فَقَالُوا : یَا أَمِیرَ الْمُؤْمِنِینَ ، أَفِی قُبَالِ نَعْلِکَ ؟ قَالَ : نَعَمْ ، کُلُّ شَیْئٍ أَصَابَ الْمُؤْمِنَ یَکْرَہُہُ ، فَہُوَ مُصِیبَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 27185","","","كتاب الأدب"
"27186","(۲۷۱۸۶) حَدَّثَنَا حُسَیْنُ بْنُ مُحَمَّدٍ قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنْ عَائِشَۃَ رضی اللہ عنہا قَالَتْ : قُولُوا : خَاتَمُ النَّبِیِّینَ ، وَلاَ تَقُولُوا : لاَ نَبِیَّ بَعْدَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 27186","","","كتاب الأدب"
"27187","(۲۷۱۸۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن مُجَالِدٍ قَالَ : أَخْبَرَنَا عَامِرٌ قَالَ : قَالَ رَجُلٌ عِنْدَ الْمُغِیرَۃِ بْنِ شُعْبَۃَ : صَلَّی اللَّہُ عَلَی مُحَمَّدٍ خَاتَمِ الأَنْبِیَائِ ، لاَ نَبِیَّ بَعْدَہُ ، قَالَ الْمُغِیرَۃُ : حَسْبُک إذَا قُلْتَ : خَاتَمُ الأَنْبِیَائِ ، فَإِنَّا کُنَّا نُحَدِّثُ، أَنَّ عِیسَی خَارِجٌ ، فَإِنْ ہُوَ خَرَجَ ، فَقَدْ کَانَ قَبْلَہُ وَبَعْدَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 27187","","","كتاب الأدب"
"27188","(۲۷۱۸۸) حَدَّثَنَا وَکِیعٌ، عَن یُونُسَ، عَنِ الزُّہْرِیِّ قَالَ: نَہَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، عَن قَتْلِ النَّمْلِ وَالنَّحْلِ۔n(ابوداؤد ۵۲۲۵۔ احمد ۳۳۲)","","Musannaf Ibn Abi Shaybah 27188","","","كتاب الأدب"
"27189","(۲۷۱۸۹) حَدَّثَنَا وَکِیعٌ ، عَن حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا آذَاک النَّمْلَ فَاقْتُلْہُ۔","","Musannaf Ibn Abi Shaybah 27189","","","كتاب الأدب"
"27190","(۲۷۱۹۰) حَدَّثَنَا وَکِیعٌ ، عَن خَالِدِ بْنِ دِینَارٍ قَالَ : رَأَیْتُ أَبَا الْعَالِیَۃِ رَأَی نَمْلاً عَلَی بِسَاطٍ فَقَتَلَہُنَّ۔","","Musannaf Ibn Abi Shaybah 27190","","","كتاب الأدب"
"27191","(۲۷۱۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ نَافِعٍ ، عَن سُلَیْمَانَ الأَحْوَلِ ، عَن طَاوُوس قَالَ : إنَّا لَنُفرِّقَ النَّمْلَ بِالْمَائِ یَعْنِی إذَا آذَتْنَا۔","","Musannaf Ibn Abi Shaybah 27191","","","كتاب الأدب"
"27192","(۲۷۱۹۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَن ہِشَامِ بْنِ عُرْوَۃَ قَالَ : قَالَ لِی أَبِی : کَتَبْت ؟ قَالَ : قُلْتُ : نَعَمْ ، قَالَ : عَارَضْت ؟ قُلْتُ : لاَ ، قَالَ : لَمْ تَکْتُبْ۔ (رامھرمزی ۷۱۸)","","Musannaf Ibn Abi Shaybah 27192","","","كتاب الأدب"
"27193","(۲۷۱۹۳) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ، عَن سَوَّارَ بْنِ عَبْدِ اللہِ قَالَ: کَانَ مُحَمَّدٌ یَکْرَہُ أَنْ یَرْفَعَ قَصَّۃً لاَ یَعْلَمُ مَا فِیہَا۔","","Musannaf Ibn Abi Shaybah 27193","","","كتاب الأدب"
"27194","(۲۷۱۹۴) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، قَالَ : سَمِعْتُ أَبَا إِسْحَاقَ یُحَدِّثُ قَالَ : کَانَ عَبْدُ اللہِ یَکْرَہُ أَنْ یَبْزُقَ الرَّجُلُ عَن یَمِینِہِ فِی غَیْرِ صَلاَۃٍ ، فَقَالَ لہ أَبَانُ : عَمَّنْ ؟ فَقَالَ : عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 27194","","","كتاب الأدب"
"27195","(۲۷۱۹۵) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ عَوْنٍ قَالَ : کَانَ ابْنُ سِیرِینَ لَہُ بَابٌ عَن یَسَارِہِ مَسْدُودٌ ، وَکَانَ یَلْتَفِتُ إلَیْہِ فَیَبْزُقُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 27195","","","كتاب الأدب"
"27196","(۲۷۱۹۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن مِسْعَر ، عَن سَعْدِ بْنِ إبْرَاہِیمَ ، قَالَ : سَمِعْتُہُ یَقُولُ : مِنْ عَقْلِ الرَّجُلِ مَوْضِعُ بُزَاقِہِ۔","","Musannaf Ibn Abi Shaybah 27196","","","كتاب الأدب"
"27197","(۲۷۱۹۷) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ قَالَ : کَانَ عَبْدُ اللہِ جَالِسًا مُسْتَقْبِلَ الْقِبْلَۃِ ، فأَرَادَ أَنْ یَبْزُقَ عَن شِمَالِہِ وَکَانَ مَشْغُولاً فَکَرِہَ أَنْ یَبْزُقَ عَن یَمِینِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 27197","","","كتاب الأدب"
"27198","(۲۷۱۹۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَن حُمَیْدِ بْنِ ہِلاَلٍ ، أَنَّ مُعَاذًا تَفَلَ ذَاتَ یَوْمٍ ، عَن یَمِینِہِ ، ثُمَّ قَالَ : ہاہ ، مَا صَنَعْت ہَذَا مُنْذُ صَحِبْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَوْ قَالَ : مُنْذُ أَسْلَمْت۔","","Musannaf Ibn Abi Shaybah 27198","","","كتاب الأدب"
"27199","(۲۷۱۹۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ قَالَ : حدَّثَنَا أَبُو ہِلاَلٍ ، عَن حُمَیْدِ بْنِ ہِلاَلٍ قَالَ : بَزَقَ أَبُو بَکْرٍ أو تَفَلَ عَن یَمِینِہِ فِی مِرْضَۃٍ مَرِضَہَا ، فَقَالَ : مَا فَعَلْتہ إلاَّ مَرَّۃً ، أَوْ قَالَ : غَیْرَ ہَذِہِ الْمَرَّۃِ۔","","Musannaf Ibn Abi Shaybah 27199","","","كتاب الأدب"
"27200","(۲۷۲۰۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ عَوْنٍ قَالَ : اعْتَذَرْت إلَی إبْرَاہِیمَ مِنْ شَیْئٍ بَلَغَہُ عَنی ، فَقَالَ : لاَ تَعْتَذِرْ ، قَدْ عَذَرْنَاک غَیْرَ مُعْتَذِرٍ۔","","Musannaf Ibn Abi Shaybah 27200","","","كتاب الأدب"
"27201","(۲۷۲۰۱) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا الأَعْمَشُ ، عَن سُلَیْمَانَ بْنِ مَیْسَرَۃَ ، عَن طَارِقِ بْنِ شِہَابٍ ، عَن رَافِعِ بْنِ أَبِی رَافِعٍ الطَّائِیِّ قَالَ : أَتَیْتُ أَبَا بَکْرٍ فَقُلْت : أَمَرْتَنِی بِمَا أَمَرْتَنِی بِہِ وَدَخَلْتَ فِیمَا دَخَلْتُ فِیہِ ، فَمَا زَالَ یَعْتَذِرُ إلَیَّ حَتَّی عَذَرْتہ۔","Sahih","Musannaf Ibn Abi Shaybah 27201","","","كتاب الأدب"
"27202","(۲۷۲۰۲) حَدَّثَنَا حَفْصٌ، وَابْنُ نُمَیْرٍ، وَوَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ قَالَ قَالَ عَبْدُ اللہِ اتَّقُوا، وَقَالَ حَفْصٌ: إیَّاکُمْ وَالْمَعَاذِرَ ، فَإِنَّ کَثِیرًا مِنْہَا کَذِبٌ۔","","Musannaf Ibn Abi Shaybah 27202","","","كتاب الأدب"
"27203","(۲۷۲۰۳) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِاللہِ الأَسَدِیُّ، عَن سُفْیَانَ، عَن طَارِقٍ، عَنِ الشَّعْبِیِّ قَالَ: خَرَجَ إلَیْنَا شُرَیْحٌ یَعْتَذِرُ۔","","Musannaf Ibn Abi Shaybah 27203","","","كتاب الأدب"
"27204","(۲۷۲۰۴) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَن شُعْبَۃَ قَالَ : کُنْتُ أَمْشِی مَعَ الْحَکَمِ فَرَأَیْنَا أَبَا مَعْشَرٍ فَقَالَ الْحَکَمُ : إنَّ ہَذَا قَدْ بَلَغَہُ عَنی شَیْئٌ أَنِّی قُلْتہ ، وَلاَ وَاللَّہِ الَّذِی لاَ إلَہَ إلاَّ ہُوَ مَا قُلْتہ ، قَالَ : فَلَمَّا جَائَ أَبُو مَعْشَرٍ اعْتَذَرَ إلَیْہِ الْحَکَمُ ، وَقَالَ : قَدْ حَلَفْت لِشُعْبَۃَ أَنِّی لَمْ أَقُلِ الَّذِی بَلَغَک عَنی۔","","Musannaf Ibn Abi Shaybah 27204","","","كتاب الأدب"
"27205","(۲۷۲۰۵) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ عَمِّہِ، قَالَ: سَمِعْتُ الشَّعْبِیَّ یَقُولُ: أَتَانِی إبْرَاہِیمُ یَعْتَذِرُ إلَیَّ مِنْ أَمْرٍ مَا بَلَغَنِی عَنہُ۔","","Musannaf Ibn Abi Shaybah 27205","","","كتاب الأدب"
"27206","(۲۷۲۰۶) حَدَّثَنَا حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن مُوسَی بن عَلِی ، عَنْ أَبِیہِ أَنَّ رَجُلاً اکتَنَی بِأَبِی عِیسَی : فَقالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ عِیسَی لاَ أَب لَہ۔","","Musannaf Ibn Abi Shaybah 27206","","","كتاب الأدب"
"27207","(۲۷۲۰۷) حَدَّثَنَا حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن عَبد اللہِ بْنُ عُمَرَ بْنُ حَفص ، عَن زَیْدِ بْنِ أ[corrupt]سْلَمَ ، عَنْ أَبِیہِ أَنَّ عُمَر ضَرَبَ ابنًا لَہ اکتَنَی بِأَبِی عِیسَی ، وَقَال : إِنَّ عِیسَی لَیسَ لَہُ أَب۔ (عبدالرزاق ۱۹۸۵۷)","Da'if","Musannaf Ibn Abi Shaybah 27207","","","كتاب الأدب"
"27208","(۲۷۲۰۸) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن حُمَیْدٍ ، عَنِ الْحَسَنِ قَالَ : کَثْرَۃُ الضَّحِکِ تُمِیتُ الْقَلْبَ۔ (بخاری ۲۵۲۔ ابن ماجہ ۴۲۱۷)","","Musannaf Ibn Abi Shaybah 27208","","","كتاب الأدب"
"27209","(۲۷۲۰۹) حَدَّثَنَا عَفَّانُ ، عَن حَمَّادِ بْنِ سَلَمَۃَ ، عَن ثَابِتٍ ، عَنِ الْحَسَنِ قَالَ : ضَحِکُ الْمُؤْمِنِ غَفْلَۃٌ مِنْ قَلْبِہِ۔","","Musannaf Ibn Abi Shaybah 27209","","","كتاب الأدب"
"27210","(۲۷۲۱۰) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ عَوْنٍ قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ یَضْحَکُ إلاَّ تَبَسُّمًا ، وَلاَ یَلْتَفِتُ إلاَّ مَعًا۔","","Musannaf Ibn Abi Shaybah 27210","","","كتاب الأدب"
"27211","(۲۷۲۱۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن زَائِدَۃَ ، عَن مَنْصُورٍ ، عَن مُجَاہِدٍ قَالَ : بَلَغَ عُمَرَ ، أَنَّ عَامِلاً لَہُ لاَ یَقِیلْ ، فَکَتَبَ إلَیْہِ عُمَرُ : قِلْ ، فَإِنِّی حُدِّثْتُ أَنَّ الشَّیْطَانَ لاَ یَقِیلُ ، قَالَ مُجَاہِدٌ : إنَّ الشَّیَاطِینَ لاَ یَقِیلُونَ۔","","Musannaf Ibn Abi Shaybah 27211","","","كتاب الأدب"
"27212","(۲۷۲۱۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ وَوَکِیعٌ قَالَ : حدَّثَنَا مِسْعَرٌ قَالَ : حَدَّثَنَی ثَابِتُ بْنُ عُبَیْدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَن خَوَّاتِ بْنِ جُبَیْرٍ وَکَانَ بَدْرِیًّا قَالَ : نَوْمُ أَوَّلِ النَّہَارِ خُرْقٌ ، وَأَوْسَطُہُ خُلُقٌ ، وَآخِرُہُ حُمْقٌ۔","Sahih","Musannaf Ibn Abi Shaybah 27212","","","كتاب الأدب"
"27213","(۲۷۲۱۳) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، عَن مَکْحُولٍ ، أَنَّہُ کَانَ یَکْرَہُ النَّوْمَ بَعْدَ الْعَصْرِ ، وَقَالَ : یَخَافُ عَلَی صَاحِبِہِ مِنْہُ الْوَسْوَاسَ۔","","Musannaf Ibn Abi Shaybah 27213","","","كتاب الأدب"
"27214","(۲۷۲۱۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : مَرَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِرَجُلٍ مُنْبَطِحٍ عَلَی بَطْنِہِ ، فَقَالَ : إنَّ ہَذِہِ ضَجْعَۃٌ لاَ یُحِبُّہَا اللَّہُ۔n(ترمذی ۲۷۶۸۔ احمد ۲۸۷)","","Musannaf Ibn Abi Shaybah 27214","","","كتاب الأدب"
"27215","(۲۷۲۱۵) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی قَالَ : حدَّثَنَا شَیْبَانُ ، عَن یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃَ ، أَنَّ یَعِیشَ بْنَ قَیْسِ بْنِ طِخْفَۃَ حَدَّثَہُ ، عَنْ أَبِیہِ قَالَ : وَکَانَ أَبِی مِنْ أَصْحَابِ الصُّفَّۃِ ، قَالَ : بَیْنَا أَنَا نَائِمٌ عَلَی بَطْنِی مِنَ السَّحَرِ إذْ دَفَعَنی رَجُلٌ بِرِجْلِہِ فَقَالَ : ہَذِہِ ضَجْعَۃٌ یُبْغِضُہَا اللَّہُ ، فَرَفَعْت رَأْسِی فَإِذَا ہُوَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (ابوداؤد ۵۰۰۱۔ احمد ۴۲۹)","Da'if","Musannaf Ibn Abi Shaybah 27215","","","كتاب الأدب"
"27216","(۲۷۲۱۶) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ قَالَ : حدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِیَادٍ قَالَ : حَدَّثَنَا عَاصِمُ بْنُ کُلَیْبٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کُلُّ خُطْبَۃٍ لَیْسَ فِیہَا تَشَہُّدٌ کَالْیَدِ الْجَذْمَائِ۔ (ترمذی ۱۱۰۶۔ ابوداؤد ۴۸۰۸)","Hasan","Musannaf Ibn Abi Shaybah 27216","","","كتاب الأدب"
"27217","(۲۷۲۱۷) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَطَائٍ ، عَنْ أَبِی الْبَخْتَرِیِّ قَالَ : کُلُّ حَاجَۃٍ لَیْسَ فِیہَا تَشَہُّدٌ فَہِیَ بَتْرَائُ۔","","Musannaf Ibn Abi Shaybah 27217","","","كتاب الأدب"
"27218","(۲۷۲۱۸) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : سَمِعت حُمَیْدَ بْنَ ہِلاَلٍ یَقول : کُل خطبۃ لَیْسَ فِیہَا تَشَہُّدٌ فَہِیَ بَتْرَائُ۔","","Musannaf Ibn Abi Shaybah 27218","","","كتاب الأدب"
"27219","(۲۷۲۱۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنِ الأَوْزَاعِیِّ ، عَن قُرَّۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : کُلُّ کَلاَمٍ ذِی بَالٍ لاَ یُبْدَأُ فِیہِ بِالْحَمْدِ لِلَّہِ ، فَہُوَ أَقْطَعُ۔n(ابوداؤد ۴۸۰۷۔ احمد ۳۵۹)","Da'if","Musannaf Ibn Abi Shaybah 27219","","","كتاب الأدب"
"27220","(۲۷۲۲۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَبِی الْمُہَزَّمِ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّہُ رَأَی رَجُلاً یَشْتَدُّ خَلْفَہُ غُلاَمٌ فَقَالَ : احْمِلْہُ فَإِنَّہُ أَخُوک الْمُسْلِمُ ، وَرُوحُہُ مِثْلُ رُوحِک۔","Da'if","Musannaf Ibn Abi Shaybah 27220","","","كتاب الأدب"
"27221","(۲۷۲۲۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن یُوسُفَ بْنِ الْمُہَاجِرِ قَالَ : رَأَیْتُ أَبَا جَعْفَرٍ رَاکِبًا عَلَی بَغْلٍ ، أَوْ بَغْلَۃٍ مَعَہُ غُلاَمٌ یَمْشِی جَنَبَتیہ۔","","Musannaf Ibn Abi Shaybah 27221","","","كتاب الأدب"
"27222","(۲۷۲۲۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن شُعْبَۃَ قَالَ حَدَّثَتْنِی شُمَیْسَۃُ ، قَالَتْ : سَمِعْت عَائِشَۃَ ، وَسُئلت عَنْ أَدَبِ الْیَتِیمِ فَقَالَتْ : إنِّی لأَضْرِبُ أَحَدَہُمْ حَتَّی یَنْبَسِطَ۔","Sahih","Musannaf Ibn Abi Shaybah 27222","","","كتاب الأدب"
"27223","(۲۷۲۲۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ الْعُرَنِیِّ ، أَنَّ رَجُلاً قَالَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مِمَّ أَضْرِبُ یَتِیمِی ؟ قَالَ : اضْرِبْہُ مِمَّا کُنْت ضَارِبًا مِنْہُ وَلَدَک۔ (طبری ۲۶۰)","Hasan","Musannaf Ibn Abi Shaybah 27223","","","كتاب الأدب"
"27224","(۲۷۲۲۴) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی جَعْفَرٍ الْخَطْمِیِّ ، أَنَّ أَبَاہُ سَأَلَ سَعِیدَ بْنَ الْمُسَیَّبِ ، أَوْ قَالَ : أَرْسِلْ مَوْلًی لَہُ وَأَنَا مَعَہُ یَسْأَلُہُ : مِمَّ یَضْرِبُ الرَّجُلُ یَتِیمَہُ ؟ قَالَ : مِمَّ یَضْرِبُ الرَّجُلُ وَلَدَہُ ، قَالَ أَبُو جَعْفَرٍ : وَسَأَلَ مُحَمَّدَ بْنَ کَعْبٍ فَقَالَ مِثْلُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 27224","","","كتاب الأدب"
"27225","(۲۷۲۲۵) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، عَن مُحَمَّدٍ قَالَ : قرَأْت کِتَابًا فِیہِ مَا شَائَ اللَّہُ وَالأَمِیرُ فَقَالَ : مَا شَائَ الأَمِیرُ بَعْدَ اللہِ۔","","Musannaf Ibn Abi Shaybah 27225","","","كتاب الأدب"
"27226","(۲۷۲۲۶) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن مَنْصُورٍ ، عَنْ عَبْدِ اللہِ بْنِ یَسَارٍ ، عَن حُذَیْفَۃَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَقُولُوا : مَا شَائَ اللَّہُ وَشَائَ فُلاَنٌ ، وَلَکِنْ قُولُوا : مَا شَائَ اللَّہُ ، ثُمَّ شَائَ فُلاَنٌ۔n(ابوداؤد ۴۹۴۱۔ احمد ۳۸۴)","Sahih","Musannaf Ibn Abi Shaybah 27226","","","كتاب الأدب"
"27227","(۲۷۲۲۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الأَجْلَحِ ، عَن یَزِیدَ بْنِ الأَصَمِّ ، عَنِ ابْنِ عَبَّاسٍ قَالَ : جَائَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَحَدَّثَہُ بِبَعْضِ الْکَلاَمِ فَقَالَ : مَا شَائَ اللَّہُ وَشِئْت ، فَقَالَ : جَعَلْتَنِی وَاللہ عَدْلاً ، لاَ بَلْ مَا شَائَ اللَّہُ۔ (ابن ماجہ ۲۱۱۷۔ احمد ۲۱۴)","Hasan","Musannaf Ibn Abi Shaybah 27227","","","كتاب الأدب"
"27228","(۲۷۲۲۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَن سَالِمٍ ، عَن زُرْعَۃَ بْنِ مُسْلِمِ بْنِ جَرْہَدٍ ، عَنْ جَدِّہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَبْصَرَہُ فِی الْمَسْجِدِ وَعَلَیْہِ بُرْدَۃٌ قَدِ انْکَشَفَ فَخِذُہُ فَقَالَ : إنَّ الْفَخِذَ مِنَ الْعَوْرَۃِ۔ (ترمذی ۲۷۹۸۔ ابوداؤد ۴۰۱۰)","Sahih","Musannaf Ibn Abi Shaybah 27228","","","كتاب الأدب"
"27229","(۲۷۲۲۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ قَالَ : حدَّثَنَا ابْنُ صَالِحٍ ، عَن مَنْصُورٍ قَالَ : قَالَ عُمَرُ : فَخْذُ الرَّجُلِ مِنَ الْعَوْرَۃِ۔","","Musannaf Ibn Abi Shaybah 27229","","","كتاب الأدب"
"27230","(۲۷۲۳۰) حَدَّثَنَا جَرِیرٌ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَقُولُ : الْفَخِذُ مِنَ الْعَوْرَۃِ۔","","Musannaf Ibn Abi Shaybah 27230","","","كتاب الأدب"
"27231","(۲۷۲۳۱) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَن لَیْثٍ ، عَن مُجَاہِدٍ قَالَ : خُرُوجُ الْفَخْذِ فِی الْمَسْجِدِ مِنَ الْعَوْرَۃِ۔","","Musannaf Ibn Abi Shaybah 27231","","","كتاب الأدب"
"27232","(۲۷۲۳۲) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی یَحْیَی ، عَن مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : الْفَخْذُ مِنَ الْعَوْرَۃِ۔ (ترمذی ۲۷۹۶۔ احمد ۲۷۵)","Da'if","Musannaf Ibn Abi Shaybah 27232","","","كتاب الأدب"
"27233","(۲۷۲۳۳) حَدَّثَنَا جَعفَر بْنُ عَوْنٍ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ عَوْنِ بْنِ أَبِی جُحَیْفَۃَ ، عَنْ أَبِیہِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ آخَی بَیْنَ سَلْمَانَ ، وَأَبِی الدَّرْدَائِ۔ (بخاری ۱۹۶۸۔ ترمذی ۲۴۱۳)","Sahih","Musannaf Ibn Abi Shaybah 27233","","","كتاب الأدب"
"27234","(۲۷۲۳۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَن ہِشَامِ بْنِ عُرْوَۃَ ، عَن بَشِیرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ کَعْبِ بْنِ مَالِکٍ قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ آخَی بَیْنَ الزُّبَیْرِ وَبَیْنَ کَعْبِ بْنِ مَالِکٍ۔ (ابن سعد ۱۰۲)","","Musannaf Ibn Abi Shaybah 27234","","","كتاب الأدب"
"27235","(۲۷۲۳۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ أَبِی فَرْوَۃَ قَالَ : قَالَ ابْنُ أَبِی لَیْلَی : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ آخَی بَیْنَ زَیْدٍ وحَمْزَۃَ ۔","","Musannaf Ibn Abi Shaybah 27235","","","كتاب الأدب"
"27236","(۲۷۲۳۶) حَدَّثَنَا قَبِیصَۃُ ، عَن حَمَّادِ بْنِ سَلَمَۃَ ، عَن ثَابِتٍ ، عَنْ أَنَسٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ آخَی بَیْنَ أَبِی طَلْحَۃَ وَبَیْنَ أَبِی عُبَیْدَۃَ بْنِ الْجَرَّاحِ۔ (حاکم ۲۶۸)","Sahih","Musannaf Ibn Abi Shaybah 27236","","","كتاب الأدب"
"27237","(۲۷۲۳۷) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن ثَابِتٍ ، عَن شَہْرِ بْنِ حَوْشَبٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ آخَی بَیْنَ عَوْفِ بْنِ مَالِکٍ وَالصَّعْبِ بْنِ جَثَّامَۃَ۔","","Musannaf Ibn Abi Shaybah 27237","","","كتاب الأدب"
"27238","(۲۷۲۳۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الْحَجَّاجِ ، عَنِ الْحَکَمِ ، عَن مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لِعَلِیٍّ ، أَنتَ أَخِی وَصَاحِبِی۔ (ترمذی ۳۷۲۰۔ احمد ۲۳۰)","","Musannaf Ibn Abi Shaybah 27238","","","كتاب الأدب"
"27239","(۲۷۲۳۹) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ قَالَ : أَخْبَرَنَا حُمَیْدٌ ، عَنْ أَنَسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ آخَی بَیْنَ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ وَسَعْدِ بْنِ الرَّبِیعِ۔ (بخاری ۲۰۴۹۔ احمد ۲۷۱)","Sahih","Musannaf Ibn Abi Shaybah 27239","","","كتاب الأدب"
"27240","(۲۷۲۴۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَن مُحَمَّدٍ قَالَ : مَا تَرَکَ الرَّجُلُ أَنْ یَأْخُذَ مِنْ دِرْہَمِ صَدِیقِہِ۔","","Musannaf Ibn Abi Shaybah 27240","","","كتاب الأدب"
"27241","(۲۷۲۴۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : لَقَدْ رَأَیْتنَا وَمَا الرَّجُلُ الْمُسْلِمُ بِأَحَقَّ بِدِینَارِہِ ، وَلاَ دِرْہَمِہِ مِنْ أَخِیہِ الْمُسْلِمِ۔","Sahih","Musannaf Ibn Abi Shaybah 27241","","","كتاب الأدب"
"27242","(۲۷۲۴۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ قَالَ : قَالَ لَہُ عَلْقَمَۃُ : یَا أَبَا عَمْرٍو ، فَقَالَ : لَبَّیْکَ ، فَقَالَ لَہُ : عَلْقَمَۃُ : لبِّیْ یَدَیْک۔","","Musannaf Ibn Abi Shaybah 27242","","","كتاب الأدب"
"27243","(۲۷۲۴۳) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، عَن مُغِیرَۃَ ، عَنْ أَبِی وَائِلٍ قَالَ : کَانَ إذَا دُعِیَ قَالَ : لَبَّیِ اللَّہَ ، وَلاَ یَقُولُ : لَبَّیْکَ۔","","Musannaf Ibn Abi Shaybah 27243","","","كتاب الأدب"
"27244","(۲۷۲۴۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَن سُفْیَانَ ، عَن سَعْدِ بْنِ یُوسُفَ بْنِ یَعْقُوبَ قَالَ : قالُوا لِطَاوُوس فِی عَبْدٍ لَہُ فَقَالَ : مَا لَہُ مَالٌ أکاتبہ ، وَلاَ ہُوَ صَالِحٌ فَأُزَوِّجُہُ ، وَکَانَ یَکْرَہُ الضَّرْبَ ، وَیَقُولُ : الْقَیْدُ۔","","Musannaf Ibn Abi Shaybah 27244","","","كتاب الأدب"
"27245","(۲۷۲۴۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ إبْرَاہِیمَ بْنِ طَہْمَانَ عَمَّنْ حَدَّثَہُ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَجْعَلَ الرَّجُلُ فِی عُنُقِ غُلاَمِہِ الرَّایَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 27245","","","كتاب الأدب"
"27246","(۲۷۲۴۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن ہِشَامٍ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَجْعَلَ الرَّجُلُ فِی عُنُقِ غُلاَمِہِ الْبَرَّایَۃَ۔","","Musannaf Ibn Abi Shaybah 27246","","","كتاب الأدب"
"27247","(۲۷۲۴۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَن مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ، أَنَّہُ قَالَ لِرَجُلٍ وَذَکَرَ امْرَأَتَہُ فَقَالَ : قیِّدْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 27247","","","كتاب الأدب"
"27248","(۲۷۲۴۸) حَدَّثَنَا وَکِیعٌ ، عَن أُسَامَۃَ بْنِ زَیْدٍ ، عَن مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، عَنْ جَابِرٍ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : سَلُوا اللَّہَ عِلْمًا نَافِعًا وَتَعَوَّذُوا بِاللَّہِ مِنْ عِلْمٍ لاَ یَنْفَعُ۔ (بخار ی۳۲۲۰۔ احمد ۲۳۰)","Hasan","Musannaf Ibn Abi Shaybah 27248","","","كتاب الأدب"
"27249","(۲۷۲۴۹) حَدَّثَنَا وَکِیعٌ ، عَن شُعْبَۃَ ، عَن غَالِبٍ الْعَبْدِیِّ ، عَن رَجُلٍ مِنْ بَنِی نمیر ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، أَوْ جَدِّ أَبِیہِ قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، إنَّ أَبِی یُقْرِئُک السَّلاَمَ ، قَالَ : عَلَیْک وَعَلَی أَبِیک السَّلاَمُ ، قُلْتُ : یَا رَسُولَ اللہِ ، إنَّ قَوْمِی یُرِیدُونَ أَنْ یُعَرِّفُونِی ، قَالَ : لاَ بُدَّ مِنْ عَرِیفٍ ، وَالْعَرِیفُ فِی النَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 27249","","","كتاب الأدب"
"27250","(۲۷۲۵۰) حَدَّثَنَا وَکِیعٌ ، عَنِ أََبِی سَعِید ، عَن رَجُلٍ لَمْ یَکُنْ یُسَمِّہِ سَمِعَ أَنَسًا یَقُولُ : وَیْلٌ لِلْعُرَفَائِ وَالنُّقَبَائِ ، وَیْلٌ لِلأمَنَائِ ، وَدَّ أَحَدُہُمْ یَوْمَ الْقِیَامَۃِ لَوْ کَانَ مُعَلَّقًا بِالثُّرَیَّا۔ (احمد ۵۳۱۔ ابویعلی ۶۱۸۹)","Da'if","Musannaf Ibn Abi Shaybah 27250","","","كتاب الأدب"
"27251","(۲۷۲۵۱) حَدَّثَنَا وَکِیعٌ ، عَن عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ ، عَن حَبِیبِ بْنِ حَیْدَۃَ قَالَ : لأَنْ أُقْطَعَ أَحَبُّ إلَیَّ مِنْ أَنْ أَکُونَ عَرِیفًا عَلَی عَشْرَۃٍ سَنَۃً۔","","Musannaf Ibn Abi Shaybah 27251","","","كتاب الأدب"
"27252","(۲۷۲۵۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَن عُثْمَانَ بْنِ حَکِیمٍ قَالَ : أَخْبَرَنِی عَبْدُ اللہِ بْنُ عُثْمَانَ ، عَنْ رَجُلُ مِنْ بَنِی سَلُولَ ، أَنَّہُ دَعَاہُ قَوْمُہُ لِیُعَرِّفُوہُ ، وَاخْتَارُوہُ لِذَلِکَ ، فَأَبَی وَامْتَنَعَ ، فَذَہَبَ إلَی عَبْدِ اللہِ بْنِ عَمْرٍو فَشَاوَرَہُ وَاسْتَأْمَرَہُ فَقَالَ : لاَ تَعْرِفَنَّ عَلَیْہِمْ فَجَاؤوا بِالْغَدْوَی فَلَمْ یَزَالُوا حَتَّی أَلْزَمُوہَا إیَّاہُ ، فَذَہَبَ إلَی عَبْدِ اللہِ بْنِ عَمْرٍو فَأَخْبَرَہُ ، أَنَّہُ قَدْ أُکْرِہَ فَقَالَ : أَوَّلُہَا شُفْعَۃٌ وَأَوْسَطُہَا خِیَانَۃٌ وَآخِرُہَا عَذَابُ النَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 27252","","","كتاب الأدب"
"27253","(۲۷۲۵۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَن غَالِبٍ قَالَ: إنَّا لَجُلُوسٌ إذْ رَجُلٌ دَخَلَ فَقَالَ: حَدَّثَنِی أَبِی، عَنْ جَدِّی، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ: مَنِ ابْتَدَأَ قَوْمًا بِسَلاَمٍ فَضَلَہُمْ بِعَشْرِ حَسَنَاتٍ ، وَقَالَ: بَعَثَنِی أَبِی إلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَقَالَ : ائْتِہِ فَأُقْرِئْہُ السَّلاَمَ ، وَقُلْ لَہُ ہُوَ یَطْلُبُ إلَیْک أَنْ تَجْعَلَ لَہُ الْعِرَافَۃُ مِنْ بَعْد ، قَالَ : الْعِرَافَۃُ حَقٌّ ، الْعِرَافَۃُ حَقٌّ ، وَلاَ بُدَّ مِنْ عُرَفَائَ ، وَلَکِنَّ الْعَرِیفَ بِمَنْزِلَۃٍ قَبِیحَۃٍ۔(ابوداؤد ۵۱۸۹۔ بزار ۸۰۸)","Da'if","Musannaf Ibn Abi Shaybah 27253","","","كتاب الأدب"
"27254","(۲۷۲۵۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ قَالَ : حدَّثَنَا قُرَّۃُ ، عَن حُمَیْدِ بْنِ ہِلاَلٍ قَالَ : قَالَ أَبُو السَّوَّارِ : وَاللَّہُ لَوَدِدْت أَنَّ حَدَقَتِی فِی حِجْرِی مَکَانَ الْعِرَافَۃِ۔","","Musannaf Ibn Abi Shaybah 27254","","","كتاب الأدب"
"27255","(۲۷۲۵۵) حَدَّثَنَا الْفَضْلُ قَالَ : حدَّثَنَا سَلاَّمُ بْنُ مِسْکِینٍ ، عَن مُحَمَّدِ بْنِ وَاسِعٍ ، عَنِ الْمَہْرِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : قَالَ لِی : یَا مَہْرِیُّ ، لاَ تَکُنْ جَابِیًا ، وَلاَ عَرِیفًا ، وَلاَ شُرْطِیًّا۔","Da'if","Musannaf Ibn Abi Shaybah 27255","","","كتاب الأدب"
"27256","(۲۷۲۵۶) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَن مُحَمَّدٍ قَالَ : کَانَ عَبِیْدَۃُ عَرِیفَ قَوْمِہِ۔","","Musannaf Ibn Abi Shaybah 27256","","","كتاب الأدب"
"27257","(۲۷۲۵۷) حَدَّثَنَا الْفَضْلُ ، عَن قُرَّۃَ قَالَ : کَانَ أَبُو السَّوَّارِ عَرِیفًا فِی زَمَنِ الْحَجَّاجِ۔","","Musannaf Ibn Abi Shaybah 27257","","","كتاب الأدب"
"27258","(۲۷۲۵۸) حَدَّثَنَا غَسَّانُ بْنُ مُضَرَ ، عَن سَعِیدِ بْنِ یَزِیدَ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ جَابِرٍ قَالَ : لَمَّا وَلِیَ عُمَرُ الْخِلاَفَۃَ فَرَضَ الْفَرَائِضَ ، وَدَوَّنَ الدَّوَاوِینَ ، وَعَرَّفَ الْعُرَفَائَ ، قَالَ جَابِرٌ : فَعَرَّفَنِی عَلَی أَصْحَابِی۔","Sahih","Musannaf Ibn Abi Shaybah 27258","","","كتاب الأدب"
"27259","(۲۷۲۵۹) حَدَّثَنَا الْفَضْلُ قَالَ : حدَّثَنَا یُونُسُ بْنِ أَبِی إِسْحَاقَ قَالَ : رَأَیْتُ سَعِید بْنَ وَہْب وَکَانَ عَرِیفَ قَوْمِہِ۔","","Musannaf Ibn Abi Shaybah 27259","","","كتاب الأدب"
"27260","(۲۷۲۶۰) حَدَّثَنَا مَرْحُومُ بن عَبْدِ العزیز ، عَنْ أَبِیہِ : کَانَ أَبُو السَّوَّارِ عَرِیفَ بَنِی عَدِیٍّ۔","","Musannaf Ibn Abi Shaybah 27260","","","كتاب الأدب"
"27261","حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ بَقِیُّ بْنُ مَخْلَدٍ قَالَ : حدَّثَنَا أَبُو بَکْرٍ عَبْدُ اللہِ بْنُ مُحَمَّدِ بْنِ أَبِی شَیْبَۃَ الْعَبْسِیُّ قَالَ:n(۲۷۲۶۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَن عِکْرِمَۃَ قَالَ : قَضَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِرَجُلٍ مِنَ الأَنْصَارِ قَتَلَہُ مَوْلَی بَنِی عَدِیٍّ بِالدِّیَۃِ اثْنَیْ عَشَرَ أَلْفًا ، وَفِیہِمْ نَزَلَتْ : {وَمَا نَقَمُوا إِلاَّ أَنْ أَغْنَاہُمُ اللَّہُ وَرَسُولُہُ مِنْ فَضْلِہِ}۔ (ابوداؤد ۴۵۳۴۔ ترمذی ۱۳۸۸)","","Musannaf Ibn Abi Shaybah 27261","","","كتاب الديات"
"27262","(۲۷۲۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَیُّوبَ بْنِ مُوسَی ، عَنْ مَکْحُولٍ قَالَ : تُوُفِّیَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالدِّیَۃُ ثَمَانُ مِئَۃِ دِینَارٍ ، فَخَشِیَ عُمَرُ مِنْ بَعْدِہِ ، فَجَعَلَہَا اثْنَیْ عَشَرَ أَلْفَ دِرْہَمٍ ، أَوْ أَلْفَ دِینَارٍ۔","","Musannaf Ibn Abi Shaybah 27262","","","كتاب الديات"
"27263","(۲۷۲۶۳) حَدَّثَنَا وَکِیعٌ ، قَالَ: حَدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، عَنْ عَبِیدَۃَ السَّلْمَانِیِّ قَالَ: وَضَعَ عُمَرُ الدِّیَاتِ، فَوَضَعَ عَلَی أَہْلِ الذَّہَبِ أَلْفَ دِینَارٍ ، وَعَلَی أَہْلِ الْوَرِقِ عَشَرَۃَ آلاَفٍ ، وَعَلَی أَہْلِ الإِبِلِ مِئَۃ مِنَ الإِبِلِ ، وَعَلَی أَہْلِ الْبَقَرِ مِئَتَیْ بَقَرَۃٍ مُسِنَّۃٍ ، وَعَلَی أَہْلِ الشَّاۃِ أَلْفَیْ شَاۃٍ ، وَعَلَی أَہْلِ الْحُلَلِ مِئَتَیْ حُلَّۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 27263","","","كتاب الديات"
"27264","(۲۷۲۶۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَطَائٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَضَعَ الدِّیَۃَ عَلَی النَّاسِ فِی أَمْوَالِہِمْ مَا کَانَتْ : عَلَی أَہْلِ الإِبِلِ مِئَۃ بَعِیرٍ ، وَعَلَی أَہْلِ الشَّاۃِ أَلْفَیْ شَاۃٍ ، وَعَلَی أَہْلِ الْبَقَرِ مِئَتَیْ بَقَرَۃٍ ، وَعَلَی أَہْلِ الْبُرُودِ مِئَتَیْ حُلَّۃٍ ، قَالَ : وَقَدْ جَعَلَ عَلَی أَہْلِ الطَّعَامِ شَیْئًا لاَ أَحْفَظُہُ۔ (ابوداؤد ۴۵۳۱)","","Musannaf Ibn Abi Shaybah 27264","","","كتاب الديات"
"27265","(۲۷۲۶۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ إِلَی أُمَرَائِ الأَجْنَادِ : إِنَّ الدِّیَۃَ کَانَتْ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِئَۃَ بَعِیرٍ۔","","Musannaf Ibn Abi Shaybah 27265","","","كتاب الديات"
"27266","(۲۷۲۶۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : دِیَۃُ الْخَطَأِ مِئَۃ بَعِیرٍ ، فَمَنْ زَادَ بَعِیرًا فَہُوَ مِنْ أَمْرِ الْجَاہِلِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 27266","","","كتاب الديات"
"27267","(۲۷۲۶۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ؛ أَنَّہُ جَعَلَ الدِّیَۃَ مِئَۃَ بَعِیرٍ ، وَقَوَّمَ کُلَّ بَعِیرٍ مِئَۃ ، غَلَتْ ، أَوْ رَخُصَتْ ، فَأَخَذَ النَّاسُ بِہَا۔","","Musannaf Ibn Abi Shaybah 27267","","","كتاب الديات"
"27268","(۲۷۲۶۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی خَالِدٍ ، عَنْ عَامِرٍ ، عَنْ عَلِیٍّ ، وَعَبْدِ اللہِ ، وَزَیْدٍ ؛ أَنَّہُمْ قَالُوا : الدِّیَۃُ مِئَۃ بَعِیرٍ۔","","Musannaf Ibn Abi Shaybah 27268","","","كتاب الديات"
"27269","(۲۷۲۶۹) حَدَّثَنَا إِسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن خَالِدٍ ، عَن عِکْرِمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : إِنِّی لأُسَبِّحُ کُلَّ یَوْمٍ ثِنْتَیْ عَشْرَۃَ أَلْفِ تَسْبِیحَۃٍ ، قَدْرَ دِیَتِی ، أَوْ قَالَ : قَدْرَ دِیَتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 27269","","","كتاب الديات"
"27270","(۲۷۲۷۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ عَمْرِو بْنِ عَبْدِ اللہِ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ قَضَی بِالدِّیَۃِ عَلَی أَہْلِ الْقُرَی اثْنَیْ عَشَرَ أَلْفًا ، وَقَالَ : إِنَّ الزَّمَانَ یَخْتَلِفُ ، وَأَخَافُ عَلَیْکُمُ الْحُکَّامَ مِنْ بَعْدِی، فَلَیْسَ عَلَی أَہْلِ الْقُرَی زِیَادَۃٌ فِی تَغْلِیظِ عَقْلٍ، وَلاَ الشَّہْرِ الْحَرَامِ، وَلاَ الْحُرْمَۃِ، وَعَقْلُ أَہْلِ الْقُرَی فِیہِ تَغْلِیظٌ ، لاَ زِیَادَۃَ فِیہِ۔","Da'if","Musannaf Ibn Abi Shaybah 27270","","","كتاب الديات"
"27271","(۲۷۲۷۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ؛ أَنَّ قَتَادَۃَ رَجُلاً مِنْ بَنِی مُدْلِجٍ قَتَلَ ابْنَہُ ، فَأَخَذَ مِنْہُ عُمَرُ مِئَۃً مِنَ الإِبِلِ : ثَلاَثِینَ حِقَّۃً ، وَثَلاَثِینَ جَذَعَۃً ، وَأَرْبَعِینَ خَلِفَۃً۔","","Musannaf Ibn Abi Shaybah 27271","","","كتاب الديات"
"27272","(۲۷۲۷۲) حَدَّثَنَا یَحْیَی بْنُ آدَمَ قَالَ: حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ، عَنْ عَلِیِّ بْنِ زَیْدِ بْنِ جُدْعَانَ، عَنِ الْقَاسِمِ بْنِ رَبِیعَۃَ، عَنِ ابْنِ عُمَرَ ، قَالَ: خَطَبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ فَتْحِ مَکَّۃَ ، فَقَامَ عَلَی دَرَجِ الْکَعْبَۃِ ، فَقَالَ: الْحَمْدُ لِلَّہِ الَّذِی صَدَقَ وَعْدَہُ ، وَنَصَرَ عَبْدَہُ ، وَہَزَمَ الأَحْزَابَ وَحْدَہُ ، أَلاَ إِنَّ قَتِیلَ الْعَمْدِ الْخَطَأِ بِالسَّوْطِ ، أَوِ الْعَصَا فِیہِ الدِّیَۃُ مُغَلَّظَۃٌ : مِئَۃٌ مِنَ الإِبِلِ ، أَرْبَعُونَ خَلِفَۃً فِی بُطُونِہَا أَوْلاَدُہَا۔ (ابوداؤد ۴۵۳۶۔ احمد ۱۱)","Da'if","Musannaf Ibn Abi Shaybah 27272","","","كتاب الديات"
"27273","(۲۷۲۷۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی أَسْنَانِ الإِبِلِ فِی الدِّیَۃِ ، قَالَ : ثَلاَثُونَ خَلِفَۃً ، وَثَلاَثُونَ جَذَعَۃً ، وَعِشْرُونَ ابْنَۃَ مَخَاضٍ ، وَعِشْرُونَ ابْنَۃَ لَبُونٍ۔","","Musannaf Ibn Abi Shaybah 27273","","","كتاب الديات"
"27274","(۲۷۲۷۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ قَالَ : کَانَ الزُّہْرِیُّ یَقُولُ : مِئَتَیْ بَقَرَۃٍ ، أَوْ أَلْفَیْ شَاۃٍ۔","","Musannaf Ibn Abi Shaybah 27274","","","كتاب الديات"
"27275","(۲۷۲۷۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ قَالَ : حدَّثَنَا سَعِیدُ بْنُ عُبَیْدٍ ، عَن بُشَیْرِ بْنِ یَسَارٍ ، عَن سَہْلِ بْنِ أَبِی حَثْمَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَدَی رَجُلاً بِمِئَۃٍ مِنَ الإِبِلِ۔ (بخاری ۶۸۹۸۔ مسلم ۱۲۹۱)","Sahih","Musannaf Ibn Abi Shaybah 27275","","","كتاب الديات"
"27276","(۲۷۲۷۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ: مِئَۃٌ مِنَ الإِبِلِ، أَوْ قِیمَتُہَا مِنْ غَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 27276","","","كتاب الديات"
"27277","(۲۷۲۷۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ إِسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : یُعْطِی أَہْلُ الإِبِلِ الإِبِلَ ، وَأَہْلُ الْبَقَرِ الْبَقَرَ ، وَأَہْلُ الشَّائِ الشَّائَ ، وَأَہْلُ الْوَرِقِ الْوَرِقَ۔","","Musannaf Ibn Abi Shaybah 27277","","","كتاب الديات"
"27278","(۲۷۲۷۸) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّ عُمَرَ ، وَعُثْمَانَ قَوَّمَا الدِّیَۃَ ، وَجَعَلاَ ذَلِکَ إِلَی الْمُعْطِی ، إِنْ شَائَ فَالإِبِلُ ، وَإِنْ شَائَ فَالْقِیمَۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 27278","","","كتاب الديات"
"27279","(۲۷۲۷۹) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ قَالَ: إِنْ کَانَ الَّذِی أَصَابَہُ مِنَ الأَعْرَابِ، فَدِیَتُہُ مِئَۃٌ مِنَ الإِبِلِ، لاَ یُکَلَّفُ الأَعْرَابِیُّ الذَّہَبَ، وَلاَ الْوَرِقَ، وَدِیَۃُ الأَعْرَابِیِّ إِذَا أَصَابَہُ الأَعْرَابِیُّ مِئَۃٌ مِنَ الإِبِلِ ، فَإِنْ لَمْ تَجِدِ الْعَاقِلَۃُ إِبِلاً ، فَعَدْلُہَا مِنَ الشَّائِ أَلْفَیْ شَاۃٍ۔","","Musannaf Ibn Abi Shaybah 27279","","","كتاب الديات"
"27280","(۲۷۲۸۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس قَالَ : قَالَ أَبِی : یُعْطُونَ مِنْ أَیِّ صِنْفٍ کَانَ ، بِقِیمَۃِ الإِبِلِ یَوْمئِذٍ مَا کَانَتْ ، إِنِ ارْتَفَعَتْ ، وَإِنِ انْخَفَضَتْ فَقِیمَتُہَا۔","","Musannaf Ibn Abi Shaybah 27280","","","كتاب الديات"
"27281","(۲۷۲۸۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ قَالَ : قُلْتُ لِعَطَائٍ : إِنْ شَائَ الْقرَوِیُّ أَعْطَی مِئَۃَ نَاقَۃٍ ، أَوْ مِئَتَیْ بَقَرَۃٍ ، أَوْ أَلْفَیْ شَاۃٍ وَلَمْ یُعْطِ ذَہَبًا ؟ قَالَ : إِنْ شَائَ أَعْطَی إِبِلاً وَلَمْ یُعْطِ ذَہَبًا۔n قَالَ: وَقَالَ عَطَائٌ : کَانَ یُقَالُ : عَلَی أَہْلِ الإِبِلِ إِبِلٌ ، وَعَلَی أَہْلِ الْبَقَرِ بَقَرٌ ، وَعَلَی أَہْلِ الشَّائِ شَائٌ۔","Sahih","Musannaf Ibn Abi Shaybah 27281","","","كتاب الديات"
"27282","(۲۷۲۸۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ قَالَ : أَخْبَرَنَا عَبْدُ الْکَرِیمِ بْنُ أَبِی الْمُخَارِقِ ، عَنِ الْحَسَنِ ، قَالَ : إِنْ شَائَ صَاحِبُ الْبَقَرِ وَالشَّائِ أَعْطَی الإِبِلَ۔","","Musannaf Ibn Abi Shaybah 27282","","","كتاب الديات"
"27283","(۲۷۲۸۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ قَالَ : قَالَ أَبُو بَکْرٍ : مَنْ کَانَ عَقْلُہُ فِی الشَّائِ ، فَکُلُّ بَعِیرٍ بِعِشْرِینَ شَاۃً ، وَمَنْ کَانَ عَقْلُہُ الْبَقَر ، فَکُلُّ بَعِیرٍ بِبَقَرَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 27283","","","كتاب الديات"
"27284","(۲۷۲۸۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، وَأَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَن زَیْدِ بْنِ جُبَیْرٍ ، عَن خِشْفٍ ، عَنْ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ قَالَ : دِیَۃُ الْخَطَأِ أَخْمَاسًا : عِشْرُونَ حِقَّۃً ، وَعِشْرُونَ جَذَعَۃً ، وَعِشْرُونَ بَنَاتِ لَبُونٍ ، وَعِشْرُونَ بَنُو لَبُونٍ ، وَعِشْرُونَ بَنَاتِ مَخَاضٍ۔ (ترمذی ۱۳۸۶۔ دارقطنی ۱۷۵)","Hasan","Musannaf Ibn Abi Shaybah 27284","","","كتاب الديات"
"27285","(۲۷۲۸۵) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَلْقَمَۃَ بْنِ قَیْسٍ ، عَنْ عَبْدِ اللہِ أَنَّہُ قَالَ : فِی الْخَطَأِ أَخْمَاسًا : عِشْرُونَ حِقَّۃً ، وَعِشْرُونَ جَذَعَۃً ، وَعِشْرُونَ بَنَاتِ مَخَاضٍ ، وَعِشْرُونَ بَنُو مَخَاضٍ ، وَعِشْرُونَ بَنَاتِ لَبُونٍ۔","","Musannaf Ibn Abi Shaybah 27285","","","كتاب الديات"
"27286","(۲۷۲۸۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ، مِثْلُہُ۔","","Musannaf Ibn Abi Shaybah 27286","","","كتاب الديات"
"27287","(۲۷۲۸۷) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ (ح) وَعَنْ سُفْیَانَ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلِیٍّ ، قَالَ : کَانَ یَقُولُ فِی الْخَطَأِ أَرْبَاعًا : خَمْسٌ وَعِشْرُونَ حِقَّۃً ، وَخَمْسٌ وَعِشْرُونَ جَذَعَۃً ، وَخَمْسٌ وَعِشْرُونَ ابْنَۃَ لَبُونٍ ، وَخَمْسٌ وَعِشْرُونَ بَنَاتِ مَخَاضٍ۔","Hasan","Musannaf Ibn Abi Shaybah 27287","","","كتاب الديات"
"27288","(۲۷۲۸۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ، عَن عُبَیْدَۃَ، عَنْ إِبْرَاہِیمَ، عَنْ عُمَرَ، وَعَبْدِاللہِ، أَنَّہُمَا قَالاَ: دِیَۃُ الْخَطَأِ أَخْمَاسًا۔","","Musannaf Ibn Abi Shaybah 27288","","","كتاب الديات"
"27289","(۲۷۲۸۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ (ح) وَعَنْ عَبْدِ رَبِّہِ ، عَنْ أَبِی عِیَاضٍ ، عَنْ عُثْمَانَ ، وَزَیْدٍ ، قَالاَ : فِی الْخَطَأِ ثَلاَثُونَ جَذَعَۃً ، وَثَلاَثُونَ بَنَاتُ لَبُونٍ ، وَعِشْرُونَ بَنُو لَبُونٍ ، وَعِشْرُونَ بَنْتُ مَخَاضٍ۔","","Musannaf Ibn Abi Shaybah 27289","","","كتاب الديات"
"27290","(۲۷۲۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ الْحَسَنِ بْنِ صَالِحٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، عَنْ زَیْدٍ ؛ فِی دِیَۃِ الْخَطَأِ : ثَلاَثُونَ جَذَعَۃً ، وَثَلاَثُونَ حِقَّۃً ، وَعِشْرُونَ بَنُو لَبُونٍ ، وَعِشْرُونَ بَنَاتِ مَخَاضٍ۔","Da'if","Musannaf Ibn Abi Shaybah 27290","","","كتاب الديات"
"27291","(۲۷۲۹۱) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الْحَسَنِ ، قَالَ : دِیَۃُ الْخَطَأِ أَخْمَاسًا۔","","Musannaf Ibn Abi Shaybah 27291","","","كتاب الديات"
"27292","(۲۷۲۹۲) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَلْقَمَۃَ ، وَالأَسْوَدِ ، عَنْ عَبْدِ اللہِ ، قَالَ: شِبْہُ الْعَمْدِ أَرْبَاعًا: خَمْسٌ وَعِشْرُونَ حِقَّۃً، وَخَمْسٌ وَعِشْرُونَ جَذَعَۃً، وَخَمْسٌ وَعِشْرُونَ بَنَاتُ مَخَاضٍ، وَخَمْسٌ وَعِشْرُونَ بَنَاتُ لَبُونٍ۔","Sahih","Musannaf Ibn Abi Shaybah 27292","","","كتاب الديات"
"27293","(۲۷۲۹۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا ابْنُ أَبِی خَالِدٍ ، عَنْ عَامِرٍ ، قَالَ : کَانَ ابْنُ مَسْعُودٍ یَقُولُ : فِی شِبْہِ الْعَمْدِ أَرْبَاعًا : خَمْسٌ وَعِشْرُونَ جَذَعَۃً ، وَخَمْسٌ وَعِشْرُونَ حِقَّۃً ، وَخَمْسٌ وَعِشْرُونَ بَنَاتُ لَبُونٍ ، وَخَمْسٌ وَعِشْرُونَ بَنَاتُ مَخَاضٍ۔","","Musannaf Ibn Abi Shaybah 27293","","","كتاب الديات"
"27294","(۲۷۲۹۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، عَنْ عُمَرَ ؛ أَنَّہُ قَالَ : فِی شِبْہِ الْعَمْدِ ثَلاَثُونَ جَذَعَۃً ، وَثَلاَثُونَ حِقَّۃً ، وَأَرْبَعُونَ مَا بَیْنَ ثَنِیَّۃٍ إِلَی بَازِلِ عَامِہَا کُلُّہَا خَلِفَۃً۔","","Musannaf Ibn Abi Shaybah 27294","","","كتاب الديات"
"27295","(۲۷۲۹۵) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمٍ ، عَنْ عَلِیٍّ ، قَالَ : فِی شِبْہِ الْعَمْدِ ثَلاَثٌ وَثَلاَثُونَ حِقَّۃً ، وَثَلاَثٌ وَثَلاَثُونَ جَذَعَۃً ، وَأَرْبَعٌ وَثَلاَثُونَ ثَنِیَّۃً إِلَی بَازِلِ عَامِہَا کُلُّہَا خَلِفَۃً۔","Hasan","Musannaf Ibn Abi Shaybah 27295","","","كتاب الديات"
"27296","(۲۷۲۹۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ (ح) وَعَنْ عَبْدِ رَبِّہِ ، عَنْ أَبِی عِیَاضٍ ؛ أَنَّ عُثْمَانَ ، وَزَیْدَ بْنَ ثَابِتٍ ، قَالاَ : فِی الْمُغَلَّظَۃِ أَرْبَعُونَ جَذَعَۃً خَلِفَۃً ، وَثَلاَثُونَ حِقَّۃً ، وَثَلاَثُونَ بَنَاتِ لَبُونٍ۔","","Musannaf Ibn Abi Shaybah 27296","","","كتاب الديات"
"27297","(۲۷۲۹۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ أَبُو مُوسَی ، وَالْمُغِیرَۃُ بْنُ شُعْبَۃَ ،یَقُولاَنِ : فِی الْمُغَلَّظَۃِ مِنَ الدِّیَۃِ ثَلاَثُونَ حِقَّۃً ، وَثَلاَثُونَ جَذَعَۃً ، وَأَرْبَعُونَ ثَنِیَّۃً إِلَی بَازِلِ عَامِہَا کُلُّہَا خَلِفَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 27297","","","كتاب الديات"
"27298","(۲۷۲۹۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا ابْنُ أَبِی خَالِدٍ ، عَنْ عَامِرٍ ، قَالَ : کَانَ زَیْدُ بْنُ ثَابِتٍ یَقُولُ : فِی شِبْہِ الْعَمْدِ : ثَلاَثُونَ حِقَّۃً ، وَثَلاَثُونَ جَذَعَۃً ، وَأَرْبَعُونَ مَا بَیْنَ ثَنِیَّۃٍ إِلَی بَازِلِ عَامِہَا کُلُّہَا خَلِفَۃً ،n وَکَانَ عَلِیٌّ یَقُولُ : فِی شِبْہِ الْعَمْدِ : ثَلاَثٌ وَثَلاَثُونَ حِقَّۃً ، وَثَلاَثٌ وَثَلاَثُونَ جَذَعَۃً ، وَأَرْبَعٌ وَثَلاَثُونَ مَا بَیْنَ ثَنِیَّۃٍ إِلَی بَازِلِ عَامِہَا کُلُّہَا خَلِفَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 27298","","","كتاب الديات"
"27299","(۲۷۲۹۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَان[corrupt] ، عَنْ أَشْعَثَ ، عَنْ عَامِرٍ ، وَالْحَسَنِ ، وَابْنِ سِیرِینَ ، وَعَمْرِو بْنِ دِینَارٍ، قَالُوا : شِبْہُ الْعَمْدِ تُغْلِظُ عَلَیْہِمُ الدِّیَۃَ فِی أَسْنَانِ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27299","","","كتاب الديات"
"27300","(۲۷۳۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : شِبْہُ الْعَمْدِ ؛ الضَّرْبَۃُ بِالْخَشَبَۃِ ، أَوِ الْقَذْفَۃُ بِالْحَجَرِ الْعَظِیمِ ، وَالدِّیَۃُ أَثْلاَثٌ : ثُلُثٌ حِقَاقٌ ، وَثُلُثٌ جِذَاعٌ ، وَثُلُثٌ مَا بَیْنَ ثَنِیَّۃٍ إِلَی بَازِلِ عَامِہَا کُلُّہَا خَلِفَۃً۔","Hasan","Musannaf Ibn Abi Shaybah 27300","","","كتاب الديات"
"27301","(۲۷۳۰۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ عَطَائٌ : تُغَلَّظُ الدِّیَۃُ فِی شِبْہِ الْعَمْدِ ، وَلاَ یُقْتَلُ بِہِ۔","","Musannaf Ibn Abi Shaybah 27301","","","كتاب الديات"
"27302","(۲۷۳۰۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : مَا تَغْلِیظُ الإِبِلِ ؟ قَالَ : أَرْبَعُونَ خَلِفَۃً ، وَثَلاَثُونَ حِقَّۃً ، وَثَلاَثُونَ جَذَعَۃً۔","","Musannaf Ibn Abi Shaybah 27302","","","كتاب الديات"
"27303","(۲۷۳۰۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی التَّغْلِیظِ : أَرْبَعُونَ ثَنِیَّۃً إِلَی بَازِلِ عَامہَا کُلَّہَا خَلِفَۃً ، وَثَلاَثُونَ حِقَّۃً وَثَلاَثُونَ بِنْتُ مَخَاضٍ۔","","Musannaf Ibn Abi Shaybah 27303","","","كتاب الديات"
"27304","(۲۷۳۰۴) حَدَّثَنَا أبو خالد ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : إِنَّمَا التَّغْلِیظُ فِی شِبْہِ الْعَمْدِ فِی أَسْنَانِ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27304","","","كتاب الديات"
"27305","(۲۷۳۰۵) حَدَّثَنَا أَبُو الأَحْوَصِ، عَنْ أَبِی إِسْحَاقَ، عَنْ عَاصِمٍ، عَنْ عَلِیٍّ، قَالَ: شِبْہُ الْعَمْدِ بِالْحَجَرِ الْعَظِیمِ وَالْعَصَا۔","Hasan","Musannaf Ibn Abi Shaybah 27305","","","كتاب الديات"
"27306","(۲۷۳۰۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: قَتِیلُ السَّوْطِ وَالْعَصَا شِبْہُ عَمْدٍ۔ (ابوداؤد ۴۵۳۵۔ احمد ۱۶۴)","Hasan","Musannaf Ibn Abi Shaybah 27306","","","كتاب الديات"
"27307","(۲۷۳۰۷) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، وَحَکَمٍ ، وَحَمَّادٍ ، قَالُوا : مَا أُصِیبَ بِہِ مِنْ حَجَرٍ ، أَوْ سَوْطٍ ، أَوْ عَصًا فَأَتَی عَلَی النَّفْسِ ، فَہُوَ شِبْہُ الْعَمْدِ ، وَفِیہِ الدِّیَۃُ مُغَلَّظَۃٌ۔","","Musannaf Ibn Abi Shaybah 27307","","","كتاب الديات"
"27308","(۲۷۳۰۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : شِبْہُ الْعَمْدِ کُلُّ شَیْئٍ یُعْمدُ بِہِ بِغَیْرِ حَدِیدٍ ، وَلاَ یَکُونُ شِبْہُ الْعَمْدِ إِلاَّ فِی النَّفْسِ ، وَلاَ یَکُونُ دُونَ النَّفْسِ۔","","Musannaf Ibn Abi Shaybah 27308","","","كتاب الديات"
"27309","(۲۷۳۰۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : مَا کَانَ مِنْ قَتْلٍ بِغَیْرِ سِلاَحٍ ، فَہُوَ شِبْہُ الْعَمْدِ ، وَفِیہِ الدِّیَۃُ عَلَی الْعَاقِلَۃِ۔","","Musannaf Ibn Abi Shaybah 27309","","","كتاب الديات"
"27310","(۲۷۳۱۰) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ ، قَالَ : شِبْہُ الْعَمْدِ أَنْ یَضْرِبَ الرَّجُلُ الرَّجُلَ فِی الثَّاْرِ یَکُونُ بَیْنَہُمَا ، وَلاَ یُرِیدُ قَتْلَہُ ، فَیَمْرَضُ مِنْ ذَلِکَ فَیَمُوتُ۔","","Musannaf Ibn Abi Shaybah 27310","","","كتاب الديات"
"27311","(۲۷۳۱۱) حَدَّثَنَا أَبُو الأَحْوَصِ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ أَبِی عَازِبٍ ، عَنِ النُّعْمَانِ بْنِ بَشِیرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کُلُّ شَیْئٍ خَطَأٌ إِلاَّ السَّیْفَ ، وَلِکُلِّ خَطَأٍ أَرْشٌ۔n(احمد ۲۷۵۔ بزار ۳۲۴۴)","Da'if","Musannaf Ibn Abi Shaybah 27311","","","كتاب الديات"
"27312","(۲۷۳۱۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : الْخَطَأُ أَنْ تُرِیدَ الشَّیئَ ، فَتُصِیبُ غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 27312","","","كتاب الديات"
"27313","(۲۷۳۱۳) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ إِبْرَاہِیمَ، قَالَ: الْخَطَأُ أَنْ تُصِیبَ الإِنْسَانَ، وَلاَ تُرِیدُہُ، فَذَلِکَ عَلَی الْعَاقِلَۃِ۔","","Musannaf Ibn Abi Shaybah 27313","","","كتاب الديات"
"27314","(۲۷۳۱۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی حَمْزَۃَ الأَسَدِیِّ ، قَالَ : شَہِدْت شُرَیْحًا قَضَی فِی مُوضِحَۃٍ بِخَمْسِ مِئَۃِ دِرْہَمٍ۔","","Musannaf Ibn Abi Shaybah 27314","","","كتاب الديات"
"27315","(۲۷۳۱۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ حَکِیمِ بْنِ الدَّیْلَمِ ، قَالَ : أَتَیْتُ شُرَیْحًا فِی مُوضِحَۃٍ ، فَقَضَی فِیہَا بِخَمْسِ قَلاَئِصَ۔","","Musannaf Ibn Abi Shaybah 27315","","","كتاب الديات"
"27316","(۲۷۳۱۶) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنْ شَیْبَۃَ بْنِ مُسَاوِرٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی الْمُوضِحَۃِ بِخَمْسٍ مِنَ الإِبِلِ ، وَلَمْ یَقْضِ فِیمَا سِوَی ذَلِکَ۔n(عبدالرزاق ۱۷۳۱۶)","","Musannaf Ibn Abi Shaybah 27316","","","كتاب الديات"
"27317","(۲۷۳۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ مَطَرٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی الْمُوضِحَۃِ خَمْسًا خَمْسًا۔ (ابوداؤد ۴۵۵۵۔ ترمذی ۱۳۹۰)","Hasan","Musannaf Ibn Abi Shaybah 27317","","","كتاب الديات"
"27318","(۲۷۳۱۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مَکْحُولٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی الْمُوضِحَۃِ بِخَمْسٍ مِنَ الإِبِلِ ، وَلَمْ یَقْضِ فِیمَا سِوَی ذَلِکَ۔۔","","Musannaf Ibn Abi Shaybah 27318","","","كتاب الديات"
"27319","(۲۷۳۱۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مَکْحُولٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی الْمُوضِحَۃِ فَصَاعِدًا ، فَجَعَلَ فِی الْمُوضِحَۃِ خَمْسًا مِنَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27319","","","كتاب الديات"
"27320","(۲۷۳۲۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ ، وَعَبْدِ اللہِ ، قَالاَ : فِی الْمُوضِحَۃِ خَمْسٌ مِنَ الإِبِلِ۔","Da'if","Musannaf Ibn Abi Shaybah 27320","","","كتاب الديات"
"27321","(۲۷۳۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : فِی الْمُوضِحَۃِ خَمْسٌ مِنَ الإِبِلِ۔","Hasan","Musannaf Ibn Abi Shaybah 27321","","","كتاب الديات"
"27322","(۲۷۳۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ قَالَ : فِیہَا خَمْسٌ مِنَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27322","","","كتاب الديات"
"27323","(۲۷۳۲۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : فِی الْمُوضِحَۃِ خَمْسُ فَرَائِضَ۔","","Musannaf Ibn Abi Shaybah 27323","","","كتاب الديات"
"27324","(۲۷۳۲۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : فِی الْمُوضِحَۃِ خَمْسٌ مِنَ الإِبِلِ ، أَوْ عَدْلُ ذَلِکَ مِنَ الذَّہَبِ أَوِ الْوَرِقِ۔","","Musannaf Ibn Abi Shaybah 27324","","","كتاب الديات"
"27325","(۲۷۳۲۵) حَدَّثَنَا یحیی بْنُ عَبْدِ الْمَلِکِ بْنِ أَبِی غَنِیَّۃ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، قَالاَ : فِی الْمُوضِحَۃِ خَمْسٌ مِنَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27325","","","كتاب الديات"
"27326","(۲۷۳۲۶) حَدَّثَنَا أَبُو دَاوُدَ ، عَن زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ قَالَ : فِی الْمُوضِحَۃِ خَمْسٌ مِنَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27326","","","كتاب الديات"
"27327","(۲۷۳۲۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حُسَیْنُ الْمُعَلِّمُ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فِی الْمُوضِحَۃِ خَمْسٌ۔ (ابوداؤد ۴۵۵۔ ترمذی ۱۳۹۰)","Hasan","Musannaf Ibn Abi Shaybah 27327","","","كتاب الديات"
"27328","(۲۷۳۲۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَن عِکْرِمَۃَ بْنِ خَالِدٍ ، عَنْ رَجُلٍ مِنْ آلِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فِی الْمُوضِحَۃِ خَمْسٌ۔","Da'if","Musannaf Ibn Abi Shaybah 27328","","","كتاب الديات"
"27329","(۲۷۳۲۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَن خَالِدٍ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : أَنْ لاَ یُزَادَ فِی الْمُوضِحَۃِ عَلَی خَمْسِینَ دِینَارًا ، قَالَ خَالِدٌ : یُرِیدُ الْمُوضِحَۃَ فِی الْوَجْہِ۔","","Musannaf Ibn Abi Shaybah 27329","","","كتاب الديات"
"27330","(۲۷۳۳۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : فِی الْمُوضِحَۃِ خَمْسٌ مِنَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27330","","","كتاب الديات"
"27331","(۲۷۳۳۱) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ ، قَالَ : فِی الْمُوضِحَۃِ خَمْسٌ مِنَ الإِبِلِ أَرْبَاعًا : رُبْعٌ جِذَاعٌ ، وَرُبْعٌ حِقَاقٌ ، وَرُبْعٌ بَنَاتُ لَبُونٍ ، وَرُبْعٌ بَنَاتُ مَخَاضٍ۔","Da'if","Musannaf Ibn Abi Shaybah 27331","","","كتاب الديات"
"27332","(۲۷۳۳۲) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ أَشْعَثَ، عَنْ عَامِرٍ، عَنْ عَبْدِاللہِ، قَالَ: فِی الْمُوضِحَۃِ خَمْسٌ مِنَ الإِبِلِ أَخْمَاسًا۔","Da'if","Musannaf Ibn Abi Shaybah 27332","","","كتاب الديات"
"27333","(۲۷۳۳۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَن مَسْرُوقٍ ، وَشُرَیْحٍ ؛ أَنَّہُمَا قَالاَ : فِی الْمُوضِحَۃِ خَمْسٌ مِنَ الإِبِلِ : حِقَّۃٌ ، وَجَذَعَۃٌ ، وَبِنْتُ مَخَاضٍ ، وَبِنْتُ لَبُونٍ ، وَابْنُ لَبُونٍ۔","","Musannaf Ibn Abi Shaybah 27333","","","كتاب الديات"
"27334","(۲۷۳۳۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ؛ فِی السِّنِّ وَالْمُوضِحَۃِ خَمْسٌ مِنَ الإِبِلِ : ابْنَا مَخَاضٍ ؛ أُنْثَی وَذَکَرٍ ، وَابْنَۃُ لَبُونٍ ، وَجَذَعَۃٌ ، وَحِقَّۃٌ۔","","Musannaf Ibn Abi Shaybah 27334","","","كتاب الديات"
"27335","(۲۷۳۳۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی دِیَۃِ الْمُوضِحَۃِ : بِنْتُ مَخَاضٍ ، وَابْنُ لَبُونٍ ، وَابْنَۃُ لَبُونٍ ، وَحِقَّۃٌ ، وَجَذَعَۃٌ۔","","Musannaf Ibn Abi Shaybah 27335","","","كتاب الديات"
"27336","(۲۷۳۳۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مَکْحُولٍ (ح) وَعَنْ أَشْعَثَ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی الآمَّۃِ ثُلُثَ الدِّیَۃِ۔ (ابوداؤد ۲۵۷۔ نسائی ۷۰۶۰)","","Musannaf Ibn Abi Shaybah 27336","","","كتاب الديات"
"27337","(۲۷۳۳۷) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمٍ ، عَنْ عَلِیٍّ قَالَ : فِی الآمَّۃِ ثُلُثُ الدِّیَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 27337","","","كتاب الديات"
"27338","(۲۷۳۳۸) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ، عَنْ أَشْعَثَ، عَنِ الشَّعْبِیِّ، عَنْ عَبْدِ اللہِ ، قَالَ: فِی الآمَّۃِ ثُلُثُ الدِّیَۃِ أَخْمَاسًا۔","Da'if","Musannaf Ibn Abi Shaybah 27338","","","كتاب الديات"
"27339","(۲۷۳۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، قَالَ : فِی الآمَّۃِ ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27339","","","كتاب الديات"
"27340","(۲۷۳۴۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : فِی الآمَّۃِ ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27340","","","كتاب الديات"
"27341","(۲۷۳۴۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عمرو ، عن عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : فِی الآمَّۃِ ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27341","","","كتاب الديات"
"27342","(۲۷۳۴۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَن جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : فِی الآمَّۃِ ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27342","","","كتاب الديات"
"27343","(۲۷۳۴۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی الْمَأْمُومَۃِ الثُّلُثُ۔","","Musannaf Ibn Abi Shaybah 27343","","","كتاب الديات"
"27344","(۲۷۳۴۴) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ؛ أَنَّ شُرَیْحًا قَضَی فِی الآمَّۃِ بِأَرْبَعَۃِ آلاَفٍ۔","","Musannaf Ibn Abi Shaybah 27344","","","كتاب الديات"
"27345","(۲۷۳۴۵) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ عَنْ عَاصِمٍ ، عَنْ عَلِیٍّ ، قَالَ : فِی الْمُنَقِّلَۃُ خَمْسَ عَشْرَۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 27345","","","كتاب الديات"
"27346","(۲۷۳۴۶) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَن عِکْرِمَۃَ بْنِ خَالِدٍ ، عَنْ رَجُلٍ مِنْ آلِ عُمَرَ ، رَفَعَہُ ، قَالَ : فِی الْمُنَقِّلَۃِ خَمْسَ عَشْرَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 27346","","","كتاب الديات"
"27347","(۲۷۳۴۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عمرو ، عن عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : فِی الْمُنَقِّلَۃِ خَمْسَ عَشْرَۃَ مِنَ الإِبِلِ ، أَوْ عَدْلُ ذَلِکَ مِنَ الذَّہَبِ ، أَوِ الْوَرِقِ۔","","Musannaf Ibn Abi Shaybah 27347","","","كتاب الديات"
"27348","(۲۷۳۴۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالَ : فِی الْمُنَقِّلَۃِ خَمْسَ عَشْرَۃَ۔","","Musannaf Ibn Abi Shaybah 27348","","","كتاب الديات"
"27349","(۲۷۳۴۹) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : فِی الْمُنَقِّلَۃِ خَمْسَ عَشْرَۃَ۔","","Musannaf Ibn Abi Shaybah 27349","","","كتاب الديات"
"27350","(۲۷۳۵۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : فِیہَا خَمْسَ عَشْرَۃَ۔","","Musannaf Ibn Abi Shaybah 27350","","","كتاب الديات"
"27351","(۲۷۳۵۱) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ قَالَ : فِی الْمُنَقِّلَۃِ خَمْسَ عَشْرَۃَ أَخْمَاسًا۔","Da'if","Musannaf Ibn Abi Shaybah 27351","","","كتاب الديات"
"27352","(۲۷۳۵۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنْ عَامِرٍ ، عَنْ عَلِیٍّ ، قَالَ : فِی الْمُنَقِّلَۃِ خَمْسَ عَشْرَۃَ مِنَ الإِبِلِ أَرْبَاعًا : رُبْعٌ جِذَاعٌ ، وَرُبْعٌ حِقَاقٌ ، وَرُبْعٌ بَنَاتُ لَبُونٍ ، وَرُبْعٌ بَنَاتُ مَخَاضٍ۔","Da'if","Musannaf Ibn Abi Shaybah 27352","","","كتاب الديات"
"27353","(۲۷۳۵۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مَکْحُولٍ ، قَالَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْمُنَقِّلَۃِ خَمْسَ عَشْرَۃَ۔","","Musannaf Ibn Abi Shaybah 27353","","","كتاب الديات"
"27354","(۲۷۳۵۴) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنِ الْحَکَمِ ، قَالَ : کَانَ عَلِیٌّ یَجْعَلُ فِی الَّتِی لَمْ تُوضِحْ وَقَدْ کَادَتْ أَرْبَعًا مِنَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27354","","","كتاب الديات"
"27355","(۲۷۳۵۵) حَدَّثَنَا وَکِیعٌ ، عن سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ ، عَنْ عَلِیِّ ؛ فی السِّمْحاق : أَرْبَعٌ مِنَ الإِبِلِ ، وَذُکِرَ عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ، مِثْلُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 27355","","","كتاب الديات"
"27356","(۲۷۳۵۶) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ سُفْیَانَ ، عَن مَالِکِ بْنِ أَنَسٍ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ قُسَیْطٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، أَنَّ عُمَرَ ، وَعُثْمَانَ قَضَیَا فِی الْمِلْطَاۃِ ، وَہِیَ السِّمْحَاقُ نِصْفَ دِیَۃِ الْمُوضِحَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 27356","","","كتاب الديات"
"27357","(۲۷۳۵۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : مَا دُونَ الْمُوضِحَۃِ فَفِیہِ الصُّلْحُ۔","","Musannaf Ibn Abi Shaybah 27357","","","كتاب الديات"
"27358","(۲۷۳۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَن فِرَاسٍ ، عَنْ عَامِرٍ ، قَالَ : قَالَ : مَا دُونَ الْمُوضِحَۃِ أَجْرُ الطَّبِیبِ۔","","Musannaf Ibn Abi Shaybah 27358","","","كتاب الديات"
"27359","(۲۷۳۵۹) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : لَیْسَ فِیمَا دُونَ الْمُوضِحَۃِ عَقْلٌ إِلاَّ أَجْرَ الطَّبِیبِ۔","","Musannaf Ibn Abi Shaybah 27359","","","كتاب الديات"
"27360","(۲۷۳۶۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : فِیمَا دُونَ الْمُوضِحَۃِ حُکْمٌ۔","","Musannaf Ibn Abi Shaybah 27360","","","كتاب الديات"
"27361","(۲۷۳۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَن مَسْرُوقٍ ، قَالَ : لَیْسَ فِیمَا دُونَ الْمُوضِحَۃِ إِلاَّ أَجْرَ الطَّبِیبِ۔","","Musannaf Ibn Abi Shaybah 27361","","","كتاب الديات"
"27362","(۲۷۳۶۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الأَعْمَشِ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ عَنِ الْخَدْشِ ، أَوِ الشَّیئِ ؟ قَالَ : صُلْحٌ ، مَا لَمْ یَبْلُغْ فَرِیضَۃً۔","","Musannaf Ibn Abi Shaybah 27362","","","كتاب الديات"
"27363","(۲۷۳۶۳) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، قَالَ : کَانَ الْحَسَنُ لاَ یُوَقِّتُ فِیمَا دُونَ الْمُوضِحَۃِ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 27363","","","كتاب الديات"
"27364","(۲۷۳۶۴) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنِ ابْنِ عُلاَثَۃَ ، عَنْ إِبْرَاہِیمَ بْنِ أَبِی عَبْلَۃَ ؛ أَنَّ مُعَاذًا ، وَعُمَرَ جَعَلاَ فِیما دون الْمُوضِحَۃِ أَجْرَ الطَّبِیبِ۔","","Musannaf Ibn Abi Shaybah 27364","","","كتاب الديات"
"27365","(۲۷۳۶۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عُمَرَ بْنِ عَامِرٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ؛ أَنَّ أَبَا بَکْرٍ ، وَعُمَرَ ، قَالاَ : الْمُوضِحَۃُ فِی الْوَجْہِ وَالرَّأْسِ سَوَائٌ۔","Hasan","Musannaf Ibn Abi Shaybah 27365","","","كتاب الديات"
"27366","(۲۷۳۶۶) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ : أَنَّ الْمُوضِحَۃَ فِی الْوَجْہِ وَالرَّأْسِ سَوَائٌ ، فِیہَا خَمْسٌ مِنَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27366","","","كتاب الديات"
"27367","(۲۷۳۶۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَن سُلَیْمَانَ بْنِ یَسَارٍ، قَالَ: الْمُوضِحَۃُ فِی الْوَجْہِ کَالْمُوضِحَۃِ فِی الرَّأْسِ، إِلاَّ أَنْ یَکُونَ فِی الْوَجْہِ شَیْنٌ، فَعَلَی قَدْرِ ذَلِکَ إِلَی أَنْ یَبْلُغَ نِصْفَ عَقْلِ الْمُوضِحَۃِ۔","","Musannaf Ibn Abi Shaybah 27367","","","كتاب الديات"
"27368","(۲۷۳۶۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : الْمُوضِحَۃُ فِی الْوَجْہِ وَالرَّأْسِ۔","","Musannaf Ibn Abi Shaybah 27368","","","كتاب الديات"
"27369","(۲۷۳۶۹) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : الْمُوضِحَۃُ فِی الْوَجْہِ وَالرَّأْسِ سَوَائٌ ، إِلاَّ أَنْ یَکُونَ فِی الْوَجْہِ شَیْنٌ ، فَیَزِیدُ عَلَی قَدْرِ الشَّیْنِ۔","","Musannaf Ibn Abi Shaybah 27369","","","كتاب الديات"
"27370","(۲۷۳۷۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنْ حَجَّاجٍ، عَنْ مَکْحُولٍ، عَنْ زَیْدٍ، قَالَ: الْمُوضِحَۃُ فِی الْوَجْہِ وَالرَّأْسِ وَالأَنْفِ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 27370","","","كتاب الديات"
"27371","(۲۷۳۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : الْمُوضِحَۃُ فِی الرَّأْسِ وَالْوَجْہِ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 27371","","","كتاب الديات"
"27372","(۲۷۳۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : الْمُوضِحَۃُ فِی الْوَجْہِ مِثْلُ الْمُوضِحَۃِ فِی الرَّأْسِ۔","","Musannaf Ibn Abi Shaybah 27372","","","كتاب الديات"
"27373","(۲۷۳۷۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ شُرَیْحٍ ، وَالْحَسَنِ ، قَالاَ : الْمُوضِحَۃُ فِی الْوَجْہِ مِثْلُ الْمُوضِحَۃِ فِی الرَّأْسِ۔","","Musannaf Ibn Abi Shaybah 27373","","","كتاب الديات"
"27374","(۲۷۳۷۴) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَن حُمْرَانَ ، عَنْ إِیَاسِ بْنِ مُعَاوِیَۃَ ، قَالَ : الْمُوضِحَۃُ ہوْنا وہوْنا سَوَائٌ ، وَأَشَارَ مُعْتَمِرٌ بِیَدِہِ إِلَی رَأْسِہِ وَوَجْہِہِ۔","","Musannaf Ibn Abi Shaybah 27374","","","كتاب الديات"
"27375","(۲۷۳۷۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ؛ أَنَّ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : خَمْسٌ خَمْسٌ۔","","Musannaf Ibn Abi Shaybah 27375","","","كتاب الديات"
"27376","(۲۷۳۷۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، قَالَ: الْمُوضِحَۃُ فِی الرَّأْسِ خَمْسٌ، وَفِی الْوَجْہِ عَشْرٌ۔","","Musannaf Ibn Abi Shaybah 27376","","","كتاب الديات"
"27377","(۲۷۳۷۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَن دَاوُد ، عَنْ عَامِرٍ ، قَالَ : الْمُوضِحَۃُ فِی الْوَجْہِ لَہَا دِیَتَانِ۔","","Musannaf Ibn Abi Shaybah 27377","","","كتاب الديات"
"27378","(۲۷۳۷۸) حَدَّثَنَا أَبُو الأَحْوَصِ، عَنْ أَبِی إِسْحَاقَ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ، عَنْ عَلِیٍّ، قَالَ: فِی الأُذُنِ نِصْفُ الدِّیَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 27378","","","كتاب الديات"
"27379","(۲۷۳۷۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَنْ زَیْدٍ ، قَالَ : إِذَا اصْطَلَمَتِ الأُذُنُ فَفِیہَا دِیَتُہَا۔","","Musannaf Ibn Abi Shaybah 27379","","","كتاب الديات"
"27380","(۲۷۳۸۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : قَالَ أَبُو بَکْرٍ : فِی الأُذُنِ خَمْسَ عَشَرَۃَ مِنْ أَجْلِ أَنَّہُ لیس یَضُرُّ سَمْعُہَا ، وَیُغَشِّیہَا الشَّعْرُ وَالْعِمَامَۃُ۔","","Musannaf Ibn Abi Shaybah 27380","","","كتاب الديات"
"27381","(۲۷۳۸۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنَی ابْنُ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ؛ أَنَّہُ کَانَ یَقُولُ : فِی الأُذُنِ إِذَا اسْتُؤْصِلَتْ خَمْسُونَ مِنَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27381","","","كتاب الديات"
"27382","(۲۷۳۸۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ، قَالَ: فِی الأُذُنِ إِذَا اسْتُؤْصِلَتْ خَمْسُونَ مِنَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27382","","","كتاب الديات"
"27383","(۲۷۳۸۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عَبْدُ الْعَزِیزِ بْنُ عُمَرَ ، أَنَّ فِی کِتَابٍ لِعُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ ، قَالَ : فِی الأُذُنِ نِصْفُ الدِّیَۃِ ، أَوْ عَدْلُ ذَلِکَ مِنَ الذَّہَبِ۔","","Musannaf Ibn Abi Shaybah 27383","","","كتاب الديات"
"27384","(۲۷۳۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی بَکْرٍ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ قَالَ : فِی الأُذُنِ نِصْفُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27384","","","كتاب الديات"
"27385","(۲۷۳۸۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ ، قَالَ : فِی الأُذُنِ إِذَا اسْتُؤْصِلَتْ نِصْفُ الدِّیَۃِ أَخْمَاسًا ، فَمَا نَقَصَ مِنْہَا فَبِحِسَابٍ۔","Da'if","Musannaf Ibn Abi Shaybah 27385","","","كتاب الديات"
"27386","(۲۷۳۸۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَن عِکْرِمَۃَ بْنِ خَالِدٍ ، عَنْ رَجُلٍ مِنْ آلِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فِی الأَنْفِ إِذَا اسْتُؤْصِلَ مَارِنُہُ الدِّیَۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 27386","","","كتاب الديات"
"27387","(۲۷۳۸۷) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : فِی الأَنْفِ الدِّیَۃُ۔","Hasan","Musannaf Ibn Abi Shaybah 27387","","","كتاب الديات"
"27388","(۲۷۳۸۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ أَشْعَثَ، عَنْ عَلِیٍّ ، قَالَ: فِی الأَنْفِ الدِّیَۃُ، وَمَا قُطِعَ مِنَ الأَنْفِ فَبِحِسَابٍ۔","Da'if","Musannaf Ibn Abi Shaybah 27388","","","كتاب الديات"
"27389","(۲۷۳۸۹) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عُمَارَۃَ ، عَنْ أَبِی بَکْرٍ بْنِ عَمْرِو بْنِ حَزْمٍ ، قَالَ : کَانَ فِی کِتَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِعَمْرِو بْنِ حَزْمٍ : فِی الأَنْفِ إِذَا اسْتُوْعِبَ مَارِنُہُ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27389","","","كتاب الديات"
"27390","(۲۷۳۹۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : فِی الأَنْفِ الدِّیَۃُ ، وَمَا نَقَصَ مِنَ الأَنْفِ فَبِحِسَابِہِ۔","","Musannaf Ibn Abi Shaybah 27390","","","كتاب الديات"
"27391","(۲۷۳۹۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : الأَنْفُ وَالأُذُنُ بِمَنْزِلَۃِ السِّنِّ ، مَا نَقَصَ مِنْہُ فَبِحِسَابٍ۔","","Musannaf Ibn Abi Shaybah 27391","","","كتاب الديات"
"27392","(۲۷۳۹۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ ؛ فِی الأَنْفِ إِذَا أُوْعِبَ جَدْعُہُ ، أَوْ قُطِعَ الْمَارِنُ ، الدِّیَۃُ أَخْمَاسًا ، فَمَا نَقَصَ مِنْہُ فَبِالْحِسَابِ۔","Da'if","Musannaf Ibn Abi Shaybah 27392","","","كتاب الديات"
"27393","(۲۷۳۹۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ، قَالَ: فِی الرَّوْثَۃِ ثُلُثُ الدِّیَۃِ، فَإِذَا بَلَغَ الْمَارِنُ الْعَظْمَ فَالدِّیَۃُ وَافِیَۃٌ ، فَإِنْ أُصِیبَ مِنَ الرَّوْثَۃِ الأَرْنَبَۃُ ، أَوْ غَیْرُہَا مَا لَمْ یَبْلُغَ الْعَظْمَ فَبِحِسَابِ الرَّوْثَۃِ۔","","Musannaf Ibn Abi Shaybah 27393","","","كتاب الديات"
"27394","(۲۷۳۹۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ سُلَیْمَانُ بْنُ مُوسَی : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ إِلَی أُمَرَائِ الأَجْنَادِ : فِی الأَنْفِ إِذَا أُوْعِبَ جَدْعُہُ الدِّیَۃُ کَامِلَۃٌ ، فَمَا أُصِیبَ مِنَ الأَنْفِ فَبِحِسَابٍِ۔","","Musannaf Ibn Abi Shaybah 27394","","","كتاب الديات"
"27395","(۲۷۳۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : فِی الْعِرْنِینِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27395","","","كتاب الديات"
"27396","(۲۷۳۹۶) حَدَّثَنَا وَکِیعٌ ، عَن سَلاَّمٍ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : فِی الْمَارِنِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27396","","","كتاب الديات"
"27397","(۲۷۳۹۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن عُبَیْدَۃَ ، عَنْ إِبْرَاہِیمَ ، عَنْ عُمَرَ ، قَالَ : فِی الأَنْفِ الدِّیَۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 27397","","","كتاب الديات"
"27398","(۲۷۳۹۸) حَدَّثَنَا یَزِیدُ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَن زَیْدِ بْنِ أَسْلَمَ ، قَالَ : فِی الأَرْنَبَۃِ ثُلُثُ دِیَۃِ الأَنْفِ ، وَفِی الْوَتَرَۃِ ثُلُثُ دِیَۃِ الأَنْفِ۔","","Musannaf Ibn Abi Shaybah 27398","","","كتاب الديات"
"27399","(۲۷۳۹۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، وَعُمَرَ بْنِ عَامِرٍ ، عَنْ مَکْحُولٍ ، عَن زَیْدِ بْنِ ثَابِتٍ ، قَالَ : فِی الْخَرَمَاتِ الثَّلاَثِ فِی الأَنْفِ الدِّیَۃُ ، وَفِی کُلِّ وَاحِدَۃٍ ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27399","","","كتاب الديات"
"27400","(۲۷۴۰۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، قَالَ : فِی الرَّوْثَۃِ ثُلُثُ الدِّیَۃِ ، وَإِنْ أُصِیبَ مِنَ الرَّوْثَۃِ الأَرْنَبَۃُ ، أَوْ غَیْرُہَا مَا لَمْ یَبْلُغِ الْعَظْمَ فَبِحِسَابٍ۔","","Musannaf Ibn Abi Shaybah 27400","","","كتاب الديات"
"27401","(۲۷۴۰۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : فِی الأَنْفِ جَائِفَۃٌ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 27401","","","كتاب الديات"
"27402","(۲۷۴۰۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ؛ أَنَّہُ کَانَ یَقُولُ فِی جَائِفَۃِ الأَنْفِ ثُلُثُ الدِّیَۃِ ، فَإِنْ أَنْفَذَ فَالثُّلُثَانِ۔","","Musannaf Ibn Abi Shaybah 27402","","","كتاب الديات"
"27403","(۲۷۴۰۳) حَدَّثَنَا شَرِیکٌ ، عَنْ سَعِیدِ بْنِ مَسْرُوقٍ ، عَنِ الشَّعْبِیِّ ؛ سُئِلَ عَنْ رَجُلٍ کَسَرَ أَنْفَ رَجُلٍ ، فَبَرِئَ عَلَی عَثَمٍ ؟ قَالَ : فِیہِ حُکْمٌ۔","","Musannaf Ibn Abi Shaybah 27403","","","كتاب الديات"
"27404","(۲۷۴۰۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عُثْمَانُ بْنُ أَبِی سُلَیْمَانَ ؛ أَنَّ مَمْلُوکًا لِجُبَیْرِ بْنِ أَبِی سُلَیْمَانَ کَسَرَ إِحْدَی قَصَبَتَیْ أَنْفِ مَوْلًی لِعَطَائِ بْنِ بُخْتٍ ، وَإِنَّ ابْنَ سُرَاقَۃَ سَأَلَ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ عَن ذَلِکَ ؟ فَقَالَ عُمَرُ : وَجَدْنَا فِی کِتَابٍ لِعُمَرَ بْنِ الْخَطَّابِ : أَیُّمَا عَظْمٍ کُسِرَ ، ثُمَّ جُبِرَ کَمَا کَانَ فَفِیہِ حِقَّتَانِ ، فَرَاجَعَ ابْنُ سُرَاقَۃَ عُمَرَ ، فَقَالَ : إِنَّمَا کُسِرَتْ إِحْدَی الْقَصَبَتَیْنِ ، فَأَبَی عُمَرُ إِلاَّ أَنْ یَجْعَلَ فِیہَا الْحِقَّتَیْنِ وَافِیَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 27404","","","كتاب الديات"
"27405","(۲۷۴۰۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عُمَارَۃَ ، عَنْ أَبِی بَکْرِ بْنِ عَمْرِو بْنِ حَزْمٍ ، قَالَ : فِی کِتَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِعَمْرِو بْنِ حَزْمٍ : وَفِی الْعَیْنِ خَمْسُونَ۔","","Musannaf Ibn Abi Shaybah 27405","","","كتاب الديات"
"27406","(۲۷۴۰۶) حَدَّثَنَا أَبُو الأَحْوَصِ، عَنْ أَبِی إِسْحَاقَ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ: فِی الْعَیْنِ نِصْفُ الدِّیَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 27406","","","كتاب الديات"
"27407","(۲۷۴۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَن عِکْرِمَۃَ بْنِ خَالِدٍ ، عَنْ رَجُلٍ مِنْ آلِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فِی الْعَیْنِ خَمْسُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 27407","","","كتاب الديات"
"27408","(۲۷۴۰۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ عَطَائٌ : الْعَیْنُ خَمْسُونَ۔","","Musannaf Ibn Abi Shaybah 27408","","","كتاب الديات"
"27409","(۲۷۴۰۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ، عَنْ أَشْعَثَ، عَنِ الشَّعْبِیِّ، عَنْ عَبْدِاللہِ، قَالَ: فِی الْعَیْنِ نِصْفُ الدِّیَۃِ، أَخْمَاسًا۔","Da'if","Musannaf Ibn Abi Shaybah 27409","","","كتاب الديات"
"27410","(۲۷۴۱۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : فِی الْعَیْنِ نِصْفُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27410","","","كتاب الديات"
"27411","(۲۷۴۱۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی الْحَاجِبَیْنِ إِذَا اجْتِیحَا الدِّیَۃُ ، وَفِی أَحَدِہِمَا نِصْفُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27411","","","كتاب الديات"
"27412","(۲۷۴۱۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، وَابْنُ إِدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : فِی الْحَاجِبَیْنِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27412","","","كتاب الديات"
"27413","(۲۷۴۱۳) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : فِی الْحَاجِبَیْنِ الدِّیَۃُ ، وَفِی أَحَدِہِمَا نِصْفُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27413","","","كتاب الديات"
"27414","(۲۷۴۱۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، قَالَ : قضَی أَبُو بَکْرٍ فِی الْحَاجِبِ إِذَا أُصِیبَ حَتَّی یَذْہَبَ شَعْرُہُ بِمُوضِحَتَیْنِ ؛ عَشْرٌ مِنَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27414","","","كتاب الديات"
"27415","(۲۷۴۱۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَن زَیْدِ بْنِ ثَابِتٍ ، قَالَ : فِی الْحَاجِبَیْنِ ثُلُثَا الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27415","","","كتاب الديات"
"27416","(۲۷۴۱۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الْحَجَّاجِ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : فِی کُلِّ اثْنَیْنِ مِنَ الرَّجُلِ وَالْمَرْأَۃِ الدِّیَۃُ ؛ الْیَدَیْنِ وَالْحَاجِبَیْنِ ، وَقَالَ الشَّعْبِیُّ : فِی کُلِّ شَیْئٍ مِنَ الإِنْسَانِ اثْنَیْنِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27416","","","كتاب الديات"
"27417","(۲۷۴۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عَبْدُ الْکَرِیمِ بْنُ أَبِی الْمُخَارِقِ ؛ أَنَّہُ بَلَغَہُ عَنْ بَعْضِ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّ فِی الْحَاجِبِ یَتَحَصْحَصُ شَعْرُہُ ؛ أَنَّ فِیہِ کُلَّہُ الرُّبْعُ ، وَفِیمَا ذَہَبَ مِنْہُ فَبِحِسَابٍ۔","Da'if","Musannaf Ibn Abi Shaybah 27417","","","كتاب الديات"
"27418","(۲۷۴۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ : مَا کَانَ مِنَ اثْنَیْنِ مِنَ الإِنْسَان الدِّیَۃُ ، وَفِی کُلِّ وَاحِدٍ مِنْہُمَا نِصْفُ الدِّیَۃِ ، وَمَا کَانَ مِنْ وَاحِدٍ فَفِیہِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27418","","","كتاب الديات"
"27419","(۲۷۴۱۹) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا الْمِنْہَالُ بْنُ خَلِیفَۃَ الْعِجْلِیُّ، عَن سَلَمَۃَ بْنِ تَمَّامٍ الشَّقَرِیِّ، قَالَ: مَرَّ رَجُلٌ بِقِدْرٍ، فَوَقَعَتْ عَلَی رَأْسِ رَجُلٍ فَأَحْرَقَتْ شَعْرَہُ ، فَرُفِعَ إِلَی عَلِیٍّ فَأَجَّلَہُ سَنَۃً ، فَلَمْ یَنْبُتْ ، فَقَضَی فِیہِ عَلِیٌّ بِالدِّیَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 27419","","","كتاب الديات"
"27420","(۲۷۴۲۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَن زَیْدِ بْنِ ثَابِتٍ ؛ فِی الشَّعْرِ إِذَا لَمْ یَنْبُتْ فَالدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27420","","","كتاب الديات"
"27421","(۲۷۴۲۱) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَن صَاعِدِ بْنِ مُسْلِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : فِیہِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27421","","","كتاب الديات"
"27422","(۲۷۴۲۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ، عَنِ ابْنِ جُرَیْجٍ، قَالَ: قُلْتُ لِعَطَائٍ: حَلْقُ الرَّأْسِ لَہُ نَذْرٌ؟ یَعْنِی أَرْشًا، قَالَ: لَمْ أَعْلَمْ۔","","Musannaf Ibn Abi Shaybah 27422","","","كتاب الديات"
"27423","(۲۷۴۲۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَنْ زَیْدٍ ، قَالَ : فِی الشَّفْرِ الأَعْلَی نِصْفُ الدِّیَۃِ، وَفِی الشَّفْرِ الأَسْفَلِ ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27423","","","كتاب الديات"
"27424","(۲۷۴۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن بَیَانٍ أَبِی بِشْرٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانُوا لاَ یُوقِّتُونَ فِی الأَشْفَارِ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 27424","","","كتاب الديات"
"27425","(۲۷۴۲۵) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، قَالَ: فِی الأَشْفَارِ الدِّیَۃُ ، وَفِی کُلِّ وَاحِدٍ مِنْہُمَا رُبْعُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27425","","","كتاب الديات"
"27426","(۲۷۴۲۶) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَن صَاعِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : فِی کُلِّ شَفْرٍ رُبْعُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27426","","","كتاب الديات"
"27427","(۲۷۴۲۷) حَدَّثَنَا شَبَابَۃُ، عَنْ شُعْبَۃَ، عَنْ عَبْدِ اللہِ بْنِ شُبْرُمَۃَ، قَالَ: کَانَ إِبْرَاہِیمُ یَقُولُ: فِی الأَشْفَارِ حُکْمُ ذَوِی عَدْلٍ۔","","Musannaf Ibn Abi Shaybah 27427","","","كتاب الديات"
"27428","(۲۷۴۲۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ، عَنِ ابْنِ جُرَیْجٍ، قَالَ: أَخْبَرَنِی عَبْدُ الْعَزِیزِ بْنُ عُمَرَ؛ أَنَّ عُمَرَ بْنَ عَبْدِالْعَزِیزِ کَتَبَ إِلَی أُمَرَائِ الأَجْنَادِ فِی شَفْرِ الْعَیْنِ الأَعْلَی : إِذَا نُتِفَ نِصْفُ الدِّیَۃِ ، وَفِی الشَّفْرِ الأَسْفَلِ ثُلُثُ دِیَۃِ الْعَیْنِ۔","","Musannaf Ibn Abi Shaybah 27428","","","كتاب الديات"
"27429","(۲۷۴۲۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن دَاوُد ، عَنِ الشَّعْبِیِّ ، قَالَ : فِی الْجَفْنِ الأَسْفَلِ الثُّلُثَانِ ، وَفِی الأَعْلَی الثُّلُثُ۔","","Musannaf Ibn Abi Shaybah 27429","","","كتاب الديات"
"27430","(۲۷۴۳۰) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : فِی الأَجْفَانِ ، فِی کُلِّ جَفْنٍ رُبْعُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27430","","","كتاب الديات"
"27431","(۲۷۴۳۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مَکْحُولٍ ، قَالَ : کَانُوا یَجْعَلُونَ فِی جَفْنَیِ الْعَیْنِ إِذَا نَدَرَا عَنِ الْعَیْنِ الدِّیَۃُ ، وَذَلِکَ أَنَّہُ لاَ بَقَائَ لِلْعَیْنِ بَعْدَہُمَا ، فَإِنْ تَفَرَّقَا جَعَلُوا فِی الأَسْفَلِ الثُّلُثُ ، وَفِی الأَعْلَی الثُّلُثَیْنِ ، وَذَلِکَ أَنَّہُ أَجْزَأُ عَنِ الْعَیْنِ مِنَ الأَسْفَلِ ، یَسْترُ وَیَکُفُّ عَنْہَا۔","","Musannaf Ibn Abi Shaybah 27431","","","كتاب الديات"
"27432","(۲۷۴۳۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُمَرَ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ إِلَی أُمَرَائِ الأَجْنَادِ : أَنْ یَکْتُبُوا إِلَیْہِ بِعِلْمِ عُلَمَائِہِمْ ، فَکَانَ مِمَّا اجْتَمَعَ عَلَیْہِ أُمَرَائُ الأَجْنَادِ : وَإِنْ مُرِطَ الشَّارِبُ فَفِیہِ سِتُّونَ دِینَارًا ، وَإِنْ مُرِطَا جَمِیعًا فَفِیہِمَا مِئَۃٌ وَعِشْرُونَ دِینَارًا۔","","Musannaf Ibn Abi Shaybah 27432","","","كتاب الديات"
"27433","(۲۷۴۳۳) حَدَّثَنَا ابْنُ نُمَیْرٍ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ، عَنْ مَکْحُولٍ، قَالَ: کَانُوا یَجْعَلُونَ فِی الْفَمِ إِذَا انْشَقَّ الدِّیَۃَ۔","","Musannaf Ibn Abi Shaybah 27433","","","كتاب الديات"
"27434","(۲۷۴۳۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَن زَیْدِ بْنِ ثَابِتٍ ، قَالَ : إِذَا ضُرِبَ الرَّجُلُ حَتَّی یَذْہَبَ سَمْعُہُ فَفِیہِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27434","","","كتاب الديات"
"27435","(۲۷۴۳۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ ضُرِبَ ، فَذَہَبَ سَمْعُہُ وَبَصَرُہُ وَکَلاَمُہُ ، قَالَ لَہُ : ثَلاَثُ دِیَاتٍ۔","","Musannaf Ibn Abi Shaybah 27435","","","كتاب الديات"
"27436","(۲۷۴۳۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ عَوْفٍ ، قَالَ : سَمِعْتُ شَیْخًا قَبْلَ فِتْنَۃِ ابْنِ الأَشْعَثِ ، فَنَعَتَ نَعْتَہُ ، قَالُوا : ذَاکَ أَبُو الْمُہَلَّبِ عَمُّ أَبِی قِلاَبَۃَ ، قَالَ : رُمِیَ رَجُل بِحَجَرٍ فِی رَأْسِہِ ، فَذَہَبَ سَمْعُہُ وَلِسَانُہُ وَعَقْلُہُ وَذَکَرُہُ ، فَلَمْ یَقْرَبِ النِّسَائَ ، فَقَضَی فِیہِ عُمَرُ بِأَرْبَعِ دِیَاتٍ۔","Da'if","Musannaf Ibn Abi Shaybah 27436","","","كتاب الديات"
"27437","(۲۷۴۳۷) حَدَّثَنَا عُمَرُ بْنُ یُونُسَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : فِی السَّمْعِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27437","","","كتاب الديات"
"27438","(۲۷۴۳۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی ابْنُ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، قَالَ : فِی ذَہَابِ السَّمْعِ خَمْسُونَ۔","","Musannaf Ibn Abi Shaybah 27438","","","كتاب الديات"
"27439","(۲۷۴۳۹) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ: سَأَلْتُ عَطَائً عَنْ رَجُلٍ أُصِیبَ مِنْ أَطْرَافِہِ ، مَا قَدْرُہُ أَکْثَرُ مِنْ دِیَتِہِ ؟ فَقَالَ : مَا سَمِعْتُ فِیہِ بِشَیْئٍ ، وَإِنِّی لأَظُنُّہُ سَیُعْطَی بِکُلِّ مَا أُصِیبَ مِنْہُ ، وَإِنْ کَانَ أَکْثَرَ مِنْ دِیَتِہِ۔","","Musannaf Ibn Abi Shaybah 27439","","","كتاب الديات"
"27440","(۲۷۴۴۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ ابْنُ شِہَابٍ فِی رَجُلٍ فَقَأَ عَیْنَ صَاحِبِہِ ، وَقَطَعَ أَنْفَہُ وَأُذُنَہُ ، قَالَ : یُحْسَبُ ذَلِکَ کُلُّہُ۔","","Musannaf Ibn Abi Shaybah 27440","","","كتاب الديات"
"27441","(۲۷۴۴۱) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ؛ أَنَّ الْحَسَنَ سُئِلَ عَنْ رَجُلٍ رُمِیَ بِحَجَرٍ ، أَوْ ضُرِبَ عَلَی رَأْسِہِ ، فَذَہَبَ سَمْعُہُ وَبَصَرُہُ ، وَانْقَطَعَ کَلأَمُہُ ؟ فَقَالَ : دِیَاتٌ ؛ فِی سَمْعِہِ دِیَۃٌ ، وَفِی بَصَرِہِ دِیَۃٌ ، وَفِی لِسَانِہِ دِیَۃٌ ، فَقِیلَ لِلْحَسَنِ : رَبِحَ ، فَقَالَ : وَاللَّہِ مَا رَبِحَ ، وَلاَ أَفْلَحَ۔","","Musannaf Ibn Abi Shaybah 27441","","","كتاب الديات"
"27442","(۲۷۴۴۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : بَلَغَنِی أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ جَائَ إِلَیْہِ رَجُلٌ ، فَقَالَ : ضَرَبَنِی فُلاَنٌ حَتَّی صُمَّتْ إِحْدَی أُذُنَیْ ، فَقَالَ : کَیْفَ نَعْلَمُ ؟ فَقَالَ : ادْعُوا الأَطِبَّائَ ، فَدَعوہُمْ فَشَمُّوہَا ، فَقَالُوا : ہَذِہِ الصَّمَّائُ۔","","Musannaf Ibn Abi Shaybah 27442","","","كتاب الديات"
"27443","(۲۷۴۴۳) حَدَّثَنَا عُمَرُ بْنُ عَلِیِّ بْنِ عَطَائِ بْنِ مُقَدَّمٍ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَن زَیْدِ بْنِ ثَابِتٍ ؛ فِی الرَّجُلِ یَدَّعِی أَنَّہُ قَدْ ذَہَبَ سَمْعُہُ ، قَالَ : یُحَلَّفُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 27443","","","كتاب الديات"
"27444","(۲۷۴۴۴) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ بَعْضِ أَصْحَابِہِ ، عَنْ شُرَیْحٍ ؛ أَنَّ رَجُلاً ادَّعَی ذِہَابَ سَمْعِہِ ؛ فَأَمَرَ أَنْ یُحَلَّفَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 27444","","","كتاب الديات"
"27445","(۲۷۴۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ فِی رَجُلٍ ادَّعَی أَنَّ سَمْعَہُ قَدْ ذَہَبَ ؟ قَالَ : یَنْظُرُ إِلَیْہِ الدَّارُونَ ، یَعْنِی الأَطِبَّائَ۔","","Musannaf Ibn Abi Shaybah 27445","","","كتاب الديات"
"27446","(۲۷۴۴۶) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنِ ابْنِ أَبِی نَجِیحٍ، عَن مُجَاہِدٍ، قَالَ: إِذَا سَمِعَ الرَّعْدَ فَغُشِیَ عَلَیْہِ فَفِیہِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27446","","","كتاب الديات"
"27447","(۲۷۴۴۷) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یُغْتَفَلُ فَیُصَاحُ بِہِ۔","","Musannaf Ibn Abi Shaybah 27447","","","كتاب الديات"
"27448","(۲۷۴۴۸) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ قَالَ : حدَّثَنَا الزُّبَیْرُ بْنُ جُنَادَۃَ ، قَالَ : سَأَلْتُ عَطَائً عَنْ رَجُلٍ ضَرَبَ رَجُلاً فَذَہَبَ سَمْعُہُ ، وَقَدْ کَانَ سَمِیعًا ؟ قَالَ : یُتْرَکُ ، فَإِذَا اسْتَثْقَلَ نَوْمًا أُجْلِبَ حَوْلَہُ ، فَإِنْ لَمْ یَسْتَنْبِہْ کَانَتِ الدِّیَۃُ، وَإِنِ اسْتَنْبَہَ کَانَتْ حُکُومَۃٌ۔","","Musannaf Ibn Abi Shaybah 27448","","","كتاب الديات"
"27449","(۲۷۴۴۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَمَّنْ سَمِعَ الْقَاسِمَ بْنَ مُحَمَّدٍ ، وَسُئِلَ عَنْ رَجُلٍ ضَرَبَ حَنْجَرَۃَ رَجُلٍ ، فَذَہَبَ صَوْتُہُ ؟ فَقَالَ : فِیہَا الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27449","","","كتاب الديات"
"27450","(۲۷۴۵۰) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَنْ زَیْدٍ ، قَالَ : إِذَا ضُرِبَ [corrupt]لرَّجُلُ فَحَدِبَ ، أَوْ غُنَّ ، أَوْ بُحَّ ، فَفِی کُلِّ وَاحِدۃٍ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27450","","","كتاب الديات"
"27451","(۲۷۴۵۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُمَرَ ؛ أَنَّ أُمَرَائَ الأَجْنَادِ اجْتَمَعُوا لِعُمَرَ بْنِ عَبْدِ الْعَزِیزِ فِی الْحَنْجَرَۃِ ، إِذَا انْکَسَرَتْ فَانْقَطَعَ الصَّوْتُ مِنَ الرَّجُلِ ، الدِّیَۃُ کَامِلَۃً۔","","Musannaf Ibn Abi Shaybah 27451","","","كتاب الديات"
"27452","(۲۷۴۵۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن یُونُسَ ، عَنِ الْحَسَنِ : إِذَا ذَہَبَ کَلاَمُہُ فَالدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27452","","","كتاب الديات"
"27453","(۲۷۴۵۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَنْ زَیْدٍ ؛ فِی الصَّعَرِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27453","","","كتاب الديات"
"27454","(۲۷۴۵۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ قَالَ : أَخْبَرَنِی عَبْدُ الْعَزِیزِ بْنُ عُمَرَ : أَنَّ أُمَرَائَ الأَجْنَادِ اجْتَمَعُوا لِعُمَرَ بْنِ عَبْدِ الْعَزِیزِ فِی الصَّعَرِ ، إِذَا لَمْ یَلْتَفِتِ الرَّجُلُ إِلاَّ مَا انْحَرَفَ : خَمْسُونَ دِینَارًا۔","","Musannaf Ibn Abi Shaybah 27454","","","كتاب الديات"
"27455","(۲۷۴۵۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عُمَرَ بْنِ عَامِرٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ رَجُلاً أَصَابَ عَیْنَ رَجُلٍ ، فَذَہَبَ بَعْضُ بَصَرِہِ وَبَقِیَ بَعْضٌ ، فَرُفِعَ ذَلِکَ إِلَی عَلِیٍّ ، فَأَمَرَ بِعَیْنِہِ الصَّحِیحَۃِ فَعُصِبَتْ ، وَأَمَرَ رَجُلاً بِبَیْضَۃٍ فَانْطَلَقَ بِہَا وَہُوَ یَنْظُرُ حَتَّی انْتَہَی بَصَرُہُ ، ثُمَّ خَطَّ عَندَ ذَلِکَ عَلَمًا ، قَالَ : ثُمَّ نَظَرَ فِی ذَلِکَ فَوَجَدُوہُ سَوَائً ، فَقَالَ : فَأَعْطوہُ بِقَدْرِ مَا نَقَصَ مِنْ بَصَرِہِ مِنْ مَالِ الآخَرِ۔","Hasan","Musannaf Ibn Abi Shaybah 27455","","","كتاب الديات"
"27456","(۲۷۴۵۶) حدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنْ الْحَسَنِ ؛ فِی رَجُلٍ فَقَأَ عَیْنَ رَجُلٍ ، وَہُوَ یُبْصِرُ بِہَا ، قَالَ : یَغْرَمُ بِقَدْرِ مَا نَقَصَ مِنْہَا۔","","Musannaf Ibn Abi Shaybah 27456","","","كتاب الديات"
"27457","(۲۷۴۵۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ عَطَائٌ : فِی الْعَیْنِ خَمْسُونَ ، قَالَ : فَذَہَبَ بَعْضُ بَصَرِہَا وَبَقِیَ بَعْضٌ ، قَالَ : بِحِسَابِ مَا ذَہَبَ ، قَالَ : یَمْسِکُ عَلَی الصَّحِیحَۃِ ، فَیَنْظُرُ بِالأُخْرَی ، ثُمَّ یَمْسِکُ عَلَی الأُخْرَی ، فَیَنْظُرُ بِالصَّحِیحَۃِ ، فَیُحْسَبُ مَا ذَہَبَ مِنْہَا۔n قُلْتُ : ضَعُفَتْ عَیْنُہُ مِنْ کِبَرٍ فَأُصِیبَتْ ، قَالَ : نَذْرُہَا وَافِیًا۔","","Musannaf Ibn Abi Shaybah 27457","","","كتاب الديات"
"27458","(۲۷۴۵۸) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَن حَسَنٍ ، عَن بَیَانٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : ذُکِرَ قَوْلُ عَلِیٍّ فِی الَّذِی أُصِیبَتْ عَیْنُہُ حَیْثُ أَرَاہُ الْبَیْضَۃَ ، فَقَالَ الشَّعْبِیُّ : إِنَّہُ إِنْ شَائَ زَادَ فِی عَیْنِہِ الَّتِی یُبْصِرُ بِہَا ، فَقَالَ : إِنَّہُ یُبْصِرُ بِہَا أَکْثَرَ مِمَّا یُبْصِرُ بِہَا ، وَإِنْ شَائَ نَقَصَ مِنْ عَیْنِہِ الَّتِی أُصِیبَتْ ، فَقَالَ : إِنَّہُ لاَ یُبْصِرُ بِہَا وَہُوَ یُبْصِرُ بِہَا ، وَلَکِنَّ أَمْثَلَ مِنْ ذَلِکَ أَنْ یَنْظُرَ طَبِیبٌ مَا یَرَی ، فَیَنْظُرُ مَا نَقَصَ مِنْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 27458","","","كتاب الديات"
"27459","(۲۷۴۵۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَنْ زَیْدٍ ؛ فِی الشَّفَۃِ السُّفْلَی ثُلُثَا الدِّیَۃِ ، لأَنَّہَا تَحْبِسُ الطَّعَامَ وَالشَّرَابَ ، وَفِی الْعُلْیَا ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27459","","","كتاب الديات"
"27460","(۲۷۴۶۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی السُّفْلَی ثُلُثَا الدِّیَۃِ ، وَفِی الْعُلْیَا ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27460","","","كتاب الديات"
"27461","(۲۷۴۶۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، أَنَّہُ قَالَ : فِی الشَّفَتَیْنِ الدِّیَۃُ ؛ فِی السُّفْلَی ثُلُثَا الدِّیَۃِ ، وَفِی الْعُلْیَا ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27461","","","كتاب الديات"
"27462","(۲۷۴۶۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : فِی الشَّفَتَیْنِ الدِّیَۃُ ، وَفِی إِحْدَاہُمَا نِصْفُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27462","","","كتاب الديات"
"27463","(۲۷۴۶۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ شُرَیْحٍ ؛ فِی الشَّفَتَیْنِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27463","","","كتاب الديات"
"27464","(۲۷۴۶۴) حَدَّثَنَا وَکِیعٌ ، عَن زَکَرِیَّا ، عَنْ عَامِرٍ ، قَالَ : فِی الشَّفَتَیْنِ الدِّیَۃُ ، وَفِی کُلِّ وَاحِدَۃٍ مِنْہُمَا نِصْفٌ۔","","Musannaf Ibn Abi Shaybah 27464","","","كتاب الديات"
"27465","(۲۷۴۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ : مَا کَانَ مِنَ اثْنَیْنِ فِی الإِنْسَان فَفِیہِمَا الدِّیَۃُ ، وَفِی کُلِّ وَاحِدَۃٍ مِنْہُمَا نِصْفُ الدِّیَۃِ ، وَمَا کَانَ مِنْ وَاحِدٍ فَفِیہِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27465","","","كتاب الديات"
"27466","(۲۷۴۶۶) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، قَالَ : قضَی أَبُو بَکْرٍ فِی الشَّفَتَیْنِ بِالدِّیَۃِ ، مِئَۃٌ مِنَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27466","","","كتاب الديات"
"27467","(۲۷۴۶۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : الشَّفَتَانِ مَا فِیہِمَا ؟ قَالَ : خَمْسُونَ خَمْسُونَ مِنَ الإِبِلِ فِی کُلِّ وَاحِدَۃٍ ، قُلْتُ : أَیُفَضَّلُ بَیْنَہُمَا ؟ قَالَ : السُّفْلَی تُفَضَّلُ ، زَعَمُوا ، قُلْتُ : بِکَمْ ؟ قَالَ : لاَ أَدْرِی۔","","Musannaf Ibn Abi Shaybah 27467","","","كتاب الديات"
"27468","(۲۷۴۶۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی ابْنُ أَبِی نَجِیحٍ ، عَن مُجَاہِدَ ، أَنَّہُ قَالَ : فِی الشَّفَتَیْنِ خَمْسُونَ خَمْسُونَ ، وَتُفَضَّلُ السُّفْلَی عَلَی الْعُلْیَا مِنَ الرَّجُلِ وَالْمَرْأَۃِ بِالتَّغْلِیظِ ، وَلاَ تُفَضَّلُ بِالزِّیَادَۃِ فِی عَدَدٍ ، وَلَکِنَّ الْخَمْسِینَ فِیہَا تَغْلِیظٌ فِی أَسْنَانِ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27468","","","كتاب الديات"
"27469","(۲۷۴۶۹) حَدَّثَنَا صَفْوَانُ بْنُ عِیسَی ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، قَالَ : الشَّفَتَانِ سَوَائٌ ؛ النِّصْفُ وَالنِّصْفُ۔","","Musannaf Ibn Abi Shaybah 27469","","","كتاب الديات"
"27470","(۲۷۴۷۰) حَدَّثَنَا حَفْصٌ، عَنِ الشَّیْبَانِیِّ، عَنِ الشَّعْبِیِّ، قَالَ: فِی الشَّفَتَیْنِ الدِّیَۃُ، فِی السُّفْلَی الثُّلُثَانِ، وَفِی الْعُلْیَا الثُّلُثُ۔","","Musannaf Ibn Abi Shaybah 27470","","","كتاب الديات"
"27471","(۲۷۴۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَن عِکْرِمَۃَ بْنِ خَالِدٍ ، عَنْ رَجُلٍ مِنْ آلِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فِی اللِّسَانِ الدِّیَۃُ کَامِلَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 27471","","","كتاب الديات"
"27472","(۲۷۴۷۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنِ الزُّہْرِیِّ ، رَفَعَہُ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فِی اللِّسَانِ إِذَا اسْتُؤْصِلَ الدِّیَۃُ کَامِلَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 27472","","","كتاب الديات"
"27473","(۲۷۴۷۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مَکْحُولٍ ، رَفَعَہُ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 27473","","","كتاب الديات"
"27474","(۲۷۴۷۴) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : فِی اللِّسَانِ الدِّیَۃُ۔","Hasan","Musannaf Ibn Abi Shaybah 27474","","","كتاب الديات"
"27475","(۲۷۴۷۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ ؛ فِی اللِّسَانِ إِذَا اسْتُؤْصِلَ الدِّیَۃُ أَخْمَاسًا ، فَمَا نَقَصَ فَبِالْحِسَابِ۔","Da'if","Musannaf Ibn Abi Shaybah 27475","","","كتاب الديات"
"27476","(۲۷۴۷۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : فِی اللِّسَانِ الدِّیَۃُ کَامِلَۃً ، وَمَا أُصِیبَ مِنَ اللِّسَانِ ، فَبَلَغَ أَنْ یَمْنَعَ الْکَلاَمَ فَفِیہِ الدِّیَۃُ کَامِلَۃً۔","","Musannaf Ibn Abi Shaybah 27476","","","كتاب الديات"
"27477","(۲۷۴۷۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : فِی عُکَدَۃِ اللِّسَانِ۔","","Musannaf Ibn Abi Shaybah 27477","","","كتاب الديات"
"27478","(۲۷۴۷۸) حَدَّثَنَا ہُشَیْمٌ ، عَن یُونُسَ ، عَنِ الْحَسَنِ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 27478","","","كتاب الديات"
"27479","(۲۷۴۷۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عُمَرَ بْنِ عَامِرٍ ، عَنْ مَکْحُولٍ ، عَن زَیْدِ بْنِ ثَابِتٍ ، قَالَ : فِی اللِّسَانِ إِذَا انْشَقَّ ، ثُمَّ الْتَأَمَ عِشْرُونَ بَعِیرًا۔","","Musannaf Ibn Abi Shaybah 27479","","","كتاب الديات"
"27480","(۲۷۴۸۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : اللِّسَانُ یُقْطَعُ کُلُّہُ ؟ قَالَ : الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27480","","","كتاب الديات"
"27481","(۲۷۴۸۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، قَالَ : قضَی أَبُو بَکْرٍ الصِّدِّیقُ فِی اللِّسَانِ إِذَا قُطِعَ بِالدِّیَۃِ ، إِذَا أُوْعِبَ مِنْ أَصْلِہِ ، وَإِذَا قُطِعَتْ أَسَلَتُہُ فَتَکَلَّمَ صَاحِبُہُ ، فَفِیہِ نِصْفُ الدِّیَۃِ۔n(بیہقی ۸۹)","","Musannaf Ibn Abi Shaybah 27481","","","كتاب الديات"
"27482","(۲۷۴۸۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ سُلَیْمَانُ بْنُ مُوسَی : فِی کِتَابِ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ : مَا قُطِعَ مِنَ اللِّسَانِ فَبَلَغَ أَنْ یَمْنَعَ الْکَلاَمَ کُلَّہُ فَفِیہِ الدِّیَۃُ ، وَمَا نَقَصَ دُونَ ذَلِکَ فَبِحِسَابِہِ۔","","Musannaf Ibn Abi Shaybah 27482","","","كتاب الديات"
"27483","(۲۷۴۸۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عَبْدُ الْعَزِیزِ بْنُ عُمَرَ ، أَنَّ فِی کِتَابٍ لِعُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ ؛ فِی اللِّسَانِ إِذَا اسْتُؤْصِلَ الدِّیَۃُ کَامِلَۃً ، وَمَا أُصِیبَ مِنَ اللِّسَانِ فَبَلَغَ أَنْ یَمْنَعَ الْکَلاَمَ فَفِیہِ الدِّیَۃُ کَامِلَۃً ، وَفِی لِسَانِ الْمَرْأَۃِ الدِّیَۃُ کَامِلَۃً ، وَمَا أُصِیبَ مِنْ لِسَانِہَا فَبَلَغَ أَنْ یَمْنَعَ الْکَلاَمَ فَفِیْہِ الدِّیَۃُ کَامِلَۃً ، وَمَا کَانَ دُونَ ذَلِکَ فَبِحِسَابِہِ۔ (ابوداؤد ۲۶۱)","","Musannaf Ibn Abi Shaybah 27483","","","كتاب الديات"
"27484","(۲۷۴۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ عَاصِمٍ ، عَنْ عَلِیٍّ ، قَالَ : فِی اللِّسَانِ الدِّیَۃُ۔","Hasan","Musannaf Ibn Abi Shaybah 27484","","","كتاب الديات"
"27485","(۲۷۴۸۵) حَدَّثَنَا وَکِیعٌ ، عَن سَلاَّمٍ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : فِیہِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27485","","","كتاب الديات"
"27486","(۲۷۴۸۶) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عَبْدُ الْعَزِیزِ بْنُ عُمَرَ ؛ أَنَّ أُمَرَائَ الأَجْنَادِ اجْتَمَعُوا لِعُمَرَ بْنِ عَبْدِ الْعَزِیزِ فِی الذَّقَنِ ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27486","","","كتاب الديات"
"27487","(۲۷۴۸۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : بَلَغَنِی عَنِ الشَّعْبِیِّ ، أَنَّہُ قَالَ : فِی اللَّحْی إِذَا کُسِرَ أَرْبَعُونَ دِینَارًا۔","","Musannaf Ibn Abi Shaybah 27487","","","كتاب الديات"
"27488","(۲۷۴۸۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : حُدِّثْتُ عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، أَنَّہُ قَالَ : فِی فَقَمِی الإِنْسَانِ أَنْ یَثْنِیَ إِبْہَامَہُ ، ثُمَّ یَجْعَلَ قَصَبَتَہُ السُّفْلَی ، وَیَفْتَحَ فَاہُ فَیَجْعَلَہَا بَیْنَ لَحْیَیْہِ ، فَمَا نَقَصَ مِنْ فَتْحِہِ فَاہُ مِنْ قَصَبَۃِ إِبْہَامِہِ السُّفْلَی کَانَ بِحِسَابِہِ۔","","Musannaf Ibn Abi Shaybah 27488","","","كتاب الديات"
"27489","(۲۷۴۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَن عِکْرِمَۃَ بْنِ خَالِدٍ ، عَنْ رَجُلٍ مِنْ آلِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فِی الْیَدِ خَمْسُونَ۔ (ابوداؤد ۴۵۵۳۔ احمد ۲۱۷)","Da'if","Musannaf Ibn Abi Shaybah 27489","","","كتاب الديات"
"27490","(۲۷۴۹۰) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عُمَارَۃَ ، عَنْ أَبِی بَکْرِ بْنِ عَمْرِو بْنِ حَزْمٍ ، قَالَ : کَانَ فِی کِتَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِعَمْرِو بْنِ حَزْمٍ : فِی الْیَدِ خَمْسُونَ۔ (نسائی ۷۰۵۹)","","Musannaf Ibn Abi Shaybah 27490","","","كتاب الديات"
"27491","(۲۷۴۹۱) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : فِی الْیَدِ نِصْفُ الدِّیَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 27491","","","كتاب الديات"
"27492","(۲۷۴۹۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ ، قَالَ : فِی الْیَدِ نِصْفُ الدِّیَۃِ ، خَمْسُونَ مِنَ الإِبِلِ أَرْبَاعًا ، رُبْعٌ جِذَاعٌ ، وَرُبْعٌ حِقَاقٌ ، وَرُبْعٌ بَنَاتُ لَبُونٍ ، وَرُبْعٌ بَنَاتُ مَخَاضٍ۔","Da'if","Musannaf Ibn Abi Shaybah 27492","","","كتاب الديات"
"27493","(۲۷۴۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمٍ ، عَنْ عَلِیِّ ، قَالَ : فِی الْیَدِ نِصْفُ الدِّیَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 27493","","","كتاب الديات"
"27494","(۲۷۴۹۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنْ عَامِرٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : فِی الْیَدِ نِصْفُ الدِّیَۃِ أَخْمَاسًا۔","Da'if","Musannaf Ibn Abi Shaybah 27494","","","كتاب الديات"
"27495","(۲۷۴۹۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَن حَکِیمِ بْنِ حَکِیمٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، قَالَ : کَانَ فِیمَا وَضَعَ أَبُو بَکْرٍ ، وَعُمَرُ مِنَ الْقَضِیَّۃِ فِی الْجِرَاحَۃِ : الْیَدُ إِذَا لَمْ یَأْکُلْ بِہَا صَاحِبُہَا ، وَلَمْ یَأْتَزِرْ ، وَلَمْ یَسْتَطِبْ بِہَا ، فَقَدْ تَمَّ عَقْلُہَا ، فَمَا نَقَصَ فَبِحِسَابٍ۔","","Musannaf Ibn Abi Shaybah 27495","","","كتاب الديات"
"27496","(۲۷۴۹۶) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ عَطَائٌ : فِی الْیَدِ تُسْتَأْصَلُ خَمْسُونَ ، قُلْتُ : أَمِنَ الْمَنْکِبِ ، أَوْ مِنَ الْکَتِفِ ؟ قَالَ : لاَ ، بَلْ مِنَ الْمَنْکِبِ۔","","Musannaf Ibn Abi Shaybah 27496","","","كتاب الديات"
"27497","(۲۷۴۹۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، قَالَ : إِنْ قُطِعَتِ الأَصَابِعُ فَالدِّیَۃُ ، وَإِنْ قُطِعَتِ الْکَفُّ فَخَمْسُونَ مِنَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27497","","","كتاب الديات"
"27498","(۲۷۴۹۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : إِذَا قُطِعَتِ الْیَدُ مِنَ الْمِفْصَلِ فَفِیہَا نِصْفُ الدِّیَۃِ ، وَإِذَا قُطِعَتْ مِنَ الْعَضُدِ فَفِیہَا نِصْفُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27498","","","كتاب الديات"
"27499","(۲۷۴۹۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَن مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : الْیَدَانِ سَوَائٌ۔","Da'if","Musannaf Ibn Abi Shaybah 27499","","","كتاب الديات"
"27500","(۲۷۵۰۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا قُطِعَتِ الْکَفُّ مِنَ الْمِفْصَلِ ، فَإِنَّ فِیہَا دِیَتُہَا ، فَإِنْ قُطِعَ مِنْہُمَا شَیْئٌ بَعْدَ ذَلِکَ فَفِیہَا حُکُومَۃُ عَدْلٍ ، وَإِذَا قُطِعَتْ مِنَ الْعَضُدِ ، أَوْ أَسْفَلَ مِنَ الْعَضُدِ شَیْئًا ، فَإِنَّ فِیہَا دِیَتُہَا۔","","Musannaf Ibn Abi Shaybah 27500","","","كتاب الديات"
"27501","(۲۷۵۰۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : أَرَأَیْتَ إِنْ قُطِعَتِ الْیَدُ مِنْ شَطْرِ الذِّرَاعِ ؟ قَالَ : خَمْسُونَ ، قُلْتُ : فَقُطِعَ شَیْئٌ مِمَّا بَقِیَ بَعْدُ ؟ قَالَ : جُرْحٌ ، لاَ أَحْسِبُ إِلاَّ ذَلِکَ ، إِلاَّ أَنْ یَکُونَ فِی ذَلِکَ سُنَّۃٌ۔","","Musannaf Ibn Abi Shaybah 27501","","","كتاب الديات"
"27502","(۲۷۵۰۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی ابْنُ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، قَالَ : إِنْ قُطِعَتِ الْکَفُّ فَخَمْسُونَ مِنَ الإِبِلِ ، فَإِنْ قُطِعَ مَا بَقِیَ مِنَ الْیَدِ کُلِّہَا ، أَوِ الذِّرَاعِ ، أَوْ قُطِعَ نِصْفُ الذِّرَاعِ : فَنِصْفُ نَذْرِ الْیَدِ أَیْضًا ، خَمْسَۃٌ وَعِشْرُونَ ، فَإِنْ کَانَتْ إِنَّمَا قُطِعَتْ مِنْ شَطْرِ ذِرَاعِہَا ، أَوِ الذِّرَاعِ بَعْدَ الْکَفِّ ، قَالَ مُجَاہِدٌ : یَقُولُ ذَلِکَ ، فَنِصْفُ نَذْرِ الْیَدِ ، فَإِنْ قُطِعَ مَا بَقِیَ کُلُّہُ فَجُرْحٌ یُرَی فِیْہِ۔ (عبدالرزاق ۱۷۶۸۹)","","Musannaf Ibn Abi Shaybah 27502","","","كتاب الديات"
"27503","(۲۷۵۰۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن زَیْدِ بْنِ أَسْلَمَ ، عَن مُسْلِمِ بْنِ جُنْدُبٍ ، عَنْ أَسْلَمَ مَوْلَی عُمَرَ ، قَالَ : سَمِعْتُ عُمَرَ یَقُولُ عَلَی الْمِنْبَرِ : فِی التَّرْقُوَۃِ جَمَلٌ۔","Sahih","Musannaf Ibn Abi Shaybah 27503","","","كتاب الديات"
"27504","(۲۷۵۰۴) حَدَّثَنَا عَبْدُالرَّحِیمِ، عَنْ حَجَّاجٍ، عَن جُنْدُبٍ الْقَاصِّ، عَنْ أَسْلَمَ مَوْلَی عُمَرَ؛ أَنَّہُ قَضَی فِی التَّرْقُوَۃِ بِبَعِیر۔","","Musannaf Ibn Abi Shaybah 27504","","","كتاب الديات"
"27505","(۲۷۵۰۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَن دَاوُد بْنِ أَبِی عَاصِمٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : فِی التَّرْقُوَۃِ بَعِیرٌ۔","","Musannaf Ibn Abi Shaybah 27505","","","كتاب الديات"
"27506","(۲۷۵۰۶) حَدَّثَنَا وَکِیعٌ ، وَأَبُو خَالِدٍ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : فِی التَّرْقُوَۃِ بَعِیرَانِ۔","","Musannaf Ibn Abi Shaybah 27506","","","كتاب الديات"
"27507","(۲۷۵۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، عَن مَسْرُوقٍ ، قَالَ : فِی التَّرْقُوَۃِ حُکْمٌ۔","","Musannaf Ibn Abi Shaybah 27507","","","كتاب الديات"
"27508","(۲۷۵۰۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَن مُجَاہِدٍ ، وَالشُّعَبِیِّ ؛ قَالاَ : إِنْ کُسِرَتْ فَأَرْبَعُونَ دِینَارًا۔","","Musannaf Ibn Abi Shaybah 27508","","","كتاب الديات"
"27509","(۲۷۵۰۹) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عَبْدُ الْکَرِیمِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، قَالَ : إِنْ قُطِعَتِ التَّرْقُوَۃُ فَلَمْ یَعِشْ فَلَہُ الدِّیَۃُ کَامِلَۃً ، فَإِنْ عَاشَ فَفِیہَا خَمْسُونَ مِنَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27509","","","كتاب الديات"
"27510","(۲۷۵۱۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ قَتَادَۃَ ، قَالَ : إِذَا انْجَبَرَتِ التَّرْقُوَۃُ فَفِیہَا أَرْبَعَۃُ أَبْعِرَۃٍ ، یَعْنِی مَثَلَ بِالوَجُور۔","","Musannaf Ibn Abi Shaybah 27510","","","كتاب الديات"
"27511","(۲۷۵۱۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی السِّنِّ بِخَمْسٍ مِنَ الإِبِلِ۔n قَالَ: وَقَالَ أَبِی: یُفَضَّلُ بَعْضُہَا عَلَی بَعْضٍ، بِمَا یَرَی أَہْلُ الرَّأْیِ وَالْمَشْورَۃِ۔(ابوداؤد ۲۶۱۔ عبدالرزاق ۱۷۴۹۰)","","Musannaf Ibn Abi Shaybah 27511","","","كتاب الديات"
"27512","(۲۷۵۱۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ أَبِی عَرُوبَۃَ ، عَنْ مَطَرٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فِی الأَسْنَانِ خَمْسٌ خَمْسٌ۔ n(ابوداؤد ۴۵۵۳۔ احمد ۱۸۲)","Hasan","Musannaf Ibn Abi Shaybah 27512","","","كتاب الديات"
"27513","(۲۷۵۱۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن حُسَیْنِ الْمُعَلِّمِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فِی السِّنِّ خَمْسٌ۔ (ابوداؤد ۴۵۵۲۔ نسائی ۷۰۴۵)","Hasan","Musannaf Ibn Abi Shaybah 27513","","","كتاب الديات"
"27514","(۲۷۵۱۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : فِی السِّنِّ خَمْسٌ مِنَ الإِبِلِ ، أَوْ عَدْلُ ذَلِکَ مِنَ الذَّہَبِ ، أَوِ الْوَرِقِ۔","","Musannaf Ibn Abi Shaybah 27514","","","كتاب الديات"
"27515","(۲۷۵۱۵) حَدَّثَنَا وَکِیعٌ ، عن مَالِکِ بْنِ أَنَسٍ ، عَنْ دَاوُدَ بْنُ حُصَیْنٍ ، عَنْ أَبِی غَطَفَانَ الْمُرِّیِّ ، عَنِ ابْنِ عَبَّاسٍ قَالَ: الأَسْنَانُ سَوَائٌ ؛ اعْتَبرہَا بِالأَصَابِعِ۔","Sahih","Musannaf Ibn Abi Shaybah 27515","","","كتاب الديات"
"27516","(۲۷۵۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَن سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ شُرَیْحٍ ، قَالَ : الأَسْنَانُ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 27516","","","كتاب الديات"
"27517","(۲۷۵۱۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، عَنْ شُرَیْحٍ ، قَالَ : أَتَانِی عُرْوَۃُ الْبَارِقِیُّ مِنْ عَندِ عُمَرَ : أَنَّ الأَصَابِعَ وَالأَسْنَانَ فِی الدِّیَۃِ سَوَائٌ۔","Sahih","Musannaf Ibn Abi Shaybah 27517","","","كتاب الديات"
"27518","(۲۷۵۱۸) حَدَّثَنَا وَکِیعٌ، عَنْ ہِشَامٍ، عَنْ أَبِیہِ، قَالَ: الأَسْنَانُ سَوَائٌ، وَقَالَ: إِنْ کَانَ لِلثَّنِیَّۃِ جَمَالٌ فَإِنَّ لِلضِّرْسِ مَنْفَعَۃً۔","","Musannaf Ibn Abi Shaybah 27518","","","كتاب الديات"
"27519","(۲۷۵۱۹) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : ہِیَ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 27519","","","كتاب الديات"
"27520","(۲۷۵۲۰) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : ہی فِی الدِّیَۃِ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 27520","","","كتاب الديات"
"27521","(۲۷۵۲۱) حَدَّثَنَا حَفْصٌ ، وَأَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَشْہَدُ عَلَی شُرَیْحٍ ،وَمَسْرُوقٍ أَنَّہُمَا جَعَلاَ الأَصَابِعَ وَالأَسْنَانَ فِی الدِّیَۃِ سَوَائً۔","","Musannaf Ibn Abi Shaybah 27521","","","كتاب الديات"
"27522","(۲۷۵۲۲) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، قَالَ : فِی السِّنِّ خَمْسٌ مِنَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27522","","","كتاب الديات"
"27523","(۲۷۵۲۳) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : حدَّثَنَا عِکْرِمَۃُ بْنُ خَالِدٍ ، عَنْ رَجُلٍ مِنْ آلِ عُمَرَ ؛ قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی السِّنِّ خَمْسٌ مِنَ الإِبِلِ۔","Da'if","Musannaf Ibn Abi Shaybah 27523","","","كتاب الديات"
"27524","(۲۷۵۲۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنَی سُلَیْمَانُ بْنُ مُوسَی ؛ أَنَّ فِی کِتَابِ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ إِلَی أُمَرَائِ الأَجْنَادِ : وَفِی الأَسْنَانِ خَمْسٌ مِنَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27524","","","كتاب الديات"
"27525","(۲۷۵۲۵) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ أَشْعَثَ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ ، قَالَ : فِی السِّنِّ خَمْسٌ مِنَ الإِبِلِ أَخْمَاسًا۔","Da'if","Musannaf Ibn Abi Shaybah 27525","","","كتاب الديات"
"27526","(۲۷۵۲۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَن مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : الأَسْنَانُ سَوَائٌ۔","Da'if","Musannaf Ibn Abi Shaybah 27526","","","كتاب الديات"
"27527","(۲۷۵۲۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : فِی الأَسْنَانِ خَمْسٌ خَمْسٌ۔","","Musannaf Ibn Abi Shaybah 27527","","","كتاب الديات"
"27528","(۲۷۵۲۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ لِی عَطَائٌ : فِی الأَسْنَانِ الثَّنِیَّتَیْنِ ، والرَّباعِیَّتیْن ، وَالنَّابَیْنِ خَمْسٌ خَمْسٌ ، وَفِیمَا بَقِیَ بَعِیرَانِ بَعِیرَانِ ، أَعْلَی الْفَمِ مِنْ ذَلِکَ وَأَسْفَلہُ سَوَائٌ ، ثَنِیَّتَا ، وَرَبَاعِیَتَا ، وَنَابَا أَعْلَی الْفَمِ وَأَسْفَلِہِ سَوَائٌ ، وَأَضْرَاسُ أَعْلَی الْفَمِ ، وَأَضْرَاسُ أَسْفَلِ الْفَمِ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 27528","","","كتاب الديات"
"27529","(۲۷۵۲۹) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخَبَرَنِی ابْنُ أَبِی نُجَیٍحٍ ، عَنْ مُجَاہِدٍ ؛ مِثْلَ قَوْلِ عَطَائٍ ، قَالَ : الأَسْنَانُ مِنْ أَعْلَی الْفَمِ وَأَسْفَلِہِ ، وَالأَضْرَاسُ مِنْ أَعْلَی الْفَمِ وَأَسْفَلِہِ ، سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 27529","","","كتاب الديات"
"27530","(۲۷۵۳۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنِ ابْنِ طَاوُوسٍ، قَالَ: قَالَ أَبِی: یُفَضَّلُ بَعْضُہَا عَلَی بَعْضٍ، بِمَا یَرَی أَہْلُ الرَّأْیِ وَالْمَشْورَۃِ۔","","Musannaf Ibn Abi Shaybah 27530","","","كتاب الديات"
"27531","(۲۷۵۳۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عَمْرُو بْنُ مُسْلِمٍ ؛ أَنَّہُ سَمِعَ طَاوُوسًا ، یَقُولُ : تُفَضَّلُ السِّتُّ فِی أَعْلَی الْفَمِ وَأَسْفَلِہِ عَلَی الأَضْرَاسِ ، وَأَنَّہُ قَالَ : فِی الأَضْرَاسِ صِغَارُ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27531","","","كتاب الديات"
"27532","(۲۷۵۳۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ قَضَی فِیمَا أَقْبَلَ مِنَ الْفَمِ بِخَمْسِ فَرَائِضَ خَمْسٍ ، وَذَلِکَ خَمْسُونَ دِینَارًا ، قِیمَۃُ کُلِّ فَرِیضَۃٍ عَشَرَۃُ دَنَانِیرَ ، وَفِی الأَضْرَاسِ بَعِیرٌ بَعِیرٌ۔n وَذَکَرَ یَحْیَی : أَنَّ مَا أَقْبَلَ مِنَ الْفَمِ ؛ الثَّنَایَا ، وَالرَّبَاعِیَاتُ ، وَالأَنْیَابُ۔n قَالَ سَعِیدٌ : حتَّی إِذَا کَانَ مُعَاوِیَۃُ فَأُصِیبَتْ أَضْرَاسُہُ ، قَالَ : أَنَا أَعْلَمُ بِالأَضْرَاسِ مِنْ عُمَرَ ، فَقَضَی فِیہِ خَمْسَ فَرَائِضَ ۔ قَالَ سَعِیدٌ : لَوْ أُصِیبَ الْفَمُ کُلُّہُ فِی قَضَائِ عُمَرَ لَنَقَصَتِ الدِّیَۃُ ، وَلَوْ أُصِیبَ فِی قَضَائِ مُعَاوِیَۃَ لَزَادَتِ الدِّیَۃُ ، وَلَوْ کُنْتُ أَنَا لَجَعَلْتُ فِی الأَضْرَاسِ بَعِیرَیْنِ بَعِیرَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 27532","","","كتاب الديات"
"27533","(۲۷۵۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ہَذِہِ وَہَذِہِ سَوَائٌ ، یَعْنِی الْخِنْصَرَ وَالإِبْہَامَ۔ (بخاری ۶۸۹۵۔ ابوداؤد ۴۵۴۶)","Sahih","Musannaf Ibn Abi Shaybah 27533","","","كتاب الديات"
"27534","(۲۷۵۳۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : قَالَ شُرَیْحٌ : أَتَانِی عُرْوَۃُ الْبَارِقِیُّ مِنْ عِندَ عُمَرَ : أَنَّ الأَصَابِعَ فِی الدِّیَۃِ سَوَائٌ۔","Sahih","Musannaf Ibn Abi Shaybah 27534","","","كتاب الديات"
"27535","(۲۷۵۳۵) حَدَّثَنَا أَبُو خ[corrupt]الِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَنْ زَیْدٍ بْنِ ثَابِتٍ ، قَالَ : الأَصَابِعُ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 27535","","","كتاب الديات"
"27536","(۲۷۵۳۶) حَدَّثَنَا أَبُو خَالِدٍ ، وَوَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ قَالَ : ہِیَ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 27536","","","كتاب الديات"
"27537","(۲۷۵۳۷) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : الدِّیَۃُ فِی الأَصَابِعِ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 27537","","","كتاب الديات"
"27538","(۲۷۵۳۸) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، قَالَ : وَجَدْتُ فِی کِتَابِی عَن حُمَیْدٍ ، عَن بَکْرٍ ، عَنْ ہِشَامِ بْنِ ہُبَیْرَۃَ ؛ أَنَّ ابْنَ عُمَرَ ، وَابْنَ عَبَّاسٍ ، قَالاَ : الأَصَابِعُ سَوَائٌ ، أَوْ ہَذِہِ وَہَذِہِ سَوَائٌ۔","Hasan","Musannaf Ibn Abi Shaybah 27538","","","كتاب الديات"
"27539","(۲۷۵۳۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، وَأَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَشْہَدُ عَلَی شُرَیْحٍ ، وَمَسْرُوقٍ ، أَنَّہُمَا جَعَلاَ الأَصَابِعَ وَالأَسْنَانَ سَوَائً۔","","Musannaf Ibn Abi Shaybah 27539","","","كتاب الديات"
"27540","(۲۷۵۴۰) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ، قَالاَ : الأَصَابِعُ سَوَائٌ ، عَشْرٌ عَشْرٌ۔","","Musannaf Ibn Abi Shaybah 27540","","","كتاب الديات"
"27541","(۲۷۵۴۱) حَدَّثَنَا إِسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن غَالِبٍ التَّمَّارِ ، عَن مَسْرُوقِ بْنِ أَوْسٍ ، عَنْ أَبِی مُوسَی ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ قَالَ : فِی الأَصَابِعِ عَشْرٌ عَشْرٌ۔ (ابوداؤد ۴۵۴۵۔ احمد ۳۹۷)","Da'if","Musannaf Ibn Abi Shaybah 27541","","","كتاب الديات"
"27542","(۲۷۵۴۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، وَأَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَن غَالِبِ التَّمَّارِ ، عنْ حُمَیْدِ بْنِ ہِلاَلٍ ، عَن مَسْرُوقِ بْنِ أَوْسٍ ، عَنْ أَبِی مُوسَی ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی الأَصَابِعِ بِعَشْرٍ مِنَ الإِبِلِ۔ (ابوداؤد ۴۵۴۴۔ ابن ماجہ ۲۶۵۴)","Da'if","Musannaf Ibn Abi Shaybah 27542","","","كتاب الديات"
"27543","(۲۷۵۴۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ سَعِیدِ ، عَنْ مَطَرٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی الأَصَابِعِ : عَشْرٌ عَشْرٌ۔ (ابوداؤد ۴۵۵۱۔ احمد ۲۱۵)","Hasan","Musannaf Ibn Abi Shaybah 27543","","","كتاب الديات"
"27544","(۲۷۵۴۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَن عِکْرِمَۃَ بْنِ خَالِدٍ ، عَنْ رَجُلٍ مِنْ آلِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فِی کُلِّ إِصْبَعٍ مِمَّا ہُنَالِکَ عَشْرٌ مِنَ الإِبِلِ۔","Da'if","Musannaf Ibn Abi Shaybah 27544","","","كتاب الديات"
"27545","(۲۷۵۴۵) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ ، وَعَبْدِ اللہِ ، قَالاَ : فِی الأَصَابِعِ ، فِی کُلِّ إِصْبَعٍ عُشْرُ الدِّیَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 27545","","","كتاب الديات"
"27546","(۲۷۵۴۶) حَدَّثَنَا أَبُو الأَحْوَصِ، عَنْ أَبِی إِسْحَاقَ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ، عَنْ عَلِیٍّ، قَالَ: فِی الإِصْبَعِ عُشْرُ الدِّیَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 27546","","","كتاب الديات"
"27547","(۲۷۵۴۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ؛ فِی کُلِّ إِصْبَعٍ عَشْرٌ مِنَ الإِبِلِ ، أَوْ عَدْلُ ذَلِکَ مِنْ ذَہَبٍ ، أَوْ وَرِقٍ۔","","Musannaf Ibn Abi Shaybah 27547","","","كتاب الديات"
"27548","(۲۷۵۴۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی کُلِّ إِصْبَعٍ خُمْسُ الدِّیَۃِ أَخْمَاسًا۔","","Musannaf Ibn Abi Shaybah 27548","","","كتاب الديات"
"27549","(۲۷۵۴۹) حَدَّثَنَا عَبْدُاللہِ بْنُ نُمَیْرٍ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ، عَنِ الشَّعْبِیِّ، قَالَ: الأَصَابِعُ کُلُّہَا سَوَائٌ، فِیہَا الْعُشْرُ۔","","Musannaf Ibn Abi Shaybah 27549","","","كتاب الديات"
"27550","(۲۷۵۵۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : فِی کُلِّ إِصْبَعٍ عَشْرِ فَرَائِضَ۔","","Musannaf Ibn Abi Shaybah 27550","","","كتاب الديات"
"27551","(۲۷۵۵۱) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الزُّہْرِیِّ ، قَالَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی کُلِّ إِصْبَعٍ مِمَّا ہُنَالِکَ عُشْرُ الدِّیَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 27551","","","كتاب الديات"
"27552","(۲۷۵۵۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ عُمَرَ قَضَی فِی الإِبْہَامِ وَالَّتِی تَلِیہَا بِکَفِکَ نِصْفُ الْکَفِّ، وَفِی الْوُسْطَی بِعَشْرِ فَرَائِضَ، وَالَّتِی تَلِیہَا بِتِسْعِ فَرَائِضَ، وَفِی الْخِنْصَرِ بِسِتِّ فَرَائِضَ۔","Sahih","Musannaf Ibn Abi Shaybah 27552","","","كتاب الديات"
"27553","(۲۷۵۵۳) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ، قَالاَ : الأَصَابِعُ عَشْرٌ عَشْرٌ۔","","Musannaf Ibn Abi Shaybah 27553","","","كتاب الديات"
"27554","(۲۷۵۵۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عَلِیٍّ ، وَابْنِ مَسْعُودٍ ، وَابْنِ عَبَّاسٍ ، وَالْحَسَنِ ، کَانُوا یَقُولُونَ : فِی الأَصَابِعِ کُلِّہَا عَشْرٌ عَشْرٌ۔","","Musannaf Ibn Abi Shaybah 27554","","","كتاب الديات"
"27555","(۲۷۵۵۵) حَدَّثَنَا إِسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن خَالِدِ الْحَذَّائِ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ عَمْرِو بْنِ سَلِمَۃَ قَالَ : کَتَبَ إِلَیْنَا عَبْدُ الْمَلِکِ بْنُ مَرْوَانَ ، وَنَحْنُ مَعَ خَالِدِ بْنِ عَبْدِ اللہِ : أَنَّ الأَصَابِعَ أَثْلاَثًا ، وَقَرَنَ خَالِدٌ بَیْنَ الْخِنْصَرِ وَالْبِنْصَرِ ، وَبَیْنَ الْوُسْطَی وَالَّتِی تَلِیہَا ، وَالإِبْہَامُ عَلَی حِدَۃٍ۔","","Musannaf Ibn Abi Shaybah 27555","","","كتاب الديات"
"27556","(۲۷۵۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : فِی کُلِّ مِفْصَلٍ مِنَ الأَصَابِعِ ثُلُثُ دِیَۃِ الإِصْبَعِ ، إِلاَّ الإِبْہَامَ فَإِنَّ فِی کُلِّ مِفْصَلٍ نِصْفَ دِیَتِہَا۔","","Musannaf Ibn Abi Shaybah 27556","","","كتاب الديات"
"27557","(۲۷۵۵۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، قَالَ : فِی الإِبْہَامِ خَمْسَ عَشْرَۃَ ، وَفِی الَّتِی تَلِیہَا عَشْرٌ ، وَفِی الَّتِی تَلِیہَا عَشْرٌ ، وَفِی الَّتِی تَلِیہَا ثَمَانٌ ، وَفِی الَّتِی تَلِیہَا سَبْعٌ۔","","Musannaf Ibn Abi Shaybah 27557","","","كتاب الديات"
"27558","(۲۷۵۵۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ حَجَّاجٍ ، عَنْ زَیْدٍ ؛ أَنَّہُ قَالَ : فِی الأَصَابِعِ فِی کُلِّ مِفْصَلٍ ثُلُثُ دِیَۃِ الإِصْبَعِ ، إِلاَّ الإِبْہَامَ ، فَإِنَّ فِیہَا نِصْفَ دِیَتِہَا إِذَا قُطِعَتْ مِنَ الْمِفْصَلِ ، لأَنَّ فِیہَا مِفْصَلَیْنِ۔","","Musannaf Ibn Abi Shaybah 27558","","","كتاب الديات"
"27559","(۲۷۵۵۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ الْقَضَائَ فِی الأَصَابِعِ فِی الْیَدَیْنِ وَالرِّجْلَیْنِ صَارَ إِلَی عَشْرٍ مِنَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27559","","","كتاب الديات"
"27560","(۲۷۵۶۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ ہِشَامَ بْنَ ہُبَیْرَۃَ کَتَبَ إِلَی شُرَیْحٍ یَسْأَلُہُ ، فَکَتَبَ إِلَیْہِ : إِنَّ أَصَابِعَ الرِّجْلَیْنِ وَالْیَدَیْنِ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 27560","","","كتاب الديات"
"27561","(۲۷۵۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَصَابِعُ الْیَدَیْنِ وَالرِّجْلَیْنِ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 27561","","","كتاب الديات"
"27562","(۲۷۵۶۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ أَبِی حَنِیفَۃَ ، عَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : أَصَابِعُ الْیَدَیْنِ وَالرِّجْلَیْنِ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 27562","","","كتاب الديات"
"27563","(۲۷۵۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی مِجْلَزٍ ؛ أَنَّ رَجُلاً سَأَلَ ابْنَ عُمَرَ عَنِ الأَعْوَرِ تُفْقَأُ عَیْنُہُ ؟ فَقَالَ عَبْدُ اللہِ بْنُ صَفْوَانَ : قَضَی فِیہَا عُمَرُ بِالدِّیَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 27563","","","كتاب الديات"
"27564","(۲۷۵۶۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عَبْدِ رَبِّہِ ، عَنْ أَبِی عِیَاضٍ ؛ أَنَّ عُثْمَانَ قَضَی فِی أَعْوَرَ أُصِیبَتْ عَیْنُہُ الصَّحِیحَۃُ الدِّیَۃَ کَامِلَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 27564","","","كتاب الديات"
"27565","(۲۷۵۶۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَن خِلاَسٍ ، عَنْ عَلِیٍّ ؛ فِی الرَّجُلِ الأَعْوَرِ إِذَا أُصِیبَتْ عَیْنُہُ الصَّحِیحَۃُ ، قَالَ : إِنْ شَائَ تُفْقَأُ عَیْنٌ مَکَانَ عَیْنٍ ، وَیَأْخ[corrupt]ذُ النِّصْفَ ، وَإِنْ شَائَ أَخَذَ الدِّیَۃَ کَامِلَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 27565","","","كتاب الديات"
"27566","(۲۷۵۶۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَن سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إِذَا فُقِئَتْ عَیْنُ الأَعْوَرِ فَفِیہَا دِیَۃٌ کَامِلَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 27566","","","كتاب الديات"
"27567","(۲۷۵۶۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَن لاَحِقِ بْنِ حُمَیْدٍ ؛ أَنَّہُ سَأَلَ ابْنُ عُمَرَ ، أَوْ سَأَلَہُ رَجُلٌ عَنِ الأَعْوَرِ تُفْقَأُ عَیْنُہُ الصَّحِیحَۃُ ؟ فَقَالَ ابْنُ صَفْوَانَ ، وَہُوَ عَندَ ابْنِ عُمَرَ : قَضَی فِیہَا عُمَرُ بِالدِّیَۃِ کَامِلَۃً ، فَقَالَ: إِنَّمَا أَسْأَلُک یَا ابْنَ عُمَرَ ، فَقَالَ : تَسْأَلُنِی ؟ ہَذَا یُحَدِّثُکَ أَنَّ عُمَرَ قَضَی فِیہَا بِالدِّیَۃِ کَامِلَۃً۔ (بیہقی ۹۴)","Sahih","Musannaf Ibn Abi Shaybah 27567","","","كتاب الديات"
"27568","(۲۷۵۶۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ ذَکَرَ مَا یَقُولُونَ فِی الأَعْوَرِ إِذَا فُقِئَتْ عَیْنُہُ الصَّحِیحَۃُ ، وَلَمْ یَکُنْ أَخَذَ لِلأُخْرَی أَرْشًا ، فَقَالُوا : الدِّیَۃُ کَامِلَۃً ، فَقَالَ إِبْرَاہِیمُ : زَعَمَ أُنَاسٌ مِنْ بَنِی کَاہِلٍ أَنَّ ذَلِکَ کَانَ فِیہِمْ ، فَقَضَی فِیہَا عُثْمَانُ دِیَۃَ الْعَیْنَیْنِ کِلْتَیْہِمَا ، فَسَأَلْنَا عَنْ غَوْر ذَلِکَ ، فَطَلَبْنَاہُ فَلَمْ نَجِدْ لَہُ نَفَاذًا ، فَبَردَ۔","","Musannaf Ibn Abi Shaybah 27568","","","كتاب الديات"
"27569","(۲۷۵۶۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : فِی الْعَیْنِ إِذَا لَمْ یَبْقَ مِنْ بَصَرِہِ غَیْرُہَا ، ثُمَّ أُصِیبَتْ ، الدِّیَۃُ کَامِلَۃً۔","","Musannaf Ibn Abi Shaybah 27569","","","كتاب الديات"
"27570","(۲۷۵۷۰) حَدَّثَنَا یَزِیدُ، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ؛ فِی أَعْوَرٍ فُقِئَتْ عَیْنُہُ، قَالَ: فِیہَا الدِّیَۃُ کَامِلَۃً۔","","Musannaf Ibn Abi Shaybah 27570","","","كتاب الديات"
"27571","(۲۷۵۷۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ؛ أَنَّہُ قَالَ : فِی الرَّجُلِ تُفْقَأُ عَیْنُہُ ، وَلَیْسَ لَہُ عَیْنٌ غَیْرُہَا ، قَالَ : الْقِصَاصُ ، وَإِنْ فُقِئَتْ خَطَأً فَنِصْفُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27571","","","كتاب الديات"
"27572","(۲۷۵۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن فِرَاسٍ ، عَنِ الشَّعْبِیِّ ، عَن مَسْرُوقٍ ؛ فِی الأَعْوَرِ تُفْقَأُ عَیْنُہُ الصَّحِیحَۃُ ، قَالَ : فِیہَا نِصْفٌ ، أَنَا أُدِیَ قَتِیلَ اللہِ؟۔","","Musannaf Ibn Abi Shaybah 27572","","","كتاب الديات"
"27573","(۲۷۵۷۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، وَوَکِیعٌ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ؛ فِی الأَعْوَرِ تُفْقَأُ عَیْنُہُ الصَّحِیحَۃُ عَمْدًا ، قَالَ : الْعَیْنُ بِالْعَیْنِ۔","","Musannaf Ibn Abi Shaybah 27573","","","كتاب الديات"
"27574","(۲۷۵۷۴) حَدَّثَنَا وَکِیعٌ ، وَعَبْدُ الرَّحِیمِ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ أَبِی الضُّحَی ، عَنْ عَبْدِ اللہِ بْنِ مُغَفَّلٍ ؛ فِی الأَعْوَرِ تُفْقَأُ عَیْنُہُ الصَّحِیحَۃُ عَمْدًا ، قَالَ : الْعَیْنُ بِالْعَیْنِ ، مَا أَنَا فَقَأْتُ عَیْنَہُ الأُوْلَی۔","","Musannaf Ibn Abi Shaybah 27574","","","كتاب الديات"
"27575","(۲۷۵۷۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَطَائِ بْنِ أَبِی رَبَاحٍ ، قَالَ : فِیہَا نِصْفُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27575","","","كتاب الديات"
"27576","(۲۷۵۷۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : فِیہَا نِصْفُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27576","","","كتاب الديات"
"27577","(۲۷۵۷۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَن زَکَرِیَّا ، عَن فِرَاسٍ ، عَنْ عَامِرٍ ، عَن مَسْرُوقٍ ؛ أَنَّہُ سُئِلَ عَنْ أَعْوَرَ فُقِئَتْ عَیْنُہُ ؟ فَقَالَ : لاَ أُدِیَ قَتِیلَ اللہِ ، إِنَّمَا عَلَی الَّذِی أَصَابَہَا دِیَۃُ عَیْنٍ وَاحِدَۃٍ۔","","Musannaf Ibn Abi Shaybah 27577","","","كتاب الديات"
"27578","(۲۷۵۷۸) حَدَّثَنَا حَفْصٌ ، عَن دَاوُد ، عَنْ عَامِرٍ ؛ فِی أَعْوَرَ فَقَأَ عَیْنَ رَجُلٍ ، فَقَالَ : الْعَیْنُ بِالْعَیْنِ۔","","Musannaf Ibn Abi Shaybah 27578","","","كتاب الديات"
"27579","(۲۷۵۷۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ فِی الأَعْوَرِ إِذَا فَقَأَ عَیْنَ إِنْسَانٍ ، فُقِئَتْ عَیْنُہُ۔","","Musannaf Ibn Abi Shaybah 27579","","","كتاب الديات"
"27580","(۲۷۵۸۰) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، قَالَ : الْعَیْنُ بِالْعَیْنِ۔","","Musannaf Ibn Abi Shaybah 27580","","","كتاب الديات"
"27581","(۲۷۵۸۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَن زَیْدٍ ، (ح) وَعَنْ حَجَّاجٍ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ (ح) وَعَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا اسْوَدَّتِ السِّنُّ تَمَّ عَقْلُہَا۔","","Musannaf Ibn Abi Shaybah 27581","","","كتاب الديات"
"27582","(۲۷۵۸۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَن زَیْدٍ ، (ح) وَعَنْ حَجَّاجٍ ، عَنْ حُصَیْنٍ الْحَارِثِیِّ ، عَنِ الشَّعْبِیِّ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ (ح) وَعَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 27582","","","كتاب الديات"
"27583","(۲۷۵۸۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : إِذَا اسْوَدَّتِ السِّنُّ فَعَقْلُہَا تَامٌّ۔","","Musannaf Ibn Abi Shaybah 27583","","","كتاب الديات"
"27584","(۲۷۵۸۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : إِذَا اسْوَدَّتْ فَعَقْلُہَا تَامٌّ۔","","Musannaf Ibn Abi Shaybah 27584","","","كتاب الديات"
"27585","(۲۷۵۸۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، عَنْ شُرَیْحٍ ؛ أَنَّہُ کَانَ إِذَا اسْوَدَّتِ السِّنُّ قَضَی فِیہَا بِدِیَتِہَا۔","","Musannaf Ibn Abi Shaybah 27585","","","كتاب الديات"
"27586","(۲۷۵۸۶) حَدَّثَنَا أَبُو عَاصِمٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ قَالَ : فِی السِّنِّ إِذَا اسْوَدَّتْ ، أَوْ تَحَرَّکَتْ ، أَوْ رَجَفَتْ ، فَہُوَ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 27586","","","كتاب الديات"
"27587","(۲۷۵۸۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَن حَنْظَلَۃَ ، عَنِ الْقَاسِمِ ؛ فِی السِّنِّ تَرْجُفُ ، قَالَ : عَقْلُہَا تَامٌّ۔","","Musannaf Ibn Abi Shaybah 27587","","","كتاب الديات"
"27588","(۲۷۵۸۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا اسْوَدَّتِ السِّنُّ ، أَوِ اصْفَرَّتْ فَفِیہَا دِیَتُہَا۔","","Musannaf Ibn Abi Shaybah 27588","","","كتاب الديات"
"27589","(۲۷۵۸۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ لَیْثٍ ، عَنِ الزُّہْرِیِّ قَالَ : إِذَا اسْوَدَّتِ السِّنُّ ، فَقَدْ تَمَّ عَقْلُہَا۔","","Musannaf Ibn Abi Shaybah 27589","","","كتاب الديات"
"27590","(۲۷۵۹۰) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَن مَنْصُورٍ، عَنْ إِبْرَاہِیمَ؛ فِی السِّنِّ یُسْتَأْنَی بِہَا، فَإِنَ اسْوَدَّتْ فَالْعَقْلُ تَامٌّ۔","","Musannaf Ibn Abi Shaybah 27590","","","كتاب الديات"
"27591","(۲۷۵۹۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : یُتَرَبَّصُ بِہَا حَوْلاً۔","Da'if","Musannaf Ibn Abi Shaybah 27591","","","كتاب الديات"
"27592","(۲۷۵۹۲) حَدَّثَنَا عَبَّادٌ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَنْ زَیْدٍ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 27592","","","كتاب الديات"
"27593","(۲۷۵۹۳) حَدَّثَنَا عَبَّادٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 27593","","","كتاب الديات"
"27594","(۲۷۵۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : فِی السِّنُّ یُسْتَأْنَی بِہَا سَنَۃً۔","","Musannaf Ibn Abi Shaybah 27594","","","كتاب الديات"
"27595","(۲۷۵۹۵) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ، عَن حَسَنٍ، عَن فِرَاسٍ، عَنِ الشَّعْبِیِّ؛ فِی السِّنِّ، قَالَ: یُتَرَبَّصُ بِہَا سَنَۃً۔","","Musannaf Ibn Abi Shaybah 27595","","","كتاب الديات"
"27596","(۲۷۵۹۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، عَنْ شُرَیْحٍ ، قَالَ : إِذَا کُسِرَتِ السِّنُّ أَجَّلَہُ سَنَۃً۔","","Musannaf Ibn Abi Shaybah 27596","","","كتاب الديات"
"27597","(۲۷۵۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : یُنْتَظَرُ بِہَا سَنَۃً ، فَإِنِ اسْوَدَّتْ ، أَوِ اصْفَرَّتْ فَفِیہَا الْعَقْلُ۔","","Musannaf Ibn Abi Shaybah 27597","","","كتاب الديات"
"27598","(۲۷۵۹۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ؛ فِی السِّنِّ إِذَا کُسِرَ بَعْضُہَا ، أُعْطَی صَاحِبُہَا بِحِسَابِ مَا نَقَصَ مِنْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 27598","","","كتاب الديات"
"27599","(۲۷۵۹۹) حَدَّثَنَا عَبَّادٌ، عَنْ حَجَّاجٍ، عَنْ مَکْحُولٍ، عَن زَیْدٍ (ح) وَعَنْ حَجَّاجٍ، عَنِ الْحَکَمِ، عَنْ إِبْرَاہِیمَ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 27599","","","كتاب الديات"
"27600","(۲۷۶۰۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ حَجَّاجٍ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، (ح) وَعَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَنْ زَیْدٍ ، (ح) وَعَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ؛ مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 27600","","","كتاب الديات"
"27601","(۲۷۶۰۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : الأَنْفُ وَالأُذُنُ بِمَنْزِلَۃِ السِّنِّ ، مَا نَقَصَ مِنْہُ فَبِحِسَابٍ۔","","Musannaf Ibn Abi Shaybah 27601","","","كتاب الديات"
"27602","(۲۷۶۰۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ؛ فِی السِّنِّ خَمْسٌ مِنَ الإِبِلِ ، فَمَا کُسِرَ مِنْہَا إِذَا لَمْ یَسْوَدَّ فَبِحِسَابٍ۔","","Musannaf Ibn Abi Shaybah 27602","","","كتاب الديات"
"27603","(۲۷۶۰۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، وَأَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، عَنْ شُرَیْحٍ ؛ أَنَّہُ کَانَ یَجْعَلُ فِیہَا قَدْرَ مَا نَقَصَ مِنْہَا۔","","Musannaf Ibn Abi Shaybah 27603","","","كتاب الديات"
"27604","(۲۷۶۰۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : مَا کُسِرَ مِنْہَا إِذَا لَمْ یَسْوَدَّ فَبِحِسَابِ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 27604","","","كتاب الديات"
"27605","(۲۷۶۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ فِی السِّنِّ إِذَا اسْوَدَّ بَعْضُہَا فَبِحِسَابِ مَنْزِلَۃِ الْکَسْرِ۔","","Musannaf Ibn Abi Shaybah 27605","","","كتاب الديات"
"27606","(۲۷۶۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : إِنْ کُسرَ مِنْہَا نِصْفٌ ، أَوْ ثُلُثٌ وَہِیَ بَیْضَائُ، فَبِحِسَابِ مَا کُسرَ مِنْہَا۔","","Musannaf Ibn Abi Shaybah 27606","","","كتاب الديات"
"27607","(۲۷۶۰۷) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، وَالشَّعْبِیِّ ، وَالْحَکَمِ ، وَحَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی السِّنِّ السَّوْدَائِ إِذَا أُصِیبَتْ فَفِیہَا حُکُومَۃُ ذَوِیْ عَدْلٍ۔","","Musannaf Ibn Abi Shaybah 27607","","","كتاب الديات"
"27608","(۲۷۶۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : فِی السِّنِّ السَّوْدَائِ حُکُومَۃٌ۔","","Musannaf Ibn Abi Shaybah 27608","","","كتاب الديات"
"27609","(۲۷۶۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : فِیہَا ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27609","","","كتاب الديات"
"27610","(۲۷۶۱۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : فِیہَا ثُلُثُ دِیَتِہَا۔","","Musannaf Ibn Abi Shaybah 27610","","","كتاب الديات"
"27611","(۲۷۶۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ یَحْیَی بْنِ یَعْمُرَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : فِیہَا ثُلُثُ الدِّیَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 27611","","","كتاب الديات"
"27612","(۲۷۶۱۲) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ قَتَادَۃَ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ عُمَرَ ؛ فِی السِّنِّ السَّوْدَائِ ثُلُثُ دِیَتِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 27612","","","كتاب الديات"
"27613","(۲۷۶۱۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عَبْدِ اللہِ بْنِ بُرَیْدَۃَ ، عَنْ یَحْیَی بْنِ یَعْمُرَ، عَنِ ابْنِ عَبَّاسٍ، عَنْ عُمَرَ بْنِ الْخَطَّابِ، قَالَ: فِی السِّنِّ السَّوْدَائِ إِذَا نُزِعَتْ وَکَانَتْ ثَابِتَۃً ثُلُثُ دِیَتِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 27613","","","كتاب الديات"
"27614","(۲۷۶۱۴) حَدَّثَنَا حَفْصٌ ، وَعَبْدُ الرَّحِیمِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَن بُکَیْر بْنِ عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَن سُلَیْمَانَ بْنِ یَسَارٍ ، عَن زَیْدِ بْنِ ثَابِتٍ ؛ أَنَّہُ قضَی فِی الْعَیْنِ الْقَائِمَۃِ إِذَا طُفِئَتْ : مِئَۃَ دِینَارٍ۔","Sahih","Musannaf Ibn Abi Shaybah 27614","","","كتاب الديات"
"27615","(۲۷۶۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : فِیہَا ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27615","","","كتاب الديات"
"27616","(۲۷۶۱۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : فِیہَا ثُلُثُ دِیَتِہَا۔","","Musannaf Ibn Abi Shaybah 27616","","","كتاب الديات"
"27617","(۲۷۶۱۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ قُسَیْطً ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ قَضَی فِی عَیْنٍ قَائِمَۃٍ بُخِصَتْ بِمِئَۃِ دِینَارٍ۔","","Musannaf Ibn Abi Shaybah 27617","","","كتاب الديات"
"27618","(۲۷۶۱۸) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، وَالشَّعْبِیِّ (ح) وَعَنِ الْحَکَمِ ، وَحَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛ قَالُوا: فِی الْعَیْنِ الْقَائِمَۃِ حُکْمُ ذَوِی عَدْلٍ۔","","Musannaf Ibn Abi Shaybah 27618","","","كتاب الديات"
"27619","(۲۷۶۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہِلاَلٍ ، عَن قَتَادَۃَ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ یَحْیَی بْنِ یَعْمُرَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : فِی الْعَیْنِ الْقَائِمَۃِ إِذَا بُخِصَتْ ثُلُثُ دِیَتِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 27619","","","كتاب الديات"
"27620","(۲۷۶۲۰) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَن مَسْرُوقٍ ، قَالَ : فِی الْعَیْنِ الْعَوْرَائِ حُکْمٌ۔","","Musannaf Ibn Abi Shaybah 27620","","","كتاب الديات"
"27621","(۲۷۶۲۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عَبْدِ اللہِ بْنِ بُرَیْدَۃَ ، عَنْ یَحْیَی بْنِ یَعْمُرَ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ عُمَرَ ؛ فِی الْعَیْنِ الْعَوْرَائِ إِذَا بُخِصَتْ وَکَانَتْ قَائِمَۃً : ثُلُثُ دِیَتِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 27621","","","كتاب الديات"
"27622","(۲۷۶۲۲) حَدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَن حَکِیمِ بْنِ حَکِیمٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، قَالَ : کَانَ فِیمَا وَضَعَ أَبُو بَکْرٍ ، وَعُمَرُ مِنَ الْقَضِیَّۃِ : أَنَّ الرَّجُلَ إِذَا بَسَطَہَا صَاحِبُہَا فَلَمْ یَقْبِضْہَا ، أَوْ قَبَضَہَا فَلَمْ یَبْسُطْہَا ، أَوْ قُلِّصَتْ عَنِ الأَرْضِ فَلَمْ تَبْلُغْہَا ، فَمَا نَقَصَ فَبِحِسَابٍ۔","","Musannaf Ibn Abi Shaybah 27622","","","كتاب الديات"
"27623","(۲۷۶۲۳) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمٍ ، عَنْ عَلِیٍّ ، قَالَ : فِی الرِّجْلِ نِصْفُ الدِّیَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 27623","","","كتاب الديات"
"27624","(۲۷۶۲۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : فِی الرِّجْلِ نِصْفُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27624","","","كتاب الديات"
"27625","(۲۷۶۲۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، (ح) وَعَنِ الْحَکَمِ ، وَحَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالاَ : فِی الْیَدِ تُصَابُ فَتُشَلُّ ، أَوِ الرِّجْلِ ، أَوِ الْعَیْنِ إِذَا ذَہَبَ بَصَرُہَا وَہِیَ قَائِمَۃٌ ، فَقَدْ تَمَّ عَقْلُہَا۔","","Musannaf Ibn Abi Shaybah 27625","","","كتاب الديات"
"27626","(۲۷۶۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَن عِکْرِمَۃَ بْنِ خَالِدٍ ، عَنْ رَجُلٍ مِنْ آلِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فِی الرِّجْلِ خَمْسُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 27626","","","كتاب الديات"
"27627","(۲۷۶۲۷) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ أَشْعَثَ، عَنِ الشَّعْبِیِّ، عَنْ عَبْدِ اللہِ، قَالَ: فِی الرِّجْلِ خَمْسُونَ مِنَ الإِبِلِ أَخْمَاسًا۔","Da'if","Musannaf Ibn Abi Shaybah 27627","","","كتاب الديات"
"27628","(۲۷۶۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عنْ حُمَیْدِ بْنِ ہِلاَلٍ ، قَالَ : فِی کِتَابٍ کَتَبَہُ مَرْوَانُ ، عَن زَیْدِ بْنِ ثَابِتٍ : إِذَا قَزَلَتِ الرِّجْلُ ، فَفِیہَا نِصْفُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27628","","","كتاب الديات"
"27629","(۲۷۶۲۹) حَدَّثَنَا أَبُو الأَحْوَصِ، عَنْ أَبِی إِسْحَاقَ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ، عَنْ عَلِیٍّ ، قَالَ: فِی الْجَائِفَۃِ ثُلُثُ الدِّیَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 27629","","","كتاب الديات"
"27630","(۲۷۶۳۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : فِی الْجَائِفَۃِ ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27630","","","كتاب الديات"
"27631","(۲۷۶۳۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ ، قَالَ : فِی الْجَائِفَۃِ ثُلُثُ الدِّیَۃِ أَخْمَاسًا۔","Da'if","Musannaf Ibn Abi Shaybah 27631","","","كتاب الديات"
"27632","(۲۷۶۳۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : فِی الْجَائِفَۃِ ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27632","","","كتاب الديات"
"27633","(۲۷۶۳۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَن مَکْحُولٍ ، (ح) وَعَنْ أَشْعَثَ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی الْجَائِفَۃِ بِثُلُث الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27633","","","كتاب الديات"
"27634","(۲۷۶۳۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : الْجَائِفَۃُ فِی الْبَطْنِ وَالْفَخْذِ ، دِیَتُہَا ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27634","","","كتاب الديات"
"27635","(۲۷۶۳۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَان ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ قَوْمًا کَانُوا یَرْمُونَ ، فَرَمَی رَجُلٌ مِنْہُمْ بِسَہْمٍ خَطَأً ، فَأَصَابَ بَطْنَ رَجُلٍ ، فَأَنْفَذَہُ إِلَی ظَہْرِہِ ، فَدُووِیَ فَبَرَأَ ، فَرُفِعَ إِلَی أَبِی بَکْرٍ فَقَضَی فِیہِ بِجَائِفَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 27635","","","كتاب الديات"
"27636","(۲۷۶۳۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَنْ زَیْدٍ ؛ فِی النَّافِذَۃِ فِی الْجَوْفِ ثُلُثُ الدِّیَۃِ ، وَفِی الأُخْرَی مِئَۃُ دِینَارٍ۔","","Musannaf Ibn Abi Shaybah 27636","","","كتاب الديات"
"27637","(۲۷۶۳۷) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَن بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : الْجَائِفَۃُ فِی الْجَوْفِ حَتَّی یَخْرُجَ مِنَ الْجَانِبِ الآخَرِ جَائِفَتَانِ۔","","Musannaf Ibn Abi Shaybah 27637","","","كتاب الديات"
"27638","(۲۷۶۳۸) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ، عَنْ عَمْرٍو، عَنِ الْحَسَنِ؛ فِی رَجُلٍ رَمَی رَجُلاً فَأَنْفَذَہُ قَالَ : فِیہِ جَائِفَتَانِ۔","","Musannaf Ibn Abi Shaybah 27638","","","كتاب الديات"
"27639","(۲۷۶۳۹) حَدَّثَنَا أَبُو خَالِدٍ ، عَن عُبَیْدَۃَ ، عَنْ إِبْرَاہِیمَ ، عَنْ عُمَرَ ، قَالَ : فِی الْجَائِفَۃِ ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27639","","","كتاب الديات"
"27640","(۲۷۶۴۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَن زَیْدِ بْنِ ثَابِتٍ ، قَالَ : فِی کُلِّ نَافِذَۃٍ فِی عُضْوٍ مِنَ الْیَدِ وَالرِّجْلِ ، مِئَۃ دِینَارٍ۔","","Musannaf Ibn Abi Shaybah 27640","","","كتاب الديات"
"27641","(۲۷۶۴۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : الْجَائِفَۃُ فِی الْفَخْذِ دِیَتُہَا ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27641","","","كتاب الديات"
"27642","(۲۷۶۴۲) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : کُلُّ نَافِذَۃٍ فِی عُضْوٍ فَدِیَتُہَا ثُلُثُ دِیَۃِ ذَلِکَ الْعُضْوِ۔","","Musannaf Ibn Abi Shaybah 27642","","","كتاب الديات"
"27643","(۲۷۶۴۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، قَالَ : لِکُلِّ عَظْمٍ جَائِفَۃٌ ، فَکُلُّ عَظْمٍ أُجِیفَ فَجَائِفَتُہُ مِنْ حِسَابِ ذَلِکَ الْعَظْمِ۔","","Musannaf Ibn Abi Shaybah 27643","","","كتاب الديات"
"27644","(۲۷۶۴۴) حَدَّثَنَا إِسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَنِ الْوَلِیدِ بْنِ أَبِی ہِشَامٍ ، عَنْ أَبِی بَکْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ، قَالَ : قَالَ عُمَرُ : کُلُّ رَمْیَۃٍ نَافِذَۃٍ فِی عُضْوٍ ، فَفِیہَا ثُلُثُ دِیَۃِ ذَلِکَ الْعُضْوِ۔","","Musannaf Ibn Abi Shaybah 27644","","","كتاب الديات"
"27645","(۲۷۶۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَن عِکْرِمَۃَ بْنِ خَالِدٍ ، عَنْ رَجُلٍ مِنْ آلِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فِی الذَّکَرِ الدِّیَۃُ۔ (عبدالرزاق ۱۷۶۳۶)","Da'if","Musannaf Ibn Abi Shaybah 27645","","","كتاب الديات"
"27646","(۲۷۶۴۶) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : فِی الذَّکَرِ الدِّیَۃُ۔","Hasan","Musannaf Ibn Abi Shaybah 27646","","","كتاب الديات"
"27647","(۲۷۶۴۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ ، قَالَ : فِی الذَّکَرِ الدِّیَۃُ أَخْمَاسًا۔","Da'if","Musannaf Ibn Abi Shaybah 27647","","","كتاب الديات"
"27648","(۲۷۶۴۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : فِی الذَّکَرِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27648","","","كتاب الديات"
"27649","(۲۷۶۴۹) حَدَّثَنَا أَبُو خَالِدٍ ، عَن عُبَیْدَۃَ ، عَنْ إِبْرَاہِیمَ ، عَنْ عُمَرَ ، قَالَ : فِی الذَّکَرِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27649","","","كتاب الديات"
"27650","(۲۷۶۵۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : فِی الذَّکَرِ الدِّیَۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 27650","","","كتاب الديات"
"27651","(۲۷۶۵۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی الذَّکَرِ الدِّیَۃَ۔ (ابوداؤد ۲۶۵)","","Musannaf Ibn Abi Shaybah 27651","","","كتاب الديات"
"27652","(۲۷۶۵۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ لَہُ : اسْتُؤْصِلَ الذَّکَرُ ؟ قَالَ : الدِّیَۃُ ، قُلْتُ : أَرَأَیْتَ إِنْ أُصِیبَتِ الْحَشَفَۃُ ، ثُمَّ أُصِیبَ شَیْئٌ مِمَّا بَقِیَ ؟ قَالَ : جُرْحٌ۔","","Musannaf Ibn Abi Shaybah 27652","","","كتاب الديات"
"27653","(۲۷۶۵۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ، عَنِ ابْنِ جُرَیْجٍ، قَالَ: أَخْبَرَنِی ابْنُ أَبِی نَجِیحٍ، عَن مُجَاہِدٍ، قَالَ: فِی الذَّکَرِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27653","","","كتاب الديات"
"27654","(۲۷۶۵۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، قَالَ : قضَی أَبُو بَکْرٍ فِی ذَکَرِ الرَّجُلِ بِدِیَتِہِ ، مِئَۃٍ مِنَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27654","","","كتاب الديات"
"27655","(۲۷۶۵۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَان ، عَنْ أَشْعَثَ ، عَنِ الزُّہْرِیِّ ، قَالَ : قضَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الذَّکَرِ إِذَا اسْتُؤْصِلَ ، أَوْ قُطِعَتْ حَشَفَتُہُ : الدِّیَۃُ کَامِلَۃٌ مِئَۃٌ مِنَ الإِبِلِ۔","Da'if","Musannaf Ibn Abi Shaybah 27655","","","كتاب الديات"
"27656","(۲۷۶۵۶) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنْ أَشْعَثَ ، عَنْ عَامِرٍ ، عَنْ عَلِیٍّ ، وَعَبْدِ اللہِ ، قَالاَ : فِی الْحَشَفَۃِ إِذَا قُطِعَتِ الدِّیَۃُ ، فَمَا نَقَصَ مِنْہَا فَبِحِسَابٍ۔","Da'if","Musannaf Ibn Abi Shaybah 27656","","","كتاب الديات"
"27657","(۲۷۶۵۷) حَدَّثَنَا وَکِیعٌ ، عَن زَکَرِیَّا ، أَوْ إِسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : فِی الْحَشَفَۃِ الدِّیَۃُ۔","Hasan","Musannaf Ibn Abi Shaybah 27657","","","كتاب الديات"
"27658","(۲۷۶۵۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : فِی الْحَشَفَۃِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27658","","","كتاب الديات"
"27659","(۲۷۶۵۹) حَدَّثَنَا وَکِیعٌ ، عَن سَلاَّمٍ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : فِی الْحَشَفَۃِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27659","","","كتاب الديات"
"27660","(۲۷۶۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ قَالَ : فِی الْحَشَفَۃِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27660","","","كتاب الديات"
"27661","(۲۷۶۶۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی ابْنُ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، قَالَ : فِی الْحَشَفَۃِ وَحْدَہَا الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27661","","","كتاب الديات"
"27662","(۲۷۶۶۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : أَرَأَیْتَ إِنْ أُصِیبَتِ الْحَشَفَۃُ ؟ قَالَ : الدِّیَۃُ ، قَالَ : قُلْتُ لِعَطَائٍ : أَثَبْتٌ ؟ قَالَ : قَدْ قَالُوا ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 27662","","","كتاب الديات"
"27663","(۲۷۶۶۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : فِی الْحَشَفَۃِ الدِّیَۃُ۔","Hasan","Musannaf Ibn Abi Shaybah 27663","","","كتاب الديات"
"27664","(۲۷۶۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَن مَسْرُوقٍ ؛ فِی الْیَدِ الشَّلاَّئِ إِذَا قُطِعَتْ حُکْمٌ ، وَفِی الضِّرْسِ حُکْمٌ ، یَعْنِی الْمَأْکُولَ۔","","Musannaf Ibn Abi Shaybah 27664","","","كتاب الديات"
"27665","(۲۷۶۶۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا ہِشَامُ الدَّسْتَوَائِیُّ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : فِی الْیَدِ الشَّلاَّئِ إِذَا قُطِعَتْ ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27665","","","كتاب الديات"
"27666","(۲۷۶۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : فِی الْیَدِ الشَّلاَّئِ إِذَا قُطِعَتْ ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27666","","","كتاب الديات"
"27667","(۲۷۶۶۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سَعِیدِ بْنِ أَبِی عُرْوَۃَ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ یَحْیَی بْنِ یَعْمُرَ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ ؛ فِی الْیَدِ الشَّلاَّئِ إِذَا قُطِعَتْ ثُلُثُ الدِّیَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 27667","","","كتاب الديات"
"27668","(۲۷۶۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ یَحْیَی بْنِ یَعْمُرَ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی الْیَدِ الشَّلاَّئِ إِذَا قُطِعَتْ ثُلُثُ الدِّیَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 27668","","","كتاب الديات"
"27669","(۲۷۶۶۹) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، وَالشَّعْبِیِّ ، وَالْحَکَمِ ، وَحَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی الْیَدِ الشَّلاَّئِ ، قَالُوا : فِیہَا حُکْمُ ذَوِی عَدْلٍ۔","","Musannaf Ibn Abi Shaybah 27669","","","كتاب الديات"
"27670","(۲۷۶۷۰) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ : إِذَا کُسِرَتِ الْیَدُ ، أَوِ الرِّجْلُ ، ثُمَّ بَرَأَتْ وَلَمْ یَنْقُصْ مِنْہَا شَیْئٌ : أَرْشُہَا مِئَۃٌ وَثَمَانُونَ دِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 27670","","","كتاب الديات"
"27671","(۲۷۶۷۱) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنِ الْقَعْقَاعِ بْنِ یَزِیدَ، عَنْ إِبْرَاہِیمَ؛ فِی الْیَدِ، أَوِ الرِّجْلِ إِذَا کُسِرَتْ صُلْح۔","","Musannaf Ibn Abi Shaybah 27671","","","كتاب الديات"
"27672","(۲۷۶۷۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنْ عَبْدِ اللہِ بْنِ ذَکْوَانَ ؛ أَنَّ عُمَرَ قَضَی فِی رَجُلٍ کُسِرَتْ سَاقُہُ فَجُبِرَتْ وَاسْتَقَامَتْ ، فَقَضَی فِیہَا بِعِشْرِینَ دِینَارًا۔n قَالَ: قیلَ لَہُ : إِنَّہَا وَہَنَتْ۔","Da'if","Musannaf Ibn Abi Shaybah 27672","","","كتاب الديات"
"27673","(۲۷۶۷۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ عَبْدِ الرَّحْمَنِ ، عن ابن سیرین ، عَنْ شُرَیْحٍ ؛فِی رَجُلٍ کَسَرَ یَدَ رَجُلٍ فَجُبِرَتْ ، فَقَالَ شُرَیْحٌ : عَلَی الْکَاسِرِ أَجْرُ الْجَابِرِ ، أَمَا یَحْمَدُ اللَّہَ حَیْثُ رَدَّ عَلَیْہِ یَدَہُ۔","","Musannaf Ibn Abi Shaybah 27673","","","كتاب الديات"
"27674","(۲۷۶۷۴) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا شُعْبَۃُ، عَنْ أَبِی بِشْرٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، قَالَ: فِی الأَعْضَائِ کُلِّہَا حُکُومَۃٌ۔","","Musannaf Ibn Abi Shaybah 27674","","","كتاب الديات"
"27675","(۲۷۶۷۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، عَن زَیْدِ بْنِ ثَابِتٍ ؛ فِی السَّاقِ تُکْسَرُ خَمْسُونَ دِینَارًا ، وَإِذَا بَرَأَتْ عَلَی عَثْمٍ فَفِیہَا خَمْسُونَ دِینَارًا ، وَفِی الْعَثْمِ مَا فِیہِ۔","Da'if","Musannaf Ibn Abi Shaybah 27675","","","كتاب الديات"
"27676","(۲۷۶۷۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ عَطَائٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَن سُلَیْمَانَ بْنِ یَسَارٍ ، قَالَ : فِی الذِّرَاعِ ، وَالسَّاقِ ، وَالْعَضُدِ ، وَالْفَخْذِ إِذَا کُسِرَتْ ، ثُمَّ جُبِرَتْ : قَلُوصَانِ ، قَلُوصَانِ۔","","Musannaf Ibn Abi Shaybah 27676","","","كتاب الديات"
"27677","(۲۷۶۷۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قُلْتُ لَہُ : کُسرَتِ الْیَدُ ، أَوِ الرِّجْلُ ، أَوِ التَّرْقُوَۃُ فَجُبِرَتْ فَاسْتَوَتْ ، قَالَ : فِی ذَلِکَ شَیْئٌ ، وَمَا بَلَغَنِی مَا ہُوَ۔","","Musannaf Ibn Abi Shaybah 27677","","","كتاب الديات"
"27678","(۲۷۶۷۸) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ أَبِی حُرَّۃَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ کُسِرَتْ یَدُہُ ، قَالَ : یُعَوَّضُ مِنْ یَدِہِ ۔ قَالَ : وَقَالَ مُحَمَّدٌ : قَالَ شُرَیْحٌ : یُعْطَی أَجْرَ الطَّبِیبِ۔","","Musannaf Ibn Abi Shaybah 27678","","","كتاب الديات"
"27679","(۲۷۶۷۹) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ؛ فِی الَّذِی یُکْسَرُ ذِرَاعُہُ ، ثُمَّ یُجْبَرُ، قَالَ: یُرْضَخُ لَہُ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 27679","","","كتاب الديات"
"27680","(۲۷۶۸۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَن زَیْدِ بْنِ ثَابِتٍ ؛ أَنَّہُ قَضَی فِی الظُّفْرِ إِذَا سَقَطَ فَلَمْ یَنْبُتْ ، أَوْ نَبَتَ مُتَغَیِّرًا : عَشَرَۃَ دَنَانِیرَ ، وَإِنْ خَرَجَ أَبْیَضَ فَفِیہِ خَمْسَ دَنَانِیرَ۔","","Musannaf Ibn Abi Shaybah 27680","","","كتاب الديات"
"27681","(۲۷۶۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَن خَالِدِ الْحَذَّائِ ، عَنْ عَمْرِو بْنِ ہَرِم ، عَنْ جَابِرِ بْنِ زَیْدٍ ، عَنِ ابْنِ عَبَّاسٍ؛ فِی الظُّفْرِ إِذَا أَعْوَرَ خُمْسُ دِیَۃِ الإِصْبَعِ۔","Sahih","Musannaf Ibn Abi Shaybah 27681","","","كتاب الديات"
"27682","(۲۷۶۸۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ بْنِ سَوَّارٍ ، عَنْ عَبْدِ اللہِ بْنِ ذَکْوَانَ ، عَنِ ابْنِ عَبَّاسٍ ؛ قَضَی فِی ظُفْرِ رَجُلٍ أَصَابَہُ رَجُلٌ فَأَعْوَرَ ، بِعُشْرِ دِیَۃِ الإِصْبَعِ۔","Da'if","Musannaf Ibn Abi Shaybah 27682","","","كتاب الديات"
"27683","(۲۷۶۸۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالَ : فِی الظُّفْرِ إِذَا نَبَتَ ، فَإِنْ کَانَ فِیہِ عَیْبٌ فَبَعِیرٌ۔","","Musannaf Ibn Abi Shaybah 27683","","","كتاب الديات"
"27684","(۲۷۶۸۴) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ قَضَی فِی الظُّفْرِ إِذَا اعْرَنْجَمَ وَفَسَدَ بِقُلُوصٍ۔","","Musannaf Ibn Abi Shaybah 27684","","","كتاب الديات"
"27685","(۲۷۶۸۵) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ الکَرِیمِ ؛ فِی الظُّفْرِ إِذَا لَمْ یَنْبُتْ فَفِیہِ نَاقَتَانِ ، فَإِنْ نَبَتَتْ عَمْیَائَ لَیْسَ لَہَا وَبِیصٌ ، فَفِیہَا نَاقَۃٌ۔","","Musannaf Ibn Abi Shaybah 27685","","","كتاب الديات"
"27686","(۲۷۶۸۶) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ؛ فِی الظُّفْرِ إِذَا لَمْ یَنْبُتْ، فَفِیہِ بِنْتُ مَخَاضٍ ، فَإِنْ لَمْ تُوجَدْ فَفِیہِ بِنْتُ لَبُونٍ۔","","Musannaf Ibn Abi Shaybah 27686","","","كتاب الديات"
"27687","(۲۷۶۸۷) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سَأَلْتُ عَطَائً عَنِ الظُّفْرِ إِذَا لَمْ یَنْبُتْ ؟ فَقَالَ : قَدْ سَمِعْت فِیہِ بِشَیْئٍ ، وَلاَ أَدْرِی مَا ہُوَ۔","","Musannaf Ibn Abi Shaybah 27687","","","كتاب الديات"
"27688","(۲۷۶۸۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عَبْدُ الْعَزِیزِ بْنُ عُمَرَ ؛ أَنَّ أُمَرَائَ الأَجْنَادِ ، وَأَہْلَ الرَّأْیِ اجْتَمَعُوا لِعُمَرَ بْنِ عَبْدِ الْعَزِیزِ فِی الظُّفْرِ إِذَا نُزِعَ فَعَنِتَ ، أَوْ سَقَطَ، أَوِ اسْوَدَّ: الْعُشْرُ مِنْ دِیَۃِ الإِصْبَعِ، عَشَرَۃُ دَنَانِیرَ۔","","Musannaf Ibn Abi Shaybah 27688","","","كتاب الديات"
"27689","(۲۷۶۸۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَن خَالِدٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی الظُّفْرِ إِذَا أَعْوَرَ خُمْسُ دِیَۃِ الإِصْبَعِ۔","Sahih","Musannaf Ibn Abi Shaybah 27689","","","كتاب الديات"
"27690","(۲۷۶۹۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حُمَیْدٍ ، عَنْ أَنَسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ بِالْقِصَاصِ فِی سِنٍّ ، وَقَالَ : کِتَابَ اللہِ الْقِصَاصَ۔ (بخاری ۶۸۹۴۔ ابوداؤد ۴۵۸۵)","Hasan","Musannaf Ibn Abi Shaybah 27690","","","كتاب الديات"
"27691","(۲۷۶۹۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَزْہَرَ ، عَن مُحَارِبِ بْنِ دِثار ، قَالَ : جَائَ رَجُلاَنِ إِلَی شُرَیْحٍ قَدْ کَسَرَ ہَذَا ضِرْسَ ہَذَا ، وَہَذَا ضِرْسَ ہَذَا ، قَالَ : ہَذِہِ ثَنِیَّۃٌ بِضِرْسٍ ، قُومَا۔","","Musannaf Ibn Abi Shaybah 27691","","","كتاب الديات"
"27692","(۲۷۶۹۲) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، وَالْحَسَنِ ، قَالاَ : لَیْسَ فِی الْعِظَامِ قِصَاصٌ مَا خَلاَ السِّنِّ ، أَوِ الرَّأْسِ۔","","Musannaf Ibn Abi Shaybah 27692","","","كتاب الديات"
"27693","(۲۷۶۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : یُقَادُ مِنَ السِّنِّ۔","","Musannaf Ibn Abi Shaybah 27693","","","كتاب الديات"
"27694","(۲۷۶۹۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : الْعَیْنُ یُقَادُ مِنْہَا ؟ قَالَ : نَعَمْ ، وَالسِّنُّ۔","","Musannaf Ibn Abi Shaybah 27694","","","كتاب الديات"
"27695","(۲۷۶۹۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن زَیْدِ بْنِ أَسْلَمَ ، [corrupt]َن مُسْلِمِ بْنِ جُنْدُبٍ ، عَنْ أَسْلَمَ مَوْلَی عُمَرَ ، قَالَ : سَمِعْتُ عُمَرَ عَلَی الْمِنْبَرِ یَقُولُ : فِی الضِّلَعِ جَمَلٌ۔","Hasan","Musannaf Ibn Abi Shaybah 27695","","","كتاب الديات"
"27696","(۲۷۶۹۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الضِّلَعِ إِذَا کُسِرَتْ بَعِیرَانِ ، فَإِذَا انْجَبَرَتْ فَبَعِیرٌ۔","","Musannaf Ibn Abi Shaybah 27696","","","كتاب الديات"
"27697","(۲۷۶۹۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ حَجَّاجٍ، عَن دَاوُد بْنِ أَبِی عَاصِمٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ؛ فِی الضِّلَعِ بَعِیرٌ۔","","Musannaf Ibn Abi Shaybah 27697","","","كتاب الديات"
"27698","(۲۷۶۹۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، وَمَسْرُوقٍ ؛ أَنَّہُمَا قَالاَ : فِی الضِّلَعِ وَنَحْوِہَا إِذَا کُسِرَتْ فَجُبِرَتْ عَلَی غَیْرِ عَثْمٍ ، قَالاَ : فِیہِ أَجْرُ الطَّبِیبِ۔","","Musannaf Ibn Abi Shaybah 27698","","","كتاب الديات"
"27699","(۲۷۶۹۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، عَن زَیْدِ بْنِ ثَابِتٍ ، قَالَ : فِیہِ عَشَرَۃُ دَنَانِیرَ۔","Da'if","Musannaf Ibn Abi Shaybah 27699","","","كتاب الديات"
"27700","(۲۷۷۰۰) حَدَّثَنَا وَکِیعٌ، عَنْ أَبِیہِ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، عَنِ الْحَکَمِ، قَالَ: فِی الضِّلَعِ بَعِیرٌ، وَفِی الضِّرْسِ بَعِیرٌ۔","","Musannaf Ibn Abi Shaybah 27700","","","كتاب الديات"
"27701","(۲۷۷۰۱) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : فِی إِحْدَی الْبَیْضَتَیْنِ نِصْفُ الدِّیَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 27701","","","كتاب الديات"
"27702","(۲۷۷۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ :حَدَّثَنَا سُفْیَان ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِم ، عَنْ عَلِیٍّ ؛ مِثْلَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 27702","","","كتاب الديات"
"27703","(۲۷۷۰۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَن زَیْدِ بْنِ ثَابِتٍ (ح) وَعَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِم ، عَنْ عَلِیٍّ (ح) وَعَنْ حَجَّاجٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ بْنِ الزُّبَیْرِ (ح) وَعَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ؛ أَنَّہُمْ قَالُوا : الْبَیْضَتَانِ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 27703","","","كتاب الديات"
"27704","(۲۷۷۰۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی ابْنُ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، قَالَ : فِی الْبَیْضَتَیْنِ الدِّیَۃُ وَافِیَۃً ، خَمْسُونَ خَمْسُونَ۔","","Musannaf Ibn Abi Shaybah 27704","","","كتاب الديات"
"27705","(۲۷۷۰۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی ابْنُ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ؛ الْبَیْضَتَانِ سَوَائٌ ، خَمْسُونَ خَمْسُونَ ، وَلَمْ أَسْمَعْہُ مِنْ ثَبْتٍ۔","","Musannaf Ibn Abi Shaybah 27705","","","كتاب الديات"
"27706","(۲۷۷۰۶) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ لَہُ : الْبَیْضَتَانِ ؟ قَالَ : خَمْسُونَ خَمْسُونَ ، وَلَمْ أَسْمَعْہُ مِنْ ثَبْتٍ۔","","Musannaf Ibn Abi Shaybah 27706","","","كتاب الديات"
"27707","(۲۷۷۰۷) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَن مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : الْبَیْضَتَانِ سَوَائٌ۔","Da'if","Musannaf Ibn Abi Shaybah 27707","","","كتاب الديات"
"27708","(۲۷۷۰۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَن مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : الأُنْثَیَانِ سَوَائٌ۔","Da'if","Musannaf Ibn Abi Shaybah 27708","","","كتاب الديات"
"27709","(۲۷۷۰۹) حَدَّثَنَا إِسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن دَاوُد ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ: فِی الْبَیْضَۃِ الْیُسْرَی ثُلُثَا الدِّیَۃِ، وَفِی الْیُمْنَی الثُّلُثُ ، قُلْتُ : لِمَہْ ؟ قَالَ : لأَنَّ الْیُسْرَی إِذَا ذَہَبَتْ لَمْ یُولَدْ لَہُ ، وَإِذَا ذَہَبَتِ الْیُمْنَی وُلِدَ لَہُ۔","","Musannaf Ibn Abi Shaybah 27709","","","كتاب الديات"
"27710","(۲۷۷۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَن مَنْصُورٍ ، قَالَ : ذَکَرْتُ ذَلِکَ لإِبْرَاہِیمَ ، فَقَالَ : ہُمَا سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 27710","","","كتاب الديات"
"27711","(۲۷۷۱۱) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ جَابِرٍ، عَنِ الشَّعْبِیِّ، عَن مَسْرُوقٍ، قَالَ: فِی لِسَانِ الأَخْرَسِ حُکْمٌ۔","","Musannaf Ibn Abi Shaybah 27711","","","كتاب الديات"
"27712","(۲۷۷۱۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ، عَن حَمَّادٍ، عَنْ إِبْرَاہِیمَ؛ فِی لِسَانِ الأَخْرَسِ الدِّیَۃُ کَامِلَۃً۔","","Musannaf Ibn Abi Shaybah 27712","","","كتاب الديات"
"27713","(۲۷۷۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی حَنِیفَۃَ ، عَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی لِسَانِ الأَخْرَسِ حُکْمٌ ، وَفِی ذَکَرِ الْخَصِیِّ حُکْمٌ۔","","Musannaf Ibn Abi Shaybah 27713","","","كتاب الديات"
"27714","(۲۷۷۱۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ، عَنِ ابْنِ جُرَیْجٍ، عَنْ قَتَادَۃَ، قَالَ: فِی لِسَانِ الأَخْرَسِ الثُّلُثُ مِمَّا فِی لِسَانِ الصَّحِیحِ۔","","Musannaf Ibn Abi Shaybah 27714","","","كتاب الديات"
"27715","(۲۷۷۱۵) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنْ عَمْرو ، عَنِ الْحَسَن ، قَالَ : فِی لِسَانِ الأَخْرَسِ الدِّیَۃُ کَامِلَۃً۔","","Musannaf Ibn Abi Shaybah 27715","","","كتاب الديات"
"27716","(۲۷۷۱۶) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : فِی ذَکَرِ الَّذِی لاَ یَأْتِی النِّسَائَ ، مِثْلُ مَا فِی ذَکَرِ الَّذِی یَأْتِی النِّسَائَ ؟ قَالَ : نَعَمْ ، وَقَالَ لِی : أَرَأَیْتَ الَّذِی قَدْ ذَہَبَ ذَلِکَ مِنْہُ ، أَلَیْسَ یُوفَی نَذْرُہُ۔","","Musannaf Ibn Abi Shaybah 27716","","","كتاب الديات"
"27717","(۲۷۷۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عَبْدُ الْعَزِیزِ بْنُ عُمَرَ ؛ أَنَّ أُمَرَائَ الأَجْنَادِ ، وَأَہْلَ الرَّأْیِ مِنْہُمُ اجْتَمَعُوا لِعُمَرَ بْنِ عَبْدِالْعَزِیزِ فِی الْمَنْکِبِ إِذَا کُسِرَ ، ثُمَّ جُبِرَ فِی غَیْرِ عَثْمٍ فَفِیہِ أَرْبَعُونَ دِینَارًا۔","","Musannaf Ibn Abi Shaybah 27717","","","كتاب الديات"
"27718","(۲۷۷۱۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ، عَنِ ابْنِ جُرَیْجٍ، قَالَ: بَلَغَنِی عَنِ الشَّعْبِیِّ؛ فِی الْمَنْکِبِ إِذَا کُسِرَ أَرْبَعُونَ دِینَارًا۔","","Musannaf Ibn Abi Shaybah 27718","","","كتاب الديات"
"27719","(۲۷۷۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَزْہَرِ الْعَطَّارِ ، عَنْ أَبِی عَوْنٍ الثَّقَفِیِّ ، عَنْ شُرَیْحٍ ، قَالَ : فِی الْفَتْقِ ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27719","","","كتاب الديات"
"27720","(۲۷۷۲۰) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ، عَنْ قَتَادَۃَ، عَنْ أَبِی مِجْلَزٍ، قَالَ: فِی فَتْقِ الْمَثَانَۃِ ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27720","","","كتاب الديات"
"27721","(۲۷۷۲۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : بَلَغَنِی عَنِ الشَّعْبِیِّ ، قَالَ : فِی الْمَثَانَۃِ إِذَا خُرِقَتْ ، فَلَمْ یَسْتَمْسِکِ الْبَوْل ثُلُثُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27721","","","كتاب الديات"
"27722","(۲۷۷۲۲) حَدَّثَنَا أَبُو أُسَامَۃَ، قَالَ: حدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِیَادٍ، عَنْ حَجَّاجٍ، عَنْ مَکْحُولٍ، عَنْ زَیْدٍ؛ فِی الْفَتْقِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27722","","","كتاب الديات"
"27723","(۲۷۷۲۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنِ الزُّہْرِیِّ ، قَالَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الصُّلْبِ الدِّیَۃَ۔ (ابوداؤد ۲۶۳۔ بیہقی ۹۵)","Da'if","Musannaf Ibn Abi Shaybah 27723","","","كتاب الديات"
"27724","(۲۷۷۲۴) حَدَّثَنَا أَبُو خَالِدٍ ، وَأَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَنْ زَیْدٍ ، قَالَ : فِی الصُّلْبِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27724","","","كتاب الديات"
"27725","(۲۷۷۲۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : فِی الصُّلْبِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27725","","","كتاب الديات"
"27726","(۲۷۷۲۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : اتَّفَقَ أَہْلُ الْعِلْمِ أَنَّ فِی الصُّلْبِ الدِّیَۃَ۔","","Musannaf Ibn Abi Shaybah 27726","","","كتاب الديات"
"27727","(۲۷۷۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : فِی الصُّلْبِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27727","","","كتاب الديات"
"27728","(۲۷۷۲۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، قَالَ : قضَی أَبُو بَکْرٍ فِی صُلْبِ الرَّجُلِ إِذَا کُسِرَ ثُمَّ جُبِرَ بِالدِّیَۃِ کَامِلَۃً ، إِذَا کَانَ لاَ یُحْمَلُ لَہُ ، وَبِنِصْفِ الدِّیَۃِ إِذَا ک[corrupt]انَ یُحْمَلُ لَہُ۔","","Musannaf Ibn Abi Shaybah 27728","","","كتاب الديات"
"27729","(۲۷۷۲۹) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ، عَنِ ابْنِ جُرَیْجٍ، قَالَ: أَخْبَرَنِی ابْنُ أَبِی نَجِیحٍ، عَن مُجَاہِدٍ قَالَ: إِنْ أُصِیبَ الصُّلْبُ، أَوْ کُسِرَ فَجُبِرَ وَانْقَطَعَ مَنِیُّہُ ، فَالدِّیَۃُ وَافِیَۃٌ ، فَإِنْ لَمْ یَنْقَطِعْ الْمَنِیُّ وَکَانَ فِی الظَّہْرِ مَیْلٌ ، فَإِنَّہُ یُرَی فِیہِ۔","","Musannaf Ibn Abi Shaybah 27729","","","كتاب الديات"
"27730","(۲۷۷۳۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سَأَلْتُ عَطَائً عَنِ الصُّلْبِ یُکْسَرُ ؟ قَالَ : الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27730","","","كتاب الديات"
"27731","(۲۷۷۳۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی مُحَمَّدُ بْنُ الْحَارِثِ بْنِ سُفْیَانَ ؛ أَنَّ مُحَمَّدَ بْنَ عَبْدِ اللہِ بْنِ أَبِی رَبِیعَۃَ أَخْبَرَہُ ؛ أَنَّہُ قَالَ : حَضَرْتُ ابْنَ الزُّبَیْرِ فِی رَجُلٍ کُسِرَ صُلْبُہُ ، فَاحْدَوْدَبَ ، وَلَمْ یَقْعُدْ وَہُوَ یَمْشِی وَہُوَ مُحْدَوْدِبٌ ، فَقَالَ : امْشِ ، فَمَشَی ، فَقَضَی لَہُ بِثُلُثَیِ الدِّیَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 27731","","","كتاب الديات"
"27732","(۲۷۷۳۲) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَن حَسَنِ بْنِ صَالِحٍ ، عَنْ عَبِیدَۃَ ، عَنْ یَزِیدَ الضَّخْمِ ، عَنْ عَلِیٍّ ، قَالَ : إِذَا کُسِرَ الصُّلْبُ ، وَمَنَعَ الْجِمَاعَ فَفِیہِ الدِّیَۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 27732","","","كتاب الديات"
"27733","(۲۷۷۳۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَن زَیْدِ بْنِ ثَابِتٍ ؛ أَنَّہُ قَضَی فِی حَلَمَۃِ ثَدْیِ الْمَرْأَۃِ رُبُعَ دِیَتِہَا ، وَفِی حَلَمَۃِ ثَدْیِ الرَّجُلِ ثُمْنَ دِیَتِہِ۔","","Musannaf Ibn Abi Shaybah 27733","","","كتاب الديات"
"27734","(۲۷۷۳۴) حَدَّثَنَا أَبُو بَکْرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : فِی الثَّدْیَیْنِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27734","","","كتاب الديات"
"27735","(۲۷۷۳۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : فی ثَدْیِ الْمَرْأَۃِ فَمَا فَوْقَہُ الدِّیَۃُ کَامِلَۃً ، وَفِی أَحَدِہِمَا نِصْفُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27735","","","كتاب الديات"
"27736","(۲۷۷۳۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : فِی الثَّدْیَیْنِ الدِّیَۃُ ، وَفِی أَحَدِہِمَا نِصْفُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 27736","","","كتاب الديات"
"27737","(۲۷۷۳۷) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : سُئِلَ عَن ثَدْیِ الْمَرْأَۃِ ؟ فَقَالَ : فِیہِ نِصْفُ الدِّیَۃِ ، وَإِذَا أُصِیبَ بَعْضُہُ فَفِیہِ حُکُومَۃُ الْعَدْلِ الْمُجْتَہِدِ۔","","Musannaf Ibn Abi Shaybah 27737","","","كتاب الديات"
"27738","(۲۷۷۳۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ عَمْرُو بْنُ شُعَیْبٍ : قَضَی أَبُو بَکْرٍ فِی ثَدْیِ الرَّجُلِ إِذَا ذَہَبَتْ حَلَمَتُہُ بِخَمْسٍ مِنَ الإِبِلِ ، وَقَضَی فِی ثَدْیِ الْمَرْأَۃِ بِعَشْرٍ مِنَ الإِبِلِ إِذَا لَمْ یُصِبْ إِلاَّ حَلَمَۃَ ثَدْیِہَا، فَإِذَا قُطِعَ مِنْ أَصْلِہِ فَخَمْسَۃُ عَشْرٍ مِنَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 27738","","","كتاب الديات"
"27739","(۲۷۷۳۹) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی مَعْمَرٌ ، عَمَّنْ أَخْبَرَہُ ، عَن عِکْرِمَۃَ ؛ أَنَّ أَبَا بَکْرٍ جَعَلَ فِی حَلَمَۃِ ثَدْیِ الْمَرْأَۃِ مِئَۃَ دِینَارٍ ، وَجَعَلَ فِی حَلَمَۃِ ثَدْیِ الرَّجُلِ خَمْسِینَ دِینَارًا۔","Da'if","Musannaf Ibn Abi Shaybah 27739","","","كتاب الديات"
"27740","(۲۷۷۴۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنَی دَاوُد بْنُ أَبِی عَاصِمٍ ؛ أَنَّ عَبْدَ الْمَلِکِ بْنَ مَرْوَانَ قَضَی فِی قِتَالِ غَسَّانَ وَأَصَابُوا النِّسَائَ ، فِی الثَّدْیِ بِخَمْسِینَ دِینَارًا۔","","Musannaf Ibn Abi Shaybah 27740","","","كتاب الديات"
"27741","(۲۷۷۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، قَالَ : بَلَغَنِی عَنْ إِبْرَاہِیمَ ، قَالَ : فِی ثَدْیِ الْمَرْأَۃِ نِصْفُ الدِّیَۃِ ، وَفِی ثَدْیِ الرَّجُلِ حُکُومَۃٌ۔","","Musannaf Ibn Abi Shaybah 27741","","","كتاب الديات"
"27742","(۲۷۷۴۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ مُحَمَّدِ بْنِ رَاشِدٍ، عَنْ مَکْحُولٍ، قَالَ: ثَدْیُ الْمَرْأَۃِ نِصْفُ عَقْلِہَا، وَإِنْ کَانَتْ عَاقِرًا۔","","Musannaf Ibn Abi Shaybah 27742","","","كتاب الديات"
"27743","(۲۷۷۴۳) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ حُصَیْنٍ الْحَارِثِیِّ ، عَنِ الشَّعْبِیِّ ، عنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : مَا جَنَی الْعَبْدُ : فَفِی رَقَبَتِہِ ، وَیُخَیَّرُ مَوْلاَہُ ، إِنْ شَائَ فَدَاہُ ، وَإِنْ شَائَ دَفَعَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 27743","","","كتاب الديات"
"27744","(۲۷۷۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ طَاوُوسٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : جِنَایَۃُ الْعَبْدِ فِی رَقَبَتِہِ ، وَیُخَیَّرُ مَوْلاَہُ ، إِنْ شَائَ فَدَاہُ ، وَإِنْ شَائَ دَفَعَہُ۔","","Musannaf Ibn Abi Shaybah 27744","","","كتاب الديات"
"27745","(۲۷۷۴۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یَجْنِی الْمَمْلُوکُ عَلَی سَیِّدِہِ أَکْثَرَ مِنْ ثَمَنِ رَقَبَتِہِ۔","","Musannaf Ibn Abi Shaybah 27745","","","كتاب الديات"
"27746","(۲۷۷۴۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ، قَالَ : مَا جَنَی الْعَبْدُ فَفِی رَقَبَتِہِ ، أَوْ یُؤَدِّی عَنْہُ سَیِّدُہُ۔","","Musannaf Ibn Abi Shaybah 27746","","","كتاب الديات"
"27747","(۲۷۷۴۷) حَدَّثَنَا عَبَّادٌ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، قَالَ : قُلْتُ لَہُ : عَبْدٌ جَنَی جِنَایَۃً ، قَالَ : فِی رَقَبَتِہِ۔","","Musannaf Ibn Abi Shaybah 27747","","","كتاب الديات"
"27748","(۲۷۷۴۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : خُبِّرْتُ عَنْ سَالِمِ بْنِ عَبْدِ اللہِ ، قَالَ : إِنْ شَائَ أَہْلُ الْمَمْلُوکِ فَدَوْہُ بِعَقْلِ جُرْحِ الْجارِحِ ، وَإِنْ شَاؤُوا أَسْلَمُوہُ۔","","Musannaf Ibn Abi Shaybah 27748","","","كتاب الديات"
"27749","(۲۷۷۴۹) حَدَّثَنَا عَبْدُالأَعْلَی، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ، قَالَ: إِنْ قَتَلَ خَطَأً: إِنْ شَائَ سَیِّدُہُ فَدَاہُ، وَإِنْ شَائَ دَفَعَہُ بِرُمَّتِہِ۔","","Musannaf Ibn Abi Shaybah 27749","","","كتاب الديات"
"27750","(۲۷۷۵۰) حَدَّثَنَا سُلَیْمَانُ بْنُ حَرْبٍ، عَنْ حَمَّادِ بْنِ زَیْدٍ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ، عَنْ أَبِیہِ؛ أَنَّہُ کَانَ یَقُولُ فِی الْعَبْدِ یَجْنِی الْجِنَایَۃَ ، قَالَ : مَوْلاَہُ بِالْخِیَارِ ؛ إِنْ شَائَ أَنْ یَدْفَعَ الْعَبْدَ بِالْجِنَایَۃِ ، وَإِنْ شَائَ أَعْطَی الْجِنَایَۃَ ، وَأَمْسَکَ الْعَبْدَ۔","","Musannaf Ibn Abi Shaybah 27750","","","كتاب الديات"
"27751","(۲۷۷۵۱) حَدَّثَنَا شَرِیکٌ، عَنْ مُغِیْرَۃ، عَنْ إِبْرَاہِیمَ، قَالَ: إِذَا جَنَی جِنَایَۃً فَعَلِمَ بِجِنَایَتِہ، فَأَعْتَقَہُ؛ فَہُوَ ضَامِن لِجِنَایَتِہِ۔","","Musannaf Ibn Abi Shaybah 27751","","","كتاب الديات"
"27752","(۲۷۷۵۲) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 27752","","","كتاب الديات"
"27753","(۲۷۷۵۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ فِی الْعَبْدِ یَجُرُّ الْجَرِیرَۃَ فَیُعْتِقُہُ سَیِّدُہُ ، أَنَّہُ یَجُوزُ عِتْقُہُ ، وَیَضْمَنُ سَیِّدُہُ ثَمَنَہُ۔","","Musannaf Ibn Abi Shaybah 27753","","","كتاب الديات"
"27754","(۲۷۷۵۴) حَدَّثَنَا عَبَّادٌ ، عَنْ أَشْعَثَ ، عن مُحَمَّدٍ ؛ فِی الْعَبْدِ یَجْنِی الْجِنَایَۃَ ، قَالَ : فِی رَقَبَتِہِ ، قُلْتُ : فَإِنْ أَعْتَقَہُ مَوْلاَہُ ؟ قَالَ : عَلَیْہِ قِیْمَتُہُ۔","","Musannaf Ibn Abi Shaybah 27754","","","كتاب الديات"
"27755","(۲۷۷۵۵) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی عَبْدٍ جَنَی جِنَایَۃً ، فَعَلِمَ مَوْلاَہُ فَأَعْتَقَہُ ، قَالَ : یَسْعَی الْعَبْدُ فِی جِنَایَتِہِ۔","","Musannaf Ibn Abi Shaybah 27755","","","كتاب الديات"
"27756","(۲۷۷۵۶) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الوارث ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَن حَمَّادٍ؛ سُئِلَ عَنِ الْعَبْدِ یُصِیبُ الْجِنَایَۃَ؟ قَالَ : سَیِّدُہُ بِالْخِیَارِ ، إِنْ شَائَ دَفَعَہُ ، وَإِنْ شَائَ أَسْلَمَہُ ، فَإِنْ أَعْتَقَہُ فَعَلَیْہِ ثَمَنُ الْعَبْدِ ، وَلَیْسَ عَلَی الْعَبْدِ شَیْئٌ إِذَا أُعْتِقَ۔","","Musannaf Ibn Abi Shaybah 27756","","","كتاب الديات"
"27757","(۲۷۷۵۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا إِسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَ[corrupt] طَارِقٍ ، عَنِ الشَّعْبِیِّ ؛ فِی عَبْدٍ قَتَلَ رَجُلاً حُرًّا، فَبَلَغَ مَوْلاَہُ فَأَعْتَقَہُ ، قَالَ : عِتْقُہُ جَائِزٌ ، وَعَلَی مَوْلاَہُ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27757","","","كتاب الديات"
"27758","(۲۷۷۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَمِعْتُ سُفْیَانَ ، یَقُولُ : إِنْ کَانَ مَوْلاَہُ أَعْتَقَہُ وَقَدْ عَلِمَ بِالْجِنَایَۃِ ، فَہُوَ ضَامِنٌ لِلْجِنَایَۃِ ، وَإِنْ لَمْ یَکُنْ عَلِمَ بِالْجِنَایَۃِ فَعَلَیْہِ قِیمَۃُ الْعَبْدِ۔","","Musannaf Ibn Abi Shaybah 27758","","","كتاب الديات"
"27759","(۲۷۷۵۹) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ قَالَ : إِذَا قَتَلَ الْعَبْدُ الْحُرَّ دُفِعَ إِلَی أَوْلِیَائِ الْمَقْتُولِ ، فَإِنْ شَاؤُوا قَتَلُوہُ ، وَإِنْ شَاؤُوا اسْتَحْیَوْہُ۔","","Musannaf Ibn Abi Shaybah 27759","","","كتاب الديات"
"27760","(۲۷۷۶۰) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : لاَ أَعْلَمُ الدَّمَ إِلاَّ لأَہْلِہِ ، إِنْ شَاؤُوا بَاعُوا ، وَإِنْ شَاؤُوا وَہَبُوا ، وَإِنْ شَاؤُوا اسْتَقَادُوا۔","","Musannaf Ibn Abi Shaybah 27760","","","كتاب الديات"
"27761","(۲۷۷۶۱) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَن یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی عَبْدٍ قَتَلَ حُرًّا فَأُعْطِی وَرَثَتُہُ أَنْ یَقْتُلُوہُ ، قَالَ : إِنْ شَائَ اسْتَرَقُّوہُ۔","","Musannaf Ibn Abi Shaybah 27761","","","كتاب الديات"
"27762","(۲۷۷۶۲) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یُدْفَعُ إِلَی أَوْلِیَائِ الْمَقْتُولِ ، فَإِنْ شَاؤُوا قَتَلُوا ، وَإِنْ شَاؤُوا اسْتَرَقُّوا۔","","Musannaf Ibn Abi Shaybah 27762","","","كتاب الديات"
"27763","(۲۷۷۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ (ح) وَعَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ قَالاَ : إِنْ شَاؤُوا قَتَلُوا ، وَإِنْ شَاؤُوا اسْتَرَقُّوا۔","","Musannaf Ibn Abi Shaybah 27763","","","كتاب الديات"
"27764","(۲۷۷۶۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ؛ فِی عَبْدٍ قَتَلَ حُرًّا مُتَعَمِّدًا ، قَالَ : یُعْطَی ہَؤُلاَئِ : أَہْلُ الْمَقْتُولِ ، إِنْ شَاؤُوا قَتَلُوہُ ، وَإِنْ شَاؤُوا اسْتَرَقُّوہُ۔","","Musannaf Ibn Abi Shaybah 27764","","","كتاب الديات"
"27765","(۲۷۷۶۵) حَدَّثَنَا عَبَّادٌ ، عَنْ عُمَرَ بْنِ عَامِرٍ ، عَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی الْعَبْدِ یَقْتُلُ الْحُرَّ عَمْدًا ، قَالَ : لَیْسَ لَہُمْ أَنْ یَسْتَخْدِمُوہُ ، إِنَّمَا لَہُمْ دَمُہُ ، إِنْ شَاؤُوا قَتَلُوہُ ، وَإِنْ شَاؤُوا عَفَوْا عَنْہُ۔","","Musannaf Ibn Abi Shaybah 27765","","","كتاب الديات"
"27766","(۲۷۷۶۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی الْعَبْدِ یَقْتُلُ الْحُرَّ مُتَعَمِّدًا ، ثُمَّ یَعْفُو وَلِیُّ الدَّمِ عَنِ الدَّمِ ، قَالَ : یَرْجِعُ إِلَی مَوْلاَہُ۔","","Musannaf Ibn Abi Shaybah 27766","","","كتاب الديات"
"27767","(۲۷۷۶۷) حَدَّثَنَا مُعَاذٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إِنْ عَفَوْا عَنْہُ رَجَعَ عبدًا إِلَی سَیِّدِہِ۔","","Musannaf Ibn Abi Shaybah 27767","","","كتاب الديات"
"27768","(۲۷۷۶۸) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَمَّادٍ ؛ فِی عَبْدٍ قَتَلَ حُرًّا فَدُفِعَ إِلَی أَوْلِیَائِہِ ، قَالَ : إِنْ عَفَوْا عَنْہُ رَجَعَ إِلَی سَیِّدِہِ ، وَلَیْسَ لَہُمْ أَنْ یَسْتَخْدِمُوہُ۔n قَالَ وَکِیعٌ : وَہُوَ قَوْلُ سُفْیَانَ۔","","Musannaf Ibn Abi Shaybah 27768","","","كتاب الديات"
"27769","(۲۷۷۶۹) حَدَّثَنَا حَفْصٌ ، وَعَلِیٌّ ، وَعَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قیمَتُہُ بَالِغَۃٌ مَا بَلَغَتْ۔","","Musannaf Ibn Abi Shaybah 27769","","","كتاب الديات"
"27770","(۲۷۷۷۰) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَمْرِو بْنِ مُہَاجِرٍ ، وَسِوَادَۃَ بْنِ زِیَادٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : قیمَتُہُ یَوْمَ یُصَابُ۔","","Musannaf Ibn Abi Shaybah 27770","","","كتاب الديات"
"27771","(۲۷۷۷۱) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَن عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ أَیُّوبَ بْنِ مُوسَی ، عَنْ عَطَائٍ وَمَکْحُولٍ ، وَابْنِ شِہَابٍ ، قَالُوا : قیمَتُہُ یَوْمَ یُصَابُ۔","","Musannaf Ibn Abi Shaybah 27771","","","كتاب الديات"
"27772","(۲۷۷۷۲) حَدَّثَنَا حَفْصٌ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ، وَابْنِ سِیرِینَ، أَنَّہُمَا قَالاَ: قیمَتُہُ یَوْمَ یُصَابُ ، بَالِغَۃً مَا بَلَغَتْ۔","","Musannaf Ibn Abi Shaybah 27772","","","كتاب الديات"
"27773","(۲۷۷۷۳) حَدَّثَنَا مَعْمَرٌ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، قَالَ : قیمَتُہُ یَوْمَ یُصَابُ۔","","Musannaf Ibn Abi Shaybah 27773","","","كتاب الديات"
"27774","(۲۷۷۷۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ ، قَالاَ : قیمَتُہُ یَوْمَ یُصَابُ ، بَالِغَۃً مَا بَلَغَتْ۔","","Musannaf Ibn Abi Shaybah 27774","","","كتاب الديات"
"27775","(۲۷۷۷۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَلِیٍّ ، وَعَبْدِ اللہِ وَشُرَیْحٍ ، قَالُوا : ثَمَنُہُ، وَإِنْ خَلَفَ دِیَۃَ الْحُرِّ۔","","Musannaf Ibn Abi Shaybah 27775","","","كتاب الديات"
"27776","(۲۷۷۷۶) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : ہُوَ مَالٌ مَا بَلَغَ۔","","Musannaf Ibn Abi Shaybah 27776","","","كتاب الديات"
"27777","(۲۷۷۷۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : یَبْلُغُ مَا بَلَغَ۔","","Musannaf Ibn Abi Shaybah 27777","","","كتاب الديات"
"27778","(۲۷۷۷۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن دَاوُد ، عَنِ الشَّعْبِیِّ ؛ أَنَّ سَعِیدَ بْنَ الْعَاصِ جَعَلَ دِیَۃَ عَبْدٍ قُتِلَ خَطَأً أَرْبَعَۃَ آلاَفٍ ، وَکَانَ ثَمَنُہُ أَکْثَرَ مِنْ ذَلِکَ ، وَقَالَ : أَکْرَہُ أَنْ أَجْعَلَ دِیَتَہُ أَکْثَرَ مِنْ دِیَۃِ الْحُرِّ۔","Sahih","Musannaf Ibn Abi Shaybah 27778","","","كتاب الديات"
"27779","(۲۷۷۷۹) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ یُبْلَغُ بِہِ دِیَۃُ الْحُرِّ۔","","Musannaf Ibn Abi Shaybah 27779","","","كتاب الديات"
"27780","(۲۷۷۸۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ، قَالَ: لاَ یُزَادُ السَّیْدُ عَلَی دِیَۃِ الْحُرِّ۔(عبدالرزاق ۱۸۱۶۹)","","Musannaf Ibn Abi Shaybah 27780","","","كتاب الديات"
"27781","(۲۷۷۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، وَالشَّعْبِیِّ ، قَالاَ : لاَ یُبْلَغُ بِدِیَۃِ الْعَبْدِ دِیَۃَ الْحُرِّ فِی الْخَطَأِ۔","","Musannaf Ibn Abi Shaybah 27781","","","كتاب الديات"
"27782","(۲۷۷۸۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : دِیَۃُ الْمَمْلُوکِ أَنْقَصُ مِنْ دِیَۃِ الْحُرِّ۔","","Musannaf Ibn Abi Shaybah 27782","","","كتاب الديات"
"27783","(۲۷۷۸۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا أُصِیبَتْ أُذُنُ الْعَبْدِ ، أَوْ عَیْنُہُ فَفِیہَا نِصْفُ ثَمَنِہِ ، وَإِذَا أُصِیبَتْ أُذُنَاہُ ، أَوْ عَیْنَاہُ فَفِیہَا ثَمَنُہُ کُلُّہُ ، وَیَدْفَعُہُ إِلَی الَّذِی أَصَابَہُ۔","","Musannaf Ibn Abi Shaybah 27783","","","كتاب الديات"
"27784","(۲۷۷۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا فُقِئَتْ عَیْنُ الْعَبْدِ ، أَوْ قُطِعَتْ یَدُہُ ، أَوْ رِجْلُہُ ؛ فَعَلَیْہِ نِصْفُ قِیمَتِہِ ، وَإِذَا فُقِئَتْ عَیْنَاہُ ، أَوْ قُطِعَتْ یَدَاہُ ، أَوْ رِجْلاَہُ ؛دَفَعَہُ وَعَلَیْہِ قِیمَتُہُ۔","","Musannaf Ibn Abi Shaybah 27784","","","كتاب الديات"
"27785","(۲۷۷۸۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الْمَمْلُوکِ إِذَا فُقِئَتْ عَیْنُہُ ، فَفِیہَا نِصْفُ ثَمَنِہِ۔","","Musannaf Ibn Abi Shaybah 27785","","","كتاب الديات"
"27786","(۲۷۷۸۶) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ إِیَاسِ بْنِ مُعَاوِیَۃَ ؛ فِی رَجُلٍ قَطَعَ یَدَ عَبْدٍ عَمْدًا ، أَوْ فَقَأَ عَیْنَہُ ، قَالَ : ہُوَ لَہُ ، وَعَلَیْہِ ثَمَنُہُ۔","","Musannaf Ibn Abi Shaybah 27786","","","كتاب الديات"
"27787","(۲۷۷۸۷) حَدَّثَنَا عَبْدُالأَعْلَی، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ، فِی الْحُرِّ یَجْرَحُ الْعَبْدَ، قَالَ: إِنْ فَقَأَ عَیْنَہُ فَفِیہَا نِصْفُ ثَمَنِہِ۔","","Musannaf Ibn Abi Shaybah 27787","","","كتاب الديات"
"27788","(۲۷۷۸۸) حَدَّثَنَا وَکِیعٌ ، عَنِ النَّہَّاسِ بْنِ قَہْمٍ ، عَنْ عَطَائٍ ؛ فِی مُوضِحَۃِ الْعَبْدِ ، نِصْفُ عُشْرِ ثَمَنِہِ۔","","Musannaf Ibn Abi Shaybah 27788","","","كتاب الديات"
"27789","(۲۷۷۸۹) حَدَّثَنَا وَکِیعٌ ، عَن زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ؛ فِی مُوضِحَۃِ الْعَبْدِ ، نِصْفُ عُشْرِ ثَمَنِہِ۔","","Musannaf Ibn Abi Shaybah 27789","","","كتاب الديات"
"27790","(۲۷۷۹۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، قَالَ : قضَی فِی سِنِّ الْعَبْدِ وَمُوضِحَتِہِ عَلَی قَدْرِ قِیمَتِہِ مِنْ ثَمَنِہِ ؛ نِصْفُ عُشْرِ قِیمَتِہِ ، کَنَحْوٍ مِنْ دِیَۃِ الْحُرِّ فِی السِّنِّ وَالْمُوضِحَۃِ۔","","Musannaf Ibn Abi Shaybah 27790","","","كتاب الديات"
"27791","(۲۷۷۹۱) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عن شُرَیْحٍ ؛ بِنَحْوِ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 27791","","","كتاب الديات"
"27792","(۲۷۷۹۲) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : جِرَاحَۃُ الْعَبْدِ مِنْ ثَمَنِہِ ، کَجِرَاحَۃِ الْحُرِّ مِنْ دِیَتِہِ ، الْعُشْرُ وَنِصْفُ الْعُشْرِ۔","","Musannaf Ibn Abi Shaybah 27792","","","كتاب الديات"
"27793","(۲۷۷۹۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : عَقْلُ الْعَبْدِ فِی ثَمَنِہِ۔","","Musannaf Ibn Abi Shaybah 27793","","","كتاب الديات"
"27794","(۲۷۷۹۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : جِرَاحَۃُ الْعَبْدِ فِی ثَمَنِہِ مِثْلُ جِرَاحَۃِ الْحُرِّ فِی دِیَتِہِ ، وَقَالَ الزُّہْرِیُّ : قَالَ أُنَاسٌ : إِنَّمَا ہُوَ مَالٌ ، فَعَلَی قَدْرِ مَا انْتَقَصَ مِنْ ثَمَنِہِ۔","","Musannaf Ibn Abi Shaybah 27794","","","كتاب الديات"
"27795","(۲۷۷۹۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : تَجْرِی جِرَاحَاتُ الْعَبِیدِ عَلَی مَا تَجْرِی عَلَیْہِ جِرَاحَاتُ الأَحْرَارِ۔","","Musannaf Ibn Abi Shaybah 27795","","","كتاب الديات"
"27796","(۲۷۷۹۶) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ أَبِی حُرَّۃَ ، عَنِ الْحَسَنِ ؛ فِی حُرٍّ أَصَابَ مِنْ عَبْدٍ شَیْئًا ، قَالَ : یُردّ عَلَی مَوْلاَہُ مَا نَقَصَ مِنْ ثَمَنِہِ۔","","Musannaf Ibn Abi Shaybah 27796","","","كتاب الديات"
"27797","(۲۷۷۹۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : عَقْلُ الْعَبْدِ فِی ثَمَنِہِ ، مِثْلُ عَقْلِ الرَّجُلِ الْحُرِّ فِی دِیَتِہِ۔","","Musannaf Ibn Abi Shaybah 27797","","","كتاب الديات"
"27798","(۲۷۷۹۸) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَجَّاجٍ ، عَنْ حُصَیْنٍ الْحَارِثِیِّ ، عَنِ الشَّعْبِیِّ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : تَجْرِی جِرَاحَاتُ الْعَبِیدِ عَلَی مَا تَجْرِی عَلَیْہِ جِرَاحَاتُ الأَحْرَارِ۔","Da'if","Musannaf Ibn Abi Shaybah 27798","","","كتاب الديات"
"27799","(۲۷۷۹۹) حَدَّثَنَا ہُشَیْمٌ ، وَابْنُ عُلَیَّۃَ ، عَن خَالِدٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ؛ فِی عَبْدٍ جَرَحَ حُرًّا ، قَالَ : إِنْ شَائَ اقْتَصَّ مِنْہُ ، وَإِنْ شَائَ أَخَذَ بِخُمَاشتہِ أَرْشًا۔","","Musannaf Ibn Abi Shaybah 27799","","","كتاب الديات"
"27800","(۲۷۸۰۰) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ إِبْرَاہِیمَ، قَالَ: إِذَا شَجَّ الْحُرُّ الْعَبْدَ مُتَعَمِّدًا، فَإِنَّمَا ہِیَ دِیَۃٌ لَیْسَ لَہُ عَلَیْہِ قَود۔","","Musannaf Ibn Abi Shaybah 27800","","","كتاب الديات"
"27801","(۲۷۸۰۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : لاَ یُقَادُ الْحُرُّ مِنَ الْعَبْدِ۔","","Musannaf Ibn Abi Shaybah 27801","","","كتاب الديات"
"27802","(۲۷۸۰۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، وَالْحَسَنِ (ح) وَعَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لَیْسَ بَیْنَ الْمَمْلُوکِینَ وَالأَحْرَارِ قِصَاصٌ فِیمَا دُونَ النَّفْسِ۔","","Musannaf Ibn Abi Shaybah 27802","","","كتاب الديات"
"27803","(۲۷۸۰۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : الْعَبْدُ یَشُجُّ الْحُرَّ ، أَوْ یَفْقَأُ عَیْنَہُ ، فَیُرِیدُ الْحُرُّ أَنْ یَسْتَقِیدَ مِنَ الْعَبْدِ ، قَالَ : لاَ یَسْتَقِیدُ حُرٌّ مِنْ عَبْدٍ ، وَقَالَ مِثْلَ ذَلِکَ مُجَاہِدٌ ، وَسُلَیْمَانُ بْنُ مُوسَی۔","","Musannaf Ibn Abi Shaybah 27803","","","كتاب الديات"
"27804","(۲۷۸۰۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أُخْبِرْتُ عَن سَالِمٍ ، قَالَ : لاَ یَسْتَقِیدُ الْعَبْدُ مِنَ الْحُرِّ۔","","Musannaf Ibn Abi Shaybah 27804","","","كتاب الديات"
"27805","(۲۷۸۰۵) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ قَوَدَ بَیْنَ الْحُرِّ وَالْعَبْدِ ، إِلاَّ أَنَّ الْعَبْدَ إِذَا قَتَلَ الْحُرَّ قُتِلَ بِہِ۔","","Musannaf Ibn Abi Shaybah 27805","","","كتاب الديات"
"27806","(۲۷۸۰۶) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، قَالاَ : لَیْسَ بَیْنَ الْمَمْلُوکِینَ قِصَاصٌ۔","","Musannaf Ibn Abi Shaybah 27806","","","كتاب الديات"
"27807","(۲۷۸۰۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، وَالْحَسَنِ (ح) وَعَنِ الْحَکَمِ ، وَحَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالُوا : لَیْسَ بَیْنَ الْمَمْلُوکِینَ قِصَاصٌ فِیمَا دُونَ النَّفْسِ۔","","Musannaf Ibn Abi Shaybah 27807","","","كتاب الديات"
"27808","(۲۷۸۰۸) حَدَّثَنَا عَبَّادٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، وَالشَّعْبِیِّ ؛ أَنَّہُمَا قَالاَ : لَیْسَ بَیْنَ الْمَمْلُوکِینَ قِصَاصٌ ، وَلَیْسَ بَیْنَ الصِّبْیَانِ قِصَاصٌ۔","","Musannaf Ibn Abi Shaybah 27808","","","كتاب الديات"
"27809","(۲۷۸۰۹) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أُخْبِرْتُ عَن سَالِمٍ ، أَنَّہُ قَالَ : إِذَا عَمَدَ الْمَمْلُوکُ فَقَتَلَ الْمَمْلُوکَ ، أَوْ جَرَحَہُ ، فَہُوَ بِہِ قَوَدٌ۔","","Musannaf Ibn Abi Shaybah 27809","","","كتاب الديات"
"27810","(۲۷۸۱۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : یُقَادُ الْمَمْلُوکُ مِنَ الْمَمْلُوکِ فِی کُلِّ عَمْدٍ یَبْلُغُ قِیمَۃَ نَفْسِہِ ، فَمَا دُونَ ذَلِکَ مِنَ الْجِرَاحَاتِ۔","","Musannaf Ibn Abi Shaybah 27810","","","كتاب الديات"
"27811","(۲۷۸۱۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُمَرَ ؛ أَنَّ فِی کِتَابٍ لِعُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ : یُقَادُ الْمَمْلُوکُ مِنَ الْمَمْلُوکِ فِی عَمْدٍ یَبْلُغُ نَفْسَہُ فَمَا دُونَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 27811","","","كتاب الديات"
"27812","(۲۷۸۱۲) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَن زُہَیْرٍ ، عَنِ الْحَسَنِ بْنِ الْحُرِّ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، وَالشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ ، قَالَ : إِنَّ الْعَبْدَ لاَ یُقَادُ مِنَ الْعَبْدِ فِی جِرَاحَۃِ عَمْدٍ ، وَلاَ خَطَأٍ ، إِلاَّ فِی قَتْلِ عَمْدٍ۔","","Musannaf Ibn Abi Shaybah 27812","","","كتاب الديات"
"27813","(۲۷۸۱۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَرَی الْقِصَاصَ بَیْنَ الْعَبِیدِ۔","","Musannaf Ibn Abi Shaybah 27813","","","كتاب الديات"
"27814","(۲۷۸۱۴) حَدَّثَنَا شَبَابَۃُ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الْحَارِثِ ، قَالَ : قَالَ : رَأَیْتُ نَوْفَلَ بْنَ مُسَاحِقٍ یقتصّ لِلْعَبِید بَعْضِہمْ مِنْ بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 27814","","","كتاب الديات"
"27815","(۲۷۸۱۵) حَدَّثَنَا إِسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن خَالِدٍ الْحَذَّائِ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ لاَ یَرَی بَأْسًا فِی الرَّجُلِ یَقْتُلُہُ الرَّجُلاَنِ أَنْ یُقْتَلَ أَحَدُہُمَا ، وَتُؤْخَذ الدِّیَۃُ مِنَ الآخَرِ۔","","Musannaf Ibn Abi Shaybah 27815","","","كتاب الديات"
"27816","(۲۷۸۱۶) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ؛ فِی الرَّجُلِ یَقْتُلُہُ النَّفَرُ ، قَالَ : یُدْفَعُونَ إِلَی أَوْلِیَائِ الْمَقْتُولِ ، فَیَقْتُلُونَ مَنْ شَاؤُوا ، وَیَعْفُونَ عَمَّنْ شَاؤُوا۔","","Musannaf Ibn Abi Shaybah 27816","","","كتاب الديات"
"27817","(۲۷۸۱۷) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ، قَالَ: إِذَا عَفَا عَنْ أَحَدِہِمْ، فَلْیَعْفُ عَنہُمْ جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 27817","","","كتاب الديات"
"27818","(۲۷۸۱۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَام[corrupt] ، عَنِ الْحَسَنِ ؛ أَنَّہُ قَالَ فِی رَجُلٍ قَتَلَہُ ثَلاَثَۃُ نَفَرٍ ، فَأَرَادَ وَلِیُّہُ أَنْ یَعْفُوَ عَن بَعْضٍ وَیَقْتُلَ بَعْضًا ، وَیَأْخُذَ مِنْ بَعْضٍ الدِّیَۃَ ، قَالَ : لَیْسَ لَہُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 27818","","","كتاب الديات"
"27819","(۲۷۸۱۹) حَدَّثَنَا بَہْزُ بْنُ أَسَدٍ ، عَنْ أَبَانَ الْعَطَّارِ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی الرَّجُلِ یَقْتُلُہُ النَّفَرُ ، قَالَ : یَعْفُوَ عَمَّنْ شَائَ ، وَیَقْتُلُ مَنْ شَائَ ، وَیَأْخُذُ الدِّیَۃَ مِمَّنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 27819","","","كتاب الديات"
"27820","(۲۷۸۲۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ؛ فِی الرَّجُلِ یَقْتُلُہُ النَّفَرُ ، قَالَ : یَقْتُلُ مَنْ شَائَ ، وَیَعْفُوَ عَمَّنْ شَائَ ، وَیَأْخُذَ الدِّیَۃَ مِمَّنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 27820","","","كتاب الديات"
"27821","(۲۷۸۲۱) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : جَنِینُ الأَمَۃِ عَشَرَۃُ دَنَانِیرَ۔","","Musannaf Ibn Abi Shaybah 27821","","","كتاب الديات"
"27822","(۲۷۸۲۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الْخَالِقِ ، عَن حَمَّادٍ ، قَالَ : فِی جَنِینِ الأَمَۃِ حُکْمٌ۔","","Musannaf Ibn Abi Shaybah 27822","","","كتاب الديات"
"27823","(۲۷۸۲۳) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ، قَالَ: جَنِینُ الأَمَۃِ إِذَا اسْتَہَلَّ، فَقِیمَتُہُ یَوْمَ اسْتَہَلَّ۔","","Musannaf Ibn Abi Shaybah 27823","","","كتاب الديات"
"27824","(۲۷۸۲۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، قَالَ : کَانُوا یَأْخُذُونَ جَنِینَ الأَمَۃِ مِنْ جَنِینِ الْحُرَّۃِ۔","","Musannaf Ibn Abi Shaybah 27824","","","كتاب الديات"
"27825","(۲۷۸۲۵) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ قَالَ : فِی جَنِینِ الأَمَۃِ مِنْ ثَمَنِہَا ، کَنَحْوٍ مِنْ جَنِینِ الْحُرَّۃِ مِنْ دِیَتِہَا ؛ الْعُشْرُ ، وَنِصْفُ الْعُشْرِ۔","","Musannaf Ibn Abi Shaybah 27825","","","كتاب الديات"
"27826","(۲۷۸۲۶) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ ، قَالَ : إِنْ وَقَعَ حَیًّا فَعَلَیْہِ ثَمَنُہُ ، وَإِنْ وَقَعَ مَیِّتًا فَعَلَیْہِ عُشْرُ ثَمَنِ أُمِّہِ۔","","Musannaf Ibn Abi Shaybah 27826","","","كتاب الديات"
"27827","(۲۷۸۲۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی جَنِینِ الأَمَۃِ عُشْرُ ثَمَنِہَا۔","","Musannaf Ibn Abi Shaybah 27827","","","كتاب الديات"
"27828","(۲۷۸۲۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : عُشْرُ ثَمَنِہَا۔","","Musannaf Ibn Abi Shaybah 27828","","","كتاب الديات"
"27829","(۲۷۸۲۹) حَدَّثَنَا أَبُو بَکْرٍ ، قَالَ : سَمِعْتُ وَکِیعًا ، یَقُولُ : قَالَ سُفْیَانُ : وَنَحْنُ نَقُولُ : إِنْ کَانَ غُلاَمًا فَنِصْفُ عُشْرِ قِیمَتِہِ ، وَإِنْ کَانَتْ جَارِیَۃً فَعُشْرُ قِیمَتِہَا لَوْ کَانَتْ حَیَّۃً۔","","Musannaf Ibn Abi Shaybah 27829","","","كتاب الديات"
"27830","(۲۷۸۳۰) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی جَنِینِ الدَّابَّۃِ قِیمَتُہُ۔","","Musannaf Ibn Abi Shaybah 27830","","","كتاب الديات"
"27831","(۲۷۸۳۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، قَالَ : کَانُوا یَأْخُذُونَ جَنِینِ الدَّابَّۃِ مِنْ جَنِینِ الأَمَۃِ۔","","Musannaf Ibn Abi Shaybah 27831","","","كتاب الديات"
"27832","(۲۷۸۳۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی جَنِینِ الدَّابَّۃِ عُشْرُ ثَمَنِ أُمِّہِ۔","","Musannaf Ibn Abi Shaybah 27832","","","كتاب الديات"
"27833","(۲۷۸۳۳) حَدَّثَنَا عُمَرُ ، عَن یُونُسَ ، عَنِ الزُّہْرِیِّ ؛ فِی جَنِینِ الْبَہِیمَۃِ ، قَالَ : نَرَی الْبَہِیمَۃِ سِلْعَۃٌ ، یُقَیِّمُ جَنِینَہَا الْحَاکِمُ ، مَا رَأَی بِرَأْیِہِ۔","","Musannaf Ibn Abi Shaybah 27833","","","كتاب الديات"
"27834","(۲۷۸۳۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ فِی وَلَدِ الْبَہِیمَۃِ حُکُومَۃٌ۔","","Musannaf Ibn Abi Shaybah 27834","","","كتاب الديات"
"27835","(۲۷۸۳۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی الْجَنِینِ ؛ عَبْدًا ، أَوْ أَمَۃً ، فَقَالَ : الَّذِی قَضَی عَلَیْہِ : أَیُعْقَل مَنْ لاَ شَرِبَ، وَلاَ أَکَلَ ، وَلاَ صَاحَ ، فَاسْتَہَلَّ ، وَمِثْلُ ذَلِکَ یُطَلُّ ؟ فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ ہَذَا لَیَقُولُ بِقَوْلِ شَاعِرٍ ، فِیہِ غُرَّۃٌ عَبْدٌ ، أَوْ أَمَۃٌ۔ (ابوداؤد ۴۵۶۸۔ ترمذی ۱۴۱۰)","Hasan","Musannaf Ibn Abi Shaybah 27835","","","كتاب الديات"
"27836","(۲۷۸۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنِ الْمِسْوَرِ بْنِ مَخْرَمَۃَ ، قَالَ : اسْتَشَارَ عُمَرُ بْنُ الْخَطَّابِ فِی إِمْلاَصِ الْمَرْأَۃِ ، فَقَالَ : الْمُغِیرَۃُ بْنُ شُعْبَۃَ : شَہِدْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِیہِ بِغُرَّۃٍ؛ عَبْدٍ ، أَوْ أَمَۃٍ ، قَالَ : فَقَالَ لَہُ عُمَرُ : ائْتِنِی بِمَنْ شَہِدَ مَعَکَ ، فَشَہِدَ لَہُ مُحَمَّدُ بْنُ مَسْلَمَۃَ۔n(بخاری ۶۹۰۷۔ ابوداؤد ۴۵۵۹)","Sahih","Musannaf Ibn Abi Shaybah 27836","","","كتاب الديات"
"27837","(۲۷۸۳۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فِی الْجَنِینِ غُرَّۃٌ ؛ عَبْدٌ ، أَوْ أَمَۃٌ ، أَوْ بَغْلٌ۔ (ابوداؤد ۴۵۶۸)","","Musannaf Ibn Abi Shaybah 27837","","","كتاب الديات"
"27838","(۲۷۸۳۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : فِیہِ عَبْدٌ ، أَوْ أَمَۃٌ ، أَوْ فَرَسٌ۔","","Musannaf Ibn Abi Shaybah 27838","","","كتاب الديات"
"27839","(۲۷۸۳۹) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : غُرَّۃٌ ؛ عَبْدٌ ، أَوْ أَمَۃٌ لأُِمِّہِ ، أَوْ لأَقْرَبِ النَّاسِ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 27839","","","كتاب الديات"
"27840","(۲۷۸۴۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، وَالْحَکَمِ ؛ قَالاَ : جَنِینُ الْحُرَّۃِ عَبْدٌ ، أَوْ أَمَۃٌ۔","","Musannaf Ibn Abi Shaybah 27840","","","كتاب الديات"
"27841","(۲۷۸۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنِ الشَّعْبِیِّ ؛ فِی رَجُلٍ ضَرَبَ بَطْنَ امْرَأَتِہِ فَأَسْقَطَتْ ، قَالَ : عَلَیْہِ غُرَّۃٌ یَرِثُہَا وَتَرِثَہُ۔","","Musannaf Ibn Abi Shaybah 27841","","","كتاب الديات"
"27842","(۲۷۸۴۲) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ لَیْثٍ ، عَن طَاوُوسٍ ، وَمُجَاہِدٍ ؛ قَالاَ : فِی الْغُرَّۃِ عَبْدٌ ، أَوْ أَمَۃٌ ، أَوْ فَرَسٌ۔","","Musannaf Ibn Abi Shaybah 27842","","","كتاب الديات"
"27843","(۲۷۸۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ لَیْثٍ ، عَن مُجَاہِدٍ ، قَالَ : عَبْدٌ ، أَوْ أَمَۃٌ ، أَوْ فَرَسٌ۔","","Musannaf Ibn Abi Shaybah 27843","","","كتاب الديات"
"27844","(۲۷۸۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : فِی امْرَأَۃٍ شَرِبَتْ دَوَائً فَأَسْقَطَتْ ، قَالَ : تُعْتِقُ رَقَبَۃً ، وَتُعْطِی أَبَاہُ غُرَّۃً۔","","Musannaf Ibn Abi Shaybah 27844","","","كتاب الديات"
"27845","(۲۷۸۴۵) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِیَادٍ ، عَن مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ قَالَ : فِی الْغُرَّۃِ عَبْدٌ ، أَوْ أَمَۃٌ۔ (مسند ۱۹۰۱)","Da'if","Musannaf Ibn Abi Shaybah 27845","","","كتاب الديات"
"27846","(۲۷۸۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : فِی أَصْلِ کُلِّ حَبَلٍ غُرَّۃٌ ، قَالَ : وَقَالَ الْحَکَمُ : فِیہِ صُلْحٌ حَتَّی یَسْتَبِینَ خَلْقُہُ۔n قَالَ وَکِیعٌ : وَقَوْلُ الْحَکَمِ أَحْسَنُ مِنْ قَوْلِ الشَّعْبِیِّ۔","","Musannaf Ibn Abi Shaybah 27846","","","كتاب الديات"
"27847","(۲۷۸۴۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ (ح) وَعَن یُونُسَ ، عَنِ الْحَسَنِ (ح) وَحَجَّاجٍ ، عَنْ عَطَائٍ ؛ قَالُوا فِیمَنْ أَصَابَ جَنِینًا : إِنَّ عَلَیْہِ عِتْقَ رَقَبَۃٍ مَعَ الْغُرَّۃِ۔","","Musannaf Ibn Abi Shaybah 27847","","","كتاب الديات"
"27848","(۲۷۸۴۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : سَمِعْتُہ یَقُولُ : إِذَا ضُرِبَتِ الْمَرْأَۃُ فَأَلْقَتْ جَنِینًا ، فَإِنَّ صَاحِبَہُ یُعْتِقُ۔","","Musannaf Ibn Abi Shaybah 27848","","","كتاب الديات"
"27849","(۲۷۸۴۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، وَوَکِیعٌ ، قَالاَ : حدَّثَنَا عُمَرُ بْنُ ذَرٍّ ، عَن مُجَاہِدٍ ؛ أَنَّ امْرَأَۃً مَسَحَتْ بَطْنَ امْرَأَۃٍ فَأَسْقَطَتْ ، فَأَمَرَہَا عُمَرُ بْنُ الْخَطَّابِ أَنْ تُعْتِقَ۔","","Musannaf Ibn Abi Shaybah 27849","","","كتاب الديات"
"27850","(۲۷۸۵۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن طَارِقٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : الْغُرَّۃُ خَمْسُ مِئَۃٍ۔","","Musannaf Ibn Abi Shaybah 27850","","","كتاب الديات"
"27851","(۲۷۸۵۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَن حَبِیبِ بْنِ أَبِی ثَابِتٍ ، قَالَ : قیمَۃُ الْغُرَّۃِ أَرْبَعُ مِئَۃِ دِرْہَمٍ۔","","Musannaf Ibn Abi Shaybah 27851","","","كتاب الديات"
"27852","(۲۷۸۵۲) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَن زَیْدِ بْنِ أَسْلَمَ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ قَوَّمَ الْغُرَّۃَ خَمْسِینَ دِینَارًا۔","Da'if","Musannaf Ibn Abi Shaybah 27852","","","كتاب الديات"
"27853","(۲۷۸۵۳) حَدَّثَنَا حَفْصٌ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَعَلَ الْغُرَّۃَ عَلَی الْعَاقِلَۃِ۔","","Musannaf Ibn Abi Shaybah 27853","","","كتاب الديات"
"27854","(۲۷۸۵۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، وَابْنُ مَہْدِیٍّ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : الْغُرَّۃُ عَلَی الْعَاقِلَۃِ۔","","Musannaf Ibn Abi Shaybah 27854","","","كتاب الديات"
"27855","(۲۷۸۵۵) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : فی مَالِہِ۔","","Musannaf Ibn Abi Shaybah 27855","","","كتاب الديات"
"27856","(۲۷۸۵۶) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِیَادٍ ، عَنِ الْمُجَالِدِ ، عَنِ الشَّعْبِیِّ ، عَنْ جَابِرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَعَلَ فِی الْجَنِینِ غُرَّۃً عَلَی عَاقِلَۃِ الْقَاتِلَۃِ ، وَبَرَّأَ زَوْجَہَا وَوَلَدَہَا۔n(بخاری ۶۷۴۰۔ مسلم ۱۳۰۹)","Da'if","Musannaf Ibn Abi Shaybah 27856","","","كتاب الديات"
"27857","(۲۷۸۵۷) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی التَّیْمِیُّ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عُبَیْدِ بْنِ نُضِیلَۃَ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ، قَالَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی عَاقِلَتِہَا بِالدِّیَۃِ ، وَفِی الْحَمْلِ غُرَّۃٌ۔n(مسلم ۱۳۱۰۔ ابوداؤد ۴۵۵۷)","Sahih","Musannaf Ibn Abi Shaybah 27857","","","كتاب الديات"
"27858","(۲۷۸۵۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ أَبِی إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ قُسَیْطٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ عُمَرَ جَعَلَ الْغُرَّۃَ عَلَی أَہْلِ الْقَرْیَۃِ ، وَالْفَرَائِضَ عَلَی أَہْلِ الْبَادِیَۃِ۔","","Musannaf Ibn Abi Shaybah 27858","","","كتاب الديات"
"27859","(۲۷۸۵۹) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : دِیَۃُ الْجَنِینِ عَلَی الَّذِی أَصَابَہُ فِی مَالِہِ ، وَلَیْسَ عَلَی قَوْمِہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 27859","","","كتاب الديات"
"27860","(۲۷۸۶۰) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عُلَیَّۃَ ، عَنْ عَلِیِّ بْنِ الْحَکَمِ ، عَنْ إِسْحَاقَ ، عَنِ الضَّحَّاکِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ قَالَ : لَیْسَ فِی الْجَائِفَۃِ ، وَلاَ الْمَأْمُومَۃِ ، وَلاَ الْمُنَقِّلَۃِ قِصَاصٌ۔","","Musannaf Ibn Abi Shaybah 27860","","","كتاب الديات"
"27861","(۲۷۸۶۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لَیْسَ فِی الآمَّۃِ ، وَالْمُنَقِّلَۃِ ، وَالْجَائِفَۃِ قَوَدٌ ، إِنَّمَا عَمْدُہَا الدِّیَۃُ فِی مَالِ الرَّجُلِ۔","","Musannaf Ibn Abi Shaybah 27861","","","كتاب الديات"
"27862","(۲۷۸۶۲) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ یُقَادُ مِنَ الْجَائِفَۃِ ، وَلاَ مِنَ الْمَأْمُومَۃِ ، وَلاَ مِنَ الْمُنَقِّلَۃِ ، وَلاَ مِنْ شَیْئٍ یُخَافُ فِیہِ عَلَی النَّفْسِ ، وَلاَ مِنْ شَیْئٍ لاَ یَأْتِی کَمَا أَصَابَ صَاحِبہُ۔","","Musannaf Ibn Abi Shaybah 27862","","","كتاب الديات"
"27863","(۲۷۸۶۳) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَن عُبَیْدِ اللہِ بْنِ عُبَیْدٍ الْکَلاَعِیِّ ، عَنْ مَکْحُولٍ ، قَالَ : لاَ یُقَادُ مِنَ الْجَائِفَۃِ ، وَالْمَأْمُومَۃِ ، وَالْمُنَقِّلَۃِ ، وَالنَّاخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 27863","","","كتاب الديات"
"27864","(۲۷۸۶۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لَیْسَ فِی الآمَّۃِ ، وَلاَ فِی الْجَائِفَۃِ ، وَلاَ فِی کَسْرِ الْعِظَامِ قِصَاصٌ۔","","Musannaf Ibn Abi Shaybah 27864","","","كتاب الديات"
"27865","(۲۷۸۶۵) حَدَّثَنَا أَبُو خَالِدٍ ، عَن عِیسَی ، عَنِ الشَّعْبِیِّ ، قَالَ : لَیْسَ فِی جَائِفَۃٍ ، وَلاَ مَأْمُومَۃٍ ، وَلاَ مُنَقِّلَۃٍ قِصَاصٌ ، وَلاَ فِی الْفَخِذِ إِذَا کُسِرَتْ۔","","Musannaf Ibn Abi Shaybah 27865","","","كتاب الديات"
"27866","(۲۷۸۶۶) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ أَبِی بَکْرِ بْنِ حَفْصٍ ، قَالَ : رَأَیْتُ ابْنَ الزُّبَیْرِ أَقَادَ مِنْ مَأْمُومَۃٍ ۔ قَالَ : فَرَأَیْتُہُمَا یَمْشِیَانِ مَأْمُومَیْنِ جَمِیعًا۔","Da'if","Musannaf Ibn Abi Shaybah 27866","","","كتاب الديات"
"27867","(۲۷۸۶۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ؛ أَنَّ ابْنَ الزُّبَیْرِ أَقَادَ مِنْ مُنَقِّلَۃٍ۔","","Musannaf Ibn Abi Shaybah 27867","","","كتاب الديات"
"27868","(۲۷۸۶۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ؛ أَنَّ ابْنَ الزُّبَیْرِ أَقَادَ مِنْ مُنَقِّلَۃٍ ، قَالَ : فَأُعْجِبَ النَّاسُ ، أَوْ جَعَلَ النَّاسَ یَعجَبُونَ۔","Sahih","Musannaf Ibn Abi Shaybah 27868","","","كتاب الديات"
"27869","(۲۷۸۶۹) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنْ عُمَرَ ، قَالَ : إِنَّا لاَ نُقِیدُ مِنَ الْعِظَامِ۔","","Musannaf Ibn Abi Shaybah 27869","","","كتاب الديات"
"27870","(۲۷۸۷۰) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَیْسَ فِی الْعِظَامِ قِصَاصٌ۔","","Musannaf Ibn Abi Shaybah 27870","","","كتاب الديات"
"27871","(۲۷۸۷۱) حَدَّثَنَا جَرِیرٌ، عَنْ حُصَیْنٍ، قَالَ: کَتَبَ عُمَرُ بْنُ عَبْدِالْعَزِیزِ: مَا کَانَ مِنْ کَسْرٍ فِی عَظْمٍ فَلاَ قِصَاصَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 27871","","","كتاب الديات"
"27872","(۲۷۸۷۲) حَدَّثَنَا شَرِیکٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ (ح) وَعَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ قَالاَ : لاَ قِصَاصَ فِی عَظْمٍ۔","","Musannaf Ibn Abi Shaybah 27872","","","كتاب الديات"
"27873","(۲۷۸۷۳) حَدَّثَنَا ابْنُ إِدْرِیسَ، عَنِ الشَّیْبَانِیِّ، عَنِ الشَّعْبِیِّ، قَالَ: لَیْسَ فِی شَیْئٍ مِنَ الْعِظَام[corrupt] قِصَاصٌ، إِلاَّ الْوَجْہَ وَالرَّأْسَ۔","","Musannaf Ibn Abi Shaybah 27873","","","كتاب الديات"
"27874","(۲۷۸۷۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لَیْسَ فِی کَسْرِ الْعِظَامِ قِصَاصٌ۔","","Musannaf Ibn Abi Shaybah 27874","","","كتاب الديات"
"27875","(۲۷۸۷۵) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، وَالْحَسَنِ ، قَالاَ : لَیْسَ فِی عَظْمٍ قِصَاصٌ۔","","Musannaf Ibn Abi Shaybah 27875","","","كتاب الديات"
"27876","(۲۷۸۷۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : إِذَا کُسِرَتِ الْیَدُ وَالسَّاقُ فَلَیْسَ عَلَی کَاسِرِہَا قَوَدٌ ، وَلَکِنْ عَلَیْہِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27876","","","كتاب الديات"
"27877","(۲۷۸۷۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ قَتَادَۃَ ، عَن خِلاَسٍ ، عَنْ عَلِیٍّ؛ أَنَّہُ کَانَ یضَمِّنُ الْقَائِدَ، وَالسَّائِقَ، وَالرَّاکِبَ۔","","Musannaf Ibn Abi Shaybah 27877","","","كتاب الديات"
"27878","(۲۷۸۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصَیْنٍ ، عَنْ شُرَیْحٍ (ح) وَعَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، (ح) وَعَنْ طَارِقٍ ، عَنِ الشَّعْبِیِّ ، قَالُوا : یضَمِّنُ الْقَائِدَ ، وَالسَّائِقَ ، وَالرَّاکِبَ۔","","Musannaf Ibn Abi Shaybah 27878","","","كتاب الديات"
"27879","(۲۷۸۷۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إِسْمَاعِیلَ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَمِعْتُُُہ یَقُولُ : إِذَا سَاقَ الرَّجُلُ دَابَّتَہُ سَوْقًا رَفِیقًا فَلاَ ضَمَانَ عَلَیْہِ ، وَإِذَا أَعَنْفَ فِی سَوْقِہَا فَأَصَابَتْ ، فَہُوَ ضَامِنٌ۔","","Musannaf Ibn Abi Shaybah 27879","","","كتاب الديات"
"27880","(۲۷۸۸۰) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : یَضْمَنُ السَّائِقُ وَالْقَائِدُ۔","","Musannaf Ibn Abi Shaybah 27880","","","كتاب الديات"
"27881","(۲۷۸۸۱) حَدَّثَنَا عَبَّادٌ ، عَنْ عُمَرَ بْنِ عَامِرٍ ، عَنْ قَتَادَۃَ ، عَن خِلاَسٍ ، عَنْ عَلِیٍّ ، قَالَ : إِذَا کَانَ الطَّرِیقُ وَاسِعًا فَلاَ ضَمَانَ عَلَیْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 27881","","","كتاب الديات"
"27882","(۲۷۸۸۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : یَغْرَمُ الْقَائِدُ ، قُلْتُ : وَالسَّائِقُ یَغْرَمُ عَنِ الْیَدِ وَالرِّجْلِ ؟ قَالَ : زَعَمُوا أَنَّہُ یَغْرَمُ عَنِ الْیَدِ ، فَرَادَدْتُہُ ، فَقَالَ : یَقُولُ : الطَّرِیقَ الطَّرِیقَ۔","","Musannaf Ibn Abi Shaybah 27882","","","كتاب الديات"
"27883","(۲۷۸۸۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَن زُہَیْرٍ ، عَنِ الْحَسَنِ بْنِ الْحُرِّ ، عَنِ الْحَکَمِ ، قَالَ : إِنَّ السَّائِقَ ، وَالْقَائِدَ ، وَالرَّاکِبَ یَغْرَمُ مَا أَصَابَتْ دَابَّتُہُ بِیَدٍ ، أَوْ رِجْلٍ ، وَطِئَتْ ، أَوْ ضَرَبَتْ۔","","Musannaf Ibn Abi Shaybah 27883","","","كتاب الديات"
"27884","(۲۷۸۸۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن زُہَیْرٍ ، عَنْ لَیْثٍ ، عَن طَاوُوسٍ ، قَالَ : یَضْمَنُ الْقَائِدُ ، وَالسَّائِقُ ، وَالرَّاکِبُ مَا أَصَابَتْ بِمُقَدَّمِہَا۔","","Musannaf Ibn Abi Shaybah 27884","","","كتاب الديات"
"27885","(۲۷۸۸۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ قَتَادَۃَ ، عَن خِلاَسٍ ، عَنْ عَلِیٍّ ، قَالَ : یُضَمِّنُ الرَّدِیفَان۔","","Musannaf Ibn Abi Shaybah 27885","","","كتاب الديات"
"27886","(۲۷۸۸۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، قَالَ : لَیْسَ عَلَی الرِّدْفِ ضَمَانٌ۔","","Musannaf Ibn Abi Shaybah 27886","","","كتاب الديات"
"27887","(۲۷۸۸۷) حَدَّثَنَا وَکِیعٌ ، عَن حَسَنٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ؛ فِی الرِّدْفِ ، قَالَ : ہُمَا شَرِیکَانِ۔","","Musannaf Ibn Abi Shaybah 27887","","","كتاب الديات"
"27888","(۲۷۸۸۸) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : الرَّاکِبُ وَالرِّدْفُ سَوَائٌ ، مَا أَوْطَأا ، فَہُوَ بَیْنَہُمَا نِصْفَانِ۔","","Musannaf Ibn Abi Shaybah 27888","","","كتاب الديات"
"27889","(۲۷۸۸۹) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ، عَنْ أَبِی الْعَلاَئِ، عَنْ قَتَادَۃَ، وَأَبِی ہَاشِمٍ، قَالاَ: یَضْمَنُ الرِّدْفُ مَا یَضْمَنُ الْمُقَدَّمُ۔","","Musannaf Ibn Abi Shaybah 27889","","","كتاب الديات"
"27890","(۲۷۸۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : یَضْمَنُ الرِّدْفُ۔","","Musannaf Ibn Abi Shaybah 27890","","","كتاب الديات"
"27891","(۲۷۸۹۱) حَدَّثَنَا أَبُو بَکْرٍ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : الْعَقْلُ عَلَی أَہْلِ الدِّیوَانِ۔","","Musannaf Ibn Abi Shaybah 27891","","","كتاب الديات"
"27892","(۲۷۸۹۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی حُرَّۃَ ، عَنِ الْحَسَنِ ، قَالَ : الْعَقْلُ عَلَی أَہْلِ الدِّیوَانِ۔","","Musannaf Ibn Abi Shaybah 27892","","","كتاب الديات"
"27893","(۲۷۸۹۳) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَن حَسَنٍ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَکَمِ ، قَالَ : عُمَرُ أَوَّلُ مَنْ جَعَلَ الدِّیَۃَ عَشَرَۃً عَشَرَۃً فِی أَعْطِیَاتِ الْمُقَاتَلَۃِ دُونَ النَّاسِ۔","","Musannaf Ibn Abi Shaybah 27893","","","كتاب الديات"
"27894","(۲۷۸۹۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ ابْنٍ لِمُحَمَّدِ بْنِ إِبْرَاہِیمَ التَّیْمِیِّ ، عَنْ أَبِیہِ ، عَنِ السَّلُولِیِّ ، عَن مُعَاذِ بْنِ جَبَلٍ ، عَنْ أَبِی عُبَیْدَۃَ بْنِ الْجَرَّاحِ ، قَالَ : جِنَایَۃُ الْمُدَبَّرِ عَلَی مَوْلاَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 27894","","","كتاب الديات"
"27895","(۲۷۸۹۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : جِنَایَۃُ الْمُدَبَّرِ عَلَی مَوْلاَہُ۔","","Musannaf Ibn Abi Shaybah 27895","","","كتاب الديات"
"27896","(۲۷۸۹۶) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ قَالَ : حدَّثَنِی یُسَیْرٌ الْمُکْتِبُ ، أَنَّ امْرَأَۃً دَبَّرَتْ جَارِیَۃً لَہَا فَجَنَتْ جِنَایَۃً ، فَقَضَی عُمَرُ بْنُ عَبْدِ الْعَزِیزِ بِجِنَایَتِہَا عَلَی مَوْلاَتِہَا فِی قِیمَۃِ الْجَارِیَۃِ۔","","Musannaf Ibn Abi Shaybah 27896","","","كتاب الديات"
"27897","(۲۷۸۹۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَن یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی جِنَایَۃِ الْمُدَبَّرِ ، قَالَ : ہُوَ عَبْدٌ ، إِنْ شَائَ مَوْلاَہُ أَسْلَمَہُ ، وَإِنْ شَائَ فَدَاہُ۔","","Musannaf Ibn Abi Shaybah 27897","","","كتاب الديات"
"27898","(۲۷۸۹۸) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا قَتَلَ الْمُدَبَّرُ قَتِیلاً ، أَوْ فَقَأَ عَیْنًا ، قِیلَ لِمَوْلاَہُ : ادْفَعْہُ ، أَوِ افْدِہِ۔","","Musannaf Ibn Abi Shaybah 27898","","","كتاب الديات"
"27899","(۲۷۸۹۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ، عَنْ عَامِرٍ، قَالَ: جِنَایَۃُ الْمُدَبَّرِ، وَأُمِّ الْوَلَدِ عَلَی عَاقِلَۃِ مَوَالِیہَا۔","","Musannaf Ibn Abi Shaybah 27899","","","كتاب الديات"
"27900","(۲۷۹۰۰) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَن حَمَّادٍ، قَالَ: عَلَی مَوَالِیہِمُ الدِّیَۃُ إِذَا قَتَلُوا، وَإِنْ قتلوا فَدِیَتُہُمْ دِیَۃُ الْمَمْلُوکِ۔","","Musannaf Ibn Abi Shaybah 27900","","","كتاب الديات"
"27901","(۲۷۹۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَن خَالِدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : جِنَایَۃُ الْمُدَبَّرِ عَلَی سَیِّدِہِ۔","","Musannaf Ibn Abi Shaybah 27901","","","كتاب الديات"
"27902","(۲۷۹۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَمِعْتُ سُفْیَانَ یَقُولُ : جِنَایَۃُ الْمُدَبَّرِ عَلَی مَوْلاَہُ ، یَضْمَنُ قِیمَتَہُ ۔ قَالَ ابْنُ أَبِی لَیْلَی فِی الْمُدَبَّرِ : عَلَیْہِ جَمِیعُ الْجِنَایَۃِ۔","","Musannaf Ibn Abi Shaybah 27902","","","كتاب الديات"
"27903","(۲۷۹۰۳) حَدَّثَنَا ہُشَیْمٌ ، عَن یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : جِنَایَۃُ الْمُکَاتَبِ فِی رَقَبَتِہِ ، یَبْدَأُ بِہَا۔","","Musannaf Ibn Abi Shaybah 27903","","","كتاب الديات"
"27904","(۲۷۹۰۴) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الشَّیْبَانِیِّ ، عَن حَمَّادٍ ، قَالَ : یَسْعَی فِیہَا وَفِی الْمُکَاتَبَۃِ بِالْحِصَصِ۔","","Musannaf Ibn Abi Shaybah 27904","","","كتاب الديات"
"27905","(۲۷۹۰۵) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : جِنَایَۃُ الْمُکَاتَبِ فِی رَقَبَتِہِ۔","","Musannaf Ibn Abi Shaybah 27905","","","كتاب الديات"
"27906","(۲۷۹۰۶) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَن خَالِدٍ، عَنْ أَبِی مَعْشَرٍ، عَنْ إِبْرَاہِیمَ ، قَالَ: جِنَایَۃُ الْمُکَاتَبِ عَلَی سَیِّدِہِ۔","","Musannaf Ibn Abi Shaybah 27906","","","كتاب الديات"
"27907","(۲۷۹۰۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ أَصْحَابِہِ ، أَوْ عَنْ إِبْرَاہِیمَ ، قَالَ : مَا جَنَی الْمُکَاتَبُ فَہُوَ فِی رَقَبَتِہِ ، یُؤَدِّی جِنَایَتَہُ وَمُکَاتَبَتَہُ جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 27907","","","كتاب الديات"
"27908","(۲۷۹۰۸) حَدَّثَنَا وَکِیعٌ ، سَمِعْت سُفْیَانَ یَقُولُ : جِنَایَۃُ الْمُکَاتَبِ فِی رَقَبَتِہِ۔","","Musannaf Ibn Abi Shaybah 27908","","","كتاب الديات"
"27909","(۲۷۹۰۹) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : مَا جُنِیَ عَلَی الْمُکَاتَبِ فَہُوَ لَہُ ، یَسْتَعِینُ بِہِ فِی کِتَابَتِہِ ، کَذَا کَانَ یَقُولُ مَنْ کَانَ قَبْلَکُمْ۔","","Musannaf Ibn Abi Shaybah 27909","","","كتاب الديات"
"27910","(۲۷۹۱۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : مَا جُنِیَ عَلَی الْمُکَاتَبِ ، فَہُوَ لَہُ۔","","Musannaf Ibn Abi Shaybah 27910","","","كتاب الديات"
"27911","(۲۷۹۱۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَمِعْتُ سُفْیَانَ ، یَقُولُ : إِذَا جُنِیَ عَلَیْہِ کَانَ لَہُ ، دُونَ مَوْلاَہُ۔","","Musannaf Ibn Abi Shaybah 27911","","","كتاب الديات"
"27912","(۲۷۹۱۲) حَدَّثَنَا إِبْرَاہِیمُ بْنُ صَدَقَۃَ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الْحَکَمِ ؛ أَنَّہُ کَانَ یَقُولُ فِی جِنَایَۃِ أُمِّ الْوَلَدِ : لاَ تَعْدُو قِیمَتَہَا ۔ وَقَالَ حَمَّادٌ : دِیَۃُ مَا جَنَتْ۔","","Musannaf Ibn Abi Shaybah 27912","","","كتاب الديات"
"27913","(۲۷۹۱۳) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَن خَالِدٍ، عَنْ أَبِی مَعْشَرٍ، عَنْ إِبْرَاہِیمَ ، قَالَ : جِنَایَۃُ أُمِّ الْوَلَدِ عَلَی سَیِّدِہَا۔","","Musannaf Ibn Abi Shaybah 27913","","","كتاب الديات"
"27914","(۲۷۹۱۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ فِی أُمِّ الْوَلَدِ إِذَا جَنَتْ جِنَایَۃً ، فَعَلَی سَیِّدِہَا جِنَایَتُہَا۔","","Musannaf Ibn Abi Shaybah 27914","","","كتاب الديات"
"27915","(۲۷۹۱۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَن یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی أُمِّ الْوَلَدِ تَجْنِی ، قَالَ : تُقَوَّمُ عَلَی سَیِّدِہَا۔","","Musannaf Ibn Abi Shaybah 27915","","","كتاب الديات"
"27916","(۲۷۹۱۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن زَکَرِیَّا ، قَالَ : سُئِلَ عَامِرٌ عَن سُرِّیَّۃٍ قَتَلَتِ امْرَأَۃً ، وَمَوْلاَہَا حَیٌّ لَمْ یُعْتِقْہَا ، وَقَدْ وَلَدَتْ لَہُ ؟ قَالَ : ہِیَ أَمَۃٌ ، إِنْ شَائَ مَوْلاَہَا أَدَّی عَنْہَا ، وَإِنْ شَائَ أَسْلَمَہَا بِرُمَّتِہَا۔","","Musannaf Ibn Abi Shaybah 27916","","","كتاب الديات"
"27917","(۲۷۹۱۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَنْ زَیْدٍ ، قَالَ : فِی الْعَقْلِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27917","","","كتاب الديات"
"27918","(۲۷۹۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، قَالَ : فِی الْعَقْلِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27918","","","كتاب الديات"
"27919","(۲۷۹۱۹) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ الأَشْعَثِ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ أَفْزَعَ رَجُلاً فَذَہَبَ عَقْلُہُ ، قَالَ : لَوْ أَدْرَکَہُ عُمَرُ لَضَمَّنَہُ۔","","Musannaf Ibn Abi Shaybah 27919","","","كتاب الديات"
"27920","(۲۷۹۲۰) حَدَّثَنَا سُلَیْمَانُ بْنُ حَیَّانَ ، عَنْ عَوْفٍ ، قَالَ : سَمِعْتُ شَیْخًا قَبْلَ فِتْنَۃِ ابْنِ الأَشْعَثِ فَنَعَتَ نَعْتَہُ ، قَالُوا ذَلِکَ أَبُو الْمُہَلَّبِ عَمُّ أَبِی قِلاَبَۃَ ، قَالَ : رَمَی رَجُلٌ رَجُلاً فِی رَأْسِہِ بِحَجَرٍ ، فَذَہَبَ سَمْعُہُ وَلِسَانُہُ وَعَقْلُہُ وَذَکَرُہُ ، فَلَمْ یَقْرَبِ النِّسَائَ ، فَقَضَی فِیہِ عُمَرُ بِأَرْبَعِ دِیَاتٍ۔","Hasan","Musannaf Ibn Abi Shaybah 27920","","","كتاب الديات"
"27921","(۲۷۹۲۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : مَنْ أَخْرَجَ حَجَرًا ، أَوْ مِرْزَابًا ، أَوْ زَادَ فِی سَاحَتِہِ مَا لَیْسَ لَہُ ، فَہُوَ ضَامِنٌ۔","Da'if","Musannaf Ibn Abi Shaybah 27921","","","كتاب الديات"
"27922","(۲۷۹۲۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : مَنْ بَنَی فِی غَیْرِ سَمَائِہِ ، فَہُوَ ضَامِنٌ۔","","Musannaf Ibn Abi Shaybah 27922","","","كتاب الديات"
"27923","(۲۷۹۲۳) حَدَّثَنَا جَرِیرٌ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ شُرَیْحٍ ، قَالَ : کَانَ یُضَمِّنُ أَصْحَابَ الْبَلاَلِیعِ الَّتِی یَتَّخِذُونَہَا فِی الطَّرِیقِ ، وبواری الْبِغَالِ ، وَالْخَشَبِ الَّذِی یُجْعَلُ فِی الْحِیطَانِ ، وَکَانَ لاَ یُضَمِّنُ الآبَارَ الْخَارِجَۃَ الَّتِی أَمَامَ الْکُوفَۃِ فِی الْجَبَّانَۃِ ، وَالَّتِی فِی الْمَقَابِرِ ، وَمَا جُعِلَ مَنْفَعَۃً لِلْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 27923","","","كتاب الديات"
"27924","(۲۷۹۲۴) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَن طَاوُوسٍ ، قَالَ : مَنْ أَوْتَد وَتِدًا فِی غَیْرِ أَرْضِہِ ، وَلاَ سَمَائِہِ ضَمِنَ مَا أَصَابَ ، وَمَنَ احْتَفَرَ بِئْرًا فِی غَیْرِ أَرْضِہِ ، وَلاَ سَمَائِہِ ، فَہُوَ ضَامِنٌ مَا وَقَعَ فِیہَا۔","","Musannaf Ibn Abi Shaybah 27924","","","كتاب الديات"
"27925","(۲۷۹۲۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، قَالَ : مَنْ أَخْرَجَ مِنْ دَارِہِ شَیْئًا إِلَی طَرِیقٍ فَأَصَابَ شَیْئًا ، فَہُوَ لَہُ ضَامِنٌ ؛ مِنْ حَجَرٍ ، أَوْ عُودٍ ، أَوْ حَفَرَ بِئْرًا فِی طَرِیقِ الْمُسْلِمِینَ ، تُؤْخَذُ دِیَتُہُ ، وَلاَ یُقَادُ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 27925","","","كتاب الديات"
"27926","(۲۷۹۲۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، قَالَ: مَنْ أَحْدَثَ شَیْئًا فِی طَرِیقِ الْمُسْلِمِینَ، فَہُوَ ضَامِنٌ۔","","Musannaf Ibn Abi Shaybah 27926","","","كتاب الديات"
"27927","(۲۷۹۲۷) حَدَّثَنَا أَبُو خَالِدٍ، عَنْ عَمْرٍو، عَنِ الْحَسَنِ، رَفَعَہُ، قَالَ: مَنْ أَخْرَجَ مِنْ حَدِّہِ شَیْئًا فَأَصَابَ شَیْئًا، فَہُوَ ضَامِنٌ۔ (بزار ۳۶۶۴)","Da'if","Musannaf Ibn Abi Shaybah 27927","","","كتاب الديات"
"27928","(۲۷۹۲۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا أَخْرَجَ الرَّجُلُ الصَّلاَیَۃَ أَوِ الْخَشَبَۃَ فِی حَائِطِہِ ضَمِنَ۔","","Musannaf Ibn Abi Shaybah 27928","","","كتاب الديات"
"27929","(۲۷۹۲۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَن وَاصِلٍ الأَحْدَبِ الأَسَدِیِّ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَانَ یَقْطَعُ الْکُنُفَ ، أَوْ یَأْمُرُ بِقَطْعِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 27929","","","كتاب الديات"
"27930","(۲۷۹۳۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ شُرَیْحٍ ؛ أَنَّہُ کَانَ یُضَمِّنُ باریَّ السُّوقِیِّ وَعَمُودَہُ ، وَیَقُولُ : أَخْرَجَہُ فِی غَیْرِ مِلْکِہِ۔","","Musannaf Ibn Abi Shaybah 27930","","","كتاب الديات"
"27931","(۲۷۹۳۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّ عَمْرَو بْنَ الْحَارِثِ بْنِ الْمُصْطَلِقِ حَفَرَ بِئْرًا فِی طَرِیقِ الْمُسْلِمِینَ ، فَوَقَعَ فِیہَا بَغْلٌ فَانْکَسَرَ ، فَضَمَّنَہُ شُرَیْحٌ۔","","Musannaf Ibn Abi Shaybah 27931","","","كتاب الديات"
"27932","(۲۷۹۳۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِیسَی بْنُ دِینَارٍ ، عَنْ أَبِیہِ ، أَنَّ عَمْرَو بْنَ الْحَارِثِ حَفَرَ بِئْرًا فِی طَرِیقِ الْمُسْلِمِینَ ، فَمَرَّ بَغْلٌ ، فَوَقَعَ فِیہَا ، فَانْکَسَرَ ؛ فَضَمَّنَہُ شُرَیْحٌ قِیمَۃَ الْبَغْلِ ، مِئَتَیْ دِرْہَمٍ ، وَأَعْطَاہُ الْبَغْلَ۔","","Musannaf Ibn Abi Shaybah 27932","","","كتاب الديات"
"27933","(۲۷۹۳۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنِ الْحَسَنِ أَبِی مُسَافِرٍ ؛ أَنَّ کَنِیفًا لِجَارٍ لَہُ وَقَعَ عَلَی صَبِیٍّ فَقَتَلَہُ، أَوْ جَرَحَہُ ، فَقَالَ شُرَیْحٌ : لَوْ أُتِیتُ بِہِ لَضَمَّنْتہ۔","","Musannaf Ibn Abi Shaybah 27933","","","كتاب الديات"
"27934","(۲۷۹۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ إِسْمَاعِیلَ ، عَنِ الْحَارِثِ ، عَنْ شُرَیْحٍ ؛ أَنَّہُ کَانَ لاَ یَدَعُ ظُلَّۃً لاَ یَمُرُّ فِیہَا الْفَارِسُ بِرُمْحِہِ ، وَیَقُولُ : بَنَیْتُمْ عَلَی رُمْحِ الْفَارِسِ۔","","Musannaf Ibn Abi Shaybah 27934","","","كتاب الديات"
"27935","(۲۷۹۳۵) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنِ ابْنِ عَوْنٍ، عَنِ ابْنِ سِیرِینَ، قَالَ: کَانُوا یُغَرِّمُونَ مِنَ الْوَطْئِ، وَلاَ یَغْرَمُونَ مِنَ النَّفْحَۃِ۔","","Musannaf Ibn Abi Shaybah 27935","","","كتاب الديات"
"27936","(۲۷۹۳۶) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَن مَنْصُورٍ، عَنْ إِبْرَاہِیمَ، قَالَ: لاَ یُضْمَنُ صَاحِبُ الدَّابَّۃِ مِنَ النَّفْحَۃِ۔","","Musannaf Ibn Abi Shaybah 27936","","","كتاب الديات"
"27937","(۲۷۹۳۷) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ؛ أَنَّہُ بَرَّأَ مِنَ النَّفْحَۃِ۔","","Musannaf Ibn Abi Shaybah 27937","","","كتاب الديات"
"27938","(۲۷۹۳۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی قَیْسٍ ، عَن ہُزَیْلٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الرِّجْلُ جُبَارٌ ، یَعْنِی ہَدَرًا۔ (عبدالرزاق ۱۸۳۷۶۔ دارقطنی ۲۱۳)","","Musannaf Ibn Abi Shaybah 27938","","","كتاب الديات"
"27939","(۲۷۹۳۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : صَاحِبُ الدَّابَّۃِ ضَامِنٌ لِمَا أَصَابَتِ الدَّابَّۃُ بِیَدِہَا ، أَوْ بِرِجْلِہَا ، حَتَّی یَنْزِلَ عَنہَا۔","","Musannaf Ibn Abi Shaybah 27939","","","كتاب الديات"
"27940","(۲۷۹۴۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنْ رَجُلٍ وَاقِفٍ عَلَی دَابَّتِہِ ، فَضَرَبَتْ بِرِجْلِہَا ؟ قَالَ حَمَّادٌ : لاَ یَضْمَنُ ، وَقَالَ الْحَکَمُ : یَضْمَنُ۔","","Musannaf Ibn Abi Shaybah 27940","","","كتاب الديات"
"27941","(۲۷۹۴۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : مَا کَانُوا یُضَمِّنُونَ مِنَ الرِّجْلِ إِلاَّ مَا رَدَّ الْعِنَانَ۔","","Musannaf Ibn Abi Shaybah 27941","","","كتاب الديات"
"27942","(۲۷۹۴۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ ، قَالَ : إِذَا ضَرَبَتِ الدَّابَّۃُ أَوْ کَبَحْتہَا ، فَأَنْتَ ضَامِنٌ۔","","Musannaf Ibn Abi Shaybah 27942","","","كتاب الديات"
"27943","(۲۷۹۴۳) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی سَلَمَۃَ ، وَسَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ، یَبْلُغُ بِہِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْعَجْمَائُ جَرْحُہَا جُبَارٌ ، وَالْبِئْرُ جُبَارٌ ، وَالْمَعْدِنُ جُبَارٌ ، وَفِی الرِّکَازِ الْخُمُسُ۔ (بخاری ۱۴۹۹۔ مسلم ۶۹۱۲)","Sahih","Musannaf Ibn Abi Shaybah 27943","","","كتاب الديات"
"27944","(۲۷۹۴۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ مُحَمَّدِ بْنِ زِیَادٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، مِثْلَہُ ، إِلاَّ أَنَّہُ لَمْ یَذْکُرْ جَرْحَہَا۔ (بخاری ۶۹۱۳۔ مسلم ۱۳۳۵)","Sahih","Musannaf Ibn Abi Shaybah 27944","","","كتاب الديات"
"27945","(۲۷۹۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : الْبَہِیمَۃُ عَقْلُہَا جُبَارٌ ، وَالْمَعْدِنُ عَقْلُہُ جُبَارٌ ، وَالْبِئْرُ عَقْلُہَا جُبَارٌ ، وَفِی الرِّکَازِ الْخُمُسُ۔ (احمد ۲۲۸۔ طحاوی ۲۰۴)","Sahih","Musannaf Ibn Abi Shaybah 27945","","","كتاب الديات"
"27946","(۲۷۹۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُغِیرَۃُ بْنُ أَبِی الْحُرِّ ؛ أَنَّ بَعِیرًا افْتَرَسَ رَجُلاً فَقَتَلَہُ ، فَجَائَ رَجُلٌ فَقَتَلَ الْبَعِیرَ ، فَأَبْطَلَ شُرَیْحٌ دِیَۃَ الرَّجُلِ ، وَضَمَّنَ الرَّجُلَ ثَمَنَ الْبَعِیرِ۔","","Musannaf Ibn Abi Shaybah 27946","","","كتاب الديات"
"27947","(۲۷۹۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّ بَعِیرًا افْتَرَسَ رَجُلاً فَقَتَلَہُ ، فَجَائَ رَجُلٌ فَقَتَلَ الْبَعِیرَ ، فَأَبْطَلَ شُرَیْحٌ دِیَۃَ الرَّجُلِ ، وَضَمَّنَ الرَّجُلَ قِیمَۃَ الْبَعِیرِ۔","","Musannaf Ibn Abi Shaybah 27947","","","كتاب الديات"
"27948","(۲۷۹۴۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : یَغْرَمُ قَاتِلُ الْبَہِیمَۃِ ، وَلاَ یَغْرَمُ أَہْلُہَا مَا قَتَلَتْ۔","","Musannaf Ibn Abi Shaybah 27948","","","كتاب الديات"
"27949","(۲۷۹۴۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَن زَمْعَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ : اقْتُلُوا الْفَحْلَ إِذَا عَدَا عَلَیْکُمْ ، وَلاَ غُرْمَ عَلَیْکُمْ۔","","Musannaf Ibn Abi Shaybah 27949","","","كتاب الديات"
"27950","(۲۷۹۵۰) حَدَّثَنَا مُحَمَّدُ بْنُ میسَّرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ الْکَرِیمِ ؛ أَنَّ فَحْلاً عَدَا عَلَی رَجُلٍ فَقَتَلَہُ ، فَرُفِعَ إِلَی أَبِی بَکْرٍ فَأَغْرَمَہُ ، وَقَالَ : بَہِیمَۃٌ لاَ تُعْقَلُ۔","","Musannaf Ibn Abi Shaybah 27950","","","كتاب الديات"
"27951","(۲۷۹۵۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ ، عَنِ الْحَیِّ ؛ أَنَّ غُلاَمًا مِنْ قَوْمِہِ دَخَلَ عَلَی نَجِیبَۃٍ لِزَیْدِ بْنِ صُوحَانَ فِی دَارِہِ ، فَخَبَطَتْہُ فَقَتَلَتْہُ ، فَجَائَ أَبُوہُ بِالسَّیْفِ فَعَقَرَہَا ، فَرُفِعَ ذَلِکَ إِلَی عُمَرَ ، فَأَہْدَرَ دَمَ الْغُلاَمِ ، وَضَمَّنَ أَبَاہُ ثَمَنَ النَّجِیبَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 27951","","","كتاب الديات"
"27952","(۲۷۹۵۲) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَلْقَی الْبَہِیمَۃَ فَیَخَافُہَا عَلَی نَفْسِہِ ، قَالَ : یَقْتُلُہَا ، وَثَمَنُہَا عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 27952","","","كتاب الديات"
"27953","(۲۷۹۵۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَیَعْلَی بْنُ عُبَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی رَجُلٍ عَدَا عَلَیْہِ فَحْلٌ فَضَرَبَہُ بِالسَّیْفِ ، أَیُضَمَّنُ ؟ قَالَ : نَعَمْ ، إِلاَّ أَنَّ ابْنَ نُمَیْرٍ قَالَ : یُضَمَّنُ۔","","Musannaf Ibn Abi Shaybah 27953","","","كتاب الديات"
"27954","(۲۷۹۵۴) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ سُئِلَ عَنِ الْمُہْرِ یَتْبَعُ أُمَّہُ ؟ قَالَ : ہُوَ ضَامِنٌ ، لأَنَّہُ أَرْسَلَہُ۔","","Musannaf Ibn Abi Shaybah 27954","","","كتاب الديات"
"27955","(۲۷۹۵۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ؛ فِی الْمُہْرِ یَتْبَعُ أُمَّہُ ، قَالَ : یَضْمَنُ۔","","Musannaf Ibn Abi Shaybah 27955","","","كتاب الديات"
"27956","(۲۷۹۵۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ؛ سَأَلْتہمَا عَنِ الْمُہْرِ یَتْبَعُ أُمَّہُ فَیُصِیبُ ؟ قَالاَ : یَضْمَنُ۔","","Musannaf Ibn Abi Shaybah 27956","","","كتاب الديات"
"27957","(۲۷۹۵۷) حَدَّثَنَا الْبَکْرَاوِیُّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یَضْمَنُ۔","","Musannaf Ibn Abi Shaybah 27957","","","كتاب الديات"
"27958","(۲۷۹۵۸) حَدَّثَنَا حَفْصٌ ، عَنِ الْحَجَّاجِ ، عَنِ الْقَاسِمِ بْنِ نَافِعٍ ، قَالَ : قَالَ عُمَرُ : مَا أَصَابَ الْمُنْفَلِتُ فَلاَ ضَمَانَ عَلَی صَاحِبِہِ ، وَمَنْ أَصَابَ الْمُنْفَلِتَ ضَمِنَ۔","","Musannaf Ibn Abi Shaybah 27958","","","كتاب الديات"
"27959","(۲۷۹۵۹) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ؛ فِی الدَّابَّۃِ الْمُرْسَلَۃِ تُصِیبُ ؟ قَالاَ : لَیْسَ عَلَیْہِ ضَمَانٌ۔","","Musannaf Ibn Abi Shaybah 27959","","","كتاب الديات"
"27960","(۲۷۹۶۰) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : کُلُّ مُرْسَلَۃٍ فَصَاحِبُہَا ضَامِنٌ۔","","Musannaf Ibn Abi Shaybah 27960","","","كتاب الديات"
"27961","(۲۷۹۶۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَن حَمَّادٍ ؛ فِی رَجُلٍ انْفَلَتَتْ دَابَّتُہُ وَہُوَ فِی أَثَرِہَا ، فَأَصَابَتْ إِنْسَانًا ، قَالَ : لَیْسَ عَلَیْہِ شَیْئٌ ، وَقَالَ الْحَکَمُ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 27961","","","كتاب الديات"
"27962","(۲۷۹۶۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الْمُہَلِّبِ ، عَنْ عُمَرَ ، قَالَ : فِی عَیْنِ الدَّابَّۃِ رُبُعُ ثَمَنِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 27962","","","كتاب الديات"
"27963","(۲۷۹۶۳) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : فِی عَیْنِ الدَّابَّۃِ رُبُعُ ثَمَنِہَا۔","","Musannaf Ibn Abi Shaybah 27963","","","كتاب الديات"
"27964","(۲۷۹۶۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ قَالَ : قضَی عُمَرُ فِی عَیْنِ الدَّابَّۃِ رُبُعَ ثَمَنِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 27964","","","كتاب الديات"
"27965","(۲۷۹۶۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَتَبَ ہِشَامُ بْنُ ہُبَیْرَۃَ قَاضِی الْبَصْرَۃِ إِلَی شُرَیْحٍ یَسْأَلُہُ عَنْ عَیْنِ الدَّابَّۃِ ؟ فَکَتَبَ إِلَیْہِ : إِنَّ فِی عَیْنِ الدَّابَّۃِ رُبُعَ ثَمَنِہَا۔","","Musannaf Ibn Abi Shaybah 27965","","","كتاب الديات"
"27966","(۲۷۹۶۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ رَجُلٍ یُقَالُ لَہُ : حَبِیبٌ ، عَنْ شُرَیْحٍ ؛ أَنَّہُ قَالَ : فِی عَیْنِ الدَّابَّۃِ رُبُعُ ثَمَنِہَا۔","","Musannaf Ibn Abi Shaybah 27966","","","كتاب الديات"
"27967","(۲۷۹۶۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَن حَمَّادٍ ، أَوْ عَن یَزِیدَ بْنِ الْوَلِیدِ ، عَن حَمَّادٍ ؛ فِی الرَّجُلِ یَفْقَأُ عَیْنَ الدَّابَّۃِ الْعَوْرَائِ ، قَالَ : یُؤَدِّی قِیمَتَہَا عَوْرَائَ ، وَیَأْخُذُ الدَّابَّۃَ۔","","Musannaf Ibn Abi Shaybah 27967","","","كتاب الديات"
"27968","(۲۷۹۶۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، عَنْ شُرَیْحٍ ؛ قَالَ : أَتَانِی عُرْوَۃُ الْبَارِقِیُّ مِنْ عَندِ عُمَرَ : أَنَّ فِی عَیْنِ الدَّابَّۃِ رُبُعَ ثَمَنِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 27968","","","كتاب الديات"
"27969","(۲۷۹۶۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، عَنْ شُرَیْحٍ ، قَالَ: فِی ذَنَبِ الدَّابَّۃِ إِذَا اسْتُؤْصِلَ رُبُعُ ثَمَنِہَا۔","","Musannaf Ibn Abi Shaybah 27969","","","كتاب الديات"
"27970","(۲۷۹۷۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ سُئِلَ عَنِ الدَّابَّۃِ یُقْطَعُ ذَنَبُہَا ، أَوْ أُذُنُہَا ؟ قَالَ : مَا نَقَصَہَا، فَإِذَا قُطِعَتْ یَدُہَا ، أَوْ رِجْلُہَا فَالْقِیمَۃُ۔","","Musannaf Ibn Abi Shaybah 27970","","","كتاب الديات"
"27971","(۲۷۹۷۱) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ؛ فِی رَجُلٍ قَطَعَ ذَنَبَ دَابَّۃٍ ، قَالَ : عَلَیْہِ ، ثَمَنُہَا ، وَتُدْفَعُ إِلَیْہِ الدَّابَّۃُ۔","","Musannaf Ibn Abi Shaybah 27971","","","كتاب الديات"
"27972","(۲۷۹۷۲) حَدَّثَنَا حَفْصٌ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، قَالَ: قَالَ عَلِیٌّ: مَنِ اسْتَعْمَلَ مَمْلُوکَ قَوْمٍ صَغِیرًا ، أَوْ کَبِیرًا، فَہُوَ ضَامِنٌ۔","","Musannaf Ibn Abi Shaybah 27972","","","كتاب الديات"
"27973","(۲۷۹۷۳) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ عَلِیٍّ ، قَالَ : مَنِ اسْتَعَانَ صَغِیرًا حُرًّا ، أَوْ عَبْدًا فَعَنِتَ ، فَہُوَ ضَامِنٌ ، وَمَنِ اسْتَعَانَ کَبِیرًا لَمْ یَضْمَنْ۔","Da'if","Musannaf Ibn Abi Shaybah 27973","","","كتاب الديات"
"27974","(۲۷۹۷۴) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا اسْتَعَنْتَ مَمْلُوکَ قَوْمٍ ، فَأَنْتَ ضَامِنٌ لِمَا أَصَابَہُ۔","","Musannaf Ibn Abi Shaybah 27974","","","كتاب الديات"
"27975","(۲۷۹۷۵) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَأْمُرُ الصَّبِیَّ بِالشَّیْئِ یَعْمَلُہُ بِغَیْرِ إِذْنِ أَہْلِہِ ، فَیَہْلِکُ الصَّبِیُّ ، قَالَ : عَلَیْہِ الضَّمَانُ ، فَإِنْ کَانَ اسْتَأْمَرَ أَہْلَہُ فَلاَ ضَمَانَ عَلَیْہِ ، وَفِی الْعَبْدِ مِثْلُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 27975","","","كتاب الديات"
"27976","(۲۷۹۷۶) حَدَّثَنَا ہُشَیمٌ ، عَنْ إِسْمَاعِیلَ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَمِعْتُہ یَقُولُ : إِذَا حَمَلَ الرَّجُلُ عَلَی دَابَّتِہِ غُلاَمًا لَمْ یَحْتَلِمْ ، فَأَصَابَ شَیْئًا ، فَہُوَ عَلَی الَّذِی حَمَلَہُ ، وَإِنْ کَانَ قَدْ بَلَغَ فَأَصَابَ شَیْئًا ، فَہُوَ ضَامِنٌ ، وَفِی الْعَبْدِ مِثْلُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 27976","","","كتاب الديات"
"27977","(۲۷۹۷۷) حَدَّثَنَا أَبُو عَاصِمٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إِنِ اسْتَأْجَرَہُ بِغَیْرِ إِذْنِہِمْ فَمَاتَ غَرِمَ۔","","Musannaf Ibn Abi Shaybah 27977","","","كتاب الديات"
"27978","(۲۷۹۷۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ الْمُبَارَکِ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : قَالَ الْمُغِیرَۃُ بْنُ شُعْبَۃَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْمَرْأَۃُ تَعْقِلُ عَنہَا عَصَبَتُہَا ، وَیَرِثُہَا بَنُوہَا۔","","Musannaf Ibn Abi Shaybah 27978","","","كتاب الديات"
"27979","(۲۷۹۷۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إِسْمَاعِیلَ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، سَمِعْتہ یَقُولُ : وَلَدُ الْمَرْأَۃِ الذَّکَرُ أَحَقُّ بِمِیرَاثِ مَوَالِیہَا مِنْ عَصَبَتِہَا ، وَإِنْ کَانَتْ جِنَایَۃُ عَقَلَ عَصَبَتُہَا۔","","Musannaf Ibn Abi Shaybah 27979","","","كتاب الديات"
"27980","(۲۷۹۸۰) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَن حَسَنِ بْنِ صَالِحٍ ، عَنْ فِرَاسٍ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ؛ فِی امْرَأَۃٍ أَعْتَقَتْ رَجُلاً ، ثُمَّ مَاتَتْ ، قَالَ : الْوَلاَئُ لِوَلَدِہَا وَالْعَقْلُ عَلَیْہِمْ۔ قَالَ : وَکَانَ عَامِرٌ یَقُولُ : الْوَلاَئُ لِوَلَدِہَا، وَالْعَقْلُ عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 27980","","","كتاب الديات"
"27981","(۲۷۹۸۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ الْبُرْسَانِیُّ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یَعْقِلُ عَنِ الْمَرْأَۃِ عَصَبَتُہَا ، وَإِنْ کَانَ لَہَا وَلَدٌ ذُکُورٌ۔","","Musannaf Ibn Abi Shaybah 27981","","","كتاب الديات"
"27982","(۲۷۹۸۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : مَا کَانَ مِنْ جُرْحٍ مِنَ الْعَمْدِ لاَ یُسْتَطَاعُ فِیہِ الْقِصَاصُ ، فَہُوَ عَلَی الْجَارِحِ فِی مَالِہِ دُونَ عَاقِلَتِہِ۔","","Musannaf Ibn Abi Shaybah 27982","","","كتاب الديات"
"27983","(۲۷۹۸۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ عَنِ الْعَمْدِ الَّذِی لاَ یُسْتَطَاعُ أَنْ یُسْتَقَادَ مِنْہُ ؟ فَقَالَ : عَلَی الْعَاقِلَۃِ ، وَسَأَلْتُ حَمَّادًا ؟ فَقَالَ : فِی مَالِہِ۔","","Musannaf Ibn Abi Shaybah 27983","","","كتاب الديات"
"27984","(۲۷۹۸۴) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ، عَنْ قَتَادَۃَ، قَالَ: کُلُّ شَیْئٍ لاَ یُقَادُ مِنْہُ، فَہُوَ عَلَی الْعَاقِلَۃِ۔","","Musannaf Ibn Abi Shaybah 27984","","","كتاب الديات"
"27985","(۲۷۹۸۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی ہِشَامٌ ، عَنْ أَبِیہِ ، قَالَ : کُلُّ عَمْدٍ لَیْسَ فِیہِ قَوَدٌ فَعَقْلُہُ فِی مَالِ الْمُصِیبِ ، وَإِنْ لَمْ یَکُنْ لَہُ مَالٌ فَعَلَی عَاقِلَۃِ الْمُصِیبِ ، إِنْ قَطَعَ یَمِینًا عَمْدًا ، وَکَانَتْ یَمِینُ الْقَاطِعِ قَدْ قُطِعَتْ قَبْلَ ذَلِکَ ، فَعَقْلُہَا فِی مَالِ الْقَاطِعِ ، فَإِنْ لَمْ یَکُنْ لَہُ مَالٌ فَعَلَی عَاقِلَتِہِ ، فَإِنْ کَانَتْ لَہُ یَدٌ یُسْرَی لَمْ یُقَدْ مِنْہَا ، وَالْعَقْلُ کَذَلِکَ ، وَالأَعْضَائِ کُلِّہَا کَذَلِکَ۔","","Musannaf Ibn Abi Shaybah 27985","","","كتاب الديات"
"27986","(۲۷۹۸۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : مَا کَانَ مِنْ قَتْلٍ بِغَیْرِ سِلاَحٍ فَہُوَ شِبْہُ الْعَمْدِ ، وَفِیہِ الدِّیَۃُ عَلَی الْعَاقِلَۃِ۔","","Musannaf Ibn Abi Shaybah 27986","","","كتاب الديات"
"27987","(۲۷۹۸۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ حَمَّادًا عَن قَتْلِ الْخَطَأِ شِبْہِ الْعَمْدِ ؟ فَقَالَ : فِی مَالِ الْقَاتِلِ ، وَقَالَ الْحَکَمُ : ہُوَ عَلَی الْعَاقِلَۃِ۔","","Musannaf Ibn Abi Shaybah 27987","","","كتاب الديات"
"27988","(۲۷۹۸۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنْ إِسْمَاعِیلَ ، عَنِ الْحَارِثِ ، وَابْنِ شُبْرُمَۃَ ، قَالاَ : ہُوَ عَلَیْہِ فِی مَالِہِ۔","","Musannaf Ibn Abi Shaybah 27988","","","كتاب الديات"
"27989","(۲۷۹۸۹) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 27989","","","كتاب الديات"
"27990","(۲۷۹۹۰) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، وَالْحَکَمِ ، وَحَمَّادًا ، قَالُوا : مَا أُصِیبَ بِہِ مِنْ سَوْطٍ ، أَوْ حَجَرٍ ، أَوْ عَصًا فَأَتَی عَلَی النَّفْسِ فَہُوَ شِبْہُ الْعَمْدِ ، وَفِیہِ الدِّیَۃُ مُغَلَّظَۃً عَلَی الْعَاقِلَۃِ۔","","Musannaf Ibn Abi Shaybah 27990","","","كتاب الديات"
"27991","(۲۷۹۹۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: قَتِیلُ السَّوْطِ وَالْعَصَی شِبْہُ الْعَمْدِ ، فِیہَا مِئَۃٌ مِنَ الإِبِلِ ، أَرْبَعُونَ مِنْہَا فِی بُطُونِہَا أَوْلاَدُہَا۔","Hasan","Musannaf Ibn Abi Shaybah 27991","","","كتاب الديات"
"27992","(۲۷۹۹۲) حَدَّثَنَا شَرِیکٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ یَعْقِلُ الْعَبْدُ ، وَلاَ یُعْقَلُ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 27992","","","كتاب الديات"
"27993","(۲۷۹۹۳) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ لَہُ : الرَّجُلُ یَقْتُلُ الْعَبْدَ ، مَنْ یَعْقِلُہُ؟ یَعْقِلُہُ ہُوَ ، أَمْ قَوْمُہُ ؟ قَالَ : قَوْمُہُ۔","","Musannaf Ibn Abi Shaybah 27993","","","كتاب الديات"
"27994","(۲۷۹۹۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَن حَمَّادٍ ، وَالْحَکَمِ ؛ أَنَّہُمَا قَالاَ فِی رَجُلٍ قَتَلَ دَابَّۃً خَطَأً ، قَالاَ : فِی مَالِہِ ، وَإِنْ قَتَلَ عَبْدًا فَہُوَ عَلَی الْعَاقِلَۃِ۔","","Musannaf Ibn Abi Shaybah 27994","","","كتاب الديات"
"27995","(۲۷۹۹۵) حَدَّثَنَا عُمَرُ ، عَن یُونُسَ ، عَنِ الزُّہْرِیِّ ؛ فِی حُرٍّ قَتَلَ عَبْدًا خَطَأً ، قَالَ : قیمَتُہُ عَلَی الْعَاقِلَۃِ۔","","Musannaf Ibn Abi Shaybah 27995","","","كتاب الديات"
"27996","(۲۷۹۹۶) حَدَّثَنَا وَکِیعٌ ، وَیَزِیدُ بْنُ ہَارُونَ ، عَن زَیْدِ بْنِ إِبْرَاہِیمَ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا قَتَلَ الْحُرُّ الْعَبْدَ خَطَأً ، یُعْتِقُ رَقَبَۃً وَعَلَیْہِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 27996","","","كتاب الديات"
"27997","(۲۷۹۹۷) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ مَکْحُولٍ ، قَالَ : لَیْسَ عَلَی أَہْلِ الْقَبِیلَۃِ مِنْ دِیَۃِ الْعَبْدِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 27997","","","كتاب الديات"
"27998","(۲۷۹۹۸) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ تَعْقِلُ الْعَاقِلَۃُ صُلْحًا ، وَلاَ عَمْدًا ، وَلاَ عَبْدًا ، وَلاَ اعْتِرَافًا۔","","Musannaf Ibn Abi Shaybah 27998","","","كتاب الديات"
"27999","(۲۷۹۹۹) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ عُبَیْدَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ تَعْقِلُ الْعَاقِلَۃُ صُلْحًا ، وَلاَ عَمْدًا ، وَلاَ اعْتِرَافًا ، وَلاَ عَبْدًا۔","","Musannaf Ibn Abi Shaybah 27999","","","كتاب الديات"
"28000","(۲۸۰۰۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، وَالشَّعْبِیِّ ، قَالاَ : الْخَطَأُ عَلَی الْعَاقِلَۃِ ، وَالْعَمْدُ وَالصُّلْحُ عَلَی الَّذِی أَصَابَہُ فِی مَالِہِ۔","","Musannaf Ibn Abi Shaybah 28000","","","كتاب الديات"
"28001","(۲۸۰۰۱) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَقُولُ : لاَ تَعْقِلُ الْعَاقِلَۃُ فِی الْعَمْدِ إِلاَّ أَنْ تَشَائَ ، وَإِنَّمَا تَعْقِلُ الْعَشِیرَۃُ الْخَطَأَ۔","","Musannaf Ibn Abi Shaybah 28001","","","كتاب الديات"
"28002","(۲۸۰۰۲) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : اصْطَلَحَ الْمُسْلِمُونَ عَلَی أَنْ لاَ تَعْقِلَ الْعَاقِلَۃُ صُلْحًا ، وَلاَ عَمْدًا ، وَلاَ اعْتِرَافًا۔","","Musannaf Ibn Abi Shaybah 28002","","","كتاب الديات"
"28003","(۲۸۰۰۳) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَن مَالِکِ بْنِ أَنَسٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : مَضَتِ السُّنَّۃُ أَنَّ الْعَاقِلَۃَ لاَ تَعْقِلُ دِیَۃَ عَمْدٍ ، إِلاَّ عَن طِیبِ نَفْسٍ۔","Da'if","Musannaf Ibn Abi Shaybah 28003","","","كتاب الديات"
"28004","(۲۸۰۰۴) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الْقَاسِمِ بْنِ نَافِعٍ ، عَنْ عَلِیِّ بْنِ مَاجِدَۃَ ، قَالَ : قاتَلْتُ غُلاَمًا فَجَدَعْتُ أَنْفَہُ ، فَأُتِیَ بِی أَبُو بَکْرٍ فَقَاسَنِی ، فَلَمْ یَجِدْ فِی قِصَاصًا ، فَجَعَلَ عَلَی عَاقِلَتِی الدِّیَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 28004","","","كتاب الديات"
"28005","(۲۸۰۰۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ قَالَ : فِی الصَّبِیِّ وَالْمَجْنُونِ خَطَؤُہُمَا وَعَمْدُہُمَا سَوَائٌ عَلَی عَاقِلَتِہِمَا۔","","Musannaf Ibn Abi Shaybah 28005","","","كتاب الديات"
"28006","(۲۸۰۰۶) حَدَّثَنَا عَبَّادٌ ، عن عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : عَمْدُ الصَّبِیِّ وَخَطَؤُہُ عَلَی الْعَاقِلَۃِ۔","","Musannaf Ibn Abi Shaybah 28006","","","كتاب الديات"
"28007","(۲۸۰۰۷) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، وَالْحَکَمِ ، وَحَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : عَمْدُ الصَّبِیِّ وَخَطَؤُہُ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 28007","","","كتاب الديات"
"28008","(۲۸۰۰۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ (ح) وَعَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، قَالاَ : أَوَّلُ مَنْ فَرَضَ الْعَطَائَ عُمَرُ بْنُ الْخَطَّابِ ، وَفَرَضَ فِیہِ الدِّیَۃَ کَامِلَۃً فِی ثَلاَثِ سِنِینَ ، ثُلُثَا الدِّیَۃِ فِی سَنَتَیْنِ ، وَالنِّصْفَ فِی سَنَتَیْنِ ، وَالثُّلُث فِی سَنَۃٍ ، وَمَا دُونَ ذَلِکَ فِی عَامِہ۔","Da'if","Musannaf Ibn Abi Shaybah 28008","","","كتاب الديات"
"28009","(۲۸۰۰۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : الدِّیَۃُ فِی ثَلاَثِ سِنِینَ ، أَوَّلُہَا فِی السَّنَۃِ الَّتِی یُصَابُ فِیہَا ، وَالثُّلُثَان فِی السَّنَتَیْنِ ، وَالثُّلُث فِی سَنَۃٍ۔","","Musannaf Ibn Abi Shaybah 28009","","","كتاب الديات"
"28010","(۲۸۰۱۰) حَدَّثَنَا مُحَمَّدُ بْنُ یزید ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ ، وَأَبِی ہَاشِمٍ ، قَالاَ : الدِّیَۃُ فِی ثَلاَثِ سِنِینَ : ثُلُثَاہَا وَنِصْفُہَا فِی سَنَتَیْنِ ، وَالثُّلُثُ فِی سَنَۃٍ۔","","Musannaf Ibn Abi Shaybah 28010","","","كتاب الديات"
"28011","(۲۸۰۱۱) حَدَّثَنَا وَکِیعٌ ، عَن حُرَیْثٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : الدِّیَۃُ فِی ثَلاَثِ سِنِینَ ، فِی کُلٍّ ثُلُثٌ۔","","Musannaf Ibn Abi Shaybah 28011","","","كتاب الديات"
"28012","(۲۸۰۱۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عُبَیدَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ یَجُوزُ اعْتِرَافُ الصَّبِیِّ ، فَإِنْ قَامَتْ عَلَیْہِ الْبَیِّنَۃُ بِقَتْلٍ فَہُوَ عَلَی الْعَاقِلَۃِ۔","","Musannaf Ibn Abi Shaybah 28012","","","كتاب الديات"
"28013","(۲۸۰۱۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَن عِیسَی بْنِ أَبِی عَزَّۃَ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ کَانَ لاَ یُجِیزُ إِقْرَارَ الصَّبِیِّ وَالْعَبْدِ فِی الْ[corrupt]ِرَاحَاتِ۔","","Musannaf Ibn Abi Shaybah 28013","","","كتاب الديات"
"28014","(۲۸۰۱۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ أَبَانَ بْنِ صَالِحٍ ، عَن مُجَاہِدٍ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : کَانَ یَقُولُ : دِیَۃُ أَہْلِ الْکِتَابِ مِثْلُ دِیَۃِ الْمُسْلِمِ۔","","Musannaf Ibn Abi Shaybah 28014","","","كتاب الديات"
"28015","(۲۸۰۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَلِیِّ بْنِ أَبِی طَلْحَۃَ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ کَانَ لَہُ عَہْدٌ ، أَوْ ذِمَّۃٌ فَدِیَتُہُ دِیَۃُ الْحُرِّ الْمُسْلِمِ۔n قَالَ سُفْیَانُ : ثُمَّ قَالَ عَلِیٌّ بَعْدُ ذَلِکَ : لاَ أَعْلَمُ إِلاَّ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 28015","","","كتاب الديات"
"28016","(۲۸۰۱۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا الْحَسَنُ بْنُ صَالِحٍ ، عَنْ عَلِیِّ بْنِ أَبِی طَلْحَۃَ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَبْدِ اللہِ ، قَالَ : مَنْ کَانَ لَہُ عَہْدٌ ، أَوْ ذِمَّۃٌ فَدِیَتُہُ دِیَۃُ الْحُرِّ الْمُسْلِمِ۔","","Musannaf Ibn Abi Shaybah 28016","","","كتاب الديات"
"28017","(۲۸۰۱۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الْعُمَیْسِ ، عَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : دِیَۃُ الْمُعَاہَدِ مِثْلُ دِیَۃِ الْمُسْلِمِ۔","","Musannaf Ibn Abi Shaybah 28017","","","كتاب الديات"
"28018","(۲۸۰۱۸) حَدَّثَنَا إِسْمَاعِیلُ بْنُ إِبْرَاہِیمَ، عَنِ ابْنِ أَبِی نَجِیحٍ، عَن مُجَاہِدٍ، وَعَطَائٍ، قَالاَ: دِیَۃُ الْمُعَاہَدِ مِثْلُ دِیَۃِ الْمُسْلِمِ۔","","Musannaf Ibn Abi Shaybah 28018","","","كتاب الديات"
"28019","(۲۸۰۱۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ (ح) وَعَنِ الْحَکَمِ ، وَحَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالاَ : دِیَۃُ الْیَہُودِیِّ وَالنَّصْرَانِیِّ وَالْمَجُوسِیِّ وَالْمُعَاہَدِ مِثْلُ دِیَۃِ الْمُسْلِمِ ، وَنِسَاؤُہُمْ عَلَی النِّصْفِ مِنْ دِیَۃِ الرِّجَالِ ، وَکَانَ عَامِرٌ یَتْلُو ہَذِہِ الآیَۃَ : {وَإِنْ کَانَ مِنْ قَوْمٍ بَیْنَکُمْ وَبَیْنَہُمْ مِیثَاقٌ فَدِیَۃٌ مُسَلَّمَۃٌ إِلَی أَہْلِہِ}۔","","Musannaf Ibn Abi Shaybah 28019","","","كتاب الديات"
"28020","(۲۸۰۲۰) حَدَّثَنَا إِسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن أَیُّوبَ ، عَنِ الزُّہْرِیِّ ، قَالَ: سَمِعْتُہ یَقُولُ: دِیَۃُ الْمُعَاہَدِ دِیَۃُ الْمُسْلِمِ، وَتَلاَ ہَذِہِ الآیَۃَ : {وَإِنْ کَانَ مِنْ قَوْمٍ بَیْنَکُمْ وَبَیْنَہُمْ مِیثَاقٌ}۔","","Musannaf Ibn Abi Shaybah 28020","","","كتاب الديات"
"28021","(۲۸۰۲۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : دِیَۃُ أَہْلِ الْعَہْدِ مِنَ الْمُشْرِکِینَ مِثْلُ دِیَۃِ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 28021","","","كتاب الديات"
"28022","(۲۸۰۲۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : دِیَۃُ الْکَافِرِ نِصْفُ دِیَۃِ الْمُؤْمِنِ۔ (ابوداؤد ۴۵۷۳۔ ترمذی ۱۴۱۳)","Hasan","Musannaf Ibn Abi Shaybah 28022","","","كتاب الديات"
"28023","(۲۸۰۲۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ بْنِ ذَکْوَانَ أَبِی الزِّنَادِ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : دِیَۃُ الْمُعَاہَدِ عَلَی النِّصْفِ مِنْ دِیَۃِ الْمُسْلِمِ۔","","Musannaf Ibn Abi Shaybah 28023","","","كتاب الديات"
"28024","(۲۸۰۲۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، قَالَ : قرَأْتُ کِتَابَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ : أَنَّ دِیَۃَ الْیَہُودِیِّ وَالنَّصْرَانِیِّ عَلَی الثُّلُثِ مِنْ دِیَۃِ الْمُسْلِمِ۔","","Musannaf Ibn Abi Shaybah 28024","","","كتاب الديات"
"28025","(۲۸۰۲۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی الْمِقْدَامِ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ، قَالَ : دِیَۃُ الْیَہُودِیِّ وَالنَّصْرَانِیِّ أَرْبَعَۃُ آلاَفٍ ، وَدِیَۃُ الْمَجُوسِیِّ ثَمَانُ مِئَۃٍ۔","","Musannaf Ibn Abi Shaybah 28025","","","كتاب الديات"
"28026","(۲۸۰۲۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُثْمَانَ بْنِ غِیَاثٍ ، عَن عِکْرِمَۃَ ، وَالْحَسَنِ ، قَالاَ : دِیَۃُ الْیَہُودِیِّ وَالنَّصْرَانِیِّ أَرْبَعَۃُ آلاَفٍ ، وَدِیَۃُ الْمَجُوسِیِّ ثَمَانُ مِئَۃٍ۔","","Musannaf Ibn Abi Shaybah 28026","","","كتاب الديات"
"28027","(۲۸۰۲۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَن سُلَیْمَانَ بْنِ یَسَارٍ ، قَالَ : کَانَ النَّاسُ یَقْضُونَ فِی الزَّمَانِ الأَوَّلِ فِی دِیَۃِ الْمَجُوسِیِّ بِثَمَانِ مِئَۃٍ ، وَیَقْضُونَ فِی دِیَۃِ الْیَہُودِیِّ وَالنَّصْرَانِیِّ بِالَّذِی کَانُوا یَتَعَاقَلُونَ بِہِ فِیمَا بَیْنَہُمْ ، ثُمَّ رَجَعَتِ الدِّیَۃُ إِلَی سِتَّۃِ آلاَفِ دِرْہَمٍ۔","","Musannaf Ibn Abi Shaybah 28027","","","كتاب الديات"
"28028","(۲۸۰۲۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : دِیَۃُ الْیَہُودِیِّ وَالنَّصْرَانِیِّ أَرْبَعَۃُ آلاَفٍ ، وَدِیَۃُ الْمَجُوسِیِّ ثَمَانُ مِئَۃٍ۔","","Musannaf Ibn Abi Shaybah 28028","","","كتاب الديات"
"28029","(۲۸۰۲۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَشْعَثَ ، عَن نَافِعٍ ، وَعَمْرِو بْنِ دِینَارٍ ؛ أَنَّہُمَا کَانَا یَقُولاَنِ : دِیَۃُ الْیَہُودِیِّ وَالنَّصْرَانِیِّ أَرْبَعَۃُ آلاَفٍ۔","","Musannaf Ibn Abi Shaybah 28029","","","كتاب الديات"
"28030","(۲۸۰۳۰) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ صَدَقَۃ بْنِ یَسَارٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ عُثْمَانَ قَضَی فِی دِیَۃِ الْیَہُودِیِّ وَالنَّصْرَانِیِّ أَرْبَعَۃَ آلاَفٍ۔","","Musannaf Ibn Abi Shaybah 28030","","","كتاب الديات"
"28031","(۲۸۰۳۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ حَجَّاجٍ ، عَن رَبِیعَۃَ بْنِ أَبِی عَبْدِ الرَّحْمَنِ ، عن عبد الرحمن بْنِ الْبَیْلَمَانِیِّ ، قَالَ : قتَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلاً مِنْ أَہْلِ الْقِبْلَۃِ قَتَلَ رَجُلاً مِنْ أَہْلِ الذِّمَّۃِ ، وَقَالَ : أَنَا أَحَقُّ مَنْ وَفَّی بِذِمَّتِہِ۔ (دارقطنی ۱۳۵)","Da'if","Musannaf Ibn Abi Shaybah 28031","","","كتاب الديات"
"28032","(۲۸۰۳۲) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ لَیْثٍ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ، وَعَبْدِ اللہِ ؛ أَنَّہُمَا قَالاَ : إِذَا قَتَلَ یَہُودِیًّا ، أَوْ نَصْرَانِیًّا قُتِلَ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 28032","","","كتاب الديات"
"28033","(۲۸۰۳۳) حَدَّثَنَا مُعْتَمِرٌ ، عَن حُمَیْدٍ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ؛ أّنَّہُ أَخْبَرَہُ ، قَالَ : مَرَّ رَجُلٌ مِنَ الْمُسْلِمِینَ بِرَجُلٍ مِنَ الْیَہُودِ، فَأَعْجَبَتْہُ امْرَأَتُہُ فَقَتَلَہُ وَغَلَبَہُ عَلَیْہَا، فَکَتَبَ إِلَی عُمَرَ بْنِ عَبْدِالْعَزِیزِ، فَکَتَبَ عُمَرُ: أَنِ ادْفَعُوہُ إِلَی وَلِیِّہِ، قَالَ: فَدَفَعْناہُ إِلَی أُمِّہِ ، فَشَدَخَتْ رَأْسَہُ بِصَخْرَۃٍ ، أَوْ بِصَلاَیَۃٍ، لاَ أَدْرِی قَامَتْ عَلَیْہِ بَیِّنَۃٌ، أَوِ اعْتَرَفَ۔","","Musannaf Ibn Abi Shaybah 28033","","","كتاب الديات"
"28034","(۲۸۰۳۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنِ النَّزَّالِ بْنِ سَبْرَۃَ ، قَالَ : قتَلَ رَجُلٌ مِنْ فُرْسَانِ أَہْلِ الْکُوفَۃِ عِبَادِیًا مِنْ أَہْلِ الْحِیرَۃِ ، فَکَتَبَ عُمَرُ : أَنْ أَقِیدوا أَخَاہُ مِنْہُ ، فَدَفَعُوا الرَّجُلَ إِلَی أَخِی الْعِبادِیِّ فَقَتَلَہُ ، ثُمَّ جَائَ کِتَابُ عُمَرَ : أَنْ لاَ تَقْتُلُوہُ وَقَدْ قَتَلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 28034","","","كتاب الديات"
"28035","(۲۸۰۳۵) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یُقْتُلُ الْمُسْلِمُ بِالْمُعَاہَدِ۔","","Musannaf Ibn Abi Shaybah 28035","","","كتاب الديات"
"28036","(۲۸۰۳۶) حَدَّثَنَا سُفْیَانُ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی الْمُسْلِمِ یَقتَلَ الذِّمِّیَّ عَمْدًا ، قَالَ : یُقْتَلُ بِہِ۔","","Musannaf Ibn Abi Shaybah 28036","","","كتاب الديات"
"28037","(۲۸۰۳۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو الأَشْہَبِ ، عَنْ أَبِی نَضِرَۃَ ، قَالَ : حُدِّثْنَا أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَقَادَ رَجُلاً مِنَ الْمُسْلِمِینَ بِرَجُلٍ مِنْ أَہْلِ الذِّمَّۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 28037","","","كتاب الديات"
"28038","(۲۸۰۳۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ ؛ أَنَّہُ أَقَادَ رَجُلاً مِنَ الْمُسْلِمِینَ بِرَجُلٍ مِنْ أَہْلِ الْحِیرَۃِ۔","","Musannaf Ibn Abi Shaybah 28038","","","كتاب الديات"
"28039","(۲۸۰۳۹) حَدَّثَنَا حَفْصٌ ، عَنِ الْمُسَاوِرِ ، قَالَ : سَمِعْتُہُ یَقُولُ : مَنِ اعْتَرَضَ ذِمَّۃَ مُحَمَّدٍ بِقَتْلِہِمْ ، فَاقْتُلُوہُ۔","","Musannaf Ibn Abi Shaybah 28039","","","كتاب الديات"
"28040","(۲۸۰۴۰) حَدَّثَنَا مَعْن ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ ؛ أَنَّ رَجُلاً مِنَ النَّبَطِ عَدَا عَلَیْہِ رَجُلٌ مِنْ أَہْلِ الْمَدِینَۃِ فَقَتَلَہُ قَتْلَ غِیلَۃٍ ، فَأُتِیَ بِہِ أَبَانُ بْنَ عُثْمَانَ ، وَہُوَ إِذْ ذَاکَ عَلَی الْمَدِینَۃِ ، فَأَمَرَ بِالْمُسْلِمِ الَّذِی قَتَلَ الذِّمِّیَّ أَنْ یُقْتَلَ۔","","Musannaf Ibn Abi Shaybah 28040","","","كتاب الديات"
"28041","(۲۸۰۴۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ قَیْسٍ الأَسَدِیُّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنِ النَّزَّالِ بْنِ سَبْرَۃَ ؛ أَنَّ رَجُلاً مِنَ الْمُسْلِمِینَ قَتَلَ رَجُلاً مِنْ أَہْلِ الْحِیرَۃِ ، فَکَتَبَ فِیہِ إِلَی عُمَرَ بْنِ الْخَطَّابِ ، فَکَتَبَ عُمَرُ : أَنِ اقْتُلُوہُ بِہِ ، فَقِیلَ لأَخِیہِ حُنَیْنٍ : اقْتُلْہُ ، قَالَ : حَتَّی یَجِیئَ الْغَضَبُ ، قَالَ : فَبَلَغَ عُمَرَ أَنَّہُ مِنْ فُرْسَانِ الْمُسْلِمِینَ ، قَالَ : فَکَتَبَ عُمَرُ : أَنْ لاَ تُقِیدُوہُ بِہِ ، قَالَ : فَجَائَہُ الْکِتَابُ وَقَدْ قُتِلَ۔ (طحاوی ۱۹۶)","Sahih","Musannaf Ibn Abi Shaybah 28041","","","كتاب الديات"
"28042","(۲۸۰۴۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، عَنْ أَبِی جُحَیْفَۃَ ، قَالَ : قُلْنَا لِعَلِیٍّ : ہَلْ عِنْدَکُمْ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ شَیْئٌ سِوَی الْقُرْآنِ ؟ فَقَالَ : لاَ ، وَالَّذِی فَلَقَ الْحَبَّۃَ وَبَرَأَ النَّسَمَۃَ ، إِلاَّ أَنْ یُعْطِیَ اللَّہُ رَجُلاً فَہْمًا فِی کِتَابِ اللہِ ، وَمَا فِی ہَذِہِ الصَّحِیفَۃِ ؟ قَالَ : قُلْتُ : وَمَا فِی ہَذِہِ الصَّحِیفَۃِ ؟ قَالَ : الْعَقْلُ ، وَفِکَاکُ الأَسِیرِ ، وَلاَ یُقْتَلُ مُسْلِمٌ بِکَافِرٍ۔ (بخاری ۱۱۱۔ ترمذی ۱۴۱۲)","Sahih","Musannaf Ibn Abi Shaybah 28042","","","كتاب الديات"
"28043","(۲۸۰۴۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ یُقْتَلُ مُؤْمِنٌ بِکَافِرٍ۔ (ابوداؤد ۲۷۴۵۔ ترمذی ۱۴۱۳)","Hasan","Musannaf Ibn Abi Shaybah 28043","","","كتاب الديات"
"28044","(۲۸۰۴۴) حَدَّثَنَا وَکِیعٌ ، عَن مَعْقِلٍ ، عَنْ عَطَائٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یُقْتَلُ مُسْلِمٌ بِکَافِرٍ ، وَلاَ ذُو عَہْدٍ فِی عَہْدِہِ۔ (ابوداؤد ۴۵۱۹۔ نسائی ۶۹۳۶)","","Musannaf Ibn Abi Shaybah 28044","","","كتاب الديات"
"28045","(۲۸۰۴۵) حَدَّثَنَا ابْنُ مُسْہِرٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی الْمَلِیحِ ؛ أَنَّ رَجُلاً مِنْ قَوْمِہِ رَمَی رَجُلاً یَہُودِیًّا بِسَہْمٍ فَقَتَلَہُ ، فَرُفِعَ إِلَی عُمَرَ بْنِ الْخَطَّابِ ، فَأَغْرَمہُ أَرْبَعَۃَ آلاَفٍ ، وَلَمْ یُقِدْ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 28045","","","كتاب الديات"
"28046","(۲۸۰۴۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : سُئِلَ عَمَّنْ یَقْتُلُ یَہُودِیًّا ، أَوْ نَصْرَانِیًّا ؟ قَالَ : لاَ یُقْتَلُ مُسْلِمٌ بِکَافِرٍ ، وَإِنْ قَتَلَہُ عَمْدًا۔","","Musannaf Ibn Abi Shaybah 28046","","","كتاب الديات"
"28047","(۲۸۰۴۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : لاَ یُقْتَلُ الرَّجُلُ الْمُسْلِمُ بِالْیَہُودِیِّ ، وَلاَ بِالنَّصْرَانِیِّ ، وَلَکِنْ یُغْرَمُ الدِّیَۃَ۔","","Musannaf Ibn Abi Shaybah 28047","","","كتاب الديات"
"28048","(۲۸۰۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : قَالَ عَلِیٌّ : مِنَ السُّنَّۃِ أَنْ لاَ یُقْتَلَ مُؤْمِنٌ بِکَافِرٍ، وَلاَ حُرٌّ بِعَبْدٍ۔","Da'if","Musannaf Ibn Abi Shaybah 28048","","","كتاب الديات"
"28049","حدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ بَقِیُّ بْنُ مَخْلَدٍ ، حدَّثَنَا أَبُو بَکْرٍ عَبْدُ اللہِ بْنُ مُحَمَّدِ بْنِ أَبِی شَیْبَۃَ الْعَبْسِیُّ ، قَالَ :n(۲۸۰۴۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ؛ أَنَّ یَہُودِیًّا رَضَخَ رَأْسَ امْرَأَۃٍ بِحَجَرٍ فَقَتَلَہَا ، فَرَضَخَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأْسَہُ بَیْنَ حَجَرَیْنِ۔ (بخاری ۶۸۸۵۔ احمد ۱۷۰)","Sahih","Musannaf Ibn Abi Shaybah 28049","","","كتاب الديات"
"28050","(۲۸۰۵۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛أَنَّ عُمَرَ قَتَلَ ثَلاَثَۃَ نَفَرٍ مِنْ أَہْلِ صَنْعَائَ بِامْرَأَۃٍ۔ (عبدالرزاق ۱۸۰۷۳)","Sahih","Musannaf Ibn Abi Shaybah 28050","","","كتاب الديات"
"28051","(۲۸۰۵۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ (ح) وَعَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، قَالاَ : یُقْتَلُ الرَّجُلُ بِالْمَرْأَۃِ إِذَا قَتَلَہَا عَمْدًا۔","","Musannaf Ibn Abi Shaybah 28051","","","كتاب الديات"
"28052","(۲۸۰۵۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ، وَعَبْدِ اللہِ ، قَالاَ : إِذَا قَتَلَ الرَّجُلُ الْمَرْأَۃَ مُتَعَمِّدًا ، فَہُوَ بِہَا قَوَدٌ۔","Da'if","Musannaf Ibn Abi Shaybah 28052","","","كتاب الديات"
"28053","(۲۸۰۵۳) حَدَّثَنَا عُمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یُقْتَلُ وَلَیْسَ بَیْنَہُمَا فَصْلٌ۔","","Musannaf Ibn Abi Shaybah 28053","","","كتاب الديات"
"28054","(۲۸۰۵۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَن سِمَاکٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : رُفِعَ إِلَی علِیٍّ رَجُلٌ قَتَلَ امْرَأَۃً ، فَقَالَ عَلِیٌّ لأَوْلِیَائِہَا : إِنْ شِئْتُمْ فَأَدُّوا نِصْفَ الدِّیَۃِ وَاقْتُلُوہُ۔","Hasan","Musannaf Ibn Abi Shaybah 28054","","","كتاب الديات"
"28055","(۲۸۰۵۵) حَدَّثَنَا غُنْدَرٌ، عَنْ عَوْفٍ، عَنِ الْحَسَنِ، قَالَ: لاَ یُقْتَلُ الذَّکَرُ بِالأُنْثَی حَتَّی یُؤَدِّی نِصْفَ الدِّیَۃِ إِلَی أَہْلِہِ۔","","Musannaf Ibn Abi Shaybah 28055","","","كتاب الديات"
"28056","(۲۸۰۵۶) حَدَّثَنَا یَعْلَی ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَقْتُلُ الْمَرْأَۃَ ، قَالَ : إِنْ قَتَلُوہُ أَدَّوْا نِصْفَ الدِّیَۃَ ، وَإِنْ شَاؤُوا قَبِلُوا الدِّیَۃَ۔","","Musannaf Ibn Abi Shaybah 28056","","","كتاب الديات"
