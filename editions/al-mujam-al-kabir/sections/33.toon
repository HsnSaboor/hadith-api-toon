hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"19201","مَيْمُونُ بْنُ أَبِي شَبِيبٍ  ، عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  1020  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ، (  ح  )  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، قَالَا ،  ثَنَا  شُعْبَةُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  مَيْمُونِ بْنِ أَبِي شَبِيبٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ رَوَى عَنِّي حَدِيثًا يَرَى أَنَّهُ كَذِبٌ فَهُوَ أَحَدُ  الْكَذَّابِينَ ، أَوْ قَالَ : الْكَاذِبِينَ  .","","Al-Mu'jam al-Kabir 1020","","المغيرة بن شعبة عن ميمون بن أبي شبيب عن حبيب بن أبي ثابت الكاهلي عن شعبة بن الحجاج عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","ميمون بن أبي شبيب عن المغيرة بن شعبة"
"19202","1021  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،         [20/423]      عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  مَيْمُونِ بْنِ أَبِي شَبِيبٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ حَدَّثَ عَنِّي بِحَدِيثٍ وَهُوَ يَرَى أَنَّهُ كَذِبٌ فَهُوَ أَحَدُ الْكَاذِبِينَ  .","","Al-Mu'jam al-Kabir 1021","","المغيرة بن شعبة عن ميمون بن أبي شبيب عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ميمون بن أبي شبيب عن المغيرة بن شعبة"
"19203","1022  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  مَيْمُونِ بْنِ أَبِي شَبِيبٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ حَدَّثَ عَنِّي بِحَدِيثٍ وَهُوَ يَرَى أَنَّهُ كَذِبٌ فَهُوَ أَحَدُ الْكَاذِبِينَ  .","","Al-Mu'jam al-Kabir 1022","","المغيرة بن شعبة عن ميمون بن أبي شبيب عن حبيب بن أبي ثابت الكاهلي عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","ميمون بن أبي شبيب عن المغيرة بن شعبة"
"19204","قَبِيصَةُ بْنُ جَابِرٍ الْأَسَدِيُّ  ، عَنِ  الْمُغِيرَةِ  1023  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا ،  ثَنَا  شَرِيكٌ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  حُصَيْنِ بْنِ قَبِيصَةَ ، - وَقَالَ مَرَّةً :  عَنْ  قَبِيصَةَ بْنِ جَابِرٍ  -  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ آخِذٌ  بِحُجْزَةِ  سُفْيَانَ بْنِ سَهْلٍ - وَهُوَ ابْنُ أَبِي سَهْلٍ  - وَهُوَ يَقُولُ :  لَا  تُسْبِلْ  إِزَارَكَ ، فَإِنَّ اللهَ لَا يُحِبُّ  الْمُسْبِلِينَ  .","","Al-Mu'jam al-Kabir 1023","","المغيرة بن شعبة عن قبيصة بن جابر بن وهب الأسدي عن حصين بن قبيصة الفزاري عن عبد الملك بن عمير القبطي عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","قبيصة بن جابر الأسدي عن المغيرة"
"19205","1024  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا         [20/424]      يَزِيدُ بْنُ هَارُونَ ،  أَنَا  شَرِيكٌ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  حُصَيْنِ بْنِ عُقْبَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَخَذَ بِرِدَاءِ  سُفْيَانَ بْنِ سَهْلٍ  وَهُوَ يَقُولُ :  يَا  سُفْيَانُ  ، لَا  تُسْبِلْ  ، فَإِنَّ اللهَ لَا يُحِبُّ  الْمُسْبِلِينَ  .  هَكَذَا رَوَاهُ  يَزِيدُ بْنُ هَارُونَ  ، عَنْ  شَرِيكٍ  ، عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ  ، عَنْ  حُصَيْنِ بْنِ عُقْبَةَ  ، وَقَالَ  سُفْيَانُ  :  ابْنُ سَهْلٍ  .","","Al-Mu'jam al-Kabir 1024","","المغيرة بن شعبة عن حصين بن قبيصة الفزاري عن عبد الملك بن عمير القبطي عن شريك بن عبد الله النخعي عن يزيد بن هارون عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","قبيصة بن جابر الأسدي عن المغيرة"
"19206","النُّعْمَانُ بْنُ سَعْدٍ  ، عَنِ  الْمُغِيرَةِ  1025  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ مُسَاوِرٍ الْجَوْهَرِيُّ ،  ثَنَا  عَفَّانُ ، (  ح  )  وَحَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  الْعَبَّاسُ بْنُ طَالِبٍ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ الْبَصْرِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَائِشَةَ ، قَالُوا ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنِ  النُّعْمَانِ بْنِ سَعْدٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  شِعَارُ  أُمَّتِي عَلَى الصِّرَاطِ : سَلِّمْ سَلِّمْ  .","","Al-Mu'jam al-Kabir 1025","","المغيرة بن شعبة عن النعمان بن سعد بن حبتة الأنصاري عن عبد الرحمن بن إسحاق بن سعد  الواسطي عن عبد الواحد بن زياد عن عفان بن مسلم الصفار عن أحمد بن القاسم بن مساور الجوهري عن الطبراني","النعمان بن سعد عن المغيرة"
"19207","1026  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ، وَعَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنِ  النُّعْمَانِ بْنِ سَعْدٍ ،         [20/425]      عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  شِعَارُ  أُمَّتِي عَلَى الصِّرَاطِ : رَبِّ سَلِّمْ  .","","Al-Mu'jam al-Kabir 1026","","المغيرة بن شعبة عن النعمان بن سعد بن حبتة الأنصاري عن عبد الرحمن بن إسحاق بن سعد  الواسطي عن علي بن مسهر القرشي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","النعمان بن سعد عن المغيرة"
"19208","1027  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ، وَمُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ قَالَا :  ثَنَا  فَرْوَةُ بْنُ أَبِي الْمَغْرَاءِ ،  ثَنَا  الْقَاسِمُ بْنُ مَالِكٍ الْمُزَنِيُّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنِ  النُّعْمَانِ بْنِ سَعْدٍ ، قَالَ :  سَمِعْتُ  الْمُغِيرَةَ بْنَ شُعْبَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَخْرُجُ قَوْمٌ مِنَ النَّارِ فَيَدْخُلُونَ الْجَنَّةَ فَيُسَمَّوْنَ : الْجَهَنَّمِيُّونَ فِي الْجَنَّةِ  ، فَيَدْعُونَ اللهَ أَنْ يُحَوِّلَ عَنْهُمْ ذَلِكَ الِاسْمَ ، فَيَمْحُو اللهُ عَنْهُمْ ، فَإِذَا خَرَجُوا مِنَ النَّارِ  . فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 1027","","المغيرة بن شعبة عن النعمان بن سعد بن حبتة الأنصاري عن عبد الرحمن بن إسحاق بن سعد  الواسطي عن القاسم بن مالك المزني عن فروة بن أبي المغراء الكندي عن محمد بن عثمان بن أبي شيبة عن الطبراني","النعمان بن سعد عن المغيرة"
"19209","رِوَايَةُ  الْبَصْرِيِّينَ  عَنِ  الْمُغِيرَةِ  فَضَالَةُ بْنُ عَمْرٍو الزَّهْرَانِيُّ  ، عَنِ  الْمُغِيرَةِ  1028  -  حَدَّثَنَا  سَعِيدُ بْنُ سَيَّارٍ الْوَاسِطِيُّ ،  ثَنَا  عَمْرُو بْنُ عَوْنٍ ،  أَنَا  خَالِدٌ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنْ  أَبِي الْعَالِيَةِ ،  عَنْ  فَضَالَةَ بْنِ عَمْرٍو الزَّهْرَانِيِّ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 1028","","المغيرة بن شعبة عن فضالة بن عبيد الزهراني عن رفيع بن مهران عن داود بن أبي هند عن خالد بن عبد الله الطحان عن عمرو بن عون الواسطي عن سعيد بن سيار الواسطي عن الطبراني","فضالة بن عمرو الزهراني عن المغيرة"
"19210","1029  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنْ  أَبِي الْعَالِيَةِ ،  عَنْ  فَضَالَةَ بْنِ عَمْرٍو الزَّهْرَانِيِّ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  كُنَّا مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي مَنْزِلِهِ ، فَاتَّبَعْتُهُ فَقَالَ :  أَيْنَ تَرَكْتَ النَّاسَ  ؟ "" فَقُلْتُ : تَرَكْتُهُمْ بِمَكَانِ كَذَا وَكَذَا ، فَأَنَاخَ رَاحِلَتَهُ فَنَزَلَ ، ثُمَّ ذَهَبَ فَتَوَارَى عَنِّي فَاحْتَبَسَ بِقَدْرِ مَا يَقْضِي الرَّجُلُ حَاجَتَهُ ثُمَّ جَاءَ فَقَالَ :         [20/426]      "" أَمَعَكَ مَاءٌ ؟ قُلْتُ : نَعَمْ ، فَصَبَبْتُ عَلَى يَدَيْهِ فَغَسَلَ وَجْهَهُ وَيَدَيْهِ ، وَمَسَحَ رَأْسَهُ ، وَعَلَيْهِ جُبَّةٌ شَامِيَّةٌ قَدْ ضَاقَتْ يَدَاهَا ، فَأَدْخَلَ يَدَهُ مِنْ تَحْتِ الْجُبَّةِ فَرَفَعَهَا عَنْ يَدَيْهِ ، ثُمَّ غَسَلَ يَدَيْهِ وَوَجْهَهُ ، وَمَسَحَ عَلَى رَأْسِهِ وَخُفَّيْهِ ، ثُمَّ قَالَ : "" أَلَكَ حَاجَةٌ ؟ "" قُلْتُ : لَا ، قَالَ : فَرَكِبْنَا حَتَّى أَدْرَكْنَا النَّاسَ  .","","Al-Mu'jam al-Kabir 1029","","المغيرة بن شعبة عن فضالة بن عبيد الزهراني عن رفيع بن مهران عن داود بن أبي هند عن يزيد بن هارون عن إدريس بن جعفر العطار عن الطبراني","فضالة بن عمرو الزهراني عن المغيرة"
"19211","عَمْرُو بْنُ وَهْبٍ الثَّقَفِيُّ  ، عَنِ  الْمُغِيرَةِ  1030  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  ثَنَا  سَعِيدُ بْنُ بَشِيرٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  عَمْرِو بْنِ وَهْبٍ الثَّقَفِيِّ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  مَسَحَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى نَاصِيَتِهِ وَعِمَامَتِهِ  ، وَمَسَحَ عَلَى خُفَّيْهِ  وَأَنَا شَاهِدٌ ذَلِكَ .","","Al-Mu'jam al-Kabir 1030","","المغيرة بن شعبة عن عمرو بن وهب الثقفي عن محمد بن سيرين عن قتادة بن دعامة عن سعيد بن بشير الأزدي عن محمد بن بكار العاملي عن أبو زرعة الدمشقي عن الطبراني","عمرو بن وهب الثقفي عن المغيرة"
"19212","1031  -  حَدَّثَنَا  سَعِيدُ بْنُ سَيَّارٍ الْوَاسِطِيُّ ،  ثَنَا  عَمْرُو بْنُ عَوْنٍ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  عَمْرِو بْنِ وَهْبٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  خَصْلَتَانِ  لَا أَسْأَلُ عَنْهُمَا أَحَدًا بَعْدَ أَنْ شَهِدْتُهُمَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  : الْمَسْحُ عَلَى الْخُفَّيْنِ ، وَصَلَاةُ إِمَامٍ خَلْفَ بَعْضِ رَعِيَّتِهِ ، كُنَّا مَعَ رَسُولِ اللهِ فِي سَفَرٍ فَنَزَلْنَا مَنْزِلًا  فَتَبَرَّزَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِبَعْضِ حَاجَتِهِ ، فَلَمَّا قَضَى حَاجَتَهُ أَتَيْتُهُ بِمَاءٍ فَتَوَضَّأَ ... وَمَسَحَ عَلَى نَاصِيَتِهِ ، وَعَلَى عِمَامَتِهِ ، وَعَلَى خُفَّيْهِ ، ثُمَّ أَتَيْنَا  الْقَوْمَ  وَهُمْ يُصَلُّونَ وَقَدْ قَدَّمَ  الْقَوْمُ  عَبْدَ الرَّحْمَنِ بْنَ عَوْفٍ  ، فَأَدْرَكْنَا مَعَهُمْ رَكْعَةً ، فَقَضَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الرَّكْعَةَ الْأُخْرَى  .  هذه العبارة سقطت من طبعة مكتبة ابن تيمية وأثبتناها من نسخة خطية .","","Al-Mu'jam al-Kabir 1031","","المغيرة بن شعبة عن عمرو بن وهب الثقفي عن محمد بن سيرين عن يونس بن عبيد عن هشيم بن بشير عن عمرو بن عون الواسطي عن سعيد بن سيار الواسطي عن الطبراني","عمرو بن وهب الثقفي عن المغيرة"
"19213","1032  -  حَدَّثَنَا  عَمْرُو بْنُ ثَوْرٍ الْجُذَامِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ، (  ح  )         [20/427]      وَحَدَّثَنَا  عُمَرُ بْنُ عَبْدِ اللهِ بْنِ الْحَسَنِ ،  ثَنَا  سَلَمَةُ بْنُ شَبِيبٍ ،  ثَنَا  الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  عَمْرِو بْنِ وَهْبٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  انْتَهَيْتُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  ، فَتَأَخَّرَ فَأَشَارَ إِلَيْهِ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، فَصَلَّيْنَا مَا أَدْرَكْنَا وَقَضَيْنَا مَا سُبِقْنَا  .","","Al-Mu'jam al-Kabir 1032","","المغيرة بن شعبة عن عمرو بن وهب الثقفي عن محمد بن سيرين عن يونس بن عبيد عن سفيان الثوري عن محمد بن يوسف الفريابي عن سلمة بن شبيب المسمعي عن عمر بن عبد الله بن الحسن الأصبهاني عن الطبراني","عمرو بن وهب الثقفي عن المغيرة"
"19214","1033  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ الْوَارِثِ بْنُ إِبْرَاهِيمَ أَبُو عُبَيْدَةَ الْعَسْكَرِيُّ ،  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ، قَالَا :  ثَنَا  جَرِيرٌ ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  عَمْرِو بْنِ وَهْبٍ الثَّقَفِيِّ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  كُنَّا مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ ، فَلَمَّا كَانَ السَّحَرُ ضَرَبْتُ رَاحِلَتِي فَأَقْبَلْتُ مَعَهُ فَانْطَلَقَ حَتَّى تَغَيَّبَ عَنِّي  ، ثُمَّ جَاءَ فَقَالَ : "" حَاجَتَكَ ؟ "" ، فَقُلْتُ : مَا لِي مِنْ حَاجَةٍ ، قَالَ : "" مَعَكَ مَاءٌ ؟ "" قُلْتُ : نَعَمْ ، فَتَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ ، ثُمَّ انْطَلَقَ حَتَّى أَدْرَكَ النَّاسَ وَهُمْ يُصَلُّونَ ،  وَعَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  يَؤُمُّهُمْ ، فَتَحَرَّكَ لِجِيئَةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَوْمَأَ بِيَدِهِ إِلَى  عَبْدِ الرَّحْمَنِ  أَنِ اثْبُتْ ، فَصَلَّيْنَا مَا أَدْرَكْنَا ، وَقَضَيْنَا مَا فَاتَنَا .","","Al-Mu'jam al-Kabir 1033","","المغيرة بن شعبة عن عمرو بن وهب الثقفي عن محمد بن سيرين عن أشعث بن سوار عن جرير بن عبد الحميد عن سليمان بن داود العتكي عن عبد الوارث بن إبراهيم العسكري عن الطبراني","عمرو بن وهب الثقفي عن المغيرة"
"19215","1034  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  عَلِيُّ بْنُ جَعْفَرٍ الْأَحْمَرُ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  وَهْبٍ - أَوِ ابْنِ وَهْبٍ  - ، عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  خَصْلَتَانِ  لَنْ أَدَعَهُمَا : أَنْ أَمْسَحَ عَلَى خُفِّي  ، وَأَنْ أُصَلِّيَ عَلَى رَجُلٍ مِنْ رَعِيَّتِي ، وَقَدْ رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَسَحَ عَلَى الْخُفَّيْنِ وَصَلَّى خَلْفَ  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  "" .","","Al-Mu'jam al-Kabir 1034","","المغيرة بن شعبة عن عمرو بن وهب الثقفي عن محمد بن سيرين عن عاصم بن سليمان الأحول عن علي بن مسهر القرشي عن علي بن جعفر بن زياد التميمي عن علي بن سعيد بن بشير عليك عن الطبراني","عمرو بن وهب الثقفي عن المغيرة"
"19216","[20/428]      1035  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  حَبِيبٍ ، وَهِشَامٍ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عُزَيْزٍ الْمَوْصِلِيُّ ،  ثَنَا  غَسَّانُ بْنُ الرَّبِيعِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  هِشَامٍ ، وَأَيُّوبَ ، وَحَبِيبِ بْنِ الشَّهِيدِ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  عَمْرِو بْنِ وَهْبٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  صَبَبْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَغَسَلَ يَدَيْهِ  ، وَمَضْمَضَ وَاسْتَنْشَقَ وَغَسَلَ وَجْهَهُ وَذِرَاعَيْهِ ، وَمَسَحَ نَاصِيَتَهُ وَعَلَى الْعِمَامَةِ وَالْخُفَّيْنِ  .","","Al-Mu'jam al-Kabir 1035","","المغيرة بن شعبة عن عمرو بن وهب الثقفي عن محمد بن سيرين عن أيوب السختياني عن حماد بن سلمة عن غسان بن الربيع الأزدي عن عبد الله بن محمد بن عزيز التميمي عن الطبراني","عمرو بن وهب الثقفي عن المغيرة"
"19217","1036  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ، (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  ثَنَا  عَوْفٌ ، وَهِشَامٌ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  ثَنَا  عَمْرُو بْنُ وَهْبٍ الثَّقَفِيُّ ، أَنَّ الْمُغِيرَةَ بْنَ شُعْبَةَ  حَدَّثَهُ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" مَسَحَ عَلَى نَاصِيَتِهِ  ، وَعَلَى عِمَامَتِهِ ، وَعَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 1036","","المغيرة بن شعبة عن عمرو بن وهب الثقفي عن محمد بن سيرين عن هشام بن حسان العتكي عن عبد الله بن المبارك عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","عمرو بن وهب الثقفي عن المغيرة"
"19218","1037  -  حَدَّثَنَا  جَعْفَرُ بْنُ أَحْمَدَ بْنِ سِنَانٍ الْوَاسِطِيُّ ، وَالْعَبَّاسُ بْنُ حَمْدَانَ الْحَنَفِيُّ الْأَصْبَهَانِيُّ قَالَا ،  ثَنَا  مُحَمَّدُ بْنُ عَمْرٍو الْبَحْرَانِيُّ ،  ثَنَا  أَبُو دَاوُدَ الطَّيَالِسِيُّ ،  ثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ أَخُو  أَبِي حُرَّةَ  ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  عَمْرِو بْنِ وَهْبٍ الثَّقَفِيِّ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، أَنَّهُ  أَفْرَغَ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ  سَطِيحَةٍ  ، قَالَ : فَتَوَضَّأَ فَغَسَلَ وَجْهَهُ  ، وَعَلَيْهِ جُبَّةٌ شَامِيَّةٌ ضَيِّقَةُ الْكُمِّ ، أَخْرَجَ يَدَيْهِ فَغَسَلَهُمَا وَمَسَحَ عَلَى عِمَامَتِهِ وَخُفَّيْهِ ، وَأَتَيْنَا  عَبْدَ الرَّحْمَنِ بْنَ عَوْفٍ  وَهُوَ يُصَلِّي وَقَدْ صَلَّى بِهِمْ رَكْعَةً ، فَصَلَّيْنَا مَعَهُ الرَّكْعَةَ الَّتِي أَدْرَكْنَا وَقَضَيْنَا الرَّكْعَةَ الَّتِي سُبِقْنَا "" .","","Al-Mu'jam al-Kabir 1037","","المغيرة بن شعبة عن عمرو بن وهب الثقفي عن محمد بن سيرين عن سعيد بن عبد الرحمن الرقاشي عن أبو داود الطيالسي عن محمد بن عمرو البحراني عن جعفر بن أحمد بن سنان الواسطي عن الطبراني","عمرو بن وهب الثقفي عن المغيرة"
"19219","1038  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ         [20/429]      بْنِ عُمَرَ بْنِ حَبِيبٍ الْعَدَوِيُّ ،  ثَنَا  سَلْمُ بْنُ سُلَيْمَانَ أَبُو هِشَامٍ ،  عَنْ  أَبِي حُرَّةَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  عَمْرِو بْنِ وَهْبٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ وَمَسَحَ عَلَى الْخُفَّيْنِ وَالْعِمَامَةِ  .","","Al-Mu'jam al-Kabir 1038","","المغيرة بن شعبة عن عمرو بن وهب الثقفي عن محمد بن سيرين عن واصل بن عبد الرحمن البصري عن سلم بن سليمان الضبي عن عبد الله بن محمد بن عمرو العدوي عن بحشل عن الطبراني","عمرو بن وهب الثقفي عن المغيرة"
"19220","1039  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  رَجُلٍ يُكْنَى أَبَا عَبْدِ اللهِ ،  عَنْ  عَمْرِو بْنِ وَهْبٍ الثَّقَفِيِّ ، قَالَ :  سَأَلْتُ  الْمُغِيرَةَ بْنَ شُعْبَةَ هَلْ أَمَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَحَدٌ مِنَ الصَّحَابَةِ سِوَى  أَبِي بَكْرٍ  ؟ قَالَ : نَعَمْ ، كُنْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرِ كَذَا وَكَذَا ، فَلَمَّا كَانَ مِنَ السَّحَرِ ضَرَبَ عُنُقَ رَاحِلَتِي فَمَالَ وَمِلْتُ مَعَهُ ، فَقَضَى حَاجَتَهُ ثُمَّ قَالَ :  يَا  مُغِيرَةُ  حَاجَتَكَ  ، قُلْتُ : لَيْسَ لِي حَاجَةٌ ، قَالَ : "" هَلْ مِنْ مَاءٍ ؟ "" فَدَعَا  بِإِدَاوَةٍ  أَوْ  سَطِيحَةٍ  فَغَسَلَ يَدَيْهِ وَغَسَلَ وَجْهَهُ ، ثُمَّ ذَهَبَ  يَحْسِرُ  عَنْ ذِرَاعَيْهِ فَضَاقَتْ كُمُّ جُبَّةٍ شَامِيَّةٍ كَانَتْ عَلَيْهِ ، فَأَخْرَجَ يَدَيْهِ مِنْ تَحْتِ الْجُبَّةِ فَغَسَلَ يَدَيْهِ ، وَمَسَحَ بِنَاصِيَتِهِ ، وَمَسَحَ عَلَى الْخُفَّيْنِ ، قَالَ : ثُمَّ انْتَهَيْنَا إِلَى النَّاسِ وَقَدْ أُقِيمَتِ الصَّلَاةُ وَقَدْ أَمَّهُمْ  عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  وَقَدْ صَلَّى بِهِمْ رَكْعَةً ، فَذَهَبْتُ أُوذِنُهُ فَنَهَانِي ، فَصَلَّيْنَا الَّذِي أَدْرَكْنَا ، وَقَضَيْنَا الَّذِي سُبِقْنَا  .","","Al-Mu'jam al-Kabir 1039","","المغيرة بن شعبة عن عمرو بن وهب الثقفي عن أبو عبد الله عن محمد بن سيرين عن أيوب السختياني عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن وهب الثقفي عن المغيرة"
"19221","1040  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنِ  ابْنِ سِيرِينَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، نَحْوَهُ .","","Al-Mu'jam al-Kabir 1040","","المغيرة بن شعبة عن محمد بن سيرين عن جرير بن حازم عن سليمان بن حرب الواشحي عن أبو مسلم الكجي عن الطبراني","عمرو بن وهب الثقفي عن المغيرة"
"19222","1041  -  حَدَّثَنَا  مُحَمَّدُ بْنُ حَيَّانَ الْمَازِنِيُّ ، وَمُحَمَّدُ بْنُ يَحْيَى بْنِ الْمُنْذِرِ الْقَزَّازُ قَالَا ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  يَزِيدُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  مُحَمَّدٌ ،  عَنْ  بَعْضِ أَصْحَابِهِ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَفْرَغَ مَاءً فَغَسَلَ يَدَيْهِ ثُمَّ غَسَلَ وَجْهَهُ  ، فَلَمَّا أَرَادَ أَنْ يَغْسِلَ ذِرَاعَيْهِ كَانَتْ عَلَيْهِ         [20/430]      جُبَّةٌ شَامِيَّةٌ ضَيِّقَةُ الْكُمَّيْنِ ، فَأَخْرَجَ يَدَيْهِ مِنْ تَحْتِ الْجُبَّةِ فَغَسَلَ ذِرَاعَيْهِ ثُمَّ مَسَحَ بِنَاصِيَتِهِ ، وَمَسَحَ بِرَأْسِهِ وَعَلَى عِمَامَتِهِ وَخُفَّيْهِ  .","","Al-Mu'jam al-Kabir 1041","","المغيرة بن شعبة عن بعض أصحاب محمد بن سيرين عن محمد بن سيرين عن يزيد بن إبراهيم التستري عن أبو الوليد الطيالسي عن محمد بن يحيى بن المنذر القزاز عن الطبراني","عمرو بن وهب الثقفي عن المغيرة"
"19223","جُبَيْرُ بْنُ حَيَّةَ الثَّقَفِيُّ مَوْلَاهُمْ  ، عَنِ  الْمُغِيرَةِ  1042  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَمْرُو بْنُ عَوْنٍ الْوَاسِطِيُّ ،  أَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  زِيَادِ بْنِ جُبَيْرٍ ،  عَنْ  أَبِيهِ جُبَيْرٍ  ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،  قَالَ - وَأَحْسِبُ  أَهْلَ زِيَادٍ  أَخْبَرُونِي  أَنَّهُ  رَفَعَهُ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الرَّاكِبُ يَمْشِي خَلْفَ الْجِنَازَةِ  ، وَالْمَاشِي يَمْشِي خَلْفَهَا وَعَنْ يَمِينِهَا وَعَنْ يَسَارِهَا ، وَالسِّقْطُ يُصَلَّى عَلَيْهِ وَيُدْعَى لِوَالِدَيْهِ بِالْمَغْفِرَةِ وَالرَّحْمَةِ  .","","Al-Mu'jam al-Kabir 1042","","المغيرة بن شعبة عن جبير بن حية بن مسعود الثقفي عن زياد بن جبير الثقفي عن يونس بن عبيد عن خالد بن عبد الله الطحان عن عمرو بن عون الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","جبير بن حية الثقفي مولاهم عن المغيرة"
"19224","1043  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  يُونُسَ ،  عَنْ  زِيَادِ بْنِ جُبَيْرٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  السُّقْطُ  يُصَلَّى عَلَيْهِ وَيُدْعَى لِأَبَوَيْهِ بِالْعَافِيَةِ وَالرَّحْمَةِ  لَمْ  يَرْفَعْهُ  سُفْيَانُ  .","","Al-Mu'jam al-Kabir 1043","","المغيرة بن شعبة عن جبير بن حية بن مسعود الثقفي عن زياد بن جبير الثقفي عن يونس بن عبيد عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","جبير بن حية الثقفي مولاهم عن المغيرة"
"19225","1044  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُسْتَمِرِّ الْعُرُوقِيُّ ،  ثَنَا  قُرَّةُ بْنُ حَبِيبٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ بُكَيْرٍ الْمُزَنِيُّ ،  ثَنَا  يُونُسُ بْنُ عُبَيْدٍ ،  عَنْ  زِيَادِ بْنِ جُبَيْرٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الرَّاكِبُ خَلْفَ الْجِنَازَةِ  ، وَالْمَاشِي حَيْثُ شَاءَ مِنْهَا ، وَالطِّفْلُ يُصَلَّى عَلَيْهِ  .","","Al-Mu'jam al-Kabir 1044","","المغيرة بن شعبة عن جبير بن حية بن مسعود الثقفي عن زياد بن جبير الثقفي عن يونس بن عبيد عن عبد الله بن بكر بن عبد الله المزني عن قرة بن حبيب القنوي عن إبراهيم بن المستمر العروقي عن عبد الله بن أحمد الجواليقي عن الطبراني","جبير بن حية الثقفي مولاهم عن المغيرة"
"19226","[20/431]      1045  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  (  ح  ) ،  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  وَكِيعٌ ،  عَنْ  سَعِيدِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  زِيَادِ بْنِ جُبَيْرٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الرَّاكِبُ خَلْفَ الْجِنَازَةِ  ، وَالْمَاشِي حَيْثُ شَاءَ ، وَالطِّفْلُ يُصَلَّى عَلَيْهِ  .","","Al-Mu'jam al-Kabir 1045","","المغيرة بن شعبة عن جبير بن حية بن مسعود الثقفي عن زياد بن جبير الثقفي عن سعيد بن عبيد الله الجبيري عن وكيع بن الجراح عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","جبير بن حية الثقفي مولاهم عن المغيرة"
"19227","1046  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  ثَنَا  إِسْمَاعِيلُ بْنُ سَعِيدِ بْنِ عُبَيْدِ اللهِ بْنِ جُبَيْرِ بْنِ حَيَّةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  زِيَادِ بْنِ جُبَيْرٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الرَّاكِبُ خَلْفَ الْجِنَازَةِ  ، وَالْمَاشِي حَيْثُ شَاءَ ، وَالطِّفْلُ يُصَلَّى عَلَيْهِ  .","","Al-Mu'jam al-Kabir 1046","","المغيرة بن شعبة عن جبير بن حية بن مسعود الثقفي عن زياد بن جبير الثقفي عن سعيد بن عبيد الله الجبيري عن إسماعيل بن سعيد بن عبيد الله الجبيري عن أبو موسى الزمن عن محمد بن صالح النرسي عن الطبراني","جبير بن حية الثقفي مولاهم عن المغيرة"
"19228","1047  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ زَكَرِيَّا ، (  ح  )  وَحَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُوسَى الْحَرَشِيُّ ، قَالَا ،  ثَنَا  إِسْمَاعِيلُ بْنُ سَعِيدٍ الْجُبَيْرِيُّ ، قَالَ  سَمِعْتُ  أَبِي  يُحَدِّثُ ، عَنْ  زِيَادِ بْنِ جُبَيْرٍ ،  عَنْ  أَبِيهِ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْخَيْلُ  مَعْقُودٌ  فِي نَوَاصِيهَا الْخَيْرُ إِلَى يَوْمِ الْقِيَامَةِ  ، وَأَهْلُهَا مُعَانُونَ عَلَيْهَا  .","","Al-Mu'jam al-Kabir 1047","","المغيرة بن شعبة عن جبير بن حية بن مسعود الثقفي عن زياد بن جبير الثقفي عن سعيد بن عبيد الله الجبيري عن إسماعيل بن سعيد بن عبيد الله الجبيري عن محمد بن موسى الحرشي عن الساجي عن الطبراني","جبير بن حية الثقفي مولاهم عن المغيرة"
"19229","1048  -  حَدَّثَنَا  أَبُو حَنِيفَةَ مُحَمَّدُ بْنُ حَنِيفَةَ الْوَاسِطِيُّ ،  ثَنَا  مُعْتَمِرُ بْنُ سَهْلٍ الْأَهْوَازِيُّ  ،  ثَنَا  عُبَيْدُ اللهِ بْنُ تَمَّامٍ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  زِيَادِ بْنِ جُبَيْرٍ ،  عَنْ  أَبِيهِ ،  عَنِ  الْمُغِيرَةِ ، قَالَ :  صَلَّيْتُ إِلَى جَنْبِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَوَجَدَ مِنِّي رِيحَ الثُّومِ  قَالَ : "" مَا هَذِهِ الرِّيحُ ؟ "" قُلْتُ : يَا رَسُولَ اللهِ ، اشْتَكَيْتُ صَدْرِي فَأَكَلْتُ ، فَلَمْ يَعِبْهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( معمر بن سهل )","","Al-Mu'jam al-Kabir 1048","","المغيرة بن شعبة عن جبير بن حية بن مسعود الثقفي عن زياد بن جبير الثقفي عن يونس بن عبيد عن عبيد الله بن تمام السلمي عن معمر بن سهل بن معمر الأهوازي عن محمد بن حنيفة القصبى عن الطبراني","جبير بن حية الثقفي مولاهم عن المغيرة"
"19230","[20/432]      1049  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ ،  ثَنَا  آدَمُ بْنُ أَبِي إِيَاسٍ ،  ثَنَا  مُبَارَكُ بْنُ فَضَالَةَ ،  ثَنَا  زِيَادُ بْنُ جُبَيْرِ بْنِ حَيَّةَ ،  حَدَّثَنِي  أَبِي  قَالَ  :  أَرْسَلَ إِلَيْهِمْ  بَنْدَادْقَانُ  الْعِلْجُ أَنْ أَرْسِلُوا ، يَا مَعْشَرَ الْعَرَبِ بِرَجُلٍ مِنْكُمْ نُكَلِّمُهُ ، فَاخْتَارَ النَّاسُ الْمُغِيرَةَ بْنَ شُعْبَةَ ، قَالَ أَبِي : فَكَأَنِّي أَنْظُرُ إِلَيْهِ طَوِيلَ الشَّعَرِ  أَعْوَرَ  ، فَأَتَاهُ فَلَمَّا رَجَعَ إِلَيْنَا سَأَلْنَاهُ مَا قَالَ لَهُ ؟ فَقَالَ : لَمَّا حَمِدْتُ اللهَ وَأَثْنَيْتُ عَلَيْهِ وَقُلْتُ :  إِنْ كُنَّا لَأَبْعَدَ النَّاسِ دَارًا ، وَأَشَدَّ النَّاسِ جُوعًا  ، وَأَعْظَمَ النَّاسِ شَقَاءً ، وَأَبْعَدَ النَّاسِ مِنْ كُلِّ خَيْرٍ حَتَّى بَعَثَ اللهُ إِلَيْنَا رَسُولًا ، فَوَعَدَنَا النَّصْرَ فِي الدُّنْيَا ، وَالْجَنَّةَ فِي الْآخِرَةِ ، فَلَمْ نَزَلْ نَعْرِفُ مِنْ رَبِّنَا مُنْذُ جَاءَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْفَلَاحَ وَالنَّصْرَ حَتَّى أَتَيْنَاكُمْ  ""  .","","Al-Mu'jam al-Kabir 1049","","المغيرة بن شعبة عن جبير بن حية بن مسعود الثقفي عن زياد بن جبير الثقفي عن مبارك بن فضالة عن آدم بن أبي إياس عن أبو زرعة الدمشقي عن الطبراني","جبير بن حية الثقفي مولاهم عن المغيرة"
"19231","1050  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ شُعَيْبٍ السِّمْسَارُ ،  ثَنَا  خَالِدُ بْنُ خِدَاشٍ ،  ثَنَا  عَمْرُو بْنُ الزُّبَيْرِ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  جُبَيْرِ بْنِ حَيَّةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  تَنَحَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَتَنَحَّيْتُ مَعَهُ ، فَدَنَوْتُ مِنْهُ قَالَ : "" مَعَكَ مَاءٌ ؟ "" قُلْتُ : نَعَمْ ، فَغَسَلَ كَفَّيْهِ وَوَجْهَهُ  ، وَذَهَبَ يَغْسِلُ يَدَيْهِ وَعَلَيْهِ جُبَّةٌ فَضَاقَتْ ، فَأَخْرَجَ يَدَهُ مِنْ أَسْفَلِ الْجُبَّةِ فَغَسَلَهُمَا ثُمَّ مَسَحَ عَلَى خُفَّيْهِ ثُمَّ جَاءَ يُصَلِّي ،  وَعَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  يُصَلِّي بِالنَّاسِ ، فَلَمَّا رَأَوُا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَنَحْنَحُوا فَذَهَبَ يَتَأَخَّرُ فَأَوْمَأَ إِلَيْهِ : امْضِهْ  .","","Al-Mu'jam al-Kabir 1050","","المغيرة بن شعبة عن جبير بن حية بن مسعود الثقفي عن الزبير الصراف عن عمرو بن الزبير الصراف عن خالد المهلبي عن محمد بن علي بن شعيب السمسار عن الطبراني","جبير بن حية الثقفي مولاهم عن المغيرة"
"19232","زُرَارَةُ بْنُ أَوْفَى  ،  وَالْحَسَنُ الْبَصْرِيُّ  ، عَنِ  الْمُغِيرَةِ  1051  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَزَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ قَالُوا ،  ثَنَا  هُدْبَةُ ،  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنِ         [20/433]      الْحَسَنِ ، وَزُرَارَةَ بْنِ أَوْفَى ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  تَخَلَّفَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَتَخَلَّفْتُ مَعَهُ ، فَقَضَى حَاجَتَهُ وَأَتَيْتُهُ بِالْمِطْهَرَةِ فَتَوَضَّأَ وَغَسَلَ وَجْهَهُ  وَأَرَادَ أَنْ يَغْسِلَ يَدَيْهِ ، وَكَانَتْ عَلَيْهِ جُبَّةٌ شَامِيَّةٌ ضَيِّقَةُ الْكُمَّيْنِ ، فَأَخْرَجَ يَدَيْهِ مِنْ تَحْتِ الْجُبَّةِ فَغَسَلَ وَجْهَهُ وَذِرَاعَيْهِ ، وَمَسَحَ عَلَى الْعِمَامَةِ وَالْخُفَّيْنِ ، فَأَتَيْنَا النَّاسَ  وَعَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  يُصَلِّي بِهِمْ صَلَاةَ الصُّبْحِ ، فَلَمَّا رَأَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَرَادَ أَنْ يَتَأَخَّرَ فَأَوْمَأَ إِلَيْهِ أَنْ يَمْضِي فِي صَلَاتِهِ ، فَصَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَنَا مَعَهُ خَلْفَ  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  ، فَلَمَّا قَضَى صَلَاتَهُ قَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَصَلَّى إِلَيْهَا رَكْعَةً أُخْرَى فَلَمْ يَزِدْ عَلَيْهَا شَيْئًا  .","","Al-Mu'jam al-Kabir 1051","","المغيرة بن شعبة عن الحسن البصري عن قتادة بن دعامة عن همام بن يحيى بن دينار عن هدبة بن خالد عن عبد الله بن أحمد بن حنبل عن الطبراني","زرارة بن أوفى والحسن البصري عن المغيرة"
"19233","بَكْرُ بْنُ عَبْدِ اللهِ الْمُزَنِيُّ  ، عَنِ  الْمُغِيرَةِ  1052  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَاصِمٍ الْأَحْوَلِ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ ، (  ح  )  قَالَ  عَبْدُ الرَّزَّاقِ :  وَأَنَا  مَعْمَرٌ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ  أَنَّ  الْمُغِيرَةَ بْنَ شُعْبَةَ قَالَ :  أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَذَكَرْتُ لَهُ امْرَأَةً أَخْطُبُهَا فَقَالَ :  اذْهَبْ فَانْظُرْ إِلَيْهَا ، فَإِنَّهُ أَحْرَى أَنْ  يُؤْدَمَ  بَيْنَكُمَا  فَأَتَيْتُ  امْرَأَةً مِنَ الْأَنْصَارِ  فَخَطَبْتُهَا إِلَى أَبَوَيْهَا وَأَخْبَرْتُهُمَا بِقَوْلِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَكَأَنَّهُمَا كَرِهَا ذَلِكَ ، فَسَمِعَتْ ذَلِكَ الْمَرْأَةُ وَهِيَ فِي خِدْرِهَا ، فَقَالَتْ : إِنْ كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَكَ أَنْ تَنْظُرَ فَانْظُرْ ، وَإِلَّا فَإِنِّي أَنْشُدُكَ ، كَأَنَّهَا أَعْظَمَتْ ذَلِكَ ، قَالَ : فَنَظَرْتُ إِلَيْهَا فَتَزَوَّجْتُهَا "" . وَذَكَرَ مِنْ مُوَافَقَتِهَا  .","","Al-Mu'jam al-Kabir 1052","","المغيرة بن شعبة عن بكر بن عبد الله المزني عن عاصم بن سليمان الأحول عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","بكر بن عبد الله المزني عن المغيرة"
"19234","[20/434]      1053  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  عَاصِمٍ الْأَحْوَلِ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ ، قَالَ :  خَطَبَ الْمُغِيرَةُ بْنُ شُعْبَةَ  امْرَأَةً  فَذَكَرَ أَمْرَهَا لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" رَأَيْتَهَا ؟ "" قَالَ : لَا ، قَالَ :  إِنِ اسْتَطَعْتَ أَنْ تَنْظُرَ إِلَيْهَا قَبْلَ أَنْ تَزَوَّجَهَا فَافْعَلْ  ، فَإِنَّهُ أَحْرَى أَنْ تُؤْدِمَ الْمَوَدَّةَ بَيْنَكُمَا "" .","","Al-Mu'jam al-Kabir 1053","","المغيرة بن شعبة عن بكر بن عبد الله المزني عن عاصم بن سليمان الأحول عن جرير بن حازم عن شيبان بن فروخ الحبطي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","بكر بن عبد الله المزني عن المغيرة"
"19235","1054  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  السَّكَنُ الْأَصَمُّ ،  ثَنَا  عَاصِمٌ الْأَحْوَلُ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  خَطَبْتُ  جَارِيَةً  فَلَمَّا تَقَارَبَ أَمْرُهَا أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ،  فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 1054","","المغيرة بن شعبة عن بكر بن عبد الله المزني عن عاصم بن سليمان الأحول عن السكن بن إسماعيل البرجمي عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","بكر بن عبد الله المزني عن المغيرة"
"19236","1055  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  أَبُو شِهَابٍ ،  عَنْ  عَاصِمٍ الْأَحْوَلِ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  خَطَبْتُ  امْرَأَةً  فَذَكَرْتُهَا لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 1055","","المغيرة بن شعبة عن بكر بن عبد الله المزني عن عاصم بن سليمان الأحول عن عبد ربه بن نافع الحناط عن سليمان بن داود العتكي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","بكر بن عبد الله المزني عن المغيرة"
"19237","1056  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  ثَنَا  عَاصِمٌ الْأَحْوَلُ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ ،  عَنِ  الْمُغِيرَةِ ، قَالَ :  خَطَبْتُ  جَارِيَةً مِنَ الْأَنْصَارِ  فَذَكَرْتُ ذَلِكَ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" رَأَيْتَهَا ؟ "" قُلْتُ : لَا ، قَالَ :  فَانْظُرْ إِلَيْهَا فَإِنَّهُ أَحْرَى أَنْ  يُؤْدَمَ  بَيْنَكُمَا  .","","Al-Mu'jam al-Kabir 1056","","المغيرة بن شعبة عن بكر بن عبد الله المزني عن عاصم بن سليمان الأحول عن عبد الواحد بن زياد عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","بكر بن عبد الله المزني عن المغيرة"
"19238","سَعِيدٌ الْقَطِيعِيُّ  ، عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  1057  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ         [20/435]      عَبْدِ الرَّحِيمِ الْبَرْقِيُّ ،  ثَنَا  شَبَابَةُ بْنُ سَوَّارٍ ،  ثَنَا  الْمُغِيرَةُ بْنُ مُسْلِمٍ ،  عَنِ  الْوَلِيدِ بْنِ مُسْلِمٍ ،  عَنْ  سَعِيدٍ الْقَطِيعِيِّ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  سَأَلْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَجْعَلَنِي إِمَامَ قَوْمِي ، فَقَالَ :  صَلِّ صَلَاةَ أَضْعَفِ  الْقَوْمِ  ، وَلَا تَتَّخِذْ مُؤَذِّنًا يَأْخُذُ عَلَى أَذَانِهِ أَجْرًا  .","","Al-Mu'jam al-Kabir 1057","","المغيرة بن شعبة عن سعيد القطيعي عن الوليد بن مسلم العنبري عن المغيرة بن مسلم القسملي عن شبابة بن سوار المدائني عن محمد بن عبد الرحيم  صاعقة عن عبد الله بن أحمد بن حنبل عن الطبراني","سعيد القطيعي عن المغيرة بن شعبة"
"19239","الْمُغِيرَةُ بْنُ عَبْدِ اللهِ بْنِ أَبِي عَقِيلٍ  - وَقَدْ قِيلَ  الْيَشْكُرِيُّ  - عَنِ  الْمُغِيرَةِ  1058  -  حَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  جَامِعِ بْنِ شَدَّادٍ أَبِي صَخْرَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ عَبْدِ اللهِ بْنِ أَبِي عَقِيلٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  ضِفْتُ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَمَرَ لِي بِجَنْبٍ فَشُوِيَ وَأَخَذَ مِنْ شَارِبِي عَلَى سِوَاكٍ بِالشَّفْرَةِ  ، فَجَعَلَ يَجُزُّ بِهَا مِنْهُ ، فَجَاءَ  بِلَالٌ  يُؤْذِنُهُ بِالصَّلَاةِ فَأَلْقَى الشَّفْرَةَ وَقَالَ لَهُ : ""  تَرِبَتْ  يَدَاكَ "" قَالَ : وَكَانَ شَارِبِي وَقَدْ  وَفَى  فَقَصَّهُ عَلَيَّ  .","","Al-Mu'jam al-Kabir 1058","","المغيرة بن شعبة عن المغيرة بن عبد الله بن أبي عقيل اليشكري عن جامع بن شداد عن مسعر بن كدام عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","المغيرة بن عبد الله بن أبي عقيل عن المغيرة"
"19240","1059  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  مِسْعَرٍ ،  حَدَّثَنِي  أَبُو صَخْرَةَ جَامِعُ بْنُ شَدَّادٍ ،  عَنِ  الْمُغِيرَةِ بْنِ عَبْدِ اللهِ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  ضِفْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَاتَ لَيْلَةٍ فَأَمَرَ بِجَنْبٍ فَشُوِيَ ثُمَّ أَخَذَ الشَّفْرَةَ فَجَعَلَ يَجُزُّ بِهَا مِنْهُ  فَجَاءَ  بِلَالٌ  يُؤْذِنُهُ بِالصَّلَاةِ فَأَلْقَىَ الشَّفْرَةَ وَقَالَ : "" مَا لَهُ  تَرِبَتْ  يَدَاهُ ؟ "" قَالَ : وَكَانَ شَارِبِي قَدْ  وَفَى  فَقَصَّهُ عَلَى سِوَاكٍ  .","","Al-Mu'jam al-Kabir 1059","","المغيرة بن شعبة عن المغيرة بن عبد الله بن أبي عقيل اليشكري عن جامع بن شداد عن مسعر بن كدام عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","المغيرة بن عبد الله بن أبي عقيل عن المغيرة"
"19241","1060  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ أَحْمَدَ بْنِ عَمْرٍو الْوَكِيعِيُّ  ،  حَدَّثَنِي  أَبِي  (  ح  ) ،         [20/436]      وَحَدَّثَنَا  غَيْلَانُ بْنُ عَبْدِ الصَّمَدِ مَاغَمَّهُ  ،  ثَنَا  الْقَاسِمُ بْنُ دِينَارٍ ، قَالَا ،  ثَنَا  إِسْحَاقُ بْنُ مَنْصُورٍ السَّلُولِيُّ ،  عَنْ  غَالِبِ بْنِ نَجِيحٍ ،  عَنْ  جَامِعِ بْنِ شَدَّادٍ ،  عَنِ  الْمُغِيرَةِ بْنِ عَبْدِ اللهِ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  تَسَحَّرْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِجَنْبٍ مَشْوِيٍّ وَكَانَ يَقْطَعُ بِالْمُدْيَةِ فَقَالَ :  لَقَدْ  وَفَى  شَارِبُكَ يَا  مُغِيرَةُ  ، فَقَصَّهُ عَلَى سِوَاكٍ بِالشَّفْرَةِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( إبراهيم بن أحمد بن عمر )  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( علان بن عبد الصمد ماغمة )","","Al-Mu'jam al-Kabir 1060","","المغيرة بن شعبة عن المغيرة بن عبد الله بن أبي عقيل اليشكري عن جامع بن شداد عن غالب بن نجيح الكوفي عن إسحاق بن منصور السلولي عن القاسم بن زكريا الطحان عن علي بن عبد الصمد علان ماغمه عن الطبراني","المغيرة بن عبد الله بن أبي عقيل عن المغيرة"
"19242","رِوَايَةُ  الْمَدَنِيِّينَ  ، عَنِ  الْمُغِيرَةِ  أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ  ، عَنِ  الْمُغِيرَةِ  1062  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا خَرَجَ فِي بَعْضِ أَسْفَارِهِ وَكَانَ إِذَا ذَهَبَ أَبْعَدَ  ، وَأَمَرَنِي أَنْ أَتَّبِعَهُ بِوَضُوءٍ ، فَجَاءَ وَعَلَيْهِ جُبَّةٌ شَامِيَّةٌ ، فَأَخْرَجَ يَدَهُ مِنْ تَحْتِهَا فَتَوَضَّأَ وَمَسَحَ عَلَى الْخُفَّيْنِ  .","","Al-Mu'jam al-Kabir 1062","","المغيرة بن شعبة عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عبد العزيز بن محمد الدراوردي عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو سلمة بن عبد الرحمن عن المغيرة"
"19243","1063  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  حَجَّاجُ بْنُ إِبْرَاهِيمَ الْأَزْرَقُ ،  ثَنَا  إِسْمَاعِيلُ بْنُ جَعْفَرٍ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا ذَهَبَ  الْمَذْهَبَ  أَبْعَدَ  ، فَذَهَبَ لِحَاجَةٍ وَهُوَ فِي بَعْضِ أَسْفَارِهِ فَقَالَ : "" ائْتِنِي بِوَضُوءٍ "" ، فَجِئْتُهُ بِوَضُوءٍ ، فَأَخْرَجَ يَدَيْهِ مِنْ تَحْتِ الْجُبَّةِ فَتَوَضَّأَ وَمَسَحَ عَلَى الْخُفَّيْنِ  .","","Al-Mu'jam al-Kabir 1063","","المغيرة بن شعبة عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن إسماعيل بن جعفر بن أبي كثير الزرقي عن حجاج بن إبراهيم الأبناوي عن يوسف بن يزيد القراطيسي عن الطبراني","أبو سلمة بن عبد الرحمن عن المغيرة"
"19244","[20/437]      1064  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  يَعْلَى بْنُ عُبَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  كُنْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي بَعْضِ أَسْفَارِهِ وَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا ذَهَبَ فِي حَاجَةٍ  أَبْعَدَ  الْمَذْهَبَ  ، فَقَالَ :  اتْبَعْنِي بِالْمَاءِ ،  فَاتَّبَعْتُهُ  بِإِدَاوَةٍ  ، وَكَانَتْ عَلَيْهِ جُبَّةٌ شَامِيَّةٌ ضَيِّقَةُ الْكُمَّيْنِ فَأَخْرَجَ يَدَيْهِ مِنْ تَحْتِ الْجُبَّةِ ، فَتَوَضَّأَ وَمَسَحَ عَلَى الْخُفَّيْنِ  .","","Al-Mu'jam al-Kabir 1064","","المغيرة بن شعبة عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يعلى بن عبيد الطنافسي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو سلمة بن عبد الرحمن عن المغيرة"
"19245","1065  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  إِسْمَاعِيلُ ابْنُ عُلَيَّةَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  كُنْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي بَعْضِ أَسْفَارِهِ  فَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا ذَهَبَ  أَبْعَدَ  الْمَذْهَبَ  .","","Al-Mu'jam al-Kabir 1065","","المغيرة بن شعبة عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن إسماعيل ابن علية عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو سلمة بن عبد الرحمن عن المغيرة"
"19246","1066  -  حَدَّثَنَا  مُحَمَّدُ بْنُ حَيَّانَ الْمَازِنِيُّ ،  ثَنَا  يُوسُفُ بْنُ عَنْبَسٍ  الْيَمَامِيُّ ،  ثَنَا  عِكْرِمَةُ بْنُ عَمَّارٍ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ، قَالَ :  قَالَ  الْمُغِيرَةُ بْنُ شُعْبَةَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنِّي ذَكَرْتُ  فُلَانَةً  أَتُطْلِقُ لِي أَنْ أَرَاهَا ؟ قَالَ : "" نَعَمْ  ، فَإِنْ كُنْتُ لَأَحْتَالُهَا فِي أُصُولِ النَّخْلِ لِتَمُرَّ بِي  .  في طبعة مكتبة ابن تيمية : (عيسى) والمثبت من النسخة الخطية . والله أعلم .","","Al-Mu'jam al-Kabir 1066","","المغيرة بن شعبة عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن عكرمة بن عمار عن يوسف بن عنبس البصري عن محمد بن حيان المازني عن الطبراني","أبو سلمة بن عبد الرحمن عن المغيرة"
"19247","قَبِيصَةُ بْنُ ذُؤَيْبٍ  ، عَنِ  الْمُغِيرَةِ  1067  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  قَبِيصَةَ بْنِ ذُؤَيْبٍ ، قَالَ :  جَاءَتِ الْجَدَّةُ إِلَى  أَبِي بَكْرٍ  رَضِيَ اللهُ عَنْهُ تَطْلُبُ مِيرَاثَهَا مِنِ  ابْنِ ابْنِهَا أَوِ ابْنِ ابْنَتِهَا - لَا أَدْرِي أَيَّتُهُمَا هِيَ  - فَقَالَ  أَبُو بَكْرٍ  : مَا أَجِدُ لَكِ فِي كِتَابِ اللهِ شَيْئًا ، وَمَا سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْضِي لَكِ بِشَيْءٍ ، وَسَأَسْأَلُ النَّاسَ الْعَشِيَّةَ ، فَلَمَّا         [20/438]      صَلَّى الظُّهْرَ أَقْبَلَ عَلَى النَّاسِ فَقَالَ : إِنَّ الْجَدَّةَ أَتَتْنِي تَسْأَلُنِي مِيرَاثَهَا مِنِ  ابْنِ ابْنِهَا أَوِ ابْنِ ابْنَتِهَا  ، وَإِنِّي لَمْ أَجِدْ لَهَا فِي الْكِتَابِ شَيْئًا ، وَلَمْ أَسْمَعِ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَضَى لَهَا بِشَيْءٍ ، فَهَلْ سَمِعَ أَحَدٌ مِنْكُمْ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِيهَا شَيْئًا ؟ فَقَامَ الْمُغِيرَةُ بْنُ شُعْبَةَ فَقَالَ :  شَهِدْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْضِي لَهَا بِالسُّدُسِ  فَقَالَ : هَلْ سَمِعَ ذَلِكَ مَعَكَ أَحَدٌ ؟ فَقَامَ مُحَمَّدُ بْنُ مَسْلَمَةَ فَقَالَ : "" شَهِدْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْضِي لَهَا بِالسُّدُسِ "" ، فَأَعْطَاهَا  أَبُو بَكْرٍ  السُّدُسَ ، فَلَمَّا كَانَتْ خِلَافَةُ  عُمَرَ  جَاءَتْهُ الْجَدَّةُ الَّتِي تُخَالِفُهَا فَقَالَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ : إِنَّمَا كَانَ الْقَضَاءُ فِي غَيْرِكِ ، وَلَكِنْ إِذَا اجْتَمَعْتُمَا فَالسُّدُسُ بَيْنَكُمَا ، وَأَيَّتُكُمَا خَلَتْ بِهِ فَهُوَ لَهَا  .","","Al-Mu'jam al-Kabir 1067","","محمد بن مسلمة بن سلمة الخزرجي عن قبيصة بن ذؤيب الخزاعي عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","قبيصة بن ذؤيب عن المغيرة"
"19248","1068  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ ، (  ح  )  وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْحَكَمِ ، (  ح  )  وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ، (  ح  )  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ، قَالُوا :  أَنَا  مَالِكٌ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُثْمَانَ بْنِ إِسْحَاقَ بْنِ خَرَشَةَ ،  عَنْ  قَبِيصَةَ بْنِ ذُؤَيْبٍ ، قَالَ :  جَاءَتِ الْجَدَّةُ إِلَى  أَبِي بَكْرٍ الصِّدِّيقِ  رَضِيَ اللهُ عَنْهُ تَسْأَلُهُ مِيرَاثَهَا فِي كِتَابِ اللهِ ، فَقَالَ لَهَا  أَبُو بَكْرٍ  : مَا لَكِ فِي كِتَابِ اللهِ شَيْءٌ ، وَمَا عَلِمْتُ لَكِ فِي سُنَّةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ شَيْئًا فَارْجِعِي حَتَّى أَسْأَلَ النَّاسَ ، فَسَأَلَ النَّاسَ فَقَالَ الْمُغِيرَةُ بْنُ شُعْبَةَ :  حَضَرْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَعْطَاهَا السُّدُسَ "" ، فَقَالَ  أَبُو بَكْرٍ  : هَلْ مَعَكَ غَيْرُكَ ؟  فَقَامَ مُحَمَّدُ بْنُ مَسْلَمَةَ الْأَنْصَارِيُّ         [20/439]      فَقَالَ مِثْلَ مَا قَالَ  الْمُغِيرَةُ  ، فَأَنْفَذَهُ لَهَا  أَبُو بَكْرٍ  ، ثُمَّ جَاءَتِ الْجَدَّةُ الْأُخْرَى إِلَى  عُمَرَ بْنِ الْخَطَّابِ  تَسْأَلُهُ مِيرَاثَهَا ، فَقَالَ : مَا لَكِ فِي كِتَابِ اللهِ مِنْ شَيْءٍ ، وَمَا كَانَ الْقَضَاءُ الَّذِي قُضِيَ بِهِ إِلَّا لِغَيْرِكِ ، وَمَا أَنَا بِزَائِدٍ فِي الْفَرَائِضِ شَيْئًا ، وَلَكِنْ هُوَ ذَلِكَ السُّدُسُ ، فَإِنِ اجْتَمَعْتُمَا فَهُوَ بَيْنَكُمَا ، وَأَيَّتُكُمَا خَلَتْ بِهِ فَهُوَ لَهَا  ،  وَاللَّفْظُ لِحَدِيثِ  ابْنِ عَبْدِ الْحَكَمِ  .","","Al-Mu'jam al-Kabir 1068","","محمد بن مسلمة بن سلمة الخزرجي عن قبيصة بن ذؤيب الخزاعي عن عثمان بن إسحاق بن خرشة العامري عن الزهري عن مالك بن أنس عن عبد الله بن عبد الحكم بن أعين عن يوسف بن يزيد القراطيسي عن الطبراني","قبيصة بن ذؤيب عن المغيرة"
"19249","عُرْوَةُ بْنُ الزُّبَيْرِ  ، عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  1069  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ، أَنَّهُ  حَدَّثَ ، عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّ  عُمَرَ  ، اسْتَشَارَهُمْ فِي  إِمْلَاصِ  الْمَرْأَةِ ، فَقَالَ  الْمُغِيرَةُ  :  قَضَى فِيهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِغُرَّةٍ  فَقَالَ  عُمَرُ  : إِنْ كُنْتَ صَادِقًا فَائْتِ بِأَحَدٍ يَعْلَمُ ذَلِكَ ، فَشَهِدَ مُحَمَّدُ بْنُ مَسْلَمَةَ أَنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَضَى فِيهِ بِغُرَّةٍ  .","","Al-Mu'jam al-Kabir 1069","","محمد بن مسلمة بن سلمة الخزرجي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عروة بن الزبير عن المغيرة بن شعبة"
"19250","1070  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  سَمِعْتُ  الْمُغِيرَةَ بْنَ شُعْبَةَ ،  أَنَّ  عُمَرَ  ، سَأَلَهُمْ عَنْ  إِمْلَاصِ  الْمَرْأَةِ ، فَقَالَ  الْمُغِيرَةُ  :  قَضَى فِيهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِغُرَّةٍ  عَبْدٍ أَوْ أَمَةٍ  فَقَالَ  عُمَرُ  : مَنْ يُصَدِّقُكَ ؟ فَشَهِدَ لَهُ مُحَمَّدُ بْنُ مَسْلَمَةَ  .","","Al-Mu'jam al-Kabir 1070","","محمد بن مسلمة بن سلمة الخزرجي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","عروة بن الزبير عن المغيرة بن شعبة"
"19251","1071  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ قَالَا ،  ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُسْلِمٍ ،  ثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ  ، رَضِيَ اللهُ عَنْهُ اسْتَفْتَاهُمْ فِي  إِمْلَاصِ  الْمَرْأَةِ ، فَقَالَ  الْمُغِيرَةُ بْنُ شُعْبَةَ  :  قَضَى فِيهِ رَسُولُ اللهِ         [20/440]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِغُرَّةٍ  ، فَشَهِدَ لَهُ مُحَمَّدُ بْنُ مَسْلَمَةَ الْأَنْصَارِيُّ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَضَى بِهِ  .","","Al-Mu'jam al-Kabir 1071","","محمد بن مسلمة بن سلمة الخزرجي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد العزيز بن مسلم الخراساني عن شيبان بن فروخ الحبطي عن الحسين بن إسحاق التستري عن الطبراني","عروة بن الزبير عن المغيرة بن شعبة"
"19252","1072  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ،  ثَنَا  مُوسَى بْنُ مُحَمَّدِ بْنِ حَيَّانَ الْبَصْرِيُّ ،  ثَنَا  أَبُو بَحْرٍ الْبَكْرَاوِيُّ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا أَرَادَ حَاجَةً  أَبْعَدَ  .","","Al-Mu'jam al-Kabir 1072","","المغيرة بن شعبة عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أبو بحر البكراوي عن موسى بن محمد بن سعيد البصري عن محمد بن علي بن زيد الصائغ عن الطبراني","عروة بن الزبير عن المغيرة بن شعبة"
"19253","1073  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ الْمُنْذِرِ الْقَزَّازُ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  أَنَّهُ كَانَ مَعَ رَجُلَيْنِ مِنْ قَوْمِهِ كُفَّارٍ فَقَتَلَهُمَا وَسَلَبَهُمَا فَجَاءَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَكَرِهَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الَّذِي صَنَعَ  ، وَأَهْدَى لَهُ سَلَبَهُمَا فَلَمْ يَقْبَلْهُ  .","","Al-Mu'jam al-Kabir 1073","","المغيرة بن شعبة عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن حفص بن عمر الحوضى عن محمد بن يحيى بن المنذر القزاز عن الطبراني","عروة بن الزبير عن المغيرة بن شعبة"
"19254","1074  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ ،  ثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ مَاهَانَ بْنِ أَبِي حَنِيفَةَ ،  ثَنَا  أَبِي  ،  ثَنَا  الْعَلَاءُ بْنُ رَاشِدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  أَنَّهُ صَحِبَ قَوْمًا مِنَ الْمُشْرِكِينَ فَوَجَدَ مِنْهُمْ غَفْلَةً ، فَقَتَلَهُمْ وَأَخَذَ أَمْوَالَهُمْ ، فَجَاءَ بِهَا إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَكَرِهَ مَا صَنَعَ  وَأَبَى أَنْ يَقْبَلَهَا  .","","Al-Mu'jam al-Kabir 1074","","المغيرة بن شعبة عن عروة بن الزبير عن هشام بن عروة بن الزبير عن العلاء بن راشد عن محمد بن ماهان القصباني عن أحمد بن أبي حنيفة محمد بن ماهان عن بحشل عن الطبراني","عروة بن الزبير عن المغيرة بن شعبة"
"19255","1075  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  ابْنُ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،         [20/441]      أَنَّ  عُمَرَ  ، اسْتَشَارَهُمْ فِي  إِمْلَاصِ  الْمَرْأَةِ ، قَالَ  الْمُغِيرَةُ  : فَقُلْتُ  لِعُمَرَ  :  قَضَى فِيهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالْغُرَّةِ  . قَالَ  عُمَرُ  : إِنْ كُنْتَ صَادِقًا فَائْتِنِي بِمَنْ يَعْلَمُ هَذَا مَعَكَ ، فَقَالَ مُحَمَّدُ بْنُ مَسْلَمَةَ : "" شَهِدْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَضَى فِي  إِمْلَاصِ  الْمَرْأَةِ الْغُرَّةَ "" فَقَضَى بِهِ  عُمَرُ  رَضِيَ اللهُ عَنْهُ  .","","Al-Mu'jam al-Kabir 1075","","محمد بن مسلمة بن سلمة الخزرجي عن عروة بن الزبير عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","عروة بن الزبير عن المغيرة بن شعبة"
"19256","1076  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  بِشْرُ بْنُ خَالِدٍ الْعَسْكَرِيُّ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  أَنَّهُ صَحِبَ قَوْمًا مِنَ الْمُشْرِكِينَ فَوَجَدَ مِنْهُمْ غَفْلَةً فَقَتَلَهُمْ ، وَأَخَذَ أَمْوَالَهُمْ ، فَجَاءَ بِهَا إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَبَى  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَقْبَلَهَا  .","","Al-Mu'jam al-Kabir 1076","","المغيرة بن شعبة عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أبو معاوية الضرير عن بشر بن خالد الفرائضي عن أحمد بن يحيى بن زهير التستري عن الطبراني","عروة بن الزبير عن المغيرة بن شعبة"
"19257","مُحَمَّدُ بْنُ كَعْبٍ الْقُرَظِيُّ  ، عَنِ  الْمُغِيرَةِ  1077  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  الْحُسَيْنُ بْنُ أَبِي السَّرِيِّ الْعَسْقَلَانِيُّ ،  ثَنَا  مَكِّيُّ بْنُ إِبْرَاهِيمَ ،  ثَنَا  هَاشِمُ بْنُ هَاشِمٍ ،  عَنْ  عَمْرِو بْنِ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ الْقُرَظِيِّ ،  عَنِ  الْمُغِيرَةِ ، قَالَ :  قَامَ فِينَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَقَامًا فَأَخْبَرَنَا بِمَا يَكُونُ فِي أُمَّتِهِ إِلَى يَوْمِ الْقِيَامَةِ  ،  وَعَاهُ  مَنْ  وَعَاهُ  ، وَنَسِيَهُ مَنْ نَسِيَهُ  .","","Al-Mu'jam al-Kabir 1077","","المغيرة بن شعبة عن محمد بن كعب بن سليم القرظي عن عمر بن إبراهيم بن محمد بن الأسود عن هاشم بن هاشم بن عتبة الوقاصي عن مكي بن إبراهيم عن الحسين بن أبي السري العسقلاني عن الحسين بن إسحاق التستري عن الطبراني","محمد بن كعب القرظي عن المغيرة"
"19258","أَبُو السَّائِبِ مَوْلَى هِشَامِ بْنِ زُهْرَةَ  ، عَنِ  الْمُغِيرَةِ  1078  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،         [20/442]      أَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  أَخْبَرَنِي  شَرِيكُ بْنُ عَبْدِ اللهِ بْنِ أَبِي نَمِرٍ ،  أَخْبَرَنِي  أَبُو السَّائِبِ ، مَوْلَى هِشَامِ بْنِ زُهْرَةَ التَّيْمِيِّ  أَنَّهُ سَمِعَ  الْمُغِيرَةَ بْنَ شُعْبَةَ ، يَقُولُ :  خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ ، فَنَزَلَ مَنْزِلًا فَتَبَرَّزَ فَتَبِعْتُهُ  بِإِدَاوَةٍ  ،  فَلَمَّا أَقْبَلَ تَلَقَّيْتُهُ فَصَبَبْتُ عَلَيْهِ فَتَوَضَّأَ وَعَلَيْهِ خُفَّانِ ، فَمَسَحَ عَلَيْهِمَا ثُمَّ صَلَّى الصُّبْحَ  .","","Al-Mu'jam al-Kabir 1078","","المغيرة بن شعبة عن أبو السائب الجهني مولى هشام بن زهرة عن شريك بن عبد الله بن أبي نمر الكناني عن محمد بن جعفر بن أبي كثير الزرقي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","أبو السائب مولى هشام بن زهرة عن المغيرة"
"19259","1079  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  حَجَّاجُ بْنُ إِبْرَاهِيمَ الْأَزْرَقُ ،  ثَنَا  إِسْمَاعِيلُ بْنُ جَعْفَرٍ ،  عَنْ  شَرِيكِ بْنِ عَبْدِ اللهِ بْنِ أَبِي نَمِرٍ ،  عَنْ  أَبِي السَّائِبِ ، مَوْلَى هِشَامِ بْنِ زُهْرَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 1079","","المغيرة بن شعبة عن أبو السائب الجهني مولى هشام بن زهرة عن شريك بن عبد الله بن أبي نمر الكناني عن إسماعيل بن جعفر بن أبي كثير الزرقي عن حجاج بن إبراهيم الأبناوي عن يوسف بن يزيد القراطيسي عن الطبراني","أبو السائب مولى هشام بن زهرة عن المغيرة"
"19260","1080  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  أَنَسُ بْنُ عِيَاضٍ ،  حَدَّثَنِي  شَرِيكُ بْنُ أَبِي نَمِرٍ ،  عَنْ  أَبِي السَّائِبِ ، مَوْلَى هِشَامِ بْنِ زُهْرَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ فِي سَفَرٍ ،  وَالْمُغِيرَةُ  كَانَ فِي ذَلِكَ السَّفَرِ  ، قَالَ : فَذَهَبَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمًا لِحَاجَتِهِ فَاتَّبَعْتُ أَثَرَهُ  بِإِدَاوَةِ  مَاءٍ ، فَنَفَرْتُ لَهُ الطَّرِيقَ فَتَوَضَّأَ وَمَسَحَ عَلَى الْخُفَّيْنِ  .","","Al-Mu'jam al-Kabir 1080","","المغيرة بن شعبة عن أبو السائب الجهني مولى هشام بن زهرة عن شريك بن عبد الله بن أبي نمر الكناني عن أنس بن عياض الليثي عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","أبو السائب مولى هشام بن زهرة عن المغيرة"
"19261","1081  -  حَدَّثَنَا  عَلِيُّ بْنُ مُحَمَّدٍ الْأَنْصَنَاوِيُّ الْمِصْرِيُّ  ،  ثَنَا  حَرْمَلَةُ بْنُ يَحْيَى ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  يَحْيَى بْنُ عَبْدِ اللهِ بْنِ سَالِمٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  أَبِي السَّائِبِ ، مَوْلَى هِشَامِ بْنِ زُهْرَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ وَمَسَحَ عَلَى الْخُفَّيْنِ  "" .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( الأنضناوي )","","Al-Mu'jam al-Kabir 1081","","المغيرة بن شعبة عن أبو السائب الجهني مولى هشام بن زهرة عن عبيد الله بن عمر العمري عن يحيى بن عبد الله بن سالم بن عبد الله بن عمر عن عبد الله بن وهب المصري عن حرملة بن يحيى التجيبي عن علي بن محمد الأنضناوي عن الطبراني","أبو السائب مولى هشام بن زهرة عن المغيرة"
"19262","[20/443]      أَبُو مُصْعَبٍ الْمَكِّيُّ  ، عَنِ  الْمُغِيرَةِ  1082  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ، (  ح  )  وَحَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ، قَالَا :  ثَنَا  عَوْنُ بْنُ عَمْرٍو الْقَيْسِيُّ ، قَالَ :  سَمِعْتُ  أَبَا مُصْعَبٍ الْمَكِّيَّ ، قَالَ : أَدْرَكْتُ أَنَسَ بْنَ مَالِكٍ ، وَزَيْدَ بْنَ أَرْقَمَ ، وَالْمُغِيرَةَ بْنَ شُعْبَةَ ،  فَسَمِعْتُهُمْ  يُحَدِّثُونَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  أَمَرَ اللهُ شَجَرَةً  لَيْلَةَ الْغَارِ  فَنَبَتَتْ فِي وَجْهِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، وَأَمَرَ اللهُ الْعَنْكَبُوتَ فَنَسَجَتْ فِي وَجْهِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَمَرَ حَمَامَتَيْنِ وَحْشِيَّتَيْنِ فَوَقَفْتَا بِفَمِ الْغَارِ ، وَأَقْبَلَ فِتْيَانُ  قُرَيْشٍ  - مِنْ كُلِّ بَطْنٍ رَجُلٌ - بِعِصِيِّهِمْ  وَهَرَاوَاتِهِمْ  وَسُيُوفِهِمْ ، حَتَّى إِذَا كَانُوا مِنَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْرَ أَرْبَعِينَ ذِرَاعًا تَعَجَّلَ بَعْضُهُمْ يَنْظُرُ فِي الْغَارِ فَرَأَى حَمَامَتَيْنِ بِفَمِ الْغَارِ ، فَرَجَعَ إِلَى أَصْحَابِهِ ، فَقَالُوا لَهُ : مَا لَكَ لَمْ تَنْظُرْ فِي  الْغَارِ  ؟ فَقَالَ : رَأَيْتُ حَمَامَتَيْنِ بِفَمِ الْغَارِ ، فَعَرَفْتُ أَنْ لَيْسَ فِيهِ أَحَدٌ ، فَسَمِعَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَا قَالَ فَعَرَفَ أَنَّ اللهَ قَدْ دَرَأَ عَنْهُ بِهِمَا ، فَدَعَا لَهُنَّ وَسَمَّتَ عَلَيْهِنَّ ،  وَفَرَضَ  جَزَاءَهُنَّ وَأُقْرِرْنَ فِي الْحَرَمِ  .","","Al-Mu'jam al-Kabir 1082","","المغيرة بن شعبة عن أبو مصعب المكي عن عوين بن عمرو القيسي عن محمد بن أبي بكر المقدمي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","أبو مصعب المكي عن المغيرة"
"19263","عَمْرُو بْنُ أَوْسٍ الثَّقَفِيُّ  ، عَنِ  الْمُغِيرَةِ  1083  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَسْعُودٍ الْمَقْدِسِيُّ ،  ثَنَا  الْهَيْثَمُ بْنُ جَمِيلٍ ،         [20/444]      ثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ الطَّائِفِيُّ ،  عَنْ  عُثْمَانَ بْنِ عَبْدِ اللهِ بْنِ أَوْسٍ ،  عَنْ  عَمْرِو بْنِ أَوْسٍ الثَّقَفِيِّ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  اسْتَأْذَنْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَ  مَكَّةَ  وَالْمَدِينَةِ  ، قَالَ :  فَائْتِنِي اللَّيْلَةَ حَرَدَى  وَلَمْ أُوثِرْ عَلَيْهِ شَيْئًا حَتَّى أَصْبَحْتُ  .","","Al-Mu'jam al-Kabir 1083","","المغيرة بن شعبة عن عمرو بن أوس بن أبي أوس الثقفي عن عثمان بن عبد الله بن أوس الطائفي عن محمد بن مسلم بن سوسن الطائفي عن الهيثم بن جميل الأنطاكي عن أحمد بن مسعود المقدسي عن الطبراني","عمرو بن أوس الثقفي عن المغيرة"
"19264","هُنَيْدَةُ الطَّائِفِيُّ  ، عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  1084  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ السِّرَارُ التُّسْتَرِيُّ ، وَمُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ قَالَا ،  ثَنَا  يَحْيَى بْنُ أَبِي مُحَمَّدِ بْنِ السَّكَنِ ،  ثَنَا  بَكْرُ بْنُ بَكَّارٍ ،  ثَنَا  يُونُسُ بْنُ الْحَارِثِ الطَّائِفِيُّ ،  حَدَّثَنِي  هُنَيْدَةُ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ قَالَ عَلَيَّ مَا لَمْ أَقُلْ  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 1084","","المغيرة بن شعبة عن هنيدة عن يونس بن الحارث الطائفي عن بكر بن بكار القيسي عن يحيى بن محمد بن السكن البزاز عن محمد بن صالح النرسي عن الطبراني","هنيدة الطائفي عن المغيرة بن شعبة"
"19265","1085  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ الطَّبَرَانِيُّ ، وَوَرْدُ بْنُ أَحْمَدَ بْنِ لَبِيدٍ الْبَيْرُوتِيُّ قَالَا ،  ثَنَا  صَفْوَانُ بْنُ صَالِحٍ ، (  ح  )  وَحَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ ،  ثَنَا  أَبِي (  ح  ) ،  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  دُحَيْمٌ ، قَالَا ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  إِسْحَاقُ بْنُ سَيَّارٍ ،  ثَنَا  يُونُسُ بْنُ مَيْسَرَةَ بْنِ حَلْبَسٍ ،  أَنَّهُ سَمِعَ  أَبَا إِدْرِيسَ الْخَوْلَانِيَّ ، يَقُولُ :  سَأَلْتُ  الْمُغِيرَةَ بْنَ شُعْبَةَ عَنْ مَا حَضَرَ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِتَبُوكَ  فَقَالَ :  وَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  غَزْوَةِ تَبُوكَ  فَمَسَحَ عَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 1085","","المغيرة بن شعبة عن عائذ الله بن عبد الله الخولاني عن يونس بن ميسرة بن حلبس الجبلاني عن إسحاق بن سيار الدمشقي عن الوليد بن مسلم القرشي عن صفوان بن صالح الدمشقي عن هاشم بن مرثد الطيالسي عن الطبراني","هنيدة الطائفي عن المغيرة بن شعبة"
"19266","[20/445]      مَنِ اسْمُهُ مَعْمَرٌ  مَعْمَرُ بْنُ عَبْدِ اللهِ بْنِ نَضْلَةَ الْعَدَوِيُّ الْقُرَشِيُّ  وَهُوَ  مَعْمَرُ بْنُ عَبْدِ اللهِ بْنِ نَضْلَةَ بْنِ حَرْثَانَ بْنِ عَوْفِ بْنِ عُبَيْدِ بْنِ عُوَيْجِ بْنِ عَدِيِّ بْنِ كَعْبٍ  ، وَأُمُّهُ أَشْعَرِيَّةٌ ، وَكَانَ مِنْ  مُهَاجِرَةِ الْحَبَشَةِ  مِمَّنْ قَدِمَ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي السَّفِينَتَيْنِ  1086  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ، وَأَحْمَدُ بْنُ مُحَمَّدِ بْنِ حَمَّادِ بْنِ زُغْبَةَ قَالَا ،  ثَنَا  سَعِيدُ بْنُ عُفَيْرٍ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ،  ثَنَا  الْقَعْنَبِيُّ ، قَالَا ،  ثَنَا  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  مَعْمَرِ بْنِ عَبْدِ اللهِ بْنِ نَضْلَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنِ احْتَكَرَ فَهُوَ خَاطِئٌ  .","","Al-Mu'jam al-Kabir 1086","","معمر بن عبد الله بن نافع بن نضلة المازني عن سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن سليمان بن بلال القرشي عن عبد الله بن مسلمة القعنبي عن محمد بن علي بن زيد الصائغ عن الطبراني","معمر بن عبد الله بن نضلة العدوي القرشي"
"19267","1087  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  مَعْمَرِ بْنِ عَبْدِ اللهِ بْنِ نَضْلَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَحْتَكِرُ إِلَّا خَاطِئٌ  قَالَ  مُحَمَّدٌ  : وَكَانَ  سَعِيدٌ  يَحْتَكِرُ ، وَكَانَ  مَعْمَرٌ  يَحْتَكِرُ  .","","Al-Mu'jam al-Kabir 1087","","معمر بن عبد الله بن نافع بن نضلة المازني عن سعيد بن المسيب عن محمد بن عمرو بن عطاء العامري عن محمد بن إسحاق عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","معمر بن عبد الله بن نضلة العدوي القرشي"
"19268","1088  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ الْحَجَّاجِ بْنِ رِشْدِينِ بْنِ سَعْدٍ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ رِشْدِينِ  ،  عَنْ  يُونُسَ بْنِ يَزِيدَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ ، عَنْ  عَلْقَمَةَ ، ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  مَعْمَرِ بْنِ عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَحْتَكِرُ إِلَّا خَاطِئٌ  .  كذا في طبعة مكتبة ابن تيمية والنسخة الخطية ، والصواب : (بن) وينظر مصادر الترجمة .","","Al-Mu'jam al-Kabir 1088","","معمر بن عبد الله بن نافع بن نضلة المازني عن سعيد بن المسيب عن محمد بن عمرو بن عطاء العامري عن محمد بن إسحاق عن يونس بن يزيدالأيلي عن رشدين بن سعد المهري عن حجاج بن رشدين المصري عن محمد بن الحجاج بن رشدين المهري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","معمر بن عبد الله بن نضلة العدوي القرشي"
"19269","[20/446]      1089  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  عَمْرِو بْنِ يَحْيَى ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  مَعْمَرِ بْنِ عَبْدِ اللهِ بْنِ نَضْلَةَ بْنِ عَدِيِّ بْنِ كَعْبٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَحْتَكِرُ إِلَّا خَاطِئٌ  فَقُلْتُ  لِسَعِيدٍ  : إِنَّكَ تَحْتَكِرُ ، قَالَ : إِنَّ  مَعْمَرًا  كَانَ يَحْتَكِرُ  .","","Al-Mu'jam al-Kabir 1089","","معمر بن عبد الله بن نافع بن نضلة المازني عن سعيد بن المسيب عن محمد بن عمرو بن عطاء العامري عن عمرو بن يحيى بن عمارة المازني عن عبد العزيز بن محمد الدراوردي عن سعيد بن منصور عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","معمر بن عبد الله بن نضلة العدوي القرشي"
"19270","1090  -  حَدَّثَنَا  الْقَاسِمُ بْنُ زَكَرِيَّا الْمُطَرِّزُ ،  ثَنَا  مُحَمَّدُ بْنُ حَاتِمٍ ، وَبَزِيعُ بْنُ فَرِيدٍ ،  ثَنَا  جَعْفَرُ بْنُ عَوْنٍ ،  عَنْ  قُدَامَةَ بْنِ مُوسَى ،  عَنْ  عَمْرِو بْنِ يَحْيَى ،  عَنْ  مُحَمَّدِ بْنِ عَطَاءٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  مَعْمَرِ بْنِ عَبْدِ اللهِ الْعَدَوِيِّ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَحْتَكِرُ إِلَّا خَاطِئٌ  .","","Al-Mu'jam al-Kabir 1090","","معمر بن عبد الله بن نافع بن نضلة المازني عن سعيد بن المسيب عن محمد بن عمرو بن عطاء العامري عن عمرو بن يحيى بن عمارة المازني عن قدامة بن موسى الجمحي عن جعفر بن عون المخزومي عن بزيع بن فريد عن القاسم بن زكريا المطرز عن الطبراني","معمر بن عبد الله بن نضلة العدوي القرشي"
"19271","1091  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  مَعْمَرِ بْنِ عَبْدِ اللهِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَحْتَكِرُ إِلَّا خَاطِئٌ  .","","Al-Mu'jam al-Kabir 1091","","معمر بن عبد الله بن نافع بن نضلة المازني عن سعيد بن المسيب عن محمد بن عمرو بن عطاء العامري عن محمد بن عجلان عن يحيى بن أيوب الغافقي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","معمر بن عبد الله بن نضلة العدوي القرشي"
"19272","1092  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  رَجُلٍ ، مِنْ قُرَيْشٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَحْتَكِرُ إِلَّا خَاطِئٌ  .","","Al-Mu'jam al-Kabir 1092","","رجل من قريش عن معمر بن عبد الله بن نافع بن نضلة المازني عن سعيد بن المسيب عن محمد بن إبراهيم بن الحارث التيمي عن محمد بن إسحاق عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","معمر بن عبد الله بن نضلة العدوي القرشي"
"19273","1093  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي         [20/447]      حَبِيبٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ جُبَيْرٍ ،  عَنْ  مَعْمَرِ بْنِ عَبْدِ اللهِ الْعَدَوِيِّ ، قَالَ :  بَعَثَنِي النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُنَادِي فِي النَّاسِ  بِمِنًى  :  إِنَّ أَيَّامَ  التَّشْرِيقِ  أَيَّامُ أَكْلٍ  وَشُرْبٍ  .","","Al-Mu'jam al-Kabir 1093","","معمر بن عبد الله بن نافع بن نضلة المازني عن عبدالرحمن بن جبير الفرضي عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن محمد بن عبد الله بن أبي مريم الخزاعي عن محمد بن إسحاق عن يزيد بن هارون عن إدريس بن جعفر العطار عن الطبراني","معمر بن عبد الله بن نضلة العدوي القرشي"
"19274","1094  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي النَّضْرِ ،  عَنْ  بُسْرِ بْنِ سَعِيدٍ ،  عَنْ  مَعْمَرِ بْنِ عَبْدِ اللهِ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الطَّعَامُ بِالطَّعَامِ : مِثْلًا بِمِثْلٍ  .","","Al-Mu'jam al-Kabir 1094","","معمر بن عبد الله بن نافع بن نضلة المازني عن بسر بن سعيد المدني عن سالم بن أبي أمية التيمي عن عبد الله بن لهيعة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","معمر بن عبد الله بن نضلة العدوي القرشي"
"19275","1095  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  أَصْبَغُ بْنُ الْفَرَجِ ،  ثَنَا  ابْنُ وَهْبٍ ،  عَنْ  عَمْرِو بْنِ الْحَارِثِ ،  عَنْ  أَبِي النَّضْرِ ،  عَنْ  بُسْرِ بْنِ سَعِيدٍ ،  عَنْ  مَعْمَرِ بْنِ عَبْدِ اللهِ الْعَدَوِيِّ ،  أَنَّهُ أَرْسَلَ  غُلَامًا  لَهُ بِصَاعٍ فَقَالَ : بِعْهُ ثُمَّ اشْتَرِ بِهِ شَعِيرًا ، فَذَهَبَ الْغُلَامُ فَأَخَذَ صَاعًا وَزِيَادَةَ بَعْضِ صَاعٍ ، فَلَمَّا جَاءَ  مَعْمَرٌ  خَبَّرَهُ بِذَلِكَ ، فَقَالَ  مَعْمَرٌ  : لِمَ فَعَلْتَ ؟ انْطَلِقْ فَرُدَّهُ ، لَا تَأْخُذَنَّ إِلَّا مِثْلًا بِمِثْلٍ ، فَإِنِّي كُنْتُ أَسْمَعُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الطَّعَامُ مِثْلًا بِمِثْلٍ  وَكَانَ طَعَامُنَا يَوْمَئِذٍ الشَّعِيرَ ، فَقِيلَ : إِنَّهُ لَيْسَ مِثْلَهُ ، فَقَالَ : إِنِّي أَخَافُ أَنْ  يُضَارِعَ  الرِّبَا .","","Al-Mu'jam al-Kabir 1095","","معمر بن عبد الله بن نافع بن نضلة المازني عن بسر بن سعيد المدني عن سالم بن أبي أمية التيمي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أصبغ بن الفرج مولى عمر بن عبد العزيز عن يحيى بن عثمان بن صالح عن الطبراني","معمر بن عبد الله بن نضلة العدوي القرشي"
"19276","1096  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  أَنَا  وَهْبُ بْنُ جَرِيرٍ ، قَالَ :  سَمِعْتُ  أَبِي  قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ إِسْحَاقَ ، يَقُولُ :  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي حَبِيبٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عُقْبَةَ ، قَالَ :  سَمِعْتُ  مَعْمَرًا ، يَقُولُ :  كُنْتُ أُرَحِّلُ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         [20/448]      يَا  مَعْمَرُ  لَقَدْ وَجَدْتُ اللَّيْلَةَ فِي أَنْسَاعِي اضْطِرَابًا  فَقُلْتُ : يَا رَسُولَ اللهِ ، لَقَدْ شَدَدْتُهَا كَمَا كُنْتُ أَشُدُّهَا ، وَلَكِنْ أَرَادَ مَنْ  يَتَنَفَّسُ  عَلَيَّ ذَلِكَ أَنْ يَسْتَبْدِلَ بِي ، فَقَالَ : "" أَمَا إِنِّي غَيْرُ فَاعِلٍ ذَلِكَ "" ،  فَلَمَّا فَرَغَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ حَجَّهِ  أَمَرَنِي فَأَخَذْتُ الْمُوسَى فَصَقَلْتُهَا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يَا  مَعْمَرُ  ، أَمْكَنَكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ  شَحْمَةِ  أُذُنِهِ ، وَفِي يَدِكَ الْمُوسَى "" ، فَقُلْتُ : يَا رَسُولَ اللهِ ، إِنِّي أَرَى ذَلِكَ مَنًّا عَلَيَّ وَفَضْلًا ، قَالَ : "" أَجَلْ "" قَالَ : فَزِدْ ذَلِكَ  .","","Al-Mu'jam al-Kabir 1096","","معمر بن عبد الله بن نافع بن نضلة المازني عن عبد الرحمن بن عقبة الغفاري عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن جرير بن حازم عن وهب بن جرير بن حازم عن إسحاق ابن راهويه عن موسى بن هارون الحمال عن الطبراني","معمر بن عبد الله بن نضلة العدوي القرشي"
"19277","[21/23]      1  -  ...  فَقَالَ  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَكُلَّ بَنِيكَ نَحَلْتَهُ ؟  قَالَ : لَا ، قَالَ "" فَارْجِعْهُ  .         [21/24]","","Al-Mu'jam al-Kabir 1","","معمر بن عبد الله بن نافع بن نضلة المازني عن عبد الرحمن بن عقبة الغفاري عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن جرير بن حازم عن وهب بن جرير بن حازم عن إسحاق ابن راهويه عن موسى بن هارون الحمال عن الطبراني","معمر بن عبد الله بن نضلة العدوي القرشي"
"19278","2  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى قَالَ :  ثَنَا  مُسَدَّدٌ ، قَالَ :  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  أَبِي عِيسَى الطَّحَّانِ مُوسَى ،  عَنْ  عَوْنِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  أَبِيهِ أَوْ أَخِيهِ -  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ الَّذِينَ يَذْكُرُونَ مِنْ جَلَالِ اللهِ  ; وَتَسْبِيحِهِ وَتَكْبِيرِهِ وَتَحْمِيدِهِ تَنْعَطِفُ حَوْلَ الْعَرْشِ ، لَهُنَّ  دَوِيٌّ  كَدَوِيِّ النَّحْلِ ، يَذْكُرْنَ         [21/25]      لِصَاحِبِهِنَّ ; أَفَلَا يُحِبُّ أَحَدُكُمْ أَلَّا يَزَالَ عِنْدَ الرَّحْمَنِ يَذْكُرْنَهُ  ؟ ""  .","","Al-Mu'jam al-Kabir 2","","النعمان بن بشير الأنصاري عن عبيد الله بن عبد الله بن عتبة بن مسعود عن عون بن عبد الله بن عتبة عن موسى بن مسلم الطحان الصغير عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عبيد الله بن عبد الله بن عتبة بن مسعود عن النعمان"
"19279","3  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ، قَالَ :  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَ :         [21/26]      ،  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  مُوسَى بْنِ مُسْلِمٍ ،  عَنْ  عَوْنِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ أَوْ أَخِيهِ  -  عَنِ  النُّعْمَانِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الَّذِينَ يَذْكُرُونَ مِنْ جَلَالِ اللهِ  ; مِنْ تَسْبِيحِهِ وَتَحْمِيدِهِ وَتَكْبِيرِهِ وَتَهْلِيلِهِ يَتَعَاطَفُونَ حَوْلَ الْعَرْشِ ، لَهُنَّ  دَوِيٌّ  كَدَوِيِّ النَّحْلِ ، يَذْكُرْنَ لِصَاحِبِهِنَّ ; أَفَلَا يُحِبُّ أَحَدُكُمْ أَلَّا يَزَالَ عِنْدَ الرَّحْمَنِ يَذْكُرْنَهُ  ؟ "" .         [21/27]","","Al-Mu'jam al-Kabir 3","","النعمان بن بشير الأنصاري عن عبيد الله بن عبد الله بن عتبة بن مسعود عن عون بن عبد الله بن عتبة عن موسى بن مسلم الطحان الصغير عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبيد الله بن عبد الله بن عتبة بن مسعود عن النعمان"
"19280","4  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ ،  عَنْ  ضَمْرَةَ بْنِ سَعِيدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ;  أَنَّ  الضَّحَّاكَ بْنَ قَيْسٍ  سَأَلَ النُّعْمَانَ بْنَ بَشِيرٍ :  مَا كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ عَلَى أَثَرِ سُورَةِ الْجُمُعَةِ ؟ فَقَالَ :         {      هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ         }      .","","Al-Mu'jam al-Kabir 4","","النعمان بن بشير الأنصاري عن عبيد الله بن عبد الله بن عتبة بن مسعود عن ضمرة بن سعيد بن أبي حنة المازني عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبيد الله بن عبد الله بن عتبة عن النعمان"
"19281","5  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَ :  حَدَّثَنِي  أَبِي  ، قَالَ :  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  ضَمْرَةَ بْنِ سَعِيدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ;  أَنَّ  الضَّحَّاكَ بْنَ قَيْسٍ  كَتَبَ إِلَى  النُّعْمَانِ بْنِ بَشِيرٍ يَسْأَلُهُ :  مَا كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ فِي الْجُمُعَةِ مَعَ سُورَةِ الْجُمُعَةِ ؟ فَقَالَ :         {      هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ         }      .         [21/28]","","Al-Mu'jam al-Kabir 5","","النعمان بن بشير الأنصاري عن عبيد الله بن عبد الله بن عتبة بن مسعود عن ضمرة بن سعيد بن أبي حنة المازني عن سفيان بن عيينة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عبيد الله بن عبد الله بن عتبة عن النعمان"
"19282","6  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  زَكَرِيَّا بْنُ أَبِي زَائِدَةَ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْحَلَالُ بَيِّنٌ ، وَالْحَرَامُ بَيِّنٌ  ، وَبَيْنَهُمَا  مُتَشَابِهَاتٌ  لَا يَعْلَمُهَا كَثِيرٌ مِنَ النَّاسِ ، فَمَنِ اتَّقَى الشُّبُهَاتِ اسْتَبْرَأَ لِدِينِهِ  وَعِرْضِهِ ،  وَمَنْ وَقَعَ فِي الشُّبُهَاتِ وَقَعَ فِي الْحَرَامِ ، كَالَّذِي يَرْعَى حَوْلَ الْحِمَى  يُوشِكُ  أَنْ يُوَاقِعَهُ . أَلَا وَإِنَّ لِكُلِّ مَلِكٍ حِمًى ; وَإِنَّ حِمَى اللهِ مَحَارِمُهُ  .         [21/29]","","Al-Mu'jam al-Kabir 6","","النعمان بن بشير الأنصاري عن الشعبي عن زكريا بن أبي زائدة الوادعي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19283","7  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ، قَالَ :  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  زَكَرِيَّا ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ... فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 7","","النعمان بن بشير الأنصاري عن الشعبي عن زكريا بن أبي زائدة الوادعي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19284","8  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ         [21/30]      الْأَنْصَارِيُّ ، وَعَبْدُ الرَّحْمَنِ بْنُ حَمَّادٍ الشُّعَثِيُّ ، قَالَا :  ثَنَا  ابْنُ عَوْنٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ الْحَلَالَ بَيِّنٌ ، وَإِنَّ الْحَرَامَ بَيِّنٌ  ، وَإِنَّ بَيْنَ ذَلِكَ أُمُورٌ  مُتَشَابِهَاتٌ  ، وَرُبَّمَا قَالَ : مُشْتَبِهَةٌ  وَسَأَضْرِبُ لَكُمْ فِي ذَلِكَ مَثَلًا :         [21/31]      إِنَّ اللهَ حَمَى حِمًى ، وَإِنَّ حِمَى اللهِ مَا حَرَّمَ ، وَإِنَّهُ مَنْ يَرْعَ حَوْلَ الْحِمَى  يُوشِكْ  أَنْ يُخَالِطَهُ الرِّيبَةُ ، وَإِنَّهُ مَنْ يُخَالِطِ الرِّيبَةَ  يُوشِكْ  أَنْ يَجْسُرَ  .","","Al-Mu'jam al-Kabir 8","","النعمان بن بشير الأنصاري عن الشعبي عن عبد الله بن عون بن أرطبان عن عبد الرحمن بن حماد الشعيثي عن أبو مسلم الكجي عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19285","9  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  شَيْبَانُ         [21/32]      أَبُو مُعَاوِيَةَ ،  عَنْ  عَاصِمِ بْنِ بَهْدَلَةَ ،  عَنْ  خَيْثَمَةَ وَالشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  حَلَالٌ بَيِّنٌ ، وَحَرَامٌ بَيِّنٌ  ، وَشُبُهَاتٌ بَيْنَ ذَلِكَ ، فَمَنْ تَرَكَ الشُّبُهَاتِ فَهُوَ لِلْحَرَامِ أَتْرَكُ ، وَمَحَارِمُ اللهِ حِمًى ، فَمَنْ أَرْتَعَ حَوْلَ الْحِمَى كَانَ قَرِفًا أَنْ  يَرْتَعَ  فِيهِ  .         [21/33]","","Al-Mu'jam al-Kabir 9","","النعمان بن بشير الأنصاري عن خيثمة بن عبد الرحمن الجعفي عن عاصم بن بهدلة عن شيبان بن عبد الرحمن المؤدب عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19286","10  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، وَأَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ، قَالَ :  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  أَبِي فَرْوَةَ الْهَمْدَانِيِّ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِمِثْلِهِ .","","Al-Mu'jam al-Kabir 10","","النعمان بن بشير الأنصاري عن الشعبي عن عروة بن الحارث الهمداني عن سفيان الثوري عن محمد بن كثير العبدي عن أحمد بن داود بن موسى السدوسي عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19287","11  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  سُفْيَانُ ،  ثَنَا  أَبُو فَرْوَةَ الْهَمْدَانِيُّ ، قَالَ :  سَمِعْتُ  الشَّعْبِيَّ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ عَلَى الْمِنْبَرِ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  حَلَالٌ بَيِّنٌ ، وَحَرَامٌ بَيِّنٌ  ، وَشُبُهَاتٌ بَيْنَ ذَلِكَ ، مَنْ تَرَكَ مَا اشْتَبَهَ عَلَيْهِ مِنَ الْإِثْمِ كَانَ لِمَا اسْتَبَانَ لَهُ أَتْرَكَ ، وَمَنِ اجْتَرَأَ عَلَى مَا يَشُكُّ فِيهِ  يُوشِكُ  أَنْ يُوَاقِعَ         [21/34]      الْحَرَامَ ، وَإِنَّ لِكُلِّ مَلِكٍ حِمًى ، وَحِمَى اللهِ فِي الْأَرْضِ مَعَاصِيهِ  .","","Al-Mu'jam al-Kabir 11","","النعمان بن بشير الأنصاري عن الشعبي عن عروة بن الحارث الهمداني عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19288","12  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ ، وَأَحْمَدُ بْنُ عَبْدِ الْقَاهِرِ بْنِ الْخَيْبَرِيِّ اللَّخْمِيُّ ، الدِّمَشْقِيَّانِ ، قَالَ :  ثَنَا  مُنَبِّهُ بْنُ عُثْمَانَ ، قَالَ :  حَدَّثَنِي  ثَوْرُ بْنُ يَزِيدَ ، قَالَ :  حَدَّثَنِي  مُجَالِدُ بْنُ سَعِيدٍ ، قَالَ :  حَدَّثَنِي  عَامِرٌ الشَّعْبِيُّ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْحَلَالُ بَيِّنٌ ، وَالْحَرَامُ بَيِّنٌ  ، وَبَيْنَ الْحَلَالِ وَالْحَرَامِ أُمُورٌ مُشْتَبِهَاتٌ لَا يَدْرِي كَثِيرٌ مِنَ النَّاسِ أَمِنَ الْحَلَالِ هِيَ أَمْ مِنَ الْحَرَامِ هِيَ ، فَمَتَى يَدَعُهُنَّ الْمَرْءُ يَكُونُ أَشَدَّ اسْتِبْرَاءً         [21/35]      لِعِرْضِهِ وَدِينِهِ ، وَمَتَى يَقَعْ فِيهِنَّ  يُوشِكْ  أَنْ يَقَعَ فِي الْحَرَامِ ، كَمَنْ  يَرْتَعُ  إِلَى جَانِبِ الْحِمَى  يُوشِكُ  أَنْ  يَرْتَعَ  فِي الْحِمَى ، أَلَا وَإِنَّ لِكُلِّ مَلِكٍ حِمًى ، وَإِنَّ حِمَى اللهِ مَحَارِمُهُ  .","","Al-Mu'jam al-Kabir 12","","النعمان بن بشير الأنصاري عن الشعبي عن مجالد بن سعيد عن ثور بن يزيد الكلاعي عن منبه بن عثمان الشامي عن أحمد بن عبد القاهر الخيبري عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19289","13  -  حَدَّثَنَا  أَبُو زُرْعَةَ الدِّمَشْقِيُّ ، وَعَبْدُ اللهِ بْنُ الْحُسَيْنِ الْمِصِّيصِيُّ ، قَالَا :  ثَنَا  آدَمُ بْنُ أَبِي إِيَاسٍ ،  ثَنَا  وَرْقَاءُ بْنُ عُمَرَ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 13","","النعمان بن بشير الأنصاري عن الشعبي عن مجالد بن سعيد عن ورقاء بن عمر عن آدم بن أبي إياس عن أبو زرعة الدمشقي عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19290","14  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  ثَنَا  مُجَالِدُ بْنُ سَعِيدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْحَلَالُ بَيِّنٌ ، وَالْحَرَامُ بَيِّنٌ  ، وَبَيْنَ ذَلِكَ مُشْتَبِهَاتٌ لَا يَدْرِي كَثِيرٌ مِنَ النَّاسِ مِنَ الْحَلَالِ هِيَ أَمْ         [21/36]      مِنَ الْحَرَامِ . مَنْ تَرَكَهُ كَانَ اسْتِبْرَاءً لِعِرْضِهِ ، وَمَنْ وَاقَعَ شَيْئًا مِنْهَا  يُوشِكُ  أَنْ يُوَاقِعَ الْحَرَامَ ، كَمَا أَنَّهُ مَنْ يَرْعَ حَوْلَ الْحِمَى  يُوشِكُ  أَنْ         [21/37]      يُوَاقِعَهُ ، أَلَا وَإِنَّ لِكُلِّ مَلِكٍ حِمًى ، وَإِنَّ حِمَى اللهِ مَحَارِمُهُ  .","","Al-Mu'jam al-Kabir 14","","النعمان بن بشير الأنصاري عن الشعبي عن مجالد بن سعيد عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19291","15  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  سُفْيَانُ ،  ثَنَا  مُجَالِدٌ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  حَلَالٌ بَيِّنٌ ، وَحَرَامٌ بَيِّنٌ  ، وَمُشْتَبِهَاتٌ بَيْنَ ذَلِكَ ، فَمَنْ تَرَكَ مَا اشْتَبَهَ عَلَيْهِ مِنَ الْإِثْمِ كَانَ لِمَا اسْتَبَانَ لَهُ أَتْرَكَ ، وَمَنِ اجْتَرَأَ عَلَى مَا شَكَّ فِيهِ  يُوشِكُ  أَنْ يُوَاقِعَ الْحِمَى ، كَمُرْتِعٍ إِلَى جَانِبِ الْحِمَى  يُوشِكُ  أَنْ يَقَعَ فِيهِ ، وَإِنَّ لِكُلِّ مَلِكٍ حِمًى ، وَحِمَى اللهِ فِي الْأَرْضِ مَعَاصِيهِ  .","","Al-Mu'jam al-Kabir 15","","النعمان بن بشير الأنصاري عن الشعبي عن مجالد بن سعيد عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19292","16  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  عَاصِمُ بْنُ النَّضْرِ الْأَحْوَلُ ،  ثَنَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ (  ح  ) .  وَحَدَّثَنَا  الْقَاسِمُ بْنُ زَكَرِيَّا الْمُطَرِّزُ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ الْمُحَارِبِيُّ ،  ثَنَا  أَبُو مَالِكٍ الْجَنْبِيُّ ; كِلَيْهِمَا ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ         [21/38]      مُجَالِدٍ ،  عَنْ  عَامِرٍ ;  أَنَّهُ سَمِعَ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الْحَلَالَ بَيِّنٌ ، وَإِنَّ الْحَرَامَ بَيِّنٌ  ، وَإِنَّ بَيْنَ الْحَلَالِ وَالْحَرَامِ مُشْتَبِهَاتٌ ، فَمَنْ تَرَكَهَا أَحْرَزَ دِينَهُ  وَعِرْضَهُ  ، وَمَنْ وَقَعَ فِيهِ  يُوشِكُ  أَنْ يُوَاقِعَ الْحَرَامَ ، كَمَنْ رَعَى قَرِيبًا مِنَ الْحِمَى  يُوشِكُ  أَنْ  يَرْتَعَ  فِيهِ ، وَلِكُلِّ مَلِكٍ حِمًى فِي الْأَرْضِ ، وَإِنَّ حِمَى اللهِ فِي الْأَرْضِ مَحَارِمُهُ  وَاللَّفْظُ لِحَدِيثِ  أَبِي مَالِكٍ الْجَنْبِيِّ  .","","Al-Mu'jam al-Kabir 16","","النعمان بن بشير الأنصاري عن الشعبي عن مجالد بن سعيد عن إسماعيل بن أبي خالد عن عمرو بن هاشم الجنبي عن محمد بن عبيد بن محمد بن واقد النحاس عن القاسم بن زكريا المطرز عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19293","17  -  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عَقِيلٍ ،  ثَنَا  جَدِّي  ،  ثَنَا  شُعْبَةُ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْحَلَالُ بَيِّنٌ ، وَالْحَرَامُ بَيِّنٌ ، وَبَيْنَ ذَلِكَ أُمُورٌ مُشْتَبِهَاتٌ  ... "" وَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 17","","النعمان بن بشير الأنصاري عن الشعبي عن مجالد بن سعيد عن شعبة بن الحجاج عن عبيد بن عقيل الهلالي عن محمد بن عبد الله بن عبيد بن عقيل الهلالي عن سعيد بن عبد الرحمن التستري عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19294","18  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي         [21/39]      شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْحَلَالُ بَيِّنٌ ، وَالْحَرَامُ بَيِّنٌ  ، وَإِنَّ بَيْنَ الْحَلَالِ وَالْحَرَامِ شُبُهَاتٍ ، فَمَنْ تَرَكَهَا اسْتَبْرَأَ لِدِينِهِ  وَعِرْضِهِ  ، وَمَنْ وَقَعَ فِيهَا  يُوشِكُ  أَنْ يُوَاقِعَ الْحَرَامَ ، كَمُرْتِعٍ إِلَى جَانِبِ الْحِمَى ،  يُوشِكُ  أَنْ  يَرْتَعَ  فِيهِ ، وَإِنَّ لِكُلِّ مَلِكٍ حِمًى ، وَإِنَّ حِمَى اللهِ : الَّذِي حَمَاهُ عَلَى عِبَادِهِ  .","","Al-Mu'jam al-Kabir 18","","النعمان بن بشير الأنصاري عن الشعبي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19295","19  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  أَنَا  جَرِيرٌ (  ح  ) .         [21/40]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَا :  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  مُطَرِّفٍ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ لِكُلِّ مَلِكٍ حِمًى  ، وَإِنَّ حِمَى اللهِ حَلَالُهُ وَحَرَامُهُ ، وَالشُّبُهَاتُ بَيْنَ ذَلِكَ ، كَمَا لَوْ أَنَّ رَاعِيً بِجَانِبِ الْحِمَى ، لَمْ تَلْبَثْ غَنَمُهُ أَنْ تَرْتَعَ فِيهِ ; فَاجْتَنِبُوا الشُّبُهَاتِ  .","","Al-Mu'jam al-Kabir 19","","النعمان بن بشير الأنصاري عن الشعبي عن مطرف بن طريف عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19296","20  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ بْنِ عِيسَى الْمِصْرِيُّ ، قَالَ :  ثَنَا  عَمِّي سَعِيدُ بْنُ عِيسَى بْنِ تَلِيدٍ الرُّعَيْنِيُّ ، قَالَ :  ثَنَا  مُفَضَّلُ بْنُ فَضَالَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنِ  الْحَارِثِ بْنِ يَزِيدَ الْعُكْلِيِّ ، وَسَعِيدِ بْنِ عَبْدِ الرَّحْمَنِ الْهَمْدَانِيِّ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ;  أَنَّهُ سَمِعَ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ :         [21/41]      سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  اجْعَلُوا بَيْنَكُمْ وَبَيْنَ الْحَرَامِ سُتْرَةً مِنَ الْحَلَالِ  ; مَنْ فَعَلَ ذَلِكَ كَانَ أَشَدَّ اسْتِبْرَاءً لِعِرْضِهِ وَدِينِهِ ، وَمَنْ أَرْتَعَ فِيهِ كَانَ كَالْمُرْتِعِ إِلَى جَنْبِ الْحِمَى ،  يُوشِكُ  أَنْ يَقَعَ فِيهِ ، إِنَّ لِكُلِّ مَلِكٍ حِمًى ، وَإِنَّ حِمَى اللهِ فِي الْأَرْضِ مَحَارِمُهُ  .","","Al-Mu'jam al-Kabir 20","","النعمان بن بشير الأنصاري عن الشعبي عن عبد الرحمن بن سعيد الخيواني عن محمد بن عجلان عن المفضل بن فضالة عن سعيد بن عيسى الرعيني عن المقدام بن داود الرعيني عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19297","21  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  حُسَيْنُ بْنُ الْحَسَنِ الْأَشْقَرُ ،  ثَنَا  يَعْقُوبُ الْقُمِّيُّ ،  عَنْ  هَارُونَ بْنِ عَنْتَرَةَ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ، قَالَ :  خَطَبَنَا  النُّعْمَانُ بْنُ بَشِيرٍ ، فَقَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  حَلَالٌ بَيِّنٌ ، وَحَرَامٌ بَيِّنٌ  ، فَمَنْ تَرَكَ الشُّبُهَاتِ فَهُوَ لِلْمَحَارِمِ أَتْرَكُ ، وَمَنِ اجْتَرَأَ عَلَى دُخُولِ الْحِمَى وَاقَعَ الْحِمَى  .","","Al-Mu'jam al-Kabir 21","","النعمان بن بشير الأنصاري عن الشعبي عن هارون بن عنترة الشيباني عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن الحسين بن الحسن الأشقر عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19298","22  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ عَامِرِ بْنِ إِبْرَاهِيمَ الْأَصْبَهَانِيُّ ، قَالَ :  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ  ،  عَنْ  يَعْقُوبَ الْقُمِّيِّ ،  عَنْ  هَارُونَ بْنِ عَنْتَرَةَ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .         [21/42]","","Al-Mu'jam al-Kabir 22","","النعمان بن بشير الأنصاري عن الشعبي عن هارون بن عنترة الشيباني عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19299","23  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ ،  ثَنَا  إِبْرَاهِيمُ بْنُ حَمْزَةَ الزُّبَيْرِيُّ ، وَأَبُو ثَابِتٍ مُحَمَّدُ بْنُ عُبَيْدِ اللهِ الْمَدِينِيُّ .  وَحَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ، قَالَ :  حَدَّثَنِي  أَبِي  ; قَالَا :  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي حَازِمٍ ،  عَنْ  يَزِيدَ بْنِ الْهَادِ ،  عَنْ  عِيسَى بْنِ أَبِي عِيسَى الْحَنَّاطِ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ أَنَّهُ سَمِعَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْحَلَالُ بَيِّنٌ ، وَالْحَرَامُ بَيِّنٌ ، وَبَيْنَ ذَلِكَ أُمُورٌ مُشْتَبِهَاتٌ  ... "" الْحَدِيثَ .","","Al-Mu'jam al-Kabir 23","","النعمان بن بشير الأنصاري عن الشعبي عن عيسى بن أبي عيسى الحناط عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن عبد العزيز بن أبي حازم المخزومي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19300","24  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عَلِيُّ بْنُ الْمُنْذِرِ ،  ثَنَا  مُحَمَّدُ بْنُ الْفُضَيْلِ ،  عَنِ  السَّرِيِّ بْنِ إِسْمَاعِيلَ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَا أَيُّهَا النَّاسُ ! إِنَّ لِكُلِّ مَلِكٍ حِمًى  ، وَإِنَّ حِمَى اللهِ فِي الْأَرْضِ حَلَالُهُ وَحَرَامُهُ ، وَالْمُشْتَبِهَاتُ بَيْنَ ذَلِكَ ، وَلَوْ أَنَّ رَاعِيًا رَعَى بِجَنَبَاتِ حِمًى لَمْ تَلْبَثْ غَنَمُهُ أَنْ تَرْعَى فِي وَسَطِهِ ; فَدَعُوا الشُّبُهَاتِ  .","","Al-Mu'jam al-Kabir 24","","النعمان بن بشير الأنصاري عن الشعبي عن السري بن إسماعيل الهمداني عن محمد بن فضيل بن غزوان عن علي بن المنذر العلاف عن الحسين بن إسحاق التستري عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19301","25  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ ،  ثَنَا  أَبُو الشَّعْثَاءِ عَلِيُّ بْنُ         [21/43]      الْحَسَنِ ،  ثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  عَنْ  أَفْلَحَ بْنِ سَعِيدٍ ،  عَنْ  عِمْرَانَ بْنِ دِينَارٍ ،  عَنْ  مَلِيحِ بْنِ عَبْدِ اللهِ الْخَطْمِيِّ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَلَا إِنَّ الْحَلَالَ بَيِّنٌ ، أَلَا وَإِنَّ الْحَرَامَ بَيِّنٌ  ، أَلَا وَإِنَّ بَيْنَهُمَا أُمُورًا مُشْتَبِهَاتٍ لَا يَعْلَمُهَا كَثِيرٌ مِنَ النَّاسِ ، فَمَنِ اتَّقَى الشُّبُهَاتِ كَانَ اسْتِبْرَاءً لِدِينِهِ  وَعِرْضِهِ ،  وَمَنْ وَقَعَ فِي الشُّبُهَاتِ وَقَعَ فِي الْحَرَامِ ، كَالرَّاعِي حَوْلَ الْحِمَى  يُوشِكُ  أَنْ  يَرْتَعَ  فِيهِ ، أَلَا وَإِنَّ لِكُلِّ مَلِكٍ حِمًى ، وَإِنَّ حِمَى اللهِ مَحَارِمُهُ  .","","Al-Mu'jam al-Kabir 25","","النعمان بن بشير الأنصاري عن الشعبي عن مليح بن عبد الله الخطمي عن عمران بن دينار عن أفلح بن سعيد الأنصاري عن زيد بن الحباب العكلي عن علي بن الحسن بن سليمان الحضرمي عن بحشل عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19302","26  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ بْنِ أَسَدٍ الْأَصْبَهَانِيُّ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ الْحُسَيْنِ بْنِ حَفْصٍ ،  ثَنَا  خَلَّادُ بْنُ يَحْيَى ،  ثَنَا  يُوسُفُ بْنُ مَيْمُونٍ ، قَالَ :  سَمِعْتُ  عَامِرًا الشَّعْبِيَّ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  حَلَالٌ بَيِّنٌ ، وَحَرَامٌ بَيِّنٌ  ، وَشُبْهَةٌ فِيمَا بَيْنَ ذَلِكَ ، فَمَنْ تَرَكَ مَا يَرِيبُهُ إِلَى مَا لَا يَرِيبُهُ ، فَهُوَ لِمَا اسْتَبَانَ لَهُ أَتْرَكُ ، وَمَنْ تَرَكَ مَا لَا يَرِيبُهُ أَوْشَكَ أَنْ يَرْكَبَ         [21/44]      مَا يَرِيبُهُ ، أَلَا إِنَّ لِكُلِّ مَلِكٍ حِمًى ، وَإِنَّ حِمَى اللهِ مَعَاصِيهِ ، وَمَنْ  يَرْتَعُ  حَوْلَ الْحِمَى أَوْشَكَ أَنْ  يَرْتَعَ  فِي الْحِمَى  .","","Al-Mu'jam al-Kabir 26","","النعمان بن بشير الأنصاري عن الشعبي عن يوسف بن ميمون الصباغ عن خلاد بن يحيى الأرحبي عن أحمد بن محمد بن الحسين الأصبهاني عن عبد الله بن محمد بن الحسن الأصبهاني عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19303","27  -  حَدَّثَنَا  أَحْمَدُ بْنُ أَبِي يَحْيَى الْحَضْرَمِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ شُعَيْبٍ الْكَيْسَانِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ الرَّصَاصِيُّ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ،  قَالَ عَبْدُ الْمَلِكِ : وَقَدْ  سَمِعْتُهُ  مِنَ النُّعْمَانِ بْنِ بَشِيرٍ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْحَلَالُ بَيِّنٌ ، وَالْحَرَامُ بَيِّنٌ  ، وَبَيْنَ ذَلِكَ أُمُورٌ مُشْتَبِهَاتٌ ، فَمَنْ تَرَكَهُنَّ كَانَ ذَلِكَ اسْتِبْرَاءً لِدِينِهِ  وَعِرْضِهِ  ، وَمَنْ وَاقَعَهُنَّ أَوْشَكَ أَنْ يَقَعَ فِي الْحَرَامِ  .         [21/45]","","Al-Mu'jam al-Kabir 27","","النعمان بن بشير الأنصاري عن الشعبي عن عبد الملك بن عمير القبطي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن عبد الرحمن بن زياد العراقي عن سليمان بن شعيب الكيساني عن أحمد بن أبي يحيى المصري عن الطبراني","عامر الشعبي عن النعمان بن بشير"
"19304","28  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  حَدَّثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  زَكَرِيَّا بْنُ أَبِي زَائِدَةَ ، قَالَ :  سَمِعْتُ  عَامِرًا يَقُولُ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ ، يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَثَلُ الْقَائِمِ عَلَى حُدُودِ اللهِ وَالْوَاقِعِ فِيهَا كَمَثَلِ قَوْمٍ اسْتَهَمُوا سَفِينَةً  ، فَأَصَابَ بَعْضُهُمْ أَعْلَاهَا ، وَأَصَابَ بَعْضُهُمْ أَسْفَلَهَا ، فَقَالُوا : لَوْ أَنَّا خَرَقْنَا فِي نَصِيبِنَا خَرْقًا فَاسْتَقَيْنَا مِنْهُ ،         [21/46]      وَلَمْ نُؤْذِ مَنْ فَوْقَنَا ! فَإِنْ تَرَكُوهُمْ وَمَا أَرَادُوا هَلَكُوا جَمِيعًا ، وَإِنْ  أَخَذُوا  عَلَى أَيْدِيهِمْ نَجَوْا جَمِيعًا  .","","Al-Mu'jam al-Kabir 28","","النعمان بن بشير الأنصاري عن الشعبي عن زكريا بن أبي زائدة الوادعي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"19305","29  -  حَدَّثَنَا  الْعَبَّاسُ الْأَسْفَاطِيُّ ،  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  جَابِرُ بْنُ يَزِيدَ بْنِ رِفَاعَةَ ،  ثَنَا  الشَّعْبِيُّ ، قَالَ :  سَمِعْتُ  عَلَى هَذَا الْمِنْبَرِ يَعْنِي مِنْبَرَ  الْكُوفَةِ  رَجُلًا وَهُوَ يَقُولُ مِنْ فِي رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَا سَمِعْتُ رَجُلًا قَالَهُ قَبْلَهُ . فَقَالَ لَهُ  نُعَيْمُ بْنُ أَبِي هِنْدٍ  : مَنْ هُوَ يَا  عَامِرُ  ؟ ، قَالَ : هُوَ النُّعْمَانُ بْنُ بَشِيرٍ الْأَنْصَارِيُّ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَثَلُ الْمُدَاهِنِ فِي أَمْرِ اللهِ كَمَثَلِ رَهْطٍ رَكِبُوا سَفِينَةً  ، فَاقْتَرَعُوا عَلَى الْمَنَازِلِ فِيهَا ، فَأَصَابَ بَعْضُهُمْ أَعْلَى السَّفِينَةِ وَبَعْضُهُمْ أَسْفَلَهَا ، فَاطَّلَعَ مُطَّلِعٌ مِنَ الَّذِي         [21/47]      أَعْلَى السَّفِينَةِ ; فَإِذَا بَعْضُ مَنْ أَسْفَلَهَا يَخْرِقُهَا ، فَقَالَ لَهُ : مَا تَصْنَعُ يَا فُلَانُ ؟ قَالَ : أَخْرِقُ مَكَانًا أَسْتَقِي مِنْهُ وَأَتَوَضَّأُ وَأَشْرَبُ ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : فَإِنْ غَيَّرُوا عَلَيْهِ نَجَا وَنَجَوْا بِإِذْنِ اللهِ ، وَإِنْ تَرَكُوهُ يَخْرِقُهَا غَرِقَ وَغَرِقُوا  .","","Al-Mu'jam al-Kabir 29","","النعمان بن بشير الأنصاري عن الشعبي عن جابر بن يزيد العجلي عن أحمد بن عبد الله اليربوعي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","باب"
"19306","30  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ،  ثَنَا  عَمْرُو بْنُ أَبِي عَاصِمٍ ،  ثَنَا  أَبِي  ،  عَنْ  جَابِرِ بْنِ يَزِيدَ بْنِ رِفَاعَةَ ،  عَنْ  نُعَيْمِ بْنِ أَبِي هِنْدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 30","","النعمان بن بشير الأنصاري عن الشعبي عن نعيم بن أبي هند الأشجعي عن جابر بن يزيد العجلي عن أبو عاصم النبيل عن عمرو بن الضحاك بن مخلد عن الحسن بن علي بن شبيب المعمري عن الطبراني","باب"
"19307","31  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ (  ح  ) .         [21/48]      وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَثَلُ الْقَائِمِ عَلَى حُدُودِ اللهِ وَالْمُدَاهِنِ فِيهَا كَمَثَلِ قَوْمٍ اسْتَهَمُوا عَلَى سَفِينَةٍ فِي الْبَحْرِ  ، فَأَصَابَ بَعْضُهُمْ أَعْلَاهَا وَبَعْضُهُمْ أَسْفَلَهَا ، فَكَانَ الَّذِي فِي أَسْفَلِهَا يَخْرُجُونَ وَيَسْتَقُونَ الْمَاءَ ، وَيَصُبُّونَ عَلَى الَّذِي فِي أَعْلَاهَا ; فَيُؤْذُونَهُمْ ; فَمَنَعُوهُمْ ; فَقَالُوا : لَا نَدَعُكُمْ تَمُرُّونَ عَلَيْنَا فَتُؤْذُونَنَا . فَقَالَ الَّذِينَ فِي         [21/49]      أَسْفَلِهَا : أَمَّا إِذْ مَنَعْتُمُونَا فَنَنْقُبُ السَّفِينَةَ وَنَسْتَقِي ، فَإِنْ  أَخَذُوا  عَلَى أَيْدِيهِمْ فَمَنَعُوهُمْ نَجَوْا جَمِيعًا ، وَإِنْ تَرَكُوهُمْ هَلَكُوا جَمِيعًا  .","","Al-Mu'jam al-Kabir 31","","النعمان بن بشير الأنصاري عن الشعبي عن الأعمش عن أبو معاوية الضرير عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","باب"
"19308","32  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَثَلُ الْقَائِمِ عَلَى حُدُودِ اللهِ مَثَلُ قَوْمٍ رَكِبُوا سَفِينَةً  ، وَاقْتَرَعُوا مَنَازِلَهَا ، فَكَانَ مَكَانُ النَّتْنِ وَمُهَرَاقُ الْمَاءِ وَمُخْتَلَفُ  الْقَوْمِ  لِأَحَدِهِمْ ، فَضَجِرَ ، فَأَخَذَ الْقَدُومَ فَنَقَرَ         [21/50]      فِي السَّفِينَةِ ، فَقَالَ أَحَدُهُمْ لِلْآخَرِ : أَتُرِيدُ أَنْ تُغْرِقَنَا وَتُغْرِقَ سَفِينَتَهُمْ ؟ قَالَ الْآخَرُ : دَعُوهُ ; فَإِنَّمَا يَخْرِقُ مَكَانَهُ  !! "" .","","Al-Mu'jam al-Kabir 32","","النعمان بن بشير الأنصاري عن الشعبي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","باب"
"19309","33  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  يَعْلَى بْنُ عُبَيْدٍ ،  ثَنَا  الْأَعْمَشُ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 33","","النعمان بن بشير الأنصاري عن الشعبي عن الأعمش عن يعلى بن عبيد الطنافسي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","باب"
"19310","34  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ (  ح  ) .  ،  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ ، قَالَا :  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  مُطَرِّفٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مُدْهِنٌ         [21/51]      فِي حُدُودِ اللهِ ، وَالرَّاكِبُ حُدُودَ اللهِ ، وَالْآمِرُ بِهَا وَالنَّاهِي عَنْهَا ; كَمَثَلِ قَوْمٍ اسْتَهَمُوا عَلَى سَفِينَةٍ  مِنْ سُفُنِ الْبَحْرِ ، فَأَصَابَ بَعْضُهُمْ مُؤَخَّرَ السَّفِينَةِ وَأَبْعَدَهَا مِنَ الْمِرْفَقِ ، وَكَانُوا سُفَهَاءَ ، فَكَانُوا إِذَا أَتَوْا عَلَى رِحَالِ  الْقَوْمِ  آذَوْهُمْ ، فَقَالُوا : نَحْنُ أَقْرَبُ أَهْلِ السَّفِينَةِ مِنَ الْمِرْفَقِ وَأَبْعَدُهَا مِنَ السَّمَاءِ ، فَبَيْنَنَا وَبَيْنَ الْمِرْفَقِ أَنْ نَخْرِقَ السَّفِينَةَ ، ثُمَّ نَسُدَّهُ إِذَا اسْتَغْنَيْنَا عَنْهُ . فَقَالَ  ضُرَبَاؤُهُ  مِنَ السُّفَهَاءِ : فَافْعَلْ ، فَأَهْوَى إِلَى فَأْسٍ فَضَرَبَ بِهَا عُرْضَ السَّفِينَةِ ، فَأَشْرَفَ عَلَيْهِ رَجُلٌ وَنَشَدَهُ ، قَالَ : مَا تَصْنَعُ ؟ قَالَ : نَحْنُ أَقْرَبُكُمْ مِنَ الْمِرْفَقِ وَأَبْعَدُكُمْ مِنْهُ ; أَخْرِقُ دَفَّ هَذِهِ السَّفِينَةِ ، فَإِذَا         [21/52]      اسْتَغْنَيْنَا عَنْهُ سَدَدْنَاهُ ، قَالَ : لَا تَفْعَلْ ; فَإِنَّكَ إِذَنْ تَهْلِكُ وَنَهْلِكُ  .","","Al-Mu'jam al-Kabir 34","","النعمان بن بشير الأنصاري عن الشعبي عن مطرف بن طريف عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","باب"
"19311","35  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ حُمَيْدٍ الرَّازِيُّ ،  ثَنَا  الْحَكَمُ بْنُ بَشِيرِ بْنِ سُلَيْمَانَ ،  عَنْ  عَمْرِو بْنِ قَيْسٍ الْمُلَائِيِّ ،  عَنْ  مُجَالِدِ بْنِ سَعِيدٍ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَثَلُ الْقَائِمِ عَلَى حُدُودِ اللهِ وَالْوَاقِعِ فِيهَا وَالْمُدْهِنِ فِيهَا ، مَثَلُ نَفَرٍ اسْتَهَمُوا فِي سَفِينَةٍ  ، فَأَصَابَ بَعْضُهُمْ أَعْلَاهَا ، وَأَصَابَ بَعْضُهُمْ أَسْفَلَهَا ، وَأَصَابَ بَعْضُهُمْ وَسَطَهَا ; فَكَانَ إِذَا أَرَادَ أَنْ يَسْتَقِيَ مِنَ الْمَاءِ مَرَّ عَلَى الَّذِينَ مِنْ فَوْقِهِ فَتَأَذَّوْا بِهِ . فَلَمَّا رَأَوْا ذَلِكَ ، أَخَذَ الْفَأْسَ قَالَ : أَنْقُبُ هَاهُنَا فَأَسْتَقِي مِنْ قَرِيبٍ . قَالَ الَّذِينَ فَوْقَهُ : لَا تَصْنَعْ ، تُرِيدُ أَنْ تُهْلِكَنَا ؟ ! فَقَالَ الْآخَرُ : وَيْحَهُ ! فَإِنَّمَا يَصْنَعُ فِي نَصِيبِهِ ، فَإِنْ  أَخَذُوا  عَلَى يَدَيْهِ نَجَوْا وَنَجَا ، وَإِنْ لَمْ يَفْعَلُوا هَلَكَ وَهَلَكُوا  .","","Al-Mu'jam al-Kabir 35","","النعمان بن بشير الأنصاري عن الشعبي عن مجالد بن سعيد عن عمرو بن قيس الملائي عن الحكم بن  أبى إسماعيل النهدي عن محمد بن حميد الرازي عن الحسين بن إسحاق التستري عن الطبراني","باب"
"19312","36  -  حَدَّثَنَا  مُحَمَّدُ بْنُ هِشَامٍ الْمُسْتَمْلِيُّ ،  ثَنَا  عَلِيُّ ابْنُ الْمَدِينِيِّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ; أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَثَلُ الْمُدَاهِنِ فِي الْحُدُودِ وَالْوَاقِعِ فِيهَا وَالْقَائِمِ عَلَيْهَا ، كَمَثَلِ ثَلَاثَةِ نَفَرٍ رَكِبُوا فِي سَفِينَةٍ  فَاسْتَهَمُوا مَنَازِلَهُمْ ، فَوَقَعَ         [21/53]      لِأَحَدِهِمْ أَسْفَلَهَا وَأَوْعَرَهَا وَأَخْبَثَهَا ، وَكَانَ لِلْآخَرِ أَوْسَطُهَا ، وَكَانَ لِلْآخَرِ أَعْلَاهَا ; فَكَانَ مُخْتَلَفُهُ وَمُهَرَاقُ مَائِهِ عَلَيْهِمْ ، فَلَمْ يَنْذَرُوا بِهِ حَتَّى إِذَا هُوَ يُرِيدُ أَنْ يَخْرِقَ فِيهَا خَرْقًا ; يَقُولُ : أَقْرَبُ مِنَ الْمَاءِ ; فَلَا يَكُونُ مَجَازِي عَلَيْكُمْ . فَقَالَ بَعْضُهُمْ : دَعُوهُ  أَبْعَدَهُ  اللهُ ! إِنَّمَا يَخْرِقُ فِي نَصِيبِهِ . وَقَالَ الْآخَرُ : لَا تَدَعُوهُ ; إِنَّمَا يُهْلِكُنَا . فَإِنْ  أَخَذُوا  عَلَى يَدَيْهِ سَلِمُوا ، وَإِنْ تَرَكُوهُ هَلَكُوا  .","","Al-Mu'jam al-Kabir 36","","النعمان بن بشير الأنصاري عن الشعبي عن مجالد بن سعيد عن سفيان بن عيينة عن علي ابن المديني عن ابن أبى الدميك محمد بن هشام بن علي عن الطبراني","باب"
"19313","37  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدٌ ،  عَنِ  الْأَجْلَحِ ،  عَنْ  عَامِرٍ ، أَنَّهُ  سَمِعَ  النُّعْمَانَ بْنَ بَشِيرٍ عَلَى الْمِنْبَرِ  بِالْكُوفَةِ  يَقُولُ : يَا أَيُّهَا النَّاسُ ، خُذُوا عَلَى أَيْدِي سُفَهَائِكُمْ ; فَإِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  إِنَّ قَوْمًا رَكِبُوا سَفِينَةً فِي الْبَحْرِ ، فَاقْتَرَعُوا ، فَأَخَذَ كُلُّ رَجُلٍ نَصِيبَهُ  ، فَأَخَذَ رَجُلٌ مِنْهُمْ فَأْسًا ، فَجَعَلَ يَنْقُرُ نَصِيبَهُ ، فَقَالُوا : مَا تَصْنَعُ ؟ إِنْ فَعَلْتَ غَرِقْنَا وَغَرِقْتَ ، فَإِنْ هُمْ لَمْ يَأْخُذُوا عَلَى يَدَيْهِ غَرِقُوا وَغَرِقَ ، وَإِنْ هُمْ  أَخَذُوا  عَلَى يَدَيْهِ نَجَا وَنَجَوْا  .         [21/54]","","Al-Mu'jam al-Kabir 37","","النعمان بن بشير الأنصاري عن الشعبي عن أجلح بن عبد الله الكندي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","باب"
"19314","38  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ،  ثَنَا  الْأَزْرَقُ بْنُ عَلِيٍّ ،  ثَنَا  حَسَّانُ بْنُ إِبْرَاهِيمَ ،  عَنْ  مُحَمَّدِ بْنِ سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ;  أَنَّهُ سَمِعَ  النُّعْمَانَ بْنَ بَشِيرٍ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَثَلُ الْفَاسِقِ فِي  الْقَوْمِ  كَمَثَلِ قَوْمٍ رَكِبُوا سَفِينَةً فِي الْبَحْرِ فَاقْتَسَمُوهَا  ، فَصَارَ لِكُلِّ وَاحِدٍ مِنْهُمْ مَكَانٌ ، فَعَمَدَ رَجُلٌ إِلَى مَكَانِهِ فَخَرَقَهُ ، فَقَالُوا لَهُ : مَا تُرِيدُ ؟ ! أَنْ تُهْلِكَنَا ؟ ! قَالَ : وَفِيمَ أَنْتُمْ مِنْ مَكَانِي ؟ ! فَإِنْ تَرَكُوا غَرِقُوا وَغَرِقَ مَعَهُمْ ، وَإِنْ  أَخَذُوا  عَلَى يَدَيْهِ نَجَوْا وَنَجَا ; فَذَلِكَ مَثَلُ الْفَاسِقِ  .         [21/55]","","Al-Mu'jam al-Kabir 38","","النعمان بن بشير الأنصاري عن الشعبي عن سلمة بن كهيل الحضرمي عن محمد بن سلمة بن كهيل الكوفي عن حسان بن إبراهيم الكرماني عن الأزرق بن علي بن مسلم الحنفي عن إبراهيم بن هاشم البغوي عن الطبراني","باب"
"19315","39  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  زَكَرِيَّا بْنُ أَبِي زَائِدَةَ ، قَالَ :  سَمِعْتُ  عَامِرًا يَقُولُ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَثَلُ الْمُؤْمِنِينَ فِي تَرَاحُمِهِمْ وَتَوَادِّهِمْ وَتَعَطُّفِهِمْ  ،         [21/56]      كَمَثَلِ الْجَسَدِ ; إِنِ اشْتَكَى عُضْوٌ مِنْهُ  تَدَاعَى  لَهُ سَائِرُ الْجَسَدِ بِالْحُمَّى وَالسَّهَرِ  .","","Al-Mu'jam al-Kabir 39","","النعمان بن بشير الأنصاري عن الشعبي عن زكريا بن أبي زائدة الوادعي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"19316","40  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَثَلُ الْمُؤْمِنِينَ مَثَلُ تَوَادِّهِمْ         [21/57]      وَتَحَابِّهِمْ مَثَلُ الْجَسَدِ  ; إِذَا اشْتَكَى  تَدَاعَى  سَائِرُهُ بِالْحُمَّى وَالْأَوْصَابِ  .","","Al-Mu'jam al-Kabir 40","","النعمان بن بشير الأنصاري عن الشعبي عن مجالد بن سعيد عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"19317","41  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ (  ح  ) .  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  حَدَّثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  وَكِيعٌ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الْمُؤْمِنِينَ كَرَجُلٍ وَاحِدٍ  ; إِنِ اشْتَكَى رَأْسُهُ  تَدَاعَى  لَهُ سَائِرُ الْجَسَدِ بِالْحُمَّى وَالسَّهَرِ  .","","Al-Mu'jam al-Kabir 41","","النعمان بن بشير الأنصاري عن الشعبي عن الأعمش عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","باب"
"19318","42  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ (  ح  ) .  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ (  ح  ) .  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ; قَالُوا :  ثَنَا         [21/58]      أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَثَلُ الْمُؤْمِنِ كَمَثَلِ الْجَسَدِ  ; إِذَا اشْتَكَى رَأْسُهُ  تَدَاعَى  سَائِرُ جَسَدِهِ  .","","Al-Mu'jam al-Kabir 42","","النعمان بن بشير الأنصاري عن الشعبي عن الأعمش عن أبو معاوية الضرير عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","باب"
"19319","43  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  أَشْعَثَ وَالْأَعْمَشِ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَثَلُ الْمُؤْمِنِينَ فِي تَوَادِّهِمْ وَتَبَاذُلِهِمْ وَتَرَاحُمِهِمْ ، مَثَلُ الْجَسَدِ  ; إِذَا اشْتَكَى مِنْهُ شَيْءٌ  تَدَاعَى  لَهُ سَائِرُ الْجَسَدِ  .","","Al-Mu'jam al-Kabir 43","","النعمان بن بشير الأنصاري عن الشعبي عن الأعمش عن حفص بن غياث النخعي عن محمد بن عبد الله بن نمير عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"19320","44  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  حُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 44","","النعمان بن بشير الأنصاري عن الشعبي عن الأعمش عن حميد بن عبد الرحمن الرؤاسي عن محمد بن عبد الله بن نمير عن عبيد بن غنام النخعي عن الطبراني","باب"
"19321","45  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي ،  ثَنَا  مُحَاضِرُ         [21/59]      بْنُ الْمُوَرِّعِ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 45","","النعمان بن بشير الأنصاري عن الشعبي عن الأعمش عن محاضر بن المورع الهمداني عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","باب"
"19322","46  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَثَلُ الْمُؤْمِنِينَ فِي تَرَاحُمِهِمْ  وَلُطْفِ  بَعْضِهِمْ بَعْضًا ، كَجَسَدِ رَجُلٍ  ; إِذَا اشْتَكَى بَعْضُ جَسَدِهِ أَلِمَ لَهُ سَائِرُ جَسَدِهِ  .","","Al-Mu'jam al-Kabir 46","","النعمان بن بشير الأنصاري عن الشعبي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","باب"
"19323","47  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  أَنَا  جَرِيرٌ .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ         [21/60]      التُّسْتَرِيُّ ، قَالَا :  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  مُطَرِّفٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  كَانَ يَنْبَغِي لِلْمُؤْمِنِينَ أَنْ يَكُونُوا فِيمَا بَيْنَهُمْ - تَرَاحُمِهِمْ بَعْضِهِمْ عَلَى بَعْضٍ  ، وَنُصْحِ بَعْضِهِمْ بَعْضًا - كَمَثَلِ الْجَسَدِ ; إِذَا اشْتَكَى  فَتَدَاعَى  عُضْوٌ مِنْهُ  تَدَاعَى  جَسَدُهُ كُلُّهُ بِالسَّهَرِ حَتَّى يَذْهَبَ أَلَمُ ذَلِكَ الْعُضْوِ  .","","Al-Mu'jam al-Kabir 47","","النعمان بن بشير الأنصاري عن الشعبي عن مطرف بن طريف عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن موسى بن هارون الحمال عن الطبراني","باب"
"19324","48  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنِ  السَّرِيِّ بْنِ إِسْمَاعِيلَ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَنْبَغِي لِلْمُؤْمِنِينَ أَنْ يَكُونُوا فِيمَا بَيْنَهُمْ كَمَنْزِلَةِ رَجُلٍ وَاحِدٍ  ; إِذَا اشْتَكَى عُضْوًا مِنْ جَسَدِهِ  تَدَاعَى  سَائِرُ جَسَدِهِ  .         [21/61]","","Al-Mu'jam al-Kabir 48","","النعمان بن بشير الأنصاري عن الشعبي عن السري بن إسماعيل الهمداني عن محمد بن فضيل بن غزوان عن علي ابن المديني عن الحسين بن إسحاق التستري عن الطبراني","باب"
"19325","49  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدٌ ،  عَنِ  الْحَسَنِ بْنِ عُبَيْدِ اللهِ ،  عَنِ  الشَّعْبِيِّ ،  قَالَ  النُّعْمَانُ بْنُ بَشِيرٍ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّمَا مَثَلُ الْمُؤْمِنِينَ كَالْجَسَدِ  ; إِذَا اشْتَكَى شَيْئًا  تَدَاعَى  لَهُ سَائِرُ الْجَسَدِ  .","","Al-Mu'jam al-Kabir 49","","النعمان بن بشير الأنصاري عن الشعبي عن الحسن بن عبيد الله النخعي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","باب"
"19326","50  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ،  ثَنَا  مَحْمُودُ بْنُ خَالِدٍ الدِّمَشْقِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  عِيسَى بْنُ الْمُسَيِّبِ ،  عَنْ  أَبِي حَصِينٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ وَهُوَ عَلَى الْمِنْبَرِ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ الْمُؤْمِنِينَ كَمَثَلِ رَجُلٍ إِذَا وَجِعَ شَيْئًا مِنْ جَسَدِهِ  تَدَاعَى  لَهُ سَائِرُ جَسَدِهِ  .","","Al-Mu'jam al-Kabir 50","","النعمان بن بشير الأنصاري عن الشعبي عن عثمان بن عاصم بن حصين عن عيسى بن المسيب البجلي عن خالد بن يزيد الأزرق عن محمود بن خالد بن أبي خالد السلمي عن الحسن بن علي بن شبيب المعمري عن الطبراني","باب"
"19327","51  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  مَرْوَانُ         [21/62]      بْنُ مُعَاوِيَةَ (  ح  ) .  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ جَعْفَرٍ الْوَرْكَانِيُّ ،  ثَنَا  أَبُو شِهَابٍ ، كِلَيْهِمَا  عَنِ  الْحَسَنِ بْنِ عَمْرٍو الْفُقَيْمِيِّ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَيُّهَا النَّاسُ تَرَاحَمُوا  ; الْمُسْلِمُونَ كَرَجُلٍ وَاحِدٍ ; إِذَا اشْتَكَى عُضْوًا مِنْهُ  تَدَاعَى  لِذَلِكَ سَائِرُ جَسَدِهِ  .","","Al-Mu'jam al-Kabir 51","","النعمان بن بشير الأنصاري عن الشعبي عن الحسن بن عمرو الفقيمي عن عبد ربه بن نافع الحناط عن محمد بن جعفر الوركاني عن عبد الله بن أحمد بن حنبل عن الطبراني","باب"
"19328","52  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  ثَنَا  أَبُو إِسْمَاعِيلَ الْمُؤَدِّبُ ،  عَنْ  حَبِيبِ بْنِ حَسَّانَ بْنِ أَبِي الْأَشْرَسِ ،         [21/63]      ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَثَلُ الْمُؤْمِنِينَ كَمَثَلِ جَسَدٍ وَاحِدٍ  اشْتَكَى بَعْضُهُ  تَدَاعَى  كُلُّهُ بِالسَّهَرِ وَالْوَجَعِ  .         [21/64]","","Al-Mu'jam al-Kabir 52","","النعمان بن بشير الأنصاري عن الشعبي عن حبيب بن أبي الأشرس الكوفي عن إبراهيم بن سليمان أبو إسماعيل عن سريج بن يونس المروزي عن عبد الله بن أحمد بن حنبل عن الطبراني","باب"
"19329","53  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  زَكَرِيَّا بْنُ أَبِي زَائِدَةَ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  أَلَا إِنَّ فِي الْجَسَدِ  مُضْغَةً  ; إِذَا صَلَحَتْ صَلَحَ الْجَسَدُ كُلُّهُ ، وَإِذَا فَسَدَتْ فَسَدَ الْجَسَدُ كُلُّهُ ; أَلَا وَهِيَ الْقَلْبُ  .","","Al-Mu'jam al-Kabir 53","","النعمان بن بشير الأنصاري عن الشعبي عن زكريا بن أبي زائدة الوادعي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"19330","54  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  فِي ابْنِ آدَمَ  مُضْغَةٌ  ; إِذَا صَلَحَتْ صَلَحَ  ; وَإِذَا فَسَدَتْ فَسَدَ : الْقَلْبُ  .","","Al-Mu'jam al-Kabir 54","","النعمان بن بشير الأنصاري عن الشعبي عن مجالد بن سعيد عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"19331","55  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ الرَّقِّيُّ ،  ثَنَا  مُعَلَّى بْنُ أَسَدٍ الْعَمِّيُّ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  ثَنَا  مُجَالِدٌ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 55","","النعمان بن بشير الأنصاري عن الشعبي عن مجالد بن سعيد عن عبد الواحد بن زياد عن معلى بن أسد عن حفص بن عمر سنجة ألف عن الطبراني","باب"
"19332","56  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  زَكَرِيَّا ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .         [21/65]","","Al-Mu'jam al-Kabir 56","","النعمان بن بشير الأنصاري عن الشعبي عن زكريا بن أبي زائدة الوادعي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","باب"
"19333","57  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مِنَ ابْنِ آدَمَ  مُضْغَةٌ  ; إِذَا صَلَحَتْ صَلَحَ لَهَا الْجَسَدُ  ، وَإِذَا فَسَدَ فَسَدَ الْجَسَدُ كُلُّهُ : الْقَلْبُ  .","","Al-Mu'jam al-Kabir 57","","النعمان بن بشير الأنصاري عن الشعبي عن مجالد بن سعيد عن حماد بن زيد عن سليمان بن داود العتكي عن موسى بن هارون الحمال عن الطبراني","باب"
"19334","58  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  الْعَبَّاسُ بْنُ طَالِبٍ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مُغِيرَةَ ،  عَنْ  عَامِرٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  فِي الْجَسَدِ  مُضْغَةٌ  ; إِذَا صَلَحَتْ صَلَحَ لَهُ كَذَا وَكَذَا ،  وَسَائِرُ جَسَدِهِ  .","","Al-Mu'jam al-Kabir 58","","النعمان بن بشير الأنصاري عن الشعبي عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن العباس بن طالب البصري عن يوسف بن يزيد القراطيسي عن الطبراني","باب"
"19335","59  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ فِي الْجَسَدِ  مُضْغَةً  ; إِذَا         [21/66]      صَلَحَتْ صَلَحَ الْجَسَدُ كُلُّهُ ، وَإِذَا فَسَدَتْ فَسَدَ الْجَسَدُ كُلُّهُ  .","","Al-Mu'jam al-Kabir 59","","النعمان بن بشير الأنصاري عن الشعبي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","باب"
"19336","60  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنِ  الْأَعْمَشِ وَأَشْعَثَ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  فِي الْجَسَدِ  مُضْغَةٌ  ; إِذَا صَلَحَتْ صَلَحَ الْجَسَدُ كُلُّهُ ،  وَإِذَا فَسَدَتْ فَسَدَ الْجَسَدُ ، وَهِيَ الْقَلْبُ  .","","Al-Mu'jam al-Kabir 60","","النعمان بن بشير الأنصاري عن الشعبي عن الأعمش عن حفص بن غياث النخعي عن محمد بن عبد الله بن نمير عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"19337","61  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  ثَنَا  جَرِيرٌ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَا :  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  مُطَرِّفِ بْنِ طَرِيفٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ فِي الْجَسَدِ  مُضْغَةً  ; إِذَا هِيَ سَلِمَتْ سَلِمَ الْجَسَدُ ; أَلَا وَهِيَ الْقَلْبُ  .","","Al-Mu'jam al-Kabir 61","","النعمان بن بشير الأنصاري عن الشعبي عن مطرف بن طريف عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","باب"
"19338","62  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدٌ ،  عَنِ  الْحَسَنِ بْنِ عُبَيْدِ اللهِ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  قَالَ  النُّعْمَانُ بْنُ بَشِيرٍ عَلَى هَذَا الْمِنْبَرِ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ فِي الْإِنْسَانِ  مُضْغَةً  ; إِذَا         [21/67]      صَلَحَتْ صَلَحَ الْجَسَدُ كُلُّهُ ، وَإِذَا سَقِمَتْ سَقِمَ لَهَا سَائِرُ الْجَسَدِ ; أَلَا وَهِيَ الْقَلْبُ  .","","Al-Mu'jam al-Kabir 62","","النعمان بن بشير الأنصاري عن الشعبي عن الحسن بن عبيد الله النخعي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","باب"
"19339","63  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عَلِيُّ بْنُ الْمُنْذِرِ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنِ  السَّرِيِّ بْنِ إِسْمَاعِيلَ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ فِي الْجَسَدِ  مُضْغَةً  ; إِذَا سَلِمَتْ سَلِمَ الْجَسَدُ كُلُّهُ ، وَإِذَا سَقِمَتْ سَقِمَ الْجَسَدُ كُلُّهُ ; أَلَا وَهِيَ الْقَلْبُ  .","","Al-Mu'jam al-Kabir 63","","النعمان بن بشير الأنصاري عن الشعبي عن السري بن إسماعيل الهمداني عن محمد بن فضيل بن غزوان عن علي بن المنذر العلاف عن الحسين بن إسحاق التستري عن الطبراني","باب"
"19340","64  -  حَدَّثَنَا  عَبْدَانُ ،  عَنْ  عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : سَمِعَ أُذُنِي مِنْ         [21/68]      رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ فِي الرَّجُلِ  مُضْغَةً  ; إِذَا صَلَحَتْ صَلَحَ جَسَدُهُ ، وَإِذَا سَقِمَتْ سَقِمَ لَهَا سَائِرُ جَسَدِهِ  .         [21/69]","","Al-Mu'jam al-Kabir 64","","النعمان بن بشير الأنصاري عن الشعبي عن منصور بن المعتمر عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن عبد الله بن أحمد الجواليقي عن الطبراني","باب"
"19341","65  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  حَدَّثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  قَالَتْ أُمِّي  عَمْرَةُ بِنْتُ رَوَاحَةَ  لِأَبِي : لَوْ نَحَلْتَ  النُّعْمَانَ  أَوْ وَهَبْتَ لَهُ ، وَأَشْهَدْتَ عَلَيْهِ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ! فَنَحَلَنِي ، وَأَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرَ ذَلِكَ لَهُ ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَكُلَّ وَلَدِكَ أَعْطَيْتَ مِثْلَ الَّذِي أَعْطَيْتَ لَهُ  ؟ "" ، قَالَ : لَا ، قَالَ : "" فَلَا  تُشْهِدْنِي  عَلَى جَوْرٍ ; فَإِنَّ لِبَنِيكَ عَلَيْكَ مِنَ الْحَقِّ أَنْ تَعْدِلَ عَلَيْهِمْ ، كَمَا أَنَّ لَكَ عَلَيْهِمْ أَنْ يَبَرُّوكَ  .","","Al-Mu'jam al-Kabir 65","","النعمان بن بشير الأنصاري عن الشعبي عن مجالد بن سعيد عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"19342","66  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  مُجَالِدِ بْنِ سَعِيدٍ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّ  أُمَّ النُّعْمَانِ بْنِ بَشِيرٍ  قَالَتْ لِأَبِيهِ : انْحَلْهُ ، وَأَشْهِدِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَلَكَ وَلَدٌ غَيْرُهُ ؟  قَالَ : نَعَمْ ، قَالَ : "" فَكُلَّهُمْ نَحَلْتَ ؟ "" ، قَالَ : لَا ، قَالَ :         [21/70]      فَتُشْهِدُنِي عَلَى الْجَوْرِ ؟ ! إِنَّ لَهُمْ عَلَيْكَ مِنَ الْحَقِّ أَنْ تَعْدِلَ بَيْنَهُمْ ، وَلَكَ عَلَيْهِمْ مِنَ الْحَقِّ أَنْ يَبَرُّوكَ  .","","Al-Mu'jam al-Kabir 66","","الشعبي عن مجالد بن سعيد عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"19343","67  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى ،  عَنْ  مُجَالِدٍ ،  حَدَّثَنِي  عَامِرٌ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ :  إِنَّ أَبِي  بَشِيرًا  وَهَبَ لِي هِبَةً ، فَقَالَتْ أُمِّي : أَشْهِدْ عَلَيْهَا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ . فَأَخَذَ بِيَدِي فَانْطَلَقْنَا حَتَّى أَتَيْنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ! إِنَّ أُمَّ هَذَا الْغُلَامِ سَأَلَتْنِي أَنْ أَهَبَ لَهُ هِبَةً ، فَوَهَبْتُهَا لَهُ ، فَقَالَتْ : أَشْهِدْ عَلَيْهَا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَتَيْتُكَ لِأُشْهِدَكَ ، فَقَالَ :  رُوَيْدًا  ! لَكَ وَلَدٌ غَيْرُهُ ؟  قَالَ : نَعَمْ ، قَالَ : "" فَكُلَّهُمْ أَعْطَيْتَ مَا أَعْطَيْتَ هَذَا ؟ "" قَالَ : لَا ، قَالَ : "" فَلَا  تُشْهِدْنِي  عَلَى جَوْرٍ ، إِنَّ لِبَنِيكَ عَلَيْكَ مِنَ الْحَقِّ أَنْ تَعْدِلَ بَيْنَهُمْ ، وَلَكَ عَلَيْهِمْ مِنَ الْحَقِّ أَنْ يَبَرُّوكَ "" فَرَجَعَ وَلَمْ يَهَبْهَا لِي  .","","Al-Mu'jam al-Kabir 67","","النعمان بن بشير الأنصاري عن الشعبي عن مجالد بن سعيد عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","باب"
"19344","68  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  عُمَرُ بْنُ عَلِيٍّ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ         [21/71]      بَشِيرٍ ، قَالَ :  تَصَدَّقَ  عَلَيَّ أَبِي بِصَدَقَةٍ ، فَقَالَتْ أُمِّي  عَمْرَةُ بِنْتُ رَوَاحَةَ  : لَا أَرْضَى حَتَّى تُشْهِدَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَتَى أَبِي النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : ابْنِي مِنْ عَمْرَةَ تَصَدَّقْتُ عَلَيْهِ ، وَإِنَّهَا قَالَتْ : لَا أَرْضَى حَتَّى تُشْهِدَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  رُوَيْدَكَ  ! هَلْ لَكَ وَلَدٌ غَيْرُهُ ؟  قَالَ : نَعَمْ . قَالَ : "" فَكُلَّهُمْ أَعْطَيْتَ مِثْلَ مَا أَعْطَيْتَهُ ؟ "" قَالَ : لَا ، قَالَ : "" فَاتَّقِ اللهَ وَاعْدِلْ بَيْنَهُمْ ; كَمَا لَكَ عَلَيْهِمْ مِنَ الْحَقِّ أَنْ يَبَرُّوكَ  .","","Al-Mu'jam al-Kabir 68","","النعمان بن بشير الأنصاري عن الشعبي عن مجالد بن سعيد عن عمر بن علي بن عطاء عن محمد بن أبي بكر المقدمي عن إبراهيم بن هاشم البغوي عن الطبراني","باب"
"19345","69  -  حَدَّثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الْقَاضِي ،  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ عَلَى مِنْبَرِنَا هَذَا يَقُولُ :  طَلَبَتْ  عَمْرَةُ بِنْتُ رَوَاحَةَ  إِلَى  بَشِيرِ بْنِ سَعْدٍ  أَنْ يَنْحَلَنِي  نُحْلًا  مِنْ مَالِهِ ، فَأَبَى عَلَيْهَا ، ثُمَّ بَدَا لَهُ بَعْدَ  حَوْلٍ أَوْ حَوْلَيْنِ  أَنْ يَنْحَلَنِيهِ ، فَقَالَ لَهَا : إِنَّ الَّذِي سَأَلْتِ لِابْنِي كَنْتُ مَنَعْتُهُ ، وَقَدْ         [21/72]      بَدَا لِي أَنْ أَنْحَلَهُ إِيَّاهُ . وَإِنَّهَا قَالَتْ : لَا أَرْضَى حَتَّى تَأْخُذَ بِيَدِهِ فَتَنْطَلِقَ بِهِ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَتُشْهِدَهُ . فَأَخَذَ بِيَدِي فَانْطَلَقَ بِي إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا نَبِيَّ اللهِ إِنَّ  عَمْرَةَ بِنْتَ رَوَاحَةَ  طَلَبَتْ إِلَيَّ أَنْ أَنْحَلَ ابْنِي هَذَا  نُحْلًا  ، وَإِنِّي كُنْتُ أَبَيْتُ عَلَيْهَا ، ثُمَّ بَدَا لِي أَنْ أَنْحَلَهُ إِيَّاهُ ، وَإِنَّهَا قَالَتْ : لَا أَرْضَى حَتَّى تَأْخُذَ بِيَدِهِ فَتَنْطَلِقَ بِهِ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَتُشْهِدَهُ . فَقَالَ :  هَلْ لَكَ مَعَهُ وَلَدٌ غَيْرُهُ ؟  قَالَ : نَعَمْ . قَالَ : "" فَهَلْ آتَيْتَ كُلَّ وَاحِدٍ مِنْهُمْ مَا آتَيْتَ هَذَا ؟ "" . قَالَ : لَا ، قَالَ : "" فَإِنِّي لَا أَشْهَدُ عَلَى هَذَا ; هَذَا جَوْرٌ ، أَشْهِدْ عَلَى هَذَا غَيْرِي . اعْدِلُوا بَيْنَ أَوْلَادِكُمْ فِي النُّحْلِ ; كَمَا تُحِبُّونَ أَنْ يَعْدِلُوا بَيْنَكُمْ فِي  الْبِرِّ  وَاللُّطْفِ  وَاللَّفْظُ لِحَدِيثِ  أَبِي الرَّبِيعِ  .","","Al-Mu'jam al-Kabir 69","","النعمان بن بشير الأنصاري عن الشعبي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","باب"
"19346","70  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  عَمْرُو بْنُ عُثْمَانَ الْحِمْصِيُّ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  ثَنَا  شُعْبَةُ ،  حَدَّثَنِي  مُغِيرَةُ بْنُ مِقْسَمٍ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : وَظَنَنْتُ أَنِّي لَمْ أَسْمَعْ رَجُلًا بَعْدَهُ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  أَرَادَتْ  عَمْرَةُ بِنْتُ رَوَاحَةَ  وَهِيَ أُمُّ  النُّعْمَانِ  أَنْ يَنْحَلَنِي         [21/73]      نُحْلًا  ، فَمَنَعَهَا حَوْلًا ، ثُمَّ بَدَا لَهُ أَنْ يُعْطِيَنِي ، فَقَالَتْ : لَا أَرْضَى حَتَّى تَأْخُذَ بِيَدِ ابْنِي فَتَأْتِيَ بِهِ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَخَذَ بِيَدِي فَأَتَاهُ بِي ، فَذَكَرَ ذَلِكَ لَهُ ، قَالَ :  فَلَا تُشْهِدْنِي عَلَى هَذَا  ، قَالَ  الْمُغِيرَةُ  : لَا أَدْرِي ،  قَالَ : "" جَوْرٌ "" أَوْ قَالَ : ""  تَلْجِئَةٌ  "" ، ثُمَّ قَالَ : "" اعْدِلُوا بَيْنَ أَوْلَادِكُمْ فِي النُّحْلِ ، كَمَا تُحِبُّونَ أَنْ يَعْدِلُوا بَيْنَكُمْ فِي  الْبِرِّ  وَاللُّطْفِ  .","","Al-Mu'jam al-Kabir 70","","النعمان بن بشير الأنصاري عن الشعبي عن المغيرة بن مقسم الضبي عن شعبة بن الحجاج عن بقية بن الوليد عن عمرو بن عثمان بن سعيد الحمصي عن عبد الله بن أحمد الجواليقي عن الطبراني","باب"
"19347","71  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  هُشَيْمٌ ،         [21/74]      أَنَا  سَيَّارٌ ، وَمُغِيرَةُ ، وَدَاوُدُ بْنُ أَبِي هِنْدٍ ، وَإِسْمَاعِيلُ بْنُ سَالِمٍ ، وَمُجَالِدٌ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  نَحَلَنِي أَبِي  نُحْلًا  ، قَالَ  إِسْمَاعِيلُ  :  نَحَلَهُ  غُلَامًا ، فَقَالَتْ لَهُ أُمِّي  عَمْرَةُ بِنْتُ رَوَاحَةَ  : ائْتِ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَشْهِدْهُ . فَأَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ ذَلِكَ لَهُ ، فَقَالَ : إِنِّي نَحَلْتُ ابْنِي  النُّعْمَانَ  نِحْلَةً  ، وَإِنَّ عَمْرَةَ سَأَلَتْنِي أَنْ أُشْهِدَكَ عَلَى ذَلِكَ . فَقَالَ : "" لَكَ وَلَدٌ سِوَاهُ ؟ "" . فَقُلْتُ : نَعَمْ . قَالَ : "" فَكُلَّهُمْ أَعْطَيْتَ مِثْلَ مَا أَعْطَيْتَ  النُّعْمَانَ  ؟ "" قَالَ : لَا ، قَالَ بَعْضُ هَؤُلَاءِ الْمُحَدِّثِينَ : "" هَذَا جَوْرٌ "" ، وَقَالَ بَعْضُهُمْ : "" هَذَا  تَلْجِئَةٌ  ، فَأَشْهِدْ عَلَى هَذَا غَيْرِي "" . قَالَ  مُغِيرَةُ  :  أَلَيْسَ يَسُرُّكَ أَنْ يَكُونُوا لَكَ فِي  اللُّطْفِ  وَالْبِرِّ سَوَاءً  ؟ "" ، قَالَ : نَعَمْ ، قَالَ : "" فَأَشْهِدْ عَلَى هَذَا غَيْرِي "" . وَذَكَرَ  مُجَالِدٌ  فِي حَدِيثِهِ : "" إِنَّ لَهُمْ عَلَيْكَ مِنَ الْحَقِّ أَنْ تَعْدِلَ بَيْنَهُمْ ، كَمَا أَنَّ لَكَ عَلَيْهِمْ مِنَ الْحَقِّ أَنْ يَبَرُّوكَ  .","","Al-Mu'jam al-Kabir 71","","النعمان بن بشير الأنصاري عن الشعبي عن مجالد بن سعيد عن هشيم بن بشير عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","باب"
"19348","72  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ ،  ثَنَا  أَبُو غَسَّانَ         [21/75]      مَالِكُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  جَعْفَرُ بْنُ زِيَادٍ الْأَحْمَرُ ،  عَنْ  بَيَانِ بْنِ بِشْرٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ;  أَنَّ أَبَاهُ  تَصَدَّقَ  عَلَيْهِ بِصَدَقَةٍ ، فَقَالَتْ أُمُّهُ : لَا أَرْضَى حَتَّى تُشْهِدَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - . فَأَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا رَسُولَ اللهِ ! إِنِّي تَصَدَّقْتُ عَلَى ابْنِي بِصَدَقَةٍ ، وَإِنَّ أُمَّهُ طَلَبَتْ إِلَيَّ أَنْ أُشْهِدَكَ . فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" أَلَكَ وَلَدٌ سِوَاهُ ؟ "" ، قَالَ : نَعَمْ ، قَالَ : "" كُلَّهُمْ أَعْطَيْتَهُ ؟ "" . قَالَ : لَا . فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اعْدِلْ بَيْنَهُمْ  .","","Al-Mu'jam al-Kabir 72","","النعمان بن بشير الأنصاري عن الشعبي عن بيان بن بشر الأحمسي عن جعفر بن زياد الأحمر عن مالك بن إسماعيل النهدي عن حفص بن عمر سنجة ألف عن الطبراني","باب"
"19349","73  -  حَدَّثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الْعُقَيْلِيُّ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  أَبُو مَعْشَرٍ ،  ثَنَا  فُضَيْلُ بْنُ مَيْسَرَةَ الْعُقَيْلِيُّ أَبُو مُعَاذٍ ،  عَنْ  أَبِي حَرِيزٍ (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى الصَّنْعَانِيُّ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ، قَالَ :  قَرَأْتُ عَلَى  الْفُضَيْلِ بْنِ مَيْسَرَةَ ،  عَنْ  أَبِي حَرِيزٍ ، عَنِ الشَّعْبِيِّ ;  أَنَّهُ حَدَّثَهُ  أَنَّ  النُّعْمَانَ بْنَ بَشِيرٍ         [21/76]      خَطَبَ  بِالْكُوفَةِ  فَقَالَ : إِنَّ وَالِدِي  بَشِيرَ بْنَ سَعْدٍ  أَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : إِنَّ  عَمْرَةَ بِنْتَ رَوَاحَةَ  نُفِسَتْ بِغُلَامٍ ، وَإِنِّي سَمَّيْتُهُ  النُّعْمَانَ  ، وَإِنَّهَا أَبَتْ أَنْ تُرَبِّيَهُ حَتَّى جَعَلْتُ لَهُ  حَدِيقَةً  لِي ; أَفْضَلُ مَالٍ هُوَ لِي ، وَإِنَّهَا قَالَتْ :         [21/77]      أَشْهِدْ عَلَى ذَلِكَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - . قَالَ :  لَكَ وَلَدٌ غَيْرُهُ ؟  ، قَالَ : نَعَمْ ، قَالَ : "" لَا  تُشْهِدْنِي  إِلَّا عَلَى عَدْلٍ ; فَإِنِّي لَا أَشْهَدُ عَلَى جَوْرٍ  .  وَاللَّفْظُ لِحَدِيثِ  الْمُقَدَّمِيِّ  . وَاسْمُ  أَبِي حَرِيزٍ  :  عَبْدُ اللهِ بْنُ حُسَيْنٍ قَاضِي سِجِسْتَانَ  .","","Al-Mu'jam al-Kabir 73","","النعمان بن بشير الأنصاري عن الشعبي عن عبد الله بن الحسين السجستاني عن فضيل بن ميسرة عن معتمر بن سليمان عن محمد بن عبد الأعلى القيسي عن الحسين بن إسحاق التستري عن الطبراني","باب"
"19350","74  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْمُعَافَى بْنِ سُلَيْمَانَ ،  ثَنَا  أَبِي  (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ الْبَرَاءِ ، قَالَ :  ثَنَا  مُعَافَى بْنُ سُلَيْمَانَ ،  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ;  أَنَّ  بَشِيرَ بْنَ سَعْدٍ  أَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا رَسُولَ اللهِ ! إِنَّ  عَمْرَةَ بِنْتَ رَوَاحَةَ  أَرَادَتْنِي عَلَى أَنْ أَتَصَدَّقَ عَلَى ابْنِهَا بِصَدَقَةٍ ، وَأَمَرَتْنِي أَنْ أُشْهِدَكَ عَلَى ذَلِكَ . فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  هَلْ لَكَ         [21/78]      بَنُونَ سِوَاهُ ؟  قَالَ : نَعَمْ ، قَالَ : "" كُلَّهُمْ أَعْطَيْتَ كَمَا أَعْطَيْتَ هَذَا ؟ "" ، فَقَالَ : لَا ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" فَلَا تُشْهِدْنِي عَلَى جَوْرٍ  .","","Al-Mu'jam al-Kabir 74","","النعمان بن بشير الأنصاري عن الشعبي عن إسماعيل بن أبي خالد عن موسى بن أعين الجزري عن المعافى بن سليمان الرسعني عن محمد بن أحمد بن البراء العبدي عن الطبراني","باب"
"19351","75  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ، قَالَا :  ثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  عَنْ  حُصَيْنٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ :  أَعْطَانِي أَبِي عَطِيَّةً ، فَقَالَتْ أُمِّي  عَمْرَةُ بِنْتُ رَوَاحَةَ  : لَا أَرْضَى حَتَّى تُشْهِدَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - . فَأَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا رَسُولَ اللهِ ! إِنِّي أَعْطَيْتُ ابْنِي مِنْ عَمْرَةَ عَطِيَّةً ، فَأَمَرَتْنِي أَنْ أُشْهِدَكَ . فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَعْطَيْتَ كُلَّ وَلَدِكَ مِثْلَ هَذَا ؟  ، قَالَ : لَا ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" فَاعْدِلُوا بَيْنَ أَوْلَادِكُمْ "" فَرَجَعَ فَرَدَّ عَطِيَّتَهُ  .","","Al-Mu'jam al-Kabir 75","","النعمان بن بشير الأنصاري عن الشعبي عن حصين بن عبد الرحمن السلمي عن عباد بن العوام الكلابي عن سعيد بن سليمان سعدويه عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"19352","76  -  حَدَّثَنَا  النُّعْمَانُ بْنُ أَحْمَدَ الْوَاسِطِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ حَرْبٍ         [21/79]      النَّشَائِيُّ ،  ثَنَا  عَلِيُّ بْنُ عَاصِمٍ ،  عَنْ  دَاوُدَ ، وَحُصَيْنٍ ، وَإِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، وَأَبُو إِسْحَاقَ الشَّيْبَانِيُّ ، وَمُطَرِّفُ بْنُ طَرِيفٍ ،  عَنِ  الشَّعْبِيِّ ،  وَعَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ، قَالَ :         [21/80]      سَمِعْنَا  النُّعْمَانَ بْنَ بَشِيرٍ وَهُوَ يَخْطُبُ عَلَى الْمِنْبَرِ ، قَالَ :  تَصَدَّقَ  عَلَيَّ أَبِي بِصَدَقَةٍ ، فَقَالَتْ  عَمْرَةُ بِنْتُ رَوَاحَةَ  وَهِيَ أُمُّ  النُّعْمَانِ  - : لَا أَرْضَى حَتَّى تُشْهِدَ عَلَيْهَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَتَى  بَشِيرٌ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : إِنِّي تَصَدَّقْتُ عَلَى ابْنِي بِصَدَقَةٍ ، فَقَالَتْ  عَمْرَةُ بِنْتُ رَوَاحَةَ  وَهِيَ أُمُّ  النُّعْمَانِ  - : لَا أَرْضَى حَتَّى تُشْهِدَ عَلَيْهَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَكَ بَنُونَ غَيْرُهُ ؟  ، قَالَ : نَعَمْ ، قَالَ : "" فَكُلَّهُمْ أَعْطَيْتَ مِثْلَ الَّذِي أَعْطَيْتَ هَذَا ؟ "" ، قَالَ : لَا . قَالَ : "" هَذَا جَوْرٌ ; فَلَا  تُشْهِدْنِي  عَلَيْهِ ، اتَّقُوا اللهَ وَاعْدِلُوا بَيْنَ أَوْلَادِكُمْ كَمَا تُحِبُّونَ أَنْ يَبَرُّوكُمْ "" ، قَالَ : فَرَجَعَ أَبِي فِي صَدَقَتِهِ  .","","Al-Mu'jam al-Kabir 76","","النعمان بن بشير الأنصاري عن محارب بن دثار عن عطاء بن السائب عن علي بن عاصم بن صهيب عن محمد بن حرب النشائي عن النعمان بن أحمد بن نعيم الواسطي عن الطبراني","باب"
"19353","77  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ ،  ثَنَا  أَبُو حُذَيْفَةَ         [21/81]      ،  ثَنَا  سُفْيَانُ ،  عَنْ  جَابِرٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ اللهَ يُحِبُّ أَنْ تَعْدِلُوا بَيْنَ أَوْلَادِكُمْ  .","","Al-Mu'jam al-Kabir 77","","النعمان بن بشير الأنصاري عن الشعبي عن جابر الجعفي عن سفيان بن عيينة عن موسى بن مسعود النهدي عن حفص بن عمر سنجة ألف عن الطبراني","باب"
"19354","78  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ ، وَيَحْيَى بْنُ مُعَاذٍ التُّسْتَرِيَّانِ ، قَالَا :  ثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ الْمُعَلَّى الْأَدَمِيُّ ، قَالَا :  ثَنَا  خَالِدُ بْنُ يَزِيدَ الْمُقْرِئُ ،  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَزْرَةَ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  أَخَذَ أَبِي بِيَدِي ، فَذَهَبَ بِي إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : إِنَّ هَذَا ابْنِي ، وَقَدْ طَلَبَتْ إِلَيَّ أُمُّهُ أَنْ أَنْحَلَهُ مِنْ مَالِي ، وَأُشْهِدَكَ عَلَيْهِ ، قَالَ :  هَلْ لَكَ وَلَدٌ غَيْرُهُ ؟  ، قَالَ : نَعَمْ ، قَالَ : "" فَكُلَّهُمْ جَعَلْتَ لَهُ مِثْلَ مَا جَعَلْتَ لِهَذَا ؟ "" ، قَالَ : لَا ، قَالَ : "" أَفَتُرِيدُ أَنْ تُشْهِدَنِي عَلَى الْجَوْرِ ؟ ! "" ، قَالَ : فَرَجَعْنَا كَمَا ذَهَبْنَا  .","","Al-Mu'jam al-Kabir 78","","النعمان بن بشير الأنصاري عن الشعبي عن عزرة بن عبد الرحمن بن زرارة عن قتادة بن دعامة عن همام بن يحيى بن دينار عن خالد بن يزيد الكحال عن أحمد بن محمد بن المعلى الهدادي عن يحيى بن معاذ التستري عن الطبراني","باب"
"19355","79  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ         [21/82]      ابْنِ جُرَيْجٍ ، قَالَ :  حَدَّثَنِي  عَوْنُ بْنُ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّ  نُعْمَانَ بْنَ بَشِيرٍ قَالَتْ أُمُّهُ : يَا  بَشِيرُ  ، انْحَلِ  النُّعْمَانَ  . فَلَمْ تَزَلْ بِهِ حَتَّى  نَحَلَهُ  ، فَقَالَتْ : أَشْهِدْ عَلَيْهِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَذَهَبَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ لَهُ الشَّهَادَةَ ، فَقَالَ لَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَنَحَلْتَ بَنِيكَ مِثْلَ ذَلِكَ ؟  ، قَالَ : لَا ، قَالَ : "" فَإِنِّي لَا أَشْهَدُ عَلَى الْجَوْرِ  .  قَالَ لِي  عَوْنٌ : وَأَمَّا أَنَا  فَسَمِعْتُ  أَبِي يَقُولُ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  فَسَوِّ بَيْنَهُمْ  .","","Al-Mu'jam al-Kabir 79","","النعمان بن بشير الأنصاري عن الشعبي عن عون بن عبد الله بن عتبة عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"19356","80  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ بَكْرٍ السَّرَّاجُ الْعَسْكَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنِي  جَرِيرٌ ،  عَنْ  مُغِيرَةَ وَعَاصِمٍ الْأَحْوَلِ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ; أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ لِأَبِيهِ :  لَا تُشْهِدْنِي عَلَى جَوْرٍ  .","","Al-Mu'jam al-Kabir 80","","النعمان بن بشير الأنصاري عن الشعبي عن عاصم بن سليمان الأحول عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن محمد بن عبد الله بن بكر السراج عن الطبراني","باب"
"19357","81  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ الْمَسْرُوقِيُّ ،  ثَنَا         [21/83]      مَسْرُوقُ بْنُ الْمَرْزُبَانِ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنِ  ابْنِ عَوْنٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  نَحَلَنِي أَبِي  نُحْلًا  ، فَقَالَتْ لِأَبِي : أَشْهِدْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِيُشْهِدَهُ ، فَقَالَ :  أَشْهِدْ عَلَى هَذَا غَيْرِي  .","","Al-Mu'jam al-Kabir 81","","النعمان بن بشير الأنصاري عن الشعبي عن عبد الله بن عون بن أرطبان عن شريك بن عبد الله بن أبي نمر الكناني عن مسروق بن المرزبان الكندي عن محمد بن عبد الله بن عبد الرحمن المسروقي عن الطبراني","باب"
"19358","82  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  أَبِي حَيَّانَ التَّيْمِيِّ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  جَاءَ بِي أَبِي إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُشْهِدُهُ عَلَى عَطِيَّةٍ         [21/84]      يُعْطِينِيهَا ، فَقَالَ : "" أَلَكَ غَيْرُهُ "" ، قَالَ : نَعَمْ ، قَالَ : "" فَكُلَّهُمْ أَعْطَيْتَ مِثْلَ الَّذِي أَعْطَيْتَ هَذَا ؟ "" ، قَالَ : لَا ، قَالَ :  فَلَا أَشْهَدُ عَلَى جَوْرٍ  .","","Al-Mu'jam al-Kabir 82","","النعمان بن بشير الأنصاري عن الشعبي عن يحيى بن سعيد التيمي عن علي بن مسهر القرشي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","باب"
"19359","83  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  يَعْلَى بْنُ عُبَيْدٍ ،  عَنْ  أَبِي حَيَّانَ التَّيْمِيِّ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ ، إِلَّا أَنَّهُ قَالَ :  لَا أَشْهَدُ عَلَى  جَنَفٍ  .         [21/85]","","Al-Mu'jam al-Kabir 83","","النعمان بن بشير الأنصاري عن الشعبي عن يحيى بن سعيد التيمي عن يعلى بن عبيد الطنافسي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","باب"
"19360","84  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ،  ثَنَا  أَبُو وَكِيعٍ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا  يَشْكُرُ  اللهَ مَنْ لَا  يَشْكُرُ  النَّاسَ  ، وَالتَّحَدُّثُ بِنِعْمَةِ اللهِ شُكْرٌ ، وَتَرْكُهَا كُفْرٌ ، وَالْجَمَاعَةُ رَحْمَةٌ ، وَالْفُرْقَةُ عَذَابٌ  .         [21/86]","","Al-Mu'jam al-Kabir 84","","النعمان بن بشير الأنصاري عن الشعبي عن القاسم بن الوليد الخبذعي عن الجراح بن مليح الرؤاسي والد وكيع عن موسى بن إسماعيل التبوذكي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","باب"
"19361","85  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ أَبُو يَحْيَى صَاعِقَةُ ،  ثَنَا  أَبُو وَكِيعٍ ،  عَنِ  الْقَاسِمِ بْنِ الْوَلِيدِ أَبِي عَبْدِ الرَّحْمَنِ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا  يَشْكُرُ  اللهَ مَنْ لَا  يَشْكُرُ  النَّاسَ  ، وَالتَّحَدُّثُ بِنِعْمَةِ اللهِ شُكْرٌ ، وَتَرْكُهَا كُفْرٌ ، وَالْجَمَاعَةُ رَحْمَةٌ ، وَالْفُرْقَةُ عَذَابٌ  .         [21/87]","","Al-Mu'jam al-Kabir 85","","النعمان بن بشير الأنصاري عن الشعبي عن القاسم بن الوليد الخبذعي عن الجراح بن مليح الرؤاسي والد وكيع عن محمد بن عبد الرحيم  صاعقة عن عبد الله بن أحمد بن حنبل عن الطبراني","باب"
"19362","86  -  حَدَّثَنَا  الْقَاسِمُ بْنُ مُحَمَّدٍ الدَّلَّالُ الْكُوفِيُّ ،  ثَنَا  مُخَوَّلُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  أَسْبَاطُ بْنُ نَصْرٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ مِنَ الْحِنْطَةِ خَمْرًا  ، وَإِنَّ مِنَ الشَّعِيرِ خَمْرًا ، وَإِنَّ مِنَ التَّمْرِ خَمْرًا ، وَإِنَّ مِنَ الْعَسَلِ خَمْرًا  .","","Al-Mu'jam al-Kabir 86","","النعمان بن بشير الأنصاري عن الشعبي عن إبراهيم بن مهاجر بن جابر البجلي عن أسباط بن نصر الهمداني عن مخول بن إبراهيم الكوفي عن قاسم بن محمد بن حماد الدلال عن الطبراني","باب"
"19363","87  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مِنَ الْحِنْطَةِ خَمْرٌ ، وَمِنَ الشَّعِيرِ خَمْرٌ  ، وَمِنَ الزَّبِيبِ خَمْرٌ ، وَمِنَ الْعَسَلِ خَمْرٌ  .","","Al-Mu'jam al-Kabir 87","","النعمان بن بشير الأنصاري عن الشعبي عن إبراهيم بن مهاجر بن جابر البجلي عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","باب"
"19364","88  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ مِنَ الْحِنْطَةِ خَمْرًا  ، وَمِنَ الشَّعِيرِ خَمْرًا ، وَمِنَ الْعَسَلِ خَمْرًا ، وَمِنَ التَّمْرِ         [21/88]      خَمْرًا ، وَمِنَ الزَّبِيبِ خَمْرًا  .","","Al-Mu'jam al-Kabir 88","","النعمان بن بشير الأنصاري عن الشعبي عن إبراهيم بن مهاجر بن جابر البجلي عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","باب"
"19365","89  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ الْأَصْبَهَانِيُّ ،  ثَنَا  أَبُو مَسْعُودٍ أَحْمَدُ بْنُ الْفُرَاتِ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ بْنِ سَعْدٍ الدَّشْتَكِيُّ ،  ثَنَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ الْمُهَاجِرِ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مِنَ الْحِنْطَةِ خَمْرٌ ، وَمِنَ الشَّعِيرِ خَمْرٌ  ، وَمِنَ الْعَسَلِ خَمْرٌ ، وَمِنَ الزَّبِيبِ خَمْرٌ  .","","Al-Mu'jam al-Kabir 89","","النعمان بن بشير الأنصاري عن الشعبي عن إبراهيم بن مهاجر بن جابر البجلي عن عمرو بن أبي قيس عن عبد الرحمن بن عبد الله الدشتكي عن أحمد بن الفرات الضبي عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","باب"
"19366","90  -  حَدَّثَنَا  مُوسَى بْنُ عِيسَى بْنِ الْمُنْذِرِ الْحِمْصِيُّ ، قَالَ :  ثَنَا  عَلِيُّ بْنُ عَيَّاشٍ (  ح  ) .  وَحَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  ثَنَا  اللَّيْثُ بْنُ سَعْدٍ ،  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي حَبِيبٍ ، أَنَّ خَالِدَ بْنَ كَثِيرٍ الْهَمْدَانِيَّ  حَدَّثَهُ  ، أَنَّ السَّرِيَّ بْنَ إِسْمَاعِيلَ  حَدَّثَهُ  أَنَّ الشَّعْبِيَّ  حَدَّثَهُ  ;  أَنَّهُ سَمِعَ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ مِنَ الْحِنْطَةِ خَمْرًا  ، وَمِنَ الزَّبِيبِ خَمْرًا ، وَمِنَ التَّمْرِ خَمْرًا ، وَمِنَ الْعَسَلِ خَمْرًا . وَأَنَا أَنْهَى عَنْ كُلِّ مُسْكِرٍ  .         [21/89]","","Al-Mu'jam al-Kabir 90","","النعمان بن بشير الأنصاري عن الشعبي عن السري بن إسماعيل الهمداني عن خالد بن كثير الهمداني عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","باب"
"19367","91  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الْكِنْدِيُّ ،  ثَنَا  جَرِيرُ بْنُ السَّرِيِّ بْنِ إِسْمَاعِيلَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اجْتَنِبُوا كُلَّ مُسْكِرٍ  .","","Al-Mu'jam al-Kabir 91","","النعمان بن بشير الأنصاري عن الشعبي عن السري بن إسماعيل الهمداني عن جرير بن السري بن إسماعيل عن علي بن سعيد بن مسروق الكندي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"19368","92  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْحَارِثِ الْحَرَّانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ مُسْلِمٍ ،  عَنِ  السَّرِيِّ بْنِ إِسْمَاعِيلَ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَا أَيُّهَا النَّاسُ ! إِنَّ مِنَ الْعِنَبِ خَمْرًا  ، وَإِنَّ مِنَ التَّمْرِ خَمْرًا ، وَإِنَّ مِنَ الْبُرِّ خَمْرًا ، وَإِنَّ مِنَ الشَّعِيرِ خَمْرًا ، وَإِنَّ مِنَ الْعَسَلِ خَمْرًا ، وَأَنَا أَنْهَى عَنْ كُلِّ مُسْكِرٍ  .","","Al-Mu'jam al-Kabir 92","","النعمان بن بشير الأنصاري عن الشعبي عن السري بن إسماعيل الهمداني عن الزهري عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن محمد بن الحارث الرافقي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"19369","93  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ، قَالَ :  قَرَأْتُ عَلَى  الْفُضَيْلِ بْنِ         [21/90]      مَيْسَرَةَ ،  عَنْ  أَبِي حَرِيزٍ ; أَنَّ عَامِرًا  حَدَّثَهُ  أَنَّ  النُّعْمَانَ بْنَ بَشِيرٍ خَطَبَ النَّاسَ  بِالْكُوفَةِ  ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ الْخَمْرَ مِنَ الْعَصِيرِ  ، وَالزَّبِيبِ ، وَالتَّمْرِ ، وَالْحِنْطَةِ ، وَالشَّعِيرِ ، وَمِنَ الذُّرَةِ ، وَإِنِّي أَنْهَاكُمْ عَنْ كُلِّ مُسْكِرٍ  .         [21/91]","","Al-Mu'jam al-Kabir 93","","النعمان بن بشير الأنصاري عن الشعبي عن عبد الله بن الحسين السجستاني عن فضيل بن ميسرة عن معتمر بن سليمان عن محمد بن عبد الأعلى القيسي عن الحسين بن إسحاق التستري عن الطبراني","باب"
"19370","94  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  عِيسَى بْنُ إِبْرَاهِيمَ الْبِرَكِيُّ ،  ثَنَا  أَبُو أُمَيَّةَ بْنُ يَعْلَى الثَّقَفِيُّ ،  ثَنَا  عِيسَى بْنُ أَبِي عِيسَى الْحَنَّاطُ ،  عَنِ  الشَّعْبِيِّ ، وَمُجَاهِدٍ ،  قَالَا  : قَدِمَ عَلَيْنَا النُّعْمَانُ بْنُ بَشِيرٍ ، فَخَطَبَنَا فَقَالَ فِي خُطْبَتِهِ :  خَطَبَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  مَسْجِدِ الْخَيْفِ  ، فَقَالَ :  نَضَّرَ  اللهُ وَجْهَ عَبْدٍ سَمِعَ مَقَالَتِي فَحَمَلَهَا ، رُبَّ حَامِلِ فِقْهٍ غَيْرُ فَقِيهٍ  ، وَرُبَّ حَامِلِ فِقْهٍ إِلَى مَنْ هُوَ أَفْقَهُ مِنْهُ . ثَلَاثٌ لَا  يُغِلُّ  عَلَيْهِنَّ قَلْبُ مُؤْمِنٍ : إِخْلَاصُ الْعَمَلِ لِلهِ ، وَمُنَاصَحَةُ وُلَاةِ الْأَمْرِ ، وَلُزُومُ جَمَاعَةِ         [21/92]      الْمُسْلِمِينَ ; فَإِنَّ  دَعْوَتَهُمْ  تُحِيطُ  مِنْ وَرَائِهِمْ  .","","Al-Mu'jam al-Kabir 94","","النعمان بن بشير الأنصاري عن مجاهد بن جبر المخزومي عن عيسى بن أبي عيسى الحناط عن إسماعيل بن يعلى الثقفي عن عيسى بن إبراهيم البركي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","باب"
"19371","95  -  حَدَّثَنَا  الْحَسَنُ بْنُ الْعَبَّاسِ الرَّازِيُّ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، وَعَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ، وَعَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ الْأَصْبَهَانِيُّ ; قَالُوا :  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  خُذُوا عَلَى أَيْدِي سُفَهَائِكُمْ  .         [21/93]","","Al-Mu'jam al-Kabir 95","","النعمان بن بشير الأنصاري عن الشعبي عن الأعمش عن حفص بن غياث النخعي عن سهل بن عثمان العسكري عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","باب"
"19372","96  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  شَيْبَانُ ،  عَنْ  عَاصِمٍ ،  عَنْ  خَيْثَمَةَ ، وَالشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  خَيْرُ النَّاسِ  قَرْنِي  ، ثُمَّ الَّذِينَ يَلُونَهُمْ ، ثُمَّ الَّذِينَ يَلُونَهُمْ ، ثُمَّ يَأْتِي قَوْمٌ تَسْبِقُ أَيْمَانُهُمْ شَهَادَتَهُمْ ، وَتَسْبِقُ شَهَادَتُهُمْ أَيْمَانَهُمْ  .","","Al-Mu'jam al-Kabir 96","","النعمان بن بشير الأنصاري عن الشعبي عن عاصم بن بهدلة عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","باب"
"19373","97  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ الْحِمْصِيُّ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  عِيسَى بْنِ عَبْدِ اللهِ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ رَبَطَ دَابَّةً عَلَى طَرِيقِ الْمُسْلِمِينَ ، فَأَصَابَ ;         [21/94]      فَهُوَ ضَامِنٌ  .","","Al-Mu'jam al-Kabir 97","","النعمان بن بشير الأنصاري عن الشعبي عن إسماعيل بن أبي خالد عن عيسى بن عبد الله عن بقية بن الوليد عن محمد بن مصفى بن بهلول عن عبد الله بن أحمد الجواليقي عن الطبراني","باب"
"19374","98  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى بْنِ مُعَاذٍ الْعَنْبَرِيُّ ،  ثَنَا  عَمِّي عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  ثَنَا  أَبِي ،  ثَنَا  أَبُو يُونُسَ الْقُشَيْرِيُّ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ، قَالَ : خَطَبَنَا النُّعْمَانُ بْنُ بَشِيرٍ (  ح  ) .  وَحَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سُفْيَانَ اللُّؤْلُئِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي عَدِيٍّ ،  عَنْ  أَبِي يُونُسَ الْقُشَيْرِيِّ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  أَنَّهُ سَمِعَ  النُّعْمَانَ بْنَ بَشِيرٍ ; وَهُوَ يَخْطُبُ عَلَى مِنْبَرِ  الْكُوفَةِ  ، وَكَانَ أَكْثَرَ شَيْءٍ حَدَّثَنَا عَلَى مِنْبَرِهِ ، فَقَالَ :  لَلَّهُ أَشَدُّ  فَرَحًا  بِتَوْبَةِ عَبْدِهِ مِنْ رَجُلٍ حَمَلَ زَادَهُ وَمَزَادَهُ عَلَى بَعِيرٍ  ، ثُمَّ انْطَلَقَ يَسِيرُ ، حَتَّى إِذَا كَانَ بِفَلَاةٍ         [21/95]      مِنَ الْأَرْضِ أَدْرَكَتْهُ الْقَائِلَةُ فَنَزَلَ ، فَقَالَ تَحْتَ شَجَرَةٍ ، فَغَلَبَتْهُ عَيْنَاهُ ،  فَانْسَلَّ  بَعِيرُهُ ، فَاسْتَيْقَظَ فَزِعًا ، ثُمَّ سَعَى شَرَفًا فَنَظَرَ فَلَمْ يَرَ شَيْئًا ، ثُمَّ سَعَى شَرَفًا آخَرَ فَنَظَرَ فَلَمْ يَرَ شَيْئًا ، ثُمَّ سَعَى شَرَفًا ثَالِثًا فَنَظَرَ فَلَمْ يَرَ شَيْئًا ، ثُمَّ أَتَى مَكَانَهُ الَّذِي قَالَ بِهِ فَقَعَدَ فِيهِ ، فَبَيْنَمَا هُوَ قَاعِدٌ قَدْ أَشْرَفَ عَلَى الْهَلَكَةِ إِذَا بَعِيرُهُ يَمْشِي حَتَّى وَضَعَ خِطَامَهُ فِي يَدِهِ . فَلَلَّهُ أَشَدُّ  فَرَحًا  بِتَوْبَةِ الْعَبْدِ مِنْهُ حِينَ وَجَدَ بَعِيرَهُ عَلَى حَالِهِ ذَاكَ  .  ،  قَالَ : فَزَعَمَ  سِمَاكٌ  أَنَّ  الشَّعْبِيَّ  أَوِ  اللَّخْمِيَّ  - لَا يَدْرِي  سِمَاكٌ  أَيُّهُمَا هُوَ - أَنَّ  النُّعْمَانَ بْنَ بَشِيرٍ  رَفَعَهُ  يَوْمَئِذٍ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَاللَّفْظُ لِحَدِيثِ  ابْنِ أَبِي عَدِيٍّ  .         [21/96]      وَقَالَ  مُعَاذُ بْنُ مُعَاذٍ  فِي حَدِيثِهِ : قَالَ  سِمَاكٌ  : فَزَعَمَ  الشَّعْبِيُّ  أَنَّ  النُّعْمَانَ  رَفَعَ  هَذَا الْحَدِيثَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَمَّا أَنَا فَلَمْ أَسْمَعْهُ . وَلَمْ يَذْكُرِ  اللَّخْمِيَّ  .  وَاللَّخْمِيُّ  :  عَبْدُ الْمَلِكِ بْنُ عُمَيْرٍ  .","","Al-Mu'jam al-Kabir 98","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن حاتم بن أبي صغيرة القشيري عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن معاذ بن المثنى العنبري عن الطبراني","باب"
"19375","99  -  حَدَّثَنَا  أَحْمَدُ بْنُ سَهْلِ بْنِ أَيُّوبَ الْأَهْوَازِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ سَيْفٍ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلِ بْنِ غَزْوَانَ ،  عَنِ  السَّرِيِّ بْنِ إِسْمَاعِيلَ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَشْرَبُوا فِي  النَّقِيرِ  وَلَا  الْمُزَفَّتِ  .","","Al-Mu'jam al-Kabir 99","","النعمان بن بشير الأنصاري عن الشعبي عن السري بن إسماعيل الهمداني عن محمد بن فضيل بن غزوان عن إسماعيل بن سيف القطعي عن أحمد بن سهل بن أيوب الأهوازي عن الطبراني","باب"
"19376","100  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  شَيْبَانُ ،  عَنْ  عَاصِمٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  خَيْرُ النَّاسِ  قَرْنِي  ، ثُمَّ الَّذِينَ يَلُونَهُمْ ، ثُمَّ الَّذِينَ يَلُونَهُمْ ، ثُمَّ يَأْتِي قَوْمٌ تَسْبِقُ أَيْمَانُهُمْ شَهَادَتَهُمْ ، وَشَهَادَتُهُمْ أَيْمَانَهُمْ  .         [21/97]","","Al-Mu'jam al-Kabir 100","","النعمان بن بشير الأنصاري عن الشعبي عن عاصم بن بهدلة عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","باب"
"19377","101  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمِ بْنِ بَهْدَلَةَ ،  عَنْ  خَيْثَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  خَيْرُ هَذِهِ الْأُمَّةِ الْقَرْنُ الَّذِي بُعِثْتُ فِيهِمْ  ، ثُمَّ الَّذِينَ يَلُونَهُمْ ، ثُمَّ الَّذِينَ يَلُونَهُمْ ، ثُمَّ يَفْشُو قَوْمٌ تَسْبِقُ أَيْمَانُهُمْ شَهَادَاتِهِمْ ، وَشَهَادَاتُهُمْ أَيْمَانَهُمْ  .","","Al-Mu'jam al-Kabir 101","","النعمان بن بشير الأنصاري عن خيثمة بن عبد الرحمن الجعفي عن عاصم بن بهدلة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","خيثمة بن عبد الرحمن عن النعمان بن بشير"
"19378","102  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ الْخَشَّابُ الرَّقِّيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ الرَّقِّيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  عَاصِمِ بْنِ بَهْدَلَةَ ،  عَنْ  خَيْثَمَةَ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  خَيْرُ النَّاسِ  قَرْنِي  ، ثُمَّ الَّذِينَ يَلُونَهُمْ ، ثُمَّ الَّذِينَ يَلُونَهُمْ ، ثُمَّ يَأْتِي قَوْمٌ تَسْبِقُ أَيْمَانُهُمْ شَهَادَتَهُمْ ، وَتَسْبِقُ شَهَادَتُهُمْ أَيْمَانَهُمْ  .","","Al-Mu'jam al-Kabir 102","","النعمان بن بشير الأنصاري عن خيثمة بن عبد الرحمن الجعفي عن عاصم بن بهدلة عن زيد بن أبي أنيسة الجزري عن عبيد الله بن عمرو بن أبي الوليد عن عبد الله بن جعفر بن غيلان عن أحمد بن إسحاق البلدي عن الطبراني","خيثمة بن عبد الرحمن عن النعمان بن بشير"
"19379","103  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  زَائِدَةُ ،  عَنْ  عَاصِمٍ ،  عَنْ  خَيْثَمَةَ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  خَيْرُ النَّاسِ  قَرْنِي  ، ثُمَّ الَّذِينَ يَلُونَهُمْ ، ثُمَّ الَّذِينَ يَلُونَهُمْ ، ثُمَّ يَأْتِي قَوْمٌ تَسْبِقُ شَهَادَتُهُمْ أَيْمَانَهُمْ ، وَأَيْمَانُهُمْ شَهَادَتَهُمْ  .         [21/98]","","Al-Mu'jam al-Kabir 103","","النعمان بن بشير الأنصاري عن خيثمة بن عبد الرحمن الجعفي عن عاصم بن بهدلة عن زائدة بن قدامة عن أحمد بن عبد الله اليربوعي عن محمد بن عثمان بن أبي شيبة عن الطبراني","خيثمة بن عبد الرحمن عن النعمان بن بشير"
"19380","104  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  شَيْبَانُ ،  عَنْ  عَاصِمٍ ،  عَنْ  خَيْثَمَةَ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  خَيْرُ النَّاسِ  قَرْنِي  ، ثُمَّ الَّذِينَ يَلُونَهُمْ ، ثُمَّ الَّذِينَ يَلُونَهُمْ ، ثُمَّ يَأْتِي قَوْمٌ تَسْبِقُ أَيْمَانُهُمْ شَهَادَتَهُمْ ، وَتَسْبِقُ شَهَادَتُهُمْ أَيْمَانَهُمْ  .","","Al-Mu'jam al-Kabir 104","","النعمان بن بشير الأنصاري عن خيثمة بن عبد الرحمن الجعفي عن عاصم بن بهدلة عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","خيثمة بن عبد الرحمن عن النعمان بن بشير"
"19381","105  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  خَيْثَمَةَ ،  عَنِ  النُّعْمَانِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 105","","النعمان بن بشير الأنصاري عن خيثمة بن عبد الرحمن الجعفي عن عاصم بن بهدلة عن أبو بكر بن عياش عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","خيثمة بن عبد الرحمن عن النعمان بن بشير"
"19382","106  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  حُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  خَيْثَمَةَ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْمُسْلِمُونَ كَرَجُلٍ وَاحِدٍ  ; إِذَا         [21/99]      اشْتَكَى عَيْنُهُ اشْتَكَى كُلُّهُ ، وَإِذَا اشْتَكَى رَأْسُهُ اشْتَكَى كُلُّهُ  .","","Al-Mu'jam al-Kabir 106","","النعمان بن بشير الأنصاري عن خيثمة بن عبد الرحمن الجعفي عن الأعمش عن حميد بن عبد الرحمن الرؤاسي عن محمد بن عبد الله بن نمير عن عبيد بن غنام النخعي عن الطبراني","خيثمة بن عبد الرحمن عن النعمان بن بشير"
"19383","107  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَاضِرُ بْنُ الْمُوَرِّعِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  خَيْثَمَةَ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 107","","النعمان بن بشير الأنصاري عن خيثمة بن عبد الرحمن الجعفي عن الأعمش عن محاضر بن المورع الهمداني عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","خيثمة بن عبد الرحمن عن النعمان بن بشير"
"19384","[21/100]      108  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْعَيْزَارِ بْنِ حُرَيْثٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  اسْتَأْذَنَ  أَبُو بَكْرٍ  عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَمِعَ  عَائِشَةَ  رَافِعَةً صَوْتَهَا عَلَيْهِ ، فَقَالَ يَا ابْنَةَ  أُمِّ رُومَانَ  ، تَرْفَعِينَ صَوْتَكِ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ ! فَتَنَاوَلَهَا ، فَحَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَهُ وَبَيْنَهَا . ثُمَّ خَرَجَ  أَبُو بَكْرٍ  ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَتَرَضَّاهَا :  أَلَمْ تَرَيْنِي حُلْتُ بَيْنَ الرَّجُلِ وَبَيْنَكِ  ؟ ! "" ثُمَّ جَاءَ مَرَّةً أُخْرَى يَسْتَأْذِنُ فَسَمِعَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُضَاحِكُهَا ، فَاسْتَأْذَنَ ، فَقَالَ  أَبُو بَكْرٍ  : يَا رَسُولَ اللهِ ، أَشْرِكَانِي فِي سِلْمِكُمَا كَمَا أَشْرَكْتُمَانِي فِي حَرْبِكُمَا  !.","","Al-Mu'jam al-Kabir 108","","النعمان بن بشير الأنصاري عن العيزار بن حريث العبدي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","العيزار بن حريث عن النعمان بن بشير"
"19385","109  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ ،  ثَنَا         [21/101]      أَبُو نُعَيْمٍ ،  ثَنَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنِ  الْعَيْزَارِ بْنِ حُرَيْثٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  اسْتَأْذَنَ  أَبُو بَكْرٍ  عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَإِذَا  عَائِشَةُ  تَرْفَعُ صَوْتَهَا عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا ابْنَةَ فُلَانَةَ ، تَرْفَعِينَ صَوْتَكِ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ ! فَحَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَهُ وَبَيْنَهَا . ثُمَّ خَرَجَ  أَبُو بَكْرٍ  ، فَجَعَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَتَرَضَّاهَا ، فَقَالَ :  أَلَمْ تَرَيْنِي حُلْتُ بَيْنَ الرَّجُلِ وَبَيْنَكِ  ؟ ! "" ثُمَّ اسْتَأْذَنَ  أَبُو بَكْرٍ  مَرَّةً أُخْرَى ، فَسَمِعَهُ يُضَاحِكُهَا ، فَقَالَ  أَبُو بَكْرٍ  : أَشْرِكَانِي فِي سِلْمِكُمَا كَمَا أَشْرَكْتُمَانِي فِي حَرْبِكُمَا  ! .","","Al-Mu'jam al-Kabir 109","","النعمان بن بشير الأنصاري عن العيزار بن حريث العبدي عن يونس بن أبي إسحاق عن الفضل بن دكين عن أبو زرعة الدمشقي عن الطبراني","العيزار بن حريث عن النعمان بن بشير"
"19386","110  -  حَدَّثَنَا  أَبُو حَصِينٍ مُحَمَّدُ بْنُ الْحُسَيْنِ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْعَيْزَارِ بْنِ حُرَيْثٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  اسْتَأْذَنَ  أَبُو بَكْرٍ  عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَعِنْدَهُ  عَائِشَةُ  وَهِيَ تَقُولُ : قَدْ عَلِمْتُ وَاللهِ إِنَّهُ لَأَحَبُّ إِلَيْكَ مِنْ أَبِي  ( تَعْنِي  عَلِيًّا  )  . فَرَفَعَ  أَبُو بَكْرٍ  صَوْتَهُ عَلَيْهَا فَقَالَ : لَا أَرَاكِ تَرْفَعِينَ         [21/102]      صَوْتَكِ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ! ثُمَّ دَخَلَ إِلَيْهَا بَعْدَ ذَلِكَ وَهِيَ تَضْحَكُ مَعَهُ ، فَقَالَ :  أَشْرِكَانِي فِي سِلْمِكُمَا كَمَا أَشْرَكْتُمَانِي فِي حَرْبِكُمَا  ! .","","Al-Mu'jam al-Kabir 110","","النعمان بن بشير الأنصاري عن العيزار بن حريث العبدي عن أبو إسحاق السبيعي عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","العيزار بن حريث عن النعمان بن بشير"
"19387","[21/103]      111  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  (  ح  ) .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ، قَالَ :  سَمِعْتُ  سَالِمَ بْنَ أَبِي الْجَعْدِ ، يَقُولُ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَتُسَوُّنَّ صُفُوفَكُمْ فِي صَلَاتِكُمْ ، أَوْ  لَيُخَالِفَنَّ  بَيْنَ قُلُوبِكُمْ  ! "" .","","Al-Mu'jam al-Kabir 111","","النعمان بن بشير الأنصاري عن سالم بن أبي الجعد الغطفاني عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","سالم بن أبي الجعد عن النعمان"
"19388","[21/104]      112  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُقَوِّمُنَا فِي الصُّفُوفِ كَمَا يُقَوِّمُ بِنَا الْقِدْحَ ، يَفْعَلُ ذَلِكَ بِنَا مِرَارًا ، حَتَّى إِذَا رَأَى أَنْ قَدْ عَلِمْنَا ، تَقَدَّمَ . فَرَأَى صَدْرَ  الرَّجُلِ  خَارِجًا ، فَقَالَ :  عِبَادَ اللهِ الْمُسْلِمِينَ ! لَتُقِيمُنَّ صُفُوفَكُمْ أَوْ  لَيُخَالِفَنَّ  اللهُ بَيْنَ  وُجُوهِكُمْ  .         [21/105]","","Al-Mu'jam al-Kabir 112","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سماك بن حرب ، عن النعمان"
"19389","113  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ، قَالَا :  حَدَّثَنَا  مِسْعَرُ بْنُ كِدَامٍ ،  عَنْ  سِمَاكٍ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ ، يَقُولُ :  إِنْ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَيُسَوِّي صُفُوفَنَا فِي الصَّلَاةِ كَمَا يُسَوِّي  الْقِدَاحَ أَوِ الرِّمَاحَ  .","","Al-Mu'jam al-Kabir 113","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سماك بن حرب ، عن النعمان"
"19390","114  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  شُعْبَةُ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ ،  ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  ثَنَا  شُعْبَةُ ;  أَخْبَرَنِي  سِمَاكُ بْنُ حَرْبٍ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَخْطُبُ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُسَوِّي الصُّفُوفَ حَتَّى تَكُونَ مِثْلَ  الرُّمْحِ أَوِ الْقِدَاحِ  ، فَرَأَى صَدْرَ  رَجُلٍ  نَاتِئًا فَقَالَ :  عِبَادَ اللهِ: سَوُّوا صُفُوفَكُمْ أَوْ  لَيُخَالِفَنَّ  اللهُ بَيْنَ  وُجُوهِكُمْ  ! "" .         [21/106]","","Al-Mu'jam al-Kabir 114","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن شعبة بن الحجاج عن علي بن الجعد عن محمد بن عبدوس السراج عن الطبراني","سماك بن حرب ، عن النعمان"
"19391","115  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  سِمَاكٍ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُسَوِّي الصُّفُوفَ حَتَّى كَأَنَّمَا يُسَوِّي بِهَا الْقِدَاحَ ، فَقَامَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى إِذَا أَرَادَ أَنْ يُكَبِّرَ رَأَى  رَجُلًا  شَاخِصًا صَدْرُهُ مِنَ الصَّفِّ ، فَقَالَ :  عِبَادَ اللهِ ، لَتُسَوُّنَّ صُفُوفَكُمْ أَوْ  لَيُخَالِفَنَّ  اللهُ بَيْنَ  وُجُوهِكُمْ  ! "" .","","Al-Mu'jam al-Kabir 115","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","سماك بن حرب ، عن النعمان"
"19392","116  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  أَنَا  سِمَاكُ بْنُ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ أَنَّهُ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُسَوِّينَا فِي الصَّلَاةِ كَمَا تُقَوَّمُ الْقِدَاحُ ، حَتَّى إِذَا ظَنَّ أَنْ قَدْ أَخَذْنَا ذَلِكَ عَنْهُ وَفَهِمْنَاهُ ؛ إِذْ أَقْبَلَ عَلَيْنَا ذَاتَ يَوْمٍ بِوَجْهِهِ فَإِذَا  رَجُلٌ  مُنْتَبِذٌ بِصَدْرِهِ فَقَالَ :  لَتُسَوُّنَّ صُفُوفَكُمْ أَوْ  لَيُخَالِفَنَّ  اللهُ بَيْنَ  وُجُوهِكُمْ  ! "" .","","Al-Mu'jam al-Kabir 116","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سماك بن حرب ، عن النعمان"
"19393","117  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ الْبَصْرِيُّ ، وَأَبُو خَلِيفَةَ الْفَضْلُ         [21/107]      بْنُ الْحُبَابِ ، قَالَا :  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  زُهَيْرُ بْنُ مُعَاوِيَةَ ،  ثَنَا  سِمَاكٌ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُسَوِّي صُفُوفَنَا كَأَنَّمَا يُسَوِّي بِهَا الْقِدَاحَ ، حَتَّى يَرَى أَنَّا قَدْ عَقَلْنَا عَنْهُ ، ثُمَّ خَرَجَ يَوْمًا فَقَامَ حَتَّى كَادَ أَنْ يُكَبِّرَ ، فَرَأَى  رَجُلًا  خَارِجًا صَدْرُهُ مِنَ الصَّفِّ فَقَالَ :  عِبَادَ اللهِ ، لَتُسَوُّنَّ صُفُوفَكُمْ أَوْ  لَيُخَالِفَنَّ  اللهُ بَيْنَ  وُجُوهِكُمْ  ! "" .","","Al-Mu'jam al-Kabir 117","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن زهير بن معاوية بن حديج عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","سماك بن حرب ، عن النعمان"
"19394","118  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْحِنَّائِيُّ  ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  ثَنَا  أَبِي  ،  ثَنَا  أَبُو يُونُسَ ،  عَنْ  سِمَاكٍ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَخْطُبُ وَهُوَ عَلَى  الْكُوفَةِ  ، وَكَانَ مِنْ أَخْطَبِ النَّاسِ -         [21/108]      فَقَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُسَوِّي صُفُوفَنَا ، فَإِذَا اسْتَوَى كَبَّرَ . يُسَوِّي صُفُوفَنَا حَتَّى إِذَا ظَنَّ أَنْ قَدِ اسْتَوَيْنَا ، حَانَتْ مِنْهُ الْتِفَاتَةٌ ، فَإِذَا  رَجُلٌ  بَيْنَ يَدَيِ الصَّفِّ ، فَقَالَ :  لَتُسَوُّنَّ صُفُوفَكُمْ أَوْ  لَيُخَالِفَنَّ  اللهُ بَيْنَ  وُجُوهِكُمْ  ! "" .  كذا في طبعة الجريسي ولعل ثمة قلب في الاسم ، وصوابه : (يحيى بن محمد).","","Al-Mu'jam al-Kabir 118","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن حاتم بن أبي صغيرة القشيري عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن يحيى بن محمد بن البختري الحنائي عن الطبراني","سماك بن حرب ، عن النعمان"
"19395","119  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  عَنْ  حَسَنِ بْنِ صَالِحٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُسَوِّي الصُّفُوفَ فِي الصَّلَاةِ كَمَا تُسَوَّى الْقِدَاحُ  .","","Al-Mu'jam al-Kabir 119","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن الحسن بن صالح بن صالح بن حي عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","سماك بن حرب ، عن النعمان"
"19396","120  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ .  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  رَأَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَإِنَّهُ لَيُقَوِّمُ الصُّفُوفَ كَمَا تُقَوَّمُ الْقِدَاحُ ، فَأَبْصَرَ صَدْرَ  رَجُلٍ         [21/109]      خَارِجًا مِنَ الصَّفِّ ، فَقَالَ :  لَتُقِيمُنَّ صُدُورَكُمْ أَوْ  لَيُخَالِفَنَّ  اللهُ بَيْنَ  وُجُوهِكُمْ  ! "" .","","Al-Mu'jam al-Kabir 120","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","سماك بن حرب ، عن النعمان"
"19397","121  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُحَمَّدُ بْنُ سَعِيدٍ الْأَصْبَهَانِيُّ (  ح  ) .  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ، قَالَ :  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  وَاللهِ ، لَلَّهُ أَفْرَحُ بِتَوْبَةِ الْعَبْدِ مِنْ رَجُلٍ كَانَ فِي سَفَرٍ  ، وَمَعَهُ رَاحِلَةٌ عَلَيْهَا مَتَاعُهُ وَزَادُهُ ، وَطَعَامُهُ وَشَرَابُهُ ، فَنَزَلَ فِي ظِلِّ شَجَرَةٍ ، وَعَقَلَ رَاحِلَتَهُ ، فَغَلَبَهُ النَّوْمُ ، فَاسْتَيْقَظَ وَقَدْ ذَهَبَتْ رَاحِلَتُهُ ، فَقَامَ فَطَلَبَهَا ، فَأَشْرَفَ شَرَفًا فَلَمْ يَرَ شَيْئًا ، ثُمَّ أَشْرَفَ شَرَفًا فَلَمْ يَرَ شَيْئًا ، فَقَالَ : وَاللهِ لَأَرْجِعَنَّ إِلَى الْمَكَانِ الَّذِي كُنْتُ فِيهِ ، فَلَأَقِيلَنَّ فِيهِ حَتَّى أَمُوتَ ، فَرَجَعَ فَنَامَ ، ثُمَّ اسْتَيْقَظَ ، فَرَفَعَ رَأْسَهُ فَإِذَا هُوَ بِرَاحِلَتِهِ تَجُرُّ خِطَامَهَا ، فَاللهُ أَشَدُّ  فَرَحًا  بِتَوْبَةِ عَبْدِهِ مِنْ ذَاكَ بِنَاقَتِهِ  .","","Al-Mu'jam al-Kabir 121","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","سماك بن حرب ، عن النعمان"
"19398","122  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  حَدَّثَنَا         [21/110]      مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَخْطُبُ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أُنْذِرُكُمُ النَّارَ أُنْذِرُكُمُ النَّارَ  ! "" حَتَّى لَوْ أَنَّ رَجُلًا كَانَ بِالسُّوقِ لَسَمِعَهُ مِنْ مَقَامِي هَذَا ، حَتَّى وَقَعَتْ  خَمِيصَةٌ  كَانَتْ عَلَى عَاتِقِهِ عِنْدَ رِجْلَيْهِ  .","","Al-Mu'jam al-Kabir 122","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سماك بن حرب ، عن النعمان"
"19399","123  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ (  ح  ) .  وَحَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  دَاوُدُ بْنُ عَمْرٍو الضَّبِّيُّ (  ح  ) .  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالُوا :  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكٍ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ وَهُوَ عَلَى مِنْبَرِ  الْكُوفَةِ  ، وَهُوَ يَقُولُ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ عَلَى الْمِنْبَرِ يَقُولُ :  يَا أَيُّهَا النَّاسُ ! أُحَذِّرُكُمُ النَّارَ  ! "" حَتَّى لَوْ كَانَ فِي مَكَانِي هَذَا لَأَسْمَعَ أَهْلَ السُّوقِ ، أَوْ مَنْ شَاءَ اللهُ أَنْ يَسْمَعَ  .         [21/111]","","Al-Mu'jam al-Kabir 123","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","سماك بن حرب ، عن النعمان"
"19400","124  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  خَلَفُ بْنُ الْوَلِيدِ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ عَلَى الْمِنْبَرِ :  أُنْذِرُكُمُ النَّارَ  ! "" حَتَّى لَوْ كَانَ أَحَدٌ فِي أَقْصَى السُّوقِ لَسَمِعَهُ  .","","Al-Mu'jam al-Kabir 124","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن خلف بن الوليد الجوهري عن بشر بن موسى بن صالح الأسدي عن الطبراني","سماك بن حرب ، عن النعمان"
"19401","125  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ،  ثَنَا  يُوسُفُ بْنُ عَدِيٍّ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُؤَخِّرُ عِشَاءَ الْآخِرَةِ  .","","Al-Mu'jam al-Kabir 125","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن يوسف بن عدي بن رزق الكوفي عن روح بن الفرج القطان عن الطبراني","سماك بن حرب ، عن النعمان"
"19402","126  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ  بْنِ خَالِدٍ الْحَرَّانِيُّ  ثَنَا  أَبِي  ، قَالَا :  ثَنَا  زُهَيْرٌ ،  ثَنَا  سِمَاكُ بْنُ حَرْبٍ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ :  وَاللهِ         [21/112]      مَا كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَشْبَعُ مِنَ  الدَّقَلِ  ، وَمَا تَرْضَوْنَ دُونَ أَلْوَانِ التَّمْرِ وَالزُّبْدِ وَأَلْوَانِ الثِّيَابِ  ! .  كذا في طبعة الجريسي وهو تصحيف ، والصواب : (بن عمرو) .","","Al-Mu'jam al-Kabir 126","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","سماك بن حرب ، عن النعمان"
"19403","127  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ ، وَذَكَرَ مَا أَصَابَ النَّاسَ مِنَ الدُّنْيَا ، فَقَالَ :  لَقَدْ رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَظَلُّ الْيَوْمَ وَمَا يَجِدُ طَعَامًا يَمْلَأُ بَطْنَهُ  ! .","","Al-Mu'jam al-Kabir 127","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سماك بن حرب ، عن النعمان"
"19404","128  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ (  ح  ) .         [21/113]      ،  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ يَقُولُ :  أَلَسْتُمْ فِي طَعَامٍ وَشَرَابٍ مَا شِئْتُمْ ؟  لَقَدْ رَأَيْتُ نَبِيَّكُمْ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَمَا يَجِدُ مِنَ  الدَّقَلِ  مَا يَمْلَأُ بَطْنَهُ  .","","Al-Mu'jam al-Kabir 128","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","سماك بن حرب ، عن النعمان"
"19405","129  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ، وَمُحَمَّدُ بْنُ حِسَابٍ ، قَالَا :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ، عَنِ النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  سَمِعْتُهُ  عَلَى الْمِنْبَرِ يَقُولُ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَا يَجِدُ مِنَ  الدَّقَلِ  مَا يَمْلَأُ بَطْنَهُ مِنَ الْجُوعِ  .","","Al-Mu'jam al-Kabir 129","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن محمد بن عبيد بن حساب الغبري عن عبد الله بن أحمد بن حنبل عن الطبراني","سماك بن حرب ، عن النعمان"
"19406","130  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  حَمَّادُ         [21/114]      بْنُ سَلَمَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْمُؤْمِنُونَ مِثْلُ الْجَسَدِ ; إِذَا اشْتَكَى بَعْضُهُ  تَدَاعَى  سَائِرُهُ  .","","Al-Mu'jam al-Kabir 130","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن حماد بن سلمة عن سليمان بن حرب الواشحي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سماك بن حرب ، عن النعمان"
"19407","131  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْحَسَنِ ،  عَنِ  الْحُسَيْنِ بْنِ وَاقِدٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَثَلُ الْمُؤْمِنِينَ مَثَلُ رَجُلٍ وَاحِدٍ  ; إِذَا اشْتَكَى شَيْئًا مِنْ جَسَدِهِ  تَدَاعَى  لَهُ سَائِرُهُ  .","","Al-Mu'jam al-Kabir 131","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن الحسين بن واقد المروزي عن محمد بن علي بن الحسن بن شقيق المطوعي عن عبد الله بن أحمد بن حنبل عن الطبراني","سماك بن حرب ، عن النعمان"
"19408","132  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ  فِي قَوْلِهِ :         {      وَلا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ         }      قَالَ :  كَانَ الرَّجُلُ يُذْنِبُ الذَّنْبَ فَيَقُولُ : لَا يُغْفَرُ لِي  . فَأَنْزَلَ اللهُ :         {      وَلا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ وَأَحْسِنُوا إِنَّ اللهَ يُحِبُّ الْمُحْسِنِينَ         }      .","","Al-Mu'jam al-Kabir 132","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن حماد بن سلمة عن هدبة بن خالد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","سماك بن حرب ، عن النعمان"
"19409","133  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  حَدَّثَنِي  حُسَيْنُ بْنُ وَاقِدٍ ،  حَدَّثَنِي  سِمَاكُ بْنُ حَرْبٍ ،  عَنِ         [21/115]      النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ اللهَ وَمَلَائِكَتَهُ يُصَلُّونَ عَلَى  الصَّفِّ الْأَوَّلِ "" أَوْ قَالَ : "" الصُّفُوفِ الْأُوَلِ  .","","Al-Mu'jam al-Kabir 133","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن الحسين بن واقد المروزي عن زيد بن الحباب العكلي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سماك بن حرب ، عن النعمان"
"19410","134  -  وَبِإِسْنَادِهِ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ مَنَحَ  مِنْحَةَ  وَرِقٍ  أَوْ ذَهَبٍ أَوْ سَقَى لَبَنًا ، أَوْ  هَدَى  زُقَاقًا ،  فَهُوَ  كَعِدْلِ         [21/116]      رَقَبَةٍ  .","","Al-Mu'jam al-Kabir 134","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن الحسين بن واقد المروزي عن زيد بن الحباب العكلي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سماك بن حرب ، عن النعمان"
"19411","135  -  حَدَّثَنَا  أَحْمَدُ بْنُ شُعَيْبٍ النَّسَائِيُّ ،  ثَنَا  الْحُسَيْنُ بْنُ عِيسَى ،  ثَنَا  عَفَّانُ بْنُ سَيَّارٍ ،  عَنْ  عَنْبَسَةَ بْنِ الْأَزْهَرِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي مَسِيرٍ ، فَخَفَقَ  رَجُلٌ  عَلَى رَاحِلَتِهِ ، فَأَخَذَ  رَجُلٌ  سَهْمًا مِنْ كِنَانَتِهِ ، فَانْتَبَهَ الرَّجُلُ فَفَزِعَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَحِلُّ لِرَجُلٍ أَنْ يُرَوِّعَ مُسْلِمًا  .","","Al-Mu'jam al-Kabir 135","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن عنبسة بن الأزهر الشيباني عن عفان بن سيار الجرجاني عن الحسين بن عيسى البسطامي عن النسائي عن الطبراني","سماك بن حرب ، عن النعمان"
"19412","136  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  طَاهِرُ بْنُ أَبِي أَحْمَدَ الزُّبَيْرِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  عَبْدُ اللهِ بْنُ الْحُسَيْنِ أَبُو مَالِكٍ النَّخَعِيُّ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ         [21/117]      فِي الْعِيدَيْنِ بِـ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      ،         {      وَالشَّمْسِ وَضُحَاهَا         }      .","","Al-Mu'jam al-Kabir 136","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن عبد الله بن الحسين أبو مالك النخعي عن محمد بن عبد الله بن الزبير عن طاهر بن أبى أحمد الزبيري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","سماك بن حرب ، عن النعمان"
"19413","137  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  جُبَارَةُ بْنُ مُغَلِّسٍ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَثَلُ الْمُجَاهِدِ فِي  سَبِيلِ  اللهِ مَثَلُ الصَّائِمِ نَهَارَهُ الْقَائِمِ لَيْلَهُ حَتَّى يَرْجِعَ مَتَى رَجَعَ  .","","Al-Mu'jam al-Kabir 137","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن جبارة بن المغلس عن محمد بن عبد الله مطين الحضرمي عن الطبراني","سماك بن حرب ، عن النعمان"
"19414","138  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  حُسَيْنُ بْنُ عَلِيٍّ ،  عَنْ  زَائِدَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اتَّقُوا النَّارَ ! وَلَوْ  بِشِقِّ  تَمْرَةٍ  .","","Al-Mu'jam al-Kabir 138","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن زائدة بن قدامة عن الحسين بن علي الجعفي عن عبد الله بن عمر مشكدانة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","سماك بن حرب ، عن النعمان"
"19415","139  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ، وَيَحْيَى بْنُ عَبْدِ الْبَاقِي الْأَذَنِيُّ ،         [21/118]      وَالْحَسَنُ بْنُ جَرِيرٍ الصُّورِيُّ ، قَالُوا :  ثَنَا  هَارُونُ بْنُ زَيْدِ بْنِ أَبِي الزَّرْقَاءِ ،  ثَنَا  أَبِي  ،  ثَنَا  أَبُو حَمَّادٍ الْكُوفِيُّ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا قَالَ : ""  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ "" لَمْ  يَحْنِ  أَحَدٌ مِنَّا ظَهْرَهُ حَتَّى يَرَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَاجِدًا  .","","Al-Mu'jam al-Kabir 139","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن المفضل بن صدقة الحنفي عن زيد بن أبي الزرقاء التغلبي عن هارون بن زيد بن أبي الزرقاء عن عبد الله بن أحمد الجواليقي عن الطبراني","سماك بن حرب ، عن النعمان"
"19416","140  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خَالِدٍ الرَّاسِبِيُّ ،  ثَنَا  مُهَلَّبُ بْنُ الْعَلَاءِ ،  ثَنَا  شُعَيْبُ بْنُ بَيَانٍ الصَّفَّارُ ،  ثَنَا  شُعْبَةُ ، قَالَ :  سَمِعْتُ  سِمَاكَ بْنَ حَرْبٍ يَقُولُ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ مَثَلَ الْأُمَرَاءِ وَمَثَلَ النَّاسِ كَمَثَلِ قَوْمٍ رَكِبُوا سَفِينَةً  ، فَأَرَادَ أَحَدُهُمْ أَنْ يَخْرِقَهَا ، فَإِنْ  أَخَذُوا  عَلَى يَدَيْهِ نَجَا وَنَجَوْا ، وَإِنْ تَرَكُوهُ هَلَكَ وَهَلَكُوا  .","","Al-Mu'jam al-Kabir 140","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن شعبة بن الحجاج عن شعيب بن بيان الصفار عن مهلب بن العلاء عن محمد بن خالد الراسبي عن الطبراني","سماك بن حرب ، عن النعمان"
"19417","141  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خَالِدٍ الرَّاسِبِيُّ ،  ثَنَا  مُهَلَّبُ بْنُ الْعَلَاءِ ،  ثَنَا  شُعَيْبُ بْنُ بَيَانٍ ،  ثَنَا  شُعْبَةُ ، قَالَ :  سَمِعْتُ  سِمَاكًا يَقُولُ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  اسْتَقِيمُوا  لِقُرَيْشٍ  مَا  اسْتَقَامُوا  لَكُمْ  ، فَإِنْ لَمْ يَسْتَقِيمُوا لَكُمْ فَضَعُوا سُيُوفَكُمْ عَلَى عَوَاتِقِكُمْ فَأَبِيدُوا خَضْرَاءَهُمْ  .         [21/119]","","Al-Mu'jam al-Kabir 141","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن شعبة بن الحجاج عن شعيب بن بيان الصفار عن مهلب بن العلاء عن محمد بن خالد الراسبي عن الطبراني","سماك بن حرب ، عن النعمان"
"19418","142  -  حَدَّثَنَا  عَبْدَانُ بْنُ مُحَمَّدٍ الْمَرْوَزِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  ثَنَا  النَّضْرُ بْنُ شُمَيْلٍ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُقَاتِلٍ الْمَرْوَزِيُّ (  ح  ) .  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَحْمَدُ بْنُ جَمِيلٍ الْمَرْوَزِيُّ ، قَالَا :  ثَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَا مِنْ عَبْدٍ وَلَا أَمَةٍ إِلَّا وَلَهُ ثَلَاثَةُ أَخِلَّاءٍ  :  فَخَلِيلٌ  يَقُولُ : أَنَا مَعَكَ فَخُذْ مِنِّي مَا شِئْتَ ; فَذَاكَ مَالُهُ .  وَخَلِيلٌ  يَقُولُ : أَنَا مَعَكَ فَإِذَا أَتَيْتَ بَابَ الْمَلِكِ تَرَكْتُكَ ; فَذَاكَ خَدَمُهُ وَأَهْلُهُ .  وَخَلِيلٌ  يَقُولُ : أَنَا مَعَكَ حَيْثُ دَخَلْتَ وَحَيْثُ خَرَجْتَ ; فَذَاكَ عَمَلُهُ  .","","Al-Mu'jam al-Kabir 142","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن حماد بن سلمة عن النضر بن شميل عن أحمد بن جميل المروزي عن عبد الله بن أحمد بن حنبل عن الطبراني","سماك بن حرب ، عن النعمان"
"19419","143  - ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ مِثْلَهُ ، وَلَمْ يَرْفَعْهُ .","","Al-Mu'jam al-Kabir 143","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن حماد بن سلمة عن هدبة بن خالد عن عبد الله بن أحمد بن حنبل عن الطبراني","سماك بن حرب ، عن النعمان"
"19420","144  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي         [21/120]      شَيْبَةَ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ; مِثْلَهُ ، وَلَمْ  يَرْفَعْهُ  .","","Al-Mu'jam al-Kabir 144","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن أبو بكر ابن أبي شيبة عن عبد الله بن أحمد بن حنبل عن الطبراني","سماك بن حرب ، عن النعمان"
"19421","145  -  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ التُّسْتَرِيُّ ،  ثَنَا  عَلِيُّ بْنُ حَرْبٍ الْمَوْصِلِيُّ ،  ثَنَا  أَبُو مَسْعُودٍ الزَّجَّاجُ ،  ثَنَا  أَبُو سَعْدٍ الْبَقَّالُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ نَفَرًا ثَلَاثَةً خَرَجُوا  .... "" ، فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 145","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن سعيد بن المرزبان عن عبد الرحمن بن الحسن الموصلي عن علي بن حرب الطائي عن سعيد بن عبد الرحمن التستري عن الطبراني","سماك بن حرب ، عن النعمان"
"19422","146  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ صَدَقَةَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ بِسْطَامٍ الزَّعْفَرَانِيُّ ،  ثَنَا  مُؤَمَّلُ بْنُ إِسْمَاعِيلَ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ حَبِيبٍ الطَّرَائِفِيُّ الرَّقِّيُّ ،  ثَنَا  أَيُّوبُ بْنُ مُحَمَّدٍ الْوَزَّانُ ،  ثَنَا  يَحْيَى بْنُ السَّكَنِ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  انْطَلَقَ ثَلَاثَةُ نَفَرٍ يَرْتَادُونَ لِأَهْلِيهِمْ  ، فَأَصَابَهُمُ السَّمَاءُ ، فَلَجَؤُوا إِلَى غَارٍ ،         [21/121]      فَوَقَعَ عَلَيْهِمْ حَجَرٌ مُتَحَامِلٌ حَتَّى مَا يَرَوْنَ مِنْهُ خَصَاصًا ، فَقَالَ بَعْضُهُمْ لِبَعْضٍ : قَدْ وَقَعَ الْحَجَرُ ،  وَعَفَا  الْأَثَرُ ، وَلَا يَعْلَمُ بِمَكَانِكُمْ هَاهُنَا إِلَّا اللهُ ، فَلْيَدْعُ كُلُّ وَاحِدٍ مِنْكُمْ بِأَحْسَنِ عَمَلِهِ ; فَقَالَ رَجُلٌ مِنْهُمْ : اللَّهُمَّ إِنْ كُنْتَ تَعْلَمُ أَنَّهُ كَانَ لِي أَبَوَانِ ، فَكُنْتُ أَحْلُبُ لَهُمَا فِي إِنَائِهِمَا ثُمَّ         [21/122]      آتِيهِمَا ، فَإِذَا وَجَدْتُهُمَا رَاقِدَيْنِ فَرِقْتُ أَنْ أُوقِظَهُمَا فَيَكْثُرُ  وَسَنُهُمَا  فِي رُؤُوسِهِمَا ، وَصِبْيَانِي يَقُولُونَ : اسْقِنَا اسْقِنَا . فَلَا أَزَالُ قَائِمًا حَتَّى يَسْتَيْقِظَا . اللَّهُمَّ إِنْ كُنْتَ تَعْلَمُ أَنِّي فَعَلْتُ ذَلِكَ رَجَاءَ رَحْمَتِكَ وَخَشْيَةَ عَذَابِكَ ، فَافْرُجْ عَنَّا . فَزَالَ الْحَجَرُ . وَقَالَ الْآخَرُ : اللَّهُمَّ إِنْ كُنْتَ تَعْلَمُ أَنَّ أَبِي تَرَكَ مَالًا ، وَأَنَّ أَخِي  .... "" فَذَكَرَ الْحَدِيثَ بِطُولِهِ .","","Al-Mu'jam al-Kabir 146","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن حماد بن سلمة عن يحيى بن السكن البصري عن أيوب بن محمد الوزان عن محمد بن علي بن حبيب الطرائفي الرقي عن الطبراني","سماك بن حرب ، عن النعمان"
"19423","147  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ زُنْبُورٍ ،  ثَنَا  مُحَمَّدُ بْنُ جَابِرٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ فِي الْإِنْسَانِ  مُضْغَةً  ; إِذَا صَلَحَتْ صَلَحَ سَائِرُ الْجَسَدِ ، وَإِذَا فَسَدَتْ فَسَدَ سَائِرُ الْجَسَدِ ; وَهِيَ الْقَلْبُ  .","","Al-Mu'jam al-Kabir 147","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن محمد بن جابر بن سيار عن محمد بن زنبور الهاشمي عن الحسين بن إسحاق التستري عن الطبراني","سماك بن حرب ، عن النعمان"
"19424","148  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ، قَالَ :  ثَنَا  جَنْدَلُ بْنُ وَالِقٍ ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ         [21/123]      بَشِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ بَيْنَ يَدَيِ السَّاعَةِ كَذَّابِينَ  .","","Al-Mu'jam al-Kabir 148","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن جندل بن والق التغلبي عن محمد بن عثمان بن أبي شيبة عن الطبراني","سماك بن حرب ، عن النعمان"
"19425","149  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ السَّرَّاجُ ،  ثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ نِيزَكَ ،  ثَنَا  الْأَسْوَدُ بْنُ عَامِرٍ شَاذَانُ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَسَارَّهُ ، فَقَالَ : "" قُلْ لَهُمْ يَقْتُلُونَهُ "" . فَلَمَّا مَضَى الرَّجُلُ ، قَالَ : "" عَلَيَّ بِهِ "" ، فَقَالَ : "" لَعَلَّهُ يَقُولُ : لَا إِلَهَ إِلَّا اللهُ ؟ ! "" قَالَ : نَعَمْ ، قَالَ : "" فَلَا تَقْتُلُوهُ ،  فَإِنِّي أُمِرْتُ أَنْ أُقَاتِلَ النَّاسَ حَتَّى يَقُولُوا : لَا إِلَهَ إِلَّا اللهُ  ، فَإِذَا قَالُوهَا حَرُمَتْ عَلَيَّ دِمَاؤُهُمْ وَأَمْوَالُهُمْ إِلَّا بِحَقِّهَا ، وَحِسَابُهُمْ عَلَى اللهِ  .","","Al-Mu'jam al-Kabir 149","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن الأسود بن عامر شاذان عن أحمد بن محمد بن نيزك الطوسي عن محمد بن عبدوس السراج عن الطبراني","سماك بن حرب ، عن النعمان"
"19426","[21/124]      150  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ،  ثَنَا  أَبُو عَامِرٍ الْأَسَدِيُّ ،  ثَنَا  مُوسَى بْنُ عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ مَثَلَ الْمُؤْمِنِينَ فِي تَوَادِّهِمْ وَتَرَاحُمِهِمْ ، كَمَثَلِ الْجَسَدِ  ، إِذَا اشْتَكَى بَعْضُهُ  تَدَاعَى  كُلُّهُ بِالسَّهَرِ وَالْحُمَّى  .","","Al-Mu'jam al-Kabir 150","","النعمان بن بشير الأنصاري عن عبد الملك بن عمير القبطي عن موسى بن عبد الملك القبطي عن القاسم بن محمد الأسدي عن منجاب بن الحارث التميمي عن محمد بن عثمان بن أبي شيبة عن الطبراني","عبد الملك بن عمير عن النعمان بن بشير"
"19427","151  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  جَعْفَرُ بْنُ حُمَيْدٍ ،  ثَنَا  الْوَلِيدُ بْنُ أَبِي ثَوْرٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ; أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَثَلُ الْمُؤْمِنِينَ فِي تَوَاصُلِهِمْ وَتَرَاحُمِهِمْ وَمَا جَعَلَ اللهُ بَيْنَهُمْ ، كَمَثَلِ الْجَسَدِ  ; إِذَا وَجِعَ بَعْضُهُ وَجِعَ كُلُّهُ بِالسَّهَرِ وَالْحُمَّى  .         [21/125]","","Al-Mu'jam al-Kabir 151","","النعمان بن بشير الأنصاري عن عبد الملك بن عمير القبطي عن الوليد بن عبد الله بن أبي ثور المرهبي عن جعفر بن حميد زنبقة عن عبد الله بن أحمد الجواليقي عن الطبراني","عبد الملك بن عمير عن النعمان بن بشير"
"19428","""  152  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ بْنِ الْبُسْتَنْبَانِ ،  ثَنَا  الْحَسَنُ بْنُ بِشْرٍ الْبَجَلِيُّ ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  عَبْدُ الْمَلِكِ بْنُ عُمَيْرٍ ، قَالَ :  خَطَبَنَا  النُّعْمَانُ بْنُ بَشِيرٍ فَقَالَ :  إِنَّ اللهَ جَعَلَ حَلَالًا بَيِّنًا وَحَرَامًا بَيِّنًا  ، وَبَيْنَ ذَلِكَ أُمُورٌ مُشْتَبِهَاتٌ ، فَمَنْ تَرَكَهُنَّ فَقَدِ اسْتَبْرَأَ لِدِينِهِ  وَعِرْضِهِ  ، وَمَنْ رَكِبَهُنَّ  يُوشِكُ  أَنْ يَقَعَ فِي الْحَرَامِ "" . ثُمَّ ضَرَبَ لَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَثَلًا ، فَقَالَ : "" مَنْ  يَرْتَعُ  حَوْلَ الْحِمَى  يُوشِكُ  أَنْ يَقَعَ فِيهِ ، وَلِكُلِّ مَلِكٍ حِمًى ، وَحِمَى اللهِ مَحَارِمُهُ  .","","Al-Mu'jam al-Kabir 152","","النعمان بن بشير الأنصاري عن عبد الملك بن عمير القبطي عن زهير بن معاوية بن حديج عن الحسن بن بشر الكاهلي عن أبو جعفر ابن البستنبان السامري عن الطبراني","عبد الملك بن عمير عن النعمان بن بشير"
"19429","153  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  سَهْلُ بْنُ سِنَانٍ النَّهَرَتِيرِيُّ ،  ثَنَا  عُمَرُ بْنُ شَبِيبٍ الْمُسْلِيُّ ،  عَنْ  عَمْرِو بْنِ قَيْسٍ الْمُلَائِيِّ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ -  قَالَ أَبُو حَفْصٍ :  وَسَمِعْتُهُ  مِنْ عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ  -  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ الْأَنْصَارِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْحَلَالُ بَيِّنٌ ، وَالْحَرَامُ بَيِّنٌ  ، وَبَيْنَهُمَا مُشْتَبِهَاتٌ ، فَمَنْ تَرَكَهُنَّ كَانَ أَشَدَّ اسْتِبْرَاءً لِعِرْضِهِ وَدِينِهِ ، وَمَنْ رَكِبَهُنَّ أَوْشَكَ أَنْ يَرْكَبَ الْحَرَامَ ; كَالْمُرْتِعِ إِلَى جَنْبِ الْحِمَى  يُوشِكُ  أَنْ  يَرْتَعَ  فِيهِ ، وَإِنَّ لِكُلِّ مَلِكٍ حِمًى ، وَإِنَّ حِمَى اللهِ مَحَارِمُهُ  .","","Al-Mu'jam al-Kabir 153","","النعمان بن بشير الأنصاري عن عبد الملك بن عمير القبطي عن عمرو بن قيس الملائي عن عمر بن شبيب بن عمر المذحجي عن سهل بن سنان النهرتيري عن عبد الله بن أحمد الجواليقي عن الطبراني","عبد الملك بن عمير عن النعمان بن بشير"
"19430","[21/126]      154  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ أَهْوَنَ أَهْلِ النَّارِ عَذَابًا يَوْمَ الْقِيَامَةِ ، رَجُلٌ فِي أَخْمَصِ قَدَمَيْهِ جَمْرَتَانِ  يَغْلِي مِنْهُمَا دِمَاغُهُ ، كَمَا يَغْلِي  الْمِرْجَلُ  أَوِ  الْقُمْقُمُ  .         [21/127]","","Al-Mu'jam al-Kabir 154","","النعمان بن بشير الأنصاري عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","أبو إسحاق السبيعي عن النعمان"
"19431","155  -  حَدَّثَنَا  دَارَانُ بْنُ سُفْيَانَ الْقَطَّانُ الْبَصْرِيُّ ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ أَهْوَنَ أَهْلِ النَّارِ عَذَابًا لَمَنْ فِي أَخْمَصِ قَدَمَيْهِ جَمْرَتَانِ يَغْلِي مِنْهُمَا دِمَاغُهُ  .","","Al-Mu'jam al-Kabir 155","","النعمان بن بشير الأنصاري عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن محمد بن معاذ بن سفيان العنزي عن الطبراني","أبو إسحاق السبيعي عن النعمان"
"19432","156  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ أَهْوَنَ أَهْلِ النَّارِ عَذَابًا يَوْمَ الْقِيَامَةِ لَمَنْ لَهُ نَعْلَانِ وَشِرَاكَانِ مِنْ نَارٍ  ، يَغْلِي دِمَاغُهُ مِنْهُمَا كَمَا يَغْلِي  الْمِرْجَلُ  ، لَا يَرَى أَنَّ أَحَدًا مِنْ أَهْلِ النَّارِ أَشَدُّ عَذَابًا مِنْهُ ، وَإِنَّهُ أَهْوَنُهُمْ عَذَابًا  .","","Al-Mu'jam al-Kabir 156","","النعمان بن بشير الأنصاري عن أبو إسحاق السبيعي عن الأعمش عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو إسحاق السبيعي عن النعمان"
"19433","157  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْفَسَوِيُّ ،  ثَنَا  نَصْرُ بْنُ الْحَرِيشِ         [21/128]      الصَّامِتُ ،  ثَنَا  رَوْحُ بْنُ مُسَافِرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ أَهْوَنَ أَهْلِ النَّارِ عَذَابًا يَوْمَ الْقِيَامَةِ رَجُلٌ لَهُ نَعْلَانِ مِنْ نَارٍ  ، يَغْلِي مِنْهُمَا دِمَاغُهُ  .","","Al-Mu'jam al-Kabir 157","","النعمان بن بشير الأنصاري عن أبو إسحاق السبيعي عن روح بن مسافر البصري عن نصر بن حريش الصامت عن الحسن بن علي بن الوليد الفسوي عن الطبراني","أبو إسحاق السبيعي عن النعمان"
"19434","158  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  تَمِيمُ بْنُ الْمُنْتَصِرِ ،  ثَنَا  إِسْحَاقُ الْأَزْرَقُ ،  عَنْ  شَرِيكٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ،  عَنِ  النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ أَهْوَنَ أَهْلِ النَّارِ عَذَابًا رَجُلٌ لَهُ نَعْلَانِ مِنْ نَارٍ ، يَغْلِي مِنْهُمَا دِمَاغُهُ  .","","Al-Mu'jam al-Kabir 158","","النعمان بن بشير الأنصاري عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن إسحاق بن يوسف الأزرق عن تميم بن المنتصر مولى ابن عباس عن محمود بن محمد بن منويه المفيد عن الطبراني","أبو إسحاق السبيعي عن النعمان"
"19435","[21/129]      159  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي عُبَيْدَةَ ،  ثَنَا  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ شُرَحْبِيلَ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كَانَ ثَلَاثَةُ نَفَرٍ يَمْشُونَ فِي غِبِّ السَّمَاءِ إِذْ مَرُّوا بِغَارٍ  فَقَالُوا : لَوْ أَوَيْتُمْ إِلَى هَذَا الْغَارِ . فَأَوَوْا إِلَيْهِ ، فَبَيْنَمَا هُمْ فِيهِ إِذْ وَقَعَ حَجَرٌ مِنَ الْجَبَلِ مِمَّا يَهْبِطُ مِنْ خَشْيَةِ اللهِ ، حَتَّى سَدَّ الْغَارَ ، فَقَالَ بَعْضُهُمْ لِبَعْضٍ : إِنَّكُمْ لَنْ تَجِدُوا شَيْئًا خَيْرًا مِنْ أَنْ يَدْعُوَ كُلُّ امْرِئٍ مِنْكُمْ بِخَيْرِ عَمَلٍ عَمِلَهُ قَطُّ ، فَقَالَ أَحَدُهُمُ : اللَّهُمَّ ، كُنْتُ رَجُلًا زَرَّاعًا وَكَانَ لِي أُجَرَاءُ ، فَكَانَ فِيهِمْ رَجُلٌ يَعْمَلُ عَمَلَ رَجُلَيْنِ ، فَأَعْطَيْتُهُ أَجْرَهُ كَمَا أَعْطَيْتَ الْأُجَرَاءَ ، فَقَالَ : أَعْمَلُ عَمَلَ رَجُلَيْنِ وَتُعْطِينِي عَمَلَ رَجُلٍ         [21/130]      وَاحِدٍ ؟ ! فَانْطَلَقَ فَغَضِبَ وَتَرَكَ أَجْرَهُ عِنْدِي ، فَبَذَرْتُهُ عَلَى  حِدَتِهِ  فَأَضْعَفَ ، ثُمَّ بَذَرْتُهُ فَأَضْعَفَ ، حَتَّى كَثُرَ الطَّعَامُ ، فَكَانَ أَكْدَاسًا ، فَاحْتَاجَ الرَّجُلُ فَأَتَانِي يَسْأَلُنِي أَجْرَهُ : فَقُلْتُ : انْطَلِقْ إِلَى تِلْكَ الْأَكْدَاسِ ; فَإِنَّهَا أَجْرُكَ . فَقَالَ : تَظْلِمُنِي وَتَسْخَرُ بِي ؟ ! قُلْتُ : مَا أَسْخَرُ بِكَ . فَانْطَلَقَ فَأَخَذَهَا . اللَّهُمَّ إِنْ كُنْتَ تَعْلَمُ أَنِّي فَعَلْتُ ذَلِكَ مِنْ خَشْيَتِكَ وَابْتِغَاءَ وَجْهِكَ ، فَاكْشِفْ عَنَّا . فَقَالَ الْحَجَرُ : قِضْ . فَأَبْصَرُوا الضَّوْءَ .  فَقَالَ الْآخَرُ : اللَّهُمَّ ، رَاوَدْتُ امْرَأَةً عَنْ نَفْسِهَا وَأَعْطَيْتُهَا مِائَةَ دِينَارٍ ، فَلَمَّا أَمْكَنَتْنِي مِنْ نَفْسِهَا بَكَتْ ، فَقُلْتُ : مَا يُبْكِيكِ ؟ قَالَتْ : فَعَلْتُ هَذَا مِنَ الْحَاجَةِ ! فَقُلْتُ : انْطَلِقِي وَلَكِ الْمِائَةُ . وَتَرَكْتُهَا . اللَّهُمَّ إِنْ كُنْتَ تَعْلَمُ أَنِّي إِنَّمَا فَعَلْتُ ذَلِكَ مِنْ خَشْيَتِكَ وَابْتِغَاءَ وَجْهِكَ ، فَاكْشِفْهُ عَنَّا . فَقَالَ الْحَجَرُ : قِضْ . فَانْفَرَجَتْ مِنْهُ فُرْجَةٌ عَظِيمَةٌ .  قَالَ الْآخَرُ : اللَّهُمَّ ، كَانَ لِي أَبَوَانِ كَبِيرَانِ ، وَكَانَ لِي غَنَمٌ ، فَكُنْتُ آتِيهِمَا بِلَبَنٍ كُلَّ لَيْلَةٍ ، فَأَبْطَأْتُ عَنْهُمَا ذَاتَ لَيْلَةٍ حَتَّى نَامَا ، فَجِئْتُ فَوَجَدْتُهُمَا نَائِمَيْنِ ، فَكَرِهْتُ أَنْ أُوقِظَهُمَا ، وَكَرِهْتُ أَنْ أَنْطَلِقَ فَيَسْتَيْقِظَانِ ، فَقُمْتُ بِالْإِنَاءِ عَلَى رُؤُوسِهِمَا حَتَّى أَصْبَحْتُ . اللَّهُمَّ إِنْ         [21/131]      كُنْتَ تَعْلَمُ أَنِّي إِنَّمَا فَعَلْتُ ذَلِكَ مِنْ خَشْيَتِكَ وَابْتِغَاءَ وَجْهِكَ ، فَاكْشِفْهُ . فَقَالَ الْحَجَرُ : قِضْ . فَانْكَشَفَتْ عَنْهُمْ ; فَخَرَجُوا يَمْشُونَ  .","","Al-Mu'jam al-Kabir 159","","النعمان بن بشير الأنصاري عن عمرو بن شرحبيل الهمداني عن أبو إسحاق السبيعي عن الأعمش عن عبد الملك بن معن المسعودي عن محمد بن أبي عبيدة المسعودي عن محمد بن عبد الله بن نمير عن محمد بن عبدوس السراج عن الطبراني","أبو ميسرة عمرو بن شرحبيل عن النعمان بن بشير"
"19436","160  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  إِسْحَاقُ بْنُ سُلَيْمَانَ ،  ثَنَا  أَبُو سِنَانٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 160","","النعمان بن بشير الأنصاري عن أبو إسحاق السبيعي عن سعيد بن سنان البرجمي عن إسحاق بن سليمان الرازي عن محمد بن عبد الله بن نمير عن محمد بن عبدوس السراج عن الطبراني","أبو ميسرة عمرو بن شرحبيل عن النعمان بن بشير"
"19437","161  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  رَجُلٍ مِنْ بَجِيلَةَ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ ثَلَاثَةَ نَفَرٍ انْطَلَقُوا فِي سَفَرٍ  .... "" فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 161","","النعمان بن بشير الأنصاري عن رجل من بجيلة عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو ميسرة عمرو بن شرحبيل عن النعمان بن بشير"
"19438","[21/132]      162  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ،  عَنْ  أَبِيهِ  ،  عَنْ  حَبِيبِ بْنِ سَالِمٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ فِي الْعِيدَيْنِ وَيَوْمَ الْجُمُعَةِ  بِـ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      وَ         {      هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ         }      .","","Al-Mu'jam al-Kabir 162","","النعمان بن بشير الأنصاري عن حبيب بن سالم الأنصاري مولى النعمان بن بشير عن محمد بن المنتشر بن الأجدع الوادعي عن إبراهيم بن محمد بن المنتشر الهمداني عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","حبيب بن سالم عن النعمان بن بشير"
"19439","163  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  شُعْبَةُ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ ،  ثَنَا  عَلِيُّ بْنُ الْجَعْدِ (  ح  ) .  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ، قَالَا :  ثَنَا  شُعْبَةُ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، قَالَ :  سَمِعْتُ  أَبِي  يُحَدِّثُ ، عَنْ  حَبِيبِ بْنِ سَالِمٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَقْرَأُ فِي         [21/133]      صَلَاةِ الْجُمُعَةِ يَوْمَ الْجُمُعَةِ  بِـ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      وَ         {      هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ         }      وَاللَّفْظُ لِحَدِيثِ  عَاصِمِ بْنِ عَلِيٍّ  .","","Al-Mu'jam al-Kabir 163","","النعمان بن بشير الأنصاري عن حبيب بن سالم الأنصاري مولى النعمان بن بشير عن محمد بن المنتشر بن الأجدع الوادعي عن إبراهيم بن محمد بن المنتشر الهمداني عن شعبة بن الحجاج عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","حبيب بن سالم عن النعمان بن بشير"
"19440","164  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ، قَالَ :  ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  سُفْيَانُ ،  ثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ،  عَنْ  أَبِيهِ  ،  عَنْ  حَبِيبِ بْنِ سَالِمٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَقْرَأُ فِي الْعِيدَيْنِ بِـ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      وَ         {      هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ         }      ، وَكَانَ يَقْرَأُ بِهِمَا إِذَا وَافَقَ ذَلِكَ يَوْمَ الْجُمُعَةِ  .         [21/134]","","Al-Mu'jam al-Kabir 164","","النعمان بن بشير الأنصاري عن سالم مولى النعمان بن بشير عن حبيب بن سالم الأنصاري مولى النعمان بن بشير عن محمد بن المنتشر بن الأجدع الوادعي عن إبراهيم بن محمد بن المنتشر الهمداني عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","حبيب بن سالم عن النعمان بن بشير"
"19441","165  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ،  عَنْ  أَبِيهِ  ،  عَنْ  حَبِيبِ بْنِ سَالِمٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِمِثْلِ مَعْنَاهُ ، وَلَمْ يَذْكُرْ فِيهِ : "" عَنْ أَبِيهِ "" .","","Al-Mu'jam al-Kabir 165","","النعمان بن بشير الأنصاري عن حبيب بن سالم الأنصاري مولى النعمان بن بشير عن محمد بن المنتشر بن الأجدع الوادعي عن إبراهيم بن محمد بن المنتشر الهمداني عن جرير بن عبد الحميد عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","حبيب بن سالم عن النعمان بن بشير"
"19442","166  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ،  عَنْ  أَبِيهِ  ،  عَنْ  حَبِيبِ بْنِ سَالِمٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ فِي الْعِيدَيْنِ وَيَوْمَ الْجُمُعَةِ  بِـ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      وَ         {      هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ         }      وَرُبَّمَا اجْتَمَعَا فِي يَوْمٍ فَقَرَأَ بِهِمَا  .","","Al-Mu'jam al-Kabir 166","","النعمان بن بشير الأنصاري عن حبيب بن سالم الأنصاري مولى النعمان بن بشير عن محمد بن المنتشر بن الأجدع الوادعي عن إبراهيم بن محمد بن المنتشر الهمداني عن الوضاح بن عبد الله اليشكري عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","حبيب بن سالم عن النعمان بن بشير"
"19443","167  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلَطِيُّ ،  ثَنَا  مُوسَى بْنُ دَاوُدَ ،  ثَنَا  الْقَاسِمُ بْنُ مَعْنٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ،  عَنْ  أَبِيهِ  ،  عَنْ  حَبِيبِ بْنِ سَالِمٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَقْرَأُ فِي الْعِيدَيْنِ وَيَوْمَ الْجُمُعَةِ  بِـ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      وَ         {      هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ         }      وَرُبَّمَا اجْتَمَعَا فِي يَوْمٍ فَقَرَأَ بِهِمَا  .         [21/135]","","Al-Mu'jam al-Kabir 167","","النعمان بن بشير الأنصاري عن حبيب بن سالم الأنصاري مولى النعمان بن بشير عن محمد بن المنتشر بن الأجدع الوادعي عن إبراهيم بن محمد بن المنتشر الهمداني عن القاسم بن معن عن موسى بن داود الخلقاني عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","حبيب بن سالم عن النعمان بن بشير"
"19444","168  -  حَدَّثَنَا  مُحَمَّدُ بْنُ حَمْزَةَ بْنِ عُمَارَةَ الْأَصْبَهَانِيُّ ،  ثَنَا  الْعَبَّاسُ بْنُ مُحَمَّدِ بْنِ حَاتِمٍ ،  ثَنَا  يَحْيَى بْنُ يَعْلَى ،  ثَنَا  أَبِي  ،  عَنْ  غَيْلَانَ بْنِ جَامِعٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ،  عَنْ  أَبِيهِ  ،  عَنْ  حَبِيبِ بْنِ سَالِمٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ بِـ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      وَ         {      هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ         }      فِي الْجُمُعَةِ وَفِي الْعِيدَيْنِ  ، وَرُبَّمَا اجْتَمَعَا فِي يَوْمٍ فَقَرَأَ بِهِمَا جَمِيعًا  .","","Al-Mu'jam al-Kabir 168","","النعمان بن بشير الأنصاري عن حبيب بن سالم الأنصاري مولى النعمان بن بشير عن محمد بن المنتشر بن الأجدع الوادعي عن إبراهيم بن محمد بن المنتشر الهمداني عن غيلان بن جامع المحاربي عن يعلى بن الحارث بن حرب المحاربي عن يحيى بن يعلى بن الحارث المحاربي عن عباس الدوري عن محمد بن حمزة بن عمارة الأصبهاني عن الطبراني","حبيب بن سالم عن النعمان بن بشير"
"19445","169  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ،  عَنْ  أَبِيهِ ،  عَنْ  حَبِيبِ بْنِ سَالِمٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَقْرَأُ فِي الْعِيدِ وَالْجُمُعَةِ بِـ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      وَ         {      هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ         }      وَإِذَا اجْتَمَعَا عِيدَانِ فِي يَوْمٍ قَرَأَهُمَا جَمِيعًا  .","","Al-Mu'jam al-Kabir 169","","النعمان بن بشير الأنصاري عن حبيب بن سالم الأنصاري مولى النعمان بن بشير عن محمد بن المنتشر بن الأجدع الوادعي عن إبراهيم بن محمد بن المنتشر الهمداني عن جرير بن عبد الحميد عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","حبيب بن سالم عن النعمان بن بشير"
"19446","170  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ         [21/136]      ،  عَنْ  مِسْعَرٍ وَسُفْيَانَ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ،  عَنْ  أَبِيهِ  ،  عَنْ  حَبِيبِ بْنِ سَالِمٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَقْرَأُ فِي الْعِيدَيْنِ وَالْجُمُعَةِ بِـ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      وَ         {      هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ         }      .","","Al-Mu'jam al-Kabir 170","","النعمان بن بشير الأنصاري عن حبيب بن سالم الأنصاري مولى النعمان بن بشير عن محمد بن المنتشر بن الأجدع الوادعي عن إبراهيم بن محمد بن المنتشر الهمداني عن سفيان الثوري عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","حبيب بن سالم عن النعمان بن بشير"
"19447","171  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  مَعْمَرُ بْنُ سَهْلٍ الْأَهْوَازِيُّ ،  ثَنَا  عَامِرُ بْنُ مُدْرِكٍ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  جَابِرٍ ،  عَنْ  حَبِيبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ فِي الْأَضْحَى وَالْفِطْرِ  بِـ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      وَ         {      هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ         }      وَيَكْثُرُ أَنْ يَقْرَأَ بِهِمَا فِي الْجُمُعَةِ  .","","Al-Mu'jam al-Kabir 171","","النعمان بن بشير الأنصاري عن حبيب بن سالم الأنصاري مولى النعمان بن بشير عن جابر الجعفي عن إسرائيل بن يونس بن أبي إسحاق عن عامر بن مدرك بن أبي الصفيراء الحارثي عن معمر بن سهل بن معمر الأهوازي عن أحمد بن يحيى بن زهير التستري عن الطبراني","حبيب بن سالم عن النعمان بن بشير"
"19448","172  -  حَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ،  عَنْ  حَبِيبِ بْنِ سَالِمٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  أَنَا أَعْلَمُ النَّاسِ بِوَقْتِ هَذِهِ الصَّلَاةِ  يَعْنِي : الْعِشَاءَ  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّيهَا لِسُقُوطِ         [21/137]      الْقَمَرِ لَيْلَةَ ثَالِثَةٍ  .","","Al-Mu'jam al-Kabir 172","","النعمان بن بشير الأنصاري عن حبيب بن سالم الأنصاري مولى النعمان بن بشير عن إبراهيم بن محمد بن المنتشر الهمداني عن الوضاح بن عبد الله اليشكري عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","حبيب بن سالم عن النعمان بن بشير"
"19449","173  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  بَشِيرِ بْنِ ثَابِتٍ ،  عَنْ  حَبِيبِ بْنِ سَالِمٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  أَنَا أَعْلَمُ النَّاسِ بِوَقْتِ هَذِهِ الصَّلَاةِ : صَلَاةِ الْعِشَاءِ ;  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّيهَا لِسُقُوطِ الْقَمَرِ فِي اللَّيْلَةِ الثَّالِثَةِ  .","","Al-Mu'jam al-Kabir 173","","النعمان بن بشير الأنصاري عن حبيب بن سالم الأنصاري مولى النعمان بن بشير عن بشير بن ثابت مولى النعمان بن بشير عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","حبيب بن سالم عن النعمان بن بشير"
"19450","174  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  أَنَا  هُشَيْمٌ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  حَبِيبِ بْنِ سَالِمٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  أَنَا أَعْلَمُ النَّاسِ بِوَقْتِ صَلَاةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْعِشَاءَ  كَانَ يُصَلِّيهَا بَعْدَ         [21/138]      سُقُوطِ الْقَمَرِ لَيْلَةَ الثَّالِثَةِ مِنْ أَوَّلِ  الشَّهْرِ  .","","Al-Mu'jam al-Kabir 174","","النعمان بن بشير الأنصاري عن حبيب بن سالم الأنصاري مولى النعمان بن بشير عن جعفر بن إياس اليشكري عن هشيم بن بشير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","حبيب بن سالم عن النعمان بن بشير"
"19451","175  -  حَدَّثَنَا  جَعْفَرُ بْنُ أَحْمَدَ بْنِ سِنَانٍ الْوَاسِطِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  شُعْبَةُ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  بَشِيرِ بْنِ ثَابِتٍ ،  عَنْ  حَبِيبِ بْنِ سَالِمٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  إِنِّي لَأَعْلَمُ النَّاسِ بِوَقْتِ صَلَاةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُصَلِّيهَا لِمِقْدَارِ مَا يَغِيبُ الْقَمَرُ لَيْلَةَ أَرْبَعَةٍ  .  قَالَ  يَزِيدُ  : فَقُلْتُ لَهُ : إِنَّ  هُشَيْمًا  ، حَدَّثَنَا بِهِ ""  لَيْلَةَ ثَالِثَةٍ  "" فَقَالَ  يَزِيدُ  : اجْعَلْهُ عَلَى الشَّكِّ : ""  لِلَيْلَةِ ثَالِثَةٍ أَوْ رَابِعَةٍ  "" .         [21/139]","","Al-Mu'jam al-Kabir 175","","النعمان بن بشير الأنصاري عن حبيب بن سالم الأنصاري مولى النعمان بن بشير عن بشير بن ثابت مولى النعمان بن بشير عن جعفر بن إياس اليشكري عن شعبة بن الحجاج عن يزيد بن هارون عن أحمد بن سنان القطان عن جعفر بن أحمد بن سنان الواسطي عن الطبراني","حبيب بن سالم عن النعمان بن بشير"
"19452","176  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  رَقَبَةَ بْنِ مَصْقَلَةَ ،  عَنْ  جَعْفَرِ بْنِ أَبِي وَحْشِيَّةَ ،  عَنْ  حَبِيبِ بْنِ سَالِمٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  أَنَا أَعْلَمُ النَّاسِ بِمِيقَاتِ هَذِهِ الصَّلَاةِ : الْعِشَاءِ الْآخِرَةِ ;  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّيهَا لِسُقُوطِ الْقَمَرِ لِثَالِثَةٍ  .","","Al-Mu'jam al-Kabir 176","","النعمان بن بشير الأنصاري عن حبيب بن سالم الأنصاري مولى النعمان بن بشير عن جعفر بن إياس اليشكري عن رقبة بن مصقلة عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن عبد الله بن أحمد الجواليقي عن الطبراني","حبيب بن سالم عن النعمان بن بشير"
"19453","177  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ (  ح  ) .  وَحَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ ،  ثَنَا  دَاوُدُ بْنُ شَبِيبٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  حَبِيبِ بْنِ سَالِمٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ;  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ فِي  رَجُلٍ  وَقَعَ بِجَارِيَةِ امْرَأَتِهِ :  إِنْ كَانَتْ أَحَلَّتْهَا لَهُ فَاجْلِدُوهُ مِائَةَ جَلْدَةٍ ، وَإِنْ لَمْ تَكُنْ أَحَلَّتْهَا لَهُ فَارْجُمُوهُ  .","","Al-Mu'jam al-Kabir 177","","النعمان بن بشير الأنصاري عن حبيب بن سالم الأنصاري مولى النعمان بن بشير عن قتادة بن دعامة عن سعيد بن أبي عروبة عن حماد بن سلمة عن داود بن شبيب عن الفضل بن الحباب الجمحي عن الطبراني","حبيب بن سالم عن النعمان بن بشير"
"19454","178  -  حَدَّثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  عَنْ  أَيُّوبَ بْنِ أَبِي مِسْكِينٍ وَسَعِيدِ بْنِ         [21/140]      أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  حَبِيبِ بْنِ سَالِمٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 178","","النعمان بن بشير الأنصاري عن حبيب بن سالم الأنصاري مولى النعمان بن بشير عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن هارون عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","حبيب بن سالم عن النعمان بن بشير"
"19455","179  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  حَبِيبِ بْنِ سَالِمٍ ،  عَنِ  النُّعْمَانِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 179","","النعمان بن بشير الأنصاري عن حبيب بن سالم الأنصاري مولى النعمان بن بشير عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبد السلام بن حرب الملائي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","حبيب بن سالم عن النعمان بن بشير"
"19456","180  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ الْمُنْذِرِ الْقَزَّازُ الْبَصْرِيُّ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ (  ح  ) .  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ، قَالَا :  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  حَبِيبِ بْنِ يَسَافٍ ،  عَنْ  حَبِيبِ بْنِ سَالِمٍ ;  أَنَّ  رَجُلًا  وَطِئَ جَارِيَةَ امْرَأَتِهِ ، فَرُفِعَ إِلَى النُّعْمَانِ بْنِ بَشِيرٍ ،  فَقَالَ  : لَأَقْضِيَنَّ فِيهَا         [21/141]      بِقَضَاءِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ كَانَتْ أَحَلَّتْهَا لَهُ جَلَدْتُهُ مِائَةً ، وَإِنْ لَمْ تَكُنْ أَحَلَّتْهَا لَهُ رَجَمْتُهُ بِالْحِجَارَةِ  .","","Al-Mu'jam al-Kabir 180","","النعمان بن بشير الأنصاري عن حبيب بن سالم الأنصاري مولى النعمان بن بشير عن حبيب بن يساف عن قتادة بن دعامة عن همام بن يحيى بن دينار عن هدبة بن خالد عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","حبيب بن سالم عن النعمان بن بشير"
"19457","181  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ كَيْسَانَ الْمِصِّيصِيُّ ،  ثَنَا  حَبَّانُ بْنُ هِلَالٍ ،  ثَنَا  أَبَانُ بْنُ يَزِيدَ ،  ثَنَا  قَتَادَةُ ،  حَدَّثَنِي  خَالِدُ بْنُ عُرْفُطَةَ ،  عَنْ  حَبِيبِ بْنِ سَالِمٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ;  أَنَّ رَجُلًا يُقَالُ لَهُ :  عَبْدُ الرَّحْمَنِ بْنُ جُبَيْرٍ  وَكَانَ  يُنْبَزُ  فَرْفَرَ أَوْ  قَرْقَرَ  فَوَقَعَ عَلَى جَارِيَةِ         [21/142]      امْرَأَةٍ ، فَرُفِعَ إِلَى  النُّعْمَانِ بْنِ بَشِيرٍ  فَقَالَ : لَأَقْضِيَنَّ بِقَضِيَّةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ كَانَتْ أَحَلَّتْهَا لَكَ جَلَدْتُكَ مِائَةً  ، وَإِنْ لَمْ تَكُنْ أَحَلَّتْهَا لَكَ رَجَمْتُكَ بِالْحِجَارَةِ . وَكَانَتْ قَدْ أَحَلَّتْهَا لَهُ ، فَجَلَدَهُ مِائَةً  .","","Al-Mu'jam al-Kabir 181","","النعمان بن بشير الأنصاري عن حبيب بن سالم الأنصاري مولى النعمان بن بشير عن خالد بن عرفطة عن قتادة بن دعامة عن أبان بن يزيد العطار عن حبان بن هلال الباهلي عن محمد بن الحسن بن كيسان المصيصي عن الطبراني","حبيب بن سالم عن النعمان بن بشير"
"19458","182  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  حَبِيبِ بْنِ سَالِمٍ ;  أَنَّ  رَجُلًا  وَقَعَ بِجَارِيَةِ امْرَأَتِهِ ، فَأَتَتِ النُّعْمَانَ فَأَخْبَرَتْهُ ،  فَقَالَ  : أَمَا إِنَّ عِنْدِي فِي ذَلِكَ خَبَرًا شَافِيًا أَخَذْتُهُ         [21/143]      ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ;  إِنْ كُنْتِ أَذِنْتِ لَهُ جَلَدْتُهُ مِائَةً ، وَإِنْ كُنْتِ لَمْ تَأْذَنِي لَهُ رَجَمْتُهُ  .","","Al-Mu'jam al-Kabir 182","","النعمان بن بشير الأنصاري عن حبيب بن سالم الأنصاري مولى النعمان بن بشير عن جعفر بن إياس اليشكري عن هشيم بن بشير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","حبيب بن سالم عن النعمان بن بشير"
"19459","[21/144]      183  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ (  ح  ) .  وَحَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  جَابِرٍ ،  عَنْ  أَبِي عَازِبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كُلُّ شَيْءٍ خَطَأٌ إِلَّا السَّيْفَ  ، وَلِكُلِّ خَطَأٍ أَرْشٌ  .","","Al-Mu'jam al-Kabir 183","","النعمان بن بشير الأنصاري عن أبو عازب الكوفي عن جابر الجعفي عن سفيان الثوري عن الفضل بن دكين عن أبو زرعة الدمشقي عن الطبراني","أبو عازب عن النعمان بن بشير"
"19460","184  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  نَصْرُ بْنُ عَلِيٍّ ،  ثَنَا  أَبِي  ،  ثَنَا  حَازِمُ بْنُ إِبْرَاهِيمَ ،  عَنْ  جَابِرٍ ،  عَنْ  أَبِي         [21/145]      عَازِبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا حَدَّ إِلَّا بِالسَّيْفِ  .","","Al-Mu'jam al-Kabir 184","","النعمان بن بشير الأنصاري عن أبو عازب الكوفي عن جابر الجعفي عن حازم بن إبراهيم البجلي عن علي بن نصر الجهضمي الكبير عن نصر بن علي بن نصر الجهضمي عن محمد بن صالح النرسي عن الطبراني","أبو عازب عن النعمان بن بشير"
"19461","185  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  جَابِرٍ ،  عَنْ  أَبِي عَازِبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  كُلُّ شَيْءٍ خَطَأٌ إِلَّا الْحَدِيدَةَ وَالسَّيْفَ  .","","Al-Mu'jam al-Kabir 185","","النعمان بن بشير الأنصاري عن أبو عازب الكوفي عن جابر الجعفي عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","أبو عازب عن النعمان بن بشير"
"19462","[21/146]      186  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عُمَرُ بْنُ حَفْصِ بْنِ غِيَاثٍ ،  ثَنَا  أَبِي  ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنْ  أَبِي زِيَادٍ التَّيْمِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْخَيْلُ  مَعْقُودٌ  فِي نَوَاصِيهَا الْخَيْرُ إِلَى يَوْمِ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 186","","النعمان بن بشير الأنصاري عن أبو زياد التيمى عن أشعث بن سوار عن حفص بن غياث النخعي عن عمر بن حفص بن غياث عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو زياد التيمي عن النعمان بن بشير"
"19463","[21/147]      187  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَالِمٍ الرَّازِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  أَبُو خَالِدٍ الْأَحْمَرُ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  حُسَيْنِ بْنِ الْحَارِثِ الْجَدَلِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَقِيمُوا صُفُوفَكُمْ أَوْ  لَيُخَالِفَنَّ  اللهُ بَيْنَ  وُجُوهِكُمْ  يَوْمَ الْقِيَامَةِ  ! "" . وَلَقَدْ رَأَيْتُ الرَّجُلَ مِنَّا يَلْتَمِسُ مَنْكِبَ أَخِيهِ بِمَنْكِبِهِ ، وَرُكْبَتَهُ بِرُكْبَتِهِ ، وَقَدَمَهُ بِقَدَمِهِ .","","Al-Mu'jam al-Kabir 187","","النعمان بن بشير الأنصاري عن الحسين بن الحارث الجدلي عن حجاج بن أرطاة عن سليمان بن حيان الأحمر عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","الحسين بن الحارث أبو القاسم الجدلي عن النعمان بن بشير"
"19464","188  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَالِمٍ الرَّازِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  وَكِيعٌ وَالْمُحَارِبِيُّ ،  عَنْ  زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  حَدَّثَنِي  أَبُو الْقَاسِمِ الْجَدَلِيُّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  أَقْبَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِوَجْهِهِ عَلَى النَّاسِ فَقَالَ :  أَقِيمُوا صُفُوفَكُمْ أَوْ  لَيُخَالِفَنَّ  اللهُ بَيْنَ قُلُوبِكُمْ  ! ""  .","","Al-Mu'jam al-Kabir 188","","النعمان بن بشير الأنصاري عن الحسين بن الحارث الجدلي عن زكريا بن أبي زائدة الوادعي عن عبد الرحمن بن محمد المحاربي عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","الحسين بن الحارث أبو القاسم الجدلي عن النعمان بن بشير"
"19465","[21/148]      189  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو حُذَيْفَةَ ، قَالَا :  ثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  ذَرٍّ ،  عَنْ  يُسَيْعٍ الْحَضْرَمِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْعِبَادَةُ هِيَ الدُّعَاءُ  ، ثُمَّ قَرَأَ :         {      ادْعُونِي أَسْتَجِبْ لَكُمْ إِنَّ الَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِي سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ         }      وَاللَّفْظُ  لِأَبِي حُذَيْفَةَ  .","","Al-Mu'jam al-Kabir 189","","النعمان بن بشير الأنصاري عن يسيع بن معدان الحضرمي عن ذر بن عبد الله المرهبي عن منصور بن المعتمر عن سفيان الثوري عن موسى بن مسعود النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","يسيع الحضرمي عن النعمان بن بشير"
"19466","190  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ الرَّقِّيُّ ،  ثَنَا  سَعْدُ بْنُ حَفْصٍ الْكُوفِيُّ ،         [21/149]      ،  ثَنَا  شَيْبَانُ .  وَحَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  شَيْبَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  ذَرٍّ ،  عَنْ  يُسَيْعٍ الْحَضْرَمِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 190","","النعمان بن بشير الأنصاري عن يسيع بن معدان الحضرمي عن ذر بن عبد الله المرهبي عن منصور بن المعتمر عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","يسيع الحضرمي عن النعمان بن بشير"
"19467","191  -  حَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ الْجُمَحِيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  ذَرٍّ ،  عَنْ  يُسَيْعٍ الْحَضْرَمِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الدُّعَاءُ هُوَ الْعِبَادَةُ  ،         {      وَقَالَ رَبُّكُمُ ادْعُونِي أَسْتَجِبْ لَكُمْ إِنَّ الَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِي سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ         }      .         [21/150]","","Al-Mu'jam al-Kabir 191","","النعمان بن بشير الأنصاري عن يسيع بن معدان الحضرمي عن ذر بن عبد الله المرهبي عن منصور بن المعتمر عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","يسيع الحضرمي عن النعمان بن بشير"
"19468","192  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  ذَرٍّ ،  عَنْ  يُسَيْعٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 192","","النعمان بن بشير الأنصاري عن يسيع بن معدان الحضرمي عن ذر بن عبد الله المرهبي عن منصور بن المعتمر عن جرير بن عبد الحميد عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","يسيع الحضرمي عن النعمان بن بشير"
"19469","193  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  ذَرٍّ ،  عَنْ  يُسَيْعٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الدُّعَاءُ هُوَ الْعِبَادَةُ  ثُمَّ قَرَأَ :         {      وَقَالَ رَبُّكُمُ ادْعُونِي أَسْتَجِبْ لَكُمْ         }      ... )  .","","Al-Mu'jam al-Kabir 193","","النعمان بن بشير الأنصاري عن يسيع بن معدان الحضرمي عن ذر بن عبد الله المرهبي عن الأعمش عن عبد الله بن إدريس الأودي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","يسيع الحضرمي عن النعمان بن بشير"
"19470","194  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو         [21/151]      مُعَاوِيَةَ وَوَكِيعٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  ذَرٍّ ،  عَنْ  يُسَيْعٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الدُّعَاءَ هُوَ الْعِبَادَةُ  ، ثُمَّ قَرَأَ :         {      وَقَالَ رَبُّكُمُ ادْعُونِي أَسْتَجِبْ لَكُمْ         }      .","","Al-Mu'jam al-Kabir 194","","النعمان بن بشير الأنصاري عن يسيع بن معدان الحضرمي عن ذر بن عبد الله المرهبي عن الأعمش عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","يسيع الحضرمي عن النعمان بن بشير"
"19471","195  -  حَدَّثَنَا  أَبُو عَوَانَةَ يَعْقُوبُ بْنُ إِسْحَاقَ النَّيْسَابُورِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْحَجَّاجِ بْنِ سُلَيْمَانَ الْحَضْرَمِيُّ الْمِصْرِيُّ ،  ثَنَا  الْخَصِيبُ بْنُ نَاصِحٍ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ دَاوُدَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  ذَرٍّ ،  عَنْ  يُسَيْعٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ;  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ فِي قَوْلِهِ :         {      إِنَّ الَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِي         }      ، قَالَ : "" عَنْ  دُعَائِي         {      سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ         }      .","","Al-Mu'jam al-Kabir 195","","النعمان بن بشير الأنصاري عن يسيع بن معدان الحضرمي عن ذر بن عبد الله المرهبي عن الأعمش عن عبد الله بن داود الخريبي عن سفيان بن عيينة عن الخصيب بن ناصح الحارثي عن محمد بن الحجاج بن سليمان الجوهري عن أبو عوانة الإسفراييني عن الطبراني","يسيع الحضرمي عن النعمان بن بشير"
"19472","[21/152]      196  -  حَدَّثَنَا  إِدْرِيسُ بْنُ عَبْدِ الْكَرِيمِ الْحَدَّادُ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ (  ح  ) .  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ إِبْرَاهِيمَ الْعَسْكَرِيُّ أَبُو عُبَيْدَةَ ،  ثَنَا  حَوْثَرَةُ بْنُ أَشْرَسَ ، قَالَا :  ثَنَا  عُقْبَةُ بْنُ عَبْدِ اللهِ الرِّفَاعِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ أَنَّ أَبَاهُ ذَهَبَ بِهِ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا رَسُولَ اللهِ ! هَذَا  النُّعْمَانُ بْنُ بَشِيرٍ  ، وَأُمُّهُ  عَمْرَةُ بِنْتُ رَوَاحَةَ  ، جِئْتُ أُشْهِدُكَ عَلَى  نُحْلٍ  أَنْحَلُهُ إِيَّاهُ ، فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" يَا  بَشِيرُ  !  أَكُلَّ وَلَدِكَ تَنْحَلُ كَمَا تَنْحَلُ هَذَا ؟  ، قَالَ : لَا ، قَالَ : "" أَلَيْسَ تُحِبُّ أَنْ يَكُونُوا لَكَ فِي  الْبِرِّ  سَوَاءً ؟ "" ، قَالَ : بَلَى ، قَالَ : "" فَأَشْهِدْ غَيْرِي  .","","Al-Mu'jam al-Kabir 196","","النعمان بن بشير الأنصاري عن عبد الله بن بريدة عن عقبة بن عبد الله الأصم عن حوثرة بن أشرس بن عومر العدوي عن عبد الله بن إبراهيم العسكري أبو عبيدة عن الطبراني","عبد الله بن بريدة عن النعمان بن بشير"
"19473","[21/153]      197  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ ، وَعَبْدُ اللهِ بْنُ نَاجِيَةَ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ الْقَصَّاصُ ،  ثَنَا  عُمَرُ بْنُ عَلِيٍّ الْمُقَدَّمِيُّ ،  ثَنَا  مِسْعَرُ بْنُ كِدَامٍ ، قَالَ :  سَمِعْتُ  خَالِي الْوَلِيدَ بْنَ عُثْمَانَ ،  يُحَدِّثُ ، عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ جَلَدَ  حَدًّا  فِي غَيْرِ حَدٍّ ، فَهُوَ مِنَ الْمُعْتَدِينَ  .","","Al-Mu'jam al-Kabir 197","","النعمان بن بشير الأنصاري عن الوليد بن عثمان خال مسعر عن مسعر بن كدام عن عمر بن علي بن عطاء عن محمد بن الحسين القصاص عن عبد الله بن محمد بن ناجية البربري عن الطبراني","الوليد بن عثمان خال مسعر عن النعمان"
"19474","[21/154]      198  -  حَدَّثَنَا  عَلَّانُ بْنُ عَبْدِ الصَّمَدِ مَاغَمَّهُ ،  حَدَّثَنَا  عُمَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ ،  ثَنَا  أَبِي  ،  ثَنَا  مُجَمِّعٌ الْأَنْصَارِيُّ ،  عَنْ  زَكَرِيَّا بْنِ خَالِدٍ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  حَلَالٌ بَيِّنٌ وَحَرَامٌ بَيِّنٌ ، وَمُشْتَبِهَاتٌ بَيْنَ ذَلِكَ  ، فَمَنْ تَرَكَ مَا اشْتَبَهَ عَلَيْهِ مِنَ الْإِثْمِ كَانَ لِمَا اسْتَبَانَ لَهُ أَتْرَكَ ، وَمَنِ اجْتَرَأَ عَلَى مَا شَكَّ فِيهِ مِنَ الْإِثْمِ أَوْشَكَ أَنْ يُوَاقِعَ مَا اسْتَبَانَ لَهُ ، وَإِنَّ الْمَعَاصِيَ حِمَى اللهِ ، فَمَنْ  يَرْتَعُ  حَوْلَ الْحِمَى  يُوشِكُ  أَنْ يُوَاقِعَهُ  .","","Al-Mu'jam al-Kabir 198","","النعمان بن بشير الأنصاري عن زكريا بن خالد الأنصاري عن مجمع بن يعقوب القبائي عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن علي بن عبد الصمد علان ماغمه عن الطبراني","زكريا بن خالد عن النعمان بن بشير"
"19475","[21/155]      199  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدِ بْنِ حَرْبٍ الْعَبَّادَانِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ .  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  خَالِدُ بْنُ خِدَاشٍ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  حَاجِبِ بْنِ الْمُفَضَّلِ بْنِ الْمُهَلَّبِ ،  عَنْ  أَبِيهِ  ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اعْدِلُوا بَيْنَ أَوْلَادِكُمْ  يَقُولُهَا ثَلَاثًا  .","","Al-Mu'jam al-Kabir 199","","النعمان بن بشير الأنصاري عن المفضل بن المهلب الأزدي عن حاجب بن المفضل بن المهلب المهلبي عن حماد بن زيد عن خالد المهلبي عن معاذ بن المثنى العنبري عن الطبراني","ما روى المفضل بن المهلب عن النعمان بن بشير"
"19476","[21/156]      200  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  مُعَاذُ بْنُ هِشَامٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَاتَ يَوْمٍ مُسْتَعْجِلًا ، حَتَّى أَتَى الْمَسْجِدَ يَجُرُّ رِدَاءَهُ ، وَقَدِ انْكَسَفَتِ الشَّمْسُ ، فَصَلَّى حَتَّى انْجَلَتْ ، ثُمَّ قَالَ : "" إِنَّ أَهْلَ الْجَاهِلِيَّةِ كَانُوا يَقُولُونَ : إِنَّ الشَّمْسَ وَالْقَمَرَ إِنَّمَا  يَنْكَسِفَانِ  لِمَوْتِ عَظِيمٍ مِنْ عُظَمَاءِ أَهْلِ الْأَرْضِ .  وَإِنَّ الشَّمْسَ وَالْقَمَرَ لَا  يَنْكَسِفَانِ  لِمَوْتِ أَحَدٍ  ، وَلَكِنَّهُمَا آيَتَانِ مِنْ آيَاتِ اللهِ ، وَخَلْقٌ مِنْ خَلْقِهِ ، يُحْدِثُ فِي خَلْقِهِ مَا يَشَاءُ ، فَأَيَّتُهُمَا كَانَتْ فَصَلُّوا حَتَّى تَنْجَلِيَ  .","","Al-Mu'jam al-Kabir 200","","النعمان بن بشير الأنصاري عن الحسن البصري عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن علي ابن المديني عن معاذ بن المثنى العنبري عن الطبراني","الحسن بن أبي الحسن البصري عن النعمان بن بشير"
"19477","[21/157]      201  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ (  ح  ) .  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  أَبُو الْأَحْوَصِ ،  ثَنَا  عَاصِمُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا انْكَسَفَتِ الشَّمْسُ أَوِ الْقَمَرُ صَلَّى بِنَا حَتَّى تَنْجَلِيَ  .","","Al-Mu'jam al-Kabir 201","","النعمان بن بشير الأنصاري عن أبو قلابة الجرمي عن عاصم بن سليمان الأحول عن سلام بن سليم الحنفي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","أبو قلابة عبد الله بن زيد الجرمي عن النعمان بن بشير"
"19478","202  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،         [21/158]      ،  عَنْ  سُفْيَانَ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى فِي الْكُسُوفِ كَنَحْوٍ مِنْ صَلَاتِكُمْ هَذِهِ ، يَرْكَعُ وَيَسْجُدُ  .","","Al-Mu'jam al-Kabir 202","","النعمان بن بشير الأنصاري عن أبو قلابة الجرمي عن عاصم بن سليمان الأحول عن سفيان الثوري عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو قلابة عبد الله بن زيد الجرمي عن النعمان بن بشير"
"19479","203  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ صَالِحٍ الشِّيرَازِيُّ ،  ثَنَا  عَمْرُو بْنُ حَكَّامٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى فِي الْكُسُوفِ رَكْعَتَيْنِ  .","","Al-Mu'jam al-Kabir 203","","النعمان بن بشير الأنصاري عن أبو قلابة الجرمي عن عاصم بن سليمان الأحول عن شعبة بن الحجاج عن عمرو بن حكام الزنجبيلي عن إبراهيم بن صالح الشيرازي عن الطبراني","أبو قلابة عبد الله بن زيد الجرمي عن النعمان بن بشير"
"19480","204  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ،  ثَنَا  رَوْحُ بْنُ عَبْدِ الْمُؤْمِنِ الْمُقْرِئُ ،  ثَنَا  مُعَاذُ بْنُ هِشَامٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا كَسَفَتِ الشَّمْسُ ، فَصَلُّوا كَأَحْدَثِ صَلَاةٍ صَلَّيْتُمُوهَا مِنَ الْمَكْتُوبَةِ  .         [21/159]","","Al-Mu'jam al-Kabir 204","","النعمان بن بشير الأنصاري عن أبو قلابة الجرمي عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن روح بن عبد المؤمن عن إبراهيم بن هاشم البغوي عن الطبراني","أبو قلابة عبد الله بن زيد الجرمي عن النعمان بن بشير"
"19481","205  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  ثَنَا  عَنْبَسَةُ بْنُ عَبْدِ الْوَاحِدِ ،  عَنْ  أَيُّوبَ بْنِ عُتْبَةَ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا نَامَ أَحَدُكُمْ وَهُوَ يُرِيدُ أَنْ يُصَلِّيَ مِنَ اللَّيْلِ فَلْيَضَعْ عَنْ يَمِينِهِ قَبْضَةً مِنْ تُرَابٍ  ، فَإِذَا انْتَبَهَ فَلْيَقْبِضْ مِنْهُ بِيَمِينِهِ فَلْيَحْصِبْ عَنْ شِمَالِهِ  .","","Al-Mu'jam al-Kabir 205","","النعمان بن بشير الأنصاري عن أبو قلابة الجرمي عن يحيى بن أبي كثير عن أيوب بن عتبة اليمامي عن عنبسة بن عبد الواحد عن محمد بن بكار الرصافي عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو قلابة عبد الله بن زيد الجرمي عن النعمان بن بشير"
"19482","[21/160]      206  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ بَرَّةَ الصَّنْعَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ بْنِ شَرُوسٍ الصَّنْعَانِيُّ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ بَحِيرٍ الْقَاصَّ  يَذْكُرُ عَنْ  وَهْبِ بْنِ مُنَبِّهٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ; أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُحَدِّثُ عَنِ الرَّقِيمِ :  أَنَّ ثَلَاثَةَ نَفَرٍ دَخَلُوا فِي كَهْفٍ  ، فَوَقَعَ قِطْعَةٌ مِنَ الْجَبَلِ عَلَى بَابِ الْكَهْفِ فَأُوصِدَ عَلَيْهِمْ ، فَقَالَ قَائِلٌ مِنْهُمْ : يَا قَوْمِ !         [21/161]      تَذَكَّرُوا أَيُّكُمْ عَمِلَ حَسَنَةً لَعَلَّ اللهَ بِرَحْمَتِهِ أَنْ يَرْحَمَنَا .  فَقَالَ أَحَدُهُمْ : قَدْ عَمِلْتُ حَسَنَةً مَرَّةً ; كَانَ لِي عُمَّالٌ اسْتَأْجَرْتُهُمْ فِي عَمَلٍ لِي ، كُلُّ رَجُلٍ مِنْهُمْ بِأَجْرٍ مَعْلُومٍ ، فَجَاءَنِي رَجُلٌ ذَاتَ يَوْمٍ وَسَطَ النَّهَارِ ، فَاسْتَأْجَرْتُهُ مَا بَقِيَ مِنَ النَّهَارِ بِشَرْطِ أَصْحَابِهِ ، فَعَمِلَ بَقِيَّةَ نَهَارِهِ كَمَا عَمِلَ رَجُلٌ مِنْهُمْ فِي نَهَارِهِ كُلِّهِ ، فَرَأَيْتُ أَنَّ الذِّمَامَ أَلَّا أَنْقُصَهُ شَيْئًا مِمَّا اسْتَأْجَرْتُ بِهِ أَصْحَابَهُ ; لِمَا جَهِدَ فِي عَمَلِهِ ، فَقَالَ لِي رَجُلٌ مِنْهُمْ : أَتُعْطِي هَذَا مِثْلَ مَا أَعْطَيْتَنِي وَلَمْ يَعْمَلْ إِلَّا نِصْفَ نَهَارٍ ؟ . قُلْتُ : يَا عَبْدَ اللهِ ! لَمْ أَبْخَسْكَ شَيْئًا مِنْ شَرْطِكَ ، وَإِنَّمَا هُوَ مَالِي أَحْكُمُ فِيهِ مَا شِئْتُ . فَغَضِبَ عِنْدَ ذَلِكَ وَتَرَكَ إِجَارَتَهُ ، وَوَضَعْتُ حَقَّهُ فِي جَانِبٍ مِنَ الْبَيْتِ مَا شَاءَ اللهُ ، ثُمَّ مَرَّتْ بِي بَعْدَ ذَلِكَ بَقَرٌ ، فَاشْتَرَيْتُ بِهِ  فَصِيلًا  مِنَ الْبَقَرِ ، فَأَمْسَكْتُهُ حَتَّى كَبِرَ ، ثُمَّ بِعْتُهُ ، ثُمَّ صَرَفْتُ ثَمَنَهُ فِي بَقَرَةٍ فَحَمَلَتْ ، ثُمَّ تَوَالَدَتْ لَهَا حَتَّى بَلَغَ مَا شَاءَ اللهُ ، ثُمَّ مَرَّ بِي بَعْدُ شَيْخٌ ضَعِيفٌ لَا أَعْرِفُهُ فَقَالَ لِي : إِنَّ لِي عِنْدَكَ حَقًّا . فَذَكَرَهُ حَتَّى عَرَفْتُهُ ، فَقُلْتُ : نَعَمْ إِيَّاكَ أَبْغِي ، فَعَرَضْتُهَا عَلَيْهِ جَمِيعًا ، فَقُلْتُ : هَذَا حَقُّكَ . فَقَالَ : يَا عَبْدَ اللهِ ! لَا تَسْتَهْزِئْ مِنِّي ، إِنْ لَمْ تَتَصَدَّقْ عَلَيَّ فَأَعْطِنِي حَقِّي ! فَقُلْتُ : وَاللهِ مَا  أَسْخَرُ  مِنْكَ ، إِنَّهَا لَحَقُّكَ ، مَا لِي مِنْهَا شَيْءٌ . فَدَفَعْتُهَا . اللَّهُمَّ إِنْ كُنْتُ فَعَلْتُ ذَلِكَ لِوَجْهِكَ فَافْرُجْ عَنَّا . فَانْصَدَعَ الْجَبَلُ حَتَّى رَأَوْا وَأَبْصَرُوا .         [21/162]      وَقَالَ الْآخَرُ : فَعَلْتُ حَسَنَةً مَرَّةً ; كَانَ عِنْدِي فَضْلٌ وَأَصَابَتِ النَّاسَ شِدَّةٌ ، فَجَاءَتْنِي امْرَأَةٌ تَطْلُبُ مِنِّي مَعْرُوفًا ، فَقُلْتُ لَهَا : لَا وَاللهِ مَا دُونَ نَفْسِكِ . فَأَبَتْ عَلَيَّ ، ثُمَّ رَجَعَتْ فَذَكَّرَتْنِي بِاللهِ فَأَبَيْتُ عَلَيْهَا ، فَقُلْتُ : لَا وَاللهِ مَا هُوَ دُونَ نَفْسِكِ . فَأَبَتْ عَلَيَّ . فَذَكَرَتْ ذَلِكَ لِزَوْجِهَا ، فَقَالَ لَهَا : أَعْطِيهِ نَفْسَكِ فَأَغْنِي عِيَالَكِ . فَجَاءَتْنِي فَنَاشَدَتْنِي اللهَ ، فَقُلْتُ لَهَا : لَا وَاللهِ مَا هُوَ دُونَ نَفْسِكِ . فَلَمَّا رَأَتْ ذَلِكَ أَسْلَمَتْ إِلَيَّ نَفْسَهَا ، فَلَمَّا كَشَفْتُهَا وَهَمَمْتُ بِهَا ارْتَعَدَتْ مِنْ تَحْتِي ، فَقُلْتُ : مَا لَكِ ؟ قَالَتْ : أَخَافُ اللهَ رَبَّ الْعَالَمِينَ . فَقُلْتُ لَهَا : خِفْتِ اللهَ فِي الشِّدَّةِ وَلَمْ أَخَفْهُ فِي  الرَّخَاءِ  ؟ ! فَتَرَكْتُهَا وَأَعْطَيْتُهَا مَا يَحِقُّ عَلَيَّ بِمَا كَشَفْتُهَا . اللَّهُمَّ إِنْ كُنْتُ فَعَلْتُ ذَلِكَ لِوَجْهِكَ فَافْرُجْ عَنَّا . فَانْصَدَعَ الْجَبَلُ حَتَّى عَرَفُوا وَتَبَيَّنَ لَهُمْ .  وَقَالَ الْآخَرُ : قَدْ عَمِلْتُ حَسَنَةً مَرَّةً ; كَانَ لِي أَبَوَانِ شَيْخَانِ كَبِيرَانِ : وَكَانَتْ لِي غَنَمٌ ، فَأُطْعِمُ أَبَوَيَّ وَأَسْقِيهِمَا ، ثُمَّ أَرْجِعُ إِلَى غَنَمِي ، فَلَمَّا كَانَ ذَاتَ يَوْمٍ أَصَابَنِي غَيْثٌ فَحَبَسَنِي ، فَلَمْ أَرُحْ حَتَّى أَمْسَيْتُ ، فَأَتَيْتُ أَهْلِي فَأَخَذْتُ مِحْلَبِي فَحَلَبْتُ وَتَرَكْتُ غَنَمِي قَائِمَةً ، فَمَشَيْتُ إِلَى أَبَوَيَّ لِأَسْقِيَهُمَا ، فَوَجَدْتُهُمَا قَدْ نَامَا ، فَشَقَّ عَلَيَّ أَنْ أُوقِظَهُمَا وَشَقَّ عَلَيَّ أَنْ أَتْرُكَ غَنَمِي ، فَمَا بَرِحْتُ جَالِسًا وَمِحْلَبِي عَلَى يَدَيَّ حَتَّى أَيْقَظَهُمَا الصُّبْحُ .         [21/163]      اللَّهُمَّ إِنْ كُنْتُ فَعَلْتُ ذَلِكَ لِوَجْهِكَ فَافْرُجْ عَنَّا "" .  قَالَ  النُّعْمَانُ  : لَكَأَنِّي أَسْمَعُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : "" فَقَالَ الْجَبَلُ : طَاقَ . فَفَرَّجَ اللهُ عَنْهُمْ فَخَرَجُوا  .","","Al-Mu'jam al-Kabir 206","","النعمان بن بشير الأنصاري عن وهب بن منبه عن عبد الله بن بحير بن ريسان المرادي عن محمد بن عبد الرحيم بن شروس الصنعاني عن إبراهيم بن محمد بن برة الصنعاني عن الطبراني","وهب بن منبه عن النعمان بن بشير"
"19483","207  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ بَرَّةَ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ بْنِ شَرُوسٍ ،  ثَنَا  رَبَاحُ بْنُ زَيْدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ سَعِيدِ بْنِ أَبِي عَاصِمٍ ،  عَنْ  وَهْبِ بْنِ مُنَبِّهٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 207","","النعمان بن بشير الأنصاري عن وهب بن منبه عن عبد الله بن سعيد بن أبي عاصم اليمني عن رباح بن زيد الصنعاني عن محمد بن عبد الرحيم بن شروس الصنعاني عن إبراهيم بن محمد بن برة الصنعاني عن الطبراني","وهب بن منبه عن النعمان بن بشير"
"19484","208  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عَلِيُّ بْنُ بَحْرٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَبْدِ الْكَرِيمِ ،  حَدَّثَنِي  عَبْدُ الصَّمَدِ بْنُ مَعْقِلٍ ، قَالَ :  سَمِعْتُ         [21/164]      وَهْبًا يَقُولُ :  حَدَّثَنِي  النُّعْمَانُ بْنُ بَشِيرٍ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَذْكُرُ الرَّقِيمَ ; قَالَ :  إِنَّ ثَلَاثَةَ نَفَرٍ كَانُوا فِي كَهْفٍ  ، فَوَقَعَ الْجَبَلُ عَلَى بَابِ الْكَهْفِ  فَأَوْصَدَهُ  عَلَيْهِمْ ، فَقَالَ قَائِلٌ مِنْهُمْ : تَذَكَّرُوا أَيُّكُمْ عَمِلَ حَسَنَةً لَعَلَّ اللهَ يَرْحَمُهُ بِرَحْمَتِهِ .  فَقَالَ رَجُلٌ مِنْهُمْ : قَدْ عَمِلْتُ حَسَنَةً مَرَّةً ; كَانَ لِي أُجَرَاءُ يَعْمَلُونَ عَمَلًا لِي ، فَاسْتَأْجَرْتُ كُلَّ رَجُلٍ مِنْهُمْ بِأَجْرٍ مَعْلُومٍ ، فَجَاءَنِي رَجُلٌ ذَاتَ يَوْمٍ وَسَطَ         [21/165]      النَّهَارِ ، فَاسْتَأْجَرْتُهُ بِشَرْطِ أَصْحَابِهِ ، فَعَمِلَ فِي بَقِيَّةِ نَهَارِهِ كَمَا عَمِلَ كُلُّ رَجُلٍ مِنْهُمْ فِي نَهَارِهِ كُلِّهِ ، فَرَأَيْتُ فِي الذِّمَامِ أَلَّا أَنْقُصَهُ مِمَّا اسْتَأْجَرْتُ بِهِ أَصْحَابَهُ ; لِمَا جَهِدَ فِي عَمَلِهِ ، فَقَالَ رَجُلٌ مِنْهُمْ : أَعْطَيْتَ هَذَا مِثْلَ مَا أَعْطَيْتَنِي وَلَمْ يَعْمَلْ إِلَّا نِصْفَ النَّهَارِ ؟ قُلْتُ : يَا عَبْدَ اللهِ ! لَمْ أَبْخَسْكَ شَيْئًا مِنْ شَرْطِكَ ، وَإِنَّمَا هُوَ مَالِي أَحْكُمُ فِيهِ بِمَا شِئْتُ . فَغَضِبَ وَذَهَبَ وَتَرَكَ أَجْرَهُ ، فَوَضَعْتُ حَقَّهُ فِي جَانِبٍ مِنَ الْبَيْتِ مَا شَاءَ اللهُ ، ثُمَّ مَرَّتْ بِي بَعْدَ ذَلِكَ بَقَرٌ ، فَاشْتَرَيْتُ بِهِ  فَصِيلَةً  مِنَ الْبَقَرِ ، فَبَلَغَتْ مَا شَاءَ اللهُ ، فَمَرَّ بِي بَعْدَ حِينٍ شَيْخٌ ضَعِيفٌ لَا أَعْرِفُهُ فَقَالَ : إِنَّ لِي عِنْدَكَ حَقًّا . فَذَكَرَهُ حَتَّى عَرَفْتُهُ ، فَقُلْتُ : إِيَّاكَ أَبْغِي ، هَذَا حَقُّكَ . فَعَرَضْتُهَا عَلَيْهِ جَمِيعًا . فَقَالَ : يَا عَبْدَ اللهِ ! أَتَسْخَرُ بِي ؟ ! إِنْ لَمْ  تَصَدَّقْ  عَلَيَّ فَأَعْطِنِي حَقِّي . قُلْتُ : وَاللهِ مَا أَسْخَرُ بِكَ ، إِنَّهَا حَقُّكَ ، مَا لِي مِنْهَا شَيْءٌ . فَدَفَعْتُهَا إِلَيْهِ جَمِيعًا . اللَّهُمَّ إِنْ كُنْتُ فَعَلْتُ ذَلِكَ لِوَجْهِكَ فَافْرُجْ عَنَّا . فَانْصَدَعَ الْجَبَلُ حَتَّى رَأَوُا الضَّوْءَ وَأَبْصَرُوا .  وَقَالَ الْآخَرُ : قَدْ عَمِلْتُ حَسَنَةً مَرَّةً ; كَانَ لِي فَضْلٌ فَأَصَابَ النَّاسَ شِدَّةٌ ، فَجَاءَتْنِي امْرَأَةٌ تَطْلُبُ مِنِّي مَعْرُوفًا ، فَقُلْتُ : وَاللهِ مَا هُوَ دُونَ نَفْسِكِ . فَأَبَتْ عَلَيَّ ، فَذَهَبَتْ ، ثُمَّ رَجَعَتْ فَذَكَّرَتْنِي بِاللهِ وَأَبَيْتُ عَلَيْهَا ، وَقُلْتُ : لَا وَاللهِ مَا هُوَ دُونَ نَفْسِكِ . فَأَبَتْ عَلَيَّ ، وَهَبَّتْ . فَذَكَرَتْ         [21/166]      لِزَوْجِهَا ، فَقَالَ لَهَا : أَعْطِيهِ نَفْسَكِ وَأَغْنِي عِيَالَكِ . فَرَجَعَتْ إِلَيَّ  فَنَشَدَتْنِي  بِاللهِ ، فَأَبَيْتُ عَلَيْهَا ، وَقُلْتُ : وَاللهِ مَا هُوَ دُونَ نَفْسِكِ . فَلَمَّا رَأَتْ ذَلِكَ أَسْلَمَتْ إِلَيَّ نَفْسَهَا ، فَلَمَّا كَشَفْتُهَا أَرْعَدَتْ مِنْ تَحْتِي ، فَقُلْتُ لَهَا : مَا شَأْنُكِ ؟ فَقَالَتْ : أَخَافُ اللهَ رَبَّ الْعَالَمِينَ . فَقُلْتُ لَهَا : خِفْتِيهِ فِي الشِّدَّةِ وَلَمْ أَخَفْهُ فِي  الرَّخَاءِ  ! فَتَرَكْتُهَا وَأَعْطَيْتُهَا بِالْحَقِّ عَلَيَّ بِمَا كَشَفْتُهَا . اللَّهُمَّ إِنْ كُنْتَ تَعْلَمُ أَنِّي كُنْتُ فَعَلْتُ ذَلِكَ لِوَجْهِكَ فَافْرُجْ عَنَّا . قَالَ : فَانْصَدَعَ حَتَّى عَرَفُوا وَتَبَيَّنَ لَهُمْ .  وَقَالَ الْآخَرُ : قَدْ عَمِلْتُ حَسَنَةً مَرَّةً ; كَانَ لِي أَبَوَانِ شَيْخَانِ كَبِيرَانِ : وَكَانَتْ لِي غَنَمٌ ، وَكُنْتُ أُطْعِمُ أَبَوَيَّ وَأَسْقِيهِمَا ، ثُمَّ رَجَعْتُ إِلَى غَنَمِي ، فَأَصَابَنِي يَوْمًا غَيْثٌ حَبَسَنِي ، فَلَمْ أَرُحْ حَتَّى أَمْسَيْتُ ، فَأَتَيْتُ فَأَخَذْتُ مِحْلَبِي فَحَلَبْتُ وَغَنَمِي قَائِمَةٌ ، فَمَضَيْتُ إِلَى أَبَوَيَّ فَوَجَدْتُهُمَا قَدْ نَامَا ، فَشَقَّ عَلَيَّ أَنْ أُوقِظَهُمَا ، وَشَقَّ عَلَيَّ أَنْ أَتْرُكَ غَنَمِي ، فَمَا بَرِحْتُ         [21/167]      جَالِسًا وَمِحْلَبِي عَلَى يَدَيَّ حَتَّى أَيْقَظَهُمَا الصُّبْحُ فَسَقَيْتُهُمَا . اللَّهُمَّ إِنْ كُنْتُ فَعَلْتُ ذَلِكَ لِوَجْهِكَ فَافْرُجْ عَنَّا "" .  قَالَ  النُّعْمَانُ  : كَأَنِّي أَسْمَعُ هَذِهِ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : "" قَالَ الْجَبَلُ : طَاقْ طَاقْ . فَفَرَّجَ اللهُ عَزَّ وَجَلَّ عَنْهُمْ فَخَرَجُوا  .","","Al-Mu'jam al-Kabir 208","","النعمان بن بشير الأنصاري عن وهب بن منبه عن عبد الصمد بن معقل عن إسماعيل بن عبد الكريم الصنعاني عن علي بن بحر بن بري القطان عن الحسين بن إسحاق التستري عن الطبراني","وهب بن منبه عن النعمان بن بشير"
"19485","[21/168]      209  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ;  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ  بِبَشِيرِ بْنِ سَعْدٍ أَبِي النُّعْمَانِ  وَمَعَهُ ابْنُهُ  النُّعْمَانُ  ، فَقَالَ : اشْهَدْ أَنِّي قَدْ نَحَلْتُهُ  عَبْدًا أَوْ أَمَةً  - قَالَ : "" أَلَكَ وَلَدٌ غَيْرُهُ ؟ "" ، قَالَ : نَعَمْ ، قَالَ : "" فَنَحَلْتَهُمْ مِثْلَ مَا نَحَلْتَهُ ؟ "" ، قَالَ : لَا ، قَالَ :  فَإِنِّي لَا أَشْهَدُ إِلَّا عَلَى الْحَقِّ  ! "" .","","Al-Mu'jam al-Kabir 209","","طاوس بن كيسان عن عبد الله بن طاووس عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن النعمان بن بشير"
"19486","[21/169]      210  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ، قَالَ :  قَرَأْتُ عَلَى  إِبْرَاهِيمَ بْنِ سَعِيدٍ الْجَوْهَرِيِّ ،  ثَنَا  رَيْحَانُ بْنُ سَعِيدٍ ،  ثَنَا  عَبَّادُ بْنُ مَنْصُورٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  أَبِي صَالِحٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ; أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ يَوْمًا:  إِنَّ اللهَ كَتَبَ كِتَابًا قَبْلَ أَنْ يَخْلُقَ السَّمَاوَاتِ وَالْأَرْضَ بِأَلْفَيْ سَنَةٍ  ، وَهُوَ عِنْدَ الْعَرْشِ ، وَإِنَّهُ أَنْزَلَ مِنْ ذَلِكَ الْكِتَابِ آيَتَيْنِ خَتَمَ بِهِمَا سُورَةَ الْبَقَرَةِ ، وَإِنَّ الشَّيْطَانَ لَا يَلِجُ بَيْتًا قُرِئَتَا فِيهِ ثَلَاثَ لَيَالٍ  .","","Al-Mu'jam al-Kabir 210","","النعمان بن بشير الأنصاري عن أبو صالح الحارثي عن أبو قلابة الجرمي عن أيوب السختياني عن عباد بن منصور الناجي عن ريحان بن سعيد الناجي عن إبراهيم بن سعيد الجوهري عن عبد الله بن أحمد الجواليقي عن الطبراني","أبو صالح الحارثي عن النعمان بن بشير"
"19487","[21/170]      211  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  عَنْ  مُعَاوِيَةَ بْنِ صَالِحٍ ، قَالَ :  حَدَّثَنِي  نُعَيْمُ بْنُ زِيَادٍ أَبُو طَلْحَةَ الْأَنْمَارِيُّ ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ عَلَى مِنْبَرِ  حِمْصَ  يَقُولُ :  قُمْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَيْلَةَ سَابِعَةٍ وَعِشْرِينَ حَتَّى ظَنَنَّا أَنَّهُ يَفُوتُنَا  الْفَلَاحُ  ، وَكُنَّا نَعُدُّهُ السُّحُورَ ، فَأَنْتُمْ تَقُولُونَ : لَيْلَةُ سَابِعَةٍ لَيْلَةُ         [21/171]      تِسْعٍ وَعِشْرِينَ ، وَنَحْنُ نَقُولُ : لَيْلَةُ سَابِعَةٍ لَيْلَةُ سَبْعٍ وَعِشْرِينَ ، فَأَيُّنَا أَصْوَبُ ; نَحْنُ أَوْ أَنْتُمْ  ؟ .","","Al-Mu'jam al-Kabir 211","","النعمان بن بشير الأنصاري عن نعيم بن زياد الأنماري عن معاوية بن صالح بن حدير الحضرمي عن زيد بن الحباب العكلي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","نعيم بن زياد أبو طلحة الأنصاري ويقال الأنماري عن النعمان"
"19488","[21/172]      212  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ الْبَصْرِيُّ ،  ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  ثَنَا  أَشْعَثُ بْنُ عَبْدِ الرَّحْمَنِ الْجَرْمِيُّ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  أَبِي الْأَشْعَثِ الصَّنْعَانِيِّ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  كَتَبَ اللهُ كِتَابًا قَبْلَ أَنْ يَخْلُقَ السَّمَاوَاتِ وَالْأَرْضَ بِأَلْفَيْ عَامٍ  ، فَأَنْزَلَ مِنْهُ آيَتَيْنِ خَتَمَ بِهِمَا سُورَةَ الْبَقَرَةِ ، فَلَا تُقْرَآنِ فِي دَارٍ ثَلَاثَ لَيَالٍ فَيَقْرَبُهَا شَيْطَانٌ  .","","Al-Mu'jam al-Kabir 212","","النعمان بن بشير الأنصاري عن شراحيل بن آدة الأبناوي عن أبو قلابة الجرمي عن أشعث بن عبد الرحمن الجرمي عن حماد بن سلمة عن هدبة بن خالد عن أحمد بن عمرو بن حفص القريعي عن الطبراني","أبو الأشعث الصنعاني عن النعمان"
"19489","[21/173]      213  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ نَافِعٍ الطَّحَّانُ الْمِصْرِيُّ ،  ثَنَا  مُؤَمَّلُ بْنُ إِهَابٍ ،  ثَنَا  عُثْمَانُ بْنُ سَعِيدِ بْنِ كَثِيرِ بْنِ دِينَارٍ الْحِمْصِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عِرْقٍ الْيَحْصِبِيُّ ،  عَنْ  أَبِيهِ  ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ :  أُهْدِيَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عِنَبٌ مِنَ  الطَّائِفِ  ، فَأَعْطَانِي عُنْقُودًا وَقَالَ : "" اذْهَبْ بِهِ إِلَى أُمِّكَ "" ، فَأَكَلْتُهُ فِي الطَّرِيقِ ، فَقَالَ : "" مَا فَعَلَ الْعُنْقُودُ ؟ "" فَقُلْتُ : أَكَلْتُهُ ، فَسَمَّانِي  غُدَرَ  .","","Al-Mu'jam al-Kabir 213","","النعمان بن بشير الأنصاري عن عبد الرحمن بن عرق اليحصبي عن محمد بن عبد الرحمن بن عرق اليحصبي عن عثمان بن سعيد بن كثير عن مؤمل بن إهاب عن أحمد بن محمد بن نافع الطحاوي عن الطبراني","عبد الرحمن بن عرق اليحصبي عن النعمان"
"19490","[21/174]      214  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عَلِيُّ بْنُ بَحْرٍ ،  ثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  عَنْ  سَعِيدِ بْنِ سِنَانٍ ،  عَنْ  أَبِيهِ  ،  أَنَّهُ سَمِعَ  النُّعْمَانَ بْنَ بَشِيرٍ يَقُولُ :  بَعَثَنِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى أُمِّي بِعُنْقُودٍ مِنْ عِنَبٍ  ، ثُمَّ سَأَلَنِي عَنْهُ بَعْدُ ، فَأَخْبَرْتُهُ أَنِّي أَكَلْتُهُ ، فَقَالَ لِيَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  غُدَرُ  .","","Al-Mu'jam al-Kabir 214","","النعمان بن بشير الأنصاري عن أبو سعيد بن سنان الحمصي عن سعيد بن سنان الحمصي عن محمد بن شعيب بن شابور القرشي عن علي بن بحر بن بري القطان عن الحسين بن إسحاق التستري عن الطبراني","سنان أبو سعيد عن النعمان بن بشير"
"19491","[21/175]      215  -  حَدَّثَنَا  أَحْمَدُ بْنُ خُلَيْدٍ الْحَلَبِيُّ ،  ثَنَا  أَبُو تَوْبَةَ الرَّبِيعُ بْنُ نَافِعٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ سَلَّامٍ ،  عَنْ  زَيْدِ بْنِ سَلَّامٍ ،  أَنَّهُ سَمِعَ  أَبَا سَلَّامٍ  يَقُولُ :  حَدَّثَنِي  النُّعْمَانُ بْنُ بَشِيرٍ ،  قَالَ  :  كُنْتُ عِنْدَ مِنْبَرِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ رَجُلٌ : مَا  أُبَالِي  أَلَّا أَعْمَلَ عَمَلًا بَعْدَ الْإِسْلَامِ إِلَّا أَنْ أَسْقِيَ الْحَاجَّ . وَقَالَ رَجُلٌ : مَا  أُبَالِي  أَلَّا أَعْمَلَ عَمَلًا بَعْدَ الْإِسْلَامِ إِلَّا أَنْ أَعْمُرَ الْمَسْجِدَ الْحَرَامَ . وَقَالَ آخَرُ :  الْجِهَادُ  فِي  سَبِيلِ  اللهِ أَفْضَلُ مِمَّا قُلْتُمْ .  فَزَجَرَهُمْ  عُمَرُ ، وَقَالَ :  لَا تَرْفَعُوا أَصْوَاتَكُمْ عِنْدَ مِنْبَرِ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَوْمُ الْجُمُعَةِ ، وَلَكِنْ إِذَا صَلَّيْتُ الْجُمُعَةَ دَخَلْتُ فَاسْتَفْتَيْتُهُ فِيمَا اخْتَلَفْتُمْ فِيهِ . فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ :         {      أَجَعَلْتُمْ سِقَايَةَ الْحَاجِّ وَعِمَارَةَ الْمَسْجِدِ الْحَرَامِ كَمَنْ آمَنَ بِاللهِ         }      ...  الْآيَةَ  .","","Al-Mu'jam al-Kabir 215","","عمر بن الخطاب عن النعمان بن بشير الأنصاري عن ممطور الحبشي عن زيد بن سلام الحبشي عن معاوية بن سلام عن الربيع بن نافع الحلبي عن أحمد بن خليد بن يزيد الحلبي عن الطبراني","أبو سلام الحبشي عن النعمان بن بشير"
"19492","[21/176]      216  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مُسْلِمُ بْنُ عَبْدِ الْمَلِكِ الْحَضْرَمِيُّ الْحِمْصِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ حِمْيَرَ ،  ثَنَا  صَفْوَانُ بْنُ عَمْرٍو السَّكْسَكِيُّ ، قَالَ :  خَرَجْنَا فِي جِنَازَةٍ فَإِذَا أَهْلُهَا يُدْخِلُونَهَا الْقَبْرَ مِمَّا يَلِي الْقِبْلَةَ ،  فَقَالَ  : كَرِبُ الْيَحْصَبِيُّ :  قَالَ  النُّعْمَانُ بْنُ بَشِيرٍ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ لِكُلِّ بَيْتٍ بَابًا ، وَبَابُ الْقَبْرِ مِنْ تِلْقَاءِ رِجْلَيْهِ  .","","Al-Mu'jam al-Kabir 216","","النعمان بن بشير الأنصاري عن كرب اليحصبي عن صفوان بن عمرو السكسكي عن محمد بن حمير القضاعي عن مسلم بن عبد الملك الحضرمي الحمصي عن الحسين بن إسحاق التستري عن الطبراني","كرب اليحصبي عن النعمان بن بشير"
"19493","[22/9]      بَابُ الْوَاوِ  وَائِلُ بْنُ حُجْرٍ الْحَضْرَمِيُّ الْقَيْلُ  عَلْقَمَةُ بْنُ وَائِلٍ  ، عَنْ أَبِيهِ  مُوسَى بْنِ عُمَيْرٍ  ، عَنْ  عَلْقَمَةَ  1  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  نَا  مُوسَى بْنُ عُمَيْرٍ الْعَنْبَرِيُّ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلِ بْنِ حُجْرٍ ،  عَنْ  أَبِيهِ وَائِلِ بْنِ حُجْرٍ  :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا قَامَ فِي الصَّلَاةِ قَبَضَ عَلَى شِمَالِهِ بِيَمِينِهِ  ، قَالَ :  وَرَأَيْتُ  عَلْقَمَةَ  يَفْعَلُهُ  .","","Al-Mu'jam al-Kabir 1","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن موسى بن عمير التميمي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","موسى بن عمير عن علقمة"
"19494","حُجْرُ بْنُ الْعَنْبَسِ  ، عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ  2  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدِ بْنِ حَرْبٍ الْعَبَّادَانِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  نَا  شُعْبَةُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  حُجْرِ بْنِ الْعَنْبَسِ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  : "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُسَلِّمُ عَنْ يَمِينِهِ وَعَنْ يَسَارِهِ  .","","Al-Mu'jam al-Kabir 2","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن حجر بن العنبس الحضرمي عن سلمة بن كهيل الحضرمي عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن جعفر بن محمد بن حرب العباداني عن الطبراني","حجر بن العنبس عن علقمة بن وائل"
"19495","3  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ السِّيُوطِيُّ  ، ثَنَا  عَفَّانُ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  حُجْرٍ أَبِي الْعَنْبَسِ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  : أَنَّهُ  صَلَّى مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَلَمَّا قَالَ :         {      غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ         }      قَالَ : آمِينَ خَفَضَ بِهَا صَوْتَهُ  .","","Al-Mu'jam al-Kabir 3","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن حجر بن العنبس الحضرمي عن سلمة بن كهيل الحضرمي عن شعبة بن الحجاج عن عفان بن مسلم الصفار عن أحمد بن محمد بن مهران السوطي عن الطبراني","حجر بن العنبس عن علقمة بن وائل"
"19496","جَامِعُ بْنُ مَطَرٍ  ، عَنْ  عَلْقَمَةَ  4  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  نَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ، (  ح  )         [22/10]      وَحَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ ،  نَا  سَعِيدُ بْنُ سُلَيْمَانَ النَّشِيطِيُّ ، قَالَا :  أَنَا  جَامِعُ بْنُ مَطَرٍ ،  ثَنَا  عَلْقَمَةُ بْنُ وَائِلٍ ،  عَنْ  أَبِيهِ  :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَقْطَعَهُ أَرْضًا  بِحَضْرَمَوْتَ  .","","Al-Mu'jam al-Kabir 4","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن جامع بن مطر الحبطي عن سعيد بن سليمان النشيطي عن أحمد بن داود بن موسى السدوسي عن الطبراني","جامع بن مطر عن علقمة"
"19497","5  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، وَأَبُو خَلِيفَةَ قَالَا :  ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ النَّشِيطِيُّ ، قَالَا :  نَا  جَامِعُ بْنُ مَطَرٍ قَالَ :  ثَنَا  عَلْقَمَةُ بْنُ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  كُنَّا قُعُودًا عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَجَاءَ  رَجُلٌ  فِي عُنُقَهِ  نِسْعَةٌ  ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّ هَذَا وَأَخِي كَانَا فِي جُبٍّ يَحْفُرَانِهِ ، فَوَقَعَ الْمِنْقَارُ فَضَرَبَ بِهِ رَأْسَ صَاحِبِهِ فَقَتَلَهُ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" اعْفُ عَنْهُ "" فَأَبَى ثُمَّ قَامَ فَذَكَرَ مِثْلَ الْكَلَامِ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" اعْفُ عَنْهُ "" فَأَبَى ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" اذْهَبْ بِهِ ، فَإِنْ قَتَلْتَهُ كُنْتَ  مِثْلَهُ  "" فَخَرَجَ بِهِ حَتَّى جَاوَزَ ، فَنَادَاهُ أَلَا تَسْمَعُ مَا يَقُولُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَرَجَعَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِنْ قَتَلْتَهُ كُنْتَ  مِثْلَهُ  "" قَالَ : نَعَمْ ، أَعْفُو عَنْهُ فَخَرَجَ يَجُرُّ  نِسْعَتَهُ  حَتَّى خَفِيَ عَلَيْنَا  .","","Al-Mu'jam al-Kabir 5","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن جامع بن مطر الحبطي عن سعيد بن سليمان النشيطي عن أحمد بن داود بن موسى السدوسي عن الطبراني","جامع بن مطر عن علقمة"
"19498","حَمْزَةُ أَبُو عُمَرَ الْعَائِذِيُّ  ، عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ  6  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ،  ثَنَا  هَوْذَةُ بْنُ خَلِيفَةَ ،  ثَنَا  عَوْفُ بْنُ أَبِي جَمِيلَةَ ،  عَنْ  حَمْزَةَ أَبُو عُمَرَ الْعَائِذِيُّ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ         [22/11]      قَالَ :  شَهِدْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِينَ جِيءَ  بِالرَّجُلِ  فِي  نِسْعَةٍ  يُقَادُ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِوَلِيِّ الْمَقْتُولِ  : "" أَتَعْفُو عَنْهُ ؟ "" قَالَ : لَا ، قَالَ : "" فَتَأْخُذُ الدِّيَةَ ؟ "" قَالَ : لَا ، قَالَ : فَتَقْتُلُهُ ؟ قَالَ : نَعَمْ ، قَالَ : فَاذْهَبْ بِهِ ، فَتَوَلَّى مِنْ عِنْدِهِ ، قَالَ : تَعَالَ ، أَتَعْفُو ؟ مِثْلَ قَوْلِهِ الْأَوَّلِ ، فَقَالَ وَلِيُّ الْمَقْتُولِ مِثْلَ قَوْلِهِ ثَلَاثَ مَرَّاتٍ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عِنْدَ الرَّابِعَةِ : "" أَمَا إِنَّكَ إِنْ عَفَوْتَ فَإِنَّهُ  يَبُوءُ  بِإِثْمِكَ وَإِثْمِ صَاحِبِكَ "" فَتَرَكَهُ ، قَالَ : فَأَنَا رَأَيْتُهُ يَجُرُّ  نِسْعَتَهُ  .","","Al-Mu'jam al-Kabir 6","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن حمزة بن عمرو العائذي عن عوف بن أبي جميلة عن هوذة بن خليفة البكراوي عن لحية الليف محمد بن العباس عن الطبراني","حمزة أبو عمر العائذي عن علقمة بن وائل"
"19499","إِسْمَاعِيلُ بْنُ سَالِمٍ  ، عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ  7  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ لُوَيْنٌ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ  ، ثَنَا  الْحَسَنُ بْنُ عَلِيِّ بْنِ رَاشِدٍ الْوَاسِطِيُّ قَالَا :  ثَنَا  هُشَيْمٌ ،  عَنْ  إِسْمَاعِيلَ بْنِ سَالِمٍ قَالَ :  وَحَدَّثَنِي  عَلْقَمَةُ بْنُ وَائِلٍ الْحَضْرَمِيُّ ،  عَنْ  أَبِيهِ وَائِلِ بْنِ حُجْرٍ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ  أُتِيَ  بِرَجُلٍ  قَتَلَ  قَتِيلًا  ، فَدَفَعَ الْقَاتِلَ إِلَى  وَلِيِّ الْمَقْتُولِ  لِيَقْتُلَهُ ، فَلَمَّا انْطَلَقَ بِهِ ، وَفِي عُنُقِهِ  نِسْعَةٌ  قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِجُلَسَائِهِ :  الْقَاتِلُ وَالْمَقْتُولُ فِي النَّارِ  فَانْطَلَقَ إِلَيْهِ رَجُلٌ وَذَكَرَ لَهُ مَا قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَخَلَّى سَبِيلَهُ ، فَلَقَدْ رَأَيْتُهُ حِينَ خَلَّى سَبِيلَهُ ، وَهُوَ يَنْطَلِقُ يَجُرُّ  نِسْعَتَهُ  .  قَالَ  إِسْمَاعِيلُ  : فَذَكَرْتُ ذَلِكَ لِحَبِيبِ بْنِ أَبِي ثَابِتٍ ،  فَقَالَ  :  عَنِ  ابْنِ أَشْوَعَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَ ذَلِكَ الرَّجُلَ بِالْعَفْوِ ، فَكَأَنَّهُ لَمْ يَفْعَلْ ، فَلَمَّا قِيلَ لَهُ مَا قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَلَّى عَنْهُ  .","","Al-Mu'jam al-Kabir 7","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن إسماعيل بن سالم الأسدي عن هشيم بن بشير عن الحسن بن علي بن راشد الواسطي عن أحمد بن عمرو بن حفص القريعي عن الطبراني","إسماعيل بن سالم عن علقمة بن وائل"
"19500","[22/12]      عَمْرُو بْنُ مُرَّةَ  ، عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ  ، عَنْ أَبِيهِ  8  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  حُصَيْنٍ قَالَ :  ذَكَرَ  عَمْرُو بْنُ مُرَّةَ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  رَفْعِ يَدَيْهِ لِلصَّلَاةِ  قَالَ  حُصَيْنٌ  : فَقَالَ  إِبْرَاهِيمُ  : مَا أَدْرِي لَعَلَّ  وَائِلًا  لَمْ يَرَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ غَيْرَ ذَلِكَ الْيَوْمِ ، فَكَيْفَ حَفِظَهُ ؟ وَلَمْ يَحْفَظْهُ  عَبْدُ اللهِ  وَأَصْحَابُهُ ؟ هُوَ أَعْلَمُ بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمْ  عَبْدُ اللهِ  ؟ فَإِنَّمَا كَانَ يَرْفَعُ يَدَيْهِ افْتِتَاحًا  .","","Al-Mu'jam al-Kabir 8","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن عمرو بن مرة المرادي عن حصين بن عبد الرحمن السلمي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","عمرو بن مرة عن علقمة بن وائل عن أبيه"
"19501","9  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  خَالِدٌ ،  ثَنَا  حُصَيْنٌ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ قَالَ : دَخَلْتُ مَسْجِدَ  حَضْرَمَوْتَ  ، فَإِذَا  عَلْقَمَةُ بْنُ وَائِلٍ  يُحَدِّثُ  عَنْ  أَبِيهِ  : "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَرْفَعُ يَدَيْهِ قَبْلَ الرُّكُوعِ وَبَعْدَهُ  فَذَكَرْتُ ذَلِكَ  لِإِبْرَاهِيمَ  ، فَغَضِبَ وَقَالَ : رَآهُ وَلَمْ يَرَهُ  ابْنُ مَسْعُودٍ  وَأَصْحَابُهُ ؟  .","","Al-Mu'jam al-Kabir 9","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن عمرو بن مرة المرادي عن حصين بن عبد الرحمن السلمي عن خالد بن عبد الله الطحان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن مرة عن علقمة بن وائل عن أبيه"
"19502","10  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مَتُّوَيْهِ الْأَصْبَهَانِيُّ  ، ثَنَا  الْيَمَانُ بْنُ سَعِيدٍ الْمِصِّيصِيُّ ،  ثَنَا  أَشْعَثُ بْنُ شُعْبَةَ ،  ثَنَا  وَرْقَاءُ بْنُ عُمَرَ ،  عَنْ  حُصَيْنٍ قَالَ : كَانَ عَمْرُو بْنُ مُرَّةَ  يُحَدِّثُهُمْ  ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِينَ قَامَ إِلَى الصَّلَاةِ رَفَعَ يَدَيْهِ  ، وَحِينَ رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ فَعَلَ ذَلِكَ  .","","Al-Mu'jam al-Kabir 10","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن عمرو بن مرة المرادي عن حصين بن عبد الرحمن السلمي عن ورقاء بن عمر عن أشعث بن شعبة المصيصي عن يمان بن سعيد المصيصي عن إبراهيم بن محمد الطيان عن الطبراني","عمرو بن مرة عن علقمة بن وائل عن أبيه"
"19503","[22/13]      أَبُو إِسْحَاقَ السَّبِيعِيُّ  ، عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ  11  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عُمَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ الْأَسَدِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  ، أَنَّهُ  سَمِعَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمَّا قَالَ :         {      وَلا الضَّالِّينَ         }      قَالَ : آمِينَ  .","","Al-Mu'jam al-Kabir 11","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","أبو إسحاق السبيعي عن علقمة بن وائل"
"19504","سِمَاكُ بْنُ حَرْبٍ  ، عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ  12  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ، وَيُوسُفُ الْقَاضِي قَالَا :  حَدَّثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَقْطَعَهُ أَرْضًا  بِحَضْرَمَوْتَ  .","","Al-Mu'jam al-Kabir 12","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن سماك بن حرب البكري عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سماك بن حرب عن علقمة بن وائل"
"19505","13  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  يَحْيَى بْنُ مَعِينٍ قَالَ  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  أَقْطَعَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَرْضًا  ، فَأَرْسَلَ مَعِي  مُعَاوِيَةَ  وَقَالَ : "" أَعْلِمْهَا إِيَّاهُ وَأَعْطِهِ إِيَّاهُ "" قَالَ لِي  مُعَاوِيَةُ  : أَرْدِفْنِي خَلْفَكَ ، قُلْتُ : لَا تَكُونُ مِنْ أَرْدَافِ الْمُلُوكِ ، قَالَ : أَعْطِنِي نَعْلَكَ أَنْتَعِلُ بِهَا ، قُلْتُ : انْتَعِلْ بِظِلِّ النَّاقَةِ ، فَلَمَّا اسْتُخْلِفَ  مُعَاوِيَةُ  أَتَيْتُهُ فَأَقْعَدَنِي مَعَهُ عَلَى السَّرِيرِ ، ثُمَّ ذَكَّرَنِي الْحَدِيثَ ، قَالَ  سِمَاكٌ  : قَالَ : وَدِدْتُ أَنِّي كُنْتُ حَمَلْتُهُ بَيْنَ يَدَيَّ  .","","Al-Mu'jam al-Kabir 13","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن يحيى بن معين عن معاذ بن المثنى العنبري عن الطبراني","سماك بن حرب عن علقمة بن وائل"
"19506","14  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ، (  ح  )         [22/14]      وَحَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ ، وَمُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ قَالَا :  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ قَالَا :  ثَنَا  شُعْبَةُ بْنُ الْحَجَّاجِ ، أَنَّ سِمَاكَ بْنَ حَرْبٍ ،  أَخْبَرَنِي  ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَقُولُوا لِلْعِنَبِ الْكَرْمَ  ، وَلَكِنْ قُولُوا  الْحَبَلَةُ  أَوِ  الْحَبَلُ  .","","Al-Mu'jam al-Kabir 14","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن سماك بن حرب البكري عن شعبة بن الحجاج عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","سماك بن حرب عن علقمة بن وائل"
"19507","15  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ، وَيُوسُفُ الْقَاضِي ، قَالَا :  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  شَهِدْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَسَأَلَهُ  سُوَيْدُ بْنُ طَارِقٍ  عَنِ الْخَمْرِ ، فَنَهَاهُ ، فَقَالَ : نَتَدَاوَى بِهَا وَيُجْعَلُ فِي الدَّوَاءِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَتْ  بِدَوَاءٍ  وَلَكِنَّهَا دَاءٌ  .","","Al-Mu'jam al-Kabir 15","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن سماك بن حرب البكري عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سماك بن حرب عن علقمة بن وائل"
"19508","16  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  قَدِمَ  يَزِيدُ بْنُ سَلَمَةَ  عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ،  إِنَّ لَنَا كُرُومًا كَثِيرَةً فَهَلَّا نَعْصِرُهَا فَنَبِيعُهَا ، وَنَسْتَشْفِي بِهَا ؟ قَالَ : "" لَا هِيَ دَاءٌ  .","","Al-Mu'jam al-Kabir 16","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","سماك بن حرب عن علقمة بن وائل"
"19509","17  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ، (  ح  )  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَالِمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ قَالُوا :  ثَنَا  أَبُو الْأَحْوَصِ ،  ثَنَا  سِمَاكُ بْنُ حَرْبٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلِ بْنِ حُجْرٍ ،  عَنْ  أَبِيهِ  قَالَ :  جَاءَ  رَجُلٌ مِنْ حَضْرَمَوْتَ         [22/15]      وَرَجُلٌ مِنْ كِنْدَةَ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ الْحَضْرَمِيُّ : يَا رَسُولَ اللهِ ، هَذَا قَدْ غَلَبَنِي عَلَى أَرْضٍ كَانَتْ لِأَبِي ، فَقَالَ الْكِنْدِيُّ : هِيَ أَرْضِي فِي يَدِي أَزْرَعُهَا لَيْسَ لَهُ فِيهَا حَقٌّ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَلَكَ بَيِّنَةٌ "" ؟ قَالَ : لَا ، قَالَ : "" فَلَكَ يَمِينُهُ "" قَالَ : يَا رَسُولَ اللهِ ، إِنَّهُ رَجُلٌ فَاجِرٌ لَا  يُبَالِي  مَا حَلَفَ عَلَيْهِ لَيْسَ يَتَوَرَّعُ مِنْ شَيْءٍ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَيْسَ لَكَ مِنْهُ إِلَّا ذَلِكَ "" فَانْطَلَقَ لِيَحْلِفَ فَلَمَّا أَدْبَرَ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَمَا إِنَّهُ إِنْ حَلَفَ عَلَى مَالِهِ لِيَأْكُلَهُ ظُلْمًا لَيَلْقَيَنَّ اللهَ وَهُوَ عَنْهُ مُعْرِضٌ  .","","Al-Mu'jam al-Kabir 17","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","سماك بن حرب عن علقمة بن وائل"
"19510","18  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَمْرُو بْنُ حَمَّادِ بْنِ طَلْحَةَ الْقَنَّادُ ،  ثَنَا  أَسْبَاطُ بْنُ نَصْرٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلِ بْنِ حُجْرٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ  امْرَأَةً  وَقَعَ عَلَيْهَا  رَجُلٌ  فِي سَوَادِ الصُّبْحِ ، وَهِيَ تَعْمِدُ إِلَى الْمَسْجِدِ يَغْصِبُهَا عَلَى نَفْسِهَا ، فَاسْتَعَانَتْ  بِرَجُلٍ  مَرَّ عَلَيْهَا ، وَفَرَّ صَاحِبُهَا ، ثُمَّ مَرَّ عَلَيْهَا قَوْمٌ ذُو عِدَّةٍ فَاسْتَعَانَتْ بِهِمْ ، فَأَدْرَكُوا الَّذِي اسْتَعَانَتْ بِهِ ، وَسَبَقَهُمُ الْآخَرُ ، فَأَتَوْا بِهِ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَخْبَرَتْهُ أَنَّهُ وَقَعَ عَلَيْهَا ، وَأَخْبَرَهُ  الْقَوْمُ  أَنَّهُمْ أَدْرَكُوهُ يَشْتَدُّ ، فَقَالَ : إِنَّمَا كُنْتُ أُعِينُهَا عَلَى صَاحِبِهَا ، فَأَدْرَكُونِي هَؤُلَاءِ فَأَخَذُونِي ، قَالَتْ : كَذَبَ ، هُوَ الَّذِي وَقَعَ عَلَيَّ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" اذْهَبُوا بِهِ فَارْجُمُوهُ "" فَقَامَ رَجُلٌ مِنَ النَّاسِ فَقَالَ : لَا تَرْجُمُوهُ ، وَلَأَنَا الَّذِي فَعَلْتُ بِهَا الْفِعْلَ ، فَاعْتَرَفَ فَاجْتَمَعَ ثَلَاثَةٌ عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، الَّذِي وَقَعَ عَلَيْهَا ، وَالَّذِي أَعَانَهَا ، وَالْمَرْأَةُ ، فَقَالَ : "" أَمَّا أَنْتَ فَقَدْ غُفِرَ لَكَ "" وَقَالَ لِلَّذِي أَعَانَهَا قَوْلًا حَسَنًا ، فَقَالَ  عُمَرُ  : ارْجُمِ الَّذِي اعْتَرَفَ بِالزِّنَا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ         [22/16]      وَسَلَّمَ :  أَلَا إِنَّهُ قَدْ تَابَ إِلَى اللهِ تَوْبَةً لَوْ تَابَهَا  أَهْلُ يَثْرِبَ  لَقُبِلَ مِنْهُمْ  .","","Al-Mu'jam al-Kabir 18","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن سماك بن حرب البكري عن أسباط بن نصر الهمداني عن عمرو بن حماد القناد عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","سماك بن حرب عن علقمة بن وائل"
"19511","19  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  :  أَنَّ  امْرَأَةً  خَرَجَتْ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تُرِيدُ الصَّلَاةَ فَلَقِيَهَا  رَجُلٌ  فَقَضَى حَاجَتَهُ مِنْهَا ، فَصَاحَتْ فَانْطَلَقَ فَمَرَّ عَلَيْهَا  رَجُلٌ  ، فَقَالَتْ : إِنَّ ذَاكَ الرَّجُلَ فَعَلَ بِي كَذَا وَكَذَا ، فَانْطَلَقُوا فَأَخَذُوا الرَّجُلَ الَّذِي ظَنَّتْ أَنَّهُ وَقَعَ عَلَيْهَا ، فَقَالُوا : هَذَا؟ فَقَالَتْ : نَعَمْ ، هُوَ هَذَا ، فَأَتَوْا بِهِ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا أَمَرَ بِهِ أَنْ يُرْجَمَ ، قَامَ صَاحِبُهَا الَّذِي وَقَعَ عَلَيْهَا قَالَ : أَنَا صَاحِبُهَا ، قَالَ : "" ادْنُ مِنِّي فَقَدْ غَفَرَ اللهُ لَكَ "" وَقَالَ لِلرَّجُلِ الْآخَرِ قَوْلًا حَسَنًا ، فَقَالُوا لَهُ فِي الرَّجُلِ الَّذِي وَقَعَ عَلَيْهَا : أَتَرْجُمُهُ ؟ فَقَالَ :  لَقَدْ تَابَ تَوْبَةً لَوْ تَابَهَا  أَهْلُ الْمَدِينَةِ  قُبِلَ مِنْهُمْ  .","","Al-Mu'jam al-Kabir 19","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","سماك بن حرب عن علقمة بن وائل"
"19512","20  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  سَأَلَ  سَلَمَةُ بْنُ يَزِيدَ اللَّيْثِيُّ  فَقَالَ : يَا رَسُولَ اللهِ ، أَرَأَيْتَ إِنْ قَامَتْ عَلَيْنَا أُمَرَاءُ يَسْأَلُونَا حَقَّهُمْ وَيَمْنَعُونَا حَقَّنَا ، فَمَا تَأْمُرُنَا ؟ فَأَعْرَضَ عَنْهُ ، ثُمَّ سَأَلَهُ فَأَعْرَضَ عَنْهُ ، ثُمَّ سَأَلَهُ  الثَّانِيَةَ أَوِ الثَّالِثَةَ  فَقَالَ :  اسْمَعُوا وَأَطِيعُوا ، فَإِنَّمَا عَلَيْهِمْ مَا حُمِّلُوا وَعَلَيْكُمْ مَا حُمِّلْتُمْ  .","","Al-Mu'jam al-Kabir 20","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن يحيى بن معين عن معاذ بن المثنى العنبري عن الطبراني","سماك بن حرب عن علقمة بن وائل"
"19513","21  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو الْأَحْوَصِ ، وَشَرِيكٌ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  جَاءَ  يَزِيدُ بْنُ سَلَمَةَ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَخْطُبُ فَقَالَ :         [22/17]      يَا رَسُولَ اللهِ ، أَرَأَيْتَ إِنْ كَانَ عَلَيْنَا قَوْمٌ يَأْخُذُونَا بِالْحَقِّ وَيَمْنَعُونَا حَقَّ اللهِ ؟ فَسَكَتَ عَنْهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَلَمْ يُجِبْهُ ، ثُمَّ عَادَ الثَّانِيَةَ فَلَمْ يُجِبْهُ ، ثُمَّ عَادَ الثَّالِثَةَ فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  عَلَيْهِ مَا حُمِّلَ وَعَلَيْكُمْ مَا حُمِّلْتُمْ ، وَإِنْ تُطِيعُوهُ تَهْتَدُوا ، فَاسْمَعُوا لَهُ وَأَطِيعُوا  .","","Al-Mu'jam al-Kabir 21","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","سماك بن حرب عن علقمة بن وائل"
"19514","22  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  عَنْ  يَزِيدَ بْنِ عَطَاءٍ ،  عَنْ  سِمَاكٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : إِنَّ هَذَا قَتَلَ أَخِي يَا رَسُولَ اللهِ ، قَالَ : "" كَيْفَ قَتَلْتَهُ ؟ "" قَالَ : ضَرَبْتُ رَأْسَهُ  بِالْفَأْسِ  ، وَلَمْ أُرِدْ قَتْلَهُ ، قَالَ :  هَلْ لَكَ مَالٌ تُؤَدِّي دِيَتَهُ ؟ "" قَالَ : لَا ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِلرَّجُلِ : "" خُذْهُ "" فَخَرَجَ بِهِ لِيَقْتُلَهُ  ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِنْ قَتَلَهُ كَانَ مِثْلَهُ "" فَرَجَعَ بِهِ حِينَ سَمِعَ قَوْلَهُ ، فَقَالَ : هُوَ هَذَا ، فَأْمُرْ بِهِ مَا شِئْتَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَرْسِلْهُ  .","","Al-Mu'jam al-Kabir 22","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن سماك بن حرب البكري عن يزيد بن عطاء بن يزيد اليشكري عن سعيد بن سليمان سعدويه عن أحمد بن يحيى بن إسحاق الحلواني عن الطبراني","سماك بن حرب عن علقمة بن وائل"
"19515","23  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ بُنْدَارٌ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَنْصَارِيُّ ،  ثَنَا  أَبُو يُونُسَ الْقُشَيْرِيُّ ،  ثَنَا  سِمَاكُ بْنُ حَرْبٍ : أَنَّ  عَلْقَمَةَ بْنَ وَائِلٍ ،  حَدَّثَهُ  عَنْ  أَبِيهِ  قَالَ :  بَيْنَمَا أَنَا عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذْ دَخَلَ  رَجُلٌ  يَقُودُ  رَجُلًا  بِنِسْعَةٍ  حَتَّى أَتَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا رَسُولَ اللهِ ، هَذَا قَتَلَ أَخِي ، قَالَ : "" أَقَتَلْتَهُ ؟ "" قَالَ : نَعَمْ ، قَالَ : "" كَيْفَ قَتَلْتَهُ ؟ "" قَالَ : كُنَّا نَحْتَطِبُ مِنْ شَجَرَةٍ فَسَبَّنِي ، فَضَرَبْتُهُ بِالْفَأْسِ عَلَى قَرْنِهِ فَقَتَلْتُهُ ، فَقَالَ : "" عِنْدَكَ مَالٌ تَدِيهِ عَنْ نَفْسِكَ ؟ "" قَالَ : لَا ، وَاللهِ مَا لِي مَالٌ إِلَّا فَأْسِي وَكِسَائِي قَالَ : "" أَتَرَى قَوْمَكَ يَدُونَكَ ؟ "" قَالَ :         [22/18]      أَنَا أَهْوَنُ عَلَى قَوْمِي مِنْ ذَاكَ ، فَرَمَى  بِنِسْعَتِهِ  إِلَيْهِ فَقَالَ : "" دُونَكَ صَاحِبَكَ "" فَلَمَّا وَلَّى قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِنْ قَتَلَهُ فَهُوَ مِثْلُهُ "" فَأَتَاهُ آتٍ فَقَالَ : وَيْلَكَ إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : "" إِنْ قَتَلَهُ فَهُوَ مِثْلُهُ "" قَالَ : يَا رَسُولَ اللهِ ، مَا أَخَذْتُهُ إِلَّا بِأَمْرِكَ ، فَقَالَ :  أَمَا تُرِيدُ أَنْ  يَبُوءَ  بِإِثْمِهِ وَإِثْمِ صَاحِبِكَ ؟ "" قَالَ : بَلَى يَا رَسُولَ اللهِ ، قَالَ : "" فَإِنَّهُ كَذَلِكَ "" فَرَمَى  نِسْعَتَهُ  وَقَالَ : "" اذْهَبْ حَيْثُ شِئْتَ  .","","Al-Mu'jam al-Kabir 23","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن سماك بن حرب البكري عن حاتم بن أبي صغيرة القشيري عن محمد بن عبد الله بن المثنى الخزرجي عن محمد بن بشار بندار عن أحمد بن يحيى بن زهير التستري عن الطبراني","سماك بن حرب عن علقمة بن وائل"
"19516","عَبْدُ الْمَلِكِ بْنُ عُمَيْرٍ  ، عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ  24  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ ، وَأَبُو خَلِيفَةَ قَالَا :  ثَنَا  إِبْرَاهِيمُ بْنُ أَبِي سُوَيْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ عُثْمَانَ ،  ثَنَا  عَبْدُ الْمَلِكِ بْنُ عُمَيْرٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ الْحَضْرَمِيِّ ،  عَنْ  أَبِيهِ  قَالَ :  اخْتَصَمَ  الْأَشْعَثُ بْنُ قَيْسٍ الْكِنْدِيُّ  وَرَجُلٌ مِنْ حَضْرَمَوْتَ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي أَرْضٍ فِي يَدِ  الْأَشْعَثِ بْنِ قَيْسِ الْكِنْدِيِّ  ادَّعَاهَا الْحَضْرَمِيُّ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِلْحَضْرَمِيِّ : "" بَيِّنَتُكَ "" قَالَ : لَيْسَ لِي بَيِّنَةٌ ، قَالَ : "" فَإِنْ لَمْ يَكُنْ لَكَ بَيِّنَةٌ حَلَفَ  الْأَشْعَثُ  "" قَالَ : هَلَكَ حَقِّي يَا رَسُولَ اللهِ ، إِنْ جَعَلْتَهَا يَمِينَ  الْأَشْعَثِ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ حَلَفَ عَلَى يَمِينٍ وَهُوَ فِيهَا كَاذِبٌ  لِيَقْتَطِعَ  بِهَا مَالَ امْرِئٍ مُسْلِمٍ لَقِيَ اللهَ يَوْمَ الْقِيَامَةِ وَهُوَ عَلَيْهِ غَضْبَانُ  .","","Al-Mu'jam al-Kabir 24","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن عبد الملك بن عمير القبطي عن إبراهيم بن عثمان أبو شيبة العبسي عن إبراهيم بن الفضل بن أبي سويد الذارع عن أحمد بن داود بن موسى السدوسي عن الطبراني","عبد الملك بن عمير عن علقمة بن وائل"
"19517","25  -  حَدَّثَنَا  طَالِبُ بْنُ قُرَّةَ الْأَذَنِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عِيسَى الطَّبَّاعُ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ غَصَبَ رَجُلًا أَرْضًا ظُلْمًا لَقِيَ اللهَ وَهُوَ عَلَيْهِ غَضْبَانُ  .","","Al-Mu'jam al-Kabir 25","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن عبد الملك بن عمير القبطي عن الوضاح بن عبد الله اليشكري عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","عبد الملك بن عمير عن علقمة بن وائل"
"19518","[22/19]      عَاصِمُ بْنُ كُلَيْبٍ  ، عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ  ، عَنْ أَبِيهِ  26  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  الْحَارِثُ بْنُ عَبْدِ اللهِ ،  أَخْبَرَنَا  هُشَيْمٌ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا رَكَعَ فَرَّجَ أَصَابِعَهُ  ، وَإِذَا سَجَدَ ضَمَّ أَصَابِعَهُ  .","","Al-Mu'jam al-Kabir 26","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن عاصم بن كليب الجرمي عن هشيم بن بشير عن الحارث بن عبد الله بن إسماعيل الخازني عن موسى بن هارون الحمال عن الطبراني","عاصم بن كليب عن علقمة بن وائل عن أبيه"
"19519","قَيْسُ بْنُ سُلَيْمٍ الْعَنْبَرِيُّ  ، عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ  27  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلْطِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  قَيْسُ بْنُ سُلَيْمٍ الْعَنْبَرِيُّ ،  حَدَّثَنِي  عَلْقَمَةُ بْنُ وَائِلِ بْنِ حُجْرٍ ،  عَنْ  أَبِيهِ  قَالَ :  صَلَّيْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَكَبَّرَ حِينَ افْتَتَحَ الصَّلَاةَ  ، وَرَفَعَ يَدَيْهِ ، وَحِينَ أَرَادَ أَنْ يَرْكَعَ رَفَعَ يَدَيْهِ ، وَبَعْدَمَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ  .","","Al-Mu'jam al-Kabir 27","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن قيس بن سليم العنبري عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","قيس بن سليم العنبري عن علقمة بن وائل"
"19520","أُمُّ يَحْيَى بِنْتُ عَبْدِ الْجَبَّارِ بْنِ وَائِلِ بْنِ حُجْرٍ  ، عَنْ عَمِّهَا  عَلْقَمَةَ  28  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ قَالَ :  حَدَّثَتْنِي  مَيْمُونَةُ بِنْتُ حُجْرِ بْنِ عَبْدِ الْجَبَّارِ بْنِ وَائِلِ بْنِ حُجْرٍ قَالَتْ :  سَمِعْتُ  عَمَّتِي أُمَّ يَحْيَى بِنْتَ عَبْدِ الْجَبَّارِ بْنِ وَائِلِ بْنِ حُجْرٍ ،  عَنْ  أَبِيهَا عَبْدِ الْجَبَّارِ  ،  عَنْ  عَلْقَمَةَ عَمِّهَا ،  عَنْ  وَائِلِ بْنِ حُجْرٍ  قَالَ :  جِئْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  هَذَا  وَائِلُ بْنُ حُجْرٍ  جَاءَكُمْ ، لَمْ يَجِئْكُمْ رَغْبَةً وَلَا رَهْبَةً ، جَاءَ حُبًّا لِلهِ وَلِرَسُولِهِ  وَبَسَطَ لَهُ رِدَاءَهُ ،         [22/20]      وَأَجْلَسَهُ إِلَى جَنْبِهِ ، وَضَمَّهُ إِلَيْهِ ، وَأَصْعَدَ بِهِ الْمِنْبَرَ فَخَطَبَ النَّاسَ فَقَالَ لِأَصْحَابِهِ : "" ارْفُقُوا بِهِ فَإِنَّهُ حَدِيثُ عَهْدٍ بِالْمُلْكِ "" فَقُلْتُ : إِنَّ أَهْلِي قَدْ غَلَبُونِي عَلَى الَّذِي لِي ، قَالَ : "" أَنَا أُعْطِيكَهُ وَأُعْطِيكَ ضِعْفَهُ "" فَقَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يَا  وَائِلُ بْنَ حُجْرٍ  ، إِذَا صَلَّيْتَ فَاجْعَلْ يَدَيْكَ حِذَاءَ أُذُنَيْكَ ، وَالْمَرْأَةُ تَجْعَلُ يَدَيْهَا حِذَاءَ ثَدْيَيْهَا  .","","Al-Mu'jam al-Kabir 28","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن جشة بنت عبد الجبار بن وائل عن ميمونة بنت حجر بن عبد الجبار بن وائل بن حجر عن محمد بن عبد الله مطين الحضرمي عن الطبراني","أم يحيى بنت عبد الجبار بن وائل بن حجر عن عمها علقمة"
"19521","29  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ قَالَ :  حَدَّثَتْنِي  مَيْمُونَةُ بِنْتُ حُجْرٍ قَالَتْ :  حَدَّثَتْنِي  عَمَّتِي أُمُّ يَحْيَى بِنْتُ عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  طُوبَى لِمَنْ رَآنِي ، وَمَنْ رَأَى مَنْ رَآنِي "" ثَلَاثًا  .","","Al-Mu'jam al-Kabir 29","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن جشة بنت عبد الجبار بن وائل عن ميمونة بنت حجر عن محمد بن عبد الله مطين الحضرمي عن الطبراني","أم يحيى بنت عبد الجبار بن وائل بن حجر عن عمها علقمة"
"19522","عَبْدُ الْجَبَّارُ بْنُ وَائِلٍ  ، عَنْ أَبِيهِ  أَبُو إِسْحَاقَ  ، عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ  بَابٌ  30  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  ثَنَا  عَبْدُ الرَّزَّاقِ ،  ثَنَا  مَعْمَرٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا قَالَ :         {      وَلا الضَّالِّينَ         }      قَالَ : "" آمِينَ "" حَتَّى يُسْمِعَنَا  .","","Al-Mu'jam al-Kabir 30","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"19523","31  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَصَلَّيْتُ خَلْفَهُ ، فَأَخَذَ يَقْرَأُ  فَقَالَ :         {      غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ         }             [22/21]      قَالَ : "" آمِينَ "" يَجْهَرُ  .","","Al-Mu'jam al-Kabir 31","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","باب"
"19524","32  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  أَنَّهُ  صَلَّى مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَلَمَّا قَرَأَ بِفَاتِحَةِ الْكِتَابِ فَقَالَ :         {      غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ         }      قَالَ : آمِينَ وَرَفَعَ بِهَا صَوْتَهُ  .","","Al-Mu'jam al-Kabir 32","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن عثمان بن حفص الضبي عن الطبراني","باب"
"19525","33  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِسْحَاقَ النَّيْسَابُورِيُّ  ، حَدَّثَنَا  يَحْيَى بْنُ يَحْيَى النَّيْسَابُورِيُّ ،  ثَنَا  حُدَيْجُ بْنُ مُعَاوِيَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  صَلَّيْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَافْتَتَحَ بِفَاتِحَةِ الْكِتَابِ  ، فَلَمَّا خَتَمَهَا قَالَ : آمِينَ حَتَّى سَمِعَ مَنْ خَلْفَهُ  .","","Al-Mu'jam al-Kabir 33","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن حديج بن معاوية بن حديج  الجعفي عن يحيى بن يحيى الحنظلي عن إسماعيل بن إسحاق السراج عن الطبراني","باب"
"19526","34  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ قَالَا :  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَرَأَ         {      غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ         }      قَالَ : "" آمِينَ "" يَمُدُّ بِهَا صَوْتَهُ  .","","Al-Mu'jam al-Kabir 34","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن أبو بكر بن عياش عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"19527","35  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ قَالَا :  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  صَلَّيْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَرَأَ بِفَاتِحَةِ الْكِتَابِ  ، فَلَمَّا فَرَغَ مِنْهَا قَالَ : "" آمِينَ "" يَمُدُّ بِهَا صَوْتَهُ  .","","Al-Mu'jam al-Kabir 35","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","باب"
"19528","36  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ ، وَعَبْدَانُ بْنُ أَحْمَدَ قَالَا :  ثَنَا  عَمْرُو بْنُ عُثْمَانَ الْحِمْصِيُّ قَالَا : كَذَا  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ قَالَ :  حَدَّثَنِي         [22/22]      يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَصَلَّيْتُ خَلْفَهُ ، فَأَخَذَ يَقْرَأُ         {      غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ         }      فَقَالَ : "" آمِينَ "" يَجْهَرُ حَتَّى سَمِعْتُهُ  .","","Al-Mu'jam al-Kabir 36","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن إسماعيل بن عياش الأحول عن عمرو بن عثمان بن سعيد الحمصي عن إبراهيم بن محمد بن عرق الحمصي عن الطبراني","باب"
"19529","37  -  حَدَّثَنَا  أَبُو شَيْخٍ مُحَمَّدُ بْنُ الْحَسَنِ الْأَصْبَهَانِيُّ  ، ثَنَا  أَحْمَدُ بْنُ الْحَارِثِ الْحَرَّانِيُّ قَالَ :  حَدَّثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي عَبْدِ الرَّحِيمِ ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  صَلَّيْتُ خَلْفَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَلَمَّا قَالَ :         {      غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ         }      قَالَ : "" آمِينَ ""  مَدَّ  بِهَا صَوْتَهُ  .","","Al-Mu'jam al-Kabir 37","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن زيد بن أبي أنيسة الجزري عن خالد بن يزيد الحراني عن محمد بن سلمة الباهلي عن أحمد بن الحارث الحراني عن أبو شيخ الأبهري محمد بن الحسين عن الطبراني","باب"
"19530","38  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  سَعْدُ بْنُ الصَّلْتِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ دَخَلَ فِي الصَّلَاةِ  ، فَلَمَّا فَرَغَ مِنْ فَاتِحَةِ الْكِتَابِ قَالَ : "" آمِينَ "" ثَلَاثَ مَرَّاتٍ  .","","Al-Mu'jam al-Kabir 38","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن الأعمش عن سعد بن الصلت بن برد البجلي عن عثمان ابن أبي شيبة عن محمد بن عثمان بن أبي شيبة عن الطبراني","باب"
"19531","39  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَنْدَهْ الْأَصْبَهَانِيُّ قَالَ :  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  سِنَانُ بْنُ مُظَاهِرٍ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ أَبِي جَعْفَرٍ الْفَرَّاءُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  صَلَّيْتُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَكَانَ إِذَا قَرَأَ         {      غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ         }      قَالَ : "" آمِينَ  لِيُوافِقَ الْمَلَائِكَةَ الْمُؤْمِنِينَ  .","","Al-Mu'jam al-Kabir 39","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن عبد الحميد بن أبي جعفر الفراء عن سنان بن مظاهر العنزي عن أبو كريب محمد بن العلاء عن محمد بن يحيى بن مندة عن الطبراني","باب"
"19532","[22/23]      40  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ الْأَصْبَهَانِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  أَنَّهُ  سَمِعَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِينَ قَالَ :         {      غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ         }      قَالَ : "" آمِينَ  فَقَالَ مَنْ خَلْفَهُ آمِينَ  .","","Al-Mu'jam al-Kabir 40","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن زكريا بن أبي زائدة الوادعي عن يحيى بن زكريا بن أبي زائدة عن سهل بن عثمان العسكري عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","باب"
"19533","41  -  حَدَّثَنَا  جَعْفَرُ بْنُ سُنَيْدِ بْنِ دَاوُدَ الْمِصِّيصِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ ،  ثَنَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  صَلَّيْتُ خَلْفَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا قَرَأَ         {      غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ         }      قَالَ : "" آمِينَ "" حَتَّى سَمِعْتُهُ وَأَنَا خَلْفَهُ  .","","Al-Mu'jam al-Kabir 41","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن حجاج بن محمد الأعور عن سنيد بن داود المصيصي عن جعفر بن سنيد بن داود عن الطبراني","باب"
"19534","بَابٌ  42  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ، (  ح  )  وَحَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ قَالَا :  ثَنَا  زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِينَ يُوجِبُ يَرْفَعُ يَدَيْهِ  حَتَّى يَبْلُغَا أُذُنَيْهِ  .","","Al-Mu'jam al-Kabir 42","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","باب"
"19535","43  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  :  أَنَّهُ صَلَّى مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَكَبَّرَ وَرَفَعَ يَدَيْهِ  .","","Al-Mu'jam al-Kabir 43","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن عثمان بن عمر الضبي عن الطبراني","باب"
"19536","44  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  صَلَّيْتُ خَلْفَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا افْتَتَحَ الصَّلَاةَ كَبَّرَ وَرَفَعَ يَدَيْهِ حَتَّى حَاذَتَا بِأُذُنَيْهِ  .","","Al-Mu'jam al-Kabir 44","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","باب"
"19537","[22/24]      45  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِسْحَاقَ النَّيْسَابُورِيُّ  ، ثَنَا  يَحْيَى بْنُ يَحْيَى النَّيْسَابُورِيُّ ،  ثَنَا  حُدَيْجُ بْنُ مُعَاوِيَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  صَلَّيْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَرَأَيْتُهُ يَرْفَعُ يَدَيْهِ إِلَى أُذُنَيْهِ  .","","Al-Mu'jam al-Kabir 45","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن حديج بن معاوية بن حديج  الجعفي عن يحيى بن يحيى الحنظلي عن إسماعيل بن إسحاق السراج عن الطبراني","باب"
"19538","46  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عَمْرُو بْنُ عُثْمَانَ الْحِمْصِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  يُونُسَ بْنِ أَبِي إِسْحَاقَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَرْفَعُ يَدَيْهِ حِينَ يُوجِبُ  حَتَّى تَبْلُغَا أَسْفَلَ مِنْ أُذُنَيْهِ  .","","Al-Mu'jam al-Kabir 46","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن إسماعيل بن عياش الأحول عن عمرو بن عثمان بن سعيد الحمصي عن عبد الله بن أحمد الجواليقي عن الطبراني","باب"
"19539","47  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ الْأَصْبَهَانِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  ثَنَا  أَبِي  ، عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  أَنَّهُ  رَأَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَفَعَ يَدَيْهِ وَكَبَّرَ  .","","Al-Mu'jam al-Kabir 47","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن زكريا بن أبي زائدة الوادعي عن يحيى بن زكريا بن أبي زائدة عن سهل بن عثمان العسكري عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","باب"
"19540","48  -  حَدَّثَنَا  جَعْفَرُ بْنُ سُنَيْدِ بْنِ دَاوُدَ الْمِصِّيصِيُّ ،  حَدَّثَنِي  أَبِي  قَالَ :  ثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ ،  عَنْ  يُونُسَ بْنِ أَبِي إِسْحَاقَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِينَ اسْتَفْتَحَ الصَّلَاةَ يَرْفَعُ يَدَيْهِ أَسْفَلَ مِنْ أُذُنَيْهِ  .","","Al-Mu'jam al-Kabir 48","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن حجاج بن محمد الأعور عن سنيد بن داود المصيصي عن جعفر بن سنيد بن داود عن الطبراني","باب"
"19541","بَابٌ  49  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا         [22/25]      زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَضَعَ يَدَهُ الْيُمْنَى فِي الصَّلَاةِ عَلَى الْيُسْرَى  .","","Al-Mu'jam al-Kabir 49","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","باب"
"19542","50  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  حَدَّثَنِي  أَبِي  ،  حَدَّثَنَا  سَعْدُ بْنُ الصَّلْتِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ دَخَلَ فِي الصَّلَاةِ فَكَبَّرَ  ، ثُمَّ وَضَعَ سَاعِدَهُ الْيُمْنَى عَلَى سَاعِدِهِ الْيُسْرَى  .","","Al-Mu'jam al-Kabir 50","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن الأعمش عن سعد بن الصلت بن برد البجلي عن عثمان ابن أبي شيبة عن محمد بن عثمان بن أبي شيبة عن الطبراني","باب"
"19543","51  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِسْحَاقَ النَّيْسَابُورِيُّ  ، ثَنَا  يَحْيَى بْنُ يَحْيَى النَّيْسَابُورِيُّ ،  ثَنَا  حُدَيْجُ بْنُ مُعَاوِيَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  صَلَّيْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَرَأَيْتُهُ يَضَعُ الْيُمْنَى عَلَى الْأُخْرَى  .","","Al-Mu'jam al-Kabir 51","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن حديج بن معاوية بن حديج  الجعفي عن يحيى بن يحيى الحنظلي عن إسماعيل بن إسحاق السراج عن الطبراني","باب"
"19544","52  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عَمْرُو بْنُ عُثْمَانَ الْحِمْصِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  يُونُسَ بْنِ أَبِي إِسْحَاقَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَضَعُ يَدَهُ الْيُمْنَى عَلَى الْيُسْرَى فِي الصَّلَاةِ  قَرِيبًا مِنَ الرُّسْغِ  .","","Al-Mu'jam al-Kabir 52","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن إسماعيل بن عياش الأحول عن عمرو بن عثمان بن سعيد الحمصي عن عبد الله بن أحمد الجواليقي عن الطبراني","باب"
"19545","53  -  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ الْبَاقِي الْمِصِّيصِيُّ  ، ثَنَا  لُوَيْنٌ ،  ثَنَا  مُحَمَّدُ بْنُ جَابِرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَعْتَمِدُ بِإِحْدَى يَدَيْهِ عَلَى الْأُخْرَى فِي الصَّلَاةِ  .","","Al-Mu'jam al-Kabir 53","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن محمد بن جابر بن سيار عن محمد بن سليمان لوين عن يحيى بن عبد الباقي الثغري عن الطبراني","باب"
"19546","54  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  :  أَنَّهُ صَلَّى خَلْفَ         [22/26]      رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَسَمِعَ  رَجُلًا  يَقُولُ : الْحَمْدُ لِلهِ كَثِيرًا طَيِّبًا مُبَارَكًا فِيهِ ، فَلَمَّا أَنْ قَضَى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَاتَهُ قَالَ : "" مَنْ صَاحِبُ الْكَلِمَاتِ "" ؟ قَالَ : أَنَا يَا رَسُولَ اللهِ ، وَاللهِ مَا أَرَدْتُ بِهَا إِلَّا الْخَيْرَ ، قَالَ :  لَقَدْ فُتِحَتْ لَهَا أَبْوَابُ السَّمَاءِ ، فَمَا  نَهْنَهَهَا  شَيْءٌ دُونَ الْعَرْشِ  .","","Al-Mu'jam al-Kabir 54","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن عثمان بن عمر الضبي عن الطبراني","باب"
"19547","55  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ قَالُوا :  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي ، فَجَاءَ  رَجُلٌ  فَدَخَلَ فِي الصَّفِّ فَقَالَ : اللهُ أَكْبَرُ  كَبِيرًا  ، وَسُبْحَانَ اللهِ بُكْرَةً وَأَصِيلًا فَلَمَّا سَلَّمَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : "" مَنْ صَاحِبُ الْكَلِمَاتِ ؟ "" قَالَ الرَّجُلُ : أَنَا يَا رَسُولَ اللهِ ، مَا أَرَدْتُ بِهِنَّ إِلَّا خَيْرًا ، قَالَ :  لَقَدْ رَأَيْتُ أَبْوَابَ السَّمَاءِ فُتِحَتْ فَمَا تَنَاهَتْ دُونَ الْعَرْشِ  .","","Al-Mu'jam al-Kabir 55","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","باب"
"19548","56  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ قَالَا :  ثَنَا  حُبَيْبُ بْنُ حَبِيبٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الصَّلَاةِ ، فَدَخَلَ  دَاخِلٌ  فِي الصَّلَاةِ ، فَقَالَ : اللهُ أَكْبَرُ  كَبِيرًا  ، وَسُبْحَانَ اللهِ وَبِحَمْدِهِ كَثِيرًا ، فَرَفَعَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى السَّمَاءِ ، ثُمَّ أَقْبَلَ عَلَى صَلَاتِهِ حَتَّى إِذَا فَرَغَ مِنَ الصَّلَاةِ قَالَ : "" مَنْ صَاحِبُ الْكَلِمَةِ ؟ "" قَالَ : أَنَا يَا رَسُولَ اللهِ ، قَالَ :  لَقَدْ فُتِحَتْ لَهَا أَبْوَابُ السَّمَاءِ فَمَا  نَهْنَهَهَا  شَيْءٌ دُونَ الْعَرْشِ  .","","Al-Mu'jam al-Kabir 56","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن حبيب بن حبيب الكوفي عن عثمان ابن أبي شيبة عن عبد الله بن أحمد الجواليقي عن الطبراني","باب"
"19549","57  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَنْدَهْ الْأَصْبَهَانِيُّ  ، ثَنَا  أَبُو         [22/27]      كُرَيْبٍ ،  ثَنَا  سِنَانُ بْنُ مُظَاهِرٍ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ أَبِي جَعْفَرٍ الْفَرَّاءُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  صَلَّيْتُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَسَمِعَ  رَجُلًا  يَقُولُ : اللهُ أَكْبَرُ  كَبِيرًا  ، وَسُبْحَانَ اللهِ وَبِحَمْدِهِ كَثِيرًا ، فَلَمَّا انْصَرَفَ قَالَ : "" مَنْ صَاحِبُ الْكَلِمَةِ ؟ "" قَالَ : مَا أَرَدْتُ إِلَّا الْخَيْرَ ، قَالَ :  لَقَدْ فُتِحَتْ لَهَا أَبْوَابُ السَّمَاءِ فَمَا  نَهْنَهَهَا  شَيْءٌ دُونَ الْعَرْشِ .","","Al-Mu'jam al-Kabir 57","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن عبد الحميد بن أبي جعفر الفراء عن سنان بن مظاهر العنزي عن أبو كريب محمد بن العلاء عن محمد بن يحيى بن مندة عن الطبراني","باب"
"19550","58  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْأَنْطَاكِيُّ قَرْقَرَةُ  ثَنَا  أَبُو الْمُعَافَى الْحَرَّانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي عَبْدِ الرَّحِيمِ ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  قَامَ  رَجُلٌ  خَلْفَ نَبِيِّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يُصَلِّي فَقَالَ : اللهُ أَكْبَرُ  كَبِيرًا  فَذَكَرَ الْحَدِيثَ  .","","Al-Mu'jam al-Kabir 58","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن زيد بن أبي أنيسة الجزري عن خالد بن يزيد الحراني عن محمد بن سلمة الباهلي عن محمد بن وهب بن عمر الحراني عن قرقرة الفقيه أحمد بن يحيى عن الطبراني","باب"
"19551","59  -  حَدَّثَنَا  جَعْفَرُ بْنُ سُنَيْدِ بْنِ دَاوُدَ الْمِصِّيصِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ ،  عَنْ  يُونُسَ بْنِ أَبِي إِسْحَاقَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  صَلَّيْتُ خَلْفَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَسَمِعَ  رَجُلًا  يَقُولُ : اللهُ أَكْبَرُ  كَبِيرًا  ، الْحَمْدُ لِلهِ كَثِيرًا طَيِّبًا مُبَارَكًا فِيهِ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  رَأَيْتُهَا وَقَدِ ابْتَدَرَهَا اثْنَا عَشَرَ مَلَكًا ، وَفُتِحَتْ لَهَا أَبْوَابُ السَّمَاءِ  .","","Al-Mu'jam al-Kabir 59","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن حجاج بن محمد الأعور عن سنيد بن داود المصيصي عن جعفر بن سنيد بن داود عن الطبراني","باب"
"19552","مُحَمَّدُ بْنُ جُحَادَةَ  ، عَنْ  عَبْدِ الْجَبَّارِ  60  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقَزَّازُ  ، ثَنَا  أَبُو عُمَرَ الْحَوْضِيُّ قَالَا :  ثَنَا  هَمَّامٌ ،  ثَنَا         [22/28]      مُحَمَّدُ بْنُ جُحَادَةَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَانَ إِذَا دَخَلَ فِي الصَّلَاةِ رَفَعَ يَدَيْهِ وَكَبَّرَ ، ثُمَّ الْتَحَفَ بِثَوْبِهِ  ، ثُمَّ وَضَعَ يَدَهُ الْيُمْنَى عَلَى الْيُسْرَى ، فَلَمَّا أَرَادَ أَنْ يَرْكَعَ قَالَ هَكَذَا بِثَوْبِهِ ، وَأَخْرَجَ يَدَيْهِ ، ثُمَّ رَفَعَهُمَا ، وَكَبَّرَ وَرَكَعَ ، فَلَمَّا أَرَادَ أَنْ يَسْجُدَ ، وَقَعَتْ رُكْبَتَاهُ عَلَى الْأَرْضِ قَبْلَ كَفَّيْهِ ، فَلَمَّا سَجَدَ وَضَعَ جَبْهَتَهُ بَيْنَ كَفَّيْهِ ، وَجَافَى عَنْ إِبِطَيْهِ "" .  قَالَ  هَمَّامٌ  : وَأَكْبَرُ عِلْمِي أَنَّ فِي حَدِيثِ  مُحَمَّدِ بْنِ جُحَادَةَ  :  فَإِذَا نَهَضَ نَهَضَ عَلَى رُكْبَتَيْهِ وَاعْتَمَدَ عَلَى فَخِذَيْهِ  .","","Al-Mu'jam al-Kabir 60","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن محمد بن جحادة الأودي عن همام بن يحيى بن دينار عن حفص بن عمر الحوضى عن محمد بن يحيى بن المنذر القزاز عن الطبراني","محمد بن جحادة عن عبد الجبار"
"19553","61  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ  ، ثَنَا  أَبُو عُمَرَ الْمَقْعَدُ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ بْنِ حِسَابٍ قَالَا :  ثَنَا  عَبْدُ الْوَارِثِ ،  ثَنَا  مُحَمَّدُ بْنُ جُحَادَةَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ قَالَ : كُنْتُ غُلَامًا لَا أَعْقِلُ صَلَاةَ أَبِي  فَحَدَّثَنِي  عَلْقَمَةُ بْنُ وَائِلٍ ،  عَنْ  أَبِي وَائِلِ بْنِ حُجْرٍ قَالَ :  صَلَّيْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَكَانَ إِذَا كَبَّرَ رَفَعَ يَدَيْهِ  ، ثُمَّ الْتَحَفَ فَأَخَذَ يَمِينَهُ بِشِمَالِهِ ، وَأَدْخَلَ يَدَيْهِ فِي ثَوْبِهِ ، وَإِذَا أَرَادَ أَنْ يَرْفَعَ رَأْسَهُ مِنَ الرُّكُوعِ رَفَعَ يَدَيْهِ ، ثُمَّ سَجَدَ وَوَضَعَ جَبْهَتَهُ بَيْنَ كَفَّيْهِ ، فَإِذَا رَفَعَ رَأْسَهُ مِنَ السُّجُودِ رَفَعَ يَدَيْهِ حَتَّى فَرَغَ مِنْ صَلَاتِهِ  .","","Al-Mu'jam al-Kabir 61","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن محمد بن جحادة الأودي عن عبد الوارث بن سعيد بن ذكوان عن محمد بن عبيد بن حساب الغبري عن عبد الله بن أحمد بن حنبل عن الطبراني","محمد بن جحادة عن عبد الجبار"
"19554","[22/29]      الْأَعْمَشُ  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ  62  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَسْجُدُ عَلَى الْأَرْضِ  ، وَاضِعًا جَبْهَتَهُ وَأَنْفَهُ فِي سُجُودِهِ  .","","Al-Mu'jam al-Kabir 62","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن الأعمش عن حفص بن غياث النخعي عن عبد الصمد بن عبد الوارث التنوري عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","الأعمش عن عبد الجبار بن وائل"
"19555","الْحَسَنُ بْنُ عُبَيْدِ اللهِ  ، عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ  63  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَالِمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  الْمُحَارِبِيُّ ،  عَنِ  الْحَسَنِ بْنِ عُبَيْدِ اللهِ ، (  ح  )  وَحَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  الْحَسَنُ بْنُ سَهْلٍ الْحَنَّاطُ ،  ثَنَا  عِمْرَانُ بْنُ عُيَيْنَةَ ،  حَدَّثَنِي  الْحَسَنُ بْنُ عُبَيْدِ اللهِ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  : أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ "" إِذَا كَبَّرَ فِي الصَّلَاةِ رَفَعَ يَدَيْهِ حَتَّى يُحَاذِيَ بِهِمَا أُذُنَيْهِ  .","","Al-Mu'jam al-Kabir 63","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن الحسن بن عبيد الله النخعي عن عبد الرحمن بن محمد المحاربي عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","الحسن بن عبيد الله عن عبد الجبار بن وائل"
"19556","الْحَجَّاجُ بْنُ أَرْطَاةَ  ، عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ  64  -  حَدَّثَنَا  طَالِبُ بْنُ قُرَّةَ الْأَذَنِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عِيسَى         [22/30]      الطَّبَّاعُ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  (  ح  ) ،  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ قَالَا :  ثَنَا  مَعْمَرُ بْنُ سُلَيْمَانَ الرَّقِّيُّ ،  ثَنَا  الْحَجَّاجُ بْنُ أَرْطَاةَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  اسْتُكْرِهَتِ  امْرَأَةٌ  عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَدَرَأَ عَنْهَا  الْحَدَّ  ، وَأَقَامَهُ عَلَى الَّذِي أَصَابَهَا ، وَلَمْ يُذْكَرْ أَنَّهُ جَعَلَ لَهَا مَهْرًا  .","","Al-Mu'jam al-Kabir 64","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن حجاج بن أرطاة عن معمر بن سليمان النخعي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","الحجاج بن أرطاة عن عبد الجبار بن وائل"
"19557","65  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  مُحَمَّدُ بْنُ خَارِمٍ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَاضِعًا أَنْفَهُ عَلَى الْأَرْضِ مَعَ جَبْهَتِهِ إِذَا سَجَدَ  .","","Al-Mu'jam al-Kabir 65","","عبد الجبار بن وائل بن حجر الحضرمي عن حجاج بن أرطاة عن أبو معاوية الضرير عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","الحجاج بن أرطاة عن عبد الجبار بن وائل"
"19558","66  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَالِمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سُلَيْمَانَ  ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  :  أَنَّهُ أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَرَآهُ يَضَعُ أَنْفَهُ مَعَ جَبْهَتِهِ فِي السُّجُودِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : (عبد الرحيم بن سليمان) .","","Al-Mu'jam al-Kabir 66","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن حجاج بن أرطاة عن عبد الرحيم بن سليمان الأشل عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","الحجاج بن أرطاة عن عبد الجبار بن وائل"
"19559","67  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى فَرَأَيْتُ أَثَرَ أَنْفِهِ مَعَ جَبْهَتِهِ فِي الْكَثِيفِ  .","","Al-Mu'jam al-Kabir 67","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن حجاج بن أرطاة عن قيس بن الربيع الأسدي عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","الحجاج بن أرطاة عن عبد الجبار بن وائل"
"19560","جَابِرٌ الْجُعْفِيُّ  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ  68  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  سَعِيدُ بْنُ مُحَمَّدٍ         [22/31]      الْجَرْمِيُّ ،  ثَنَا  أَبُو تُمَيْلَةَ ،  عَنْ  أَبِي حَمْزَةَ ،  عَنْ  جَابِرٍ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  لَقَدْ كُنْتُ أُصَافِحُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، أَوْ يَمَسُّ جِلْدِي جِلْدَهُ ، فَأَتَعَرَّقُهُ فِي يَدَيَّ بَعْدَ ثَالِثَةٍ أَطْيَبَ رِيحًا مِنَ الْمِسْكِ "" .","","Al-Mu'jam al-Kabir 68","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن جابر الجعفي عن محمد بن ميمون أبو حمزة السكري عن يحيى بن واضح الأنصاري عن سعيد بن محمد الجرمي عن عبد الله بن أحمد بن حنبل عن الطبراني","جابر الجعفي عن عبد الجبار بن وائل"
"19561","69  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَنْدَهْ الْأَصْبَهَانِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  عَنْ  شَيْبَانَ ،  عَنْ  جَابِرٍ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  : ""  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ  فَاسْتَنْثَرَ  وَخَلَّلَ أَصَابِعَهُ بِأَصَابِعِهِ  .","","Al-Mu'jam al-Kabir 69","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن جابر الجعفي عن شيبان بن عبد الرحمن المؤدب عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن محمد بن يحيى بن مندة عن الطبراني","جابر الجعفي عن عبد الجبار بن وائل"
"19562","مِسْعَرُ بْنُ كِدَامٍ  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ  70  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  مِسْعَرٍ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ دَعَا بِدَلْوٍ مِنْ مَاءٍ فَشَرِبَ مِنْهُ ثُمَّ مَجَّ فِيهِ  .","","Al-Mu'jam al-Kabir 70","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن مسعر بن كدام عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","مسعر بن كدام عن عبد الجبار بن وائل"
"19563","أَشْعَثُ بْنُ سَوَّارٍ  عَنْ  عَبْدِ الْجَبَّارِ  71  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَنْدَهْ الْأَصْبَهَانِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  هَانِي بْنُ سَعِيدٍ النَّخَعِيُّ ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  قَدِمْتُ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَمَا يَسُرُّنِي أَنَّ لِي بِوَجْهِي مِنْهُ وَجْهَ رَجُلٍ مِنْ بِوَادِيَ الْعَرَبِ ، فَرَأَيْتُهُ يُصَلِّي فَيُكَبِّرُ إِذَا رَفَعَ ، وَإِذَا سَجَدَ  ، وَيُسَلِّمُ عَنْ يَمِينِهِ وَعَنْ يَسَارِهِ إِذَا انْصَرَفَ ، حَتَّى أَرَى بَيَاضَ خَدِّهِ مِنْ هَاهُنَا وَهَاهُنَا  .","","Al-Mu'jam al-Kabir 71","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أشعث بن سوار عن هاني بن سعيد النخعي عن أبو كريب محمد بن العلاء عن محمد بن يحيى بن مندة عن الطبراني","أشعث بن سوار عن عبد الجبار"
"19564","[22/32]      فِطْرُ بْنُ خَلِيفَةَ  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ  72  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  فِطْرٌ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ الْحَضْرَمِيِّ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا افْتَتَحَ الصَّلَاةَ  رَفَعَ يَدَيْهِ حَتَّى يُحَاذِيَ طَرَفُ إِبْهَامَيْهِ  شَحْمَةَ  أُذُنَيْهِ  .","","Al-Mu'jam al-Kabir 72","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن فطر بن خليفة عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","فطر بن خليفة عن عبد الجبار بن وائل"
"19565","قَيْسُ بْنُ الرَّبِيعِ  عَنْ  عَبْدِ الْجَبَّارِ  73  -  حَدَّثَنَا  عَلَّانُ بْنُ عَبْدِ الصَّمَدِ الطَّيَالِسِيُّ مَاغَمَّهُ قَالَ :  ثَنَا  [ عُمَرُ بْنُ ]  مُحَمَّدِ بْنِ الْحَسَنِ الْأَسَدِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  قَيْسٌ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  : أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَانَ يَأْمُرُ بِدَفْنِ الشَّعَرِ وَالْأَظْفَارِ  .  سقط من طبعة مكتبة ابن تيمية ، والمثبت من النسخة الخطية .","","Al-Mu'jam al-Kabir 73","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن قيس بن الربيع الأسدي عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن علي بن عبد الصمد علان ماغمه عن الطبراني","قيس بن الربيع عن عبد الجبار"
"19566","الْمَسْعُودِيُّ  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ  74  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  قَالَ :  لَمَّا قَدِمَ أَبِي عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" رَآهُ يَضَعُ يَدَهُ الْيُمْنَى عَلَى الْيُسْرَى  ، وَرَفَعَ يَدَيْهِ مَعَ كُلِّ تَكْبِيرَةٍ  .","","Al-Mu'jam al-Kabir 74","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","المسعودي عن عبد الجبار بن وائل"
"19567","75  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ قَالَ :  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  : "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَسْجُدُ بَيْنَ كَفَّيْهِ  .","","Al-Mu'jam al-Kabir 75","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن يزيد بن هارون عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","المسعودي عن عبد الجبار بن وائل"
"19568","76  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  ثَنَا         [22/33]      الْمَسْعُودِيُّ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أُنَاسٍ مِنْ أَهْلِهِ ،  عَنْ  أَبِيهِ  :  أَنَّهُ "" رَأَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَفَعَ يَدَيْهِ ، إِذَا افْتَتَحَ الصَّلَاةَ  ، وَوَضَعَ الْيُمْنَى عَلَى الْيُسْرَى ، وَيَحْبِسُ كَفَّيْهِ  .","","Al-Mu'jam al-Kabir 76","","وائل بن حجر بن سعد الحضرمي عن أناس من أهل عبد الجبار بن وائل بن حجر الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن عمرو بن مرزوق الباهلي عن أبو مسلم الكجي عن الطبراني","المسعودي عن عبد الجبار بن وائل"
"19569","77  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ  ، ثَنَا  أَبُو حَفْصٍ عَمْرُو بْنُ عَلِيٍّ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَهْلِ بَيْتِهِ ،  عَنْ  أَبِيهِ قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا صَلَّى رَفَعَ يَدَيْهِ مَعَ التَّكْبِيرِ  .","","Al-Mu'jam al-Kabir 77","","وائل بن حجر بن سعد الحضرمي عن أهل بيت عبد الجبار بن وائل بن حجر الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن الفلاس عن محمد بن صالح النرسي عن الطبراني","المسعودي عن عبد الجبار بن وائل"
"19570","كُلَيْبُ بْنُ شِهَابٍ أَبُو عَاصِمٍ الْجَرْمِيُّ  عَنْ  وَائِلِ بْنِ حُجْرٍ  78  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَضَعُ يَدَهُ الْيُمْنَى عَلَى الْيُسْرَى  ، وَإِذَا جَلَسَ افْتَرَشَ رِجْلَهُ الْيُسْرَى ، وَوَضَعَ ذِرَاعَيْهِ عَلَى فَخِذَيْهِ وَأَشَارَ بِالسَّبَّابَةِ  .","","Al-Mu'jam al-Kabir 78","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19571","79  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ الْجَرْمِيِّ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ افْتَتَحَ الصَّلَاةَ ، وَكَبَّرَ  وَرَفَعَ يَدَيْهِ ، ثُمَّ أَخَذَ شِمَالَهُ بِيَمِينِهِ ، فَلَمَّا أَرَادَ أَنْ يَرْكَعَ كَبَّرَ فَرَفَعَ يَدَيْهِ فَوَضَعَ رَاحَتَيْهِ عَلَى رُكْبَتَيْهِ ، وَفَرَّجَ بَيْنَ أَصَابِعِهِ ، فَلَمَّا رَفَعَ رَأْسَهُ كَبَّرَ وَرَفَعَ ، فَلَمَّا سَجَدَ وَضَعَ جَبِينَهُ         [22/34]      بَيْنَ كَفَّيْهِ ، وَنَصَبَ أَصَابِعَ رِجْلَيْهِ ، فَلَمَّا رَفَعَ ثَنَى رِجْلَهُ الْيُسْرَى ، وَنَصَبَ أَصَابِعَ رِجْلَهِ الْيُمْنَى ، فَلَمَّا جَلَسَ وَضَعَ كَفَّهُ الْيُسْرَى عَلَى فَخِذِهِ الْيُسْرَى وَوَضَعَ مِرْفَقَهُ الْيُمْنَى عَلَى فَخِذِهِ الْيُمْنَى ، وَعَقَدَ الْخِنْصَرَ وَالَّتِي تَلِيهَا ، وَحَلَّقَ بِالْوُسْطَى وَالْإِبْهَامِ ، وَأَشَارَ بِالسَّبَّابَةِ يَدْعُو بِهَا  .","","Al-Mu'jam al-Kabir 79","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن قيس بن الربيع الأسدي عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19572","80  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  أَبُو الْأَحْوَصِ ،  ثَنَا  عَاصِمُ بْنُ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  "" صَلَّيْتُ خَلْفَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقُلْتُ : لَأَحْفَظَنَّ صَلَاةَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فَلَمَّا افْتَتَحَ الصَّلَاةَ كَبَّرَ وَرَفَعَ يَدَيْهِ حَتَّى حَاذَتَا بِأُذُنَيْهِ  ، ثُمَّ أَخَذَ شِمَالَهُ بِيَمِينِهِ ، فَلَمَّا كَبَّرَ لِلرُّكُوعِ رَفَعَ يَدَيْهِ أَيْضًا كَمَا رَفَعَهُمَا لِتَكْبِيرَةِ الصَّلَاةِ ، فَلَمَّا رَكَعَ وَضَعَ كَفَّيْهِ عَلَى رُكْبَتَيْهِ ، فَلَمَّا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ رَفَعَ يَدَيْهِ أَيْضًا ، فَلَمَّا قَعَدَ يَتَشَهَّدُ افْتَرَشَ رِجْلَهُ الْيُسْرَى بِالْأَرْضِ ، ثُمَّ قَعَدَ عَلَيْهَا فَوَضَعَ كَفَّهُ الْأَيْسَرَ عَلَى فَخِذِهِ الْيُسْرَى ، وَوَضَعَ مِرْفَقَهُ الْأَيْمَنَ عَلَى فَخِذِهِ الْيُمْنَى ثُمَّ عَقَدَ أَصَابِعَهُ ، وَجَعَلَ حَلْقَةً بِالْإِبْهَامِ وَالْوُسْطَى ، ثُمَّ جَعَلَ يَدْعُو بِالْأُخْرَى  .","","Al-Mu'jam al-Kabir 80","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن سلام بن سليم الحنفي عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19573","81  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  رَمَقْتُ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَرَفَعَ يَدَيْهِ فِي الصَّلَاةِ حِينَ كَبَّرَ  ، ثُمَّ حِينَ كَبَّرَ رَفَعَ يَدَيْهِ ، ثُمَّ إِذَا قَالَ : ""  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ "" رَفَعَ يَدَيْهِ ، ثُمَّ جَلَسَ فَافْتَرَشَ رِجْلَهُ الْيُسْرَى ، ثُمَّ وَضَعَ يَدَهُ الْيُسْرَى عَلَى رُكْبَتِهِ الْيُسْرَى ، وَوَضَعَ ذِرَاعَهُ الْيُمْنَى عَلَى فَخِذِهِ الْيُمْنَى ، ثُمَّ أَشَارَ بِسَبَّابَتِهِ ، وَوَضَعَ الْإِبْهَامَ عَلَى الْوُسْطَى         [22/35]      وَحَلَّقَ بِهَا وَقَبَضَ أَصَابِعَهُ ، ثُمَّ سَجَدَ ، وَكَانَتْ يَدَاهُ  حَذْوَ  أُذُنَيْهِ  .","","Al-Mu'jam al-Kabir 81","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19574","82  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ، (  ح  )  وَحَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ قَالَا :  ثَنَا  زَائِدَةُ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ : قُلْتُ :  لَأَنْظُرَنَّ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَيْفَ يُصَلِّي ، فَنَظَرْتُ إِلَيْهِ ،  فَكَبَّرَ وَرَفَعَ يَدَيْهِ حَتَّى حَاذَتَا بِأُذُنَيْهِ  ، ثُمَّ وَضَعَ يَدَهُ الْيُمْنَى عَلَى ظَهْرِ كَفَّهِ الْيُسْرَى بَيْنَ الرُّسْغِ وَالسَّاعِدِ ، ثُمَّ لَمَّا أَرَادَ أَنْ يَرْكَعَ رَفَعَ يَدَيْهِ مِثْلَهَا ، وَوَضَعَ يَدَيْهِ عَلَى رُكْبَتَيْهِ ، ثُمَّ رَفَعَ رَأْسَهُ فَرَفَعَ يَدَيْهِ مِثْلَهَا ، ثُمَّ سَجَدَ فَجَعَلَ كَفَّيْهِ حِذَاءَ أُذُنَيْهِ ، ثُمَّ قَعَدَ وَافْتَرَشَ رِجْلَهُ الْيُسْرَى وَوَضَعَ كَفَّهُ الْيُسْرَى ، وَجَعَلَ حَدَّ مِرْفَقِهِ الْأَيْمَنِ عَلَى فَخِذِهِ الْيُمْنَى ، ثُمَّ قَبَضَ ثِنْتَيْنِ مِنْ أَصَابِعِهِ ، وَحَلَّقَ حَلْقَةً ، ثُمَّ رَفَعَ أُصْبُعَهُ ، وَرَأَيْتُهُ يُحَرِّكُهَا يَدْعُو بِهَا ، ثُمَّ جِئْتُ بَعْدَ ذَلِكَ فِي زَمَانٍ فِيهِ بَرْدٌ فَرَأَيْتُ النَّاسَ عَلَيْهِمْ جُلُّ الثِّيَابِ يُحَرِّكُ أَيْدِيهِمْ مِنْ تَحْتِ الثِّيَابِ  وَاللَّفْظُ لِحَدِيثِ  مُعَاوِيَةَ بْنِ عَمْرٍو  .","","Al-Mu'jam al-Kabir 82","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن زائدة بن قدامة عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19575","83  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ قَالَا :  ثَنَا  شُعْبَةُ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ الْحَضْرَمِيِّ :  أَنَّهُ صَلَّى مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا أَنْ كَبَّرَ رَفَعَ يَدَيْهِ  ، وَلَمَّا أَنْ سَجَدَ جَافَى عَضُدَيْهِ عَنْ إِبِطَيْهِ ، وَلَمَّا أَنْ قَعَدَ افْتَرَشَ رِجْلَهُ الْيُسْرَى وَوَضَعَ يَدَهُ الْيُسْرَى         [22/36]      عَلَى فَخِذِهِ الْيُسْرَى ، وَوَضَعَ يَدَهُ الْيُمْنَى عَلَى فَخِذِهِ الْيُمْنَى ، وَأَشَارَ بِمُسَبِّحَتِهِ  وَاللَّفْظُ لِحَدِيثِ  مُسْلِمٍ  .","","Al-Mu'jam al-Kabir 83","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن أحمد بن داود بن موسى السدوسي عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19576","84  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  عَاصِمُ بْنُ كُلَيْبٍ ، أَنَّ أَبَاهُ  ،  أَخْبَرَهُ  أَنَّ وَائِلَ بْنَ حُجْرٍ  أَخْبَرَهُ  :  قُلْتُ "" لَأَنْظُرَنَّ إِلَى صَلَاةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَيْفَ يُصَلِّي ؟ فَقَامَ فَرَفَعَ يَدَيْهِ حَتَّى حَاذَتَا بِأُذُنَيْهِ  ، ثُمَّ أَخَذَ شِمَالَهُ بِيَمِينِهِ ، ثُمَّ حِينَ أَرَادَ أَنْ يَرْكَعَ رَفَعَ يَدَيْهِ حَتَّى حَاذَتَا بِأُذُنَيْهِ ، ثُمَّ وَضَعَ كَفَّيْهِ عَلَى رُكْبَتَيْهِ ، ثُمَّ رَفَعَ فَرَفَعَ يَدَيْهِ مِثْلَ ذَلِكَ ، ثُمَّ سَجَدَ فَوَضَعَ يَدَيْهِ حِذَاءَ أُذُنَيْهِ ، ثُمَّ سَجَدَ فَوَضَعَ يَدَيْهِ حِذَاءَ أُذُنَيْهِ ، ثُمَّ قَعَدَ فَافْتَرَشَ رِجْلَهُ الْيُسْرَى ، وَوَضَعَ كَفَّهُ الْيُسْرَى عَلَى رُكْبَتِهِ الْيُسْرَى ، ثُمَّ وَضَعَ حَدَّ مِرْفَقِهِ الْأَيْمَنِ عَلَى فَخِذِهِ الْيُمْنَى ، وَقَبَضَ ثِنْتَيْنِ ، وَحَلَّقَ حَلْقَةً ، ثُمَّ رَأَيْتُهُ يَقُولُ هَكَذَا ، وَرَفَعَ  زُهَيْرٌ  أُصْبُعَهُ الْمُسَبِّحَةَ  .","","Al-Mu'jam al-Kabir 84","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن زهير بن معاوية بن حديج عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19577","85  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  الْحُمَيْدِيُّ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ  ، ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ قَالَا :  ثَنَا  سُفْيَانُ ،  ثَنَا  عَاصِمُ بْنُ كُلَيْبٍ الْجَرْمِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا افْتَتَحَ الصَّلَاةَ رَفَعَ يَدَيْهِ حَتَّى يُحَاذِيَ أُذُنَيْهِ  ، وَإِذَا أَرَادَ أَنْ يَرْكَعَ وَبَعْدَمَا يَرْفَعُ مِنَ الرُّكُوعِ ، وَإِذَا جَلَسَ اضْطَجَعَ رِجْلَهُ الْيُسْرَى ، وَنَصَبَ الْيُمْنَى وَوَضَعَ يَدَهُ الْيُسْرَى عَلَى فَخِذِهِ الْيُسْرَى وَيَدَهُ الْيُمْنَى عَلَى فَخِذِهِ الْيُمْنَى ، وَعَقَدَ ثِنْتَيْنِ ، وَحَلَّقَ حَلْقَةً ، وَأَشَارَ هَكَذَا بِالسَّبَّابَةِ  .","","Al-Mu'jam al-Kabir 85","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن أحمد بن داود بن موسى السدوسي عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19578","[22/37]      86  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ قَالَا :  ثَنَا  مُسَدَّدٌ ،  ثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  ثَنَا  عَاصِمُ بْنُ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  قُلْتُ لَأَنْظُرَنَّ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَيْفَ يُصَلِّي ؟  فَاسْتَقْبَلَ الْقِبْلَةَ فَرَفَعَ يَدَيْهِ حَتَّى حَاذَتَا بِأُذُنَيْهِ ، ثُمَّ أَخَذَ شِمَالَهُ بِيَمِينِهِ ، فَلَمَّا أَرَادَ أَنْ يَرْكَعَ رَفَعَهُمَا مِثْلَ ذَلِكَ ، ثُمَّ وَضَعَ يَدَيْهِ عَلَى رُكْبَتَيْهِ ، فَلَمَّا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ رَفَعَهُمَا مِثْلَ ذَلِكَ ، فَلَمَّا سَجَدَ وَضَعَ رَأْسَهُ بِذَلِكَ الْمَنْزِلِ بَيْنَ يَدَيْهِ  .","","Al-Mu'jam al-Kabir 86","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن بشر بن المفضل عن مسدد بن مسرهد عن أبو مسلم الكجي عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19579","87  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ الْجُنْدَيْسَابُورِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ حُمَيْدٍ ،  ثَنَا  هَارُونُ بْنُ الْمُغِيرَةِ ،  عَنْ  عَنْبَسَةَ بْنِ سَعِيدٍ الْأَسَدِيِّ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ وَيُكَنَّى أَبَا بَكْرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  قُلْتُ : لَأَنْظُرَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَيْفَ يُصَلِّي  ؟  فَذَكَرَ نَحْوَ حَدِيثِ  بِشْرِ بْنِ الْمُفَضَّلِ  .","","Al-Mu'jam al-Kabir 87","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن عنبسة بن سعيد بن الضريس عن هارون بن المغيرة المروزي عن محمد بن حميد الرازي عن محمد بن جابان الجند يسابوري عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19580","88  -  حَدَّثَنَا  الْحَسَنُ بْنُ عُلَيْلٍ الْعَنَزِيُّ ، وَمُحَمَّدُ بْنُ يَحْيَى بْنِ مَنْدَهْ الْأَصْبَهَانِيُّ قَالَا :  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  يَحْيَى بْنُ يَعْلَى ،  عَنْ  أَبِيهِ  ،  عَنْ  غَيْلَانَ بْنِ جَامِعٍ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  صَلَّيْتُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا افْتَتَحَ الصَّلَاةَ كَبَّرَ  ، ثُمَّ ذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 88","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن غيلان بن جامع المحاربي عن يعلى بن الحارث بن حرب المحاربي عن يحيى بن يعلى بن الحارث المحاربي عن أبو كريب محمد بن العلاء عن محمد بن يحيى بن مندة عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19581","89  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  أَبِي (  ح  ) ،  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  مَحْمُودُ بْنُ خَالِدٍ الدِّمَشْقِيُّ قَالَا :  ثَنَا  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُوسَى بْنُ أَبِي كَثِيرٍ قَالَ :  حَدَّثَنِي  عَاصِمُ بْنُ         [22/38]      كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  صَلَّيْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا كَبَّرَ رَفَعَ يَدَيْهِ  ، فَلَمَّا أَرَادَ أَنْ يَرْكَعَ رَفَعَ يَدَيْهِ ، وَلَمَّا أَرَادَ أَنْ يَسْجُدَ رَفَعَ يَدَيْهِ ، وَكَانَ إِذَا جَلَسَ  لِلتَّشَهُّدِ  يُشِيرُ  بِإِصْبَعِهِ السَّبَّابَةِ  .","","Al-Mu'jam al-Kabir 89","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن موسى بن أبي كثير الأنصاري عن سويد بن عبد العزيز السلمي عن محمود بن خالد بن أبي خالد السلمي عن الحسين بن إسحاق التستري عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19582","90  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ قَالَا :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلٍ الْحَضْرَمِيِّ قَالَ :  قُلْتُ : "" لَأَنْظُرَنَّ إِلَى صَلَاةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَيْفَ يُصَلِّي ؟ فَقَامَ فَاسْتَقْبَلَ الْقِبْلَةَ فَكَبَّرَ  وَرَفَعَ يَدَيْهِ حَتَّى حَاذَى بِهِمَا أُذُنَيْهِ ، ثُمَّ قَبَضَ بِالْيُمْنَى عَلَى الْيُسْرَى ، ثُمَّ رَكَعَ فَرَفَعَ يَدَيْهِ فَحَاذَى بِهِمَا أُذُنَيْهِ ، ثُمَّ وَضَعَ كَفَّيْهِ عَلَى رُكْبَتَيْهِ ، ثُمَّ رَفَعَ رَأْسَهُ وَرَفَعَ يَدَيْهِ فَحَاذَى بِهِمَا أُذُنَيْهِ ، ثُمَّ سَجَدَ فَوَضَعَ رَأْسَهُ بَيْنَ كَفَّيْهِ ، ثُمَّ صَلَّى رَكْعَةً أُخْرَى مِثْلَهَا ، ثُمَّ جَلَسَ فَافْتَرَشَ رِجْلَهُ الْيُسْرَى ، ثُمَّ دَعَا وَوَضَعَ كَفَّهُ الْيُسْرَى عَلَى رُكْبَتِهِ الْيُسْرَى ، وَكَفَّهُ الْيُمْنَى عَلَى رُكْبَتِهِ الْيُمْنَى ، وَدَعَا بِالسَّبَّابَةِ  .","","Al-Mu'jam al-Kabir 90","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن الوضاح بن عبد الله اليشكري عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19583","91  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ قَالَا :  ثَنَا  أَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ الْأَوْدِيُّ قَالَ :  ثَنَا  شُرَيْحُ بْنُ مَسْلَمَةَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ يُوسُفَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلٍ الْقِيلِ قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ضَرَبَ بِيَمِينِهِ عَلَى شِمَالِهِ فِي الصَّلَاةِ  .","","Al-Mu'jam al-Kabir 91","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن أبو إسحاق السبيعي عن يوسف بن إسحاق بن أبي إسحاق السبيعي عن إبراهيم بن يوسف بن إسحاق بن أبي إسحاق السبيعي عن شريح بن مسلمة التنوخي عن أحمد بن عثمان بن حكيم عن الحسين بن إسحاق التستري عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19584","92  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  جَعْفَرٌ الْأَحْمَرُ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  صَلَّيْتُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا سَجَدَ افْتَرَشَ الْيُسْرَى وَنَصَبَ الْيُمْنَى  .","","Al-Mu'jam al-Kabir 92","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن جعفر بن زياد الأحمر عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19585","[22/39]      93  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِينَ سَجَدَ وَضَعَ جَبْهَتَهُ بَيْنَ كَفَّيْهِ  .","","Al-Mu'jam al-Kabir 93","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19586","94  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  حُسَيْنُ بْنُ عَطِيَّةَ  ،  عَنْ  قَيْسٍ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَجَدَ ، وَنَصَبَ قَدَمَيْهِ وَصَفَّهُمَا  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( الحسن بن عطية ) .","","Al-Mu'jam al-Kabir 94","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن قيس بن الربيع الأسدي عن الحسن بن عطية البزاز عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19587","95  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ يَحْيَى الصُّوفِيُّ ،  ثَنَا  عَلِيُّ بْنُ قَادِمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا قَامَ اتَّكَأَ عَلَى إِحْدَى يَدَيْهِ  .","","Al-Mu'jam al-Kabir 95","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن سفيان الثوري عن علي بن قادم الخزاعي عن أحمد بن يحيى بن زكريا عن محمد بن عبد الله مطين الحضرمي عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19588","96  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِينَ افْتَتَحَ الصَّلَاةَ رَفَعَ يَدَيْهِ  حَذْوَ  أُذُنَيْهِ  .","","Al-Mu'jam al-Kabir 96","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19589","97  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  شَرِيكٌ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  رَأَيْتُ         [22/40]      النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا سَجَدَ وَضَعَ رُكْبَتَيْهِ قَبْلَ يَدَيْهِ  ، وَرَفَعَ يَدَيْهِ قَبْلَ رُكْبَتَيْهِ  .","","Al-Mu'jam al-Kabir 97","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن شريك بن عبد الله النخعي عن يزيد بن هارون عن علي ابن المديني عن معاذ بن المثنى العنبري عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19590","98  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ قَالَا :  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  عَمَّارُ بْنُ مَطَرٍ ،  ثَنَا  شَرِيكٌ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابَهُ فِي الشِّتَاءِ  ، فَرَأَيْتُهُمْ فِي الْبَرَانِسِ وَالْأَكْسِيَةِ ، وَأَيْدِيهُمْ فِيهَا يَرْفَعُونَهَا إِلَى نُحُورِهِمْ أَوْ قَالَ : إِلَى صُدُورِهِمْ  .","","Al-Mu'jam al-Kabir 98","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19591","99  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَلِي شَعَرٌ فَقَالَ : ""  ذُبَابٌ  "" فَذَهَبْتُ فَأَخَذْتُ مِنْ شَعَرِي ، ثُمَّ جِئْتُهُ فَقَالَ لِي :  لِمَ أَخَذْتَ مِنْ شَعَرِكَ ؟  ، قُلْتُ : سَمِعْتُكَ تَقُولُ :  ذُبَابٌ  ، فَظَنَنْتُكَ تُعِيبُنِي ، فَقَالَ : "" مَا عَيَّبْتُكَ وَهَكَذَا أَحْسَنُ  .","","Al-Mu'jam al-Kabir 99","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن سفيان الثوري عن موسى بن مسعود النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19592","100  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  بَعَثَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَجُلًا  عَلَى الصَّدَقَةِ ، فَجَاءَ بِفَصِيلٍ  مَخْلُولٍ  سَيِّئِ الْحَالِ مَهْزُولٍ ، فَقَالَ :         [22/41]      هَذَا مِنْ صَدَقَةِ فُلَانِ بْنِ فُلَانٍ الْفُلَانِيِّ ، فَصَعِدَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمِنْبَرَ ، فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ :  إِنِّي بَعَثْتُ رَسُولِي عَلَى الصَّدَقَةِ  ، فَجَاءَ إِلَى  فُلَانِ  الرَّجُلِ دُعَاءُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَجَاءَ بِنَاقَةٍ  كَوْمَاءَ  يَتُلُّهَا حَتَّى انْتَهَى إِلَى ابْنِ فُلَانٍ الْفُلَانِيِّ فَجَاءَ بِهَذَا الْفَصِيلِ الْمَحْلُولِ ، لَا بَارَكَ اللهُ فِي إِبِلِهِ "" ، فَبَلَغَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِهَا فَتَلَّهَا إِلَيْهِ ، فَصَعِدَ الْمِنْبَرَ فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ : "" إِنَّ فُلَانَ بْنَ فُلَانٍ الْفُلَانِيَّ بَلَغَهُ دُعَاءُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَجَاءَ بِهَذِهِ النَّاقَةِ  الْكَوْمَاءِ  بَارَكَ اللهُ فِيهِ وَفِي إِبِلِهِ  .","","Al-Mu'jam al-Kabir 100","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن سفيان الثوري عن موسى بن مسعود النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19593","101  -  حَدَّثَنَا  مَحْمُودُ بْنُ الْفَرَجِ الْأَصْبَهَانِيُّ  ، عَنْ  إِسْمَاعِيلَ بْنِ عَمْرٍو الْبَجَلِيِّ ،  عَنْ  قَيْسِ بْنِ الرَّبِيعِ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ : أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  النَّدَمُ تَوْبَةٌ  .","","Al-Mu'jam al-Kabir 101","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن قيس بن الربيع الأسدي عن إسماعيل بن عمرو البجلي عن محمود بن أحمد بن الفرج الأصبهاني عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19594","102  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَنْدَهْ الْأَصْبَهَانِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ أَبِي بَكْرٍ  ،  ثَنَا  يَحْيَى بْنُ أَبِي بَكْرٍ ،  ثَنَا  شَرِيكٌ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  وَائِلِ بْنِ حُجْرٍ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَهَرَ بِآمِينَ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( بكير ) والله أعلم.","","Al-Mu'jam al-Kabir 102","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن شريك بن عبد الله النخعي عن يحيى بن أبي بكير عن عبد الله بن محمد بن يحيى الكرماني عن محمد بن يحيى بن مندة عن الطبراني","كليب بن شهاب أبو عاصم الجرمي عن وائل بن حجر"
"19595","عَبْدُ الرَّحْمَنِ الْيَحْصَبِيُّ  عَنْ  وَائِلِ بْنِ حُجْرٍ  103  -  حَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي الْبَخْتَرِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ الْيَحْصَبِيِّ ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  قُلْتُ  : "" لَأَنْظُرَنَّ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَكَانَ يُكَبِّرُ إِذَا خَفَضَ وَإِذَا رَفَعَ  ، وَيَرْفَعُ يَدَيْهِ ، وَيُسَلِّمْ عَنْ يَمِينِهِ وَعَنْ يَسَارِهِ  .","","Al-Mu'jam al-Kabir 103","","وائل بن حجر بن سعد الحضرمي عن عبد الرحمن بن اليحصبي الكوفي عن سعيد بن فيروز الطائي عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن حفص بن عمر الحوضى عن الفضل بن الحباب الجمحي عن الطبراني","عبد الرحمن اليحصبي عن وائل بن حجر"
"19596","[22/42]      104  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ الْأَصْبَهَانِيُّ  ، ثَنَا  يُونُسُ بْنُ حَبِيبٍ ،  ثَنَا  أَبُو دَاوُدَ ،  ثَنَا  شُعْبَةُ ،  ثَنَا  عَمْرُو بْنُ مُرَّةَ قَالَ :  سَمِعْتُ  أَبَا الْبَخْتَرِيِّ  يُحَدِّثُ عَنْ  عَبْدِ الرَّحْمَنِ الْيَحْصَبِيِّ ،  عَنْ  وَائِلِ بْنِ حُجْرٍ :  أَنَّهُ صَلَّى مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَكَانَ يُكَبِّرُ إِذَا خَفَضَ وَإِذَا رَفَعَ  ، وَيَرْفَعُ يَدَيْهِ عِنْدَ التَّكْبِيرَةِ ، وَيُسَلِّمُ عَنْ يَمِينِهِ ، وَعَنْ شِمَالِهِ "" قَالَ  شُعْبَةُ  : فَقَالَ لِي  أَبَانُ بْنُ تَغْلِبَ  فِي ذَا الْحَدِيثِ : حَتَّى يَبْدُوَ وَضَحُ وَجْهِهِ  ، فَذَكَرْتُ ذَلِكَ  لِعَمْرِو بْنِ مُرَّةَ  قَالَ : أَوْ نَحْوَ ذَلِكَ .","","Al-Mu'jam al-Kabir 104","","وائل بن حجر بن سعد الحضرمي عن عبد الرحمن بن اليحصبي الكوفي عن سعيد بن فيروز الطائي عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن أبو داود الطيالسي عن يونس بن حبيب الماصر عن محمد بن إسماعيل بن أحمد الأصبهاني عن الطبراني","عبد الرحمن اليحصبي عن وائل بن حجر"
"19597","105  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  أَبُو بِلَالٍ الْأَشْعَرِيُّ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ قَالَا :  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي الْبَخْتَرِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ الْيَحْصَبِيِّ ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُسَلِّمُ عَنْ يَمِينِهِ  وَعَنْ شِمَالِهِ حَتَّى يُرَى بَيَاضُ خَدِّهِ  "" .","","Al-Mu'jam al-Kabir 105","","وائل بن حجر بن سعد الحضرمي عن عبد الرحمن بن اليحصبي الكوفي عن سعيد بن فيروز الطائي عن عمرو بن مرة المرادي عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","عبد الرحمن اليحصبي عن وائل بن حجر"
"19598","106  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ ، وَأَحْمَدُ بْنُ مُحَمَّدٍ الْخُزَاعِيُّ الْأَصْبَهَانِيُّ قَالَا :  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  عَبْدِ الْأَعْلَى  قَالَ  :  صَلَّيْتُ خَلْفَ عَبْدِ الرَّحْمَنِ الْيَحْصَبِيِّ فَسَلَّمَ عَنْ يَمِينِهِ  السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ ، وَعَنْ يَسَارِهِ مِثْلَ ذَلِكَ ، قَالَ : قُلْتُ لَهُ : مِنْ أَيْنَ أَخَذْتَ هَذَا  ؟  قَالَ  :  صَلَّيْتُ خَلْفَ وَائِلِ بْنِ حُجْرٍ  قَالَ :  صَلَّيْتُ خَلْفَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فَفَعَلَ مِثْلَ ذَلِكَ حَتَّى رَأَيْتُ بَيَاضَ خَدَّيْهِ  .","","Al-Mu'jam al-Kabir 106","","وائل بن حجر بن سعد الحضرمي عن عبد الرحمن بن اليحصبي الكوفي عن عبد الأعلى بن عامر الثعلبي عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن كثير العبدي عن أحمد بن محمد بن علي الخزاعي عن الطبراني","عبد الرحمن اليحصبي عن وائل بن حجر"
"19599","107  -  حَدَّثَنَا  الْقَاسِمُ بْنُ عَبَّادٍ الْخَطَّابِيُّ  ، ثَنَا  أَحْمَدُ بْنُ عَبْدِ الْجَبَّارِ         [22/43]      الْعُطَارِدِيُّ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  أَبِي بَكْرٍ النَّهْشَلِيِّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عَبْدِ اللهِ الْيَحْصَبِيِّ ،  عَنْ  وَائِلِ بْنِ حُجْرٍ ، أَنَّهُ  سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِينَ قَالَ :         {      غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ         }      قَالَ :  رَبِّ اغْفِرْ لِي آمِينَ  .","","Al-Mu'jam al-Kabir 107","","وائل بن حجر بن سعد الحضرمي عن عبد الرحمن بن اليحصبي الكوفي عن أبو إسحاق السبيعي عن أبو بكر النهشلي عن عبد الجبار بن محمد بن عمير العطاردي عن أحمد بن عبد الجبار العطاردي عن القاسم بن عباد الخطابى عن الطبراني","عبد الرحمن اليحصبي عن وائل بن حجر"
"19600","108  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  شُعْبَةَ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي الْبَخْتَرِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ الْيَحْصَبِيِّ ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  شَهِدْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِينَ أُتِيَ بِالْقَاتِلِ يَجُرُّ  نِسْعَتَهُ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِوَلِيِّ الْمَقْتُولِ : "" أَتَعْفُو عَنْهُ ؟ "" قَالَ : لَا ، قَالَ : "" فَتَأْخُذُ ؟ "" قَالَ : لَا ، قَالَ : "" فَتَقْتُلُهُ ؟ "" قَالَ : نَعَمْ ، فَأَعَادَ عَلَيْهِ ثَلَاثًا ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّكَ إِنْ عَفَوْتَ عَنْهُ فَإِنَّهُ  يَبُوءُ  بِإِثْمِهِ  قَالَ : فَعَفَا عَنْهُ ، قَالَ : فَرَأَيْتُهُ يَجُرُّ  نِسْعَتَهُ  قَدْ عَفَا عَنْهُ  .","","Al-Mu'jam al-Kabir 108","","وائل بن حجر بن سعد الحضرمي عن عبد الرحمن بن اليحصبي الكوفي عن سعيد بن فيروز الطائي عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبد الرحمن اليحصبي عن وائل بن حجر"
"19601","أَبُو الْعَنْبَسِ  عَنْ  وَائِلِ بْنِ حُجْرٍ  109  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  أَبُو الْوَلِيدِ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ قَالَ :  سَمِعْتُ  أَبَا عَنْبَسٍ ،  يُحَدِّثُ ، عَنْ  وَائِلٍ الْحَضْرَمِيِّ ،  أَنَّهُ صَلَّى         [22/44]      خَلْفَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَلَمَّا قَالَ :         {      وَلا الضَّالِّينَ         }      قَالَ : "" آمِينَ  فَأَخْفَى بِهَا صَوْتَهُ ، وَوَضَعَ يَدَهُ الْيُمْنَى عَلَى يَدِهِ الْيُسْرَى وَسَلَّمَ عَنْ يَمِينِهِ وَعَنْ يَسَارِهِ  .","","Al-Mu'jam al-Kabir 109","","وائل بن حجر بن سعد الحضرمي عن حجر بن العنبس الحضرمي عن سلمة بن كهيل الحضرمي عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن معاذ بن المثنى العنبري عن الطبراني","أبو العنبس عن وائل بن حجر"
"19602","110  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  حَجَّاجُ بْنُ نُصَيْرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ قَالَ :  سَمِعْتُ  حُجْرَ أَبَا الْعَنْبَسِ  يُحَدِّثُ ، عَنْ  وَائِلٍ الْحَضْرَمِيِّ ،  أَنَّهُ صَلَّى مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِينَ قَالَ :         {      وَلا الضَّالِّينَ         }      قَالَ : "" آمِينَ  وَأَخْفَى بِهَا صَوْتَهُ ، ثُمَّ وَضَعَ يَدَهُ الْيُمْنَى عَلَى الْيُسْرَى ، وَجَعَلَهَا عَلَى بَطْنِهِ ، وَكَانَ إِذَا قَالَ : ""  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ "" قَالَ : "" اللَّهُمَّ رَبَّنَا لَكَ الْحَمْدُ "" وَيُسَلِّمُ عَنْ يَمِينِهِ وَعَنْ يَسَارِهِ تَسْلِيمَتَيْنِ  .","","Al-Mu'jam al-Kabir 110","","وائل بن حجر بن سعد الحضرمي عن حجر بن العنبس الحضرمي عن سلمة بن كهيل الحضرمي عن شعبة بن الحجاج عن حجاج بن نصير الفساطيطي عن أبو مسلم الكجي عن الطبراني","أبو العنبس عن وائل بن حجر"
"19603","111  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ الرَّقِّيُّ قَالَ :  ثَنَا  قَبِيصَةُ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ قَالَا :  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ قَالَا :  ثَنَا  سُفْيَانُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  حُجْرِ بْنِ الْعَنْبَسِ الْحَضْرَمِيِّ ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا قَالَ :         {      وَلا الضَّالِّينَ         }      قَالَ : "" آمِينَ  يَرْفَعُ بِهَا صَوْتَهُ  .","","Al-Mu'jam al-Kabir 111","","وائل بن حجر بن سعد الحضرمي عن حجر بن العنبس الحضرمي عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن قبيصة بن عقبة السوائي عن حفص بن عمر سنجة ألف عن الطبراني","أبو العنبس عن وائل بن حجر"
"19604","[22/45]      112  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ قَالَ :  ثَنَا  وَكِيعٌ ،  عَنْ  شُعْبَةَ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِي الْعَنْبَسِ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ قَالَ :  صَلَّيْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَسَمِعْتُهُ حِينَ قَالَ :         {      وَلا الضَّالِّينَ         }      قَالَ : "" آمِينَ  وَيَخْفِضُ بِهَا صَوْتَهُ وَوَضَعَ يَدَهُ الْيُمْنَى عَلَى الْيُسْرَى ، وَيُسَلِّمُ عَنْ يَمِينِهِ وَعَنْ يَسَارِهِ  .","","Al-Mu'jam al-Kabir 112","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن حجر بن العنبس الحضرمي عن سلمة بن كهيل الحضرمي عن شعبة بن الحجاج عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو العنبس عن وائل بن حجر"
"19605","113  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  الْأَزْرَقُ بْنُ عَلِيٍّ ،  ثَنَا  حَسَّانُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي السَّكَنِ حُجْرِ بْنِ عَنْبَسٍ قَالَ :  سَمِعْتُ  وَائِلَ بْنَ حُجْرٍ الْحَضْرَمِيَّ يَقُولُ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُسَلِّمُ حَتَّى رَأَيْتُ بَيَاضَ خَدِّهِ  مِنْ ذَا الْجَانِبِ ، وَمِنْ ذَا الْجَانِبِ  .","","Al-Mu'jam al-Kabir 113","","وائل بن حجر بن سعد الحضرمي عن حجر بن العنبس الحضرمي عن سلمة بن كهيل الحضرمي عن محمد بن سلمة بن كهيل الكوفي عن حسان بن إبراهيم الكرماني عن الأزرق بن علي بن مسلم الحنفي عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو العنبس عن وائل بن حجر"
"19606","114  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  ابْنُ نُمَيْرٍ ،  عَنِ  الْعَلَاءِ بْنِ صَالِحٍ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَنْدَهْ الْأَصْبَهَانِيُّ  ، حَدَّثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ، وَعَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنِ  الْعَلَاءِ بْنِ صَالِحٍ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  حُجْرِ بْنِ عَنْبَسٍ ،  عَنْ  وَائِلٍ قَالَ :  صَلَّيْتُ خَلْفَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَجَهَرَ بِآمِينَ  ، وَسَلَّمَ عَنْ يَمِينِهِ وَعَنْ شِمَالِهِ حَتَّى رَأَيْتُ بَيَاضَ خَدِّهِ  .","","Al-Mu'jam al-Kabir 114","","وائل بن حجر بن سعد الحضرمي عن حجر بن العنبس الحضرمي عن سلمة بن كهيل الحضرمي عن العلاء بن صالح التيمي عن عبد الله بن نمير عن أبو كريب محمد بن العلاء عن محمد بن يحيى بن مندة عن الطبراني","أبو العنبس عن وائل بن حجر"
"19607","115  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ  ، ثَنَا  أَبُو الشَّعْثَاءِ عَلِيُّ بْنُ الْحَسَنِ ،  ثَنَا  يَحْيَى بْنُ آدَمَ ،  ثَنَا  مُوسَى بْنُ قَيْسٍ الْحَضْرَمِيُّ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ الْحَضْرَمِيِّ ،  عَنْ  أَبِيهِ  قَالَ :  صَلَّيْتُ مَعَ رَسُولِ         [22/46]      اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَسَلَّمَ عَنْ يَمِينِهِ  : السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ ، وَعَنْ يَسَارِهِ : السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ  هَكَذَا رَوَاهُ  مُوسَى بْنُ قَيْسٍ  ، عَنْ  سَلَمَةَ  قَالَ : عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ  وَزَادَ فِي السَّلَامِ :  وَبَرَكَاتُهُ  .","","Al-Mu'jam al-Kabir 115","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن سلمة بن كهيل الحضرمي عن عصفور الجنة  ، موسى بن قيس الفراء عن يحيى بن آدم عن علي بن الحسن بن سليمان الحضرمي عن بحشل عن الطبراني","أبو العنبس عن وائل بن حجر"
"19608","أَبُو حَرِيزٍ  ، عَنْ  وَائِلِ بْنِ حُجْرٍ  116  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ  ، ثَنَا  يَحْيَى بْنُ دَاوُدَ ،  ثَنَا  إِسْحَاقُ الْأَزْرَقُ ،  عَنْ  سُفْيَانَ ،  عَنْ  جَابِرٍ ،  عَنْ  أَبِي حَرِيزٍ ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ وَجِعٌ حَتَّى اشْتَكَى صَلَّى جَالِسًا عَلَى جَنْبِهِ إِلَى يَمِينِهِ  .","","Al-Mu'jam al-Kabir 116","","وائل بن حجر بن سعد الحضرمي عن أبو حريز عن جابر الجعفي عن سفيان الثوري عن إسحاق بن يوسف الأزرق عن يحيى بن داود بن ميمون الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","أبو حريز عن وائل بن حجر"
"19609","أُمُّ يَحْيَى  امْرَأَةُ  وَائِلِ بْنِ حُجْرٍ  عَنْ  وَائِلِ بْنِ حُجْرٍ  117  -  حَدَّثَنَا  أَبُو هِنْدٍ يَحْيَى بْنُ عَبْدِ اللهِ بْنِ حُجْرِ بْنِ عَبْدِ الْجَبَّارِ بْنِ وَائِلِ بْنِ حُجْرٍ الْحَضْرَمِيُّ  بِالْكُوفَةِ  قَالَ :  حَدَّثَنِي  عَمِّي مُحَمَّدُ بْنُ حُجْرٍ قَالَ :  حَدَّثَنِي  عَمِّي سَعِيدُ بْنُ عَبْدِ الْجَبَّارِ ،  عَنْ  أَبِيهِ عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أُمِّهِ أُمِّ يَحْيَى ،  عَنْ  وَائِلِ بْنِ حُجْرٍ  قَالَ :  لَمَّا بَلَغَنَا ظُهُورُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَرَجْتُ وَافِدًا عَنْ قَوْمِي حَتَّى قَدِمْتُ  الْمَدِينَةَ  ، فَلَقِيتُ أَصْحَابَهُ قَبْلَ لِقَائِهِ فَقَالُوا : قَدْ بَشَّرَنَا بِكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ قَبْلِ أَنْ تَقْدَمَ عَلَيْنَا بِثَلَاثَةِ أَيَّامٍ فَقَالَ : "" قَدْ جَاءَكُمْ  وَائِلُ بْنُ حُجْرٍ  "" ثُمَّ لَقِيتُهُ         [22/47]      عَلَيْهِ السَّلَامُ ، فَرَحَّبَ بِي ، وَأَدْنَا مَجْلِسِي ، وَبَسَطَ لِي رِدَاءَهُ فَأَجْلَسَنِي عَلَيْهِ ، ثُمَّ دَعَا فِي النَّاسِ ، فَاجْتَمَعُوا إِلَيْهِ ، ثُمَّ اطَّلَعَ الْمِنْبَرَ ، وَأَطْلَعَنِي مَعَهُ فَأَنَا مِنْ دُونِهِ ، ثُمَّ حَمِدَ اللهَ وَقَالَ :  يَا أَيُّهَا النَّاسُ ، هَذَا  وَائِلُ بْنُ حُجْرٍ  أَتَاكُمْ مِنْ بِلَادٍ بَعِيدَةٍ  مِنْ بِلَادِ  حَضْرَمَوْتَ  طَائِعًا غَيْرَ مُكْرَهٍ ، بَقِيَّةُ أَبْنَاءِ الْمُلُوكِ ، بَارَكَ اللهُ فِيكَ يَا  وَائِلُ  ، وَفِي وَلَدِكَ ، وَفِي وَلَدِ وَلَدِكَ "" ، ثُمَّ نَزَلَ وَأَنْزَلَنِي مَعَهُ وَنَزَّلَنِي مَنْزِلًا شَاسِعًا مِنَ  الْمَدِينَةِ  ، وَأَمَرَ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ  أَنْ يُنْزِلَنِي إِيَّاهُ ، فَخَرَجْتُ وَخَرَجَ مَعِي حَتَّى إِذَا كُنَّا بِبَعْضِ الطَّرِيقِ قَالَ : يَا  وَائِلُ  ، إِنَّ الرَّمْضَاءَ قَدْ أَصَابَتْ بَاطِنَ قَدَمَيَّ فَأَرْدِفْنِي خَلْفَكَ ، قُلْتُ : مَا أَضِنُّ عَنْكَ بِهَذِهِ النَّاقَةِ ، وَلَكِنْ لَسْتَ مِنْ أَرْدَافِ الْمُلُوكِ ، وَأَكْرَهُ أَنْ أُعَيَّرَ بِكَ ، قَالَ : فَأَلْقِ إِلَيَّ حِذَاءَكَ أَتَوَقَّى بِهِ مِنْ حَرِّ الشَّمْسِ ، قَالَ : مَا أَضِنُّ عَنْكَ بِهَاتَيْنِ الْجِلْدَتَيْنِ ، وَلَكِنْ لَسْتَ مِمَّنْ يَلْبَسُ لِبَاسَ الْمُلُوكِ ، وَأَكْرَهُ أَنْ أُعَيَّرَ بِكَ ، فَلَمَّا أَرَدْتُ الرُّجُوعَ إِلَى قَوْمِي أَمَرَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِكُتُبٍ ثَلَاثَةٍ ؛ مِنْهَا : كِتَابٌ لِي خَالِصٌ يُفَضِّلُنِي فِيهِ عَلَى قَوْمِي ، وَكِتَابٌ لِي وَلِأَهْلِ بَيْتِي بِأَمْوَالِنَا هُنَالِكَ ، وَبِكِتَابٍ لِي وَلِقَوْمِي ، فِي كِتَابِي الْخَالِصِ :  "" بِسْمِ اللهِ مِنْ  مُحَمَّدٍ  رَسُولِ اللهِ إِلَى  الْمُهَاجِرِ بْنِ أَبِي أُمَيَّةَ  : إِنَّ  وَائِلًا  يُسْتَسْعَى  وَيَتَرَفَّلُ  فِي الْأَقْبَالِ حَيْثُ كَانُوا مِنْ  حَضْرَمَوْتَ  "" .  وَفِي كِتَابِي الَّذِي لِي وَلِأَهْلِ بَيْتِي : "" بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ مِنْ  مُحَمَّدٍ  رَسُولِ اللهِ إِلَى  الْمُهَاجِرِ بْنِ أَبِي أُمَيَّةَ  لِأَبْنَاءِ مَعْشَرٍ  ،  وَأَبْنَاءِ ضَمْعَاجٍ أَقْيَالُ شَنُوءَةَ  بِمَا كَانَ لَهُمْ فِيهَا مِنْ مِلْكٍ وَمَرَاهِنَ ، وَعُمْرَانٍ ، وَبَحْرٍ ، وَمِلْحٍ ، وَمَحْجَرٍ ، وَمَا كَانَ مِنْ مَالٍ اتَّرَثُوهُ وَمَاءِ يَنَابِعَ وَمَا لَهُمْ فِيهَا مِنْ مَالٍ  بِحَضْرَمَوْتَ  أَعْلَاهَا وَأَسْفَلَهَا عَلَى الذِّمَّةِ وَالْجِوَارِ ، اللهُ لَهُمْ جَارٌ ، وَالْمُؤْمِنُونَ عَلَى ذَلِكَ أَنْصَارٌ .  وَفِي الْكِتَابِ الَّذِي لِي وَلِقَوْمِي : "" بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ مِنْ  مُحَمَّدٍ         [22/48]      رَسُولِ اللهِ إِلَى  وَائِلِ بْنِ حُجْرٍ  وَالْأَقْوَالِ الْعَيَاهِلَةِ مِنْ  حَضْرَمَوْتَ  بِإِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ مِنَ الصِّرْمَةِ التَّبِعَةِ ، وَلِصَاحِبِهَا الثِّيمَةُ ، لَا  جَلَبَ  وَلَا  جَنَبَ  وَلَا شِغَارَ وَلَا  وِرَاطَ  فِي الْإِسْلَامِ ، لِكُلِّ عَشَرَةٍ مِنَ السَّرَايَا مَا يَحْمِلُ  الْقِرَابُ  مِنَ التَّمْرِ ، مَنْ  أَجْبَا  فَقَدْ  أَرْبَى  ، وَكُلُّ مُسْكِرٍ حَرَامٌ ،  فَلَمَّا مَلَكَ  مُعَاوِيَةُ  بَعَثَ رَجُلًا مِنْ  قُرَيْشٍ  ، يُقَالُ لَهُ  بُسْرُ بْنُ أَرْطَاةَ  ، وَقَالَ لَهُ : لَقَدْ ضَمَمْتُ إِلَيْكَ النَّاحِيَةَ فَاخْرُجْ بِجَيْشِكَ ، فَإِذَا خَلَّفْتَ أَفْوَاهَ  الشَّامِ  فَضَعْ سَيْفَكَ ، فَاقْتُلْ مَنْ أَبَى بَيْعَتِي حَتَّى تَصِيرَ إِلَى  الْمَدِينَةِ  ، ثُمَّ ادْخُلِ  الْمَدِينَةَ  فَاقْتُلْ مَنْ أَبَى بَيْعَتِي ، ثُمَّ اخْرُجْ إِلَى  حَضْرَمَوْتَ  فَاقْتُلْ مَنْ أَبَى بَيْعَتِي ، وَإِنْ أَصَبْتَ  وَائِلَ بْنَ حُجْرٍ  حَيًّا فَائْتِنِي بِهِ ، فَفَعَلَ فَأَصَابَ  وَائِلَ بْنَ حُجْرٍ  حَيًّا فَجَاءَ بِهِ إِلَيْهِ ، فَأَمَرَ  مُعَاوِيَةُ  أَنْ يَتَلَقَّى وَأَذِنَ لَهُ فَأَجْلَسَهُ مَعَهُ عَلَى سَرِيرِهِ ، فَقَالَ لَهُ  مُعَاوِيَةُ  : أَسَرِيرِي هَذَا أَفْضَلُ أَمْ ظَهْرُ نَاقَتِكَ ؟ قُلْتُ : يَا أَمِيرَ الْمُؤْمِنِينَ ، كُنْتُ حَدِيثَ عَهْدٍ بِجَاهِلِيَّةٍ وَكُفْرٍ ، وَكَانَتْ تِلْكَ سِيرَةَ الْجَاهِلِيَّةِ ، وَقَدْ أَتَانَا اللهُ الْيَوْمَ بِالْإِسْلَامِ فَسِيرَةُ الْإِسْلَامِ مَا فَعَلْتَ ، قَالَ : فَمَا مَنَعَكَ مِنْ نَصْرِنَا وَقَدِ اتَّخَذَكَ  عُثْمَانُ  ثِقَةً وَصِهْرًا ؟ قُلْتُ : إِنَّكَ قَاتَلْتَ رَجُلًا هُوَ أَحَقُّ  بِعُثْمَانَ  مِنْكَ ، قَالَ : فَكَيْفَ يَكُونُ أَحَقَّ  بِعُثْمَانَ  مِنِّي فَأَنَا أَقْرَبُ إِلَى  عُثْمَانَ  بِالنَّسَبِ ؟ قُلْتُ : إِنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ آخَى بَيْنَ  عَلِيٍّ  وَعُثْمَانَ  ، وَالْأَخُ أَوْلَى مِنَ ابْنِ الْعَمِّ ، وَلَسْتُ أُقَاتِلُ  الْمُهَاجِرِينَ  ، قَالَ : أَوَلَسْنَا  مُهَاجِرِينَ  ؟ قُلْتُ : أَوَلَيْسَ قَدِ اعْتَزَلْنَاكُمَا جَمِيعًا ؟ وَحُجَّةٌ أُخْرَى حَضَرْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقَدْ رَفَعَ رَأْسَهُ نَحْوَ الْمَشْرِقِ ، وَقَدْ حَضَرَهُ جَمْعٌ كَثِيرٌ ثُمَّ رَدَّ إِلَيْهِ بَصَرَهُ فَقَالَ :  أَتَتْكُمُ الْفِتَنُ  كَقِطَعِ  اللَّيْلِ الْمُظْلِمِ  ، فَشَدَّ أَمْرَهَا وَعَجَّلَهُ وَقَبَّحَهُ "" ، قُلْتُ لَهُ مِنْ بَيْنِ  الْقَوْمِ  : يَا رَسُولَ اللهِ ، وَمَا الْفِتَنُ ؟ قَالَ : "" يَا  وَائِلُ  ، إِذَا اخْتَلَفَ سَيْفَانِ فِي الْإِسْلَامِ فَاعْتَزِلْهُمَا "" فَقَالَ : أَصْبَحْتَ شِيعِيًّا ؟ فَقُلْتُ : لَا ، وَلَكِنْ         [22/49]      أَصْبَحْتُ نَاصِحًا لِلْمُسْلِمِينَ ، فَقَالَ  مُعَاوِيَةُ  : لَوْ سَمِعْتُ ذَا وَعَلِمْتُهُ مَا أَقْدَمْتُكَ ، قُلْتُ : أَوَلَيْسَ قَدْ رَأَيْتَ مَا صَنَعَ  مُحَمَّدُ بْنُ مَسْلَمَةَ  عِنْدَ مَقْتَلِ  عُثْمَانَ  ؟ أَوْمَأَ بِسَيْفِهِ إِلَى صَخْرَةٍ فَضَرَبَهُ بِهَا حَتَّى انْكَسَرَ ، قَالَ : أُولَئِكَ قَوْمٌ يَحْمِلُونَ عَلَيْنَا ، قُلْتُ : فَكَيْفَ نَصْنَعُ بِقَوْلِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَحَبَّ  الْأَنْصَارَ  فَبِحُبِّي ، وَمَنْ أَبْغَضَهُمْ فَبِبُغْضِي  ؟ فَقَالَ : اخْتَرْ أَيَّ الْبِلَادِ شِئْتَ ، فَإِنَّكَ لَسْتَ بِرَاجِعٍ إِلَى  حَضْرَمَوْتَ  ، فَقُلْتُ : عَشِيرَتِي  بِالشَّامِ  ، وَأَهْلُ بَيْتِي  بِالْكُوفَةِ  ، فَقَالَ : رَجُلٌ مِنْ أَهْلِ بَيْتِكَ خَيْرٌ مِنْ عَشَرَةٍ مِنْ عَشِيرَتِكَ ، فَقُلْتُ : مَا رَجَعْتُ إِلَى  حَضْرَمَوْتَ  سُرُورًا بِهَا ، وَمَا يَنْبَغِي لِلْمُهَاجِرِ أَنْ يَرْجِعَ إِلَى الْمَوْضِعِ الَّذِي هَاجَرَ مِنْهُ إِلَّا مِنْ عِلَّةٍ ، قَالَ : وَمَا عِلَّتُكَ ؟ قُلْتُ : قَوْلُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْفِتَنِ ، فَحَيْثُ اخْتَلَفْتُمُ اعْتَزَلْنَاكُمْ وَحَيْثُ اجْتَمَعْتُمْ جِئْنَاكُمْ ، فَهَذِهِ الْعِلَّةُ ، فَقَالَ : إِنِّي قَدْ وَلَّيْتُكَ  الْكُوفَةَ  فَسِرْ إِلَيْهَا ، فَقُلْتُ : مَا أَلِي بَعْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِأَحَدٍ ، أَمَا رَأَيْتَ  أَبَا بَكْرٍ  قَدْ أَرَادَنِي فَأَبَيْتُ ، وَأَرَادَنِي  عُمَرُ  فَأَبَيْتُ ، وَأَرَادَنِي  عُثْمَانُ  فَأَبَيْتُ ، وَلَمْ أَدَعْ بَيْعَتَهُمْ ، قَدْ جَاءَ فِي كِتَابِ  أَبِي بَكْرٍ  حَيْثُ ارْتَدَّ أَهْلُ نَاحِيَتِنَا ، فَقُمْتُ فِيهِمْ حَتَّى رَدَّهُمُ اللهُ إِلَى الْإِسْلَامِ بِغَيْرِ وِلَايَةٍ ، فَدَعَا  عَبْدَ الرَّحْمَنِ ابْنَ أُمِّ الْحَكَمِ  ، فَقَالَ لَهُ : سِرْ فَقَدْ وَلَّيْتُكَ  الْكُوفَةَ  وَسِرْ  بِوَائِلِ بْنِ حُجْرٍ  فَأَكْرِمْهُ وَاقْضِ حَوَائِجَهُ ، فَقَالَ : يَا أَمِيرَ الْمُؤْمِنِينَ ، أَسَأْتَ فِيَّ الظَّنَّ ، تَأْمُرُنِي بِإِكْرَامِ رَجُلٍ قَدْ رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَكْرَمَهُ  وَأَبَا بَكْرٍ  ،  وَعُمَرَ  ، وَأَنْتَ ، قَالَ : فَسِرْ بِمَعْرِفَةِ ذَلِكَ مِنْهُ ، فَقَدِمَ مَعَهُ  .","","Al-Mu'jam al-Kabir 117","","وائل بن حجر بن سعد الحضرمي عن أم يحيى عن عبد الجبار بن وائل بن حجر الحضرمي عن سعيد بن عبد الجبار بن وائل بن حجر الحضرمي عن محمد بن حجر بن عبد الجبار عن يحيى بن عبد الله بن حجر الكوفي عن الطبراني","أم يحيى امرأة وائل بن حجر عن وائل بن حجر"
"19610","118  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  مُحَمَّدُ بْنُ حُجْرِ بْنِ عَبْدِ الْجَبَّارِ         [22/50]      بْنِ وَائِلٍ الْحَضْرَمِيُّ  حَدَّثَنِي  عَمِّي  سَعِيدُ بْنُ عَبْدِ الْجَبَّارِ ،  عَنْ  أَبِيهِ ،  عَنْ  أُمِّهِ أُمِّ يَحْيَى  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ قَالَ :  "" حَضَرْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقَدْ أُتِيَ بِإِنَاءٍ فِيهِ مَاءٌ ، فَأَكْفَأَ عَلَى يَمِينِهِ ثَلَاثًا ، ثُمَّ غَمَسَ يَمِينَهُ فِي الْإِنَاءِ فَأَفَاضَ بِهَا عَلَى الْيُسْرَى ثَلَاثًا ، ثُمَّ غَمَسَ الْيُمْنَى فِي الْمَاءِ فَحَفَنَ حَفْنَةً مِنْ مَاءٍ فَتَمَضْمَضَ بِهَا وَاسْتَنْشَقَ ،  وَاسْتَنْثَرَ  ثَلَاثًا ، ثُمَّ أَدْخَلَ كَفَّيْهِ فِي الْإِنَاءِ فَحَمَلَ بِهِمَا مَاءً ، فَغَسَلَ وَجْهَهُ ثَلَاثًا ، وَخَلَّلَ لِحْيَتَهُ ، وَمَسَحَ بَاطِنَ أُذُنَيْهِ ، ثُمَّ أَدْخَلَ خِنْصَرَهُ فِي دَاخِلِ أُذُنِهِ لِيُبَلِّغَ الْمَاءَ ، ثُمَّ مَسَحَ رَقَبَتَهُ ، وَبَاطِنَ لِحْيَتِهِ مِنْ فَضْلِ مَاءِ الْوَجْهِ ، وَغَسَلَ ذِرَاعَهُ الْيُمْنَى ثَلَاثًا حَتَّى مَا وَرَاءَ الْمِرْفَقِ ، وَغَسَلَ الْيُسْرَى مِثْلَ ذَلِكَ بِالْيُمْنَى حَتَّى جَاوَزَ الْمِرْفَقَ ، ثُمَّ مَسَحَ عَلَى رَأْسِهِ ثَلَاثًا ، وَمَسَحَ ظَاهِرَ أُذُنَيْهِ ، وَمَسَحَ رَقَبَتَهُ وَبَاطِنَ لِحْيَتِهِ بِفَضْلِ مَاءِ الرَّأْسِ ، ثُمَّ غَسَلَ قَدَمَهُ الْيُمْنَى ثَلَاثًا ، وَخَلَّلَ أَصَابِعَهَا وَجَاوَزَ بِالْمَاءِ الْكَعْبَ ، وَرَفَعَ فِي السَّاقِ الْمَاءَ ، ثُمَّ فَعَلَ فِي الْيُسْرَى مِثْلَ ذَلِكَ ، ثُمَّ أَخَذَ حَفْنَةً مِنْ مَاءٍ بِيَدِهِ الْيُمْنَى فَوَضَعَهُ عَلَى رَأْسِهِ حَتَّى تَحَدَّرَ مِنْ جَوَانِبِ رَأْسِهِ ، وَقَالَ :  هَذَا تَمَامُ الْوُضُوءِ  فَدَخَلَ  مِحْرَابَهُ  فَصَفَّ النَّاسَ خَلْفَهُ ، وَنَظَرَ عَنْ يَمِينِهِ وَيَسَارِهِ ، ثُمَّ رَفَعَ يَدَيْهِ بِالتَّكْبِيرِ إِلَى أَنْ أَزَّتَا  شَحْمَةَ  أُذُنَيْهِ ، ثُمَّ وَضَعَ يَمِينَهُ عَلَى يَسَارِهِ عَلَى صَدْرِهِ ، ثُمَّ جَهَرَ بِالْحَمْدِ حَتَّى فَرَغَ مِنَ         {      الْحَمْدُ         }      ، ثُمَّ جَهَرَ بِآمِينَ عِنْدَ فَرَاغِهِ مِنْ قِرَاءَةِ         {      الْحَمْدُ         }      حَتَّى  سَمِعَ  مَنْ خَلْفَهُ ، ثُمَّ قَرَأَ سُورَةً أُخْرَى مَعَ         {      الْحَمْدُ         }      ، ثُمَّ رَفَعَ يَدَيْهِ بِالتَّكْبِيرِ إِلَى أَنْ أَزَّتَا  شَحْمَةَ  أُذُنَيْهِ ، ثُمَّ انْحَطَّ رَاكِعًا فَوَضَعَ كَفَّيْهِ عَلَى رُكْبَتَيْهِ ، وَفَرَّجَ أَصَابِعَهُ ، وَأَمْهَلَ فِي الرُّكُوعِ حَتَّى اعْتَدَلَ رُكُوعُهُ وَصَارَ مَتْنَاهُ         [22/51]      كَأَنَّهُمَا نَهَرٌ جَارٍ لَوْ وُضِعَ عَلَيْهِ قَدَحٌ مَلْآنُ مَا  انْكَفَأَ  ، ثُمَّ رَفَعَ رَأْسَهُ بِالْخُشُوعِ وَرَفَعَ يَدَيْهِ حَتَّى أَزَّتَا  شَحْمَةَ  أُذُنَيْهِ ، وَقَالَ : ""  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ "" ثُمَّ اعْتَدَلَ قَائِمًا وَأَمْهَلَ فِيهِ حَتَّى رَجَعَ كُلُّ عَظْمٍ إِلَى مَوْضِعِهِ ، ثُمَّ انْحَطَّ بِالتَّكْبِيرِ سَاجِدًا فَأَثْبَتَ جَبْهَتَهُ فِي الْأَرْضِ وَأَنْفَهُ حَتَّى رَأَى أَثَرَ أَنْفِهِ فِي الرَّمْلِ ، وَفَرَشَ ذِرَاعَيْهِ وَرَأْسَهُ بَيْنَهُمَا ، ثُمَّ رَفَعَ رَأْسَهُ بِالتَّكْبِيرِ ، وَجَلَسَ جَلْسَةً خَفِيفَةً فَاسْتَبْطَنَ فَخِذَهُ الْيُسْرَى وَنَصَبَ قَدَمَهُ الْيُمْنَى أَثْبَتَ أَصَابِعَهُمَا ، ثُمَّ انْحَطَّ سَاجِدًا مِثْلَ ذَلِكَ ، ثُمَّ رَفَعَ رَأْسَهُ بِالتَّكْبِيرِ ، ثُمَّ فَعَلَ مِثْلَ ذَلِكَ فِي جَمِيعِ الصَّلَاةِ حَتَّى تَمَّتْ أَرْبَعَ رَكَعَاتٍ ، ثُمَّ جَلَسَ فِي  التَّشَهُّدِ  فَوَضَعَ كَفَّهُ الْيُمْنَى عَلَى رُكْبَتِهِ الْيُمْنَى وَخَفَضَ فَخِذَهُ وَحَلَّقَ أُصْبُعَهُ يَدْعُو بِهِ مِنْ تَحْتِ الثَّوْبِ ، وَكَانَ ذَلِكَ فِي الشِّتَاءِ ، وَكَانَ أَصْحَابُهُ خَلْفَهُ أَيْدِيهِمْ فِي ثِيَابِهِمْ يَعْمَلُونَ هَذَا ، وَتَنَفَّلَ ثُمَّ سَلَّمَ عَنْ يَمِينِهِ حَتَّى رُئِيَ بَيَاضُ خَدِّهِ الْأَيْمَنِ ، ثُمَّ سَلَّمَ عَنْ يَسَارِهِ حَتَّى رُئِيَ بَيَاضُ خَدِّهِ الْأَيْسَرِ  .","","Al-Mu'jam al-Kabir 118","","وائل بن حجر بن سعد الحضرمي عن أم يحيى عن عبد الجبار بن وائل بن حجر الحضرمي عن سعيد بن عبد الجبار بن وائل بن حجر الحضرمي عن محمد بن حجر بن عبد الجبار عن بشر بن موسى بن صالح الأسدي عن الطبراني","أم يحيى امرأة وائل بن حجر عن وائل بن حجر"
"19611","119  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ قَالَ :  حَدَّثَنِي  أَهْلِي ،  عَنْ  أَبِي قَالَ :  أُتِيَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِدَلْوٍ مِنْ مَاءٍ فَشَرِبَ  ، ثُمَّ  مَجَّ  فِي الدَّلْوِ ، ثُمَّ  صَبَّ فِي الْبِئْرِ أَوْ شَرِبَ مِنَ الدَّلْوِ  ، ثُمَّ  مَجَّ  فِي الْبِئْرِ ، فَفَاحَ مِنْهَا مِثْلُ رِيحِ الْمِسْكِ  .","","Al-Mu'jam al-Kabir 119","","وائل بن حجر بن سعد الحضرمي عن أهل عبد الجبار بن وائل بن حجر الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أم يحيى امرأة وائل بن حجر عن وائل بن حجر"
"19612","120  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  مِسْعَرٍ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  بَعْضِ أَهْلِهِ  عَنْ  أَبِيهِ ، أَنَّهُ  رَأَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُتِيَ بِدَلْوٍ فَتَوَضَّأَ مِنْهُ  فَمَضْمَضَ ، ثُمَّ  مَجَّ فِيهِ الْمِسْكَ ، أَوْ أَطْيَبَ مِنَ الْمِسْكِ  ،  وَاسْتَنْثَرَ  خَارِجَهُ  .","","Al-Mu'jam al-Kabir 120","","وائل بن حجر بن سعد الحضرمي عن بعض أهل عبد الجبار بن وائل بن حجر الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن مسعر بن كدام عن سفيان بن عيينة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","أم يحيى امرأة وائل بن حجر عن وائل بن حجر"
"19613","[22/52]      مَنِ اسْمُهُ وَاثِلَةُ  وَاثِلَةُ بْنُ الْأَسْقَعِ اللَّيْثِيُّ  يُكَنَّى أَبَا الْأَسْقَعِ وَيُقَالُ : أَبُو قِرْصَافَةَ ، وَيُقَالُ : أَبُو شَدَّادٍ  ، كَانَ يَنْزِلُ  الشَّامَ  بِدِمَشْقَ  ، وَهُوَ  وَاثِلَةُ بْنُ الْأَسْقَعِ بْنِ عَبْدِ الْعُزَّى بْنِ عَبْدِ يَالِيلَ بْنِ نَاشِبِ بْنِ غَيْرَةَ بْنِ سَعْدِ بْنِ لَيْثِ بْنِ بَكْرِ بْنِ عَبْدِ مَنَاةَ بْنِ كِنَانَةَ  .  121  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَالِمٍ الرَّازِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ عِمْرَانَ الْأَصْبَهَانِيُّ ،  ثَنَا  أَبُو دَاوُدَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي الْفَيْضِ قَالَ :  خَطَبَنَا مَسْلَمَةُ بْنُ عَبْدِ الْمَلِكِ  فَقَالَ  :  لَا تَصُومُوا فِي السَّفَرِ رَمَضَانَ ، فَمَنْ صَامَ فَلْيَقْضِهِ  "" قَالَ أَبُو الْفَيْضِ : فَلَقِيتُ أَبَا قِرْصَافَةَ وَاثِلَةَ بْنَ الْأَسْقَعِ فَسَأَلْتُهُ  فَقَالَ  :  لَوْ صُمْتُ ، ثُمَّ صُمْتُ ، ثُمَّ صُمْتُ مَا قَضَيْتُهُ  "" .","","Al-Mu'jam al-Kabir 121","","واثلة بن الأسقع الليثي عن موسى بن أيوب المهري عن شعبة بن الحجاج عن أبو داود الطيالسي عن عبد الله بن عمران بن أبي علي عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","واثلة بن الأسقع الليثي"
"19614","122  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ الدِّمَشْقِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  مَرْوَانُ بْنُ جَنَاحٍ ،  ثَنَا  يُونُسُ بْنُ مَيْسَرَةَ بْنِ حَلْبَسٍ قَالَ :  لَقِيتُ  وَاثِلَةَ بْنَ الْأَسْقَعِ فَسَلَّمْتُ عَلَيْهِ  ، فَقُلْتُ : كَيْفَ أَنْتَ يَا  أَبَا شَدَّادٍ  أَصْلَحَكَ اللهُ ؟ قَالَ : بِخَيْرٍ يَا ابْنَ أَخِي  "" .","","Al-Mu'jam al-Kabir 122","","واثلة بن الأسقع الليثي عن يونس بن ميسرة بن حلبس الجبلاني عن مروان بن جناح الدمشقي عن الوليد بن مسلم القرشي عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","واثلة بن الأسقع الليثي"
"19615","123  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَزْدَادَ التَّوَّزِيُّ  ، ثَنَا  أَبُو هَمَّامٍ الْوَلِيدُ         [22/53]      بْنُ شُجَاعٍ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  حَدَّثَنِي  حَبِيبُ بْنُ عُمَرَ الْأَنْصَارِيُّ ،  أَخْبَرَنِي  أَبِي  قَالَ :  لَقِيتُ  وَاثِلَةَ يَوْمَ عِيدٍ فَقُلْتُ : تَقَبَّلَ اللهُ مِنَّا وَمِنْكَ  ، فَقَالَ : نَعَمْ ، تَقَبَّلَ اللهُ مِنَّا وَمِنْكَ  "" .","","Al-Mu'jam al-Kabir 123","","واثلة بن الأسقع الليثي عن والد حبيب بن عمر الأنصاري عن حبيب بن عمر الأنصاري عن بقية بن الوليد عن الوليد بن شجاع عن محمد بن يزداد التوزي عن الطبراني","واثلة بن الأسقع الليثي"
"19616","124  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عَلِيُّ بْنُ بَحْرٍ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  حَدَّثَنِي  حَبِيبُ بْنُ عُمَرَ الْأَنْصَارِيُّ ،  حَدَّثَنِي  أَبِي  قَالَ :  سَأَلْتُ  وَاثِلَةَ بْنَ الْأَسْقَعِ عَنِ الصَّلَاةِ خَلْفَ الْقَدَرِيِّ ، فَقَالَ :  لَا تُصَلِّ خَلْفَهُ ، أَمَّا أَنَا لَوْ كُنْتُ صَلَّيْتُ خَلْفَهُ لَأَعَدْتُ صَلَاتِي  "" .","","Al-Mu'jam al-Kabir 124","","واثلة بن الأسقع الليثي عن والد حبيب بن عمر الأنصاري عن حبيب بن عمر الأنصاري عن بقية بن الوليد عن علي بن بحر بن بري القطان عن الحسين بن إسحاق التستري عن الطبراني","واثلة بن الأسقع الليثي"
"19617","125  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  قَالَ : ""  تُوُفِّيَ  وَاثِلَةُ بْنُ الْأَسْقَعِ  سَنَةَ خَمْسٍ وَثَمَانِينَ  ، سِنُّهُ ثَمَانٍ وَتِسْعُونَ سَنَةً ""  .","","Al-Mu'jam al-Kabir 125","","","واثلة بن الأسقع الليثي"
"19618","126  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  أَبُو الْمُغِيرَةِ  ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ  ،  حَدَّثَنِي  سَعِيدُ بْنُ خَالِدٍ  قَالَ : ""  تُوُفِّيَ  وَاثِلَةُ بْنُ الْأَسْقَعِ  فِي سَنَةِ ثَلَاثٍ وَثَمَانِينَ  ، وَهُوَ ابْنُ مِائَةٍ وَخَمْسِ سِنِينَ  "" .","","Al-Mu'jam al-Kabir 126","","","واثلة بن الأسقع الليثي"
"19619","مَا  أَسْنَدَ  وَاثِلَةُ  مَكْحُولٌ الشَّامِيُّ  عَنْ  وَاثِلَةَ  127  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الْقَاسِمُ بْنُ أُمَيَّةَ الْحَذَّاءُ ،         [22/54]      ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  ثَنَا  بُرْدُ بْنُ سِنَانٍ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تُظْهِرِ  الشَّمَاتَةَ  لِأَخِيكَ فَيُعَافِيَهُ اللهُ وَيَبْتَلِيكَ  .","","Al-Mu'jam al-Kabir 127","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن برد بن سنان عن حفص بن غياث النخعي عن القاسم بن أمية العقدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مكحول الشامي عن واثلة"
"19620","128  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنِ  الْعَلَاءِ بْنِ الْحَارِثِ ،  عَنْ  مَكْحُولٍ قَالَ :  دَخَلْتُ أَنَا ،  وَأَبُو الْأَزْهَرِ  عَلَى وَاثِلَةَ بْنِ الْأَسْقَعِ فَقُلْنَا لَهُ : يَا  أَبَا الْأَسْقَعِ  ،  حَدِّثْنَا  بِحَدِيثٍ سَمِعْتَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَيْسَ فِيهِ وَهَمٌ ، وَلَا تَزَيُّدٌ ، وَلَا نِسْيَانٌ ، قَالَ :  هَلْ قَرَأَ أَحَدُكُمُ اللَّيْلَةَ مِنَ الْقُرْآنِ شَيْئًا ؟  فَقُلْنَا : نَعَمْ ، وَمَا نَحْنُ لَهُ بِالْحَافِظِينَ جِدًّا ، إِنَّا لَنَزِيدُ الْوَاوَ وَالْأَلِفَ وَنُنْقِصُ ، قَالَ : فَهَذَا الْقُرْآنُ مَكْتُوبٌ بَيْنَ أَظْهُرِكُمْ لَا تَأْلُونَ حِفْظَهُ ، وَأَنْتُمْ تَزْعُمُونَ أَنَّكُمْ تَزِيدُونَ وَتَنْقُصُونَ ، فَكَيْفَ بِأَحَادِيثَ سَمِعْنَاهَا مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، عَسَى أَنْ لَا يَكُونَ سَمِعْنَاهَا مِنْهُ إِلَّا مَرَّةً وَاحِدَةً ، حَسْبُكُمْ إِذَا مَا حَدَّثْنَاكُمْ بِالْحَدِيثِ عَلَى الْمَعْنَى  "" .","","Al-Mu'jam al-Kabir 128","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن العلاء بن الحارث الرمادي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","مكحول الشامي عن واثلة"
"19621","129  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ  ، ثَنَا  عَبْدُ الْوَهَّابِ بْنُ الضَّحَّاكِ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  مُعَاوِيَةَ بْنِ يَحْيَى ،  عَنْ  يَحْيَى         [22/55]      بْنِ الْعَلَاءِ بْنِ الْحَارِثِ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ بَاعَ عَيْبًا لَمْ يُسَمِّهِ لَمْ يَزَلْ فِي غَضِبِ اللهِ  ، وَلَمْ تَزَلِ الْمَلَائِكَةُ تَلْعَنُهُ  .","","Al-Mu'jam al-Kabir 129","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن يحيى بن العلاء بن الحارث عن معاوية بن يحيى الصدفي عن بقية بن الوليد عن عبد الوهاب بن الضحاك عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","مكحول الشامي عن واثلة"
"19622","130  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ الْوَاسِطِيُّ ،  ثَنَا  أَبُو شِهَابٍ ، (  ح  )  وَحَدَّثَنَا  أَبُو عُمَرَ الضَّرِيرُ مُحَمَّدُ بْنُ عُثْمَانَ بْنِ سَعِيدٍ الْكُوفِيُّ  ، ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  الْمُعَافَى بْنُ عِمْرَانَ كِلَاهُمَا  عَنِ  الْمُغِيرَةِ بْنِ زِيَادٍ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يُجَنَّدُ النَّاسُ أَجْنَادًا جُنْدٌ  بِالْيَمَنِ  ، وَجُنْدٌ  بِالشَّامِ  ،  وَجُنْدٌ بِالْمَشْرِقِ ، وَجُنْدٌ بِالْمَغْرِبِ "" قَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، إِنِّي فَتًى شَابٌّ فَلَعَلِّي أُدْرِكُ ذَلِكَ ، فَأَيُّ ذَلِكَ تَأْمُرُنِي ؟ قَالَ : "" عَلَيْكُمْ  بِالشَّامِ  ، فَإِنَّهَا صَفْوَةُ اللهِ مِنْ بِلَادِهِ يَسُوقُ إِلَيْهَا صَفْوَتَهُ مِنْ عِبَادِهِ ، عَلَيْكُمْ  بِالشَّامِ  ، فَإِنَّ اللهَ تَكَفَّلَ لِي  بِالشَّامِ  وَأَهْلِهِ ، فَمَنْ أَبَى فَلْيَلْحَقْ  بِيَمَنِهِ  .","","Al-Mu'jam al-Kabir 130","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن المغيرة بن زياد البجلي عن المعافى بن عمران عن أحمد بن عبد الله اليربوعي عن محمد بن عثمان بن سعيد الضرير عن الطبراني","مكحول الشامي عن واثلة"
"19623","131  -  حَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ الْمِصْرِيُّ  ، ثَنَا  هَانِي بْنُ الْمُتَوَكِّلِ الْإِسْكَنْدَرَانِيُّ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُّ         [22/56]      بُنْيَانٍ  وَبَالٌ  عَلَى صَاحِبِهِ إِلَّا مَا كَانَ هَكَذَا  وَأَشَارَ بِكَفِّهِ "" وَكُلُّ عِلْمٍ  وَبَالٌ  عَلَى صَاحِبِهِ يَوْمَ الْقِيَامَةِ إِلَّا مَنْ عَمِلَ بِهِ  .","","Al-Mu'jam al-Kabir 131","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن أبو عمرو الأوزاعي عن بقية بن الوليد عن هانئ بن المتوكل الإسكندراني عن عمرو بن أبي الطاهر المصري عن الطبراني","مكحول الشامي عن واثلة"
"19624","132  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ الْحِمْصِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْعَنَزِيُّ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  حَسَّانَ بْنِ عَطِيَّةَ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْرُجُ إِلَيْنَا ، وَكُنَّا تُجَّارًا وَكَانَ يَقُولُ :  يَا مَعْشَرَ التُّجَّارِ إِيَّاكُمْ وَالْكَذِبَ  .","","Al-Mu'jam al-Kabir 132","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن حسان بن عطية المحاربي عن أبو عمرو الأوزاعي عن محمد بن إسحاق العنزي عن محمد بن مصفى بن بهلول عن إبراهيم بن محمد بن عرق الحمصي عن الطبراني","مكحول الشامي عن واثلة"
"19625","133  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُعَاوِيَةَ الْعُتْبِيُّ الْمِصْرِيُّ  ، ثَنَا  يُوسُفُ بْنُ عَدِيٍّ ،  ثَنَا  أَيُّوبُ بْنُ مُدْرِكٍ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اصْطَفُّوا وَلْيَتَقَدَّمْكُمْ فِي الصَّلَاةِ أَفْضَلُكُمْ  ، فَإِنَّ اللهَ عَزَّ وَجَلَّ يَصْطَفِي مِنَ الْمَلَائِكَةِ وَمِنَ النَّاسِ  .","","Al-Mu'jam al-Kabir 133","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن أيوب بن مدرك الحنفي عن يوسف بن عدي بن رزق الكوفي عن عبد الرحمن بن معاوية العتبي عن الطبراني","مكحول الشامي عن واثلة"
"19626","134  -  حَدَّثَنَا  الْفَضْلُ بْنُ هَارُونَ الْبَغْدَادِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ         [22/57]      إِبْرَاهِيمَ التَّرْجُمَانِيُّ ،  ثَنَا  أَيُّوبُ بْنُ مُدْرِكٍ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَمْسَحُ الرَّجُلُ جَبْهَتَهُ حَتَّى يَفْرُغَ مِنْ صَلَاتِهِ  ، وَلَا بَأْسَ أَنْ يَمْسَحَ الْعَرَقَ عَنْ صُدْغَيْهِ ، فَإِنَّ الْمَلَائِكَةَ تُصَلِّي عَلَيْهِ مَا دَامَ أَثَرُ السُّجُودِ بَيْنَ عَيْنَيْهِ  .","","Al-Mu'jam al-Kabir 134","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن أيوب بن مدرك الحنفي عن إسماعيل بن إبراهيم الترجماني عن الفضل بن هارون البغدادي عن الطبراني","مكحول الشامي عن واثلة"
"19627","135  -  حَدَّثَنَا  أَحْمَدُ بْنُ النَّضْرِ الْعَسْكَرِيُّ  ، ثَنَا  مُصْعَبُ بْنُ سَعْدٍ  ،  ثَنَا  مُحَمَّدُ بْنُ مِحْصَنٍ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ  قَذَفَ  ذِمِّيًّا حُدَّ لَهُ يَوْمَ الْقِيَامَةِ بِسِياطٍ مِنْ نَارٍ  فَقُلْتُ  لِمَكْحُولٍ  :  مَا أَشَدُّ مَا يُقَالُ ؟ قَالَ : يُقَالُ لَهُ : "" يَا ابْنَ الْكَافِرِ  "" .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( مصعب بن سعيد )","","Al-Mu'jam al-Kabir 135","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن أبو عمرو الأوزاعي عن محمد بن محصن العكاشي عن مصعب بن سعيد المصيصي عن أحمد بن النضر بن بحر العسكري عن الطبراني","مكحول الشامي عن واثلة"
"19628","136  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، وَعَبْدُ الْوَارِثِ بْنُ إِبْرَاهِيمَ الْعَسْكَرِيُّ ، وَأَحْمَدُ بْنُ عَلِيٍّ الْأَبَّارُ قَالُوا :  ثَنَا  عِيسَى بْنُ إِبْرَاهِيمَ الْبِرَكِيُّ ، قَالَ :  ثَنَا  الْحَارِثُ بْنُ نَبْهَانَ ، قَالَ :  ثَنَا  عُتْبَةُ بْنُ يَقْظَانَ ،  عَنْ  أَبِي سَعِيدٍ الشَّامِيِّ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ يَعْنِي ابْنَ الْأَسْقَعِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  جَنِّبُوا الْمَسَاجِدَ صِبْيَانَكُمْ ،  وَمَجَانِينَكُمْ  وَشِرَاءَكُمْ وَبَيْعَكُمْ وَخُصُومَاتِكُمْ  ، وَرَفْعَ أَصْوَاتِكُمْ ، وَإِقَامَةَ حُدُودِكُمْ ، وَسَلَّ أَسْيَافِكُمْ ، وَجَمِّرُوهَا فِي الْجُمَعِ ، وَاتَّخِذُوا عَلَى أَبْوَابِهَا الْمَطَاهِرَ  .","","Al-Mu'jam al-Kabir 136","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن أبو سعيد الشامي عن عتبة بن يقظان عن الحارث بن نبهان الجرمي عن عيسى بن إبراهيم البركي عن أحمد بن علي بن مسلم النخشبي عن الطبراني","مكحول الشامي عن واثلة"
"19629","[22/58]      137  -  حَدَّثَنَا  الْوَلِيدُ بْنُ حَمَّادٍ الرَّمْلِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ ،  ثَنَا  بِشْرُ بْنُ عَوْنٍ ،  ثَنَا  بَكَّارُ بْنُ تَمِيمٍ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَقُولُ  لِحُذَيْفَةَ بْنِ الْيَمَانِ  وَمُعَاذِ بْنِ جَبَلٍ  ، وَهُمَا يَسْتَشِيرَانِهِ فِي الْمَنْزِلِ فَأَوْمَى إِلَى  الشَّامِ  ، ثُمَّ سَأَلَاهُ ، فَأَوْمَى إِلَى  الشَّامِ  ، ثُمَّ سَأَلَاهُ فَأَوْمَى إِلَى  الشَّامِ  قَالَ :  عَلَيْكُمْ  بِالشَّامِ  ، فَإِنَّهَا صَفْوَةُ بِلَادِ اللهِ يَسْكُنُهَا خِيرَتُهُ مِنْ خَلْقِهِ  ، فَمَنْ أَبَى فَلْيَلْحَقْ  بِيَمَنِهِ  ، وَلْيَسْقِ مِنْ غُدُرِهِ ، فَإِنَّ اللهَ تَكَفَّلَ لِي  بِالشَّامِ  وَأَهْلِهِ  .","","Al-Mu'jam al-Kabir 137","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن بكار بن تميم عن بشر بن عون الشامي عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","مكحول الشامي عن واثلة"
"19630","138  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ الْجَرْجَرَائِيُّ ،  ثَنَا  عَلِيُّ بْنُ ثَابِتٍ ،  أَنَا  الْحَارِثُ بْنُ يَزِيدَ الشَّامِيُّ ،  عَنِ  الْعَلَاءِ بْنِ كَثِيرٍ ،  عَنْ  مَكْحُولٍ قَالَ :  دَخَلْنَا عَلَى وَاثِلَةَ بْنِ الْأَسْقَعِ ، فَقُلْنَا :  حَدِّثْنَا  حَدِيثًا سَمِعْتَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" سَمِعْتُ  مُعَاذًا  وَحُذَيْفَةَ  يَسْتَشِيرَانِ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْمَنْزِلِ ، فَأَوْمَى إِلَيْهِمَا  بِالشَّامِ  ، ثُمَّ اسْتَشَارَاهُ فَأَوْمَى إِلَيْهِمَا  بِالشَّامِ  ، ثُمَّ اسْتَشَارَاهُ فَأَوْمَى إِلَيْهِمَا  بِالشَّامِ  ، قَالَ فِي الثَّالِثَةِ :  عَلَيْكُمْ  بِالشَّامِ  ، فَإِنَّهَا صَفْوَةُ بِلَادِ اللهِ يَسْكُنُهَا خِيرَتُهُ مِنْ عِبَادِهِ  ، وَمَنْ أَبَى فَلْيَلْحَقْ  بِيَمَنِهِ  وَلْيَسْقِ بِغُدُرِهِ ، فَإِنَّ اللهَ قَدْ تَكَفَّلَ لِي  بِالشَّامِ  وَأَهْلِهِ  .","","Al-Mu'jam al-Kabir 138","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن العلاء بن كثير الليثي عن الحارث بن يزيد الشامي عن علي بن ثابت الجزري عن محمد بن الصباح الجرجرائي عن الحسين بن إسحاق التستري عن الطبراني","مكحول الشامي عن واثلة"
"19631","[22/59]      139  -  حَدَّثَنَا  الْوَلِيدُ بْنُ حَمَّادٍ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  حَدَّثَنَا  بِشْرُ بْنُ عَوْنٍ ،  عَنْ  بَكَّارِ بْنِ تَمِيمٍ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَيْلَةُ الْقَدْرِ  بَلْجَةٌ ،  لَا حَارَّةٌ وَلَا بَارِدَةٌ  ، وَلَا سَحَابَ فِيهَا ، وَلَا مَطَرَ ، وَلَا رِيحَ ، وَلَا يُرْمَى فِيهَا بِنَجْمٍ ، وَمِنْ عَلَامَةِ يَوْمِهَا تَطْلُعُ الشَّمْسُ لَا شُعَاعَ لَهَا  .","","Al-Mu'jam al-Kabir 139","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن بكار بن تميم عن بشر بن عون الشامي عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","مكحول الشامي عن واثلة"
"19632","140  -  حَدَّثَنَا  الْوَلِيدُ بْنُ حَمَّادٍ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  بِشْرُ بْنُ عَوْنٍ ،  ثَنَا  بَكَّارُ بْنُ تَمِيمٍ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يَبْعَثُ اللهُ يَوْمَ الْقِيَامَةِ عَبْدًا لَا ذَنْبَ لَهُ  ، فَيَقُولُ اللهُ : بِأَيِّ الْأَمْرَيْنِ أَحَبُّ إِلَيْكَ أَنْ أَجْزِيَكَ بِعَمَلِكَ ، أَوْ بِنِعْمَتِي عِنْدَكَ ؟ قَالَ : رَبِّ ، إِنَّكَ تَعْلَمُ أَنِّي لَمْ أَعْصِكَ ، قَالَ : خُذُوا عَبْدِي بِنِعْمَةٍ مِنْ نِعَمِي ، فَمَا تَبْقَى لَهُ حَسَنَةٌ إِلَّا اسْتَغْرَقَهَا تِلْكَ النِّعْمَةُ ، فَيَقُولُ : رَبِّ بِنِعْمَتِكَ وَرَحْمَتِكَ ، فَيَقُولُ : بِنِعْمَتِي وَرَحْمَتِي ، وَيُؤْتَى بِعَبْدٍ مُحْسِنٍ فِي نَفْسِهِ لَا يُرَى أَنَّ لَهُ ذَنْبًا ، فَيَقُولُ لَهُ : هَلْ كُنْتَ تُوَالِي أَوْلِيَائِي ؟ قَالَ : كُنْتُ مِنَ النَّاسِ سَلْمًا ، قَالَ : فَهَلْ كُنْتَ تُعَادِي أَعْدَائِي ؟ قَالَ : يَا رَبِّ ، لَمْ يَكُنْ بَيْنِي وَبَيْنَ أَحَدٍ شَيْئًا ، فَيَقُولُ اللهُ عَزَّ وَجَلَّ : لَا يَنَالُ رَحْمَتِي مَنْ لَا يُوَالِي أَوْلِيَائِي وَيُعَادِي أَعْدَائِي  .","","Al-Mu'jam al-Kabir 140","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن بكار بن تميم عن بشر بن عون الشامي عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","مكحول الشامي عن واثلة"
"19633","141  -  حَدَّثَنَا  الْوَلِيدُ بْنُ حَمَّادٍ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،         [22/60]      ثَنَا  بِشْرُ بْنُ عَوْنٍ ،  ثَنَا  بَكَّارُ بْنُ تَمِيمٍ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الصِّيَامُ  جُنَّةٌ  ، وَهُوَ حِصْنٌ مِنْ حُصُونِ الْمُؤْمِنِ  ، وَكُلُّ عَمَلٍ لِصَاحِبِهِ إِلَّا الصِّيَامَ ، يَقُولُ اللهُ عَزَّ وَجَلَّ : الصَّوْمُ لِي وَأَنَا  أَجْزِي  بِهِ  .","","Al-Mu'jam al-Kabir 141","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن بكار بن تميم عن بشر بن عون الشامي عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","مكحول الشامي عن واثلة"
"19634","142  -  حَدَّثَنَا  الْوَلِيدُ بْنُ حَمَّادٍ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  بِشْرُ بْنُ عَوْنٍ ،  ثَنَا  بَكَّارُ بْنُ تَمِيمٍ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  شَرُّ الْمَجَالِسِ الْأَسْوَاقُ وَالطُّرُقُ  ، وَخَيْرُ الْمَجَالِسِ الْمَسَاجِدُ ، فَإِنْ لَمْ تَجْلِسْ فِي الْمَسْجِدِ ، فَالْزَمْ بَيْتَكَ  .","","Al-Mu'jam al-Kabir 142","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن بكار بن تميم عن بشر بن عون الشامي عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","مكحول الشامي عن واثلة"
"19635","143  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ بَكْرٍ السَّرَّاجُ قَالَ :  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ التَّرْجُمَانِيُّ ،  ثَنَا  أَيُّوبُ بْنُ مُدْرِكٍ ،  ثَنَا  مَكْحُولٌ ،  عَنْ  وَاثِلَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مِنْ شَرِّ الْمَجَالِسِ الْأَسْوَاقُ وَالطُّرُقُ ، وَخَيْرُ الْمَجَالِسِ الْمَسَاجِدُ  ، فَإِنْ لَمْ تَجْلِسْ فِي الْمَسْجِدِ فَالْزَمْ بَيْتَكَ  .","","Al-Mu'jam al-Kabir 143","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن أيوب بن مدرك الحنفي عن إسماعيل بن إبراهيم الترجماني عن محمد بن عبد الله بن بكر السراج عن الطبراني","مكحول الشامي عن واثلة"
"19636","144  -  حَدَّثَنَا  الْوَلِيدُ بْنُ حَمَّادٍ الرَّمْلِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  بِشْرُ بْنُ عَوْنٍ ،  ثَنَا  بَكَّارُ بْنُ تَمِيمٍ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ قَالَ :  سَأَلَ  سَائِلٌ  رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَا بَالُ يَوْمِ الْجُمُعَةِ يُؤَذَّنُ فِيهَا بِالصَّلَاةِ فِي نِصْفِ النَّهَارِ وَقَدْ نَهَيْتَ عَنْ سَائِرِ الْأَيَّامِ ؟ فَقَالَ :  إِنَّ اللهَ يُسَعِّرُ  جَهَنَّمَ  كُلَّ يَوْمٍ فِي نِصْفِ النَّهَارِ  ، وَيُخْبِثُهَا فِي يَوْمِ الْجُمُعَةِ  .","","Al-Mu'jam al-Kabir 144","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن بكار بن تميم عن بشر بن عون الشامي عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","مكحول الشامي عن واثلة"
"19637","[22/61]      145  -  حَدَّثَنَا  الْوَلِيدُ بْنُ حَمَّادٍ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  بِشْرُ بْنُ عَوْنٍ ،  ثَنَا  بَكَّارُ بْنُ تَمِيمٍ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَمْنَعُوا عِبَادَ اللهِ  فَضْلَ  الْمَاءِ ،  وَالْكَلَأَ  ، وَلَا نَارًا فَإِنَّ اللهَ جَعَلَهَا مُشَاعًا لِلْمُقْوِينَ ، وَقُوَّةً لِلَمُسْتَضْعَفِينَ  .","","Al-Mu'jam al-Kabir 145","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن بكار بن تميم عن بشر بن عون الشامي عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","مكحول الشامي عن واثلة"
"19638","146  -  حَدَّثَنَا  الْوَلِيدُ بْنُ حَمَّادٍ  ، ثَنَا  سُلَيْمَانُ ،  ثَنَا  بِشْرُ بْنُ عَوْنٍ ،  ثَنَا  بَكَّارُ بْنُ تَمِيمٍ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ يَبْعَثُ الْمَلَائِكَةَ يَوْمَ الْجُمُعَةِ عَلَى أَبْوَابِ الْمَسَاجِدِ ،  يَكْتُبُونَ  الْقَوْمَ  الْأَوَّلَ وَالثَّانِيَ وَالثَّالِثَ وَالرَّابِعَ وَالْخَامِسَ وَالسَّادِسَ ، فَإِذَا بَلَغُوا السَّابِعَ كَانُوا بِمَنْزِلَةِ مَنْ قَرَّبَ الْعَصَافِيرَ  .","","Al-Mu'jam al-Kabir 146","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن بكار بن تميم عن بشر بن عون الشامي عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","مكحول الشامي عن واثلة"
"19639","147  -  وَبِإِسْنَادِهِ  ،  عَنْ  وَاثِلَةَ قَالَ :  أَمَرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ نَتَفَقَّهَ فِي الدِّينِ  .","","Al-Mu'jam al-Kabir 147","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن بكار بن تميم عن بشر بن عون الشامي عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","مكحول الشامي عن واثلة"
"19640","148  -  وَبِإِسْنَادِهِ  ،  عَنْ  وَاثِلَةَ قَالَ :  أَمَرَنَا رَسُولُ اللهِ صَلَّى         [22/62]      اللهُ عَلَيْهِ وَسَلَّمَ لَا نَتَحَلَّقُ يَوْمَ الْجُمُعَةِ قَبْلَ خُرُوجِ الْإِمَامِ  وَلْيُقْبِلُوا عَلَى الْقِبْلَةِ ، وَلَا يَوْمَ الْعِيدَيْنِ بَعْدَ الصَّلَاةِ  .","","Al-Mu'jam al-Kabir 148","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن بكار بن تميم عن بشر بن عون الشامي عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","مكحول الشامي عن واثلة"
"19641","149  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ  ، ثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ النَّضْرِ الْعَسْكَرِيُّ  ، ثَنَا  أَبُو تَقِيٍّ قَالَا :  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  عُمَرَ الدِّمَشْقِيِّ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ قَالَ :  لَمَّا افْتَتَحَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  خَيْبَرَ  جُعِلَتْ لَهُ مَأْدُبَةٌ  ، فَأَكَلَ مُتَّكِئًا وَأَطْلَى ، فَأَصَابَتْهُ الشَّمْسُ فَلَبِسَ الظُّلَّةَ  .","","Al-Mu'jam al-Kabir 149","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن عمر بن محمد بن عبد الله الشعيثي عن بقية بن الوليد عن هشام بن عبد الملك اليزني عن أحمد بن النضر بن بحر العسكري عن الحسين بن إسحاق التستري عن الطبراني","مكحول الشامي عن واثلة"
"19642","150  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ يُوسُفَ الْجُبَيْرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  عَنْبَسَةُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَقُولَنَّ أَحَدُكُمْ أَهْرَقْتُ الْمَاءَ وَلَكِنْ لِيَقُلْ أَبُولُ  .","","Al-Mu'jam al-Kabir 150","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن عنبسة بن عبد الرحمن بن عنبسة الأموي عن عثمان بن عبد الرحمن الطرائفي عن عبيد الله بن يوسف الجبيري عن الحسين بن إسحاق التستري عن الطبراني","مكحول الشامي عن واثلة"
"19643","151  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ  ، ثَنَا  عَلِيُّ بْنُ شَبَابَةَ  ،  ثَنَا  إِبْرَاهِيمُ بْنُ بَكْرٍ الشَّيْبَانِيُّ ،  ثَنَا  بِسْطَامُ بْنُ عَبْدِ الْوَهَّابِ الْأَرُزِّيُّ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا وُضِعَ الْمَيِّتُ فِي قَبْرِهِ قَالَ : "" بِسْمِ اللهِ ،  وَعَلَى سُنَّةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَوَضَعَ خَلْفَ قَفَاهُ مَدَرَةً ، وَبَيْنَ كَتِفَيْهِ مَدَرَةً ، وَبَيْنَ رُكْبَتَيْهِ ، وَمِنْ وَرَائِهِ أُخْرَى  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( علي بن سيابة )","","Al-Mu'jam al-Kabir 151","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن بسطام بن عبد الوهاب عن إبراهيم بن بكر الأعور عن علي بن سيابة عن الحسين بن إسحاق التستري عن الطبراني","مكحول الشامي عن واثلة"
"19644","[22/63]      152  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ  ، ثَنَا  عَمْرُو بْنُ الْحُصَيْنِ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عُلَاثَةَ ،  عَنْ  ثَوْرِ بْنِ يَزِيدَ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  عَلَيْكُمْ بِالْقَرْعِ فَإِنَّهُ يَزِيدُ فِي الدِّمَاغِ  ، وَعَلَيْكُمْ بِالْعَدَسِ ، فَإِنَّهُ قُدِّسَ عَلَى لِسَانِ سَبْعِينَ نَبِيًّا  .","","Al-Mu'jam al-Kabir 152","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن ثور بن يزيد الكلاعي عن قاضي الجن محمد بن عبد الله بن علاثة عن عمرو بن الحصين العقيلي عن الحسين بن إسحاق التستري عن الطبراني","مكحول الشامي عن واثلة"
"19645","153  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ  ، ثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  حَدَّثَنِي  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَنْبَسَةَ بْنِ سَعِيدٍ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  السِّحَاقُ بَيْنَ النِّسَاءِ زِنًا بَيْنَهُنَّ  .","","Al-Mu'jam al-Kabir 153","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن عنبسة بن سعيد بن الضريس عن عثمان بن عبد الرحمن الطرائفي عن بقية بن الوليد عن سويد بن سعيد الحدثاني عن الحسين بن إسحاق التستري عن الطبراني","مكحول الشامي عن واثلة"
"19646","154  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ  ، ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  حَكِيمُ بْنُ خِذَامٍ ،  عَنِ  الْعَلَاءِ بْنِ كَثِيرٍ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ قَالَ :  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَجُلٌ  أَكْشَفُ أَحْوَلُ أَوْقَصُ أَحْنَفُ أَقْحَمُ  أَعْسَرُ  أَرْسَجُ         [22/64]      أَفْحَجُ ، فَقَالَ : يَا رَسُولَ اللهِ ، أَخْبِرْنِي بِمَا  فَرَضَ  اللهُ عَلَيَّ ، فَلَمَّا أَخْبَرَهُ قَالَ : إِنِّي أُعَاهِدُ اللهَ أَنْ لَا أَزِيدَ عَلَى فَرِيضَتِهِ ، قَالَ : "" لِمَ "" قَالَ : لِأَنَّهُ خَلَقَنِي أَكْشَفَ أَحْوَلَ أَقْحَمَ  أَعْسَرَ  أَرْسَجَ أَفْحَجَ ، ثُمَّ أَدْبَرَ فَأَتَاهُ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ فَقَالَ : يَا  مُحَمَّدُ  ، أَيْنَ الْعَاتِبُ عَلَى رَبِّهِ ؟ عَاتَبَ رَبًّا كَرِيمًا فَأَعْتَبَهُ ، قَالَ : قُلْ لَهُ : أَلَا تَرْضَى أَنْ تُبْعَثَ فِي صُورَةِ  جِبْرِيلَ  يَوْمَ الْقِيَامَةِ ؟ فَبَعَثَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى الرَّجُلِ فَقَالَ :  إِنَّكَ عَاتَبْتَ رَبًّا كَرِيمًا فَأَعْتَبَكَ  ، أَفَلَا تَرْضَى أَنْ يَبْعَثَكَ اللهُ يَوْمَ الْقِيَامَةِ عَلَى صُورَةِ  جِبْرِيلَ  ؟ "" قَالَ : بَلَى يَا رَسُولَ اللهِ ، قَالَ : فَإِنِّي أُعَاهِدُ اللهَ لَا يَقْوَى جَسَدِي عَلَى شَيْءٍ يَرْضَاهُ اللهُ إِلَّا حَمَلْتُهُ  .","","Al-Mu'jam al-Kabir 154","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن العلاء بن كثير الليثي عن حكيم بن خذام الأزدي عن شيبان بن فروخ الحبطي عن الحسين بن إسحاق التستري عن الطبراني","مكحول الشامي عن واثلة"
"19647","155  -  حَدَّثَنَا  الْحَجَّاجُ بْنُ عِمْرَانَ  ، ثَنَا  عَمْرُو بْنُ الْحُصَيْنِ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْمَلِكِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ بْنِ جَابِرٍ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا اسْتَفْتَحَ الصَّلَاةَ قَالَ : "" سُبْحَانَكَ اللَّهُمَّ  وَبِحَمْدِكَ  ، وَتَبَارَكَ اسْمُكَ ، وَتَعَالَى  جَدُّكَ ،  وَلَا إِلَهَ غَيْرُكَ  .","","Al-Mu'jam al-Kabir 155","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن عبد الرحمن بن يزيد الداراني عن عبد الملك بن عبد الملك بن أبي ذئب عن عمرو بن الحصين العقيلي عن حجاج بن عمران السدوسي عن الطبراني","مكحول الشامي عن واثلة"
"19648","156  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ  ، ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  حَكِيمُ بْنُ خِذَامٍ ،  عَنِ  الْعَلَاءِ بْنِ كَثِيرٍ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ لَمْ يُخَلِّلْ أَصَابِعَهُ بِالْمَاءِ خَلَّلَهَا اللهُ بِالنَّارِ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 156","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن العلاء بن كثير الليثي عن حكيم بن خذام الأزدي عن شيبان بن فروخ الحبطي عن الحسين بن إسحاق التستري عن الطبراني","مكحول الشامي عن واثلة"
"19649","[22/65]      157  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ سَمَيْدَعٍ  ، ثَنَا  مُوسَى بْنُ أَيُّوبَ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  مُعَاوِيَةَ بْنِ يَحْيَى ،  عَنِ  الْعَلَاءِ بْنِ الْحَارِثِ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ بَاعَ عَيْبًا لَمْ يُبَيِّنْهُ  ،  لَمْ يَزَلْ فِي مَقْتِ اللهِ "" ، أَوْ قَالَ : "" لَمْ تَزَلِ الْمَلَائِكَةُ تَلْعَنُهُ  .","","Al-Mu'jam al-Kabir 157","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن العلاء بن الحارث الرمادي عن معاوية بن يحيى الصدفي عن بقية بن الوليد عن موسى بن أيوب النصيبي عن الحسين بن السميدع البجلي عن الطبراني","مكحول الشامي عن واثلة"
"19650","158  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ  ، ثَنَا  أَبُو صَالِحٍ ،  عَنِ  الْعَلَاءِ بْنِ الْحَارِثِ ،  عَنْ  مَكْحُولٍ قَالَ :  دَخَلْتُ أَنَا ،  وَأَبُو الْأَزْهَرِ  ، عَلَى وَاثِلَةَ بْنِ الْأَسْقَعِ فَقُلْنَا : يَا  أَبَا الْأَسْقَعِ  حَدِّثْنَا  بِحَدِيثٍ سَمِعْتَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، لَيْسَ فِيهِ وَهَمٌ ، وَلَا تَزَيُّدٌ ، وَلَا نِسْيَانٌ فَقَالَ :  هَلْ قَرَأَ أَحَدٌ مِنْكُمْ مِنَ الْقُرْآنِ اللَّيْلَةَ شَيْئًا  ؟ فَقُلْنَا : نَعَمْ ، وَمَا نَحْنُ لَهُ بِالْحَافِظِينَ جِدًّا ، إِنَّا لَنَزِيدُ الْوَاوَ وَالْأَلِفَ وَنُنْقِصُ ، قَالَ : فَهَذَا الْقُرْآنُ مَكْتُوبٌ بَيْنَ أَظْهُرِكُمْ لَا تَأْلُونَ حِفْظَهُ ، وَأَنْتُمْ تَزْعُمُونَ أَنَّكُمْ تَزِيدُونَ وَتَنْقُصُونَ ، فَكَيْفَ بِأَحَادِيثَ سَمِعْنَاهَا مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَسَى أَنْ لَا نَكُونَ سَمِعْنَاهَا مِنْهُ إِلَّا مَرَّةً وَاحِدَةً ، حَسْبُكُمْ إِذَا حَدَّثْنَاكُمْ بِالْحَدِيثِ عَلَى الْمَعْنَى  "" .","","Al-Mu'jam al-Kabir 158","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن العلاء بن الحارث الرمادي عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","مكحول الشامي عن واثلة"
"19651","شَدَّادٌ أَبُو عَمَّارٍ  عَنْ  وَاثِلَةَ  159  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ السَّلَامِ بْنِ حَرْبٍ ،  عَنْ  كُلْثُومِ بْنِ زِيَادٍ ،  عَنْ  أَبِي عَمَّارٍ  قَالَ  :  إِنِّي لَجَالِسٌ عِنْدَ وَاثِلَةَ بْنِ الْأَسْقَعِ إِذْ ذَكَرُوا  عَلِيًّا  فَشَتَمُوهُ ، فَلَمَّا قَامُوا قَالَ : اجْلِسْ حَتَّى أُخْبِرَكَ عَنْ هَذَا الَّذِي شَتَمُوا ، إِنِّي عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَاتَ يَوْمٍ         [22/66]      إِذْ جَاءَ  عَلِيٌّ  ،  وَفَاطِمَةُ  ،  وَالْحَسَنُ  ،  وَالْحُسَيْنُ  ، فَأَلْقَى عَلَيْهِمْ كِسَاءً لَهُ ثُمَّ قَالَ :  اللَّهُمَّ هَؤُلَاءِ أَهْلُ بَيْتِي ، اللَّهُمَّ أَذْهِبْ عَنْهُمُ الرِّجْسَ  وَطَهِّرْهُمْ تَطْهِيرًا "" فَقُلْتُ : يَا رَسُولَ اللهِ ، وَأَنَا . قَالَ : "" وَأَنْتَ  "" قَالَ : فَوَاللهِ إِنَّهَا لَأَوْثَقُ عَمَلِي فِي نَفْسِي  .","","Al-Mu'jam al-Kabir 159","","واثلة بن الأسقع الليثي عن شداد بن عبد الله العذري عن كلثوم بن زياد القاضي عن عبد السلام بن حرب الملائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","شداد أبو عمار عن واثلة"
"19652","160  -  حَدَّثَنَا  أَبُو زَيْدٍ أَحْمَدُ بْنُ عَبْدِ الرَّحِيمِ بْنِ يَزِيدَ قَالَ :  ثَنَا  مُحَمَّدُ بْنُ مُصْعَبٍ الْقَرْقَسَانِيُّ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ التِّنِّيسِيُّ قَالَا :  ثَنَا  الْأَوْزَاعِيُّ ،  ثَنَا  أَبُو عَمَّارٍ شَدَّادٌ قَالَ :  قَالَ  وَاثِلَةُ بْنُ الْأَسْقَعِ اللَّيْثِيُّ :  كُنْتُ أُرِيدُ  عَلِيًّا  فَلَمْ أَجِدْهُ ، فَقَالَتْ  فَاطِمَةُ  : انْطَلَقَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَدْعُوهُ حَتَّى يَأْتِيَ ، فَجَاءَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ فَدَخَلَا فَدَخَلْتُ مَعَهُمَا ، فَدَعَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  حَسَنًا  وَحُسَيْنًا  ، فَأَجْلَسَ كُلَّ وَاحِدٍ مِنْهُمَا عَلَى فَخِذِهِ وَأَدْنَى  فَاطِمَةَ  مِنْ حِجْرِهِ ، ثُمَّ لَفَّ عَلَيْهِمَا ثَوْبَهُ وَأَنَا مُسْنِدٌ ، ثُمَّ قَالَ :         {      إِنَّمَا يُرِيدُ اللهُ لِيُذْهِبَ عَنْكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا         }      ثُمَّ قَالَ :  هَؤُلَاءِ أَهْلِي هَؤُلَاءِ أَهْلِي أَحَقُّ  قَالَ  وَاثِلَةُ  : قُلْتُ يَا رَسُولَ اللهِ ، وَأَنَا مِنْ أَهْلِكَ ؟ قَالَ : "" وَأَنْتَ مِنْ أَهْلِي  "" قَالَ  وَاثِلَةُ  : وَإِنَّهُ لَمِنْ أَرْجَى مَا أَرْجُوهُ  .","","Al-Mu'jam al-Kabir 160","","واثلة بن الأسقع الليثي عن شداد بن عبد الله العذري عن أبو عمرو الأوزاعي عن محمد بن بشر التنيسي عن محمد بن علي بن زيد الصائغ عن الطبراني","شداد أبو عمار عن واثلة"
"19653","161  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ  ، حَدَّثَنَا  أَبُو الْمُغِيرَةِ ، (  ح  )         [22/67]      وَحَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحِيمِ أَبُو زَيْدٍ الْحَوْطِيُّ قَالَ :  ثَنَا  مُحَمَّدُ بْنُ مُصْعَبٍ الْقَرْقَسَانِيُّ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ قَالَ :  ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ التِّنِّيسِيُّ قَالُوا :  ثَنَا  الْأَوْزَاعِيُّ ،  ثَنَا  شَدَّادٌ أَبُو عَمَّارٍ ، قَالَ :  حَدَّثَنِي  وَاثِلَةُ بْنُ الْأَسْقَعِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ اصْطَفَى  بَنِي كِنَانَةَ  مِنْ  بَنِي إِسْمَاعِيلَ  وَاصْطَفَى مِنْ  كِنَانَةَ  قُرَيْشًا  ، وَاصْطَفَى مِنْ  قُرَيْشٍ  بَنِي هَاشِمٍ  ، وَاصْطَفَانِي مِنْ  بَنِي هَاشِمٍ  .","","Al-Mu'jam al-Kabir 161","","واثلة بن الأسقع الليثي عن شداد بن عبد الله العذري عن أبو عمرو الأوزاعي عن محمد بن بشر التنيسي عن محمد بن علي بن زيد الصائغ عن الطبراني","شداد أبو عمار عن واثلة"
"19654","162  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَسْعُودٍ الْمَقْدِسِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  الْأَوْزَاعِيُّ ،  ثَنَا  شَدَّادٌ أَبُو عَمَّارٍ ، أَنَّ وَاثِلَةَ بْنَ الْأَسْقَعِ ،  حَدَّثَهُ  قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي أَصَبْتُ  حَدًّا  فَأَقِمْهُ عَلَيَّ ، فَأَعْرَضَ عَنْهُ مَرَّتَيْنِ ، وَأُقِيمَتِ الصَّلَاةُ فَلَمَّا سَلَّمَ قَالَ : يَا رَسُولَ اللهِ ، إِنِّي أَصَبْتُ  حَدًّا  فَأَقِمْهُ عَلَيَّ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَمَا تَوَضَّأْتَ حِينَ أَقْبَلْتَ  قَالَ : نَعَمْ ، قَالَ : "" وَصَلَّيْتَ مَعَنَا "" قَالَ : نَعَمْ ، قَالَ : "" فَاذْهَبْ فَإِنَّ اللهَ قَدْ عَفَا عَنْكَ  .","","Al-Mu'jam al-Kabir 162","","واثلة بن الأسقع الليثي عن شداد بن عبد الله العذري عن أبو عمرو الأوزاعي عن محمد بن كثير بن أبي عطاء عن أحمد بن مسعود المقدسي عن الطبراني","شداد أبو عمار عن واثلة"
"19655","163  -  حَدَّثَنَا  أَبُو عَمَّارٍ مُحَمَّدُ بْنُ إِبْرَاهِيمَ النَّحْوِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  شَدَّادٍ أَبِي عَمَّارٍ ،  عَنْ  أَبِي أُمَامَةَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 163","","أبو أمامة الباهلي عن شداد بن عبد الله العذري عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن سليمان بن عبد الرحمن التميمي عن محمد بن إبراهيم الصوري عن الطبراني","شداد أبو عمار عن واثلة"
"19656","[22/68]      رَبِيعَةُ بْنُ يَزِيدَ  ، عَنْ  وَاثِلَةَ  164  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  رَبِيعَةَ بْنِ يَزِيدَ ،  أَنَّهُ سَمِعَ  وَاثِلَةَ بْنَ الْأَسْقَعِ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ مِنْ أَعْظَمَ  الْفِرْيَةِ  ثَلَاثًا : أَنْ يَفْتَرِيَ عَلَى عَيْنَيْهِ أَنْ يَقُولَ : قَدْ رَأَيْتُ وَلَمْ يَرَ  ، وَأَنْ يَفْتَرِيَ يُدْعَى إِلَى غَيْرِ أَبِيهِ أَوْ يَقُولَ : بِسَمْعِي وَلَمْ يَسْمَعْ  .","","Al-Mu'jam al-Kabir 164","","واثلة بن الأسقع الليثي عن ربيعة بن يزيد القصير عن معاوية بن صالح بن حدير الحضرمي عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","ربيعة بن يزيد عن واثلة"
"19657","165  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ  ، ثَنَا  يَحْيَى بْنُ صَالِحٍ الْوُحَاظِيُّ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَمْزَةَ الدِّمَشْقِيُّ  ، ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ أَبُو النَّضْرِ قَالَا :  ثَنَا  رَبِيعَةُ بْنُ يَزِيدَ الرَّحَبِيُّ  ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ طَلَبَ عِلْمًا فَأَدْرَكَهُ كَتَبَ اللهُ لَهُ  كِفْلَيْنِ  مِنَ الْأَجْرِ  ، وَمَنْ طَلَبَ عِلْمًا فَلَمْ يُدْرِكْهُ كَتَبَ اللهُ  كِفْلًا  مِنَ الْأَجْرِ  .  كذا في طبعة مكتبة ابن تيمية والنسخة الخطية ، وفيه سقط ، والصواب : (يَزِيدُ بْنُ رَبِيعَةَ الرحبي عن ربيعة بن يزيد) والله أعلم .","","Al-Mu'jam al-Kabir 165","","واثلة بن الأسقع الليثي عن يزيد بن ربيعة الرحبي عن إسحاق بن إبراهيم الفراديسي عن أحمد بن محمد بن يحيى البتلهي عن الطبراني","ربيعة بن يزيد عن واثلة"
"19658","166  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ قَالَ :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،         [22/69]      حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ، أَنَّ رَبِيعَةَ بْنَ يَزِيدَ ،  حَدَّثَهُ  أَنَّهُ سَمِعَ  وَاثِلَةَ بْنَ الْأَسْقَعِ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّكُمْ تَزْعُمُونَ أَنِّي آخِرُكُمْ مَوْتًا  ، وَإِنِّي أَوَّلُكُمْ ذَهَابًا ، ثُمَّ تَأْتُونَ مِنْ بَعْدِي  أَفْنَادًا  يَقْتُلُ بَعْضُكُمْ بَعْضًا  .","","Al-Mu'jam al-Kabir 166","","واثلة بن الأسقع الليثي عن ربيعة بن يزيد القصير عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","ربيعة بن يزيد عن واثلة"
"19659","167  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَسْعُودٍ الْمَقْدِسِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  الْأَوْزَاعِيُّ ،  عَنْ  رَبِيعَةَ بْنِ يَزِيدَ قَالَ :  سَمِعْتُ  وَاثِلَةَ بْنَ الْأَسْقَعِ ، يَقُولُ :  خَرَجَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  إِنَّكُمْ تَزْعُمُونَ أَنِّي مِنْ آخِرِكُمْ وَفَاةً  ، وَإِنِّي مِنْ أَوَّلِكُمْ وَفَاةً ، فَتَتْبَعُونِي  أَفْنَادًا  يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ  .","","Al-Mu'jam al-Kabir 167","","واثلة بن الأسقع الليثي عن ربيعة بن يزيد القصير عن أبو عمرو الأوزاعي عن محمد بن كثير بن أبي عطاء عن أحمد بن مسعود المقدسي عن الطبراني","ربيعة بن يزيد عن واثلة"
"19660","168  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ ،  ثَنَا  أَبِي  ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ، وَعُمَرُ بْنُ عَبْدِ الْوَاحِدِ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  الْحَكَمُ بْنُ مُوسَى ،  ثَنَا  الْهِقْلُ بْنُ زِيَادٍ ،  عَنِ  الْأَوْزَاعِيِّ قَالَ :  حَدَّثَنِي  رَبِيعَةُ بْنُ يَزِيدَ ،  عَنْ  وَاثِلَةَ قَالَ :  خَرَجَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  تَزْعُمُونَ أَنِّي مِنْ آخِرِكُمْ وَفَاةً ، وَإِنِّي أَوَّلُكُمْ وَفَاةً  ، وَتَتْبَعُونِي  أَفْنَادًا  يُهْلِكُ بَعْضُكُمْ بَعْضًا  .","","Al-Mu'jam al-Kabir 168","","واثلة بن الأسقع الليثي عن ربيعة بن يزيد القصير عن أبو عمرو الأوزاعي عن هقل بن زياد السكسكي عن الحكم بن موسى بن أبي زهير النسائي عن عبد الله بن أحمد بن حنبل عن الطبراني","ربيعة بن يزيد عن واثلة"
"19661","أَبُو بَكْرِ بْنُ بَشِيرٍ  عَنْ  وَاثِلَةَ  169  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  سُلَيْمَانُ بْنُ أَحْمَدَ الْوَاسِطِيُّ ،  ثَنَا  يَحْيَى بْنُ الْحَجَّاجِ ،  ثَنَا  عِيسَى بْنُ سِنَانٍ ،  عَنْ  أَبِي بَكْرِ بْنِ بَشِيرٍ قَالَ :  سَمِعْتُ  وَاثِلَةَ بْنَ الْأَسْقَعِ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ أَتَى  كَاهِنًا  فَسَأَلَهُ عَنْ شَيْءٍ  حُجِبَتْ  عَنْهُ التَّوْبَةُ أَرْبَعِينَ لَيْلَةً  ، فَإِنْ صَدَّقَهُ بِمَا قَالَ كَفَرَ  .","","Al-Mu'jam al-Kabir 169","","واثلة بن الأسقع الليثي عن أبو بكر بن بشير عن عيسى بن سنان القسملي عن يحيى بن أبي الحجاج الأهتمي عن سليمان بن أحمد الدمشقي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو بكر بن بشير عن واثلة"
"19662","[22/70]      بُسْرُ بْنُ عُبَيْدِ اللهِ  عَنْ  وَاثِلَةَ  170  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ ،  ثَنَا  الْحَسَنُ بْنُ يَحْيَى الْخُشَنِيُّ قَالَ :  ثَنَا  زَيْدُ بْنُ وَاقِدٍ ، (  ح  )  وَحَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ  ، ثَنَا  أَبُو مُسْهِرٍ ، (  ح  )  وَحَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي حَسَّانَ الْأَنْمَاطِيُّ ، وَمُوسَى بْنُ سَهْلٍ أَبُو عِمْرَانَ الْجَوْنِيُّ قَالَا :  ثَنَا  هِشَامُ بْنُ عَمَّارٍ قَالَا :  ثَنَا  صَدَقَةُ بْنُ خَالِدٍ قَالَ :  حَدَّثَنِي  زَيْدُ بْنُ وَاقِدٍ ،  عَنْ  بُسْرِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ :  كُنْتُ فِي  أَصْحَابِ الصُّفَّةِ  ، فَلَقَدْ رَأَيْتُنَا وَمَا مِنَّا إِنْسَانٌ عَلَيْهِ ثَوْبٌ تَامٌّ ، وَأَخَذَ الْعَرَقُ فِي جُلُودِنَا طَرَفًا مِنَ الْغُبَارِ وَالْوَسَخِ ، إِذْ خَرَجَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ: لِيُبْشِرْ فُقَرَاءُ  الْمُهَاجِرِينَ  ، إِذْ أَقْبَلَ  رَجُلٌ  عَلَيْهِ  شَارَةٌ  حَسَنَةٌ ، فَجَعَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَا يَتَكَلَّمُ بِكَلَامٍ إِلَّا  كَلَّفَتْهُ  نَفْسُهُ ، يَأْتِي بِكَلَامٍ يَعْلُو كَلَامَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا انْصَرَفَ قَالَ :  إِنَّ اللهَ لَا يُحِبُّ هَذَا وَصَوْتَهُ ،  يَلْوُونَ أَلْسِنَتَهُمْ لِلنَّاسِ لَيَّ الْبَقَرَةِ لِسَانَهَا بِالْمَرْعَى ، كَذَلِكَ يَلْوِي اللهُ أَلْسِنَتَهُمْ وَوُجُوهَهُمْ فِي النَّارِ  .","","Al-Mu'jam al-Kabir 170","","واثلة بن الأسقع الليثي عن بسر بن عبيد الله الحضرمي عن زيد بن واقد القرشي عن صدقة بن خالد السمين عن هشام بن عمار عن إسحاق بن إبراهيم بن أبي حسان الأنماطي عن الطبراني","بسر بن عبيد الله عن واثلة"
"19663","عَبْدُ الْوَاحِدِ بْنُ عَبْدِ اللهِ النَّصْرِيُّ  عَنْ  وَاثِلَةَ  171  -  حَدَّثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ حَبِيبِ بْنِ أَدْرَكَ ، أَنَّ عَبْدَ الْوَهَّابِ بْنَ مُحِبٍّ ،  أَخْبَرَهُ  أَنَّ عَبْدَ الْوَاحِدِ النَّصْرِيَّ  أَخْبَرَهُمْ  قَالَ :  سَمِعْتُ  وَاثِلَةَ بْنَ الْأَسْقَعِ يُحَدِّثُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مِنْ  أَفْرَى         [22/71]      الْفَرْيِ مَنْ  قَوَّلَنِي  مَا لَمْ أَقُلْ  ، وَمَنْ أَرَى عَيْنَيْهِ فِي الْمَنَامِ مَا لَمْ يَرَهُ ، وَمَنِ  ادَّعَى  إِلَى غَيْرِ أَبِيهِ  .","","Al-Mu'jam al-Kabir 171","","واثلة بن الأسقع الليثي عن عبد الواحد بن عبد الله بن كعب النصري عن عبد الوهاب بن بخت الأموي عن عبد الرحمن بن حبيب بن أردك المخزومي عن سليمان بن بلال القرشي عن إسماعيل بن أبي أويس عن علي بن محمد بن عبد الله الصنعاني عن الطبراني","عبد الواحد بن عبد الله النصري عن واثلة"
"19664","172  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، (  ح  )  وَحَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ قَالَا :  ثَنَا  اللَّيْثُ بْنُ سَعْدٍ ،  عَنْ  هِشَامِ بْنِ سَعْدٍ ،  عَنْ  عَبْدِ الْوَهَّابِ بْنِ بُخْتٍ الْمَكِّيِّ ،  عَنْ  عَبْدِ الْوَاحِدِ النَّصْرِيِّ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ مِنْ  أَفْرَى  الْفَرْيِ مَنْ  قَوَّلَنِي  مَا لَمْ أَقُلْ  ، وَمَنِ  ادَّعَى  إِلَى غَيْرِ أَبِيهِ ، وَمَنْ أَرَى عَيْنَيْهِ فِي الْمَنَامِ مَا لَمْ يَرَ  .","","Al-Mu'jam al-Kabir 172","","واثلة بن الأسقع الليثي عن عبد الواحد بن عبد الله بن كعب النصري عن عبد الوهاب بن بخت الأموي عن هشام بن سعد المخزومي عن الليث بن سعد عن يحيى بن عبد الله بن بكير المخزومي عن روح بن الفرج القطان عن الطبراني","عبد الواحد بن عبد الله النصري عن واثلة"
"19665","173  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ الْحِمْصِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ،  ثَنَا  بَقِيَّةُ ،  حَدَّثَنِي  أَيُّوبُ بْنُ سَعْدٍ ،  عَنْ  أَبِيهِ  قَالَ :  حَدَّثَنِي  عَبْدُ الْوَاحِدِ النَّصْرِيُّ ،  عَنْ  وَاثِلَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ أَعْظَمَ الْفَرْيِ عِنْدَ اللهِ مَنْ يَقُولُ عَلَيَّ مَا لَمْ أَقُلْ  ، وَادَّعَى إِلَى غَيْرِ مَوَالِيهِ ، أَوْ أَرَى عَيْنَيْهِ فِي الْمَنَامِ مَا لَمْ يَرَ  .","","Al-Mu'jam al-Kabir 173","","واثلة بن الأسقع الليثي عن عبد الواحد بن عبد الله بن كعب النصري عن أبيه عن أيوب بن سعد عن بقية بن الوليد عن محمد بن مصفى بن بهلول عن إبراهيم بن محمد بن عرق الحمصي عن الطبراني","عبد الواحد بن عبد الله النصري عن واثلة"
"19666","174  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِي ،  عَنْ  سَعِيدِ بْنِ أَبِي أَيُّوبَ ، قَالَ :  حَدَّثَنِي  مُحَمَّدُ بْنُ عَجْلَانَ قَالَ :  سَمِعْتُ  عَبْدَ الْوَاحِدِ بْنَ عَبْدِ اللهِ يَقُولُ :  سَمِعْتُ  وَاثِلَةَ بْنَ الْأَسْقَعِ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَفْرَى  الْفَرْيِ مَنْ تَقَوَّلَ عَلَيَّ مَا لَمْ أَقُلْ  ، وَمَنْ أَرَى عَيْنَيْهِ مَا لَمْ يَرَ ، وَمَنِ  ادَّعَى  إِلَى غَيْرِ أَبِيهِ  .","","Al-Mu'jam al-Kabir 174","","واثلة بن الأسقع الليثي عن عبد الواحد بن عبد الله بن كعب النصري عن محمد بن عجلان عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن بشر بن موسى بن صالح الأسدي عن الطبراني","عبد الواحد بن عبد الله النصري عن واثلة"
"19667","175  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ الْمِصْرِيُّ ،  ثَنَا  خَالِدُ بْنُ نِزَارٍ ،  ثَنَا         [22/72]      هِشَامُ بْنُ سَعْدٍ ،  عَنْ  عَبْدِ الْوَهَّابِ بْنِ بُخْتٍ ،  عَنْ  عَبْدِ الْوَاحِدِ بْنِ عَبْدِ اللهِ النَّصْرِيِّ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 175","","واثلة بن الأسقع الليثي عن عبد الواحد بن عبد الله بن كعب النصري عن عبد الوهاب بن بخت الأموي عن هشام بن سعد المخزومي عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","عبد الواحد بن عبد الله النصري عن واثلة"
"19668","176  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْخُزَاعِيُّ الْأَصْبَهَانِيُّ ،  ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ حَبِيبِ بْنِ أَدْرَكَ ،  عَنْ  عَبْدِ الْوَاحِدِ النَّصْرِيِّ ،  عَنْ  وَاثِلَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 176","","واثلة بن الأسقع الليثي عن عبد الواحد بن عبد الله بن كعب النصري عن عبد الرحمن بن حبيب بن أردك المخزومي عن عبد العزيز بن محمد الدراوردي عن عبد الله بن مسلمة القعنبي عن أحمد بن محمد بن علي الخزاعي عن الطبراني","عبد الواحد بن عبد الله النصري عن واثلة"
"19669","177  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْخَلَّالُ الْمَكِّيُّ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُوسَى التَّيْمِيُّ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  عَنْ  عَبْدِ الْوَهَّابِ بْنِ بُخْتٍ ،  عَنْ  عَبْدِ الْوَاحِدِ النَّصْرِيِّ ،  عَنْ  وَاثِلَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 177","","واثلة بن الأسقع الليثي عن عبد الواحد بن عبد الله بن كعب النصري عن عبد الوهاب بن بخت الأموي عن أسامة بن زيد الليثي المدني عن عبد الله بن موسى بن إبراهيم الطلحي عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","عبد الواحد بن عبد الله النصري عن واثلة"
"19670","178  -  حَدَّثَنَا  أَبُو زُرْعَةَ الدِّمَشْقِيُّ  ، ثَنَا  عَلِيُّ بْنُ عَيَّاشٍ ، (  ح  )  وَحَدَّثَنَا  وَرْدُ بْنُ أَحْمَدَ بْنِ لَبِيدٍ الْبَيْرُوتِيُّ  ، ثَنَا  صَفْوَانُ بْنُ صَالِحٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  أَنَا  حَرِيزُ بْنُ عُثْمَانَ ،  عَنْ  عَبْدِ الْوَاحِدِ بْنِ عَبْدِ اللهِ النَّصْرِيِّ قَالَ :  سَمِعْتُ  وَاثِلَةَ بْنَ الْأَسْقَعِ ، يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مِنْ أَعْظَمِ الْفَرْيِ أَنْ يَدَّعِيَ إِلَى غَيْرِ أَبِيهِ  ، أَوْ أَنْ يُرِيَ عَيْنَيْهِ فِي الْمَنَامِ مَا لَمْ تَرَ ، أَوْ يَقُولَ عَلَى اللهِ وَعَلَى رَسُولِهِ مَا لَمْ يَقُلْ  .","","Al-Mu'jam al-Kabir 178","","واثلة بن الأسقع الليثي عن عبد الواحد بن عبد الله بن كعب النصري عن حريز بن عثمان الرحبي عن الوليد بن مسلم القرشي عن صفوان بن صالح الدمشقي عن محمد بن أحمد بن لبيد عن الطبراني","عبد الواحد بن عبد الله النصري عن واثلة"
"19671","179  -  حَدَّثَنَا  عَمْرُو بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ بْنِ الْعَلَاءِ ،  ثَنَا  أَبِي  (  ح  ) ،  وَحَدَّثَنَا  عُمَارَةُ بْنُ وَثِيمَةَ الْمِصْرِيُّ  ، ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ زِبْرِيقٍ         [22/73]      الْحِمْصِيُّ ،  ثَنَا  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ سَالِمٍ ،  عَنِ  الزُّبَيْدِيِّ قَالَ :  ثَنَا  عَبْدُ الْوَاحِدِ ،  أَنَّهُ سَمِعَ  وَاثِلَةَ بْنَ الْأَسْقَعِ يَقُولُ : إِنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ أَعْظَمَ الْفَرْيِ أَنْ يُتَقَوَّلَ عَلَيَّ مَا لَمْ أَقُلْ  ، أَوْ يَدَّعِيَ رَجُلٌ لِغَيْرِ أَبِيهِ ، أَوْ يُرِيَ عَيْنَيْهِ فِي الْمَنَامِ مَا لَمْ تَرَ  .","","Al-Mu'jam al-Kabir 179","","واثلة بن الأسقع الليثي عن عبد الواحد بن عبد الله بن كعب النصري عن محمد بن الوليد بن عامر الزبيدي عن عبد الله بن سالم الوحاظي عن عمرو بن الحارث الزبيدي عن إسحاق بن إبراهيم بن العلاء عن عمارة بن وثيمة المصري عن الطبراني","عبد الواحد بن عبد الله النصري عن واثلة"
"19672","180  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  أَنَسُ بْنُ عِيَاضٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرٍ الْأَسْلَمِيِّ ،  عَنْ  سُلَيْمَانَ بْنِ حَبِيبٍ الْمُحَارِبِيِّ ،  عَنْ  عَبْدِ الْوَاحِدِ بْنِ عَبْدِ اللهِ النَّصْرِيِّ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مِنْ أَعْظَمَ الْفَرْيِ أَنْ يَقُولَ عَلَيَّ الرَّجُلُ مَا لَمْ أَقُلْ  ، أَوْ يَدَّعِيَ إِلَى غَيْرِ أَبِيهِ ، أَوْ يُرِيَ عَيْنَيْهِ فِي الْمَنَامِ مَا لَمْ تَرَ  .","","Al-Mu'jam al-Kabir 180","","واثلة بن الأسقع الليثي عن عبد الواحد بن عبد الله بن كعب النصري عن سليمان بن حبيب المحاربي عن عبد الله بن عامر الأسلمي عن أنس بن عياض الليثي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","عبد الواحد بن عبد الله النصري عن واثلة"
"19673","181  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  أَنَا  مُحَمَّدُ بْنُ حَرْبٍ ،  أَنَا  عُمَرُ بْنُ رُؤْبَةَ  قَالَ  : دَخَلْتُ مَعَ أَبِي سَلَمَةَ الْحِمْصِيِّ عَلَيْهِ  فَحَدَّثَنِي عَنْ  عَبْدِ الْوَاحِدِ النَّصْرِيِّ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  تَحُوزُ  الْمَرْأَةُ ثَلَاثَ مَوَارِيثَ : عَتِيقَهَا ،  وَلَقِيطَهَا  ، وَالْوَلَدَ الَّذِي لَا عَيْبَ عَلَيْهِ  .         [22/74]","","Al-Mu'jam al-Kabir 181","","واثلة بن الأسقع الليثي عن عبد الواحد بن عبد الله بن كعب النصري عن سليمان بن سليم الكناني عن عمر بن رؤبة التغلبي عن محمد بن حرب الأبرش عن إسحاق ابن راهويه عن موسى بن هارون الحمال عن الطبراني","عبد الواحد بن عبد الله النصري عن واثلة"
"19674","182  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  ثَنَا  بَقِيَّةُ ،  حَدَّثَنِي  أَبُو سَلَمَةَ الْحِمْصِيُّ سُلَيْمَانُ بْنُ سُلَيْمٍ ،  عَنْ  عُمَرَ بْنِ رُؤْبَةَ ،  عَنْ  عَبْدِ الْوَاحِدِ بْنِ عَبْدِ اللهِ النَّصْرِيِّ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 182","","واثلة بن الأسقع الليثي عن عبد الواحد بن عبد الله بن كعب النصري عن عمر بن رؤبة التغلبي عن سليمان بن سليم الكناني عن بقية بن الوليد عن إسحاق ابن راهويه عن موسى بن هارون الحمال عن الطبراني","عبد الواحد بن عبد الله النصري عن واثلة"
"19675","183  -  حَدَّثَنَا  أَبُو زُرْعَةَ الدِّمَشْقِيُّ ، وَالْحُسَيْنُ بْنُ السَّمَيْدَعِ الْأَنْطَاكِيُّ قَالَا :  ثَنَا  مُحَمَّدُ بْنُ الْمُبَارَكِ الصُّورِيُّ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، وَإِدْرِيسُ بْنُ عَبْدِ الْكَرِيمِ قَالَا :  ثَنَا  الْهَيْثَمُ بْنُ خَارِجَةَ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ قَالَ :  ثَنَا  هِشَامُ بْنُ عَمَّارٍ قَالُوا :  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  يَحْيَى بْنِ يَزِيدَ ،  عَنْ  يَزِيدَ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  عَبْدِ الْوَهَّابِ الْمَكِّيِّ ،  عَنْ  عَبْدِ الْوَاحِدِ بْنِ عَبْدِ اللهِ النَّصْرِيِّ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْمُسْلِمُ عَلَى الْمُسْلِمِ حَرَامٌ ، دَمُهُ  وَعِرْضُهُ  ، وَمَالُهُ ، الْمُسْلِمُ أَخُو الْمُسْلِمِ لَا يَظْلِمُهُ ، وَلَا  يَخْذُلُهُ  ، وَالتَّقْوَى هَاهُنَا وَأَشَارَ بِيَدِهِ إِلَى الْقَلْبِ ، وَبِحَسْبِ امْرِئٍ مِنَ الشَّرِّ أَنْ يَحْقِرَ أَخَاهُ الْمُسْلِمَ  .","","Al-Mu'jam al-Kabir 183","","واثلة بن الأسقع الليثي عن عبد الواحد بن عبد الله بن كعب النصري عن عبد الوهاب بن بخت الأموي عن زيد بن أبي أنيسة الجزري عن يحيى بن يزيد الرهاوي عن إسماعيل بن عياش الأحول عن محمد بن المبارك القلانسي عن أبو زرعة الدمشقي عن الطبراني","عبد الواحد بن عبد الله النصري عن واثلة"
"19676","184  -  حَدَّثَنَا  عَمْرُو بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ بْنِ الْعَلَاءِ ،  ثَنَا  جَدِّي  ، (  ح  )  وَحَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْعَلَاءِ الْحِمْصِيُّ ،  ثَنَا         [22/75]      إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عُمَرَ بْنِ رُؤْبَةَ ،  عَنْ  عَبْدِ الْوَاحِدِ بْنِ عَبْدِ اللهِ النَّصْرِيِّ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ سَنَّ سُنَّةً حَسَنَةً فَلَهُ أَجْرُهَا مَا عَمِلَ بِهِ فِي حَيَاتِهِ وَبَعْدَ مَمَاتِهِ حَتَّى يَتْرُكَ  ، وَمَنْ سَنَّ سُنَّةً سَيِّئَةً فَعَلَيْهِ إِثْمُهَا حَتَّى يَتْرُكَ ، وَمَنْ مَاتَ مُرَابِطًا فِي  سَبِيلِ  اللهِ جَرَى لَهُ أَجْرُ الْمُرَابِطِ حَتَّى يُبْعَثَ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 184","","واثلة بن الأسقع الليثي عن عبد الواحد بن عبد الله بن كعب النصري عن عمر بن رؤبة التغلبي عن إسماعيل بن عياش الأحول عن إبراهيم بن العلاء زبريق عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","عبد الواحد بن عبد الله النصري عن واثلة"
"19677","أَبُو الْمَلِيحِ بْنُ أُسَامَةَ الْهُذَلِيُّ  عَنْ  وَاثِلَةَ  185  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ قَالَا  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ قَالَ :  أَخْبَرَنَا  عِمْرَانُ الْقَطَّانُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  وَاثِلَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أُنْزِلَتْ صُحُفُ  إِبْرَاهِيمَ  أَوَّلَ لَيْلَةٍ مِنْ شَهْرِ رَمَضَانَ  ، وَأُنْزِلَتِ التَّوْرَاةُ لِسِتٍّ مَضَيْنَ مِنْ رَمَضَانَ ، وَأُنْزِلَ الْإِنْجِيلُ لِثَلَاثَ عَشْرَةَ مَضَتْ مِنْ رَمَضَانَ ، وَأُنْزِلَ الزَّبُورُ لِثَمَانِ عَشْرَةَ خَلَتْ مِنْ رَمَضَانَ ، وَأُنْزِلَ الْقُرْآنُ لِأَرْبَعَ عَشْرَةَ خَلَتْ مِنْ رَمَضَانَ  .","","Al-Mu'jam al-Kabir 185","","واثلة بن الأسقع الليثي عن أبو المليح بن أسامة الهذلي عن قتادة بن دعامة عن عمران بن داور القطان عن عبد الله بن رجاء الغداني عن أبو مسلم الكجي عن الطبراني","أبو المليح بن أسامة الهذلي عن واثلة"
"19678","186  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ، وَالْحَسَنُ بْنُ سَهْلٍ الْمُجَوِّزُ الْبَصْرِيُّ قَالَا :  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ قَالَ :  أَخْبَرَنَا  عِمْرَانُ الْقَطَّانُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  وَاثِلَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أُعْطِيتُ مَكَانَ التَّوْرَاةِ  السَّبْعَ  ، وَأُعْطِيتُ مَكَانَ الزَّبُورِ الْمَثَانِيَ ، وَفُضِّلْتُ بِالْمُفَصَّلِ  .","","Al-Mu'jam al-Kabir 186","","واثلة بن الأسقع الليثي عن أبو المليح بن أسامة الهذلي عن قتادة بن دعامة عن عمران بن داور القطان عن عمرو بن مرزوق الباهلي عن الحسن بن سهل بن عبد العزيز المجوز عن الطبراني","أبو المليح بن أسامة الهذلي عن واثلة"
"19679","[22/76]      187  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  مُحَمَّدُ بْنُ شُعَيْبِ بْنِ شَابُورَ ،  ثَنَا  سَعِيدُ بْنُ بَشِيرٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أُعْطِيتُ  السَّبْعَ  الطُّوَلَ مَكَانَ التَّوْرَاةِ  ، وَأُعْطِيتُ الْمَثَانِيَ مَكَانَ الْإِنْجِيلِ ، وَأُعْطِيتُ الْمِئِينَ مَكَانَ الزَّبُورِ وَفُضِّلْتُ بِالْمُفَصَّلِ  .","","Al-Mu'jam al-Kabir 187","","واثلة بن الأسقع الليثي عن أبو المليح بن أسامة الهذلي عن قتادة بن دعامة عن سعيد بن بشير الأزدي عن محمد بن شعيب بن شابور القرشي عن هشام بن عمار عن أحمد بن المعلى الأسدي عن الطبراني","أبو المليح بن أسامة الهذلي عن واثلة"
"19680","188  -  حَدَّثَنَا  الْحَسَنُ بْنُ جَرِيرٍ الصُّورِيُّ  ، ثَنَا  أَبُو الْجُمَاهِرِ ،  ثَنَا  سَعِيدُ بْنُ بَشِيرٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيَدْخُلَنَّ الْجَنَّةَ بِشَفَاعَةِ رَجُلٍ مِنْ أُمَّتِي أَكْثَرُ مِنْ  بَنِي تَمِيمٍ  .","","Al-Mu'jam al-Kabir 188","","واثلة بن الأسقع الليثي عن أبو المليح بن أسامة الهذلي عن قتادة بن دعامة عن سعيد بن بشير الأزدي عن محمد بن عثمان الكفرسوسي عن الحسن بن جرير الزنبقي عن الطبراني","أبو المليح بن أسامة الهذلي عن واثلة"
"19681","189  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  رَوْحُ بْنُ عَبْدِ الْمُؤْمِنِ الْمُقْرِي ، (  ح  )  وَحَدَّثَنَا  طَالِبُ بْنُ قُرَّةَ الْأَذَنِيُّ قَالَ :  ثَنَا  مُحَمَّدُ بْنُ عِيسَى الطَّبَّاعُ قَالُوا :  ثَنَا  إِسْمَاعِيلُ ابْنُ عُلَيَّةَ قَالَ :  أَنَا  لَيْثٌ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَقَدْ أُمِرْتُ بِالسِّوَاكِ حَتَّى خَشِيتُ أَنْ يُكْتَبَ عَلَيَّ  .","","Al-Mu'jam al-Kabir 189","","واثلة بن الأسقع الليثي عن أبو المليح بن أسامة الهذلي عن ليث بن أبي سليم عن إسماعيل ابن علية عن ابن الطباع ، محمد بن عيسى بن نجيح البغدادي عن طالب بن قرة الأذني عن الطبراني","أبو المليح بن أسامة الهذلي عن واثلة"
"19682","190  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  إِسْمَاعِيلُ         [22/77]      بْنُ إِبْرَاهِيمَ ، وَجَرِيرٌ ،  عَنْ  لَيْثٍ ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  وَاثِلَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَقَدْ أُمِرْتُ بِالسِّوَاكِ حَتَّى لَقَدْ خَشِيتُ أَنْ يُكْتَبَ عَلَيَّ  .","","Al-Mu'jam al-Kabir 190","","واثلة بن الأسقع الليثي عن أبو المليح بن أسامة الهذلي عن أبو بردة بن أبي موسى الأشعري عن ليث بن أبي سليم عن جرير بن عبد الحميد عن علي ابن المديني عن الفضل بن الحباب الجمحي عن الطبراني","أبو المليح بن أسامة الهذلي عن واثلة"
"19683","191  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْحُسَيْنِ الصَّابُونِيُّ  ، ثَنَا  زُرَيْقُ بْنُ السَّخْتِ ، قَالَ :  أَنَا  هَاشِمُ بْنُ الْقَاسِمِ ، (  ح  )  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ قَالَا:  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى قَالَا :  ثَنَا  شَيْبَانُ أَبُو مُعَاوِيَةَ ،  عَنْ  لَيْثِ بْنِ أَبِي سُلَيْمٍ ،  عَنْ  أَبِي بُرْدَةَ بْنِ أَبِي مُوسَى ،  عَنْ  أَبِي مَلِيحِ بْنِ أُسَامَةَ الْهُذَلِيِّ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ :  كُنَّا عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَتَاهُ  رَجُلٌ  فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي أَصَبْتُ  حَدًّا  مِنْ حُدُودِ اللهِ فَأَقِمْ فِيَّ حَدَّ اللهِ فَأَعْرَضَ عَنْهُ ثُمَّ أَتَاهُ الثَّانِيَةَ فَأَعْرَضَ عَنْهُ ، ثُمَّ أَتَاهُ الثَّالِثَةَ فَأَعْرَضَ عَنْهُ فَأُقِيمَتِ الصَّلَاةُ ، فَلَمَّا قَضَى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الصَّلَاةَ قَالَ : يَا رَسُولَ اللهِ ، إِنِّي أَصَبْتُ  حَدًّا  مِنْ حُدُودِ اللهِ فَأَقِمْ فِيَّ حَدَّ اللهِ ، قَالَ :  أَوَلَيْسَ قَدْ تَوَضَّأْتَ فَأَحْسَنْتَ الْوُضُوءَ ، وَتَطَهَّرْتَ فَأَحْسَنْتَ الطُّهُورَ ، وَشَهِدْتَ مَعَنَا الصَّلَاةَ آنِفًا  قَالَ : بَلَى ، قَالَ : "" اذْهَبْ فَهِيَ كَفَّارَتُكَ  .","","Al-Mu'jam al-Kabir 191","","واثلة بن الأسقع الليثي عن أبو المليح بن أسامة الهذلي عن أبو بردة بن أبي موسى الأشعري عن ليث بن أبي سليم عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","أبو المليح بن أسامة الهذلي عن واثلة"
"19684","192  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ قَالَ :  ثَنَا  أَبُو الرَّبِيعِ         [22/78]      الزَّهْرَانِيُّ ،  ثَنَا  عَلِيُّ بْنُ غُرَابٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ أَبِي حُمَيْدٍ ،  ثَنَا  أَبُو الْمَلِيحِ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَدَخَلَ  أَعْرَابِيٌّ  فَقَالَ : اللَّهُمَّ ارْحَمْنِي  وَمُحَمَّدًا  وَلَا تَرْحَمْ مَعَنَا أَحَدًا ، فَقَالُوا لَهُ : وَيْحَكَ وَوَيْلَكَ لَقَدْ حَظَرْتَ وَاسِعًا ، ثُمَّ تَنَحَّى الْأَعْرَابِيُّ ، فَبَالَ قَائِمًا فَوَثَبُوا إِلَيْهِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  دَعُوهُ حَتَّى يَفْرُغَ مِنْ مَبَالِهِ  ، ثُمَّ دَعَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِسَجْلٍ  مِنْ مَاءٍ فَصَبَّهُ عَلَى مَبَالِهِ  .","","Al-Mu'jam al-Kabir 192","","واثلة بن الأسقع الليثي عن أبو المليح بن أسامة الهذلي عن عبيد الله بن أبي حميد الهذلي عن علي بن عبد العزيز الفزاري عن سليمان بن داود العتكي عن الحسين بن إسحاق التستري عن الطبراني","أبو المليح بن أسامة الهذلي عن واثلة"
"19685","193  -  حَدَّثَنَا  جَعْفَرُ بْنُ أَحْمَدَ بْنِ سِنَانٍ الْوَاسِطِيُّ  ، ثَنَا  أَحْمَدُ بْنُ الْمِقْدَامِ أَبُو الْأَشْعَثِ ،  حَدَّثَنَا  عُبَيْدُ بْنُ الْقَاسِمِ ،  ثَنَا  الْعَلَاءُ بْنُ ثَعْلَبَةَ ،  عَنْ  أَبِي الْمَلِيحِ الْهُذَلِيِّ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ :  تَرَاءَيْتُ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِمَسْجِدِ الْخَيْفِ  فَقَالَ لِي أَصْحَابُهُ : إِلَيْكَ يَا  وَاثِلَةُ  ، أَيْ تَنَحَّ عَنْ وَجْهِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" دَعُوهُ فَإِنَّمَا جَاءَ لِيَسْأَلَ "" فَدَنَوْتُ ، فَقُلْتُ : بِأَبِي أَنْتَ وَأُمِّي يَا رَسُولَ اللهِ ، أَفْتِنَا عَنْ أَمْرٍ نَأْخُذُهُ عَنْكَ مِنْ بَعْدِكَ ، قَالَ : "" لِتُعِنْكَ نَفْسُكَ "" فَقَالَ "" كَيْفَ لِي بِذَلِكَ ؟ فَقَالَ :  تَدَعُ مَا  يَرِيبُكَ  إِلَى مَا لَا  يَرِيبُكَ  وَإِنْ أَفْتَاكَ الْمُفْتُونَ  فَقُلْتُ : وَكَيْفَ لِي بِعِلْمِ ذَلِكَ ؟ قَالَ : "" تَضَعُ يَدَكَ عَلَى فُؤَادِكَ ، فَإِنَّ الْقَلْبَ يَسْكُنُ لِلْحَلَالِ ، وَلَا يَسْكُنُ لِلْحَرَامِ ، وَإِنَّ الْوَرِعَ الْمُسْلِمَ يَدَعُ الصَّغِيرَ مَخَافَةَ أَنْ يَقَعَ فِي الْكَبِيرِ "" قُلْتُ : بِأَبِي أَنْتَ وَأُمِّي مَا  الْعَصَبِيَّةُ  ؟ قَالَ : "" الَّذِي يُعِينُ قَوْمَهُ عَلَى الظُّلْمِ "" قُلْتُ : فَمَنِ الْحَرِيصُ ؟ قَالَ : "" الَّذِي يَطْلُبُ الْمَكْسَبَةَ مِنْ غَيْرِ حِلِّهَا "" قُلْتُ :         [22/79]      فَمَنِ الْوَرِعُ ؟ قَالَ : "" الَّذِي يَقِفُ عِنْدَ الشُّبْهَةِ "" قُلْتُ : فَمَنِ الْمُؤْمِنُ ؟ قَالَ : "" مَنْ أَمِنَهُ النَّاسُ عَلَى أَمْوَالِهِمْ وَدِمَائِهِمْ "" قُلْتُ : فَمَنِ الْمُسْلِمُ ؟ قَالَ : "" مَنْ سَلِمَ النَّاسُ مِنْ لِسَانِهِ وَيَدِهِ "" ، قُلْتُ : فَأَيُّ  الْجِهَادِ  أَفْضَلُ ؟ قَالَ : "" كَلِمَةُ حُكْمٍ عِنْدَ إِمَامٍ جَائِرٍ  .","","Al-Mu'jam al-Kabir 193","","واثلة بن الأسقع الليثي عن أبو المليح بن أسامة الهذلي عن العلاء بن ثعلبة عن عبيد بن القاسم الأسدي عن أحمد بن المقدام العجلي عن جعفر بن أحمد بن سنان الواسطي عن الطبراني","أبو المليح بن أسامة الهذلي عن واثلة"
"19686","عَوْنُ بْنُ عَبْدِ اللهِ بْنِ عُتْبَةَ  عَنْ  وَاثِلَةَ  194  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  حَدَّثَنِي  مُبَشِّرُ بْنُ عُبَيْدٍ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  عَوْنِ بْنِ عَبْدِ اللهِ قَالَ : لَقِيتُ وَاثِلَةَ بْنَ الْأَسْقَعِ فَقُلْتُ : مَا أَعْمَلَنِي إِلَى  الشَّامِ  غَيْرُكَ  فَحَدِّثْنِي  مِمَّا سَمِعْتَ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  اللَّهُمَّ ارْحَمْنَا ، وَاغْفِرْ لَنَا ، وَنَهَانَا أَنْ نُصَلِّيَ إِلَى الْقُبُورِ ، أَوْ نَجْلِسَ عَلَيْهَا  .","","Al-Mu'jam al-Kabir 194","","واثلة بن الأسقع الليثي عن عون بن عبد الله بن عتبة عن حجاج بن أرطاة عن مبشر بن عبيد الحمصي عن بقية بن الوليد عن عبد الوهاب بن نجدة عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","عون بن عبد الله بن عتبة عن واثلة"
"19687","عَمْرُو بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  عَنْ  وَاثِلَةَ  195  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عِمْرَانُ بْنُ هَارُونَ الرَّمْلِيُّ ،  ثَنَا  صَدَقَةُ بْنُ الْمُنْتَصِرِ ،  حَدَّثَنِي  يَحْيَى بْنُ أَبِي عَمْرٍو السَّيْبَانِيُّ قَالَ :  حَدَّثَنِي  عَمْرُو بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ قَالَ :  حَدَّثَنِي  وَاثِلَةُ بْنُ الْأَسْقَعِ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  لَا تَقُومُ السَّاعَةُ حَتَّى يَكُونَ عَشْرُ آيَاتٍ : خَسْفٌ بِالْمَشْرِقِ ، وَخَسْفٌ بِالْمَغْرِبِ  ، وَخَسْفٌ فِي  جَزِيرَةِ  الْعَرَبِ  ،  وَالدَّجَّالُ  ، وَنُزُولُ  عِيسَى ابْنِ مَرْيَمَ  ،  وَيَأْجُوجُ  وَمَأْجُوجُ  ، وَالدَّابَّةُ ، وَطُلُوعُ الشَّمْسِ مِنْ         [22/80]      مَغْرِبِهَا ، وَنَارٌ تَخْرُجُ مِنْ تَعْزِ عَدَنٍ يَسُوقُ النَّاسَ إِلَى الْمَحْشَرِ تَحْشُرُ  الذَّرَّ  وَالنَّمْلَ  .","","Al-Mu'jam al-Kabir 195","","واثلة بن الأسقع الليثي عن عمرو بن عبد الله السيباني عن يحيى بن أبي عمرو السيباني عن صدقة بن المنتصر الشعباني عن الصوفي عمران بن أبى عمران عن مطلب بن شعيب بن حيان المروزي عن الطبراني","عمرو بن عبد الله الحضرمي عن واثلة"
"19688","196  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ الدِّمَشْقِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ شُعَيْبِ بْنِ شَابُورَ ،  حَدَّثَنِي  يَحْيَى بْنُ أَبِي عَمْرٍو السَّيْبَانِيُّ ،  عَنْ  عَمْرِو بْنِ عَبْدِ اللهِ الْحَضْرَمِيِّ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ :  خَرَجْتُ مُهَاجِرًا إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا أَقْبَلَ النَّاسُ مِنْ بَيْنِ خَارِجٍ وَقَائِمٍ ، فَجَعَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَا يَرَى جَالِسًا إِلَّا دَنَا إِلَيْهِ فَسَأَلَهُ هَلْ لَكَ مِنْ حَاجَةٍ ؟ وَبَدَأَ بِالصَّفِّ الْأَوَّلِ ، ثُمَّ الثَّانِي ، ثُمَّ الثَّالِثِ حَتَّى دَنَا إِلَيَّ فَقَالَ : "" هَلْ لَكَ مِنْ حَاجَةٍ ؟ "" فَقُلْتُ : نَعَمْ يَا رَسُولَ اللهِ ، قَالَ : "" وَمَا حَاجَتُكَ ؟ "" قُلْتُ : الْإِسْلَامُ ، فَقَالَ : "" هُوَ خَيْرٌ لَكَ "" قَالَ : "" وَتُهَاجِرُ "" قُلْتُ : نَعَمْ ، قَالَ : "" هِجْرَةُ الْبَادِيَةِ أَوْ هِجْرَةُ الْبَاتَّةِ "" قُلْتُ : أَيُّهُمَا أَفْضَلُ ؟ قَالَ :  الْهِجْرَةُ الْبَاتَّةُ أَنْ تَثْبُتَ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَهِجْرَةُ الْبَادِيَةِ أَنْ تَرْجِعَ إِلَى بَادِيَتِكَ وَعَلَيْكَ السَّمْعَ وَالطَّاعَةَ  فِي عُسْرِكَ وَيُسْرِكَ  وَمَكْرَهِكَ  وَمَنْشَطِكَ  وَأَثَرَةٍ عَلَيْكَ "" قَالَ : فَبَسَطْتُ يَدِي إِلَيْهِ فَبَايَعْتُهُ ، قَالَ : وَاسْتَثْنَى لِي حِينَ لَمْ أَسْتَثْنِ لِنَفْسِي ، فَقَالَ : "" فِيمَا اسْتَطَعْتَ "" قَالَ : وَنَادَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  غَزْوَةِ تَبُوكَ  فَخَرَجْتُ إِلَى أَهْلِي فَوَافَقْتُ أَبِي جَالِسًا فِي الشَّمْسِ يَسْتَدْبِرُهَا ، فَسَلَّمْتُ عَلَيْهِ بِتَسْلِيمِ الْإِسْلَامِ ، فَقَالَ : أَصَبَوْتَ ؟ فَقُلْتُ : أَسْلَمْتُ ، فَقَالَ : لَعَلَّ اللهَ يَجْعَلُ لَكَ وَلَنَا فِيهِ خَيْرًا ، فَرَضِيتُ بِذَلِكَ مِنْهُ ، فَبَيْنَا أَنَا مَعَهُ إِذْ أَتَتْنِي أُخْتِي تُسَلِّمُ عَلَيَّ ، فَقُلْتُ : يَا أُخْتَاهُ ، زَوِّدِينِي زَادَ الْمَرْأَةِ أَخَاهَا غَازِيًا ، فَأَتَتْنِي بِعَجِينٍ فِي دَلْوٍ ، وَالدَّلْوُ فِي مِزْوَدٍ ، فَأَقْبَلْتُ وَقَدْ خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَجَعَلْتُ أُنَادِي أَلَا مَنْ يَحْمِلُ رَجُلًا لَهُ سَهْمُهُ ؟         [22/81]      فَنَادَانِي  شَيْخٌ مِنَ الْأَنْصَارِ  فَقَالَ : لَنَا سَهْمُهُ عَلَى أَنْ نَحْمِلَهُ عُقْبَةً وَطَعَامُهُ مَعَنَا ، فَقُلْتُ : نَعَمْ سِرْ عَلَى بَرَكَةِ اللهِ ، فَخَرَجْتُ مَعَ خَيْرِ صَاحِبٍ لِي زَادَنِي حِمْلَانًا عَلَى مَا شَارَطْتُ ، وَخَصَّنِي بِطَعَامٍ سِوَى مَا أَطْعَمُ مَعَهُ حَتَّى أَفَاءَ اللهُ عَلَيْنَا فَأَصَابَنِي  قَلَائِصُ  فَسُقْتُهُنَّ حَتَّى أَتَيْتُهُ ، وَهُوَ فِي خِبَائِهِ ، فَدَعَوْتُهُ فَخَرَجَ فَقَعَدَ عَلَى حَقِيبَةٍ مِنْ حَقَائِبِ إِبِلِهِ ، ثُمَّ قَالَ : سُقْهُنَّ مُدْبِرَاتٍ ، فَسُقْتُهُنَّ مُدْبِرَاتٍ ، ثُمَّ قَالَ : سُقْهُنَّ مُقْبِلَاتٍ ، فَسُقْتُهُنَّ مُقْبِلَاتٍ ، فَقَالَ : مَا أَرَى  قَلَائِصَكَ  إِلَّا كِرَامًا ، قَالَ : قُلْتُ : إِنَّمَا هِيَ غَنِيمَتُكَ الَّتِي شَرَطْتُ لَكَ ، فَقَالَ : خُذْ  قَلَائِصَكَ  يَا ابْنَ أَخِي فَغَيْرَ سَهْمِكَ أَرَدْنَا  .","","Al-Mu'jam al-Kabir 196","","واثلة بن الأسقع الليثي عن عمرو بن عبد الله السيباني عن يحيى بن أبي عمرو السيباني عن محمد بن شعيب بن شابور القرشي عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","عمرو بن عبد الله الحضرمي عن واثلة"
"19689","طَاوُسٌ الْيَمَانِيُّ  عَنْ  وَاثِلَةَ  197  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  حَدَّثَنِي  إِسْمَاعِيلُ بْنُ عَبْدِ اللهِ الْكِنْدِيُّ ،  عَنْ  طَاوُسٍ ،  عَنْ  وَاثِلَةَ قَالَ :  قُلْتُ : يَا نَبِيَّ اللهِ نَبِّئْنِي ، قَالَ : "" إِنْ شِئْتَ أَنْبَأْتُكَ بِمَا جِئْتَ تَسْأَلُ عَنْهُ ، وَإِنْ شِئْتَ فَسَلْ "" قَالَ : قُلْتُ : بَلْ نَبِّئْنِي يَا رَسُولَ اللهِ ، فَإِنَّهُ أَطْيَبُ لِنَفْسِي ، قَالَ : "" جِئْتَ تَسْأَلُ عَنِ الْيَقِينِ وَالشَّكِّ "" قَالَ : قُلْتُ : هُوَ ذَاكَ يَا رَسُولَ اللهِ ، قَالَ :  فَإِنَّ الْيَقِينَ مَا اسْتَقَرَّ فِي الصَّدْرِ وَاطْمَأَنَّ إِلَيْهِ الْقَلْبُ وَإِنْ أَفْتَاكَ الْمُفْتُونَ ، دَعْ مَا  يَرِيبُكَ  إِلَى مَا لَا  يَرِيبُكَ  ، فَإِنَّ الْخَيْرَ طُمَأْنِينَةٌ ، وَالشَّكَّ رِيبَةٌ ، وَإِذَا شَكَكْتَ فَدَعْ مَا  يَرِيبُكَ  إِلَى مَا لَا  يَرِيبُكَ  "" قُلْتُ : يَا نَبِيَّ اللهِ ، بِأَبِي وَأُمِّي فَمَا  الْعَصَبِيَّةُ  ؟ قَالَ : "" أَنْ تُعِينَ قَوْمَكَ عَلَى الظُّلْمِ ، وَالْوَرِعُ الَّذِي يَقِفُ عَلَى الشُّبُهَاتِ ، وَالْحَرِيصُ عَلَى الدُّنْيَا الَّذِي يَطْلُبُهَا مِنْ غَيْرِ حِلٍّ ، وَالْإِثْمُ مَا  حَاكَ  فِي الصَّدْرِ  .","","Al-Mu'jam al-Kabir 197","","واثلة بن الأسقع الليثي عن طاوس بن كيسان عن إسماعيل بن عبد الله الكندي عن بقية بن الوليد عن هشام بن عمار عن أحمد بن المعلى الأسدي عن الطبراني","طاوس اليماني عن واثلة"
"19690","[22/82]      عَبْدُ اللهِ بْنُ يَزِيدَ بْنِ آدَمَ  عَنْ  وَاثِلَةَ  198  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  عَلِيُّ بْنُ مَيْمُونٍ الرَّقِّيُّ ،  ثَنَا  عَبْدُونُ بْنُ خَالِدٍ الْقَرْقَسَانِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ بْنِ آدَمَ الدِّمَشْقِيُّ ،  عَنْ  أَبِي الدَّرْدَاءِ ، وَوَاثِلَةَ بْنِ الْأَسْقَعِ ، وَأَبِي أُمَامَةَ ، وَأَنَسِ بْنِ مَالِكٍ قَالُوا :  كُنَّا فِي مَجْلِسِ أُنَاسٍ مِنَ الْيَهُودِ وَنَحْنُ نَتَذَاكَرُ الْقَدَرَ ، فَخَرَجَ إِلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُغْضَبًا فَعَبَسَ وَانْتَهَرَ وَقَطَّبَ ثُمَّ قَالَ :  مَهْ ،  اتَّقُوا اللهَ يَا أُمَّةَ  مُحَمَّدٍ  ، وَادِيَانِ عَمِيقَانِ قَعْرَانِ مُظْلِمَانِ لَا يَهْجُو إِلَيْكُمْ وَهَجُ النَّارِ  ثُمَّ أَمَرَ الْيَهُودَ أَنْ يَقُومُوا ، ثُمَّ قَامَ وَبَسَطَ يَمِينَهُ وَبَسَطَ أُصْبُعَهُ الشِّمَالَ ، ثُمَّ قَالَ : "" بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ ، هَذَا كِتَابٌ مِنَ اللهِ الرَّحْمَنِ الرَّحِيمِ بِأَسْمَاءِ أَهْلِ الْجَنَّةِ ، وَأَسْمَاءِ آبَائِهِمْ ، وَأُمَّهَاتِهِمْ ، وَعَشَائِرِهِمْ ، فَرَغَ رَبُّكُمْ ، فَرَغَ رَبُّكُمْ ، فَرَغَ رَبُّكُمْ ، أَعْذَرْتُ أَنْذَرْتُ ، اللَّهُمَّ إِنِّي قَدْ أَبْلَغْتُ  .","","Al-Mu'jam al-Kabir 198","","أنس بن مالك عن عبد الله بن يزيد بن آدم عن عبد الله بن خالد القرقساني البجلي عن علي بن ميمون الرقي عن الحسن بن علي بن شبيب المعمري عن الطبراني","عبد الله بن يزيد بن آدم عن واثلة"
"19691","مَعْرُوفٌ أَبُو الْخَطَّابِ  عَنْ  وَاثِلَةَ  199  -  حَدَّثَنَا  [ مُحَمَّدُ بْنُ إِدْرِيسَ بْنِ مُطَيَّبٍ الْمِصِّيصِيُّ ]  قَالَ :  ثَنَا  سُلَيْمُ بْنُ مَنْصُورِ بْنِ عَمَّارٍ ،  ثَنَا  أَبِي  ،  عَنْ  مَعْرُوفٍ أَبِي الْخَطَّابِ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ :  لَمَّا أَسْلَمْتُ أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ لِي :  اذْهَبْ فَاغْتَسِلْ بِمَاءٍ وَسِدْرٍ وَأَلْقِ عَنْكَ شَعَرَ الْكُفْرِ  .  في طبعة مكتبة ابن تيمية : ( محمد بن إدريس عن مطيب المصيصي ) ، والصواب ما أثبتناه كما في المعجم الصغير للمصنف ، وينظر ترجمته في إرشاد القاصي والداني إلى تراجم شيوخ الطبراني ، والله أعلم .","","Al-Mu'jam al-Kabir 199","","واثلة بن الأسقع الليثي عن معروف بن عبد الله الخياط عن منصور بن عمار  الخراساني عن سليم بن منصور بن عمار المروزي عن محمد بن إدريس بن مطيب المصيصي عن الطبراني","معروف أبو الخطاب عن واثلة"
"19692","[22/83]      200  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِدْرِيسَ بْنِ مُطَيَّبٍ  ، ثَنَا  سُلَيْمُ بْنُ مَنْصُورٍ ،  ثَنَا  أَبِي  ،  عَنْ  مَعْرُوفٍ ،  عَنْ  وَاثِلَةَ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ لِلْمَرْأَةِ الَّتِي تَكُونُ تَحْتَهُ : "" عَلَيْكِ  السَّكِينَةَ  وَالْوَقَارَ  .","","Al-Mu'jam al-Kabir 200","","واثلة بن الأسقع الليثي عن معروف بن عبد الله الخياط عن منصور بن عمار  الخراساني عن سليم بن منصور بن عمار المروزي عن محمد بن إدريس بن مطيب عن الطبراني","معروف أبو الخطاب عن واثلة"
"19693","جُنَاحٌ أَبُو مَرْوَانَ مَوْلَى الْوَلِيدِ بْنِ عَبْدِ الْمَلِكِ  عَنْ  وَاثِلَةَ  201  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلُ  ، ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، كِلَاهُمَا ،  عَنْ  عَنْبَسَةَ بْنِ سَعِيدٍ ،  عَنْ  حَمَّادٍ ، مَوْلَى بَنِي أُمَيَّةَ ،  عَنْ  جُنَاحٍ ، مَوْلَى الْوَلِيدِ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْوَلَدُ  لِلْفِرَاشِ  وَلِلْعَاهِرِ  الْحَجَرُ  ، وَلَيْسَ لِلْمَرْأَةِ أَنْ تَنْتَهِكَ شَيْئًا مِنْ مَالِهَا إِلَّا بِإِذْنِ زَوْجِهَا  .","","Al-Mu'jam al-Kabir 201","","واثلة بن الأسقع الليثي عن جناح الشامي عن حماد مولى بني أمية عن عنبسة بن سعيد الواسطي عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","جناح أبو مروان مولى الوليد بن عبد الملك عن واثلة"
"19694","202  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  سَعِيدُ بْنُ أَبِي الرَّبِيعِ السَّمَّانُ ،  ثَنَا  عَنْبَسَةُ بْنُ سَعِيدٍ ، (  ح  )  وَحَدَّثَنَا  عُبَيْدٌ الْعِجْلُ  ، ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ، (  ح  )         [22/84]      وَحَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ  ، ثَنَا  ابْنُ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، كِلَاهُمَا ،  عَنْ  عَنْبَسَةَ بْنِ سَعِيدٍ ،  عَنْ  حَمَّادٍ ، مَوْلَى بَنِي أُمَيَّةَ ،  عَنْ  جُنَاحٍ ، مَوْلَى الْوَلِيدِ ،  عَنْ  وَاثِلَةَ ، أَنَّهُ سَمِعَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  خَيْرُ شَبَابِكُمْ مَنْ تَشَبَّهَ بِكُهُولِكُمْ ، وَشَرُّ كُهُولِكُمْ مَنْ تَشَبَّهَ بِشَبَابِكُمْ  .","","Al-Mu'jam al-Kabir 202","","واثلة بن الأسقع الليثي عن جناح الشامي عن حماد مولى بني أمية عن عنبسة بن سعيد الواسطي عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","جناح أبو مروان مولى الوليد بن عبد الملك عن واثلة"
"19695","203  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلُ ، وَمُحَمَّدُ بْنُ مُحَمَّدِ بْنِ عُقْبَةَ الشَّيْبَانِيُّ قَالَا:  ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  ابْنُ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى كِلَاهُمَا  عَنْ  عَنْبَسَةَ بْنِ سَعِيدٍ ،  عَنْ  حَمَّادٍ ، مَوْلَى بَنِي أُمَيَّةَ ،  عَنْ  جُنَاحٍ ، مَوْلَى الْوَلِيدِ ،  عَنْ  وَاثِلَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْإِمَامُ  ضَامِنٌ ،  وَالْمُؤَذِّنُ  مُؤْتَمَنٌ ،  اللَّهُمَّ اغْفِرْ لِلْمُؤَذِّنِينَ وَاهْدِ الْأَئِمَّةَ  .","","Al-Mu'jam al-Kabir 203","","واثلة بن الأسقع الليثي عن جناح الشامي عن حماد مولى بني أمية عن عنبسة بن سعيد الواسطي عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","جناح أبو مروان مولى الوليد بن عبد الملك عن واثلة"
"19696","204  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلُ  ، ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ  ، ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، كِلَاهُمَا ،  عَنْ  عَنْبَسَةَ بْنِ سَعِيدٍ ،  عَنْ  حَمَّادٍ ، مَوْلَى بَنِي أُمَيَّةَ ،  عَنْ  جُنَاحٍ ، مَوْلَى الْوَلِيدِ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ مُسْلِمٍ وَلِيَ مِنْ أَمْرِ الْمُسْلِمِينَ شَيْئًا إِلَّا بَعَثَ اللهُ إِلَيْهِ مَلَكَيْنِ  يُسَدِّدَانِهِ  مَا تَوَلَّى الْحَقَّ  ، فَإِذَا نَوَى الْجَوْرَ عَلَى عَمْدٍ وَكَلَاهُ إِلَى نَفْسِهِ  .","","Al-Mu'jam al-Kabir 204","","واثلة بن الأسقع الليثي عن جناح الشامي عن حماد مولى بني أمية عن عنبسة بن سعيد بن الضريس عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","جناح أبو مروان مولى الوليد بن عبد الملك عن واثلة"
"19697","[22/85]      205  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلُ  ، ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ  ، ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، كِلَاهُمَا  عَنْ  عَنْبَسَةَ بْنِ سَعِيدٍ ،  عَنْ  حَمَّادٍ ، مَوْلَى بَنِي أُمَيَّةَ ،  عَنْ  جُنَاحٍ ، مَوْلَى الْوَلِيدِ ،  عَنْ  وَاثِلَةَ قَالَ :  لَعَنَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمُخَنَّثِينَ مِنَ الرِّجَالِ ، وَالْمُتَرَجِّلَاتِ مِنَ النِّسَاءِ  ، وَقَالَ : "" أَخْرِجُوهُمْ مِنْ بُيُوتِكُمْ "" فَأَخْرَجَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْحَبَشَةَ وَأَخْرَجَ  عُمَرُ  فُلَانًا  .","","Al-Mu'jam al-Kabir 205","","واثلة بن الأسقع الليثي عن جناح الشامي عن حماد مولى بني أمية عن عنبسة بن سعيد الواسطي عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","جناح أبو مروان مولى الوليد بن عبد الملك عن واثلة"
"19698","206  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلُ  ، ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  عَنْ  عَنْبَسَةَ بْنِ سَعِيدٍ ،  عَنْ  حَمَّادٍ ، مَوْلَى بَنِي أُمَيَّةَ ،  عَنْ  جُنَاحٍ ، مَوْلَى الْوَلِيدِ بْنِ عَبْدِ الْمَلِكِ قَالَ :  سَمِعْتُ  أَنَّ وَاثِلَةَ بْنَ الْأَسْقَعِ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ لِامْرَأَةٍ أَنْ تَنْتَهِكَ مِنْ مَالِهَا شَيْئًا إِلَّا بِإِذْنِ زَوْجِهَا إِذَا مَلَكَ عِصْمَتَهَا  .","","Al-Mu'jam al-Kabir 206","","واثلة بن الأسقع الليثي عن جناح الشامي عن حماد مولى بني أمية عن عنبسة بن سعيد الواسطي عن يزيد بن هارون عن الحسن بن علي الريحاني عن عبيد العجل عن الطبراني","جناح أبو مروان مولى الوليد بن عبد الملك عن واثلة"
"19699","207  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ أَبُو عَبْدِ الْمَلِكِ الدِّمَشْقِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ الْعَلَاءِ بْنِ زَبْرٍ قَالَ :  حَدَّثَنِي  أَبِي  (  ح  ) ،  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  زَيْدُ بْنُ الْحُبَابِ ، (  ح  )         [22/86]      وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ أَحْمَدَ الْوَاسِطِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ الْعَلَاءِ بْنِ زَبْرٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَامِرٍ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَزَالُونَ بِخَيْرٍ مَا دَامَ فِيكُمْ مَنْ رَأَى مَنْ رَآنِي وَصَاحَبَنِي  .","","Al-Mu'jam al-Kabir 207","","واثلة بن الأسقع الليثي عن عبد الله بن عامر بن يزيد اليحصبي عن عبد الله بن العلاء بن زبر عن زيد بن الحباب العكلي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبد الله بن عامر اليحصبي عن واثلة"
"19700","سُلَيْمَانُ بْنُ حَيَّانَ الْعَدَوِيُّ  عَنْ  وَاثِلَةَ  208  -  حَدَّثَنَا  مُوسَى بْنُ عِيسَى بْنِ الْمُنْذِرِ الْحِمْصِيُّ قَالَ :  ثَنَا  مُحَمَّدُ بْنُ الْمُبَارَكِ الصُّورِيُّ قَالَ :  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ قَالَ :  ثَنَا  سُلَيْمَانُ بْنُ حَيَّانَ الْعَدَوِيُّ  قَالَ :  سَمِعْتُ  وَاثِلَةَ بْنَ الْأَسْقَعِ ، يَقُولُ :  كُنْتُ مِنْ  أَصْحَابِ الصُّفَّةِ  فَشَكَا أَصْحَابِي الْجُوعَ فَقَالُوا : يَا  وَاثِلَةُ  ، اذْهَبْ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَاسْتَطْعِمْ لَنَا ، فَأَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقُلْتُ : يَا رَسُولَ اللهِ ، إِنَّ أَصْحَابِي يَشْكُونَ الْجُوعَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يَا  عَائِشَةُ  هَلْ عِنْدَكِ مِنْ شَيْءٍ ؟ "" قَالَتْ : يَا رَسُولَ اللهِ ، مَا عِنْدِي إِلَّا فُتَاتُ خُبْزٍ قَالَ : "" هَاتِيهِ "" فَجَاءَتْ بِجِرَابٍ فَدَعَا رَسُولُ اللهِ بِصَحْفَةٍ ، فَأَفْرَغَ الْخُبْزَ فِي الصَّحْفَةِ ثُمَّ جَعَلَ يُصْلِحُ الثَّرِيدَ بِيَدَيْهِ ، وَهُوَ يَرْبُو حَتَّى امْتَلَأَتِ الصَّحْفَةُ فَقَالَ :  يَا  وَاثِلَةُ  ، اذْهَبْ فَجِئْ بِعَشَرَةٍ مِنْ أَصْحَابِكَ ، وَأَنْتَ عَاشِرُهُمْ  فَذَهَبْتُ فَجِئْتُ بِعَشَرَةٍ مِنْ أَصْحَابِي وَأَنَا عَاشِرُهُمْ ، فَقَالَ : "" اجْلِسُوا خُذُوا بِسْمِ اللهِ ، خُذُوا مِنْ حَوَالَيْهَا ، وَلَا تَأْخُذُوا مِنْ أَعْلَاهَا فَإِنَّ الْبَرَكَةَ تَنْحَدِرُ مِنْ أَعْلَاهَا "" فَأَكَلُوا حَتَّى شَبِعُوا ، ثُمَّ قَامُوا وَفِي الصَّحْفَةِ مِثْلُ مَا كَانَ فِيهَا ، ثُمَّ جَعَلَ يُصْلِحُهَا بِيَدِهِ ، وَهِيَ تَرْبُو حَتَّى امْتَلَأَتْ ، فَقَالَ :         [22/87]      "" يَا  وَاثِلَةُ  ، اذْهَبْ فَجِئْ بِعَشَرَةٍ مِنْ أَصْحَابِكَ "" فَجِئْتُ بِعَشَرَةٍ فَقَالَ : "" اجْلِسُوا "" فَجَلَسُوا فَأَكَلُوا حَتَّى شَبِعُوا ، ثُمَّ قَامُوا فَقَالَ : "" اذْهَبْ فَجِئْ بِعَشَرَةٍ مِنْ أَصْحَابِكَ "" فَذَهَبْتُ فَجِئْتُ بِعَشَرَةٍ ، فَفَعَلُوا مِثْلَ ذَلِكَ ، فَقَالَ : "" هَلْ بَقِيَ أَحَدٌ ؟ قُلْتُ : نَعَمْ عَشَرَةٌ ، قَالَ : "" اذْهَبْ فَجِئْ بِهِمْ "" فَذَهَبْتُ فَجِئْتُ بِهِمْ ، فَقَالَ : "" اجْلِسُوا "" فَجَلَسُوا فَأَكَلُوا حَتَّى شَبِعُوا ، ثُمَّ قَامُوا وَبَقِيَ فِي الصَّحْفَةِ مِثْلُ مَا كَانَ ، ثُمَّ قَالَ : "" يَا  وَاثِلَةُ  ، اذْهَبْ بِهَذَا إِلَى  عَائِشَةَ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( العذري )","","Al-Mu'jam al-Kabir 208","","واثلة بن الأسقع الليثي عن سليمان بن حيان العذري عن إسماعيل بن عياش الأحول عن محمد بن المبارك القلانسي عن موسى بن عيسى بن المنذر الحمصي عن الطبراني","سليمان بن حيان العدوي عن واثلة"
"19701","حَيَّانُ أَبُو النَّضْرِ  عَنْ  وَاثِلَةَ  209  -  حَدَّثَنَا  أَحْمَدُ بْنُ خُلَيْدٍ الْحَلَبِيُّ  ، ثَنَا  أَبُو تَوْبَةَ الرَّبِيعُ بْنُ نَافِعٍ ،  ثَنَا  مُحَمَّدُ بْنُ مُهَاجِرٍ ،  عَنْ  يَزِيدَ بْنِ عَبِيدَةَ ،  عَنْ  حَيَّانَ أَبِي النَّضْرِ  قَالَ  : لَقِيتُ وَاثِلَةَ بْنَ الْأَسْقَعِ ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  قَالَ اللهُ عَزَّ وَجَلَّ : أَنَا عِنْدَ ظَنِّ عَبْدِي بِي ، إِنْ ظَنَّ خَيْرًا ، وَإِنْ ظَنَّ شَرًّا  .","","Al-Mu'jam al-Kabir 209","","واثلة بن الأسقع الليثي عن حيان أبو النضر الأسدي عن يزيد بن عبيدة بن أبي المهاجر السكوني عن محمد بن مهاجر بن أبي مسلم عن الربيع بن نافع الحلبي عن أحمد بن خليد بن يزيد الحلبي عن الطبراني","حيان أبو النضر عن واثلة"
"19702","210  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ قَالَ :  ثَنَا  أَبُو الْمُغِيرَةِ ،  ثَنَا  هِشَامُ بْنُ الْغَازِ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ قَالَ :  ثَنَا  الْمُبَارَكُ ،  عَنْ  هِشَامِ بْنِ الْغَازِ ،  عَنْ  حَيَّانَ أَبِي النَّضْرِ قَالَ :  سَمِعْتُ  وَاثِلَةَ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قَالَ اللهُ عَزَّ وَجَلَّ :  أَنَا عِنْدَ ظَنِّ عَبْدِي بِي فَلْيَظُنَّ بِي مَا شَاءَ  .","","Al-Mu'jam al-Kabir 210","","واثلة بن الأسقع الليثي عن حيان أبو النضر الأسدي عن هشام بن الغاز الجرشي عن عبد الله بن المبارك عن عبد الله بن محمد بن أسماء الضبعي عن معاذ بن المثنى العنبري عن الطبراني","حيان أبو النضر عن واثلة"
"19703","[22/88]      211  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ الطَّبَرَانِيُّ  ، ثَنَا  صَفْوَانُ بْنُ صَالِحٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنِ  الْوَلِيدِ بْنِ سُلَيْمَانَ بْنِ أَبِي السَّائِبِ قَالَ :  سَمِعْتُ  حَيَّانَ أَبَا النَّضْرِ  يُحَدِّثُ عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ  قَالَ :  سَمِعْتُ  وَاثِلَةَ بْنَ الْأَسْقَعِ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  قَالَ اللهُ عَزَّ وَجَلَّ :  أَنَا عِنْدَ ظَنِّ عَبْدِي بِي ، فَلْيَظُنَّ عَبْدِي مَا شَاءَ  .","","Al-Mu'jam al-Kabir 211","","واثلة بن الأسقع الليثي عن حيان أبو النضر الأسدي عن الوليد بن سليمان بن أبي السائب عن الوليد بن مسلم القرشي عن صفوان بن صالح الدمشقي عن هاشم بن مرثد الطيالسي عن الطبراني","حيان أبو النضر عن واثلة"
"19704","أَبُو سَعْدٍ الدِّمَشْقِيُّ  عَنْ  وَاثِلَةَ  212  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنْبَأَ  فَرَجُ بْنُ فَضَالَةَ ،  ثَنَا  أَبُو سَعْدٍ قَالَ :  رَأَيْتُ  وَاثِلَةَ بْنَ الْأَسْقَعِ دَخَلَ  مَسْجِدَ دِمَشْقَ  فَصَلَّى فِيهِ وَبَزَقَ تَحْتَ قَدَمِهِ الْيُسْرَى ، ثُمَّ عَرَكَهَا  ، فَلَمَّا انْصَرَفَ ، قُلْتُ لَهُ : أَتَبْزُقُ فِي الْمَسْجِدِ وَأَنْتَ مِنْ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : "" هَكَذَا رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَعَلَ  .","","Al-Mu'jam al-Kabir 212","","واثلة بن الأسقع الليثي عن أبو سعد الحميري عن فرج بن فضالة بن النعمان التنوخي عن عبد الله بن رجاء الغداني عن أبو مسلم الكجي عن الطبراني","أبو سعد الدمشقي عن واثلة"
"19705","بِشْرُ بْنُ حَيَّانَ  عَنْ  وَاثِلَةَ  213  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ، (  ح  )  وَحَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  الْهَيْثَمُ بْنُ خَارِجَةَ ، (  ح  )  وَحَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ قَالُوا :  ثَنَا         [22/89]      الْحَسَنُ بْنُ يَحْيَى الْخُشَنِيُّ ،  عَنْ  بِشْرِ بْنِ حَيَّانَ  قَالَ  :  أَتَانَا وَاثِلَةُ بْنُ الْأَسْقَعِ وَنَحْنُ نَبْنِي مَسْجِدًا فَوَقَفَ عَلَيْنَا فَسَلَّمَ ، ثُمَّ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ بَنَى لِلهِ مَسْجِدًا يُصَلَّى فِيهِ بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ أَفْضَلَ مِنْهُ  .","","Al-Mu'jam al-Kabir 213","","واثلة بن الأسقع الليثي عن بشر بن حيان الخشني عن الحسن بن يحيى الخشني عن سليمان بن عبد الرحمن التميمي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","بشر بن حيان عن واثلة"
"19706","يُونُسُ بْنُ مَيْسَرَةَ بْنِ حَلْبَسٍ  عَنْ  وَاثِلَةَ  214  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ، (  ح  )  وَحَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ الدِّمَشْقِيُّ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ، (  ح  )  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ أَحْمَدَ الْوَاسِطِيُّ قَالُوا :  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  مَرْوَانُ بْنُ جَنَاحٍ قَالَ :  سَمِعْتُ  يُونُسَ بْنَ مَيْسَرَةَ بْنِ حَلْبَسٍ ، يَقُولُ :  سَمِعْتُ  وَاثِلَةَ بْنَ الْأَسْقَعِ يَقُولُ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ فِي صَلَاتِهِ عَلَى  رَجُلٍ  مِنَ الْمُسْلِمِينَ :  اللَّهُمَّ إِنَّ فُلَانًا فِي ذِمَّتِكَ ،  وَحَبْلِ  جِوَارِكَ فَقِهْ فِتْنَةَ الْقَبْرِ  ، وَعَذَابَ النَّارِ ، إِنَّكَ أَهْلُ الْوَفَاءِ وَالْحَقِّ ، اللَّهُمَّ اغْفِرْ لَهُ وَارْحَمْهُ إِنَّكَ أَنْتَ الْغَفُورُ الرَّحِيمُ  .","","Al-Mu'jam al-Kabir 214","","واثلة بن الأسقع الليثي عن يونس بن ميسرة بن حلبس الجبلاني عن مروان بن جناح الدمشقي عن الوليد بن مسلم القرشي عن سليمان بن أحمد الدمشقي عن أبو مسلم الكجي عن الطبراني","يونس بن ميسرة بن حلبس عن واثلة"
"19707","215  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ السَّمَيْدَعِ الْأَنْطَاكِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الْمُبَارَكِ الصُّورِيُّ قَالَا :  ثَنَا  عَمْرُو بْنُ وَاقِدٍ ،  عَنْ  يُونُسَ بْنِ مَيْسَرَةَ بْنِ حَلْبَسٍ قَالَ :  دَخَلْنَا عَلَى  يَزِيدَ         [22/90]      بْنِ الْأَسْوَدِ  عَائِدِينَ ، فَدَخَلَ عَلَيْهِ وَاثِلَةُ بْنُ الْأَسْقَعِ ، فَلَمَّا نَظَرَ إِلَيْهِ مَدَّ يَدَهُ فَمَسَحَ بِهَا وَجْهَهُ وَصَدْرَهُ ، وَقَدْ بَايَعَ بِهَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فَقَالَ  وَاثِلَةُ  :  كَيْفَ ظَنُّكَ بِرَبِّكَ ؟ قَالَ : حَسَنٌ ، قَالَ : فَأَبْشِرْ  ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : إِنَّ اللهَ يَقُولُ :  أَنَا عِنْدَ ظَنِّ عَبْدِي إِنْ خَيْرٌ فَخَيْرٌ ، وَإِنْ شَرٌّ فَشَرٌّ  .","","Al-Mu'jam al-Kabir 215","","واثلة بن الأسقع الليثي عن يونس بن ميسرة بن حلبس الجبلاني عن عمرو بن واقد القرشي عن محمد بن المبارك القلانسي عن الحسين بن السميدع البجلي عن الطبراني","يونس بن ميسرة بن حلبس عن واثلة"
"19708","عَبْدُ الرَّحْمَنِ بْنُ أَبِي قَسِيمَةَ  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ  216  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى ، وَإِسْحَاقُ بْنُ أَبِي حَسَّانَ الْأَنْمَاطِيُّ قَالَا :  أَنَا  هِشَامُ بْنُ عَمَّارٍ قَالَ :  ثَنَا  عُمَرُ بْنُ الدَّرَفْسِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي قَسِيمَةَ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ ،  أَنَّهُ حَدَّثَهُ  قَالَ :  كُنْتُ فِي  الصُّفَّةِ  وَهُمْ عِشْرُونَ رَجُلًا فَأَصَابَنَا جُوعٌ ، وَكُنْتُ أَحْدَثَ  الْقَوْمِ  سِنًّا فَبَعَثُونِي إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَشْكُو إِلَيْهِ جُوعَهُمْ ، فَالْتَفَتَ فِي بَيْتِهِ فَقَالَ : "" هَلْ مِنْ شَيْءٍ ؟ قَالُوا : نَعَمْ ، هَاهُنَا كِسْرَةٌ وَشَيْءٌ مِنْ لَبَنٍ ، قَالَ : "" ائْتِنِي بِهِ "" فَفَتَّ الْكِسْرَةَ فَتًّا رَقِيقًا ، ثُمَّ صَبَّ عَلَيْهَا اللَّبَنَ ، ثُمَّ حَمَلَهُ بِيَدِهِ حَتَّى جَعَلَهُ كَالثَّرِيدِ ، ثُمَّ قَالَ :  يَا  وَاثِلَةُ  ، ادْعُ لِيَ عَشَرَةً مِنْ أَصْحَابِكَ وَخَلِّفْ عَشَرَةً  فَفَعَلْتُ ، ثُمَّ قَالَ : "" اجْلِسُوا بِسْمِ اللهِ "" فَجَلَسُوا فَأَخَذَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِرَأْسِ الثَّرِيدِ وَقَالَ : "" كُلُوا مِنْ حَوَالَيْهَا بِسْمِ اللهِ ، إِنَّ الْبَرَكَةَ تَأْتِيهَا مِنْ فَوْقِهَا وَلِأَنَّهَا تُمَدُّ "" قَالَ : فَرَأَيْتُهُمْ يَأْكُلُونَ يَتَخَلَّلُونَ أَصَابِعَهُمْ حَتَّى ثَمِلُوا شِبَعًا ، فَلَمَّا انْتَهَوْا قَالَ لَهُمُ : "" انْصَرِفُوا إِلَى مَكَانِكُمْ فَابْعَثُوا إِلَيَّ أَصْحَابَكُمْ "" فَقُمْتُ مُتَعَجِّبًا لِمَا رَأَيْتُ ، فَأَقْبَلَ         [22/91]      عَلَى الْعَشَرَةِ فَأَمَرَهُمْ بِمِثْلِ ذَلِكَ فَأَكَلُوا حَتَّى ثَمِلُوا شِبَعًا ، وَإِنَّ فِيهَا لَفَضْلَةً  .","","Al-Mu'jam al-Kabir 216","","واثلة بن الأسقع الليثي عن عبد الرحمن بن أبي قسيمة الحجري عن عمر بن الدرفس الغساني عن هشام بن عمار عن إسحاق بن إبراهيم بن أبي حسان الأنماطي عن الطبراني","عبد الرحمن بن أبي قسيمة عن واثلة بن الأسقع"
"19709","أَبُو سِبَاعٍ  عَنْ  وَاثِلَةَ  217  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ قَالَ :  ثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ قَالَا :  ثَنَا  هَاشِمُ بْنُ الْقَاسِمِ ،  ثَنَا  أَبُو جَعْفَرٍ الرَّازِيُّ ،  عَنْ  يَزِيدَ بْنِ أَبِي مَالِكٍ قَالَ :  أَخْبَرَنَا  أَبُو سِبَاعٍ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  لَا يَحِلُّ لِأَحَدٍ بَيْعُ شَيْءٍ لَا يُبَيِّنُ مَا فِيهِ  .","","Al-Mu'jam al-Kabir 217","","واثلة بن الأسقع الليثي عن أبو سباع عن يزيد بن عبد الرحمن بن أبي مالك عن عيسى بن أبي عيسى الرازي عن هاشم بن القاسم بن مسلم عن يعقوب بن إبراهيم بن كثير عن أحمد بن يحيى بن زهير التستري عن الطبراني","أبو سباع عن واثلة"
"19710","الْغَرِيفُ بْنُ الدَّيْلَمِيِّ  عَنْ  وَاثِلَةَ  218  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ  ، ثَنَا  مَهْدِيُّ بْنُ جَعْفَرٍ الرَّمْلِيُّ ،  ثَنَا  ضَمْرَةُ بْنُ رَبِيعَةَ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  إِبْرَاهِيمَ بْنِ أَبِي عَبْلَةَ ،  عَنِ  الْغَرِيفِ يَعْنِي رَجُلًا مِنْ آلِ ابْنِ الدَّيْلَمِيِّ قَالَ :  أَتَيْنَا  وَاثِلَةَ بْنَ الْأَسْقَعِ صَاحِبَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قُلْنَا : حَدِّثْنَا عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِحَدِيثٍ لَيْسَ فِيهِ زِيَادَةٌ وَلَا نُقْصَانٌ ، فَغَضِبَ وَقَالَ :  إِنَّ أَحَدَكُمْ لَيَقْرَأُ وَمُصْحَفُهُ مُعَلَّقٌ فِي بَيْتِهِ فَيَزِيدُ وَيَنْقُصُ  ، فَقُلْنَا : إِنَّمَا أَرَدْنَا أَنْ تُحَدِّثَنَا عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَيْسَ بَيْنَكَ وَبَيْنَهُ أَحَدٌ  قَالَ : أَتَيْنَا رَسُولَ         [22/92]      اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي صَاحِبٍ لَنَا قَدْ أَوْجَبَ فَقَالَ :  أَعْتِقُوا عَنْهُ  يُعْتِقِ  اللهُ بِكُلِّ عُضْوٍ مِنْهُ عُضْوًا مِنَ النَّارِ  .  هَكَذَا حَدَّثَنَاهُ  ابْنُ أَيُّوبَ الْعَلَّافُ  ، عَنْ  مَهْدِيِّ بْنِ جَعْفَرٍ  ، عَنْ  ضَمْرَةَ  ، عَنِ  الْأَوْزَاعِيِّ  ، عَنْ  إِبْرَاهِيمَ بْنِ أَبِي عَبْلَةَ  مِنْ أَصْلِ كِتَابِهِ .","","Al-Mu'jam al-Kabir 218","","واثلة بن الأسقع الليثي عن الغريف بن عياش بن فيروز الديلمي عن إبراهيم بن أبي عبلة عن أبو عمرو الأوزاعي عن ضمرة بن ربيعة الفلسطيني عن مهدي بن جعفر بن جيهان الرملي عن يحيى بن أيوب العلاف عن الطبراني","الغريف بن الديلمي عن واثلة"
"19711","219  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ،  ثَنَا  مَهْدِيُّ بْنُ جَعْفَرٍ الرَّمْلِيُّ ،  ثَنَا  ضَمْرَةُ بْنُ رَبِيعَةَ ،  عَنْ  إِبْرَاهِيمَ بْنِ أَبِي عَبْلَةَ ،  عَنِ  الْغَرِيفِ بْنِ الدَّيْلَمِيِّ قَالَ :  أَتَيْنَا  وَاثِلَةَ بْنَ الْأَسْقَعِ  ،  فَذَكَرَ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَحْوَهُ ، وَلَمْ يَذْكُرِ  الْأَوْزَاعِيَّ  .","","Al-Mu'jam al-Kabir 219","","واثلة بن الأسقع الليثي عن الغريف بن عياش بن فيروز الديلمي عن إبراهيم بن أبي عبلة عن ضمرة بن ربيعة الفلسطيني عن مهدي بن جعفر بن جيهان الرملي عن محمد بن علي بن زيد الصائغ عن الطبراني","الغريف بن الديلمي عن واثلة"
"19712","220  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ ،  ثَنَا  أَبُو مُسْهِرٍ ،  ثَنَا  يَحْيَى بْنُ حَمْزَةَ ،  حَدَّثَنِي  إِبْرَاهِيمُ بْنُ أَبِي عَبْلَةَ ،  حَدَّثَنِي  الْغَرِيفُ بْنُ عَيَّاشِ بْنِ فَيْرُوزَ الدَّيْلَمِيُّ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ :  خَرَجْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  غَزَاةِ تَبُوكَ  ، فَجَاءَ نَاسٌ مِنْ  بَنِي سُلَيْمٍ  فَقَالُوا : يَا رَسُولَ اللهِ ، إِنَّ صَاحِبًا لَنَا قَدْ  أَوْجَبَ  قَالَ :  فَلْيُعْتِقْ  عَنْهُ رَقَبَةٌ يَفُكَّ اللهُ بِكُلِّ عُضْوٍ مِنْهُ عُضْوًا مِنْهُ مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 220","","واثلة بن الأسقع الليثي عن الغريف بن عياش بن فيروز الديلمي عن إبراهيم بن أبي عبلة عن يحيى بن حمزة بن البتلهي عن عبد الأعلى بن مسهر الغساني عن أبو زرعة الدمشقي عن الطبراني","الغريف بن الديلمي عن واثلة"
"19713","221  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  ثَنَا  إِبْرَاهِيمُ بْنُ أَبِي عَبْلَةَ ،  ثَنَا  الْغَرِيفُ بْنُ عَيَّاشِ بْنِ فَيْرُوزَ الدَّيْلَمِيُّ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ :  أَنَّ نَفَرًا مِنْ  بَنِي سُلَيْمٍ  أَتَوْا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالُوا : إِنَّ صَاحِبًا لَنَا قَدْ  أَوْجَبَ  قَالَ :  فَلْيُعْتِقْ  عَنْهُ رَقَبَةٌ يَفُكَّ اللهُ بِكُلِّ عُضْوٍ مِنْهَا عُضْوًا مِنْهُ مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 221","","واثلة بن الأسقع الليثي عن الغريف بن عياش بن فيروز الديلمي عن إبراهيم بن أبي عبلة عن عبد الله بن المبارك عن العباس بن الوليد النرسي عن عبد الله بن أحمد بن حنبل عن الطبراني","الغريف بن الديلمي عن واثلة"
"19714","222  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  عَمْرُو بْنُ مُحَمَّدٍ         [22/93]      النَّاقِدُ ،  ثَنَا  مَعْمَرُ بْنُ سُلَيْمَانَ الرَّقِّيُّ ،  ثَنَا  زَيْدُ بْنُ حَبَّانَ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  عَبْدَةَ بْنِ أَبِي لُبَابَةَ ،  عَنْ  فَيْرُوزَ الدَّيْلَمِيِّ ،  عَنِ  الْغَرِيفِ بْنِ عَيَّاشٍ  ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا رَسُولَ اللهِ ، مَا تَقُولُ فِي رَجُلٍ قَدْ أَوْجَبَ ؟ يَعْنِي النَّارَ ، فَقَالَ :  يُعْتِقُ  رَقَبَةً فَإِنَّهُ يَفْدِي كُلُّ عُضْوٍ مِنْهَا عُضْوًا مِنْهُ مِنَ النَّارِ  .  كذا في طبعة مكتبة ابن تيمية والنسخة الخطية ، ولعل الإسناد فيه قلب ؛ فإن فيروز الديلمي جد الغريف ويروي الغريف عنه وعن واثلة ، والله أعلم .","","Al-Mu'jam al-Kabir 222","","واثلة بن الأسقع الليثي عن الغريف بن عياش بن فيروز الديلمي عن فيروز الديلمي عن عبدة بن أبي لبابة عن حجاج بن أرطاة عن زيد بن حبان الرقي عن معمر بن سليمان النخعي عن عمرو بن محمد بن بكير عن عبد الله بن أحمد بن حنبل عن الطبراني","الغريف بن الديلمي عن واثلة"
"19715","223  -  حَدَّثَنَا  الْوَلِيدُ بْنُ حَمَّادٍ الرَّمْلِيُّ  ، ثَنَا  يَزِيدُ بْنُ خَالِدِ بْنِ مُرْسَلٍ قَالَ :  ثَنَا  رُدَيْحُ بْنُ عَطِيَّةَ ،  عَنْ  إِبْرَاهِيمَ بْنِ أَبِي عَبْلَةَ ،  عَنِ  الْغَرِيفِ بْنِ الدَّيْلَمِيِّ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ :  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَفَرٌ مِنْ  بَنِي سُلَيْمٍ  ، فَقَالُوا : يَا رَسُولَ اللهِ ، إِنَّا نُصِيبُ سَبَايَا وَإِنَّا  نَعْزِلُ  عَنْهُنَّ ، قَالَ : "" وَإِنَّكُمْ لَتَفْعَلُونَ "" قَالُوا : نَعَمْ ، قَالَ :  مَا مِنْ  نَسَمَةٍ  أَرَادَ اللهُ أَنْ تَخْرُجَ مِنْ صُلْبِ رَجُلٍ إِلَّا وَهِيَ خَارِجَةٌ  ، إِنْ شَاءَ وَإِنْ أَبَى ، فَلَا عَلَيْكُمْ أَنْ لَا تَفْعَلُوا  .","","Al-Mu'jam al-Kabir 223","","واثلة بن الأسقع الليثي عن الغريف بن عياش بن فيروز الديلمي عن إبراهيم بن أبي عبلة عن رديح بن عطية الفلسطيني عن يزيد بن خالد بن مرشل اليافي عن الوليد بن حماد بن جابر الزيات عن الطبراني","الغريف بن الديلمي عن واثلة"
"19716","عَبْدُ الْأَعْلَى بْنُ هِلَالٍ الْحِمْصِيُّ  عَنْ  وَاثِلَةَ  224  -  حَدَّثَنَا  أَبُو حَنِيفَةَ مُحَمَّدُ بْنُ حَنِيفَةَ الْوَاسِطِيُّ قَالَ :  ثَنَا  عَمِّي  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ مَاهَانَ بْنِ أَبِي حَنِيفَةَ ،  ثَنَا  أَبِي  ،  ثَنَا  طَلْحَةُ بْنُ زَيْدٍ ،  عَنْ  يُونُسَ بْنِ يَزِيدَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَبْدِ الْأَعْلَى بْنِ هِلَالٍ الْحِمْصِيِّ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ  أَفْرَى  الْفِرَى مَنِ  ادَّعَى  إِلَى غَيْرِ أَبِيهِ  ، أَوْ كَذَبَ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَوْ كَذَبَ عَلَى عَيْنَيْهِ  .","","Al-Mu'jam al-Kabir 224","","واثلة بن الأسقع الليثي عن عبد الأعلى بن هلال السلمي عن الزهري عن يونس بن يزيدالأيلي عن طلحة بن زيد الرقي عن محمد بن ماهان القصباني عن أحمد بن أبي حنيفة محمد بن ماهان عن محمد بن حنيفة القصبى عن الطبراني","عبد الأعلى بن هلال الحمصي عن واثلة"
"19717","[22/94]      عِيسَى بْنُ سِنَانٍ أَبُو سِنَانٍ  عَنْ  وَاثِلَةَ  225  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ الْحِمْصِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ،  ثَنَا  بَقِيَّةُ ،  عَنْ  أَبِي مُحَمَّدٍ عِيسَى بْنِ سِنَانٍ ،  عَنْ  وَاثِلَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ رَجُلٍ يَأْتِي  كَاهِنًا  فَيَسْأَلُهُ إِلَّا  حُجِبَتْ  مِنْهُ التَّوْبَةُ أَرْبَعِينَ لَيْلَةً  ، فَإِنْ هُوَ آمَنَ بِمَا يَقُولُ فَقَدْ كَفَرَ بِاللهِ  .","","Al-Mu'jam al-Kabir 225","","واثلة بن الأسقع الليثي عن عيسى بن سنان القسملي عن بقية بن الوليد عن محمد بن مصفى بن بهلول عن إبراهيم بن محمد بن عرق الحمصي عن الطبراني","عيسى بن سنان أبو سنان عن واثلة"
"19718","يَحْيَى بْنُ الْحَارِثِ الذِّمَارِيُّ  عَنْ  وَاثِلَةَ  226  -  حَدَّثَنَا  مُحَمَّدُ بْنُ هَارُونَ بْنِ مُحَمَّدِ بْنِ بَكَّارٍ الدِّمَشْقِيُّ  ، ثَنَا  مَحْمُودُ بْنُ خَالِدٍ ،  ثَنَا  مَرْوَانُ بْنُ مُحَمَّدٍ الطَّاطَرِيُّ ،  ثَنَا  أَبُو عَبْدِ الْمَلِكِ الْفَزَارِيُّ ،  حَدَّثَنِي  يَحْيَى بْنُ الْحَارِثِ الذِّمَارِيُّ قَالَ :  لَقِيتُ  وَاثِلَةَ بْنَ الْأَسْقَعِ ، فَقُلْتُ : بَايَعْتَ بِيَدِكَ هَذِهِ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" نَعَمْ  ، فَقُلْتُ : أَعْطِنِي يَدَكَ أُقَبِّلْهَا فَأَعْطَانِيهَا فَقَبَّلْتُهَا  .","","Al-Mu'jam al-Kabir 226","","واثلة بن الأسقع الليثي عن يحيى بن الحارث الذماري عن أبو عبد الملك الفزاري عن مروان بن محمد الطاطري عن محمود بن خالد بن أبي خالد السلمي عن محمد بن هارون بن محمد الدمشقي عن الطبراني","يحيى بن الحارث الذماري عن واثلة"
"19719","الْقَاسِمُ أَبُو عَبْدِ الرَّحْمَنِ  عَنْ  وَاثِلَةَ  227  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ قَالَ :  ثَنَا  عَلِيُّ بْنُ مَيْمُونٍ الرَّقِّيُّ ،  ثَنَا  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  عُمَرَ بْنِ مُوسَى ،  عَنِ  الْقَاسِمِ ،  عَنْ  وَاثِلَةَ قَالَ :         [22/95]      قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ وُلِدَ لَهُ ثَلَاثَةُ أَوْلَادٍ لَمْ يُسَمِّ أَحَدَهُمْ مُحَمَّدًا فَقَدْ جَهِلَ  .","","Al-Mu'jam al-Kabir 227","","واثلة بن الأسقع الليثي عن القاسم بن عبد الرحمن الدمشقي عن عمر بن موسى بن الوجيه الميثمي عن عثمان بن عبد الرحمن الطرائفي عن علي بن ميمون الرقي عن الحسن بن علي بن شبيب المعمري عن الطبراني","القاسم أبو عبد الرحمن عن واثلة"
"19720","أَبُو الْأَسْوَدِ  عَنْ  وَاثِلَةَ  228  -  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ الْبَاقِي الْأَذَنِيُّ ،  ثَنَا  أَبُو عُمَيْرِ بْنِ النَّحَّاسِ قَالَ :  ثَنَا  الْفِرْيَابِيُّ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  وَاثِلَةَ قَالَ :  دَخَلَ  رَجُلٌ  الْمَسْجِدَ وَالنَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِيهِ وَحْدَهُ  فَتَزَحْزَحَ  لَهُ ،  فَقَالَ الرَّجُلُ : يَا رَسُولَ اللهِ ، إِنَّ الْمَكَانَ وَاسِعٌ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِنَّ لِلْمُسْلِمْ حَقًّا  .","","Al-Mu'jam al-Kabir 228","","واثلة بن الأسقع الليثي عن مجاهد بن فرقد الصنعاني عن محمد بن يوسف الفريابي عن عيسى بن محمد بن إسحاق عن يحيى بن عبد الباقي الثغري عن الطبراني","أبو الأسود عن واثلة"
"19721","الزُّهْرِيُّ  عَنْ  وَاثِلَةَ  229  -  حَدَّثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ النَّوْفَلِيُّ الْمَدَنِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  مَعْنُ بْنُ عِيسَى ،  ثَنَا  عَبْدُ اللهِ بْنُ يَحْيَى بْنِ عَطَاءِ بْنِ سُلَيْكٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  وَاثِلَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ مِنَّا مَنْ لَمْ يَرْحَمْ صَغِيرَنَا وَيُجِلُّ كَبِيرَنَا  .","","Al-Mu'jam al-Kabir 229","","واثلة بن الأسقع الليثي عن الزهري عن عبد الله بن يحيى بن عطاء بن سليك عن معن بن عيسى عن إبراهيم بن المنذر الحزامي عن جعفر بن سليمان النوفلي عن الطبراني","الزهري عن واثلة"
"19722","أَبُو الْأَزْهَرِ  عَنْ  وَاثِلَةَ  230  -  حَدَّثَنَا  أَحْمَدُ بْنُ خُلَيْدٍ الْحَلَبِيُّ  ، ثَنَا  أَبُو تَوْبَةَ الرَّبِيعُ         [22/96]      بْنُ نَافِعٍ ،  ثَنَا  يَزِيدُ بْنُ رَبِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي مَالِكٍ ،  عَنْ  أَبِي الْأَزْهَرِ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ :  خَرَجْتُ أَنَا أُرِيدُ  عَلِيًّا  ، فَقِيلَ لِي : هُوَ عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَمَمْتُ إِلَيْهِ فَأَجِدُهُمْ فِي حَظِيرَةٍ مِنْ قَصَبٍ وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَعَلِيٌّ  وَفَاطِمَةُ  وَحَسَنٌ  وَحُسَيْنٌ  قَدْ جَمَعَهُمْ تَحْتَ ثَوْبٍ فَقَالَ :  اللَّهُمَّ إِنَّكَ جَعَلْتَ صَلَوَاتِكَ وَرَحْمَتَكَ وَمَغْفِرَتَكَ وَرِضْوَانَكَ عَلَيَّ وَعَلَيْهِمْ  .","","Al-Mu'jam al-Kabir 230","","واثلة بن الأسقع الليثي عن أبو الأزهر عن يزيد بن عبد الرحمن بن أبي مالك عن يزيد بن ربيعة الرحبي عن الربيع بن نافع الحلبي عن أحمد بن خليد بن يزيد الحلبي عن الطبراني","أبو الأزهر عن واثلة"
"19723","سِنَانُ بْنُ أَبِي مَنْصُورٍ مَوْلَى وَاثِلَةَ  عَنْ  وَاثِلَةَ  231  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلُ قَالَ :  ثَنَا  إِسْمَاعِيلُ بْنُ عُبَيْدِ بْنِ أَبِي كَرِيمَةَ الْحَرَّانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي عَبْدِ الرَّحِيمِ قَالَ :  حَدَّثَنِي  أَبُو الْفَضْلِ ،  عَنْ  سِنَانٍ ، مَوْلَى وَاثِلَةَ قَالَ :  تُوُفِّيَ وَلَدُ  الرَّيَّانِ  وَشَهِدَهُ  وَاثِلَةُ  ، فَلَمَّا انْصَرَفُوا مِنَ الْمَقْبَرَةِ قَعَدَ  وَاثِلَةُ  عَلَى بَابِ  دِمَشْقَ  ، فَمَرَّ بِهِ  الرَّيَّانُ  ،  فَقَالَ  لَهُ وَاثِلَةُ :  يَا  أَبَا سَعِيدٍ  ، جَبَرَ اللهُ مُصِيبَتَكَ ، وَغَفَرَ لِمُتَوَّفَاكَ  ، قَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ دَفَنَ ثَلَاثَةً مِنَ الْوَلَدِ حَرَّمَ اللهُ عَلَيْهِ النَّارَ  .","","Al-Mu'jam al-Kabir 231","","واثلة بن الأسقع الليثي عن سنان بن أبى منصور الشامي عن أبو الفضل عن خالد بن يزيد الحراني عن محمد بن سلمة الباهلي عن إسماعيل بن عبيد بن عمر مولى عثمان بن عفان عن عبيد العجل عن الطبراني","سنان بن أبي منصور مولى واثلة عن واثلة"
"19724","أَسْمَاءُ بِنْتُ وَاثِلَةَ بْنِ الْأَسْقَعِ  عَنْ أَبِيهَا  232  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ قِيرَاطٍ الدِّمَشْقِيُّ قَالَ :  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ قَالَ :  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ الْمَقْدِسِيُّ قَالَ :  حَدَّثَتْنِي  أَسْمَاءُ بِنْتُ وَاثِلَةَ بْنِ الْأَسْقَعِ  قَالَتْ :  كَانَ أَبِي إِذَا صَلَّى الصُّبْحَ جَلَسَ مُسْتَقْبِلَ         [22/97]      الْقِبْلَةِ لَا يَتَكَلَّمُ حَتَّى تَطْلُعَ الشَّمْسُ  ، فَرُبَّمَا كَلَّمْتُهُ فِي الْحَاجَةِ فَلَا يُكَلِّمُنِي ، فَقُلْتُ : مَا هَذَا ؟  قَالَ  : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ صَلَّى الصُّبْحَ ، ثُمَّ قَرَأَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      مِائَةَ مَرَّةٍ  قَبْلَ أَنْ يَتَكَلَّمَ ، فَكُلَّمَا قَرَأَ "" قُلْ هُوَ اللهُ أَحَدٌ "" غُفِرَ لَهُ ذَنْبُ سَنَةٍ  .","","Al-Mu'jam al-Kabir 232","","واثلة بن الأسقع الليثي عن أسماء بنت واثلة بن الأسقع الليثية عن محمد بن عبد الرحمن البيروتي عن سليمان بن عبد الرحمن التميمي عن إسماعيل بن محمد بن عبيد الله العذري عن الطبراني","أسماء بنت واثلة بن الأسقع عن أبيها"
"19725","233  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ قِيرَاطٍ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ قَالَ :  حَدَّثَتْنَا  أَسْمَاءُ بِنْتُ وَاثِلَةَ  ،  عَنْ  أَبِيهَا ،  أَنَّهُ كَانَ يَصُومُ الِاثْنَيْنِ وَالْخَمِيسَ  وَيَقُولُ : كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَصُومُهُمَا وَيَقُولُ :  تُعْرَضُ فِيهِمَا الْأَعْمَالُ عَلَى اللهِ تَبَارَكَ وَتَعَالَى  .","","Al-Mu'jam al-Kabir 233","","واثلة بن الأسقع الليثي عن أسماء بنت واثلة بن الأسقع الليثية عن محمد بن عبد الرحمن البيروتي عن سليمان بن عبد الرحمن التميمي عن إسماعيل بن محمد بن عبيد الله العذري عن الطبراني","أسماء بنت واثلة بن الأسقع عن أبيها"
"19726","234  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ قِيرَاطٍ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ قَالَ :  حَدَّثَتْنِي  أَسْمَاءُ بِنْتُ وَاثِلَةَ ،  عَنْ  أَبِيهَا  قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الذَّهَبُ وَالْحَرِيرُ حِلٌّ لِإِنَاثِ أُمَّتِي  حَرَامٌ عَلَى ذُكُورِ أُمَّتِي  .","","Al-Mu'jam al-Kabir 234","","واثلة بن الأسقع الليثي عن أسماء بنت واثلة بن الأسقع الليثية عن محمد بن عبد الرحمن البيروتي عن سليمان بن عبد الرحمن التميمي عن إسماعيل بن محمد بن عبيد الله العذري عن الطبراني","أسماء بنت واثلة بن الأسقع عن أبيها"
"19727","خُصَيْلَةُ بِنْتُ وَاثِلَةَ  عَنْ أَبِيهَا  235  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ قَالَ :  حَدَّثَنَا  عَبْدُ الْوَهَّابِ بْنُ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  صَدَقَةَ بْنِ يَزِيدَ قَالَ :  حَدَّثَتْنِي  بِنْتُ         [22/98]      وَاثِلَةَ بْنِ الْأَسْقَعِ ،  عَنْ  أَبِيهَا  قَالَ :  قُلْتُ :  يَا رَسُولَ اللهِ ، الرَّجُلُ يُحِبُّ قَوْمَهُ ، أَعَصِبِيٌّ هُوَ ؟ قَالَ : "" لَا  قُلْتُ : مَنِ الْعَصَبِيُّ ؟ قَالَ : "" الَّذِي يُعِينُ قَوْمَهُ عَلَى الظُّلْمِ  .","","Al-Mu'jam al-Kabir 235","","واثلة بن الأسقع الليثي عن جميلة بنت واثلة بن الأسقع عن صدقة بن يزيد الدمشقي عن الوليد بن مسلم القرشي عن عبد الوهاب بن نجدة عن أحمد بن داود بن موسى السدوسي عن الطبراني","خصيلة بنت واثلة عن أبيها"
"19728","236  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مَحْمُودُ بْنُ خَالِدٍ الدِّمَشْقِيُّ قَالَ :  حَدَّثَتْنَا  خُصَيْلَةُ بِنْتُ وَاثِلَةَ بْنِ الْأَسْقَعِ أَنَّهَا  سَمِعَتْ  أَبَاهَا  ، يَقُولُ :  قُلْتُ :  يَا رَسُولَ اللهِ ، مَا  الْعَصَبِيَّةُ  ؟ قَالَ : "" أَنْ تُعِينَ قَوْمَكَ عَلَى الظُّلْمِ  "" .","","Al-Mu'jam al-Kabir 236","","واثلة بن الأسقع الليثي عن جميلة بنت واثلة بن الأسقع عن محمود بن خالد بن أبي خالد السلمي عن الحسين بن إسحاق التستري عن الطبراني","خصيلة بنت واثلة عن أبيها"
"19729","237  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى بْنُ خَالِدِ بْنِ حَيَّانَ الرَّقِّيُّ قَالَ :  ثَنَا  أَحْمَدُ بْنُ دَاوُدَ الصَّدَفِيُّ سَنَةَ ثَلَاثٍ وَثَلَاثِينَ وَمِائَتَيْنِ قَالَ :  حَدَّثَنِي  مُحَمَّدُ بْنُ الْأَشْقَرِ اللَّخْمِيُّ قَالَ :  حَدَّثَتْنِي  خُصَيْلَةُ بِنْتُ وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَتْ :  سَمِعْتُ  أَبِي  يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ مِنْ أَكْبَرِ الْكَبَائِرِ أَنْ يَقُولَ الرَّجُلُ عَلَيَّ مَا لَمْ أَقُلْ  .","","Al-Mu'jam al-Kabir 237","","واثلة بن الأسقع الليثي عن جميلة بنت واثلة بن الأسقع عن محمد بن الأشقر اللخمي عن أحمد بن داود البرلسي عن أحمد بن يحيى بن خالد الرقي عن الطبراني","خصيلة بنت واثلة عن أبيها"
"19730","238  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى بْنُ خَالِدِ بْنِ حَيَّانَ الرَّقِّيُّ ،  ثَنَا  أَحْمَدُ بْنُ دَاوُدَ الصَّدَفِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْأَشْقَرِ اللَّخْمِيُّ قَالَ :  حَدَّثَتْنِي  خُصَيْلَةُ بِنْتُ وَاثِلَةَ قَالَتْ :  سَمِعْتُ  أَبِي  ، يَقُولُ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ مِنْ أَكْبَرِ الْكَبَائِرِ أَنْ يَنْتَفِيَ الرَّجُلُ مِنْ وَلَدِهِ  .","","Al-Mu'jam al-Kabir 238","","واثلة بن الأسقع الليثي عن جميلة بنت واثلة بن الأسقع عن محمد بن الأشقر اللخمي عن أحمد بن داود البرلسي عن أحمد بن يحيى بن خالد الرقي عن الطبراني","خصيلة بنت واثلة عن أبيها"
"19731","239  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى ،  ثَنَا  أَحْمَدُ بْنُ دَاوُدَ ،  ثَنَا  مُحَمَّدُ بْنُ الْأَشْقَرِ قَالَ :  حَدَّثَتْنِي  خُصَيْلَةُ بِنْتُ وَاثِلَةَ ، قَالَتْ :  سَمِعْتُ  أَبِي  ، يَقُولُ :         {      قَدْ أَفْلَحَ مَنْ تَزَكَّى             *          وَذَكَرَ اسْمَ رَبِّهِ فَصَلَّى         }      إِلْقَاءُ  الْقَمْحِ  يَوْمَ الْفِطْرِ  قَبْلَ الصَّلَاةِ فِي الْمُصَلَّى  "" .","","Al-Mu'jam al-Kabir 239","","واثلة بن الأسقع الليثي عن جميلة بنت واثلة بن الأسقع عن محمد بن الأشقر اللخمي عن أحمد بن داود البرلسي عن أحمد بن يحيى بن خالد الرقي عن الطبراني","خصيلة بنت واثلة عن أبيها"
"19732","[22/99]      مَنِ اسْمُهُ  وَهْبٌ  وَهْبُ بْنُ عَبْدِ اللهِ أَبُو جُحَيْفَةَ السُّوَائِيُّ  عَوْنُ بْنُ أَبِي جُحَيْفَةَ  عَنْ أَبِيهِ  سِمَاكِ بْنِ حَرْبٍ  ، عَنْ  عَوْنٍ  240  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  عَنْ  زَائِدَةَ ، (  ح  )  وَحَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ قَالَ :  ثَنَا  زَائِدَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  ، قَالَ  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" صَلَاةَ الظُّهْرِ  بِمَكَّةَ  رَكْعَتَيْنِ  صَلَاةَ الْمُسَافِرِ  .","","Al-Mu'jam al-Kabir 240","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن سماك بن حرب البكري عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","سماك بن حرب عن عون"
"19733","أَبُو إِسْحَاقَ السَّبِيعِيُّ  ، عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  ، عَنْ أَبِيهِ  241  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ الْبَرَاءِ  ، ثَنَا  الْمُعَافَى بْنُ سُلَيْمَانَ ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنِ  ابْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى  بِالْأَبْطَحِ  صَلَاةَ الْعَصْرِ رَكْعَتَيْنِ  .","","Al-Mu'jam al-Kabir 241","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن المعافى بن سليمان الرسعني عن محمد بن أحمد بن البراء العبدي عن الطبراني","أبو إسحاق السبيعي عن عون بن أبي جحيفة عن أبيه"
"19734","مِسْعَرُ بْنُ كِدَامٍ  ، عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  ، عَنْ أَبِيهِ  242  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  خَلَّادُ بْنُ يَحْيَى ،  ثَنَا  مِسْعَرٌ ،  ثَنَا  عَوْنُ بْنُ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِالْأَبْطَحِ  بَيْنَ يَدَيْهِ  عَنَزَةٌ  ، أَوْ شَبِيهٌ  بِالْعَنَزَةِ  ، وَالطَّرِيقُ مِنْ وَرَائِهَا وَالْمَارَّةُ  .","","Al-Mu'jam al-Kabir 242","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن مسعر بن كدام عن خلاد بن يحيى الأرحبي عن بشر بن موسى بن صالح الأسدي عن الطبراني","مسعر بن كدام عن عون بن أبي جحيفة عن أبيه"
"19735","243  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا         [22/100]      وَكِيعٌ ،  عَنْ  مِسْعَرٍ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" صَلَّى إِلَى  الْعَنَزَةِ  وَالطَّرِيقُ مِنْ وَرَائِهَا  .","","Al-Mu'jam al-Kabir 243","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن مسعر بن كدام عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","مسعر بن كدام عن عون بن أبي جحيفة عن أبيه"
"19736","244  -  حَدَّثَنَا  أَبُو عَقِيلٍ أَنَسُ بْنُ سَالِمٍ الْخَوْلَانِيُّ ، وَأَحْمَدُ بْنُ خَالِدِ بْنِ مُسَرِّحٍ قَالَا :  ثَنَا  الْوَلِيدُ بْنُ عَبْدِ الْمَلِكِ بْنِ مُسَرِّحٍ الْحَرَّانِيُّ ،  ثَنَا  مَخْلَدُ بْنُ يَزِيدَ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  لَمَّا قَدِمَ  جَعْفَرٌ  عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ أَرْضِ  الْحَبَشَةِ  قَبَّلَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَا بَيْنَ عَيْنَيْهِ ثُمَّ قَالَ :  مَا أَدْرِي أَنَا بِقُدُومِ  جَعْفَرٍ  أُسَرُّ أَوْ  بِفَتْحِ خَيْبَرَ  .","","Al-Mu'jam al-Kabir 244","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن مسعر بن كدام عن مخلد بن يزيد الحراني عن الوليد بن عبد الملك الحراني عن أحمد بن خالد بن عبد الملك الحراني عن الطبراني","مسعر بن كدام عن عون بن أبي جحيفة عن أبيه"
"19737","إِدْرِيسُ بْنُ يَزِيدَ الْأَوْدِيُّ  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  245  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَمَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ قَالُوا :  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ قَالَ :  ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ ،  عَنْ  إِدْرِيسَ الْأَوْدِيِّ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  ،  أَنَّ  بِلَالًا  : كَانَ "" يُؤَذِّنُ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِصَوْتَيْنِ صَوْتَيْنِ  .","","Al-Mu'jam al-Kabir 245","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن إدريس بن يزيد الزعافري عن زياد بن عبد الله البكائي عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","إدريس بن يزيد الأودي عن عون بن أبي جحيفة"
"19738","[22/101]      246  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  زَكَرِيَّا بْنُ يَحْيَى ،  ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ ،  عَنْ  إِدْرِيسَ الْأَوْدِيِّ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  أَذَّنَ  بِلَالٌ  لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِمِنًى  مَثْنَى مَثْنَى  ، وَأَقَامَ مَثْنَى مَثْنَى  .","","Al-Mu'jam al-Kabir 246","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن إدريس بن يزيد الزعافري عن زياد بن عبد الله البكائي عن زكريا بن يحيى زحمويه عن عبد الله بن أحمد بن حنبل عن الطبراني","إدريس بن يزيد الأودي عن عون بن أبي جحيفة"
"19739","247  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ الْعَبَّاسِ الدُّورِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ نُوحٍ الرَّازِيُّ ،  ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ ،  عَنْ  إِدْرِيسَ الْأَوْدِيِّ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  أَتَيْنَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَحَضَرَتِ الصَّلَاةُ ، فَقَامَ  بِلَالٌ  فَأَذَّنَ فَجَعَلَ أُصْبُعَيْهِ فِي أُذُنَيْهِ ، وَجَعَلَ يَسْتَدِيرُ ، وَأُتِيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِوَضُوءٍ فَتَوَضَّأَ هُوَ وَأَصْحَابُهُ ، فَفَضَلَ مِنَ الْمَاءِ فَضْلَةٌ ، فَجَعَلْنَا نَبْتَدِرُ فَضْلَهُ ، ثُمَّ أَخْرَجَ  عَنَزَةً  فَرَكَزَهَا ، وَأَقَامَ الصَّلَاةَ فَصَلَّى إِلَيْهَا الظُّهْرَ رَكْعَتَيْنِ وَالْعَصْرَ رَكْعَتَيْنِ ، ثُمَّ قَالَ :  إِذَا قَدِمْتُ  الْمَدِينَةَ  فَأْتُونِي  وَكَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَعَلَ لَنَا شَيْئًا يُعْطِيَنَا ، فَسَلَّمَهُ لَنَا  أَبُو بَكْرٍ  رَضِيَ اللهُ عَنْهُ  .","","Al-Mu'jam al-Kabir 247","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن إدريس بن يزيد الزعافري عن زياد بن عبد الله البكائي عن محمد بن نوح القومسي عن الحسين بن العباس الدوري عن الطبراني","إدريس بن يزيد الأودي عن عون بن أبي جحيفة"
"19740","سُفْيَانُ الثَّوْرِيُّ  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  248  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ  بِلَالًا  يُؤَذِّنُ وَيَدُورُ فَأَتَتَبَّعُ فَاهُ هَاهُنَا وَهَاهُنَا وَأُصْبُعَاهُ فِي أُذُنَيْهِ  قَالَ : وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  قُبَّةٍ  لَهُ حَمْرَاءُ ، قَالَ : فَخَرَجَ  بِلَالٌ  بَيْنَ يَدَيْهِ  الْعَنَزَةُ  فَرَكَزَهَا         [22/102]      فِي  الْأَبْطَحِ  فَصَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَيْهَا الظُّهْرَ وَالْعَصْرَ ، يَمُرُّ بَيْنَ يَدَيْهِ الْكَلْبُ وَالْحِمَارُ وَالْمَرْأَةُ ، وَعَلَيْهِ  حُلَّةٌ  لَهُ حَمْرَاءُ كَأَنِّي أَنْظُرُ إِلَى بَرِيقِ سَاقَيْهِ  .","","Al-Mu'jam al-Kabir 248","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سفيان الثوري عن عون بن أبي جحيفة"
"19741","249  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِالْأَبْطَحِ  فَخَرَجَ  بِلَالٌ  فَأَذَّنَ ، فَكَأَنِّي أَنْظُرُ إِلَيْهِ  ، فَأَتَتَبَّعُ فَاهُ هَاهُنَا وَهَاهُنَا  يَعْنِي يَمِينًا وَشِمَالًا  ، وَأَخْرَجَ فَضْلَ وَضُوئِهِ ، فَبَيْنَ  نَائِلٍ  وَنَاضِحٍ  فَرَكَزَ  عَنَزَةً  ، فَخَرَجَ وَعَلَيْهِ  حُلَّةٌ  حَمْرَاءُ ، كَأَنِّي أَنْظُرُ إِلَى بَرِيقِ سَاقَيْهِ ، فَصَلَّى الظُّهْرَ وَالْعَصْرَ رَكْعَتَيْنِ حَتَّى رَجَعَ  .","","Al-Mu'jam al-Kabir 249","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن سفيان الثوري عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","سفيان الثوري عن عون بن أبي جحيفة"
"19742","250  -  حَدَّثَنَا  إِسْحَاقُ بْنُ جَمِيلٍ ،  ثَنَا  أَحْمَدُ بْنُ مَنِيعٍ ،  ثَنَا  إِسْحَاقُ الْأَزْرَقُ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  أَنَّ  بِلَالًا  أَخْرَجَ فَضْلَ وَضُوءِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَجَعَلَ النَّاسُ مِنْ  نَائِلٍ  وَنَاضِحٍ  حَتَّى جَعَلَ الصَّبِيُّ يُدْخِلُ يَدَهُ تَحْتَ آبَاطِ  الْقَوْمِ  يَتَصَبَّبُ  .","","Al-Mu'jam al-Kabir 250","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن سفيان الثوري عن إسحاق بن يوسف الأزرق عن أحمد بن منيع البغوي عن إسحاق بن إبراهيم الأصبهاني عن الطبراني","سفيان الثوري عن عون بن أبي جحيفة"
"19743","251  -  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى بْنُ حَسَّانَ الْكُوفِيُّ ،  ثَنَا  وَكِيعٌ ،  ثَنَا  سُفْيَانُ ، وَابْنُ أَبِي لَيْلَى ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  صَلَّيْتُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِمِنًى  رَكْعَتَيْنِ  ، ثُمَّ لَمْ يَزَلْ يُصَلِّي رَكْعَتَيْنِ حَتَّى رَجَعَ إِلَى  الْمَدِينَةِ  .","","Al-Mu'jam al-Kabir 251","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن محمد بن عبد الرحمن بن أبي ليلى عن وكيع بن الجراح عن يحيى بن حسان بن حيان التنيسي عن سعيد بن عبد الرحمن التستري عن الطبراني","سفيان الثوري عن عون بن أبي جحيفة"
"19744","252  -  حَدَّثَنَا  إِسْحَاقُ بْنُ جَمِيلٍ الْأَصْبَهَانِيُّ  ، ثَنَا  أَحْمَدُ بْنُ مَنِيعٍ ،  ثَنَا  إِسْحَاقُ الْأَزْرَقُ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  صَلَّى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الظُّهْرَ  بِالْبَطْحَاءِ  رَكْعَتَيْنِ  ، ثُمَّ سَارَ فَصَلَّى الْعَصْرَ رَكْعَتَيْنِ حَتَّى قَدِمَ  الْمَدِينَةَ  فَأَتَمَّ  .","","Al-Mu'jam al-Kabir 252","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن سفيان الثوري عن إسحاق بن يوسف الأزرق عن أحمد بن منيع البغوي عن إسحاق بن إبراهيم الأصبهاني عن الطبراني","سفيان الثوري عن عون بن أبي جحيفة"
"19745","[22/103]      أَبُو خَالِدٍ الدَّالَانِيُّ  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  253  -  حَدَّثَنَا  الْمُفَضَّلُ بْنُ مُحَمَّدٍ الْجَنَدِيُّ ،  ثَنَا  أَبُو حُمَةَ مُحَمَّدُ بْنُ يُوسُفَ ،  ثَنَا  أَبُو قُرَّةَ قَالَ :  ذَكَرَ  ابْنُ جُرَيْجٍ ،  عَنْ  أَبِي خَالِدٍ ،  أَخْبَرَهُ عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ أَبِي جُحَيْفَةَ  قَالَ :  صَلَّيْتُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِالْأَبْطَحِ  ، وَكَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  قُبَّةٍ  مِنْ أَدَمٍ ، فَتَوَضَّأَ مِنْ  تَوْرِ  حِجَارَةٍ ، فَخَرَجَ  بِلَالٌ  بِفَضْلِهِ فَصَلَّى الظُّهْرَ وَالْعَصْرَ يَمُرُّ بَيْنَ يَدَيْهِ الرَّجُلُ وَالْمَرْأَةُ وَالْحِمَارُ مِنْ وَرَاءِ الْحَرْبَةِ  .","","Al-Mu'jam al-Kabir 253","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن أبو خالد الدالاني عن ابن جريج عن موسى بن طارق الزبيدي عن محمد بن يوسف الزبيدي صاحب أبي قرة عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","أبو خالد الدالاني عن عون بن أبي جحيفة"
"19746","عَلِيُّ بْنُ الْأَقْمَرِ  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  254  -  حَدَّثَنَا  طَالِبُ بْنُ قُرَّةَ الْأَذَنِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عِيسَى الطَّبَّاعُ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  رَقَبَةَ بْنِ مَصْقَلَةَ ،  عَنْ  عَلِيِّ بْنِ الْأَقْمَرِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا آكُلُ  مُتَّكِئًا  .","","Al-Mu'jam al-Kabir 254","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن علي بن الأقمر عن رقبة بن مصقلة عن الوضاح بن عبد الله اليشكري عن ابن الطباع ، محمد بن عيسى بن نجيح البغدادي عن طالب بن قرة الأذني عن الطبراني","علي بن الأقمر عن عون بن أبي جحيفة"
"19747","مَالِكُ بْنُ مِغْوَلٍ  ، عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  ، عَنْ أَبِيهِ  255  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  الْحُمَيْدِيُّ ، (  ح  )  وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  حَجَّاجُ بْنُ إِبْرَاهِيمَ الْأَزْرَقُ ، قَالَا :  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  مَالِكِ بْنِ مِغْوَلٍ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  خَرَجَ  بِلَالٌ  فَرَكَزَ  عَنَزَةً  فَصَلَّى إِلَيْهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَمُرُّ         [22/104]      بَيْنَ يَدَيْهِ الْحِمَارُ وَالْكَلْبُ  ، وَخَرَجَ بِفَضْلِ وَضُوءِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" وَزَادَ  الْحُمَيْدِيُّ  فِي حَدِيثِهِ وَالْمَرْأَةُ  .","","Al-Mu'jam al-Kabir 255","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن مالك بن مغول الصهيبي عن سفيان بن عيينة عن حجاج بن إبراهيم الأبناوي عن يوسف بن يزيد القراطيسي عن الطبراني","مالك بن مغول عن عون بن أبي جحيفة عن أبيه"
"19748","256  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُوسَى بْنُ عَبْدِ الرَّحْمَنِ الْمَسْرُوقِيُّ ،  ثَنَا  حُسَيْنُ بْنُ عَلِيٍّ الْجُعْفِيُّ ،  عَنْ  زَائِدَةَ ،  عَنْ  مَالِكِ بْنِ مِغْوَلٍ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  دُفِعْتُ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِالْأَبْطَحِ  فِي  قُبَّةٍ  ، فَخَرَجَ  بِلَالٌ  فَنَادَى بِالصَّلَاةِ  ، ثُمَّ دَخَلَ  بِلَالٌ  فَأَخْرَجَ  الْعَنَزَةَ  ، فَخَرَجَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَرَكَزَ  الْعَنَزَةَ  وَأَقَامَ الصَّلَاةَ ، فَصَلَّى لَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَمُرُّ بَيْنَ يَدَيْهِ الْحِمَارُ وَالْمَرْأَةُ  .","","Al-Mu'jam al-Kabir 256","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن مالك بن مغول الصهيبي عن زائدة بن قدامة عن الحسين بن علي الجعفي عن موسى بن عبد الرحمن بن سعيد المسروقي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","مالك بن مغول عن عون بن أبي جحيفة عن أبيه"
"19749","257  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَعَلِيُّ بْنُ الْعَبَّاسِ الْبَجَلِيُّ الْكُوفِيُّ قَالَا :  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى الْأَكْفَانِيُّ ،  ثَنَا  خُنَيْسُ بْنُ بَكْرٍ ،  ثَنَا  مَالِكُ بْنُ مِغْوَلٍ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَبُو بَكْرٍ  وَعُمَرُ  سَيِّدَا  كُهُولِ  أَهْلِ الْجَنَّةِ  مِنَ الْأَوَّلِينَ وَالْآخِرِينَ مَا خَلَا النَّبِيِّينَ وَالْمُرْسَلِينَ  .","","Al-Mu'jam al-Kabir 257","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن مالك بن مغول الصهيبي عن خنيس بن بكر بن خنيس عن زكريا بن يحيى الأكفاني عن المقانعي علي بن العباس بن الوليد عن الطبراني","مالك بن مغول عن عون بن أبي جحيفة عن أبيه"
"19750","[22/105]      الْحَجَّاجُ بْنُ أَرْطَاةَ  وَعَبْدُ اللهِ بْنُ الْمُخْتَارِ  عَنْ  عَوْنٍ  258  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ قَالَ :  ثَنَا  الْحَجَّاجُ ، وَعَبْدُ اللهِ بْنُ الْمُخْتَارِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" صَلَّى  بِالْبَطْحَاءِ  وَبَيْنَ يَدَيْهِ  عَنَزَةٌ  ، فَجَعَلَ يَمُرُّ مِنْ وَرَائِهَا الْكَلْبُ وَالْحِمَارُ وَالْمَرْأَةُ  .","","Al-Mu'jam al-Kabir 258","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عبد الله بن المختار البصري عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن عبد الله بن أحمد بن حنبل عن الطبراني","الحجاج بن أرطاة وعبد الله بن المختار عن عون"
"19751","259  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  أَبُو عُمَرَ الضَّرِيرُ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  :  أَنَّ  بِلَالًا  "" أَذَّنَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِالْبَطْحَاءِ  فَجَعَلَ أُصْبُعَيْهِ فِي أُذُنَيْهِ وَجَعَلَ يَسْتَدِيرُ  .","","Al-Mu'jam al-Kabir 259","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن حجاج بن أرطاة عن حماد بن سلمة عن حفص بن عمر الضرير البصري عن أبو مسلم الكجي عن الطبراني","الحجاج بن أرطاة وعبد الله بن المختار عن عون"
"19752","260  -  حَدَّثَنَا  إِسْحَاقُ بْنُ جَمِيلٍ الْأَصْبَهَانِيُّ  ، ثَنَا  أَحْمَدُ بْنُ مَنِيعٍ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  ثَنَا  الْحَجَّاجُ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  كَانَ  بِلَالٌ  "" إِذَا أَذَّنَ وَضَعَ أُصْبُعَيْهِ فِي أُذُنَيْهِ  وَاسْتَدَارَ  فِي أَذَانِهِ  ""  .","","Al-Mu'jam al-Kabir 260","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن حجاج بن أرطاة عن أبو معاوية الضرير عن أحمد بن منيع البغوي عن إسحاق بن إبراهيم الأصبهاني عن الطبراني","الحجاج بن أرطاة وعبد الله بن المختار عن عون"
"19753","261  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ الْأَعْلَى بْنُ وَاصِلٍ ،  ثَنَا  يَحْيَى بْنُ آدَمَ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ  بِلَالًا  أَذَّنَ فَأَتَتَبَّعُ فَاهُ هَاهُنَا وَهَاهُنَا ، وَالْتَفَتَ  سُفْيَانُ  يَمِينًا وَشِمَالًا  ""  قَالَ  يَحْيَى  : قَالَ  سُفْيَانُ  : كَانَ  حَجَّاجٌ  يَذْكُرُهُ عَنْ  عَوْنٍ  أَنَّهُ قَالَ :  وَاسْتَدَارَ  فِي أَذَانِهِ ، فَلَمَّا لَقِينَا  عَوْنًا  لَمْ يَذْكُرْ فِيهِ  اسْتَدَارَ  .","","Al-Mu'jam al-Kabir 261","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن سفيان الثوري عن يحيى بن آدم عن عبد الأعلى بن واصل الأسدي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","الحجاج بن أرطاة وعبد الله بن المختار عن عون"
"19754","262  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ  ، ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ ،  ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ ،  عَنْ  حَجَّاجٍ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُمَكِّنُ أَنْفَهُ مِنَ الْأَرْضِ كَمَا يُمَكِّنُ جَبْهَتَهُ  .","","Al-Mu'jam al-Kabir 262","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن حجاج بن أرطاة عن زياد بن عبد الله البكائي عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","الحجاج بن أرطاة وعبد الله بن المختار عن عون"
"19755","[22/106]      263  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدِ بْنِ كَاسِبٍ ،  ثَنَا  الْقَاسِمُ بْنُ نَافِعٍ السَّوَارِقِيُّ ،  عَنْ  حَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ دَرَأَ  الْحَدَّ  عَنِ  امْرَأَةٍ  اسْتُكْرِهَتْ  .","","Al-Mu'jam al-Kabir 263","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن حجاج بن أرطاة عن القاسم بن نافع السوارقي عن يعقوب بن حميد بن كاسب المدني عن عبد الله بن أحمد بن حنبل عن الطبراني","الحجاج بن أرطاة وعبد الله بن المختار عن عون"
"19756","264  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  عَنْ  حَجَّاجٍ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  أَتَيْنَا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِالْأَبْطَحِ  فِي  قُبَّةٍ  لَهُ حَمْرَاءَ ، فَقَالَ : "" مَنْ أَنْتُمْ  ؟ "" قُلْنَا :  بَنُو عَامِرٍ  ، فَقَالَ : "" مَرْحَبًا أَنْتُمْ مِنِّي  .","","Al-Mu'jam al-Kabir 264","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن حجاج بن أرطاة عن عباد بن العوام الكلابي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","الحجاج بن أرطاة وعبد الله بن المختار عن عون"
"19757","265  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى قَالَ :  ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  دَخَلْتُ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَا  وَرَجُلٌ مِنْ بَنِي عَامِرٍ  فَقَالَ : "" مَنْ أَنْتُمْ  ؟ "" قُلْنَا : مِنْ  بَنِي عَامِرٍ  فَقَالَ : "" مَرْحَبًا بِكُمْ أَنْتُمْ مِنِّي  .","","Al-Mu'jam al-Kabir 265","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن حجاج بن أرطاة عن أبو معاوية الضرير عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","الحجاج بن أرطاة وعبد الله بن المختار عن عون"
"19758","266  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  أَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ فِي  الْأَبْطَحِ  فِي  قُبَّةٍ  حَمْرَاءَ فِي نَفَرٍ مِنْ  بَنِي عَامِرٍ  فَقَالَ لَنَا : مِمَّنْ أَنْتُمْ؟  قُلْنَا : مِنْ  بَنِي عَامِرٍ  ، قَالَ : فَأَنَا مِنْكُمْ ، ثُمَّ خَرَجَ  بِلَالٌ  وَوَضَعَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ طَهُورًا ، ثُمَّ أَذَّنَ وَوَضَعَ أُصْبُعَيْهِ فِي أُذُنَيْهِ  وَاسْتَدَارَ  فِي أَذَانِهِ ، وَرَكَزَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عَنَزَةً  فَصَلَّى إِلَيْهَا ، فَصَلَّى الظُّهْرَ رَكْعَتَيْنِ وَالْعَصْرَ رَكْعَتَيْنِ ، وَقَالَ لَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         [22/107]      "" ائْتُونِي  بِالْمَدِينَةِ  "" وَوَعَدَنَا سُلْتًا ، فَأَتَيْنَا  الْمَدِينَةَ  فَوَجَدْنَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ مَاتَ ،  فَأَتَيْنَا  أَبَا بَكْرٍ  فَأَنْجَزَ مَا وَعَدَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 266","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن حجاج بن أرطاة عن عبد الواحد بن زياد عن العباس بن الوليد النرسي عن عبد الله بن أحمد بن حنبل عن الطبراني","الحجاج بن أرطاة وعبد الله بن المختار عن عون"
"19759","عَبْدُ الْجَبَّارِ بْنُ الْعَبَّاسِ الْهَمَدَانِيُّ الشِّبَامِيُّ  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  267  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ الْجَبَّارِ بْنُ الْعَبَّاسِ ،  ثَنَا  عَوْنُ بْنُ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  لَمَّا كَانَ  يَوْمُ  النَّفْرِ  نَزَلْنَا  بِالْأَبْطَحِ  "" فَأَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِلَالًا  فَنَادَى بِالصَّلَاةِ  ، ثُمَّ أَخْرَجَ وَضُوءَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَوَثَبَ النَّاسُ عَلَيْهِ فَمِنْ بَيْنِ  نَائِلٍ  وَنَاضِحٍ ،  ثُمَّ أَخْرَجَ  عَنَزَةً  فَرَكَزَهَا بَيْنَهُ وَبَيْنَ الطَّرِيقِ  "" .","","Al-Mu'jam al-Kabir 267","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عبد الجبار بن العباس الشبامي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الجبار بن العباس الهمداني الشبامي عن عون بن أبي جحيفة"
"19760","268  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ الْجَبَّارِ بْنُ الْعَبَّاسِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرِهِ الَّذِي نَامُوا فِيهِ حَتَّى طَلَعَتِ الشَّمْسُ ، فَقَالَ :  إِنَّكُمْ كُنْتُمْ أَمْوَاتًا فَرَدَّ اللهُ أَرْوَاحَكُمْ  ، فَمَنْ نَامَ عَنْ صَلَاةٍ فَلْيُصَلِّهَا إِذَا اسْتَيْقَظَ ، وَمَنْ نَسِيَ صَلَاةً فَلْيُصَلِّهَا إِذَا ذَكَرَهَا  .","","Al-Mu'jam al-Kabir 268","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عبد الجبار بن العباس الشبامي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الجبار بن العباس الهمداني الشبامي عن عون بن أبي جحيفة"
"19761","269  -  حَدَّثَنَا  عَبْدُ الْوَارِثِ بْنُ إِبْرَاهِيمَ أَبُو عُبَيْدَةَ الْعَسْكَرِيُّ  ، ثَنَا  عِيسَى بْنُ إِبْرَاهِيمَ الْبِرَكِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُسْهِرٍ ،  ثَنَا  عَبْدُ الْجَبَّارِ بْنُ الْعَبَّاسِ الْهَمَدَانِيُّ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا قَامَ أَحَدُكُمْ مِنْ مَنَامِهِ فَلْيَقُلِ: الْحَمْدُ لِلهِ الَّذِي رَدَّ فِينَا أَرْوَاحَنَا  بَعْدَ إِذْ كُنَّا أَمْوَاتًا  .","","Al-Mu'jam al-Kabir 269","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عبد الجبار بن العباس الشبامي عن عبد الرحمن بن مسهر البغدادي عن عيسى بن إبراهيم البركي عن عبد الوارث بن إبراهيم العسكري عن الطبراني","عبد الجبار بن العباس الهمداني الشبامي عن عون بن أبي جحيفة"
"19762","[22/108]      270  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  (  ح  ) ،  وَحَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ قَالَ:  قَرَأْتُ عَلَى  إِبْرَاهِيمَ بْنِ سَعِيدٍ الْجَوْهَرِيِّ قَالَا :  ثَنَا  أَبُو أَحْمَدَ الزُّبَيْرِيُّ قَالَ :  ثَنَا  عَبْدُ الْجَبَّارِ بْنُ الْعَبَّاسِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  ، فِيمَا نَعْلَمُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  سَتُفْتَحُ عَلَيْكُمُ الدُّنْيَا حَتَّى تُنَجِّدُوا بُيُوتَكُمْ كَمَا تُنَجَّدُ  الْكَعْبَةُ  قُلْنَا : وَنَحْنُ عَلَى دِينِنَا؟ قَالَ : "" نَعَمْ فَأَنْتُمُ الْيَوْمَ خَيْرٌ مِنْ يَوْمِئِذٍ "" قُلْنَا : يَوْمَئِذٍ ، قَالَ : "" بَلْ أَنْتُمُ الْيَوْمَ خَيْرٌ  .","","Al-Mu'jam al-Kabir 270","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عبد الجبار بن العباس الشبامي عن محمد بن عبد الله بن الزبير عن إبراهيم بن سعيد الجوهري عن عبد الله بن أحمد الجواليقي عن الطبراني","عبد الجبار بن العباس الهمداني الشبامي عن عون بن أبي جحيفة"
"19763","271  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ قَالَ :  ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ قَالَا :  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  عَبْدُ الْجَبَّارِ بْنُ الْعَبَّاسِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  :  أَنَّ  رَجُلًا  ذَبَحَ قَبْلَ أَنْ يُصَلِّيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمَ النَّحْرِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يُجْزِئُ عَنْ أَحَدٍ  قَالَ : فَإِنَّ عِنْدَنَا  جَذَعَةً  قَالَ : "" يُجْزِئُ عَنْكَ وَلَا يُجْزِي بَعْدَكَ  .","","Al-Mu'jam al-Kabir 271","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عبد الجبار بن العباس الشبامي عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","عبد الجبار بن العباس الهمداني الشبامي عن عون بن أبي جحيفة"
"19764","272  -  حَدَّثَنَا  ابْنُ أَبِي مَرْيَمَ ،  ثَنَا  الْفِرْيَابِيُّ ، (  ح  )  وَحَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلْطِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ قَالَ :  ثَنَا  عَبْدُ الْجَبَّارِ بْنُ الْعَبَّاسِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ ثَمَنِ الدَّمِ  ، وَمَهْرِ  الْبَغِيِّ  ، وَثَمَنِ الْكَلْبِ  .","","Al-Mu'jam al-Kabir 272","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عبد الجبار بن العباس الشبامي عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","عبد الجبار بن العباس الهمداني الشبامي عن عون بن أبي جحيفة"
"19765","[22/109]      273  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  عَبْدُ الْجَبَّارِ بْنُ الْعَبَّاسِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ ثَمَنِ الدَّمِ  ، وَمَهْرِ  الْبَغِيِ  ، وَكَسْبِ الْحَجَّامِّ  .","","Al-Mu'jam al-Kabir 273","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عبد الجبار بن العباس الشبامي عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","عبد الجبار بن العباس الهمداني الشبامي عن عون بن أبي جحيفة"
"19766","274  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، أَنَا  مُوسَى بْنُ مُحَمَّدِ بْنِ حَبَّانَ ،  ثَنَا  سَالِمُ بْنُ قُتَيْبَةَ  قَالَ :  ثَنَا  عَبْدُ الْجَبَّارِ بْنُ الْعَبَّاسِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي مَسِيرٍ فَسَمِعَ قَائِلًا يَقُولُ : اللهُ أَكْبَرُ ، اللهُ أَكْبَرُ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" دَعْوَةُ الْحَقِّ  فَقَالَ : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" كَلِمَةُ الْإِخْلَاصِ "" فَقَالَ : أَشْهَدُ أَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" خَرَجَ صَاحِبُهَا مِنَ النَّارِ "" ثُمَّ قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" تَجِدُونَ هَذَا صَاحِبَ مِعْزًى أَوْ صَاحِبَ كِلَابٍ يَتَصَيَّدُ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( سلم بن قتيبة).","","Al-Mu'jam al-Kabir 274","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عبد الجبار بن العباس الشبامي عن سلم بن قتيبة الشعيري عن موسى بن محمد بن سعيد البصري عن الحسين بن إسحاق التستري عن الطبراني","عبد الجبار بن العباس الهمداني الشبامي عن عون بن أبي جحيفة"
"19767","أَشْعَثُ بْنُ سَوَّارٍ  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  مَا رَوَى  صَدَقَةُ بْنُ أَبِي عِمْرَانَ  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  275  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  عَنْ  عَبَّادِ بْنِ الْعَوَّامِ ، وَإِسْمَاعِيلُ بْنُ زَكَرِيَّا ، وَيَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،         [22/110]      عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  بَعَثَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُصَدِّقًا فَكَانَ يَأْخُذُ مِنَ الْأَغْنِيَاءِ وَيُعْطِي الْفُقَرَاءَ  ، قَالَ  ابْنُ أَبِي زَائِدَةَ  فِي حَدِيثِهِ : "" وَكُنْتُ غُلَامًا يَتِيمًا فَأَعْطَانِي مِنْهَا قَلُوصًا  "" .","","Al-Mu'jam al-Kabir 275","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن أشعث بن سوار عن يحيى بن زكريا بن أبي زائدة عن سعيد بن سليمان سعدويه عن محمد بن الفضل بن جابر السقطى عن الطبراني","أشعث بن سوار عن عون بن أبي جحيفة"
"19768","276  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو خَالِدٍ الْأَحْمَرُ ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  بَعَثَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِينَا  سَاعِيًا  فَأَخَذَ الصَّدَقَةَ مِنْ أَغْنِيَائِنَا  ، فَجَعَلَهَا فِي فُقَرَائِنَا ، وَكُنْتُ غُلَامًا يَتِيمًا لَا مَالَ لِي ، فَأَعْطَانِي مِنْهَا قَلُوصًا  .","","Al-Mu'jam al-Kabir 276","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن أشعث بن سوار عن سليمان بن حيان الأحمر عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أشعث بن سوار عن عون بن أبي جحيفة"
"19769","277  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  أَبُو بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  عُمَرُ بْنُ عَلِيٍّ ،  عَنْ  أَشْعَثَ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  بَعَثَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فَذَكَرَ مِثْلَهُ  .","","Al-Mu'jam al-Kabir 277","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن أشعث بن سوار عن عمر بن علي بن عطاء عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","أشعث بن سوار عن عون بن أبي جحيفة"
"19770","278  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  أَبُو بَكْرِ بْنُ نَافِعٍ ،  ثَنَا  الْفَضْلُ بْنُ الْعَلَاءِ ،  ثَنَا  أَشْعَثُ بْنُ سَوَّارٍ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  حَجَجْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَنَا غُلَامٌ  ، فَبَيْنَمَا نَحْنُ نُزُولٌ  بِمِنًى  قَالَ قَائِلٌ : "" ارْتَحَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَقُومُ عَلَى رَاحِلَتِي فَأَشَدُّ عَلَيْهَا ، وَضَرَبْتُ نَحْوَهُ حَتَّى انْتَهَيْنَا إِلَى  الْبَطْحَاءِ  ، فَإِذَا جَمَاعَةٌ مِنَ النَّاسِ غَيْرُ كَثِيرٍ ، وَإِذَا  قُبَّةٌ  مَضْرُوبَةٌ فَخَرَجَ عَلَيْنَا  بِلَالٌ  وَمَعَهُ وَضُوءٌ  وَعَنَزَةٌ  ، ثُمَّ أَذَّنَ فَخَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَتَوَضَّأَ فَأَفْضَلَ فَضْلَةً ، فَإِذَا النَّاسُ يَأْخُذُونَ مِنْهَا فَيَمْسَحُونَ وُجُوهَهُمْ وَرُءُوسَهُمْ فَالْتَفَتُّ فَفَعَلْتُ مِثْلَ مَا فَعَلُوا ، ثُمَّ صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَالْعَنَزَةُ  بَيْنَ يَدَيْهِ ، وَالنَّاسُ مُقْبِلُونَ وَمُدْبِرُونَ  .","","Al-Mu'jam al-Kabir 278","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن أشعث بن سوار عن الفضل بن العلاء الكوفي عن محمد بن أحمد بن نافع القيسي عن الحسين بن إسحاق التستري عن الطبراني","أشعث بن سوار عن عون بن أبي جحيفة"
"19771","[22/111]      279  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ ،  ثَنَا  سَعْدَانُ بْنُ يَحْيَى ،  ثَنَا  صَدَقَةُ بْنُ أَبِي عِمْرَانَ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ رَآنِي فِي الْمَنَامِ فَكَأَنَّمَا رَآنِي فِي الْيَقَظَةِ  ، فَإِنَّ الشَّيْطَانَ لَا يَسْتَطِيعُ أَنْ يَتَمَثَّلَ بِي  .","","Al-Mu'jam al-Kabir 279","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن صدقة بن أبي عمران الكوفي عن سعيد بن يحيى سعدان عن سليمان بن عبد الرحمن التميمي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","ما روى صدقة بن أبي عمران عن عون بن أبي جحيفة"
"19772","280  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ السَّمَرْقَنْدِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ بَكْرٍ الْكُوفِيُّ ،  عَنْ  صَدَقَةَ بْنِ أَبِي عِمْرَانَ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ رَآنِي فَقَدْ رَآنِي ، فَإِنَّ الشَّيْطَانَ لَا يَسْتَطِيعُ أَنْ يَتَشَبَّهَ بِي  .","","Al-Mu'jam al-Kabir 280","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن صدقة بن أبي عمران الكوفي عن محمد بن بكر بن عثمان البرساني عن الدارمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ما روى صدقة بن أبي عمران عن عون بن أبي جحيفة"
"19773","281  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  الْقَاسِمُ بْنُ مُحَمَّدِ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  صَدَقَةَ بْنِ أَبِي عِمْرَانَ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 281","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن صدقة بن أبي عمران الكوفي عن حماد بن أسامة القرشي عن قاسم بن محمد بن أبي شيبة العبسي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ما روى صدقة بن أبي عمران عن عون بن أبي جحيفة"
"19774","كَثِيرُ بْنُ قَارَوَنْدَا  ، عَنِ  ابْنِ أَبِي جُحَيْفَةَ  282  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَجَاءٍ السَّقَطِيُّ  ، ثَنَا  الْعَبَّاسُ بْنُ مُحَمَّدِ بْنِ حَاتِمٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْعَزِيزِ بْنِ صَادِرٍ الْمَدِينِيُّ ،  ثَنَا  الْفَضْلُ بْنُ سُلَيْمَانَ ،  ثَنَا  كَثِيرُ بْنُ قَارَوَنْدَا ،  ثَنَا  عَوْنُ بْنُ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  حَجَجْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَجَّةَ الْوَدَاعِ  ، فَمَا زِلْنَا نُصَلِّي رَكْعَتَيْنِ حَتَّى رَجَعْنَا  .","","Al-Mu'jam al-Kabir 282","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن كثير بن قاروندا الكوفي عن فضيل بن سليمان النميري عن عبد الرحمن بن عبد العزيز سبويه عن عباس الدوري عن محمد بن رجاء السقطي عن الطبراني","كثير بن قاروندا عن ابن أبي جحيفة"
"19775","الْهَيْثَمُ بْنُ حَبِيبٍ الصَّيْرَفِيُّ  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  283  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  أَبُو الرَّبِيعِ         [22/112]      الزَّهْرَانِيُّ ،  ثَنَا  حَفْصُ بْنُ أَبِي دَاوُدَ ،  عَنِ  الْهَيْثَمِ بْنِ حَبِيبٍ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  مَرَّ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِرَجُلٍ  يُصَلِّي قَدْ  سَدَلَ  ثَوْبَهُ فَقَطَعَهُ عَلَيْهِ  .","","Al-Mu'jam al-Kabir 283","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن الهيثم بن حبيب عن حفيص الأسدي عن سليمان بن داود العتكي عن الحسين بن إسحاق التستري عن الطبراني","الهيثم بن حبيب الصيرفي عن عون بن أبي جحيفة"
"19776","284  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ،  ثَنَا  عُبَيْدُ بْنُ إِسْحَاقَ الْعَطَّارُ ،  ثَنَا  كَامِلٌ أَبُو الْعَلَاءِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ ثَمَنِ الدَّمِ  .","","Al-Mu'jam al-Kabir 284","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن كامل بن العلاء التميمي عن عبيد بن إسحاق عطار المطلقات عن لحية الليف محمد بن العباس عن الطبراني","كامل أبو العلاء عن عون بن أبي جحيفة"
"19777","عُتْبَةُ بْنُ الْعُمَيْسِ  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  285  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، وَالْعَبَّاسُ بْنُ عَبْدِ الْعَظِيمِ الْعَنْبَرِيُّ قَالُوا :  ثَنَا  جَعْفَرُ بْنُ عَوْنٍ ،  ثَنَا  أَبُو الْعُمَيْسِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  آخَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَ  سَلْمَانَ  وَأَبِي الدَّرْدَاءِ  ، فَجَاءَ  سَلْمَانُ  يَزُورُ  أَبَا الدَّرْدَاءِ  ، فَإِذَا  أُمُّ الدَّرْدَاءِ  مُبْتَذَلَةٌ ، فَقَالَ : مَا شَأْنُكِ يَا  أُمَّ الدَّرْدَاءِ  ؟ قَالَتْ : إِنَّ أَخَاكَ  أَبَا الدَّرْدَاءِ  يَقُومُ اللَّيْلَ وَيَصُومُ النَّهَارَ ، وَلَيْسَ لَهُ حَاجَةٌ فِي شَيْءٍ مِنَ الدُّنْيَا ، فَجَاءَ  أَبُو الدَّرْدَاءِ  فَرَحَّبَ  بِسَلْمَانَ  وَقَرَّبَ إِلَيْهِ طَعَامًا ، فَقَالَ لَهُ  سَلْمَانُ  : اطْعَمْ ، قَالَ : إِنِّي صَائِمٌ ، قَالَ : أَقْسَمْتُ عَلَيْكَ لَتُفْطِرَنَّ ، فَأَبَى يَأْكُلُ حَتَّى يَأْكُلَ مَعَهُ ، فَأَكَلَ مَعَهُ ، ثُمَّ بَاتَ عِنْدَهُ ، فَلَمَّا كَانَ مِنَ اللَّيْلِ أَرَادَ  أَبُو الدَّرْدَاءِ  أَنْ يَقُومَ فَمَنَعَهُ  سَلْمَانُ  ، ثُمَّ قَالَ : يَا  أَبَا الدَّرْدَاءِ  ، إِنَّ لِجَسَدِكَ عَلَيْكَ حَقًّا وَلِرَبِّكَ حَقًّا ، وَلِأَهْلِكَ حَقًّا ،         [22/113]      أَعْطِ كُلَّ ذِي حَقٍّ حَقَّهُ ، فَلَمَّا كَانَ فِي وَجْهِ الصُّبْحِ قَالَ : قُمِ الْآنَ إِنْ شِئْتَ ، فَقَامَا فَتَوَضَّآ ، ثُمَّ رَكَعَا ، ثُمَّ خَرَجَا إِلَى الصَّلَاةِ ، فَدَنَا  أَبُو الدَّرْدَاءِ  لِيُخْبِرَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ لِجَسَدِكَ حَقًّا  مِثْلَ مَا قَالَ  سَلْمَانُ  .","","Al-Mu'jam al-Kabir 285","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عتبة بن عبد الله بن عتبة المسعودي عن جعفر بن عون المخزومي عن عباس بن عبد العظيم العنبري عن عبد الله بن أحمد الجواليقي عن الطبراني","عتبة بن العميس عن عون بن أبي جحيفة"
"19778","286  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَعْفَرُ بْنُ عَوْنٍ ،  عَنْ  أَبِي الْعُمَيْسِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِالْأَبْطَحِ  ، فَجَاءَ  بِلَالٌ  فَآذَنَهُ بِالصَّلَاةِ  وَذَكَرَ الْحَدِيثَ ""  .","","Al-Mu'jam al-Kabir 286","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عتبة بن عبد الله بن عتبة المسعودي عن جعفر بن عون المخزومي عن عثمان ابن أبي شيبة عن عبد الله بن أحمد الجواليقي عن الطبراني","عتبة بن العميس عن عون بن أبي جحيفة"
"19779","يَزِيدُ بْنُ زِيَادِ بْنِ أَبِي الْجَعْدِ  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  287  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ، (  ح  )  وَحَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ  ، ثَنَا  أَبُو الشَّعْثَاءِ عَلِيُّ بْنُ الْحَسَنِ قَالَا :  ثَنَا  وَكِيعٌ ،  عَنْ  يَزِيدَ بْنِ زِيَادِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  نَهَى عَنْ كَسْبِ الْحَجَّامِ وَمَهْرِ  الْبَغِيِّ  .","","Al-Mu'jam al-Kabir 287","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن يزيد بن زياد بن أبي الجعد الغطفاني عن وكيع بن الجراح عن علي بن الحسن بن سليمان الحضرمي عن محمود بن محمد بن منويه المفيد عن الطبراني","يزيد بن زياد بن أبي الجعد عن عون بن أبي جحيفة"
"19780","أَبُو بُرْدَةَ الْأَشْعَرِيُّ  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  288  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِالْبَطْحَاءِ  ، وَقَدْ أَذَّنَ         [22/114]      بِلَالٌ ،  فَخَرَجَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ  قُبَّةٍ  لَهُ مِنْ أَدَمٍ فَجَلَسَ بِفِنَائِهَا  ، ثُمَّ أُتِيَ بِطَهُورٍ فَتَوَضَّأَ ، ثُمَّ بَادَرَ النَّاسُ إِلَى فَضْلِ وَضُوئِهِ مِنْ شَارِبٍ وَمُتَوَضِئٍ ، ثُمَّ أُتِيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِعَنَزَةٍ  فَغُرِزَتْ بَيْنَ يَدَيْهِ فَصَلَّى بِالنَّاسِ ، وَإِنَّ الصَّبِيَّ وَالْمَرْأَةَ وَالشَّاةَ وَالْبَعِيرَ يَمُرُّونَ بَيْنَ يَدَيْهِ  .","","Al-Mu'jam al-Kabir 288","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن أبو بردة عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","أبو بردة الأشعري عن عون بن أبي جحيفة"
"19781","قَيْسُ بْنُ الرَّبِيعِ  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  289  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  أَبُو بِلَالٍ الْأَشْعَرِيُّ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ قَالَ :  ثَنَا  يَحْيَى الْحِمَّانِيُّ قَالَا :  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ  بِلَالًا  خَرَجَ بِالْهَاجِرَةِ وَمَعَهُ  عَنَزَةٌ  فَرَكَزَهَا ، ثُمَّ قَامَ يُؤَذِّنُ فَجَعَلَ أُصْبُعَيْهِ فِي أُذُنَيْهِ  ، وَجَعَلَ يَقُولُ بِرَأْسِهِ هَكَذَا وَهَكَذَا يَمِينًا وَشِمَالًا حَتَّى فَرَغَ مِنْ أَذَانِهِ ، ثُمَّ دَخَلَ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَخْرَجَ فَضْلَةً مِنَ الْمَاءِ ، فَمِنْ بَيْنِ آخِذٍ  وَنَاضِحٍ  ، ثُمَّ خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَعَلَيْهِ  حُلَّةٌ  حَمْرَاءُ كَأَنِّي أَنْظُرُ إِلَى بَيَاضِ سَاقَيْهِ مِنْ تَحْتِهَا ، فَصَلَّى إِلَى  الْعَنَزَةِ  وَالظُّعُنُ يَمُرُّونَ بَيْنَ يَدَيْهِ .  وَاللَّفْظُ لِحَدِيثِ  أَبِي بِلَالٍ  .","","Al-Mu'jam al-Kabir 289","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن قيس بن الربيع الأسدي عن أبو بلال الأشعري عن عمر بن حفص السدوسي عن الطبراني","قيس بن الربيع عن عون بن أبي جحيفة"
"19782","290  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ قَالَ :  حَدَّثَنَا  جُبَارَةُ بْنُ مُغَلِّسٍ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  لَعَنَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  آكِلَ  الرِّبَا وَمُوكِلَهُ  .","","Al-Mu'jam al-Kabir 290","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن قيس بن الربيع الأسدي عن جبارة بن المغلس عن محمد بن عبد الله مطين الحضرمي عن الطبراني","قيس بن الربيع عن عون بن أبي جحيفة"
"19783","291  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،         [22/115]      ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  دَخَلْتُ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَا وَرَجُلَانِ مِنْ  بَنِي عَامِرٍ  ، فَقَالَ : "" مِمَّنْ أَنْتُمْ ؟ "" قُلْنَا : مِنْ  بَنِي عَامِرٍ  ، قَالَ :  أَنْتُمَا مِنِّي  .","","Al-Mu'jam al-Kabir 291","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","قيس بن الربيع عن عون بن أبي جحيفة"
"19784","عَبْدُ الْحَمِيدِ بْنُ أَبِي جَعْفَرٍ الْفَرَّاءُ  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  292  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  هِشَامُ بْنُ يُونُسَ اللُّؤْلُؤِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِيُّ ،  عَنْ  عَبْدِ الْحَمِيدِ بْنِ أَبِي جَعْفَرٍ الْفَرَّاءِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  كَانَ يُرْكَزُ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عَنَزَةٌ  فِي الْفَضَاءِ فَيُصَلِّي إِلَيْهَا  .","","Al-Mu'jam al-Kabir 292","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عبد الحميد بن أبي جعفر الفراء عن عبد الرحمن بن محمد المحاربي عن هشام بن يونس بن وابل النهشلي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عبد الحميد بن أبي جعفر الفراء عن عون بن أبي جحيفة"
"19785","شُعْبَةُ بْنُ الْحَجَّاجِ  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  293  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ، وَأَبُو خَلِيفَةَ ، قَالَا :  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، (  ح  )  وَحَدَّثَنَا  أَبُو خَلِيفَةَ قَالَ :  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ قَالَا :  ثَنَا  شُعْبَةُ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  :  أَنَّهُ "" صَلَّى مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِالْبَطْحَاءِ ،  فَرَكَزَ بَيْنَ يَدَيْهِ  عَنَزَةً  فَصَلَّى إِلَيْهَا الظُّهْرَ رَكْعَتَيْنِ  ، وَالْعَصْرَ رَكْعَتَيْنِ ، وَكَانَ الْحِمَارُ وَالْمَرْأَةُ يَمُرُّونَ مِنْ وَرَاءِ  الْعَنَزَةِ  ""  وَاللَّفْظُ لِحَدِيثِ  سُلَيْمَانَ بْنِ حَرْبٍ  .","","Al-Mu'jam al-Kabir 293","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن أبو مسلم الكجي عن الطبراني","شعبة بن الحجاج عن عون بن أبي جحيفة"
"19786","294  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ ،  عَنْ  شُعْبَةَ ،  عَنِ  الْحَكَمِ قَالَ :  سَمِعْتُ  أَبَا جُحَيْفَةَ يُحَدِّثُ ، قَالَ :  خَرَجَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالْهَاجِرَةِ إِلَى  الْبَطْحَاءِ  فَتَوَضَّأَ وَصَلَّى الظُّهْرَ رَكْعَتَيْنِ وَصَلَّى الْعَصْرَ  رَكْعَتَيْنِ وَبَيْنَ يَدَيْهِ  عَنَزَةٌ  "" قَالَ  شُعْبَةُ  : وَزَادَ عَوْنٌ         [22/116]      عَنْ  أَبِي جُحَيْفَةَ قَالَ : كَانَ يَمُرُّ مِنْ وَرَائِهَا الْحِمَارُ وَالْمَرْأَةُ ، ثُمَّ قَامَ النَّاسُ فَجَعَلُوا يَأْخُذُونَ يَدَهُ فَيَمْسَحُونَ بِهَا وُجُوهَهُمْ ، فَأَخَذْتُ بِيَدِهِ فَوَضَعْتُهَا عَلَى وَجْهِي ، فَإِذَا هِيَ أَبْرَدُ مِنَ الثَّلْجِ ، وَأَطْيَبُ رِيحًا مِنَ الْمِسْكِ  .","","Al-Mu'jam al-Kabir 294","","وهب بن عبد الله السوائي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن حجاج بن محمد الأعور عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","شعبة بن الحجاج عن عون بن أبي جحيفة"
"19787","295  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ، وَأَبُو خَلِيفَةَ ، قَالَا :  حَدَّثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ قَالَ :  رَأَيْتُ أَبِي  اشْتَرَى غُلَامًا حَجَّامًا فَكَسَرَ مَحَاجِمَهُ  فَسَأَلْتُهُ عَنْ ذَلِكَ  فَقَالَ  : "" إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ ثَمَنِ الدَّمِ ، وَثَمَنِ الْكَلْبِ  ، وَعَنْ مَهْرِ  الْبَغِيِّ  ، وَلَعَنَ  الْوَاشِمَةَ  وَالْمُسْتَوْشِمَةَ ، وَآكِلَ الرِّبَا وَمُوكِلَهُ  .","","Al-Mu'jam al-Kabir 295","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن أبو مسلم الكجي عن الطبراني","شعبة بن الحجاج عن عون بن أبي جحيفة"
"19788","296  -  حَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  أَبُو الْوَلِيدِ ، وَمُحَمَّدُ بْنُ كَثِيرٍ قَالَا:  ثَنَا  شُعْبَةُ ،  عَنِ  ابْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَحْوَهُ ، زَادَ  ابْنُ كَثِيرٍ :  وَلَعَنَ الْمُصَوِّرَ  .","","Al-Mu'jam al-Kabir 296","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","شعبة بن الحجاج عن عون بن أبي جحيفة"
"19789","أَبُو مَعْدَانَ عَامِرُ بْنُ مُرَّةَ  عَنْ  عَوْنٍ  297  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  الْجَرَّاحُ بْنُ مَخْلَدٍ ،  ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ الْجَزَرِيُّ ،  ثَنَا  سَعِيدُ بْنُ عَنْبَسَةَ الْقَطَّانُ ،  ثَنَا  أَبُو مَعْدَانَ قَالَ :  سَمِعْتُ  عَوْنَ بْنَ أَبِي جُحَيْفَةَ  يُحَدِّثُ عَنْ  أَبِيهِ  قَالَ :  أَتَتْ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  امْرَأَةٌ  ، وَمَعَهَا  جَارِيَةٌ سَوْدَاءُ  ، فَقَالَتِ الْمَرْأَةُ : يَا رَسُولَ اللهِ ، إِنَّ عَلَيَّ رَقَبَةً مُؤْمِنَةً أَفَتُجْزِئُ عَنِّي هَذِهِ ؟ فَقَالَ لَهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَيْنَ اللهُ ؟ "" قَالَتْ : فِي السَّمَاءِ ، قَالَ : "" فَمَنْ أَنَا ؟ "" قَالَتْ : أَنْتَ رَسُولُهُ ،         [22/117]      قَالَ : "" أَتَشْهَدِينَ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَنِّي رَسُولُ اللهِ "" قَالَتْ : نَعَمْ ، قَالَ : "" أَتُؤْمِنِينَ بِمَا جَاءَ مِنْ عِنْدِ اللهِ ؟ قَالَتْ : "" نَعَمْ "" قَالَ :  أَعْتِقِيهَا فَإِنَّهَا  مُؤْمِنَةٌ  .","","Al-Mu'jam al-Kabir 297","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن أبو معدان المكي عن سعيد بن عنبسة الرازي عن محمد بن عثمان الجزري عن الجراح بن مخلد عن عبد الله بن أحمد الجواليقي عن الطبراني","أبو معدان عامر بن مرة عن عون"
"19790","مُحَمَّدُ بْنُ جَابِرٍ الْيَمَامِيُّ  عَنْ  عَوْنٍ  298  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، وَيُوسُفُ الْقَاضِي قَالَا :  ثَنَا  مُسَدَّدٌ ،  ثَنَا  مُحَمَّدُ بْنُ جَابِرٍ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ :  لَعَنَ  آكِلَ  الرِّبَا  وَالْوَاشِمَةَ  وَالْمُصَوِّرَ  .","","Al-Mu'jam al-Kabir 298","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن محمد بن جابر بن سيار عن مسدد بن مسرهد عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","محمد بن جابر اليمامي عن عون"
"19791","أَيُّوبُ بْنُ جَابِرٍ الْيَمَامِيُّ  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  299  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَيُّوبُ بْنُ جَابِرٍ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَ لَنَا  غُلَامٌ  حَجَّامٌ فَنَهَانَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ نَأْكُلَ مِنْ  كَسْبِهِ  شَيْئًا  .","","Al-Mu'jam al-Kabir 299","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن أيوب بن جابر السحيمي عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","أيوب بن جابر اليمامي عن عون بن أبي جحيفة"
"19792","زَيْدُ بْنُ أَبِي أُنَيْسَةَ  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  300  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ وَهْبِ بْنِ أَبِي كَرِيمَةَ الْحَرَّانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي عَبْدِ الرَّحِيمِ ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنِ  ابْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  نَزَلْنَا مَعَ نَبِيِّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِالْأَبْطَحِ  فَنَادَى  بِلَالٌ  بِصَلَاةِ الظُّهْرِ  ، فَجَاءَ إِلَى نَبِيِّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَدَخَلَ عَلَيْهِ فِي بَيْتٍ وَأَدْخَلَ مَعَهُ  تَوْرًا  مِنْ مَاءٍ مِنْ أَدَمٍ ، فَتَوَضَّأَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَبَقِيَتْ فِيهِ بَقِيَّةٌ ، ثُمَّ خَرَجَ ، فَلَقَدْ رَأَيْتُنَا نَبْتَدِرُ ، ثُمَّ أَخَذَ  بِلَالٌ  عَنَزَةً  ، فَرَكَزَهَا ، فَخَرَجَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [22/118]      فَصَلَّى بِنَا رَكْعَتَيْنِ ، وَلَقَدْ رَأَيْتُ الْمَرْأَةَ وَالْكَلْبَ تَمُرُّ بَيْنَ أَيْدِينَا وَنَحْنُ نُصَلِّي  .","","Al-Mu'jam al-Kabir 300","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن زيد بن أبي أنيسة الجزري عن خالد بن يزيد الحراني عن محمد بن سلمة الباهلي عن محمد بن وهب بن عمر الحراني عن الحسين بن إسحاق التستري عن الطبراني","زيد بن أبي أنيسة عن عون بن أبي جحيفة"
"19793","301  -  حَدَّثَنَا  أَبُو عَرُوبَةَ الْحُسَيْنُ بْنُ مُحَمَّدٍ الْحَرَّانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ وَهْبِ بْنِ أَبِي كَرِيمَةَ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي عَبْدِ الرَّحِيمِ ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ رَآنِي فِي الْمَنَامِ فَكَأَنَّمَا رَآنِي فِي الْيَقَظَةِ  ، فَإِنَّ الشَّيْطَانَ لَا يَتَشَبَّهُ بِي  .","","Al-Mu'jam al-Kabir 301","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن زيد بن أبي أنيسة الجزري عن خالد بن يزيد الحراني عن محمد بن سلمة الباهلي عن محمد بن وهب بن عمر الحراني عن الحسين بن محمد بن أبي معشر الجزري عن الطبراني","زيد بن أبي أنيسة عن عون بن أبي جحيفة"
"19794","أَبُو مَرْيَمَ عَبْدُ الْغَفَّارِ بْنُ الْقَاسِمِ  عَنْ  عَوْنٍ  302  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ أَبِي بُكَيْرٍ ،  ثَنَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ  ، ثَنَا  عَبْدُ الْغَفَّارِ بْنُ الْقَاسِمِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  خَرَجَ  بِلَالٌ  بِالْهَاجِرَةِ فَأَذَّنَ ، ثُمَّ دَخَلَ  ، فَخَرَجَ  بِتَوْرٍ  فِيهِ فَضْلُ وَضُوءِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُمْسَكَةٌ بِيَدِهِ ، لَوْ وَضَعَهُ بِالْأَرْضِ كَسَرَهُ النَّاسُ ، فَجَعَلُوا يَتَنَاوَلُونَ فَمُصِيبٌ مِنْهُ وَمُتَنَضِّحٌ عَلَيْهِ بِالْمَاءِ  ، فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 302","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عبد الغفار بن القاسم الأنصاري عن يحيى بن أبي بكير عن عبد الله بن محمد بن يحيى الكرماني عن أحمد بن يحيى بن زهير التستري عن الطبراني","أبو مريم عبد الغفار بن القاسم عن عون"
"19795","مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى  عَنْ  عَوْنٍ  303  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ قَالَا:  ثَنَا  مُحَمَّدُ بْنُ عِمْرَانَ بْنِ أَبِي لَيْلَى ،  حَدَّثَنِي  أَبِي ،  عَنِ  ابْنِ أَبِي لَيْلَى  ، (  ح  )  وَحَدَّثَنَا  عِيسَى بْنُ مُحَمَّدٍ السِّمْسَارُ قَالَ :  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدٌ ،  عَنِ  ابْنِ أَبِي لَيْلَى ، (  ح  )  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  حُمَيْدُ بْنُ         [22/119]      عَبْدِ الرَّحْمَنِ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  كُنْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِالْأَبْطَحِ  فَقُلْتُ : لَأَحْفَظَنَّ كَيْفَ صَلَاةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْيَوْمَ  ، فَخَرَجَ  بِلَالٌ  ، ثُمَّ دَخَلَ فَخَرَجَ بِفَضْلِ وَضُوءِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَابْتَدَرَهُ النَّاسُ فَمِنْ بَيْنِ آخِذٍ  وَنَاضِحٍ  ، ثُمَّ دَخَلَ فَأَخْرَجَ  عَنَزَةً  فَرَكَزَهَا ، ثُمَّ خَرَجَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَعَلَيْهِ  حُلَّةٌ  حَمْرَاءُ كَأَنِّي أَنْظُرُ إِلَى بَيَاضِ سَاقَيْهِ مِنْ وَرَائِهَا ، فَأَقَامَ  بِلَالٌ  الصَّلَاةَ ، وَتَقَدَّمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَصَفَّنَا خَلْفَهُ ، فَصَلَّى بِنَا وَبَيْنَ يَدَيْهِ الْحِمَارُ وَالْمَرْأَةُ وَالْكَلْبُ  .","","Al-Mu'jam al-Kabir 303","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن محمد بن عبد الرحمن بن أبي ليلى عن عمران بن محمد ابن أبي ليلى عن محمد بن عمران بن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن عبد الرحمن بن أبي ليلى عن عون"
"19796","304  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، وَالْحَضْرَمِيُّ قَالَا :  ثَنَا  مُحَمَّدُ بْنُ عِمْرَانَ بْنِ أَبِي لَيْلَى ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ أَبِي لَيْلَى  ، عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَرَجَ مُسَافِرًا فَلَمْ يَزَلْ يُصَلِّي رَكْعَتَيْنِ حَتَّى رَجَعَ  .","","Al-Mu'jam al-Kabir 304","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن محمد بن عبد الرحمن بن أبي ليلى عن عمران بن محمد ابن أبي ليلى عن محمد بن عمران بن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن عبد الرحمن بن أبي ليلى عن عون"
"19797","305  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  هَارُونُ بْنُ إِسْحَاقَ ، فِي مُسْنَدِ أَبِي جُحَيْفَةَ ، قَالَ :  ثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  صَلَّيْتُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الظُّهْرَ  بِمِنًى  رَكْعَتَيْنِ  قَالَ  الْحَضْرَمِيُّ  :  وَهَذَا وَهْمٌ ، إِنَّمَا هُوَ  وَكِيعٌ  ، عَنْ  سُفْيَانَ  وَابْنِ أَبِي لَيْلَى  .","","Al-Mu'jam al-Kabir 305","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن محمد بن عبد الرحمن بن أبي ليلى عن سفيان الثوري عن وكيع بن الجراح عن هارون بن إسحاق الهمداني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن عبد الرحمن بن أبي ليلى عن عون"
"19798","306  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عِمْرَانَ بْنِ أَبِي لَيْلَى ،  حَدَّثَنِي  أَبِي ،  عَنِ  ابْنِ أَبِي لَيْلَى  ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  دَنَوْتُ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ  بِالْأَبْطَحِ  حِينَ زَالَتِ الشَّمْسُ  ، فَخَرَجَ  بِلَالٌ  فَأَذَّنَ بِالصَّلَاةِ  .","","Al-Mu'jam al-Kabir 306","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن محمد بن عبد الرحمن بن أبي ليلى عن عمران بن محمد ابن أبي ليلى عن محمد بن عمران بن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن عبد الرحمن بن أبي ليلى عن عون"
"19799","[22/120]      عِمْرَانُ بْنُ أَبِي زَائِدَةَ  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  307  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، وَحَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ قَالَا :  ثَنَا  عُمَرُ بْنُ أَبِي زَائِدَةَ ،  أَنَا  عَوْنُ بْنُ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  : أَنَّهُ  رَأَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  قُبَّةٍ  حَمْرَاءَ مِنْ أَدَمٍ  قَالَ : فَرَأَيْتُ  بِلَالًا  أَخْرَجَ وَضُوءَهُ فَرَأَيْتُ النَّاسَ يَبْتَدِرُونَ ذَلِكَ الْوَضُوءَ ، فَمَنْ أَصَابَ مِنْهُ شَيْئًا تَمَسَّحَ بِهِ ، وَمَنْ لَمْ يُصِبْ مِنْهُ شَيْئًا أَخَذَ مِنْ بَلَلِ يَدِ صَاحِبِهِ ، ثُمَّ رَأَيْتُ  بِلَالًا  أَخْرَجَ  عَنَزَةً  فَرَكَزَهَا ، وَخَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  حُلَّةٍ  حَمْرَاءَ مُشَمِّرًا ، فَصَلَّى إِلَى  الْعَنَزَةِ  بِالنَّاسِ رَكْعَتَيْنِ ، وَرَأَيْتُ النَّاسَ وَالدَّوَابَّ يَمُرُّونَ بَيْنَ يَدَيِ  الْعَنَزَةِ  .","","Al-Mu'jam al-Kabir 307","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عمر بن أبي زائدة الهمداني عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمران بن أبي زائدة عن عون بن أبي جحيفة"
"19800","يُونُسُ بْنُ أَبِي يَعْفُورٍ  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  308  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ ،  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  يُونُسُ بْنُ أَبِي يَعْفُورٍ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  قَالَ :  كُنْتُ مَعَ عَمِّي عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَخْطُبُ ، فَقَالَ :  لَا تَزَالُ أَمْرُ أُمَّتِي صَالِحًا حَتَّى يَمْضِيَ اثْنَا عَشَرَ  خَلِيفَةً  وَخَفَضَ بِهَا صَوْتَهُ ،  فَقُلْتُ  لِعَمِّي وَكَانَ أَمَامِي : مَا قَالَ يَا عَمِّ ؟ قَالَ : يَا بُنَيَّ ، كُلُّهُمْ مِنْ  قُرَيْشٍ  .","","Al-Mu'jam al-Kabir 308","","سمرة بن جنادة السوائي عن وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن يونس بن أبي يعفور العبدي عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","يونس بن أبي يعفور عن عون بن أبي جحيفة"
