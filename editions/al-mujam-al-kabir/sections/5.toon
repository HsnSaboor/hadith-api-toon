hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"2401","2403  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنْ  عَلِيِّ بْنِ مُدْرِكٍ ،  عَنْ  أَبِي زُرْعَةَ بْنِ عَمْرِو بْنِ جَرِيرٍ ،  ثَنَا  جَرِيرٌ ، قَالَ :  سَأَلْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ النَّظْرَةِ فَقَالَ : "" اصْرِفْ  .","","Al-Mu'jam al-Kabir 2403","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو زرعة بن عمرو بن جرير الغلابي عن علي بن مدرك الوهبيلي عن أشعث بن سوار عن قيس بن الربيع الأسدي عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","أبو زرعة بن عمرو بن جرير عن جده"
"2402","2404  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ، (  ح  )  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي ، وَمُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالُوا :  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ، قَالَا :  ثَنَا  سُفْيَانُ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  عَمْرِو بْنِ سَعِيدٍ ،  عَنْ  أَبِي زُرْعَةَ بْنِ عَمْرِو بْنِ جَرِيرٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  سَأَلْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ نَظْرَةِ الْفُجَاءَةِ ؟  فَأَمَرَنِي أَنْ أَصْرِفَ بَصَرِي  .","","Al-Mu'jam al-Kabir 2404","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو زرعة بن عمرو بن جرير الغلابي عن عمرو بن سعيد الخولاني عن يونس بن عبيد عن سفيان الثوري عن محمد بن كثير العبدي عن أبو مسلم الكجي عن الطبراني","أبو زرعة بن عمرو بن جرير عن جده"
"2403","2405  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ، وَعَبْدُ الْوَارِثِ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  عَمْرِو بْنِ سَعِيدٍ ،  عَنْ  أَبِي زُرْعَةَ بْنِ عَمْرِو بْنِ جَرِيرٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  سَأَلْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ نَظْرَةِ الْفَجْأَةِ ؟  فَأَمَرَنِي أَنْ أَصْرِفَ بَصَرِي  .","","Al-Mu'jam al-Kabir 2405","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو زرعة بن عمرو بن جرير الغلابي عن عمرو بن سعيد الخولاني عن يونس بن عبيد عن عبد الوارث بن سعيد بن ذكوان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","أبو زرعة بن عمرو بن جرير عن جده"
"2404","2406  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدٌ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  عَمْرِو بْنِ سَعِيدٍ ،  عَنْ  أَبِي زُرْعَةَ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 2406","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو زرعة بن عمرو بن جرير الغلابي عن عمرو بن سعيد الخولاني عن يونس بن عبيد عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن الحسين بن إسحاق التستري عن الطبراني","أبو زرعة بن عمرو بن جرير عن جده"
"2405","2407  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  عَمْرِو بْنِ سَعِيدٍ ،  عَنْ  أَبِي زُرْعَةَ بْنِ عَمْرِو بْنِ جَرِيرٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ  جَرِيرًا سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ نَظْرَةِ الْفُجَاءَةِ ، فَقَالَ :  اصْرِفْ بَصَرَكَ  .","","Al-Mu'jam al-Kabir 2407","","جرير بن عبد الله بن جابر يوسف الأمة عن عمرو بن جرير بن عبد الله البجلي عن أبو زرعة بن عمرو بن جرير الغلابي عن عمرو بن سعيد الخولاني عن يونس بن عبيد عن حماد بن سلمة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","أبو زرعة بن عمرو بن جرير عن جده"
"2406","2408  -  حَدَّثَنَا  أَبُو حَصِينٍ ،  حَدَّثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  عَمْرِو بْنِ سَعِيدٍ ،  عَنْ  أَبِي زُرْعَةَ بْنِ عَمْرِو بْنِ جَرِيرٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2408","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو زرعة بن عمرو بن جرير الغلابي عن عمرو بن سعيد الخولاني عن يونس بن عبيد عن عبد السلام بن حرب الملائي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","أبو زرعة بن عمرو بن جرير عن جده"
"2407","[2/338]      2409  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ، وَمُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  عَمْرِو بْنِ سَعِيدٍ ،  عَنْ  أَبِي زُرْعَةَ بْنِ عَمْرِو بْنِ جَرِيرٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَلْوِي نَاصِيَةَ فَرَسٍ بَيْنَ إِصْبَعَيْهِ ، وَقَالَ :  الْخَيْرُ  مَعْقُودٌ  فِي نَوَاصِي الْخَيْلِ إِلَى يَوْمِ الْقِيَامَةِ  الْغَنِيمَةُ وَالْأَجْرُ  .","","Al-Mu'jam al-Kabir 2409","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو زرعة بن عمرو بن جرير الغلابي عن عمرو بن سعيد الخولاني عن يونس بن عبيد عن سفيان الثوري عن محمد بن كثير العبدي عن محمد بن محمد بن حيان التمار عن الطبراني","أبو زرعة بن عمرو بن جرير عن جده"
"2408","2410  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ، (  ح  ) ،  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ، قَالَ :  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  عَمْرِو بْنِ سَعِيدٍ ،  عَنْ  أَبِي زُرْعَةَ بْنِ عَمْرِو بْنِ جَرِيرٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى السَّمْعِ وَالطَّاعَةِ  وَالنُّصْحِ لِكُلِّ مُسْلِمٍ  .","","Al-Mu'jam al-Kabir 2410","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو زرعة بن عمرو بن جرير الغلابي عن عمرو بن سعيد الخولاني عن يونس بن عبيد عن يزيد بن زريع العيشي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","أبو زرعة بن عمرو بن جرير عن جده"
"2409","2411  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ، (  ح  ) ،  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُعَلَّى بْنُ مَهْدِيٍّ ، قَالَا :  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  عَمْرِو بْنِ سَعِيدٍ ،  عَنْ  أَبِي زُرْعَةَ بْنِ عَمْرِو بْنِ جَرِيرٍ ،  عَنْ  جَرِيرٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْخَيْلُ  مَعْقُودٌ  فِي نَوَاصِيهَا الْخَيْرُ  إِلَى يَوْمِ الْقِيَامَةِ ؛ الْأَجْرُ وَالْغَنِيمَةُ  .","","Al-Mu'jam al-Kabir 2411","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو زرعة بن عمرو بن جرير الغلابي عن عمرو بن سعيد الخولاني عن يونس بن عبيد عن يزيد بن زريع العيشي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","أبو زرعة بن عمرو بن جرير عن جده"
"2410","2412  -  حَدَّثَنَا  يَحْيَى بْنُ مُحَمَّدِ بْنِ سَهْلٍ الْعَسْكَرِيُّ ،  ثَنَا  أَبُو كَامِلٍ الْجَحْدَرِيُّ ،  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  عَمْرِو بْنِ سَعِيدٍ ،  عَنْ  أَبِي زُرْعَةَ بْنِ عَمْرِو بْنِ جَرِيرٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2412","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو زرعة بن عمرو بن جرير الغلابي عن عمرو بن سعيد الخولاني عن يونس بن عبيد عن عبد الواحد بن زياد عن فضيل بن حسين الجحدري عن يحيى بن محمد بن سهل العسكري عن الطبراني","أبو زرعة بن عمرو بن جرير عن جده"
"2411","2413  -  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  عَمْرٍو ،  عَنْ  أَبِي زُرْعَةَ بْنِ عَمْرِو بْنِ جَرِيرٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2413","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو زرعة بن عمرو بن جرير الغلابي عن عمرو بن سعيد الخولاني عن يونس بن عبيد عن عبد الوارث بن سعيد بن ذكوان عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","أبو زرعة بن عمرو بن جرير عن جده"
"2412","2414  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، وَأَبُو خَلِيفَةَ ، قَالَا :  ثَنَا  مُسَدَّدٌ ،  ثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  عَمْرِو بْنِ سَعِيدٍ ،  عَنْ  أَبِي زُرْعَةَ بْنِ عَمْرِو         [2/339]      بْنِ جَرِيرٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى السَّمْعِ وَالطَّاعَةِ وَالنُّصْحِ لِكُلِّ مُسْلِمٍ  فَكَانَ إِذَا اشْتَرَى شَيْئًا أَوْ بَاعَهُ قَالَ لِصَاحِبِهِ : اعْلَمْ أَنَّ مَا آخُذُ مِنْكَ أَحَبُّ إِلَيْنَا مِمَّا أَعْطَيْنَاكَ فَاخْتَرْ  .","","Al-Mu'jam al-Kabir 2414","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو زرعة بن عمرو بن جرير الغلابي عن عمرو بن سعيد الخولاني عن يونس بن عبيد عن عبد الوارث بن سعيد بن ذكوان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","أبو زرعة بن عمرو بن جرير عن جده"
"2413","2415  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدٌ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  عَمْرِو بْنِ سَعِيدٍ ،  عَنْ  أَبِي زُرْعَةَ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2415","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو زرعة بن عمرو بن جرير الغلابي عن عمرو بن سعيد الخولاني عن يونس بن عبيد عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن الحسين بن إسحاق التستري عن الطبراني","أبو زرعة بن عمرو بن جرير عن جده"
"2414","2416  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ الرَّقِّيُّ ،  ثَنَا  مُعَلَّى بْنُ أَسَدٍ ،  ثَنَا  وُهَيْبٌ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  عَمْرِو بْنِ سَعِيدٍ ،  عَنْ  أَبِي زُرْعَةَ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2416","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو زرعة بن عمرو بن جرير الغلابي عن عمرو بن سعيد الخولاني عن يونس بن عبيد عن وهيب بن خالد الكرابيسي عن معلى بن أسد عن حفص بن عمر سنجة ألف عن الطبراني","أبو زرعة بن عمرو بن جرير عن جده"
"2415","2417  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  الْحُسَيْنُ بْنُ حُرَيْثٍ ،  ثَنَا  الْفَضْلُ بْنُ مُوسَى ،  عَنْ  عِيسَى بْنِ عُبَيْدٍ ،  عَنْ  غَيْلَانَ بْنِ عَبْدِ اللهِ الْعَامِرِيِّ ،  عَنْ  أَبِي زُرْعَةَ بْنِ عَمْرِو بْنِ جَرِيرٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ أَوْحَى إِلَيَّ أَيَّ هَؤُلَاءِ الثَّلَاثِ نَزَلْتَ فَهِيَ دَارُ هِجْرَتِكَ  :  الْمَدِينَةَ  ، أَوِ  الْبَحْرَيْنِ  ، أَوْ  قِنَّسْرِينَ  .","","Al-Mu'jam al-Kabir 2417","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو زرعة بن عمرو بن جرير الغلابي عن غيلان بن عبد الله العامري عن عيسى بن عبيد الكندي عن الفضل بن موسى السيناني عن الحسين بن حريث الخزاعي عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو زرعة بن عمرو بن جرير عن جده"
"2416","2418  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ثَنَا  مُسَدَّدٌ ،  ثَنَا  خَالِدُ بْنُ زِيَادٍ الزَّيَّاتُ  ،  حَدَّثَنِي  أَبُو زُرْعَةَ بْنُ عَمْرِو بْنِ جَرِيرٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  لَمَّا قَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْمَدِينَةَ  قَالَ لِأَصْحَابِهِ :  انْطَلِقُوا بِنَا إِلَى  أَهْلِ قُبَاءَ  فَنُسَلِّمَ عَلَيْهِمْ  ، فَأَتَاهُمْ         [2/340]      فَسَلَّمَ عَلَيْهِمْ وَرَحَّبُوا بِهِ ، ثُمَّ قَالَ : "" يَا  أَهْلَ قُبَاءَ  ائْتُونِي  بِأَحْجَارٍ  مِنْ هَذِهِ  الْحَرَّةِ  "" ، فَجُمِعَتْ عِنْدَهُ أَحْجَارٌ كَثِيرَةٌ وَمَعَهُ  عَنَزَةٌ  لَهُ ، فَخَطَّ قِبْلَتَهُمْ ، فَأَخَذَ حَجَرًا ، فَوَضَعَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثُمَّ قَالَ : "" يَا  أَبَا بَكْرٍ  خُذْ حَجَرًا ، فَضَعْهُ إِلَى حَجَرِي "" ، ثُمَّ قَالَ : "" يَا  عُمَرُ  خُذْ حَجَرًا فَضَعْهُ إِلَى جَنْبِ حَجَرِ  أَبِي بَكْرٍ  "" ، ثُمَّ الْتَفَتَ فَقَالَ : "" يَا  عُثْمَانُ  خُذْ حَجَرًا فَضَعْهُ إِلَى جَنْبِ حَجَرِ  عُمَرَ  "" ، ثُمَّ الْتَفَتَ إِلَى النَّاسِ بِأَخَرَةٍ فَقَالَ : "" وَضَعَ رَجُلٌ حَجَرَهُ حَيْثُ أَحَبَّ عَلَى ذِي  الْخَطِّ  .  كذا في طبعة مكتبة ابن تيمية ، ولعل الصواب : (خالد بن يزيد الزيات ) .","","Al-Mu'jam al-Kabir 2418","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو زرعة بن عمرو بن جرير الغلابي عن خالد بن يزيد الكوفي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","أبو زرعة بن عمرو بن جرير عن جده"
"2417","2419  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ بَكْرٍ السَّرَّاجُ الْعَسْكَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الْفَرَجِ ،  ثَنَا  مُحَمَّدُ بْنُ الزِّبْرِقَانِ ،  عَنْ  مَرْوَانَ بْنِ سَالِمٍ ،  عَنْ  أَبِي زُرْعَةَ بْنِ عَمْرِو بْنِ جَرِيرٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ قَرَأَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      حِينَ يَدْخُلُ مَنْزِلَهُ  نَفَتِ الْفَقْرَ عَنْ أَهْلِ ذَلِكَ الْمَنْزِلِ وَالْجِيرَانِ  .","","Al-Mu'jam al-Kabir 2419","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو زرعة بن عمرو بن جرير الغلابي عن مروان بن سالم الغفاري عن محمد بن الزبرقان الأهوازي عن محمد بن الفرج الفراء عن محمد بن عبد الله بن بكر السراج عن الطبراني","أبو زرعة بن عمرو بن جرير عن جده"
"2418","2420  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  أَحْمَدُ بْنُ مَنْصُورٍ الرَّمَادِيُّ ،  ثَنَا  خَالِدُ بْنُ عَمْرٍو الْأُمَوِيُّ ،  ثَنَا  مَالِكُ بْنُ مِغْوَلٍ ،  عَنْ  أَبِي زُرْعَةَ ،  عَنْ  جَرِيرٍ ، قَالَ :  كَانَ إِذَا قَدِمَتْ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْوُفُودُ دَعَاهُمْ  فَبَاهَاهُمْ بِي  .","","Al-Mu'jam al-Kabir 2420","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو زرعة بن عمرو بن جرير الغلابي عن مالك بن مغول الصهيبي عن خالد بن عمرو السعيدي عن أحمد بن منصور الرمادي عن البزار عن الطبراني","أبو زرعة بن عمرو بن جرير عن جده"
"2419","بَابٌ  هَمَّامُ بْنُ الْحَارِثِ  عَنْ  جَرِيرٍ  2421  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هَمَّامِ بْنِ الْحَارِثِ ، قَالَ :  رَأَيْتُ  جَرِيرَ بْنَ عَبْدِ اللهِ ، "" بَالَ ثُمَّ مَسَحَ عَلَى خُفَّيْهِ  فَقِيلَ لَهُ ، فَقَالَ : "" رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَعَلَ ذَلِكَ  ، قَالَ  إِبْرَاهِيمُ  :  فَكَانُوا يَرَوْنَ أَنَّ الْمَسْحَ كَانَ بَعْدَ نُزُولِ الْمَائِدَةِ ؛ لِأَنَّ  جَرِيرًا  كَانَ مِنْ آخِرِهِمْ إِسْلَامًا  "" .","","Al-Mu'jam al-Kabir 2421","","جرير بن عبد الله بن جابر يوسف الأمة عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","همام بن الحارث عن جرير"
"2420","[2/341]      2422  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ، (  ح  )  وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْحَكَمِ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هَمَّامِ بْنِ الْحَارِثِ ، قَالَ :  رَأَيْتُ  جَرِيرَ بْنَ عَبْدِ اللهِ "" تَوَضَّأَ مِنْ مِطْهَرَةِ الْمَسْجِدِ ، فَمَسَحَ عَلَى خُفَّيْهِ  فَقِيلَ لَهُ فِي ذَلِكَ ، فَقَالَ : وَمَا يَمْنَعُنِي ، وَقَدْ رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَفْعَلُهُ  .","","Al-Mu'jam al-Kabir 2422","","جرير بن عبد الله بن جابر يوسف الأمة عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن سفيان بن عيينة عن عبد الله بن عبد الحكم بن أعين عن يوسف بن يزيد القراطيسي عن الطبراني","همام بن الحارث عن جرير"
"2421","2423  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هَمَّامِ بْنِ الْحَارِثِ ، قَالَ :  بَالَ  جَرِيرٌ  ، فَتَوَضَّأَ وَمَسَحَ عَلَى الْخُفَّيْنِ  فَعَابَ ذَلِكَ عَلَيْهِ  رَجُلٌ  مِنَ  الْقَوْمِ  ،  فَقَالَ  جَرِيرٌ : "" إِنْ أَفْعَلْ فَقَدْ رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَعَلَ هَذَا  .","","Al-Mu'jam al-Kabir 2423","","جرير بن عبد الله بن جابر يوسف الأمة عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","همام بن الحارث عن جرير"
"2422","2424  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هَمَّامِ بْنِ الْحَارِثِ ،  عَنْ  جَرِيرٍ ، قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَمْسَحُ عَلَى خُفَّيْهِ  ، قَالَ  إِبْرَاهِيمُ  :  فَكَانَ أَصْحَابُنَا يُعْجَبُونَ بِحَدِيثِ  جَرِيرٍ  ، يَقُولُونَ : كَانَ إِسْلَامُهُ بَعْدَ نُزُولِ الْمَائِدَةِ  "" .","","Al-Mu'jam al-Kabir 2424","","جرير بن عبد الله بن جابر يوسف الأمة عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن حماد بن أسامة القرشي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","همام بن الحارث عن جرير"
"2423","2425  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هَمَّامِ بْنِ الْحَارِثِ :  أَنَّ جَرِيرًا "" بَالَ فَتَوَضَّأَ ، وَمَسَحَ عَلَى خُفَّيْهِ  فَقِيلَ لَهُ ، فَقَالَ : "" رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَفْعَلُهُ  .","","Al-Mu'jam al-Kabir 2425","","جرير بن عبد الله بن جابر يوسف الأمة عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن الوضاح بن عبد الله اليشكري عن حجاج بن المنهال الأنماطي عن أبو مسلم الكجي عن الطبراني","همام بن الحارث عن جرير"
"2424","2426  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هَمَّامِ بْنِ الْحَارِثِ ،  أَنَّ  جَرِيرًا "" بَالَ ثُمَّ تَوَضَّأَ ، وَمَسَحَ عَلَى خُفَّيْهِ  ، وَقَالَ : "" رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَفْعَلُهُ  .","","Al-Mu'jam al-Kabir 2426","","جرير بن عبد الله بن جابر يوسف الأمة عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","همام بن الحارث عن جرير"
"2425","2427  -  حَدَّثَنَا  أَحْمَدُ بْنُ شُعَيْبٍ النَّسَائِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ رَافِعٍ النَّيْسَابُورِيُّ ،  ثَنَا  مُصْعَبُ بْنُ الْمِقْدَامِ ،  عَنْ  دَاوُدَ الطَّائِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هَمَّامِ بْنِ الْحَارِثِ ،  عَنْ  جَرِيرٍ :  أَنَّهُ رَأَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ  ، وَمَسَحَ         [2/342]      عَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 2427","","جرير بن عبد الله بن جابر يوسف الأمة عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن داود بن نصير الطائي عن مصعب بن المقدام الخثعمي عن محمد بن رافع القشيري عن النسائي عن الطبراني","همام بن الحارث عن جرير"
"2426","2428  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ حَسَّانَ الْبُرْجُنَانِيُّ  ،  ثَنَا  مُحَمَّدُ بْنُ يَزِيدَ الْوَاسِطِيُّ ،  عَنْ  جَعْفَرِ بْنِ الْحَارِثِ ،  عَنْ  سُلَيْمَانَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هَمَّامِ بْنِ الْحَارِثِ ، قَالَ :  بَالَ جَرِيرٌ ثُمَّ تَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ ، فَقُلْتُ لَهُ : أَتَفْعَلُ هَذَا وَقَدْ بُلْتَ ؟ قَالَ :  فَإِنِّي رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَالَ ثُمَّ تَوَضَّأَ  ، وَمَسَحَ عَلَى خُفَّيْهِ  .  كذا في طبعة مكتبة ابن تيمية وهو مصحف ، وصوابه : (البرجلاني) .","","Al-Mu'jam al-Kabir 2428","","جرير بن عبد الله بن جابر يوسف الأمة عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن جعفر بن الحارث الواسطي عن محمد بن يزيد الكلاعي عن محمد بن حسان البرجلاني عن بحشل عن الطبراني","همام بن الحارث عن جرير"
"2427","2429  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ مَنْصُورٍ الطُّوسِيُّ ،  ثَنَا  عَبْدُ الصَّمَدِ بْنُ النُّعْمَانِ ،  ثَنَا  حَمْزَةُ الزَّيَّاتُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هَمَّامِ بْنِ الْحَارِثِ ، قَالَ :  بَالَ جَرِيرٌ فَتَوَضَّأَ ، وَمَسَحَ عَلَى خُفَّيْهِ  وَقَالَ : "" رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَفْعَلُهُ  .","","Al-Mu'jam al-Kabir 2429","","جرير بن عبد الله بن جابر يوسف الأمة عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن حمزة الزيات عن عبد الصمد بن النعمان البغدادي عن محمد بن منصور الطوسي عن علي بن سعيد بن بشير عليك عن الطبراني","همام بن الحارث عن جرير"
"2428","2430  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هَمَّامِ بْنِ الْحَارِثِ ،  عَنْ  جَرِيرٍ رَضِيَ اللهُ عَنْهُ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ  ، وَمَسَحَ عَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 2430","","جرير بن عبد الله بن جابر يوسف الأمة عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","همام بن الحارث عن جرير"
"2429","2431  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  عَبْدُ اللهِ بْنُ عَمْرِو بْنِ أَبَانَ  ،  ثَنَا  عُبَيْدَةُ بْنُ الْأَسْوَدِ ،  ثَنَا  الْقَاسِمُ بْنُ الْوَلِيدِ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنْ  هَمَّامِ بْنِ الْحَارِثِ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لِلْمُسَافِرِ ثَلَاثٌ ، وَلِلْمُقِيمِ يَوْمٌ فِي الْمَسْحِ عَلَى الْخُفَّيْنِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عبد الله بن عمر بن أبان )","","Al-Mu'jam al-Kabir 2431","","جرير بن عبد الله بن جابر يوسف الأمة عن همام بن الحارث بن قيس النخعي عن إبراهيم بن يزيد بن شريك التيمي عن طلحة بن مصرف الهمداني عن القاسم بن الوليد الخبذعي عن عبيدة بن الأسود بن سعيد الهمداني عن عبد الله بن عمر مشكدانة عن عبد الله بن أحمد بن حنبل عن الطبراني","همام بن الحارث عن جرير"
"2430","2432  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  مُحَمَّدُ بْنُ سَلَّامٍ الْجُمَحِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هَمَّامِ بْنِ الْحَارِثِ ،  عَنْ  جَرِيرٍ : "" عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ تَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 2432","","جرير بن عبد الله بن جابر يوسف الأمة عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن محمد بن سلام الجمحي عن عبد الله بن أحمد بن حنبل عن الطبراني","همام بن الحارث عن جرير"
"2431","2433  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ الْأَصْبَهَانِيُّ  ، ثَنَا  حَبِيبُ بْنُ بِشْرٍ ،  ثَنَا  حَمَّادُ بْنُ مَسْعَدَةَ ،  عَنْ  شُعْبَةَ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هَمَّامِ بْنِ الْحَارِثِ ،  أَنَّهُ رَأَى جَرِيرَ بْنَ عَبْدِ اللهِ "" بَالَ ، وَمَسَحَ عَلَى الْخُفَّيْنِ ، وَصَلَّى "" فَسُئِلَ عَنْ ذَلِكَ ، فَقَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَمْسَحُ عَلَيْهِمَا  .","","Al-Mu'jam al-Kabir 2433","","جرير بن عبد الله بن جابر يوسف الأمة عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن حماد بن أبي سليمان عن شعبة بن الحجاج عن حماد بن مسعدة عن حبيب بن بشر عن محمد بن العباس ابن الأخرم عن الطبراني","همام بن الحارث عن جرير"
"2432","2434  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ حُمَيْدٍ ،  ثَنَا         [2/343]      الْحَكَمُ بْنُ بَشِيرٍ ،  عَنْ  عَمْرِو بْنِ قَيْسٍ الْمُلَائِيِّ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هَمَّامٍ ،  عَنْ  جَرِيرٍ :  أَنَّهُ تَوَضَّأَ ، وَمَسَحَ عَلَى خُفَّيْهِ "" فَقِيلَ لَهُ ، فَقَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَمْسَحُ فَمَسَحْتُ  .","","Al-Mu'jam al-Kabir 2434","","جرير بن عبد الله بن جابر يوسف الأمة عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن حماد بن أبي سليمان عن عمرو بن قيس الملائي عن الحكم بن  أبى إسماعيل النهدي عن محمد بن حميد الرازي عن الحسين بن إسحاق التستري عن الطبراني","همام بن الحارث عن جرير"
"2433","2435  -  حَدَّثَنَا  صَالِحُ بْنُ أَحْمَدَ بْنِ أَبِي مُقَاتِلٍ  ، ثَنَا  مُحَمَّدُ بْنُ حَسَّانَ الْوَاسِطِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ يَزِيدَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هَمَّامٍ ، قَالَ :  بَالَ جَرِيرٌ وَتَوَضَّأَ ، وَمَسَحَ عَلَى خُفَّيْهِ  ، وَقَالَ : "" رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَعَلَ مِثْلَ ذَلِكَ  .","","Al-Mu'jam al-Kabir 2435","","جرير بن عبد الله بن جابر يوسف الأمة عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن شعبة بن الحجاج عن محمد بن يزيد الكلاعي عن محمد بن حسان بن فيروز البرجماني عن صالح بن أبي مقاتل القيراطي عن الطبراني","همام بن الحارث عن جرير"
"2434","2436  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ الْأَصْبَهَانِيُّ  ، ثَنَا  حَمَّادُ بْنُ الْحَسَنِ بْنِ عَنْبَسَةَ ،  ثَنَا  حَجَّاجُ بْنُ نُصَيْرٍ ،  ثَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ، قَالَ :  سَمِعْتُ  إِبْرَاهِيمَ ،  يُحَدِّثُ عَنْ  هَمَّامِ بْنِ الْحَارِثِ ،  أَنَّ  جَرِيرًا "" بَالَ ثُمَّ تَوَضَّأَ ، وَمَسَحَ عَلَى خُفَّيْهِ  ثُمَّ قَالَ : "" رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَفْعَلُ مِثْلَ هَذَا  .","","Al-Mu'jam al-Kabir 2436","","جرير بن عبد الله بن جابر يوسف الأمة عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن حجاج بن نصير الفساطيطي عن حماد بن الحسن بن عنبسة النهشلي عن محمد بن العباس ابن الأخرم عن الطبراني","همام بن الحارث عن جرير"
"2435","أَبُو الضُّحَى مُسْلِمُ بْنُ صُبَيْحٍ  عَنْ  جَرِيرٍ  2437  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مُحَمَّدُ بْنُ قَيْسٍ الْأَسَدِيُّ ،  عَنْ  مُسْلِمِ بْنِ صُبَيْحٍ ، قَالَ :  سَمِعْتُ  جَرِيرَ بْنَ عَبْدِ اللهِ وَهُوَ يَخْطُبُ النَّاسَ ، وَكَانَ مِمَّا يَفْعَلُ يَأْتِي الْمِنْبَرَ حَتَّى يَقُومَ عَلَيْهِ ، فَسَمِعْتُهُ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ سَنَّ فِي الْإِسْلَامِ سُنَّةً حَسَنَةً ، فَلَهُ مِثْلُ أَجْرِ مَنْ عَمِلَ بِهَا فِي أَنْ لَا يَنْقُصَ مِنْ أُجُورِهِمْ شَيْءٌ  ، وَمَنْ سَنَّ فِي الْإِسْلَامِ سُنَّةً سَيِّئَةً فَعَلَيْهِ مِثْلُ وِزْرِ مَنْ عَمِلَ بِهَا فِي أَنَّهُ لَا يَنْقُصُ مِنْ أَوْزَارِهِمْ شَيْءٌ  .","","Al-Mu'jam al-Kabir 2437","","جرير بن عبد الله بن جابر يوسف الأمة عن مسلم بن صبيح الهمداني عن محمد بن قيس الوالبي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو الضحى مسلم بن صبيح عن جرير"
"2436","عَبْدُ الرَّحْمَنِ بْنُ هِلَالٍ الْعَبْسِيُّ  عَنْ  جَرِيرٍ  بَابٌ  2438  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سُوَيْدٍ الشِّبَامِيُّ  ، ثَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُوسَى بْنِ عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ هِلَالٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُهَاجِرُونَ  وَالْأَنْصَارُ  بَعْضُهُمْ         [2/344]      أَوْلِيَاءُ بَعْضٍ فِي الدُّنْيَا وَالْآخِرَةِ  ،  وَالطُّلَقَاءُ  مِنْ  قُرَيْشٍ  ، وَالْعُتَقَاءُ مِنْ  ثَقِيفٍ  بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ فِي الدُّنْيَا وَالْآخِرَةِ  .","","Al-Mu'jam al-Kabir 2438","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الرحمن بن هلال العبسي عن موسى بن عبد الله بن يزيد الخطمي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إبراهيم بن محمد بن عبد الله الشبامي عن الطبراني","عبد الرحمن بن هلال العبسي عن جرير"
"2437","2439  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  ، أَنَا  عَبْدُ الرَّزَّاقِ  أَنَا  مَعْمَرٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  حُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ هِلَالٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ الْبَجَلِيِّ ،  أَنَّ  رَجُلًا مِنَ الْأَنْصَارِ  جَاءَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِصُرَّةٍ مِنْ ذَهَبٍ يَمْلَأُ مَا بَيْنَ أَصَابِعِهِ ، فَقَالَ : هَذِهِ فِي  سَبِيلِ  اللهِ ، ثُمَّ قَامَ  أَبُو بَكْرٍ  رَضِيَ اللهُ عَنْهُ ، فَأَعْطَاهُ ، ثُمَّ قَامَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ فَأَعْطَاهُ ، ثُمَّ قَامَ  الْمُهَاجِرُونَ  وَالْأَنْصَارُ  ، فَأَعْطَوْا فَأَشْرَقَ وَجْهُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى رَأَيْنَا الْإِشْرَاقَ فِي وَجْنَتِهِ ، ثُمَّ قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنِ اسْتَنَّ سُنَّةً صَالِحَةً فِي الْإِسْلَامِ ، فَعُمِلَ بِهَا بَعْدَهُ كَانَ لَهُ مِثْلُ أُجُورِهِمْ مِنْ غَيْرِ أَنْ يَنْقُصَ مِنْ أُجُورِهِمْ شَيْءٌ  ، وَمَنْ سَنَّ فِي الْإِسْلَامِ سُنَّةً سَيِّئَةً فَعُمِلَ بِهَا بَعْدَهُ كَانَ عَلَيْهِ مِثْلُ أَوْزَارِهِمْ مِنْ غَيْرِ أَنْ يَنْقُصَ مِنْ أَوْزَارِهِمْ شَيْءٌ  .  سقط من طبعة مكتبة ابن تيمية والمثبت من النسخ الخطية","","Al-Mu'jam al-Kabir 2439","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الرحمن بن هلال العبسي عن حميد بن هلال العدوي عن قتادة بن دعامة عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عبد الرحمن بن هلال العبسي عن جرير"
"2438","2440  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ ثَعْلَبَةَ بْنِ سَوَاءٍ ،  حَدَّثَنَا  عَمِّي مُحَمَّدُ بْنُ سَوَاءٍ ،  حَدَّثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  حُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ هِلَالٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 2440","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الرحمن بن هلال العبسي عن حميد بن هلال العدوي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن محمد بن سواء السدوسي عن محمد بن ثعلبة السدوسي عن إبراهيم بن هاشم البغوي عن الطبراني","عبد الرحمن بن هلال العبسي عن جرير"
"2439","2441  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ، (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ أَبِي إِسْمَاعِيلَ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ هِلَالٍ الْعَبْسِيُّ ، قَالَ :  قَالَ  جَرِيرُ بْنُ عَبْدِ اللهِ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَسُنُّ الْعَبْدُ سُنَّةً صَالِحَةً يُعْمَلُ بِهَا بَعْدَهُ إِلَّا كَانَ لَهُ مِثْلُ أَجْرِ مَنْ يَعْمَلُ بِهَا لَا يَنْقُصُ مِنْ أُجُورِهِمْ شَيْءٌ  ، وَلَا يَسْتَنُّ عَبْدٌ سُنَّةً سَيِّئَةً يُعْمَلُ بِهَا بَعْدَهُ إِلَّا كَانَ عَلَيْهِ مِثْلُ وِزْرِ مَنْ يَعْمَلُ بِهَا لَا يَنْقُصُ مِنْ أَوْزَارِهِمْ شَيْءٌ "" ، وَأَتَى نَاسٌ مِنَ الْأَعْرَابِ فَقَالُوا : يَأْتِينَا مُصَدِّقُوكَ فَيَظْلِمُونَنَا ، قَالَ : "" أَرْضُوا مُصَدِّقِيكُمْ  .","","Al-Mu'jam al-Kabir 2441","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الرحمن بن هلال العبسي عن محمد بن أبي إسماعيل السلمي عن علي بن مسهر القرشي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","عبد الرحمن بن هلال العبسي عن جرير"
"2440","2442  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  الْحَسَنُ بْنُ سَهْلٍ ،  ثَنَا         [2/345]      عِمْرَانُ بْنُ عُيَيْنَةَ ،  حَدَّثَنِي  الْحَسَنُ بْنُ عُبَيْدِ اللهِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ هِلَالٍ الْعَبْسِيِّ ،  عَنْ  جَرِيرٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ أَحَدٍ يَسُنُّ سُنَّةً حَسَنَةً فِي الْإِسْلَامِ  ، فَيُعْمَلُ بِهَا مِنْ بَعْدِهِ إِلَّا كَانَ لَهُ مِثْلُ أَجْرِ مَنْ عَمِلَ بِهَا مِنْ بَعْدِهِ مِنْ غَيْرِ أَنْ يَنْقُصَ مِنْ أُجُورِهِمْ شَيْءٌ ، وَمَنْ سَنَّ سُنَّةً سَيِّئَةً فِي الْإِسْلَامِ ، فَيُعْمَلُ بِهَا مِنْ بَعْدِهِ إِلَّا كَانَ عَلَيْهِ مِثْلُ أَوْزَارِ الَّذِينَ يَعْمَلُونَ بِهَا مِنْ بَعْدِهِ مِنْ غَيْرِ أَنْ يَنْقُصَ مِنْ أَوْزَارِهِمْ شَيْءٌ  .","","Al-Mu'jam al-Kabir 2442","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الرحمن بن هلال العبسي عن الحسن بن عبيد الله النخعي عن عمران بن عيينة الهلالي عن الحسن بن سهل الخياط عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","عبد الرحمن بن هلال العبسي عن جرير"
"2441","2443  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْجَارُودِ الْأَصْبَهَانِيُّ  ، ثَنَا  أَحْمَدُ بْنُ مُعَاوِيَةَ الْأَصْبَهَانِيُّ ،  ثَنَا  حُسَيْنُ بْنُ حَفْصٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنِ  الْحَسَنِ بْنِ عُبَيْدِ اللهِ ،  عَنِ  ابْنِ هِلَالٍ الْعَبْسِيِّ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَا مِنْ رَجُلٍ يَسْتَنُّ فِي الْإِسْلَامِ سُنَّةً حَسَنَةً  ثُمَّ ذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2443","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الرحمن بن هلال العبسي عن الحسن بن عبيد الله النخعي عن إبراهيم بن طهمان عن الحسين بن حفص الهمداني عن أحمد بن معاوية بن الهذيل العنبري عن الجارودي أحمد بن علي الأصبهاني عن الطبراني","عبد الرحمن بن هلال العبسي عن جرير"
"2442","2444  -  حَدَّثَنَا  جَعْفَرُ بْنُ أَحْمَدَ بْنِ سِنَانٍ ،  ثَنَا  سَلْمُ بْنُ جُنَادَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنِ  الْحَسَنِ بْنِ عُبَيْدِ اللهِ ،  عَنِ  ابْنِ هِلَالٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2444","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الرحمن بن هلال العبسي عن الحسن بن عبيد الله النخعي عن عبد الله بن إدريس الأودي عن سلم بن جنادة السوائي عن جعفر بن أحمد بن سنان الواسطي عن الطبراني","عبد الرحمن بن هلال العبسي عن جرير"
"2443","2445  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُوسَى بْنِ عَبْدِ اللهِ بْنِ يَزِيدَ ، وَأَبِي الضُّحَى ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ هِلَالٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ سَنَّ فِي الْإِسْلَامِ سُنَّةً حَسَنَةً فَيُعْمَلُ بِهَا بَعْدَهُ ، كُتِبَ لَهُ مِثْلُ أَجْرِ مَنْ عَمِلَ بِهَا  ، وَلَا يَنْقُصُ مِنْ أَجْرِ مَنْ عَمِلَ بِهَا شَيْءٌ ، وَمَنْ سَنَّ فِي الْإِسْلَامِ سُنَّةً سَيِّئَةً فَعُمِلَ بِهَا بَعْدَهُ كُتِبَ عَلَيْهِ مِثْلُ وِزْرِ مَنْ عَمِلَ بِهَا ، وَلَا يَنْقُصُ مِنْ أَوْزَارِهِمْ شَيْءٌ  .","","Al-Mu'jam al-Kabir 2445","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الرحمن بن هلال العبسي عن مسلم بن صبيح الهمداني عن الأعمش عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","عبد الرحمن بن هلال العبسي عن جرير"
"2444","2446  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  شَيْبَانُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُسْلِمِ بْنِ صُبَيْحٍ ،  وَعَنْ  أَبِي يَزِيدَ الْأَنْصَارِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ هِلَالٍ الْعَبْسِيِّ ،  عَنْ  جَرِيرٍ ، قَالَ :  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَوْمٌ مِنَ الْأَعْرَابِ فَأَبْصَرَ عَلَيْهِمُ  الْخَصَاصَةَ  وَالْجَهْدَ  ، فَخَطَبَ النَّاسَ فَحَمِدَ اللهَ عَزَّ وَجَلَّ وَأَثْنَى عَلَيْهِ ، ثُمَّ أَمَرَهُمْ بِالصَّدَقَةِ ، وَحَضَّهُمْ عَلَيْهَا ، وَرَغَّبَهُمْ فِيهَا ، فَأَبْطَأُوا عَلَيْهِ حَتَّى رُئِيَ ذَلِكَ فِي وَجْهِهِ ، فَجَاءَ  رَجُلٌ  بِقَبْضَةٍ مِنْ         [2/346]      وَرِقٍ  ، فَأَعْطَاهَا إِيَّاهُ ، ثُمَّ جَاءَ  آخَرُ  حَتَّى تَتَابَعَ النَّاسُ بِالصَّدَقَةِ حَتَّى رُئِيَ فِي وَجْهِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ السُّرُورُ ، فَقَالَ :  مَنْ سَنَّ فِي الْإِسْلَامِ سُنَّةً حَسَنَةً ، فَعُمِلَ بِهَا بَعْدَهُ كَانَ لَهُ أَجْرُهَا  ، وَأَجْرُ مَنْ عَمِلَ بِهَا مِنْ غَيْرِ أَنْ يُنْتَقَصَ مِنْ أُجُورِهِمْ شَيْءٌ ، وَمَنْ سَنَّ فِي الْإِسْلَامِ سُنَّةً سَيِّئَةً ، فَعُمِلَ بِهَا مِنْ بَعْدِهِ كَانَ عَلَيْهِ وِزْرُهَا وَوِزْرُ مَنْ عَمِلَ بِهَا مِنْ غَيْرِ أَنْ يَنْقُصَ مِنْ أَوْزَارِهِمْ شَيْءٌ  .","","Al-Mu'jam al-Kabir 2446","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الرحمن بن هلال العبسي عن مسلم بن صبيح الهمداني عن الأعمش عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","عبد الرحمن بن هلال العبسي عن جرير"
"2445","2447  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  ) .  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُسْلِمِ بْنِ صُبَيْحٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ هِلَالٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  جَاءَ نَاسٌ مِنَ الْأَعْرَابِ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2447","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الرحمن بن هلال العبسي عن مسلم بن صبيح الهمداني عن الأعمش عن أبو معاوية الضرير عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","عبد الرحمن بن هلال العبسي عن جرير"
"2446","2448  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ الْأَصْبَهَانِيُّ  ، ثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ النَّرْمَقِيُّ الرَّازِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ ،  حَدَّثَنِي  مُجَالِدٌ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ هِلَالٍ ،  قَالَ  :  أَرْسَلَنِي أَبِي إِلَى جَرِيرِ بْنِ عَبْدِ اللهِ قَالَ : اقْرَأْ عَلَيْهِ السَّلَامَ وَقُلْ لَهُ : كَيْفَ سَمِعْتَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ سَنَّ سُنَّةً صَالِحَةً ، فَاتُّبِعَ فِيهَا ، وَعُمِلَ بِهَا  ، قَالَ : فَأَتَيْتُهُ وَسَأَلْتُهُ ، فَقَالَ : "" لَهُ مِثْلُ أَجْرِ كُلِّ رَجُلٍ عَمِلَ بِهَا مِنْ غَيْرِ أَنْ يَنْقُصَ مِنْ أُجُورِهِمْ شَيْءٌ ، وَمَنْ سَنَّ سُنَّةً سَيِّئَةً فَاتُّبِعَ فِيهَا وَعُمِلَ بِهَا كَانَ عَلَيْهِ مِثْلُ إِثْمِ كُلِّ رَجُلٍ عَمِلَ بِهَا مِنْ غَيْرِ أَنْ يَنْقُصَ مِنْ إِثْمِهِمْ شَيْءٌ  .","","Al-Mu'jam al-Kabir 2448","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الرحمن بن هلال العبسي عن مجالد بن سعيد عن عبد الرحمن بن مغراء الدوسي عن أحمد بن إبراهيم النرمقي عن محمد بن شعيب التاجر عن الطبراني","عبد الرحمن بن هلال العبسي عن جرير"
"2447","2449  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  تَمِيمِ بْنِ سَلَمَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ هِلَالٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ يُحْرَمِ  الرِّفْقَ  يُحْرَمِ الْخَيْرَ  .","","Al-Mu'jam al-Kabir 2449","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الرحمن بن هلال العبسي عن تميم بن سلمة السلمي عن الأعمش عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن عثمان بن عمر الضبي عن الطبراني","عبد الرحمن بن هلال العبسي عن جرير"
"2448","2450  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  حَدَّثَنَا  حَفْصٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  تَمِيمِ بْنِ سَلَمَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ هِلَالٍ ،  عَنْ  جَرِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ يُحْرَمِ  الرِّفْقَ  يُحْرَمِ الْخَيْرَ  .","","Al-Mu'jam al-Kabir 2450","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الرحمن بن هلال العبسي عن تميم بن سلمة السلمي عن الأعمش عن حفص بن غياث النخعي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عبد الرحمن بن هلال العبسي عن جرير"
"2449","2451  -  ثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنِ         [2/347]      الْأَعْمَشِ ،  عَنْ  تَمِيمٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ هِلَالٍ ،  عَنْ  جَرِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ يُحْرَمِ  الرِّفْقَ  يُحْرَمِ الْخَيْرَ  .","","Al-Mu'jam al-Kabir 2451","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الرحمن بن هلال العبسي عن تميم بن سلمة السلمي عن الأعمش عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبد الرحمن بن هلال العبسي عن جرير"
"2450","2452  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  تَمِيمِ بْنِ سَلَمَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ هِلَالٍ ،  عَنْ  جَرِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ يُحْرَمِ  الرِّفْقَ  يُحْرَمِ الْخَيْرَ  .","","Al-Mu'jam al-Kabir 2452","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الرحمن بن هلال العبسي عن تميم بن سلمة السلمي عن الأعمش عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","عبد الرحمن بن هلال العبسي عن جرير"
"2451","2453  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ، وَأَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  تَمِيمِ بْنِ سَلَمَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ هِلَالٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ يُحْرَمِ  الرِّفْقَ  يُحْرَمِ الْخَيْرَ  .","","Al-Mu'jam al-Kabir 2453","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الرحمن بن هلال العبسي عن تميم بن سلمة السلمي عن الأعمش عن أبو معاوية الضرير عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","عبد الرحمن بن هلال العبسي عن جرير"
"2452","2454  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ جَعْفَرٍ الْقَتَّاتُ الْكُوفِيُّ ،  ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ، (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  شَرِيكٌ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي إِسْمَاعِيلَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ هِلَالٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ يُحْرَمِ  الرِّفْقَ  يُحْرَمِ الْخَيْرَ كُلَّهُ  .","","Al-Mu'jam al-Kabir 2454","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الرحمن بن هلال العبسي عن محمد بن أبي إسماعيل السلمي عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","عبد الرحمن بن هلال العبسي عن جرير"
"2453","2455  -  حَدَّثَنَا  أَبُو حَصِينٍ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي إِسْمَاعِيلَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ هِلَالٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ يُحْرَمِ  الرِّفْقَ  يُحْرَمِ الْخَيْرَ  .","","Al-Mu'jam al-Kabir 2455","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الرحمن بن هلال العبسي عن محمد بن أبي إسماعيل السلمي عن علي بن مسهر القرشي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","عبد الرحمن بن هلال العبسي عن جرير"
"2454","2456  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  أَحْمَدُ بْنُ يَحْيَى الصُّوفِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ شَرِيكٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  تَمِيمِ بْنِ سَلَمَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ هِلَالٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الطُّلَقَاءُ  مِنْ  قُرَيْشٍ  ، وَالْعُتَقَاءُ مِنْ  ثَقِيفٍ  ،  وَالْمُهَاجِرُونَ  وَالْأَنْصَارُ  بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ  .","","Al-Mu'jam al-Kabir 2456","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الرحمن بن هلال العبسي عن تميم بن سلمة السلمي عن الأعمش عن حفص بن غياث النخعي عن عبد الرحمن بن شريك بن عبد الله النخعي عن أحمد بن يحيى بن زكريا عن البزار عن الطبراني","عبد الرحمن بن هلال العبسي عن جرير"
"2455","الْمُسْتَظِلُّ بْنُ حُصَيْنٍ  عَنْ  جَرِيرٍ  2457  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنَا  إِسْرَائِيلُ ،         [2/348]      عَنْ  شَبِيبِ بْنِ غَرْقَدَةَ ،  عَنْ  أَبِي الْمُثَنَّى  الْمُسْتَظِلِّ ، قَالَ :  سَمِعْتُ  جَرِيرَ بْنَ عَبْدِ اللهِ ، وَكَانَ أَمِيرًا عَلَيْنَا يَقُولُ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ إِنِّي رَجَعْتُ فَدَعَانِي ، فَقَالَ :  لَا أَقْبَلُ مِنْكَ حَتَّى  تُبَايِعَ  : وَالنُّصْحَ لِكُلِّ مُسْلِمٍ ، فَبَايَعْتُهُ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( أبي الميثاء )","","Al-Mu'jam al-Kabir 2457","","جرير بن عبد الله بن جابر يوسف الأمة عن مستظل بن حصين البارقي عن شبيب بن غرقدة البارقي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن عثمان بن عمر الضبي عن الطبراني","المستظل بن حصين عن جرير"
"2456","أَبُو بُرْدَةَ بْنُ أَبِي مُوسَى  عَنْ  جَرِيرٍ  2458  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  الْفَضْلُ بْنُ سَهْلٍ الْأَعْرَجُ ،  ثَنَا  مُعَلَّى بْنُ مَنْصُورٍ ،  ثَنَا  عَمْرُو بْنُ ثَابِتٍ ،  عَنْ  عَمِّهِ ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  جَرِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الرِّفْقُ  فِيهِ الزِّيَادَةُ وَالْبَرَكَةُ ، وَمَنْ يُحْرَمِ  الرِّفْقَ  يُحْرَمِ الْخَيْرَ  .","","Al-Mu'jam al-Kabir 2458","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو بردة بن أبي موسى الأشعري عن عم عمرو  بن أبي المقدام عن عمرو  بن أبي المقدام عن معلى بن منصور الرازي عن الفضل بن سهل الخراساني عن البزار عن الطبراني","أبو بردة بن أبي موسى عن جرير"
"2457","عَبْدُ الْمَلِكِ بْنُ عُمَيْرٍ  عَنْ  جَرِيرٍ  2459  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُعَاوِيَةَ الْعُتْبِيُّ  ، ثَنَا  حِبَّانُ بْنُ نَافِعِ بْنِ صَخْرِ بْنِ جُوَيْرِيَةَ ،  ثَنَا  سَعِيدُ بْنُ سَالِمٍ الْقَدَّاحُ ،  عَنْ  مَعْمَرِ بْنِ الْحَسَنِ ،  عَنْ  بَكْرِ بْنِ خُنَيْسٍ ،  عَنْ  أَبِي شَيْبَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِنَفَرٍ مِنْ أَصْحَابِهِ :  إِنِّي قَارِئٌ عَلَيْكُمْ آيَاتٍ مِنْ آخِرِ الزُّمَرِ ، فَمَنْ بَكَى مِنْكُمْ وَجَبَتْ لَهُ الْجَنَّةُ  فَقَرَأَهَا مِنْ عِنْدِ :         {      وَمَا قَدَرُوا اللهَ حَقَّ قَدْرِهِ         }      إِلَى آخِرِ السُّورَةِ ، فَمِنَّا مَنْ بَكَى ، وَمِنَّا مَنْ لَمْ يَبْكِ ، فَقَالَ الَّذِينَ لَمْ يَبْكُوا : يَا رَسُولَ اللهِ لَقَدْ  جَهِدْنَا  أَنْ نَبْكِيَ فَلَمْ نَبْكِ ، فَقَالَ : "" إِنِّي سَأَقْرَأُهَا عَلَيْكُمْ فَمَنْ لَمْ يَبْكِ فَلْيَتَبَاكَ  .","","Al-Mu'jam al-Kabir 2459","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الملك بن عمير القبطي عن إبراهيم بن عثمان أبو شيبة العبسي عن بكر بن خنيس الكوفي عن معمر بن الحسن عن سعيد بن سالم القداح عن حبان بن نافع بن صخر بن جويرية عن عبد الرحمن بن معاوية العتبي عن الطبراني","عبد الملك بن عمير عن جرير"
"2458","2460  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَرْوَزِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ قُهْزَادَ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي رِزْمَةَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ، قَالَ :  رَأَيْتُ  جَرِيرًا مَسَحَ عَلَى الْخُفَّيْنِ ، فَقَالَ النَّاسُ : إِنَّمَا كَانَ هَذَا قَبْلَ الْمَائِدَةِ ، فَقَالَ  جَرِيرٌ  : إِنَّمَا أَسْلَمْتُ بَعْدَ الْمَائِدَةِ ،  وَلَقَدْ رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَمْسَحُ عَلَى الْخُفَّيْنِ  .","","Al-Mu'jam al-Kabir 2460","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الملك بن عمير القبطي عن إسماعيل بن إبراهيم بن مهاجر النخعي عن عبد العزيز بن أبي رزمة اليشكري عن محمد بن عبد الله بن قهزاذ المروزي عن محمد بن علي بن محمد المروزي عن الطبراني","عبد الملك بن عمير عن جرير"
"2459","[2/349]      2461  -  حَدَّثَنَا  أَبُو عُمَرَ الضَّرِيرُ مُحَمَّدُ بْنُ عُثْمَانَ بْنِ سَعِيدٍ الْكُوفِيُّ ،  حَدَّثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  زُهَيْرُ بْنُ مُعَاوِيَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى الْإِسْلَامِ وَاشْتَرَطَ عَلَيَّ النُّصْحَ لِكُلِّ مُسْلِمٍ  ، وَإِنِّي لَنَاصِحٌ لَكُمْ أَجْمَعِينَ  .","","Al-Mu'jam al-Kabir 2461","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الملك بن عمير القبطي عن زهير بن معاوية بن حديج عن أحمد بن عبد الله اليربوعي عن محمد بن عثمان بن سعيد الضرير عن الطبراني","عبد الملك بن عمير عن جرير"
"2460","2462  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  جَعْفَرُ بْنُ حُمَيْدٍ ،  ثَنَا  الْوَلِيدُ بْنُ أَبِي ثَوْرٍ ،  عَنْ  عَبْدِ الْمَلِكِ ،  عَنْ  جَرِيرٍ ، قَالَ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى الْإِسْلَامِ وَالنُّصْحِ لِكُلِّ مُسْلِمٍ  وَإِنِّي لَكُمْ نَاصِحٌ أَجْمَعِينَ  .","","Al-Mu'jam al-Kabir 2462","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الملك بن عمير القبطي عن الوليد بن عبد الله بن أبي ثور المرهبي عن جعفر بن حميد زنبقة عن عبد الله بن أحمد بن حنبل عن الطبراني","عبد الملك بن عمير عن جرير"
"2461","زِيَادُ بْنُ عِلَاقَةَ  عَنْ  جَرِيرٍ  2463  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ، قَالَ :  سَمِعْتُ  جَرِيرَ بْنَ عَبْدِ اللهِ عَلَى الْمِنْبَرِ وَهُوَ يَقُولُ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَاشْتَرَطَ عَلَيَّ: وَالنُّصْحَ لِكُلِّ مُسْلِمٍ  .","","Al-Mu'jam al-Kabir 2463","","جرير بن عبد الله بن جابر يوسف الأمة عن زياد بن علاقة الثعلبي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","زياد بن علاقة عن جرير"
"2462","2464  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  سَهْلُ بْنُ بَكَّارٍ ، (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالُوا :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ، قَالَ :  سَمِعْتُ  جَرِيرًا ، يَقُولُ :  إِنِّي أَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقُلْتُ : "" يَا رَسُولَ اللهِ  أُبَايِعُكَ  عَلَى الْهِجْرَةِ  ، فَبَايَعَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَاشْتَرَطَ عَلَيَّ : وَالنُّصْحَ لِكُلِّ مُسْلِمٍ ، فَبَايَعْتُهُ عَلَى هَذَا  .","","Al-Mu'jam al-Kabir 2464","","جرير بن عبد الله بن جابر يوسف الأمة عن زياد بن علاقة الثعلبي عن الوضاح بن عبد الله اليشكري عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","زياد بن علاقة عن جرير"
"2463","2465  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  أَنَّهُ سَمِعَ  جَرِيرًا يَقُولُ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَاشْتَرَطَ عَلَيَّ وَالنُّصْحَ لِكُلِّ مُسْلِمٍ  "" فَوَرَبِّ الْكَعْبَةِ إِنِّي لَكُمْ نَاصِحٌ أَجْمَعِينَ  .","","Al-Mu'jam al-Kabir 2465","","جرير بن عبد الله بن جابر يوسف الأمة عن زياد بن علاقة الثعلبي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن عثمان بن عمر الضبي عن الطبراني","زياد بن علاقة عن جرير"
"2464","2466  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، حَدَّثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  شَيْبَانُ أَبُو مُعَاوِيَةَ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ، قَالَ :  سَمِعْتُ  جَرِيرًا ، يَقُولُ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [2/350]      بِيَدِي هَذِهِ عَلَى الْإِسْلَامِ ، وَشَرَطَ عَلَيَّ النُّصْحَ لِكُلِّ مُسْلِمٍ  "" فَوَرَبِّ الْكَعْبَةِ إِنِّي لَنَاصِحٌ لَكُمْ أَجْمَعِينَ  .","","Al-Mu'jam al-Kabir 2466","","جرير بن عبد الله بن جابر يوسف الأمة عن زياد بن علاقة الثعلبي عن شيبان بن عبد الرحمن المؤدب عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","زياد بن علاقة عن جرير"
"2465","2467  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ ،  ثَنَا  سُفْيَانُ ،  ثَنَا  زِيَادُ بْنُ عِلَاقَةَ ، قَالَ :  سَمِعْتُ  جَرِيرَ بْنَ عَبْدِ اللهِ ، يَقُولُ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى النُّصْحِ لِكُلِّ مُسْلِمٍ  .","","Al-Mu'jam al-Kabir 2467","","جرير بن عبد الله بن جابر يوسف الأمة عن زياد بن علاقة الثعلبي عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","زياد بن علاقة عن جرير"
"2466","2468  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مِسْعَرٍ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  جَرِيرٍ ، قَالَ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى إِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَالنُّصْحِ لِكُلِّ مُسْلِمٍ  "" وَإِنِّي لَكُمْ نَاصِحٌ  .","","Al-Mu'jam al-Kabir 2468","","جرير بن عبد الله بن جابر يوسف الأمة عن زياد بن علاقة الثعلبي عن مسعر بن كدام عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","زياد بن علاقة عن جرير"
"2467","2469  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا ،  عَنْ  عَاصِمٍ الْأَحْوَلِ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ، قَالَ :  سَمِعْتُ  جَرِيرًا ، يَقُولُ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى إِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَالنُّصْحِ لِكُلِّ مُسْلِمٍ  "" وَإِنِّي نَاصِحٌ لِجَمِيعِكُمْ  .","","Al-Mu'jam al-Kabir 2469","","جرير بن عبد الله بن جابر يوسف الأمة عن زياد بن علاقة الثعلبي عن عاصم بن سليمان الأحول عن إسماعيل بن زكريا شقوصا عن محمد بن بكار الرصافي عن عبد الله بن أحمد بن حنبل عن الطبراني","زياد بن علاقة عن جرير"
"2468","2470  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  جَرِيرٍ ، قَالَ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى النُّصْحِ لِكُلِّ مُسْلِمٍ  .","","Al-Mu'jam al-Kabir 2470","","جرير بن عبد الله بن جابر يوسف الأمة عن زياد بن علاقة الثعلبي عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","زياد بن علاقة عن جرير"
"2469","2471  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ ، وَيُوسُفُ الْقَاضِي ، قَالَا :  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ ، قَالَ :  سَمِعْتُهُ يَوْمَ تُوُفِّيَ  الْمُغِيرَةُ بْنُ شُعْبَةَ  ، يَقُولُ :  أُوصِيكُمْ بِتَقْوَى اللهِ ، وَاسْمَعُوا وَأَطِيعُوا حَتَّى يَأْتِيَكُمْ أَمِيرٌ  ، قَالَ : ثُمَّ ذَكَرَ  الْمُغِيرَةَ  ، فَقَالَ : اسْتَغْفِرُوا لَهُ عَفَا اللهُ عَنْكُمْ ، فَإِنَّهُ كَانَ يُحِبُّ الْعَافِيَةَ  ، ثُمَّ قَالَ : أَمَّا بَعْدُ فَإِنِّي أَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِأُبَايِعَهُ  عَلَى الْإِسْلَامِ فَقَالَ :  وَالنُّصْحَ لِكُلِّ مُسْلِمٍ  .","","Al-Mu'jam al-Kabir 2471","","جرير بن عبد الله بن جابر يوسف الأمة عن زياد بن علاقة الثعلبي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","زياد بن علاقة عن جرير"
"2470","2472  -  ثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ  ، ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ ،  ثَنَا  وَكِيعٌ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ ، قَالَ :  بَايَعَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى السَّمْعِ وَالطَّاعَةِ ،  وَالنَّصِيحَةِ  لِكُلِّ مُسْلِمٍ  ، فَبَايَعْتُهُ عَلَى الْإِسْلَامِ         [2/351]      وَالنُّصْحِ لِكُلِّ مُسْلِمٍ  .","","Al-Mu'jam al-Kabir 2472","","جرير بن عبد الله بن جابر يوسف الأمة عن زياد بن علاقة الثعلبي عن وكيع بن الجراح عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","زياد بن علاقة عن جرير"
"2471","2473  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  أَحْمَدُ بْنُ أَبَانَ الْقُرَشِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ، قَالَ :  سَمِعْتُ  جَرِيرَ بْنَ عَبْدِ اللهِ ، قَالَ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى السَّمْعِ وَالطَّاعَةِ ،  وَالنَّصِيحَةِ  لِكُلِّ مُسْلِمٍ  .","","Al-Mu'jam al-Kabir 2473","","جرير بن عبد الله بن جابر يوسف الأمة عن زياد بن علاقة الثعلبي عن سفيان الثوري عن أحمد بن أبان القرشي عن البزار عن الطبراني","زياد بن علاقة عن جرير"
"2472","2474  -  ثَنَا  أَبُو زُرْعَةَ الدِّمَشْقِيُّ  ، ثَنَا  آدَمُ بْنُ أَبِي إِيَاسٍ ،  ثَنَا  شَيْبَانُ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ لَا يَرْحَمْ لَا يُرْحَمْ  .","","Al-Mu'jam al-Kabir 2474","","جرير بن عبد الله بن جابر يوسف الأمة عن زياد بن علاقة الثعلبي عن شيبان بن عبد الرحمن المؤدب عن آدم بن أبي إياس عن أبو زرعة الدمشقي عن الطبراني","زياد بن علاقة عن جرير"
"2473","2475  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  جَعْفَرُ بْنُ حُمَيْدٍ ،  ثَنَا  الْوَلِيدُ بْنُ أَبِي ثَوْرٍ ،  عَنْ  زِيَادٍ ،  أَنَّ  جَرِيرًا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَا يَرْحَمْ لَا يُرْحَمْ ، وَمَنْ لَا يَغْفِرْ لَا يُغْفَرْ لَهُ  .","","Al-Mu'jam al-Kabir 2475","","جرير بن عبد الله بن جابر يوسف الأمة عن زياد بن علاقة الثعلبي عن الوليد بن عبد الله بن أبي ثور المرهبي عن جعفر بن حميد زنبقة عن عبد الله بن أحمد بن حنبل عن الطبراني","زياد بن علاقة عن جرير"
"2474","2476  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  حَدَّثَنَا  هَارُونُ بْنُ زَيْدِ بْنِ أَبِي الزَّرْقَاءِ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  الْمُفَضَّلُ بْنُ صَدَقَةَ أَبُو حَمَّادٍ الْكُوفِيُّ ،  عَنْ  زِيَادٍ ، قَالَ :  سَمِعْتُ  جَرِيرًا ، يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَا يَرْحَمْ لَا يُرْحَمْ ، وَمَنْ لَا يَغْفِرْ لَا يُغْفَرْ لَهُ ، وَمَنْ لَا يَتُبْ لَا يُتَبْ عَلَيْهِ  .","","Al-Mu'jam al-Kabir 2476","","جرير بن عبد الله بن جابر يوسف الأمة عن زياد بن علاقة الثعلبي عن المفضل بن صدقة الحنفي عن زيد بن أبي الزرقاء التغلبي عن هارون بن زيد بن أبي الزرقاء عن عبد الله بن أحمد الجواليقي عن الطبراني","زياد بن علاقة عن جرير"
"2475","2477  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  الْحَسَنُ بْنُ عَلِيِّ بْنِ جَعْفَرٍ ،  ثَنَا  دَاوُدُ بْنُ الرَّبِيعِ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَا يَرْحَمْ لَا يُرْحَمْ ، وَمَنْ لَا يَتُبْ لَا يُتَبْ عَلَيْهِ  "" .","","Al-Mu'jam al-Kabir 2477","","جرير بن عبد الله بن جابر يوسف الأمة عن زياد بن علاقة الثعلبي عن قيس بن الربيع الأسدي عن داود بن الربيع عن الحسين بن علي بن جعفر عن البزار عن الطبراني","زياد بن علاقة عن جرير"
"2476","2478  -  حَدَّثَنَا  أَبُو الْحَصِينِ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  جَرِيرٍ ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا يَغْفِرُ اللهُ لِمَنْ لَا         [2/352]      يَغْفِرُ ، وَلَا يَرْحَمُ اللهُ مَنْ لَا يَرْحَمُ  .","","Al-Mu'jam al-Kabir 2478","","جرير بن عبد الله بن جابر يوسف الأمة عن زياد بن علاقة الثعلبي عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","زياد بن علاقة عن جرير"
"2477","2479  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  أَبُو سَعِيدٍ مَوْلَى بَنِي هَاشِمٍ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، حَدَّثَنَا  بِشْرُ بْنُ آدَمَ ،  ثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ الْحَضْرَمِيُّ ، قَالَا :  ثَنَا  زَائِدَةُ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  جَرِيرٍ ، قَالَ  :  قَالَ لِي  حَبْرٌ  بِالْيَمَنِ  : إِنْ كَانَ صَاحِبُكُمْ نَبِيًّا ، فَقَدْ مَاتَ ، قَالَ : "" فَمَاتَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمَ الِاثْنَيْنِ  .","","Al-Mu'jam al-Kabir 2479","","جرير بن عبد الله بن جابر يوسف الأمة عن زياد بن علاقة الثعلبي عن زائدة بن قدامة عن يعقوب بن إسحاق بن زيد الحضرمي عن بشر بن آدم بن يزيد عن البزار عن الطبراني","زياد بن علاقة عن جرير"
"2478","2480  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  عِصَامُ بْنُ رَوَّادِ بْنِ الْجَرَّاحِ ،  ثَنَا  يَعْقُوبُ بْنُ أَبِي عَبَّادٍ ،  ثَنَا  سُفْيَانُ هُوَ ابْنُ عُيَيْنَةَ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ، قَالَ :  سَمِعْتُ  جَرِيرَ بْنَ عَبْدِ اللهِ ، يَقُولُ :  مَا رَآنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا تَبَسَّمَ  .","","Al-Mu'jam al-Kabir 2480","","جرير بن عبد الله بن جابر يوسف الأمة عن زياد بن علاقة الثعلبي عن سفيان بن عيينة عن يعقوب بن إسحاق القلزمي عن عصام بن رواد بن الجراح العسقلاني عن علي بن سعيد بن بشير عليك عن الطبراني","زياد بن علاقة عن جرير"
"2479","الْمُغِيرَةُ بْنُ شُبَيْلِ بْنِ عَوْفٍ  عَنْ  جَرِيرٍ  2481  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُبَيْلٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَيُّمَا عَبْدٍ  أَبَقَ  فَقَدْ بَرِئَتْ مِنْهُ  الذِّمَّةُ  .","","Al-Mu'jam al-Kabir 2481","","جرير بن عبد الله بن جابر يوسف الأمة عن المغيرة بن شبل الأحمسي عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","المغيرة بن شبيل بن عوف عن جرير"
"2480","2482  -  حَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ ،  ثَنَا  عَمْرُو بْنُ دِينَارٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا  أَبَقَ  الْعَبْدُ فَقَدْ بَرِئَتْ مِنْهُ ذِمَّةُ اللهِ  ،  وَلَمْ يَذْكُرِ  الْمُغِيرَةَ بْنَ شُبَيْلٍ  .","","Al-Mu'jam al-Kabir 2482","","جرير بن عبد الله بن جابر يوسف الأمة عن حبيب بن أبي ثابت الكاهلي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","المغيرة بن شبيل بن عوف عن جرير"
"2481","2483  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُبَيْلٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  لَمَّا أَنْ دَنَوْتُ مِنَ  الْمَدِينَةِ  أَنَخْتُ رَاحِلَتِي ، ثُمَّ حَلَلْتُ عَيْبَتِي ، فَلَبِسْتُ حُلَّتِي ، فَدَخَلْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْطُبُ ، فَسَلَّمْتُ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَرَمَانِي النَّاسُ بِالْحَدَقِ ،         [2/353]      فَقُلْتُ لِجَلِيسِي : يَا عَبْدَ اللهِ هَلْ ذَكَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ أَمْرِي شَيْئًا ؟ قَالَ : نَعَمْ ذَكَرَكَ بِأَحْسَنِ الذِّكْرِ ، بَيْنَمَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْطُبُ ، إِذْ عَرَضَ لَهُ فِي خُطْبَتِهِ ، فَقَالَ :  إِنَّهُ سَيَدْخُلُ عَلَيْكُمْ  مِنْ هَذَا  الْفَجِّ  أَوْ مِنْ هَذَا الْبَابِ  مِنْ خَيْرِ  ذِي  يَمَنٍ ، أَلَا وَإِنَّ عَلَى وَجْهِهِ  مَسْحَةَ  مَلَكٍ  قَالَ : "" فَحَمِدْتُ اللهَ عَلَى مَا أَبْلَانِي  .","","Al-Mu'jam al-Kabir 2483","","جرير بن عبد الله بن جابر يوسف الأمة عن المغيرة بن شبل الأحمسي عن يونس بن أبي إسحاق عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","المغيرة بن شبيل بن عوف عن جرير"
"2482","عَبْدُ اللهِ بْنُ عَمِيرَةَ  عَنْ  جَرِيرٍ  2484  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  إِبْرَاهِيمُ بْنُ حُمَيْدٍ الطَّوِيلُ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمِيرَةَ ،  عَنْ  جَرِيرٍ ، قَالَ :  أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أُبَايِعُهُ  عَلَى الْإِسْلَامِ ، فَقَبَضَ يَدَهُ : وَالنُّصْحِ لِكُلِّ مُسْلِمٍ  .","","Al-Mu'jam al-Kabir 2484","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الله بن عميرة بن حصن القيسي عن سماك بن حرب البكري عن شعبة بن الحجاج عن إبراهيم بن حميد الطويل عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن عميرة عن جرير"
"2483","2485  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  إِبْرَاهِيمُ بْنُ حُمَيْدٍ الطَّوِيلُ ،  ثَنَا  شُعْبَةُ  عَنْ  سِمَاكٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمِيرَةَ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَا يَرْحَمِ النَّاسَ لَا يَرْحَمْهُ اللهُ  .","","Al-Mu'jam al-Kabir 2485","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الله بن عميرة بن حصن القيسي عن سماك بن حرب البكري عن شعبة بن الحجاج عن إبراهيم بن حميد الطويل عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن عميرة عن جرير"
"2484","طَارِقٌ التَّيْمِيُّ  عَنْ  جَرِيرٍ  2486  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَمْرُو بْنُ عَوْنٍ ، وَمُحَمَّدُ بْنُ أَبِي نُعَيْمٍ ، قَالَا :  ثَنَا  وَكِيعٌ ،  عَنْ  شُعْبَةَ ،  عَنْ  جَابِرٍ ،  عَنْ  طَارِقٍ التَّيْمِيِّ  ،  عَنْ  جَرِيرٍ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ عَلَى نِسْوَةٍ فَسَلَّمَ عَلَيْهِنَّ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : (طارق التميمي).  كذا في طبعة مكتبة ابن تيمية ، والصواب : (طارق التميمي).","","Al-Mu'jam al-Kabir 2486","","جرير بن عبد الله بن جابر يوسف الأمة عن طارق التميمي عن جابر الجعفي عن شعبة بن الحجاج عن وكيع بن الجراح عن محمد بن موسى بن أبي نعيم الهذلي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","طارق التيمي عن جرير"
"2485","عَامِرُ بْنُ سَعْدٍ الْبَجَلِيُّ  عَنْ  جَرِيرٍ  2487  -  حَدَّثَنَا  عَلِيُّ بْنُ مُحَمَّدٍ الْأَنْصِنَاوِيُّ الْمِصْرِيُّ ،  ثَنَا  حَرْمَلَةُ بْنُ يَحْيَى ،         [2/354]      حَدَّثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  يَحْيَى بْنُ عَبْدِ اللهِ بْنِ سَالِمٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَلِيٍّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ الْبَجَلِيِّ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَا يَرْحَمْ لَا يُرْحَمْ  .","","Al-Mu'jam al-Kabir 2487","","جرير بن عبد الله بن جابر يوسف الأمة عن عامر بن سعد البجلي عن أبو إسحاق السبيعي عن عبد الله بن علي الأزرق عن موسى بن عقبة عن يحيى بن عبد الله بن سالم بن عبد الله بن عمر عن عبد الله بن وهب المصري عن حرملة بن يحيى التجيبي عن علي بن محمد الأنضناوي عن الطبراني","عامر بن سعد البجلي عن جرير"
"2486","عَبْدُ اللهِ بْنُ عَبْدِ اللهِ السَّبِيعِيُّ  عَنْ  جَرِيرٍ  2488  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَرِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ لَا يَرْحَمِ النَّاسَ لَا يَرْحَمْهُ اللهُ  .","","Al-Mu'jam al-Kabir 2488","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو أبو إسحاق السبيعي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن عثمان بن حفص الضبي عن الطبراني","عبد الله بن عبد الله السبيعي عن جرير"
"2487","2489  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ صَالِحٍ الشِّيرَازِيُّ  ، ثَنَا  عَمْرُو بْنُ حَكَّامٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَرِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ لَا يَرْحَمِ النَّاسَ لَا يَرْحَمْهُ اللهُ  .","","Al-Mu'jam al-Kabir 2489","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو أبو إسحاق السبيعي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن عمرو بن حكام الزنجبيلي عن إبراهيم بن صالح الشيرازي عن الطبراني","عبد الله بن عبد الله السبيعي عن جرير"
"2488","رِبْعِيُّ بْنُ حِرَاشٍ  عَنْ  جَرِيرٍ  2490  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  يَاسِينَ ،  عَنْ  حَمَّادِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  رِبْعِيِّ بْنِ حِرَاشٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ ، قَالَ :  وَضَّأْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَمَسَحَ عَلَى خُفَّيْهِ بَعْدَمَا أُنْزِلَتْ سُورَةُ الْمَائِدَةِ  "" .","","Al-Mu'jam al-Kabir 2490","","جرير بن عبد الله بن جابر يوسف الأمة عن ربعي بن حراش العبسي عن حماد بن أبي سليمان عن ياسين بن معاذ الزيات عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","ربعي بن حراش عن جرير"
"2489","أَبُو ظِبْيَانَ الْجَنْبِيُّ حُصَيْنُ بْنُ جُنْدُبٍ  عَنْ  جَرِيرٍ  2491  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي ظِبْيَانَ ،  عَنْ  جَرِيرٍ ،  عَنِ  النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ لَا يَرْحَمْ لَا يُرْحَمْ  .","","Al-Mu'jam al-Kabir 2491","","جرير بن عبد الله بن جابر يوسف الأمة عن حصين بن جندب الجنبي عن الأعمش عن محمد بن عبيد بن أبي أمية عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو ظبيان الجنبي حصين بن جندب عن جرير"
"2490","2492  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ وَأَبِي ظِبْيَانَ  أَنَّهُمَا سَمِعَا  جَرِيرَ بْنَ عَبْدِ اللهِ ، يُحَدِّثُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ لَا يَرْحَمِ النَّاسَ لَا يَرْحَمْهُ اللهُ  .","","Al-Mu'jam al-Kabir 2492","","جرير بن عبد الله بن جابر يوسف الأمة عن حصين بن جندب الجنبي عن الأعمش عن حفص بن غياث النخعي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","أبو ظبيان الجنبي حصين بن جندب عن جرير"
"2491","[2/355]      2493  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  أَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ وَأَبِي ظِبْيَانَ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَا يَرْحَمِ النَّاسَ لَا يَرْحَمْهُ اللهُ  .","","Al-Mu'jam al-Kabir 2493","","جرير بن عبد الله بن جابر يوسف الأمة عن حصين بن جندب الجنبي عن الأعمش عن أبو معاوية الضرير عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","أبو ظبيان الجنبي حصين بن جندب عن جرير"
"2492","2494  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي ظِبْيَانَ ،  عَنْ  جَرِيرٍ ،  عَنِ  النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ لَا يَرْحَمِ النَّاسَ لَا يَرْحَمْهُ اللهُ  .","","Al-Mu'jam al-Kabir 2494","","جرير بن عبد الله بن جابر يوسف الأمة عن حصين بن جندب الجنبي عن الأعمش عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","أبو ظبيان الجنبي حصين بن جندب عن جرير"
"2493","2495  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ يَزِيدَ الْبَكْرِيُّ الْجُوزَجَانِيُّ ،  ثَنَا  أَبُو مُطِيعٍ الْبَلْخِيُّ الْحَكَمُ بْنُ عَبْدِ اللهِ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سُلَيْمَانَ الْأَعْمَشِ ،  عَنْ  أَبِي ظِبْيَانَ ،  عَنْ  جَرِيرٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : قَالَ :  مَنْ لَا يَرْحَمِ النَّاسَ لَا يَرْحَمْهُ اللهُ  .","","Al-Mu'jam al-Kabir 2495","","جرير بن عبد الله بن جابر يوسف الأمة عن حصين بن جندب الجنبي عن الأعمش عن شعبة بن الحجاج عن الحكم بن عبد الله بن مسلمة الخراساني عن محمد بن يزيد البكري الجوزجاني عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","أبو ظبيان الجنبي حصين بن جندب عن جرير"
"2494","2496  -  قَالَ  : وَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  إِنَّ اللهَ كَتَبَ فِي أُمِّ الْكِتَابِ قَبْلَ أَنْ يَخْلُقَ السَّمَاوَاتِ وَالْأَرْضَ : إِنِّي أَنَا الرَّحْمَنُ الرَّحِيمُ خَلَقْتُ الرَّحِمَ  ، وَشَقَقْتُ لَهَا اسْمًا مِنْ أَسْمَائِي ، فَمَنْ وَصَلَهَا وَصَلْتُهُ ، وَمَنْ قَطَعَهَا قَطَعْتُهُ  .","","Al-Mu'jam al-Kabir 2496","","جرير بن عبد الله بن جابر يوسف الأمة عن حصين بن جندب الجنبي عن الأعمش عن شعبة بن الحجاج عن الحكم بن عبد الله بن مسلمة الخراساني عن محمد بن يزيد البكري الجوزجاني عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","أبو ظبيان الجنبي حصين بن جندب عن جرير"
"2495","2497  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  عُثْمَانُ بْنُ سَعِيدٍ ،  ثَنَا  أَبُو وَكِيعٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي ظِبْيَانَ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَا يَرْحَمْ مَنْ فِي الْأَرْضِ لَا يَرْحَمْهُ مَنْ فِي السَّمَاءِ  .","","Al-Mu'jam al-Kabir 2497","","جرير بن عبد الله بن جابر يوسف الأمة عن حصين بن جندب الجنبي عن أبو إسحاق السبيعي عن الجراح بن مليح الرؤاسي والد وكيع عن عثمان بن سعيد بن مرة المكفوف عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","أبو ظبيان الجنبي حصين بن جندب عن جرير"
"2496","[2/356]      2498  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ سَعِيدٍ الْقَطَّانُ  ثَنَا  سُوَيْدُ بْنُ عَمْرٍو الْكَلْبِيُّ  ثَنَا  أَبُو كُدَيْنَةَ يَحْيَى بْنُ الْمُهَلَّبِ  عَنْ  قَابُوسِ بْنِ أَبِي ظِبْيَانَ  عَنْ  أَبِيهِ  عَنْ  جَرِيرٍ قَالَ  : كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْطُبُ النَّاسَ يَوْمًا فَقَالَ :  قَدْ جَاءَكُمْ مِنْ خَيْرِ  ذِي  يَمَنٍ مَنْ عَلَى وَجْهِهِ  مَسْحَةُ  مَلَكٍ  يَعْنِينِي .","","Al-Mu'jam al-Kabir 2498","","جرير بن عبد الله بن جابر يوسف الأمة عن حصين بن جندب الجنبي عن قابوس بن أبي ظبيان عن يحيى بن المهلب البجلي عن سويد بن عمرو الكلبي عن أحمد بن محمد بن يحيى القطان عن البزار عن الطبراني","أبو ظبيان الجنبي حصين بن جندب عن جرير"
"2497","أَبُو إِسْحَاقَ السَّبِيعِيُّ  عَنْ  جَرِيرٍ  2499  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  جَنْدَلُ بْنُ وَالِقٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صِيَامُ ثَلَاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ صِيَامُ الدَّهْرِ  ، أَيَّامُ  الْبِيضِ  ثَلَاثَ عَشْرَةَ ، وَأَرْبَعَ عَشْرَةَ ، وَخَمْسَ عَشْرَةَ  .","","Al-Mu'jam al-Kabir 2499","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو إسحاق السبيعي عن زيد بن أبي أنيسة الجزري عن عبيد الله بن عمرو بن أبي الوليد عن جندل بن والق التغلبي عن محمد بن عثمان بن أبي شيبة عن الطبراني","أبو إسحاق السبيعي جرير"
"2498","2500  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْعَبَّاسِ الطَّيَالِسِيُّ ،  ثَنَا  مَخْلَدُ بْنُ الْحَسَنِ بْنِ أَبِي زُمَيْلٍ ،  ثَنَا  عَبْدُ اللهِ  بِإِسْنَادِهِ  مِثْلَهُ .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عبيد الله )","","Al-Mu'jam al-Kabir 2500","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو إسحاق السبيعي عن زيد بن أبي أنيسة الجزري عن عبيد الله بن عمرو بن أبي الوليد عن مخلد بن الحسن بن أبي زميل الحراني عن عبد الله بن العباس الطيالسي عن الطبراني","أبو إسحاق السبيعي جرير"
"2499","2501  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَحْيَى بْنُ آدَمَ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَمْ  يَشْكُرِ  النَّاسَ لَمْ  يَشْكُرِ  اللهَ  .","","Al-Mu'jam al-Kabir 2501","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن يحيى بن آدم عن عثمان ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","أبو إسحاق السبيعي جرير"
"2500","2502  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  جَرِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  ارْحَمْ مَنْ فِي الْأَرْضِ يَرْحَمْكَ مَنْ فِي السَّمَاءِ  .","","Al-Mu'jam al-Kabir 2502","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","أبو إسحاق السبيعي جرير"
"2501","مُجَاهِدٌ  عَنْ  جَرِيرٍ  2503  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي النَّضْرِ ، (  ح  )         [2/357]      وَثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبِي  ، قَالَا :  ثَنَا  أَبُو النَّضْرِ ،  حَدَّثَنِي  زِيَادُ بْنُ عَبْدِ اللهِ بْنِ عُلَاثَةَ ،  عَنْ  عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ ، قَالَ :  إِنَّمَا أَسْلَمْتُ بَعْدَمَا أُنْزِلَتِ الْمَائِدَةُ ، وَإِنَّمَا رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَمْسَحُ بَعْدَمَا أَسْلَمْتُ  .","","Al-Mu'jam al-Kabir 2503","","جرير بن عبد الله بن جابر يوسف الأمة عن مجاهد بن جبر المخزومي عن عبد الكريم الاصطخري عن زياد بن عبد الله بن علاثة العقيلي عن هاشم بن القاسم بن مسلم عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","مجاهد عن جرير"
"2502","نَافِعُ بْنُ جُبَيْرِ بْنِ مُطْعِمٍ  عَنْ  جَرِيرٍ  2504  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ ،  ثَنَا  عَمْرُو بْنُ دِينَارٍ ،  عَنْ  نَافِعِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ ،  عَنْ  جَرِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ لَا يَرْحَمِ النَّاسَ لَا يَرْحَمْهُ اللهُ  .","","Al-Mu'jam al-Kabir 2504","","جرير بن عبد الله بن جابر يوسف الأمة عن نافع بن جبير بن مطعم النوفلي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","نافع بن جبير بن مطعم عن جرير"
"2503","بِشْرُ بْنُ حَرْبٍ  عَنْ  جَرِيرٍ  2505  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  الْحَسَنُ بْنُ صَالِحِ بْنِ رُزَيْقٍ الْعَطَّارُ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَوْنٍ أَبُو عَوْنٍ الزِّيَادِيُّ ،  ثَنَا  حَرْبُ بْنُ سُرَيْجٍ ،  عَنْ  بِشْرِ بْنِ حَرْبٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  شَهِدْنَا الْمَوْسِمَ فِي حَجَّةٍ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهِيَ  حَجَّةُ الْوَدَاعِ  فَبَلَغْنَا مَكَانًا يُقَالُ لَهُ :  غَدِيرُ  خُمٍّ ،  فَنَادَى : الصَّلَاةَ جَامِعَةً ، فَاجْتَمَعْنَا  الْمُهَاجِرُونَ  وَالْأَنْصَارُ  ، فَقَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَسْطَنَا ، فَقَالَ : "" أَيُّهَا النَّاسِ بِمَ تَشْهَدُونَ ؟ "" قَالُوا : نَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، قَالَ : "" ثُمَّ  مَهْ  ؟ "" قَالُوا : وَأَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ ، قَالَ : "" فَمَنْ وَلِيُّكُمْ ؟ "" قَالُوا : اللهُ وَرَسُولُهُ مَوْلَانَا ، قَالَ : "" مَنْ وَلِيُّكُمْ ؟ "" ثُمَّ ضَرَبَ بِيَدِهِ عَلَى عَضُدِ  عَلِيٍّ  رَضِيَ اللهُ عَنْهُ فَأَقَامَهُ فَنَزَعَ عَضُدَهُ ، فَأَخَذَ بِذِرَاعَيْهِ ، فَقَالَ :  مَنْ يَكُنِ اللهُ وَرَسُولُهُ مَوْلَيَاهُ ، فَإِنَّ هَذَا مَوْلَاهُ اللَّهُمَّ وَالِ مَنْ وَالَاهُ وَعَادِ مَنْ عَادَاهُ  ، اللَّهُمَّ مَنْ أَحَبَّهُ مِنَ النَّاسِ فَكُنْ لَهُ حَبِيبًا ، وَمَنْ أَبْغَضَهُ فَكُنْ لَهُ مُبْغِضًا ، اللَّهُمَّ إِنِّي لَا أَجِدُ أَحَدًا أَسْتَوْدِعُهُ فِي الْأَرْضِ بَعْدَ الْعَبْدَيْنِ الصَّالِحَيْنِ غَيْرَكَ ، فَاقْضِ فِيهِ         [2/358]      بِالْحُسْنَى "" قَالَ  بِشْرٌ  : قُلْتُ : "" مَنْ هَذَيْنِ الْعَبْدَيْنِ الصَّالِحَيْنِ ؟ قَالَ : لَا أَدْرِي  "" .","","Al-Mu'jam al-Kabir 2505","","جرير بن عبد الله بن جابر يوسف الأمة عن بشر بن حرب عن حرب بن سريج المنقري عن محمد بن عون الزيادي عن الحسن بن صالح بن رزيق العطار عن علي بن سعيد بن بشير عليك عن الطبراني","بشر بن حرب عن جرير"
"2504","مُحَمَّدُ بْنُ سِيرِينَ  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ  2506  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  حَرْبُ بْنُ سُرَيْجٍ الْمِنْقَرِيُّ ،  ثَنَا  خَالِدٌ الْحَذَّاءُ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  حَجَّةِ الْوَدَاعِ  ، فَذَهَبَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَتَبَرَّزَ فَتَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ  "" .","","Al-Mu'jam al-Kabir 2506","","جرير بن عبد الله بن جابر يوسف الأمة عن محمد بن سيرين عن خالد الحذاء عن حرب بن سريج المنقري عن شيبان بن فروخ الحبطي عن عبد الله بن أحمد بن حنبل عن الطبراني","محمد بن سيرين عن جرير بن عبد الله"
"2505","عِيسَى بْنُ جَارِيَةَ الْأَنْصَارِيُّ  عَنْ  جَرِيرٍ  2507  -  حَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ الْمِصْرِيُّ  ، ثَنَا  أَبُو صَالِحٍ الْحَرَّانِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  سَعِيدِ بْنِ مُحَمَّدٍ الْأَنْصَارِيِّ ،  عَنْ  عِيسَى بْنِ جَارِيَةَ الْأَنْصَارِيِّ ،  عَنْ  جَرِيرٍ الْبَجَلِيِّ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَمْسَحُ عَلَى الْخُفَّيْنِ  فَقِيلَ لَهُ : بَعْدَمَا أُنْزِلَتْ سُورَةُ الْمَائِدَةِ ؟ فَقَالَ : "" وَهَلْ أَسْلَمْتُ إِلَّا بَعْدَمَا أُنْزِلَتْ سُورَةُ الْمَائِدَةِ  "" .","","Al-Mu'jam al-Kabir 2507","","جرير بن عبد الله بن جابر يوسف الأمة عن عيسى بن جارية الأنصاري عن سعيد بن محمد الأنصاري عن عبد الله بن لهيعة عن عبد الغفار بن داود الحراني عن عمرو بن أبي الطاهر المصري عن الطبراني","عيسى بن جارية الأنصاري عن جرير"
"2506","أَبُو بَكْرِ بْنُ عَمْرِو بْنِ عُتْبَةَ  عَنْ  جَرِيرٍ  2508  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، حَدَّثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  أَبِي بَكْرٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى الْإِسْلَامِ فَكَفَّ يَدَهُ ؛ لِيَشْتَرِطَ عَلَيَّ النُّصْحَ لِكُلِّ مُسْلِمٍ  .","","Al-Mu'jam al-Kabir 2508","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو بكر بن محمد الخزرجي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","أبو بكر بن عمرو بن عتبة عن جرير"
"2507","مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ الْحَارِثِ التَّيْمِيُّ  عَنْ  جَرِيرٍ  2509  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  يَحْيَى بْنُ مُحَمَّدِ بْنِ السَّكَنِ ،  ثَنَا  إِسْحَاقُ بْنُ إِدْرِيسَ ،  ثَنَا  بَكَّارُ بْنُ أَخِي مُوسَى بْنِ عُبَيْدَةَ ،  عَنْ  مُوسَى بْنِ عُبَيْدَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  جَرِيرٍ :  أَنَّ نَاسًا مِنْ  عُرَيْنَةَ  أَغَارُوا عَلَى لِقَاحِ رَسُولِ         [2/359]      اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فَأَمَرَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ تُقَطَّعَ أَيْدِيهِمْ وَأَرْجُلُهُمْ ، وَأَنْ تُسَمَّرَ أَعْيُنُهُمْ  .","","Al-Mu'jam al-Kabir 2509","","جرير بن عبد الله بن جابر يوسف الأمة عن محمد بن إبراهيم بن الحارث التيمي عن موسى بن عبيدة بن نشيط الحميري عن بكار بن عبد الله بن عبيدة الربذي عن إسحاق بن إدريس المباركي عن يحيى بن محمد بن السكن البزاز عن البزار عن الطبراني","محمد بن إبراهيم بن الحارث التيمي عن جرير"
"2508","عَوْنُ بْنُ عَبْدِ اللهِ بْنِ عُتْبَةَ بْنِ مَسْعُودٍ  عَنْ  جَرِيرٍ  2510  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ، وَإِبْرَاهِيمُ بْنُ مَتُّوَيْهِ الْأَصْبَهَانِيُّ ، قَالَا :  ثَنَا  الْحَسَنُ بْنُ دَاوُدَ الْمُنْكَدِرِيُّ ،  ثَنَا  بَكْرُ بْنُ صَدَقَةَ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ شُعَيْبٍ الدُّجَانِيُّ  ، ثَنَا  يَحْيَى بْنُ حَكِيمٍ ،  ثَنَا  حَمَّادُ بْنُ مَسْعَدَةَ ، كِلَاهُمَا  عَنِ  ابْنِ عَجْلَانَ ،  عَنْ  عَوْنِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  جَرِيرٍ الْبَجَلِيِّ ،  أَنَّهُ كَانَ إِذَا أَقَامَ سِلْعَةً بَصَّرَ عُيُوبَهَا ثُمَّ خَيَّرَهُ فَقَالَ : إِنْ شِئْتَ فَخُذْ ، وَإِنْ شِئْتَ فَاتْرُكْ ، فَقِيلَ لَهُ : يَرْحَمُكَ اللهُ إِنَّكَ إِذَا فَعَلْتَ هَذَا لَمْ يَنْفُذْ لَكَ الْبَيْعُ ، فَقَالَ :  إِنَّا بَايَعْنَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى النُّصْحِ لِأَهْلِ الْإِسْلَامِ  .","","Al-Mu'jam al-Kabir 2510","","جرير بن عبد الله بن جابر يوسف الأمة عن عون بن عبد الله بن عتبة عن محمد بن عجلان عن حماد بن مسعدة عن يحيى بن حكيم المقوم عن عبد الله بن محمد بن شعيب الرجاني عن الطبراني","عون بن عبد الله بن عتبة بن مسعود عن جرير"
"2509","شَهْرُ بْنُ حَوْشَبٍ  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ  2511  -  حَدَّثَنَا  أَبُو زُرْعَةَ الدِّمَشْقِيُّ  ، ثَنَا  حَيْوَةُ بْنُ شُرَيْحٍ الْحِمْصِيُّ ،  ثَنَا  بَقِيَّةُ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ السَّمَيْدَعِ الْأَنْطَاكِيُّ  ، ثَنَا  مُوسَى بْنُ أَيُّوبَ النَّصِيبِيُّ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ، (  ح  )  وَحَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  حَاجِبُ بْنُ الْوَلِيدِ ،  ثَنَا  أَبُو حَيْوَةَ شُرَيْحُ بْنُ يَزِيدَ الْحِمْصِيُّ ، قَالَا :  ثَنَا  إِبْرَاهِيمُ بْنُ أَدْهَمَ ،  عَنْ  مُقَاتِلِ بْنِ حَيَّانَ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ  "" .","","Al-Mu'jam al-Kabir 2511","","جرير بن عبد الله بن جابر يوسف الأمة عن شهر بن حوشب عن مقاتل بن حيان عن إبراهيم بن أدهم الزاهد عن بقية بن الوليد عن موسى بن أيوب النصيبي عن الحسين بن السميدع البجلي عن الطبراني","شهر بن حوشب عن جرير بن عبد الله"
"2510","ضَمْرَةُ بْنُ حَبِيبٍ  عَنْ  جَرِيرٍ  2512  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ الصَّفَّارُ ،  ثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  ثَنَا  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  ضَمْرَةَ بْنِ حَبِيبٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  قَدِمْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعْدَ نُزُولِ الْمَائِدَةِ ، فَرَأَيْتُهُ يَمْسَحُ عَلَى الْخُفَّيْنِ  "" .","","Al-Mu'jam al-Kabir 2512","","جرير بن عبد الله بن جابر يوسف الأمة عن ضمرة بن حبيب الزبيدي عن معاوية بن صالح بن حدير الحضرمي عن زيد بن الحباب العكلي عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار عن الطبراني","ضمرة بن حبيب عن جرير"
"2511","[3/17]      234 -  جَنْدَرَةُ بْنُ خَيْشَنَةَ أَبُو قِرْصَافَةَ اللَّيْثِيُّ مَوْلَى بَنِي لَيْثِ بْنِ بَكْرِ بْنِ عَبْدِ مَنَاةَ بْنِ كِنَانَةَ  2513  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ قُتَيْبَةَ الْعَسْقَلَانِيُّ  ، ثَنَا  أَيُّوبُ بْنُ عَلِيِّ بْنِ الْهَيْصَمِ ،  ثَنَا  زِيَادُ بْنُ سَيَّارٍ ،  حَدَّثَتْنِي  عَزَّةُ بِنْتُ عِيَاضِ بْنِ أَبِي قِرْصَافَةَ ، قَالَتْ :  سَمِعْتُ  جَدِّي أَبَا قِرْصَافَةَ صَاحِبَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  كَانَ بَدْءُ إِسْلَامِي أَنِّي كُنْتُ يَتِيمًا بَيْنَ أُمِّي وَخَالَتِي ، فَكَانَ أَكْثَرُ مَيْلِي إِلَى خَالَتِي ، وَكُنْتُ أَرْعَى شُوَيْهَاتٍ لِي ، وَكَانَتْ خَالَتِي كَثِيرًا مِمَّا تَقُولُ لِي : يَا بُنَيَّ ، لَا تَمُرَّ إِلَى هَذَا الرَّجُلِ -  تَعْنِي النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - فَيُغْوِيَكَ وَيُضِلَّكَ . فَكُنْتُ أَخْرُجُ حَتَّى آتِيَ الْمَرْعَى ، فَأَتْرُكَ شُوَيْهَاتِي ، ثُمَّ آتِيَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَا أَزَالُ عِنْدَهُ أَسْمَعُ مِنْهُ ، ثُمَّ أَرُوحُ بِغَنَمِي ضُمَّرًا يَابِسَاتِ الضُّرُوعِ ، وَقَالَتْ لِي خَالَتِي : مَا لِغَنَمِكَ يَابِسَاتِ الضُّرُوعِ ؟ قُلْتُ : مَا أَدْرِي . ثُمَّ عُدْتُ إِلَيْهِ الْيَوْمَ الثَّانِي ، فَفَعَلَ كَمَا فَعَلَ الْيَوْمَ الْأَوَّلَ ، غَيْرَ أَنِّي سَمِعْتُهُ يَقُولُ :  أَيُّهَا النَّاسُ ، هَاجِرُوا وَتَمَسَّكُوا بِالْإِسْلَامِ ، فَإِنَّ  الْهِجْرَةَ  لَا تَنْقَطِعُ مَا دَامَ  الْجِهَادُ  . ثُمَّ إِنِّي رَجَعْتُ بِغَنَمِي كَمَا رَجَعْتُ الْيَوْمَ الْأَوَّلَ ، ثُمَّ عُدْتُ إِلَيْهِ فِي الْيَوْمِ الثَّالِثِ ، فَلَمْ أَزَلْ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَسْمَعُ مِنْهُ حَتَّى أَسْلَمْتُ وَبَايَعْتُهُ وَصَافَحْتُهُ بِيَدِي ، وَشَكَوْتُ إِلَيْهِ أَمْرَ خَالَتِي وَأَمْرَ غَنَمِي ، فَقَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" جِئْنِي  بِالشِّيَاهِ  "" . فَجِئْتُهُ بِهِنَّ ، فَمَسَحَ ظُهُورَهُنَّ وَضُرُوعَهُنَّ ، وَدَعَا فِيهِنَّ بِالْبَرَكَةِ ، فَامْتَلَأَتْ شَحْمًا وَلَبَنًا ، فَلَمَّا دَخَلْتُ عَلَى خَالَتِي بِهِنَّ ، قَالَتْ : يَا بُنَيَّ ، هَكَذَا فَارْعَ . قُلْتُ : يَا خَالَةُ ، مَا رَعَيْتُ إِلَّا حَيْثُ كُنْتُ أَرْعَى كُلَّ يَوْمٍ ، وَلَكِنْ أُخْبِرُكِ بِقِصَّتِي ، فَأَخْبَرْتُهَا بِالْقِصَّةِ ، وَإِتْيَانِي النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَخْبَرْتُهَا بِسِيرَتِهِ وَبِكَلَامِهِ ، فَقَالَتْ لِي أُمِّي وَخَالَتِي : اذْهَبْ بِنَا إِلَيْهِ . فَذَهَبْتُ أَنَا وَأُمِّي وَخَالَتِي ، فَأَسْلَمْنَ وَبَايَعْنَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَمَا صَافَحْنَ  . فَهَذَا مَا كَانَ مِنْ إِسْلَامِ  أَبِي قِرْصَافَةَ  وَهِجْرَتِهِ إِلَى         [3/18]      النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .  قَالَ  زِيَادٌ : ""  وَكَانَ أَبُو قِرْصَافَةَ يَسْكُنُ أَرْضَ  تِهَامَةَ  "" .","","Al-Mu'jam al-Kabir 2513","","جندرة بن خيشنة الكناني عن عزة بنت عياض بن أبي قرصافة عن زياد بن سيار الشامي عن أيوب بن علي بن الهيصم الفلسطيني عن محمد بن الحسن بن قتيبة اللخمي عن الطبراني","جندرة بن خيشنة"
"2512","2514  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ قُتَيْبَةَ الْعَسْقَلَانِيُّ  ، ثَنَا  أَيُّوبُ بْنُ عَلِيِّ بْنِ الْهَيْصَمِ ،  ثَنَا  زِيَادُ بْنُ سَيَّارٍ ،  عَنْ  عَزَّةَ بِنْتِ عِيَاضٍ ، قَالَتْ :  سَمِعْتُ  أَبَا قِرْصَافَةَ يَقُولُ :  قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" هَلْ لَكَ عَقِبٌ ؟ "" قُلْتُ : لِي أَخٌ . قَالَ : "" فَجِئْ بِهِ "" . فَرَفَقْتُ بِأَخِي وَكَانَ غُلَامًا صَغِيرًا حَتَّى جَاءَ مَعِي ، فَلَمَّا دَنَا مِنَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ هَرَبَ ، فَأَخَذْتُهُ فَضَمَمْتُ يَدَيْهِ وَرِجْلَيْهِ ، ثُمَّ جِئْتُ بِهِ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَبَايَعَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَكَانَ اسْمُهُ  "" مِيسَمٌ ""  ، فَقَالَ لِيَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا اسْمُهُ يَا  أَبَا قِرْصَافَةَ  ؟ "" قُلْتُ : اسْمُهُ  مِيسَمٌ  . قَالَ : "" بَلِ اسْمُهُ  مُسْلِمٌ  . فَقُلْتُ : مُسْلِمٌ مَعَكَ يَا رَسُولَ اللهِ  .","","Al-Mu'jam al-Kabir 2514","","جندرة بن خيشنة الكناني عن عزة بنت عياض بن أبي قرصافة عن زياد بن سيار الشامي عن أيوب بن علي بن الهيصم الفلسطيني عن محمد بن الحسن بن قتيبة اللخمي عن الطبراني","جندرة بن خيشنة"
"2513","2515  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ قُتَيْبَةَ  ، ثَنَا  أَيُّوبُ بْنُ عَلِيِّ بْنِ الْهَيْصَمِ ،  ثَنَا  زِيَادُ بْنُ سَيَّارٍ ،  عَنْ  عَزَّةَ ،  عَنْ  أَبِي قِرْصَافَةَ  أَنَّهُ "" رَأَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُسْتَلْقِيًا عَلَى قَفَاهُ ، وَاضِعًا إِحْدَى رِجْلَيْهِ عَلَى الْأُخْرَى  "" .","","Al-Mu'jam al-Kabir 2515","","جندرة بن خيشنة الكناني عن عزة بنت عياض بن أبي قرصافة عن زياد بن سيار الشامي عن أيوب بن علي بن الهيصم الفلسطيني عن محمد بن الحسن بن قتيبة اللخمي عن الطبراني","جندرة بن خيشنة"
"2514","2516  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ قُتَيْبَةَ  ، ثَنَا  أَيُّوبُ بْنُ عَلِيِّ بْنِ الْهَيْصَمِ ،  ثَنَا  زِيَادُ بْنُ سَيَّارٍ ،  عَنْ  عَزَّةَ ، قَالَتْ :  سَمِعْتُ  أَبَا قِرْصَافَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  حَدِّثُوا عَنِّي بِمَا تَسْمَعُونَ ، وَلَا يَحِلُّ لِرَجُلٍ أَنْ يَكْذِبَ عَلَيَّ  ، فَمَنْ كَذَبَ عَلَيَّ - وَقَالَ عَلَيَّ غَيْرَ مَا قُلْتُ - بُنِيَ لَهُ بَيْتٌ فِي  جَهَنَّمَ  يَرْتَعُ  فِيهِ  .","","Al-Mu'jam al-Kabir 2516","","جندرة بن خيشنة الكناني عن عزة بنت عياض بن أبي قرصافة عن زياد بن سيار الشامي عن أيوب بن علي بن الهيصم الفلسطيني عن محمد بن الحسن بن قتيبة اللخمي عن الطبراني","جندرة بن خيشنة"
"2515","2517  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ قُتَيْبَةَ  ، ثَنَا  أَيُّوبُ بْنُ عَلِيِّ بْنِ الْهَيْصَمِ ،  ثَنَا  زِيَادُ بْنُ سَيَّارٍ ،  عَنْ  عَزَّةَ بِنْتِ عِيَاضٍ ، قَالَتْ :  سَمِعْتُ  أَبَا قِرْصَافَةَ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  غِفَارُ  غَفَرَ  اللهُ لَهَا ،  وَأَسْلَمُ  سَالَمَهَا  اللهُ  .","","Al-Mu'jam al-Kabir 2517","","جندرة بن خيشنة الكناني عن عزة بنت عياض بن أبي قرصافة عن زياد بن سيار الشامي عن أيوب بن علي بن الهيصم الفلسطيني عن محمد بن الحسن بن قتيبة اللخمي عن الطبراني","جندرة بن خيشنة"
"2516","2518  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ قُتَيْبَةَ  ، ثَنَا  أَيُّوبُ بْنُ عَلِيِّ بْنِ الْهَيْصَمِ ،  ثَنَا  زِيَادُ بْنُ سَيَّارٍ ،  عَنْ  عَزَّةَ بِنْتِ عِيَاضٍ ، قَالَتْ :  سَمِعْتُ  أَبَا قِرْصَافَةَ يَقُولُ :  لَمَّا         [3/19]      بَايَعْنَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَا وَأُمِّي وَخَالَتِي وَرَجَعْنَا مِنْ عِنْدِهِ مُنْصَرِفِينَ ، قَالَتْ لِي أُمِّي وَخَالَتِي :  يَا بُنَيَّ ، مَا رَأَيْنَا مِثْلَ هَذَا الرَّجُلِ أَحْسَنَ مِنْهُ وَجْهًا  ، وَلَا أَنْقَى ثَوْبًا ، وَلَا أَلْيَنَ كَلَامًا ، وَرَأَيْنَا كَأَنَّ النُّورَ يَخْرُجُ مِنْ فِيهِ  .","","Al-Mu'jam al-Kabir 2518","","جندرة بن خيشنة الكناني عن عزة بنت عياض بن أبي قرصافة عن زياد بن سيار الشامي عن أيوب بن علي بن الهيصم الفلسطيني عن محمد بن الحسن بن قتيبة اللخمي عن الطبراني","جندرة بن خيشنة"
"2517","2519  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ قُتَيْبَةَ  ، ثَنَا  أَيُّوبُ ،  عَنْ  زِيَادٍ ،  عَنْ  عَزَّةَ بِنْتِ عِيَاضٍ ، قَالَتْ :  سَمِعْتُ  أَبَا قِرْصَافَةَ قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَحَبَّ قَوْمًا حَشَرَهُ اللهُ فِي زُمْرَتِهِمْ  .","","Al-Mu'jam al-Kabir 2519","","جندرة بن خيشنة الكناني عن عزة بنت عياض بن أبي قرصافة عن زياد بن سيار الشامي عن أيوب بن علي بن الهيصم الفلسطيني عن محمد بن الحسن بن قتيبة اللخمي عن الطبراني","جندرة بن خيشنة"
"2518","2520  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ قُتَيْبَةَ ،  ثَنَا  أَيُّوبُ ،  ثَنَا  زِيَادٌ ،  عَنْ  عَزَّةَ بِنْتِ عِيَاضٍ ، قَالَتْ :  سَمِعْتُ  أَبَا قِرْصَافَةَ قَالَ :  كَسَانِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بُرْنُسًا  ، وَقَالَ : "" الْبَسْهُ  "" .","","Al-Mu'jam al-Kabir 2520","","جندرة بن خيشنة الكناني عن عزة بنت عياض بن أبي قرصافة عن زياد بن سيار الشامي عن أيوب بن علي بن الهيصم الفلسطيني عن محمد بن الحسن بن قتيبة اللخمي عن الطبراني","جندرة بن خيشنة"
"2519","2521  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ قُتَيْبَةَ  ، ثَنَا  أَيُّوبُ بْنُ عَلِيٍّ ،  ثَنَا  زِيَادُ بْنُ سَيَّارٍ ،  عَنْ  عَزَّةَ بِنْتِ عِيَاضٍ ، قَالَتْ :  سَمِعْتُ  أَبَا قِرْصَافَةَ أَنَّهُ سَمِعَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  ابْنُوا الْمَسَاجِدَ وَأَخْرِجُوا الْقُمَامَةَ مِنْهَا ، فَمَنْ بَنَى لِلهِ مَسْجِدًا بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  . قَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، وَهَذِهِ الْمَسَاجِدُ الَّتِي تُبْنَى فِي الطَّرِيقِ ؟ قَالَ : نَعَمْ ، وَإِخْرَاجُ الْقُمَامَةِ مِنْهَا مُهُورُ حُورِ  الْعِينِ  .","","Al-Mu'jam al-Kabir 2521","","جندرة بن خيشنة الكناني عن عزة بنت عياض بن أبي قرصافة عن زياد بن سيار الشامي عن أيوب بن علي بن الهيصم الفلسطيني عن محمد بن الحسن بن قتيبة اللخمي عن الطبراني","جندرة بن خيشنة"
"2520","2522  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، حَدَّثَنِي  يُونُسُ بْنُ عَبْدِ الرَّحِيمِ الْعَسْقَلَانِيُّ ،  حَدَّثَنِي  عَيَّاشُ بْنُ مَرْثَدٍ الْكِنَانِيُّ  ،  حَدَّثَنِي  عَمِّي عَطِيَّةُ بْنُ سَعِيدٍ ، قَالَ :  سَمِعْتُ  أَبَا قِرْصَافَةَ يَقُولُ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  اللَّهُمَّ لَا تُخْزِنِي يَوْمَ الْبَأْسِ ، وَلَا تُخْزِنِي يَوْمَ الْقِيَامَةِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عياش بن يزيد )","","Al-Mu'jam al-Kabir 2522","","جندرة بن خيشنة الكناني عن عطية بن سعيد عن عياش بن يزيد الشامي عن يونس بن عبد الرحيم العسقلاني عن يحيى بن عثمان بن صالح عن الطبراني","جندرة بن خيشنة"
"2521","2523  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْخَزَرِ الطَّبَرَانِيُّ  ، ثَنَا  أَيُّوبُ بْنُ عَلِيِّ بْنِ الْهَيْصَمِ ،  ثَنَا  زِيَادُ بْنُ سَيَّارٍ ،  حَدَّثَتْنِي  عَزَّةُ بِنْتُ عِيَاضِ بْنِ أَبِي قِرْصَافَةَ ،  قَالَتْ  :  أَسَرَ  الرُّومُ  ابْنًا لِأَبِي قِرْصَافَةَ  ، فَكَانَ أَبُو قِرْصَافَةَ إِذَا كَانَ وَقْتُ كُلِّ صَلَاةٍ صَعِدَ         [3/20]      سُوَرَ  عَسْقَلَانَ  ،  وَنَادَى : يَا فُلَانُ الصَّلَاةَ ، فَسَمِعَهُ وَهُوَ فِي بَلَدِ  الرُّومِ  ""  .","","Al-Mu'jam al-Kabir 2523","","جندرة بن خيشنة الكناني عن عزة بنت عياض بن أبي قرصافة عن زياد بن سيار الشامي عن أيوب بن علي بن الهيصم الفلسطيني عن محمد بن خزر الطبراني عن الطبراني","جندرة بن خيشنة"
"2522","2524  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  ثَنَا  يَحْيَى بْنُ حَسَّانَ ،  حَدَّثَنِي  شَيْخٌ مِنْ بَنِي كِنَانَةَ ، قَالَ :  صَلَّيْتُ خَلْفَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَسَمِعْتُهُ يَقُولُ : "" اللَّهُمَّ لَا تُخْزِنِي يَوْمَ الْقِيَامَةِ ، وَلَا تُخْزِنِي يَوْمَ الْبَأْسِ  .","","Al-Mu'jam al-Kabir 2524","","أحد الصحابة عن يحيى بن حسان العسقلاني عن عبد الله بن المبارك عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","جندرة بن خيشنة"
"2523","بَابُ الْحَاءِ  235 -  حَسَنُ بْنُ عَلِيِّ بْنِ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُ "" يُكَنَّى  أَبَا مُحَمَّدٍ  ذِكْرُ مَوْلِدِ  الْحَسَنِ بْنِ عَلِيٍّ  وَصِفَتِهِ وَوَفَاتِهِ رَضِيَ اللهُ عَنْهُ "" .  2525  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَبْدِ اللهِ بْنِ نُمَيْرٍ  يَقُولُ :  ""  الْحَسَنُ بْنُ عَلِيٍّ يُكَنَّى أَبَا مُحَمَّدٍ  ""  .","","Al-Mu'jam al-Kabir 2525","","","ذكر مولد الحسن بن علي وصفته ووفاته"
"2524","2526  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عُثْمَانُ بْنُ سَعِيدٍ الْمُرِّيُّ ،  ثَنَا  عَلِيُّ بْنُ صَالِحٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  قَابُوسَ بْنِ الْمُخَارِقِ الشَّيْبَانِيِّ ،  عَنْ  أَبِيهِ  ،  قَالَ  :  جَاءَتْ أُمُّ الْفَضْلِ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَتْ : إِنِّي رَأَيْتُ بَعْضَ جِسْمِكَ فِيَّ . فَقَالَ : "" نِعْمَ مَا رَأَيْتِ ، تَلِدُ  فَاطِمَةُ  غُلَامًا ، وَتُرْضِعِينَهُ بِلَبَنِ  قُثَمَ  "" . قَالَ : فَجَاءَتْ بِهِ تَحْمِلُهُ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَوَضَعَتْهُ فِي حِجْرِهِ ، فَبَالَ ، فَلَطَمَتْهُ بِيَدِهَا ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَوْجَعْتِ ابْنِي رَحِمَكِ اللهُ "" . قَالَتْ : هَاتِ إِزَارَكَ حَتَّى نَغْسِلَهُ . قَالَ :  إِنَّمَا يُغْسَلُ بَوْلُ الْجَارِيَةِ ،  وَيُنْضَحُ  بَوْلُ الْغُلَامِ  .","","Al-Mu'jam al-Kabir 2526","","لبابة بنت الحارث الهلالية عن مخارق بن سليم الشيباني عن قابوس بن أبي المخارق الشيباني عن سماك بن حرب البكري عن علي بن صالح بن حي عن عثمان بن سعيد بن مرة المكفوف عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2525","2527  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْحَكَمِ بْنِ         [3/21]      أَبِي زِيَادٍ ،  ثَنَا  أَبُو زِيَادٍ  ،  ثَنَا  أَبُو دَاوُدَ الْحَفَرِيُّ ،  عَنْ  سُفْيَانَ ،  عَنْ  عُمَرَ بْنِ سَعِيدٍ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عُقْبَةَ بْنِ الْحَارِثِ ،  قَالَ  :  إِنِّي لَمَعَ أَبِي بَكْرٍ رَضِيَ اللهُ عَنْهُ حِينَ مَرَّ عَلَى  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ ، فَوَضَعَهُ عَلَى عُنُقِهِ ، وَقَالَ :  بِأَبِي شَبَهُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَا شَبِيهُ  عَلِيٍّ  . قَالَ :  وَعَلِيٌّ  مَعَهُ ، فَجَعَلَ يَضْحَكُ رَضِيَ اللهُ عَنْهُمْ أَجْمَعِينَ  .  كذا في طبعة مكتبة ابن تيمية وهي زيادة ليست في النسخ الخطية التي بين أيدينا ، والله أعلم","","Al-Mu'jam al-Kabir 2527","","أبو  بكر الصديق عن عقبة بن الحارث بن عامر النوفلي عن ابن أبي مليكة عن عمر بن سعيد النوفلي عن سفيان الثوري عن عمر بن سعد بن عبيد الحفري عن أبو زياد عن عبد الله بن الحكم القطواني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2526","2528  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو أَحْمَدَ الزُّبَيْرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ سَعِيدِ بْنِ أَبِي حُسَيْنٍ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عُقْبَةَ بْنِ الْحَارِثِ ،  قَالَ :  خَرَجْتُ مَعَ أَبِي بَكْرٍ  . فَذَكَرَ مِثْلَهُ  .","","Al-Mu'jam al-Kabir 2528","","أبو  بكر الصديق عن عقبة بن الحارث بن عامر النوفلي عن ابن أبي مليكة عن عمر بن سعيد النوفلي عن محمد بن عبد الله بن الزبير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2527","2529  -  حَدَّثَنَا  زَكَرِيَّا بْنُ حَمْدَوَيْهِ الصَّفَّارُ الْبَغْدَادِيُّ ،  حَدَّثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  قَالَ  :  ذُكِرَ  الْحَسَنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا عِنْدَ ابْنِ عَبَّاسٍ ، فَقَالَ :  إِنَّهُ كَانَ يُشْبِهُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ""  .","","Al-Mu'jam al-Kabir 2529","","عبد الله بن عباس عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن عبد الواحد بن زياد عن عفان بن مسلم الصفار عن زكريا بن حمدويه الصفار عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2528","2530  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، حَدَّثَنَا  عَبْدُ الْوَارِثِ بْنُ عَبْدِ الصَّمَدِ بْنِ عَبْدِ الْوَارِثِ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحْتَسِبٌ أَبُو عَائِذٍ ،  حَدَّثَنِي  شُجَاعُ بْنُ عَبْدِ الرَّحْمَنِ أَنَّهُ  رَأَى  الْحَسَنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ يَضْرِبُ شَعَرُهُ مَنْكِبَيْهِ  ""  .","","Al-Mu'jam al-Kabir 2530","","الحسن بن علي سبط رسول الله عن شجاع بن عبد الرحمن عن محتسب بن عبد الرحمن الأعمى عن عبد الصمد بن عبد الوارث التنوري عن عبد الوارث بن عبد الصمد التنوري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2529","2531  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عُبَادَةُ بْنُ زِيَادٍ ،  ثَنَا  شَرِيكٌ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي زُهَيْرٍ مَوْلَى الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ ، قَالَ :  رَأَيْتُ  الْحَسَنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ يَخْضِبُ  بِالْوَسْمَةِ  "" .  قَالَ  الْحَضْرَمِيُّ  : ""  هَكَذَا قَالَ  عُبَادَةُ  : مَوْلَى  الْحَسَنِ  ، وَإِنَّمَا هُوَ مَوْلَى  الْحُسَيْنِ  "" .","","Al-Mu'jam al-Kabir 2531","","الحسن بن علي سبط رسول الله عن عبد الله بن أبي زهير مولى الحسن بن علي عن شريك بن عبد الله النخعي عن عبادة بن زياد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2530","2532  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا         [3/22]      شَرِيكٌ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي زُهَيْرٍ النَّخَعِيِّ ، قَالَ :  رَأَيْتُ  الْحَسَنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ يَخْضِبُ بِالسَّوَادِ  "" .","","Al-Mu'jam al-Kabir 2532","","الحسن بن علي سبط رسول الله عن عبد الله بن أبي زهير النخعي عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2531","2533  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  الْعَلَاءُ بْنُ خَالِدٍ الرِّيَاحِيُّ ،  عَنْ  زَاذَانَ أَبِي مَنْصُورٍ ، قَالَ :  رَأَيْتُ  الْحَسَنَ بْنَ عَلِيٍّ يَخْضِبُ بِالْحِنَّاءِ  وَالْكَتَمِ  ""  .","","Al-Mu'jam al-Kabir 2533","","الحسن بن علي سبط رسول الله عن زاذان البصري عن العلاء بن خالد الواسطي عن هدبة بن خالد عن عبد الله بن أحمد بن حنبل عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2532","2534  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ عَامِرِ بْنِ إِبْرَاهِيمَ الْأَصْبَهَانِيُّ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي عَامِرٍ  ، عَنْ  يَعْقُوبَ الْقُمِّيِّ ،  عَنْ  عَنْبَسَةَ بْنِ سَعِيدٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنِ  الشَّعْبِيِّ  أَنَّ  الْحَسَنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ كَانَ يَخْضِبُ بِالسَّوَادِ  ""  .","","Al-Mu'jam al-Kabir 2534","","الحسن بن علي سبط رسول الله عن الشعبي عن إبراهيم بن مهاجر بن جابر البجلي عن عنبسة بن سعيد بن الضريس عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2533","2535  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْمَاعِيلَ بْنِ رَجَاءٍ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  أَنَّ  الْحَسَنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ كَانَ يَخْضِبُ بِالسَّوَادِ  ""  .","","Al-Mu'jam al-Kabir 2535","","الحسن بن علي سبط رسول الله عن أبو جعفر الباقر عن جعفر الصادق عن محمد بن إسماعيل بن رجاء الزبيدي عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2534","2536  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ الْوَارِثِ بْنُ عَبْدِ الصَّمَدِ ،  ثَنَا  أَبِي  ،  ثَنَا  مُحْتَسِبٌ أَبُو عَائِذٍ ،  حَدَّثَنِي  شُجَاعُ بْنُ عَبْدِ الرَّحْمَنِ أَنَّهُ  رَأَى  الْحَسَنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ مَخْضُوبًا بِالسَّوَادِ عَلَى فَرَسٍ  ذَنُوبٍ  ""  .","","Al-Mu'jam al-Kabir 2536","","الحسن بن علي سبط رسول الله عن شجاع بن عبد الرحمن عن محتسب بن عبد الرحمن الأعمى عن عبد الصمد بن عبد الوارث التنوري عن عبد الوارث بن عبد الصمد التنوري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2535","2537  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  جُمْهُورُ بْنُ مَنْصُورٍ ،  ثَنَا  مُحَمَّدُ بْنُ رَبِيعَةَ ،  عَنْ  مُسْتَقِيمِ بْنِ عَبْدِ الْمَلِكِ ، قَالَ :  رَأَيْتُ  الْحَسَنَ وَالْحُسَيْنَ رَضِيَ اللهُ عَنْهُمَا شَابَا وَمَا يَخْضِبَانِ  ""  .","","Al-Mu'jam al-Kabir 2537","","الحسين بن علي عن عثمان بن عبد الملك الحجازي عن محمد بن ربيعة بن سمير الرؤاسي عن جمهور بن منصور عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2536","2538  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  ابْنُ الصَّلْتِ ،  عَنْ  أَبِي شِهَابٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنِ  الْحَسَنِ بْنِ زَيْدٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  رَأَيْتُ  فِي رَأْسِ الْحَسَنِ  قَزَعَةً  ، فَلَقَدْ رَأَيْتُ  الْحَسَنَ  يَجْبِذُهَا حَتَّى يُدْنِيَهَا  ""  .","","Al-Mu'jam al-Kabir 2538","","الحسن بن علي سبط رسول الله عن زيد بن الحسن بن علي بن أبي طالب عن الحسن بن زيد بن الحسن بن علي بن أبي طالب عن محمد بن إسحاق عن عبد ربه بن نافع الحناط عن محمد بن الصلت الأصم عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2537","[3/23]      2539  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  طَاهِرُ بْنُ أَبِي أَحْمَدَ ،  ثَنَا  مَعْنُ بْنُ عِيسَى ،  عَنْ  سُلَيْمَانَ بْنِ بِلَالٍ ،  عَنْ  جَعْفَرٍ ،  عَنْ  أَبِيهِ  أَنَّهُ  قَالَ  :  كَانَ الْحَسَنُ يَتَخَتَّمُ فِي يَسَارِهِ  ""  .","","Al-Mu'jam al-Kabir 2539","","الحسن بن علي سبط رسول الله عن أبو جعفر الباقر عن جعفر الصادق عن سليمان بن بلال القرشي عن معن بن عيسى عن طاهر بن أبى أحمد الزبيري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2538","2540  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ اللهِ الْمُحَارِبِيُّ ،  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  قَالَ  :  كَانَ الْحَسَنُ بْنُ عَلِيٍّ رَضِيَ اللهُ عَنْهُ يَتَخَتَّمُ فِي يَسَارِهِ  .","","Al-Mu'jam al-Kabir 2540","","الحسن بن علي سبط رسول الله عن أبو جعفر الباقر عن جعفر الصادق عن حاتم بن إسماعيل الحارثي عن محمد بن عبيد بن محمد بن واقد النحاس عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2539","2541  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ الْحِمَّانِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  قَابُوسَ بْنِ الْمُخَارِقِ ،  عَنْ  أُمِّ الْفَضْلِ ، قَالَتْ :  قُلْتُ : يَا رَسُولَ اللهِ ، رَأَيْتُ فِي الْمَنَامِ كَأَنَّ عُضْوًا مِنْ أَعْضَائِكَ  فِي بَيْتِي ، أَوْ قَالَتْ : فِي حُجْرَتِي  . فَقَالَ : "" تَلِدُ  فَاطِمَةُ  غُلَامًا إِنْ شَاءَ اللهُ فَتَكْفُلِينَهُ "" . قَالَتْ : فَوَلَدَتْ  فَاطِمَةُ  حَسَنًا  ، فَدَفَعَهُ إِلَيْهَا فَأَرْضَعَتْهُ بِلَبَنِ  قُثَمَ بْنِ الْعَبَّاسِ  . قَالَتْ : فَجِئْتُ بِهِ يَوْمًا إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَبَالَ عَلَى صَدْرِهِ ، فَدَحَيْتُ فِي ظَهْرِهِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَهْلًا يَرْحَمُكِ اللهُ أَوْجَعْتِ ابْنِي "" . فَقُلْتُ : ادْفَعْ إِلَيَّ إِزَارَكَ فَأَغْسِلَهُ . فَقَالَ :  لَا ، صُبِّي عَلَيْهِ الْمَاءَ ، فَإِنَّهُ يُصَبُّ عَلَى بَوْلِ الْغُلَامِ ، وَيُغْسَلُ بَوْلُ الْجَارِيَةِ  .","","Al-Mu'jam al-Kabir 2541","","لبابة بنت الحارث الهلالية عن قابوس بن أبي المخارق الشيباني عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2540","2542  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ضِرَارُ بْنُ صُرَدٍ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  عَلِيِّ بْنِ مُيَسِّرٍ ،  عَنْ  عُمَرَ بْنِ عُمَيْرٍ ،  عَنْ  عُرْوَةَ بْنِ فَيْرُوزَ ،  عَنْ  سُورَةَ بِنْتِ مِشْرَحٍ ، قَالَتْ :  كُنْتُ فِيمَنْ حَضَرَ  فَاطِمَةَ  رَضِيَ اللهُ عَنْهَا حِينَ ضَرَبَهَا الْمَخَاضُ فِي نِسْوَةٍ ، فَأَتَانَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" كَيْفَ هِيَ ؟ "" قُلْتُ : إِنَّهَا لَمَجْهُودَةٌ يَا رَسُولَ اللهِ . قَالَ : "" فَإِذَا هِيَ وَضَعَتْ فَلَا تَسْبِقِينِي فِيهِ بِشَيْءٍ "" . قَالَتْ : فَوَضَعَتْ ، فَسَرُّوهُ وَلَفَّفُوهُ فِي خِرْقَةٍ صَفْرَاءَ ، فَجَاءَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" مَا فَعَلَتْ ؟ "" قُلْتُ : قَدْ وَلَدَتْ غُلَامًا ، وَسَرَرْتُهُ وَلَفَفْتُهُ فِي خِرْقَةٍ .         [3/24]      قَالَ : "" عَصَيْتِنِي "" . قَالَتْ : أَعُوذُ بِاللهِ مِنْ مَعْصِيَةِ اللهِ وَمِنْ غَضَبِ رَسُولِهِ . قَالَ : "" ائْتِينِي بِهِ "" . فَأَتَيْتُهُ بِهِ ، فَأَلْقَى الْخِرْقَةَ الصَّفْرَاءَ ، وَلَفَّهُ فِي خِرْقَةٍ بَيْضَاءَ ،  وَتَفَلَ  فِي فِيهِ ،  وَأَلْبَأَهُ  بِرِيقِهِ ، فَجَاءَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ ، فَقَالَ : "" مَا سَمَّيْتَهُ يَا  عَلِيُّ  ؟ "" قَالَ : سَمَّيْتُهُ  جَعْفَرًا  يَا رَسُولَ اللهِ . قَالَ :  لَا ، وَلَكِنْ  حَسَنٌ  ، وَبَعْدَهُ  حُسَيْنٌ  ، وَأَنْتَ  أَبُو حَسَنِ الْخَيْرِ  .","","Al-Mu'jam al-Kabir 2542","","سوادة الكندية عن عروة بن فيروز عن أبو الخطاب الهجري عن علي بن ميسر عن محمد بن فضيل بن غزوان عن ضرار بن صرد التيمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2541","2543  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ قَالَ :  كَانَ أَشْبَهَهُمْ بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْحَسَنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  "" .","","Al-Mu'jam al-Kabir 2543","","أنس بن مالك عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2542","2544  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  أَبِي جُحَيْفَةَ ، قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَكَانَ  الْحَسَنُ بْنُ عَلِيٍّ  يُشْبِهُهُ  .","","Al-Mu'jam al-Kabir 2544","","وهب بن عبد الله السوائي عن إسماعيل بن أبي خالد عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2543","2545  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ الْأَصْبَهَانِيُّ  ، ثَنَا  أَبُو مَسْعُودٍ أَحْمَدُ بْنُ الْفُرَاتِ ،  ثَنَا  الْحَسَنُ بْنُ قَيْسٍ ،  عَنْ  هَارُونَ بْنِ الْمُغِيرَةِ ،  عَنْ  عَمْرِو بْنِ أَبِي قَيْسٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي مَرْيَمَ ،  عَنِ  الْبَهِيِّ ،  قَالَ  :  تَذَاكَرْنَا شِبْهَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  إِنْ أَرَدْتُمْ أَنْ تَنْظُرُوا إِلَى شِبْهِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَانْظُرُوا إِلَى  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمْ  .","","Al-Mu'jam al-Kabir 2545","","عبد الله البهي مولى مصعب بن الزبير عن يزيد بن أبي مريم الدمشقي عن عمرو بن أبي قيس عن هارون بن المغيرة المروزي عن الحسن بن قيس عن كرز التيمي عن أحمد بن الفرات الضبي عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2544","2546  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  ثَنَا  إِسْمَاعِيلُ ، قَالَ :  قَالَ لِي  أَبُو جُحَيْفَةَ :  قَدْ رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَكَانَ  الْحَسَنُ بْنُ عَلِيٍّ  يُشْبِهُهُ  .","","Al-Mu'jam al-Kabir 2546","","وهب بن عبد الله السوائي عن إسماعيل بن أبي خالد عن محمد بن بشر بن الفرافصة عن محمد بن عبد الله بن نمير عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2545","2547  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  إِسْحَاقُ بْنُ شَاهِينَ ،  ثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  أَبِي جُحَيْفَةَ ، قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَكَانَ  الْحَسَنُ بْنُ عَلِيٍّ  يُشْبِهُهُ  .","","Al-Mu'jam al-Kabir 2547","","وهب بن عبد الله السوائي عن إسماعيل بن أبي خالد عن خالد بن عبد الله الطحان عن إسحاق بن شاهين الدهقاني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2546","[3/25]      2548  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، قَالَ :  قُلْتُ  لِأَبِي جُحَيْفَةَ : رَأَيْتَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : "" نَعَمْ ، وَأَشْبَهُ النَّاسِ بِهِ  الْحَسَنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمْ  .","","Al-Mu'jam al-Kabir 2548","","وهب بن عبد الله السوائي عن إسماعيل بن أبي خالد عن يزيد بن هارون عن الحسن بن علي الريحاني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2547","2549  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  أَبِي جُحَيْفَةَ ، قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَكَانَ  الْحَسَنُ بْنُ عَلِيٍّ  يُشْبِهُهُ  .","","Al-Mu'jam al-Kabir 2549","","وهب بن عبد الله السوائي عن إسماعيل بن أبي خالد عن عبد الله بن إدريس الأودي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2548","2550  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ فُسْتُقَةُ  ، ثَنَا  دَاوُدُ بْنُ رُشَيْدٍ  ، عَنِ  الْهَيْثَمِ بْنِ عَدِيٍّ  ،  قَالَ  : ""  هَلَكَ  الْحَسَنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ سَنَةَ أَرْبَعٍ وَأَرْبَعِينَ  ""  .  هَكَذَا قَالَ  الْهَيْثَمُ بْنُ عَدِيٍّ  ، وَخُولِفَ  .","","Al-Mu'jam al-Kabir 2550","","","ذكر مولد الحسن بن علي وصفته ووفاته"
"2549","2551  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ  ،  قَالَ  : ""  مَاتَ  الْحَسَنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ سَنَةَ ثَمَانٍ وَأَرْبَعِينَ  "" .","","Al-Mu'jam al-Kabir 2551","","","ذكر مولد الحسن بن علي وصفته ووفاته"
"2550","2552  -  حَدَّثَنَا  عُبَيْدٌ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ  ، ثَنَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ  ، ثَنَا  شُعْبَةُ  ، عَنْ  أَبِي بَكْرِ بْنِ حَفْصٍ  ،  قَالَ  : ""  تُوُفِّيَ  سَعْدٌ  وَالْحَسَنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمْ سَنَةَ ثَمَانٍ وَأَرْبَعِينَ  "" .","","Al-Mu'jam al-Kabir 2552","","","ذكر مولد الحسن بن علي وصفته ووفاته"
"2551","2553  -  حَدَّثَنَا  عُبَيْدٌ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ  ، ثَنَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ  ، ثَنَا  شُعْبَةُ  ، عَنْ  أَبِي بَكْرِ بْنِ حَفْصٍ  ،  قَالَ  : ""  تُوُفِّيَ  سَعْدٌ  وَالْحَسَنُ بْنُ عَلِيٍّ  بَعْدَمَا مَضَى مِنْ إِمْرَةِ  مُعَاوِيَةَ  عَشْرُ سِنِينَ رَضِيَ اللهُ عَنْهُمْ  ""  .","","Al-Mu'jam al-Kabir 2553","","","ذكر مولد الحسن بن علي وصفته ووفاته"
"2552","2554  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَبْدِ اللهِ بْنِ نُمَيْرٍ  يَقُولُ : ""  مَاتَ  الْحَسَنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ وَهُوَ ابْنُ سَبْعٍ وَأَرْبَعِينَ  "" .","","Al-Mu'jam al-Kabir 2554","","","ذكر مولد الحسن بن علي وصفته ووفاته"
"2553","2555  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَبْدِ اللهِ بْنِ نُمَيْرٍ  يَقُولُ : ""  مَاتَ  الْحَسَنُ بْنُ عَلِيٍّ  سَنَةَ ثَمَانٍ وَأَرْبَعِينَ  ""  .","","Al-Mu'jam al-Kabir 2555","","","ذكر مولد الحسن بن علي وصفته ووفاته"
"2554","[3/26]      2556  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  ،  قَالَ  : ""  تُوُفِّيَ  الْحَسَنُ بْنُ عَلِيٍّ  سَنَةَ تِسْعٍ وَأَرْبَعِينَ  ، وَصَلَّى عَلَيْهِ  سَعِيدُ بْنُ الْعَاصِ  ، وَكَانَ مَوْتُهُ  بِالْمَدِينَةِ  وَسِنُّهُ  سِتٌّ أَوْ سَبْعٌ  وَأَرْبَعُونَ ، وَيُكْنَى  أَبَا مُحَمَّدٍ  ""  .","","Al-Mu'jam al-Kabir 2556","","","ذكر مولد الحسن بن علي وصفته ووفاته"
"2555","2557  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  قَالَ  :  كَانَتِ الْفِتْنَةُ خَمْسَ سِنِينَ ، لِلْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ مِنْ ذَلِكَ أَرْبَعَةُ أَشْهُرٍ  ، وَكَانَتِ الْجَمَاعَةُ عَلَى  مُعَاوِيَةَ  سَنَةَ أَرْبَعِينَ  ""  .","","Al-Mu'jam al-Kabir 2557","","الحسن بن علي سبط رسول الله عن عبد الله بن محمد بن عقيل بن أبي طالب عن عبيد الله بن عمرو بن أبي الوليد عن علي بن معبد العبدي عن المقدام بن داود الرعيني عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2556","2558  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَدِينِيُّ  ، ثَنَا  أَبُو زَيْدٍ عُمَرُ بْنُ شَبَّةَ  ، عَنْ  أَبِي نُعَيْمٍ  ،  قَالَ  : ""  وَفِيهَا مَاتَ  الْحَسَنُ بْنُ عَلِيٍّ  وَسَعْدُ بْنُ أَبِي وَقَّاصٍ  سَنَةَ ثَمَانٍ وَخَمْسِينَ  ""  .","","Al-Mu'jam al-Kabir 2558","","","ذكر مولد الحسن بن علي وصفته ووفاته"
"2557","2559  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  قَالَ  :  شَهِدْتُ الْحَسَنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ  بِالنُّخَيْلَةِ  حِينَ صَالَحَهُ  مُعَاوِيَةُ  رَضِيَ اللهُ عَنْهُ ، فَقَالَ لَهُ  مُعَاوِيَةُ  :  إِذَا كَانَ ذَا فَقُمْ فَتَكَلَّمْ ،  وَأَخْبِرِ النَّاسَ أَنَّكَ قَدْ سَلَّمْتَ هَذَا الْأَمْرَ لِي . وَرُبَّمَا قَالَ  سُفْيَانُ  : أَخْبِرِ النَّاسَ بِهَذَا الْأَمْرِ الَّذِي تَرَكْتَهُ لِي  . فَقَامَ فَخَطَبَ عَلَى الْمِنْبَرِ ، فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ - قَالَ  الشَّعْبِيُّ  : وَأَنَا أَسْمَعُ - ثُمَّ قَالَ : "" أَمَّا بَعْدُ ، فَإِنَّ  أَكْيَسَ  الْكَيْسِ التُّقَى ، وَإِنَّ أَحْمَقَ الْحُمْقِ الْفُجُورُ ، وَإِنَّ هَذَا الْأَمْرَ الَّذِي اخْتَلَفْتُ فِيهِ أَنَا  وَمُعَاوِيَةُ  إِمَّا كَانَ حَقًّا لِي تَرَكْتُهُ  لِمُعَاوِيَةَ  إِرَادَةَ صَلَاحِ هَذِهِ الْأُمَّةِ ، وَحَقْنِ دِمَائِهِمْ ، أَوْ يَكُونُ حَقًّا كَانَ لِامْرِئٍ أَحَقَّ بِهِ مِنِّي ، فَفَعَلْتُ ذَلِكَ ،         {      وَإِنْ أَدْرِي لَعَلَّهُ فِتْنَةٌ لَكُمْ وَمَتَاعٌ إِلَى حِينٍ         }      .","","Al-Mu'jam al-Kabir 2559","","الحسن بن علي سبط رسول الله عن الشعبي عن مجالد بن سعيد عن سفيان بن عيينة عن علي ابن المديني عن الفضل بن الحباب الجمحي عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2558","2560  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ أَعْيَنَ الْبَغْدَادِيُّ ،  ثَنَا  دَاوُدُ بْنُ عَمْرٍو الضَّبِّيُّ ،  ثَنَا  أَسْبَاطُ بْنُ مُحَمَّدٍ ،  عَنْ  مُطَرِّفٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ الْأَصَمِّ ،  قَالَ  : دَخَلْتُ عَلَى الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُمَا وَهُوَ فِي دَارِ  عَمْرِو         [3/27]      بْنِ حُرَيْثٍ  ، فَقُلْتُ : إِنَّ نَاسًا يَزْعُمُونَ أَنَّ  عَلِيًّا  رَضِيَ اللهُ عَنْهُ يَرْجِعُ قَبْلَ يَوْمِ الْقِيَامَةِ . فَضَحِكَ وَقَالَ :  سُبْحَانَ اللهِ ، لَوْ عَلِمْنَا ذَلِكَ مَا زَوَّجْنَا نِسَاءَهُ ، وَلَا سَاهَمْنَا مِيرَاثَهُ  .","","Al-Mu'jam al-Kabir 2560","","الحسن بن علي سبط رسول الله عن عمرو بن عبد الله الأصم عن أبو إسحاق السبيعي عن مطرف بن طريف عن أسباط بن محمد بن ميسرة القرشي عن داود بن عمرو المسيبي عن محمد بن جعفر بن أعين البغدادي عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2559","2561  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْحَسَنِ بْنِ سَعْدٍ ،  عَنْ  أَبِيهِ  ،  قَالَ  :  مَتَّعَ  الْحَسَنُ بْنُ عَلِيٍّ رَضِيَ اللهُ عَنْهُ امْرَأَتَيْنِ بِعِشْرِينَ أَلْفًا وَزِقَاقٍ مِنْ عَسَلٍ ، فَقَالَتْ إِحْدَاهُمَا ، وَأُرَاهَا  حَنَفِيَّةَ  : مَتَاعٌ قَلِيلٌ مِنْ حَبِيبٍ مُفَارِقٍ  ""  .","","Al-Mu'jam al-Kabir 2561","","الحسن بن علي سبط رسول الله عن سعد بن معبد الهاشمي عن الحسن بن سعد مولى علي بن أبي طالب عن عبد الله بن عتبة بن مسعود عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","ذكر مولد الحسن بن علي وصفته ووفاته"
"2560","بَقِيَّةُ أَخْبَارِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا  2562  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْرَائِيلَ بْنِ يُونُسَ ،  عَنْ  أَبِي إِسْحَاقَ ،  قَالَ  :  مَتَّعَ  الْحَسَنُ بْنُ عَلِيٍّ رَضِيَ اللهُ عَنْهُمَا  امْرَأَةً  بِعِشْرِينَ أَلْفًا ، فَلَمَّا أُتِيَتْ بِهَا وَوُضِعَتْ بَيْنَ يَدَيْهَا قَالَتْ : مَتَاعٌ قَلِيلٌ مِنْ حَبِيبٍ مُفَارِقٍ  ""  .","","Al-Mu'jam al-Kabir 2562","","الحسن بن علي سبط رسول الله عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2561","2563  -  حَدَّثَنَا  سَهْلُ بْنُ مُوسَى شِيرَانُ الرَّامَهُرْمُزِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي صَفْوَانَ الثَّقَفِيُّ ،  ثَنَا  قُرَيْشُ بْنُ أَنَسٍ ،  ثَنَا  ابْنُ عَوْنٍ ،  عَنْ  مُحَمَّدٍ ،  قَالَ  :  خَطَبَ الْحَسَنُ بْنُ عَلِيٍّ رَضِيَ اللهُ عَنْهُمَا إِلَى  مَنْظُورِ بْنِ سَيَّارِ بْنِ رَيَّانَ الْفَزَارِيِّ  ابْنَتَهُ ، فَقَالَ : "" وَاللهِ إِنِّي لَأُنْكِحُكَ وَإِنِّي لَأَعْلَمُ أَنَّكَ غَلِقٌ طَلِقٌ مَلِقٌ  ، غَيْرَ أَنَّكَ أَكْرَمُ الْعَرَبِ بَيْتًا ، وَأَكْرَمُهُ نَسَبًا ""  .","","Al-Mu'jam al-Kabir 2563","","الحسن بن علي سبط رسول الله عن محمد بن سيرين عن عبد الله بن عون بن أرطبان عن قريش بن أنس عن محمد بن عثمان بن أبي صفوان الثقفي عن شيران سهل بن موسى الرامهرمزي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2562","2564  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا         [3/28]      عَبْدُ الْأَعْلَى ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنِ  ابْنِ سِيرِينَ ،  قَالَ  :  تَزَوَّجَ الْحَسَنُ بْنُ عَلِيٍّ  امْرَأَةً  ، فَأَرْسَلَ لَهَا بِمِائَةِ جَارِيَةٍ ، مَعَ كُلِّ جَارِيَةٍ أَلْفُ دِرْهَمٍ  ""  .","","Al-Mu'jam al-Kabir 2564","","الحسن بن علي سبط رسول الله عن محمد بن سيرين عن هشام بن حسان العتكي عن عبد الأعلى بن عبد الأعلى القرشي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2563","2565  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ وَمُحَمَّدُ بْنُ نُصَيْرٍ الْأَصْبَهَانِيَّانِ ، قَالَا :  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  عُبَيْدُ بْنُ وَسِيمٍ ،  ثَنَا  أَبُو شَدَّادٍ ،  قَالَ  :  كُنْتُ أُلَاعِبُ الْحَسَنَ وَالْحُسَيْنَ  بِالْمَدَاحِي ،  فَإِذَا مَا دَحَانِي رَكِبَانِي ، وَإِذَا مَادَحْتُهُمَا قَالَا : تَرْكَبُ بِضْعَةً مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  "" ؟  .","","Al-Mu'jam al-Kabir 2565","","الحسين بن علي عن سلمان المدني عن عبيد بن الوسيم البكري عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2564","2566  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  الْحَسَنُ بْنُ الرَّبِيعِ ،  عَنْ  سَالِمٍ أَبِي عَبْدِ اللهِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ، قَالَ :  سَأَلْتُ  عَطَاءً : أَحْمِلُ مِنْ مَاءِ زَمْزَمَ ؟ فَقَالَ : "" قَدْ حَمَلَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، وَحَمَلَهُ  الْحَسَنُ  وَالْحُسَيْنُ  رَضِيَ اللهُ عَنْهُمَا  .","","Al-Mu'jam al-Kabir 2566","","عطاء بن أبي رباح عن حبيب بن أبي ثابت الكاهلي عن سالم البراد عن الحسن بن الربيع البوراني عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2565","2567  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو مَعْمَرٍ الْمُقْعَدُ ،  ثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  أَيُّوبَ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ""  عَقَّ  عَنِ  الْحَسَنِ  وَالْحُسَيْنِ  رَضِيَ اللهُ عَنْهُمَا  .","","Al-Mu'jam al-Kabir 2567","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن أيوب السختياني عن عبد الوارث بن سعيد بن ذكوان عن عبد الله بن عمرو المقعد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2566","2568  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  أَحْمَدُ بْنُ حَفْصٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنِ  الْحَجَّاجِ بْنِ الْحَجَّاجِ ،  عَنْ  قَتَادَةَ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ :  عَقَّ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الْحَسَنِ  وَالْحُسَيْنِ  .","","Al-Mu'jam al-Kabir 2568","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن قتادة بن دعامة عن حجاج بن حجاج الباهلي الأحول عن إبراهيم بن طهمان عن حفص بن عبد الله بن راشد النيسابوري عن أحمد بن حفص بن عبد الله النيسابوري عن موسى بن هارون الحمال عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2567","2569  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ الْمُحَارِبِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْأَجْلَحِ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  عُقَّ  عَنِ  الْحَسَنِ  وَالْحُسَيْنِ  رَضِيَ اللهُ عَنْهُمَا  .","","Al-Mu'jam al-Kabir 2569","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن يحيى بن سعيد الأنصاري عن عبد الله بن الأجلح عن محمد بن عبيد بن محمد بن واقد النحاس عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2568","2570  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الْكِنْدِيُّ ،  ثَنَا  الْمُحَارِبِيُّ ،  عَنْ  يَحْيَى بْنِ         [3/29]      سَعِيدٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا  أَنَّ  حَسَنًا  وَحُسَيْنًا  عُقَّ  عَنْهُمَا  .","","Al-Mu'jam al-Kabir 2570","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن يحيى بن سعيد الأنصاري عن محمد بن عبيد بن محمد بن واقد النحاس عن علي بن سعيد بن مسروق الكندي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2569","2571  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  حَدَّثَنَا  عَبَّادُ بْنُ أَحْمَدَ الْعَرْزَمِيُّ ،  ثَنَا  عَمِّي ،  عَنْ  أَبِيهِ  ،  عَنْ  عَمْرِو بْنِ قَيْسٍ ،  عَنْ  عَطِيَّةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ رَضِيَ اللهُ عَنْهُ ، قَالَ :  قَالَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ :  أَمَّا  حَسَنٌ  وَحُسَيْنٌ  وَمُحَسِّنٌ  فَإِنَّمَا سَمَّاهُمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  وَعَقَّ  عَنْهُمْ  ، وَحَلَقَ رُءُوسَهُمْ ، وَتَصَدَّقَ بَوَزْنِهَا ، وَأَمَرَ بِهِمْ فَسُرُّوا وَخُتِنُوا  .","","Al-Mu'jam al-Kabir 2571","","أبو سعيد الخدري عن عطية بن سعد العوفي عن عمرو بن قيس الملائي عن عبد الرحمن بن محمد العرزمي عن محمد بن عبد الرحمن العرزمي عن عباد العرزمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2570","2572  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  مُحَمَّدُ بْنُ جَابِرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  بَعْضِ أَصْحَابِهِ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عَقَّ  عَنِ  الْحَسَنِ  وَالْحُسَيْنِ  رَضِيَ اللهُ عَنْهُمَا  .","","Al-Mu'jam al-Kabir 2572","","علي بن أبي طالب عن بعض أصحاب أبو إسحاق السبيعي عن أبو إسحاق السبيعي عن محمد بن جابر بن سيار عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2571","2573  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  سَهْلُ بْنُ زَنْجَلَةَ الرَّازِيُّ ، وَالْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ، قَالَا :  ثَنَا  شَبَابَةُ بْنُ سَوَّارٍ ،  عَنِ  الْمُغِيرَةِ بْنِ مُسْلِمٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، قَالَ :  عَقَّ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الْحَسَنِ  وَالْحُسَيْنِ  رَضِيَ اللهُ عَنْهُمَا  .","","Al-Mu'jam al-Kabir 2573","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن المغيرة بن مسلم القسملي عن شبابة بن سوار المدائني عن الحسن بن علي الريحاني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2572","2574  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مَحْمُودُ بْنُ غَيْلَانَ ،  ثَنَا  عَلِيُّ بْنُ الْحَسَنِ بْنِ شَقِيقٍ ،  حَدَّثَنَا  الْحُسَيْنُ بْنُ وَاقِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  عَقَّ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الْحَسَنِ  وَالْحُسَيْنِ  رَضِيَ اللهُ عَنْهُمَا  .","","Al-Mu'jam al-Kabir 2574","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن الحسين بن واقد المروزي عن علي بن الحسن بن شقيق عن محمود بن غيلان المروزي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2573","2575  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى بْنِ خَالِدِ بْنِ حَيَّانَ الرَّقِّيُّ ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عُمَارَةَ بْنِ غَزِيَّةَ ،  عَنْ  رَبِيعَةَ بْنِ أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ رَضِيَ اللهُ عَنْهُ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَ بِرَأْسَيِ  الْحَسَنِ  وَالْحُسَيْنِ         [3/30]      ابْنَيْ  عَلِيِّ بْنِ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُمْ يَوْمَ سَابِعِهِمَا فَحُلِقَ ، ثُمَّ  تَصَدَّقَ  بِوَزْنِهِ فِضَّةً ، وَلَمْ يَجِدْ  ذِبْحًا  .","","Al-Mu'jam al-Kabir 2575","","أنس بن مالك عن ربيعة الرأي عن عمارة بن غزية عن عبد الله بن لهيعة عن يحيى بن عبد الله بن بكير المخزومي عن أحمد بن يحيى بن خالد الرقي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2574","2576  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُوسَى بْنُ دَاوُدَ الضَّبِّيُّ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُعَلَّى بْنُ مَهْدِيٍّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  عَلِيِّ بْنِ الْحُسَيْنِ ،  عَنْ  أَبِي رَافِعٍ ، قَالَ :  لَمَّا وَلَدَتْ  فَاطِمَةُ  رَضِيَ اللهُ عَنْهَا  حَسَنًا  قَالَتْ : يَا رَسُولَ اللهِ ، أَلَا أَعُقُّ عَنِ ابْنِي ؟ قَالَ :  لَا ، وَلَكِنِ احْلِقِي رَأْسَهُ ، وَتَصَدَّقِي بِوَزْنِ شَعَرَهُ  وَرِقًا - أَوْ قَالَ : فِضَّةً  - عَلَى الْمَسَاكِينِ  . فَلَمَّا وَلَدَتْ  حُسَيْنًا  رَضِيَ اللهُ عَنْهُ فَعَلَتْ بِهِ مِثْلَ ذَلِكَ  وَقَالَ  مُوسَى بْنُ دَاوُدَ  فِي حَدِيثِهِ : عَلَى  الْأَوْفَاضِ  وَالْمَسَاكِينِ  .  وَقَالَ أَبُو الْقَاسِمِ : ""  الْأَوْفَاضُ  الْفُقَرَاءُ ، وَالْأَوْقَاصُ مَا بَيْنَ الْفَرِيضَتَيْنِ  "" .","","Al-Mu'jam al-Kabir 2576","","أبو رافع القبطي عن علي بن الحسين زين العابدين عن عبد الله بن محمد بن عقيل بن أبي طالب عن شريك بن عبد الله النخعي عن موسى بن داود الخلقاني عن محمد بن أحمد بن النضر النضري عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2575","2577  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  سَعِيدُ بْنُ أَبِي الرَّبِيعِ السَّمَّانُ ،  ثَنَا  سَعِيدُ بْنُ سَلَمَةَ بْنِ أَبِي الْحُسَامِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  عَلِيِّ بْنِ الْحُسَيْنِ ،  عَنْ  أَبِي رَافِعٍ  أَنَّ  الْحَسَنَ بْنَ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا حِينَ وَلَدَتْهُ  فَاطِمَةُ  رَضِيَ اللهُ عَنْهَا أَرَادَتْ أَنْ  تَعُقَّ  عَنْهُ بِكَبْشٍ عَظِيمٍ ، فَأَتَتْ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  لَا تَعُقِّي عَنْهُ بِشَيْءٍ ، وَلَكِنِ احْلِقِي شَعَرَ رَأْسِهِ ، ثُمَّ تَصَدَّقِي بِوَزْنِهِ مِنَ الْوَرِقِ فِي  سَبِيلِ  اللهِ ، أَوْ عَلَى  الْأَوْفَاضِ  . "" ثُمَّ وَلَدَتِ  الْحُسَيْنَ  رَضِيَ اللهُ عَنْهُ مِنَ الْعَامِ الْمُقْبِلِ ، فَصَنَعَتْ بِهِ كَذَلِكَ  .","","Al-Mu'jam al-Kabir 2577","","أبو رافع القبطي عن علي بن الحسين زين العابدين عن عبد الله بن محمد بن عقيل بن أبي طالب عن سعيد بن سلمة السدوسي عن سعيد بن أبى الربيع السمان عن عبد الله بن أحمد الجواليقي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2576","2578  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ، (  ح  ) ،  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَاصِمِ بْنِ         [3/31]      عُبَيْدِ اللهِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي رَافِعٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَذَّنَ فِي أُذُنِ  الْحَسَنِ بْنِ عَلِيٍّ  بِالصَّلَاةِ حِينَ وَلَدَتْهُ  فَاطِمَةُ  رَضِيَ اللهُ عَنْهُمَا  .","","Al-Mu'jam al-Kabir 2578","","أبو رافع القبطي عن عبيد الله بن أبي رافع مولى رسول الله عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2577","2579  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَوْنُ بْنُ سَلَّامٍ وَجُبَارَةُ بْنُ مُغَلِّسٍ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ شُعَيْبٍ ،  عَنْ  عَاصِمِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  عَلِيِّ بْنِ الْحُسَيْنِ ،  عَنْ  أَبِي رَافِعٍ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَذَّنَ فِي أُذُنِ  الْحَسَنِ  وَالْحُسَيْنِ  حِينَ وُلِدَا ، وَأَمَرَ بِهِ  .","","Al-Mu'jam al-Kabir 2579","","أبو رافع القبطي عن علي بن الحسين زين العابدين عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن حماد بن شعيب الحماني عن عون بن سلام الهاشمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2578","2580  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ عَوْنٍ ،  عَنْ  عُمَيْرِ بْنِ إِسْحَاقَ  أَنَّ  أَبَا هُرَيْرَةَ لَقِيَ  الْحَسَنَ بْنَ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمْ ، فَقَالَ :  ارْفَعْ ثَوْبَكَ حَتَّى أُقَبِّلَ حَيْثُ رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُقَبِّلُ  . فَرَفَعَ عَنْ بَطْنِهِ ، وَوَضَعَ يَدَهُ عَلَى سُرَّتِهِ  .","","Al-Mu'jam al-Kabir 2580","","أبو هريرة الدوسي عن عمير بن إسحاق الهاشمي عن عبد الله بن عون بن أرطبان عن أبو عاصم النبيل عن أبو مسلم الكجي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2579","2581  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  حَدَّثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  يَزِيدَ بْنِ يُحَنَّسَ ،  عَنْ  سَعِيدِ بْنِ زَيْدٍ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ احْتَضَنَ  حَسَنًا  ، ثُمَّ قَالَ :  اللَّهُمَّ إِنِّي قَدْ أَحْبَبْتُهُ فَأَحِبَّهُ  .","","Al-Mu'jam al-Kabir 2581","","سعيد بن زيد بن عمرو العدوي عن يزيد بن يحنس عن يزيد بن أبي زياد القرشي عن عبد السلام بن حرب الملائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2580","2582  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  شُعْبَةُ  أَنَا  عَدِيُّ بْنُ ثَابِتٍ قَالَ :  سَمِعْتُ  الْبَرَاءَ بْنَ عَازِبٍ يَقُولُ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  وَالْحَسَنُ بْنُ عَلِيٍّ  عَلَى عَاتِقِهِ ، وَهُوَ يَقُولُ :  اللَّهُمَّ إِنِّي أُحِبُّهُ فَأَحِبَّهُ  .","","Al-Mu'jam al-Kabir 2582","","البراء بن عازب الأوسي عن عدي بن ثابت الظفري عن شعبة بن الحجاج عن حجاج بن المنهال الأنماطي عن أبو مسلم الكجي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2581","2583  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  حَدَّثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  فُضَيْلُ بْنُ         [3/32]      مَرْزُوقٍ ،  عَنْ  عَدِيِّ بْنِ ثَابِتٍ ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ ، قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِلْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ :  اللَّهُمَّ إِنِّي قَدْ أَحْبَبْتُهُ فَأَحِبَّهُ وَأَحِبَّ مَنْ أَحَبَّهُ  .","","Al-Mu'jam al-Kabir 2583","","البراء بن عازب الأوسي عن عدي بن ثابت الظفري عن فضيل بن مرزوق الأغر عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2582","2584  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الطُّفَيْلِ ،  ثَنَا  شَرِيكُ  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنْ  عَدِيِّ بْنِ ثَابِتٍ ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَامِلًا  الْحَسَنَ بْنَ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمْ عَلَى عَاتِقِهِ ، وَهُوَ يَقُولُ :  اللَّهُمَّ إِنِّي أُحِبُّ حَسَنًا فَأَحِبَّهُ  .","","Al-Mu'jam al-Kabir 2584","","البراء بن عازب الأوسي عن عدي بن ثابت الظفري عن أشعث بن سوار عن شريك بن عبد الله النخعي عن محمد بن الطفيل بن مالك النخعي عن أحمد بن عمرو بن حفص القريعي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2583","2585  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُوسَى بْنُ مُحَمَّدِ بْنِ حَيَّانَ الْبَصْرِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ أَبِي الْوَزِيرِ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي الْكَنَّاتِ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَأْخُذُ  حَسَنًا  فَيَضُمُّهُ إِلَيْهِ ، فَيَقُولُ :  اللَّهُمَّ إِنَّ هَذَا ابْنِي فَأَحِبَّهُ ، وَأَحِبَّ مَنْ يُحِبُّهُ  .","","Al-Mu'jam al-Kabir 2585","","عائشة بنت أبي بكر الصديق عن ابن أبي مليكة عن عثمان بن أبى الكنات المكي عن إبراهيم بن أبي الوزير عن موسى بن محمد بن سعيد البصري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2584","2586  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  رَاشِدِ بْنِ سَعْدٍ ،  عَنْ  يَعْلَى بْنِ مُرَّةَ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَدُعِينَا إِلَى طَعَامٍ ، فَإِذَا  الْحُسَيْنُ  رَضِيَ اللهُ عَنْهُ يَلْعَبُ فِي الطَّرِيقِ ، فَأَسْرَعَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَامَ  الْقَوْمِ  ، ثُمَّ بَسَطَ يَدَيْهِ ، فَجَعَلَ  حُسَيْنٌ  يَمُرُّ مَرَّةً هَاهُنَا وَمَرَّةً هَاهُنَا ، فَيُضَاحِكُهُ حَتَّى أَخَذَهُ ، فَجَعَلَ إِحْدَى يَدَيْهِ فِي ذَقَنِهِ ، وَالْأُخْرَى بَيْنَ رَأْسِهِ وَأُذُنَيْهِ ، ثُمَّ اعْتَنَقَهُ فَقَبَّلَهُ ، ثُمَّ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  حُسَيْنٌ  مِنِّي وَأَنَا مِنْهُ ، أَحَبَّ اللهُ مَنْ أَحَبَّهُ ،  الْحَسَنُ  وَالْحُسَيْنُ  سِبْطَانِ مِنَ  الْأَسْبَاطِ  .","","Al-Mu'jam al-Kabir 2586","","يعلى بن مرة الثقفي عن راشد بن سعد المقرائي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2585","2587  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  يَحْيَى بْنُ سُلَيْمٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُثْمَانَ بْنِ خُثَيْمٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي رَاشِدٍ ،  عَنْ  يَعْلَى         [3/33]      بْنِ مُرَّةَ  أَنَّ  حَسَنًا  وَحُسَيْنًا  أَقْبَلَا يَمْشِيَانِ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا جَاءَ أَحَدُهُمَا جَعَلَ يَدَهُ فِي عُنُقِهِ ، ثُمَّ جَاءَ الْآخَرُ فَجَعَلَ يَدَهُ الْأُخْرَى فِي عُنُقِهِ ، فَقَبَّلَ هَذَا ، ثُمَّ قَبَّلَ هَذَا ، ثُمَّ قَالَ :  اللَّهُمَّ إِنِّي أُحِبُّهُمَا فَأَحِبَّهُمَا ، أَيُّهَا النَّاسُ ، إِنَّ الْوَلَدَ  مَبْخَلَةٌ  مَجْبَنَةٌ  .","","Al-Mu'jam al-Kabir 2587","","يعلى بن مرة الثقفي عن سعيد بن أبي راشد السماك عن عبد الله بن عثمان بن خثيم عن يحيى بن سليم الطائفي عن العباس بن الوليد النرسي عن عبد الله بن أحمد الجواليقي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2586","2588  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ وَعَارِمٌ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أَبِي بَكْرَةَ ، قَالَ :  بَيْنَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْطُبُ إِذْ صَعِدَ إِلَيْهِ  الْحَسَنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ ، فَضَمَّهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  إِنَّ ابْنِي هَذَا  سَيِّدٌ ،  وَلَعَلَّ اللهَ عَزَّ وَجَلَّ أَنْ يُصْلِحَ بِهِ بَيْنَ  فِئَتَيْنِ  مِنَ الْمُسْلِمِينَ  .","","Al-Mu'jam al-Kabir 2588","","أبو بكرة الثقفي عن الحسن البصري عن علي بن زيد بن جدعان عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2587","2589  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْقَوَّاشُ ،  ثَنَا  مُسْلِمُ بْنُ خَالِدٍ ،  عَنِ  ابْنِ خَيْثَمٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي رَاشِدٍ ،  عَنْ  يَعْلَى بْنِ مُرَّةَ الْعَامِرِيِّ  أَنَّهُمْ خَرَجُوا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى طَعَامٍ دُعُوا إِلَيْهِ ، فَإِذَا  حُسَيْنٌ  رَضِيَ اللهُ عَنْهُ يَلْعَبُ مَعَ صِبْيَانٍ ، فَاسْتَقْبَلَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَبَسَطَ يَدَهُ ، فَجَعَلَ الْغُلَامُ يَفِرُّ هَاهُنَا وَهَاهُنَا ، فَيُضَاحِكُهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى أَخَذَهُ ، فَجَعَلَ إِحْدَى يَدَيْهِ فِي عُنُقِهِ ، وَالْأُخْرَى فِي  فَأْسِ  رَأْسِهِ ، ثُمَّ اعْتَنَقَهُ فَقَبَّلَهُ ، ثُمَّ قَالَ :  حُسَيْنٌ  مِنِّي وَأَنَا مِنْ  حُسَيْنٍ  ، أَحَبَّ اللهُ مَنْ أَحَبَّ حُسَيْنًا ، حُسَيْنٌ  سِبْطٌ  مِنَ  الْأَسْبَاطِ  .","","Al-Mu'jam al-Kabir 2589","","يعلى بن مرة الثقفي عن سعيد بن أبي راشد السماك عن عبد الله بن عثمان بن خثيم عن مسلم بن خالد الزنجي عن أحمد بن محمد بن علقمة النبال عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2588","2590  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ، (  ح  ) ،  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَ :  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ، قَالَا :  ثَنَا  سُفْيَانُ ،  عَنْ  إِسْرَائِيلَ أَبِي مُوسَى ،  عَنِ  الْحَسَنِ ، قَالَ :  حَدَّثَنِي  أَبُو بَكْرَةَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى الْمِنْبَرِ ،  وَالْحَسَنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ إِلَى جَنْبِهِ ، وَهُوَ يَنْظُرُ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَظْرَةً ، وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَنْظُرُ إِلَيْهِ نَظْرَةً ، وَيَقُولُ :  إِنَّ ابْنِي هَذَا  سَيِّدٌ ،  وَلَعَلَّ اللهَ أَنْ يُصْلِحَ بِهِ بَيْنَ  فِئَتَيْنِ  مِنَ الْمُسْلِمِينَ  .","","Al-Mu'jam al-Kabir 2590","","أبو بكرة الثقفي عن الحسن البصري عن إسرائيل بن موسى أبو موسى البصري عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن أبو مسلم الكجي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2589","[3/34]      2591  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ الْبَصْرِيُّ وَأَبُو خَلِيفَةَ ، قَالَا :  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  مُبَارَكُ بْنُ فَضَالَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  أَبِي بَكْرَةَ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي ، فَكَانَ  الْحَسَنُ  يَجِيءُ وَهُوَ صَبِيُّ صَغِيرٌ ، فَكَانَ كُلَّمَا سَجَدَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَثَبَ عَلَى رَقَبَتِهِ وَظَهْرِهِ ، فَيَرْفَعُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَأْسَهُ رَفْعًا رَفِيقًا حَتَّى يَضَعَهُ ، فَقَالُوا : يَا رَسُولَ اللهِ إِنَّكَ لَتَصْنَعُ بِهَذَا الْغُلَامِ شَيْئًا مَا رَأَيْنَاكَ تَصْنَعُهُ .  إِنَّهُ رَيْحَانَتِي مِنَ الدُّنْيَا ، إِنَّ ابْنِي هَذَا  سَيِّدٌ ،  وَعَسَى أَنْ يُصْلِحَ اللهُ بِهِ بَيْنَ  فِئَتَيْنِ  مِنَ الْمُسْلِمِينَ  .","","Al-Mu'jam al-Kabir 2591","","أبو بكرة الثقفي عن الحسن البصري عن مبارك بن فضالة عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2590","2592  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ النَّيْسَابُورِيُّ ،  ثَنَا  الرَّبِيعُ بْنُ سُلَيْمَانَ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ شَيْبَةَ الْجُدِّيُّ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  يُونُسَ وَمَنْصُورٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أَبِي بَكْرَةَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَمَعَهُ  الْحَسَنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ وَهُوَ يَقُولُ :  إِنَّ ابْنِي هَذَا  سَيِّدٌ  ، وَإِنَّ اللهَ سَيُصْلِحُ عَلَى يَدَيْهِ بَيْنَ  فِئَتَيْنِ  مِنَ الْمُسْلِمِينَ عَظِيمَتَيْنِ  .","","Al-Mu'jam al-Kabir 2592","","أبو بكرة الثقفي عن الحسن البصري عن منصور بن المعتمر عن هشيم بن بشير عن عبد الرحمن بن شيبة عن الربيع بن سليمان المرادي عن جعفرك المفيد الأعرج عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2591","2593  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَنْصَارِيُّ ،  ثَنَا  أَشْعَثُ بْنُ عَبْدِ الْمَلِكِ ،  عَنِ  الْحَسَنِ ،  عَنْ  أَبِي بَكْرَةَ ، قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِلْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ :  إِنَّ ابْنِي هَذَا  سَيِّدٌ  ، وَإِنِّي أَرْجُو أَنْ يُصْلِحَ اللهُ بِهِ بَيْنَ  فِئَتَيْنِ  مِنْ أُمَّتِي  .","","Al-Mu'jam al-Kabir 2593","","أبو بكرة الثقفي عن الحسن البصري عن أشعث الحمراني عن محمد بن عبد الله بن المثنى الخزرجي عن أبو موسى الزمن عن أحمد بن يحيى بن زهير التستري عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2592","2594  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُسْلِمٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أَبِي بَكْرَةَ ، قَالَ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمًا وَمَعَهُ  حَسَنٌ  وَحُسَيْنٌ  ، فَلَمَّا سَجَدَ أَتَى  الْحَسَنُ  فَوَثَبَ عَلَى ظَهْرِهِ ، فَكَانَ إِذَا رَفَعَ رَأْسَهُ حَرَّفَهُ كَرَاهِيَةَ أَنْ يَسْقُطَ ، فَلَمَّا انْصَرَفَ أَخَذَ بِيَدِهِ ، فَأَجْلَسَهُ فِي حِجْرِهِ فَقَبَّلَهُ ، فَقَالَ :  إِنَّ ابْنِي هَذَا  سَيِّدٌ ،  وَإِنَّهُ رَيْحَانَتِي فِي الدُّنْيَا  ، وَأَرْجُو أَنْ يُصْلِحَ اللهُ بِهِ بَيْنَ  فِئَتَيْنِ  مِنَ الْمُسْلِمِينَ عَظِيمَتَيْنِ  .","","Al-Mu'jam al-Kabir 2594","","أبو بكرة الثقفي عن الحسن البصري عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن أبو معاوية الضرير عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2593","[3/35]      2595  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ الْبَزَّارُ التُّسْتَرِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ يُوسُفَ الْجُبَيْرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَنْصَارِيُّ ،  ثَنَا  أَبُو الْأَشْهَبِ ،  عَنِ  الْحَسَنِ ،  عَنْ  أَبِي بَكْرَةَ ، قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِلْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا :  إِنَّ ابْنِي هَذَا  سَيِّدٌ ،  وَإِنِّي لَأَرْجُو أَنْ يُصْلِحَ اللهُ بِهِ بَيْنَ  فِئَتَيْنِ  مِنْ أُمَّتِي  .","","Al-Mu'jam al-Kabir 2595","","أبو بكرة الثقفي عن الحسن البصري عن جعفر بن حيان العطاردي عن محمد بن عبد الله بن المثنى الخزرجي عن عبيد الله بن يوسف الجبيري عن التستري أحمد بن عبد الله بن زياد عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2594","2596  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْحَكَمِ بْنِ أَبِي زِيَادٍ الْقَطَوَانِيُّ ،  حَدَّثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  ثَنَا  مُحَمَّدُ بْنُ صَالِحٍ التَّمَّارُ الْمَدَنِيُّ ،  حَدَّثَنِي  مُسْلِمُ بْنُ أَبِي مَرْيَمَ ،  عَنِ  الْمَقْبُرِيِّ ، قَالَ :  كُنَّا مَعَ أَبِي هُرَيْرَةَ ، فَجَاءَ  الْحَسَنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمْ فَسَلَّمَ عَلَيْهِ ، فَرَدَّ عَلَيْهِ  الْقَوْمُ  وَمَضَى  وَأَبُو هُرَيْرَةَ  لَا يَعْلَمُ ، فَقِيلَ لَهُ هَذَا  حَسَنُ بْنُ عَلِيٍّ  يُسَلِّمُ ، فَلَحِقَهُ فَقَالَ : وَعَلَيْكَ يَا سَيِّدِي . فَقِيلَ لَهُ : تَقُولُ يَا سَيِّدِي ؟ فَقَالَ :  أَشْهَدُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : "" إِنَّهُ سَيِّدٌ  .","","Al-Mu'jam al-Kabir 2596","","أبو هريرة الدوسي عن سعيد المقبري عن مسلم بن أبي مريم الأنصاري عن محمد بن صالح بن دينار التمار عن زيد بن الحباب العكلي عن عبد الله بن الحكم القطواني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2595","2597  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ عَاصِمٍ الرَّازِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ ابْنِي -  يَعْنِي  الْحَسَنَ  -  سَيِّدٌ  ، وَلَيُصْلِحَنَّ اللهُ بِهِ بَيْنَ  فِئَتَيْنِ  مِنَ الْمُسْلِمِينَ  .","","Al-Mu'jam al-Kabir 2597","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن عبد الرحمن بن مغراء الدوسي عن عبد السلام بن عاصم الهسنجاني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2596","2598  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَوْنٍ السِّيرَافِيُّ ،  ثَنَا  أَبُو الْأَشْعَثِ أَحْمَدُ بْنُ الْمِقْدَامِ ،  ثَنَا  أَبُو سُمَيْرٍ حَكِيمُ بْنُ خِذَامٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنْ  أَبِيهِ  ،  عَنْ  شُرَيْحٍ الْقَاضِي ،  عَنْ  عُمَرَ بْنِ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْحَسَنُ  وَالْحُسَيْنُ  سَيِّدَا شَبَابِ أَهْلِ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 2598","","عمر بن الخطاب عن شريح بن الحارث الكندي عن يزيد بن شريك بن طارق التيمي عن إبراهيم بن يزيد بن شريك التيمي عن الأعمش عن حكيم بن خذام الأزدي عن أحمد بن المقدام العجلي عن محمد بن عون بن داود مشليق عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2597","2599  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو         [3/36]      الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْحَارِثِ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْحَسَنُ  وَالْحُسَيْنُ  سَيِّدَا شَبَابِ أَهْلِ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 2599","","علي بن أبي طالب عن الحارث الأعور عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2598","2600  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ الْمِصْرِيُّ ،  ثَنَا  يَزِيدُ بْنُ مَوْهَبٍ الرَّمْلِيُّ ،  ثَنَا  مَسْرُوحٌ أَبُو شِهَابٍ ،  عَنْ  سُفْيَانَ الثَّوْرِيِّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْحَارِثِ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْحَسَنُ  وَالْحُسَيْنُ  سَيِّدَا شَبَابِ أَهْلِ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 2600","","الحارث الأعور عن أبو إسحاق السبيعي عن سفيان الثوري عن مسروح بن عبد الرحمن الكوفي عن يزيد بن خالد بن يزيد بن موهب عن روح بن الفرج القطان عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2599","2601  -  حَدَّثَنَا  الْقَاسِمُ بْنُ مُحَمَّدٍ الدَّلَّالُ الْكُوفِيُّ ،  ثَنَا  مُخَوَّلُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  مَنْصُورُ بْنُ أَبِي الْأَسْوَدِ ،  عَنْ  لَيْثٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  الْحَارِثِ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْحَسَنُ  وَالْحُسَيْنُ  سَيِّدَا شَبَابِ أَهْلِ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 2601","","علي بن أبي طالب عن الحارث الأعور عن الشعبي عن ليث بن أبي سليم عن منصور بن أبي الأسود الليثي عن مخول بن إبراهيم الكوفي عن قاسم بن محمد بن حماد الدلال عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2600","2602  -  حَدَّثَنَا  الْقَاسِمُ بْنُ مُحَمَّدٍ الدَّلَّالُ الْكُوفِيُّ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ إِسْحَاقَ الصِّينِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  عَنْ  أَبِي جَنَابٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  زَيْدِ بْنِ يُثَيْعٍ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2602","","علي بن أبي طالب عن زيد بن يثيع الهمداني عن الشعبي عن يحيى بن أبي حية عن محمد بن أبان بن صالح عن إبراهيم بن إسحاق الصيني عن قاسم بن محمد بن حماد الدلال عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2601","2603  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ الْأَوْدِيُّ ،  ثَنَا  عَلِيُّ بْنُ ثَابِتٍ ،  حَدَّثَنَا  أَسْبَاطُ بْنُ نَصْرٍ ،  عَنْ  جَابِرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ يَحْيَى  ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ ، قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِفَاطِمَةَ  رَضِيَ اللهُ عَنْهَا :  وَاللهِ مَا مِنْ نَبِيٍّ إِلَّا وَوَلَدُ الْأَنْبِيَاءِ غَيْرِي ، وَإِنَّ ابْنَيْكِ سَيِّدَا شَبَابِ أَهْلِ الْجَنَّةِ  ، إِلَّا ابْنَيِ الْخَالَةِ  يَحْيَى  وَعِيسَى  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عبد الله بن نجي )","","Al-Mu'jam al-Kabir 2603","","علي بن أبي طالب عن عبد الله بن نجي بن سلمة الحضرمي عن جابر الجعفي عن أسباط بن نصر الهمداني عن علي بن ثابت الدهان عن أحمد بن عثمان بن حكيم عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2602","2604  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مُحَمَّدُ بْنُ مَرْوَانَ         [3/37]      الذُّهْلِيُّ ،  حَدَّثَنِي  أَبُو حَازِمٍ ،  حَدَّثَنِي  أَبُو هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ مَلَكًا مِنَ السَّمَاءِ لَمْ يَكُنْ زَارَنِي ، فَاسْتَأْذَنَ اللهَ عَزَّ وَجَلَّ فِي زِيَارَتِي  ، فَبَشَّرَنِي أَنَّ  الْحَسَنَ  وَالْحُسَيْنَ  سَيِّدَا شَبَابِ أَهْلِ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 2604","","أبو هريرة الدوسي عن سلمان الأعرج مولى عزة الأشجعية عن محمد بن مروان الذهلي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2603","2605  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  حَدَّثَنَا  جُمْهُورُ بْنُ مَنْصُورٍ ،  ثَنَا  يُوسُفُ بْنُ مُحَمَّدٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي الْجَحَّافِ وَحَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْحَسَنُ  وَالْحُسَيْنُ  سَيِّدَا شَبَابِ أَهْلِ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 2605","","أبو هريرة الدوسي عن سلمان الأعرج مولى عزة الأشجعية عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن يوسف بن محمد العصفري عن جمهور بن منصور عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2604","2606  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  حَدَّثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  حَدَّثَنِي  مَيْسَرَةُ بْنُ حَبِيبٍ ،  عَنْ  عَدِيِّ بْنِ ثَابِتٍ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنْ  حُذَيْفَةَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  هَذَا مَلَكٌ مِنَ الْمَلَائِكَةِ اسْتَأْذَنَ رَبَّهُ لِيُسَلِّمَ عَلَيَّ وَيَزُورَنِي  ، لَمْ يَهْبِطْ إِلَى الْأَرْضِ قَبْلَهَا ، فَبَشَّرَنِي أَنَّ  حَسَنًا  وَحُسَيْنًا  سَيِّدَا شَبَابِ أَهْلِ الْجَنَّةِ .","","Al-Mu'jam al-Kabir 2606","","حذيفة بن اليمان عن زر بن حبيش الثعلبي عن عدي بن ثابت الظفري عن ميسرة بن حبيب النهدي عن قيس بن الربيع الأسدي عن عاصم بن علي الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2605","2607  -  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ يَعْقُوبَ أَبُو الْأَصْبَغِ الْقَيْصَرَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  مَيْسَرَةَ بْنِ حَبِيبٍ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنْ  حُذَيْفَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2607","","حذيفة بن اليمان عن زر بن حبيش الثعلبي عن المنهال بن عمرو الأسدي عن ميسرة بن حبيب النهدي عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن يوسف الفريابي عن عبد العزيز بن يعقوب أبو الأصبغ القيصراني عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2606","2608  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  الْهَيْثَمُ بْنُ خَارِجَةَ ،  ثَنَا  أَبُو         [3/38]      الْأَسْوَدِ عَبْدُ اللهِ بْنُ عَامِرٍ الْهَاشِمِيُّ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  حُذَيْفَةَ رَضِيَ اللهُ عَنْهُ قَالَ :  رَأَيْنَا فِي وَجْهِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ السُّرُورَ يَوْمًا مِنَ الْأَيَّامِ ، فَقُلْنَا : يَا رَسُولَ اللهِ لَقَدْ رَأَيْنَا فِي وَجْهِكِ تَبَاشِيرَ السُّرُورِ . قَالَ :  وَكَيْفَ لَا أُسَرُّ وَقَدْ أَتَانِي  جِبْرِيلُ  عَلَيْهِ السَّلَامُ فَبَشَّرَنِي  أَنَّ  حَسَنًا  وَحُسَيْنًا  سَيِّدَا شَبَابِ أَهْلِ الْجَنَّةِ ، وَأَبُوهُمَا أَفْضَلُ مِنْهُمَا  .","","Al-Mu'jam al-Kabir 2608","","حذيفة بن اليمان عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن عبد الرحمن بن عامر الكوفي عن الهيثم بن خارجة الخراساني عن عبد الله بن أحمد بن حنبل عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2607","2609  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ الْأَنْمَاطِيُّ ،  ثَنَا  عُبَيْدُ بْنُ جَنَّادٍ الْحَلَبِيُّ ،  ثَنَا  عَطَاءُ بْنُ مُسْلِمٍ الْخَفَّافُ ،  حَدَّثَنِي  أَبُو عَمْرَةَ الْأَشْجَعِيُّ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  حُذَيْفَةَ بْنِ الْيَمَانِ رَضِيَ اللهُ عَنْهُ قَالَ :  بِتُّ عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَرَأَيْتُ عِنْدَهُ شَخْصًا ، فَقَالَ لِي : "" يَا  حُذَيْفَةُ  هَلْ رَأَيْتَ ؟ "" قُلْتُ : نَعَمْ يَا رَسُولَ اللهِ . قَالَ :  هَذَا مَلَكٌ لَمْ يَهْبِطْ إِلَيَّ مُنْذُ بُعِثْتُ ، أَتَانِي اللَّيْلَةَ فَبَشَّرَنِي  أَنَّ  الْحَسَنَ  وَالْحُسَيْنَ  سَيِّدَا شَبَابِ أَهْلِ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 2609","","حذيفة بن اليمان عن قيس بن أبي حازم عن سالم بن أبي الجعد الغطفاني عن أبو عمرة الأشجعي عن عطاء بن مسلم عن عبيد بن جناد الرقي عن محمد بن الحسين الأنماطي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2608","2610  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْحَكَمُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي نُعْمٍ الْبَجَلِيُّ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْحَسَنُ  وَالْحُسَيْنُ  سَيِّدَا شَبَابِ أَهْلِ الْجَنَّةِ  إِلَّا ابْنَيِ الْخَالَةِ  عِيسَى ابْنَ مَرْيَمَ  وَيَحْيَى بْنَ زَكَرِيَّا  .","","Al-Mu'jam al-Kabir 2610","","أبو سعيد الخدري عن عبد الرحمن بن أبي نعم البجلي عن الحكم بن عبد الرحمن بن أبي نعم البجلي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2609","2611  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  يَزِيدُ بْنُ مَرْدَانُبَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي نُعْمٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْحَسَنُ  وَالْحُسَيْنُ  سَيِّدَا شَبَابِ أَهْلِ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 2611","","أبو سعيد الخدري عن عبد الرحمن بن أبي نعم البجلي عن يزيد بن مردانبة الأصبهاني عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2610","2612  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَ :  وَجَدْتُ  فِي كِتَابِ  عُقْبَةَ بْنِ قَبِيصَةَ :  ثَنَا  أَبِي  ،  عَنْ  حَمْزَةَ الزَّيَّاتِ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي نُعْمٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         [3/39]      حَسَنٌ  وَحُسَيْنٌ  سَيِّدَا شَبَابِ أَهْلِ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 2612","","أبو سعيد الخدري عن عبد الرحمن بن أبي نعم البجلي عن يزيد بن أبي زياد القرشي عن حمزة الزيات عن قبيصة بن عقبة السوائي عن عقبة بن قبيصة بن عقبة العامري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2611","2613  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  حَدَّثَنَا  الْحَسَنُ بْنُ مُعَاوِيَةَ بْنِ هِشَامٍ ،  ثَنَا  عَلِيُّ بْنُ قَادِمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنِ  ابْنِ أَبِي نُعْمٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  حَسَنٌ  وَحُسَيْنٌ  سَيِّدَا شَبَابِ أَهْلِ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 2613","","أبو سعيد الخدري عن عبد الرحمن بن أبي نعم البجلي عن يزيد بن أبي زياد القرشي عن سفيان الثوري عن علي بن قادم الخزاعي عن الحسن بن معاوية بن هشام عن الساجي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2612","2614  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  حَرْبُ بْنُ الْحَسَنِ الطَّحَّانُ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِيُّ ،  عَنْ  صَفْوَانَ بْنِ سُلَيْمٍ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أَبِي سَعِيدٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْحَسَنُ  وَالْحُسَيْنُ  سَيِّدَا شَبَابِ أَهْلِ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 2614","","أبو سعيد الخدري عن عطاء بن يسار الهلالي عن صفوان بن سليم القرشي عن عبد العزيز بن محمد الدراوردي عن حرب بن الحسن الطحان عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2613","2615  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَطِيَّةَ ،  عَنْ  أَبِي سَعِيدٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْحَسَنُ  وَالْحُسَيْنُ  سَيِّدَا شَبَابِ أَهْلِ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 2615","","أبو سعيد الخدري عن عطية بن سعد العوفي عن الأعمش عن أبو معاوية الضرير عن سويد بن سعيد الحدثاني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2614","2616  -  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الطُّفَيْلِ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  جَابِرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  حَسَنٌ  وَحُسَيْنٌ  سَيِّدَا شَبَابِ أَهْلِ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 2616","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الرحمن بن سابط الجمحي عن جابر الجعفي عن شريك بن عبد الله النخعي عن محمد بن الطفيل بن مالك النخعي عن أحمد بن عمرو بن حفص القريعي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2615","2617  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادِ بْنِ أَنْعُمَ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  أَبِيهِ  ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْحَسَنُ  وَالْحُسَيْنُ  سَيِّدَا شَبَابِ أَهْلِ الْجَنَّةِ  ، وَأَبُوهُمَا خَيْرٌ مِنْهُمَا  .","","Al-Mu'jam al-Kabir 2617","","قرة بن إياس بن هلال المزني عن معاوية بن قرة عن عبد الرحمن بن زياد بن أنعم الإفريقي عن علي بن مسهر القرشي عن منجاب بن الحارث التميمي عن محمد بن عثمان بن أبي شيبة عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2616","2618  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ         [3/40]      الْأَرُزِّيُّ ،  ثَنَا  إِسْمَاعِيلُ ابْنُ عُلَيَّةَ ،  عَنْ  زِيَادٍ الْجَصَّاصِ ،  عَنْ  أَبِي عُثْمَانَ النَّهْدِيِّ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْحَسَنُ  وَالْحُسَيْنُ  سَيِّدَا شَبَابِ أَهْلِ الْجَنَّةِ  ، اللَّهُمَّ إِنِّي أُحِبُّهُمَا فَأَحِبَّهُمَا  .","","Al-Mu'jam al-Kabir 2618","","أسامة بن زيد بن حارثة ذو البطين عن أبو عثمان النهدي عن زياد بن أبي زياد الجصاص عن إسماعيل ابن علية عن محمد بن عبد الله الأرزي عن محمد بن الفضل بن جابر السقطى عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2617","2619  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَمُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ، قَالَا :  ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  أَسْبَاطُ بْنُ نَصْرٍ ،  عَنِ  السُّدِّيِّ ،  عَنْ  صُبَيْحٍ مَوْلَى أُمِّ سَلَمَةَ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  قَالَ  لِعَلِيٍّ  وَفَاطِمَةَ  وَحَسَنٍ  وَالْحُسَيْنِ  :  أَنَا سِلْمٌ لِمَنْ  سَالَمْتُمْ  ، وَحَرْبٌ لِمَنْ حَارَبْتُمْ  .","","Al-Mu'jam al-Kabir 2619","","زيد بن أرقم الأنصاري عن صبيح مولى أم سلمة عن السدي الكبير عن أسباط بن نصر الهمداني عن مالك بن إسماعيل النهدي عن محمد بن أحمد بن النضر النضري عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2618","2620  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  ثَنَا  حُسَيْنُ بْنُ مُحَمَّدٍ ،  ثَنَا  سُلَيْمَانُ بْنُ قَرْمٍ ،  عَنْ  أَبِي الْجَحَّافِ ،  عَنْ  إِبْرَاهِيمَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ صُبَيْحٍ مَوْلَى أُمِّ سَلَمَةَ رَضِيَ اللهُ عَنْهَا ،  عَنْ  جَدِّهِ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ ، قَالَ :  مَرَّ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى بَيْتٍ فِيهِ  فَاطِمَةُ  وَعَلِيٌّ  وَحَسَنٌ  وَحُسَيْنٌ  رَضِيَ اللهُ عَنْهُمْ ، فَقَالَ :  أَنَا حَرْبٌ لِمَنْ حَارَبْتُمْ ، وَسِلْمٌ لِمَنْ  سَالَمْتُمْ  .","","Al-Mu'jam al-Kabir 2620","","زيد بن أرقم الأنصاري عن صبيح مولى أم سلمة عن إبراهيم بن عبد الرحمن بن صبيح مولى أم سلمة عن داود بن أبي عوف البرجمي عن سليمان بن قرم الضبي عن الحسين بن محمد بن بهرام المروذي عن إبراهيم بن سعيد الجوهري عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2619","2621  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  تَلِيدُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِي الْجَحَّافِ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ قَالَ :  نَظَرَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  عَلِيٍّ  وَالْحَسَنِ  وَالْحُسَيْنِ  وَفَاطِمَةَ  رَضِيَ اللهُ عَنْهُمْ ، وَقَالَ :  أَنَا حَرْبٌ لِمَنْ حَارَبَكُمْ ، وَسِلْمٌ لِمَنْ سَالَمَكُمْ  .","","Al-Mu'jam al-Kabir 2621","","أبو هريرة الدوسي عن سلمان الأعرج مولى عزة الأشجعية عن داود بن أبي عوف البرجمي عن تليد بن سليمان المحاربي الأعرج عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2620","2622  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عِمْرَانَ ،  ثَنَا         [3/41]      أَبُو دَاوُدَ ،  ثَنَا  عَمْرُو بْنُ ثَابِتٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي فَاخِتَةَ ، قَالَ :  قَالَ  عَلِيٌّ رَضِيَ اللهُ عَنْهُ :  زَارَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَبَاتَ عِنْدَنَا  وَالْحَسَنُ  وَالْحُسَيْنُ  نَائِمَانِ ، فَاسْتَسْقَى  الْحَسَنُ  فَقَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى قِرْبَةٍ لَنَا فَجَعَلَ يَعْصِرُهَا فِي الْقَدَحِ ، ثُمَّ جَاءَ يَسْقِيهِ ، فَنَاوَلَ  الْحَسَنَ  ، فَتَنَاوَلَ  الْحُسَيْنُ  لِيَشْرَبَ فَمَنَعَهُ وَبَدَأَ  بِالْحَسَنِ  ، فَقَالَتْ  فَاطِمَةُ  : يَا رَسُولَ اللهِ كَأَنَّهُ أَحَبُّهُمَا إِلَيْكَ . قَالَ : "" إِنَّهُ اسْتَسْقَى أَوَّلَ مَرَّةٍ "" . ثُمَّ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنِّي وَهَذَيْنِ -  وَأَحْسَبُهُ قَالَ : وَهَذَا الرَّاقِدُ -  يَعْنِي  عَلِيًّا  -  يَوْمَ الْقِيَامَةِ فِي مَكَانٍ وَاحِدٍ  .","","Al-Mu'jam al-Kabir 2622","","علي بن أبي طالب عن سعيد بن علاقة الهاشمي عن ثابت بن هرمز الحداد عن عمرو  بن أبي المقدام عن أبو داود الطيالسي عن عبد الله بن عمران بن أبي علي عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2621","2623  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ ضُرَيْسٍ الْفَيْدِيُّ ،  حَدَّثَنَا  عِيسَى بْنُ عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عُمَرَ بْنِ عَلِيٍّ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  عَنْ  عَلِيٍّ  رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَنَا  وَفَاطِمَةُ  وَحَسَنٌ  وَحُسَيْنٌ  مُجْتَمِعُونَ وَمَنْ أَحَبَّنَا يَوْمَ الْقِيَامَةِ  ، نَأْكُلُ وَنَشْرَبُ حَتَّى يُفَرَّقَ بَيْنَ الْعِبَادِ "" . فَبَلَغَ ذَلِكَ  رَجُلًا  مِنَ النَّاسِ ، فَسَأَلَ عَنْهُ فَأَخْبَرْتُهُ ، فَقَالَ : كَيْفَ بِالْعَرْضِ وَالْحِسَابِ ؟ فَقُلْتُ لَهُ : "" كَيْفَ كَانَ لِصَاحِبِ يَاسِينَ بِذَلِكَ حِينَ أُدْخِلَ الْجَنَّةَ مِنْ سَاعَتِهِ ؟  .","","Al-Mu'jam al-Kabir 2623","","علي بن أبي طالب عن عمر بن علي بن أبي طالب الأكبر عن محمد بن عمر بن علي بن أبي طالب عن عبد الله بن محمد بن عمر بن علي بن أبي طالب عن عيسى بن عبد الله بن محمد العلوي عن محمد بن يحيى بن الضريس الفيدي عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2622","2624  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْمُرِّيُّ الْقَنْطَرِيُّ ،  ثَنَا  حَرْبُ بْنُ الْحَسَنِ الطَّحَّانُ ،  ثَنَا  يَحْيَى بْنُ يَعْلَى ،  عَنْ  مُحَمَّدِ بْنِ عُبَيْدِ اللهِ بْنِ أَبِي رَافِعٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  قَالَ  لِعَلِيٍّ  رَضِيَ اللهُ عَنْهُ :  إِنَّ "" أَوَّلَ أَرْبَعَةٍ يَدْخُلُونَ الْجَنَّةَ أَنَا وَأَنْتَ  وَالْحَسَنُ  وَالْحُسَيْنُ  ،  وَذَرَارِيُّنَا خَلْفَ ظُهُورِنَا ، وَأَزْوَاجُنَا خَلْفَ ذَرَارِيِّنَا ، وَشِيعَتُنَا عَنْ أَيْمَانِنَا وَعَنْ شَمَائِلِنَا  .","","Al-Mu'jam al-Kabir 2624","","أبو رافع القبطي عن عبيد الله بن أبي رافع مولى رسول الله عن محمد بن عبيد الله بن أبي رافع عن يحيى بن يعلى القطواني عن حرب بن الحسن الطحان عن أحمد بن محمد القنطري عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2623","2625  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، وَعَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ         [3/42]      حَنْبَلٍ ، وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالُوا :  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  عَنْ  عَمْرِو بْنِ غِيَاثٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ  فَاطِمَةَ  حَصَّنَتْ فَرْجَهَا  ، وَإِنَّ اللهَ عَزَّ وَجَلَّ أَدْخَلَهَا  بِإِحْصَانِ  فَرْجِهَا وَذُرِّيَّتَهَا الْجَنَّةَ  .","","Al-Mu'jam al-Kabir 2625","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن عمر بن غياث الحضرمي عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2624","2626  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَلِيٍّ الْجَارُودِيُّ النَّيْسَابُورِيُّ ،  ثَنَا  أَحْمَدُ بْنُ حَفْصٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  عَبَّادِ بْنِ إِسْحَاقَ ،  عَنْ  زَيْدِ بْنِ أَبِي الْعَتَّابِ ،  عَنْ  عُبَيْدِ بْنِ جُرَيْجٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى الْمِنْبَرِ يَخْطُبُ النَّاسَ ، فَخَرَجَ  الْحَسَنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ فِي عُنُقِهِ خِرْقَةٌ يَجُرُّهَا ، فَعَثَرَ فِيهَا فَسَقَطَ عَلَى وَجْهِهِ ، فَنَزَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الْمِنْبَرِ يُرِيدُهُ ، فَلَمَّا رَآهُ النَّاسُ أَخَذُوا الصَّبِيَّ فَأَتَوْهُ بِهِ ، فَحَمَلَهُ فَقَالَ :  قَاتَلَ اللهُ الشَّيْطَانَ ، إِنَّ الْوَلَدَ فِتْنَةٌ  ، وَاللهِ مَا عَلِمْتُ أَنِّي نَزَلْتُ عَنِ الْمِنْبَرِ حَتَّى أُوتِيتُ بِهِ  .","","Al-Mu'jam al-Kabir 2626","","عبد الله بن عمر بن الخطاب عن عبيد بن جريج التيمي عن زيد بن أبي عتاب الشامي عن عبد الرحمن بن إسحاق العامري عن إبراهيم بن طهمان عن حفص بن عبد الله بن راشد النيسابوري عن أحمد بن حفص بن عبد الله النيسابوري عن ابن الجارود عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2625","2627  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ صَالِحٍ الْأَسَدِيُّ ،  ثَنَا  نَافِعُ بْنُ هُرْمُزَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ رَضِيَ اللهُ عَنْهُ قَالَ :  بَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَاقِدٌ فِي بَعْضِ بُيُوتِهِ عَلَى قَفَاهُ ، إِذْ جَاءَ  الْحَسَنُ         [3/43]      يَدْرُجُ حَتَّى قَعَدَ عَلَى صَدْرِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ بَالَ عَلَى صَدْرِهِ ، فَجِئْتُ أُمِيطُهُ عَنْهُ ، فَاسْتَنْبَهَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  وَيْحَكَ يَا  أَنَسُ  دَعِ ابْنِي  وَثَمَرَةَ  فُؤَادِي ، فَإِنَّ مَنْ آذَى هَذَا فَقَدْ آذَانِي  ، وَمَنْ آذَانِي فَقَدْ آذَى اللهَ "" . ثُمَّ دَعَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِمَاءٍ فَصَبَّهُ عَلَى الْبَوْلِ صَبًّا ، فَقَالَ : "" يُصَبُّ عَلَى بَوْلِ الْغُلَامِ ، وَيُغْسَلُ بَوْلُ الْجَارِيَةِ  .","","Al-Mu'jam al-Kabir 2627","","أنس بن مالك عن نافع بن هرمز البصري عن إسحاق بن إبراهيم بن صالح الأسدي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2626","2628  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَمْزَةَ الدِّمَشْقِيُّ ،  ثَنَا  حَيْوَةُ بْنُ شُرَيْحٍ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  بَحِيرِ بْنِ سَعْدٍ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ، قَالَ :  وَفَدَ  الْمِقْدَامُ بْنُ مَعْدِي كَرِبَ  وَعَمْرُو بْنُ الْأَسْوَدِ  إِلَى  قِنَّسْرِينَ  ، فَقَالَ  مُعَاوِيَةُ  رَحِمَهُ اللهُ  لِلْمِقْدَامِ  : أَعَلِمْتَ أَنَّ  الْحَسَنَ بْنَ عَلِيٍّ  تُوُفِّيَ ؟  فَاسْتَرْجَعَ  الْمِقْدَامُ ، فَقَالَ لَهُ  مُعَاوِيَةُ  : أَتَرَاهَا مُصِيبَةً ؟ فَقَالَ : لِمَ لَا أَرَاهَا مُصِيبَةً وَقَدْ وَضَعَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي حِجْرِهِ ، فَقَالَ :  هَذَا مِنِّي ،  وَحُسَيْنٌ  مِنْ  عَلِيٍّ  .","","Al-Mu'jam al-Kabir 2628","","المقدام بن معدي كرب الكندي عن خالد بن معدان عن بحير بن سعد عن بقية بن الوليد عن حيوة المقرئ عن أحمد بن محمد بن يحيى البتلهي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2627","2629  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  ثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ الْقُرَظِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يُحْشَرُ الْأَنْبِيَاءُ يَوْمَ الْقِيَامَةِ عَلَى الدَّوَابِّ لِيُوَافُوا مِنْ يَوْمِهِمُ الْمَحْشَرَ  ، وَيُبْعَثُ  صَالِحٌ  عَلَى نَاقَتِهِ ، وَأُبْعَثُ أَنَا عَلَى الْبُرَاقِ ، وَيُبْعَثُ ابْنَايَ  الْحَسَنُ  وَالْحُسَيْنُ  عَلَى نَاقَتَيْنِ مِنْ نُوقِ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 2629","","أبو هريرة الدوسي عن محمد بن كعب بن سليم القرظي عن ابن جريج عن يحيى بن أيوب الغافقي عن عبد الله بن صالح المصري عن يحيى بن عثمان بن صالح عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2628","2630  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  عُبَادَةُ بْنُ زِيَادٍ         [3/44]      الْأَسَدِيُّ ،  ثَنَا  يَحْيَى بْنُ الْعَلَاءِ الرَّازِيُّ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ عَزَّ وَجَلَّ جَعَلَ  ذُرِّيَّةَ  كُلِّ نَبِيٍّ فِي صُلْبِهِ  ، وَإِنَّ اللهَ تَعَالَى جَعَلَ ذُرِّيَّتِي فِي صُلْبِ  عَلِيِّ بْنِ أَبِي طَالِبٍ  "" رَضِيَ اللهُ عَنْهُ  .","","Al-Mu'jam al-Kabir 2630","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن يحيى بن العلاء الفوراردي عن عباد بن زياد  بن موسى الساجي عن محمد بن عثمان بن أبي شيبة عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2629","2631  -  حَدَّثَنَا  مُحَمَّدُ بْنُ زَكَرِيَّا الْغَلَّابِيُّ ،  حَدَّثَنَا  بِشْرُ بْنُ مِهْرَانَ ،  ثَنَا  شَرِيكُ بْنُ عَبْدِ اللهِ ،  عَنْ  شَبِيبِ بْنِ غَرْقَدَةَ ،  عَنِ  الْمُسْتَظِلِّ بْنِ حُصَيْنٍ ،  عَنْ  عُمَرَ رَضِيَ اللهُ عَنْهُ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  كُلُّ بَنِي أُنْثَى فَإِنَّ عَصَبَتَهُمْ لِأَبِيهِمْ  ، مَا خَلَا وَلَدَ  فَاطِمَةَ  فَإِنِّي أَنَا عَصَبَتُهُمْ وَأَنَا أَبُوهُمْ  .","","Al-Mu'jam al-Kabir 2631","","عمر بن الخطاب عن مستظل بن حصين البارقي عن شبيب بن غرقدة البارقي عن شريك بن عبد الله النخعي عن بشر بن الحكم النيسابوري عن محمد بن زكريا بن دينار الإخباري عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2630","2632  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  شَيْبَةَ بْنِ نَعَامَةَ ،  عَنْ  فَاطِمَةَ بِنْتِ حُسَيْنٍ ،  عَنْ  فَاطِمَةَ الْكُبْرَى قَالَتْ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُّ بَنِي أُمٍّ يَنْتَمُونَ إِلَى عَصَبَةٍ إِلَّا وَلَدَ  فَاطِمَةَ  ، فَأَنَا وَلِيُّهُمْ وَأَنَا عَصَبَتُهُمْ  .","","Al-Mu'jam al-Kabir 2632","","فاطمة الزهراء عن فاطمة بنت الحسين بن علي بن أبي طالب عن شيبة بن نعامة الضبي عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2631","2633  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدِ بْنِ سُلَيْمَانَ النَّوْفَلِيُّ الْمَدِينِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ حَمْزَةَ الزُّبَيْرِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِيُّ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  أَبِيهِ  ، قَالَ :  دَعَا عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ  عَلِيَّ بْنَ أَبِي طَالِبٍ  فَسَارَّهُ ، ثُمَّ قَامَ  عَلِيٌّ  فَجَاءَ  الصُّفَّةَ  ، فَوَجَدَ  الْعَبَّاسَ  وَعَقِيلًا  وَالْحُسَيْنَ  ، فَشَاوَرَهُمْ فِي تَزْوِيجِ  أُمِّ كُلْثُومٍ  عُمَرَ  ، فَغَضِبَ  عَقِيلٌ  : وَقَالَ : يَا  عَلِيُّ  مَا تَزِيدُكَ الْأَيَّامُ وَالشُّهُورُ وَالسِّنُونَ إِلَّا الْعَمَى فِي أَمْرِكَ ، وَاللهِ لَئِنْ فَعَلْتَ لَيَكُونَنَّ وَلَيَكُونَنَّ لِأَشْيَاءَ عَدَّدَهَا . وَمَضَى يَجُرُّ ثَوْبَهُ ، فَقَالَ  عَلَيٌّ  لِلْعَبَّاسِ  : وَاللهِ مَا ذَاكَ مِنْهُ  نَصِيحَةٌ  ،         [3/45]      وَلَكِنَّ دِرَّةَ  عُمَرَ  أَخْرَجَتْهُ إِلَى مَا تَرَى ، أَمَا وَاللهِ مَا ذَاكَ رَغْبَةً فِيكَ يَا  عَقِيلُ  ، وَلَكِنْ قَدْ أَخْبَرَنِي  عُمَرُ بْنُ الْخَطَّابِ  رَضِيَ اللهُ عَنْهُ أَنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  كُلُّ  سَبَبٍ  وَنَسَبٍ مُنْقَطِعٌ يَوْمَ الْقِيَامَةِ إِلَّا سَبَبِي وَنَسَبِي  . فَضَحِكَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ ، وَقَالَ : "" وَيْحَ  عَقِيلٍ  ، سَفِيهٌ أَحْمَقُ  .","","Al-Mu'jam al-Kabir 2633","","عمر بن الخطاب عن أسلم العدوي مولى عمر بن الخطاب عن زيد بن أسلم عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن جعفر بن محمد بن سليمان النوفلي المديني عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2632","2634  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  عُبَادَةُ بْنُ زِيَادٍ الْأَسَدِيُّ ،  حَدَّثَنَا  يُونُسُ بْنُ أَبِي يَعْفُورٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ قَالَ :  سَمِعْتُ  عُمَرَ بْنَ الْخَطَّابِ  رَضِيَ اللهُ عَنْهُ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  كُلُّ  سَبَبٍ  وَنَسَبٍ يَوْمَ الْقِيَامَةِ مُنْقَطِعٌ إِلَّا سَبَبِي وَنَسَبِي  .","","Al-Mu'jam al-Kabir 2634","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن وقدان العبدي أبو يعفور عن يونس بن أبي يعفور العبدي عن عباد بن زياد  بن موسى الساجي عن عبد الله بن أحمد بن حنبل عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2633","2635  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  الْحَسَنُ بْنُ سَهْلٍ الْحَنَّاطُ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرٍ ، قَالَ :  سَمِعْتُ  عُمَرَ بْنَ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ يَقُولُ : "" سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَنْقَطِعُ يَوْمَ الْقِيَامَةِ كُلُّ  سَبَبٍ  وَنَسَبٍ إِلَّا سَبَبِي وَنَسَبِي  .","","Al-Mu'jam al-Kabir 2635","","عمر بن الخطاب عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن سفيان بن عيينة عن الحسن بن سهل الخياط عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2634","2636  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ ،  ثَنَا  عَليُّ بْنُ زَيْدِ بْنِ جُدْعَانَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي ذَرٍّ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَثَلُ  أَهْلِ بَيْتِي  مَثَلُ سَفِينَةِ  نُوحٍ  ، مَنْ رَكِبَ فِيهَا نَجَا  ، وَمَنْ تَخَلَّفَ عَنْهَا غَرِقَ ، وَمَنْ قَاتَلَنَا فِي آخِرِ الزَّمَانِ فَكَأَنَّمَا قَاتَلَ مَعَ  الدَّجَّالِ  .","","Al-Mu'jam al-Kabir 2636","","أبو ذر الغفاري عن سعيد بن المسيب عن علي بن زيد بن جدعان عن الحسن بن أبي جعفر الجفري عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2635","2637  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ أَحْمَدَ بْنِ مَنْصُورٍ سَجَّادَةُ ،  ثَنَا  عَبْدُ اللهِ بْنُ         [3/46]      دَاهِرٍ الرَّازِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْقُدُّوسِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  حَنَشِ بْنِ الْمُعْتَمِرِ ، قَالَ :  رَأَيْتُ أَبَا ذَرٍّ أَخَذَ بِعِضَادَتَيْ بَابِ  الْكَعْبَةِ  وَهُوَ يَقُولُ : مَنْ عَرَفَنِي فَقَدْ عَرَفَنِي ، وَمَنْ لَمْ يَعْرِفْنِي فَأَنَا  أَبُو ذَرٍّ الْغِفَارِيُّ  ، سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَثَلُ  أَهْلِ بَيْتِي  فِيكُمْ كَمَثَلِ سَفِينَةِ  نُوحٍ  ، فِي  قَوْمِ نُوحٍ  ، مَنْ رَكِبَهَا نَجَا ، وَمَنْ تَخَلَّفَ عَنْهَا هَلَكَ ، وَمَثَلِ بَابِ حِطَّةٍ فِي  بَنِي إِسْرَائِيلَ  .","","Al-Mu'jam al-Kabir 2637","","أبو ذر الغفاري عن حنش بن المعتمر الكناني عن أبو إسحاق السبيعي عن الأعمش عن عبد الله بن عبد القدوس الرازي عن الأحمري عبد الله بن داهر الأحمري عن سجادة الحسين بن أحمد بن منصور عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2636","2638  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  حَدَّثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ ،  عَنْ  أَبِي الصَّهْبَاءِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَثَلُ  أَهْلِ بَيْتِي  مَثَلُ سَفِينَةِ  نُوحٍ  ، مَنْ رَكِبَ فِيهَا نَجَا  ، وَمَنْ تَخَلَّفَ عَنْهَا غَرِقَ  .","","Al-Mu'jam al-Kabir 2638","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن أبو الصهباء الكوفي عن الحسن بن أبي جعفر الجفري عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2637","2639  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  هِشَامُ بْنُ يُوسُفَ ،  عَنْ  عَبْدِ اللهِ بْنِ سُلَيْمَانَ النَّوْفَلِيِّ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيِّ بْنِ عَبْدِ اللهِ بْنِ عَبَّاسٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَحِبُّوا اللهَ لِمَا يَغْدُوكُمْ مِنْ نِعَمِهِ  ، وَأَحِبُّونِي لِحُبِّ اللهِ ، وَأَحِبُّوا  أَهْلَ بَيْتِي  لِحُبِّي  .","","Al-Mu'jam al-Kabir 2639","","عبد الله بن عباس عن علي بن عبد الله بن عباس بن عبد المطلب عن محمد بن علي بن عبد الله بن عباس بن عبد المطلب عن عبد الله بن سليمان النوفلي عن هشام بن يوسف الأبناوي عن يحيى بن معين عن عبد الله بن أحمد بن حنبل عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2638","2640  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  جَنْدَلُ بْنُ وَالِقٍ ،  ثَنَا  مُحَمَّدُ بْنُ حَبِيبٍ الْعِجْلِيُّ ،  عَنْ  إِبْرَاهِيمَ بْنِ الْحَسَنِ ،  عَنْ  زِيَادِ بْنِ الْمُنْذِرِ ،  عَنْ         [3/47]      عَبْدِ الرَّحْمَنِ بْنِ مَسْعُودٍ الْعَبْدِيِّ ،  عَنْ  عُلَيْمٍ ،  عَنْ  سَلْمَانَ ، قَالَ :  أَنْزِلُوا  آلَ مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِمَنْزِلَةِ الرَّأْسِ مِنَ الْجَسَدِ  ، وَبِمَنْزِلَةِ الْعَيْنِ مِنَ الرَّأْسِ ، فَإِنَّ الْجَسَدَ لَا يَهْتَدِي إِلَّا بِالرَّأْسِ ، وَإِنَّ الرَّأْسَ لَا يَهْتَدِي إِلَّا بِالْعَيْنَيْنِ  "" .","","Al-Mu'jam al-Kabir 2640","","سلمان الفارسي عن عليم الكندي عن عبد الرحمن بن مسعود العبدي عن زياد بن المنذر الهمداني عن إبراهيم بن الحسن عن محمد بن حبيب العجلي عن جندل بن والق التغلبي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2639","2641  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ ،  ثَنَا  حَرْبُ بْنُ الْحَسَنِ الطَّحَّانُّ ،  ثَنَا  حُسَيْنٌ الْأَشْقَرُ ،  عَنْ  قَيْسِ بْنِ الرَّبِيعِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ :  لَمَّا نَزَلَتْ :         {      قُلْ لا أَسْأَلُكُمْ عَلَيْهِ أَجْرًا إِلا الْمَوَدَّةَ فِي الْقُرْبَى         }      قَالُوا : يَا رَسُولَ اللهِ ، وَمَنْ قَرَابَتُكَ هَؤُلَاءِ الَّذِينَ وَجَبَتْ عَلَيْنَا مَوَدَّتُهُمْ ؟ قَالَ :  عَلِيٌّ  وَفَاطِمَةُ  وَابْنَاهُمَا  .","","Al-Mu'jam al-Kabir 2641","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن الأعمش عن قيس بن الربيع الأسدي عن الحسين بن الحسن الأشقر عن حرب بن الحسن الطحان عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2640","2642  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  هَوْذَةُ بْنُ خَلِيفَةَ ،  حَدَّثَنَا  سُلَيْمَانُ التَّيْمِيُّ ،  عَنْ  أَبِي عُثْمَانَ النَّهْدِيِّ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَأْخُذُنِي  وَالْحُسَيْنَ  ، فَيَقْعُدُ أَحَدُنَا عَلَى فَخِذِهِ الْيُمْنَى وَالْآخَرُ عَلَى فَخِذِهِ الْيُسْرَى ، وَيَقُولُ :  اللَّهُمَّ إِنِّي أُحِبُّهُمَا فَأَحِبَّهُمَا  .","","Al-Mu'jam al-Kabir 2642","","أسامة بن زيد بن حارثة ذو البطين عن أبو عثمان النهدي عن سليمان بن طرخان عن هوذة بن خليفة البكراوي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2641","2643  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ حَفْصِ بْنِ رَاشِدٍ الْهِلَالِيُّ ،  ثَنَا  الْحُسَيْنُ بْنُ عَلِيٍّ ،  ثَنَا  وَرْقَاءُ بْنُ عُمَرَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْحَارِثِ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِلْحُسَيْنِ بْنِ عَلِيٍّ  :  مَنْ أَحَبَّ هَذَا فَقَدْ أَحَبَّنِي  .","","Al-Mu'jam al-Kabir 2643","","علي بن أبي طالب عن الحارث الأعور عن أبو إسحاق السبيعي عن ورقاء بن عمر عن الحسين بن علي عن محمد بن حفص بن راشد الهلالي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2642","2644  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ الْأَزْدِيُّ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي  وَالْحَسَنُ  وَالْحُسَيْنُ  عَلَى ظَهْرِهِ ، فَبَاعَدَهُمَا النَّاسُ ، وَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  دَعُوهُمَا بِأَبِي هُمَا وَأُمِّي مَنْ أَحَبَّنِي فَلْيُحِبَّ هَذَيْنِ  "" .","","Al-Mu'jam al-Kabir 2644","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن أبو بكر بن عياش عن عبد الرحمن بن صالح العتكي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2643","2645  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلْطِيُّ ،  حَدَّثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سَلْمٌ         [3/48]      الْحَذَّاءُ ،  عَنِ  الْحَسَنِ بْنِ سَالِمِ بْنِ أَبِي الْجَعْدِ ، قَالَ :  سَمِعْتُ  أَبَا حَازِمٍ  يُحَدِّثُ عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ أَحَبَّ  الْحَسَنَ  وَالْحُسَيْنَ  فَقَدْ أَحَبَّنِي  ، وَمَنْ أَبْغَضَهُمَا فَقَدْ أَبْغَضَنِي  .","","Al-Mu'jam al-Kabir 2645","","أبو هريرة الدوسي عن سلمان الأعرج مولى عزة الأشجعية عن الحسن بن سالم عن سلم الحذاء عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2644","2646  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  الثَّوْرِيُّ ،  عَنْ  سَالِمِ بْنِ أَبِي حَفْصَةَ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ أَحَبَّهُمَا فَقَدْ أَحَبَّنِي ، وَمَنْ أَبْغَضَهُمَا فَقَدْ أَبْغَضَنِي  .  يَعْنِي  الْحَسَنَ  وَالْحُسَيْنَ  .","","Al-Mu'jam al-Kabir 2646","","أبو هريرة الدوسي عن سلمان الأعرج مولى عزة الأشجعية عن سالم بن أبي حفصة العجلي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2645","2647  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  أَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي الْجَحَّافِ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَحَبَّهُمَا فَقَدْ أَحَبَّنِي ، وَمَنْ أَبْغَضَهُمَا فَقَدْ أَبْغَضَنِي  .  يَعْنِي  الْحَسَنَ  وَالْحُسَيْنَ  .","","Al-Mu'jam al-Kabir 2647","","أبو هريرة الدوسي عن سلمان الأعرج مولى عزة الأشجعية عن داود بن أبي عوف البرجمي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2646","2648  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ، وَأَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ ، قَالَا :  ثَنَا  إِسْرَائِيلُ ، قَالَ :  سَمِعْتُ  سَالِمَ بْنَ أَبِي حَفْصَةَ يَقُولُ :  سَمِعْتُ  أَبَا حَازِمٍ يَقُولُ :  سَمِعْتُ  أَبَا هُرَيْرَةَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ أَحَبَّ  الْحَسَنَ  وَالْحُسَيْنَ  فَقَدْ أَحَبَّنِي  ، وَمَنْ أَبْغَضَهُمَا فَقَدْ أَبْغَضَنِي  .","","Al-Mu'jam al-Kabir 2648","","أبو هريرة الدوسي عن سلمان الأعرج مولى عزة الأشجعية عن سالم بن أبي حفصة العجلي عن إسرائيل بن يونس بن أبي إسحاق عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2647","2649  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  جُمْهُورُ بْنُ مَنْصُورٍ ،  ثَنَا  سَيْفُ بْنُ مُحَمَّدٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ قَالَ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ فِي  الْحَسَنِ  وَالْحُسَيْنِ  :  مَنْ أَحَبَّهُمَا فَبِحُبِّي ، وَمَنْ أَبْغَضَهُمَا فَبِبُغْضِي  .","","Al-Mu'jam al-Kabir 2649","","أبو هريرة الدوسي عن سلمان الأعرج مولى عزة الأشجعية عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن سيف بن محمد الثوري عن جمهور بن منصور عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2648","2650  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ، وَمُحَمَّدُ بْنُ عُمَرَ الْهَيَّاجِيُّ ، (  ح  ) .         [3/49]      وَحَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ، قَالَا :  ثَنَا  يَحْيَى بْنُ عَبْدِ الرَّحْمَنِ الْأَرْحَبِيُّ ،  ثَنَا  عُبَيْدَةُ بْنُ الْأَسْوَدِ ،  عَنِ  الْقَاسِمِ بْنِ الْوَلِيدِ الطَّائِيِّ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ أَحَبَّنِي فَقَدْ أَحَبَّهُمَا  .  يَعْنِي  الْحَسَنَ  وَالْحُسَيْنَ  .","","Al-Mu'jam al-Kabir 2650","","أبو هريرة الدوسي عن سلمان الأعرج مولى عزة الأشجعية عن طلحة بن مصرف الهمداني عن القاسم بن الوليد الخبذعي عن عبيدة بن الأسود بن سعيد الهمداني عن يحيى بن عبد الرحمن بن مالك الأرحبي عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2649","2651  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ مَيْمُونٍ ،  ثَنَا  عَلِيُّ بْنُ عَابِسٍ ،  عَنْ  سَالِمِ بْنِ أَبِي حَفْصَةَ وَكَثِيرٍ النَّوَّاءِ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  مَرَّ  الْحَسَنُ  وَالْحُسَيْنُ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  اللَّهُمَّ إِنِّي أُحِبُّهُمَا فَأَحِبَّهُمَا وَأَبْغِضْ مَنْ أَبْغَضَهُمَا  .","","Al-Mu'jam al-Kabir 2651","","أبو هريرة الدوسي عن سلمان الأعرج مولى عزة الأشجعية عن كثير بن إسماعيل النواء عن علي بن عابس الملائي عن إبراهيم بن محمد بن ميمون الكندي عن محمد بن عثمان بن أبي شيبة عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2650","2652  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ الْأَصْبَهَانِيُّ ،  حَدَّثَنَا  أَحْمَدُ بْنُ الْوَلِيدِ بْنِ بُرْدٍ الْأَنْطَاكِيُّ ،  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  ثَنَا  الْمُتَوَكِّلُ بْنُ مُوسَى ،  عَنْ  مُحَمَّدِ بْنِ مُسْرِعٍ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  وَقَفَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى بَيْتِ  فَاطِمَةَ  فَسَلَّمَ ، فَخَرَجَ إِلَيْهِ  الْحَسَنُ  أَوِ  الْحُسَيْنُ  ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ارْقَ بِأَبِيكَ ، أَنْتَ عَيْنُ بَقَّةٍ  وَأَخَذَ بِأُصْبُعَيْهِ ، فَرَقَى عَلَى عَاتِقِهِ ، ثُمَّ خَرَجَ الْآخَرُ  الْحَسَنُ  أَوِ  الْحُسَيْنُ  مُرْتَفِعَةً إِحْدَى عَيْنَيْهِ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَرْحَبًا بِكَ ، ارْقَ بِأَبِيكَ ، أَنْتَ عَيْنُ الْبَقَّةِ "" وَأَخَذَ بِأُصْبُعَيْهِ فَاسْتَوَى عَلَى عَاتِقِهِ الْآخَرِ ، وَأَخَذَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِأَقْفِيَتِهِمَا حَتَّى وَضَعَ أَفْوَاهَهُمَا عَلَى فِيهِ ، ثُمَّ قَالَ :  اللَّهُمَّ إِنِّي أُحِبُّهُمَا فَأَحِبَّهُمَا وَأَحِبَّ مَنْ يُحِبُّهُمَا  .","","Al-Mu'jam al-Kabir 2652","","أبو هريرة الدوسي عن أبو سعيد المقبري عن سعيد المقبري عن محمد بن مسرع عن المتوكل بن موسى عن محمد بن إسماعيل بن مسلم الديلي عن أحمد بن محمد بن الوليد الأنطاكي عن إبراهيم بن محمد الطيان عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2651","2653  -  حَدَّثَنَا  عَبْدَانُ بْنُ مُحَمَّدٍ الْمَرْوَزِيُّ ،  ثَنَا  قُتَيْبَةُ بْنُ سَعِيدٍ ،  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي مُزَرِّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  سَمِعَتْ أُذُنَايَ هَاتَانِ وَأَبْصَرَتْ عَيْنَايَ هَاتَانِ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ آخِذٌ بِكَفَّيْهِ جَمِيعًا         [3/50]      حَسَنًا  أَوْ  حُسَيْنًا  وَقَدَمَاهُ عَلَى قَدَمَيْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَقُولُ :  حُزُقَّةُ  حُزُقَّةُ  ارْقَ عَيْنَ بَقَّةٍ  فَيَرْقَى الْغُلَامُ حَتَّى يَضَعَ قَدَمَيْهِ عَلَى صَدْرِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ قَالَ لَهُ : "" افْتَحْ "" . قَالَ : ثُمَّ قَبَّلَهُ ، ثُمَّ قَالَ : "" اللَّهُمَّ أَحِبَّهُ فَإِنِّي أُحِبُّهُ  .","","Al-Mu'jam al-Kabir 2653","","أبو هريرة الدوسي عن عبد الرحمن بن يسار أبو مزرد عن معاوية بن أبي مزرد الهاشمي عن حاتم بن إسماعيل الحارثي عن قتيبة بن سعيد عن عبدان بن محمد الجنوجردى عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2652","2654  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  نَصْرُ بْنُ عَلِيٍّ ،  ثَنَا  عَلِيُّ بْنُ جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَخِيهِ مُوسَى بْنِ جَعْفَرٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  عَنْ  عَلِيِّ بْنِ الْحُسَيْنِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَلِيٍّ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَخَذَ بِيَدِ  الْحَسَنِ  وَالْحُسَيْنِ  ، فَقَالَ :  مَنْ أَحَبَّ هَذَيْنِ وَأَبَاهُمَا وَأُمَّهُمَا كَانَ مَعِي فِي دَرَجَتِي يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 2654","","علي بن أبي طالب عن الحسين بن علي عن علي بن الحسين زين العابدين عن أبو جعفر الباقر عن جعفر الصادق عن الكاظم ، موسى بن جعفر بن محمد الصادق عن علي بن جعفر بن محمد بن علي بن الحسين بن علي بن أبي طالب عن نصر بن علي بن نصر الجهضمي عن الساجي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2653","2655  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  مُحَمَّدِ بْنِ رُسْتُمَ ،  عَنْ  زَاذَانَ ،  عَنْ  سَلْمَانَ ، قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِلْحَسَنِ  وَالْحُسَيْنِ  :  مَنْ أَحَبَّهُمَا أَحْبَبْتُهُ ، وَمَنْ أَحْبَبْتُهُ أَحَبَّهُ اللهُ  ، وَمَنْ أَحَبَّهُ اللهُ أَدْخَلَهُ جَنَّاتِ النَّعِيمِ ، وَمَنْ أَبْغَضَهُمَا أَوْ بَغَى عَلَيْهِمَا أَبْغَضْتُهُ ، وَمَنْ أَبْغَضْتُهُ أَبْغَضَهُ اللهُ ، وَمَنْ أَبْغَضَهُ اللهُ أَدْخَلَهُ عَذَابَ  جَهَنَّمَ  وَلَهُ عَذَابٌ مُقِيمٌ  .","","Al-Mu'jam al-Kabir 2655","","سلمان الفارسي عن زاذان الكندي عن محمد بن رستم الضبي عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن محمد بن عثمان بن أبي شيبة عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2654","2656  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يُوسُفُ بْنُ سَلْمَانَ الْمَازِنِيُّ ،  حَدَّثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  سَعْدُ بْنُ إِسْحَاقَ بْنِ كَعْبِ بْنِ عُجْرَةَ ،  عَنْ  إِسْحَاقَ بْنِ أَبِي حَبِيبَةَ مَوْلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  عَنْ  أَبِي هُرَيْرَةَ  أَنَّ  مَرْوَانَ بْنَ الْحَكَمِ  أَتَى  أَبَا هُرَيْرَةَ  فِي مَرَضِهِ الَّذِي مَاتَ فِيهِ ، فَقَالَ  مَرْوَانُ  لِأَبِي هُرَيْرَةَ  : مَا وَجَدْتُ عَلَيْكَ فِي شَيْءٍ مُنْذُ اصْطَحَبْنَا إِلَّا فِي حُبِّكَ  الْحَسَنَ  وَالْحُسَيْنَ  . قَالَ : فَتَحَفَّزَ  أَبُو هُرَيْرَةَ  فَجَلَسَ ، فَقَالَ : أَشْهَدُ لَخَرَجْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، حَتَّى إِذَا كُنَّا بِبَعْضِ الطَّرِيقِ سَمِعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَوْتَ  الْحَسَنِ         [3/51]      وَالْحُسَيْنِ  وَهُمَا يَبْكِيَانِ وَهُمَا مَعَ أُمِّهِمَا ، فَأَسْرَعَ السَّيْرَ حَتَّى أَتَاهُمَا ، فَسَمِعْتُهُ يَقُولُ لَهَا : "" مَا  شَأْنُ  ابْنَيَّ ؟ "" فَقَالَتِ : الْعَطَشُ . قَالَ : فَأَخْلَفَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى شَنَّةٍ يَبْتَغِي فِيهَا مَاءً ، وَكَانَ الْمَاءُ يَوْمَئِذٍ أَغْدَارًا ، وَالنَّاسُ يُرِيدُونَ الْمَاءَ ، فَنَادَى :  هَلْ أَحَدٌ مِنْكُمْ مَعَهُ مَاءٌ ؟  فَلَمْ يَبْقَ أَحَدٌ إِلَّا أَخْلَفَ بِيَدِهِ إِلَى  كُلَّابِهِ  يَبْتَغِي الْمَاءَ فِي شَنَّةٍ ، فَلَمْ يَجِدْ أَحَدٌ مِنْهُمْ قَطْرَةً ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" نَاوِلِينِي أَحَدَهُمَا "" فَنَاوَلَتْهُ إِيَّاهُ مِنْ تَحْتِ الْخِدْرِ ، فَرَأَيْتُ بَيَاضَ ذِرَاعَيْهَا حِينَ نَاوَلَتْهُ ، فَأَخَذَهُ فَضَمَّهُ إِلَى صَدْرِهِ وَهُوَ يَطْغُو مَا يَسْكُتُ ،  فَأَدْلَعَ  لَهُ لِسَانَهُ فَجَعَلَ يَمُصُّهُ حَتَّى  هَدَأَ أَوْ سَكَنَ  ، فَلَمْ أَسْمَعْ لَهُ بُكَاءً ، وَالْآخَرُ يَبْكِي كَمَا هُوَ مَا يَسْكُتُ ، فَقَالَ : "" نَاوِلِينِي الْآخَرَ "" ، فَنَاوَلَتْهُ إِيَّاهُ فَفَعَلَ بِهِ كَذَلِكَ ، فَسَكَتَا فَمَا أَسْمَعُ لَهُمَا صَوْتًا ، ثُمَّ قَالَ : "" سِيرُوا "" ، فَصَدَعْنَا يَمِينًا وَشِمَالًا عَنِ الظَّعَائِنِ حَتَّى لَقِينَاهُ عَلَى  قَارِعَةِ  الطَّرِيقِ ، فَأَنَا لَا أُحِبُّ هَذَيْنِ وَقَدْ رَأَيْتُ هَذَا مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟  .","","Al-Mu'jam al-Kabir 2656","","أبو هريرة الدوسي عن إسحاق بن أبي حبيبة المدني عن سعد بن إسحاق بن كعب بن عجرة عن حاتم بن إسماعيل الحارثي عن يوسف بن سلمان الباهلي عن الحسين بن إسحاق التستري عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2655","2657  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  الْحَسَنُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  ثَنَا  عَلِيُّ بْنُ هَاشِمٍ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  عَطِيَّةَ ،  عَنْ  أَبِي سَعِيدٍ ، قَالَ :  جَاءَ  الْحُسَيْنُ  وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي ، فَالْتَزَمَ عُنُقَ النَّبِيِّ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَامَ بِهِ وَأَخَذَ بِيَدِهِ ، فَلَمْ يَزَلْ مُمْسِكَهَا حَتَّى رَكَعَ  .","","Al-Mu'jam al-Kabir 2657","","أبو سعيد الخدري عن عطية بن سعد العوفي عن محمد بن عبد الرحمن بن أبي ليلى عن علي بن هاشم العائذي عن الحسن بن عبد الرحمن بن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2656","2658  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْفَسَوِيُّ ،  ثَنَا  خَالِدُ بْنُ يَزِيدَ الْعُرَنِيُّ ،  ثَنَا  جَرِيرٌ ،  عَنْ  قَابُوسَ بْنِ أَبِي ظِبْيَانَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَرَّجَ مَا بَيْنَ فَخِذَيِ  الْحُسَيْنِ  وَقَبَّلَ زَبِيبَتَهُ  .","","Al-Mu'jam al-Kabir 2658","","عبد الله بن عباس عن حصين بن جندب الجنبي عن قابوس بن أبي ظبيان عن جرير بن عبد الحميد عن خالد بن يزيد العرني عن الحسن بن علي بن الوليد الفسوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2657","2659  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ ،         [3/52]      حَدَّثَنَا  كَامِلٌ أَبُو الْعَلَاءِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  بَيْنَمَا نَحْنُ نُصَلِّي مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْعِشَاءَ ، فَكَانَ إِذَا سَجَدَ وَثَبَ  الْحَسَنُ  وَالْحُسَيْنُ  رَضِيَ اللهُ عَنْهُمَا عَلَى ظَهْرِهِ ، فَإِذَا أَرَادَ أَنْ يَرْكَعَ أَخَذَهُمَا بِيَدِهِ أَخْذًا رَقِيقًا حَتَّى يَضَعَهُمَا عَلَى الْأَرْضِ ، فَإِذَا عَادَ عَادَا ، حَتَّى قَضَى صَلَاتَهُ وَانْصَرَفَ وَوَضَعَهُمَا عَلَى فَخِذَيْهِ . قَالَ  أَبُو هُرَيْرَةَ  : فَقُمْتُ إِلَيْهِ ، فَقُلْتَ : يَا رَسُولَ اللهِ أَذْهَبُ بِهِمَا ؟ قَالَ : "" لَا "" . فَبَرَقَتْ بَرْقَةٌ ، فَقَالَ :  الْحَقَا بِأُمِّكُمَا  . فَلَمْ يَزَالَا فِي ضَوْئِهَا حَتَّى دَخَلَا  .","","Al-Mu'jam al-Kabir 2659","","أبو هريرة الدوسي عن ذكوان السمان عن كامل بن العلاء التميمي عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2658","2660  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نَصْرِ بْنِ حُمَيْدٍ الْبَغْدَادِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ الْأَزْدِيُّ ،  ثَنَا  مُوسَى بْنُ عُثْمَانَ الْحَضْرَمِيُّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ قَالَ :  كَانَ  الْحُسَيْنُ  رَضِيَ اللهُ عَنْهُ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَكَانَ يُحِبُّهُ حُبًّا شَدِيدًا  ، فَقَالَ : أَذْهَبُ إِلَى أُمِّي . فَقُلْتُ : أَذْهَبُ مَعَهُ . فَجَاءَتْ بَرْقَةٌ مِنَ السَّمَاءِ فَمَشَى فِي ضَوْئِهَا حَتَّى بَلَغَ  .","","Al-Mu'jam al-Kabir 2660","","أبو هريرة الدوسي عن ذكوان السمان عن الأعمش عن موسى بن عثمان الحضرمي عن عبد الرحمن بن صالح العتكي عن محمد بن نصر ابن الوازع البغدادي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2659","2661  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ وَجَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ، قَالَا :  ثَنَا  يَزِيدُ بْنُ مَوْهَبٍ الرَّمْلِيُّ ،  حَدَّثَنَا  مَسْرُوحٌ أَبُو شِهَابٍ ،  عَنْ  سُفْيَانَ الثَّوْرِيِّ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ قَالَ :  دَخَلْتُ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَمْشِي عَلَى أَرْبَعَةٍ وَعَلَى ظَهْرِهِ  الْحَسَنُ  وَالْحُسَيْنُ  رَضِيَ اللهُ عَنْهُمَا وَهُوَ يَقُولُ :  نِعْمَ الْجَمَلُ جَمَلُكُمَا ، وَنِعْمَ الْعِدْلَانِ أَنْتُمَا  .","","Al-Mu'jam al-Kabir 2661","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان الثوري عن مسروح بن عبد الرحمن الكوفي عن يزيد بن خالد بن يزيد بن موهب عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2660","2662  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  فُضَيْلُ بْنُ مَرْزُوقٍ ،  ثَنَا  عَطِيَّةُ الْعَوْفِيُّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  نَزَلَتْ هَذِهِ الْآيَةُ فِي بَيْتِي :         {      إِنَّمَا يُرِيدُ اللهُ لِيُذْهِبَ عَنْكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا         }      ، وَهِيَ جَالِسَةٌ عَلَى الْبَابِ ، فَقُلْتُ :  يَا رَسُولَ اللهِ أَلَسْتُ مِنْ أَهْلِ         [3/53]      الْبَيْتِ ؟ قَالَ : "" أَنْتِ إِلَى خَيْرٍ  .","","Al-Mu'jam al-Kabir 2662","","هند بنت أبي أمية زوج رسول الله عن أبو سعيد الخدري عن عطية بن سعد العوفي عن فضيل بن مرزوق الأغر عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2661","2663  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ ،  ثَنَا  جَعْفَرُ بْنُ مُسَافِرٍ التِّنِّيسِيُّ ،  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  ثَنَا  مُوسَى بْنُ يَعْقُوبَ الزَّمْعِيُّ ،  عَنْ  هَاشِمِ بْنِ هَاشِمٍ ،  عَنْ  وَهْبِ بْنِ عَبْدِ اللهِ بْنِ زَمْعَةَ ،  عَنْ  أُمِّ سَلَمَةَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  جَمَعَ  فَاطِمَةَ  وَحَسَنًا  وَحُسَيْنًا  رَضِيَ اللهُ عَنْهُمْ ثُمَّ أَدْخَلَهُمْ تَحْتَ ثَوْبِهِ ، ثُمَّ قَالَ :  اللَّهُمَّ هَؤُلَاءِ  أَهْلُ بَيْتِي  . قَالَتْ  أُمُّ سَلَمَةَ  : قُلْتُ : يَا رَسُولَ اللهِ أَدْخِلْنِي مَعَهُمْ . قَالَ : "" إِنَّكِ مِنْ أَهْلِي  .","","Al-Mu'jam al-Kabir 2663","","هند بنت أبي أمية زوج رسول الله عن وهب بن عبد بن زمعة الأسدي عن هاشم بن هاشم بن عتبة الوقاصي عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن محمد بن إسماعيل بن مسلم الديلي عن جعفر بن مسافر التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2662","2664  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدِ بْنِ جُدْعَانَ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِفَاطِمَةَ  : "" ائْتِينِي بِزَوْجِكِ وَابْنَيْهِ "" . فَجَاءَتْ بِهِمْ ، فَأَلْقَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كِسَاءً فَدَكِيًّا ، ثُمَّ وَضَعَ يَدَهُ عَلَيْهِمْ ، ثُمَّ قَالَ :  اللَّهُمَّ إِنَّ هَؤُلَاءِ  آلُ مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَاجْعَلْ صَلَوَاتِكَ وَبَرَكَاتِكَ عَلَى  آلِ مُحَمَّدٍ  فَإِنَّكَ حَمِيدٌ مَجِيدٌ "" . قَالَتْ  أُمُّ سَلَمَةَ  : فَرَفَعْتُ الْكِسَاءَ لِأَدْخُلَ مَعَهُمْ ، فَجَذَبَهُ مِنْ يَدِي ، وَقَالَ : "" إِنَّكِ عَلَى خَيْرٍ  .","","Al-Mu'jam al-Kabir 2664","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن علي بن زيد بن جدعان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2663","2665  -  حَدَّثَنَا  عَبْدُ الْوَارِثِ بْنُ إِبْرَاهِيمَ أَبُو عُبَيْدَةَ الْعَسْكَرِيُّ ،  ثَنَا  حَوْثَرَةُ بْنُ أَشْرَسَ الْمِنْقَرِيُّ ،  ثَنَا  عُقْبَةُ بْنُ عَبْدِ اللهِ الرِّفَاعِيُّ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِفَاطِمَةَ  : "" ائْتِينِي بِزَوْجِكِ وَابْنَيْكِ "" . فَجَاءَتْ بِهِمْ ، فَأَلْقَى عَلَيْهِمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كِسَاءً ، ثُمَّ قَالَ :  اللَّهُمَّ هَؤُلَاءِ  آلُ مُحَمَّدٍ  فَاجْعَلْ صَلَوَاتِكَ وَبَرَكَاتِكَ عَلَى  آلِ مُحَمَّدٍ  كَمَا جَعَلْتَهَا عَلَى  إِبْرَاهِيمَ  إِنَّكَ حَمِيدٌ مَجِيدٌ  .","","Al-Mu'jam al-Kabir 2665","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن عقبة بن عبد الله الأصم عن حوثرة بن أشرس بن عومر العدوي عن عبد الوارث بن إبراهيم العسكري عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2664","2666  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ         [3/54]      بْنُ الْمِنْهَالِ ، (  ح  ) .  وَحَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ الْجُمَحِيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، قَالَا :  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ بَهْرَامَ الْفَزَارِيُّ ،  ثَنَا  شَهْرُ بْنُ حَوْشَبٍ ، قَالَ :  سَمِعْتُ  أُمَّ سَلَمَةَ تَقُولُ :  جَاءَتْ  فَاطِمَةُ  عُدَّيَةً بِثَرِيدٍ لَهَا تَحْمِلُهَا فِي طَبَقٍ لَهَا حَتَّى وَضَعَتْهَا بَيْنَ يَدَيْهِ ، فَقَالَ لَهَا : "" وَأَيْنَ ابْنُ عَمِّكِ ؟ "" قَالَتْ : هُوَ فِي الْبَيْتِ . قَالَ : "" اذْهَبِي فَادْعِيهِ وَائْتِينِي بِابْنَيَّ "" . فَجَاءَتْ تَقُودُ ابْنَيْهَا كُلُّ وَاحِدٍ مِنْهُمَا فِي يَدٍ ،  وَعَلِيٌّ  يَمْشِي فِي أَثَرِهِمَا ، حَتَّى دَخَلُوا عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَجْلَسَهُمَا فِي حِجْرِهِ ، وَجَلَسَ  عَلِيٌّ  عَنْ يَمِينِهِ ، وَجَلَسَتْ  فَاطِمَةُ  رَضِيَ اللهُ عَنْهَا فِي يَسَارِهِ . قَالَتْ  أُمُّ سَلَمَةَ  : فَأَخَذَتْ مِنْ تَحْتِي كِسَاءً كَانَ بِسَاطَنَا عَلَى  الْمَنَامَةِ  فِي الْبَيْتِ  بِبُرْمَةٍ  فِيهَا خَزِيرَةٌ ، فَقَالَ لَهَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" ادْعِي لِي  بَعْلَكِ  وَابْنَيْكِ  الْحَسَنَ  وَالْحُسَيْنَ  "" . فَدَعَتْهُمْ فَجَلَسُوا جَمِيعًا يَأْكُلُونَ مِنْ تِلْكَ  الْبُرْمَةِ  . قَالَتْ : وَأَنَا أُصَلِّي فِي تِلْكَ الْحُجْرَةِ ، فَنَزَلَتْ هَذِهِ الْآيَةُ :         {      إِنَّمَا يُرِيدُ اللهُ لِيُذْهِبَ عَنْكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا         }      ، فَأَخَذَ فَضْلَ الْكِسَاءِ فَغَشَّاهُمْ ، ثُمَّ أَخْرَجَ يَدَهُ الْيُمْنَى مِنَ الْكِسَاءِ  وَأَلْوَى  بِهَا إِلَى السَّمَاءِ ، ثُمَّ قَالَ :  اللَّهُمَّ هَؤُلَاءِ  أَهْلُ بَيْتِي  وَحَامَّتِي  فَأَذْهِبْ عَنْهُمُ الرِّجْسَ وَطَهِّرْهُمْ تَطْهِيرًا  . قَالَتْ  أُمُّ سَلَمَةَ  : فَأَدْخَلْتُ رَأْسِيَ الْبَيْتَ ، فَقُلْتُ : يَا رَسُولَ اللهِ ، وَأَنَا مَعَكُمْ ؟ قَالَ : "" أَنْتِ عَلَى خَيْرٍ "" مَرَّتَيْنِ  .","","Al-Mu'jam al-Kabir 2666","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن عبد الحميد بن بهرام الفزاري عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2665","2667  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ،  حَدَّثَنَا  هَوْذَةُ بْنُ خَلِيفَةَ ،  ثَنَا  عَوْفٌ ،  عَنْ  عَطِيَّةَ أَبِي الْمُعَدِّلِ  ،  عَنْ  أَبِيهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتِ :  اعْتَنَقَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عَلِيًّا  وَفَاطِمَةَ  بِيَدٍ ،  وَحَسَنًا  وَحُسَيْنًا  بِيَدٍ ، وَعَطَفَ عَلَيْهِمْ  خَمِيصَةً  كَانَتْ عَلَيْهِ سَوْدَاءَ ، وَقَبَّلَ  عَلِيًّا  وَقَبَّلَ  فَاطِمَةَ  رَضِيَ اللهُ عَنْهُمَا ، ثُمَّ قَالَ :  اللَّهُمَّ إِلَيْكَ لَا إِلَى النَّارِ أَنَا  وَأَهْلُ بَيْتِي  . قَالَتْ  أُمُّ سَلَمَةَ  : قُلْتُ : وَأَنَا ؟ قَالَ : "" وَأَنْتِ  .  كذا في طبعة مكتبة ابن تيمية ، وصوابه : ( المعذل) .","","Al-Mu'jam al-Kabir 2667","","هند بنت أبي أمية زوج رسول الله عن والد عطية الطفاوي عن عطية الطفاوي عن عوف بن أبي جميلة عن هوذة بن خليفة البكراوي عن لحية الليف محمد بن العباس عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2666","2668  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ ،  ثَنَا  أَبُو غَسَّانَ مَالِكُ         [3/55]      بْنُ إِسْمَاعِيلَ ،  ثَنَا  جَعْفَرٌ الْأَحْمَرُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  عَطَاءٍ ،  عَنْ  أُمِّ سَلَمَةَ  أَنَّ  فَاطِمَةَ  جَاءَتْ بِطُعَيْمٍ لَهَا إِلَى أَبِيهَا وَهُوَ عَلَى مَنَامَةٍ لَهُ فِي بَيْتِ  أُمِّ سَلَمَةَ  ، قَالَتْ : قَالَ : "" اذْهَبِي فَادْعِي ابْنَيَّ وَابْنَ عَمِّكِ "" . فَجَاءُوا فَجَلَّلَهُمْ بِكِسَاءٍ ، ثُمَّ قَالَ :  اللَّهُمَّ هَؤُلَاءِ  أَهْلُ بَيْتِي  وَحَامَّتِي  فَأَذْهِبْ عَنْهُمُ الرِّجْسَ وَطَهِّرْهُمْ تَطْهِيرًا  . قَالَتْ  أُمُّ سَلَمَةَ  : وَأَنَا مَعَهُمْ يَا رَسُولَ اللهِ ؟ قَالَ : "" أَنْتِ زَوْجُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَإِلَى - أَوْ عَلَى - خَيْرٍ  .","","Al-Mu'jam al-Kabir 2668","","هند بنت أبي أمية زوج رسول الله عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن جعفر بن زياد الأحمر عن مالك بن إسماعيل النهدي عن حفص بن عمر سنجة ألف عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2667","2669  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  كُلْثُومِ بْنِ زِيَادٍ ،  عَنْ  أَبِي عَمَّارٍ ، قَالَ :  إِنِّي لَجَالِسٌ عِنْدَ وَاثِلَةَ بْنِ الْأَسْقَعِ ، إِذْ ذَكَرُوا  عَلِيًّا  رَضِيَ اللهُ عَنْهُ فَشَتَمُوهُ ، فَلَمَّا قَامُوا ، قَالَ : اجْلِسْ حَتَّى أُخْبِرَكَ عَنْ هَذَا الَّذِي شَتَمُوا ، إِنِّي عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَاتَ يَوْمٍ إِذْ جَاءَ  عَلِيٌّ  وَفَاطِمَةُ  وَالْحَسَنُ  وَالْحُسَيْنُ  رَضِيَ اللهُ عَنْهُمْ ، فَأَلْقَى عَلَيْهِمْ كِسَاءً لَهُ ، ثُمَّ قَالَ :  اللَّهُمَّ هَؤُلَاءِ  أَهْلُ بَيْتِي  ، اللَّهُمَّ أَذْهِبْ عَنْهُمُ الرِّجْسَ وَطَهِّرْهُمْ تَطْهِيرًا  . فَقُلْتُ : يَا رَسُولَ اللهِ وَأَنَا ؟ قَالَ : "" وَأَنْتَ "" . قَالَ : فَوَاللهِ إِنَّهَا لَأَوْثَقُ عَمَلٍ فِي نَفْسِي  .","","Al-Mu'jam al-Kabir 2669","","واثلة بن الأسقع الليثي عن شداد بن عبد الله العذري عن كلثوم بن زياد القاضي عن عبد السلام بن حرب الملائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2668","2670  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ التِّنِّيسِيُّ ،  ثَنَا  الْأَوْزَاعِيُّ ،  ثَنَا  أَبُو عَمَّارٍ شَدَّادٌ ، قَالَ :  قَالَ  وَاثِلَةُ بْنُ الْأَسْقَعِ اللَّيْثِيُّ :  كُنْتُ أُرِيدُ  عَلِيًّا  فَلَمْ أَجِدْ ، فَقَالَتْ  فَاطِمَةُ  : انْطَلَقَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَدْعُوهُ حَتَّى يَأْتِيَ . قَالَ : فَجَاءَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَجَاءَ ، فَدَخَلْتُ مَعَهُمَا ، فَدَعَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  حَسَنًا  وَحُسَيْنًا  ، فَأَجْلَسَ كُلَّ وَاحِدٍ مِنْهُمَا عَلَى فَخِذِهِ ، وَأَدْنَى  فَاطِمَةَ  مِنْ         [3/56]      حِجْرِهِ ، ثُمَّ لَفَّ عَلَيْهِمْ ثَوْبَهُ وَأَنَا مُسْتَنِدٌ ، ثُمَّ قَالَ :         {      إِنَّمَا يُرِيدُ اللهُ لِيُذْهِبَ عَنْكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا         }      ، ثُمَّ قَالَ : "" هَؤُلَاءِ أَهْلِي "" . قَالَ  وَاثِلَةُ  : قُلْتُ : يَا رَسُولَ اللهِ وَأَنَا مِنْ أَهْلِكَ ؟ قَالَ : "" وَأَنْتَ مِنْ أَهْلِي "" . قَالَ  وَاثِلَةُ  : إِنَّهُ لَأَرْجَى مَا أَرْجُوهُ  .","","Al-Mu'jam al-Kabir 2670","","واثلة بن الأسقع الليثي عن شداد بن عبد الله العذري عن أبو عمرو الأوزاعي عن محمد بن بشر التنيسي عن محمد بن علي بن زيد الصائغ عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2669","2671  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدِ بْنِ جُدْعَانَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَمُرُّ بِبَيْتِ  فَاطِمَةَ  رَضِيَ اللهُ عَنْهَا سِتَّةَ أَشْهُرٍ إِذَا خَرَجَ مِنْ صَلَاةِ الْفَجْرِ يَقُولُ :  يَا أَهْلَ الْبَيْتِ "" الصَّلَاةَ  ،         {      إِنَّمَا يُرِيدُ اللهُ لِيُذْهِبَ عَنْكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا         }      .","","Al-Mu'jam al-Kabir 2671","","أنس بن مالك عن علي بن زيد بن جدعان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن أبو مسلم الكجي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2670","2672  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ الْأَنْمَاطِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ، قَالَ :  سَمِعْتُ  مَنْصُورَ بْنَ أَبِي الْأَسْوَدِ يَقُولُ :  سَمِعْتُ  أَبَا دَاوُدَ يَقُولُ :  سَمِعْتُ  أَبَا الْحَمْرَاءِ يَقُولُ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَأْتِي بَابَ  فَاطِمَةَ  سِتَّةَ أَشْهُرٍ ، فَيَقُولُ :         {      إِنَّمَا يُرِيدُ اللهُ لِيُذْهِبَ عَنْكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا         }      .","","Al-Mu'jam al-Kabir 2672","","أبو الحمراء مولى رسول الله عن نفيع بن الحارث الأعمى عن منصور بن أبي الأسود الليثي عن سعيد بن سليمان سعدويه عن محمد بن الحسين الأنماطي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2671","2673  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ مَيْمُونٍ ،  ثَنَا  عَلِيُّ بْنُ عَابِسٍ ،  عَنْ  أَبِي الْجَحَّافِ ،  عَنْ  عَطِيَّةَ  ، عَنْ  أَبِي سَعِيدٍ ،  وَعَنِ  الْأَعْمَشِ ،  عَنْ  عَطِيَّةَ  ، عَنْ  أَبِي سَعِيدٍ ، قَالَ :  نَزَلَتْ هَذِهِ الْآيَةُ :         {      إِنَّمَا يُرِيدُ اللهُ لِيُذْهِبَ عَنْكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا         }      فِي رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَعَلِيٍّ  وَفَاطِمَةَ  وَالْحَسَنِ  وَالْحُسَيْنِ  رَضِيَ اللهُ عَنْهُمْ ""  .","","Al-Mu'jam al-Kabir 2673","","أبو سعيد الخدري عن عطية بن سعد العوفي عن داود بن أبي عوف البرجمي عن علي بن عابس الملائي عن إبراهيم بن محمد بن ميمون الكندي عن محمد بن عثمان بن أبي شيبة عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2672","2674  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ         [3/57]      الْحِمَّانِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبَايَةَ بْنِ رِبْعِيٍّ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ تَعَالَى قَسَمَ الْخَلْقَ قِسْمَيْنِ ، فَجَعَلَنِي فِي خَيْرِهَا قِسْمًا  ، فَذَلِكَ قَوْلُهُ :         {      أَصْحَابُ الْيَمِينِ         }             {      وَأَصْحَابُ الشِّمَالِ         }      ، فَأَنَا مِنْ أَصْحَابِ الْيَمِينِ ، وَأَنَا مِنْ خَيْرِ أَصْحَابِ الْيَمِينِ ، ثُمَّ جَعَلَ الْقِسْمَيْنِ بُيُوتًا ، فَجَعَلَنِي فِي خَيْرِهِمَا بَيْتًا ، فَذَلِكَ قَوْلُهُ :         {      فَأَصْحَابُ الْمَيْمَنَةِ مَا أَصْحَابُ الْمَيْمَنَةِ             *          وَأَصْحَابُ الْمَشْأَمَةِ مَا أَصْحَابُ الْمَشْأَمَةِ             *          وَالسَّابِقُونَ السَّابِقُونَ         }      ، فَأَنَا مِنْ خَيْرِ السَّابِقِينَ ، ثُمَّ جَعَلَ الْبُيُوتَ قَبَائِلَ ، فَجَعَلَنِي فِي خَيْرِهَا قَبِيلَةً ، فَذَلِكَ قَوْلُهُ :         {      شُعُوبًا وَقَبَائِلَ         }      ، فَأَنَا أَتْقَى وَلَدِ آدَمَ وَأَكْرَمُهُمْ عَلَى اللهِ عَزَّ وَجَلَّ وَلَا  فَخْرَ ،  ثُمَّ جَعَلَ الْقَبَائِلَ بُيُوتًا ، فَجَعَلَنِي فِي خَيْرِهَا بَيْتًا ، فَذَلِكَ قَوْلُهُ :         {      إِنَّمَا يُرِيدُ اللهُ لِيُذْهِبَ عَنْكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا         }      .","","Al-Mu'jam al-Kabir 2674","","عبد الله بن عباس عن عباية بن ربعي الأسدي عن الأعمش عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2673","2675  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رُزَيْقِ بْنِ جَامِعٍ الْمِصْرِيُّ  ، ثَنَا  الْهَيْثَمُ بْنُ حَبِيبٍ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَلِيِّ بْنِ عَلِيٍّ الْمَكِّيِّ الْهِلَالِيِّ ،  عَنْ  أَبِيهِ  ، قَالَ :  دَخَلْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي شَكَاتِهِ الَّتِي قُبِضَ فِيهَا ، فَإِذَا  فَاطِمَةُ  رَضِيَ اللهُ عَنْهَا عِنْدَ رَأْسِهِ . قَالَ : فَبَكَتْ حَتَّى ارْتَفَعَ صَوْتُهَا ، فَرَفَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ طَرْفَهُ إِلَيْهَا ، فَقَالَ :  حَبِيبَتِي  فَاطِمَةُ  مَا الَّذِي يُبْكِيكِ ؟  فَقَالَتْ : أَخْشَى الضَّيْعَةَ مِنْ بَعْدِكَ . فَقَالَ : "" يَا حَبِيبَتِي ، أَمَا عَلِمْتِ أَنَّ اللهَ عَزَّ وَجَلَّ اطَّلَعَ إِلَى الْأَرْضِ اطِّلَاعَةً فَاخْتَارَ مِنْهَا أَبَاكِ فَبُعِثَ بِرِسَالَتِهِ ، ثُمَّ اطَّلَعَ اطِّلَاعَةً فَاخْتَارَ مِنْهَا  بَعْلَكِ  وَأَوْحَى إِلَيَّ أَنْ أُنْكِحَكِ إِيَّاهُ ، يَا  فَاطِمَةُ  وَنَحْنُ  أَهْلُ بَيْتٍ  قَدْ أَعْطَانَا اللهُ سَبْعَ خِصَالٍ لَمْ يُعْطَ أَحَدٌ قَبْلَنَا ، وَلَا يُعْطَى أَحَدٌ بَعْدَنَا : أَنَا خَاتَمُ النَّبِيِّينَ ، وَأَكْرَمُ النَّبِيِّينَ عَلَى اللهِ ، وَأَحَبُّ الْمَخْلُوقِينَ إِلَى اللهِ عَزَّ وَجَلَّ ، وَأَنَا أَبُوكِ ، وَوَصِيِّي خَيْرُ الْأَوْصِيَاءِ وَأَحَبُّهُمُ إِلَى اللهِ ، وَهُوَ  بَعْلُكِ  ،  وَشَهِيدُنَا  خَيْرُ         [3/58]      الشُّهَدَاءِ وَأَحَبُّهُمْ إِلَى اللهِ ، وَهُوَ عَمُّكِ  حَمْزَةُ بْنُ عَبْدِ الْمُطَّلِبِ  ، وَهُوَ عَمُّ أَبِيكِ ، وَعَمُّ  بَعْلِكِ  ، وَمِنَّا مَنْ لَهُ جَنَاحَانِ أَخْضَرَانِ يَطِيرُ فِي الْجَنَّةِ مَعَ الْمَلَائِكَةِ حَيْثُ يَشَاءُ ، وَهُوَ ابْنُ عَمِّ أَبِيكِ وَأَخُو  بَعْلِكِ  ، وَمِنَّا سِبْطَا هَذِهِ الْأُمَّةِ ، وَهُمَا ابْنَاكِ  الْحَسَنُ  وَالْحُسَيْنُ  ، وَهُمَا سَيِّدَا شَبَابِ أَهْلِ الْجَنَّةِ ، وَأَبُوهُمَا وَالَّذِي بَعَثَنِي بِالْحَقِّ خَيْرٌ مِنْهُمَا ، يَا  فَاطِمَةُ  وَالَّذِي بَعَثَنِي بِالْحَقِّ إِنَّ مِنْهُمَا مَهْدِيَّ هَذِهِ الْأُمَّةِ إِذَا صَارَتِ الدُّنْيَا  هَرْجًا  وَمَرْجًا ، وَتَظَاهَرَتِ الْفِتَنُ ، وَتَقَطَّعَتِ السُّبُلُ ، وَأَغَارَ بَعْضُهُمْ عَلَى بَعْضٍ ، فَلَا كَبِيرَ يَرْحَمُ صَغِيرًا ، وَلَا صَغِيرَ يُوَقِّرُ كَبِيرًا ، فَيَبْعَثُ اللهُ عَزَّ وَجَلَّ عِنْدَ ذَلِكَ مِنْهُمَا مَنْ يَفْتَتِحُ حُصُونَ الضَّلَالَةِ ، وَقُلُوبًا  غُلْفًا  ، يَقُومُ بِالدِّينِ فِي آخِرِ الزَّمَانِ كَمَا قُمْتُ بِهِ فِي أَوَّلِ الزَّمَانِ ، وَيَمْلَأُ الدُّنْيَا عَدْلًا كَمَا مُلِئَتْ جَوْرًا ، يَا  فَاطِمَةُ  لَا تَحْزَنِي وَلَا تَبْكِي ؛ فَإِنَّ اللهَ عَزَّ وَجَلَّ أَرْحَمُ بِكِ وَأَرْأَفُ عَلَيْكِ مِنِّي ، وَذَلِكَ لِمَكَانِكِ مِنِّي ، وَمَوْضِعِكِ مِنْ قَلْبِي ، وَزَوَّجَكِ اللهُ زَوْجَكِ وَهُوَ أَشْرَفُ أَهْلِ بَيْتِكِ حَسَبًا ، وَأَكْرَمُهُمْ مَنْصِبًا ، وَأَرْحَمُهُمْ بِالرَّعِيَّةِ ، وَأَعْدَلُهُمْ بِالسَّوِيَّةِ ، وَأَبْصَرُهُمْ بِالْقَضِيَّةِ ، وَقَدْ سَأَلْتُ رَبِّي عَزَّ وَجَلَّ أَنْ تَكُونِي أَوَّلَ مَنْ يَلْحَقُنِي مِنْ  أَهْلِ بَيْتِي  "" . قَالَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ : "" فَلَمَّا قُبِضَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمْ تَبْقَ  فَاطِمَةُ  رَضِيَ اللهُ عَنْهَا بَعْدَهُ إِلَّا خَمْسَةً وَسَبْعِينَ يَوْمًا حَتَّى أَلْحَقَهَا اللهُ بِهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 2675","","علي الهلالي عن علي بن علي المكي الهلالي عن سفيان بن عيينة عن الهيثم بن حبيب عن محمد بن رزيق بن جامع العدل عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2674","2676  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ الْبَرَاءِ  ، ثَنَا  عَبْدُ الْمُنْعِمِ بْنُ         [3/59]      إِدْرِيسَ بْنِ سِنَانٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَهْبِ بْنِ مُنَبِّهٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، وَعَبْدِ اللهِ بْنِ عَبَّاسٍ  فِي قَوْلِ اللهِ عَزَّ وَجَلَّ :         {      إِذَا جَاءَ نَصْرُ اللهِ وَالْفَتْحُ             *          وَرَأَيْتَ النَّاسَ يَدْخُلُونَ فِي دِينِ اللهِ أَفْوَاجًا             *          فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُ إِنَّهُ كَانَ تَوَّابًا         }      ، قَالَ : لَمَّا نَزَلَتْ قَالَ  مُحَمَّدٌ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  جِبْرِيلُ  نَفْسِي قَدْ نُعِيَتْ  . قَالَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ : الْآخِرَةُ خَيْرٌ لَكَ مِنَ الْأُولَى ،         {      وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَى         }      . فَأَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِلَالًا  أَنْ يُنَادِيَ بِالصَّلَاةِ جَامِعَةً ، فَاجْتَمَعَ  الْمُهَاجِرُونَ  وَالْأَنْصَارُ  إِلَى مَسْجِدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ صَعِدَ الْمِنْبَرَ ، فَحَمِدَ اللهَ عَزَّ وَجَلَّ وَأَثْنَى عَلَيْهِ ، ثُمَّ خَطَبَ خُطْبَةً  وَجِلَتْ  مِنْهَا الْقُلُوبُ وَبَكَتِ الْعُيُونُ ، ثُمَّ قَالَ : "" أَيُّهَا النَّاسُ أَيُّ نَبِيٍّ كُنْتُ لَكُمْ ؟ "" فَقَالُوا : جَزَاكَ اللهُ مِنْ نَبِيٍّ خَيْرًا ؛ فَلَقَدْ كُنْتَ بِنَا كَالْأَبِ الرَّحِيمِ ، وَكَالْأَخِ النَّاصِحِ الْمُشْفِقِ ، أَدَّيْتَ رِسَالَاتِ اللهِ عَزَّ وَجَلَّ وَأَبْلَغْتَنَا وَحَيَهُ ، وَدَعَوْتَ إِلَى  سَبِيلِ  رَبِّكِ بِالْحِكْمَةِ وَالْمَوْعِظَةِ الْحَسَنَةِ ، فَجَزَاكَ اللهُ عَنَّا أَفْضَلَ مَا جَازَى نَبِيًّا عَنْ أُمَّتِهِ . فَقَالَ لَهُمْ : "" مَعَاشِرَ الْمُسْلِمِينَ ، أَنَا  أَنْشُدُكُمْ  بِاللهِ وَبِحَقِّي عَلَيْكُمْ ، مَنْ كَانَتْ لَهُ قِبَلِي مَظْلَمَةٌ فَلْيَقُمْ فَلْيَقْتَصَّ مِنِّي . فَلَمْ يَقُمْ إِلَيْهِ أَحَدٌ ، فَنَاشَدَهُمُ الثَّانِيَةَ ، فَلَمْ يَقُمْ إِلَيْهِ أَحَدٌ ، فَنَاشَدَهُمُ الثَّالِثَةَ : مَعَاشِرَ الْمُسْلِمِينَ  أَنْشُدُكُمْ  بِاللهِ وَبِحَقِّي عَلَيْكُمْ مَنْ كَانَتْ لَهُ قِبَلِي مَظْلَمَةٌ فَلْيَقُمْ فَلْيَقْتَصَّ مِنِّي قَبْلَ الْقِصَاصِ فِي الْقِيَامَةِ "" . فَقَامَ مِنْ بَيْنِ الْمُسْلِمِينَ شَيْخٌ كَبِيرٌ يُقَالُ لَهُ  عُكَّاشَةُ  ، فَتَخَطَّى الْمُسْلِمِينَ حَتَّى وَقَفَ بَيْنَ يَدَيْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : فِدَاكَ أَبِي وَأُمِّي ، لَوْلَا أَنَّكَ نَاشَدْتَنَا مَرَّةً بَعْدَ أُخْرَى مَا كُنْتُ بِالَّذِي يُقْدِمُ عَلَى شَيْءٍ مِنْ هَذَا ، كُنْتُ مَعَكَ فِي غَزَاةٍ ، فَلَمَّا فَتَحَ اللهُ عَزَّ وَجَلَّ عَلَيْنَا وَنَصَرَ نَبِيَّهُ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَكُنَّا فِي الِانْصِرَافِ حَاذَتْ نَاقَتِي نَاقَتَكَ فَنَزَلْتُ عَنِ النَّاقَةِ ، وَدَنَوْتُ مِنْكَ لِأُقَبِّلَ         [3/60]      فَخِذَكَ ، فَرَفَعْتَ الْقَضِيبَ فَضَرَبْتَ  خَاصِرَتِي  ، وَلَا أَدْرِي أَكَانَ عَمْدًا مِنْكَ ، أَمْ أَرَدْتَ ضَرْبَ النَّاقَةِ . فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أُعِيذُكَ بِجَلَالِ اللهِ أَنْ يَتَعَمَّدَكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالضَّرْبِ ، يَا  بِلَالُ  انْطَلِقْ إِلَى مَنْزِلِ  فَاطِمَةَ  وَائْتِنِي بِالْقَضِيبِ الْمَمْشُوقِ "" . فَخَرَجَ  بِلَالٌ  مِنَ الْمَسْجِدِ وَيَدُهُ عَلَى أُمِّ رَأْسِهِ ، وَهُوَ يُنَادِي : هَذَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُعْطِي الْقِصَاصَ مِنْ نَفْسِهِ . فَقَرَعَ الْبَابَ عَلَى  فَاطِمَةَ  ، فَقَالَ : يَا بِنْتَ رَسُولِ اللهِ نَاوِلِينِي الْقَضِيبَ الْمَمْشُوقَ . فَقَالَتْ  فَاطِمَةُ  : يَا  بِلَالُ  وَمَا يَصْنَعُ أَبِي بِالْقَضِيبِ وَلَيْسَ هَذَا يَوْمَ حَجٍّ وَلَا يَوْمَ غَزَاةٍ ؟ فَقَالَ : يَا  فَاطِمَةُ  مَا أَغْفَلَكِ عَمَّا فِيهِ أَبُوكِ ، إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُوَدِّعُ الدِّينَ وَيُفَارِقُ الدُّنْيَا ، وَيُعْطِي الْقِصَاصَ مِنْ نَفْسِهِ . فَقَالَتْ  فَاطِمَةُ  رَضِيَ اللهُ عَنْهَا : يَا  بِلَالُ  وَمَنْ ذَا الَّذِي تَطِيبُ نَفْسُهُ أَنْ يَقْتَصَّ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ يَا  بِلَالُ  فَقُلْ  لِلْحَسَنِ  وَالْحُسَيْنِ  يَقُومَانِ إِلَى هَذَا الرَّجُلِ فَيَقْتَصُّ مِنْهُمَا ، وَلَا يَدَعَانِهِ يَقْتَصُّ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ . فَدَخَلَ  بِلَالٌ  الْمَسْجِدَ ، وَدَفَعَ الْقَضِيبَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَدَفَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْقَضِيبَ إِلَى  عُكَّاشَةَ  ، فَلَمَّا نَظَرَ  أَبُو بَكْرٍ  وَعُمَرُ  رَضِيَ اللهُ عَنْهُمَا إِلَى ذَلِكَ ، قَامَا فَقَالَا : يَا  عُكَّاشَةُ  هَذَانِ نَحْنُ بَيْنَ يَدَيْكَ فَاقْتَصَّ مِنَّا ، وَلَا تَقْتَصَّ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ . فَقَالَ لَهُمَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" امْضِ يَا  أَبَا بَكْرٍ  وَأَنْتَ يَا  عُمَرُ  ، فَامْضِ فَقَدْ عَرَفَ اللهُ مَكَانَكُمَا وَمَقَامَكُمَا "" . فَقَامَ  عَلِيُّ بْنُ أَبِي طَالِبٍ  ، فَقَالَ : يَا  عُكَّاشَةُ  أَنَا فِي الْحَيَاةِ بَيْنَ يَدَيْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَلَا تَطِيبُ نَفْسِي أَنْ يُضْرَبَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَهَذَا ظَهْرِي وَبَطْنِي ، اقْتَصَّ مِنِّي بِيَدِكَ وَاجْلِدْنِي مِائَةً ، وَلَا تَقْتَصَّ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ . فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يَا  عَلِيُّ  اقْعُدْ فَقَدْ عَرَفَ اللهُ عَزَّ وَجَلَّ مَقَامَكَ وَنِيَّتَكَ "" . وَقَامَ  الْحَسَنُ  وَالْحُسَيْنُ  رَضِيَ اللهُ عَنْهُمَا فَقَالَا : يَا  عُكَّاشَةُ  أَلَيْسَ تَعْلَمُ أَنَّا  سِبْطَا  رَسُولِ اللهِ ؟ فَالْقِصَاصُ مِنَّا كَالْقِصَاصِ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ . فَقَالَ لَهُمَا صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" اقْعُدَا يَا قُرَّةَ عَيْنِي ، لَا نَسِيَ اللهُ لَكُمَا هَذَا الْمُقَامَ "" . ثُمَّ قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يَا  عُكَّاشَةُ  اضْرِبْ إِنْ كُنْتَ ضَارِبًا "" . فَقَالَ : يَا رَسُولَ اللهِ ، ضَرَبْتَنِي وَأَنَا حَاسِرٌ عَنْ بَطْنِي . فَكَشَفَ         [3/61]      عَنْ بَطْنِهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَصَاحَ الْمُسْلِمُونَ بِالْبُكَاءِ ، وَقَالُوا : أَتُرَى :  عُكَّاشَةُ  ضَارِبٌ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَلَمَّا نَظَرَ  عُكَّاشَةُ  إِلَى بَيَاضِ بَطْنِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَأَنَّهُ  الْقَبَاطِيُّ  ، لَمْ يَمْلِكْ أَنْ كَبَّ عَلَيْهِ وَقَبَّلَ بَطْنَهُ ، وَهُوَ يَقُولُ : فِدَاءٌ لَكَ أَبِي وَأُمِّي ، وَمَنْ تُطِيقُ نَفْسُهُ أَنْ يَقْتَصَّ مِنْكَ ؟ فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِمَّا أَنْ تَضْرِبَ ، وَإِمَّا أَنْ تَعْفُوَ "" . فَقَالَ : قَدْ عَفَوْتُ عَنْكَ رَجَاءَ أَنْ يَعْفُوَ اللهُ عَنِّي فِي الْقِيَامَةِ . فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَنْ أَرَادَ أَنْ يَنْظُرَ إِلَى رَفِيقِي فِي الْجَنَّةِ فَلْيَنْظُرْ إِلَى هَذَا الشَّيْخِ "" . فَقَامَ الْمُسْلِمُونَ ، فَجَعَلُوا يُقَبِّلُونَ مَا بَيْنَ عَيْنَيْ  عُكَّاشَةَ  ، وَيَقُولُونَ : طُوبَاكَ طُوبَاكَ ، نِلْتَ الدَّرَجَاتِ الْعُلَى وَمُرَافَقَةَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ . فَمَرِضَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ يَوْمِهِ ، فَكَانَ مَرِيضًا ثَمَانِيَةَ عَشَرَ يَوْمًا يَعُودُهُ النَّاسُ ، وَكَانَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وُلِدَ يَوْمَ الِاثْنَيْنِ ، وَبُعِثَ يَوْمَ الِاثْنَيْنِ ، وَقُبِضَ يَوْمَ الِاثْنَيْنِ ، فَلَمَّا كَانَ فِي يَوْمِ الْأَحَدِ ثَقُلَ فِي مَرَضِهِ ، فَأَذَّنَ  بِلَالٌ  بِالْأَذَانِ ، ثُمَّ وَقَفَ بِالْبَابِ فَنَادَى : السَّلَامُ عَلَيْكَ يَا رَسُولَ اللهِ وَرَحْمَةُ اللهِ ، الصَّلَاةَ رَحِمَكَ اللهُ . فَسَمِعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَوْتَ  بِلَالٍ  ، فَقَالَتْ  فَاطِمَةُ  رَضِيَ اللهُ عَنْهَا : يَا  بِلَالُ  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْيَوْمَ مَشْغُولٌ بِنَفْسِهِ . فَدَخَلَ  بِلَالٌ  الْمَسْجِدَ ، فَلَمَّا  أَسْفَرَ  الصُّبْحُ ، قَالَ : وَاللهِ لَا أُقِيمُهَا أَوْ أَسْتَأْذِنَ سَيِّدِي رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ . فَرَجَعَ فَقَامَ بِالْبَابِ وَنَادَى : السَّلَامُ عَلَيْكَ يَا رَسُولَ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ ، الصَّلَاةَ يَرْحَمُكَ اللهُ . فَسَمِعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَوْتَ  بِلَالٍ  ، فَقَالَ : "" ادْخُلْ يَا  بِلَالُ  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَشْغُولٌ بِنَفْسِهِ ، مُرْ  أَبَا بَكْرٍ  يُصَلِّ بِالنَّاسِ "" . فَخَرَجَ وَيَدُهُ عَلَى أُمِّ رَأْسِهِ ، وَهُوَ يَقُولُ : وَاغَوْثًا بِاللهِ ، وَانْقِطَاعَ رَجَائِهِ ،  وَانْقِصَامَ  ظَهْرِي ، لَيْتَنِي لَمْ تَلِدْنِي أُمِّي ، وَإِذْ وَلَدَتْنِي لَمْ أَشْهَدْ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ هَذَا الْيَوْمَ . ثُمَّ قَالَ : يَا  أَبَا بَكْرٍ  ، أَلَا إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَكَ أَنْ تُصَلِّيَ بِالنَّاسِ . فَتَقَدَّمَ  أَبُو بَكْرٍ  رَضِيَ اللهُ عَنْهُ لِلنَّاسِ ، وَكَانَ رَجُلًا رَقِيقًا ، فَلَمَّا نَظَرَ إِلَى خَلْوَةِ الْمَكَانِ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمْ يَتَمَالَكْ أَنْ خَرَّ مَغْشِيًّا عَلَيْهِ ، وَصَاحَ الْمُسْلِمُونَ بِالْبُكَاءِ ، فَسَمِعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ضَجِيجَ النَّاسِ ، فَقَالَ : "" مَا هَذِهِ الضَّجَّةُ ؟ "" قَالُوا : ضَجَّةُ الْمُسْلِمِينَ لِفَقْدِكَ يَا رَسُولَ اللهِ . فَدَعَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عَلِيَّ بْنَ أَبِي طَالِبٍ         [3/62]      وَابْنَ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا ، فَاتَّكَأَ عَلَيْهِمَا ، فَخَرَجَ إِلَى الْمَسْجِدِ ، فَصَلَّى بِالنَّاسِ رَكْعَتَيْنِ خَفِيفَتَيْنِ ، ثُمَّ أَقْبَلَ بِوَجْهِهِ الْمَلِيحِ عَلَيْهِمْ ، فَقَالَ : "" يَا مَعْشَرَ الْمُسْلِمِينَ ، أَسْتَوْدِعُكُمُ اللهَ ، أَنْتُمْ فِي رَجَاءِ اللهِ وَأَمَانِهِ ، وَاللهُ خِلْفَتِي عَلَيْكُمْ ، مَعَاشِرَ الْمُسْلِمِينَ ، عَلَيْكُمْ بِاتِّقَاءِ اللهِ وَحِفْظِ طَاعَتِهِ مِنْ بَعْدِي ، فَإِنِّي مُفَارِقٌ الدُّنْيَا ، هَذَا أَوَّلُ يَوْمٍ مِنَ الْآخِرَةِ ، وَآخِرُ يَوْمٍ مِنْ أَيَّامِ الدُّنْيَا "" . فَلَمَّا كَانَ يَوْمُ الِاثْنَيْنِ اشْتَدَّ بِهِ الْأَمْرُ ، وَأَوْحَى اللهُ عَزَّ وَجَلَّ إِلَى  مَلَكِ الْمَوْتِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنِ اهْبِطْ إِلَى حَبِيبِي وَصَفِيِّي  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي أَحْسَنِ صُورَةٍ ، وَارْفُقْ بِهِ فِي قَبْضِ رُوحِهِ ، فَهَبَطَ  مَلَكُ الْمَوْتِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَوَقَفَ بِالْبَابِ شِبْهَ أَعْرَابِيٍّ ، ثُمَّ قَالَ : السَّلَامُ عَلَيْكُمْ يَا أَهْلَ بَيْتِ النُّبُوَّةِ ، وَمَعْدِنَ الرِّسَالَةِ ، وَمُخْتَلَفَ الْمَلَائِكَةِ ، أَدْخُلُ ؟ فَقَالَتْ  عَائِشَةُ  رَضِيَ اللهُ عَنْهَا  لِفَاطِمَةَ  : أَجِيبِي الرَّجُلَ . فَقَالَتْ  فَاطِمَةُ  : آجَرَكَ اللهُ فِي مَمْشَاكَ يَا عَبْدَ اللهِ ، إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَشْغُولٌ بِنَفْسِهِ . فَدَعَا الثَّانِيَةَ ، فَقَالَتْ  عَائِشَةُ  : يَا  فَاطِمَةُ  أَجِيبِي الرَّجُلَ . فَقَالَتْ  فَاطِمَةُ  : آجَرَكَ اللهُ فِي مَمْشَاكَ يَا عَبْدَ اللهِ ، إِنَّ رَسُولَ اللهِ مَشْغُولٌ بِنَفْسِهِ . ثُمَّ دَعَا الثَّالِثَةَ : السَّلَامُ عَلَيْكُمْ يَا أَهْلَ بَيْتِ النُّبُوَّةِ ، وَمَعْدِنَ الرِّسَالَةِ ، وَمُخْتَلَفَ الْمَلَائِكَةِ ، أَأَدْخُلُ ؟ فَلَا بُدَّ مِنَ الدُّخُولِ . فَسَمِعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَوْتَ  مَلَكِ الْمَوْتِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" يَا  فَاطِمَةُ  مَنْ بِالْبَابِ ؟ "" فَقَالَتْ : يَا رَسُولَ اللهِ ، إِنَّ رَجُلًا بِالْبَابِ يَسْتَأْذِنُ فِي الدُّخُولِ ، فَأَجَبْنَاهُ مَرَّةً بَعْدَ أُخْرَى ، فَنَادَى فِي الثَّالِثَةِ صَوْتًا اقْشَعَرَّ مِنْهُ جِلْدِي ، وَارْتَعَدَتْ  فَرَائِصِي  . فَقَالَ لَهَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يَا  فَاطِمَةُ  ، أَتَدْرِينَ مَنْ بِالْبَابِ ؟ هَذَا هَادِمُ اللَّذَّاتِ ، وَمُفَرِّقُ الْجَمَاعَاتِ ، هَذَا مُرَمِّلُ الْأَزْوَاجِ ، وَمُوتِمُ الْأَوْلَادِ ، هَذَا مُخَرِّبُ الدُّورِ ، وَعَامِرُ الْقُبُورِ ، هَذَا  مَلَكُ الْمَوْتِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ادْخُلْ رَحِمَكَ اللهُ يَا  مَلَكَ الْمَوْتِ  "" . فَدَخَلَ  مَلَكُ الْمَوْتِ  عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يَا  مَلَكَ الْمَوْتِ  ، جِئْتَنِي زَائِرًا أَمْ قَابِضًا ؟ "" قَالَ : جِئْتُكَ زَائِرًا وَقَابِضًا ، وَأَمَرَنِي اللهُ عَزَّ وَجَلَّ أَنْ لَا أَدْخُلَ عَلَيْكَ إِلَّا بِإِذْنِكَ ، وَلَا أَقْبِضَ رُوحَكَ إِلَّا بِإِذْنِكَ ، فَإِنْ أَذِنْتَ وَإِلَّا رَجَعْتُ إِلَى رَبِّي عَزَّ وَجَلَّ . فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يَا  مَلَكَ الْمَوْتِ  ، أَيْنَ خَلَّفْتَ حَبِيبِي  جِبْرِيلَ  ؟ "" قَالَ : خَلَّفْتُهُ فِي السَّمَاءِ الدُّنْيَا وَالْمَلَائِكَةُ         [3/63]      يُعَزُّونَهُ فِيكَ ، فَمَا كَانَ بِأَسْرَعِ أَنْ أَتَاهُ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، فَقَعَدَ عِنْدَ رَأْسِهِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يَا  جِبْرِيلُ  ، هَذَا الرَّحِيلُ مِنَ الدُّنْيَا ، فَبَشِّرْنِي مَا لِي عِنْدَ اللهِ "" ؟ قَالَ : أُبَشِّرُكَ يَا حَبِيبَ اللهِ أَنِّي قَدْ تَرَكْتُ أَبْوَابَ السَّمَاءِ قَدْ فُتِحَتْ ، وَالْمَلَائِكَةَ قَدْ قَامُوا صُفُوفًا صُفُوفًا بِالتَّحِيَّةِ وَالرَّيْحَانِ يُحَيُّونَ رُوحَكَ يَا  مُحَمَّدُ  . فَقَالَ : "" لِوَجْهِ رَبِّي الْحَمْدُ ، وَبَشِّرْنِي يَا  جِبْرِيلُ  "" . قَالَ : أُبَشِّرُكَ أَنَّ أَبْوَابَ الْجِنَانِ قَدْ فُتِحَتْ ، وَأَنْهَارَهَا قَدِ اطَّرَدَتْ ، وَأَشْجَارَهَا قَدْ تَدَلَّتْ ، وَحُورَهَا قَدْ تَزَيَّنَتْ لِقُدُومِ رُوحِكِ يَا  مُحَمَّدُ  . قَالَ : "" لِوَجْهِ رَبِّي الْحَمْدُ ، فَبَشِّرْنِي يَا  جِبْرِيلُ  "" . قَالَ : أَنْتَ أَوَّلُ شَافِعٍ وَأَوَّلُ مُشَفَّعٍ فِي الْقِيَامَةِ . قَالَ : "" لِوَجْهِ رَبِّي الْحَمْدُ "" . قَالَ  جِبْرِيلُ  : يَا حَبِيبِي ، عَمَّ تَسْأَلُنِي ؟ قَالَ : "" أَسْأَلُكَ عَنْ غَمِّي وَهَمِّي ، مَنْ لِقُرَّاءِ الْقُرْآنِ مِنْ بَعْدِي ؟ مَنْ لِصَوْمِ شَهْرِ رَمَضَانَ مِنْ بَعْدِي ؟ مَنْ لحَاجِّ بَيْتِ اللهِ الْحَرَامِ مِنْ بَعْدِي ؟ مَنْ لِأُمَّتِي الْمُصْطَفَاةِ مِنْ بَعْدِي ؟ "" قَالَ : أَبْشِرْ يَا حَبِيبَ اللهِ ، فَإِنَّ اللهَ عَزَّ وَجَلَّ يَقُولُ : قَدْ حُرِّمَتِ الْجَنَّةُ عَلَى جَمِيعِ الْأَنْبِيَاءِ وَالْأُمَمِ حَتَّى تَدْخُلَهَا أَنْتَ وَأُمَّتُكَ يَا  مُحَمَّدُ  . قَالَ : "" الْآنَ طَابَتْ نَفْسِي ، إِذَنْ يَا  مَلَكَ الْمَوْتِ  فَانْتَهِ إِلَى مَا أُمِرْتَ "" . فَقَالَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ : يَا رَسُولَ اللهِ ، إِذَا أَنْتَ قُبِضْتَ فَمَنْ يُغَسِّلُكَ ؟ وَفِيمَ نُكَفِّنُكَ ؟ وَمَنْ يُصَلِّي عَلَيْكَ ؟ وَمَنْ يَدْخُلُ الْقَبْرَ ؟ فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يَا  عَلِيُّ  أَمَّا الْغُسْلُ فَاغْسِلْنِي أَنْتَ ،  وَالْفَضْلُ بْنُ عَبَّاسٍ  يَصُبُّ عَلَيْكَ الْمَاءَ ،  وَجِبْرِيلُ  عَلَيْهِ السَّلَامُ ثَالِثُكُمَا ، فَإِذَا أَنْتُمْ فَرَغْتُمْ مِنْ غُسْلِي فَكَفِّنُونِي فِي ثَلَاثَةِ أَثْوَابٍ جُدُدٍ ،  وَجِبْرِيلُ  عَلَيْهِ السَّلَامُ يَأْتِينِي بِحَنُوطٍ مِنَ الْجَنَّةِ ، فَإِذَا أَنْتُمْ وَضَعْتُمُونِي عَلَى السَّرِيرِ فَضَعُونِي فِي الْمَسْجِدِ وَاخْرُجُوا عَنِّي ، فَإِنَّ أَوَّلَ مَنْ يُصَلِّي عَلَيَّ الرَّبُّ عَزَّ وَجَلَّ مِنْ فَوْقِ عَرْشِهِ ، ثُمَّ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، ثُمَّ  مِيكَائِيلُ  ، ثُمَّ  إِسْرَافِيلُ  عَلَيْهِمَا السَّلَامُ ، ثُمَّ الْمَلَائِكَةُ زُمَرًا زُمَرًا ، ثُمَّ ادْخُلُوا ، فَقُومُوا صُفُوفًا لَا يَتَقَدَّمُ عَلَيَّ أَحَدٌ "" . فَقَالَتْ  فَاطِمَةُ  رَضِيَ اللهُ تَعَالَى عَنْهَا : الْيَوْمَ الْفِرَاقُ ، فَمَتَى أَلْقَاكَ ؟ فَقَالَ لَهَا : "" يَا بُنَيَّةُ ، تَلْقَيْنَنِي يَوْمَ الْقِيَامَةِ عِنْدَ الْحَوْضِ وَأَنَا أَسْقِي مَنْ يَرِدُ عَلَيَّ الْحَوْضَ مِنْ أُمَّتِي "" . قَالَتْ : فَإِنْ لَمْ أَلْقَكَ يَا رَسُولَ اللهِ ؟         [3/64]      قَالَ : "" تَلْقَيْنِي عِنْدَ الْمِيزَانِ وَأَنَا أَشْفَعُ لِأُمَّتِي "" . قَالَتْ : فَإِنْ لَمْ أَلْقَكَ يَا رَسُولَ اللهِ ؟ قَالَ : "" تَلْقَيْنِي عِنْدَ الصِّرَاطِ وَأَنَا أُنَادِي رَبِّي سَلِّمْ أُمَّتِي مِنَ النَّارِ "" . فَدَنَا  مَلَكُ الْمَوْتِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يُعَالِجُ  قَبْضَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا بَلَغَ الرُّوحُ الرُّكْبَتَيْنِ ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  أَوْهِ  "" . فَلَمَّا بَلَغَ الرُّوحُ السُّرَّةَ نَادَى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" وَاكَرْبَاهُ "" . فَقَالَتْ  فَاطِمَةُ  عَلَيْهَا السَّلَامُ : كَرْبِي يَا أَبَتَاهُ . فَلَمَّا بَلَغَ الرُّوحُ إِلَى الثُّنْدُؤَةِ نَادَى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يَا  جِبْرِيلُ  ، مَا أَشَدَّ مَرَارَةَ الْمَوْتِ "" . فَوَلَّى  جِبْرِيلُ  عَلَيْهِ السَّلَامُ وَجْهَهُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يَا  جِبْرِيلُ  ، كَرِهْتَ النَّظَرَ إِلَيَّ ؟ "" فَقَالَ  جِبْرِيلُ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : يَا حَبِيبِي ، وَمَنْ تُطِيقُ نَفْسُهُ أَنْ يَنْظُرَ إِلَيْكَ وَأَنْتَ  تُعَالِجُ  سَكَرَاتِ الْمَوْتِ ؟ فَقُبِضَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَغَسَّلَهُ  عَلِيُّ بْنُ أَبِي طَالِبٍ  ،  وَابْنُ عَبَّاسٍ  يَصُبُّ عَلَيْهِ الْمَاءَ ،  وَجِبْرِيلُ  عَلَيْهِ السَّلَامُ مَعَهُمَا ، وَكُفِّنَ بِثَلَاثَةِ أَثْوَابٍ جُدُدٍ ، وَحُمِلَ عَلَى سَرِيرٍ ، ثُمَّ أَدْخَلُوهُ الْمَسْجِدَ ، وَوَضَعُوهُ فِي الْمَسْجِدِ ، وَخَرَجَ النَّاسُ عَنْهُ ، فَأَوَّلُ مَنْ صَلَّى عَلَيْهِ الرَّبُّ تَعَالَى مِنْ فَوْقِ عَرْشِهِ ، ثُمَّ  جِبْرِيلُ  ، ثُمَّ  مِيكَائِيلُ  ، ثُمَّ  إِسْرَافِيلُ  ، ثُمَّ الْمَلَائِكَةُ زُمَرًا زُمَرًا . قَالَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ : لَقَدْ سَمِعْنَا فِي الْمَسْجِدِ  هَمْهَمَةً  ، وَلَمْ نَرَ لَهُمْ شَخْصًا ، فَسَمِعْنَا هَاتِفًا يَهْتِفُ وَيَقُولُ : ادْخُلُوا رَحِمَكُمُ اللهُ فَصَلُّوا عَلَى نَبِيِّكُمْ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ . فَدَخَلْنَا وَقُمْنَا صُفُوفًا صُفُوفًا كَمَا أَمَرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَكَبَّرْنَا بِتَكْبِيرِ  جِبْرِيلَ  عَلَيْهِ السَّلَامُ ، وَصَلَّيْنَا عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِصَلَاةِ  جِبْرِيلَ  عَلَيْهِ السَّلَامُ ، مَا تَقَدَّمَ مِنَّا أَحَدٌ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَدَخَلَ الْقَبْرَ  أَبُو بَكْرٍ الصِّدِّيقُ  ،  وَعَلِيُّ بْنُ أَبِي طَالِبٍ  ،  وَابْنُ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمْ ، وَدُفِنَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا انْصَرَفَ النَّاسُ قَالَتْ  فَاطِمَةُ  لِعَلِيٍّ  رَضِيَ اللهُ عَنْهُ : يَا  أَبَا الْحَسَنِ  ، دَفَنْتُمْ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : نَعَمْ . قَالَتْ  فَاطِمَةُ  رَضِيَ اللهُ عَنْهَا : كَيْفَ طَابَتْ أَنْفُسُكُمْ أَنْ تَحْثُوا التُّرَابَ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ أَمَا كَانَ فِي صُدُورِكُمْ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الرَّحْمَةُ ، أَمَا كَانَ مُعَلِّمَ الْخَيْرِ ؟ قَالَ : بَلَى يَا  فَاطِمَةُ  ، وَلَكِنْ أَمْرُ اللهِ الَّذِي لَا مَرَدَّ لَهُ . فَجَعَلَتْ تَبْكِي وَتَنْدُبُ ، وَهِيَ تَقُولُ : يَا أَبَتَاهُ ، الْآنَ انْقَطَعَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، وَكَانَ  جِبْرِيلُ  يَأْتِينَا بِالْوَحْيِ مِنَ السَّمَاءِ .","","Al-Mu'jam al-Kabir 2676","","عبد الله بن عباس عن وهب بن منبه عن إدريس بن سنان اليماني عن عبد المنعم بن إدريس اليماني عن محمد بن أحمد بن البراء العبدي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2675","[3/65]      2677  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ مُحَمَّدٍ الْحَنَّاطُ الرَّامَهُرْمُزِيُّ  ، ثَنَا  أَحْمَدُ بْنُ رُشْدِ بْنِ خَيْثَمٍ الْهِلَالِيُّ  ،  ثَنَا  عَمِّي سَعِيدُ بْنُ خَيْثَمٍ  ،  ثَنَا  مُسْلِمٌ الْمُلَائِيُّ ،  عَنْ  حَبَّةَ الْعُرَنِيِّ وَأَبِي الْبَخْتَرِيِّ ،  عَنْ  سَلْمَانَ ، قَالَ :  كُنَّا حَوْلَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَجَاءَتْ  أُمُّ أَيْمَنَ  ، فَقَالَتْ : يَا رَسُولَ اللهِ لَقَدْ ضَلَّ  الْحَسَنُ  وَالْحُسَيْنُ  . قَالَ : وَذَلِكَ رَادَّ النَّهَارِ ،  يَقُولُ : ارْتِفَاعَ النَّهَارِ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" قُومُوا فَاطْلُبُوا ابْنَيَّ "" . قَالَ : وَأَخَذَ كُلُّ رَجُلٍ تُجَاهَ وَجْهِهِ ، وَأَخَذْتُ نَحْوَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمْ يَزَلْ حَتَّى أَتَى سَفْحَ جَبَلٍ ، وَإِذَا  الْحَسَنُ  وَالْحُسَيْنُ  رَضِيَ اللهُ عَنْهُمَا مُلْتَزِقٌ كُلُّ وَاحِدٍ مِنْهُمَا صَاحِبَهُ ، وَإِذَا شُجَاعٌ قَائِمٌ عَلَى ذَنَبِهِ ، يَخْرُجُ مِنْ فِيهِ شِبْهُ النَّارِ ، فَأَسْرَعَ إِلَيْهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَالْتَفَتَ مُخَاطِبًا لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ انْسَابَ فَدَخَلَ بَعْضَ الْأَحْجِرَةِ ، ثُمَّ أَتَاهُمَا فَأَفْرَقَ بَيْنَهُمَا وَمَسَحَ وَجْهَهُمَا ، وَقَالَ :  بِأَبِي وَأُمِّي أَنْتُمَا مَا أَكَرَمَكُمَا عَلَى اللهِ  . ثُمَّ حَمَلَ أَحَدَهُمَا عَلَى عَاتِقِهِ الْأَيْمَنِ ، وَالْآخَرَ عَلَى عَاتِقِهِ الْأَيْسَرِ ، فَقُلْتُ : طُوبَاكُمَا ، نِعْمَ الْمَطِيَّةُ مَطِيَّتُكُمَا . فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" وَنِعْمَ الرَّاكِبَانِ هُمَا ، وَأَبُوهُمَا خَيْرٌ مِنْهُمَا  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( خثيم )  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( خثيم )","","Al-Mu'jam al-Kabir 2677","","سلمان الفارسي عن سعيد بن فيروز الطائي عن مسلم بن كيسان البراد عن سعيد بن خثيم الهلالي عن أحمد بن راشد بن خثيم الكوفي عن الحسين بن محمد بن عبد الرحمن الخياط عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2676","2678  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  عَطِيَّةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَيُّهَا النَّاسُ إِنِّي تَارِكٌ فِيكُمْ مَا إِنْ أَخَذْتُمْ بِهِ لَنْ تَضِلُّوا بَعْدِي أَمْرَيْنِ  ، أَحَدُهُمَا أَكْبَرُ مِنَ الْآخَرِ : كِتَابَ اللهِ ،  حَبْلٌ  مَمْدُودٌ مَا بَيْنَ السَّمَاءِ وَالْأَرْضِ ،  وَعِتْرَتِي  أَهْلَ بَيْتِي  ، وَإِنَّهُمَا لَنْ يَفْتَرِقَا حَتَّى يَرِدَا عَلَيَّ الْحَوْضَ  .","","Al-Mu'jam al-Kabir 2678","","أبو سعيد الخدري عن عطية بن سعد العوفي عن عبد الملك بن أبي سليمان العرزمي عن علي بن مسهر القرشي عن منجاب بن الحارث التميمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2677","2679  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ ،  ثَنَا  صَالِحُ بْنُ أَبِي الْأَسْوَدِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَطِيَّةَ ،  عَنْ  أَبِي سَعِيدٍ ،         [3/66]      رَفَعَهُ  ، قَالَ :  كَأَنِّي قَدْ دُعِيتُ فَأَجَبْتُ فَإِنِّي تَارِكٌ فِيكُمُ  الثَّقَلَيْنِ :  كِتَابَ اللهِ  ،  حَبْلٌ  مَمْدُودٌ بَيْنَ السَّمَاءِ وَالْأَرْضِ ،  وَعِتْرَتِي  أَهْلَ بَيْتِي  ، وَإِنَّهُمَا لَنْ يَفْتَرِقَا حَتَّى يَرِدَا عَلَيَّ الْحَوْضَ ، فَانْظُرُوا كَيْفَ تَخْلُفُونِي فِيهِمَا . ؟","","Al-Mu'jam al-Kabir 2679","","أبو سعيد الخدري عن عطية بن سعد العوفي عن الأعمش عن صالح الحناط عن عبد الرحمن بن صالح العتكي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2678","2680  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  نَصْرُ بْنُ عَبْدِ الرَّحْمَنِ الْوَشَّاءُ ،  ثَنَا  زَيْدُ بْنُ الْحَسَنِ الْأَنْمَاطِيُّ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرٍ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  حَجَّتِهِ يَوْمَ عَرَفَةَ  وَهُوَ عَلَى نَاقَتِهِ  الْقَصْوَاءِ  ، فَخَطَبَ ، فَسَمِعْتُهُ وَهُوَ يَقُولُ :  أَيُّهَا النَّاسُ ، قَدْ تَرَكْتُ فِيكُمْ مَا إِنْ أَخَذْتُمْ بِهِ لَنْ تَضِلُّوا : كِتَابَ اللهِ  وَعِتْرَتِي  أَهْلَ بَيْتِي  .","","Al-Mu'jam al-Kabir 2680","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن زيد بن الحسن الأنماطي عن نصر بن عبد الرحمن الوشاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2679","2681  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  جَعْفَرُ بْنُ حُمَيْدٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ بُكَيْرٍ الْغَنَوِيُّ ،  عَنْ  حَكِيمِ بْنِ جُبَيْرٍ ،  عَنْ  أَبِي الطُّفَيْلِ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنِّي لَكُمْ  فَرَطٌ  ، وَإِنَّكُمْ وَارِدُونَ عَلَيَّ الْحَوْضَ  ، عَرْضُهُ مَا بَيْنَ  صَنْعَاءَ  إِلَى  بُصْرَى  ، فِيهِ عَدَدُ الْكَوَاكِبِ مِنْ قِدْحَانِ الذَّهَبِ وَالْفِضَّةِ ، فَانْظُرُوا كَيْفَ تَخْلُفُونِي فِي  الثَّقَلَيْنِ  ؟ "" فَقَامَ  رَجُلٌ  ، فَقَالَ : يَا رَسُولَ اللهِ وَمَا  الثَّقَلَانِ  ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" الْأَكْبَرُ كِتَابُ اللهِ ، سَبَبٌ طَرَفُهُ بِيَدِ اللهِ ، وَطَرَفُهُ بِأَيْدِيكُمْ ، فَتَمَسَّكُوا بِهِ لَنْ تَزَالُوا ، وَلا تَضِلُّوا ، وَالْأَصْغَرُ  عِتْرَتِي  ، وَإِنَّهُمْ لَنْ يَفْتَرِقَا حَتَّى يَرِدَا عَلَيَّ الْحَوْضَ ، وَسَأَلْتُ لَهُمَا ذَاكَ رَبِّي ، فَلَا تَقَدَّمُوهُمَا فَتَهْلِكُوا ، وَلَا تُعَلِّمُوهُمَا ؛ فَإِنَّهُمَا أَعْلَمُ مِنْكُمْ  .","","Al-Mu'jam al-Kabir 2681","","زيد بن أرقم الأنصاري عن عامر بن واثلة عن حكيم بن جبير الأسدي عن عبد الله بن بكير الغنوي عن جعفر بن حميد زنبقة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2680","2682  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عِرْسٍ الْمِصْرِيُّ  ، ثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْيَمَامِيُّ ،  ثَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَاةَ الْعَصْرِ ، فَلَمَّا كَانَ         [3/67]      فِي الرَّابِعَةِ أَقْبَلَ  الْحَسَنُ  وَالْحُسَيْنُ  حَتَّى رَكِبَا عَلَى ظَهْرِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَضَعَهُمَا بَيْنَ يَدَيْهِ ، وَأَقْبَلَ  الْحُسَيْنُ  ، فَحَمَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْحَسَنَ  عَلَى عَاتِقِهِ الْأَيْمَنِ ،  وَالْحُسَيْنَ  عَلَى عَاتِقِهِ الْأَيْسَرِ ، ثُمَّ قَالَ :  أَيُّهَا النَّاسُ ، أَلَا أُخْبِرُكُمْ بِخَيْرِ النَّاسِ جَدًّا وَجَدَّةً  ؟ أَلَا أُخْبِرُكُمْ بِخَيْرِ النَّاسِ عَمًّا وَعَمَّةً ؟ أَلَا أُخْبِرُكُمْ بِخَيْرِ النَّاسِ خَالًا وَخَالَةً ؟ أَلَا أُخْبِرُكُمْ بِخَيْرِ النَّاسِ أَبًا وَأُمًّا ؟ هُمَا  الْحَسَنُ  وَالْحُسَيْنُ  ، جَدُّهُمَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَجَدَّتُهُمَا  خَدِيجَةُ بِنْتُ خُوَيْلِدٍ  ، وَأُمُّهُمَا  فَاطِمَةُ بِنْتُ رَسُولِ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَبُوهُمَا  عَلِيُّ بْنُ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُ ، وَعَمُّهُمَا  جَعْفَرُ بْنُ أَبِي طَالِبٍ  ، وَعَمَّتُهُمَا  أُمُّ هَانِئٍ بِنْتُ أَبِي طَالِبٍ  ، وَخَالُهُمَا  الْقَاسِمُ ابْنُ رَسُولِ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَخَالَاتُهُمَا  زَيْنَبُ  ،  وَرُقَيَّةُ  ،  وَأُمُّ كُلْثُومٍ  بَنَاتُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، جَدُّهُمَا فِي الْجَنَّةِ ، وَأَبُوهُمَا فِي الْجَنَّةِ ، وَعَمُّهُمَا فِي الْجَنَّةِ ، وَعَمَّتُهُمَا فِي الْجَنَّةِ ، وَخَالَاتُهُمَا فِي الْجَنَّةِ ، وَهُمَا فِي الْجَنَّةِ ، وَمَنْ أَحَبَّهُمَا فِي الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 2682","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن معمر بن راشد عن عبد الرزاق الصنعاني عن أحمد بن محمد بن عمر اليمامي عن محمد بن عبد الله بن عرس عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2681","2683  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ، (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَزَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ، قَالَا :  ثَنَا  نَصْرُ بْنُ عَبْدِ الرَّحْمَنِ الْوَشَّاءُ ،  ثَنَا  زَيْدُ بْنُ الْحَسَنِ الْأَنْمَاطِيُّ ،  ثَنَا  مَعْرُوفُ بْنُ خُرَّبُوذَ ،  عَنْ  أَبِي الطُّفَيْلِ ،  عَنْ  حُذَيْفَةَ بْنِ أَسِيدٍ الْغِفَارِيِّ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَيُّهَا النَّاسُ ، إِنِّي  فَرَطٌ  لَكُمْ ، وَارِدُونَ عَلَيَّ الْحَوْضَ  ، حَوْضٌ أَعْرَضُ مَا بَيْنَ  صَنْعَاءَ  وَبُصْرَى  ، فِيهِ عَدَدُ النُّجُومِ قِدْحَانٌ مِنْ فِضَّةٍ ، وَإِنِّي سَائِلُكُمْ حِينَ تَرِدُونَ عَلَيَّ عَنِ  الثَّقَلَيْنِ  ، فَانْظُرُوا كَيْفَ تَخْلُفُونِي فِيهِمَا ؟ السَّبَبُ الْأَكْبَرُ كِتَابُ اللهِ عَزَّ وَجَلَّ ، سَبَبٌ طَرَفُهُ بِيَدِ اللهِ ، وَطَرَفُهُ بِأَيْدِيكُمْ ، فَاسْتَمْسِكُوا بِهِ ، وَلَا تَضِلُّوا وَلَا تُبَدِّلُوا ،  وَعِتْرَتِي  أَهْلُ بَيْتِي  ، فَإِنَّهُ قَدْ نَبَّأَنِيَ اللَّطِيفُ الْخَبِيرُ أَنَّهُمَا لَنْ يَنْقَضِيَا حَتَّى يَرِدَا عَلَيَّ الْحَوْضَ  .","","Al-Mu'jam al-Kabir 2683","","حذيفة بن أسيد الغفاري عن عامر بن واثلة عن معروف بن خربوذ عن زيد بن الحسن الأنماطي عن نصر بن عبد الرحمن الوشاء عن الساجي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2682","2684  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مُحَمَّدِ بْنِ         [3/68]      جُحَادَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي السَّوَّارِ الضُّبَعِيِّ  ، عَنِ  الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  رُفِعَ الْكِتَابُ ، وَجَفَّ الْقَلَمُ ، وَأُمُورٌ يُقْضَى فِي كِتَابٍ قَدْ خَلَا  "" .","","Al-Mu'jam al-Kabir 2684","","الحسن بن علي سبط رسول الله عن أبو السوار العدوي عن قتادة بن دعامة عن محمد بن جحادة الأودي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2683","2685  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَلِيِّ بْنِ الْحَسَنِ ،  عَنْ  جَدَّتِهِ  أَنَّ  الْحَسَنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ كَانَ  يَعْزِلُ  عَنْهَا  ، وَكَانَتْ سُرِّيَّتَهُ  "" .","","Al-Mu'jam al-Kabir 2685","","الحسن بن علي سبط رسول الله عن جدته عن علي بن الحسن عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2684","2686  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  جَحْشٍ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  أَنَّهُ سُئِلَ عَنِ الْجُبْنِ  ، فَقَالَ : "" ضَعِ  السِّكِّينَ  ، وَسَمِّ وَكُلْ "" .","","Al-Mu'jam al-Kabir 2686","","الحسن بن علي سبط رسول الله عن معاوية بن قرة عن جحش بن زياد الضبي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2685","2687  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو النُّعَيْمِ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَمَّارٍ الدُّهْنِيِّ ،  عَنْ  أَبِي شُعْبَةَ ، قَالَ :  رَأَيْتُ  الْحَسَنَ وَالْحُسَيْنَ رَضِيَ اللهُ عَنْهُمَا طَافَا بَعْدَ الْعَصْرِ  وَصَلَّيَا رَكْعَتَيْنِ  "" .","","Al-Mu'jam al-Kabir 2687","","الحسين بن علي عن أبو شعبة الأشجعي عن عمار بن معاوية الدهني عن سفيان بن عيينة عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2686","2688  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَلِيُّ بْنُ الْمُنْذِرِ الطَّرِيقِيُّ ،  ثَنَا  عُثْمَانُ بْنُ سَعِيدٍ الزَّيَّاتُ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ أَبُو رَجَاءٍ الْحَبَطِيُّ التُّسْتَرِيُّ ،  ثَنَا  شُعْبَةُ بْنُ الْحَجَّاجِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْحَارِثِ  أَنَّ  عَلِيًّا رَضِيَ اللهُ عَنْهُ سَأَلَ ابْنَهُ الْحَسَنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ عَنْ أَشْيَاءَ مِنْ أَمْرِ الْمُرُوءَةِ ، فَقَالَ :  يَا بُنَيَّ ، مَا  السَّدَادُ  ؟ قَالَ : يَا أَبَهْ ،  السَّدَادُ  دَفْعُ الْمُنْكَرِ بِالْمَعْرُوفِ  . قَالَ : فَمَا الشَّرَفُ ؟ قَالَ : اصْطِنَاعُ الْعَشِيرَةِ ، وَحَمْلُ  الْجَرِيرَةِ  ، وَمُوافَقَةُ الْإِخْوَانِ ، وَحِفْظُ الْجِيرَانِ . قَالَ : فَمَا الْمُرُوءَةُ ؟ قَالَ : الْعَفَافُ ، وَإِصْلَاحُ الْمَالِ . قَالَ : فَمَا الدِّقَّةُ ؟ قَالَ : النَّظَرُ فِي الْيَسِيرِ ، وَمَنْعُ الْحَقِيرِ . قَالَ : فَمَا اللَّوْمُ ؟ قَالَ : إِحْرَازُ الْمَرْءِ نَفْسَهُ ، وَبَذْلُهُ  عُرْسَهُ  . قَالَ : فَمَا السَّمَاحَةُ ؟ قَالَ : الْبَذْلُ مِنَ الْعَسِيرِ وَالْيَسِيرِ . قَالَ : فَمَا  الشُّحُّ  ؟ قَالَ : أَنْ تَرَى مَا أَنْفَقْتَهُ تَلَفًا . قَالَ : فَمَا الْإِخَاءُ ؟ قَالَ : الْمُوَاسَاةُ فِي         [3/69]      الشِّدَّةِ وَالرَّخَاءِ . قَالَ : فَمَا الْجُبْنُ ؟ قَالَ : الْجُرْأَةُ عَلَى الصَّدِيقِ ، وَالنُّكُولُ عَنِ الْعَدُوِّ . قَالَ : فَمَا الْغَنِيمَةُ ؟ قَالَ : الرَّغْبَةُ فِي التَّقْوَى ، وَالزَّهَادَةُ فِي الدُّنْيَا هِيَ  الْغَنِيمَةُ  الْبَارِدَةُ . قَالَ : فَمَا الْحِلْمُ ؟ قَالَ :  كَظْمُ  الْغَيْظِ ، وَمِلْكُ النَّفْسِ . قَالَ : فَمَا الْغِنَى ؟ قَالَ : رِضَى النَّفْسِ بِمَا قَسَمَ اللهُ تَعَالَى لَهَا وَإِنْ قَلَّ ، وَإِنَّمَا الْغِنَى غِنَى النَّفْسِ . قَالَ : فَمَا الْفَقْرُ ؟ قَالَ : شَرَهُ النَّفْسِ فِي كُلِّ شَيْءٍ . قَالَ : فَمَا الْمَنَعَةُ ؟ قَالَ : شِدَّةُ الْبَأْسِ ، وَمُنَازَعَةُ أَعِزَّاءِ النَّاسِ . قَالَ : فَمَا الذُّلُّ ؟ قَالَ : الْفَزَعُ عِنْدَ الْمَصْدُوقَةِ . قَالَ : فَمَا الْعِيُّ ؟ قَالَ : الْعَبَثُ بِاللِّحْيَةِ ، وَكَثْرَةُ الْبَزْقِ عِنْدَ الْمُخَاطَبَةِ . قَالَ : فَمَا الْجُرْأَةُ ؟ قَالَ : مُوَافَقَةُ الْأَقْرَانِ . قَالَ : فَمَا الْكُلْفَةُ ؟ قَالَ : كَلَامُكَ فِيمَا لَا يَعْنِيكَ . قَالَ : فَمَا الْمَجْدُ ؟ قَالَ : أَنْ تُعْطِيَ فِي الْغُرْمِ ، وَتَعْفُوَ عَنِ  الْجُرْمِ  . قَالَ : فَمَا الْعَقْلُ ؟ قَالَ : حِفْظُ الْقَلْبِ كُلَّمَا اسْتَوْعَيْتَهُ . قَالَ : فَمَا الْخُرْقُ ؟ قَالَ : مُعَازَتُكَ إِمَامَكَ ، وَرَفْعُكَ عَلَيْهِ كَلَامَكَ . قَالَ : فَمَا حُسْنُ الثَّنَاءِ ؟ قَالَ : إِتْيَانُ الْجَمِيلِ وَتَرْكُ الْقَبِيحِ . قَالَ : فَمَا  الْحَزْمُ  ؟ قَالَ : طُولُ الْأَنَاةِ ، وَالرِّفْقُ بِالْوُلَاةِ . قَالَ : فَمَا السَّفَهُ ؟ قَالَ : اتِّبَاعُ الدَّنَاءَةِ ، وَمُصَاحَبَةُ الْغُوَاةِ . قَالَ : فَمَا الْغَفْلَةُ ؟ قَالَ : تَرْكُكَ الْمَسْجِدَ ، وَطَاعَتُكَ الْمُفْسِدَ . قَالَ : فَمَا الْحِرْمَانُ ؟ قَالَ : تَرْكُكَ حَظَّكَ وَقَدْ عُرِضَ عَلَيْكَ . قَالَ : فَمَا الْمُفْسِدُ ؟ قَالَ : الْأَحْمَقُ فِي مَالِهِ ، الْمُتَهَاوِنُ فِي عِرْضِهِ . ثُمَّ قَالَ عَلِيٌّ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا فَقْرَ أَشَدُّ مِنَ الْجَهْلِ ، وَلَا مَالَ أَعْوَدُ مِنَ الْعَقْلِ  ، وَلَا وَحْدَةَ أَوْحَشُ مِنَ الْعُجْبِ ، وَلَا اسْتِظْهَارَ أَوْفَقُ مِنَ الْمُشَاوَرَةِ ، وَلَا عَقْلَ كَالتَّدْبِيرِ ، وَلَا حَسَبَ كَحُسْنِ  الْخُلُقِ  ، وَلَا  وَرَعَ  كَالْكَفِّ ، وَلَا عِبَادَةَ كَالتَّفَكُّرِ ، وَلَا إِيمَانَ كَالْحَيَاءِ وَالصَّبْرِ ، وَآفَةُ الْحَدِيثِ الْكَذِبُ ، وَآفَةُ الْعِلْمِ النِّسْيَانُ ، وَآفَةُ الْحِلْمِ السَّفَهُ ، وَآفَةُ الْعِبَادَةِ الْفَتْرَةُ ، وَآفَةُ الظَّرْفِ  الصَّلَفُ ،  وَآفَةُ الشَّجَاعَةِ الْبَغْيُ ، وَآفَةُ السَّمَاحَةِ الْمَنُّ ، وَآفَةُ الْجَمَالِ  الْخُيَلَاءُ  ، وَآفَةُ  الْحَسَبِ  الْفَخْرُ "" . يَا بُنَيَّ ، لَا تَسْتَخِفَّنَّ بِرَجُلٍ تَرَاهُ أَبَدًا ، فَإِنْ كَانَ خَيْرًا مِنْكَ فَاحْسَبْ أَنَّهُ أَبُوكَ ، وَإِنْ كَانَ مِثْلَكَ فَهُوَ أَخُوكَ ، وَإِنْ كَانَ أَصْغَرَ مِنْكَ فَاحْسَبْ أَنَّهُ ابْنُكَ .  قَالَ أَبُو الْقَاسِمِ :  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  شُعْبَةَ  إِلَّا  مُحَمَّدُ بْنُ عَبْدِ اللهِ         [3/70]      أَبُو رَجَاءٍ الْحَبَطِيُّ  ،  تَفَرَّدَ بِهِ  عُثْمَانُ بْنُ سَعِيدٍ الزَّيَّاتُ  ، وَلَا يُرْوَى عَنْ  عَلِيٍّ  رَضِيَ اللهُ عَنْهُ إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Al-Mu'jam al-Kabir 2688","","الحسن بن علي سبط رسول الله عن علي بن أبي طالب عن الحارث الأعور عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن محمد بن عبد الله الحبطي عن عثمان بن سعيد الزيات عن علي بن المنذر العلاف عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2687","2689  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، حَدَّثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  نُسَيْرِ بْنِ ذُعْلُوقٍ ،  عَنْ  مُسْلِمِ بْنِ عِيَاضٍ ، قَالَ :  سَأَلْتُ  الْحَسَنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ عَنْ رَكْعَتَيِ الْجُمُعَةِ  ، فَقَالَ : "" هُمَا قَاضِيَتَانِ عَمَّا سِوَاهُمَا "" .","","Al-Mu'jam al-Kabir 2689","","الحسن بن علي سبط رسول الله عن مسلم بن عياض الكوفي عن نسير بن ذعلوق الثوري عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2688","2690  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ، قَالَ :  كَانَ  زِيَادٌ  يَتَتَبَّعُ شِيعَةَ  عَلِيٍّ  رَضِيَ اللهُ عَنْهُ فَيَقْتُلُهُمْ  ، فَبَلَغَ ذَلِكَ الْحَسَنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ ،  فَقَالَ  : "" اللَّهُمَّ تَفَرَّدْ بِمَوْتِهِ ؛ فَإِنَّ الْقَتْلَ كَفَّارَةٌ ""  .","","Al-Mu'jam al-Kabir 2690","","الحسن بن علي سبط رسول الله عن الحسن البصري عن يونس بن عبيد عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2689","2691  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْحَكَمِ بْنِ أَبِي زِيَادٍ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  سُفْيَانَ بْنِ عُيَيْنَةَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ الْأَصَمِّ ،  عَنْ  عَمِّهِ يَزِيدَ بْنِ الْأَصَمِّ ، قَالَ :  خَرَجْتُ مَعَ الْحَسَنِ ،  وَجَارِيَةٌ  تَحُتُّ شَيْئًا مِنَ الْحِنَّاءِ عَنْ أَظْفَارِهِ ، فَجَاءَتْهُ إِضْبَارَةٌ مِنْ كُتُبٍ ،  فَقَالَ  :  يَا جَارِيَةُ هَاتِ  الْمِخْضَبَ  . فَصَبَّ فِيهِ مَاءً ، وَأَلْقَى الْكُتُبَ فِي الْمَاءِ ، فَلَمْ يَفْتَحْ مِنْهَا شَيْئًا  ، وَلَمْ يَنْظُرْ إِلَيْهِ ، فَقُلْتُ : يَا  أَبَا مُحَمَّدٍ  ، مِمَّنْ هَذِهِ الْكُتُبُ ؟ قَالَ : "" مِنْ  أَهْلِ الْعِرَاقِ  ، مِنْ قَوْمٍ لَا يَرْجِعُونَ إِلَى حَقٍّ ، وَلَا يُقْصِرُونَ عَنْ بَاطِلٍ ، أَمَا إِنِّي لَسْتُ أَخْشَاهُمْ عَلَى نَفْسِي ، وَلَكِنِّي أَخْشَاهُمْ عَلَى ذَلِكَ . وَأَشَارَ إِلَى  الْحُسَيْنِ  "" .","","Al-Mu'jam al-Kabir 2691","","الحسن بن علي سبط رسول الله عن يزيد بن الأصم بن عبيد البكائي عن عبيد الله بن عبد الله بن الأصم العامري عن سفيان بن عيينة عن حماد بن أسامة القرشي عن عبد الله بن الحكم القطواني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2690","2692  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  سُفْيَانَ بْنِ عُيَيْنَةَ ،  عَنْ  رَقَبَةَ بْنِ مَصْقَلَةَ ، قَالَ :  لَمَّا حُضِرَ الْحَسَنُ بْنُ عَلِيٍّ رَضِيَ اللهُ عَنْهُ  قَالَ  : أَخْرِجُونِي إِلَى الصَّحْرَاءِ لَعَلِيِّ أَنْظُرُ فِي مَلَكُوتِ السَّمَاوَاتِ .  يَعْنِي الْآيَاتِ  ، فَلَمَّا أُخْرِجَ بِهِ قَالَ :  اللَّهُمَّ إِنِّي أَحْتَسِبُ نَفْسِي عِنْدَكَ ، فَإِنَّهَا أَعَزُّ الْأَنْفُسِ عَلَيَّ  . وَكَانَ مِمَّا صَنَعَ اللهُ لَهُ أَنَّهُ  احْتَسَبَ  نَفْسَهُ  ""  .","","Al-Mu'jam al-Kabir 2692","","الحسن بن علي سبط رسول الله عن رقبة بن مصقلة عن سفيان بن عيينة عن حماد بن أسامة القرشي عن عثمان ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2691","[3/71]      2693  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَبْدِ اللهِ بْنِ نُمَيْرٍ  يَقُولُ : ""  تُوُفِّيَ  الْحَسَنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ وَهُوَ ابْنُ سَبْعٍ وَأَرْبَعِينَ  ""  .","","Al-Mu'jam al-Kabir 2693","","","بقية أخبار الحسن بن علي رضي الله عنهما"
"2692","2694  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي بَكْرِ بْنِ حَفْصٍ  أَنَّ  سَعْدًا وَالْحَسَنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُمَا مَاتَا فِي زَمَنِ  مُعَاوِيَةَ  رَضِيَ اللهُ عَنْهُ ، فَيَرَوْنَ أَنَّهُ سَمَّهُ  ""  .","","Al-Mu'jam al-Kabir 2694","","الحسن بن علي سبط رسول الله عن عبد الله بن حفص بن عمر بن سعد بن أبي وقاص عن شعبة بن الحجاج عن يحيى بن أبي بكير عن محمد بن عبد الله بن نمير عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2693","2695  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَبْدِ اللهِ بْنِ نُمَيْرٍ  يَقُولُ : ""  تُوُفِّيَ  الْحَسَنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ سَنَةَ تِسْعٍ وَأَرْبَعِينَ  فِي شَهْرِ رَبِيعٍ الْأَوَّلِ  ""  .","","Al-Mu'jam al-Kabir 2695","","","بقية أخبار الحسن بن علي رضي الله عنهما"
"2694","2696  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ الْمِصْرِيُّ  ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  ، قَالَ : ""  تُوُفِّيَ  الْحَسَنُ بْنُ عَلِيِّ بْنِ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُ سَنَةَ تِسْعٍ وَأَرْبَعِينَ  ، وَصَلَّى عَلَيْهِ  سَعِيدُ بْنُ الْعَاصِ  ، وَكَانَ مَوْتُهُ  بِالْمَدِينَةِ  وَسِنُّهُ  سِتٌّ أَوْ سَبْعٌ  وَأَرْبَعُونَ  "" .","","Al-Mu'jam al-Kabir 2696","","","بقية أخبار الحسن بن علي رضي الله عنهما"
"2695","2697  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مَنْصُورٍ الطُّوسِيُّ ،  ثَنَا  أَبُو أَحْمَدَ الزُّبَيْرِيُّ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ عَدَوِيَّةَ ،  حَدَّثَنِي  شُرَحْبِيلُ ، قَالَ :  كُنْتُ مَعَ  الْحُسَيْنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ وَأُخْرِجَ بِسَرِيرِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ ، وَأَرَادَ أَنْ يَدْفِنَهُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَخَافَ أَنْ يَمْنَعَهُ  بَنُو أُمَيَّةَ  ، فَلَمَّا انْتَهَوْا بِهِ إِلَى الْمَسْجِدِ قَامَتْ  بَنُو أُمَيَّةَ  ، فَقَامَ عَبْدُ اللهِ بْنُ جَعْفَرٍ ،  فَقَالَ  : إِنِّي سَمِعْتُهُ يَقُولُ :  إِنْ مَنَعُوكُمْ فَادْفِنُونِي مَعَ أُمِّي  "" .","","Al-Mu'jam al-Kabir 2697","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن شرحبيل بن سعد الخطمي عن عبد الرحيم بن عدوية عن محمد بن عبد الله بن الزبير عن محمد بن منصور الطوسي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2696","2698  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ بُنْدَارٌ ،  ثَنَا         [3/72]      عَبْدُ الْمَلِكِ بْنُ الصَّبَّاحِ الْمِسْمَعِيُّ ،  ثَنَا  عِمْرَانُ بْنُ حُدَيْرٍ ،  أَظُنُّهُ  عَنْ  أَبِي مِجْلَزٍ  ، قَالَ : قَالَ  عَمْرُو بْنُ الْعَاصِ  وَالْمُغِيرَةُ بْنُ شُعْبَةَ  لِمُعَاوِيَةَ  :  إِنَّ الْحَسَنَ بْنَ عَلِيٍّ عَيِيُّ ، وَإِنَّ لَهُ كَلَامًا وَرَأَيًا ، وَإِنَّهُ قَدْ عَلِمْنَا كَلَامَهُ ، فَيَتَكَلَّمُ كَلَامًا فَلَا يَجِدُ كَلَامًا . فَقَالَ : لَا تَفْعَلُوا . فَأَبَوْا عَلَيْهِ ، فَصَعِدَ  عَمْرٌو  الْمِنْبَرَ ، فَذَكَرَ  عَلِيًّا  وَوَقَعَ فِيهِ ، ثُمَّ صَعِدَ  الْمُغِيرَةُ بْنُ شُعْبَةَ  ، فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ، ثُمَّ وَقَعَ فِي  عَلِيٍّ  رَضِيَ اللهُ عَنْهُ ، ثُمَّ قِيلَ  لِلْحَسَنِ بْنِ عَلِيٍّ  : اصْعَدْ ، فَقَالَ :  لَا أَصْعَدُ وَلَا أَتَكَلَّمُ حَتَّى تُعْطُونِي إِنْ قُلْتُ حَقًّا أَنْ تُصَدِّقُونِي  ، وَإِنْ قُلْتُ بَاطِلًا أَنْ تُكَذِّبُونِي . فَأَعْطَوْهُ ، فَصَعِدَ الْمِنْبَرَ ، فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ، فَقَالَ : بِاللهِ يَا عَمْرُو وَأَنْتَ يَا مُغِيرَةُ تَعْلَمَانِ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَعَنَ اللهُ السَّائِقَ وَالرَّاكِبَ  أَحَدُهُمَا  فُلَانٌ  ؟ قَالَا : اللَّهُمَّ نَعَمْ بَلَى . قَالَ :  أَنْشُدُكَ  اللهَ يَا مُعَاوِيَةُ وَيَا مُغِيرَةُ أَتَعْلَمَانِ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَعَنَ  عَمْرًا  بِكُلِّ قَافِيَةٍ قَالَهَا لَعْنَةً ؟ قَالَا : اللَّهُمَّ بَلَى . قَالَ :  أَنْشُدُكَ  اللهَ يَا عَمْرُو وَأَنْتَ يَا مُعَاوِيَةُ بْنَ أَبِي سُفْيَانَ ، أَتَعْلَمَانِ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَعَنَ قَوْمَ هَذَا ؟ قَالَا : بَلَى . قَالَ  الْحَسَنُ  : فَإِنِّي أَحْمَدُ اللهَ الَّذِي وَقَعْتُمْ فِيمَنْ تَبَرَّأَ مِنْ هَذَا  . وَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 2698","","معاوية بن أبي سفيان عن لاحق بن حميد عن عمران بن حدير عن عبد الملك بن الصباح المسمعي عن محمد بن بشار بندار عن زكريا بن يحيى السجزي عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2697","2699  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَوْنٍ السِّيرَافِيُّ ،  ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْوَاسِطِيُّ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  حَرِيزُ بْنُ عُثْمَانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي عَوْفٍ ، قَالَ :  قَالَ  عَمْرُو بْنُ الْعَاصِ  وَأَبُو الْأَعْوَرِ السُّلَمِيُّ  لِمُعَاوِيَةَ  : إِنَّ  الْحَسَنَ بْنَ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا رَجُلٌ عَيِيٌّ . فَقَالَ مُعَاوِيَةُ رَضِيَ اللهُ عَنْهُ : لَا تَقُولَا ذَلِكَ ؛  فَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ  تَفَلَ  فِي فِيهِ  ، وَمَنْ  تَفَلَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي فِيهِ فَلَيْسَ بِعَيِيٍّ . فَقَالَ الْحَسَنُ بْنُ عَلِيٍّ رَضِيَ اللهُ عَنْهُ : "" أَمَّا أَنْتَ يَا  عَمْرُو  فَإِنَّهُ تَنَازَعَ فِيكَ رَجُلَانِ ، فَانْظُرْ أَيُّهُمَا أَبُوكَ ، وَأَمَّا أَنْتَ يَا  أَبَا الْأَعْوَرِ  فَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَعَنَ  رِعْلًا  وَذَكْوَانَ  وَعَمْرَو بْنَ سُفْيَانَ  .","","Al-Mu'jam al-Kabir 2699","","الحسن بن علي سبط رسول الله عن عبد الرحمن بن أبي عوف الجرشي عن حريز بن عثمان الرحبي عن يزيد بن هارون عن الحسن بن علي بن راشد الواسطي عن محمد بن عون بن داود مشليق عن الطبراني","بقية أخبار الحسن بن علي رضي الله عنهما"
"2698","[3/73]      وَمَا  أَسْنَدَ  الْحَسَنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا  عَائِشَةُ  عَنِ  الْحَسَنِ  رَضِيَ اللهُ عَنْهُمَا  2700  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدِ بْنِ بَشِيرٍ الرَّازِيُّ ،  ثَنَا  الْحَسَنُ بْنُ دَاوُدَ الْمُنْكَدِرِيُّ ، (  ح  ) .  وَحَدَّثَنَا  الْحَسَنُ بْنُ عَلِيِّ بْنِ شَهْرَيَارَ الْبَغْدَادِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَبْدِ اللهِ بْنِ زُرَارَةَ الرَّقِّيُّ ، قَالَا :  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  حَدَّثَنِي  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ بْنِ عُقْبَةَ ،  عَنْ  عَمِّهِ مُوسَى بْنِ عُقْبَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا قَالَتْ :  أَخْبَرَنِي  الْحَسَنُ بْنُ عَلِيٍّ رَضِيَ اللهُ عَنْهُ ، قَالَ :  عَلَّمَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ دُعَاءَ  الْقُنُوتِ  فِي  الْوِتْرِ  :  اللَّهُمَّ اهْدِنَا فِيمَنْ هَدَيْتَ ، وَعَافِنَا فِيمَنْ عَافَيْتَ  ، وَتَوَلَّنَا فِيمَنْ تَوَلَّيْتَ ، وَبَارِكْ لَنَا فِيمَا أَعْطَيْتَ ، وَقِنَا شَرَّ مَا قَضَيْتَ ؛ إِنَّكَ تَقْضِي وَلَا يُقْضَى عَلَيْكَ ، وَإِنَّهُ لَا يَذِلُّ مَنْ وَالَيْتَ ، تَبَارَكْتَ وَتَعَالَيْتَ  .","","Al-Mu'jam al-Kabir 2700","","الحسن بن علي سبط رسول الله عن عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن موسى بن عقبة عن إسماعيل بن إبراهيم بن عقبة الأسدي عن محمد بن إسماعيل بن مسلم الديلي عن إسماعيل بن عبد الله بن زرارة الثغري عن الحسن بن علي ابن شهريار الرقي عن الطبراني","عائشة عن الحسن رضي الله عنهما"
"2699","أَبُو الْحَوْرَاءِ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  2701  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ بْنِ وَاضِحٍ الْعَسَّالُ الْمِصْرِيُّ ،  حَدَّثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  بُرَيْدِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  أَبِي الْحَوْرَاءِ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  عَلَّمَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ أَقُولَ فِي  الْوِتْرِ  :  اللَّهُمَّ اهْدِنِي فِيمَنْ هَدَيْتَ ، وَعَافِنِي فِيمَنْ عَافَيْتَ  ، وَتَوَلَّنِي فِيمَنْ تَوَلَّيْتَ ، وَبَارِكْ لِي فِيمَا أَعْطَيْتَ ، وَقِنِي شَرَّ مَا قَضَيْتَ ؛ إِنَّكَ تَقْضِي وَلَا يُقْضَى عَلَيْكَ ، إِنَّهُ لَا يَذِلُّ مَنْ وَالَيْتَ ، وَلَا يَعِزُّ مَنْ عَادَيْتَ ، تَبَارَكْتَ وَتَعَالَيْتَ  .","","Al-Mu'jam al-Kabir 2701","","الحسن بن علي سبط رسول الله عن ربيعة بن شيبان السعدي عن بريد بن أبي مريم السلولي عن أبو إسحاق السبيعي عن موسى بن عقبة عن محمد بن جعفر بن أبي كثير الزرقي عن سعيد بن الحكم الجمحي عن أحمد بن إسحاق العسال عن الطبراني","أبو الحوراء عن الحسن بن علي رضي الله عنه"
"2700","2702  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  الْحَكَمُ بْنُ مَرْوَانَ ،  ثَنَا  إِسْرَائِيلُ ،         [3/74]      عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  بُرَيْدِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  أَبِي الْحَوْرَاءِ ،  قَالَ  :  قِيلَ لِلْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُمَا : أَيَّ شَيْءٍ حَفِظْتَ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : مَا حَفِظْتُ مِنْهُ إِلَّا كَلِمَاتٍ أَقُولُهُنَّ فِي  الْوِتْرِ  :  اللَّهُمَّ اهْدِنِي فِيمَنْ هَدَيْتَ ، وَعَافِنِي فِيمَنْ عَافَيْتَ  ، وَتَوَلَّنِي فِيمَنْ تَوَلَّيْتَ ، وَبَارِكْ لِي فِيمَا أَعْطَيْتَ ، وَقِنِي شَرَّ مَا قَضَيْتَ ؛ إِنَّكَ تَقْضِي وَلَا يُقْضَى عَلَيْكَ ، تَبَارَكْتَ رَبَّنَا وَتَعَالَيْتَ  .","","Al-Mu'jam al-Kabir 2702","","الحسن بن علي سبط رسول الله عن ربيعة بن شيبان السعدي عن بريد بن أبي مريم السلولي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن الحكم بن مروان الكوفي عن أبو مسلم الكجي عن الطبراني","أبو الحوراء عن الحسن بن علي رضي الله عنه"
"2701","2703  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  عَلِيُّ بْنُ حَكِيمٍ الْأَوْدِيُّ ، (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَيَحْيَى الْحِمَّانِيُّ ، قَالُوا :  ثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  بُرَيْدِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  أَبِي الْحَوْرَاءِ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  عَلَّمَنِي جَدِّي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَلِمَاتٍ أَقُولُهُنَّ فِي  الْوِتْرِ  :  اللَّهُمَّ اهْدِنِي فِيمَنْ هَدَيْتَ ، وَعَافِنِي فِيمَنْ عَافَيْتَ  ، وَبَارِكْ لِي فِيمَا أَعْطَيْتَ ، وَقِنِي شَرَّ مَا قَضَيْتَ ؛ إِنَّكَ تَقْضِي وَلَا يُقْضَى عَلَيْكَ ، إِنَّهُ لَا يَذِلُّ مَنْ وَالَيْتَ ، وَلَا يَعِزُّ مَنْ عَادَيْتَ ، تَبَارَكْتَ رَبَّنَا وَتَعَالَيْتَ  .","","Al-Mu'jam al-Kabir 2703","","الحسن بن علي سبط رسول الله عن ربيعة بن شيبان السعدي عن بريد بن أبي مريم السلولي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","أبو الحوراء عن الحسن بن علي رضي الله عنه"
"2702","2704  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  حَدَّثَنَا  زُهَيْرٌ ،  ثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  بُرَيْدٍ ،  عَنْ  أَبِي مَرْيَمَ  ،  عَنْ  أَبِي الْحَوْرَاءِ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ تَعَالَى عَنْهُ قَالَ :  عَلَّمَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اللَّهُمَّ اهْدِنِي فِيمَنْ هَدَيْتَ ، وَعَافِنِي فِيمَنْ عَافَيْتَ  ، وَتَوَلَّنِي فِيمَنْ تَوَلَّيْتَ ، وَقِنِي شَرَّ مَا قَضَيْتَ ؛ إِنَّكَ تَقْضِي وَلَا يُقْضَى عَلَيْكَ ، لَا يَذِلُّ مَنْ وَالَيْتَ ، وَلَا يَعِزُّ مَنْ عَادَيْتَ تَبَارَكْتَ وَتَعَالَيْتَ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( بريد بن أبي مريم )","","Al-Mu'jam al-Kabir 2704","","الحسن بن علي سبط رسول الله عن ربيعة بن شيبان السعدي عن أبو مريم عن بريد بن أبي مريم السلولي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","أبو الحوراء عن الحسن بن علي رضي الله عنه"
"2703","2705  -  حَدَّثَنَا  الْحَسَنُ بْنُ الْمُتَوَكِّلِ الْبَغْدَادِيُّ ،  ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  بُرَيْدِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  أَبِي الْحَوْرَاءِ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  عَلَّمَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَلِمَاتٍ أَقُولُهُنَّ فِي         [3/75]      قُنُوتِ  الْوِتْرِ  :  اللَّهُمَّ اهْدِنِي فِيمَنْ هَدَيْتَ  ، وَعَافِنِي فِيمَنْ عَافَيْتَ ، وَتَوَلَّنِي فِيمَنْ تَوَلَّيْتَ ، وَبَارِكْ لِي فِيمَا أَعْطَيْتَ ، وَقِنِي شَرَّ مَا قَضَيْتَ ؛ إِنَّكَ تَقْضِي وَلَا يُقْضَى عَلَيْكَ ، إِنَّهُ لَا يَذِلُّ مَنْ وَالَيْتَ ، وَلَا يَعِزُّ مَنْ عَادَيْتَ ، تَبَارَكْتَ رَبَّنَا وَتَعَالَيْتَ  .","","Al-Mu'jam al-Kabir 2705","","الحسن بن علي سبط رسول الله عن ربيعة بن شيبان السعدي عن بريد بن أبي مريم السلولي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن عفان بن مسلم الصفار عن الحسن بن علي بن المتوكل البغدادي عن الطبراني","أبو الحوراء عن الحسن بن علي رضي الله عنه"
"2704","2706  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ الطَّبَرَانِيُّ ،  ثَنَا  أَبُو صَالِحٍ الْفَرَّاءُ ،  ثَنَا  أَبُو إِسْحَاقَ الْفَزَارِيُّ ،  عَنْ  سُفْيَانَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  بُرَيْدِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  أَبِي الْحَوْرَاءِ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  عَلَّمَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ أَقُولَ هَؤُلَاءِ الْكَلِمَاتِ فِي  الْوِتْرِ  :  اللَّهُمَّ اهْدِنِي فِيمَنْ هَدَيْتَ ، وَعَافِنِي فِيمَنْ عَافَيْتَ  ، وَتَوَلَّنِي فِيمَنْ تَوَلَّيْتَ ، وَبَارِكْ لِي فِيمَا أَعْطَيْتَ ، وَقِنِي شَرَّ مَا قَضَيْتَ ؛ إِنَّكَ تَقْضِي وَلَا يُقْضَى عَلَيْكَ ، وَلَا يَذِلُّ مَنْ وَالَيْتَ ، تَبَارَكْتَ رَبَّنَا وَتَعَالَيْتَ  .","","Al-Mu'jam al-Kabir 2706","","الحسن بن علي سبط رسول الله عن ربيعة بن شيبان السعدي عن بريد بن أبي مريم السلولي عن أبو إسحاق السبيعي عن سفيان الثوري عن أبو إسحاق الفزاري عن محبوب بن موسى الفراء عن هاشم بن مرثد الطيالسي عن الطبراني","أبو الحوراء عن الحسن بن علي رضي الله عنه"
"2705","2707  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ ،  حَدَّثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  بُرَيْدِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  أَبِي الْحَوْرَاءِ ، قَالَ :  سَمِعْتُ  الْحَسَنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ يَقُولُ :  عَلَّمَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ أَقُولَ فِي  الْوِتْرِ  :  اللَّهُمَّ اهْدِنِي فِيمَنْ هَدَيْتَ ، وَتَوَلَّنِي فِيمَنْ تَوَلَّيْتَ  ، وَعَافِنِي فِيمَنْ عَافَيْتَ ، وَبَارِكْ لِي فِيمَا أَعْطَيْتَ ، وَقِنِي شَرَّ مَا قَضَيْتَ ؛ إِنَّكَ تَقْضِي وَلَا يُقْضَى عَلَيْكَ ، إِنَّهُ لَا يَذِلُّ مَنْ وَالَيْتَ ، وَلَا يَعِزُّ مَنْ عَادَيْتَ ، تَبَارَكْتَ وَتَعَالَيْتَ  .","","Al-Mu'jam al-Kabir 2707","","الحسن بن علي سبط رسول الله عن ربيعة بن شيبان السعدي عن بريد بن أبي مريم السلولي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن محمد بن محمد بن حيان التمار عن الطبراني","أبو الحوراء عن الحسن بن علي رضي الله عنه"
"2706","2708  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ الطَّبَرَانِيُّ ،  ثَنَا  أَبُو صَالِحٍ الْفَرَّاءُ ،  ثَنَا  أَبُو إِسْحَاقَ الْفَزَارِيُّ ،  عَنِ  الْحَسَنِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  بُرَيْدِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  أَبِي الْحَوْرَاءِ ، قَالَ :  قُلْتُ لِلْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُمَا : مِثْلُ مَنْ كُنْتَ فِي عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ وَمَا عَقَلْتَ عَنْهُ ؟ قَالَ : عَقَلْتُ عَنْهُ أَنِّي سَمِعْتُهُ يَقُولُ :  دَعْ مَا  يَرِيبُكَ  إِلَى مَا لَا  يَرِيبُكَ  ، فَإِنَّ الشَّرَّ رِيبَةٌ ، وَالْخَيْرَ طُمَأْنِينَةٌ "" ، وَعَقَلْتُ عَنْهُ الصَّلَوَاتِ الْخَمْسَ ، وَكَلِمَاتٍ أَقُولُهُنَّ عِنْدَ انْقِضَائِهِنَّ ، قَالَ : "" قُلِ :  اللَّهُمَّ         [3/76]      اهْدِنِي فِيمَنْ هَدَيْتَ ، وَعَافِنِي فِيمَنْ عَافَيْتَ  ، وَتَوَلَّنِي فِيمَنْ تَوَلَّيْتَ ، وَبَارِكْ لِي فِيمَا أَعْطَيْتَ ، وَقِنِي شَرَّ مَا قَضَيْتَ ؛ إِنَّكَ تَقْضِي وَلَا يُقْضَى عَلَيْكَ ، إِنَّهُ لَا يَذِلُّ مَنْ وَالَيْتَ ، تَبَارَكْتَ رَبَّنَا وَتَعَالَيْتَ  .  قَالَ  بُرَيْدُ بْنُ أَبِي مَرْيَمَ  : فَدَخَلْتُ عَلَى مُحَمَّدِ بْنِ عَلِيٍّ فِي الشِّعْبِ ، فَحَدَّثْتُهُ بِهَذَا الْحَدِيثِ ، عَنْ  أَبِي الْحَوْرَاءِ  ، عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ ، فَقَالَ :  صَدَقَ ، هُنَّ كَلِمَاتٌ عَلَّمَنَاهُنَّ أَنْ نَقُولَهُنَّ فِي  الْقُنُوتِ  .","","Al-Mu'jam al-Kabir 2708","","الحسن بن علي سبط رسول الله عن ربيعة بن شيبان السعدي عن بريد بن أبي مريم السلولي عن الحسن بن عبيد الله النخعي عن أبو إسحاق الفزاري عن محبوب بن موسى الفراء عن هاشم بن مرثد الطيالسي عن الطبراني","أبو الحوراء عن الحسن بن علي رضي الله عنه"
"2707","2709  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ،  ثَنَا  أَبُو أَحْمَدَ الزُّبَيْرِيُّ ،  ثَنَا  الْعَلَاءُ بْنُ صَالِحٍ ،  عَنْ  بُرَيْدِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  أَبِي الْحَوْرَاءِ ، قَالَ :  قُلْتُ  لِلْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ : مَا حَفِظْتَ مِنَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَقَالَ :  الصَّلَوَاتِ الْخَمْسَ  .","","Al-Mu'jam al-Kabir 2709","","الحسن بن علي سبط رسول الله عن ربيعة بن شيبان السعدي عن بريد بن أبي مريم السلولي عن العلاء بن صالح التيمي عن محمد بن عبد الله بن الزبير عن عمرو بن محمد بن بكير عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو الحوراء عن الحسن بن علي رضي الله عنه"
"2708","2710  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ مُسَاوِرٍ الْجَوْهَرِيُّ ،  ثَنَا  عَفَّانُ ،  ثَنَا  شُعْبَةُ ،  عَنْ  بُرَيْدِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  أَبِي الْحَوْرَاءِ ، قَالَ :  قُلْتُ  لِلْحَسَنِ بْنِ عَلِيٍّ : مَا تَذْكُرُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : أَذْكُرُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّنِي أَخَذْتُ تَمْرَةً مِنْ تَمْرِ الصَّدَقَةِ ، فَجَعَلْتُهَا فِي فِيَّ ، فَنَزَعَهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِلُعَابِهَا ، فَجَعَلَهَا فِي التَّمْرِ ، فَقِيلَ : يَا رَسُولَ اللهِ ، مَا عَلَيْكَ مِنْ هَذِهِ التَّمْرَةِ لِهَذَا الصَّبِيِّ ؟ فَقَالَ :  إِنَّا  آلَ مُحَمَّدٍ  لَا تَحِلُّ لَنَا الصَّدَقَةُ  .","","Al-Mu'jam al-Kabir 2710","","الحسن بن علي سبط رسول الله عن ربيعة بن شيبان السعدي عن بريد بن أبي مريم السلولي عن شعبة بن الحجاج عن عفان بن مسلم الصفار عن أحمد بن القاسم بن مساور الجوهري عن الطبراني","أبو الحوراء عن الحسن بن علي رضي الله عنه"
"2709","2711  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الْحَسَنِ بْنِ عُمَارَةَ ،  حَدَّثَنِي  بُرَيْدُ بْنُ أَبِي مَرْيَمَ ،  عَنْ  أَبِي الْحَوْرَاءِ ، قَالَ :  قُلْتُ  لِلْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ : مِثْلَ مَا كُنْتَ يَوْمَ مَاتَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ وَمَا تَعْقِلُ مِنْهُ ؟ قَالَ : عَقَلْتُ عَنْهُ أَنَّ  رَجُلًا  جَاءَهُ يَوْمًا ، فَسَأَلَهُ عَنْ شَيْءٍ ، فَقَالَ :  دَعْ مَا  يَرِيبُكَ  إِلَى مَا لَا  يَرِيبُكَ  ؛ فَإِنَّ الشَّرَّ رِيبَةٌ ، وَإِنَّ الْخَيْرَ طُمَأْنِينَةٌ "" ، وَعَقَلْتُ عَنْهُ أَنِّي         [3/77]      مَرَرْتُ بِهِ يَوْمًا وَبَيْنَ يَدَيْهِ فِي  جُرْنٍ  مِنْ  جِرَانِ  تَمْرِ الصَّدَقَةِ ، فَأَخَذْتُ تَمْرَةً فَطَرَحْتُهَا فِي فِيَّ ، فَأَخَذَ بِقَفَايَ ، ثُمَّ أَدْخَلَ يَدَهُ فِي فِيَّ فَانْتَزَعَهَا بِلُعَابِهَا ، ثُمَّ طَرَحَهَا فِي  الْجُرْنِ  ، فَقَالَ لَهُ أَصْحَابُهُ : لَوْ تَرَكْتَ الْغُلَامَ فَأَكَلَهَا ؟ فَقَالَ :  إِنَّ الصَّدَقَةَ لَا تَحِلُّ  لِآلِ مُحَمَّدٍ  . قَالَ : وَعَلَّمَنِي كَلِمَاتٍ أَدْعُو بِهِنَّ فِي آخِرِ  الْقُنُوتِ  :  اللَّهُمَّ اهْدِنِي فِيمَنْ هَدَيْتَ ، وَتَوَلَّنِي فِيمَنْ تَوَلَّيْتَ ،  وَعَافِنِي فِيمَنْ عَافَيْتَ ، وَبَارِكْ لِي فِيمَا أَعْطَيْتَ ، وَقِنِي شَرَّ مَا قَضَيْتَ ؛ إِنَّكَ تَقْضِي وَلَا يُقْضَى عَلَيْكَ ، وَإِنَّهُ لَا يَذِلُّ مَنْ وَالَيْتَ ، تَبَارَكْتَ وَتَعَالَيْتَ  .","","Al-Mu'jam al-Kabir 2711","","الحسن بن علي سبط رسول الله عن ربيعة بن شيبان السعدي عن بريد بن أبي مريم السلولي عن الحسن بن عمارة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","أبو الحوراء عن الحسن بن علي رضي الله عنه"
"2710","2712  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ النُّعْمَانِ الْقَزَّازُ الْبَصْرِيُّ ،  حَدَّثَنَا  سُفْيَانُ بْنُ وَكِيعِ بْنِ الْجَرَّاحِ ،  حَدَّثَنِي  أَبِي ،  عَنْ  يُونُسَ بْنِ أَبِي إِسْحَاقَ ،  عَنْ  بُرَيْدِ بْنِ أَبِي مَرْيَمَ السَّلُولِيِّ ،  عَنْ  أَبِي الْحَوْرَاءِ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  عَلَّمَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَلِمَاتٍ أَقُولُهُنَّ فِي  قُنُوتِ  الْوِتْرِ  :  اللَّهُمَّ اهْدِنِي فِيمَنْ هَدَيْتَ ، وَعَافِنِي فِيمَنْ عَافَيْتَ  ، وَتَوَلَّنِي فِيمَنْ تَوَلَّيْتَ ، وَبَارِكْ لِي فِيمَا أَعْطَيْتَ ، وَقِنِي شَرَّ مَا قَضَيْتَ ؛ فَإِنَّكَ تَقْضِي وَلَا يُقْضَى عَلَيْكَ ؛ إِنَّهُ لَا يَذِلُّ مَنْ وَالَيْتَ ، تَبَارَكْتَ وَتَعَالَيْتَ  .","","Al-Mu'jam al-Kabir 2712","","الحسن بن علي سبط رسول الله عن ربيعة بن شيبان السعدي عن بريد بن أبي مريم السلولي عن يونس بن أبي إسحاق عن وكيع بن الجراح عن سفيان بن وكيع بن الجراح عن عبد الله بن محمد بن النعمان القزاز البصري عن الطبراني","أبو الحوراء عن الحسن بن علي رضي الله عنه"
"2711","2713  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ الْمُحَارِبِيُّ ،  ثَنَا  الرَّبِيعُ بْنُ سَهْلٍ أَبُو إِبْرَاهِيمَ الْفَزَارِيُّ ،  ثَنَا  الرَّبِيعُ بْنُ الرُّكَيْنِ ،  عَنْ  أَبِي يَزِيدَ الزَّرَّادِ ،  عَنْ  أَبِي الْحَوْرَاءِ ، قَالَ :  لَقِيتُ الْحَسَنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ  بِالْبَصْرَةِ  ، فَقُلْتُ : بِنَفْسِي أَنْتَ مَا حَفِظْتَ عَنْ أَبِيكَ  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟  فَقَالَ  : عَلَّمَنِي كَلِمَاتٍ أَقُولُهُنَّ فِي  الْوِتْرِ  . قُلْتُ : مَا هِيَ ؟ قَالَ :  اللَّهُمَّ اهْدِنِي فِيمَنْ هَدَيْتَ ، وَعَافِنِي فِيمَنْ عَافَيْتَ  ، وَتَوَلَّنِي فِيمَنْ تَوَلَّيْتَ ، وَبَارِكْ لِي فِيمَا أَعْطَيْتَ ، وَقِنِي شَرَّ مَا قَضَيْتَ ؛ إِنَّكَ تَقْضِي وَلَا يُقْضَى عَلَيْكَ "" . قُلْتُ : بِنَفْسِي مَا حَفِظْتَ عَنْهُ غَيْرَ هَذَا ؟ قَالَ : كُنْتُ أَمْشِي مَعَهُ فِي حَائِطِ الصَّدَقَةِ ، فَأَخَذْتُ تَمْرَةً ، فَأَدْخَلْتُهَا فِي فِيَّ ، فَأَدْخَلَ يَدَهُ حَتَّى أَخْرَجَهَا ، وَقَالَ :  أَيْ بُنَيَّ ، أَمَا عَلِمْتَ أَنَّا  أَهْلُ بَيْتٍ  لَا تَحِلُّ لَنَا الصَّدَقَةُ  ؟  .","","Al-Mu'jam al-Kabir 2713","","الحسن بن علي سبط رسول الله عن ربيعة بن شيبان السعدي عن عبد الملك بن ميسرة الهلالي عن ركين بن الربيع الفزاري عن الربيع بن سهل بن الركين الفزاري عن محمد بن عبيد بن محمد بن واقد النحاس عن محمد بن عثمان بن أبي شيبة عن الطبراني","أبو الحوراء عن الحسن بن علي رضي الله عنه"
"2712","[3/78]      2714  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  طَاهِرُ بْنُ أَبِي أَحْمَدَ الزُّبَيْرِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  الْعَلَاءُ بْنُ صَالِحٍ ،  عَنْ  بُرَيْدِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  أَبِي الْحَوْرَاءِ ، قَالَ :  كُنَّا عِنْدَ الْحَسَنِ بْنِ عَلِيٍّ فَسُئِلَ : مَا عَقَلْتَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَقَالَ : كُنْتُ أَمْشِي مَعَهُ يَوْمًا ، فَمَرَّ عَلَى  جَرِينٍ  مِنْ تَمْرِ الصَّدَقَةِ ، فَوَجَدْتُ تَمْرَةً ، فَأَلْقَيْتُهَا فِي فِيَّ ، فَأَخْرَجَهَا بِلُعَابِي ، فَقَالَ  بَعْضُ الْقَوْمِ  : مَا عَلَيْكَ يَا رَسُولَ اللهِ لَوْ تَرَكْتَهَا ؟ قَالَ :  إِنَّا  آلَ مُحَمَّدٍ  لَا تَحِلُّ لَنَا الصَّدَقَةُ  .","","Al-Mu'jam al-Kabir 2714","","الحسن بن علي سبط رسول الله عن ربيعة بن شيبان السعدي عن بريد بن أبي مريم السلولي عن العلاء بن صالح التيمي عن محمد بن عبد الله بن الزبير عن طاهر بن أبى أحمد الزبيري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","أبو الحوراء عن الحسن بن علي رضي الله عنه"
"2713","أَبُو وَائِلٍ شَقِيقُ بْنُ سَلَمَةَ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  2715  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  جَعْفَرُ بْنُ حُمَيْدٍ ،  ثَنَا  حُدَيْجُ بْنُ مُعَاوِيَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  شَقِيقِ بْنِ سَلَمَةَ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ ، قَالَ :  جَاءَتِ  امْرَأَةٌ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَمَعَهَا ابْنَانِ لَهَا ، فَأَعْطَاهَا ثَلَاثَ تَمَرَاتٍ ، فَأَعْطَتِ ابْنَيْهَا كُلَّ وَاحِدٍ مِنْهُمَا تَمْرَةً ، فَأَكَلَا تَمْرَتَيْهِمَا ، ثُمَّ جَعَلَا يَنْظُرَانِ إِلَى أُمِّهِمَا ، فَشَقَّتْ تَمْرَتَهَا بِنِصْفَيْنِ بَيْنَهُمَا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قَدْ رَحِمَهَا اللهُ بِرَحْمَتِهَا ابْنَيْهَا  .","","Al-Mu'jam al-Kabir 2715","","الحسن بن علي سبط رسول الله عن شقيق بن سلمة عن أبو إسحاق السبيعي عن حديج بن معاوية بن حديج  الجعفي عن جعفر بن حميد زنبقة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","أبو وائل شقيق بن سلمة عن الحسن بن علي رضي الله عنه"
"2714","عَامِرٌ الشَّعْبِيُّ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا  2716  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ الْمِصْرِيُّ ،  ثَنَا  يَحْيَى بْنُ سُلَيْمَانَ الْجُعْفِيُّ ،  حَدَّثَنَا  أَحْمَدُ بْنُ بِشْرٍ  ،  ثَنَا  مُجَالِدٌ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ بِهِ وَفِي يَدِهِ عَرْقٌ يَتَعَرَّقُ مِنْهُ  . قَالَ : "" فَتَنَاوَلَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فَنَهَسَ  مِنْهُ  نَهْسَةً أَوْ نَهْسَتَيْنِ  ، ثُمَّ صَلَّى وَلَمْ يَتَوَضَّأْ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب :""بشير"".","","Al-Mu'jam al-Kabir 2716","","الحسن بن علي سبط رسول الله عن الشعبي عن مجالد بن سعيد عن أحمد بن بشير المخزومى عن يحيى بن سليمان بن يحيى عن روح بن الفرج القطان عن الطبراني","عامر الشعبي عن الحسن بن علي رضي الله عنهما"
"2715","[3/79]      هُبَيْرَةُ بْنُ يَرِيمَ  عَنِ  الْحَسَنِ  رَضِيَ اللهُ عَنْهُ  2717  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  يَحْيَى بْنُ إِسْحَاقَ السَّيْلَحِينِيُّ ،  ثَنَا  يَزِيدُ بْنُ عَطَاءٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هُبَيْرَةَ بْنِ يَرِيمَ  أَنَّ الْحَسَنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ  خَطَبَ  النَّاسَ ، فَقَالَ : "" يَا أَيُّهَا النَّاسُ ، لَقَدْ فَقَدْتُمْ رَجُلًا لَمْ يَسْبِقْهُ الْأَوَّلُونَ ، وَلَا يُدْرِكُهُ الْآخِرُونَ ،  إِنْ كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَيَبْعَثُهُ فِي السَّرِيَّةِ ، وَإِنَّ  جِبْرِيلَ  عَنْ يَمِينِهِ  ،  وَمِيكَائِيلَ  عَنْ يَسَارِهِ ، وَاللهِ مَا تَرَكَ بَيْضَاءَ وَلَا صَفْرَاءَ إِلَّا ثَمَانَمِائَةِ دِرْهَمٍ فِي ثَمَنِ خَادِمٍ "" .","","Al-Mu'jam al-Kabir 2717","","الحسن بن علي سبط رسول الله عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن يزيد بن عطاء بن يزيد اليشكري عن يحيى بن إسحاق السيلحيني عن بشر بن موسى بن صالح الأسدي عن الطبراني","هبيرة بن يريم عن الحسن رضي الله عنه"
"2716","2718  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  عَلِيُّ بْنُ حَكِيمٍ الْأَوْدِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هُبَيْرَةَ بْنِ يَرِيمَ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَبْعَثُهُ بِالسَّرِيَّةِ -  يَعْنِي  عَلِيًّا  رَضِيَ اللهُ عَنْهُ  - فَيُقَاتِلُ  ،  جِبْرِيلُ  عَنْ يَمِينِهِ ،  وَمِيكَائِيلُ  عَنْ يَسَارِهِ ، وَلَا يَرْجِعُ حَتَّى يَفْتَحَ اللهُ عَلَيْهِ  .","","Al-Mu'jam al-Kabir 2718","","الحسن بن علي سبط رسول الله عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن علي بن حكيم بن ذبيان عن محمد بن عثمان بن أبي شيبة عن الطبراني","هبيرة بن يريم عن الحسن رضي الله عنه"
"2717","2719  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ  ، ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  ثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ الْمُزَنِيُّ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هُبَيْرَةَ بْنِ يَرِيمَ ، قَالَ :  سَمِعْتُ  الْحَسَنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ يَخْطُبُ النَّاسَ ، فَقَالَ : "" يَا أَيُّهَا النَّاسُ ، لَقَدْ فَارَقَكُمْ بِالْأَمْسِ رَجُلٌ مَا سَبَقَهُ الْأَوَّلُونَ بِعِلْمٍ ، وَلَا يُدْرِكُهُ الْآخِرُونَ ، إِنْ  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَبْعَثُهُ الْمَبْعَثَ فَيُعْطِيهِ  الرَّايَةَ  ، فَمَا يَرْجِعُ حَتَّى يَفْتَحَ اللهُ عَلَيْهِ ، إِنَّ  جِبْرِيلَ  عَنْ يَمِينِهِ ،  وَمِيكَائِيلَ  عَنْ يَسَارِهِ ، مَا تَرَكَ صَفْرَاءَ وَلَا بَيْضَاءَ إِلَّا سَبْعَمِائَةِ دِرْهَمٍ ، أَرَادَ أَنْ يَشْتَرِيَ بِهَا خَادِمًا "" .","","Al-Mu'jam al-Kabir 2719","","الحسن بن علي سبط رسول الله عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن إسماعيل بن أبي خالد عن محمد بن الحسن المزني عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","هبيرة بن يريم عن الحسن رضي الله عنه"
"2718","2720  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  ضِرَارُ بْنُ صُرَدٍ ،  ثَنَا  يَحْيَى بْنُ يَعْلَى ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هُبَيْرَةَ بْنِ يَرِيمَ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَا يَبْعَثُ  عَلِيًّا  مَبْعَثًا إِلَّا أَعْطَاهُ  الرَّايَةَ  .","","Al-Mu'jam al-Kabir 2720","","الحسن بن علي سبط رسول الله عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن إسماعيل بن أبي خالد عن يحيى بن يعلى القطواني عن ضرار بن صرد التيمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","هبيرة بن يريم عن الحسن رضي الله عنه"
"2719","[3/80]      2721  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  ضِرَارُ بْنُ صُرَدٍ ،  ثَنَا  عَلِيُّ بْنُ هَاشِمٍ ،  عَنْ  صَدَقَةَ بْنِ أَبِي عِمْرَانَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هُبَيْرَةَ بْنِ يَرِيمَ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  مَا بَعَثَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عَلِيًّا  مَبْعَثًا إِلَّا أَعْطَاهُ  الرَّايَةَ  .","","Al-Mu'jam al-Kabir 2721","","الحسن بن علي سبط رسول الله عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن صدقة بن أبي عمران الكوفي عن علي بن هاشم العائذي عن ضرار بن صرد التيمي عن محمد بن عثمان بن أبي شيبة عن الطبراني","هبيرة بن يريم عن الحسن رضي الله عنه"
"2720","2722  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ، وَمُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ ، قَالَا :  ثَنَا  عِيسَى بْنُ سَالِمٍ الشَّاشِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  يَزِيدَ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هُبَيْرَةَ بْنِ يَرِيمَ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  لَقَدْ فَارَقَكُمْ  رَجُلٌ  لَمْ يَسْبِقْهُ أَحَدٌ مِنَ الْأَوَّلِينَ بِعِلْمٍ ، وَلَا يُدْرِكُهُ أَحَدٌ مِنَ الْآخِرِينَ ،  مَنْ كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَبْعَثُهُ فَيُعْطِيهِ  الرَّايَةَ  ، ثُمَّ يَخْرُجُ وَلَا يَرْجِعُ حَتَّى يَفْتَحَ اللهُ عَزَّ وَجَلَّ عَلَيْهِ ،  جِبْرِيلُ  عَنْ يَمِينِهِ ،  وَمِيكَائِيلُ  عَنْ يَسَارِهِ يُقَاتِلُونَ مَعَهُ  ، مَاتَ وَلَمْ يَتْرُكْ دِينَارًا وَلَا دِرْهَمًا ، إِلَّا حُلِيًّا قِيمَتُهُ سَبْعُمِائَةِ دِرْهَمٍ فَضَلَتْ عَنْ عَطَائِهِ  .","","Al-Mu'jam al-Kabir 2722","","الحسن بن علي سبط رسول الله عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن زيد بن أبي أنيسة الجزري عن عبيد الله بن عمرو بن أبي الوليد عن عيسى بن سالم الشاشي عن محمد بن الفضل بن جابر السقطى عن الطبراني","هبيرة بن يريم عن الحسن رضي الله عنه"
"2721","2723  -  حَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هُبَيْرَةَ بْنِ يَرِيمَ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  لَقَدْ فَارَقَكُمْ رَجُلٌ مَا تَرَكَ صَفْرَاءَ وَلَا بَيْضَاءَ  إِلَّا سَبْعَمِائَةِ دِرْهَمٍ عَنْ عَطَائِهِ أَرَادَ أَنْ يَبْتَاعَ بِهَا خَادِمًا  "" .  يَعْنِي  عَلِيًّا  رَضِيَ اللهُ عَنْهُ  .","","Al-Mu'jam al-Kabir 2723","","الحسن بن علي سبط رسول الله عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن سفيان الثوري عن محمد بن كثير العبدي عن الفضل بن الحباب الجمحي عن الطبراني","هبيرة بن يريم عن الحسن رضي الله عنه"
"2722","2724  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا الْكُوفِيُّ ،  ثَنَا  عَلِيُّ بْنُ عَابِسٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هُبَيْرَةَ بْنِ يَرِيمَ ، قَالَ :  خَطَبَ الْحَسَنُ ، فَقَالَ : لَقَدْ فَارَقَكُمْ بِالْأَمْسِ رَجُلٌ مَا سَبَقَهُ الْأَوَّلُونَ بِعِلْمٍ وَلَا يُدْرِكُهُ الْآخِرُونَ ، إِنْ  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَيَبْعَثُهُ الْمَبْعَثَ فَيُعْطِيهِ  الرَّايَةَ  ،  جِبْرِيلُ  عَنْ يَمِينِهِ ،  وَمِيكَائِيلُ  عَنْ يَسَارِهِ  ، فَمَا يَرْجِعُ حَتَّى يَفْتَحَ اللهُ عَزَّ وَجَلَّ لَهُ "" .","","Al-Mu'jam al-Kabir 2724","","الحسن بن علي سبط رسول الله عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن علي بن عابس الملائي عن إسماعيل بن زكريا الكوفي عن عبد الله بن أحمد الجواليقي عن الطبراني","هبيرة بن يريم عن الحسن رضي الله عنه"
"2723","2725  -  حَدَّثَنَا  الْحَسَنُ بْنُ غُلَيْبٍ الْمِصْرِيُّ ،  ثَنَا  سَعِيدُ بْنُ عُفَيْرٍ ،  ثَنَا  بَكَّارُ بْنُ زَكَرِيَّا ،  عَنِ  الْأَجْلَحِ ،  عَنْ  أَبِي إِسْحَاقَ الْهَمْدَانِيِّ ،  عَنْ  هُبَيْرَةَ بْنِ يَرِيمَ  أَنَّ  عَلِيًّا  رَضِيَ اللهُ تَعَالَى عَنْهُ لَمَّا تُوُفِّيَ قَامَ الْحَسَنُ بْنُ عَلِيٍّ عَلَى الْمِنْبَرِ ، فَقَالَ : أَيُّهَا النَّاسُ ، قَدْ         [3/81]      قُبِضَ فِيكُمُ اللَّيْلَةَ رَجُلٌ لَمْ يَسْبِقْهُ الْأَوَّلُونَ ، وَلَا يُدْرِكُهُ الْآخِرُونَ ، قَدْ  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَبْعَثُهُ الْمَبْعَثَ  ، فَيَكْتَنِفُهُ  جِبْرِيلُ  عَنْ يَمِينِهِ ،  وَمِيكَائِيلُ  عَنْ يَسَارِهِ  ، لَا يَنْثَنِي حَتَّى يُفْتَحَ لَهُمْ ، مَا تَرَكَ إِلَّا سَبْعَمِائَةِ دِرْهَمٍ أَرَادَ أَنْ يَبْتَاعَ بِهَا خَادِمًا ، وَقَدْ قُبِضَ فِي اللَّيْلَةِ الَّتِي عَرَجَ فِيهَا  عِيسَى ابْنُ مَرْيَمَ  ، لَيْلَةِ سَبْعٍ وَعِشْرِينَ مِنْ رَمَضَانَ "" .","","Al-Mu'jam al-Kabir 2725","","الحسن بن علي سبط رسول الله عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن أجلح بن عبد الله الكندي عن بكار بن زكريا الأشجعي عن سعيد بن كثير بن عفير عن الحسن بن غليب المصري عن الطبراني","هبيرة بن يريم عن الحسن رضي الله عنه"
"2724","مُعَاوِيَةُ بْنُ حُدَيْجٍ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  2726  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَمْرٍو الْوَاقِفِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  مُحَمَّدِ بْنِ يَزِيدَ ،  عَنْ  مُعَاوِيَةَ بْنِ حُدَيْجٍ ، قَالَ :  أَرْسَلَنِي  مُعَاوِيَةُ بْنُ أَبِي سُفْيَانَ  رَحِمَهُ اللهُ إِلَى الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُمْ أَخْطُبُ عَلَى  يَزِيدَ  بِنْتًا لَهُ  أَوْ  أُخْتًا لَهُ  ،  فَأَتَيْتُهُ فَذَكَرْتُ لَهُ  يَزِيدَ  ، فَقَالَ : إِنَّا قَوْمٌ لَا تُزَوَّجُ نِسَاؤُنَا حَتَّى نَسْتَأْمِرَهُنَّ ، فَائْتِهَا . فَأَتَيْتُهَا فَذَكَرْتُ لَهَا  يَزِيدَ  ، فَقَالَتْ : وَاللهِ لَا يَكُونُ ذَاكَ حَتَّى يَسِيرَ فِينَا صَاحِبُكَ كَمَا سَارَ  فِرْعَوْنُ  فِي  بَنِي إِسْرَائِيلَ  ، يَذْبَحُ أَبْنَاءَهُمْ ، وَيَسْتَحْيِي نِسَاءَهُمْ . فَرَجَعْتُ إِلَى  الْحَسَنِ  ، فَقُلْتُ : أَرْسَلْتَنِي إِلَى فِلْقَةٍ مِنَ الْفَلَقِ تُسَمِّي أَمِيرَ الْمُؤْمِينَ  فِرْعَوْنَ  . فَقَالَ : يَا  مُعَاوِيَةُ  إِيَّاكَ وَبُغْضَنَا ، فَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يُبْغِضُنَا وَلَا يَحْسُدُنَا أَحَدٌ إِلَّا زِيدَ يَوْمَ الْقِيَامَةِ بِسِيَاطٍ مِنْ نَارٍ  .","","Al-Mu'jam al-Kabir 2726","","الحسن بن علي سبط رسول الله عن معاوية بن حديج السكوني عن محمد بن زيد بن المهاجر الجدعاني عن شريك بن عبد الله النخعي عن عبد الله بن عمرو بن حسان الواقعي عن أبو مسلم الكجي عن الطبراني","معاوية بن حديج عن الحسن بن علي رضي الله عنه"
"2725","أَبُو كَبِيرٍ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا  2727  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، (  ح  ) .  وَحَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ، قَالَا :  ثَنَا  عَبَّادُ بْنُ يَعْقُوبَ الْأَسَدِيُّ ،  ثَنَا  عَلِيُّ بْنُ عَابِسٍ ،  عَنْ  بَدْرِ بْنِ الْخَلِيلِ أَبِي الْخَلِيلِ ،  عَنْ  أَبِي كَبِيرٍ ، قَالَ :  كُنْتُ         [3/82]      جَالِسًا عِنْدَ الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ ، فَجَاءَهُ  رَجُلٌ  ، فَقَالَ : لَقَدْ سَبَّ عِنْدَ  مُعَاوِيَةَ  عَلِيًّا  رَضِيَ اللهُ عَنْهُمَا سَبًّا قَبِيحًا رَجُلٌ يُقَالُ لَهُ  مُعَاوِيَةُ - يَعْنِي ابْنَ حُدَيْجٍ  - تَعْرِفُهُ ؟ قَالَ : نَعَمْ . قَالَ : إِذَا رَأَيْتَهُ فَائْتِنِي بِهِ . قَالَ : فَرَآهُ عِنْدَ دَارِ  عَمْرِو بْنِ حُرَيْثٍ  ، فَأَرَاهُ إِيَّاهُ ، قَالَ : أَنْتَ  مُعَاوِيَةُ بْنُ حُدَيْجٍ  ؟ فَسَكَتَ فَلَمْ يُجِبْهُ ثَلَاثًا ، ثُمَّ قَالَ :  أَنْتَ السَّبَّابُ  عَلِيًّا  عِنْدَ ابْنِ آكِلَةِ الْأَكْبَادِ ، أَمَا لَئِنْ وَرَدْتَ عَلَيْهِ الْحَوْضَ ، وَمَا أُرَاكَ تَرِدُهُ  ، لَتَجِدَنَّهُ مُشَمِّرًا حَاسِرًا ذِرَاعَيْهِ يَذُودُ الْكُفَّارَ وَالْمُنَافِقِينَ عَنْ حَوْضِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، كَمَا  تُذَادُ  غَرِيبَةُ  الْإِبِلِ عَنْ صَاحِبِهَا ، قَوْلُ الصَّادِقِ الْمَصْدُوقِ  أَبِي الْقَاسِمِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 2727","","الحسن بن علي سبط رسول الله عن أبو كبير عن بدر بن الخليل الأسدي عن علي بن عابس الملائي عن عباد بن يعقوب الرواجني عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","أبو كبير عن الحسن بن علي رضي الله عنهما"
"2726","الْمُسَيِّبُ بْنُ نَجَبَةَ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  2728  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْحَسَنِ التَّغْلِبِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ بُكَيْرٍ الْغَنَوِيُّ  ،  عَنْ  حَكِيمِ بْنِ جُبَيْرٍ ،  عَنْ  أَبِي إِدْرِيسَ ،  عَنِ  الْمُسَيِّبِ بْنِ نَجَبَةَ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْحَرْبُ  خَدْعَةٌ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عبد الله)","","Al-Mu'jam al-Kabir 2728","","الحسن بن علي سبط رسول الله عن المسيب بن نجبة الفزاري عن أبو إدريس المرهبي عن حكيم بن جبير الأسدي عن عبد الله بن بكير الغنوي عن إبراهيم بن الحسن الثعلبي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","المسيب بن نجبة عن الحسن بن علي رضي الله عنه"
"2727","حَسَنُ بْنُ حَسَنِ بْنِ عَلِيٍّ  عَنْ أَبِيهِ رَضِيَ اللهُ عَنْهُ  2729  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  أَخْبَرَنِي  حُمَيْدُ بْنُ أَبِي زَيْنَبَ ،  عَنْ  حَسَنِ بْنِ حَسَنِ بْنِ عَلِيِّ بْنِ أَبِي طَالِبٍ ،  عَنْ  أَبِيهِ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  حَيْثُمَا كُنْتُمْ فَصَلُّوا عَلَيَّ  ، فَإِنَّ صَلَاتَكُمْ تَبْلُغُنِي  .","","Al-Mu'jam al-Kabir 2729","","الحسن بن علي سبط رسول الله عن الحسن بن الحسن بن علي بن أبي طالب عن حميد بن أبي زينب المديني عن محمد بن جعفر بن أبي كثير الزرقي عن سعيد بن الحكم الجمحي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","حسن بن حسن بن علي عن أبيه رضي الله عنه"
"2728","2730  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ،  ثَنَا  كَثِيرُ بْنُ يَحْيَى ،  ثَنَا         [3/83]      حَفْصُ بْنُ عُمَرَ الرَّقَاشِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ حَسَنِ بْنِ حَسَنِ بْنِ عَلِيٍّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  قَالَ :  قِيلَ :  يَا رَسُولَ اللهِ  الْقَوْمُ  يَأْتُونَ الدَّارَ فَيَسْتَأْذِنُ وَاحِدٌ مِنْهُمْ ، أَيُجْزِئُ عَنْهُمْ جَمِيعًا ؟ قَالَ : "" نَعَمْ  . قِيلَ : فَيَرُدُّ رَجُلٌ مِنَ  الْقَوْمِ  ، أَيُجْزِئُ عَنِ الْجَمِيعِ ؟ قَالَ : "" نَعَمْ "" . قِيلَ :  الْقَوْمُ  يَمُرُّونَ فَيُسَلِّمُ وَاحِدٌ مِنْهُمْ ، أَيُجْزِئُ عَنِ الْجَمِيعِ ؟ قَالَ : "" نَعَمْ "" . قِيلَ : فَيَرُدُّ رَجُلٌ مِنَ  الْقَوْمِ  ، أَيُجْزِئُ عَنِ الْجَمِيعِ ؟ قَالَ : "" نَعَمْ  .","","Al-Mu'jam al-Kabir 2730","","الحسن بن علي سبط رسول الله عن الحسن بن الحسن بن علي بن أبي طالب عن عبد الله بن حسن بن حسن بن علي بن أبي طالب عن حفص بن عمرو الربالي عن كثير بن يحيى بن كثير الشيعي عن إبراهيم بن هاشم البغوي عن الطبراني","حسن بن حسن بن علي عن أبيه رضي الله عنه"
"2729","2731  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَادَةَ الْوَاسِطِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ ،  ثَنَا  جَهْمُ بْنُ عُثْمَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ حَسَنِ بْنِ حَسَنٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ مِنْ  مُوجِبَاتِ  الْمَغْفِرَةِ إِدْخَالَ السُّرُورِ عَلَى أَخِيكَ الْمُسْلِمِ  .","","Al-Mu'jam al-Kabir 2731","","الحسن بن علي سبط رسول الله عن الحسن بن الحسن بن علي بن أبي طالب عن عبد الله بن حسن بن حسن بن علي بن أبي طالب عن جهم بن عثمان صاحب جعفر الصادق عن يعقوب بن محمد بن عيسى عن محمد بن عبادة بن البخترى الأسدي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","حسن بن حسن بن علي عن أبيه رضي الله عنه"
"2730","2732  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ،  ثَنَا  قَيْسُ بْنُ مُحَمَّدٍ الْكِنْدِيُّ ،  ثَنَا  طَلْحَةُ بْنُ كَامِلٍ ،  عَنْ  مُحَمَّدِ بْنِ هِشَامٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَسَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  الْمَغْبُونُ لَا مَحْمُودٌ وَلَا مَأْجُورٌ  .","","Al-Mu'jam al-Kabir 2732","","الحسين بن علي عن الحسن بن الحسن بن علي بن أبي طالب عن عبد الله بن حسن بن حسن بن علي بن أبي طالب عن أبو هشام القناد عن كامل بن طلحة الجحدري عن قيس بن محمد بن عمران الكندي عن عبدة بن عبد الله بن عبدة الخزاعي عن زكريا بن يحيى السجزي عن الطبراني","حسن بن حسن بن علي عن أبيه رضي الله عنه"
"2731","2733  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ،  ثَنَا  كَثِيرُ بْنُ يَحْيَى ،  ثَنَا         [3/84]      حَفْصُ بْنُ عُمَرَ الرَّقَاشِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ حَسَنِ بْنِ حَسَنٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ قَرَأَ آيَةَ الْكُرْسِيِّ فِي دُبُرِ الصَّلَاةِ الْمَكْتُوبَةِ كَانَ فِي ذِمَّةِ اللهِ  إِلَى الصَّلَاةِ الْأُخْرَى  .","","Al-Mu'jam al-Kabir 2733","","الحسن بن علي سبط رسول الله عن الحسن بن الحسن بن علي بن أبي طالب عن عبد الله بن حسن بن حسن بن علي بن أبي طالب عن حفص بن عمرو الربالي عن كثير بن يحيى بن كثير الشيعي عن إبراهيم بن هاشم البغوي عن الطبراني","حسن بن حسن بن علي عن أبيه رضي الله عنه"
"2732","2734  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُصَرِّفُ بْنُ عَمْرٍو الْيَامِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدِ بْنِ طَلْحَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  يَاسِينَ الزَّيَّاتِ أَبِي مُعَاذٍ ،  عَنْ  أَبِي عَبْدِ اللهِ الْمَكِّيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَسَنِ بْنِ الْحَسَنِ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى ، وَالرِّجَالُ وَالنِّسَاءُ يَطُوفُونَ بَيْنَ يَدَيْهِ  بِغَيْرِ سُتْرَةٍ مِمَّا يَلِي الْحَجَرَ الْأَسْوَدَ  .","","Al-Mu'jam al-Kabir 2734","","الحسن بن علي سبط رسول الله عن الحسن بن الحسن بن علي بن أبي طالب عن عبد الله بن حسن بن حسن بن علي بن أبي طالب عن أبو عبد الله المكي عن ياسين بن معاذ الزيات عن محمد بن طلحة بن مصرف الهمداني عن عبد الرحمن بن محمد بن طلحة اليامي عن مصرف بن عمرو بن السري الهمداني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","حسن بن حسن بن علي عن أبيه رضي الله عنه"
"2733","2735  -  حَدَّثَنَا  أَبُو عُبَيْدَةَ عَبْدُ الْوَارِثِ بْنُ إِبْرَاهِيمَ الْعَسْكَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ جَامِعٍ الْعَطَّارُ ،  ثَنَا  فَضَالَةُ بْنُ حُصَيْنٍ ،  حَدَّثَنِي  رَجُلٌ مِنْ أَهْلِ الْمَدِينَةِ يُكَنَّى أَبَا عَبْدِ اللهِ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ حَسَنِ بْنِ حَسَنِ بْنِ عَلِيِّ بْنِ أَبِي طَالِبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمْ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  النَّخْلُ وَالشَّجَرُ بَرَكَةٌ عَلَى أَهْلِهِ  ، وَعَلَى عَقِبِهِمْ بَعْدَهُمْ ، إِذَا كَانُوا لِلهِ شَاكِرِينَ  .","","Al-Mu'jam al-Kabir 2735","","الحسن بن علي سبط رسول الله عن الحسن بن الحسن بن علي بن أبي طالب عن عبد الله بن حسن بن حسن بن علي بن أبي طالب عن رجل من أهل المدينة يكنى أبا عبد الله عن فضالة بن حصين الضبي عن محمد بن جامع العطار عن عبد الوارث بن إبراهيم العسكري عن الطبراني","حسن بن حسن بن علي عن أبيه رضي الله عنه"
"2734","2736  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ النَّخَعِيُّ الْقَاضِي الْكُوفِيُّ  ، ثَنَا  عَمَّارُ بْنُ أَبِي مَالِكٍ الْجَنْبِيُّ ،  ثَنَا  أَبُو دَاوُدَ النَّخَعِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ حَسَنِ بْنِ حَسَنٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ ضَحَّى طَيِّبَةً بِهَا نَفْسُهُ ، مُحْتَسِبًا لِأُضْحِيَّتِهِ ؛ كَانَتْ لَهُ حِجَابًا مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 2736","","الحسن بن علي سبط رسول الله عن الحسن بن الحسن بن علي بن أبي طالب عن عبد الله بن حسن بن حسن بن علي بن أبي طالب عن سليمان بن عمرو البغدادي عن عمار بن أبي مالك عن أحمد بن محمد النخعي القاضي الكوفي عن الطبراني","حسن بن حسن بن علي عن أبيه رضي الله عنه"
"2735","2737  -  حَدَّثَنَا  أَحْمَدُ بْنُ النَّضْرِ الْعَسْكَرِيُّ ،  ثَنَا  أَحْمَدُ بْنُ النُّعْمَانِ الْفَرَّاءُ الْمِصِّيصِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عُثْمَانَ الْحَاطِبِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدٍ الْجُهَنِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَسَنِ بْنِ عَلِيٍّ ،  عَنْ  أَبِيهِ  ، قَالَ :  صَعِدَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمِنْبَرَ  يَوْمَ غَزْوَةِ تَبُوكَ  ، فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ :  أَيُّهَا النَّاسُ ، إِنِّي وَاللهِ         [3/85]      مَا آمُرُكُمْ إِلَّا بِمَا أَمَرَكُمُ اللهُ بِهِ  ، وَلَا أَنْهَاكُمْ إِلَّا عَمَّا نَهَاكُمُ اللهُ عَنْهُ ، فَأَجْمِلُوا فِي الطَّلَبِ ، فَوَالَّذِي نَفْسُ  أَبِي الْقَاسِمِ  بِيَدِهِ إِنَّ أَحَدَكُمْ لَيَطْلُبُهُ رِزْقُهُ كَمَا يَطْلُبُهُ أَجَلُهُ ، فَإِنْ تَعَسَّرَ عَلَيْكُمْ شَيْءٌ مِنْهُ فَاطْلُبُوهُ بِطَاعَةِ اللهِ عَزَّ وَجَلَّ  .","","Al-Mu'jam al-Kabir 2737","","الحسن بن الحسن بن علي بن أبي طالب عن عبد الله بن حسن بن حسن بن علي بن أبي طالب عن عبد الله بن محمد الجهني عن عثمان بن إبراهيم الجمحي عن عبد الرحمن بن عثمان بن إبراهيم الحاطبي عن أحمد بن النعمان الفراء عن أحمد بن النضر بن بحر العسكري عن الطبراني","حسن بن حسن بن علي عن أبيه رضي الله عنه"
"2736","2738  -  حَدَّثَنَا  مُوسَى بْنُ جُمْهُورٍ التِّنِّيسِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ،  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  حَدَّثَنِي  جَهْمُ بْنُ عُثْمَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ حَسَنِ بْنِ حَسَنٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ مِنْ  وَاجِبِ  الْمَغْفِرَةِ إِدْخَالَكَ السُّرُورَ عَلَى أَخِيكَ الْمُسْلِمِ  .","","Al-Mu'jam al-Kabir 2738","","الحسن بن علي سبط رسول الله عن الحسن بن الحسن بن علي بن أبي طالب عن عبد الله بن حسن بن حسن بن علي بن أبي طالب عن جهم بن عثمان صاحب جعفر الصادق عن محمد بن إسماعيل بن مسلم الديلي عن محمد بن مصفى بن بهلول عن موسى بن جمهور بن زريق البغدادي عن الطبراني","حسن بن حسن بن علي عن أبيه رضي الله عنه"
"2737","زَيْدُ بْنُ عَلِيٍّ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  2739  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَالِمٍ ،  ثَنَا  حُسَيْنُ بْنُ زَيْدِ بْنِ عَلِيٍّ ،  عَنِ  الْحَسَنِ بْنِ زَيْدٍ ،  عَنْ  أَبِيهِ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا تَوَضَّأَ فَضَّلَ مَاءً حَتَّى يُسِيلَهُ عَلَى مَوْضِعِ سُجُودِهِ  .","","Al-Mu'jam al-Kabir 2739","","الحسن بن علي سبط رسول الله عن زيد بن الحسن بن علي بن أبي طالب عن الحسن بن زيد بن الحسن بن علي بن أبي طالب عن الحسين بن زيد بن علي بن الحسين بن علي بن أبي طالب عن عبد الله بن سالم المفلوج عن محمد بن عبد الله مطين الحضرمي عن الطبراني","زيد بن علي عن الحسن بن علي رضي الله عنه"
"2738","أَبُو يَحْيَى الْأَعْرَجُ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  2740  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ الْأَنْمَاطِيُّ ، (  ح  ) .  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي يَحْيَى ، قَالَ :  كُنْتُ بَيْنَ  الْحَسَنِ  وَالْحُسَيْنِ  وَمَرْوَانَ  يَتَسَابَّانِ ، فَجَعَلَ  الْحَسَنُ  يُسْكِتُ  الْحُسَيْنَ  ، فَقَالَ  مَرْوَانُ  :  أَهْلُ بَيْتٍ  مَلْعُونُونَ . فَغَضِبَ الْحَسَنُ ، وَقَالَ :  قُلْتَ  أَهْلُ بَيْتٍ  مَلْعُونُونَ ، فَوَاللهِ لَقَدْ لَعَنَكَ اللهُ عَلَى لِسَانِ نَبِيِّهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَنْتَ فِي صُلْبِ أَبِيكَ  .","","Al-Mu'jam al-Kabir 2740","","الحسن بن علي سبط رسول الله عن زياد القرشي الأعرج عن عطاء بن السائب عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو يحيى الأعرج عن الحسن بن علي رضي الله عنه"
"2739","[3/86]      رَبِيعَةُ بْنُ شَيْبَانَ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  2741  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ وَأَبُو أُسَامَةَ ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  ثَابِتِ بْنِ عُمَارَةَ ،  عَنْ  رَبِيعَةَ بْنِ شَيْبَانَ ، قَالَ :  قُلْتُ  لِلْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ : مَا تَعْقِلُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : صَعِدْتُ مَعَهُ غُرْفَةَ الصَّدَقَةِ ، فَأَخَذْتُ تَمْرَةً  فَلُكْتُهَا  ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلْقِهَا ؛ فَإِنَّا لَا تَحِلُّ لَنَا الصَّدَقَةُ  .","","Al-Mu'jam al-Kabir 2741","","الحسن بن علي سبط رسول الله عن ربيعة بن شيبان السعدي عن ثابت بن عمارة الحنفي عن وكيع بن الجراح عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","ربيعة بن شيبان عن الحسن بن علي"
"2740","إِسْحَاقُ بْنُ يَسَارٍ أَبُو مُحَمَّدِ بْنُ إِسْحَاقَ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  2742  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ الْبَغْدَادِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَمْرِو بْنِ أَبَانَ  ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ  أَنَّهُ دَخَلَ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْتَ  فَاطِمَةَ  ، فَنَاوَلَتْهُ كَتِفَ شَاةٍ مَطْبُوخَةٍ فَأَكَلَهَا ، ثُمَّ قَامَ يُصَلِّي ، فَأَخَذَتْ ثِيَابَهُ ، فَقَالَتْ : أَلَا تَوَضَّأُ يَا رَسُولَ اللهِ ؟ قَالَ : "" مِمَّ يَا بُنَيَّةُ ؟ "" قَالَتْ : قَدْ أَكَلْتَ مِمَّا مَسَّتْهُ النَّارُ . قَالَ :  إِنَّ أَطْهَرَ طَعَامِكُمْ لَمَا مَسَّتْهُ النَّارُ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب: (بن عمر بن أبان ) .","","Al-Mu'jam al-Kabir 2742","","الحسن بن علي سبط رسول الله عن إسحاق بن يسار المازنى عن محمد بن إسحاق عن محمد بن فضيل بن غزوان عن عبد الله بن عمر مشكدانة عن محمد بن عبدوس السراج عن الطبراني","إسحاق بن يسار أبو محمد بن إسحاق عن الحسن بن علي"
"2741","مُحَمَّدُ بْنُ سِيرِينَ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  2743  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ  أَنَّ  الْحَسَنَ بْنَ عَلِيٍّ وَابْنَ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا كَانَا جَالِسَيْنِ ، فَمَرَّتْ جِنَازَةٌ ، فَقَامَ أَحَدُهُمَا وَلَمْ يَقُمِ الْآخَرُ ، فَقَالَ أَحَدُهُمَا :  أَلَمْ يَقُمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ "" فَقَالَ الْآخَرُ : "" بَلَى ، ثُمَّ قَعَدَ  .","","Al-Mu'jam al-Kabir 2743","","عبد الله بن عباس عن محمد بن سيرين عن أيوب السختياني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","محمد بن سيرين عن الحسن بن علي رضي الله عنه"
"2742","2744  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،         [3/87]      عَنْ  أَيُّوبَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ، قَالَ :  مَرَّتْ جِنَازَةٌ  بِابْنِ عَبَّاسٍ  وَالْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا ، فَقَامَ الْحَسَنُ ، وَقَعَدَ  ابْنُ عَبَّاسٍ  ، فَقَالَ الْحَسَنُ :  أَلَيْسَ قَدْ قَامَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِجِنَازَةِ  يَهُودِيٍّ أَوْ يَهُودِيَّةٍ  مَرَّتْ بِهِ  ؟ "" فَقَالَ ابْنُ عَبَّاسٍ : "" بَلَى ، وَجَلَسَ  .","","Al-Mu'jam al-Kabir 2744","","عبد الله بن عباس عن محمد بن سيرين عن أيوب السختياني عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","محمد بن سيرين عن الحسن بن علي رضي الله عنه"
"2743","2745  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ حَمَّادٍ الشُّعَيْثِيُّ ،  ثَنَا  ابْنُ عَوْنٍ ،  عَنْ  مُحَمَّدٍ  أَنَّ جِنَازَةً مَرَّتْ عَلَى ابْنِ عَبَّاسٍ وَالْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُمَا ، فَقَامَ أَحَدُهُمَا ، وَقَعَدَ الْآخَرُ ، فَقَالَ الْقَائِمُ لِلْقَاعِدِ :  أَلَيْسَ قَدْ قَامَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ "" قَالَ : "" بَلَى ، ثُمَّ قَعَدَ  .","","Al-Mu'jam al-Kabir 2745","","الحسن بن علي سبط رسول الله عن محمد بن سيرين عن عبد الله بن عون بن أرطبان عن عبد الرحمن بن حماد الشعيثي عن أبو مسلم الكجي عن الطبراني","محمد بن سيرين عن الحسن بن علي رضي الله عنه"
"2744","2746  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ الْأَصْبَهَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُغِيرَةِ ،  ثَنَا  النُّعْمَانُ بْنُ عَبْدِ السَّلَامِ ،  عَنْ  سَعْدِ بْنِ عَبْدِ الرَّحْمَنِ ، وَيَزِيدَ بْنِ إِبْرَاهِيمَ التُّسْتَرِيِّ ، وَأَبِي بَكْرٍ الْهُذَلِيِّ ، قَالُوا :  حَدَّثَنَا  مُحَمَّدُ بْنُ سِيرِينَ ، قَالَ :  نُبِّئْتُ أَنَّ  الْحَسَنَ بْنَ عَلِيٍّ  وَابْنَ عَبَّاسٍ  مَرَّتْ عَلَيْهِمَا جِنَازَةٌ ، فَقَامَ  الْحَسَنُ  ، وَجَلَسَ  ابْنُ عَبَّاسٍ  ، فَقَالَ الْحَسَنُ لِابْنِ عَبَّاسٍ :  أَلَمْ تَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّتْ بِهِ جِنَازَةٌ فَقَامَ ؟ "" قَالَ : "" بَلَى ، وَقَدْ جَلَسَ  .","","Al-Mu'jam al-Kabir 2746","","عبد الله بن عباس عن محمد بن سيرين عن سعد بن عبد الرحمن عن النعمان بن عبد السلام عن محمد بن المغيرة ابن أبي مريم الأصبهاني عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","محمد بن سيرين عن الحسن بن علي رضي الله عنه"
"2745","2747  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ شُعَيْبٍ الرَّجَّانِيُّ ،  ثَنَا  يَحْيَى بْنُ حَكِيمٍ الْمُقَوِّمُ ،  ثَنَا  أَبُو بَحْرٍ الْبَكْرَاوِيُّ ،  ثَنَا  أَشْعَثُ ،  عَنْ  مُحَمَّدٍ  أَنَّ  ابْنَ عَبَّاسٍ  وَالْحَسَنَ بْنَ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا كَانَا جَالِسَيْنِ ، فَمَرَّتْ بِهِمَا جِنَازَةٌ ، فَقَامَ الْحَسَنُ ، وَقَعَدَ  ابْنُ عَبَّاسٍ  ، فَقَالَ :  أَمَا عَلِمْتَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ قَامَ وَجَلَسَ  ؟  .","","Al-Mu'jam al-Kabir 2747","","الحسن بن علي سبط رسول الله عن محمد بن سيرين عن أشعث الحمراني عن أبو بحر البكراوي عن يحيى بن حكيم المقوم عن عبد الله بن محمد بن شعيب الرجاني عن الطبراني","محمد بن سيرين عن الحسن بن علي رضي الله عنه"
"2746","2748  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  ثَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  أَيُّوبَ ،  عَنِ  ابْنِ سِيرِينَ  أَنَّ  الْحَسَنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  لَوْ نَظَرْتُمْ مَا بَيْنَ  جَابَرْسَ  إِلَى  جَابَلْقَ  مَا وَجَدْتُمْ رَجُلًا جَدُّهُ نَبِيٌّ غَيْرِي وَأَخِي  ، وَإِنِّي أَرَى أَنْ تَجْتَمِعُوا عَلَى  مُعَاوِيَةَ  ،         {      وَإِنْ أَدْرِي لَعَلَّهُ فِتْنَةٌ لَكُمْ وَمَتَاعٌ إِلَى حِينٍ         }      "" .  قَالَ  مَعْمَرٌ  : ""  جَابَرْسُ  وَجَابَلْقُ  : الْمَشْرِقُ وَالْمَغْرِبُ  ""  .","","Al-Mu'jam al-Kabir 2748","","الحسن بن علي سبط رسول الله عن محمد بن سيرين عن أيوب السختياني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","محمد بن سيرين عن الحسن بن علي رضي الله عنه"
"2747","[3/88]      أَبُو لَيْلَى  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  2749  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  إِبْرَاهِيمُ بْنُ إِسْحَاقَ الصِّينِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  لَيْثٍ ،  عَنْ  أَبِي لَيْلَى  ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  أَنَسُ  انْطَلِقْ فَادْعُ لِيَ سَيِّدَ الْعَرَبِ  -  يَعْنِي  عَلِيًّا  - فَقَالَتْ  عَائِشَةُ  رَضِيَ اللهُ عَنْهَا : أَلَسْتَ سَيِّدَ الْعَرَبِ ؟ قَالَ : "" أَنَا  سَيِّدُ  وَلَدِ آدَمَ ،  وَعَلِيٌّ  سَيِّدُ الْعَرَبِ "" . فَلَمَّا جَاءَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ أَرْسَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  الْأَنْصَارِ  فَأَتَوْهُ ، فَقَالَ لَهُمْ : "" يَا مَعْشَرَ  الْأَنْصَارِ  ، أَلَا أَدُلُّكُمْ عَلَى مَا إِنْ تَمَسَّكْتُمْ بِهِ لَنْ تَضِلُّوا بَعْدَهُ ؟ "" قَالُوا : بَلَى يَا رَسُولَ اللهِ . قَالَ : "" هَذَا  عَلِيٌّ  فَأَحِبُّوهُ بِحُبِّي ، وَكَرِّمُوهُ لِكَرَامَتِي ، فَإِنَّ  جِبْرِيلَ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَنِي بِالَّذِي قُلْتُ لَكُمْ عَنِ اللهِ عَزَّ وَجَلَّ  .  كذا في طبعة مكتبة ابن تيمية ، ولعل صوابه: (ابن أبي ليلى) ، كما في حلية الأولياء (1 / 63).","","Al-Mu'jam al-Kabir 2749","","الحسن بن علي سبط رسول الله عن عبد الرحمن بن أبي ليلى عن ليث بن أبي سليم عن قيس بن الربيع الأسدي عن إبراهيم بن إسحاق الصيني عن محمد بن عثمان بن أبي شيبة عن الطبراني","أبو ليلى عن الحسن بن علي رضي الله عنه"
"2748","عُمَيْرُ بْنُ مَأْمُونٍ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  2750  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  سَعْدِ بْنِ طَرِيفٍ ،  عَنْ  عُمَيْرِ بْنِ مَأْمُونٍ ، قَالَ :  سَمِعْتُ  الْحَسَنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ يَقُولُ : سَمِعْتُ جَدِّي رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ أَدْمَنَ الِاخْتِلَافَ إِلَى الْمَسْجِدِ أَصَابَ أَخًا مُسْتَفَادًا فِي اللهِ عَزَّ وَجَلَّ  ، وَعِلْمًا مُسْتَطْرَفًا ، وَكَلِمَةً تَدْعُوهُ إِلَى الْهُدَى ، وَكَلِمَةً تَصْرِفُهُ عَنِ الرَّدَى ، وَيَتْرُكُ الذُّنُوبَ حَيَاءً أَوْ خَشْيَةً ، وَنِعْمَةً أَوْ رَحْمَةً مُنْتَظَرَةً  .","","Al-Mu'jam al-Kabir 2750","","الحسن بن علي سبط رسول الله عن عمير بن مأموم الدارمي عن سعد بن طريف الإسكاف عن مروان بن معاوية الفزاري عن سعيد بن سليمان سعدويه عن محمد بن الفضل بن جابر السقطى عن الطبراني","عمير بن مأمون عن الحسن بن علي رضي الله عنه"
"2749","2751  -  حَدَّثَنَا  الْقَاسِمُ بْنُ عَبْدِ الْوَارِثِ  ، حَدَّثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا         [3/89]      أَبُو مُعَاوِيَةَ ،  عَنْ  سَعْدِ بْنِ طَرِيفٍ ،  عَنْ  عُمَيْرِ بْنِ مَأْمُونٍ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تُحْفَةُ  الصَّائِمِ الدُّهْنُ  وَالْمِجْمَرُ  .","","Al-Mu'jam al-Kabir 2751","","الحسن بن علي سبط رسول الله عن عمير بن مأموم الدارمي عن سعد بن طريف الإسكاف عن أبو معاوية الضرير عن سليمان بن داود العتكي عن القاسم بن عبد الوارث الوراق عن الطبراني","عمير بن مأمون عن الحسن بن علي رضي الله عنه"
"2750","حَبِيبُ بْنُ أَبِي ثَابِتٍ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  2752  -  حَدَّثَنَا  عَلَّانُ بْنُ عَبْدِ الصَّمَدِ مَاغَمَّهُ  ، ثَنَا  عُمَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  حَمَّادُ بْنُ شُعَيْبٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ ، قَالَ :  "" كُلًّا قَدْ فَعَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  قَدْ أَهَلَّ حِينَ اسْتَوَتْ بِهِ رَاحِلَتُهُ  ، وَقَدْ أَهَلَّ وَهُوَ  بِالْبَيْدَاءِ  بِالْأَرْضِ قَبْلَ أَنْ تَسْتَوِيَ بِهِ رَاحِلَتُهُ  .","","Al-Mu'jam al-Kabir 2752","","الحسن بن علي سبط رسول الله عن حبيب بن أبي ثابت الكاهلي عن حماد بن شعيب الحماني عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن علي بن عبد الصمد علان ماغمه عن الطبراني","حبيب بن أبي ثابت عن الحسن بن علي رضي الله عنه"
"2751","أُمُّ أُنَيْسٍ بِنْتُ الْحَسَنِ بْنِ عَلِيٍّ  عَنْ أَبِيهَا  2753  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ حَمْدَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  شُعَيْبُ بْنُ عَبْدِ الْحَمِيدِ الطَّحَّانُ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  شَيْبَانُ ،  عَنِ  الْحَكَمِ بْنِ عَبْدِ اللهِ بْنِ خَطَّافٍ ،  عَنْ  أُمِّ أُنَيْسٍ بِنْتِ الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُمَا ،  عَنْ  أَبِيهَا  ، قَالَ :  قَالُوا : يَا رَسُولَ اللهِ أَرَأَيْتَ قَوْلَ اللهِ عَزَّ وَجَلَّ :         {      إِنَّ اللهَ وَمَلائِكَتَهُ يُصَلُّونَ عَلَى النَّبِيِّ         }      ؟ قَالَ :  إِنَّ هَذَا لَمِنْ مَكْتُومٍ ، وَلَوْلَا أَنَّكُمْ سَأَلْتُمُونِي عَنْهُ مَا أَخْبَرْتُكُمْ  ، إِنَّ اللهَ عَزَّ وَجَلَّ وَكَّلَ بِي مَلَكَيْنِ ، لَا أُذْكَرُ عِنْدَ عَبْدٍ مُسْلِمٍ فَيُصَلِّي عَلَيَّ إِلَّا قَالَ ذَانِكَ الْمَلَكَانِ : غَفَرَ اللهُ لَكَ ، وَقَالَ اللهُ وَمَلَائِكَتُهُ جَوَابًا لِذَيْنِكَ الْمَلَكَيْنِ : آمِينَ ، وَلَا يُصَلِّي عَلَيَّ أَحَدٌ إِلَّا قَالَ ذَانِكَ الْمَلَكَانِ : غَفَرَ اللهُ لَكَ ، وَقَالَ اللهُ وَمَلَائِكَتُهُ جَوَابًا لِذَيْنِكَ الْمَلَكَيْنِ : آمِينَ  .","","Al-Mu'jam al-Kabir 2753","","الحسن بن علي سبط رسول الله عن أم أنيس بنت الحسن بن علي عن أبو سلمة العاملي عن شيبان بن عبد الرحمن المؤدب عن يزيد بن هارون عن شعيب بن عبد الحميد الواسطي عن العباس بن حمدان الأصبهاني عن الطبراني","أم أنيس بنت الحسن بن علي عن أبيها"
"2752","يُوسُفُ بْنُ مَازِنٍ الرَّاسِبِيُّ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  2754  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ ، وَالْعَبَّاسُ بْنُ حَمْدَانَ الْحَنَفِيُّ ، قَالَا :         [3/90]      ثَنَا  زَيْدُ بْنُ أَخْزَمَ ،  ثَنَا  أَبُو دَاوُدَ ،  ثَنَا  الْقَاسِمُ بْنُ الْفَضْلِ ،  عَنْ  يُوسُفَ بْنِ مَازِنٍ الرَّاسِبِيِّ ، قَالَ :  قَامَ  رَجُلٌ  إِلَى الْحَسَنِ بْنِ عَلِيٍّ ، فَقَالَ : سَوَّدْتَ وُجُوهَ الْمُؤْمِنِينَ . فَقَالَ : "" لَا  تُؤَنِّبْنِي  رَحِمَكَ اللهُ ،  فَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ أُرِيَ  بَنِي أُمَيَّةَ  يَخْطُبُونَ عَلَى مِنْبَرِهِ رَجُلًا فَرَجُلًا ، فَسَاءَهُ ذَلِكَ  ، فَنَزَلَتْ هَذِهِ الْآيَةُ :         {      إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ         }      نَهَرٌ فِي الْجَنَّةِ ، وَنَزَلَتْ :         {      إِنَّا أَنْـزَلْنَاهُ فِي لَيْلَةِ الْقَدْرِ             *          وَمَا أَدْرَاكَ مَا لَيْلَةُ الْقَدْرِ             *          لَيْلَةُ الْقَدْرِ خَيْرٌ مِنْ أَلْفِ شَهْرٍ         }      ، تَمْلِكُهُ  بَنُو أُمَيَّةَ  .  قَالَ  الْقَاسِمُ  : ""  فَحَسَبْنَا ذَلِكَ ، فَإِذَا هُوَ أَلْفٌ لَا يَزِيدُ وَلَا يَنْقُصُ  "" .","","Al-Mu'jam al-Kabir 2754","","الحسن بن علي سبط رسول الله عن يوسف بن مازن الراسبي عن القاسم بن الفضل بن معدان عن أبو داود الطيالسي عن زيد بن أخزم الطائي عن العباس بن حمدان الأصبهاني عن الطبراني","يوسف بن مازن الراسبي عن الحسن بن علي رضي الله عنه"
"2753","عَطَاءُ بْنُ أَبِي رَبَاحٍ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  2755  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَبَانَ الْوَاسِطِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ الْمُزَنِيُّ ،  عَنْ  سَعِيدِ بْنِ الْمَرْزُبَانِ أَبِي سَعْدٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يُحْشَرُ النَّاسُ يَوْمَ الْقِيَامَةِ حُفَاةً عُرَاةً  . فَقَالَتِ  امْرَأَةٌ  : يَا رَسُولَ اللهِ ، فَكَيْفَ يَرَى بَعْضُنَا بَعْضًا ؟ قَالَ : "" إِنَّ الْأَبْصَارَ يَوْمَئِذٍ شَاخِصَةٌ "" . فَرَفَعَ بَصَرَهُ إِلَى السَّمَاءِ ، فَقَالَتْ : يَا رَسُولَ اللهِ ، ادْعُ اللهَ أَنْ يَسْتُرَ  عَوْرَتِي  . قَالَ : "" اللَّهُمَّ اسْتُرْ  عَوْرَتَهَا  .","","Al-Mu'jam al-Kabir 2755","","الحسن بن علي سبط رسول الله عن عطاء بن أبي رباح عن سعيد بن المرزبان عن محمد بن الحسن المزني عن محمد بن أبان بن عمران السلمي عن الحسين بن إسحاق التستري عن الطبراني","عطاء بن أبي رباح عن الحسن بن علي"
"2754","إِسْحَاقُ بْنُ بُزْرُجَ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  2756  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  إِسْحَاقُ بْنُ بُزْرُجَ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  أَمَرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ نَلْبَسَ أَجْوَدَ مَا نَجِدُ  ، وَأَنْ نَتَطَيَّبَ بِأَجْوَدِ مَا نَجِدُ ، وَأَنْ نُضَحِّيَ بِأَسْمَنِ مَا نَجِدُ ، الْبَقَرَةُ عَنْ سَبْعَةٍ ،  وَالْجَزُورُ  عَنْ         [3/91]      عَشَرَةٍ ، وَأَنْ نُظْهِرَ التَّكْبِيرَ وَعَلَيْنَا  السَّكِينَةُ  وَالْوَقَارُ  .","","Al-Mu'jam al-Kabir 2756","","الحسن بن علي سبط رسول الله عن إسحاق بن بزرج الفارسي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","إسحاق بن بزرج عن الحسن بن علي رضي الله عنه"
"2755","سُوَيْدُ بْنُ غَفَلَةَ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  2757  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ حُمَيْدٍ الرَّازِيُّ ،  ثَنَا  سَلَمَةُ بْنُ الْفَضْلِ ،  حَدَّثَنَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ عَبْدِ الْأَعْلَى ،  عَنْ  سُوَيْدِ بْنِ غَفَلَةَ ، قَالَ :  كَانَتْ  عَائِشَةُ بِنْتُ خَلِيفَةَ الْخَثْعَمِيَّةُ  عِنْدَ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ ، فَلَمَّا أُصِيبَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ وَبُويِعَ  لِلْحَسَنِ  رَضِيَ اللهُ عَنْهُ بِالْخِلَافَةِ ، دَخَلَ عَلَيْهَا ، فَقَالَتْ : لِتَهْنِكَ الْخِلَافَةُ . فَقَالَ لَهَا : أَتُظْهِرِينَ  الشَّمَاتَةَ  بِقَتْلِ  عَلِيٍّ  ، انْطَلِقِي فَأَنْتِ طَالِقٌ ثَلَاثًا . فَتَقَنَّعَتْ  بِسَاجٍ  لَهَا ، وَجَلَسَتْ فِي نَاحِيَةِ الْبَيْتِ ، وَقَالَتْ : أَمَا وَاللهِ مَا أَرَدْتُ مَا ذَهَبْتَ إِلَيْهِ . فَأَقَامَتْ حَتَّى انْقَضَتْ عِدَّتُهَا ، ثُمَّ تَحَوَّلَتْ عَنْهُ ، فَبَعَثَ إِلَيْهَا بِبَقِيَّةٍ بَقِيَتْ لَهَا مِنْ صَدَاقِهَا عَلَيْهِ ، وَبِمُتْعَةٍ عَشَرَةِ آلَافٍ ، فَلَمَّا جَاءَهَا الرَّسُولُ بِذَلِكَ قَالَتْ : مَتَاعٌ قَلِيلٌ مِنْ حَبِيبٍ مُفَارِقٍ .  فَلَمَّا رَجَعَ الرَّسُولُ إِلَى  الْحَسَنِ  فَأَخْبَرَهُ بِمَا قَالَتْ ، بَكَى الْحَسَنُ بْنُ عَلِيٍّ رَضِيَ اللهُ عَنْهُ ، وَقَالَ :  لَوْلَا أَنِّي سَمِعْتُ جَدِّي رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَوْ  سَمِعْتُ  أَبِي  يُحَدِّثُ عَنْ جَدِّي  أَنَّهُ قَالَ :  إِذَا طَلَّقَ الرَّجُلُ امْرَأَتَهُ ثَلَاثًا عِنْدَ  الْأَقْرَاءِ  ، أَوْ طَلَّقَهَا ثَلَاثًا مُبْهَمَةً ؛ لَمْ تَحِلَّ لَهُ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ "" ؛ لَرَاجَعْتُهَا  .","","Al-Mu'jam al-Kabir 2757","","علي بن أبي طالب عن الحسن بن علي سبط رسول الله عن سويد بن غفلة المذحجي عن إبراهيم بن عبد الأعلى الجعفي مولاهم عن عمرو بن أبي قيس عن سلمة بن الفضل الأبرش عن محمد بن حميد الرازي عن علي بن سعيد بن بشير عليك عن الطبراني","سويد بن غفلة عن الحسن بن علي"
"2756","عَلِيُّ بْنُ أَبِي طَلْحَةَ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  2758  -  حَدَّثَنَا  عَلِيُّ بْنُ إِسْحَاقَ الْوَزِيرُ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ مُوسَى السَّدُوسِيُّ ،  ثَنَا  سَعِيدُ بْنُ خَيْثَمٍ الْهِلَالِيُّ ،  عَنِ  الْوَلِيدِ بْنِ يَسَارٍ الْهَمْدَانِيِّ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَلْحَةَ مَوْلَى بَنِي أُمَيَّةَ ، قَالَ :  حَجَّ  مُعَاوِيَةُ بْنُ أَبِي سُفْيَانَ  وَحَجَّ مَعَهُ  مُعَاوِيَةُ بْنُ حُدَيْجٍ  ، وَكَانَ مِنْ أَسَبِّ النَّاسِ  لِعَلِيٍّ  ، فَمَرَّ فِي  الْمَدِينَةِ         [3/92]      فِي  مَسْجِدِ الرَّسُولِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَالْحَسَنُ بْنُ عَلِيٍّ جَالِسٌ فِي نَفَرٍ مِنْ أَصْحَابِهِ ، فَقِيلَ لَهُ : هَذَا  مُعَاوِيَةُ بْنُ حُدَيْجٍ  السَّابُّ  لِعَلِيٍّ  رَضِيَ اللهُ عَنْهُ . فَقَالَ : عَلَيَّ بِالرَّجُلِ . فَأَتَاهُ الرَّسُولُ ، فَقَالَ : أَجِبْ . قَالَ : مَنْ ؟ قَالَ :  الْحَسَنُ بْنُ عَلِيٍّ  يَدْعُوكَ . فَأَتَاهُ فَسَلَّمَ عَلَيْهِ ، فَقَالَ لَهُ  الْحَسَنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ : أَنْتَ  مُعَاوِيَةُ بْنُ حُدَيْجٍ  ؟ قَالَ : نَعَمْ . فَرَدَّ عَلَيْهِ ثَلَاثًا ، فَقَالَ لَهُ  الْحَسَنُ  : السَّابُّ  لِعَلِيٍّ  ؟ فَكَأَنَّهُ اسْتَحْيَى ، فَقَالَ لَهُ  الْحَسَنُ  رَضِيَ اللهُ عَنْهُ :  أَمْ وَاللهِ لَئِنْ وَرَدْتَ عَلَيْهِ الْحَوْضَ ، وَمَا أُرَاكَ أَنْ تَرِدَهُ  ، لَتَجِدَنَّهُ مُشَمِّرَ الْإِزَارِ عَلَى سَاقٍ يَذُودُ الْمُنَافِقِينَ ذَوْدَ  غَرِيبَةِ  الْإِبِلِ ، قَوْلُ الصَّادِقِ الْمَصْدُوقِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،         {      وَقَدْ خَابَ مَنِ افْتَرَى         }      "" .","","Al-Mu'jam al-Kabir 2758","","الحسن بن علي سبط رسول الله عن علي بن أبي طلحة العباسي عن الوليد بن يسار الهمداني عن سعيد بن خثيم الهلالي عن إسماعيل بن موسى الفزاري عن الوزير علي بن إسحاق بن إبراهيم عن الطبراني","علي بن أبي طلحة عن الحسن بن علي رضي الله عنه"
"2757","فُلْفُلَةُ الْجُعْفِيُّ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  2759  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ الْأَصْبَهَانِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  ثَنَا  سَعِيدُ بْنُ مُحَمَّدٍ الْوَرَّاقُ ،  ثَنَا  فُضَيْلُ بْنُ غَزْوَانَ ،  حَدَّثَنَا  أَبُو الْمُغِيرَةِ الذُّهْلِيُّ ،  حَدَّثَنِي  فُلْفُلَةُ الْجُعْفِيُّ ، قَالَ :  سَمِعْتُ  الْحَسَنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ يَقُولُ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْمَنَامِ مُتَعَلِّقًا بِالْعَرْشِ  ، وَرَأَيْتُ  أَبَا بَكْرٍ  رَضِيَ اللهُ عَنْهُ أَخَذَ بِحَقْوَيِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَرَأَيْتُ  عُمَرَ  رَضِيَ اللهُ عَنْهُ أَخَذَ بِحَقْوَيْ  أَبِي بَكْرٍ  رَضِيَ اللهُ عَنْهُ ، وَرَأَيْتُ  عُثْمَانَ  رَضِيَ اللهُ عَنْهُ أَخَذَ بِحَقْوَيْ  عُمَرَ  رَضِيَ اللهُ عَنْهُ ، وَرَأَيْتُ الدَّمَ يَنْصَبُّ مِنَ السَّمَاءِ إِلَى الْأَرْضِ "" . فَحَدَّثَ  الْحَسَنُ  بِهَذَا الْحَدِيثِ وَعِنْدَهُ قَوْمٌ مِنَ الشِّيعَةِ ، فَقَالُوا : وَمَا رَأَيْتَ  عَلِيًّا  ؟ فَقَالَ  الْحَسَنُ  : "" مَا كَانَ أَحَدٌ أَحَبَّ إِلَيَّ أَنْ أَرَاهُ أَخَذَ بِحَقْوَيِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ  عَلِيٍّ  ، وَلَكِنَّهَا رُؤْيَا رَأَيْتُهَا  "" .","","Al-Mu'jam al-Kabir 2759","","الحسن بن علي سبط رسول الله عن فلفلة بن عبد الله الجعفي عن أبو المغيرة عن فضيل بن غزوان عن سعيد بن محمد الوراق عن إبراهيم بن سعيد الجوهري عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","فلفلة الجعفي عن الحسن بن علي رضي الله عنه"
"2758","الْأَصْبَغُ بْنُ نُبَاتَةَ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  2760  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ سَيْفٍ ،  ثَنَا         [3/93]      جَعْفَرُ بْنُ سُلَيْمَانَ ،  عَنْ  سَعْدِ بْنِ طَرِيفٍ ،  عَنِ  الْأَصْبَغِ بْنِ نُبَاتَةَ ، قَالَ :  دَخَلْتُ مَعَ  عَلِيِّ بْنِ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُ إِلَى الْحَسَنِ بْنِ عَلِيٍّ نَعُودُهُ ، فَقَالَ لَهُ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ : كَيْفَ أَصْبَحْتَ يَا ابْنَ رَسُولِ اللهِ ؟ قَالَ : أَصْبَحْتُ بِحَمْدِ اللهِ  بَارِئًا  . قَالَ : كَذَلِكَ إِنْ شَاءَ اللهُ . ثُمَّ قَالَ  الْحَسَنُ  رَضِيَ اللهُ عَنْهُ : اسْنِدُونِي . فَأَسْنَدَهُ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ إِلَى صَدْرِهِ ،  فَقَالَ  : سَمِعْتُ جَدِّي رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ فِي الْجَنَّةِ  شَجَرَةً  يُقَالُ لَهَا  شَجَرَةُ  الْبَلْوَى  ، يُؤْتَى بِأَهْلِ الْبَلَاءِ يَوْمَ الْقِيَامَةَ ، فَلَا يُرْفَعُ لَهُمْ دِيوَانٌ ، وَلَا يُنْصَبُ لَهُمْ مِيزَانٌ ، يُصَبُّ عَلَيْهِمُ الْأَجْرُ صَبًّا "" ، وَقَرَأَ :         {      إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُمْ بِغَيْرِ حِسَابٍ         }      .","","Al-Mu'jam al-Kabir 2760","","الحسن بن علي سبط رسول الله عن أصبغ بن نباتة الكوفي عن سعد بن طريف الإسكاف عن جعفر بن سليمان الضبعي عن إسماعيل بن سيف القطعي عن إبراهيم بن هاشم البغوي عن الطبراني","الأصبغ بن نباتة عن الحسن بن علي رضي الله عنه"
"2759","أَبُو جَمِيلَةَ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا  2761  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدٌ ،  عَنْ  حُصَيْنٍ ،  عَنْ  أَبِي جَمِيلَةَ  أَنَّ  الْحَسَنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ حِينَ قُتِلَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ اسْتُخْلِفَ  ، فَبَيْنَمَا هُوَ يُصَلِّي بِالنَّاسِ إِذْ وَثَبَ عَلَيْهِ  رَجُلٌ  ، فَطَعَنَهُ بِخِنْجَرٍ فِي وَرِكِهِ ، فَتَمَرَّضَ مِنْهَا أَشْهُرًا ، ثُمَّ قَامَ عَلَى الْمِنْبَرِ يَخْطُبُ ، فَقَالَ : "" يَا  أَهْلَ الْعِرَاقِ  اتَّقُوا اللهَ فِينَا ، فَإِنَّا أُمَرَاؤُكُمْ وَضِيفَانُكُمْ ، وَنَحْنُ  أَهْلُ الْبَيْتِ  الَّذِي قَالَ اللهُ عَزَّ وَجَلَّ :         {      إِنَّمَا يُرِيدُ اللهُ لِيُذْهِبَ عَنْكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا         }      . فَمَا زَالَ يَوْمَئِذٍ يَتَكَلَّمُ حَتَّى مَا يُرَى فِي الْمَسْجِدِ إِلَّا بَاكِيًا  .","","Al-Mu'jam al-Kabir 2761","","الحسن بن علي سبط رسول الله عن ميسرة بن يعقوب الطهوي عن حصين بن عبد الرحمن السلمي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","أبو جميلة عن الحسن بن علي رضي الله عنهما"
"2760","طَلْحَةُ بْنُ عُبَيْدِ اللهِ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  2762  -  حَدَّثَنَا  أَحْمَدُ بْنُ حَمُّويَةَ أَبُو سَيَّارٍ التُّسْتَرِيُّ ،  ثَنَا  بِشْرُ بْنُ مُعَاذٍ الْعَقَدِيُّ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ الْوَاسِطِيُّ ،  ثَنَا  يَحْيَى بْنُ الْعَلَاءِ ،  عَنْ  طَلْحَةَ بْنِ         [3/94]      عُبَيْدِ اللهِ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَتَتْهُ هَدِيَّةٌ وَعِنْدَهُ قَوْمٌ جُلُوسٌ فَهُمْ شُرَكَاؤُهُ فِيهَا  "" .","","Al-Mu'jam al-Kabir 2762","","الحسن بن علي سبط رسول الله عن طلحة بن عبيد الله بن كريز الخزاعي عن يحيى بن العلاء الفوراردي عن يحيى بن سعيد الأنصاري عن بشر بن معاذ عن أحمد بن حمويه التستري عن الطبراني","طلحة بن عبيد الله عن الحسن بن علي رضي الله عنه"
"2761","2763  -  حَدَّثَنَا  الْقَاسِمُ بْنُ مُحَمَّدٍ الدَّلَّالُ  ، ثَنَا  مُخَوَّلُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  كَامِلٌ أَبُو الْعَلَاءِ ،  عَنْ  عَبْدِ اللهِ بْنِ سُلَيْمَانَ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَطْعِمُوا الطَّعَامَ  ، وَأَطْيِبُوا الْكَلَامَ  "" .","","Al-Mu'jam al-Kabir 2763","","الحسن بن علي سبط رسول الله عن عبد الله بن سليمان عن كامل بن العلاء التميمي عن مخول بن إبراهيم الكوفي عن قاسم بن محمد بن حماد الدلال عن الطبراني","طلحة بن عبيد الله عن الحسن بن علي رضي الله عنه"
"2762","عُمَرُ بْنُ إِسْحَاقَ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا  2764  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ عَوْنٍ ،  عَنْ  عُمَيْرِ بْنِ إِسْحَاقَ  أَنَّ  أَبَا هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ لَقِيَ  الْحَسَنَ بْنَ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا ، فَقَالَ :  ارْفَعْ ثَوْبَكَ حَتَّى أُقَبِّلَ حَيْثُ رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُقَبِّلُ  . فَرَفَعَ عَنْ بَطْنِهِ ، وَوَضَعَ يَدَهُ عَلَى سُرَّتِهِ  .","","Al-Mu'jam al-Kabir 2764","","أبو هريرة الدوسي عن عمير بن إسحاق الهاشمي عن عبد الله بن عون بن أرطبان عن أبو عاصم النبيل عن أبو مسلم الكجي عن الطبراني","عمر بن إسحاق عن الحسن بن علي رضي الله عنهما"
"2763","2765  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  ابْنُ الْأَصْبَهَانِيِّ ،  ثَنَا  شَرِيكٌ ،  عَنِ  ابْنِ عَوْنٍ ،  عَنْ  عُمَيْرِ بْنِ إِسْحَاقَ  أَنَّ  أَبَا هُرَيْرَةَ لَقِيَ  الْحَسَنَ بْنَ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا  ، فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 2765","","أبو هريرة الدوسي عن عمير بن إسحاق الهاشمي عن عبد الله بن عون بن أرطبان عن شريك بن عبد الله النخعي عن محمد بن سعيد حمدان عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمر بن إسحاق عن الحسن بن علي رضي الله عنهما"
"2764","236 -  الْحُسَيْنُ بْنُ عَلِيِّ بْنِ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُ يُكَنَّى أَبَا عَبْدِ اللهِ  ذِكْرُ مَوْلِدِهِ وَصِفَتِهِ وَهَيْئَتِهِ رَضِيَ اللهُ عَنْهُ  وَكَرَّمَ اللهُ وَجْهَهُ وَعَنْ أَبِيهِ وَأُمِّهِ .  2766  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ سَعِيدٍ         [3/95]      الْكِنْدِيُّ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  لَمْ يَكُنْ بَيْنَ  الْحَسَنِ  وَالْحُسَيْنِ  إِلَّا طُهْرٌ  "" .","","Al-Mu'jam al-Kabir 2766","","أبو جعفر الباقر عن جعفر الصادق عن حفص بن غياث النخعي عن عبد الله بن سعيد الأشج عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2765","2767  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  ضِرَارُ بْنُ صُرَدٍ ،  حَدَّثَنَا  عَبْدُ الْكَرِيمِ بْنُ يَعْفُورٍ الْجُعْفِيُّ ،  عَنْ  جَابِرٍ ،  عَنْ  أَبِي الشَّعْثَاءِ ،  عَنْ  بِشْرِ بْنِ غَالِبٍ ، قَالَ :  كُنْتُ مَعَ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، فَرَأَى  الْحُسَيْنَ بْنَ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا ، فَقَالَ : يَا  أَبَا عَبْدِ اللهِ  ، لَقَدْ رَأَيْتُكَ عَلَى يَدَيْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ خَضَّبْتَهَا دَمًا حِينَ أَتَى بِكَ حِينَ وُلِدْتَ ، فَسَرَّرَكَ وَلَفَّكَ فِي خِرْقَةٍ ، وَلَقَدْ  تَفَلَ  فِي فِيكَ ، وَتَكَلَّمَ بِكَلَامٍ مَا أَدْرِي مَا هُوَ ،  وَلَقَدْ كَانَتْ  فَاطِمَةُ  رَضِيَ اللهُ عَنْهَا سَبَقَتْهُ بِقَطْعِ  سُرَّةِ  الْحَسَنِ  رَضِيَ اللهُ عَنْهُ ، فَقَالَ : "" لَا تَسْبِقِينِي بِهَا  "" .","","Al-Mu'jam al-Kabir 2767","","أبو هريرة الدوسي عن بشر بن غالب بن جنادة الأسدي عن جابر بن زيد اليحمدي عن جابر الجعفي عن عبد الكريم بن يعفور الجعفي عن ضرار بن صرد التيمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2766","2768  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ سَالِمٍ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ يُوسُفَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هُبَيْرَةَ بْنِ يَرِيمَ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  مَنْ سَرَّهُ أَنْ يَنْظُرَ إِلَى أَشْبَهِ النَّاسِ بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مَا بَيْنَ عُنُقِهِ إِلَى وَجْهِهِ فَلْيَنْظُرْ إِلَى  الْحَسَنِ بْنِ عَلِيٍّ  ، وَمَنْ سَرَّهُ أَنْ يَنْظُرَ إِلَى أَشْبَهِ النَّاسِ بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَا بَيْنَ عُنُقِهِ إِلَى كَعْبِهِ خَلْقًا وَلَوْنًا فَلْيَنْظُرْ إِلَى  الْحُسَيْنِ بْنِ عَلِيٍّ  "" .","","Al-Mu'jam al-Kabir 2768","","علي بن أبي طالب عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن يوسف بن إسحاق بن أبي إسحاق السبيعي عن إبراهيم بن يوسف بن إسحاق بن أبي إسحاق السبيعي عن عبد الله بن سالم المفلوج عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2767","2769  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَ :  وَجَدْتُ فِي كِتَابِ  عُقْبَةَ بْنِ قَبِيصَةَ :  حَدَّثَنَا  أَبِي  ،  عَنْ  حَمْزَةَ الزَّيَّاتِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هُبَيْرَةَ بْنِ يَرِيمَ ،  عَنْ  عَلِيٍّ ، قَالَ :  مَنْ أَرَادَ أَنْ يَنْظُرَ إِلَى وَجْهِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مِنْ رَأْسَهِ إِلَى عُنُقِهِ فَلْيَنْظُرْ إِلَى  الْحَسَنِ  ، وَمَنْ أَرَادَ أَنْ يَنْظُرَ إِلَى مَا لَدُنْ عُنُقِهِ فَلْيَنْظُرْ إِلَى  الْحُسَيْنِ  ، اقْتَسَمَاهُ  "" .","","Al-Mu'jam al-Kabir 2769","","علي بن أبي طالب عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن حمزة الزيات عن قبيصة بن عقبة السوائي عن عقبة بن قبيصة بن عقبة العامري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2768","2770  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَوْنُ بْنُ سَلَّامٍ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هُبَيْرَةَ بْنِ يَرِيمَ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  كَانَ  الْحَسَنُ  أَشْبَهَ النَّاسِ بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مِنَ النَّحْرِ فَصَاعِدًا  "" .  فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2770","","علي بن أبي طالب عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن قيس بن الربيع الأسدي عن عون بن سلام الهاشمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2769","[3/96]      2771  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبَّادِ بْنِ أَبِي زَائِدَةَ ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هُبَيْرَةَ بْنِ يَرِيمَ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  أَشْبَهُ النَّاسِ بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَا بَيْنَ رَأْسِهِ إِلَى نَحْرِهِ  الْحَسَنُ  "" .","","Al-Mu'jam al-Kabir 2771","","علي بن أبي طالب عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن زكريا بن أبي زائدة الوادعي عن يحيى بن زكريا بن أبي زائدة عن محمد بن عباد بن زكريا بن أبي زائدة عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2770","2772  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ  ، ثَنَا  أَحْمَدُ بْنُ خَالِدٍ الْوَهْبِيُّ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هُبَيْرَةَ بْنِ يَرِيمَ ،  عَنْ  عَلِيٍّ ، قَالَ :  الْحَسَنُ  أَشْبَهُ النَّاسِ بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مَا بَيْنَ الرَّأْسِ إِلَى النَّحْرِ  "" .","","Al-Mu'jam al-Kabir 2772","","علي بن أبي طالب عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن أحمد بن خالد بن موسى الوهبي عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2771","2773  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، حَدَّثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هَانِي بْنِ هَانِي ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  لَمَّا وُلِدَ  الْحَسَنُ  سَمَّيْتُهُ  حَرْبًا  ، فَجَاءَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" أَرُونِي ابْنِي مَا سَمَّيْتُمُوهُ ؟ "" فَقُلْتُ : حَرْبًا . فَقَالَ : "" بَلْ هُوَ  حَسَنٌ  "" . فَلَمَّا وُلِدَ  الْحُسَيْنُ  سَمَّيْنَاهُ  حَرْبًا  ، فَأَتَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" ائْتُونِي ابْنِي مَا سَمَّيْتُمُوهُ ؟ "" فَقُلْتُ : حَرْبًا . فَقَالَ : "" بَلْ هُوَ  حُسَيْنٌ  "" . فَلَمَّا وُلِدَ الثَّالِثُ سَمَّيْتُهُ  حَرْبًا  ، فَجَاءَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" أَرُونِي ابْنِي مَا سَمَّيْتُمُوهُ ؟ "" فَقُلْتُ : حَرْبًا . فَقَالَ : "" بَلْ هُوَ  مُحَسِّنٌ  "" . ثُمَّ قَالَ :  إِنِّي سَمَّيْتُهُمْ بِأَسْمَاءِ وَلَدِ  هَارُونَ  شَبَّرَ  وَشَبِيرًا  وَمُشَبِّرَ  "" .","","Al-Mu'jam al-Kabir 2773","","علي بن أبي طالب عن هانئ بن هانئ المرادي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن عثمان بن حفص الضبي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2772","2774  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ سَهْلِ بْنِ مُحَمَّدٍ الْعَسْكَرِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هَانِي بْنِ هَانِي ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  لَمَّا وُلِدَ  الْحَسَنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ جَاءَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" أَرُونِي ابْنِي مَا سَمَّيْتُمُوهُ ؟ "" قُلْتُ : سَمَّيْتُهُ  حَرْبًا  . قَالَ : "" بَلْ هُوَ  حَسَنٌ  "" . فَلَمَّا وُلِدَ  الْحُسَيْنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ جَاءَ ، فَقَالَ مِثْلَ قَوْلِهِ ، فَقُلْتُ : سَمَّيْتُهُ  حَرْبًا  . فَقَالَ : "" بَلْ هُوَ  حُسَيْنٌ  "" . فَلَمَّا وَلَدْتُ         [3/97]      الثَّالِثَ جَاءَ ، فَقَالَ مِثْلَ قَوْلِهِ ، فَقُلْتُ : سَمَّيْتُهُ  حَرْبًا  . فَقَالَ : "" بَلْ هُوَ  مُحَسِّنٌ  "" . ثُمَّ قَالَ :  سَمَّيْتُهُمْ بِوَلَدِ  هَارُونَ  شَبَّرَ  وَشَبِيرَ  وَمُشَبِّرَ  "" .","","Al-Mu'jam al-Kabir 2774","","علي بن أبي طالب عن هانئ بن هانئ المرادي عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زكريا بن أبي زائدة الوادعي عن يحيى بن زكريا بن أبي زائدة عن سهل بن عثمان العسكري عن محمد بن يحيى بن سهل بن محمد العسكري عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2773","2775  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هَانِي بْنِ هَانِي ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  كُنْتُ أُحِبُّ أَنْ أَكْتَنِيَ  بِأَبِي حَرْبٍ  ، فَلَمَّا وُلِدَ  الْحَسَنُ  سَمَّيْتُهُ  حَرْبًا  ، فَجَاءَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  مَا سَمَّيْتُمْ ؟ "" فَقُلْتُ : سَمَّيْتُهُ  حَرْبًا  . فَقَالَ : "" هُوَ  الْحَسَنُ  "" .","","Al-Mu'jam al-Kabir 2775","","علي بن أبي طالب عن هانئ بن هانئ المرادي عن أبو إسحاق السبيعي عن قيس بن الربيع الأسدي عن إسماعيل بن عمرو البجلي عن محمد بن أبان الأصبهاني عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2774","2776  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ يُوسُفَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هَانِي بْنِ هَانِي ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  لَمَّا وُلِدَ  الْحَسَنُ  سَمَّيْتُهُ  حَرْبًا  ، فَقَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بِمَ سَمَّيْتَهُ ؟ "" فَقُلْتُ :  حَرْبًا  . فَقَالَ : "" لَا ، وَلَكِنْ سَمِّهِ  حَسَنًا  . ثُمَّ وُلِدَ  الْحُسَيْنُ  ، فَسَمَّيْتُهُ  حَرْبًا  ، فَقَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَا سَمَّيْتَهُ ؟ "" فَقُلْتُ :  حَرْبًا  . قَالَ : "" بَلْ سَمِّهِ  حُسَيْنًا  "" . ثُمَّ وُلِدَ آخَرُ ، فَسَمَّيْتُهُ  حَرْبًا  ، فَقَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَا سَمَّيْتَهُ ؟ "" قُلْتُ :  حَرْبًا  . قَالَ : "" سَمِّهِ  مُحْسِنًا  "" .","","Al-Mu'jam al-Kabir 2776","","علي بن أبي طالب عن هانئ بن هانئ المرادي عن أبو إسحاق السبيعي عن يوسف بن إسحاق بن أبي إسحاق السبيعي عن إبراهيم بن يوسف بن إسحاق بن أبي إسحاق السبيعي عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2775","2777  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  يَحْيَى بْنُ عِيسَى الرَّمْلِيُّ التَّمِيمِيُّ ،  ثَنَا  الْأَعْمَشُ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ، قَالَ :  قَالَ  عَلِيٌّ رَضِيَ اللهُ عَنْهُ :  كُنْتُ رَجُلًا أُحِبُّ الْحَرْبَ ، فَلَمَّا وُلِدَ  الْحَسَنُ  هَمَمْتُ أَنْ أُسَمِّيَهُ  حَرْبًا  ، فَسَمَّاهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْحَسَنَ  ، فَلَمَّا وُلِدَ  الْحُسَيْنُ  هَمَمْتُ أَنْ أُسَمِّيَهُ  حَرْبًا  ، فَسَمَّاهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْحُسَيْنَ  ، وَقَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنِّي سَمَّيْتُ ابْنَيَّ هَذَيْنِ بِاسْمِ ابْنَيْ  هَارُونَ  شَبَّرَ  وَشَبِيرًا  "" .","","Al-Mu'jam al-Kabir 2777","","علي بن أبي طالب عن سالم بن أبي الجعد الغطفاني عن الأعمش عن يحيى بن عيسى النهشلي عن عبد الله بن عمر مشكدانة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2776","2778  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  عَمْرُو بْنُ حُرَيْثٍ ،  ثَنَا  بَرْذَعَةُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي الْخَلِيلِ ،  عَنْ  سَلْمَانَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  سَمَّيْتُهُمَا -  يَعْنِي  الْحَسَنَ  وَالْحُسَيْنَ  - بِاسْمِ ابْنَيْ  هَارُونَ         [3/98]      شَبَرَ  وَشُبَيْرًا  "" .","","Al-Mu'jam al-Kabir 2778","","سلمان الفارسي عن عبد الله بن الخليل الحضرمي عن برذعة بن عبد الرحمن عن عمرو بن حريث عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2777","2779  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ أَبُو يَحْيَى ،  ثَنَا  حُسَيْنُ بْنُ مُحَمَّدٍ ،  ثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  أَنَسٍ  أَنَّ  الْحُسَيْنَ بْنَ عَلِيٍّ كَانَ يَخْضِبُ  بِالْوَسْمَةِ  "" .","","Al-Mu'jam al-Kabir 2779","","الحسين بن علي عن أنس بن مالك عن محمد بن سيرين عن جرير بن حازم عن الحسين بن محمد بن بهرام المروذي عن محمد بن عبد الرحيم  صاعقة عن عبد الله بن أحمد بن حنبل عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2778","2780  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ عَبْدِ اللهِ بْنِ زُرَارَةَ الرَّقِّيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  عَبْدِ اللهِ بْنِ عَقِيلٍ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ أَنَّهُ  سَمَّى ابْنَهُ الْأَكْبَرَ  حَمْزَةَ  ، وَسَمَّى  حُسَيْنًا  جَعْفَرًا  بِاسْمِ عَمِّهِ ،  فَسَمَّاهُمَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  حَسَنًا  وَحُسَيْنًا  "" .","","Al-Mu'jam al-Kabir 2780","","علي بن أبي طالب عن ابن الحنفية عن عبد الله بن محمد بن عقيل بن أبي طالب عن عبيد الله بن عمرو بن أبي الوليد عن إسماعيل بن عبد الله بن زرارة الثغري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2779","2781  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، وَعَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ، قَالَا :  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْعَيْزَارِ بْنِ حُرَيْثٍ ، قَالَ :  رَأَيْتُ  الْحَسَنَ وَالْحُسَيْنَ رَضِيَ اللهُ عَنْهُمَا يَخْضِبَانِ بِالْحِنَّاءِ  وَالْكَتَمِ  "" .","","Al-Mu'jam al-Kabir 2781","","الحسين بن علي عن العيزار بن حريث العبدي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن عثمان ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2780","2782  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ ،  عَنْ  قَيْسٍ مَوْلَى خَبَّابٍ ، قَالَ :  رَأَيْتُ  الْحَسَنَ وَالْحُسَيْنَ رَضِيَ اللهُ عَنْهُمَا يَخْضِبَانِ بِالسَّوَادِ  "" .","","Al-Mu'jam al-Kabir 2782","","الحسين بن علي عن قيس بن سعد عن عبد العزيز بن رفيع الطائفي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2781","2783  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ  ، قَالَ : ""  قُتِلَ  الْحُسَيْنُ بْنُ عَلِيٍّ  يَوْمَ عَاشُورَاءَ  فِي سَنَةِ إِحْدَى وَسِتِّينَ ، وَهُوَ ابْنُ ثَمَانٍ وَخَمْسِينَ سَنَةً ، وَكَانَ يَخْضِبُ بِالْحِنَّاءِ  وَالْكَتَمِ  "" .","","Al-Mu'jam al-Kabir 2783","","","ذكر مولده وصفته وهيأته رضي الله عنه"
"2782","2784  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ، قَالَ : ""  قُتِلَ  عَلِيٌّ  وَهُوَ ابْنُ ثَمَانٍ وَخَمْسِينَ ، وَلَهَا قُتِلَ  الْحُسَيْنُ بْنُ عَلِيٍّ  ، وَمَاتَ لَهَا  عَلِيُّ بْنُ الْحُسَيْنِ  ، وَمَاتَ لَهَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْحُسَيْنِ  "" .","","Al-Mu'jam al-Kabir 2784","","أبو جعفر الباقر عن جعفر الصادق عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2783","[3/99]      2785  - حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرٍ  ، ثَنَا  حُسَيْنُ بْنُ عَلِيٍّ الْجُعْفِيُّ  ، عَنْ  سُفْيَانَ بْنِ عُيَيْنَةَ  ، قَالَ : سَمِعْتُ  الْمَهْدِيَّ  سَأَلَ  جَعْفَرَ  :  كَمْ كَانَ  لِعَلِيٍّ  حِينَ قُتِلَ ؟ قَالَ : "" ثَمَانٍ وَخَمْسُونَ ، وَلَهَا قُتِلَ  الْحُسَيْنُ بْنُ عَلِيٍّ  "" .","","Al-Mu'jam al-Kabir 2785","","","ذكر مولده وصفته وهيأته رضي الله عنه"
"2784","2786  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، حَدَّثَنَا  أَحْمَدُ بْنُ جَوَّاسٍ الْحَنَفِيُّ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْعَيْزَارِ بْنِ حُرَيْثٍ ، قَالَ :  رَأَيْتُ  الْحُسَيْنَ بْنَ عَلِيٍّ يَخْضِبُ بِالسَّوَادِ  "" .","","Al-Mu'jam al-Kabir 2786","","الحسين بن علي عن العيزار بن حريث العبدي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن أحمد بن جواس الحنفي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2785","2787  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  كَامِلُ بْنُ طَلْحَةَ الْجَحْدَرِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ بُزْرُجَ ، قَالَ :  رَأَيْتُ  الْحَسَنَ وَالْحُسَيْنَ رَضِيَ اللهُ عَنْهُمَا ابْنَيْ  فَاطِمَةَ  رَضِيَ اللهُ عَنْهَا يَخْضِبَانِ بِالسَّوَادِ  ، وَكَانَ  الْحُسَيْنُ  يَدَعُ الْعَنْفَقَةَ  "" .","","Al-Mu'jam al-Kabir 2787","","الحسين بن علي عن عبد الرحمن بن بزرج عن عبد الله بن لهيعة عن كامل بن طلحة الجحدري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2786","2788  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ أَسَدٍ ،  ثَنَا  شَرِيكٌ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُهَاجِرٍ وَفِرَاسٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  دَخَلْتُ عَلَى الْحُسَيْنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ وَقَدْ خَضَبَ بِالسَّوَادِ  "" .","","Al-Mu'jam al-Kabir 2788","","الحسين بن علي عن الشعبي عن فراس بن يحيى الخارفي عن شريك بن عبد الله النخعي عن أحمد بن أسد بن عاصم بن مغول البجلي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2787","2789  -  حَدَّثَنَا  الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْمَاعِيلَ ،  عَنْ  جَعْفَرٍ ،  عَنْ  أَبِيهِ  أَنَّ  الْحُسَيْنَ بْنَ عَلِيٍّ كَانَ يَخْضِبُ بِالسَّوَادِ  "" .","","Al-Mu'jam al-Kabir 2789","","الحسين بن علي عن أبو جعفر الباقر عن جعفر الصادق عن محمد بن إسماعيل بن رجاء الزبيدي عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2788","2790  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  طَاهِرُ بْنُ أَبِي أَحْمَدَ الزُّبَيْرِيُّ ،  ثَنَا  مَعْنُ بْنُ عِيسَى ،  أَخْبَرَنِي  أَبُو مَعْشَرٍ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ، قَالَ :  رَأَيْتُ  الْحُسَيْنَ بْنَ عَلِيٍّ يَخْضِبُ بِالسَّوَادِ  "" .","","Al-Mu'jam al-Kabir 2790","","الحسين بن علي عن سعيد المقبري عن نجيح بن عبد الرحمن السندي عن معن بن عيسى عن طاهر بن أبى أحمد الزبيري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2789","2791  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  أَنَا  سُلَيْمُ بْنُ مُسْلِمٍ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَلِيِّ بْنِ الْحُسَيْنِ  أَنَّ  الْحُسَيْنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ كَانَ يَخْضِبُ بِالسَّوَادِ  "" .","","Al-Mu'jam al-Kabir 2791","","الحسين بن علي عن علي بن الحسين زين العابدين عن الزهري عن معمر بن راشد عن سليم بن مسلم الخشاب عن عبد الله بن عمر مشكدانة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2790","[3/100]      2792  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  سُلَيْمُ بْنُ مُسْلِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عُمَرَ بْنِ عَطَاءِ بْنِ أَبِي الْخُوَارِ ، وَعُبَيْدِ اللهِ بْنِ أَبِي يَزِيدَ ، قَالَا :  رَأَيْنَا  الْحُسَيْنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ يَخْضِبُ  بِالْوَسْمَةِ  "" .","","Al-Mu'jam al-Kabir 2792","","الحسين بن علي عن عبيد الله بن أبي يزيد الكناني عن ابن جريج عن سليم بن مسلم الخشاب عن عبد الله بن عمر مشكدانة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2791","2793  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  ثَنَا  لَيْثٌ ، قَالَ :  حَدَّثَنِي  الْخَيَّاطُ الَّذِي قَطَعَ لِلْحُسَيْنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَمِيصًا ، قَالَ : قُلْتُ : أَجْعَلُهُ عَلَى ظَهْرِ الْقَدَمِ ؟ قَالَ : "" لَا "" . قُلْتُ : فَأَجْعَلُهُ أَسْفَلَ مِنَ  الْكَعْبَيْنِ  ؟  فَقَالَ  :  مَا أَسْفَلَ مِنَ  الْكَعْبَيْنِ  فِي النَّارِ  "" .","","Al-Mu'jam al-Kabir 2793","","الحسين بن علي عن الخياط عن ليث بن أبي سليم عن حفص بن غياث النخعي عن محمد بن عبد الله بن نمير عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2792","2794  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدٍ الْهِلَالِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  مُسْتَقِيمُ بْنُ عَبْدِ الْمَلِكِ ، قَالَ :  رَأَيْتُ  عَلَى الْحَسَنِ وَالْحُسَيْنِ رَضِيَ اللهُ عَنْهُمَا جَوَارِبَ خَزٍّ مَنْصُوبٍ  ، وَرَأَيْتُهُمَا يَرْكَبَانِ الْبَرَاذِينَ التِّجَارِيَّةَ  "" .","","Al-Mu'jam al-Kabir 2794","","الحسين بن علي عن عثمان بن عبد الملك الحجازي عن إسماعيل بن عمرو البجلي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2793","2795  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ جَوَّاسٍ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْعَيْزَارِ بْنِ حُرَيْثٍ ، قَالَ :  رَأَيْتُ  عَلَى الْحُسَيْنِ بْنِ عَلِيٍّ كِسَاءَ خَزٍّ أَحْمَرَ  "" .","","Al-Mu'jam al-Kabir 2795","","الحسين بن علي عن العيزار بن حريث العبدي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن أحمد بن جواس الحنفي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2794","2796  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ الْحِمَّانِيُّ ، وَالْحُسَيْنُ بْنُ يَزِيدَ الطَّحَّانُ ، قَالَا :  ثَنَا  الْمُطَّلِبُ بْنُ زِيَادٍ ،  عَنِ  السُّدِّيِّ ، قَالَ :  رَأَيْتُ  الْحُسَيْنَ بْنَ عَلِيٍّ وَعَلَيْهِ عِمَامَةُ خَزٍّ  قَدْ خَرَجَ شَعَرُهُ مِنْ تَحْتِ الْعِمَامَةِ  "" .","","Al-Mu'jam al-Kabir 2796","","الحسين بن علي عن السدي الكبير عن المطلب بن زياد الثقفي عن الحسين بن يزيد بن يحيى الطحان عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2795","2797  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ أَسَدٍ ،  ثَنَا         [3/101]      شَرِيكٌ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُهَاجِرٍ وَفِرَاسٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  دَخَلْتُ عَلَى الْحُسَيْنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُمَا وَعَلَيْهِ ثَوْبُ خَزٍّ  "" .","","Al-Mu'jam al-Kabir 2797","","الحسين بن علي عن الشعبي عن فراس بن يحيى الخارفي عن شريك بن عبد الله النخعي عن أحمد بن أسد بن عاصم بن مغول البجلي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2796","2798  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  طَاهِرُ بْنُ أَبِي أَحْمَدَ الزُّبَيْرِيُّ ،  ثَنَا  مَعْنُ بْنُ عِيسَى ،  ثَنَا  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  أَنَّ  الْحُسَيْنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ كَانَ يَتَخَتَّمُ فِي الْيَسَارِ  "" .","","Al-Mu'jam al-Kabir 2798","","الحسين بن علي عن أبو جعفر الباقر عن جعفر الصادق عن سليمان بن بلال القرشي عن معن بن عيسى عن طاهر بن أبى أحمد الزبيري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2797","2799  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  عَمْرُو بْنُ عَوْنٍ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  أَبِي إِسْحَاقَ الْكُوفِيِّ ،  عَنْ  أَبِي عُكَّاشَةَ الْهَمْدَانِيِّ ، قَالَ :  رَأَيْتُ  عَلَى الْحُسَيْنِ يَوْمَ قُتِلَ يَلْمَقَ  سُنْدُسٍ  "" .","","Al-Mu'jam al-Kabir 2799","","الحسين بن علي عن أبو عكاشة الهمداني عن عبد الله بن ميسرة الحارثي عن هشيم بن بشير عن عمرو بن عون الواسطي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2798","2800  -  حَدَّثَنَا  أَبُو حَنِيفَةَ مُحَمَّدُ بْنُ حَنِيفَةَ الْوَاسِطِيُّ  ، ثَنَا  يَزِيدُ بْنُ عَمْرِو بْنِ الْبَرَاءِ الْغَنَوِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ الْهَيْثَمِ ، قَالَ :  كَانَ الْحُسَيْنُ بْنُ عَلِيٍّ رَضِيَ اللهُ عَنْهُ يَطُوفُ  بِالْبَيْتِ  ، فَأَرَادَ أَنْ يَسْتَلِمَ الْحَجَرَ ، فَأَوْسَعَ النَّاسُ لَهُ ،  وَالْفَرَزْدَقُ بْنُ غَالِبٍ  يَنْظُرُ إِلَيْهِ ، فَقَالَ  رَجُلٌ  : يَا  أَبَا فِرَاسٍ  ، مَنْ هَذَا ؟ فَقَالَ  الْفَرَزْدَقُ  :         [3/102]      عِرْنِينِهِ  "" .","","Al-Mu'jam al-Kabir 2800","","الحسن بن علي سبط رسول الله عن سليمان بن الهيثم عن يزيد بن عمرو بن يزيد الغنوي عن محمد بن حنيفة القصبى عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2799","2801  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  ثَنَا  يَحْيَى بْنُ حَمَّادٍ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  أَبِي إِدْرِيسَ ،  ثَنَا  الْمُسَيِّبُ بْنُ نَجَبَةَ ، قَالَ :  قَالَ  عَلِيٌّ رَضِيَ اللهُ عَنْهُ :  أَلَا أُحَدِّثُكُمْ عَنْ خَاصَّةِ نَفْسِي وَأَهْلِ بَيْتِي ؟  قُلْنَا : بَلَى . قَالَ : "" أَمَّا  حَسَنٌ  فَصَاحِبُ  جَفْنَةٍ  وَخُوَانٍ ، وَفَتًى مِنَ الْفِتْيَانِ ، وَلَوْ قَدِ الْتَقَتْ حَلْقَتَا الْبِطَانِ لَمْ يُغْنِ عَنْكُمْ فِي الْحَرْبِ حِبَالَةَ عُصْفُورٍ . وَأَمَّا  عَبْدُ اللهِ بْنُ جَعْفَرٍ  فَصَاحِبُ  لَهْوٍ  وَظِلٍّ وَبَاطِلٍ ، وَلَا يَغُرَّنَّكُمُ  ابْنَا عَبَّاسٍ  ، وَأَمَّا أَنَا  وَحُسَيْنٌ  فَأَنَا  وَحُسَيْنٌ  ، فَإِنَّا مِنْكُمْ وَأَنْتُمْ مِنَّا ، وَاللهِ لَقَدْ خَشِيتُ أَنْ يُدَالَ هَؤُلَاءِ  الْقَوْمُ  عَلَيْكُمْ بِصَلَاحِهِمْ فِي أَرْضِهِمْ ، وَفَسَادِكُمْ فِي أَرْضِكُمْ ، وَبِأَدَائِهِمُ الْأَمَانَةَ وَخِيَانَتِكُمْ ، وَبِطَوَاعِيَتِهِمْ إِمَامَهُمْ وَمَعْصِيَتِكُمْ لَهُ ، وَاجْتِمَاعِهِمْ عَلَى بَاطِلِهِمْ ، وَتَفَرُّقِكُمْ عَلَى حَقِّكُمْ ، حَتَّى تَطُولَ دَوْلَتُهُمْ ، حَتَّى لَا يَدَعُوا لِلهِ مُحَرَّمًا إِلَّا اسْتَحَلُّوهُ ، وَلَا يَبْقَى  مَدَرٌ  وَلَا وَبَرٌ إِلَّا دَخَلَهُ ظُلْمُهُمْ ، وَحَتَّى يَكُونَ أَحَدُكُمْ تَابِعًا لَهُمْ ، وَحَتَّى يَكُونَ نُصْرَةُ أَحَدِكُمْ مِنْهُمْ كَنُصْرَةِ الْعَبْدِ مِنْ سَيِّدِهِ ، إِذَا شَهِدَ أَطَاعَهُ ، وَإِذَا غَابَ عَنْهُ  سَبَّهُ  ، وَحَتَّى يَكُونَ أَعْظَمُكُمْ فِيهَا غِنًى أَحْسَنَكُمْ بِاللهِ ظَنًّا ، فَإِنْ أَتَاكُمُ اللهُ بِعَافِيَةٍ فَاقْبَلُوا ، فَإِنِ ابْتُلِيتُمْ فَاصْبِرُوا ، فَإِنَّ الْعَاقِبَةَ لِلْمُتَّقِينَ  "" .","","Al-Mu'jam al-Kabir 2801","","علي بن أبي طالب عن المسيب بن نجبة الفزاري عن أبو إدريس المرهبي عن حبيب بن أبي ثابت الكاهلي عن الأعمش عن الوضاح بن عبد الله اليشكري عن يحيى بن حماد بن أبي زياد الشيباني عن أبو موسى الزمن عن زكريا بن يحيى السجزي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2800","[3/103]      2802  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  أَبُو دَاوُدَ الْحَفَرِيُّ ،  عَنْ  فِطْرِ بْنِ خَلِيفَةَ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِي إِدْرِيسَ ،  عَنِ  الْمُسَيِّبِ بْنِ نَجَبَةَ الْفَزَارِيِّ ، قَالَ :  كُنَّا جُلُوسًا عِنْدَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ ، فَذَكَرُوا أَهْلَ بَيْتِهِ  ،  فَقَالَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ : "" أَمَّا  الْحَسَنُ  فَلَا يُغْنِي عَنْكُمْ فِي الْحَرْبِ حِبَالَةَ عُصْفُورٍ ، وَأَمَّا  عَبْدُ اللهِ بْنُ جَعْفَرٍ  فَصَاحِبُ ظِلٍّ وَخُوَانٍ ، وَأَمَّا  حُسَيْنٌ  فَإِنَّهُ مِنْكُمْ وَأَنْتُمْ مِنْهُ  "" .","","Al-Mu'jam al-Kabir 2802","","علي بن أبي طالب عن المسيب بن نجبة الفزاري عن أبو إدريس المرهبي عن سلمة بن كهيل الحضرمي عن فطر بن خليفة عن عمر بن سعد بن عبيد الحفري عن الحسين بن إسحاق التستري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2801","2803  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  ، حَدَّثَنِي  اللَّيْثُ بْنُ سَعْدٍ  ، قَالَ : ""  تُوُفِّيَ  مُعَاوِيَةُ  رَضِيَ اللهُ عَنْهُ فِي رَجَبٍ لِأَرْبَعِ لَيَالٍ خَلَتْ مِنْهُ  ،  وَاسْتُخْلِفَ  يَزِيدُ  سَنَتَيْنِ  ،  وَفِي سَنَةِ إِحْدَى وَسِتِّينَ قُتِلَ  الْحُسَيْنُ بْنُ عَلِيٍّ  وَأَصْحَابُهُ رَضِيَ اللهُ عَنْهُمْ لِعَشْرِ لَيَالٍ خَلَوْنَ مِنَ الْمُحَرَّمِ يَوْمَ عَاشُورَاءَ  ،  وَقُتِلَ  الْعَبَّاسُ بْنُ عَلِيِّ بْنِ أَبِي طَالِبٍ  ، وَأُمُّهُ  أُمُّ الْبَنِينَ عَامِرِيَّةٌ  ،  وَجَعْفَرُ بْنُ عَلِيِّ بْنِ أَبِي طَالِبٍ  ،  وَعَبْدُ اللهِ بْنُ عَلِيِّ بْنِ أَبِي طَالِبٍ  ،  وَعُثْمَانُ بْنُ عَلِيِّ بْنِ أَبِي طَالِبٍ  ،  وَأَبُو بَكْرِ بْنُ عَلِيِّ بْنِ أَبِي طَالِبٍ  ،  وَأُمُّهُ لَيْلَى بِنْتُ مَسْعُودٍ نَهْشَلِيَّةٌ  ،  وَعَلِيُّ بْنُ الْحُسَيْنِ بْنِ عَلِيِّ بْنِ أَبِي طَالِبٍ الْأَكْبَرُ  ، وَأُمُّهُ  لَيْلَى ثَقَفِيَّةٌ  ،  وَعَبْدُ اللهِ بْنُ الْحُسَيْنِ  ، وَأُمُّهُ  الرَّبَابُ بِنْتُ امْرِئِ الْقَيْسِ كَلْبِيَّةٌ  ،  وَأَبُو بَكْرِ بْنُ الْحُسَيْنِ  لِأُمِّ وَلَدٍ ،  وَالْقَاسِمُ بْنُ الْحَسَنِ  لِأُمِّ وَلَدٍ ،  وَعَوْنُ بْنُ عَبْدِ اللهِ بْنِ جَعْفَرِ بْنِ أَبِي طَالِبٍ  ،  وَجَعْفَرُ بْنُ عَقِيلِ بْنِ أَبِي طَالِبٍ  ،  وَمُسْلِمُ بْنُ عَقِيلِ بْنِ أَبِي طَالِبٍ  ،  وَسُلَيْمَانُ مَوْلَى الْحُسَيْنِ  ،  وَعَبْدُ اللهِ رَضِيعُ الْحُسَيْنِ  رَضِيَ اللهُ عَنْهُمْ  ،  وَقُتِلَ  الْحُسَيْنُ  رَضِيَ اللهُ عَنْهُ وَهُوَ ابْنُ ثَمَانٍ وَخَمْسِينَ  "" .  كذا في طبعة مكتبة ابن تيمية، وهو أيضا ما ورد في الأصل المخطوط نسخة مكتبة أبي عبد العزيز خليفة [136 / ب] . والتصويب من الأمالي الشجرية [1 / 155] حيث ورد الاسم على النحو التالي: وأبو بكر بن الحسن لأم ولد ، والقاسم بن الحسن لأم ولد والله أعلم.","","Al-Mu'jam al-Kabir 2803","","","ذكر مولده وصفته وهيأته رضي الله عنه"
"2802","2804  - حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، ثَنَا  يَحْيَى بْنُ حَسَّانَ  ، ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ  ، عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ  ، عَنْ أَبِيهِ  ، قَالَ : ""  قُتِلَ  الْحُسَيْنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ وَهُوَ ابْنُ ثَمَانٍ وَخَمْسِينَ  "" .","","Al-Mu'jam al-Kabir 2804","","","ذكر مولده وصفته وهيأته رضي الله عنه"
"2803","2805  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ السَّلَامِ بْنُ عَاصِمٍ         [3/104]      الرَّازِيُّ ،  ثَنَا  يَحْيَى بْنُ ضُرَيْسٍ ،  عَنْ  فِطْرٍ ،  عَنْ  مُنْذِرٍ الثَّوْرِيِّ ، قَالَ :  كَانَ إِذَا ذُكِرَ قَتْلُ  الْحُسَيْنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ عِنْدَ مُحَمَّدِ ابْنِ الْحَنَفِيَّةِ ،  قَالَ  :  لَقَدْ قُتِلَ مَعَهُ سَبْعَةَ عَشَرَ مِمَّنِ ارْتَكَضَ فِي رَحِمِ  فَاطِمَةَ  رَضِيَ اللهُ عَنْهُمْ  .","","Al-Mu'jam al-Kabir 2805","","ابن الحنفية عن المنذر بن يعلى الثوري عن فطر بن خليفة عن يحيى بن الضريس عن عبد السلام بن عاصم الهسنجاني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2804","2806  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ الْمِصْرِيُّ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  حَدَّثَنِي  اللَّيْثُ ، قَالَ :  أَبَى  الْحُسَيْنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا أَنْ يُسْتَأْسَرَ ، فَقَاتَلُوهُ فَقَتَلُوهُ  ، وَقَتَلُوا ابْنَيْهِ وَأَصْحَابَهُ الَّذِينَ قَاتَلُوا مَعَهُ بِمَكَانٍ يُقَالُ لَهُ  الطَّفُّ  ، وَانْطُلِقَ  بِعَلِيِّ بْنِ حُسَيْنٍ  ،  وَفَاطِمَةَ بِنْتِ حُسَيْنٍ  ،  وَسُكَيْنَةَ بِنْتِ حُسَيْنٍ  إِلَى  عُبَيْدِ اللهِ بْنِ زِيَادٍ  ،  وَعَلِيٌّ  يَوْمَئِذٍ غُلَامٌ قَدْ بَلَغَ ، فَبَعَثَ بِهِمْ إِلَى  يَزِيدَ بْنِ مُعَاوِيَةَ  ، فَأَمَرَ  بِسُكَيْنَةَ  فَجَعَلَهَا خَلْفَ سَرِيرِهِ لِئَلَّا تَرَى رَأْسَ أَبِيهَا وَذَوِي قَرَابَتِهَا ،  وَعَلِيُّ بْنُ الْحُسَيْنِ  رَضِيَ اللهُ عَنْهُمَا فِي غُلٍّ ، فَوَضَعَ رَأْسَهُ ، فَضَرَبَ عَلَى ثَنِيَّتَيِ  الْحُسَيْنِ  رَضِيَ اللهُ عَنْهُ ، فَقَالَ :  أَعَقَّ  فَقَالَ  عَلِيُّ بْنُ الْحُسَيْنِ  رَضِيَ اللهُ عَنْهُ :         {      مَا أَصَابَ مِنْ مُصِيبَةٍ فِي الأَرْضِ وَلا فِي أَنْفُسِكُمْ إِلا فِي كِتَابٍ مِنْ قَبْلِ أَنْ نَبْرَأَهَا إِنَّ ذَلِكَ عَلَى اللهِ يَسِيرٌ         }      . فَثَقُلَ عَلَى  يَزِيدَ  أَنْ يَتَمَثَّلَ بِبَيْتِ شِعْرٍ ، وَتَلَا  عَلِيٌّ  آيَةً مِنْ كِتَابِ اللهِ عَزَّ وَجَلَّ ، فَقَالَ  يَزِيدُ  : بَلْ بِمَا كَسَبَتْ أَيْدِيكُمْ وَيَعْفُو عَنْ كَثِيرٍ. فَقَالَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ : "" أَمَا وَاللهِ لَوْ رَآنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَغْلُولِينَ لَأَحَبَّ أَنْ يُخَلِّيَنَا مِنَ الْغُلِّ "" . قَالَ : صَدَقْتَ ، فَخَلُّوهُمْ مِنَ الْغُلِّ . قَالَ : "" وَلَوْ وَقَفْنَا بَيْنَ يَدَيْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى بُعْدٍ لَأَحَبَّ أَنْ يُقَرِّبَنَا "" . قَالَ : صَدَقْتَ ، فَقَرِّبُوهُمْ . فَجَعَلَتْ  فَاطِمَةُ  وَسُكَيْنَةُ  يَتَطَاوَلَانِ لِتَرَيَا رَأْسَ أَبِيهِمَا ، وَجَعَلَ  يَزِيدُ  يَتَطَاوَلُ فِي مَجْلِسِهِ لِيَسْتُرَ عَنْهُمَا رَأْسَ أَبِيهِمَا ، ثُمَّ أَمَرَ بِهِمْ فَجُهِّزُوا ، فَأَصْلَحَ إِلَيْهِمْ ، وَأُخْرِجُوا إِلَى  الْمَدِينَةِ  .","","Al-Mu'jam al-Kabir 2806","","الليث بن سعد عن يحيى بن عبد الله بن بكير المخزومي عن روح بن الفرج القطان عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2805","[3/105]      2807  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَحْمَدُ بْنُ يَحْيَى الصُّوفِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبَانَ ،  ثَنَا  حِبَّانُ بْنُ عَلِيٍّ ،  عَنْ  سَعْدِ بْنِ طَرِيفٍ ،  عَنْ  أَبِي جَعْفَرٍ مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يُقْتَلُ  حُسَيْنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ عَلَى رَأْسِ سِتِّينَ مِنْ مُهَاجَرَتِي  "" .","","Al-Mu'jam al-Kabir 2807","","هند بنت أبي أمية زوج رسول الله عن أبو جعفر الباقر عن سعد بن طريف الإسكاف عن حبان بن علي العنزي عن إسماعيل بن أبان عن أحمد بن يحيى بن زكريا عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2806","2808  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَحْمَدُ بْنُ يَحْيَى الصُّوفِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبَانَ ،  حَدَّثَنِي  حِبَّانُ بْنُ عَلِيٍّ ،  عَنْ  سَعْدِ بْنِ طَرِيفٍ ،  عَنْ  أَبِي جَعْفَرٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يُقْتَلُ  الْحُسَيْنُ  حِينَ يَعْلُوهُ  الْقَتِيرُ  ""  قَالَ أَبُو الْقَاسِمِ :  الْقَتِيرُ  : الشَّيْبُ  .","","Al-Mu'jam al-Kabir 2808","","هند بنت أبي أمية زوج رسول الله عن أبو جعفر الباقر عن سعد بن طريف الإسكاف عن حبان بن علي العنزي عن إسماعيل بن أبان عن أحمد بن يحيى بن زكريا عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2807","2809  -  حَدَّثَنَا  الْقَاسِمُ بْنُ عَبَّادٍ الْخَطَّابِيُّ الْبَصْرِيُّ ،  ثَنَا  سَعِيدُ بْنُ صُبَيْحٍ ، قَالَ :  قَالَ  هِشَامُ بْنُ الْكَلْبِيِّ ،  عَنْ  عَوَانَةَ بْنِ الْحَكَمِ قَالَ :  لَمَّا ضَرَبَ  عَبْدُ الرَّحْمَنِ بْنُ مُلْجَمٍ  عَلِيًّا  رَضِيَ اللهُ عَنْهُ  . وَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 2809","","عوانة بن الحكم الأخباري عن هشام بن محمد بن السائب الكلبي عن سعيد بن صبيح عن القاسم بن عباد الخطابى عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2808","2810  - حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ  ، عَنِ  ابْنِ عُيَيْنَةَ  ، عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ  ، عَنْ  أَبِيهِ  ""  أَنَّ  عَلِيًّا  رَضِيَ اللهُ عَنْهُ قُتِلَ وَهُوَ ابْنُ ثَمَانٍ وَخَمْسِينَ ، وَقُتِلَ  الْحُسَيْنُ  رَضِيَ اللهُ عَنْهُ وَهُوَ ابْنُ ثَمَانٍ وَخَمْسِينَ  ،  وَتُوُفِّيَ  عَلِيُّ بْنُ الْحُسَيْنِ  وَهُوَ ابْنُ ثَمَانٍ وَخَمْسِينَ  "" .","","Al-Mu'jam al-Kabir 2810","","","ذكر مولده وصفته وهيأته رضي الله عنه"
"2809","2811  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،  حَدَّثَنِي  شُرَحْبِيلُ بْنُ مُدْرِكٍ الْجُعْفِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ نُجَيٍّ ،  عَنْ  أَبِيهِ  أَنَّهُ سَافَرَ مَعَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ ، فَلَمَّا حَاذَى  نِينَوَى  ، قَالَ : صَبْرًا  أَبَا         [3/106]      عَبْدِ اللهِ  ، صَبْرًا بِشَطِّ  الْفُرَاتِ  . قُلْتُ : وَمَا ذَاكَ ؟ قَالَ : دَخَلْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَاتَ يَوْمٍ وَعَيْنَاهُ تَفِيضَانِ ، فَقُلْتُ : هَلْ أَغْضَبَكَ أَحَدٌ يَا رَسُولَ اللهِ ؟ مَالِي أَرَى عَيْنَيْكَ مُفِيضَتَيْنِ ؟ قَالَ :  قَامَ مِنْ عِنْدِي  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، فَأَخْبَرَنِي أَنَّ أُمَّتِي تَقْتُلُ  الْحُسَيْنَ  ابْنِي  . ثُمَّ قَالَ : هَلْ لَكَ أَنْ أُرِيَكَ مِنْ تُرْبَتِهِ ؟ قُلْتُ : نَعَمْ . فَمَدَّ يَدَهُ فَقَبَضَ ، فَلَمَّا رَأَيْتُهَا لَمْ أَمْلِكْ عَيْنَيَّ أَنْ فَاضَتَا  "" .","","Al-Mu'jam al-Kabir 2811","","علي بن أبي طالب عن نجي الحضرمي عن عبد الله بن نجي بن سلمة الحضرمي عن شرحبيل بن مدرك الجعفي عن محمد بن عبيد بن أبي أمية عن أبو بكر ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2810","2812  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ  ، حَدَّثَنَا  يَعْقُوبُ بْنُ حُمَيْدِ بْنِ كَاسِبٍ ،  ثَنَا  سُفْيَانُ بْنُ حَمْزَةَ ،  عَنْ  كَثِيرِ بْنِ زَيْدٍ ،  عَنِ  الْمُطَّلِبِ بْنِ عَبْدِ اللهِ بْنِ حَنْطَبٍ ، قَالَ :  لَمَّا أُحِيطَ بِالْحُسَيْنِ بْنِ عَلِيٍّ ، قَالَ : مَا اسْمُ هَذِهِ الْأَرْضِ ؟ قِيلَ :  كَرْبَلَاءُ  . فَقَالَ : صَدَقَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّهَا أَرْضُ كَرْبٍ وَبَلَاءٍ  "" .","","Al-Mu'jam al-Kabir 2812","","الحسين بن علي عن المطلب بن عبد الله بن حنطب المخزومي عن كثير بن زيد السهمي عن سفيان بن حمزة الأسلمي عن يعقوب بن حميد بن كاسب المدني عن محمد بن علي بن زيد الصائغ عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2811","2813  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  عَبْدُ الصَّمَدِ بْنُ حَسَّانَ الْمَرْوَزِيُّ ، (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَمُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ الْبَصْرِيُّ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالُوا :  ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ، قَالَا :  ثَنَا  عُمَارَةُ بْنُ زَاذَانَ الصَّيْدَلَانِيُّ ، قَالَا :  ثَنَا  ثَابِتٌ الْبُنَانِيُّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  اسْتَأْذَنَ مَلَكُ الْقَطْرِ رَبَّهُ عَزَّ وَجَلَّ أَنْ يَزُورَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَذِنَ لَهُ ، فَجَاءَهُ وَهُوَ فِي بَيْتِ  أُمِّ سَلَمَةَ  ، فَقَالَ :  يَا  أُمَّ سَلَمَةَ  احْفَظِي عَلَيْنَا الْبَابَ  ، لَا يَدْخُلْ عَلَيْنَا أَحَدٌ "" . فَبَيْنَمَا هُمْ عَلَى الْبَابِ إِذْ جَاءَ  الْحُسَيْنُ  فَفَتَحَ الْبَابَ ، فَجَعَلَ يَتَقَفَّزُ عَلَى ظَهْرِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَالنَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَلْتَثِمُهُ وَيُقَبِّلُهُ ، فَقَالَ لَهُ الْمَلَكُ : تُحِبُّهُ يَا  مُحَمَّدُ  ؟ قَالَ : "" نَعَمْ "" . قَالَ : أَمَا إِنَّ أُمَّتَكَ سَتَقْتُلُهُ ، وَإِنْ شِئْتَ أَنْ أُرِيَكَ مِنْ تُرْبَةِ الْمَكَانِ الَّذِي يُقْتَلُ فِيهَا . قَالَ : فَقَبَضَ قَبْضَةً مِنَ الْمَكَانِ الَّذِي يُقْتَلُ فِيهِ ، فَأَتَاهُ  بِسَهْلَةٍ  حَمْرَاءَ ، فَأَخَذَتْهُ  أُمُّ سَلَمَةَ  فَجَعَلَتْهُ فِي ثَوْبِهَا  . قَالَ  ثَابِتٌ  : ""  كُنَّا نَقُولُ إِنَّهَا  كَرْبَلَاءُ  "" .","","Al-Mu'jam al-Kabir 2813","","أنس بن مالك عن ثابت البناني عن عمارة بن زاذان الصيدلاني عن شيبان بن فروخ الحبطي عن عبد الله بن أحمد الجواليقي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2812","[3/107]      2814  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ  ، ثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ تَعَالَى عَنْهَا قَالَتْ :  دَخَلَ  الْحُسَيْنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يُوحَى إِلَيْهِ ، فَنَزَا عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ مُنْكَبٌّ ، وَلَعِبَ عَلَى ظَهْرِهِ ، فَقَالَ  جِبْرِيلُ  لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَتُحِبُّهُ يَا  مُحَمَّدُ  ؟ قَالَ :  يَا  جِبْرِيلُ  ، وَمَا لِي لَا أُحِبُّ ابْنِي  . قَالَ : فَإِنَّ أُمَّتَكَ سَتَقْتُلُهُ مِنْ بَعْدِكَ . فَمَدَّ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ يَدَهُ ، فَأَتَاهُ بِتُرْبَةٍ بَيْضَاءَ ، فَقَالَ : فِي هَذِهِ الْأَرْضِ يُقْتَلُ ابْنُكَ هَذَا يَا  مُحَمَّدُ  ، وَاسْمُهَا  الطَّفُّ  . فَلَمَّا ذَهَبَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ مِنْ عِنْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَالتُّرْبَةُ فِي يَدِهِ يَبْكِي ، فَقَالَ : "" يَا  عَائِشَةُ  ، إِنَّ  جِبْرِيلَ  عَلَيْهِ السَّلَامُ أَخْبَرَنِي أَنَّ  الْحُسَيْنَ  ابْنِي مَقْتُولٌ فِي أَرْضِ  الطَّفِّ  ، وَأَنَّ أُمَّتِي سَتُفْتَتَنُ بَعْدِي "" . ثُمَّ خَرَجَ إِلَى أَصْحَابِهِ فِيهِمْ  عَلِيٌّ  وَأَبُو بَكْرٍ  وَعُمَرُ  وَحُذَيْفَةُ  وَعَمَّارٌ  وَأَبُو ذَرٍّ  رَضِيَ اللهُ عَنْهُمْ وَهُوَ يَبْكِي ، فَقَالُوا : مَا يُبْكِيكَ يَا رَسُولَ اللهِ ؟ فَقَالَ : "" أَخْبَرَنِي  جِبْرِيلُ  أَنَّ ابْنِي  الْحُسَيْنَ  يُقْتَلُ بَعْدِي بِأَرْضِ  الطَّفِّ  ، وَجَاءَنِي بِهَذِهِ التُّرْبَةِ ، وَأَخْبَرَنِي أَنَّ فِيهَا مَضْجَعَهُ  "" .","","Al-Mu'jam al-Kabir 2814","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن أحمد بن محمد بن الحجاج المصري عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2813","2815  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  الْحُسَيْنُ بْنُ حُرَيْثٍ ،  ثَنَا  الْفَضْلُ بْنُ مُوسَى ،  عَنْ  عَبْدِ اللهِ بْنِ سَعِيدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ  أَنَّ  الْحُسَيْنَ بْنَ عَلِيٍّ  دَخَلَ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  عَائِشَةُ  ، أَلَا أُعَجِّبُكِ ؟ لَقَدْ دَخَلَ عَلَيَّ مَلَكٌ آنِفًا  مَا دَخَلَ عَلَيَّ قَطُّ ، فَقَالَ : إِنَّ ابْنِي هَذَا مَقْتُولٌ ، وَقَالَ : إِنْ شِئْتَ أَرَيْتُكَ تُرْبَةً يُقْتَلُ فِيهَا ، فَتَنَاوَلَ الْمَلَكُ بِيَدِهِ ، فَأَرَانِي تُرْبَةً حَمْرَاءَ  "" .","","Al-Mu'jam al-Kabir 2815","","عائشة بنت أبي بكر الصديق عن سعيد المقبري عن عبد الله بن سعيد بن أبي سعيد المقبري عن الفضل بن موسى السيناني عن الحسين بن حريث الخزاعي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2814","2816  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  هُدْبَةُ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،         [3/108]      عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  عَلِيِّ بْنِ الْحُسَيْنِ ، قَالَ :  قَالَ لِيَ  الْحُسَيْنُ بْنُ عَلِيٍّ قَبْلَ قَتْلِهِ بِيَوْمٍ  : إِنَّ  بَنِي إِسْرَائِيلَ  كَانَ لَهُمْ  مَلِكٌ  . وَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 2816","","الحسين بن علي عن علي بن الحسين زين العابدين عن علي بن زيد بن جدعان عن حماد بن سلمة عن هدبة بن خالد عن عبد الله بن أحمد بن حنبل عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2815","2817  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  عَبَّادُ بْنُ زِيَادٍ الْأَسَدِيُّ ،  ثَنَا  عَمْرُو بْنُ ثَابِتٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ شَقِيقِ بْنِ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ  الْحَسَنُ  وَالْحُسَيْنُ  رَضِيَ اللهُ عَنْهُمَا يَلْعَبَانِ بَيْنَ يَدَيِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي بَيْتِي ، فَنَزَلَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، فَقَالَ : يَا  مُحَمَّدُ  ، إِنَّ أُمَّتَكَ تَقْتُلُ ابْنَكَ هَذَا مِنْ بَعْدِكَ . فَأَوْمَأَ بِيَدِهِ إِلَى  الْحُسَيْنِ  ، فَبَكَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَضَمَّهُ إِلَى صَدْرِهِ ، ثُمَّ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  وَدِيعَةٌ عِنْدَكِ هَذِهِ التُّرْبَةُ  . فَشَمَّهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقَالَ : "" وَيْحَ كَرْبٍ وَبَلَاءٍ "" . قَالَتْ : وَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يَا  أُمَّ سَلَمَةَ  إِذَا تَحَوَّلَتْ هَذِهِ التُّرْبَةُ دَمًا فَاعْلَمِي أَنَّ ابْنِي قَدْ قُتِلَ "" قَالَ :  فَجَعَلَتْهَا  أُمُّ سَلَمَةَ  فِي قَارُورَةٍ ، ثُمَّ جَعَلَتْ تَنْظُرُ إِلَيْهَا كُلَّ يَوْمٍ ، وَتَقُولُ : إِنَّ يَوْمًا تَحَوَّلِينَ دَمًا لَيَوْمٌ عَظِيمٌ  "" .","","Al-Mu'jam al-Kabir 2817","","هند بنت أبي أمية زوج رسول الله عن شقيق بن سلمة عن الأعمش عن عمرو  بن أبي المقدام عن عباد بن زياد  بن موسى الساجي عن عبد الله بن أحمد بن حنبل عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2816","2818  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، (  ح  ) .  وَحَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، قَالَا :  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ بَهْرَامَ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ، قَالَ :  سَمِعْتُ  أُمَّ سَلَمَةَ حِينَ جَاءَ نَعْيُ  الْحُسَيْنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ لَعَنَتْ  أَهْلَ الْعِرَاقِ  ، وَقَالَتْ : "" قَتَلُوهُ قَتَلَهُمُ اللهُ عَزَّ وَجَلَّ ، غَرُّوهُ وَذَلُّوهُ ، لَعَنَهُمُ اللهُ  "" .","","Al-Mu'jam al-Kabir 2818","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن عبد الحميد بن بهرام الفزاري عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2817","2819  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ الْحِمَّانِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنْ  كَثِيرِ بْنِ زَيْدٍ ،  عَنْ  عَبْدِ الْمُطَّلِبِ بْنِ عَبْدِ اللهِ بْنِ حَنْطَبٍ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَالِسًا ذَاتَ يَوْمٍ فِي بَيْتِي ،         [3/109]      فَقَالَ :  لَا يَدْخُلْ عَلَيَّ أَحَدٌ "" . فَانْتَظَرْتُ فَدَخَلَ  الْحُسَيْنُ  رَضِيَ اللهُ عَنْهُ  ، فَسَمِعْتُ  نَشِيجَ  رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَبْكِي ، فَاطَّلَعْتُ فَإِذَا  حُسَيْنٌ  فِي حِجْرِهِ ، وَالنَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَمْسَحُ جَبِينَهُ وَهُوَ يَبْكِي ، فَقُلْتُ : وَاللهِ مَا عَلِمْتُ حِينَ دَخَلَ ، فَقَالَ : "" إِنَّ  جِبْرِيلَ  عَلَيْهِ السَّلَامُ كَانَ مَعَنَا فِي الْبَيْتِ ، فَقَالَ : تُحِبُّهُ ؟ قُلْتُ : أَمَّا مِنَ الدُّنْيَا فَنَعَمْ . قَالَ : إِنَّ أُمَّتَكَ سَتَقْتُلُ هَذَا بِأَرْضٍ يُقَالُ لَهَا  كَرْبَلَاءُ  "" . فَتَنَاوَلَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ مِنْ تُرْبَتِهَا ، فَأَرَاهَا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا أُحِيطَ  بِحُسَيْنٍ  حِينَ قُتِلَ ، قَالَ : مَا اسْمُ هَذِهِ الْأَرْضِ ؟ قَالُوا :  كَرْبَلَاءُ  . قَالَ : صَدَقَ اللهُ وَرَسُولُهُ ، أَرْضُ كَرْبٍ وَبَلَاءٍ  .  كذا في طبعة مكتبة ابن تيمية ، وصوابه : (المطلب بن عبد الله بن حنطب ) .","","Al-Mu'jam al-Kabir 2819","","هند بنت أبي أمية زوج رسول الله عن المطلب بن عبد الله بن حنطب المخزومي عن كثير بن زيد السهمي عن سليمان بن بلال القرشي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2818","2820  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عَلِيُّ بْنُ بَحْرٍ ،  ثَنَا  عِيسَى بْنُ يُونُسَ ، (  ح  ) .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَعْلَى بْنُ عُبَيْدٍ ، قَالَا :  ثَنَا  مُوسَى بْنُ صَالِحٍ الْجُهَنِيُّ  ،  عَنْ  صَالِحِ بْنِ أَرْبَدَ ،  عَنْ  أُمِّ سَلَمَةَ رَضِيَ اللهُ عَنْهَا قَالَتْ :  قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اجْلِسِي بِالْبَابِ ، وَلَا يَلِجَنَّ عَلَيَّ أَحَدٌ  . فَقُمْتُ بِالْبَابِ ، إِذْ جَاءَ  الْحُسَيْنُ  رَضِيَ اللهُ عَنْهُ ، فَذَهَبْتُ أَتَنَاوَلُهُ ، فَسَبَقَنِي الْغُلَامُ ، فَدَخَلَ عَلَى جَدِّهِ ، فَقُلْتُ : يَا نَبِيَّ اللهِ ، جَعَلَنِي اللهُ فِدَاكَ ، أَمَرْتَنِي أَنْ لَا يَلِجَ عَلَيْكَ أَحَدٌ ، وَإِنَّ ابْنَكَ جَاءَ ، فَذَهَبْتُ أَتَنَاوَلُهُ فَسَبَقَنِي ، فَلَمَّا طَالَ ذَلِكَ تَطَلَّعْتُ مِنَ الْبَابِ ، فَوَجَدْتُكَ تُقَلِّبُ بِكَفَّيْكَ شَيْئًا وَدُمُوعُكَ تَسِيلُ ، وَالصَّبِيُّ عَلَى بَطْنِكَ . قَالَ : "" نَعَمْ ، أَتَانِي  جِبْرِيلُ  ، فَأَخْبَرَنِي أَنَّ أُمَّتِي يَقْتُلُونَهُ ، وَأَتَانِي بِالتُّرْبَةِ الَّتِي يُقْتَلُ عَلَيْهَا ، فَهِيَ الَّتِي أُقَلِّبُ بِكَفَّيَّ  "" .  كذا في طبعة مكتبة ابن تيمية ونسخة الظاهرية (1) والذي في نسخة الظاهرية (2) : (موسى الجهني) وكتب فوق موسى ما يشبه أبو صلح أو لعلها أبو سلم واللفظة غير واضحة ولعل ذلك سبب التصحيف ، والصواب : (موسى الجهني) كما في مصادر التخريج ، وهو موسى بن عبد الله الجهني ويكنى بأبي سلمة وغير ذلك ، فالله أعلم .","","Al-Mu'jam al-Kabir 2820","","هند بنت أبي أمية زوج رسول الله عن صالح بن أربد عن موسى بن عبد الله الجهني عن عيسى بن يونس بن أبي إسحاق عن علي بن بحر بن بري القطان عن الحسين بن إسحاق التستري عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2819","2821  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ  ، ثَنَا  جَعْفَرُ بْنُ مُسَافِرٍ التِّنِّيسِيُّ ،  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  ثَنَا  مُوسَى بْنُ يَعْقُوبَ الزَّمْعِيُّ ،  عَنْ  هَاشِمِ بْنِ هَاشِمِ بْنِ عُتْبَةَ بْنِ أَبِي وَقَّاصٍ ،  عَنْ  عُتْبَةَ بْنِ عَبْدِ اللهِ بْنِ زَمْعَةَ ،  عَنْ  أُمِّ سَلَمَةَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ اضْطَجَعَ ذَاتَ يَوْمٍ ، فَاسْتَيْقَظَ وَهُوَ  خَاثِرُ  النَّفْسِ ، وَفِي يَدِهِ تُرْبَةٌ         [3/110]      حَمْرَاءُ يُقَلِّبُهَا ، فَقُلْتُ : مَا هَذِهِ التُّرْبَةُ يَا رَسُولَ اللهِ ؟ فَقَالَ :  أَخْبَرَنِي  جِبْرِيلُ  عَلَيْهِ السَّلَامُ أَنَّ هَذَا يُقْتَلُ بِأَرْضِ  الْعِرَاقِ  -  لِلْحُسَيْنِ  - فَقُلْتُ  لِجِبْرِيلَ  عَلَيْهِ السَّلَامُ : أَرِنِي تُرْبَةَ الْأَرْضِ الَّتِي يُقْتَلُ بِهَا ، فَهَذِهِ تُرْبَتُهَا  "" .","","Al-Mu'jam al-Kabir 2821","","هند بنت أبي أمية زوج رسول الله عن عتبة بن عبد الله بن زمعة عن هاشم بن هاشم بن عتبة الوقاصي عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن محمد بن إسماعيل بن مسلم الديلي عن جعفر بن مسافر التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2820","2822  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، (  ح  ) .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمَّارِ بْنِ أَبِي عَمَّارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِيمَا يَرَى النَّائِمُ بِنِصْفِ النَّهَارِ  أَشْعَثَ  أَغْبَرَ ، بِيَدِهِ قَارُورَةٌ فِيهَا دَمٌ ، فَقُلْتُ : بِأَبِي أَنْتَ وَأُمِّي يَا رَسُولَ اللهِ ، مَا هَذَا ؟ فَقَالَ : "" دَمُ  الْحُسَيْنِ  وَأَصْحَابِهِ ، لَمْ أَزَلْ أَلْتَقِطُهُ مُنْذُ الْيَوْمَ "" . فَأُحْصِيَ ذَلِكَ الْيَوْمُ ، فَوُجِدَ قَدْ قُتِلَ يَوْمَئِذٍ  .","","Al-Mu'jam al-Kabir 2822","","عبد الله بن عباس عن عمار بن أبي عمار الحارثي عن حماد بن سلمة عن سليمان بن حرب الواشحي عن أبو مسلم الكجي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2821","2823  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  سَعْدُ بْنُ وَهْبٍ الْوَاسِطِيُّ ،  ثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ ،  عَنْ  شُبَيْلِ بْنِ غَزَرَةَ ،  عَنْ  أَبِي حِبَرَةَ ، قَالَ :  صَحِبْتُ  عَلِيًّا رَضِيَ اللهُ عَنْهُ حَتَّى أَتَى  الْكُوفَةَ  ، فَصَعِدَ الْمِنْبَرَ  ، فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ : "" كَيْفَ أَنْتُمْ إِذَا نَزَلَ بِذُرِّيَّةِ نَبِيِّكُمْ بَيْنَ  ظَهْرَانَيْكُمْ  ؟ "" قَالُوا : إِذًا نُبْلِيَ اللهَ فِيهِمْ بَلَاءً حَسَنًا . فَقَالَ : "" وَالَّذِي نَفْسِي بِيَدِهِ لَيَنْزِلُنَّ بَيْنَ  ظَهْرَانَيْكُمْ  ، وَلَتَخْرُجُنَّ إِلَيْهِمْ فَلَتَقْتُلُنَّهُمْ "" . ثُمَّ أَقْبَلَ يَقُولُ :  .","","Al-Mu'jam al-Kabir 2823","","علي بن أبي طالب عن شيحة بن عبد الله الضبعي عن شبيل بن عزرة الضبعي عن جعفر بن سليمان الضبعي عن سعد بن وهب بن سنان عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2822","2824  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ الْحَكَمِ بْنِ أَبِي زِيَادٍ ، وَأَحْمَدُ بْنُ يَحْيَى الصُّوفِيُّ ، قَالَا :  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هَانِي بْنِ هَانِي ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  لَيُقْتَلَنَّ         [3/111]      الْحُسَيْنُ  قَتْلًا  ، وَإِنِّي لَأَعْرِفُ التُّرْبَةَ الَّتِي يُقْتَلُ فِيهَا قَرِيبًا مِنَ النَّهَرَيْنِ  "" .","","Al-Mu'jam al-Kabir 2824","","علي بن أبي طالب عن هانئ بن هانئ المرادي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن أحمد بن يحيى بن زكريا عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2823","2825  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو [ مُعَاوِيَةَ  عن  ]  الْأَعْمَشِ ،  عَنْ  سَلَّامٍ أَبِي شُرَحْبِيلَ ،  عَنْ  أَبِي هَرْثَمَةَ ، قَالَ :  كُنْتُ مَعَ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ بِنَهَرَيْ  كَرْبَلَاءَ  ، فَمَرَّ بِشَجَرَةٍ تَحْتَهَا بَعْرُ غِزْلَانٍ ، فَأَخَذَ مِنْهُ قَبْضَةً فَشَمَّهَا ، ثُمَّ قَالَ : "" يُحْشَرُ مِنْ هَذَا الظَّهْرِ سَبْعُونَ أَلْفًا يَدْخُلُونَ الْجَنَّةَ بِغَيْرِ حِسَابٍ  "" .  سقط من طبعة مكتبة ابن تيمية والمثبت من النسخ الخطية .","","Al-Mu'jam al-Kabir 2825","","علي بن أبي طالب عن أبو هرثمة عن سلام بن شرحبيل عن الأعمش عن أبو معاوية الضرير عن عثمان ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2824","2826  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ أَبِي سَمِينَةَ ،  ثَنَا  يَحْيَى بْنُ حَمَّادٍ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  عَنْ  شَيْبَانَ بْنِ مُخَرِّمٍ ، وَكَانَ عُثْمَانِيًّا ، قَالَ :  إِنِّي لَمَعَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ إِذْ أَتَى  كَرْبَلَاءَ  ،  فَقَالَ  : "" يُقْتَلُ فِي هَذَا الْمَوْضِعِ شُهَدَاءُ لَيْسَ مِثْلَهُمْ شُهَدَاءُ إِلَّا شُهَدَاءُ  بَدْرٍ  "" . فَقُلْتُ : بَعْضُ كِذْبَاتِهِ ، وَثَمَّ رِجْلُ حِمَارٍ مَيِّتٍ ، فَقُلْتُ لِغُلَامِي : خُذْ رِجْلَ هَذَا الْحِمَارِ فَأَوْتِدْهَا فِي مَقْعَدِهِ وَغَيِّبْهَا ،  فَضَرَبَ  الدَّهْرُ ضَرْبَةً ، فَلَمَّا قُتِلَ  الْحُسَيْنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا ، انْطَلَقْتُ وَمَعِي أَصْحَابٌ لِي ، فَإِذَا  جُثَّةُ  الْحُسَيْنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ عَلَى رِجْلِ ذَاكَ الْحِمَارِ ، وَإِذَا أَصْحَابُهُ رِبْضَةٌ حَوْلَهُ  "" .","","Al-Mu'jam al-Kabir 2826","","علي بن أبي طالب عن شيبان بن محزم عن ميمون بن مهران الرقي عن عطاء بن السائب عن الوضاح بن عبد الله اليشكري عن يحيى بن حماد بن أبي زياد الشيباني عن محمد بن يحيى بن أبي سمينة التمار عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2825","2827  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ الْبَصْرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ الْعَبْدِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ كَثِيرٍ ،  عَنْ  حُصَيْنِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنِ  الْعَلَاءِ بْنِ أَبِي عَائِشَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  رَأْسِ الْجَالُوتِ  ، قَالَ :  كُنَّا نَسْمَعُ أَنَّهُ يُقْتَلُ  بِكَرْبَلَاءَ  ابْنُ نَبِيٍّ  ، فَكُنْتُ إِذَا دَخَلْتُهَا رَكَّضْتُ فَرَسِي حَتَّى أَجُوزَ عَنْهَا ، فَلَمَّا قُتِلَ  الْحُسَيْنُ  جَعَلْتُ أَسِيرُ بَعْدَ ذَلِكَ عَلَى هَيْئَتِي  "" .  رأس الجالوت هو اسم الحاكم على اليهود بعد خراب بيت المقدس","","Al-Mu'jam al-Kabir 2827","","رأس الجالوت عن أبو العلاء بن أبي عائشة الجزري عن العلاء بن أبي عائشة الجزري عن حصين بن عبد الرحمن السلمي عن سليمان بن كثير الأصيد عن محمد بن كثير العبدي عن محمد بن محمد بن حيان التمار عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2826","2828  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  فُرَاتُ بْنُ مَحْبُوبٍ ،  ثَنَا         [3/112]      أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  حَدَّثَنِي  أَسْلَمُ الْمِنْقَرِيُّ ، قَالَ :  دَخَلْتُ عَلَى  الْحَجَّاجِ ، فَدَخَلَ  سِنَانُ بْنُ أَنَسٍ  قَاتِلُ  الْحُسَيْنِ  ، فَإِذَا شَيْخٌ آدَمُ فِيهِ حِنَّاءٌ ، طَوِيلُ الْأَنْفِ فِي وَجْهِهِ بَرَشٌ ، فَأُوقِفَ بِحِيَالِ  الْحَجَّاجِ  ، فَنَظَرَ إِلَيْهِ  الْحَجَّاجُ  ، فَقَالَ : "" أَنْتَ قَتَلْتَ  الْحُسَيْنَ  ؟ "" قَالَ : نَعَمْ . قَالَ : "" وَكَيْفَ صَنَعْتَ بِهِ ؟ "" قَالَ :  دَعَمْتُهُ  بِالرُّمْحِ ،  وَهَبَرْتُهُ  بِالسَّيْفِ  هَبْرًا  . فَقَالَ لَهُ  الْحَجَّاجُ  : "" أَمَا إِنَّكُمَا لَنْ تَجْتَمِعَا فِي دَارٍ  "" .","","Al-Mu'jam al-Kabir 2828","","حجاج بن يوسف بن أبي عقيل الثقفي عن أسلم المنقري عن أبو بكر بن عياش عن الفرات بن محبوب السكوني عن محمد بن عثمان بن أبي شيبة عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2827","2829  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  سَعِيدُ بْنُ خُثَيْمٍ ،  عَنْ  مُحَمَّدِ بْنِ خَالِدٍ الضَّبِّيِّ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  لَوْ كُنْتُ فِيمَنْ قَتَلَ  الْحُسَيْنَ بْنَ عَلِيٍّ  ، ثُمَّ غُفِرَ لِي  ، ثُمَّ أُدْخِلْتُ الْجَنَّةَ ، اسْتَحْيَيْتُ أَنْ أَمُرَّ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَيَنْظُرَ فِي وَجْهِي  "" .","","Al-Mu'jam al-Kabir 2829","","إبراهيم النخعي عن محمد بن خالد الضبي عن سعيد بن خثيم الهلالي عن عثمان ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2828","2830  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  بَكْرُ بْنُ خَلَفٍ ،  ثَنَا  أَبُو عَاصِمٍ ، (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  ثَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ، كِلَاهُمَا  عَنْ  قُرَّةَ بْنِ خَالِدٍ ، قَالَ :  سَمِعْتُ  أَبَا رَجَاءٍ الْعُطَارِدِيَّ يَقُولُ :  لَا  تَسُبُّوا  عَلِيًّا  وَلَا أَهْلَ هَذَا الْبَيْتِ  ، فَإِنَّ جَارًا لَنَا مِنْ بَلْهُجَيْمٍ قَالَ : أَلَمْ تَرَوْا إِلَى هَذَا الْفَاسِقِ  الْحُسَيْنِ بْنِ عَلِيٍّ  قَتَلَهُ اللهُ ، فَرَمَاهُ اللهُ بِكَوْكَبَيْنِ فِي عَيْنَيْهِ ، فَطَمَسَ اللهُ بَصَرَهُ  "" .","","Al-Mu'jam al-Kabir 2830","","أبو رجاء العطاردي عن قرة بن خالد السدوسي عن أبو عامر العقدي عن إبراهيم بن سعيد الجوهري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2829","2831  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ يَحْيَى الصُّوفِيُّ ،  نَا  أَبُو غَسَّانَ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ كُرْدُوسٍ ،  عَنْ  حَاجِبِ عُبَيْدِ اللهِ بْنِ زِيَادٍ ، قَالَ :  دَخَلْتُ الْقَصْرَ خَلْفَ عُبَيْدِ اللهِ بْنِ زِيَادٍ حِينَ قُتِلَ  الْحُسَيْنُ  ، فَاضْطَرَمَ فِي وَجْهِهِ نَارٌ ، فَقَالَ هَكَذَا بِكُمِّهِ عَلَى وَجْهِهِ ، فَقَالَ : هَلْ رَأَيْتَ ؟ قُلْتُ : نَعَمْ ، فَأَمَرَنِي أَنْ أَكْتُمَ ذَلِكَ  "" .","","Al-Mu'jam al-Kabir 2831","","عبيد الله بن زياد الهمداني عن حاجب عبيد الله بن زياد عن عبد الملك بن كردوس الهدادي عن عبد السلام بن حرب الملائي عن مالك بن إسماعيل النهدي عن أحمد بن يحيى بن زكريا عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2830","2832  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ         [3/113]      نُمَيْرٍ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ بْنِ عُمَيْرٍ ، قَالَ :  لَمَّا جِيءَ بِرَأْسِ  عُبَيْدِ اللهِ بْنِ زِيَادٍ  وَأَصْحَابِهِ ، نُصِبَتْ فِي  الرَّحَبَةِ  ، فَانْتَهَيْتُ إِلَيْهِمْ وَهُمْ يَقُولُونَ : قَدْ جَاءَتْ قَدْ جَاءَتْ ، فَإِذَا حَيَّةٌ قَدْ جَاءَتْ تَخَلَّلُ الرُّؤُوسَ حَتَّى دَخَلَتْ فِي  مَنْخَرِ  عُبَيْدِ اللهِ  ، فَمَكَثَتْ هُنَيْهَةً ، ثُمَّ خَرَجَتْ فَذَهَبَتْ ، ثُمَّ قَالُوا : قَدْ جَاءَتْ فَفَعَلَتْ ذَلِكَ مَرَّتَيْنِ أَوْ ثَلَاثًا  "" .","","Al-Mu'jam al-Kabir 2832","","عمارة بن عمير التيمي عن الأعمش عن أبو معاوية الضرير عن محمد بن عبد الله بن نمير عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2831","2833  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  سَلْمُ بْنُ جُنَادَةَ ،  ثَنَا  أَحْمَدُ بْنُ بَشِيرٍ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  رَأَيْتُ فِي النَّوْمِ كَأَنَّ رِجَالًا نَزَلُوا مِنَ السَّمَاءِ مَعَهُمْ حِرَابٌ  يَتَتَبَّعُونَ قَتَلَةَ  الْحُسَيْنِ  رَضِيَ اللهُ عَنْهُ ، فَمَا لَبِثَتْ أَنْ نَزَلَ  الْمُخْتَارُ  فَقَتَلَهُمْ  "" .","","Al-Mu'jam al-Kabir 2833","","الشعبي عن مجالد بن سعيد عن أحمد بن بشير المخزومى عن سلم بن جنادة السوائي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2832","2834  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يَزِيدُ بْنُ مِهْرَانَ أَبُو خَالِدٍ ،  ثَنَا  أَسْبَاطُ بْنُ مُحَمَّدٍ ،  عَنْ  أَبِي بَكْرٍ الْهُذَلِيِّ ،  عَنِ  الزُّهْرِيِّ ، قَالَ :  لَمَّا قُتِلَ  الْحُسَيْنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ لَمْ يُرْفَعْ حَجَرٌ  بِبَيْتِ الْمَقْدِسِ  إِلَّا وُجِدَ تَحْتَهُ دَمٌ  عَبِيطٌ  "" .","","Al-Mu'jam al-Kabir 2834","","الزهري عن أبو بكر الهذلي عن أسباط بن محمد بن ميسرة القرشي عن يزيد بن مهران الخباز عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2833","2835  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  ثَنَا  الضَّحَّاكُ بْنُ مَخْلَدٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  ابْنِ شِهَابٍ ، قَالَ :  مَا رُفِعَ  بِالشَّامِ  حَجَرٌ يَوْمَ قُتِلَ  الْحُسَيْنُ بْنُ عَلِيٍّ  إِلَّا عَنْ دَمٍ ، رَضِيَ اللهُ عَنْهُ  "" .","","Al-Mu'jam al-Kabir 2835","","الزهري عن ابن جريج عن أبو عاصم النبيل عن أبو موسى الزمن عن زكريا بن يحيى السجزي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2834","2836  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  حَدَّثَتْنِي  جَدَّتِي أُمُّ حَكِيمٍ ،  قَالَتْ  :  قُتِلَ  الْحُسَيْنُ بْنُ عَلِيٍّ  وَأَنَا يَوْمَئِذٍ جُوَيْرِيَةٌ  ، فَمَكَثَتِ السَّمَاءُ أَيَّامًا مِثْلَ  الْعَلَقَةِ  "" .","","Al-Mu'jam al-Kabir 2836","","حكيمة بنت أمية بن الأخنس عن علي بن مسهر القرشي عن منجاب بن الحارث التميمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2835","2837  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ يَحْيَى بْنِ الرَّبِيعِ بْنِ أَبِي رَاشِدٍ الْكَاهِلِيُّ ،  حَدَّثَنَا  مَنْصُورُ بْنُ أَبِي نُوَيْرَةَ ،  عَنْ  أَبِي بَكْرِ بْنِ عَيَّاشٍ ،  عَنْ  جَمِيلِ بْنِ زَيْدٍ ، قَالَ :  لَمَّا قُتِلَ  الْحُسَيْنُ  احْمَرَّتِ السَّمَاءُ  . قُلْتُ : أَيُّ         [3/114]      شَيْءٍ تَقُولُ ؟ فَقَالَ : "" إِنَّ الْكَذَّابَ مُنَافِقٌ ، إِنَّ السَّمَاءَ احْمَرَّتْ حِينَ قُتِلَ  "" .","","Al-Mu'jam al-Kabir 2837","","جميل بن زيد الطائي عن أبو بكر بن عياش عن منصور بن يعقوب بن أبي نويرة العلاف عن عبد الله بن يحيى بن الربيع بن أبي راشد الكاهلي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2836","2838  -  حَدَّثَنَا  قَيْسُ بْنُ أَبِي قَيْسٍ الْبُخَارِيُّ  ، ثَنَا  قُتَيْبَةُ بْنُ سَعِيدٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي قَبِيلٍ ، قَالَ :  لَمَّا قُتِلَ  الْحُسَيْنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ انْكَسَفَتِ الشَّمْسُ  كَسْفَةً حَتَّى بَدَتِ الْكَوَاكِبُ نِصْفَ النَّهَارِ ، حَتَّى ظَنَنَّا أَنَّهَا هِيَ  "" .","","Al-Mu'jam al-Kabir 2838","","حيي بن هانئ السريعي عن عبد الله بن لهيعة عن قتيبة بن سعيد عن قيس بن أبي قيس البخاري عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2837","2839  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  جَدِّي ،  عَنْ  عِيسَى بْنِ الْحَارِثِ الْكِنْدِيِّ ، قَالَ :  لَمَّا قُتِلَ  الْحُسَيْنُ  رَضِيَ اللهُ عَنْهُ مَكَثْنَا سَبْعَةَ أَيَّامٍ  إِذَا صَلَّيْنَا الْعَصْرَ نَظَرْنَا إِلَى الشَّمْسِ عَلَى أَطْرَافِ الْحِيطَانِ كَأَنَّهَا الْمَلَاحِفُ الْمُعَصْفَرَةُ ، وَنَظَرْنَا إِلَى الْكَوَاكِبِ يَضْرِبُ بَعْضُهَا بَعْضًا  "" .","","Al-Mu'jam al-Kabir 2839","","عيسى بن الحارث عن إبراهيم بن عثمان أبو شيبة العبسي عن محمد بن أبي شيبة العبسي عن عثمان ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2838","2840  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ، قَالَ :  لَمْ يَكُنْ فِي السَّمَاءِ حُمْرَةٌ حَتَّى قُتِلَ  الْحُسَيْنُ  "" .","","Al-Mu'jam al-Kabir 2840","","محمد بن سيرين عن هشام بن حسان العتكي عن حماد بن زيد عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2839","2841  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ يَحْيَى الصُّوفِيُّ ،  ثَنَا  أَبُو غَسَّانَ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنِ  الْكَلْبِيِّ ، قَالَ :  رَمَى  رَجُلٌ  الْحُسَيْنَ وَهُوَ يَشْرَبُ  ، فَشُلَّ شِدْقُهُ ،  فَقَالَ  : "" لَا أَرْوَاكَ اللهُ "" قَالَ : "" فَشَرِبَ حَتَّى تَفَطَّرَ  "" .","","Al-Mu'jam al-Kabir 2841","","الحسين بن علي عن محمد بن السائب الكلبي عن عبد السلام بن حرب الملائي عن مالك بن إسماعيل النهدي عن أحمد بن يحيى بن زكريا عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2840","2842  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الزُّبَيْرُ بْنُ بَكَّارٍ ،  ثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ ، قَالَ :  لَمَّا نَزَلَ  عُمَرُ بْنُ سَعْدٍ  بِحُسَيْنٍ ، وَأَيْقَنَ أَنَّهُمْ قَاتِلُوهُ  ، وَقَامَ فِي أَصْحَابِهِ خَطِيبًا ، فَحَمِدَ اللهَ عَزَّ وَجَلَّ وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ : "" قَدْ نَزَلَ مَا تَرَوْنَ مِنَ الْأَمْرِ ، وَإِنَّ الدُّنْيَا تَغَيَّرَتْ وَتَنَكَّرَتْ وَأَدْبَرَ مَعْرُوفُهَا ، وَاسْتَمَرَّتْ حَتَّى لَمْ         [3/115]      يَبْقَ مِنْهَا إِلَّا  كَصُبَابَةِ  الْإِنَاءِ إِلَّا خَسِيسُ عَيْشٍ كَالْمَرْعَى الْوَبِيلِ ، أَلَا تَرَوْنَ الْحَقَّ لَا يُعْمَلُ بِهِ ، وَالْبَاطِلَ لَا يُتَنَاهَى عَنْهُ ، لِيَرْغَبِ الْمُؤْمِنُ فِي لِقَاءِ اللهِ ، وَإِنِّي لَا أَرَى الْمَوْتَ إِلَّا سَعَادَةً ، وَالْحَيَاةَ مَعَ الظَّالِمِينَ إِلَّا  بُرْمًا  "" . وَقُتِلَ  الْحُسَيْنُ  رَضِيَ اللهُ عَنْهُ يَوْمَ عَاشُورَاءَ سَنَةَ إِحْدَى وَسِتِّينَ  بِالطَّفِّ  بِكَرْبَلَاءَ  ، وَعَلَيْهِ جُبَّةُ خَزٍّ دَكْنَاءُ ، وَهُوَ صَابِغٌ بِالسَّوَادِ ، وَهُوَ ابْنُ سِتٍّ وَخَمْسِينَ  .","","Al-Mu'jam al-Kabir 2842","","الحسين بن علي عن محمد بن الحسن بن زبالة المخزومي عن الزبير بن بكار عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2841","2843  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الزُّبَيْرُ ،  حَدَّثَنِي  أَحْمَدُ بْنُ سَلْمَانَ ،  عَنْ  عَبْدِ الْعَزِيزِ الدَّرَاوَرْدِيِّ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَايَعَ  الْحَسَنَ  وَالْحُسَيْنَ  وَعَبْدَ اللهِ بْنَ عَبَّاسٍ  وَعَبْدَ اللهِ بْنَ جَعْفَرٍ  رَضِيَ اللهُ عَنْهُمْ وَهُمْ صِغَارٌ لَمْ يَبْلُغُوا "" . قَالَ : "" وَلَمْ  يُبَايِعْ  صَغِيرًا إِلَّا مِنَّا  .","","Al-Mu'jam al-Kabir 2843","","أبو جعفر الباقر عن جعفر الصادق عن عبد العزيز بن محمد الدراوردي عن أحمد بن سلمان عن الزبير بن بكار عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2842","2844  -  حَدَّثَنَا  عَلِيٌّ  ، ثَنَا  الزُّبَيْرُ ، قَالَ :  وَحَدَّثَنِي  عَمِّي مُصْعَبُ بْنُ عَبْدِ اللهِ ، قَالَ :  حَجَّ الْحُسَيْنُ رَضِيَ اللهُ عَنْهُ خَمْسًا وَعِشْرِينَ حَجَّةً مَاشِيًا  "" .","","Al-Mu'jam al-Kabir 2844","","الحسين بن علي عن مصعب بن عبد الله بن مصعب الزبيري عن الزبير بن بكار عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2843","2845  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، حَدَّثَنَا  الزُّبَيْرُ بْنُ بَكَّارٍ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ الضَّحَّاكِ بْنِ عُثْمَانَ الْحِزَامِيُّ ، قَالَ :  كَانَ جَسَدُ الْحُسَيْنِ شِبْهَ جَسَدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  "" .","","Al-Mu'jam al-Kabir 2845","","الحسين بن علي عن محمد بن الضحاك الحزامى عن الزبير بن بكار عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2844","2846  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الزُّبَيْرُ بْنُ بَكَّارٍ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ الضَّحَّاكِ بْنِ عُثْمَانَ الْحِزَامِيُّ ،  عَنْ  أَبِيهِ  ، قَالَ :  خَرَجَ  الْحُسَيْنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا إِلَى  الْكُوفَةِ  سَاخِطًا لِوِلَايَةِ  يَزِيدَ بْنِ مُعَاوِيَةَ  ، فَكَتَبَ  يَزِيدُ بْنُ مُعَاوِيَةَ  إِلَى  عُبَيْدِ اللهِ بْنِ زِيَادٍ  وَهُوَ وَالِيهِ عَلَى  الْعِرَاقِ  : إِنَّهُ قَدْ بَلَغَنِي أَنَّ  حُسَيْنًا  قَدْ سَارَ إِلَى  الْكُوفَةِ  ، وَقَدِ ابْتُلِيَ بِهِ زَمَانُكَ مِنْ بَيْنِ الْأَزْمَانِ ، وَبَلَدُكَ مِنْ بَيْنِ الْبُلْدَانِ ، وَابْتُلِيتَ بِهِ مِنْ بَيْنِ الْعُمَّالِ ، وَعِنْدَهَا يُعْتَقُ أَوْ يَعُودُ عَبْدًا كَمَا يُعْتَبَدُ الْعَبِيدُ "" . فَقَتَلَهُ  عُبَيْدُ اللهِ بْنُ زِيَادٍ  ، وَبَعَثَ بِرَأْسِهِ إِلَيْهِ ، فَلَمَّا وُضِعَ بَيْنَ يَدَيْهِ تَمَثَّلَ بِقَوْلِ  الْحُسَيْنِ بْنِ الْحُمَامِ  :         [3/116]      أَعَقَّ  "" .","","Al-Mu'jam al-Kabir 2846","","الضحاك بن عثمان الحزامي عن محمد بن الضحاك الحزامى عن الزبير بن بكار عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2845","2847  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ، قَالَ :  خَرَجَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ بَيْتِ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا ، فَمَرَّ عَلَى بَيْتِ  فَاطِمَةَ  ، فَسَمِعَ  حُسَيْنًا  يَبْكِي رَضِيَ اللهُ عَنْهُ ، فَقَالَ :  أَلَمْ تَعْلَمِي أَنَّ بُكَاءَهُ يُؤْذِينِي  ؟ "" .","","Al-Mu'jam al-Kabir 2847","","يزيد بن أبي زياد القرشي عن عبد السلام بن حرب الملائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2846","2848  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الزُّبَيْرُ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ الْحَسَنِ الْمَخْزُومِيُّ ، قَالَ :  لَمَّا أُدْخِلَ ثِقَلُ  الْحُسَيْنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ عَلَى  يَزِيدَ بْنِ مُعَاوِيَةَ  ، وَوُضِعَ رَأْسُهُ بَيْنَ يَدَيْهِ ، بَكَى يَزِيدُ ، وَقَالَ :  أَعَقَّ  أَمَا وَاللهِ لَوْ كُنْتُ أَنَا صَاحِبَكَ مَا قَتَلْتُكَ أَبَدًا . فَقَالَ  عَلِيُّ بْنُ الْحُسَيْنِ  : "" لَيْسَ هَكَذَا "" . فَقَالَ : كَيْفَ يَا ابْنَ أُمِّ ؟ فَقَالَ :         {      مَا أَصَابَ مِنْ مُصِيبَةٍ فِي الأَرْضِ وَلا فِي أَنْفُسِكُمْ إِلا فِي كِتَابٍ مِنْ قَبْلِ أَنْ نَبْرَأَهَا إِنَّ ذَلِكَ عَلَى اللهِ يَسِيرٌ         }      . وَعِنْدَهُ  عَبْدُ الرَّحْمَنِ ابْنُ أُمِّ الْحَكَمِ  ، فَقَالَ  عَبْدُ الرَّحْمَنِ  :  فَرَفَعَ  يَزِيدُ  يَدَهُ ، فَضَرَبَ صَدْرَ  عَبْدِ الرَّحْمَنِ  ، وَقَالَ : اسْكُتْ .","","Al-Mu'jam al-Kabir 2848","","يزيد بن معاوية بن أبي سفيان الأموي عن محمد بن الحسن بن زبالة المخزومي عن الزبير بن بكار عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2847","2849  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُحَمَّدُ بْنُ سَعِيدِ بْنِ الْأَصْبَهَانِيِّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنِ  ابْنِ وَائِلٍ أَوْ وَائِلِ بْنِ عَلْقَمَةَ  أَنَّهُ شَهِدَ مَا         [3/117]      هُنَاكَ ، قَالَ : قَامَ  رَجُلٌ  ، فَقَالَ : أَفِيكُمْ  حُسَيْنٌ  ؟  قَالُوا : نَعَمْ . فَقَالَ : أَبْشِرْ بِالنَّارِ . فَقَالَ : "" أَبْشِرْ بِرَبٍّ رَحِيمٍ ، وَشَفِيعٍ مُطَاعٍ "" . قَالَ : "" مَنْ أَنْتَ ؟ "" قَالَ : أَنَا  ابْنُ جُوَيْزَةَ - أَوْ حُوَيْزَةَ  . قَالَ : فَقَالَ : "" اللَّهُمَّ حُزْهُ إِلَى النَّارِ "" . فَنَفَرَتْ بِهِ الدَّابَّةُ ، فَتَعَلَّقَتْ رِجْلُهُ فِي الرِّكَابِ . قَالَ : فَوَاللهِ مَا بَقِيَ عَلَيْهَا مِنْهُ إِلَّا رِجْلُهُ  "" .","","Al-Mu'jam al-Kabir 2849","","علقمة بن وائل بن حجر الحضرمي عن عطاء بن السائب عن شريك بن عبد الله النخعي عن محمد بن سعيد حمدان عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2848","2850  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  إِسْحَاقُ بْنُ إِسْمَاعِيلَ الطَّالْقَانِيُّ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  ابْنِ أَبِي لَيْلَى ، قَالَ :  قَالَ  حُسَيْنُ بْنُ عَلِيٍّ رَضِيَ اللهُ عَنْهُ حِينَ  أَحَسَّ  بِالْقَتْلِ :  ائْتُونِي ثَوْبًا لَا يَرْغَبُ فِيهِ أَحَدٌ أَجْعَلْهُ تَحْتَ ثِيَابِي لَا أُجَرَّدُ  . فَقِيلَ لَهُ :  تُبَّانٌ  ؟ فَقَالَ : "" لَا ؛ ذَلِكِ لِبَاسُ مَنْ ضُرِبَتْ عَلَيْهِ الذِّلَّةُ "" . فَأَخَذَ ثَوْبًا فَمَزَّقَهُ ، فَجَعَلَهُ تَحْتَ ثِيَابِهِ ، فَلَمَّا أَنْ قُتِلَ جَرَّدُوهُ  .","","Al-Mu'jam al-Kabir 2850","","الحسين بن علي عن محمد بن عبد الرحمن بن أبي ليلى عن جرير بن عبد الحميد عن إسحاق بن إسماعيل الطالقاني عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2849","2851  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ الْجَبَّارِ بْنُ الْعَبَّاسِ ،  عَنْ  عَمَّارٍ الدُّهْنِيِّ ، قَالَ :  مَرَّ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ عَلَى كَعْبٍ ، فَقَالَ : "" يُقْتَلُ مِنْ وَلَدِ هَذَا الرَّجُلِ رَجُلٌ فِي عِصَابَةٍ  ، لَا يَجِفُّ عَرَقُ خُيُولِهِمْ حَتَّى يَرِدُوا عَلَى  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" . فَمَرَّ  حَسَنٌ  رَضِيَ اللهُ عَنْهُ ، فَقَالُوا : هَذَا يَا  أَبَا إِسْحَاقَ  ؟ قَالَ : "" لَا "" . فَمَرَّ  حُسَيْنٌ  ، فَقَالُوا : هَذَا ؟ قَالَ : "" نَعَمْ  "" .","","Al-Mu'jam al-Kabir 2851","","كعب الأحبار عن عمار بن معاوية الدهني عن عبد الجبار بن العباس الشبامي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2850","2852  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الزُّبَيْرُ بْنُ بَكَّارٍ ، قَالَ :  وُلِدَ  الْحُسَيْنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ لِخَمْسِ لَيَالٍ خَلَوْنَ مِنْ شَعْبَانَ سَنَةَ أَرْبَعٍ مِنَ الْهِجْرَةِ  ، وَقُتِلَ يَوْمَ الْجُمُعَةِ يَوْمَ عَاشُورَاءَ فِي الْمُحَرَّمِ سَنَةَ إِحْدَى وَسِتِّينَ ، قَتَلَهُ  سِنَانُ بْنُ أَبِي أَنَسٍ النَّخَعِيُّ  ، وَأَجْهَزَ عَلَيْهِ  خَوْلِيُّ بْنُ يَزِيدَ الْأَصْبَحِيُّ  مِنْ  حِمْيَرَ  ، وَحَزَّ رَأْسَهُ وَأَتَى بِهِ  عُبَيْدَ اللهِ بْنَ زِيَادٍ  ، فَقَالَ  سِنَانُ بْنُ أَنَسٍ  :  أَوْقِرْ         [3/118]      "" .","","Al-Mu'jam al-Kabir 2852","","الزبير بن بكار عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2851","2853  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الزُّبَيْرُ ،  عَنْ  عَمِّهِ مُصْعَبِ بْنِ عَبْدِ اللهِ ، قَالَ :  خَرَجَتْ زَيْنَبُ الصُّغْرَى بِنْتُ عَقِيلِ بْنِ أَبِي طَالِبٍ عَلَى النَّاسِ  بِالْبَقِيعِ  تَبْكِي  قَتْلَاهَا  بِالطَّفِّ  ، وَهِيَ تَقُولُ :  فَقَالَ أَبُو الْأَسْوَدِ الدُّؤَلِيُّ : "" نَقُولُ :         {      رَبَّنَا ظَلَمْنَا أَنْفُسَنَا         }      الْآيَةَ ، ثُمَّ قَالَ  أَبُو الْأَسْوَدِ الدُّؤَلِيُّ  :  .","","Al-Mu'jam al-Kabir 2853","","أبو الأسود الدؤلي عن مصعب بن عبد الله بن مصعب الزبيري عن الزبير بن بكار عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2852","2854  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  إِسْحَاقُ بْنُ إِسْمَاعِيلَ الطَّالْقَانِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  أَبِي مُوسَى ،  عَنِ  الْحَسَنِ ، قَالَ :  قُتِلَ مَعَ  الْحُسَيْنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ سِتَّةَ عَشَرَ رَجُلًا مِنْ أَهْلِ بَيْتِهِ  ، وَاللهِ مَا عَلَى ظَهْرِ الْأَرْضِ يَوْمَئِذٍ أَهْلُ بَيْتٍ يُشْبِهُونَ  "" .  قَالَ  سُفْيَانُ  : "" وَمَنْ يَشُكُّ فِي هَذَا ؟ "" .","","Al-Mu'jam al-Kabir 2854","","الحسن البصري عن إسرائيل بن موسى أبو موسى البصري عن سفيان بن عيينة عن إسحاق بن إسماعيل الطالقاني عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2853","[3/119]      2855  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  حَدَّثَنَا  فِطْرُ بْنُ خَلِيفَةَ ،  عَنْ  مُنْذِرٍ الثَّوْرِيِّ ، قَالَ :  كُنَّا إِذَا ذَكَرْنَا  حُسَيْنًا  وَمَنْ قُتِلَ مَعَهُ رَضِيَ اللهُ عَنْهُمْ قَالَ مُحَمَّدُ بْنُ الْحَنَفِيَّةِ  : "" قُتِلَ مَعَهُ سَبْعَةَ عَشَرَ شَابًّا ، كُلُّهُمُ ارْتَكَضَ فِي رَحِمِ  فَاطِمَةَ  رَضِيَ اللهُ عَنْهَا  "" .","","Al-Mu'jam al-Kabir 2855","","ابن الحنفية عن المنذر بن يعلى الثوري عن فطر بن خليفة عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2854","2856  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ الْهَرَوِيُّ ،  أَنَا  هُشَيْمٌ ،  ثَنَا  أَبُو مَعْشَرٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ سَعِيدِ بْنِ الْعَاصِ ،  عَنِ  الزُّهْرِيِّ ، قَالَ :  قَالَ لِي عَبْدُ الْمَلِكِ بْنُ مَرْوَانَ : أَيُّ وَاحِدٍ أَنْتَ إِنْ أَخْبَرْتَنِي  أَيُّ عَلَامَةٍ كَانَتْ يَوْمَ قُتِلَ  الْحُسَيْنُ بْنُ عَلِيٍّ  ؟ قَالَ : قُلْتُ : "" لَمْ تُرْفَعْ حَصَاةٌ  بِبَيْتِ الْمَقْدِسِ  إِلَّا وُجِدَ تَحْتَهَا دَمٌ  عَبِيطٌ  "" . فَقَالَ  عَبْدُ الْمَلِكِ  : إِنِّي وَإِيَّاكَ فِي هَذَا الْحَدِيثِ لَقَرِينَانِ  .","","Al-Mu'jam al-Kabir 2856","","عبد الملك بن مروان بن الحكم عن الزهري عن محمد بن عبد الله بن سعيد بن العاص عن نجيح بن عبد الرحمن السندي عن هشيم بن بشير عن إبراهيم بن عبد الله الهروي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2855","2857  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  إِسْحَاقُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  سُفْيَانُ ،  حَدَّثَتْنِي  جَدَّتِي أُمُّ أَبِي ، قَالَتْ :  شَهِدَ رَجُلَانِ مِنَ  الْجُعْفِيِّينَ  قَتْلَ  الْحُسَيْنِ بْنِ عَلِيٍّ  "" . قَالَتْ : "" وَأَمَّا أَحَدُهُمَا فَطَالَ ذَكَرُهُ حَتَّى كَانَ يَلُفُّهُ  ، وَأَمَّا الْآخَرُ فَكَانَ يَسْتَقْبِلُ الرَّاوِيَةَ بِفِيهِ حَتَّى يَأْتِيَ عَلَى آخِرِهَا "" . قَالَ  سُفْيَانُ  : "" رَأَيْتُ وَلَدَ أَحَدِهِمَا كَأَنَّ لَهُ  خَبْلًا  ، وَكَأَنَّهُ مَجْنُونٌ  "" .","","Al-Mu'jam al-Kabir 2857","","جدة سفيان بن عيينة عن سفيان بن عيينة عن إسحاق بن إسماعيل الطالقاني عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2856","2858  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  إِسْحَاقُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  سُفْيَانُ ،  حَدَّثَتْنِي  جَدَّتِي أُمُّ أَبِي قَالَتْ :  رَأَيْتُ الْوَرْسَ الَّذِي أُخِذَ مِنْ عَسْكَرِ  الْحُسَيْنِ  صَارَ مِثْلَ الرَّمَادِ  "" .","","Al-Mu'jam al-Kabir 2858","","جدة سفيان بن عيينة عن سفيان بن عيينة عن إسحاق بن إسماعيل الطالقاني عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2857","2859  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  إِسْحَاقُ ،  ثَنَا  سُفْيَانُ ،  عَنْ  إِبْرَاهِيمَ بْنِ مَيْسَرَةَ ،  عَنْ  طَاوُسٍ ، قَالَ :  قَالَ  ابْنُ عَبَّاسٍ :  اسْتَأْذَنَنِي  حُسَيْنٌ  فِي الْخُرُوجِ ، فَقُلْتُ : لَوْلَا أَنْ يُزْرِيَ ذَلِكَ بِي أَوْ بِكَ لَشَبَكْتُ بِيَدِي فِي رَأْسِكَ  . قَالَ : فَكَانَ         [3/120]      الَّذِي رَدَّ عَلَيَّ أَنْ قَالَ : "" لَأَنْ أُقْتَلَ بِمَكَانِ كَذَا وَكَذَا أَحَبُّ إِلَيَّ مِنْ أَنْ يُسْتَحَلَّ بِي حَرَمُ اللهِ وَرَسُولِهِ "" . قَالَ : فَذَلِكَ الَّذِي سَلَى بِنَفْسِي عَنْهُ  .","","Al-Mu'jam al-Kabir 2859","","عبد الله بن عباس عن طاوس بن كيسان عن إبراهيم بن ميسرة الطائفي عن سفيان بن عيينة عن إسحاق بن إسماعيل الطالقاني عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2858","2860  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الْمَرْوَزِيُّ ،  ثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ، قَالَ :  خَرِئَ رَجُلٌ مِنْ  بَنِي أَسَدٍ  عَلَى قَبْرِ  حُسَيْنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  . قَالَ : "" فَأَصَابَ أَهْلَ ذَلِكَ الْبَيْتِ  خَبْلٌ  وَجُنُونٌ وَجُذَامٌ وَمَرَضٌ وَفَقْرٌ  "" .","","Al-Mu'jam al-Kabir 2860","","الأعمش عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2859","2861  -  حَدَّثَنَا  الْحَسَنُ بْنُ الْعَبَّاسِ الرَّازِيُّ  ، ثَنَا  سُلَيْمُ بْنُ مَنْصُورِ بْنِ عَمَّارٍ ،  ثَنَا  أَبِي  ، (  ح  ) .  وَحَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى بْنِ خَالِدِ بْنِ حَيَّانَ الرَّقِّيُّ ،  ثَنَا  عَمْرُو بْنُ بُكَيْرِ بْنِ بَكَّارٍ الْقَعْنَبِيُّ ،  ثَنَا  مُجَاشِعُ بْنُ عَمْرٍو ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ لَهِيعَةَ ،  عَنْ  أَبِي قَبِيلٍ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ عَمْرِو بْنِ الْعَاصِ أَنَّ مُعَاذَ بْنَ جَبَلٍ  أَخْبَرَهُ  ، قَالَ :  خَرَجَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُتَغَيِّرَ اللَّوْنِ ، فَقَالَ :  أَنَا  مُحَمَّدٌ  ، أُوتِيتُ فَوَاتِحَ الْكَلَامِ وَخَوَاتِمَهُ  ، فَأَطِيعُونِي مَا دُمْتُ بَيْنَ أَظْهُرِكُمْ ، فَإِذَا ذُهِبَ بِي فَعَلَيْكُمْ بِكِتَابِ اللهِ عَزَّ وَجَلَّ ، أَحِلُّوا حَلَالَهُ ، وَحَرِّمُوا حَرَامَهُ ، أَتَتْكُمْ بِالرَّوْحِ وَالرَّاحَةِ ، كِتَابٌ مِنَ اللهِ سَبَقَ ، أَتَتْكُمْ فِتَنٌ  كَقِطَعِ  اللَّيْلِ الْمُظْلِمِ ، كُلَّمَا ذَهَبَ رُسُلٌ جَاءَ رُسُلٌ ،  تَنَاسَخَتِ  النُّبُوَّةُ فَصَارَتْ مُلْكًا ، رَحِمَ اللهُ مَنْ أَخَذَهَا بِحَقِّهَا ، وَخَرَجَ مِنْهَا كَمَا دَخَلَهَا ، أَمْسِكْ يَا  مُعَاذُ  وَأَحْصِ "" . قَالَ : فَلَمَّا بَلَغْتُ خَمْسَةً قَالَ : ""  يَزِيدُ  لَا يُبَارِكُ اللهُ فِي  يَزِيدَ  "" . ثُمَّ  ذَرَفَتْ  عَيْنَاهُ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ قَالَ : "" نُعِيَ إِلَيَّ  حُسَيْنٌ  ، وَأُتِيتُ بِتُرْبَتِهِ ، وَأُخْبِرْتُ بِقَاتِلِهِ ، وَالَّذِي نَفْسِي بِيَدِهِ لَا يُقْتَلُ بَيْنَ ظَهْرَانَيْ قَوْمٍ لَا يَمْنَعُوهُ إِلَّا خَالَفَ اللهُ بَيْنَ صُدُورِهِمْ وَقُلُوبِهِمْ ، وَسَلَّطَ عَلَيْهِمْ شِرَارَهُمْ ، وَأَلْبَسَهُمْ  شِيَعًا  "" . ثُمَّ قَالَ : "" وَاهًا لِفِرَاخِ  آلِ مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ  خَلِيفَةٍ  مُسْتَخْلَفٍ  مُتْرَفٍ  ، يَقْتُلُ خَلَفِي وَخَلَفَ الْخَلَفِ ، أَمْسِكْ يَا  مُعَاذُ  "" .         [3/121]      فَلَمَّا بَلَغْتُ عَشَرَةً قَالَ : ""  الْوَلِيدُ  اسْمُ  فِرْعَوْنَ  هَادِمِ شَرَائِعِ الْإِسْلَامِ بَيْنَ يَدَيْهِ ،  رَجُلٌ  مِنْ أَهْلِ بَيْتٍ يَسُلُّ اللهُ سَيْفَهُ فَلَا غِمَادَ لَهُ ، وَاخْتَلَفَ النَّاسُ فَكَانُوا هَكَذَا "" ،  وَشَبَّكَ  بَيْنَ أَصَابِعِهِ ، ثُمَّ قَالَ : "" بَعْدَ الْعِشْرِينَ وَمِائَةٍ مَوْتٌ سَرِيعٌ ، وَقَتْلٌ ذَرِيعٌ ، فَفِيهِ هَلَاكُهُمْ ، وَيَلِي عَلَيْهِمْ  رَجُلٌ  مِنْ وَلَدِ  الْعَبَّاسِ  "" .","","Al-Mu'jam al-Kabir 2861","","معاذ بن جبل عن عبد الله بن عمرو بن العاص عن حيي بن هانئ السريعي عن عبد الله بن لهيعة عن مجاشع بن عمرو عن عمرو بن بكير بن بكار القعنبي عن أحمد بن يحيى بن خالد الرقي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2860","2862  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمَّارِ بْنِ أَبِي عَمَّارٍ ،  عَنْ  أُمِّ سَلَمَةَ رَضِيَ اللهُ عَنْهَا قَالَتْ :  سُمِعَتِ الْجِنُّ تَنُوحُ عَلَى  الْحُسَيْنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  "" .","","Al-Mu'jam al-Kabir 2862","","هند بنت أبي أمية زوج رسول الله عن عمار بن أبي عمار الحارثي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2861","2863  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ يَحْيَى الصُّوفِيُّ ،  ثَنَا  أَبُو غَسَّانَ ،  حَدَّثَنَا  أَبُو نُمَيْرٍ عَمُّ الْحَسَنِ بْنِ شُعَيْبٍ ،  عَنْ  أَبِي حُمَيْدٍ الطَّحَّانِ  ، قَالَ :  كُنْتُ فِي  خُزَاعَةَ  ، فَجَاءُوا بِشَيْءٍ مِنْ تَرِكَةِ  الْحُسَيْنِ  ، فَقِيلَ لَهُمْ : نَنْحَرُ أَوْ نَبِيعُ فَنَقْسِمُ . قَالَ : انْحَرُوا "" . قَالَ : "" فَجَلَسَ عَلَى جَفْنَةٍ ، فَلَمَّا وُضِعَتْ فَارَتْ نَارًا  "" .  كذا باللأصل طبعة مكتبة ابن تيمية أبي حميد الطحان ، وكذا ب ( خ ) أيضا 137 / أ ، وجاء في مجمع الزوائد [9 / 315] 15155 - وعن حميد الطحان قال : كنت في خزاعة فجاءوا بشيء من تركة الحسين فقيل لهم : ننحر أو نبيع فنقسم . قال : انحروا فجلست على جفنة فلما جلست فارت نارا رواه الطبراني وفيه من لم أعرفه","","Al-Mu'jam al-Kabir 2863","","أبو حميد الطحان عن أبو نمير عم الحسن بن شعيب عن مالك بن إسماعيل النهدي عن أحمد بن يحيى بن زكريا عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2862","2864  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ مُوسَى السُّدِّيُّ ،  ثَنَا  ذُوَيْدٌ الْجُعْفِيُّ ،  عَنْ  أَبِيهِ  ، قَالَ :  لَمَّا قُتِلَ  الْحُسَيْنُ  رَضِيَ اللهُ عَنْهُ انُتُهِبَ جَزُورٌ مِنْ عَسْكَرِهِ  ، فَلَمَّا طُبِخَتْ إِذَا هِيَ دَمٌ فَأَكْفَؤُوهَا  "" .","","Al-Mu'jam al-Kabir 2864","","أبيه عن ذويد الجعفي عن إسماعيل بن موسى الفزاري عن الساجي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2863","2865  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  ثَنَا  عُمَرُ بْنُ عَبْدِ الرَّحْمَنِ أَبُو حَفْصٍ الْأَبَّارُ ،  عَنْ  إِسْمَاعِيلَ بْنِ عَبْدِ الرَّحْمَنِ الْأَزْدِيِّ ،  عَنْ  أَبِي جَنَابٍ ، قَالَ :  سُمِعَ مِنَ الْجِنِّ يَبْكُونَ عَلَى  الْحُسَيْنِ بْنِ عَلِيِّ بْنِ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُ  :  "" .","","Al-Mu'jam al-Kabir 2865","","يحيى بن أبي حية عن إسماعيل بن عبد الرحمن الأودي عن عمر بن عبد الرحمن بن قيس عن سريج بن يونس المروزي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2864","[3/122]      2866  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  جَنْدَلُ بْنُ وَالِقٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ الطُّفَيْلِ ،  عَنْ  أَبِي زَيْدٍ الْفُقَيْمِيِّ ،  عَنْ  أَبِي جَنَابٍ الْكَلْبِيِّ ،  حَدَّثَنِي  الْجَصَّاصُونَ ، قَالُوا :  كُنَّا إِذَا خَرَجْنَا بِاللَّيْلِ إِلَى  الْجَبَّانَةِ  عِنْدَ مَقْتَلِ  الْحُسَيْنِ  رَضِيَ اللهُ عَنْهُ  ، سَمِعَنَا الْجِنَّ يَنُوحُونَ عَلَيْهِ وَيَقُولُونَ :  "" .","","Al-Mu'jam al-Kabir 2866","","الجصاصون عن يحيى بن أبي حية عن أبو زيد الفقيمي عن عبد الله بن الطفيل عن جندل بن والق التغلبي عن محمد بن عثمان بن أبي شيبة عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2865","2867  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمَّارِ بْنِ أَبِي عَمَّارٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  سُمِعَتِ الْجِنُّ تَنُوحُ عَلَى  الْحُسَيْنِ  رَضِيَ اللهُ عَنْهُ  "" .","","Al-Mu'jam al-Kabir 2867","","هند بنت أبي أمية زوج رسول الله عن عمار بن أبي عمار الحارثي عن حماد بن سلمة عن هدبة بن خالد عن عبد الله بن أحمد بن حنبل عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2866","2868  -  حَدَّثَنَا  عَبْدُ اللهِ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمَّارٍ ،  عَنْ  مَيْمُونَةَ ، قَالَتْ :  سُمِعَتِ الْجِنُّ تَنُوحُ عَلَى  الْحُسَيْنِ  "" .","","Al-Mu'jam al-Kabir 2868","","ميمونة بنت الحارث زوج رسول الله عن عمار بن أبي عمار الحارثي عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن عبد الله بن أحمد بن حنبل عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2867","2869  -  حَدَّثَنَا  الْقَاسِمُ بْنُ عَبَّادٍ الْخَطَّابِيُّ  ، ثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  ثَنَا  عَمْرُو بْنُ ثَابِتٍ ، قَالَ :  قَالَتْ  أُمُّ سَلَمَةَ :  مَا سَمِعْتُ نَوْحَ الْجِنِّ مُنْذُ قُبِضَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا اللَّيْلَةَ  ، وَمَا أَرَى ابْنِي إِلَّا قَدْ قُتِلَ "" - تَعْنِي  الْحُسَيْنَ  رَضِيَ اللهُ عَنْهُ - فَقَالَتْ لِجَارِيَتِهَا : "" اخْرُجِي فَسَلِي "" فَأُخْبِرَتْ أَنَّهُ قَدْ قُتِلَ ، وَإِذَا جِنِّيَّةٌ تَنُوحُ :  بِجَهْدِ  .","","Al-Mu'jam al-Kabir 2869","","هند بنت أبي أمية زوج رسول الله عن عمرو  بن أبي المقدام عن سويد بن سعيد الحدثاني عن القاسم بن عباد الخطابى عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2868","[3/123]      2870  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ الْحَكَمِ بْنِ أَبِي زِيَادٍ ،  ثَنَا  أَبُو الْجَوَّابِ ،  ثَنَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ بَعْجَةَ ، قَالَ :  أَوَّلُ ذُلٍّ دَخَلَ عَلَى الْعَرَبِ قَتْلُ  الْحُسَيْنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  ، وَادِّعَاءُ  زِيَادٍ  "" .","","Al-Mu'jam al-Kabir 2870","","عمرو بن بعجة اليشكري عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن أحوص بن جواب الضبي عن عبد الله بن الحكم القطواني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2869","2871  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ يَحْيَى الصُّوفِيُّ ،  ثَنَا  أَبُو غَسَّانَ ،  ثَنَا  نُوحُ بْنُ دَرَّاجٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عُمَرَ بْنِ عَلِيِّ بْنِ حُسَيْنٍ ،  عَنْ  أَبِيهِ ، قَالَ :  قُتِلَ  الْحُسَيْنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ وَعَلَيْهِ دَيْنٌ كَثِيرٌ  ، فَبَاعَ فِيهَا  عَلِيُّ بْنُ حُسَيْنٍ  عَيْنَ كَذَا وَعَيْنَ كَذَا  "" .","","Al-Mu'jam al-Kabir 2871","","علي بن الحسين زين العابدين عن عمر بن علي بن الحسين بن علي بن أبي طالب الأصغر عن محمد بن إسحاق عن نوح بن دراج الطائي عن مالك بن إسماعيل النهدي عن أحمد بن يحيى بن زكريا عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2870","2872  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُوسَى بْنُ عَبْدِ الرَّحْمَنِ الْمَسْرُوقِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي الْجَحَّافِ ،  عَنْ  مُوسَى بْنِ عُمَيْرٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  أَمَرَ الْحُسَيْنُ مُنَادِيًا ، فَنَادَى : "" لَا يُقْبِلْ مَعَنَا رَجُلٌ عَلَيْهِ دَيْنٌ  . فَقَالَ  رَجُلٌ  : إِنَّ امْرَأَتِي ضَمِنَتْ دَيْنِي .  فَقَالَ  حُسَيْنٌ  رَضِيَ اللهُ عَنْهُ : "" وَمَا ضَمَانُ امْرَأَةٍ ؟  "" .","","Al-Mu'jam al-Kabir 2872","","الحسين بن علي عن أبو موسى بن عمير الأنصاري عن موسى بن عمير الأنصاري عن داود بن أبي عوف البرجمي عن سفيان الثوري عن محمد بن بشر بن الفرافصة عن موسى بن عبد الرحمن بن سعيد المسروقي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2871","2873  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ صَالِحٍ الْأَسَدِيُّ ،  ثَنَا  السَّرِيُّ بْنُ مَنْصُورِ بْنِ عَمَّارٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ لَهِيعَةَ ،  عَنْ  أَبِي قَبِيلٍ ، قَالَ :  لَمَّا قُتِلَ  الْحُسَيْنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا ، احْتَزُّوا رَأْسَهُ  ، وَقَعَدُوا فِي أَوَّلِ مَرْحَلَةٍ يَشْرَبُونَ النَّبِيذَ يَتَحَيَّوْنَ بِالرَّأْسِ ، فَخَرَجَ عَلَيْهِمْ قَلَمٌ مِنْ حَدِيدٍ مِنْ حَائِطٍ ، فَكَتَبَ بِسَطْرِ دَمٍ :  فَهَرَبُوا وَتَرَكُوا الرَّأْسَ ، ثُمَّ رَجَعُوا  "" .","","Al-Mu'jam al-Kabir 2873","","حيي بن هانئ السريعي عن عبد الله بن لهيعة عن منصور بن عمار  الخراساني عن السري بن منصور بن عمار عن محمد بن عبد الرحمن بن صالح الأسدي عن الساجي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2872","[3/124]      2874  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ غُورَكٍ ،  ثَنَا  أَبُو سَعِيدٍ التَّغْلِبِيُّ ،  عَنْ  يَحْيَى بْنِ يَمَانٍ ،  عَنْ  إِمَامٍ لِبَنِي سُلَيْمٍ ،  عَنْ  أَشْيَاخٍ لَهُ  غَزَوُا  الرُّومَ  ، فَنَزَلُوا فِي كَنِيسَةٍ مِنْ كَنَائِسِهِمْ  ، فَقَرَءُوا فِي حَجَرٍ مَكْتُوبٍ :  فَسَأَلْنَاهُمْ : مُنْذُ كَمْ بُنِيَتْ هَذِهِ الْكَنِيسَةُ ؟ قَالُوا : قَبْلَ أَنْ يُبْعَثَ نَبِيُّكُمْ بِثَلَاثِمِائَةِ سَنَةٍ  "" .  قَالَ أَبُو جَعْفَرٍ الْحَضْرَمِيُّ :  وَثَنَا  جَنْدَلُ بْنُ وَالِقٍ ،  عَنْ  مُحَمَّدِ بْنِ غُورَكٍ ، ثُمَّ سَمِعْتُهُ مِنْ  مُحَمَّدِ بْنِ غُورَكٍ  .","","Al-Mu'jam al-Kabir 2874","","أشياخ له عن إمام لبني سليم عن يحيى بن يمان العجلي عن محمد بن أسعد التغلبي عن محمد بن غورك عن جندل بن والق التغلبي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2873","2875  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ، قَالَ :  سَمِعْتُ  أَحْمَدَ بْنَ مُحَمَّدِ بْنِ حُمَيْدٍ الْجَهْمِيَّ ، مِنْ وَلَدِ أَبِي جَهْمِ بْنِ حُذَيْفَةَ ، يُنْشِدُ فِي قَتْلِ  الْحُسَيْنِ  ، وَقَالَ هَذَا الشِّعْرَ  لِزَيْنَبَ بِنْتِ عَقِيلِ بْنِ أَبِي طَالِبٍ  :  فَقَالَ أَبُو الْأَسْوَدِ الدُّؤَلِيُّ : "" نَقُولُ :         {      ظَلَمْنَا أَنْفُسَنَا وَإِنْ لَمْ تَغْفِرْ لَنَا وَتَرْحَمْنَا لَنَكُونَنَّ مِنَ الْخَاسِرِينَ         }      "" .","","Al-Mu'jam al-Kabir 2875","","أبو الأسود الدؤلي عن أحمد بن محمد بن حميد الجهمي عن زكريا بن يحيى السجزي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2874","2876  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  أَحْمَدُ بْنُ حُمَيْدٍ الْجَهْمِيُّ ،  ثَنَا         [3/125]      الْوَاقِدِيُّ ،  عَنْ  عِيسَى بْنِ عَبْدِ الرَّحْمَنِ السُّلَمِيِّ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  رَأْسُ  الْحُسَيْنِ  رَضِيَ اللهُ عَنْهُ  أَوَّلُ رَأْسٍ حُمِلَ فِي الْإِسْلَامِ  ""  .","","Al-Mu'jam al-Kabir 2876","","الشعبي عن عيسى بن عبد الرحمن السلمي عن الواقدي عن أحمد بن محمد بن حميد الفيل المخضوب عن زكريا بن يحيى السجزي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2875","2877  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عُبَيْدُ بْنُ إِسْمَاعِيلَ الْهَبَّارِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُوَيْدٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ، قَالَ :  دَخَلْتُ عَلَى  عُبَيْدِ اللهِ بْنِ زِيَادٍ  ، وَإِذَا رَأْسُ  الْحُسَيْنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ قُدَّامَهُ عَلَى تُرْسٍ  ، فَوَاللهِ مَا لَبِثْتُ إِلَّا قَلِيلًا حَتَّى دَخَلْتُ عَلَى  الْمُخْتَارِ  ، فَإِذَا رَأْسُ  عُبَيْدِ اللهِ بْنِ زِيَادٍ  عَلَى تُرْسٍ ، فَوَاللهِ مَا لَبِثْتُ إِلَّا قَلِيلًا حَتَّى دَخَلْتُ عَلَى  مُصْعَبِ بْنِ الزُّبَيْرِ  وَإِذَا رَأْسُ  الْمُخْتَارِ  عَلَى تُرْسٍ ، فَوَاللهِ مَا لَبِثْتُ إِلَّا قَلِيلًا حَتَّى دَخَلْتُ عَلَى  عَبْدِ الْمَلِكِ بْنِ مَرْوَانَ  وَإِذَا رَأْسُ  مُصْعَبِ بْنِ الزُّبَيْرِ  عَلَى تُرْسٍ  "" .","","Al-Mu'jam al-Kabir 2877","","عبد الملك بن عمير القبطي عن سعيد بن سويد عن عبيد بن إسماعيل الهباري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2876","2878  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  لَمَّا أُتِيَ بِرَأْسِ  الْحُسَيْنِ بْنِ عَلِيٍّ  إِلَى  عُبَيْدِ اللهِ بْنِ زِيَادٍ  ، جَعَلَ  يَنْكُتُ  بِقَضِيبٍ  فِي يَدِهِ  ، وَيَقُولُ : إِنْ كَانَ لَحَسَنَ الثَّغْرِ . فَقُلْتُ : وَاللهِ لَأَسُوءَنَّكَ ، لَقَدْ رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُقَبِّلُ مَوْضِعَ قَضِيبِكَ مِنْ فِيهِ  .","","Al-Mu'jam al-Kabir 2878","","أنس بن مالك عن علي بن زيد بن جدعان عن حماد بن سلمة عن سليمان بن حرب الواشحي عن أبو مسلم الكجي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2877","2879  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  الْحُسَيْنُ بْنُ عُبَيْدِ اللهِ الْكُوفِيُّ ،  ثَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  ثَنَا  هِشَامُ بْنُ حَسَّانَ ،  عَنْ  حَفْصَةَ بِنْتِ سِيرِينَ ،  عَنْ  أَنَسٍ ، قَالَ :  كُنْتُ عِنْدَ  ابْنِ زِيَادٍ  حِينَ أُتِيَ بِرَأْسِ  الْحُسَيْنِ  ، فَجَعَلَ يَقُولُ  بِقَضِيبٍ  فِي أَنْفِهِ  : مَا رَأَيْتُ مِثْلَ هَذَا حُسْنًا . فَقُلْتُ : "" أَمَا إِنَّهُ كَانَ مِنْ أَشْبَهِهِمْ بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  "" .","","Al-Mu'jam al-Kabir 2879","","أنس بن مالك عن حفصة بنت سيرين عن هشام بن حسان العتكي عن النضر بن شميل عن الحسين بن عبيد الله العجلي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2878","2880  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ شَرِيكٍ ،  عَنْ  بِشْرِ بْنِ غَالِبٍ ،  عَنِ  الْحُسَيْنِ بْنِ عَلِيٍّ ، قَالَ :  مَنْ أَحَبَّنَا         [3/126]      لِلدُّنْيَا فَإِنَّ صَاحِبَ الدُّنْيَا يُحِبُّهُ الْبَرُّ وَالْفَاجِرُ  ، وَمَنْ أَحَبَّنَا لِلهِ كُنَّا نَحْنُ وَهُوَ يَوْمَ الْقِيَامَةِ كَهَاتَيْنِ "" . وَأَشَارَ بِالسَّبَّابَةِ وَالْوُسْطَى  .","","Al-Mu'jam al-Kabir 2880","","الحسين بن علي عن بشر بن غالب بن جنادة الأسدي عن عبد الله بن شريك العامري عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2879","2881  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ، وَمُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ، وَأَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّونَ ، قَالُوا :  ثَنَا  إِبْرَاهِيمُ بْنُ حَمَّادِ بْنِ أَبِي حَازِمٍ الْمَدِينِيُّ ،  ثَنَا  عِمْرَانُ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ لِلهِ عَزَّ وَجَلَّ  حُرُمَاتٍ  ثَلَاثًا  ، مَنْ حَفِظَهُنَّ حَفِظَ اللهُ لَهُ أَمْرَ دِينِهِ وَدُنْيَاهُ ، وَمَنْ لَمْ يَحْفَظْهُنَّ لَمْ يَحْفَظِ اللهُ لَهُ شَيْئًا :  حُرْمَةَ  الْإِسْلَامِ ،  وَحُرْمَتِي  ،  وَحُرْمَةَ  رَحِمِي  "" .","","Al-Mu'jam al-Kabir 2881","","أبو سعيد الخدري عن سعيد بن المسيب عن محمد بن سعيد بن المسيب المخزومي عن عمران بن محمد بن سعيد المخزومي عن إبراهيم بن حماد الزهري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2880","2882  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ الْمِصْرِيُّ ،  ثَنَا  يُوسُفُ بْنُ عَدِيٍّ ،  ثَنَا  حَمَّادُ بْنُ الْمُخْتَارِ ،  عَنْ  عَطِيَّةَ الْعَوْفِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ رَضِيَ اللهُ عَنْهُ قَالَ :  دَخَلْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  قَدْ أُعْطِيتُ  الْكَوْثَرَ  . قُلْتُ : يَا رَسُولَ اللهِ ، وَمَا  الْكَوْثَرُ  ؟ قَالَ : "" نَهَرٌ فِي الْجَنَّةِ ، عَرْضُهُ وَطُولُهُ مَا بَيْنَ الْمَشْرِقِ وَالْمَغْرِبِ ، وَلَا يَشْرَبُ مِنْهُ أَحَدٌ فَيَظْمَأُ ، وَلَا يَتَوَضَّأُ مِنْهُ أَحَدٌ فَيَشْعَثُ ، لَا يَشْرَبُهُ إِنْسَانٌ خَفَرَ ذِمَّتِي ، وَلَا قَتَلَ  أَهْلَ بَيْتِي  "" .","","Al-Mu'jam al-Kabir 2882","","أنس بن مالك عن عطية بن سعد العوفي عن حماد بن يحيى بن المختار الكوفي عن يوسف بن عدي بن رزق الكوفي عن روح بن الفرج القطان عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2881","2883  -  حَدَّثَنَا  أَحْمَدُ بْنُ شُعَيْبٍ النَّسَائِيُّ  ، أَنَا  قُتَيْبَةُ بْنُ سَعِيدٍ ،  ثَنَا  ابْنُ         [3/127]      أَبِي الْمَوَالِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ مَوْهَبٍ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  سِتَّةٌ لَعَنْتُهُمْ ، وَكُلُّ نَبِيٍّ مُجَابٌ  : الزَّائِدُ فِي كِتَابِ اللهِ عَزَّ وَجَلَّ ، وَالْمُكَذِّبُ بِقَدَرِ اللهِ ، وَالْمُسْتَحِلُّ مَحَارِمَ اللهِ ، وَالْمُسْتَحِلُّ مِنْ  عِتْرَتِي  مَا حَرَّمَ اللهُ ، وَالتَّارِكُ لِلسُّنَّةِ  "" .","","Al-Mu'jam al-Kabir 2883","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن عبيد الله بن عبد الرحمن بن عبد الله بن موهب عن عبد الرحمن بن أبي الموال مولى علي بن أبي طالب عن قتيبة بن سعيد عن النسائي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2882","2884  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  مَهْدِيُّ بْنُ مَيْمُونٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ أَبِي يَعْقُوبَ ،  عَنِ  ابْنِ أَبِي نُعْمٍ ، قَالَ :  كُنْتُ عِنْدَ ابْنِ عُمَرَ ، فَسَأَلَهُ  رَجُلٌ  عَنْ دَمِ الْبَعُوضِ ، فَقَالَ : مِمَّنْ أَنْتَ ؟ قَالَ : مِنْ  أَهْلِ الْعِرَاقِ  . قَالَ : انْظُرُوا إِلَى هَذَا ، يَسْأَلُنِي عَنْ دَمِ الْبَعُوضِ ، وَقَدْ قَتَلُوا ابْنَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَقَدْ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  هُمَا رَيْحَانَتَايَ مِنَ الدُّنْيَا  "" .","","Al-Mu'jam al-Kabir 2884","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن أبي نعم البجلي عن محمد بن عبد الله بن أبي يعقوب عن مهدي بن ميمون المعولي عن حجاج بن المنهال الأنماطي عن أبو مسلم الكجي عن الطبراني","ذكر مولده وصفته وهيأته رضي الله عنه"
"2883","وَمَا  أَسْنَدَ  الْحُسَيْنُ بْنُ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا  عَلِيُّ بْنُ الْحُسَيْنِ  عَنْ أَبِيهِ رَضِيَ اللهُ عَنْهُمْ  2885  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَا :  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنْ  عُمَارَةَ بْنِ غَزِيَّةَ ،  عَنْ         [3/128]      عَبْدِ اللهِ بْنِ عَلِيِّ بْنِ الْحُسَيْنِ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْبَخِيلُ مَنْ ذُكِرْتُ عِنْدَهُ فَلَمْ يُصَلِّ عَلَيَّ  "" .","","Al-Mu'jam al-Kabir 2885","","الحسين بن علي عن علي بن الحسين زين العابدين عن عبد الله بن علي بن الحسين بن علي بن أبي طالب عن عمارة بن غزية عن سليمان بن بلال القرشي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","علي بن الحسين عن أبيه رضي الله عنهم"
"2884","2886  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُوسَى بْنُ دَاوُدَ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عَلِيِّ بْنِ حُسَيْنٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مِنْ حُسْنِ إِسْلَامِ الْمَرْءِ تَرْكُهُ مَا لَا  يَعْنِيهِ  "" .","","Al-Mu'jam al-Kabir 2886","","الحسين بن علي عن علي بن الحسين زين العابدين عن الزهري عن عبد الله بن عمر العمري عن موسى بن داود الخلقاني عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","علي بن الحسين عن أبيه رضي الله عنهم"
"2885","2887  -  حَدَّثَنَا  يُوسُفُ بْنُ الْحَكَمِ الضَّبِّيُّ  ، ثَنَا  مُحَمَّدُ بْنُ بَشِيرٍ الْكِنْدِيُّ ،  ثَنَا  عَبِيدَةُ بْنُ حُمَيْدٍ ،  حَدَّثَنِي  فِطْرُ بْنُ خَلِيفَةَ ،  عَنْ  أَبِي جَعْفَرٍ مُحَمَّدِ بْنِ عَلِيِّ بْنِ حُسَيْنٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ حُسَيْنِ بْنِ عَلِيٍّ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ ذُكِرْتُ عِنْدَهُ فَخَطِئَ الصَّلَاةَ عَلَيَّ ؛ خَطِئَ طَرِيقَ الْجَنَّةِ  "" .","","Al-Mu'jam al-Kabir 2887","","الحسين بن علي عن علي بن الحسين زين العابدين عن أبو جعفر الباقر عن فطر بن خليفة عن عبيدة بن حميد بن صهيب التيمي عن محمد بن بشير الدعاء عن دبيس يوسف بن الحكم بن سعيد عن الطبراني","علي بن الحسين عن أبيه رضي الله عنهم"
"2886","2888  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  ثَنَا  الْهَيَّاجُ بْنُ بِسْطَامٍ ،  ثَنَا  عَنْبَسَةُ ،  عَنْ  مُحَمَّدِ بْنِ سُلَيْمَانَ ،  عَنْ  عَلِيِّ بْنِ الْحُسَيْنِ ،  عَنْ  أَبِيهِ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اعْتِكَافُ عَشْرٍ فِي رَمَضَانَ كَحَجَّتَيْنِ وَعُمْرَتَيْنِ  "" .","","Al-Mu'jam al-Kabir 2888","","الحسين بن علي عن علي بن الحسين زين العابدين عن محمد بن سليمان عن عنبسة بن عبد الرحمن بن عنبسة الأموي عن هياج بن بسطام البرجمي عن سعيد بن سليمان سعدويه عن محمد بن الفضل بن جابر السقطى عن الطبراني","علي بن الحسين عن أبيه رضي الله عنهم"
"2887","2889  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  أَحْمَدُ بْنُ يَحْيَى الصُّوفِيُّ ،  ثَنَا  عَلِيُّ بْنُ قَادِمٍ ،  عَنْ  عَبْدِ السَّلَامِ بْنِ حَرْبٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  عَلِيِّ بْنِ الْحُسَيْنِ ،  عَنْ  أَبِيهِ  ، قَالَ :  أَحِبُّونَا بِحُبِّ الْإِسْلَامِ  ، فَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : "" لَا تَرْفَعُونِي فَوْقَ حَقِّي ، فَإِنَّ اللهَ تَعَالَى اتَّخَذَنِي عَبْدًا قَبْلَ أَنْ يَتَّخِذَنِي رَسُولًا  "" .","","Al-Mu'jam al-Kabir 2889","","الحسين بن علي عن علي بن الحسين زين العابدين عن يحيى بن سعيد الأنصاري عن عبد السلام بن حرب الملائي عن علي بن قادم الخزاعي عن أحمد بن يحيى بن زكريا عن الحسين بن إسحاق التستري عن الطبراني","علي بن الحسين عن أبيه رضي الله عنهم"
"2888","2890  -  حَدَّثَنَا  إِسْحَاقُ بْنُ مُحَمَّدٍ الْحَرَّاجِيُّ الْمَكِّيُّ ، وَالْعَبَّاسُ بْنُ حَمْدَانَ الْحَنَفِيُّ الْأَصْبَهَانِيُّ ، قَالَا :  ثَنَا  عَبْدُ الْجَبَّارِ بْنُ الْعَلَاءِ ،  ثَنَا  عَبْدُ اللهِ بْنُ مَيْمُونٍ         [3/129]      الْقَدَّاحُ ،  ثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  عَلِيِّ بْنِ حُسَيْنٍ ، قَالَ :  سَمِعْتُ  أَبِي  يَقُولُ :  لَمَّا كَانَ قَبْلَ وَفَاةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِثَلَاثَةِ أَيَّامٍ  ، هَبَطَ عَلَيْهِ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، فَقَالَ : يَا  مُحَمَّدُ  ، إِنَّ اللهَ عَزَّ وَجَلَّ أَرْسَلَنِي إِلَيْكَ إِكْرَامًا لَكَ ، وَتَفْضِيلًا لَكَ ، وَخَاصَّةً لَكَ ، أَسْأَلُكَ عَمَّا هُوَ أَعْلَمُ بِهِ مِنْكَ ، يَقُولُ : كَيْفَ تَجِدُكَ ؟ فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَجِدُنِي يَا  جِبْرِيلُ  مَغْمُومًا  ، وَأَجِدُنِي يَا  جِبْرِيلُ  مَكْرُوبًا "" . قَالَ : فَلَمَّا كَانَ الْيَوْمُ الثَّالِثُ هَبَطَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، وَهَبَطَ  مَلَكُ الْمَوْتِ  عَلَيْهِمَا السَّلَامُ ، وَهَبَطَ مَعَهُمَا مَلَكٌ فِي الْهَوَاءِ يُقَالُ لَهُ  إِسْمَاعِيلُ  عَلَى سَبْعِينَ أَلْفَ مَلَكٍ ، لَيْسَ فِيهِمْ مَلَكٌ إِلَّا عَلَى سَبْعِينَ أَلْفَ مَلَكٍ ، يُشَيِّعُهُمْ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، فَقَالَ : يَا  مُحَمَّدُ  ، إِنَّ اللهَ عَزَّ وَجَلَّ أَرْسَلَنِي إِلَيْكَ إِكْرَامًا لَكَ ، وَتَفْضِيلًا لَكَ ، وَخَاصَّةً لَكَ ، أَسْأَلُكَ عَمَّا هُوَ أَعْلَمُ بِهِ مِنْكَ ، يَقُولُ : كَيْفَ تَجِدُكُ ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَجِدُنِي يَا  جِبْرِيلُ  مَغْمُومًا ، وَأَجِدُنِي يَا  جِبْرِيلُ  مَكْرُوبًا "" . قَالَ : فَاسْتَأْذَنَ  مَلَكُ الْمَوْتِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى الْبَابِ ، فَقَالَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ : يَا  مُحَمَّدُ  ، هَذَا  مَلَكُ الْمَوْتِ  يَسْتَأْذِنُ عَلَيْكَ ، مَا اسْتَأْذَنَ عَلَى آدَمِيٍّ قَبْلَكَ ، وَلَا يَسْتَأْذِنُ عَلَى آدَمِيٍّ بَعْدَكَ . فَقَالَ : ائْذَنْ لَهُ . فَأَذِنَ لَهُ  جِبْرِيلُ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَقْبَلَ حَتَّى وَقَفَ بَيْنَ يَدَيْهِ ، فَقَالَ : يَا  مُحَمَّدُ  ، إِنَّ اللهَ عَزَّ وَجَلَّ أَرْسَلَنِي إِلَيْكَ ، وَأَمَرَنِي أَنْ أُطِيعَكَ فِيمَا أَمَرْتَنِي بِهِ ، إِنْ أَمَرْتَنِي أَنْ أَقْبِضَ نَفْسَكَ قَبَضْتُهَا ، وَإِنْ كَرِهْتَ تَرَكْتُهَا . فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَتَفْعَلُ يَا  مَلَكَ الْمَوْتِ  ؟ "" قَالَ : نَعَمْ ، وَبِذَلِكَ أُمِرْتُ أَنْ أُطِيعَكَ فِيمَا أَمَرْتَنِي بِهِ . فَقَالَ لَهُ  جِبْرِيلُ  ؟ عَلَيْهِ السَّلَامُ : إِنَّ اللهَ عَزَّ وَجَلَّ قَدِ اشْتَاقَ إِلَى لِقَائِكَ . فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" امْضِ لِمَا أُمِرْتَ بِهِ "" . فَقَالَ لَهُ  جِبْرِيلُ  : هَذَا آخِرُ وَطْأَتِي الْأَرْضَ ، إِنَّمَا كُنْتُ حَاجَتِي فِي الدُّنْيَا . فَلَمَّا تُوُفِّيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَجَاءَتِ التَّعْزِيَةُ ، جَاءَ آتٍ ، يَسْمَعُونَ  حِسَّهُ  وَلَا يَرَوْنَ شَخْصَهُ ، فَقَالَ : السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ ، كُلُّ نَفْسٍ ذَائِقَةُ الْمَوْتِ ، إِنَّ فِي اللهِ عَزَاءً مِنْ كُلِّ مُصِيبَةٍ ، وَخَلَفًا مِنْ كُلِّ هَالِكٍ ،  وَدَرَكًا  مِنْ كُلِّ مَا فَاتَ ، فَبِاللهِ فَثِقُوا ، وَإِيَّاهُ فَارْجُوا ، فَإِنَّ الْمُصَابَ مَنْ حُرِمَ الثَّوَابَ ، وَالسَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ  .","","Al-Mu'jam al-Kabir 2890","","الحسين بن علي عن علي بن الحسين زين العابدين عن أبو جعفر الباقر عن جعفر الصادق عن عبد الله بن ميمون القداح عن عبد الجبار بن العلاء العطار عن العباس بن حمدان الأصبهاني عن الطبراني","علي بن الحسين عن أبيه رضي الله عنهم"
"2889","[3/130]      2891  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ الْأَصْبَهَانِيُّ  ، ثَنَا  أَبُو حَفْصٍ عَمْرُو بْنُ عَلِيٍّ ،  ثَنَا  أَبُو دَاوُدَ ،  ثَنَا  شَيْبَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  جَابِرٍ ،  عَنْ  أَبِي جَعْفَرٍ مُحَمَّدِ بْنِ عَلِيِّ بْنِ حُسَيْنٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَوْصَى عِنْدَ مَوْتِهِ بِثَلَاثٍ  ، أَوْصَى أَنْ يُنْفَذَ جَيْشُ  أُسَامَةَ  ، وَلَا يَسْكُنَ مَعَهُ  الْمَدِينَةَ  إِلَّا أَهْلُ دِينِهِ "" . قَالَ  مُحَمَّدٌ  : وَنَسِيتُ الثَّالِثَةَ  .","","Al-Mu'jam al-Kabir 2891","","الحسين بن علي عن علي بن الحسين زين العابدين عن أبو جعفر الباقر عن جابر الجعفي عن شيبان بن عبد الرحمن المؤدب عن أبو داود الطيالسي عن الفلاس عن محمد بن العباس ابن الأخرم عن الطبراني","علي بن الحسين عن أبيه رضي الله عنهم"
"2890","2892  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  حَفْصُ بْنُ عُمَرَ الْمَازِنِيُّ ،  ثَنَا  أَرْطَاةُ بْنُ الْأَشْعَثِ الْعَدَوِيُّ ،  ثَنَا  بِشْرُ بْنُ عَبْدِ اللهِ بْنِ عَمْرِو بْنِ سَعِيدٍ الْخَثْعَمِيُّ ، قَالَ :  دَخَلْتُ عَلَى مُحَمَّدِ بْنِ عَلِيِّ بْنِ حُسَيْنٍ وَعِنْدَهُ ابْنُهُ ، فَقَالَ : هَلُمَّ إِلَى  الْغَدَاءِ  . فَقُلْتُ : قَدْ تَغَدَّيْتُ يَا ابْنَ رَسُولِ اللهِ . فَقَالَ لِي : إِنَّهُ هِنْدِبَاءُ . قُلْتُ : يَا ابْنَ رَسُولِ اللهِ ، وَمَا فِي الْهِنْدِبَاءِ ؟ قَالَ :  حَدَّثَنِي  أَبِي  عَنْ  جَدِّي  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا مِنْ وَرَقَةٍ مِنْ وَرَقِ الْهِنْدِبَاءِ  إِلَّا وَعَلَيْهَا قَطْرَةٌ مِنْ مَاءِ الْجَنَّةِ "" .  ثُمَّ أَتَى بِدُهْنٍ ، فَقَالَ : ادَّهِنْ . فَقُلْتُ : قَدِ ادَّهَنْتُ يَا ابْنَ رَسُولِ اللهِ . قَالَ : إِنَّهُ بَنَفْسَجٌ . قُلْتُ : وَمَا فِي الْبَنَفْسَجِ ؟ قَالَ :  حَدَّثَنِي  أَبِي  عَنْ  جَدِّي  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ فَضْلَ الْبَنَفْسَجِ عَلَى سَائِرِ الْأَدْهَانِ  كَفَضْلِ وَلَدِ  عَبْدِ الْمُطَّلِبِ  عَلَى سَائِرِ  قُرَيْشٍ  ، وَإِنَّ فَضْلَ دُهْنِ الْبَنَفْسَجِ كَفَضْلِ الْإِسْلَامِ عَلَى سَائِرِ الْأَدْيَانِ  "" .","","Al-Mu'jam al-Kabir 2892","","الحسين بن علي عن علي بن الحسين زين العابدين عن أبو جعفر الباقر عن بشر بن عبد الله بن عمرو بن سعيد الخثعمي عن أرطاة بن أشعث العدوي عن حفص بن عمر بن خالد المازني عن أحمد بن داود بن موسى السدوسي عن الطبراني","علي بن الحسين عن أبيه رضي الله عنهم"
"2891","فَاطِمَةُ بِنْتُ الْحُسَيْنِ  عَنْ أَبِيهَا رَضِيَ اللهُ عَنْهَا  2893  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  سُفْيَانُ ،  حَدَّثَنِي         [3/131]      مُصْعَبُ بْنُ مُحَمَّدٍ ،  عَنْ  يَعْلَى بْنِ أَبِي يَحْيَى ،  عَنْ  فَاطِمَةَ بِنْتِ الْحُسَيْنِ ،  عَنْ  أَبِيهَا  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لِلسَّائِلِ  حَقٌّ وَإِنْ جَاءَ عَلَى فَرَسٍ  "" .","","Al-Mu'jam al-Kabir 2893","","الحسين بن علي عن فاطمة بنت الحسين بن علي بن أبي طالب عن يعلى بن أبي يحيى المدني عن مصعب بن محمد بن عبد الرحمن العبدري عن سفيان الثوري عن محمد بن كثير العبدي عن أبو مسلم الكجي عن الطبراني","فاطمة بنت الحسين عن أبيها رضي الله عنها"
"2892","2894  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  خَالِدُ بْنُ إِلْيَاسَ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ عَمْرِو بْنِ عُثْمَانَ ،  عَنْ  فَاطِمَةَ بِنْتِ الْحُسَيْنِ ،  عَنْ  حُسَيْنِ بْنِ عَلِيٍّ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ يُحِبُّ مَعَالِيَ الْأُمُورِ وَأَشْرَافَهَا  ، وَيَكْرَهُ  سَفْسَافَهَا  "" .","","Al-Mu'jam al-Kabir 2894","","الحسين بن علي عن فاطمة بنت الحسين بن علي بن أبي طالب عن الديباج ، محمد بن عبد الله بن عمرو عن خالد بن الياس العدوي عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","فاطمة بنت الحسين عن أبيها رضي الله عنها"
"2893","2895  -  حَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ الْجُمَحِيُّ ، وَإِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ، قَالَا :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلَّامٍ الْجُمَحِيُّ ،  ثَنَا  هِشَامٌ أَبُو الْمِقْدَامِ ،  عَنْ  أُمِّهِ فَاطِمَةَ بِنْتِ الْحُسَيْنِ ،  عَنْ  أَبِيهَا  رَضِيَ اللهُ عَنْهُ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ أَصَابَتْهُ مُصِيبَةٌ  ، فَقَالَ إِذَا ذَكَرَهَا :         {      إِنَّا لِلهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ         }      ، جَدَّدَ اللهُ لَهُ مِنْ أَجْرِهَا مِثْلَ مَا كَانَ يَوْمَ أَصَابَتْهُ  "" .","","Al-Mu'jam al-Kabir 2895","","الحسين بن علي عن فاطمة بنت الحسين بن علي بن أبي طالب عن هشام بن زياد بن أبي يزيد العثماني عن عبد الرحمن بن سلام الطرسوسي عن إبراهيم بن هاشم البغوي عن الطبراني","فاطمة بنت الحسين عن أبيها رضي الله عنها"
"2894","2896  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُوسَى بْنُ عَبْدِ الرَّحْمَنِ الْبَكْرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الْقُرَشِيُّ ،  حَدَّثَتْنَا  عَائِشَةُ بِنْتُ طَلْحَةَ ،  عَنْ  فَاطِمَةَ بِنْتِ الْحُسَيْنِ ،  عَنْ  أَبِيهَا  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا تَطْرُقُوا الطَّيْرَ فِي أَوْكَارِهَا  ، فَإِنَّ اللَّيْلَ لَهُ أَمَانٌ  "" .","","Al-Mu'jam al-Kabir 2896","","الحسين بن علي عن فاطمة بنت الحسين بن علي بن أبي طالب عن عائشة بنت طلحة التيمية عن عثمان بن عبد الرحمن بن عثمان التيمي عن موسى بن عبد الرحمن البكري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","فاطمة بنت الحسين عن أبيها رضي الله عنها"
"2895","2897  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنِ  الْحُسَيْنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ  عَنْ  أُمِّهِ فَاطِمَةَ بِنْتِ الْحُسَيْنِ ،  عَنْ  أَبِيهَا الْحُسَيْنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا         [3/132]      تُدِيمُوا النَّظَرَ إِلَى  الْمَجْذُومِينَ  "" .","","Al-Mu'jam al-Kabir 2897","","الحسين بن علي عن فاطمة بنت الحسين بن علي بن أبي طالب عن الحسين بن علي بن الحسين بن علي بن أبي طالب عن عبد الله بن المبارك عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","فاطمة بنت الحسين عن أبيها رضي الله عنها"
"2896","2898  -  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ الْبَاقِي ،  ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ لُوَيْنٌ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ سُلَيْمَانَ ،  عَنْ  عُمَارَةَ بْنِ غَزِيَّةَ ،  عَنْ  فَاطِمَةَ بِنْتِ الْحُسَيْنِ ،  عَنْ  أَبِيهَا  أَنَّ  عَبْدَ اللهِ بْنَ عَمْرٍو  جَاءَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ أَمِنَ الْكِبْرِ أَنْ أَلْبَسَ  الْحُلَّةَ  الْحَسَنَةَ ؟ قَالَ : "" لَا "" . قَالَ : فَمِنَ الْكِبْرِ أَنْ أَرْكَبَ النَّاقَةَ النَّجِيبَةَ ؟ قَالَ : "" لَا "" . قَالَ : أَفَمِنَ الْكِبْرِ أَنْ أَصْنَعَ طَعَامًا فَأَدْعُوَ قَوْمًا يَأْكُلُونَ عِنْدِي ، وَيَمْشُونَ خَلْفَ عَقِبِي ؟ قَالَ : "" لَا "" . قَالَ :  فَمَا الْكِبْرُ ؟ قَالَ : "" أَنْ  تُسَفِّهَ  الْحَقَّ ،  وَتَغْمِصَ  النَّاسَ  "" .","","Al-Mu'jam al-Kabir 2898","","الحسين بن علي عن فاطمة بنت الحسين بن علي بن أبي طالب عن عمارة بن غزية عن عبد الحميد بن سليمان الخزاعي عن محمد بن سليمان لوين عن يحيى بن عبد الباقي الثغري عن الطبراني","فاطمة بنت الحسين عن أبيها رضي الله عنها"
"2897","سُكَيْنَةُ بِنْتُ الْحُسَيْنِ  عَنْ أَبِيهَا  2899  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ الْعَطَّارُ الْمَكِّيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ مَوْلَى جُمَيْعِ بْنِ حَارِثَةَ الْأَنْصَارِيُّ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ مَاهَانَ الْأَزْدِيُّ ،  حَدَّثَنِي  فَايِدٌ مَوْلَى عُبَيْدِ اللهِ بْنِ أَبِي رَافِعٍ ،  حَدَّثَتْنِي  سُكَيْنَةُ بِنْتُ الْحُسَيْنِ بْنِ عَلِيٍّ ،  عَنْ  أَبِيهَا  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  حَمَلَةُ الْقُرْآنِ  عُرَفَاءُ  أَهْلِ الْجَنَّةِ يَوْمَ الْقِيَامَةِ  "" .","","Al-Mu'jam al-Kabir 2899","","الحسين بن علي عن سكينة بنت الحسين بن على الهاشمية عن فائد المدني مولى عبادل عن عبد الله بن ماهان الأزدي عن إسحاق بن إبراهيم بن سعيد الصواف عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","سكينة بنت الحسين عن أبيها"
"2898","عُبَيْدُ اللهِ بْنُ أَبِي يَزِيدَ  عَنِ  الْحُسَيْنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمْ  2900  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ، قَالَ :  سَأَلْتُ  عُبَيْدَ اللهِ بْنَ أَبِي يَزِيدَ : رَأَيْتَ الْحُسَيْنَ بْنَ عَلِيٍّ  قَالَ  : نَعَمْ ، رَأَيْتُهُ جَالِسًا فِي  حَوْضِ زَمْزَمَ  . قُلْتُ : هَلْ رَأَيْتَهُ صَبَغَ . قَالَ :  لَا إِلَّا أَنِّي رَأَيْتُهُ وَلِحْيَتُهُ سَوْدَاءُ إِلَى هَذَا الْمَوْضِعِ ، يَعْنِي  عَنْفَقَتَهُ  ، وَأَسْفَلُ مِنْ ذَلِكَ بَيَاضٌ . وَذَكَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ شَابَ ذَلِكَ الْمَوْضِعُ مِنْهُ ، وَكَانَ يَتَشَبَّهُ بِهِ  "" .","","Al-Mu'jam al-Kabir 2900","","الحسين بن علي عن عبيد الله بن أبي يزيد الكناني عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن عبد الله بن أحمد بن حنبل عن الطبراني","عبيد الله بن أبي يزيد عن الحسين بن علي رضي الله عنهم"
"2899","[3/133]      عُبَيْدُ اللهِ بْنُ الْحَارِثِ  عَنِ  الْحُسَيْنِ  رَضِيَ اللهُ عَنْهُمَا  2901  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  ابْنُ الْأَصْبَهَانِيِّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  جَابِرٍ ،  عَنْ  عَمْرِو بْنِ خُبَيْبٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ الْحُرِّ  أَنَّهُ سَأَلَ  الْحُسَيْنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ :  أَعَهِدَ إِلَيْكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي مَسِيرِكَ هَذَا شَيْئًا ؟  قَالَ : "" لَا  "" .","","Al-Mu'jam al-Kabir 2901","","الحسين بن علي عن عبيد الله بن الحر الجعفي عن عمرو بن حبيب عن جابر الجعفي عن شريك بن عبد الله النخعي عن محمد بن سعيد حمدان عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبيد الله بن الحارث عن الحسين رضي الله عنهما"
"2900","الْمُطَّلِبُ بْنُ عَبْدِ اللهِ بْنِ الْحُسَيْنِ  رَضِيَ اللهُ عَنْهُ  2902  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  سُفْيَانُ بْنُ حَمْزَةَ ،  عَنْ  كَثِيرِ بْنِ زَيْدٍ ،  عَنِ  الْمُطَّلِبِ بْنِ عَبْدِ اللهِ ، قَالَ :  لَمَّا أُحِيطَ بِالْحُسَيْنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ ، قَالَ : مَا اسْمُ هَذَا الْمَوْضِعِ ؟ قَالُوا :  كَرْبَلَاءُ  . قَالَ : "" صَدَقَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  هِيَ كَرْبٌ وَبَلَاءٌ  "" .","","Al-Mu'jam al-Kabir 2902","","الحسين بن علي عن المطلب بن عبد الله بن حنطب المخزومي عن كثير بن زيد السهمي عن سفيان بن حمزة الأسلمي عن يعقوب بن حميد بن كاسب المدني عن علي بن سعيد بن بشير عليك عن الطبراني","المطلب بن عبد الله بن الحسين رضي الله عنه"
"2901","طَلْحَةُ بْنُ عُبَيْدِ اللهِ  عَنِ  الْحُسَيْنِ  رَضِيَ اللهُ عَنْهُ  2903  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْحُسَيْنِ الصُّوفِيُّ  ، ثَنَا  الْهَيْثَمُ بْنُ خَارِجَةَ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ الْعَطَّارُ ،  عَنْ  يَحْيَى بْنِ الْعَلَاءِ ،  عَنْ  طَلْحَةَ بْنِ عُبَيْدِ اللهِ ،  عَنِ  الْحُسَيْنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  نِعْمَ الشَّيْءُ الْهَدِيَّةُ أَمَامَ الْحَاجَةِ  "" .","","Al-Mu'jam al-Kabir 2903","","الحسين بن علي عن طلحة بن عبيد الله بن كريز الخزاعي عن يحيى بن العلاء الفوراردي عن يحيى بن سعيد الأنصاري عن الهيثم بن خارجة الخراساني عن أبو محمد الجريري عن الطبراني","طلحة بن عبيد الله عن الحسين رضي الله عنه"
"2902","بِشْرُ بْنُ غَالِبٍ  عَنِ  الْحُسَيْنِ بْنِ عَلِيٍّ  2904  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ، (  ح  ) .  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ النُّعْمَانِ الْقَزَّازُ الْبَصْرِيُّ  ، ثَنَا  سُفْيَانُ بْنُ وَكِيعٍ ، قَالَا :  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  عَنْ  زِيَادِ بْنِ الْمُنْذِرِ ،  عَنْ  بِشْرِ بْنِ غَالِبٍ ،  عَنْ  حُسَيْنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَشْرَبُ وَهُوَ قَائِمٌ  "" .","","Al-Mu'jam al-Kabir 2904","","الحسين بن علي عن بشر بن غالب بن جنادة الأسدي عن زياد بن المنذر الهمداني عن يونس بن بكير عن سفيان بن وكيع بن الجراح عن عبد الله بن محمد بن النعمان القزاز البصري عن الطبراني","بشر بن غالب عن الحسين بن علي"
"2903","[3/134]      الْبَهْزِيُّ  عَنِ  الْحُسَيْنِ  2905  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ الْأَزْدِيُّ ، (  ح  ) .  وَحَدَّثَنَا  الْعَبَّاسُ بْنُ حَمْدَانَ الْحَنَفِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ يُوسُفَ الصَّيْرَفِيُّ ، قَالَا :  ثَنَا  عَمْرُو بْنُ هَاشِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَطَاءٍ ،  عَنِ  الْبَهْزِيِّ ، قَالَ :  سَأَلْتُ  الْحُسَيْنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ عَنْ  تَشَهُّدِ  عَلِيٍّ  رَضِيَ اللهُ عَنْهُ ، فَقَالَ : هُوَ  تَشَهُّدُ  رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ . قُلْتُ :  فَتَشَهُّدُ  عَبْدِ اللهِ  ؟ فَقَالَ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يُحِبُّ أَنْ يُخَفِّفَ عَلَى أُمَّتِهِ . فَقُلْتُ : كَيْفَ تَشَهَّدَ  عَلِيٌّ  بِتَشَهُّدِ  رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ :  التَّحِيَّاتُ  لِلهِ ، وَالصَّلَوَاتُ  وَالطَّيِّبَاتُ  الْغَادِيَاتُ الرَّائِحَاتُ الزَّاكِيَاتُ الطَّاهِرَاتُ لِلهِ  "" .","","Al-Mu'jam al-Kabir 2905","","الحسين بن علي عن البهزي عن عبد الله بن عطاء الطائفي عن عمرو بن هاشم الجنبي عن إبراهيم بن يوسف الصيرفي عن العباس بن حمدان الأصبهاني عن الطبراني","البهزي عن الحسين"
"2904","أَبُو سَعِيدٍ التَّيْمِيُّ عَقِيصَا  عَنِ  الْحُسَيْنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  2906  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ النُّعْمَانِ الْقَزَّازُ الْبَصْرِيُّ  ، ثَنَا  سُفْيَانُ بْنُ وَكِيعٍ ،  ثَنَا  حُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  فُضَيْلِ بْنِ مَرْزُوقٍ ،  عَنْ  أَبِي سَعِيدٍ التَّيْمِيِّ ، قَالَ :  سَمِعْتُ  الْحَسَنَ وَالْحُسَيْنَ رَضِيَ اللهُ عَنْهُمَا يَقُولَانِ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَبِسَ مَشْهُورًا مِنَ الثِّيَابِ  أَعْرَضَ اللهُ عَنْهُ يَوْمَ الْقِيَامَةِ  "" .","","Al-Mu'jam al-Kabir 2906","","الحسين بن علي عن دينار الكوفي عقيصا عن فضيل بن مرزوق الأغر عن حميد بن عبد الرحمن الرؤاسي عن سفيان بن وكيع بن الجراح عن عبد الله بن محمد بن النعمان القزاز البصري عن الطبراني","أبو سعيد التيمي عقيصا عن الحسين بن علي رضي الله عنه"
"2905","2907  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ النُّعْمَانِ الْقَزَّازُ ،  ثَنَا  سُفْيَانُ بْنُ وَكِيعٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبَانَ الْوَرَّاقُ ،  عَنْ  زِيَادِ بْنِ الْمُنْذِرِ ،  عَنْ  أَبِي سَعِيدٍ التَّيْمِيِّ ،  عَنِ  الْحَسَنِ وَالْحُسَيْنِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 2907","","الحسين بن علي عن دينار الكوفي عقيصا عن زياد بن المنذر الهمداني عن إسماعيل بن أبان عن سفيان بن وكيع بن الجراح عن عبد الله بن محمد بن النعمان القزاز عن الطبراني","أبو سعيد التيمي عقيصا عن الحسين بن علي رضي الله عنه"
"2906","سِنَانُ بْنُ أَبِي سِنَانٍ  عَنِ  الْحُسَيْنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا  2908  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ         [3/135]      مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سِنَانِ بْنِ أَبِي سِنَانٍ  أَنَّهُ سَمِعَ  حُسَيْنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ يُحَدِّثُ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَبَّأَ  لِابْنِ صَائِدٍ  دُخَانًا  ، فَسَأَلَهُ عَمَّا خَبَّأَ لَهُ ، فَقَالَ : دُخْ ، فَقَالَ :  اخْسَأْ فَلَنْ تَعْدُوَ قَدْرَكَ  . فَلَمَّا وَلَّى ، قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَا قَالَ ؟ "" فَقَالَ بَعْضُهُمْ : دُخْ ، وَقَالَ بَعْضُهُمْ : بَلْ قَالَ زُخْ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" قَدِ اخْتَلَفْتُمْ وَأَنَا بَيْنَ أَظْهُرِكُمْ ، فَأَنْتُمْ بَعْدِي أَشَدُّ اخْتِلَافًا  "" .","","Al-Mu'jam al-Kabir 2908","","الحسين بن علي عن سنان بن أبي سنان الدؤلي عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سنان بن أبي سنان عن الحسين بن علي رضي الله عنهما"
"2907","2909  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  عُقَيْلٌ  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سِنَانِ بْنِ أَبِي سِنَانٍ ،  عَنِ  الْحُسَيْنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمَّا خَبَّأَ  لِابْنِ صَائِدٍ  دُخَانًا  سَأَلَهُ عَمَّا خَبَّأَ لَهُ ، فَقَالَ : دُخْ ، فَقَالَ :  اخْسَأْ فَلَنْ تَعْدُوَ أَجَلَكَ  . فَلَمَّا وَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ  الْقَوْمُ  : مَاذَا قَالَ ؟ قَالَ بَعْضُهُمْ :  دُخُ  ، وَقَالَ بَعْضُهُمْ : بَلْ زُخْ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" هَذَا وَأَنْتُمْ مَعِي تَخْتَلِفُونَ ، فَأَنْتُمْ بَعْدِي أَشَدُّ اخْتِلَافًا  "" .","","Al-Mu'jam al-Kabir 2909","","الحسين بن علي عن سنان بن أبي سنان الدؤلي عن الزهري عن عقيل بن خالد الأيلي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","سنان بن أبي سنان عن الحسين بن علي رضي الله عنهما"
"2908","عَبَايَةُ بْنُ رِفَاعَةَ  عَنِ  الْحُسَيْنِ  رَضِيَ اللهُ عَنْهُ  2910  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مُعَاوِيَةَ بْنِ إِسْحَاقَ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنِ  الْحُسَيْنِ بْنِ عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنِّي جَبَانٌ ، وَإِنِّي ضَعِيفٌ . قَالَ :  هَلُمَّ إِلَى  جِهَادٍ  لَا  شَوْكَةَ  فِيهِ ،  الْحَجُّ  "" ..","","Al-Mu'jam al-Kabir 2910","","الحسين بن علي عن عباية بن رفاعة الزرقي عن معاوية بن إسحاق بن طلحة التيمي عن الوضاح بن عبد الله اليشكري عن إبراهيم بن الحجاج السامي عن عبد الله بن أحمد بن حنبل عن الطبراني","عباية بن رفاعة عن الحسين رضي الله عنه"
"2909","حَبِيبُ بْنُ أَبِي ثَابِتٍ  عَنِ  الْحُسَيْنِ  رَضِيَ اللهُ عَنْهُ  2911  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ  ، ثَنَا  زِيَادُ بْنُ يَحْيَى ،  ثَنَا  أَبُو عَتَّابٍ         [3/136]      الدَّلَّالُ ،  أَنَا  عَمْرُو بْنُ ثَابِتٍ ،  حَدَّثَنِي  حَبِيبُ بْنُ أَبِي ثَابِتٍ ، قَالَ :  صَنَعَتِ  امْرَأَةٌ مِنْ نِسَاءِ الْحُسَيْنِ  طَعَامًا فِي بَعْضِ أَرْضِهِ ، فَطَعِمَ ثُمَّ رُفِعَ الطَّعَامُ ، فَجَاءَ مَوْلًى لَهُ ، فَدَعَا بِالطَّعَامِ ، فَقَالَ : يَا  أَبَا عَبْدِ اللهِ  لَا أُرِيدُهُ . قَالَ : لِمَ ؟ قَالَ : أَكَلْنَا قُبَيْلُ عِنْدَ  عُبَيْدِ اللهِ بْنِ عَبَّاسٍ  ، فَقَالَ  الْحُسَيْنُ : إِنَّ أَبَاهُ كَانَ سَيِّدَ  قُرَيْشٍ  ، إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يَا  بَنِي عَبْدِ الْمُطَّلِبِ  أَطْعِمُوا الطَّعَامَ  ، وَأَطِيبُوا الْكَلَامَ  "" .","","Al-Mu'jam al-Kabir 2911","","الحسين بن علي عن حبيب بن أبي ثابت الكاهلي عن عمرو  بن أبي المقدام عن سهل بن حماد الدلال عن زياد بن يحيى الحساني عن أحمد بن عمرو بن حفص القريعي عن الطبراني","حبيب بن أبي ثابت عن الحسين رضي الله عنه"
"2910","أَبُو حَازِمٍ الْأَشْجَعِيُّ  عَنِ  الْحُسَيْنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  2912  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  الثَّوْرِيُّ ،  عَنْ  سَالِمٍ ، يَعْنِي ابْنَ أَبِي حَفْصَةَ ،  عَنْ  أَبِي حَازِمٍ ، قَالَ :  شَهِدْتُ  حُسَيْنًا رَضِيَ اللهُ عَنْهُ حِينَ مَاتَ  الْحَسَنُ  رَضِيَ اللهُ عَنْهُ وَهُوَ يَدْفَعُ فِي قَفَا  سَعِيدِ بْنِ الْعَاصِ  ، وَهُوَ يَقُولُ :  تَقَدَّمْ ، فَلَوْلَا أَنَّهَا السُّنَّةُ - يَقُولُ الشَّيْبَةُ - مَا قَدَّمْتُكَ  "" .  وَسَعِيدٌ  أَمِيرٌ عَلَى  الْمَدِينَةِ  يَوْمَئِذٍ .","","Al-Mu'jam al-Kabir 2912","","الحسين بن علي عن سلمان الأعرج مولى عزة الأشجعية عن سالم بن أبي حفصة العجلي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","أبو حازم الأشجعي عن الحسين بن علي رضي الله عنه"
"2911","2913  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُوسَى بْنُ عَبْدِ الرَّحْمَنِ الْمَسْرُوقِيُّ ،  ثَنَا  حُسَيْنٌ الْجُعْفِيُّ ،  عَنْ  زَائِدَةَ ،  عَنْ  سُفْيَانَ ،  عَنْ  سَالِمِ بْنِ أَبِي حَفْصَةَ ،  عَنْ  أَبِي حَازِمٍ ، قَالَ :  رَأَيْتُ  الْحُسَيْنَ بْنَ عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَدَّمَ  سَعِيدَ بْنَ الْعَاصِ  فِي جِنَازَةِ  الْحَسَنِ بْنِ عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  "" .","","Al-Mu'jam al-Kabir 2913","","الحسين بن علي عن سلمان الأعرج مولى عزة الأشجعية عن سالم بن أبي حفصة العجلي عن سفيان الثوري عن زائدة بن قدامة عن الحسين بن علي الجعفي عن موسى بن عبد الرحمن بن سعيد المسروقي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","أبو حازم الأشجعي عن الحسين بن علي رضي الله عنه"
"2912","[3/137]      بَابُ مَنِ اسْمُهُ حَمْزَةُ  237 -  حَمْزَةُ بْنُ عَبْدِ الْمُطَّلِبِ بْنِ عَبْدِ مَنَافٍ  عَمُّ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  وَأُمُّ حَمْزَةَ : هَالَةُ بِنْتُ أُهَيْبِ بْنِ عَبْدِ مَنَافِ بْنِ زُهْرَةَ  ، شَهِدَ  بَدْرًا  مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَيُكَنَّى  أَبَا عُمَارَةَ  ، وَيُقَالُ :  أَبُو يَعْلَى  "" .  2914  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ حَمْدَانَ الْحَنَفِيُّ الْأَصْبَهَانِيُّ ،  ثَنَا  عَلِيُّ بْنُ أَحْمَدَ الْجَوَارِبِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ عِمْرَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ الْمُخَرِّمِيِّ ،  عَنْ  أَبِي عَوْنٍ مَوْلَى الْمِسْوَرِ بْنِ مَخْرَمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  تَزَوَّجَ  عَبْدُ الْمُطَّلِبِ  هَالَةَ بِنْتَ أُهَيْبِ بْنِ عَبْدِ مَنَافِ بْنِ زُهْرَةَ  ، فَوَلَدَتْ لَهُ  حَمْزَةَ  وَصَفِيَّةَ  "" .","","Al-Mu'jam al-Kabir 2914","","العباس بن عبد المطلب عم رسول الله عن عبد الله بن عباس عن أبو عون بن أبي حازم المديني عن عبد الله بن جعفر بن عبد الرحمن بن المسور بن مخرمة عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن يعقوب بن محمد بن عيسى عن علي بن أحمد بن عبد الله الجواربي عن العباس بن حمدان الأصبهاني عن الطبراني","حمزة بن عبد المطلب بن عبد مناف"
"2913","2915  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ""  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  :  حَمْزَةُ بْنُ عَبْدِ الْمُطَّلِبِ  "" .","","Al-Mu'jam al-Kabir 2915","","","حمزة بن عبد المطلب بن عبد مناف"
"2914","2916  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْفَهَانِيُّ  ، حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  ""  فِي تَسْمِيَةِ مَنْ شَهِدِ  بَدْرًا  مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  :  حَمْزَةُ بْنُ عَبْدِ الْمُطَّلِبِ بْنِ عَبْدِ مَنَافٍ  "" .","","Al-Mu'jam al-Kabir 2916","","","حمزة بن عبد المطلب بن عبد مناف"
"2915","2917  -  حَدَّثَنِي  الْعَبَّاسُ بْنُ حَمْدَانَ الْحَنَفِيُّ الْأَصْبَهَانِيُّ ،  ثَنَا  عَلِيُّ بْنُ أَحْمَدَ الْجَوَارِبِيُّ الْوَاسِطِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ         [3/138]      عِمْرَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ الْمُخَرِّمِيِّ ،  عَنْ  أَبِي عَوْنٍ مَوْلَى الْمِسْوَرِ بْنِ مَخْرَمَةَ ،  عَنِ  الْمِسْوَرِ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  قَالَ  عَبْدُ الْمُطَّلِبِ  : "" خَرَجْتُ إِلَى  الْيَمَنِ  فِي إِحْدَى رِحْلَتَيِ الْإِيلَافِ  ، فَنَزَلْتُ عَلَى  رَجُلٍ مِنَ الْيَهُودِ  ، فَرَآنِي  رَجُلٌ مِنْ أَهْلِ الدُّيُورِ  ، فَنَسَبَنِي فَانْتَسَبْتُ لَهُ ، فَقَالَ : أَتَأْذَنُ لِي أَنْ أَنْظُرَ إِلَى بَعْضِكَ ؟ قُلْتُ : نَعَمْ ، مَا لَمْ تَكُنْ  عَوْرَةً  ، فَفَتَحَ إِحْدَى  مَنْخَرَيَّ  فَنَظَرَ ، ثُمَّ نَظَرَ فِي الْآخَرِ ، فَقَالَ : أَشْهَدُ أَنَّ فِي إِحْدَى يَدَيْكَ مُلْكًا ، وَفِي الْأُخْرَى نُبُوَّةً ، وَإِنَّا لَنَجِدُ ذَلِكَ فِي  بَنِي زُهْرَةَ  ، فَكَيْفَ ذَلِكَ ؟ قُلْتُ : لَا أَدْرِي . قَالَ : هَلْ لَكَ مِنْ  شَاعَةٍ  ؟ قُلْتُ : وَمَا  الشَّاعَةُ  ؟ قَالَ : زَوْجَةٌ . قُلْتُ : أَمَّا الْيَوْمَ فَلَا . قَالَ : فَإِذَا رَجَعْتَ فَتَزَوَّجْ فِي  بَنِي زُهْرَةَ  . فَرَجَعَ  عَبْدُ الْمُطَّلِبِ  ، فَتَزَوَّجَ  هَالَةَ بِنْتَ وُهَيْبِ بْنِ عَبْدِ مَنَافِ بْنِ زُهْرَةَ  ، فَوَلَدَتْ لَهُ  حَمْزَةَ  وَصَفِيَّةَ  ، وَزَوَّجَ  عَبْدَ اللهِ  ابْنَهُ  آمِنَةَ بِنْتَ وَهْبٍ  ، فَقَالَتْ  قُرَيْشٌ  : نَتَجَ  عَبْدُ الْمُطَّلِبِ  عَلَى ابْنِهِ ، فَوَلَدَتْ لَهُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَكَانَ  حَمْزَةُ  رَضِيَ اللهُ عَنْهُ أَخَا رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنَ الرَّضَاعَةِ ، أَرْضَعَتْهُمَا  ثُوَيْبَةُ مَوْلَاةُ أَبِي لَهَبٍ  ، وَكَانَ أَسَنَّ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  "" .","","Al-Mu'jam al-Kabir 2917","","العباس بن عبد المطلب عم رسول الله عن عبد الله بن عباس عن المسور بن مخرمة عن أبو عون بن أبي حازم المديني عن عبد الله بن جعفر بن عبد الرحمن بن المسور بن مخرمة عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن يعقوب بن محمد بن عيسى عن علي بن أحمد بن عبد الله الجواربي عن العباس بن حمدان الأصبهاني عن الطبراني","حمزة بن عبد المطلب بن عبد مناف"
"2916","2918  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  قُلْتُ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَلَا أَدُلُّكَ عَلَى أَحْسَنِ فَتَاةِ  قُرَيْشٍ  ؟ قَالَ :  مَنْ هِيَ ؟ "" قَالَ :  بِنْتُ حَمْزَةَ  . قَالَ : "" إِنَّهَا ابْنَةُ أَخِي مِنَ الرَّضَاعَةِ  "" .","","Al-Mu'jam al-Kabir 2918","","علي بن أبي طالب عن سعيد بن المسيب عن علي بن زيد بن جدعان عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","حمزة بن عبد المطلب بن عبد مناف"
"2917","2919  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، وَيُوسُفُ الْقَاضِي ، قَالَا :  ثَنَا  مُسَدَّدٌ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ :  قَالَ عَلِيٌّ رَضِيَ اللهُ عَنْهُ : يَا رَسُولَ اللهِ هَلْ لَكَ فِي بِنْتِ عَمِّكِ أَجْمَلِ فَتَاةٍ فِي  قُرَيْشٍ  ؟ قَالَ :  أَمَا عَلِمْتَ أَنَّ  حَمْزَةَ  أَخِي مِنَ الرَّضَاعَةِ ؟  "" .","","Al-Mu'jam al-Kabir 2919","","علي بن أبي طالب عن سعيد بن المسيب عن علي بن زيد بن جدعان عن سفيان بن عيينة عن مسدد بن مسرهد عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","حمزة بن عبد المطلب بن عبد مناف"
"2918","2920  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  أَبِي عَوْنٍ ،  عَنْ  أَبِي صَالِحٍ الْحَنَفِيِّ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  ذَكَرْتُ  بِنْتَ         [3/139]      حَمْزَةَ  لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِيَتَزَوَّجَهَا ، فَقَالَ :  هِيَ ابْنَةُ أَخِي مِنَ الرَّضَاعَةِ  "" .","","Al-Mu'jam al-Kabir 2920","","علي بن أبي طالب عن المسبح ماهان الأعور عن محمد بن عبيد الله بن سعيد الثقفي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","حمزة بن عبد المطلب بن عبد مناف"
"2919","2921  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  ثَنَا  سُفْيَانُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  سَعْدِ بْنِ عُبَيْدَةَ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، مَا لِي أَرَاكَ  تَتَوَّقُ  فِي  قُرَيْشٍ  وَتَدَعُنَا ؟ قَالَ :  عِنْدَكَ شَيْءٌ ؟ "" قُلْتُ : نَعَمْ ،  بِنْتُ حَمْزَةَ  . قَالَ : "" إِنَّهَا بِنْتُ أَخِي مِنَ الرَّضَاعَةِ  "" .","","Al-Mu'jam al-Kabir 2921","","علي بن أبي طالب عن عبد الله بن حبيب السلمي عن سعد بن عبيدة السلمي عن الأعمش عن سفيان الثوري عن عبد الرحمن بن مهدي عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","حمزة بن عبد المطلب بن عبد مناف"
"2920","2922  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُرِيدَ عَلَى  بِنْتِ حَمْزَةَ  ، فَقَالَ : "" إِنَّهَا لَا تَحِلُّ لِي ؛ إِنَّهَا ابْنَةُ أَخِي مِنَ الرَّضَاعَةِ ،  وَيَحْرُمُ مِنَ الرَّضَاعَةِ مَا يَحْرُمُ مِنَ النَّسَبِ  "" .","","Al-Mu'jam al-Kabir 2922","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن هدبة بن خالد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","حمزة بن عبد المطلب بن عبد مناف"
"2921","2923  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  سَعِيدٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُرِيدَ عَلَى  بِنْتِ حَمْزَةَ  ، فَقَالَ : "" إِنَّهَا بِنْتُ أَخِي مِنَ الرَّضَاعَةِ ،  وَإِنَّ اللهَ عَزَّ وَجَلَّ يُحَرِّمُ مِنَ الرَّضَاعِ مَا يُحَرِّمُ مِنَ النَّسَبِ  "" .","","Al-Mu'jam al-Kabir 2923","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن محمد بن المنهال عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","حمزة بن عبد المطلب بن عبد مناف"
"2922","2924  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  مَخْرَمَةُ بْنُ بُكَيْرٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ مُسْلِمٍ يَقُولُ :  سَمِعْتُ  مُحَمَّدَ بْنَ مُسْلِمٍ يَقُولُ :  سَمِعْتُ  حُمَيْدَ بْنَ عَبْدِ الرَّحْمَنِ يَقُولُ :  سَمِعْتُ  أُمَّ سَلَمَةَ تَقُولُ :  قِيلَ : يَا رَسُولَ اللهِ ،  أَيْنَ أَنْتَ مِنْ  بِنْتِ حَمْزَةَ  ؟ أَوْ قِيلَ : أَلَا تَخْطُبُ  بِنْتَ حَمْزَةَ  ؟  قَالَ :  حَمْزَةُ  أَخِي مِنَ الرَّضَاعَةِ  "" .","","Al-Mu'jam al-Kabir 2924","","هند بنت أبي أمية زوج رسول الله عن حميد بن عبد الرحمن القرشي عن الزهري عن عبد الله بن مسلم أخو ابن شهاب الزهري عن بكير بن عبد الله بن الأشج القرشي عن مخرمة بن بكير المخزومي عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل بن الحسن الخفاف عن الطبراني","حمزة بن عبد المطلب بن عبد مناف"
"2923","2925  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ الْمِصْرِيُّ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  أُسَامَةُ بْنُ زَيْدٍ اللَّيْثِيُّ ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ         [3/140]      كَعْبٍ الْقُرَظِيَّ يَقُولُ :  كَانَ إِسْلَامُ حَمْزَةَ بْنِ عَبْدِ الْمُطَّلِبِ رَحِمَهُ اللهُ حَمِيَّةً  ، وَكَانَ رَجُلًا رَامِيًا ، وَكَانَ يَخْرُجُ مِنَ الْحَرَمِ فَيَصْطَادُ ، فَإِذَا رَجَعَ مَرَّ بِمَجْلِسِ  قُرَيْشٍ  ، وَكَانُوا يَجْلِسُونَ عِنْدَ  الصَّفَا  وَالْمَرْوَةِ  ، فَيَمُرُّ بِهِمْ فَيَقُولُ : رَمَيْتُ كَذَا ، وَصَنَعْتُ كَذَا وَكَذَا ، ثُمَّ يَنْطَلِقُ إِلَى مَنْزِلِهِ ، وَأَقْبَلَ مِنْ رَمْيِهِ ذَاتَ يَوْمٍ ، فَلَقِيَتْهُ  امْرَأَةٌ  ، فَقَالَتْ : يَا  أَبَا عُمَارَةَ  ، مَاذَا لَقِيَ ابْنُ أَخِيكَ مِنْ  أَبِي جَهْلِ بْنِ هِشَامٍ  ؟ وَتَنَاوَلَهُ وَفَعَلَ بِهِ وَفَعَلَ . فَقَالَ : "" هَلْ رَآهُ أَحَدٌ ؟ "" قَالَتْ :  إِي  وَاللهِ لَقَدْ رَآهُ نَاسٌ . فَأَقْبَلَ حَتَّى انْتَهَى إِلَى ذَلِكَ الْمَجْلِسِ عِنْدَ  الصَّفَا  وَالْمَرْوَةِ  ، فَإِذَا هُمْ جُلُوسٌ  وَأَبُو جَهْلٍ  فِيهِمْ ، فَاتَّكَأَ عَلَى قَوْسِهِ ، فَقَالَ : "" رَمَيْتُ كَذَا وَفَعَلْتُ كَذَا "" ، ثُمَّ جَمَعَ يَدَهُ بِالْقَوْسِ ، فَضَرَبَ بِهَا بَيْنَ أُذُنَيْ  أَبِي جَهْلٍ  ، فَدَقَّ  سِيَتَهَا  ، ثُمَّ قَالَ : "" خُذْهَا بِالْقَوْسِ ، وَأُخْرَى بِالسَّيْفِ ، أَشْهَدُ أَنَّهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَنَّهُ جَاءَ بِالْحَقِّ مِنْ عِنْدِ اللهِ "" . قَالُوا : يَا  أَبَا عُمَارَةَ  ، إِنَّهُ سَبَّ آلِهَتَنَا ، وَلَوْ كُنْتَ أَنْتَ ، وَأَنْتَ أَفْضَلُ مِنْهُ ، مَا أَقْرَرْنَاكَ وَذَاكَ ، وَمَا كُنْتَ يَا  أَبَا عُمَارَةَ  فَاحِشًا  .","","Al-Mu'jam al-Kabir 2925","","أسد الله حمزة بن عبد المطلب عن محمد بن كعب بن سليم القرظي عن أسامة بن زيد الليثي المدني عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل بن الحسن الخفاف المصري عن الطبراني","حمزة بن عبد المطلب بن عبد مناف"
"2924","2926  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ يَعْقُوبَ الْجُوزَجَانِيُّ ،  ثَنَا  عُبَيْدُ بْنُ عَقِيلٍ ،  ثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَعْقُوبَ بْنِ عُتْبَةَ بْنِ الْمُغِيرَةِ بْنِ الْأَخْنَسِ بْنِ شَرِيقٍ حَلِيفِ  بَنِي زُهْرَةَ  أَنَّ  أَبَا جَهْلٍ  اعْتَرَضَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِالصَّفَا  فَآذَاهُ  ، وَكَانَ حَمْزَةُ رَضِيَ اللهُ عَنْهُ صَاحِبَ قَنْصٍ وَصَيْدٍ ، وَكَانَ يَوْمَئِذٍ فِي قَنْصِهِ ، فَلَمَّا رَجَعَ قَالَتْ لَهُ امْرَأَتُهُ ، وَكَانَتْ قَدْ رَأَتْ مَا صَنَعَ  أَبُو جَهْلٍ  لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : يَا  أَبَا عُمَارَةَ  ، لَوْ رَأَيْتَ مَا صَنَعَ - تَعْنِي  أَبَا جَهْلٍ  - بِابْنِ أَخِيكَ ؟ فَغَضِبَ  حَمْزَةُ  ، وَمَضَى كَمَا هُوَ قَبْلَ أَنْ يَدْخُلَ بَيْتَهُ ، وَهُوَ مُعَلِّقٌ قَوْسَهُ فِي عُنُقِهِ حَتَّى دَخَلَ الْمَسْجِدَ ، فَوَجَدَ  أَبَا جَهْلٍ  فِي مَجْلِسٍ مِنْ مَجَالِسِ  قُرَيْشٍ  ، فَلَمْ يُكَلِّمْهُ حَتَّى عَلَا رَأْسَهُ بِقَوْسِهِ  فَشَجَّهُ  ، فَقَامَ رِجَالٌ مِنْ  قُرَيْشٍ  إِلَى  حَمْزَةَ  يُمْسِكُونَهُ عَنْهُ ، فَقَالَ  حَمْزَةُ  : "" دِينِي دِينُ  مُحَمَّدٍ  ، أَشْهَدُ أَنَّهُ رَسُولُ اللهِ ، فَوَاللهِ لَا أَنْثَنِي عَنْ ذَلِكَ ، فَامْنَعُونِي مِنْ ذَلِكَ إِنْ كُنْتُمْ         [3/141]      صَادِقِينَ  "" . فَلَمَّا أَسْلَمَ  حَمْزَةُ  عَزَّ بِهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَالْمُسْلِمُونَ ، وَثَبَتَ لَهُمْ بَعْضُ أَمْرِهِمْ وَهَابَتْهُ  قُرَيْشٌ  ، وَعَلِمُوا أَنَّ  حَمْزَةَ  رَضِيَ اللهُ عَنْهُ سَيَمْنَعُهُ  .","","Al-Mu'jam al-Kabir 2926","","يعقوب بن عتبة بن المغيرة الثقفي عن محمد بن إسحاق عن جرير بن حازم عن عبيد بن عقيل الهلالي عن الجوزجاني عن الحسين بن إسحاق التستري عن الطبراني","حمزة بن عبد المطلب بن عبد مناف"
"2925","وَآخَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَ  حَمْزَةَ  وَبَيْنَ  زَيْدِ بْنِ حَارِثَةَ  2927  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  عَنْ  يُونُسَ بْنِ أَبِي إِسْحَاقَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ  أَنَّ  زَيْدَ بْنَ حَارِثَةَ قَالَ : "" يَا رَسُولَ اللهِ ، آخَيْتَ بَيْنِي وَبَيْنَ  حَمْزَةَ  .","","Al-Mu'jam al-Kabir 2927","","زيد بن حارثة الكلبي عن البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن يونس بن بكير عن محمد بن عبد الله بن نمير عن محمد بن عبد الله مطين الحضرمي عن الطبراني","وآخى رسول الله صلى الله عليه وسلم بين حمزة وبين زيد بن حارثة"
"2926","2928  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ الْمَلِكِ بْنِ أَبِي غَنِيَّةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  رَجُلٍ مِنْ  أَصْحَابِ عَلِيٍّ  ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ قَالَ :  آخَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَ  حَمْزَةَ بْنِ عَبْدِ الْمُطَّلِبِ  وَبَيْنَ  زَيْدِ بْنِ حَارِثَةَ  "" .","","Al-Mu'jam al-Kabir 2928","","علي بن أبي طالب عن رجل عن أبو إسحاق السبيعي عن عبد الملك بن حميد الخزاعي عن يحيى بن عبد الملك بن حميد عن عبد الله بن عمر مشكدانة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","وآخى رسول الله صلى الله عليه وسلم بين حمزة وبين زيد بن حارثة"
"2927","وَاسْتُشْهِدَ  حَمْزَةُ  رَضِيَ اللهُ عَنْهُ  يَوْمَ أُحُدٍ  2929  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ ،  ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ :  وَخَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمَ الْجُمُعَةِ حِينَ صَلَّى الْجُمُعَةَ  ، فَأَصْبَحَ  بِالشِّعْبِ مِنْ أُحُدٍ  ، فَالْتَقَوْا  يَوْمَ السَّبْتِ فِي النِّصْفِ مِنْ شَوَّالٍ سَنَةَ ثَلَاثٍ  "" .","","Al-Mu'jam al-Kabir 2929","","محمد بن إسحاق عن محمد بن سلمة الباهلي عن عبد الله بن محمد النفيلي عن أبو شعيب الحراني عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2928","2930  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ :  كَانَتْ  أُحُدٌ  فِي شَوَّالٍ سَنَةَ ثَلَاثٍ  "" .","","Al-Mu'jam al-Kabir 2930","","محمد بن إسحاق عن يونس بن بكير عن محمد بن عبد الله بن نمير عن محمد بن عبد الله مطين الحضرمي عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2929","[3/142]      2931  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ  ،  ثَنَا  ابْنُ نُمَيْرٍ  ،  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ  ""  فِي تَسْمِيَةِ مَنِ اسْتُشْهِدَ مِنَ الْمُسْلِمِينَ  يَوْمَ أُحُدٍ  مِنَ  الْمُهَاجِرِينَ  :  حَمْزَةُ بْنُ عَبْدِ الْمُطَّلِبِ  "" .","","Al-Mu'jam al-Kabir 2931","","","واستشهد حمزة رضي الله عنه يوم أحد"
"2930","2932  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  هَارُونُ بْنُ إِسْحَاقَ الْهَمْدَانِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  أَبِي حَمَّادِ  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  جَابِرٍ ، قَالَ :  لَمَّا جَرَّدَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  حَمْزَةَ  بَكَى  ، فَلَمَّا رَأَى مُثَالَهُ شَهِقَ  "" .","","Al-Mu'jam al-Kabir 2932","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن المفضل بن صدقة الحنفي عن عبد الله بن نمير عن هارون بن إسحاق الهمداني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2931","2933  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مَنْصُورُ بْنُ أَبِي مُزَاحِمٍ ،  ثَنَا  أَبُو سَعِيدٍ الْمُؤَدِّبُ ،  عَنْ  سَالِمٍ الْأَفْطَسِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، قَالَ :  أُصِيبَ  حَمْزَةُ  يَوْمَ أُحُدٍ  "" .","","Al-Mu'jam al-Kabir 2933","","سعيد بن جبير الأسدي عن سالم بن عجلان الأفطس عن محمد بن مسلم بن أبي الوضاح القضاعي عن منصور بن أبي مزاحم عن محمد بن عبد الله مطين الحضرمي عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2932","2934  -  حَدَّثَنَا  الْحَضْرَمِيُّ  ، ثَنَا  ابْنُ نُمَيْرٍ ،  ثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  سَالِمٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  قَالَ  :  أُصِيبَ  حَمْزَةُ  يَوْمَ أُحُدٍ  "" .","","Al-Mu'jam al-Kabir 2934","","سعيد بن جبير الأسدي عن سالم بن عجلان الأفطس عن سفيان الثوري عن وكيع بن الجراح عن محمد بن عبد الله بن نمير عن محمد بن عبد الله مطين الحضرمي عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2933","2935  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مِقْسَمٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ قَالَ :  لَمَّا قُتِلَ  حَمْزَةُ  يَوْمَ أُحُدٍ  أَقْبَلَتْ  صَفِيَّةُ  تَطْلُبُهُ لَا تَدْرِي مَا صَنَعَ ، فَلَقِيَتْ  عَلِيًّا  وَالزُّبَيْرَ  ، فَقَالَ  عَلِيٌّ  لِلزُّبَيْرِ  : اذْكُرْ لِأُمِّكَ . وَقَالَ  الزُّبَيْرُ  لِعَلِيٍّ  : اذْكُرْ أَنْتَ لِعَمَّتِكَ . فَقَالَتَ : مَا فَعَلَ  حَمْزَةُ  ؟ فَأَرَيَاهَا أَنَّهُمَا لَا يَدْرِيَانِ ، فَجَاءَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" إِنِّي أَخَافُ عَلَى عَقْلِهَا "" . فَوَضَعَ يَدَهُ عَلَى صَدْرِهَا ، وَدَعَا لَهَا ،  فَاسْتَرْجَعَتْ  وَبَكَتْ ، ثُمَّ جَاءَ فَقَامَ عَلَيْهِ وَقَدْ مُثِّلَ بِهِ ، فَقَالَ :  لَوْلَا جَزَعُ         [3/143]      النِّسَاءِ لَتَرَكْتُهُ حَتَّى يُحْشَرَ مِنْ حَوَاصِلِ الطَّيْرِ وَبُطُونِ  السِّبَاعِ  . ثُمَّ أَمَرَ بِالْقَتْلَى ، فَجَعَلَ يُصَلِّي عَلَيْهِمْ ، فَيَضَعُ تِسْعَةً  وَحَمْزَةَ  ، فَيُكَبِّرُ عَلَيْهِمْ سَبْعَ تَكْبِيرَاتٍ ، ثُمَّ يُرْفَعُونَ وَيُتْرَكُ  حَمْزَةُ  ، ثُمَّ دَعَا بِتِسْعَةٍ ، فَكَبَّرَ عَلَيْهِمْ سَبْعَ تَكْبِيرَاتٍ ، حَتَّى فَرَغَ مِنْهُمْ  .","","Al-Mu'jam al-Kabir 2935","","عبد الله بن عباس عن مقسم بن بجرة عن يزيد بن أبي زياد القرشي عن أبو بكر بن عياش عن أحمد بن عبد الله اليربوعي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2934","2936  -  حَدَّثَنَا  الْحَضْرَمِيُّ  ، ثَنَا  يَزِيدُ بْنُ مِهْرَانَ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مِقْسَمٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي عَلَى شُهَدَاءِ  أُحُدٍ  تِسْعَةً  وَحَمْزَةُ  عَاشِرُهُمْ ، حَتَّى فَرَغَ مِنْهُمْ  .","","Al-Mu'jam al-Kabir 2936","","عبد الله بن عباس عن مقسم بن بجرة عن يزيد بن أبي زياد القرشي عن أبو بكر بن عياش عن يزيد بن مهران الخباز عن محمد بن عبد الله مطين الحضرمي عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2935","2937  -  ثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  خَالِدُ بْنُ خِدَاشٍ ، (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ، قَالَا :  ثَنَا  صَالِحٌ الْمُرِّيُّ ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ،  عَنْ  أَبِي عُثْمَانَ النَّهْدِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ أُحُدٍ  نَظَرَ إِلَى  حَمْزَةَ  وَقَدْ قُتِلَ وَمُثِّلَ بِهِ ، فَرَأَى مَنْظَرًا لَمْ يَرَ مَنْظَرًا قَطُّ أَوْجَعَ لِقَلْبِهِ مِنْهُ وَلَا أَوْجَلَ ، فَقَالَ :  رَحْمَةُ اللهِ عَلَيْكَ ، فَقَدْ كُنْتَ وَصُولًا لِلرَّحِمِ ، فَعُولًا لِلْخَيْرَاتِ  ، وَلَوْلَا حُزْنُ مَنْ بَعْدَكَ عَلَيْكَ لَسَرَّنِي أَنْ أَدَعَكَ حَتَّى تَجِيءَ مِنْ أَفْوَاجٍ شَتَّى "" . ثُمَّ حَلَفَ وَهُوَ وَاقِفٌ مَكَانَهُ : "" وَاللهِ لَأُمَثِّلَنَّ بِسَبْعِينَ مِنْهُمْ مَكَانَكَ "" . فَنَزَلَ الْقُرْآنُ وَهُوَ وَاقِفٌ فِي مَكَانِهِ لَمْ يَبْرَحْ بَعْدُ :         {      وَإِنْ عَاقَبْتُمْ فَعَاقِبُوا بِمِثْلِ مَا عُوقِبْتُمْ بِهِ وَلَئِنْ صَبَرْتُمْ لَهُوَ خَيْرٌ لِلصَّابِرِينَ         }      حَتَّى تُخْتَمَ السُّورَةُ ، فَكَفَّرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَمْسَكَ عَمَّا أَرَادَ  .","","Al-Mu'jam al-Kabir 2937","","أبو هريرة الدوسي عن أبو عثمان النهدي عن سليمان بن طرخان عن صالح بن بشير المري عن سعيد بن سليمان سعدويه عن محمد بن الفضل بن جابر السقطى عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2936","2938  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  سَعِيدُ بْنُ أَحْمَدَ الْجَرْمِيُّ  ،         [3/144]      ثَنَا  أَبُو تُمَيْلَةَ ،  ثَنَا  عِيسَى بْنُ عُبَيْدٍ الْكِنْدِيُّ ،  عَنِ  الرَّبِيعِ بْنِ أَنَسٍ ،  حَدَّثَنِي  أَبُو الْعَالِيَةِ ،  عَنْ  أُبَيِّ بْنِ كَعْبٍ رَحِمَهُ اللهُ قَالَ :  أُصِيبَ  يَوْمَ أُحُدٍ  مِنَ  الْأَنْصَارِ  أَرْبَعَةٌ وَسِتُّونَ ، وَأُصِيبَ مِنَ  الْمُهَاجِرِينَ  سِتَّةٌ فِيهِمْ  حَمْزَةُ  رَضِيَ اللهُ عَنْهُ ، فَمَثَّلُوا بِقَتْلَاهُمْ ، فَقَالَتِ  الْأَنْصَارُ  : لَئِنْ أَصَبْنَا مِنْهُمْ يَوْمًا مِنَ الدَّهْرِ  لَنُرْبِيَنَّ  عَلَيْهِمْ . فَلَمَّا كَانَ  يَوْمُ فَتْحُ مَكَّةَ  نَادَى  رَجُلٌ  لَا يُعْرَفُ يَقُولُ : لَا  قُرَيْشَ  بَعْدَ الْيَوْمِ ، وَأَنْزَلَ اللهُ عَزَّ وَجَلَّ عَلَى نَبِيِّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         {      وَإِنْ عَاقَبْتُمْ فَعَاقِبُوا بِمِثْلِ مَا عُوقِبْتُمْ بِهِ وَلَئِنْ صَبَرْتُمْ لَهُوَ خَيْرٌ لِلصَّابِرِينَ         }      ، فَقَالَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُفُّوا عَنِ  الْقَوْمِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( سعيد بن محمد الجرمي )","","Al-Mu'jam al-Kabir 2938","","أبي بن كعب عن رفيع بن مهران عن الربيع بن أنس البكري عن عيسى بن عبيد الكندي عن يحيى بن واضح الأنصاري عن سعيد بن محمد الجرمي عن عبد الله بن أحمد بن حنبل عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2937","2939  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  ثَنَا  أُسَامَةُ بْنُ زَيْدٍ ،  حَدَّثَنِي  الزُّهْرِيُّ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ عَلَى  حَمْزَةَ  بَعْدَ  أُحُدٍ  وَقَدْ مُثِّلَ بِهِ ، فَقَالَ :  لَوْلَا أَنْ تَجِدَ  صَفِيَّةُ  فِي نَفْسِهَا لَتَرَكْتُهُ حَتَّى تَأْكُلَهُ الْعَافِيَةُ  حَتَّى يُحْشَرَ مِنْ بُطُونِهَا "" . ثُمَّ دَعَا  بِنَمِرَةٍ  ، فَكَانَتْ إِذَا مُدَّتْ عَلَى رَأْسِهِ بَدَتْ رِجْلَاهُ ، وَإِذَا مُدَّتْ عَلَى رِجْلَيْهِ بَدَا رَأْسُهُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مُدُّوهَا عَلَى رَأْسِهِ "" . وَقَلَّتِ الثِّيَابُ وَكَثُرَتِ الْقَتْلَى ، وَكَانَ الرَّجُلُ وَالرَّجُلَانِ وَالثَّلَاثَةُ يُكَفَّنُونَ فِي الثَّوْبِ الْوَاحِدِ ، وَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَسْأَلُ أَيُّهُمْ أَكْثَرُ قُرْآنًا فَيُقَدِّمُهُ إِلَى الْقِبْلَةِ ، فَدُفِنُوا وَلَمْ يُصَلِّ عَلَيْهِمْ  .","","Al-Mu'jam al-Kabir 2939","","أنس بن مالك عن الزهري عن أسامة بن زيد الليثي المدني عن زيد بن الحباب العكلي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2938","2940  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ صَالِحٍ التَّمَّارُ ،  عَنْ  يَزِيدَ بْنِ زَيْدٍ ،  عَنْ  أَبِي أَسِيدٍ السَّاعِدِيِّ ، قَالَ :  أَنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى قَبْرِ  حَمْزَةَ بْنِ عَبْدِ الْمُطَّلِبِ  ، فَجَعَلُوا يَجُرُّونَ  النَّمِرَةَ  عَلَى وَجْهِهِ ، فَيَنْكَشِفُ قَدَمَاهُ ، وَيَجُرُّونَهَا عَلَى قَدَمَيْهِ فَيَنْكَشِفُ وَجْهُهُ ، فَقَالَ رَسُولُ اللهِ         [3/145]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اجْعَلُوهَا عَلَى وَجْهِهِ ، وَاجْعَلُوا عَلَى قَدَمَيْهِ مِنْ هَذَا الشَّجَرِ  . قَالَ : فَرَفَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَأْسَهُ ، فَإِذَا أَصْحَابُهُ يَبْكُونَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِنَّهُ يَأْتِي عَلَى النَّاسِ زَمَانٌ يَخْرُجُونَ إِلَى  الْأَرْيَافِ  ،  وَالْمَدِينَةُ  خَيْرٌ لَهُمْ لَوْ كَانُوا يَعْلَمُونَ ، لَا يَصْبِرُ عَلَى  لَأْوَائِهَا  وَشِدَّتِهَا أَحَدٌ إِلَّا كُنْتُ لَهُ شَفِيعًا أَوْ شَهِيدًا يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 2940","","مالك بن ربيعة أبو أسيد الساعدي عن يزيد بن زيد المدني عن محمد بن صالح بن دينار التمار عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2939","2941  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  أَبِيهِ  ، (  ح  ) .  وَحَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  حَارِثَةَ بْنِ مُضَرِّبٍ ،  عَنْ  خَبَّابٍ ، قَالَ :  لَقَدْ رَأَيْتُ  حَمْزَةَ  وَمَا وَجَدْنَا لَهُ ثَوْبًا نُكَفِّنُهُ فِيهِ غَيْرَ بُرْدَةٍ  ، إِذَا غَطَّيْنَا بِهَا رِجْلَيْهِ خَرَجَ رَأْسُهُ ، وَإِذَا غَطَّيْنَا بِهَا رَأْسَهُ خَرَجَتْ رِجْلَاهُ ، فَغَطَّيْنَا رَأْسَهُ ، وَوَضَعْنَا عَلَى رِجْلَيْهِ مِنَ  الْإِذْخِرِ  "" .","","Al-Mu'jam al-Kabir 2941","","خباب بن الأرت التميمي عن حارثة بن مضرب العبدي عن أبو إسحاق السبيعي عن زكريا بن أبي زائدة الوادعي عن عبد الرحيم بن سليمان الأشل عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2940","2942  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  سَعْدُ بْنُ الصَّلْتِ ،  عَنْ  حَجَّاجٍ ،  عَنِ  الْحَكَمِ ،  عَنْ  مِقْسَمٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا  أَنَّ  حَمْزَةَ  كَانَتْ عَلَيْهِ  نَمِرَةٌ  ، فَإِذَا غُطِّيَ بِهَا رَأْسُهُ بَدَتْ رِجْلَاهُ  ، وَإِذَا غُطِّيَتْ رِجْلَاهُ خَرَجَ رَأْسُهُ ، فَأَمَرَ بِهِ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَغُطِّي رَأْسُهُ ، وَجُعِلَ عَلَى رِجْلَيْهِ شَجَرَةٌ وَحِجَارَةٌ  .","","Al-Mu'jam al-Kabir 2942","","عبد الله بن عباس عن مقسم بن بجرة عن الحكم بن عتيبة الكندي عن حجاج بن أرطاة عن سعد بن الصلت بن برد البجلي عن عثمان ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2941","2943  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  زَائِدَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  جَابِرٍ ، قَالَ : ""  كَفَّنَ رَسُولُ اللهِ         [3/146]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  حَمْزَةَ  فِي ثَوْبٍ وَاحِدٍ  . قَالَ جَابِرٌ : ""  ذَلِكَ الثَّوْبُ  نَمِرَةٌ  .","","Al-Mu'jam al-Kabir 2943","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن زائدة بن قدامة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2942","2944  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُوسَى بْنُ عَبْدِ الرَّحْمَنِ الْمَسْرُوقِيُّ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا قَالَ :  رَجَعَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ  أُحُدٍ  ، فَسَمِعَ نِسَاءَ  بَنِي عَبْدِ الْأَشْهَلِ  يَبْكِينَ عَلَى هَلْكَاهُنَّ ، فَقَالَ : "" لَكِنَّ  حَمْزَةَ  لَا بَوَاكِيَ لَهُ "" . فَجِئْنَ نِسَاءُ  الْأَنْصَارِ  يَبْكِينَ عَلَى  حَمْزَةَ  عِنْدَهُ ، فَاسْتَيْقَظَ وَهُنَّ يَبْكِينَ ، فَقَالَ :  يَا وَيْحَهُنَّ ، إِنَّهُنَّ هَاهُنَا حَتَّى الْآنَ ، مُرْهُنَّ فَلْيَرْجِعْنَ وَلَا يَبْكِينَ عَلَى هَالِكٍ بَعْدَ الْيَوْمِ  .","","Al-Mu'jam al-Kabir 2944","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أسامة بن زيد الليثي المدني عن حماد بن أسامة القرشي عن موسى بن عبد الرحمن بن سعيد المسروقي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2943","2945  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَبْدِ الْمَجِيدِ ،  ثَنَا  زَمْعَةُ بْنُ صَالِحٍ ،  عَنْ  سَلَمَةَ بْنِ وَهْرَامَ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  دَخَلْتُ الْبَارِحَةَ الْجَنَّةَ ، فَنَظَرْتُ فِيهَا فَإِذَا  حَمْزَةُ  مُتَّكِئٌ عَلَى سَرِيرٍ  .","","Al-Mu'jam al-Kabir 2945","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سلمة بن وهرام اليماني عن زمعة بن صالح الجندي عن عبيد الله بن عبد المجيد الحنفي عن الحسن بن علي الريحاني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2944","2946  -  حَدَّثَنَا  الْحَضْرَمِيُّ  ، ثَنَا  مَنْصُورُ بْنُ مُزَاحِمٍ ،  ثَنَا  أَبُو سَعِيدٍ مَوْلَى بَنِي هَاشِمٍ ،  عَنْ  سَالِمٍ الْأَفْطَسِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، قَالَ :  لَمَّا أُصِيبَ  حَمْزَةُ  وَأَصْحَابُهُ  يَوْمَ أُحُدٍ  ، قَالُوا : لَيْتَ أَنَّ مَنْ خَلْفَنَا عَلِمُوا مَا أَعْطَانَا اللهُ مِنَ الثَّوَابِ لِيَكُونَ أَجْرًا لَهُمْ ، فَقَالَ اللهُ عَزَّ وَجَلَّ : أَنَا أُعْلِمُهُمْ "" ، فَأَنْزَلَ اللهُ تَبَارَكَ وَتَعَالَى :         {      وَلا تَحْسَبَنَّ الَّذِينَ قُتِلُوا فِي سَبِيلِ اللهِ أَمْوَاتًا         }      الْآيَةَ  .","","Al-Mu'jam al-Kabir 2946","","سعيد بن جبير الأسدي عن سالم بن عجلان الأفطس عن عبد الرحمن بن عبد الله بن عبيد جردقة عن منصور بن أبي مزاحم عن محمد بن عبد الله مطين الحضرمي عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2945","2947  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ         [3/147]      نُمَيْرٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  عَبْدِ اللهِ بْنِ الْفَضْلِ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  حَفْصِ بْنِ عَمْرِو بْنِ أُمَيَّةَ الضَّمْرِيِّ  ، قَالَ :  خَرَجْتُ أَنَا  وَعُبَيْدُ اللهِ بْنُ عَدِيِّ بْنِ الْخِيَارِ  ،  فَأَدْرَبْنَا  -  يَعْنِي دَرْبَ  الرُّومِ  - ثُمَّ مَرَرْنَا  بِحِمْصَ  وَبِهَا وَحْشِيٌّ ، فَقُلْتُ : لَوْ أَتَيْنَاهُ فَسَأَلْنَاهُ عَنْ قَتْلِهِ  حَمْزَةَ  رَحِمَهُ اللهُ كَيْفَ قَتَلَهُ ؟ فَأَقْبَلْنَا نَحْوَهُ ، فَلَقِيَنَا  رَجُلٌ  وَنَحْنُ نَسْأَلُ عَنْهُ ، فَقَالَ : إِنَّهُ رَجُلٌ قَدْ غَلَبَتْ عَلَيْهِ هَذَا الْخَمْرُ ، فَإِنْ تَجِدَاهُ صَاحِيًا تَجِدَاهُ رَجُلًا عَرَبِيًّا ، يُحَدِّثُكُمَا مَا شِئْتُمَا مِنْ حَدِيثٍ ، وَإِنْ تَجِدَاهُ عَلَى غَيْرِ ذَلِكَ فَانْصَرِفَا عَنْهُ . فَأَتَيْنَاهُ فَوَجَدْنَاهُ بِفِنَائِهِ ، فَنَظَرَ إِلَى  عُبَيْدِ اللهِ بْنِ عَدِيٍّ  ، فَقَالَ :  ابْنُ عَدِيِّ بْنِ الْخِيَارِ  ؟ قَالَ : نَعَمْ . قَالَ : مَا رَأَيْتُكَ مُنْذُ نَاوَلَتْنِيكَ أُمُّكَ السَّعْدِيَّةُ بِعُرْضَتِكَ ، وَمَا هُوَ إِلَّا أَنْ لَمَعَتْ لِي قَدَمَاكَ فَعَرَفْتُكَ . قَالَ : قُلْتُ لَهُ : إِنَّا جِئْنَاكَ لِتُخْبِرَنَا عَنْ قَتَلِكَ  حَمْزَةَ  كَيْفَ قَتَلْتَهُ ؟ قَالَ : كُنْتُ عَبْدًا  لِجُبَيْرِ بْنِ مُطْعِمٍ  ، وَكَانَ عَمُّهُ  طُعَيْمَةُ بْنُ عَدِيٍّ  قُتِلَ  يَوْمَ بَدْرٍ  ، فَقَالَ : إِنْ قَتَلْتَ عَمَّ  مُحَمَّدٍ  بِعَمِّي فَأَنْتَ حُرٌّ . فَخَرَجْتُ  يَوْمَ أُحُدٍ  فِي النَّاسِ مَعَ حَرْبَتِي ، وَإِنَّمَا هَمِّي أَنْ أُعْتَقَ ، فَجَعَلْتُ  حَمْزَةَ  مِنْ شَأْنِي ، فَعَمَدْتُ لَهُ ، وَتَقَدَّمَنِي إِلَيْهِ  سِبَاعٌ بْنُ عَبْدِ الْعُزَّى  . قَالَ : وَصَدَرْتُ عَنْهُ وَهُوُ يَهُذُّ النَّاسَ بِسَيْفِهِ هَذًّا ، كَأَنَّهُ جَمَلٌ  أَوْرَقُ ،  فَلَمَّا تَقَدَّمَنِي إِلَيْهِ  سِبَاعٌ  ، قَالَ  حَمْزَةُ  : هَلُمَّ يَا ابْنَ مُقَطِّعَةِ  الْبُظُورِ  . قَالَ : فَدَنَا إِلَيْهِ فَضَرَبَهُ ، فَكَأَنَّمَا أَخْطَأَهُ ، وَاسْتَتَرْتُ بِشَيْءٍ ، هَزَزْتُ حَرْبَتِي حَتَّى إِذَا رَضِيتُ مِنْهَا دَفَعْتُهَا ، فَوَقَعَتْ فِي  ثُنَّتِهِ  . قَالَ : وَذَهَبَ لِيَنُوءَ فَغُلِبَ ، وَاعْتَزَلْتُ وَرَجَعْتُ فِي النَّاسِ إِلَى  مَكَّةَ  ، وَعَتَقْتُ ، فَلَمَّا فَتَحَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مَكَّةَ  خَرَجْتُ إِلَى  الطَّائِفِ  ، فَأَقَمْتُ بِهَا ، فَلَمَّا أَجْمَعَ  أَهْلُ الطَّائِفِ  عَلَى مُصَالَحَةِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَعَيَّتْ عَلَيَّ الْمَذَاهِبُ ، فَجَعَلْتُ أَتَذَكَّرُ أَيْنَ أَذْهَبُ ؟ فَبَيْنَا أَنَا فِي هَمِّي إِذْ عَرَضَ لِي  رَجُلٌ  ، فَقَالَ : مَالِي أَرَاكَ هَكَذَا ؟ قُلْتُ : هَذَا الرَّجُلُ قَدْ بَلَغْتُ مِنْ عَمِّهِ ، وَقَدْ أَرَى هَؤُلَاءِ  الْقَوْمَ  قَدْ أَجْمَعُوا عَلَى مُصَالَحَتِهِ ، فَمَا أَدْرِي أَيْنَ أَذْهَبُ ؟ قَالَ : فَوَاللهِ مَا يَقْتُلُ أَحَدًا         [3/148]      أَتَاهُ وَشَهِدَ شَهَادَتَهُ . فَخَرَجْتُ كَمَا أَنَا ، فَوَاللهِ مَا شَعَرْتُ حَتَّى قُمْتُ عَلَى رَأْسِهِ  بِالْمَدِينَةِ  ، فَرَفَعَ رَأْسَهُ ، فَنَظَرَ إِلَيَّ ، فَقَالَ : ""  وَحْشِيٌّ  ؟ "" قُلْتُ :  وَحْشِيٌّ  ، وَشَهِدْتُ بِشَهَادَتِهِ ، فَقَالَ :  وَيْحَكَ ، أَخْبِرْنِي عَنْ قَتَلِكَ  حَمْزَةَ  ، كَيْفَ قَتَلْتَهُ ؟  فَأَخْبَرْتُهُ وَاللهِ كَمَا أَخْبَرْتُكُمَا ، فَقَالَ : "" وَيْحَكَ ، غَيِّبْ عَنِّي وَجْهَكَ "" . فَكُنْتُ أَتَجَنَّبُهُ حَتَّى قَبَضَهُ اللهُ تَعَالَى ، فَلَمَّا بَعَثَ  أَبُو بَكْرٍ  رَضِيَ اللهُ عَنْهُ الْجَيْشَ إِلَى  الْيَمَامَةِ  خَرَجْتُ مَعَ النَّاسِ ، فَجَعَلْتُ  مُسَيْلِمَةَ  مِنْ شَأْنِي ، فَحَمَلْتُ عَلَيْهِ أَنَا  وَرَجُلٌ مِنَ الْأَنْصَارِ  وَمَعِي حَرْبَتِي الَّتِي قَتَلْتُ بِهَا  حَمْزَةَ  . قَالَ : فَقَذَفْتُهُ بِالْحَرْبَةِ ، وَحَمَلَ عَلَيْهِ الْأَنْصَارِيُّ ، فَرَبُّكَ أَعْلَمُ : أَيُّنَا قَتَلَهُ ، فَإِنْ أَكُ قَتَلْتُهُ فَقَدْ قَتَلْتُ خَيْرَ النَّاسِ وَشَرَّ النَّاسِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( جعفر )","","Al-Mu'jam al-Kabir 2947","","وحشي بن حرب الحبشي عن جعفر بن عمرو بن أمية الضمري عن سليمان بن يسار مولى ميمونة زوج رسول الله عن عبد الله بن الفضل بن العباس الهاشمي عن محمد بن إسحاق عن عبد الله بن إدريس الأودي عن محمد بن عبد الله بن نمير عن محمد بن عبد الله مطين الحضرمي عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2946","2948  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ ، قَالَ :  وَقُتِلَ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ أُحُدٍ  مِنَ الْمُسْلِمِينَ  ، ثُمَّ مِنْ  بَنِي هَاشِمٍ  حَمْزَةُ بْنُ عَبْدِ الْمُطَّلِبِ ، قَتَلَهُ  وَحْشِيٌّ مَوْلَى عُتْبَةَ بْنِ غَزْوَانَ  "" .","","Al-Mu'jam al-Kabir 2948","","أسد الله حمزة بن عبد المطلب عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2947","2949  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  أَحْمَدُ بْنُ خَالِدٍ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي سَلَمَةَ الْمَاجِشُونُ ،  عَنْ  عَبْدِ اللهِ بْنِ الْفَضْلِ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  جَعْفَرِ بْنِ عَمْرِو بْنِ أُمَيَّةَ الضَّمْرِيِّ ، قَالَ :  خَرَجْتُ أَنَا  وَعُبَيْدُ اللهِ بْنُ عَدِيِّ بْنِ الْخِيَارِ  فَأَدْرَبْنَا  ، ثُمَّ مَرَرْنَا  بِحِمْصَ  وَبِهَا وَحْشِيٌّ  .  فَذَكَرَ مِثْلَ حَدِيثِ  ابْنِ إِسْحَاقَ  .","","Al-Mu'jam al-Kabir 2949","","وحشي بن حرب الحبشي عن جعفر بن عمرو بن أمية الضمري عن سليمان بن يسار مولى ميمونة زوج رسول الله عن عبد الله بن الفضل بن العباس الهاشمي عن عبد العزيز بن عبد الله الماجشون عن أحمد بن خالد بن موسى الوهبي عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2948","2950  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ الدِّمَشْقِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ شُعَيْبِ بْنِ شَابُورَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ يَزِيدَ بْنِ جَابِرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْفَضْلِ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  جَعْفَرِ بْنِ عَمْرٍو قَالَ :  خَرَجْتُ أَنَا  وَعُبَيْدُ اللهِ بْنُ عَدِيِّ بْنِ الْخِيَارِ  زَمَنَ  مُعَاوِيَةَ  فَأَدْرَبْنَا  ، فَلَمَّا قَفَلْنَا مَرَرْنَا  بِحِمْصَ  ، وَكَانَ بِهَا وَحْشِيُّ بْنُ حَرْبٍ  .  فَذَكَرَ نَحْوَ حَدِيثِ  ابْنِ إِسْحَاقَ  .","","Al-Mu'jam al-Kabir 2950","","وحشي بن حرب الحبشي عن جعفر بن عمرو بن أمية الضمري عن سليمان بن يسار مولى ميمونة زوج رسول الله عن عبد الله بن الفضل بن العباس الهاشمي عن عبد الرحمن بن يزيد الداراني عن محمد بن شعيب بن شابور القرشي عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2949","[3/149]      2951  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ رَضِيَ اللهُ عَنْهُ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَأَى فِيمَا يَرَى النَّائِمُ ، قَالَ :  رَأَيْتُ كَأَنِّي مُرْدِفٌ كَبْشًا ، وَكَأَنَّ ظُبَةَ سَيْفِي انْكَسَرَتْ  ، فَأَوَّلْتُ أَنِّي أَقْتُلُ كَبْشَ  الْقَوْمِ  ، وَأَوَّلْتُ ظُبَةَ سَيْفِي قَتْلَ رَجُلٍ مِنْ  عِتْرَتِي  "" . "" فَقُتِلَ  حَمْزَةُ  ، وَقَتَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  طَلْحَةَ  ، وَكَانَ صَاحِبَ اللِّوَاءِ  .","","Al-Mu'jam al-Kabir 2951","","أنس بن مالك عن علي بن زيد بن جدعان عن حماد بن سلمة عن عبد الواحد بن غياث عن الساجي عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2950","2952  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ الْعَطَّارُ  ، ثَنَا  إِبْرَاهِيمُ بْنُ مُنْذِرٍ الْحِزَامِيُّ ،  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنْ  يَحْيَى بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَبِيبَةَ ،  عَنْ  جَدِّهِ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  وَالَّذِي نَفْسِي بِيَدِهِ إِنَّهُ لَمَكْتُوبٌ عِنْدَ اللهِ فِي السَّمَاءِ السَّابِعَةِ  :  حَمْزَةُ بْنُ عَبْدِ الْمُطَّلِبِ  أَسَدُ اللهِ وَأَسَدُ رَسُولِهِ  .","","Al-Mu'jam al-Kabir 2952","","أبو لبيبة الأشهلى عن يحيى بن محمد ابن أبي لبيبة المدني عن حاتم بن إسماعيل الحارثي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2951","2953  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنِ  ابْنِ عَوْنٍ ،  عَنْ  عُمَيْرِ بْنِ إِسْحَاقَ ، قَالَ :  كَانَ  حَمْزَةُ بْنُ عَبْدِ الْمُطَّلِبِ  يُقَاتِلُ بَيْنَ يَدَيْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِسَيْفَيْنِ  ، وَيَقُولُ : "" أَنَا أَسَدُ اللهِ وَأَسَدُ رَسُولِهِ  .","","Al-Mu'jam al-Kabir 2953","","عمير بن إسحاق الهاشمي عن عبد الله بن عون بن أرطبان عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2952","2954  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ  ، حَدَّثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  أَبِي هَاشِمٍ الرُّمَّانِيِّ ،  عَنْ  أَبِي مِجْلَزٍ ،  عَنْ  قَيْسِ بْنِ عَبَّادٍ ، قَالَ :  سَمِعْتُ  أَبَا ذَرٍّ يَقُولُ :  أُقْسِمُ بِاللهِ أُنْزِلَتْ هَذِهِ الْآيَةُ :         {      هَذَانِ خَصْمَانِ اخْتَصَمُوا فِي رَبِّهِمْ         }      فِي هَؤُلَاءِ السِّتَّةِ  :  حَمْزَةَ  وَعُبَيْدَةَ  وَعَلِيِّ بْنِ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُمْ ،  وَعُتْبَةَ  وَشَيْبَةَ ابْنَيْ رَبِيعَةَ  وَالْوَلِيدِ بْنِ عُتْبَةَ  ، وَكَانُوا تَبَارَزُوا  يَوْمَ بَدْرٍ  "" .","","Al-Mu'jam al-Kabir 2954","","أبو ذر الغفاري عن قيس بن عباد الضبعي عن لاحق بن حميد عن يحيى بن دينار الرماني عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن محمد بن محمد بن حيان التمار عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2953","2955  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  حَمَّادٌ بْنِ زَيْدِ بْنِ الْحَرِيشِ  ،  ثَنَا  حُسَيْنٌ الْأَشْقَرُ ،  عَنْ  قَيْسٍ ،  عَنِ  السُّدِّيِّ ،  عَنْ  عَبْدِ خَيْرٍ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَالِبٍ         [3/150]      رَضِيَ اللهُ عَنْهُ قَالَ :  أُعِنْتُ أَنَا  وَحَمْزَةُ  وَعُبَيْدَةُ بْنُ الْحَارِثِ  يَوْمَ بَدْرٍ  عَلَى  الْوَلِيدِ بْنِ عُتْبَةَ  -  أَظُنُّهُ قَالَ : فَلَمْ يَغِبْ ذَلِكَ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  كذا في طبعة مكتبة ابن تيمية والنسخ الخطية ، ولعل الصواب ( زيد بن الحريش ) وأن ( حماد بن ) مقحمة والله أعلم","","Al-Mu'jam al-Kabir 2955","","علي بن أبي طالب عن عبد خير بن يزيد الخيواني عن السدي الكبير عن قيس بن الربيع الأسدي عن الحسين بن الحسن الأشقر عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2954","2956  -  حَدَّثَنَا  مَحْمُودٌ الْوَاسِطِيُّ  ، ثَنَا  الْقَاسِمُ بْنُ عِيسَى الطَّائِيُّ ،  حَدَّثَنَا  رَحْمَةُ بْنُ مُصْعَبٍ الْبَاهِلِيُّ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  قَالَ  :  قَدِمَ عَلَى مُعَاوِيَةَ رَجُلٌ يُقَالُ لَهُ هَوْذَةُ ، فَقَالَ لَهُ  مُعَاوِيَةُ  : "" يَا  هَوْذَةُ  ، هَلْ شَهِدْتَ  بَدْرًا  ؟  قَالَ : نَعَمْ يَا أَمِيرَ الْمُؤْمِنِينَ ، عَلَيَّ لَا لِي . قَالَ : "" فَكَمْ أَتَى عَلَيْكَ ؟ "" قَالَ : أَنَا يَوْمَئِذٍ قُمُدٌّ قُمْدُودٌ مِثْلُ الصَّفَاةِ الْجُلْمُودِ ، كَأَنِّي أَنْظُرُ إِلَيْهِمْ وَقَدْ صَفُّوا لَنَا صَفًّا طَوِيلًا ، وَكَأَنِّي أَنْظُرُ إِلَى بَرِيقِ سُيُوفِهِمْ كَشُعَاعِ الشَّمْسِ مِنْ خَلَلِ السَّحَابِ ، فَمَا اسْتَفَقْتُ حَتَّى غَشِيَتْنَا عَادِيَةُ  الْقَوْمِ  ، فِي أَوَائِلِهِمْ  عَلِيُّ بْنُ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُ لَيْثًا  عِفْرِيًّا  يَفْرِي  الْفَرِيَّا ، وَهُوَ يَقُولُ : لَنْ تَأْكُلُوا التَّمْرَ بِبَطْنِ  مَكَّةَ  ، لَنْ تَأْكُلُوا التَّمْرَ بِبَطْنِ  مَكَّةَ  ، يَتْبَعُهُ  حَمْزَةُ بْنُ عَبْدِ الْمُطَّلِبِ  ، فِي صَدْرِهِ رِيشَةٌ بَيْضَاءُ قَدْ أُعْلِمَ بِهَا كَأَنَّهُ جَمَلٌ يَحْطِمُ يَبِيسًا ، فَرُعْتُ مِنْهُمَا ، وَأَحَالَا عَلَى  حَنْظَلَةَ  - يَعْنِي أَخَا  مُعَاوِيَةَ  . فَقَالَ  مُعَاوِيَةُ  رَضِيَ اللهُ عَنْهُ : "" عَنْكَ وَلَا كُفْرَانَ لِلهِ زِلْتَ فَلَيْتَ شِعْرِي مَتَى أَرَحْتَ يَا  هَوْذَةُ  ؟ "" قَالَ : وَاللهِ يَا أَمِيرَ الْمُؤْمِنِينَ مَا أَرَحْتُ حَتَّى نَظَرْتُ إِلَى  الْهَضَبَاتِ  مِنْ أَرْثَدَ . فَقُلْتُ : لَيْتَ شِعْرِي مَا فَعَلَ  حَنْظَلَةُ  . فَقَالَ  مُعَاوِيَةُ  : "" أَنْتَ بِذِكْرِكَ  حَنْظَلَةَ  كَذِكْرِ الْغَنِيِّ أَخَاهُ الْفَقِيرَ ، فَإِنَّهُ لَا يَكَادُ يَذْكُرُ إِلَّا وَسْنَانًا أَوْ مُتَوَاسِنًا  "" .","","Al-Mu'jam al-Kabir 2956","","هوذة بن خالد الكناني عن معاوية بن أبي سفيان عن الشعبي عن مجالد بن سعيد عن رحمة بن مصعب الواسطي عن القاسم بن عيسى بن إبراهيم الطائي عن محمود بن محمد بن منويه المفيد عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2955","2957  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ بْنِ عَنْبَرٍ الْبَصْرِيُّ  ، حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ طَلْحَةَ التَّيْمِيُّ ،  حَدَّثَنِي  مُوسَى بْنُ الْحَارِثِ التَّيْمِيُّ ،  عَنْ  أَبِيهِ ،  قَالَ :  كَانَ حَمْزَةُ بْنُ عَبْدِ الْمُطَّلِبِ  يَوْمَ بَدْرٍ  مُعَلَّمًا بِرِيشَةِ نَعَامَةٍ  ، فَقَالَ  رَجُلٌ مِنَ الْمُشْرِكِينَ  : مَنْ رَجُلٌ أُعْلِمَ بِرِيشَةِ نَعَامَةٍ ؟ فَقِيلَ :  حَمْزَةُ بْنُ عَبْدِ الْمُطَّلِبِ  . فَقَالَ : ذَاكَ الَّذِي فَعَلَ بِنَا الْفِعَلَ  "" .","","Al-Mu'jam al-Kabir 2957","","أسد الله حمزة بن عبد المطلب عن محمد بن إبراهيم بن الحارث التيمي عن موسى بن محمد بن إبراهيم التيمي عن محمد بن طلحة بن عبد الرحمن عن إبراهيم بن المنذر الحزامي عن أحمد بن ابراهيم بن عنبر البصري عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2956","[3/151]      2958  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  أَبُو أُسَامَةَ الْكَلْبِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عِمْرَانَ بْنِ أَبِي لَيْلَى ،  ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ بْنِ الْأَصْبَهَانِيِّ ،  عَنْ  أَبِي إِسْحَاقَ الشَّيْبَانِيِّ ،  عَنْ  عَلِيِّ بْنِ الْحَزَوَّرِ ،  ثَنَا  الْأَصْبَغُ بْنُ نُبَاتَةَ ، قَالَ :  سَمِعْتُ  عَلِيَّ بْنَ أَبِي طَالِبٍ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  سَيِّدُ الشُّهَدَاءِ  حَمْزَةُ بْنُ عَبْدِ الْمُطَّلِبِ  .","","Al-Mu'jam al-Kabir 2958","","علي بن أبي طالب عن أصبغ بن نباتة الكوفي عن علي بن الحزور الغنوي عن سليمان بن فيروز الشيباني عن محمد بن سليمان بن عبد الله الأصبهاني عن محمد بن عمران بن محمد بن عبد الرحمن بن أبي ليلى عن عبد الله بن أسامة الكلبى عن علي بن سعيد بن بشير عليك عن الطبراني","واستشهد حمزة رضي الله عنه يوم أحد"
"2957","مَا  أَسْنَدَ  حَمْزَةُ بْنُ عَبْدِ الْمُطَّلِبِ  رَضِيَ اللهُ عَنْهُ  2959  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  أَبُو بَكْرِ بْنُ خَلَّادٍ الْبَاهِلِيُّ وَعُمَرُ بْنُ شَبَّةَ ، قَالَا :  ثَنَا  سُلْمَى بْنُ عِيَاضِ بْنِ مُنْقِذِ بْنِ سُلْمَى بْنِ مَالِكٍ ،  حَدَّثَنِي  جَدِّي مُنْقِذُ بْنُ سُلْمَى ،  عَنْ حَدِيثِ  جَدِّهِ مَالِكٍ ،  عَنْ حَدِيثِ  جَدِّهِ أَبِي مَرْثَدٍ ،  عَنْ حَدِيثِ  حَلِيفِهِ حَمْزَةَ بْنِ عَبْدِ الْمُطَّلِبِ - وَكَانَ حَلِيفَهُ مَا أَبَّسَ عَبْدٌ  بِلَقُوحٍ  ، وَمَا نَادَى غُلَامٌ أَبَاهُ ، وَمَا أَقَامَ أَحَدٌ مَكَانَهُ - حَدَّثَهُ حَدِيثًا  مُسْنَدًا  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْزَمُوا هَذَا الدُّعَاءَ : اللَّهُمَّ إِنِّي أَسْأَلُكَ بِاسْمِكَ الْأَعْظَمِ ،  وَرِضْوَانِكَ الْأَكْبَرِ  . ""  يَقُولُهَا  سُلْمَى  مِرَارًا ، فَإِنَّهُ اسْمٌ مِنْ أَسْمَاءِ اللهِ تَعَالَى ، وَلَمْ أَزَلْ أَسْمَعُ أَنَّ جَدَّ  بَنِي عَامِرٍ  صَخْرَةٌ يَرْفَعُهَا الْمَاءُ لَا تَرْسُبُ . قَالَ : وَهُوَ  مَالِكُ ابْنُ فَاطِمَةَ بِنْتِ أَبِي مَرْثَدٍ كَنَّازِ بْنِ حُصَيْنِ بْنِ نَفَرِ بْنِ يَرْبُوعٍ  "" .","","Al-Mu'jam al-Kabir 2959","","أسد الله حمزة بن عبد المطلب عن كناز بن الحصين الغنوي عن مالك عن منقذ بن سلمى عن سلمى بن عياض بن سلمى بن منقذ عن عمر بن شبة عن علي بن سعيد بن بشير عليك عن الطبراني","ما أسند حمزة بن عبد المطلب رضي الله عنه"
"2958","2960  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ أَبِي كَثِيرٍ ، قَالَ :  أَخْبَرَنِي  حَرَامُ بْنُ عُثْمَانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ الْأَعْرَجِ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَتَى  حَمْزَةَ بْنَ عَبْدِ الْمُطَّلِبِ  يَوْمًا وَلَمْ يَجِدْهُ ، فَسَأَلَ امْرَأَتَهُ  عِنَبَةَ  ، وَكَانَتْ مِنْ  بَنِي النَّجَّارِ  ،         [3/152]      فَقَالَتْ : خَرَجَ بِأَبِي أَنْتَ آنِفًا عَامِدًا نَحْوَكَ ، فَأَظُنُّهُ أَخْطَأَكَ فِي بَعْضِ أَزِقَّةِ  بَنِي النَّجَّارِ  ، أَفَلَا تَدْخُلُ يَا رَسُولَ اللهِ ؟ فَدَخَلَ ، فَقَدَّمَتْ لَهُ حَيْسًا ، فَأَكَلَ مِنْهُ ، فَقَالَتْ : يَا رَسُولَ اللهِ ، هَنِيئًا لَكَ  وَمَرِيئًا  ، لَقَدْ جِئْتَ وَأَنَا أُرِيدُ أَنْ آتِيَكَ أُهْنِئَكَ  وَأُمْرِئَكَ  ، أَخْبَرَنِي  أَبُو عُمَارَةَ  أَنَّكَ أُعْطِيتَ نَهَرًا فِي الْجَنَّةِ يُدْعَى  الْكَوْثَرَ  . قَالَ :  أَجَلْ ، وَعَرْصَتُهُ يَاقُوتٌ وَمَرْجَانٌ وَزَبَرْجَدُ وَلُؤْلُؤٌ  . قَالَتْ : أَحْبَبْتُ أَنْ تَصِفَ لِي حَوْضَكَ بِصِفَةٍ أَسْمَعُهَا مِنْكَ . فَقَالَ : "" هُوَ مَا بَيْنَ  أَيْلَةَ  وَصَنْعَاءَ  ، فِيهِ أَبَارِيقُ مِثْلُ عَدَدِ النُّجُومِ ، وَأَحَبُّ وَارِدِهَا عَلَيَّ قَوْمُكِ يَا بِنْتَ قَهْدٍ  .  يَعْنِي  الْأَنْصَارَ  .","","Al-Mu'jam al-Kabir 2960","","أسامة بن زيد بن حارثة ذو البطين عن عبد الرحمن بن هرمز الأعرج عن حرام بن عثمان الأنصاري عن محمد بن جعفر بن أبي كثير الزرقي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","ما أسند حمزة بن عبد المطلب رضي الله عنه"
"2959","238 -  حَمْزَةُ بْنُ عَمْرٍو الْأَسْلَمِيُّ ، يُكَنَّى أَبَا صَالِحٍ ، وَيُقَالُ : أَبُو مُحَمَّدٍ  2961  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ خَلَّادٍ الْوَاسِطِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  ثَنَا  سُفْيَانُ بْنُ حَمْزَةَ ،  عَنْ  كَثِيرِ بْنِ زَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ حَمْزَةَ بْنِ عَمْرٍو ،  عَنْ  أَبِيهِ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَنَّاهُ  أَبَا صَالِحٍ  .","","Al-Mu'jam al-Kabir 2961","","حمزة بن عمرو بن عويمر الأسلمي عن محمد بن حمزة الأسلمي عن كثير بن زيد السهمي عن سفيان بن حمزة الأسلمي عن يعقوب بن محمد بن عيسى عن عبد الله بن محمد بن خلاد العراقي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","حمزة بن عمرو الأسلمي"
"2960","عَائِشَةُ  رَضِيَ اللهُ عَنْهَا عَنْ  حَمْزَةَ بْنِ عَمْرٍو  2962  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ الزُّبَيْرِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  عَنْ  حَمْزَةَ بْنِ عَمْرٍو الْأَسْلَمِيِّ  أَنَّهُ قَالَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنِّي رَجُلٌ  أَسْرُدُ  الصَّوْمَ ، أَفَأَصُومُ فِي السَّفَرِ ؟ قَالَ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Al-Mu'jam al-Kabir 2962","","حمزة بن عمرو بن عويمر الأسلمي عن عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد العزيز بن محمد الدراوردي عن مصعب بن عبد الله بن مصعب الزبيري عن عبد الله بن أحمد بن حنبل عن الطبراني","عائشة رضي الله عنها عن حمزة بن عمرو"
"2961","2963  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  عَنْ  حَمْزَةَ         [3/153]      الْأَسْلَمِيِّ  أَنَّهُ قَالَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنِّي رَجُلٌ أَصُومُ ، أَفَأَصُومُ فِي السَّفَرِ ؟ قَالَ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Al-Mu'jam al-Kabir 2963","","حمزة بن عمرو بن عويمر الأسلمي عن عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الرحيم بن سليمان الأشل عن أبو بكر ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عائشة رضي الله عنها عن حمزة بن عمرو"
"2962","2964  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْحَكَمِ ،  أَنَا  مَالِكٌ ، (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا  أَنَّ  حَمْزَةَ بْنَ عَمْرٍو الْأَسْلَمِيَّ قَالَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَصُومُ فِي السَّفَرِ ؟ وَكَانَ كَثِيرَ الصِّيَامِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Al-Mu'jam al-Kabir 2964","","حمزة بن عمرو بن عويمر الأسلمي عن عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عائشة رضي الله عنها عن حمزة بن عمرو"
"2963","2965  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عَائِشَةَ  أَنَّ  حَمْزَةَ بْنَ عَمْرٍو الْأَسْلَمِيَّ سَأَلَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الصِّيَامِ فِي السَّفَرِ ، فَقَالَ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Al-Mu'jam al-Kabir 2965","","حمزة بن عمرو بن عويمر الأسلمي عن عائشة بنت أبي بكر الصديق عن هشام بن عروة بن الزبير عن محمد بن عجلان عن الليث بن سعد عن عبد الله بن صالح المصري عن يحيى بن عثمان بن صالح عن الطبراني","عائشة رضي الله عنها عن حمزة بن عمرو"
"2964","2966  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  أَنَّ  حَمْزَةَ بْنَ عَمْرٍو الْأَسْلَمِيَّ سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الصِّيَامِ فِي السَّفَرِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Al-Mu'jam al-Kabir 2966","","حمزة بن عمرو بن عويمر الأسلمي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عائشة رضي الله عنها عن حمزة بن عمرو"
"2965","2967  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ، قَالَ :  أَخْبَرَنِي  عُرْوَةُ  ،  عَنْ  عَائِشَةَ  أَنَّ  حَمْزَةَ الْأَسْلَمِيَّ أَتَى         [3/154]      رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي رَجُلٌ كُنْتُ أُسَافِرُ ، فَأَصُومُ فِي السَّفَرِ ؟ فَقَالَ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Al-Mu'jam al-Kabir 2967","","حمزة بن عمرو بن عويمر الأسلمي عن عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","عائشة رضي الله عنها عن حمزة بن عمرو"
"2966","2968  -  حَدَّثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  أَنَّ عَائِشَةَ  أَخْبَرَتْهُ  أَنَّ  حَمْزَةَ بْنَ عَمْرٍو الْأَسْلَمِيَّ سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنِّي رَجُلٌ أَصُومُ فِي السَّفَرِ ؟ فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Al-Mu'jam al-Kabir 2968","","حمزة بن عمرو بن عويمر الأسلمي عن عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن عبد الله بن أويس عن إسماعيل بن أبي أويس عن علي بن محمد بن عبد الله الصنعاني عن الطبراني","عائشة رضي الله عنها عن حمزة بن عمرو"
"2967","2969  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُعَاذٍ الْحَلَبِيُّ  ، ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  أَبِي  ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ  أَنَّ  حَمْزَةَ بْنَ عَمْرٍو الْأَسْلَمِيَّ قَالَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنِّي رَجُلٌ أَصُومُ ، فَأَصُومُ فِي السَّفَرِ ؟ فَقَالَ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Al-Mu'jam al-Kabir 2969","","حمزة بن عمرو بن عويمر الأسلمي عن عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن مسلمة بن قعنب القعنبي عن عبد الله بن مسلمة القعنبي عن محمد بن معاذ بن سفيان العنزي عن الطبراني","عائشة رضي الله عنها عن حمزة بن عمرو"
"2968","2970  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى بْنِ مُعَاذٍ الْعَنْبَرِيُّ  ، ثَنَا  مُسَدَّدٌ ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا  أَنَّ  حَمْزَةَ بْنَ عَمْرٍو الْأَسْلَمِيَّ سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي رَجُلٌ  أَسْرُدُ  الصَّوْمَ ، أَفَأَصُومُ فِي السَّفَرِ ؟ فَقَالَ :  صُمْ إِنْ شِئْتَ ، وَأَفْطِرْ إِنْ شِئْتَ  .","","Al-Mu'jam al-Kabir 2970","","حمزة بن عمرو بن عويمر الأسلمي عن عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن زيد عن سليمان بن داود العتكي عن الحسين بن إسحاق التستري عن الطبراني","عائشة رضي الله عنها عن حمزة بن عمرو"
"2969","2971  -  حَدَّثَنَا  الْقَاسِمُ بْنُ مُحَمَّدٍ الدَّلَّالُ  ، ثَنَا  عَوْنُ بْنُ سَلَّامٍ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ  أَنَّ  حَمْزَةَ الْأَسْلَمِيَّ سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الصَّوْمِ فِي السَّفَرِ ، فَقَالَ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Al-Mu'jam al-Kabir 2971","","حمزة بن عمرو بن عويمر الأسلمي عن عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن قيس بن الربيع الأسدي عن عون بن سلام الهاشمي عن قاسم بن محمد بن حماد الدلال عن الطبراني","عائشة رضي الله عنها عن حمزة بن عمرو"
"2970","2972  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عَاصِمُ بْنُ النَّضْرِ ،  ثَنَا  الْمُعْتَمِرُ ،  ثَنَا  الْحَجَّاجُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ  أَنَّ  حَمْزَةَ بْنَ عَمْرٍو الْأَسْلَمِيَّ سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الصَّوْمِ فِي السَّفَرِ ، فَقَالَ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Al-Mu'jam al-Kabir 2972","","حمزة بن عمرو بن عويمر الأسلمي عن عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حجاج بن أرطاة عن معتمر بن سليمان عن عاصم بن النضر الأحول عن عبد الله بن أحمد الجواليقي عن الطبراني","عائشة رضي الله عنها عن حمزة بن عمرو"
"2971","2973  -  حَدَّثَنَا  إِسْحَاقُ بْنُ دَاوُدَ الصَّوَّافُ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ         [3/155]      إِسْمَاعِيلَ الْبُخَارِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  أَخِي  ،  عَنْ  سُلَيْمَانَ بْنِ بِلَالٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا  أَنَّ  حَمْزَةَ الْأَسْلَمِيَّ قَالَ : يَا رَسُولَ اللهِ ، إِنَّ بِي قُوَّةً فِي السَّفَرِ ، أَفَأَصُومُ ؟ قَالَ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Al-Mu'jam al-Kabir 2973","","حمزة بن عمرو بن عويمر الأسلمي عن عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن يحيى بن سعيد الأنصاري عن سليمان بن بلال القرشي عن عبد الحميد بن أبي أويس الأعشى عن إسماعيل بن أبي أويس عن البخاري عن إسحاق بن داود الصواف التستري عن الطبراني","عائشة رضي الله عنها عن حمزة بن عمرو"
"2972","2974  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ خَلَّادٍ الدَّوْرَقِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبَّادِ بْنِ آدَمَ ،  ثَنَا  عَبْدُ الْوَهَّابِ ،  عَنْ  أَيُّوبَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ  أَنَّ  حَمْزَةَ - رَجُلٌ مِنْ  أَسْلَمَ  - قَالَ : يَا رَسُولَ اللهِ ، إِنِّي  أَسْرُدُ  الصَّوْمَ فَلَا أُفْطِرُ ، أَفَأَصُومُ فِي السَّفَرِ ؟ قَالَ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Al-Mu'jam al-Kabir 2974","","حمزة بن عمرو بن عويمر الأسلمي عن عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أيوب السختياني عن عبد الوهاب بن عبد المجيد الثقفي عن محمد بن عباد بن آدم الهذلي عن عبد الرحمن بن خلاد الدورقي عن الطبراني","عائشة رضي الله عنها عن حمزة بن عمرو"
"2973","2975  -  حَدَّثَنَا  جَعْفَرُ بْنُ أَحْمَدَ بْنِ سِنَانٍ الْوَاسِطِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  شُعْبَةُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ  أَنَّ  حَمْزَةَ بْنَ عَمْرٍو الْأَسْلَمِيَّ سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الصَّوْمِ فِي السَّفَرِ ، فَقَالَ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Al-Mu'jam al-Kabir 2975","","حمزة بن عمرو بن عويمر الأسلمي عن عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن شعبة بن الحجاج عن يزيد بن هارون عن أحمد بن سنان القطان عن جعفر بن أحمد بن سنان الواسطي عن الطبراني","عائشة رضي الله عنها عن حمزة بن عمرو"
"2974","2976  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  عَائِشَةَ  أَنَّ  حَمْزَةَ بْنَ عَمْرٍو قَالَ : يَا رَسُولَ اللهِ ، إِنِّي كُنْتُ  أَسْرُدُ  الصَّوْمَ ، فَأَصُومُ فِي السَّفَرِ ؟ قَالَ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Al-Mu'jam al-Kabir 2976","","حمزة بن عمرو بن عويمر الأسلمي عن عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عائشة رضي الله عنها عن حمزة بن عمرو"
"2975","2977  -  حَدَّثَنَا  عَبْدُ الْكَبِيرِ بْنُ عُمَرَ الْخَطَّابِيُّ  ، ثَنَا  عُمَرُ بْنُ مُدْرِكٍ الرَّازِيُّ ،  ثَنَا  مَكِّيُّ بْنُ إِبْرَاهِيمَ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ بْنِ سَالِمٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ  أَنَّ  حَمْزَةَ بْنَ عَمْرٍو الْأَسْلَمِيَّ سَأَلَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الصَّوْمِ فِي السَّفَرِ ، فَقَالَ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Al-Mu'jam al-Kabir 2977","","حمزة بن عمرو بن عويمر الأسلمي عن عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن يحيى بن عبد الله بن سالم بن عبد الله بن عمر عن مكي بن إبراهيم عن عمر بن مدرك البلخي عن عبد الكبير بن عمر الخطابي عن الطبراني","عائشة رضي الله عنها عن حمزة بن عمرو"
"2976","2978  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ بَرَّادٍ الْأَشْعَرِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  حَمْزَةَ بْنِ عَمْرٍو  أَنَّهُ سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الصَّوْمِ فِي السَّفَرِ ، فَقَالَ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Al-Mu'jam al-Kabir 2978","","حمزة بن عمرو بن عويمر الأسلمي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن إدريس الأودي عن عبد الله بن براد بن يوسف بن أبي بردة بن أبي موسى عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عائشة رضي الله عنها عن حمزة بن عمرو"
"2977","2979  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ مَنْصُورٍ         [3/156]      الْمَرْوَزِيُّ ،  ثَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  أَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ عَلْقَمَةَ ،  عَنْ  يَحْيَى بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  حَمْزَةَ بْنِ عَمْرٍو الْأَسْلَمِيِّ ، قَالَ :  قُلْتُ : يَا رَسُولَ إِنِّي أَقْوَى عَلَى الصِّيَامِ . قَالَ :  إِنْ قَوِيتَ فَأَنْتَ وَذَاكَ  .","","Al-Mu'jam al-Kabir 2979","","حمزة بن عمرو بن عويمر الأسلمي عن عروة بن الزبير عن يحيى بن عبد الرحمن بن حاطب اللخمي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن النضر بن شميل عن زاج ، أحمد بن منصور الحنظلي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عائشة رضي الله عنها عن حمزة بن عمرو"
"2978","2980  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  عَبْدُ الْقُدُّوسِ بْنُ مُحَمَّدٍ الْعَطَّارُ الْحَبْحَابِيُّ ،  ثَنَا  عَمْرُو بْنُ عَاصِمٍ ،  ثَنَا  عِمْرَانُ الْقَطَّانُ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ  أَنَّ  حَمْزَةَ بْنَ عَمْرٍو الْأَسْلَمِيَّ سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الصَّوْمِ فِي السَّفَرِ ، فَقَالَ :  صُمْ إِنْ شِئْتَ ، وَأَفْطِرْ إِنْ شِئْتَ  .","","Al-Mu'jam al-Kabir 2980","","حمزة بن عمرو بن عويمر الأسلمي عن عروة بن الزبير عن محمد بن إبراهيم بن الحارث التيمي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عمران بن داور القطان عن عمرو بن عاصم الكلابي عن عبد القدوس بن محمد الحبحابي عن أحمد بن يحيى بن زهير التستري عن الطبراني","عائشة رضي الله عنها عن حمزة بن عمرو"
"2979","2981  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ ،  عَنْ  أَبِي مُرَاوِحٍ ،  عَنْ  حَمْزَةَ الْأَسْلَمِيِّ أَنَّهُ قَالَ :  يَا رَسُولَ اللهِ ، إِنَّ بِي قُوَّةً لِلصِّيامِ فِي السَّفَرِ ، فَهَلْ عَلَيَّ جُنَاحٌ ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هِيَ رُخْصَةٌ مِنَ اللهِ عَزَّ وَجَلَّ ، مَنْ شَاءَ أَخَذَ بِهَا فَحَسَنٌ  ، وَمَنْ أَحَبَّ أَنْ يَصُومَ فَلَا جُنَاحَ عَلَيْهِ  .","","Al-Mu'jam al-Kabir 2981","","حمزة بن عمرو بن عويمر الأسلمي عن أبو مراوح الغفاري عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","عائشة رضي الله عنها عن حمزة بن عمرو"
"2980","سُلَيْمَانُ بْنُ يَسَارٍ  عَنْ  حَمْزَةَ  2982  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  عَنْ  قَتَادَةَ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ  أَنَّ  حَمْزَةَ بْنَ عَمْرٍو الْأَسْلَمِيَّ سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الصَّوْمِ فِي السَّفَرِ ، فَقَالَ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Al-Mu'jam al-Kabir 2982","","حمزة بن عمرو بن عويمر الأسلمي عن سليمان بن يسار مولى ميمونة زوج رسول الله عن قتادة بن دعامة عن هشام الدستوائي عن مسلم بن إبراهيم الشحام عن أبو مسلم الكجي عن الطبراني","سليمان بن يسار عن حمزة"
"2981","[3/157]      2983  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  سَلْمُ بْنُ جُنَادَةَ ،  ثَنَا  وَكِيعٌ ،  ثَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  عَنْ  قَتَادَةَ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  حَمْزَةَ الْأَسْلَمِيِّ  أَنَّهُ سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الصَّوْمِ فِي السَّفَرِ ، فَقَالَ :  أَنْتَ بِالْخِيَارِ ، إِنْ شِئْتَ صُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Al-Mu'jam al-Kabir 2983","","حمزة بن عمرو بن عويمر الأسلمي عن سليمان بن يسار مولى ميمونة زوج رسول الله عن قتادة بن دعامة عن هشام الدستوائي عن وكيع بن الجراح عن سلم بن جنادة السوائي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","سليمان بن يسار عن حمزة"
"2982","2984  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  ثَنَا  سَعِيدٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ  أَنَّ  حَمْزَةَ الْأَسْلَمِيَّ سَأَلَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الصَّوْمِ فِي السَّفَرِ ، فَقَالَ :  إِنْ شِئْتَ صُمْتَ ، وَإِنْ شِئْتَ أَفْطَرْتَ  .","","Al-Mu'jam al-Kabir 2984","","حمزة بن عمرو بن عويمر الأسلمي عن سليمان بن يسار مولى ميمونة زوج رسول الله عن قتادة بن دعامة عن سعيد بن أبي عروبة عن محمد بن بشر بن الفرافصة عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","سليمان بن يسار عن حمزة"
"2983","2985  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ  ، ثَنَا  شُعَيْبُ بْنُ يَحْيَى ، (  ح  ) .  وَحَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  أَبُو صَالِحٍ عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَا :  ثَنَا  اللَّيْثُ ، (  ح  ) .  وَحَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  أَبُو الْوَلِيدِ ،  ثَنَا  لَيْثُ بْنُ سَعْدٍ ،  عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ  أَنَّ  حَمْزَةَ الْأَسْلَمِيَّ قَالَ : يَا رَسُولَ اللهِ إِنِّي أَجِدُ قُوَّةً عَلَى الصِّيَامِ فِي السَّفَرِ . فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Al-Mu'jam al-Kabir 2985","","حمزة بن عمرو بن عويمر الأسلمي عن سليمان بن يسار مولى ميمونة زوج رسول الله عن بكير بن عبد الله بن الأشج القرشي عن الليث بن سعد عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","سليمان بن يسار عن حمزة"
"2984","2986  -  حَدَّثَنَا  - مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  ابْنُ مُبَارَكٍ ،  عَنْ  عَبْدِ الْحَمِيدِ بْنِ جَعْفَرٍ ،  عَنْ  عِمْرَانَ بْنِ أَبِي أَنَسٍ ، قَالَ :  سَمِعْتُ  سُلَيْمَانَ بْنَ يَسَارٍ ،  عَنْ  حَمْزَةَ الْأَسْلَمِيِّ  أَنَّهُ سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الصَّوْمِ فِي السَّفَرِ ، فَقَالَ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Al-Mu'jam al-Kabir 2986","","حمزة بن عمرو بن عويمر الأسلمي عن سليمان بن يسار مولى ميمونة زوج رسول الله عن عمران بن أبي أنس العامري عن عبد الحميد بن جعفر الأوسي عن عبد الله بن المبارك عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","سليمان بن يسار عن حمزة"
"2985","2987  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  عَنْ  سَعِيدٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  حَمْزَةَ الْأَسْلَمِيِّ  أَنَّهُ رَأَى  رَجُلًا  بِمِنًى  يَطُوفُ عَلَى جَمَلٍ لَهُ آدَمَ يَقُولُ :  لَا تَصُومُوا هَذِهِ الْأَيَّامَ ، فَإِنَّهَا أَيَّامُ أَكْلٍ  وَشُرْبٍ  ، وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَ أَظْهُرِهِمْ  .","","Al-Mu'jam al-Kabir 2987","","حمزة بن عمرو بن عويمر الأسلمي عن سليمان بن يسار مولى ميمونة زوج رسول الله عن قتادة بن دعامة عن سعيد بن أبي عروبة عن محمد بن بشر بن الفرافصة عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","سليمان بن يسار عن حمزة"
"2986","[3/158]      أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ  عَنْ  حَمْزَةَ بْنِ عَمْرٍو  2988  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  عِمْرَانَ بْنِ أَبِي أَنَسٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  حَمْزَةَ بْنِ عَمْرٍو الْأَسْلَمِيِّ  أَنَّهُ سَأَلَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الصِّيَامِ فِي السَّفَرِ ، فَقَالَ :  أَيُّ ذَلِكَ أَيْسَرُ عَلَيْكَ فَافْعَلْ  .","","Al-Mu'jam al-Kabir 2988","","حمزة بن عمرو بن عويمر الأسلمي عن أبو سلمة بن عبد الرحمن عن عمران بن أبي أنس العامري عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن يحيى بن عبد الله بن بكير المخزومي عن روح بن الفرج القطان عن الطبراني","أبو سلمة بن عبد الرحمن عن حمزة بن عمرو"
"2987","2989  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ الْبَكْرِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ رَاشِدٍ النَّصْرِيُّ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  حَمْزَةَ بْنِ عَمْرٍو الْأَسْلَمِيِّ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِلْأَسْلَمِيِّينَ  :  ارْمُوا يَا  بَنِي إِسْمَاعِيلَ  ، فَإِنَّ أَبَاكُمْ كَانَ رَامِيًا  . قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" وَأَنَا مَعَ  مِحْجَنِ بْنِ الْأَذْرَعِ  "" . فَأَمْسَكَ  الْقَوْمُ  ، قَالَ : "" مَا لَكُمْ ؟ "" قَالُوا : مَنْ كُنْتَ مَعَهُ فَقَدْ غَلَبَ . قَالَ : "" فَارْمُوا وَأَنَا مَعَكُمْ كُلِّكُمْ  .","","Al-Mu'jam al-Kabir 2989","","حمزة بن عمرو بن عويمر الأسلمي عن أبو سلمة بن عبد الرحمن عن سليمان بن راشد المصري عن عبد الله بن يزيد البكري عن هشام بن عمار عن الحسن بن علي بن شبيب المعمري عن الطبراني","أبو سلمة بن عبد الرحمن عن حمزة بن عمرو"
"2988","مُحَمَّدُ بْنُ حَمْزَةَ بْنِ عَمْرٍو الْأَسْلَمِيُّ  عَنْ أَبِيهِ  2990  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ، (  ح  ) .  وَحَدَّثَنَا  أَبُو خَلِيفَةَ  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْوَهَّابِ الْحَجَبِيُّ ، (  ح  ) .  وَحَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الْقَطَّانُ الْمِصْرِيُّ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ، قَالُوا :  ثَنَا  الْمُغِيرَةُ بْنُ عَبْدِ الرَّحْمَنِ الْحِزَامِيُّ ،  عَنْ  أَبِي الزِّنَادِ أَنَّ  مُحَمَّدَ بْنَ حَمْزَةَ بْنِ عَمْرٍو الْأَسْلَمِيَّ  أَخْبَرَهُ  ، أَنَّ أَبَاهُ  أَخْبَرَهُ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَّرَهُ عَلَى سَرِيَّةٍ ، قَالَ : فَخَرَجْتُ فِيهَا ، فَقَالَ : "" إِنْ أَخَذْتُمْ  فُلَانًا  فَأَحْرِقُوهُ  بِالنَّارِ "" . فَلَمَّا وَلَّيْتُ نَادَانِي ، فَقَالَ :  إِنْ أَخَذْتُمُوهُ فَاقْتُلُوهُ ، فَإِنَّهُ لَا يُعَذِّبُ بِالنَّارِ إِلَّا رَبُّ النَّارِ  .  وَاللَّفْظُ لِحَدِيثِ  سَعِيدِ بْنِ مَنْصُورٍ  .","","Al-Mu'jam al-Kabir 2990","","حمزة بن عمرو بن عويمر الأسلمي عن محمد بن حمزة الأسلمي عن أبو الزناد عن المغيرة بن عبد الرحمن بن عبد الله الحزامي عن يحيى بن عبد الله بن بكير المخزومي عن إسحاق بن إبراهيم بن جابر التجيبي عن الطبراني","محمد بن حمزة بن عمرو الأسلمي عن أبيه"
"2989","[3/159]      2991  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ،  حَدَّثَنِي  أَبِي  ، (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  إِبْرَاهِيمُ بْنُ حَمْزَةَ ،  ثَنَا  سُفْيَانُ بْنُ حَمْزَةَ ،  عَنْ  كَثِيرِ بْنِ زَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ حَمْزَةَ بْنِ عَمْرٍو الْأَسْلَمِيِّ ،  عَنْ  أَبِيهِ  ، قَالَ :  أُنْفِرَ  بِنَا وَنَحْنُ فِي سَفَرٍ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي لَيْلَةٍ ظَلْمَاءَ دَحِسَةٍ ، فَأَضَاءَتْ أَصَابِعِي  حَتَّى جَمَعُوا عَلَيْهَا ظَهْرَهَمْ وَمَا سَقَطَ مِنْ مَتَاعِهِمْ ، وَإِنَّ أَصَابِعِي لَتُنِيرُ  .","","Al-Mu'jam al-Kabir 2991","","حمزة بن عمرو بن عويمر الأسلمي عن محمد بن حمزة الأسلمي عن كثير بن زيد السهمي عن سفيان بن حمزة الأسلمي عن إبراهيم بن حمزة الزبيري عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","محمد بن حمزة بن عمرو الأسلمي عن أبيه"
"2990","2992  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نَصْرٍ الصَّائِغُ  ، ثَنَا  إِبْرَاهِيمُ بْنُ حَمْزَةَ الزُّبَيْرِيُّ ،  ثَنَا  سُفْيَانُ بْنُ حَمْزَةَ ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  حَمْزَةُ بْنُ مَالِكِ بْنِ حَمْزَةَ الْمَدِينِيُّ ،  حَدَّثَنِي  عَمِّي سُفْيَانُ بْنُ حَمْزَةَ ،  عَنْ  كَثِيرِ بْنِ زَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ حَمْزَةَ بْنِ عَمْرٍو الْأَسْلَمِيِّ ،  عَنْ  أَبِيهِ حَمْزَةَ بْنِ عَمْرٍو  ، قَالَ :  كَانَ طَعَامُ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَدُورُ عَلَى يَدَيْ أَصْحَابِهِ هَذَا لَيْلَةً وَهَذَا لَيْلَةً . قَالَ : فَدَارَ عَلَيَّ لَيْلَةً ، فَصَنَعْتُ طَعَامَ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَتَرَكْتُ النِّحْيَ وَلَمْ أُوكِهِ ، وَذَهَبْتُ بِالطَّعَامِ إِلَيْهِ ، فَتَحَرَّكَ فَأُهْرِيقَ مَا فِيهِ ، فَقُلْتُ : أَعَلَى يَدِي أُهْرِيقَ طَعَامُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَدْنِهِ "" . فَقُلْتُ : لَا أَسْتَطِيعُ يَا رَسُولَ اللهِ ، فَرَجَعْتُ مَكَانِي ، فَإِذَا النِّحْيُ يَقُولُ : قَبْ قَبْ ، فَقُلْتُ : مَهْ ، قَدْ أُهْرِيقَتْ فَضْلَةٌ فَضَلَتْ فِيهِ ، فَجِئْتُ أَنْظُرُ فِيهِ فَوَجَدْتُهُ قَدْ مُلِئَ إِلَى ثَدْيَيْهِ ، فَاجْتَذَبْتُهُ ، وَجِئْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَخْبَرْتُهُ ، فَقَالَ :  أَلَا إِنَّكَ لَوْ تَرَكْتَهُ لَمُلِئَ إِلَى فِيهِ ثُمَّ أُوكِئَ  .","","Al-Mu'jam al-Kabir 2992","","حمزة بن عمرو بن عويمر الأسلمي عن محمد بن حمزة الأسلمي عن كثير بن زيد السهمي عن سفيان بن حمزة الأسلمي عن حمزة بن مالك بن حمزة الأسلمي عن الحسين بن إسحاق التستري عن الطبراني","محمد بن حمزة بن عمرو الأسلمي عن أبيه"
"2991","2993  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يَزِيدُ بْنُ يَحْيَى بْنِ يَزِيدَ         [3/160]      أَبُو خَالِدٍ الْخُزَاعِيُّ ،  ثَنَا  أَبُو بَكْرِ بْنُ مُحَمَّدِ بْنِ حَمْزَةَ بْنِ عَمْرٍو الْأَسْلَمِيُّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، قَالَ :  خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  غَزْوَةِ تَبُوكَ  ، وَكُنْتُ عَلَى خِدْمَتِهِ ذَلِكَ السَّفَرَ ، فَنَظَرْتُ إِلَى نِحْيِ السَّمْنِ قَدْ قَلَّ مَا فِيهِ ، وَهَيَّأْتُ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ طَعَامًا ، فَوَضَعْتُ النِّحْيَ فِي الشَّمْسِ وَنِمْتُ ، فَانْتَبَهْتُ  بِخَرِيرِ  النِّحْيِ ، فَقُمْتُ فَأَخَذْتُ بِرَأْسِهِ بِيَدِي ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَرَآنِي :  لَوْ تَرَكْتَهُ لسَالَ وَادِيًا سَمْنًا  .","","Al-Mu'jam al-Kabir 2993","","حمزة بن عمرو بن عويمر الأسلمي عن محمد بن حمزة الأسلمي عن حمزة بن محمد بن حمزة الأسلمي عن يزيد بن يزيد الخزاعي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن حمزة بن عمرو الأسلمي عن أبيه"
"2992","2994  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ نَافِعٍ الطَّحَّانُ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  أُسَامَةُ بْنُ زَيْدٍ أَنَّ  مُحَمَّدَ بْنَ حَمْزَةَ بْنِ عَمْرٍو الْأَسْلَمِيَّ  حَدَّثَهُ  أَنَّهُ سَمِعَ  أَبَاهُ حَمْزَةَ  يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  فِي ظَهْرِ كُلِّ بَعِيرٍ شَيْطَانٌ ، فَإِذَا رَكِبْتُمُوهَا فَسَمُّوا اللهَ  ، ثُمَّ لَا تُقَصِّرُوا عَنْ حَاجَتِكُمْ  .","","Al-Mu'jam al-Kabir 2994","","حمزة بن عمرو بن عويمر الأسلمي عن محمد بن حمزة الأسلمي عن أسامة بن زيد الليثي المدني عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن نافع الطحاوي عن الطبراني","محمد بن حمزة بن عمرو الأسلمي عن أبيه"
"2993","2995  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، حَدَّثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْمَجِيدِ الْمَدَنِيُّ ، قَالَ :  سَمِعْتُ  حَمْزَةَ بْنَ مُحَمَّدِ بْنِ حَمْزَةَ بْنِ عَمْرٍو الْأَسْلَمِيَّ يَذْكُرُ أَنَّ أَبَاهُ  أَخْبَرَهُ  عَنْ  جَدِّهِ ،  قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، إِنِّي صَاحِبُ ظَهْرٍ  أُعَالِجُهُ  أُسَافِرُ عَلَيْهِ وَأَكْرِيهِ  ، وَإِنَّهُ رُبَّمَا صَادَفَنِي هَذَا  الشَّهْرُ  -  يَعْنِي رَمَضَانَ  - وَأَنَا أَجِدُ الْقُوَّةَ وَأَنَا شَاتٍ ، فَأَجِدُ أَنْ أَصُومَ يَا رَسُولَ اللهِ أَهْوَنُ عَلَيَّ مِنْ أَنْ أُؤَخِّرَهُ ، فَيَكُونَ دَيْنًا عَلَيَّ ، أَفَأَصُومُ يَا رَسُولَ اللهِ أَعْظَمُ لِأَجْرِي أَمْ أُفْطِرُ ؟ فَقَالَ : "" أَيَّ ذَلِكَ شِئْتَ يَا  حَمْزَةُ  .","","Al-Mu'jam al-Kabir 2995","","حمزة بن عمرو بن عويمر الأسلمي عن محمد بن حمزة الأسلمي عن حمزة بن محمد بن حمزة الأسلمي عن محمد بن عبد المجيد بن سهيل بن عبد الرحمن بن عوف عن عبد الله بن محمد النفيلي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","محمد بن حمزة بن عمرو الأسلمي عن أبيه"
"2994","2996  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  أَبِي الزِّنَادِ ،  أَخْبَرَنِي  حَنْظَلَةُ الْأَسْلَمِيُّ أَنَّ حَمْزَةَ بْنَ عَمْرٍو الْأَسْلَمِيَّ         [3/161]      صَاحِبَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  حَدَّثَهُ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعَثَهُ وَرَهْطًا مَعَهُ سَرِيَّةً إِلَى  رَجُلٍ  مِنْ عَدُوِّهِ ، فَقَالَ :  إِنْ قَدَرْتُمْ عَلَى  فُلَانٍ  فَأَحْرِقُوهُ  بِالنَّارِ  . فَانْطَلَقُوا ، حَتَّى إِذَا تَوَارَوْا مِنْهُ نَادَاهُمْ ، فَأَرْسَلَ فِي آثَارِهِمْ فَرَدُّوهُمْ ، ثُمَّ قَالَ : "" إِنْ أَنْتُمْ قَدَرْتُمْ عَلَيْهِ فَاقْتُلُوهُ ، وَلَا تُحْرِقُوهُ بِالنَّارِ ؛ فَإِنَّهُ لَا يُعَذِّبُ بِالنَّارِ إِلَّا رَبُّ النَّارِ  .","","Al-Mu'jam al-Kabir 2996","","حمزة بن عمرو بن عويمر الأسلمي عن حنظلة بن علي بن الأسقع الأسلمي عن أبو الزناد عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","محمد بن حمزة بن عمرو الأسلمي عن أبيه"
"2995","2997  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  إِسْحَاقُ بْنُ مُوسَى الْأَنْصَارِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ، (  ح  ) .  وَحَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  عَلِيُّ بْنُ الْحَسَنِ بْنِ سَالِمٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سُلَيْمَانَ ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنْ  أَبِي الْأَشْعَثِ الْعَطَّارِ  ، عَنْ  حَمْزَةَ بْنِ عَمْرٍو الْأَسْلَمِيِّ ، قَالَ :  سَأَلْتُهُ عَنِ الصِّيَامِ فِي السَّفَرِ ، قَالَ :  كُنَّا نَصُومُ وَنُفْطِرُ ، وَلَا يَعِيبُ الْمُفْطِرُ عَلَى الصَّائِمِ  ، وَلَا الصَّائِمُ عَلَى الْمُفْطِرِ  "" .","","Al-Mu'jam al-Kabir 2997","","حمزة بن عمرو بن عويمر الأسلمي عن أبو الأشعث العطار عن أشعث بن سوار عن عبد الرحمن بن سليمان الداراني عن علي بن الحسن اللاني عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","محمد بن حمزة بن عمرو الأسلمي عن أبيه"
"2996","2998  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ،  ثَنَا  شَرِيكٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  حَمْزَةَ بْنِ عَمْرٍو ، قَالَ :  أَكَلْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ طَعَامًا ، فَقَالَ :  كُلْ بِيَمِينِكَ ، وَكُلْ مِمَّا يَلِيكَ ، وَاذْكُرِ اسْمَ اللهِ  .","","Al-Mu'jam al-Kabir 2998","","حمزة بن عمرو بن عويمر الأسلمي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن شريك بن عبد الله النخعي عن منجاب بن الحارث التميمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن حمزة بن عمرو الأسلمي عن أبيه"
"2997","قَالَ  الْحَضْرَمِيُّ  :  سَمِعْتُ  مِنْجَابَ بْنَ الْحَارِثِ  يَقُولُ : ""  هَذَا خَطَأٌ أَخْطَأَ فِيهِ  شَرِيكٌ  ،  أَخْبَرَنَا بِهِ  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُمَرَ بْنِ أَبِي سَلَمَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ "" . ""  حَمْزَةُ بْنُ عَمْرٍو  ، وَلَيْسَ بِصَحِيحٍ ، أَخْطَأَ فِيهِ  شَرِيكٌ  "" .","","Al-Mu'jam al-Kabir 2997","","عمر بن أبي سلمة المخزومي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن علي بن مسهر القرشي عن منجاب بن الحارث التميمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن حمزة بن عمرو الأسلمي عن أبيه"
"2998","239 -  حُذَيْفَةُ بْنُ الْيَمَانِ ، يُكْنَى أَبَا عَبْدِ اللهِ ، الْعَبْسِيُّ  2999  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عِقَالٍ الْحَرَّانِيُّ  ،  حَدَّثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ  ،  ثَنَا  زُهَيْرٌ  ،  عَنْ  أَبِي إِسْحَاقَ  ،  عَنْ  جَامِعٍ الْأَرْحَبِيِّ  ،  قَالَ  : ""  أَتَيْتُ أَنَا وَصَاحِبٌ لِي  حُذَيْفَةَ بْنَ الْيَمَانِ  ، فَقُلْنَا : يَا  أَبَا عَبْدِ اللهِ  "" .","","Al-Mu'jam al-Kabir 2999","","","حذيفة بن اليمان"
"2999","[3/162]      3000  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  زَكَرِيَّا بْنُ عَدِيٍّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  يُونُسَ ،  عَنِ  الزُّهْرِيِّ  أَنَّ  حُذَيْفَةَ كَانَ أَحَدَ  بَنِي عَبْسٍ  ، وَكَانَ عِدَادُهُ فِي  الْأَنْصَارِ  "" .","","Al-Mu'jam al-Kabir 3000","","حذيفة بن اليمان عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن المبارك عن زكريا بن عدي بن رزيق عن محمد بن عبد الله بن نمير عن محمد بن عبد الله مطين الحضرمي عن الطبراني","حذيفة بن اليمان"
"3000","3001  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  مُصْعَبِ بْنِ سَعْدٍ ، قَالَ :  أَخَذَ  حُذَيْفَةَ  وَأَبَاهُ الْمُشْرِكُونَ  قَبْلَ  بَدْرٍ  ، فَأَرَادُوا أَنْ يَقْتُلُوهُمْ ، وَأَخَذُوا عَلَيْهِمْ عَهْدًا وَمِيثَاقًا أَنْ لَا يُعِينُوا عَلَيْنَا ، فَأَرْسَلُوهُمَا ، فَأَتَيَا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَا : إِنَّا قَدْ جَعَلْنَا لَهُمْ أَنْ لَا نُعِينَ عَلَيْهِمْ ، فَإِنْ شِئْتَ قَاتَلْنَا مَعَكَ . فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بَلْ نَفِي لَهُمْ ، وَنَسْتَعِينُ اللهَ عَلَيْهِمْ  .","","Al-Mu'jam al-Kabir 3001","","مصعب بن سعد بن أبي وقاص عن أبو إسحاق السبيعي عن الأعمش عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن محمد بن عبد الله مطين الحضرمي عن الطبراني","حذيفة بن اليمان"
