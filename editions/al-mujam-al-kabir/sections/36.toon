hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"21001","أُمُّ حَبِيبَةَ بِنْتُ أَبِي سُفْيَانَ بْنِ حَرْبِ بْنِ أُمَيَّةَ بْنِ عَبْدِ شَمْسِ بْنِ عَبْدِ مَنَافٍ  ، زَوْجُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  اسْمُهَا  رَمْلَةُ  رَضِيَ اللهُ عَنْهَا .  ذِكْرُ تَزْوِيجِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أُمَّ حَبِيبَةَ  مِنْ أَخْبَارِهَا .  401  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  فِي "" تَسْمِيَةِ مَنْ هَاجَرَ إِلَى أَرْضِ  الْحَبَشَةِ  مَعَ  جَعْفَرِ بْنِ أَبِي طَالِبٍ  مِنْ  بَنِي أَسَدِ بْنِ خُزَيْمَةَ :  عُبَيْدُ اللهِ بْنُ جَحْشِ بْنِ رِئَابٍ  ، مَاتَ بِأَرْضِ  الْحَبَشَةِ  نَصْرَانِيًّا وَمَعَهُ أُمُّ حَبِيبَةَ بِنْتُ أَبِي سُفْيَانَ ، وَاسْمُهَا رَمْلَةُ ، فَخَلَّفَ عَلَيْهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْكَحَهُ إِيَّاهَا  عُثْمَانُ بْنُ عَفَّانَ  بِأَرْضِ  الْحَبَشَةِ  ،  وَأُمُّ حَبِيبَةَ  أُمُّهَا  صَفِيَّةُ بِنْتُ أَبِي الْعَاصِ  ، أُخْتُ  عَفَّانَ بْنِ أَبِي الْعَاصِ  ، عَمَّةُ  عُثْمَانَ بْنِ عَفَّانَ  ""  .","","Al-Mu'jam al-Kabir 401","","رملة بنت أبي سفيان زوج رسول الله عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","ذكر تزويج النبي صلى الله عليه وسلم أم حبيبة"
"21002","[23/219]      402  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، [ قَالَا ] :  ثَنَا  يَعْمَرُ بْنُ بَشِيرٍ  ،  ثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  أَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  أُمِّ حَبِيبَةَ ،  أَنَّهَا كَانَتْ تَحْتَ  عَبْدِ اللهِ بْنِ جَحْشٍ  ، وَكَانَ رَحَلَ إِلَى  النَّجَاشِيِّ  فَمَاتَ  ، وَأَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَزَوَّجَ  أُمَّ حَبِيبَةَ  ، وَإِنَّهَا لَفِي أَرْضِ  الْحَبَشَةِ  ، زَوَّجَهَا إِيَّاهُ  النَّجَاشِيُّ  وَلَمْ يُرْسِلْ إِلَيْهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِشَيْءٍ ، وَكَانَ مُهُورُ أَزْوَاجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَرْبَعَمِائَةِ دِرْهَمٍ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( بن بشر )","","Al-Mu'jam al-Kabir 402","","رملة بنت أبي سفيان زوج رسول الله عن عروة بن الزبير عن الزهري عن معمر بن راشد عن عبد الله بن المبارك عن يعمر بن بشر الخراساني عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","ذكر تزويج النبي صلى الله عليه وسلم أم حبيبة"
"21003","403  -  حَدَّثَنَا  أَبُو أُسَامَةَ عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ أَبِي أُسَامَةَ الْحَلَبِيُّ ،  ثَنَا  حَجَّاجُ بْنُ أَبِي مَنِيعٍ ،  عَنْ  جَدِّهِ عُبَيْدِ اللهِ بْنِ أَبِي زِيَادٍ  ،  عَنِ  الزُّهْرِيِّ ، قَالَ :  تَزَوَّجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أُمَّ حَبِيبَةَ بِنْتَ أَبِي سُفْيَانَ بْنِ حَرْبِ بْنِ أُمَيَّةَ بْنِ عَبْدِ شَمْسِ بْنِ عَبْدِ مَنَافِ بْنِ قُصَيِّ بْنِ كِلَابِ بْنِ مُرَّةَ بْنِ كَعْبِ بْنِ لُؤَيِّ بْنِ غَالِبِ بْنِ فِهْرِ بْنِ مَالِكٍ ، وَاسْمُ أُمِّ حَبِيبَةَ رَمْلَةُ  ، وَأَنْكَحَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أُمَّ حَبِيبَةَ  - رَضِيَ اللهُ عَنْهَا -  عُثْمَانُ بْنُ عَفَّانَ  - رَضِيَ اللهُ عَنْهُ - مِنْ أَجْلِ أَنَّ  أُمَّ حَبِيبَةَ  أُمُّهَا  صَفِيَّةُ بِنْتُ أَبِي الْعَاصِ  ،  وَصَفِيَّةُ  عَمَّةُ  عُثْمَانَ  ، أُخْتُ  عَفَّانَ  لِأَبِيهِ وَأُمِّهِ ، وَقَدِمَ  بِأُمِّ حَبِيبَةَ  عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  شُرَحْبِيلُ بْنُ حَسَنَةَ  .","","Al-Mu'jam al-Kabir 403","","الزهري عن عبيد الله بن أبي زياد الرصافي عن حجاج بن يوسف الرصافي عن عبد الله بن محمد بن أبي أسامة الحلبي عن الطبراني","ذكر تزويج النبي صلى الله عليه وسلم أم حبيبة"
"21004","[23/220]      404  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  الْعَبَّاسُ بْنُ عَبْدِ الْعَظِيمِ الْعَنْبَرِيُّ ،  ثَنَا  النَّضْرُ بْنُ مُحَمَّدٍ ،  ثَنَا  عِكْرِمَةُ بْنُ عَمَّارٍ ،  ثَنَا  أَبُو زُمَيْلٍ ،  ثَنَا  ابْنُ عَبَّاسٍ ،  أَنَّ  أَبَا سُفْيَانَ  ، قَالَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : عِنْدِي أَحْسَنُ نِسَاءِ الْعَرَبِ وَأَجْمَلُهُ  أُمُّ حَبِيبَةَ بِنْتُ أَبِي سُفْيَانَ  أُزَوِّجُكَهَا ؟ قَالَ : "" نَعَمْ "" ، قَالَ :  وَمُعَاوِيَةُ  تَتَّخِذُهُ كَاتِبًا ؟ قَالَ : "" نَعَمْ  .","","Al-Mu'jam al-Kabir 404","","عبد الله بن عباس عن سماك بن الوليد اليمامي عن عكرمة بن عمار عن النضر بن محمد بن موسى الجرشي عن عباس بن عبد العظيم العنبري عن عبد الله بن أحمد الجواليقي عن الطبراني","ذكر تزويج النبي صلى الله عليه وسلم أم حبيبة"
"21005","مَا  أَسْنَدَتْ  أُمُّ حَبِيبَةَ  زَوْجُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .  مَا رَوَى  مُعَاوِيَةُ بْنُ أَبِي سُفْيَانَ  عَنْ أُخْتِهِ  أُمِّ حَبِيبَةَ  .  405  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْحَكَمِ ،  ثَنَا  اللَّيْثُ بْنُ سَعْدٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  سُوَيْدِ بْنِ قَيْسٍ ،  عَنْ  مُعَاوِيَةَ بْنِ حُدَيْجٍ ، قَالَ :  سَمِعْتُ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ ، يَقُولُ :  سَأَلْتُ  أُمَّ حَبِيبَةَ هَلْ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي فِي الثَّوْبِ الَّذِي يُجَامِعُهَا فِيهِ ؟ ، قَالَتْ : "" نَعَمْ  ، إِذَا لَمْ يَكُنْ فِيهِ أَذًى  .","","Al-Mu'jam al-Kabir 405","","رملة بنت أبي سفيان زوج رسول الله عن معاوية بن أبي سفيان عن معاوية بن حديج السكوني عن سويد بن قيس التجيبي عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن عبد الله بن عبد الحكم بن أعين عن يوسف بن يزيد القراطيسي عن الطبراني","ما روى معاوية بن أبي سفيان عن أخته أم حبيبة"
"21006","406  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ الْعَطَّارُ الْمَكِّيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  سُوَيْدِ بْنِ قَيْسٍ ،  عَنْ  مُعَاوِيَةَ بْنِ حُدَيْجٍ ، قَالَ :  سَمِعْتُ  مُعَاوِيَةَ بْنَ         [23/221]      أَبِي سُفْيَانَ  ، يَقُولُ :  سَأَلْتُ  أُمَّ حَبِيبَةَ - زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي فِي الثَّوْبِ الَّذِي يُجَامِعُ فِيهِ ؟ ، قَالَتْ : "" نَعَمْ  ، إِذَا لَمْ يَرَ فِيهِ أَذًى  .","","Al-Mu'jam al-Kabir 406","","رملة بنت أبي سفيان زوج رسول الله عن معاوية بن أبي سفيان عن معاوية بن حديج السكوني عن سويد بن قيس التجيبي عن يزيد بن أبي حبيب الأزدي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","ما روى معاوية بن أبي سفيان عن أخته أم حبيبة"
"21007","407  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  شُعَيْبُ بْنُ يَحْيَى ،  ثَنَا  عَبْدُ الْجَبَّارِ بْنُ عُمَرَ ،  عَنْ  عَطَاءٍ الْخُرَاسَانِيِّ ،  عَنْ  يَحْيَى بْنِ أَبِي الْمُطَاعِ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ ، قَالَ :  دَخَلْتُ عَلَى  أُمِّ حَبِيبَةَ بِنْتِ أَبِي سُفْيَانَ  فَقَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" يُصَلِّي فِي ثَوْبٍ وَاحِدٍ مُلْتَحِفًا بِهِ  "" .","","Al-Mu'jam al-Kabir 407","","رملة بنت أبي سفيان زوج رسول الله عن معاوية بن أبي سفيان عن يحيى بن أبي المطاع الأردني عن عطاء الخراساني عن عبد الجبار بن عمر الأيلي عن شعيب بن يحيى التجيبي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","ما روى معاوية بن أبي سفيان عن أخته أم حبيبة"
"21008","408  -  حَدَّثَنَا  عُمَرُ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  سُوَيْدِ بْنِ قَيْسٍ ،  عَنْ  مُعَاوِيَةَ بْنِ حُدَيْجٍ ، قَالَ :  سَمِعْتُ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ ، يَقُولُ :  سَأَلْتُ  أُمَّ حَبِيبَةَ - زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي فِي الثَّوْبِ الَّذِي يُجَامِعُكِ فِيهِ ؟  ، قَالَتْ : "" نَعَمْ ، إِذَا لَمْ يَرَ فِيهِ أَذًى  .","","Al-Mu'jam al-Kabir 408","","رملة بنت أبي سفيان زوج رسول الله عن معاوية بن أبي سفيان عن معاوية بن حديج السكوني عن سويد بن قيس التجيبي عن يزيد بن أبي حبيب الأزدي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن عبد العزيز بن عمران المصري عن عمر بن عبد العزيز الخزاعي عن الطبراني","ما روى معاوية بن أبي سفيان عن أخته أم حبيبة"
"21009","مَا رَوَى  أَنَسُ بْنُ مَالِكٍ  عَنْ  أُمِّ حَبِيبَةَ  .  409  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ ،  ثَنَا  أَبُو الْيَمَانِ الْحَكَمُ بْنُ نَافِعٍ ،  أَخْبَرَنِي  شُعَيْبُ بْنُ أَبِي حَمْزَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  عَنْ  أُمِّ حَبِيبَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أُرِيتُ مَا يَلْقَى أُمَّتِي مِنْ بَعْدِي مِنْ  سَفْكِ  بَعْضِهِمْ دَمَ بَعْضٍ  ، فَسَأَلْتُهُ أَنْ         [23/222]      يُوَلِّيَنِي فِيهِمْ شَفَاعَةَ يَوْمِ الْقِيَامَةِ ، فَفَعَلَ "" .","","Al-Mu'jam al-Kabir 409","","رملة بنت أبي سفيان زوج رسول الله عن أنس بن مالك عن الزهري عن شعيب بن أبي حمزة الحمصي عن أبو اليمان الحكم بن نافع عن أبو زرعة الدمشقي عن الطبراني","ما روى أنس بن مالك عن أم حبيبة"
"21010","410  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  أَبُو الْيَمَانِ ،  أَنَا  شُعَيْبُ بْنُ أَبِي حَمْزَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي حُسَيْنٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  عَنْ  أُمِّ حَبِيبَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أُرِيتُ مَا يَلْقَى أُمَّتِي مِنْ بَعْدِي وَسَفْكِ دِمَائِهَا  ، فَسَأَلْتُ اللهَ أَنْ يُوَلِّيَنِي فِيهِمْ شَفَاعَةً ، فَفَعَلَ "" .","","Al-Mu'jam al-Kabir 410","","رملة بنت أبي سفيان زوج رسول الله عن أنس بن مالك عن عبد الله بن عبد الرحمن بن أبي حسين النوفلي عن شعيب بن أبي حمزة الحمصي عن أبو اليمان الحكم بن نافع عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","ما روى أنس بن مالك عن أم حبيبة"
"21011","411  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ،  ثَنَا  عُبَيْدُ بْنُ إِسْحَاقَ الْعَطَّارُ ،  ثَنَا  سِنَانُ بْنُ هَارُونَ الْبُرْجُمِيُّ ،  عَنْ  حُمَيْدٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  قَالَتْ  أُمُّ حَبِيبَةَ  : يَا رَسُولَ اللهِ الْمَرْأَةُ مِنَّا يَكُونُ لَهَا زَوْجَانِ ثُمَّ تَمُوتُ فَتَدْخُلُ الْجَنَّةَ هِيَ وَزَوْجَاهَا ، لِأَيِّهِمَا تَكُونُ لِلْأَوَّلِ أَوْ لِلْآخَرِ ؟ قَالَ :  تَخَيَّرُ أَحْسَنَهُمَا  خُلُقًا  كَانَ مَعَهَا فِي الدُّنْيَا يَكُونُ زَوْجَهَا فِي الْجَنَّةِ  يَا  أُمَّ حَبِيبَةَ  ، ذَهَبَ حُسْنُ  الْخُلُقِ  بِخَيْرِ الدُّنْيَا وَالْآخِرَةِ  .","","Al-Mu'jam al-Kabir 411","","أنس بن مالك عن حميد الطويل عن سنان بن هارون البرجمي عن عبيد بن إسحاق عطار المطلقات عن لحية الليف محمد بن العباس عن الطبراني","ما روى أنس بن مالك عن أم حبيبة"
"21012","زَيْنَبُ بِنْتُ أَبِي سَلَمَةَ  عَنْ  أُمِّ حَبِيبَةَ  .  عُرْوَةُ  عَنْ  زَيْنَبَ  .  412  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ الْمِصْرِيُّ ،  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  يُونُسُ ،  عَنِ  ابْنِ شِهَابٍ ، أَنَّ عُرْوَةَ بْنَ الزُّبَيْرِ         [23/223]      حَدَّثَهُ  ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  أَنَّ  أُمَّ حَبِيبَةَ ، قَالَتْ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : انْكِحْ بِنْتَ  أَبِي سُفْيَانَ  لِأُخْتِهَا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" أَوَ تُحِبِّينَ ذَلِكَ ؟ "" ، قَالَتْ : نَعَمْ ، لَسْتُ لَكَ  بِمُخْلِيَةٍ  ، وَأَحَبُّ مَنْ شَارَكَنِي فِي خَيْرٍ أُخْتِي ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" فَإِنَّ ذَلِكَ لَا يَحِلُّ "" ، قَالَتْ  أُمُّ حَبِيبَةَ  : يَا رَسُولَ اللهِ لَقَدْ تُحَدِّثَ أَنَّكَ نَاكِحٌ  دُرَّةَ بِنْتَ أَبِي سَلَمَةَ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" بِنْتَ  أُمِّ سَلَمَةَ  ؟ "" ، قَالَتْ  أُمُّ حَبِيبَةَ  : نَعَمْ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَوْ أَنَّهَا لَمْ تَكُنْ رَبِيبَتِي فِي حَجْرِي مَا حَلَّتْ ، لِأَنَّهَا بِنْتُ أَخِي مِنَ الرَّضَاعَةِ  ، أَرْضَعَتْنِي أَنَا  وَأَبَا سَلَمَةَ  ثُوَيْبَةُ  ، فَلَا تَعْرِضْنَ عَلَيَّ بَنَاتِكِ وَلَا أَخَوَاتِكُ  .","","Al-Mu'jam al-Kabir 412","","رملة بنت أبي سفيان زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل بن الحسن الخفاف المصري عن الطبراني","عروة عن زينب"
"21013","413  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ سَعْدِ بْنِ إِبْرَاهِيمَ بْنِ سَعْدٍ ،  ثَنَا  عَمِّي يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ مُسْلِمِ بْنِ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ مُحَمَّدِ بْنِ مُسْلِمِ بْنِ شِهَابٍ ، قَالَ :  أَخْبَرَنِي  عُرْوَةُ بْنُ الزُّبَيْرِ ، أَنَّ زَيْنَبَ بِنْتَ أَبِي سَلَمَةَ  أَخْبَرَتْهُ  ،  أَنَّ أُمَّ حَبِيبَةَ - زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَخْبَرَتْهَا  ، أَنَّهَا قَالَتْ : يَا رَسُولَ اللهِ انْكِحْ أُخْتِي بِنْتَ  أَبِي سُفْيَانَ  ، فَزَعَمَتْ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ لَهَا : "" أَوَ تُحِبِّينَ ذَلِكَ ؟ "" ، قَالَتْ : نَعَمْ ، يَا رَسُولَ اللهِ ، لَسْتُ لَكَ  بِمُخْلِيَةٍ  وَأَحَبُّ مَنْ شَرِكَنِي فِي خَيْرٍ أُخْتِي ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" إِنَّ ذَلِكَ لَا يَحِلُّ لِي "" ، قُلْتُ : يَا رَسُولَ اللهِ إِنَّا لَنَتَحَدَّثُ أَنَّكَ تُرِيدُ أَنْ تَنْكِحَ  دُرَّةَ بِنْتَ أَبِي سَلَمَةَ  ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  بِنْتَ أَبِي سَلَمَةَ  ؟ "" ، قَالَتْ : نَعَمْ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  فَأَيْمُ اللهِ لَوْ         [23/224]      أَنَّهَا لَمْ تَكُنْ رَبِيبَتِي فِي حِجْرِي لَمَا حَلَّتْ لِي  ، لِأَنَّهَا بِنْتُ أَخِي مِنَ الرَّضَاعَةِ أَرْضَعَتْنِي ،  وَأَبَا سَلَمَةَ  ثُوَيْبَةُ  ، فَلَا تَعْرِضْنَ عَلَيَّ بَنَاتِكُنَّ ، وَلَا أَخَوَاتِكُنَّ  .","","Al-Mu'jam al-Kabir 413","","رملة بنت أبي سفيان زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن عبيد الله بن سعد بن إبراهيم الزهري عن أحمد بن يحيى بن زهير التستري عن الطبراني","عروة عن زينب"
"21014","414  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  قَالَ  عُرْوَةُ بْنُ الزُّبَيْرِ :  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  أَنَّ  أُمَّ حَبِيبَةَ - زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ : يَا رَسُولَ اللهِ انْكِحْ أُخْتِي بِنْتَ  أَبِي سُفْيَانَ  ، فَقَالَ لَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" أَوَ تُحِبِّينَ ذَلِكَ ؟ "" ، قَالَتْ : مَا أَنَا  بِمُخْلِيَةٍ  ، وَخَيْرُ مَنْ شَرِكَنِي فِي خَيْرٍ أُخْتِي ، قَالَ : "" إِنَّ ذَلِكَ لَا يَحِلُّ لِي "" ، قَالَتْ : فَوَاللهِ إِنَّا لَنُحَدَّثُ أَنَّكَ تُرِيدُ أَنْ تَنْكِحَ  دُرَّةَ بِنْتَ أَبِي سَلَمَةَ  ، قَالَ : "" بِنْتَ  أُمِّ سَلَمَةَ  ؟ "" ، قَالَتْ : نَعَمْ ، قَالَ :  فَوَاللهِ لَوْ لَمْ تَكُنْ رَبِيبَتِي مَا حَلَّتْ لِي ، إِنَّهَا لَابْنَةُ أَخِي مِنَ الرَّضَاعَةِ  ، لَقَدْ أَرْضَعَتْنِي وَإِيَّاهَا  ثُوَيْبَةُ  ، فَلَا تَعْرِضْنَ عَلَيَّ بَنَاتِكُنَّ ، وَلَا أَخَوَاتِكُنَّ  .","","Al-Mu'jam al-Kabir 414","","رملة بنت أبي سفيان زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عروة عن زينب"
"21015","415  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  ابْنُ عَائِشَةَ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ حَبِيبَةَ ، أَنَّهَا قَالَتْ :  يَا رَسُولَ اللهِ هَلْ لَكَ فِي  حَمْنَةَ بِنْتِ أَبِي سُفْيَانَ  ، قَالَ : "" أَصْنَعُ مَاذَا ؟ "" ، قَالَتْ : تَنْكِحُهَا ، قَالَ : "" فَهَلْ تَحِلُّ لِي ؟ "" ، قَالَتْ : وَاللهِ لَقَدْ أُخْبِرْتُ أَنَّكَ تَخْطُبُ  زَيْنَبَ بِنْتَ أَبِي سَلَمَةَ  ، قَالَ :  أَرَبِيبَتِي فِي  حِجْرِي  فَوَاللهِ لَوْ لَمْ تَكُنْ رَبِيبَتِي فِي حِجْرِي إِنَّهَا لَابْنَةُ أَخِي  ، أَرْضَعَتْنِي وَإِيَّاهَا  ثُوَيْبَةُ  ، فَلَا تَعْرِضْنَ عَلَيَّ بَنَاتِكُنَّ وَلَا أَخَوَاتِكُنَّ وَلَا أُمَّهَاتِكُنَّ  .","","Al-Mu'jam al-Kabir 415","","رملة بنت أبي سفيان زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن ابن عائشة عن أبو مسلم الكجي عن الطبراني","عروة عن زينب"
"21016","416  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  أَنَّ  أُمَّ حَبِيبَةَ ، قَالَتْ : يَا رَسُولَ اللهِ ، فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 416","","رملة بنت أبي سفيان زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عروة عن زينب"
"21017","[23/225]      417  -  حَدَّثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ حَبِيبَةَ ، قَالَتْ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقُلْتُ : هَلْ لَكَ فِي أُخْتِي  بِنْتِ أَبِي سُفْيَانَ  ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" فَأَفْعَلُ مَاذَا ؟ "" ، قُلْتُ : فَتَنْكِحُهَا ، قَالَ : "" أُخْتَكِ ؟ "" ، قُلْتُ : نَعَمْ ، قَالَ : "" أَوَ تُحِبِّينَ ذَلِكَ ؟ "" ، قُلْتُ : نَعَمْ ، لَسْتُ  بِمُخْلِيَةٍ  ، وَأَحَبُّ مَنْ شَرِكَنِي فِي خَيْرٍ أُخْتِي ، قَالَ : "" إِنَّهَا لَا تَحِلُّ لِي "" ، قُلْتُ : وَاللهِ لَقَدْ أُنْبِئْتُ أَنَّكَ تَخْطُبُ  بِنْتَ أَبِي سَلَمَةَ  ، قَالَ : ""  بِنْتَ أَبِي سَلَمَةَ  ؟ "" ، قُلْتُ : نَعَمْ ، قَالَ :  وَاللهِ لَوْ لَمْ تَكُنْ رَبِيبَتِي فِي  حِجْرِي  مَا حَلَّتْ لِي ، إِنَّهَا بِنْتُ أَخِي مِنَ الرَّضَاعَةِ  ، أَرْضَعَتْنِي وَإِيَّاهَا  ثُوَيْبَةُ  فَلَا تَعْرِضْنَ عَلَيَّ بَنَاتِكُنَّ وَأَخَوَاتِكُنَّ  .","","Al-Mu'jam al-Kabir 417","","رملة بنت أبي سفيان زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن عبد الله بن أويس عن إسماعيل بن أبي أويس عن علي بن محمد بن عبد الله الصنعاني عن الطبراني","عروة عن زينب"
"21018","418  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  ابْنُ جُرَيْجٍ ، وَمَعْمَرٌ ، قَالَا :  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ حَبِيبَةَ ، قَالَتْ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقُلْتُ : هَلْ لَكَ فِي أُخْتِي  بِنْتِ أَبِي سُفْيَانَ  ؟ قَالَ : "" أَفْعَلُ مَاذَا ؟ "" ، قُلْتُ : تَنْكِحُهَا ، قَالَ : "" أُخْتَكِ ؟ "" ، قُلْتُ : نَعَمْ ، قَالَ : "" أَوَ تُحِبِّينَ ذَلِكَ ؟ "" ، قُلْتُ : نَعَمْ ، لَسْتُ لَكَ  بِمُخْلِيَةٍ  وَأَحَبُّ - أَوْ قَالَتْ : - وَأَحَقُّ  مَنْ شَرِكَنِي فِي خَيْرٍ أُخْتِي ، قَالَ : "" فَإِنَّهَا لَا تَحِلُّ لِي "" ، قَالَتْ : فَوَاللهِ لَقَدْ أُخْبِرْتُ أَنَّكَ تَخْطُبُ  دُرَّةَ بِنْتَ أَبِي سَلَمَةَ  ، قَالَ : "" بِنْتَ  أَبِي سَلَمَةَ  ؟ "" ، قُلْتُ : نَعَمْ ، قَالَ :  فَوَاللهِ لَوْ لَمْ تَكُنْ رَبِيبَتِي فِي  حَجْرِي  مَا حَلَّتْ لِي إِنَّهَا ابْنَةُ أَخِي مِنَ الرَّضَاعَةِ  ، أَرْضَعَتْنِي وَإِيَّاهَا  ثُوَيْبَةُ  ، فَلَا تَعْرِضْنَ عَلَيَّ بَنَاتِكُنَّ وَلَا أَخَوَاتِكُنَّ  .","","Al-Mu'jam al-Kabir 418","","رملة بنت أبي سفيان زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عروة عن زينب"
"21019","عِرَاكُ بْنُ مَالِكٍ  عَنْ  زَيْنَبَ  .  419  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،         [23/226]      حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي حَبِيبٍ ،  عَنْ  عِرَاكِ بْنِ مَالِكٍ ، أَنَّ زَيْنَبَ بِنْتَ أَبِي سَلَمَةَ  أَخْبَرَتْهُ  ،  أَنَّ  أُمَّ حَبِيبَةَ قَالَتْ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّا قَدْ تَحَدَّثْنَا أَنَّكَ نَاكِحٌ  دُرَّةَ بِنْتَ أَبِي سَلَمَةَ  ، فَقَالَ : "" أَهْلِي  أُمُّ سَلَمَةَ  ؟  لَوْ لَمْ أَنْكِحْ  أُمَّ سَلَمَةَ  مَا حَلَّتْ لِي إِنَّ أَبَاهَا أَخِي مِنَ الرَّضَاعَةِ  .","","Al-Mu'jam al-Kabir 419","","رملة بنت أبي سفيان زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عراك بن مالك الغفاري عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","عراك بن مالك عن زينب"
"21020","حُمَيْدُ بْنُ نَافِعٍ  [ عَنْ  زَيْنَبَ  ] .  420  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ، (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  الْقَعْنَبِيُّ ، (  ح  ) .  وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ، كُلُّهُمْ  عَنْ  مَالِكِ بْنِ أَنَسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرٍ ،  عَنْ  حُمَيْدِ بْنِ نَافِعٍ ، أَنَّ زَيْنَبَ بِنْتَ أَبِي سَلَمَةَ  أَخْبَرَتْهُ  ،  أَنَّهَا دَخَلَتْ عَلَى أُمِّ حَبِيبَةَ بِنْتِ أَبِي سُفْيَانَ - زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ تُوُفِّيَ [ أَبُوهَا ]  أَبُو سُفْيَانَ  ، فَدَعَتْ  أُمُّ حَبِيبَةَ  بِطِيبٍ فِيهِ صُفْرَةٌ خَلُوقٌ أَوْ غَيْرُهُ ، فَدَهَنَتْ مِنْهُ  جَارِيَةً  ، ثُمَّ مَسَّتْ  بِعَارِضَيْهَا  ، ثُمَّ قَالَتْ : أَمَا وَاللهِ مَا لِي بِالطِّيبِ مِنْ حَاجَةٍ ، غَيْرَ أَنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا يَحِلُّ لِامْرَأَةٍ تُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ  تُحِدُّ  عَلَى مَيِّتٍ فَوْقَ ثَلَاثِ لَيَالٍ  إِلَّا عَلَى زَوْجٍ أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا  .","","Al-Mu'jam al-Kabir 420","","رملة بنت أبي سفيان زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن حميد بن نافع حميد صفيرا عن عبد الله بن أبي بكر بن محمد  ابن حزم عن مالك بن أنس عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","حميد بن نافع عن زينب"
"21021","421  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ، قَالَ :  حَدَّثَنِي  حُمَيْدُ بْنُ         [23/227]      نَافِعٍ ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ حَبِيبَةَ بِنْتِ أَبِي سُفْيَانَ ،  أَنَّهُ لَمَّا جَاءَ نَعْيُ أَبِيهَا دَعَتْ بِطِيبٍ فَمَسَحَتْ بِهِ ذِرَاعَيْهَا ، وَقَالَتْ : وَاللهِ مَا لِي بِالطِّيبِ مِنْ حَاجَةٍ ، لَوْلَا أَنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا يَحِلُّ لِامْرَأَةٍ تُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ  تُحِدُّ  عَلَى مَيِّتٍ فَوْقَ ثَلَاثِ لَيَالٍ  إِلَّا عَلَى زَوْجٍ أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا  .","","Al-Mu'jam al-Kabir 421","","رملة بنت أبي سفيان زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن حميد بن نافع حميد صفيرا عن عبد الله بن أبي بكر بن محمد  ابن حزم عن سفيان الثوري عن محمد بن كثير العبدي عن أبو مسلم الكجي عن الطبراني","حميد بن نافع عن زينب"
"21022","422  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  أَيُّوبُ بْنُ مُوسَى ،  عَنْ  حُمَيْدِ بْنِ نَافِعٍ ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ حَبِيبَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا يَحِلُّ لِامْرَأَةٍ تُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ أَنْ  تُحِدَّ  عَلَى مَيِّتٍ فَوْقَ ثَلَاثِ لَيَالٍ  إِلَّا عَلَى زَوْجٍ أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا  .","","Al-Mu'jam al-Kabir 422","","رملة بنت أبي سفيان زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن حميد بن نافع حميد صفيرا عن أيوب بن موسى الأموي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","حميد بن نافع عن زينب"
"21023","423  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  أَيُّوبَ بْنِ مُوسَى ،  عَنْ  حُمَيْدِ بْنِ نَافِعٍ ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ حَبِيبَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا يَحِلُّ لِامْرَأَةٍ تُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ أَنْ  تُحِدَّ  عَلَى مَيِّتٍ فَوْقَ ثَلَاثِ لَيَالٍ  إِلَّا عَلَى زَوْجٍ "" .","","Al-Mu'jam al-Kabir 423","","رملة بنت أبي سفيان زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن حميد بن نافع حميد صفيرا عن أيوب بن موسى الأموي عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن أبو مسلم الكجي عن الطبراني","حميد بن نافع عن زينب"
"21024","424  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  شُعْبَةَ ،  عَنْ  حُمَيْدِ بْنِ نَافِعٍ ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ حَبِيبَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا يَحِلُّ لِامْرَأَةٍ تُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ أَنْ  تُحِدَّ  عَلَى مَيِّتٍ فَوْقَ ثَلَاثٍ  إِلَّا عَلَى زَوْجٍ "" .","","Al-Mu'jam al-Kabir 424","","رملة بنت أبي سفيان زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن حميد بن نافع حميد صفيرا عن شعبة بن الحجاج عن يحيى القطان عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","حميد بن نافع عن زينب"
"21025","425  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، (  ح  ) .         [23/228]      وَحَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي عَوْنٍ أَبُو عَوْنٍ الزِّيَادِيُّ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  أَخْبَرَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  حُمَيْدِ بْنِ نَافِعٍ ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، وَأُمِّ حَبِيبَةَ ،  أَنَّ  امْرَأَةً  قَالَتْ : يَا رَسُولَ اللهِ إِنَّ ابْنَتِي تُوُفِّيَ عَنْهَا زَوْجُهَا وَقَدْ خَشِيتُ عَلَى بَصَرِهَا أَفَأَكْحُلُهَا ؟ قَالَ :  كَانَتْ إِحْدَاكُنَّ تَرْمِي بِالْبَعْرَةِ عَلَى رَأْسِ الْحَوْلِ  وَإِنَّمَا هِيَ أَرْبَعَةُ أَشْهُرٍ وَعَشْرًا  .","","Al-Mu'jam al-Kabir 425","","رملة بنت أبي سفيان زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن حميد بن نافع حميد صفيرا عن يحيى بن سعيد الأنصاري عن حماد بن سلمة عن محمد بن عون الزيادي عن أحمد بن عمرو بن حفص القريعي عن الطبراني","حميد بن نافع عن زينب"
"21026","426  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  حُمَيْدِ بْنِ نَافِعٍ ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  أَنَّ  امْرَأَةً  ،  سَأَلَتْ  أُمَّ سَلَمَةَ ، وَأُمَّ حَبِيبَةَ : أَتَكْتَحِلُ الْمَرْأَةُ فِي عِدَّتِهَا مِنْ وَفَاةِ زَوْجِهَا ؟ فَقَالَتْ : أَتَتِ  امْرَأَةٌ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَأَلَتْهُ عَنْ ذَلِكَ ، فَقَالَ :  كَانَتْ إِحْدَاكُنَّ فِي الْجَاهِلِيَّةِ إِذَا تُوُفِّيَ عَنْهَا زَوْجُهَا أَقَامَتْ سَنَةً  ، ثُمَّ تَقْذِفُ بِبَعْرَةٍ ، فَإِنَّمَا هِيَ أَرْبَعَةُ أَشْهُرٍ وَعَشْرًا حَتَّى يَمْضِيَ الْأَجَلُ  .","","Al-Mu'jam al-Kabir 426","","رملة بنت أبي سفيان زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن حميد بن نافع حميد صفيرا عن يحيى بن سعيد الأنصاري عن حماد بن زيد عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","حميد بن نافع عن زينب"
"21027","427  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  حُمَيْدِ بْنِ نَافِعٍ ،  أَنَّهُ سَمِعَ  زَيْنَبَ بِنْتَ أَبِي سَلَمَةَ ، تَقُولُ :  سَمِعْتُ  أُمَّ سَلَمَةَ  ، وَأُمَّ حَبِيبَةَ  تَذْكُرَانِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قِصَّةَ الْعِدَّةِ  .","","Al-Mu'jam al-Kabir 427","","رملة بنت أبي سفيان زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن حميد بن نافع حميد صفيرا عن يحيى بن سعيد الأنصاري عن يزيد بن هارون عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","حميد بن نافع عن زينب"
"21028","عَبْدُ اللهِ بْنُ عُتْبَةَ بْنِ أَبِي سُفْيَانَ  عَنْ  أُمِّ حَبِيبَةَ  .  428  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،         [23/229]      أَخْبَرَنَا  شُعْبَةُ ،  عَنْ  أَبِي بِشْرٍ ، قَالَ :  سَمِعْتُ  أَبَا الْمَلِيحِ ،  يُحَدِّثُ ، عَنْ  عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  أُمِّ حَبِيبَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ : "" إِذَا سَمِعَ الْمُؤَذِّنَ قَالَ كَمَا يَقُولُ حَتَّى يَسْكُتَ  .","","Al-Mu'jam al-Kabir 428","","رملة بنت أبي سفيان زوج رسول الله عن عبد الله بن عتبة بن أبي سفيان الأموي عن أبو المليح بن أسامة الهذلي عن جعفر بن إياس اليشكري عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن عتبة بن أبي سفيان عن أم حبيبة"
"21029","عَنْبَسَةُ بْنُ أَبِي سُفْيَانَ  عَنْ  أُمِّ حَبِيبَةَ  .  430  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَمْرُو بْنُ عَوْنٍ الْوَاسِطِيُّ ،  ثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُحَمَّدُ بْنُ سَعِيدٍ الْأَصْبَهَانِيُّ ،  ثَنَا  عَبِيدَةُ بْنُ حُمَيْدٍ ، وَمُحَمَّدُ بْنُ فُضَيْلٍ ، كُلُّهُمْ  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدَ ،  عَنِ  النُّعْمَانِ بْنِ سَالِمٍ ،  عَنْ  عَمْرِو بْنِ أَوْسٍ ، قَالَ : دَخَلْتُ عَلَى  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ، قَالَ :  حَدَّثَتْنِي  أُمُّ حَبِيبَةَ بِنْتُ أَبِي سُفْيَانَ  ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ صَلَّى فِي يَوْمٍ اثْنَتَيْ عَشْرَةَ رَكْعَةً بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  .  قَالَتْ  أُمُّ حَبِيبَةَ  : مَا تَرَكْتُهُنَّ مُنْذُ سَمِعْتُهُنَّ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .  قَالَ  عَمْرٌو  : مَا تَرَكْتُهُنَّ مُنْذُ سَمِعْتُهُنَّ مِنْ  عَنْبَسَةَ  .  وَاللَّفْظُ  لِعَمْرِو بْنِ عَوْنٍ  "" .","","Al-Mu'jam al-Kabir 430","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن عمرو بن أوس بن أبي أوس الثقفي عن النعمان بن سالم الطائفي عن داود بن أبي هند عن محمد بن فضيل بن غزوان عن محمد بن سعيد حمدان عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21030","431  -  حَدَّثَنَا  أَبُو مُسْلِمٍ ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  شُعْبَةُ ،  عَنِ  النُّعْمَانِ بْنِ سَالِمٍ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ ، قَالَتْ : سَمِعْتُ         [23/230]      رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ صَلَّى فِي يَوْمٍ اثْنَتَيْ عَشْرَةَ رَكْعَةً بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 431","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن النعمان بن سالم الطائفي عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن أبو مسلم الكجي عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21031","432  -  حَدَّثَنَا  أَبُو يَزِيدَ يُوسُفُ بْنُ يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  النَّضْرُ بْنُ عَبْدِ الْجَبَّارِ أَبُو الْأَسْوَدِ ،  ثَنَا  بَكْرُ بْنُ مُضَرَ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ أَوْسٍ الثَّقَفِيِّ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  - زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهِيَ أُخْتُهُ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  ثِنْتَا عَشْرَةَ رَكْعَةً مَنْ صَلَّاهُنَّ بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  : أَرْبَعَ رَكَعَاتٍ قَبْلَ الظُّهْرِ ، وَرَكْعَتَيْنِ بَعْدَ الظُّهْرِ ، وَرَكْعَتَيْنِ قَبْلَ الْعَصْرِ ، وَرَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ ، وَرَكْعَتَيْنِ قَبْلَ الصُّبْحِ  .","","Al-Mu'jam al-Kabir 432","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن عمرو بن أوس بن أبي أوس الثقفي عن أبو إسحاق السبيعي عن محمد بن عجلان عن بكر بن مضر المصري عن النضر بن عبد الجبار المرادي عن يوسف بن يزيد القراطيسي عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21032","433  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  أَبِي إِسْحَاقَ الْهَمْدَانِيِّ ،  عَنْ  عَمْرِو بْنِ أَوْسٍ الثَّقَفِيِّ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ صَلَّى اثْنَتَيْ عَشْرَةَ رَكْعَةً فِي يَوْمٍ بَنَى اللهُ لَهُ بِهَا بَيْتًا فِي الْجَنَّةِ  : أَرْبَعَ رَكَعَاتٍ قَبْلَ الظُّهْرِ ، وَرَكْعَتَيْنِ بَعْدَ الظُّهْرِ ، وَرَكْعَتَيْنِ قَبْلَ الْعَصْرِ ، وَرَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ ، وَرَكْعَتَيْنِ قَبْلَ الصُّبْحِ  .","","Al-Mu'jam al-Kabir 433","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن عمرو بن أوس بن أبي أوس الثقفي عن أبو إسحاق السبيعي عن محمد بن عجلان عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21033","434  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  سَالِمِ بْنِ مُنْقِذٍ ،  عَنْ  عَمْرِو بْنِ أَوْسٍ الثَّقَفِيِّ ، قَالَ : دَخَلْتُ عَلَى  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ وَهُوَ يَنْزِعُ ، فَقَالَ : إِنِّي  مُحَدِّثُكَ  حَدِيثًا  حَدَّثَتْنِيهِ  أُمُّ حَبِيبَةَ بِنْتُ أَبِي سُفْيَانَ  ، حَدَّثَتْنِي ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ صَلَّى اثْنَتَيْ عَشْرَةَ رَكْعَةً مَعَ صَلَاةِ النَّهَارِ بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 434","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن عمرو بن أوس بن أبي أوس الثقفي عن سالم بن منقذ عن عبد الملك بن عمير القبطي عن جرير بن حازم عن شيبان بن فروخ الحبطي عن موسى بن هارون الحمال عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21034","[23/231]      435  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ الْجُنْدَيْسَابُورِيُّ ،  ثَنَا  مَحْمُودُ بْنُ عَلَّانَ الْمَرْوَزِيُّ ،  ثَنَا  مُؤَمَّلُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ صَلَّى فِي يَوْمٍ وَلَيْلَةٍ اثْنَتَيْ عَشْرَةَ رَكْعَةً بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  : أَرْبَعًا قَبْلَ الظُّهْرِ ، وَرَكْعَتَيْنِ بَعْدَهَا ، وَرَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ ، وَرَكْعَتَيْنِ بَعْدَ الْعِشَاءِ ، وَرَكْعَتَيْنِ قَبْلَ صَلَاةِ الْغَدَاةِ  .","","Al-Mu'jam al-Kabir 435","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن المسيب بن رافع الكاهلي عن أبو إسحاق السبيعي عن سفيان الثوري عن مؤمل بن إسماعيل العدوي عن محمود بن غيلان المروزي عن محمد بن جابان الجند يسابوري عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21035","436  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ، وَيَعْلَى بْنُ عُبَيْدٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ صَلَّى فِي يَوْمٍ وَلَيْلَةٍ اثْنَتَيْ عَشْرَةَ رَكْعَةً سِوَى الْمَكْتُوبَةِ  بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 436","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن المسيب بن رافع الكاهلي عن إسماعيل بن أبي خالد عن يعلى بن عبيد الطنافسي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21036","437  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَبَانَ ،  عَنْ  سُلَيْمَانَ بْنِ قَيْسٍ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ صَلَّى فِي يَوْمٍ ثِنْتَيْ عَشْرَةَ رَكْعَةً بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  ، وَمَنْ بَنَى لِلهِ مَسْجِدًا بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 437","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن سليمان بن قيس اليشكري عن أبان بن أبي عياش عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21037","438  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  عُمَرُ بْنُ السَّائِبِ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ الْجَفْرِيِّ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ صَلَّى فِي يَوْمٍ اثْنَتَيْ عَشْرَةَ رَكْعَةً بَنَى اللهُ         [23/232]      لَهُ بَيْتًا فِي الْجَنَّةِ  : أَرْبَعَ رَكَعَاتٍ قَبْلَ الظُّهْرِ ، وَرَكْعَتَيْنِ بَعْدَ الظُّهْرِ ، وَرَكْعَتَيْنِ قَبْلَ الْعَصْرِ ، وَرَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ ، وَرَكْعَتَيْنِ بَعْدَ الْعِشَاءِ  .","","Al-Mu'jam al-Kabir 438","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن عبد الله بن عبد الرحمن الجفري عن أسامة بن زيد بن حارثة ذو البطين عن عمر بن السائب بن أبي راشد المصري عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21038","439  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  قُتَيْبَةُ بْنُ سَعِيدٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ صَلَّى اثْنَتَيْ عَشْرَةَ رَكْعَةً فِي لَيْلِهِ وَنَهَارِهِ غَيْرَ الْمَكْتُوبَةِ  بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 439","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن عطاء بن أبي رباح عن عبد الله بن لهيعة عن قتيبة بن سعيد عن موسى بن هارون الحمال عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21039","440  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى بْنِ خَالِدِ بْنِ حَيَّانَ الرَّقِّيُّ ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ (  ح  ) .  وَحَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ،  ثَنَا  قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَا :  ثَنَا  مُفَضَّلُ بْنُ فَضَالَةَ ،  عَنْ  خَالِدِ بْنِ يَزِيدَ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ صَلَّى اثْنَتَيْ عَشْرَةَ رَكْعَةً غَيْرَ الْمَكْتُوبَةِ بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 440","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن عطاء بن أبي رباح عن خالد بن يزيد الجمحي عن المفضل بن فضالة عن قتيبة بن سعيد عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21040","441  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  الْهَيْثَمُ بْنُ حُمَيْدٍ ،  أَنَا  النُّعْمَانُ بْنُ الْمُنْذِرِ ،  عَنْ  مَكْحُولٍ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ ،  أَنَّهَا أَخْبَرَتْهُ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ حَافَظَ عَلَى أَرْبَعِ رَكَعَاتٍ قَبْلَ صَلَاةِ  الْهَجِيرِ  ، وَأَرْبَعٍ بَعْدَهَا حُرِّمَ عَلَى  جَهَنَّمَ  .","","Al-Mu'jam al-Kabir 441","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن مكحول بن أبي مسلم عن النعمان بن المنذر الغساني عن الهيثم بن حميد الغساني عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21041","[23/233]      442  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  يَحْيَى بْنُ حَمْزَةَ ،  عَنِ  النُّعْمَانِ بْنِ الْمُنْذِرِ ،  عَنْ  مَكْحُولٍ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  أَخْبَرَتْهُ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ :  مَنْ حَافَظَ عَلَى أَرْبَعِ رَكَعَاتٍ قَبْلَ الظُّهْرِ  ، وَأَرْبَعٍ بَعْدَهَا حَرَّمَهُ اللهُ عَلَى النَّارِ  .","","Al-Mu'jam al-Kabir 442","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن مكحول بن أبي مسلم عن النعمان بن المنذر الغساني عن يحيى بن حمزة بن البتلهي عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21042","443  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  عُبَيْدُ بْنُ يَعِيشَ ،  ثَنَا  خَالِدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ بْنِ جَابِرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  مَكْحُولٍ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ حَافَظَ عَلَى أَرْبَعِ رَكَعَاتٍ قَبْلَ صَلَاةِ  الْهَجِيرِ  ، وَأَرْبَعٍ بَعْدَهَا حُرِّمَ عَلَى  جَهَنَّمَ  .","","Al-Mu'jam al-Kabir 443","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن مكحول بن أبي مسلم عن عبد الرحمن بن يزيد الداراني عن خالد بن عبد الرحمن بن يزيد بن جابر عن عبيد بن يعيش عن محمد بن عثمان بن أبي شيبة عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21043","444  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْرَائِيلَ بْنِ يُونُسَ ،  عَنْ  مُحَمَّدِ بْنِ عُبَيْدِ اللهِ بْنِ الْمُهَاجِرِ  ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، أَنَّهَا سَمِعَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ صَلَّى أَرْبَعَ رَكَعَاتٍ قَبْلَ الظُّهْرِ حَرَّمَ اللهُ عَلَيْهِ النَّارَ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( بن عبد الله )","","Al-Mu'jam al-Kabir 444","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن محمد بن عبد الله بن المهاجر الشعيثي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21044","445  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِي ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ اللهِ الشُّعَيْثِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ صَلَّى أَرْبَعَ رَكَعَاتٍ قَبْلَ الظُّهْرِ  ، وَأَرْبَعًا بَعْدَهَا حَرَّمَهُ اللهُ عَلَى النَّارِ  .","","Al-Mu'jam al-Kabir 445","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن عبد الله بن المهاجر الشعيثي عن محمد بن عبد الله بن المهاجر الشعيثي عن عبد الله بن يزيد القصير عن بشر بن موسى بن صالح الأسدي عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21045","446  -  حَدَّثَنَا  سَلَامَةُ بْنُ نَاهِضٍ الْمَقْدِسِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ هَانِي         [23/234]      بْنِ عَبْدِ الرَّحْمَنِ ،  ثَنَا  أَبِي  ،  ثَنَا  إِبْرَاهِيمُ بْنُ أَبِي عَبْلَةَ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ صَلَّى قَبْلَ الظُّهْرِ أَرْبَعَ رَكَعَاتٍ حَرَّمَ اللهُ جَسَدَهُ عَلَى النَّارِ  .","","Al-Mu'jam al-Kabir 446","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن إبراهيم بن أبي عبلة عن هانئ بن عبد الرحمن بن أبي عبلة الفلسطيني عن عبد الله بن هانئ المقدسي عن سلام بن محمد بن ناهض الترياقي عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21046","447  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  الْهَيْثَمُ بْنُ حُمَيْدٍ ،  ثَنَا  الْعَلَاءُ بْنُ الْحَارِثِ ،  عَنْ  مَكْحُولٍ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، أَنَّهَا سَمِعَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ مَسَّ فَرْجَهُ فَلْيَتَوَضَّأْ  .","","Al-Mu'jam al-Kabir 447","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن مكحول بن أبي مسلم عن العلاء بن الحارث الرمادي عن الهيثم بن حميد الغساني عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21047","448  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  عَنْ  مُحَمَّدِ بْنِ سَعِيدٍ الطَّائِفِيِّ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ، قَالَ :  حَدَّثَنِي  صَفْوَانُ بْنُ يَعْلَى بْنِ أُمَيَّةَ ، قَالَ :  قَدِمْتُ  الطَّائِفَ  عَلَى  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ وَهُوَ يَمُوتُ وَقَدْ جَزِعَ مِنْ ذَلِكَ ، فَقُلْنَا : أَبْشِرْ يَا  أَبَا عُثْمَانَ  فَإِنَّا نَرْجُو لَكَ ، فَقَالَ : أَمَا إِنَّ أُخْتِي أُمَّ حَبِيبَةَ - زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  حَدَّثَتْنِي  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ صَلَّى مِنْ لَيْلٍ أَوْ نَهَارٍ ثِنْتَيْ عَشْرَةَ رَكْعَةً سِوَى الْفَرِيضَةِ  بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ "" . فَمَا تَرَكْتُهُنَّ مُنْذُ سَمِعْتُهُنَّ  .","","Al-Mu'jam al-Kabir 448","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن صفوان بن يعلى بن أمية التميمي عن عطاء بن أبي رباح عن محمد بن سعيد الطائفي عن عبد الله بن رجاء البصري عن يعقوب بن حميد بن كاسب المدني عن عبد الله بن أحمد بن حنبل عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21048","449  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عُبَيْدُ بْنُ حُمَيْدٍ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدَ ،  عَنِ  النُّعْمَانِ بْنِ سَالِمٍ ،  عَنْ  عَمْرِو بْنِ أَوْسٍ ،  عَنْ         [23/235]      عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ صَلَّى فِي يَوْمٍ وَلَيْلَةٍ ثِنْتَيْ عَشْرَةَ رَكْعَةً بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 449","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن عمرو بن أوس بن أبي أوس الثقفي عن النعمان بن سالم الطائفي عن داود بن أبي هند عن عبيدة بن حميد بن صهيب التيمي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21049","450  -  حَدَّثَنَا  أَبُو زُرْعَةَ ،  ثَنَا  أَبُو مُسْهِرٍ ،  ثَنَا  الْهَيْثَمُ بْنُ حُمَيْدٍ ،  عَنِ  الْعَلَاءِ بْنِ الْحَارِثِ ،  عَنْ  مَكْحُولٍ ،  عَنْ  عَنْبَسَةَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ مَسَّ ذَكَرَهُ فَلْيَتَوَضَّأْ  .","","Al-Mu'jam al-Kabir 450","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن مكحول بن أبي مسلم عن العلاء بن الحارث الرمادي عن الهيثم بن حميد الغساني عن عبد الأعلى بن مسهر الغساني عن أبو زرعة الدمشقي عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21050","451  -  حَدَّثَنَا  مُحَمَّدُ بْنُ هَارُونَ بْنِ مُحَمَّدِ بْنِ بَكَّارٍ ،  ثَنَا  مَحْمُودُ بْنُ خَالِدٍ ،  ثَنَا  مَرْوَانُ بْنُ مُحَمَّدٍ ،  ثَنَا  الْهَيْثَمُ بْنُ حُمَيْدٍ ،  عَنِ  الْعَلَاءِ بْنِ الْحَارِثِ ،  عَنْ  مَكْحُولٍ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، قَالَتْ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ مَسَّ ذَكَرَهُ فَلْيَتَوَضَّأْ  .","","Al-Mu'jam al-Kabir 451","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن مكحول بن أبي مسلم عن العلاء بن الحارث الرمادي عن الهيثم بن حميد الغساني عن مروان بن محمد الطاطري عن محمود بن خالد بن أبي خالد السلمي عن محمد بن هارون بن محمد الدمشقي عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21051","452  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ ،  ثَنَا  مَحْمُودُ بْنُ خَالِدٍ ،  ثَنَا  مَرْوَانُ بْنُ مُحَمَّدٍ ،  ثَنَا  سَعِيدُ بْنُ عَبْدِ الْعَزِيزِ ،  عَنْ  سُلَيْمَانَ بْنِ مُوسَى ،  عَنْ  مَكْحُولٍ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ رَكَعَ أَرْبَعَ رَكَعَاتٍ قَبْلَ الظُّهْرِ  ، وَأَرْبَعَ رَكَعَاتٍ بَعْدَهَا ، حَرَّمَهُ اللهُ عَلَى النَّارِ  .","","Al-Mu'jam al-Kabir 452","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن مكحول بن أبي مسلم عن سليمان بن موسى الأشدق عن سعيد بن عبد العزيز التنوخي عن مروان بن محمد الطاطري عن محمود بن خالد بن أبي خالد السلمي عن أحمد بن المعلى الأسدي عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21052","453  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  الْهَيْثَمُ بْنُ حُمَيْدٍ ،  حَدَّثَنِي  الْعَلَاءُ بْنُ الْحَارِثِ ،  عَنِ  الْقَاسِمِ أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ صَلَّى أَرْبَعَ رَكَعَاتٍ قَبْلَ الظُّهْرِ  ، وَأَرْبَعًا بَعْدَهَا حَرَّمَهُ اللهُ عَلَى النَّارِ  .","","Al-Mu'jam al-Kabir 453","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن القاسم بن عبد الرحمن الدمشقي عن العلاء بن الحارث الرمادي عن الهيثم بن حميد الغساني عن عبد الله بن يوسف التنيسي عن يحيى بن عثمان بن صالح عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21053","[23/236]      454  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ هَاشِمٍ ،  ثَنَا  أَبِي  ،  ثَنَا  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ ،  عَنْ  حُصَيْنٍ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  ذَكْوَانَ أَبِي صَالِحٍ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ صَلَّى فِي يَوْمٍ ثِنْتَيْ عَشْرَةَ رَكْعَةً بُنِيَ لَهُ بَيْتٌ فِي الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 454","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن ذكوان السمان عن المسيب بن رافع الكاهلي عن حصين بن عبد الرحمن السلمي عن سويد بن عبد العزيز السلمي عن محمد بن هاشم البعلبكي عن أحمد بن محمد بن هاشم البعلبكي عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21054","455  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ، ثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 455","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن المسيب بن رافع الكاهلي عن إسماعيل بن أبي خالد عن يزيد بن هارون عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21055","456  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدِ بْنِ عُقْبَةَ الشَّيْبَانِيُّ ،  ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ،  ثَنَا  أَبُو عَاصِمٍ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ عَبْدِ الْعَزِيزِ ،  عَنْ  سُلَيْمَانَ بْنِ مُوسَى ،  عَنْ  مَكْحُولٍ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ، قَالَ :  أَخْبَرَتْنِي  أُخْتِي أُمُّ حَبِيبَةَ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ صَلَّى أَرْبَعَ رَكَعَاتٍ قَبْلَ الظُّهْرِ  ، وَأَرْبَعًا بَعْدَهَا حَرَّمَهُ اللهُ عَلَى النَّارِ  .","","Al-Mu'jam al-Kabir 456","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن مكحول بن أبي مسلم عن سليمان بن موسى الأشدق عن سعيد بن عبد العزيز التنوخي عن أبو عاصم النبيل عن الحسن بن علي الريحاني عن محمد بن محمد بن عقبة الشيباني عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21056","457  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  سُلَيْمَانَ بْنِ مُوسَى ،  عَنْ  مَكْحُولٍ ،  عَنْ  مَوْلًى لِعَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ ، أَنَّ النَّبِيَّ قَالَ :  مَنْ صَلَّى أَرْبَعًا قَبْلَ الظُّهْرِ  ، وَأَرْبَعًا بَعْدَهُ حَرَّمَهُ اللهُ عَلَى النَّارِ  .","","Al-Mu'jam al-Kabir 457","","رملة بنت أبي سفيان زوج رسول الله عن مولى لعنبسة بن أبي سفيان عن مكحول بن أبي مسلم عن سليمان بن موسى الأشدق عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن يحيى بن عثمان بن صالح عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21057","458  -  حَدَّثَنَا  أَبُو زُرْعَةَ ،  ثَنَا  أَبُو النَّضْرِ ،  ثَنَا  يَحْيَى بْنُ حَمْزَةَ ،  عَنِ  النُّعْمَانِ بْنِ الْمُنْذِرِ ،  عَنْ  مَكْحُولٍ ،  عَنْ  عَنْبَسَةَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 458","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن مكحول بن أبي مسلم عن النعمان بن المنذر الغساني عن يحيى بن حمزة بن البتلهي عن إسحاق بن إبراهيم الفراديسي عن أبو زرعة الدمشقي عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21058","[23/237]      459  -  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ الْبَاقِي ،  ثَنَا  مُحَمَّدُ بْنُ عَوْفٍ ،  ثَنَا  الرَّبِيعُ بْنُ رَوْحٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ الْبَصْرِيِّ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ الْمُهَاجِرِ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ، قَالَ :  حَدَّثَتْنِي  أُمُّ حَبِيبَةَ  ، أَنَّهَا سَمِعَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ صَلَّى أَرْبَعَ رَكَعَاتٍ قَبْلَ الظُّهْرِ  ، وَأَرْبَعًا بَعْدَهَا حَرَّمَهُ اللهُ عَلَى النَّارِ  .","","Al-Mu'jam al-Kabir 459","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن عبد الله بن المهاجر الشعيثي عن محمد بن عبد الله بن المهاجر الشعيثي عن إسماعيل بن عياش الأحول عن الربيع بن روح اللاحوني عن محمد بن عوف بن سفيان عن يحيى بن عبد الباقي الثغري عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21059","460  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَبُو الْأَسْوَدِ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنِي  خَالِدُ بْنُ يَزِيدَ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  حَدَّثَنِي  عَنْبَسَةُ بْنُ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ صَلَّى اثْنَتَيْ عَشْرَ رَكْعَةً فِي لَيْلِهِ وَنَهَارِهِ  ، بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 460","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن عطاء بن أبي رباح عن خالد بن يزيد الجمحي عن عبد الله بن لهيعة عن النضر بن عبد الجبار المرادي عن المقدام بن داود الرعيني عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21060","461  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ سُفْيَانَ الرَّقِّيُّ ،  ثَنَا  أَيُّوبُ بْنُ مُحَمَّدٍ الْوَزَّانُ ،  ثَنَا  مَعْمَرُ بْنُ سُلَيْمَانَ ،  ثَنَا  زَيْدُ بْنُ حَبَّانَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ  ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ صَلَّى فِي يَوْمٍ ثِنْتَيْ عَشْرَةَ رَكْعَةً بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 461","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن عطاء بن أبي رباح عن ابن جريج عن زيد بن حبان الرقي عن معمر بن سليمان النخعي عن أيوب بن محمد الوزان عن محمد بن جعفر بن سفيان عن الطبراني","عنبسة بن أبي سفيان عن أم حبيبة"
"21061","أَبُو سُفْيَانَ بْنُ سَعِيدِ بْنِ الْمُغِيرَةِ بْنِ الْأَخْنَسِ  عَنْ  أُمِّ حَبِيبَةَ  .  462  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي سُفْيَانَ بْنِ سَعِيدِ بْنِ الْأَخْنَسِ ،  أَنَّهُ  دَخَلَ عَلَى  أُمِّ حَبِيبَةَ فَسَقَتْهُ سَوِيقًا ، ثُمَّ قَامَ يُصَلِّي ، فَقَالَتْ         [23/238]      لَهُ : تَوَضَّأْ يَا ابْنَ أَخِي ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  تَوَضَّئُوا مِمَّا مَسَّتْهُ النَّارُ  .","","Al-Mu'jam al-Kabir 462","","رملة بنت أبي سفيان زوج رسول الله عن أبو سفيان بن سعيد بن المغيرة الثقفي عن أبو سلمة بن عبد الرحمن عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","أبو سفيان بن سعيد بن المغيرة بن الأخنس عن أم حبيبة"
"21062","463  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي سُفْيَانَ بْنِ سَعِيدِ بْنِ الْأَخْنَسِ ،  عَنْ  أُمِّ حَبِيبَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  تَوَضَّئُوا مِمَّا مَسَّتِ النَّارُ  .","","Al-Mu'jam al-Kabir 463","","رملة بنت أبي سفيان زوج رسول الله عن أبو سفيان بن سعيد بن المغيرة الثقفي عن أبو سلمة بن عبد الرحمن عن الزهري عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","أبو سفيان بن سعيد بن المغيرة بن الأخنس عن أم حبيبة"
"21063","464  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ، قَالَ :  أَخْبَرَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْعَزِيزِ الْإِمَامِيُّ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي سُفْيَانَ بْنِ سَعِيدِ بْنِ الْأَخْنَسِ ،  عَنْ  أُمِّ حَبِيبَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  تَوَضَّئُوا مِمَّا مَسَّتِ النَّارُ  .","","Al-Mu'jam al-Kabir 464","","رملة بنت أبي سفيان زوج رسول الله عن أبو سفيان بن سعيد بن المغيرة الثقفي عن أبو سلمة بن عبد الرحمن عن الزهري عن عبد الرحمن بن عبد العزيز الأوسي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","أبو سفيان بن سعيد بن المغيرة بن الأخنس عن أم حبيبة"
"21064","465  -  حَدَّثَنَا  حَمَّادُ بْنُ زُغْبَةَ ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  ثَنَا  بَكْرُ بْنُ مُضَرَ ،  عَنْ  جَعْفَرِ بْنِ رَبِيعَةَ ،  عَنْ  بَكْرِ بْنِ سَوَادَةَ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي سُفْيَانَ بْنِ سَعِيدِ بْنِ الْأَخْنَسِ ،  عَنْ  أُمِّ حَبِيبَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  الْوُضُوءُ مِمَّا مَسَّتِ النَّارُ  .","","Al-Mu'jam al-Kabir 465","","رملة بنت أبي سفيان زوج رسول الله عن أبو سفيان بن سعيد بن المغيرة الثقفي عن أبو سلمة بن عبد الرحمن عن الزهري عن بكر بن سوادة عن جعفر بن ربيعة الكندي عن بكر بن مضر المصري عن يحيى بن عبد الله بن بكير المخزومي عن زغبة ، أحمد بن حماد بن مسلم التجيبي عن الطبراني","أبو سفيان بن سعيد بن المغيرة بن الأخنس عن أم حبيبة"
"21065","أَبُو سُفْيَانَ ابْنُ أُخْتِ أُمِّ حَبِيبَةَ  .  466  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  عَنِ  ابْنِ شِهَابٍ ، أَنَّ أَبَا سَلَمَةَ بْنَ عَبْدِ الرَّحْمَنِ  أَخْبَرَهُ  ، أَنَّ أَبَا سُفْيَانَ بْنَ سَعِيدِ بْنِ الْأَخْنَسِ  أَخْبَرَهُ  ،  أَنَّهُ  دَخَلَ عَلَى  خَالَتِهِ أُمِّ حَبِيبَةَ - زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَخَاضَتْ لَهُ سَوِيقًا         [23/239]      فَشَرِبَهُ ، فَقَالَتْ : يَا بُنَيَّ تَوَضَّأْ ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  الْوُضُوءُ مِمَّا مَسَّتِ النَّارُ  .","","Al-Mu'jam al-Kabir 466","","رملة بنت أبي سفيان زوج رسول الله عن أبو سفيان بن سعيد بن المغيرة الثقفي عن أبو سلمة بن عبد الرحمن عن الزهري عن صالح بن كيسان الدوسي عن إبراهيم بن سعد أبو إسحاق الزهري عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","أبو سفيان ابن أخت أم حبيبة"
"21066","467  -  حَدَّثَنَا  مُوسَى بْنُ عِيسَى بْنِ الْمُنْذِرِ الْحِمْصِيُّ ،  ثَنَا  أَبُو الْيَمَانِ ،  ثَنَا  شُعَيْبُ بْنُ أَبِي حَمْزَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي سُفْيَانَ بْنِ سَعِيدِ بْنِ الْأَخْنَسِ ،  عَنْ  أُمِّ حَبِيبَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَوَضَّئُوا مِمَّا مَسَّتِ النَّارُ  .","","Al-Mu'jam al-Kabir 467","","رملة بنت أبي سفيان زوج رسول الله عن أبو سفيان بن سعيد بن المغيرة الثقفي عن أبو سلمة بن عبد الرحمن عن الزهري عن شعيب بن أبي حمزة الحمصي عن أبو اليمان الحكم بن نافع عن موسى بن عيسى بن المنذر الحمصي عن الطبراني","أبو سفيان ابن أخت أم حبيبة"
"21067","468  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْخَطَّابِ التُّسْتَرِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ سَعْدٍ الزُّهْرِيُّ ، قَالَ :  ثَنَا  عَمِّي  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ :  حَدَّثَنِي  الزُّهْرِيُّ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي سُفْيَانَ بْنِ سَعِيدِ بْنِ الْأَخْنَسِ ،  عَنْ  أُمِّ حَبِيبَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" أَمَرَ بِالْوُضُوءِ مِمَّا مَسَّتِ النَّارُ  مِنَ الطَّعَامِ  .","","Al-Mu'jam al-Kabir 468","","رملة بنت أبي سفيان زوج رسول الله عن أبو سفيان بن سعيد بن المغيرة الثقفي عن أبو سلمة بن عبد الرحمن عن الزهري عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن عبيد الله بن سعد بن إبراهيم الزهري عن أحمد بن الخطاب التستري عن الطبراني","أبو سفيان ابن أخت أم حبيبة"
"21068","469  -  حَدَّثَنَا  أَبُو حَنِيفَةَ مُحَمَّدُ بْنُ حَنِيفَةَ الْوَاسِطِيُّ ،  ثَنَا  عَمِّي  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ مَاهَانَ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  الْعَلَاءُ بْنُ رَاشِدٍ ،  عَنْ  عُثْمَانَ بْنِ حَكِيمٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي سُفْيَانَ بْنِ سَعِيدِ بْنِ الْأَخْنَسِ ،  عَنْ  أُمِّ حَبِيبَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  تَوَضَّئُوا مِمَّا مَسَّتِ النَّارُ  .","","Al-Mu'jam al-Kabir 469","","رملة بنت أبي سفيان زوج رسول الله عن أبو سفيان بن سعيد بن المغيرة الثقفي عن أبو سلمة بن عبد الرحمن عن الزهري عن عثمان بن حكيم الأحلافي عن العلاء بن راشد عن محمد بن ماهان القصباني عن أحمد بن أبي حنيفة محمد بن ماهان عن محمد بن حنيفة القصبى عن الطبراني","أبو سفيان ابن أخت أم حبيبة"
"21069","470  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  أَبَانُ بْنُ يَزِيدَ ،  حَدَّثَنَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ، أَنَّ أَبَا سُفْيَانَ بْنَ الْمُغِيرَةِ  حَدَّثَهُ  ،  أَنَّهُ دَخَلَ عَلَى أُمِّ حَبِيبَةَ فَسَقَتْهُ قَدَحًا مِنْ سَوِيقٍ ، فَدَعَا بِمَاءٍ فَمَضْمَضَ ، فَقَالَتْ لَهُ : يَا ابْنَ أُخْتِي أَلَا تَتَوَضَّأُ ، فَإِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  تَوَضَّئُوا  مِمَّا غَيَّرَتْ ، أَوْ مَسَّتِ النَّارُ  .","","Al-Mu'jam al-Kabir 470","","رملة بنت أبي سفيان زوج رسول الله عن أبو سفيان بن سعيد بن المغيرة الثقفي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبان بن يزيد العطار عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو سفيان ابن أخت أم حبيبة"
"21070","[23/240]      الْجَرَّاحُ وَيُقَالُ أَبُو الْجَرَّاحِ مَوْلَى أُمِّ حَبِيبَةَ  عَنْ  أُمِّ حَبِيبَةَ  .  472  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  نَافِعٍ ،  عَنِ  الْجَرَّاحِ ، مَوْلَى أُمِّ حَبِيبَةَ ،  عَنْ  أُمِّ حَبِيبَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ الْمَلَائِكَةَ لَا تَصْحَبُ رُفْقَةً فِيهَا  جَرَسٌ  .","","Al-Mu'jam al-Kabir 472","","رملة بنت أبي سفيان زوج رسول الله عن أبو الجراح مولى أم حبيبة زوج رسول الله عن نافع مولى ابن عمر عن أيوب السختياني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","الجراح ويقال أبو الجراح مولى أم حبيبة عن أم حبيبة"
"21071","473  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  نَافِعٍ ،  عَنْ  سَالِمٍ ،  عَنِ  الْجَرَّاحِ ، مَوْلَى أُمِّ حَبِيبَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ  الْعِيرَ  الَّتِي فِيهَا  الْجَرَسُ  لَا تَصْحَبُهَا الْمَلَائِكَةُ  .","","Al-Mu'jam al-Kabir 473","","أبو الجراح مولى أم حبيبة زوج رسول الله عن سالم بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","الجراح ويقال أبو الجراح مولى أم حبيبة عن أم حبيبة"
"21072","474  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ أَبِي عَبَّادٍ الْمَكِّيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ بْنِ عُقْبَةَ ،  عَنْ  نَافِعٍ ،  عَنْ  سَالِمٍ ،  عَنِ  الْجَرَّاحِ ، مَوْلَى أُمِّ حَبِيبَةَ ،  سَمِعَهُ يُخْبِرُ  ابْنَ عُمَرَ ،  عَنْ  أُمِّ حَبِيبَةَ ، أَنَّهَا أَخْبَرَتْهُ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ  الْعِيرَ  الَّتِي فِيهَا  الْجَرَسُ  لَا تَصْحَبُهَا الْمَلَائِكَةُ  .","","Al-Mu'jam al-Kabir 474","","رملة بنت أبي سفيان زوج رسول الله عن عبد الله بن عمر بن الخطاب عن أبو الجراح مولى أم حبيبة زوج رسول الله عن سالم بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن إسماعيل بن إبراهيم بن عقبة الأسدي عن يعقوب بن إسحاق القلزمي عن يوسف بن يزيد القراطيسي عن الطبراني","الجراح ويقال أبو الجراح مولى أم حبيبة عن أم حبيبة"
"21073","475  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِي الْجَرَّاحِ ، مَوْلَى أُمِّ حَبِيبَةَ ،  عَنْ  أُمِّ حَبِيبَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تَصْحَبُ الْمَلَائِكَةُ رُفْقَةً فِيهَا  جَرَسٌ  .","","Al-Mu'jam al-Kabir 475","","رملة بنت أبي سفيان زوج رسول الله عن أبو الجراح مولى أم حبيبة زوج رسول الله عن سالم بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","الجراح ويقال أبو الجراح مولى أم حبيبة عن أم حبيبة"
"21074","476  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي         [23/241]      شَيْبَةَ ،  ثَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ، وَمُحَمَّدُ بْنُ بِشْرٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِي الْجَرَّاحِ ، مَوْلَى أُمِّ حَبِيبَةَ ،  عَنْ  أُمِّ حَبِيبَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَصْحَبُ الْمَلَائِكَةُ رُفْقَةً فِيهَا  جَرَسٌ  .","","Al-Mu'jam al-Kabir 476","","رملة بنت أبي سفيان زوج رسول الله عن أبو الجراح مولى أم حبيبة زوج رسول الله عن سالم بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن محمد بن بشر بن الفرافصة عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","الجراح ويقال أبو الجراح مولى أم حبيبة عن أم حبيبة"
"21075","477  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْحُسَيْنِ بْنِ مُدْرِكٍ الْقَصْرِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ أَحْمَدَ الْوَاسِطِيُّ ،  ثَنَا  أَبُو خُلَيْدٍ عُتْبَةُ بْنُ حَمَّادٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ ثَابِتِ بْنِ ثَوْبَانَ ،  عَنْ  نَافِعٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِي الْجَرَّاحِ ، مَوْلَى أُمِّ حَبِيبَةَ ،  عَنْ  أُمِّ حَبِيبَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ  الْعِيرَ  الَّتِي فِيهَا  جَرَسٌ  لَا تَصْحَبُهَا الْمَلَائِكَةُ  .","","Al-Mu'jam al-Kabir 477","","رملة بنت أبي سفيان زوج رسول الله عن أبو الجراح مولى أم حبيبة زوج رسول الله عن سالم بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الرحمن بن ثابت العنسي عن عتبة بن حماد بن خليد عن سليمان بن أحمد الدمشقي عن أحمد بن الحسين بن مدرك القصري عن الطبراني","الجراح ويقال أبو الجراح مولى أم حبيبة عن أم حبيبة"
"21076","478  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ،  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى ، كَاتِبُ الْعُمَرِيِّ ،  ثَنَا  الْمُفَضَّلُ بْنُ فَضَالَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ سُلَيْمَانَ الطَّوِيلِ ،  عَنْ  نَافِعٍ ، أَنَّ سَالِمًا  أَخْبَرَهُ  ، أَنَّ أُمَّ حَبِيبَةَ  أَخْبَرَتْهُ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تَصْحَبُ الْمَلَائِكَةُ رُفْقَةً فِيهَا  جَرَسٌ  .","","Al-Mu'jam al-Kabir 478","","رملة بنت أبي سفيان زوج رسول الله عن سالم بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن سليمان بن زرعة الحميري عن المفضل بن فضالة عن زكريا بن يحيى القضاعي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","الجراح ويقال أبو الجراح مولى أم حبيبة عن أم حبيبة"
"21077","479  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  جَعْفَرِ بْنِ رَبِيعَةَ ،  عَنْ  عِرَاكِ بْنِ مَالِكٍ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنِ  الْجَرَّاحِ ،  عَنْ  أُمِّ حَبِيبَةَ ، أَنَّهَا سَمِعَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا تَصْحَبُ الْمَلَائِكَةُ رُفْقَةً فِيهَا  جَرَسٌ  .","","Al-Mu'jam al-Kabir 479","","رملة بنت أبي سفيان زوج رسول الله عن أبو الجراح مولى أم حبيبة زوج رسول الله عن سالم بن عبد الله بن عمر بن الخطاب عن عراك بن مالك الغفاري عن جعفر بن ربيعة الكندي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","الجراح ويقال أبو الجراح مولى أم حبيبة عن أم حبيبة"
"21078","ذَكْوَانُ أَبُو صَالِحٍ السَّمَّانُ  عَنْ  أُمِّ حَبِيبَةَ  .  480  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَاصِمِ بْنِ بَهْدَلَةَ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أُمِّ حَبِيبَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ صَلَّى فِي يَوْمٍ اثْنَتَيْ عَشْرَةَ رَكْعَةً بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 480","","رملة بنت أبي سفيان زوج رسول الله عن ذكوان السمان عن عاصم بن بهدلة عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكوان أبو صالح السمان عن أم حبيبة"
"21079","[23/242]      سَالِمُ بْنُ شَوَّالٍ  عَنْ  أُمِّ حَبِيبَةَ  .  481  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  الْحُمَيْدِيُّ ، (  ح  ) .  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَ :  حَدَّثَنِي  أَبِي  ، قَالَا :  ثَنَا  سُفْيَانُ ،  ثَنَا  عَمْرُو بْنُ دِينَارٍ ، قَالَ :  سَمِعْتُ  سَالِمَ بْنَ شَوَّالٍ  يُحَدِّثُ ، عَنْ  أُمِّ حَبِيبَةَ ، قَالَتْ :  كُنَّا نَفْعَلُهُ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نُغَلِّسُ  مِنْ  جَمْعٍ  إِلَى  مِنًى  ""  .  زَادَ  الْحُمَيْدِيُّ  فِي حَدِيثِهِ ، قَالَ  سُفْيَانُ  :  وَسَالِمُ بْنُ شَوَّالٍ  رَجُلٌ مِنْ  أَهْلِ مَكَّةَ  لَمْ نَسْمَعْ أَحَدًا يُحَدِّثُ عَنْهُ إِلَّا  عَمْرَو بْنَ دِينَارٍ  هَذَا الْحَدِيثَ  .","","Al-Mu'jam al-Kabir 481","","رملة بنت أبي سفيان زوج رسول الله عن سالم بن شوال المكي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","سالم بن شوال عن أم حبيبة"
"21080","أَبُو عَبْدِ الرَّحْمَنِ السُّلَمِيُّ  عَنْ  أُمِّ حَبِيبَةَ  .  482  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي حُصَيْنٍ ،  عَنْ  يَحْيَى بْنِ وَثَّابٍ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ ،  عَنْ  أُمِّ حَبِيبَةَ ، "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ : "" يُصَلِّي عَلَى  الْخُمْرَةِ  "" .","","Al-Mu'jam al-Kabir 482","","رملة بنت أبي سفيان زوج رسول الله عن عبد الله بن حبيب السلمي عن يحيى بن وثاب الأصبهاني عن عثمان بن عاصم بن حصين عن شعبة بن الحجاج عن وهب بن جرير بن حازم عن عبيد الله بن عمر القواريري عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو عبد الرحمن السلمي عن أم حبيبة"
"21081","عَمْرُو بْنُ الْحَكَمِ  عَنْ  أُمِّ حَبِيبَةَ  .  483  -  حَدَّثَنَا  عَبْدُ الْمَلِكِ بْنُ يَحْيَى بْنِ بُكَيْرٍ الْمِصْرِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  دَرَّاجٍ أَبِي السَّمْحِ ،  عَنْ  عَمْرِو بْنِ الْحَكَمِ  ،  عَنْ  أُمِّ حَبِيبَةَ بِنْتِ أَبِي         [23/243]      سُفْيَانَ ، قَالَتْ :  إِنَّ نَاسًا مِنْ  أَهْلِ الْيَمَنِ  قَدِمُوا عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَعَلَّمَهُمُ الصَّلَاةَ وَالسُّنَنَ وَالْفَرَائِضَ ، فَقَالُوا : يَا رَسُولَ اللهِ إِنَّ لَنَا شَرَابًا نَصْنَعُهُ مِنَ  الْقَمْحِ  وَالشَّعِيرِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَصْنَعُوا  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عمر بن الحكم ) .","","Al-Mu'jam al-Kabir 483","","رملة بنت أبي سفيان زوج رسول الله عن عمر بن الحكم بن رافع الأوسي عن دراج أبي السمح عن عبد الله بن لهيعة عن يحيى بن عبد الله بن بكير المخزومي عن عبد الملك بن يحيى المخزومي عن الطبراني","عمرو بن الحكم عن أم حبيبة"
"21082","صَفِيَّةُ بِنْتُ شَيْبَةَ  عَنْ  أُمِّ حَبِيبَةَ  .  484  -  حَدَّثَنَا  أَبُو هَارُونَ مُوسَى بْنُ مُحَمَّدِ بْنِ كَثِيرٍ السِّرِينِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ يَزِيدَ بْنِ خُنَيْسٍ الْمَكِّيُّ ، قَالَ : دَخَلْنَا عَلَى  سُفْيَانَ الثَّوْرِيِّ  نَعُودُهُ ، فَدَخَلَ عَلَيْهِ سَعِيدُ بْنُ حَسَّانَ الْمَخْزُومِيُّ ، فَقَالَ لَهُ سُفْيَانُ : أَعِدْ عَلَيَّ حَدِيثَ  أُمِّ صَالِحٍ  ، فَقَالَ :  حَدَّثَتْنِي  أُمُّ صَالِحٍ ، [ (  ح  ) ] .  [ وَ ]  حَدَّثَنَا  الْعَبَّاسُ بْنُ مُحَمَّدٍ الْمُجَاشِعِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي يَعْقُوبَ الْكَرْمَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ يَزِيدَ بْنِ خُنَيْسٍ الْمَكِّيُّ ،  عَنْ  سَعِيدِ بْنِ حَسَّانَ ، قَالَ :  حَدَّثَتْنِي  أُمُّ صَالِحٍ ،  عَنْ  صَفِيَّةَ بِنْتِ شَيْبَةَ ،  عَنْ  أُمِّ حَبِيبَةَ - زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  كَلَامُ ابْنِ آدَمَ كُلُّهُ عَلَيْهِ لَا لَهُ إِلَّا أَمْرًا بِمَعْرُوفٍ  ، أَوْ نَهْيًا عَنْ مُنْكَرٍ ، أَوْ ذِكْرًا لِلهِ  ،  فَقَالَ رَجُلٌ مِنَ  الْقَوْمِ  : مَا أَشَدَّ هَذَا الْحَدِيثَ ، فَقَالَ  سُفْيَانُ الثَّوْرِيُّ  : وَمَا شِدَّتُهُ ؟ أَلَيْسَ قَدْ جَاءَكُمْ نَبِيُّكُمْ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ رَبِّكُمْ - عَزَّ وَجَلَّ - فَقَالَ :         {      يَوْمَ يَقُومُ الرُّوحُ وَالْمَلائِكَةُ صَفًّا لا يَتَكَلَّمُونَ إِلا مَنْ أَذِنَ لَهُ الرَّحْمَنُ وَقَالَ صَوَابًا             *          ذَلِكَ الْيَوْمُ الْحَقُّ         }      وَقَالَ :         {      لا خَيْرَ فِي كَثِيرٍ مِنْ نَجْوَاهُمْ إِلا مَنْ أَمَرَ بِصَدَقَةٍ أَوْ مَعْرُوفٍ أَوْ إِصْلاحٍ بَيْنَ النَّاسِ         }      إِلَى آخِرِ الْآيَةِ  .","","Al-Mu'jam al-Kabir 484","","رملة بنت أبي سفيان زوج رسول الله عن صفية بنت شيبة الحجبية عن أم صالح بنت صالح عن سعيد بن حسان المخزومي عن محمد بن يزيد المخزومي عن محمد بن إسحاق الكرماني عن العباس بن محمد بن مجاشع الأصبهاني عن الطبراني","صفية بنت شيبة عن أم حبيبة"
"21083","[23/244]      أُمُّ عَلْقَمَةَ  عَنْ  أُمِّ حَبِيبَةَ  .  485  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ التَّيْمِيِّ ،  عَنِ  الصَّلْتِ يَعْنِي ابْنَ دِينَارٍ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  أُمِّهِ ،  عَنْ  أُمِّ حَبِيبَةَ ، "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ فِي بَيْتِهَا فَسَمِعَ الْمُؤَذِّنَ ، فَقَالَ كَمَا يَقُولُ ، فَلَمَّا قَالَ : حَيَّ عَلَى الصَّلَاةِ نَهَضَ  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى الصَّلَاةِ  .","","Al-Mu'jam al-Kabir 485","","رملة بنت أبي سفيان زوج رسول الله عن أم علقمة بن قيس النخعي عن علقمة بن قيس النخعي عن الصلت بن دينار الهنائي عن معتمر بن سليمان عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","أم علقمة عن أم حبيبة"
"21084","486  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ ،  ثَنَا  مُحَمَّدُ بْنُ يَزِيدَ الرَّوَاسِبِيُّ ،  ثَنَا  فَضَالَةُ بْنُ حُصَيْنٍ الْعَطَّارُ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّ حَبِيبَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ صَلَّى فِي يَوْمٍ ثِنْتَيْ عَشْرَةَ رَكْعَةً سِوَى الْفَرِيضَةِ بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 486","","رملة بنت أبي سفيان زوج رسول الله عن الحسن البصري عن يونس بن عبيد عن فضالة بن حصين الضبي عن محمد بن يزيد الرواسبي عن البزار عن الطبراني","أم علقمة عن أم حبيبة"
"21085","487  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِي الْجَرَّاحِ ،  عَنْ  أُمِّ حَبِيبَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَصْحَبُ الْمَلَائِكَةُ رُفْقَةً فِيهَا  جَرَسٌ  .","","Al-Mu'jam al-Kabir 487","","رملة بنت أبي سفيان زوج رسول الله عن أبو الجراح مولى أم حبيبة زوج رسول الله عن سالم بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن محمد بن بشر بن الفرافصة عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أم علقمة عن أم حبيبة"
"21086","488  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ الزُّبَيْرِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  أَنَسُ بْنُ عِيَاضٍ ،  عَنْ  يُونُسَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي سُفْيَانَ بْنِ سَعِيدٍ ،  عَنْ  أُمِّ حَبِيبَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  تَوَضَّئُوا مِمَّا مَسَّتِ النَّارُ  .","","Al-Mu'jam al-Kabir 488","","رملة بنت أبي سفيان زوج رسول الله عن أبو سفيان بن سعيد بن المغيرة الثقفي عن أبو سلمة بن عبد الرحمن عن الزهري عن يونس بن يزيدالأيلي عن أنس بن عياض الليثي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","أم علقمة عن أم حبيبة"
"21087","489  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  خَالِدُ بْنُ مَخْلَدٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْعَزِيزِ الْأَنْصَارِيُّ ،  أَخْبَرَنِي  الزُّهْرِيُّ ،         [23/245]      حَدَّثَنِي  أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  أَخْبَرَنِي  أَبُو سُفْيَانَ بْنُ سَعِيدِ بْنِ الْأَخْنَسِ ،  عَنْ  أُمِّ حَبِيبَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 489","","رملة بنت أبي سفيان زوج رسول الله عن أبو سفيان بن سعيد بن المغيرة الثقفي عن أبو سلمة بن عبد الرحمن عن الزهري عن عبد الرحمن بن عبد العزيز الأوسي عن خالد بن مخلد القطواني عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أم علقمة عن أم حبيبة"
"21088","490  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  سَالِمِ بْنِ شَوَّالٍ ،  عَنْ  أُمِّ حَبِيبَةَ ، قَالَتْ :  كُنَّا نَفْعَلُهُ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِغَلَسٍ  مِنْ جَمْعٍ إِلَى  مِنًى  "" .","","Al-Mu'jam al-Kabir 490","","رملة بنت أبي سفيان زوج رسول الله عن سالم بن شوال المكي عن عطاء بن أبي رباح عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أم علقمة عن أم حبيبة"
"21089","491  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  عَنْ  مُعَاوِيَةَ بْنِ صَالِحٍ ، قَالَ :  حَدَّثَنِي  ضَمْرَةُ بْنُ حَبِيبٍ ، قَالَ :  حَدَّثَنِي  مُحَمَّدُ بْنُ أَبِي سُفْيَانَ الثَّقَفِيُّ ،  عَنْ  أُمِّ حَبِيبَةَ ، قَالَتْ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي ثَوْبٍ عَلَيَّ وَعَلَيْهِ كَانَ فِيهِ مَا كَانَ  .","","Al-Mu'jam al-Kabir 491","","رملة بنت أبي سفيان زوج رسول الله عن محمد بن أبي سفيان بن العلاء الثقفي عن ضمرة بن حبيب الزبيدي عن معاوية بن صالح بن حدير الحضرمي عن زيد بن الحباب العكلي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أم علقمة عن أم حبيبة"
"21090","492  -  حَدَّثَنَا  حَجَّاجُ بْنُ عِمْرَانَ ،  ثَنَا  يَحْيَى بْنُ خَلَفٍ ،  ثَنَا  ابْنُ أَبِي عَدِيٍّ ،  عَنْ  شُعْبَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  شُتَيْرِ بْنِ شَكَلٍ ،  عَنْ  أُمِّ حَبِيبَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ : "" يُقَبِّلُ وَهُوَ صَائِمٌ  .","","Al-Mu'jam al-Kabir 492","","رملة بنت أبي سفيان زوج رسول الله عن شتير بن شكل العبسي عن شقيق بن سلمة عن منصور بن المعتمر عن شعبة بن الحجاج عن محمد بن إبراهيم بن أبي عدي القسملي عن يحيى بن خلف الجوباري عن حجاج بن عمران السدوسي عن الطبراني","أم علقمة عن أم حبيبة"
"21091","493  -  حَدَّثَنَا  يَحْيَى بْنُ صَالِحٍ ،  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  ثَنَا  شُعْبَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  شُتَيْرِ بْنِ شَكَلٍ ،  عَنْ  أُمِّ حَبِيبَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ : "" يُقَبِّلُ وَهُوَ صَائِمٌ  .","","Al-Mu'jam al-Kabir 493","","رملة بنت أبي سفيان زوج رسول الله عن شتير بن شكل العبسي عن مسلم بن صبيح الهمداني عن منصور بن المعتمر عن شعبة بن الحجاج عن عبد الله بن المبارك عن نعيم بن حماد الخزاعي عن يحيى بن عثمان بن صالح عن الطبراني","أم علقمة عن أم حبيبة"
"21092","494  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ ،  ثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ،  حَدَّثَنَا  بَقِيَّةُ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي مَرْيَمَ ،  عَنْ  عَطِيَّةَ بْنِ قَيْسٍ ،  أَنَّ  أُمَّ حَبِيبَةَ         [23/246]      كَانَتْ فِي أَرْضِ  الْحَبَشَةِ  مَعَ  جَعْفَرِ بْنِ أَبِي طَالِبٍ  ، "" وَأَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَزَوَّجَهَا وَأَصْدَقَ عَنْهُ  النَّجَاشِيُّ  أَرْبَعَمِائَةِ دِينَارٍ  .","","Al-Mu'jam al-Kabir 494","","عطية بن قيس الكلابي عن أبو بكر الغساني عن بقية بن الوليد عن محمد بن مصفى بن بهلول عن إبراهيم بن محمد بن عرق الحمصي عن الطبراني","أم علقمة عن أم حبيبة"
"21093","495  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ ،  ثَنَا  حَسَّانُ بْنُ غَالِبٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  دَرَّاجٍ ،  عَنْ  عُمَرَ بْنِ الْحَكَمِ ،  عَنْ  أُمِّ حَبِيبَةَ بِنْتِ أَبِي سُفْيَانَ ،  أَنَّ نَاسًا مِنْ  أَهْلِ الْيَمَنِ  قَدِمُوا عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَعَلَّمَهُمُ السُّنَنَ وَالصَّلَاةَ وَالْفَرَائِضَ  ، فَقَالُوا : إِنَّ لَنَا شَرَابًا نَصْنَعُهُ مِنَ  الْقَمْحِ  وَالشَّعِيرِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  الْغُبَيْرَاءُ  "" ؟ قَالُوا : نَعَمْ ، قَالَ : "" فَلَا تَطْعَمُوهُ "" ، قَالُوا : فَإِنَّهُمْ لَا يَدَعُونَهَا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" فَمَنْ لَمْ يَتْرُكْهَا فَاضْرِبُوا عُنُقَهُ  .","","Al-Mu'jam al-Kabir 495","","رملة بنت أبي سفيان زوج رسول الله عن عمر بن الحكم بن رافع الأوسي عن دراج أبي السمح عن عبد الله بن لهيعة عن حسان بن غالب المصري عن يحيى بن عثمان بن صالح عن الطبراني","أم علقمة عن أم حبيبة"
"21094","أُمُّ سَلَمَةَ  وَاسْمُهَا  هِنْدُ بِنْتُ أَبِي أُمَيَّةَ بْنِ حُذَيْفَةَ بْنِ الْمُغِيرَةِ بْنِ عَبْدِ اللهِ بْنِ عَمْرِو بْنِ مَخْزُومِ بْنِ نُقْطَةَ بْنِ مُرَّةَ بْنِ كَعْبِ بْنِ لُؤَيِّ بْنِ غَالِبٍ  .  496  - حَدَّثَنَا بِهَذِهِ النِّسْبَةِ  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، قَالَ : ثَنَا  الزُّبَيْرُ بْنُ بَكَّارٍ  .  "" وَكَانَتْ  أُمُّ سَلَمَةَ  قَبْلَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِنْدَ  أَبِي سَلَمَةَ عَبْدِ اللهِ بْنِ عَبْدِ الْأَسَدِ  ، فَوَلَدَتْ لَهُ  سَلَمَةَ  ،  وَعُمَرَ  ،  وَزَيْنَبَ  ، ثُمَّ تُوُفِّيَ عَنْهَا فَخَلَفَ عَلَيْهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" .","","Al-Mu'jam al-Kabir 496","","","أم سلمة"
"21095","497  -  حَدَّثَنَا  مُعَاذٌ الْحَلَبِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ الْعَبْدِيُّ ،  ثَنَا         [23/247]      حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ ، قَالَ :  أَخْبَرَنِي  عُمَرُ بْنُ أَبِي سَلَمَةَ ،  عَنْ  أُمِّهِ أُمِّ سَلَمَةَ  ،  عَنْ  زَوْجِهَا أَبِي سَلَمَةَ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا مِنْ أَحَدٍ مِنَ الْمُسْلِمِينَ يُصَابُ بِمُصِيبَةٍ فَيَقُولُ : إِنَّا لِلهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ  ، اللَّهُمَّ إِنِّي أَحْتَسِبُ مُصِيبَتِي عِنْدَكَ ، اللَّهُمَّ أَبْدِلْنِي بِهَا خَيْرًا مِنْهَا ، إِلَّا أَبْدَلَهُ اللهُ بِهَا خَيْرًا مِنْهَا "" ، فَلَمَّا تُوُفِّيَ  أَبُو سَلَمَةَ  قَالَتْ  أُمُّ سَلَمَةَ  : إِنَّا لِلهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ ، اللَّهُمَّ إِنِّي أَحْتَسِبُ مُصِيبَتِي فِي  أَبِي سَلَمَةَ  عِنْدَكَ ، اللَّهُمَّ أَبْدِلْنِي بِهِ خَيْرًا مِنْهُ ، فَجَعَلْتُ أَقُولُ فِي نَفْسِي مِنْ خَيْرٍ مِنْ  أَبِي سَلَمَةَ  ، فَجَاءَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَخَطَبَنِي ، فَقُلْتُ : أَنَا  مُصْبِيَةٌ  ، وَأَنَا  غَيُورٌ  ، وَأَنَا كَبِيرَةُ السِّنِّ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" أَمَّا كِبَرُ السِّنِّ فَأَنَا أَكْبَرُ مِنْكِ ، وَأَمَّا الْغَيْرَةُ فَأَنَا أَدْعُو اللهَ أَنْ يُذْهِبَهَا عَنْكِ ، وَأَمَّا الْعِيَالُ فَإِلَى اللهِ وَرَسُولِهِ "" ، فَأَمَرَ  عُمَرُ بْنُ أَبِي سَلَمَةَ  فَزَوَّجَنِي إِيَّاهُ  .","","Al-Mu'jam al-Kabir 497","","عبد الله بن عبد الأسد بن هلال البدري عن هند بنت أبي أمية زوج رسول الله عن عمر بن أبي سلمة المخزومي عن ثابت البناني عن حماد بن سلمة عن محمد بن كثير العبدي عن معاذ بن المثنى العنبري عن الطبراني","أم سلمة"
"21096","498  -  حَدَّثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ (  ح  ) .  وَحَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  أَبُو كَامِلٍ الْجَحْدَرِيُّ ، قَالَا :  ثَنَا  أَبُو دَاوُدَ الطَّيَالِسِيُّ ،  ثَنَا  الْحَكَمُ بْنُ عَطِيَّةَ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَزَوَّجَ  أُمَّ سَلَمَةَ  عَلَى مَتَاعٍ قِيمَتُهُ عَشَرَةُ دَرَاهِمَ  .","","Al-Mu'jam al-Kabir 498","","أنس بن مالك عن ثابت البناني عن الحكم بن عطية العيشي عن أبو داود الطيالسي عن فضيل بن حسين الجحدري عن عبد الله بن أحمد الجواليقي عن الطبراني","أم سلمة"
"21097","499  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدِ         [23/248]      بْنِ كَاسِبٍ ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ الْفَزَارِيُّ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ أَيْمَنَ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ، قَالَ :  قَالَتْ  أُمُّ سَلَمَةَ :  لَمَّا خَطَبَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - قُلْتُ لَهُ : خِلَالٌ فِيَّ ثَلَاثٌ ، أَنَا كَبِيرَةُ السِّنِّ وَأَنَا امْرَأَةٌ مُطْفِلٌ ، وَأَنَا امْرَأَةٌ شَدِيدَةُ الْغَيْرَةِ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" أَمَا السِّنُّ فَأَنَا أَكْبَرُ مِنْكِ ، وَأَمَّا الْأَطْفَالُ فَهُمْ إِلَى اللهِ وَرَسُولِهِ ، وَأَمَّا الْغَيْرَةُ فَأَدْعُو اللهَ فَيُذْهِبُهَا عَنْكِ "" ، فَتَزَوَّجَهَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا دَخَلَ عَلَيْهَا قَالَ : "" إِنَّ بِكِ وَبِأَهْلِكِ عَلَيَّ كَرَامَةً ، وَإِنِّي لَمْ أُسَبِّعْ لِأَحَدٍ مِنْ نِسَائِي ، وَإِنْ أُسَبِّعْ لَكِ أُسَبِّعْ لِنِسَائِي  .","","Al-Mu'jam al-Kabir 499","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن عبد الواحد بن أيمن المخزومي عن مروان بن معاوية الفزاري عن يعقوب بن حميد بن كاسب المدني عن محمد بن علي بن زيد الصائغ عن الطبراني","أم سلمة"
"21098","500  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَدِينِيُّ فُسْتُقَةُ ،  ثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  عَنِ  الْهَيْثَمِ بْنِ عَدِيٍّ ، قَالَ :  أَوَّلُ مَنْ هَلَكَ مِنْ أَزْوَاجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  زَيْنَبُ بِنْتُ جَحْشٍ  ،  هَلَكَتْ فِي خِلَافَةِ  عُمَرَ  ، وَآخِرُ مَنْ هَلَكَ مِنْهُنَّ  أُمُّ سَلَمَةَ  ، هَلَكَتْ زَمَنَ  يَزِيدَ بْنِ مُعَاوِيَةَ  سَنَةَ ثِنْتَيْنِ وَسِتِّينَ  "" .","","Al-Mu'jam al-Kabir 500","","الهيثم بن عدي المنبجي عن داود بن رشيد الخوارزمي عن محمد بن علي فستقة البغدادي عن الطبراني","أم سلمة"
"21099","مَا أَسْنَدَتْ  أُمُّ سَلَمَةَ  .  عَائِشَةُ أُمُّ الْمُؤْمِنِينَ  عَنْ  أُمِّ سَلَمَةَ  - رَضِيَ اللهُ عَنْهُمَا .  501  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادٌ ،  عَنِ  الْأَزْرَقِ بْنِ قَيْسٍ ،  عَنْ  ذَكْوَانَ ،  عَنْ  عَائِشَةَ ،  أَنَّ  أُمَّ سَلَمَةَ ، قَالَتْ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعْدَ الْعَصْرِ فَصَلَّى رَكْعَتَيْنِ  ، فَقُلْتُ : يَا رَسُولَ اللهِ مَا هَاتَانِ الرَّكْعَتَانِ ، قَالَ : "" كُنْتُ أُصَلِّيهِمَا بَعْدَ الظُّهْرِ ،         [23/249]      فَجَاءَنِي حَالٌ فَشَغَلَنِي عَنْهُمَا حَتَّى صَلَّيْتُ الْعَصْرَ ، فَصَلَّيْتُهُمَا الْآنَ  .","","Al-Mu'jam al-Kabir 501","","هند بنت أبي أمية زوج رسول الله عن عائشة بنت أبي بكر الصديق عن ذكوان مولى عائشة بنت أبي بكر عن أزرق بن قيس الحارثي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عائشة أم المؤمنين عن أم سلمة رضي الله عنهما"
"21100","502  -  حَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ ،  ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ ،  ثَنَا  أَبِي  ،  عَنِ  ابْنِ إِسْحَاقَ ، قَالَ :  حَدَّثَنِي  مُحَمَّدُ بْنُ عَمْرِو بْنِ عَطَاءٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي سُفْيَانَ بْنِ حُوَيْطِبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ بْنِ نَوْفَلٍ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  حَدَّثَتْنِي  أُمُّ سَلَمَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّاهُمَا فِي بَيْتِهَا  .","","Al-Mu'jam al-Kabir 502","","هند بنت أبي أمية زوج رسول الله عن عائشة بنت أبي بكر الصديق عن عبد الله بن الحارث بن نوفل عن عبد الرحمن بن أبي سفيان بن حويطب القرشي عن محمد بن عمرو بن عطاء العامري عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن علي ابن المديني عن الفضل بن الحباب الجمحي عن الطبراني","عائشة أم المؤمنين عن أم سلمة رضي الله عنهما"
"21101","أَبُو سَعِيدٍ الْخُدْرِيُّ  عَنْ  أُمِّ سَلَمَةَ  .  503  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  فُضَيْلُ بْنُ مَرْزُوقٍ ،  ثَنَا  عَطِيَّةُ ،  عَنْ  أَبِي سَعِيدٍ ، قَالَ :  قَالَتْ  أُمُّ سَلَمَةَ :  نَزَلَتْ هَذِهِ الْآيَةُ فِي بَيْتِي         {      إِنَّمَا يُرِيدُ اللهُ لِيُذْهِبَ عَنْكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا         }      ،  وَأَنَا جَالِسَةٌ عَلَى الْبَابِ ، فَقُلْتُ : يَا رَسُولَ اللهِ أَلَسْتُ مِنْ أَهْلِ الْبَيْتِ ، قَالَ : "" أَنْتِ إِلَى خَيْرٍ  .","","Al-Mu'jam al-Kabir 503","","هند بنت أبي أمية زوج رسول الله عن أبو سعيد الخدري عن عطية بن سعد العوفي عن فضيل بن مرزوق الأغر عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو سعيد الخدري عن أم سلمة"
"21102","عُمَرُ بْنُ أَبِي سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  504  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  دُحَيْمٌ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ بَشِيرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  حَدَّثَنِي  أَبُو بَكْرِ بْنُ مُحَمَّدٍ ،  عَنْ  عُمَرَ بْنِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِضُبَاعَةَ بِنْتِ الزُّبَيْرِ  :  أَهِلِّي بِالْحَجِّ وَقُولِي مَحِلِّي حَيْثُ حَبَسْتَنِي  .","","Al-Mu'jam al-Kabir 504","","هند بنت أبي أمية زوج رسول الله عن عمر بن أبي سلمة المخزومي عن أبو بكر بن محمد الخزرجي عن محمد بن إسحاق عن عبد الرحمن بن بشير الدمشقي عن دحيم عن عبد الله بن أحمد الجواليقي عن الطبراني","عمر بن أبي سلمة عن أم سلمة"
"21103","[23/250]      505  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ لُوَيْنٌ ، قَالَا :  ثَنَا  أَبُو عَقِيلٍ يَحْيَى بْنُ الْمُتَوَكِّلِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ رَافِعٍ ،  عَنِ  ابْنِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنْ كَانَ أَوَّلَ مَا عَهِدَ إِلَيَّ فِيهِ رَبِّي وَنَهَانِي  عَنْهُ بَعْدَ عِبَادَةِ الْأَوْثَانِ ، وَشُرْبِ الْخَمْرِ  لَمُلَاحَاةُ  الرِّجَالِ  .","","Al-Mu'jam al-Kabir 505","","هند بنت أبي أمية زوج رسول الله عن ابن أبي سلمة عن إسماعيل بن رافع بن عويمر المزني عن يحيى بن المتوكل الحذاء عن محمد بن سليمان لوين عن الحسين بن إسحاق التستري عن الطبراني","عمر بن أبي سلمة عن أم سلمة"
"21104","506  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  أَبُو عُمَرَ الضَّرِيرُ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ ، قَالَ :  أَخْبَرَنِي  ابْنُ عُمَرَ بْنُ أَبِي سَلَمَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  أُمِّ سَلَمَةَ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ لَهَا حِينَ تَزَوَّجَ بِهَا :  إِنْ شِئْتِ أُسَبِّعُ لَكِ فَسَبَّعْتُ  ، ثُمَّ  سَبَّعْتُ  لِسَائِرِ نِسَائِي  .","","Al-Mu'jam al-Kabir 506","","هند بنت أبي أمية زوج رسول الله عن عمر بن أبي سلمة المخزومي عن ابن عمر بن أبي سلمة عن ثابت البناني عن حماد بن سلمة عن حفص بن عمر الضرير البصري عن أبو مسلم الكجي عن الطبراني","عمر بن أبي سلمة عن أم سلمة"
"21105","507  -  وَعَنْ  أُمِّ سَلَمَةَ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا مِنْ أَحَدٍ يُصَابُ بِمُصِيبَةٍ  فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 507","","هند بنت أبي أمية زوج رسول الله عن عمر بن أبي سلمة المخزومي عن ابن عمر بن أبي سلمة عن ثابت البناني عن حماد بن سلمة عن حفص بن عمر الضرير البصري عن أبو مسلم الكجي عن الطبراني","عمر بن أبي سلمة عن أم سلمة"
"21106","أَنَسُ بْنُ مَالِكٍ  عَنْ  أُمِّ سَلَمَةَ  .  508  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  ) .         [23/251]      وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  مُوسَى بْنُ عُبَيْدَةَ ،  عَنْ  سَعِيدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : كُنْتُ  بِالْبَصْرَةِ  ،  فَقَالَ  أَنَسُ بْنُ مَالِكٍ :  أَخْبَرَتْنِي  أُمُّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  قَدْ رَأَيْتُ مَا يَلْقَى أُمَّتِي بَعْدِي ، فَأَخَّرْتُ شَفَاعَتِي  إِلَى يَوْمِ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 508","","هند بنت أبي أمية زوج رسول الله عن أنس بن مالك عن سعيد بن عبد الرحمن الأسدي عن موسى بن عبيدة بن نشيط الحميري عن عبيد الله بن موسى عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","أنس بن مالك عن أم سلمة"
"21107","بُرَيْدَةُ بْنُ الْحُصَيْبِ الْأَسْلَمِيُّ  عَنْ  أُمِّ سَلَمَةَ  .  509  -  حَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ ،  ثَنَا  عَلِيُّ بْنُ عَبْدِ اللهِ ،  ثَنَا  أَبُو تُمَيْلَةَ يَحْيَى بْنُ وَاضِحٍ ، قَالَ :  أَخْبَرَنِي  عَبْدُ اللهِ بْنُ سَالِمٍ أَبُو قُتَيْبَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  ،  أَنَّ أُمَّ سَلَمَةَ كَانَتْ فِي  غَزْوَةِ خَيْبَرَ  ،  فَقَالَتْ  : "" سَمِعْتُ وَقْعَ السَّيْفِ فِي أَسْنَانِ  مَرْحَبٍ  "" .","","Al-Mu'jam al-Kabir 509","","هند بنت أبي أمية زوج رسول الله عن بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن عبد الله بن سالم أبو قتيبة عن يحيى بن واضح الأنصاري عن علي ابن المديني عن الفضل بن الحباب الجمحي عن الطبراني","بريدة بن الحصيب الأسلمي عن أم سلمة"
"21108","510  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  مُحَمَّدُ بْنُ حُمَيْدٍ ،  ثَنَا  أَبُو تُمَيْلَةَ ،  ثَنَا  عَبْدُ الْمُؤْمِنِ بْنُ خَالِدٍ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا زَالَ  جِبْرِيلُ  يُوصِينِي بِالسِّوَاكِ حَتَّى خِفْتُ عَلَى أَضْرَاسِي  .","","Al-Mu'jam al-Kabir 510","","هند بنت أبي أمية زوج رسول الله عن بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن عبد المؤمن بن خالد المروزي عن يحيى بن واضح الأنصاري عن محمد بن حميد الرازي عن عبد الله بن أحمد بن حنبل عن الطبراني","بريدة بن الحصيب الأسلمي عن أم سلمة"
"21109","سُلَيْمَانُ بْنُ بُرَيْدَةَ  عَنْ  أُمِّ سَلَمَةَ  .  511  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ،  ثَنَا  أَيُّوبُ الْوَزَّانُ ،         [23/252]      ثَنَا  فُهَيْرُ بْنُ زِيَادٍ ،  ثَنَا  أَبُو شَيْبَةَ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  يَا رَسُولَ اللهِ عَلَى النِّسَاءِ  جِهَادٌ  ، قَالَ : ""  جِهَادُهُنَّ  هَاهُنَا  ، وَأَوْمَأَ بِيَدِهِ نَحْوَ  مَكَّةَ  .","","Al-Mu'jam al-Kabir 511","","هند بنت أبي أمية زوج رسول الله عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن إبراهيم بن عثمان أبو شيبة العبسي عن يحيى بن زياد بن أبي داود الحراني عن أيوب بن محمد الوزان عن الحسن بن علي بن شبيب المعمري عن الطبراني","سليمان بن بريدة عن أم سلمة"
"21110","أَبُو رَافِعٍ  عَنْ  أُمِّ سَلَمَةَ  .  512  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مُخَوَّلِ بْنِ رَاشِدٍ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي رَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  نَهَى أَنْ يُصَلِّيَ الرَّجُلُ ، وَرَأْسُهُ  مَعْقُوصٌ  .","","Al-Mu'jam al-Kabir 512","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن سعيد المقبري عن مخول بن راشد النهدي عن سفيان الثوري عن موسى بن مسعود النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو رافع عن أم سلمة"
"21111","أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ  عَنْ  أُمِّ سَلَمَةَ  أَبُو إِسْحَاقَ  عَنْ  أَبِي سَلَمَةَ  .  513  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  ثَنَا  عَبْدُ الرَّزَّاقِ ،  ثَنَا  الثَّوْرِيُّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  وَالَّذِي تُوُفِّيَ نَفْسُهُ ،  تَعْنِي النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - مَا تُوُفِّيَ حَتَّى كَانَ أَكْثَرُ صَلَاتِهِ قَاعِدًا إِلَّا الْمَكْتُوبَةَ  ، وَكَانَ أَعْجَبُ الْعَمَلِ إِلَيْهِ الَّذِي يَدُومُ عَلَيْهِ صَاحِبُهُ ، وَإِنْ كَانَ يَسِيرًا  .","","Al-Mu'jam al-Kabir 513","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن أبو إسحاق السبيعي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","أبو إسحاق عن أبي سلمة"
"21112","514  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  ابْنُ الْأَصْبَهَانِيِّ ، (  ح  ) .  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ طُفَيْلٍ ، قَالَا :  ثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ أَحَبُّ الْأَعْمَالِ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - مَا  دِيمَ  عَلَيْهِ وَإِنْ قَلَّ  .","","Al-Mu'jam al-Kabir 514","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن محمد بن الطفيل بن مالك النخعي عن أحمد بن عمرو بن حفص القريعي عن الطبراني","أبو إسحاق عن أبي سلمة"
"21113","[23/253]      515  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  نَصْرُ بْنُ عَلِيٍّ ،  ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ الْبَكَّائِيُّ ،  ثَنَا  رَحِيلُ بْنُ مُعَاوِيَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  مَا مَاتَ حَتَّى كَانَ أَكْثَرُ صَلَاتِهِ قَاعِدًا  ، وَكَانَ أَحَبُّ الْعَمَلِ إِلَيْهِ مَا دَاوَمَ عَلَيْهِ صَاحِبُهُ ، وَإِنْ قَلَّ "" ،  تَعْنِي النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .","","Al-Mu'jam al-Kabir 515","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن أبو إسحاق السبيعي عن رحيل بن معاوية الجعفي عن زياد بن عبد الله البكائي عن نصر بن علي بن نصر الجهضمي عن محمد بن صالح النرسي عن الطبراني","أبو إسحاق عن أبي سلمة"
"21114","516  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  وَالَّذِي ذَهَبَ بِنَفْسِهِ مَا مَاتَ حَتَّى كَانَتْ أَكْثَرُ صَلَاتِهِ وَهُوَ جَالِسٌ  ، وَكَانَ أَحَبَّ الْأَعْمَالِ إِلَيْهِ الْعَمَلُ الصَّالِحُ الَّذِي يَدُومُ عَلَيْهِ الْعَبْدُ ، وَإِنْ كَانَ يَسِيرًا  .","","Al-Mu'jam al-Kabir 516","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو إسحاق عن أبي سلمة"
"21115","517  -  حَدَّثَنَا  أَبُو يَحْيَى الدَّارِيُّ [ الرَّازِيُّ ] ،  ثَنَا  مَحْمُودُ بْنُ غَيْلَانَ ،  ثَنَا  مُؤَمَّلٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَسْأَلِ الْمَرْأَةُ طَلَاقَ أُخْتِهَا  لِتَكْتَفِئَ  مَا فِي صَحْفَتِهَا  ، فَإِنَّمَا رِزْقُهَا عَلَى اللهِ - عَزَّ وَجَلَّ  - "" .","","Al-Mu'jam al-Kabir 517","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن أبو إسحاق السبيعي عن سفيان الثوري عن مؤمل بن إسماعيل العدوي عن محمود بن غيلان المروزي عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","أبو إسحاق عن أبي سلمة"
"21116","518  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ، وَمُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالُوا :  ثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ الْعَيْشِيُّ ،  ثَنَا  أَبُو قُتَيْبَةَ ،  عَنْ  إِسْرَائِيلَ بْنِ يُونُسَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّهُ أَتَاهَا فَلَفَّ رِدَاءَهُ وَوَضَعَهُ عَلَى أُسْكُفَّةِ الْبَابِ وَاتَّكَأَ عَلَيْهِ  وَقَالَ : "" هَلْ لَكِ يَا  أُمَّ سَلَمَةَ  ؟ "" ، قَالَتْ : إِنِّي امْرَأَةٌ         [23/254]      شَدِيدَةُ الْغَيْرَةِ ، وَأَخَافُ أَنْ يَبْدُوَ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنِّي مَا يَكْرَهُ ، فَانْصَرَفَ ثُمَّ عَادَ وَقَالَ : "" هَلْ لَكِ يَا  أُمَّ سَلَمَةَ  ؟ إِنْ كَانَ بِكِ الزِّيَادَةُ فِي صَدَاقِكِ زِدْنَا "" ، فَعَادَتْ لِقَوْلِهَا ، فَقَالَتْ  أُمُّ عَبْدٍ  : يَا  أُمَّ سَلَمَةَ  تَدْرِينَ مَا تَتَحَدَّثُ بِهِ نِسَاءُ  قُرَيْشٍ  ؟ تَقُلْنَ إِنَّ  أُمَّ سَلَمَةَ  إِنَّمَا رَدَّتْ  مُحَمَّدًا  لِأَنَّهَا أَرَادَتْ شَابًّا مِنْ  قُرَيْشٍ  أَحْدَثَ مِنْهُ سِنًّا وَأَكْثَرَ مَالًا ، قَالَتْ : فَأَتَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَتَزَوَّجَهَا  .","","Al-Mu'jam al-Kabir 518","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن سلم بن قتيبة الشعيري عن محمد بن بكار العيشي عن عبد الله بن أحمد الجواليقي عن الطبراني","أبو إسحاق عن أبي سلمة"
"21117","عَمَّارٌ الدُّهْنِيُّ  عَنْ  أَبِي سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  519  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَمَّارٍ الدُّهْنِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قَوَائِمُ مِنْبَرِي رَوَاتِبُ فِي الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 519","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن عمار بن معاوية الدهني عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمار الدهني عن أبي سلمة عن أم سلمة"
"21118","520  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  ابْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  شُعْبَةَ ،  عَنْ  عَمَّارٍ الدُّهْنِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قَوَائِمُ مِنْبَرِي رَوَاتِبُ فِي الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 520","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن عمار بن معاوية الدهني عن شعبة بن الحجاج عن وكيع بن الجراح عن عبد الله بن عمر مشكدانة عن عبد الله بن أحمد بن حنبل عن الطبراني","عمار الدهني عن أبي سلمة عن أم سلمة"
"21119","521  -  حَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ ،  ثَنَا  أَبُو الْوَلِيدِ ،  ثَنَا  زَائِدَةُ ،  عَنْ  عَمَّارِ بْنِ أَبِي مُعَاوِيَةَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كُنْتُ أَغْتَسِلُ أَنَا وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ إِنَاءٍ وَاحِدٍ  .         [23/255]","","Al-Mu'jam al-Kabir 521","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن عمار بن معاوية الدهني عن زائدة بن قدامة عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","عمار الدهني عن أبي سلمة عن أم سلمة"
"21120","522  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ النَّضْرِ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  عَمَّارٍ الدُّهْنِيِّ نَحْوَهُ .","","Al-Mu'jam al-Kabir 522","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن عمار بن معاوية الدهني عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","عمار الدهني عن أبي سلمة عن أم سلمة"
"21121","523  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُسْلِمِ بْنِ وَارَةَ ،  ثَنَا  مُحَمَّدُ بْنُ سَعِيدِ بْنِ سَابِقٍ ،  ثَنَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  عَمَّارٍ الدُّهْنِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 523","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن عمار بن معاوية الدهني عن عمرو بن أبي قيس عن محمد بن سعيد القزويني عن ابن وارة عن علي بن سعيد بن بشير عليك عن الطبراني","عمار الدهني عن أبي سلمة عن أم سلمة"
"21122","524  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  تَمِيمُ بْنُ الْمُنْتَصِرِ ،  ثَنَا  إِسْحَاقُ ،  عَنْ  شَرِيكٍ ،  عَنْ  عَمَّارٍ الدُّهْنِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ : "" يَخْطُبُ إِلَى جِذْعٍ فِي الْمَسْجِدِ ، فَلَمَّا صُنِعَ الْمِنْبَرُ  حَنَّ  الْجِذْعُ فَاعْتَنَقَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَكَنَ  .","","Al-Mu'jam al-Kabir 524","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن عمار بن معاوية الدهني عن شريك بن عبد الله النخعي عن إسحاق بن يوسف الأزرق عن تميم بن المنتصر مولى ابن عباس عن محمود بن محمد بن منويه المفيد عن الطبراني","عمار الدهني عن أبي سلمة عن أم سلمة"
"21123","525  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُسْلِمِ بْنِ وَارَةَ ،  ثَنَا  مُحَمَّدُ بْنُ سَعِيدِ بْنِ سَابِقٍ ،  ثَنَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  عَمَّارٍ الدُّهْنِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 525","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن عمار بن معاوية الدهني عن عمرو بن أبي قيس عن محمد بن سعيد القزويني عن ابن وارة عن علي بن سعيد بن بشير عليك عن الطبراني","عمار الدهني عن أبي سلمة عن أم سلمة"
"21124","526  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمَّارٍ الدُّهْنِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا بَيْنَ بَيْتِي وَمِنْبَرِي رَوْضَةٌ مِنْ رِيَاضِ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 526","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن عمار بن معاوية الدهني عن سفيان بن عيينة عن محمد بن الصباح الجرجرائي عن الحسين بن إسحاق التستري عن الطبراني","عمار الدهني عن أبي سلمة عن أم سلمة"
"21125","[23/256]      سَالِمُ بْنُ أَبِي الْجَعْدِ  عَنْ  أَبِي سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  527  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  شُعْبَةُ بْنُ الْحَجَّاجِ ،  عَنْ  مَنْصُورٍ ، قَالَ :  سَمِعْتُ  سَالِمَ بْنَ أَبِي الْجَعْدِ ،  يُحَدِّثُ عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ : "" لَا يَصُومُ شَهْرًا كَامِلًا  ، إِلَّا أَنَّهُ كَانَ يَصُومُ شَعْبَانَ وَيَصِلُهُ بِرَمَضَانَ  .","","Al-Mu'jam al-Kabir 527","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن سالم بن أبي الجعد الغطفاني عن منصور بن المعتمر عن شعبة بن الحجاج عن عاصم بن علي الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سالم بن أبي الجعد عن أبي سلمة عن أم سلمة"
"21126","528  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَائِشَةَ ، وَأُمِّ سَلَمَةَ ، قَالَتَا :  مَا كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَصُومُ شَهْرًا سِوَى رَمَضَانَ إِلَّا شَعْبَانَ  ، فَإِنَّهُ كَانَ يَصِلُهُ بِرَمَضَانَ ، فَيَكُونُ شَهْرَيْنِ مُتَتَابِعَيْنِ ، وَكَانَ يَصُومُ  الشَّهْرَ  حَتَّى نَقُولَ لَا يُفْطِرُ وَيُفْطِرُ حَتَّى نَقُولَ لَا يَصُومُ  .","","Al-Mu'jam al-Kabir 528","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن سالم بن أبي الجعد الغطفاني عن منصور بن المعتمر عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","سالم بن أبي الجعد عن أبي سلمة عن أم سلمة"
"21127","529  -  حَدَّثَنَا  الْحُسَيْنُ ،  ثَنَا  يَحْيَى ،  ثَنَا  وَكِيعٌ ،  عَنْ  أَبِيهِ  ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ : "" يَصُومُ شَعْبَانَ وَرَمَضَانَ  .","","Al-Mu'jam al-Kabir 529","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن سالم بن أبي الجعد الغطفاني عن منصور بن المعتمر عن الجراح بن مليح الرؤاسي والد وكيع عن وكيع بن الجراح عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","سالم بن أبي الجعد عن أبي سلمة عن أم سلمة"
"21128","530  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  عَلِيُّ بْنُ حَرْبٍ ،  ثَنَا  سُلَيْمَانُ بْنُ أَبِي هَوْذَةَ ،  عَنْ  عَمْرِو بْنِ أَبِي قَيْسٍ ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  أَبِي سَلَمَةَ ، نَحْوَهُ .","","Al-Mu'jam al-Kabir 530","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن سالم بن أبي الجعد الغطفاني عن منصور بن المعتمر عن عمرو بن أبي قيس عن سليمان بن أبى هوذة عن علي بن حرب الجند يسابوري عن عبد الله بن أحمد الجواليقي عن الطبراني","سالم بن أبي الجعد عن أبي سلمة عن أم سلمة"
"21129","عَبْدُ الْعَزِيزِ بْنُ رُفَيْعٍ  عَنْ  أَبِي سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  531  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ حَمْدَانَ الْحَنَفِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ         [23/257]      عَبْدِ الرَّحِيمِ أَبُو يَحْيَى صَاعِقَةُ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ  جَارِيَةً  زَوَّجَهَا أَبُوهَا ، وَأَرَادَتْ أَنْ تَزَوَّجَ رَجُلًا آخَرَ  ، فَأَتَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرَتْ ذَلِكَ لَهُ ، فَنَزَعَهَا مِنَ الرَّجُلِ الَّذِي زَوَّجَهَا أَبُوهَا ، وَزَوَّجَهَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ الَّذِي أَرَادَتْ  .","","Al-Mu'jam al-Kabir 531","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن عبد العزيز بن رفيع الطائفي عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن محمد بن عبد الرحيم  صاعقة عن العباس بن حمدان الأصبهاني عن الطبراني","عبد العزيز بن رفيع عن أبي سلمة عن أم سلمة"
"21130","532  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  رِزْقُ اللهِ بْنُ مُوسَى ،  ثَنَا  شَبَابَةُ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ ، قَالَ :  سَمِعْتُ  أَبَا سَلَمَةَ ،  أَنَّ  أُمَّ سَلَمَةَ سَأَلَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الْمَرْأَةِ تَحْتَلِمُ  ، فَقَالَ : "" تَجِدُ شَهْوَةً ؟ "" ، قَالَتْ : نَعَمْ ، قَالَ : "" فَلْتَغْتَسِلْ  .","","Al-Mu'jam al-Kabir 532","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن عبد العزيز بن رفيع الطائفي عن شعبة بن الحجاج عن شبابة بن سوار المدائني عن رزق الله بن موسى الناجي عن الحسين بن إسحاق التستري عن الطبراني","عبد العزيز بن رفيع عن أبي سلمة عن أم سلمة"
"21131","يَحْيَى بْنُ أَبِي كَثِيرٍ  عَنْ  أَبِي سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  533  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كُنْتُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي لِحَافِهِ فَحِضْتُ  فَانْسَلَلْتُ  مِنْهُ  فَقَالَ : "" مَالَكِ  أَنَفِسْتِ  ؟ "" ،  يَعْنِي الْحَيْضَةَ  ، قُلْتُ : نَعَمْ ، قَالَتْ : فَشَدَدْتُ عَلَيَّ ثِيَابَ حَيْضَتِي ، ثُمَّ رَجَعْتُ فَاضْطَجَعْتُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .","","Al-Mu'jam al-Kabir 533","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","يحيى بن أبي كثير عن أبي سلمة عن أم سلمة"
"21132","534  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،         [23/258]      عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  لَمْ أَرَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعْدَ الْعَصْرِ صَلَّاهَا قَطُّ إِلَّا مَرَّةً ،  وَجَاءَهُ نَاسٌ بَعْدَ الظُّهْرِ فَشَغَلُوهُ حَتَّى نَسِيَ ، فَلَمْ يُصَلِّ بَعْدَ الظُّهْرِ شَيْئًا حَتَّى صَلَّى الْعَصْرَ ، فَلَمَّا صَلَّى الْعَصْرَ دَخَلَ بَيْتِي ، فَصَلَّى رَكْعَتَيْنِ  .","","Al-Mu'jam al-Kabir 534","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","يحيى بن أبي كثير عن أبي سلمة عن أم سلمة"
"21133","535  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ،  ثَنَا  أَحْمَدُ بْنُ أَبِي الْحَوَارِيِّ ،  ثَنَا  الْوَلِيدُ ،  ثَنَا  شَيْبَانُ ،  عَنْ  يَحْيَى ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا قَلِيلَ مِنْ أَذَى الْجَارِ  .","","Al-Mu'jam al-Kabir 535","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن شيبان بن عبد الرحمن المؤدب عن الوليد بن مسلم القرشي عن أحمد بن عبد الله بن ميمون عن أحمد بن محمد بن الحجاج المصري عن الطبراني","يحيى بن أبي كثير عن أبي سلمة عن أم سلمة"
"21134","536  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ  سُبَيْعَةَ الْأَسْلَمِيَّةَ  وَضَعَتْ بَعْدَ وَفَاةِ زَوْجِهَا بِعِشْرِينَ لَيْلَةً  ، فَأَمَرَهَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ تَزَوَّجَ  .","","Al-Mu'jam al-Kabir 536","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","يحيى بن أبي كثير عن أبي سلمة عن أم سلمة"
"21135","537  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ بَزِيعٍ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  حَجَّاجٌ ،  عَنْ  يَحْيَى ،  عَنْ  أَبِي سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 537","","أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن حجاج بن أبى عثمان الصواف الكندي عن يزيد بن زريع العيشي عن محمد بن عبد الله بن بزيع البصري عن أحمد بن يحيى بن زهير التستري عن الطبراني","يحيى بن أبي كثير عن أبي سلمة عن أم سلمة"
"21136","538  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ قِيرَاطٍ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  يُوسُفُ بْنُ السَّفْرِ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  يَحْيَى ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا بَأْسَ بِمَسْكِ الْمَيْتَةِ إِذَا دُبِغَ  .","","Al-Mu'jam al-Kabir 538","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن يوسف بن السفر الدمشقي عن سليمان بن عبد الرحمن التميمي عن إسماعيل بن محمد بن عبيد الله العذري عن الطبراني","يحيى بن أبي كثير عن أبي سلمة عن أم سلمة"
"21137","[23/259]      539  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدِ بْنِ عُقْبَةَ ،  ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ،  أَخْبَرَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ  امْرَأَةً  وَهَبَ لَهَا  رَجُلٌ  شَاةً  تَصَدَّقَ  بِهَا عَلَيْهَا  ، "" فَأَمَرَهَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَقْبَلَهَا  .","","Al-Mu'jam al-Kabir 539","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن معمر بن راشد عن عبد الرزاق الصنعاني عن الحسن بن علي الريحاني عن محمد بن محمد بن عقبة الشيباني عن الطبراني","يحيى بن أبي كثير عن أبي سلمة عن أم سلمة"
"21138","عَبْدُ اللهِ بْنُ أَبِي لَبِيدٍ  ، عَنْ  أَبِي سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  540  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي لَبِيدٍ ، قَالَ :  سَمِعْتُ  أَبَا سَلَمَةَ بْنَ عَبْدِ الرَّحْمَنِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  دَخَلَ عَلَيَّ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمًا ، فَصَلَّى رَكْعَتَيْنِ بَعْدَ الْعَصْرِ  ، وَلَمْ أَكُنْ أَرَاهُ يُصَلِّيهِمَا فَقُلْتُ : يَا رَسُولَ اللهِ مَا هَاتَانِ الرَّكْعَتَانِ ، قَالَ : "" قَدِمَ وَفْدُ  بَنِي تَمِيمٍ  ، فَكُنْتُ أُصَلِّي رَكْعَتَيْنِ بَعْدَ الظُّهْرِ ، فَلَمْ أَكُنْ صَلَّيْتُهُمَا فَهُمَا هَاتَانِ  .","","Al-Mu'jam al-Kabir 540","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن عبد الله بن أبي لبيد مولى الأخنس بن شريق عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عبد الله بن أبي لبيد عن أبي سلمة عن أم سلمة"
"21139","عَنْبَسَةُ بْنُ عَمَّارٍ الْمَدَنِيُّ  عَنْ  أَبِي سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  رَضِيَ اللهُ عَنْهَا .  541  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ ،  ثَنَا  أَبِي  ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  دُحَيْمٌ ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  ثَنَا  عَنْبَسَةُ بْنُ عَمَّارٍ ،  ثَنَا  أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" اغْتَسَلَ هُوَ وَالْمَرْأَةُ مِنْ أَزْوَاجِهِ  مِنْ إِنَاءٍ وَاحِدٍ  .","","Al-Mu'jam al-Kabir 541","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن عنبسة بن عمار الحجازي عن مروان بن معاوية الفزاري عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","عنبسة بن عمار المدني عن أبي سلمة عن أم سلمة رضي الله عنها"
"21140","خَالِدُ بْنُ إِيَاسٍ  عَنْ  أَبِي سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  542  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ بْنِ         [23/260]      ثَعْلَبَةَ ،  ثَنَا  أَبُو يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  خَالِدُ بْنُ إِيَاسٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" يَسْتَحِبُّ يَوْمَ الْخَمِيسِ أَنْ يُسَافَرَ فِيهِ  .","","Al-Mu'jam al-Kabir 542","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن خالد بن الياس العدوي عن عبد الحميد بن عبد الرحمن بشمين عن الجرب ، محمد بن عبيد بن محمد بن ثعلبة عن الحسين بن إسحاق التستري عن الطبراني","خالد بن إياس عن أبي سلمة عن أم سلمة"
"21141","543  -  حَدَّثَنَا  عَلَّانُ بْنُ عَبْدِ الصَّمَدِ ،  ثَنَا  ابْنُ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  عَنْ  خَالِدِ بْنِ إِيَاسٍ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" يَسْتَحِبُّ أَنْ يُسَافِرَ يَوْمَ الْخَمِيسِ  .","","Al-Mu'jam al-Kabir 543","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن محمد بن المنكدر عن خالد بن الياس العدوي عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن علي بن عبد الصمد علان ماغمه عن الطبراني","خالد بن إياس عن أبي سلمة عن أم سلمة"
"21142","أَبُو صَالِحٍ السَّمَّانُ  عَنْ  أَبِي سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  544  -  حَدَّثَنَا  عَلِيُّ بْنُ إِسْحَاقَ الْأَصْبَهَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ زُنْبُورٍ ،  ثَنَا  فُضَيْلُ بْنُ عِيَاضٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا رَأَى أَحَدُكُمْ فِي مَنَامِهِ مَا يَكْرَهُ ، فَلْيَنْفُثْ عَنْ يَسَارِهِ ثَلَاثًا  ، وَلْيَسْتَعِذْ مِمَّا رَأَى  .","","Al-Mu'jam al-Kabir 544","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن ذكوان السمان عن الأعمش عن الفضيل بن عياض عن محمد بن زنبور الهاشمي عن الوزير علي بن إسحاق بن إبراهيم عن الطبراني","أبو صالح السمان عن أبي سلمة عن أم سلمة"
"21143","مُحَمَّدُ بْنُ إِبْرَاهِيمَ التَّيْمِيُّ  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  .  545  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  ثَنَا  أَبِي  ،  ثَنَا  شُعْبَةُ ،  عَنْ  تَوْبَةَ الْعَنْبَرِيِّ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  مَا صَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - شَهْرًا كَامِلًا ،  إِلَّا شَعْبَانَ كَانَ يَصِلُهُ بِرَمَضَانَ  .","","Al-Mu'jam al-Kabir 545","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن محمد بن إبراهيم بن الحارث التيمي عن توبة بن أبي الأسد العنبري عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن الحسين بن إسحاق التستري عن الطبراني","محمد بن إبراهيم التيمي عن أبي سلمة عن أم سلمة"
"21144","[23/261]      [  عَبْدُ رَبِّهِ  عَنْ  أَبِي سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  ] .  546  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ، وَأَحْمَدُ بْنُ زُهَيْرٍ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  ثَنَا  ابْنُ أَبِي عَدِيٍّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَبْدِ رَبِّهِ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  وَضَعَتْ  سُبَيْعَةُ  بَعْدَ وَفَاةِ زَوْجِهَا ، فَخَطَبَهَا رَجُلَانِ ، فَقَالُوا : لَمْ تَحِلَّ ، فَذَكَرَتْ ذَلِكَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قَدْ أَحْلَلْتِ فَتَزَوَّجِي مَنْ شِئْتِ  .","","Al-Mu'jam al-Kabir 546","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن عبد ربه بن سعيد النجاري عن شعبة بن الحجاج عن محمد بن إبراهيم بن أبي عدي القسملي عن محمد بن بشار بندار عن أحمد بن يحيى بن زهير التستري عن الطبراني","عبد ربه عن أبي سلمة عن أم سلمة"
"21145","547  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ [الْكَشِّيُّ قَالَا :  ثَنَا  ]  ، عَنْ  مَالِكٍ ، (  ح  ) .  وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  أَنَا  مَالِكٌ ،  عَنْ  عَبْدِ رَبِّهِ بْنِ سَعِيدٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  وَلَدَتْ  سُبَيْعَةُ الْأَسْلَمِيَّةُ  بَعْدَ وَفَاةِ زَوْجِهَا بِنِصْفِ شَهْرٍ ، فَخَطَبَهَا رَجُلَانِ أَحَدُهُمَا شَابٌّ ، وَالْآخَرُ كَهْلٌ ،  فَحَطَّتْ  إِلَى الشَّابِّ ، فَقَالَ : الْكَهْلُ لَمْ تَحِلَّ ، وَكَانَ أَهْلُهَا غُيَّبًا ، وَرَجَا إِذَا جَاءَ أَهْلُهَا أَنْ يُؤْثِرُوهُ [ بِهَا ] ، فَجَاءَتْ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  قَدْ حَلَلْتِ فَانْكِحِي مَنْ شِئْتِ  .  سقط من طبعة مكتبة ابن تيمية والمثبت من النسخ الخطية .","","Al-Mu'jam al-Kabir 547","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن عبد ربه بن سعيد النجاري عن مالك بن أنس عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","عبد ربه عن أبي سلمة عن أم سلمة"
"21146","الْحَاطِبِيُّ  عَنْ  أَبِي سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  548  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَعْلَى بْنُ عُبَيْدٍ ،  حَدَّثَنَا  الْحَاطِبِيُّ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أُمِّ         [23/262]      سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" يَغْتَسِلُ وَبَعْضُ نِسَائِهِ مِنَ الْإِنَاءِ الْوَاحِدِ  .","","Al-Mu'jam al-Kabir 548","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن الحاطبي عن يعلى بن عبيد الطنافسي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","الحاطبي عن أبي سلمة عن أم سلمة"
"21147","سَعِيدٌ الْمَقْبُرِيُّ  عَنْ  أَبِي سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  549  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَالِكٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّ أُمَّ سَلَمَةَ  أَخْبَرَتْهُ  أَنَّ  سُبَيْعَةَ وَلَدَتْ بَعْدَ وَفَاةِ زَوْجِهَا بِنِصْفِ شَهْرٍ  "" .","","Al-Mu'jam al-Kabir 549","","سبيعة بنت الحارث الأسلمية عن هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن سعيد المقبري عن مالك بن أنس عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سعيد المقبري عن أبي سلمة عن أم سلمة"
"21148","عَوْنُ بْنُ عَبْدِ اللهِ بْنِ عُتْبَةَ  عَنْ  أَبِي سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  550  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ صَدَقَةَ ، وَحُسَيْنُ بْنُ مُحَمَّدٍ الْخَيَّاطُ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ الْحَسَنِ بْنِ عَنْبَسَةَ ،  ثَنَا  أَبُو دَاوُدَ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَوْنِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا مِنْ عَبْدٍ يُصَابُ بِمُصِيبَةٍ ، فَيَقُولُ إِنَّا لِلهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ  ، اللَّهُمَّ عِنْدَكَ أَحْتَسِبُ مُصِيبَتِي ، فَأْجُرْنِي فِيهَا خَيْرًا مِنْهَا ، إِلَّا آجَرَهُ اللهُ فِي مُصِيبَتِهِ ، فَأَعْقَبَهُ اللهُ خَيْرًا مِنْهَا  .","","Al-Mu'jam al-Kabir 550","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن عون بن عبد الله بن عتبة عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن أبو داود الطيالسي عن حماد بن الحسن بن عنبسة النهشلي عن الحسين بن محمد بن عبد الرحمن الخياط عن الطبراني","عون بن عبد الله بن عتبة عن أبي سلمة عن أم سلمة"
"21149","الزُّهْرِيُّ  عَنْ  أَبِي سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  551  -  حَدَّثَنَا  أَبُو يَحْيَى عَبْدُ الرَّحْمَنِ بْنُ سَالِمٍ الرَّازِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  عَبْدُ الرَّحِيمِ  عن  إِسْمَاعِيلَ بْنِ مُسْلِمٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ : "" يُقَبِّلُهَا وَهُوَ صَائِمٌ  .  في نسخة كوبرلي : (عبد الرحمن) .","","Al-Mu'jam al-Kabir 551","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن الزهري عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن عبد الرحيم بن سليمان الأشل عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","الزهري عن أبي سلمة عن أم سلمة"
"21150","[23/263]      552  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ الْعَبَّادِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ الْوَاسِطِيُّ ،  ثَنَا  يَحْيَى بْنُ الْمُتَوَكِّلِ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُسْلِمٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنْ كَانَ لَفِي أَوَّلِ مَا نَهَانِي عَنْهُ رَبِّي  ، وَعَهِدَ إِلَيَّ فِيهِ بَعْدَ عِبَادَةِ الْأَوْثَانِ وَشُرْبِ الْخَمْرِ :  مُلَاحَاةُ  الرِّجَالِ  .","","Al-Mu'jam al-Kabir 552","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن الزهري عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن يحيى بن المتوكل الحذاء عن عبد الله بن داود الواسطي عن عبد الله بن محمد العبادي عن أحمد بن يحيى بن زهير التستري عن الطبراني","الزهري عن أبي سلمة عن أم سلمة"
"21151","مُحَمَّدُ بْنُ عَمْرِو بْنِ عَلْقَمَةَ  عَنْ  أَبِي سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  553  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَالِمٍ الرَّازِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  الْمُحَارِبِيُّ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  دَخَلَتِ  امْرَأَةٌ  عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ فِي بَيْتِ  أُمِّ سَلَمَةَ  ، فَقَالَتْ : يَا رَسُولَ اللهِ أَرَأَيْتَ الْمَرْأَةَ تَرَى فِي مَنَامِهَا مَا يَرَى الرَّجُلُ ، قَالَتْ  أُمُّ سَلَمَةَ  :  تَبًّا  لَكِ فَضَحْتِ النِّسَاءَ ، قَالَتْ : إِنَّ اللهَ لَا يَسْتَحْيِي مِنَ الْحَقِّ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" مَنْ رَأَى ذَلِكَ مِنْكُنَّ فَلْتَغْتَسِلْ  .","","Al-Mu'jam al-Kabir 553","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عبد الرحمن بن محمد المحاربي عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","محمد بن عمرو بن علقمة عن أبي سلمة عن أم سلمة"
"21152","554  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  قُلْتُ : "" يَا رَسُولَ اللهِ إِنَّ اللهَ يَذْكُرُ الرِّجَالَ فِي كُلِّ شَيْءٍ  ، وَلَا يَذْكُرُنَا ، فَأَنْزَلَ اللهُ         {      إِنَّ الْمُسْلِمِينَ وَالْمُسْلِمَاتِ وَالْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ         }      الْآيَةَ إِلَى آخِرِهَا  .","","Al-Mu'jam al-Kabir 554","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن أبو معاوية الضرير عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","محمد بن عمرو بن علقمة عن أبي سلمة عن أم سلمة"
"21153","555  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  ) .         [23/264]      وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  ثَنَا  أَبُو سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كُنْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي لِحَافٍ  ، فَوَجَدْتُ مَا تَجِدُ النِّسَاءُ مِنَ الْحَيْضَةِ ، قَالَ : "" ذَاكَ مَا كُتِبَ عَلَى بَنَاتِ آدَمَ "" ،  فَانْسَلَلْتُ  فَأَصْلَحْتُ مِنْ شَأْنِي ، ثُمَّ رَجَعْتُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" تَعَالَيْ فَادْخُلِي مَعِي فِي اللِّحَافِ "" ، قَالَتْ : فَدَخَلْتُ مَعَهُ  .","","Al-Mu'jam al-Kabir 555","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن محمد بن بشر بن الفرافصة عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","محمد بن عمرو بن علقمة عن أبي سلمة عن أم سلمة"
"21154","556  -  حَدَّثَنَا  عَبَّادُ بْنُ عَبْدِ اللهِ ،  ثَنَا  يَزِيدُ بْنُ حَكِيمٍ  ،  ثَنَا  سُفْيَانُ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  تُوُفِّيَ زَوْجُ  سُبَيْعَةَ بِنْتِ الْحَارِثِ  ، فَوَضَعَتْ بَعْدَ وَفَاتِهِ بِأَيَّامٍ  ، فَأَمَرَهَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ تَزَوَّجَ  .  كذا في طبعة مكتبة ابن تيمية ، ولعل الصواب (بن أبي حكيم).","","Al-Mu'jam al-Kabir 556","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن سفيان الثوري عن يزيد بن أبي حكيم الكناني عن عباد بن عبد الله عن الطبراني","محمد بن عمرو بن علقمة عن أبي سلمة عن أم سلمة"
"21155","557  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَالِمٍ الرَّازِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  جُنَادَةُ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ كَانَ لَهُ  ذِبْحٌ  يُرِيدُ أَنْ يَذْبَحَهُ  ، فَإِذَا أَهَلَّ هِلَالُ ذِي الْحِجَّةِ ، فَلَا يَمَسَّ مِنْ شَعَرِهِ ، وَلَا مِنْ أَظْفَارِهِ شَيْئًا حَتَّى يَذْبَحَ  .","","Al-Mu'jam al-Kabir 557","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن جنادة بن سلم العامري عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","محمد بن عمرو بن علقمة عن أبي سلمة عن أم سلمة"
"21156","الْوَازِعُ بْنُ نَافِعٍ  عَنْ  أَبِي سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  558  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ         [23/265]      الصَّبَّاحِ الْجَرْجَرَائِيُّ ،  ثَنَا  عَلِيُّ بْنُ ثَابِتٍ ،  عَنِ  الْوَازِعِ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  دَخَلَتْ عَلَيْنَا  جَارِيَةٌ لِحَسَّانَ بْنِ ثَابِتٍ  يَوْمَ فِطْرٍ نَاشِرَةً شَعَرَهَا  ، مَعَهَا دُفٌّ تُغَنِّي ،  فَزَجَرَتْهَا  أُمُّ سَلَمَةَ  ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" دَعِيهَا يَا  أُمَّ سَلَمَةَ  فَإِنَّ لِكُلِّ قَوْمٍ عِيدًا ، وَهَذَا يَوْمُ عِيدِنَا  .","","Al-Mu'jam al-Kabir 558","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن الوازع بن نافع العقيلي عن علي بن ثابت الجزري عن محمد بن الصباح الجرجرائي عن محمود بن محمد بن منويه المفيد عن الطبراني","الوازع بن نافع عن أبي سلمة عن أم سلمة"
"21157","سَالِمُ أَبُو النَّضْرِ  عَنْ  أَبِي سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  559  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ،  ثَنَا  سُرَيْجُ بْنُ النُّعْمَانِ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  سَالِمٍ أَبِي النَّضْرِ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  جَاءَتِ  امْرَأَةٌ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ : إِنِّي أُسْتَحَاضُ  ، قَالَ : "" لَيْسَ ذَاكَ بِالْحَيْضِ إِنَّمَا هُوَ  عِرْقٌ  لِتَقْعُدِ الْمَرْأَةُ أَيَّامَ  أَقْرَائِهَا  ، ثُمَّ لِتَغْتَسِلْ ، ثُمَّ  لِتَسْتَثْفِرْ  بِثَوْبٍ ، وَتُصَلِّي  .","","Al-Mu'jam al-Kabir 559","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن سالم بن أبي أمية التيمي عن عبد الله بن عمر العمري عن سريج بن النعمان الجوهري عن لحية الليف محمد بن العباس عن الطبراني","سالم أبو النضر عن أبي سلمة عن أم سلمة"
"21158","يَزِيدُ بْنُ أَبِي حَبِيبٍ  عَنْ  أَبِي سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  560  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  بُنْدَارٌ ، (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحٍ النَّرْسِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَا :  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  ثَنَا  أَبِي  ،  عَنْ  يَحْيَى بْنِ أَيُّوبَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَخْرِجُوا الْيَهُودَ مِنْ  جَزِيرَةِ الْعَرَبِ  .","","Al-Mu'jam al-Kabir 560","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن يزيد بن أبي حبيب الأزدي عن يحيى بن أيوب الغافقي عن جرير بن حازم عن وهب بن جرير بن حازم عن أبو موسى الزمن عن محمد بن صالح النرسي عن الطبراني","يزيد بن أبي حبيب عن أبي سلمة عن أم سلمة"
"21159","561  -  وَبِإِسْنَادِهِ  عَنْهَا  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [23/266]      أَوْصَى عِنْدَ وَفَاتِهِ فَقَالَ :  اللهَ اللهَ فِي قِبْطِ  مِصْرَ  ، فَإِنَّكُمْ سَتَظْهَرُونَ عَلَيْهِمْ ، وَيَكُونُونَ لَكُمْ عِدَّةً  ، وَأَعْوَانًا فِي  سَبِيلِ  اللهِ  .","","Al-Mu'jam al-Kabir 561","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن يزيد بن أبي حبيب الأزدي عن يحيى بن أيوب الغافقي عن جرير بن حازم عن وهب بن جرير بن حازم عن أبو موسى الزمن عن محمد بن صالح النرسي عن الطبراني","يزيد بن أبي حبيب عن أبي سلمة عن أم سلمة"
"21160","سَعِيدُ بْنُ الْمُسَيِّبِ  عَنْ  أُمِّ سَلَمَةَ  .  562  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْقَعْنَبِيُّ (  ح  ) .  وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ، قَالَا :  ثَنَا  مَالِكٌ ،  عَنْ  عَمْرِو بْنِ مُسْلِمٍ الْجُنْدَعِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا دَخَلَ الْعَشْرُ فَمَنْ أَرَادَ أَنْ يُضَحِّيَ  ، فَلَا يَأْخُذْ مِنْ شَعَرِهِ وَلَا مِنْ أَظْفَارِهِ  .","","Al-Mu'jam al-Kabir 562","","هند بنت أبي أمية زوج رسول الله عن سعيد بن المسيب عن عمرو بن مسلم بن عمارة الجندعي عن مالك بن أنس عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","سعيد بن المسيب عن أم سلمة"
"21161","563  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ ،  ثَنَا  أَبُو صَالِحٍ ،  ثَنَا  اللَّيْثُ ،  عَنْ  خَالِدِ بْنِ يَزِيدَ ،  عَنْ  سَعِيدِ بْنِ أَبِي هِلَالٍ ،  عَنْ  عَمْرِو بْنِ مُسْلِمٍ الْجُنْدَعِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 563","","هند بنت أبي أمية زوج رسول الله عن سعيد بن المسيب عن عمرو بن مسلم بن عمارة الجندعي عن سعيد بن أبي هلال الليثي عن خالد بن يزيد الجمحي عن الليث بن سعد عن عبد الله بن صالح المصري عن يحيى بن عثمان بن صالح عن الطبراني","سعيد بن المسيب عن أم سلمة"
"21162","564  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  عَمْرُو بْنُ حَكَّامٍ ،  ثَنَا  شُعْبَةُ ،         [23/267]      عَنْ  مَالِكٍ ،  عَنْ  عَمْرِو بْنِ مُسْلِمٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 564","","هند بنت أبي أمية زوج رسول الله عن سعيد بن المسيب عن عمرو بن مسلم بن عمارة الجندعي عن مالك بن أنس عن شعبة بن الحجاج عن عمرو بن حكام الزنجبيلي عن بشر بن موسى بن صالح الأسدي عن الطبراني","سعيد بن المسيب عن أم سلمة"
"21163","565  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ ،  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 565","","هند بنت أبي أمية زوج رسول الله عن سعيد بن المسيب عن عبد الرحمن بن حميد بن عبد الرحمن بن عوف عن سفيان بن عيينة عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","سعيد بن المسيب عن أم سلمة"
"21164","566  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ عَبْدِ الْحَمِيدِ ،  ثَنَا  أَبُو الْمَلِيحِ الرَّقِّيُّ ،  عَنْ  زِيَادِ بْنِ بَيَانَ ،  عَنْ  عَلِيِّ بْنِ نُفَيْلٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  ذُكِرَ  الْمَهْدِيُّ  عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ  : "" مِنْ وَلَدِ  فَاطِمَةَ  - رَضِيَ اللهُ عَنْهَا  - "" .","","Al-Mu'jam al-Kabir 566","","هند بنت أبي أمية زوج رسول الله عن سعيد بن المسيب عن علي بن نفيل النهدي عن زياد بن بيان الرقي عن الحسن بن عمر الفزاري عن عبد السلام بن عبد الحميد بن سويد عن الحسين بن إسحاق التستري عن الطبراني","سعيد بن المسيب عن أم سلمة"
"21165","عُرْوَةُ بْنُ الزُّبَيْرِ  عَنْ  أُمِّ سَلَمَةَ  .  567  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  سُلَيْمَانُ بْنُ كَثِيرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، وَأُمِّ سَلَمَةَ ، قَالَتَا :  حَاضَتْ  صَفِيَّةُ بِنْتُ حُيَيٍّ  قَبْلَ  النَّفْرِ  ، فَدَخَلَ عَلَيْهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهِيَ تَبْكِي ، فَقَالَ :  أَحَابِسَتُنَا هِيَ ؟ هَلْ كُنْتِ  أَفَضْتِ  يَوْمَ النَّحْرِ  ؟ "" ، قَالَتْ : نَعَمْ ، قَالَ : "" فَانْفِرِي  .","","Al-Mu'jam al-Kabir 567","","هند بنت أبي أمية زوج رسول الله عن عروة بن الزبير عن الزهري عن سليمان بن كثير الأصيد عن محمد بن كثير العبدي عن محمد بن محمد بن حيان التمار عن الطبراني","عروة بن الزبير عن أم سلمة"
"21166","[23/268]      568  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  دَاوُدُ بْنُ عَمْرٍو الضَّبِّيُّ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  حَدَّثَنِي  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  دَخَلَ عَلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَفُلَانٌ  يَشْتَكِي ، فَقَالَ : "" مَا هَذَا ؟ "" ، فَقُلْنَا : نَتَّهِمُ لَهُ الْعَيْنَ ، فَقَالَ :  أَلَا تَسْتَرْقُونَ لَهُ مِنَ الْعَيْنِ  .","","Al-Mu'jam al-Kabir 568","","هند بنت أبي أمية زوج رسول الله عن عروة بن الزبير عن سليمان بن يسار مولى ميمونة زوج رسول الله عن يحيى بن سعيد الأنصاري عن أبو معاوية الضرير عن داود بن عمرو المسيبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عروة بن الزبير عن أم سلمة"
"21167","569  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ نَافِعٍ الطَّحَّانُ الْمِصْرِيُّ ،  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  مَخْرَمَةُ بْنُ بُكَيْرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ، قَالَ :  قَالَتْ  أُمُّ سَلَمَةَ :  ذَكَرْتُ  الْمَسِيحَ الدَّجَّالَ  لَيْلَةً فَلَمْ يَأْتِنِي النَّوْمُ ، فَلَمَّا أَصْبَحْتُ غَدَوْتُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَخْبَرْتُهُ ، فَقَالَ :  لَا تَفْعَلِي ، فَإِنَّهُ إِنْ يَخْرُجْ وَأَنَا فِيكُمْ يَكْفِيكُمُ اللهُ بِي  ، وَإِنْ يَخْرُجْ بَعْدَ أَنْ أَمُوتَ يَكْفِيكُمُوهُ بِالصَّالِحِينَ "" ثُمَّ قَامَ ، فَذَكَرَ  الدَّجَّالَ  ، فَقَالَ : "" مَا مِنْ نَبِيٍّ إِلَّا قَدْ حَذَّرَهُ أُمَّتَهُ ، وَأَنَا أُحَذِّرُكُمُوهُ ، إِنَّهُ  أَعْوَرُ  ، وَإِنَّ اللهَ لَيْسَ  بِأَعْوَرَ  ، أَلَا إِنَّ  الْمَسِيحَ الدَّجَّالَ  كَأَنَّ عَيْنَهُ عِنَبَةٌ  طَافِيَةٌ  .","","Al-Mu'jam al-Kabir 569","","هند بنت أبي أمية زوج رسول الله عن عروة بن الزبير عن بكير بن عبد الله بن الأشج القرشي عن مخرمة بن بكير المخزومي عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن نافع الطحاوي عن الطبراني","عروة بن الزبير عن أم سلمة"
"21168","570  -  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  عَلِيُّ بْنُ حَرْبٍ الْمَوْصِلِيُّ ،  ثَنَا  هَارُونُ بْنُ عِمْرَانَ ،  ثَنَا  سُلَيْمَانُ بْنُ أَبِي دَاوُدَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  حَدَّثَتْنِي  أُمُّ سَلَمَةَ ، قَالَتْ :  قَدَّمَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِيمَنْ قَدِمَ مِنْ ضَعَفَةِ أَهْلِهِ  لَيْلَةَ  الْمُزْدَلِفَةِ  "" ، قَالَتْ :  فَرَمَيْتُ الْجَمْرَةَ         [23/269]      بِلَيْلٍ ، ثُمَّ مَضَيْتُ إِلَى  مَكَّةَ  ، فَصَلَّيْتُ بِهَا الصُّبْحَ ، ثُمَّ رَجَعْتُ إِلَى  مِنًى  .","","Al-Mu'jam al-Kabir 570","","هند بنت أبي أمية زوج رسول الله عن عروة بن الزبير عن هشام بن عروة بن الزبير عن سليمان بن أبي داود الحراني بومة عن هارون بن عمران الموصلي عن علي بن حرب الطائي عن سعيد بن عبد الرحمن عن الطبراني","عروة بن الزبير عن أم سلمة"
"21169","571  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو قَبِيصَةَ الْفَزَارِيُّ ،  ثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّهَا قَالَتْ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنِّي لَمْ أَطُفْ طَوَافَ الْخُرُوجِ ، فَقَالَ لَهَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا صَلَّى النَّاسُ الصُّبْحَ ، فَطُوفِي عَلَى بَعِيرِكِ مِنْ وَرَاءِ الصُّفُوفِ  ، ثُمَّ اخْرُجِي  .","","Al-Mu'jam al-Kabir 571","","هند بنت أبي أمية زوج رسول الله عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن قبيصة الفزاري عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","عروة بن الزبير عن أم سلمة"
"21170","سُلَيْمَانُ بْنُ يَسَارٍ  عَنْ  أُمِّ سَلَمَةَ  .  572  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  أَنَّ  أَبَا هُرَيْرَةَ  ،  وَابْنَ عَبَّاسٍ  ،  وَأَبَا سَلَمَةَ  ، اجْتَمَعُوا فَتَذَاكَرُوا الَّتِي تَضَعُ بَعْدَ وَفَاةِ زَوْجِهَا  ، فَقَالَ  ابْنُ عَبَّاسٍ  : آخِرُ الْأَجَلَيْنِ ، وَقَالَ  أَبُو سَلَمَةَ  : إِذَا وَضَعَتْ حَلَّتْ ، فَقَالَ  أَبُو هُرَيْرَةَ  : أَنَا مَعَ ابْنِ أَخِي ،  فَبَعَثُوا  كُرَيْبًا إِلَى أُمِّ سَلَمَةَ ، فَذَكَرَتْ حَدِيثَ  سُبَيْعَةَ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" أَمَرَهَا أَنْ تَزَوَّجَ  .","","Al-Mu'jam al-Kabir 572","","هند بنت أبي أمية زوج رسول الله عن كريب بن أبي مسلم الحجازي عن سليمان بن يسار مولى ميمونة زوج رسول الله عن يحيى بن سعيد الأنصاري عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سليمان بن يسار عن أم سلمة"
"21171","573  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَالِكٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  أَنَّ  ابْنَ عَبَّاسٍ  ،  وَأَبَا سَلَمَةَ  أَرْسَلُوا  إِلَى أُمِّ سَلَمَةَ كُرَيْبًا مَوْلَى ابْنِ عَبَّاسٍ  فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 573","","هند بنت أبي أمية زوج رسول الله عن كريب بن أبي مسلم الحجازي عن سليمان بن يسار مولى ميمونة زوج رسول الله عن يحيى بن سعيد الأنصاري عن مالك بن أنس عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سليمان بن يسار عن أم سلمة"
"21172","[23/270]      574  -  حَدَّثَنَا  عَلِيٌّ ،  ثَنَا  أَبُو حُذَيْفَةَ ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَحْيَى بْنُ آدَمَ ، قَالَا :  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  كُرَيْبٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  وَعَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  كُرَيْبٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  وَضَعَتْ  سُبَيْعَةُ بِنْتُ الْحَارِثِ  حَمْلَهَا بَعْدَ وَفَاةِ زَوْجِهَا بِأَيَّامٍ  ، "" وَأَمَرَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ تَزَوَّجَ  .","","Al-Mu'jam al-Kabir 574","","هند بنت أبي أمية زوج رسول الله عن كريب بن أبي مسلم الحجازي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن سفيان الثوري عن يحيى بن آدم عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","سليمان بن يسار عن أم سلمة"
"21173","575  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُعَلَّى بْنُ رَاشِدٍ ،  ثَنَا  وَهْبٌ ،  عَنْ  أَيُّوبَ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ  فَاطِمَةَ  اسْتُحِيضَتْ  ، وَكَانَتْ تَغْتَسِلُ مِنَ الْمِرْكَنِ ، فَتَخْرُجُ وَهِيَ عَالِيَةُ الصُّفْرَةِ وَالْكُدْرَةِ ، فَاسْتَفْتَتْ لَهَا  أُمُّ سَلَمَةَ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  تَنْتَظِرُ أَيَّامَ حَيْضِهَا ، فَتَدَعُ الصَّلَاةَ فِيهَا  ، وَتَغْتَسِلُ فِيمَا سِوَى ذَلِكَ ، وَتُصَلِّي  .  قَالَ  أَيُّوبُ  :  فَقُلْتُ  لِسُلَيْمَانَ بْنِ يَسَارٍ  : يَأْتِيهَا زَوْجُهَا ؟ قَالَ : "" إِنَّمَا نَقُولُ مَا سَمِعْنَا  "" .","","Al-Mu'jam al-Kabir 575","","هند بنت أبي أمية زوج رسول الله عن سليمان بن يسار مولى ميمونة زوج رسول الله عن أيوب السختياني عن وهيب بن خالد الكرابيسي عن معلى بن راشد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سليمان بن يسار عن أم سلمة"
"21174","576  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  عُبَادَةُ بْنُ زِيَادٍ ،  ثَنَا  أَبُو مَرْيَمَ ،  عَنْ  قَتَادَةَ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ نَحْوَهُ .","","Al-Mu'jam al-Kabir 576","","هند بنت أبي أمية زوج رسول الله عن سليمان بن يسار مولى ميمونة زوج رسول الله عن قتادة بن دعامة عن عبد الغفار بن القاسم الأنصاري عن عباد بن زياد  بن موسى الساجي عن محمد بن عثمان بن أبي شيبة عن الطبراني","سليمان بن يسار عن أم سلمة"
"21175","577  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو خَالِدٍ الْأَحْمَرُ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  نَافِعٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ         [23/271]      أَنَّ  فَاطِمَةَ  أَتَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ : إِنِّي أَرَى الدَّمَ  ، فَأَمَرَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ "" تَغْتَسِلَ وَتَتَوَضَّأَ لِكُلِّ صَلَاةٍ  .","","Al-Mu'jam al-Kabir 577","","هند بنت أبي أمية زوج رسول الله عن سليمان بن يسار مولى ميمونة زوج رسول الله عن نافع مولى ابن عمر عن حجاج بن أرطاة عن سليمان بن حيان الأحمر عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","سليمان بن يسار عن أم سلمة"
"21176","578  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  سَأَلَتِ  امْرَأَةٌ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ : إِنِّي أُسْتَحَاضُ ، فَلَا أَطْهُرُ ، أَفَأَدَعُ الصَّلَاةَ ؟ ، قَالَ :  لَا وَلَكِنْ دَعِي قَدْرَ الْأَيَّامِ وَاللَّيَالِي الَّتِي كُنْتِ تَحِيضِينَ فِيهَا ، ثُمَّ اغْتَسِلِي وَاسْتَثْفِرِي بِثَوْبٍ وَصَلِّي  .","","Al-Mu'jam al-Kabir 578","","هند بنت أبي أمية زوج رسول الله عن سليمان بن يسار مولى ميمونة زوج رسول الله عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبدة بن سليمان الكلابي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","سليمان بن يسار عن أم سلمة"
"21177","579  -  حَدَّثَنَا  الْحُسَيْنُ ،  ثَنَا  عُثْمَانُ ،  ثَنَا  عَبْدَةُ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّهَا ذَكَرَتْ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذُيُولَ النِّسَاءِ ، فَقَالَ : "" تُرْخِينَ شِبْرًا  ، قُلْتُ : إِذَنْ تَنْكَشِفُ عَنْهُنَّ ، قَالَ : "" فَذِرَاعٌ لَا يَزِدْنَ عَلَيْهِ  .","","Al-Mu'jam al-Kabir 579","","هند بنت أبي أمية زوج رسول الله عن سليمان بن يسار مولى ميمونة زوج رسول الله عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبدة بن سليمان الكلابي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","سليمان بن يسار عن أم سلمة"
"21178","580  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ مَنْصُورٍ الرُّمَّانِيُّ ،  ثَنَا  الْمُعَافَى بْنُ سُلَيْمَانَ ، (  ح  ) .  وَحَدَّثَنَا  سُلَيْمَانُ بْنُ الْمُعَافَى ،  ثَنَا  أَبِي  ،  ثَنَا  حَكِيمُ بْنُ نَافِعٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ، قَالَ :  سَمِعْتُ  أُمَّ سَلَمَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ         [23/272]      - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  سَيَكُونُ بَعْدِي خَسْفٌ بِالْمَشْرِقِ  ، وَخَسْفٌ بِالْمَغْرِبِ ، وَخَسْفٌ فِي  جَزِيرَةِ  الْعَرَبِ  "" ، فَقَالَتْ : يَا رَسُولَ اللهِ يُخْسَفُ بِالْأَرْضِ وَفِيهِمُ الصَّالِحُونَ ؟ فَقَالَ لَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" إِذَا كَانَ أَكْثَرُ أَهْلِهَا  الْخَبَثَ  .","","Al-Mu'jam al-Kabir 580","","هند بنت أبي أمية زوج رسول الله عن سليمان بن يسار مولى ميمونة زوج رسول الله عن يحيى بن سعيد الأنصاري عن حكيم بن نافع الرقي عن المعافى بن سليمان الرسعني عن الحسين بن منصور الرماني عن الطبراني","سليمان بن يسار عن أم سلمة"
"21179","581  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  ثَنَا  أُسَامَةُ بْنُ زَيْدٍ ، قَالَ :  سَمِعْتُ  سُلَيْمَانَ بْنَ يَسَارٍ  يُحَدِّثُ عَنْ  أُمِّ سَلَمَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" يُصْبِحُ  جُنُبًا  مِنْ غَيْرِ احْتِلَامٍ  ، فَيَغْتَسِلُ ثُمَّ يَمْضِي عَلَى صَوْمِهِ  .","","Al-Mu'jam al-Kabir 581","","هند بنت أبي أمية زوج رسول الله عن سليمان بن يسار مولى ميمونة زوج رسول الله عن أسامة بن زيد الليثي المدني عن وكيع بن الجراح عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","سليمان بن يسار عن أم سلمة"
"21180","582  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  ثَنَا  سَعِيدُ بْنُ حَفْصٍ النَّجَّارِيُّ  ،  ثَنَا  عَبْدُ اللهِ بْنُ الْوَلِيدِ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( البخاري )","","Al-Mu'jam al-Kabir 582","","هند بنت أبي أمية زوج رسول الله عن سليمان بن يسار مولى ميمونة زوج رسول الله عن أسامة بن زيد الليثي المدني عن سفيان الثوري عن عبد الله بن الوليد بن ميمون العدني عن سعيد بن حفص بن عمرو البخاري عن محمد بن العباس ابن الأخرم عن الطبراني","سليمان بن يسار عن أم سلمة"
"21181","583  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ ،  عَنْ  نَافِعٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ  امْرَأَةً  كَانَتْ  تُهَرَاقُ  الدَّمَ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَاسْتَفْتَتْ لَهَا  أُمُّ سَلَمَةَ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  لِتَنْظُرْ عِدَّةَ اللَّيَالِي وَالْأَيَّامِ الَّتِي كَانَتْ تَحِيضُهُنَّ مِنَ  الشَّهْرِ  قَبْلَ أَنْ يُصِيبَهَا الَّذِي أَصَابَهَا  ، فَلْتَتْرُكِ الصَّلَاةَ قَدْرَ ذَلِكَ مِنَ  الشَّهْرِ  ، فَإِذَا خَلَّفَتْ ذَلِكَ ، فَلْتَغْتَسِلْ ، ثُمَّ  لِتَسْتَثْفِرْ  بِثَوْبٍ ، ثُمَّ لِتُصَلِّي  .","","Al-Mu'jam al-Kabir 583","","هند بنت أبي أمية زوج رسول الله عن سليمان بن يسار مولى ميمونة زوج رسول الله عن نافع مولى ابن عمر عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سليمان بن يسار عن أم سلمة"
"21182","عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ بْنِ عُتْبَةَ  عَنْ  أُمِّ سَلَمَةَ  .  584  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُحَمَّدِ بْنِ         [23/273]      عَائِشَةَ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  ثَنَا  طَلْحَةُ بْنُ يَحْيَى ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  مَا صَلَّاهُمَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِنْدِي إِلَّا مَرَّةً دَخَلَ يَوْمًا بَعْدَ الْعَصْرِ ، فَصَلَّى رَكْعَتَيْنِ ، فَقُلْتُ : يَا رَسُولَ اللهِ مَا هَذِهِ الصَّلَاةُ ، مَا كُنْتَ تُصَلِّيهَا ، فَنَزَلَتْ صَلَاةٌ بَعْدَ الْعَصْرِ ؟ قَالَ :  لَا وَلَكِنْ رَكْعَتَيْنِ كُنْتُ أُصَلِّيهِمَا بَعْدَ الظُّهْرِ ، فَشُغِلْتُ عَنْهُمَا فَتَدَارَكْتُهُمَا  .","","Al-Mu'jam al-Kabir 584","","هند بنت أبي أمية زوج رسول الله عن عبيد الله بن عبد الله بن عتبة بن مسعود عن طلحة بن يحيى بن طلحة التيمي عن عبد الواحد بن زياد عن ابن عائشة عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبيد الله بن عبد الله بن عتبة عن أم سلمة"
"21183","أَبُو بَكْرِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ  عَنْ  أُمِّ سَلَمَةَ  .  585  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  ابْنُ جُرَيْجٍ ،  أَخْبَرَنِي  حَبِيبُ بْنُ أَبِي ثَابِتٍ : أَنَّ عَبْدَ الْمَجِيدِ بْنَ عَبْدِ اللهِ بْنِ أَبِي عَمْرٍو  . وَالْقَاسِمَ بْنَ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ،  أَخْبَرَاهُ  أَنَّهُمَا ، سَمِعَا  أَبَا بَكْرِ بْنَ عَبْدِ الرَّحْمَنِ ، يُخْبِرُ أَنَّ أُمَّ سَلَمَةَ ، زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَخْبَرَتْهُ  :  أَنَّهَا لَمَّا قَدِمَتِ  الْمَدِينَةَ  ، أَخْبَرَتْهُمْ أَنَّهَا  بِنْتُ أُمَيَّةَ بْنِ الْمُغِيرَةِ  فَكَذَّبُوهَا ، وَيَقُولُونَ : مَا أَكْذَبَ الْغَرَائِبَ ، حَتَّى أَنْشَأَ نَاسٌ مِنْهُمْ إِلَى  الْحَجِّ  ، فَقَالُوا : أَتَكْتُبِينَ إِلَى أَهْلِكِ ، فَكَتَبَتْ مَعَهُمْ ، فَرَجَعُوا إِلَى  الْمَدِينَةِ  يُصَدِّقُونَهَا ، وَازْدَادَتْ عَلَيْهِمْ كَرَامَةً ، قَالَتْ : فَلَمَّا وَضَعْتُ  زَيْنَبَ  ، جَاءَنِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَخَطَبَنِي ، فَقُلْتُ : مَا مِثْلِي تُنْكَحُ ، أَمَّا أَنَا فَلَا وَلَدَ فِيَّ ، وَأَنَا  غَيُورٌ  ذَاتُ عِيَالٍ ، قَالَ :  أَنَا أَكْبَرُ مِنْكِ ، وَأَمَّا الْغَيْرَةُ فَيُذْهِبُهَا اللهُ ، وَأَمَّا الْعِيَالُ فَإِلَى اللهِ وَرَسُولِهِ  فَتَزَوَّجَهَا ، فَجَعَلَ يَأْتِيهَا فَيَقُولُ : "" أَيْنَ  زُنَابُ  ؟ "" ، حَتَّى جَاءَ  عَمَّارُ بْنُ يَاسِرٍ  يَوْمًا  فَاخْتَلَجَهَا  ، وَقَالَ : هَذِهِ تَمْنَعُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَكَانَتْ تُرْضِعُهَا ، فَجَاءَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : "" أَيْنَ  زُنَابُ  ؟ "" ،         [23/274]      قَالَتْ  قَرِيبَةُ بِنْتُ أُمَيَّةَ  - وَوَافَقَهَا عِنْدَهَا - : أَخَذَهَا  عَمَّارُ بْنُ يَاسِرٍ  ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" أَنَا آتِيكُمُ اللَّيْلَةَ "" ، قَالَتْ : فَقُمْتُ ، فَوَضَعْتُ  ثِفَالِي  ، وَأَخَّرْتُ  حَبَّاتٍ  مِنْ شَعِيرٍ كَانَتْ فِي جَرٍّ ، وَأَخْرَجْتُ شَحْمًا ، فَعَصَدْتُهُ لَهُ ، قَالَتْ : فَبَاتَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ أَصْبَحَ ، فَقَالَ حِينَ أَصْبَحَ : "" إِنَّ بِكِ عَلَى أَهْلِكِ كَرَامَةً ، فَإِنْ شِئْتِ  سَبَّعْتُ  ، وَإِنْ أُسَبِّعْ أُسَبِّعْ لِنِسَائِي  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عبد الحميد بن عبد الله )","","Al-Mu'jam al-Kabir 585","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن القاسم بن محمد بن عبد الرحمن المخزومي عن حبيب بن أبي ثابت الكاهلي عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","أبو بكر بن عبد الرحمن بن الحارث بن هشام عن أم سلمة"
"21184","586  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ تَزَوَّجَهَا ، قَالَ :  إِنْ أُسَبِّعْ لَكِ أُسَبِّعْ لِنِسَائِي  .","","Al-Mu'jam al-Kabir 586","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن حبيب بن أبي ثابت الكاهلي عن ابن جريج عن سفيان بن عيينة عن علي ابن المديني عن معاذ بن المثنى العنبري عن الطبراني","أبو بكر بن عبد الرحمن بن الحارث بن هشام عن أم سلمة"
"21185","587  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ الْفَزَارِيُّ ،  عَنْ  عَبْدِ الْوَاحِدِ بْنِ أَيْمَنَ ، قَالَ :  حَدَّثَنِي  أَبُو بَكْرِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ لَهَا حِينَ دَخَلَ عَلَيْهَا :  إِنَّ بِكِ وَبِأَهْلِكِ عَلَيَّ كَرَامَةً  ، وَإِنِّي إِنْ أُسَبِّعْ لَكِ أُسَبِّعْ لِنِسَائِي  .","","Al-Mu'jam al-Kabir 587","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن عبد الواحد بن أيمن المخزومي عن مروان بن معاوية الفزاري عن يحيى بن معين عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو بكر بن عبد الرحمن بن الحارث بن هشام عن أم سلمة"
"21186","588  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ ،  عَنْ  عَبْدِ رَبِّهِ بْنِ سَعِيدٍ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَائِشَةَ ، وَأُمِّ سَلَمَةَ ، قَالَتَا :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" يُصْبِحُ  جُنُبًا  مِنْ غَيْرِ احْتِلَامٍ  ، ثُمَّ يَصُومُ  .","","Al-Mu'jam al-Kabir 588","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن عبد ربه بن سعيد النجاري عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو بكر بن عبد الرحمن بن الحارث بن هشام عن أم سلمة"
"21187","[23/275]      589  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، حَدَّثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ ،  عَنْ  عَبْدِ رَبِّهِ بْنِ سَعِيدٍ ،  عَنْ  عَائِشَةَ ، وَأُمِّ سَلَمَةَ ، قَالَتَا :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" يُصْبِحُ  جُنُبًا  مِنْ جِمَاعٍ مِنْ غَيْرِ احْتِلَامٍ  ، ثُمَّ يَصُومُ  .","","Al-Mu'jam al-Kabir 589","","هند بنت أبي أمية زوج رسول الله عن عبد ربه بن سعيد النجاري عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو بكر بن عبد الرحمن بن الحارث بن هشام عن أم سلمة"
"21188","590  -  حَدَّثَنَا  عَبْدُ الْمَلِكِ بْنُ يَحْيَى بْنِ بُكَيْرٍ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  مُوسَى بْنِ جُبَيْرٍ ،  عَنْ  عِرَاكِ بْنِ مَالِكٍ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ  زَيْنَبَ بِنْتَ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَجَارَتْ  أَبَا الْعَاصِ بْنَ الرَّبِيعِ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يُجِيرُ  عَلَى الْمُسْلِمِينَ أَدْنَاهُمْ  .","","Al-Mu'jam al-Kabir 590","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن عراك بن مالك الغفاري عن موسى بن جبير الأنصاري عن عبد الله بن لهيعة عن يحيى بن عبد الله بن بكير المخزومي عن عبد الملك بن يحيى المخزومي عن الطبراني","أبو بكر بن عبد الرحمن بن الحارث بن هشام عن أم سلمة"
"21189","591  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي بَكْرِ بْنِ عَمْرِو بْنِ حَزْمٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي بَكْرِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  مَكَثَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِنْدَ  أُمِّ سَلَمَةَ  ثَلَاثًا حِينَ بَنَى بِهَا ، ثُمَّ قَالَ :  لَيْسَ بِكِ هَوَانٌ عَلَى  أَهْلِكِ  ، وَإِنِّي إِنْ أُسَبِّعْ لَكِ أُسَبِّعْ لِنِسَائِي  .","","Al-Mu'jam al-Kabir 591","","أبو بكر بن عبد الرحمن راهب قريش عن عبد الملك بن أبي بكر المخزومي عن محمد بن أبي بكر بن محمد بن عمرو بن حزم عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","أبو بكر بن عبد الرحمن بن الحارث بن هشام عن أم سلمة"
"21190","592  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سُفْيَانَ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي بَكْرِ [  عن  عَبْدِ الْمَلِكِ بْنِ أَبِي بَكْرِ ]  بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ  ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمَّا تَزَوَّجَ  أُمَّ سَلَمَةَ  أَقَامَ عِنْدَهَا         [23/276]      ثَلَاثًا ، وَقَالَ :  إِنَّهُ لَيْسَ بِكِ عَلَى  أَهْلِكِ  هَوَانٌ ، إِنْ شِئْتِ  سَبَّعْتُ  لَكِ  ، وَإِنْ  سَبَّعْتُ  لَكِ  سَبَّعْتُ  لِنِسَائِي  .  سقط من طبعة مكتبة ابن تيمية ونسخة الوطنية ، وسقطت اللوحة (104) من نسخة كوبرلي ، والمثبت من مصنف ابن أبي شيبة ، وصحيح مسلم . والله أعلم .","","Al-Mu'jam al-Kabir 592","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن محمد الخزرجي عن عبد الملك بن أبي بكر المخزومي عن محمد بن أبي بكر بن محمد بن عمرو بن حزم عن سفيان الثوري عن يحيى القطان عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو بكر بن عبد الرحمن بن الحارث بن هشام عن أم سلمة"
"21191","593  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ، قَالَ :  أَخْبَرَنِي  ابْنُ شِهَابٍ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ،  عَنْ  أُمِّ سَلَمَةَ ، وَعَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ : "" يُدْرِكُهُ الْفَجْرُ وَهُوَ  جُنُبٌ  مِنْ أَهْلِهِ  ، وَلَمْ يَغْتَسِلْ فَيَصُومُ  .","","Al-Mu'jam al-Kabir 593","","عائشة بنت أبي بكر الصديق عن أبو بكر بن عبد الرحمن راهب قريش عن الزهري عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","أبو بكر بن عبد الرحمن بن الحارث بن هشام عن أم سلمة"
"21192","594  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَائِشَةَ ، وَأُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 594","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","أبو بكر بن عبد الرحمن بن الحارث بن هشام عن أم سلمة"
"21193","595  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  الْفَضْلُ بْنُ يَعْقُوبَ ،  ثَنَا  عَبْدُ الْأَعْلَى ،  ثَنَا  بُرْدٌ ،  عَنِ  الزُّهْرِيِّ ،  بِإِسْنَادٍ  نَحْوَهُ .","","Al-Mu'jam al-Kabir 595","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن الزهري عن برد بن سنان عن عبد الأعلى بن عبد الأعلى القرشي عن الفضل بن يعقوب الجزري عن الحسين بن إسحاق التستري عن الطبراني","أبو بكر بن عبد الرحمن بن الحارث بن هشام عن أم سلمة"
"21194","596  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  عِرَاكِ بْنِ مَالِكٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي بَكْرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" يُصْبِحُ  جُنُبًا  مِنَ النِّسَاءِ  مِنْ غَيْرِ حُلُمٍ ، ثُمَّ يَظَلُّ صَائِمًا  .","","Al-Mu'jam al-Kabir 596","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن عبد الملك بن أبي بكر المخزومي عن عراك بن مالك الغفاري عن يحيى بن سعيد الأنصاري عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","أبو بكر بن عبد الرحمن بن الحارث بن هشام عن أم سلمة"
"21195","597  -  حَدَّثَنَا  الْحُسَيْنُ ،  ثَنَا  يَحْيَى ،  ثَنَا  مِنْدَلٌ ،  عَنِ  ابْنِ جُرَيْجٍ ،  بِإِسْنَادِهِ  مِثْلَهُ .         [23/277]","","Al-Mu'jam al-Kabir 597","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن عبد الملك بن أبي بكر المخزومي عن ابن جريج عن مندل بن علي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","أبو بكر بن عبد الرحمن بن الحارث بن هشام عن أم سلمة"
"21196","598  -  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ يَعْقُوبَ  ،  ثَنَا  الْفَضْلُ بْنُ يَعْقُوبَ ،  ثَنَا  عَبْدُ الْأَعْلَى ،  ثَنَا  بُرْدٌ ،  عَنِ  الزُّهْرِيِّ  بِإِسْنَادِهِ  نَحْوَهُ .  كذا في طبعة مكتبة ابن تيمية ، والصواب : الحسين بن إسحاق .","","Al-Mu'jam al-Kabir 598","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن الزهري عن برد بن سنان عن عبد الأعلى بن عبد الأعلى القرشي عن الفضل بن يعقوب الجزري عن الحسين بن إسحاق التستري عن الطبراني","أبو بكر بن عبد الرحمن بن الحارث بن هشام عن أم سلمة"
"21197","599  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نُوحٍ الْعَسْكَرِيُّ ،  ثَنَا  يَحْيَى بْنُ غَيْلَانَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدٍ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي بَكْرِ بْنِ حَزْمٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 599","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن عمر بن عبد العزيز بن مروان عن أبو بكر بن محمد الخزرجي عن محمد بن أبي بكر بن محمد بن عمرو بن حزم عن إبراهيم بن محمد بن أبي يحيى عن يحيى بن غيلان بن عوام التستري عن محمد بن نوح العسكري عن الطبراني","أبو بكر بن عبد الرحمن بن الحارث بن هشام عن أم سلمة"
"21198","600  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ بْنِ مُكْرَمٍ ،  ثَنَا  مَحْمُودُ بْنُ غَيْلَانَ ،  ثَنَا  بِشْرُ بْنُ السَّرِيِّ ،  ثَنَا  مُصْعَبُ بْنُ ثَابِتٍ ،  عَنْ  عَمِّهِ عَامِرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ "" إِذَا صَلَّى الْعَصْرَ يَنْصَرِفُ فَيُصَلِّي فِي بَيْتِهِ رَكْعَتَيْنِ  .","","Al-Mu'jam al-Kabir 600","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن مصعب بن ثابت بن عبد الله بن الزبير بن العوام عن بشر بن السري عن محمود بن غيلان المروزي عن محمد بن الحسين بن مكرم البارع عن الطبراني","أبو بكر بن عبد الرحمن بن الحارث بن هشام عن أم سلمة"
"21199","عُبَيْدُ بْنُ عُمَيْرٍ اللَّيْثِيُّ عَنْ أُمِّ سَلَمَةَ .  601  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، وَعُثْمَانُ ، قَالُوا :  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ ، قَالَ :  قَالَتْ  أُمُّ سَلَمَةَ :  لَمَّا مَاتَ  أَبُو سَلَمَةَ  بِالْمَدِينَةِ  ، قُلْتُ : غَرَبْتَ فِي أَرْضِ غُرْبَةٍ ، لَأَبْكِيَنَّهُ بُكَاءً يُتَحَدَّثُ عَنْهُ ، قَالَتْ : فَإِنِّي لَكَذَلِكَ إِذْ أَتَتْنِي  امْرَأَةٌ  تُسْعِدُنِي مِنَ الصَّعِيدِ ، فَاسْتَقْبَلَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  تُرِيدِينَ أَنْ تُدْخِلِي الشَّيْطَانَ بَيْتًا قَدْ أَخْرَجَهُ اللهُ مِنْهُ مَرَّتَيْنِ  ، قَالَتْ : فَتَرَكْتُهُ وَلَمْ أَبْكِهِ  .","","Al-Mu'jam al-Kabir 601","","هند بنت أبي أمية زوج رسول الله عن عبيد بن عمير بن قتادة الجندعي عن يسار الثقفي مولى الأخنس بن شريق عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبيد بن عمير الليثي عن أم سلمة"
"21200","[23/278]      عَبْدُ اللهِ بْنُ أَبِي مُلَيْكَةَ  عَنْ  أُمِّ سَلَمَةَ  .  602  -  حَدَّثَنَا  ابْنُ السَّمَيْدَعِ ،  ثَنَا  يَعْقُوبُ بْنُ كَعْبٍ ،  ثَنَا  يَحْيَى بْنُ الْمُتَوَكِّلِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  نَهَيْتُكُمْ عَنْ زِيَارَةِ الْقُبُورِ فَزُورُوهَا  ، فَإِنَّ لَكُمْ فِيهَا عِبْرَةً  .","","Al-Mu'jam al-Kabir 602","","هند بنت أبي أمية زوج رسول الله عن ابن أبي مليكة عن ابن جريج عن يحيى بن المتوكل الباهلي عن يعقوب بن كعب الأنطاكي عن الحسين بن السميدع البجلي عن الطبراني","عبد الله بن أبي مليكة عن أم سلمة"
"21201","603  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو عُبَيْدٍ الْقَاسِمُ بْنُ سَلَّامٍ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ الْأُمَوِيُّ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" يُقَطِّعُ فِي قِرَاءَتِهِ         {      بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ             *          الْحَمْدُ لِلهِ رَبِّ الْعَالَمِينَ             *          الرَّحْمَنِ الرَّحِيمِ             *          مَالِكِ يَوْمِ الدِّينِ         }      .","","Al-Mu'jam al-Kabir 603","","هند بنت أبي أمية زوج رسول الله عن ابن أبي مليكة عن ابن جريج عن يحيى بن سعيد بن أبان عن أبو عبيد القاسم بن سلام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن أبي مليكة عن أم سلمة"
"21202","604  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  ) .         [23/279]      وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  ابْنُ عُلَيَّةَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" أَشَدَّ تَعْجِيلًا لِلظُّهْرِ مِنْكُمْ  ، وَأَنْتُمْ أَشَدُّ تَأْخِيرًا لِلْعَصْرِ مِنْهُ  .","","Al-Mu'jam al-Kabir 604","","هند بنت أبي أمية زوج رسول الله عن ابن أبي مليكة عن ابن جريج عن إسماعيل ابن علية عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","عبد الله بن أبي مليكة عن أم سلمة"
"21203","طَاوُسٌ  عَنْ  أُمِّ سَلَمَةَ  .  605  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عَمْرُو بْنُ هِشَامٍ الْحَرَّانِيُّ ،  ثَنَا  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو الْبَصْرِيِّ ،  عَنْ  طَاوُسٍ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّهَا سَمِعَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ قَالَ لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ كُتِبَ لَهُ كَذَا وَكَذَا  حَسَنَةً  .","","Al-Mu'jam al-Kabir 605","","هند بنت أبي أمية زوج رسول الله عن طاوس بن كيسان عن محمد بن عمرو البصري عن عثمان بن عبد الرحمن الطرائفي عن عمرو بن هشام بن بزين الحراني عن الحسين بن إسحاق التستري عن الطبراني","طاوس عن أم سلمة"
"21204","مُجَاهِدٌ  عَنْ  أُمِّ سَلَمَةَ  .  606  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو حُذَيْفَةَ ، (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ، قَالَا :  ثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  قُلْتُ : يَا رَسُولَ اللهِ إِنَّ عَمِّي  هِشَامَ بْنَ الْمُغِيرَةِ  كَانَ يُطْعِمُ الطَّعَامَ ، وَيَصِلُ الرَّحِمَ ، وَيَفْعَلُ وَيَفْعَلُ ، فَلَوْ أَدْرَكَكَ لَأَسْلَمَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كَانَ يُعْطِي لِلدُّنْيَا وَحْدَهَا وَذِكْرِهَا  ، وَمَا قَالَ يَوْمًا قَطُّ اغْفِرْ لِي يَوْمَ الدِّينِ  .","","Al-Mu'jam al-Kabir 606","","هند بنت أبي أمية زوج رسول الله عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن سفيان الثوري عن محمد بن كثير العبدي عن محمد بن محمد بن حيان التمار عن الطبراني","مجاهد عن أم سلمة"
"21205","607  -  حَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  أَبُو الْوَلِيدِ ،  ثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 607","","هند بنت أبي أمية زوج رسول الله عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن جرير بن عبد الحميد عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","مجاهد عن أم سلمة"
"21206","[23/280]      608  -  حَدَّثَنَا  أَبُو يَحْيَى الرَّازِيُّ  ، حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي عُمَرَ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أُمِّ سَلَمَةَ ، زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ :  كُنَّا نَكُونُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَنَحْنُ مُحْرِمَاتٌ  ، فَيَمُرُّ بِنَا الرَّاكِبُ ، فَتَسْدِلُ إِحْدَانَا الثَّوْبَ عَلَى وَجْهِهَا مِنْ فَوْقِ رَأْسِهَا ، وَرُبَّمَا قَالَتْ مِنْ فَوْقِ الْخِمَارِ  .","","Al-Mu'jam al-Kabir 608","","هند بنت أبي أمية زوج رسول الله عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن سفيان بن عيينة عن ابن أبي عمر العدني عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","مجاهد عن أم سلمة"
"21207","609  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  ابْنُ كَثِيرٍ ،  ثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ، قَالَ :  قَالَتْ  أُمُّ سَلَمَةَ :  يَا رَسُولَ اللهِ لَا نُقْطَعُ الْمِيرَاثَ  ، وَلَا نُقَاتِلُ ، فَنُسْتَشْهَدَ ، فَأَنْزَلَ اللهُ         {      وَلا تَتَمَنَّوْا مَا فَضَّلَ اللهُ بِهِ بَعْضَكُمْ عَلَى بَعْضٍ         }      إِلَى آخِرِ الْآيَةِ ، ثُمَّ نَزَلَتْ         {      أَنِّي لا أُضِيعُ عَمَلَ عَامِلٍ مِنْكُمْ مِنْ ذَكَرٍ أَوْ أُنْثَى         }      .","","Al-Mu'jam al-Kabir 609","","هند بنت أبي أمية زوج رسول الله عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن سفيان الثوري عن محمد بن كثير العبدي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","مجاهد عن أم سلمة"
"21208","عَطَاءُ بْنُ أَبِي رَبَاحٍ  عَنْ  أُمِّ سَلَمَةَ  .  610  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  ) .         [23/281]      وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  لَيْثٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّهَا لَبِسَتْ قِلَادَةً فِيهَا شُعَيْرَاتٌ مِنْ ذَهَبٍ ، فَرَآهَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَكَرِهَهَا ، فَأَعْرَضَ عَنْهَا ، فَنَزَعْتُهَا فَقَالَ :  مَا يُؤَمِّنُكِ أَنْ يُقَلِّدَكِ يَوْمَ الْقِيَامَةِ مَكَانَهَا شَعَرَاتٍ مِنْ نَارٍ  .","","Al-Mu'jam al-Kabir 610","","هند بنت أبي أمية زوج رسول الله عن عطاء بن أبي رباح عن ليث بن أبي سليم عن أبو معاوية الضرير عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","عطاء بن أبي رباح عن أم سلمة"
"21209","611  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عَلِيُّ بْنُ حَمْزَةَ الْعَتَكِيُّ ،  ثَنَا  يَزِيدُ بْنُ عَبْدِ اللهِ الرَّازِيُّ ،  عَنْ  نَافِعِ بْنِ مِهْرَانَ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ صَلَّى أَرْبَعَ رَكَعَاتٍ قَبْلَ الْعَصْرِ حَرَّمَ اللهُ بَدَنَهُ عَلَى النَّارِ  ، قُلْتُ : يَا رَسُولَ اللهِ قَدْ رَأَيْتُكَ تُصَلِّي وَتَدَعُ ، قَالَ : "" لَسْتُ كَأَحَدِهِمْ  .","","Al-Mu'jam al-Kabir 611","","هند بنت أبي أمية زوج رسول الله عن عطاء بن أبي رباح عن نافع بن مهران عن يزيد بن عبد الله الرازي عن علي بن حمزة بن سوار العتكي عن الحسين بن إسحاق التستري عن الطبراني","عطاء بن أبي رباح عن أم سلمة"
"21210","612  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ ،  ثَنَا  أَبُو غَسَّانَ ،  ثَنَا  جَعْفَرٌ الْأَحْمَرُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  عَطَاءٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ  فَاطِمَةَ  جَاءَتْ بِطُعَيْمٍ لَهَا إِلَى أَبِيهَا وَهُوَ عَلَى مَنَامَةٍ لَهُ ، فَقَالَ :  اذْهَبِي فَادْعِي ابْنَيَّ وَابْنَ عَمِّكِ  ،  قَالَتْ : فَجَلَّلَهُمْ ، أَوْ قَالَتْ : ، فَحَوَّلْتُ عَلَيْهِمُ الْكِسَاءَ  ، ثُمَّ قَالَ : "" اللَّهُمَّ هَؤُلَاءِ أَهْلُ بَيْتِي ،  وَحَامَّتِي ،  فَأَذْهِبْ عَنْهُمُ الرِّجْسَ وَطَهِّرْهُمْ تَطْهِيرًا "" ، قَالَتْ  أُمُّ سَلَمَةَ  : وَأَنَا مَعَهُمْ يَا رَسُولَ اللهِ ؟ قَالَ : "" أَنْتِ زَوْجُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَإِلَى أَوْ عَلَى  خَيْرٍ  .","","Al-Mu'jam al-Kabir 612","","هند بنت أبي أمية زوج رسول الله عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن جعفر بن زياد الأحمر عن مالك بن إسماعيل النهدي عن حفص بن عمر سنجة ألف عن الطبراني","عطاء بن أبي رباح عن أم سلمة"
"21211","613  -  حَدَّثَنَا  الْمَعْمَرِيُّ ،  ثَنَا  عَمْرُو بْنُ عُثْمَانَ ،  ثَنَا  أَبِي  ،  عَنْ  مُحَمَّدِ         [23/282]      بْنِ مُهَاجِرٍ ،  عَنْ  ثَابِتِ بْنِ عَجْلَانَ ،  عَنْ  عَطَاءٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّهَا كَانَتْ تَلْبَسُ  أَوْضَاحًا  مِنْ ذَهَبٍ فَسَأَلَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَكَنْزٌ هُوَ ؟ فَقَالَ :  إِذَا أَدَّيْتِ زَكَاتَهُ فَلَيْسَ  بِكَنْزٍ  .","","Al-Mu'jam al-Kabir 613","","هند بنت أبي أمية زوج رسول الله عن عطاء بن أبي رباح عن ثابت بن عجلان السلمي عن محمد بن مهاجر بن أبي مسلم عن عثمان بن سعيد بن كثير عن عمرو بن عثمان بن سعيد الحمصي عن الحسن بن علي بن شبيب المعمري عن الطبراني","عطاء بن أبي رباح عن أم سلمة"
"21212","عِكْرِمَةُ  عَنْ  أُمِّ سَلَمَةَ  .  614  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو غَسَّانَ ،  ثَنَا  قَيْسٌ ،  عَنْ  خُصَيْفٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَائِشَةَ ،  وَعَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  عِكْرِمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  إِنَّمَا نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الذَّهَبِ ، قُلْنَا : يَا رَسُولَ اللهِ  الْمَسَكُ  يُصِيبُ بِالذَّهَبِ ؟ قَالَ :  لَا إِلَّا أَنْ يَكُونَ بِفِضَّةٍ ، ثُمَّ الْطَخِيهِ بِزَعْفَرَانٍ  .","","Al-Mu'jam al-Kabir 614","","هند بنت أبي أمية زوج رسول الله عن عكرمة مولى ابن عباس عن عبد الكريم بن أبي المخارق عن قيس بن الربيع الأسدي عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عكرمة عن أم سلمة"
"21213","615  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  عِكْرِمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كُنْتُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي لِحَافٍ فَحِضْتُ ، فَقَالَ :  ارْجِعِي فَشُدِّي عَلَيْكِ إِزَارَكِ ثُمَّ ارْجِعِي  .","","Al-Mu'jam al-Kabir 615","","هند بنت أبي أمية زوج رسول الله عن عكرمة مولى ابن عباس عن خالد الحذاء عن يزيد بن زريع العيشي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","عكرمة عن أم سلمة"
"21214","[23/283]      كُرَيْبٌ  عَنْ  أُمِّ سَلَمَةَ  .  616  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ ،  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  أَخْبَرَنِي  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عُمَرَ بْنِ عَلِيٍّ ،  عَنْ  أَبِيهِ  ،  عَنْ  كُرَيْبٍ ،  قَالَ  :  أَرْسَلَنِي نَاسٌ إِلَى أُمِّ سَلَمَةَ ، أَسْأَلُهَا : أَيُّ الْأَيَّامِ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَكْثَرَهَا صَوْمًا ؟ فَقَالَتِ : السَّبْتُ وَالْأَحَدُ ، وَيَقُولُ :  هُمَا يَوْمَا عِيدٍ لِلْمُشْرِكِينَ فَأُحِبُّ أَنْ أُخَالِفَهُمْ  .","","Al-Mu'jam al-Kabir 616","","هند بنت أبي أمية زوج رسول الله عن كريب بن أبي مسلم الحجازي عن محمد بن عمر بن علي بن أبي طالب عن عبد الله بن محمد بن عمر بن علي بن أبي طالب عن عبد الله بن المبارك عن نعيم بن حماد الخزاعي عن يحيى بن عثمان بن صالح عن الطبراني","كريب عن أم سلمة"
"21215","مِقْسَمٌ  عَنْ  أُمِّ سَلَمَةَ  .  617  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الْحَكَمِ ،  عَنْ  مِقْسَمٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" يُوتِرُ بِخَمْسٍ ، أَوْ سَبْعٍ ، لَا يَفْصِلُ بَيْنَهُنَّ بِكَلَامٍ  وَلَا تَسْلِيمٍ  .","","Al-Mu'jam al-Kabir 617","","هند بنت أبي أمية زوج رسول الله عن مقسم بن بجرة عن الحكم بن عتيبة الكندي عن منصور بن المعتمر عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","مقسم عن أم سلمة"
"21216","عَبْدُ الْمَلِكِ بْنُ مَرْوَانَ  عَنْ  أُمِّ سَلَمَةَ  .  618  -  حَدَّثَنَا  أَبُو الْجَهْمِ عَمْرُو بْنُ حَازِمٍ الدِّمَشْقِيُّ ، قَالَ :  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  عَبْدُ الْخَالِقِ بْنُ زَيْدِ بْنِ وَاقِدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُحَمَّدِ         [23/284]      بْنِ عَبْدِ الْمَلِكِ بْنِ مَرْوَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَا مِنْ أَحَدٍ يَلْبَسُ ثَوْبًا  لِيُبَاهِيَ  بِهِ ، فَيَنْظُرُ النَّاسُ إِلَيْهِ  ، لَمْ يَنْظُرِ اللهُ إِلَيْهِ حَتَّى يَنْزِعَهُ مَتَى مَا نَزَعَهُ  .","","Al-Mu'jam al-Kabir 618","","هند بنت أبي أمية زوج رسول الله عن عبد الملك بن مروان بن الحكم عن محمد بن عبد الملك بن مروان القرشي عن زيد بن واقد القرشي عن عبد الخالق بن زيد بن واقد الدمشقي عن سليمان بن عبد الرحمن التميمي عن عمرو بن حازم القرشي عن الطبراني","عبد الملك بن مروان عن أم سلمة"
"21217","619  -  حَدَّثَنَا  أَبُو الْجَهْمِ عَمْرُو بْنُ حَازِمٍ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الْخَالِقِ بْنِ زَيْدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الْمَلِكِ بْنِ مَرْوَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ تَعَلَّمَ الْعِلْمَ  لِيُبَاهِيَ  بِهِ الْعُلَمَاءَ  ،  وَيُمَارِيَ  بِهِ السُّفَهَاءَ فَهُوَ فِي النَّارِ  .","","Al-Mu'jam al-Kabir 619","","هند بنت أبي أمية زوج رسول الله عن عبد الملك بن مروان بن الحكم عن محمد بن عبد الملك بن مروان القرشي عن عبد الخالق بن زيد بن واقد الدمشقي عن سليمان بن عبد الخالق بن زيد عن عمرو بن حازم القرشي عن الطبراني","عبد الملك بن مروان عن أم سلمة"
"21218","عَطَاءُ بْنُ يَسَارٍ  عَنْ  أُمِّ سَلَمَةَ  .  620  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيِّ بْنِ خَلَفٍ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَبَّادِ بْنِ كَثِيرٍ ،  عَنْ  سَالِمٍ أَبِي عَبْدِ اللهِ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنِ ابْتُلِيَ بِالْقَضَاءِ بَيْنَ الْمُسْلِمِينَ  ، فَلَا يَقْضِيَنَّ وَهُوَ غَضْبَانُ  .","","Al-Mu'jam al-Kabir 620","","هند بنت أبي أمية زوج رسول الله عن عطاء بن يسار الهلالي عن سالم أبي عبد الله عن عباد بن كثير الكاهلي عن إسماعيل بن عياش الأحول عن سليمان بن عبد الرحمن التميمي عن الحسن بن علي بن خلف الصراري عن الطبراني","عطاء بن يسار عن أم سلمة"
"21219","621  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ "" يُقَبِّلُ وَهُوَ صَائِمٌ  "" .","","Al-Mu'jam al-Kabir 621","","هند بنت أبي أمية زوج رسول الله عن عطاء بن يسار الهلالي عن زيد بن أسلم عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عطاء بن يسار عن أم سلمة"
"21220","622  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا         [23/285]      زُهَيْرٌ ،  ثَنَا  عَبَّادُ بْنُ كَثِيرٍ ،  عَنْ  أَبِي عَبْدِ اللهِ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنِ ابْتُلِيَ بِالْقَضَاءِ بَيْنَ الْمُسْلِمِينَ ، فَلْيَعْدِلْ بَيْنَهُمْ  فِي لَحْظَتِهِ وَإِشَارَتِهِ وَمَقْعَدِهِ وَمَجْلِسِهِ  .","","Al-Mu'jam al-Kabir 622","","هند بنت أبي أمية زوج رسول الله عن عطاء بن يسار الهلالي عن أبو عبد الله عن عباد بن كثير الكاهلي عن زهير بن معاوية بن حديج عن أحمد بن عبد الله اليربوعي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عطاء بن يسار عن أم سلمة"
"21221","623  -  وَبِهِ  قَالَ :  مَنِ ابْتُلِيَ بِالْقَضَاءِ بَيْنَ الْمُسْلِمِينَ ، فَلَا يَرْفَعْ صَوْتَهُ عَلَى أَحَدِ الْخَصْمَيْنِ  ، مَا لَا يَرْفَعُ عَلَى الْآخَرِ  .","","Al-Mu'jam al-Kabir 623","","هند بنت أبي أمية زوج رسول الله عن عطاء بن يسار الهلالي عن سلمة بن تمام الشقري عن عباد بن كثير الكاهلي عن زهير بن معاوية بن حديج عن أحمد بن عبد الله اليربوعي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عطاء بن يسار عن أم سلمة"
"21222","624  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  عَبَّادُ بْنُ كَثِيرٍ ،  عَنْ  أَبِي عَبْدِ اللهِ ،  عَنْ  عَطَاءِ اللهِ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تَقْطَعُوا الْخُبْزَ  بِالسِّكِّينِ  كَمَا تَقْطَعُهُ الْأَعَاجِمُ  ، وَإِذَا أَرَادَ أَحَدُكُمْ أَنْ يَأْكُلَ اللَّحْمَ ، فَلَا يَقْطَعْهُ  بِالسِّكِّينِ  ، وَلَكِنْ لِيَأْخُذْهُ بِيَدِهِ فَلْيَنْهَشْهُ بِفِيهِ ، فَإِنَّهُ أَهْنَأُ  وَأَمْرَأُ  .","","Al-Mu'jam al-Kabir 624","","هند بنت أبي أمية زوج رسول الله عن عطاء بن يسار الهلالي عن سلمة بن تمام الشقري عن عباد بن كثير الكاهلي عن زهير بن معاوية بن حديج عن أحمد بن عبد الله اليربوعي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عطاء بن يسار عن أم سلمة"
"21223","625  -  حَدَّثَنَا  عَلِيٌّ ،  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  عَبَّادُ بْنُ كَثِيرٍ ،  عَنْ  أَبِي عَبْدِ اللهِ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تَشُمُّوا الطَّعَامَ كَمَا تَشُمُّهُ  السِّبَاعُ  .","","Al-Mu'jam al-Kabir 625","","هند بنت أبي أمية زوج رسول الله عن عطاء بن يسار الهلالي عن أبو عبد الله عن عباد بن كثير الكاهلي عن زهير بن معاوية بن حديج عن أحمد بن عبد الله اليربوعي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عطاء بن يسار عن أم سلمة"
"21224","626  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  ابْنُ         [23/286]      جُرَيْجٍ ،  أَخْبَرَنِي  مُحَمَّدُ بْنُ يُوسُفَ ، أَنَّ عَطَاءَ بْنَ يَسَارٍ  أَخْبَرَهُ  ، أَنَّ أُمَّ سَلَمَةَ ، زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَخْبَرَتْهُ  :  أَنَّهَا قَرَّبَتْ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَنْبًا مَشْوِيًّا  ، فَأَكَلَ مِنْهُ ، ثُمَّ قَامَ إِلَى الصَّلَاةِ وَلَمْ يَتَوَضَّأْ  "" .","","Al-Mu'jam al-Kabir 626","","هند بنت أبي أمية زوج رسول الله عن عطاء بن يسار الهلالي عن محمد بن يوسف بن عبد الله الأعرج عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عطاء بن يسار عن أم سلمة"
"21225","627  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ ،  ثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ ،  عَنْ  شَرِيكِ بْنِ أَبِي نَمِرٍ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  فِي بَيْتِي نَزَلَتْ هَذِهِ الْآيَةُ         {      إِنَّمَا يُرِيدُ اللهُ لِيُذْهِبَ عَنْكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا         }      ، فَأَرْسَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى  فَاطِمَةَ  وَحَسَنٍ  وَحُسَيْنٍ  ، فَقَالَ : "" اللَّهُمَّ أَهْلِي "" ، فَقُلْتُ : يَا رَسُولَ اللهِ أَنَا مِنْ أَهْلِ الْبَيْتِ ؟ قَالَ : "" إِنْ شَاءَ اللهُ  .","","Al-Mu'jam al-Kabir 627","","هند بنت أبي أمية زوج رسول الله عن عطاء بن يسار الهلالي عن شريك بن عبد الله بن أبي نمر الكناني عن عبد الرحمن بن عبد الله بن دينار العدوي عن عثمان بن عمر بن فارس عن إدريس بن جعفر العطار عن الطبراني","عطاء بن يسار عن أم سلمة"
"21226","عَبْدُ اللهِ بْنُ شَدَّادٍ  عَنْ  أُمِّ سَلَمَةَ  .  628  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  أَبِي عَوْنٍ ، قَالَ :  أَنَا  عَبْدُ اللهِ بْنُ شَدَّادِ بْنِ الْهَادِ ،  قَالَ  :  أَرْسَلَنِي  مَرْوَانُ  إِلَى أُمِّ سَلَمَةَ ، فَسَأَلْتُهَا فَقَالَتْ :  أَتَانِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَقَدْ تَوَضَّأَ ، فَنَاوَلْتُهُ  عَرْقًا  ، أَوْ كَتِفًا  ، فَأَكَلَ  ، ثُمَّ قَامَ إِلَى الصَّلَاةِ ، وَلَمْ يَتَوَضَّأْ  .","","Al-Mu'jam al-Kabir 628","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن شداد بن الهاد الليثي عن محمد بن عبيد الله بن سعيد الثقفي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عبد الله بن شداد عن أم سلمة"
"21227","629  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ جَعْفَرٍ الْقَتَّاتُ ،  حَدَّثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  مِسْعَرٍ ،  عَنْ  أَبِي عَوْنٍ ،  عَنْ  عَبْدِ اللهِ بْنِ شَدَّادٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 629","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن شداد بن الهاد الليثي عن محمد بن عبيد الله بن سعيد الثقفي عن مسعر بن كدام عن علي بن مسهر القرشي عن منجاب بن الحارث التميمي عن الحسين بن جعفر القتات عن الطبراني","عبد الله بن شداد عن أم سلمة"
"21228","630  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ، (  ح  ) .         [23/287]      وَحَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، (  ح  ) .  وَحَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  أَبُو الْوَلِيدِ ، قَالُوا :  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي عَوْنٍ ،  عَنْ  عَبْدِ اللهِ بْنِ شَدَّادٍ ،  عَنْ  أُمِّ سَلَمَةَ  سُئِلَتْ عَمَّا غَيَّرَتِ النَّارُ ؟ فَقَالَتْ :  أَكَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَتِفًا ، ثُمَّ صَلَّى ، وَلَمْ يَتَوَضَّأْ  .","","Al-Mu'jam al-Kabir 630","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن شداد بن الهاد الليثي عن محمد بن عبيد الله بن سعيد الثقفي عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","عبد الله بن شداد عن أم سلمة"
"21229","631  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ الْعَبَّاسِ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  أَبُو خَالِدٍ الْأَحْمَرُ ،  عَنْ  حَجَّاجٍ ،  عَنِ  الْحَسَنِ بْنِ سَعْدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ شَدَّادٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ  أَسْمَاءَ  بَكَتْ عَلَى  جَعْفَرٍ  ، أَوْ  حَمْزَةَ  ،  ثَلَاثًا ، "" فَأَمَرَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ تَرْقَأَ وَتَكْتَحِلَ  .","","Al-Mu'jam al-Kabir 631","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن شداد بن الهاد الليثي عن الحسن بن سعد مولى علي بن أبي طالب عن حجاج بن أرطاة عن سليمان بن حيان الأحمر عن سهل بن عثمان العسكري عن الجمال الحسن بن العباس عن الطبراني","عبد الله بن شداد عن أم سلمة"
"21230","عَلِيُّ بْنُ حُسَيْنٍ  عَنْ  أُمِّ سَلَمَةَ  .  632  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنِ  الْقَاسِمِ بْنِ عَوْفٍ ،  عَنْ  عَلِيِّ بْنِ حُسَيْنٍ ، قَالَ :  حَدَّثَتْنَا  أُمُّ سَلَمَةَ ،  أَنَّ نَبِيَّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَيْنَا هُوَ يَوْمًا قَائِلٌ فِي بَيْتِهَا وَعِنْدَهُ  رَجُلٌ  مِنْ أَصْحَابِهِ يَتَحَدَّثُونَ إِذْ جَاءَ  رَجُلٌ  ، فَقَالَ : يَا رَسُولَ اللهِ كَمْ صَدَقَةُ كَذَا وَكَذَا مِنَ التَّمْرِ ؟ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" كَذَا وَكَذَا "" ، قَالَ الرَّجُلُ : فَإِنَّ  فُلَانًا  تَعَدَّى عَلَيَّ فَأَخَذَ مِنِّي كَذَا وَكَذَا مِنَ التَّمْرِ ، فَازْدَادَ صَاعًا ، فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" فَكَيْفَ إِذَا سَعَى عَلَيْكُمْ مَنْ يَتَعَدَّى عَلَيْكُمْ أَشَدَّ مِنْ هَذَا التَّعَدِّي ؟ "" ، فَخَاضَ  الْقَوْمُ  وَبَهَرَهُمُ الْحَدِيثُ حَتَّى قَالَ  رَجُلٌ  مِنْهُمْ : كَيْفَ يَا رَسُولَ اللهِ إِذَا كَانَ رَجُلٌ غَائِبٌ عَنْكَ فِي إِبِلِهِ وَمَاشِيَتِهِ وَزَرْعِهِ فَأَدَّى زَكَاةَ مَالِهِ فَتُعَدِّي         [23/288]      عَلَيْهِ الْحَقُّ فَكَيْفَ يَصْنَعُ وَهُوَ غَائِبٌ عَنْكَ ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَدَّى زَكَاةَ مَالِهِ طَيِّبَ النَّفْسِ بِهَا يُرِيدُ بِهَا وَجْهَ اللهِ وَالدَّارَ الْآخِرَةِ  ، فَلَمْ يُغَيِّبْ شَيْئًا مِنْ مَالِهِ ، وَأَقَامَ الصَّلَاةَ ، ثُمَّ أَدَّى الزَّكَاةَ فَتُعَدِّي عَلَيْهِ فِي الْحَقِّ ، فَأَخَذَ سِلَاحًا فَقَاتَلَ فَقُتِلَ فَهُوَ  شَهِيدٌ  .","","Al-Mu'jam al-Kabir 632","","هند بنت أبي أمية زوج رسول الله عن علي بن الحسين زين العابدين عن القاسم بن عوف الشيباني عن زيد بن أبي أنيسة الجزري عن عبيد الله بن عمرو بن أبي الوليد عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","علي بن حسين عن أم سلمة"
"21231","عَبْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ  عَنْ  أُمِّ سَلَمَةَ  .  633  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ، وَعَبْدِ الرَّحْمَنِ السِّرَاجِ ،  عَنْ  نَافِعٍ ،  عَنْ  زَيْدِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الَّذِي يَشْرَبُ فِي إِنَاءِ فِضَّةٍ إِنَّمَا  يُجَرْجِرُ  فِي بَطْنِهِ نَارَ  جَهَنَّمَ  .","","Al-Mu'jam al-Kabir 633","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن عبد الرحمن بن أبي بكر الصديق عن زيد بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الرحمن بن عبد الله السراج عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن عبد الرحمن بن أبي بكر عن أم سلمة"
"21232","634  -  حَدَّثَنَا  عَلِيٌّ ،  ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنْ  زَيْدِ بْنِ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 634","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن عبد الرحمن بن أبي بكر الصديق عن زيد بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن عبد الرحمن بن أبي بكر عن أم سلمة"
"21233","635  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ، وَعَبْدَةُ ، قَالَا :  ثَنَا  عُبَيْدُ اللهِ ،  عَنْ  نَافِعٍ ،  عَنْ  زَيْدِ بْنِ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 635","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن عبد الرحمن بن أبي بكر الصديق عن زيد بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبدة بن سليمان الكلابي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","عبد الله بن عبد الرحمن بن أبي بكر عن أم سلمة"
"21234","عَوْفُ بْنُ الْحَارِثِ بْنِ الطُّفَيْلِ  عَنْ  أُمِّ سَلَمَةَ  .  636  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ لُوَيْنٌ ،         [23/289]      ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ حُصَيْنٍ ،  عَنْ  عَوْفِ بْنِ الْحَارِثِ بْنِ الطُّفَيْلِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَعْنِي لِأَزْوَاجِهِ  :  الَّذِي يَحْنُو عَلَيْكُنَّ بَعْدِي لَهُوَ الصَّادِقُ الْبَارُّ  ، اللَّهُمَّ اسْقِ  ابْنَ عَوْفٍ  مِنَ السَّلْسَبِيلِ  .","","Al-Mu'jam al-Kabir 636","","هند بنت أبي أمية زوج رسول الله عن عوف بن الحارث بن الطفيل الأزدي عن محمد بن عبد الرحمن بن عبد الله بن الحصين التميمي عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن محمد بن سليمان لوين عن الحسين بن إسحاق التستري عن الطبراني","عوف بن الحارث بن الطفيل عن أم سلمة"
"21235","الْمُطَّلِبُ بْنُ عَبْدِ اللهِ بْنِ حَنْطَبٍ  عَنْ  أُمِّ سَلَمَةَ  - رَضِيَ اللهُ عَنْهَا - .  637  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنْ  كَثِيرِ بْنِ زَيْدٍ ،  عَنِ  الْمُطَّلِبِ بْنِ عَبْدِ اللهِ بْنِ حَنْطَبٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَالِسًا ذَاتَ يَوْمٍ فِي بَيْتِي ، فَقَالَ :  لَا يَدْخُلْ عَلَيَّ أَحَدٌ  ، فَانْتَظَرْتُ فَدَخَلَ  الْحُسَيْنُ  فَسَمِعْتُ  نَشِيجَ  رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَبْكِي ، فَاطَّلَعْتُ فَإِذَا  حُسَيْنٌ  فِي حِجْرِهِ ، أَوْ إِلَى جَنْبِهِ  ، يَمْسَحُ رَأْسَهُ وَهُوَ يَبْكِي ، فَقُلْتُ : وَاللهِ مَا عَلِمْتُهُ حِينَ دَخَلَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" إِنَّ  جِبْرِيلَ  كَانَ فِي الْبَيْتِ ، فَقَالَ : أَتُحِبُّهُ ؟ قُلْتُ : أَمَّا فِي الدُّنْيَا فَنَعَمْ ، قَالَ : إِنَّ أُمَّتَكَ سَتَقْتُلُ هَذَا بِأَرْضٍ يُقَالُ لَهَا  كَرْبَلَاءُ  ، فَتَنَاوَلَ  جِبْرِيلُ  مِنْ تُرْبَتِهَا فَأَرَاهُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" ، فَلَمَّا أُحِيطَ  بِحُسَيْنٍ  حِينَ قُتِلَ قَالَ : مَا اسْمُ هَذِهِ الْأَرْضِ ؟ قَالُوا :  كَرْبَلَاءُ  ، قَالَ : صَدَقَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَرْضُ كَرْبٍ وَبَلَاءٍ  .","","Al-Mu'jam al-Kabir 637","","هند بنت أبي أمية زوج رسول الله عن المطلب بن عبد الله بن حنطب المخزومي عن كثير بن زيد السهمي عن سليمان بن بلال القرشي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","المطلب بن عبد الله بن حنطب عن أم سلمة"
"21236","[23/290]      سُلَيْمَانُ مَوْلَى أُمِّ سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  638  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  سَعِيدُ بْنُ زَيْدٍ ،  عَنْ  عَلِيِّ بْنِ الْحَكَمِ الْبُنَانِيِّ ، قَالَ :  حَدَّثَنِي  سُلَيْمَانُ مَوْلًى لِأُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ يُوضَعُ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِنَاءٌ وَاحِدٌ قَدْرَ نِصْفِ  الْفَرَقِ  ، فَيَبْدَأُ فِيهِ ، فَيَغْتَسِلُ أَنَا وَهُوَ جَمِيعًا  .","","Al-Mu'jam al-Kabir 638","","هند بنت أبي أمية زوج رسول الله عن سليمان بن يسار مولى ميمونة زوج رسول الله عن علي بن الحكم البناني عن سعيد بن زيد الجهضمي عن محمد بن أبان بن عمران السلمي عن عبد الله بن أحمد بن حنبل عن الطبراني","سليمان مولى أم سلمة عن أم سلمة"
"21237","ثَابِتٌ مَوْلَى أُمِّ سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  639  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَابِهْرَامَ الْإِيذَجِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مَرْزُوقٍ ،  ثَنَا  بُهْلُولُ بْنُ مُوَرِّقٍ ،  ثَنَا  مُوسَى بْنُ عُبَيْدَةَ ،  حَدَّثَنِي  ثَابِتٌ مَوْلَى أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعْدَ الْعَصْرِ فَصَلَّى رَكْعَتَيْنِ فَقُلْتُ : مَا هَاتَانِ الرَّكْعَتَانِ يَا رَسُولَ اللهِ ؟ قَالَ :  كُنْتُ أُصَلِّيهِمَا قَبْلَ الْعَصْرِ فَجَاءَنِي قَوْمٌ فَشَغَلُونِي فَصَلَّيْتُهُمَا الْآنَ  .","","Al-Mu'jam al-Kabir 639","","هند بنت أبي أمية زوج رسول الله عن ثابت مولى أم سلمة عن موسى بن عبيدة بن نشيط الحميري عن بهلول بن مورق الشامى عن محمد بن محمد بن مرزوق الباهلي عن أحمد بن الحسين بن مابهرام الأيذجي عن الطبراني","ثابت مولى أم سلمة عن أم سلمة"
"21238","نَافِعٌ مَوْلَى ابْنِ عُمَرَ  عَنْ  أُمِّ سَلَمَةَ  .  640  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  ابْنُ جُرَيْجٍ ، قَالَ :  كَتَبَ إِلَيَّ  عَبْدُ اللهِ بْنُ زِيَادِ بْنِ سَمْعَانَ ، أَنَّ عَبْدَ اللهِ بْنَ عَبْدِ الرَّحْمَنِ الْأَنْصَارِيَّ  أَخْبَرَهُ  ،  عَنْ  نَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ  غُلَامًا  لَهَا طَلَّقَ  امْرَأَةً         [23/291]      لَهُ حُرَّةً بِتَطْلِيقَتَيْنِ ، فَاسْتَفْتَتْ  أُمُّ سَلَمَةَ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  حَرُمَتْ عَلَيْهِ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ  .","","Al-Mu'jam al-Kabir 640","","هند بنت أبي أمية زوج رسول الله عن نافع مولى ابن عمر عن عبد الله بن عبد الرحمن بن معمر الأنصاري عن عبد الله بن زياد المخزومي عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","نافع مولى ابن عمر عن أم سلمة"
"21239","641  -  قَالَ  عَبْدُ الرَّزَّاقِ :  وَسَمِعْتُ  أَنَا عَبْدَ اللهِ بْنَ زِيَادٍ ، يُحَدِّثُ أَنَّ عَبْدَ اللهِ بْنَ عَبْدِ الرَّحْمَنِ  أَخْبَرَهُ  ،  عَنْ  نَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ ، ثُمَّ ذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 641","","هند بنت أبي أمية زوج رسول الله عن نافع مولى ابن عمر عن عبد الله بن عبد الرحمن بن معمر الأنصاري عن عبد الله بن زياد المخزومي عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","نافع مولى ابن عمر عن أم سلمة"
"21240","642  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ ،  ثَنَا  عَبْدَةُ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" يُصْبِحُ  جُنُبًا  مِنَ الْوِقَاعِ لَا مِنَ الِاحْتِلَامِ ، ثُمَّ يُتِمُّ صَوْمَهُ  "" .","","Al-Mu'jam al-Kabir 642","","هند بنت أبي أمية زوج رسول الله عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبدة بن سليمان الكلابي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","نافع مولى ابن عمر عن أم سلمة"
"21241","643  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ ،  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْلَى ،  ثَنَا  عَنْبَسَةُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ نَافِعٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ  الْقُنُوتِ  فِي صَلَاةِ الصُّبْحِ  .","","Al-Mu'jam al-Kabir 643","","هند بنت أبي أمية زوج رسول الله عن نافع مولى ابن عمر عن عبد الله بن نافع مولى عبد الله بن عمر عن عنبسة بن عبد الرحمن بن عنبسة الأموي عن زنبور ، محمد بن يعلى السلمي عن إبراهيم بن بشار الرمادى عن محمد بن محمد بن حيان التمار عن الطبراني","نافع مولى ابن عمر عن أم سلمة"
"21242","644  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ ،  ثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ،  ثَنَا  مُوسَى بْنُ عَاصِمٍ ،  عَنْ  مُوسَى بْنِ عُبَيْدَةَ ،  عَنْ  نَافِعٍ ، قَالَ :  سَمِعْتُ  أُمَّ سَلَمَةَ ، قَالَتْ :  كُنْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي لِحَافٍ  فَانْسَلَلْتُ  مِنْ لِحَافِهِ ، فَقَالَ :         [23/292]      "" مَا لَكِ ؟  أَنَفِسْتِ  ؟ "" ، قُلْتُ : نَعَمْ ، قَالَ :  شُدِّي عَلَيْكِ مِئْزَرَكِ وَعُودِي حَيْثُ كُنْتِ  .","","Al-Mu'jam al-Kabir 644","","هند بنت أبي أمية زوج رسول الله عن نافع مولى ابن عمر عن موسى بن عبيدة بن نشيط الحميري عن موسى بن عاصم عن محمد بن معمر بن ربعي البحراني عن أحمد بن يحيى بن زهير التستري عن الطبراني","نافع مولى ابن عمر عن أم سلمة"
"21243","يَعْلَى بْنُ مَمْلَكٍ  عَنْ  أُمِّ سَلَمَةَ  .  645  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي مُلَيْكَةَ ،  عَنْ  يَعْلَى بْنِ مَمْلَكٍ ،  أَنَّهُ سَأَلَ  أُمَّ سَلَمَةَ زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ صَلَاةِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ :  كَانَ يُصَلِّي الْعِشَاءَ الْآخِرَةَ ، ثُمَّ يُسَبِّحُ ، ثُمَّ يُصَلِّي بَعْدَهَا مَا شَاءَ اللهُ مِنَ اللَّيْلِ  ، ثُمَّ يَنْصَرِفُ فَيَرْقُدُ مِثْلَ مَا صَلَّى ، ثُمَّ يَسْتَيْقِظُ مِنْ نَوْمَتِهِ تِلْكَ فَيُصَلِّي مِثْلَ مَا نَامَ ، فَصَلَاتُهُ تِلْكَ الْآخِرَةُ تَكُونُ إِلَى الصُّبْحِ  .","","Al-Mu'jam al-Kabir 645","","هند بنت أبي أمية زوج رسول الله عن يعلى بن مملك المكي عن ابن أبي مليكة عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","يعلى بن مملك عن أم سلمة"
"21244","646  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  أَبُو صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  عَنِ  ابْنِ لَهِيعَةَ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  يَعْلَى بْنِ مَمْلَكٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّهَا نَعَتَتْ قِرَاءَةَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَإِذَا هِيَ تَنْعَتُ قِرَاءَةً مُفَسَّرَةً حَرْفًا حَرْفًا  "" .","","Al-Mu'jam al-Kabir 646","","هند بنت أبي أمية زوج رسول الله عن يعلى بن مملك المكي عن ابن أبي مليكة عن عبد الله بن لهيعة عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","يعلى بن مملك عن أم سلمة"
"21245","أَبُو جَعْفَرٍ مُحَمَّدُ بْنُ عَلِيٍّ  عَنْ  أُمِّ سَلَمَةَ  .  647  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  الْقَاسِمُ بْنُ         [23/293]      الْفَضْلِ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْحَجُّ  جِهَادُ  كُلِّ ضَعِيفٍ  .","","Al-Mu'jam al-Kabir 647","","هند بنت أبي أمية زوج رسول الله عن أبو جعفر الباقر عن القاسم بن الفضل بن معدان عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو جعفر محمد بن علي عن أم سلمة"
"21246","648  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ زُرَارَةَ ،  ثَنَا  عِصْمَتُ بْنُ عَبْدِ اللهِ الْأَسَدِيُّ ،  ثَنَا  أَبُو مَرْيَمَ ،  عَنِ  الْحَكَمِ ،  عَنْ  أَبِي جَعْفَرٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ لِي غَزَالٌ مِنْ ذَهَبٍ "" فَأَمَرَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ أَتَصَدَّقَ بِهِ فَفَعَلْتُ  .","","Al-Mu'jam al-Kabir 648","","هند بنت أبي أمية زوج رسول الله عن أبو جعفر الباقر عن الحكم بن عتيبة الكندي عن عبد الغفار بن القاسم الأنصاري عن عصمت بن عبد الله الأسدي عن إسماعيل بن عبد الله بن زرارة الثغري عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو جعفر محمد بن علي عن أم سلمة"
"21247","سَعِيدُ بْنُ مَرْجَانَةَ  عَنْ  أُمِّ سَلَمَةَ  .  649  -  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  طَاهِرُ بْنُ خَالِدِ بْنِ نِزَارٍ ،  ثَنَا  أَبِي  ،  ثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  نَافِعٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  أَنَّهُ حَدَّثَهُ  ابْنُ مَرْجَانَةَ ،  عَنْ  أُمِّ سَلَمَةَ أَنَّهَا قَالَتْ :  إِنَّ  امْرَأَةً  كَانَتْ  تُهَرَاقُ  الدِّمَاءَ عَلَى عَهْدِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَإِنَّ  أُمَّ سَلَمَةَ  سَأَلَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ أَمْرِهَا ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لِتَنْظُرْ عَدَدَ الْأَيَّامِ وَاللَّيَالِي الَّتِي كَانَتْ تَحِيضُ قَبْلَ أَنْ يَكُونَ بِهَا الدَّمُ الَّذِي كَانَ وَقَدْرَهُنَّ مِنَ  الشَّهْرِ  ، فَلْتَتْرُكِ الصَّلَاةَ قَدْرَ ذَلِكَ ، فَإِذَا جَاوَزَتْ ذَلِكَ فَلْتَغْتَسِلْ ، ثُمَّ  لِتَسْتَثْفِرْ  بِثَوْبِهَا وَلْتُصَلِّ  .","","Al-Mu'jam al-Kabir 649","","هند بنت أبي أمية زوج رسول الله عن سعيد ابن مرجانة العامري عن سليمان بن يسار مولى ميمونة زوج رسول الله عن نافع مولى ابن عمر عن موسى بن عقبة عن إبراهيم بن طهمان عن خالد بن نزار عن طاهر بن خالد بن نزار الأيلي عن سعيد بن عبد الرحمن عن الطبراني","سعيد بن مرجانة عن أم سلمة"
"21248","عَبْدُ الرَّحْمَنِ بْنُ شَيْبَةَ  عَنْ  أُمِّ سَلَمَةَ  .  650  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَفَّانُ ،  ثَنَا  عَبْدُ الْوَاحِدِ         [23/294]      بْنُ زِيَادٍ ،  ثَنَا  عُثْمَانُ بْنُ حَكِيمٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ شَيْبَةَ ، قَالَ :  سَمِعْتُ  أُمَّ سَلَمَةَ ، تَقُولُ :  قُلْتُ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : مَا لَنَا لَا نُذْكَرُ فِي الْقُرْآنِ كَمَا يُذْكَرُ الرِّجَالُ ؟ فَلَمْ  يَرُعْنِي  ذَاتَ يَوْمٍ إِلَّا وَقِرَاءَةٌ عَلَى الْمِنْبَرِ ، وَأَنَا أُسَرِّحُ رَأْسِي ، فَلَفَفْتُ شَعَرِي ، ثُمَّ خَرَجْتُ إِلَى حُجْرَتِي ، فَجَعَلْتُ سَمْعِي عِنْدَ الْجَرِيدِ ، فَإِذَا هُوَ يَقُولُ عَلَى الْمِنْبَرِ :  يَا أَيُّهَا الَّذِينَ آمَنُوا إِنَّ اللهَ يَقُولُ فِي كِتَابِهِ :         {      إِنَّ الْمُسْلِمِينَ وَالْمُسْلِمَاتِ وَالْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ         }      إِلَى آخِرِ الْآيَةِ  .","","Al-Mu'jam al-Kabir 650","","هند بنت أبي أمية زوج رسول الله عن عبد الرحمن بن شيبة الحجبي عن عثمان بن حكيم الأحلافي عن عبد الواحد بن زياد عن عفان بن مسلم الصفار عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الرحمن بن شيبة عن أم سلمة"
"21249","سَلَمَةُ مِنْ وَلَدِ أُمِّ سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  651  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  سَلَمَةَ ، مِنْ وَلَدِ أُمِّ سَلَمَةَ ، [ قَالَتْ ] :  قُلْتُ : يَا رَسُولَ اللهِ لَمْ أَسْمَعِ اللهَ ذَكَرَ النِّسَاءَ فِي الْهِجْرَةِ ، فَأَنْزَلَ اللهُ         {      إِنَّ اللهَ لا يُضِيعُ         }             {      أَنِّي لا أُضِيعُ عَمَلَ عَامِلٍ مِنْكُمْ مِنْ ذَكَرٍ أَوْ أُنْثَى         }      .","","Al-Mu'jam al-Kabir 651","","سلمة بن عبد الله المخزومي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","سلمة من ولد أم سلمة عن أم سلمة"
"21250","652  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْخَلَّالُ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  سَلَمَةَ ، رَجُلٍ مِنْ وَلَدِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ،         [23/295]      قَالَتْ :  خَاصَمَ  الزُّبَيْرُ  رَجُلًا  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَضَى  لِلزُّبَيْرِ  ،  فَقَالَ الرَّجُلُ : إِنَّمَا قَضَى لَهُ لِأَنَّهُ ابْنُ عَمَّتِهِ ، فَنَزَلَتْ         {      فَلا وَرَبِّكَ لا يُؤْمِنُونَ حَتَّى يُحَكِّمُوكَ         }      الْآيَةَ  .","","Al-Mu'jam al-Kabir 652","","هند بنت أبي أمية زوج رسول الله عن سلمة بن عبد الله المخزومي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","سلمة من ولد أم سلمة عن أم سلمة"
"21251","عَبْدُ اللهِ بْنُ فَرُّوخَ  عَنْ  أُمِّ سَلَمَةَ  .  653  -  حَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ ،  عَنْ  طَلْحَةَ بْنِ يَحْيَى ،  عَنْ  عَبْدِ اللهِ بْنِ فَرُّوخَ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ "" يُقَبِّلُ وَهُوَ صَائِمٌ  .","","Al-Mu'jam al-Kabir 653","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن فروخ مولى آل طلحة بن عبيد الله عن طلحة بن يحيى بن طلحة التيمي عن عبد الله بن داود الخريبي عن مسدد بن مسرهد عن الفضل بن الحباب الجمحي عن الطبراني","عبد الله بن فروخ عن أم سلمة"
"21252","654  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  طَلْحَةَ بْنِ يَحْيَى ،  عَنْ  عَبْدِ اللهِ بْنِ فَرُّوخَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" يُقَبِّلُنِي وَأَنَا صَائِمَةٌ وَهُوَ صَائِمٌ  .","","Al-Mu'jam al-Kabir 654","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن فروخ مولى آل طلحة بن عبيد الله عن طلحة بن يحيى بن طلحة التيمي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبد الله بن فروخ عن أم سلمة"
"21253","عَبْدُ اللهِ بْنُ الْحَارِثِ بْنِ نَوْفَلٍ  عَنْ  أُمِّ سَلَمَةَ  .  655  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبِيدَةُ بْنُ حُمَيْدٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" صَلَّى فِي بَيْتِهَا رَكْعَتَيْنِ بَعْدَ الْعَصْرِ لَمْ يُصَلِّهَا قَبْلُ وَلَا بَعْدُ  "" .","","Al-Mu'jam al-Kabir 655","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن الحارث بن نوفل عن يزيد بن أبي زياد القرشي عن عبيدة بن حميد بن صهيب التيمي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","عبد الله بن الحارث بن نوفل عن أم سلمة"
"21254","656  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُوسَى الشَّامِيُّ الْبَصْرِيُّ ،  ثَنَا  سَهْلُ بْنُ تَمَّامِ بْنِ بَزِيعٍ ،  ثَنَا  عِمْرَانُ الْقَطَّانُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْخَلِيلِ ،  عَنْ  عَبْدِ اللهِ بْنِ         [23/296]      الْحَارِثِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يُبَايَعُ لِرَجُلٍ بَيْنَ  الرُّكْنِ  وَالْمَقَامِ  عِدَّةُ  أَهْلِ بَدْرٍ  ، فَيَأْتِيهِ  عَصَائِبُ  أَهْلِ الْعِرَاقِ  ،  وَأَبْدَالُ  أَهْلِ الشَّامِ  ، فَيَغْزُوهُمْ جَيْشٌ مِنْ  أَهْلِ الشَّامِ  حَتَّى إِذَا كَانُوا  بِالْبَيْدَاءِ  خُسِفَ بِهِمْ ، يَغْزُوهُمْ رَجُلٌ مِنْ  قُرَيْشٍ  أَخْوَالُهُ  كَلْبٌ  ، فَيَلْتَقُونَ فَيَهْزِمُهُمْ "" . فَكَانَ يُقَالُ : الْخَائِبُ مَنْ خَابَ مِنْ غَنِيمَةِ  كَلْبٍ  .","","Al-Mu'jam al-Kabir 656","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن الحارث بن نوفل عن صالح بن أبي مريم الضبعي عن قتادة بن دعامة عن عمران بن داور القطان عن سهل بن تمام الطفاوي عن أحمد بن موسى بن يزيد السامي عن الطبراني","عبد الله بن الحارث بن نوفل عن أم سلمة"
"21255","عَبْدُ اللهِ بْنُ رَافِعٍ مَوْلَى أُمِّ سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  657  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  أَيُّوبَ بْنِ مُوسَى ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ رَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  قُلْتُ : يَا رَسُولَ اللهِ إِنِّي امْرَأَةٌ أَشُدُّ  ضَفْرَ  رَأْسِي أَفَأَنْقُضُهُ لِلْجَنَابَةِ ؟ قَالَ :  لَا إِنَّمَا يَكْفِيكِ أَنْ تَأْخُذِي بِكَفَّيْكِ حَفَنَاتٍ ، ثُمَّ تَصُبِّينَ عَلَى جِلْدِكِ الْمَاءَ ، فَتَطْهُرِينَ  .","","Al-Mu'jam al-Kabir 657","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن سعيد المقبري عن أيوب بن موسى الأموي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عبد الله بن رافع مولى أم سلمة عن أم سلمة"
"21256","658  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ، (  ح  ) .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  أَيُّوبَ بْنِ مُوسَى ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ رَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 658","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن سعيد المقبري عن أيوب بن موسى الأموي عن سفيان بن عيينة عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبد الله بن رافع مولى أم سلمة عن أم سلمة"
"21257","[23/297]      659  -  حَدَّثَنَا  الْحَسَنُ بْنُ سَهْلٍ الْمُجَوِّزُ الْبَصْرِيُّ ،  ثَنَا  أَبُو عَاصِمٍ ،  ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الْمَقْبُرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ رَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  قَالَتْ  أُمُّ سُلَيْمٍ  : يَا رَسُولَ اللهِ الْمَرْأَةُ تَحْتَلِمُ ؟ قَالَ :  إِذَا نَزَلَ الْمَاءُ الْأَصْفَرُ ، فَلْتَغْتَسِلْ  .","","Al-Mu'jam al-Kabir 659","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن سعيد المقبري عن محمد بن عبد الرحمن بن المغيرة عن أبو عاصم النبيل عن الحسن بن سهل بن عبد العزيز المجوز عن الطبراني","عبد الله بن رافع مولى أم سلمة عن أم سلمة"
"21258","660  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عُلَيَّةَ ، (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الرَّقَاشِيُّ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ رَافِعٍ ، قَالَ :  سَمِعْتُ  أُمَّ سَلَمَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا حَضَرَ  الْعَشَاءُ  ، وَحَضَرَتِ الصَّلَاةُ فَابْدَءُوا بِالْعَشَاءِ  .","","Al-Mu'jam al-Kabir 660","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن محمد بن إسحاق عن يزيد بن زريع العيشي عن محمد بن عبد الله بن محمد بن عبد الملك الرقاشي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن رافع مولى أم سلمة عن أم سلمة"
"21259","661  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  حَرْمَلَةُ بْنُ يَحْيَى ،  ثَنَا  ابْنُ وَهْبٍ ،  حَدَّثَنِي  عَمْرُو بْنُ الْحَارِثِ ، أَنَّ بُكَيْرَ بْنَ عَبْدِ اللهِ بْنِ الْأَشَجِّ  حَدَّثَهُ  ،  عَنِ  الْقَاسِمِ بْنِ عَبَّاسٍ الْهَاشِمِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ رَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنِّي لَكُمْ  فَرَطٌ  عَلَى الْحَوْضِ  ، فَإِيَّايَ أَنْ لَا يَأْتِيَ أَحَدُكُمْ فَيُذَبُّ كَمَا يُذَبُّ الْبَعِيرُ الضَّالُّ ، فَأَقُولُ : فِيمَ هَذَا ؟ فَيُقَالُ : إِنَّكَ لَا تَدْرِي مَا أَحْدَثُوا بَعْدَكَ ، فَأَقُولُ :  سُحْقًا  .","","Al-Mu'jam al-Kabir 661","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن القاسم بن العباس اللهبي عن بكير بن عبد الله بن الأشج القرشي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن حرملة بن يحيى التجيبي عن الحسين بن إسحاق التستري عن الطبراني","عبد الله بن رافع مولى أم سلمة عن أم سلمة"
"21260","662  -  حَدَّثَنَا  السَّرَّاجُ هُوَ الْحَسَنُ بْنُ عَلِيٍّ ، قَالَ :  ثَنَا  الْفَضْلُ بْنُ يَعْقُوبَ ،  ثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَبْدِ اللهِ بْنِ رَافِعٍ ،  عَنْ  أُمِّ         [23/298]      سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 662","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن الفضل بن يعقوب الجزري عن السراج هو الحسن بن علي عن الطبراني","عبد الله بن رافع مولى أم سلمة عن أم سلمة"
"21261","663  -  حَدَّثَنَا  أَبُو يَحْيَى الرَّازِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ رَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّكُمْ تَخْتَصِمُونَ إِلَيَّ ، وَإِنَّمَا أَنَا بَشَرٌ ، فَإِنَّمَا أَقْضِي بَيْنَكُمْ عَلَى نَحْوِ مَا أَسْمَعُ مِنْكُمْ  ، فَمَنْ قَضَيْتُ لَهُ مِنْ حَقِّ أَخِيهِ شَيْئًا فَإِنَّمَا أَقْطَعُ لَهُ قِطْعَةً مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 663","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن أسامة بن زيد الليثي المدني عن وكيع بن الجراح عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","عبد الله بن رافع مولى أم سلمة عن أم سلمة"
"21262","664  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  خَالِدِ بْنِ إِلْيَاسَ ،  عَنْ  عَبْدِ اللهِ بْنِ رَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ "" إِذَا تَوَضَّأَ خَلَّلَ لِحْيَتَهُ  .","","Al-Mu'jam al-Kabir 664","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن خالد بن الياس العدوي عن أبو معاوية الضرير عن سليمان بن داود العتكي عن عبد الله بن أحمد بن حنبل عن الطبراني","عبد الله بن رافع مولى أم سلمة عن أم سلمة"
"21263","665  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنْ  عُثْمَانَ بْنِ حَكِيمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ رَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  قُلْتُ : يَا رَسُولَ اللهِ مَا لَنَا لَا نُذْكَرُ فِي الْقُرْآنِ كَمَا يُذْكَرُ الرِّجَالُ  ؟         [23/299]      فَلَمْ  يَرُعْنِي  إِلَّا  وَنِدَاءٌ  عَلَى الْمِنْبَرِ ، وَأَنَا أُسَرِّحُ رَأْسِي فَلَفَفْتُ شَعَرِي ، ثُمَّ جَعَلْتُ سَمْعِي عِنْدَ الْجَرِيدِ ، فَسَمِعْتُهُ يَقُولُ :         {      إِنَّ الْمُسْلِمِينَ وَالْمُسْلِمَاتِ         }      الْآيَةَ  .","","Al-Mu'jam al-Kabir 665","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن عثمان بن حكيم الأحلافي عن عبد الواحد بن زياد عن محمد بن المنهال عن الحسين بن إسحاق التستري عن الطبراني","عبد الله بن رافع مولى أم سلمة عن أم سلمة"
"21264","666  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ ،  حَدَّثَنَا  أَبِي  ،  ثَنَا  بَكْرُ بْنُ مُضَرَ ،  عَنْ  مُوسَى بْنِ جُبَيْرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ رَافِعٍ مَوْلَى أُمِّ سَلَمَةَ ،  أَنَّ  أُمَّ سَلَمَةَ ، قَالَتْ :  أَكْثَرُ مَا عَلِمْتُ أُتِيَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَرِيطَةً مِنَ الْمَالِ فِيهَا ثَمَانُمِائَةِ دِرْهَمٍ  .","","Al-Mu'jam al-Kabir 666","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن موسى بن جبير الأنصاري عن بكر بن مضر المصري عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","عبد الله بن رافع مولى أم سلمة عن أم سلمة"
"21265","667  -  حَدَّثَنَا  عَبْدَانُ ،  ثَنَا  سَعِيدُ بْنُ الرَّبِيعِ ،  ثَنَا  الْحَارِثُ بْنُ عُبَيْدٍ ،  عَنِ  الْمُغِيرَةِ بْنِ حَبِيبٍ ،  عَنْ  مَوْلًى لِأُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الْحِجَامَةَ فِي الرَّأْسِ دَوَاءٌ مِنْ دَاءِ الْجُنُونِ وَالْجُذَامِ وَالْعَشَا وَالْبَرَصِ وَالصُّدَاعِ  .","","Al-Mu'jam al-Kabir 667","","هند بنت أبي أمية زوج رسول الله عن مولى لأم سلمة عن المغيرة بن حبيب الأزدي عن الحارث بن عبيد الإيادي عن سعيد بن الربيع الحرشي عن عبد الله بن أحمد الجواليقي عن الطبراني","عبد الله بن رافع مولى أم سلمة عن أم سلمة"
"21266","مَا رَوَى  عَامِرُ بْنُ أَبِي أُمَيَّةَ أَخُو أُمِّ سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  668  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  أَبَانُ ،  ثَنَا  قَتَادَةُ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَامِرٍ أَخِي أُمِّ سَلَمَةَ  ،  عَنْ  أُمِّ سَلَمَةَ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ "" يُصْبِحُ  جُنُبًا  ، فَيَصُومُ ذَلِكَ الْيَوْمَ  .","","Al-Mu'jam al-Kabir 668","","هند بنت أبي أمية زوج رسول الله عن عامر بن أبي أمية المخزومي عن سعيد بن المسيب عن قتادة بن دعامة عن أبان بن يزيد العطار عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ما روى عامر بن أبي أمية أخو أم سلمة عن أم سلمة"
"21267","669  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَامِرٍ أَخِي أُمِّ سَلَمَةَ  ،  عَنْ  أُمِّ سَلَمَةَ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُصْبِحُ  جُنُبًا  ثُمَّ يَغْتَسِلُ وَيَصُومُ  .         [23/300]","","Al-Mu'jam al-Kabir 669","","هند بنت أبي أمية زوج رسول الله عن عامر بن أبي أمية المخزومي عن سعيد بن المسيب عن قتادة بن دعامة عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن عثمان بن عمر الضبي عن الطبراني","ما روى عامر بن أبي أمية أخو أم سلمة عن أم سلمة"
"21268","670  -  حَدَّثَنَا  أَبُو هَارُونَ الشِّيرِينِيُّ  ،  ثَنَا  عَبْدُ الْمَلِكِ الْجُدِّيُّ ،  عَنْ  شُعْبَةَ ،  عَنْ  قَتَادَةَ وَعَمْرِو بْنِ مُرَّةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَامِرٍ ،  عَنْ  أُمِّ سَلَمَةَ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .  كذا في طبعة مكتبة ابن تيمية ، ولعل الصواب: ( السريني) .","","Al-Mu'jam al-Kabir 670","","هند بنت أبي أمية زوج رسول الله عن عامر بن أبي أمية المخزومي عن سعيد بن المسيب عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن عبد الملك بن إبراهيم الجدي عن موسى بن محمد بن كثير السريني عن الطبراني","ما روى عامر بن أبي أمية أخو أم سلمة عن أم سلمة"
"21269","671  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقَزَّازُ ،  ثَنَا  أَبُو عُمَرَ الْحَوْضِيُّ ،  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَامِرٍ ،  عَنْ  أُمِّ سَلَمَةَ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 671","","هند بنت أبي أمية زوج رسول الله عن عامر بن أبي أمية المخزومي عن سعيد بن المسيب عن قتادة بن دعامة عن همام بن يحيى بن دينار عن حفص بن عمر الحوضى عن محمد بن يحيى بن المنذر القزاز عن الطبراني","ما روى عامر بن أبي أمية أخو أم سلمة عن أم سلمة"
"21270","672  -  حَدَّثَنَا  أَبُو يَحْيَى الرَّازِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  شُعْبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَامِرٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 672","","هند بنت أبي أمية زوج رسول الله عن عامر بن أبي أمية المخزومي عن سعيد بن المسيب عن قتادة بن دعامة عن شعبة بن الحجاج عن يزيد بن زريع العيشي عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","ما روى عامر بن أبي أمية أخو أم سلمة عن أم سلمة"
"21271","عَبْدُ اللهِ بْنُ أَبِي أُمَيَّةَ أَخُو أُمِّ سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  673  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ الْأَصْبَهَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبَادَةَ ،  ثَنَا  يَعْقُوبُ الزُّهْرِيُّ ،  ثَنَا  الْمُطَّلِبُ بْنُ كَثِيرٍ ،  ثَنَا  الزُّبَيْرُ بْنُ مُوسَى ،  عَنْ  مُصْعَبِ بْنِ عَبْدِ اللهِ بْنِ أَبِي أُمَيَّةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  رَأَيْتُ  لِأَبِي جَهْلٍ  عُتَقَاءَ فِي الْجَنَّةِ  ، فَلَمَّا أَسْلَمَ  عِكْرِمَةُ  ، قَالَ : "" هُوَ هَذَا  .","","Al-Mu'jam al-Kabir 673","","هند بنت أبي أمية زوج رسول الله عن مصعب بن عبد الله بن أبي أمية المخزومي عن الزبير بن موسى بن ميناء المكي عن المطلب بن كثير عن يعقوب بن محمد بن عيسى عن محمد بن عبادة بن البخترى الأسدي عن محمد بن أبان الأصبهاني عن الطبراني","عبد الله بن أبي أمية أخو أم سلمة عن أم سلمة"
"21272","674  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  أَبُو الْمُعَافَى الْحَرَّانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي عَبْدِ الرَّحِيمِ ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ         [23/301]      عَبْدِ اللهِ أَخِي أُمِّ سَلَمَةَ  ، قَالَ :  سَمِعْتُ  أُمَّ سَلَمَةَ  ، تَقُولُ :  لَقَدْ خَرَجَ  أَبُو بَكْرٍ  عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَاجِرًا إِلَى  بُصْرَى  ، لَمْ يَمْنَعْ  أَبَا بَكْرٍ  مِنَ الضَّنِّ بِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  شُحُّهُ  عَلَى نَصِيبِهِ مِنَ الشُّخُوصِ لِلتِّجَارَةِ ، وَذَلِكَ كَانَ لِإِعْجَابِهِمْ كَسْبَ التِّجَارَةِ وَحُبِّهِمْ لِلتِّجَارَةِ ، وَلَمْ يَمْنَعْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَبَا بَكْرٍ  مِنَ الشُّخُوصِ فِي تِجَارَتِهِ لِحُبِّهِ صُحْبَتَهُ وَضَنِّهِ  بِأَبِي بَكْرٍ  ، فَقَدْ كَانَ بِصُحْبَتِهِ مُعْجَبًا ، لِاسْتِحْسَانِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِلتِّجَارَةِ ، وَإِعْجَابِهِ بِهَا  .","","Al-Mu'jam al-Kabir 674","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن أبي أمية المخزومي صهر رسول الله عن الزهري عن زيد بن أبي أنيسة الجزري عن خالد بن يزيد الحراني عن محمد بن سلمة الباهلي عن محمد بن وهب بن عمر الحراني عن الحسين بن إسحاق التستري عن الطبراني","عبد الله بن أبي أمية أخو أم سلمة عن أم سلمة"
"21273","عَبْدُ اللهِ بْنُ عَبْدِ اللهِ بْنِ أَبِي أُمَيَّةَ  عَنْ  أُمِّ سَلَمَةَ  .  675  -  حَدَّثَنَا  الْمَعْمَرِيُّ ،  ثَنَا  عَمْرُو بْنُ عُثْمَانَ ،  ثَنَا  أَبِي  ، (  ح  ) .  وَحَدَّثَنَا  أَبُو الزِّنْبَاعِ ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ، [ قَالَا ] :  ثَنَا  عَبْدُ اللهِ بْنُ أَبِي السَّمْحِ ،  عَنِ  ابْنِ أَبِي ذِئْبٍ ،  عَنِ  الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ أَبِي أُمَيَّةَ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  تَوَضَّئُوا مِمَّا مَسَّتِ النَّارُ  .","","Al-Mu'jam al-Kabir 675","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن عبد الله بن أبي أمية بن المغيرة المخزومي عن محمد بن عبد الرحمن بن ثوبان القرشي عن الحارث بن عبد الرحمن العامري عن محمد بن عبد الرحمن بن المغيرة عن عبد الله بن أبي السمح عن عثمان بن سعيد بن كثير عن عمرو بن عثمان بن سعيد الحمصي عن الحسن بن علي بن شبيب المعمري عن الطبراني","عبد الله بن عبد الله بن أبي أمية عن أم سلمة"
"21274","نَبْهَانُ مَوْلَى أُمِّ سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  676  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ، قَالَ :  ثَنَا  نَبْهَانُ مُكَاتَبُ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : سَمِعْتُ         [23/302]      رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا كَانَ عِنْدَ الْمُكَاتَبِ مَا يُؤَدِّي ، فَاحْتَجِبِي مِنْهُ  .","","Al-Mu'jam al-Kabir 676","","هند بنت أبي أمية زوج رسول الله عن نبهان المخزومي مولى أم سلمة عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","نبهان مولى أم سلمة عن أم سلمة"
"21275","677  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  قَبِيصَةُ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  مُكَاتَبٍ لِأُمِّ سَلَمَةَ يُقَالُ لَهُ نَبْهَانُ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا وَجَدَ الْمُكَاتَبُ مَا يُؤَدِّي ، فَاحْتَجِبِي مِنْهُ  .","","Al-Mu'jam al-Kabir 677","","هند بنت أبي أمية زوج رسول الله عن نبهان المخزومي مولى أم سلمة عن محمد بن عبد الرحمن بن عبيد الطلحي عن سفيان الثوري عن قبيصة بن عقبة السوائي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","نبهان مولى أم سلمة عن أم سلمة"
"21276","678  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ، (  ح  ) .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، [ قَالَا ] :  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  يُونُسَ بْنِ يَزِيدَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  نَبْهَانَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كُنْتُ عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعِنْدَهُ  مَيْمُونَةُ  ، فَأَقْبَلَ  ابْنُ أُمِّ مَكْتُومٍ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  احْتَجِبَا مِنْهُ  ، فَقُلْنَا : يَا رَسُولَ اللهِ أَلَيْسَ بِأَعْمَى لَا يُبْصِرُنَا وَلَا يَعْرِفُنَا ؟ فَقَالَ : "" وَإِنْ أَنْتُمَا أَلَسْتُمَا تُبْصِرَانِهِ ؟  .","","Al-Mu'jam al-Kabir 678","","هند بنت أبي أمية زوج رسول الله عن نبهان المخزومي مولى أم سلمة عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن المبارك عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","نبهان مولى أم سلمة عن أم سلمة"
"21277","679  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ الْعِجْلِيُّ  ،  ثَنَا  خَلَّادُ بْنُ أَسْلَمَ ،  ثَنَا         [23/303]      النَّضْرُ بْنُ شُمَيْلٍ ،  ثَنَا  صَالِحُ بْنُ أَبِي الْأَخْضَرِ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  نَبْهَانَ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ "" يُبَاشِرُهَا وَهِيَ طَامِثٌ وَعَلَيْهَا إِزَارٌ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عبيد بن غنام النخعي )","","Al-Mu'jam al-Kabir 679","","هند بنت أبي أمية زوج رسول الله عن نبهان المخزومي مولى أم سلمة عن الزهري عن صالح بن أبي الأخضر اليمامي عن النضر بن شميل عن خلاد بن أسلم الصفار عن عبيد بن غنام النخعي عن الطبراني","نبهان مولى أم سلمة عن أم سلمة"
"21278","أَبُو كَثِيرٍ مَوْلَى أُمِّ سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  680  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ (  ح  ) .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  إِسْحَاقُ بْنُ مَنْصُورٍ ،  ثَنَا  هُرَيْمُ بْنُ سُفْيَانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنْ  أَبِي كَثِيرٍ مَوْلَى أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قُولِي عِنْدَ أَذَانِ الْمَغْرِبِ : اللَّهُمَّ عِنْدَ إِقْبَالِ لَيْلِكَ  ، وَإِدْبَارِ نَهَارِكَ ، وَأَصْوَاتِ دُعَائِكَ ، وَحُضُورِ صَلَوَاتِكَ اغْفِرْ لِي "" ، وَكَانَتْ إِذَا  تَعَارَّتْ  مِنَ اللَّيْلِ ، تَقُولُ : رَبِّ اغْفِرْ وَارْحَمْ وَاهْدِ السَّبِيلَ الْأَقْوَمَ  .","","Al-Mu'jam al-Kabir 680","","هند بنت أبي أمية زوج رسول الله عن أبو كثير مولى أم سلمة عن عبد الرحمن بن إسحاق بن سعد  الواسطي عن هريم بن سفيان البجلي عن إسحاق بن منصور السلولي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","أبو كثير مولى أم سلمة عن أم سلمة"
"21279","681  -  حَدَّثَنَا  الْحُسَيْنُ ،  ثَنَا  يَحْيَى ،  ثَنَا  ابْنُ فُضَيْلٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنْ  حُمَيْضَةَ بِنْتِ أَبِي كَثِيرٍ ،  عَنْ  أَبِيهَا أَبِي كَثِيرٍ  ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 681","","هند بنت أبي أمية زوج رسول الله عن أبو كثير مولى أم سلمة عن حفصة بنت أبي كثير المخزومية عن عبد الرحمن بن إسحاق بن سعد  الواسطي عن محمد بن فضيل بن غزوان عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","أبو كثير مولى أم سلمة عن أم سلمة"
"21280","[23/304]      عِكْرِمَةُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ  عَنْ  أُمِّ سَلَمَةَ .  682  -  حَدَّثَنَا  حَجَّاجُ بْنُ عِمْرَانَ ،  ثَنَا  يَحْيَى بْنُ خَلَفٍ ،  ثَنَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  يَحْيَى بْنِ عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ صَيْفِيٍّ ،  عَنْ  عِكْرِمَةَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَ الْحَدِيثِ الَّذِي يَتْلُوهُ .","","Al-Mu'jam al-Kabir 682","","هند بنت أبي أمية زوج رسول الله عن عكرمة بن عبد الرحمن المخزومي عن يحيى بن عبد الله بن محمد بن يحيى بن صيفي المخزومي عن ابن جريج عن أبو عاصم النبيل عن يحيى بن خلف الجوباري عن حجاج بن عمران السدوسي عن الطبراني","عكرمة بن عبد الرحمن بن الحارث عن أم سلمة"
"21281","683  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ حَمْدَانَ الْحَنَفِيُّ ،  ثَنَا  زُهَيْرُ بْنُ مُحَمَّدِ بْنِ قُمَيْرٍ ،  ثَنَا  رَوْحٌ ،  ثَنَا  ابْنُ جُرَيْجٍ ،  أَخْبَرَنِي  يَحْيَى بْنُ عَبْدِ اللهِ بْنِ شَدَّادِ بْنِ صَيْفِيٍّ ، أَنَّ عِكْرِمَةَ بْنَ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ  أَخْبَرَهُ  ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَلَفَ أَنْ لَا يَدْخُلَ عَلَى بَعْضِ أَهْلِهِ شَهْرًا ، فَلَمَّا مَضَى تِسْعٌ وَعِشْرُونَ  غَدَا عَلَيْهِنَّ ، أَوْ رَاحَ  ، فَقِيلَ : يَا رَسُولَ اللهِ إِنَّكَ حَلَفْتَ أَنْ لَا تَدْخُلَ عَلَيْهِنَّ شَهْرًا ، فَقَالَ :  إِنَّ  الشَّهْرَ  قَدْ يَكُونُ تِسْعًا وَعِشْرِينَ  .","","Al-Mu'jam al-Kabir 683","","هند بنت أبي أمية زوج رسول الله عن عكرمة بن عبد الرحمن المخزومي عن يحيى بن عبد الله بن محمد بن يحيى بن صيفي المخزومي عن ابن جريج عن روح بن عبادة القيسي عن زهير بن محمد بن قمير المروزي عن العباس بن حمدان الأصبهاني عن الطبراني","عكرمة بن عبد الرحمن بن الحارث عن أم سلمة"
"21282","684  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ السَّرَّاجُ ،  ثَنَا  الْحَسَنُ بْنُ مُكْرَمٍ ،  ثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ ،  عَنِ  ابْنِ جُرَيْجٍ ، قَالَ :  أَخْبَرَنِي  يَحْيَى بْنُ عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ صَيْفِيٍّ ، عَنْ عِكْرِمَةَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ،  أَخْبَرَهُ  ، أَنَّ أُمَّ سَلَمَةَ  أَخْبَرَتْهُ  ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَلَفَ أَنْ لَا يَدْخُلَ عَلَى بَعْضِ أَهْلِهِ شَهْرًا ، فَلَمَّا مَضَى تِسْعٌ وَعِشْرُونَ يَوْمًا غَدَا عَلَيْهِنَّ ، أَوْ رَاحَ ، فَقِيلَ لَهُ : يَا نَبِيَّ اللهِ حَلَفْتَ أَنْ لَا تَدْخُلَ شَهْرًا ، فَقَالَ :  إِنَّ  الشَّهْرَ  تِسْعٌ وَعِشْرُونَ يَوْمًا  .","","Al-Mu'jam al-Kabir 684","","هند بنت أبي أمية زوج رسول الله عن عكرمة بن عبد الرحمن المخزومي عن يحيى بن عبد الله بن محمد بن يحيى بن صيفي المخزومي عن ابن جريج عن حجاج بن محمد الأعور عن الحسن بن مكرم البغدادي عن الحسن بن علي السراج عن الطبراني","عكرمة بن عبد الرحمن بن الحارث عن أم سلمة"
"21283","[23/305]      سَفِينَةُ مَوْلَى أُمِّ سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  685  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  مُوسَى بْنِ أَبِي عَائِشَةَ ،  عَنْ  مَوْلًى لِأُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ فِي دُبُرِ الصَّلَاةِ :  اللَّهُمَّ إِنِّي أَسْأَلُكَ رِزْقًا طَيِّبًا ، وَعَمَلًا مُتَقَبَّلًا ، وَعِلْمًا نَافِعًا  .","","Al-Mu'jam al-Kabir 685","","هند بنت أبي أمية زوج رسول الله عن مولى أم سلمة عن موسى بن أبي عائشة المخزومي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سفينة مولى أم سلمة عن أم سلمة"
"21284","686  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  شُعْبَةُ  عَنْ  مُوسَى بْنِ أَبِي عَائِشَةَ ،  عَنْ  مَوْلًى لِأُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا أَصْبَحَ وَصَلَّى صَلَاةَ الصُّبْحِ  ، فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 686","","هند بنت أبي أمية زوج رسول الله عن مولى أم سلمة عن موسى بن أبي عائشة المخزومي عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفينة مولى أم سلمة عن أم سلمة"
"21285","687  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مُوسَى بْنِ أَبِي عَائِشَةَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 687","","هند بنت أبي أمية زوج رسول الله عن مولى أم سلمة عن موسى بن أبي عائشة المخزومي عن الوضاح بن عبد الله اليشكري عن سعيد بن منصور عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","سفينة مولى أم سلمة عن أم سلمة"
"21286","688  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبُو مَعْمَرٍ ،  ثَنَا  أَبُو أُسَامَةَ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  مُوسَى بْنِ أَبِي عَائِشَةَ ،  عَنْ  مَوْلًى لِأُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 688","","هند بنت أبي أمية زوج رسول الله عن مولى أم سلمة عن موسى بن أبي عائشة المخزومي عن مسعر بن كدام عن حماد بن أسامة القرشي عن إسماعيل بن إبراهيم المقعد عن عبد الله بن أحمد بن حنبل عن الطبراني","سفينة مولى أم سلمة عن أم سلمة"
"21287","689  -  حَدَّثَنَا  مَحْمُودُ بْنُ أَحْمَدَ بْنِ الْفَرَجِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ         [23/306]      عَمْرٍو ،  ثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُوسَى بْنِ أَبِي عَائِشَةَ ،  عَنْ  سَفِينَةَ مَوْلًى لِأُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 689","","هند بنت أبي أمية زوج رسول الله عن سفينة مولى رسول الله عن موسى بن أبي عائشة المخزومي عن منصور بن المعتمر عن سفيان بن عيينة عن إسماعيل بن عمرو البجلي عن محمود بن أحمد بن الفرج الأصبهاني عن الطبراني","سفينة مولى أم سلمة عن أم سلمة"
"21288","690  -  حَدَّثَنَا  أَبُو خَلِيفَةَ [  ثَنَا  ]  عَبْدُ اللهِ بْنُ عَبْدِ الْوَهَّابِ الْحَجَبِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَفِينَةَ مَوْلًى لِأُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَتْ عَامَّةُ وَصِيَّةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِنْدَ مَوْتِهِ :  الصَّلَاةَ ، وَمَا  مَلَكَتْ  أَيْمَانُكُمْ  .  سقط من طبعة مكتبة ابن تيمية ونسخة الوطنية ، والمثبت من نسخة كوبرلي .","","Al-Mu'jam al-Kabir 690","","هند بنت أبي أمية زوج رسول الله عن سفينة مولى رسول الله عن قتادة بن دعامة عن الوضاح بن عبد الله اليشكري عن عبد الله بن عبد الوهاب الحجبي عن الفضل بن الحباب الجمحي عن الطبراني","سفينة مولى أم سلمة عن أم سلمة"
"21289","691  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْخَلِيلِ ،  عَنْ  سَفِينَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 691","","هند بنت أبي أمية زوج رسول الله عن سفينة مولى رسول الله عن صالح بن أبي مريم الضبعي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن هدبة بن خالد عن الحسين بن إسحاق التستري عن الطبراني","سفينة مولى أم سلمة عن أم سلمة"
"21290","692  -  حَدَّثَنَا  الْحُسَيْنُ ،  ثَنَا  عُثْمَانُ ،  ثَنَا  ابْنُ نُمَيْرٍ ،  ثَنَا  سَعْدُ بْنُ سَعِيدٍ ،  حَدَّثَنِي  عُمَرُ بْنُ كَثِيرٍ ،  عَنْ  سَفِينَةَ مَوْلَى أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا مِنْ عَبْدٍ تُصِيبُهُ مُصِيبَةٌ فَيَقُولُ إِنَّا لِلهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ ، اللَّهُمَّ أْجُرْنِي فِي مُصِيبَتِي  ،  وَاخْلُفْ  لِي بِخَيْرٍ مِنْهَا ، إِلَّا آجَرَهُ اللهُ فِي مُصِيبَتِهِ ، وَخَلَفَ لَهُ خَيْرًا مِنْهَا "" فَلَمَّا تُوُفِّيَ  أَبُو سَلَمَةَ  ، قُلْتُ : مَنْ خَيْرٌ مِنْ  أَبِي سَلَمَةَ  صَاحِبِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ ثُمَّ عَزَمَ لِي فَقُلْتُهَا ، فَتَزَوَّجْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .","","Al-Mu'jam al-Kabir 692","","هند بنت أبي أمية زوج رسول الله عن سفينة مولى رسول الله عن عمر بن كثير بن أفلح المدني عن سعد بن سعيد بن قيس الأنصاري عن عبد الله بن نمير عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","سفينة مولى أم سلمة عن أم سلمة"
"21291","[23/307]      693  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ مُسَاوِرٍ ،  ثَنَا  خَالِدُ بْنُ خِدَاشٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنِ  ابْنِ عَبْدِ اللهِ ، قَالَ :  حَدَّثَنِي  سَفِينَةُ مَوْلَى أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ : قَالَ [ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ] :  لَا تَصْحَبُ الْمَلَائِكَةُ  عِيرًا  فِيهَا  جَرَسٌ  .","","Al-Mu'jam al-Kabir 693","","هند بنت أبي أمية زوج رسول الله عن سفينة مولى رسول الله عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن خالد المهلبي عن أحمد بن القاسم بن مساور الجوهري عن الطبراني","سفينة مولى أم سلمة عن أم سلمة"
"21292","عَبْدُ اللهِ بْنُ الْحَسَنِ  عَنْ  أُمِّ سَلَمَةَ  .  694  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الْمَوَالِ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَسَنِ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّهَا حَلَفَتْ فِي غُلَامٍ لَهَا اسْتَعْتَقَهَا ، قَالَتْ : لَا أَعْتَقَهَا اللهُ مِنَ النَّارِ إِنْ أَعْتَقَتْهُ أَبَدًا  ، ثُمَّ مَكَثَتْ مَا شَاءَ اللهُ ، فَقَالَتْ : سُبْحَانَ اللهِ سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  مَنْ  حَلَفَ  عَلَى يَمِينٍ فَرَأَى خَيْرًا مِنْهَا فَلْيُكَفِّرْ عَنْ يَمِينِهِ ، ثُمَّ لِيَفْعَلِ الَّذِي هُوَ خَيْرٌ  "" ، فَأَعْتَقَتِ الْعَبْدَ ، ثُمَّ كَفَّرَتْ عَنْ يَمِينِهَا  .","","Al-Mu'jam al-Kabir 694","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن حسن بن حسن بن علي بن أبي طالب عن عبد الرحمن بن أبي الموال مولى علي بن أبي طالب عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن الحسن عن أم سلمة"
"21293","695  -  حَدَّثَنَا  الْبُحْتُرِيُّ بْنُ مُحَمَّدٍ الْبَغْدَادِيُّ ،  ثَنَا  دَاوُدُ بْنُ عَمْرٍو الضَّبِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَسَنِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ         [23/308]      رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ لَمْ يَكُنْ فِيهِ وَاحِدَةٌ مِنْ ثَلَاثٍ فَلَا يَحْتَسِبُ بِشَيْءٍ ، تَقْوَى يَحْجِزُهُ عَنِ الْمَحَارِمِ  ، أَوْ حِلْمٌ يَكُفُّ بِهِ عَنِ السَّفِيهِ ، أَوْ  خُلُقٌ  يَعِيشُ بِهِ فِي النَّاسِ  .","","Al-Mu'jam al-Kabir 695","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن حسن بن حسن بن علي بن أبي طالب عن محمد بن مسلم بن سوسن الطائفي عن داود بن عمرو المسيبي عن البختري بن محمد اللخمي عن الطبراني","عبد الله بن الحسن عن أم سلمة"
"21294","أَبُو عُبَيْدِ اللهِ بْنُ عَبْدِ اللهِ بْنِ زَمْعَةَ  عَنْ  أُمِّ سَلَمَةَ  .  696  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدِ بْنِ عُقْبَةَ الشَّيْبَانِيُّ ،  ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ خَالِدِ بْنِ عَثْمَةَ ،  ثَنَا  مُوسَى بْنُ يَعْقُوبَ الزَّمْعِيُّ ،  عَنْ  هَاشِمِ بْنِ هَاشِمِ بْنِ عُتْبَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ وَهْبِ بْنِ زَمْعَةَ ، قَالَ :  أَخْبَرَتْنِي  أُمُّ سَلَمَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَمَعَ  فَاطِمَةَ  وَالْحَسَنَ  وَالْحُسَيْنَ  ، ثُمَّ أَدْخَلَهُمْ تَحْتَ ثَوْبِهِ ، ثُمَّ قَالَ :  اللَّهُمَّ هَؤُلَاءِ أَهْلِي  ، قَالَتْ  أُمُّ سَلَمَةَ  : قُلْتُ : يَا رَسُولَ اللهِ أَدْخِلْنِي مَعَهُمْ ، قَالَ : "" إِنَّكِ مِنْ أَهْلِي  .","","Al-Mu'jam al-Kabir 696","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن وهب بن زمعة الغنمي عن هاشم بن هاشم بن عتبة الوقاصي عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن محمد بن خالد بن عثمة الهاشمى عن الحسن بن علي الريحاني عن محمد بن محمد بن عقبة الشيباني عن الطبراني","أبو عبيد الله بن عبد الله بن زمعة عن أم سلمة"
"21295","697  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ [  ثَنَا  أَبِي ]  ،  ثَنَا  مُوسَى بْنُ يَعْقُوبَ ،  حَدَّثَنِي  هَاشِمُ بْنُ هَاشِمٍ ،  عَنْ  وَهْبِ بْنِ عَبْدِ اللهِ بْنِ زَمْعَةَ ، قَالَ :  أَخْبَرَتْنِي  أُمُّ سَلَمَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اضْطَجَعَ ذَاتَ يَوْمٍ لِلنَّوْمِ ، فَاسْتَيْقَظَ وَهُوَ  خَاثِرُ  النَّفْسِ ، فَاضْطَجَعَ فَرَقَدَ ، فَاسْتَيْقَظَ وَفِي يَدِهِ تُرْبَةٌ حَمْرَاءُ يُقَلِّبُهَا ، فَقُلْتُ : مَا هَذِهِ التُّرْبَةُ يَا رَسُولَ اللهِ ؟ قَالَ :  أَخْبَرَنِي  جِبْرِيلُ  أَنَّ هَذَا يُقْتَلُ  بِأَرْضِ الْعِرَاقِ  لِحُسَيْنٍ  ، فَقُلْتُ  لِجِبْرِيلَ  : أَرِنِي تُرْبَةَ الْأَرْضِ الَّتِي يُقْتَلُ فِيهَا ، فَهَذِهِ تُرْبَتُهَا  .  سقط من طبعة مكتبة ابن تيمية والمثبت من النسخ الخطية ، وفيه انقطاع أيضا فعبد الرحمن بن إبراهيم دحيم إنما يروى عن موسى ابن يعقوب بواسطة ، ولعله : (ابن أبي فديك) فالله أعلم .","","Al-Mu'jam al-Kabir 697","","هند بنت أبي أمية زوج رسول الله عن وهب بن عبد بن زمعة الأسدي عن هاشم بن هاشم بن عتبة الوقاصي عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","أبو عبيد الله بن عبد الله بن زمعة عن أم سلمة"
"21296","698  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْجَارُودِ النَّيْسَابُورِيُّ ،  ثَنَا  أَحْمَدُ         [23/309]      بْنُ حَفْصٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  إِبْرَاهِيمُ ،  عَنْ  عَبَّادِ بْنِ إِسْحَاقَ ،  عَنْ  هَاشِمِ بْنِ هَاشِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ وَهْبِ بْنِ زَمْعَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 698","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن وهب بن زمعة الغنمي عن هاشم بن هاشم بن عتبة الوقاصي عن عبد الرحمن بن إسحاق العامري عن إبراهيم بن طهمان عن حفص بن عبد الله بن راشد النيسابوري عن أحمد بن حفص بن عبد الله النيسابوري عن ابن الجارود عن الطبراني","أبو عبيد الله بن عبد الله بن زمعة عن أم سلمة"
"21297","699  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  ) .  وَحَدَّثَنَا  أَبُو يَحْيَى الدَّارِيُّ ( الرَّازِيُّ ) ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ، قَالَا :  ثَنَا  وَكِيعٌ ،  عَنْ  زَمْعَةَ بْنِ صَالِحٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  وَهْبِ بْنِ عَبْدِ اللهِ بْنِ زَمْعَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  خَرَجَ  أَبُو بَكْرٍ  فِي تِجَارَةٍ إِلَى  بُصْرَى  قَبْلَ مَوْتِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِعَامٍ ، وَمَعَهُ  نُعَيْمَانُ  وَسُوَيْبِطُ بْنُ حَرْمَلَةَ  ، وَكَانَا شَهِدَا  بَدْرًا  ، وَكَانَ  نُعَيْمَانُ  عَلَى الزَّادِ ، فَقَالَ لَهُ  سُوَيْبِطٌ  ، - وَكَانَ رَجُلًا مَزَّاحًا - : أَطْعِمْنِي ، قَالَ : حَتَّى يَجِيءَ صَاحِبُكَ  "" ، فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 699","","هند بنت أبي أمية زوج رسول الله عن وهب بن عبد بن زمعة الأسدي عن الزهري عن زمعة بن صالح الجندي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو عبيد الله بن عبد الله بن زمعة عن أم سلمة"
"21298","700  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ مُسَاوِرٍ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  ثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ اللهِ بْنِ زَمْعَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  طَرَقَتْنِي حَيْضَتِي وَأَنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فَانْسَلَلْتُ  ، فَقَالَ لِي :  يَا  أُمَّ سَلَمَةَ  لَعَلَّكِ  نَفِسْتِ  ، قُلْتُ : نَعَمْ ، قَالَ : "" فَارْجِعِي فَاضْطَجِعِي "" ، قَالَتْ : فَرَجَعْتُ فَاضْطَجَعْتُ ، وَمَا بَيْنِي وَبَيْنَهُ مِنَ الْإِزَارِ مَا يُجَاوِزُ الرُّكْبَتَيْنِ  .","","Al-Mu'jam al-Kabir 700","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن زمعة بن الأسود الأسدي عن محمد بن إبراهيم بن الحارث التيمي عن محمد بن إسحاق عن عباد بن العوام الكلابي عن سعيد بن سليمان سعدويه عن أحمد بن القاسم بن مساور الجوهري عن الطبراني","أبو عبيد الله بن عبد الله بن زمعة عن أم سلمة"
"21299","[23/310]      701  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ ،  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  عَنْ  مُوسَى بْنِ يَعْقُوبَ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ وَهْبِ بْنِ زَمْعَةَ ، أَنَّ أَبَاهُ  أَخْبَرَهُ  ، أَنَّ أُمَّ سَلَمَةَ  أَخْبَرَتْهُ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَدْخُلُ عَلَى أَزْوَاجِهِ غَدَاةً ، فَيُسَلِّمُ عَلَيْهِنَّ ، وَكَانَتْ مِنْهُنَّ  امْرَأَةٌ  عِنْدَهَا عَسَلٌ  ، وَكَانَ كُلَّمَا دَخَلَ عَلَيْهَا ، أَحْضَرَتْ لَهُ مِنْهُ فَمَكَثَ عِنْدَهَا كَذَلِكَ ، وَإِنَّ  عَائِشَةَ  وَحَفْصَةَ  وَجَدَا مِنْ ذَلِكَ ، فَقَالَا حِينَ دَخَلَ عَلَيْهِمَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِنَّا نَجِدُ مِنْكَ رِيحَ مَعَافِيرَ ، فَتَرَكَ ذَلِكَ الْعَسَلَ  .","","Al-Mu'jam al-Kabir 701","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن وهب بن زمعة الغنمي عن يزيد بن عبد الله بن وهب بن زمعة عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن محمد بن إسماعيل بن مسلم الديلي عن أحمد بن صالح المصري عن إسماعيل بن الحسن عن الطبراني","أبو عبيد الله بن عبد الله بن زمعة عن أم سلمة"
"21300","وَهْبُ بْنُ عَبْدِ اللهِ بْنِ زَمْعَةَ بْنِ الْأَسْوَدِ  عَنْ  أُمِّ سَلَمَةَ  .  702  -  حَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  مُوسَى بْنُ يَعْقُوبَ ،  أَخْبَرَنِي  ابْنُ أَبِي عُبَيْدَةَ  بْنِ عَبْدِ اللهِ بْنِ زَمْعَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا شَرِبْتُمْ لَبَنًا فَمَضْمِضُوا مِنْهُ ، فَإِنَّ لَهُ دَسَمًا  .  كذا في طبعة مكتبة ابن تيمية ، ولعل الصواب: (أبو عبيدة) .","","Al-Mu'jam al-Kabir 702","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن زمعة بن الأسود الأسدي عن أبو عبيدة بن عبد الله بن زمعة الأسدي عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن سعيد بن الحكم الجمحي عن عمرو بن أبي الطاهر المصري عن الطبراني","وهب بن عبد الله بن زمعة بن الأسود عن أم سلمة"
"21301","703  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  خَالِدُ بْنُ مَخْلَدٍ ،  عَنْ  مُوسَى بْنِ يَعْقُوبَ ، قَالَ :  أَخْبَرَنِي  أَبُو عُبَيْدَةَ بْنُ عَبْدِ اللهِ بْنِ         [23/311]      زَمْعَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا شَرِبْتُمُ اللَّبَنَ فَمَضْمِضُوا مِنْهُ ، فَإِنَّ لَهُ دَسَمًا  .","","Al-Mu'jam al-Kabir 703","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن زمعة بن الأسود الأسدي عن أبو عبيدة بن عبد الله بن زمعة الأسدي عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن خالد بن مخلد القطواني عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","وهب بن عبد الله بن زمعة بن الأسود عن أم سلمة"
"21302","704  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا         [23/312]      الْخَلِيلُ بْنُ مُوسَى ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ بْنِ عَبْدِ اللهِ بْنِ زَمْعَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  لَمَّا كَانَ مَسَاءُ  يَوْمِ النَّحْرِ  رَأَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَهْبَ بْنَ زَمْعَةَ  ،  وَرَجُلًا مِنْ آلِ أَبِي أُمَيَّةَ  ، وَهُمَا مُتَقَمِّصَانِ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِوَهْبٍ  :  أَفَضْتَ  يَا  أَبَا عَبْدِ اللهِ  ؟ "" ، قَالَ : لَا ، قَالَ : "" انْزِعْ قَمِيصَكَ "" ، قَالَ  وَهْبٌ  : لِمَ ذَاكَ يَا رَسُولَ اللهِ ؟ قَالَ :  إِنَّ هَذَا يَوْمٌ أُرَخِّصُ لَكُمْ فِيهِ إِذَا رَمَيْتُمْ جَمْرَةَ الْعَقَبَةِ  ، أَنْ تُحِلُّوا مِنْ كُلِّ شَيْءٍ حُرِّمَ عَلَيْكُمْ مِنْ  شَأْنِ  الْحَجِّ  إِلَّا النِّسَاءَ ، فَإِذَا أَمْسَى أَحَدُكُمْ ، وَلَمْ يُفِضْ كَانَ كَهَيْأَتِهِ حَرَامًا حَتَّى يُفِيضَ  .","","Al-Mu'jam al-Kabir 704","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن زمعة بن الأسود الأسدي عن أبو عبيدة بن عبد الله بن زمعة الأسدي عن محمد بن إسحاق عن خليل بن موسى الباهلي عن هشام بن عمار عن الحسين بن إسحاق التستري عن الطبراني","وهب بن عبد الله بن زمعة بن الأسود عن أم سلمة"
"21303","وَهْبٌ مَوْلَى أَبِي أَحْمَدَ  عَنْ  أُمِّ سَلَمَةَ  .  705  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ، (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  وَهْبٍ مَوْلَى أَبِي أَحْمَدَ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَخَلَ عَلَيْهَا ، وَهِيَ تَخْتَمِرُ ، فَقَالَ : ""  لَيَّةً  لَا  لَيَّتَيْنِ  .","","Al-Mu'jam al-Kabir 705","","هند بنت أبي أمية زوج رسول الله عن وهب مولى أبي أحمد بن جحش عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","وهب مولى أبي أحمد عن أم سلمة"
"21304","[23/313]      عَبْدُ الرَّحْمَنِ بْنُ سَعِيدِ بْنِ يَرْبُوعٍ  عَنْ  أُمِّ سَلَمَةَ  .  706  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ الْمُخَرِّمِيُّ ،  حَدَّثَنِي  عُثْمَانُ بْنُ عُمَرَ الْأَخْنَسُ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَعِيدِ بْنِ يَرْبُوعٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ لِأَزْوَاجِهِ  عَامَ حَجَّةِ الْوَدَاعِ  :  هَذِهِ الْحَجَّةُ ، ثُمَّ ظُهُورَ  الْحُصْرِ  .","","Al-Mu'jam al-Kabir 706","","هند بنت أبي أمية زوج رسول الله عن عبد الرحمن بن سعيد بن يربوع المخزومي عن عثمان بن محمد بن المغيرة الأخنسي عن عبد الله بن جعفر بن عبد الرحمن بن المسور بن مخرمة عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","عبد الرحمن بن سعيد بن يربوع عن أم سلمة"
"21305","أُمُّ سَابِطٍ  عَنْ  أُمِّ سَلَمَةَ  .  707  -  حَدَّثَنَا  الْحَضْرَمِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  مُعَاوِيَةُ ،  عَنْ  سُفْيَانَ ، وَشَيْبَانَ ،  عَنْ  جَابِرٍ ،  عَنِ  ابْنِ سَابِطٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" إِذَا أَرَادَ أَنْ يَأْكُلَ وَهُوَ  جُنُبٌ  تَوَضَّأَ وُضُوءَهُ لِلصَّلَاةِ  .","","Al-Mu'jam al-Kabir 707","","هند بنت أبي أمية زوج رسول الله عن عبد الرحمن بن سابط الجمحي عن جابر الجعفي عن شيبان بن عبد الرحمن المؤدب عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ابن سابط عن أم سلمة"
"21306","708  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  أَبُو شَيْبَةَ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  سَأَلْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى النِّسَاءِ  جِهَادٌ  ؟ قَالَ :  جِهَادُهُنَّ  هَاهُنَا "" وَأَوْمَأَ بِيَدِهِ نَحْوَ  مَكَّةَ  .","","Al-Mu'jam al-Kabir 708","","هند بنت أبي أمية زوج رسول الله عن عبد الرحمن بن سابط الجمحي عن علقمة بن مرثد الحضرمي عن إبراهيم بن عثمان أبو شيبة العبسي عن محمد بن أبان بن عمران السلمي عن عبد الله بن أحمد بن حنبل عن الطبراني","ابن سابط عن أم سلمة"
"21307","السَّائِبُ مَوْلَى أُمِّ سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  709  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ ،  ثَنَا  كَامِلُ بْنُ طَلْحَةَ ،         [23/314]      ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  دَرَّاجٍ ،  عَنِ  السَّائِبِ مَوْلَى أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  خَيْرُ صَلَاةِ النِّسَاءِ فِي قَعْرِ بُيُوتِهِنَّ  .","","Al-Mu'jam al-Kabir 709","","هند بنت أبي أمية زوج رسول الله عن السائب بن عبد الله مولى أم سلمة عن دراج أبي السمح عن عبد الله بن لهيعة عن كامل بن طلحة الجحدري عن أحمد بن عمرو بن حفص القريعي عن الطبراني","السائب مولى أم سلمة عن أم سلمة"
"21308","710  -  حَدَّثَنَا  عُمَرُ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ وَهْبٍ ،  عَنْ  عَمْرِو بْنِ الْحَارِثِ ، أَنَّ دَرَّاجًا  أَخْبَرَهُ  ،  عَنِ  السَّائِبِ  أَنَّهُ ، سَمِعَ  أُمَّ سَلَمَةَ - رَضِيَ اللهُ عَنْهَا - سَمِعَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  أَيُّمَا امْرَأَةٍ نَزَعَتْ ثِيَابَهَا فِي غَيْرِ بَيْتِهَا خَرَقَ اللهُ عَنْهَا سِتْرَهَا  .","","Al-Mu'jam al-Kabir 710","","هند بنت أبي أمية زوج رسول الله عن السائب بن عبد الله مولى أم سلمة عن دراج أبي السمح عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن عبد العزيز بن عمران المصري عن عمر بن عبد العزيز الخزاعي عن الطبراني","السائب مولى أم سلمة عن أم سلمة"
"21309","الصَّعْبُ بْنُ عَبْدِ اللهِ بْنِ أَبِي أُمَيَّةَ  عَنْ  أُمِّ سَلَمَةَ  .  711  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ،  ثَنَا  يَحْيَى بْنُ سُلَيْمِ بْنِ زَيْدٍ مَوْلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَنِ  الصَّعْبِ بْنِ عَبْدِ اللهِ بْنِ أَبِي أُمَيَّةَ ،  حَدَّثَتْنِي  أُمُّ سَلَمَةَ ، أَنَّهَا سَمِعَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَيَأْتِيَنَّ عَلَى النَّاسِ زَمَانٌ يُكَذَّبُ فِيهِ الصَّادِقُ  ، وَيُصَدَّقُ فِيهِ الْكَاذِبُ ، وَيُخَوَّنُ فِيهِ الْأَمِينُ ، وَيُؤْتَمَنُ الْخَؤُونُ ، وَيَشْهَدُ الْمَرْءُ وَلَمْ يُسْتَشْهَدْ ، وَيَحْلِفُ وَإِنْ لَمْ يُسْتَحْلَفْ ، وَيَكُونُ أَسْعَدَ النَّاسِ بِالدُّنْيَا  لُكَعُ  بْنُ  لُكَعٍ ،  لَا يُؤْمِنُ بِاللهِ وَرَسُولِهِ  .","","Al-Mu'jam al-Kabir 711","","هند بنت أبي أمية زوج رسول الله عن مصعب بن عبد الله بن أبي أمية المخزومي عن يحيى بن سليم بن زيد الهاشمي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","الصعب بن عبد الله بن أبي أمية عن أم سلمة"
"21310","قَبِيصَةُ بْنُ ذُؤَيْبٍ  عَنْ  أُمِّ سَلَمَةَ  .  712  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضْرِ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  جَعْفَرُ         [23/315]      بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ،  ثَنَا  عَبْدُ الْمَلِكِ بْنُ مَرْوَانَ الْمِصِّيصِيُّ ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  الْمُسَيِّبُ بْنُ وَاضِحٍ ، قَالُوا :  ثَنَا  أَبُو إِسْحَاقَ الْفَزَارِيُّ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  قَبِيصَةَ بْنِ ذُؤَيْبٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  دَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى  أَبِي سَلَمَةَ  وَقَدْ  شَقَّ  بَصَرُهُ ، فَأَغْمَضَ وَقَالَ :  إِنَّ الرُّوحَ إِذَا قُبِضَ تَبِعَهُ الْبَصَرُ  ، فَضَجَّ نَاسٌ مِنْ أَهْلِهِ ، فَقَالَ : "" لَا تَدْعُوا عَلَى أَنْفُسِكُمْ إِلَّا بِخَيْرٍ ، فَإِنَّ الْمَلَائِكَةَ يُؤَمِّنُونَ عَلَى مَا تَقُولُونَ "" ، - ثُمَّ قَالَ - : "" اللَّهُمَّ اغْفِرْ  لِأَبِي سَلَمَةَ  وَارْفَعْ دَرَجَتَهُ فِي الْمَهْدِيِّينَ ،  وَاخْلُفْهُ  فِي عَقِبِهِ فِي الْغَابِرِينَ ، وَاغْفِرْ لَنَا وَلَهُ يَا رَبَّ الْعَالَمِينَ ، اللَّهُمَّ  افْسَحْ  لَهُ فِي قَبْرِهِ وَنَوِّرْ لَهُ فِيهِ  .","","Al-Mu'jam al-Kabir 712","","هند بنت أبي أمية زوج رسول الله عن قبيصة بن ذؤيب الخزاعي عن أبو قلابة الجرمي عن خالد الحذاء عن أبو إسحاق الفزاري عن عبد الملك بن حبيب المصيصي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","قبيصة بن ذؤيب عن أم سلمة"
"21311","713  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عِيسَى الْوَاسِطِيُّ ،  ثَنَا  مُثَنَّى بْنُ مُعَاذٍ ،  ثَنَا  أَبِي  ،  ثَنَا  عُبَيْدُ اللهِ بْنُ الْحَسَنِ ،  عَنْ  خَالِدٍ الْخُزَاعِيِّ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  قَبِيصَةَ بْنِ ذُؤَيْبٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَغْمَضَ  أَبَا سَلَمَةَ  .","","Al-Mu'jam al-Kabir 713","","هند بنت أبي أمية زوج رسول الله عن قبيصة بن ذؤيب الخزاعي عن أبو قلابة الجرمي عن خالد الحذاء عن عبيد الله بن الحسن بن الحصين العنبري عن معاذ بن معاذ بن نصر عن المثنى بن معاذ بن معاذ العنبري عن محمد بن عيسى ابن أبي قماش عن الطبراني","قبيصة بن ذؤيب عن أم سلمة"
"21312","714  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ ،  ثَنَا  كَثِيرُ بْنُ يَحْيَى ،  عَنْ  مَخْلَدِ بْنِ هِلَالٍ ،  حَدَّثَنِي  خَالِدٌ الْحَذَّاءُ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  قَبِيصَةَ بْنِ ذُؤَيْبٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَخَلَ عَلَى  أَبِي سَلَمَةَ  فَذَكَرَ نَحْوَ حَدِيثِ  الْفَزَارِيِّ  .","","Al-Mu'jam al-Kabir 714","","هند بنت أبي أمية زوج رسول الله عن قبيصة بن ذؤيب الخزاعي عن أبو قلابة الجرمي عن خالد الحذاء عن محمد بن هلال بن أبي هلال المذحجي عن كثير بن يحيى بن كثير الشيعي عن إبراهيم بن هاشم البغوي عن الطبراني","قبيصة بن ذؤيب عن أم سلمة"
"21313","أَبُو سُفْيَانَ  عَنْ  أُمِّ سَلَمَةَ  .  715  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ ،  ثَنَا  بِشْرُ بْنُ عُبَيْسٍ ،  حَدَّثَنِي  النَّضْرُ بْنُ عَرَبِيٍّ ،  عَنْ  خَارِجَةَ بْنِ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي سُفْيَانَ ،         [23/316]      عَنْ  أَبِيهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ فِي السَّمَاءِ مَلَكَيْنِ أَحَدُهُمَا يَأْمُرُ بِالشِّدَّةِ وَالْآخَرُ يَأْمُرُ بِاللِّينِ  وَكُلٌّ مُصِيبٌ  جِبْرِيلُ  وَمِيكَائِيلُ  ، وَنَبِيَّانِ أَحَدُهُمَا يَأْمُرُ بِاللِّينِ وَالْآخَرُ يَأْمُرُ بِالشِّدَّةِ وَكُلٌّ مُصِيبٌ ، وَذَكَرَ  إِبْرَاهِيمَ  وَنُوحًا  ، وَلِي صَاحِبَانِ أَحَدُهُمَا يَأْمُرُ بِاللِّينِ وَالْآخَرُ بِالشِّدَّةِ وَكُلٌّ مُصِيبٌ ، وَذَكَرَ  أَبَا بَكْرٍ  وَعُمَرَ  .","","Al-Mu'jam al-Kabir 715","","هند بنت أبي أمية زوج رسول الله عن أبو سفيان الأشهلى عن عبد الله بن أبي سفيان الحجازي عن خارجة بن عبد الله النجاري عن النضر بن عربي الباهلي عن بشر بن عبيس بن مرحوم العطار عن محمد بن علي بن زيد الصائغ عن الطبراني","أبو سفيان عن أم سلمة"
"21314","مُسْلِمُ بْنُ سُلَيْمٍ  عَنْ  أُمِّ سَلَمَةَ  .  716  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ،  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  إِسْحَاقَ بْنِ أَبِي فَرْوَةَ ، أَنَّ مُسْلِمَ بْنَ سُلَيْمٍ  حَدَّثَهُ  ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ شَاةً لَهُمْ مَاتَتْ ، فَلَمْ يُدْرِكُوا ذَكَاتَهَا حَتَّى مَاتَتْ ، فَبَلَغَ ذَلِكَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  لَوِ انْتَفَعْتُمْ بِإِهَابِهَا  .","","Al-Mu'jam al-Kabir 716","","هند بنت أبي أمية زوج رسول الله عن سليم بن مسلم الخشاب عن إسحاق بن أبي فروة عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","مسلم بن سليم عن أم سلمة"
"21315","عَاصِمُ بْنُ أَبِي عُبَيْدٍ  عَنْ  أُمِّ سَلَمَةَ  .  717  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ الزُّبَيْرِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي حَازِمٍ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  عَاصِمِ بْنِ أَبِي عُبَيْدَةَ  ،  عَنْ  أُمِّ سَلَمَةَ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ  كَانَ يَدْعُو بِهَؤُلَاءِ الْكَلِمَاتِ :  اللَّهُمَّ أَنْتَ الْأَوَّلُ لَا شَيْءَ قَبْلَكَ ، وَأَنْتَ الْآخِرُ لَا شَيْءَ بَعْدَكَ  ، أَعُوذُ بِكَ مِنْ كُلِّ دَابَّةٍ نَاصِيَتُهَا بِيَدِكَ ، وَأَعُوذُ بِكَ مِنَ الْإِثْمِ وَالْكَسَلِ وَمَنْ عَذَابِ النَّارِ وَمَنْ عَذَابِ الْقَبْرِ وَمَنْ فِتْنَةِ         [23/317]      الْغِنَى وَفِتْنَةِ الْفَقْرِ ، وَأَعُوذُ بِكَ مِنَ  الْمَأْثَمِ  وَالْمَغْرَمِ ،  اللَّهُمَّ نَقِّ قَلْبِي مِنَ الْخَطَايَا كَمَا نَقَّيْتَ الثَّوْبَ الْأَبْيَضَ مِنَ الدَّنَسِ ، اللَّهُمَّ بَعِّدْ بَيْنِي وَبَيْنَ خَطِيئَتِي كَمَا بَعَّدْتَ بَيْنَ الْمَشْرِقِ وَالْمَغْرِبِ ، هَذَا مَا سَأَلَ  مُحَمَّدٌ  رَبَّهُ ، اللَّهُمَّ إِنِّي أَسْأَلُكَ خَيْرَ الْمَسْأَلَةِ وَخَيْرَ الدُّعَاءِ وَخَيْرَ النَّجَاحِ وَخَيْرَ الْعَمَلِ وَخَيْرَ الثَّوَابِ وَخَيْرَ الْحَيَاةِ وَخَيْرَ الْمَمَاتِ وَثَبِّتْنِي وَثَقِّلْ مَوَازِينِي وَأَحِقَّ إِيمَانِي وَارْفَعْ دَرَجَتِي وَتَقَبَّلْ صَلَاتِي وَاغْفِرْ خَطِيئَتِي ، وَأَسْأَلُكَ الدَّرَجَاتِ الْعُلَى مِنَ الْجَنَّةِ آمِينَ ، اللَّهُمَّ إِنِّي أَسْأَلُكَ فَوَاتِحَ الْخَيْرِ وَخَوَاتِمَهُ وَجَوَامِعَهُ وَأَوَّلَهُ وَآخِرَهُ وَظَاهِرَهُ وَبَاطِنَهُ ، وَالدَّرَجَاتِ الْعُلَى مِنَ الْجَنَّةِ آمِينَ ، اللَّهُمَّ وَنَجِّنِي مِنَ النَّارِ ، وَمَغْفِرَةَ اللَّيْلِ وَالنَّهَارِ ، وَالْمَنْزِلَ الصَّالِحَ مِنَ الْجَنَّةِ آمِينَ ، اللَّهُمَّ إِنِّي أَسْأَلُكَ  خَلَاصًا  مِنَ النَّارِ سَالِمًا ، وَأَدْخِلْنِي الْجَنَّةَ آمِنًا ، اللَّهُمَّ إِنِّي أَسْأَلُكَ أَنْ تُبَارِكَ لِي فِي نَفْسِي وَفِي سَمْعِي وَفِي بَصَرِي وَفِي رُوحِي وَفِي  خُلُقِي  وَفِي خَلِيقَتِي وَأَهْلِي وَفِي مَحْيَايَ وَفِي مَمَاتِي ، اللَّهُمَّ وَتَقَبَّلْ حَسَنَاتِي ، وَأَسْأَلُكَ الدَّرَجَاتِ الْعُلَى مِنَ الْجَنَّةِ آمِينَ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عاصم بن أبى عبيد )","","Al-Mu'jam al-Kabir 717","","هند بنت أبي أمية زوج رسول الله عن عاصم بن أبي عبيد عن موسى بن عقبة عن سهيل بن أبي صالح السمان عن عبد العزيز بن أبي حازم المخزومي عن مصعب بن عبد الله بن مصعب الزبيري عن عبد الله بن أحمد بن حنبل عن الطبراني","عاصم بن أبي عبيد عن أم سلمة"
"21316","718  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ جَعْفَرٍ الْقَتَّاتُ الْكُوفِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ مُحَمَّدٍ الطَّلْحِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  عَنْ  عُثْمَانَ بْنِ طَلْحَةَ ،  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ  ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّهَا قَالَتْ يَوْمَ مَاتَتْ  عَائِشَةُ  :  الْيَوْمَ مَاتَ أَحَبُّ  شَخْصٍ  كَانَ فِي الدُّنْيَا إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - "" ، ثُمَّ قَالَتْ : "" أَسْتَغْفِرُ اللهَ مَا خَلَا أَبَاهَا  "" .","","Al-Mu'jam al-Kabir 718","","هند بنت أبي أمية زوج رسول الله عن أبيه عن أبو عبد الرحمن عن عثمان بن طلحة عن يعقوب بن محمد بن عيسى عن إسماعيل بن محمد بن إسماعيل الطلحي عن الحسين بن جعفر القتات عن الطبراني","عاصم بن أبي عبيد عن أم سلمة"
"21317","وَمَنْ رَوَى عَنْ  أُمِّ سَلَمَةَ  مِنْ  أَهْلِ الْكُوفَةِ  .  مَسْرُوقُ بْنُ الْأَجْدَعِ  عَنْ  أُمِّ سَلَمَةَ  .  719  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  شَرِيكٌ ،  عَنْ         [23/318]      عَاصِمٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  مِنْ أَصْحَابِي مَنْ لَا يَرَانِي بَعْدَ أَنْ أَمُوتَ أَبَدًا  ، فَجَاءَ  عُمَرُ  فَدَخَلَ عَلَيْهَا فَقَالَ :  أَنْشُدُكِ  اللهَ أَنَا مِنْهُمْ ؟ قَالَتْ : لَا وَلَا  أُزَكِّي  أَحَدًا بَعْدَكَ أَبَدًا  ، فَبَكَى  عُمَرُ  - رَضِيَ اللهُ عَنْهُ  - .","","Al-Mu'jam al-Kabir 719","","هند بنت أبي أمية زوج رسول الله عن مسروق بن الأجدع عن شقيق بن سلمة عن عاصم بن بهدلة عن شريك بن عبد الله النخعي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مسروق بن الأجدع عن أم سلمة"
"21318","720  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ ،  ثَنَا  غَنْمُ بْنُ مُحَمَّدِ بْنِ سَعِيدٍ الْبَصْرِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ الدَّشْتَكِيُّ ،  ثَنَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 720","","هند بنت أبي أمية زوج رسول الله عن مسروق بن الأجدع عن شقيق بن سلمة عن عاصم بن بهدلة عن عمرو بن أبي قيس عن عبد الرحمن بن عبد الله الدشتكي عن عثمان بن محمد بن سعيد الدشتكي عن عبد الله بن أحمد بن حنبل عن الطبراني","مسروق بن الأجدع عن أم سلمة"
"21319","721  -  حَدَّثَنَا  عَلَّانُ بْنُ عَبْدِ الصَّمَدِ ،  ثَنَا  الْقَاسِمُ بْنُ دِينَارٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  عَاصِمٍ ،  عَنْ  شَقِيقٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 721","","هند بنت أبي أمية زوج رسول الله عن مسروق بن الأجدع عن شقيق بن سلمة عن عاصم بن بهدلة عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن القاسم بن زكريا الطحان عن علي بن عبد الصمد علان ماغمه عن الطبراني","مسروق بن الأجدع عن أم سلمة"
"21320","أَبُو وَائِلٍ شَقِيقُ بْنُ سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  722  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا حَضَرْتُمُ الْمَيِّتَ ، فَقُولُوا خَيْرًا  ، فَإِنَّ الْمَلَائِكَةَ يُؤَمِّنُونَ عَلَى مَا تَقُولُونَ  .","","Al-Mu'jam al-Kabir 722","","هند بنت أبي أمية زوج رسول الله عن شقيق بن سلمة عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","أبو وائل شقيق بن سلمة عن أم سلمة"
"21321","723  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا         [23/319]      شَرِيكٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا أُصِيبَ أَحَدُكُمْ بِمُصِيبَةٍ ، فَلْيَقُلِ : اللَّهُمَّ أْجُرْنِي فِي مُصِيبَتِي وَأَعْقِبْنِي خَيْرًا بِهَا  ، فَلَمَّا مَاتَ  أَبُو سَلَمَةَ  ، فَقُلْتُ : مَنْ يَعْقُبُنِي اللهُ بَعْدَ  أَبِي سَلَمَةَ  ، قَالَتْ : فَأَعْقَبَنِي اللهُ خَيْرًا مِنْهُ  مُحَمَّدًا  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .","","Al-Mu'jam al-Kabir 723","","هند بنت أبي أمية زوج رسول الله عن شقيق بن سلمة عن الأعمش عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","أبو وائل شقيق بن سلمة عن أم سلمة"
"21322","724  -  حَدَّثَنَا  الْحُسَيْنُ ،  ثَنَا  يَحْيَى ،  ثَنَا  أَبُو مُعَاوِيَةَ ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ ،  ثَنَا  عُثْمَانُ ،  ثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ مِنْ أَصْحَابِي مَنْ لَنْ يَرَانِي بَعْدَ أَنْ أُفَارِقَهُ  .","","Al-Mu'jam al-Kabir 724","","هند بنت أبي أمية زوج رسول الله عن شقيق بن سلمة عن الأعمش عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","أبو وائل شقيق بن سلمة عن أم سلمة"
"21323","725  -  حَدَّثَنَا  مُحَمَّدُ بْنُ حُسَيْنٍ الْحَنَّاطُ ، قَالَ :  ثَنَا  عَلِيُّ بْنُ حَرْبٍ الْمَوْصِلِيُّ ،  ثَنَا  ابْنُ فُضَيْلٍ ،  عَنْ  أَبِي إِسْحَاقَ الشَّيْبَانِيِّ ،  عَنْ  وَاصِلٍ ،  عَنْ  أَبِي وَائِلٍ ، قَالَ :  قَالَتْ  أُمُّ سَلَمَةَ لَمَّا مَاتَ  أَبُو سَلَمَةَ  ، قُلْتُ : يَا رَسُولَ اللهِ كَيْفَ أَقُولُ ؟ قَالَ :  قُولِي اللَّهُمَّ اغْفِرْ لَهُ وَأَعْقِبْنِي مِنْهُ عُقْبَى نَافِعَةً  ، فَقُلْتُهَا ، فَأَعْقَبَنِي رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .","","Al-Mu'jam al-Kabir 725","","هند بنت أبي أمية زوج رسول الله عن شقيق بن سلمة عن واصل بن حيان الأحدب عن سليمان بن فيروز الشيباني عن محمد بن فضيل بن غزوان عن علي بن حرب الطائي عن محمد بن حسين الحناط عن الطبراني","أبو وائل شقيق بن سلمة عن أم سلمة"
"21324","[23/320]      عَامِرُ بْنُ شَرَاحِيلَ الشَّعْبِيُّ  عَنْ  أُمِّ سَلَمَةَ .  726  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  مَا خَرَجَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ بَيْتِي صَبَاحًا إِلَّا رَفَعَ بَصَرَهُ إِلَى السَّمَاءِ وَقَالَ :  اللَّهُمَّ إِنِّي أَعُوذُ بِكَ أَنْ أَضِلَّ أَوْ أُضَلَّ  ، أَوْ أَذِلَّ أَوْ أُذَلَّ ، أَوْ أَظْلِمَ أَوْ أُظْلَمَ ، أَوْ أَجْهَلَ أَوْ يُجْهَلَ عَلَيَّ  .","","Al-Mu'jam al-Kabir 726","","هند بنت أبي أمية زوج رسول الله عن الشعبي عن منصور بن المعتمر عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عامر بن شراحيل الشعبي عن أم سلمة"
"21325","727  -  حَدَّثَنَا  عَلِيٌّ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَ حَدِيثِ  شُعْبَةَ  .","","Al-Mu'jam al-Kabir 727","","هند بنت أبي أمية زوج رسول الله عن الشعبي عن منصور بن المعتمر عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عامر بن شراحيل الشعبي عن أم سلمة"
"21326","728  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  إِدْرِيسَ الْأَوْدِيِّ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 728","","هند بنت أبي أمية زوج رسول الله عن الشعبي عن منصور بن المعتمر عن إدريس بن يزيد الزعافري عن موسى بن أعين الجزري عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","عامر بن شراحيل الشعبي عن أم سلمة"
"21327","729  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَلِيِّ بْنِ الْجَارُودِ ،  ثَنَا  أَحْمَدُ بْنُ الْحَكَمِ بْنِ ظِبْيَانَ الْبَصْرِيُّ ،  ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  زَيْدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 729","","هند بنت أبي أمية زوج رسول الله عن الشعبي عن زيد بن أسلم عن سفيان الثوري عن موسى بن مسعود النهدي عن أحمد بن الحكم بن ظبيان البصري عن الجارودي أحمد بن علي الأصبهاني عن الطبراني","عامر بن شراحيل الشعبي عن أم سلمة"
"21328","730  -  حَدَّثَنَا  خَطَّابُ بْنُ سَعْدٍ الدِّمَشْقِيُّ ،  ثَنَا  حُمَيْدُ بْنُ عَيَّاشٍ ،  ثَنَا  مُؤَمَّلٌ ،  ثَنَا  شُعْبَةُ ،  عَنْ  مَنْصُورٍ ، وَعَاصِمٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .         [23/321]","","Al-Mu'jam al-Kabir 730","","هند بنت أبي أمية زوج رسول الله عن الشعبي عن عاصم بن سليمان الأحول عن شعبة بن الحجاج عن مؤمل بن إسماعيل العدوي عن حميد بن عياش المكتب عن خطاب بن سعد الخير الحمصي عن الطبراني","عامر بن شراحيل الشعبي عن أم سلمة"
"21329","731  -  حَدَّثَنَا  الْمَعْمَرِيُّ ،  ثَنَا  عُقْبَةُ ،  ثَنَا  شُعَيْبُ بْنُ إِسْحَاقَ ،  عَنْ  مَعْمَرٍ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِمِثْلِهِ .","","Al-Mu'jam al-Kabir 731","","هند بنت أبي أمية زوج رسول الله عن الشعبي عن منصور بن المعتمر عن معمر بن راشد عن شعيب بن إسحاق الدمشقي عن عقبة بن مكرم بن عقبة الكوفي عن الحسن بن علي بن شبيب المعمري عن الطبراني","عامر بن شراحيل الشعبي عن أم سلمة"
"21330","732  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبِيدَةُ بْنُ حُمَيْدٍ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 732","","هند بنت أبي أمية زوج رسول الله عن الشعبي عن منصور بن المعتمر عن عبيدة بن حميد بن صهيب التيمي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عامر بن شراحيل الشعبي عن أم سلمة"
"21331","كُلْثُومٌ الْخُزَاعِيُّ  عَنْ  أُمِّ سَلَمَةَ  .  733  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  جَامِعِ بْنِ شَدَّادٍ ،  عَنْ  كُلْثُومٍ الْخُزَاعِيِّ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّهَا كَانَتْ تُفَلِّي رَأْسَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَاءَتْ  زَيْنَبُ امْرَأَةُ عَبْدِ اللهِ بْنِ مَسْعُودٍ  فَجَعَلَتْ تُكَلِّمُنِي وَأُكَلِّمُهَا وَرَفَعْتُ بَصَرِي إِلَيْهَا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَقْبِلِي عَلَى فِلَايَتِكِ ، فَإِنَّكِ لَسْتِ تُكَلِّمِينَهَا بِعَيْنَيْكِ  ، قَالَتْ  زَيْنَبُ  : فَجَعَلْتُ أَشْكُو ضِيقَ الْمَسْكَنِ ، فَقَالَ : هَذَا كَمَا صَنَعَتِ  امْرَأَةُ عُثْمَانَ بْنِ مَظْعُونٍ  ، لَمْ يَسَعُهَا مَا نَزَلَتْ حَتَّى نَزَلَ عَلَى رَأْسِهَا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" كَذَاكَ مَنِ اخْتَطَّ  خُطَّةً  بِالْمَدِينَةِ  مِنَ الْمُهَاجِرَاتِ ، فَلَهَا خُطَّتُهَا ، فَوَرِثَتْ نَصِيبَهَا مِنْ دَارِ  عَبْدِ اللهِ  ، وَأَحْرَزَتْ دَارَهَا  بِالْمَدِينَةِ  .","","Al-Mu'jam al-Kabir 733","","هند بنت أبي أمية زوج رسول الله عن كلثوم بن المصطلق الخزاعي عن جامع بن شداد عن قيس بن الربيع الأسدي عن عاصم بن علي الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","كلثوم الخزاعي عن أم سلمة"
"21332","الْمُهَاجِرُ بْنُ الْقِبْطِيَّةِ  عَنْ  أُمِّ سَلَمَةَ  .  734  -  حَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  أَبُو الْوَلِيدِ ،  حَدَّثَنَا  زُهَيْرٌ ،  عَنْ         [23/322]      عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ ،  عَنِ  الْمُهَاجِرِ ابْنِ الْقِبْطِيَّةِ ،  قَالَ  : دَخَلْنَا عَلَى أُمِّ سَلَمَةَ ، فَقَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَعُوذُ عَائِذٌ بِالْبَيْتِ ، فَيُبْعَثُ إِلَيْهِ بَعْثٌ حَتَّى إِذَا كَانُوا  بِبَيْدَاءَ  مِنَ الْأَرْضِ خُسِفَتْ بِهِمْ  ، قُلْتُ : يَا نَبِيَّ اللهِ مَنْ كَانَ كَارِهًا ؟ قَالَ : "" يُخْسَفُ بِهِ مَعَهُمْ ، وَلَكِنَّهُ يُبْعَثُ يَوْمَ الْقِيَامَةِ عَلَى مَا كَانَ فِي نَفْسِهِ  .","","Al-Mu'jam al-Kabir 734","","هند بنت أبي أمية زوج رسول الله عن عبيد الله بن القبطية اللخمي عن عبد العزيز بن رفيع الطائفي عن زهير بن معاوية بن حديج عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","المهاجر بن القبطية عن أم سلمة"
"21333","735  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُعَلَّى بْنُ أَسَدٍ الْعَمِّيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ الْمُخْتَارِ ،  ثَنَا  أَبُو يُونُسَ الْقُشَيْرِيُّ ،  عَنِ  الْمُهَاجِرِ ابْنِ الْقِبْطِيَّةِ ، قَالَ :  سَمِعْتُ  أُمَّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 735","","هند بنت أبي أمية زوج رسول الله عن ابن القبطية ، مهاجر المكي عن حاتم بن أبي صغيرة القشيري عن عبد العزيز بن المختار الدباغ عن معلى بن أسد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","المهاجر بن القبطية عن أم سلمة"
"21334","736  -  حَدَّثَنَا  حُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  شُعْبَةَ ،  عَنْ  أَبِي يُونُسَ الْبَاهِلِيِّ ،  عَنِ  الْمُهَاجِرِ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 736","","هند بنت أبي أمية زوج رسول الله عن ابن القبطية ، مهاجر المكي عن حاتم بن أبي صغيرة القشيري عن شعبة بن الحجاج عن وكيع بن الجراح عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","المهاجر بن القبطية عن أم سلمة"
"21335","أَبُو عَبْدِ اللهِ الْجَدَلِيُّ  عَنْ  أُمِّ سَلَمَةَ  .  737  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  فِطْرُ بْنُ خَلِيفَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عَبْدِ اللهِ الْجَدَلِيِّ ، قَالَ :  قَالَتْ  أُمُّ         [23/323]      سَلَمَةَ : يَا  أَبَا عَبْدِ اللهِ  أَيُسَبُّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِيكُمْ  ؟ قُلْتُ : وَمَنْ  يَسُبُّ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَتْ : "" أَلَيْسَ  يُسَبُّ  عَلِيٌّ  وَمَنْ يُحِبُّهُ ، وَقَدْ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُحِبُّهُ .  ؟","","Al-Mu'jam al-Kabir 737","","هند بنت أبي أمية زوج رسول الله عن عبد بن عبد الجدلي عن أبو إسحاق السبيعي عن فطر بن خليفة عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو عبد الله الجدلي عن أم سلمة"
"21336","738  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  عَوْنُ بْنُ سَلَامَةَ ، (  ح  ) .  وَحَدَّثَنَا  الْقَتَّاتُ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ صَالِحٍ ، قَالَا :  ثَنَا  عِيسَى بْنُ عَبْدِ الرَّحْمَنِ ،  عَنِ  السُّدِّيِّ ،  عَنْ  أَبِي عَبْدِ اللهِ الْجَدَلِيِّ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 738","","هند بنت أبي أمية زوج رسول الله عن عبد بن عبد الجدلي عن السدي الكبير عن عيسى بن عبد الرحمن السلمي عن عون بن سلامة عن محمد بن عثمان بن أبي شيبة عن الطبراني","أبو عبد الله الجدلي عن أم سلمة"
"21337","739  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ بْنِ مُكْرَمٍ ،  ثَنَا  مُحَمَّدُ بْنُ يَزِيدَ الْأَدْمِيُّ ،  ثَنَا  يَحْيَى بْنُ يَعْلَى الْأَسْلَمِيُّ ،  عَنْ  سَعْدٍ الْإِسْكَافِ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِي عَبْدِ اللهِ الْجَدَلِيِّ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنِّي أُبْغِضُ الْمَرْأَةَ تَخْرُجُ مِنْ بَيْتِهَا تَجُرُّ ذَيْلَهَا تَشْكُو زَوْجَهَا  .","","Al-Mu'jam al-Kabir 739","","هند بنت أبي أمية زوج رسول الله عن عبد بن عبد الجدلي عن سلمة بن كهيل الحضرمي عن عبد الملك بن أبي سليمان العرزمي عن سعد بن طريف الإسكاف عن يحيى بن يعلى القطواني عن محمد بن يزيد بن محمد بن كثير الرفاعي عن محمد بن الحسين بن مكرم البارع عن الطبراني","أبو عبد الله الجدلي عن أم سلمة"
"21338","يَحْيَى بْنُ الْجَزَّارِ  عَنْ  أُمِّ سَلَمَةَ  .  740  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  يَحْيَى بْنِ الْجَزَّارِ ،  قَالَ  :  دَخَلَ نَاسٌ مِنْ أَصْحَابِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى أُمِّ سَلَمَةَ ، فَقَالُوا : يَا أُمَّ الْمُؤْمِنِينَ حَدِّثِينَا عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ :  كَانَتْ عَلَانِيَتُهُ         [23/324]      وَسِرُّهُ سَوَاءً ثُمَّ نَدِمَتْ  ، فَقَالَتْ : أَفْشَيْتُ سِرَّ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا دَخَلَ أَخْبَرْتُهُ ، فَقَالَ : "" أَحْسَنْتِ  .","","Al-Mu'jam al-Kabir 740","","هند بنت أبي أمية زوج رسول الله عن يحيى بن الجزار العرني عن عمرو بن مرة المرادي عن الأعمش عن محمد بن عبيد بن أبي أمية عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","يحيى بن الجزار عن أم سلمة"
"21339","741  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  أَبُو مُعَاوِيَةَ ،  ثَنَا  الْأَعْمَشُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  يَحْيَى بْنِ الْجَزَّارِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" يُوتِرُ بِثَلَاثَ عَشْرَةَ ، فَلَمَّا كَبِرَ وَضَعُفَ أَوْتَرَ بِسَبْعٍ  .","","Al-Mu'jam al-Kabir 741","","هند بنت أبي أمية زوج رسول الله عن يحيى بن الجزار العرني عن عمرو بن مرة المرادي عن الأعمش عن أبو معاوية الضرير عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","يحيى بن الجزار عن أم سلمة"
"21340","أَبُو صَالِحٍ مَوْلَى طَلْحَةَ بْنِ عُبَيْدِ اللهِ  عَنْ  أُمِّ سَلَمَةَ  .  742  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  مَيْمُونٍ أَبِي حَمْزَةَ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَأَى  غُلَامًا  لَهَا يُصَلِّي ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَرِّبْ وَجْهَكَ يَا  رَبَاحُ  .","","Al-Mu'jam al-Kabir 742","","هند بنت أبي أمية زوج رسول الله عن أبو صالح مولى طلحة بن عبيد الله عن ميمون القصاب عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو صالح مولى طلحة بن عبيد الله عن أم سلمة"
"21341","743  -  حَدَّثَنَا  عَلِيٌّ ،  ثَنَا  عَمْرُو بْنُ عَوْنٍ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي حَمْزَةَ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .         [23/325]","","Al-Mu'jam al-Kabir 743","","هند بنت أبي أمية زوج رسول الله عن أبو صالح مولى طلحة بن عبيد الله عن ميمون القصاب عن سلام بن سليم الحنفي عن عمرو بن عون الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو صالح مولى طلحة بن عبيد الله عن أم سلمة"
"21342","744  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  قَيْسٌ ،  عَنْ  أَبِي حَمْزَةَ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 744","","هند بنت أبي أمية زوج رسول الله عن أبو صالح مولى طلحة بن عبيد الله عن ميمون القصاب عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","أبو صالح مولى طلحة بن عبيد الله عن أم سلمة"
"21343","745  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  أَبُو هَمَّامٍ ،  عَنْ  هُدْبَةَ بْنِ الْمِنْهَالِ ،  عَنْ  مَيْمُونٍ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 745","","هند بنت أبي أمية زوج رسول الله عن أبو صالح مولى طلحة بن عبيد الله عن ميمون القصاب عن هدبة بن المنهال الأهوازي عن محمد بن الزبرقان الأهوازي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","أبو صالح مولى طلحة بن عبيد الله عن أم سلمة"
"21344","الْمَعْرُورُ بْنُ سُوَيْدٍ  عَنْ  أُمِّ سَلَمَةَ  .  746  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْحَسَنُ بْنُ الرَّبِيعِ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  لَيْثٍ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنِ  الْمَعْرُورِ بْنِ سُوَيْدٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا مَسَخَ اللهُ مِنْ شَيْءٍ ، فَكَانَ لَهُ عَقِبٌ وَلَا نَسْلٌ  .","","Al-Mu'jam al-Kabir 746","","هند بنت أبي أمية زوج رسول الله عن معرور بن سويد الأسدي عن علقمة بن مرثد الحضرمي عن ليث بن أبي سليم عن عبد الله بن إدريس الأودي عن الحسن بن الربيع البوراني عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","المعرور بن سويد عن أم سلمة"
"21345","747  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الْمَوْصِلِيُّ ،  ثَنَا  خَلَفُ بْنُ خَلِيفَةَ ، (  ح  ) .         [23/326]      وَحَدَّثَنَا  حُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  خَلَفُ بْنُ خَلِيفَةَ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ ،  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  خَلَفُ بْنُ خَلِيفَةَ ،  عَنْ  لَيْثٍ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنِ  الْمَعْرُورِ بْنِ سُوَيْدٍ ، قَالَ :  سَمِعْتُ  أُمَّ سَلَمَةَ ، تَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا ظَهَرَتِ الْمَعَاصِي فِي أُمَّتِي عَمَّهُمُ اللهُ بِعَذَابٍ  ، قُلْتُ : يَا رَسُولَ اللهِ أَمَا فِي النَّاسِ يَوْمَئِذٍ نَاسٌ صَالِحُونَ ، قَالَ : "" بَلَى "" ، قُلْتُ : فَكَيْفَ يَصْنَعُ أُولَئِكَ ؟ قَالَ : "" يُصِيبُهُمْ مَا أَصَابَ النَّاسَ ثُمَّ يَصِيرُونَ إِلَى مَغْفِرَةٍ مِنَ اللهِ وَرِضْوَانٍ  ،  ""  لَفْظُ حَدِيثِ  أَبِي الرَّبِيعِ  "" .","","Al-Mu'jam al-Kabir 747","","هند بنت أبي أمية زوج رسول الله عن معرور بن سويد الأسدي عن علقمة بن مرثد الحضرمي عن ليث بن أبي سليم عن خلف بن خليفة الأشجعي عن سليمان بن داود العتكي عن الحسين بن إسحاق التستري عن الطبراني","المعرور بن سويد عن أم سلمة"
"21346","إِنْسَانٌ عَنْ  أُمِّ سَلَمَةَ  .  748  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو غَسَّانَ ،  ثَنَا  كَامِلٌ أَبُو الْعَلَاءِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  إِنْسَانٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" إِذَا أَطَّلَى بَدَأَ بِعَانَتِهِ ، فَهُوَ الَّذِي يَلِيهَا  .","","Al-Mu'jam al-Kabir 748","","هند بنت أبي أمية زوج رسول الله عن إنسان عن حبيب بن أبي ثابت الكاهلي عن كامل بن العلاء التميمي عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","إنسان عن أم سلمة"
"21347","حَسَّانُ بْنُ الْمُخَارِقِ  عَنْ  أُمِّ سَلَمَةَ  .  749  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ ،  ثَنَا  جَرِيرٌ ،  عَنِ         [23/327]      الشَّيْبَانِيِّ ،  عَنْ  حَسَّانَ الْمُخَارِقِ ، قَالَ :  قَالَتْ  أُمُّ سَلَمَةَ :  اشْتَكَتِ ابْنَةٌ لِي فَنَبَذْتُ لَهَا فِي كُوزٍ لَهَا ، فَدَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَغْلِي ، فَقَالَ : "" مَا هَذَا ؟ "" ، فَقُلْتُ : إِنَّ ابْنَتِي اشْتَكَتْ فَنَبَذْتُ لَهَا هَذَا ، فَقَالَ :  إِنَّ اللهَ لَمْ يَجْعَلْ شِفَاءَكُمْ فِيمَا حَرَّمَ عَلَيْكُمْ  .","","Al-Mu'jam al-Kabir 749","","هند بنت أبي أمية زوج رسول الله عن حسان بن مخارق الكوفي عن سليمان بن فيروز الشيباني عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","حسان بن المخارق عن أم سلمة"
"21348","حَكِيمُ بْنُ سَعْدٍ  عَنْ  أُمِّ سَلَمَةَ  .  750  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ ،  ثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  جَعْفَرِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  حَكِيمِ بْنِ سَعْدٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ  هَذِهِ الْآيَةُ :         {      إِنَّمَا يُرِيدُ اللهُ لِيُذْهِبَ عَنْكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا         }      فِي رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَعَلِيٍّ  وَفَاطِمَةَ  وَالْحَسَنِ  وَالْحُسَيْنِ  .","","Al-Mu'jam al-Kabir 750","","هند بنت أبي أمية زوج رسول الله عن حكيم بن سعد الحنفي عن جعفر بن عبد الرحمن الأنصاري عن الأعمش عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","حكيم بن سعد عن أم سلمة"
"21349","رِبْعِيُّ بْنُ حِرَاشٍ  عَنْ  أُمِّ سَلَمَةَ  رَضِيَ اللهُ عَنْهَا .  751  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  رِبْعِيِّ بْنِ حِرَاشٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ  سَاهِمُ  الْوَجْهِ ، فَقُلْتُ : يَا رَسُولَ اللهِ مَا لِي أَرَاكَ  سَاهِمَ  الْوَجْهِ ؟ قَالَ :  الدَّنَانِيرُ الَّتِي أَتَوْنَا بِهَا ، نَسِيتُهَا فِي  خُصْمِ  فِرَاشِي ، نُسِّيتُ أَنْ أَقْسِمَهَا قَبْلَ أَنْ أُمْسِيَ  .","","Al-Mu'jam al-Kabir 751","","هند بنت أبي أمية زوج رسول الله عن ربعي بن حراش العبسي عن عبد الملك بن عمير القبطي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","ربعي بن حراش عن أم سلمة رضي الله عنها"
"21350","752  -  حَدَّثَنَا  حُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى بْنُ دَاوُدَ الْوَاسِطِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ يَزِيدَ بْنِ مَرْدَانِيَةَ ،  ثَنَا  رُقْيَةُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  رِبْعِيٍّ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 752","","هند بنت أبي أمية زوج رسول الله عن ربعي بن حراش العبسي عن عبد الملك بن عمير القبطي عن رقبة بن مصقلة عن إبراهيم بن يزيد بن مردانبه عن يحيى بن داود بن ميمون الواسطي عن الحسين بن إسحاق التستري عن الطبراني","ربعي بن حراش عن أم سلمة رضي الله عنها"
"21351","[23/328]      مُنْذِرٌ الثَّوْرِيُّ  عَنْ  أُمِّ سَلَمَةَ  .  753  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ الْعَسَّالُ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  جَعْفَرٌ الْأَحْمَرُ ،  عَنْ  جَامِعِ بْنِ أَبِي رَاشِدٍ ،  عَنْ  مُنْذِرٍ أَبِي يَعْلَى ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" إِذَا غَضِبَ احْمَرَّ وَجْهُهُ  .","","Al-Mu'jam al-Kabir 753","","هند بنت أبي أمية زوج رسول الله عن المنذر بن يعلى الثوري عن جامع بن أبي راشد الكاهلي عن جعفر بن زياد الأحمر عن إسماعيل بن عمرو البجلي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","منذر الثوري عن أم سلمة"
"21352","صَالِحُ بْنُ زَيْدٍ  عَنْ  أُمِّ سَلَمَةَ  .  754  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَعْلَى بْنُ عُبَيْدٍ ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عَلِيُّ بْنُ بَحْرٍ ،  ثَنَا  عِيسَى بْنُ يُونُسَ ، قَالَا :  ثَنَا  مُوسَى الْجُهَنِيُّ ،  عَنْ  صَالِحِ بْنِ زَيْدٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  قَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اجْلِسِي بِالْبَابِ فَلَا يَلِجَنَّ عَلَيَّ أَحَدٌ  ، فَقُمْتُ بِالْبَابِ إِذْ جَاءَ  الْحُسَيْنُ  وَهُوَ وَصِيفٌ فَذَهَبْتُ أَتَنَاوَلُهُ فَسَبَقَنِي الْغُلَامُ فَدَخَلَ عَلَى جَدِّهِ ، فَقُلْتُ : يَا نَبِيَّ اللهِ جَعَلَنِي اللهُ فِدَاكَ أَمَرْتَنِي أَنْ لَا يَلِجَنَّ عَلَيْكَ أَحَدٌ وَإِنَّ ابْنَكَ جَاءَ فَذَهَبْتُ أَتَنَاوَلُهُ فَسَبَقَنِي ، فَلَمَّا طَالَ ذَلِكَ تَطَلَّعْتُ مِنَ الْبَابِ ، فَوَجَدْتُكَ تُقَلِّبُ بِكَفِّكَ شَيْئًا وَدُمُوعُكَ تَسِيلُ وَالصَّبِيُّ عَلَى بَطْنِكَ ، قَالَ : "" نَعَمْ أَتَانِي  جِبْرِيلُ  ، فَأَخْبَرَنِي أَنَّ أُمَّتِي يَقْتُلُونَهُ ، وَأَتَانِي بِالتُّرْبَةِ الَّتِي يُقْتَلُ عَلَيْهَا ، فَهِيَ الَّتِي أُقَلِّبُ بِكَفَّيَّ  .","","Al-Mu'jam al-Kabir 754","","هند بنت أبي أمية زوج رسول الله عن صالح بن زيد عن موسى بن عبد الله الجهني عن يعلى بن عبيد الطنافسي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","صالح بن زيد عن أم سلمة"
"21353","[23/329]      زِرُّ بْنُ حُبَيْشٍ  عَنْ  أُمِّ سَلَمَةَ  .  755  -  حَدَّثَنَا  إِسْحَاقُ بْنُ دَاوُدَ الصَّوَّافُ ،  ثَنَا  يَحْيَى بْنُ خِذَامٍ السَّقَطِيُّ ، (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ الْجُذُوعِيُّ ،  ثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ، (  ح  ) .  وَحَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ الْعَبَّادِيُّ ، قَالُوا :  ثَنَا  الْحَكَمُ بْنُ مَرْوَانَ الضَّرِيرُ ،  ثَنَا  عَبْدُ الْغَفَّارِ بْنُ الْقَاسِمِ ،  عَنْ  عَاصِمِ بْنِ أَبِي النَّجُودِ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ مِنْ أَصْحَابِي مَنْ لَمْ يَرَنِي بَعْدَ أَنْ أَمُوتَ  .","","Al-Mu'jam al-Kabir 755","","هند بنت أبي أمية زوج رسول الله عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن عبد الغفار بن القاسم الأنصاري عن الحكم بن مروان الكوفي عن يحيى بن خذام السقطي عن إسحاق بن داود الصواف عن الطبراني","زر بن حبيش عن أم سلمة"
"21354","نُفَيْعُ بْنُ الْحَارِثِ  عَنْ  أُمِّ سَلَمَةَ  .  756  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يُسَيْرُ بْنُ سُرَيْجٍ  ،  عَنْ  نُفَيْعِ بْنِ الْحَارِثِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  لَمْ نَنْخُلْ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَقِيقًا قَطُّ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( بشير )","","Al-Mu'jam al-Kabir 756","","هند بنت أبي أمية زوج رسول الله عن نفيع بن الحارث الأعمى عن بشير بن سريج البصري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","نفيع بن الحارث عن أم سلمة"
"21355","سَعِيدُ بْنُ وَهْبٍ  عَنْ  أُمِّ سَلَمَةَ  .  757  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  ابْنُ الْأَصْبَهَانِيِّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سَعِيدِ بْنِ وَهْبٍ ، أَوْ  عَنْ  أَخِيهِ  ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ شَاةً لَهُمْ مَاتَتْ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَفَلَا انْتَفَعْتُمْ بِإِهَابِهَا  ؟  .","","Al-Mu'jam al-Kabir 757","","هند بنت أبي أمية زوج رسول الله عن أخو أبو إسحاق السبيعي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن محمد بن سعيد حمدان عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سعيد بن وهب عن أم سلمة"
"21356","مَالِكُ بْنُ جَعْوَنَةَ  عَنْ  أُمِّ سَلَمَةَ  .  758  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلْطِيُّ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مُوسَى         [23/330]      بْنُ قَيْسٍ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  عِيَاضِ بْنِ عِيَاضٍ ،  عَنْ  مَالِكِ بْنِ جَعْوَنَةَ ، قَالَ :  سَمِعْتُ  أُمَّ سَلَمَةَ ، تَقُولُ :  كَانَ  عَلِيٌّ  عَلَى الْحَقِّ مَنِ اتَّبَعَهُ اتَّبَعَ الْحَقَّ  ، وَمَنْ تَرَكَهُ تَرَكَ الْحَقَّ عَهْدًا مَعْهُودًا قَبْلَ يَوْمِهِ هَذَا  "" .","","Al-Mu'jam al-Kabir 758","","هند بنت أبي أمية زوج رسول الله عن مالك بن جعونة عن عياض بن عياض بن خليفة الخزاعي عن سلمة بن كهيل الحضرمي عن عصفور الجنة  ، موسى بن قيس الفراء عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","مالك بن جعونة عن أم سلمة"
"21357","عَطِيَّةُ أَبُو الْمُعَدِّلِ  عَنْ أَبِيهِ عَنْ  أُمِّ سَلَمَةَ  .  759  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ صَالِحٍ الشِّيرَازِيُّ ،  ثَنَا  عُثْمَانُ بْنُ الْهَيْثَمِ ، (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  ثَنَا  هَوْذَةُ ، قَالَا :  ثَنَا  عَوْفٌ ، (  ح  ) .  وَحَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ ،  ثَنَا  أَبُو ظُفُرٍ عَبْدُ السَّلَامِ بْنُ مُطَهَّرٍ ،  ثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ ،  عَنْ  عَوْفٍ ،  عَنْ  عَطِيَّةَ أَبِي الْمُعَدِّلِ  ،  عَنْ  أَبِيهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتِ :  اعْتَنَقَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَلِيًّا  بِيَدٍ  وَفَاطِمَةَ  بِيَدٍ ، وَعَطَفَ عَلَيْهِمَا  خَمِيصَةً  كَانَتْ عَلَيْهِ سَوْدَاءَ ، وَقَبَّلَ  عَلِيًّا  وَفَاطِمَةَ  ، وَقَالَ :  اللَّهُمَّ إِلَيْكَ لَا إِلَى النَّارِ أَنَا وَأَهْلُ بَيْتِي  ، قَالَتْ  أُمُّ سَلَمَةَ  ، قُلْتُ : أَيْ رَسُولَ اللهِ وَأَنَا ؟ قَالَ : "" وَأَنْتِ  .  كذا في طبعة مكتبة ابن تيمية ، وصوابه : ( المعذل) .  كذا في طبعة مكتبة ابن تيمية ، وصوابه : ( المعذل) .","","Al-Mu'jam al-Kabir 759","","هند بنت أبي أمية زوج رسول الله عن والد عطية الطفاوي عن عطية الطفاوي عن عوف بن أبي جميلة عن جعفر بن سليمان الضبعي عن عبد السلام بن مطهر الأزدي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","عطية أبو المعدل عن أبيه عن أم سلمة"
"21358","وَمَنْ حَدَّثَ عَنْ  أُمِّ سَلَمَةَ  مِنْ  أَهْلِ الْبَصْرَةِ  .  ضَبَّةُ بْنُ مِحْصَنٍ الْعَنَزِيُّ  عَنْ  أُمِّ سَلَمَةَ  .  760  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ، (  ح  ) .         [23/331]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقَزَّازُ ،  ثَنَا  أَبُو عُمَرَ الْحَوْضِيُّ ، قَالَا :  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  ضَبَّةَ بْنِ مِحْصَنٍ الْعَنَزِيِّ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّهُ سَيَكُونُ أُمَرَاءُ ، فَيُعْرَفُونَ وَيُنْكَرُونَ  ، فَمَنْ عَرَفَ بَرِئَ ، وَمَنْ أَنْكَرَ سَلِمَ ، وَلَكِنْ مَنْ رَضِيَ وَتَابَعَ "" ، قَالُوا : أَفَلَا نُقَاتِلُهُمْ ؟ قَالَ : "" لَا مَا صَلَّوْا  .","","Al-Mu'jam al-Kabir 760","","هند بنت أبي أمية زوج رسول الله عن ضبة بن محصن العنزي عن الحسن البصري عن قتادة بن دعامة عن همام بن يحيى بن دينار عن حفص بن عمر الحوضى عن محمد بن يحيى بن المنذر القزاز عن الطبراني","ضبة بن محصن العنزي عن أم سلمة"
"21359","761  -  حَدَّثَنَا  أَبُو يَحْيَى الرَّازِيُّ ،  ثَنَا  زُنَيْجُ أَبُو غَسَّانَ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُعَلَّى الرَّازِيُّ ،  عَنْ  أَشْعَثَ ،  عَنْ  هِشَامٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  ضَبَّةَ بْنِ مِحْصَنٍ ،  عَنْ  أُمِّ سَلَمَةَ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 761","","هند بنت أبي أمية زوج رسول الله عن ضبة بن محصن العنزي عن الحسن البصري عن هشام بن حسان العتكي عن أشعث الحمراني عن محمد بن المعلى الهمداني عن محمد بن عمرو بن بكر بن سالم عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","ضبة بن محصن العنزي عن أم سلمة"
"21360","762  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  أَبُو الرَّبِيعِ ، (  ح  ) .  وَحَدَّثَنَا  مُعَاذٌ ،  ثَنَا  مُسَدَّدٌ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  ثَنَا  الْمُعَلَّى بْنُ زِيَادٍ ، وَهِشَامٌ ،  عَنِ  الْحَسَنِ ،  عَنْ  ضَبَّةَ بْنِ مِحْصَنٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 762","","هند بنت أبي أمية زوج رسول الله عن ضبة بن محصن العنزي عن الحسن البصري عن هشام بن حسان العتكي عن حماد بن زيد عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","ضبة بن محصن العنزي عن أم سلمة"
"21361","763  -  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ التُّسْتَرِيُّ ، وَالْحُسَيْنُ بْنُ مُهَّانَ ، قَالَا :  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى ،  ثَنَا  حِبَّانُ بْنُ أَغْلَبَ بْنِ تَمِيمٍ الْمَسْعُودِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنِ  الْحَسَنِ ،  عَنْ  ضَبَّةَ بْنِ مِحْصَنٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الصَّحْرَاءِ فَإِذَا مُنَادِيًا يُنَادِيهِ يَا رَسُولَ اللهِ فَالْتَفَتَ ، فَلَمْ يَرَ أَحَدًا ، ثُمَّ الْتَفَتَ فَإِذَا ظَبْيَةٌ مُوَثَّقَةٌ ، فَقَالَتِ : ادْنُ مِنِّي         [23/332]      يَا رَسُولَ اللهِ فَدَنَا مِنْهَا ، فَقَالَ : "" حَاجَتَكِ ؟ "" قَالَتْ : إِنَّ لِي خَشَفَيْنِ فِي ذَلِكَ الْجَبَلِ فَحُلَّنِي حَتَّى أَذْهَبَ ، فَأُرْضِعَهُمَا ، ثُمَّ أَرْجِعُ إِلَيْكَ ، قَالَ : "" وَتَفْعَلِينَ ؟ "" ، قَالَتْ : عَذَّبَنِي اللهُ بِعَذَابِ الْعِشَارِ إِنْ لَمْ أَفْعَلْ ، فَأَطْلَقَهَا فَذَهَبَتْ ، فَأَرْضَعَتْ خَشَفَيْهَا ، ثُمَّ رَجَعَتْ ، فَأَوْثَقَهَا وَانْتَبَهَ  الْأَعْرَابِيُّ  ، فَقَالَ : لَكَ حَاجَةٌ يَا رَسُولَ اللهِ ، قَالَ :  نَعَمْ تُطْلِقُ هَذِهِ "" ، فَأَطْلَقَهَا فَخَرَجَتْ تَعْدُو ، وَهِيَ تَقُولُ : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَنَّكَ رَسُولُ اللهِ  .","","Al-Mu'jam al-Kabir 763","","هند بنت أبي أمية زوج رسول الله عن ضبة بن محصن العنزي عن الحسن البصري عن هشام بن حسان العتكي عن أغلب بن تميم الشعوذي عن حبان بن أغلب بن تميم السعدي عن زكريا بن يحيى المنقري عن الحسين بن مهان عن الطبراني","ضبة بن محصن العنزي عن أم سلمة"
"21362","عُثْمَانُ بْنُ عَبْدِ اللهِ بْنِ مَوْهَبٍ  عَنْ  أُمِّ سَلَمَةَ  .  764  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ، وَمُعَلَّى بْنُ أَسَدٍ ، قَالَا :  ثَنَا  سَلَّامُ بْنُ أَبِي مُطِيعٍ ،  ثَنَا  عُثْمَانُ بْنُ عَبْدِ اللهِ بْنِ مَوْهَبٍ ، قَالَ :  دَخَلْنَا عَلَى أُمِّ سَلَمَةَ ، فَأَخْرَجَتْ لَنَا صُرَّةً فِيهَا شَعَرِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَخْضُوبٌ بِحِنَّاءٍ  ، فَقَالَتْ : "" هَذَا مِنْ شَعَرِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .","","Al-Mu'jam al-Kabir 764","","هند بنت أبي أمية زوج رسول الله عن عثمان بن عبد الله بن موهب الأعرج عن سلام بن أبي مطيع الخزاعي عن معلى بن أسد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عثمان بن عبد الله بن موهب عن أم سلمة"
"21363","765  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ ،  ثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ،  ثَنَا  أَبُو عَاصِمٍ ،  عَنْ  مَنْصُورِ بْنِ دِينَارٍ ،  عَنْ  عُثْمَانَ بْنِ عَبْدِ اللهِ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 765","","هند بنت أبي أمية زوج رسول الله عن عثمان بن عبد الله بن موهب الأعرج عن منصور بن دينار التميمي عن أبو عاصم النبيل عن محمد بن معمر بن ربعي البحراني عن أحمد بن يحيى بن زهير التستري عن الطبراني","عثمان بن عبد الله بن موهب عن أم سلمة"
"21364","مُعَاوِيَةُ بْنُ قُرَّةَ  عَنْ  أُمِّ سَلَمَةَ  .  766  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو         [23/333]      بَكْرِ بْنُ عَيَّاشٍ ،  عَنِ  الْمُعَلَّى الْأَسَدِيِّ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" يَبْدَأُ بِالشَّرَابِ إِذَا كَانَ صَائِمًا  ، وَكَانَ لَا  يَعُبُّ  يَشْرَبُ مَرَّتَيْنِ أَوْ ثَلَاثًا  "" .","","Al-Mu'jam al-Kabir 766","","هند بنت أبي أمية زوج رسول الله عن معاوية بن قرة عن معلى بن زياد القردوسي عن أبو بكر بن عياش عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","معاوية بن قرة عن أم سلمة"
"21365","767  -  حَدَّثَنَا  أَبُو عُمَرَ الضَّرِيرُ ،  ثَنَا  ابْنُ يُونُسَ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنِ  الْمُعَلَّى الْمَالِكِيِّ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" لَا  يَعُبُّ  فِي شَرَابِهِ مَرَّتَيْنِ أَوْ ثَلَاثًا  .","","Al-Mu'jam al-Kabir 767","","هند بنت أبي أمية زوج رسول الله عن معاوية بن قرة عن المعلى المالكي عن أبو بكر بن عياش عن أحمد بن عبد الله اليربوعي عن محمد بن عثمان بن سعيد الضرير عن الطبراني","معاوية بن قرة عن أم سلمة"
"21366","شَهْرُ بْنُ حَوْشَبٍ  عَنْ  أُمِّ سَلَمَةَ  .  زُبَيْدٌ الْيَامِيُّ  عَنْ  شَهْرِ بْنِ حَوْشَبٍ  .  768  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو إِسْرَائِيلَ ،  عَنْ  زُبَيْدٍ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ الْآيَةَ نَزَلَتْ فِي بَيْتِهَا         {      إِنَّمَا يُرِيدُ اللهُ لِيُذْهِبَ عَنْكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا         }      ، وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَعَلِيٌّ  وَفَاطِمَةُ  وَالْحَسَنُ  وَالْحُسَيْنُ  ، فَأَخَذَ عَبَاءَةً فَجَلَّلَهُمْ بِهَا ثُمَّ قَالَ :  اللَّهُمَّ هَؤُلَاءِ أَهْلُ بَيْتِي ، فَأَذْهِبْ عَنْهُمُ الرِّجْسَ وَطَهِّرْهُمْ تَطْهِيرًا  ، فَقُلْتُ وَأَنَا عِنْدَ عَتَبَةِ الْبَابِ : يَا رَسُولَ اللهِ وَأَنَا مَعَهُمْ ؟ قَالَ : "" إِنَّكِ بِخَيْرٍ وَإِلَى خَيْرٍ  .","","Al-Mu'jam al-Kabir 768","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن زبيد بن الحارث اليامي عن إسماعيل بن خليفة الملائي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","زبيد اليامي عن شهر بن حوشب"
"21367","769  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ ،  ثَنَا  مُوسَى بْنُ عَبْدِ الرَّحْمَنِ الْمَسْرُوقِيُّ ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ إِبْرَاهِيمَ ،  ثَنَا  هِلَالُ بْنُ مِقْلَاصٍ ،  عَنْ  زُبَيْدٍ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .         [23/334]","","Al-Mu'jam al-Kabir 769","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن زبيد بن الحارث اليامي عن هلال بن أبي حميد عن يحيى بن زكريا بن إبراهيم النخعي عن موسى بن عبد الرحمن بن سعيد المسروقي عن أحمد بن يحيى بن زهير التستري عن الطبراني","زبيد اليامي عن شهر بن حوشب"
"21368","770  -  حَدَّثَنَا  عَبْدَانُ ،  ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  أَبُو أَحْمَدَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  زُبَيْدٍ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 770","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن زبيد بن الحارث اليامي عن سفيان الثوري عن محمد بن عبد الله بن الزبير عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","زبيد اليامي عن شهر بن حوشب"
"21369","771  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ السِّرَاجُ ،  ثَنَا  ابْنُ أَبِي الْحُسَيْنِ ،  ثَنَا  جَعْفَرٌ الْأَحْمَرُ ،  عَنِ  الْأَجْلَحِ ،  عَنْ  زُبَيْدٍ ،  عَنْ  شَهْرٍ ،  عَنْ  أُمِّ سَلَمَةَ مِثْلَهُ  .","","Al-Mu'jam al-Kabir 771","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن زبيد بن الحارث اليامي عن أجلح بن عبد الله الكندي عن جعفر بن زياد الأحمر عن ابن أبي الحسين عن الحسن بن علي السراج عن الطبراني","زبيد اليامي عن شهر بن حوشب"
"21370","أَبُو كَعْبٍ صَاحِبُ الْجَرِيدِ  عَنْ  شَهْرٍ  .  772  -  حَدَّثَنَا  أَبُو مُسْلِمٍ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  أَبُو كَعْبٍ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَقُولُ :  يَا مُقَلِّبَ الْقُلُوبِ ثَبِّتْ قَلْبِي عَلَى دِينِكَ  .","","Al-Mu'jam al-Kabir 772","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن عبد ربه بن عبيد الجرموزي عن مسلم بن إبراهيم الشحام عن أبو مسلم الكجي عن الطبراني","أبو كعب صاحب الحرير عن شهر"
"21371","773  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالَا :  ثَنَا  الْفَضْلُ بْنُ سَهْلٍ الْأَعْرَجُ ،  ثَنَا  عَلِيُّ بْنُ ثَابِتٍ ،  عَنْ  أَسْبَاطٍ ،  عَنِ  السُّدِّيِّ ،  عَنْ  بِلَالِ بْنِ مِرْدَاسٍ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَتَتْهُ  فَاطِمَةُ  بِخَرِيزَةٍ فَوَضَعَتْهُ بَيْنَ يَدَيْهِ ، فَقَالَ لِي :  ادْعِ لِي زَوْجَكِ وَابْنَيْكِ  ، فَدَعَوْتُهُمْ فَطَعِمُوا وَتَحْتَهُمْ كِسَاءٌ خَيْبَرِيٌّ ، فَجَمَعَ         [23/335]      رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْكِسَاءَ عَلَيْهِمْ ، ثُمَّ قَالَ : "" هَؤُلَاءِ أَهْلُ بَيْتِي  وَحَامَّتِي ،  فَأَذْهِبْ عَنْهُمُ الرِّجْسَ وَطَهِّرْهُمْ تَطْهِيرًا  .","","Al-Mu'jam al-Kabir 773","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن بلال بن مرداس الفزاري عن السدي الكبير عن أسباط بن نصر الهمداني عن علي بن ثابت الدهان عن الفضل بن سهل الخراساني عن عبد الله بن أحمد الجواليقي عن الطبراني","أبو كعب صاحب الحرير عن شهر"
"21372","ثَابِتٌ الْبُنَانِيُّ  عَنْ  شَهْرِ بْنِ حَوْشَبٍ  .  774  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  خَلَفُ بْنُ مُوسَى بْنِ خَلَفٍ ،  ثَنَا  أَبِي  ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَقْرَأُ هَذِهِ الْآيَةَ         {      إِنَّهُ عَمَلٌ غَيْرُ صَالِحٍ         }      .","","Al-Mu'jam al-Kabir 774","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن ثابت البناني عن موسى بن خلف العمي عن خلف بن موسى بن خلف العمي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ثابت البناني عن شهر بن حوشب"
"21373","775  -  حَدَّثَنَا  عَلِيٌّ ،  ثَنَا  مُعَلَّى بْنُ أَسَدٍ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ الْمُخْتَارِ ،  عَنْ  ثَابِتٍ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 775","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن ثابت البناني عن عبد العزيز بن المختار الدباغ عن معلى بن أسد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ثابت البناني عن شهر بن حوشب"
"21374","776  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  طَالُوتُ بْنُ عَبَّادٍ ،  ثَنَا  هَارُونُ بْنُ مُوسَى ،  عَنْ  ثَابِتٍ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 776","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن ثابت البناني عن هارون بن موسى العتكي عن طالوت بن عباد الجحدري عن الحسين بن إسحاق التستري عن الطبراني","ثابت البناني عن شهر بن حوشب"
"21375","777  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عَقِيلٍ ،  ثَنَا  مُحَمَّدُ بْنُ عُمَرَ الْبَاهِلِيُّ ،  ثَنَا  عَبَّاسُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  دَاوُدُ بْنُ أَبِي هِنْدَ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" قَرَأَ هَذَا الْحَرْفَ         {      إِنَّهُ عَمَلٌ غَيْرُ صَالِحٍ         }      .","","Al-Mu'jam al-Kabir 777","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن ثابت البناني عن داود بن أبي هند عن عباس بن عبد الرحمن عن محمد بن عمر بن عبد الله بن فيروز عن محمد بن عبد الله بن عبيد بن عقيل الهلالي عن عبد الله بن أحمد الجواليقي عن الطبراني","ثابت البناني عن شهر بن حوشب"
"21376","778  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عُثْمَانُ بْنُ مُضَرٍ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" قَرَأَ هَذَا الْحَرْفَ         {      إِنَّهُ عَمَلٌ غَيْرُ صَالِحٍ         }      .","","Al-Mu'jam al-Kabir 778","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن ثابت البناني عن عثمان بن مطر الشيباني عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","ثابت البناني عن شهر بن حوشب"
"21377","[23/336]      عَلِيُّ بْنُ زَيْدٍ  عَنْ  شَهْرِ بْنِ حَوْشَبٍ  .  779  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجٌ ،  ثَنَا  حَمَّادٌ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِفَاطِمَةَ  :  ائْتِنِي بِزَوْجِكِ وَابْنَيْهِ  ، فَجَاءَتْ بِهِمْ ، فَأَلْقَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَيْهِمْ كِسَاءً فَدَكِيًّا ، ثُمَّ وَضَعَ يَدَهُ عَلَيْهِمْ ، فَقَالَ : "" اللَّهُمَّ إِنَّ هَؤُلَاءِ  آلُ مُحَمَّدٍ  ، فَاجْعَلْ صَلَوَاتِكَ وَبَرَكَاتِكَ عَلَى  آلِ مُحَمَّدٍ  ، فَإِنَّكَ حَمِيدٌ مَجِيدٌ "" ، قَالَتْ  أُمُّ سَلَمَةَ  : فَرَفَعْتُ الْكِسَاءَ لِأَدْخُلَ مَعَهُمْ ،  فَجَبَذَهُ  مِنْ يَدِي ، وَقَالَ : "" إِنَّكِ عَلَى خَيْرٍ  .","","Al-Mu'jam al-Kabir 779","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن علي بن زيد بن جدعان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","علي بن زيد عن شهر بن حوشب"
"21378","عُقْبَةُ بْنُ عَبْدِ اللهِ الرِّفَاعِيُّ  عَنْ  شَهْرِ بْنِ حَوْشَبٍ  .  780  -  حَدَّثَنَا  عَبْدُ الْوَارِثِ بْنُ إِبْرَاهِيمَ الْعَسْكَرِيُّ ،  ثَنَا  حَوْثَرَةُ بْنُ أَشْرَسَ ،  ثَنَا  عُقْبَةُ بْنُ عَبْدِ اللهِ الرِّفَاعِيُّ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِفَاطِمَةَ  :  ائْتِينِي بِزَوْجِكِ وَابْنَيْكِ  ، فَجَاءَتْ بِهِمْ ، فَأَلْقَى عَلَيْهِمْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كِسَاءً ، ثُمَّ قَالَ : "" هَؤُلَاءِ  آلُ مُحَمَّدٍ  ، فَاجْعَلْ صَلَوَاتِكَ وَبَرَكَاتِكَ عَلَى  آلِ مُحَمَّدٍ  ، كَمَا جَعَلْتَهَا عَلَى  آلِ إِبْرَاهِيمَ  إِنَّكَ حَمِيدٌ مَجِيدٌ  .","","Al-Mu'jam al-Kabir 780","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن عقبة بن عبد الله الأصم عن حوثرة بن أشرس بن عومر العدوي عن عبد الوارث بن إبراهيم العسكري عن الطبراني","عقبة بن عبد الله الرفاعي عن شهر بن حوشب"
"21379","[23/337]      الْحَكَمُ بْنُ عُتَيْبَةَ  عَنْ  شَهْرِ بْنِ حَوْشَبٍ  .  781  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، وَعُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالُوا :  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنِ  الْحَسَنِ بْنِ عَمْرٍو ،  عَنِ  الْحَكَمِ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ كُلِّ مُسْكِرٍ  وَمُفَتِّرٍ  .","","Al-Mu'jam al-Kabir 781","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن الحكم بن عتيبة الكندي عن الحسن بن عمرو الفقيمي عن عبد الله بن نمير عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","الحكم بن عتيبة عن شهر بن حوشب"
"21380","يَزِيدُ مَوْلَى الصَّهْبَاءِ  عَنْ  شَهْرٍ  .  782  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى ، وَعُثْمَانُ ، قَالَا :  ثَنَا  وَكِيعٌ ،  عَنْ  يَزِيدَ مَوْلَى الصَّهْبَاءِ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  قَوْلَهُ :         {      وَلا يَعْصِينَكَ فِي مَعْرُوفٍ         }      ، قَالَ : "" النَّوْحُ  .","","Al-Mu'jam al-Kabir 782","","أسماء بنت يزيد بن السكن الأوسية عن شهر بن حوشب عن يزيد بن عبد الله الشيباني عن وكيع بن الجراح عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","يزيد مولى الصهباء عن شهر"
"21381","حَبِيبُ بْنُ أَبِي ثَابِتٍ  عَنْ  شَهْرٍ  .  783  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدِ بْنِ مَنْصُورٍ ،  ثَنَا  حُسَيْنٌ الْأَشْقَرُ ،  حَدَّثَنَا  مَنْصُورُ بْنُ أَبِي الْأَسْوَدِ ،  ثَنَا  الْأَعْمَشُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَخَذَ ثَوْبًا فَجَلَّلَهُ عَلَى  عَلِيٍّ  وَفَاطِمَةَ  وَالْحَسَنِ  وَالْحُسَيْنِ  ، ثُمَّ قَرَأَ هَذِهِ الْآيَةَ         {      إِنَّمَا يُرِيدُ اللهُ لِيُذْهِبَ عَنْكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا         }      .","","Al-Mu'jam al-Kabir 783","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن حبيب بن أبي ثابت الكاهلي عن الأعمش عن منصور بن أبي الأسود الليثي عن الحسين بن الحسن الأشقر عن عبد الرحمن بن محمد كربزان عن أحمد بن يحيى بن زهير التستري عن الطبراني","حبيب بن أبي ثابت عن شهر"
"21382","[23/338]      زَيْدٌ الْعَمِّيُّ  عَنْ  شَهْرٍ  .  784  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نُوحٍ الْعَسْكَرِيُّ ،  ثَنَا  يَحْيَى بْنُ عَلَّانَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدٍ ،  عَنْ  أَبِي الْفَضْلِ الْقَيْسِيِّ ،  عَنْ  زَيْدٍ الْعَمِّيِّ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّهُ قَرَأَ         {      عَمَلٌ غَيْرُ صَالِحٍ         }      .","","Al-Mu'jam al-Kabir 784","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن زيد بن الحواري العمي عن أبو الفضل القيسي عن إبراهيم بن محمد بن أبي يحيى عن يحيى بن غيلان بن عوام التستري عن محمد بن نوح العسكري عن الطبراني","زيد العمي عن شهر"
"21383","عَبْدُ الْحَمِيدِ بْنُ بَهْرَامَ  عَنْ  شَهْرِ بْنِ حَوْشَبٍ  .  785  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ مِنْهَالٍ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ بَهْرَامَ ،  ثَنَا  شَهْرُ بْنُ حَوْشَبٍ ، قَالَ :  سَمِعْتُ  أُمَّ سَلَمَةَ ، قَالَتْ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُكْثِرُ أَنْ يَقُولَ :  يَا مُقَلِّبَ الْقُلُوبِ ثَبِّتْ قَلْبِي عَلَى دِينِكَ  ، قَالَتْ : قُلْتُ : يَا رَسُولَ اللهِ وَإِنَّ الْقُلُوبَ لَتَتَقَلَّبُ ، قَالَ : "" نَعَمْ مَا خَلَقَ اللهُ مِنْ بَنِي آدَمَ مِنْ بَشَرٍ إِلَّا وَقَلْبُهُ بَيْنَ  أُصْبُعَيْنِ  مِنْ أَصَابِعِ اللهِ إِنْ شَاءَ أَقَامَهُ وَإِنْ شَاءَ أَزَاغَهُ ، فَنَسْأَلُ اللهَ رَبَّنَا أَنْ لَا  يُزِيغَ  قُلُوبَنَا بَعْدَ إِذْ هَدَانَا ، وَنَسْأَلُهُ أَنْ يَهَبَ لَنَا مِنْ لَدُنْهُ رَحْمَةً إِنَّهُ هُوَ الْوَهَّابُ "" ، قُلْتُ : يَا رَسُولَ اللهِ فَعَلِّمْنِي دُعَاءً أَدْعُو بِهِ لِنَفْسِي ، قَالَ : "" قُولِي اللَّهُمَّ اغْفِرْ لِي ذَنْبِي وَأَذْهِبْ غَيْظَ قَلْبِي وَأَجِرْنِي مِنْ مُضِلَّاتِ الْفِتَنِ  .","","Al-Mu'jam al-Kabir 785","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن عبد الحميد بن بهرام الفزاري عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الحميد بن بهرام عن شهر بن حوشب"
"21384","786  -  حَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  أَبُو الْوَلِيدِ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ بَهْرَامَ ،  ثَنَا  شَهْرُ بْنُ حَوْشَبٍ ، قَالَ :  سَمِعْتُ  أُمَّ سَلَمَةَ حِينَ جَاءَ نَعْيُ  الْحُسَيْنِ بْنِ عَلِيٍّ  - رَضِيَ اللهُ عَنْهُ - لَعَنَتْ  أَهْلَ الْعِرَاقِ  ، وَقَالَتْ : قَتَلُوهُ قَتَلَهُمُ اللهُ عَزَّوْهُ         [23/339]      وَذَلُّوهُ لَعَنَهُمُ اللهُ "" ، فَإِنِّي  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَاءَتْهُ  فَاطِمَةُ  - رَضِيَ اللهُ عَنْهَا  - فَذَكَرَ الْحَدِيثَ  .","","Al-Mu'jam al-Kabir 786","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن عبد الحميد بن بهرام الفزاري عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","عبد الحميد بن بهرام عن شهر بن حوشب"
"21385","787  -  حَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  أَبُو الْوَلِيدِ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ بَهْرَامَ ،  ثَنَا  شَهْرُ بْنُ حَوْشَبٍ ، قَالَ :  سَمِعْتُ  أُمَّ سَلَمَةَ تُحَدِّثُ  أَنَّ  فَاطِمَةَ  جَاءَتْ تَشْتَكِي الْخِدْمَةَ ، فَقَالَتْ : يَا رَسُولَ اللهِ  مَجِلَتْ  يَدَايَ مِنَ الرَّحَى الْخُبْزُ مَرَّةً ، وَالْعَجِينُ مَرَّةً ، فَقَالَ لَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنْ يَرْزُقْكِ اللهُ شَيْئًا يَأْتِكِ ، سَأَدُلُّكِ عَلَى شَيْءٍ خَيْرٍ مِنْ ذَلِكَ إِذَا لَزِمْتِ مَضْجَعَكِ ، فَسَبِّحِي اللهَ ثَلَاثًا وَثَلَاثِينَ  ، وَاحْمَدِي اللهَ ثَلَاثًا وَثَلَاثِينَ ، وَكَبِّرِي أَرْبَعًا وَثَلَاثِينَ ، فَذَلِكَ خَيْرٌ لَكِ مِنَ الْخَادِمِ ، وَإِذَا صَلَّيْتِ صَلَاةَ الصُّبْحِ فَقُولِي : لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ يُحْيِي وَيُمِيتُ بِيَدِهِ الْخَيْرُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ عَشْرَ مَرَّاتٍ بَعْدَ صَلَاةِ الصُّبْحِ ، وَعَشْرَ مَرَّاتٍ بَعْدَ صَلَاةِ الْمَغْرِبِ ، فَإِنَّ كُلَّ وَاحِدَةٍ مِنْهُنَّ يُكْتَبُ عَشْرَ حَسَنَاتٍ وَيَحُطُّ عَشْرَ سَيِّئَاتٍ ، وَكُلُّ وَاحِدَةٍ مِنْهُنَّ كَعِتْقِ رَقَبَةٍ مِنْ وَلَدِ  إِسْمَاعِيلَ  ، لَا يَحِلُّ بِذَنْبٍ كُتِبَ ذَلِكَ الْيَوْمَ إِلَّا مَحَتْهُ إِلَّا أَنْ يَكُونَ  الشِّرْكُ  ، لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، وَهِيَ تَحْرُسُكِ مَا بَيْنَ أَنْ تَقُولِيهِ غُدْوَةً إِلَى أَنْ تَقُولِيهِ عَشِيَّةً مِنْ كُلِّ شَيْطَانٍ ، وَمِنْ كُلِّ شَيْءٍ  .","","Al-Mu'jam al-Kabir 787","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن عبد الحميد بن بهرام الفزاري عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","عبد الحميد بن بهرام عن شهر بن حوشب"
"21386","أَبُو عُثْمَانَ  عَنْ  أُمِّ سَلَمَةَ  .  788  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي سَمِينَةَ ،  ثَنَا  مُعْتَمِرٌ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي عُثْمَانَ ، [ قَالَ ] :  قَالَتْ  أُمُّ سَلَمَةَ ،  كَانَ رَسُولُ         [23/340]      اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُحَدِّثُ رَجُلًا ، فَقَالَ :  يَا  أُمَّ سَلَمَةَ  مَنْ هَذَا ؟ "" فَقُلْتُ :  دِحْيَةُ الْكَلْبِيُّ  ، فَلَمْ أَعْلَمْ أَنَّهُ  جِبْرِيلُ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُحَدِّثُ أَصْحَابَهُ مَا كَانَ بَيْنَهُمَا  ، قُلْتُ  لِأَبِي عُثْمَانَ  :  مَنْ حَدَّثَكَ  هَذَا ؟ قَالَ : أُسَامَةُ بْنُ زَيْدٍ .","","Al-Mu'jam al-Kabir 788","","هند بنت أبي أمية زوج رسول الله عن أسامة بن زيد بن حارثة ذو البطين عن أبو عثمان النهدي عن سليمان بن طرخان عن معتمر بن سليمان عن محمد بن إسماعيل بن أبي سمينة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","أبو عثمان عن أم سلمة"
"21387","وَمَنْ رَوَى عَنْ  أُمِّ سَلَمَةَ  مِنْ  أَهْلِ مِصْرَ  .  أَبُو قَيْسٍ مَوْلَى عَمْرِو بْنِ الْعَاصِ  عَنْ  أُمِّ سَلَمَةَ  .  789  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  ثَنَا  مُوسَى بْنُ عُلَيٍّ بْنِ رَبَاحٍ اللَّخْمِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي قَيْسٍ ،  أَنَّ  عَبْدَ اللهِ بْنَ عَمْرِو بْنِ الْعَاصِ أَرْسَلَهُ إِلَى أُمِّ سَلَمَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَسْأَلُهَا  ، هَلْ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُقَبِّلُ وَهُوَ صَائِمٌ ؟ فَإِنْ قَالَتْ : لَا ، فَقُلْ لَهَا : إِنَّ عَائِشَةَ  تُحَدِّثُ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ "" يُقَبِّلُ وَهُوَ صَائِمٌ  ، قَالَ  أَبُو قَيْسٍ  : فَجِئْتُهَا ، فَقَالَتْ : أَحُرٌّ أَمْ مَمْلُوكٌ ؟ فَقُلْتُ : بَلْ مَمْلُوكٌ ، فَقَالَتِ : ادْنُهْ فَدَنَوْتُ ، فَقُلْتُ : إِنَّ  عَبْدَ اللهِ بْنَ عَمْرٍو  أَرْسَلَنِي إِلَيْكِ لِأَسْأَلَكِ  هَلْ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُقَبِّلُ وَهُوَ صَائِمٌ ؟ فَقَالَتْ : لَا  ، فَقُلْتُ : إِنَّ  عَائِشَةَ  تُحَدِّثُ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ "" يُقَبِّلُ وَهُوَ صَائِمٌ "" ، فَقَالَتْ : لَعَلَّهُ أَنَّهُ كَانَ لَمْ يَكُ يَتَمَالَكُ لَهَا حُبًّا  .","","Al-Mu'jam al-Kabir 789","","هند بنت أبي أمية زوج رسول الله عن عبد الرحمن بن ثابت السهمي عن علي بن رباح اللخمي عن موسى بن علي اللخمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","أبو قيس مولى عمرو بن العاص عن أم سلمة"
"21388","أَسْلَمُ أَبُو عِمْرَانَ  عَنْ  أُمِّ سَلَمَةَ  .  790  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  ابْنُ         [23/341]      الْمُبَارَكِ ،  عَنْ  حَيْوَةَ بْنِ شُرَيْحٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  أَسْلَمَ أَبِي عِمْرَانَ  قَالَ  :  حَجَجْتُ فَلَقِيتُ أُمَّ سَلَمَةَ فَقَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ حَجَّ مِنْكُمْ فَلْيُهِلَّ بِهِمَا جَمِيعَا بِحَجَّةٍ وَعُمْرَةٍ  .","","Al-Mu'jam al-Kabir 790","","هند بنت أبي أمية زوج رسول الله عن أسلم بن يزيد التجيبي عن يزيد بن أبي حبيب الأزدي عن حيوة بن شريح التجيبي عن عبد الله بن المبارك عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","أسلم أبو عمران عن أم سلمة"
"21389","791  -  وَحَدَّثَنَا  هَارُونُ بْنُ مَمْلُوكٍ الْمِصْرِيُّ  ،  ثَنَا  الْمُقْرِي ،  ثَنَا  حَيْوَةُ مِثْلَهُ .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( هارون بن ملول )","","Al-Mu'jam al-Kabir 791","","هند بنت أبي أمية زوج رسول الله عن أسلم بن يزيد التجيبي عن يزيد بن أبي حبيب الأزدي عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","أسلم أبو عمران عن أم سلمة"
"21390","792  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  أَبُو صَالِحٍ عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي حَبِيبٍ ،  عَنْ  أَسْلَمَ أَبِي عِمْرَانَ  قَالَ  :  حَجَجْتُ مَعَ مَوْلَايَ فَدَخَلْتُ عَلَى أُمِّ سَلَمَةَ فَقَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  أَهِلُّوا يَا أُمَّةَ  مُحَمَّدٍ  بِحَجَّةٍ وَعُمْرَةٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .","","Al-Mu'jam al-Kabir 792","","هند بنت أبي أمية زوج رسول الله عن أسلم بن يزيد التجيبي عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","أسلم أبو عمران عن أم سلمة"
"21391","الْقَاسِمُ بْنُ مُخَيْمِرَةَ  عَنْ  أُمِّ سَلَمَةَ  .  793  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى بْنِ حَمَّادٍ الْبَرْبَرِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  مُحَمَّدُ بْنُ آدَمَ ، قَالَا :  ثَنَا  عَبْدُ الرَّحِيمِ ،  عَنْ  مُسْلِمٍ الْمُلَائِيِّ ،  عَنِ  الْقَاسِمِ بْنِ مُخَيْمِرَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  شَغَلُونَا عَنْ صَلَاةِ الْوُسْطَى صَلَاةِ الْعَصْرِ  مَلَأَ اللهُ أَجْوَافَهُمْ وَقُبُورَهُمْ نَارًا  .","","Al-Mu'jam al-Kabir 793","","هند بنت أبي أمية زوج رسول الله عن القاسم بن مخيمرة عن مسلم بن كيسان البراد عن عبد الرحيم بن سليمان الأشل عن عبد الرحمن بن صالح العتكي عن محمد بن موسى بن حماد البربري عن الطبراني","القاسم بن مخيمرة عن أم سلمة"
"21392","هَذَا مَا  أَسْنَدَ  النِّسَاءُ عَنْ  أُمِّ سَلَمَةَ  زَيْنَبُ بِنْتُ أُمِّ سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  هِشَامُ بْنُ عُرْوَةَ  عَنْ أَبِيهِ عَنْ  زَيْنَبَ  .  794  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،         [23/342]      حَدَّثَنِي  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ  ، أَنَّ  زَيْنَبَ بِنْتَ أُمِّ سَلَمَةَ  حَدَّثَتْهُ  ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  دَخَلَتْ  أُمُّ سُلَيْمٍ  عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ : يَا رَسُولَ اللهِ هَلْ عَلَى الْمَرْأَةِ غُسْلٌ إِذَا احْتَلَمَتْ ؟ قَالَ :  نَعَمْ إِذَا رَأَتِ الْمَاءَ  .","","Al-Mu'jam al-Kabir 794","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","هشام بن عروة عن أبيه عن زينب"
"21393","795  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  ابْنُ الْأَصْبَهَانِيِّ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْنَبَ ،  عَنْ  أُمِّ سَلَمَةَ  مِثْلَهُ .","","Al-Mu'jam al-Kabir 795","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن علي بن مسهر القرشي عن محمد بن سعيد حمدان عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","هشام بن عروة عن أبيه عن زينب"
"21394","796  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ،  أَنَّهَا قَالَتْ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : هَلْ لِي مِنْ أَجْرٍ فِي  بَنِي أَبِي سَلَمَةَ  ، فَإِنِّي أُنْفِقُ عَلَيْهِمْ وَلَسْتُ شَارِكَتَهُمْ ؟ قَالَ :  نَعَمْ لَكِ أَجْرُ مَا أَنْفَقْتِ عَلَيْهِمْ  .","","Al-Mu'jam al-Kabir 796","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد العزيز بن محمد الدراوردي عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","هشام بن عروة عن أبيه عن زينب"
"21395","797  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعِنْدِي  مُخَنَّثٌ  ، فَسَمِعَهُ يَقُولُ  لِعَبْدِ اللهِ بْنِ أَبِي أُمَيَّةَ  : يَا  عَبْدَ اللهِ  إِنْ فَتَحَ اللهُ عَلَيْكُمُ  الطَّائِفَ  غَدًا فَعَلَيْكَ  بِابْنَةِ غَيْلَانَ  ، فَإِنَّهَا تُقْبِلُ بِأَرْبَعٍ ، وَتُدْبِرُ بِثَمَانٍ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَدْخُلْ هَؤُلَاءِ عَلَيْكُمْ  .","","Al-Mu'jam al-Kabir 797","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن سفيان بن عيينة عن سعيد بن عبد الرحمن بن حسان المخزومي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","هشام بن عروة عن أبيه عن زينب"
"21396","[23/343]      798  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلْطِيُّ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْنَبَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّمَا أَنَا بَشَرٌ وَإِنَّكُمْ تَخْتَصِمُونَ إِلَيَّ ، وَلَعَلَّ أَحَدَكُمْ أَنْ يَكُونَ  أَلْحَنَ  بِحُجَّتِهِ مِنْ بَعْضٍ  ، فَأَقْضِي لَهُ عَلَى مَا أَسْمَعُ ، فَمَنْ قَضَيْتُ لَهُ مِنْ حَقِّ أَخِيهِ بِشَيْءٍ فَلَا يَأْخُذْ مِنْهُ شَيْئًا ، فَإِنَّمَا أَقْطَعُ لَهُ قِطْعَةً مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 798","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن سفيان الثوري عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","هشام بن عروة عن أبيه عن زينب"
"21397","799  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ الرَّقِّيُّ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَهَا أَنْ تُوَافِيَ مَعَهُ يَوْمَ النَّحْرِ  بِمَكَّةَ  .","","Al-Mu'jam al-Kabir 799","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أبو معاوية الضرير عن عبد الله بن جعفر بن غيلان عن أبو شعيب الحراني عن الطبراني","هشام بن عروة عن أبيه عن زينب"
"21398","[23/344]      800  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  يَحْيَى بْنُ آدَمَ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  أَمَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِالصَّدَقَةِ  ، فَقَالَتْ  زَيْنَبُ امْرَأَةُ عَبْدِ اللهِ بْنِ مَسْعُودٍ  : أَيُجْزِينِي مِنَ الصَّدَقَةِ أَنْ أَتَصَدَّقَ عَلَى زَوْجِي وَهُوَ فَقِيرٌ ، وَعَلَى بَنِي أَخٍ لِي أَيْتَامٍ وَأَنَا مُنْفِقَةٌ عَلَيْهِمْ عَلَى كُلِّ حَالٍ ؟ فَقَالَ : "" نَعَمْ "" وَكَانَتْ صَنَاعَ الْيَدَيْنِ  .","","Al-Mu'jam al-Kabir 800","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حفص بن غياث النخعي عن يحيى بن آدم عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","هشام بن عروة عن أبيه عن زينب"
"21399","الزُّهْرِيُّ  عَنْ  عُرْوَةَ  .  801  -  حَدَّثَنَا  الْفِرْيَابِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْجَبَّارِ الْخَبَائِرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ حَرْبٍ ،  عَنِ  الزُّبَيْدِيِّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  زَيْنَبَ ،  عَنْ  أُمِّ سَلَمَةَ  ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَأَى  جَارِيَةً  فِي وَجْهِهَا  سَفْعَةٌ  ، فَقَالَ :  اسْتَرْقُوا  لَهَا فَإِنَّ بِهَا  نَظْرَةً  .","","Al-Mu'jam al-Kabir 801","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن الزهري عن محمد بن الوليد بن عامر الزبيدي عن محمد بن حرب الأبرش عن عبد الله بن عبد الجبار الخبائري عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","الزهري عن عروة"
"21400","أَبُو الزِّنَادِ عَبْدُ اللهِ بْنُ ذَكْوَانَ  عَنْ  عُرْوَةَ  ، عَنْ  زَيْنَبَ  .  802  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ الْهَاشِمِيُّ ،  ثَنَا  ابْنُ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُرْوَةَ ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  قَالَتْ :  دَخَلَتْ  أُمُّ سُلَيْمٍ  عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ :  يَا رَسُولَ اللهِ هَلْ عَلَى الْمَرْأَةِ مِنْ غُسْلٍ إِذَا احْتَلَمَتْ ؟ فَقَالَ : "" نَعَمْ إِذَا رَأَتِ الْمَاءَ  .","","Al-Mu'jam al-Kabir 802","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن سليمان بن داود القرشي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو الزناد عبد الله بن ذكوان عن عروة عن زينب"
"21401","[23/345]      803  -  حَدَّثَنَا  عَلِيٌّ ،  ثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ الْهَاشِمِيُّ ،  ثَنَا  ابْنُ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُرْوَةَ ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّمَا أَنَا بَشَرٌ وَإِنَّكُمْ تَخْتَصِمُونَ إِلَيَّ وَلَعَلَّ بَعْضَكُمْ أَنْ يَكُونَ هُوَ  أَلْحَنَ  بِحُجَّتِهِ مِنْ بَعْضٍ  فَأَقْضِي لَهُ عَلَى مَا أَسْمَعُ ، فَمَنْ قَضَيْتُ لَهُ شَيْئًا مِنْ حَقِّ أَخِيهِ فَلَا يَأْخُذْ مِنْهُ شَيْئًا ، فَإِنَّمَا أَقْطَعُ لَهُ قِطْعَةً مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 803","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن سليمان بن داود القرشي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو الزناد عبد الله بن ذكوان عن عروة عن زينب"
"21402","أَبُو الْأَسْوَدِ  عَنْ  عُرْوَةَ  ، عَنْ  زَيْنَبَ  .  804  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَالِكٌ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ نَوْفَلٍ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  شَكَوْتُ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنِّي أَشْتَكِي ، فَقَالَ :  طُوفِي مِنْ وَرَاءِ النَّاسِ وَأَنْتِ رَاكِبَةٌ  ، قَالَتْ : فَطُفْتُ ، وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي بِالنَّاسِ إِلَى جَنْبِ  الْبَيْتِ  ، وَهُوَ يَقْرَأُ بِالطُّورِ         {      وَكِتَابٍ مَسْطُورٍ         }      .","","Al-Mu'jam al-Kabir 804","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن مالك بن أنس عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","أبو الأسود عن عروة عن زينب"
"21403","805  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ ، قَالَ :  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  ثَنَا  مَيْمُونُ بْنُ يَحْيَى ،  عَنْ  مَخْرَمَةَ بْنِ بُكَيْرٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَبْدِ الرَّحْمَنِ ، يَقُولُ :  سَمِعْتُ  عُرْوَةَ بْنَ الزُّبَيْرِ ، قَالَ :  سَمِعْتُ  زَيْنَبَ بِنْتَ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ،         [23/346]      قَالَتْ :  حَجَجْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَاشْتَكَيْتُ قَبْلَ أَنْ أَطُوفَ  بِالْبَيْتِ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ارْكَبِي فَطُوفِي رَاكِبَةً وَرَاءَ النَّاسِ  ، وَهُوَ يُصَلِّي حِينَئِذٍ إِلَى  حَاشِيَةِ  الْبَيْتِ  .","","Al-Mu'jam al-Kabir 805","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن بكير بن عبد الله بن الأشج القرشي عن مخرمة بن بكير المخزومي عن ميمون بن يحيى بن مسلم المدني عن يحيى بن عبد الله بن بكير المخزومي عن روح بن الفرج القطان عن الطبراني","أبو الأسود عن عروة عن زينب"
"21404","أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ  عَنْ  زَيْنَبَ  .  806  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  لَيْثُ بْنُ سَعْدٍ ،  عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ بْنِ الْأَشَجِّ ،  عَنْ  أَبِي بَكْرِ بْنِ الْمُنْذِرِ  ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  أَنَّهَا قَالَتْ :  قَبَّلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ صَائِمٌ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( المنكدر )","","Al-Mu'jam al-Kabir 806","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو سلمة بن عبد الرحمن عن أبو بكر بن المنكدر بن عبد الله التيمي عن بكير بن عبد الله بن الأشج القرشي عن الليث بن سعد عن عاصم بن علي الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو سلمة بن عبد الرحمن عن زينب"
"21405","807  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ [  ثَنَا  ]  الْحَوْضِيُّ ،  ثَنَا  هِشَامٌ  (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عُلَيَّةَ ،  عَنْ  هِشَامُ الدَّسْتُوَائِيِّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  أَنَّهَا كَانَتْ "" تَغْتَسِلُ هِيَ وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ إِنَاءٍ وَاحِدٍ مِنَ الْجَنَابَةِ  .  سقط من طبعة مكتبة ابن تيمية ونسخة الوطنية ، والمثبت من نسخة كوبرلي .  في طبعة مكتبة ابن تيمية : ( هشام بن علية عن إسماعيل الدستوائي ) وهو خطأ والمثبت من نسخة كوبرلي.","","Al-Mu'jam al-Kabir 807","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن هشام الدستوائي عن إسماعيل ابن علية عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","أبو سلمة بن عبد الرحمن عن زينب"
"21406","808  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ بَكْرٍ أَبُو جَعْفَرٍ السِّرَاجُ الْعَسْكَرِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  عَنْبَسَةُ ،  عَنْ  مُحَمَّدِ بْنِ يَعْقُوبَ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّ  زَيْنَبَ بِنْتَ أُمِّ سَلَمَةَ         [23/347]      حَدَّثَتْهُ  ، أَنَّ أُمَّ سَلَمَةَ  حَدَّثَتْهَا  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ "" يُقَبِّلُ وَهُوَ صَائِمٌ  .","","Al-Mu'jam al-Kabir 808","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن محمد بن يعقوب اليمامي عن عنبسة بن عبد الواحد عن عبد الله بن عمر مشكدانة عن محمد بن عبد الله بن بكر السراج عن الطبراني","أبو سلمة بن عبد الرحمن عن زينب"
"21407","809  -  حَدَّثَنَا  حُسَيْنٌ ،  ثَنَا  عُثْمَانُ ،  ثَنَا  ابْنُ عُلَيَّةَ ،  عَنْ  هِشَامٍ ،  عَنْ  يَحْيَى  بِإِسْنَادِهِ  نَحْوَهُ .","","Al-Mu'jam al-Kabir 809","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن هشام الدستوائي عن إسماعيل ابن علية عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","أبو سلمة بن عبد الرحمن عن زينب"
"21408","810  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ ،  ثَنَا  أَبُو مَعْمَرٍ ،  ثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  حُسَيْنٍ الْمُعَلِّمِ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  زَيْنَبَ ،  عَنْ  أُمِّ سَلَمَةَ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهِيَ كَانَا "" يَغْتَسِلَانِ مِنْ إِنَاءٍ وَاحِدٍ  .","","Al-Mu'jam al-Kabir 810","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن حسين المعلم عن عبد الوارث بن سعيد بن ذكوان عن عبد الله بن عمرو المقعد عن أحمد بن داود بن موسى السدوسي عن الطبراني","أبو سلمة بن عبد الرحمن عن زينب"
"21409","811  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  يَحْيَى بْنُ بِشْرٍ ،  ثَنَا  مُعَاوِيَةُ ،  عَنْ  يَحْيَى ،  عَنْ  أَبِي سَلَمَةَ ، أَنَّ  زَيْنَبَ بِنْتَ أَبِي سَلَمَةَ  أَخْبَرَتْهُ  ،  عَنْ  أُمِّ سَلَمَةَ  ،  أَنَّ امْرَأَةً مِنْ  أَسْلَمَ  يُقَالُ لَهَا  سُبَيْعَةُ  كَانَتْ تَحْتَ زَوْجِهَا فَتُوُفِّيَ عَنْهَا ، وَهِيَ حَامِلٌ ، فَخَطَبَهَا  أَبُو السَّنَابِلِ بْنُ بَعْكَكٍ  ، فَأَبَتْ أَنْ تَنْكِحَهُ ، فَقَالَ :  مَا يَصْلُحُ لَكِ أَنْ تَنْكِحِي حَتَّى تَعْتَدِّي آخِرَ الْأَجَلَيْنِ فَمَكَثَتْ عِشْرِينَ لَيْلَةً ، فَأَتَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ لَهَا : "" انْكِحِي  .","","Al-Mu'jam al-Kabir 811","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن معاوية بن سلام عن يحيى بن بشر بن كثير الأسدي عن محمد بن عثمان بن أبي شيبة عن الطبراني","أبو سلمة بن عبد الرحمن عن زينب"
"21410","حُمَيْدُ بْنُ نَافِعٍ  عَنْ  زَيْنَبَ  عَنْ  أُمِّ سَلَمَةَ  .  812  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  أَنَا  عَبْدُ الرَّزَّاقِ ، (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  الْقَعْنَبِيُّ ، (  ح  ) .  وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ، قَالُوا :  ثَنَا  مَالِكُ بْنُ أَنَسٍ ،         [23/348]      عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرٍ ،  عَنْ  حُمَيْدِ بْنِ نَافِعٍ ، أَنَّ  زَيْنَبَ بِنْتَ أَبِي سَلَمَةَ  أَخْبَرَتْهُ  ، فَقَالَتْ :  سَمِعْتُ  أُمَّ سَلَمَةَ  ، تَقُولُ :  جَاءَتِ  امْرَأَةٌ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ : يَا رَسُولَ اللهِ إِنَّ ابْنَتِي تُوُفِّيَ زَوْجُهَا وَقَدِ اشْتَكَتْ عَيْنَيْهَا أَفَأَكْحُلُهَا ؟ قَالَ : "" لَا "" ،  مَرَّتَيْنِ أَوْ ثَلَاثًا  كُلُّ ذَلِكَ ، يَقُولُ : "" لَا "" ، ثُمَّ قَالَ :  إِنَّمَا هِيَ أَرْبَعَةُ أَشْهُرٍ وَعَشْرًا ، وَقَدْ كَانَتْ إِحْدَاكُنَّ تَرْمِي بِالْبَعْرَةِ عَلَى رَأْسِ الْحَوْلِ  .","","Al-Mu'jam al-Kabir 812","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن حميد بن نافع حميد صفيرا عن عبد الله بن أبي بكر بن محمد  ابن حزم عن مالك بن أنس عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","حميد بن نافع عن زينب عن أم سلمة"
"21411","813  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَاصِمٌ ،  ثَنَا  شُعْبَةُ بْنُ الْحَجَّاجِ ،  عَنْ  حُمَيْدِ بْنِ نَافِعٍ ، قَالَ :  سَمِعْتُ  زَيْنَبَ بِنْتَ أُمِّ سَلَمَةَ  تُحَدِّثُ ، عَنْ  أُمِّهَا  ،  أَنَّ  امْرَأَةً  تُوُفِّيَ عَنْهَا زَوْجُهَا فَاشْتَكَتْ عَيْنَهَا فَأَتَوُا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَاسْتَأْذَنُوهُ فِي الْكُحْلِ ، وَذَكَرُوا أَنَّهُمْ يَخْشَوْنَ عَلَى عَيْنِهَا ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قَدْ كَانَتْ إِحْدَاكُنَّ تَمْكُثُ فِي بَيْتِهَا حَوْلًا ، فَإِذَا كَانَ حَوْلًا رَمَتْ بِبَعْرَةٍ أَفَلَا أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا ؟  .","","Al-Mu'jam al-Kabir 813","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن حميد بن نافع حميد صفيرا عن شعبة بن الحجاج عن عاصم بن علي الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","حميد بن نافع عن زينب عن أم سلمة"
"21412","814  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو عُبَيْدٍ الْقَاسِمُ بْنُ سَلَّامٍ ،  ثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ ،  عَنْ  شُعْبَةَ ،  عَنْ  عَاصِمِ بْنِ سُلَيْمَانَ ،  عَنْ  حَفْصَةَ بِنْتِ سِيرِينَ ، قَالَتْ :  كَتَبَ  حُمَيْدُ بْنُ نَافِعٍ إِلَى  حُمَيْدٍ الْحِمْيَرِيِّ  فَذَكَرَ حَدِيثَ زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ، قَالَ  شُعْبَةُ  : فَقُلْتُ  لِعَاصِمٍ  : قَدْ سَمِعْتُ أَنَا مِنْ  حُمَيْدٍ  ، قَالَ : أَنْتَ قُلْتُ : نَعَمْ ، قَالَ : وَكَانَ  عَاصِمٌ  يَرَى أَنَّهُ قَدْ مَاتَ مُنْذُ مِائَةِ سَنَةٍ "" .  ""  لَمْ يَرْوِهِ عَنْ  شُعْبَةَ  إِلَّا  حَجَّاجٌ  ، وَلَا رَوَاهُ عَنْهُ إِلَّا  أَبُو عُبَيْدٍ  ،  وَأَحْمَدُ بْنُ حَنْبَلٍ  "" (  ح  ) .         [23/349]","","Al-Mu'jam al-Kabir 814","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن حميد بن نافع حميد صفيرا عن حفصة بنت سيرين عن عاصم بن سليمان الأحول عن شعبة بن الحجاج عن حجاج بن محمد الأعور عن أبو عبيد القاسم بن سلام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","حميد بن نافع عن زينب عن أم سلمة"
"21413","815  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ .  وَقَالَ :  وَحَدَّثَنَا  أَحْمَدُ بْنُ يُونُسَ ، قَالَ :  ثَنَا  زُهَيْرٌ ،  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  حُمَيْدِ بْنِ نَافِعٍ ،  عَنْ  زَيْنَبَ ،  عَنْ  أُمِّ سَلَمَةَ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَحْوَ حَدِيثِ  شُعْبَةَ  ، عَنْ  حُمَيْدِ بْنِ نَافِعٍ  .","","Al-Mu'jam al-Kabir 815","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن حميد بن نافع حميد صفيرا عن يحيى بن سعيد الأنصاري عن زهير بن معاوية بن حديج عن أحمد بن عبد الله اليربوعي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","حميد بن نافع عن زينب عن أم سلمة"
"21414","816  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  ابْنُ أَبِي عُمَرَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَيُّوبَ بْنِ مُوسَى ،  عَنْ  حُمَيْدِ بْنِ نَافِعٍ ،  عَنْ  زَيْنَبَ ،  عَنْ  أُمِّ سَلَمَةَ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 816","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن حميد بن نافع حميد صفيرا عن أيوب بن موسى الأموي عن سفيان بن عيينة عن ابن أبي عمر العدني عن الحسين بن إسحاق التستري عن الطبراني","حميد بن نافع عن زينب عن أم سلمة"
"21415","817  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  حُمَيْدِ بْنِ نَافِعٍ ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ، أَنَّهَا  سَمِعَتْ  أُمَّ حَبِيبَةَ ، وَأُمَّ سَلَمَةَ  ، تَذْكُرَانِ  أَنَّ  امْرَأَةً  أَتَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرَتْ أَنَّ ابْنَةً لَهَا تُوُفِّيَ عَنْهَا زَوْجُهَا فَاشْتَكَتْ عَيْنَيْهَا وَهِيَ تُرِيدُ أَنْ تَكْحُلَهَا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قَدْ كَانَتْ إِحْدَاكُنَّ تَرْمِي بِالْبَعْرَةِ عِنْدَ رَأْسِ الْحَوْلِ  ، وَإِنَّمَا هِيَ أَرْبَعَةُ أَشْهُرٍ وَعَشْرًا  .","","Al-Mu'jam al-Kabir 817","","رملة بنت أبي سفيان زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن حميد بن نافع حميد صفيرا عن يحيى بن سعيد الأنصاري عن يزيد بن هارون عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","حميد بن نافع عن زينب عن أم سلمة"
"21416","الْقَاسِمُ بْنُ مُحَمَّدٍ  عَنْ  زَيْنَبَ  .  818  -  حَدَّثَنَا  الْحَسَنُ بْنُ غُلَيْبٍ الْمِصْرِيُّ ،  ثَنَا  عِمْرَانُ بْنُ هَارُونَ الرَّمْلِيُّ ، (  ح  ) .  وَحَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  أَحْمَدُ بْنُ سَعِيدٍ الْهَمْدَانِيُّ ،  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  ابْنُ لَهِيعَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ  أَنَّهُ ، سَمِعَ  الْقَاسِمَ بْنَ مُحَمَّدٍ  يُحَدِّثُ ، عَنْ  زَيْنَبَ ، أَنَّ أُمَّ سَلَمَةَ  أَخْبَرَتْهَا  ،  أَنَّ  بِنْتَ نُعَيْمِ بْنِ عَبْدِ اللهِ الْعَدَوِيِّ  أَتَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ : إِنَّ ابْنَتِي تُوُفِّيَ عَنْهَا زَوْجُهَا ،         [23/350]      وَكَانَتْ تَحْتَ  الْمُغِيرَةِ الْمَخْزُومِيِّ  ، وَهِيَ  تُحِدُّ  وَهِيَ تَشْتَكِي عَيْنَيْهَا أَفَتَكْتَحِلُ ؟ قَالَ : "" لَا "" ، ثُمَّ صَمَتَتْ سَاعَةً ، ثُمَّ قَالَتْ : إِنَّهَا تَشْتَكِي عَيْنَيْهَا فَوْقَ مَا نَظُنُّ أَفَتَكْتَحِلُ ؟ قَالَ : "" لَا "" ، ثُمَّ قَالَ :  لَا يَحِلُّ لِمُسْلِمَةٍ أَنْ  تُحِدَّ  فَوْقَ ثَلَاثَةِ أَيَّامٍ إِلَّا عَلَى زَوْجٍ أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا  .","","Al-Mu'jam al-Kabir 818","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن القاسم بن محمد بن أبي بكر الصديق عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن عبد الله بن وهب المصري عن أحمد بن سعيد بن بشر الهمداني عن الساجي عن الطبراني","القاسم بن محمد عن زينب"
"21417","أَبُو قِلَابَةَ عَبْدُ اللهِ بْنُ زَيْدٍ  عَنْ  زَيْنَبَ  عَنْ  أُمِّ سَلَمَةَ  .  819  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُعَلَّى بْنُ أَسَدٍ الْعَمِّيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ الْمُخْتَارِ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  زَيْنَبَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  كَانَ فِرَاشِي حِيَالَ مُصَلَّى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  .","","Al-Mu'jam al-Kabir 819","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو قلابة الجرمي عن خالد الحذاء عن عبد العزيز بن المختار الدباغ عن معلى بن أسد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو قلابة عبد الله بن زيد عن زينب عن أم سلمة"
"21418","820  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدٌ ،  عَنْ  خَالِدٍ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  زَيْنَبَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  كَانَ فِرَاشِي حِيَالَ مُصَلَّى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  .","","Al-Mu'jam al-Kabir 820","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو قلابة الجرمي عن خالد الحذاء عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","أبو قلابة عبد الله بن زيد عن زينب عن أم سلمة"
"21419","[23/351]      821  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ، قَالَا :  ثَنَا  ابْنُ وَهْبٍ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" يُصَلِّي عَلَى  الْخُمْرَةِ  "" .","","Al-Mu'jam al-Kabir 821","","زينب بنت أبي سلمة المخزومية عن أبو قلابة الجرمي عن خالد الحذاء عن عبد الله بن وهب المصري عن عبد الأعلى بن حماد النرسي عن الحسين بن إسحاق التستري عن الطبراني","أبو قلابة عبد الله بن زيد عن زينب عن أم سلمة"
"21420","822  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَسْعُودٍ الْمَقْدِسِيُّ ،  ثَنَا  الْهَيْثَمُ بْنُ جَمِيلٍ ، (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ السَّرِيِّ بْنِ مِهْرَانَ ،  ثَنَا  بَشَّارُ بْنُ مُوسَى ، قَالَا :  ثَنَا  شَرِيكٌ ،  عَنْ  عَاصِمٍ الْأَحْوَلِ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  زَيْنَبَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" يُصَلِّي عَلَى الْحَصِيرِ  "" .","","Al-Mu'jam al-Kabir 822","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو قلابة الجرمي عن عاصم بن سليمان الأحول عن شريك بن عبد الله النخعي عن بشار بن موسى الشيباني عن محمد بن السري بن مهران الناقد عن الطبراني","أبو قلابة عبد الله بن زيد عن زينب عن أم سلمة"
"21421","عَلِيُّ بْنُ الْحُسَيْنِ  عَنْ  زَيْنَبَ  عَنْ  أُمِّ سَلَمَةَ  .  823  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُحَمَّدُ بْنُ سَعِيدٍ الْأَصْبَهَانِيُّ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  ثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَلِيِّ بْنِ حُسَيْنٍ ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَعَرَّضَ كَتِفًا ثُمَّ صَلَّى وَلَمْ يَتَوَضَّأْ  .","","Al-Mu'jam al-Kabir 823","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن علي بن الحسين زين العابدين عن أبو جعفر الباقر عن جعفر الصادق عن حفص بن غياث النخعي عن محمد بن سعيد حمدان عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","علي بن الحسين عن زينب عن أم سلمة"
"21422","824  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا         [23/352]      حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَلِيِّ بْنِ الْحُسَيْنِ ،  عَنْ  زَيْنَبَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  أُتِيَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِكَتِفِ شَاةٍ فَأَكَلَ مِنْهَا فَصَلَّى وَلَمْ يَمَسَّ مَاءً  "" .","","Al-Mu'jam al-Kabir 824","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن علي بن الحسين زين العابدين عن أبو جعفر الباقر عن جعفر الصادق عن حاتم بن إسماعيل الحارثي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","علي بن الحسين عن زينب عن أم سلمة"
"21423","عَاصِمٌ مَوْلَى بَنِي جُمَحَ  عَنْ  زَيْنَبَ  عَنْ  أُمِّ سَلَمَةَ  .  825  -  حَدَّثَنَا  أَبُو يَحْيَى الرَّازِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  جُنَادَةُ ،  عَنْ  عُبَيْدِ اللهِ ،  عَنْ  عَاصِمٍ مَوْلَى بَنِي جُمَحَ ،  عَنْ  أُمِّ سَلَمَةَ ، أَوْ  عَنْ  زَيْنَبَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  أَمَرَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ نَدْعُوَ وَنَقُولَ :  اللَّهُمَّ أَنْتَ الْأَوَّلُ فَلَا شَيْءَ قَبْلَكَ وَأَنْتَ الْآخِرُ فَلَا شَيْءَ بَعْدَكَ  ، أَعُوذُ بِكَ مِنْ شَرِّ كُلِّ دَابَّةٍ نَاصِيَتُهَا بِيَدِكَ ، وَأَعُوذُ بِكَ مِنَ الْإِثْمِ وَالْكَسَلِ ، وَعَذَابِ النَّارِ وَعَذَابِ الْقَبْرِ وَفِتْنَةِ الْغِنَى وَفِتْنَةِ الْفَقْرِ ، وَأَعُوذُ بِكَ مِنَ  الْمَأْثَمِ  وَالْمَغْرَمِ ،  اللَّهُمَّ نَقِّ قَلْبِي مِنَ  الْمَأْثَمِ  كَمَا يُنَقَّى الثَّوْبُ الْأَبْيَضُ مِنَ الدَّنَسِ ، وَبَاعِدْ بَيْنِي وَبَيْنَ خَطِيئَتِي كَمَا بَاعَدْتَ بَيْنَ الْمَشْرِقِ وَالْمَغْرِبِ  .","","Al-Mu'jam al-Kabir 825","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عاصم مولى بني جمح عن عبيد الله بن عمر العمري عن جنادة بن سلم العامري عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","عاصم مولى بني جمح عن زينب عن أم سلمة"
"21424","أُمُّ كُلْثُومٍ بِنْتُ أُمِّ سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  826  -  حَدَّثَنَا  أَبُو زُرْعَةَ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُبَارَكِ ، (  ح  ) .         [23/353]      وَحَدَّثَنَا  الْعَلَّافُ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ، (  ح  ) .  وَحَدَّثَنَا  عَبْدُ الْمَلِكِ بْنُ يَحْيَى بْنِ بُكَيْرٍ ،  ثَنَا  أَبِي  ، (  ح  ) .  وَحَدَّثَنَا  أَحْمَدُ بْنُ سَهْلٍ الْأَهْوَازِيُّ ،  ثَنَا  كَثِيرُ بْنُ يَحْيَى صَاحِبُ الْبَصْرِيِّ ، قَالُوا :  ثَنَا  مُسْلِمُ بْنُ خَالِدٍ الزَّنْجِيُّ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  أُمِّهِ [  عَنْ  ]  أُمِّ كُلْثُومٍ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  لَمَّا دَخَلَ بِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  يَا  أُمَّ سَلَمَةَ  إِنِّي قَدْ أَهْدَيْتُ  لِلنَّجَاشِيِّ  مِسْكًا  وَحُلَّةً  وَلَا أُرَاهُ إِلَّا قَدْ مَاتَ  ، وَلَا أَرَى هَدِيَّتِي إِلَّا سَتُرَدُّ إِلَيَّ "" ، قَالَتْ : وَكَانَ كَمَا قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَعْطَاهُ نِسَاءَهُ أُوقِيَّةً أُوقِيَّةً ، وَأَعْطَانِي سَائِرَ الْمِسْكِ  وَالْحُلَّةَ  .  سقط من طبعة مكتبة ابن تيمية ، والمثبت من نسخة كوبرلي .","","Al-Mu'jam al-Kabir 826","","هند بنت أبي أمية زوج رسول الله عن أم كلثوم بنت أبي سلمة ربيبة رسول الله صلى الله عليه وسلم عن أم موسى بن عقبة عن موسى بن عقبة عن مسلم بن خالد الزنجي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","أم كلثوم بنت أم سلمة عن أم سلمة"
"21425","827  -  حَدَّثَنَا  أَبُو يَحْيَى الرَّازِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  جُنَادَةُ بْنُ سَالمٍ  ،  عَنْ  عُبَيْدِ اللهِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ كُلْثُومٍ بِنْتِ زَيْنَبَ ،  عَنْ  أُمِّ سَلَمَةَ أَنَّهَا قَالَتْ :  لَمَّا مَاتَ  أَبُو سَلَمَةَ  وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِنْدَهُ قُمْتُ أُرِيدُ الْبُكَاءَ عَلَيْهِ ، فَقَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" فَاعِلَةٌ         [23/354]      مَاذَا ؟ "" ، فَقُلْتُ : يَا رَسُولَ اللهِ أَبْكِي عَلَى  أَبِي سَلَمَةَ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَفْعَلِي فَإِنَّ لِأَهْلِ الْمَيِّتِ عِنْدَ مَوْتِ مَيِّتِهِمْ مَا دَعَوْا بِهِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( جنادة بن سلم )","","Al-Mu'jam al-Kabir 827","","هند بنت أبي أمية زوج رسول الله عن أم كلثوم بنت أبي سلمة ربيبة رسول الله صلى الله عليه وسلم عن أم عبيد الله بن عمر العمري عن عبيد الله بن عمر العمري عن جنادة بن سلم العامري عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","أم كلثوم بنت أم سلمة عن أم سلمة"
"21426","828  -  حَدَّثَنَا  الْخَلَّالُ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  أُمِّ كُلْثُومٍ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ،  أَنَّهَا قَالَتْ : يَا رَسُولَ اللهِ أَبْكِي عَلَى  أَبِي سَلَمَةَ  ؟ فَقَالَ :  لَا تَفْعَلِي ، فَإِنَّ لِأَهْلِ الْمَيِّتِ عِنْدَ مَيِّتِهِمْ مَا دَعَوْا بِهِ  .","","Al-Mu'jam al-Kabir 828","","هند بنت أبي أمية زوج رسول الله عن أم كلثوم بنت أبي سلمة ربيبة رسول الله صلى الله عليه وسلم عن موسى بن عقبة عن عبد العزيز بن محمد الدراوردي عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","أم كلثوم بنت أم سلمة عن أم سلمة"
"21427","829  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  أُمِّ كُلْثُومٍ بِنْتِ أَبِي سَلَمَةَ بْنِ عَبْدِ الْأَسَدِ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  لَمَّا تُوُفِّيَ  أَبُو سَلَمَةَ  تَهَيَّأْتُ أَنْ أَبْكِيَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" فَاعِلَةٌ مَاذَا ؟ "" ، قُلْتُ : يَا رَسُولَ اللهِ  أَبُو سَلَمَةَ  أَبْكِي عَلَيْهِ ، فَقَالَ :  لَا تَفْعَلِي ، فَإِنَّ لِأَهْلِ الْمَيِّتِ عِنْدَ مَيِّتِهِمْ مَا دَعَوْا بِهِ  .","","Al-Mu'jam al-Kabir 829","","هند بنت أبي أمية زوج رسول الله عن أم كلثوم بنت أبي سلمة ربيبة رسول الله صلى الله عليه وسلم عن موسى بن عقبة عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","أم كلثوم بنت أم سلمة عن أم سلمة"
"21428","830  -  حَدَّثَنَا  ابْنُ أَبِي شَيْبَةَ ،  ثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  ثَنَا  طَلْحَةُ بْنُ يَحْيَى ،  عَنْ  أُمِّ كُلْثُومٍ بِنْتِ عَبْدِ اللهِ بْنِ زَمْعَةَ ،  أَنَّ  جَدَّتَهَا أُمَّ سَلَمَةَ زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  دَفَعَتْ إِلَيْهَا  مِخْضَبًا  مِنْ صُفْرٍ ، قَالَتْ : "" كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَغْتَسِلُ فِيهِ  . قَالَ  طَلْحَةُ  : وَكَانَ نَحْوًا مِنْ صَاعٍ أَوْ أَقَلَّ  .","","Al-Mu'jam al-Kabir 830","","هند بنت أبي أمية زوج رسول الله عن أم كلثوم بنت عبد الله بن زمعة عن طلحة بن يحيى بن طلحة التيمي عن عقبة بن مكرم بن عقبة الكوفي عن محمد بن عثمان بن أبي شيبة عن الطبراني","أم كلثوم بنت أم سلمة عن أم سلمة"
"21429","[23/355]      831  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  هِنْدَ بِنْتِ الْحَارِثِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" إِذَا سَلَّمَ مَكَثَ قَلِيلًا  .","","Al-Mu'jam al-Kabir 831","","هند بنت أبي أمية زوج رسول الله عن هند بنت الحارث الفراسية عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","أم كلثوم بنت أم سلمة عن أم سلمة"
"21430","832  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  هِنْدَ بِنْتِ الْحَارِثِ ،  عَنْ  أُمِّ سَلَمَةَ : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ "" إِذَا سَلَّمَ مَكَثَ فِي مَكَانِهِ يَسِيرًا  .","","Al-Mu'jam al-Kabir 832","","هند بنت أبي أمية زوج رسول الله عن هند بنت الحارث الفراسية عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن عاصم بن علي الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أم كلثوم بنت أم سلمة عن أم سلمة"
"21431","833  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْخَلَّالُ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ، وَعَمْرُو بْنُ دِينَارٍ ، وَمَعْمَرُ بْنُ رَاشِدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  هِنْدَ بِنْتِ الْحَارِثِ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَظَرَ ذَاتَ لَيْلَةٍ إِلَى السَّمَاءِ ، فَقَالَ :  سُبْحَانَ اللهِ مَاذَا أُنْزِلَ اللَّيْلَةَ مِنَ الْفِتَنِ ؟ أَوْ مَاذَا فُتِحَ مِنَ الْخَزَائِنِ ؟  أَيْقَظْنَ صَوَاحِبَ الْحُجَرِ ، فَلَرُبَّ  كَاسِيَةٍ  فِي الدُّنْيَا عَارِيَةٌ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 833","","هند بنت أبي أمية زوج رسول الله عن هند بنت الحارث الفراسية عن الزهري عن معمر بن راشد عن سفيان بن عيينة عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","أم كلثوم بنت أم سلمة عن أم سلمة"
"21432","834  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  هِنْدَ بِنْتِ الْحَارِثِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كُنَّ نِسَاءً يَشْهَدْنَ         [23/356]      مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَاةَ الصُّبْحِ ، فَيَنْصَرِفْنَ  مُتَلَفِّعَاتٍ  فِي  مُرُوطِهِنَّ  مَا يُعْرَفْنَ مِنَ  الْغَلَسِ  .","","Al-Mu'jam al-Kabir 834","","هند بنت أبي أمية زوج رسول الله عن هند بنت الحارث الفراسية عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","أم كلثوم بنت أم سلمة عن أم سلمة"
"21433","هِنْدُ بِنْتُ الْحَارِثِ  عَنْ  أُمِّ سَلَمَةَ  .  835  -  حَدَّثَنَا  الْخَلَّالُ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي عُمَرَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  هِنْدَ بِنْتِ الْحَارِثِ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ ذَاتَ لَيْلَةٍ :  سُبْحَانَ اللهِ مَاذَا أُنْزِلَ مِنَ الْفِتَنِ ؟ مَا فُتِحَ مِنَ الْخَزَائِنِ ؟  أَيْقَظْنَ صَوَاحِبَاتِ الْحُجَرِ ، فَرُبَّ  كَاسِيَةٍ  فِي الدُّنْيَا عَارِيَةٌ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 835","","هند بنت أبي أمية زوج رسول الله عن هند بنت الحارث الفراسية عن الزهري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن ابن أبي عمر العدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","هند بنت الحارث عن أم سلمة"
"21434","836  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  هِنْدَ بِنْتِ الْحَارِثِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتِ :  اسْتَيْقَظَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ لَيْلَةٍ وَهُوَ ، يَقُولُ :  لَا إِلَهَ إِلَّا اللهُ مَا فُتِحَ اللَّيْلَةَ مِنَ الْخَزَائِنِ ؟ لَا إِلَهَ إِلَّا اللهُ مَا أُنْزِلَ اللَّيْلَةَ مِنَ الْفِتْنَةِ ؟  مَنْ يُوقِظُ صَوَاحِبَ الْحُجْرَةِ ، يَا رُبَّ  كَاسِيَةٍ  فِي الدُّنْيَا عَارِيَةٌ فِي الْآخِرَةِ  .","","Al-Mu'jam al-Kabir 836","","هند بنت أبي أمية زوج رسول الله عن هند بنت الحارث الفراسية عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","هند بنت الحارث عن أم سلمة"
"21435","صَفِيَّةُ بِنْتُ شَيْبَةَ  عَنْ  أُمِّ سَلَمَةَ  .  837  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنِ  ابْنِ خَيْثَمٍ ،  عَنْ  صَفِيَّةَ بِنْتِ شَيْبَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  لَمَّا قَدِمَ  الْمُهَاجِرُونَ  الْمَدِينَةَ  أَرَادُوا أَنْ يَأْتُوا النِّسَاءَ فِي أَدْبَارِهِنَّ فِي  فُرُوجَهُنَّ  فَأَنْكَرْنَ ذَلِكَ ، فَجِئْنَ إِلَى  أُمِّ سَلَمَةَ  فَذَكَرْنَ لَهَا ذَلِكَ فَسَأَلَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :         {      نِسَاؤُكُمْ حَرْثٌ لَكُمْ فَأْتُوا حَرْثَكُمْ أَنَّى شِئْتُمْ         }      صِمَامًا  وَاحِدًا  .","","Al-Mu'jam al-Kabir 837","","هند بنت أبي أمية زوج رسول الله عن صفية بنت شيبة الحجبية عن عبد الله بن عثمان بن خثيم عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","صفية بنت شيبة عن أم سلمة"
"21436","[23/357]      838  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ ، قَالَا :  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  أَبُو أُسَامَةَ ،  ثَنَا  سُفْيَانُ ،  أَخْبَرَنِي  مَعْمَرٌ ،  عَنْ  بُدَيْلِ بْنِ مَيْسَرَةَ ،  عَنِ  الْحَسَنِ بْنِ مُسْلِمِ بْنِ يَنَّاقٍ ،  عَنْ  صَفِيَّةَ بِنْتِ شَيْبَةَ ،  عَنْ  أُمِّ سَلَمَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تُخَضِّبِ الْمُتَوَفَّاةُ زَوْجُهَا ، وَلَا تَكْتَحِلْ  ، وَلَا تَطَيَّبْ ، وَلَا تَلْبَسْ ثَوْبًا مَصْبُوغًا ، وَلَا تَلْبَسْ حُلِيًّا  .","","Al-Mu'jam al-Kabir 838","","هند بنت أبي أمية زوج رسول الله عن صفية بنت شيبة الحجبية عن الحسن بن مسلم بن يناق عن بديل بن ميسرة العقيلي عن معمر بن راشد عن سفيان الثوري عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن الحسين بن إسحاق التستري عن الطبراني","صفية بنت شيبة عن أم سلمة"
"21437","أُمُّ حَبِيبَةَ بِنْتُ كَيْسَانَ  عَنْ  أُمِّ سَلَمَةَ  .  839  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عَمْرُو بْنُ هِشَامٍ الْحَرَّانِيُّ ،  ثَنَا  عُثْمَانُ ،  عَنِ  الْقَاسِمِ بْنِ مُسْلِمٍ الْهَاشِمِيِّ ،  عَنْ  أُمِّ حَبِيبَةَ بِنْتِ كَيْسَانَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  أُنْزِلَتْ هَذِهِ الْآيَةُ         {      إِنَّمَا يُرِيدُ اللهُ لِيُذْهِبَ عَنْكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ         }      ، وَأَنَا فِي بَيْتِي ، فَدَعَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْحَسَنَ  وَالْحُسَيْنَ  ، فَأَجْلَسَ أَحَدَهُمَا عَلَى فَخِذِهِ الْيُمْنَى ، وَالْآخَرَ عَلَى فَخِذِهِ الْيُسْرَى ، وَأَلْقَتْ عَلَيْهِمْ  فَاطِمَةُ  كِسَاءً ،  فَلَمَّا أُنْزِلَتْ         {      إِنَّمَا يُرِيدُ اللهُ لِيُذْهِبَ عَنْكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ         }      ، قُلْتُ : وَأَنَا مَعَكُمْ يَا رَسُولَ اللهِ ؟ قَالَ : "" وَأَنْتِ مَعَنَا  .","","Al-Mu'jam al-Kabir 839","","هند بنت أبي أمية زوج رسول الله عن أم حبيبة بنت كيسان عن القاسم بن مسلم الهاشمي عن عثمان بن عبد الرحمن الطرائفي عن عمرو بن هشام بن بزين الحراني عن الحسين بن إسحاق التستري عن الطبراني","أم حبيبة بنت كيسان عن أم سلمة"
"21438","[23/358]      مَا رَوَتْ  صَفِيَّةُ بِنْتُ أَبِي عُبَيْدٍ  عَنْ  أُمِّ سَلَمَةَ  .  840  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  يَعْلَى بْنُ عُبَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  نَافِعٍ ،  عَنْ  صَفِيَّةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  سَأَلْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ ذُيُولِ النِّسَاءِ ، فَقَالَ : "" شِبْرٌ  ، فَقُلْتُ إِذًا تَخْرُجُ أَقْدَامُهُنَّ ؟ قَالَ : "" فَذِرَاعٌ  .","","Al-Mu'jam al-Kabir 840","","هند بنت أبي أمية زوج رسول الله عن صفية بنت أبي عبيد زوج عبد الله بن عمر عن نافع مولى ابن عمر عن محمد بن إسحاق عن يعلى بن عبيد الطنافسي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","ما روت صفية بنت أبي عبيد عن أم سلمة"
"21439","841  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عِقَالٍ الْحَرَّانِيُّ ،  ثَنَا  النُّفَيْلِيُّ ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عَمْرُو بْنُ هِشَامٍ الْحَرَّانِيُّ ، [ قَالَا ] :  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  نَافِعٍ ،  عَنْ  صَفِيَّةَ بِنْتِ أَبِي عُبَيْدٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ شَرِبَ فِي إِنَاءِ ذَهَبٍ أَوْ فِضَّةٍ فَإِنَّمَا  يُجَرْجِرُ  فِي بَطْنِهِ نَارَ  جَهَنَّمَ  .","","Al-Mu'jam al-Kabir 841","","هند بنت أبي أمية زوج رسول الله عن صفية بنت أبي عبيد زوج عبد الله بن عمر عن نافع مولى ابن عمر عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن عمرو بن هشام بن بزين الحراني عن الحسين بن إسحاق التستري عن الطبراني","ما روت صفية بنت أبي عبيد عن أم سلمة"
"21440","842  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَعْلَى بْنُ عُبَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  نَافِعٍ ،  عَنْ  صَفِيَّةَ بِنْتِ أَبِي عُبَيْدٍ ،  عَنْ  عَائِشَةَ ، وَأُمِّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا يَحِلُّ لِامْرَأَةٍ تُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ أَنْ  تُحِدَّ  عَلَى مَيِّتٍ فَوْقَ ثَلَاثٍ  إِلَّا عَلَى زَوْجِهَا  .","","Al-Mu'jam al-Kabir 842","","هند بنت أبي أمية زوج رسول الله عن صفية بنت أبي عبيد زوج عبد الله بن عمر عن نافع مولى ابن عمر عن محمد بن إسحاق عن يعلى بن عبيد الطنافسي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","ما روت صفية بنت أبي عبيد عن أم سلمة"
"21441","843  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  عَيَّاشٌ الرَّقَّامُ ،  ثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  نَافِعٍ ،  عَنْ  صَفِيَّةَ بِنْتِ أَبِي عُبَيْدٍ ،         [23/359]      عَنْ  أُمِّ سَلَمَةَ ، وَعَائِشَةَ ، أَنَّهُمَا سَمِعَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا يَحِلُّ لِامْرَأَةٍ تُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ أَنْ  تُحِدَّ  عَلَى مَيِّتٍ فَوْقَ ثَلَاثٍ  إِلَّا عَلَى زَوْجِهَا  .","","Al-Mu'jam al-Kabir 843","","عائشة بنت أبي بكر الصديق عن صفية بنت أبي عبيد زوج عبد الله بن عمر عن نافع مولى ابن عمر عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن عياش بن الوليد الرقام عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","ما روت صفية بنت أبي عبيد عن أم سلمة"
"21442","844  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ السِّرَاجُ  ، حَدَّثَنَا  يَحْيَى بْنُ أَبِي طَالِبٍ ،  ثَنَا  عَبْدُ الْوَهَّابِ ،  ثَنَا  سَعِيدٌ ،  عَنْ  أَيُّوبَ ،  عَنْ  نَافِعٍ ،  عَنْ  صَفِيَّةَ بِنْتِ أَبِي عُبَيْدٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  الَّذِي يَشْرَبُ فِي آنِيَةِ الْفِضَّةِ ، إِنَّمَا  يُجَرْجِرُ  فِي بَطْنِهِ نَارَ  جَهَنَّمَ  .","","Al-Mu'jam al-Kabir 844","","هند بنت أبي أمية زوج رسول الله عن صفية بنت أبي عبيد زوج عبد الله بن عمر عن نافع مولى ابن عمر عن أيوب السختياني عن سعيد بن أبي عروبة عن عبد الوهاب بن عطاء الخفاف عن يحيى بن أبي طالب البغدادي عن الحسن بن علي السراج عن الطبراني","ما روت صفية بنت أبي عبيد عن أم سلمة"
"21443","أُمُّ وَلَدِ إِبْرَاهِيمَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  عَنْ  أُمِّ سَلَمَةَ  .  845  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ ،  عَنْ  مُحَمَّدِ بْنِ عُمَارَةَ بْنِ حَزْمٍ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ بْنِ الْحَارِثِ التَّيْمِيِّ ،  عَنْ  أُمِّ وَلَدٍ لِإِبْرَاهِيمَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ،  عَنْ  أُمِّ سَلَمَةَ  أَنَّهَا سَأَلَتْهَا ، فَقَالَتْ : إِنِّي امْرَأَةٌ أُطِيلُ ذَيْلِي ، وَأَمْشِي فِي الْمَكَانِ الْقَذِرِ ، فَقَالَتْ  أُمُّ سَلَمَةَ  : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يُطَهِّرُهُ  مَا بَعْدَهُ  .","","Al-Mu'jam al-Kabir 845","","هند بنت أبي أمية زوج رسول الله عن أم ولد عبد الرحمن بن عوف عن محمد بن إبراهيم بن الحارث التيمي عن محمد بن عمارة بن عمرو بن حزم عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أم ولد إبراهيم بن عبد الرحمن بن عوف عن أم سلمة"
"21444","846  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  مُحَمَّدِ بْنِ عُمَارَةَ التَّيْمِيِّ ،  عَنْ  أُمِّ وَلَدِ إِبْرَاهِيمَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 846","","هند بنت أبي أمية زوج رسول الله عن أم ولد عبد الرحمن بن عوف عن محمد بن عمارة بن عمرو بن حزم عن عبد الله بن إدريس الأودي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أم ولد إبراهيم بن عبد الرحمن بن عوف عن أم سلمة"
"21445","[23/360]      عَمْرَةُ بِنْتُ عَبْدِ الرَّحْمَنِ  عَنْ  أُمِّ سَلَمَةَ  .  847  -  حَدَّثَنَا  طَالِبُ بْنُ قُرَّةَ الْأَذَنِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عِيسَى الطَّبَّاعُ ، (  ح  ) .  وَحَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ، وَمَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ، قَالَا :  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ ، قَالَا :  ثَنَا  فَرَجُ بْنُ فَضَالَةَ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  عَمْرَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَتْ لَنَا شَاةٌ نَحْلُبُهَا فَفَقَدَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  مَا فَعَلَتْ شَاتُكُمْ ؟ "" ، قَالُوا : مَاتَتْ ، قَالَ : "" مَا فَعَلْتُمْ بِإِهَابِهَا ؟  ، قَالُوا : يَا رَسُولَ اللهِ أَلْقَيْنَاهُ ، قَالَ : "" أَفَلَا انْتَفَعْتُمْ بِهِ ؟ فَإِنَّ دِبَاغَهَا ذَكَاتُهَا يُحِلُّ كَمَا يُحِلُّ الْخَلُّ مِنَ الْخَمْرِ  .","","Al-Mu'jam al-Kabir 847","","هند بنت أبي أمية زوج رسول الله عن عمرة بنت عبد الرحمن الأنصارية عن يحيى بن سعيد الأنصاري عن فرج بن فضالة بن النعمان التنوخي عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","عمرة بنت عبد الرحمن عن أم سلمة"
"21446","848  -  حَدَّثَنَا  عَبْدُ الْمَلِكِ بْنُ يَحْيَى بْنِ بُكَيْرٍ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يُونُسَ بْنِ يَزِيدَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَمْرَةَ بِنْتِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أُمِّ سَلَمَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ :  كَانَ بِحُجْرَةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صِيَاحٌ فَخَرَجَ فِي رِدَاءٍ مُتَوَشِّحًا ، فَقَالَ : "" مَا هَؤُلَاءِ ؟ "" ، قَالُوا : يَخْتَصِمُونَ يَا رَسُولَ اللهِ ، فَقَضَى بَيْنَهُمْ نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ قَالَ :  إِنِّي لَأَقْضِي بَيْنَكُمْ ، وَلَعَلَّ أَحَدَكُمْ أَنْ يَكُونَ أَبْلَغَ مِنْ أَخِيهِ         [23/361]      فِي الْكَلَامِ  ، فَأَقْضِي لَهُ بِمَا أَسْتَبِينُ فَمَنْ قَضَيْتُ لَهُ شَيْئًا لَيْسَ لَهُ فَإِنَّمَا أُعْطِيهِ حَدَّهُ مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 848","","هند بنت أبي أمية زوج رسول الله عن عمرة بنت عبد الرحمن الأنصارية عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن لهيعة عن يحيى بن عبد الله بن بكير المخزومي عن عبد الملك بن يحيى المخزومي عن الطبراني","عمرة بنت عبد الرحمن عن أم سلمة"
"21447","حُكَيْمَةُ  عَنْ  أُمِّ سَلَمَةَ  .  849  -  حَدَّثَنَا  عَبْدُ الْمَلِكِ بْنُ يَحْيَى ،  ثَنَا  أَبِي  ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عُثْمَانَ ،  عَنْ  يَحْيَى بْنِ أَبِي سُفْيَانَ ،  عَنْ  جَدَّتِهِ حُكَيْمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَهَلَّ مِنْ  بَيْتِ الْمَقْدِسِ  غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ  .","","Al-Mu'jam al-Kabir 849","","هند بنت أبي أمية زوج رسول الله عن حكيمة بنت أمية بن الأخنس عن يحيى بن أبي سفيان الأخنسي عن عبد الله بن عبد الرحمن بن يحنس الحجازي عن عبد العزيز بن محمد الدراوردي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","حكيمة عن أم سلمة"
"21448","[23/362]      رُمَيْثَةُ  عَنْ  أُمِّ سَلَمَةَ  .  850  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عَوْفِ بْنِ الْحَارِثِ ،  عَنْ  رُمَيْثَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  قَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا  أُمَّ سَلَمَةَ  لَا تُؤْذِينِي فِي  عَائِشَةَ  فَإِنَّ الْوَحْيَ لَمْ يَنْزِلْ عَلَيَّ وَمَعِيَ أَحَدٌ مِنْ نِسَائِي إِلَّا  عَائِشَةَ  ،  فَإِنَّ الْوَحْيَ نَزَلَ عَلَيَّ وَهِيَ مَعِي فِي لِحَافِي  .","","Al-Mu'jam al-Kabir 850","","هند بنت أبي أمية زوج رسول الله عن رميثة بنت الحارث بن الطفيل عن عوف بن الحارث بن الطفيل الأزدي عن هشام بن عروة بن الزبير عن علي بن مسهر القرشي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","رميثة عن أم سلمة"
"21449","أُمُّ مُحَمَّدِ بْنِ قَيْسٍ  عَنْ  أُمِّ سَلَمَةَ  .  851  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  وَكِيعٌ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ بَكْرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي حُجْرَةِ  أُمِّ سَلَمَةَ  ، فَمَرَّ ابْنُهَا  عُمَرُ  أَوْ  عَبْدُ اللهِ  بَيْنَ يَدَيْهِ ، فَقَالَ بِيَدِهِ هَكَذَا ، فَرَجَعَ  فَمَرَّتْ  زَيْنَبُ  ، فَقَالَ : بِيَدِهِ هَكَذَا ، فَمَضَتْ ، فَقَالَ : "" هُنَّ أَغْلَبُ  .","","Al-Mu'jam al-Kabir 851","","هند بنت أبي أمية زوج رسول الله عن أبيه عن محمد بن بكر عن أسامة بن زيد الليثي المدني عن وكيع بن الجراح عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","أم محمد بن قيس عن أم سلمة"
"21450","[23/363]      وَمِنْ  نِسَاءِ أَهْلِ الْبَصْرَةِ  عَنْ  أُمِّ سَلَمَةَ  .  أُمُّ الْحَسَنِ  عَنْ  أُمِّ سَلَمَةَ  الْحَسَنُ  عَنْ أُمِّهِ  852  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ ، وَعُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ، قَالُوا :  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَيُّوبَ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ فِي  عَمَّارٍ  :  تَقْتُلُهُ  الْفِئَةُ  الْبَاغِيَةُ  .","","Al-Mu'jam al-Kabir 852","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن أيوب السختياني عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن عثمان بن عمر الضبي عن الطبراني","الحسن عن أمه"
"21451","853  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ صَالِحٍ ،  ثَنَا  عُثْمَانُ بْنُ الْهَيْثَمِ ، (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  ثَنَا  هَوْذَةُ بْنُ خَلِيفَةَ ، قَالَا :  ثَنَا  عَوْفٌ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ فِي  عَمَّارٍ  :  تَقْتُلُهُ  الْفِئَةُ  الْبَاغِيَةُ  .","","Al-Mu'jam al-Kabir 853","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن عوف بن أبي جميلة عن هوذة بن خليفة البكراوي عن لحية الليف محمد بن العباس عن الطبراني","الحسن عن أمه"
"21452","854  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو عُبَيْدٍ ،  أَنَا  مُعَاذُ بْنُ مُعَاذٍ ، قَالَ :  ثَنَا  ابْنُ عَوْنٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  مَا نَسِيتُ  يَوْمَ الْخَنْدَقِ  أَثَرًا عِنْدَ صَدْرِهِ وَهُوَ يُعَاطِيهِمُ اللَّبَنَ ، وَيَقُولُ :  اللَّهُمَّ الْخَيْرُ خَيْرُ الْآخِرَةِ فَاغْفِرْ  لِلْأَنْصَارِ  وَالْمُهَاجِرَةِ  ، فَلَمَّا رَآهُ ،  يَعْنِي النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - قَالَ : "" يَا  ابْنَ سُمَيَّةَ  تَقْتُلُكَ  الْفِئَةُ  الْبَاغِيَةُ  .","","Al-Mu'jam al-Kabir 854","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن عبد الله بن عون بن أرطبان عن معاذ بن معاذ بن نصر عن أبو عبيد القاسم بن سلام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","الحسن عن أمه"
"21453","855  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عُلَيَّةَ ،  عَنِ  ابْنِ عَوْنٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَقْتُلُ  عَمَّارًا  الْفِئَةُ  الْبَاغِيَةُ  .","","Al-Mu'jam al-Kabir 855","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن عبد الله بن عون بن أرطبان عن إسماعيل ابن علية عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","الحسن عن أمه"
"21454","[23/364]      856  -  حَدَّثَنَا  عُمَرُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  أَبُو عَاصِمٍ ،  عَنْ  سَهْلٍ السَّرَّاجِ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَقْتُلُ  عَمَّارًا  الْفِئَةُ  الْبَاغِيَةُ  .","","Al-Mu'jam al-Kabir 856","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن سهل بن أبي الصلت العبسي عن أبو عاصم النبيل عن محمد بن إبراهيم بن مسلم السجستاني عن أبو الآذان البغدادي عن الطبراني","الحسن عن أمه"
"21455","857  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ، وَزَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  ثَنَا  أَبُو دَاوُدَ الطَّيَالِسِيُّ ،  عَنْ  شُعْبَةَ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَقْتُلُ  عَمَّارًا  الْفِئَةُ  الْبَاغِيَةُ  .","","Al-Mu'jam al-Kabir 857","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن يونس بن عبيد عن شعبة بن الحجاج عن أبو داود الطيالسي عن محمد بن بشار بندار عن الساجي عن الطبراني","الحسن عن أمه"
"21456","858  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ ،  ثَنَا  فَضْلُ بْنُ دَاوُدَ الْوَاسِطِيُّ ،  ثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَوْفٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 858","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن عوف بن أبي جميلة عن شعبة بن الحجاج عن عبد الصمد بن عبد الوارث التنوري عن الفضل بن داود الواسطي عن بحشل عن الطبراني","الحسن عن أمه"
"21457","859  -  حَدَّثَنَا  السَّاجِيُّ ،  ثَنَا  بُنْدَارٌ ،  ثَنَا  حَمَّادُ بْنُ مَسْعَدَةَ ،  عَنْ  مَيْمُونِ بْنِ مُوسَى الْمَرَئِيِّ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ "" يُصَلِّي بَعْدَ  الْوِتْرِ  رَكْعَتَيْنِ وَهُوَ جَالِسٌ  .","","Al-Mu'jam al-Kabir 859","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن ميمون بن موسى المرئي عن حماد بن مسعدة عن محمد بن بشار بندار عن الساجي عن الطبراني","الحسن عن أمه"
"21458","860  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ نَاجِيَةَ ، وَأَبُو جَعْفَرٍ مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ بَكْرٍ السَّرَّاجُ ، قَالَا :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  عَنْبَسَةُ ،  عَنْ  زَكَرِيَّا بْنِ حَكِيمٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ "" يُصَلِّي بَعْدَ  وِتْرِهِ  رَكْعَتَيْنِ وَهُوَ جَالِسٌ  .","","Al-Mu'jam al-Kabir 860","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن زكريا بن يحيى الحبطي ، ويقال عن عنبسة بن عبد الواحد عن عبد الله بن عمر مشكدانة عن محمد بن عبد الله بن بكر السراج عن الطبراني","الحسن عن أمه"
"21459","861  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ ، قَالَ :  ثَنَا         [23/365]      عَبْدُ الْوَارِثِ بْنُ عَبْدِ الصَّمَدِ ،  ثَنَا  أَبِي ،  عَنْ  جَدِّي  ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْحَسَنِ الْعَلَّافُ ،  ثَنَا  عَبْدُ الْوَارِثِ ،  ثَنَا  عَلِيُّ بْنُ زَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اسْتَيْقَظَ مِنْ مَنَامِهِ وَهُوَ يَسْتَرْجِعُ ، فَقُلْتُ : يَا رَسُولَ اللهِ مَا شَأْنُكَ ؟ قَالَ :  طَائِفَةٌ مِنْ أُمَّتِي يُخْسَفُ بِهِمْ فَيُبْعَثُونَ إِلَى رَجُلٍ فَيَأْتِي  مَكَّةَ  فَيَمْنَعُهُ وَيُخْسَفُ بِهِمْ ،  مَصْرَعُهُمْ وَاحِدٌ وَمَصَادِرُهُمْ  شَتَّى  إِنَّ مِنْهُمْ مَنْ يُكْرَهُ فَيَجِيءُ مُكْرَهًا  .","","Al-Mu'jam al-Kabir 861","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن علي بن زيد بن جدعان عن عبد الوارث بن سعيد بن ذكوان عن عبد الصمد بن عبد الوارث التنوري عن عبد الوارث بن عبد الصمد التنوري عن محمد بن صالح بن الوليد النرسي عن الطبراني","الحسن عن أمه"
"21460","862  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  عَمْرُو بْنُ مَخْرَمٍ أَبُو قَتَادَةَ الْبَصْرِيُّ ،  ثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  عَمْرٍو ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" قَرَأَ         {      إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ         }      .","","Al-Mu'jam al-Kabir 862","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن عمرو بن عبيد عن عبد الوارث بن سعيد بن ذكوان عن عمرو بن مخرم بصري عن معاذ بن المثنى العنبري عن الطبراني","الحسن عن أمه"
"21461","863  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  جُمْهُورُ بْنُ مَنْصُورٍ ،  ثَنَا  سِنَانُ بْنُ هَارُونَ الْبُرْجُمِيُّ ،  عَنْ  أَشْعَثَ بْنِ عَبْدِ الْمَلِكِ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" يَتَوَضَّأُ بِالْمُدِّ  ، وَيَغْتَسِلُ بِالصَّاعِ  .","","Al-Mu'jam al-Kabir 863","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن أشعث الحمراني عن سنان بن هارون البرجمي عن جمهور بن منصور عن محمد بن عبد الله مطين الحضرمي عن الطبراني","الحسن عن أمه"
"21462","864  -  حَدَّثَنَا  أَبُو زُرْعَةَ الدِّمَشْقِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  ثَنَا         [23/366]      سَعِيدُ بْنُ بَشِيرٍ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَكْرَهُ سَوْرَةَ الدَّمِ ثَلَاثًا  ، ثُمَّ يُبَاشِرُ بَعْدَ الثَّلَاثِ  .","","Al-Mu'jam al-Kabir 864","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن قتادة بن دعامة عن سعيد بن بشير الأزدي عن محمد بن بكار العاملي عن أبو زرعة الدمشقي عن الطبراني","الحسن عن أمه"
"21463","865  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى ، وَعَبْدَانُ ، قَالَا :  ثَنَا  هِشَامُ بْنُ خَالِدٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  سَالِمٌ الْخَيَّاطُ ، قَالَ :  سَمِعْتُ  الْحَسَنَ  يُحَدِّثُ ، عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُكْثِرُ أَنْ يَقُولَ :  يَا مُقَلِّبَ الْقُلُوبِ ثَبِّتْ قَلْبِي عَلَى دِينِكَ  ، فَقُلْتُ : يَا رَسُولَ اللهِ ، مَا أَكْثَرَ مَا تَدْعُو بِهَذَا الدُّعَاءِ ؟ فَقَالَ : "" يَا  أُمَّ سَلَمَةَ ،  إِنَّ قَلْبَ ابْنِ آدَمَ بَيْنَ  أُصْبُعَيْنِ  مِنْ أَصَابِعِ رَبِّ الْعَالَمِينَ ؛ إِذَا شَاءَ أَقَامَهُ ، وَإِذَا شَاءَ أَزَاغَهُ  .","","Al-Mu'jam al-Kabir 865","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن سالم بن عبد الله الخياط عن الوليد بن مسلم القرشي عن هشام بن خالد السلامي عن عبد الله بن أحمد الجواليقي عن الطبراني","الحسن عن أمه"
"21464","866  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ، وَعَبْدُ الرَّحْمَنِ بْنُ سَالِمٍ  ، وَالْحَسَنُ بْنُ الْعَبَّاسِ الرَّازِيَّانِ ، قَالُوا :  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ، (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  ابْنُ الْأَصْبَهَانِيِّ ، قَالَا :  ثَنَا  عَبْدُ الرَّحِيمِ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُسْلِمٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يُنْضَحُ  بَوْلُ الْغُلَامِ  ، وَيُغْسَلُ بَوْلُ الْجَارِيَةِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( سلم )","","Al-Mu'jam al-Kabir 866","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن عبد الرحيم بن سليمان الأشل عن سهل بن عثمان العسكري عن الحسين بن إسحاق التستري عن الطبراني","الحسن عن أمه"
"21465","867  -  حَدَّثَنَا  أَحْمَدُ بْنُ سَهْلٍ الْأَهْوَازِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ         [23/367]      الْمُقْرِي ،  ثَنَا  سَالِمُ بْنُ قُتَيْبَةَ  ،  عَنْ  أَبِي بَكْرٍ الْهُذَلِيِّ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كُنْتُ أَفْرُكُ الْمَنِيَّ مِنْ ثَوْبِ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( سلم بن قتيبة).","","Al-Mu'jam al-Kabir 867","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن أبو بكر الهذلي عن سلم بن قتيبة الشعيري عن سليمان بن داود المقري عن أحمد بن سهل بن أيوب الأهوازي عن الطبراني","الحسن عن أمه"
"21466","868  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَلِيِّ بْنِ الْجَارُودِ ، وَسَلْمُ  بْنُ عِصَامٍ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ حَفْصِ بْنِ هِشَامِ بْنِ زَيْدِ بْنِ أَنَسِ بْنِ مَالِكٍ ، قَالَ :  ثَنَا  سَالِمُ بْنُ نُوحٍ الْعَطَّارُ ،  ثَنَا  يُونُسُ بْنُ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كُنْتُ أَنَا وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَغْتَسِلُ مِنْ إِنَاءٍ وَاحِدٍ  أَقُولُ لَهُ : أَبْقِ لِي أَبْقِ لِي  .  في طبعة مكتبة ابن تيمية ونسخة الوطنية : (سالم) والمثبت من نسخة كوبرلي .","","Al-Mu'jam al-Kabir 868","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن يونس بن عبيد عن سالم بن نوح العطار عن محمد بن عبد الله بن حفص الأنصاري عن سلم بن عصام الثقفي عن الطبراني","الحسن عن أمه"
"21467","869  -  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ التُّسْتَرِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُسْتَمِرِّ الْعُرُوقِيُّ ،  ثَنَا  أَبُو هَمَّامٍ الْخَارِجِيُّ ،  حَدَّثَنِي  عَدِيُّ بْنُ أَبِي عَدِيٍّ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  فِي كُلِّ رَكْعَةٍ  تَشَهُّدٌ  وَتَسْلِيمٌ عَلَى الْمُرْسَلِينَ  ، وَعَلَى مَنْ تَبِعَهُمْ مِنْ عِبَادِ اللهِ الصَّالِحِينَ  .","","Al-Mu'jam al-Kabir 869","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن علي بن زيد بن جدعان عن عدي بن أبي عدي البصري عن الصلت بن محمد الخاركي عن إبراهيم بن المستمر العروقي عن سعيد بن عبد الرحمن التستري عن الطبراني","الحسن عن أمه"
"21468","870  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ ،  ثَنَا  عَمْرُو بْنُ هَاشِمٍ الْبَيْرُوتِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ أَبِي كَرِيمَةَ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  قُلْتُ يَا رَسُولَ اللهِ أَخْبِرْنِي عَنْ قَوْلِ اللهِ         {      وَحُورٌ عِينٌ         }             [23/368]      قَالَ : "" حُورٌ : بِيضٌ ،  عِينٌ  : ضِخَامُ الْعُيُونِ شُقْرُ الْجَرْدَاءِ بِمَنْزِلَةِ جَنَاحِ النُّسُورِ  ، قُلْتُ : يَا رَسُولَ اللهِ أَخْبِرْنِي عَنْ قَوْلِهِ :         {      كَأَنَّهُمْ لُؤْلُؤٌ مَكْنُونٌ         }      ، قَالَ : "" صَفَاؤُهُنَّ صَفَاءُ الدُّرِّ فِي  الْأَصْدَافِ  الَّتِي لَمْ تَمَسَّهُ الْأَيْدِي "" . قُلْتُ : يَا رَسُولَ اللهِ أَخْبِرْنِي عَنْ قَوْلِهِ :         {      فِيهِنَّ خَيْرَاتٌ حِسَانٌ         }      ، قَالَ : "" خَيْرَاتُ  الْأَخْلَاقِ  ، حِسَانُ الْوُجُوهِ "" . قُلْتُ : يَا رَسُولَ اللهِ أَخْبِرْنِي عَنْ قَوْلِهِ :         {      كَأَنَّهُنَّ بَيْضٌ مَكْنُونٌ         }      ، قَالَ : "" رِقَّتُهُنَّ كَرِقَّةِ الْجِلْدِ الَّذِي رَأَيْتِ فِي دَاخِلِ الْبَيْضَةِ مِمَّا يَلِي الْقِشْرَ وَهُوَ الْعُرْفِيُّ "" . قُلْتُ : يَا رَسُولَ اللهِ ، أَخْبِرْنِي عَنْ قَوْلِهِ :         {      عُرُبًا أَتْرَابًا         }      ، قَالَ : "" هُنَّ اللَّوَاتِي قُبِضْنَ فِي دَارِ الدُّنْيَا عَجَائِزَ رَمْضَاءَ شَمْطَاءَ خَلَقَهُنَّ اللهُ بَعْدَ الْكِبَرِ ، فَجَعَلَهُنَّ  عَذَارَى  عُرُبًا مُتَعَشَّقَاتٍ مُحَبَّبَاتٍ ، أَتْرَابًا عَلَى مِيلَادٍ وَاحِدٍ "" . قُلْتُ : يَا رَسُولَ اللهِ أَنِسَاءُ الدُّنْيَا أَفْضَلُ أَمِ الْحُورُ  الْعِينُ  ؟ قَالَ : "" بَلْ نِسَاءُ الدُّنْيَا أَفْضَلُ مِنَ  الْحُورِ  الْعِينِ  كَفَضْلِ الظِّهَارَةِ عَلَى الْبِطَانَةِ "" . قُلْتُ : يَا رَسُولَ اللهِ وَبِمَا ذَاكَ ؟ قَالَ : "" بِصَلَاتِهِنَّ وَصِيَامِهِنَّ وَعِبَادَتِهِنَّ اللهَ أَلْبَسَ اللهُ وُجُوهَهُنَّ النُّورَ ، وَأَجْسَادَهُنَّ الْحَرِيرَ بِيضَ الْأَلْوَانِ خُضْرَ الثِّيَابِ صَفْرَاءَ الْحُلِيِّ ،  مَجَامِرُهُنَّ  الدُّرُّ وَأَمْشَاطُهُنَّ الذَّهَبُ يَقُلْنَ : أَلَا نَحْنُ الْخَالِدَاتُ فَلَا نَمُوتُ أَبَدًا ، وَنَحْنُ النَّاعِمَاتُ فَلَا  نَبْؤُسُ  أَبَدًا ، وَنَحْنُ الْمُقِيمَاتُ فَلَا نَظْعَنُ أَبَدًا ، أَلَا وَنَحْنُ الرَّاضِيَاتُ فَلَا نَسْخَطُ أَبَدًا طُوبَى لِمَنْ كُنَّا لَهُ وَكَانَ لَنَا "" ، قُلْتُ : يَا رَسُولَ اللهِ ، الْمَرْأَةُ مِنَّا تَتَزَوَّجُ الزَّوْجَيْنِ وَالثَّلَاثَةَ وَالْأَرْبَعَةَ ثُمَّ تَمُوتُ فَتَدْخُلُ الْجَنَّةَ وَيَدْخُلُونَ مَعَهَا مَنْ يَكُونُ زَوْجَهَا ؟ قَالَ : "" يَا  أُمَّ سَلَمَةَ  إِنَّهَا تُخَيَّرُ فَتَخْتَارُ أَحْسَنَهُمْ  خُلُقًا  فَتَقُولُ : أَيْ رَبِّ إِنَّ هَذَا كَانَ أَحْسَنَهُمْ مَعِي  خُلُقًا  فِي دَارِ الدُّنْيَا فَزَوِّجْنِيهِ ، يَا  أُمَّ سَلَمَةَ  ذَهَبَ حُسْنُ  الْخُلُقِ  بِخَيْرِ الدُّنْيَا وَالْآخِرَةِ  .","","Al-Mu'jam al-Kabir 870","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن هشام بن حسان العتكي عن سليمان بن أبي كريمة الشامي عن عمرو بن هاشم البيروتي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","الحسن عن أمه"
"21469","[23/369]      871  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ رَاشِدٍ الْأَدَمِيُّ ،  ثَنَا  أَبُو رَبِيعَةَ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ، وَحُمَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" شَبَرَ  لِفَاطِمَةَ  مِنْ ذَيْلِهَا شِبْرًا  .","","Al-Mu'jam al-Kabir 871","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن حميد الطويل عن حماد بن سلمة عن زيد بن عوف القطعي عن إبراهيم بن راشد بن سليمان الآدمي عن أحمد بن يحيى بن زهير التستري عن الطبراني","الحسن عن أمه"
"21470","872  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  عَمْرُو بْنُ مَخْرَمٍ أَبُو قَتَادَةَ ،  ثَنَا  مُحَمَّدُ بْنُ دِينَارٍ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اعْمَلِي وَلَا تَتَّكِلِي ، فَإِنَّ شَفَاعَتِي لِلْهَالِكِينَ مِنْ أُمَّتِي  .","","Al-Mu'jam al-Kabir 872","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن يونس بن عبيد عن محمد بن دينار الطاحي عن عمرو بن مخرم بصري عن معاذ بن المثنى العنبري عن الطبراني","الحسن عن أمه"
"21471","سَعِيدُ بْنُ أَبِي الْحَسَنِ  عَنْ أُمِّهِ عَنْ  أُمِّ سَلَمَةَ  .  873  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ الْمُخَرِّمِيُّ ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  ثَنَا  سَعِيدٌ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  سَعِيدِ بْنِ أَبِي الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَقْتُلُ  عَمَّارًا  الْفِئَةُ  الْبَاغِيَةُ  .","","Al-Mu'jam al-Kabir 873","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن سعيد بن أبي الحسن الأنصاري عن خالد الحذاء عن سعيد بن أبي عروبة عن عمرو بن مرزوق الباهلي عن يعقوب بن إسحاق البيهسي عن الطبراني","سعيد بن أبي الحسن عن أمه عن أم سلمة"
"21472","874  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  سَعِيدِ بْنِ أَبِي الْحَسَنِ ،         [23/370]      قَالَ :  حَدَّثَتْنَا  أُمُّنَا  ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِعَمَّارٍ  :  تَقْتُلُهُ  الْفِئَةُ  الْبَاغِيَةُ  .","","Al-Mu'jam al-Kabir 874","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن سعيد بن أبي الحسن الأنصاري عن خالد الحذاء عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سعيد بن أبي الحسن عن أمه عن أم سلمة"
"21473","875  -  حَدَّثَنَا  مُحَمَّدُ بْنُ زَكَرِيَّا الْجَوْهَرِيُّ ،  ثَنَا  قَحْطَبَةُ بْنُ غُدَانةَ  ،  ثَنَا  أَبُو أُمَيَّةَ بْنُ يَعْلَى ،  عَنْ  سَعِيدِ بْنِ أَبِي الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ قَالَ حِينَ يُصْبِحُ : الْحَمْدُ لِلهِ الَّذِي تَوَاضَعَ كُلُّ شَيْءٍ لِعَظَمَتِهِ كُتِبَتْ لَهُ عَشْرُ حَسَنَاتٍ  .  في طبعة مكتبة ابن تيمية : (عرابة) والذي في النسخ الخطية غير منقوط وتحتمل الوجهين ، وقال ابن ماكولا في الإكمال : ""وأما غدانة بضم الغين المعجمة وفتح الدال المهملة وبعد الالف نون فهو قحطبة بن غدانة الجشمي"" أ.هـ والله أعلم .","","Al-Mu'jam al-Kabir 875","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن سعيد بن أبي الحسن الأنصاري عن إسماعيل بن يعلى الثقفي عن قحطبة بن غدانة الجشمي عن محمد بن زكريا بن دينار الإخباري عن الطبراني","سعيد بن أبي الحسن عن أمه عن أم سلمة"
"21474","876  -  حَدَّثَنَا  مُحَمَّدُ بْنُ زَكَرِيَّا ،  ثَنَا  قَحْطَبَةُ بْنُ غُدَانةَ  ،  ثَنَا  أَبُو أُمَيَّةَ ،  عَنْ  سَعِيدِ بْنِ أَبِي الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا خَرَجَ إِلَى الصَّلَاةِ ، يَقُولُ :  اللَّهُمَّ اجْعَلْنِي أَقْرَبَ مَنْ تَقَرَّبَ إِلَيْكَ  ، وَأَوْجَهَ مَنْ تَوَجَّهَ إِلَيْكَ ، وَأَلْحَحَ مَنْ سَأَلَكَ  .  في طبعة مكتبة ابن تيمية : (عرابة) والذي في النسخ الخطية غير منقوط وتحتمل الوجهين ، وقال ابن ماكولا في الإكمال : ""وأما غدانة بضم الغين المعجمة وفتح الدال المهملة وبعد الالف نون فهو قحطبة بن غدانة الجشمي"" أ.هـ والله أعلم .","","Al-Mu'jam al-Kabir 876","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن سعيد بن أبي الحسن الأنصاري عن إسماعيل بن يعلى الثقفي عن قحطبة بن غدانة الجشمي عن محمد بن زكريا بن دينار الإخباري عن الطبراني","سعيد بن أبي الحسن عن أمه عن أم سلمة"
"21475","877  -  حَدَّثَنَا  مُحَمَّدُ بْنُ زَكَرِيَّا ،  ثَنَا  قَحْطَبَةُ بْنُ غُدَانةَ  ،  ثَنَا  أَبُو أُمَيَّةَ بْنُ يَعْلَى ،  عَنْ  سَعِيدِ بْنِ أَبِي الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ قَالَ كُلَّ يَوْمٍ : اللَّهُمَّ اغْفِرْ لِي وَلِلْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ  أَلْحِقْ بِهِ مِنْ كُلِّ مُؤْمِنٍ حَسَنَةً  .  في طبعة مكتبة ابن تيمية : (عرابة) والذي في النسخ الخطية غير منقوط وتحتمل الوجهين ، وقال ابن ماكولا في الإكمال : ""وأما غدانة بضم الغين المعجمة وفتح الدال المهملة وبعد الالف نون فهو قحطبة بن غدانة الجشمي"" أ.هـ والله أعلم .","","Al-Mu'jam al-Kabir 877","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن سعيد بن أبي الحسن الأنصاري عن إسماعيل بن يعلى الثقفي عن قحطبة بن غدانة الجشمي عن محمد بن زكريا بن دينار الإخباري عن الطبراني","سعيد بن أبي الحسن عن أمه عن أم سلمة"
"21476","مُسَّةُ  عَنْ  أُمِّ سَلَمَةَ  .  878  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ، (  ح  ) .         [23/371]      وَحَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  أَبُو الْوَلِيدِ ، قَالَا :  ثَنَا  زُهَيْرٌ ،  ثَنَا  عَلِيُّ بْنُ عَبْدِ الْأَعْلَى ،  عَنْ  أَبِي سَهْلٍ مِنْ أَهْلِ الْبَصْرَةِ ،  عَنْ  مُسَّةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَتِ النِّسَاءُ         [23/372]      تَقْعُدُ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعْدَ  نِفَاسِهَا  أَرْبَعِينَ لَيْلَةً  ، وَكُنَّا نُصَلِّي ، وَعَلَى وُجُوهِنَا الْوَرْسُ مِنَ الْكَلَفِ ""  .","","Al-Mu'jam al-Kabir 878","","هند بنت أبي أمية زوج رسول الله عن مسة الأزدية عن كثير بن زياد البرساني عن علي بن عبد الأعلى الثعلبي عن زهير بن معاوية بن حديج عن أحمد بن عبد الله اليربوعي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مسة عن أم سلمة"
"21477","كَبْشَةُ بِنْتُ أَبِي مَرْيَمَ  عَنْ  أُمِّ سَلَمَةَ  .  879  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ ،  ثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  ثَنَا  ثَابِتُ بْنُ عُمَارَةَ ،  عَنْ  رَيْطَةَ ،  عَنْ  كَبْشَةَ بِنْتِ أَبِي مَرْيَمَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" يَنْهَى أَنْ يُخْلَطَ التَّمْرُ بِالزَّبِيبِ  ، وَأَنْ يُعْجَمَ النَّوَاءُ طَبْخًا  .","","Al-Mu'jam al-Kabir 879","","هند بنت أبي أمية زوج رسول الله عن كبشة بنت أبي مريم عن ريطة بنت حريث عن ثابت بن عمارة الحنفي عن عثمان بن عمر بن فارس عن إدريس بن جعفر العطار عن الطبراني","كبشة بنت أبي مريم عن أم سلمة"
"21478","880  -  حَدَّثَنَا  الْجُذُوعِيُّ ،  حَدَّثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  ثَنَا  أَبُو عَاصِمٍ ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى ،  ثَنَا  خَالِدُ بْنُ الْحَارِثِ ،  ثَنَا  ثَابِتٌ ،  حَدَّثَتْنِي  رَيْطَةُ بِنْتُ حُرَيْثٍ ،  عَنْ  كَبْشَةَ بِنْتِ أَبِي مَرْيَمَ ،  أَنَّهَا  سَأَلَتْ  أُمَّ سَلَمَةَ زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الشَّرَابِ ، فَقَالَتْ : أُخْبِرُكُمْ بِمَا كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنْهَى عَنْهُ أَهْلَهُ  كَانَ "" يَنْهَانَا أَنْ يُخْلَطَ الزَّبِيبُ بِالتَّمْرِ  .","","Al-Mu'jam al-Kabir 880","","هند بنت أبي أمية زوج رسول الله عن كبشة بنت أبي مريم عن ريطة بنت حريث عن ثابت بن عمارة الحنفي عن خالد الصدق عن محمد بن عبد الأعلى القيسي عن الحسين بن إسحاق التستري عن الطبراني","كبشة بنت أبي مريم عن أم سلمة"
"21479","وَمِنْ  نِسَاءِ أَهْلِ الْكُوفَةِ  عَمْرَةُ بِنْتُ أَفْعَى  عَنْ  أُمِّ سَلَمَةَ  .  881  -  حَدَّثَنَا  الْقَاسِمُ بْنُ مُحَمَّدٍ الدَّلَّالُ  بِالْكُوفَةِ  ،  ثَنَا  مُخَوَّلُ         [23/373]      بْنُ إِبْرَاهِيمَ ،  ثَنَا  عَبْدُ الْجَبَّارِ بْنُ الْعَبَّاسِ ،  عَنْ  عَمَّارٍ الدُّهْنِيِّ ،  عَنْ  عَمْرَةَ بِنْتِ أَفْعَى ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَنْبَغِي لِأَحَدٍ أَنْ  يُجْنِبَ  فِي هَذَا الْمَسْجِدِ ، إِلَّا أَنَا  وَعَلِيٌّ  .","","Al-Mu'jam al-Kabir 881","","هند بنت أبي أمية زوج رسول الله عن عمرة بنت الشافع عن عمار بن معاوية الدهني عن عبد الجبار بن العباس الشبامي عن مخول بن إبراهيم الكوفي عن قاسم بن محمد بن حماد الدلال عن الطبراني","عمرة بنت أفعى عن أم سلمة"
"21480","سَلْمَى  عَنْ  أُمِّ سَلَمَةَ  .  882  -  حَدَّثَنَا  عَلِيُّ بْنُ الْعَبَّاسِ الْبَجَلِيُّ ،  ثَنَا  أَبُو سَعِيدٍ الْأَشَجُّ ،  ثَنَا  أَبُو خَالِدٍ الْأَحْمَرُ ،  حَدَّثَنِي  رَزِينٌ ،  حَدَّثَتْنِي  سَلْمَى ، قَالَتْ :  دَخَلْتُ عَلَى أُمِّ سَلَمَةَ وَهِيَ تَبْكِي ، فَقُلْتُ : مَا يُبْكِيكِ ؟  فَقَالَتْ  :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَعْنِي فِي الْمَنَامِ  ، وَعَلَى رَأْسِهِ وَلِحْيَتِهِ التُّرَابُ  ، فَقُلْتُ : مَا لَكَ يَا رَسُولَ اللهِ ؟ فَقَالَ : "" شَهِدْتُ قَتْلَ  الْحُسَيْنِ  آنِفًا "" .","","Al-Mu'jam al-Kabir 882","","هند بنت أبي أمية زوج رسول الله عن سلمى البكرية عن رزين بن حبيب الجهني عن سليمان بن حيان الأحمر عن عبد الله بن سعيد الأشج عن المقانعي علي بن العباس بن الوليد عن الطبراني","سلمى عن أم سلمة"
"21481","جَسْرَةُ  عَنْ  أُمِّ سَلَمَةَ  .  883  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  ابْنُ أَبِي         [23/374]      عُتْبَةَ  ،  عَنْ  أَبِي الْخَطَّابِ الْهَجَرِيِّ ،  عَنْ  مَحْدُوجٍ الذُّهْلِيِّ ،  عَنْ  جَسْرَةَ ، قَالَتْ :  أَخْبَرَتْنِي  أُمُّ سَلَمَةَ ، قَالَتْ :  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى الْمَسْجِدِ ، فَنَادَى بِأَعْلَى صَوْتِهِ  أَلَا إِنَّ هَذَا الْمَسْجِدَ لَا يَحِلُّ  لِجُنُبٍ  ، وَلَا لِحَائِضٍ إِلَّا لِلنَّبِيِّ وَأَزْوَاجِهِ  وَفَاطِمَةَ بِنْتِ مُحَمَّدٍ  ،  وَعَلِيٍّ ،  أَلَا بَيَّنْتُ لَكُمْ أَنْ تَضِلُّوا  .  كذا في طبعة مكتبة ابن تيمية ، والصواب: (ابن أبي غنية).","","Al-Mu'jam al-Kabir 883","","هند بنت أبي أمية زوج رسول الله عن جسرة بنت دجاجة العامرية عن محدوج الهذلي عن أبو الخطاب الهجري عن عبد الملك بن حميد الخزاعي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","جسرة عن أم سلمة"
"21482","أُمُّ مُسَاوِرٍ الْحِمْيَرِيُّ  عَنْ  أُمِّ سَلَمَةَ  .  884  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  إِسْحَاقُ بْنُ إِسْمَاعِيلَ الطَّالْقَانِيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  مُسَاوِرٍ الْحِمْيَرِيِّ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  أَيُّمَا امْرَأَةٍ مَاتَتْ وَزَوْجُهَا عَنْهَا رَاضٍ دَخَلَتِ الْجَنَّةَ  .","","Al-Mu'jam al-Kabir 884","","هند بنت أبي أمية زوج رسول الله عن أم مساور الحميرية عن مساور الحميري عن عبد الله بن عبد الرحمن الضبي عن محمد بن فضيل بن غزوان عن إسحاق بن إسماعيل الطالقاني عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أم مساور الحميري عن أم سلمة"
"21483","885  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  ) .         [23/375]      وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  إِسْحَاقُ بْنُ إِسْمَاعِيلَ الطَّالْقَانِيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  أَبِي نَصْرٍ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  مُسَاوِرٍ الْحِمْيَرِيِّ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا يُبْغِضُ  عَلِيًّا  مُؤْمِنٌ  ، وَلَا يُحِبُّهُ مُنَافِقٌ  .","","Al-Mu'jam al-Kabir 885","","هند بنت أبي أمية زوج رسول الله عن أم مساور الحميرية عن مساور الحميري عن عبد الله بن عبد الرحمن الضبي عن محمد بن فضيل بن غزوان عن إسحاق بن إسماعيل الطالقاني عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أم مساور الحميري عن أم سلمة"
"21484","886  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  وَاصِلٌ ،  ثَنَا  ابْنُ فُضَيْلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ أَبِي نَصْرٍ ،  عَنْ  مُسَاوِرٍ الْحِمْيَرِيِّ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا يُحِبُّ  عَلِيًّا  إِلَّا مُؤْمِنٌ  ، وَلَا يُبْغِضُهُ إِلَّا مُنَافِقٌ  .","","Al-Mu'jam al-Kabir 886","","هند بنت أبي أمية زوج رسول الله عن أم مساور الحميرية عن مساور الحميري عن عبد الله بن عبد الرحمن الضبي عن محمد بن فضيل بن غزوان عن واصل بن عبد الأعلى الأسدي عن محمد بن عثمان بن أبي شيبة عن الطبراني","أم مساور الحميري عن أم سلمة"
"21485","أُمُّ مُوسَى  عَنْ  أُمِّ سَلَمَةَ  .  887  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ ، قَالَا :  ثَنَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  أُمِّ مُوسَى ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  وَالَّذِي تَحْلِفُ بِهِ  أُمُّ سَلَمَةَ  إِنْ كَانَ أَقْرَبُ النَّاسِ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَلِيًّا  ،  كُنَّا عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي  بَيْتِ عَائِشَةَ  ، فَكُنْتُ آخِرَ مَنْ خَرَجَ مِنَ الْبَيْتِ ، ثُمَّ جَلَسْنَا أَدْنَى مِنَ الْبَابِ وَأَكَبَّ عَلَيْهِ  عَلِيٌّ  ، فَكَانَ آخِرَ النَّاسِ بِهِ عَهْدًا يُسَارُّهُ وَيُنَاجِيهِ  .","","Al-Mu'jam al-Kabir 887","","هند بنت أبي أمية زوج رسول الله عن أم موسى سرية علي بن أبي طالب عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","أم موسى عن أم سلمة"
"21486","جَدَّةُ ابْنِ جُدْعَانَ  عَنْ  أُمِّ سَلَمَةَ  .  888  -  حَدَّثَنَا  أَبُو يَحْيَى الرَّازِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ، (  ح  ) .         [23/376]      وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  وَكِيعٌ ،  عَنْ  دَاوُدَ بْنِ أَبِي عَبْدِ اللهِ ،  عَنِ  ابْنِ جُدْعَانَ ،  عَنْ  جَدَّتِهِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا  حِلْفَ  فِي الْإِسْلَامِ  ، وَمَا كَانَ مِنْ  حِلْفٍ  فِي الْجَاهِلِيَّةِ لَمْ يَزِدْهُ الْإِسْلَامُ إِلَّا شِدَّةً  .","","Al-Mu'jam al-Kabir 888","","هند بنت أبي أمية زوج رسول الله عن جدة عبد الرحمن بن محمد بن جدعان عن عبد الرحمن بن محمد القرشي عن داود بن أبي عبد الله الهاشمي عن وكيع بن الجراح عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","جدة ابن جدعان عن أم سلمة"
"21487","889  -  حَدَّثَنَا  أَبُو يَحْيَى ،  ثَنَا  سَهْلٌ ، (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ ،  ثَنَا  عُثْمَانُ ، (  ح  ) .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالُوا :  ثَنَا  وَكِيعٌ ،  عَنْ  دَاوُدَ بْنِ أَبِي عَبْدِ اللهِ ،  عَنِ  ابْنِ جُدْعَانَ ،  عَنْ  جَدَّتِهِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  دَعَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَصِيفَةً لَهُ فَأَبْطَأَتْ عَلَيْهِ ، فَقَالَ :  لَوْلَا مَخَافَةُ الْقَوَدِ يَوْمَ الْقِيَامَةِ لَأَوْجَعْتُكِ بِهَذَا السِّوَاكِ  .","","Al-Mu'jam al-Kabir 889","","هند بنت أبي أمية زوج رسول الله عن جدة عبد الرحمن بن محمد بن جدعان عن عبد الرحمن بن محمد القرشي عن داود بن أبي عبد الله الهاشمي عن وكيع بن الجراح عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","جدة ابن جدعان عن أم سلمة"
"21488","890  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ ، (  ح  ) .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  وَكِيعٌ ،  عَنْ  دَاوُدَ بْنِ أَبِي عَبْدِ اللهِ ،  عَنِ  ابْنِ جُدْعَانَ ،  عَنْ  جَدَّتِهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْمُسْتَشَارُ مُؤْتَمَنٌ  .","","Al-Mu'jam al-Kabir 890","","هند بنت أبي أمية زوج رسول الله عن جدة عبد الرحمن بن محمد بن جدعان عن عبد الرحمن بن محمد القرشي عن داود بن أبي عبد الله الهاشمي عن وكيع بن الجراح عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","جدة ابن جدعان عن أم سلمة"
"21489","[23/377]      أُمُّ مُبَشِّرٍ  عَنْ  أُمِّ سَلَمَةَ  .  891  -  حَدَّثَنَا  أَبُو يَحْيَى الرَّازِيُّ ،  ثَنَا  مَحْمُودُ بْنُ غَيْلَانَ ،  ثَنَا  أَبُو النَّضْرِ ،  ثَنَا  سَالِمُ بْنُ طَلْحَةَ ،  ثَنَا  جَامِعُ بْنُ أَبِي رَاشِدٍ وَدُمُوعُهُ يَتَحَدَّرُ ،  عَنْ  أُمِّ مُبَشِّرٍ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّهَا سَمِعَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا ظَهَرَ الشَّرُّ فِي الْأَرْضِ أَنْزَلَ اللهُ بَأْسَهُ بِأَهْلِ الْأَرْضِ  ، قُلْتُ : يَا رَسُولَ اللهِ ، فَإِنْ كَانَ فِيهِمْ قَوْمٌ صَالِحُونَ ؟ قَالَ : "" نَعَمْ ، وَإِنْ كَانَ فِيهِمْ قَوْمٌ صَالِحُونَ يُصِيبُهُمْ مَا أَصَابَ النَّاسَ ، ثُمَّ يَرْجِعُونَ إِلَى رَحْمَةِ اللهِ وَمَغْفِرَتِهِ  .","","Al-Mu'jam al-Kabir 891","","هند بنت أبي أمية زوج رسول الله عن أم مبشر الأنصارية عن جامع بن أبي راشد الكاهلي عن سالم بن طلحة عن هاشم بن القاسم بن مسلم عن محمود بن غيلان المروزي عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","أم مبشر عن أم سلمة"
"21490","الزِّيَادَاتُ فِي حَدِيثِ  أُمِّ سَلَمَةَ  .  سَعْدُ بْنُ أَبِي وَقَّاصٍ  عَنْ  أُمِّ سَلَمَةَ  .  892  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبَانَ ،  ثَنَا  يَحْيَى بْنُ سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  سَعْدِ بْنِ أَبِي وَقَّاصٍ  ، عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِعَلِيٍّ  :  أَمَا تَرْضَى أَنْ تَكُونَ مِنِّي كَمَا  هَارُونُ  مِنْ  مُوسَى  غَيْرَ أَنَّهُ لَيْسَ بَعْدِي نَبِيٌّ  .","","Al-Mu'jam al-Kabir 892","","هند بنت أبي أمية زوج رسول الله عن سعد بن أبي وقاص عن عامر بن سعد بن أبي وقاص عن المنهال بن عمرو الأسدي عن سلمة بن كهيل الحضرمي عن يحيى بن سلمة بن كهيل عن إسماعيل بن أبان عن الحسن بن علي الريحاني عن محمد بن عثمان بن أبي شيبة عن الطبراني","سعد بن أبي وقاص عن أم سلمة"
"21491","عُمَرُ بْنُ أَبِي سَلَمَةَ  ، عَنْ  أُمِّ سَلَمَةَ  .  893  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ ،  ثَنَا  أَبِي  ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ         [23/378]      بِشْرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ :  حَدَّثَنِي  أَبُو بَكْرِ بْنُ مُحَمَّدٍ ،  عَنْ  عُمَرَ بْنِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  أَتَتْ  ضُبَاعَةُ بِنْتُ الزُّبَيْرِ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهِيَ شَاكِيَةٌ ، فَقَالَ لَهَا :  أَلَا تَخْرُجِينَ مَعَنَا فِي سَفَرِنَا هَذَا ؟  فَقَالَتْ : يَا رَسُولَ اللهِ إِنِّي شَاكِيَةٌ وَأَخْشَى أَنْ تَحْبِسَنِي شَكْوَتِي ، قَالَ : "" فَأَهِلِّي بِالْحَجِّ ، وَقُولِي اللَّهُمَّ مَحِلِّي حَيْثُ حَبَسْتَنِي  .","","Al-Mu'jam al-Kabir 893","","هند بنت أبي أمية زوج رسول الله عن عمر بن أبي سلمة المخزومي عن أبو بكر بن محمد الخزرجي عن محمد بن إسحاق عن عبد الرحمن بن بشير الدمشقي عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","عمر بن أبي سلمة عن أم سلمة"
"21492","894  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ شُعَيْبٍ السِّمْسَارُ ،  ثَنَا  خَالِدُ بْنُ خِدَاشٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  عَبْدِ رَبِّهِ بْنِ سَعِيدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ كَعْبٍ الْحِمْيَرِيِّ ،  عَنْ  عُمَرَ بْنِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 894","","هند بنت أبي أمية زوج رسول الله عن عمر بن أبي سلمة المخزومي عن عبد الله بن كعب مولى عثمان بن عفان عن عبد ربه بن سعيد النجاري عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن خالد المهلبي عن محمد بن علي بن شعيب السمسار عن الطبراني","عمر بن أبي سلمة عن أم سلمة"
"21493","ابْنُ عَبَّاسٍ  عَنْ  أُمِّ سَلَمَةَ  .  895  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ بْنِ الزُّبَيْرِ الْحَلَبِيُّ ،  ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  مَخْلَدُ بْنُ يَزِيدَ ،  عَنْ  سُفْيَانَ الثَّوْرِيِّ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الْحَكَمِ ،  عَنْ  مِقْسَمٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" يُوتِرُ بِسَبْعٍ وَبِخَمْسٍ  لَا يَفْصِلُ بَيْنَهُنَّ بِتَسْلِيمٍ وَلَا بِكَلَامٍ  .","","Al-Mu'jam al-Kabir 895","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن عباس عن مقسم بن بجرة عن الحكم بن عتيبة الكندي عن منصور بن المعتمر عن سفيان الثوري عن مخلد بن يزيد الحراني عن عبد الله بن محمد النفيلي عن يعقوب بن إسحاق بن الزبير الحلبي عن الطبراني","ابن عباس عن أم سلمة"
"21494","عَوْفُ بْنُ مَالِكٍ الْأَشْجَعِيُّ  عَنْ  أُمِّ سَلَمَةَ  .  896  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الطَّرَائِفِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ مَيْمُونٍ الرَّقِّيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ اللهِ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَوْفِ بْنِ مَالِكٍ الْأَشْجَعِيِّ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الَّذِي يَحْنُو عَلَيْكُمْ مِنْ بَعْدِي هُوَ الصَّادِقُ الْبَارُّ  ، اللَّهُمَّ اسْقِ  ابْنَ عَوْفٍ  مِنْ سَلْسَبِيلِ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 896","","هند بنت أبي أمية زوج رسول الله عن عوف بن مالك بن نضلة الجشمي عن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن سليمان بن عبد الله بن الزبرقان الأنطاكي عن محمد بن علي بن ميمون الرقي عن محمد بن علي الطرائفي عن الطبراني","عوف بن مالك الأشجعي عن أم سلمة"
"21495","[23/379]      سَفِينَةُ مَوْلَى أُمِّ سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  897  -  حَدَّثَنَا  زَكَرِيَّا بْنُ حَمْدَوَيْهِ الصَّفَّارُ ،  ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الطُّفَيْلِ ،  عَنْ  سَفِينَةَ مَوْلَى أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَقُولُ فِي  مَرَضِهِ الَّذِي تُوُفِّيَ فِيهِ  :  الصَّلَاةُ وَمَا  مَلَكَتْ  أَيْمَانُكُمْ  فَمَا زَالَ يَقُولُهَا حَتَّى مَا يُقْبَضُ بِهَا لِسَانُهُ  .","","Al-Mu'jam al-Kabir 897","","هند بنت أبي أمية زوج رسول الله عن سفينة مولى رسول الله عن عامر بن واثلة عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عفان بن مسلم الصفار عن زكريا بن حمدويه الصفار عن الطبراني","سفينة مولى أم سلمة عن أم سلمة"
"21496","898  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  عُقَيْلٌ ،  عَنِ  ابْنِ شِهَابٍ ، قَالَ :  أَخْبَرَنِي  سَالِمُ بْنُ عَبْدِ اللهِ ، أَنَّ سَفِينَةَ مَوْلَى أُمِّ سَلَمَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَخْبَرَهُ  ، أَنَّ أُمَّ سَلَمَةَ  أَخْبَرَتْهُ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تَصْحَبُ الْمَلَائِكَةُ رُفْقَةً فِيهَا  جَرَسٌ  .","","Al-Mu'jam al-Kabir 898","","هند بنت أبي أمية زوج رسول الله عن سفينة مولى رسول الله عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عقيل بن خالد الأيلي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","سفينة مولى أم سلمة عن أم سلمة"
"21497","899  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ ،  ثَنَا  أَبُو النَّضْرِ إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  يَحْيَى بْنُ حَمْزَةَ ،  ثَنَا  الزُّبَيْدِيُّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ، أَنَّ سَفِينَةَ مَوْلَى أُمِّ سَلَمَةَ  أَخْبَرَهُ  ،  أَنَّ  أُمَّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَصْحَبُ الْمَلَائِكَةُ رُفْقَةً فِيهَا  جَرَسٌ  .","","Al-Mu'jam al-Kabir 899","","هند بنت أبي أمية زوج رسول الله عن سفينة مولى رسول الله عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن محمد بن الوليد بن عامر الزبيدي عن يحيى بن حمزة بن البتلهي عن إسحاق بن إبراهيم الفراديسي عن أبو زرعة الدمشقي عن الطبراني","سفينة مولى أم سلمة عن أم سلمة"
"21498","عَامِرُ بْنُ أَبِي أُمَيَّةَ  عَنْ  أُمِّ سَلَمَةَ  .  900  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  ثَنَا  مُعَاذُ بْنُ هِشَامٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،         [23/380]      عَنْ  عَامِرِ بْنِ أَبِي أُمَيَّةَ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ "" يُصْبِحُ  جُنُبًا  ثُمَّ يَصُومُ  .","","Al-Mu'jam al-Kabir 900","","هند بنت أبي أمية زوج رسول الله عن عامر بن أبي أمية المخزومي عن سعيد بن المسيب عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن أبو موسى الزمن عن محمد بن صالح النرسي عن الطبراني","عامر بن أبي أمية عن أم سلمة"
"21499","أَبُو الطُّفَيْلِ  عَنْ  أُمِّ سَلَمَةَ  .  901  -  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ الْبَاقِي الْأَذَنِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَوْفٍ الْحِمْصِيُّ ،  ثَنَا  أَبُو جَابِرٍ مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ ،  ثَنَا  الْحَكَمُ بْنُ مُحَمَّدٍ شَيْخٌ مَكِّيٌّ ،  عَنْ  فِطْرِ بْنِ خَلِيفَةَ ،  عَنْ  أَبِي الطُّفَيْلِ ، قَالَ :  سَمِعْتُ  أُمَّ سَلَمَةَ ، تَقُولُ : أَشْهَدُ أَنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ أَحَبَّ  عَلِيًّا  فَقَدْ أَحَبَّنِي ، وَمَنْ أَحَبَّنِي فَقَدْ أَحَبَّ اللهَ  ، وَمَنْ أَبْغَضَ  عَلِيًّا  فَقَدْ أَبْغَضَنِي ، وَمَنْ أَبْغَضَنِي فَقَدْ أَبْغَضَ اللهَ  .","","Al-Mu'jam al-Kabir 901","","هند بنت أبي أمية زوج رسول الله عن عامر بن واثلة عن فطر بن خليفة عن الحكم بن محمد شيخ مكي عن أبو جابر محمد بن عبد الملك الأزدي عن محمد بن عوف بن سفيان عن يحيى بن عبد الباقي الثغري عن الطبراني","أبو الطفيل عن أم سلمة"
"21500","الزُّهْرِيُّ  عَنْ  عُرْوَةَ  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  902  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي ،  ثَنَا  عَبْدُ الرَّزَّاقِ ،  أَخْبَرَنِي  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ، قَالَ :  حَدَّثَتْنِي  زَيْنَبُ بِنْتُ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  سَمِعَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَلَبَ خُصُومَةٍ عِنْدَ بَابِ  أُمِّ سَلَمَةَ  فَخَرَجَ إِلَيْهِمْ فَقَالَ :  إِنَّكُمْ تَخْتَصِمُونَ إِلَيَّ ، وَإِنَّمَا أَنَا بَشَرٌ  ، وَلَعَلَّ بَعْضَكُمْ أَنْ يَكُونَ أَعْلَمَ بِحُجَّتِهِ مِنْ بَعْضٍ ، فَأَقْضِي         [23/381]      لَهُ بِمَا أَسْمَعُ ، وَأَظُنُّهُ صَادِقًا ، فَمَنْ قَضَيْتُ لَهُ بِشَيْءٍ مِنْ حَقِّ أَخِيهِ ، فَإِنَّهَا قِطْعَةٌ مِنَ النَّارِ ، فَلْيَأْخُذْهَا أَوْ لِيَدَعْهَا  .","","Al-Mu'jam al-Kabir 902","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","الزهري عن عروة عن زينب بنت أم سلمة عن أم سلمة"
"21501","903  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْخَلَّالُ الْمَكِّيُّ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُوسَى التَّيْمِيُّ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُرْوَةَ ، أَنَّ  زَيْنَبَ بِنْتَ أُمِّ سَلَمَةَ  أَخْبَرَتْهُ  ،  عَنْ  أُمِّ سَلَمَةَ  ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَمِعَ جَلَبَةَ خُصُومٍ بِبَابِ  أُمِّ سَلَمَةَ  ، فَخَرَجَ إِلَيْهِمْ  فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 903","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن الزهري عن أسامة بن زيد الليثي المدني عن عبد الله بن موسى بن إبراهيم الطلحي عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","الزهري عن عروة عن زينب بنت أم سلمة عن أم سلمة"
"21502","هِشَامُ بْنُ عُرْوَةَ  عَنْ أَبِيهِ عَنْ  زَيْنَبَ  .  904  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ عُمَيْرٍ  ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ،  أَنَّ  أُمَّ حَبِيبَةَ  ، قَالَتْ : يَا رَسُولَ اللهِ هَلْ لَكَ فِي أُخْتِي  بِنْتِ أَبِي سُفْيَانَ  ؟ قَالَ :  لَا إِنَّهَا لَا تَحِلُّ لِي  ، قَالَتْ : إِنَّهُ بَلَغَنِي أَنَّكَ تَخْطُبُ  دُرَّةَ بِنْتَ أَبِي سَلَمَةَ  ، قَالَ : "" بِنْتُ  أُمِّ سَلَمَةَ ،  وَاللهِ لَوْ لَمْ تَكُنْ رَبِيبَتِي فِي  حِجْرِي  مَا حَلَّتْ لِي ، إِنَّهَا بِنْتُ أَخِي مِنَ الرَّضَاعَةِ أَرْضَعَتْنِي وَإِيَّاهَا  ثُوَيْبَةُ  ، فَلَا تَعْرِضْنَ عَلَيَّ أَخَوَاتِكُنَّ وَلَا بَنَاتِكُنَّ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : (عبد الله بن نمير).","","Al-Mu'jam al-Kabir 904","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","هشام بن عروة عن أبيه عن زينب"
"21503","905  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ أَبِي حَازِمٍ ،  عَنْ  هِشَامٍ ،  عَنْ  أَبِيهِ ،  عَنْ  زَيْنَبَ ،  عَنْ  أُمِّ سَلَمَةَ ،  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 905","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد العزيز بن أبي حازم المخزومي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","هشام بن عروة عن أبيه عن زينب"
"21504","[23/382]      906  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّكُمْ تَخْتَصِمُونَ ، وَإِنَّمَا أَنَا بَشَرٌ ، وَلَعَلَّ بَعْضَكُمْ أَنْ يَكُونَ  أَلْحَنَ  بِحُجَّتِهِ مِنْ بَعْضٍ ، فَإِنَّمَا أَقْضِي بَيْنَكُمْ عَلَى نَحْوِ مَا أَسْمَعُ مِنْكُمْ ،  فَمَنْ قَضَيْتُ لَهُ مِنْ حَقِّ أَخِيهِ شَيْئًا ، فَلَا يَأْخُذْهُ ، فَإِنَّمَا أَقْطَعُ لَهُ قِطْعَةً مِنْ نَارِ  جَهَنَّمَ  يَأْتِي بِهَا يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 906","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","هشام بن عروة عن أبيه عن زينب"
"21505","907  -  حَدَّثَنَا  مُصْعَبٌ الزُّبَيْرِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ أَبِي حَازِمٍ ،  عَنْ  هِشَامٍ ،  عَنْ  أَبِيهِ ،  عَنْ  زَيْنَبَ ،  عَنْ  أُمِّ سَلَمَةَ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 907","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد العزيز بن أبي حازم المخزومي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","هشام بن عروة عن أبيه عن زينب"
"21506","908  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْنَبَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  جَاءَتْ  أُمُّ سُلَيْمٍ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَأَلَتْهُ عَنِ الْمَرْأَةِ تَرَى فِي مَنَامِهَا مَا يَرَى الرَّجُلُ ، فَقَالَ :  إِذَا رَأَتِ الْمَاءَ فَلْتَغْتَسِلْ  ، فَقُلْتُ لَهَا : فَضَحْتِ النِّسَاءَ هَلْ تَحْتَلِمُ الْمَرْأَةُ ؟ فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  تَرِبَتْ  يَمِينُكِ ، فَبِمَ يُشْبِهُهَا ابْنُهَا إِذًا ؟  .","","Al-Mu'jam al-Kabir 908","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","هشام بن عروة عن أبيه عن زينب"
"21507","909  -  حَدَّثَنَا  مُصْعَبٌ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ أَبِي حَازِمٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  زَيْنَبَ ،  عَنْ  أُمِّ سَلَمَةَ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 909","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد العزيز بن أبي حازم المخزومي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","هشام بن عروة عن أبيه عن زينب"
"21508","910  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا         [23/383]      وَكِيعٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَخَلَ عَلَيْهَا ، وَسَمِعَ  مُخَنَّثًا  ، وَهُوَ يَقُولُ  لِعَبْدِ اللهِ بْنِ أَبِي أُمَيَّةَ  : إِنْ فَتَحَ اللهُ  الطَّائِفَ  غَدًا دَلَلْتُكَ عَلَى امْرَأَةٍ تُقْبِلُ بِأَرْبَعٍ ، وَتُدْبِرُ بِثَمَانٍ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَخْرِجُوهُمْ مِنْ بُيُوتِكُمْ  .","","Al-Mu'jam al-Kabir 910","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","هشام بن عروة عن أبيه عن زينب"
"21509","911  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي ،  قَالَ :  ثَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّهَا قَالَتْ : يَا رَسُولَ اللهِ إِنَّ بَنِي أَبِي سَلَمَةَ فِي  حِجْرِي  ، وَلَيْسَ لَهُمْ شَيْءٌ إِلَّا مَا أَنْفَقْتُ ، فَلِي أَجْرٌ إِنْ أَنْفَقْتُ عَلَيْهِمْ ؟ فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَنْفِقِي عَلَيْهِمْ ، فَلَكِ أَجْرُ مَا أَنْفَقْتِ عَلَيْهِمْ  .","","Al-Mu'jam al-Kabir 911","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن معمر بن راشد عن عبد الرزاق الصنعاني عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","هشام بن عروة عن أبيه عن زينب"
"21510","أَبُو سَلَمَةَ  عَنْ  زَيْنَبَ  .  912  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ الْجُذُوعِيُّ ،  ثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  ثَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ،  قَالَتْ :  بَيْنَا أَنَا مُضْجِعَةٌ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي  الْخَمِيلَةِ  إِذْ حِضْتُ "" قَالَتْ :  كَانَتْ هِيَ وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي  الْخَمِيلَةِ  .","","Al-Mu'jam al-Kabir 912","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن هشام الدستوائي عن وهب بن جرير بن حازم عن عقبة بن مكرم عن الجذوعى محمد بن محمد بن إسماعيل عن الطبراني","أبو سلمة عن زينب"
"21511","913  -  حَدَّثَنَا  الْجُذُوعِيُّ ،  ثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  ثَنَا  سَالِمُ بْنُ نُوحٍ ،  عَنْ  عُمَرَ بْنِ عَامِرٍ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  زَيْنَبَ ،         [23/384]      عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  كُنْتُ أَنَا وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 913","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن عمر بن عامر الأحول عن سالم بن نوح العطار عن عقبة بن مكرم عن الجذوعى محمد بن محمد بن إسماعيل عن الطبراني","أبو سلمة عن زينب"
"21512","914  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  إِسْمَاعِيلُ ابْنُ عُلَيَّةَ ،  عَنْ  هِشَامٍ الدَّسْتُوَائِيِّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  زَيْنَبَ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّهَا كَانَتْ تَغْتَسِلُ هِيَ وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ إِنَاءٍ وَاحِدٍ مِنَ الْجَنَابَةِ  وَأَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ "" يُقَبِّلُهَا وَهُوَ صَائِمٌ  "" .","","Al-Mu'jam al-Kabir 914","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن هشام الدستوائي عن إسماعيل ابن علية عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو سلمة عن زينب"
"21513","نَافِعٌ مَوْلَى أُمِّ سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  915  -  حَدَّثَنَا  حَجَّاجُ بْنُ عِمْرَانَ السَّدُوسِيُّ ،  ثَنَا  أَبُو سَلَمَةَ يَحْيَى بْنُ خَلَفٍ ،  ثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَبْدِ رَبِّهِ ،  عَنْ  أَبِي عِيَاضٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ،  أَنَّ  مَرْوَانَ بْنَ الْحَكَمِ  بَعَثَهُ إِلَى أُمِّ سَلَمَةَ ،  قَالَ  : فَلَقِيتُ غُلَامَهَا نَافِعًا فَأَرْسَلَهُ إِلَيْهَا فَسَأَلَهَا ، ثُمَّ رَجَعَ إِلَيْهِ فَأَنْبَأَهُ  أَنَّهَا حَدَّثَتْهُ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ "" يُصْبِحُ  جُنُبًا  مِنْ جِمَاعٍ مِنْ غَيْرِ احْتِلَامٍ ، ثُمَّ يُصْبِحُ صَائِمًا  .","","Al-Mu'jam al-Kabir 915","","هند بنت أبي أمية زوج رسول الله عن نافع مولى أم سلمة عن عبد الرحمن بن الحارث بن هشام المخزومي عن أبو عياض المدني صاحب علي عن عبد ربه بن أبي يزيد عن أبي عياض عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبد الأعلى بن عبد الأعلى القرشي عن يحيى بن خلف الجوباري عن حجاج بن عمران السدوسي عن الطبراني","نافع مولى أم سلمة عن أم سلمة"
"21514","سُلَيْمَانُ بْنُ يَسَارٍ  عَنْ  أُمِّ سَلَمَةَ  .  916  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو أُسَامَةَ ، وَمُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ  عَنْ  نَافِعٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  قُلْتُ :  يَا رَسُولَ اللهِ كَيْفَ بِالنِّسَاءِ ؟         [23/385]      قَالَ : "" يُرْخِينَ شِبْرًا  ، قُلْتُ : إِذًا يَنْكَشِفُ عَنْهُنَّ ، قَالَ : "" فَذِرَاعًا لَا يَزِدْنَ عَلَيْهِ  .","","Al-Mu'jam al-Kabir 916","","هند بنت أبي أمية زوج رسول الله عن سليمان بن يسار مولى ميمونة زوج رسول الله عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن معتمر بن سليمان عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","سليمان بن يسار عن أم سلمة"
"21515","917  -  حَدَّثَنَا  عُبَيْدٌ ،  ثَنَا  أَبُو بَكْرٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ، وَأَبُو أُسَامَةَ ، وَمُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَيْرٍ  ،  عَنْ  نَافِعٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  سَأَلَتِ  امْرَأَةٌ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ :  يَا رَسُولَ اللهِ إِنِّي أُسْتَحَاضُ ، فَلَا أَطْهُرُ أَفَأَدَعُ الصَّلَاةَ ؟ قَالَ : "" لَا ، وَلَكِنْ دَعِي قَدْرَ الْأَيَّامِ وَاللَّيَالِي الَّتِي كُنْتِ تَحِيضِينَ وَقَدْرَهُنَّ مِنَ  الشَّهْرِ  ، ثُمَّ اغْتَسِلِي وَاسْتَثْفِرِي وَصَلِّي  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عبيد الله بن عمر )","","Al-Mu'jam al-Kabir 917","","هند بنت أبي أمية زوج رسول الله عن سليمان بن يسار مولى ميمونة زوج رسول الله عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن معتمر بن سليمان عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","سليمان بن يسار عن أم سلمة"
"21516","918  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  أَنَا  مَالِكٌ ،  عَنْ  نَافِعٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ  امْرَأَةً  كَانَتْ  تُهَرَاقُ  الدِّمَاءَ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَاسْتَفْتَتْ لَهَا  أُمُّ سَلَمَةَ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ ذَلِكَ فَقَالَ :  لِتَنْظُرْ عِدَّةَ اللَّيَالِي وَالْأَيَّامِ الَّتِي كَانَتْ تَحِيضُهُنَّ وَقَدْرَهُنَّ فَلْتَتْرُكِ الصَّلَاةَ  ، فَإِذَا حَلَفَتْ ذَلِكَ فَلْتَغْتَسِلْ  وَلْتَسْتَثْفِرْ  بِثَوْبٍ وَلْتُصَلِّ  .","","Al-Mu'jam al-Kabir 918","","هند بنت أبي أمية زوج رسول الله عن سليمان بن يسار مولى ميمونة زوج رسول الله عن نافع مولى ابن عمر عن مالك بن أنس عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","سليمان بن يسار عن أم سلمة"
"21517","919  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  سُفْيَانُ ،  ثَنَا  أَيُّوبُ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْحَدِيثَ .","","Al-Mu'jam al-Kabir 919","","هند بنت أبي أمية زوج رسول الله عن سليمان بن يسار مولى ميمونة زوج رسول الله عن أيوب السختياني عن سفيان بن عيينة عن علي ابن المديني عن معاذ بن المثنى العنبري عن الطبراني","سليمان بن يسار عن أم سلمة"
"21518","920  -  حَدَّثَنَا  مُصْعَبٌ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ أَبِي حَازِمٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  نَافِعٍ ، أَنَّ سُلَيْمَانَ بْنَ يَسَارٍ ،  أَخْبَرَهُ  ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ  امْرَأَةً  كَانَتْ  تُهَرَاقُ  الدِّمَاءَ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَاسْتَفْتَتْ لَهَا         [23/386]      أُمُّ سَلَمَةَ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لِتَنْظُرْ عِدَّةَ الْأَيَّامِ وَاللَّيَالِي الَّتِي كَانَتْ تَحِيضُ قَبْلَ أَنْ يَكُونَ بِهَا الَّذِي كَانَ وَقَدْرَهُنَّ مِنَ  الشَّهْرِ  ، فَتَتْرُكِ الصَّلَاةَ لِذَلِكَ ، فَإِذَا حَلَفَتْ لِذَلِكَ فَحَضَرَتِ الصَّلَاةُ فَلْتَغْتَسِلْ وَلْتُصَلِّ  .","","Al-Mu'jam al-Kabir 920","","هند بنت أبي أمية زوج رسول الله عن سليمان بن يسار مولى ميمونة زوج رسول الله عن نافع مولى ابن عمر عن موسى بن عقبة عن عبد العزيز بن أبي حازم المخزومي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","سليمان بن يسار عن أم سلمة"
"21519","عَبْدُ اللهِ بْنُ رَافِعٍ  عَنْ  أُمِّ سَلَمَةَ  .  921  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ رَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" يُصْبِحُ  جُنُبًا  مِنْ غَيْرِ احْتِلَامٍ  ، ثُمَّ يَغْتَسِلُ ، وَيَمْضِي عَلَى صَوْمِهِ  .","","Al-Mu'jam al-Kabir 921","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن أسامة بن زيد الليثي المدني عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبد الله بن رافع عن أم سلمة"
"21520","922  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ الْجُذُوعِيُّ ،  ثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  ثَنَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  مُحَمَّدِ بْنِ يُوسُفَ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  قَرَّبْتُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَنْبًا مَشْوِيًّا فَأَكَلَ مِنْهُ  ، ثُمَّ قَامَ إِلَى الصَّلَاةِ وَلَمْ يَتَوَضَّأْ  .","","Al-Mu'jam al-Kabir 922","","هند بنت أبي أمية زوج رسول الله عن سليمان بن يسار مولى ميمونة زوج رسول الله عن محمد بن يوسف بن عبد الله الأعرج عن ابن جريج عن أبو عاصم النبيل عن عقبة بن مكرم عن الجذوعى محمد بن محمد بن إسماعيل عن الطبراني","عبد الله بن رافع عن أم سلمة"
"21521","عَطَاءُ بْنُ يَسَارٍ  عَنْ  أُمِّ سَلَمَةَ  .  923  -  حَدَّثَنَا  وَاثِلَةُ بْنُ الْحُسَيْنِ  ،  ثَنَا  كَثِيرُ بْنُ عُبَيْدٍ ،  ثَنَا  بَقِيَّةُ ،  عَنْ  إِسْمَاعِيلَ بْنِ عَيَّاشٍ ،  حَدَّثَنِي  أَبُو بَكْرٍ التَّمِيمِيُّ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنِ ابْتُلِيَ بِالْقَضَاءِ بَيْنَ الْمُسْلِمِينَ فَلْيُسَاوِي بَيْنَهُمْ فِي الْمَجْلِسِ فِي الْإِشَارَةِ وَالنَّظَرِ  ، وَلَا يَرْفَعُ صَوْتَهُ عَلَى أَحَدِ الْخَصْمَيْنِ أَكْثَرَ مِنَ الْآخَرِ  .  كذا في طبعة مكتبة ابن تيمية ، ولعل الصواب: (الحسن) .","","Al-Mu'jam al-Kabir 923","","هند بنت أبي أمية زوج رسول الله عن عطاء بن يسار الهلالي عن أبو بكر التميمي عن إسماعيل بن عياش الأحول عن بقية بن الوليد عن كثير بن عبيد المذحجي عن واثلة بن الحسن العرقي عن الطبراني","عطاء بن يسار عن أم سلمة"
"21522","[23/387]      أَبُو سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  924  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْخَلَّالُ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  مُحَمَّدِ بْنِ طَحْلَاءَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ "" يَتَوَضَّأُ مِمَّا مَسَّتِ النَّارُ  .","","Al-Mu'jam al-Kabir 924","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن محمد بن طحلاء الغطفاني عن عبد العزيز بن محمد الدراوردي عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","أبو سلمة عن أم سلمة"
"21523","حُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ  عَنْ  أُمِّ سَلَمَةَ  .  925  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ ،  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  مَخْرَمَةُ ،  عَنْ  أَبِيهِ ،  قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ مُسْلِمٍ ، يَقُولُ :  سَمِعْتُ  مُحَمَّدَ بْنَ مُسْلِمٍ  الْحَدِيثَ ، (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحٍ النَّرْسِيُّ ،  ثَنَا  نَصْرُ بْنُ عَلِيٍّ ،  ثَنَا  ابْنُ أَبِي عَدِيٍّ ،  عَنْ  مُحَمَّدِ بْنِ عُمَرَ  ،  عَنْ  عَمْرِو بْنِ مُسْلِمٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ أَهَلَّ ذَا الْحِجَّةِ وَلَهُ  ذِبْحٌ  يُرِيدُ أَنْ يَذْبَحَهُ ، فَلْيُمْسِكْ عَنْ شَعَرِهِ وَأَظْفَارِهِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( محمد بن عمرو )","","Al-Mu'jam al-Kabir 925","","هند بنت أبي أمية زوج رسول الله عن سعيد بن المسيب عن الزهري عن عبد الله بن مسلم أخو ابن شهاب الزهري عن بكير بن عبد الله بن الأشج القرشي عن مخرمة بن بكير المخزومي عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل بن الحسن الخفاف عن الطبراني","حميد بن عبد الرحمن عن أم سلمة"
"21524","عَبْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ  عَنْ  أُمِّ سَلَمَةَ  .  926  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا         [23/388]      عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الَّذِي يَأْكُلُ أَوْ يَشْرَبُ فِي آنِيَةِ الْفِضَّةِ وَالذَّهَبِ ، إِنَّمَا  يُجَرْجِرُ  فِي بَطْنِهِ نَارَ  جَهَنَّمَ  .  كذا بطبعة مكتبة ابن تيمية ، والصواب : (زيد بن عبد الله).","","Al-Mu'jam al-Kabir 926","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن عبد الرحمن بن أبي بكر الصديق عن زيد بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن عمر العمري عن علي بن مسهر القرشي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبد الله بن عبد الرحمن عن أم سلمة"
"21525","927  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  أَنَا  مَالِكٌ ، (  ح  ) .  وَحَدَّثَنَا  مُصْعَبٌ الزُّبَيْرِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ أَبِي حَازِمٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ، (  ح  ) .  وَحَدَّثَنَا  الشَّافِعِيُّ ، قَالَ :  حَدَّثَنَا  عَمِّي ،  ثَنَا  يَحْيَى بْنُ سُلَيْمَانَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أُمَيَّةَ ، كُلُّهُمْ :  عَنْ  نَافِعٍ ،  عَنْ  زَيْدِ بْنِ عَبْدِ اللهِ ، [  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ ] ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 927","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن عبد الرحمن بن أبي بكر الصديق عن زيد بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن موسى بن عقبة عن عبد العزيز بن أبي حازم المخزومي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","عبد الله بن عبد الرحمن عن أم سلمة"
"21526","928  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ سَعْدٍ ،  ثَنَا  عَمِّي ،  حَدَّثَنَا  أَبِي  ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  أَنَا  نَافِعٌ ، أَنَّ زَيْدَ بْنَ عَبْدِ اللهِ         [23/389]      أَخْبَرَهُ  ، أَنَّ عَبْدَ اللهِ بْنَ عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ  أَخْبَرَهُ  ، أَنَّ أُمَّ سَلَمَةَ  أَخْبَرَتْهُ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ الَّذِي يَشْرَبُ فِي إِنَاءِ الْفِضَّةِ ، إِنَّمَا  يُجَرْجِرُ  فِي بَطْنِهِ نَارَ  جَهَنَّمَ ،  إِلَّا أَنْ يَتُوبَ  .","","Al-Mu'jam al-Kabir 928","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن عبد الرحمن بن أبي بكر الصديق عن زيد بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن صالح بن كيسان الدوسي عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن عبيد الله بن سعد بن إبراهيم الزهري عن أحمد بن يحيى بن زهير التستري عن الطبراني","عبد الله بن عبد الرحمن عن أم سلمة"
"21527","عَبْدُ اللهِ بْنُ الْحَارِثِ بْنِ نَوْفَلٍ  عَنْ  أُمِّ سَلَمَةَ  .  929  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  قَالَ  :  أَرْسَلَ  مُعَاوِيَةُ  إِلَى  أُمِّ سَلَمَةَ  ، فَانْطَلَقَتْ مَعَ الرَّسُولِ ، فَسَأَلَ أُمَّ سَلَمَةَ ، فَقَالَتْ :  إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَدْ نَهَى عَنْهَا ،  يَعْنِي الرَّكْعَتَيْنِ بَعْدَ الْعَصْرِ  ، إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَيْنَمَا هُوَ يَتَوَضَّأُ لِلظُّهْرِ ،  وَكَانَ قَدْ بَعَثَ  سَاعِيًا  وَعِنْدَهُ  الْمُهَاجِرُونَ  وَقَدْ كَانَ يُهِمُّهُ شَأْنُهُمْ إِذْ ضُرِبَ الْبَابُ فَخَرَجَ فَصَلَّى الظُّهْرَ ، ثُمَّ جَاءَ فَقَسَمَ مَا جَاءَ بِهِ فَلَمْ يَزَلْ كَذَلِكَ حَتَّى صَلَّى الْعَصْرَ ، ثُمَّ دَخَلَ مَنْزِلَهُ فَصَلَّى رَكْعَتَيْنِ ، ثُمَّ قَالَ : "" شَغَلَنِي أَمْرُ السَّاعِي ، أَنْ أُصَلِّيَهُمَا بَعْدَ الظُّهْرِ فَصَلَّيْتُهُمَا بَعْدَ الْعَصْرِ  .","","Al-Mu'jam al-Kabir 929","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن الحارث بن نوفل عن يزيد بن أبي زياد القرشي عن عبد الله بن إدريس الأودي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبد الله بن الحارث بن نوفل عن أم سلمة"
"21528","930  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ الْمُخَرِّمِيُّ ،  ثَنَا  عَفَّانُ بْنُ         [23/390]      مُسْلِمٍ ،  ثَنَا  عِمْرَانُ الْقَطَّانُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْخَلِيلِ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يُبَايَعُ لِرَجُلٍ بَيْنَ الرُّكْنِ وَالْمَقَامِ عِدَّةُ  أَهْلِ بَدْرٍ  ،  فَيَأْتِيهِ  عَصَائِبُ  أَهْلِ الْعِرَاقِ  وَأَبْدَالُ الشَّامِ  ، فَيَغْزُوهُمْ جَيْشٌ مِنْ قِبَلِ  الشَّامِ  حَتَّى إِذَا كَانُوا  بِالْبَيْدَاءِ  خُسِفَ بِهِمْ ، ثُمَّ يَغْزُوهُمْ رَجُلٌ مِنْ  قُرَيْشٍ  أَخْوَالُهُ  كَلْبٌ  ، فَيَلْتَقُونَ فَيَهْزِمُهُمُ اللهُ "" . "" فَكَانَ يُقَالُ : الْخَائِبُ مَنْ خَابَ مِنْ غَنِيمَةِ  كَلْبٍ  .","","Al-Mu'jam al-Kabir 930","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن الحارث بن نوفل عن صالح بن أبي مريم الضبعي عن قتادة بن دعامة عن عمران بن داور القطان عن عفان بن مسلم الصفار عن يعقوب بن إسحاق البيهسي عن الطبراني","عبد الله بن الحارث بن نوفل عن أم سلمة"
"21529","مُجَاهِدٌ  عَنْ  أُمِّ سَلَمَةَ  .  931  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  مَعْمَرٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَكُونُ اخْتِلَافٌ عِنْدَ مَوْتِ  خَلِيفَةٍ  ، فَيَخْرُجُ رَجُلٌ مِنْ  بَنِي هَاشِمٍ  مِنَ  الْمَدِينَةِ  إِلَى  مَكَّةَ  فَيَجِيئُهُ نَاسٌ  فَيُبَايِعُونَهُ  بَيْنَ الرُّكْنِ وَالْمَقَامِ  ، وَهُوَ كَارِهٌ ،  فَيُجَهَّزُ  لَهُمْ جَيْشٌ مِنَ  الشَّامِ  حَتَّى إِذَا كَانُوا  بِالْبَيْدَاءِ  خُسِفَ بِهِمْ ، فَيَأْتِيهِمْ  عَصَائِبُ  أَهْلِ الْعِرَاقِ  وَأَبْدَالُ الشَّامِ  ، وَيَنْشُو رَجُلٌ  بِالشَّامِ  أَخْوَالُهُ  كَلْبٌ  ،  فَيُجَهِّزُ  إِلَيْهِمْ جَيْشًا ، فَيَهْزِمُهُمُ اللهُ ، وَتَكُونُ  الدَّائِرَةُ  عَلَيْهِمْ ،         [23/391]      وَذَلِكَ يَوْمُ  كَلْبٍ  ، وَالْخَائِبُ مَنْ خَابَ مِنْ غَنِيمَةِ  كَلْبٍ  ، وَيَسْتَخْرِجُ الْكُنُوزَ ، وَيَقْسِمُ الْأَمْوَالَ ، وَيُلْقَى الْإِسْلَامُ بِجِرَابِهِ إِلَى الْأَرْضِ ، يَعِيشُ فِي ذَلِكَ  سَبْعَ سِنِينَ أَوْ سِتَّ سِنِينَ  .  قَالَ  عُبَيْدُ اللهِ  :  فَحَدَّثْتُ بِهِ  لَيْثًا ، فَقَالَ :  حَدَّثَنِيهِ  مُجَاهِدٌ .","","Al-Mu'jam al-Kabir 931","","هند بنت أبي أمية زوج رسول الله عن مجاهد بن جبر المخزومي عن قتادة بن دعامة عن معمر بن راشد عن عبيد الله بن عمرو بن أبي الوليد عن حفص بن عمر سنجة ألف عن الطبراني","مجاهد عن أم سلمة"
"21530","932  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  عَنْ  شَيْبَانَ  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  أَنَّ  أُمَّ سَلَمَةَ ،  قَالَتْ : يَا رَسُولَ اللهِ إِنَّ  هِشَامَ بْنَ الْمُغِيرَةِ  كَانَ يُطْعِمُ الطَّعَامَ ، وَيَقْرِي الضَّيْفَ ، وَيَصِلُ الرَّحِمَ ، وَيَفُكُّ  الْعَانِيَ  ، فَلَوْ أَدْرَكَكَ أَسْلَمَ ، فَهَلْ لَهُ فِي ذَلِكَ أَجْرٌ ؟ قَالَ :  إِنَّهُ عَمُّكِ كَانَ يُعْطِي لِلدُّنْيَا وَذِكْرِهَا وَجَمَالِهَا ، وَمَا قَالَ يَوْمًا قَطُّ اغْفِرْ لِي يَوْمَ الدِّينِ  .","","Al-Mu'jam al-Kabir 932","","هند بنت أبي أمية زوج رسول الله عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","مجاهد عن أم سلمة"
"21531","933  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي ،  ثَنَا  وَكِيعٌ ،  ثَنَا  الْمِنْهَالُ بْنُ خَلِيفَةَ ،  عَنْ  خَالِدِ بْنِ سَلَمَةَ ،  عَنْ  مُجَاهِدٍ  ، عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  إِنْ كَانَتْ إِحْدَانَا لَتَحِيضُ وَمَا لَهَا إِلَّا ثَوْبٌ وَاحِدٌ  ، وَإِنَّ إِحْدَانَا الْيَوْمَ  لَتُفْرِغُ  خَادِمَهَا لِتَغْسِلَ ثِيَابَهَا لِيُطَهِّرَهَا  "" .","","Al-Mu'jam al-Kabir 933","","هند بنت أبي أمية زوج رسول الله عن مجاهد بن جبر المخزومي عن الفأفأ ، خالد بن سلمة بن العاص عن المنهال بن خليفة العجلي عن وكيع بن الجراح عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","مجاهد عن أم سلمة"
"21532","934  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْخَلَّالُ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ ، قَالَ :  سُئِلَتْ  أُمُّ سَلَمَةَ هَلْ تُغَطِّي الْمَرْأَةُ وَجْهَهَا وَهِيَ مُحْرِمَةٌ ؟ فَقَالَتْ :  كَانَ الرَّكْبُ يَمُرُّونَ عَلَيْنَا ، وَنَحْنُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَتَسْدُلُ إِحْدَانَا عَلَى وَجْهِهَا الثَّوْبَ  .","","Al-Mu'jam al-Kabir 934","","هند بنت أبي أمية زوج رسول الله عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن سفيان بن عيينة عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","مجاهد عن أم سلمة"
"21533","[23/392]      عُبَيْدُ بْنُ عُمَيْرٍ  عَنْ  أُمِّ سَلَمَةَ  .  935  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ الْجُذُوعِيُّ ،  ثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  ثَنَا  عِيسَى بْنُ شُعَيْبٍ ،  ثَنَا  رَوْحُ بْنُ الْقَاسِمِ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كُنْتُ أَغْتَسِلُ أَنَا وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ إِنَاءٍ وَاحِدٍ يَأْخُذُ كُلُّ وَاحِدٍ مِنَّا عَلَى  حِدَتِهِ  .","","Al-Mu'jam al-Kabir 935","","هند بنت أبي أمية زوج رسول الله عن عبيد بن عمير بن قتادة الجندعي عن أبو الزبير المكي عن روح بن القاسم العنبري عن عيسى بن شعيب بن إبراهيم النحوي عن عقبة بن مكرم عن الجذوعى محمد بن محمد بن إسماعيل عن الطبراني","عبيد بن عمير عن أم سلمة"
"21534","936  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ الْخَشَّابُ الرَّقِّيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ جَعْفَرٍ  ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  أَبِي سَعْدٍ الْأَنْصَارِيِّ ،  عَنْ  رَجُلٍ مِنْ أَهْلِ الْمَدِينَةِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كُنْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَصَابَنِي حَيْضٌ فَخَرَجْتُ مِنَ الْفِرَاشِ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اتَّزِرِي وَعُودِي  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عبد الله بن جعفر )","","Al-Mu'jam al-Kabir 936","","هند بنت أبي أمية زوج رسول الله عن رجل من أهل المدينة عن شرحبيل بن سعد الخطمي عن زيد بن أبي أنيسة الجزري عن عبيد الله بن عمرو بن أبي الوليد عن عبد الله بن جعفر بن غيلان عن أحمد بن إسحاق بن يوسف الرقي عن الطبراني","عبيد بن عمير عن أم سلمة"
"21535","ابْنُ أَبِي مُلَيْكَةَ  عَنْ  أُمِّ سَلَمَةَ  .  937  -  حَدَّثَنَا  عُبَيْدٌ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْرَأُ :         {      بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ             *          الْحَمْدُ لِلهِ رَبِّ الْعَالَمِينَ         }      ،  يَعْنِي حَرْفًا حَرْفًا  .","","Al-Mu'jam al-Kabir 937","","هند بنت أبي أمية زوج رسول الله عن ابن أبي مليكة عن ابن جريج عن حفص بن غياث النخعي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","ابن أبي مليكة عن أم سلمة"
"21536","الْمُطَّلِبُ بْنُ عَبْدِ اللهِ بْنِ حَنْطَبٍ  عَنْ  أُمِّ سَلَمَةَ  .  938  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ ،  ثَنَا  أَبِي ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي حُمَيْدٍ ،  عَنِ  الْمُطَّلِبِ بْنِ عَبْدِ اللهِ بْنِ حَنْطَبٍ ،  عَنْ         [23/393]      أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ أَنْفَقَ عَلَى ابْنَتَيْنِ أَوْ أُخْتَيْنِ أَوْ ذَوَاتَيْ قَرَابَةٍ يَحْتَسِبُ النَّفَقَةَ عَلَيْهِمَا حَتَّى يَكْفِيَهُمَا اللهُ يُغْنِيَهُمَا مِنْ فَضْلِهِ  كَانَتَا لَهُ سِتْرًا مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 938","","هند بنت أبي أمية زوج رسول الله عن المطلب بن عبد الله بن حنطب المخزومي عن محمد بن أبي حميد الزرقي عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","المطلب بن عبد الله بن حنطب عن أم سلمة"
"21537","أَبُو عَطِيَّةَ الطُّفَاوِيُّ  عَنْ  أُمِّ سَلَمَةَ  .  939  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  أَبُو ظَفَرٍ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ مُطَهَّرٍ ،  ثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ ،  عَنْ  عَوْفٍ ، (  ح  )  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو أُسَامَةَ ،  ثَنَا  عَوْفٌ ،  عَنْ  عَطِيَّةَ أَبِي الْمُعَدِّلِ الطُّفَاوِيِّ ،  عَنْ  أَبِيهِ  ، قَالَ :  أَخْبَرَتْنِي  أُمُّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ عِنْدَهَا وَفِي بَيْتِهَا ذَاتَ يَوْمٍ فَجَاءَتِ الْخَادِمُ فَقَالَتْ : إِنَّ  عَلِيًّا  وَفَاطِمَةَ  بِالسُّدَّةِ  ، فَقَالَ :  تَنَحَّيْ لِي عَنْ أَهْلِ بَيْتِي  ، فَتَنَحَّيْتُ فِي نَاحِيَةِ الْبَيْتِ وَجَاءَ  عَلِيٌّ  وَفَاطِمَةُ  وَحَسَنٌ  وَحُسَيْنٌ  وَهُمَا صَبِيَّانِ صَغِيرَانِ ، فَأَخَذَ  حَسَنًا  وَحُسَيْنًا  وَوَضَعَهُمَا فِي حِجْرِهِ ، وَأَخَذَ  عَلِيًّا  بِإِحْدَى يَدَيْهِ فَضَمَّهُ إِلَيْهِ ، وَغَدَقَ عَلَيْهِمْ قَطِيفَةً سَوْدَاءَ ثُمَّ قَالَ : "" اللَّهُمَّ إِلَيْكَ لَا إِلَى النَّارِ أَنَا وَأَهْلُ بَيْتِي "" ، قَالَتْ : فَنَادَيْتُهُ ، فَقُلْتُ : وَأَنَا يَا رَسُولَ اللهِ ، قَالَ : "" وَأَنْتِ  .","","Al-Mu'jam al-Kabir 939","","هند بنت أبي أمية زوج رسول الله عن والد عطية الطفاوي عن عطية الطفاوي عن عوف بن أبي جميلة عن جعفر بن سليمان الضبعي عن عبد السلام بن مطهر الأزدي عن أبو ظفر عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","أبو عطية الطفاوي عن أم سلمة"
"21538","أَبُو وَائِلٍ  عَنْ  أُمِّ سَلَمَةَ  .  940  -  حَدَّثَنَا  عُبَيْدٌ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  شَقِيقٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا حَضَرْتُمُ الْمَرِيضَ أَوِ الْمَيِّتَ فَقُولُوا خَيْرًا ، فَإِنَّ الْمَلَائِكَةَ يُؤَمِّنُونَ عَلَى مَا تَقُولُونَ  ، قَالَتْ : فَلَمَّا مَاتَ  أَبُو سَلَمَةَ  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [23/394]      فَقُلْتُ : يَا رَسُولَ اللهِ إِنَّ  أَبَا سَلَمَةَ  قَدْ مَاتَ ، فَقَالَ : "" قُولِي اللَّهُمَّ اغْفِرْ لِي وَلَهُ وَأَعْقِبْنِي مِنْهُ عُقْبَى حَسَنَةً "" فَفَعَلْتُ ، فَأَعْقَبَنِي اللهُ مَنْ هُوَ خَيْرٌ مِنْهُ  مُحَمَّدًا  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 940","","هند بنت أبي أمية زوج رسول الله عن شقيق بن سلمة عن الأعمش عن أبو معاوية الضرير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو وائل عن أم سلمة"
"21539","941  -  حَدَّثَنَا  عُبَيْدٌ ،  ثَنَا  أَبُو بَكْرٍ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  شَقِيقٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  قَالَتْ : دَخَلَ عَلَيْهَا  عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  ، فَقَالَ : يَا أُمَّهْ قَدْ خَشِيتُ أَنْ يُهْلِكَنِي كَثْرَةُ مَالِي أَنَا أَكْثَرُ  قُرَيْشٍ  مَالًا ، فَقَالَتْ : يَا بُنَيَّ  تَصَدَّقْ  ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ مِنْ أَصْحَابِي مَنْ لَنْ يَرَنِي بَعْدَ أَنْ أَمُوتَ  ، فَخَرَجَ  عَبْدُ الرَّحْمَنِ  ، فَلَقِيَ  عُمَرَ  ، فَأَخْبَرَهُ بِمَا قَالَتْ  أُمُّ سَلَمَةَ  ، فَجَاءَ  عُمَرُ  ، فَدَخَلَ عَلَيْهَا ، فَقَالَ : أَنَا مِنْهُمْ ؟ فَقَالَتْ : لَا ، وَلَنْ أَقُولَ ذَلِكَ لِأَحَدٍ بَعْدَكَ  .","","Al-Mu'jam al-Kabir 941","","هند بنت أبي أمية زوج رسول الله عن شقيق بن سلمة عن الأعمش عن أبو معاوية الضرير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو وائل عن أم سلمة"
"21540","زَاذَانُ  عَنْ  أُمِّ سَلَمَةَ  .  942  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ ،  ثَنَا  أَبِي  ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ مُسْلِمٍ السِّرَاجِ ،  عَنْ  مَيْمُونِ بْنِ أَبِي مَيْمُونٍ ،  عَنْ  زَاذَانَ ،  قَالَ  :  رَأَتْ أُمُّ سَلَمَةَ ابْنَ عَمٍّ لَهَا سَاجِدًا ، فَقَالَتْ : تَرِّبْ وَجْهَكَ فَإِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ لِمَوْلًى لَنَا يُقَالُ لَهُ  رَبَاحٌ  رَآهُ سَاجِدًا :  تَرِّبْ وَجْهَكَ يَا  رَبَاحُ  .","","Al-Mu'jam al-Kabir 942","","هند بنت أبي أمية زوج رسول الله عن أبو صالح مولى طلحة بن عبيد الله عن ميمون القصاب عن المغيرة بن مسلم القسملي عن مروان بن معاوية الفزاري عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","زاذان عن أم سلمة"
"21541","أَبُو الْعَالِيَةِ  عَنْ  أُمِّ سَلَمَةَ  .  943  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،         [23/395]      ثَنَا  إِسْحَاقُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِي جَعْفَرٍ الرَّازِيِّ ،  عَنِ  الرَّبِيعِ بْنِ أَنَسٍ ،  عَنْ  أَبِي الْعَالِيَةِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْرَأُ : ( بَلَى قَدْ جَاءَتْكِ آيَاتِي فَكَذَّبْتِ بِهَا وَاسْتَكْبَرْتِ )  .","","Al-Mu'jam al-Kabir 943","","هند بنت أبي أمية زوج رسول الله عن رفيع بن مهران عن الربيع بن أنس البكري عن عيسى بن أبي عيسى الرازي عن إسحاق بن سليمان الرازي عن نعيم بن حماد الخزاعي عن يحيى بن عثمان بن صالح عن الطبراني","أبو العالية عن أم سلمة"
"21542","عَبْدُ اللهِ بْنُ الْحَسَنِ  عَنْ  أُمِّ سَلَمَةَ  .  944  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ الْحِمْصِيُّ ،  ثَنَا  عَمْرُو بْنُ عُثْمَانَ ،  ثَنَا  رَوَّادُ بْنُ الْجَرَّاحِ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُسْلِمٍ  ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَسَنِ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ لَمْ يَكُنْ فِيهِ وَاحِدَةٌ مِنْ ثَلَاثٍ ، فَلَا يَحْتَسِبُ بِشَيْءٍ مِنْ عَمَلِهِ : تَقْوَى يَحْجِزُهُ عَنْ مَعَاصِي اللهِ  ، أَوْ حِلْمٌ يَكُفُّ بِهِ سَفِيهًا ، أَوْ  خُلُقٌ  يَعِيشُ بِهِ فِي النَّاسِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : (محمد بن مسلم).","","Al-Mu'jam al-Kabir 944","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن حسن بن حسن بن علي بن أبي طالب عن محمد بن مسلم بن سوسن الطائفي عن رواد بن الجراح عن عمرو بن عثمان بن سعيد الحمصي عن إبراهيم بن محمد بن عرق الحمصي عن الطبراني","عبد الله بن الحسن عن أم سلمة"
"21543","945  -  وَأَنَّ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ كَانَ فِيهِ وَاحِدَةٌ مِنْ ثَلَاثٍ زَوَّجَهُ اللهُ مِنَ الْحُورِ  الْعِينِ  : مَنْ كَانَتْ عِنْدَهُ  - يَعْنِي - أَمَانَةٌ خَفِيَّةٌ شَهِيَّةٌ ، فَأَدَّاهَا مِنْ مَخَافَةِ اللهِ ، أَوْ رَجُلٌ عَفَا عَنْ قَاتِلِهِ ، أَوْ رَجُلٌ قَرَأَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      دُبُرَ كُلِّ صَلَاةٍ  .","","Al-Mu'jam al-Kabir 945","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن الحسن عن عبد الله بن مسلم عن رواد بن الجراح عن عمرو بن عثمان بن سعيد الحمصي عن إبراهيم بن محمد بن عرق الحمصي عن الطبراني","عبد الله بن الحسن عن أم سلمة"
"21544","مَالِكُ بْنُ جَعْوَنَةَ  عَنْ  أُمِّ سَلَمَةَ  .  946  -  حَدَّثَنَا  الْأَسْفَاطِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ الْخَطَّابِ ،  ثَنَا  عَلِيُّ         [23/396]      بْنُ غُرَابٍ ،  عَنْ  مُوسَى بْنِ قَيْسٍ الْحَضْرَمِيِّ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  عِيَاضٍ ،  عَنْ  مَالِكِ بْنِ جَعْوَنَةَ  ، سَمِعْتُ  أُمَّ سَلَمَةَ ، تَقُولُ :  عَلِيٌّ  عَلَى الْحَقِّ ، فَمَنِ اتَّبَعَهُ اتَّبَعَ الْحَقَّ ، وَمَنْ تَرَكَهُ تَرَكَ الْحَقَّ عَهْدٌ مَعْهُودٌ قَبْلَ مَوْتِهِ  "" .","","Al-Mu'jam al-Kabir 946","","هند بنت أبي أمية زوج رسول الله عن مالك بن جعونة عن عياض بن عياض بن خليفة الخزاعي عن سلمة بن كهيل الحضرمي عن عصفور الجنة  ، موسى بن قيس الفراء عن علي بن عبد العزيز الفزاري عن عبد العزيز بن الخطاب الكوفي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","مالك بن جعونة عن أم سلمة"
"21545","شَهْرُ بْنُ حَوْشَبٍ  عَنْ  أُمِّ سَلَمَةَ  .  947  -  حَدَّثَنَا  عَلَّانُ بْنُ عَبْدِ الصَّمَدِ  ، حَدَّثَنَا  الْقَاسِمُ بْنُ دِينَارٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  إِسْمَاعِيلُ بْنُ نَشِيطٍ ، قَالَ :  سَمِعْتُ  شَهْرَ بْنَ حَوْشَبٍ ، قَالَ :  أَتَيْتُ أُمَّ سَلَمَةَ أُعَرِّفُهَا عَلَى  الْحُسَيْنِ  ، فَقَالَتْ لِي فِيمَا  حَدَّثَتْنِي  : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ فِي بَيْتِي يَوْمًا ، وَإِنَّ  فَاطِمَةَ  جَاءَتْهُ بِسَخِيَّةٍ ، فَقَالَ : "" انْطَلِقِي فَجِيئِي  بِزَوْجِكِ أَوِ ابْنِ عَمِّكِ  وَابْنَيْكِ "" ، فَانْطَلَقْتُ فَجَاءَتْ  بِعَلِيٍّ  وَحَسَنٍ  وَحُسَيْنٍ  ، فَأَكَلُوا مِنْ ذَلِكَ الطَّعَامِ ، وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى مَنَامَةٍ لَنَا ، وَتَحْتَهُ كِسَاءٌ خَيْبَرِيٌّ فَأَخَذَ الْكِسَاءَ فَجَلَّلَهُمْ إِيَّاهُ ، ثُمَّ رَفَعَ يَدَيْهِ إِلَى السَّمَاءِ ثُمَّ قَالَ :  اللَّهُمَّ هَؤُلَاءِ  عِتْرَتِي  وَأَهْلِي فَأَذْهِبْ عَنْهُمُ الرِّجْسَ وَطَهِّرْهُمْ تَطْهِيرًا  ، فَقَالَتْ  أُمُّ سَلَمَةَ  : وَأَنَا مِنْ أَهْلِ بَيْتِكَ ؟ فَقَالَ : "" وَأَنْتِ إِلَى خَيْرٍ  .","","Al-Mu'jam al-Kabir 947","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن إسماعيل بن نشيط العامري عن عبيد الله بن موسى عن القاسم بن زكريا الطحان عن علي بن عبد الصمد علان ماغمه عن الطبراني","شهر بن حوشب عن أم سلمة"
"21546","أَبُو سَلَّامٍ الْحَبَشِيُّ  عَنْ  أُمِّ سَلَمَةَ  .  948  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ ،  ثَنَا  أَبِي ،  ثَنَا  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  شَدَّادٌ أَبُو مُحَمَّدٍ ،  عَنْ  أَبِي سَلَّامٍ الْأَسْوَدِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :         [23/397]      مَرَّ بِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا أَبْكِي عَلَى  أَبِي سَلَمَةَ  ، فَقَالَ :  أَلَا أَدُلُّكِ عَلَى خَيْرٍ مِمَّا تَقُولِينَ ؟  تَسْتَرْجِعِينَ وَتَقُولِينَ : اللَّهُمَّ أَحْسِنْ عُقْبَايَ  وَاجْبُرْ  مُصِيبَتِي ، وَأَبْدِلْنِي بِهِ خَيْرًا مِنْهُ "" ، فَرَجَعْتُ وَقُلْتُ مَا قَالَ لِي ، ثُمَّ جَعَلْتُ أَقُولُ : وَأَيْنَ لِي مِثْلُ  أَبِي سَلَمَةَ  ؟ قَالَتْ : وَأَبْدَلَنِي اللهُ بِهِ خَيْرًا مِنْ  أَبِي سَلَمَةَ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  .","","Al-Mu'jam al-Kabir 948","","هند بنت أبي أمية زوج رسول الله عن ممطور الحبشي عن شداد بن أبي سلام الخولاني عن سويد بن عبد العزيز السلمي عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","أبو سلام الحبشي عن أم سلمة"
"21547","عَبْدُ اللهِ بْنُ وَهْبِ بْنِ زَمْعَةَ  عَنْ  أُمِّ سَلَمَةَ  .  949  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  مُوسَى بْنُ يَعْقُوبَ ،  حَدَّثَتْنِي  عَمَّتِي قَرِيبَةُ بِنْتُ عَبْدِ اللهِ ،  أَنَّ  أَبَاهَا ،  قَالَتْ لَهُ  أُمُّ سَلَمَةَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا مِنِ امْرِئٍ يُحْيِي أَرْضًا ، فَيَشْرَبُ مِنْهُ كَبِدٌ  حَرَّى  أَوْ يُصِيبُ مِنْهُ عَافِيَةٌ ، إِلَّا كَتَبَ اللهُ لَهُ بِهِ أَجْرًا  .","","Al-Mu'jam al-Kabir 949","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن وهب بن زمعة الغنمي عن قريبة بنت عبد الله بن وهب الأسدية عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","عبد الله بن وهب بن زمعة عن أم سلمة"
"21548","950  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدِ بْنِ عُقْبَةَ الشَّيْبَانِيُّ ،  ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ خَالِدِ بْنِ عَثْمَةَ ،  ثَنَا  مُوسَى بْنُ يَعْقُوبَ الزَّمْعِيُّ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ وَهْبِ بْنِ زَمْعَةَ ، أَنَّ أَبَاهُ  أَخْبَرَهُ  ، أَنَّ أُمَّ سَلَمَةَ زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَخْبَرَتْهُ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ "" يَدْخُلُ عَلَى أَزْوَاجِهِ كُلَّ غَدَاةٍ فَيُسَلِّمُ عَلَيْهِنَّ ، وَكَانَتِ  امْرَأَةٌ مِنْهُنَّ  عِنْدَهَا عَسَلٌ ، فَكُلَّمَا دَخَلَ عَلَيْهَا أَحْضَرَتْ لَهُ مِنْهُ ، فَيَمْكُثُ عِنْدَهَا لِذَلِكَ ، وَأَنَّ  عَائِشَةَ         [23/398]      وَحَفْصَةَ  وَجَدَتَا مِنْ ذَلِكَ ، فَقَالَتَا حِينَ دَخَلَ عَلَيْهِمَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّا نَجِدُ مِنْكَ رِيحَ مَعَافِيرَ ، "" فَتَرَكَ ذَلِكَ الْعَسَلَ  .","","Al-Mu'jam al-Kabir 950","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن وهب بن زمعة الغنمي عن يزيد بن عبد الله بن وهب بن زمعة عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن محمد بن خالد بن عثمة الهاشمى عن الحسن بن علي الريحاني عن محمد بن محمد بن عقبة الشيباني عن الطبراني","عبد الله بن وهب بن زمعة عن أم سلمة"
"21549","951  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ ،  ثَنَا  أَبِي ،  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  عَنْ  مُوسَى بْنِ يَعْقُوبَ الزَّمْعِيِّ ،  عَنْ  عَمَّتِهِ قَرِيبَةَ بِنْتِ عَبْدِ اللهِ بْنِ وَهْبِ بْنِ زَمْعَةَ ،  عَنْ  أَبِيهَا ،  قَالَ :  أَخْبَرَتْنِي  أُمُّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَعَنَ اللهُ  الرَّاشِيَ  وَالْمُرْتَشِيَ فِي الْحُكْمِ  .","","Al-Mu'jam al-Kabir 951","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن وهب بن زمعة الغنمي عن قريبة بنت عبد الله بن وهب الأسدية عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن محمد بن إسماعيل بن مسلم الديلي عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","عبد الله بن وهب بن زمعة عن أم سلمة"
"21550","أَبُو عُبَيْدَةَ بْنُ عَبْدِ اللهِ بْنِ زَمْعَةَ  عَنْ  أُمِّ سَلَمَةَ  .  952  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ ،  ثَنَا  أَبِي ،  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ،         [23/399]      ثَنَا  زَكَرِيَّا بْنُ إِبْرَاهِيمَ بْنِ عَبْدِ اللهِ بْنِ مُطِيعٍ الْعَدَوِيُّ ،  عَنْ  رُكَيْحِ بْنِ أَبِي عُبَيْدَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  مَا لِي أَرَاكِ  مُرْتَثَّةً  ؟ "" ، فَقُلْتُ : شَرِبْتُ دَوَاءً أَسْتَحْشِي بِهِ ، قَالَ : "" وَمَا هُوَ ؟ "" ،  قُلْتُ :  الشُّبْرُمُ  ، قَالَ : "" وَمَا لَكِ وَالشُّبْرُمُ ؟ "" ، قَالَ : "" فَإِنَّهُ حَارٌّ نَارٌ ، عَلَيْكِ بِالسَّنَا  وَالسَّنُّوتِ  فَإِنَّ فِيهِمَا دَوَاءً مِنْ كُلِّ شَيْءٍ ، إِلَّا  السَّامَ  .","","Al-Mu'jam al-Kabir 952","","هند بنت أبي أمية زوج رسول الله عن أبو عبيدة بن عبد الله بن زمعة الأسدي عن ركيح بن أبى عبيدة عن زكريا بن إبراهيم بن عبد الله عن محمد بن إسماعيل بن مسلم الديلي عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","أبو عبيدة بن عبد الله بن زمعة عن أم سلمة"
"21551","953  -  وَعَنْ  رُكَيْحِ بْنِ أَبِي عُبَيْدَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  أُمِّهِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  رُبَّمَا صَبَغَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رِدَاءَهُ وَإِزَارَهُ  بِزَعْفَرَانٍ ، أَوْ وَرْسٍ  ثُمَّ خَرَجَ فِيهِمَا  .","","Al-Mu'jam al-Kabir 953","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو عبيدة بن عبد الله بن زمعة الأسدي عن ركيح بن أبى عبيدة عن زكريا بن إبراهيم بن عبد الله عن محمد بن إسماعيل بن مسلم الديلي عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","أبو عبيدة بن عبد الله بن زمعة عن أم سلمة"
"21552","مِقْسَمٌ  عَنْ  أُمِّ سَلَمَةَ  .  954  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  حُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  زُهَيْرٍ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الْحَكَمِ ،  عَنْ  مِقْسَمٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" يُوتِرُ  بِتِسْعٍ أَوْ عَشْرٍ  لَا يَفْصِلُ بَيْنَهُنَّ بِتَسْلِيمٍ ، وَلَا كَلَامٍ  .","","Al-Mu'jam al-Kabir 954","","هند بنت أبي أمية زوج رسول الله عن مقسم بن بجرة عن الحكم بن عتيبة الكندي عن منصور بن المعتمر عن زهير بن معاوية بن حديج عن حميد بن عبد الرحمن الرؤاسي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","مقسم عن أم سلمة"
"21553","نَبْهَانُ  عَنْ  أُمِّ سَلَمَةَ  .  955  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  نَبْهَانَ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [23/400]      [ أَنَّهُ قَالَ ] :  إِذَا كَانَ لِإِحْدَاكُنَّ مُكَاتَبٌ ، وَكَانَ عِنْدَهُ مَا يُؤَدِّي فَلْتَحْتَجِبْ مِنْهُ  .","","Al-Mu'jam al-Kabir 955","","هند بنت أبي أمية زوج رسول الله عن نبهان المخزومي مولى أم سلمة عن الزهري عن سفيان بن عيينة عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","نبهان عن أم سلمة"
"21554","956  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَنَا  نَافِعٌ ،  عَنِ  ابْنِ يَزِيدَ ،  عَنْ  عُقَيْلٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  نَبْهَانَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كُنْتُ عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعِنْدَهُ  مَيْمُونَةُ  فَأَقْبَلَ  ابْنُ أُمِّ كُلْثُومٍ  الْحَدِيثَ .","","Al-Mu'jam al-Kabir 956","","هند بنت أبي أمية زوج رسول الله عن نبهان المخزومي مولى أم سلمة عن الزهري عن عقيل بن خالد الأيلي عن خالد بن يزيد الجمحي عن نافع بن عمر بن عبد الله بن جميل الجمحي عن سعيد بن الحكم الجمحي عن يحيى بن عثمان بن صالح عن الطبراني","نبهان عن أم سلمة"
"21555","ابْنُ سَفِينَةَ  عَنْ  أُمِّ سَلَمَةَ  .  957  -  حَدَّثَنَا  عُبَيْدٌ ،  ثَنَا  أَبُو بَكْرٍ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  سَعْدِ بْنِ سَعِيدٍ ، قَالَ :  أَخْبَرَنِي  عُمَرُ بْنُ كَثِيرِ بْنِ أَفْلَحَ ، قَالَ :  سَمِعْتُ  ابْنَ سَفِينَةَ ، يَذْكُرُ  أَنَّهُ سَمِعَ  أُمَّ سَلَمَةَ ، تَقُولُ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا مِنْ عَبْدٍ تُصِيبُهُ مُصِيبَةٌ  ، الْحَدِيثَ وَهُوَ فِي كِتَابِ الْمَوْتِ .","","Al-Mu'jam al-Kabir 957","","هند بنت أبي أمية زوج رسول الله عن عمر بن سفينة الهاشمي عن عمر بن كثير بن أفلح المدني عن سعد بن سعيد بن قيس الأنصاري عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","ابن سفينة عن أم سلمة"
"21556","958  -  حَدَّثَنَا  عُبَيْدٌ ،  ثَنَا  أَبُو بَكْرٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  سَعْدِ بْنِ سَعِيدٍ ،  عَنْ  عُمَرَ بْنِ كَثِيرِ بْنِ أَفْلَحَ ،  عَنِ  ابْنِ سَفِينَةَ مَوْلَى أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا مِنْ عَبْدٍ يُصَابُ بِمُصِيبَةٍ  الْحَدِيثَ .","","Al-Mu'jam al-Kabir 958","","هند بنت أبي أمية زوج رسول الله عن عمر بن سفينة الهاشمي عن عمر بن كثير بن أفلح المدني عن سعد بن سعيد بن قيس الأنصاري عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","ابن سفينة عن أم سلمة"
"21557","ثَابِتٌ مَوْلَى أُمِّ سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  959  -  حَدَّثَنَا  مُصْعَبٌ ،  ثَنَا  أَبِي ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  مُوسَى بْنِ عُبَيْدَةَ بْنِ نَشِيطٍ ،  عَنْ  ثَابِتٍ مَوْلَى أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ نَبِيَّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - انْصَرَفَ إِلَى بَيْتِهَا ، فَصَلَّى فِيهِ رَكْعَتَيْنِ بَعْدَ الْعَصْرِ ،         [23/401]      فَأَرْسَلَتْ  عَائِشَةُ  إِلَى  أُمِّ سَلَمَةَ  : مَا هَذِهِ الصَّلَاةُ الَّتِي صَلَّاهَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي بَيْتِكِ ، فَقَالَتْ :  إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ "" يُصَلِّي بَعْدَ الظُّهْرِ رَكْعَتَيْنِ ، فَقَدِمَ عَلَيْهِ وَفْدُ  بَنِي الْمُصْطَلِقِ  فِي  شَأْنِ  مَا صَنَعَ بِهِمْ عَامِلُهُمُ  الْوَلِيدُ بْنُ عُقْبَةَ  ،  فَلَمْ يَزَالُوا يَعْتَذِرُونَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى جَاءَ الْمُؤَذِّنُ يَدْعُوهُ إِلَى صَلَاةِ الْعَصْرِ ، فَصَلَّى الْمَكْتُوبَةَ ، ثُمَّ صَلَّى عِنْدِي فِي بَيْتِي تِلْكَ الرَّكْعَتَيْنِ مَا صَلَّاهُمَا قَبْلُ وَلَا بَعْدُ  .","","Al-Mu'jam al-Kabir 959","","هند بنت أبي أمية زوج رسول الله عن ثابت مولى أم سلمة عن موسى بن عبيدة بن نشيط الحميري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","ثابت مولى أم سلمة عن أم سلمة"
"21558","960  -  وَعَنْ  أُمِّ سَلَمَةَ  أَنَّهُ نَزَلَ فِي  بَنِي الْمُصْطَلِقِ  فِي  شَأْنِ  مَا صَنَعَ بِهِمْ عَامِلُهُمُ  الْوَلِيدُ بْنُ عُقْبَةَ         {      يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ جَاءَكُمْ فَاسِقٌ بِنَبَإٍ فَتَبَيَّنُوا         }      الْآيَةَ ، قَالَتْ :  وَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعَثَ إِلَيْهِمْ يَصْدُقُ أَمْوَالَهُمْ  ، فَلَمَّا سَمِعُوا بِهِ أَقْبَلَ رَكْبٌ مِنْهُمْ فَقَالُوا : نَسِيرُ مَعَ رَسُولِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَنَحْمِلُهُ ، فَلَمَّا سَمِعَ بِذَلِكَ ظَنَّ أَنَّهُمْ سَارُوا إِلَيْهِ لِيَقْتُلُوهُ فَرَجَعَ فَقَالَ : إِنَّ  بَنِي الْمُصْطَلِقِ  مَنَعُوا صَدَقَاتِهِمْ يَا رَسُولَ اللهِ ، وَأَقْبَلَ  الْقَوْمُ  حَتَّى قَدِمُوا  الْمَدِينَةَ  ثُمَّ صَفُّوا وَرَاءَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الصَّفِّ ، فَلَمَّا قَضَى الصَّلَاةَ انْصَرَفُوا ، فَقَالُوا : إِنَّا نَعُوذُ بِاللهِ مِنْ غَضَبِ اللهِ وَغَضَبِ رَسُولِهِ ، سَمِعْنَا يَا رَسُولَ اللهِ بِرَسُولِكَ الَّذِي أَرْسَلْتَ يَصْدُقُ أَمْوَالَنَا فَسُرِرْنَا بِذَلِكَ  وَقَرَّتْ  بِهِ أَعْيُنُنَا ، وَأَرَدْنَا أَنْ نَلْقَاهُ وَنَسِيرَ مَعَ رَسُولِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَمِعْنَا أَنَّهُ رَجَعَ فَخَشِينَا أَنْ يَكُونَ رَدَّهُ غَضَبٌ مِنَ اللهِ وَرَسُولِهِ ، فَلَمْ يَزَالُوا يَعْتَذِرُونَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى نَزَلَتْ هَذِهِ الْآيَةُ  .","","Al-Mu'jam al-Kabir 960","","هند بنت أبي أمية زوج رسول الله عن ثابت مولى أم سلمة عن موسى بن عبيدة بن نشيط الحميري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","ثابت مولى أم سلمة عن أم سلمة"
"21559","[23/402]      961  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  مُوسَى بْنِ عُبَيْدَةَ ،  عَنْ  ثَابِتٍ مَوْلَى أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَصْحَبُ الْمَلَائِكَةُ رُفْقَةً فِيهَا  جُلْجُلٌ  .","","Al-Mu'jam al-Kabir 961","","هند بنت أبي أمية زوج رسول الله عن سفينة مولى رسول الله عن موسى بن عبيدة بن نشيط الحميري عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","ثابت مولى أم سلمة عن أم سلمة"
"21560","أَبُو السَّائِبِ مَوْلَى أُمِّ سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ .  962  -  حَدَّثَنَا  ابْنُ زُغْبَةَ ،  ثَنَا  ابْنُ أَبِي مَرْيَمَ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي السَّمْحِ ،  عَنْ  أَبِي السَّائِبِ مَوْلَى أُمِّ سَلَمَةَ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  أَيُّمَا امْرَأَةٍ نَزَعَتْ ثِيَابَهَا فِي غَيْرِ بَيْتِ زَوْجِهَا خَرَقَ اللهُ عَلَيْهَا سِتْرَهَا  .  أشار محقق طبعة ابن تيمية ، إلى أنه كذا في النسخة الخطية ، والصواب: (السائب مولى أم سلمة).  أشار محقق طبعة ابن تيمية ، إلى أنه كذا في النسخة الخطية ، والصواب: (السائب مولى أم سلمة).","","Al-Mu'jam al-Kabir 962","","هند بنت أبي أمية زوج رسول الله عن السائب بن عبد الله مولى أم سلمة عن دراج أبي السمح عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن زغبة ، أحمد بن حماد بن مسلم التجيبي عن الطبراني","أبو السائب مولى أم سلمة عن أم سلمة"
"21561","963  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  مُحَمَّدُ بْنُ أَبَانَ الْوَاسِطِيُّ ،  ثَنَا  سَعِيدُ بْنُ زَيْدٍ ،  عَنْ  عَلِيِّ بْنِ الْحَكَمِ الْبُنَانِيِّ ، قَالَ :  حَدَّثَنِي  سُلَيْمَانُ مَوْلَى أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كُنْتُ أَغْتَسِلُ أَنَا وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ إِنَاءٍ وَاحِدٍ  نَحْوَ نِصْفِ  الْفَرَقِ  ، نَتَعَاوَرُ الْغُسْلَ جَمِيعًا يَبْدَأُ قَبْلِي  .","","Al-Mu'jam al-Kabir 963","","هند بنت أبي أمية زوج رسول الله عن سليمان بن يسار مولى ميمونة زوج رسول الله عن علي بن الحكم البناني عن سعيد بن زيد الجهضمي عن محمد بن أبان بن عمران السلمي عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو السائب مولى أم سلمة عن أم سلمة"
"21562","كُرَيْبٌ  عَنْ  أُمِّ سَلَمَةَ  .  964  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُعَاذُ بْنُ أَسَدٍ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَلِيِّ بْنِ عُمَرَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  كُرَيْبٍ ،  قَالَ  :  أَرْسَلَنِي  ابْنُ عَبَّاسٍ  وَأُنَاسٌ إِلَى أُمِّ سَلَمَةَ ، أَسْأَلُهَا أَيُّ الْأَيَّامِ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ         [23/403]      عَلَيْهِ وَسَلَّمَ - أَكْثَرَ صِيَامًا ؟ قَالَتْ : "" يَوْمُ السَّبْتِ وَالْأَحَدِ أَكْثَرُ مَا يَصُومُ مِنَ الْأَيَّامِ "" ، وَيَقُولُ :  إِنَّهُمَا يَوْمَا عِيدٍ لِلْمُشْرِكِينَ ، فَإِنِّي أُحِبُّ أَنْ أُخَالِفَهُمْ  .","","Al-Mu'jam al-Kabir 964","","هند بنت أبي أمية زوج رسول الله عن كريب بن أبي مسلم الحجازي عن محمد بن عمر بن علي بن أبي طالب عن عبد الله بن محمد بن عمر بن علي بن أبي طالب عن عبد الله بن المبارك عن معاذ بن أسد الغنوي عن معاذ بن المثنى العنبري عن الطبراني","كريب عن أم سلمة"
"21563","الْمَقْبُرِيُّ  عَنْ  أُمِّ سَلَمَةَ  .  965  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ الزُّبَيْرِيُّ ،  ثَنَا  أَنَسُ بْنُ عِيَاضٍ ،  عَنْ  أَبِي مَعْشَرٍ ،  عَنِ  الْمَقْبُرِيِّ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كُنْتُ أَغْتَسِلُ أَنَا وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ إِنَاءٍ وَاحِدٍ كِلَانَا  جُنُبٌ  حَتَّى يَخْتَلِفَ يَدِي وَيَدُهُ  .","","Al-Mu'jam al-Kabir 965","","هند بنت أبي أمية زوج رسول الله عن سعيد المقبري عن نجيح بن عبد الرحمن السندي عن أنس بن عياض الليثي عن مصعب بن إبراهيم بن حمزة عن الطبراني","المقبري عن أم سلمة"
"21564","نَاعِمٌ مَوْلَى أُمِّ سَلَمَةَ  عَنْ  أُمِّ سَلَمَةَ  .  966  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ ،  ثَنَا  سَعِيدُ بْنُ عُفَيْرٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  نَاعِمٍ مَوْلَى أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فِي الْحَائِضِ : "" تَغْسِلُ مَا أَصَابَ ثَوْبَهَا وَلَا تَغْسِلُ الثَّوْبَ كُلَّهُ  .","","Al-Mu'jam al-Kabir 966","","هند بنت أبي أمية زوج رسول الله عن ناعم بن أجيل الهمداني عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن سعيد بن كثير بن عفير عن روح بن الفرج القطان عن الطبراني","ناعم مولى أم سلمة عن أم سلمة"
"21565","أَبُو صَالِحٍ  عَنْ  أُمِّ سَلَمَةَ  .  967  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي حَمْزَةَ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  قَالَتْ : لَبِسْتُ قِلَادَةً فِيهَا شَعَرَاتٌ مِنْ ذَهَبٍ ، فَرَآنِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَكَرِهَهَا فَأَعْرَضَ عَنِّي فَنَزَعْتُهَا ، فَقَالَ :  مَا يُؤَمِّنُكِ أَنْ يُقَلِّدَكِ اللهُ مَكَانَهَا يَوْمَ الْقِيَامَةِ شَعَرَاتٍ مِنْ نَارٍ  .","","Al-Mu'jam al-Kabir 967","","هند بنت أبي أمية زوج رسول الله عن أبو صالح مولى طلحة بن عبيد الله عن ميمون القصاب عن سلام بن سليم الحنفي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو صالح عن أم سلمة"
"21566","[23/404]      968  -  حَدَّثَنَا  الْخَلَّالُ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ الْمَلِكِ بْنِ أَبِي عُتْبَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  عَطَاءٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  دَخَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعَلَيَّ شَعَرَاتٌ مِنْ ذَهَبٍ ، فَأَعْرَضَ عَنِّي ، فَقُلْتُ : يَا رَسُولَ اللهِ أَلَا تَنْظُرُ إِلَى زِينَتِي ، فَقَالَ :  عَنْهَا أُعْرِضُ  ، فَقَطَعْتُهَا ، فَأَقْبَلَ إِلَيَّ بِوَجْهِهِ .","","Al-Mu'jam al-Kabir 968","","هند بنت أبي أمية زوج رسول الله عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن يحيى بن عبد الملك بن حميد عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","أبو صالح عن أم سلمة"
"21567","969  -  حَدَّثَنَا  الْخَلَّالُ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنْ  مُحَمَّدِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  عَطَاءٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَفْرِضُ الصِّيَامَ مِنَ اللَّيْلِ ، ثُمَّ يُصْبِحُ فَيَقُولُ :  هَلْ عِنْدَكُمْ شَيْءٌ ؟  ، فَنَقُولُ : مَا عِنْدَنَا شَيْءٌ ، أَلَسْتَ صَائِمًا . ؟","","Al-Mu'jam al-Kabir 969","","هند بنت أبي أمية زوج رسول الله عن عطاء بن أبي رباح عن محمد بن عبيد الله بن أبي سليمان العرزمي عن حاتم بن إسماعيل الحارثي عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","أبو صالح عن أم سلمة"
"21568","نَوْفَلُ بْنُ مُسَاحِقٍ  عَنْ  أُمِّ سَلَمَةَ  .  970  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  عَنْ  مُوسَى بْنِ عُبَيْدَةَ ، قَالَ :  حَدَّثَنِي  الْمُنْذِرُ بْنُ الْجَهْمِ الْأَسْلَمِيُّ ،  عَنْ  نَوْفَلِ بْنِ مُسَاحِقٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الرَّحِمُ  شِجْنَةٌ  آخِذَةٌ  بِحُجْزَةِ  الرَّحْمَنِ تُنَاشِدُهُ حَقَّهَا  ، فَيَقُولُ : أَلَا تَرْضَيْنَ أَنْ أَصِلَ مَنْ وَصَلَكِ ، وَأَقْطَعَ مَنْ قَطَعَكِ ، مَنْ وَصَلَكِ فَقَدْ وَصَلَنِي ، وَمَنْ قَطَعَكِ فَقَدْ قَطَعَنِي  .","","Al-Mu'jam al-Kabir 970","","هند بنت أبي أمية زوج رسول الله عن نوفل بن مساحق العامري عن منذر بن جهم عن موسى بن عبيدة بن نشيط الحميري عن زيد بن الحباب العكلي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","نوفل بن مساحق عن أم سلمة"
"21569","[23/405]      أَبُو بَكْرِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ  عَنْ  أُمِّ سَلَمَةَ  .  971  -  حَدَّثَنَا  عُمَرُ بْنُ عَبْدِ الْعَزِيزِ بْنِ مِقْلَاصٍ ،  ثَنَا  أَبِي ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  عَبْدِ رَبِّهِ بْنِ سَعِيدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ كَعْبٍ ، أَنَّ أَبَا بَكْرِ بْنَ عَبْدِ الرَّحْمَنِ  حَدَّثَهُ  ،  أَنَّ  مَرْوَانَ بْنَ الْحَكَمِ  أَرْسَلَهُ إِلَى أُمِّ سَلَمَةَ  يَسْأَلُهَا  عَنِ الرَّجُلِ يُصْبِحُ  جُنُبًا  أَيَصُومُ ؟ فَقَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" يُصْبِحُ  جُنُبًا  مِنْ جِمَاعٍ لَا حُلُمٍ فَلَا يُفْطِرُ ، وَلَا يَقْضِي  .","","Al-Mu'jam al-Kabir 971","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن عبد الله بن كعب مولى عثمان بن عفان عن عبد ربه بن سعيد النجاري عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن عبد العزيز بن عمران المصري عن عمر بن عبد العزيز الخزاعي عن الطبراني","أبو بكر بن عبد الرحمن بن الحارث عن أم سلمة"
"21570","972  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ ،  ثَنَا  إِسْحَاقُ بْنُ سَلْمَانَ الْقُلُوسِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبَانَ ،  ثَنَا  عُمَرُ بْنُ ثَابِتٍ  ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ  الْحَارِثَ بْنَ هِشَامٍ  أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَامَ  حَجَّةِ الْوَدَاعِ  ، فَقَالَ : يَا رَسُولَ اللهِ إِنِّي كُنْتُ عَلَى صِلَةِ الرَّحِمِ وَالْإِحْسَانِ إِلَى الْجَارِ وَإِيوَاءِ الْيَتِيمِ وَإِطْعَامِ الضَّيْفِ وَإِطْعَامِ الْمَسَاكِينِ ، وَكُلُّ هَذَا قَدْ كَانَ يَفْعَلُهُ  هِشَامُ بْنُ الْمُغِيرَةِ  ، فَمَا ظَنُّكَ بِهِ أَيْ رَسُولَ اللهِ ؟ فَقَالَ :  كُلُّ قَبْرٍ لَا يَشْهَدُ صَاحِبُهُ أَنْ لَا إِلَهَ إِلَّا اللهُ فَهُوَ جَذْوَةٌ مِنَ النَّارِ  ، وَقَدْ وَجَدْتُ عَمِّي  أَبَا طَالِبٍ  فِي  طَمْطَامٍ  مِنَ النَّارِ فَأَخْرَجَهُ اللهُ بِمَكَانِهِ مِنِّي وَإِحْسَانِهِ إِلَيَّ فَجَعَلَهُ فِي  ضَحْضَاحٍ  مِنَ النَّارِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عمرو بن ثابت ) وينظر المعجم الأوسط .","","Al-Mu'jam al-Kabir 972","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن عبد الله بن محمد بن عقيل بن أبي طالب عن عمرو  بن أبي المقدام عن إسماعيل بن أبان عن إسحاق بن سلمان القلوسي عن البزار عن الطبراني","أبو بكر بن عبد الرحمن بن الحارث عن أم سلمة"
"21571","973  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا         [23/406]      عَبْدَةُ بْنُ سُلَيْمَانَ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  عِرَاكِ بْنِ مَالِكٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرٍ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ "" يُصْبِحُ  جُنُبًا  مِنْ غَيْرِ حُلُمٍ ، ثُمَّ يُصْبِحُ صَائِمًا  .","","Al-Mu'jam al-Kabir 973","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن أبي بكر بن عبد الرحمن المخزومي عن عراك بن مالك الغفاري عن يحيى بن سعيد الأنصاري عن عبدة بن سليمان الكلابي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو بكر بن عبد الرحمن بن الحارث عن أم سلمة"
"21572","974  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  عَبْدِ الْوَاحِدِ بْنِ أَيْمَنَ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ ، قَالَ :  قَالَتْ  أُمُّ سَلَمَةَ :  لَمَّا خَطَبَنِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قُلْتُ لَهُ : فِيَّ خِلَالٌ ثَلَاثٌ ، أَنَا كَبِيرَةُ السِّنِّ ، وَأَنَا امْرَأَةٌ مُطْفِلٌ ، وَأَنَا امْرَأَةٌ شَدِيدَةُ الْغَيْرَةِ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَمَّا الْأَطْفَالُ فَهُمْ إِلَى اللهِ وَإِلَى رَسُولِهِ ،  وَأَمَّا الْغَيْرَةُ فَأَدْعُو اللهَ أَنْ يُذْهِبَهَا عَنْكِ ، وَأَمَّا السِّنُّ فَأَنَا أَكْبَرُ مِنْكِ سِنًّا "" ، فَتَزَوَّجَهَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهِيَ تُرْضِعُ بِنْتَهَا  زَيْنَبَ بِنْتَ أَبِي سَلَمَةَ  ، فَكَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَدْخُلُ وَيَخْرُجُ وَلَا يَقْرَبُهَا ، وَكَانَ يُمَازِحُ ابْنَتَهَا إِذَا دَخَلَ ، فَدَخَلَ  عَمَّارُ بْنُ يَاسِرٍ  ، فَقَالَ : أَيْنَ ابْنَتُكُمْ هَذِهِ الَّتِي قَدْ شَغَلَتْ أَهْلَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَخَذَهَا فَاسْتَرْضَعَ لَهَا سَعْيًا ، فَدَخَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : "" أَيْنَ  زُنَابُ  ؟ "" ، فَقَالَتِ  امْرَأَةٌ  : دَخَلَ  عَمَّارٌ  فَأَخَذَهَا فَاسْتَرْضَعَ لَهَا سَعْيًا ، فَدَخَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِأَهْلِهِ  .","","Al-Mu'jam al-Kabir 974","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن عبد الواحد بن أيمن المخزومي عن مروان بن معاوية الفزاري عن يحيى بن معين عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو بكر بن عبد الرحمن بن الحارث عن أم سلمة"
"21573","عَوْفُ بْنُ الْحَارِثِ  عَنْ  أُمِّ سَلَمَةَ  .  975  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ مُسَاوِرٍ ،  ثَنَا  عَفَّانُ ،  ثَنَا  حَمَّادُ         [23/407]      بْنُ سَلَمَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عَوْفِ بْنِ الْحَارِثِ ، قَالَ :  حَدَّثَتْنِي  أُمُّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تُؤْذِينِي فِي  عَائِشَةَ  فَإِنَّ الْوَحْيَ لَمْ يَنْزِلْ عَلَيَّ فِي لِحَافِ وَاحِدَةٍ مِنْكُنَّ غَيْرَ  عَائِشَةَ  .","","Al-Mu'jam al-Kabir 975","","هند بنت أبي أمية زوج رسول الله عن عوف بن الحارث بن الطفيل الأزدي عن هشام بن عروة بن الزبير عن حماد بن سلمة عن عفان بن مسلم الصفار عن أحمد بن القاسم بن مساور الجوهري عن الطبراني","عوف بن الحارث عن أم سلمة"
"21574","976  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عَوْفِ بْنِ الْحَارِثِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تُؤْذِينِي فِي  عَائِشَةَ  فَإِنَّ الْوَحْيَ لَمْ يَنْزِلْ فِي لِحَافِ وَاحِدَةٍ مِنْكُنَّ غَيْرَ  عَائِشَةَ  - رَضِيَ اللهُ عَنْهَا  -  .","","Al-Mu'jam al-Kabir 976","","هند بنت أبي أمية زوج رسول الله عن عوف بن الحارث بن الطفيل الأزدي عن هشام بن عروة بن الزبير عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عوف بن الحارث عن أم سلمة"
"21575","يَعْلَى بْنُ مَمْلَكٍ  عَنْ  أُمِّ سَلَمَةَ  .  977  -  حَدَّثَنَا  حَجَّاجُ بْنُ عِمْرَانَ السَّدُوسِيُّ ،  ثَنَا  أَبُو سَلَمَةَ بْنُ خَلَفٍ الْجُوبَارِيُّ ،  ثَنَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ، قَالَ :  أَخْبَرَنِي  أَبِي ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  يَعْلَى بْنِ مَمْلَكٍ ، قَالَ :  سَأَلْتُ  أُمَّ سَلَمَةَ عَنْ صَلَاةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِاللَّيْلِ ، فَقَالَتْ :  كَانَ يُصَلِّي الْعِشَاءَ ثُمَّ يُسَبِّحُ مَا شَاءَ اللهُ أَنْ يُسَبِّحَ ثُمَّ يَنَامُ ثُمَّ يَسْتَيْقِظُ مِثْلَ نَوْمَتِهِ  ، ثُمَّ يَنَامُ وَيَقُومُ ، فَتَكُونُ تِلْكَ صَلَاتَهُ إِلَى الصُّبْحِ  .","","Al-Mu'jam al-Kabir 977","","هند بنت أبي أمية زوج رسول الله عن يعلى بن مملك المكي عن ابن أبي مليكة عن عبد العزيز بن جريج المكي عن ابن جريج عن أبو عاصم النبيل عن يحيى بن خلف الجوباري عن حجاج بن عمران السدوسي عن الطبراني","يعلى بن مملك عن أم سلمة"
"21576","عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ بْنِ عُتْبَةَ  عَنْ  أُمِّ سَلَمَةَ  رَضِيَ اللهُ عَنْهَا .  978  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  طَلْحَةَ بْنِ يَحْيَى قَالَ :  سَمِعْتُ  عُبَيْدَ اللهِ بْنَ عُتْبَةَ  يُحَدِّثُ عَنْ  أُمِّ سَلَمَةَ         [23/408]      قَالَتْ :  شُغِلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الرَّكْعَتَيْنِ قَبْلَ الْعَصْرِ فَصَلَّاهُمَا بَعْدَ الْعَصْرِ  .","","Al-Mu'jam al-Kabir 978","","هند بنت أبي أمية زوج رسول الله عن عبيد الله بن عبد الله بن عتبة بن مسعود عن طلحة بن يحيى بن طلحة التيمي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبيد الله بن عبد الله بن عتبة عن أم سلمة رضي الله عنها"
"21577","979  -  حَدَّثَنَا  مَحْمُودٌ  ، حَدَّثَنَا  تَمِيمُ بْنُ الْمُنْتَصِرِ ،  ثَنَا  إِسْحَاقُ الْأَزْرَقُ ،  عَنْ  شَرِيكٍ ،  عَنْ  طَلْحَةَ بْنِ يَحْيَى ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ "" يُبَاشِرُهَا وَهُوَ صَائِمٌ  .","","Al-Mu'jam al-Kabir 979","","هند بنت أبي أمية زوج رسول الله عن عبيد الله بن عبد الله بن عتبة بن مسعود عن طلحة بن يحيى بن طلحة التيمي عن شريك بن عبد الله النخعي عن إسحاق بن يوسف الأزرق عن تميم بن المنتصر مولى ابن عباس عن محمود بن محمد بن منويه المفيد عن الطبراني","عبيد الله بن عبد الله بن عتبة عن أم سلمة رضي الله عنها"
"21578","عُرْوَةُ بْنُ الزُّبَيْرِ  عَنْ  أُمِّ سَلَمَةَ  .  980  -  حَدَّثَنَا  الْخَلَّالُ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  أَنَسُ بْنُ عِيَاضٍ ،  عَنْ  يُونُسَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  أُمِّ سَلَمَةَ : أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ "" إِذَا أَرَادَ أَنْ يَنَامَ وَهُوَ  جُنُبٌ  تَوَضَّأَ وُضُوءَهُ لِلصَّلَاةِ  ، وَإِذَا أَرَادَ أَنْ يَطْعَمَ غَسَلَ يَدَيْهِ ثُمَّ يَأْكُلُ  .","","Al-Mu'jam al-Kabir 980","","هند بنت أبي أمية زوج رسول الله عن عروة بن الزبير عن الزهري عن يونس بن يزيدالأيلي عن أنس بن عياض الليثي عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","عروة بن الزبير عن أم سلمة"
"21579","981  -  حَدَّثَنَا  الْخَلَّالُ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  مُحَمَّدُ بْنُ صَالِحٍ ، وَأُسَامَةُ بْنُ حَفْصٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّهَا قَالَتْ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : لَمْ أَطُفْ  بِالْبَيْتِ  طَوَافَ الصَّدْرِ ، فَقَالَ :  إِذَا صَلَّيْتِ ، فَطُوفِي مِنْ وَرَاءِ النَّاسِ عَلَى بَعِيرِكِ  .","","Al-Mu'jam al-Kabir 981","","هند بنت أبي أمية زوج رسول الله عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن صالح عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","عروة بن الزبير عن أم سلمة"
"21580","982  -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَحْمَدَ الْخُزَاعِيُّ ، قَالَ :  ثَنَا  عَبْدُ الْجَبَّارِ بْنُ الْعَلَاءِ ،  ثَنَا  سُفْيَانُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" أَمَرَهَا أَنْ تُصَلِّيَ الصُّبْحَ  بِمَكَّةَ  .","","Al-Mu'jam al-Kabir 982","","هند بنت أبي أمية زوج رسول الله عن عروة بن الزبير عن هشام بن عروة بن الزبير عن سفيان بن عيينة عن عبد الجبار بن العلاء العطار عن إسحاق بن أحمد بن إسحاق الخزاعي عن الطبراني","عروة بن الزبير عن أم سلمة"
"21581","[23/409]      أَبُو جَعْفَرٍ مُحَمَّدُ بْنُ عَلِيٍّ  عَنْ  أُمِّ سَلَمَةَ  .  983  -  حَدَّثَنَا  الْخَلَّالُ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ، وَعَبْدُ اللهِ بْنُ رَجَاءٍ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،  قَالَ :  قَالَتْ  أُمُّ سَلَمَةَ : يَا رَسُولَ اللهِ امْرَأَةٌ تُوُفِّيَ زَوْجُهَا أَتَأْذَنُ فِي الْكُحْلِ ؟ فَقَالَ :  قَدْ كَانَتْ إِحْدَاكُنَّ إِذَا تُوُفِّيَ زَوْجُهَا أَخَذَتْ بَعْرَةً ، فَرَمَتْ بِهَا خَلْفَ ظَهْرِهَا ،  ثُمَّ قَالَتْ : لَا أَكْتَحِلُ حَتَّى تُحَوَّلَ هَذِهِ الْبَعْرَةُ ، وَإِنَّمَا هِيَ أَرْبَعَةُ أَشْهُرٍ وَعَشْرًا  .","","Al-Mu'jam al-Kabir 983","","هند بنت أبي أمية زوج رسول الله عن أبو جعفر الباقر عن جعفر الصادق عن عبد الله بن رجاء البصري عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","أبو جعفر محمد بن علي عن أم سلمة"
"21582","مُهَاجِرُ بْنُ الْقِبْطِيَّةِ  عَنْ  أُمِّ سَلَمَةَ  .  984  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ الْقِبْطِيَّةِ ،  قَالَ  :  دَخَلَ  الْحَارِثُ بْنُ أَبِي رَبِيعَةَ  وَعَبْدُ اللهِ بْنُ صَفْوَانَ  عَلَى أُمِّ سَلَمَةَ وَأَنَا مَعَهُمَا فَسَأَلَاهَا عَنِ الْجَيْشِ الَّذِي يُخْسَفُ بِهِ ، وَكَانَ ذَلِكَ فِي زَمَانِ  ابْنِ الزُّبَيْرِ  ، فَقَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَعُوذُ عَائِذٌ  بِالْبَيْتِ  ، فَيَبْعَثُ اللهُ بَعْثًا فَإِذَا كَانُوا  بِبَيْدَاءَ  مِنَ الْأَرْضِ خُسِفَ بِهِمْ  ، قَالَتْ : يَا رَسُولَ اللهِ يُخْسَفُ بِمَنْ كَانَ كَارِهًا ، قَالَ : "" يُخْسَفُ بِهِ مَعَهُمْ ، وَلَكِنَّهُ يُبْعَثُ يَوْمَ الْقِيَامَةِ عَلَى نِيَّتِهِ  .","","Al-Mu'jam al-Kabir 984","","هند بنت أبي أمية زوج رسول الله عن عبيد الله بن القبطية اللخمي عن عبد العزيز بن رفيع الطائفي عن جرير بن عبد الحميد عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","مهاجر بن القبطية عن أم سلمة"
"21583","985  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  شُعْبَةَ ،  عَنْ  أَبِي يُونُسَ الْبَاهِلِيِّ ،  عَنِ  الْمُهَاجِرِ الْمَكِّيِّ ،  عَنْ  أُمِّ سَلَمَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَغْزُو جَيْشٌ هَذَا  الْبَيْتَ  حَتَّى إِذَا كَانُوا  بِبَيْدَاءَ  مِنَ الْأَرْضِ خُسِفَ بِهِمْ  ، قُلْتُ : يَا رَسُولَ اللهِ أَرَأَيْتَ الْمُكْرَهَ ، فَقَالَ : "" يُبْعَثُ عَلَى نِيَّتِهِ  .","","Al-Mu'jam al-Kabir 985","","هند بنت أبي أمية زوج رسول الله عن ابن القبطية ، مهاجر المكي عن حاتم بن أبي صغيرة القشيري عن شعبة بن الحجاج عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","مهاجر بن القبطية عن أم سلمة"
"21584","[23/410]      الْأَعْرَجُ  عَنْ  أَبِي سَلَمَةَ  [ عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ  ] عَنْ  أُمِّ سَلَمَةَ  .  986  -  حَدَّثَنَا  أَحْمَدُ بْنُ حَمَّادِ بْنِ زُغْبَةَ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ هُرْمُزَ الْأَعْرَجِ ،  عَنْ  أَبِي سَلَمَةَ ، قَالَ :  حَدَّثَتْنِي  زَيْنَبُ بِنْتُ أَبِي سَلَمَةَ ،  عَنْ  أُمِّهَا أُمِّ سَلَمَةَ ،  أَنَّ امْرَأَةً مِنْ  أَسْلَمَ  ، يُقَالُ لَهَا  سُبَيْعَةُ ،  كَانَتْ تَحْتَ  رَجُلٍ  فَتُوُفِّيَ عَنْهَا ، فَخَطَبَهَا  أَبُو السَّنَابِلِ بْنُ بَعْكَكٍ  فَأَبَتْ أَنْ تَنْكِحَهُ ، فَقَالَ : مَا يَصْلُحُ لَكِ أَنْ تَنْكِحِي حَتَّى تَعْتَدِّي آخِرَ الْأَجَلَيْنِ ، فَجَاءَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  انْكِحِي مَنْ شِئْتِ  .","","Al-Mu'jam al-Kabir 986","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو سلمة بن عبد الرحمن عن عبد الرحمن بن هرمز الأعرج عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن زغبة ، أحمد بن حماد بن مسلم التجيبي عن الطبراني","الأعرج عن أبي سلمة عن زينب بنت أبي سلمة عن أم سلمة"
"21585","987  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، (  ح  )  وَحَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ، قَالَا :  ثَنَا  اللَّيْثُ ،  حَدَّثَنِي  جَعْفَرُ بْنُ رَبِيعَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ هُرْمُزَ ،  عَنْ  أَبِي سَلَمَةَ ، أَنَّ  زَيْنَبَ بِنْتَ أَبِي سَلَمَةَ  أَخْبَرَتْهُ  ،  عَنْ  أُمِّهَا أُمِّ سَلَمَةَ  ،  أَنَّ امْرَأَةً مِنْ  أَسْلَمَ  ، يُقَالُ لَهَا  سُبَيْعَةُ  كَانَتْ تَحْتَ زَوْجِهَا فَتُوُفِّيَ عَنْهَا وَهِيَ حُبْلَى ، فَخَطَبَهَا  أَبُو السَّنَابِلِ بْنُ بَعْكَكٍ  فَأَبَتْ أَنْ تَنْكِحَهُ ، فَقَالَ : مَا يَصْلُحُ أَنْ تَنْكِحِي حَتَّى تَعْتَدِّي آخِرَ الْأَجَلَيْنِ ، فَمَكَثَتْ مِنْ عِشْرِينَ لَيْلَةً ثُمَّ  نَفِسَتْ  ، فَجَاءَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  انْكِحِي  .  وَكَانَتْ  فَاطِمَةُ بِنْتُ قَيْسٍ  تُحَدِّثُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ طُلِّقَتِ أَلْبَتَّةَ ، أَنَّهُ أَمَرَهَا أَنْ تَنْتَقِلَ إِلَى  ابْنِ أُمِّ مَكْتُومٍ  ، فَإِنَّهُ أَعْمَى ، تَضَعُ عِنْدَهُ ثِيَابَهَا قَبْلَ أَنْ تَنْقَضِيَ عِدَّتُهَا ، وَكَانَ  مُحَمَّدُ بْنُ أُسَامَةَ بْنِ زَيْدٍ  يُحَدِّثُ أَنَّهَا كَانَتْ إِذَا ذَكَرَتْ مِنْ ذَلِكَ شَيْئًا رَمَاهَا  أُسَامَةُ  بِمَا كَانَ فِي يَدِهِ .","","Al-Mu'jam al-Kabir 987","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو سلمة بن عبد الرحمن عن عبد الرحمن بن هرمز الأعرج عن جعفر بن ربيعة الكندي عن الليث بن سعد عن يحيى بن عبد الله بن بكير المخزومي عن عمرو بن أبي الطاهر المصري عن الطبراني","الأعرج عن أبي سلمة عن زينب بنت أبي سلمة عن أم سلمة"
"21586","[23/411]      عَلِيُّ بْنُ الْحُسَيْنِ  عَنْ  زَيْنَبَ  .  988  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْخَلَّالُ الْمَكِّيُّ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ مُحَمَّدٍ ، وَعَبْدُ اللهِ بْنُ مَيْمُونٍ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  عَلِيِّ بْنِ حُسَيْنٍ ،  عَنْ  زَيْنَبَ ،  عَنْ  أُمِّ سَلَمَةَ  : أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَكَلَ مِنْ كَتِفِ شَاةٍ ثُمَّ أُذِّنَ بِالصَّلَاةِ فَصَلَّى - وَلَمْ يَمَسَّ مَاءً - صَلَاةَ الْعَصْرِ  .","","Al-Mu'jam al-Kabir 988","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن علي بن الحسين زين العابدين عن أبو جعفر الباقر عن جعفر الصادق عن عبد الله بن ميمون القداح عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","علي بن الحسين عن زينب"
"21587","حُمَيْدُ بْنُ نَافِعٍ  عَنْ  زَيْنَبَ  .  989  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْخَلَّالُ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  حُمَيْدِ بْنِ نَافِعٍ ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ  امْرَأَةً  سَأَلَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ : يَا رَسُولَ اللهِ ، ابْنَةٌ لِي زَوَّجْتُهَا فَأَصَابَتْهَا الْحَصْبَةُ فَمَرَقَ شَعَرُهَا وَنَحْنُ نُرِيدُ أَنْ نُدْخِلَهَا عَلَى زَوْجِهَا ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَعَنَ اللهُ  الْوَاصِلَةَ  وَالْمُسْتَوْصِلَةَ  .","","Al-Mu'jam al-Kabir 989","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن حميد بن نافع حميد صفيرا عن يحيى بن سعيد الأنصاري عن سفيان بن عيينة عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","حميد بن نافع عن زينب"
"21588","أَبُو الْأَسْوَدِ ،  عَنْ  عُرْوَةَ ،  عَنْ  زَيْنَبَ  .  990  -  حَدَّثَنَا  الْحَسَنُ بْنُ غُلَيْبٍ ،  ثَنَا  عِمْرَانُ بْنُ هَارُونَ الرَّمْلِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ ،  عَنْ  زَيْنَبَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  جَاءَتْ  أُمُّ سُلَيْمٍ  فَقَالَتْ : يَا رَسُولَ اللهِ هَلْ عَلَى الْمَرْأَةِ غُسْلٌ إِذَا احْتَلَمَتْ ؟ قَالَ :  نَعَمْ ، إِذَا رَأَتِ الْمَاءَ فَلْتَغْتَسِلْ  .","","Al-Mu'jam al-Kabir 990","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن الصوفي عمران بن أبى عمران عن الحسن بن غليب المصري عن الطبراني","أبو الأسود عن عروة عن زينب"
"21589","[23/412]      أَبُو عُبَيْدَةَ بْنُ عَبْدِ اللهِ بْنِ زَمْعَةَ  عَنْ  زَيْنَبَ  عَنْ  أُمِّ سَلَمَةَ  .  991  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي عَدِيٍّ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  حَدَّثَنِي  أَبُو عُبَيْدَةَ بْنُ عَبْدِ اللهِ بْنِ زَمْعَةَ ،  عَنْ  أَبِيهِ ،  وَعَنْ  أُمِّهِ زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ،  قَالَتْ :  كَانَتْ لَيْلَتِي الَّتِي يَصِيرُ إِلَيَّ فِيهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَسَاءَ  يَوْمِ النَّحْرِ  ، فَصَارَ إِلَيَّ ، فَدَخَلَ عَلَيَّ  وَهْبُ بْنُ زَمْعَةَ  وَمَعَهُ  رَجُلٌ آخَرُ مِنْ آلِ أَبِي أُمَيَّةَ  مُتَقَمِّصَيْنِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  وَهَلْ  أَفَضْتَ  بَعْدُ يَا  أَبَا عَبْدِ اللهِ  ؟ "" فَقَالَ : لَا وَاللهِ يَا رَسُولَ اللهِ ، فَقَالَ : "" انْزِعْ عَنْكَ الْقَمِيصَ  ، قَالَ : فَنَزَعَهُ مِنْ رَأْسِهِ ، وَنَزَعَ صَاحِبُهُ قَمِيصَهُ عَنْ رَأْسِهِ ، ثُمَّ قَالَ : لِمَ يَا رَسُولَ اللهِ ؟ فَقَالَ : "" إِنَّ هَذَا يَوْمٌ رُخِّصَ لَكُمْ إِذَا رَمَيْتُمُ الْجَمْرَةَ ، أَنْ تُحِلُّوا مِنْ كُلِّ مَا حُرِمْتُمْ عَنْهُ إِلَّا مِنَ النِّسَاءِ ، فَإِذَا مَسَسْتُمْ قَبْلَ أَنْ تَطُوفُوا بِهَذَا  الْبَيْتِ  صِرْتُمْ حَرَامًا كَهَيْأَتِكُمْ قَبْلَ أَنْ تَرْمُوا الْجَمْرَةَ  .","","Al-Mu'jam al-Kabir 991","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو عبيدة بن عبد الله بن زمعة الأسدي عن محمد بن إسحاق عن محمد بن إبراهيم بن أبي عدي القسملي عن يحيى بن معين عن معاذ بن المثنى العنبري عن الطبراني","أبو عبيدة بن عبد الله بن زمعة عن زينب عن أم سلمة"
"21590","992  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبِي ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ ،  حَدَّثَنِي  أَبِي ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ بْنِ عَبْدِ اللهِ بْنِ زَمْعَةَ ،  عَنْ  أُمِّهِ زَيْنَبَ ،  وَعَنْ  أَبِيهِ عَبْدِ اللهِ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  كَانَتْ لَيْلَتِي مِنَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 992","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن زمعة بن الأسود الأسدي عن أبو عبيدة بن عبد الله بن زمعة الأسدي عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو عبيدة بن عبد الله بن زمعة عن زينب عن أم سلمة"
"21591","993  -  وَعَنِ  ابْنِ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ جَعْفَرِ بْنِ الزُّبَيْرِ ،  عَنْ  يَزِيدَ بْنِ رُومَانَ ،  عَنْ  خَالِدٍ مَوْلَى الزُّبَيْرِ ،  عَنْ  زَيْنَبَ ،  عَنْ  أُمِّ سَلَمَةَ  مِثْلَهُ .","","Al-Mu'jam al-Kabir 993","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن خالد مولى الزبير بن نوفل عن يزيد بن رومان الأسدي عن محمد بن جعفر بن الزبير بن العوام عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو عبيدة بن عبد الله بن زمعة عن زينب عن أم سلمة"
"21592","وَاهِبٌ  عَنْ  زَيْنَبَ  .  994  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،         [23/413]      عَنْ  وَاهِبِ بْنِ عَبْدِ اللهِ الْمَعَافِرِيِّ ،  أَنَّهُ سَمِعَ  ،  زَيْنَبَ بِنْتَ أَبِي سَلَمَةَ  تُخْبِرُ ، عَنْ  أُمِّهَا أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  اعْتَكَفَ أَوَّلَ سَنَةٍ الْعَشْرَ الْأُوَلَ ، ثُمَّ اعْتَكَفَ الْعَشْرَ الْأَوْسَطَ ، ثُمَّ اعْتَكَفَ الْعَشْرَ الْأَوَاخِرَ ، وَقَالَ :  إِنِّي رَأَيْتُ لَيْلَةَ الْقَدْرِ فِيهَا فَأُنْسِيتُهَا  ، فَلَمْ يَزَلْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَعْتَكِفُ فِيهِنَّ حَتَّى تُوُفِّيَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .","","Al-Mu'jam al-Kabir 994","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن واهب بن عبد الله المعافري عن عبد الله بن لهيعة عن يحيى بن عبد الله بن بكير المخزومي عن روح بن الفرج القطان عن الطبراني","واهب عن زينب"
"21593","عُبَيْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ  عَنْ  أُمِّ سَلَمَةَ  .  995  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  حَدَّثَنَا  أَبُو عَاصِمٍ ،  عَنْ  عُثْمَانَ بْنِ مُرَّةَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  خَالَتِهِ أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ شَرِبَ فِي آنِيَةِ الذَّهَبِ وَالْفِضَّةِ فَإِنَّمَا  يُجَرْجِرُ  فِي بَطْنِهِ نَارَ  جَهَنَّمَ  .","","Al-Mu'jam al-Kabir 995","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن عبد الرحمن بن أبي بكر الصديق عن عثمان بن مرة البصري عن أبو عاصم النبيل عن أبو موسى الزمن عن محمد بن صالح النرسي عن الطبراني","عبيد الله بن عبد الرحمن عن أم سلمة"
"21594","عَبْدُ اللهِ بْنُ رَافِعٍ  عَنْ  أُمِّ سَلَمَةَ  .  996  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَبْدِ اللهِ بْنِ رَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ عَلَى هَذَا الْمِنْبَرِ :  إِنِّي سَابِقُكُمْ عَلَى  الْكَوْثَرِ  ، فَبَيْنَا أَنَا عَلَيْهِ إِذْ مُرَّ بِكُمْ أَرْسَالًا مُخَالَفًا بِكُمْ ، فَأُنَادِي أَلَا هَلُمَّ ،  فَيُنَادِي مُنَادٍ ، فَيَقُولُ أَلَا إِنَّهُمْ قَدْ أَحْدَثُوا بَعْدَكَ ، فَأَقُولُ  سُحْقًا  .","","Al-Mu'jam al-Kabir 996","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن محمد بن إسحاق عن عبد الرحيم بن سليمان الأشل عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبد الله بن رافع عن أم سلمة"
"21595","997  -  حَدَّثَنَا  الْحَسَنُ بْنُ غُلَيْبٍ ،  ثَنَا  عِمْرَانُ بْنُ هَارُونَ الرَّمْلِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عَبْدِ اللهِ بْنِ رَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّهَا بَيْنَمَا         [23/414]      هِيَ تَمْتَشِطُ لَمْ يَرُعْهَا إِلَّا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُنَادِي عَلَى الْمِنْبَرِ يَقُولُ :  يَا أَيُّهَا النَّاسُ إِنِّي بَيْنَمَا أَنَا عَلَى الْحَوْضِ أُتِيَ بِكُمْ رُفْقَةً رُفْقَةً ، فَذَهَبَتْ طَائِفَةٌ مِنْكُمْ هَاهُنَا وَهَاهُنَا  ، فَقُلْتُ مَا لَهُمْ هَلُمُّوا إِلَيَّ فَصَرَخَ صَارِخٌ فَقَالَ : إِنَّهُمْ قَدْ بَدَّلُوا بَعْدَكَ ، فَقُلْتُ :  سُحْقًا  سُحْقًا  .","","Al-Mu'jam al-Kabir 997","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن الصوفي عمران بن أبى عمران عن الحسن بن غليب المصري عن الطبراني","عبد الله بن رافع عن أم سلمة"
"21596","998  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْخَلَّالُ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ ،  عَنِ  ابْنِ أَبِي ذِئْبٍ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ رَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ  أُمَّ سُلَيْمٍ  ، قَالَتْ :  يَا رَسُولَ اللهِ هَلْ عَلَى الْمَرْأَةِ تَرَى فِي زَوْجِهَا فِي الْمَنَامِ يَقَعُ عَلَيْهَا غُسْلٌ ؟ قَالَ :  نَعَمْ إِذَا رَأَتِ الْمَاءَ  ، فَقَالَتْ  أُمُّ سَلَمَةَ  : يَا رَسُولَ اللهِ أَوَ يَكُونُ ذَلِكَ مِنَ الْمَرْأَةِ ؟ قَالَ : "" نَعَمْ  تَرِبَتْ  جَبِينُكِ مِنْ أَيْنَ يَكُونُ شَبَهُ الْخُؤُولَةِ لَا أُمَّ لَكِ ، أَيُّ  النُّطْفَتَيْنِ  سَبَقَتْ عَلَى الرَّحِمِ غَلَبَتْ عَلَى الشَّبَهِ  .","","Al-Mu'jam al-Kabir 998","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن سعيد المقبري عن محمد بن عبد الرحمن بن المغيرة عن محمد بن فليح بن سليمان الأسلمي عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","عبد الله بن رافع عن أم سلمة"
"21597","999  -  حَدَّثَنَا  عُمَرُ بْنُ عَبْدِ الْعَزِيزِ بْنِ مِقْلَاصٍ ،  ثَنَا  أَبِي ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ، أَنَّ مُوسَى بْنَ جُبَيْرٍ  حَدَّثَهُمْ  ، أَنَّ عَبْدَ اللهِ بْنَ رَافِعٍ  حَدَّثَهُ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  إِنِّي لَأَعْلَمُ أَكْثَرَ مَالٍ قَدِمَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى قَبَضَهُ اللهُ ، قَدِمَ عَلَيْهِ فِي جُنْحِ اللَّيْلِ خَرِيطَةٌ فِيهَا ثَمَانُمِائَةِ دِرْهَمٍ وَصَحِيفَةٌ ، فَأَرْسَلَ بِهَا إِلَيَّ ، وَكَانَتْ لَيْلَتِي ، ثُمَّ انْقَلَبَ بَعْدَ الْعِشَاءِ الْآخِرَةِ فَصَلَّى فِي الْحُجْرَةِ فِي مُصَلًّى لَهُ ، وَقَدْ مَهَّدْتُ لَهُ وَلِنَفْسِي ، فَأَنَا أَنْتَظِرُ ، فَأَطَالَ ثُمَّ خَرَجَ ، ثُمَّ رَجَعَ ، فَلَمْ يَزَلْ كَذَلِكَ حَتَّى دُعِيَ لِصَلَاةِ الصُّبْحِ فَصَلَّى ثُمَّ رَجَعَ ، فَقَالَ :  أَيْنَ تِلْكَ الْخَرِيطَةُ الَّتِي فَتَنَتْنِي الْبَارِحَةَ  فَدَعَا بِهَا فَقَسَمَهَا         [23/415]      ثُمَّ قَالَ : "" قُبْحًا لَكِ "" ، فَقُلْتُ : يَا رَسُولَ اللهِ صَنَعْتَ شَيْئًا لَمْ تَكُنْ تَصْنَعُهُ ، فَقَالَ : "" كُنْتُ أُصَلِّي فَأُوتَى بِهَا فَأَنْصَرِفُ حَتَّى أَنْظُرَ إِلَيْهَا ثُمَّ أَرْجِعُ فَأُصَلِّي  .","","Al-Mu'jam al-Kabir 999","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن موسى بن جبير الأنصاري عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن عبد العزيز بن عمران المصري عن عمر بن عبد العزيز الخزاعي عن الطبراني","عبد الله بن رافع عن أم سلمة"
"21598","1000  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  بَكْرُ بْنُ مُضَرَ ،  عَنْ  مُوسَى بْنِ جُبَيْرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ رَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 1000","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن موسى بن جبير الأنصاري عن بكر بن مضر المصري عن سعيد بن الحكم الجمحي عن يوسف بن يزيد القراطيسي عن الطبراني","عبد الله بن رافع عن أم سلمة"
"21599","1001  -  حَدَّثَنَا  الْحَسَنُ بْنُ غُلَيْبٍ ،  ثَنَا  عِمْرَانُ بْنُ هَارُونَ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عَبْدِ اللهِ بْنِ رَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَأَى أَبْعِرَةً فِي بَعْضِهَا  جَرَسٌ ،  فَلَمَّا سَمِعَ صَوْتَهُ قَالَ :  مَا هَذَا ؟ "" قَالَ  رَجُلٌ  :  الْجُلْجُلُ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" وَمَا  الْجُلْجُلُ  ؟ "" ، قَالَ :  الْجَرَسُ  ،  قَالَ : "" نَعَمْ فَاذْهَبْ فَاقْطَعْهُ ثُمَّ ارْمِ بِهِ "" ، فَفَعَلَ ، ثُمَّ رَجَعَ الرَّجُلُ ، فَقَالَ : يَا رَسُولَ اللهِ مَا لَهُ ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" إِنَّ الْمَلَائِكَةَ لَا تَصْحَبُ رُفْقَةً فِيهَا  جَرَسٌ  .","","Al-Mu'jam al-Kabir 1001","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن الصوفي عمران بن أبى عمران عن الحسن بن غليب المصري عن الطبراني","عبد الله بن رافع عن أم سلمة"
"21600","1002  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ ،  ثَنَا  عَبْدُ اللهِ ،  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ رَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ رَجُلَيْنِ مِنَ  الْأَنْصَارِ  دَخَلَا عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - . الْحَدِيثَ .","","Al-Mu'jam al-Kabir 1002","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن أسامة بن زيد الليثي المدني عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","عبد الله بن رافع عن أم سلمة"
