hadiths[28]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"688","أَخْبَرَنَا مُحَمَّدُ بْنُ جَعْفَرٍ، نا شُعْبَةُ، عَنْ مُحَمَّدِ بْنِ زِيَادٍ، قَالَ: كَانَ مَرْوَانُ يَسْتَعْمِلُ أَبَا هُرَيْرَةَ عَلَى الْمَدِينَةِ، قَالَ: فَكَانَ أَبُو هُرَيْرَةَ إِذَا رَأَى رَجُلًا يَجُرُّ إِزَارَهُ أَنْ يَضْرِبَ بِرِجْلِهِ الْأَرْضَ، ثُمَّ يَقُولُ: قَدْ جَاءَ الْأَمْرُ، ثُمَّ يَقُولُ: قَالَ أَبُو الْقَاسِمِ لَا يَنْظُرُ اللَّهُ إِلَى رَجُلٍ جَرَّ إِزَارَهُ بَطَرًا.","","Musnad Ishaq ibn Rahwayh 688","","","Description of wearing clothes below the ankles"
"689","أَخْبَرَنَا النَّضْرُ، نا شُعْبَةُ، نا مُحَمَّدُ بْنُ زِيَادٍ، قَالَ: كَانَ مَرْوَانُ يَسْتَعْمِلُ أَبَا هُرَيْرَةَ عَلَى الْمَدِينَةِ، فَذَكَرَ مِثْلَهُ سَوَاءً.","","Musnad Ishaq ibn Rahwayh 689","","","Description of wearing clothes below the ankles"
"690","أَخْبَرَنَا شَبَابَةُ، نا شُعْبَةُ، نا مُحَمَّدُ بْنُ زِيَادٍ، عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: لَا يَنْظُرُ اللَّهُ إِلَى مَنْ جَرَّ إِزَارَهُ بَطَرًا.","","Musnad Ishaq ibn Rahwayh 690","","","Description of wearing clothes below the ankles"
"691","أَخْبَرَنَا مُحَمَّدُ بْنُ جَعْفَرٍ، نا شُعْبَةُ، عَنْ مُحَمَّدِ بْنِ زِيَادٍ، قَالَ: سَمِعْتُ أَبَا هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ يَقُولُ: قَالَ رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَحْفِهِمَا جَمِيعًا أَوْ أَنْعِلْهُمَا جَمِيعًا فَإِذَا لَبِسْتَ فَابْدَأْ بِالْيُمْنَى وَإِذَا خَلَعْتَ فَابْدَأْ بِالْيُسْرَى.","","Musnad Ishaq ibn Rahwayh 691","","","Prohibition of walking with only one shoe"
"692","أَخْبَرَنَا النَّضْرُ، نا شُعْبَةُ، نا مُحَمَّدٌ، قَالَ: سَمِعْتُ أَبَا هُرَيْرَةَ، يَقُولُ: قَالَ رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: فَذَكَرَهُ مِثْلَهُ سَوَاءً.","","Musnad Ishaq ibn Rahwayh 692","","","Prohibition of walking with only one shoe"
"693","أَخْبَرَنَا عَبْدُ الرَّزَّاقِ، نا مَعْمَرٌ، عَنْ مُحَمَّدِ بْنِ زِيَادٍ، قَالَ: سَمِعْتُ أَبَا هُرَيْرَةَ، يَقُولُ: قَالَ رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا انْتَعَلَ أَحَدُكُمْ فَلْيَبْدَأْ بِالْيُمْنَى، وَإِذَا خَلَعَ فَلْيَبْدَأْ بِالْيُسْرَى، أَنْعِلْهُمَا جَمِيعًا أَوْ أَحْفِهِمَا جَمِيعًا.","","Musnad Ishaq ibn Rahwayh 693","","","Prohibition of walking with only one shoe"
"694","أَخْبَرَنَا النَّضْرُ، نا شُعْبَةُ، نا مُحَمَّدٌ، قَالَ: سَمِعْتُ أَبَا هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ يَقُولُ: قَالَ رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: بَيْنَمَا رَجُلٌ يَمْشِي فِي حُلَّةٍ مُرَجِّلَ جُمَّتِهِ يُعْجِبُهُ نَفْسُهُ، إِذْ خُسِفَتْ بِهِ الْأَرْضُ فَهُوَ يَتَجَلْجَلُ فِيهَا إِلَى يَوْمِ الْقِيَامَةِ.","","Musnad Ishaq ibn Rahwayh 694","","","Consequence of arrogance"
"695","أَخْبَرَنَا مُحَمَّدُ بْنُ جَعْفَرٍ، نا شُعْبَةُ، عَنْ مُحَمَّدٍ، عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ سَوَاءً.","","Musnad Ishaq ibn Rahwayh 695","","","Consequence of arrogance"
"696","أَخْبَرَنَا عَبْدُ الرَّزَّاقِ، نا مَعْمَرٌ، عَنْ مُحَمَّدِ بْنِ زِيَادٍ مَوْلَى بَنِي جُمَحٍ أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ، يَقُولُ: قَالَ رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: بَيْنَمَا رَجُلٌ يَمْشِي، فَذَكَرَ مِثْلَهُ.","","Musnad Ishaq ibn Rahwayh 696","","","Consequence of arrogance"
"697","أَخْبَرَنَا النَّضْرُ، نا عَوْفٌ، عَنْ خِلَاسٍ، عَنْ أَبِي هُرَيْرَةَ، عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: ((بَيْنَمَا شَابٌّ مِمَّنْ كَانَ قَبْلَكُمْ يَمْشِي فِي حُلَّةٍ مُخْتَالَا فَخُورًا ابْتَلَعَتْهُ الْأَرْضُ فَهُوَ يَتَجَلْجَلُ فِيهَا إِلَى يَوْمِ الْقِيَامَةِ أَنْ تَقُومَ السَّاعَةُ)) .","","Musnad Ishaq ibn Rahwayh 697","","","Consequence of arrogance"
"698","أَخْبَرَنَا النَّضْرُ، نا بِشْرُ بْنُ عُمَيْرِ بْنِ كَثِيرٍ الْأَسِيدِيُّ، عَنْ عَبْدِ اللَّهِ بْنِ شَقِيقٍ، قَالَ: أَحْسَبُهُ، عَنْ أَبِي هُرَيْرَةَ، قَالَ: نَهَى رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الْحَرِيرِ أَشَدَّ النَّهْيِ، فَقَالَ رَجُلٌ لِعَبْدِ اللَّهِ بْنِ شَقِيقٍ: إِنَّ هَذَا عَلَيْكَ حَرِيرٌ، قَالَ: فَقَالَ: سُبْحَانَ اللَّهِ لَيْسَ هَذَا حَرِيرٌ، فَقَالَ: إِنَّ سَدَاهُ حَرِيرٌ، قَالَ: فَقَالَ: عَبْدُ اللَّهِ بْنُ شَقِيقٍ: مَا شَعَرْتُ.","","Musnad Ishaq ibn Rahwayh 698","","","Silk and gold are forbidden for men"
"699","أَخْبَرَنَا النَّضْرُ، نا شُعْبَةُ، عَنْ قَتَادَةَ، عَنِ النَّضْرِ بْنِ أَنَسٍ، عَنْ بَشِيرِ بْنِ نَهِيكٍ، عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ قَالَ: ((نَهَى رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ خَاتَمِ الذَّهَبِ)) .","","Musnad Ishaq ibn Rahwayh 699","","","Silk and gold are forbidden for men"
"700","أَخْبَرَنَا جَرِيرٌ، عَنْ عُمَارَةَ بْنِ الْقَعْقَاعِ، عَنْ أَبِي زُرْعَةَ، عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ قَالَ: أُتِيَ عُمَرُ بِامْرَأَةٍ تَشِمُ قَالَ: أُنْشِدُكُمُ اللَّهَ هَلْ سَمِعَ أَحَدٌ مِنْكُمْ مِنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ؟ قَالَ: أَبُو هُرَيْرَةَ: فَقُمْتُ، فَقُلْتُ: يَا أَمِيرَ الْمُؤْمِنِينَ، أَنَا سَمِعْتُهُ قَالَ: فَمَا سَمِعْتَهُ، فَقُلْتُ: سَمِعْتُهُ يَقُولُ: ((لَا تَشِمْنَ وَلَا تَسْتَوْشِمْنَ)) .","","Musnad Ishaq ibn Rahwayh 700","","","Prohibition of tattooing and being tattooed"
"701","أَخْبَرَنَا جَرِيرٌ، عَنْ مُطَرِّفٍ، عَنْ أَبِي الْجَهْمِ، عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ قَالَ: كُنْتُ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَتَتْهُ امْرَأَةٌ فَقَالَتْ: يَا رَسُولَ اللَّهِ أَسِوَارَانِ مِنْ ذَهَبٍ؟ فَقَالَ رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: ((أَسِوَارَانِ مِنْ نَارٍ)) ، قَالَتْ: يَا رَسُولَ اللَّهِ: قُرْطَانِ مِنْ ذَهَبٍ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: ((قُرْطَانِ مِنْ نَارٍ)) ، قَالَتْ: يَا رَسُولَ اللَّهِ، إِنَّ الْمَرْأَةَ إِذَا لَمْ تَزَّيَّنَ لِزَوْجِهَا صَلِفَتْ عِنْدَهُ، قَالَ: فَقَالَ رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: ((فَمَا يَمْنَعُكُنَّ أَنْ تَجْعَلَ قُرْطَيْنِ مِنْ فِضَّةٍ وَتُصَفِّرِيهِ بِعَبِيرٍ أَوْ زَعْفَرَانٍ فَيَكُونَ كَأَنَّهُ ذَهَبٌ)) .","","Musnad Ishaq ibn Rahwayh 701","","","Description of gold jewelry"
"702","أَخْبَرَنَا مُعَاذُ بْنُ هِشَامٍ، وَحَدَّثَنِي أَبِي، عَنْ قَتَادَةَ، عَنْ زُرَارَةَ بْنِ أَوْفَى، عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ، عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: ((لَا تَصْحَبُ الْمَلَائِكَةُ رُفْقَةً فِيهَا جَرَسٌ)).","","Musnad Ishaq ibn Rahwayh 702","","","Angels of mercy do not enter where there is a bell"
"703","أَخْبَرَنَا أَبُو الْوَلِيدِ، نا شَرِيكٌ، عَنْ هِشَامِ بْنِ عَبْدِ الْمَلِكِ، عَنْ عَبْدِ اللَّهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ قَالَ: سَمِعْتُ الرُّبَيِّعَ بِنْتَ مُعَوِّذِ ابْنِ عَفْرَاءَ قَالَتْ: أَتَيْتُ رَسُولَ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِصَاعٍ مِنْ رَطْبٍ وَأَجْرًا مِنْ زُغْبٍ، فَجَعَلَ فِي كَفِّي حُلِيًّا أَوْ ذَهَبًا فَقَالَ: ((تَحَلِّي)).","","Musnad Ishaq ibn Rahwayh 703","","","Replying to gifts"
"704","أَخْبَرَنَا الْمُلَائِيُّ، نا سُفْيَانُ، عَنْ أَبِي إِسْحَاقَ، عَنْ مُجَاهِدٍ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: ((غَطِّي عَنَّا قِنَاعَكَ يَا أُمَّ أَيْمَنَ)).","","Musnad Ishaq ibn Rahwayh 704","","","Encouragement for hijab"
"705","أَخْبَرَنَا سُفْيَانُ، عَنِ ابْنِ أَبِي حُسَيْنٍ، عَنْ شَهْرِ بْنِ حَوْشَبٍ، عَنْ أَسْمَاءَ بِنْتِ يَزِيدَ بْنِ السَّكَنِ قَالَتْ: ((رَأَى رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى امْرَأَةٍ سِوَارَيْنِ مِنْ نَارٍ فَرَقَّتْ بِهِ، فَمَا رَأَيْنَاهُ بَعْدُ)).","","Musnad Ishaq ibn Rahwayh 705","","","Description of gold bangles"
"706","أَخْبَرَنَا مُعَاذُ بْنُ هِشَامٍ - صَاحِبُ الدَّسْتُوَائِيِّ - , حَدَّثَنِي أَبِي، عَنْ بُدَيْلِ بْنِ مَيْسَرَةَ الْعُقَيْلِيِّ، عَنْ شَهْرِ بْنِ حَوْشَبٍ، عَنْ أَسْمَاءَ بِنْتِ يَزِيدَ قَالَتْ: ((كَانَتْ يَدُ كُمِّ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى الرُّصْغِ)).","","Musnad Ishaq ibn Rahwayh 706","","","Limit of sleeve length for shirts"
"707","قَالَ: وَقَالَ أَبِي: عَنٍ أَبِي صَالِحٍ، عَنْ سَلْمَانَ مِثْلَهُ.","","Musnad Ishaq ibn Rahwayh 707","","","Limit of sleeve length for shirts"
"708","أَخْبَرَنَا مُحَمَّدُ بْنُ سَوَاءٍ أَبُو الْخَطَّابِ، نا مُوسَى بْنُ ثَرْوَانَ الْمُعَلِّمُ، عَنْ بُدَيْلِ بْنِ مَيْسَرَةَ الْعُقَيْلِيِّ قَالَ: ((كَانَ كُمُّ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى الرُّصْغِ)).","","Musnad Ishaq ibn Rahwayh 708","","","Limit of sleeve length for shirts"
"709","أَخْبَرَنَا مُعَاذُ بْنُ هِشَامٍ - صَاحِبُ الدَّسْتُوَائِيِّ - , حَدَّثَنِي أَبِي، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ، عَنْ مَحْمُودِ بْنِ عَمْرٍو، أَنَّ أَسْمَاءَ بِنْتَ يَزِيدَ حَدَّثَتْهُ أَنَّ رَسُولَ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: ((أَيُّمَا امْرَأَةٍ تَحَلَّتْ قِلَادَةً مِنْ ذَهَبٍ جُعَلَ فِي عُنُقِهَا مِثْلُهَا مِنَ النَّارِ، وَأَيُّمَا امْرَأَةٍ جَعَلَتْ فِي أُذُنِهَا خُرْصًا مِنْ ذَهَبٍ جُعِلَ فِي أُذُنِهَا مِثْلَهُ يَوْمَ الْقِيَامَةِ مِنَ النَّارِ)).","","Musnad Ishaq ibn Rahwayh 709","","","Punishment for wearing gold jewelry"
"710","أَخْبَرَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ، نا حَبِيبُ بْنُ الشَّهِيدِ، نا يَزِيدُ أَبُو الْمُهَزَّمِ، عَنْ أَبِي هُرَيْرَةَ، عَنْ عَائِشَةَ قَالَتْ: قَالَ رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي ذُيُولِ النِّسَاءِ شِبْرًا. قُلْتُ: إِذًا يَخْرُجُ سُوقُهُنَّ. قَالَ: فَذِرَاعٌ.","","Musnad Ishaq ibn Rahwayh 710","","","Women's garments should be below the ankles"
"711","أَخْبَرَنَا جَرِيرٌ، عَنْ مَنْصُورٍ، عَنْ رِبْعِيِّ بْنِ حِرَاشٍ، عَنِ امْرَأَتِهِ، عَنْ أُخْتٍ لِحُذَيْفَةَ قَالَتْ: خَطَبَنَا رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: ((يَا مَعْشَرَ النِّسَاءِ، أَمَا لَكُنَّ فِي الْفِضَّةِ مَا تَحَلَّيْنَ بِهِ، إِنَّهُ لَيْسَ مِنَ امْرَأَةٍ تَحَلَّى ذَهَبًا تُظْهِرُهُ إِلَّا عُذِّبَتْ بِهِ)).","","Musnad Ishaq ibn Rahwayh 711","","","Prohibition of wearing gold jewelry for display"
"712","أَخْبَرَنَا عُمَرُ بْنُ عُبَيْدٍ، عَنْ مَنْصُورٍ، عَنْ رِبْعِيِّ بْنِ حِرَاشٍ، عَنْ أُخْتٍ لِحُذَيْفَةَ قَالَتْ: خَطَبَنَا رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ، فَذَكَرَ مِثْلَهُ.","","Musnad Ishaq ibn Rahwayh 712","","","Prohibition of wearing gold jewelry for display"
"713","أَخْبَرَنَا جَرِيرٌ، عَنْ مُحَمَّدِ بْنِ عَجْلَانَ، عَنْ بُكَيْرِ بْنِ عَبْدِ اللَّهِ بْنِ الْأَشَجِّ، عَنْ بُسْرِ بْنِ سَعِيدٍ، عَنْ زَيْنَبَ امْرَأَةِ عَبْدِ اللَّهِ قَالَتْ: قَالَ لَنَا رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: ((إِذَا شَهِدَتْ إِحْدَاكُنَّ الْعِشَاءَ الْآخِرَةَ فَلَا تَمَسُّ طِيبًا)).","","Musnad Ishaq ibn Rahwayh 713","","","Prohibition of women wearing perfume to the mosque"
"714","اَخْبَرَنَا اَبُوْ عَامِرِ الْعَقَدِیُّ۔ عَبْدُالْمَلِكِ بْنِ عَمْرٍو۔ نَا مُحَمَّدُ بْنُ طَلْحَةَ بْنِ مُصَرِّفٍ، عَنْ حُمَیْدِ بْنِ وَهْبٍ، عَنِ ابْنِ طَاؤُوْسٍ، عَنْ اِبْرَاهِیْمَ، عَنِ ابْنِ عَبَّاسٍ اَنَّ رَسُوْلَ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ مَرَّ بِرَجُلٍ قَدْ خَضَبَ بِالْحِنَّاءِ، فَقَالَ: مَا اَحْسَنَ هٰذَا، ثُمَّ مَرَّ بِاٰخَرَ قَدْ خَضَبَ بِالْحِنَّاءِ وَالْکَتْمِ، فَقَالَ: هٰذَا اَحْسَنُ مِنْ هَذَا؟ ثُمَّ مَرَّ بِاٰخَرَ قَدْ خَضَبَ بِالصُّفْرَةِ، فَقَالَ: ہٰذَا اَحْسَنُ مِنْ هَذَا کُلِّهٖ۔ قَالَ: فَکَانَ طَاؤُوْسٌ یَخْضِبُ (بالصفرة).","","Musnad Ishaq ibn Rahwayh 714","","","Description of dyeing hair"
"715","اَخْبَرَنَا یَحْیَ بْنُ آدَمَ، وَاِسْرَائِیْلُ، عَنْ اَبِیْ یَحْیَی الثِّقَاتِ، عَنْ مُجَاهِدٍ،عَنِ ابْنِ عَبَّاسٍ، رَاٰی رَسُوْلُ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ فَخِذَ رَجُلٍ، فَقَالَ لَهٗ: غَطِّ فَخِذَكَ فَاِنَّ فَخِذَ الرَّجُلِ مِنْ عَوْرَتِهٖ.","","Musnad Ishaq ibn Rahwayh 715","","","Men must cover their thighs as they are part of the awrah"
