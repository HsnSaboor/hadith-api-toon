hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"10021","(۱۰۰۲۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : فِی ثَلاَثِینَ مِنَ الْبَقَرِ تَبِیعٌ ، أَوْ تَبِیعَۃٌ ، وَفِی أَرْبَعِینَ مُسِنَّۃٌ.","","Musannaf Ibn Abi Shaybah 10021","","","كتاب الزكاة"
"10022","(۱۰۰۲۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنْ عِکْرِمَۃَ بْنِ خَالِدٍ ، قَالَ : اُسْتُعْمِلْتُ عَلَی صَدَقَاتِ عَکٍّ ، فَلَقِیتُ أَشْیَاخًا مِمَّنْ صَدَّقَ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَاخْتَلَفُوا عَلَیَّ ، فَمِنْہُمْ مَنْ قَالَ اجْعَلْہَا مِثْلَ صَدَقَۃِ الإِبِلِ ، وَمِنْہُمْ مَنْ قَالَ فِی ثَلاَثِینَ تَبِیعٌ ، وَمِنْہُمْ مَنْ قَالَ فِی أَرْبَعِینَ بَقَرَۃٍ بَقَرَۃٌ مُسِنَّۃٌ","Da'if","Musannaf Ibn Abi Shaybah 10022","","","كتاب الزكاة"
"10023","(۱۰۰۲۳) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : فِی ثَلاَثِینَ تَبِیعٌ ، أَوْ تَبِیعَۃٌ جَذَعٌ ، أَوْ جَذَعَۃٌ ، وَفِی أَرْبَعِینَ مُسِنَّۃٌ.","","Musannaf Ibn Abi Shaybah 10023","","","كتاب الزكاة"
"10024","(۱۰۰۲۴) حَدَّثَنَا زَیْدُ بْنُ حَبَّابٍ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، عَنِ الْعَلاَئِ بْنِ الْحَارِثِ ، عَنْ مَکْحُولٍ ، قَالَ : إذَا بَلَغَتْ ثَلاَثِینَ فَفِیہَا تَبِیعٌ ، أَوْ تَبِیعَۃٌ ، فَإِذَا بَلَغَتْ أَرْبَعِینَ فَفِیہَا مُسِنَّۃٌ.","","Musannaf Ibn Abi Shaybah 10024","","","كتاب الزكاة"
"10025","(۱۰۰۲۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ؛ أَنَّہُ قَالَ : فِی ثَلاَثِینَ مِنَ الْبَقَرِ تَبِیعٌ جَذَعٌ ، أَوْ جَذَعَۃٌ ، وَفِی کُلِّ أَرْبَعِینَ بَقَرَۃً بَقَرَۃٌ.","","Musannaf Ibn Abi Shaybah 10025","","","كتاب الزكاة"
"10026","(۱۰۰۲۶) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ صَالِحِ بْنِ دِینَارٍ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ إلَی عُثْمَانَ بْنِ مُحَمَّدِ بْنِ أَبِی سُوَیْد : أَنْ یَأْخُذَ مِنْ کُلِّ ثَلاَثِینَ بَقَرَۃً تَبِیعًا ، وَمِنْ کُلِّ أَرْبَعِینَ بَقَرَۃً بَقَرَۃً ، وَلَمْ یَزِدْ عَلَی ذَلِکَ.","","Musannaf Ibn Abi Shaybah 10026","","","كتاب الزكاة"
"10027","(۱۰۰۲۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا ؟ فَقَالاَ : فِی ثَلاَثِینَ جَذَعٌ ، أَوْ جَذَعَۃٌ ، وَفِی أَرْبَعِینَ مُسِنَّۃٌ.","","Musannaf Ibn Abi Shaybah 10027","","","كتاب الزكاة"
"10028","(۱۰۰۲۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عَمْرٌو ، قَالَ : کَانَ عُثْمانُ بْنُ الزُّبَیْرِ بْنِ أَبِی عَوْفٍ وَغَیْرُہُ یَأْخُذُونَ مِنْ کُلِّ خَمْسِینَ بَقَرَۃً بَقَرَۃً.","","Musannaf Ibn Abi Shaybah 10028","","","كتاب الزكاة"
"10029","(۱۰۰۲۹) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، قَالَ : إذَا بَلَغَتِ الْبَقَرُ ثَلاَثِینَ فَفِیہَا تَبِیعٌ ، أَوْ جَذَعٌ ، أَوْ جَذَعَۃٌ حَتَّی تَبْلُغَ أَرْبَعِینَ ، فَإِذَا بَلَغَتْ أَرْبَعِینَ فَفِیہَا بَقَرَۃٌ مُسِنَّۃٌ.","","Musannaf Ibn Abi Shaybah 10029","","","كتاب الزكاة"
"10030","(۱۰۰۳۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ؛ أَنَّ نُعَیْمَ بْنَ سَلاَمَۃَ أَخْبَرَہُ، وَہُوَ الَّذِی کَانَ خَاتَمُ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ فِی یَدِہِ : أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ دَعَا بِصَحِیفَۃٍ ، زَعَمُوا أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَتَبَ بِہَا إلَی مُعَاذٍ ، فَقَالَ نُعَیْمٌ : فَقُرِئَتْ وَأَنَا حَاضِرٌ ، فَإِذَا فِیہَا : مِنْ کُلِّ ثَلاَثِینَ تَبِیعًا جَذَعٌ ، أَوْ جَذَعَۃٌ ، وَمِنْ کُلِّ أَرْبَعِینَ بَقَرَۃً بَقَرَۃٌ مُسِنَّۃٌ ، قَالَ نُعَیْمٌ : فَقُلْتُ : تَبِیعُ الْجَذَعِ ، فَقَالَ عُمَرُ: بَلْ تَبِیعٌ جَذَعٌ.","","Musannaf Ibn Abi Shaybah 10030","","","كتاب الزكاة"
"10031","(۱۰۰۳۱) حَدَّثَنَا زَیْدُ بْنُ حَبَّابٍ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، عَنِ الْعَلاَئِ بْنِ الْحَارِثِ ، عَنْ مَکْحُولٍ ، قَالَ : لَیْسَ فِیمَا دُونَ الثَّلاَثِینَ مِنَ الْبَقَرِ شَیْئٌ.","","Musannaf Ibn Abi Shaybah 10031","","","كتاب الزكاة"
"10032","(۱۰۰۳۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، قَالَ : حدَّثَنَا ابْنُ جُرَیْجٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، قَالَ : لَیْسَ فِیمَا دُونَ الثَّلاَثِینَ بَقَرَۃً شَیْئٌ.","","Musannaf Ibn Abi Shaybah 10032","","","كتاب الزكاة"
"10033","(۱۰۰۳۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ، عَنْ زَکَرِیَّا، عَنْ أَبِی إِسْحَاقَ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ، عَنْ عَلِیٍّ، قَالَ: لَیْسَ فِیہَا شَیْئٌ.","Hasan","Musannaf Ibn Abi Shaybah 10033","","","كتاب الزكاة"
"10034","(۱۰۰۳۴) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَمْرِو بْنِ مُرَّۃً ، عَنْ أَبِی الْبَخْتَرِیِّ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : لَیْسَ فِیمَا دُونَ الثَّلاَثِینَ مِنَ الْبَقَرِ شَیْئٌ.","Da'if","Musannaf Ibn Abi Shaybah 10034","","","كتاب الزكاة"
"10035","(۱۰۰۳۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ ابْن أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، قَالَ : بَعَثَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُعَاذًا ، فَأَمَرَہُ أَنْ یَأْخُذَ مِنَ الْبَقَرِ مِنْ کُلِّ ثَلاَثِینَ تَبِیعًا ، أَوْ تَبِیعَۃً ، وَمِنْ کُلِّ أَرْبَعِینَ مُسِنَّۃً ، فَسَأَلُوہُ عَنْ فَضْلِ مَا بَیْنَہُمَا ؟ فَأَبَی أَنْ یَأْخُذَ حَتَّی سَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : لاَ تَأْخُذْ شَیْئًا. (احمد ۵/۲۴۰۔ مالک ۲۴)","Da'if","Musannaf Ibn Abi Shaybah 10035","","","كتاب الزكاة"
"10036","(۱۰۰۳۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنْ مُعَاذٍ ، قَالَ : لَیْسَ فِی الأَوْقَاصِ شَیْئٌ.","Da'if","Musannaf Ibn Abi Shaybah 10036","","","كتاب الزكاة"
"10037","(۱۰۰۳۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَیْسَ فِی الأَشْنَاقِ شَیْئٌ.","","Musannaf Ibn Abi Shaybah 10037","","","كتاب الزكاة"
"10038","(۱۰۰۳۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ ، قَالَ : فِی أَرْبَعِینَ مُسِنَّۃٌ ، وَفِی ثَلاَثِینَ تَبِیعٌ ، وَلَیْسَ فِی النَّیِّفِ شَیْئٌ.","Da'if","Musannaf Ibn Abi Shaybah 10038","","","كتاب الزكاة"
"10039","(۱۰۰۳۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا ، قُلْتُ : إِنْ کَانَتْ خَمْسِینَ بَقَرَۃً ؟ فَقَالَ الْحَکَمُ : فِیہَا مُسِنَّۃٌ ، وَقَالَ حَمَّادٌ : بِحِسَابِ ذَلِکَ.","","Musannaf Ibn Abi Shaybah 10039","","","كتاب الزكاة"
"10040","(۱۰۰۴۰) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ حَجَّاجٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : صَاحِبُ الْبَقَرِ بِمَا فَوْقَ الْفَرِیضَۃِ.","","Musannaf Ibn Abi Shaybah 10040","","","كتاب الزكاة"
"10041","(۱۰۰۴۱) حَدَّثَنَا زَیْدُ بْنُ حَبَّابٍ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، عَنِ الْعَلاَئِ بْنِ الْحَارِثِ ، عَنْ مَکْحُولٍ ، قَالَ : مَا زَادَ فَبِالْحِسَابِ.","","Musannaf Ibn Abi Shaybah 10041","","","كتاب الزكاة"
"10042","(۱۰۰۴۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی أَبُو بَکْرِ بْنُ عَبْدِ اللہِ ، عَنِ ابْنِ شِہَابٍ ، قَالَ : لَیْسَ فِی الْفُضُولِ شَیْئٌ إِلاَّ أَنْ یَکُونَ تَأْلِیفٌ.","","Musannaf Ibn Abi Shaybah 10042","","","كتاب الزكاة"
"10043","(۱۰۰۴۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : التَّبِیعُ : الَّذِی قَدِ اسْتَوَی قَرْنَاہُ وَأُذُنَاہُ ، وَالْمُسِنُّ : الثَّنِیُّ فَصَاعِدًا.","","Musannaf Ibn Abi Shaybah 10043","","","كتاب الزكاة"
"10044","(۱۰۰۴۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ الْحَذَّائِ ، قَالَ : قُلْتُ لأَبِی قِلاَبَۃَ : کَمِ السَّائِمَۃُ ؟ قَالَ : مِئَۃ.","","Musannaf Ibn Abi Shaybah 10044","","","كتاب الزكاة"
"10045","(۱۰۰۴۵) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَیْسَ فِی شَیْئٍ مِنَ السَّوَائِمِ صَدَقَۃٌ ، إِلاَّ إنَاثِ الإِبِلِ ، وَإِنَاثِ الْبَقَرِ وَالْغَنَمِ.","","Musannaf Ibn Abi Shaybah 10045","","","كتاب الزكاة"
"10046","(۱۰۰۴۶) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : لَیْسَ فِی الْبَقَرِ الْعَوَامِلِ صَدَقَۃٌ.","Hasan","Musannaf Ibn Abi Shaybah 10046","","","كتاب الزكاة"
"10047","(۱۰۰۴۷) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ لَیْثٍ، عَنْ طَاوُوسٍ، عَنْ مُعَاذٍ؛ أَنَّہُ کَانَ لاَ یَأْخُذُ مِنَ الْبَقَرِ الْعَوَامِلِ صَدَقَۃً.","Da'if","Musannaf Ibn Abi Shaybah 10047","","","كتاب الزكاة"
"10048","(۱۰۰۴۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، وَمُجَاہِدٍ ، قَالاَ : لَیْسَ فِی الْبَقَرِ الْعَوَامِلِ صَدَقَۃٌ.","","Musannaf Ibn Abi Shaybah 10048","","","كتاب الزكاة"
"10049","(۱۰۰۴۹) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ، عَنْ حَجَّاجٍ، عَنِ الْحَکَمِ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ، قَالَ: لَیْسَ فِی الْبَقَرِ الْعَوَامِلِ صَدَقَۃٌ.","","Musannaf Ibn Abi Shaybah 10049","","","كتاب الزكاة"
"10050","(۱۰۰۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لَیْسَ عَلَی جَمَلٍ ظَعِینَۃٍ ، وَلاَ عَلَی ثَوْرٍ عَامِلٍ صَدَقَۃٌ.","","Musannaf Ibn Abi Shaybah 10050","","","كتاب الزكاة"
"10051","(۱۰۰۵۱) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : لَیْسَ فِی عَوَامِلِ الْبَقَرِ شَیْئٌ ، إِلاَّ مَا کَانَ سَائِمًا ، وَذَلِکَ فِی الإِبِلِ.","","Musannaf Ibn Abi Shaybah 10051","","","كتاب الزكاة"
"10052","(۱۰۰۵۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ شَہْرٍ ، قَالَ : لَیْسَ فِی الْبَقَرِ الْعَوَامِلِ صَدَقَۃٌ.","","Musannaf Ibn Abi Shaybah 10052","","","كتاب الزكاة"
"10053","(۱۰۰۵۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَیْسَ فِی الْبَقَرِ الْعَوَامِلِ صَدَقَۃٌ.","","Musannaf Ibn Abi Shaybah 10053","","","كتاب الزكاة"
"10054","(۱۰۰۵۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : لَیْسَ عَلَی الْبَقَرِ الْعَوَامِلِ ، وَلاَ عَلَی الإِبِلِ الَّتِی یُسْتَقَی عَلَیْہَا النَّوَاضِحِ ، وَیُغْزَی عَلَیْہَا فِی سَبِیلِ اللہِ صَدَقَۃٌ.","","Musannaf Ibn Abi Shaybah 10054","","","كتاب الزكاة"
"10055","(۱۰۰۵۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی زِیَادٌ ، أَنَّ أَبَا الزُّبَیْرِ أَخْبَرَہُ ، عَنْ جَابِرٍ ، قَالَ : لاَ صَدَقَۃَ فِی الْمُثِیرَۃِ.","Sahih","Musannaf Ibn Abi Shaybah 10055","","","كتاب الزكاة"
"10056","(۱۰۰۵۶) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : الْحَمُولَۃُ وَالْمُثِیرَۃُ فِیہَا الصَّدَقَۃ ؟ قَالَ : لاَ ، وَقَالَ عَمْرُو بْنُ دِینَارٍ : سَمِعْنَا ذَلِکَ.","","Musannaf Ibn Abi Shaybah 10056","","","كتاب الزكاة"
"10057","(۱۰۰۵۷) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَتَبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کِتَابَ الصَّدَقَۃِ فَقَرَنَہُ بِسَیْفِہِ ، أَوَ قَالَ : بِوَصِیَّتِہِ وَلَمْ یُخْرِجْہُ إلَی عُمَّالِہِ حَتَّی قُبِضَ ، عمِلَ بِہِ أَبُو بَکْرٍ حَتَّی ہَلَکَ ، وَعَمِلَ بِہِ عُمَرُ : فِی صَدَقَۃِ الْغَنَمِ فِی کُلِّ أَرْبَعِینَ شَاۃً شَاۃٌ إلَی عِشْرِینَ وَمِئَۃٍ ، فَإِنْ زَادَتْ فَشَاتَانِ إلَی مِئَتَیْنِ ، فَإِنْ زَادَتْ فَثَلاَثٌ إلَی ثَلاَثِ مِئَۃٍ ، فَإِنْ زَادَتْ فَفِی کُلِّ مِئَۃِ شَاۃٍ شَاۃٌ ، لَیْسَ فِیہَا شَیْئٌ حَتَّی تَبْلُغَ الْمِئَۃَ ، وَلاَ یُفَرَّقُ بَیْنَ مُجْتَمِعٍ ، وَلاَ یُجْمَعُ بَیْنَ مُفْتَرِقٍ ، وَمَا کَانَ مِنْ خَلِیطَیْنِ ، فَإِنَّہُمَا یَتَرَاجَعَانِ بِالسَّوِیَّۃِ.","Da'if","Musannaf Ibn Abi Shaybah 10057","","","كتاب الزكاة"
"10058","(۱۰۰۵۸) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : فِی کُلِّ أَرْبَعِینَ شَاۃً شَاۃٌ إلَی عِشْرِینَ وَمِئَۃٍ ، فَإِنْ زَادَتْ فَفِیہَا شَاتَانِ إلَی مِئَتَیْنِ ، فَإِنْ زَادَتْ فَفِیہَا ثَلاَثُ شِیَاہٍ إلَی ثَلاَثِ مِئَۃٍ ، فَإِنْ کَثُرَتِ الْغَنَمُ فَفِی کُلِّ مِئَۃِ شَاۃٍ شَاۃٌ.","Hasan","Musannaf Ibn Abi Shaybah 10058","","","كتاب الزكاة"
"10059","(۱۰۰۵۹) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: فِی کُلِّ أَرْبَعِینَ شَاۃً شَاۃٌ إلَی عِشْرِینَ وَمِئَۃٍ، فَإِذَا زَادَتْ وَاحِدَۃً فَفِیہَا شَاتَانِ إلَی مِئَتَیْنِ ، فَإِنْ زَادَتْ شَاۃً وَاحِدَۃً فَفِیہَا ثَلاَثُ شِیَاہٍ إلَی ثَلاَثِ مِئَۃٍ فِی کُلِّ مِئَۃ شَاۃٍ شَاۃٌ.","","Musannaf Ibn Abi Shaybah 10059","","","كتاب الزكاة"
"10060","(۱۰۰۶۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إلَی أَرْبَعِ مِئَۃٍ ، فَإِنْ زَادَتْ وَاحِدَۃً فَإِلَی خَمْسِ مِئَۃٍ ، ثُمَّ عَلَی ہَذَا الْحِسَابِ.","","Musannaf Ibn Abi Shaybah 10060","","","كتاب الزكاة"
"10061","(۱۰۰۶۱) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : فِی أَرْبَعِینَ شَاۃً شَاۃٌ إلَی عِشْرِینَ وَمِئَۃٍ ، فَإِذَا جَاوَزَتِ الْعِشْرِینَ وَمِئَۃ فَشَاتَانِ حَتَّی تَبْلُغَ الْمِئَتَیْنِ، وَإِذَا جَاوَزَ الْمِئَتَیْنِ فَثَلاَثُ شِیَاہٍ حَتَّی تَبْلُغَ الثَّلاَثَ مِئَۃ.","","Musannaf Ibn Abi Shaybah 10061","","","كتاب الزكاة"
"10062","(۱۰۰۶۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنْ عَامِرٍ ، عَنْ عَلِیٍّ ، فِی صَدَقَۃِ الْغَنَمِ ، قَالَ: إذَا بَلَغَتْ أَرْبَعِینَ فَفِیہَا شَاۃٌ إلَی عِشْرِینَ وَمِئَۃٍ ، فَإِذَا زَادَتْ وَاحِدَۃً فَفِیہَا شَاتَانِ إلَی مِئَتَیْنِ ، فَإِذَا زَادَتْ وَاحِدَۃً فَفِیہَا ثَلاَثُ شِیَاہٍ إلَی ثَلاَثِ مِئَۃٍ ، فَإِذَا زَادَتْ عَلَی ثَلاَثِ مِئَۃٍ وَکَثُرَتْ فَفِی کُلِّ مِئَۃِ شَاۃٍ شَاۃٌ ، وَقَالَ عَبْدُ اللہِ مِثْلَ قَوْلِ عَلِیٍّ حَتَّی تَبْلُغَ ثَلاَثَ مِئَۃٍ ، ثُمَّ قَالَ عَبْدُ اللہِ : فَإِذَا زَادَتْ وَاحِدَۃً عَلَی ثَلاَثِ مِئَۃٍ فَفِیہَا أَرْبَعٌ إلَی أَرْبَعِ مِئَۃٍ ، ثُمَّ عَلَی ہَذَا الْحِسَابِ.n قَالَ مُحَمَّدٌ : أَخْبَرَنَا عَامِرٌ ، عَنْ عَلِیٍّ ، وَعَبْدِ اللہِ ، قَالاَ : لاَ یُجْمَعُ بَیْنَ مُفْتَرِقٍ ، وَلاَ یُفَرَّقُ بَیْنَ مُجْتَمِعٍ.","Da'if","Musannaf Ibn Abi Shaybah 10062","","","كتاب الزكاة"
"10063","(۱۰۰۶۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إذَا بَلَغَتْ أَرْبَعِینَ فَفِیہَا شَاۃٌ حَتَّی تَبْلُغَ عِشْرِینَ وَمِئَۃ ، فَإِذَا زَادَتْ وَاحِدَۃً فَفِیہَا شَاتَانِ إلَی مِئَتَیْنِ ، فَإِذَا زَادَتْ وَاحِدَۃً فَفِیہَا ثَلاَثُ شِیَاہٍ إلَی ثَلاَثِ مِئَۃٍ ، فَإِذَا زَادَتْ فَفِی کُلِّ مِئَۃِ شَاۃٍ شَاۃٌ ، وَسَقَطَتِ الأَرْبَعُونَ.","","Musannaf Ibn Abi Shaybah 10063","","","كتاب الزكاة"
"10064","(۱۰۰۶۴) حُدِّثَنَا حَفْص ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ عُمَرَ کَانَ إذَا بَعَثَ الْمُصَدِّقَ بَعَثَ مَعَہُ بِکِتَابٍ : لَیْسَ فِی أَقَلَّ مِنْ أَرْبَعِینَ شَاۃٍ شَیْئٌ.","Da'if","Musannaf Ibn Abi Shaybah 10064","","","كتاب الزكاة"
"10065","(۱۰۰۶۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : إِنْ لَمْ یَکُنْ لَکَ إِلاَّ تِسْعٌ وَثَلاَثُونَ شَاۃً ، فَلَیْسَ فِیہَا صَدَقَۃٌ.","Hasan","Musannaf Ibn Abi Shaybah 10065","","","كتاب الزكاة"
"10066","(۱۰۰۶۶) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَبْدِ الْکَرِیمِ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لَیْسَ فِی أَقَلَّ مِنْ أَرْبَعِینَ شَیْئٌ.","Da'if","Musannaf Ibn Abi Shaybah 10066","","","كتاب الزكاة"
"10067","(۱۰۰۶۷) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : کَانَ الْکِتَابُ الَّذِی کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ حِینَ بَعَثَہُمْ یُصَدِّقُونَ : لاَ صَدَقَۃَ فِی الْغَنَمِ حَتَّی تَبْلُغَ أَرْبَعِینَ.","","Musannaf Ibn Abi Shaybah 10067","","","كتاب الزكاة"
"10068","(۱۰۰۶۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لَیْسَ فِیمَا دُونَ أَرْبَعِینَ مِنَ الشَّائِ صَدَقَۃٌ.","","Musannaf Ibn Abi Shaybah 10068","","","كتاب الزكاة"
"10069","(۱۰۰۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ فِطْرٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَیْسَ فِیمَا زَادَ عَلَی الثَّلاَثِ مِئَۃٍ شَیْئٌ حَتَّی تَبْلُغَ أَرْبَعَ مِئَۃٍ.","","Musannaf Ibn Abi Shaybah 10069","","","كتاب الزكاة"
"10070","(۱۰۰۷۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَمْزَۃَ ، عَنِ الْحَکَمِ ، قَالَ : لَیْسَ فِیمَا زَادَ عَلَی ثَلاَثِ مِئَۃٍ شَیْئٌ ، حَتَّی تَبْلُغَ أَرْبَعَ مِئَۃٍ ، یَعْنِی الْغَنَمَ.","","Musannaf Ibn Abi Shaybah 10070","","","كتاب الزكاة"
"10071","(۱۰۰۷۱) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، قَالَ : کَتَبَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کِتَابَ الصَّدَقَۃِ فَقَرَنَہُ بِسَیْفِہِ ، أَوَ قَالَ : بِوَصِیَّتِہِ فَلَمْ یُخْرِجْہُ إلَی عُمَّالِہِ حَتَّی قُبِضَ ، عَمِلَ بِہِ أَبُو بَکْرٍ حَتَّی ہَلَکَ ، ثُمَّ عَمِلَ بِہِ عُمَرُ ، قَالَ : فِی الْغَنَمِ فِی ثَلاَثِ مِئَۃِ شَاۃٍ ثَلاَثُ شِیَاہٍ ، فَإِنْ زَادَتْ فَفِی کُلِّ مِئَۃِ شَاۃٍ شَاۃٌ ، وَلَیْسَ فِیہَا شَیْئٌ حَتَّی تَبْلُغَ الْمِئَۃَ.","Da'if","Musannaf Ibn Abi Shaybah 10071","","","كتاب الزكاة"
"10072","(۱۰۰۷۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إذَا زَادَتْ عَلَی الْمِائَتَیْنِ وَاحِدَۃً فَفِیہَا ثَلاَثُ شِیَاہٍ إلَی ثَلاَثِ مِئَۃٍ ، فَإِذَا زَادَتْ فَفِی کُلِّ مِئَۃِ شَاۃٍ شَاۃٌ ، وَسَقَطَتِ الأَرْبَعُونَ.","","Musannaf Ibn Abi Shaybah 10072","","","كتاب الزكاة"
"10073","(۱۰۰۷۳) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا زَادَتْ عَلَی الثَّلاَثِ مِئَۃٍ فَفِی کُلِّ مِئَۃٍ شَاۃٌ.","","Musannaf Ibn Abi Shaybah 10073","","","كتاب الزكاة"
"10074","(۱۰۰۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ رَجُلٍ ، عَنْ مُجَاہِدٍ ؛ فِی الرَّجُلِ تَکُونُ لَہُ أَرْبَعُونَ شَاۃً فِی الْمِصْرِ یَحْلِبُہَا ، قَالَ : لَیْسَ عَلَیْہِ صَدَقَۃٌ.","","Musannaf Ibn Abi Shaybah 10074","","","كتاب الزكاة"
"10075","(۱۰۰۷۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَیْسَ فِی غَنَمِ الرَّبَائِبِ صَدَقَۃٌ.","","Musannaf Ibn Abi Shaybah 10075","","","كتاب الزكاة"
"10076","(۱۰۰۷۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالاَ : لاَ یُعْتَدُّ بِالسَّخْلَۃِ ، وَلاَ تُؤْخَذُ فِی الصَّدَقَۃِ.","","Musannaf Ibn Abi Shaybah 10076","","","كتاب الزكاة"
"10077","(۱۰۰۷۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ، قَالَ: قُلْتُ لَہُ: أَیُعْتَدُّ بِالصِّغَارِ أَوْلاَدِ الشَّائِ؟ قَالَ: نَعَمْ.","","Musannaf Ibn Abi Shaybah 10077","","","كتاب الزكاة"
"10078","(۱۰۰۷۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : یُعْتَدُّ بِالصَّغِیرِ حِینَ تُنْتِجُہُ أُمُّہُ.","","Musannaf Ibn Abi Shaybah 10078","","","كتاب الزكاة"
"10079","(۱۰۰۷۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ بِشْرِ بْنِ عَاصِمٍ ، عَنْ أَبِیہِ ، عَنْ عُمَرَ ؛ اسْتَعْمَلَ أَبَاہُ عَلَی الطَّائِفِ وَمَخَالیفہا ، فَکَانَ یُصَدِّقُ فَاعْتَدَّ عَلَیْہِمْ بِالْغِذَائِ ، فَقَالَ لَہُ النَّاسُ : إِنْ کُنْت مُعْتَدًّا بِالْغِذَائِ فَخُذْ مِنْہُ ، فَأَمْسَکَ عَنْہُمْ حَتَّی لَقِیَ عُمَرَ ، فَأَخْبَرَہُ بِالَّذِی قَالُوا ، فَقَالَ : اعْتَدْ عَلَیْہِمْ بِالْغِذَائِ ، وَإِنْ جَائَ بِہَا الرَّاعِی یَحْمِلُہَا عَلَی یَدِہِ ، وَأَخْبِرْہُمْ أَنَّک تَدَعُ لَہُمَ الرُّبَّی وَالْمَاخِضَ وَالأَکِیلَۃَ وَفَحْلَ الْغَنَمِ ، وَخُذِ الْعَنَاقَ وَالْجَذَعَۃَ وَالثَّنِیَّۃَ ، فَذَلِکَ عَدْلٌ بَیْنَ خِیَارِ الْمَالِ وَالْغِذَائِ.","Hasan","Musannaf Ibn Abi Shaybah 10079","","","كتاب الزكاة"
"10080","(۱۰۰۸۰) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنِ النَّہَّاسِ بْنِ قَہْمٍ، قَالَ: حدَّثَنَا الْحَسَنُ بْنُ مُسْلِمٍ، قَالَ: بَعَثَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سُفْیَانَ بْنَ عَبْدِ اللہِ عَلَی الصَّدَقَۃِ ، فَقَالَ : خُذْ مَا بَیْنَ الْغَذِیَّۃِ ، وَالْہَرِمَۃِ ، یَعْنِی بِالْغَذِیَّۃِ السَّخْلَۃَ.","Da'if","Musannaf Ibn Abi Shaybah 10080","","","كتاب الزكاة"
"10081","(۱۰۰۸۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ رَجُلٍ مِنْ ثَقِیفٍ ، قَالَ : سَأَلْتُ أَبَا ہُرَیْرَۃَ : فِی أَیِّ الْمَالِ صَدَقَۃٌ ؟ فَقَالَ : فِی الثُّلُثِ الأَوْسَطِ ، فَإِذَا أَتَاک الْمُصَدِّقُ فَأَخْرِجْ لَہُ الْجَذَعَۃَ وَالثَّنِیَّۃَ.","Da'if","Musannaf Ibn Abi Shaybah 10081","","","كتاب الزكاة"
"10082","(۱۰۰۸۲) حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، عَنْ مَعْمَرٍ، عَنْ سِمَاکٍ ، عَنِ ابْنِ شِہَابٍ ، أَو شِہَابِ بْنِ مَالِکٍ ، عَنْ سَعِیدٍ الأَعْرَجِ، قَالَ: خَرَجْت أُرِیدُ الْجِہَادَ ، فَلَقِیتُ عُمَرَ بِمَکَّۃَ ، فَقَالَ: بإِذْنِ صَاحِبِکَ خَرَجتَ؟ یَعْنِی یَعْلَی بْنَ أُمَیَّۃَ، قَالَ: قُلْتُ : لاَ ، قَالَ : فَارْجِعْ إلَی صَاحِبِکَ ، فَإِذَا أَوْقَفَ الرَّجُلُ عَلَیْکُمْ غَنَمَہُ ، فَاصْدَعُوہَا صَدْعَیْنِ ، ثُمَّ اخْتَارُوا مِنَ النِّصْفِ الآخَرَ.","Da'if","Musannaf Ibn Abi Shaybah 10082","","","كتاب الزكاة"
"10083","(۱۰۰۸۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سَمِعْتُ أَبِی وَغَیْرَہُ یَذْکُرُونَ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ : أَنْ تُقَسَّمَ الْغَنَمُ أَثْلاَثًا ، ثُمَّ یَخْتَارُ سَیِّدُہَا ثُلُثًا ، وَیَأْخُذُ الْمُصَدِّقُ مِنَ الثُّلُثِ الأَوْسَطِ.","","Musannaf Ibn Abi Shaybah 10083","","","كتاب الزكاة"
"10084","(۱۰۰۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عُبَیْدِ اللہِ ، عَنِ الْقَاسِمِ ، قَالَ : تُقْسَمُ الْغَنَمُ أَثْلاَثًا.","","Musannaf Ibn Abi Shaybah 10084","","","كتاب الزكاة"
"10085","(۱۰۰۸۵) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إذَا جَائَ الْمُصَدِّقُ قُسِمَتِ الْغَنَمُ أَثْلاَثًا : ثُلُثٌ خِیَارٌ ، وَثُلُثٌ شِرَارٌ، وَثُلُثٌ أَوْسَاطٌ ، وَیَأْخُذُ الْمُصَدِّقُ مِنَ الْوَسَطِ.","","Musannaf Ibn Abi Shaybah 10085","","","كتاب الزكاة"
"10086","(۱۰۰۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنِ الْحَکَمِ ، قَالَ : کَانَ الْمُصَدِّقُ یَصْدَعُ الْغَنَمَ صَدْعَیْنِ ، فَیَخْتَارُ صَاحِبُ الْغَنَمِ خَیْرَ الصَّدْعَیْنِ.","","Musannaf Ibn Abi Shaybah 10086","","","كتاب الزكاة"
"10087","(۱۰۰۸۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : یَقْسِمُ الْغَنَمَ قِسْمَیْنِ ، فَیَخْتَارُ صَاحِبُ الْغَنَمِ خَیْرَ الْقِسْمَیْنِ ، وَیَخْتَارُ الْمُصَدِّقُ مِنَ الْقَسَمِ الأَخرَ.","","Musannaf Ibn Abi Shaybah 10087","","","كتاب الزكاة"
"10088","(۱۰۰۸۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَجْمَعُ الشَّائَ فَیَأْخُذُ صَاحِبُ الْغَنَمِ الثُّلُثَ مِنْ خِیَارِہِ ، وَیَأْخُذُ صَاحِبُ الصَّدَقَۃِ مِنَ الثُّلُثَیْنِ حَقَّہُ.","","Musannaf Ibn Abi Shaybah 10088","","","كتاب الزكاة"
"10089","(۱۰۰۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : تُفَرَّقُ فِرْقَتَیْنِ.","","Musannaf Ibn Abi Shaybah 10089","","","كتاب الزكاة"
"10090","(۱۰۰۹۰) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ؛ نَحْوَہُ.","","Musannaf Ibn Abi Shaybah 10090","","","كتاب الزكاة"
"10091","(۱۰۰۹۱) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَتَبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کِتَابَ الصَّدَقَۃِ فَقَرَنَہُ بِسَیْفِہِ ، أَوَ قَالَ : بِوَصِیَّتِہِ ثُمَّ لَمْ یُخْرِجْہُ إلَی عُمَّالِہِ حَتَّی قُبِضَ ، فَلَمَّا قُبِضَ عَمِلَ بِہِ أَبُو بَکْرٍ حَتَّی ہَلَکَ ، ثُمَّ عَمِلَ بِہِ عُمَرُ : لاَ یُؤْخَذُ فِی الصَّدَقَۃِ ہَرِمَۃٌ ، وَلاَ ذَاتُ عَوَارٍ.","Da'if","Musannaf Ibn Abi Shaybah 10091","","","كتاب الزكاة"
"10092","(۱۰۰۹۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : لاَ یَأْخُذُ الْمُصَدِّقُ ہَرِمَۃً ، وَلاَ ذَاتَ عَوَارٍ ، وَلاَ تَیْسًا إِلاَّ أَنْ یَشَائَ الْمُصَدِّقُ.","Hasan","Musannaf Ibn Abi Shaybah 10092","","","كتاب الزكاة"
"10093","(۱۰۰۹۳) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ خُصَیْفٍ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : لَیْسَ لِلْمُصَدِّقِ ہَرِمَۃٌ ، وَلاَ ذَاتُ عَوَارٍ ، وَلاَ جَدَّائَ.","Da'if","Musannaf Ibn Abi Shaybah 10093","","","كتاب الزكاة"
"10094","(۱۰۰۹۴) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لَیْسَ لِلْمُصَدِّقِ ہَرِمَۃٌ ، وَلاَ ذَاتُ عَوَارٍ ، وَلاَ جَدَّائُ إِلاَّ أَنْ یَشَائَ الْمُصَدِّقُ.","Da'if","Musannaf Ibn Abi Shaybah 10094","","","كتاب الزكاة"
"10095","(۱۰۰۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، قَالَ : سَمِعْتُ سُلَیْمَانَ بْنَ یَسَارٍ ، قَالَ : لاَ یُجْزِء فِی الصَّدَقَۃِ ذَاتُ عَوَارٍ.","","Musannaf Ibn Abi Shaybah 10095","","","كتاب الزكاة"
"10096","(۱۰۰۹۶) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ مَیْمُونٍ ، قَالَ : لاَ یُؤْخَذُ فِی الصَّدَقَۃِ الْعَجْفَائُ ، وَلاَ الْعَوْرَائُ ، وَلاَ الْجَرْبَائُ ، وَلاَ الْعَرْجَائُ الَّتِی لاَ تَتْبَعُ الْغَنَمَ.","","Musannaf Ibn Abi Shaybah 10096","","","كتاب الزكاة"
"10097","(۱۰۰۹۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَمْرِو بْنِ یَحْیَی بن عُمَارَۃَ ، أَنَّ أَبَاہُ یَحْیَی بْنَ عُمَارَۃَ أَخْبَرَہُ ، أَنَّ أَبَا سَعِیدٍ کَانَ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ فِیمَا دُونَ خَمْسَۃِ أَوْسُقٍ صَدَقَۃٌ.","Sahih","Musannaf Ibn Abi Shaybah 10097","","","كتاب الزكاة"
"10098","(۱۰۰۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ، عَنْ یَحْیَی بْنِ عُمَارَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ فِی أَقَلَّ مِنْ خَمْسَۃِ أَوْسَاقٍ تَمْرٍ، وَلاَ حَبٍّ صَدَقَۃٌ. (مسلم ۶۷۴۔ احمد ۳/۹۷)","Sahih","Musannaf Ibn Abi Shaybah 10098","","","كتاب الزكاة"
"10099","(۱۰۰۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَمْرِو بْنِ یَحْیَی ، عَنْ أَبِیہِ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ فِیمَا دُونَ خَمْسَۃِ أَوْسَاقٍ صَدَقَۃٌ.","Sahih","Musannaf Ibn Abi Shaybah 10099","","","كتاب الزكاة"
"10100","(۱۰۱۰۰) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ (ح) وَعَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : لَیْسَ فِیمَا دُونَ خَمْسَۃِ أَوْسَاقٍ صَدَقَۃٌ. (عبدالرزاق ۷۲۵۱۔ احمد ۳/۲۹۶)","","Musannaf Ibn Abi Shaybah 10100","","","كتاب الزكاة"
"10101","(۱۰۱۰۱) حَدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا بَلَغَ الطَّعَامُ خَمْسَۃَ أَوْسُقٍ فَفِیہِ الصَّدَقَۃُ.","","Musannaf Ibn Abi Shaybah 10101","","","كتاب الزكاة"
"10102","(۱۰۱۰۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَیْسَ فِیمَا دُونَ خَمْسَۃِ أَوْسَاقٍ صَدَقَۃٌ.","","Musannaf Ibn Abi Shaybah 10102","","","كتاب الزكاة"
"10103","(۱۰۱۰۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالاَ : لاَ تَجِبُ الصَّدَقَۃُ حَتَّی تَبْلُغَ ثَلاَثَ مِئَۃِ صَاعٍ.","","Musannaf Ibn Abi Shaybah 10103","","","كتاب الزكاة"
"10104","(۱۰۱۰۴) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لَیْسَ فِی أَقَلَّ مِنْ خَمْسَۃِ أَوْسُقٍ شَیْئٌ.","Da'if","Musannaf Ibn Abi Shaybah 10104","","","كتاب الزكاة"
"10105","(۱۰۱۰۵) حَدَّثَنَا شَرِیکٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی الْبَخْتَرِیِّ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : الْوَسْقُ سِتُّونَ صَاعًا.","Da'if","Musannaf Ibn Abi Shaybah 10105","","","كتاب الزكاة"
"10106","(۱۰۱۰۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ (ح) وَمُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالاَ : الْوَسْقُ سِتُّونَ صَاعًا.","","Musannaf Ibn Abi Shaybah 10106","","","كتاب الزكاة"
"10107","(۱۰۱۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : الْوَسْقُ سِتُّونَ صَاعًا.","Da'if","Musannaf Ibn Abi Shaybah 10107","","","كتاب الزكاة"
"10108","(۱۰۱۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : الْوَسْقُ سِتُّونَ صَاعًا.","","Musannaf Ibn Abi Shaybah 10108","","","كتاب الزكاة"
"10109","(۱۰۱۰۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَسَنِ (ح) وَمُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قاَلَ : الْوَسْقُ سِتُّونَ صَاعًا.","","Musannaf Ibn Abi Shaybah 10109","","","كتاب الزكاة"
"10110","(۱۰۱۱۰) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ قَالاَ : الْوَسْقُ سِتُّونَ صَاعًا.","","Musannaf Ibn Abi Shaybah 10110","","","كتاب الزكاة"
"10111","(۱۰۱۱۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَر ، عَنْ أَشْعَثَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ (ح) وَعَنْ أَبِی الزُّبَیْرِ، عَنْ جَابِرٍ ، قَالاَ: الْوَسْقُ سِتُّونَ صَاعًا.","","Musannaf Ibn Abi Shaybah 10111","","","كتاب الزكاة"
"10112","(۱۰۱۱۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : الْوَسْقُ سِتُّونَ صَاعًا.","","Musannaf Ibn Abi Shaybah 10112","","","كتاب الزكاة"
"10113","(۱۰۱۱۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : الْوَسْقُ سِتُّونَ صَاعًا.","","Musannaf Ibn Abi Shaybah 10113","","","كتاب الزكاة"
"10114","(۱۰۱۱۴) حَدَّثَنَا رَوَّادُ بْنُ جَرَّاحٍ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ ، قَالَ : الْوَسْقُ سِتُّونَ صَاعًا.","","Musannaf Ibn Abi Shaybah 10114","","","كتاب الزكاة"
"10115","(۱۰۱۱۵) حَدَّثَنَا بَعض أَصْحَابِنَا ، عَنِ ابْنِ الْمُبَارَکِ، عَنْ یَعْقُوبَ، عَنْ عَطَائٍ ، وَعَنْ قَتَادَۃ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، قَالَ: الْوَسْقُ سِتُّونَ صَاعًا.","","Musannaf Ibn Abi Shaybah 10115","","","كتاب الزكاة"
"10116","(۱۰۱۱۶) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْعُشْرُ فِی التَّمْرِ وَالزَّبِیبِ ، وَالْحِنْطَۃِ وَالشَّعِیرِ. (دارقطنی )","Da'if","Musannaf Ibn Abi Shaybah 10116","","","كتاب الزكاة"
"10117","(۱۰۱۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عَمْرِو بْنِ عُثْمَانَ ، عَنْ مُوسَی بْنِ طَلْحَۃَ ؛ أَنَّ مُعَاذًا لَمَّا قَدِمَ الْیَمَنَ لَمْ یَأْخُذِ الزَّکَاۃَ إِلاَّ مِنَ الْحِنْطَۃِ ، وَالشَّعِیرِ ، وَالتَّمْرِ ، وَالزَّبِیبِ. (احمد ۵/۲۲۸۔ دارقطنی ۸)","","Musannaf Ibn Abi Shaybah 10117","","","كتاب الزكاة"
"10118","(۱۰۱۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ بْنِ یَحْیَی ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِی مُوسَی الأَشْعَرِیِّ ؛ أَنَّہُ لَمْ یَأْخُذْہَا إِلاَّ مِنَ الْحِنْطَۃِ ، وَالشَّعِیرِ ، وَالتَّمْرِ ، وَالزَّبِیبِ.","Hasan","Musannaf Ibn Abi Shaybah 10118","","","كتاب الزكاة"
"10119","(۱۰۱۱۹) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : الصَّدَقَۃُ مِنْ أَرْبَعٍ : مِنَ الْبُرِّ ، فَإِنْ لَمْ یَکُنْ بُرٌّ فَتَمْرٌ ، فَإِنْ لَمْ یَکُنْ تَمْرٌ فَزَبِیبٌ ، فَإِنْ لَمْ یَکُنْ زَبِیبٌ فَشَعِیرٌ.","Da'if","Musannaf Ibn Abi Shaybah 10119","","","كتاب الزكاة"
"10120","(۱۰۱۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ بْنِ یَحْیَی ، قَالَ : سَأَلَ عَبْدُ الْحَمِیدِ مُوسَی بْنَ طَلْحَۃَ عَنْہَا ؟ فَقَالَ : إنَّمَا الصَّدَقَۃُ فِی الْحِنْطَۃِ ، وَالشَّعِیرِ ، وَالتَّمْرِ ، وَالزَّبِیبِ.","","Musannaf Ibn Abi Shaybah 10120","","","كتاب الزكاة"
"10121","(۱۰۱۲۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ لِی عَطَائٌ : لاَ صَدَقَۃَ إِلاَّ فِی نَخْلٍ ، أَوْ عِنَبٍ، أَوْ حَبٍّ، وَقَالَ لِی ذَلِکَ عَمْرُو بْنُ دِینَارٍ.","","Musannaf Ibn Abi Shaybah 10121","","","كتاب الزكاة"
"10122","(۱۰۱۲۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : الزَّکَاۃُ فِی الْبُرِّ ، وَالشَّعِیرِ ، وَالتَّمْرِ ، وَالزَّبِیبِ.","","Musannaf Ibn Abi Shaybah 10122","","","كتاب الزكاة"
"10123","(۱۰۱۲۳) حَدَّثَنَا مُعَمَّرُ بْنُ سُلَیْمَانَ الرَّقِّیُّ ، عَنْ خُصَیْفٍ ، عَنْ مُجَاہِدٍ ، قَالَ : فِیمَا أَخْرَجَتِ الأَرْضُ فِیمَا قَلَّ مِنْہُ ، أَوْ کَثُرَ الْعُشْرُ ، أَوْ نِصْفُ الْعُشْرِ.","","Musannaf Ibn Abi Shaybah 10123","","","كتاب الزكاة"
"10124","(۱۰۱۲۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، قَالَ : فِی کُلِّ شَیْئٍ أَخْرَجَتِ الأَرْضُ الْعُشْرُ ، أَوْ نِصْفُ الْعُشْرِ.","","Musannaf Ibn Abi Shaybah 10124","","","كتاب الزكاة"
"10125","(۱۰۱۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : فِی کُلِّ شَیْئٍ أَخْرَجَتِ الأَرْضُ زَکَاۃٌ ، حَتَّی فِی عَشْرِ دَسْتَجَات ِدَسْتَجَۃ بَقْلٍ.","","Musannaf Ibn Abi Shaybah 10125","","","كتاب الزكاة"
"10126","(۱۰۱۲۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، أَنَّہُ کَانَ لاَ یُوَقِّتُ فِی الثَّمَرَۃِ شَیْئًا ، وَقَالَ : الْعُشْرُ وَنِصْفُ الْعُشْرِ.","","Musannaf Ibn Abi Shaybah 10126","","","كتاب الزكاة"
"10127","(۱۰۱۲۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ مُجَاہِدٍ ؛ مِثْلَہُ.","","Musannaf Ibn Abi Shaybah 10127","","","كتاب الزكاة"
"10128","(۱۰۱۲۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، قَالَ : کَتَبَ بِذَلِکَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ إلَی أَہْلِ الْیَمَنِ.","","Musannaf Ibn Abi Shaybah 10128","","","كتاب الزكاة"
"10129","(۱۰۱۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : فِی کُلِّ شَیْئٍ أَخْرَجَتِ الأَرْضُ زَکَاۃٌ.","","Musannaf Ibn Abi Shaybah 10129","","","كتاب الزكاة"
"10130","(۱۰۱۳۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : فِی الْخَضِرَاوَاتِ زَکَاۃٌ.","Da'if","Musannaf Ibn Abi Shaybah 10130","","","كتاب الزكاة"
"10131","(۱۰۱۳۱) حَدَّثَنَا وَکِیعٌ، عَنْ قَیْسٍ، عَنْ أَبِی إِسْحَاقَ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ، عَنْ عَلِیٍّ، قَالَ: لَیْسَ فِی الْخَضِرِ شَیْئٌ.","Da'if","Musannaf Ibn Abi Shaybah 10131","","","كتاب الزكاة"
"10132","(۱۰۱۳۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنْ مُجَالِدٍ، عَنِ الشَّعْبِیِّ، قَالَ: لَیْسَ فِی الْبُقُولِ؛ الْخِیَارِ، وَالْقِثَّائِ، وَنَحْوِہِ صَدَقَۃٌ.","","Musannaf Ibn Abi Shaybah 10132","","","كتاب الزكاة"
"10133","(۱۰۱۳۳) حَدَّثَنَا حَفْصٌ ، عَنِ الأَجْلَحِ ، عَنْ عَامِرٍ ، قَالَ : لَیْسَ فِی غَلَّۃِ الصَّیْفِ صَدَقَۃٌ.","","Musannaf Ibn Abi Shaybah 10133","","","كتاب الزكاة"
"10134","(۱۰۱۳۴) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : لَیْسَ فِی الْخَضِرِ زَکَاۃٌ ، إِلاَّ أَنْ یَصِیرَ مَالاً ، فَیَکُونَ فِیہِ زَکَاۃٌ.","","Musannaf Ibn Abi Shaybah 10134","","","كتاب الزكاة"
"10135","(۱۰۱۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، قَالَ : سَمِعْتُ مُجَاہِدًا ، وَإِبْرَاہِیمَ جَالِسٌ یَقُولُ : لَیْسَ فِی الْبُقُولِ ، وَلاَ فِی التُّفَّاحِ ، وَلاَ فِی الْخَضِرِ زَکَاۃٌ.","","Musannaf Ibn Abi Shaybah 10135","","","كتاب الزكاة"
"10136","(۱۰۱۳۶) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : لَیْسَ فِی الْخَضِرَاوَاتِ صَدَقَۃٌ.","","Musannaf Ibn Abi Shaybah 10136","","","كتاب الزكاة"
"10137","(۱۰۱۳۷) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حُصَیْنٍ ، عَنْ مُطَرِّفٍ ، قَالَ : سَأَلْتُ الْحَکَمَ عَنِ الْفَصَافِصِ ، وَالأَقْطَانِ ، وَالسَّمَاسِمِ ؟ فَقَالَ : لَیْسَ فِیہَا شَیْئٌ . قَالَ الْحَکَمُ : فِیمَا حَفِظْنَا عَنْ أَصْحَابِنَا أَنَّہُمْ کَانُوا یَقُولُونَ : لَیْسَ فِی شَیْئٍ مِنْ ہَذَا شَیْئٌ ، إِلاَّ فِی الْحِنْطَۃِ ، وَالشَّعِیرِ ، وَالتَّمْرِ ، وَالزَّبِیبِ.","","Musannaf Ibn Abi Shaybah 10137","","","كتاب الزكاة"
"10138","(۱۰۱۳۸) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَطَائٍ الْخُرَاسَانِیِّ ، قَالَ : لَیْسَ فِی الْفَاکِہَۃِ عُشُورٌ ؛الْجَوْزُ ، وَاللَّوْزُ ، وَالْبُقُولُ کُلُّہَا ، وَالْخَضِرُ ، وَلَکِنْ مَا بِیعَ مِنْہُ فَبَلَغَ مِئَتَیْ دِرْہَمٍ فَصَاعِدًا ، فَفِیہِ الزَّکَاۃُ.","","Musannaf Ibn Abi Shaybah 10138","","","كتاب الزكاة"
"10139","(۱۰۱۳۹) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ، عَنِ ابْنِ جُرَیْجٍ، قَالَ: قَالَ عَطَائٌ: لَیْسَ فِی الْبُقُولِ، وَالْقَصَبِ، وَالْخِرْبَزِ، وَالْقِثَّائِ، وَالْکُرْسُفِ ، وَالْفَوَاکِہِ ، وَالأُتْرُجِّ ، وَالتُّفَّاحِ ، وَالتِّینِ ، وَالرُّمَّانِ ، وَالْفَرْسَکِ ، وَالْفَاکِہَۃِ تُعَدُّ کُلُّہَا صَدَقَۃٌ.","","Musannaf Ibn Abi Shaybah 10139","","","كتاب الزكاة"
"10140","(۱۰۱۴۰) حَدَّثَنَا عَبْدُ الصَّمَدِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ الْحَکَمِ ، عَنْ أَبِی الْعَلاَئِ بْنِ الشِّخِّیرِ ، قَالَ : لَیْسَ فِی الأَعْلاَفِ ، وَلاَ فِی الْبُقُولِ صَدَقَۃٌ.","","Musannaf Ibn Abi Shaybah 10140","","","كتاب الزكاة"
"10141","(۱۰۱۴۱) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ فِی الزَّیْتُونِ ، قَالَ : ہُوَ یُکَالُ فِیہِ الْعُشْرُ.","","Musannaf Ibn Abi Shaybah 10141","","","كتاب الزكاة"
"10142","(۱۰۱۴۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ عِمْرَانَ الْقَطَّانِ، عَنْ لَیْثٍ، عَنْ طَاوُوسٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: فِی الزَّیْتُونِ الْعُشْرُ.","Da'if","Musannaf Ibn Abi Shaybah 10142","","","كتاب الزكاة"
"10143","(۱۰۱۴۳) حَدَّثَنَا زَیْدُ بْنُ حَبَّابٍ ، عَنْ رَجَائِ بْنِ أَبِی سَلَمَۃَ ، قَالَ : سَأَلْتُ یَزِیدَ بْنَ یَزِیدَ بْنِ جَابِرٍ عَنِ الزَّیْتُونِ ؟ فَقَالَ : عَشَّرَہُ عُمَرُ بْنُ الْخَطَّابِ بِالشَّامِ.","","Musannaf Ibn Abi Shaybah 10143","","","كتاب الزكاة"
"10144","(۱۰۱۴۴) حَدَّثَنَا زَیْدُ بْنُ حَبَّابٍ ، عَنْ رَجَائٍ ، عَنْ عَطَائٍ الْخُرَاسَانِیِّ ، قَالَ : فِیہِ الْعُشْرُ.","","Musannaf Ibn Abi Shaybah 10144","","","كتاب الزكاة"
"10145","(۱۰۱۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ عَبْدِ الْعَزِیزِ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، عَنْ أَبِی سَیَّارَۃَ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، إنَّ لِی نَحْلاً ، قَالَ : أَدِّیَنَّ الْعُشْرُ ؟ قُلْتُ : یَا رَسُولَ اللہِ ، احْمِہَا لِی ، قَالَ : فَحَمَاہَا لِی. (احمد ۲۳۶۔ ابن ماجہ ۱۸۲۳)","","Musannaf Ibn Abi Shaybah 10145","","","كتاب الزكاة"
"10146","(۱۰۱۴۶) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ؛ أَنَّ أَمِیرَ الطَّائِفِ کَتَبَ إلَی عُمَرَ بْنِ الْخَطَّابِ : إِنَّ أَہْلَ الْعَسَلِ مَنَعُونَا مَا کَانُوا یُعْطُونَ مَنْ کَانَ قَبْلَنَا ، قَالَ : فَکَتَبَ إلَیْہِ إِنْ أَعْطَوْک مَا کَانُوا یُعْطُونَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَاحْمِ لَہُمْ ، وَإِلاَّ فَلاَ تَحْمِہَا لَہُمْ ، قَالَ : وَزَعَمَ عَمْرُو بْنُ شُعَیْبٍ أَنَّہُمْ کَانُوا یُعْطُونَ مِنْ کُلِّ عَشْرِ قِرَبٍ قِرْبَۃً. (ابوداؤد ۱۵۹۷)","","Musannaf Ibn Abi Shaybah 10146","","","كتاب الزكاة"
"10147","(۱۰۱۴۷) حَدَّثَنَا ابْنُ الْمُبَارَکِ ، عَنْ عَطَائٍ الْخُرَاسَانِیِّ ، عَنْ عُمَرَ ، قَالَ : فِی الْعَسَلِ عُشْرٌ.","","Musannaf Ibn Abi Shaybah 10147","","","كتاب الزكاة"
"10148","(۱۰۱۴۸) حَدَّثَنَا صَفْوَانُ بْنُ عِیسَی ، عَنِ الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ مُنِیرِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ ، عَنْ سَعْدِ بْنِ أَبِی ذُبَابٍ ؛ أَنَّہُ قَدِمَ عَلَی قَوْمِہِ فَقَالَ لَہُم : فِی الْعَسَلِ زَکَاۃٌ ، فَإِنَّہُ لاَ خَیْرَ فِی مَالٍ لاَ یُزَکَّی ، قَالَ : قَالُوا : فَکَمْ تَرَی ؟ قُلْتُ : الْعُشْرُ ، قَالَ : فَأَخَذَ مِنْہُمَ الْعُشْرَ ، فَقَدِمَ بِہِ عَلَی عُمَرَ وَأَخْبَرَہُ بِمَا فِیہِ ، قَالَ : فَأَخَذَہُ عُمَرُ وَجَعَلَہُ فِی صَدَقَاتِ الْمُسْلِمِینَ.","Da'if","Musannaf Ibn Abi Shaybah 10148","","","كتاب الزكاة"
"10149","(۱۰۱۴۹) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : فِی الْعَسَلِ الْعُشْرُ.","","Musannaf Ibn Abi Shaybah 10149","","","كتاب الزكاة"
"10150","(۱۰۱۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ طَاوُوسٍ ؛ أَنَّ مُعَاذًا لَمَّا أَتَی الْیَمَنَ أُتَیَ بِالْعَسَلِ وَأَوْقَاصِ الْغَنَمِ ، فَقَالَ : لَمْ أُومَر فِیہَا بِشَیْئٍ. (عبدالرزاق ۶۹۶۴۔ بیہقی ۱۲۸)","","Musannaf Ibn Abi Shaybah 10150","","","كتاب الزكاة"
"10151","(۱۰۱۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، قَالَ : بَعَثَنِی عُمَرُ بْنُ عَبْدِ الْعَزِیزِ عَلَی الْیَمَنِ ، فَأَرَدْت أَنْ آخُذَ مِنَ الْعَسَلِ الْعُشْرَ ، قَالَ مُغِیرَۃُ بْنُ حَکِیمٍ الصَّنْعَانِیُّ : لَیْسَ فِیہِ شَیْئٌ ، فَکَتَبْتُ إلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، فَقَالَ : صَدَقَ ، وَہُوَ عَدْلٌ رضا.","","Musannaf Ibn Abi Shaybah 10151","","","كتاب الزكاة"
"10152","(۱۰۱۵۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، قَالَ : سَأَلَنِی عُمَرُ بْنُ عَبْدِ الْعَزِیزِ عَنْ صَدَقَۃِ الْعَسَلِ ؟ فَقُلْتُ : أَخْبَرَنِی الْمُغِیرَۃُ بْنُ حَکِیمٍ ، أَنَّہُ لَیْسَ فِیہِ صَدَقَۃٌ ، فَقَالَ عُمَرُ : عَدْلٌ مُصَدَّقٌ.","","Musannaf Ibn Abi Shaybah 10152","","","كتاب الزكاة"
"10153","(۱۰۱۵۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أُذَیْنَۃَ ، سَمِعَ ابْنَ عَبَّاسٍ ، قَالَ : لَیْسَ الْعَنْبَرُ بِرِکَازٍ ، وَإِنَّمَا ہُوَ شَیْئٌ دَسَرَہُ الْبَحْرُ ، لَیْسَ فِیہِ شَیْئٌ.","Sahih","Musannaf Ibn Abi Shaybah 10153","","","كتاب الزكاة"
"10154","(۱۰۱۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ الثَّوْرِیِّ ، عَنْ عَمْرٍو ، عَنْ أُذَیْنَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَیْسَ فِی الْعَنْبَرِ زَکَاۃٌ ، إنَّمَا ہُوَ شَیْئٌ دَسَرَہُ الْبَحْرُ.","Sahih","Musannaf Ibn Abi Shaybah 10154","","","كتاب الزكاة"
"10155","(۱۰۱۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ إسْمَاعِیلَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : لَیْسَ فِی الَعَنَبَرِ زَکَاۃٌ ، إنَّمَا ہُوَ غَنِیمَۃٌ لِمَنْ أَخَذَہُ.","Da'if","Musannaf Ibn Abi Shaybah 10155","","","كتاب الزكاة"
"10156","(۱۰۱۵۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مَعْمَرٍ ؛ أَنَّ عُرْوَۃَ بْنَ مُحَمَّدٍ کَتَبَ إلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، فِی عَنْبَرَۃٍ فِیہَا سَبْعُمِئَۃِ رِطْلٍ ، قَالَ : فِیہَا الْخُمُسُ.","","Musannaf Ibn Abi Shaybah 10156","","","كتاب الزكاة"
"10157","(۱۰۱۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ خَمَّسَ الْعَنْبَرَ.","","Musannaf Ibn Abi Shaybah 10157","","","كتاب الزكاة"
"10158","(۱۰۱۵۸) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَقُولُ : فِی الْعَنْبَرِ الْخُمُسُ ، وَکَذَلِکَ کَانَ یَقُولُ فِی اللُّؤْلُؤِ.","","Musannaf Ibn Abi Shaybah 10158","","","كتاب الزكاة"
"10159","(۱۰۱۵۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : سَأَلَ إبْرَاہِیمُ بْنُ سَعْدٍ ابْنَ عَبَّاسٍ عَنِ الْعَنْبَرِ ؟ فَقَالَ : إِنْ کَانَ فِیہِ شَیْئٌ ، فَفِیہِ الْخُمُسُ.","Sahih","Musannaf Ibn Abi Shaybah 10159","","","كتاب الزكاة"
"10160","(۱۰۱۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ الثَّوْرِیِّ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ؛ أَنَّ ابْنَ عَبَّاسٍ سُئِلَ عَنِ الْعَنْبَرِ ؟ فَقَالَ : إِنْ کَانَ فِیہِ شَیْئٌ ، فَفِیہِ الْخُمُسُ.","Sahih","Musannaf Ibn Abi Shaybah 10160","","","كتاب الزكاة"
"10161","(۱۰۱۶۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : کَانَ سُفْیَانُ یَقُولُ : لَیْسَ فِی الْعَنْبَرِ ، وَلاَ فِی الْعَسَلِ ، وَلاَ فِی الأَوْقَاصِ زَکَاۃٌ.","","Musannaf Ibn Abi Shaybah 10161","","","كتاب الزكاة"
"10162","(۱۰۱۶۲) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَنْ خُصَیْفٍ، عَنْ عِکْرِمَۃَ ، قَالَ: لَیْسَ فِی حَجَرِ اللُّؤْلُؤِ ، وَلاَ حَجَرِ الزُّمُرُّدِ زَکَاۃٌ، إِلاَّ أَنْ یَکُونَا لِتِجَارَۃٍ ، فَإِنْ کَانَا لِتِجَارَۃٍ فَفِیہِمَا زَکَاۃٌ.","","Musannaf Ibn Abi Shaybah 10162","","","كتاب الزكاة"
"10163","(۱۰۱۶۳) حَدَّثَنَا شَرِیکٌ، عَنْ سَالِمٍ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ، قَالَ: لَیْسَ فِی الْخَرَزِ وَاللُّؤْلُؤِ زَکَاۃٌ، إِلاَّ أَنْ یَکُونَا لِتِجَارَۃٍ.","","Musannaf Ibn Abi Shaybah 10163","","","كتاب الزكاة"
"10164","(۱۰۱۶۴) حَدَّثَنَا شَرِیکٌ ، عَنْ خُصَیْفٍ ، عَنْ عِکْرِمَۃَ ؛ مِثْلَہُ.","","Musannaf Ibn Abi Shaybah 10164","","","كتاب الزكاة"
"10165","(۱۰۱۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لَیْسَ فِی الْخَرَزِ وَاللُّؤْلُؤِ زَکَاۃٌ ، إِلاَّ أَنْ یَکُونَ لِتِجَارَۃٍ.","","Musannaf Ibn Abi Shaybah 10165","","","كتاب الزكاة"
"10166","(۱۰۱۶۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، وَالزُّہْرِیِّ ، وَمَکْحُولٍ ، قَالُوا : لَیْسَ فِی الْجَوْہَرِ شَیْئٌ ، إِلاَّ أَنْ یَکُونَ لِتِجَارَۃٍ.","","Musannaf Ibn Abi Shaybah 10166","","","كتاب الزكاة"
"10167","(۱۰۱۶۷) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ؛ أَنَّہُ کَانَ لاَ یَرَی فِی الْحُلِیِّ زَکَاۃً ، إِلاَّ فِی الذَّہَبِ وَالْفِضَّۃِ ، وَلاَ یَرَاہُ فِی الْجَوْہَرِ ، وَاللُّؤْلُؤِ وَہَذَا النَّحْوِ.","","Musannaf Ibn Abi Shaybah 10167","","","كتاب الزكاة"
"10168","(۱۰۱۶۸) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ طَلْحَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کُلُّ شَیْئٍ أُرِیدَ بِہِ التِّجَارَۃُ فَفِیہِ الزَّکَاۃُ ، وَإِنْ کَانَ لَبَنٌ ، أَوْ طِینٌ . قَالَ : وَکَانَ الْحَکَمُ یَرَی ذَلِکَ.","","Musannaf Ibn Abi Shaybah 10168","","","كتاب الزكاة"
"10169","(۱۰۱۶۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، قَالَ : لَیْسَ فِی الْجَوْہَرِ زَکَاۃٌ ، إِلاَّ أَنْ یُشْتَرَی لِتِجَارَۃٍ.","","Musannaf Ibn Abi Shaybah 10169","","","كتاب الزكاة"
"10170","(۱۰۱۷۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْر ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ لِی عَطَائٌ : لاَ صَدَقَۃَ فِی لُؤْلُؤٍ ، وَلاَ زَبَرْجَدٍ ، وَلاَ یَاقُوتٍ ، وَلاَ فُصُوصٍ ، وَلاَ عَرْضٍ ، وَلاَ شَیْئٍ لاَ یُدَارُ ، وَإِنْ کَانَ شَیْئٌ مِنْ ذَلِکَ یُدَارُ فَفِیہِ الصَّدَقَۃُ ، فِی ثَمَنِہِ حِینَ یُبَاعُ.","","Musannaf Ibn Abi Shaybah 10170","","","كتاب الزكاة"
"10171","(۱۰۱۷۱) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنْ أُسَامَۃَ ، قَالَ : سَأَلْتُ الْقَاسِمَ عَنِ اللُّؤْلُؤِ : ہَلْ فِیہِ زَکَاۃٌ ؟ فَقَالَ : مَا کَانَ مِنْہُ یُلْبَسُ کَالْحُلِیِّ لَیْسَ لِتِجَارَۃٍ ، فَلاَ زَکَاۃَ فِیہِ ، وَمَا کَانَ مِنْ ذَلِکَ لِلتِّجَارَۃِ فَفِیہِ الزَّکَاۃُ.","","Musannaf Ibn Abi Shaybah 10171","","","كتاب الزكاة"
"10172","(۱۰۱۷۲) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ أَبِی الْمَلِیحِ ، فِی حَدِیثٍ ذَکَرَہُ ؛ کَأَنَّہُ یَرَی فِیہِ الزَّکَاۃَ ، یَعْنِی اللُّؤْلُؤَ.","","Musannaf Ibn Abi Shaybah 10172","","","كتاب الزكاة"
"10173","(۱۰۱۷۳) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ، عَنْ أَبِیہِ، عَنْ جَدِّہِ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَا سُقِیَ سَیْحًا فَفِیہِ الْعُشْرُ ، وَمَا سُقِیَ بِالْغُرْبِ فَفِیہِ نِصْفُ الْعُشْرِ. (دارقطنی ۷)","Da'if","Musannaf Ibn Abi Shaybah 10173","","","كتاب الزكاة"
"10174","(۱۰۱۷۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الأَجْلَحِ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَتَبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی الْیَمَنِ : یُؤْخَذُ مِمَّا سَقَتِ السَّمَائُ ، وَسُقِیَ بِالْغَیْلِ مِنَ الْحِنْطَۃِ ، وَالشَّعِیرِ ، وَالتَّمْرِ ، وَالزَّبِیبِ الْعُشْرُ ، وَمَا سُقِیَ بِالسَّوَانِی نِصْفُ الْعُشْرِ.","Da'if","Musannaf Ibn Abi Shaybah 10174","","","كتاب الزكاة"
"10175","(۱۰۱۷۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ ، قَالَ : کَتَبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی مُعَاذٍ بِالْیَمَنِ ، إِنَّ فِیمَا سَقَتِ السَّمَائُ ، أَوْ سُقِیَ غَیْلاً الْعُشْرَ ، وَفِیمَا سُقِیَ بِالْغُرْبِ وَالدَّالِیَۃِ نِصْفَ الْعُشْرِ.","","Musannaf Ibn Abi Shaybah 10175","","","كتاب الزكاة"
"10176","(۱۰۱۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَمَّامٍ ، عَنْ قَتَادَۃَ ، عَنْ صَالِحٍ أَبِی الْخَلِیلِ ، قَالَ : سَنَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِیمَا سَقَت السَّمَائُ ، أَوِ الْعَیْنُ السَّائِحَۃُ وَمَائُ الْغَیْلِ ، أَوْ کَانَ بَعْلاً الْعُشْرُ کَامِلاً ، وَمَا سُقِیَ بِالرِّشَائِ فَنِصْفُ الْعُشْرِ.","","Musannaf Ibn Abi Shaybah 10176","","","كتاب الزكاة"
"10177","(۱۰۱۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : فِیمَا سقَت السَّمَائُ ، أَوْ کَانَ سَیْحًا الْعُشْرُ ، وَمَا سُقِیَ بِالدَّالِیَۃِ فَنِصْفُ الْعُشْرِ.","Hasan","Musannaf Ibn Abi Shaybah 10177","","","كتاب الزكاة"
"10178","(۱۰۱۷۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، قَالَ : سَنَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِیمَا سَقَت السَّمَائُ ، أَوْ سَقَی الْغَیْلُ ، وَکَانَ بَعْلاً الْعُشْرُ کَامِلاً ، وَمَا سُقِیَ بِالرِّشَائِ فَنِصْفُ الْعُشْرِ . قَالَ : وَقَالَ قَتَادَۃُ : وَکَانَ یُقَالُ : فِیمَا یُکَالُ مِنَ الثَّمَرَۃِ الْعُشْرُ ، وَنِصْفُ الْعُشْرِ. (مسلم ۱۵۷۱)","","Musannaf Ibn Abi Shaybah 10178","","","كتاب الزكاة"
"10179","(۱۰۱۷۹) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی مُوسَی بْنُ عُقْبَۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَقُولُ : صَدَقَۃُ الثمَّارِ ، وَالزَّرْعِ ، وَمَا کَانَ مِنْ نَخْلٍ ، أَوْ زَرْعٍ مِنْ حِنْطَۃٍ ، أَوْ شَعِیرٍ ، أَوْ سُلْتٍ مِمَّا کَانَ بَعْلاً، أَوْ یُسْقَی بِنَہَرٍ ، أَوْ یُسْقَی بِالْعَیْنِ ، أَوْ عَثَرِیًّا یُسْقَی بِالْمَطَرِ فَفِیہِ الْعُشْرُ ، مِنْ کُلِّ عَشَرَۃٍ وَاحِدٌ ، وَمَا کَانَ مِنْہُ یُسْقَی بِالنَّضْحِ فَفِیہِ نِصْفُ الْعُشْرِ ، فِی کُلِّ عِشْرِینَ وَاحِدٌ ، وَکَتَبَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی أَہْلِ الْیَمَنِ، إلَی الْحَارِثِ بْنِ عَبْدِ کُلاَلٍ ، وَمَنْ مَعَہُ مِنْ أَہْلِ الْیَمَنِ مِنْ مَعَافِرَ وَہَمْدَانَ : أَنَّ عَلَی الْمُؤْمِنِینَ مِنْ صَدَقَۃِ أَمْوَالِہِمْ عُشُورَ ، مَا سَقَتِ الْعَیْنُ ، وَسَقَتِ السَّمَائُ الْعُشْرُ ، وَعَلَی مَا یُسْقَی بِالْغُرْبِ نِصْفُ الْعُشْرِ. (دارقطنی ۱۳۰۔ بیہقی ۱۳۰)","Sahih","Musannaf Ibn Abi Shaybah 10179","","","كتاب الزكاة"
"10180","(۱۰۱۸۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : فِیمَا یُسْقَی بِالْکَظَائِمِ مِنْ نَخْلٍ ، أَوْ عِنَبٍ ، أَوْ حَبٍّ ، قَالَ : الْعُشْرُ.","","Musannaf Ibn Abi Shaybah 10180","","","كتاب الزكاة"
"10181","(۱۰۱۸۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ، عَنِ ابْنِ جُرَیْجٍ، قَالَ: أَخْبَرَنِی أَبُو الزُّبَیْرِ، عَنْ جَابِرٍ، أَنَّہُ سَمِعَہُ یَقُولُ: فِیہَا الْعُشْرُ.","Hasan","Musannaf Ibn Abi Shaybah 10181","","","كتاب الزكاة"
"10182","(۱۰۱۸۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ قَالَ : قُلْتُ لِعَطَائٍ : فَکَمْ فِیمَا کَانَ بَعْلاً مِنْ نَخْلٍ ، أَوْ عَثری مِن حَبٍّ ، أَوْ حَرْثٍ ؟ قَالَ : الْعُشْرُ ، قَالَ : فَقُلْتُ : فَکَمْ فِیمَا یُسْقَی غَیْلاً مِنْ نَخْلٍ ، أَوْ عِنَبٍ ، أَوْ حَبٍّ ؟ قَالَ : الْعُشْرُ ، قُلْتُ : فِیمَا یُسْقَی بِالدَّلْوِ وَبِالْمَنَاضِحِ ؟ قَالَ : نِصْفُ الْعُشْرِ.","","Musannaf Ibn Abi Shaybah 10182","","","كتاب الزكاة"
"10183","(۱۰۱۸۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی أَبُو الزُّبَیْرِ ، قَالَ : أَخْبَرَنِی جَابِرُ بْنُ عَبْدِ اللہِ ؛ أَنَّہُ قَالَ : نِصْفُ الْعُشْرِ.","Hasan","Musannaf Ibn Abi Shaybah 10183","","","كتاب الزكاة"
"10184","(۱۰۱۸۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّہُ کَانَ لاَ یُوَقِّتُ فِی الثَّمَرَۃِ شَیْئًا ، وَیَقُولُ : الْعُشْرُ وَنِصْفُ الْعُشْرِ.","","Musannaf Ibn Abi Shaybah 10184","","","كتاب الزكاة"
"10185","(۱۰۱۸۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ مُجَاہِدٍ ؛ مِثْلَہُ.","","Musannaf Ibn Abi Shaybah 10185","","","كتاب الزكاة"
"10186","(۱۰۱۸۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، قَالَ : کَتَبَ بِذَلِکَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ إلَی أَہْلِ الْیَمَنِ.","","Musannaf Ibn Abi Shaybah 10186","","","كتاب الزكاة"
"10187","(۱۰۱۸۷) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : فِی الْبُرِّ ، وَالشَّعِیرِ ، وَالتَّمْرِ ، وَالْعِنَبِ ، إذَا کَانَ خَمْسَۃَ أَوْسَاقٍ ، وَذَلِکَ ثَلاَثُ مِئَۃِ صَاعٍ فَفِیہِ نِصْفُ الْعُشْرِ ، إذَا کَانَ یُسْقَی ، وَمَا سَقَت السَّمَائُ وَالْعَیْنُ فَفِیہِ الْعُشْرُ.","","Musannaf Ibn Abi Shaybah 10187","","","كتاب الزكاة"
"10188","(۱۰۱۸۸) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ لَیْثِ بْنِ سَعْدٍ ، عَنْ نَافِعٍ ؛ أَنَّ عَبْدَ اللہِ کَانَ یُفْتِی فِی صَدَقَۃِ الزَّرْعِ وَالثِّمَارِ، مَا کَانَ فِیہِمَا یَشْرَبُ بِالنَّہَرِ ، أَوْ بِالْعیون ، أَوْ عَثَرِیًّا ، أَوْ بَعْلٍ ، فَإِنَّ صَدَقَتَہُ الْعُشُورُ ، مِنْ کُلِّ عَشْرَۃٍ وَاحِدٌ، وَمَا کَانَ مِنْہَا یُسْقَی بِالأَنْضَاحِ ، فَإِنَّ صَدَقَتَہُ نِصْفُ الْعُشُورِ ، وَفِی کُلِّ عِشْرِینَ وَاحِدٌ.","Sahih","Musannaf Ibn Abi Shaybah 10188","","","كتاب الزكاة"
"10189","(۱۰۱۸۹) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی الزَّرْعِ یَکُونُ عَلَی السَّیْحِ الزَّمَانِ ، ثُمَّ یُسْقَی بِالْبِئْرِ، یَعْنِی بِالدَّالِیَۃِ ؟ قَالَ : یُصَدَّقُ عَلَی أَکْثَرِ ذَلِکَ أَنْ یُسْقَی بِہِ.","","Musannaf Ibn Abi Shaybah 10189","","","كتاب الزكاة"
"10190","(۱۰۱۹۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : إنَّمَا یَکُونُ عَلَی الْعَیْنِ عَامَّۃَ الزَّمَانِ ، ثُمَّ یَحْتَاجُ إلَی الْبِئْرِ فِی الْقِطعَۃِ یُسْقَی بِہَا ، ثُمَّ الْقِطْعَۃِ ، ثُمَّ یَصِیرُ إلَی الْعَیْنِ ، کَیْفَ صَدَقَتُہُ ؟ قَالَ : الْعُشْرُ ، قَالَ : یَکُونُ ذَلِکَ عَلَی أَکْثَرِ ذَلِکَ أَنْ یُسْقَی بِہِ ، إِنْ کَانَ یُسْقَی بِالْعَیْنِ أَکْثَرَ مِمَّا یُسْقَی بِالدَّلْوِ ، فَفِیہِ الْعُشْرُ، وَإِنْ کَانَ یُسْقَی بِالدَّلْوِ ، أَکْثَرَ مِمَّا یُسْقَی بِالنَّجْلِ ، فَفِیہِ نِصْفُ الْعُشْرِ ، قُلْتُ : ہُوَ بِمَنْزِلَۃِ ذَلِکَ أَیْضًا الْمَالُ یَکُونُ بَعْلاً ، أَوْ عَثَرِیًّا عَامَّۃَ الزَّمَانِ ، ثُمَّ یَحْتَاجُ إلَی الْبِئْرِ ؟ قَالَ : نَعَمْ . قَالَ أَبُو الزُّبَیْرِ : وَسَمِعْت ابْنَ عُمَیرَ یَقُولُ ہَذَا الْقَوْلَ ، ثُمَّ سَأَلْتُ سَالِمَ بْنَ عَبْدِ اللہِ ؟ فَقَالَ : مِثْلَ قَوْلِ عُبَیدِِ.","","Musannaf Ibn Abi Shaybah 10190","","","كتاب الزكاة"
"10191","(۱۰۱۹۱) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ حَبِیبٍ الْمُعَلِّمِ ، قَالَ : کَانَ عَطَائٌ یَقُولُ : فِی الزَّرْعِ إذَا أَعْطَی صَاحِبُہُ أَجْرَ الْحَصَّادِینَ ، وَالَّذِینَ یَذُرُّونَ ، ہَلْ عَلَیْہِ فِیمَا أَعْطَاہُمْ صَدَقَۃٌ ؟ قَالَ : لاَ ، إنَّمَا الصَّدَقَۃُ فِیمَا حَصَلَ فِی یَدِک.","","Musannaf Ibn Abi Shaybah 10191","","","كتاب الزكاة"
"10192","(۱۰۱۹۲) حَدَّثَنَا وَکِیعٌ، عَنْ أَبِی عَوَانَۃَ، عَنْ أَبِی بِشْرٍ، عَنْ عَمْرِو بْنِ ہَرِمٍ، عَنْ جَابِرِ بْنِ زَیْدٍ، عَنِ ابْنِ عُمَرَ، وَابْنِ عَبَّاسٍ ؛ فِی الرَّجُلِ یُنْفِقُ عَلَی ثَمَرَتِہِ ؟ فَقَالَ أَحَدُہُمَا : یُزَکِّیہَا ، وَقَالَ الآخَرُ : یَرْفَعُ النَّفَقَۃَ ، وَیُزَکِّی مَا بَقِیَ.","Sahih","Musannaf Ibn Abi Shaybah 10192","","","كتاب الزكاة"
"10193","(۱۰۱۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : اِرْفَعِ الْبذْرَ ، وَالنَّفَقَۃَ ، وَزَکِّ مَا بَقِیَ.","","Musannaf Ibn Abi Shaybah 10193","","","كتاب الزكاة"
"10194","(۱۰۱۹۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعَثَ سَاعِیًا عَلَی الصَّدَقَۃِ فَأَتَی الْعَبَّاسَ یَسْتَسْلِفہُ ، فَقَالَ لَہُ الْعَبَّاسُ : إنِّی أَسْلَفْتُ صَدَقَۃَ مَالِی إِلَی سَنَتَیْنِ ، فَأَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَأَخْبَرَہُ فَقَالَ : صَدَقَ عَمِّی. (ترمذی ۶۷۸۔ ابوداؤد ۱۶۲۱)","","Musannaf Ibn Abi Shaybah 10194","","","كتاب الزكاة"
"10195","(۱۰۱۹۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ یُوسُفَ بْنِ عَبْدَۃَ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یُعَجِّلَہَا.","","Musannaf Ibn Abi Shaybah 10195","","","كتاب الزكاة"
"10196","(۱۰۱۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لاَ بَأْسَ بِتَعْجِیلِ الزَّکَاۃِ.","","Musannaf Ibn Abi Shaybah 10196","","","كتاب الزكاة"
"10197","(۱۰۱۹۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَوْ عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ تُعَجِّلَ زَکَاۃَ مَالِکَ ، وَتَحْتَسِبَ بِہَا فِیمَا یَسْتَقْبِلُ.","","Musannaf Ibn Abi Shaybah 10197","","","كتاب الزكاة"
"10198","(۱۰۱۹۸) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، عَنِ الْحَسَنِ، قَالَ: لاَ بَأْسَ بِتَعْجِیلِ الزَّکَاۃِ إذَا أَخْرَجہَا جَمِیعًا.","","Musannaf Ibn Abi Shaybah 10198","","","كتاب الزكاة"
"10199","(۱۰۱۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ حَفْصِ بْنِ سُلَیْمَانَ ، قَالَ : سَأَلْتُ الْحَسَنَ عَنْ رَجُلٍ أَخْرَجَ زَکَاۃَ ثَلاَثَ سِنِینَ ضَرْبَۃً ؟ قَالَ : یُجْزِیہِ.","","Musannaf Ibn Abi Shaybah 10199","","","كتاب الزكاة"
"10200","(۱۰۲۰۰) حَدَّثَنَا مُحَمَّدُ بْنُ زَیْدٍ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : لاَ بَأْسَ أَنْ یُعَجِّلَہَا قَبْلَ مَحِلِّہَا.","","Musannaf Ibn Abi Shaybah 10200","","","كتاب الزكاة"
"10201","(۱۰۲۰۱) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنِ الْحَسَنِ بْنِ صَالِحٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، قَالَ : لاَ بَأْسَ أَنْ یُعَجِّلَہَا.","Hasan","Musannaf Ibn Abi Shaybah 10201","","","كتاب الزكاة"
"10202","(۱۰۲۰۲) حَدَّثَنَا عُمَرُ بْنُ یُونُسَ ، عَنِ الزُّہْرِیِّ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُعَجِّلَ الرَّجُلُ زَکَاتَہُ قَبْلَ الْحِلِّ.","","Musannaf Ibn Abi Shaybah 10202","","","كتاب الزكاة"
"10203","(۱۰۲۰۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : مَا أَدْرِی مَا ہَذَا ، فِی تَعْجِیلِ الزَّکَاۃِ قَبْلَ الْحِلِّ بِشَہْرٍ ، أَوْ شَہْرَیْنِ ؟.","","Musannaf Ibn Abi Shaybah 10203","","","كتاب الزكاة"
"10204","(۱۰۲۰۴) حَدَّثَنَا ابْنُ الْمُبَارَک ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یُخْرِجُ لَہُ الطَّعَامَ مِنْ أَرْضِہِ فَیُزَکِّیہِ ، ثُمَّ یَمْکُثُ عِنْدَہُ السَّنَتَیْنِ وَالثَّلاَثَ فَلاَ یُزَکِّیہ ، وَہُوَ یُرِیدُ أَنْ یَبِیعَہُ.","","Musannaf Ibn Abi Shaybah 10204","","","كتاب الزكاة"
"10205","(۱۰۲۰۵) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ ابْنِ لَہِیعَۃَ ، قَالَ : حدَّثَنِی عَبْدُ اللہِ بْنُ أَبِی جَعْفَرٍ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ: إذَا أُخِذَ مِنَ الزَّرْعِ الْعُشْرُ ، فَلَیْسَ فِیہِ زَکَاۃٌ ، وَإنْ مَکَثَ عَشْرَ سِنِینَ.","","Musannaf Ibn Abi Shaybah 10205","","","كتاب الزكاة"
"10206","(۱۰۲۰۶) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا أَخْرَجَ صَدَقَۃَ الزَّرْعِ ، وَالتَّمْرِ ، وَکُلِّ شَیْئٍ أَنْبَتَتِ الأَرْضُ ، فَلَیْسَ فِیہِ زَکَاۃٌ حَتَّی یَحُولَ عَلَیْہِ الْحَوْلُ.","","Musannaf Ibn Abi Shaybah 10206","","","كتاب الزكاة"
"10207","(۱۰۲۰۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : طَعَامٌ أُمْسِکُہُ أُرِیدُ أَکْلَہُ ، فَیَحُولُ عَلَیْہِ الْحَوْلُ ، قَالَ : لَیْسَ عَلَیْک فِیہِ صَدَقَۃٌ ، لَعَمْرِی إنَّا لَنَفْعَلُ ذَلِکَ ، نَبْتَاعُ الطَّعَامَ ، وَمَا نُزَکِّیہِ ، فَإِنْ کُنْت تُرِیدُ بَیْعَہُ فَزَکِّہِ إذَا بِعْتَہُ.","","Musannaf Ibn Abi Shaybah 10207","","","كتاب الزكاة"
"10208","(۱۰۲۰۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ لِی عَبْدُ الْکَرِیمِ فِی الْحَرْثِ : إذَا أَعْطَیْت زَکَاتَہُ أَوَّلَ مَرَّۃٍ فَحَالَ عَلَیْہِ الْحَوْلُ عِنْدَکَ ، فَلاَ تُزَکِّہِ حَسْبُک الأُولَی.","","Musannaf Ibn Abi Shaybah 10208","","","كتاب الزكاة"
"10209","(۱۰۲۰۹) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی الْیَقْظَانِ ، عَنِ ابْنِ أَبِی لَیْلَی ؛ أَنَّ عَلِیًّا زَکَّی أمْوَالَ بَنِی أَبِی رَافِعٍ ، أَیْتَامٍ فِی حِجْرِہِ ، وَقَالَ : تُرَوْنَ کُنْتُ أَلِی مَالاً لاَ أُزَکِّیہِ ؟!.","Da'if","Musannaf Ibn Abi Shaybah 10209","","","كتاب الزكاة"
"10210","(۱۰۲۱۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، قَالَ : کُنَّا أَیْتَامًا فِی حِجْرِ عَائِشَۃَ ، فَکَانَتْ تُزَکِّی أَمْوَالَنَا وَنُبْضِعُہَا فِی الْبَحْرِ.","Sahih","Musannaf Ibn Abi Shaybah 10210","","","كتاب الزكاة"
"10211","(۱۰۲۱۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : فِی مَالِ الْیَتِیمِ زَکَاۃٌ.","Da'if","Musannaf Ibn Abi Shaybah 10211","","","كتاب الزكاة"
"10212","(۱۰۲۱۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُزَکِّی مَالَ الْیَتِیمِ.","Da'if","Musannaf Ibn Abi Shaybah 10212","","","كتاب الزكاة"
"10213","(۱۰۲۱۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، قَالَ : قَالَ عُمَرُ : ابْتَغُوْا لِلْیَتَامَی فِی أَمْوَالِہِمْ، لاَ تَسْتَغْرِقُہَا الزَّکَاۃُ.","","Musannaf Ibn Abi Shaybah 10213","","","كتاب الزكاة"
"10214","(۱۰۲۱۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی ، وَحَنْظَلَۃَ ، وَحُمَیْدٍ ، عَنِ الْقَاسِمِ ؛ أَنَّ عَائِشَۃَ کَانَتْ تُبْضِعُ أَمْوَالَہُمْ فِی الْبَحْرِ ، وَتُزَکِّیہَا.","Hasan","Musannaf Ibn Abi Shaybah 10214","","","كتاب الزكاة"
"10215","(۱۰۲۱۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ أَیُّوبَ، عَنْ عَمْرِو بْنِ دِینَارٍ، عَنْ مَکْحُولٍ، قَالَ: قَالَ عُمَرُ: ابْتَغُوا بِأَمْوَالِ الْیَتَامَی، لاَ تَسْتَغْرِقُہَا الصَّدَقَۃُ.","","Musannaf Ibn Abi Shaybah 10215","","","كتاب الزكاة"
"10216","(۱۰۲۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنٍ ، عَنِ أَبِی فَرْوَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : فِی مَالِ الْیَتِیمِ زَکَاۃٌ.","","Musannaf Ibn Abi Shaybah 10216","","","كتاب الزكاة"
"10217","(۱۰۲۱۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ فِی مَالِ الْیَتِیمِ : لَہُ حَقٌّ وَعَلَیْہِ حَقٌّ ، وَلاَ أَقُولُ إِلاَّ مَا قَالَ اللَّہُ تَعَالَی.","","Musannaf Ibn Abi Shaybah 10217","","","كتاب الزكاة"
"10218","(۱۰۲۱۸) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ، عَنِ الْحَسَنِ بْنِ یَزِیدَ، عَنْ طَاوُوسٍ، قَالَ: زَکِّ مَالَ الْیَتِیمِ، وَإِلاَّ فَہُوَ دَیْنٌ فِی عُنُقِکَ.","","Musannaf Ibn Abi Shaybah 10218","","","كتاب الزكاة"
"10219","(۱۰۲۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، قَالَ : دُعِی ابْنُ عُمَرَ إلَی مَالِ یَتِیمٍ ، فَقَالَ: إِنْ شِئْتُمْ وَلَّیْتُہُ عَلَی أَنْ أُزَکِّیَہُ حَوْلاً إلَی حَوْلٍ.","Da'if","Musannaf Ibn Abi Shaybah 10219","","","كتاب الزكاة"
"10220","(۱۰۲۲۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ رَأَی فِی مَالِ الْیَتِیمِ زَکَاۃً.","","Musannaf Ibn Abi Shaybah 10220","","","كتاب الزكاة"
"10221","(۱۰۲۲۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ مَسْعُودٍ ؛ أَنَّہُ کَانَ یَقُولُ : أَحْصِ مَا یَجِبُ فِی مَالِ الْیَتِیمِ مِنَ الزَّکَاۃِ ، فَإِذَا بَلَغَ وَأُونِسَ مِنْہُ رُشْدُہُ فَأَعْلِمْہُ ، فَإِنْ شَائَ زَکَّاہُ ، وَإِنْ شَائَ تَرَکَہُ.","Da'if","Musannaf Ibn Abi Shaybah 10221","","","كتاب الزكاة"
"10222","(۱۰۲۲۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَیْسَ فِی مَالِ الْیَتِیمِ زَکَاۃٌ حَتَّی یَحْتَلِمَ.","","Musannaf Ibn Abi Shaybah 10222","","","كتاب الزكاة"
"10223","(۱۰۲۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، مِثْلَہُ.","","Musannaf Ibn Abi Shaybah 10223","","","كتاب الزكاة"
"10224","(۱۰۲۲۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لَیْسَ فِی مَالِ الْیَتِیمِ زَکَاۃٌ حَتَّی یَحْتَلِمَ.","","Musannaf Ibn Abi Shaybah 10224","","","كتاب الزكاة"
"10225","(۱۰۲۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ عِنْدَہُ مَالٌ لِبَنِی أَخٍ لَہُ أَیْتَامٍ ، فَلاَ یُزَکِّیہ.","","Musannaf Ibn Abi Shaybah 10225","","","كتاب الزكاة"
"10226","(۱۰۲۲۶) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ شُرَیْحٍ ، فِی مَالِ الْیَتِیمِ قَالَ : أَوْشَکَ إِذَا أَخَذْتَ مِنْہُ الذَوْدَ وَالذَوْدَین لاَ یَبْقَی مِنْہُ شَیْء .","","Musannaf Ibn Abi Shaybah 10226","","","كتاب الزكاة"
"10227","(۱۰۲۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لَیْسَ فِی مَالِ الْیَتِیمِ زَکَاۃٌ.","","Musannaf Ibn Abi Shaybah 10227","","","كتاب الزكاة"
"10228","(۱۰۲۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ دِینَارٍ ، قَالَ : سَأَلْتُ الشَّعبیَِّ عَنْ مَالِ الْیَتِیمِ ، فِیہِ زَکَاۃٌ ؟ قَالَ : نَعَمْ ، وَلَوْ کَانَ عِنْدِی مَا زَکَّیْتُہُ.","","Musannaf Ibn Abi Shaybah 10228","","","كتاب الزكاة"
"10229","(۱۰۲۲۹) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنِ الْحَسَنِ بْنِ زَیْدٍ ، قَالَ : سَمِعْتُ مُجَاہِدًا یَقُولُ : أَحْصِہِ ، فَإِذَا عَلِمْت فَزَکِّہِ.","","Musannaf Ibn Abi Shaybah 10229","","","كتاب الزكاة"
"10230","(۱۰۲۳۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : یُؤْخَذُ مِنَ النَّخْلِ وَالْمَاشِیَۃِ ، فَأَمَّا الْمَالُ فَحَتَّی یَحْتَلِمَ . یَعْنِی مَالَ الْیَتِیمِ.","","Musannaf Ibn Abi Shaybah 10230","","","كتاب الزكاة"
"10231","(۱۰۲۳۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ؛ أَنَّ أَبَا وَائِلٍ قَالَ : کَانَ فِی حِجْرِی یَتِیمٌ لَہُ ثَمَانیَۃُ آلاَفٍ ، فَلَمْ أُزَکِّہَا حَتَّی لَمَّا بَلَغَ دَفَعْتہَا إلَیْہِ.","","Musannaf Ibn Abi Shaybah 10231","","","كتاب الزكاة"
"10232","(۱۰۲۳۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ السَّائِبِ ، قَالَ : کَانَ عِنْدَ ابْنِ عُمَرَ مَالُ یَتِیمٍ ، فَاسْتَسْلَفَ مَالَہُ حَتَّی لاَ یُؤَدِّیَ زَکَاتَہُ.","Da'if","Musannaf Ibn Abi Shaybah 10232","","","كتاب الزكاة"
"10233","(۱۰۲۳۳) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ، عَنْ خُثَیْمِ بْنِ عِرَاکٍ، قَالَ: سَمِعْتُ أَبِی یَقُولُ : سَمِعْت أَبَا ہُرَیْرَۃَ یَقُولُ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لاَ صَدَقَۃَ عَلَی الْمُسْلِمِ فِی عَبْدِہِ ، وَلاَ فَرَسِہِ.(بخاری ۱۴۶۴۔ مسلم ۶۷۶)","Sahih","Musannaf Ibn Abi Shaybah 10233","","","كتاب الزكاة"
"10234","(۱۰۲۳۴) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنْ عِرَاکِ بْنِ مَالِکٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، إِنَّہُ لَیْسَ عَلَی الْمُسْلِمِ فِی فَرَسِہِ ، وَلاَ عَبْدِہِ صَدَقَۃٌ. (بخاری ۱۴۶۳۔ ابوداؤد ۱۵۹۱)","Sahih","Musannaf Ibn Abi Shaybah 10234","","","كتاب الزكاة"
"10235","(۱۰۲۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ ، عَنْ مَکْحُولٍ ، عَنْ عِرَاکِ بْنِ مَالِکٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّہُ لَیْسَ عَلَی الْمُسْلِمِ فِی عَبْدِہِ ، وَلاَ فَرَسِہِ ، وَلاَ وَلِیدَتِہِ صَدَقَۃٌ. (دارقطنی ۸)","Sahih","Musannaf Ibn Abi Shaybah 10235","","","كتاب الزكاة"
"10236","(۱۰۲۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، وسُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنْ عِرَاکِ بْنِ مَالِکٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ عَلَی الْمُسْلِمِ فِی فَرَسِہِ ، وَلاَ عَبْدِہِ صَدَقَۃٌ. (ترمذی ۶۲۸۔ احمد ۲/۴۷۷)","","Musannaf Ibn Abi Shaybah 10236","","","كتاب الزكاة"
"10237","(۱۰۲۳۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، رَفَعَہُ ، قَالَ : قَدْ تَجَاوَزْتُ لَکُمْ عَنْ صَدَقَۃِ الْخَیْلِ وَالرَّقِیقِ. (ابن ماجہ ۱۸۱۳۔ ابویعلی ۲۹۴)","Da'if","Musannaf Ibn Abi Shaybah 10237","","","كتاب الزكاة"
"10238","(۱۰۲۳۸) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَمَّا الْخَیْلُ وَالرَّقِیقُ فَقَدْ عَفَوْتُ عَنْ صَدَقَاتِہَا. (احمد ۱/۱۲۱)","Da'if","Musannaf Ibn Abi Shaybah 10238","","","كتاب الزكاة"
"10239","(۱۰۲۳۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ أَبِی خَالِدٍ ، عَنْ شُبَیْلِ بْنِ عَوْفٍ ، قَالَ : وَقَدْ کَانَ أَدْرَکَ الْجَاہِلِیَّۃَ ، قَالَ : أَمَرَ عُمَرُ بْنُ الْخَطَّابِ النَّاسَ بِالصَّدَقَۃِ ، فَقَالَ النَّاسُ : یَا أَمِیرَ الْمُؤْمِنِینَ ، خَیْلٌ لَنَا وَرَقِیقٌ ، افْرِضْ عَلَیْنَا عَشَرَۃً عَشَرَۃً ، قَالَ : أَمَّا أَنَا فَلاَ أَفْرِضُ ذَلِکَ عَلَیْکُمْ.","Sahih","Musannaf Ibn Abi Shaybah 10239","","","كتاب الزكاة"
"10240","(۱۰۲۴۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عَبْدُ اللہِ بْنُ أَبِی حُسَیْنٍ ، أَنَّ ابْنَ شِہَابٍ أَخْبَرَہُ ؛ أَنَّ عُثْمَانَ کَانَ یُصَدِّقُ الْخَیْلَ ، وَأَنَّ السَّائِبَ ابْنَ أُخْتِ نَمِرٍ أَخْبَرَہُ ؛ أَنَّہُ کَانَ یَأْتِی عُمَرَ بِصَدَقَۃِ الْخَیْلِ.","","Musannaf Ibn Abi Shaybah 10240","","","كتاب الزكاة"
"10241","(۱۰۲۴۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: لَیْسَ عَلَی الْفَرَسِ الْغَازِی فِی سَبِیلِ اللہِ صَدَقَۃٌ.","Sahih","Musannaf Ibn Abi Shaybah 10241","","","كتاب الزكاة"
"10242","(۱۰۲۴۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، قَالَ : سُئِلَ ابْنُ الْمُسَیَّبِ : أَفِی الْبَرَاذِینِ صَدَقَۃٌ ؟ قَالَ : أَوَ فِی الْخَیْلِ صَدَقَۃٌ.","","Musannaf Ibn Abi Shaybah 10242","","","كتاب الزكاة"
"10243","(۱۰۲۴۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ عَنْ صَدَقَۃِ الْبَرَاذِینِ ؟ فَقَالَ لِی : أَوَ فِی الْخَیْلِ صَدَقَۃٌ ؟ أَوَ فِی الْخَیْلِ صَدَقَۃٌ ؟.","","Musannaf Ibn Abi Shaybah 10243","","","كتاب الزكاة"
"10244","(۱۰۲۴۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ نَافِعٍ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ، قَالَ : لَیْسَ فِی الْخَیْلِ صَدَقَۃٌ.","","Musannaf Ibn Abi Shaybah 10244","","","كتاب الزكاة"
"10245","(۱۰۲۴۵) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : لَیْسَ فِی الْخَیْلِ وَلاَ الرَّقِیقِ صَدَقَۃٌ.","","Musannaf Ibn Abi Shaybah 10245","","","كتاب الزكاة"
"10246","(۱۰۲۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکٍ ، عَنْ عَطَائٍ ، قَالَ : لَیْسَ فِی الْخَیْلِ السَّائِمَۃِ صَدَقَۃٌ.","","Musannaf Ibn Abi Shaybah 10246","","","كتاب الزكاة"
"10247","(۱۰۲۴۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الأَجْلَحِ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ عَنْ صَدَقَۃِ الْخَیْلِ وَالرَّقِیقِ ؟ فَقَالَ : لَیْسَ فِیہا زَکَاۃٌ.","","Musannaf Ibn Abi Shaybah 10247","","","كتاب الزكاة"
"10248","(۱۰۲۴۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ لاَ یَرَی فِی الرَّقِیقِ إذَا کَانُوا لِلتِّجَارَۃِ صَدَقَۃَ الْفِطْرَ ، وَلَکِنْ یُقَوِّمُہُمْ فَیُؤَدِّی عَنْہُمُ الزَّکَاۃَ.","","Musannaf Ibn Abi Shaybah 10248","","","كتاب الزكاة"
"10249","(۱۰۲۴۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ ذَلِکَ.","","Musannaf Ibn Abi Shaybah 10249","","","كتاب الزكاة"
"10250","(۱۰۲۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مُبَارَکٍ ، عَنِ الْحَسَنِ ، قَالَ : لَیْسَ فِی الْخَیْلِ وَالْبَرَاذِینِ وَالْحَمِیرِ صَدَقَۃٌ.","","Musannaf Ibn Abi Shaybah 10250","","","كتاب الزكاة"
"10251","(۱۰۲۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ؛ فِی الْعَبْدِ لِلتِّجَارَۃِ، قَالَ: لَیْسَ عَلَیْہِ زَکَاۃُ الْفِطْرُ.","","Musannaf Ibn Abi Shaybah 10251","","","كتاب الزكاة"
"10252","(۱۰۲۵۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَیْسَ عَلَی الْبَہِیمَۃِ ، وَلاَ عَلَی الْمَمْلُوکِ زَکَاۃٌ ، إِلاَّ أَنْ تَکُونَ لِلتِّجَارَۃِ.","","Musannaf Ibn Abi Shaybah 10252","","","كتاب الزكاة"
"10253","(۱۰۲۵۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : لَیْسَ فِی الْخَیْلِ صَدَقَۃٌ ۔ قَالَ : حَمَّادٌ فِیہَا۔","","Musannaf Ibn Abi Shaybah 10253","","","كتاب الزكاة"
"10254","(۱۰۲۵۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : سَأَلْتُہُ عَنِ الْحَمِیرِ ، فِیہَا زَکَاۃٌ أَمْ لاَ ؟ قَالَ : أَمَّا أَنَا فَأُشَبِّہُہَا بِالْبَقَرِ ، وَلاَ نَعْلَمُ فِیہَا شَیْئًا۔","","Musannaf Ibn Abi Shaybah 10254","","","كتاب الزكاة"
"10255","(۱۰۲۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مُبَارَکٍ ، عَنِ الْحَسَنِ ، قَالَ : لَیْسَ فِی الْحَمِیرِ صَدَقَۃٌ۔","","Musannaf Ibn Abi Shaybah 10255","","","كتاب الزكاة"
"10256","(۱۰۲۵۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ؛ أَنَّ امْرَأَتَیْنِ أَتَتَا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَفِی أَیْدِیہِمَا أَسْوِرَۃٌ مِنَ الذَّہَبِ ، فَقَالَ لَہُمَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَتُحِبَّانِ أَنْ یُسَوِّرَکُمَا رَبُّکُمَا بِأَسْوِرَۃٍ مِنْ نَارٍ ؟ قَالَتَا : لاَ ، قَالَ : فَأَدِّیَا حَقَّ ہَذَا فِی أَیْدِیکُمَا۔ (احمد ۲/۱۷۸۔ دارقطنی ۱۰۸)","","Musannaf Ibn Abi Shaybah 10256","","","كتاب الزكاة"
"10257","(۱۰۲۵۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، وَوَکِیعٌ ، عَنْ مُسَاوِرٍ الْوَرَّاقِ ، عَنْ شُعَیْبٍ ، قَالَ : کَتَبَ عُمَرُ إلَی أَبِی مُوسَی : أَنْ مُرْ مَنْ قِبَلَک مِنْ نِسَائِ الْمُسْلِمِینَ أَنْ یُصَدِّقْنَ حُلِیَّہنَّ ، وَلاَ یَجْعَلْنَ الْہَدِیَّۃَ وَالزِّیَادَۃَ تَقَارُضًا بَیْنَہُنَّ۔","","Musannaf Ibn Abi Shaybah 10257","","","كتاب الزكاة"
"10258","(۱۰۲۵۸) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، قَالَ : یُزَکَّی مَرَّۃً۔","Sahih","Musannaf Ibn Abi Shaybah 10258","","","كتاب الزكاة"
"10259","(۱۰۲۵۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ؛ أَنَّہُ کَانَ یَرَی فِی الْحُلِیِّ زَکَاۃً۔","","Musannaf Ibn Abi Shaybah 10259","","","كتاب الزكاة"
"10260","(۱۰۲۶۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : فِی الْحُلِیِّ زَکَاۃٌ۔","","Musannaf Ibn Abi Shaybah 10260","","","كتاب الزكاة"
"10261","(۱۰۲۶۱) حَدَّثَنَا شَرِیکٌ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ ، قَالَ : فِی الْحُلِیِّ زَکَاۃٌ۔","","Musannaf Ibn Abi Shaybah 10261","","","كتاب الزكاة"
"10262","(۱۰۲۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : فِی حُلِیِّ الذَّہَبِ وَالْفِضَّۃِ زَکَاۃٌ۔ قَالَ: وَہُوَ قَوْلُ سُفْیَانَ۔","","Musannaf Ibn Abi Shaybah 10262","","","كتاب الزكاة"
"10263","(۱۰۲۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرو ؛ أَنَّہُ کَانَ یَأْمُرُ نِسَائَہُ أَنْ یُزَکِّینَ حُلِیَّہُنَّ۔","","Musannaf Ibn Abi Shaybah 10263","","","كتاب الزكاة"
"10264","(۱۰۲۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکٍ ، عَنْ عَطَائٍ ، قَالَ : فِی الْحُلِیِّ زَکَاۃٌ۔","","Musannaf Ibn Abi Shaybah 10264","","","كتاب الزكاة"
"10265","(۱۰۲۶۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : فِی الْحُلِیِّ زَکَاۃٌ۔","","Musannaf Ibn Abi Shaybah 10265","","","كتاب الزكاة"
"10266","(۱۰۲۶۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ : ہَلْ فِی الْحُلِیِّ زَکَاۃٌ ؟ قَالَ : نَعَمْ ، إذَا کَانَ عِشْرِینَ مِثْقَالاً ، أَوْ مِئَتَیْ دِرْہَمٍ۔","","Musannaf Ibn Abi Shaybah 10266","","","كتاب الزكاة"
"10267","(۱۰۲۶۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، وَالزُّہْرِیِّ ، وَمَکْحُولٍ قَالُوا : فِی الْحُلِیِّ زَکَاۃٌ ۔ وَقَالُوا : مَضَتِ السُّنَّۃُ أَنَّ فِی الْحُلِیِّ ، الذَّہَبِ وَالْفِضَّۃِ ، زَکَاۃً۔","","Musannaf Ibn Abi Shaybah 10267","","","كتاب الزكاة"
"10268","(۱۰۲۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی جَعْفَرٍ الْفَرَّائِ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، قَالَ : فِی الْحُلِیِّ زَکَاۃٌ ، حَتَّی فِی الْخَاتَمِ۔","","Musannaf Ibn Abi Shaybah 10268","","","كتاب الزكاة"
"10269","(۱۰۲۶۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ جَعْفَرِ بْنِ مَیْمُونٍ ، قَالَ : کَانَ عِنْدَنَا طَوْقٌ قَدْ زَکَّیْنَاہُ ، حَتَّی أُرَاہُ قَدْ أَتَی عَلَی ثَمَنِہِ۔","","Musannaf Ibn Abi Shaybah 10269","","","كتاب الزكاة"
"10270","(۱۰۲۷۰) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ حُسَیْنٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا بَلَغَ الْحُلِیُّ مَا تَجِبُ فِیہِ الزَّکَاۃُ ، فَفِیہِ الزَّکَاۃُ۔","","Musannaf Ibn Abi Shaybah 10270","","","كتاب الزكاة"
"10271","(۱۰۲۷۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ لاَ یَرَی فِی الْحُلِیِّ زَکَاۃً۔","Sahih","Musannaf Ibn Abi Shaybah 10271","","","كتاب الزكاة"
"10272","(۱۰۲۷۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَبْدِ اللہِ بْنِ ذَکْوَانَ ، وَعَمْرِو بْنِ مُرَّۃَ ، عَنِ الْقَاسِمِ ، قَالَ : کَانَ مَالُنَا عِنْدَ عَائِشَۃَ ، فَکَانَتْ تُزَکِّیہ إِلاَّ الْحُلِیَّ۔","Sahih","Musannaf Ibn Abi Shaybah 10272","","","كتاب الزكاة"
"10273","(۱۰۲۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَ[corrupt]ِیہِ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَانَتْ لاَ تُزَکِّیہ۔","Sahih","Musannaf Ibn Abi Shaybah 10273","","","كتاب الزكاة"
"10274","(۱۰۲۷۴) حَدَّثَنَا وَکِیعٌ، عَنْ دَلْہَمِ بْنِ صَالِحٍ، عَنْ عَطَائٍ، عَنْ عَائِشَۃَ، قَالَ: کَانَ لِبَنَاتِ أَخِیہَا حُلِیٌّ، فَلَمْ تَکُنْ تُزَکِّیہ۔","Da'if","Musannaf Ibn Abi Shaybah 10274","","","كتاب الزكاة"
"10275","(۱۰۲۷۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : لاَ زَکَاۃَ فِی الْحُلِیِّ ، قُلْتُ : إِنَّہ یَکُونُ فِیہِ أَلْفُ دِینَارٍ ، قَالَ : یُعَارُ وَیُلْبَسُ۔","Sahih","Musannaf Ibn Abi Shaybah 10275","","","كتاب الزكاة"
"10276","(۱۰۲۷۶) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ فَاطِمَۃَ بِنْتِ الْمُنْذِرِ ، عَنْ أَسْمَائَ ؛ أَنَّہَا کَانَتْ لاَ تُزَکِّی الْحُلِیَّ۔","Sahih","Musannaf Ibn Abi Shaybah 10276","","","كتاب الزكاة"
"10277","(۱۰۲۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ فَاطِمَۃَ ، عَنْ أَسْمَائَ ؛ أَنَّہَا کَانَتْ تُحَلِّی بَنََاتہَا الذَّہَبَ ، وَلاَ تُزَکِّیہ۔","Sahih","Musannaf Ibn Abi Shaybah 10277","","","كتاب الزكاة"
"10278","(۱۰۲۷۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : سَأَلْتُ عَمْرَۃَ عَنْ زَکَاۃِ الْحُلِیِّ ؟ فَقَالَتْ : مَا رَأَیْت أَحَدًا یُزَکِّیِہِ۔","","Musannaf Ibn Abi Shaybah 10278","","","كتاب الزكاة"
"10279","(۱۰۲۷۹) حَدَّثَنَا وَکِیعٌ، عَنْ زِیَادِ بْنِ أَبِی مُسْلِمٍ، عَنِ الْحَسَنِ، قَالَ: لاَ نَعْلَمُ أَحَدًا مِنَ الْخُلَفَائِ قَالَ فِی الْحُلِیِّ زَکَاۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 10279","","","كتاب الزكاة"
"10280","(۱۰۲۸۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لَیْسَ فِی الْحُلِیِّ زَکَاۃٌ ، یُعَارُ وَیَلْبَسُ۔","","Musannaf Ibn Abi Shaybah 10280","","","كتاب الزكاة"
"10281","(۱۰۲۸۱) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، وَخِلاسٍ ، قَالَ : لاَ زَکَاۃَ فِی الْحُلِیّ۔","","Musannaf Ibn Abi Shaybah 10281","","","كتاب الزكاة"
"10282","(۱۰۲۸۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی حَصِینٍ (ح) وَأَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الشَّعْبِیِّ قَالَ : زَکَاۃُ الْحُلِیِّ عَارِیَّتُہُ۔","","Musannaf Ibn Abi Shaybah 10282","","","كتاب الزكاة"
"10283","(۱۰۲۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، قَالَ : سَمِعْتُ أَبَا جَعْفَرٍ یَقُولُ : لَیْسَ فِی الْحُلِیِّ زَکَاۃٌ ، ثُمَّ قَرَأَ : {وَتَسْتَخْرِجُونَ مِنْہُ حِلْیَۃً تَلْبَسُونَہَا}۔","","Musannaf Ibn Abi Shaybah 10283","","","كتاب الزكاة"
"10284","(۱۰۲۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ حُسَیْنٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : لَیْسَ فِی الْحُلِیِّ زَکَاۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 10284","","","كتاب الزكاة"
"10285","(۱۰۲۸۵) وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ، قَالَ : زَکَاۃُ الْحُلِیِّ یُعَارُ وَیُلْبَسُ۔","","Musannaf Ibn Abi Shaybah 10285","","","كتاب الزكاة"
"10286","(۱۰۲۸۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عُمَارَۃَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ ، عَنْ عَمْرَۃَ قَالَتْ : کُنَّا أَیْتَامًا فِی حِجْرِ عَائِشَۃَ ، وَکَانَ لَنَا حُلِیٌّ ، فَکَانَتْ لاَ تُزَکِّیہ۔","Hasan","Musannaf Ibn Abi Shaybah 10286","","","كتاب الزكاة"
"10287","(۱۰۲۸۷) حَدَّثَنَا بِشْرُ بْنُ الْمُفَضَّلِ ، عَنْ سُہَیْلٍ ، عَنْ أَبِیہِ ، قَالَ : سَأَلْتُ سَعْدًا ، وَابْنَ عُمَرَ ، وَأَبَا ہُرَیْرَۃَ ، وَأَبَا سَعِیدٍ ، فَقُلْتُ : إنَّ لِی مَالاً ، وَأَنَا أُرِیدُ أَنْ أُعْطِیَ زَکَاتَہُ ، وَلاَ أَجِدُ لَہُ مَوْضِعًا ، وَہَؤُلاَئِ یَصْنَعُونَ فِیہَا مَا تَرَوْنَ ؟ فَقَالَ : کُلُّہُمْ أَمَرُونِی أَنْ أَدْفَعَہَا إلَیْہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 10287","","","كتاب الزكاة"
"10288","(۱۰۲۸۸) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، عَنْ نَافِعٍ ، قَالَ : قَالَ ابْنُ عُمَرَ : ادْفَعُوا زَکَاۃَ أَمْوَالِکُمْ إلَی مَنْ وَلاَّہُ اللَّہُ أَمْرَکُمْ ، فَمَنْ بَرَّ فَلِنَفْسِہِ ، وَمِنْ أَثِمَ فَعَلَیْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 10288","","","كتاب الزكاة"
"10289","(۱۰۲۸۹) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ حَاتِمِ بْنِ أَبِی صَغِیرَۃَ ، قَالَ : حدَّثَنِی رِیَاحُ بْنُ عَبِیْدَۃَ ، عَنْ قَزَعَۃَ ، قَالَ : قُلْتُ لِاِبْنِ عُمَرَ : إنَّ لِی مَالاً ، فَإِلَی مَنْ أَدْفَعُ زَکَاتَہُ ؟ قَالَ : ادْفَعْہَا إلَی ہَؤُلاَئِ الْقَوْمِ ، یَعْنِی الأُمَرَائَ ، قُلْتُ : إذًا یَتَّخِذُونَ بِہَا ثِیَابًا وَطِیبًا ، قَالَ : وَإِنِ اتَّخَذُوا ثِیَابًا وَطِیبًا ، وَلَکِنْ فِی مَالِکَ حَقٌّ سِوَی الزَّکَاۃِ ، یَا قَزَعَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 10289","","","كتاب الزكاة"
"10290","(۱۰۲۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ حَاجِبِ بْنِ عُمَرَ ، عَنِ الْحَکَمِ بْنِ الأَعْرَجِ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ ؟ فَقَالَ : ادْفَعْہَا إلَیْہِمْ ، وَإِنْ أَکَلُوا بِہَا لُحُومَ الْکِلاَبِ ، فَلَمَّا عَادُوا عَلَیْہِ ، قَالَ : ادْفَعْہَا إلَیْہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 10290","","","كتاب الزكاة"
"10291","(۱۰۲۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مُثَنَّی بْنِ سَعِیدٍ ، عَنْ أَبِی التَّیَّاحِ ، عَنْ نُعَیْمٍ بن مُجَالِدٍ ؛ سَأَلْتُ ابْنَ عُمَرَ عَنْہَا ؟ فَقَالَ: ادْفَعْہَا إلَیْہِمْ وَإِنْ أَکَلُوا بِہَا البَیْشِیَارَجات۔","Da'if","Musannaf Ibn Abi Shaybah 10291","","","كتاب الزكاة"
"10292","(۱۰۲۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ یُونُسَ بْنِ الْحَارِثِ ، عَنْ دَاوُدَ بْنِ أَبِی عَاصِمٍ ، عَنِ الْمُغِیرَۃَ بْنِ شُعْبَۃَ ؛ أَنَّہُ کَانَ یَبْعَثُ بِصَدَقَتِہِ إلَی الأُمَرَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 10292","","","كتاب الزكاة"
"10293","(۱۰۲۹۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، أَنَّ حُذَیْفَۃَ ، وَسَعِیدَ بْنَ عُمَیْرٍ کَانُوا یَرَوْنَ أَنْ تُدْفَعَ الزَّکَاۃُ إلَی السُّلْطَانِ۔","","Musannaf Ibn Abi Shaybah 10293","","","كتاب الزكاة"
"10294","(۱۰۲۹۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَتِ الصَّدَقَۃُ تُدْفَعُ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَمَنْ أَمَرَ بِہِ ، وَإِلَی أَبِی بَکْرٍ وَمَنْ أَمَرَ بِہِ ، وَإِلَی عُمَرَ وَمَنْ أَمَرَ بِہِ ، وَإِلَی عُثْمَانَ وَمَنْ أَمَرَ بِہِ ، فَلَمَّا قُتِلَ عُثْمَانُ اخْتَلَفُوا ، فَمِنْہُمْ مَنْ رَأَی أَنْ یَدْفَعَہَا إلَیْہِمْ ، وَمِنْہُمْ مِنْ رَأَی أَنْ یَقْسِمَہَا ہُوَ ۔ قَالَ مُحَمَّدٌ : فَلْیَتَّقِ اللَّہَ مَنِ اخْتَارَ أَنْ یَقْسِمَہَا ہُوَ ، وَلاَ یَکُونَ یَعِیبُ عَلَیْہِمْ شَیْئًا ، یَأْتِی مِثْلُ الَّذِی یَعِیبُ عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 10294","","","كتاب الزكاة"
"10295","(۱۰۲۹۵) حَدَّثَنَا عَبْدَۃُ ، عَنْ حَارِثَۃَ بْنِ أَبِی الرِّجَالِ ، قَالَ : سَأَلْتُ عَمْرَۃَ عَنِ الزَّکَاۃِ ؟ فَقَالَتْ : قَالَتْ عَائِشَۃُ : ادْفَعُوہَا إلَی أُولِی الأَمْرِ مِنْکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 10295","","","كتاب الزكاة"
"10296","(۱۰۲۹۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ اللہِ بْنِ حَبِیبٍ ، قَالَ : سَأَلْتُ أَبَا جَعْفَرٍ عَنِ الزَّکَاۃِ ، أَدْفَعُہَا إلَی الْوُلاَۃِ ؟ فَقَالَ : ادْفَعْہَا إلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 10296","","","كتاب الزكاة"
"10297","(۱۰۲۹۷) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَائِشَۃَ ، عَنِ الْحَسَنِ ، قَالَ : أَرْبَعٌ إلَی السُّلْطَانِ ؛ الصَّلاَۃُ ، وَالزَّکَاۃُ ، وَالْحُدُودُ ، وَالْقَضَائُ۔","","Musannaf Ibn Abi Shaybah 10297","","","كتاب الزكاة"
"10298","(۱۰۲۹۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الْحَسَنِ ، قَالَ : ضَمِنَ ، أَوْ ضُمِنَ ہَؤُلاَء الْقَوْمُ أَرْبَعًا ؛ الصَّلاَۃَ ، وَالزَّکَاۃَ ، وَالْحُدُودَ ، وَالْحُکْمَ۔","","Musannaf Ibn Abi Shaybah 10298","","","كتاب الزكاة"
"10299","(۱۰۲۹۹) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، أَنَّہُ سُئِلَ عَنِ الزَّکَاۃِ ؟ قَالَ : ادْفَعْہَا إلَی السُّلْطَانِ ، فَقِیلَ : إنَّہُمْ یَفْعَلُونَ فِیہَا وَیَفْعَلُونَ ، مَرَّتَیْنِ ، قَالَ : فَتَسْتَطِیعُونَ أَنْ تَضَعُوہَا مَوَاضِعَہَا ؟ قَالُوا : لاَ ، قَالَ : فَادْفَعُوہَا إلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 10299","","","كتاب الزكاة"
"10300","(۱۰۳۰۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، عَنْ خَیْثَمَۃَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : أَعْطُوہَا الأُمَرَائَ مَا صَلَّوْا ۔ قَالَ : وَقَالَ خَیْثَمَۃُ : مَا صَلَّوا الصَّلاَۃَ لِوَقْتِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 10300","","","كتاب الزكاة"
"10301","(۱۰۳۰۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ کُلْثُومِ بْنِ جَبْرٍ ، عَنْ مُسْلِمِ بْنِ یَسَارٍ ، أَنَّہُ قَالَ : {وَأَقِیمُوا الصَّلاَۃَ وَآتَوُا الزَّکَاۃَ} ، قَالَ : ہَذِہِ الْفَرِیضَۃُ إلَی السُّلْطَانِ۔","","Musannaf Ibn Abi Shaybah 10301","","","كتاب الزكاة"
"10302","(۱۰۳۰۲) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّہُ کَانَ یَرَی أَنْ تُدْفَعَ الزَّکَاۃُ إلَی السُّلْطَانِ۔","","Musannaf Ibn Abi Shaybah 10302","","","كتاب الزكاة"
"10303","(۱۰۳۰۳) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ، قَالَ: حدَّثَنَا ہِشَامٌ، عَنْ یَحْیَی، عَنْ عَبْدِالرَّحْمَنِ بْنِ الْبَیْلَمَانِیِّ، قَالَ: قَالَ أَبُو بَکْرٍ الصِّدِّیقُ فِیمَا یُوصِی بِہِ عُمَرَ: مَنْ أَدَّی الزَّکَاۃَ إلَی غَیْرِ وُلاَتِہَا لَمْ تُقْبَلْ مِنْہُ صَدَقَتُہُ، وَلَوْ تَصَدَّقَ بِالدُّنْیَا جَمِیعًا۔","Da'if","Musannaf Ibn Abi Shaybah 10303","","","كتاب الزكاة"
"10304","(۱۰۳۰۴) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَد ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ قَالاَ : أَدِّ زَکَاۃَ مَالِکَ إلَی السُّلْطَانِ۔","","Musannaf Ibn Abi Shaybah 10304","","","كتاب الزكاة"
"10305","(۱۰۳۰۵) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ حَکِیمِ بْنِ الدَّیْلَمِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، وَابْنِ عُمَرَ قَالاَ : ادْفَعْ زَکَاۃَ مَالِکَ إلَی السُّلْطَانِ۔","Hasan","Musannaf Ibn Abi Shaybah 10305","","","كتاب الزكاة"
"10306","(۱۰۳۰۶) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنِ النُّعْمَانِ ، عَنْ مَکْحُولٍ ، قَالَ : سَأَلَہُ رَجُلٌ عَنِ الزَّکَاۃِ ؟ فَقَالَ : ادْفَعْہَا إلَی الإِمَامِ ۔ وَقَالَ : الإِمَامُ الْقُرْآنُ ، وَکَانَ یُخْفِی ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 10306","","","كتاب الزكاة"
"10307","(۱۰۳۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ إبْرَاہِیمَ ، وَالْحَسَنِ قَالاَ : ضَعْہَا مَوَاضِعَہَا وَأَخْفِہَا۔","","Musannaf Ibn Abi Shaybah 10307","","","كتاب الزكاة"
"10308","(۱۰۳۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عُتْبَۃَ الْکِنْدِیِّ ، عَنْ طَاوُوسٍ ، قَالَ : ضَعْہَا فِی الْفُقَرَائِ۔","","Musannaf Ibn Abi Shaybah 10308","","","كتاب الزكاة"
"10309","(۱۰۳۰۹) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ حَسَّانَ بْنِ أَبِی یَحْیَی ، قَالَ : سَأَلَ رَجُلٌ سَعِیدَ بْنَ جُبَیْرٍ عَنِ الصَّدَقَۃِ ؟ قَالَ : ہِیَ إلَی وُلاَۃِ الأَمْرِ ۔ قَالَ : فَإِنَّ الْحَجَّاجَ یَبْنِی بِہَا الْقُصُورَ ، وَیَضَعُہَا فِی غَیْرِ مَوَاضِعِہَا ، قَالَ : ضَعْہَا حَیْثُ أُمِرْت بِہِ۔","","Musannaf Ibn Abi Shaybah 10309","","","كتاب الزكاة"
"10310","(۱۰۳۱۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إِنْ دَفَعَہَا إلَیْہِمْ أَجْزَأَ عَنْہُ ، وَإِنْ قَسَمَہَا أَجْزَأَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 10310","","","كتاب الزكاة"
"10311","(۱۰۳۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ خَیْثَمَۃَ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنِ الزَّکَاۃِ ؟ فَقَالَ : ادْفَعْہَا إلَیْہِمْ ، ثُمَّ سَأَلْتُہُ بَعْدُ ، فَقَالَ : لاَ تَدْفَعْہَا إلَیْہِمْ ، فَإِنَّہُمْ قَدْ أَضَاعُوا الصَّلاَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 10311","","","كتاب الزكاة"
"10312","(۱۰۳۱۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : جَائَ رَجُلٌ بِزَکَاۃِ مَالِہِ إلَی عَلِیٍّ ، فَقَالَ لَہُ عَلِیٌّ : تَأْخُذُ مِنْ عَطَائِنَا شَیْئًا ؟ قَالَ : لاَ ، قَالَ : لاَ نَجْمَعُ عَلَیْک أَنْ لاَ نُعْطِیَک وَنَأْخُذُ مِنْک ، فَأَمَرَہُ أَنْ یَقْسِمَہَا۔","","Musannaf Ibn Abi Shaybah 10312","","","كتاب الزكاة"
"10313","(۱۰۳۱۳) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، قَالَ۔","","Musannaf Ibn Abi Shaybah 10313","","","كتاب الزكاة"
"10314","(۱۰۳۱۴) وحَدَّثَنَا شَرِیکٌ، عَنْ أَبِی إِسْحَاقَ، عَنْ عَاصِمٍ، عَنْ عَلِیٍّ، قَالَ: لَیْسَ فِی مَالٍ زَکَاۃٌ، حَتَّی یَحُولَ عَلَیْہِ الْحَوْلُ۔","Hasan","Musannaf Ibn Abi Shaybah 10314","","","كتاب الزكاة"
"10315","(۱۰۳۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمٍ ، عَنْ عَلِیٍّ ، قَالَ : لَیْسَ فِی مَالٍ زَکَاۃٌ ، حَتَّی یَحُولَ عَلَیْہِ الْحَوْلُ۔","Hasan","Musannaf Ibn Abi Shaybah 10315","","","كتاب الزكاة"
"10316","(۱۰۳۱۶) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَنْ أَصَابَ مَالاً فَلاَ زَکَاۃَ عَلَیْہِ حَتَّی یَحُولَ عَلَیْہِ الْحَوْلُ۔","Da'if","Musannaf Ibn Abi Shaybah 10316","","","كتاب الزكاة"
"10317","(۱۰۳۱۷) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ الأَعْمَشِ ، عَنْ رَجُلٍ ، عَنْ جَابِرٍ ، عَنْ أَبِی بَکْر ، قَالَ : لَیْسَ عَلَیْہِ زَکَاۃٌ حَتَّی یَحُولَ عَلَیْہِ الْحَوْلُ۔","Da'if","Musannaf Ibn Abi Shaybah 10317","","","كتاب الزكاة"
"10318","(۱۰۳۱۸) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ حُمَیْدٍ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : أَیُّمَا رَجُلٍ أَفَادَ مَالاً فَلاَ زَکَاۃَ عَلَیْہِ ، حَتَّی یَعُودَ عَلَیْہِ الْحَوْلُ۔","","Musannaf Ibn Abi Shaybah 10318","","","كتاب الزكاة"
"10319","(۱۰۳۱۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَالِمٍ ، قَالَ : لَیْسَ فِیہِ زَکَاۃٌ حَتَّی یَحُولَ عَلَیْہِ الْحَوْلُ۔","","Musannaf Ibn Abi Shaybah 10319","","","كتاب الزكاة"
"10320","(۱۰۳۲۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لَیْسَ فِی مَالٍ زَکَاۃٌ ، حَتَّی یَحُولَ عَلَیْہِ الْحَوْلُ۔","","Musannaf Ibn Abi Shaybah 10320","","","كتاب الزكاة"
"10321","(۱۰۳۲۱) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مَنْصُورٍ، أَوْ غَیْرِہِ، عَنْ َإِبْرَاہِیمَ قَالَ: لاَ زَکَاۃَ فِیہِ حَتَّی یَحُولَ عَلَیْہِ الْحَوْلُ۔","","Musannaf Ibn Abi Shaybah 10321","","","كتاب الزكاة"
"10322","(۱۰۳۲۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ حَارِثَۃَ بْنِ مُحَمَّدٍ ، عَنْ عَمْرَۃَ بِنْتِ عَبْدِ الرَّحْمَنِ ، عَنْ عَائِشَۃَ ،قَالَتْ : لَیْسَ فِی مَالٍ زَکَاۃٌ حَتَّی یَحُولَ عَلَیْہِ الْحَوْلُ۔","Da'if","Musannaf Ibn Abi Shaybah 10322","","","كتاب الزكاة"
"10323","(۱۰۳۲۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : لَیْسَ فِیہِ زَکَاۃٌ حَتَّی یَحُولَ عَلَیْہِ الْحَوْلُ۔","","Musannaf Ibn Abi Shaybah 10323","","","كتاب الزكاة"
"10324","(۱۰۳۲۴) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی التَّیْمِیُّ ، عَنْ مَنْصُورٍ ، عَنْ یَعْلَی بْنِ نُعْمَانَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لَیْسَ عَلَیْہِ زَکَاۃٌ حَتَّی یَحُولَ عَلَیْہِ حَوْلٌ ، مِنْ حِینَ یَسْتَفِیدُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 10324","","","كتاب الزكاة"
"10325","(۱۰۳۲۵) حَدَّثَنَا مُعْتَمِر ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : إذَا کَانَ لِلرَّجُلِ شَہْرٌ یُزَکِّی فِیہِ فَأَصَابَ مَالاً فَأَنْفَقَہُ ، فَلَیْسَ عَلَیْہِ زَکَاۃُ مَا أَنْفَقَ ، وَلَکِنْ مَا وَافَی الشَّہْرَ الَّذِی یُزَکِّی فِیہِ مَالَہُ زَکَّاہُ ، فَإِنْ کَانَ لَیْسَ لَہُ شَہْرٌ یُزَکِّی فِیہِ فَاسْتَفَادَ مَالاً ، فَلْیُزَکِّہِ حِینَ یَسْتَفِیدُہُ۔","","Musannaf Ibn Abi Shaybah 10325","","","كتاب الزكاة"
"10326","(۱۰۳۲۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی الرَّجُلِ یَسْتَفِیدُ مَالاً ؟ قَالَ : یُزَکِّیہ حِینَ یَسْتَفِیدُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 10326","","","كتاب الزكاة"
"10327","(۱۰۳۲۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّہُ کَانَ یَقُولُ : إذَا اسْتَفَادَ الرَّجُلُ مَالاً فَأَرَادَ أَنْ یُنْفِقَہُ قَبْلَ مَجِیئِ شَہْرِ زَکَاتِہِ فَلْیُزَکِّہِ ، ثُمَّ لْیُنْفِقْہُ ، وَإِنْ کَانَ لاَ یُرِیدُ أَنْ یُنْفِقَ فَلْیُزَکِّہِ مَعَ مَالِہِ۔","","Musannaf Ibn Abi Shaybah 10327","","","كتاب الزكاة"
"10328","(۱۰۳۲۸) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لَیْسَ فِی مَالِ الْمُکَاتَبِ زَکَاۃٌ۔","","Musannaf Ibn Abi Shaybah 10328","","","كتاب الزكاة"
"10329","(۱۰۳۲۹) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ، قَالَ : لَیْسَ فِی مَالِ الْمُکَاتَبِ زَکَاۃٌ۔","","Musannaf Ibn Abi Shaybah 10329","","","كتاب الزكاة"
"10330","(۱۰۳۳۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ صُبَیْحٍ أَبِی الْجَہْمِ مَوْلَی بَنِی عَبْسٍ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ ، وَابْنَ الْمُسَیَّبِ عَنْ رَجُلٍ مُکَاتَبٍ لَہُ مَالٌ ، أَعَلَی مَالِہِ زَکَاۃٌ ؟ قَالاَ : لاَ۔","","Musannaf Ibn Abi Shaybah 10330","","","كتاب الزكاة"
"10331","(۱۰۳۳۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، عَنْ أَبِیہِ مَیْمُونِ بْنِ مِہْرَانَ ، عَنْ جَدَّتِہِ ، عَنْ مَسْرُوقٍ ، قَالَ: لَیْسَ فِی مَالِ الْمُکَاتَبِ زَکَاۃٌ۔","","Musannaf Ibn Abi Shaybah 10331","","","كتاب الزكاة"
"10332","(۱۰۳۳۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : لَیْسَ فِی مَالِ الْمُکَاتَبِ ، وَلاَ الْعَبْدِ زَکَاۃٌ حَتَّی یُعْتَقَا۔","","Musannaf Ibn Abi Shaybah 10332","","","كتاب الزكاة"
"10333","(۱۰۳۳۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لَیْسَ فِی مَالِ الْمُکَاتَبِ ، وَلاَ الْعَبْدِ زَکَاۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 10333","","","كتاب الزكاة"
"10334","(۱۰۳۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی صَخْرٍ ، عَنْ کَیْسَانَ أَبِی سَعِیدٍ الْمَقْبُرِیِّ ، قَالَ : أَتَیْتُ عُمَرَ بِزَکَاۃِ مَالِی ، مِئَتَیْ دِرْہَمٍ وَأَنَا مُکَاتَبٌ ، فَقَالَ : ہَلْ عُتِقْتَ ؟ قُلْتُ : نَعَمْ ، قَالَ : اذْہَبْ فَاقْسِمْہَا۔","Hasan","Musannaf Ibn Abi Shaybah 10334","","","كتاب الزكاة"
"10335","(۱۰۳۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ؛ مِثْلَ قَوْلِ جَابِرٍ۔","","Musannaf Ibn Abi Shaybah 10335","","","كتاب الزكاة"
"10336","(۱۰۳۳۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لَیْسَ فِی مَالِ الْعَبْدِ زَکَاۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 10336","","","كتاب الزكاة"
"10337","(۱۰۳۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ اللہِ بْنِ نَافِعٍ ، عَنْ أَبِیہِ ، عَنْ عُمَرَ ، قَالَ : لَیْسَ فِی مَالِ الْعَبْدِ زَکَاۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 10337","","","كتاب الزكاة"
"10338","(۱۰۳۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : لَیْسَ فِی مَالِ الْعَبْدِ زَکَاۃٌ۔","","Musannaf Ibn Abi Shaybah 10338","","","كتاب الزكاة"
"10339","(۱۰۳۳۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : الْعَبْدُ وَمَالُہُ لِسَیِّدِہِ ، الزَّکَاۃُ عَلَی الْمَوْلَی ، وَلَیْسَ عَلَی الْعَبْدِ زَکَاۃٌ۔","","Musannaf Ibn Abi Shaybah 10339","","","كتاب الزكاة"
"10340","(۱۰۳۴۰) حَدَّثَنَا زَیْدُ بْنُ حَبَّابٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَبْدِ اللہِ بْنِ کَثِیرٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لَیْسَ فِی مَالِ الْعَبْدِ زَکَاۃٌ۔","","Musannaf Ibn Abi Shaybah 10340","","","كتاب الزكاة"
"10341","(۱۰۳۴۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : لَیْسَ فِی مَالِ الْعَبْدِ زَکَاۃٌ۔","","Musannaf Ibn Abi Shaybah 10341","","","كتاب الزكاة"
"10342","(۱۰۳۴۲) حَدَّثَنَا یَحْیَی بْنُ عَبْدِ الْمَلِکِ بْنِ أَبِی غَنِیَّۃَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : لَیْسَ عَلَی الْعَبْدِ زَکَاۃٌ۔","","Musannaf Ibn Abi Shaybah 10342","","","كتاب الزكاة"
"10343","(۱۰۳۴۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ عُثْمَانَ بْنِ غِیَاثٍ ، عَنْ عِکْرِمَۃَ ؛ أَنَّہُ سُئِلَ عَنِ الْعَبْدِ : ہَلْ عَلَیْہِ زَکَاۃٌ ؟ قَالَ : ہَلْ عَلَیْہِ صَلاَۃٌ ؟۔","","Musannaf Ibn Abi Shaybah 10343","","","كتاب الزكاة"
"10344","(۱۰۳۴۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : فِی مَالِ الْعَبْدِ زَکَاۃٌ۔","","Musannaf Ibn Abi Shaybah 10344","","","كتاب الزكاة"
"10345","(۱۰۳۴۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ جَابِرٍ الْحَذَّائِ ، قَالَ : قُلْتُ لِاِبْنِ عُمَرَ : فِی مَالِ الْعَبْدِ زَکَاۃٌ ؟ قَالَ : مُسْلِمٌ ہُوَ ؟ قُلْتُ : نَعَمْ ، قَالَ : فِی مِئَتَیْ دِرْہَمٍ خَمْسَۃُ دَرَاہِمَ۔","Da'if","Musannaf Ibn Abi Shaybah 10345","","","كتاب الزكاة"
"10346","(۱۰۳۴۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ ، قَالَ : سُئِلَ عَلِیٌّ عَنِ الرَّجُلِ یَکُونُ لَہُ الدَّیْنُ عَلَی الرَّجُلِ ؟ قَالَ : یُزَکِّیہ صَاحِبُ الْمَالِ ، فَإِنْ تَوَی مَا عَلَیْہِ وَخَشِیَ أَنْ لاَ یَقْضِیَ ، فَإِنَّہُ یُمْہِلُ ، فَإِذَا خَرَجَ أَدَّی زَکَاۃَ مَا مَضَیِ۔","Hasan","Musannaf Ibn Abi Shaybah 10346","","","كتاب الزكاة"
"10347","(۱۰۳۴۷) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : نُبِّئْت أَنَّ عَلِیًّا قَالَ : إِنْ کَانَ صَادِقًا ، فَلْیُزَکِّ إذَا قَبَضَ، یَعْنِی الدَّیْنَ۔","Da'if","Musannaf Ibn Abi Shaybah 10347","","","كتاب الزكاة"
"10348","(۱۰۳۴۸) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : إذَا کَانَ لَکَ دَیْنٌ فَزَکِّہِ۔","","Musannaf Ibn Abi Shaybah 10348","","","كتاب الزكاة"
"10349","(۱۰۳۴۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لِیَنْظُرْ مَا کَانَ عَلَیْہِ مِنْ دَیْنٍ فَلْیَعْزِلْہُ ، وَمَا کَانَ لَہُ مِنْ دَیْنٍ ثِقَۃٍ فَلْیُزَکِّہِ ، وَمَا کَانَ لاَ یَسْتَقِرّ یُعْطِیہ الْیَوْمَ وَیَأْخُذْہُ إِلَی یَوْمَینِ فَلْیُزَکِّہِ۔","","Musannaf Ibn Abi Shaybah 10349","","","كتاب الزكاة"
"10350","(۱۰۳۵۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : یُزَکِّیہِ۔","Da'if","Musannaf Ibn Abi Shaybah 10350","","","كتاب الزكاة"
"10351","(۱۰۳۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : زَکَاۃُ أَمْوَالِکُمْ حَوْلٌ إلَی حَوْلٍ ، فَمَا کَانَ مِنْ دَیْنٍ ثِقَۃٍ فَزَکُّوہ ، وَمَا کَانَ مِنْ دَیْنِ ظُنُون فَلاَ زَکَاۃَ فِیہِ ، حَتَّی یَقْضِیَہُ صَاحِبُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 10351","","","كتاب الزكاة"
"10352","(۱۰۳۵۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : یُزَکِّیہِ۔","","Musannaf Ibn Abi Shaybah 10352","","","كتاب الزكاة"
"10353","(۱۰۳۵۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ یَزِیدَ بْنِ یَزِیدَ بْنِ جَابِرٍ ؛ أَنَّ عَبْدَ الْمَلِکِ بْنَ أَبِی بَکْرٍ أَخْبَرَہُ ، أَنَّ عُمَرَ قَالَ لِرَجُلٍ : إذَا حَلَّتْ فَاحْسُبْ دَیْنَک ، وَمَا عِنْدَک ، فَاجْمَعْ ذَلِکَ جَمِیعًا ، ثُمَّ زَکِّہِ۔","","Musannaf Ibn Abi Shaybah 10353","","","كتاب الزكاة"
"10354","(۱۰۳۵۴) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرٍ ، عَنْ مَیْمُونٍ ، قَالَ : مَا کَانَ مِنْ دَیْنٍ فِیمَا لاَ تَرْجُوہُ فَاحْسُبْہُ ، ثُمَّ أَخْرِجْ مَا عَلَیْک ، ثُمَّ زَکِّ مَا بَقِیَ۔","","Musannaf Ibn Abi Shaybah 10354","","","كتاب الزكاة"
"10355","(۱۰۳۵۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُثْمَانَ بْنِ الأَسْوَد ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا کُنْتَ تَعْلَمُ أَنَّہُ خَارِجٌ فَزَکِّہِ۔","","Musannaf Ibn Abi Shaybah 10355","","","كتاب الزكاة"
"10356","(۱۰۳۵۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنْ مُحَمَّدٍ ، عَنْ عُبَیْدَۃَ ، قَالَ : سُئِلَ عَلِیٌّ عَنِ الرَّجُلِ یَکُونُ لَہُ الدَّیْنُ الظَّنُونُ أَیُزَکِّیہِ ؟ فَقَالَ : إِنْ کَانَ صَادِقًا فَلْیُزَکِّہِ لِمَا مَضَی إذَا قَبَضَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 10356","","","كتاب الزكاة"
"10357","(۱۰۳۵۷) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ عُثْمَانَ بْنِ أَبِی عُثْمَانَ ، قَالَ : قُلْتُ لِلْقَاسِمِ بْنِ مُحَمَّدٍ : إنَّ لَنَا قَرْضًا وَقَرْضًا وَدَیْنًا ، فَنُزَکِّیہِ ؟ قَالَ : نَعَمْ ، کَانَتْ عَائِشَۃُ تَأْمُرُنَا نُزَکِّیَ مَا فِی الْبَحْرِ ۔ وَسَأَلْتُ سَالِمًا؟ فَقَالَ : مِثْلَ ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 10357","","","كتاب الزكاة"
"10358","(۱۰۳۵۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزِّنَادِ ، عَنْ عِکْرِمَۃَ ، قَالَ : لَیْسَ فِی الدَّیْنِ زَکَاۃٌ۔","","Musannaf Ibn Abi Shaybah 10358","","","كتاب الزكاة"
"10359","(۱۰۳۵۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ عَبْدِ اللہِ بْنِ الْمُؤَمِّلِ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ عَائِشَۃَ ،قَالَتْ : لَیْسَ فِیہِ زَکَاۃٌ حَتَّی یَقْبِضَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 10359","","","كتاب الزكاة"
"10360","(۱۰۳۶۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُثْمَانَ بْنِ الأَسْوَد ، عَنْ عَطَائٍ ، قَالَ : لاَ یُزَکِّیہِ حَتَّی یَقْبِضَہُ۔","","Musannaf Ibn Abi Shaybah 10360","","","كتاب الزكاة"
"10361","(۱۰۳۶۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : لَیْسَ عَلَی صَاحِبِ الدَّیْنِ الَّذِی ہُوَ لَہُ ، وَلاَ الَّذِی ہُوَ عَلَیْہِ زَکَاۃٌ۔","","Musannaf Ibn Abi Shaybah 10361","","","كتاب الزكاة"
"10362","(۱۰۳۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : لَیْسَ فِیہِ زَکَاۃٌ حَتَّی یَقْبِضَہُ۔","","Musannaf Ibn Abi Shaybah 10362","","","كتاب الزكاة"
"10363","(۱۰۳۶۳) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ، عَنِ الْحَکَمِ، قَالَ: خَالَفَنِی إبْرَاہِیمُ فِیہِ، فَقُلْتُ: لاَ یُزَکِّی، ثُمَّ رَجَعَ إلَی قَوْلِی۔","","Musannaf Ibn Abi Shaybah 10363","","","كتاب الزكاة"
"10364","(۱۰۳۶۴) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ الْعُمَرِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : لَیْسَ فِی الدَّیْنِ زَکَاۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 10364","","","كتاب الزكاة"
"10365","(۱۰۳۶۵) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یُکَافِیَٔ الْعَبْدُ أَصْحَابَہُ ، وَأَنْ یَتَصَدَّقَ مِنَ الْفَضْلِ کَذَلِکَ۔","","Musannaf Ibn Abi Shaybah 10365","","","كتاب الزكاة"
"10366","(۱۰۳۶۶) حَدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : یَتَصَدَّقُ الْعَبْدُ مِنْ قُوتِہِ بِالشَّیْئِ لاَ یُضَرُّ بِہِ۔","","Musannaf Ibn Abi Shaybah 10366","","","كتاب الزكاة"
"10367","(۱۰۳۶۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ سَأَلَہُ رَجُلٌ ، فَقَالَ : أَنَا رَجُلٌ مَمْلُوکٌ وَمَعِی مَالٌ ، فَأَتَصَدَّقُ مِنْہُ ؟ قَالَ : نَعَمْ ، بِثَلاَثَۃِ دَرَاہِمَ ، أَرْبَعَۃِ۔","","Musannaf Ibn Abi Shaybah 10367","","","كتاب الزكاة"
"10368","(۱۰۳۶۸) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَنْ دَاوُدَ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ : مَا یَتَصَدَّقُ بِہِ الْعَبْدُ مِنْ مَالِہِ ؟ قَالَ : الصَّاعُ وَشَبَہُہُ۔","","Musannaf Ibn Abi Shaybah 10368","","","كتاب الزكاة"
"10369","(۱۰۳۶۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَتَصَدَّقُ الْعَبْدُ بِمَا دُونَ الدِّرْہَمِ۔","","Musannaf Ibn Abi Shaybah 10369","","","كتاب الزكاة"
"10370","(۱۰۳۷۰) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ اللہِ بْنِ نَافِعٍ ، عَنْ أَبِیہِ ، وَکَانَ مَمْلُوکًا لِبَنِی ہَاشِمٍ ؛ أَنَّہُ سَأَلَ عُمَرَ أَیَتَصَدَّقُ ؟ قَالَ : بِالدِّرْہَمِ وَالرَّغِیفِ۔","Da'if","Musannaf Ibn Abi Shaybah 10370","","","كتاب الزكاة"
"10371","(۱۰۳۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ دَاوُدَ بْنِ قَیْسٍ ، عَنْ سَالِمٍ ، قَالَ : یَتَقَرَّبُ بِمَا اسْتَطَاعَ مِنْ خَیْرٍ۔","","Musannaf Ibn Abi Shaybah 10371","","","كتاب الزكاة"
"10372","(۱۰۳۷۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، وَخَیْثَمَۃَ ؛ فِی الْعَبْدِ یَتَصَدَّقُ ؟ قَالاَ : لاَ یَتَصَدَّقُ بِمَا فَوْقَ الدِّرْہَمِ۔","","Musannaf Ibn Abi Shaybah 10372","","","كتاب الزكاة"
"10373","(۱۰۳۷۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : یَتَصَدَّقُ بِالشَّیْئِ لَیْسَ بِذِی بَالٍ۔","","Musannaf Ibn Abi Shaybah 10373","","","كتاب الزكاة"
"10374","(۱۰۳۷۴) حَدَّثَنَا حَفْصٌ ، عَنْ مُحَمَّدِ بْنِ زَیْدٍ ، عَنْ عُمَیْرٍ مَوْلَی آبِی اللَّحْمِ ، قَالَ : کُنْتُ عَبْدًا مَمْلُوکًا ، وَکُنْت أَتَصَدَّقُ ، فَسَأَلْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَکَانَ مَوْلاَیَ یَنْہَانِی ، أَوْ سَأَلَہُ ، فَقَالَ : الأَجْرُ بَیْنَکُمَا۔ (مسلم ۷۱۱۔ ابن ماجہ ۲۲۹۷)","Sahih","Musannaf Ibn Abi Shaybah 10374","","","كتاب الزكاة"
"10375","(۱۰۳۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ، قَالَ : یَتَصَدَّقُ بِالدِّرْہَمِ۔","Da'if","Musannaf Ibn Abi Shaybah 10375","","","كتاب الزكاة"
"10376","(۱۰۳۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُجِیبُ دَعْوَۃَ الْمَمْلُوکِ۔ (ابن سعد ۳۷۰)","","Musannaf Ibn Abi Shaybah 10376","","","كتاب الزكاة"
"10377","(۱۰۳۷۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُسْلِمٍ ، عَنْ أَنَسٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُجِیبُ دَعْوَۃَ الْمَمْلُوکِ۔ (ترمذی ۱۰۱۷۔ ابن ماجہ ۴۱۷۸)","Da'if","Musannaf Ibn Abi Shaybah 10377","","","كتاب الزكاة"
"10378","(۱۰۳۷۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ عُبَیْدِ بْنِ سَلْمَانَ ، عَنِ ابْنِ الْمُسَیَّبِ ، قَالَ : لاَ یَتَصَدَّقُ الْعَبْدُ عَلَی وَالِدِہِ ، وَلاَ عَلَی أُمِّہِ إِلاَّ بِإِذْنِ سَیِّدِہِ۔","","Musannaf Ibn Abi Shaybah 10378","","","كتاب الزكاة"
"10379","(۱۰۳۷۹) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ دِرْہمٍ ، قَالَ : سَأَلْتُ أَبَا ہُرَیْرَۃَ ، قُلْتُ : إِنَّہُ قَدْ جَعَلَ عَلَیَّ مَوْلاَیَ دِرْہَمًا فِی الْیَوْمِ ، فَأَتَصَدَّقُ ؟ قَالَ : لاَ یَحِلُّ لَکَ مِنْ دَمِکَ ، وَلاَ مِنْ مَالِکَ شَیْئٌ إِلاَّ بِإِذْنِہِ ، تُنَاوِلُ الْمِسْکِینَ اللُّقْمَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 10379","","","كتاب الزكاة"
"10380","(۱۰۳۸۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : لاَ یَتَصَدَّقُ الْعَبْدُ بِشَیْئٍ مِنْ مَالِہِ ، إِلاَّ بِإِذْنِ مَوْلاَہُ۔","","Musannaf Ibn Abi Shaybah 10380","","","كتاب الزكاة"
"10381","(۱۰۳۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ سُلَیْمَانَ ، قَالَ : شَہِدْت الشَّعْبِیَّ ، وَسَأَلَہُ مَمْلُوکٌ ، قَالَ : إنِّی اکْتَسَبْتُ کَذَا وَکَذَا ، فَیَأْخُذُ مَوْلاَیَ کَذَا وَکَذَا ، فَأَتَصَدَّقُ ؟ قَالَ : إِذَنْ یَکُونُ الأَجْرُ لِمَوَالِیک۔","","Musannaf Ibn Abi Shaybah 10381","","","كتاب الزكاة"
"10382","(۱۰۳۸۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّ عَمْرَو بْنَ الْعَاصِ کَانَ یَأْمُرُ لِلْمِسْکِینِ بِالشَّیْئِ ، فَإِذَا لَمْ یُوجَدْ وُضِعَ حَتَّی یُعْطِیَہُ غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 10382","","","كتاب الزكاة"
"10383","(۱۰۳۸۳) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ؛ إِنَّہُ کَرِہَ إذَا أُمِرَ لِلسَّائِلِ بِطَعَامٍ فَلَمْ یَقْدِرْ عَلَیْہِ ، أَنْ یَأْکُلَہُ حَتَّی یَتَصَدَّقَ بِہِ۔","","Musannaf Ibn Abi Shaybah 10383","","","كتاب الزكاة"
"10384","(۱۰۳۸۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَبَّابِ بْنِ الْمُخْتَارِ، عَنْ عَمْرِو بْنِ سَعِیدٍ؛ أَنَّ سَائِلاً سَأَلَ حُمَیْدَ بْنَ عَبْدِالرَّحْمَنِ؟ فَقَالَ لَہُ حمَیْدٌ : إنَّک ضَالٌّ ، وَکَأَنَّہُ عِبَادِیٌّ ، فَأَمَرَ لَہُ بِشَیْئٍ فَاسْتَقَلَّہُ وَأَبَی أَنْ یَقْبَلَہُ ، فَقَالَ لَہُ حُمَیْدٌ : مَا شِئْت إِنْ قَبِلْتَہُ ، وَإِلاَّ أَعْطَیْنَاہُ غَیْرَک ، ثُمَّ قَالَ : کَانَ یُقَالُ : رُدُّوا السَّائِلَ وَلَوْ بِمِثْلِ رَأْسِ الْقَطَاۃِ۔","","Musannaf Ibn Abi Shaybah 10384","","","كتاب الزكاة"
"10385","(۱۰۳۸۵) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ؛ فِی الرَّجُلِ یَخْرُجُ بِالصَّدَقَۃِ إلَی السَّائل فَیَفُوتُ مِنْہُ فَلاَ یَجِدُہُ ؟ قَالَ : یَصْرِفُہَا إلَی غَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 10385","","","كتاب الزكاة"
"10386","(۱۰۳۸۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یُخْرِجُ الصَّدَقَۃَ إلَی الْمِسْکِینَ فَیَفُوتُہُ ، قَالَ : یَحْبِسُہَا حَتَّی یُعْطِیَہَا مِسْکِینًا غَیْرَہُ ، وَلاَ یَرْجِعُ فِی شَیْئٍ جَعَلَہُ لِلَّہِ۔","","Musannaf Ibn Abi Shaybah 10386","","","كتاب الزكاة"
"10387","(۱۰۳۸۷) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ؛ فِی السَّائِلِ إذَا خَرَجَ إلَیْہِ بِالْکِسْرَۃِ فَلَمْ یَجِدْہُ ، احْبِسْہَا حَتَّی یَجِیئَ غَیْرُہُ۔","","Musannaf Ibn Abi Shaybah 10387","","","كتاب الزكاة"
"10388","(۱۰۳۸۸) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ ابْنُ الْعَاصِ یَقُولُ : إذَا خَرَجَ إلَیْہِ بِالْکِسْرَۃِ فَلَمْ یُوجَدْ ، حَبَسوہَا حَتَّی یَجِیئَ غَیْرُہُ۔","","Musannaf Ibn Abi Shaybah 10388","","","كتاب الزكاة"
"10389","(۱۰۳۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَمْرِو بْنِ الْعَاصِ ، قَالَ : یَضَعُہَا حَتَّی یَجِیئَ غَیْرُہُ۔","","Musannaf Ibn Abi Shaybah 10389","","","كتاب الزكاة"
"10390","(۱۰۳۹۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ، قَالاَ: یَحْبِسُہَا حَتَّی یُعْطِیَہَا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 10390","","","كتاب الزكاة"
"10391","(۱۰۳۹۱) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : یَصْنَعُ بِہَا مَا شَائَ۔","","Musannaf Ibn Abi Shaybah 10391","","","كتاب الزكاة"
"10392","(۱۰۳۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، وَعَامِرٍ ، وَعَطَائٍ ، قَالُوا : إِنْ شَائَ أَمْضَاہَا ، وَإِنْ شَائَ أَمْسَکَہَا۔","","Musannaf Ibn Abi Shaybah 10392","","","كتاب الزكاة"
"10393","(۱۰۳۹۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ، عَنْ أَنَسٍ ، وَالْحَسَنِ قَالاَ : مَا أُخِذَ مِنْک عَلَی الْجُسُورِ وَالْقَنَاطِیرِ ، فَتِلْکَ زَکَاۃٌ مَاضِیَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 10393","","","كتاب الزكاة"
"10394","(۱۰۳۹۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، وَأَبُو بَکْرٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : احْتَسِبْ مَا أَخَذَ مِنْکَ الْعَشَّارُونَ مِنْ زَکَاۃِ مَالِک۔","","Musannaf Ibn Abi Shaybah 10394","","","كتاب الزكاة"
"10395","(۱۰۳۹۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الزِّبْرِقَانِ ، قَالَ : سَأَلْتُ أَبَا رَزِینٍ : مَا یَأْخُذُ الْعَشَّارُ مِنَ التُّجَّارِ ؟ قَالَ : یَحْتَسِبُ بِہِ مِنْ زَکَاتِہِ۔","","Musannaf Ibn Abi Shaybah 10395","","","كتاب الزكاة"
"10396","(۱۰۳۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ إبْرَاہِیمَ ، وَالْحَسَنِ ، قَالاَ : مَا أَخَذَ مِنْک الْعَاشِرُ ، فَاحْتَسِبْ بِہِ مِنَ الزَّکَاۃِ۔","","Musannaf Ibn Abi Shaybah 10396","","","كتاب الزكاة"
"10397","(۱۰۳۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَحْتَسِبُ بِہِ۔","","Musannaf Ibn Abi Shaybah 10397","","","كتاب الزكاة"
"10398","(۱۰۳۹۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا مَرَّ عَلَی الْعَاشِرِ فَأَخَذَ مِنْہُ ، احْتَسَبَ بِہِ مِنْ زَکَاتِہِ۔","","Musannaf Ibn Abi Shaybah 10398","","","كتاب الزكاة"
"10399","(۱۰۳۹۹) حَدَّثَنَا ابْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عَبْدِ اللہِ ، عَنِ الشَّعْبِیِّ ، قَالَ : فِی الرَّجُلِ یَمُرُّ بِالْعَاشِرِ فَیَأْخُذُ مِنْہُ ؟ قَالَ : یَحْتَسِبُ مَا أَخَذُوا مِنْہُ مِنْ زَکَاۃِ مَالِہِ۔","","Musannaf Ibn Abi Shaybah 10399","","","كتاب الزكاة"
"10400","(۱۰۴۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ قَیْسٍ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : یَحْتَسِبُ بِہِ۔","","Musannaf Ibn Abi Shaybah 10400","","","كتاب الزكاة"
"10401","(۱۰۴۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : سَأَلْتُہُ ؟ فَقَالَ : احْتَسِبْ بِمَا أَخَذَ مِنْک الْعَاشِرُ۔","","Musannaf Ibn Abi Shaybah 10401","","","كتاب الزكاة"
"10402","(۱۰۴۰۲) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : لاَ تَحْتَسِبْ بِمَا أَخَذَ مِنْک الْعَاشِرُ۔","","Musannaf Ibn Abi Shaybah 10402","","","كتاب الزكاة"
"10403","(۱۰۴۰۳) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ الْمَوْصِلِیِّ ، عَنْ جَعْفَرٍ ، عَنْ مَیْمُونٍ ، قَالَ : لاَ یَحْتَسِبُ بِہِ۔","","Musannaf Ibn Abi Shaybah 10403","","","كتاب الزكاة"
"10404","(۱۰۴۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، وَطَاوُوسٍ قَالاَ : لاَ تَحْتَسِبْ مَا أَخَذَ مِنْکَ الْعَاشِرُ۔","","Musannaf Ibn Abi Shaybah 10404","","","كتاب الزكاة"
"10405","(۱۰۴۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ ثُوَیْرٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ یَحْتَسِبُ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 10405","","","كتاب الزكاة"
"10406","(۱۰۴۰۶) حَدَّثَنَا وَکِیعٌ، عَنْ حَسَنِ بْنِ صَالِحٍ، عَنِ سُدَیرٍ، عَنْ أَبِی جَعْفَرٍ، قَالَ: لاَ تَحْتَسِبْ بِمَا أَخَذَ مِنْک الْعَاشِرُ۔","","Musannaf Ibn Abi Shaybah 10406","","","كتاب الزكاة"
"10407","(۱۰۴۰۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ ہِشَامٍ ، أَوْ غَیْرِہِ ، عَنِ الْحَسَنِ ؛ أَنَّہُمَا کَانَا یَکْرَہَانِ أَنْ تُخْرِجَ الزَّکَاۃَ مِنْ بَلَدٍ إلَی بَلَدٍ۔","","Musannaf Ibn Abi Shaybah 10407","","","كتاب الزكاة"
"10408","(۱۰۴۰۸) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَرِہَ أَنْ تُحْمَلَ الصَّدَقَۃُ مِنْ بَلَدٍ إلَی بَلَدٍ۔","","Musannaf Ibn Abi Shaybah 10408","","","كتاب الزكاة"
"10409","(۱۰۴۰۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ أَبِی رَوَّادٍ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ بُعِثَ إلَیْہِ بِزَکَاۃٍ مِنَ الْعِرَاقِ إلَی الشَّامِ ، فَرَدَّہَا إلَی الْعِرَاقِ۔","","Musannaf Ibn Abi Shaybah 10409","","","كتاب الزكاة"
"10410","(۱۰۴۱۰) حَد[corrupt]َثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنْ عُثْمَانَ بْنِ مُرَّۃَ ، قَالَ : سَأَلْتُ امْرَأَۃَ الْقَاسِمِ ؟ فَقَالَتْ : اجْتَمَعَ عِنْدَنَا دَرَاہِمُ مِنْ زَکَاتِنَا ، فَبَعَثْت بِہَا إلَی الشَّامِ ، فَقَالَ : ادْفَعُوہَا إلَی الأَمِیرِ الَّذِی بِالْمَدِینَۃِ۔","","Musannaf Ibn Abi Shaybah 10410","","","كتاب الزكاة"
"10411","(۱۰۴۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی لَیْنۃ ، عَنِ الضَّحَّاکِ ، قَالَ : ضَعِ الزَّکَاۃَ فِی الْقَرْیَۃِ الَّتِی أَنْتَ فِیہَا ، فَإِنْ لَمْ یَکُنْ فِیہَا فُقَراء فَإِلَی الَّتِی تَلِیہَا۔","","Musannaf Ibn Abi Shaybah 10411","","","كتاب الزكاة"
"10412","(۱۰۴۱۲) حَدَّثَنَا أَبُو خَالِدٍ وَلَیْسَ بِالأَحْمَرِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ فَرْقَدٍ السَبَخِیِّ ، قَالَ : بُعِثَ مَعِیَ بِزَکَاۃٍ إلَی مَکَّۃَ ، فَلَقِیت سَعِیدَ بْنَ جُبَیْرٍ ، فَقَالَ : رُدَّہَا إلَی الأَرْضِ الَّتِی حَمَلْتہَا مِنْہَا۔","","Musannaf Ibn Abi Shaybah 10412","","","كتاب الزكاة"
"10413","(۱۰۴۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی خَلدۃ ، عَنْ أَبِی الْعَالِیَۃِ ؛ أَنَّہُ بَعَثَ بِصَدَقَۃِ مَالِہِ إلَی الْمَدِینَۃِ۔","","Musannaf Ibn Abi Shaybah 10413","","","كتاب الزكاة"
"10414","(۱۰۴۱۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی سَاسَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : ہُمُ الْمُسْلِمُونَ فَأَعْطِہِ حَیْثُ شِئْت۔","","Musannaf Ibn Abi Shaybah 10414","","","كتاب الزكاة"
"10415","(۱۰۴۱۵) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرٍ ، عَنْ مَیْمُونٍ ، قَالَ : کَانَ یَسْتَحِبُّ أَنْ یُرْسِلَ بِالصَّدَقَۃِ إلَی أَبْنَائِ الْمُہَاجِرِینَ وَالأَنْصَارِ الَّذِینَ بِالْمَدِینَۃِ۔","","Musannaf Ibn Abi Shaybah 10415","","","كتاب الزكاة"
"10416","(۱۰۴۱۶) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، قَالَ : کَانَ طَاوُوس یَرَی أَنْ یَجْلِسَ الْمُصَدِّقُ ، فَإِنْ أُعْطِیَ شَیْئًا أَخَذَ ، وَإِنْ لَمْ یُعْطَ شَیْئًا سَکَتَ۔","","Musannaf Ibn Abi Shaybah 10416","","","كتاب الزكاة"
"10417","(۱۰۴۱۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ؛ أَنَّ شَیْخَیْنِ مِنْ أَشْجَعَ أَخْبَرَاہُ ، أَنَّ مُحَمَّدَ بْنَ مَسْلَمَۃَ الأَنْصَارِیَّ ، مِنْ أَصْحَابِ بَدْرٍ کَانَ یَقدم عَلَیْہِمْ فَیُصَدِّقُ مَاشِیَتَہُمْ فِی زَمَنِ عُمَرَ بْنِ الْخَطَّابِ ، فَکَانَ یَجْلِسُ ، فَمَنْ أَتَاہُ بِشَاۃٍ فِیہَا وَفَائً مِنْ حَقِّہِ قَبِلَہَا مِنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 10417","","","كتاب الزكاة"
"10418","(۱۰۴۱۸) حَدَّثَنَا حَفْصٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، عَنْ أَبِی حَارِثَۃَ ، قَالَ : بَعَثَنَا عُمَرُ مُصَدِّقِینَ ، فَکُنَّا إذَا أُوْتیْنَا بِشَیْئٍ فِیہِ وَفَائٌ مِنْ حَقِّنَا قَبِلْنَاہُ مِنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 10418","","","كتاب الزكاة"
"10419","(۱۰۴۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ رَجُلٍ ، عَنْ طَاوُوسٍ ، قَالَ : یَأْتِیہِمُ الْمُصَدِّقُ عَلَی مِیَاہِہِمْ ، وَلاَ یَسْتَحْلِفُہُمْ۔","","Musannaf Ibn Abi Shaybah 10419","","","كتاب الزكاة"
"10420","(۱۰۴۲۰) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ الْمُصَدِّقُ یَجِیئُ ، فَإِنْ رَأَی إبِلاً قَائِمَۃً وَغَنَمًا صَدَّقَہَا ، وَلَمْ یَنْتَظِرْ۔","","Musannaf Ibn Abi Shaybah 10420","","","كتاب الزكاة"
"10421","(۱۰۴۲۱) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : أَمَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِإِخْرَاجِ زَکَاۃِ الْفِطْرِ قَبْلَ الصَّلاَۃِ۔ (بخاری ۱۵۰۹۔ مسلم ۶۷۹)","","Musannaf Ibn Abi Shaybah 10421","","","كتاب الزكاة"
"10422","(۱۰۴۲۲) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُخْرِجُہَا قَبْلَ الصَّلاَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 10422","","","كتاب الزكاة"
"10423","(۱۰۴۲۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ (ح) وَعَنِ الْحَجَّاجِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ مِثْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 10423","","","كتاب الزكاة"
"10424","(۱۰۴۲۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إنَّ السُّنَّۃَ أَنْ یُخْرِجَ صَدَقَۃَ الْفِطْرِ قَبْلَ الصَّلاَۃِ۔ (دارقطنی ۷۰)","","Musannaf Ibn Abi Shaybah 10424","","","كتاب الزكاة"
"10425","(۱۰۴۲۵) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یُحِبُّ أَنْ یُخْرِجَ زَکَاۃَ الْفِطْرِ قَبْلَ أَنْ یَخْرُجَ إلَی الْجَبَّانَۃِ۔","","Musannaf Ibn Abi Shaybah 10425","","","كتاب الزكاة"
"10426","(۱۰۴۲۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِم بْن یَسَارٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یُعْطِی صَدَقَۃَ الْفِطْرِ قَبْلَ الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 10426","","","كتاب الزكاة"
"10427","(۱۰۴۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ؛ أَنَّہُ کَان یُخْرِجہَا قَبْلَ الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 10427","","","كتاب الزكاة"
"10428","(۱۰۴۲۸) حَدَّثَنَا غَسَّانُ بْنُ مُضَرَ ، عَنْ سَعِیدِ بْنِ یَزِیدَ ، قَالَ : کَانَ أَبُو نَضْرَۃَ یَقْعُدُ یَوْمَ الْفِطْرِ فِی مَسْجِدِ الْحَیِّ ، فَیُؤْتَی بِزَکوَاتِہِمْ وَیُرْسِلُ فِی مَنْ بَقِیَ ، فَیُؤْتَی بِزَکَاتِہِ فَیَقْسِمُہَا فِی فُقَرَائِ الْحَیِّ ، ثُمَّ یَخْرُجُ۔","","Musannaf Ibn Abi Shaybah 10428","","","كتاب الزكاة"
"10429","(۱۰۴۲۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : لاَ یَخْرُجُ الرَّجُلُ یَوْمَ الْفِطْرِ إلَی الْمُصَلَّی ، حَتَّی یُؤَدِّیَ صَدَقَۃَ الْفِطْرِ ، وَمَا عَلَی أَہْلِہِ۔","","Musannaf Ibn Abi Shaybah 10429","","","كتاب الزكاة"
"10430","(۱۰۴۳۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عِکْرِمَۃَ ، قَالَ : قَدِّمْ زَکَاتَکَ قَبْلَ صَلاَتِک۔","","Musannaf Ibn Abi Shaybah 10430","","","كتاب الزكاة"
"10431","(۱۰۴۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنِ الْحَکَمِ ، قَالَ : کَانُوا یَسْتَحِبُّونَ إخْرَاجَہَا قَبْلَ الصَّلاَۃِ ۔ وَقَالَ عَامِرٌ : إِنْ شَائَ عَجَّلَہَا ، وَإِنْ شَائَ أَخَّرَہَا۔","","Musannaf Ibn Abi Shaybah 10431","","","كتاب الزكاة"
"10432","(۱۰۴۳۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ یُعْطِی صَدَقَۃَ الْفِطْرِ بَعْدَ الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 10432","","","كتاب الزكاة"
"10433","(۱۰۴۳۳) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُطَرِّفٍ ، قَالَ : أَخْبَرَنِی خَتْنُ مُجَاہِدٍ ، عَنْ مُجَاہِدٍ ، قَالَ : صَدَقَۃُ الْفِطْرِ یَوْمَ الْفِطْرِ زَکَاۃٌ ، وَمَنْ أَعْطَاہَا بَعْدَ ذَلِکَ ، فَہِیَ صَدَقَۃٌ۔","","Musannaf Ibn Abi Shaybah 10433","","","كتاب الزكاة"
"10434","(۱۰۴۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ زُہَیْرٍ ، قَالَ : حدَّثَنَا أَبُو إِسْحَاقَ ، قَالَ : کَانَ أَبُو مَیْسَرَۃَ یُطْعِمُ بَعْد َمَا یُصَلِّی۔","","Musannaf Ibn Abi Shaybah 10434","","","كتاب الزكاة"
"10435","(۱۰۴۳۵) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، وَیَزِیدُ بْنُ ہَارُونَ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : فَرَضَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَدَقَۃَ الْفِطْرِ عَلَی کُلِّ حُرٍّ ، أَوْ عَبْدٍ ، صَغِیرٍ ، أَوْ کَبِیرٍ ، ذَکَرٍ ، أَوْ أُنْثَی ، صَاعًا مِنْ تَمْرٍ ، أَوْ شَعِیرٍ ، أَوْ نِصْفَ صَاعٍ مِنْ بُرٍّ۔ (ابوداؤد ۱۶۱۹۔ نسائی ۲۲۸۷)","Hasan","Musannaf Ibn Abi Shaybah 10435","","","كتاب الزكاة"
"10436","(۱۰۴۳۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ عُثْمَانَ ، قَالَ : صَاعٌ مِنْ تَمْرٍ ، أَوْ نِصْفُ صَاعٍ مِنْ بُرٍّ۔","","Musannaf Ibn Abi Shaybah 10436","","","كتاب الزكاة"
"10437","(۱۰۴۳۷) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : أَخْبَرَنِی مَنْ أَدَّی إلَی أَبِی بَکْرٍ صَدَقَۃَ الْفِطْرِ ، نِصْفُ صَاعٍ مِنْ طَعَامٍ۔","Da'if","Musannaf Ibn Abi Shaybah 10437","","","كتاب الزكاة"
"10438","(۱۰۴۳۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، یَرْفَعُہُ ؛ أَنَّہُ سُئِلَ عَنْ صَدَقَۃِ الْفِطْرِ ؟ فَقَالَ : عَنِ الصَّغِیرِ ، وَالْکَبِیرِ ، وَالْحُرِّ ، وَالْمَمْلُوکِ ، نِصْفُ صَاعٍ مِنْ بُرٍّ ، أَوْ صَاعٌ مِنْ تَمْرٍ، أَوْ شَعِیرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 10438","","","كتاب الزكاة"
"10439","(۱۰۴۳۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : صَدَقَۃُ الْفِطْرِ عَنِ الصَّغِیرِ ، وَالْکَبِیرِ ، وَالْحُرِّ ، وَالْعَبْدِ، عَنْ کُلِّ إنْسَانٍ نِصْفُ صَاعٍ مِنْ قَمْحٍ۔","","Musannaf Ibn Abi Shaybah 10439","","","كتاب الزكاة"
"10440","(۱۰۴۴۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : عَنْ کُلِّ إنْسَانٍ نِصْفُ صَاعٍ مِنْ قَمْحٍ ، وَمَنْ خَالَفَ الْقَمْحَ ، مِنْ تَمْرٍ ، أَوْ زَبِیبٍ ، أَوْ أَقِطٍ ، أَوْ شَعِیرٍ ، أَوْ غَیْرِہِ ، فَصَاعٌ تَامٌّ۔","","Musannaf Ibn Abi Shaybah 10440","","","كتاب الزكاة"
"10441","(۱۰۴۴۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ کَانَ یَقُولُ : صَدَقَۃُ الْفِطْرِ عَمَّنْ صَامَ مِنَ الأَحْرَارِ ، وَعَنِ الرَّقِیقِ مَنْ صَامَ مِنْہُمْ ، وَمَنْ لَمْ یَصُمْ ، نِصْفُ صَاعٍ مِنْ بُرٍّ ، أَوْ صَاعٌ مِنْ تَمْرٍ ، أَوْ شَعِیرٍ۔","","Musannaf Ibn Abi Shaybah 10441","","","كتاب الزكاة"
"10442","(۱۰۴۴۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ قَالَ مِثْلَ قَوْلِ الشَّعْبِیِّ فِیمَنْ لَمْ یَصُمْ مِنَ الأَحْرَارِ۔","","Musannaf Ibn Abi Shaybah 10442","","","كتاب الزكاة"
"10443","(۱۰۴۴۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ وَالأَسْوَد ، عَنْ عَبْدِ اللہِ ، قَالَ : مُدَّانِ مِنْ قَمْحٍ ، أَوْ صَاعٌ مِنْ تَمْرٍ ، أَوْ شَعِیرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 10443","","","كتاب الزكاة"
"10444","(۱۰۴۴۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 10444","","","كتاب الزكاة"
"10445","(۱۰۴۴۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : نِصْفُ صَاعٍ مِنْ قَمْحٍ ، أَوْ صَاعٌ مِنْ تَمْرِ۔","","Musannaf Ibn Abi Shaybah 10445","","","كتاب الزكاة"
"10446","(۱۰۴۴۶) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ أَنَّہُ قَالَ : صَاعٌ مِنْ تَمْرٍ ، أَوْ صَاعٌ مِنْ شَعِیرٍ۔","","Musannaf Ibn Abi Shaybah 10446","","","كتاب الزكاة"
"10447","(۱۰۴۴۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : مُدَّانِ مِنْ قَمْحٍ ، أَوْ صَاعٌ مِنْ تَمْرٍ ، أَوْ شَعِیرٍ۔","","Musannaf Ibn Abi Shaybah 10447","","","كتاب الزكاة"
"10448","(۱۰۴۴۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرٍو ؛ أَنَّہُ سَمِعَ ابْنَ الزُّبَیْرِ وَہُوَ عَلَی الْمِنْبَرِ ، یَقُولُ : مُدَّانِ مِنْ قَمْحٍ ، أَوْ صَاعٌ مِنْ شَعِیرٍ ، أَوْ تَمْرٍ۔","","Musannaf Ibn Abi Shaybah 10448","","","كتاب الزكاة"
"10449","(۱۰۴۴۹) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ؛ أَنَّہُ سَأَلَ الْحَکَمَ ، وَحَمَّادًا ؟ فَقَالاَ : نِصْفُ صَاعِ حِنْطَۃٍ ۔ قَالَ : وَسَأَلْتُ عَبْدَ الرَّحْمَن بْنَ الْقَاسِمِ ، وَسَعْدَ بْنِ إبْرَاہِیمَ ؟ فَقَالاَ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 10449","","","كتاب الزكاة"
"10450","(۱۰۴۵۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ إِسْحَاقَ بْنِ سُلَیْمَانَ الشَّیْبَانِیِّ ، قَالَ : حدَّثَنِی أَبُو حَبِیبٍ ، قَالَ : سَأَلْتُ عَبْدَ اللہِ بْنَ شَدَّادٍ عَنْ صَدَقَۃِ الْفِطْرِ ؟ فَقَالَ : نِصْفُ صَاعٍ مِنْ حِنْطَۃٍ ، أَوْ دَقِیقٍ۔","","Musannaf Ibn Abi Shaybah 10450","","","كتاب الزكاة"
"10451","(۱۰۴۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ عَلِیٍّ ؛ فِی صَدَقَۃِ الْفِطْرِ صَاعٌ مِنْ تَمْرٍ ، أَوْ صَاعٌ مِنْ شَعِیرٍ ، أَوْ نِصْفُ صَاعٍ مِنْ بُرٍّ۔","Sahih","Musannaf Ibn Abi Shaybah 10451","","","كتاب الزكاة"
"10452","(۱۰۴۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ فَاطِمَۃَ ، عَنْ أَسْمَائَ ؛ أَنَّہَا کَانَتْ تُعْطِی زَکَاۃَ الْفِطْرِ عَمَّنْ تَمُونُ مِنْ أَہْلِہَا الشَّاہِدِ ، وَالْغَائِبِ ، نِصْفُ صَاعٍ مِنْ بُرٍّ ، أَوْ صَاعٌ مِنْ تَمْرٍ ، أَوْ شَعِیرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 10452","","","كتاب الزكاة"
"10453","(۱۰۴۵۳) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ عَوْفٍ، قَالَ: سَمِعْتُ کِتَابَ عُمَرَ بْنِ عَبْدِالْعَزِیزِ إلَی عَدِیٍّ یُقْرَأُ بِالْبَصْرَۃِ فِی صَدَقَۃِ رَمَضَانَ: عَلَی کُلِّ صَغِیرٍ، أَوَ کَبِیرٍ ، حُرٍّ ، أَوْ عَبْدٍ ، ذَکَرٍ ، أَوْ أُنْثَی ، نِصْفُ صَاعٍ مِنْ بُرٍّ ، أَوْ صَاعٌ مِنْ تَمْرٍ۔","","Musannaf Ibn Abi Shaybah 10453","","","كتاب الزكاة"
"10454","(۱۰۴۵۴) حَدَّثَنَا عَبْدُ الرَّحِیم بْنُ سُلَیْمَانَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: الصَّدَقَۃُ صَاعٌ مِنْ تَمْرٍ، أَوْ نِصْفُ صَاعٍ مِنْ طَعَامٍ۔","","Musannaf Ibn Abi Shaybah 10454","","","كتاب الزكاة"
"10455","(۱۰۴۵۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الضَّحَّاکِ بْنِ عُثْمَانَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : فَرَضَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَدَقَۃَ الْفِطْرِ ، صَاعًا مِنْ تَمْرٍ ، أَوْ صَاعًا مِنْ شَعِیرٍ ۔ قَالَ : وَکَانَ ابْنُ عُمَرَ یُعْطِیہِ عَمَّنْ یَعُولُ مِنْ نِسَائِہِ ، وَمَمَالِیکِ نِسَائِہِ ، إِلاَّ عَبْدَیْنِ کَانَا مُکَاتَبَیْنِ ، فَإِنَّہُ لَمْ یَکُنْ یُعْطِی عَنْہُمَا۔ (بخاری ۱۵۰۳۔ مسلم ۱۲)","Sahih","Musannaf Ibn Abi Shaybah 10455","","","كتاب الزكاة"
"10456","(۱۰۴۵۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَر ، قَالَ : فَرَضَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَدَقَۃَ الْفِطْرِ : صَاعًا مِنْ تَمْرٍ ، أَوْ صَاعًا مِنْ شَعِیرٍ ، عَلَی کُلِّ عَبْدٍ ، أَوْ حُرٍّ صَغِیرٍ ، أَوْ کَبِیرٍ۔ (بخاری ۱۵۱۲۔ ابوداؤد ۱۶۰۹)","Sahih","Musannaf Ibn Abi Shaybah 10456","","","كتاب الزكاة"
"10457","(۱۰۴۵۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ عَجْلاَنَ ، عَنِ ابْنِ أَبِی سَرْحٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ؛ فِی صَدَقَۃِ الْفِطْرِ ، قَالَ : إنِّی وَاللَّہِ لاَ أُخْرِجُ إِلاَّ مَا کُنَّا نُخْرِجُ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَاعًا مِنْ تَمْرٍ ، أَوْ صَاعًا مِنْ شَعِیرٍ ، أَوْ صَاعَ زَبِیبٍ ، أَوْ صَاعَ أَقِطٍ۔ (بخاری ۱۵۰۶۔ ابوداؤد ۱۶۱۲)","Hasan","Musannaf Ibn Abi Shaybah 10457","","","كتاب الزكاة"
"10458","(۱۰۴۵۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَد ، عَنْ عَائِشَۃَ ، قَالَتْ : أحبَّ إِلَیَّ أَنَّ إذَا وَسَّعَ اللَّہُ عَلَی النَّاسِ ، أَنْ یُتِمُّوا صَاعًا مِنْ قَمْحٍ عَنْ کُلِّ إنْسَانٍ۔","Sahih","Musannaf Ibn Abi Shaybah 10458","","","كتاب الزكاة"
"10459","(۱۰۴۵۹) حَدَّثَنَا جَرِیرٌ ، عَنْ عَاصِمٍ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : عَنْ کُلِّ إنْسَانٍ صَاعٌ مِنْ قَمْحٍ فِی صَدَقَۃِ الْفِطْرِ۔","","Musannaf Ibn Abi Shaybah 10459","","","كتاب الزكاة"
"10460","(۱۰۴۶۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ: سَمِعْتُ مَسْرُوقًا یَقُولُ: صَدَقَۃُ الْفِطْرِ: صَاعٌ ، صَاعٌ۔","","Musannaf Ibn Abi Shaybah 10460","","","كتاب الزكاة"
"10461","(۱۰۴۶۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : سَمِعْتُ أَبَا عَبْدِ الرَّحْمَنِ یَقُولُ : صَاعٌ ، صَاعٌ ، عَنْ کُلِّ صَغِیرٍ ، وَکَبِیرٍ مَکْتُوبٍ۔","","Musannaf Ibn Abi Shaybah 10461","","","كتاب الزكاة"
"10462","(۱۰۴۶۲) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : کَتَبَ إلَیْنَا ابْنُ الزُّبَیْرِ : {بِئْسَ الْاِسْمُ الْفُسُوقُ بَعْدَ الإِیمَانِ} صَدَقَۃُ الْفِطْرِ : صَاعٌ ، صَاعٌ۔","Sahih","Musannaf Ibn Abi Shaybah 10462","","","كتاب الزكاة"
"10463","(۱۰۴۶۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : صَدَقَۃُ الْفِطْرِ عَنِ الصَّغِیرِ ، وَالْکَبِیرِ ، وَالْحُرِّ ، وَالْمَمْلُوکِ ، وَالذَّکَرِ ، وَالأُنْثَی ، قَالَ : إِنْ کَانُوا یُعْطُونَ حَتَّی یُعْطُونَ عَنِ الْحَبْلِ۔","","Musannaf Ibn Abi Shaybah 10463","","","كتاب الزكاة"
"10464","(۱۰۴۶۴) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ ، وَأَبِی الْعَالِیَۃِ ، وَابْنِ سِیرِینَ قَالُوا : صَدَقَۃُ الْفِطْرِ عَنِ الصَّغِیرِ، وَالْکَبِیرِ ، وَالْحُرِّ ، وَالْعَبْدِ ، وَالشَّاہِدِ ، وَالْغَائِبِ ، وَالذَّکَرِ ، وَالأُنْثَی ، وَالْغَنِیِّ ، وَالْفَقِیرِ۔","","Musannaf Ibn Abi Shaybah 10464","","","كتاب الزكاة"
"10465","(۱۰۴۶۵) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ أَبِی إِسْحَاقَ، عَنِ الْحَارِثِ، عَنْ عَلِیٍّ، قَالَ: ہِیَ عَلَی مَنْ أَطَاقَ الصَّوْمَ۔","Da'if","Musannaf Ibn Abi Shaybah 10465","","","كتاب الزكاة"
"10466","(۱۰۴۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ عَلِیٍّ ، قَالَ : صَدَقَۃُ الْفِطْرِ عَلَی مَنْ تُجْرِی عَلَیْہِ نَفَقَتُک۔","Sahih","Musannaf Ibn Abi Shaybah 10466","","","كتاب الزكاة"
"10467","(۱۰۴۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَسْتَحِبُّ التَّمْرَ فِی زَکَاۃِ الْفِطْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 10467","","","كتاب الزكاة"
"10468","(۱۰۴۶۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : تُجْزِئُ فِی صَدَقَۃِ الْفِطْرِ الْحِنْطَۃُ ، وَالشَّعِیرُ ، وَالتَّمْرُ ، وَالزَّبِیبُ ، وَالسُّلْتُ ، وَشَکَّ فِی الدَّقِیقِ وَالسَّوِیقِ ، وَقَالَ : مِنْ کُلِّ ہَذَا سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 10468","","","كتاب الزكاة"
"10469","(۱۰۴۶۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ عَوْفٍ، قَالَ : سَمِعْتُ کِتَابَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ یُقْرَأُ إلَی عَدِیٍّ بِالْبَصْرَۃِ : یُؤْخَذُ مِنْ أَہْلِ الدِّیوَانِ مِنْ أَعْطِیَّاتِہِمْ ، عَنْ کُلِّ إنْسَانٍ نِصْفُ دِرْہَمٍ۔","","Musannaf Ibn Abi Shaybah 10469","","","كتاب الزكاة"
"10470","(۱۰۴۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ قُرَّۃَ ، قَالَ : جَائَنَا کِتَابُ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ فِی صَدَقَۃِ الْفِطْرِ : نِصْفُ صَاعٍ عَنْ کُلِّ إنْسَانٍ ، أَوْ قِیمَتُہُ نِصْفُ دِرْہَمٍ۔","","Musannaf Ibn Abi Shaybah 10470","","","كتاب الزكاة"
"10471","(۱۰۴۷۱) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ أَنْ تُعْطِیَ الدَّرَاہِمَ فِی صَدَقَۃِ الْفِطْرِ۔","","Musannaf Ibn Abi Shaybah 10471","","","كتاب الزكاة"
"10472","(۱۰۴۷۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ زُہَیْرٍ ، قَالَ : سَمِعْتُ أَبَا إِسْحَاقَ یَقُولُ : أَدْرَکْتُہُمْ وَہُمْ یُعْطُونَ فِی صَدَقَۃِ رَمَضَانَ ، الدَّرَاہِمَ بِقِیمَۃِ الطَّعَامِ۔","","Musannaf Ibn Abi Shaybah 10472","","","كتاب الزكاة"
"10473","(۱۰۴۷۳) حَدَّثَنَا عُمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَرِہَ أَنْ یُعْطِیَ فِی صَدَقَۃِ الْفِطْرِ وَرِقًا۔","","Musannaf Ibn Abi Shaybah 10473","","","كتاب الزكاة"
"10474","(۱۰۴۷۴) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَمْرِو بْنِ مُہَاجِرٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : سَمِعْتُہ یَقُولُ : یُؤَدِّی الرَّجُلُ الْمُسْلِمُ عَنْ مَمْلُوکِہِ النَّصْرَانِیِّ صَدَقَۃَ الْفِطْرِ۔","","Musannaf Ibn Abi Shaybah 10474","","","كتاب الزكاة"
"10475","(۱۰۴۷۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ دَاوُد ، عَنِ الأَوْزَاعِیِّ ، قَالَ : بَلَغَنِی عَنِ ابْنِ عُمَرَ أَنَّہُ کَانَ یُعْطِی عَنْ مَمْلُوکِہِ النَّصْرَانِیِّ صَدَقَۃَ الْفِطْرِ۔","","Musannaf Ibn Abi Shaybah 10475","","","كتاب الزكاة"
"10476","(۱۰۴۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ثَوْرٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی، قَالَ: کَتَبَ إلَی عَطَائٍ یَسْأَلُہُ عَنْ عَبِیدِ یَہُودٍ وَنَصَارَی، أُطْعِمُ عَنْہُمْ زَکَاۃَ الْفِطْرِ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 10476","","","كتاب الزكاة"
"10477","(۱۰۴۷۷) حَدَّثَنَا ابْنُ عَیَّاشٍ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ مِثْلَ قَوْلِ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ۔","","Musannaf Ibn Abi Shaybah 10477","","","كتاب الزكاة"
"10478","(۱۰۴۷۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ عَطَائٌ : إذَا کَانَ لَکَ عَبِیدٌ نَصَارَی لاَ یُدَارُونَ ، یَعْنِی لِلتِّجَارَۃِ ، فَزَکِّ عَنْہُمْ یَوْمَ الْفِطْرِ۔","","Musannaf Ibn Abi Shaybah 10478","","","كتاب الزكاة"
"10479","(۱۰۴۷۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ الْحَارِثِ بْنِ أَبِی ذُبَابٍ ، عَنْ نَافِعٍ ؛ أَنَّ ابْنَ عُمَرَ کَانَ یُعْطِی عَنْ غِلْمَانٍ لَہُ فِی أَرْضِ عُمَرَ الصَّدَقَۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 10479","","","كتاب الزكاة"
"10480","(۱۰۴۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ فَاطِمَۃَ ، عَنْ أَسْمَائَ ؛ أَنَّہَا کَانَتْ تُعْطِی صَدَقَۃَ الْفِطْرِ عَمَّنْ تَمُونُ مِنْ أَہْلِہَا ؛ الشَّاہِدِ وَالْغَائِبِ۔","Sahih","Musannaf Ibn Abi Shaybah 10480","","","كتاب الزكاة"
"10481","(۱۰۴۸۱) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ قُسَیْطٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، وَسَعِیدِ بْنِ الْمُسَیَّبِ ، وَعَطَائِ بْنِ یَسَارٍ ، وَأَبِی سَلَمَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، قَالُوا : مَنْ کَانَ لَہُ عَبْدٌ فِی زَرْعٍ ، أَوْ ضَرْعٍ ، فَعَلَیْہِ صَدَقَۃُ الْفِطْرِ","","Musannaf Ibn Abi Shaybah 10481","","","كتاب الزكاة"
"10482","(۱۰۴۸۲) وَرُوِیَ عَنْ أَبِی إِسْحَاقَ ، قَالَ : حدَّثَنِی نَافِعٌ ؛ أَنَّ عَبْدَ اللہِ بْنَ عُمَرَ کَانَ یُخْرِجُ صَدَقَۃَ الْفِطْرِ عَنْ أَہْلِ بَیْتِہِ کُلِّہِمْ ؛ حُرِّہِمْ وَعَبْدِہِمْ ، صَغِیرِہِمْ وَکَبِیرِہِمْ ، وَمُسْلِمِہِمْ وَکَافِرِہِمْ مِنَ الرَّقِیقِ۔","","Musannaf Ibn Abi Shaybah 10482","","","كتاب الزكاة"
"10483","(۱۰۴۸۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یُعْطِی عَنْ عُمَّالِ أَرْضِہِ۔","","Musannaf Ibn Abi Shaybah 10483","","","كتاب الزكاة"
"10484","(۱۰۴۸۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : ہَلْ عَلَی غُلاَمِ مَاشِیَۃٍ ، أَوْ حَرْثٍ زَکَاۃٌ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 10484","","","كتاب الزكاة"
"10485","(۱۰۴۸۵) حَدَّثَنَا حَفْصٌ، عَنْ عَاصِمٍ، عَنْ أَبِی الْعَالِیَۃِ، وَالشَّعْبِیِّ، وَابْنِ سِیرِینَ، قَالُوا: ہِیَ عَلَی الشَّاہِدِ وَالْغَائِبِ۔","","Musannaf Ibn Abi Shaybah 10485","","","كتاب الزكاة"
"10486","(۱۰۴۸۶) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی أُمَیَّۃُ بْنُ أَبِی عُثْمَانَ ، عَنْ أُمَیَّۃَ بْنِ عَبْدِ اللہِ ؛ أَنَّ نَافِعَ بْنَ عَلْقَمَۃَ کَتَبَ إلَی عَبْدِ الْمَلِکِ بْنِ مَرْوَانَ یَسْأَلُہُ عَنِ الْعَبْدِ فِی الْحَائِطِ وَالْمَاشِیَۃِ ، عَلَیْہِ زَکَاۃُ یَوْمِ الْفِطْرِ ؟ قَالَ : لاَ ، مِنْ أَجْلِ أَنَّ الْحَائِطَ وَالْمَاشِیَۃَ الَّذِی ہُوَ فِیہَا إنَّمَا صَدَّقْتَ بِہِ ، فَلَیْسَ عَلَیْہِ زَکَاۃٌ۔","","Musannaf Ibn Abi Shaybah 10486","","","كتاب الزكاة"
"10487","(۱۰۴۸۷) حَدَّثَنَا حَفْصٌ، عَنِ الضَّحَّاکِ بْنِ عُثْمَانَ، عَنْ نَافِعٍ، عَ[corrupt]ِ ابْنِ عُمَرَ، قَالَ: کَانَ لَہُ مُکَاتَبَانِ فَلَمْ یُعْطِ عَنْہُمَا۔","Hasan","Musannaf Ibn Abi Shaybah 10487","","","كتاب الزكاة"
"10488","(۱۰۴۸۸) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَرَی عَنِ الْمُکَاتَبِ صَدَقَۃَ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 10488","","","كتاب الزكاة"
"10489","(۱۰۴۸۹) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : بَلَغَنِی أَنَّ مَیْمُونًا کَانَ یُؤَدِّی عَنِ الْمُکَاتَبِ صَدَقَۃَ الْفِطْرِ۔","","Musannaf Ibn Abi Shaybah 10489","","","كتاب الزكاة"
"10490","(۱۰۴۹۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إِنْ کَانَ مُکَاتَبًا وَطَرَحَ عَنْ نَفْسِہِ فَقَد کَفَی نَفْسَہُ ، وَإِنْ لَمْ یَطْرَحْ عَنْ نَفْسِہِ فَیُطْعِم عَنْہُ سَیِّدُہُ۔","","Musannaf Ibn Abi Shaybah 10490","","","كتاب الزكاة"
"10491","(۱۰۴۹۱) حَدَّثَنَا ابْنُ الدَّرَاوَرْدِیِّ ، عَنْ مُوسَی بْنِ عُقْبَۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ لاَ یَرَی عَلَی الْمُکَاتَبِ زَکَاۃَ الْفِطْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 10491","","","كتاب الزكاة"
"10492","(۱۰۴۹۲) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : یُعْطِی کُلَّ قَوْمٍ بِصَاعِ أَہْلِ الْمَدِینَۃِ۔","","Musannaf Ibn Abi Shaybah 10492","","","كتاب الزكاة"
"10493","(۱۰۴۹۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُثْمَانَ بْنِ الأَسْوَد ، عَنْ مُجَاہِدٍ ، قَالَ : بِالْمُدِّ الَّذِی تَقُوتُ بِہِ أَہْلَک۔","","Musannaf Ibn Abi Shaybah 10493","","","كتاب الزكاة"
"10494","(۱۰۴۹۴) حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، قَالَ : کَانَ سَالِمٌ یُخْرِجُ زَکَاۃَ الْفِطْرِ بِصَاعِ السُّوقِ یَوْمَئِذٍ قَبْلَ أَنْ یَغْدُوَ ، وَلاَ یُخْرِجُ إِلاَّ تَمْرًا۔","","Musannaf Ibn Abi Shaybah 10494","","","كتاب الزكاة"
"10495","(۱۰۴۹۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ، قَالَ : یُعْطِی کُلُّ قَوْمٍ بِصَاعِہِمْ۔","","Musannaf Ibn Abi Shaybah 10495","","","كتاب الزكاة"
"10496","(۱۰۴۹۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، أَوْ عَنْ فَاطِمَۃَ ، عَنْ أَسْمَائَ ، قَالَتْ : بِالْمُدِّ وَالصَّاعِ الَّذِی یَمْتَارُونَ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 10496","","","كتاب الزكاة"
"10497","(۱۰۴۹۷) حَدَّثَنَا عُمَر ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إِنْ أَعْطَیْتَ بِمُدِّ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَجْزَأَ عَنْک ، وَإِنْ أَعْطَیْتَ بِالْمُدِّ الَّذِی تَقُوتُ بِہِ أَہْلَک أَجْزَأَ عَنْک۔","","Musannaf Ibn Abi Shaybah 10497","","","كتاب الزكاة"
"10498","(۱۰۴۹۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ عَطَائٌ : أَحَبُّ إلَیَّ أَنْ تُعْطِیَ بِمِکْیَالِکَ الْیَوْمَ بِمِکْیَالٍ تَأْخُذُ بِہِ وَتَقْتَاتُ بِہِ۔","","Musannaf Ibn Abi Shaybah 10498","","","كتاب الزكاة"
"10499","(۱۰۴۹۹) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ أَشْعَثَ ، عَنْ جَعْفَرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَصَدَّقُوا إِلاَّ عَلَی أَہْلِ دِینِکُمْ ، فَأَنْزَلَ اللَّہُ تَعَالَی : {لَیْسَ عَلَیْک ہُدَاہُمْ} ، إلَی قَوْلِہِ : {وَمَا تُنْفِقُوا مِنْ خَیْرٍ یُوَفَّ إلَیْکُمْ} ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَصَدَّقُوا عَلَی أَہْلِ الأَدْیَانِ۔ (نسائی ۱۱۰۵۲۔ حاکم ۲۸۵)","Da'if","Musannaf Ibn Abi Shaybah 10499","","","كتاب الزكاة"
"10500","(۱۰۵۰۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ سَالِمٍ الْمَکِّیِّ ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، قَالَ : کَرِہَ النَّاسُ أَنْ یَتَصَدَّقُوا عَلَی الْمُشْرِکِینَ ، فَأَنْزَلَ اللَّہُ تَعَالَی : {لَیْسَ عَلَیْک ہُدَاہُمْ} ، قَالَ : فَتَصَدَّقَ النَّاسُ عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 10500","","","كتاب الزكاة"
"10501","(۱۰۵۰۱) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ: لاَ تَصَدَّقْ عَلَی یَہُودِیٍّ ، وَلاَ نَصْرَانِیٍّ إِلاَّ أَنْ لاَ تَجِدَ غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 10501","","","كتاب الزكاة"
"10502","(۱۰۵۰۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الزِّبْرِقَانِ السَّرَّاجِ ، عَنْ أَبِی رَزِینٍ ، قَالَ : کُنْتُ مَعَ شَقِیق بْنِ سَلَمَۃَ ، فَمَرَّ عَلَیْہِ أُسَارَی مِنَ الْمُشْرِکِینَ فَأَمَرَنِی أَنْ أَتَصَدَّقَ عَلَیْہِمْ ، ثُمَّ تَلاَ ہَذِہِ الآیَۃَ : {وَیُطْعِمُونَ الطَّعَامَ عَلَی حُبِّہِ مِسْکِینًا وَیَتِیمًا وَأَسِیرًا}۔","","Musannaf Ibn Abi Shaybah 10502","","","كتاب الزكاة"
"10503","(۱۰۵۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عِکْرِمَۃَ ، قَالَ : أَطْعِمْہُ ، وَلاَ تُعْطِہِ نَفَقَتَہُ۔","","Musannaf Ibn Abi Shaybah 10503","","","كتاب الزكاة"
"10504","(۱۰۵۰۴) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ أَبِی إِسْحَاقَ، عَنْ أَبِی مَیْسَرَۃَ؛ أَنَّہُ کَانَ یُعْطِی الرُّہْبَانَ مِنْ صَدَقَۃِ الْفِطْرِ۔","","Musannaf Ibn Abi Shaybah 10504","","","كتاب الزكاة"
"10505","(۱۰۵۰۵) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عِکْرِمَۃَ ، قَالَ : لاَ تَصَدَّقْ عَلَی الْیَہُودِی وَالنَّصْرَانِیِّ بِنَفَقَۃٍ۔","","Musannaf Ibn Abi Shaybah 10505","","","كتاب الزكاة"
"10506","(۱۰۵۰۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ (ح) وَعَنْ حجَّاج ، عَنْ عَطَائٍ ؛ {وَیُطْعِمُونَ الطَّعَامَ عَلَی حُبِّہِ مِسْکِینًا وَیَتِیمًا وَأَسِیرًا} ، قَالاَ : مِنْ أَہْلِ الْقِبْلَۃِ وَغَیْرِہِمْ۔","","Musannaf Ibn Abi Shaybah 10506","","","كتاب الزكاة"
"10507","(۱۰۵۰۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عُمَرَ بْنِ نَافِعٍ ، عَنْ أَبِی بَکْرٍ الْعَبْسِیِّ ، عَنْ عُمَرَ ؛ فِی قولہ تعالی : {إنَّمَا الصَّدَقَات لِلْفُقَرَائِ} ، قَالَ : ہُمْ زَمْنَی أَہْلِ الْکِتَابِ۔","Da'if","Musannaf Ibn Abi Shaybah 10507","","","كتاب الزكاة"
"10508","(۱۰۵۰۸) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، وَطَاوُسٍ ؛ أَنَّہُمَا کَرِہَا الصَّدَقَۃَ عَلَی النَّصْرَانِیِّ۔","","Musannaf Ibn Abi Shaybah 10508","","","كتاب الزكاة"
"10509","(۱۰۵۰۹) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ عُثْمَانَ الْبَتِّیِّ ، عَنِ الْحَسَنِ ؛ فِی قولہ تعالی : {وَیُطْعِمُونَ الطَّعَامَ عَلَی حُبِّہِ مِسْکِینًا وَیَتِیمًا وَأَسِیرًا} قَالَ : الأَسْرَی مِنْ أَہْلِ الشِّرْکِ۔","","Musannaf Ibn Abi Shaybah 10509","","","كتاب الزكاة"
"10510","(۱۰۵۱۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَبِیبُ بْنُ أَبِی حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : سُئِلَ عَنِ الصَّدَقَۃِ فِی مَنْ تُوضَعُ ؟ فَقَالَ : فِی أَہْلِ الْمَسْکَنَۃِ مِنَ الْمُسْلِمِینَ وَأَہْلِ ذِمَّتِہِمْ ، وَقَالَ : قَدْ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُقْسِمُ فِی أَہْلِ الذِّمَّۃِ مِنَ الصَّدَقَۃِ وَالْخُمُسِ۔ (ابوعبید ۱۹۹۲۔ ابن زنجویہ ۲۲۹۱)","","Musannaf Ibn Abi Shaybah 10510","","","كتاب الزكاة"
"10511","(۱۰۵۱۱) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، قَالَ: سَأَلْتُ إبْرَاہِیمَ عَنِ الصَّدَقَۃِ عَلَی غَیْرِ أَہْلِ الإِسْلاَمِ؟ فَقَالَ : أَمَّا الزَّکَاۃُ فَلاَ ، وَأَمَّا إِنْ شَائَ رَجُلٌ أَنْ یَتَصَدَّقَ ، فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 10511","","","كتاب الزكاة"
"10512","(۱۰۵۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ تُعْطِہِمْ مِنَ الزَّکَاۃِ ، وَأَعْطِہِمْ مِنَ التَّطَوُّعِ۔","","Musannaf Ibn Abi Shaybah 10512","","","كتاب الزكاة"
"10513","(۱۰۵۱۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ إیَاسٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یُعْطَی الْمُشْرِکُونَ مِنَ الزَّکَاۃِ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 10513","","","كتاب الزكاة"
"10514","(۱۰۵۱۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ رَجُلٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : لاَ تُعْطِ الْیَہُودِیَّ وَالنَّصْرَانِیَّ مِنَ الزَّکَاۃِ ، وَلاَ ب[corrupt]أْسَ أَنْ تََتَصَدَّقَ عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 10514","","","كتاب الزكاة"
"10515","(۱۰۵۱۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ إسْمَاعِیلَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یُعْطَی الْمُشْرِکُونَ مِنَ الزَّکَاۃِ ، وَلاَ مِنْ شَیْئٍ مِنَ الْکَفَّارَاتِ۔","","Musannaf Ibn Abi Shaybah 10515","","","كتاب الزكاة"
"10516","(۱۰۵۱۶) حَدَّثَنَا جَرِیرٌ ، عَنْ أَشْعَثَ ، عَنْ جَعْفَرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : یُعْطَی مِنَ الزَّکَاۃِ مَنْ لَہُ الدَّارُ وَالْخَادِمُ وَالْفَرَسُ۔","","Musannaf Ibn Abi Shaybah 10516","","","كتاب الزكاة"
"10517","(۱۰۵۱۷) حَدَّثَنَا شَرِیکٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا لاَ یَمْنَعُونَ الزَّکَاۃَ مَنْ لَہُ الْبَیْتُ وَالْخَادِمُ۔","","Musannaf Ibn Abi Shaybah 10517","","","كتاب الزكاة"
"10518","(۱۰۵۱۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ لاَ یَرَی بَأْسًا أَنْ یُعْطَی مِنْہَا مَنْ لَہُ الْخَادِمُ وَالْمَسْکَنُ ، إذَا کَانَ مُحْتَاجًا۔","","Musannaf Ibn Abi Shaybah 10518","","","كتاب الزكاة"
"10519","(۱۰۵۱۹) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ شَبِیبِ بْنِ عَبْدِ الْمَلِکِ ، قَالَ : سَأَلْتُ مُقَاتِلَ بْنَ حَیَّانَ عَنْ رَجُلٍ فِی الدِّیوَانِ لَہُ عَطَائٌ وَفَرَسٌ ، وَہُوَ مُحْتَاجٌ ، أُعْطِیہ مِنَ الزَّکَاۃِ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 10519","","","كتاب الزكاة"
"10520","(۱۰۵۲۰) حَدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ بَعْضِ أَصْحَابِہِ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَشْتَرِیَ مِنْ زَکَاۃِ مَالِہِ رَقَبَۃً یُعْتِقُہَا۔","","Musannaf Ibn Abi Shaybah 10520","","","كتاب الزكاة"
"10521","(۱۰۵۲۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَرِہَ أَنْ یَشْتَرِیَ مِنَ الزَّکَاۃِ رَقَبَۃً یُعْتِقُہَا۔","","Musannaf Ibn Abi Shaybah 10521","","","كتاب الزكاة"
"10522","(۱۰۵۲۲) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ أَنَّہُ کَرِہَ أَنْ یَشْتَرِیَ مِنَ الزَّکَاۃِ رَقَبَۃً یُعْتِقُہَا۔","","Musannaf Ibn Abi Shaybah 10522","","","كتاب الزكاة"
"10523","(۱۰۵۲۳) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا ہُرَیْمٌ ، وَجَعْفَرٌ الأَحْمَر ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لاَ تُعْتِقْ مِنَ الزَّکَاۃِ ۔ زَادَ جَعْفَرٌ : مَخَافَۃَ جَرِّ الْوَلاَئِ۔","","Musannaf Ibn Abi Shaybah 10523","","","كتاب الزكاة"
"10524","(۱۰۵۲۴) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ بْنِ سَوَّارٍ ، قَالَ : سُئِلَ الْحَسَنُ عَنْ رَجُلٍ اشْتَرَی أَبَاہُ مِنَ الزَّکَاۃِ فَأَعْتَقَہُ ؟ قَالَ : اشْتَرَی خَیْرَ الرِّقَابِ۔","","Musannaf Ibn Abi Shaybah 10524","","","كتاب الزكاة"
"10525","(۱۰۵۲۵) حَدَّثَنَا أَبُو جَعْفَرٍ ، عَنِ الأَعْمَشِ ، عَنْ حَسَّانَ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُعْطِی الرَّجُلُ مِنْ زَکَاتِہِ فِی الْحَجِّ ، وَأَنْ یُعْتِقَ مِنْہَا النَّسَمَۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 10525","","","كتاب الزكاة"
"10526","(۱۰۵۲۶) حَدَّثَنَا حَفْصٌ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَمْرِو بْنِ دِینَارٍ، قَالَ: قَالَ عُمَرُ: إذَا أَعْطَیْتُمْ فَأَغْنُوا۔ یَعْنِی: مِنَ الصَّدَقَۃِ۔","","Musannaf Ibn Abi Shaybah 10526","","","كتاب الزكاة"
"10527","(۱۰۵۲۷) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یُعْطُوا مِنَ الزَّکَاۃِ مَا یَکُونُ رَأْسَ المَالِ۔","","Musannaf Ibn Abi Shaybah 10527","","","كتاب الزكاة"
"10528","(۱۰۵۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْحَسَنِ بْنِ عُمَرَ أَبِی حَمْزَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُسْتَحَبُّ أَنْ یَسُدَّ بِہَا حَاجَۃَ أَہْلِ الْبَیْتِ ، یَعْنِی بِالزَّکَاۃِ۔","","Musannaf Ibn Abi Shaybah 10528","","","كتاب الزكاة"
"10529","(۱۰۵۲۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ، عَنْ سُفْیَانَ، عَنِ أَبِی حَیَّانَ، عَنِ الضَّحَّاکِ، قَالَ: یُعْطَی مِنْہَا مَا بَیْنَہُ وَبَیْنَ الْمِئَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 10529","","","كتاب الزكاة"
"10530","(۱۰۵۳۰) حَدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنِ الرَّبِیعِ بْنِ حَبِیبٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : یُعْطَی مِنْہَا مَا بَیْنَہُ وَبَیْنَ الْمِئَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 10530","","","كتاب الزكاة"
"10531","(۱۰۵۳۱) حَدَّثَنَا عُمَرُ بْنُ زُرْعَۃَ ، عَنِ ابْنِ سَالِمٍ ، عَنْ عَامِرٍ ، قَالَ : أَعْطِ مِنَ الزَّکَاۃِ مَا دُونَ أَنْ یَحِلَّ عَلَی مَنْ تُعْطِیہِ الزَّکَاۃَ۔","","Musannaf Ibn Abi Shaybah 10531","","","كتاب الزكاة"
"10532","(۱۰۵۳۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنِ الْحَجَّاجِ ، عَنِ الْحَسَنِ بْنِ سَعْدٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، وَعَبْدِ اللہِ، قَالاَ : لاَ تَحِلُّ الصَّدَقَۃُ لِمَنْ لَہُ خَمْسُونَ دِرْہَمًا ، أَوْ عَرْضُہَا مِنَ الذَّہَبِ۔","Da'if","Musannaf Ibn Abi Shaybah 10532","","","كتاب الزكاة"
"10533","(۱۰۵۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَکِیمِ بْنِ جُبَیْرٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بن یَزِیدَ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ سَأَلَ وَلَہُ مَا یُغْنِیہِ کَانَ خُدُوشًا ، أَوْ کُدُوحًا یَوْمَ الْقِیَامۃِ ، قِیلَ : یَا رَسُولَ اللہِ ، وَمَا غِنَاؤُہُ ؟ قَالَ : خَمْسُونَ دِرْہَمًا ، أَوْ حِسَابُہَا مِنَ الذَّہَبِ۔ (ترمذی ۶۵۱۔ ابوداؤد ۱۶۲۳)","Da'if","Musannaf Ibn Abi Shaybah 10533","","","كتاب الزكاة"
"10534","(۱۰۵۳۴) حَدَّثَنَا حَفْصٌ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یُعْطَی مِنَ الزَّکَاۃِ مَنْ لَہُ خَمْسُونَ دِرْہَمًا ، وَلاَ یُعْطَی مِنْہَا أَکْثَرَ مِنْ خَمْسِینَ دِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 10534","","","كتاب الزكاة"
"10535","(۱۰۵۳۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : کَانَ سُفْیَانُ ، وَحَسَنٌ ، یَقُولاَنِ : لاَ یُعْطَی مِنْہَا مَنْ لَہُ خَمْسُونَ دِرْہَمًا ، وَلاَ یُعْطَی مِنْہَا أَکْثَرَ مِنْ خَمْسِینَ ، إِلاَّ أَنْ یَکُونَ عَلَیْہِ دَیْنٌ فَیُقْضَی دَیْنُہُ ، وَیُعْطَی بَعْدَ خَمْسِینَ۔","","Musannaf Ibn Abi Shaybah 10535","","","كتاب الزكاة"
"10536","(۱۰۵۳۶) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ مِسْعَرٍ ، قَالَ : سَمِعْتُ حَمَّادًا یَقُولُ : مَنْ لَمْ یَکُنْ عِنْدَہُ مَالٌ یَبْلُغُ فِیہِ الزَّکَاۃَ، أُعْطِیَ مِنَ الزَّکَاۃِ۔","","Musannaf Ibn Abi Shaybah 10536","","","كتاب الزكاة"
"10537","(۱۰۵۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْحَسَنِ ، عَنْ عَمْرٍو ، عَنْ فُضَیْلٍ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ عَنْ أَصْحَابِ الأَہْوَائِ ؟ قَالَ : مَا کَانُوا یَسْأَلُونَ إِلاَّ عَنِ الْحَاجَۃِ۔","","Musannaf Ibn Abi Shaybah 10537","","","كتاب الزكاة"
"10538","(۱۰۵۳۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنِ الْحَجَّاجِ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ طَاوُوسٍ ، قَالَ : بَعَثَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُعَاذًا إلَی الْیَمَنِ ، وَأَمَرَہُ أَنْ یَأْخُذَ الصَّدَقَۃَ مِنَ الْحِنْطَۃِ ، وَالشَّعِیرِ ۔ فَأَخَذَ الْعُرُوضَ الثِّیَابَ مِنَ الْحِنْطَۃِ وَالشَّعِیرِ۔","","Musannaf Ibn Abi Shaybah 10538","","","كتاب الزكاة"
"10539","(۱۰۵۳۹) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ؛ أَنَّ عُمَرَ کَانَ یَأْخُذُ الْعُرُوضَ فِی الصَّدَقَۃِ مِنَ الْوَرِقِ وَغَیْرِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 10539","","","كتاب الزكاة"
"10540","(۱۰۵۴۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ طَاوُوسٍ ، قَالَ : قَالَ مُعَاذٌ : ائْتُونِی بِخَمِیس ، أَوْ لَبِیسٍ آخذ مِنْکُمْ۔","","Musannaf Ibn Abi Shaybah 10540","","","كتاب الزكاة"
"10541","(۱۰۵۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ طَاوُوسٍ ؛ أَنَّ مُعَاذًا کَانَ یَأْخُذُ الْعُرُوضَ فِی الصَّدَقَۃِ۔","","Musannaf Ibn Abi Shaybah 10541","","","كتاب الزكاة"
"10542","(۱۰۵۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی سِنَانٍ ، عَنْ عَنْتَرَۃَ ؛ أَنَّ عَلِیًّا کَانَ یَأْخُذُ الْعُرُوضَ فِی الْجِزْیَۃِ مِنْ أَہْلِ الإِبَرِ الإِبَرَ، وَمِنْ أَہْلِ الْمَسالِّ الْمَسالَّ ، وَمِنْ أَہْلِ الْحِبَالِ الْحِبَالَ۔","Sahih","Musannaf Ibn Abi Shaybah 10542","","","كتاب الزكاة"
"10543","(۱۰۵۴۳) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ: کَانُوا یَسْتَحِبُّونَ زَکَاۃَ کُلِّ شَیْئٍ مِنْہُ ؛ الْوَرِقُ مِنَ الْوَرِقِ، وَالذَّہَبُ مِنَ الذَّہَبِ ، وَالْبَقَرُ مِنَ الْبَقَرِ ، وَالْغَنَمُ مِنَ الْغَنَمِ۔","","Musannaf Ibn Abi Shaybah 10543","","","كتاب الزكاة"
"10544","(۱۰۵۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَرِہَ الْعَرْضَ فِی الصَّدَقَۃِ۔","","Musannaf Ibn Abi Shaybah 10544","","","كتاب الزكاة"
"10545","(۱۰۵۴۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سَمِعْتُ ابْنَ أَبِی نَجِیحٍ ، یَزْعُمُ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ فِی صَدَقَۃِ التَّمْرِ : أَنْ یُؤْخَذَ الْبَرْنِیُّ مِنَ الْبَرْنِیِّ ، وَاللَّوْنُ مِنَ اللَّوْنِ ، وَلاَ یُؤْخَذُ اللَّوْنُ مِنَ الْبَرْنِیِّ۔","","Musannaf Ibn Abi Shaybah 10545","","","كتاب الزكاة"
"10546","(۱۰۵۴۶) حَدَّثَنَا حَفْصٌ ، وَأَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنِ الْمِنْہَالِ ، عَنْ زِرٍّ ، عَنْ حُذَیْفَۃَ ، قَالَ : إِنْ أَعْطَاہَا فِی صِنْفٍ وَاحِدٍ مِنَ الأَصْنَافِ الثَمَانِیَۃِ الَّتِی سَمَّی اللَّہُ تَعَالَی أَجْزَأَہُ۔","","Musannaf Ibn Abi Shaybah 10546","","","كتاب الزكاة"
"10547","(۱۰۵۴۷) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، قَالَ : قَالَ حُذَیْفَۃُ : إذَا وَضَعْتَ فِی أَیِّ الأَصْنَافِ شِئْتَ ، أَجْزَأَکَ إذَا لَمْ تَجِدْ غَیْرَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 10547","","","كتاب الزكاة"
"10548","(۱۰۵۴۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، أَوْ غَیْرِہِ ، عَنِ الْمِنْہَالِ ، عَنْ زِرٍّ ، عَنْ حُذَیْفَۃَ ، قَالَ : إِنْ جَعَلَہَا فِی صِنْفٍ وَاحِدٍ أَجْزَأَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 10548","","","كتاب الزكاة"
"10549","(۱۰۵۴۹) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ؛ أَنَّ عُمَرَ کَانَ یَأْخُذُ الْعَرْضَ فِی الصَّدَقَۃِ ، وَیُعْطِیہَا فِی صِنْفٍ وَاحِدٍ مِمَّا سَمَّی اللَّہُ تَعَالَی۔","Da'if","Musannaf Ibn Abi Shaybah 10549","","","كتاب الزكاة"
"10550","(۱۰۵۵۰) حَدَّثَنَا جَرِیرٌ ، عَنْ عَطَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ (ح) وَعَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالاَ : یُجْزِئکَ أَنْ تَضَعَ الصَّدَقَۃَ فِی صِنْفٍ مِنَ الأَصْنَافِ الَّتِی سَمَّی اللَّہُ تَعَالَی۔","","Musannaf Ibn Abi Shaybah 10550","","","كتاب الزكاة"
"10551","(۱۰۵۵۱) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ أَبِی جَعْفَرٍ ، عَنِ الرَّبِیعِ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : لاَ بَأْسَ أَنْ تَجْعَلَہَا فِی صِنْفٍ وَاحِدٍ مِمَا قَالَ اللَّہُ تَعَالَی۔","","Musannaf Ibn Abi Shaybah 10551","","","كتاب الزكاة"
"10552","(۱۰۵۵۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : سَأَلْتُہُ : أُعْطِی الصَّدَقَۃَ فِی صِنْفٍ وَاحِدٍ مِنَ الأَصْنَافِ الثَمَانِیَۃِ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 10552","","","كتاب الزكاة"
"10553","(۱۰۵۵۳) حَدَّثَنَا وَکِیعٌ، عَنْ یَزِیدَ، عَنِ الْحَسَنِ، قَالَ: لاَ بَأْسَ أَنْ تَجْعَلَہَا فِی صِنْفٍ وَاحِدٍ مِنَ الأَصْنَافِ الثَمَانِیَۃِ۔","","Musannaf Ibn Abi Shaybah 10553","","","كتاب الزكاة"
"10554","(۱۰۵۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ تَجْعَلَہَا فِی صِنْفٍ وَاحِدٍ مِمَّا سَمَّی اللَّہُ تَعَالَی۔","","Musannaf Ibn Abi Shaybah 10554","","","كتاب الزكاة"
"10555","(۱۰۵۵۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : صَرِّفْہَا فِی الأَصْنَافِ ۔ وَقَالَ الْحَسَنُ : فِی أَیِّہَا وَضَعْتَ أَجْزَأَکَ۔","","Musannaf Ibn Abi Shaybah 10555","","","كتاب الزكاة"
"10556","(۱۰۵۵۶) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرٍ ، عَنْ مَیْمُونٍ ، قَالَ : سَمِعْتُہُ یَقُولُ : لَوْ وَضَعْتُ الزَّکَاۃَ فِی ہَذَیْنِ الصِّنْفَیْنِ ؛ الْفُقَرَائِ وَالْمَسَاکِینِ لَرَأَیْتُ أَنَّ ذَلِکَ یُجْزِء عَنِّی۔","","Musannaf Ibn Abi Shaybah 10556","","","كتاب الزكاة"
"10557","(۱۰۵۵۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی سَلَمَۃَ ، أَنْ أَبَا عَمْرِو بْنَ حِمَاسٍ أَخْبَرَہُ ، أَنَّ أَبَاہُ حِمَاسًا کَانَ یَبِیعُ الأَدَمَ وَالْجِعَابَ ، وَأَنَّ عُمَرَ قَالَ لَہُ : یَا حِمَاسُ ، أَدِّ زَکَاۃَ مَالَک ، فَقَالَ : وَاللَّہِ مَا لِی مَالٌ ، إنَّمَا أَبِیعُ الأَدَمَ وَالْجِعَابَ ، فَقَالَ : قَوِّمْہُ وَأَدِّ زَکَاتَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 10557","","","كتاب الزكاة"
"10558","(۱۰۵۵۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، وَعَبْدَۃُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی سَلَمَۃَ ، عَنْ أَبِی عَمْرِو بْنِ حِمَاسٍ ، أَنَّ أَبَاہُ حِمَاسًا کَانَ یَبِیعُ الأَدَمَ وَالْجِعَابَ ، وَأَنَّ عُمَرَ قَالَ لَہُ : ثُمَّ ذَکَرَ مِثْلَہُ ، أَوْ نَحْوَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 10558","","","كتاب الزكاة"
"10559","(۱۰۵۵۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ اشْتَرَی مَتَاعًا فَحَلَّتْ فِیہِ الزَّکَاۃُ ؟ فَقَالَ : یُزَکِّیہ بِقِیمَتِہِ یَوْمَ حَلَّتْ۔","","Musannaf Ibn Abi Shaybah 10559","","","كتاب الزكاة"
"10560","(۱۰۵۶۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لَیْسَ فِی الْعُرُوضِ زَکَاۃٌ ، إِلاَّ عُرْضٍ فِی تِجَارَۃٍ ، فَإِنَّ فِیہِ زَکَاۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 10560","","","كتاب الزكاة"
"10561","(۱۰۵۶۱) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ، عَنْ أَبِی ہِلاَلٍ، عَنِ ابْنِ سِیرِینَ، قَالَ فِی الْمَتَاعِ: یُقَوَّمُ، ثُمَّ تُؤَدَّی زَکَاتُہُ۔","","Musannaf Ibn Abi Shaybah 10561","","","كتاب الزكاة"
"10562","(۱۰۵۶۲) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَشْتَرِی الْمَتَاعَ فَیَمْکُثُ السِّنِینَ ، یُزَکِّیِہِ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 10562","","","كتاب الزكاة"
"10563","(۱۰۵۶۳) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ طَلْحَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کُلُّ شَیْئٍ أُرِیدَ بِہِ التِّجَارَۃُ فَفِیہِ الزَّکَاۃُ ، وَإِنْ کَانَ لَبَنًا ، أَوْ طِینًا ۔ قَالَ : وَکَانَ الْحَکَمُ یَرَی ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 10563","","","كتاب الزكاة"
"10564","(۱۰۵۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَمَّدِ بْنِ عُقْبَۃَ ، عَنِ الْقَاسِمِ ، قَالَ : کَانَ أَبُو بَکْرٍ إذَا أَعْطَی النَّاسَ الْعَطَائَ سَأَلَ الرَّجُلَ : أَلَکَ مَالٌ ؟ فَإِنْ قَالَ : نَعَمْ ، زَکَّی مَالَہُ مِنْ عَطَائِہِ ، وَإِلاَّ سَلَّمَ لَہُ عَطَائَہُ۔","","Musannaf Ibn Abi Shaybah 10564","","","كتاب الزكاة"
"10565","(۱۰۵۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہُبَیْرَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : کَانَ یُعْطِینَا العَطَائَ فِی الرَّسَلِ فَنُزَکِّیِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 10565","","","كتاب الزكاة"
"10566","(۱۰۵۶۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہُبَیْرَۃَ ، قَالَ : کَانَ ابْنُ مَسْعُودٍ یُزَکِّی أَعْطِیَّاتِہِمْ مِنْ کُلِّ أَلْفٍ خَمْسَۃً وَعِشْرِینَ۔","Hasan","Musannaf Ibn Abi Shaybah 10566","","","كتاب الزكاة"
"10567","(۱۰۵۶۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدٍ الْقَارِی ، وَکَانَ عَلَی بَیْتِ الْمَالِ فِی زَمَنِ عُمَرَ مَعَ عَبْدِ اللہِ بْنِ الأَرْقَمِ ، فَکَانَ إِذَا خَرَجَ الْعَطَائُ جَمَعَ عُمَرُ أَمْوَالَ التِّجَارَۃِ ، فَحَسَبَ عَاجِلَہَا وَآجِلَہَا ، ثُمَّ یَأْخُذُ الزَّکَاۃَ مِنَ الشَّاہِدِ وَالْغَائِبِ۔","Sahih","Musannaf Ibn Abi Shaybah 10567","","","كتاب الزكاة"
"10568","(۱۰۵۶۸) حَدَّثَنَا بِشْرُ بْنُ الْمُفَضَّلِ ، عَنْ مُحَمَّدِ بْنِ عُقْبَۃَ ، عَنِ الْقَاسِمِ ، قَالَ : کَانَ أَبُو بَکْرٍ إذَا أَعْطَی الرَّجُلَ الْعَطَائَ سَأَلَہُ ، ثُمَّ ذَکَرَ نَحْوَ حَدِیثِ وَکِیعٍ۔","","Musannaf Ibn Abi Shaybah 10568","","","كتاب الزكاة"
"10569","(۱۰۵۶۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، وَوَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ مُخَارِقٍ ، عَنْ طَارِقٍ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ کَانَ یُعْطِیہِمُ الْعَطَائَ وَلاَ یُزَکِّیہِ۔","Sahih","Musannaf Ibn Abi Shaybah 10569","","","كتاب الزكاة"
"10570","(۱۰۵۷۰) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : رَأَیْتُ الأُمَرَائَ إذَا أُعْطَوُا الْعَطَائَ زَکَّوْہُ۔","","Musannaf Ibn Abi Shaybah 10570","","","كتاب الزكاة"
"10571","(۱۰۵۷۱) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ، عَنْ عُمَرَ بْنِ عَبْدِالْعَزِیزِ؛ أَنَّہُ کَانَ یُزَکِّی الْعَطَائَ وَالْجَائِزَۃَ۔","","Musannaf Ibn Abi Shaybah 10571","","","كتاب الزكاة"
"10572","(۱۰۵۷۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ بَعْضِ أَصْحَابِہِ ، عَنِ ابْنِ مَسْعُودٍ ؛ أَنَّہُ کَانَ یُعْطِی الْعَطَائَ وَیُزَکِّیہِ۔","Da'if","Musannaf Ibn Abi Shaybah 10572","","","كتاب الزكاة"
"10573","(۱۰۵۷۳) حَدَّثَنَا حَفْصٌ ، عَنِ الْحَجَّاجِ ، عَنِ الْحَکَمِ ، عَنِ ابْنِ عَبَّاسٍ (ح) وَعَنْ سَالِمٍ ، عَنِ ابْنِ الْحَنَفِیَّۃِ ؛ فِی قولہ تعالی : {وَآتُوا حَقَّہُ یَوْمَ حَصَادِہِ} قَالاَ : نَسَخَتْہَا الْعُشْرُ وَنِصْفُ الْعُشْرِ۔","","Musannaf Ibn Abi Shaybah 10573","","","كتاب الزكاة"
"10574","(۱۰۵۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ شِبَاکٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : نَسَخَتْہَا الْعُشْرُ وَنِصْفُ الْعُشْرِ۔","","Musannaf Ibn Abi Shaybah 10574","","","كتاب الزكاة"
"10575","(۱۰۵۷۵) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ عَاصِمٍ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : کَانُوا یُعْطُونَ شَیْئًا غَیْرَ الصَّدَقَۃِ۔","","Musannaf Ibn Abi Shaybah 10575","","","كتاب الزكاة"
"10576","(۱۰۵۷۶) حَدَّثَنَا ابْنُ الْمُبَارَکِ ، عَنْ مُحَمَّدِ بْنِ سُلَیْمَانَ ، عَنْ حَیَّانَ الأَعْرَجِ ، عَنْ جَابِرِ بْنِ زَیْدٍ ؛فِی قولہ تعالی : {وَآتُوا حَقَّہُ یَوْمَ حَصَادِہِ}قَالَ : الزَّکَاۃُ۔","","Musannaf Ibn Abi Shaybah 10576","","","كتاب الزكاة"
"10577","(۱۰۵۷۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ إبْرَاہِیمَ بْنِ نَافِعٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : الزَّکَاۃُ۔","","Musannaf Ibn Abi Shaybah 10577","","","كتاب الزكاة"
"10578","(۱۰۵۷۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، وَنَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ {وَآتُوا حَقَّہُ یَوْمَ حَصَادِہِ} قَالَ : کَانُوا یُعْطُونَ مَن اعْتَرَاہم شَیئًا سِوَی الصَّدَقَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 10578","","","كتاب الزكاة"
"10579","(۱۰۵۷۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ عَطَاء ؛ فِی قولہ : {وَآتُوا حَقَّہُ یَوْمَ حَصَادِہِ} قَالَ : مَنْ حَضَرَک یَوْمَئِذٍ أَنْ تُعْطِیَہُ الْقَبَضَاتِ ، وَلَیْسَ بِزَکَاۃٍ۔","","Musannaf Ibn Abi Shaybah 10579","","","كتاب الزكاة"
"10580","(۱۰۵۸۰) حَدَّثَنَا جَرِیرٌ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ؛ فِی قولہ تعالی : {وَآتُوا حَقَّہُ یَوْمَ حَصَادِہِ} قَالَ : إذَا حَصَدْتَہُ فَحَضَرَک الْمَسَاکِینُ طَرَحْتَ لَہُمْ مِنْہُ ، وَإِذَا طَبَنْتَہُ طَرَحْتَ لَہُمْ مِنْہُ ، وَإِذَا کَدَّسْتَہُ طَرَحْتَ لَہُمْ مِنْہُ ، وَإِذَا نَقَّیْتَہُ وَأَخَذْتَ فِی کَیْلِہِ حَثَوْتَ لَہُمْ مِنْہُ ، وَإِذَا عَلِمْتَ کَیْلَہُ عَزَلْتَ زَکَاتَہُ ، وَإِذَا أَخَذْتَ فِی جُذَاذِ النَّخْلِ طَرَحْتَ لَہُمْ مِنَ الثَّفَارِیقِ وَالتَّمْرِ ، وَإِذَا أَخَذْتَ فِی کَیْلِہِ حَثَوْت لَہُمْ مِنْہُ ، وَإِذَا عَلِمْتَ کَیْلَہُ عَزَلْتَ زَکَاتَہُ۔n (۱۰۵۸۰ م) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ فِی قولہ تعالی : {وَآتُوا حَقَّہُ یَوْمَ حَصَادِہِ} قَالَ: زَکَاتُہُ یَوْمَ کَیْلِہِ۔","","Musannaf Ibn Abi Shaybah 10580","","","كتاب الزكاة"
"10581","(۱۰۵۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ السُّدِّیِّ ، قَالَ : ہَذِہِ مَدَنِیَّۃٌ مَکِّیَّۃٌ ، نَسَخَتْہَا الْعُشْرُ وَنِصْفُ الْعُشْرِ ، قُلْتُ : عَمَّنْ ؟ قَالَ : عَنِ الْفُقَہَائِ ۔ یَعْنِی قَوْلَہُ تَعَالَی : {وَآتُوا حَقَّہُ یَوْمَ حَصَادِہِ}۔","","Musannaf Ibn Abi Shaybah 10581","","","كتاب الزكاة"
"10582","(۱۰۵۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ (ح) وَعَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالاَ : {وَآتُوا حَقَّہُ یَوْمَ حَصَادِہِ} قَالاَ : یُعْطِی ضِغْثًا۔","","Musannaf Ibn Abi Shaybah 10582","","","كتاب الزكاة"
"10583","(۱۰۵۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : نَحْوَ الضِّغْثِ۔","","Musannaf Ibn Abi Shaybah 10583","","","كتاب الزكاة"
"10584","(۱۰۵۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : نَسَخَتْہَا الزَّکَاۃُ۔","","Musannaf Ibn Abi Shaybah 10584","","","كتاب الزكاة"
"10585","(۱۰۵۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سَلَمَۃَ ، عَنِ الضَّحَّاکِ ، قَالَ : نَسَخَتِ الزَّکَاۃُ کُلَّ صَدَقَۃٍ فِی الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 10585","","","كتاب الزكاة"
"10586","(۱۰۵۸۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ عَطِیَّۃَ ، قَالَ : نَسَخَتْہَا الْعُشْرُ ، وَنِصْفُ الْعُشْرِ۔","","Musannaf Ibn Abi Shaybah 10586","","","كتاب الزكاة"
"10587","(۱۰۵۸۷) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ؛ فِی قَوْلِہِ تَعَالَی : {وَآتُوا حَقَّہُ یَوْمَ حَصَادِہِ} قَالَ: زَکَاتُہُ یَوْمَ کَیْلِہِ۔","","Musannaf Ibn Abi Shaybah 10587","","","كتاب الزكاة"
"10588","(۱۰۵۸۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنْ حَجَّاجٍ، عَنِ الْحَکَمِ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ؛ {وَآتُوا حَقَّہُ یَوْمَ حَصَادِہِ} نَسَخَتْہَا الْعُشْرُ ، وَنِصْفُ الْعُشْرِ۔","","Musannaf Ibn Abi Shaybah 10588","","","كتاب الزكاة"
"10589","(۱۰۵۸۹) حَدَّثَنَا حَفْصٌ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : یُخْرِجُ مَکَانَہَا۔","","Musannaf Ibn Abi Shaybah 10589","","","كتاب الزكاة"
"10590","(۱۰۵۹۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ أَصْحَابِہِ قَالُوا : إذَا أَخْرَجَ زَکَاۃَ مَالِہِ فَضَاعَتْ ، فَلْیُزَکِّ مَرَّۃً أُخْرَی۔","","Musannaf Ibn Abi Shaybah 10590","","","كتاب الزكاة"
"10591","(۱۰۵۹۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ مَعْمَرٍ ، عَنْ حَمَّادٍ ؛ فِی الرَّجُلِ یَبْعَثُ بِصَدَقَتِہِ فَتَہْلِکُ قَبْلَ أَنْ تَصِلَ إلَی أَہْلِہَا ، قَالَ : ہِیَ بِمَنْزِلَۃِ رَجُلٍ بَعَثَ إلَی غَرِیمِہِ بِدَیْنٍ ، فَلَمْ یَصِلْ إلَیْہِ الْمَالُ حَتَّی ہَلَکَ۔","","Musannaf Ibn Abi Shaybah 10591","","","كتاب الزكاة"
"10592","(۱۰۵۹۲) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : لاَ تُجْزِیئُ۔","","Musannaf Ibn Abi Shaybah 10592","","","كتاب الزكاة"
"10593","(۱۰۵۹۳) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ حَسَّانَ بْنِ إبْرَاہِیمَ ، عَنْ إبْرَاہِیمَ الصَّائِغِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ إذَا أَخْرَجَ زَکَاۃَ مَالِہِ فَضَاعَتْ ، أَنَّہَا تُجْزِیئُ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 10593","","","كتاب الزكاة"
"10594","(۱۰۵۹۴) حَدَّثْنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ أَخْرَجَ زَکَاۃَ مَالِہِ فَضَاعَتْ ، قَالَ : لاَ تُجْزِیئُ عَنْہُ حَتَّی یَضَعَہَا مَوَاضِعَہَا۔","","Musannaf Ibn Abi Shaybah 10594","","","كتاب الزكاة"
"10595","(۱۰۵۹۵) حَدَّثَنَا أَبُو بَحْرٍ الْبَکْرَاوِیُّ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : یُخْرِجُ مَکَانَہَا۔","","Musannaf Ibn Abi Shaybah 10595","","","كتاب الزكاة"
"10596","(۱۰۵۹۶) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْن جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عَمْرُو بْنُ دِینَارٍ ، عَنْ طَاوُوسٍ قَالاَ : إذَا کَانَ الْخَلِیطَانِ یَعْمَلاَنِ فِی أَمْوَالِہِمَا ، فَلاَ تُجْمَعُ أَمْوَالُہُمَا فِی الصَّدَقَۃِ۔","","Musannaf Ibn Abi Shaybah 10596","","","كتاب الزكاة"
"10597","(۱۰۵۹۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرْت عَطَائً عَنْ قَوْلِ طَاوُوس ، فَقَالَ : مَا أُرَاہُ إِلاَّ حَقًّا۔","","Musannaf Ibn Abi Shaybah 10597","","","كتاب الزكاة"
"10598","(۱۰۵۹۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، أَنَّہُ کَانَ یَقُولُ : إذَا کَانَ لِلرَّجُلِ عِشْرُونَ شَاۃ ، وَلِرَجُلٍ آخَر عِشْرُونَ شَاۃ ، وَرَاعِیہِمَا وَاحِدٌ ، یَشْرَعَانِ مَعًا وَیَرِدَانِ مَعًا ، قَالَ : فِیہَا الزَّکَاۃُ۔","","Musannaf Ibn Abi Shaybah 10598","","","كتاب الزكاة"
"10599","(۱۰۵۹۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ یَزِیدَ مَوْلَی سَلَمَۃَ ، قَالَ : کَانَ یُعْرَضُ عَلَی سَلَمَۃَ صَدَقَۃُ إبِلِہِ فَیَأْبَی أَنْ یَشْتَرِیَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 10599","","","كتاب الزكاة"
"10600","(۱۰۶۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ مُسْلِمِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ تَشْتَرِی طُہرَۃَ مَالِک۔","Da'if","Musannaf Ibn Abi Shaybah 10600","","","كتاب الزكاة"
"10601","(۱۰۶۰۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی أَبُو الزُّبَیْرِ ، أَنَّہُ سَمِعَ جَابِرًا یَقُولُ : إذَا جَائَ الْمُصَدِّقُ فَادْفَعْ إلَیْہِ صَدَقَتَکَ ، وَلاَ تَبْتَعْہَا ، قَالَ : فَإِنَّہُمَ یَقُولُونَ ابْتَعْہَا فَأَقُولُ : لاَ ، إنَّمَا ہِیَ لِلَّہِ۔","Sahih","Musannaf Ibn Abi Shaybah 10601","","","كتاب الزكاة"
"10602","(۱۰۶۰۲) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : سَأَلْتُہُ : أَیَشْتَرِی الرَّجُلُ صَدَقَتَہُ ؟ فَقَالَ : لاَ یَشْتَرِیہَا مِنَ الْمُصَدِّقِ حَتَّی یُخْرِجَہَا ، وَلاَ یَشْتَرِیہَا إذَا أَخْرَجَہَا حَتَّی تَخْتَلِطَ بِغَنَمٍ کَثِیرٍ۔","","Musannaf Ibn Abi Shaybah 10602","","","كتاب الزكاة"
"10603","(۱۰۶۰۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّ مَنْ مَضَی کَانُوا یَکْرَہُونَ ابْتِیَاعَ صَدَقَاتِہِمْ ، قَالَ : وَإِنْ فَعَلْتَ بَعْدَ مَا تُقْبَضَ مِنْک فَلاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 10603","","","كتاب الزكاة"
"10604","(۱۰۶۰۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن أَبِیہِ ، قَالَ : حُمِلَ عُمَرُ عَلَی فَرَسٍ فِی سَبِیلِ اللہِ فَرَآہُ ، أَوْ شَیْئًا مِنْ ثِیَابِہِ تُبَاعُ فِی السُّوقِ ، فَأَرَادَ أَنْ یَشْتَرِیَہُ فَسَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَقَالَ : اُتْرُکْہُ حَتَّی تُوَافِیَک یَوْمَ الْقِیَامَۃِ۔ (مسلم ۱۲۳۹۔ احمد ۱/۲۵)","","Musannaf Ibn Abi Shaybah 10604","","","كتاب الزكاة"
"10605","(۱۰۶۰۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرٍ ، عَنِ الزُّبَیْرِ بْنِ الْعَوَّامِ ؛ أَنَّ رَجُلاً حَمَلَ عَلَی فَرَسٍ فِی سَبِیلِ اللہِ ، فَرَأَی فَرَسًا ، أَوْ مُہْرَۃً تُبَاعُ یُنْسَبُ إلَی فَرَسِہِ ، فنہیَ عَنْہَا۔ (ابن ماجہ ۲۳۹۳۔ احمد ۱/۱۶۴)","Sahih","Musannaf Ibn Abi Shaybah 10605","","","كتاب الزكاة"
"10606","(۱۰۶۰۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیم (ح) وَعَنْ دَاوُدَ ، عَنْ أَبِی الْعَالِیَۃِ ؛ أَنَّ أَبَا أُسَامَۃَ حَمَلَ عَلَی مُہْرٍ لَہُ فِی سَبِیلِ اللہِ ، فَرَآہُ بَعْدَ ذَلِکَ نِضْوًا یُبَاعُ ، قَالَ : فَقُلْتُ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : قَدْ عَرَفْتُ عُرْفَہُ ، فَنَہَانِی عَنْہُ۔ (طبرانی ۴۶۶۸)","","Musannaf Ibn Abi Shaybah 10606","","","كتاب الزكاة"
"10607","(۱۰۶۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ عُمَرُ : إذَا تَحَوَّلَتِ الصَّدَقَۃُ إلَی غَیْرِ الَّذِی تُصُدِّقَ عَلَیْہِ ، فَلاَ بَأْسَ أَنْ یَشْتَرِیَہَا۔","Hasan","Musannaf Ibn Abi Shaybah 10607","","","كتاب الزكاة"
"10608","(۱۰۶۰۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ عُمَرَ حَمَلَ عَلَی فَرَسٍ فِی سَبِیلِ اللہِ ، فَرَآہَا فِی السُّوقِ تُبَاعُ ، فَسَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یَشْتَرِیَہَا ، فَقَالَ : لاَ ، دَعْہَا حَتَّی تُوَافِیَک یَوْمَ الْقِیَامَۃِ۔ (بخاری ۲۷۷۵۔ مسلم ۴)","Sahih","Musannaf Ibn Abi Shaybah 10608","","","كتاب الزكاة"
"10609","(۱۰۶۰۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنِ الشَّعْبِیِّ ، عَنْ زَیْدِ بْنِ حَارِثَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، نَحْوًا مِنْ حَدِیثِ أُسَامَۃَ۔","","Musannaf Ibn Abi Shaybah 10609","","","كتاب الزكاة"
"10610","(۱۰۶۱۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ؛ أَنَّہُ سُئِلَ عَنِ الرَّجُلِ یُصِیبُ مِنْ صَدَقَتِہِ ؟ قَالَ : یَنْقُصُ مِنْ أَجْرِہِ بِقَدْرِ مَا أَصَابَ مِنْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 10610","","","كتاب الزكاة"
"10611","(۱۰۶۱۱) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَہْضَمِ بْنِ عَبْدِ اللہِ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَن مُحَمَّدِ بْنِ زَیْدٍ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ شِرَائِ الصَّدَقَاتِ حَتَّی تُقْبَضَ۔ (ابن ماجہ ۲۱۹۶۔ دارقطنی ۴۴)","Da'if","Musannaf Ibn Abi Shaybah 10611","","","كتاب الزكاة"
"10612","(۱۰۶۱۲) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ طَاوُوسٍ ؛ سُئِلَ : أَیَشْتَرِی صَدَقَتَہُ قَبْلَ أَنْ تُعْقَلَ؟ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 10612","","","كتاب الزكاة"
"10613","(۱۰۶۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ الشُّعَیثیِّ ، عَنْ مَکْحُولٍ قَالَ : لاَ تُشْتَرَی الصَّدَقَۃُ حَتَّی تُوسَمَ وَتُعْقَلَ۔","","Musannaf Ibn Abi Shaybah 10613","","","كتاب الزكاة"
"10614","(۱۰۶۱۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ مَکْحُولٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تُشْتَرَی الصَّدَقَۃُ حَتَّی تُوسَمَ۔","","Musannaf Ibn Abi Shaybah 10614","","","كتاب الزكاة"
"10615","(۱۰۶۱۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ؛ أَنَّہُمَا کَرِہَا أَنْ یَشْتَرِیَ الرَّجُلُ شَیْئًا مِنْ صَدَقَۃِ مَالِہِ ، حَتَّی یَحُولَ مِنْ عِنْدِ الْمُصَدِّقِ۔","","Musannaf Ibn Abi Shaybah 10615","","","كتاب الزكاة"
"10616","(۱۰۶۱۶) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی أَبُو الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ أَنَّہُ سَمِعَہُ یَنْہَی عَنْ بَیْعِ الصَّدَقَۃِ قَبْلَ أَنْ تُخْرَج۔","Sahih","Musannaf Ibn Abi Shaybah 10616","","","كتاب الزكاة"
"10617","(۱۰۶۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی مُوسَی بْنُ عُقْبَۃَ ، عَنْ غَیْرِ وَاحِدٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی أَنْ تُبَاعَ الصَّدَقَۃُ حَتَّی تُعْقَلَ وَتُوسَمَ۔","","Musannaf Ibn Abi Shaybah 10617","","","كتاب الزكاة"
"10618","(۱۰۶۱۸) حَدَّثَنَا ابْن عُیَیْنَۃَ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ ، أَنَّ عُمَرَ سَأَلَ رَجُلاً عَنْ أَرْضٍ لَہُ بَاعَہَا ؟ فَقَالَ لَہُ : احْرُزْ مَالَک ، وَاحْفِرْ لَہُ تَحْتَ فِرَاشِ امْرَأَتِکَ ، قَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، أَلَیْسَ بِکَنْزٍ ؟ فَقَالَ : لَیْسَ بِکَنْزٍ مَا أُدِّیَ زَکَاتُہُ۔","","Musannaf Ibn Abi Shaybah 10618","","","كتاب الزكاة"
"10619","(۱۰۶۱۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ أَبِی حَرْمَلَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : مَا أُدِّیَ زَکَاتُہُ فَلَیْسَ بِکَنْزٍ۔","","Musannaf Ibn Abi Shaybah 10619","","","كتاب الزكاة"
"10620","(۱۰۶۲۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ، عَنْ حَجَّاجٍ، عَنْ أَبِی الزُّبَیْرِ، عَنْ جَابِرٍ، قَالَ: أَیُّ مَالٍ أُدِّیَ زَکَاتُہُ فَلَیْسَ بِکَنْزٍ۔","","Musannaf Ibn Abi Shaybah 10620","","","كتاب الزكاة"
"10621","(۱۰۶۲۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَنِ ابْنِ عُمَرَ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 10621","","","كتاب الزكاة"
"10622","(۱۰۶۲۲) حَدَّثَنَا وَکِیعٌ، عَنْ شَرِیکٍ، عَنْ أَبِی إِسْحَاقَ، عَنْ عِکْرِمَۃَ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: مَا أُدِّیَ زَکَاتُہُ فَلَیْسَ بِکَنْزٍ۔","Hasan","Musannaf Ibn Abi Shaybah 10622","","","كتاب الزكاة"
"10623","(۱۰۶۲۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حَنْظَلَۃَ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ قَالاَ : لَیْسَ مَالٌ بِکَنْزٍ أُدِّیَ زَکَاتُہُ ، وَإِنْ کَانَ تَحْتَ الأَرْضِ ، وَإِنْ کَانَ لاَ یُؤَدَّی زَکَاتُہُ فَہُوَ کَنْزٌ ، وَإِنْ کَانَ عَلَی وَجْہِ الأَرْضِ۔","","Musannaf Ibn Abi Shaybah 10623","","","كتاب الزكاة"
"10624","(۱۰۶۲۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَطِیَّۃَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : وُجِدَ لِرَجُلٍ عَشَرَۃُ آلاَفٍ بَعْدَ مَوْتِہِ مَدْفُونَۃً ، قَالَ : فَقَالُوا : ہَذَا کَنْزٌ ، مَا کَانَ یُؤَدِّی زَکَاتَہُ ، فَقَالَ ابْنُ عُمَرَ : لَعَلَّہُ کَانَ یُؤَدِّی عَنْہَا مِنْ غَیْرِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 10624","","","كتاب الزكاة"
"10625","(۱۰۶۲۵) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَرَوْنَ فِی أَمْوَالِہِمْ حَقًّا سِوَی الزَّکَاۃِ۔","","Musannaf Ibn Abi Shaybah 10625","","","كتاب الزكاة"
"10626","(۱۰۶۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، وَابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ؛ {فِی أَمْوَالِہِمْ حَقٌّ مَعْلُومٌ} ، قَالَ : سِوَی الزَّکَاۃِ۔","","Musannaf Ibn Abi Shaybah 10626","","","كتاب الزكاة"
"10627","(۱۰۶۲۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَیَانٍ ، عَنْ عَامِرٍ ، قَالَ : فِی الْمَالِ حَقٌّ سِوَی الزَّکَاۃِ۔","","Musannaf Ibn Abi Shaybah 10627","","","كتاب الزكاة"
"10628","(۱۰۶۲۸) حَدَّثَنَا مُعَاذٌ ، قَالَ : حدَّثَنَا حَاتِمُ بْنُ أَبِی صَغِیرَۃَ أَبُو یُونُسَ ، قَالَ : حَدَّثَنَا رِیَاحُ بنُ عَبِیْدَۃَ ، عَنْ قَزَعَۃَ ، قَالَ : قُلْتُ لِاِبْنِ عُمَرَ : إنَّ لِی مَالاً ، فَمَا تَأْمُرُنِی إلَی مَنْ أَدْفَعُ زَکَاتَہُ ؟ قَالَ : ادْفَعْہَا إلَی وَلِیِّ الْقَوْمِ ، یَعْنِی الأُمَرَائَ ، وَلَکِنْ فِی مَالِکَ حَقٌّ سِوَی ذَلِکَ یَا قَزَعَۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 10628","","","كتاب الزكاة"
"10629","(۱۰۶۲۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ أَبِی حَیَّانَ ، قَالَ : حدَّثَنِی مُزَاحِمُ بْنُ زُفَرَ ، قَالَ : کُنْتُ جَالِسًا عِنْدَ عَطَائٍ ، فَأَتَاہُ أَعْرَابِیٌّ فَسَأَلَہُ : إنَّ لِی إبِلاً ، فَہَلْ عَلَیَّ فِیہَا حَقٌّ بَعْدَ الصَّدَقَۃِ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 10629","","","كتاب الزكاة"
"10630","(۱۰۶۳۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ أَدَّی زَکَاۃَ مَالِہِ فَلَیْسَ عَلَیْہِ جُنَاحٌ أَنْ لاَ یَتَصَدَّقَ۔","Sahih","Musannaf Ibn Abi Shaybah 10630","","","كتاب الزكاة"
"10631","(۱۰۶۳۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : فِی الْمَالِ حَقٌّ سِوَی الزَّکَاۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 10631","","","كتاب الزكاة"
"10632","(۱۰۶۳۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : جَائَتِ امْرَأَۃُ عَبْدِ اللہِ إلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : إنَّ فِی حِجْرِی بَنِی أَخٍ لِی کَلاَلَۃً ، فَیُجْزِینِی أَنْ أَجْعَلَ زَکَاۃَ حُلِیِّی فِیہِمْ ؟ قَالَ : نَعَمْ۔ (بخاری ۱۴۶۶۔ مسلم ۴۵)","","Musannaf Ibn Abi Shaybah 10632","","","كتاب الزكاة"
"10633","(۱۰۶۳۳) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ أَنْ تَجْعَلَ زَکَاتَکَ فِی ذَوِی قَرَابَتِکَ ، مَا لَمْ یَکُونُوا فِی عِیَالِک۔","","Musannaf Ibn Abi Shaybah 10633","","","كتاب الزكاة"
"10634","(۱۰۶۳۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الْخَالِقِ الشَّیْبَانِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : إنَّ أَحَقَّ مَنْ دَفَعْتُ إلَیْہِ زَکَاتِی یَتِیمِی وَذُو قَرَابَتِی۔","","Musannaf Ibn Abi Shaybah 10634","","","كتاب الزكاة"
"10635","(۱۰۶۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ؛ أَنَّ امْرَأَتَہُ سَأَلَتْہُ عَنْ بَنِی أَخٍ لَہَا أَیْتَامٍ فِی حِجْرِہَا ، تُعْطِیہِمْ مِنَ الزَّکَاۃِ ؟ قَالَ : نَعَمْ۔","Hasan","Musannaf Ibn Abi Shaybah 10635","","","كتاب الزكاة"
"10636","(۱۰۶۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إِبْرَاہِیمَ بْنِ أَبِی حَفْصَۃَ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنِ الْخَالَۃِ ، تُعْطَی مِنَ الزَّکَاۃِ ؟ فَقَالَ سَعِید : مَا لَمْ یُغْلَقُ عَلَیْکُمْ بَابٌ۔","","Musannaf Ibn Abi Shaybah 10636","","","كتاب الزكاة"
"10637","(۱۰۶۳۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ ہِشَامٍ ، أَوْ غَیْرِہِ ، عَنِ الْحَسَنِ ؛ أَنَّہُمَا رَخَّصَا فِی ذِی الْقَرَابَۃِ۔","","Musannaf Ibn Abi Shaybah 10637","","","كتاب الزكاة"
"10638","(۱۰۶۳۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ ، قَالَ : قُلْتُ لِعَطَائٍ : أَیَجْزِی الرَّجُلَ أَنْ یَضَعَ زَکَاتَہُ فِی أَقَارِبِہِ ؟ قَالَ : نَعَمْ ، إذَا لَمْ یَکُونُوا فِی عِیَالِہِ۔","","Musannaf Ibn Abi Shaybah 10638","","","كتاب الزكاة"
"10639","(۱۰۶۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سَلَمَۃَ بْنِ نُبَیْطٍ ، عَنِ الضَّحَّاکِ ، قَالَ : إذَا کَانَ لَکَ أَقَارِبُ فُقَرَائُ فَہُمْ أَحَقُّ بِزَکَاتِکَ مِنْ غَیْرِہِمْ۔","","Musannaf Ibn Abi Shaybah 10639","","","كتاب الزكاة"
"10640","(۱۰۶۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زُبَیْدٍ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ عَنِ الأُخْتِ ، تُعْطَی مِنَ الزَّکَاۃِ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 10640","","","كتاب الزكاة"
"10641","(۱۰۶۴۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یُعْطِی زَکَاتَہُ ذَوِی قَرَابَتِہِ ؟ قَالَ : نَعَمْ ، مَا لَمْ یَکُونُوا فِی عِیَالِہِ۔","","Musannaf Ibn Abi Shaybah 10641","","","كتاب الزكاة"
"10642","(۱۰۶۴۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَنْظَلَۃَ ، عَنْ طَاوُوسٍ ، قَالَ: سَأَلَہُ رَجُلٌ ، فَقَالَ: إنَّ عِنْدِی نَاسًا مِنْ أَہْلِی فُقَرَائَ؟ فَقَالَ : أَخْرِجْہَا مِنْک وَمِنْ أَہْلِک۔","","Musannaf Ibn Abi Shaybah 10642","","","كتاب الزكاة"
"10643","(۱۰۶۴۳) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ ابْنَۃِ سِیرِینَ ، عَنْ أُمِّ الرَّائِحِ بِنْتِ صُلَیْعٍ ، عَنْ عَمِّہَا سَلْمَانَ بْنِ عَامِرٍ الضَّبِّیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الصَّدَقَۃُ عَلَی غَیْرِ ذِی الرَّحِمِ صَدَقَۃٌ ، وَعَلَی ذِی الرَّحِمِ اثْنَتَانِ ؛ صَدَقَۃٌ وَصِلَۃٌ۔ (ترمذی ۶۵۸۔ نسائی ۲۳۶۳)","Da'if","Musannaf Ibn Abi Shaybah 10643","","","كتاب الزكاة"
"10644","(۱۰۶۴۴) قَالَ أَبُو بَکْرٍ : وَسَمِعْتُ وَکِیعًا یَذْکُرُ ، عَنْ سُفْیَانَ ، أَنَّہُ قَالَ : لاَ یُعْطِیہَا مَنْ یُجْبَر عَلَی نَفَقَتِہِ۔","","Musannaf Ibn Abi Shaybah 10644","","","كتاب الزكاة"
"10645","(۱۰۶۴۵) حَدَّثَنَا جَرِیرٌ ، عَنْ ثَعْلَبَۃَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ تُقْبَلُ وَرَحِمٌ مُحْتَاجَۃٌ۔","","Musannaf Ibn Abi Shaybah 10645","","","كتاب الزكاة"
"10646","(۱۰۶۴۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یُعْطِی زَکَاتَہُ إلَی فَقِیرٍ ، ثُمَّ یَتَبَیَّنُ لَہُ أَنَّہُ غَنِیٌّ ؟ قَالَ : أَجْزَأَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 10646","","","كتاب الزكاة"
"10647","(۱۰۶۴۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ إسْمَاعِیلَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یُعْطِی مِنْ زَکَاتِہِ الْغَنِیَّ ، وَہُوَ لاَ یَعْلَمُ ؟ قَالَ : لاَ یُجْزئہُ۔","","Musannaf Ibn Abi Shaybah 10647","","","كتاب الزكاة"
"10648","(۱۰۶۴۸) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ مُحَمَّدِ بْنِ زِیَادٍ الأَلْہَانِیِّ ، قَالَ : سَمِعْتُ أَبَا أُمَامَۃَ الْبَاہِلِیَّ یَقُولُ : حِلْیَۃُ السَّیْفِ مِنَ الْکُنُوزِ۔","Sahih","Musannaf Ibn Abi Shaybah 10648","","","كتاب الزكاة"
"10649","(۱۰۶۴۹) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عُبَیدِ اللہِ بْنِ عُبَیْدٍ ، قَالَ : قُلْتُ لِمَکْحُولٍ : یَا أَبَا عَبْدِ اللہِ ، إنَّ لِی سَیْفًا فِیہِ خَمْسُونَ وَمِئَۃُ دِرْہَمٍ ، عَلَیَّ فِیہَا زَکَاۃٌ ؟ فَقَالَ : أَضِفْ إلَیْہَا مَا کَانَ لَکَ مِنْ ذَہَبٍ وَفِضَّۃٍ ، فَعَلَیْک فِیہِ الزَّکَاۃُ۔","","Musannaf Ibn Abi Shaybah 10649","","","كتاب الزكاة"
"10650","(۱۰۶۵۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ حَجَّاجٍ ، قَالَ : سَأَلْتُ عَطَائً ، وَحَمَّادًا ، وَإِبْرَاہِیمَ عَنِ الْقَدَحِ الْمُفَضَّضِ ، وَالسَّیْفِ الْمُحَلَّی ، وَالْمِنْطَقَۃِ الْمُحَلاَّۃِ ، إِذَا جَمَعْتُہُ فَکَانَ فِیہِ مِئَتَا دِرْہَمٍ ، أُزَکِّیہِ ؟ قَالُوا : لاَ۔","","Musannaf Ibn Abi Shaybah 10650","","","كتاب الزكاة"
"10651","(۱۰۶۵۱) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ مَالِکِ بْنِ عَبْدِ اللہِ الْکِلاَعِیِّ ، قَالَ : سَمِعْتُ مَالِکَ بْنَ مِغْوَلٍ یَقُولُ : حِلْیَۃُ السَّیْفِ مِنَ الْکُنُوزِ۔","","Musannaf Ibn Abi Shaybah 10651","","","كتاب الزكاة"
"10652","(۱۰۶۵۲) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : إذَا کَانَ عَلَیْک دَیْنٌ فَلاَ تُزَکِّہِ۔","","Musannaf Ibn Abi Shaybah 10652","","","كتاب الزكاة"
"10653","(۱۰۶۵۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَکُونُ عَلَیْہِ الدَّیْنُ السَّنَۃَ وَالسَّنَتَیْنِ ، أَیُزَکِّیہِ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 10653","","","كتاب الزكاة"
"10654","(۱۰۶۵۴) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا کَانَ حِینَ یُزَکِّی الرَّجُلُ لِلرَّجُلِ مَالَہُ ، نَظَرَ مَا لِلنَّاسِ عَلَیْہِ فَیَعْزِلُہُ۔","","Musannaf Ibn Abi Shaybah 10654","","","كتاب الزكاة"
"10655","(۱۰۶۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ فُضَیْلٍ ، قَالَ : لاَ تُزَکِّ مَا لِلنَّاسِ عَلَیْک۔","","Musannaf Ibn Abi Shaybah 10655","","","كتاب الزكاة"
"10656","(۱۰۶۵۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لِلزَّکَاۃِ حَدٌّ مَعْلُومٌ ، فَإِذَا جَائَ ذَلِکَ حَسَبَ مَالَہُ الشَّاہِدَ وَالْغَائِبَ ، فَیُؤَدِّی عَنْہُ إِلاَّ مَا کَانَ مِنْ دَیْنٍ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 10656","","","كتاب الزكاة"
"10657","(۱۰۶۵۷) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرٍ ، عَنْ مَیْمُونٍ ، قَالَ : اطْرَحْ مَا کَانَ عَلَیْک مِنَ الدَّیْنِ ، ثُمَّ زَکِّ مَا بَقِیَ۔","","Musannaf Ibn Abi Shaybah 10657","","","كتاب الزكاة"
"10658","(۱۰۶۵۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنِ السَّائِبِ بْنِ یَزِیدَ ، قَالَ : سَمِعْتُ عُثْمَانَ یَقُولُ : ہَذَا شَہْرُ زَکَاتِکُمْ ، فَمَنْ کَانَ عَلَیْہِ دَیْنٌ فَلْیَقْضِہِ ، وَزَکُّوا بَقِیَّۃَ أَمْوَالِکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 10658","","","كتاب الزكاة"
"10659","(۱۰۶۵۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ حَمَّادًا عَنِ الرَّجُلِ یَکُونُ عَلَیْہِ الدَّیْنُ وَفِی یَدِہِ مَالٌ ، أَیُزَکِّیہِ ؟ قَالَ : نَعَمْ ، عَلَیْہِ زَکَاتُہُ ، أَلاَ تَرَی أَنَّہُ ضَامِنٌ ۔ وَسَأَلْت رَبِیعَۃَ ؟ فَقَالَ : مِثْلَ قَوْلِ حَمَّادٍ۔","","Musannaf Ibn Abi Shaybah 10659","","","كتاب الزكاة"
"10660","(۱۰۶۶۰) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعَثَ عَبْدَ اللہِ بْنَ رَوَاحَۃَ إلَی الْیَمَنِ یَخْرُصُ عَلَیْہِمُ النَّخْلَ ۔ قَالَ : فَسَأَلْتُ الشَّعْبِیَّ : أَفَعَلَہُ ؟ قَالَ : لاَ۔ (طبرانی ۲۱۳۶)","","Musannaf Ibn Abi Shaybah 10660","","","كتاب الزكاة"
"10661","(۱۰۶۶۱) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِی بَکْرِ بْنِ حَزْمٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا بَعَثَ الْخَارِصَ ، أَمَرَہُ أَنْ لاَ یَخْرُصَ النَّخْلَ الْعَرَایَا۔ (عبدالرزاق ۷۲۱)","","Musannaf Ibn Abi Shaybah 10661","","","كتاب الزكاة"
"10662","(۱۰۶۶۲) حَدَّثَنَا أَبُو دَاوُدَ ، وَغُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ خُبَیْبِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : سَمِعْتُ عَبْدَ الرَّحْمَن بْنَ مَسْعُودٍ یَقُولُ : جَائَ سَہْلُ بْنُ أَبِی حَثْمَۃَ إلَی مَجْلِسَنا ، فَحَدَّثَ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إذَا خَرَصْتُمْ فَخُذُوا وَدَعُوا الثُّلُثَ ، فَإِنْ لَمْ تَجِدُوا الثُّلُثَ فَالرُّبْعَ۔ (ترمذی ۶۴۳۔ ابوداؤد ۱۶۰۱)","Da'if","Musannaf Ibn Abi Shaybah 10662","","","كتاب الزكاة"
"10663","(۱۰۶۶۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ بُشَیْرِ بْنِ یَسَارٍ ؛ أَنَّ عُمَرَ کَانَ یَبْعَثُ أَبَا خَیْثَمَۃَ خَارِصًا لِلنَّخْلِ ، فَقَالَ : إذَا أَتَیْتَ أَہْلَ الْبَیْتِ فِی حَائِطِہِمْ فَلاَ تَخْرُصْ عَلَیْہِمْ قَدْرَ مَا یَأْکُلُونَ۔","Hasan","Musannaf Ibn Abi Shaybah 10663","","","كتاب الزكاة"
"10664","(۱۰۶۶۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، أَنَّہُ سَمِعَہُ یَقُولُ : خَرَصَہَا ابْنُ رَوَاحَۃَ ، یَعْنِی خَیْبَرَ أَرْبَعِینَ أَلْفَ وَسْقٍ ، وَزَعَمَ أَنَّ الْیَہُودَ لَمَّا خَیَّرَہُمُ ابْنُ رَوَاحَۃَ أَخَذُوا التَّمْرَ وَعَلَیْہِمْ عِشْرُونَ أَلْفَ وَسْقٍ۔","Sahih","Musannaf Ibn Abi Shaybah 10664","","","كتاب الزكاة"
"10665","(۱۰۶۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خَفِّفْ عَلَی النَّاسِ فِی الْخَرْصِ ، فَإِنَّ فِی الْمَالِ الْعَرِیَّۃَ وَالْوَطِیَّۃَ۔n قَالَ : الْعَرِیَّۃُ النَّخْلَۃُ یَرِثُہَا الرَّجُلُ فِی حَائِطِ الرَّجُلِ ۔ وَالْوَطِیَّۃُ الرَّجُلُ یُوصِی بِالْوَطِیَّۃِ لِلْمَسَاکِینِ۔ (ابوعبید ۱۴۵۳)","","Musannaf Ibn Abi Shaybah 10665","","","كتاب الزكاة"
"10666","(۱۰۶۶۶) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ عَتَّابَ بْنَ أُسَیْدٍ أَنْ یَخْرُصَ الْعِنَبَ کَمَا یُخْرَصُ النَّخْلَ ، فَتُؤَدَّی زَکَاتُہُ زَبِیبًا ، کَمَا تُؤَدَّی زَکَاۃُ النَّخْلِ تَمْرًا ، فَتِلْکَ سُنَّۃُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی النَّخْلِ وَالْعِنَبِ۔ (ترمذی ۶۴۴۔ ابوداؤد ۱۵۹۹)","","Musannaf Ibn Abi Shaybah 10666","","","كتاب الزكاة"
"10667","(۱۰۶۶۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ لِی عَبْدُ الْکَرِیمِ ، وَعَمْرُو بْنُ دِینَارٍ : یُخْرَصُ النَّخْلَ وَالْعِنَبَ ، وَلاَ یُخْرُصُ الْحَبَّ۔","","Musannaf Ibn Abi Shaybah 10667","","","كتاب الزكاة"
"10668","(۱۰۶۶۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : مَتَی یُخْرَصُ النَّخْلُ ؟ قَالَ : حینَ یُطْعَمُ۔","","Musannaf Ibn Abi Shaybah 10668","","","كتاب الزكاة"
"10669","(۱۰۶۶۹) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، قَالَ : قَالَ ابْنُ جُرَیْجٍ : کَذَلِکَ أَخْبَرَنَا عَبْدُ اللہِ بْنُ فُلاَنٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ بِخَرْصِ خَیْبَرَ حِینَ طَابَ تَمْرُہُمْ ۔ فَقَالَ : وَقَالَ ابْنُ شِہَابٍ : أَمَرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُخَرْصَ خَیْبَرَ حِینَ یَطِیب أَوَّلُ التَّمْرِ۔ (عبدالرزاق ۷۲۱۶)","","Musannaf Ibn Abi Shaybah 10669","","","كتاب الزكاة"
"10670","(۱۰۶۷۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : حَرْثٌ لِرَجُلٍ دَیْنُہُ أَکْثَرُ مِنْ مَالِہِ فَحُصِدَ ، أَیُؤَدِّی حَقَّہُ یَوْمَ حَصَادِہِ ؟ فَقَالَ : مَا نَرَی عَلَی الرَّجُلِ دَیْنُہُ أَکْثَرُ مِنْ مَالِہِ مِنْ صَدَقَۃٍ فِی مَاشِیَۃٍ ، وَلاَ فِی أَصْلٍ ، إِلاَّ أَنْ یُؤَدِّیَ حَقَّہُ یَوْمَ حَصَادِہِ ، یَوْمَ یَحْصُدُہُ۔","","Musannaf Ibn Abi Shaybah 10670","","","كتاب الزكاة"
"10671","(۱۰۶۷۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ، عَنِ ابْنِ جُرَیْجٍ، قَالَ: قَالَ لِی أَبُو الزُّبَیْرِ: سَمِعْتُ طَاوُوسًا یَقُولُ: لَیْسَ عَلَیْہِ صَدَقَۃٌ۔","","Musannaf Ibn Abi Shaybah 10671","","","كتاب الزكاة"
"10672","(۱۰۶۷۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ الزِّبْرِقَانِ ، عَنْ عَبْدِ اللہِ بْنِ مِعْقَلٍ ؛ أَنَّہُ کَانَ عَلَی الْعُشُورِ ، فَکَانَ یَسْتَحْلِفُہُمْ ، فَمَرَّ بِہِ أَبُو وَائِلٍ ، فَقَالَ : لِمَ تَسْتَحْلِفُ النَّاسَ عَلَی أَمْوَالِہِمْ ، تَرْمِی بِہِمْ فِی جَہَنَّمَ ؟ فَقَالَ : إنِّی لَوْ لَمْ أَسْتَحْلِفْہُمْ لَمْ یُعْطُوا شَیْئًا ، قَالَ : إنَّہُمْ أَنْ لاَ یُعْطُوک خَیْرٌ مِنْ أَنْ تَسْتَحْلِفَہُمْ۔","","Musannaf Ibn Abi Shaybah 10672","","","كتاب الزكاة"
"10673","(۱۰۶۷۳) حَدَّثَنَا حَفْصٌ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : کَانَ مَسْرُوقٌ عَلَی السَّلْسَلَۃِ ، فَکَانَ مَنْ مَرَّ بِہِ أَعْطَاہُ شَیْئًا قَبِلَ مِنْہُ وَیَقُولُ : مَعَکَ شَیْئٌ لَنَا فِیہِ حَقٌّ ؟ فَإِنْ قَالَ نَعَمْ ، وَإِلاَّ قَالَ لہ : اذْہَبْ۔","","Musannaf Ibn Abi Shaybah 10673","","","كتاب الزكاة"
"10674","(۱۰۶۷۴) حَدَّثَنَا مُعْتَمِر ، عَنْ قُرَّۃَ ، عَمَّنْ حَدَّثَہُ ، قَالَ : مَرَرْت عَلَی حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ بِسَفِینَۃٍ ، فَمَا تَرَکَنِی حَتَّی اسْتَحْلَفَنِی مَا فِیہَا۔","","Musannaf Ibn Abi Shaybah 10674","","","كتاب الزكاة"
"10675","(۱۰۶۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ أَبِیہِ ، عَنْ زِیَادِ بْنِ حُدَیْرٍ ، قَالَ : بَعَثَنِی عُمَرُ عَلَی الْعُشُورِ ، وَأَمَرَنِی أَنْ لاَ أُفَتِّشَ أَحَدًا۔","Da'if","Musannaf Ibn Abi Shaybah 10675","","","كتاب الزكاة"
"10676","(۱۰۶۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : إنَّمَا کَانَ الْعَاشِرُ یُرْشِدُ ابْنَ السَّبِیلِ ، وَمَنْ أَتَاہُ بِشَیْئٍ قَبِلَہُ۔","","Musannaf Ibn Abi Shaybah 10676","","","كتاب الزكاة"
"10677","(۱۰۶۷۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ حَرْبِ بْنِ عُبَیْدِ اللہِ ، عَنْ جَدِّہِ أَبِی أُمہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ عَلَی الْمُسْلِمِینَ عُشُورٌ ، إنَّمَا الْعُشُورُ عَلَی الْیَہُودِ وَالنَّصَارَی۔ (ابوداؤد ۳۰۴۱)","","Musannaf Ibn Abi Shaybah 10677","","","كتاب الزكاة"
"10678","(۱۰۶۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ حَرْبِ بْنِ عُبَیْدِ اللہِ ، عَنْ خَالِہ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، مِثْلَ حَدِیثِ أَبِی الأَحْوَصِ۔ (ابوداؤد ۳۰۴۲۔ احمد ۳/۴۷۴)","","Musannaf Ibn Abi Shaybah 10678","","","كتاب الزكاة"
"10679","(۱۰۶۷۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إسْرَائِیلَ ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، قَالَ : حدَّثَنِی مَنْ سَمِعَ عَمْرَو بْنَ حُرَیْثٍ ، عَنْ سَعِیدِ بْنِ زَیْدٍ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : یَا مَعْشَرَ الْعَرَبِ ، احْمَدُوا اللَّہَ الَّذِی وَضَعَ عَنْکُمَ الْعُشُورَ۔ (احمد ۱/۱۹۰۔ ابویعلی ۹۶۴)","Da'if","Musannaf Ibn Abi Shaybah 10679","","","كتاب الزكاة"
"10680","(۱۰۶۸۰) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ قَابُوسَ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَصْلُحُ قِبْلَتَانِ فِی أَرْضٍ ، وَلَیْسَ عَلَی مُسْلِمٍ جِزْیَۃٌ۔ (ابوداؤد ۳۰۴۸۔ احمد ۱/۲۲۳)","Da'if","Musannaf Ibn Abi Shaybah 10680","","","كتاب الزكاة"
"10681","(۱۰۶۸۱) حَدَّثَنَا شَرِیکٌ ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ زِیَادِ بْنِ حُدَیْرٍ ، قَالَ : بَعَثَنِی عُمَرُ عَلَی السَّوَادِ ، وَنَہَانِی أَنْ أُعَشِّرَ مُسْلِمًا ، أَوْ ذَا ذِمَّۃٍ یُؤَدِّی الْخَرَاجَ۔","Hasan","Musannaf Ibn Abi Shaybah 10681","","","كتاب الزكاة"
"10682","(۱۰۶۸۲) حَدَّثَنَا عَفَّانُ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ ، عَنْ عُثْمَانَ بْنِ أَبِی الْعَاصِ ؛ أَنَّ وَفْدَ ثَقِیفٍ قَدِمُوا عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَاشْتَرَطُوا عَلَیْہِ أَنْ لاَ یُحْشَرُوا ، وَلاَ یُعْشَرُوا ، وَلاَ یُجَبُّوا ، فَقالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَکُم أَنْ لاَ تُحْشَرُوا ، وَلاَ تُعْشَرُوا ، وَلاَ یُسْتَعْمَلَ عَلَیْکُمْ غَیْرُکُمْ۔ (ابوداؤد ۳۰۲۰۔ احمد ۴/۲۱۸)","Hasan","Musannaf Ibn Abi Shaybah 10682","","","كتاب الزكاة"
"10683","(۱۰۶۸۳) حَدَّثَنَا شَرِیکٌ ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ زِیَادِ بْنِ حُدَیْرٍ ، قَالَ : بَعَثَنِی عُمَرُ إلَی نَصَارَی بَنِی تَغْلِبَ ، وَأَمَرَنِی أَنْ آخُذَ نِصْفَ عُشْرِ أَمْوَالِہِمْ۔","Hasan","Musannaf Ibn Abi Shaybah 10683","","","كتاب الزكاة"
"10684","(۱۰۶۸۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ السَّفَّاحِ بْنِ مَطَرٍ ، عَنْ دَاوُدَ بْنِ کُرْدُوسٍ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ ؛ أَنَّہُ صَالَحَ نَصَارَی بَنِی تَغْلِبَ عَلَی أَنْ تُضَعَّفَ عَلَیْہِمُ الزَّکَاۃُ مَرَّتَیْنِ ، وَعَلَی ا[corrupt]َنْ لاَ یُنَصِّرُوا صَغِیرًا ، وَعَلَی أَنْ لاَ یُکْرَہُوا عَلَی دِینِ غَیْرِہِمْ ۔ قَالَ دَاوُد : لَیْسَتْ لَہُمْ ذِمَّۃٌ ، قَدْ نَصَّرُوا۔","Da'if","Musannaf Ibn Abi Shaybah 10684","","","كتاب الزكاة"
"10685","(۱۰۶۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ زِیَادِ بْنِ حُدَیْرٍ ، قَالَ : کُنْتُ مَعَ جَدِّی فَمَرَّ عَلَی نَصْرَانِیٍّ بِفَرَسٍ قِیمَتُہُ عِشْرُونَ أَلْفًا ، فَقَالَ لَہُ : إِنْ شِئْتَ أَعْطَیْتَ أَلْفَیْنِ ، وَإِنْ شِئْتَ أَخَذْتُ الْفَرَسَ وَأَعْطَیْنَاک قِیمَتَہُ ، ثَمَانیَۃَ عَشَرَ أَلْفًا۔","","Musannaf Ibn Abi Shaybah 10685","","","كتاب الزكاة"
"10686","(۱۰۶۸۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی مِجْلَزٍ ؛ أَنَّ عُمَرَ بَعَثَ عُثْمَانَ بْنَ حُنَیْفٍ ، فَجَعَلَ عَلَی أَہْلِ الذِّمَّۃِ فِی أَمْوَالِہِمَ الَّتِی یَخْتَلِفُونَ بِہَا فِی کُلِّ عِشْرِینَ دِرْہَمًا دِرْہَمًا ، وَکَتَبَ بِذَلِکَ إلَی عُمَرَ بْنِ الْخَطَّابِ فَرَضِیَ وَأَجَازَہُ ، وَقَالَ لِعُمَرَ : کَمْ تَأْمُرُنَا أَنْ نَأْخُذَ مِنْ تُجَّارِ أَہْلِ الْحَرْبِ ؟ قَالَ : کَمْ یَأْخُذُونَ مِنْکُمْ إذَا أَتَیْتُمْ بِلاَدَہُمْ ؟ قَالُوا : الْعُشْرَ ، قَالَ : فَکَذَلِکَ فَخُذُوا مِنْہُمْ۔","","Musannaf Ibn Abi Shaybah 10686","","","كتاب الزكاة"
"10687","(۱۰۶۸۷) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ اسْتَعْمَلَ أَبَاہُ وَرَجُلاً آخَرَ عَلَی صَدَقَاتِ أَہْلِ الذِّمَّۃِ مِمَّا یَخْتَلِفُونَ بِہِ إلَی الْمَدِینَۃِ ، فَکَانَ یَأْمُرُہُمْ أَنْ یَأْخُذُوا مِنَ الْقَمْحِ نِصْفَ الْعُشْرِ ، تَخْفِیفًا عَلَیْہِمْ ، لِیَحْمِلُوا إلَی الْمَدِینَۃِ ، وَمِنَ الْقُطْنِیَّۃِ ، وَہِیَ الْحُبُوبُ الْعُشْرَ۔","","Musannaf Ibn Abi Shaybah 10687","","","كتاب الزكاة"
"10688","(۱۰۶۸۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُؤْخَذُ مِنْ أَہْلِ الذِّمَّۃِ مِنْ کُلِّ عِشْرِینَ دِرْہَمًا دِرْہَمٌ ، وَمِنْ أَہْلِ الْحَرْبِ مِنْ کُلِّ عَشَرَۃِ دَرَاہِمَ دِرْہَمٌ ، وَمِنْ أَہْلِ الذِّمَّۃِ إذَا اتَّجَرُوا فِی الْخَمْرِ ، مِنْ کُلِّ عَشَرَۃِ دَرَاہِمَ دِرْہَمٌ۔","","Musannaf Ibn Abi Shaybah 10688","","","كتاب الزكاة"
"10689","(۱۰۶۸۹) حَدَّثَنَا یَعْلَی ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ رُزَیْقٍ مَوْلَی بَنِی فَزَارَۃَ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ إلَیْہِ : خُذْ مِمَّنْ مَرَّ بِکَ مِنْ تُجَّارِ أَہْلِ الذِّمَّۃِ فِیمَا یُظْہِرُونَ مِنْ أَمْوَالِہِمْ وَیُدِیرُونَ مِنَ التِّجَارَاتِ ، مِنْ کُلِّ عِشْرِینَ دِینَارًا دِینَارًا ، فَمَا نَقَصَ مِنْہَا فَبِحِسَابِ مَا نَقَصَ ، حَتَّی تَبْلُغَ عَشَرَۃً ، فَإِذَا نَقَصَتْ ثَلاَثَۃَ دَنَانِیرَ فَدَعْہَا لاَ تَأْخُذْ مِنْہَا شَیْئًا ، وَاکْتُبْ لَہُمْ بَرَائَۃً إلَی مِثْلِہَا مِنَ الْحَوْلِ بِمَا تَأْخُذُ مِنْہُمْ۔","","Musannaf Ibn Abi Shaybah 10689","","","كتاب الزكاة"
"10690","(۱۰۶۹۰) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، قَالَ : وَسَأَلْت الزُّہْرِیَّ عَنْ جِزْیَۃِ نَصَارَی کَلْبٍ وَتَغْلِبَ ؟ فَقَالَ : بَلَغَنَا أَنَّہُ یُؤْخَذُ مِنْہُمْ نِصْفُ الْعُشْرِ مِنْ مَوَاشِیہِمْ۔","","Musannaf Ibn Abi Shaybah 10690","","","كتاب الزكاة"
"10691","(۱۰۶۹۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی حَصِینٍ ، عَنْ زِیَادِ بْنِ حُدَیْرٍ ، قَالَ : اسْتَعْمَلَنِی عُمَرُ عَلَی الْمَاصِر ، فَکُنْتُ أُعَشِّرُ مَنْ أَقْبَلَ وَأَدْبَرَ ، فَخَرَجَ إلَیْہِ رَجُلٌ فَأَعْلَمَہُ ، فَکَتَبَ إلَیَّ : أَنْ لاَ تُعَشِّرْ إِلاَّ مَرَّۃً وَاحِدَۃً ، یَعْنِی فِی السَّنَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 10691","","","كتاب الزكاة"
"10692","(۱۰۶۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ غَالِبِ بْنِ الْہُذَیْلِ ، عَنْ إبْرَاہِیمَ ، قَالَ : جَائَ نَصْرَانِیٌّ إلَی عُمَرَ ، فَقَالَ: إنَّ عَامِلَک عَشَّرَ فِی السَّنَۃِ مَرَّتَیْنِ ، فَقَالَ : مَنْ أَنْتَ ؟ فَقَالَ : أَنَا الشَّیْخُ النَّصْرَانِیُّ ، فَقَالَ عُمَرُ : وَأَنَا الشَّیْخُ الْحَنِیفِی ، فَکَتَبَ إلَی عَامِلِہِ : أَنْ لاَ تُعَشِّرْ فِی السَّنَۃِ إِلاَّ مَرَّۃً۔","","Musannaf Ibn Abi Shaybah 10692","","","كتاب الزكاة"
"10693","(۱۰۶۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ زِیَادِ بْنِ حُدَیْرٍ ، قَالَ : أَنَا أَوَّلُ مَنْ عَشَّرَ فِی الإِسْلاَمِ۔","","Musannaf Ibn Abi Shaybah 10693","","","كتاب الزكاة"
"10694","(۱۰۶۹۴) ما قالوا فی الفقراء والمساکین: من ھم؟","","Musannaf Ibn Abi Shaybah 10694","","","كتاب الزكاة"
"10695","(۱۰۶۹۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنِی جَرِیرُ بْنُ حَازِمٍ ، قَالَ : حدَّثَنِی رَجُلٌ ، عَنْ جَابِرِ بْنِ زَیْدٍ ؛ أَنَّہُ سُئِلَ عَنِ الْفُقَرَائِ وَالْمَسَاکِینِ ؟ فَقَالَ : الْفُقَرَائُ : الْمُتَعَفِّفُونَ ، وَالْمَسَاکِینُ : الَّذِین یَسْأَلُونَ۔","","Musannaf Ibn Abi Shaybah 10695","","","كتاب الزكاة"
"10696","(۱۰۶۹۵) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ عَلِیِّ بْنِ الْحَکَمِ ، قَالَ : سَمِعْتُ الضَّحَّاکَ بْنَ مُزَاحِمٍ یَقُولُ: {إنَّمَا الصَّدَقَاتُ لِلْفُقَرَائِ وَالْمَسَاکِینِ} ، قَالَ : الْفُقَرَائُ : الَّذِینَ ہَاجَرُوا ، وَالْمَسَاکِینُ : الَّذِینَ لَمْ یُہَاجِرُوا۔","","Musannaf Ibn Abi Shaybah 10696","","","كتاب الزكاة"
"10697","(۱۰۶۹۶) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، قَالَ : حدَّثَنَا مَعْقَلٌ ، قَالَ : سَأَلْتُ الزُّہْرِیَّ عَنْ قَوْلِ اللہِ تَعَالَی : {إنَّمَا الصَّدَقَاتُ لِلْفُقَرَائِ} ؟ قَالَ : الْفُقَرَائُ : الَّذِینَ فِی بُیُوتِہِمْ وَلاَ یَسْأَلُونَ ، وَالْمَسَاکِینُ : الَّذِینَ یَخْرُجُونَ فَیَسْأَلُونَ۔","","Musannaf Ibn Abi Shaybah 10697","","","كتاب الزكاة"
"10698","(۱۰۶۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ زَمْعَۃَ بْنِ صَالِحٍ ، عَنْ یُحَنَّسَ ، عَنِ ابْنِ الزُّبَیْرِ ، قَالَ : عَلَی الأَعْرَابِ صَدَقَۃُ الْفِطْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 10698","","","كتاب الزكاة"
"10699","(۱۰۶۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لَیْسَ عَلَی الأَعْرَابِ زَکَاۃُ الْفِطْرِ۔","","Musannaf Ibn Abi Shaybah 10699","","","كتاب الزكاة"
"10700","(۱۰۶۹۹) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ إِسْحَاقَ بْنِ طَلْحَۃَ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ بْنِ سَعِیدِ بْنِ الْعَاصِ ، قَالَ : کَانَ أَبُو بَکْرٍ الصِّدِّیقُ یَأْخُذُ مِنَ الأَعْرَابِ صَدَقَۃَ الْفِطْرِ الأَقِطَ۔","","Musannaf Ibn Abi Shaybah 10700","","","كتاب الزكاة"
"10701","(۱۰۷۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ ، قَالَ : یُعْطُونَ مِنَ اللَّبَنِ۔","","Musannaf Ibn Abi Shaybah 10701","","","كتاب الزكاة"
"10702","(۱۰۷۰۱) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ أَبِی حُرَّۃَ ، عَنِ الْحَسَنِ ، أَنَّہُ قَالَ : عَلَی الأَعْرَابِ صَدَقَۃُ الْفِطْرِ ، صَاعٌ مِنْ لَبَنٍ۔","","Musannaf Ibn Abi Shaybah 10702","","","كتاب الزكاة"
"10703","(۱۰۷۰۲) حَدَّثَنَا حَفْصٌ، عَنِ ابن أَبِی خَالِدٍ، عَنِ الشَّعْبِیِّ؛ فِی الرَّجُلِ یُعْتِقُ الْعَبْدَ النَّصْرَانِیَّ، قَالَ: ذِمَّتُہُ ذِمَّۃُ مَوَالِیہ۔","","Musannaf Ibn Abi Shaybah 10703","","","كتاب الزكاة"
"10704","(۱۰۷۰۳) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : لَیْسَ عَلَیْہِ الْجِزْیَۃُ۔","","Musannaf Ibn Abi Shaybah 10704","","","كتاب الزكاة"
"10705","(۱۰۷۰۴) حَدَّثَنَا حَفْصٌ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یُعْتِقُ الْعَبْدَ النَّصْرَانِیَّ ، قَالَ : عَلَیْہِ الْجِزْیَۃُ۔","","Musannaf Ibn Abi Shaybah 10705","","","كتاب الزكاة"
"10706","(۱۰۷۰۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ سُفْیَانَ، عَنْ سِنَانٍ؛ أَنَّ عُمَرَ بْنَ عَبْدِالْعَزِیزِ أَخَذَ الْجِزْیَۃَ مِنْ نَصْرَانِیٍّ أَعْتَقَہُ مُسْلِمٌ۔","","Musannaf Ibn Abi Shaybah 10706","","","كتاب الزكاة"
"10707","(۱۰۷۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ: سَأَلْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ عَنْ أَرْضِ الْخَرَاجِ، عَلَیْہَا زَکَاۃٌ ؟ فَقَالَ : الْخَرَاجُ عَلَی الأَرْضِ ، وَالزَّکَاۃُ عَلَی الْحَبِّ۔","","Musannaf Ibn Abi Shaybah 10707","","","كتاب الزكاة"
"10708","(۱۰۷۰۷) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : الْخَرَاجُ عَلَی الأَرْضِ ، وَالْعُشْرُ عَلَی الْحَبِّ۔","","Musannaf Ibn Abi Shaybah 10708","","","كتاب الزكاة"
"10709","(۱۰۷۰۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَقُولُ : لَیْسَ فِی التَّمْرِ زَکَاۃٌ إذَا کَانَ یُؤْخَذُ مِنْہُ الْعُشْرُ ، وَإِنْ کَانَ بِمِئَۃِ أَلْفٍ۔","","Musannaf Ibn Abi Shaybah 10709","","","كتاب الزكاة"
"10710","(۱۰۷۰۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : کَانَ حَسَنٌ وَسُفْیَانُ یَقُولاَنِ : عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 10710","","","كتاب الزكاة"
"10711","(۱۰۷۱۰) حَدَّثَنَا إبْرَاہِیمُ بْنُ الْمُغِیرَۃِ خَتَنٌ لِعَبْدِ اللہِ بْنِ الْمُبَارَکِ ، عَنْ أَبِی حَمْزَۃَ السَّکُرِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ یَجْتَمِعُ خَرَاجٌ وَعُشْرٌ فِی أَرْضٍ وَاحِدٍ۔","Da'if","Musannaf Ibn Abi Shaybah 10711","","","كتاب الزكاة"
"10712","(۱۰۷۱۱) حَدَّثَنَا أَبُو تُمَیْلَۃَ یَحْیَی بْنُ وَاضِحٍ، عَنْ أَبِی الْمُنِیبِ، عَنْ عِکْرِمَۃَ، قَالَ: لاَ یَجْتَمِعُ خَرَاجٌ وَعُشْرٌ فِی مَالٍ۔","","Musannaf Ibn Abi Shaybah 10712","","","كتاب الزكاة"
"10713","(۱۰۷۱۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : کَانَ أَبُو حَنِیفَۃَ یَقُولُ : لاَ یَجْتَمِعُ خَرَاجٌ وَزَکَاۃٌ عَلَی رَجُلٍ۔","","Musannaf Ibn Abi Shaybah 10713","","","كتاب الزكاة"
"10714","(۱۰۷۱۳) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمِ بْنِ مُحَمَّدٍ ؛ فِی قَوْلِہِ : {وَالَّذِینَ فِی أَمْوَالِہِمْ حَقٌّ مَعْلُومٌ} ، قَالَ : الزَّکَاۃُ۔","","Musannaf Ibn Abi Shaybah 10714","","","كتاب الزكاة"
"10715","(۱۰۷۱۴) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ {وَالَّذِینَ فِی أَمْوَالِہِمْ حَقٌّ مَعْلُومٌ} ، قَالَ : الزَّکَاۃُ الْمَفْرُوضَۃُ۔","","Musannaf Ibn Abi Shaybah 10715","","","كتاب الزكاة"
"10716","(۱۰۷۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی الْہَیْثُمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا إذَا خَرَجَتْ أَعْطِیَاتُہُمْ تَصَدَّقُوا مِنْہَا۔","","Musannaf Ibn Abi Shaybah 10716","","","كتاب الزكاة"
"10717","(۱۰۷۱۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : أَخَذَ الوَلِیدُ بن عَبْدِ الْمَلِکِ مَالَ رَجُلٍ مِنْ أَہْلِ الرَّقَّۃِ یُقَالُ لَہُ : أَبُو عَائِشَۃَ عِشْرِینَ أَلْفًا ، فَأَلقَاہَا فِی بَیْتِ الْمَالِ ، فَلَمَّا وَلِیَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ أَتَاہُ وَلَدُہُ ، فَرَفَعُوا مَظْلِمَتَہُمْ إلَیْہِ ، فَکَتَبَ إلَی مَیْمُونٍ : ادْفَعُوا إلَیْہِمْ أَمْوَالَہُمْ ، وَخُذُوا زَکَاۃَ عَامِہِ ہَذَا ، فَلَوْلا أَنَّہُ کَانَ مَالاً ضِمَارًا أَخَذْنَا مِنْہُ زَکَاۃَ مَا مَضَی۔","","Musannaf Ibn Abi Shaybah 10717","","","كتاب الزكاة"
"10718","(۱۰۷۱۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مَیْمُونٍ ؛ أَنَّ رَجُلاً ذَہَبَ لَہُ مَالٌ فِی بَعْضِ الْمَظَالِمِ ، فَوَقَعَ فِی بَیْتِ الْمَالِ ، فَلَمَّا وَلِیَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ رُفِعَ إلَیْہِ ، فَکَتَبَ عُمَرُ : أَنِ ادْفَعُوا إلَیْہِ ، وَخُذُوا مِنْہُ زَکَاۃَ مَا مَضَی ، ثُمَّ تَبعَہُمْ بَعْدُ کِتَاب : أَنِ ادْفَعُوا إلَیْہِ مَالَہُ ، ثُمَّ خُذُوا مِنْہُ زَکَاۃَ ذَلِکَ الْعَامِ ، فَإِنَّہُ کَانَ مَالاً ضِمَارًا۔","","Musannaf Ibn Abi Shaybah 10718","","","كتاب الزكاة"
"10719","(۱۰۷۱۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : عَلَیْہِ زَکَاۃُ ذَلِکَ الْعَامِ۔","","Musannaf Ibn Abi Shaybah 10719","","","كتاب الزكاة"
"10720","(۱۰۷۱۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنِ الْحَارِثِ بْنِ سُوَیْد ، عَنْ عَبْدِ اللہِ : {وَیَمْنَعُونَ الْمَاعُونَ}، قَالَ : ہُوَ مَا تَعَاوَر النَّاسُ بَیْنَہُمَ ؛ الْفَأْسُ ، وَالْقِدْرُ ، وَالدَّلْوُ ، وَأَشْبَاہُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 10720","","","كتاب الزكاة"
"10721","(۱۰۷۲۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنِ الْحَکَمِ ، عَنْ یَحْیَی بْنِ الْجَزَّارِ ، عَنْ أَبِی الْعُبَیْدَیْنِ ، عَنْ عَبْدِ اللہِ ، قَالَ : ہُوَ مَا تَعَاوَر النَّاسُ بَیْنَہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 10721","","","كتاب الزكاة"
"10722","(۱۰۷۲۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، عَنْ عَلِیٍّ ؛ {وَیَمْنَعُونَ الْمَاعُونَ} قَالَ : الزَّکَاۃُ الْمَفْرُوضَۃُ ۔ وَقَالَ ابْنُ عَبَّاسٍ : عَارِیَۃُ الْمَتَاعِ۔","","Musannaf Ibn Abi Shaybah 10722","","","كتاب الزكاة"
"10723","(۱۰۷۲۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ ، عَنْ عَلِیٍّ ، قَالَ : الْمَاعُونُ الزَّکَاۃُ۔","","Musannaf Ibn Abi Shaybah 10723","","","كتاب الزكاة"
"10724","(۱۰۷۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ عُبَیْدٍ ، عَنْ عَلِیِّ بْنِ رَبِیعَۃَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : ہُوَ الْمَالُ الَّذِی لاَ یُعْطَی حَقُّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 10724","","","كتاب الزكاة"
"10725","(۱۰۷۲۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ سَعِیدِ بْنِ عُبَیْدٍ ، عَنْ عَلِیِّ بْنِ رَبِیعَۃَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : ہُوَ الْمَالُ الَّذِی لاَ یُؤَدَّی حَقُّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 10725","","","كتاب الزكاة"
"10726","(۱۰۷۲۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ (ح) وَغُنْدَرٍ ، عَنْ َشُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَعْدِ بْنِ عِیَاضٍ ، عَنْ أصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُمْ قَالُوا : الْمَاعُونُ مَنْعُ الْفَأْسِ وَالْقِدْرِ وَالدَّلْوِ۔","Da'if","Musannaf Ibn Abi Shaybah 10726","","","كتاب الزكاة"
"10727","(۱۰۷۲۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ جَابِرِ بْنِ صُبْحٍ ، عَنْ أُمِّ شَرَاحِیلَ ، عَنْ أُمِّ عَطِیَّۃَ قَالَتْ : الْمَہْنَۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 10727","","","كتاب الزكاة"
"10728","(۱۰۷۲۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : الْمَاعُونُ مَنْعُ الْفَأْسِ وَالْقِدْرِ وَالدَّلْوِ۔","Da'if","Musannaf Ibn Abi Shaybah 10728","","","كتاب الزكاة"
"10729","(۱۰۷۲۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَمْ یَجِیْٔ أَہْلُہَا بَعْد۔","Da'if","Musannaf Ibn Abi Shaybah 10729","","","كتاب الزكاة"
"10730","(۱۰۷۲۹) حَدَّثَنَا جَرِیرٌ ، عَنْ إبْرَاہِیمَ ، قَالَ : الْقِدْرُ وَالرَّحَی ۔ وَقَالَ بَعْضُہُمْ : الْفَأْسُ۔","Da'if","Musannaf Ibn Abi Shaybah 10730","","","كتاب الزكاة"
"10731","(۱۰۷۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سَلَمَۃَ بْنِ نُبَیْطٍ ، عَنِ الضَّحَّاکِ ، قَالَ : الزَّکَاۃُ۔","","Musannaf Ibn Abi Shaybah 10731","","","كتاب الزكاة"
"10732","(۱۰۷۳۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنِ الْحَارِثِ ، عَنْ عَبْدِ اللہِ ، قَالَ : الْقِدْرُ وَالدَّلْوُ۔","Da'if","Musannaf Ibn Abi Shaybah 10732","","","كتاب الزكاة"
"10733","(۱۰۷۳۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللہِ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 10733","","","كتاب الزكاة"
"10734","(۱۰۷۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ أَبِی الْمُغِیرَۃِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : ہِیَ الزَّکَاۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 10734","","","كتاب الزكاة"
"10735","(۱۰۷۳۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، مِثْلَ حَدِیثِ ابْنِ مَسْعُودٍ۔","Sahih","Musannaf Ibn Abi Shaybah 10735","","","كتاب الزكاة"
"10736","(۱۰۷۳۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنِ الْحَکَمِ ، عَنْ یَحْیَی بْنِ الْجَزَّارِ ؛ أَنَّ أَبَا العُبَیدِین سَأَلَ عَبْدَ اللہِ عَنِ الْمَاعُونِ ؟ قَالَ : ہُوَ الْفَأْسُ وَالْقِدْرُ وَالدَّلْوُ۔","Sahih","Musannaf Ibn Abi Shaybah 10736","","","كتاب الزكاة"
"10737","(۱۰۷۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِی عُمَر ، عَنْ یَحْیَی ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، قَالَ : الْمَاعُونُ الزَّکَاۃُ۔","","Musannaf Ibn Abi Shaybah 10737","","","كتاب الزكاة"
"10738","(۱۰۷۳۷) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : الْمَاعُونُ ہُوَ الْمَالُ بِلِسَانِ قُرَیْشٍ۔","","Musannaf Ibn Abi Shaybah 10738","","","كتاب الزكاة"
"10739","(۱۰۷۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ بسَّامٍ ، قَالَ : سَأَلْتُ عِکْرِمَۃَ عَنِ الْمَاعُونِ ؟ فَقَالَ : الْفَأْسُ وَالْقِدْرُ وَالدَّلْوُ۔","","Musannaf Ibn Abi Shaybah 10739","","","كتاب الزكاة"
"10740","(۱۰۷۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : ہُوَ الْمَتَاعُ ۔ وَقَالَ عَلِیٌّ : ہُوَ الزَّکَاۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 10740","","","كتاب الزكاة"
"10741","(۱۰۷۴۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : الْمَاعُونُ الزَّکَاۃُ الْمَفْرُوضَۃُ۔","","Musannaf Ibn Abi Shaybah 10741","","","كتاب الزكاة"
"10742","(۱۰۷۴۱) حَدَّثَنَا جَرِیرٌ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : عَیَّرْنَا صَاعَ الْمَدِینَۃِ فَوَجَدْنَاہُ یَزِیدُ مِکْیَالاً عَلَی الْحَجَّاجِیِّ۔","","Musannaf Ibn Abi Shaybah 10742","","","كتاب الزكاة"
"10743","(۱۰۷۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مُوسَی بْنِ طَلْحَۃَ ، قَالَ : الْحَجَّاجِیُّ صَاعُ عُمَرَ بْنِ الْخَطَّابِ۔","","Musannaf Ibn Abi Shaybah 10743","","","كتاب الزكاة"
"10744","(۱۰۷۴۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ أَبِی شِہَابٍ ، عَنْ حَجَّاجٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : الْقَفِیزُ الْحَجَّاجِیُّ ہُوَ الصَّاعُ۔","","Musannaf Ibn Abi Shaybah 10744","","","كتاب الزكاة"
"10745","(۱۰۷۴۴) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، قَالَ: مَا کَانَ یُفْتِی فِیہِ إبْرَاہِیمُ فِی کَفَّارَۃِ یَمِینٍ ، أَوْ فِی الشِّرَائِ ، أَوْ فِی إطْعَامِ سِتِّینَ مِسْکِینًا، وَفِیمَا قَالَ فِیہِ: الْعُشْرُ وَنِصْفُ الْعُشْرِ، قَالَ: کَانَ یُفْتِی بِقَفِیزِ الْحَجَّاجِیِّ، قَالَ: ہُوَ الصَّاعُ۔","","Musannaf Ibn Abi Shaybah 10745","","","كتاب الزكاة"
"10746","(۱۰۷۴۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : سَمِعْتُ حَسَنًا یَقُولُ : صَاعُ عُمَرَ ثَمَانیَۃُ أَرْطَالٍ ۔ وَقَالَ شَرِیکٌ : أَکْثَرُ مِنْ سَبْعَۃِ أَرْطَالٍ وَأَقَلُّ مِنْ ثَمَانِیَۃٍ۔","Hasan","Musannaf Ibn Abi Shaybah 10746","","","كتاب الزكاة"
"10747","(۱۰۷۴۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ بْنِ سَوَّارٍ ، عَنْ عَوْنِ بْنِ أَبِی جُحَیْفَۃَ ، عَنْ أَبِیہِ ، قَالَ : بَعَثَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِینَا سَاعِیًا ، فَأَخَذَ الصَّدَقَۃَ مِنْ أَغْنِیَائِنَا ، فَقَسَمَہَا فِی فُقَرَائِنَا ، وَکُنْت غُلاَمًا یَتِیمًا فَأَعْطَانِی مِنْہَا قَلُوصًا۔ (ترمذی ۶۴۹۔ دارقطنی ۷)","Da'if","Musannaf Ibn Abi Shaybah 10747","","","كتاب الزكاة"
"10748","(۱۰۷۴۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِیہِ ، قَالَ : سُئِلَ عُمَرُ عَمَّا یُؤْخَذُ مِنْ صَدَقَاتِ الأَعْرَابِ ، کَیْفَ یُصْنَعُ بِہَا ؟ فَقَالَ عُمَرُ : وَاللَّہِ ، لأَرُدَّنَّ عَلَیْہِمُ الصَّدَقَۃَ ، حَتَّی تَرُوحَ عَلَی أَحَدِہِمْ مِئَۃ نَاقَۃٍ ، أَوْ مِئَۃ بَعِیرٍ۔","","Musannaf Ibn Abi Shaybah 10748","","","كتاب الزكاة"
"10749","(۱۰۷۴۸) حَدَّثَنَا جَرِیر بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ؛ أَخَذَ نِصْفَ صَدَقَاتِ الأَعْرَابِ ، وَرَدَّ نِصْفَہَا فِی فُقَرَائنَا۔","","Musannaf Ibn Abi Shaybah 10749","","","كتاب الزكاة"
"10750","(۱۰۷۴۹) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ سَالِمُ بْنُ عَبْدِ اللہِ یَقْسِمُ صَدَقَۃَ عُمَرَ ، فَیَأْتِیہِ الرَّجُلُ ذُو ہِیئَۃٍ قَدْ أَعْطَاہُ ، فَیَقُولُ : أَعْطِنِی ، فَیُعْطِیہ وَلاَ یَسْأَلُہُ۔","","Musannaf Ibn Abi Shaybah 10750","","","كتاب الزكاة"
"10751","(۱۰۷۵۰) حَدَّثَنَا بِشْرُ بْنُ مُفَضَّلٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَمْرِو بْنِ سَہلٍ، قَالَ : لَقَدْ رَأَیْتُ عُثْمَانَ فِی طَرِیقِ مَکَّۃَ ، وَإِنَّ الصَّدَقَاتِ لَتُسَاقُ مَعَہُ ، فَیَحْمِلُ عَلَیْہَا الرَّاجِلَ المُنْقَطِع بِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 10751","","","كتاب الزكاة"
"10752","(۱۰۷۵۱) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ شَرِیکِ بْنِ نَمْلَۃَ ، قَالَ : بَعَثَنِی عَلِیٌّ سَاعِیًا عَلَی الصَّدَقَۃِ ، قَالَ : فَصَحِبَنِی أَخِی ، فَتَصَدَّقْت ، قَالَ : فَحَمَلْت أَخِی عَلَی بَعِیرٍ ، فَقُلْتُ : إِنْ أَجَازَہُ عَلِیٌّ ، وَإِلاَّ فَہُوَ مِنْ مَالِی ، فَلَمَّا قَدِمْت عَلَیْہِ قَصَصْت عَلَیْہِ قِصَّۃَ أَخِی ، فَقَالَ : لَکَ فِیہِ نَصِیبٌ۔","Da'if","Musannaf Ibn Abi Shaybah 10752","","","كتاب الزكاة"
"10753","(۱۰۷۵۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَالِمٍ ، عَنْ أَسْلَمَ ؛ أَنَّ عُمَرَ بَعَثَہُ بِإِبِلٍ مِنَ الصَّدَقَۃِ إلَی الْحِمَی ، فَلَمَّا أَرَدْتُ أَنْ أَصْدُرَ ، قَالَ : اعْرِضْہَا عَلَیَّ ، فَعَرَضْتہَا عَلَیْہِ وَقَدْ جَعَلْتُ جَہَازِی عَلَی نَاقَۃٍ مِنْہَا ، فَقَالَ : لاَ أُمَّ لَکَ ، عَمَدْت إلَی نَاقَۃٍ تُحْیِی أَہْلَ بَیْتٍ مِنَ الْمُسْلِمِینَ تَحْمِلُ عَلَیْہَا جَہَازَک ؟ أَفَلاَ ابْنَ لَبُونٍ بَوَّالاً ، أَوْ نَاقَۃً شَصُوصًا۔","Sahih","Musannaf Ibn Abi Shaybah 10753","","","كتاب الزكاة"
"10754","(۱۰۷۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الْحُوَیْرِثِ ، عَنْ أَبِی عَمَّارٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : لَیْسَ فِی الْمَمْلُوکِ زَکَاۃٌ إِلاَّ مَمْلُوکٌ تَمْلِکُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 10754","","","كتاب الزكاة"
"10755","(۱۰۷۵۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ عَمْرِو بْنِ مَیْمُونِ بْنِ مِہْرَانَ ، عَنْ زِیَادِ بْنِ أَبِی مَرْیَمَ ، عَنْ أُمِّہِ قَالَتْ أَتَیْتُ عَبْدَ اللہِ بْنَ الأَرْقَمِ ، قَالَ وَکَانَ عَلَی بَیْتِ الْمَالِ فِی إمْرَۃِ عُمَر وَفِی إمْرَۃِ عُثْمَانَ وَہُوَ یَقْسِمُ صَدَقَۃً بِالْمَدِینَۃِ ، فَلَمَّا رَآنِی ، قَالَ : مَا جَائَ بِکَ یَا أُمَّ زِیَادٍ ، قَالَتْ قُلْتُ لَہُ : لِمَا جَائَ لَہُ النَّاسُ ، قَالَ ہَلْ عَتَقْتِ بَعْدُ ؟ قُلْتُ : لاَ ، فَبَعَثَ إلَی بَیْتِہِ فَأُتِیَ بِبُرْدٍ فَأَمَرَ لِی بِہِ ، وَلَمْ یَأْمُرْ لِی مِنَ الصَّدَقَۃِ بِشَیْئٍ لأَنِّی کُنْت مَمْلُوکَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 10755","","","كتاب الزكاة"
"10756","(۱۰۷۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَر بْنِ ذَرٍّ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ تُطْعِمُوا ہَؤُلاَئِ السُّودَانِ مِنْ أَضَاحِیکُمْ فَإِنَّمَا ہِیَ أَمْوَالُ أَہْلِ مَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 10756","","","كتاب الزكاة"
"10757","(۱۰۷۵۶) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ سَالِمٍ ، أَنَّہُ کَرِہَ أَنْ یُتَصَدَّقَ عَلَی عَبِیدِ الأَعْرَابِ۔ (طبرانی ۳۲۳۳)","","Musannaf Ibn Abi Shaybah 10757","","","كتاب الزكاة"
"10758","(۱۰۷۵۷) حَدَّثَنَا عبد الرحمن وَ وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ عَبَّاسِ بْنِ عَبْدِ الرَّحْمَنِ الْمَدَنِیِّ ، قَالَ خَصْلَتَانِ لَمْ یَکُنِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَکِلُہُمَا إلَی أَحَدٍ مِنْ أَہْلِہِ کَانَ یُنَاوِلُ الْمِسْکِینَ بِیَدِہِ وَیَضَعُ الطَّہُورَ لِنَفْسِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 10758","","","كتاب الزكاة"
"10759","(۱۰۷۵۸) وَکِیعٌ، عَنْ أَبِی الْمِنْہَالِ، قَالَ: رَأَیْتُ عَلِیَّ بْنَ حُسَیْنٍ لَہُ جُمَّۃٌ وَعَلَیْہِ مِلْحَفَۃٌ وَرَأَیْتُہ یُنَاوِلُ الْمِسْکِینَ بِیَدِہِ۔","","Musannaf Ibn Abi Shaybah 10759","","","كتاب الزكاة"
"10760","(۱۰۷۵۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : سَأَلْتُہ عَنِ الرَّجُلِ یُسَلِّفُ إلَی أَہْلِ الأَرْضِ أو یَکُونُ لَہُ الدَّیْنُ أَیُزَکِّیہِ ؟ قَالَ : نَعَمْ۔","Da'if","Musannaf Ibn Abi Shaybah 10760","","","كتاب الزكاة"
"10761","(۱۰۷۶۰) وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ رَجُلٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَیْسَ فِی مُضَارَبَۃٍ زَکَاۃٌ لأَنَّہُ لاَ یَدْرِی مَا صُنِعَ۔","","Musannaf Ibn Abi Shaybah 10761","","","كتاب الزكاة"
"10762","(۱۰۷۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ (وَالْغَارِمِینَ) ، قَالَ : الْمُنْفِقِینَ فِی غَیْرِ فَسَادٍ ، (وَابْنِ السَّبِیلِ) الْمُجْتَازُ عَلَی الأَرْضِ إلَی الأَرْضِ۔","","Musannaf Ibn Abi Shaybah 10762","","","كتاب الزكاة"
"10763","(۱۰۷۶۲) عُبَیْدُ اللہِ بْنُ مُوسَی، عَنْ عُثْمَانَ بْنِ الأَسْوَد ، عَنْ مُجَاہِدٍ ، قَالَ ثَلاَثَۃٌ مِنَ الْغَارِمِینَ: رَجُلٌ ذَہَبَ السَّیْلُ بِمَالِہِ وَرَجُلٌ أَصَابَہُ حَرِیقٌ فَذَہَبَ بِمَالِہِ , وَرَجُلٌ لَہُ عِیَالٌ وَلَیْسَ لَہُ مَالٌ, فَہُوَ یَدَّانُ وَیُنْفِقُ عَلَی عِیَالِہِ۔","","Musannaf Ibn Abi Shaybah 10763","","","كتاب الزكاة"
"10764","(۱۰۷۶۳) وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ لِلْغَارِمِ : یَنْبَغِی الإِمَامُ أَنْ یَقْضِیَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 10764","","","كتاب الزكاة"
"10765","(۱۰۷۶۴) الزُّبَیْرِیُّ أَبُو أَحْمَدَ ، قَالَ : حدَّثَنَا مَعْقِلٌ ، قَالَ : سَأَلْتُ الزُّہْرِیَّ ، عَنِ الْغَارِمِینَ : قَالَ أَصْحَابُ الدَّیْنِ ، وَابْنُ السَّبِیلِ ، وَإِنْ کَانَ غَنِیًّا۔","","Musannaf Ibn Abi Shaybah 10765","","","كتاب الزكاة"
"10766","(۱۰۷۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن رَیْحَانَ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَحِلُّ الصَّدَقَۃُ لِغَنِیٍّ ، وَلاَ لِذِی مِرَّۃٍ سَوِیٍّ۔ (ترمذی ۶۵۲۔ ابوداؤد ۱۶۳۱)","Sahih","Musannaf Ibn Abi Shaybah 10766","","","كتاب الزكاة"
"10767","(۱۰۷۶۶) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی حَصِینٍ ، عَنْ سَالِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَحِلُّ الصَّدَقَۃُ لِغَنِیٍّ ، وَلاَ لِذِی مِرَّۃٍ سَوِیٍّ۔","","Musannaf Ibn Abi Shaybah 10767","","","كتاب الزكاة"
"10768","(۱۰۷۶۷) عَبْدُ الرَّحِیمِ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ حُبْشِیِّ بْنِ جُنَادَۃَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : الْمَسْأَلَۃُ لاَ تَحِلُّ لِغَنِیٍّ ، وَلاَ لِذِی مِرَّۃٍ سَوِیٍّ۔","Da'if","Musannaf Ibn Abi Shaybah 10768","","","كتاب الزكاة"
"10769","(۱۰۷۶۸) عَبْدُ الرَّحِیمِ ، وَابْنُ نُمَیْرٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عُبَیْدِ اللہِ بْنِ عَدِیِّ بْنِ الْخِیَارِ ، قَالَ : أَخْبَرَنِی رَجُلاَنِ أَنَّہُمَا أَتَیَا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْأَلاَنِہِ الصَّدَقَۃَ ، قَالَ فَرَفَّعَ فِیہِم الْبَصَرَ وَصَوَّبَہُ ، وَقَالَ : إنَّکُمَا لَجَلْدَانِ ، فَقَالَ : أَمَا إِنْ شِئْتُمَا أَعْطَیْتُکُمَا وَلاَ حَظَّ فِیہَا لِغَنِیٍّ ، وَلاَ لِقَوِیٍّ مُکْتَسِبٍ۔n(ابوداؤد ۱۶۳۰۔ احمد ۵/۳۶۲)","Sahih","Musannaf Ibn Abi Shaybah 10769","","","كتاب الزكاة"
"10770","(۱۰۷۶۹) ابْنُ مَہْدِیٍّ ، عَنْ مُوسَی بْنِ عُلَیٍّ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : لاَ تَنْبَغِی الصَّدَقَۃُ لِغَنِیٍّ ، وَلاَ لِذِی مِرَّۃٍ سَوِیٍّ۔","Sahih","Musannaf Ibn Abi Shaybah 10770","","","كتاب الزكاة"
"10771","(۱۰۷۷۰) حَدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ أَخِی الزُّہْرِیِّ ، عَنْ حَمْزَۃَ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ تَزَالُ الْمَسْأَلَۃُ بِأَحَدِکُمْ حَتَّی یَلْقَی اللَّہَ وَلَیْسَ فِی وَجْہِہِ مُزْعَۃُ لَحْمٍ۔ (بخاری ۱۴۷۴۔ مسلم ۱۰۳)","Sahih","Musannaf Ibn Abi Shaybah 10771","","","كتاب الزكاة"
"10772","(۱۰۷۷۱) جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ قَابُوسَ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ لَوْ یَعْلَمُ صَاحِبُ الْمَسْأَلَۃِ مَا فِیہَا مَا سَأَلَ۔ (طبرانی ۱۲۶۱۶)","Da'if","Musannaf Ibn Abi Shaybah 10772","","","كتاب الزكاة"
"10773","(۱۰۷۷۲) أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مَسْرُوقٍ ، قَالَ : مَنْ سَأَلَ النَّاسَ مِنْ غَیْرِ فَاقَۃٍ جَائَ یَوْمَ الْقِیَامَۃِ وَفِی وَجْہِہِ خُدُوشٌ ، أَوْ خُمُوشٌ۔","","Musannaf Ibn Abi Shaybah 10773","","","كتاب الزكاة"
"10774","(۱۰۷۷۳) ابْنُ نُمَیْرٍ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : قَالَتْ أُمُّ الدَّرْدَائِ لأَبِی الدَّرْدَائِ : إِنِ احْتَجْتُ بَعْدَکَ آکُلُ الصَّدَقَۃَ؟ قَالَ: لاَ ، اعْمَلِی وَکُلِی قَالَتْ: إِنْ ضَعُفْت عَنِ الْعَمَلِ ، قَالَ: الْتَقِطِی السُّنْبُلَ، وَلاَ تَأْکُلِی الصَّدَقَۃَ۔","","Musannaf Ibn Abi Shaybah 10774","","","كتاب الزكاة"
"10775","(۱۰۷۷۴) جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ عَبْدِ الْمَلِکَ بْنِ عُمَیْرٍ ، عَنْ عُقْبَۃَ ، أَوْ فُلاَنِ بْنِ عُقْبَۃَ ، عَنِ ابْنِ جُنْدُبٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کُلُّ الْمَسْأَلَۃِ کَدٌّ فِی وَجْہِ الرَّجُلِ یَوْمَ الْقِیَامَۃِ إِلاَّ أَنْ یَسْأَلَ سُلْطَانًا، أَوْ فِی أَمْرٍ لاَ بُدَّ مِنْہُ۔ (ترمذی ۶۸۱۔ ابوداؤد ۱۶۳۶)","Sahih","Musannaf Ibn Abi Shaybah 10775","","","كتاب الزكاة"
"10776","(۱۰۷۷۵) ابْنُ فُضَیْلٍ ، عَنْ عُمَارَۃَ بْنِ الْقَعْقَاعِ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ سَأَلَ النَّاسَ أَمْوَالَہُمْ تَکَثُّرًا فَإِنَّمَا یَسْأَلُ جَمْرَۃً فَلْیَسْتَقِلَّ مِنْہُ ، أَوْ لِیَسْتَکْثِرْ۔ (مسلم ۱۰۵۔ احمد ۲/۲۳۱)","Sahih","Musannaf Ibn Abi Shaybah 10776","","","كتاب الزكاة"
"10777","(۱۰۷۷۶) ابْنُ نُمَیْرٍ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ حُبْشِیِّ السَّلُولِیِّ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ سَأَلَ النَّاسَ لِیُثْرِیَ بِہِ مَالَہُ ، فَإِنَّہُ خُمُوشٌ فِی وَجْہِہِ وَرَضْفٌ مِنْ جَہَنَّمَ یَأْکُلُہُ یَوْمَ الْقِیَامَۃِ , وَذَلِکَ فِی حَجَّۃِ الْوَدَاعِ۔","Da'if","Musannaf Ibn Abi Shaybah 10777","","","كتاب الزكاة"
"10778","(۱۰۷۷۷) أَبُو مُعَاوِیَۃَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ عُمَرُ مَنْ سَأَلَ النَّاسَ لِیَثْرَی بِہِ مَالَہُ فَإِنَّمَا ہُوَ رُضَفٌ مِنْ جَہَنَّمَ , فَمَنْ شَائَ فَلْیُقِلَّ وَمَنْ شَائَ فَلْیُکْثِرْ۔","","Musannaf Ibn Abi Shaybah 10778","","","كتاب الزكاة"
"10779","(۱۰۷۷۸) ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لأَنْ یَأْخُذَ أَحَدُکُمْ أَحْبُلاً فَیَأْتِیَ الْجَبَلَ , فَیَحْتَطِبَ مِنْہُ فَیَبِیعَہُ , وَیَأْکُلَ وَیَتَصَدَّقَ , خَیْرٌ مِنْ أَنْ یَسْأَلَ النَّاسَ۔ (بخاری ۱۴۸۰۔ مسلم ۱۰۷)","Sahih","Musannaf Ibn Abi Shaybah 10779","","","كتاب الزكاة"
"10780","(۱۰۷۷۹) ابْنُ نُمَیْرٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنِ الزُّبَیْرِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لأَنْ یَأْخُذَ أَحَدُکُمْ أَحْبُلاً فَیَذْہَبَ فَیَأْتِیَ بِحُزْمَۃٍ مِنْ حَطَبٍ عَلَی ظَہْرِہِ فَیَبِیعَہَا فَیَکُفَّ اللَّہُ بِہَا وَجْہَہُ , خَیْرٌ لَہُ مِنْ أَنْ یَسْأَلَ النَّاسَ شَیْئًا , أَعْطَوْہُ ، أَوْ مَنَعُوہُ۔ (بخاری ۳۰۷۵۔ احمد ۱/۱۶۷)","Sahih","Musannaf Ibn Abi Shaybah 10780","","","كتاب الزكاة"
"10781","(۱۰۷۸۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ وَالْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مِسْعَرٍ ، عَنْ عُبَیْدِ بْنِ الْحَسَنِ ، عَنِ ابْنِ مَعْقِلٍ ، قَالَ مَنْ سَأَلَ تَکَثُّرًا جَائَ یَوْمَ الْقِیَامَۃِ وَفِی وَجْہِہِ خُمُوشٌ۔","","Musannaf Ibn Abi Shaybah 10781","","","كتاب الزكاة"
"10782","(۱۰۷۸۱) حَفْصٌ وَأَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : جَائَ سَائِلٌ فَسَأَلَ فَأَعْطَاہُ شَیْئًا ، فَقِیلَ لَہُ : تُعْطِیہ وَہُوَ مُوسِرٌ ؟ فَقَالَ : إِنَّہُ سَائِلٌ وَلِلسَّائِلِ حَقٌّ وَلَیَتَمَنَّیَنَّ یَوْمَ الْقِیَامَۃِ ، أَنَّہَا کَانَتْ رَضْفَۃً فِی یَدِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 10782","","","كتاب الزكاة"
"10783","(۱۰۷۸۲) ابْنُ عُیَیْنَۃَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عَنْ عَطَائِ بْنِ یَسَارٍ یَبْلُغُ بِہِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ سَأَلَ وَلَہُ أُوقِیَّۃٌ ، أَوْ عَدْلُہَا فَہُوَ یَسْأَلُ النَّاسَ إلْحَافًا۔ (ابوداؤد ۱۶۲۴۔ مالک ۱۱)","","Musannaf Ibn Abi Shaybah 10783","","","كتاب الزكاة"
"10784","(۱۰۷۸۳) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطِیَّۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَحِلُّ الصَّدَقَۃُ لِغَنِیٍّ إِلاَّ لِثَلاَثَۃٍ : فِی سَبِیلِ اللہِ ، أَوِ ابْنِ السَّبِیلِ ، أَوْ رَجُلٍ کَانَ لَہُ جَارٌ فَتُصُدِّقَ عَلَیْہِ فَأَہْدَی لَہُ۔ (ابوداؤد ۱۶۳۴۔ بیہقی ۲۳)","Da'if","Musannaf Ibn Abi Shaybah 10784","","","كتاب الزكاة"
"10785","(۱۰۷۸۴) وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَحِلُّ الصَّدَقَۃُ إِلاَّ لِخَمْسَۃٍ : رَجُلٍ اشْتَرَاہَا بِمَالِہِ ، أَوْ رَجُلٍ عَمِلَ عَلَیْہَا ، أَوِ ابْنِ السَّبِیلِ ، أَوْ فِی سَبِیلِ اللہِ ، أَوْ رَجُلٍ کَانَ لَہُ جَارٌ فَتُصُدِّقَ عَلَیْہِ فَأَہْدَی لَہُ۔ (مالک ۲۹)","","Musannaf Ibn Abi Shaybah 10785","","","كتاب الزكاة"
"10786","(۱۰۷۸۵) ابْنُ نُمَیْرٍ، عَنِ الْمُجَالِدِ، عَنِ الشَّعْبِیِّ، عَنْ حُبْشِیِّ بْنِ جُنَادَۃَ السَّلُولِیِّ، قَالَ: سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ وَأَتَاہُ أَعْرَابِیٌّ فَسَأَلَہُ ، فَقَالَ : إنَّ الْمَسْأَلَۃَ لاَ تَحِلُّ إِلاَّ لِفَقْرٍ مُدْقِعٍ ، أَوْ غُرْمٍ مُفْظِعٍ۔","Da'if","Musannaf Ibn Abi Shaybah 10786","","","كتاب الزكاة"
"10787","(۱۰۷۸۶) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، أَنَّ سَائِلاً سَأَلَ ابْنَ عُمَرَ وَالْحَسَنَ وَالْحُسَیْنَ ، وَعَبْدَ اللہِ بْنَ جَعْفَرٍ فَقَالُوا : إِنْ کُنْت تَسْأَلُ لِدَیْنٍ مُفْظِعٍ ، أَوْ فَقْرٍ مُدْقِعٍ ، أَوَ قَالَ دَمٍ مُوجِعٍ فَإِنَّ الصَّدَقَۃَ تَحِلُّ لَک۔","","Musannaf Ibn Abi Shaybah 10787","","","كتاب الزكاة"
"10788","(۱۰۷۸۷) الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ ہَارُونَ بْنِ رِئَابٍ ، عَنْ کِنَانَۃَ بْنِ نُعَیْمٍ ، عَنْ قَبِیصَۃَ بْنِ الْمُخَارِقِ الْہِلاَلِیِّ ، قَالَ تَحَمَّلْت حَمَالَۃً فَأَتَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَسْأَلُہُ فِیہَا ، فَقَالَ : أَقِمْ یَا قَبِیصَۃُ ، حَتَّی تَأْتِیَنَا الصَّدَقَۃُ نَأْمُرْ لَکَ بِہَا ، قَالَ : قَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَا قَبِیصَۃُ ، إنَّ الْمَسْأَلَۃَ لاَ تَحِلُّ إِلاَّ لأَحَدِ ثَلاَثَۃٍ : رَجُلٍ تَحَمَّلَ حَمَالَۃً فَحَلَّتْ لَہُ الْمَسْأَلَۃُ حَتَّی یُصِیبَہَا ، ثُمَّ یُمْسِکُ , وَرَجُلٍ أَصَابَتْہُ جَائِحَۃٌ فَاجْتَاحَتْ مَالَہُ فَحَلَّتْ لَہُ الْمَسْأَلَۃُ حَتَّی یُصِیبَ قِوَامًا مِنْ عَیْشٍ ، ثُمَّ یُمْسِکُ , وَرَجُلٍ أَصَابَتْہُ فَاقَۃٌ حَتَّی یَقُولَ ثَلاَثَۃٌ مِنْ ذَوِی الْحِجَا مِنْ قَوْمِہِ قَدْ أَصَابَتْ فُلاَنًا فَاقَۃٌ , فَحَلَّتْ لَہُ الْمَسْأَلَۃُ حَتَّی یُصِیبَ قِوَامًا مِنْ عَیْشٍ ، ثُمَّ یُمْسِکُ ، یَا قَبِیصَۃُ ، مَا سِوَاہُنَّ مِنَ الْمَسْأَلَۃِ سُحْتٌ یَأْکُلُہَا صَاحِبُہَا۔ (مسلم ۱۰۹۔ ابوداؤد ۱۶۳۷)","Sahih","Musannaf Ibn Abi Shaybah 10788","","","كتاب الزكاة"
"10789","(۱۰۷۸۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ فِی رَجُلٍ سَافَرَ وَہُوَ غَنِیٌّ فَنَفِدَ مَا مَعَہُ فِی سَفَرِہِ وَاحْتَاجَ ؟ قَالَ : یُعْطَی مِنَ الصَّدَقَۃِ فِی سَفَرِہِ لأَنَّہُ ابْنُ السَّبِیلِ۔","","Musannaf Ibn Abi Shaybah 10789","","","كتاب الزكاة"
"10790","(۱۰۷۸۹) حَدَّثَنَا حَفْصٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ حَکِیمِ بْنِ حِزَامٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ یَسْتَغْنِ یُغْنِہِ اللَّہُ , وَمَنْ یَسْتَعْفِفْ یُعِفَّہُ اللَّہُ , وَالْیَدُ الْعُلْیَا خَیْرٌ مِنَ الْیَدِ السُّفْلَی۔ (بخاری ۱۴۲۷۔ مسلم ۹۵)","Sahih","Musannaf Ibn Abi Shaybah 10790","","","كتاب الزكاة"
"10791","(۱۰۷۹۰) ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ وَعُرْوَۃَ ، عَنْ حَکِیمِ بْنِ حِزَامٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْیَدُ الْعُلْیَا خَیْرٌ مِنَ الْیَدِ السُّفْلَی۔ (بخاری ۲۷۵۰۔ ترمذی ۲۴۶۳)","Sahih","Musannaf Ibn Abi Shaybah 10791","","","كتاب الزكاة"
"10792","(۱۰۷۹۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَمِعْتُ أَبَا حَمْزَۃَ یُحَدِّثُ عَنْ ہِلاَلِ بْنِ حِصْنٍ ، قَالَ : نَزَلْتُ دَارَ أَبِی سَعِیدٍ فَضَمَّنِی وَإِیَّاہُ الْمَجْلِسُ فَحَدَّثَنِی ، أَنَّہُ أَصْبَحَ ذَاتَ یَوْمٍ وَقَدْ عَصَبَ عَلَی بَطْنِہِ مِنَ الْجُوعِ ، قَالَ : فَأَتَیْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَدْرَکْتُ مِنْ قَوْلِہِ وَہُوَ یَقُولُ : مَنْ یَسْتَعْفِفْ یُعِفُّہُ اللَّہُ وَمَنْ یَسْتَغْنِ یُغْنِہِ اللَّہُ وَمَنْ سَأَلَنَا إمَّا أَنْ نَبْذُلَ لَہُ , وَإِمَّا أَنْ نُوَاسِیَہُ وَمَنْ یَسْتَغْنِ ، أَو یَسْتَعْفِفْ عَنَّا خَیْرٌ لَہُ مِنْ أَنْ یَسْأَلَنَا ، قَالَ : فَرَجَعْت فَمَا سَأَلْتُہُ شَیْئًا۔ (نسائی ۲۳۶۹۔ احمد ۳/۴۴)","Da'if","Musannaf Ibn Abi Shaybah 10792","","","كتاب الزكاة"
"10793","(۱۰۷۹۲) عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اسْتَغْنِ عَنِ النَّاسِ وَلَوْ بِقِصْمَۃِ سِوَاکٍ۔ (بزار ۹۱۳)","Da'if","Musannaf Ibn Abi Shaybah 10793","","","كتاب الزكاة"
"10794","(۱۰۷۹۳) أَبُو مُعَاوِیَۃَ ، وَابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ، عَنِ الْحَکَمِ، عَنْ عَبْدِالرَّحْمَنِ بْنِ أَبِی لَیْلَی، بِمِثْلِہِ، وَلَمْ یَرْفَعْہُ۔","","Musannaf Ibn Abi Shaybah 10794","","","كتاب الزكاة"
"10795","(۱۰۷۹۴) وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ عَبْدِاللہِ بْنِ دِینَارٍ، عَنِ ابْنِ عُمَرَ، قَالَ: کُنَّا نَتَحَدَّثُ أَنَّ الْیَدَ الْعُلْیَا ہِیَ الْمُتَعَفِّفَۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 10795","","","كتاب الزكاة"
"10796","(۱۰۷۹۵) ابْنُ فُضَیْلٍ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْیَدُ الْعُلْیَا خَیْرٌ مِنَ الْیَدِ السُّفْلَی وَخَیْرُ الصَّدَقَۃِ مَا أَبْقَتْ غِنًی وَابْدَأْ بِمَنْ تَعُولُ۔","Hasan","Musannaf Ibn Abi Shaybah 10796","","","كتاب الزكاة"
"10797","(۱۰۷۹۷) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنْ أَسْوَدَ بْنِ ہِلاَلٍ ، عَنْ ثَعْلَبَۃَ بْنِ زَہْدَمٍ ، قَالَ : انْتَہَی قَوْمٌ مِن ثَعْلَبَۃَ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یَخْطُبُ وَہُوَ یَقُولُ : یَدُ الْمُعْطِی : الْعُلْیَا وَیَدُ السَّائِلِ : السُّفْلَی , وَابْدَأْ بِمَنْ تَعُولُ : أُمَّک وَأَبَاک وَأُخْتَکَ وَأَخَاک وَأَدْنَاک فَأَدْنَاک۔ (طیالسی ۱۲۵۷۔ مسندہ ۶۳۴)","Hasan","Musannaf Ibn Abi Shaybah 10797","","","كتاب الزكاة"
"10798","(۱۰۷۹۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الْمُغِیرَۃِ بْنِ النُّعْمَانِ ، عَنْ عَبْدِ اللہِ بْنِ الأَقْنَعِ الْبَاہِلِیِّ، عَنِ الأَحْنَفِ بْنِ قَیْسٍ ، قَالَ : کُنْتُ جَالِسًا فِی مَجْلِسٍ فِی الْمَدِینَۃِ , فَأَقْبَلَ رَجُلٌ لاَ تَرَی حَلْقَۃٌ إِلاَّ فَرُّوا مِنْہُ حَتَّی انْتَہَی إلَی الْحَلْقَۃِ الَّتِی کُنْت فِیہَا , فَثَبَتُّ وَفَرُّوا ، فَقُلْت : مَنْ أَنْتَ ؟ قَالَ : أَبُو ذَرٍّ صَاحِبُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَقُلْت : مَا یَفِرُّ النَّاسُ مِنْک ؟ قَالَ : إنِّی أَنْہَاہُمْ ، عَنِ الْکُنُوزِ ، قَالَ : قُلْتُ : إنَّ أَعْطِیَاتِنَا قَدْ بَلَغَتْ وَارْتَفَعَتْ فَتَخَافُ عَلَیْنَا مِنْہَا ، قَالَ : أَمَّا الْیَوْمُ فَلاَ وَلَکِنَّہَا یُوشِکُ أَنْ تَکُونَ أَثْمَانَ دِینِکُمْ فَدَعُوہُمْ وَإِیَّاہَا۔","Hasan","Musannaf Ibn Abi Shaybah 10798","","","كتاب الزكاة"
"10799","(۱۰۷۹۹) ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، قَالَ مَرَرْنَا عَلَی أَبِی ذَرٍّ بِالرَّبَذَۃِ فَسَأَلْنَاہ عَنْ مَنْزِلِہِ ، قَالَ: کُنْتُ بِالشَّامِ فَقَرَأَتْ ہَذِہِ الآیَۃَ (وَالَّذِینَ یَکْنِزُونَ الذَّہَبَ وَالْفِضَّۃَ ، وَلاَ یُنْفِقُونَہَا فِی سَبِیلِ اللہِ فَبَشِّرْہُمْ بِعَذَابٍ أَلِیمٍ) ، فَقَالَ : مُعَاوِیَۃُ إنَّمَا ہِیَ فِی أَہْلِ الْکِتَابِ فَقُلْنَا : إِنَّہَا لَفِینَا وَفِیہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 10799","","","كتاب الزكاة"
"10800","(۱۰۸۰۰)ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ ، عَنْ مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : وَالَّذِی لاَ إلَہَ غَیْرُہُ لاَ یُعَذِّبُ اللَّہُ رَجُلاً یَکْنِزُ فَیَمَسُّ دِرْہَمٌ دِرْہَمًا ، وَلاَ دِینَارٌ دِینَارًا , وَلَکِنْ یُوَسِّعُ جِلْدَہُ حَتَّی یُوضَعَ کُلُّ دِرْہَمٍ وَدِینَارٍ عَلَی حِدَتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 10800","","","كتاب الزكاة"
"10801","(۱۰۸۰۱) أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی وَائِلٍ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ یَقُولُ فِی قولہ تعالی : {سَیُطَوَّقُونَ مَا بَخِلُوا بِہِ یَوْمَ الْقِیَامَۃِ} قَالَ {یُطَوَّقُونَ} ثُعْبَانًا بِفِیہِ زَبِیبَتَانِ یَنْہَشُہُ یَقُولُ أَنَا مَالُکَ الَّذِی بَخِلْتَ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 10801","","","كتاب الزكاة"
"10802","(۱۰۸۰۲) یَعْلَی بْنُ عُبَیْدٍ ، قَالَ : حدَّثَنَا عَبْدُ الْمَلِکِ بْنُ أَبِی سُلَیْمَانَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا مِنْ صَاحِبِ إبِلٍ ، وَلاَ بَقَرٍ ، وَلاَ غَنَمٍ لاَ یُؤَدِّی حَقَّہَا إِلاَّ قَعَدَ لَہَا یَوْمَ الْقِیَامَۃِ بِقَاعٍ قَرْقَرٍ , تَطَؤُہُ ذَاتُ الظِّلْفِ بِظِلْفِہَا , وَتَنْطَحُہُ ذَاتُ الْقَرْنِ بِقَرْنِہَا , وَلَیْسَ فِیہَا یَوْمَئِذٍ جَمَّائُ ، وَلاَ مَکْسُورَۃُ الْقَرْنِ قَالُوا : یَا رَسُولَ اللہِ ، وَمَا حَقُّہَا ؟ قَالَ إطْرَاقُ فَحْلِہَا , وَإِعَارَۃُ دَلْوِہَا , وَمَنِیحَتُہَا وَحَلْبُہَا عَلَی الْمَاء وَحَمْلٌ عَلَیْہَا فِی سَبِیلِ اللہِ۔ (مسلم ۲۷۔ احمد ۳/۳۲۱)","Sahih","Musannaf Ibn Abi Shaybah 10802","","","كتاب الزكاة"
"10803","(۱۰۸۰۳) زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنِی مُوسَی بْنُ عُبَیْدَۃَ ، قَالَ : حَدَّثَنِی عِمْرَانُ بْنُ أَبِی أُنَیْسٍ ، عَنْ مَالِکِ بْنِ أَوْسِ بْنِ الْحَدَثَانِ ، عَنْ أَبِی ذَرٍّ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَوْ حَبِیبِی یَقُولُ : فِی الإِبِلِ صَدَقَتُہَا مَنْ جَمَعَ دِینَارًا ، أَوْ دِرْہَمًا ، أَوْ تِبْرًا ، أَوْ فِضَّۃً ، لاَ یُعِدُّہُ لِغَرِیمٍ ، وَلاَ یُنْفِقُہُ فِی سَبِیلِ اللہِ فَہُوَ کَیٌّ یُکْوَی بِہِ یَوْمَ الْقِیَامَۃِ۔ (دارقطنی ۲۷۔ بیہقی ۱۴۷)","Da'if","Musannaf Ibn Abi Shaybah 10803","","","كتاب الزكاة"
"10804","(۱۰۸۰۴) جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ فِی قولہ تعالی : {سَیُطَوَّقُونَ مَا بَخِلُوا بِہِ یَوْمَ الْقِیَامَۃِ} قَالَ : طَوْقٌ مِنْ نَارٍ۔","","Musannaf Ibn Abi Shaybah 10804","","","كتاب الزكاة"
"10805","(۱۰۸۰۵) خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ مَسْرُوقٍ فِی قولہ تعالی : (سَیُطَوَّقُونَ مَا بَخِلُوا بِہِ یَوْمَ الْقِیَامَۃِ) قَالَ : ہُوَ الرَّجُلُ یَرْزُقُہُ اللَّہُ الْمَالَ فَیَمْنَعُ قَرَابَتَہُ الْحَقَّ الَّذِی فِیہِ فَیُجْعَلُ حَیَّۃً فَیُطَوَّقُہَا فَیَقُولُ : مَا لِی وَمَا لَکَ ؟ فَیَقُولُ الْحَیَّۃُ : أَنَا مَالُک۔","","Musannaf Ibn Abi Shaybah 10805","","","كتاب الزكاة"
"10806","(۱۰۸۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ مُحَمَّدِ بْنِ زِیَادٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أُتِیَ بِتَمْرٍ مِنْ تَمْرِ الصَّدَقَۃِ فَتَنَاوَلَ الْحَسَنُ بْنُ عَلِیٍّ تَمْرَۃً فَلاَکَہَا فِی فِیہِ ، فَقَالَ لَہُ : رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَخٍْ کَخٍْ إنَّا لاَ تَحِلُّ لَنَا الصَّدَقَۃُ۔ (بخاری ۱۴۹۱۔ مسلم ۱۶۱)","Sahih","Musannaf Ibn Abi Shaybah 10806","","","كتاب الزكاة"
"10807","(۱۰۸۰۷) حَدَّثَنَا وَکِیعٌ وَأَبُو أُسَامَۃَ ، عَنْ ثَابِتِ بْنِ عُمَارَۃَ ، عَنْ شَیْخٍ یُقَالُ لَہُ رَبِیعَۃُ بْنُ شَیْبَانَ ، قَالَ : قُلْتُ لِلْحَسَنِ بْنِ عَلِیٍّ رضی اللَّہُ عَنْہُما مَا تَذْکُرُ ، عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَمَا تَعْقِلُ عَنْہُ ، قَالَ أَخَذْت تَمْرَۃً مِنْ تَمْرِ الصَّدَقَۃِ فَلُکْتہَا ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّا لاَ تَحِلُّ لَنَا الصَّدَقَۃُ۔n(احمد ۱/۲۰۰۔ طبرانی ۲۷۴۱)","Sahih","Musannaf Ibn Abi Shaybah 10807","","","كتاب الزكاة"
"10808","(۱۰۸۰۸) وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ طَلْحَۃَ ، عَنْ أَنَسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَجَدَ تَمْرَۃً ، فَقَالَ : لَوْلاَ أَنْ تَکُونَ مِنَ الصَّدَقَۃِ لأَکَلْتہَا۔ (بخاری ۲۰۵۵۔ مسلم ۱۶۶)","Sahih","Musannaf Ibn Abi Shaybah 10808","","","كتاب الزكاة"
"10809","(۱۰۸۰۹) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عِکْرِمَۃَ ، قَالَ : لاَ تَحِلُّ الصَّدَقَۃُ لِبَنِی ہَاشِمٍ ، وَلاَ لِمَوَالِیہِمْ۔","","Musannaf Ibn Abi Shaybah 10809","","","كتاب الزكاة"
"10810","(۱۰۸۱۰) غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنِ ابْنِ أَبِی رَافِعٍ ، عَنْ أَبِی رَافِعٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعَثَ رَجُلاً مِنْ بَنِی مَخْزُومٍ عَلَی الصَّدَقَۃِ ، فَقَالَ لأَبِی رَافِعٍ تَصْحَبُنِی کَیْمَا تُصِیبَ مِنْہَا ، فَقَالَ : لاَ حَتَّی آتِیَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَانْطَلَقَ إلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَسَأَلَہُ فَقَالَ لَہُ : إنَّ الصَّدَقَۃَ لاَ تَحِلُّ لَنَا , وَمَوْلَی الْقَوْمِ مِنْ أَنْفُسِہِمْ۔ (ترمذی ۶۵۷۔ ابوداؤد ۱۶۴۷)","Sahih","Musannaf Ibn Abi Shaybah 10810","","","كتاب الزكاة"
"10811","(۱۰۸۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ شَرِیکٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، أَنَّ خَالِدَ بْنَ سَعِیدٍ بَعَثَ إلَی عَائِشَۃَ بِبَقَرَۃٍ مِنَ الصَّدَقَۃِ فَرَدَّتْہَا وَقَالَتْ إنَّا آلَ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ تَحِلُّ لَنَا الصَّدَقَۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 10811","","","كتاب الزكاة"
"10812","(۱۰۸۱۲) عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی قُرَّۃَ الْکِنْدِیِّ ، عَنْ سَلْمَانَ ، قَالَ احْتَطَبْت حَطَبًا فَبِعْتُہُ ، فَأَتَیْت بِہِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَوَضَعْتُہُ بَیْنَ یَدَیْہِ ، فَقَالَ : مَا ہَذَا قُلْتُ صَدَقَۃٌ، فَقَالَ لأَصْحَابِہِ کُلُوا ، وَلَمْ یَأْکُلْ۔ (احمد ۵/۴۳۸۔ حاکم ۱۰۸)","Hasan","Musannaf Ibn Abi Shaybah 10812","","","كتاب الزكاة"
"10813","(۱۰۸۱۳) وَ[corrupt]ِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : أَتَیْتُ أُمَّ کُلْثُومٍ ابْنَۃَ عَلِیٍّ بِشَیْئٍ مِنَ الصَّدَقَۃِ فَرَدَّتْہَا وَقَالَتْ حَدَّثَنِی مَوْلًی لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُقَالُ لَہُ مِہْرَانُ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّا آلَ مُحَمَّدٍ لاَ تَحِلُّ لَنَا الصَّدَقَۃُ وَمَوْلَی الْقَوْمِ مِنْہُمْ۔ (احمد ۳/۴۴۸۔ عبدالرزاق ۶۹۴۲)","Da'if","Musannaf Ibn Abi Shaybah 10813","","","كتاب الزكاة"
"10814","(۱۰۸۱۴) الْحَسَنُ بْنُ مُوسَی ، عَنْ زُہَیْرٍ ، عَنْ عَبْدِ اللہِ بْنِ عِیسَی ، عَنْ أَبِیہِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ أَبِیہِ ، قَالَ : کُنْتُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی بَیْتِ الصَّدَقَۃِ ، قَالَ : فَجَائَ الْحَسَنُ بْنُ عَلِیٍّ فَأَخَذَ تَمْرَۃً فَأَخَذَہَا مِنْہُ فَاسْتَخْرَجَہَا ، وَقَالَ : إنَّا لاَ تَحِلُّ لَنَا الصَّدَقَۃُ۔ (احمد ۴/۳۴۸۔ دارمی ۱۶۴۳)","Sahih","Musannaf Ibn Abi Shaybah 10814","","","كتاب الزكاة"
"10815","(۱۰۸۱۵) ابْنُ فُضَیْلٍ ، عَنْ أَبِی حَیَّانَ ، عَنْ یَزِیدَ بْنِ حَیَّانَ ، قَالَ : انْطَلَقْت أَنَا وَحُصَیْنُ بْنُ عُقْبَۃَ إلَی زَیْدِ بْنِ أَرْقَمَ ، فَقَالَ لَہُ یَزِیدُ وَحُصَیْنٌ مَنْ أَہْلُ بَیْتِہِ , أَلَیْسَ نِسَاؤُہُ مِنْ أَہْلِ بَیْتِہِ ؟ قَالَ : نِسَاؤُہُ مِنْ أَہْلِ بَیْتِہِ , وَلَکِنْ أَہْلُ بَیْتِہِ مَنْ حُرِمَ الصَّدَقَۃَ بعدہ، فَقَالَ لَہُ حُصَیْنٌ : وَمَنْ ہُمْ ؟ قَالَ : ہُمْ آلُ عَبَّاسٍ ، وَآلُ عَلِیٍّ ، وَآلُ جَعْفَرٍ ، وَآلُ عَقِیلٍ، فَقَالَ لَہُ حُصَیْنٌ عَلَی ہَؤُلاَئِ تَحْرُمُ الصَّدَقَۃُ ، قَالَ نَعَمْ۔ (مسلم ۳۶۔ احمد ۴/۳۶۷)","Sahih","Musannaf Ibn Abi Shaybah 10815","","","كتاب الزكاة"
"10816","(۱۰۸۱۶) کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : حدَّثَنَا ثَابِتُ بْنُ الْحَجَّاجِ ، قَالَ بَلَغَنِی ، أَنَّ رَجُلَیْنِ مِنْ بَنِی عَبْدِ الْمُطَّلِبِ أَتَیَا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْأَلاَنِہِ مِنَ الصَّدَقَۃِ ، فَقَالَ : لاَ وَلَکِنْ إذَا رَأَیْتُمَا عِنْدِی شَیْئًا مِنَ الْخُمُسِ فَأْتِیَانِی۔","","Musannaf Ibn Abi Shaybah 10816","","","كتاب الزكاة"
"10817","(۱۰۸۱۷) وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ خُصَیْفٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ آلُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ تَحِلُّ لَہُمُ الصَّدَقَۃُ فَجَعَلَ لَہُمْ خُمُسَ الْخُمْسِ۔ (نسائی ۴۴۴۹)","","Musannaf Ibn Abi Shaybah 10817","","","كتاب الزكاة"
"10818","(۱۰۸۱۸) الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا مُعَرِّفُ بْنُ وَاصِلٍ ، قَالَ حَدَّثَتْنِی حَفْصَۃُ بِنْتُ طَلْقٍ قَالَتْ حَدَّثَنِی جَدِّی رُشَیْدُ بْنُ مَالِکٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّا لاَ تَحِلُّ لَنَا الصَّدَقَۃُ۔ (بخاری ۱۱۳۱۔ احمد ۳/۴۸۹)","Da'if","Musannaf Ibn Abi Shaybah 10818","","","كتاب الزكاة"
"10819","(۱۰۸۱۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ عُمَرَ ، عَنْ مَحْمُودِ بْنِ لَبِیدٍ ، عَنْ رَافِعِ بْنِ خَدِیجٍ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : الْعَامِلُ عَلَی الصَّدَقَۃِ بِالْحَقِّ کَالْغَازِی فِی سَبِیلِ اللہِ حَتَّی یَرْجِعَ إلَی بَیْتِہِ۔ (ترمذی ۶۴۵۔ ابوداؤد ۲۹۲۹)","Hasan","Musannaf Ibn Abi Shaybah 10819","","","كتاب الزكاة"
"10820","(۱۰۸۲۰) أَبُو أُسَامَۃَ ، عَنْ بُرِیدِ بْنِ عبد اللہِ بْنِ أَبِی بُرْدَۃَ ، عَنْ جَدِّہِ ، عَنْ أَبِی مُوسَی ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ الْخَازِنَ الأَمِینَ الَّذِی یُعْطِی مَا أُمِرَ بِہِ کَامِلاً مُوَفَّرًا طَیِّبَۃً بِہِ نَفْسُہُ حِینَ یَدْفَعُہُ إلَی الَّذِی أُمِرَ لہ بِہِ أَحَدُ الْمُتَصَدِّقَیْنِ۔ (بخاری ۱۴۳۸۔ ابوداؤد ۱۶۸۱)","Sahih","Musannaf Ibn Abi Shaybah 10820","","","كتاب الزكاة"
"10821","(۱۰۸۲۱) غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنِ الْحَسَنِ بْنِ مُسْلِمٍ الْمَکِّیِّ ، قَالَ بَعَثَ عُمَرُ بْنُ الْخَطَّابِ رَجُلاً مِنْ ثَقِیفٍ عَلَی الصَّدَقَۃِ فَرَآہُ بَعْدَ ذَلِکَ الْیَوْمِ ، فَقَالَ : أَلاَ أَرَاک وَلَکَ کَأَجْرِ الْغَازِی فِی سَبِیلِ اللہِ۔","Hasan","Musannaf Ibn Abi Shaybah 10821","","","كتاب الزكاة"
"10822","(۱۰۸۲۲) أَبُو أُسَامَۃَ وَوَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زِیَادِ بْنِ أَبِی عُثْمَانَ ، عَنْ ثَابِتٍ ، عَنِ الْحَسَنِ ، قَالَ مَنْ دُفِعَتْ إلَیْہِ الصَّدَقَۃُ فَوَضَعَہَا مَوَاضِعَہَا فَلَہُ أَجْرُ صَاحِبِہَا۔","","Musannaf Ibn Abi Shaybah 10822","","","كتاب الزكاة"
"10823","(۱۰۸۲۳) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، أن عُمَرَ بْنِ الْخَطَّابِ جَعَلَ عَلَی أَہْلِ السَّوَادِ عَلَی کُلِّ جَرِیبٍ قَفِیزًا وَدِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 10823","","","كتاب الزكاة"
"10824","(۱۰۸۲۴) حَفْصٌ، عَنِ ابْنِ أَبِی عَرُوبَۃَ، عَنْ قَتَادَۃَ، عَنْ أَبِی مِجْلَزٍ، أَنَّ عُمَرَ جَعَلَ عَلَی جَرِیبِ النَّخْلِ ثَمَانیَۃَ دَرَاہِمَ۔","Da'if","Musannaf Ibn Abi Shaybah 10824","","","كتاب الزكاة"
"10825","(۱۰۸۲۵) عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی عَوْنٍ مُحَمَّدِ بْنِ عُبَیْدِ اللہِ الثَّقَفِیِّ ، قَالَ وَضَعَ عُمَرُ بْنُ الْخَطَّابِ عَلَی أَہْلِ السَّوَادِ عَلَی کُلِّ جَرِیبِ أَرضٍ یَبْلُغُہُ الْمَائُ عَامِرًا وَغَامِرًا دِرْہَمًا وَقَفِیزًا مِنْ طَعَامٍ , وَعَلَی الْبَسَاتِینِ عَلَی کُلِّ جَرِیبِ أَرضٍ عَشَرَۃَ دَرَاہِمَ وَعَشَرَۃَ أَقْفِزَۃً من طَعَامٍ وَعَلَی الْکُرُومِ عَلَی کُلِّ جَرِیبِ أَرْضٍ عَشَرَۃَ دَرَاہِمَ وَعَشَرَۃَ أَقْفِزَۃً طَعَامٍ , وَعَلَی الرِّطَابِ عَلَی کُلِّ جَرِیبِ أَرْضٍ خَمْسَۃَ دَرَاہِمَ , وَخَمْسَۃَ أَقْفِزَۃَ طَعَامٍ ، وَلَمْ یَضَعْ عَلَی النَّخْلِ شَیْئًا , وَجَعَلَہُ تَبَعًا لِلأَرْضِ , وَعَلَی رُؤُوسِ الرِّجَالِ عَلَی الْغَنِیِّ ثَمَانِیَۃً وَأَرْبَعِینَ دِرْہَمًا , وَعَلَی الْوَسَطِ أَرْبَعَۃً وَعِشْرِینَ دِرْہَمًا , وَعَلَی الْفَقِیرِ اثْنَیْ عَشَرَ دِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 10825","","","كتاب الزكاة"
"10826","(۱۰۸۲۶) أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ مُحَمَّدِ بْنِ عُبَیْدِ اللہِ ، قَالَ وَضَعَ عُمَرُ عَلَی السَّوَادِ فَذَکَرَ مِثْلَ حَدِیثِ ابْنِ مُسْہِرٍ۔ (ابو عبید ۱۷۴)","","Musannaf Ibn Abi Shaybah 10826","","","كتاب الزكاة"
"10827","(۱۰۸۲۷) أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ بَعَثَ عُمَرُ عُثْمَانَ بْنَ حُنَیْفٍ عَلَی مِسَاحَۃِ الأَرْضِ فَوَضَعَ عُثْمَانُ عَلَی الْجَرِیبِ مِنَ الْکَرْمِ عَشَرَۃَ دَرَاہِمَ وَعَلَی جَرِیبِ النَّخْلِ ثَمَانیَۃَ دَرَاہِمَ وَعَلَی جَرِیبِ الشَّعِیرِ دِرْہَمَیْنِ، وَجَعَلَ عَلَی کُلِّ رَأْسٍ فِی السَّنَۃِ أَرْبَعَۃً وَعِشْرِینَ دِرْہَمًا، وَعَطَّلَ النِّسَائَ وَالصِّبْیَانَ۔","","Musannaf Ibn Abi Shaybah 10827","","","كتاب الزكاة"
"10828","(۱۰۸۲۸) وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ عُمَرَ ، أَنَّہُ بَعَثَ عُثْمَانَ بْنَ حُنَیْفٍ عَلَی السَّوَادِ فَوَضَعَ عَلَی کُلِّ جَرِیبٍ عَامِرًا وَغَامِرًا یَنَالُہُ الْمَائُ دِرْہَمًا وَقَفِیزًا , یَعْنِی الْحِنْطَۃَ وَالشَّعِیرَ , وَعَلَی کُلِّ جَرِیبِ الْکَرْمِ عَشَرَۃَ دَرَاہِمَ , وَعَلَی کُلِّ جَرِیبِ الرَّطْبِ خَمْسَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 10828","","","كتاب الزكاة"
"10829","(۱۰۸۲۹) وَکِیعٌ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ أَبَانَ بْنِ تَغْلِبَ ، عَنْ رَجُلٍ ، عَنْ عُمَرَ ، أَنَّہُ وَضَع عَلَی النَّخْلِ عَلَی الرَّقْلَتَیْنِ دِرہَمًا وَعَلَی الْفَارِسِیَّۃِ دِرْہَمًا۔n وَقَالَ وَکِیعٌ مَرَّۃً : عَنْ أَبَانَ ، عَنْ إبْرَاہِیمَ۔","Da'if","Musannaf Ibn Abi Shaybah 10829","","","كتاب الزكاة"
"10830","(۱۰۸۳۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ قَالَ ؛ فِی الرَّجُلِ إذَا أُعْطِیَ مِنْ صَدَقَۃِ الْفِطْرِ ، قَالَ : إذَا اجْتَمَعَتْ عِنْدَہُ الآصع أَعْطَی۔","","Musannaf Ibn Abi Shaybah 10830","","","كتاب الزكاة"
"10831","(۱۰۸۳۱) حَفْصٌ ، عَنْ عَاصِمٍ ، عَنْ أَبِی الْعَالِیَۃِ وَالشَّعْبِیِّ ، وَابْنِ سِیرِینَ قَالُوا : صَدَقَۃُ الْفِطْرِ عَلَی الْغَنِیِّ وَالْفَقِیرِ۔","","Musannaf Ibn Abi Shaybah 10831","","","كتاب الزكاة"
"10832","(۱۰۸۳۲) وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُثَنًّی ، عَنْ عَطَائٍ ، قَالَ یَأْخُذُ وَیُعْطِی۔","","Musannaf Ibn Abi Shaybah 10832","","","كتاب الزكاة"
"10833","(۱۰۸۳۳) مَالِکُ بْنُ إسْمَاعِیلَ ، عَنْ مِنْدَلٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ تُعْطِی صَدَقَۃَ الْفِطْرِ مَنْ تَحِلُّ لَہُ الصَّدَقَۃُ ، قَالَ : وَقَالَ الزُّہْرِیُّ یُؤَدِّی حَقَّ اللہِ وَیَأْخُذُ۔","","Musannaf Ibn Abi Shaybah 10833","","","كتاب الزكاة"
"10834","(۱۰۸۳۴) عَفَّانُ ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، عَنْ قَتَادَۃَ ، قَالَ یُعْطِی۔","","Musannaf Ibn Abi Shaybah 10834","","","كتاب الزكاة"
"10835","(۱۰۸۳۵) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ لَمْ یَبْلُغْنَا أن أَحَدا مِنْ وُلاَۃِ ہَذِہِ الأُمَّۃِ الَّذِینَ کَانُوا بِالْمَدِینَۃِ , أَبُو بَکْرٍ ، وَعُمَرُ , وَعُثْمَانَ , أَنَّہُمْ کَانُوا یَثْنُونَ الصَّدَقَۃَ لَکِنْ یَبْعَثُونَ عَلَیْہَا کُلَّ عَامٍ فِی الْخِصْبِ وَالْجَدْبِ لأَنَّ أَخْذَہَا سُنَّۃٌ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 10835","","","كتاب الزكاة"
"10836","(۱۰۸۳۶) مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی سُلَیْمَانُ الأَحْوَلُ ، عَنْ طَاوُوسٍ ، أَنَّہُ قَالَ إذْ تَدَارَکَتِ الصَّدَقَتَانِ فَلاَ یُؤْخَذُ الأُولَی کَالْجِزْیَۃِ۔","","Musannaf Ibn Abi Shaybah 10836","","","كتاب الزكاة"
"10837","(۱۰۸۳۷) سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الْوَلِیدِ بْنِ کَثِیرٍ ، عَنْ حَسَنِ بْنِ حَسَنٍ ، عَنْ أُمِّہِ فَاطِمَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ ثِنَا فِی الصَّدَقَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 10837","","","كتاب الزكاة"
"10838","(۱۰۸۳۸) حَدَّثَنَا ہُشَیْمٌ، عَنْ رَہْطٍ ثَلاَثَۃٍ، عَنْ أَبِی جَعْفَرٍ، قَالَ: لاَ بَأْسَ بِالصَّدَقَۃِ مِنْ بَنِی ہَاشِمٍ بَعْضِہِمْ عَلَی بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 10838","","","كتاب الزكاة"
"10839","(۱۰۸۳۹) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ قَالَ: کَانَ یُقَالُ إنَّمَا الصَّدَقَاتُ لِلْفُقَرَائِ وَالْمُہَاجِرِینَ۔","","Musannaf Ibn Abi Shaybah 10839","","","كتاب الزكاة"
"10840","(۱۰۸۴۰) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن حُمَیْدٍ ، عَن بَکر : أَنَّ عُثْمَانَ کَانَ یُعْطِی صَدَقَۃَ الْفِطْرِ ، عَنِ الْحَبَلِ۔","","Musannaf Ibn Abi Shaybah 10840","","","كتاب الزكاة"
"10841","(۱۰۸۴۱) عَبْدُالْوَہَّابِ الثَّقَفِیُّ، عَنْ أَیُّوبَ، عَنْ أَبِی قِلاَبَۃَ، قَالَ: کَانُوا یُعْطُونَ صَدَقَۃَ الْفِطْرِ حَتَّی یُعْطُونَ، عَنِ الْحَبَلِ۔","","Musannaf Ibn Abi Shaybah 10841","","","كتاب الزكاة"
"10842","(۱۰۸۴۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَخَذَ الْمُصَدِّقُ سِنًّا فَوْقَ سِنٍّ رَدَّ عَلَیْہِمْ شَاتَیْنِ ، أَوْ عِشْرِینَ دِرْہَمًا ، وَإِذَا أَخَذَ سِنًّا دُونَ سِنٍّ رَدُّوا عَلَیْہِ شَاتَیْنِ ، أَوْ عِشْرِینَ دِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 10842","","","كتاب الزكاة"
"10843","(۱۰۸۴۳) مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی خَلاَّدٌ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، أَنَّہُ قَالَ لَہُ ، فَإِنْ لَمْ تَجِدِ السِّنَّ الَّذِی دُونَہَا أَخَذْت السِّنَّ الَّذِی فَوْقَہَا وَرَدَدْت إلَی صَاحِبِ الْمَاشِیَۃِ شَاتَیْنِ ، أَوْ عِشْرِینَ دِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 10843","","","كتاب الزكاة"
"10844","(۱۰۸۴۴) مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ الأَنْصَارِیِّ ، أَنَّ عُمَرَ کَتَبَ إلَی بَعْضِ عُمَّالِہِ أَنْ لاَ تَأْخُذُوا مِنْ رَجُلٍ لَمْ تَجِدُوا فِی إبِلِہِ السِّنَّ الَّتِی عَلَیْہِ إِلاَّ تِلْکَ السِّنَّ خُذُوا شَروی إبِلِہِ ، أَوْ قِیمَۃَ عَدْلٍ۔","","Musannaf Ibn Abi Shaybah 10844","","","كتاب الزكاة"
"10845","(۱۰۸۴۵) غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ فِی رَجُلٍ وَجَبَتْ عَلَیْہِ فَرِیضَۃٌ فِی إبِلِہِ لَمْ تَکُنْ عِنْدَہُ ، قَالَ : فَقَالَ : یَتَرَادَّانِ الْفَضْلَ فِیمَا بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 10845","","","كتاب الزكاة"
"10846","(۱۰۸۴۶) الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ إِنْ أَخَذَ سِنًّا دُونَ سِنٍّ رَدَّ شَاتَیْنِ ، أَوْ عَشَرَۃَ دَرَاہِمَ۔","Hasan","Musannaf Ibn Abi Shaybah 10846","","","كتاب الزكاة"
"10847","(۱۰۸۴۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ الْمُسْتَوْرِدِ ، قَالَ : سَمِعْتُ أَبَا قِلاَبَۃَ یُحَدِّثُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ، قَالَ : بَعَثَ أَبُو بَکْرٍ الْمُصَدِّقِینَ فَأَمَرَہُمْ أَنْ یَبِیعُوا الْجَذَعَۃَ بِأَرْبَعِینَ وَالْحِقَّۃَ بِثَلاَثِینَ ، وَابْنَ لَبُونٍ بِعِشْرِینَ , وَبِنْتَ مَخَاضٍ بِعَشَرَۃٍ , فَانْطَلَقُوا فَبَاعُوا مَا بَاعُوا بِقِیمَۃِ أَبِی بَکْرٍ ، ثُمَّ رَجَعُوا حَتَّی إذَا کَانَ الْعَامُ الْمُقْبِلُ بَعَثَہُمْ فَقَالُوا : لَوْ شِئْنَا أَنْ نَزْدَادَ ازْدَدْنَا ، فَقَالَ : زِیدُوا فِی کُلِّ سِنٍّ عَشَرَۃً ، فَلَمَّا أن کَانَ الْعَامُ الْمُقْبِلُ بَعَثَہُمْ فَقَالُوا : لَوْ شِئْنَا أَنْ نَزْدَادَ ازْدَدْنَا شَیْئًا ، فَلَمَّا وَلِیَ عُمَرُ بَعَثَ عُمَّالَہُ بِقِیمَۃِ أَبِی بَکْرٍ الآخِرَۃِ حَتَّی إذَا کَانَ الْعَامُ الْمُقْبِلُ ، قَالَ الْعُمَّالُ لَوْ شِئْنَا أَنْ نَزْدَادَ ازْدَدْنَا ، فَقَالَ : زِیدُوا فِی کُلِّ سِنٍّ عَشْرَۃً حَتَّی إذَا کَانَ الْعَامُ الْمُقْبِلُ بَعَثَہُمْ بِالْقِیمَۃِ الآخِرَۃِ فَقَالُوا : لَوْ شِئْنَا أَنْ نَزْدَادَ ازْدَدْنَا ، قَالَ : لاَ حَتَّی إذَا وَلِیَ عُثْمَانُ بَعَثَ بِقِیمَۃِ عُمَرَ الآخِرَۃِ حَتَّی إذَا کَانَ الْعَامُ الْمُقْبِلُ قَالُوا : لَوْ شِئْنَا أَنْ نَزْدَادَ ازْدَدْنَا ، قَالَ : زِیدُوا فِی کُلِّ سِنٍّ عَشَرَۃً حَتَّی إذَا کَانَ الْعَامُ الْمُقْبِلُ قَالُوا : لَوْ شِئْنَا أَنْ نَزْدَادَ ازْدَدْنَا ، قَالَ : لاَ , فَلَمَّا وَلِیَ مُعَاوِیَۃُ بَعَثَ بِقِیمَۃِ عُثْمَانَ الآخِرَۃِ ، فَلَمَّا کَانَ الْعَامُ الْمُقْبِلُ قَالُوا : لَوْ شِئْنَا أَنْ نَزْدَادَ ازْدَدْنَا ، قَالَ : زِیدُوا فِی کُلِّ سِنٍّ عَشَرَۃً , حَتَّی إذَا کَانَ الْعَامُ الْمُقْبِلُ قَالُوا : لَوْ شِئْنَا أَنْ نَزْدَادَ ازْدَدْنَا ، قَالَ : خُذُوا الْفَرَائِضَ بِأَسْنَانِہَا ، ثُمَّ سَمُّوہَا وَأَعْلِنُوہَا ، ثُمَّ خالِسُوہُمْ لِلْبَیْعِ فَمَا اسْتَطَاعُوا أن ینتقصوا وَمَا اسْتَطَعْتُمْ أَنْ تَزْدَادُوا فَازْدَادُوا ، قَالَ عَبْدُ اللہِ : فَرَأَیْت عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَأَنَّہُ لَمْ یَرَ بِذَلِکَ بَأْسًا ، فَقَالَ لأَبِی قِلاَبَۃَ : فَکَیْفَ کَانَتْ صَدَقَۃُ الْغَنَمِ ؟ قَالَ : کَانَتِ الصَّدَقَۃُ تُؤْخَذُ فَتُقْسَمُ فِی فُقَرَائِ أَہْلِ الْبَادِیَۃِ حَتَّی إذْ کَانَ عَبْدُ الْمَلِکِ بْنُ مَرْوَانَ أَمَرَ بِہَا فَقُسِمَتْ أَخْمَاسًا فَجَعَلَ لِلْمِسْکِینَۃِ خُمُسًا مِنْہَا ، ثُمَّ لَمْ یَزَلْ ذَلِکَ إلَی الْیَوْمِ۔","","Musannaf Ibn Abi Shaybah 10847","","","كتاب الزكاة"
"10848","(۱۰۸۴۸) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أنَّہُ کَانَ یقول : الجوامیس بمنزلۃ البقر۔","","Musannaf Ibn Abi Shaybah 10848","","","كتاب الزكاة"
"10849","(۱۰۸۴۹) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ قَالَ فِی رَجُلٍ فَرَّطَ فِی زَکَاتِہِ حَتَّی ذَہَبَ مَالُہُ ، قَالَ ہُوَ دَیْنٌ عَلَیْہِ حَتَّی یَقْضِیَہُ۔","","Musannaf Ibn Abi Shaybah 10849","","","كتاب الزكاة"
"10850","(۱۰۸۵۰) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ قَالَ : إذَا کَانَ فِی الأَرْضِ بُرٌّ وَشَعِیرٌ کُلُّ وَاحِدٍ مِنْہَا أَقَلُّ مِنْ خَمْسَۃِ أَوْسَاقٍ فَإِذَا جَمَعَہُمَا کَانَ فیہِمَا خَمْسَۃُ أَوْسَاقٍ ، أَوْ أَکْثَرُ کَانَ فِیہِمَا الصَّدَقَۃُ لأَنَّ کُلَّہُ زَرْعٌ فَإِذَا کَانَ بُرٌّ وَزَبِیبٌ وَہُوَ لاَ یَبْلُغُ خَمْسَۃَ أَوْسَاقٍ فَلَیْسَ فِیہِ شَیْئٌ حَتَّی یَبْلُغَ مِنْ کُلِّ صِنْفٍ خَمْسَۃَ أَوْسَاقٍ فَإِذَا بَلَغَ فَفِیہِ الْعُشْرُ۔","","Musannaf Ibn Abi Shaybah 10850","","","كتاب الزكاة"
"10851","(۱۰۸۵۱) عَبْدُ السَّلاَمِ ، عَنْ لَیْثٍ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، قَالَ : فِی کُلِّ عَشَرَۃٍ مِنَ الْبَقَرِ شَاۃٌ , وَفِی کُلِّ عِشْرِینَ شَاتَانِ وَفِی کُلِّ ثَلاَثِینَ تَبِیعٌ۔","","Musannaf Ibn Abi Shaybah 10851","","","كتاب الزكاة"
"10852","(۱۰۸۵۲) عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنْ عِکْرِمَۃَ بْنِ خَالِدٍ ، قَالَ : اسْتُعْمِلْت عَلَی صَدَقَاتِ عَکٍّ , فَلَقِیت أَشْیَاخًا مِمَّنْ صَدَّقَ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ البقر , وَسَأَلْتُہُمْ فَاخْتَلَفُوا عَلَیَّ , فَمِنْہُمْ مَنْ قَالَ اجْعَلْہَا مِثْلَ صَدَقَۃِ الإِبِلِ , وَمِنْہُمْ مَنْ قَالَ فِی ثَلاَثِینَ تَبِیعٌ , وَمِنْہُمْ مَنْ قَالَ فِی أَرْبَعِینَ بَقَرَۃً بَقَرَۃٌ مُسِنَّۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 10852","","","كتاب الزكاة"
"10853","(۱۰۸۵۳) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : أَخْبَرَنَا أَشْعَثُ ، عَنِ الْحَسَنِ ، أَنَّہُ قَالَ فِی رَجُلٍ اشْتَرَی مِنْ زَکَاتِہِ نَسَمَۃً فَأَعْتَقَہَا فَمَاتَتِ النَّسَمَۃُ وَتَرَکَتْ مِیرَاثًا ، قَالَ یُوَجِّہُہَا فِی مَوَاضِعِ الزَّکَاۃِ۔","","Musannaf Ibn Abi Shaybah 10853","","","كتاب الزكاة"
"10854","(۱۰۸۵۴) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ عِمْرَانَ الْقَطَّانِ ، قَالَ : سُئِلَ الْحَسَن ہَلْ عَلَی الْمَرْأَۃِ زَکَاۃٌ فِی مَالِہَا عَلَی ظَہْرِ زَوْجِہَا ، قَالَ إِنْ کَانَ مَلِیًّا فَعَلَیْہَا زَکَاتُہُ۔","","Musannaf Ibn Abi Shaybah 10854","","","كتاب الزكاة"
"10855","(۱۰۸۵۵) إِسْحَاقُ الأَزْرَقُ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، أَنَّہُ قَالَ : عَلَی الْمَرْأَۃِ أَنْ تُزْکِیَ مَہْرَہَا إذَا کَانَ عَلَی زَوْجِہَا إِنْ کَانَ مُوسِرًا ، وَإِنْ کَانَ فَقِیرًا فَلَیْسَ عَلَیْہَا شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 10855","","","كتاب الزكاة"
"10856","(۱۰۸۵۶) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ لَہُ لَوْ کَانَتْ لِرَجُلٍ تِسْعَۃَ عَشَرَ دِینَارًا لَیْسَ لَہُ غَیْرُہَا وَالصَّرْفُ اثْنا عَشَرَ ، أَوْ ثَلاَثَۃَ عَشَرَ فِیہَا صَدَقَۃٌ ؟ قَالَ : نَعَمْ , إذَا کَانَتْ لَوْ صُرِفَتْ مِئَتَیْ دِرْہَمٍ إنَّمَا کَانَ إذْ ذَاکَ الْوَرِقُ ، وَلَمْ یَکُنِ الذَّہَبُ۔","","Musannaf Ibn Abi Shaybah 10856","","","كتاب الزكاة"
"10857","(۱۰۸۵۷) عَبْدُ السَّلاَمِ ، قَالَ : حدَّثَنَا یَحیی بْنُ سَعِیدٍ ، قَالَ : مِنَ السُّنَّۃِ فِی الصَّدَقَۃِ أَنْ یُؤْخَذَ مَعَ کُلِّ بَعِیرٍ عِقَالٌ ، وَمَعَ کُلِّ بَعِیرَیْنِ عِقَالین وَقِرَانًا۔","","Musannaf Ibn Abi Shaybah 10857","","","كتاب الزكاة"
"10858","(۱۰۸۵۸) حَدَّثَنَا شَرِیکٌ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ أَبُو بَکْرٍ : لَوْ مَنَعُونِی عِقَالاً مِمَّا أَعْطَوْا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَجَاہَدْتہمْ علیہ۔","","Musannaf Ibn Abi Shaybah 10858","","","كتاب الزكاة"
"10859","(۱۰۸۵۹) حَدَّثَنَا جَرِیرٌ ، عَنِ أَبِی حَیَّانَ ، عَنِ الْحَارِثِ فِی قولہ تعالی : (وَأَقِیمُوا الصَّلاَۃَ وَآتُوا الزَّکَاۃَ) قَالَ : عَنَی بِہِ صَدَقَۃَ الْفِطْرِ۔","","Musannaf Ibn Abi Shaybah 10859","","","كتاب الزكاة"
"10860","(۱۰۸۶۰) غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ ، قَالَ : صَدَقَۃُ الْفِطْرِ صَاعًا مَکْتُوبٌ۔","","Musannaf Ibn Abi Shaybah 10860","","","كتاب الزكاة"
"10861","(۱۰۸۶۱) وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی الْعَالِیَۃِ ، وَابْنِ سِیرِینَ قَالاَ : صَدَقَۃُ الْفِطْرِ فَرِیضَۃٌ۔","","Musannaf Ibn Abi Shaybah 10861","","","كتاب الزكاة"
"10862","(۱۰۸۶۲) أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : فَرَضَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَدَقَۃَ الْفِطْرِ۔ (بخاری ۱۵۰۴۔ ابوداؤد ۱۶۰۷)","Sahih","Musannaf Ibn Abi Shaybah 10862","","","كتاب الزكاة"
"10863","(۱۰۸۶۳) یَزِیدُ بْنُ ہَارُونَ وَسَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ فَرَضَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَدَقَۃَ الْفِطْرِ۔","Hasan","Musannaf Ibn Abi Shaybah 10863","","","كتاب الزكاة"
"10864","(۱۰۸۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : إنَّمَا کَانَتِ الْمُؤَلَّفَۃُ قُلُوبُہُمْ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَلَمَّا وَلِیَ أَبُو بَکْرٍ انْقَطَعَتْ۔","Da'if","Musannaf Ibn Abi Shaybah 10864","","","كتاب الزكاة"
"10865","(۱۰۸۶۵) وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ الْیَوْمَ مُؤَلَّفَۃٌ۔","","Musannaf Ibn Abi Shaybah 10865","","","كتاب الزكاة"
"10866","(۱۰۸۶۶) حَدَّثَنَا عَفَّانُ ، قَالَ : سُئِلَ حَمَّادٌ ، عَنِ الْمُؤَلَّفَۃِ قُلُوبُہُمْ فحَدَّثَنَا عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ الَّذِینَ یَدْخُلُونَ فِی الإِسْلاَمِ۔","","Musannaf Ibn Abi Shaybah 10866","","","كتاب الزكاة"
"10867","(۱۰۸۶۷) مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیِّ ، قَالَ : حدَّثَنَا مَعْقِلٌ ، قَالَ : سَأَلْتُ الزُّہْرِیَّ : عَنِ الْمُؤَلَّفَۃِ قُلُوبُہُمْ ، قَالَ : ہُوَ مَنْ أَسْلَمَ مِنْ یَہُودِیٍّ ، أَوْ نَصْرَانِیٍّ قُلْتُ : وَإِنْ کَانَ غَنِیًّا ، قَالَ : وَإِنْ کَانَ غَنِیًّا۔","","Musannaf Ibn Abi Shaybah 10867","","","كتاب الزكاة"
"10868","(۱۰۸۶۸) عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا حُمَیْدٌ ، عَنْ حَیَّانَ السُّلَمِیِّ ، قَالَ : قُلْتُ لِاِبْنِ عُمَرَ یَجِیئُنِی مُصَدِّقُوا ابْنِ الزُّبَیْرِ فَیَأْخُذُونَ صَدَقَۃَ مالی وَیَجِیئُ مُصَدِّقُوا نَجْدۃَ فَیَأْخُذُونَ ؟ قَالَ : أَیُّہُمَا أَعْطَیْت أَجْزَأَک۔","Sahih","Musannaf Ibn Abi Shaybah 10868","","","كتاب الزكاة"
"10869","(۱۰۸۶۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَشْعَثَ ، عَنِ الزُّہْرِیِّ ، قَالَ أَخَذَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ مَجُوسِ ہَجَرَ مِنْ کُلِّ حَالِمٍ دِینَارًا۔","Da'if","Musannaf Ibn Abi Shaybah 10869","","","كتاب الزكاة"
"10870","(۱۰۸۷۰) حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عُمَرُ وَہُوَ فِی مَجْلِسٍ بَیْنَ الْقَبْرِ وَالْمِنْبَرِ مَا أَدْرِی کَیْفَ أَصْنَعُ بِالْمَجُوسِ وَلَیْسُوا بِأَہْلِ کِتَابٍ ، فَقَالَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : سُنُّوا بِہِمْ سُنَّۃَ أَہْلِ الْکِتَابِ۔ (مالک ۴۲۔ عبدالرزاق ۱۰۰۲۵)","","Musannaf Ibn Abi Shaybah 10870","","","كتاب الزكاة"
"10871","(۱۰۸۷۱) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِیُّ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ سَعد ، قَالَ : حَدَّثَنِی عمْرُو بْنُ شُعَیْبٍ ، عَنْ أَبِیہِ، عَنْ جَدِّہِ ، قَالَ : قَالَ رَجُلٌ یَا رَسُولَ اللہِ مَا کَانَ فِی الطَّرِیقِ غَیرِ المِیتَائِ ، أَوْ فِی الْقَرْیَۃِ الْمَسْکُونَۃِ ، قَالَ فِیہِ، وَفِی الرِّکَازِ الْخُمْسُ۔ (احمد ۲/۱۸۰۔ حمیدی ۵۹۷)","Hasan","Musannaf Ibn Abi Shaybah 10871","","","كتاب الزكاة"
"10872","(۱۰۸۷۲) عَبْدُ الْوَہَّابِ ، عَن أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : فِی الرِّکَازِ الْخُمْسُ۔","Sahih","Musannaf Ibn Abi Shaybah 10872","","","كتاب الزكاة"
"10873","(۱۰۸۷۳) وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ مِثْلُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 10873","","","كتاب الزكاة"
"10874","(۱۰۸۷۴) عَبْدُ الرَّحِیمِ ، عَنِ ابْنِ أَبِی خَالِدٍ وَزَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فِی الرِّکَازِ الْخُمْسُ۔ (احمد ۲/۴۹۳)","","Musannaf Ibn Abi Shaybah 10874","","","كتاب الزكاة"
"10875","(۱۰۸۷۵) عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِثْلُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 10875","","","كتاب الزكاة"
"10876","(۱۰۸۷۶) أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، أَنَّ غُلاَمًا مِنَ الْعَرَبِ وَجَدَ سَتُّوقَۃً فِیہَا عَشَرَۃُ آلاَفٍ فَأَتَی بِہَا عُمَرَ فَأَخَذَ مِنْہَا خُمْسَہَا أَلْفَیْنِ وَأَعْطَاہُ ثَمَانیَۃَ آلاَفٍ۔","Da'if","Musannaf Ibn Abi Shaybah 10876","","","كتاب الزكاة"
"10877","(۱۰۸۷۷) وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، أَنَّ رَجُلاً وَجَدَ فِی خَرِبَۃٍ أَلْفًا وَخَمْسَمِئَۃٍ فَأَتَی عَلِیًّا، فَقَالَ : أَدِّ خُمْسَہَا وَلَک ثَلاَثَۃُ أَخْمَاسِہَا وَسَنُطَیِّبُ لَکَ الْخُمْسَ الْبَاقِیَ۔","Sahih","Musannaf Ibn Abi Shaybah 10877","","","كتاب الزكاة"
"10878","(۱۰۸۷۸) مُعْتَمِرٌ ، عَنْ مَعْمَرٍ الضَّبِّیِّ ، قَالَ بَیْنَمَا قَوْمٌ عِنْدِی بِسَابُور یُلَیّنون ، أَوْ یُثِیرُونَ الأَرْضَ إذْ أَصَابُوا کَنْزًا وَعَلَیْہَا مُحَمَّدُ بْنُ جَابِرٍ الرَّاسِبِیُّ ، فَکَتَبَ فِیہِ إلَی عَدِیٍّ , فَکَتَبَ عَدِیٌّ إلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، فَکَتَبَ عُمَرُ أَنْ خُذُوا مِنْہُ الْخُمْسَ ، وَاکْتُبُوا لَہُمُ الْبَرَائَۃَ , وَدَعُوا سَائرہ لہم فدفع إلیہم الماء وأخذ منہم الخمس۔","","Musannaf Ibn Abi Shaybah 10878","","","كتاب الزكاة"
"10879","(۱۰۸۷۹) ہُشَیْمٌ ، عَنْ حُصَیْنٍ عَمَّنْ شَہِدَ الْقَادِسِیَّۃَ قَالَ : بَیْنَمَا رَجُلٌ یَغْتَسِلُ إذْ فَحَصَ لَہُ الْمَائُ التُّرَابَ عَنْ لَبِنَۃٍ مِنْ ذَہَبٍ فَأَتَی سَعْدَ بْنَ أَبِی وَقَّاصٍ فَأَخْبَرَہُ ، فَقَالَ : اجْعَلْہَا فِی غَنَائِمِ الْمُسْلِمِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 10879","","","كتاب الزكاة"
"10880","(۱۰۸۸۰) ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ أَبِی قَیْسٍ عَبْدِ الرَّحْمَنِ بْنِ ثَرْوَانَ ، عَنْ ہُزَیْلٍ ، قَالَ : جَائَ رَجُلٌ إلَی عَبْدِ اللہِ ، فَقَالَ : إنِّی وَجَدْت مِئِینَ مِنَ دَرَاہِمٍ ، فَقَالَ عَبْدُ اللہِ : لاَ أَرَی الْمُسْلِمِینَ بَلَغَتْ أَمْوَالُہُمْ ہَذَا , أُرَاہُ رِکَازَ مَالٍ عَادِیٍّ , فَأَدِّ خُمْسَہُ فِی بَیْتِ الْمَالِ , وَلَکَ مَا بَقِیَ۔","Da'if","Musannaf Ibn Abi Shaybah 10880","","","كتاب الزكاة"
"10881","(۱۰۸۸۱) عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : الرِّکَازُ الْکَنْزُ الْعَادِیُّ , وَفِیہِ الْخُمْسُ۔","","Musannaf Ibn Abi Shaybah 10881","","","كتاب الزكاة"
"10882","(۱۰۸۸۲) أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا وُجِدَ الْکَنْزُ فِی أَرْضِ الْعَدُوِّ فَفِیہِ الْخُمْسُ ، وَإِذَا وُجِدَ فِی أَرْضِ الْعَرَبِ فَفِیہِ الزَّکَاۃُ۔","","Musannaf Ibn Abi Shaybah 10882","","","كتاب الزكاة"
"10883","(۱۰۸۸۳) غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ إبْرَاہِیمَ بْنِ الْمُنْتَشِرِ ، عَنْ أَبِیہِ ، أَنَّ رَجُلاً سَأَلَ عَائِشَۃَ ، فَقَالَ : إنِّی وَجَدْت کَنْزًا فَدَفَعْتُہُ إلَی السُّلْطَانِ ، فَقَالَتْ فِی فِیک الْکَِثْکَِتِ ، أَوْ کَلِمَۃٍ نَحْوِہَا , الشَّکُّ مِنِّی۔","Sahih","Musannaf Ibn Abi Shaybah 10883","","","كتاب الزكاة"
"10884","(۱۰۸۸۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فِی الرِّکَازِ الْخُمْسُ۔ (بخاری ۱۴۹۹۔ مسلم ۱۳۳۵)","Sahih","Musannaf Ibn Abi Shaybah 10884","","","كتاب الزكاة"
"10885","(۱۰۸۸۵) خَالِدُ بْنُ مَخْلَدٍ ، عَنْ کَثِیرِ بْنِ عَبْدِ اللہِ الْمُزَنِیّ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فِی الرِّکَازِ الْخُمْسُ۔ (ابن ماجہ ۲۶۷۴۔ طبرانی ۶)","Da'if","Musannaf Ibn Abi Shaybah 10885","","","كتاب الزكاة"
"10886","(۱۰۸۸۶) الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إسْرَائِیلَ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : قَضَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الرِّکَازِ الْخُمْسُ۔ (احمد ۳۱۴)","","Musannaf Ibn Abi Shaybah 10886","","","كتاب الزكاة"
"10887","(۱۰۸۸۷) الْفَضْلُ ، قَالَ : حدَّثَنَا عُمَرُ بْنُ الْوَلِیدِ الشَّنِّی ، عَنْ عِکْرِمَۃَ ، قَالَ : سُئِلَ عَنْ رَجُلٍ وَجَدَ مَطْمُورَۃً ، قَالَ أَدِّ خُمُسَہَا۔","","Musannaf Ibn Abi Shaybah 10887","","","كتاب الزكاة"
"10888","(۱۰۸۸۸) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ حُمَیْدِ بْنِ صَخْرٍ ، عَنْ عُمَرَ بْنِ أَبِی بَکْرٍ ، قَالَ : حدَّثَنِی أَبِی ، قَالَ : دَخَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمَسْجِدَ وَأَقْنَائٌ فِی الْمَسْجِدِ مُعَلَّقَۃٌ ، وَإِذَا فِیہِ قِنْوٌ فِیہِ جَدَرٌ، وَمَعَہُ عُرْجُونٌ ، أَوْ عَصًا ، فَطَعَنَ فِیہِ ، وَقَالَ : مَنْ جَائَ بِہَذَا ؟ قَالُوا : فُلاَنٌ ، قَالَ : بَؤُسَ أُنَاسٌ یُمْسِکُونَ صَدَقَاتِہِمْ، ثُمَّ یُطْرَحُ بِالْعَرَائِ فَلاَ تَأْکُلُہَا الْعَافِیَۃُ یہَاجر کَل بَرْقِۃ وَرَعْدَۃ إلَی الشَّامِ۔(ابوداؤد ۱۶۰۴۔ احمد ۶/۲۸)","","Musannaf Ibn Abi Shaybah 10888","","","كتاب الزكاة"
"10889","(۱۰۸۸۹) أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ أَبِی حَفْصَۃَ ، قَالَ : حدَّثَنِی الزُّہْرِیُّ ، عَنْ أَبِی أُمَامَۃَ بْنِ سَہْلٍ ، قَالَ : کَانَ نَاسٌ یَتَصَدَّقُونَ بِشِرَارِ ثِمَارِہِمْ حَتَّی نَزَلَتْ {وَلاَ تَیَمَّمُوا الْخَبِیثَ مِنْہُ تُنْفِقُونَ وَلَسْتُمْ بِآخِذِیہِ إِلاَّ أَنْ تُغْمِضُوا فِیہِ}۔","","Musannaf Ibn Abi Shaybah 10889","","","كتاب الزكاة"
"10890","(۱۰۸۹۰) ابْنُ عُلَیَّۃَ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ سَأَلَ عَبِیدَۃَ ، عَنْ قولہ تعالی : (وَلاَ تَیَمَّمُوا الْخَبِیثَ مِنْہُ تُنْفِقُونَ وَلَسْتُمْ بِآخِذِیہِ) إنَّمَا ذَلِکَ فِی الزَّکَاۃِ , وَالدَّرَاہِمُ الزَّیْفُ أَحَبُّ إلَیَّ مِنَ التَّمْرِ۔","","Musannaf Ibn Abi Shaybah 10890","","","كتاب الزكاة"
"10891","(۱۰۸۹۱) وَکِیعٌ ، عَنْ یَزِیدَ ، عَنِ الْحَسَنِ {وَلاَ تَیَمَّمُوا الْخَبِیثَ مِنْہُ تُنْفِقُونَ} قَالَ : کَانَ الرَّجُلُ یَتَصَدَّقُ بِرَذَاذَۃِ مَالِہِ۔","","Musannaf Ibn Abi Shaybah 10891","","","كتاب الزكاة"
"10892","(۱۰۸۹۲) عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ إسْرَائِیلَ ، عَنِ السُّدِّیِّ ، عَنْ أَبِی مَالِکٍ ، عَنِ الْبَرَائِ فِی قولہ تعالی : {وَلاَ تَیَمَّمُوا الْخَبِیثَ} قَالَ : نَزَلَتْ فِینَا کُنَّا أَصْحَابَ نَخْلٍ ، فَکَانَ الرَّجُلُ یَأْتِی مِنْ نَخْلِہِ کَقَدْرِ قِلَّتِہِ وَکَثْرَتِہِ ، قَالَ : فَکَانَ الرَّجُلُ یَأْتِی بِالْقِنْوِ وَالرَّجُلُ یَأْتِی بِالْقِنْوَیْنِ , فَیُعَلِّقُہُ فِی الْمَسْجِدِ ، قَالَ وَکَانَ أَہْلُ الصُّفَّۃِ لَیْسَ لَہُمْ طَعَامٌ، فَکَانَ أَحَدُہُمْ إذَا جَائَ أتی الْقِنْوِ فَضَرَبَہُ بِعَصًا فَیَسْقُطُ مِنَ التَّمْرِ وَالْبُسْرِ فَیَأْکُلُ وَکَانَ أُنَاسٌ مِمَّنْ لاَ یَرْغَبُ فِی الْخَیْرِ فَیَأْتِی أَحَدُہُمْ بِالْقِنْوَ فِیہِ الْحَشَفُ , وَفِیہِ الشِّیصُ , وَیَأْتِی بِالْقِنْوِ قَدِ انْکَسَرَ فَیُعَلِّقُہُ ، قَالَ : فَأَنْزَلَ اللَّہُ تعالی: {وَلاَ تَیَمَّمُوا الْخَبِیثَ مِنْہُ تُنْفِقُونَ وَلَسْتُمْ بِآخِذِیہِ إِلاَّ أَنْ تُغْمِضُوا فِیہِ} قَالَ : لَوْ أَنَّ أَحَدَکُمْ أُہْدِیَ إلَیْہِ مِثْلُ مَا أَعْطَی لَمْ یَأْخُذْہُ إِلاَّ عَلَی إغْمَاضٍ وَحَیَائٍ ، قَالَ : فَکَانَ بَعْدَ ذَلِکَ یَأْتِی الرَّجُلُ بِصَالِحِ مَا عِنْدَہُ۔ (ترمذی ۲۹۸۷۔ ابن ماجہ ۱۸۲۲)","Hasan","Musannaf Ibn Abi Shaybah 10892","","","كتاب الزكاة"
"10893","(۱۰۸۹۳) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : أَخْبَرَنَا أَشْعَثُ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ خُرِصَتْ عَلَیْہِ ثَمَرَتُہُ ، فَکَانَ فِیہَا فَضل عَلَی مَا خُرِصَ عَلَیْہِ ، قَالَ : مَا زَادَ فَلَہُ وَمَا نَقَصَ فَعَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 10893","","","كتاب الزكاة"
"10894","(۱۰۸۹۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : سَأَلَنَا لإبْرَاہِیمَ مَرَّتَیْنِ الزَّکَاۃَ۔","","Musannaf Ibn Abi Shaybah 10894","","","كتاب الزكاة"
"10895","(۱۰۸۹۵) ہُشَیْمٌ، عَنْ عُبَیْدَۃَ، عَنْ إبْرَاہِیمَ، قَا[corrupt]َ: أَتَیْتُہ بِزَکَاۃٍ فَقَبِلَہَا، قَالَ: وَأَخْبَرَنِی أَنَّ بَعْضَ أَہْلِ بَدْرٍ کَانَ یَقْبَلُہَا۔","","Musannaf Ibn Abi Shaybah 10895","","","كتاب الزكاة"
"10896","(۱۰۸۹۶) عَبْدُ السَّلاَمِ ، عَنْ عَمرو بْنِ مُسَاوِرٍ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُعَجِّلَ الرَّجُلُ صَدَقَۃَ الْفِطْرِ قَبْلَ الْفِطْرِ بِیَوْمٍ ، أَوْ یَوْمَیْنِ۔","","Musannaf Ibn Abi Shaybah 10896","","","كتاب الزكاة"
"10897","(۱۰۸۹۷) أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ إذَا جَلَسَ مَنْ یَقْبِضُ الْفِطْرَ قَبْلَ الفطر بیَوْمَیْنِ ، أَوْ یَوْمٍ أَعْطَاہَا إِیاہ قَبْلَ الْفِطْرِ بِیَوْمٍ ، أَوْ یَوْمَیْنِ ، وَلاَ یَرَی بِذَلِکَ بَأْسًا۔","Sahih","Musannaf Ibn Abi Shaybah 10897","","","كتاب الزكاة"
"10898","(۱۰۸۹۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ مُسْلِمٍ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ یَعْقُوبَ بْنِ عَاصِمٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ مَنْ سُئِلَ بِاللَّہِ فَأَعْطَی فَلَہُ سَبْعُونَ أَجْرًا۔ (بیہقی ۳۵۴۰)","Hasan","Musannaf Ibn Abi Shaybah 10898","","","كتاب الزكاة"
"10899","(۱۰۸۹۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : أَخْبَرَنَا سُفْیَانُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، أَنَّہُ کَرِہَ أَنْ یُسْأَلَ بِوَجْہِ اللہِ ، أَوْ بِالْقُرْآنِ لِشَیْئٍ مِنْ أَمْرِ الدُّنْیَا۔","","Musannaf Ibn Abi Shaybah 10899","","","كتاب الزكاة"
"10900","(۱۰۹۰۰) حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنْ یَزِیدَ مَوْلَی سَلَمَۃَ ، قَالَ : کَانَ سَلَمَۃُ لاَ یَسْأَلُہُ إنْسَانٌ بِوَجْہِ اللہِ شَیْئًا إِلاَّ أَعْطَاہُ وَیَکْرَہُہَا وَیَقُولُ ہِیَ إلْحَافٌ۔","Sahih","Musannaf Ibn Abi Shaybah 10900","","","كتاب الزكاة"
"10901","(۱۰۹۰۱) عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ سَأَلَ بِاَللَّہِ فَأَعْطُوہُ۔ (ابوداؤد ۵۰۶۸۔ طبرانی ۱۳۵۴۰)","Da'if","Musannaf Ibn Abi Shaybah 10901","","","كتاب الزكاة"
"10902","(۱۰۹۰۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنِ الْمُثَنَّی ، قَالَ قُرِئَ عَلَیْنَا کِتَابُ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، وَلاَ یُعَشِّرُ الْخَمْرَ مُسْلِمٌ۔","","Musannaf Ibn Abi Shaybah 10902","","","كتاب الزكاة"
"10903","(۱۰۹۰۳) وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ یُعَشِّرُ الْخَمْرَ وَیُضَاعِفُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 10903","","","كتاب الزكاة"
"10904","(۱۰۹۰۴) وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، أَنَّ عُمَّالَ عُمَرَ کَتَبُوا إلَیْہِ فِی شَأْنِ الْخَنَازِیرِ وَالْخَمْرِ یَأْخُذُونَہَا فِی الْجِزْیَۃِ فَکَتَبَ عُمَرُ أَنْ وَلُّوہَا أَرْبَابَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 10904","","","كتاب الزكاة"
"10905","حدثنا أبو بکر بن أبی شیبۃ قال:n(۱۰۹۰۵) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنِ الْحَارِثِ بْنِ سُوَیْد ، عَنْ عَبْدِ اللہِ ، قَالَ : دَخَلْت عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یُوعَکُ ، قَالَ فَمَسِسْتُہُ فَقُلْت : یَا رَسُولَ اللہِ إنَّک لَتُوعَکُ وَعْکًا شَدِیدًا ، فَقَالَ : أَجَلْ إنِّی أُوعَکُ کَمَا یُوعَکُ رَجُلاَنِ مِنْکُمْ قَال : قُلْتُ : لأَنَّ لَکَ أَجْرَیْن ؟ فَقَالَ : نَعَمْ وَالَّذِی نَفْسِی بِیَدِہِ مَا عَلَی الأَرْضِ مُسْلِمٌ یُصِیبُہُ أَذًی فَمَا سِوَاہُ إِلاَّ حَطَّ اللَّہُ بِہِ عَنْہُ خَطَایَاہُ کَمَا تَحُطُّ الشَّجَرَۃُ وَرَقَہَا۔ (بخاری ۵۶۴۷۔ مسلم ۱۹۹۱)","Sahih","Musannaf Ibn Abi Shaybah 10905","","","كتاب الجنائز"
"10906","(۱۰۹۰۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَد ، عَنْ عَائِشَۃَ قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یُصِیبُ الْمُؤْمِنَ شَوْکَۃٌ فَمَا فَوْقَہَا إِلاَّ رَفَعَہُ اللَّہُ بِہَا دَرَجَۃً أَوْ حَطَّ بِہَا عَنْہُ سَیِّئَۃً۔ (مسلم ۱۹۹۱۔ ترمذی ۹۶۵)","Sahih","Musannaf Ibn Abi Shaybah 10906","","","كتاب الجنائز"
"10907","(۱۰۹۰۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، عَنْ إسْمَاعِیلَ بْنِ عُبَیْدِ اللہِ ، عَنْ أَبِی صَالِحٍ الأَشْعَرِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ عَادَ مَرِیضًا وَمَعَہُ أَبُو ہُرَیْرَۃَ مِنْ وَعَکٍ کَانَ بِہِ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَبْشِرْ إنَّ اللَّہَ یَقُولُ : ہِیَ نَارِی أُسَلِّطُہَا عَلَی عَبْدِی الْمُؤْمِنِ فِی الدُّنْیَا لِیَکُونَ حَظَّہُ مِنَ النَّارِ فِی الآخِرَۃِ۔ (ترمذی ۲۰۸۸۔ احمد ۲/۴۴۰)","Hasan","Musannaf Ibn Abi Shaybah 10907","","","كتاب الجنائز"
"10908","(۱۰۹۰۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ مُحَیْصِنٍ ، عَنْ مُحَمَّدِ بْنِ قَیْسِ بْنِ مَخْرَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : لَمَّا نَزَلَتْ ہَذِہِ الآیَۃُ : {مَنْ یَعْمَلْ سُوئًا یُجْزَ بِہِ} شَقَّ عَلَی الْمُسْلِمِینَ وَبَلَغَ مِنْہُمْ وَشَکَوْا ذَلِکَ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : قَارِّبُوا وَسَدِّدُوا وَکُلُّ مَا أُصِیبَ بِہِ الْمُسْلِمُ کَفَّارَۃٌ حَتَّی النَّکْبَۃُ یُنْکَبُہَا وَالشَّوْکَۃُ یُشَاکُہَا۔ (مسلم ۱۹۹۳۔ ترمذی ۳۰۳۸)","Sahih","Musannaf Ibn Abi Shaybah 10908","","","كتاب الجنائز"
"10909","(۱۰۹۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنِ الْقَاسِمِ بْنِ مُخَیْمِرَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا مِنْ أَحَدٍ مِنَ الْمُسْلِمِینَ یُبْتَلَی بِبَلاَئٍ فِی جَسَدِہِ إِلاَّ أَمَرَ اللَّہُ الْحَفَظَۃَ، فَقَالَ : اکْتُبُوا لِعَبْدِی مَا کَانَ یَعْمَلُ وَہُوَ صَحِیحٌ مَا دَامَ مَشْدُودًا فِی وَثَاقِی۔ (احمد ۲/۱۵۹۔ دارمی ۲۷۷۰)","Sahih","Musannaf Ibn Abi Shaybah 10909","","","كتاب الجنائز"
"10910","(۱۰۹۱۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْعَوَّامِ ، عَنْ إبْرَاہِیمَ السَّکْسَکِیِّ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِی مُوسَی ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ مَرِضَ ، أَوْ سَافَرَ کَتَبَ اللَّہُ لَہُ مَا کَانَ یَعْمَلُ صَحِیحًا مُقِیمًا۔ (بخاری ۲۹۹۶۔ ابوداؤد ۳۰۸۴)","Sahih","Musannaf Ibn Abi Shaybah 10910","","","كتاب الجنائز"
"10911","(۱۰۹۱۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْوَلِیدِ بْنِ کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرِو بن عَطَائٍ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، عَنْ أَبِی سَعِیدٍ ، وَأَبِی ہُرَیْرَۃَ أَنَّہُمَا سَمِعَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَا یُصِیبُ الْمُؤْمِنَ مِنْ وَصَبٍ ، وَلاَ نَصَبٍ ، وَلاَ سَقَمٍ ، وَلاَ حَزَنٍ حَتَّی الْہَمِّ یَہُمُّہُ إِلاَّ کَفَّرَ اللَّہُ عَنْہُ مِنْ خَطَایَاہُ۔ (بخاری ۵۶۴۲۔ مسلم ۱۹۹۲)","Sahih","Musannaf Ibn Abi Shaybah 10911","","","كتاب الجنائز"
"10912","(۱۰۹۱۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ وَاصِلٍ ، عَنْ بَشَّارِ بْنِ أَبِی سَیْفٍ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عِیَاضِ بْنِ غُطَیْفٍ ، قَالَ : دَخَلْنَا عَلَی أَبِی عُبَیْدَۃَ بْنِ الْجَرَّاحِ نَعُودُہُ فَإِذَا وَجْہُہُ مِمَّا یَلِی الْجِدَارَ وَامْرَأَتُہُ قَاعِدَۃٌ عِنْدَ رَأْسِہِ قُلْتُ : کَیْفَ بَاتَ أَبُو عُبَیْدَۃَ قَالَتْ بَاتَ بِأَجْرٍ فَأَقْبَلَ عَلَیْنَا بِوَجْہِہِ ، فَقَالَ : إنِّی لَمْ أَبِتْ بِأَجْرٍ , وَمَنِ ابْتَلاَہُ اللَّہُ بِبَلاَئٍ فِی جَسَدِہِ فَہُوَ لَہُ حِطَّۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 10912","","","كتاب الجنائز"
"10913","(۱۰۹۱۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا جَرِیرُ بْنُ حَازِمٍ سَمِعَہُ ، مِنْ بَشَّارِ بْنِ أَبِی سَیْفٍ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عِیَاضِ بْنِ غُطَیْفُ رَفَعَہُ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِثْلُہُ۔ (احمد ۱۹۵۔ بخاری ۹۳)","Da'if","Musannaf Ibn Abi Shaybah 10913","","","كتاب الجنائز"
"10914","(۱۰۹۱۴) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ طَلْحَۃَ بْنِ یَحْیَی ، عَنْ أَبِی بُرْدَۃَ ، عَنْ مُعَاوِیَۃَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَا مِنْ شَیْئٍ یُصِیبُ الْمُؤْمِنَ فِی جَسَدِہِ یُؤْذِیہِ إِلاَّ کُفِّرَ بِہِ عَنْہُ مِنْ سَیِّئَاتِہِ۔ (طبرانی ۸۴۲)","Hasan","Musannaf Ibn Abi Shaybah 10914","","","كتاب الجنائز"
"10915","(۱۰۹۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنْ حَفْصِ بْنِ عُبَیْدِ اللہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : ذُکِرَتِ الْحُمَّی عِنْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَبَّہَا رَجُلٌ ، فَقَالَ لَہُ : لاَ تَسُبَّہَا فَإِنَّہَا تَنْقِی الذُّنُوبَ کَمَا تَنْقِی النَّارُ خَبَثَ الْحَدِیدِ۔ (ابن ماجہ ۳۴۶۹)","Da'if","Musannaf Ibn Abi Shaybah 10915","","","كتاب الجنائز"
"10916","(۱۰۹۱۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ یَزَالُ الْبَلاَئُ بِالْمُؤْمِنِ وَالْمُؤْمِنَۃِ حَتَّی یَلْقَی اللَّہَ وَمَا عَلَیْہِ مِنْ خَطِیئَۃٍ۔ (حاکم ۳۴۶)","Hasan","Musannaf Ibn Abi Shaybah 10916","","","كتاب الجنائز"
"10917","(۱۰۹۱۷) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عَنْ عَطَائِ بْنِ یَسَارٍ یُبْلِغُ بِہِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: إذَا مَرِضَ الْعَبْدُ، قَالَ اللَّہُ لِلْکِرَامِ الْکَاتِبِینَ اکْتُبُوا لِعَبْدِی مِثْلَ الَّذِی کَانَ یَعْمَلُ حَتَّی أَقْبَضَہُ، أَوْ أُعَافِیَہُ۔","","Musannaf Ibn Abi Shaybah 10917","","","كتاب الجنائز"
"10918","(۱۰۹۱۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنْ سَعِیدِ بْنِ مَوْہَبٍ ، قَالَ انْطَلَقْت مَعَ سَلْمَانَ إلَی صَدِیقٍ لَہُ یَعُودُہُ مِنْ کِنْدَۃَ ، فَقَالَ : إنَّ الْمُؤْمِنَ یُصِیبُہُ اللَّہُ بِالْبَلاَئِ ، ثُمَّ یُعَافِیہِ فَیَکُونُ کَفَّارَۃً لِسَیِّئَاتِہِ وَیُسْتَعْتَبُ فِیمَا بَقِیَ وَإِنَّ الْفَاجِرَ یُصِیبُہُ اللَّہُ بِالْبَلاَئِ ، ثُمَّ یُعَافِیہِ فَیَکُونُ کَالْبَعِیرِ عَقَلَہُ أَہْلُہُ لاَ یَدْرِی لِمَ عَقَلُوہُ ، ثُمَّ أَرْسَلُوہُ فَلاَ یَدْرِی لِمَ أَرْسَلُوہُ۔","Sahih","Musannaf Ibn Abi Shaybah 10918","","","كتاب الجنائز"
"10919","(۱۰۹۱۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ فُضَیْلِ بْنِ غَزْوَانَ ، عَنْ عَبْدِ اللہِ بْنِ السَّائِبِ ، عَنْ زَاذَانَ ، قَالَ : قَالَ سَلْمَانُ إذَا مَرِضَ الْعَبْدُ ، قَالَ الْمَلَکُ یَا رَبِّ ابْتَلَیْت عَبْدَک بِکَذَا قَالَ : فَیَقُولُ مَا دَامَ فِی وِثَاقِی فاکْتُبُوا لَہُ مِثْلَ عَمَلِہِ الَّذِی کَانَ یَعْمَلُ۔","Sahih","Musannaf Ibn Abi Shaybah 10919","","","كتاب الجنائز"
"10920","(۱۰۹۲۰) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ سَعْدٍ ، قَالَ : سَمِعْتُ عُرْوَۃَ بْنَ رُوَیْمٍ یَذْکُرُ عَنِ الْقَاسِمِ ، عَنْ مُعَاذٍ ، قَالَ : إذَا ابْتَلَی اللَّہُ الْعَبْدَ بِالسَّقَمِ ، قَالَ لِصَاحِبِ الشِّمَالِ ارْفَعْ ، وَقَالَ لِصَاحِبِ الْیَمِینِ اکْتُبْ لِعَبْدِی مَا کَانَ یَعْمَلُ۔","","Musannaf Ibn Abi Shaybah 10920","","","كتاب الجنائز"
"10921","(۱۰۹۲۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ : سَمِعْتُ أَبَا وَائِلٍ یُحَدِّثُ عَنْ عَائِشَۃَ قَالَتْ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَا مِنْ مُسْلِمٍ یُشَاکُ بِشَوْکَۃٍ فَمَا فَوْقَہَا إِلاَّ رَفَعَہُ اللَّہُ بِہَا دَرَجَۃً وَحَطَّ عَنْہُ بِہَا خَطِیئَۃً۔ (بخاری ۵۶۴۰۔ مسلم ۱۹۹۱)","Sahih","Musannaf Ibn Abi Shaybah 10921","","","كتاب الجنائز"
"10922","(۱۰۹۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إیَاسِ بْنِ أَبِی تَمِیمَۃَ ، عَنْ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : مَا مِنْ وَجَعٍ یُصِیبُنِی أَحَبُّ إلَیَّ مِنَ الْحُمَّی إِنَّہَا تَدْخُلُ فِی کُلِّ مَفْصِلٍ مِنَ ابْنِ آدَمَ , وَإِنَّ اللَّہَ لَیُعْطِی کُلَّ مَفْصِلٍ قِسْطًا مِنَ الأَجْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 10922","","","كتاب الجنائز"
"10923","(۱۰۹۲۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ سَالِمٍ ، قَالَ رَأَی أَبُو الدَّرْدَائِ یَوْمًا رَجُلاً فَتَعَجَّبَ مِنْ جَلَدِہِ ، فَقَالَ أَبُو الدَّرْدَائِ ہَلْ حُمِمْت قَطُّ ہَلْ صُدِعْت قَطُّ ، فَقَالَ : الرَّجُلُ لاَ فَقَالَ أَبُو الدَّرْدَائِ بُؤْسٌ لِہَذَا یَمُوتُ بِخَطِیئَتِہِ۔","","Musannaf Ibn Abi Shaybah 10923","","","كتاب الجنائز"
"10924","(۱۰۹۲۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ بَعْضِ أَصْحَابِہِ ، عَنِ الْحَکَمِ ، عَنْ رَبِیعِ بْنِ عُمَیْلَۃَ ، عَنْ عَمَّارٍ ، قَالَ : کَانَ عِنْدَہُ أَعْرَابِیٌّ فَذَکَرُوا الْوَجَعَ ، فَقَالَ : عَمَّارٌ ہَلِ اشْتَکَیْت قَطُّ ، فَقَالَ : لاَ فَقَالَ : عَمَّارٌ مَا أَنْتَ مِنَّا ، أَوْ لَسْت مِنَّا مَا مِنْ عَبْدٍ یُبْتَلَی إِلاَّ حُطَّ عَنْہُ خَطَایَاہُ کَمَا تَحُطُّ الشَّجَرَۃُ وَرَقَہَا , وَإِنَّ الْکَافِرَ یُبْتَلَی فَمَثَلُہُ کَمَثَلِ الْبَعِیرِ عُقِلَ فَلَمْ یَدْرِ لِمَا عُقِلَ , وَأُطْلِقَ فَلَمْ یَدْرِ لِمَا أُطْلِقَ۔","Da'if","Musannaf Ibn Abi Shaybah 10924","","","كتاب الجنائز"
"10925","(۱۰۹۲۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَاصِمٍ ، قَالَ : دَخَلَ أَبُو الْعَالِیَۃِ عَلَی النَّضْرِ بْنِ أَنَسٍ یَعُودُہُ ، قَالَ : کُنَّا نَتَحَدَّثُ مُنْذُ خَمْسِینَ سَنَۃً ، أَنَّہُ مَا مِنْ عَبْدٍ یَمْرَضُ إِلاَّ قَامَ مِنْ مَرَضِہِ کَیَوْمِ وَلَدَتْہُ أُمُّہُ وَکُنَّا نَتَحَدَّثُ مُنْذُ خَمْسِینَ سَنَۃً ، أَنَّہُ مَا مِنْ عَبْدٍ یَمْرَضُ إِلا قَالَ اللَّہُ لِکَاتِبَیْہِ : اکْتُبَا لِعَبْدِی مَا کَانَ یَعْمَلُ فِی صِحَّتِہِ۔","","Musannaf Ibn Abi Shaybah 10925","","","كتاب الجنائز"
"10926","(۱۰۹۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنْ أَبِی عَمَّار ، عَنْ عَمْرِو بْنِ شُرَحْبِیلَ ، قَالَ : قَالَ عَبْدُ اللہِ إنَّ الْوَجَعَ لاَ یُکْتَبُ بِہِ الأَجْرُ وَلَکِنْ تُکَفَّرُ بِہِ الْخَطَایَا۔","Sahih","Musannaf Ibn Abi Shaybah 10926","","","كتاب الجنائز"
"10927","(۱۰۹۲۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ أَبِی قَیْسٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : قَالَ أَبُو الدَّرْدَائِ مَا یَسُرُّنِی بِلَیْلَۃٍ أَمْرَضُہَا حُمْرُ النَّعَمِ۔","","Musannaf Ibn Abi Shaybah 10927","","","كتاب الجنائز"
"10928","(۱۰۹۲۸) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : إذَا مَرِضَ الرَّجُلُ عَلَی عَمَلٍ صَالِحٍ جَرَی لَہُ مَا کَانَ یَعْمَلُ فِی صِحَّتِہِ۔","","Musannaf Ibn Abi Shaybah 10928","","","كتاب الجنائز"
"10929","(۱۰۹۲۹) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنِ الْحَکَمِ بْنِ أَبَانَ ، عَنْ عِکْرِمَۃَ ، قَالَ : إذَا مَرِضَ الرَّجُلُ رُفِعَ لَہُ کُلَّ یَوْمٍ مَا کَانَ یَعْمَلُ۔","","Musannaf Ibn Abi Shaybah 10929","","","كتاب الجنائز"
"10930","(۱۰۹۳۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُلَیْمَانَ بْنِ الْمُغِیرَۃِ ، عَنْ ثَابِتِ ، عَنْ مُسْلِمِ بْنِ یَسَارٍ ، قَالَ : إذَا مَرِضَ العبد کُتِبَ لَہُ أَحْسَنُ مَا کَانَ یَعْمَلُ فِی صِحَّتِہِ۔","","Musannaf Ibn Abi Shaybah 10930","","","كتاب الجنائز"
"10931","(۱۰۹۳۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجِ ، عَنْ مُحَمَّدٍ ، قَالَ : قَالَ عَلِیُّ بْنُ الْحُسَیْنِ إذَا لَمْ یَمْرَضِ الْجَسَدُ أَشِرَ ، وَلاَ خَیْرَ فِی جَسَدٍ مَا یَأْشَر۔","","Musannaf Ibn Abi Shaybah 10931","","","كتاب الجنائز"
"10932","(۱۰۹۳۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ قَالَتْ : مَا شِیکَ امْرُؤٌ بِشَوْکَۃٍ فَمَا فَوْقَہَا إِلاَّ حَطَّ اللَّہُ بِہَا عَنْہُ خَطَایَاہُ۔","Hasan","Musannaf Ibn Abi Shaybah 10932","","","كتاب الجنائز"
"10933","(۱۰۹۳۳) حَدَّثَنَا أَبُوبَکْرِ بْنُ عَیَّاشٍ، عَنْ عَاصِمٍ، عَنْ مُصْعَبِ بْنِ سَعْدٍ، عَنْ أَبِیہِ، قَالَ: قُلْتُ یَا رَسُولَ اللہِ أَیُّ النَّاسِ أَشَدُّ بَلاَئً ، قَالَ : النَّبِیُّونَ ، ثُمَّ الأَمْثَلُ مِنَ النَّاسِ وَمَا یَزَالُ بِالْعَبْدِ الْبَلاَئُ حَتَّی یَلْقَی اللَّہَ وَمَا عَلَیْہِ مِنْ خَطِیئَۃٍ۔ (ترمذی ۲۳۹۸۔ ابن حبان ۲۹۰۰)","Hasan","Musannaf Ibn Abi Shaybah 10933","","","كتاب الجنائز"
"10934","(۱۰۹۳۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ طَلْحَۃَ بْنِ عُمیرۃ ، عَنْ مَسْرُوقٍ ، قَالَ : یَوَدُّ أَہْلُ الْبَلاَئِ یَوْمَ الْقِیَامَۃِ ، أَنَّ أَجْسَادَہُمْ کَانَتْ فِی الدُّنْیَا تُقْرَضُ بِالْمَقَارِیضِ۔","","Musannaf Ibn Abi Shaybah 10934","","","كتاب الجنائز"
"10935","(۱۰۹۳۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ لَیْثٍ، عَنْ مُجَاہِدٍ، قَالَ: یُکْتَبُ مِنَ الْمَرِیضِ کُلُّ شَیْئٍ حَتَّی أَنِینُہُ فِی مَرَضِہِ۔","","Musannaf Ibn Abi Shaybah 10935","","","كتاب الجنائز"
"10936","(۱۰۹۳۶) حَدَّثَنَا عَفَّانُ ، قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا أَبُو رَبِیعَۃَ ، قَالَ : سَمِعْتُ أَنَسَ بْنَ مَالِکٍ یَقُولُ : إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إذَا ابْتَلَی اللَّہُ الْمُسْلِمَ بِبَلاَئٍ فِی جَسَدِہِ ، قَالَ لِلْمَلَکِ اکْتُبْ لَہُ صَالِحَ عَمَلِہِ الَّذِی کَانَ یَعْمَلُ فَإِنْ شَفَاہُ غَسَلَہُ وَطَہَّرَہُ , وَإِنْ قَبَضَہُ غَفَرَ لَہُ وَرَحِمَہُ۔n(احمد ۱۴۸۔ بخاری ۵۰۱)","Hasan","Musannaf Ibn Abi Shaybah 10936","","","كتاب الجنائز"
"10937","(۱۰۹۳۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ بَشِیرٍ ، قَالَ : أَخْبَرَنَا خَالِدٌ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی أَسْمَائَ الرَّحَبِیِّ ، عَنْ ثَوْبَانَ مَوْلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ عَادَ مَرِیضًا لَمْ یَزَلْ فِی خُرْفَۃِ الْجَنَّۃِ حَتَّی یَرْجِعَ۔","","Musannaf Ibn Abi Shaybah 10937","","","كتاب الجنائز"
"10938","(۱۰۹۳۸) حَدَّثَنَا یَزِیدُ ، عَنْ عَاصِمٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الأَشْعَثِ ، عَنْ أَبِی أَسْمَائَ ، عَنْ ثَوْبَانَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوِہِ۔ (مسلم ۱۹۸۹۔ ترمذی ۹۶۸)","Sahih","Musannaf Ibn Abi Shaybah 10938","","","كتاب الجنائز"
"10939","(۱۰۹۳۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَنْ عُمَرَ بْنِ الْحَکَمِ بْنِ ثَوْبَانَ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ عَادَ مَرِیضًا لَمْ یَزَلْ یَخُوضُ فِی الرَّحْمَۃِ حَتَّی یَجْلِسَ فَإِذَا جَلَسَ اغْتَمَسَ فِیہَا۔ (بخاری ۵۲۲۔ احمد ۳۰۴)","","Musannaf Ibn Abi Shaybah 10939","","","كتاب الجنائز"
"10940","(۱۰۹۴۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : جَائَ أَبُو مُوسَی إلَی الْحَسَنِ بْنِ عَلِیٍّ یَعُودُہُ وَکَانَ شَاکِیًا ، فَقَالَ لَہُ : عَلِیٌّ : عَائِدًا جِئْت أَمْ شَامِتًا ؟ فَقَالَ : لاَ بَلْ عَائِدًا ، فَقَالَ لَہُ عَلِیٌّ أَمَا إذْ جِئْت عَائِدًا فَإِنِّی سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ أَتَی أَخَاہُ الْمُسْلِمَ یَعُودُہُ مَشَی فِی خَرَافَۃِ الْجَنَّۃِ حَتَّی یَجْلِسَ فَإِذَا جَلَسَ غَمَرَتْہُ الرَّحْمَۃُ ، وَإِنْ کَانَ غدوۃ صَلَّی عَلَیْہِ سَبْعُونَ أَلْفَ مَلَکٍ حَتَّی یُمْسِیَ ، وَإِنْ کَانَ مَسَائً صَلَّی عَلَیْہِ سَبْعُونَ أَلْفَ مَلَکٍ حَتَّی یُصْبِحَ۔n(ابوداؤد ۳۰۹۲۔ ترمذی ۹۶۹)","Sahih","Musannaf Ibn Abi Shaybah 10940","","","كتاب الجنائز"
"10941","(۱۰۹۴۱) حدَّثنا شَرِیک ، عن عَلْقَمۃ بن مَرْثَد ، عن بعض آل أَبی مُوسَی الأَشْعَرِیِّ ، أَنَّہُ أَتَی عَلِیًّا ، فَقَالَ لَہُ : مَا جَائَ بِکَ ؟ أَجِئْتَ عَائِدًا ؟ قَالَ : مَا عَلِمْتُ لأَحَدٍ مِنْکُمْ بِشَکْوَی ، فَقَالَ : بَلَی ، الْحَسَنُ بْنُ عَلِیٍّ ، ثُمَّ قَالَ عَلِیٌّ : مَنْ عَادَ مَرِیضًا نَہَارًا ، صَلَّی عَلَیْہِ سَبْعُونَ أَلْفَ مَلَکٍ ، حَتَّی یُمْسِیَ ، وَمَنْ عَادَ لَیْلاً ، صَلَّی عَلَیْہِ سَبْعُونَ أَلْفَ مَلَکٍ ، حَتَّی یُصْبِحَ۔","Da'if","Musannaf Ibn Abi Shaybah 10941","","","كتاب الجنائز"
"10942","(۱۰۹۴۲) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ عِکْرِمَۃَ بْنِ خَالِدٍ ، قَالَ : حُدِّثت أَنَّ الرَّجُلَ إذَا عَادَ مَرِیضًا خَاضَ فِی الرَّحْمَۃِ خَوْضًا فَإِذَا جَلَسَ اسْتَنْقَعَ فِیہَا اسْتِنْقَاعًا۔","","Musannaf Ibn Abi Shaybah 10942","","","كتاب الجنائز"
"10943","(۱۰۹۴۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا جَرِیرُ بْنُ حَازِمٍ ، قَالَ : أَخْبَرَنَا بَشَّارُ بْنُ أَبِی سَیْفٍ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عِیَاضِ بْنِ غُطَیْفٍ ، عَنْ أَبِی عُبَیْدَۃَ بْنِ الْجَرَّاحِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ عَادَ مَرِیضًا ، أَوْ أَمَاطَ أَذًی عَنْ طَرِیقٍ فَحَسَنَتُہُ بِعَشْرِ أَمْثَالِہَا۔ (احمد ۱/۱۹۵۔ ابو یعلی ۸۷۵)","Da'if","Musannaf Ibn Abi Shaybah 10943","","","كتاب الجنائز"
"10944","(۱۰۹۴۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا مُوسَی الْجُہَنِیُّ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ أَبِی بُرْدَۃَ ، قَالَ : حَدَّثَنِی أَبِی ، أَنَّ أَبَا مُوسَی انْطَلَقَ عَائِدًا لِلْحُسَیْنِ بْنِ عَلِیٍّ ، فَقَالَ لَہُ عَلِیٌّ : أَعَائِدًا جِئْت ، أَوْ زَائِرًا ؟ قَالَ : لاَ بَلْ زَائِرًا ، قَالَ : أَمَا إِنَّہُ لاَ یَمْنَعُنِی ، وَإِنْ کَانَ فِی نَفْسِکَ مَا فِی نَفْسِکَ أَنْ أُخْبِرَک؛ أَنَّ الْعَائِدَ إذَا خَرَجَ مِنْ بَیْتِہِ یَعُودُ مَرِیضًا ، کَانَ یَخُوضُ فِی الرَّحْمَۃِ خَوْضًا ، فَإِذَا انْتَہَی إلَی الْمَرِیضِ فَجَلَسَ غَمَرَتْہُ الرَّحْمَۃُ وَیَرْجِع مِنْ عِنْدِ الْمَرِیضِ ، حِینَ یَرْجِعُ ، یُشَیِّعُہُ سَبْعُونَ أَلْفَ مَلَکٍ ، یَسْتَغْفِرُونَ لَہُ نَہَارَہ أَجْمَعَ ، وَإِنْ کَانَ لَیْلاً ، کَانَ بِذَلِکَ الْمَنْزِلِ حَتَّی یُصْبِحَ ، وَلَہُ خَرِیفٌ فِی الْجَنَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 10944","","","كتاب الجنائز"
"10945","(۱۰۹۴۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ الْمُحَارِبیِّ ، عَنْ مُعَاوِیَۃَ بْنِ سُوَیْد ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، قَالَ : أَمَرَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِعِیَادَۃِ الْمَرِیضِ وَاتِّبَاعِ الْجَنَائِزِ۔n(بخاری ۱۲۳۹۔ ترمذی ۱۷۶۰)","Sahih","Musannaf Ibn Abi Shaybah 10945","","","كتاب الجنائز"
"10946","(۱۰۹۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَمَّامٍ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی عِیسَی الأُسْوَارِیِّ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عُودُوا الْمَرِیضَ وَاتَّبِعُوا الْجِنَازَۃَ تُذَکِّرُکُمُ الآخِرَۃَ۔n(عبد بن حمید ۱۰۰۱۔ ابویعلی ۱۱۱۴)","Sahih","Musannaf Ibn Abi Shaybah 10946","","","كتاب الجنائز"
"10947","(۱۰۹۴۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لِلْمُسْلِمِ عَلَی الْمُسْلِمِ أَنْ یَعُودَہُ إذَا مَرِضَ وَیَحْضُرَ جِنَازَتَہُ۔ (ترمذی ۲۷۳۶۔ احمد ۱/۸۹)","Da'if","Musannaf Ibn Abi Shaybah 10947","","","كتاب الجنائز"
"10948","(۱۰۹۴۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ، عَنْ جَابِرٍ ، قَالَ : قلْنَا یَا رَسُولَ اللہِ کَیْفَ أَصْبَحْت ، قَالَ : بِخَیْرٍ مِنْ رَجُلٍ لَمْ یُصْبِحْ صَائِمًا ، وَلَمْ یَعُدْ سَقِیمًا۔ (بخاری ۱۳۳)","Da'if","Musannaf Ibn Abi Shaybah 10948","","","كتاب الجنائز"
"10949","(۱۰۹۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سَلَمَۃَ بْنِ وَرْدَانَ ، قَالَ : سَمِعْتُ أَنَسَ بْنَ مَالِکٍ یَقُولُ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لأَصْحَابِہِ : مَنْ شَہِدَ مِنْکُمْ جِنَازَۃً ؟ قَالَ عُمَرُ أَنَا ، قَالَ : مَنْ عَادَ مِنْکُمْ مَرِیضًا ؟ قَالَ عُمَرُ أَنَا ، قَالَ : مَنْ تَصَدَّقَ ؟ قَالَ عُمَرُ أَنَا ، قَالَ : مَنْ أَصْبَحَ مِنْکُمْ صَائِمًا ؟ قَالَ عُمَرُ أَنَا ، قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : وَجَبَتْ وَجَبَتْ۔ (احمد ۳/۱۱۸۔ طبرانی ۱۱)","Da'if","Musannaf Ibn Abi Shaybah 10949","","","كتاب الجنائز"
"10950","(۱۰۹۵۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مِنْ حَقِّ الْمُسْلِمِ عَلَی الْمُسْلِمِ شُہُودُ الْجِنَازَۃِ وَعِیَادَۃُ الْمَرِیضِ۔ (بخاری ۵۱۹۔ احمد ۳۵۷)","Hasan","Musannaf Ibn Abi Shaybah 10950","","","كتاب الجنائز"
"10951","(۱۰۹۵۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یُحِبُّونَ إذَا سُئِلُوا عَنِ الْمَرِیضِ أَنْ یَقُولُوا صَالِحٌ ، ثُمَّ یَذْکُرُونَ وَجَعَہُ بَعْدُ۔","","Musannaf Ibn Abi Shaybah 10951","","","كتاب الجنائز"
"10952","(۱۰۹۵۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، عَنْ أُمِّ سَلَمَۃَ قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إذَا حَضَرْتُمُ الْمَرِیضَ ، أَوِ الْمَیِّتَ فَقُولُوا خَیْرًا فَإِنَّ الْمَلاَئِکَۃَ یُؤَمِّنُونَ عَلَی مَا تَقُولُونَ۔ (مسلم ۶۔ ترمذی ۹۷۷)","Sahih","Musannaf Ibn Abi Shaybah 10952","","","كتاب الجنائز"
"10953","(۱۰۹۵۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الْمُجَالِدِ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَتِ الأَنْصَارُ یَقْرَؤُونَ عِنْدَ الْمَیِّتِ بِسُورَۃِ الْبَقَرَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 10953","","","كتاب الجنائز"
"10954","(۱۰۹۵۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ ، عَنْ حَفْصَۃَ بِنْتِ سِیرِینَ ، عَنْ أُمِّ الْحَسَنِ قَالَتْ : کُنْت عِنْدَ أُمِّ سَلَمَۃَ أَنْظُرُ فِی رَأْسِہَا , فَجَائَ إنْسَانٌ فَقَالَ : فُلاَنٌ فِی الْمَوْتِ ، فَقَالَتْ لَہَا انْطَلِقِی , فَإِذَا احْتُضِرَ فَقُوْلِی : السَّلاَمُ عَلَی الْمُرْسَلِینَ , وَالْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ۔","Hasan","Musannaf Ibn Abi Shaybah 10954","","","كتاب الجنائز"
"10955","(۱۰۹۵۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : نُبِّئْت أَنَّ مُحَمَّدَ بْنَ سِیرِینَ حَضَرَ بَعْضَ أَہْلِہِ وَہُوَ فِی الْمَوْتِ , فَجَعَلَ یَقُولُ : قُولُوا سَلاَمًا , قُولُوا سَلاَمًا۔","","Musannaf Ibn Abi Shaybah 10955","","","كتاب الجنائز"
"10956","(۱۰۹۵۶) حَدَّثَنَا عُقْبَۃُ بْنُ خَالِدٍ ، عَنْ مُوسَی بن مُحَمَّدُ بْن إِبْرَاہِیمَ ، عَن أَبِیہِ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا دَخَلْتُمْ عَلَی الْمَرِیضِ فَنَفِّسُوا لَہُ فِی الأَجَلِ فَإِنَّ ذَلِکَ لاَ یَرُدُّ شَیْئًا وَہُوَ یُطَیِّبُ نَفْسَ الْمَرِیضِ۔ (ترمذی ۲۰۸۷۔ ابن ماجہ ۱۴۳۸)","Da'if","Musannaf Ibn Abi Shaybah 10956","","","كتاب الجنائز"
"10957","(۱۰۹۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَّانَ بْنِ إِبْرَاہِیمَ ، عَن أُمَیَّۃَ الأَزْدِیِّ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، أَنَّہُ کَانَ یَقْرَأُ عِنْدَ الْمَیِّتِ سُورَۃَ الرَّعْدِ۔","","Musannaf Ibn Abi Shaybah 10957","","","كتاب الجنائز"
"10958","(۱۰۹۵۸) حَدَّثَنَا عَلِیُّ بْنُ الْحَسَنِ بْنُ شَقِیقٍ ، عَنِ ابْنِ مُبَارَکٍ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ وَلَیْسَ بِالنَّہْدِیِّ ، عَنْ أَبِیہِ ، عَنْ مَعْقِلِ بْنِ یَسَارٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اقْرَؤُوہَا عِنْدَ مَوْتَاکُمْ ، یَعْنِی یٰسٓ۔n(ابوداؤد ۳۱۱۲۔ ابن حبان ۳۰۰۲)","Da'if","Musannaf Ibn Abi Shaybah 10958","","","كتاب الجنائز"
"10959","(۱۰۹۵۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا إذَا حَضَرُوا الرَّجُلَ یَمُوتُ أَخْرَجُوا الْحُیَّضَ۔","","Musannaf Ibn Abi Shaybah 10959","","","كتاب الجنائز"
"10960","(۱۰۹۶۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ جَائَتْہُ امْرَأَۃٌ ، فَقَالَتْ : إنِّی أُعَالِجُ مَرِیضًا فَأَقُومُ عَلَیْہِ وَأَنَا حَائِضٌ ، فَقَالَ : نَعَمْ فَإِذَا حَضَرَ فَاجْتَنِبِی رَأْسَہُ۔","","Musannaf Ibn Abi Shaybah 10960","","","كتاب الجنائز"
"10961","(۱۰۹۶۱) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ تَحْضُرَ الْحَائِضُ الْمَیِّتَ۔","","Musannaf Ibn Abi Shaybah 10961","","","كتاب الجنائز"
"10962","(۱۰۹۶۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَزِیدَ بْنِ کَیْسَانَ ، عَنْ أَبِی حَازِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَقِّنُوا مَوْتَاکُمْ لاَ إلَہَ إِلاَّ اللَّہُ۔ (مسلم ۲۔ ابن ماجہ ۱۴۴۴)","Hasan","Musannaf Ibn Abi Shaybah 10962","","","كتاب الجنائز"
"10963","(۱۰۹۶۳) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ عُمَرُ احْضُرُوا مَوْتَاکُمْ وَذَکِّرُوہُمْ لاَ إلَہَ إِلاَّ اللَّہُ ، فَإِنَّہُمَا یَرَوْنَ وَیُقَالُ لَہُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 10963","","","كتاب الجنائز"
"10964","(۱۰۹۶۴) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ، عَنْ مَنْصُورِ بْنِ صَفِیَّۃَ، عَنْ أُمِّہِ، عَنْ عَائِشَۃَ قَالَتْ: لَقِّنُوا مَوْتَاکُمْ لاَ إلَہَ إِلاَّ اللَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 10964","","","كتاب الجنائز"
"10965","(۱۰۹۶۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ إبْرَاہِیمَ ، قَالَ لَمَّا ثَقُلَ عَلْقَمَۃُ ، قَالَ أَقْعِدُوا عِنْدِی مَنْ یُذَکِّرُنِی لاَ إلَہَ إِلاَّ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 10965","","","كتاب الجنائز"
"10966","(۱۰۹۶۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ حُصَیْنٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : أَوْصَی عَلْقَمَۃُ وَالأَسْوَد أَنْ لَقِّنِّی لاَ إلَہَ إِلاَّ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 10966","","","كتاب الجنائز"
"10967","(۱۰۹۶۷) حَدَّثَنَا عَبْدُاللہِ بْنُ نُمَیْرٍ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ أَو غَیرہ قَالَ: قَالَ عُمَر: لَقِّنُوا مَوْتَاکُمْ لاَ إلَہَ إِلاَّ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 10967","","","كتاب الجنائز"
"10968","(۱۰۹۶۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ کَانَ یُسْتَحَبُّ أَنْ یُلَقَّنَ الْمَیِّتُ ؟ قَالَ نَعَمْ حَسَنٌ إنِّی لأُحِبُّ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 10968","","","كتاب الجنائز"
"10969","(۱۰۹۶۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ إذَا مَرِضَ فَثَقُلَ ، قَالَ : کَانُوا یُحِبُّونَ أَنْ لاَ یُخْلُوہُ ویَعْتَقِبونہ إذَا قَامَ نَاسٌ جَائَ آخَرُونَ , وَیُلَقِّنُونَہُ لاَ إلَہَ إِلاَّ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 10969","","","كتاب الجنائز"
"10970","(۱۰۹۷۰) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ سُلَیْمَانَ بْنِ بِلاَلٍ ، قَالَ : حدَّثَنَا عُمَارَۃُ بْنُ غَزِیَّۃَ الأَنْصَارِیُّ ، عَنْ یَحْیَی بْنِ عُمَارَۃَ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لَقِّنُوا مَوْتَاکُمْ لاَ إلَہَ إِلاَّ اللَّہُ۔ (ابوداؤد ۳۱۰۸۔ ترمذی ۹۷۶)","Hasan","Musannaf Ibn Abi Shaybah 10970","","","كتاب الجنائز"
"10971","(۱۰۹۷۱) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إبْرَاہِیمَ ، أَنَّ الأَسْوَد أَوْصَی رَجُلاً ، فَقَالَ : إنِ اسْتَطَعْت أَنْ یَکُونَ آخِرَ ما أَقُولُ لاَ إلَہَ إِلاَّ اللَّہُ فَافْعَلْ ، وَلاَ تَجْعَلُوا فِی قَبْرِی آجُرًّا۔","","Musannaf Ibn Abi Shaybah 10971","","","كتاب الجنائز"
"10972","(۱۰۹۷۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ عَبْدِ اللہِ بْنِ الْوَلِیدِ ، قَالَ : حدَّثَنَا النَّضْرُ بْنُ قَیْسٍ ، عَنْ رَجُلٍ مِنْ أَہْلِ الْمَدِینَۃِ ، عَنْ عَبْدِ اللہِ بْنِ جَعْفَرٍ ، أَنَّ رَجُلاً اشْتَکَی ، فَقَالَ : لَقِّنُوہُ لاَ إلَہَ إِلاَّ اللَّہُ فَإِنَّہَا مَنْ کَانَتْ آخِرَ کَلاَمِہِ دَخَلَ الْجَنَّۃَ۔ (ابوداؤد ۳۱۰۷۔ احمد ۲۳۳)","Da'if","Musannaf Ibn Abi Shaybah 10972","","","كتاب الجنائز"
"10973","(۱۰۹۷۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ زَاذَانَ ، قَالَ مَنْ قَالَ لاَ إلَہَ إِلاَّ اللَّہُ عِنْدَ مَوْتِہِ دَخَلَ الْجَنَّۃَ۔","","Musannaf Ibn Abi Shaybah 10973","","","كتاب الجنائز"
"10974","(۱۰۹۷۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، قَالَ : حدَّثَنِی الْوَلِیدُ بْنُ مُسْلِمٍ ، عَنْ حُمْرَانَ ، عَنْ عُثْمَانَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ مَاتَ وَہُوَ یَعْلَمُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ دَخَلَ الْجَنَّۃَ۔(مسلم ۴۳۔ احمد ۶۹)","Sahih","Musannaf Ibn Abi Shaybah 10974","","","كتاب الجنائز"
"10975","(۱۰۹۷۵) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنِی شَرِیکٌ ، عَنْ عَاصِمٍ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : لَقِّنُوا مَوْتَاکُمْ لاَ إلَہَ إِلاَّ اللَّہُ فَإِنَّہَا لاَ تَکُونُ آخِرَ کَلاَمِ امْرِئٍ مُسْلِمٍ إِلاَّ حَرَّمَہُ اللَّہُ عَلَی النَّارِ۔","","Musannaf Ibn Abi Shaybah 10975","","","كتاب الجنائز"
"10976","(۱۰۹۷۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، قَالَ : حدَّثَنِی یَحْیَی بْنُ أَبِی رَاشِدٍ الْبَصْرِیُّ ، قَالَ : قَالَ عُمَرُ لاِبْنِہِ حِینَ حَضَرَتْہُ الْوَفَاۃُ إذَا حَضَرَتِ الْوَفَاۃُ فَاحْرفْنِی۔","","Musannaf Ibn Abi Shaybah 10976","","","كتاب الجنائز"
"10977","(۱۰۹۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ أَنْ یُوَجَّہَ الْمَیِّتُ الْقِبْلَۃَ إذَا حُضِرَ۔","","Musannaf Ibn Abi Shaybah 10977","","","كتاب الجنائز"
"10978","(۱۰۹۷۸) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یُسْتَحَبُّ أَنْ یُسْتَقْبَلَ بِالْمَیِّتِ الْقِبْلَۃُ إذَا کَانَ فِی الْمَوْتِ۔","","Musannaf Ibn Abi Shaybah 10978","","","كتاب الجنائز"
"10979","(۱۰۹۷۹) حَدَّثَنَا عُمَرُ بْنُ ہَارُونَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ کَانَ یُسْتَحَبُّ أَنْ یُوَجَّہَ الْمَیِّتُ عِنْدَ نَزْعِہِ إلَی الْقِبْلَۃِ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 10979","","","كتاب الجنائز"
"10980","(۱۰۹۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ إِنْ شِئْتَ فَوَجِّہِ الْمَیِّتَ وَإِنْ شِئْتَ فَلاَ تُوَجِّہْہُ۔","","Musannaf Ibn Abi Shaybah 10980","","","كتاب الجنائز"
"10981","(۱۰۹۸۱) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنْ سُفْیَانَ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، أَنَّہُ کَرِہَہُ ، وَقَالَ: أَلَیْسَ الْمَیِّتُ امْرَئًا مُسْلِمًا ؟۔","","Musannaf Ibn Abi Shaybah 10981","","","كتاب الجنائز"
"10982","(۱۰۹۸۲) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ، عَنْ رِبْعِیِّ بْنِ حِرَاشٍ، قَالَ: لَمَّا کَانَتْ لَیْلَۃ مَاتَ فِیہَا حُذَیْفَۃُ دَخَلَ عَلَیْہِ أَبُو مَسْعُودٍ ، فَقَالَ: تَنَحَّ فَقَدْ طَالَ لَیْلک فَأَسْنَدَہُ إلَی صَدْرِہِ فَأَفَاقَ ، فَقَالَ: أَیُّ سَاعَۃٍ ہَذِہِ قَالُوا: السَّحَرُ، فَقَالَ حُذَیْفَۃُ: اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ صَبَاحٍ إلَی النَّارِ وَمَسَائٍ بِہَا، ثُمَّ أَضْجَعْنَاہُ فَقَضَی۔","Sahih","Musannaf Ibn Abi Shaybah 10982","","","كتاب الجنائز"
"10983","(۱۰۹۸۳) حَدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، قَالَ : حدَّثَنِی زُرْعَۃُ بْنُ عَبْدِ الرَّحْمَنِ ، أَنَّہُ شَہِدَ سَعِیدَ بْنَ الْمُسَیَّبِ فِی مَرَضِہِ ، وَعِنْدَہُ أَبُو سَلَمَۃَ بْنُ عَبْدِ الرَّحْمَنِ , فَغُشِیَ عَلَی سَعِیدٍ , فَأَمَرَ أَبُو سَلَمَۃَ أَنْ یُحَوَّلَ فِرَاشُہُ إلَی الْکَعْبَۃِ فَأَفَاقَ ، فَقَالَ : حَوَّلْتُمْ فِرَاشِی ؟ فَقَالُوا : نَعَمْ , فَنَظَرَ إلَی أَبِی سَلَمَۃَ ، فَقَالَ : أُرَاہُ عَمَلَک ، فَقَالَ أَجَل : أَنَا أَمَرْتُہُمْ ، فَقَالَ فَأَمَرَ سَعِیدٌ أَنْ یُعَادَ فِرَاشُہُ۔","","Musannaf Ibn Abi Shaybah 10983","","","كتاب الجنائز"
"10984","(۱۰۹۸۴) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ التَّیْمِیِّ ، عَنْ بَکْرٍ ، قَالَ : إذَا أَغْمَضْت الْمَیِّتَ فَقُلْ : بِسْمِ اللہِ وَعَلَی وفاۃ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 10984","","","كتاب الجنائز"
"10985","(۱۰۹۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ قَبِیصَۃَ بْنِ ذُؤَیْبٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَغْمَضَ أَبَا سَلَمَۃَ۔ (عبدالرزاق ۶۰۵۰)","","Musannaf Ibn Abi Shaybah 10985","","","كتاب الجنائز"
"10986","(۱۰۹۸۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ یَحْیَی بْنِ أَبِی رَاشِدٍ الْبَصْرِیِّ ، قَالَ : قَالَ عُمَرُ حِینَ حَضَرَتْہُ الْوَفَاۃُ لاِبْنِہِ إذَا قُبِضْتُ فَأَغْمِضْنِی۔","","Musannaf Ibn Abi Shaybah 10986","","","كتاب الجنائز"
"10987","(۱۰۹۸۷) حَدَّثَنَا ابْنُ نُمَیْرٍ، عَنِ ابْنِ جُرَیْجٍ، عَنِ ابْنِ شِہَابٍ، قَالَ أَغْمَضَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَیْنَ رَجُلٍ۔","","Musannaf Ibn Abi Shaybah 10987","","","كتاب الجنائز"
"10988","(۱۰۹۸۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، أَوْ غَیْرِہِ ، قَالَ : قَالَ عُمَرُ لَقِّنُوا مَوْتَاکُمْ لاَ إلَہَ إِلاَّ اللَّہُ وَأَغْمِضُوا أَعْیُنَہُمْ إذَا مَاتُوا۔","","Musannaf Ibn Abi Shaybah 10988","","","كتاب الجنائز"
"10989","(۱۰۹۸۹) حَدَّثَنَا جَرِیرٌ ، عَنْ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ :إِذَا غُسِّل الْمَیِّت جُعِلَ بَینَہُ وَبَینَ السَّماء سترۃ۔","","Musannaf Ibn Abi Shaybah 10989","","","كتاب الجنائز"
"10990","(۱۰۹۹۰) حَدَّثَنَا أَزْہَر السَّمَّان ، عَنِ ابْنِ عَوْنٍ ، أَنَّ مُحَمَّدًا کَانَ یَسْتُرُ الْمَیِّتَ بِجَہدہ۔","","Musannaf Ibn Abi Shaybah 10990","","","كتاب الجنائز"
"10991","(۱۰۹۹۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ قَالَ : لاَ بَأْسَ أَنْ یَغْتَسِلَ الرَّجُل فِی الْفَضَائِ وَکَرِہَ أَنْ یُغَسَّلَ الْمَیِّتُ کَذَلِکَ۔","","Musannaf Ibn Abi Shaybah 10991","","","كتاب الجنائز"
"10992","(۱۰۹۹۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ مُحَمَّدِ بْنِ عَلِیٍّ ، قَالَ : غَسَّلَ عَلِیٌّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی قَمِیصٍ۔ (ابوداؤد ۳۱۳۳۔ مالک ۲۲۲)","","Musannaf Ibn Abi Shaybah 10992","","","كتاب الجنائز"
"10993","(۱۰۹۹۳) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ ہَمَّامٍ ، عَنْ أَیُّوبَ ، قَالَ : قَالَ لِی أَبُو قِلاَبَۃَ اسْتُرْہُ مَا اسْتَطَعْت۔","","Musannaf Ibn Abi Shaybah 10993","","","كتاب الجنائز"
"10994","(۱۰۹۹۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ )، قَالَ غَسَّلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلِیٌّ , وَعَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَمِیصُہُ , وَعَلَی یَدَیْ عَلِیٍّ خِرْقَۃٌ یُغَسِّلُہُ بِہَا یُدْخِلُ یَدَہُ تَحْتَ الْقَمِیصِ فَیُغَسِّلُہُ وَالْقَمِیصُ عَلَیْہِ۔ (بیہقی ۳۸۸)","Da'if","Musannaf Ibn Abi Shaybah 10994","","","كتاب الجنائز"
"10995","(۱۰۹۹۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ لَمَّا أَرَادُوا أَنْ یُغَسِّلُوا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ عَلَیْہِ قَمِیصٌ فَأَرَادُوا أَنْ یَنْزِعُوہُ فَسَمِعُوا نِدَائً مِنَ الْبَیْتِ لاَ تَنْزِعُوا الْقَمِیصَ۔ (ابن سعد ۲۷۵)","","Musannaf Ibn Abi Shaybah 10995","","","كتاب الجنائز"
"10996","(۱۰۹۹۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الضَّحَّاکِ ، قَالَ : لاَ تُجَرِّدُونِی۔","","Musannaf Ibn Abi Shaybah 10996","","","كتاب الجنائز"
"10997","(۱۰۹۹۷) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : کَانَ یُسْتَحَبُّ أَنْ یُوضَعَ السَّیْفُ عَلَی بَطْنِ الْمَیِّتِ۔","","Musannaf Ibn Abi Shaybah 10997","","","كتاب الجنائز"
"10998","(۱۰۹۹۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ الْحَذَّائِ ، عَنْ حَفْصَۃَ ، عَنْ أُمِّ عَطِیَّۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ لَہُنَّ فِی غُسْلِ ابْنَتِہِ : ابْدَأْنَ بِمَیَامِنِہَا وَمَوَاضِعِ الْوُضُوئِ مِنْہَا۔ (بخاری ۱۲۵۶۔ مسلم ۴۲)","Sahih","Musannaf Ibn Abi Shaybah 10998","","","كتاب الجنائز"
"10999","(۱۰۹۹۹) حَدَّثَنَا عبد الوہاب الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، قَالَ حَدَّثَتْنِی حَفْصَۃُ ، عَنْ أُمِّ عَطِیَّۃَ قَالَتْ دَخَلَ عَلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَنَحْنُ نُغَسِّلُ ابْنَتَہُ ، فَقَالَ : ابْدَأْنَ بِمَیَامِنِہَا وَمَوَاضِعِ الْوُضُوئِ مِنْہَا۔ (ابوداؤد ۳۱۳۷۔ احمد ۸۵)","Sahih","Musannaf Ibn Abi Shaybah 10999","","","كتاب الجنائز"
"11000","(۱۱۰۰۰) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، أَنَّہُ کَانَ إذَا سُئِلَ عَنْ غَسْلِ الْمَیِّتِ ، قَالَ : یُبْدَأْ بِمَیَامِنِہِ وَمَوَاضِعِ الْوُضُوئِ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 11000","","","كتاب الجنائز"
"11001","(۱۱۰۰۱) حَدَّثَنَا أَبُوالأَحْوَصِِ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: یُبْدَأُ بِالْمَیِّتِ فَیُوَضَّأُ وُضُوئَہُ لِلصَّلاَۃِ ثُمَّ یَبدَأ بِمَیَامِنِہ۔","","Musannaf Ibn Abi Shaybah 11001","","","كتاب الجنائز"
"11002","(۱۱۰۰۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ یُبدَأ بِالْمَیِّتِ فَیُوَضَّأُ وُضُوئَہُ لِلصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 11002","","","كتاب الجنائز"
"11003","(۱۱۰۰۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُوَضَّأُ وُضُوئَہُ لِلصَّلاَۃِ إِلاَّ رِجْلَیْہِ۔","","Musannaf Ibn Abi Shaybah 11003","","","كتاب الجنائز"
"11004","(۱۱۰۰۴) حَدَّثَنَا مُعَاذٌ وَأَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : یُوَضَّأُ وُضُوئَہُ لِلصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 11004","","","كتاب الجنائز"
"11005","(۱۱۰۰۵) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ مِنْدَلٍ ، عَنْ جَعْفَرٍ بن أَبِی الْمُغِیرَۃِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ یُوَضَّأُ الْمَیِّتُ وُضُوئَہُ لِلصَّلاَۃِ ، إِلاَّ أَنَّہُ لاَ یُمَضْمَضُ ، وَلاَ یُنَشَّقُ۔","","Musannaf Ibn Abi Shaybah 11005","","","كتاب الجنائز"
"11006","(۱۱۰۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ یُوَضَّأُ الْمَیِّتُ کَمَا یُوَضَّأُ الْحَیُّ۔","","Musannaf Ibn Abi Shaybah 11006","","","كتاب الجنائز"
"11007","(۱۱۰۰۷) غُنْدَرٌ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، وَسَعِیدِ بْنِ الْمُسَیَّبِ أَنَّہُمَا قَالاَ : فِی الْمَیِّتِ یُوَضَّأُ وُضُوئَہُ لِلصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 11007","","","كتاب الجنائز"
"11008","(۱۱۰۰۸) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی الأَسْلَمِیُّ ، عَنْ عُثْمَانَ بْنِ الأَسْوَد ، قَالَ حَضَرَنَا مُجَاہِدٌ وَنَحْنُ نُغَسِّلُ مَیِّتًا ، فَقَالَ: وَضِّئُوہُ وُضُوئَہُ لِلصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 11008","","","كتاب الجنائز"
"11009","(۱۱۰۰۹) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، عَنْ أُمِّ عَطِیَّۃَ قَالَتْ دَخَلَ عَلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَنَحْنُ نُغَسِّلُ ابْنَتَہُ ، فَقَالَ : اغْسِلْنَہَا ثَلاَثًا ، أَوْ خَمْسًا ، أَوْ أَکْثَرَ مِنْ ذَلِکَ إِنْ رَأَیْتُنَّ ذَلِکَ بِمَائٍ وَسِدْرٍ وَاجْعَلْنَ فِی الآخِرَۃِ کَافُورًا ، أَوْ شَیْئًا مِنْ کَافُورٍ فَإِذَا فَرَغْتُنَّ فَآذِنَّنِی ، فَلَمَّا فَرَغْنَا آذَنَّاہُ فَأَلْقَی إلَیْنَا حِقْوَہُ، فَقَالَ : أَشْعِرْنَہَا إیَّاہُ۔ (بخاری ۱۲۵۹۔ مسلم ۶۴۶)","Sahih","Musannaf Ibn Abi Shaybah 11009","","","كتاب الجنائز"
"11010","(۱۱۰۱۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ حَفْصَۃَ ، عَنْ أُمِّ عَطِیَّۃَ قَالَتْ : لَمَّا مَاتَتْ زَیْنَبُ ابنۃ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : اغْسِلْنَہَا وِتْرًا ثَلاَثًا ، أَوْ خَمْسًا وَاجْعَلْنَ فِی الآخِرَۃِ کَافُورًا ، أَوْ شَیْئًا مِنْ کَافُورٍ فَإِذَا غَسَلْتُنَّہَا فَأَعْلِمَنَّنِی، فَلَمَّا غَسَلْنَاہَا أَعْلَمْنَاہُ فَأَعْطَانَا حِقْوَہُ، فَقَالَ: أَشْعِرْنَہَا إیَّاہُ۔(مسلم ۴۰۔ احمد ۸۵)","Sahih","Musannaf Ibn Abi Shaybah 11010","","","كتاب الجنائز"
"11011","(۱۱۰۱۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ قَالاَ : یُغَسَّلُ الْمَیِّتُ ثَلاَثَ غَسَلاَتٍ ، أَوْ ثَلاَثَ مِرَارٍ ، مَرَّۃً بِمَائٍ وَسِدْرٍ ، وَمَرَّۃً بِمَائٍ قَرَاحٍ ، وَمَرَّۃً بِمَائٍ وَکَافُورٍ.","","Musannaf Ibn Abi Shaybah 11011","","","كتاب الجنائز"
"11012","(۱۱۰۱۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ یُغَسَّلُ الْمَیِّتُ ثَلاَثًا وَیُجْعَلُ السِّدْرُ فِی الْغَسْلَۃِ الْوُسْطَی۔","","Musannaf Ibn Abi Shaybah 11012","","","كتاب الجنائز"
"11013","(۱۱۰۱۳) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ یُغَسَّلُ الْمَیِّتُ ثَلاَثَ غَسَلاَتٍ بِسِدْرٍ وَمَائٍ۔","","Musannaf Ibn Abi Shaybah 11013","","","كتاب الجنائز"
"11014","(۱۱۰۱۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُوَضَّأُ الْمَیِّتُ وُضُوئَہُ لِلصَّلاَۃِ إِلاَّ رِجْلَیْہِ، ثُمَّ یُصَبُّ الْمَائُ مِنْ قِبَلِ رَأْسِہِ وَیُمْسَحُ بَطْنُہُ ، فَإِنْ کَانَ شَیْئٌ خَرَجَ ، ثُمَّ یُتْرَکُ ، حَتَّی إذَا قُلْتَ جَفَّ ، أَوْ کَادَ ، غُسِلَ الثَّانِیَۃَ وَالثَّالِثَۃَ ، وَتُجَمَّرُ ثِیَابُہُ ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 11014","","","كتاب الجنائز"
"11015","(۱۱۰۱۵) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: یَقْعُد غَاسِل المَیت بَین کُل غُسْلَین قَعْدَۃ قَدْر مَا یَسْتَرِیح۔","","Musannaf Ibn Abi Shaybah 11015","","","كتاب الجنائز"
"11016","(۱۱۰۱۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عن إبراہیم ، قَالَ : لاَ یُمَضْمَضُ الْمَیِّتُ ، وَلاَ یُنَشَّقُ ، وَلَکِنْ یُؤْخَذُ خِرْقَۃٌ نَظِیفَۃٌ فَیُمْسَحُ بِہَا فَمُہُ وَمَنْخِرَاہُ۔","","Musannaf Ibn Abi Shaybah 11016","","","كتاب الجنائز"
"11017","(۱۱۰۱۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنْ فَرْقَدٍ السَّبَخِیِّ ، عَنْ أَبِی تَمِیمَۃَ الْہُجَیْمِیِّ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ کَتَبَ إلَی أَبِی مُوسَی الأَشْعَرِیِّ أَنِ اغْسِلْ ذَیْنِکَ بِالسِّدْرِ وَمَائِ الرَّیْحَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 11017","","","كتاب الجنائز"
"11018","(۱۱۰۱۸) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ عَبْدِ اللہِ بْنِ الْمُخْتَارِ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، قَالَ : حَدَّثَنَا أَبُو کَرْبٍ، أو أَبُو حَرْبٍ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو، أَنَّ أَبَاہُ أَوْصَاہُ، فَقَالَ: یَا بُنَیَّ إذَا مِتُّ فَاغْسِلْنِی غَسْلَۃً بِالْمَائِ، ثُمَّ جَفِّفْنِی فی ثَوْبٍ ، ثُمَّ اغْسِلْنِی الثَّانِیَۃَ بِمَائٍ قَرَاحٍ ، ثُمَّ جَفِّفْنِی فی ثَوْبٍ ثم إِذَا أَلْبَسْتنِی الثِّیَابَ فَأَزِّرْنِی۔","Sahih","Musannaf Ibn Abi Shaybah 11018","","","كتاب الجنائز"
"11019","(۱۱۰۱۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : یُغسَلُ أَوَّلَ غَسْلَۃٍ بِمَائٍ قَرَاحٍ وَالثَّانِیَۃَ بِمَائٍ وَسِدْرٍ ، وَالثَّالِثَۃَ بِمَائٍ وَکَافُورٍ ، ثُمَّ یُؤْخَذُ الْکَافُورُ وَیُوضَعُ عَلَی مَوَاضِعِ مَسَاجِدِہِ۔","","Musannaf Ibn Abi Shaybah 11019","","","كتاب الجنائز"
"11020","(۱۱۰۲۰) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، عَنْ أَیُّوبَ السِّخْتِیَانِیِّ ، قَالَ : کَانَ أَبُو قِلاَبَۃَ إذَا غُسِّلَ الْمَیِّتُ أَمَرَ بِالسِّدْرِ فَصُفِّیَ فِی ثَوْبٍ فَغُسِّلَ بِصَفْوِہِ وَرُمِیَ بِثُفْلِہِ۔","","Musannaf Ibn Abi Shaybah 11020","","","كتاب الجنائز"
"11021","(۱۱۰۲۱) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، عَنْ عُتَیٍّ ، عَنْ أُبَیٍّ ، قَالَ لَمَّا ثَقُلَ آدَم أَمَرَ بَنِیہِ أَنْ یَجِدُّوا مِنْ ثِمَارِ الْجَنَّۃِ فَجَاؤوا فَتَلَقَّتْہُمُ الْمَلاَئِکَۃُ فَقَالُوا : ارْجِعُوا فَقَدْ أَمَرَ اللَّہُ بِقَبْضِ أَبِیکُمْ فَرَجَعُوا مَعَہُمْ فَقَبَضُوا رُوحَہُ وَجَاؤُوا مَعَہُمْ بِکَفَنِہِ وَحَنَّطُوہ ، وَقَالُوا لِبَنِیہِ : احْضُرُونَا ، فَاغْسِلُوہُ ، وَکَفِّنُوہُ ، وَحَنِّطُوہُ ، وَصَلُّوْا عَلَیْہِ ، ثم قَالُوا : یَا بَنِی آدَمَ ، ہَذِہِ سُنَّتکم بَیْنَکُمْ۔ (حاکم ۳۳۴)","Sahih","Musannaf Ibn Abi Shaybah 11021","","","كتاب الجنائز"
"11022","(۱۱۰۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ حَکِیمِ بْنِ جَابِرٍ الأَحْمَسِیِّ ، قَالَ : لَمَّا مَاتَ الأَشْعَثُ بْنُ قَیْسٍ وَکَانَتِ ابْنَتُہُ تَحْتَ الْحَسَنِ بْنِ عَلِیٍّ ، قَالَ : قَالَ الْحَسَنُ بْنُ عَلِیٍّ إذَا غَسَّلْتُمُوہُ فَلاَ تُہَیجوہُ حَتَّی تُؤْذِنُونِی فَآذَنَّاہُ فَجَائَ فَوَضَّأَہُ بِالْحَنُوطِ وُضُوء ًا۔","Hasan","Musannaf Ibn Abi Shaybah 11022","","","كتاب الجنائز"
