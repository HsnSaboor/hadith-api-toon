hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"8017","(۸۰۱۷) حَدَّثَنَا زَیْدُ بْنُ حُبَاب ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، قَالَ : حدَّثَنِی السَّفْرُ بْنُ نُسَیْرٍ الأَسَدِیُّ ، عَنْ یَزِیدَ بْنِ شُرَیْحٍ الْحَضْرَمِیِّ ، أَنَّہُ سَمِعَ أَبَا أُمَامَۃَ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَأْتِی أَحَدُکُمُ الصَّلاَۃ وَہُوَ حَاقِنٌ حَتَّی یَتَخَفَّفَ۔ (احمد ۵/۲۵۰۔ طبرانی ۷۵۰۷)","Da'if","Musannaf Ibn Abi Shaybah 8017","","","كتاب الجمعة"
"8018","(۸۰۱۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : لاَ یَقُومُ أَحَدُکُمْ إلَی الصَّلاَۃ وَبِہِ أَذًی۔ (احمد ۲/۴۴۲۔ ابن حبان ۲۰۷۲)","Hasan","Musannaf Ibn Abi Shaybah 8018","","","كتاب الجمعة"
"8019","(۸۰۱۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ زَمْعَۃَ ، عَنْ عُثْمَانَ بْنِ الزُّبَیْرِ ، عَنْ یَحْیَی بْنِ جَعْدَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَقْرَبُ الصَّلاَۃ الزَّنیء قِیلَ : یَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَمَا الزَّنیء ؟ قَالَ : الَّذِی یَجِدُ الرِّزّ فِی بَطْنِہِ۔","","Musannaf Ibn Abi Shaybah 8019","","","كتاب الجمعة"
"8020","(۸۰۲۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدِ بْنِ أَبِی صَدَقَۃَ ، عَنْ یَحْیَی بْنِ عَتِیقٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : یُکْرَہُ حَبْسُ الأَذَی مَا لَمْ یَخَفْ فَوْتَ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8020","","","كتاب الجمعة"
"8021","(۸۰۲۱) حَدَّثَنَا حَفْصٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ الأَرْقَمِ ، قَالَ : خَرَجَ مُعْتَمِرًا مَعَ أَصْحَابِہِ فَأَذَّنَ وَأَقَامَ ، وَقَالَ لِبَعْضِ أَصْحَابِہِ : تَقَدَّمْ إنِّی سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إذَا حَضَرَتِ الصَّلاَۃ وَأَحَدُکُمْ یُرِیدُ الْخَلاَئَ فَابْدَأْ بِالْخَلاَئِ۔ (ترمذ ی۱۴۲۔ ابوداؤد ۸۹)","Sahih","Musannaf Ibn Abi Shaybah 8021","","","كتاب الجمعة"
"8022","(۸۰۲۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سُئِلَ نَافِعٌ عَنِ الرَّجُلِ یَجِدُ النَّفْخَۃَ فِی بَطْنِہِ ؟ قَالَ : لاَ یُصَلِّی وَہُوَ یَجِدُ النَّفْخَۃَ۔","","Musannaf Ibn Abi Shaybah 8022","","","كتاب الجمعة"
"8023","(۸۰۲۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی حَزْرَۃَ شَیْخٍ مِنْ أَہْلِ الْمَدِینَۃِ وَأَثْنَی عَلَیْہِ خَیْرًا ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ، قَالَ : دَخَلَ بَعْضُ بَنِی أَخِی عَائِشَۃَ إلَیْہَا فَقَامَ إلَی الْمَسْجِدِ ، فَقَالَتْ لَہُ : اجْلِسْ إنِّی سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : لاَ یُصَلِّی أَحَدُکُمْ بِحَضْرَۃِ طَعَامٍ ، وَلاَ ہُوَ یُدَافِعُ الأَخْبَثَیْنِ۔ (مسلم ۳۹۳۔ ابن حبان ۲۰۷۳)","Sahih","Musannaf Ibn Abi Shaybah 8023","","","كتاب الجمعة"
"8024","(۸۰۲۴) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، عَنْ عِکْرِمَۃَ ، قَالَ : لأَنْ أَصُرَّہُ فِی عِمَامَتِی ، ثُمَّ أَقُومَ إلَی الصَّلاَۃ أَحَبُّ إلَیَّ مِنْ أَنْ أُدَافِعَہُ وَأَنَا أُصَلِّی ، یَعْنِی الْغَائِطَ وَالْبَوْلَ۔","","Musannaf Ibn Abi Shaybah 8024","","","كتاب الجمعة"
"8025","(۸۰۲۵) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، عَنْ بَکْرٍ ، قَالَ : لأَنْ أُہْرِیقَ الْمَائَ وَأَتَیَمَّمَ وَأُصَلِّیَ أَحَبُّ إلَیَّ مِنْ أَنْ أُصَلِّیَ وَأَنَا أُدَافِعُ غَائِطًا ، أَوْ بَوْلاً۔","","Musannaf Ibn Abi Shaybah 8025","","","كتاب الجمعة"
"8026","(۸۰۲۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَجِدُ الْبَوْلَ أَوِ النَّفْخَۃَ ، قَالَ : یُصَلِّی مَا لَمْ یُعَجِّلْہُ عَنْ صَلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 8026","","","كتاب الجمعة"
"8027","(۸۰۲۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : نُبِّئْتُ عَنْ طَاوُوسٍ قَالَ : إنَّا لَنَصُرُّہُ صَرًّا۔","","Musannaf Ibn Abi Shaybah 8027","","","كتاب الجمعة"
"8028","(۸۰۲۸) حَدَّثَنَا ہُشَیْمٌ ، وَابْنُ عُلَیَّۃَ ، عَنِ ابن عَوْنٍ ، عَنْ إبْرَاہِیمَ قَالَ : ذَکَرُوا عِنْدَہُ الرَّجُلَ یَجِدُ الْبَوْلَ ، قَالَ ہُشَیْمٌ : وَیَجِدُ النَّفْخَۃَ أَیَتَوَضَّأُ ؟ فَقَالَ : إذنْ وَاللَّہِ لاَ نَزَالُ نَتَوَضَّأُ۔","","Musannaf Ibn Abi Shaybah 8028","","","كتاب الجمعة"
"8029","(۸۰۲۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : ذَکَرْت ذَلِکَ لِمُحَمَّدٍ ، فَقَالَ : کَانُوا یَرَوْنَہُ مَا وَجَدَ بُدًّا۔","","Musannaf Ibn Abi Shaybah 8029","","","كتاب الجمعة"
"8030","(۸۰۳۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ وَاصِلٍ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ لَہُ : أَجِدُ الْعَصْرَ مِنَ الْبَوْلِ فَتَحْضُرُ الصَّلاَۃ فَأُصَلِّی وَأَنَا أَجِدُہُ ، قَالَ : نَعَمْ إِنْ کُنْتَ تَرَی أَنَّک تَحْبِسُہُ حَتَّی تُصَلِّی۔","","Musannaf Ibn Abi Shaybah 8030","","","كتاب الجمعة"
"8031","(۸۰۳۱) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ جَابِرٍ، عَنْ مُحَمَّدِ بْنِ عَلِیٍّ وَعَامِرٍ وَعَطَائٍ، قَالُوا: لاَ بَأْسَ أَنْ یَحْقِنَ الرَّجُلُ۔","","Musannaf Ibn Abi Shaybah 8031","","","كتاب الجمعة"
"8032","(۸۰۳۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِاللہ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَحْقِنَ الرَّجُلُ الْبَوْلَ مَا لَمْ یُعْجِلہُ عَنِ الرُّکُوعِ وَالسُّجُودِ۔","","Musannaf Ibn Abi Shaybah 8032","","","كتاب الجمعة"
"8033","(۸۰۳۳) حَدَّثَنَا حَفْصٌ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ، عَنْ أَبِیہِ، قَالَ: قَالَ عُمَرُ: إنِّی لأَحْسِبُ جِزْیَۃَ الْبَحْرَیْنِ وَأَنَا فِی الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 8033","","","كتاب الجمعة"
"8034","(۸۰۳۴) حَدَّثَنَا حَفْصٌ، عَنْ عَاصِمٍ، عَنْ أَبِی عُثْمَانَ النَّہْدِیِّ، قَالَ: قَالَ عُمَرُ: إنِّی لأُجَہِّزُ جُیُوشِی وَأَنَا فِی الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 8034","","","كتاب الجمعة"
"8035","(۸۰۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ مُحَمَّدًا عَنِ الإِمَام یُصَلی بِالقَوم یَقُومُ فِی زَاوِیَۃٍ وَلاَ یَقُومُ وَسَطًا ؟ فَقَالَ : لاَ أَعْلَمُ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 8035","","","كتاب الجمعة"
"8036","(۸۰۳۶) حَدَّثَنَا بِشْرُ بْنُ مُفَضَّلٍ ، عَنْ قُرَّۃَ ، قَالَ : کَانَ أَبُو الْعَلاَئِ یَسْتَعْرِضُ بِنَا الظِّلَّ فَیُصَلِّی بِنَا أَیَّ نَوَاحِی الْمَسْجِدِ کَانَ۔","","Musannaf Ibn Abi Shaybah 8036","","","كتاب الجمعة"
"8037","(۸۰۳۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُغِیرَۃُ بْنُ زِیَادٍ الْمَوْصِلِیُّ ، قَالَ : رَأَیْتُ عَطَائً یُصَلِّی فِی السَّقِیفَۃِ فِی الْمَسْجِدِ الْحَرَامِ فِی النَّفَرِ وَہُمْ مُتَفَرِّقُونَ عَنِ الصُّفُوفِ فَقُلْتُ لَہُ ، أَوْ قِیلَ لَہُ ، فَقَالَ : إنِّی شَیْخٌ کَبِیرٌ وَمَکَّۃُ دَوِّیَّۃٌ ، قَدْ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ فَأَصَابَہُ مَطَرٌ فَصَلَّی بِالنَّاسِ وَہُمْ فِی رِحَالِہِمْ وَبِلاَلٌ یُسْمِعُ النَّاسَ التَّکْبِیرَ۔","","Musannaf Ibn Abi Shaybah 8037","","","كتاب الجمعة"
"8038","(۸۰۳۸) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیدَ ، عَنِ الزُّبَیْرِ بْنِ الْخِرِّیتِ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ الْعُقَیْلِیِّ قَالَ : رُبَّمَا أَمَّنَا ابْنُ عَبَّاسٍ فِی زَاوِیَۃِ الْمَسْجِدِ ، وَلاَ یَتَوَسَّطُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 8038","","","كتاب الجمعة"
"8039","(۸۰۳۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ أَبِی عَرُوبَۃَ قَالَ: رَأَیْتُُ الْحَسَنَ الْبَصْرِیَّ یَؤُمُّہُمْ فِی زَاوِیَۃٍ۔","","Musannaf Ibn Abi Shaybah 8039","","","كتاب الجمعة"
"8040","(۸۰۴۰) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : قَالَ بِلاَلٌ : یَا رَسُولَ اللہِ لاَ تَسْبِقْنِی بِآمِینَ۔ (ابوداؤد ۹۳۴۔ احمد ۶/۱۵)","","Musannaf Ibn Abi Shaybah 8040","","","كتاب الجمعة"
"8041","(۸۰۴۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ رفعہ ، قَالَ : إذَا أَمَّنَ الْقَارِیئُ فَأَمِّنُوا فَمَنْ وَافَقَ تَأْمِینُہُ تَأْمِینَ الْمَلاَئِکَۃِ غُفِرَ لَہُ مَا تَقَدَّمَ مِنْ ذَنْبِہِ۔ (بخاری ۶۴۰۲۔ مسلم ۷۲)","Sahih","Musannaf Ibn Abi Shaybah 8041","","","كتاب الجمعة"
"8042","(۸۰۴۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ، عَنْ أَبِیہِ ، قَالَ : صَلَّیْتُ خَلْفَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَلَمَا قَالَ {غَیْرِ الْمَغْضُوبِ عَلَیْہِمْ وَلاَ الضَّالِّینَ} قَالَ : آمِینَ۔ (عبدالرزاق ۲۶۳۳۔ احمد ۴/۳۱۸)","","Musannaf Ibn Abi Shaybah 8042","","","كتاب الجمعة"
"8043","(۸۰۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ حُجْرِ بْنِ عَنْبَسٍ ، عَنْ وَائِلِ بْنِ حُجْرٍ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَأَ : {وَلاَ الضَّالِّینَ} فَقَالَ : آمِینَ یَمُدُّ بِہَا صَوْتَہُ۔ (ترمذی ۲۴۹۔ ابوداؤد ۹۳۰)","Sahih","Musannaf Ibn Abi Shaybah 8043","","","كتاب الجمعة"
"8044","(۸۰۴۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی مَیْسَرَۃَ : أَنَّ جِبْرِیل علیہ السلام أَقْرَأَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَاتِحَۃَ الْکِتَابِ ، فَلَمَا قَالَ : {وَلاَ الضَّالِّینَ} قَالَ : قُلْ آمِینَ ، فَقَالَ : آمِینَ۔","","Musannaf Ibn Abi Shaybah 8044","","","كتاب الجمعة"
"8045","(۸۰۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا کَثِیرُ بْنُ زَیدٍ ، عَنِ الْوَلِیدِ بْنِ رَبَاحٍ ، عَنْ أَبِی ہُرَیْرَۃَ : أَنَّہُ کَانَ مُؤَذِّنًا بِالْبَحْرَیْنِ ، فَقَالَ لِلإِمَامِ : لاَ تَسْبِقْنِی بِآمِینَ۔","Hasan","Musannaf Ibn Abi Shaybah 8045","","","كتاب الجمعة"
"8046","(۸۰۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا فِطْرٌ ، قَالَ : سَمِعْتُ عِکْرِمَۃَ یَقُولُ : أَدْرَکْتُ النَّاسَ وَلَہُمْ رَجَّۃٌ فِی مَسَاجِدِہِمْ بِآمِینَ إذَا قَالَ الإِمَام : {غَیْرِ الْمَغْضُوبِ عَلَیْہِمْ وَلاَ الضَّالِّینَ}۔","","Musannaf Ibn Abi Shaybah 8046","","","كتاب الجمعة"
"8047","(۸۰۴۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّمَا جُعِلَ الإِمَام لِیُؤْتَمَّ بِہِ فَإذَا قَالَ : {غَیْرِ الْمَغْضُوبِ عَلَیْہِمْ وَلاَ الضَّالِّینَ} فَقُولُوا : آمِینَ۔ (ابن ماجہ ۸۴۶۔ مالک ۴۵)","Hasan","Musannaf Ibn Abi Shaybah 8047","","","كتاب الجمعة"
"8048","(۸۰۴۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِید ، عَنْ قَتَادَۃَ ، عَنْ یُونُسَ بْنِ جُبَیْرٍ ، عَنْ حِطَّانَ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی مُوسَی، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ۔ (مسلم ۶۳۔ ابوداؤد ۹۶۴)","Sahih","Musannaf Ibn Abi Shaybah 8048","","","كتاب الجمعة"
"8049","(۸۰۴۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِیہِ ، عَنْ أَبِی یَعْلَی ، قَالَ : کَانَ الرَّبِیعُ بْنُ خُثَیم إذَا قَالَ الإِمَام : {غَیْرِ الْمَغْضُوبِ عَلَیْہِمْ وَلاَ الضَّالِّینَ} فَقَالَ : اللَّہُمَّ اغْفِرْ لِی آمِینَ۔","","Musannaf Ibn Abi Shaybah 8049","","","كتاب الجمعة"
"8050","(۸۰۵۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یُونُسُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ بَکْرِ بْنِ مَاعِز ، عَنِ الرُّبَیعِ بْنِ خُثَیم ، قَالَ : إذَا قَالَ الإِمَام : {غَیْرِ الْمَغْضُوبِ عَلَیْہِمْ وَلاَ الضَّالِّینَ} فَاسْتَعِنْ مِنَ الدُّعاء بِمَا شِئْتَ۔","","Musannaf Ibn Abi Shaybah 8050","","","كتاب الجمعة"
"8051","(۸۰۵۱) حَدَّثَنَا أَبُو الأَحْوَصِ، عَنْ أَبِی حَمْزَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: کَانَ یُسْتَحَبُّ إذَا قَالَ الإِمَام: {غَیْرِ الْمَغْضُوبِ عَلَیْہِمْ وَلاَ الضَّالِّینَ} أَنْ یُقَالَ : اللَّہُمَّ اغْفِرْ لِی آمِینَ۔","","Musannaf Ibn Abi Shaybah 8051","","","كتاب الجمعة"
"8052","(۸۰۵۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : صَلَّیْتُ خَلْفَ أَبِی عَبْدِ اللہِ الْجَدَلِیِّ ، فَلَمَا قَالَ : {غَیْرِ الْمَغْضُوبِ عَلَیْہِمْ وَلاَ الضَّالِّینَ} قَالَ : کَفَی بِاللَّہِ ہَادِیًا وَنَصِیرًا۔","","Musannaf Ibn Abi Shaybah 8052","","","كتاب الجمعة"
"8053","(۸۰۵۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ یُونُسَ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا قَالَ الإِمَام : {غَیْرِ الْمَغْضُوبِ عَلَیْہِمْ وَلاَ الضَّالِّینَ} فَقُلْ : اللَّہُمَّ إنِّی أَسْأَلُک الْجَنَّۃَ وَأَعُوذُ بِکَ مِنَ النَّارِ۔","","Musannaf Ibn Abi Shaybah 8053","","","كتاب الجمعة"
"8054","(۸۰۵۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، قَالَ : آمِینَ اسْمٌ مِنْ أَسْمَائِ اللہِ۔","","Musannaf Ibn Abi Shaybah 8054","","","كتاب الجمعة"
"8055","(۸۰۵۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 8055","","","كتاب الجمعة"
"8056","(۸۰۵۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سُفْیَانَ ، عَنْ طَارِقٍ ، عَنْ حَکِیمِ بْنِ جَابِرٍ ، قَالَ : آمِینَ اسْمٌ مِنْ أَسْمَائِ اللہِ۔","","Musannaf Ibn Abi Shaybah 8056","","","كتاب الجمعة"
"8057","(۸۰۵۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : آمِینَ اسْمٌ مِنْ أَسْمَائِ اللہِ۔","","Musannaf Ibn Abi Shaybah 8057","","","كتاب الجمعة"
"8058","(۸۰۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الرَّبِیعُ ، عَنْ عَطَائٍ ، قَالَ : لَقَدْ کَانَ لَنَا دَوِیٌّ فِی مَسْجِدِنَا ہَذَا بِآمِینَ إذَا قَالَ الإِمَام : {غَیْرِ الْمَغْضُوبِ عَلَیْہِمْ وَلاَ الضَّالِّینَ}۔","","Musannaf Ibn Abi Shaybah 8058","","","كتاب الجمعة"
"8059","(۸۰۵۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ رَجُلٍ ، عَنْ مُعَاذٍ : أَنَّہُ کَانَ إذَا خَتَمَ الْبَقَرَۃَ قَالَ : آمِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 8059","","","كتاب الجمعة"
"8060","(۸۰۶۰) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ أَبِی حَمْزَۃَ مَوْلَی الْمُہَلَّبِ : أَنَّہُ صَلَّی إلَی جَنْبِ سَعِیدِ بْنِ جُبَیْرٍ ، فَلَمَا قَالَ : {غَیْرِ الْمَغْضُوبِ عَلَیْہِمْ وَلاَ الضَّالِّینَ} قَالَ : آمِینَ ، أَوْ شَیْئًا ہَذَا مَعَنَاہُ۔","","Musannaf Ibn Abi Shaybah 8060","","","كتاب الجمعة"
"8061","(۸۰۶۱) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ ہِشَامٍ، عَنْ مُحَمَّدٍ: أَنَّ أَبَا ہُرَیْرَۃَ کَانَ مُؤَذِّنًا بِالْبَحْرَیْنِ، فَقَالَ لِلإِمَامِ: لاَ تَسْبِقْنِی بِآمِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 8061","","","كتاب الجمعة"
"8062","(۸۰۶۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ رَجُلٍ ، أَنَّ مُعَاذًا کَانَ إذَا قَرَأَ آخِرَ الْبَقَرَۃِ {فَانْصُرْنَا عَلَی الْقَوْمِ الْکَافِرِینَ} قَالَ : آمِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 8062","","","كتاب الجمعة"
"8063","(۸۰۶۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، قَالَ : لَعَلَّہُ عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ الزُّبَیْرِ ، قَالَ : کَانَ لِلْمَسْجِدِ رَجَّۃٌ ، أَوْ قَالَ لُجَّۃٌ إذَا قَالَ الإِمَام : {غَیْرِ الْمَغْضُوبِ عَلَیْہِمْ وَلاَ الضَّالِّینَ}۔","","Musannaf Ibn Abi Shaybah 8063","","","كتاب الجمعة"
"8064","(۸۰۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سُہَیْلِ بْنِ أَبِی صَالِحٍ ، عَنِ ابْنِ أَبِی سَعِیدٍ الْخُدْرِیِّ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا تَثَائَبَ أَحَدُکُمْ فِی الصَّلاَۃ فَلْیَکْظِمْ مَا اسْتَطَاعَ فَإِنَّ الشَّیْطَانَ یَدْخُلُ۔ (مسلم ۵۸۔ ابوداؤد ۴۹۸۷)","Sahih","Musannaf Ibn Abi Shaybah 8064","","","كتاب الجمعة"
"8065","(۸۰۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی فَزَارَۃَ الْعَبْسِیِّ ، عَنْ یَزِیدَ بْنِ الأَصَمِّ ، قَالَ : مَا تَثَائَبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی صَلاَۃ قَطُّ۔","","Musannaf Ibn Abi Shaybah 8065","","","كتاب الجمعة"
"8066","(۸۰۶۶) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: إذَا تَثَائَبَ أَحَدُکُمْ فِی الصَّلاَۃ فَلْیَضَعْ یَدَہُ عَلَی فِیہِ۔","Sahih","Musannaf Ibn Abi Shaybah 8066","","","كتاب الجمعة"
"8067","(۸۰۶۷) عن قتادۃ بِمِثْلِ حَدِیثِ سُفْیَانَ۔","","Musannaf Ibn Abi Shaybah 8067","","","كتاب الجمعة"
"8068","(۸۰۶۸) حَدَّثَنَا عَبْدَۃَُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ، عَنْ عَلِیٍّ ، قَالَ : التَّثَاؤُبُ فِی الصَّلاَۃ مِنَ الشَّیْطَانِ وَشِدَّۃُ الْعُطَاسِ وَالنُّعَاسُ عِنْدَ الْمَوْعِظَۃِ۔","","Musannaf Ibn Abi Shaybah 8068","","","كتاب الجمعة"
"8069","(۸۰۶۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَزِیدَ عَنْ أَبِی ظَبْیَانَ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : التَّثَاؤُبُ فِی الصَّلاَۃ وَالْعُطَاسُ مِنَ الشَّیْطَانِ فَتَعَوَّذُوا بِاللَّہِ مِنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 8069","","","كتاب الجمعة"
"8070","(۸۰۷۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إنِّی لأَدْفَعُ التَّثَاوُبَ فِی الصَّلاَۃ بِالتَّنَحْنُحِ۔","","Musannaf Ibn Abi Shaybah 8070","","","كتاب الجمعة"
"8071","(۸۰۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا تَثَائَبَ فِی الصَّلاَۃ ضَمَّ شَفَتَیْہِ ، وَمَسَحَ أَنْفَہُ۔","","Musannaf Ibn Abi Shaybah 8071","","","كتاب الجمعة"
"8072","(۸۰۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : نُبِّئْتُ أَنَّ لِلشَّیْطَانِ قَارُورَۃً یُشِمُّہَا الْقَوْمَ فِی الصَّلاَۃ کَیْ یَتَثَائَبُوا۔","","Musannaf Ibn Abi Shaybah 8072","","","كتاب الجمعة"
"8073","(۸۰۷۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الرَّبِیعُ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَرُدُّ الرَّجُلُ التَّثَاؤُبَ فِی الصَّلاَۃ مَا اسْتَطَاعَ ، فَإِنْ غَلَبَہُ وَضَعَ یَدَہُ عَلَی فِیہِ۔","","Musannaf Ibn Abi Shaybah 8073","","","كتاب الجمعة"
"8074","(۸۰۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : التَّثَاؤُبُ فِی الصَّلاَۃ مِنَ الشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 8074","","","كتاب الجمعة"
"8075","(۸۰۷۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : إنَّ لِلشَّیْطَانِ قَارُورَۃً فِیہَا نَفُوخٌ فَإِذَا قَامُوا إلَی الصَّلاَۃ أُنْشَقُوہَا فَأُمِرُوا عِنْدَ ذَلِکَ بِالاسْتِنْثَارِ۔","","Musannaf Ibn Abi Shaybah 8075","","","كتاب الجمعة"
"8076","(۸۰۷۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو مَعْشَرٍ ، عَنْ سَعِیدٍ الْمَقْبُرِیِّ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: إنَّ اللَّہَ یَکْرَہُ التَّثَاؤُبَ وَیُحِبُّ الْعُطَاسَ فِی الصَّلاَۃ۔","Da'if","Musannaf Ibn Abi Shaybah 8076","","","كتاب الجمعة"
"8077","(۸۰۷۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا تَثَائَبَ فِی الصَّلاَۃ فَلْیُمْسِکْ ، عَنِ الْقِرَائَۃِ۔","","Musannaf Ibn Abi Shaybah 8077","","","كتاب الجمعة"
"8078","(۸۰۷۸) حَدَّثَنَا أَبُو خَالِدٍ وَلَیْسَ بِالأَحْمَر ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ یَعْلَی بْنِ حَکِیمٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : إذَا تَثَائَبَ أَحَدُکُمْ وَہُوَ یَقْرَأُ فَلْیُمْسِکْ عَنِ الْقِرَائَۃِ۔","","Musannaf Ibn Abi Shaybah 8078","","","كتاب الجمعة"
"8079","(۸۰۷۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عَبَّادِ بْنِ تَمِیمٍ ، عَنْ عَمِّہِ : شُکِیَ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الرَّجُلُ یَجِدُ الشَّیْئَ فِی الصَّلاَۃ یَتَشَبَّہُ عَلَیْہِ ، قَالَ : إِنَّہُ لاَ یَجِبُ عَلَیْہِ شَیْئٌ حَتَّی یَجِدَ رِیحَہُ ، وَیَسْمَعَ صَوْتَہُ۔ (بخاری ۱۳۷۔ ابوداؤد ۱۷۸)","Sahih","Musannaf Ibn Abi Shaybah 8079","","","كتاب الجمعة"
"8080","(۸۰۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عِیَاضِ بْنِ ہِلاَلٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا جَائَ أَحَدَکُمُ الشَّیْطَانُ وَہُوَ فِی صَلاَتِہِ فَقَالَ لَہُ : إنَّکَ قَدْ أَحْدَثْتَ فَلْیَقُلْ : کَذَبْتَ مَا لَمْ یَجِدْ رِیحَہُ بِأَنْفِہِ ، أَوْ یَسْمَعْ صَوْتَہُ بِأُذُنِہِ۔(ابوداؤد ۱۰۲۱۔ احمد ۳/۵۱)","Da'if","Musannaf Ibn Abi Shaybah 8080","","","كتاب الجمعة"
"8081","(۸۰۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ سُہَیْلٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ وُضُوئَ إِلاَّ مِنْ رِیحٍ ، أَوْ صَوْتٍ۔ (ترمذی ۷۵۔ ابوداؤد ۱۷۹)","Sahih","Musannaf Ibn Abi Shaybah 8081","","","كتاب الجمعة"
"8082","(۸۰۸۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُبَیْدِ اللہِ ، عَنْ مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَائٍ ، قَالَ : رَأَیْتُُ السَّائِبَ بْنَ خَبَّابٍ یَشُمُّ ثَوْبَہُ فَقُلْتُ لَہُ : مِمَّ ذَلِکَ رَحِمَک اللَّہُ ؟ فَقَالَ : إنِّی سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : لاَ وُضُوئَ إِلاَّ مِنْ رِیحٍ ، أَوْ سَمَاعٍ۔ (احمد ۳/۴۲۶۔ طبرانی ۶۶۲۲)","Da'if","Musannaf Ibn Abi Shaybah 8082","","","كتاب الجمعة"
"8083","(۸۰۸۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنِ الْمِنْہَالِ بْنِ عَمْرٍو ، عَنْ قَیْسِ بْنِ سَکَنٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : إنَّ الشَّیْطَانَ یَأْتِی أَحَدَکُمْ وَہُوَ فِی الصَّلاَۃ فَیَبَلُّ إحْلِیلَہُ حَتَّی یَرَی أَنَّہُ قَدْ أَحْدَثَ ، وَأَنَّہُ یَأْتِیہِ فَیَضْرِبُ دُبُرَہُ ، فَیُرِیہِ أَنَّہُ قَدْ أَحْدَثَ ، فَلاَ تَنْصَرِفُوا حَتَّی تَجِدُوا رِیحًا ، أَوْ تَجِدُوا بَلَلاً۔","Sahih","Musannaf Ibn Abi Shaybah 8083","","","كتاب الجمعة"
"8084","(۸۰۸۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الْعَوَّامُ ، عَنْ إبْر[corrupt]اہِیمِ التَّیْمِیِّ ، قَالَ : قَالَ عَبْدُ اللہِ : إنَّ الشَّیْطَانَ یَأْتِی أَحَدَکُمْ وَہُوَ فِی صَلاَتِہِ فَیَنْقُرُ دُبُرَہُ لِیُرِیَہُ أَنَّہُ قَدْ أَحْدَثَ ، فَإِذَا فَعَلَ ذَلِکَ فَلاَ یَنْصَرِفَنَّ أَحَدُکُمْ حَتَّی یَسْمَعَ صَوْتًا ، أَوْ یَجِدَ رِیحًا۔","","Musannaf Ibn Abi Shaybah 8084","","","كتاب الجمعة"
"8085","(۸۰۸۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : سَأَلَہُ رَجُلٌ فَقَالَ لَہُ : إنَّ الشَّیْطَانَ یَأْتِینِی وَأَنَا فِی الصَّلاَۃ فَیُوَسْوِسُ إلیّ حَتَّی یَقُولَ : إنَّکَ قَدْ أَحْدَثْتَ ، فَقَالَ : لاَ یَنْصَرِفْ حَتَّی یَجِدَ لَہَا رِیحًا ، أَوْ یَسْمَعَ لَہَا طَنِینًا۔","Sahih","Musannaf Ibn Abi Shaybah 8085","","","كتاب الجمعة"
"8086","(۸۰۸۶) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، أَنَّہُ سَمِعَہُ یَقُولُ : إنَّ الشَّیْطَانَ یَجْرِی مِنَ الإِنْسَان مَجْرَی الدَّمِ ، ثُمَّ یَنبِضُ عِنْدَ عِجَانِہِ فَیُخْرِجُہُ ، فَلاَ یَخْرُجُ أَحَدُکُمْ حَتَّی یَسْمَعَ حِسًّا ، أَوْ یَجِدَ رِیحًا۔","","Musannaf Ibn Abi Shaybah 8086","","","كتاب الجمعة"
"8087","(۸۰۸۷) حَدَّثَنَا عَبَّادٌ، عَنْ خَالِدٍ، عَنْ عِکْرِمَۃَ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: لاَ یَنْصَرِفُ حَتَّی یَسْمَعَ صَوْتًا، أَوْ یَجِدَ رِیحًا۔","Sahih","Musannaf Ibn Abi Shaybah 8087","","","كتاب الجمعة"
"8088","(۸۰۸۸) حَدَّثَنَا حَفْصٌ ، عَنْ دَاوُدَ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، قَالَ : إنَّ الشَّیْطَانَ لَیَأْتِی أَحَدَکُمْ فَیُدْخِلُ خَطْمہ فِی دُبُرِہِ فَیُحَرِّکُہُ وَیُحَرِّکُ إحْلِیلَہُ لِیَشِرَ ، فَلاَ یَنْصَرِفَنَّ حَتَّی یَسْمَعَ صَوْتًا ، أَوْ یَجِدَ رِیحًا۔","","Musannaf Ibn Abi Shaybah 8088","","","كتاب الجمعة"
"8089","(۸۰۸۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یَقُولُ : إنَّ الشَّیْطَانَ یَجْرِی فِی الإِحْلِیلِ فَیَنبِضُ عِنْدَ الدُّبُرِ فَیَرَی الرَّجُلُ أَنَّہُ قَدْ أَحْدَثَ ، فَلاَ یَنْصَرِفَنَّ أَحَدُکُمْ حَتَّی یَسْمَعَ صَوْتًا ، أَوْ یَجِدَ رِیحًا ، أَوْ یَرَی بَلَلاً۔","","Musannaf Ibn Abi Shaybah 8089","","","كتاب الجمعة"
"8090","(۸۰۹۰) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : لاَ یَنْصَرِفُ حَتَّی یَسْمَعَ صَوْتًا ، أَوْ یَجِدَ رِیحًا۔","","Musannaf Ibn Abi Shaybah 8090","","","كتاب الجمعة"
"8091","(۸۰۹۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، قَالَ : حَدَّثَنَا الْمِنْہَالُ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إنَّ الشَّیْطَانَ یَطِیفُ بِالْعَبْدِ لِیَقْطَعَ عَلَیْہِ صَلاَتَہُ فَإِذَا أَعْیَاہُ نَفَخَ فِی دُبُرِہِ فَلاَ یَنْصَرِفْ حَتَّی یَسْمَعَ صَوْتًا، أَوْ یَجِدَ رِیحًا ، وَیَأْتِیہِ فَیَعْصِرُ ذَکَرَہُ فَیُرِیہِ أَنَّہُ أُخْرِجَ مِنْہُ شَیْئٌ فَلاَ یَنْصَرِفْ حَتَّی یَسْتَیْقِنَ۔","Sahih","Musannaf Ibn Abi Shaybah 8091","","","كتاب الجمعة"
"8092","(۸۰۹۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ أَبُو ہُرَیْرَۃَ : إذَا شَکَّ أَحَدُکُمْ فِی الْبِلَّۃِ وَہُوَ فِی الصَّلاَۃ فَلْیَضَعْ یَدَیہ عَلَی الْحَصَی فَلْیَمْسَحْ إحْدَاہُمَا بِالأُخْرَی وَلْیَمْضِ فِی صَلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 8092","","","كتاب الجمعة"
"8093","(۸۰۹۳) حَدَّثَنَا مُعْتَمِرٌ ، أَنَّہُ سَمِعَ أَبَاہُ یُحَدِّثُ : أَنَّ زَیْدَ بْنَ ثَابِتٍ وَحُذَیْفَۃَ وَالْحَسَنَ الْبَصْرِیَّ وَعَطَائً لَمْ یَرَوْا بَأْسًا بِالْبِلَّۃِ یَجِدُہَا الرَّجُلُ وَہُوَ یُصَلِّی ، إِلاَّ أَنَّ عَطَائً قَالَ : إِلاَّ أَنْ تَقْطُرَ ، قَالَ : وَقَالَ سَعِیدُ بْنُ الْمُسَیَّبِ : وَإِنْ قَطَرَ عَلَی رِجْلِکَ فَلاَ یَرَاہا ، ولا عَلَیْہِ إعَادَۃً وَلاَ طُہُور۔","","Musannaf Ibn Abi Shaybah 8093","","","كتاب الجمعة"
"8094","(۸۰۹۴) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، قَالَ : حدَّثَنِی شَیْخٌ ، عَنِ الْحَسَنِ بْنِ عَلِیٍّ : أَنَّہُ سَأَلَ زَیْدَ بْنَ ثَابِتٍ عَنْ ذَلِکَ ، فَرَخَّصَ فِیہِ۔","Da'if","Musannaf Ibn Abi Shaybah 8094","","","كتاب الجمعة"
"8095","(۸۰۹۵) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ یُونُسَ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، قَالَ : سُئِلَ حُذَیْفَۃُ عَنِ الرَّجُلِ یَجِدُ الْبِلَّۃَ بَعْدَ الْوُضُوئِ ، فَقَالَ : مَا کُنْت أُبَالِی إذَا کَانَ ذَلِکَ بَعْدَ الْوُضُوئِ ذَاکَ کَانَ أَوْ ہَذَا ، وَأَوْمَأَ بِیَدِہِ إلَی فِیہِ۔","","Musannaf Ibn Abi Shaybah 8095","","","كتاب الجمعة"
"8096","(۸۰۹۶) حَدَّثَنَا أَبُو بَکْرٍ الْحَنَفِیُّ ، عَنِ الضَّحَّاکِ بْنِ عُثْمَانَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ وَعُرْوَۃَ بْنَ الزُّبَیْرِ وَسُلَیْمَانَ بْنَ یَسَارٍ وَأَبَا سَلَمَۃَ بْنَ عَبْدِ الرَّحْمَنِ ، عَنِ الرَّجُلِ یَخْرُجُ مِنْہُ الْمَذْیُ فَکُلُّہُمْ قَالَ: أُنْزِلُہُ بِمَنْزِلَۃِ الْقُرْحَۃِ، مَا عَلِمْتَ مِنْہُ فَاغْسِلْہُ وَمَا غَلَبَکَ مِنْہُ فَدَعْہُ۔","","Musannaf Ibn Abi Shaybah 8096","","","كتاب الجمعة"
"8097","(۸۰۹۷) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا دَعَتْکَ أُمُّکَ فِی الصَّلاَۃ فَأَجِبْہَا ، وَإِذَا دَعَاکَ أَبُوکَ فَلاَ تُجِبْہُ۔","","Musannaf Ibn Abi Shaybah 8097","","","كتاب الجمعة"
"8098","(۸۰۹۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ مَکْحُولٍ ، قَالَ : إذَا دَعَتْکَ وَالِدَتُکَ وَأَنْتَ فِی الصَّلاَۃ فَأَجِبْہَا ، وَإِذَا دَعَاکَ أَبُوکَ فَلاَ تُجِبْہُ حَتَّی تَفْرُغَ۔","","Musannaf Ibn Abi Shaybah 8098","","","كتاب الجمعة"
"8099","(۸۰۹۹) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الْعَوَّامِ ، قَالَ : سَأَلْتُ مُجَاہِدًا ، قَالَ : قُلْتُ لَہُ : تُقَامُ الصَّلاَۃ وَتَدْعُونِی وَالِدَتِی ؟ قَالَ: أَجِبْ وَالِدَتَکَ۔","","Musannaf Ibn Abi Shaybah 8099","","","كتاب الجمعة"
"8100","(۸۱۰۰) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ ہَمَّامِ بْنِ یَحْیَی ، قَالَ : حدَّثَنَا فَرْقَدٌ السَّبَخِیُّ ، عَنْ مُرَّۃَ الطَّیِّبِ ، عَنْ عُمَرَ ، أَنَّہُ کَرِہَ لِلرَّجُلِ أَنْ یُصَلِّیَ وَفِی رِجْلَیْہِ قَیْدٌ۔","Da'if","Musannaf Ibn Abi Shaybah 8100","","","كتاب الجمعة"
"8101","(۸۱۰۱) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدِ بْنِ أَبِی صَدَقَۃَ ، قَالَ : قُلْتُ لِاِبْنِ سِیرِینَ : إذَا عَطَسْت فِی الصَّلاَۃ مَا أَقُولُ ؟ قَالَ : قُلِ : الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ۔","","Musannaf Ibn Abi Shaybah 8101","","","كتاب الجمعة"
"8102","(۸۱۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ : فِی الرَّجُلِ یَعْطِسُ فِی الصَّلاَۃ قَالَ : یَحْمَدُ اللَّہَ۔","","Musannaf Ibn Abi Shaybah 8102","","","كتاب الجمعة"
"8103","(۸۱۰۳) حَدَّثَنَا وَکِیعٌ، عَنْ رَبِیعٍ، عَنِ الْحَسَنِ: فِی الرَّجُلِ یَعْطِسُ فِی الصَّلاَۃ؟ قَالَ: یَحْمَدُ اللَّہَ فِی الْمَکْتُوبَۃِ وَغَیْرِہَا۔","","Musannaf Ibn Abi Shaybah 8103","","","كتاب الجمعة"
"8104","(۸۱۰۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ حَجَّاجٍ الصَّوَّافِ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ ہِلاَلِ بْنِ أَبِی مَیْمُونَۃَ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، عَنْ مُعَاوِیَۃَ بْنِ الْحَکَمِ السُّلَمِیِّ ، قَالَ: بَیْنََا أَنَا أُصَلِّی مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذْ عَطَسَ رَجُلٌ مِنَ الْقَوْمِ ، فَقُلْتُ : یَرْحَمُک اللَّہُ ، فَرَمَی الْقَوْمُ بِأَبْصَارِہِمْ ، فَقُلْتُ : وَاثُکْلَ أُمَّاہُ مَا شَأْنُکُمْ تَنْظُرُونَ إلَیَّ ؟ قَالَ : فَجَعَلُوا یَضْرِبُونَ بِأَیْدِیہِمْ عَلَی أَفْخَاذِہِمْ ، فَلَمَّا رَأَیْتُہُمْ یُصْمِتُونَنِی سَکَتُّ ، فَلَمَّا صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِأَبِی ہُوَ وَأُمِّی مَا رَأَیْتُ مِثْلَہُ قَبْلَہُ وَلاَ بَعْدَہُ أَحْسَنَ تَعْلِیمًا مِنْہُ ، وَاللَّہِ مَا کَہَرَنِی ، وَلاَ شَتَمَنِی ، وَلاَ ضَرَبَنِی ، قَالَ : إنَّ ہَذِہِ الصَّلاَۃ لاَ یَصْلُحُ فِیہَا شَیْئٌ مِنْ کَلاَمِ النَّاسِ إنَّمَا ہِیَ التَّسْبِیحُ وَالتَّکْبِیرُ وَقِرَائَۃُ الْقُرْآنِ ، أَوْ کَمَا قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (مسلم ۳۸۱۔ ابوداؤد ۹۲۷)","Sahih","Musannaf Ibn Abi Shaybah 8104","","","كتاب الجمعة"
"8105","(۸۱۰۵) حَدَّثَنَا عَبْدَ[corrupt]ُ ، عَنْ سُفْیَانَ ، عَنْ غَالِبٍ أَبِی الْہُذَیْلِ ، قَالَ : سُئِلَ إبْرَاہِیمُ عَنْ رَجُلٍ عَطَسَ فِی الصَّلاَۃ ، فَقَالَ لَہُ آخَرُ وَہُوَ فِی الصَّلاَۃ : یَرْحَمُک اللَّہُ ، فَقَالَ إبْرَاہِیمُ : إنَّمَا قَالَ مَعْرُوفًا وَلَیْسَ عَلَیْہِ إعَادَۃٌ۔","","Musannaf Ibn Abi Shaybah 8105","","","كتاب الجمعة"
"8106","(۸۱۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ عَطَسَ وَہُوَ فِی الصَّلاَۃ فَشَمَّتَہُ رَجُلٌ ، فَقَالَ وَہُوَ فِی الصَّلاَۃ : یَرْحَمُک اللَّہُ ، وَقَالَ إبْرَاہِیمُ : یَسْتَأْنِفُ۔","","Musannaf Ibn Abi Shaybah 8106","","","كتاب الجمعة"
"8107","(۸۱۰۷) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جُبَیْرِ بْنِ شَیْبَۃَ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ عَنِ الرَّجُلِ یَتَیَمَّمُ ثُمَّ یَجِدُ الْمَائَ فِی وَقْتٍ ؟ قَالَ : یُعِیدُ۔","Sahih","Musannaf Ibn Abi Shaybah 8107","","","كتاب الجمعة"
"8108","(۸۱۰۸) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ الأَشْعَثِ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ ، قَالاَ : إذَا تَیَمَّمَ ، ثُمَّ وَجَدَ الْمَائَ فِی وَقْتِ الصَّلاَۃ ، أَعَادَ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8108","","","كتاب الجمعة"
"8109","(۸۱۰۹) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ؛ فِی الرَّجُلِ یَتَیَمَّمُ فَیُصَلِّی ، ثُمَّ یَجِدُ الْمَائَ فِی وَقْتٍ ، قَالَ : یُعِیدُ۔","","Musannaf Ibn Abi Shaybah 8109","","","كتاب الجمعة"
"8110","(۸۱۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ؛ فِی الرَّجُلِ یَتَیَمَّمُ ثُمَّ یَجِدُ الْمَائَ ، قَالَ : یُعِیدُ۔","","Musannaf Ibn Abi Shaybah 8110","","","كتاب الجمعة"
"8111","(۸۱۱۱) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : یُعِیدُ۔","","Musannaf Ibn Abi Shaybah 8111","","","كتاب الجمعة"
"8112","(۸۱۱۲) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنِ الْعَلاَئِ ، عَنْ عَطَائٍ قَالَ : یُعِیدُ۔","","Musannaf Ibn Abi Shaybah 8112","","","كتاب الجمعة"
"8113","(۸۱۱۳) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ عُثْمَانَ بن أبی عثمان ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : یُعِیدُ۔","","Musannaf Ibn Abi Shaybah 8113","","","كتاب الجمعة"
"8114","(۸۱۱۴) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا أَصَابَ الْمَائَ فِی وَقْتٍ أَعَادَ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8114","","","كتاب الجمعة"
"8115","(۸۱۱۵) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : یُعِیدُ الصَّلاۃَ۔","","Musannaf Ibn Abi Shaybah 8115","","","كتاب الجمعة"
"8116","(۸۱۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ لَیْثِ بْنِ سَعْدٍ ، عَنْ بَکْرِ بْنِ سَوَادَۃَ ، عَنْ عَطَائِ بْنِ یَسَارٍ : أَنَّ رَجُلَیْنِ أَصَابَتْہُمَا جَنَابَۃٌ فَتَیَمَّمَا فَصَلَّیَا ، ثُمَّ أَدْرَکَا الْمَائَ فِی وَقْتٍ فَأَعَادَ أَحَدُہُمَا وَلَمْ یُعِدِ الأَخَرُ فَذُکِرَ ذَلِکَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : أَمَّا الَّذِی أَعَادَ فَلَہُ أَجْرُہَا مَرَّتَیْنِ ، وَأَمَّا الأَخَرُ فَقَدْ أَجْزَأَتْ عَنْہُ صَلاَتُہُ۔ (ابوداؤد ۳۴۲۔ دارقطنی ۲)","","Musannaf Ibn Abi Shaybah 8116","","","كتاب الجمعة"
"8117","(۸۱۱۷) حَدَّثَنَا شَرِیکٌ ، عَنِ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : یَتَلَوَّمُ الْجُنُبُ مَا بَیْنَہُ وَبَیْنَ آخِرِ الْوَقْتِ ، فَإِنْ وَجَدَ الْمَائَ تَوَضَّأَ ، وَإِنْ لَمْ یَجِدِ الْمَائَ تَیَمَّمَ وَصَلَّی ، فَإِنْ وَجَدَ الْمَائَ بَعْدُ اغْتَسَلَ ، وَلَمْ یُعِدِ الصَّلاَۃ۔","Da'if","Musannaf Ibn Abi Shaybah 8117","","","كتاب الجمعة"
"8118","(۸۱۱۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جُبَیْرِ بْنِ شَیْبَۃَ ، عَنِ ابنِ سَلَمَۃَ ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : لاَ یُعِیدُ۔","","Musannaf Ibn Abi Shaybah 8118","","","كتاب الجمعة"
"8119","(۸۱۱۹) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : أَنَّہُ تَیَمَّمَ وَصَلَّی ، ثُمَّ دَخَلَ الْمَدِینَۃَ فِی وَقْتٍ فَلَمْ یُعِدْ۔","Da'if","Musannaf Ibn Abi Shaybah 8119","","","كتاب الجمعة"
"8120","(۸۱۲۰) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا تَیَمَّمَ الرَّجُلُ فَصَلَّی ، ثُمَّ أَتَی الْمَائَ وَہُوَ فِی وَقْتٍ بَعْدَ مَا یَفْرُغُ مِنْ صَلاَتِہِ فَقَدْ فَرَغَ مِنْ صَلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 8120","","","كتاب الجمعة"
"8121","(۸۱۲۱) حَدَّثَنَا أَبُو دَاوُدَ، عَنْ جَرِیرِ بْنِ حَازِمٍ، عَنْ قَیْسِ بْنِ سَعْدٍ، عَنْ مُجَاہِدٍ، قَالَ: لاَ یُعِیدُ، قَدْ مَضَتْ صَلاَتُہُ۔","","Musannaf Ibn Abi Shaybah 8121","","","كتاب الجمعة"
"8122","(۸۱۲۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ وَالشَّعْبِیِّ ، قَالاَ : إذَا صَلَّی لِغَیْرِ الْقِبْلَۃِ أَوْ تَیَمَّمَ ، أَوْ صَلَّی وَفِی ثَوْبِہِ دَمٌ أَوْ جَنَابَۃٌ ثُمَّ أَصَابَ الْمَائَ فِی وَقْتٍ أوْغَیْر وَقْتٍ ، فَلَیْسَ عَلَیْہِ إعَادَۃٌ۔","","Musannaf Ibn Abi Shaybah 8122","","","كتاب الجمعة"
"8123","(۸۱۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا وَجَدَ الْمَائَ اغْتَسَلَ ، فَإِنْ شَائَ أَعَادَ ، وَإِنْ شَائَ لَمْ یُعِدْ۔","","Musannaf Ibn Abi Shaybah 8123","","","كتاب الجمعة"
"8124","(۸۱۲۴) حَدَّثَنَا مُعْتَمِرٌ ، عَنِ الْحَکَمِ بْنِ أَبَانَ ، عَنْ عِکْرِمَۃَ ، قَالَ : کُنْتُ أَنَا فِی رُفْقَۃٍ ، وعِکْرِمَۃُ فی رُفْقَۃٍ ، فَلَمْ یَکُنْ مَعَ عِکْرِمَۃَ وَأَصْحَابِہِ مَائٌ فَتَیَمَّمُوا وَصَلَّوْا فَأَتَوْا عَلَی الْمَائِ ، فَقَالَ لَہُم عِکْرِمَۃُ : تَرَوْنَ الشَّمْسَ عَلَی رَأْسِ الْجَبَلِ ؟ فَقَالُوا : لاَ ، قَالَ : لَوْ رَأَیْتُمُوہَا لَمْ نُعِدْ إذًا کَفَانَا التَّیَمُّمُ ، فَقَالَ : فَانْطَلَقْتُ حَتَّی دَخَلْت الْجَنَد فَلَقِیتُ عَمْرَو بْنَ مُسْلِمٍ صَاحِبَ طَاوُوس ، فَحَدَّثْتُہُ بِمَا قَالَ عِکْرِمَۃُ ، فَانْطَلَقَ إلَی طَاوُوس فَذَکَرَ ذَلِکَ لَہُ ثُمَّ رَجَعَ إلَیَّ فَقَالَ : ذَکَرْتُ لِطَاوُوس مَا قَالَ عِکْرِمَۃُ فَقَالَ : صَدَقَ۔","","Musannaf Ibn Abi Shaybah 8124","","","كتاب الجمعة"
"8125","(۸۱۲۵) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ کَثِیرِ بْنِ نَبَاتَۃَ ، قَالَ : سَمِعْتُ ابْنَ سِیرِینَ یَقُولُ : خَرَجْتُ فِی سَفَرِ حَجٍّ أَوْ عُمْرَۃٍ ، فَلَمَّا کَانَ مِنْ آخِرِ اللَّیْلِ أَصَابَتْنِی جَنَابَۃٌ وَلَیْسَ مَعَنَا مَائٌ ، فَتَیَمَّمْت وَصَلَّیْت ، فَلَمَّا ارْتَفَعَ الضُّحَی قَالَ رَجُلٌ : یَا أَبَا بَکْرٍ أَعَدْتَ صَلاَتَکَ ؟ قَالَ : وَلَوْ لَمْ أَجِد الْمَائَ عِشْرِینَ سَنَۃً أَکُنْتُ أُعِیدُ صَلاَتِی۔","","Musannaf Ibn Abi Shaybah 8125","","","كتاب الجمعة"
"8126","(۸۱۲۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ شُعْبَۃَ ، عَنِ الْمُخَوَّلِ ، عَنْ أَبِی سَعْدٍ ، عَنْ أَبِی رَافِعٍ ، قَالَ : مَرَّ بِی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنَا سَاجِدٌ قَدْ عَقَصْتُ شَعْرِی فَحَلَّہُ ، أَوَ قَالَ : فَنَہَانِی عَنْہُ۔ (ابوداؤد ۶۴۶۔ عبدالرزاق ۲۹۹۰)","","Musannaf Ibn Abi Shaybah 8126","","","كتاب الجمعة"
"8127","(۸۱۲۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ مُجَاہِدٍ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ وَحُذَیْفَۃَ ؛ فِی الرَّجُلِ یُصَلِّی وَہُوَ عَاقِصٌ شَعْرَہُ ، فَذَکَرَا حَدِیثًا غَیْرَ أَنَّ مَعَنَاہُ أَنَّہُمَا کَرِہَاہُ۔","","Musannaf Ibn Abi Shaybah 8127","","","كتاب الجمعة"
"8128","(۸۱۲۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زُہَیْرِ بْنِ مُحَمَّدٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن أَبَانَ بْنِ عُثْمَانَ ، قَالَ : رَأَی عُثْمَانُ رَجُلاً یُصَلِّی وَقَدْ عَقَدَ شَعْرَہُ ، فَقَالَ : یَا ابْنَ أَخِی مَثَلُ الَّذِی یُصَلِّی وَقَدْ عَقَصَ شَعْرَہُ مَثَلُ الَّذِی یُصَلِّی وَہُوَ مَکْتُوفٌ۔","Sahih","Musannaf Ibn Abi Shaybah 8128","","","كتاب الجمعة"
"8129","(۸۱۲۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ شَرِیکٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : کَانَ ابْنُ عَبَّاسٍ إذَا صَلَّی وَقَعَ شَعْرُہُ الأَرْضَ۔","","Musannaf Ibn Abi Shaybah 8129","","","كتاب الجمعة"
"8130","(۸۱۳۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ زَیْدِ بْنِ وَہْبٍ ، عَنْ عَبْدِ اللہِ : أَنَّہُ دَخَلَ الْمَسْجِدَ فَإِذَا فِیہِ رَجُلٌ یُصَلِّی عَاقِصًا شَعْرَہُ ، فَلَمَّا انْصَرَفَ قَالَ عَبْدُ اللہِ : إذَا صَلَّیْت فَلاَ تَعْقِصْ شَعْرَکَ ، فَإِنَّ شَعْرَکَ یَسْجُدُ مَعَکَ وَلَکَ بِکُلِّ شَعَرَۃٍ أَجْرٌ ، فَقَالَ الرَّجُلُ : إنِّی أَخَافُ أَنْ یَتْرَبَ ، فَقَالَ : تَتْرِیبُہُ خَیْرٌ لَک۔","Sahih","Musannaf Ibn Abi Shaybah 8130","","","كتاب الجمعة"
"8131","(۸۱۳۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی فَرْوَۃَ ، قَالَ : کَانَ عَبْدُ الرَّحْمَنِ بْنُ أَبِی لَیْلَی یَضفِرُ شَعْرَہُ فَإِذَا صَلَّی نَشَرَہُ۔","","Musannaf Ibn Abi Shaybah 8131","","","كتاب الجمعة"
"8132","(۸۱۳۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَانَ یَکْرَہُ عَقْدَ الرَّجُلِ شَعْرَہُ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8132","","","كتاب الجمعة"
"8133","(۸۱۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : لاَ یُصَلِّی الرَّجُلُ وَہُوَ عَاقِصٌ شَعْرَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 8133","","","كتاب الجمعة"
"8134","(۸۱۳۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُ قَالَ : أُمِرْتُ أَنْ أَسْجُدَ عَلَی سَبْعَۃِ أَعْظُمٍ ، وَلاَ أَکُفَّ شَعْرًا ، وَلاَ ثَوْبًا۔","Da'if","Musannaf Ibn Abi Shaybah 8134","","","كتاب الجمعة"
"8135","(۸۱۳۵) حَدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرٍو ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أُمِرَ نَبِیُّکُمْ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُسْجَدَ عَلَی سَبْعَۃٍ وَأُمِرَ أَنْ لاَ یَکُفَّ شَعْرًا وَلاَ ثَوْبًا۔ (بخاری ۸۱۵۔ ابوداؤد ۸۸۶)","Sahih","Musannaf Ibn Abi Shaybah 8135","","","كتاب الجمعة"
"8136","(۸۱۳۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : کُنَّا لاَ نَتَوَضَّأُ مِنْ مَوْطَِأ ، وَلاَ نَکُفُّ شَعْرًا وَلاَ ثَوْبًا فِی الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 8136","","","كتاب الجمعة"
"8137","(۸۱۳۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی حَیَّانَ التَّیْمِیِّ ، عَنْ مُجَمِّعٍ ، قَالَ : کَانَ الْحَسَنُ بْنُ یَزِیدَ یبصرُ السُّیُوفَ فَکَانَ إِذَا أُتِیَ بِالسَّیْفِ لِیَنْظُرَ إلَیْہِ وَہُوَ فی الْمَسْجِدِ خَرَجَ بِہِ فَنَظَرَ إلَیْہِ۔","","Musannaf Ibn Abi Shaybah 8137","","","كتاب الجمعة"
"8138","(۸۱۳۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُعاذ ، عَنْ أَسْلَمَ الْمِنْقَرِیِّ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی الْخُزَاعِیِّ ، قَالَ : لاَ یُسَلُّ السَّیْفُ فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 8138","","","كتاب الجمعة"
"8139","(۸۱۳۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : نَہَی أَو نُہِیَ عَنْ سَلِّ السَّیْفِ فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 8139","","","كتاب الجمعة"
"8140","(۸۱۴۰) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، سَمِعَ جَابِرًا یَقُولُ : مَرَّ رَجُلٌ فِی الْمَسْجِدِ بِسِہَامٍ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَمْسِکْ بِنِصَالِہَا۔ (بخاری ۷۰۷۴۔ مسلم ۱۲۱)","Sahih","Musannaf Ibn Abi Shaybah 8140","","","كتاب الجمعة"
"8141","(۸۱۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ بُرَیدِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِی مُوسَی ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا مَرَّ أَحَدُکُمْ بِالنَّبْلِ فِی الْمَسْجِدِ فَلْیُمْسِکْ عَلَی نُصُولِہَا۔ (بخاری ۴۵۲۔ ابوداؤد ۲۵۸۰)","Sahih","Musannaf Ibn Abi Shaybah 8141","","","كتاب الجمعة"
"8142","(۸۱۴۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا مَرَرْت بِنَبْلٍ فَامْسِکْ بِنِصَالِہَا۔","","Musannaf Ibn Abi Shaybah 8142","","","كتاب الجمعة"
"8143","(۸۱۴۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ سُلَیْمَانَ بْنِ سُحَیْمٍ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ اللہِ بْنِ مَعْبَدٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ، قَالَ : کَشَفَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ السِّتَارَۃَ وَالنَّاسُ صُفُوفٌ خَلْفَ أَبِی بَکْرٍ ، وَقَالَ : یَا أَیُّہَا النَّاسُ، إِنَّہُ لَمْ یَبْقَ مِنْ مُبَشِّرَاتِ النُّبُوَّۃِ إِلاَّ الرُّؤْیَا الصَّالِحَۃُ یَرَاہَا الْمُسْلِمُ أَوْ تُرَی لَہُ أَلاَ وَإِنِّی نُہِیتُ أَنْ أَقْرَأَ الْقُرْآنَ رَاکِعًا ، أَوْ سَاجِدًا۔","Sahih","Musannaf Ibn Abi Shaybah 8143","","","كتاب الجمعة"
"8144","(۸۱۴۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، قَالَ : حَدَّثَنِی إبْرَاہِیمُ بْنُ عَبْدِ اللہِ بْنِ حُنَیْنٍ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ عَلِیًّا بِرَحْبَۃِ الْکُوفَۃِ یَقُولُ : نَہَانِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ قِرَائَۃِ الْقُرْآنِ وَأَنَا رَاکِعٌ۔ (مسلم ۲۱۳۔ احمد ۱/۸۱)","Hasan","Musannaf Ibn Abi Shaybah 8144","","","كتاب الجمعة"
"8145","(۸۱۴۵) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : لاَ تَقْرَأُ الْقُرْآنَ وَأَنْتَ رَاکِعٌ ، وَلاَ سَاجِدٌ۔","Da'if","Musannaf Ibn Abi Shaybah 8145","","","كتاب الجمعة"
"8146","(۸۱۴۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، وَعُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی زِیَادٍ ، قَالَ : قرَأْتُُ السَّجْدَۃَ وَأَنَا سَاجِدٌ فَسَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ فَقَالَ : یُجْزِئُکََ وَلِمَ تَقْرَأْ وَأَنْتَ سَاجِدٌ۔","","Musannaf Ibn Abi Shaybah 8146","","","كتاب الجمعة"
"8147","(۸۱۴۷) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ قِرَائَۃَ فِی الرُّکُوعِ وَلاَ فِی السُّجُودِ ، إنَّمَا جُعِلاَ لِذِکْرِ اللہِ تَعَالَی۔","","Musannaf Ibn Abi Shaybah 8147","","","كتاب الجمعة"
"8148","(۸۱۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ عَلِیِّ بْنِ مُدْرِکٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الرَّبِیعِ بْنِ خُثَیْمٍ ، قَالَ : أَیَعْجِزُ أَحَدُکُمْ أَنْ یَقْرَأَ ثُلُثَ الْقُرْآنِ وَہُوَ رَاکِعٌ ، أَوْ سَاجِدٌ للہ الوَاحِدِ الصَّمَدِ۔","","Musannaf Ibn Abi Shaybah 8148","","","كتاب الجمعة"
"8149","(۸۱۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبَانَ بْنِ صَمْعَۃَ ، عَنْ شَیْخٍ کَانَ مَعَ ابْنِ الزُّبَیْرِ فَقَرَأَ الْبَقَرَۃَ وَہُوَ رَاکِعٌ ، ثُمَّ رَفَعَ رَأْسَہُ فَقَرَأَ آلَ عِمْرَانَ ، ثُمَّ سَجَدَ فَقَرَأَ النِّسَائَ ، ثُمَّ رَفَعَ رَأْسَہُ فَقَرَأَ الْمَائِدَۃَ۔","","Musannaf Ibn Abi Shaybah 8149","","","كتاب الجمعة"
"8150","(۸۱۵۰) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ، عَنْ عَبْدِالْمَلِکِ، عَنْ عَطَائٍ، قَالَ: کَانَ عُبَیْدُ بْنُ عُمَیْرٍ یَقْرَأُ فِی الرُّکُوعِ وَالسُّجُودِ۔","","Musannaf Ibn Abi Shaybah 8150","","","كتاب الجمعة"
"8151","(۸۱۵۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا إذَا عَجَّلَ الرَّجُلُ فَرَکَعَ وَبَقِیَ عَلَیْہِ مِنَ السُّورَۃِ آیَۃٌ أَوْ آیَتَانِ أَنْ یَقْرَأَہُمَا وَہُوَ رَاکِعٌ۔","","Musannaf Ibn Abi Shaybah 8151","","","كتاب الجمعة"
"8152","(۸۱۵۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَبِی حَیَّانَ ، عَنْ أَبِیہِ ، قَالَ : مَا سَمِعْتُ الرَّبِیعَ بْنَ خُثَیْمٍ یَذْکُرُ شَیْئًا مِنْ أَمْرِ الدُّنْیَا إِلاَّ أَنِّی سَمِعْتُہُ مَرَّۃً یَقُولُ : کَمْ للتَّیمْ مَسْجِدًا۔","","Musannaf Ibn Abi Shaybah 8152","","","كتاب الجمعة"
"8153","(۸۱۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، قَالَ : سَمِعْتُ زِرًّا وأَبَا وَائِلٍ یَقُولاَنِ : مَسْجِدُ بَنِی فُلاَنٍ۔","","Musannaf Ibn Abi Shaybah 8153","","","كتاب الجمعة"
"8154","(۸۱۵۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَانَ یَکْرَہُ أَنْ یَقُولَ : مَسْجِدُ بَنِی فُلاَنٍ ، وَلاَ یَرَی بَأْسًا أَنْ یَقُولَ : مُصَلَّی بَنِی فُلاَنٍ۔","","Musannaf Ibn Abi Shaybah 8154","","","كتاب الجمعة"
"8155","(۸۱۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ مُحَارِبٍ ، عَنْ جَابِرٍ ، أَنَّہُ قَالَ : فَانْأ مَسْجِدَ مُعَاذٍ۔","","Musannaf Ibn Abi Shaybah 8155","","","كتاب الجمعة"
"8156","(۸۱۵۶) حَدَّثَنَا جَرِیرٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ عَطَائٍ ، عَنِ ابن عَبَّاسٍ ، قَالَ : تؤَخِّرُ الْمُسْتَحَاضَۃُ الظُّہْرَ وَتُعَجِّلُ الْعَصْرَ ، وَتَقْرِنُ بَیْنَہُمَا ، وَتَغْتَسِلُ مَرَّۃً وَاحِدَۃً ، وَتُؤَخِّرُ الْمَغْرِبَ ، وَتُعَجِّلُ الْعِشَائَ ، وَتَغْتَسِلُ مَرَّۃً وَاحِدَۃً ، وَتَغْتَسِلُ لِلْفَجْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 8156","","","كتاب الجمعة"
"8157","(۸۱۵۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ الأَجْلَحِ ، عَنْ عِکْرِمَۃَ : فِی الْمُسْتَحَاضَۃِ ، قَالَ : تَجْمَعُ بَیْنَ الصَّلاَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 8157","","","كتاب الجمعة"
"8158","(۸۱۵۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَنْظَلَۃَ ، عَنِ الْقَاسِمِ قَالَ : إِنْ شَائَتْ فَلْتَجْمَعْ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 8158","","","كتاب الجمعة"
"8159","(۸۱۵۹) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، سَمِعَ أَبَا سَلَمَۃَ بْنَ عَبْدِ الرَّحْمَنِ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَغْلِبَنَّکُمُ الأَعْرَابُ عَلَی اسْمِ صَلاَتِکُمْ فَإِنَّمَا ہِیَ الْعِشَائُ وَإِنَّمَا تَدْعُونَہَا الْعَتَمَۃُ لإعْتَامِ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 8159","","","كتاب الجمعة"
"8160","(۸۱۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی لَبِیدٍ ، عَنْ أَبِی سَلَمَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَغْلِبَنَّکُمُ الأَعْرَابُ عَلَی اسْمِ صَلاَتِکُمُ الْعِشَائِ ، فَإِنَّمَا ہِیَ فِی کِتَابِ اللہِ الْعِشَائُ ، وَإِنَّمَا یُعْتَمُ بِحِلاَبِ الإِبِلِ۔ (مسلم ۲۲۹۔ احمد ۲/۱۰)","Sahih","Musannaf Ibn Abi Shaybah 8160","","","كتاب الجمعة"
"8161","(۸۱۶۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی رَوَّادٍ ، عَنْ رَجُلٍ لَمْ یُسَمِّہِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَغْلِبَنَّکُمُ الأَعْرَابُ عَلَی اسْمِ صَلاَتِکُمُ الْعِشَائِ ، فَإِنَّمَا ہِیَ فِی کِتَابِ اللہِ الْعِشَائُ ، وَإِنَّمَا یُعْتَمُ بِحِلاَبِ الإِبِلِ۔ (ابویعلی ۸۶۵۔ بیہقی ۳۷۲)","Da'if","Musannaf Ibn Abi Shaybah 8161","","","كتاب الجمعة"
"8162","(۸۱۶۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ أَبِی رَوَّادٍ ، عَنْ نَافِعٍ قَالَ : کَانَ ابْنُ عُمَرَ إذَا سَمِعَہُمْ یَقُولُونَ الْعَتَمَۃُ غَضِبَ غَضَبًا شَدِیدًا ، أَوْ نَہَی نَہْیًا شَدِیدًا۔","Hasan","Musannaf Ibn Abi Shaybah 8162","","","كتاب الجمعة"
"8163","(۸۱۶۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ طَہْمَانَ أَبُو الْمُعْتَمِرِ ، عَنِ ابْنِ سِیرِینَ : أَنَّہُ کَرِہَ أَنْ یَقُولَ الْعَتَمَۃُ۔","","Musannaf Ibn Abi Shaybah 8163","","","كتاب الجمعة"
"8164","(۸۱۶۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ أَبِی فَزَارَۃَ الْعَبْسِیِّ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، قَالَ : قُلْتُ لِعَبْدِ اللہِ بْنِ عُمَرَ : مَنْ أَوَّلُ مَنْ سَمَّاہَا الْعَتَمَۃَ ؟ قَالَ : الشَّیْطَانُ۔","Hasan","Musannaf Ibn Abi Shaybah 8164","","","كتاب الجمعة"
"8165","(۸۱۶۵) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی فَزَارَۃَ ، عَنْ مَیْمُونٍ ، عَنِ ابْنِ عُمَرَ بِنَحْوِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 8165","","","كتاب الجمعة"
"8166","(۸۱۶۶) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنِ مُحَمدِ بْنِ عَبْدِ اللہِ بْنِ أَبِی سَارَۃَ ، قَالَ : سَمِعْتُ سَالِمًا وَہُوَ یَقُولُ : لاَ تَقُلِ الْعَتَمَۃَ إنَّمَا ہِیَ الْعِشَائُ الأَخِرَۃُ مَرَّتَیْنِ۔","","Musannaf Ibn Abi Shaybah 8166","","","كتاب الجمعة"
"8167","(۸۱۶۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا حَرِیزُ بْنُ عُثْمَانَ ، عَنْ رَاشِدِ بْنِ سَعْدٍ ، عَنْ عاصِمِ بْنِ حُمَیْدٍ السَّکُونِیِّ وَکَانَ مِنْ أَصْحَابِ مُعَاذٍ ، عَنْ مُعَاذِ بْنِ جَبَلٍ ، قَالَ : بَقَیْنَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی صَلاَۃِ الْعِشَائِ فَخَرَجَ عَلَیْنَا فَقَالَ : أَعْتِمُوا بِہَذِہِ الصَّلاَۃ ، فَقَدْ فُضِّلْتُمْ بِہَا عَلَی سَائِرِ الأُمَمِ ، وَلَمْ تُصَلِّہَا أُمَّۃٌ قَبْلَکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 8167","","","كتاب الجمعة"
"8168","(۸۱۶۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لأَبِی بَکْرٍ : مَتَی تُوتِرُ ؟ قَالَ مِنْ أَوَّلِ اللَّیْلِ بَعْدَ الْعَتَمَۃِ قَبْلَ أَنْ أَنَامَ۔","Da'if","Musannaf Ibn Abi Shaybah 8168","","","كتاب الجمعة"
"8169","(۸۱۶۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا کَانَ سَفَرُکَ یَوْمًا إلَی الْعَتَمَۃِ فَلاَ تَقْصُرِ الصَّلاَۃ ، فَإِنْ جَاوَزْت ذَلِکَ فَقَصِّر۔","Sahih","Musannaf Ibn Abi Shaybah 8169","","","كتاب الجمعة"
"8170","(۸۱۷۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ فِی قَوْلِہِ : {وَلاَ تَجْہَرْ بِصَلاَتِکَ وَلاَ تُخَافِتْ بِہَا} قَالَتْ : فِی الدُّعَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 8170","","","كتاب الجمعة"
"8171","(۸۱۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عُبَیْدِ الْمُکْتِبِ ، عَنْ إبْرَاہِیمَ ۔ وَعَنْ سُفْیَانَ ، عَنْ سِمَاکِ بْنِ عُبَیْدٍ ، عَنْ عَطَائٍ ، قَالاَ : الدُّعَائُ۔","","Musannaf Ibn Abi Shaybah 8171","","","كتاب الجمعة"
"8172","(۸۱۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : قِرَائَۃُ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 8172","","","كتاب الجمعة"
"8173","(۸۱۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إبْرَاہِیمَ الْہَجَرِیِّ ، عَنِ أَبِی عِیَاضٍ قَالَ : الدُّعَائُ۔","","Musannaf Ibn Abi Shaybah 8173","","","كتاب الجمعة"
"8174","(۸۱۷۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا قَرَأَ یَرْفَعُ صَوْتَہُ یُعْجِبُ ذَلِکَ الْمُسْلِمِینَ وَیَسُوئُ الْکُفَّارَ ، قَالَ فَنَزَلَتْ : {وَلاَ تَجْہَرْ بِصَلاَتِکَ وَلاَ تُخَافِتْ بِہَا}۔ (بخاری ۴۷۲۲۔ ترمذی ۳۱۴۶)","","Musannaf Ibn Abi Shaybah 8174","","","كتاب الجمعة"
"8175","(۸۱۷۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنِ الأَسْوَدِ بْنِ ہِلاَلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : لَمْ یُخَافِتْ مَنْ أَسْمَعَ أُذُنَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 8175","","","كتاب الجمعة"
"8176","(۸۱۷۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : سَأَلْتُ عَبِیْدَۃَ عَنِ الْقِرَائَۃِ ؟ فَقَالَ : أَسْم[corrupt]عْ نَفْسَک۔","","Musannaf Ibn Abi Shaybah 8176","","","كتاب الجمعة"
"8177","(۸۱۷۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَاصِمٍ ، عَنِ الْحَسَنِ ، أَنَّہُ قَالَ فِی قِرَائَۃِ النَّہَارِ : أَسْمِعْ نَفْسَک۔","","Musannaf Ibn Abi Shaybah 8177","","","كتاب الجمعة"
"8178","(۸۱۷۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ الْہَجَرِیِّ ، عَنْ أَبِی عِیَاضٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا صَلَّی عِنْدَ الْبَیْتِ جَہَرَ بِقِرَائَتِہِ ، فَکَانَ الْمُشْرِکُونَ یُؤْذُونَہُ فَنَزَلَتْ : (وَلاَ تَجْہَرْ بِصَلاَتِکَ وَلاَ تُخَافِتْ بِہَا) الآیَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 8178","","","كتاب الجمعة"
"8179","(۸۱۷۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ قَوْلُہُ : (وَلاَ تَجْہَرْ بِصَلاَتِکَ وَلاَ تُخَافِتْ بِہَا) قَالَ : الدُّعَائُ۔","Da'if","Musannaf Ibn Abi Shaybah 8179","","","كتاب الجمعة"
"8180","(۸۱۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ ، قَالَ : الدُّعَاء ۔","","Musannaf Ibn Abi Shaybah 8180","","","كتاب الجمعة"
"8181","(۸۱۸۱) حَدَّثَنَا مُعَاذُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَیَّاشٍ الْعَامِرِیِّ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، قَالَ : کَانَ أَعْرَابٌ لِبَنِی تَمِیمٍ إذَا سَلَّمَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالُوا : اللَّہُمَّ ارْزُقْنَا مَالاً وَوَلَدًا ، فَنَزَلَتْ (وَلاَ تَجْہَرْ بِصَلاَتِک)۔","","Musannaf Ibn Abi Shaybah 8181","","","كتاب الجمعة"
"8182","(۸۱۸۲) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ سُفْیَانَ ، عَنْ عَیَّاشٍ الْعَامِرِیِّ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ بِنَحْوِہِ۔","","Musannaf Ibn Abi Shaybah 8182","","","كتاب الجمعة"
"8183","(۸۱۸۳) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنِ ابْنِ سِیرِینَ : {وَلاَ تَجْہَرْ بِصَلاَتِکَ وَلاَ تُخَافِتْ بِہَا} قَالَ : تُحْسِنُ عَلاَنِیَۃً وَتَجَوَّزُ سِرًّا {وَابْتَغِ بَیْنَ ذَلِکَ سَبِیلاً} قَالَ : تُجْعَلُہا سَوَائً فِی السِّرِّ وَالْعَلاَنِیَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 8183","","","كتاب الجمعة"
"8184","(۸۱۸۴) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، قَالَ : حدَّثَنَا أَبُو سَعِیدٍ ، قَالَ : حَدَّثَنَا سَالِمٌ ، عَنْ سَعِیدٍ : {وَلاَ تَجْہَرْ بِصَلاَتِکَ وَلاَ تُخَافِتْ بِہَا} ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَرْفَعُ صَوْتَہُ بِبِسْمِ اللہِ الرَّحْمَن الرَّحِیمِ وَکَانَ مُسَیْلِمَۃُ قَدْ تَسَمَّی الرَّحْمَان ، فَکَانَ الْمُشْرِکُونَ إذَا سَمِعُوا ذَلِکَ مِنَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالُوا : قَدْ ذَکَرَ مُسَیْلِمَۃَ إلَہَ الْیَمَامَۃِ ، ثُمَّ عَارَضُوہُ بِالْمُکَائِ وَالتَّصْدِیَۃِ وَالصَّفِیرِ فَأَنْزَلَ اللَّہُ تَعَالَی : {وَلاَ تَجْہَرْ بِصَلاَتِکَ وَلاَ تُخَافِتْ بِہَا}۔ (طبری ۱۸۲)","","Musannaf Ibn Abi Shaybah 8184","","","كتاب الجمعة"
"8185","(۸۱۸۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ : أَنَّ أَبَاہُ کَانَ یَدْعُو لِلزُّبَیْرِ فِی صَلاَتِہِ وَیُسَمِّیہِ۔","","Musannaf Ibn Abi Shaybah 8185","","","كتاب الجمعة"
"8186","(۸۱۸۶) حَدَّثَنَا وَکِیعٌ، عَنْ شُعْبَۃَ، عَنْ أَبِی إیَاسٍ، قَالَ: قَالَ أَبُوالدَّرْدَائِ: إنِّی لأَدْعُو لِسَبْعِینَ مِنْ إخْوَانِی وَأَنَا سَاجِدٌ۔","","Musannaf Ibn Abi Shaybah 8186","","","كتاب الجمعة"
"8187","(۸۱۸۷) حَدَّثَنَا وَکِیعٌ، عَنْ حَسَنِ بْنِ صَالِحٍ، عَنْ مُجَالِدٍ، عَنِ الشَّعْبِیِّ: أَنَّ عَلِیًّا کَانَ یُسَمِّی الرِّجَالَ بَعْدَ الصَّلاَۃ۔","Da'if","Musannaf Ibn Abi Shaybah 8187","","","كتاب الجمعة"
"8188","(۸۱۸۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الْفَضْلُ بْنُ عَطِیَّۃَ قَالَ : أَخْبَرَنِی مَنْ رَأَی عُرْوَۃَ بْنَ الزُّبَیْرِ وَہُوَ یُصَلِّی وَہُوَ یَقُولُ : اللَّہُمَّ اغْفِرْ لِلزُّبَیْرِ اللَّہُمَّ اغْفِرْ لأَسْمَائَ بِنْت أَبِی بَکْرٍ۔","","Musannaf Ibn Abi Shaybah 8188","","","كتاب الجمعة"
"8189","(۸۱۸۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ۔ وَعَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، أَنَّہُمَا قَالاَ : اُدْعُ فِی صَلاَتِکَ بِمَا بَدَا لَک۔","","Musannaf Ibn Abi Shaybah 8189","","","كتاب الجمعة"
"8190","(۸۱۹۰) حَدَّثَنَا مُعَاذٌ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : نُبِّئْت أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ أَنْ لاَ یُسَمّی أَحَدٌ فِی الدُّعَائِ۔","","Musannaf Ibn Abi Shaybah 8190","","","كتاب الجمعة"
"8191","(۸۱۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنِ الْفُرَافِصَۃِ ، قَالَ : سَمِعْتُ ابْنَ الزُّبَیْرِ یَقُولُ وَہُوَ سَاجِدٌ : اللَّہُمَّ اغْفِرْ لِلزُّبَیْرِ اللَّہُمَّ اغْفِرْ لأَسْمَائَ بِنْتِ أَبِی بَکْرٍ الصِّدِّیق۔","","Musannaf Ibn Abi Shaybah 8191","","","كتاب الجمعة"
"8192","(۸۱۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنِ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یَقُولَ فِی الصَّلاَۃ : اللَّہُمَّ ارْزُقْنِی غُلاَمًا ، وَلاَ یُسَمِّی۔","","Musannaf Ibn Abi Shaybah 8192","","","كتاب الجمعة"
"8193","(۸۱۹۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ بُرْقَانَ ، عَنْ حَبِیبِ بْنِ أَبِی مَرْزُوقٍ ، قَالَ : قَالَ عُثْمَانَ : لاَ یَقْطَعُ الصَّلاَۃ شَیْئٌ إِلاَّ الْکَلاَمُ وَالْحَدَثُ۔","","Musannaf Ibn Abi Shaybah 8193","","","كتاب الجمعة"
"8194","(۸۱۹۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنِ الرَّجُلِ یَتَکَلَّمُ فِی الصَّلاَۃ فَقَالاَ : إذَا تَکَلَّمَ وَقَدْ فَرَغَ مِنْ صَلاَتِہِ فَزَادَ فَقَدْ مَضَتْ ، وَعَلَیْہِ سَجْدَتَا السَّہْوِ ، وَإِنْ تَکَلَّمَ وَلَمْ یُتِمَّ صَلاَتَہُ فَإِنَّہُ یُعِیدُ۔","","Musannaf Ibn Abi Shaybah 8194","","","كتاب الجمعة"
"8195","(۸۱۹۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : یَسْتَأْنِفُ۔","","Musannaf Ibn Abi Shaybah 8195","","","كتاب الجمعة"
"8196","(۸۱۹۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا تَکَلَّمَ فِی الصَّلاَۃ أَعَادَ الصَّلاَۃ ، وَلَمْ یُعِدِ الْوُضُوئَ۔","","Musannaf Ibn Abi Shaybah 8196","","","كتاب الجمعة"
"8197","(۸۱۹۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی ہَارُونَ ، عَنْ أَبِی سَعِیدٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا سَافَرَ فَرْسَخًا قَصَرَ الصَّلاَۃ۔ (عبد بن حمید ۹۴۷)","Da'if","Musannaf Ibn Abi Shaybah 8197","","","كتاب الجمعة"
"8198","(۸۱۹۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا جُوَیْبِرٌ ، عَنِ الضَّحَّاکِ ، عَنِ النَّزَّال : أَنَّ عَلِیًّا خَرَجَ إلَی النُّخِیلَۃ فَصَلَّی بِہَا الظُّہْرَ وَالْعَصْرَ رَکْعَتَیْنِ ، ثُمَّ رَجَعَ مِنْ یَوْمِہِ فَقَالَ : أَرَدْتُ أَنْ أُعَلِّمَکُمْ سُنَّۃَ نَبِیِّکُمْ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 8198","","","كتاب الجمعة"
"8199","(۸۱۹۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، سَمِعَ أَنَسًا یَقُولُ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْمَدِینَۃِ الظُّہْرَ أَرْبَعًا وَبِذِی الْحُلَیْفَۃِ رَکْعَتَیْنِ ، یَعْنِی الْعَصْرَ۔","Sahih","Musannaf Ibn Abi Shaybah 8199","","","كتاب الجمعة"
"8200","(۸۲۰۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ محمد بْنِ الْمُنْکَدِرِ وَإِبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، سَمِعَا أَنَسًا یَقُولُ : صَلَّیْتُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الظُّہْرَ بِالْمَدِینَۃِ أَرْبَعًا وَبِذِی الْحُلَیْفَۃِ الْعَصْرَ رَکْعَتَیْنِ۔ (ترمذی ۵۴۶۔ ابوداؤد ۱۱۹۵)","Sahih","Musannaf Ibn Abi Shaybah 8200","","","كتاب الجمعة"
"8201","(۸۲۰۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، عَنْ عَامِرٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا خَرَجَ مُسَافِرًا قَصَرَ الصَّلاَۃ مِنْ ذِی الْحُلَیْفَۃِ۔","","Musannaf Ibn Abi Shaybah 8201","","","كتاب الجمعة"
"8202","(۸۲۰۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَ[corrupt]َّامِ ، عَنْ عُمَرَ بْنِ عَامِرٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ : أَنَّ حُذَیْفَۃَ کَانَ یُصَلِّی رَکْعَتَیْنِ فِیمَا بَیْنَ الْکُوفَۃِ وَالْمَدَائِنِ۔","","Musannaf Ibn Abi Shaybah 8202","","","كتاب الجمعة"
"8203","(۸۲۰۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : تُقْصَرُ الصَّلاَۃ فِی مَسِیرَۃِ یَوْمٍ وَلَیْلَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 8203","","","كتاب الجمعة"
"8204","(۸۲۰۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ مُحَمَّدِ بْنِ زَیْدِ بْنِ خُلَیْدَۃَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : تُقْصَرُ الصَّلاَۃ فِی مَسِیرَۃِ ثَلاَثَۃِ أَمْیَالٍ۔","Hasan","Musannaf Ibn Abi Shaybah 8204","","","كتاب الجمعة"
"8205","(۸۲۰۵) حَدَّثَنَا حَفْصٌ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ ،: أَنَّ مَسْرُوقًا کَانَ یَقْصُرُ الصَّلاَۃ إلَی وَاسِطٍ۔","","Musannaf Ibn Abi Shaybah 8205","","","كتاب الجمعة"
"8206","(۸۲۰۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : خَرَجْت مَعَ مَسْرُوقٍ إلَی السِّلْسِلَۃِ فَقَصَرَ الصَّلاَۃ وَأَقَامَ بِہَا سَنَتَیْنِ یَقْصُرُ الصَّلاَۃ وَقَصَرَ حِینَ رَجَعَ حَتَّی دَخَلَ۔","","Musannaf Ibn Abi Shaybah 8206","","","كتاب الجمعة"
"8207","(۸۲۰۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ یَحْیَی بْنِ یَزِیدَ الْہُنَائِیِّ ، قَالَ : سَأَلْتُ أَنَسَ بْنَ مَالِکٍ عَنْ قَصْرِ الصَّلاَۃ ، فَقَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا خَرَجَ مَسِیرَۃَ ثَلاَثَۃِ أَمْیَالٍ ، أَوْ ثَلاَثَۃِ فَرَاسِخَ ، شُعْبَۃُ الشَّاکُّ صَلَّی رَکْعَتَیْنِ۔ (مسلم ۱۲۔ ابوداؤد ۱۱۹۴)","Hasan","Musannaf Ibn Abi Shaybah 8207","","","كتاب الجمعة"
"8208","(۸۲۰۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ وَمَنْصُورٍ ، عَنِ الْحَسَنِ ، قَالَ : تُقْصُرُ الصَّلاَۃُ فِی مَسِیرَۃِ اللَّیْلَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 8208","","","كتاب الجمعة"
"8209","(۸۲۰۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الْمُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ لَہُ الْحَارِثُ : أَتَقْصُرُ الصَّلاَۃ إلَی الْمَدَائِنِ؟ قَالَ : إنَّ الْمَدَائِنَ لَقَرِیبٌ وَلَکِنْ إلَی الأَہْوَازِ وَنَحْوِہَا۔","","Musannaf Ibn Abi Shaybah 8209","","","كتاب الجمعة"
"8210","(۸۲۱۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حَجَّاجٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : : کَانَ أَصْحَابُ عَبْدِ اللہِ لاَ یَقْصُرُونَ إلَی وَاسِطٍ وَالْمَدَائِنِ وَأَشْبَاہِہِمَا۔","","Musannaf Ibn Abi Shaybah 8210","","","كتاب الجمعة"
"8211","(۸۲۱۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ زَکَرِیَّا ، أَنَّہُ سَمِعَ الشَّعْبِیَّ یَقُولُ : لَوْ سَافَرْتُ إلَی دَیْرِ الثَّعَالِبِ لَقَصَرْتُ۔","","Musannaf Ibn Abi Shaybah 8211","","","كتاب الجمعة"
"8212","(۸۲۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنْ عَامِرٍ مِثْلَہُ ، إِلاَّ أَنَّ وَکِیعًا قَالَ : لَوْ خَرَجْتُ۔","","Musannaf Ibn Abi Shaybah 8212","","","كتاب الجمعة"
"8213","(۸۲۱۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمعَۃ ، عَنْ عَمْرٍو ، عَنْ أَبِی الشَّعْثَائِ ، قَالَ : تُقْصَرُ فِی مَسِیرَۃِ سِتَّۃِ أَمْیَالٍ۔","","Musannaf Ibn Abi Shaybah 8213","","","كتاب الجمعة"
"8214","(۸۲۱۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْحَسَنُ بْنُ صَالِحٍ وَإِسْرَائِیلُ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : تُقْصَرُ الصَّلاَۃ فِی مَسِیرَۃِ ثَلاَثٍ۔","","Musannaf Ibn Abi Shaybah 8214","","","كتاب الجمعة"
"8215","(۸۲۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، أَوْ غَیْرِہِ ، عَنِ الشَّعْبِیِّ : أَنَّہُ کَانَ یَقْصُرُ الصَّلاَۃ إلَی وَاسِطٍ۔","","Musannaf Ibn Abi Shaybah 8215","","","كتاب الجمعة"
"8216","(۸۲۱۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، قَالَ : رَأَیْتُُ الشَّعْبِیَّ یَقْصُرُ الصَّلاَۃ إلَی وَاسِطٍ۔","","Musannaf Ibn Abi Shaybah 8216","","","كتاب الجمعة"
"8217","(۸۲۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ رَجُلٍ یُقَالُ لَہُ شُبَیْلٌ ، عَنْ أَبِی حِبَرَۃَ ، قَالَ : قُلْتُ لِاِبْنِ عَبَّاسٍ : أَقْصُرُ إلَی الأُبُلَّۃِ ؟ فَقَالَ : تَذْہَبُ وَتَجِیئُ فِی یَوْمٍ ؟ قَالَ : قُلْتُ : نَعَمْ ، قَالَ : لاَ إِلاَّ فِی یَوْمٍ مَتَّاحٍ۔","Hasan","Musannaf Ibn Abi Shaybah 8217","","","كتاب الجمعة"
"8218","(۸۲۱۸) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا ہِشَامُ بْنُ الْغَازِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : أَنَّہُ کَانَ لاَ یَقْصُرُ الصَّلاَۃ إِلاَّ فِی الْیَوْمِ التَّامِّ۔n قَالَ ہِشَامٌ : وَسَمِعْتُ مَکْحُولاً یَقُولُ مِثْلَ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 8218","","","كتاب الجمعة"
"8219","(۸۲۱۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا کَانَ سَفَرُک یَوْمًا إلَی الْعَتَمَۃِ فَلاَ تُقَصِّرِ الصَّلاَۃ ، فَإِنْ جَاوَزْتَ ذَلِکَ فَقَصِّرِ الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 8219","","","كتاب الجمعة"
"8220","(۸۲۲۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنْ سَالِمٍ : أَنَّ ابْنَ عُمَرَ خَرَجَ إلَی أَرْضٍ لَہُ بِذَاتِ النُّصُبِ فَقَصَرَ وَہِیَ سِتَّۃَ عَشَرَ فَرْسَخًا۔","Sahih","Musannaf Ibn Abi Shaybah 8220","","","كتاب الجمعة"
"8221","(۸۲۲۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیرِیِّ ، عَنْ أَبِی الْوَرْدِ ، عَنِ اللَّجْلاَجِ ، قَالَ : کُنَّا نُسَافِرُ مَعَ عُمَرَ بْنِ الْخَطَّابِ فَیَسِیرُ ثَلاَثَۃَ أَمْیَالٍ فَیَتَجَوَّزُ فِی الصَّلاَۃ وَیَفْطُرُ۔","Hasan","Musannaf Ibn Abi Shaybah 8221","","","كتاب الجمعة"
"8222","(۸۲۲۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ الْغَازِ ، عَنْ رَبِیعَۃَ الْجُرَشِیِّ ، عَنْ عَطَائِ بْنِ أَبِی رَبَاحٍ ، قَالَ : قُلْتُ لِاِبْنِ عَبَّاسٍ : أَقْصُرُ إلَی عَرَفَۃَ ؟ فَقَالَ : لاَ ، قُلْتُ : أَقْصُرُ إلَی مَرٍّ ؟ قَالَ : لاَ ، قُلْتُ أَقْصُرُ إلَی الطَّائِفِ وَإِلَی عُسْفَانَ ؟ قَالَ : نَعَمْ ، وَذَلِکَ ثَمَانِیَۃٌ وَأَرْبَعُونَ مِیلاً وَعَقَدَ بِیَدِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 8222","","","كتاب الجمعة"
"8223","(۸۲۲۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُحَارِبِ بْنِ دِثَارٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : إنِّی لأُسَافِرُ السَّاعَۃَ مِنَ النَّہَارِ فَأَقْصُرُ۔","Sahih","Musannaf Ibn Abi Shaybah 8223","","","كتاب الجمعة"
"8224","(۸۲۲۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو، قَالَ: أَخْبَرَنِی عَطَائٌ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تَقْصُرْ إلَی عَرَفَۃَ وَبَطْنِ نَخْلَۃٍ ، وَاقْصُرْ إلَی عُسْفَانَ وَالطَّائِفِ وَجُدَّۃَ فَإِذَا قَدِمْتَ عَلَی أَہْلٍ أَوْ مَاشِیَۃٍ فَأَتِمَّ۔","Sahih","Musannaf Ibn Abi Shaybah 8224","","","كتاب الجمعة"
"8225","(۸۲۲۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، قَالَ : قَالَ لِی جَابِرُ بْنُ زَیْدٍ : اُقْصُرْ بِعَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 8225","","","كتاب الجمعة"
"8226","(۸۲۲۶) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ لِاِبْنِ عَبَّاسٍ أَقْصُرُ بِعَرَفَۃَ ؟ قَالَ : لاَ۔","Sahih","Musannaf Ibn Abi Shaybah 8226","","","كتاب الجمعة"
"8227","(۸۲۲۷) حَدَّثَنَا عُبَیْدُ بْنُ سَعِیدٍ ، عَنْ شُعْبَۃَ ، عَنْ یَزِیدَ بْنِ خُمَیْرٍ ، قَالَ : سَمِعْتُ حَبِیبَ بْنَ عُبَیْدٍ یُحَدِّثُ ، عَنْ جُبَیْرِ بْنِ نُفَیْرٍ ، عَنِ ابْنِ السِّمْطِ قَالَ : شَہِدْتُ عُمَرَ بِذِی الْحُلَیْفَۃِ کَأَنَّہُ یُرِیدُ مَکَّۃَ صَلَّی رَکْعَتَیْنِ فَقُلْتُ لَہُ لِمَ تَفْعَلُ ہَذَا ؟ قَالَ : إنَّمَا أَصْنَعُ کَمَا رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَصْنَعُ۔ (مسلم ۴۸۱۔ احمد ۱/۳۰)","Sahih","Musannaf Ibn Abi Shaybah 8227","","","كتاب الجمعة"
"8228","(۸۲۲۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ خَیْثَمَۃَ ، قَالَ : خَرَجَ الْحَارِثُ بْنُ قَیْسٍ الْجُعْفِیُّ ، فَلَمَّا خَرَجَ مِنَ الْبُیُوتِ قَصَرَ الصَّلاَۃ ، قَالَ : فَقِیلَ لَہُ : تَقْصُرُ الصَّلاَۃ ، قَالَ أُتِمُّ الْیَوْمَ وَأَقْصُرُ غَدًا۔","","Musannaf Ibn Abi Shaybah 8228","","","كتاب الجمعة"
"8229","(۸۲۲۹) حَدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ الْفَائشیِّ ، قَالَ : خَرَجْنَا مَعَ عَلِیٍّ إلَی صِفِّینَ فَصَلَّی بَیْنَ الْجِسْرِ وَالْقَنْطَرَۃِ رَکْعَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 8229","","","كتاب الجمعة"
"8230","(۸۲۳۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَلْقَمَۃُ إذَا خَرَجَ حَاجًّا أَحْرَمَ مِنَ النَّجَفِ وَقَصَرَ۔","","Musannaf Ibn Abi Shaybah 8230","","","كتاب الجمعة"
"8231","(۸۲۳۱) حَدَّثَنَا مُعَاذٌ قَالَ : أَخْبَرَنَا ابْنُ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : تُقْصَرُ الصَّلاَۃ فِی الْیَوْمِ التَّامِّ ، وَلاَ تُقْصَرُ فِیمَا دُونَ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 8231","","","كتاب الجمعة"
"8232","(۸۲۳۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عِمْرَانَ بْنِ عُمَیْرٍ ، عَنْ أَبِیہِ ، قَالَ : خَرَجْتُ مَعَ عَبْدِ اللہِ إلَی مَکَّۃَ فَصَلَّی رَکْعَتَیْنِ بِقَنْطَرَۃِ الْحِیرَۃِ۔","","Musannaf Ibn Abi Shaybah 8232","","","كتاب الجمعة"
"8233","(۸۲۳۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ بْنِ عُمَیْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : قَالَ عَبْدُ اللہِ : لاَ تُقْصَرُ الصَّلاَۃ إِلاَّ فِی حَجٍّ أَوْ جِہَادٍ۔","Sahih","Musannaf Ibn Abi Shaybah 8233","","","كتاب الجمعة"
"8234","(۸۲۳۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ وَسُفْیَانُ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، قَالَ : قَالَ لِی ابْنُ مَسْعُودٍ : لاَ یَغُرَّنَّکُمْ سَوَادُکُمْ مِنْ صَلاَتِکُمْ فَإِنَّمَا ہُوَ مِنْ کُوفَتِِکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 8234","","","كتاب الجمعة"
"8235","(۸۲۳۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : حدَّثَنِی رَجُلٌ مِنْ قُرَّائِ کِتَابِ عُثْمَانَ أَوْ قُرِئَ عَلَیْہِ ، فَقَالَ : أَمَّا بَعْدُ فَإِنَّہُ بَلَغَنِی أَنَّ رِجَالاً مِنْکُمْ یَخْرُجُونَ إلَی سَوَادِہِمْ ، إمَّا فِی جشْرٍ وَإِمَّا فِی جِبَایَۃٍ وَإِمَّا فِی تِجَارَۃٍ فَیَقْصُرُونَ الصَّلاَۃ أوْ لاَ یُتِمُّونَ الصَّلاَۃ ، فَلاَ تَفْعَلُوا فَإِنَّمَا یَقْصُرُ الصَّلاَۃ مَنْ کَانَ شَاخِصًا أَوْ بِحَضْرَۃِ عَدُوٍّ۔","Da'if","Musannaf Ibn Abi Shaybah 8235","","","كتاب الجمعة"
"8236","(۸۲۳۶) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الْعَوَّامِ ، قَالَ : کَانَ إبْرَاہِیمُ التَّیْمِیُّ لاَ یَرَی الْقَصْرَ إِلاَّ فِی حَجٍّ ، أَوْ جِہَادٍ ، أَوْ عُمْرَۃٍ۔","","Musannaf Ibn Abi Shaybah 8236","","","كتاب الجمعة"
"8237","(۸۲۳۷) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانُوا یَقُولُونَ : السَّفَرُ الَّذِی تُقْصَرُ فِیہِ الصَّلاَۃ الَّذِی یُحْمَلُ فِیہِ الزَّادَ وَالْمَزَادَ۔","","Musannaf Ibn Abi Shaybah 8237","","","كتاب الجمعة"
"8238","(۸۲۳۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارق بْنِ شِہَابٍ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : لاَ یَغُرَّنکُمْ سَوَادُکُمْ ہَذَا مِنْ صَلاَتِکُمْ فَإِنَّمَا ہُوَ مِنْ مِصْرِکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 8238","","","كتاب الجمعة"
"8239","(۸۲۳۹) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنِ ابْنِ أَبِی فَرْوَۃَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ : أَنَّ مُعَاذًا وَعُقْبَۃَ بْنَ عَامِرٍ ، وَابْنَ مَسْعُودٍ قَالُوا : لاَ یَغُرَّنکُمْ مَوَاشِیکُمْ یَطَأُ أَحَدُکُمْ بِمَاشِیَتِہِ أَحْدَابَ الْجِبَالِ ، أَوْ بُطُونَ الأَوْدِیَۃِ وَتَزْعُمُونَ بِأَنَّکُمْ سَفْرٌ لاَ وَلاَ کَرَامَۃَ ، إنَّمَا التَّقْصِیرُ فِی السَّفَرِ الْبَاتِّ مِنَ الأُفُقِ إلَی الأُفُقِ۔","Da'if","Musannaf Ibn Abi Shaybah 8239","","","كتاب الجمعة"
"8240","(۸۲۴۰) حَدَّثَنَا شَرِیکٌ ، عَنْ زُبَیْدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ عُمَرَ ، قَالَ : صَلاَۃُ السَّفَرِ رَکْعَتَانِ تَمَامٌ غَیْرُ قَصْرٍ عَلَی لِسَانِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 8240","","","كتاب الجمعة"
"8241","(۸۲۴۱) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ شُفَیٍّ ، قَالَ : قُلْتُ لِاِبْنِ عَبَّاسٍ : إنَّا قَوْمٌ کُنَّا إذَا سَافَرْنَا کَانَ مَعَنَا مَنْ یَکْفِینَا الْخِدْمَۃَ مِنْ غِلْمَانِنَا فَکَیْفَ نُصَلِّی ؟ فَقَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا سَافَرَ صَلَّی رَکْعَتَیْنِ حَتَّی یَرْجِعَ ، قَالَ : ثُمَّ عُدْتُ فَسَأَلْتُہُ فَقَالَ مِثْلَ ذَلِکَ ، ثُمَّ عُدْت فَقَالَ لِی بَعْضُ الْقَوْمِ : أَمَا تَعْقِلُ أَمَا تَسْمَعُ مَا یَقُولُ لَک۔ (احمد ۱/۲۴۱۔ طبرانی ۱۲۷۱۲)","Sahih","Musannaf Ibn Abi Shaybah 8241","","","كتاب الجمعة"
"8242","(۸۲۴۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی خَالِدٍ ، عَنْ أَبِی حَنْظَلَۃَ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنِ الصَّلاَۃ فِی السَّفَرِ ، فَقَالَ : رَکْعَتَانِ سُنَّۃُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (احمد ۲/۱۳۵)","Sahih","Musannaf Ibn Abi Shaybah 8242","","","كتاب الجمعة"
"8243","(۸۲۴۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی عَمَّارٍ ، عَنْ عَبْدِ اللہِ بْنِ بَابَاہ ، عَنْ یَعْلَی بْنِ أُمَیَّۃَ ، قَالَ: سَأَلْتُ عُمَرَ بْنَ الْخَطَّابِ قُلْتُ {فَلَیْسَ عَلَیْکُمْ جُنَاحٌ أَنْ تَقْصُرُوا مِنَ الصَّلاَۃ إِنْ خِفْتُمْ أَنْ یَفْتِنَکُمُ الَّذِینَ کَفَرُوا} وَقَدْ أَمِنَ النَّاسُ ، فَقَالَ : عَجِبْتُ مِمَّا عَجِبْتَ مِنْہُ فَسَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ ذَلِکَ فَقَالَ : صَدَقَۃٌ تَصَدَّقَ اللَّہُ بِہَا عَلَیْکُمْ فَاقْبَلُوا صَدَقَتَہُ۔ (مسلم ۴۔ ابوداؤد ۱۱۹۲)","Sahih","Musannaf Ibn Abi Shaybah 8243","","","كتاب الجمعة"
"8244","(۸۲۴۴) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی لَیْلَی ، قَالَ : خَرَجَ سَلْمَانُ فِی ثَلاَثَۃَ عَشَرَ رَجُلاً مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ غُزَاۃً وَسَلْمَانُ أَسَنُّہُمْ ، فَلَمَّا حَضَرَتِ الصَّلاَۃ قَالُوا لَہُ : تَقَدَّمْ یَا أَبَا عَبْدِ اللہِ ، فَقَالَ : مَا أَنَا بِالَّذِی أَتَقَدَّمُ وَأَنْتُمُ الْعَرَبُ مِنْکُمُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَلْیَتَقَدَّمْ بَعْضُکُمْ ، فَتَقَدَّمَ بَعْضُ الْقَوْمِ فَصَلَّی بِہِمْ أَرْبَعَ رَکَعَاتٍ ، فَلَمَّا قَضَیْنَا الصَّلاَۃ قَالَ سَلْمَانُ : وَمَا لِلْمُرْبَعَۃِ ، إنَّمَا کَانَ یَکْفِینَا رَکْعَتَانِ نِصْفُ الْمُرْبَعَۃِ۔","","Musannaf Ibn Abi Shaybah 8244","","","كتاب الجمعة"
"8245","(۸۲۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ عُبَیْدٍ الطَّائِیُّ ، عَنْ عَلِیِّ بْنِ رَبِیعَۃَ الْوَالِبی ، عَنِ الرَّبِیعِ بْنِ نَضْلَۃَ ، قَالَ : خَرَجْنَا فِی سَفَرٍ وَنَحْنُ اثْنَا عَشَرَ ، أَوْ ثَلاَثَۃَ عَشَرَ رَاکِبًا کُلُّہُمْ قَدْ صَحِبَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ غَیْری ، قَالَ : فَحَضَرَتِ الصَّلاَۃ فَتَدَافَعَ الْقَوْمُ فَتَقَدَّمَ شَابٌّ مِنْہُمْ فَصَلَّی بِہِمْ أَرْبَعَ رَکَعَاتٍ ، فَلَمَّا صَلَّی قَالَ سَلْمَانُ : مَا لَنَا وَلِلْمَرْبُوعَۃِ یَکْفِینَا نِصْفُ الْمَرْبُوعَۃِ ، نَحْنُ إلَی التَّخْفِیفِ أَفْقَرُ فَقَالُوا : تَقَدَّمْ أَنْتَ یَا أَبَا عَبْدِ اللہِ فَصَلِّ بِنَا ، فَقَالَ : أَنْتُمْ بَنُو إسْمَاعِیلَ الأَئِمَّۃُ وَنَحْنُ الْوُزَرَائُ۔","Da'if","Musannaf Ibn Abi Shaybah 8245","","","كتاب الجمعة"
"8246","(۸۲۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، قَالَ : جَائَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إنِّی رَجُلٌ تَاجِرٌ أَخْتَلِفُ إلَی الْبَحْرَیْنِ فَأَمَرَہُ أَنْ یُصَلِّیَ رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 8246","","","كتاب الجمعة"
"8247","(۸۲۴۷) حَدَّثَنَا شَرِیکٌ ، عَنِ أَبِی إِسْحَاقَ ، قَالَ : سَأَلْتُ سَلَمَۃَ بْنَ صُہَیْبٍ وَنَحْنُ بِسِجِسْتَانَ ، عَنِ الصَّلاَۃ ، فَقَالَ : رَکْعَتَیْنِ رَکْعَتَیْنِ حَتَّی تَرْجِعَ إلَی أَہْلِکَ ، ہَکَذَا کَانَ عَبْدُ اللہِ بْنُ مَسْعُودٍ یَقُولُ۔","Hasan","Musannaf Ibn Abi Shaybah 8247","","","كتاب الجمعة"
"8248","(۸۲۴۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : صَلَّیْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیْنَ مَکَّۃَ وَالْمَدِینَۃِ وَنَحْنُ آمِنُونَ لاَ نَخَافُ ش[corrupt]یْئًا رَکْعَتَیْنِ۔ (ترمذی ۵۴۷۔ احمد ۱/۲۲۶)","","Musannaf Ibn Abi Shaybah 8248","","","كتاب الجمعة"
"8249","(۸۲۴۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، وَابْنُ أَبِی لَیْلَی ، عَنْ عَوْنِ بْنِ أَبِی جُحَیْفَۃَ السُّوَائِیِّ ، عَنْ أَبِیہِ ، قَالَ: صَلَّیْتُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِنًی الظُّہْرَ رَکْعَتَیْنِ ، ثُمَّ لَمْ یَزَلْ یُصَلِّی رَکْعَتَیْنِ حَتَّی رَجَعَ إلَی الْمَدِینَۃِ۔ (احمد ۴/۳۰۹۔ طبرانی ۲۵۱)","Sahih","Musannaf Ibn Abi Shaybah 8249","","","كتاب الجمعة"
"8250","(۸۲۵۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : أَوَّلُ مَا فُرِضَتِ الصَّلاَۃ رَکْعَتَیْنِ ، ثُمَّ زِیدَ فِیہَا فَجُعِلَ لِلْمُقِیمِ أَرْبَعًا۔ (بخاری ۳۵۰۔ مسلم ۴۷۸)","Sahih","Musannaf Ibn Abi Shaybah 8250","","","كتاب الجمعة"
"8251","(۸۲۵۱)حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ سِمَاکٍ الْحَنَفِیِّ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : الرَّکْعَتَانِ فِی السَّفَرِ تَمَامٌ غَیْرُ قَصْرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 8251","","","كتاب الجمعة"
"8252","(۸۲۵۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ وِقَائِ بْنِ إیَاسٍ ، عَنْ عَلِیِّ بْنِ رَبِیعَۃَ : أَنَّ عَلِیًّا خَرَجَ فِی السَّفَرِ ، فَکَانَ یُصَلِّی رَکْعَتَیْنِ رَکْعَتَیْنِ حَتَّی یَرْجِعَ۔","Hasan","Musannaf Ibn Abi Shaybah 8252","","","كتاب الجمعة"
"8253","(۸۲۵۳) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ أَبِی حَرْبِ بْنِ أَبِی الأَسْوَدِ : أَنَّ عَلِیًّا خَرَجَ مِنَ الْبَصْرَۃِ فَصَلَّی الظُّہْرَ أَرْبَعًا ، ثُمَّ قَالَ : أَمَا إنَّا إذَا جَاوَزْنَا ہَذَا الْخُصَّ صَلَّیْنَا رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 8253","","","كتاب الجمعة"
"8254","(۸۲۵۴) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، أَنَّہُ سَمِعَ رَجُلاً یَسْأَلُ سَعِیدَ بْنَ الْمُسَیَّبِ أُتِمُّ الصَّلاَۃ وَأَصُومُ فِی السَّفَرِ ؟ قَالَ : لاَ ، قَالَ : فَإِنِّی أَقْوَی عَلَی ذَلِکَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَقْوَی مِنْک کَانَ یَقْصُرُ الصَّلاَۃ فِی السَّفَرِ وَیُفْطِرُ ، وَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خِیَارُکُمْ مَنْ قَصَرَ الصَّلاَۃ فِی السَّفَرِ وَأَفْطَرَ۔ (عبدالرزاق ۴۴۸۰۔ طبرانی ۶۵۵۴)","","Musannaf Ibn Abi Shaybah 8254","","","كتاب الجمعة"
"8255","(۸۲۵۵) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنِ أَبِی إِسْحَاقَ ، قَالَ : لَقِیتُ عَبْدَ اللہِ بْنَ مَعقِلٍ بِالْمَدَائِنِ فَقُلْتُ : إنِّی إمَامُ قَوْمِی وَإِنِّی أُرِیدُ الرُّجُوعَ إلَی أَہْلِی فَکَمْ أُصَلِّی ؟ قَالَ : أَرْبَعًا ، ثُمَّ لَقِیتُہُ بَعْدُ بِالرَّیِّ فَقُلْت إنِّی أُرِیدُ أنْ أرْجِع إلَی أَہْلِی فَکَمْ تَأْمُرُنِی أَنْ أُصَلِّیَ ؟ قَالَ رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 8255","","","كتاب الجمعة"
"8256","(۸۲۵۶) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ قَالَ : حدَّثَنَا إبْرَاہِیمُ بْنُ نَافِعٍ ، عَنِ ابْنِ طَاوُوس ، قَالَ : کَانَ أَبِی یَقْصُرُ مِنْ حِینِ یَخْرُجُ مِنْ بَیْتِہِ حَتَّی یَرْجِعَ إلَی أَہْلِہِ۔","","Musannaf Ibn Abi Shaybah 8256","","","كتاب الجمعة"
"8257","(۸۲۵۷) حَدَّثَنَا ہُشَیْمٌ قَالَ : أَخْبَرَنَا ہَارُونُ بْنُ زَارْوَی ، عَنْ مُجَاہِدٍ ، قَالَ : جَائَ رَجُلٌ إلَی ابْنِ عَبَّاسٍ ، فَقَالَ : إنِّی وَصَاحِبٌ لِی کُنَّا فِی سَفَرٍ فَکُنْتُ أُتِمُّ وَکَانَ صَاحِبِی یَقْصُرُ ، فَقَالَ لَہُ ابْنُ عَبَّاسٍ : بَلْ أَنْتَ الَّذِی کُنْتَ تَقْصُرُ وَصَاحِبُک الَّذِی کَانَ یُتِمُّ۔","Da'if","Musannaf Ibn Abi Shaybah 8257","","","كتاب الجمعة"
"8258","(۸۲۵۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ أَبِی نَضْرَۃَ ، قَالَ : مَرَّ عِمْرَانُ بْنُ حُصَیْنٍ فِی مَجْلِسِنَا ، فَقَامَ إلَیْہِ فَتًی مِنَ الْقَوْمِ فَسَأَلَہُ عَنْ صَلاَۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْحَجِّ وَالْغَزْوِ وَالْعُمْرَۃِ ، فَجَائَ فَوَقَفَ عَلَیْنَا فَقَالَ : إنَّ ہَذَا سَأَلَنِی عَنْ أَمْرٍ فَأَرَدْتُ أَنْ تَسْمَعُوہُ ، أَوْ کَمَا قَالَ : غَزَوْتُ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَلَمْ یُصَلِّ إِلاَّ رَکْعَتَیْنِ حَتَّی رَجَعَ إلَی الْمَدِینَۃِ ، وَحَجَجْتُ مَعَہُ فَلَمْ یُصَلِّ إِلاَّ رَکْعَتَیْنِ حَتَّی رَجَعَ إلَی الْمَدِینَۃِ ، وَشَہِدْتُ مَعَہُ الْفَتْحَ فَأَقَامَ بِمَکَّۃَ ثَمَانَ عَشْرَۃَ لَیْلَۃً لاَ یُصَلِّی إِلاَّ رَکْعَتَیْنِ ، یَقُولُ لأَہْلِ الْبَلَدِ : صَلُّوا أَرْبَعًا فَإِنَّا سَفْرٌ ، وَاعْتَمَرْتُ مَعَہُ ثَلاَثَ عُمَرَ لاَ یُصَلِّی إِلاَّ رَکْعَتَیْنِ ، وَحَجَجْت مَعَ أَبِی بَکْرٍ وَغَزَوْت فَلَمْ یُصَلِّ إِلاَّ رَکْعَتَیْنِ حَتَّی رَجَعَ إلَی الْمَدِینَۃِ ، وَحَجَجْت مَعَ عُمَرَ حَجَّاتٍ فَلَمْ یُصَلِّ إِلاَّ رَکْعَتَیْنِ حَتَّی رَجَعَ إلَی الْمَدِینَۃِ، وَحَجَجْت مَعَ عُثْمَانَ سَبْعَ سِنِینَ مِنْ إمَارَتِہِ لاَ یُصَلِّی إِلاَّ رَکْعَتَیْنِ ، ثُمَّ صَلاَّہا بِمِنًی أَرْبَعًا۔","Da'if","Musannaf Ibn Abi Shaybah 8258","","","كتاب الجمعة"
"8259","(۸۲۵۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ سِمَاکٍ ، عَنْ عَوْنِ بْنِ أَبِی جُحَیْفَۃَ ، عَنْ أَبِیہِ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمَکَّۃَ الظُّہْرَ رَکْعَتَیْنِ صَلاَۃَ الْمُسَافِرِ۔","Hasan","Musannaf Ibn Abi Shaybah 8259","","","كتاب الجمعة"
"8260","(۸۲۶۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزَیْدٍ ، قَالَ : صَلَّی عُثْمَانُ بِمِنًی أَرْبَعًا ، فَقَالَ عَبْدُ اللہِ : صَلَّیْتُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِنًی رَکْعَتَیْنِ ، وَمَعَ أَبِی بَکْرٍ رَکْعَتَیْنِ ، وَمَعَ عُمَرَ رَکْعَتَیْنِ ، ثُمَّ تَفَرَّقَتْ بِکُمُ الطُّرُقُ ، وَلَوَدِدْت أَنَّ لِی مِنْ أَرْبَعِ رَکَعَاتٍ رَکْعَتَیْنِ مُتَقَبَّلَتَیْنِ۔n(بخاری ۱۶۵۷۔ مسلم ۱۹)","Sahih","Musannaf Ibn Abi Shaybah 8260","","","كتاب الجمعة"
"8261","(۸۲۶۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، وَأَبُو الأَحْوَص ، عَنْ أَبِی إِسْحَاقَ ، عَنْ حَارِثَۃَ بْنِ وَہْبٍ الْخُزَاعِیِّ ، قَالَ : صَلَّیْتُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِنًی آمَنَ مَا کَانَ النَّاسُ وَأَکْثَرہ رَکْعَتَیْنِ۔ (بخاری ۱۰۸۳۔ مسلم ۲۱)","Sahih","Musannaf Ibn Abi Shaybah 8261","","","كتاب الجمعة"
"8262","(۸۲۶۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ السَّائِبِ الطَّائِفِیُّ ، عَنْ دَاوُدَ بْنِ أَبِی عَاصِمٍ الثَّقَفِیِّ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنِ الصَّلاَۃ بِمِنًی فَقَالَ : ہَلْ سَمِعْتَ بِمُحَمَّدٍ وَ آمَنْتَ بِہِ ، فَإِنَّہُ کَانَ یُصَلِّی بِمِنًی رَکْعَتَیْنِ۔ (احمد ۲/۲۴)","Sahih","Musannaf Ibn Abi Shaybah 8262","","","كتاب الجمعة"
"8263","(۸۲۶۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَبَا بَکْرٍ وَعُمَرَ وَعُثْمَانَ صَدْرًا مِنْ إمَارَتِہِ صَلَّوْا بِمِنًی رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 8263","","","كتاب الجمعة"
"8264","(۸۲۶۴) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا حَنْظَلَۃُ قَالَ: سَأَلْتُ الْقَاسِمَ وَسَالِمًا وَطَاوُوسا عَنِ الصَّلاَۃ بِمِنًی، فَقَالُوا: قَصر۔","","Musannaf Ibn Abi Shaybah 8264","","","كتاب الجمعة"
"8265","(۸۲۶۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : یُصَلِّی الْمُسَافِرُ رَکْعَتَیْنِ حَتَّی یَرْجِعَ إِلاَّ أَنْ یَأْتِیَ مِصْرًا مِنَ الأَمْصَارِ فَیُصَلِّیَ بِصَلاَتِہِمْ۔","","Musannaf Ibn Abi Shaybah 8265","","","كتاب الجمعة"
"8266","(۸۲۶۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ: إِنَّ الصَّلاَۃ أَوَّلُ مَا فُرِضَتْ رَکْعَتَیْنِ فَزِیدَتْ فِی صَلاَۃِ الْحَضَرِ وَأُقِرَّتْ صَلاَۃُ السَّفَرِ ، فَقُلْت لِعُرْوَۃِ : مَا بَالُ عَائِشَۃَ کَانَتْ تُتِمُّ الصَّلاَۃ فِی السَّفَرِ وَہِیَ تَقُولُ ہَذَا ؟ قَالَ : تَأَوَّلَتْ مَا تَأَوَّلَ عُثْمَانُ فَلَمْ أَسْأَلْہُ مَا تَأَوَّلَ عُثْمَانُ۔ (مسلم ۶۷۸)","Sahih","Musannaf Ibn Abi Shaybah 8266","","","كتاب الجمعة"
"8267","(۸۲۶۷) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، قَالَ : نُبِّئْت عَنِ الْقَاسِمِ وَسَالِمٍ أَنَّہُمَا کَانَ یَقُولاَنِ : أَہْلُ مَکَّۃَ إذَا خَرَجُوا إلَی مِنًی قَصَرُوا۔n قَالَ : وَکَانَ عَطَائٌ وَالزُّہْرِیُّ یَقُولاَنِ : یُتِمُّونَ۔","","Musannaf Ibn Abi Shaybah 8267","","","كتاب الجمعة"
"8268","(۸۲۶۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : أَنَّہُ کَانَ یُقِیمُ بِمَکَّۃَ فَإِذَا خَرَجَ إلَی مِنًی قَصَرَ۔","Sahih","Musannaf Ibn Abi Shaybah 8268","","","كتاب الجمعة"
"8269","(۸۲۶۹) حَدَّثَنَا عُبَیْدُاللہِ بْنُ مُوسَی، عَنْ حَنْظَلَۃَ، قَالَ: سَأَلْتُ الْقَاسِمَ عَنِ الصَّلاَۃ مَعَ الإِمَامِ بِعَرَفَۃَ؟ قَالَ: صَلِّ بِصَلاَتِہِ۔n قَالَ : وَسَأَلْت سَالِمًا وَطَاوُوسا فَقَالاَ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 8269","","","كتاب الجمعة"
"8270","(۸۲۷۰) حَدَّثَنَا عُبَیْدُ اللہِ بنُ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ ، قَالاَ : لَیْسَ عَلَی أَہْلِ مَکَّۃَ قَصْرُ صَلاَۃٍ فِی حَجٍّ۔","","Musannaf Ibn Abi Shaybah 8270","","","كتاب الجمعة"
"8271","(۸۲۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمُغِیرَۃُ بْنُ زِیَادٍ ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُتِمُّ الصَّلاَۃ فِی السَّفَرِ وَیَقْصُرُ وَیَصُومُ وَیُفْطِرُ وَیُؤَخِّرُ الظُّہْرَ وَیُعَجِّلُ الْعَصْرَ وَیُؤَخِّرُ الْمَغْرِبَ وَیُعَجِّلُ الْعِشَائَ۔ (دارقطنی ۴۵۔ طحاوی ۱۶۴)","","Musannaf Ibn Abi Shaybah 8271","","","كتاب الجمعة"
"8272","(۸۲۷۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَاصِمٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : إِنْ صَلَّیْتَ فِی السَّفَرِ رَکْعَتَیْنِ فَالسُّنَّۃُ ، وَإِنْ صَلَّیْتَ أَرْبَعًا فَالسُّنَّۃُ۔","","Musannaf Ibn Abi Shaybah 8272","","","كتاب الجمعة"
"8273","(۸۲۷۳) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ : أَنَّہَا کَانَتْ تُتِمُّ الصَّلاَۃ فِی السَّفَرِ۔","Sahih","Musannaf Ibn Abi Shaybah 8273","","","كتاب الجمعة"
"8274","(۸۲۷۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ خُضَیْرٍ ، عَنْ أَبِی نَجِیحٍ الْمَکِّیِّ ، قَالَ : اصْطَحَبَ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی السَّیْرِ ، فَکَانَ بَعْضُہُمْ یُتِمُّ وَبَعْضُہُمْ یَقْصُرُ وَبَعْضُہُمْ یَصُومُ وَبَعْضُہُمْ یُفْطِرُ، فَلاَ یَعِیبُ ہَؤُلاَئِ عَلَی ہَؤُلاَئِ ، وَلاَ ہَؤُلاَئِ عَلَی ہَؤُلاَئِ۔","Hasan","Musannaf Ibn Abi Shaybah 8274","","","كتاب الجمعة"
"8275","(۸۲۷۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا بِسْطَامُ بْنُ مُسْلِمٍ ، قَالَ : سَأَلْتُ عَطَائً عَنْ قَصْرِ الصَّلاَۃ فِی السَّفَرِ ؟ فَقَالَ: إِنْ قَصَرْتَ فَرُخْصَۃٌ وَإِنْ شِئْتَ أَتْمَمْتَ۔","","Musannaf Ibn Abi Shaybah 8275","","","كتاب الجمعة"
"8276","(۸۲۷۶) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ حَبِیبِ بْنِ شَہِیدٍ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، أَنَّہُ سَأَلَ سَعِیدَ بْنَ الْمُسَیَّبِ عَنِ الصَّلاَۃ فِی السَّفَرِ ، فَقَالَ : إِنْ شِئْتَ رَکْعَتَیْنِ وَإِنْ شِئْتَ فَأَرْبَع۔","","Musannaf Ibn Abi Shaybah 8276","","","كتاب الجمعة"
"8277","(۸۲۷۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ ، قَالَ : قُلْتُ لَہُمَا : الرَّجُلُ یَبْدُو عَشَرَۃَ أَیَّامٍ أَیَقْصُرُ الصَّلاَۃ ؟ قَالَ : فَقَالاَ : لاَ۔","","Musannaf Ibn Abi Shaybah 8277","","","كتاب الجمعة"
"8278","(۸۲۷۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، قَالَ : سُئِلَ جَابِرُ بْنُ زَیدٍ عَنِ الْقَوْمِ یَبْدُونَ مِنْ مِصْرِہِمْ إلَی الْبَرِّیَّۃِ أَیُصَلُّونَ ثِنْتَیْنِ مَا دَامُوا بُدَاۃً حَتَّی یَرْجِعُوا إلَی مِصْرِہِمْ ؟ قَالَ : لاَ لیُتِمُّوا الصَّلاَۃ فِی الْقُرْبِ والبُعد مَا دَامُوا بُدَاۃً۔","","Musannaf Ibn Abi Shaybah 8278","","","كتاب الجمعة"
"8279","(۸۲۷۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ، قَالَ : شَہِدْتُ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْفَتْحَ فَأَقَامَ بِمَکَّۃَ ثَمَانَ عَشْرَۃَ لَیْلَۃً لاَ یُصَلِّی إِلاَّ رَکْعَتَیْنِ ، ثُمَّ یَقُولُ لأَہْلِ الْبَلَدِ : صَلُّوا أَرْبَعًا فَإِنَّا سَفْرٌ۔","Da'if","Musannaf Ibn Abi Shaybah 8279","","","كتاب الجمعة"
"8280","(۸۲۸۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أقَامَ حَیْثُ فَتَحَ مَکَّۃَ خَمْسَ عَشْرَۃَ یَقْصُرُ الصَّلاَۃ حَتَّی سَارَ إلَی حُنَیْنٍ۔ (ابوداؤد ۱۲۲۴۔ نسائی ۵۱۱)","","Musannaf Ibn Abi Shaybah 8280","","","كتاب الجمعة"
"8281","(۸۲۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یَحْیَی بْنِ أَبِی إِسْحَاقَ ، قَالَ : سَمِعْتُ أَنَسَ بْنَ مَالِکٍ یَقُولُ : خَرَجْنَا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَصَرَ الصَّلاَۃ حَتَّی أَتَیْنَا مَکَّۃَ وَأَقَامَ بِہَا عَشْرًا یَقْصُرُ الصَّلاَۃ حَتَّی رَجَعَ إلَی الْمَدِینَۃِ۔ (بخاری ۱۰۸۱۔ مسلم ۱۵)","Sahih","Musannaf Ibn Abi Shaybah 8281","","","كتاب الجمعة"
"8282","(۸۲۸۲) حَدَّثَنَا شَرِیکٌ ، عَنِ ابْنِ الأَصْبَہَانِیِّ ، عَنْ عِکْرِمَۃَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَقَامَ بِمَکَّۃَ سَبْعَ عَشْرَۃَ یَقْصُرُ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8282","","","كتاب الجمعة"
"8283","(۸۲۸۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ سِمَاکِ بْنِ سَلَمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إِنْ أَقَمْتَ فِی بَلَدٍ خَمْسَۃَ أَشْہُرٍ فَاقْصُرِ الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 8283","","","كتاب الجمعة"
"8284","(۸۲۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ وَسُفْیَانُ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ مِسْوَرٍ ، قَالَ : أَقَمْنَا مَعَ سَعْدِ بْنِ مَالِکٍ شَہْرَیْنِ ، قَالَ سُفْیَانُ : بِعُمَّانَ ، وَقَالَ مِسْعَرٌ : بِعُمَّانَ ، أَوْ عَمَّان یَقْصُرُ الصَّلاَۃ وَنَحْنُ نُتِمُّ ، فَقُلْنَا لَہُ فَقَالَ : نَحْنُ أَعْلَمُ۔","Hasan","Musannaf Ibn Abi Shaybah 8284","","","كتاب الجمعة"
"8285","(۸۲۸۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ أَبِی التَّیَّاحِ الضُّبَعِیِّ ، عَنْ رَجُلٍ مِنْ عَنْزَۃَ یُکَنَّی أَبَا الْمِنْہَالِ ، قَالَ: قُلْتُ لِاِبْنِ عَبَّاسٍ : إنِّی أُقِیمُ بِالْمَدِینَۃِ حَوْلاً لاَ أَشُدُّ عَلَی سَیْرٍ ، قَالَ : صَلِّ رَکْعَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 8285","","","كتاب الجمعة"
"8286","(۸۲۸۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمُثَنَّی بْنُ سَعِیدٍ ، عَنْ أَبِی جَمْرَۃَ نَصْرِ بْنِ عِمْرَانَ ، قَالَ : قلت لِاِبْنِ عَبَّاسٍ: إنَّا نُطِیلُ الْقِیَامَ بِالْغَزْوِ بِخُرَاسَانَ فَکَیْفَ تَرَی ؟ فَقَالَ : صَلِّ رَکْعَتَیْنِ وَإِنْ أَقَمْتَ عِشْرِینَ سَنَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 8286","","","كتاب الجمعة"
"8287","(۸۲۸۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّ عَبْدَ الرَّحْمَن بْنَ سَمُرَۃَ شَتَی بِکَابُلَ شَتْوَۃً ، أَوْ شَتْوَتَیْنِ یُصَلِّی رَکْعَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 8287","","","كتاب الجمعة"
"8288","(۸۲۸۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّ أَنَسَ بْنَ مَالِکٍ أَقَامَ بِسَابُورَ سَنَۃً ، أَوْ سَنَتَیْنِ یُصَلِّی رَکْعَتَیْنِ ، ثُمَّ یُسَلِّمُ ، ثُمَّ یُصَلِّی رَکْعَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 8288","","","كتاب الجمعة"
"8289","(۸۲۸۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ مَالِکٍ ، قَالَ : قُلْتُ لِجَابِرِ بْنِ زَیْدٍ : أُقِیمُ بِکَسْکَرٍ السَّنَۃَ وَالسَّنَتَیْنِ وَأَنَا شِبْہُ الأَہِلِ ، فَقَالَ : صَلِّ رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 8289","","","كتاب الجمعة"
"8290","(۸۲۹۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ مَسْرُوقٍ ، قَالَ : أَقَمْتُ مَعَہُ سَنَتَیْنِ یُصَلِّی رَکْعَتَیْنِ بِالسِّلْسِلَۃِ ، قَالَ : قُلْتُ لَہُ : مَا حَمَلَک عَلَی ہَذَا یَا أَبَا عَائِشَۃَ ؟ فَقَالَ : الْتِمَاسُ السُّنَّۃِ۔","","Musannaf Ibn Abi Shaybah 8290","","","كتاب الجمعة"
"8291","(۸۲۹۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی وَائِلٍ ، عَنْ مَسْرُوقٍ بِنَحْوِ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 8291","","","كتاب الجمعة"
"8292","(۸۲۹۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ، قَالَ: کُنْتُ مَعَ عَلْقَمَۃَ بِخَوَارِزْمَ سَنَتَینِ یُصَلِّی رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 8292","","","كتاب الجمعة"
"8293","(۸۲۹۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : عَلِیُّ بْنُ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ ، قَالَ : أَقَامَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِتَبُوکَ عِشْرِینَ لَیْلَۃً یُصَلِّی صَلاَۃَ الْمُسَافِرِ رَکْعَتَیْنِ۔ (بیہقی ۱۵۲۔ عبدالرزاق ۴۳۳۵)","","Musannaf Ibn Abi Shaybah 8293","","","كتاب الجمعة"
"8294","(۸۲۹۴) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا زَکَرِیَّا عَنْ عَامِرٍ قَالَ : أَقَامَ عَلْقَمَۃُ بِمَرْوَ سَنَتَیْنِ فِی الْغَزْوِ یَقْصُرُ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8294","","","كتاب الجمعة"
"8295","(۸۲۹۵) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَقَامَ سَبْعَ عَشْرَۃَ یَقْصُرُ الصَّلاَۃ ، قَالَ : وَقَالَ ابْنُ عَبَّاسٍ : مَنْ أَقَامَ سَبْعَ عَشْرَۃَ قَصَرَ الصَّلاَۃ وَمَنْ أَقَامَ أَکْثَرَ مِنْ ذَلِکَ أَتَمَّ۔ (بخاری ۱۰۸۰۔ ابوداؤد ۱۲۲۳)","Sahih","Musannaf Ibn Abi Shaybah 8295","","","كتاب الجمعة"
"8296","(۸۲۹۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : إذَا أَجْمَعَ الرَّجُلُ عَلَی إقَامَۃِ خَمْسَ عَشْرَۃَ أَتَمَّ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8296","","","كتاب الجمعة"
"8297","(۸۲۹۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا أَقَمْت عَشْرًا فَأَتِمَّ۔","","Musannaf Ibn Abi Shaybah 8297","","","كتاب الجمعة"
"8298","(۸۲۹۸) حَدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ بِنَحْوِہِ۔","","Musannaf Ibn Abi Shaybah 8298","","","كتاب الجمعة"
"8299","(۸۲۹۹) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ ابی جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : مَنْ أَقَامَ عَشْرًا أَتَمَّ۔","","Musannaf Ibn Abi Shaybah 8299","","","كتاب الجمعة"
"8300","(۸۳۰۰) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ عَنْ أَبِی جَعْفَرٍ ، أَنَّہُ کَانَ یُتِمُّ فِی عَشْر۔","","Musannaf Ibn Abi Shaybah 8300","","","كتاب الجمعة"
"8301","(۸۳۰۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُمَر بْنُ ذَرٍّ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ ابْنُ عُمَرَ إذَا أَجْمَعَ عَلَی إقَامَۃِ خَمْسَ عَشْرَۃَ سَرَحَ ظَہْرَہُ وَصَلَّی أَرْبَعًا۔","Sahih","Musannaf Ibn Abi Shaybah 8301","","","كتاب الجمعة"
"8302","(۸۳۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : إذَا أَقَمْتَ أَکْثَرَ مِنْ خَمْسَ عَشْرَۃَ فَأَتِمَّ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8302","","","كتاب الجمعة"
"8303","(۸۳۰۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ، قَالَ : إذَا أَقَمْتَ أَرْبَعًا فَصَلِّ أَرْبَعًا۔","","Musannaf Ibn Abi Shaybah 8303","","","كتاب الجمعة"
"8304","(۸۳۰۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا قُرَّۃُ بْنُ خَالِدٍ ، عَنْ أَبِی حُکَیمَۃَ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ ، فَقَالَ : إذَا أَقَمْتَ ثَلاَثًا فَأَتِمَّ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8304","","","كتاب الجمعة"
"8305","(۸۳۰۵) قَالَ وَکِیعٌ : سَمِعْتُ سُفْیَانَ یَقُولُ : إذَا أَجْمَعَ عَلَی مُقَامِ خَمْسَ عَشْرَۃَ أَتَمَّ الصَّلاَۃ حِینَ یَدْخُلُ ، وَإِذَا لَمْ یَدْرِ مَتَی یَخْرُجُ صَلَّی رَکْعَتَیْنِ وَإِنْ أَقَامَ حَوْلاً وَہُوَ الْقَوْلُ عِنْدَہُ۔","","Musannaf Ibn Abi Shaybah 8305","","","كتاب الجمعة"
"8306","(۸۳۰۶) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : إذَا وَضَعْتَ الزَّادَ وَالْمَزَادَ فَصَلِّ أَرْبَعًا وَکَانَ طَاوُوس إذَا قَدِمَ مَکَّۃَ صَلَّی أَرْبَعًا۔","Da'if","Musannaf Ibn Abi Shaybah 8306","","","كتاب الجمعة"
"8307","(۸۳۰۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : یُصَلِّی رَکْعَتَیْنِ فَإِذَا اطْمَأَنَّ صَلَّی أَرْبَعًا ، یَعْنِی إذَا نَزَلَ۔","","Musannaf Ibn Abi Shaybah 8307","","","كتاب الجمعة"
"8308","(۸۳۰۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ أَیُّوبَ، عَنْ عَمْرٍو، عَنْ عَطَائٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: إذَا انْتَہَیْتَ إلَی مَاشِیَتِکَ فَأَتْمِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 8308","","","كتاب الجمعة"
"8309","(۸۳۰۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 8309","","","كتاب الجمعة"
"8310","(۸۳۱۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا قَدِمَ مُسَافِرٌ مِصْرًا مِنَ الأَمْصَارِ صَلَّی أَرْبَعًا۔","","Musannaf Ibn Abi Shaybah 8310","","","كتاب الجمعة"
"8311","(۸۳۱۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا جَدَّ بِہِ السَّیْرُ جَمَعَ بَیْنَ الْمَغْرِبِ وَالْعِشَائِ۔ (بخاری ۱۱۰۶۔ مسلم ۴۵)","Sahih","Musannaf Ibn Abi Shaybah 8311","","","كتاب الجمعة"
"8312","(۸۳۱۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ جَابِرِ بْنِ زَیْدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : صَلَّیْتُ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ثَمَانِیًا جَمِیعًا وَسَبْعًا جَمِیعًا ، قَالَ : قُلْتُ : یَا أَبَا الشَّعْثَائِ أَظُنُّہُ أَخَّرَ الظُّہْرَ وَعَجَّلَ الْعَصْرَ وَأَخَّرَ الْمَغْرِبَ وَعَجَّلَ الْعِشَائَ ، قَالَ : وَأَنَا أَظُنُّ ذَلِکَ۔ (بخاری ۵۴۳۔ ابوداؤد ۱۲۰۷)","Sahih","Musannaf Ibn Abi Shaybah 8312","","","كتاب الجمعة"
"8313","(۸۳۱۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، قَالَ : جَمَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی غَزْوَۃِ تَبُوکَ بَیْنَ الظُّہْرِ وَالْعَصْرِ وَبَیْنَ الْمَغْرِبِ وَالْعِشَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 8313","","","كتاب الجمعة"
"8314","(۸۳۱۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ أَبِی الطُّفَیْلِ ، عَنْ مُعَاذِ بْنِ جَبَلٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَمَعَ بَیْنَ الظُّہْرِ وَالْعَصْرِ وَبَیْنَ الْمَغْرِبِ وَالْعِشَائِ فِی السَّفَرِ فِی غَزْوَۃِ تَبُوکَ۔ (مسلم ۵۲۔ ابوداؤد ۱۱۹۹)","Sahih","Musannaf Ibn Abi Shaybah 8314","","","كتاب الجمعة"
"8315","(۸۳۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا دَاوُد بْنُ قَیْسٍ الْفَرَّائُ ، عَنْ صَالِحٍ مَوْلَی التَّوْأَمَۃِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : جَمَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیْنَ الظُّہْرِ وَالْعَصْرِ وَالْمَغْرِبِ وَالْعِشَائِ فِی الْمَدِینَۃِ فِی غَیْرِ خَوْفٍ وَلاَ مَطَرٍ ، قَالَ: فَقِیلَ لِاِبْنِ عَبَّاسٍ : لِمَ فَعَلَ ذَلِکَ ؟ قَالَ : أَرَادَ التَّوْسِعَۃَ عَلَی أُمَّتِہِ۔ (احمد ۱/۳۴۶۔ ابو یعلی ۲۶۷۰)","Sahih","Musannaf Ibn Abi Shaybah 8315","","","كتاب الجمعة"
"8316","(۸۳۱۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِمْرَانُ بْنُ حُدَیْرٍ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ الْعُقَیْلِیِّ ، قَالَ : قَالَ رَجُلٌ لِاِبْنِ عَبَّاسٍ : الصَّلاَۃ فَسَکَتَ ، ثُمَّ قَالَ لَہُ : الصَّلاَۃ فَسَکَتَ ، ثُمَّ قَالَ لَہُ : الصَّلاَۃ ثَلاَثًا ، فَقَالَ : لاَ أُمَّ لَکَ أَنْتَ تُعَلِّمُنَا بِالصَّلاَۃ ، قَدْ کُنَّا نَجْمَعُ بَیْنَ الصَّلاَتَیْنِ عَلَی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، یَعْنِی فِی السَّفَرِ۔ (مسلم ۵۸۔ احمد ۳۵۱)","Sahih","Musannaf Ibn Abi Shaybah 8316","","","كتاب الجمعة"
"8317","(۸۳۱۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ حَفْصِ بْنِ عُبَیْدِ اللہِ بْنِ أَنَسٍ ، قَالَ : کُنَّا نُسَافِرُ مَعَ أَنَسِ بْنِ مَالِکٍ ، فَکَانَ إِذَا زَالَتِ الشَّمْسُ وَہُوَ فِی مَنْزِلٍ ، لَمْ یَرْکَبْ حَتَّی یُصَلِّیَ الظُّہْرَ ، فَإِذَا رَاحَ فَحَضَرَتِ الْعَصْرُ صَلَّی الْعَصْرَ ، فَإِنْ سَارَ مِنْ مَنْزِلِہِ قَبْلَ أَنْ تَزُولَ ، فَحَضَرَتِ الصَّلاَۃُ قُلْنَا لَہُ : الصَّلاَۃَ ، فَیَقُولُ : سِیرُوا ، حَتَّی إِذَا کَانَ بَیْنَ الصَّلاَتَیْنِ نَزَلَ فَجَمَعَ بَیْنَ الظُّہْرِ وَالْعَصْرِ ، ثُمَّ یَقُولُ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، إِذَا وَصَلَ ضَحْوَتَہُ بِرَوْحَتِہِ صَنَعَ ہَکَذَا۔ (عبدالرزاق ۴۳۹۵)","","Musannaf Ibn Abi Shaybah 8317","","","كتاب الجمعة"
"8318","(۸۳۱۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : أَقْبَلَ ابْنُ عَبَّاسٍ مِنَ الطَّائِفِ فَأَخَّرَ صَلاَۃَ الْمَغْرِبِ ، ثُمَّ نَزَلَ فَجَمَعَ بَیْنَ َالْعِشَائِ والْمَغْرِبِ۔","","Musannaf Ibn Abi Shaybah 8318","","","كتاب الجمعة"
"8319","(۸۳۱۹) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : خَرَجْتُ أَنَا وَسَعْدٌ إلَی مَکَّۃَ ، فَکَانَ یَجْمَعُ بَیْنَ الصَّلاَتَیْنِ بَیْنَ الظُّہْرِ وَالْعَصْرِ یُؤَخِّرُ مِنْ ہَذِہِ وَیُعَجِّلُ مِنْ ہَذِہِ وَیُصَلِّیہِمَا جَمِیعًا وَیُؤَخِّرُ الْمَغْرِبَ وَیُعَجِّلُ الْعِشَائَ ، ثُمَّ یُصَلِّیہِمَا جَمِیعًا حَتَّی قَدِمْنَا مَکَّۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 8319","","","كتاب الجمعة"
"8320","(۸۳۲۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ حَبِیبِ بْنِ شِہَابٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی مُوسَی ، قَالَ : صَحِبْتُہُ فِی سَفَرٍ ، فَکَانَ یَجْمَعُ بَیْنَ الظُّہْرِ وَالْعَصْرِ وَبَیْنَ الْمَغْرِبِ وَالْعِشَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 8320","","","كتاب الجمعة"
"8321","(۸۳۲۱) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : سَافَرْتُ مَعَ أُسَامَۃَ بْنِ زَیْدٍ ، وَسَعِیدِ بْنِ زَیْدٍ وَکَانَا یَجْمَعَانِ بَیْنَ الظُّہْرِ وَالْعَصْرِ وَالْمَغْرِبِ وَالْعِشَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 8321","","","كتاب الجمعة"
"8322","(۸۳۲۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَبْدِ الْجَلِیلِ بْنِ عَطِیَّۃَ ، قَالَ : سَافَرْتُ مَعَ جَابِرِ بْنِ زَیْدٍ ، فَکَانَ یَجْمَعُ بَیْنَ الصَّلاَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 8322","","","كتاب الجمعة"
"8323","(۸۳۲۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُغِیرَۃُ بْنُ زِیَادٍ ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُؤَخِّرُ الظُّہْرَ وَیُعَجِّلُ الْعَصْرَ وَیُؤَخِّرُ الْمَغْرِبَ وَیُعَجِّلُ الْعِشَائَ فِی السَّفَرِ۔","","Musannaf Ibn Abi Shaybah 8323","","","كتاب الجمعة"
"8324","(۸۳۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی قَیْسٍ ، عَنْ ہُذَیْلِ بْنِ شُرَحْبِیلَ الأَوْدِیِّ ، قَالَ : جَمَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیْنَ الظُّہْرِ وَالْعَصْرِ وَالْمَغْرِبِ وَالْعِشَائِ فِی السَّفَرِ۔ (طیالسی ۳۷۶)","","Musannaf Ibn Abi Shaybah 8324","","","كتاب الجمعة"
"8325","(۸۳۲۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ بْنِ عُمَیْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ ، قَالَ : مَا رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی صَلاَۃً إِلاَّ لِوَقْتِہَا إِلاَّ الْعِشَائَ وَالْمَغْرِبَ فَإِنَّہُ جَمَعَہُمَا یَوْمَئِذٍ بِجَمْعٍ ، وَصَلَّی الْفَجْرَ یَوْمَئِذٍ قَبْلَ مِیقَاتِہَا۔ (بخاری ۱۶۸۲۔ ابوداؤد ۱۹۲۹)","Sahih","Musannaf Ibn Abi Shaybah 8325","","","كتاب الجمعة"
"8326","(۸۳۲۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْجُرَیرِیِّ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : کَانَ أُسَامَۃُ بْنُ زَیْدٍ إذَا عَجِلَ بِہِ السَّیْرُ جَمَعَ بَیْنَ الصَّلاَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 8326","","","كتاب الجمعة"
"8327","(۸۳۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، قَالَ : سَأَلْتُ عَطَائً عَنْ تَأْخِیرِ الظُّہْرِ وَالْمَغْرِبِ فِی السَّفَرِ، فَلَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 8327","","","كتاب الجمعة"
"8328","(۸۳۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ زَیْدٍ أَبِی أُسَامَۃَ ، قَالَ : سَأَلْتُ مُجَاہِدًا عَنْ تَأْخِیرِ الْمَغْرِبِ وَتَعْجِیلِ الْعِشَائِ فِی السَّفَرِ ، فَلَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 8328","","","كتاب الجمعة"
"8329","(۸۳۲۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : جَمَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیْنَ الصَّلاَتَیْنِ فِی غَزْوَۃِ بَنِی الْمُصْطَلِقِ۔ (احمد ۱۷۹)","","Musannaf Ibn Abi Shaybah 8329","","","كتاب الجمعة"
"8330","(۸۳۳۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عُمَرَ بْنِ عَلِیٍّ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ : أَنَّ عَلِیًّا کَانَ یُصَلِّی الْمَغْرِبَ فِی السَّفَرِ ، ثُمَّ یَتَعَشَّی ، ثُمَّ یُصَلِّی الْعِشَائَ عَلَی إثْرِہَا ، ثُمَّ یَقُولُ : ہَکَذَا رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَصْنَعُ۔ (ابوداؤد ۱۲۲۷۔ نسائی ۱۵۷۱)","Hasan","Musannaf Ibn Abi Shaybah 8330","","","كتاب الجمعة"
"8331","(۸۳۳۱) حَدَّثَنَا بَکْرُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ : حدَّثَنَا عِیسَی بْنُ الْمُخْتَارِ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ أَبِی قَیْسٍ ، عَنْ ہُزَیْلٍ ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَمَعَ بَیْنَ الصَّلاَتَیْنِ فِی السَّفَرِ۔ (طبرانی ۹۸۸۱۔ ابو یعلی ۵۴۱۳)","Da'if","Musannaf Ibn Abi Shaybah 8331","","","كتاب الجمعة"
"8332","(۸۳۳۲) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ الأَسْوَدُ وَأَصْحَابُہُ یَنْزِلُونَ عِنْدَ وَقْتِ کُلِّ صَلاَۃٍ فِی السَّفَرِ فَیُصَلُّونَ الْمَغْرِبَ لِوَقْتِہَا، ثُمَّ یَتَعَشَّوْنَ، ثُمَّ یَمْکُثُونَ سَاعَۃً، ثُمَّ یُصَلُّونَ الْعِشَائَ۔","","Musannaf Ibn Abi Shaybah 8332","","","كتاب الجمعة"
"8333","(۸۳۳۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أُبَیِّ بْنِ عَبْدِ اللہِ ، قَالَ : جَائَنَا کِتَابُ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ : أنْ لاَ تَجْمَعُوا بَیْنَ الصَّلاَتَیْنِ إِلاَّ مِنْ عُذْرٍ۔","","Musannaf Ibn Abi Shaybah 8333","","","كتاب الجمعة"
"8334","(۸۳۳۴) حَدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَنْ یُونُسَ ، قَالَ : سُئِلَ الْحَسَنُ عَنْ جَمْعِ الصَّلاَتَیْنِ فِی السَّفَرِ ، فَکَانَ لاَ یُعْجِبُہُ ذَلِکَ إِلاَّ مِنْ عُذْرٍ۔","","Musannaf Ibn Abi Shaybah 8334","","","كتاب الجمعة"
"8335","(۸۳۳۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ : أَنَّ الأَسْوَدَ کَانَ یَنْزِلُ لِوَقْتِ الصَّلاَۃ فِی السَّفَرِ وَلَوْ عَلَی حَجَرٍ۔","","Musannaf Ibn Abi Shaybah 8335","","","كتاب الجمعة"
"8336","(۸۳۳۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عُمَارَۃَ ، عَنِ الأَسْوَدِ ، قَالَ : مَا کَانَ إِلاَّ رَاہِبًا إذَا جَائَ وَقْتُ الصَّلاَۃ نَزَلَ وَلَوْ عَلَی حَجَرٍ۔","","Musannaf Ibn Abi Shaybah 8336","","","كتاب الجمعة"
"8337","(۸۳۳۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو ہِلاَلٍ ، عَنْ حَنْظَلَۃَ السَّدُوسِیِّ ، عَنْ أَبِی مُوسَی ، قَالَ : الْجَمْعُ بَیْنَ الصَّلاَتَیْنِ مِنْ غَیْرِ عُذْرٍ مِنَ الْکَبَائِرِ۔","Da'if","Musannaf Ibn Abi Shaybah 8337","","","كتاب الجمعة"
"8338","(۸۳۳۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ ہِشَامِ بْنِ حَسَّانَ ، عَنْ رَجُلٍ ، عَنْ أَبِی الْعَالِیَۃِ ، عَنْ عُمَرَ ، قَالَ: الْجَمْعُ بَیْنَ الصَّلاَتَیْنِ مِنْ غَیْرِ عُذْرٍ مِنَ الْکَبَائِرِ۔","Da'if","Musannaf Ibn Abi Shaybah 8338","","","كتاب الجمعة"
"8339","(۸۳۳۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُبَیدُ اللہِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ مَوْہَبٍ ، قَالَ : أَتَیْتُُ سَالِمًا فَقُلْتُ یَا أَبَا عُمَرَ تَجْمَعُ بَیْنَ الصَّلاَتَیْنِ فِی السَّفَرِ ؟ فَقَالَ : لاَ إِلاَّ أَنْ یَعْجَلَنِی سَیْرٌ۔","","Musannaf Ibn Abi Shaybah 8339","","","كتاب الجمعة"
"8340","(۸۳۴۰) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : ذُکِرَ لِمُحَمَّدِ بْنِ سِیرِینَ أَنَّ جَابِرَ بْنَ زَیْدٍ یَجْمَعُ بَیْنَ الصَّلاَتَیْنِ ، فَقَالَ : مَا أَرَی أَنْ یَجْمَعَ بَیْنَ الصَّلاَتَیْنِ إِلاَّ مِنْ أَمْرٍ۔","","Musannaf Ibn Abi Shaybah 8340","","","كتاب الجمعة"
"8341","(۸۳۴۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ ، قَالاَ : مَا نَعْلَمُ مِنَ السُّنَّۃِ الْجَمْعَ بَیْنَ الصَّلاَتَیْنِ فِی حَضَرٍ وَلاَ سَفَرٍ إِلاَّ بَیْنَ الظُّہْرِ وَالْعَصْرِ بِعَرَفَۃَ وَبَیْنَ الْمَغْرِبِ وَالْعِشَائِ بِجَمْعٍ۔","Hasan","Musannaf Ibn Abi Shaybah 8341","","","كتاب الجمعة"
"8342","(۸۳۴۲) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ : أَنَّ رَجُلاً جَائَ إلی سَعِیدِ بْنَ الْمُسَیَّبِ ، فَقَالَ: إنِّی رَاعِی إبِلٍ أَطلُبہَا حَتَّی إذَا أَمْسَیْتُ صَلَّیْتُ الْمَغْرِبَ ، ثُمَّ طَرَحْتُ نَفْسِی فَرَقَدْتُ عَنِ الْعَتَمَۃِ ، فَقَالَ : لاَ تَنَمْ حَتَّی تُصَلِّیَہَا ، فَإِنْ خِفْتَ أَنْ تَرْقُدَ فَاجْمَعْ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 8342","","","كتاب الجمعة"
"8343","(۸۳۴۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ یَعْقُوبَ ، عَنْ عَطَائٍ ، وَعَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ فِی الْمَرِیضِ یُصَلِّی ، قَالاَ : إِنْ شَائَ جَمَعَ بَیْنَ الصَّلاَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 8343","","","كتاب الجمعة"
"8344","(۸۳۴۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ یَعْقُوبَ ، عَنْ عَطَائٍ فِی الرَّاعِی یَقْصُرُ ، قَالَ : إنَّمَا یَقْصُرُ الْمُسَافِرُ۔","","Musannaf Ibn Abi Shaybah 8344","","","كتاب الجمعة"
"8345","(۸۳۴۵) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ عَطَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، وَأَبِی الْبَخْتَرِیِّ ، قَالَ : أَظُنُّ فِیہِ وَأَصْحَابِہِمْ قَالُوا : إذَا الْتَقَی الزَّحْفَانِ وَضَرَبَ النَّاسُ بَعْضُہُمْ بَعْضًا وَحَضَرَتِ الصَّلاَۃُ فَقُلْ : سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلاَ إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ فَتِلْکَ صَلاَتُکَ ، ثُمَّ لاَ تُعِدْ۔","","Musannaf Ibn Abi Shaybah 8345","","","كتاب الجمعة"
"8346","(۸۳۴۶) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ وَالْحَکَمِ ، قَالاَ : إذَا کَانَ عِنْدَ الطِّرَادِ وَعِنْدَ سَلِّ السُّیُوفِ أَجْزَأَ الرَّجُلَ أَنْ تَکُونَ صَلاَتُہُ تَکْبِیرًا ، فَإِنْ لَمْ یَکُنْ إِلاَّ تَکْبِیرَۃٌ وَاحِدَۃٌ أَجْزَأَتْہُ أَیْنَمَا کَانَ وَجْہُہُ۔","","Musannaf Ibn Abi Shaybah 8346","","","كتاب الجمعة"
"8347","(۸۳۴۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : فِی قولہ تعالی : {فَإِنْ خِفْتُمْ فَرِجَالاً ، أَوْ رُکْبَانًا} قَالَ : إذَا حَضَرَتِ الصَّلاَۃ فِی الْمُطَارَدَۃِ فَأَوْمِ حَیْثُ کَانَ وَجْہُکَ وَاجْعَلِ السُّجُودَ أَخْفَضَ مِنَ الرُّکُوعِ۔","","Musannaf Ibn Abi Shaybah 8347","","","كتاب الجمعة"
"8348","(۸۳۴۸) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ أَبِی مَسْلَمَۃَ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ جَابِرِ بْنِ غُرَابٍ وَکَانَ سَیِّدَ النَّمِر ، قَالَ : کُنَّا مَعَ ہَرِمِ بْنِ حَیَّانَ فِی جَیْشٍ نُقَاتِلُ الْعَدُوَّ ، فَقَالَ ہَرِمٌ : لیَسْجُدُ کُلُّ رَجُلٍ مِنْکُمْ سَجْدَۃً تَحْتَ جُنَّتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 8348","","","كتاب الجمعة"
"8349","(۸۳۴۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، سُئِلَ عَنِ الرَّجُلِ إذَا حَضَرَتِ الْمُسَایَفَۃُ کَیْفَ یُصَلِّی ؟ فَقَالَ : یُصَلِّی رَکْعَۃً وَسَجْدَتَیْنِ تِلْقَائَ وَجْہِہِ۔","","Musannaf Ibn Abi Shaybah 8349","","","كتاب الجمعة"
"8350","(۸۳۵۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنْ صَلاَۃِ الْمُسَایَفَۃِ ، فَقَالاَ : رَکْعَۃً حَیْثُ کَانَ وَجْہُہُ یُومِیئُ إیمَائً۔","","Musannaf Ibn Abi Shaybah 8350","","","كتاب الجمعة"
"8351","(۸۳۵۱) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا شُعْبَۃُ عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : الصَّلاَۃ عِنْد الْمُسَایَفَۃِ رَکْعَۃً یُومِیئُ إیمَائً حَیْثُ کَانَ وَجْہُہُ۔","","Musannaf Ibn Abi Shaybah 8351","","","كتاب الجمعة"
"8352","(۸۳۵۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : تُجْزِئہ تَکْبِیرَۃٌ عِنْدَ السَّلَّۃِ إذَا لَمْ یَسْتَطِعْ۔","","Musannaf Ibn Abi Shaybah 8352","","","كتاب الجمعة"
"8353","(۸۳۵۳) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ کَانَ یَقُولُ فِی صَلاَۃِ الْمُسَایَفَۃِ : یُومِئُ إیمَائً حَیْثُ کَانَ وَجْہُہُ۔","","Musannaf Ibn Abi Shaybah 8353","","","كتاب الجمعة"
"8354","(۸۳۵۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : تَکْبِیرَتَیْنِ عِنْدَ الْمُسَایَفَۃِ۔","","Musannaf Ibn Abi Shaybah 8354","","","كتاب الجمعة"
"8355","(۸۳۵۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : الصَّلاَۃ عِنْدَ الْمُسَایَفَۃِ رَکْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 8355","","","كتاب الجمعة"
"8356","(۸۳۵۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، عَنْ رَجَائِ بْنِ حَیْوَۃَ الْکِنْدِیِّ ، قَالَ : کَانَ ثَابِتُ بْنُ السِّمْطِ ، أَوِ السِّمْطُ بْنُ ثَابِتٍ فِی مَسِیرٍ فِی خَوْفٍ فَحَضَرَتِ الصَّلاَۃ فَصَلَّوْا رُکْبَانًا فَنَزَلَ الأَشْتَرُ ، فَقَالَ : مَا لَہُ ؟ قَالُوا : نَزَلَ فَصَلَّی ، قَالَ : مَا لَہُ خَالَفَ خُولِفَ بِہِ۔","","Musannaf Ibn Abi Shaybah 8356","","","كتاب الجمعة"
"8357","(۸۳۵۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی بَکْرٍ بْنِ أَبِی الْجَہْمِ بن صُخَیْرٍ الْعَدَوِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلاَۃَ الْخَوْفِ بِذِی قَرَدٍ أَرْضٍ مِنْ أَرْضِ بَنِی سُلَیْمٍ ، فَصَفَّ النَّاسُ خَلفَہُ صَفَّیْنِ ، صَفٌّ خَلْفَہُ ، وَصَفٌّ مُوَاز الْعَدُوِّ ، فَصَلَّی بِالصَّفِّ الَّذِی یَلِیہِ رَکْعَۃً ، ثُمَّ نَکَصَ ہَؤُلاَئِ إلَی مَصَافِّ ہَؤُلاَئِ وَہَؤُلاَئِ إلَی مَصَافِّ ہَؤُلاَئِ فَصَلَّی بِہِمْ رَکْعَۃً۔ (احمد ۱/۲۳۲۔ عبدالرزاق ۳۵۷)","Sahih","Musannaf Ibn Abi Shaybah 8357","","","كتاب الجمعة"
"8358","(۸۳۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الرُّکَیْنِ الْفَزَارِیِّ ، عَنِ الْقَاسِمِ بْنِ حَسَّانَ ، عَنْ زَیْدِ بْنِ ثَابِتٍ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی صَلاَۃَ الْخَوْفِ۔n قَالَ سُفْیَانُ فَذَکَرَ مِثْلَ حَدِیثِ ابْنِ عَبَّاسٍ۔ (نسائی ۱۹۱۹۔ ابن خزیمۃ ۱۳۴۵)","Hasan","Musannaf Ibn Abi Shaybah 8358","","","كتاب الجمعة"
"8359","(۸۳۵۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَشْعَثَ بن أَبِی الشَّعْثَائِ ، عَنِ الأَسْوَدِ بْنِ ہِلاَلٍ ، عَنْ ثَعْلَبَۃَ بْنِ زَہْدَمٍ الْحَنْظَلِیِّ ، قَالَ : کُنَّا مَعَ سَعِیدِ بْنِ الْعَاصِ بِطَبَرِسْتَانَ وَمَعَنَا حُذَیْفَۃُ ، فَقَالَ سَعِیدٌ : أَیُّکُمْ صَلَّی مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلاَۃَ الْخَوْفِ ؟ فَقَالَ : حُذَیْفَۃُ : أَنَا ، قَالَ : فَقَامَ فَصَلَّی بِالنَّاسِ۔n قَالَ سُفْیَانُ : فَذَکَرَ مِثْلَ حَدِیثِ ابْنِ عَبَّاسٍ وَزَیْدِ بْنِ ثَابِتٍ۔ (ابوداؤد ۱۲۴۰۔ احمد ۵/۳۹۹)","Sahih","Musannaf Ibn Abi Shaybah 8359","","","كتاب الجمعة"
"8360","(۸۳۶۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ: حدَّثَنَا سَعِیدٌ، عَنْ قَتَادَۃَ، عَنْ أَبِی الْعَالِیَۃِ الرِّیَاحِیِّ: أَنَّ أَبَا مُوسَی الأَشْعَرِِی کَانَ بِالدَّارِ مِنْ أَصْبَہَانَ وَمَا بِہِمْ یَوْمَئِذٍ کَثِیرُ خَوْفٍ وَلَکِنْ أَحَبَّ أَنْ یُعَلِّمَہُمْ دِینَہُمْ وَسُنَّۃَ نَبِیِّہِمْ فَجَعَلَہُمْ صَفَّیْنِ ، طَائِفَۃٌ مَعَہَا السِّلاَحُ مُقْبِلَۃٌ عَلَی عَدُوِّہَا وَطَائِفَۃٌ وَرَائَہَا ، فَصَلَّی بِالَّذِینَ یَلُونَہ رَکْعَۃً ، ثُمَّ نَکَصُوا عَلَی أَدْبَارِہِمْ حَتَّی قَامُوا مَقَامَ الأَخَرِینَ یَتَخَلَّلُونَہُمْ حَتَّی قَامُوا وَرَائَہُ فَصَلَّی بِہِمْ رَکْعَۃً أُخْرَی ، ثُمَّ سَلَّمَ ، فَقَامَ الَّذِینَ یَلُونَ وَالأَخَرُونَ فَصَلَّوْا رَکْعَۃً رَکْعَۃً فَسَلَّمَ بِہِمْ بَعْضُہُمْ عَلَی بَعْضٍ فَتَمَّتْ لِلإِمَامِ رَکْعَتَانِ فِی جَمَاعَۃٍ وَلِلنَّاسِ رَکْعَۃٌ رَکْعَۃٌ۔ (طبرانی ۱۹۷۔ بیہقی ۲۵۳)","","Musannaf Ibn Abi Shaybah 8360","","","كتاب الجمعة"
"8361","(۸۳۶۱) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ خُصَیْفٍ ، عَنْ أَبِی عُبَیْدَۃَ ، عَن عَبد اللہ ، قَالَ : صَلَّی بِنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلاَۃَ الْخَوْفِ فَقَامُوا صَفَّیْنِ صَفٌّ خَلْفَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَصَفٌّ مُسْتَقْبِلٌ الْعَدُوَّ فَصَلَّی بِہِمْ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَکْعَۃً وَجَائَ الأَخَرُونَ فَقَامُوا مَقَامَہُمْ وَاسْتَقْبَلَ ہَؤُلاَئِ الْعَدُوَّ فَصَلَّی بِہِمْ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَکْعَۃً ، ثُمَّ سَلَّمَ فَقَامَ ہَؤُلاَئِ فَصَلَّوْا لأَنْفُسِہِمْ رَکْعَۃً ، ثُمَّ سَلَّمُوا ، ثُمَّ ذَہَبُوا فَقَامُوا مَقَامَ أُولَئِکَ مُسْتَقْبِلَ الْعَدُوِّ وَرَجَعَ أُولَئِکَ إلَی مَقَامِہِمْ فَصَلَّوْا لأَنْفُسِہِمْ رَکْعَۃً، ثُمَّ سَلَّمُوا۔ (ابوداؤد ۱۲۳۷۔ احمد ۳۷۵)","Da'if","Musannaf Ibn Abi Shaybah 8361","","","كتاب الجمعة"
"8362","(۸۳۶۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ یَزِیدَ الْفَقِیرِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی بِہِمْ صَلاَۃَ الْخَوْفِ فَقَامَ صَفٌّ بَیْنَ یَدَیْہِ وَصَفٌّ خَلْفَہُ فَصَلَّی بِہِمْ وَجَائَ أُولَئِکَ حَتَّی قَامُوا مَقَامَ ہَؤُلاَئِ فَصَلَّی بِہِمْ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَکْعَۃً وَسَجْدَتَیْنِ ، ثُمَّ سَلَّمَ فَکَانَتْ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَکْعَتَانِ وَلَہُمْ رَکْعَۃٌ رَکْعَۃٌ۔ (نسائی ۱۹۳۳۔ احمد ۳/۲۹۸)","Sahih","Musannaf Ibn Abi Shaybah 8362","","","كتاب الجمعة"
"8363","(۸۳۶۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُمَرُ بْنُ ذَرٍّ سَمِعَہُ مِنْ مُجَاہِدٍ قَالَ : کَانَ رَسُولُ اللہِ بِعُسْفَانَ وَالْمُشْرِکُونَ بِضَجِنَانَ ، فَلَمَّا صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الظُّہْرَ رَآہُ الْمُشْرِکُونَ یَرْکَعُ وَیَسْجُدُ فَائْتَمَرُوا أَنْ یُغِیرُوا عَلَیْہِ ، فَلَمَّا حَضَرَتِ الْعَصْرُ صَفَّ النَّاسُ خَلْفَہُ صَفَّیْنِ فَکَبَّرَ وَکَبَّرُوا جَمِیعًا وَرَکَعَ وَرَکَعُوا جَمِیعًا وَسَجَدَ وَسَجَدَ الصَّفُّ الَّذِینَ یَلُونَہُ وَقَامَ الصَّفُّ الثَّانِی الَّذِینَ بِسِلاَحِہِمْ مُقْبِلِینَ عَلَی الْعَدُوِّ بِوُجُوہِہِمْ ، فَلَمَّا رَفَعَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأْسَہُ سَجَدَ الصَّفُّ الثَّانِی ، فَلَمَّا رَفَعُوا رُؤُوسَہُمْ رَکَعَ وَرَکَعُوا جَمِیعًا وَسَجَدَ وَسَجَدَ الصَّفُّ الَّذِینَ یَلُونَہُ وَقَامَ الصَّفُّ الثَّانِی بِسِلاَحِہِمْ مُقْبِلِینَ عَلَی الْعَدُوِّ بِوُجُوہِہِمْ ، فَلَمَّا رَفَعَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأْسَہُ سَجَدَ الصَّفُّ الثَّانِی۔n قَالَ: قَالَ مُجَاہِدٌ، فَکَانَ تَکْبِیرُہُمْ وَرُکُوعُہُمْ وَتَسْلِیمُہُ عَلَیْہِمْ سَوَائً وَتَنَاصَفُوا فِی السُّجُودِ۔ قَالَ: قَالَ مُجَاہِدٌ فَلَمْ یُصَلِّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلاَۃَ الْخَوْفِ قَبْلَ یَوْمِہِ، وَلاَ بَعْدَہُ۔(عبدالرزاق ۴۲۳۵)","","Musannaf Ibn Abi Shaybah 8363","","","كتاب الجمعة"
"8364","(۸۳۶۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنْ أَبِی عَیَّاشٍ الزُّرَقِیِّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوٍ مِنْ حَدِیثِ عُمَرَ بْنِ ذَرٍّ۔ (ابوداؤد ۱۲۲۹۔ ابن حبان ۲۸۷۶)","Sahih","Musannaf Ibn Abi Shaybah 8364","","","كتاب الجمعة"
"8365","(۸۳۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوٍ مِنْ حَدِیثِ مُجَاہِدٍ ، وَزَادَ فِیہِ کَمَا یَفْعَلُ حَرَسُکُمْ ہَؤُلاَئِ بِأُمَرَائِہِمْ۔ (مسلم ۳۰۸۔ احمد ۳/۳۷۴)","Sahih","Musannaf Ibn Abi Shaybah 8365","","","كتاب الجمعة"
"8366","(۸۳۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی بِہِمْ رَکْعَتَیْنِ فَکَانَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَکْعَتَانِ وَلَہُمْ رَکْعَۃٌ رَکْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 8366","","","كتاب الجمعة"
"8367","(۸۳۶۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ وَمِسْعَرٌ ، عَنْ یَزِیدَ الْفَقِیرِ ، عَنْ جَابِرِ بْنِ عَبْد اللہِ ، قَالَ : صَلاَۃُ الْخَوْفِ رَکْعَۃٌ رَکْعَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 8367","","","كتاب الجمعة"
"8368","(۸۳۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی عَوَانَۃَ ، عَنْ بُکَیْرِ بْنِ الأَخْنَسِ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : فَرَضَ اللَّہُ تَعَالی صَلاَۃَ الْحَضَرِ أَرْبَعَۃً وَالسَّفَرِ رَکْعَتَیْنِ وَالْخَوْفِ رَکْعَۃً عَلَی لِسَانِ نَبِیِّکُمْ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (مسلم ۴۷۹۔ ابوداؤد ۱۲۴۱)","Sahih","Musannaf Ibn Abi Shaybah 8368","","","كتاب الجمعة"
"8369","(۸۳۶۹) حَدَّثَنَا قَاسِمُ بْنُ مَالِکٍ ، عَنْ أَیُّوبَ بْنِ عَائِذٍ ، عَنْ بُکَیرِ بْنِ الأَخْنَسِ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: فَرَضَ اللَّہُ صَلاَۃَ الْحَضَرِ أَربَعًا وَصَلاَۃَ السَّفَرِ رَکْعَتَیْنِ وَالْخَوْفِ رَکْعَۃً عَلَی لِسَانِ نَبِیِّہِ ، أَوَ قَالَ نَبِیِّکُمْ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (مسلم ۴۷۹۔ احمد ۱/۲۴۳)","Sahih","Musannaf Ibn Abi Shaybah 8369","","","كتاب الجمعة"
"8370","(۸۳۷۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُوسَی بْنِ عُقْبَۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلاَۃَ الْخَوْفِ فِی بَعْضِ أَیَّامِہِ فَقَامَتْ طَائِفَۃٌ مَعَہُ وَطَائِفَۃٌ بِإِزَائِ الْعَدُوِّ ، فَصَلَّی بِالَّذِینَ مَعَہُ رَکْعَۃً ، ثُمَّ ذَہَبُوا وَجَائَ الأَخَرُونَ فَصَلَّی بِہِمْ رَکْعَۃً ، ثُمَّ قَضَتِ الطَّائِفَتَانِ رَکْعَۃً رَکْعَۃً۔n قَالَ : وَقَالَ ابْنُ عُمَرَ إذَا کَانَ خَوْفٌ أَکْبَرُ مِنْ ذَلِکَ فَصَلِّ رَاکِبًا ، أَوْ قَائِمًا تُومِیئُ إیمَائً۔ (بخاری ۹۴۳۔ مسلم ۳۰۶)","Sahih","Musannaf Ibn Abi Shaybah 8370","","","كتاب الجمعة"
"8371","(۸۳۷۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : صَلَّیْت صَلاَۃَ الْخَوْفِ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَکْعَتَیْنِ رَکْعَتَیْنِ إِلاَّ الْمَغْرِبَ ، فَإِنَّہُ صَلاَّہَا ثَلاَثًا۔","Da'if","Musannaf Ibn Abi Shaybah 8371","","","كتاب الجمعة"
"8372","(۸۳۷۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ سُئِلَ عَنْ صَلاَۃِ الْخَوْفِ ، فَقَالَ : نُبِّئْت عَنْ جَابِرِ بْنِ عَبْدِ اللہِ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی بِأَصْحَابِہِ فَصَلَّی بِطَائِفَۃٍ مِنْہُمْ وَطَائِفَۃٌ مُوَاجِہَۃُ الْعَدُوِّ فَصَلَّی بِہِمْ رَکْعَتَیْنِ ، ثُمَّ قَامُوا مَقَامَ الأَخَرِینَ فَجَائَ الأَخَرُونَ فَصَلَّوا فَصَلَّی بِہِمْ رَکْعَتَیْنِ ، ثُمَّ سَلَّمَ۔ (نسائی ۱۹۴۲۔ بیہقی ۲۵۹)","Da'if","Musannaf Ibn Abi Shaybah 8372","","","كتاب الجمعة"
"8373","(۸۳۷۳) حَدَّثَنَا عَفَّانُ ، قَالَ : أَبَانُ بْنُ زَیْدٍ قَالَ : حَدَّثَنَا یَحْیَی بْنُ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ ، عَنْ جَابِرِ بنِ عَبْدِ اللہِ ، قَالَ : أَقْبَلْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی إذَا کُنَّا بِذَاتِ الرِّقَاعِ نُودِیَ بِالصَّلاَۃ فَصَلَّی بِطَائِفَۃٍ رَکْعَتَیْنِ ، ثُمَّ تَأَخَّرُوا وَصَلَّی بِالطَّائِفَۃِ الأُخْرَی رَکْعَتَیْنِ ، قَالَ : فَکَانَتْ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَرْبَعُ رَکَعَاتٍ ، وَلِلْقَوْمِ رَکْعَتَانِ۔ (مسلم ۳۱۱۔ ابن حبان ۲۸۸۴)","Sahih","Musannaf Ibn Abi Shaybah 8373","","","كتاب الجمعة"
"8374","(۸۳۷۴) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سُلَیْمِ بْنِ عَبْدٍ ، عَنْ حُذَیْفَۃَ ، قَالَ : صَلاَۃُ الْخَوْفِ رَکْعَتَانِ وَأَرْبَعُ سَجَدَاتٍ ، فَإِنْ أَعْجَلَکَ الْعَدُوُّ فَقَدْ حَلَّ لَکَ الْقِتَالُ وَالْکَلاَمُ بَیْنَ الرَّکْعَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 8374","","","كتاب الجمعة"
"8375","(۸۳۷۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سُلَیْمِ بْنِ عَبْدٍ السَّلُولِیِّ ، عَنْ حُذَیْفَۃَ قَالَ : إِنْ ہَاجَ بِکَ ہَیجٌ فَقَد حَلَّ لَکَ الْقِتَالُ وَالْکَلاَمُ ، یَعْنِی فِی الصَّلاَۃ۔","Da'if","Musannaf Ibn Abi Shaybah 8375","","","كتاب الجمعة"
"8376","(۸۳۷۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّ أَبَا مُوسَی صَلَّی بِأَصْحَابِہِ بِأَصْبَہَانَ فَصَلَّتْ طَائِفَۃٌ مِنْہُمْ مَعَہُ وَطَائِفَۃٌ مُوَاجِہَۃُ الْعَدُوِّ فَصَلَّی بِہِمْ رَکْعَۃً ، ثُمَّ نَکَصُوا وَأَقْبَلَ الأَخَرُونَ یَتَخَلَّلُونَہُمْ فَصَلَّی بِہِمْ رَکْعَۃً ، ثُمَّ سَلَّمَ وَقَامَتِ الطَّائِفَتَانِ فَصَلَّتَا رَکْعَۃً رَکْعَۃً۔","Hasan","Musannaf Ibn Abi Shaybah 8376","","","كتاب الجمعة"
"8377","(۸۳۷۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی الزُّبَیْرِ ، سَمِعَ جَابِرًا یَقُولُ : سُئِلَ عَنْ صَلاَۃِ الْخَوْفِ ؟ فَقَالَ : کَمَا یَصْنَعُ أُمَرَاؤُکُمْ ہَؤُلاَئِ۔","Sahih","Musannaf Ibn Abi Shaybah 8377","","","كتاب الجمعة"
"8378","(۸۳۷۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : سَمِعْتُہُ یُحَدِّثُ ، عَنْ أَبِی عَیَّاشٍ الزُّرَقِیِّ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ مُصَافَّ الْعَدُوِّ بِعُسْفَانَ وَعَلَی الْمُشْرِکِینَ خَالِدُ بْنُ الْوَلِیدِ ، فَصَلَّی بِہِمُ النَّبِیُّ صَلَّی الل[corrupt]َہُ عَلَیْہِ وَسَلَّمَ الظُّہْرَ ، ثُمَّ قَالَ الْمُشْرِکُونَ : إنَّ لَہُمْ صَلاَۃً بَعْدَ ہَذِہِ ہِیَ أَحَبُّ إلَیْہِمْ مِنْ أَمْوَالِہِمْ وَأَبْنَائِہِمْ ، قَالَ : فَصَلَّی بِہِمْ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَصَفَّہُمْ خَلْفَہُ صَفَّیْنِ ، قَالَ : فَرَکَعَ بِہِمْ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَمِیعًا ، فَلَمَّا رَفَعُوا رُؤُوسَہُمْ سَجَدَ الصَّفُّ الَّذِی یَلِیہِ وَقَامَ الأَخَرُونَ ، فَلَمَّا رَفَعُوا رُؤُوسَہُمْ مِنَ السُّجُودِ سَجَدَ الصَّفُّ الْمُؤَخَّرُ لِرُکُوعِہِمْ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : ثُمَّ تَأَخَّرَ الصَّفُّ الْمُقَدَّمُ وَتَقَدَّمَ الصَّفُّ الْمُؤَخَّرُ لِرُکُوعِہِمْ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ تَأَخَّرَ الصَّفُّ الْمُؤَخَّرُ وَتَقَدَّمَ الصَّفُّ الْمُقَدَّمُ فَقَامَ کُلُّ وَاحِدٍ مِنْہُمَا فِی مَقَامِ صَاحِبِہِ ، ثُمَّ رَکَعَ وَقَامَ الأَخَرُونَ ، فَلَمَّا فَرَغُوا مِنْ سُجُودِہِمْ سَجَدَ الأَخَرُونَ ، ثُمَّ سَلَّمَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَیْہِمْ۔ (نسائی ۱۹۳۷۔ احمد ۴/۶۰)","Sahih","Musannaf Ibn Abi Shaybah 8378","","","كتاب الجمعة"
"8379","(۸۳۷۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، عَنْ صَالِحِ بْنِ خَوَّاتٍ ، عَنْ سَہْلِ بْنِ أَبِی حَثْمَۃَ فِی صَلاَۃِ الْخَوْفِ ، قَالَ : یَقُومُ الإِمَام إلَی الْقِبْلَۃِ وَمَعَہُ طَائِفَۃٌ وَطَائِفَۃٌ مُوَاجِہَۃُ الْعَدُوِّ فَیُصَلی بِمَنْ مَعَہُ رَکْعَۃً فَإِذَا قَامَ وَقَفَ قَائمًا وَصَلَّی الَّذِینَ وَرَائَہُ لأَنْفُسِہِمْ رَکْعَۃً وَسَجَدُوا وَسَلَّمُوا ، ثُمَّ ذَہَبُوا حَتَّی یَقُومُوا مَقَامَ إخْوَانِہِمُ الَّذِینَ بِإِزَائِ الْعَدُوِّ وَرَجَعَ الأَخَرُونَ عَلَی أَعْقَابِہِمْ فَوَقَفُوا خَلْفَ الإِمَام فَصَلَّی بِہِمْ رَکْعَۃً أُخْرَی ، ثُمَّ سَلَّمَ وَقَامَ الَّذِینَ وَرَائَہُمْ فَرَکَعُوا لأَنْفُسِہِمْ وَسَجَدُوا وَسَلَّمُوا۔ (بخاری ۴۱۳۱۔ ابوداؤد ۱۲۳۲)","Sahih","Musannaf Ibn Abi Shaybah 8379","","","كتاب الجمعة"
"8380","(۸۳۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : رَکْعَۃٌ کَیْفَ تَکُونُ مَقْصُورَۃً وَہُمَا رَکْعَتَانِ۔","","Musannaf Ibn Abi Shaybah 8380","","","كتاب الجمعة"
"8381","(۸۳۸۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، أَنَّہُ قَالَ : صَلاَۃُ الْخَوْفِ یَقُومُ الإِمَام وَیَصُفُّونَ خَلْفَہُ صَفَّیْنِ ، ثُمَّ یَرْکَعُ الإِمَام فَیَرْکَعُ الَّذِینَ یَلُونَہُ ، ثُمَّ یَسْجُدُ بِالَّذِین یَلُونَہُ فَإِذَا قَامَ تَأَخَّرَ ہَؤُلاَئِ الَّذِینَ یَلُونَہُ وَجَائَ الأَخَرُونَ فَقَامُوا مَقَامَہُمْ فَرَکَعَ بِہِمْ وَسَجَدَ بِہِمْ وَالأَخَرُونَ قِیَامٌ ، ثُمَّ یَقُومُونَ فَیَقْضُونَ رَکْعَۃً رَکْعَۃً فَیَکُونُ لِلإِمَامِ رَکْعَتَانِ فِی جَمَاعَۃٍ وَیَکُونُ لِلْقَوْمِ رَکْعَۃٌ رَکْعَۃٌ فِی جَمَاعَۃٍ وَیَقْضُونَ الرَّکْعَۃَ الثَّانِیَۃَ۔","","Musannaf Ibn Abi Shaybah 8381","","","كتاب الجمعة"
"8382","(۸۳۸۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ یُوسُفَ بْنِ مِہْرَانَ ، عَنِ ابْنِ عَبَّاسٍ مِثْلَ ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 8382","","","كتاب الجمعة"
"8383","(۸۳۸۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی خَالِدٍ ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ، عَنْ أَبِی مَسْعُودٍ الأَنْصَارِیِّ عُقْبَۃَ بْنِ عَمْرٍو قَالَ : انْکَسَفَتِ الشَّمْسُ عَلَی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ النَّاسُ : إنَّمَا انْکَسَفَتْ لِمَوْتِ إبْرَاہِیمَ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ الشَّمْسَ وَالْقَمَرَ لاَ یَنْکَسِفَانِ لِمَوْتِ أَحَدٍ وَلاَ لِحَیَاتِہِ وَلَکِنَّہُمَا آیَتَانِ مِنْ آیَاتِ اللہِ فَإِذَا رَأَیْتُمُوہُمَا فَصَلُّوا۔ (بخاری ۱۰۴۱۔ مسلم ۲۳)","Sahih","Musannaf Ibn Abi Shaybah 8383","","","كتاب الجمعة"
"8384","(۸۳۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَاصِمٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنِ النُّعْمَانِ بْنِ بَشِیرٍ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی فِی کُسُوفٍ نَحْوًا مِنْ صَلاَتِکُمْ یَرْکَعُ وَیَسْجُدُ۔ (ابوداؤد ۱۱۸۶۔ احمد ۴/۲۶۷)","","Musannaf Ibn Abi Shaybah 8384","","","كتاب الجمعة"
"8385","(۸۳۸۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : انْکَسَفَتِ الشَّمْسُ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَامَ وَقُمْنَا مَعَہُ ، ثُمَّ قَالَ : یَا أَیُّہَا النَّاسُ إنَّ الشَّمْسَ وَالْقَمَرَ آیَتَانِ مِنْ آیَاتِ اللہِ فَإِذَا انْکَسَفَتْ إحْدَاہُمَا فَافْزَعُوا إلَی الْمَسَاجِدِ۔ (نسائی ۱۸۶۷)","Da'if","Musannaf Ibn Abi Shaybah 8385","","","كتاب الجمعة"
"8386","(۸۳۸۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، وَابْنُ نُمَیْرٍ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : صَلَّی بِنَا رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی کُسُوفِ الشَّمْسِ ، ثَمَانَ رَکَعَاتٍ فِی أَرْبَعِ سَجَدَاتٍ۔ (مسلم ۱۸۔ ابوداؤد ۱۱۷۶)","","Musannaf Ibn Abi Shaybah 8386","","","كتاب الجمعة"
"8387","(۸۳۸۷) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ طَاوُوسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ ، وَلَمْ یَذْکُرِ ابْنَ عَبَّاسٍ۔","","Musannaf Ibn Abi Shaybah 8387","","","كتاب الجمعة"
"8388","(۸۳۸۸) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : خُسِفَت الشَّمْسُ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَصَلَّی فَفَرَغَ مِنْ صَلاَتِہِ حِینَ تَجَلَّی عَنِ الشَّمْسِ فَحَمِدَ اللَّہَ وَأَثْنَی عَلَیْہِ ، ثُمَّ قَالَ : إنَّ الشَّمْسَ وَالْقَمَرَ آیَتَانِ مِنْ آیَاتِ اللہِ لاَ یَخْسِفَان لِمَوْتِ أَحَدٍ وَلاَ لِحَیَاتِہِ وَلَکِنَّہُمَا آیَتَانِ مِنْ آیَاتِ اللہِ فَإِذَا رَأَیْتُمُوہُمَا فَصَلُّوا وَتَصَدَّقُوا۔ (بخاری ۱۰۴۴۔ مسلم ۶۱۸)","Sahih","Musannaf Ibn Abi Shaybah 8388","","","كتاب الجمعة"
"8389","(۸۳۸۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِثْلَہُ ، إِلاَّ أَنَّ ابْنَ نُمَیْرٍ قَالَ : فَکَبِّرُوا وَادْعُوا۔ (مسلم ۶۱۸)","Sahih","Musannaf Ibn Abi Shaybah 8389","","","كتاب الجمعة"
"8390","(۸۳۹۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : أَخْبَرَنَا عَبْدُ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، قَالَ : انْکَسَفَتِ الشَّمْسُ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ مَاتَ إبْرَاہِیمُ بْنُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ النَّاسُ : إنَّمَا انْکَسَفَتِ الشَّمْسُ لِمَوْتِ إبْرَاہِیمَ ، فَقَامَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَصَلَّی بِالنَّاسِ سِتَّ رَکَعَاتٍ وَأَرْبَعَ سَجَدَاتٍ ، بَدَأَ فَکَبَّرَ ، ثُمَّ قَرَأَ فَأَطَالَ الْقِرَائَۃَ ، ثُمَّ رَکَعَ نَحْوًا مِمَّا قَامَ ، ثُمَّ رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ فَقَرَأَ قِرَائَۃً دُونَ القِرَائَۃ الأُولی ، ثُمَّ رَکَعَ نَحْوًا مِمَّا قَامَ ، ثُمَّ رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ ، فَقَرَأَ قِرَائَۃً دُونَ الثَانِیۃ ثُمَّ رَکَعَ نَحْوًا مِمَّا قَامَ ، ثُمَّ رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ ثُمَّ انْحَدَرَ بِالسُّجُودِ فَسَجَدَ سَجْدَتَیْنِ ، ثُمَّ قَامَ فَرَکَعَ أَیْضًا ثَلاَثَ رَکَعَاتٍ لَیْسَ مِنْہَا رَکْعَۃٌ إِلاَّ الَّتِی قَبْلَہَا أَطْوَلُ مِنَ الَّتِی بَعْدَہَا وَرُکُوعُہُ نَحْوًا مِنْ سُجُودِہِ ، ثُمَّ تَأَخَّرَ وَتَأَخَّرَتِ الصُّفُوفُ خَلْفَہُ حَتَّی انْتَہَی إلَی النِّسَائِ ، ثُمَّ تَقَدَّمَ وَتَقَدَّمَ النَّاسُ مَعَہُ حَتَّی قَامَ فِی مَقَامِہِ فَانْصَرَفَ حِینَ انْصَرَفَ وَقَدْ أَضَائَتِ الشَّمْسُ ، فَقَالَ : یَا أَیُّہَا النَّاسُ إنَّ الشَّمْسَ وَالْقَمَرَ آیَتَانِ مِنْ آیَاتِ اللہِ لاَ یَنْکَسِفَانِ لِمَوْتِ بَشَرٍ فَإِذَا رَأَیْتُمْ شَیْئًا مِنْ ذَلِکَ فَصَلُّوا حَتَّی تَنْجَلِیَ۔ (مسلم ۹۔ ابوداؤد ۱۱۷۲)","","Musannaf Ibn Abi Shaybah 8390","","","كتاب الجمعة"
"8391","(۸۳۹۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ السَّائِبِ بْنِ مَالِکٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ صَلَّی فِی کُسُوفِ الشَّمْسِ رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 8391","","","كتاب الجمعة"
"8392","(۸۳۹۲) حَدَّثَنَا ہُشَیْمٌ قَالَ: أَخْبَرَنَا یُونُسُ، عَنِ الْحَسَنِ: أَنَّ عَلِیًّا صَلَّی فِی الْکُسُوفِ عَشْرَ رَکَعَاتٍ بِأَرْبَعِ سَجَدَاتٍ۔","Sahih","Musannaf Ibn Abi Shaybah 8392","","","كتاب الجمعة"
"8393","(۸۳۹۳) حَدَّثَنَا غُنْدَرٌ ، عَنِ ابْنِ جُرَیْجٍ، عَنْ سُلَیْمَانَ الأَحْوَلِ، عَنْ طَاوُوس: أَنَّ الشَّمْسَ انْکَسَفَتْ عَلَی عَہْدِ ابْنِ عَبَّاسٍ فَصَلَّی عَلَی صُفَّۃِ زَمْزَمَ رَکْعَتَیْنِ فِی کُلِّ رَکْعَۃٍ أَرْبَعُ سَجَدَاتٍ۔","Sahih","Musannaf Ibn Abi Shaybah 8393","","","كتاب الجمعة"
"8394","(۸۳۹۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ، عَنْ أَبِی بَکْرَۃَ ، قَالَ : انْکَسَفَتِ الشَّمْسُ أَوِ الْقَمَرُ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنَّ الشَّمْسَ وَالْقَمَرَ آیَتَانِ مِنْ آیَاتِ اللہِ لاَ یَنْکَسِفَانِ لِمَوْتِ أَحَدٍ مِنَ النَّاسِ ، فَإِذَا کَانَ ذَلِکَ فَصَلُّوا حَتَّی تَنْجَلِیَ۔ (بخاری ۱۰۴۰۔ نسائی ۱۸۴۷)","Sahih","Musannaf Ibn Abi Shaybah 8394","","","كتاب الجمعة"
"8395","(۸۳۹۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَقُولُونَ : إذَا کَانَ ذَلِکَ فَصَلُّوا کَصَلاَتِکُمْ حَتَّی تَنْجَلِیَ۔","","Musannaf Ibn Abi Shaybah 8395","","","كتاب الجمعة"
"8396","(۸۳۹۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ ہِشَامٍ ، عَنْ فَاطِمَۃَ ، عَنْ أَسْمَائَ ، قَالَتْ : خَسَفَتِ الشَّمْسُ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَطَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی تَجَلاَّنِی الْغَشْیُ ، قَالَ : قَالَتْ : فَانْصَرَفَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَقَدْ تَجَلَّتْ۔ (بخاری ۸۶۔ مسلم ۶۲۴)","Sahih","Musannaf Ibn Abi Shaybah 8396","","","كتاب الجمعة"
"8397","(۸۳۹۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : حدَّثَنِی فُلاَنٌ وَفُلاَنٌ ، أَنَّ رَسُولَ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إنَّ کُسُوفَ الشَّمْسِ وَالْقَمَرِ آیَتَانِ مِنْ آیَاتِ اللہِ فَإِذَا رَأَیْتُمْ ذَلِکَ فَافْزَعُوا إلَی الصَّلاَۃ۔ (بزار ۱۳۷۱۔ طبرانی ۱۰۹۴)","Da'if","Musannaf Ibn Abi Shaybah 8397","","","كتاب الجمعة"
"8398","(۸۳۹۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیرِیِّ ، عَنْ حَیَّانَ بْنِ عُمَیْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَمُرَۃَ ، وَکَانَ مِنْ أَصْحَابِ النَبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : کُنْتُُ أَرْتَمِی بِأَسْہُمٍ بِالْمَدِینَۃِ فِی حَیَاۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، إذِ انْکَسَفَتِ الشَّمْسُ فَنَبَذْتُہَا ، فَقُلْتُ : وَاللَّہِ لأَنْظُرَنَّ إلَی مَا حَدَثَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی کُسُوفِ الشَّمْسِ ، قَالَ : فَأَتَیْتُہُ وَہُوَ قَائِمٌ فِی الصَّلاَۃ رَافِعًا یَدَیْہِ ، قَالَ : فَجَعَلَ یُسَبِّحُ وَیَحْمَدُ وَیُکَبِّرُ وَیُہَلِّلُ وَیَدْعُو حَتَّی حُسِرَ عَنْہَا ، قَالَ : فَلَمَّا حُسِرَ عَنْہَا قَالَ قَرَأَ سُورَتَیْنِ وَصَلَّی رَکْعَتَیْنِ۔ (مسلم ۲۷۔ ابوداؤد ۱۱۸۸)","Sahih","Musannaf Ibn Abi Shaybah 8398","","","كتاب الجمعة"
"8399","(۸۳۹۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ ، قَالَ : حَدَّثَنِی ثَعْلَبَۃُ بْنُ عِبَادٍ الْعَبْدِیُّ : أَنَّہُ شَہِدَ یَوْمًا خُطْبَۃً لِسَمُرَۃَ بْنِ جُنْدُبٍ فَذَکَرَ فِی خُطْبَتِہِ حَدِیثًا عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : قَالَ سَمُرَۃُ : بَیْنَا أَنَا یَوْمًا وَغُلاَمٌ مِنَ الأَنْصَارِ نَرْمِی غَرَضًا لَنَا عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی إذَا کَانَتِ الشَّمْسُ قِیدَ رُمْحَیْنِ أَوْ ثَلاَثَۃٍ فِی عَیْنِ النَّاظِرِ مِنَ الأُفُقِ اسْوَدَّتْ حَتَّی آضَتْ کأَنَّہَا تَنُّومَۃٌ ، فَقَالَ أَحَدُنَا لصاحبِہِ : انْطَلِقْ بِنَا إلَی الْمَسْجِدِ فَوَاللَّہِ لَتُحْدِثَنَّ ہَذِہِ الشَّمْسُ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی أُمَّتِہِ حَدَثًا ، فَقَالَ : فَدَفَعْنَا إلَی الْمَسْجِدِ فَإِذَا ہُوَ بَارِزٌ مُحْتَفِلٌ ، قَالَ : وَوَافَقْنَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ خَرَجَ إلَی النَّاسِ فَاسْتَقْدَمَ فَصَلَّی بِنَا کَأَطْوَلِ مَا قَامَ بِنَا فِی صَلاَۃٍ قَطُّ لاَ نَسْمَعُ لَہُ صَوْتًا ، ثُمَّ سَجَدَ بِنَا کَأَطْوَلِ مَا سَجَدَ بِنَا فِی صَلاَۃٍ قَطُّ لاَ نَسْمَعُ لَہُ صَوْتًا ، قَالَ : ثُمَّ فَعَلَ فِی الرَّکْعَۃِ الثَّانِیَۃِ مِثْلَ ذَلِکَ ، قَالَ : فَوَافَقَ تَجَلِّی الشَّمْسِ جُلُوسَہُ فِی الرَّکْعَۃِ الثَّانِیَۃِ فَسَلَّمَ۔ (ابوداؤد ۱۱۷۷۔ نسائی ۱۸۶۹)","Da'if","Musannaf Ibn Abi Shaybah 8399","","","كتاب الجمعة"
"8400","(۸۴۰۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنْ قَتَادَۃَ ، عَنْ عَطَائٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : صَلاَۃُ الأَیَاتِ سِتُّ رَکَعَاتٍ فِی أَرْبَعِ سَجَدَاتٍ۔","Sahih","Musannaf Ibn Abi Shaybah 8400","","","كتاب الجمعة"
"8401","(۸۴۰۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَاصِمِ بْنِ عُبَیْدِ اللہِ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ یُہَرْوِلُ إلَی الْمَسْجِدِ فِی کُسُوفٍ وَمَعَہُ نَعْلاَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 8401","","","كتاب الجمعة"
"8402","(۸۴۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا رَبِیعٌ ، عَنِ الْحَسَنِ ، قَالَ : یُصَلِّی رَکْعَتَیْنِ رَکْعَتَیْنِ فِی الْکُسُوفِ۔","","Musannaf Ibn Abi Shaybah 8402","","","كتاب الجمعة"
"8403","(۸۴۰۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ أَبِی الْخَیْرِ بْنِ تَمِیمِ بْنِ حَذْلَمٍ ، قَالَ : کَانَتْ بِالْکُوفَۃِ ظُلْمَۃٌ فَجَائَ ہُنَیُّ بْنُ نُوَیْرَۃَ مَعَہُ صَاحِبٌ لَہُ حَتَّی دَخَلاَ عَلَی تَمِیمِ بْنِ حَذْلَمٍ ، وَکَانَ مِنْ أَصْحَابِ عَبْدِاللہِ، فَوَجَدَاہُ یُصَلِّی ، قَالَ : فَقَالَ لَہُمَا : ارْجِعَا إلَی بُیُوتِکُمَا وَصَلِّیَا حَتَّی یَنْجَلِیَ مَا تَرَوْنَ ، فَإِنَّہُ کَانَ یُؤْمَرُ بِذَلِکَ۔","","Musannaf Ibn Abi Shaybah 8403","","","كتاب الجمعة"
"8404","(۸۴۰۴) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : إذَا فَزِعْتُمْ مِنْ أُفُقٍ مِنْ آفَاقِ السَّمَائِ فَافْزَعُوا إلَی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8404","","","كتاب الجمعة"
"8405","(۸۴۰۵) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، قَالَ : فَزِعَ النَّاسُ فِی انْکِسَافِ شَمْسٍ ، أَوْ قَمَرٍ ، أَوْ شَیْئٍ ، فَقَالَ الشَّعْبِیُّ : عَلَیْکُمْ بِالْمَسْجِدِ ، فَإِنَّہُ مِنَ السُّنَّۃِ۔","","Musannaf Ibn Abi Shaybah 8405","","","كتاب الجمعة"
"8406","(۸۴۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُصَلِّی رَکْعَتَیْنِ فِی الْکُسُوفِ۔","","Musannaf Ibn Abi Shaybah 8406","","","كتاب الجمعة"
"8407","(۸۴۰۷) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ إِسْحَاقَ بْنِ سُوَیْد ، عَنِ الْعَلاَئِ بْنِ زِیَادٍ : فِی صَلاَۃِ الْکُسُوف ، قَالَ : یَقُومُ فَیَقْرَأُ وَیَرْکَعُ ، فَإذَا قَالَ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ نَظَرَ إلَی الْقَمَرِ ، فَإِنْ کَانَ لَمْ یَنجَلِ قَرَأَ ثُمَّ رَکَعَ ، ثُمَّ رَفَعَ رَأْسَہُ ، فَإذَا قَالَ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ نَظَرَ إلَی الْقَمَرِ ، فَإِنْ کَانَ لَمْ یَنجَلِ قَرَأَ ثُمَّ رَکَعَ ، ثُمَّ رَفَعَ رَأْسَہُ ، فَإذَا قَالَ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ نَظَرَ إلَی الْقَمَرِ ، فَإِنْ کَانَ انْجَلَی سَجَدَ ، ثُمَّ قَامَ فَشَفعََہَا بِرَکْعَۃٍ ، وَإِنْ لَمْ یَنْجَلِ لَمْ یَسْجُدْ أَبَدًا حَتَّی تَنْجَلِی مَتَی مَا تجَلَّی ، ثُمَّ إِنْ کَانَ کُسُوفٌ بَعْدُ لَمْ یُصَلِّ ہَذِہِ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8407","","","كتاب الجمعة"
"8408","(۸۴۰۸) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا إِسْحَاقُ بْنُ عُثْمَانَ الْکِلاَبِیُّ ، عَنْ أَبِی أَیُّوبَ الْہَجَرِیُّ قَالَ : انْکَسَفَتِ الشَّمْسُ بِالْبَصْرَۃِ ، وَابْنُ عَبَّاسٍ أَمِیرٌ عَلَیْہَا فَقَامَ یُصَلِّی بِالنَّاسِ ، فَقَرَأَ فَأَطَالَ الْقِرَائَۃَ ، ثُمَّ رَکَعَ فَأَطَالَ الرُّکُوعَ ، ثُمَّ رَفَعَ رَأْسَہُ ، ثُمَّ سَجَدَ ثُمَّ فَعَلَ مِثْلَ ذَلِکَ فِی الثَّانِیَۃِ ، فَلَمَّا فَرَغَ قَالَ : ہَکَذَا صَلاَۃُ الأَیَاتِ ، قَالَ : فَقُلْتُ : بِأَیِّ شَیْئٍ قَرَأَ فِیہِمَا ؟ قَالَ : بِالْبَقَرَۃِ وَآلِ عِمْرَانَ۔","Hasan","Musannaf Ibn Abi Shaybah 8408","","","كتاب الجمعة"
"8409","(۸۴۰۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا شَیْبَانُ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرِو بْنِ الْعَاصِ : أَنَّہُ لَمَّا انْکَسَفَتِ الشَّمْسُ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نُودِیَ بِالصَّلاَۃ جَامِعَۃً، فَرَکَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَکْعَتَیْنِ فِی سَجْدَۃٍ، ثُمَّ قَامَ فَرَکَعَ رَکْعَتَیْنِ فِی سَجْدَۃٍ، ثُمَّ جُلِّیَ عَنِ الشَّمْسِ ، قَالَ : قالَتْ عَائِشَۃُ : مَا سَجَدْتُ سُجُودًا قَطُّ وَلاَ رَکَعْتُ رُکُوعًا قَطُّ کَانَ أَطْوَلَ مِنْہُ۔ (بخاری ۱۰۴۵۔ مسلم ۲۰)","Sahih","Musannaf Ibn Abi Shaybah 8409","","","كتاب الجمعة"
"8410","(۸۴۱۰) حَدَّثَنَا مُصْعَبُ بْنُ الْمِقْدَامِ ، قَالَ : أَخْبَرَنَا زَائِدَۃُ ، قَالَ : قَالَ زِیَادُ بْنُ عِلاَقَۃَ : سَمِعْتُ الْمُغِیرَۃَ بْنَ شُعْبَۃَ یَقُولُ : انْکَسَفَتِ الشَّمْسُ فِی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ مَاتَ إبْرَاہِیمُ ، فَقَالَ النَّاسُ : انْکَسَفَتْ لِمَوْتِ إبْرَاہِیمَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ الشَّمْسَ وَالْقَمَرَ آیَتَانِ مِنْ آیَاتِ اللہِ ، لاَ یَنْکَسِفَانِ لِمَوْتِ أَحَدٍ وَلاَ لِحَیَاتِہِ ، فَإِذَا رَأَیْتُمُوہُمَا فَادْعُوا اللَّہَ وَصَلُّوا حَتَّی تَنْکَشِفَ۔ (بخاری ۶۱۹۹۔ احمد ۴/۲۴۹)","Hasan","Musannaf Ibn Abi Shaybah 8410","","","كتاب الجمعة"
"8411","(۸۴۱۱) حَدَّثَنَا وَکِیعٌ قَالَ : حَدَّثَنَا یَزِیدُ بْنُ إبْرَاہِیمَ ، عَنِ الْحَسَنِ ، أنَّ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی فِی کُسُوفٍ رَکْعَتَیْنِ فَقَرَأَ فِی إحْدَاہُمَا بِالنَّجْمِ۔","","Musannaf Ibn Abi Shaybah 8411","","","كتاب الجمعة"
"8412","(۸۴۱۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إبْرَاہِیمُ بْنُ إسْمَاعِیلَ بْنِ مُجَمِّعٍ ، عَنِ الْمَاجِشُونِ ، قَالَ : سَمِعْتُ أَبَانَ بْنَ عُثْمَانَ قَرَأَ فِی کُسُوفٍ : {سَأَلَ سَائِلٌ}۔","","Musannaf Ibn Abi Shaybah 8412","","","كتاب الجمعة"
"8413","(۸۴۱۳) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ عَبْدِ اللہِ بْنِ عِیسَی ، قَالَ : صَلَّی بِنَا عَبْدُ الرَّحْمَنِ بْنُ أَبِی لَیْلَی حِینَ انْکَسَفَ الْقَمَرُ مِثْلَ صَلاَتِنَا ہَذِہِ فِی رَمَضَانَ ، قَالَ وَقَرَأَ أَوَّلَ شَیْئٍ قَرَأَ {یس وَالْقُرْآنِ الْحَکِیمِ} ۔","","Musannaf Ibn Abi Shaybah 8413","","","كتاب الجمعة"
"8414","(۸۴۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : کَتَبَ إلَیْنَا عُمَرُ بْنُ عَبْدِ الْعَزِیزِ فِی زَلْزَلَۃٍ کَانَتْ بِالشَّامِ ، أَنِ اخْرُجُوا یَوْمَ الإِثْنَیْنِ مِنْ شَہْرِ کَذَا وَکَذَا وَمَنِ اسْتَطَاعَ مِنْکُمْ أَنْ یُخْرِجَ صَدَقَۃً فَلْیَفْعَلْ فَإِنَّ اللَّہَ تَعَالَی قَالَ : {قَدْ أَفْلَحَ مَنْ تَزَکَّی وَذَکَرَ اسْمَ رَبِّہِ فَصَلَّی}۔","","Musannaf Ibn Abi Shaybah 8414","","","كتاب الجمعة"
"8415","(۸۴۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ الْعَبْدِیِّ ، عَنْ ثَعْلَبَۃَ بْنِ عِبَادٍ ، عَنْ سَمُرَۃََ بْنِ جُنْدُبٍ ، قَالَ : صَلَّی بِنَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی کُسُوفٍ ، وَلاَ نَسْمَعُ لَہُ صَوْتًا۔ (ترمذی ۵۶۲۔ نسائی ۱۸۸۲)","Da'if","Musannaf Ibn Abi Shaybah 8415","","","كتاب الجمعة"
"8416","(۸۴۱۶) حَدَّثَنَا سُفْیَانُ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الْحَکَمِ ، عَنْ حَنَشٍ الْکِنَانِیِّ : أَنَّ عَلِیًّا جَہَرَ بِالْقِرَائَۃِ فِی الْکُسُوفِ۔","Da'if","Musannaf Ibn Abi Shaybah 8416","","","كتاب الجمعة"
"8417","(۸۴۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ عَطَائٍ ، قَالَ : إذَا کَانَ الْکُسُوفُ بَعْدَ الْعَصْرِ وَبَعْدَ الصُّبْحِ قَامُوا فَذَکَرُوا رَبَّہُمْ ، وَلاَ یُصَلُّونَ۔","","Musannaf Ibn Abi Shaybah 8417","","","كتاب الجمعة"
"8418","(۸۴۱۸) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا انْکَسَفَتِ الشَّمْسُ فِی وَقْتٍ لاَ تَحِلُّ فِیہِ الصَّلاَۃ ، قَالَ : یَدْعُونَ۔","","Musannaf Ibn Abi Shaybah 8418","","","كتاب الجمعة"
"8419","(۸۴۱۹) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، أَنَّ ابْنَ عَبَّاسٍ صَلَّی بِہِمْ فِی زَلْزَلَۃٍ کَانَتْ أَرْبَعَ سَجَدَاتٍ رَکَعَ فِیہَا سِتًّا۔","Sahih","Musannaf Ibn Abi Shaybah 8419","","","كتاب الجمعة"
"8420","(۸۴۲۰) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ شَہْرٍ ، قَالَ : زُلْزِلَتِ الْمَدِینَۃُ فِی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ: إنَّ رَبَّکُمْ یَسْتَعْتِبُکُمْ فَأَعْتِبُوہُ۔","Da'if","Musannaf Ibn Abi Shaybah 8420","","","كتاب الجمعة"
"8421","(۸۴۲۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ اللہِ ، عَنْ نَافِعٍ ، عَنْ صَفِیَّۃَ ابْنَۃِ أَبِی عُبَیْدٍ ، قَالَت : زُلْزِلَتِ الأَرْضُ عَلَی عَہْدِ عُمَرَ حَتَّی اصْطَفَقَتِ السُّرُرُ فَوَافَقَ ذَلِکَ عَبْدَ اللہِ بْنَ عُمَرَ وَہُوَ یُصَلِّی فَلَمْ یَدْرِ ، قَالَت : فَخَطَبَ عُمَرُ لِلنَّاسِ فَقَالَ : أَحدَثْتُم لَقَدْ عَجِلْتُمْ ، قَالَت : وَلاَ أَعْلَمُہُ إِلاَّ قَالَ : لَئِنْ عَادَتْ لأَخْرُجَنَّ مِنْ بَیْنِ ظَہْرَانِیکُمْ۔","","Musannaf Ibn Abi Shaybah 8421","","","كتاب الجمعة"
"8422","(۸۴۲۲) وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ ہِشَامِ بْنِ إِسْحَاقَ بْنِ عَبْدِ اللہِ بْنِ کِنَانَۃَ ، عَنْ أَبِیہِ قَالَ : أَرْسَلَنِی أَمِیرٌ مِنَ الأُمَرَائِ إلَی ابْنِ عَبَّاسٍ أَسْأَلُہُ عَنِ الاِسْتِسْقَائِ ؟ فَقَالَ ابْنُ عَبَّاسٍ : مَا مَنَعَہُ أَنْ یَسْأَلَنِی؟ ثُمَّ قَالَ ابْنُ عَبَّاسٍ : خَرَجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُتَوَاضِعًا مُتَبذِلاً مُتَخَشِّعًا مُتَضَرِّعًا مُتَرَسِّلاً ، فَصَلَّی رَکْعَتَیْنِ کَمَا یُصَلِّی فِی الْعِیدِ ، وَلَمْ یَخْطُبْ خُطْبَتَکُمْ ہَذِہِ۔ (ترمذی ۵۵۸۔ ابوداؤد ۱۱۶۰)","Hasan","Musannaf Ibn Abi Shaybah 8422","","","كتاب الجمعة"
"8423","(۸۴۲۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَنْ أَبِیہِ ، عَنْ حَارِثَۃَ بْنِ مُضَرِّبٍ الْعَبْدِیِّ ، قَالَ : خَرَجْنَا مَعَ أَبِی مُوسَی نَسْتَسْقِی فَصَلَّی بِنَا رَکْعَتَیْنِ بغَیْرِ أَذَانٍ وَلاَ إقَامَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 8423","","","كتاب الجمعة"
"8424","(۸۴۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : خَرَجْنَا مَعَ عَبْدِ اللہِ بْنِ یَزِیدَ الأَنْصَارِیِّ نَسْتَسْقِی ، فَصَلَّی رَکْعَتَیْنِ وَخَلْفَہُ زَیْدُ بْنُ أَرْقَمَ۔","Sahih","Musannaf Ibn Abi Shaybah 8424","","","كتاب الجمعة"
"8425","(۸۴۲۵) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ مُحَمَّدِ بْنِ ہِلاَلٍ : أَنَّہُ شَہِدَ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ فِی الاِسْتِسْقَائِ بَدَأَ بِالصَّلاَۃ قَبْلَ الْخُطْبَۃِ ، قَالَ : وَرَأَیْتُہُ اسْتَسْقَی فَحَوَّلَ رِدَائَہُ۔","","Musannaf Ibn Abi Shaybah 8425","","","كتاب الجمعة"
"8426","(۸۴۲۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عَبَّادِ بْنِ تَمِیمٍ ، عَنْ عَمِّہِ ، قَالَ : شَہِدْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَرَجَ یَسْتَسْقِی ، فَاسْتَقْبَلَ الْقِبْلَۃَ ، وَوَلَّی ظَہْرَہُ الناس ، وَحَوَّلَ رِدَائَہُ ، وَصَلَّی رَکْعَتَیْنِ ، وَجَہَرَ بِالْقِرَائَۃِ۔ (بخاری ۱۰۲۵۔ ابوداؤد ۱۱۵۵)","Sahih","Musannaf Ibn Abi Shaybah 8426","","","كتاب الجمعة"
"8427","(۸۴۲۷) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ أَبِی بَکْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ، عَنْ عَبَّادِ بْنِ تَمِیمٍ ، عَنْ عَبْدِ اللہِ بْنِ زَیْدٍ قَالَ : خَرَجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی الْمُصَلَّی یَسْتَسْقِی ، فَلَمَّا دَعَا اسْتَقْبَلَ الْقِبْلَۃَ وَحَوَّلَ رِدَائَہُ۔ (بخاری ۱۰۲۸۔ مسلم ۶۱۱)","Sahih","Musannaf Ibn Abi Shaybah 8427","","","كتاب الجمعة"
"8428","(۸۴۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عِیسَی بْنِ حَفْصِ بْنِ عَاصِمٍ ، عَنْ عَطَائِ بْنِ أَبِی مَرْوَانَ الأَسْلَمِیِّ ، عَنْ أَبِیہِ ، قَالَ : خَرَجْنَا مَعَ عُمَرَ بْنِ الْخَطَّابِ نَسْتَسْقِی فَمَا زَادَ عَلَی الاِسْتِغْفار۔","Hasan","Musannaf Ibn Abi Shaybah 8428","","","كتاب الجمعة"
"8429","(۸۴۲۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ : أَنَّ عُمَرَ بْنَ الْخَطَّابِ خَرَجَ یَسْتَسْقِی فَصَعِدَ الْمِنْبَرَ فَقَالَ : {اسْتَغْفِرُوا رَبَّکُمْ إِنَّہُ کَانَ غَفَّارًا یُرْسِلِ السَّمَائَ عَلَیْکُمْ مِّدْرَارًا وَیُمْدِدْکُمْ بِأَمْوَالٍ وَبَنِینَ وَیَجْعَلْ لَکُمْ جَنَّاتٍ وَیَجْعَلْ لَکُمْ أَنَّہَارًا} ، {اسْتَغْفِرُوا رَبَّکُمْ أَنَّہُ کَانَ غَفَّارًا} ، ثُمَّ نَزَلَ فَقَالُوا : یَا أَمِیرَ الْمُؤْمِنِینَ لَوِ اسْتَسْقَیْتَ ، فَقَالَ : لَقَدْ طَلَبْتُہُ بِمَجَادِیحِ السَّمَائِ الَّتِی یُسْتَنْزَلُ بِہَا الْقَطَرُ۔","","Musannaf Ibn Abi Shaybah 8429","","","كتاب الجمعة"
"8430","(۸۴۳۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ أَسْلَمَ الْعِجْلِیّ ، قَالَ : خَرَجَ أناسُ مَرَّۃً یَسْتَسْقُونَ وَخَرَجَ إبْرَاہِیمُ مَعَہُمْ، فَلَمَّا فَرَغُوا قَامُوا یُصَلُّونَ فَرَجَعَ إبْرَاہِیمُ ، وَلَمْ یُصَلِّ مَعَہُمْ۔","","Musannaf Ibn Abi Shaybah 8430","","","كتاب الجمعة"
"8431","(۸۴۳۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : أَنَّہُ خَرَجَ مَعَ الْمُغِیرَۃِ بْنِ عَبْدِ اللہِ الثَّقَفِیِّ یَسْتَسْقِی ، قَالَ : فَصَلَّی الْمُغِیرَۃُ فَرَجَعَ إبْرَاہِیمُ حَیْثُ رَآہُ صَلَّی۔","","Musannaf Ibn Abi Shaybah 8431","","","كتاب الجمعة"
"8432","حَدَّثَنَا أَبُو مُحَمَّدٍ عَبْدُ اللہِ بْنُ یُونُسَ ، قَالَ : حدَّثَنَا بَقِیُّ بْنُ مَخْلَدٍ رَحِمَہُ اللَّہُ ، قَالَ : حَدَّثَنَا أَبُو بَکْرٍ قَالَ :n(۸۴۳۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ قَالَ : سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَیُّ الصَّلاَۃ أَفْضَلُ ؟ قَالَ : طُولُ الْقُنُوتِ۔ (مسلم ۵۲۰۔ ابن ماجہ ۱۴۲۱)","Hasan","Musannaf Ibn Abi Shaybah 8432","","","كتاب الجمعة"
"8433","(۸۴۳۳) حَدَّثَنَا وَکِیعٌ، عَنِ الأَعْمَشِ، عَنْ أَبِی صَالِحٍ، عَنْ رَجُلٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: أنَّ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُومُ فِی الصَّلاَۃ حَتَّی تَرِمَ قَدَمَاہُ فَقِیلَ لَہُ ، فَقَالَ : أَلاَ أَکُونُ عَبْدًا شَکُورًا۔","Sahih","Musannaf Ibn Abi Shaybah 8433","","","كتاب الجمعة"
"8434","(۸۴۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، وَسُفْیَانَ ، عَنْ زِیَادِ بْنِ عِلاَقَۃَ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِثْلَہُ۔ (بخاری ۴۸۳۶۔ مسلم ۷۹)","Sahih","Musannaf Ibn Abi Shaybah 8434","","","كتاب الجمعة"
"8435","(۸۴۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : طُولُ الْقِیَامِ أَحَبُّ إلَیَّ مِنْ کَثْرَۃِ الرُّکُوعِ وَالسُّجُودِ۔","","Musannaf Ibn Abi Shaybah 8435","","","كتاب الجمعة"
"8436","(۸۴۳۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَجَّاجُ بْنُ حَسَّانَ ، قَالَ : سَمِعت أَبَا مِجْلَزٍ ، أَو سَأَلْتُ أَبَا مِجْلَزٍ عَنْ صَلاَۃِ اللَّیْلِ أَطُولُ الْقِرَائَۃِ أَحَبُّ إلَیْک ، أَوْ کَثْرَۃُ الرُّکُوعِ وَالسُّجُودِ ؟ فَقَالَ : لاَ بَلْ طُولُ الْقِرَائَۃِ۔","","Musannaf Ibn Abi Shaybah 8436","","","كتاب الجمعة"
"8437","(۸۴۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ یَحْیَی بْنِ رَافِعٍ ، قَالَ : کَانَ یُقَالُ : لاَ تُطِیلُ الْقِرَائَۃَ فِی الصَّلاَۃ فَیَعْرِضُ لَکَ الشَّیْطَانُ فَیَفْتِنُکَ۔","","Musannaf Ibn Abi Shaybah 8437","","","كتاب الجمعة"
"8438","(۸۴۳۸) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، قَالَ : حدَّثَنی أنَّ رَجُلاً أَتَی إلَی أَبِی ذَرٍّ بِالرَّبَذَۃِ فَقَالَ : أَیْنَ أَبُو ذَرٍّ ؟ فَقَالُوا : ہُوَ فِی سَفْحِ ذَلِکَ الْجَبَلِ فِی غُنَیمَۃ لَہُ ، قَالَ : فَأَتَیْتُہُ فَإِذَا ہُوَ یُصَلِّی وَإِذَا ہُوَ یُقِلُّ الْقِیَامَ وَیُکْثِرُ الرُّکُوعَ وَالسُّجُودَ ، قَالَ : فَلَمَّا صَلَّی قُلْتُ : یَا أَبَا ذَرٍّ رَأَیْتُک تُصَلِّی تُقِلُّ الْقِیَامَ وَتُکْثِرُ الرُّکُوعَ وَالسُّجُودَ ، فَقَالَ : إنِّی حُدِّثْتُ أَنَّہُ مَا مِنْ مُسْلِمٍ یَسْجُدُ لِلَّہِ سَجْدَۃً إِلاَّ رَفَعَہُ اللَّہُ بِہَا دَرَجَۃً وَکَفَّرَ عَنْہُ بِہَا خَطِیئَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 8438","","","كتاب الجمعة"
"8439","(۸۴۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی مُصْعَبٍ الأَسْلَمِیِّ ؛ أَنَّ غُلاَمًا مِنْ أَسْلَمَ کَانَ یَخْدُمُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَخَفَّ لَہُ فَقَالَ : یَا رَسُولَ اللہِ اُدْعُ اللَّہَ لِی أَنْ یُدْخِلَنِی الْجَنَّۃَ ، أَوْ یَجْعَلَنِی فِی شَفَاعَتِکَ ، قَالَ: نَعَمْ، وَأَعِنِّی بِکَثْرَۃِ السُّجُودِ۔ (مسلم ۲۲۶۔ ابوداؤد ۱۳۱۴)","","Musannaf Ibn Abi Shaybah 8439","","","كتاب الجمعة"
"8440","(۸۴۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، عَنْ مَسْرُوقٍ : أَنَّہُ کَانَ یُصَلِّی حَتَّی تَجْلِسَ امْرَأَتُہُ تَبْکِی خَلْفَہُ۔","","Musannaf Ibn Abi Shaybah 8440","","","كتاب الجمعة"
"8441","(۸۴۴۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، وَسُفْیَانَ ، عَنْ زُبَیْدٍ ، عَنْ مُرَّۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : إنَّک مَا دُمْت فِی صَلاَۃٍ تَقْرَعُ بَابَ الْمَلِکِ وَمَنْ یُکْثِرُ قَرْعَ بَابِ الْمَلِکِ یُوشِکُ أَنْ یُفْتَحَ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 8441","","","كتاب الجمعة"
"8442","(۸۴۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، عَنِ الْحَسَنِ ، قَالَ : طُولُ الْقِیَامِ فِی الصَّلاَۃ أَفْضَلُ مِنَ الرُّکُوعِ وَالسُّجُودِ۔","","Musannaf Ibn Abi Shaybah 8442","","","كتاب الجمعة"
"8443","(۸۴۴۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃَ ، عَنِ الْحَارِثِ بْنِ قَیْسٍ ، قَالَ : إذَا ہَمَمْتَ بِخَیْرٍ فَعَجِّلْہُ ، وَإِذَا أَتَاکَ الشَّیْطَانُ فَقَالَ : إنَّکَ تُرَائِی فَزِدْہَا طُولاً۔","","Musannaf Ibn Abi Shaybah 8443","","","كتاب الجمعة"
"8444","(۸۴۴۴) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ رَجُلٍ، عَنْ إبْرَاہِیمَ، قَالَ: إذَا أَکَلَ أَوْ شَرِبَ فِی الصَّلاَۃ اسْتَقْبَلَ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8444","","","كتاب الجمعة"
"8445","(۸۴۴۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ أَبَانَ الْعَطَّارِ ، عَنِ الصَّلْتِ بْنِ رَاشِدٍ ، قَالَ : سُئِلَ طَاوُوس عَنِ الشُّرْبِ فِی الصَّلاَۃ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 8445","","","كتاب الجمعة"
"8446","(۸۴۴۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَطَائٍ ، عَنْ حَجَّاجٍ ، وَإِبْرَاہِیمَ : أَنَّہُمَا کَرِہَا الشُّرْبَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8446","","","كتاب الجمعة"
"8447","(۸۴۴۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : لاَ یَحِلُّ الأَکْلُ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8447","","","كتاب الجمعة"
"8448","(۸۴۴۸) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ لَیْثٍ، عَنْ طَاوُوسٍ، قَالَ: لاَ بَأْسَ بِالشُّرْبِ وَالإِمَام یَخْطُبُ یَوْمَ الْجُمُعَۃِ۔","","Musannaf Ibn Abi Shaybah 8448","","","كتاب الجمعة"
"8449","(۸۴۴۹) حَدَّثَنَا عَبْدُاللہِ بْنُ إدْرِیسَ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ، عَنْ مُحَمَّدِ بْنِ جَعْفَرِ بْنِ الزُّبَیْرِ: أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعَثَ عَبْدَ اللہِ بْنَ أُنَیْسٍ إلَی خَالِدِ بْنِ سُفْیَانَ ، قَالَ : فَلَمَّا دَنَوْتُ مِنْہُ وَذَلِکَ فِی وَقْتِ الْعَصْرِ خِفْتُ أَنْ یَکُونَ دُونَہُ مُحَاوَلَۃٌ أَوْ مُزَاوَلَۃٌ ، فَصَلَّیْتُ وَأَنَا أَمْشِی۔ (ابوداؤد ۱۲۴۳۔ احمد ۳/۴۹۶)","","Musannaf Ibn Abi Shaybah 8449","","","كتاب الجمعة"
"8450","(۸۴۵۰) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنِ الْحَسَنِ بْنِ أَبِی جَعْفَرٍ ، عَنْ أَبِی الصَّہْبَائِ ، قَالَ : رَأَیْتُُ مُجَاہِدًا أَقْبَلَ مِنَ الْبَطْحَائِ ، فَلَمَّا انْتَہَی إلَی الْمَسْجِدِ الْحَرَامِ قَرَأَ سَجْدَۃً فَسَجَدَ فَذَکَرْتُ ذَلِکَ لِعَطَائٍ ، قَالَ : وَمَا تَعْجَبُ مِنْ ذَا ؟ کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلُّونَ وَہُمْ یَمْشُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 8450","","","كتاب الجمعة"
"8451","(۸۴۵۱) حَدَّثَنَا مَخْلَدُ بْنُ یَزِیدَ ، عَنْ سَعِیدِ بْنِ عَبْدِ الْعَزِیزِ ، عَنْ مَکْحُولٍ ، قَالَ : سَأَلْتُُہُ عَنِ الرَّجُلِ یُصَلِّی وَہُوَ یَمْشِی ؟ قَالَ : لاَ بَأْسَ یُومِیئُ إیمَائً۔","","Musannaf Ibn Abi Shaybah 8451","","","كتاب الجمعة"
"8452","(۸۴۵۲) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ یَزِیدَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : إِنْ کَانَ أَحَدُنَا لیُصَلِّی وَہُوَ یَسْعَی ، یَعْنِی فِی الْحَرْبِ۔","","Musannaf Ibn Abi Shaybah 8452","","","كتاب الجمعة"
"8453","(۸۴۵۳) حَدَّثَنَا حَفْصٌ ، عَنْ حُمَیْدٍ ، عَنِ الأَزْرَقِ بْنِ قَیْسٍ ، عَنْ أَبِی بَرْزَۃَ : أَنَّہُ صَلَّی وَہُوَ مُمْسِکٌ بِعَنَانِ دَابَّتِہِ وَہُوَ یَمْشِی۔","Sahih","Musannaf Ibn Abi Shaybah 8453","","","كتاب الجمعة"
"8454","(۸۴۵۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا قُدَامَۃُ الْعَامِرِیُّ ، عَنْ جَسْرَۃَ بِنْتِ دَجَاجَۃَ ، عَنْ أَبِی ذَرٍّ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَدَّدَ ہَذِہِ الآیَۃَ حَتَّی أَصْبَحَ {إنْ تُعَذِّبْہُمْ ، فَإِنَّہُمْ عِبَادُکَ وَإِنْ تَغْفِرْ لَہُمْ فَإِنَّکَ أَنْتَ الْعَزِیزُ الْحَکِیمُ}۔ (نسائی ۱۰۸۳۔ احمد ۵/۱۷۰)","Hasan","Musannaf Ibn Abi Shaybah 8454","","","كتاب الجمعة"
"8455","(۸۴۵۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ عُبَیْدٍ الطَّائِیُّ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ جُبَیْرٍ وَہُوَ یُصَلِّی بِہِمْ فِی شَہْرِ رَمَضَانَ یُرَدِّدُ ہَذِہِ الآیَۃَ {فَسَوْفَ یَعْلَمُونَ إذِ الأَغْلاَلُ فِی أَعْنَاقِہِمْ وَالسَّلاَسِلُ یُسْحَبُونَ فِی الْحَمِیمِ ثُمَّ فِی النَّارِ یُسْجَرُونَ}۔","","Musannaf Ibn Abi Shaybah 8455","","","كتاب الجمعة"
"8456","(۸۴۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حُصَیْنٍ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، أَنَّ تَمِیمًا الدَّارِیَّ رَدَّدَ ہَذِہِ الآیَۃَ : {أَمْ حَسِبَ الَّذِینَ اجْتَرَحُوا السَّیِّئَاتِ أَنْ نَّجْعَلَہُمْ کَاَلَّذِینَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ سَوَائً مَّحْیَاہُمْ وَمَمَاتُہُمْ}۔","Sahih","Musannaf Ibn Abi Shaybah 8456","","","كتاب الجمعة"
"8457","(۸۴۵۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَجْلاَنَ ، عَنْ نُسِیر أَبِی طُعْمَۃَ مَوْلَی الرَّبِیعِ بْنِ خُثَیْمٍ ، قَالَ : کَانَ الرَّبِیعُ بْنُ خُثَیْمٍ یُصَلِّی فَمَرَّ بِہَذِہِ الآیَۃِ : {أَمْ حَسِبَ الَّذِینَ اجْتَرَحُوا السَّیِّئَاتِ} حَتَّی خَتَمَہا یُرَدِّدُہَا حَتَّی أَصْبَحَ۔","","Musannaf Ibn Abi Shaybah 8457","","","كتاب الجمعة"
"8458","(۸۴۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ مُغَفَّلٍ یَقُولُ : قَرَأَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی مَسِیرٍ لَہُ فِی عَامِ الْفَتْحِ سُورَۃَ الْفَتْحِ عَلَی رَاحِلَتِہِ فَرَجَّعَ فِی قِرَائَتِہِ ، قَالَ مُعَاوِیَۃُ : وَلَوْلاَ أَنِّی أَخَافُ أَنْ یَجْتَمِعَ عَلَیَّ النَّاسُ لَحَکَیْتُ لَکُمْ قِرَائَتَہُ۔ (بخاری ۴۲۸۱۔ مسلم ۲۳۹)","Sahih","Musannaf Ibn Abi Shaybah 8458","","","كتاب الجمعة"
"8459","(۸۴۵۹) حَدَّثَنَا عَبْدُاللہِ بْنُ إدْرِیسَ، عَنْ لَیْثٍ، عَنِ الأَسْوَدِ، قَالَ: کَانُوا یُحِبُّونَ أَنْ یُرَجِّعُوا بِالآیَۃِ مِنْ آخِرِ اللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 8459","","","كتاب الجمعة"
"8460","(۸۴۶۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : أُرَاہُ عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَقِفَ الرَّجُلُ عِنْدَ الآیَۃِ فَیُرَدِّدُہَا۔","","Musannaf Ibn Abi Shaybah 8460","","","كتاب الجمعة"
"8461","(۸۴۶۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ فِی قولہ تعالی : {وَإِذَا قُرِیئَ الْقُرْآنُ فَاسْتَمِعُوا لَہُ وَأَنْصِتُوا} قَالَ : فِی الصَّلاَۃ الْمَکْتُوبَۃِ۔","","Musannaf Ibn Abi Shaybah 8461","","","كتاب الجمعة"
"8462","(۸۴۶۲) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الْعَوَّامِ ، أُخْبِرنَا عَنْ مُجَاہِدٍ قَالَ : فِی خُطْبَۃِ الإِمَام یَوْمَ الْجُمُعَۃِ۔","","Musannaf Ibn Abi Shaybah 8462","","","كتاب الجمعة"
"8463","(۸۴۶۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا جُوَیْبِرٌ ، عَنِ الضَّحَّاکِ ، قَالَ : فِی الصَّلاَۃ الْمَکْتُوبَۃِ ، وَعِنْدَ الذِّکْرِ۔","","Musannaf Ibn Abi Shaybah 8463","","","كتاب الجمعة"
"8464","(۸۴۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ حُرَیث ، عَنِ الشَّعْبِیِّ ۔ وَعَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ مُجَاہِدٍ ۔ وَعَنْ أَبِی الْمِقْدَامِ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ مُغَفَّلٍ : فِی قولہ تعالی : {وَإِذَا قُرِیئَ الْقُرْآنُ فَاسْتَمِعُوا لَہُ وَأَنْصِتُوا} قَالُوا : فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8464","","","كتاب الجمعة"
"8465","(۸۴۶۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْ سَمِعَ الْحَسَنَ یَقُولُ : عِنْدَ الصَّلاَۃ الْمَکْتُوبَۃِ ، وَعِنْدَ الذِّکْرِ۔","","Musannaf Ibn Abi Shaybah 8465","","","كتاب الجمعة"
"8466","(۸۴۶۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ الْہَجَرِیِّ ، عَنْ أَبِی عِیَاضٍ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : کَانُوا یَتَکَلَّمُونَ فِی الصَّلاَۃ فَنَزَلَتْ : {وَإِذَا قُرِیئَ الْقُرْآنُ فَاسْتَمِعُوا لَہُ وَأَنْصِتُوا} ، قَالُوا : ہَذَا فِی الصَّلاَۃ۔","Da'if","Musannaf Ibn Abi Shaybah 8466","","","كتاب الجمعة"
"8467","(۸۴۶۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ أَشْعَثَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْرَأُ وَرَجُلٌ یَقْرَأُ فَنَزَلَ : {وَإِذَا قُرِیئَ الْقُرْآنُ فَاسْتَمِعُوا لَہُ وَأَنْصِتُوا}۔","","Musannaf Ibn Abi Shaybah 8467","","","كتاب الجمعة"
"8468","(۸۴۶۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، قَالَ : سَمِعْتُ إبْرَاہِیمَ بْنَ أَبِی حُرَّۃَ ، أَنَّہُ سَمِعَ مُجَاہِدًا قَالَ فِی ہَذِہِ الآیَۃِ : {وَإِذَا قُرِیئَ الْقُرْآنُ فَاسْتَمِعُوا لَہُ وَأَنْصِتُوا} قَالَ : فِی الصَّلاَۃ وَالْخُطْبَۃِ یَوْمَ الْجُمُعَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 8468","","","كتاب الجمعة"
"8469","(۸۴۶۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ : {وَإِذَا قُرِیئَ الْقُرْآنُ فَاسْتَمِعُوا لَہُ وَأَنْصِتُوا} قَالَ: فِی الصَّلاَۃ الْمَکْتُوبَۃِ۔","","Musannaf Ibn Abi Shaybah 8469","","","كتاب الجمعة"
"8470","(۸۴۷۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا لَمْ یَسْکُنِ الرُّعَافُ شَدَّہُ ، ثُمَّ بَادَرَ فَصَلَّی۔","","Musannaf Ibn Abi Shaybah 8470","","","كتاب الجمعة"
"8471","(۸۴۷۱) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : إذَا لَمْ یَنْقَطِعِ الرُّعَافُ أَوْمَأَ صَاحِبُہُ إیمَائً۔","","Musannaf Ibn Abi Shaybah 8471","","","كتاب الجمعة"
"8472","(۸۴۷۲) حَدَّثَنَا عُمَرُ بْنُ ہَارُونَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ : فِی رَجُلٍ رَعَفَ فَلَمْ یَرْقَأ عَنْہُ حَتَّی یَخْشَی فَوْتَ الصَّلاَۃ ، قَالَ : یَشُدُّ مَنْخِرَیْہِ بِخِرْقَۃٍ وَیُبَادِرُ فَیُصَلِّی ، قُلْتُ : إذًا یَقَعُ فِی جَوْفِہِ ، قَالَ : وَلَوْ۔","","Musannaf Ibn Abi Shaybah 8472","","","كتاب الجمعة"
"8473","(۸۴۷۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : یُدَارَی مَا بَیْنَہُ وَبَیْنَ أَنْ یَخَافَ فَوْتَ الْوَقْتِ فَإِذَا کَانَ ذَلِکَ بَادَرَ فَصَلَّی ، یَعْنِی الرُّعَافَ۔","","Musannaf Ibn Abi Shaybah 8473","","","كتاب الجمعة"
"8474","(۸۴۷۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنِ الْمِسْوَرِ بْنِ مَخْرَمَۃَ : أَنَّ عُمَرَ بْنَ الْخَطَّابِ صَلَّی وَإِنَّ جُرْحَہُ لَیَثْعَبُ دَمًا۔","Sahih","Musannaf Ibn Abi Shaybah 8474","","","كتاب الجمعة"
"8475","(۸۴۷۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی الأَحْوَص ، عَنْ عَبْدِ اللہِ ، سَمِعَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : فَضْلُ صَلاَۃِ الرَّجُلِ فِی جَمَاعَۃٍ عَلَی صَلاَتِہِ وَحْدَہُ بِضْعٌ وَعِشْرُونَ دَرَجَۃً۔ (احمد ۱/۳۷۶۔ بزار ۴۵۸)","Da'if","Musannaf Ibn Abi Shaybah 8475","","","كتاب الجمعة"
"8476","(۸۴۷۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِلالِ بْنِ مَیْمُونٍ ، عَنْ عَطَائِ بْنِ یَزِیدَ اللَّیْثِیِّ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَلاَۃُ الرَّجُلِ فِی جَمَاعَۃٍ تَزِیدُ عَلَی صَلاَتِہِ وَحْدَہُ خَمْسًا وَعِشْرِینَ دَرَجَۃً ، وَإِنْ صَلاَّہَا بِأَرْضِ فَلاَۃٍ فَأَتَمَّ وُضُوئَہَا وَرُکُوعَہَا وَسُجُودَہَا بَلَغَتْ صَلاَتُہُ خَمْسِینَ دَرَجَۃً۔ (ابوداؤد ۵۶۱۔ ابن ماجہ ۷۸۸)","Hasan","Musannaf Ibn Abi Shaybah 8476","","","كتاب الجمعة"
"8477","(۸۴۷۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : تَفْضُلُ الصَّلاَۃ فِی الْجَمِیعِ عَلَی صَلاَۃِ الرَّجُلِ وَحْدَہُ خَمْسًا وَعِشْرِینَ دَرَجَۃً۔ (بخاری ۶۴۸۔ مسلم ۲۴۵)","Sahih","Musannaf Ibn Abi Shaybah 8477","","","كتاب الجمعة"
"8478","(۸۴۷۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدِ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَلاَۃُ الرَّجُلِ فِی جَمَاعَۃٍ تَفْضُلُ عَلَی صَلاَتِہِ وَحْدَہُ بِسَبْعٍ وَعِشْرِینَ دَرَجَۃً۔ (مسلم ۴۵۱۔ ابن ماجہ ۷۸۹)","Sahih","Musannaf Ibn Abi Shaybah 8478","","","كتاب الجمعة"
"8479","(۸۴۷۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الصَّلاَۃ فِی الْجَمَاعَۃِ تَزِیدُ عَلَی صَلاَۃِ الْفَذِّ خَمْسًا وَعِشْرِینَ دَرَجَۃً۔ (بخاری ۶۴۸۔ مسلم ۴۵۰)","Hasan","Musannaf Ibn Abi Shaybah 8479","","","كتاب الجمعة"
"8480","(۸۴۸۰) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : فَضْلُ صَلاَۃِ الْجَمَاعَۃِ عَلَی صَلاَۃِ الرَّجُلِ وَحْدَہُ أَرْبَعٌ وَعِشْرُونَ دَرَجَۃً۔","Hasan","Musannaf Ibn Abi Shaybah 8480","","","كتاب الجمعة"
"8481","(۸۴۸۱) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، عَنْ أَبِی جَعْفَرٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : تُضَاعَفُ صَلاَۃُ الْجَمَاعَۃِ عَلَی صَلاَۃِ الْوَحْدَۃِ خَمْسًا وَعِشْرِینَ دَرَجَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 8481","","","كتاب الجمعة"
"8482","(۸۴۸۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی حَصِینٍ ، عَنْ أَبِی الأَحْوَص ، قَالَ : قَالَ عَبْدُ اللہِ : صَلاَۃُ الرَّجُلِ فِی جَمَاعَۃٍ أَفْضَلُ مِنْ صَلاَتِہِ فِی سُوقِہِ أَوْ وَحْدَہُ ببِضْعٍ وَعِشْرِینَ دَرَجَۃً ، قَالَ : وَکَانَ یُؤْمَرُ أَنْ یُقَارَبَ بَیْنَ الْخُطَی۔","Sahih","Musannaf Ibn Abi Shaybah 8482","","","كتاب الجمعة"
"8483","(۸۴۸۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ ثَابِتِ بنِ عُبَیْدٍ ، قَالَ : دَخَلْنَا عَلَی زَیْدِ بْنِ ثَابِتٍ وَہُوَ یُصَلِّی عَلَی حَصِیرٍ یَسْجُدُ عَلَیْہِ ، وَقَالَ : فَضْلُ صَلاَۃِ الْجَمَاعَۃِ عَلَی صَلاَۃِ الْوَحْدَۃِ خَمْسٌ وَعِشْرُونَ دَرَجَۃً۔","","Musannaf Ibn Abi Shaybah 8483","","","كتاب الجمعة"
"8484","(۸۴۸۴) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : الصَّلاَۃ مَعَ الإِمَامِ تَفْضُلُ عَلَی صَلاَتِہِ وَحْدَہُ سَبْعًا وَعِشْرِینَ دَرَجَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 8484","","","كتاب الجمعة"
"8485","(۸۴۸۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ عَمْرِو بْنِ قَیْسٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : فَضْلُ صَلاَۃِ الْجَمَاعَۃِ عَلَی صَلاَۃِ الْوَحْدَۃِ خَمْسٌ وَعِشْرُونَ دَرَجَۃً ، فَإِنْ کَانُوا أَکْثَرَ فَعَلَی عَدَدِ مَنْ فِی الْمَسْجِدِ ، فَقَالَ رَجُلٌ : وَإِنْ کَانُوا عَشْرَۃَ الأَفٍ ؟ قَالَ : نَعَمْ وَإِنْ کَانُوا أَرْبَعِینَ أَلْفًا۔","Hasan","Musannaf Ibn Abi Shaybah 8485","","","كتاب الجمعة"
"8486","(۸۴۸۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ مُحَمَّدِ بْنِ سُوقَۃَ ، عَنْ رَجُلٍ ، عَنْ کَعْبٍ ، قَالَ : عَلَی عَدَدِ مَنْ فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 8486","","","كتاب الجمعة"
"8487","(۸۴۸۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، عَنْ کَثِیرِ بْنِ أَفْلَحَ ، قَالَ : کُنَّا بِالْمَدِینَۃِ فِی دَارِ أَبِی یُوسُفَ فِی حِسَابٍ لَنَا نَحْسِبُہُ وَمَعَنَا زَیْدُ بْنُ ثَابِتٍ ، فَقَالَ : صَلاَۃُ الرَّجُلِ مَعَ الإِمَامِ تُضَعَّفُ عَلَی صَلاَتِہِ وَحْدَہُ بِضْعًا وَعِشْرِینَ دَرَجَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 8487","","","كتاب الجمعة"
"8488","(۸۴۸۸) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَص ، قَالَ : قَالَ عَبْدُ اللہِ : تَزِیدُ صَلاَۃُ الرَّجُلِ فِی جَمَاعَۃٍ عَلَی صَلاَتِہِ وَحْدَہُ أَرْبَعًا وَعِشْرِینَ دَرَجَۃً ، أَوْ خَمْسًا وَعِشْرِینَ دَرَجَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 8488","","","كتاب الجمعة"
"8489","(۸۴۸۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ سَعْدِ بْنِ إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَۃَ ، عَنْ مَحْمُودِ بْنِ لَبِیدٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إیَّاکُمْ إیَّاکُمْ وَشِرْکَ السَّرَائِرِ ، قَالُوا : وَمَا شِرْکُ السَّرَائِرِ؟ قَالَ: أَنْ یَقُومَ أَحَدُکُمْ یُزَیِّنُ صَلاَتَہُ جَاہِدًا لِیَنْظُرَ النَّاسُ إلَیْہِ ، فَذَلِکَ شِرْکُ السَّرَائِرِ۔ (بیہقی ۲۹۰۔ احمد ۵/۴۲۹)","Hasan","Musannaf Ibn Abi Shaybah 8489","","","كتاب الجمعة"
"8490","(۸۴۹۰) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَص ، عَنْ عَبْدِ اللہِ ، قَالَ : مَنْ صَلَّی صَلاَۃً وَالنَّاسُ یَرَوْنَہُ فَلْیُصَلِّ إذَا خَلاَ مِثْلَہَا وَالأَ فَإِنَّمَا ہِیَ اسْتِہَانَۃٌ یَسْتَہِینُ بِہَا رَبَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 8490","","","كتاب الجمعة"
"8491","(۸۴۹۱) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ رَجُلٍ ، عَنْ حُذَیْفَۃَ مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 8491","","","كتاب الجمعة"
"8492","(۸۴۹۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ بُرْدٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی فِی الثَّوْبِ الَّذِی یُجَامِعُ فِیہِ۔ (احمد ۲۱۷)","","Musannaf Ibn Abi Shaybah 8492","","","كتاب الجمعة"
"8493","(۸۴۹۳) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ : سَأَلَ رَجُلٌ جَابِرَ بْنَ سَمُرَۃَ أُصَلِّی فِی الثَّوْبِ وَأُجَامِعُ فِیہِ ؟ قَالَ : إِنْ أَصَابَہُ شَیْئٌ فَاغْسِلْہُ ، وَإِن لَم یُصبہ شَیْئٌ فَلاَ بَأْسَ أَنْ تُصَلِّیَ فِیہِ۔","Sahih","Musannaf Ibn Abi Shaybah 8493","","","كتاب الجمعة"
"8494","(۸۴۹۴) حَدَّثَنَا وَکِیعٌ، عَنْ بَشِیرٍ، عَنْ أَبِی حَازِمٍ، عَنِ ابْنِ عُمَرَ، قَالَ: إنَّ ہَذِہِ لَتَعْلَمُ أَنَّا نُجَامِعُ فِیہِ وَنُصَلِّی فِیہِ۔","Sahih","Musannaf Ibn Abi Shaybah 8494","","","كتاب الجمعة"
"8495","(۸۴۹۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ الشَّعْبِیِّ : سُئِلَ عَنِ الثَّوْبِ الَّذِی یُجَامِعُ فِیہِ أَیُصَلِّی فِیہِ ؟ قَالَ : قُلْتُ : نَعَمْ ، قُلْتُ : فَأَنْضَحُہُ بِالْمَائِ ؟ قَالَ : لاَ یَزِیدُہ إِلاَّ نَتَنًا۔","","Musannaf Ibn Abi Shaybah 8495","","","كتاب الجمعة"
"8496","(۸۴۹۶) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ قَالَ : حدَّثَنِی ضَمْرَۃُ بْنُ حَبِیبٍ ، قَالَ : حَدَّثَنِی مُحَمَّدُ بْنُ أَبِی سُفْیَانَ الثَّقَفِیُّ ، أَنَّ أُمَّ حَبِیبَۃَ زَوْجَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَتْ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی فِی ثَوْبٍ عَلَیَّ وَعَلَیْہِ کَانَ فِیہِ مَا کَانَ۔ (بخاری ۲۸۸۔ احمد ۶/۳۲۵)","Da'if","Musannaf Ibn Abi Shaybah 8496","","","كتاب الجمعة"
"8497","(۸۴۹۷) حَدَّثَنَا شَبَابَۃُ ، عَنْ لَیْثٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ سُوَیْد بْنِ قَیْسٍ ، عَنْ مُعَاوِیَۃَ بْنِ حُدَیْجٍ ، عَنْ مُعَاوِیَۃَ بْنِ أَبِی سُفْیَانَ : أَنَّہُ سَأَلَ أُمَّ حَبِیبَۃَ ابْنَۃَ أَبِی سُفْیَانَ ہَلْ کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی فِی الثَّوْبِ الَّذِی کَانَ یُجَامِعُہَا فِیہِ ؟ قَالَتْ : نَعَمْ إذَا لَمْ یَرَ فِیہِ أَذًی۔ (ابوداؤد ۳۶۹۔ احمد ۶/۴۲۷)","Sahih","Musannaf Ibn Abi Shaybah 8497","","","كتاب الجمعة"
"8498","(۸۴۹۸) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی رَجُلاً قَصِیرًا یُقَالُ لَہُ : زنیْمٌ فَسَجَدَ ، وَقَالَ : الْحَمْدُ لِلَّہِ الَّذِی لَمْ یَجْعَلْنِی مِثْلَ ہَذَا۔ (ابوداؤد ۲۷۶۸۔ ترمذی ۱۵۷۸)","Da'if","Musannaf Ibn Abi Shaybah 8498","","","كتاب الجمعة"
"8499","(۸۴۹۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ أَبِی عَوْنٍ الثَّقَفِیِّ مُحَمَّدِ بْنِ عُبَیدِ اللہِ ، عَنْ رَجُلٍ لَمْ یُسَمِّہِ ، أَنَّ أَبَا بَکْرٍ لَمَّا فَتَحَ الْیَمَامَۃَ سَجَدَ۔","Da'if","Musannaf Ibn Abi Shaybah 8499","","","كتاب الجمعة"
"8500","(۸۵۰۰) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ أَبِی عَوْنٍ الثَّقَفِیِّ ، عَنْ یَحْیَی بْنِ الْجَزَّارِ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ بِہِ رَجُلٌ بِہِ زَمَانَۃٌ فَسَجَدَ ، وَأَبُو بَکْرٍ ، وَعُمَرُ۔","","Musannaf Ibn Abi Shaybah 8500","","","كتاب الجمعة"
"8501","(۸۵۰۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن أَبِیہِ : أَنَّ عُمَرَ أَتَاہُ فَتْحٌ مِنْ قِبَلِ الْیَمَامَۃِ فَسَجَدَ۔","Da'if","Musannaf Ibn Abi Shaybah 8501","","","كتاب الجمعة"
"8502","(۸۵۰۲) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ الْہَمْدَانِیِّ ، عَنْ شَیْخٍ لَہُمْ یُکَنَّی أَبَا مُوسَی قَالَ : شَہِدْتُ عَلِیًّا لَمَّا أُتِیَ بِالْمُخْدَجِ سَجَدَ۔","Da'if","Musannaf Ibn Abi Shaybah 8502","","","كتاب الجمعة"
"8503","(۸۵۰۳) حَدَّثَنَا شَرِیکٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ أَبِی مُوسَی : أَنَّ عَلِیًّا لَمَّا أُتِیَ بِالْمُخْدَجِ سَجَدَ۔","Da'if","Musannaf Ibn Abi Shaybah 8503","","","كتاب الجمعة"
"8504","(۸۵۰۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَرِہَ سَجْدَۃَ الشُّکْرِ ، قَالَ مَنْصُورٌ : وَبَلَغَنِی أَنَّ أَبَا بَکْرٍ وَعُمَرَ سَجَدَا سَجْدَۃَ الشُّکْرِ۔","","Musannaf Ibn Abi Shaybah 8504","","","كتاب الجمعة"
"8505","(۸۵۰۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ بنُغَاشِیٍّ فَسَجَدَ وَقَالَ : اسْأَلُوا اللَّہَ الْعَافِیَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 8505","","","كتاب الجمعة"
"8506","(۸۵۰۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الْکَلْبِیُّ ، عَنْ أَبِی صَالِحٍ ، عَنِ ابْنِ عَبَّاسٍ قَالَ : لَمَّا نَزَلَ نِکَاحُ زَیْنَبَ انْطَلَقَ زَیْدُ بْنُ حَارِثَۃَ حَتَّی اسْتَأْذَنَ عَلَی زَیْنَبَ ، قَالَ : فَقَالَتْ زَیْنَبُ : مَا لِی وَلِزَیْدٍ ، قَالَ : فَأَرْسَلَ إلَیْہَا فَقَالَ : إنِّی رَسُولُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَیْکِ ، قَالَ : فَأَذِنَتْ لَہُ ، فَبَشَّرَہَا أَنَّ اللَّہَ قَدْ زَوَّجَہَا مِنْ نَبِیِّہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَخَرَّتْ سَاجِدَۃً لِلَّہِ شُکْرًا۔ (ابن سعد ۱۰۲)","Da'if","Musannaf Ibn Abi Shaybah 8506","","","كتاب الجمعة"
"8507","(۸۵۰۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَانَ یَکْرَہُ سَجْدَۃَ الْفَرَحِ ، وَیَقُولُ : لَیْسَ فِیہَا رُکُوعٌ وَلاَ سُجُودٌ۔","","Musannaf Ibn Abi Shaybah 8507","","","كتاب الجمعة"
"8508","(۸۵۰۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُوَیْد بْنُ عُبَیْدٍ الْعِجْلِیّ ، عَنْ أَبِی مُؤَمَّنٍ الْوَاثِلِیِّ قَالَ : شَہِدْتُ عَلِیًّا لَمَّا أُتِیَ بِالْمُخْدَجِ سَجَدَ۔","Da'if","Musannaf Ibn Abi Shaybah 8508","","","كتاب الجمعة"
"8509","(۸۵۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : سَجْدَۃُ الشُّکْرِ بِدْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 8509","","","كتاب الجمعة"
"8510","(۸۵۱۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : أَخْبَرَنَا إسْمَاعِیلُ بْنُ زَرْبِیٍّ ، قَالَ : حَدَّثَنَا رَبَّانُ بْنُ صَبِرَۃَ الْحَنَفِیُّ : أَنَّہُ شَہِدَ یَوْمَ النَّہْرَوَانِ ، قَالَ : وَکُنْتُ فِیمَنِ اسْتَخْرَجَ ذَا الثُّدَیَّۃِ فَبُشِّرَ بِہِ عَلِیًّا قَبْلَ أَنْ یَنْتَہِیَ إلَیْہِ ، فَانْتَہَیْنا إلَیْہِ وَہُوَ سَاجِدٌ فَرِحًا بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 8510","","","كتاب الجمعة"
"8511","(۸۵۱۱) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ قَالَ : حدَّثَنَا مُوسَی بْنُ عُبَیْدَۃَ ، عَنْ قَیْسِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِی صَعْصَعَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِیہِ ، عَنْ جَدِّہِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ، قَالَ : انْتَہَیْتُ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ ساجِدٌ ، فَلَمَّا انْصَرَفَ قُلْتُ : أَطَلْت السُّجُودَ ، قَالَ : إنِّی سَجَدْتُ شُکْرًا لِرَبِّی فِیمَا أَبْلاَنِی فِی أُمَّتِی۔ (احمد ۱/۱۹۱۔ ابو یعلی ۸۴۳)","Da'if","Musannaf Ibn Abi Shaybah 8511","","","كتاب الجمعة"
"8512","(۸۵۱۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أَبْصَرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَعْدًا وَہُوَ یَدْعُو بِإِصْبَعَیْہِ ، قَالَ : فَقاَلَ لَہُ : یَا سَعد أَحِّد أَحِّد۔ (ترمذی ۳۵۵۷۔ ابوداؤد ۱۴۹۴)","Sahih","Musannaf Ibn Abi Shaybah 8512","","","كتاب الجمعة"
"8513","(۸۵۱۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ : أَنَّہُ رَأَی رَجُلاً یَدْعُو بِإِصْبَعَیْہِ کِلْتَیْہِمَا فَنَہَاہُ ، وَقَالَ بِإِصْبَعٍ وَاحِدَۃٍ بِالْیُمْنَی۔","Sahih","Musannaf Ibn Abi Shaybah 8513","","","كتاب الجمعة"
"8514","(۸۵۱۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ رَاشِدٍ أَبِی سَعْدٍ ، عَنْ سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا جَلَسَ فِی الصَّلاَۃ وَضَعَ یَدَہُ عَلَی فَخِذِہِ یُشِیرُ بِإِصْبَعِہِ فِی الدُّعَائِ۔ (مسلم ۴۰۸۔ ابوداؤد ۹۷۹)","Da'if","Musannaf Ibn Abi Shaybah 8514","","","كتاب الجمعة"
"8515","(۸۵۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ التَّمِیمِیِّ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : ہُوَ الإِخْلاَصُ ، یَعْنِی الدُّعَائَ بِالأَصْبَعِ۔","Da'if","Musannaf Ibn Abi Shaybah 8515","","","كتاب الجمعة"
"8516","(۸۵۱۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ سُلَیْمَانَ بْنِ أَبِی یَحْیَی، قَالَ: کَانَ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَأْخُذُ بَعْضُہُمْ عَلَی بَعْضٍ ، یَعْنِی الإِشَارَۃَ بِالأَصْبَعِ فِی الدُّعَائِ۔","Hasan","Musannaf Ibn Abi Shaybah 8516","","","كتاب الجمعة"
"8517","(۸۵۱۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، أَنَّہُ قَالَ : الدُّعَائُ ہَکَذَا وَأَشَارَ بِإِصْبَعٍ وَاحِدَۃٍ مِقْمَعَۃُ الشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 8517","","","كتاب الجمعة"
"8518","(۸۵۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی عَلْقَمَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : إنَّ اللَّہَ یُحِبُّ أَنْ یُدْعاَ ہَکَذَا وَأَشَارَتْ بِإِصْبَعٍ وَاحِدَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 8518","","","كتاب الجمعة"
"8519","(۸۵۱۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، عَنْ کَثِیرِ بْنِ أَفْلَحَ ، قَالَ : صَلَّیْتُ ، فَلَمَّا کَانَ فِی آخِرِ الْقَعْدَۃِ قُلْتُ ہَکَذَا وَأَشَارَ ابْنُ عُلَیَّۃَ بِإِصْبَعَیْہِ ، فَقَبَضَ ابْنُ عُمَر ہَذِہِ ، یَعْنِی الْیُسْرَی۔","Sahih","Musannaf Ibn Abi Shaybah 8519","","","كتاب الجمعة"
"8520","(۸۵۲۰) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عُمَرَ : أَنَّہُ کَانَ یُشِیرُ بِإِصْبَعِہِ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8520","","","كتاب الجمعة"
"8521","(۸۵۲۱) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ طلحۃ ، عَنْ خَیْثَمَۃَ : أَنَّہُ کَانَ یَعْقِدُ ثَلاَثًا وَخَمْسِینَ ، وَیُشِیرُ بِإِصْبَعِہِ۔","","Musannaf Ibn Abi Shaybah 8521","","","كتاب الجمعة"
"8522","(۸۵۲۲) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانُوا إذَا رَأَوْا إنْسَانًا یَدْعُو بِإِصْبَعَیْہِ ضَرَبُوا إحْدَاہُمَا وَقَالُوا : إنَّمَا ہُوَ إلَہٌ وَاحِدٌ۔","","Musannaf Ibn Abi Shaybah 8522","","","كتاب الجمعة"
"8523","(۸۵۲۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَشَارَ الرَّجُلُ بِإِصْبَعِہِ فِی الصَّلاَۃ فَہُوَ حَسَنٌ وَہُوَ التَّوْحِیدُ ، وَلَکِنْ لاَ یُشِیرُ بِإِصْبَعَیْہِ ، فَإِنَّہُ یُکْرَہُ۔","","Musannaf Ibn Abi Shaybah 8523","","","كتاب الجمعة"
"8524","(۸۵۲۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ : أَنَّ أَبَاہُ کَانَ یُشِیرُ بِإِصْبَعِہِ فِی الدُّعَائِ ، وَلاَ یُحَرِّکُہَا۔","","Musannaf Ibn Abi Shaybah 8524","","","كتاب الجمعة"
"8525","(۸۵۲۵) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ، عَنْ مَعْبَدِ بْنِ خَالِدٍ، عَنْ قَیْسِ بْنِ سَعْدٍ، قَالَ: کَانَ لاَ یُزَادُ ہَکَذَا وَأَشَارَ بِإِصْبَعِہِ۔","","Musannaf Ibn Abi Shaybah 8525","","","كتاب الجمعة"
"8526","(۸۵۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عَاصِمِ بْنِ قُدَامَۃَ ، عَنْ مَالِکِ بْنِ نُمَیْرٍ الْخُزَاعِیِّ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَالِسًا فِی الصَّلاَۃ وَاضِعًا یَدَہُ الْیُمْنَی عَلَی فَخِذِہِ یُشِیرُ بِإِصْبَعِہِ۔ (ابوداؤد ۹۸۳۔ ابن حبان ۱۹۴۶)","Da'if","Musannaf Ibn Abi Shaybah 8526","","","كتاب الجمعة"
"8527","(۸۵۲۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی سَعْدًا یَدْعُو بِإِصْبَعَیْہِ، فَقَالَ : أَحِّدْ ، أَحِّدْ۔","","Musannaf Ibn Abi Shaybah 8527","","","كتاب الجمعة"
"8528","(۸۵۲۸) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ عَامِرِ بْنِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، عَنْ أَبِیہِ ،قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، إِذَا قَعَدَ یَدْعُو، وَضَعَ یَدَہُ الْیُمْنَی عَلَی فَخِذِہِ الْیُمْنَی ، وَیَدَہُ الْیُسْرَی عَلَی فَخِذِہِ الْیُسْرَی ، وَأَشَارَ بِإِصْبَعِہِ السَّبَّابَۃِ ، وَوَضَعَ إِبْہَامَہُ عَلَی إِصْبَعِہِ الْوُسْطَی ، وَیُلْقِمُ کَفَّہُ الْیُسْرَی رُکْبَتَہُ۔n(مسلم ۱۱۳۔ ابوداؤد ۹۸۰)","Hasan","Musannaf Ibn Abi Shaybah 8528","","","كتاب الجمعة"
"8529","(۸۵۲۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، عَنْ وَائِلِ بْنِ حُجْرٍ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَاضِعًا حَدَّ مِرْفَقہِ الأَیْمَنَ عَلَِ فَخِذِہِ الْیُمْنَی ، وَحَلَّقَ بِالإِبْہَامِ وَالْوُسْطَی ، وَرَفَعَ الَّتِی تَلِی الإِبْہَامَ یَدْعُو بِہَا۔ (ابوداؤد ۷۲۶۔ احمد ۴/۳۱۹)","Hasan","Musannaf Ibn Abi Shaybah 8529","","","كتاب الجمعة"
"8530","(۸۵۳۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ سُلَیْمَانَ بْنِ عَمْرِو بْنِ الأَحْوَص ، قَالَ : أَخْبَرَنِی أَبُو ہِلاَلٍ ، عَنْ أَبِی بَرْزَۃَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دَعَا عَلَی رَجُلَیْنِ فَرَفَعَ یَدَیْہِ۔ (ابویعلی ۷۴۴۰)","Da'if","Musannaf Ibn Abi Shaybah 8530","","","كتاب الجمعة"
"8531","(۸۵۳۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیرِیِّ ، عَنْ حَیَّانَ بْنِ عُمَیْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَمُرَۃَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَفَعَ یَدَیْہِ ، یَعْنِی فِی الدُّعَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 8531","","","كتاب الجمعة"
"8532","(۸۵۳۲) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ مُعَاوِیَۃَ ، عَنِ ابْنِ أَبِی ذُبابٍ ، عَنْ سَہْلِ بْنِ سَعْدٍ ، قَالَ : مَا رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ شَاہِرًا یَدَیْہِ فِی الدُّعَائِ عَلَی مِنْبَرٍ وَلاَ غَیْرِہِ ، وَلَقَدْ رَأَیْتُ یَدَیْہِ حَذْوَ مَنْکِبَیْہِ وَیَدْعُو۔ (ابوداؤد ۱۰۹۸۔ احمد ۵/۳۳۷)","Da'if","Musannaf Ibn Abi Shaybah 8532","","","كتاب الجمعة"
"8533","(۸۵۳۳) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ لاَ یَرْفَعُ یَدَیْہِ فِی شَیْئٍ مِنَ الدُّعَائِ إِلاَّ فِی الاِسْتِسْقَائِ۔ (بخاری ۱۰۳۱۔ ابوداؤد ۱۱۶۳)","Sahih","Musannaf Ibn Abi Shaybah 8533","","","كتاب الجمعة"
"8534","(۸۵۳۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ تَمِیمِ بْنِ طَرَفَۃَ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : خَرَجَ عَلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : مَا لِی أَرَاکُمْ رَافِعِی أَیْدِیکُمْ کَأَنَّہَا أَذْنَابُ خَیْلٍ شُمْسٍ ، اُسْکُنُوا فِی الصَّلاَۃ۔ (مسلم ۱۱۹۔ ابوداؤد ۹۰۹)","Sahih","Musannaf Ibn Abi Shaybah 8534","","","كتاب الجمعة"
"8535","(۸۵۳۵) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : سُئِلَ ہَلْ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَرْفَعُ یَدَیْہِ ؟ فَقَالَ : نَعَمْ شَکَا إلَیْہِ النَّاسُ ذَاتَ جُمُعَۃٍ فَقَالُوا : یَا رَسُولَ اللہِ قَحَطَ الْمَطَرُ وَأَجْدَبَتِ الأَرْضُ وَہَلَکَ الْمَالُ ، قَالَ : فَرَفَعَ یَدَیْہِ وَدَعَا حَتَّی رَأَیْتُ بَیَاضَ إبِطَیْہِ۔ (بخاری ۶۱۲۔ مسلم ۶۱۲)","Sahih","Musannaf Ibn Abi Shaybah 8535","","","كتاب الجمعة"
"8536","(۸۵۳۶) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ قَالَ : لاَ تقُومُوا تَدْعُونَ کَمَا تَصْنَعُ الْیَہُودُ فِی کَنَائِسِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 8536","","","كتاب الجمعة"
"8537","(۸۵۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنِ ابْنِ الأَصْبَہَانِیِّ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ : أَنَّہُ رَأَی رَجُلاً یَدْعُو قَائِمًا بَعْدَ مَا انْصَرَفَ فَسَبَّہُ ، أَوْ شَتَمَہُ۔","","Musannaf Ibn Abi Shaybah 8537","","","كتاب الجمعة"
"8538","(۸۵۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنِ الْحَکَمِ ، عَنْ عَبْدَۃَ بْنِ أَبِی لُبَابَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 8538","","","كتاب الجمعة"
"8539","(۸۵۳۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ ، قَالَ : ثِنْتَانِ ہُمَا بِدْعَۃٌ أَنْ یَقُومَ الرَّجُلُ بَعْدَ مَا یَفْرُغُ مِنْ صَلاَتِہِ مُسْتَقْبِلَ الْقِبْلَۃِ یَدْعُو وَأَنْ یَسْجُدَ السَّجْدَۃَ الثَّانِیَۃَ فَیَرَی أَنَّ حَقًّا عَلَیْہِ أَنْ یُلْزِقَ أَلْیَتَیْہِ بِالأَرْضِ قَبْلَ أَنْ یَنْہَضَ۔","","Musannaf Ibn Abi Shaybah 8539","","","كتاب الجمعة"
"8540","(۸۵۴۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، أَنَّہُ کَانَ یَکْرَہُ الْقِیَامَ بَعْدَہَا یَتَشَبَّہُ بِالْیَہُودِ۔","","Musannaf Ibn Abi Shaybah 8540","","","كتاب الجمعة"
"8541","(۸۵۴۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : قُلْتُ لِلْمُغِیرَۃِ : أَکَانَ إبْرَاہِیمُ یَکْرَہُ إذَا انْصَرَفَ أَنْ یَقُومَ مُسْتَقْبِلَ الْقِبْلَۃِ یَرْفَعُ یَدَیْہِ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 8541","","","كتاب الجمعة"
"8542","(۸۵۴۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، عَنْ عَبْدِ اللہِ : أَنَّہُ بَلَغَہُ أَنَّ قَوْمًا یَذْکُرُونَ اللَّہَ قِیَامًا فَأَتَاہُمْ، فَقَالَ : مَا ہَذِہِ النَّکْرَاء ؟ قَالُوا : سَمِعْنَا اللَّہَ یَقُولُ : {فَاذْکُروا اللَّہَ قِیَامًا وَقُعُودًا وَعَلَی جُنُوبِکمْ} ، فَقَالَ : ہَذَا إنَّمَا إذَا لَمْ یَسْتَطِعِ الرَّجُلُ أَنْ یُصَلِّیَ قَائِمًا صَلَّی قَاعِدًا۔","Da'if","Musannaf Ibn Abi Shaybah 8542","","","كتاب الجمعة"
"8543","(۸۵۴۳) حَدَّثَنَا عَبَّادُ بْنُ العَوَّامِ ، عَنْ جَمِیلِ بْنِ زَیْدٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ دَخَلَ الْبَیْتَ فَصَلَّی رَکْعَتَیْنِ ، ثُمَّ تَحَوَّلَ فَصَلَّی رَکْعَتَیْنِ مِمَّا یَلِی الرُّکْنَ ، ثُمَّ خَرَجْتُ وَتَرَکْتُہُ قَائِمًا یَدْعُو وَیُکَبِّرُ۔","Da'if","Musannaf Ibn Abi Shaybah 8543","","","كتاب الجمعة"
"8544","(۸۵۴۴) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، قَالَ : رَأَیْتُُ الْحَسَنَ یَرْفَعُ بَصَرَہُ إلَی السَّمَائِ فِی الصَّلاَۃ یَدْعُو وَہُوَ قَائِمٌ۔","","Musannaf Ibn Abi Shaybah 8544","","","كتاب الجمعة"
"8545","(۸۵۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ مُجَاہِدٍ : أَنَّہُ سَمِعَ رَجُلاً یَرْفَعُ صَوْتَہُ بِالدُّعَائِ ، فَرَمَاہُ بِالْحَصَی۔","","Musannaf Ibn Abi Shaybah 8545","","","كتاب الجمعة"
"8546","(۸۵۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : أَیُّہَا النَّاسُ إنَّکُمْ لاَ تَدْعُونَ أَصَمَّ وَلاَ غَائِبًا ، یَعْنِی فِی رَفْعِ الصَّوْتِ بِالدُّعَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 8546","","","كتاب الجمعة"
"8547","(۸۵۴۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنْ یَزِیدَ بْنِ أَبَانَ ، عَنْ أَنَسٍ ۔ وَعَنْ رَبِیعٍ ، عَنِ الْحَسَنِ : أَنَّہُمَا کَرِہَا أَنْ یُسْمِعَ الرَّجُلُ جَلِیسَہُ شَیْئًا مِنَ الدُّعَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 8547","","","كتاب الجمعة"
"8548","(۸۵۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مُبَارَکٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانُوا یَجْتَہِدُونَ فِی الدُّعَائِ ، وَلاَ تَسْمَعُ إِلاَّ ہَمْسًا۔","","Musannaf Ibn Abi Shaybah 8548","","","كتاب الجمعة"
"8549","(۸۵۴۹) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ صَدَقَۃَ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّ الْمُصَلِّیَ إذَا صَلَّی یُنَاجِی رَبَّہُ فَلْیَعْلَمْ أَحَدُکُمْ بِمَا یُنَاجِیہِ ، وَلاَ یَجْہَرْ بَعْضُکُمْ عَلَی بَعْضٍ۔ (احمد ۲/۶۷۔ بزار ۷۲۶)","Da'if","Musannaf Ibn Abi Shaybah 8549","","","كتاب الجمعة"
"8550","(۸۵۵۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، وَأَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، عَنْ أَبِی مُوسَی ، قَالَ : کُنَّا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ فَجَعَلَ النَّاسُ یَجْہَرُونَ بِالتَّکْبِیرِ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَیُّہَا النَّاسُ ارْبَعُوا عَلَی أَنْفُسِکُمْ إِنَّکم لَیْسَ تَدْعُونَ أَصَمَّ ، وَلاَ غَائِبًا إنَّکُمْ تَدْعُونَ سَمِیعًا قَرِیبًا وَہُوَ مَعَکُمْ۔ (بخاری ۲۹۹۲۔ ابوداؤد ۱۵۲۳)","Sahih","Musannaf Ibn Abi Shaybah 8550","","","كتاب الجمعة"
"8551","(۸۵۵۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ نُسَیْبٍ قَالَ : صَلَّیْتُ إلَی جَنْبِ سَعِیدِ بْنِ الْمُسَیَّبِ الْمَغْرِبَ ، فَلَمَّا جَلَسْتُ فِی الرَّکْعَۃِ الثَّانِیۃ رَفَعْتُ صَوْتِی بِالدُّعَائِ فَانْتَہَرَنِی ، فَلَمَّا انْصَرَفْتُ قُلْتُ لَہُ : مَا کَرِہْتَ مِنِّی؟ قَالَ : ظَنَنْتَ أَنَّ اللَّہَ لَیْسَ بِقَرِیبٍ مِنْکَ؟۔","","Musannaf Ibn Abi Shaybah 8551","","","كتاب الجمعة"
"8552","(۸۵۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زَیْدٍ الْعَمِّیِّ ، عَنْ أَبِی إیَاسٍ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الدُّعَائُ بَیْنَ الأَذَانِ وَالإِقَامَۃِ لاَ یُرَدُّ۔ (ترمذی ۲۱۲۔ احمد ۳/۱۱۹)","Da'if","Musannaf Ibn Abi Shaybah 8552","","","كتاب الجمعة"
"8553","(۸۵۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ أَبِی مُرَارَۃَ ، عَنْ مُجَاہِدٍ ، قَالَ : أَفْضَلُ السَّاعَاتِ مَوَاقِیتُ الصَّلَوَاتِ فَادْعُوا فِیہَا۔","","Musannaf Ibn Abi Shaybah 8553","","","كتاب الجمعة"
"8554","(۸۵۵۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنْ مُحَارِبٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ یُسْتَحَبُّ الدُّعَائُ عِنْدَ أَذَانِ الْمَغْرِبِ ، وَقَالَ : إِنَّہَا سَاعَۃٌ یُسْتَجَابُ فِیہَا الدُّعَائُ۔","Da'if","Musannaf Ibn Abi Shaybah 8554","","","كتاب الجمعة"
"8555","(۸۵۵۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ زِیَادِ بْنِ أَنْعُمٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ رَافِعٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرو ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا جَلَسَ الإِمَام ثُمَّ أَحْدَثَ فَقَدْ تَمَّتْ صَلاَتُہُ وَمَنْ کَانَ خَلْفَہُ مِمَّنْ أَدْرَکَ مَعَہُ الصَّلاَۃ عَلَی مِثْلِ ذَلِکَ۔ (ترمذی ۴۰۸۔ ابوداؤد ۶۱۷)","Da'if","Musannaf Ibn Abi Shaybah 8555","","","كتاب الجمعة"
"8556","(۸۵۵۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا جَلَسَ الإِمَام فِی الرَّابِعَۃِ ، ثُمَّ أَحْدَثَ فَقَدْ تَمَّتْ صَلاَتُہُ فَلْیَقُمْ حَیْثُ شَائَ۔","Da'if","Musannaf Ibn Abi Shaybah 8556","","","كتاب الجمعة"
"8557","(۸۵۵۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی إِسْحَاقَ الْکُوفِی ، عَنْ أَبِی سَعِیدٍ ، عَنْ عَلِیٍّ ، قَالَ : إذَا رَعَفَ فِی صَلاَتہِ بَعْدَ السَجْدَۃِ الآخِرَۃِ فَقَدْ تَمَّتْ صَلاَتُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 8557","","","كتاب الجمعة"
"8558","(۸۵۵۸) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ ، قَالاَ : إذَا رَفَعَ رَأْسَہُ ، ثُمَّ أَحْدَثَ فَقَدْ أَجْزَأَتْہُ صَلاَتُہُ۔","","Musannaf Ibn Abi Shaybah 8558","","","كتاب الجمعة"
"8559","(۸۵۵۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا رَفَعَ رَأْسَہُ مِنَ السَّجْدَۃِ فَقَدْ مَضَتْ صَلاَتُہُ۔","","Musannaf Ibn Abi Shaybah 8559","","","كتاب الجمعة"
"8560","(۸۵۶۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : إذَا جَلَسَ بَعْدَ تَمَامِ الصَّلاَۃ فَأَحْدَثَ قبْلَ أَنْ یَتَشَہَّدَ أَوْ بَعْدَ التَّشَہُّدِ قَبْلَ أَنْ یُسَلِّمَ الإِمَام ، فَقَدْ جَازَتْ وَلْیَنْصَرِفْ۔","","Musannaf Ibn Abi Shaybah 8560","","","كتاب الجمعة"
"8561","(۸۵۶۱) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ طَلْحَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَتَمَّ الرُّکُوعَ وَالسُّجُودَ ، ثُمَّ أَحْدَثَ فَقَدِ انْقَضَتْ صَلاَتُہُ وَإِنْ لَمْ یَتَشَہَّدْ۔","","Musannaf Ibn Abi Shaybah 8561","","","كتاب الجمعة"
"8562","(۸۵۶۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا رَعَفَ بَعْدَ مَا یَفْرُغُ مِنَ السَّجْدَۃِ الأَخِرَۃِ فَلْیَنْصَرِفْ فَلْیَتَوَضَّأْ وَلْیَرْجِعْ فَلْیَتَشَہَّدْ مَا لَمْ یَتَکَلَّمْ ، فَإِنْ تَکَلَّمَ اسْتَأْنَفَ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8562","","","كتاب الجمعة"
"8563","(۸۵۶۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 8563","","","كتاب الجمعة"
"8564","(۸۵۶۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ ابْنِ سِیرِینَ أَنَّہُ کَانَ یَقُولُ : حَتَّی یُسَلِّمَ۔","","Musannaf Ibn Abi Shaybah 8564","","","كتاب الجمعة"
"8565","(۸۵۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مَعْقِلٍ ، عَنْ عَطَائٍ : فِی الرَّجُلِ یُحْدِثُ ، قَالَ : إذَا قَالَ : السَّلاَمُ عَلَیْنَا وَعَلَی عِبَادِ اللہِ الصَّالِحِینَ أَجْزَأَہُ۔","","Musannaf Ibn Abi Shaybah 8565","","","كتاب الجمعة"
"8566","(۸۵۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، قَالاَ : حتَّی یَتَشَہَّدَ ، أَوْ یَقْعُدَ مِقْدَارَ التَّشَہُّدِ۔","","Musannaf Ibn Abi Shaybah 8566","","","كتاب الجمعة"
"8567","(۸۵۶۷) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ فِی الرَّجُلِ یَتَشَہَّدُ ثُمَّ یُحْدِثُ ، قَالَ : ہَذَا قَدْ تَمَّتْ صَلاَتُہُ۔","","Musannaf Ibn Abi Shaybah 8567","","","كتاب الجمعة"
"8568","(۸۵۶۸) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنِ ابْنِ الْمُسَیَّبِ ، قَالَ : ہَلْ تَعْلَمُونَ صَلاَۃً یُقْعَدُ فِیہَا کُلِّہَا ؟ فَقَالَ : ذَلکَ رَجُلٌ أَدْرَکَ مِنَ الْمَغْرِبِ رَکْعَۃً فَیَقْعُدُ فِیہِنَّ جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 8568","","","كتاب الجمعة"
"8569","(۸۵۶۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : أَدْرَکَ مَسْرُوقٌ وَجُنْدُبٌ رَکْعَۃً مِنَ الْمَغْرِبِ ، فَلَمَّا سَلَّمَ الإِمَام قَامَ مَسْرُوقٌ فَأَضَافَ إلَیْہَا رَکْعَۃً ، ثُمَّ جَلَسَ وَقَامَ جُنْدُبٌ فِیہِما جَمِیعًا ، ثُمَّ جَلَسَ فِی آخِرِہَا فَذَکَرَ ذَلِکَ لِعَبْدِ اللہِ ، فَقَالَ : کِلاَہُمَا قَدْ أَحْسَنَ وَأَفْعَلُ کَمَا فَعَلَ مَسْرُوقٌ أَحَبُّ إلَیَّ۔","","Musannaf Ibn Abi Shaybah 8569","","","كتاب الجمعة"
"8570","(۸۵۷۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ : أَنَّ جُنْدُبًا وَمَسْرُوقًا خَرَجَا یُرِیدَانِ صَلاَۃَ الْمَغْرِبِ فَأَدْرَکَا مَعَ الإِمَامِ رَکْعَۃً ، فَلَمَّا سَلَّمَ الإِمَام جَلَسَ مَسْرُوقٌ فِی الرَّکْعَۃِ الثَّانِیَۃِ ، وَلَمْ یَجْلِسْ جُنْدُبٌ ، قَالَ وَقَرَأَ جُنْدُبٌ فِی الرَّکْعَۃِ الَّتِی أَدْرَکَ وَلَمْ یَقْرَأْ مَسْرُوقٌ ، فَأَتَیَا ابْنَ مَسْعُودٍ فَذَکَرَا لَہُ مَا صَنَعَا ، فَقَالَ عَبْدُ اللہِ : کِلاَکُمَا قَدْ أَحْسَنَ وَأَفْعَلُ کَمَا فَعَلَ مَسْرُوقٌ۔","","Musannaf Ibn Abi Shaybah 8570","","","كتاب الجمعة"
"8571","(۸۵۷۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی یَحْیَی ، قَالَ : حدَّثَنَا أَبو الْمُثَنَّی الْجُہَنِیُّ ، عَنْ سَعْدٍ قَالَ : إذَا أَدْرَکَ مَعَ الإِمَامِ رَکْعَۃً مِنَ الأَرْبَعِ فَلاَ یَقْعُدُ إِلاَّ فِی آخِرہنَّ ، فَإِنَّہ لاَ یُقْعَدُ مِنَ الصَّلاَۃ إِلاَّ فِی قَعدَتَیْن۔","Sahih","Musannaf Ibn Abi Shaybah 8571","","","كتاب الجمعة"
"8572","(۸۵۷۲) حَدَّثَنَا یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ : فِی الرَّجُلِ یُدْرِکُ رَکْعَۃً مِنَ الْمَغْرِبِ ، قَالَ : یَقْعُدُ فِی کُلِّہِنَّ۔","","Musannaf Ibn Abi Shaybah 8572","","","كتاب الجمعة"
"8573","(۸۵۷۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابن أَبِی لَبِیدٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ عَائِشَۃَ ، قُلْتُ : أَخْبِرِینِی عَنْ صَلاَۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَتْ : کَانَتْ صَلاَتُہُ بِاللَّیْلِ فِی رَمَضَانَ وَغَیْرِہِ ثَلاَثَ عَشْرَۃَ رَکْعَۃً مِنْہَا رَکْعَتَا الْفَجْرِ۔ (ترمذی ۴۳۹۔ ابوداؤد ۱۳۳۵)","Sahih","Musannaf Ibn Abi Shaybah 8573","","","كتاب الجمعة"
"8574","(۸۵۷۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی جَمْرَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ سَمِعْتُہُ یَقُولُ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی مِنَ اللَّیْلِ ثَلاَثَ عَشْرَۃَ رَکْعَۃً۔ (بخاری ۱۱۳۸۔ مسلم ۱۹۴)","Sahih","Musannaf Ibn Abi Shaybah 8574","","","كتاب الجمعة"
"8575","(۸۵۷۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ شُرَحْبِیلَ ، عَنْ جَابِرٍ ، قَالَ : أَقْبَلْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنَ الْحُدَیْبِیَۃِ حَتَّی إذَا کُنَّا بِالصَّہْبَائِ قَالَ مُعَاذٌ : مَنْ یُسْقِینَا فِی أَسْقِیَتِنَا ، قَالَ : فَخَرَجْتُ فِی فِتْیَانٍ مَعِی حَتَّی أَتَیْنا الأُثایَۃَ فَأَسْقَیْنَا وَاسْتَقَیْنَا ، فَلَمَّا کَانَ بَعْدَ عَتَمَۃٍ مِنَ اللَّیْلِ فَإِذَا رَجُلٌ یُنَازِعُہُ بَعِیرُہُ الْمَائَ ، قَالَ : فَإِذَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَأَخَذْتُ رَاحِلَتَہُ فَأَنَخْتُہَا فَتَقَدَّمَ فَصَلَّی الْعِشَائَ وَأَنَا عَنْ یَمِینِہِ ، ثُمَّ صَلَّی ثَلاَثَ عَشْرَۃَ رَکْعَۃً۔ (احمد ۳/۳۸۰۔ ابویعلی ۲۲۱۳)","Da'if","Musannaf Ibn Abi Shaybah 8575","","","كتاب الجمعة"
"8576","(۸۵۷۶) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سَعِیدِ بْنِ مَسْرُوقٍ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ أَبِی رِشْدِینَ کُرَیْبٍ مَوْلَی ابْنِ عَبَّاسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : بِتّ عِنْدَ خَالَتِی مَیْمُونَۃَ وَبَاتَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عِنْدَہَا فَرَأَیْتُہُ قَامَ مِنَ اللَّیْلِ قَوْمَۃً فَصَلَّی إمَّا إحْدَی عَشْرَۃَ رَکْعَۃً وَإِمَّا ثَلاَثَ عَشْرَۃَ رَکْعَۃً۔(بخاری ۶۳۱۶۔ مسلم ۱۸۱)","Sahih","Musannaf Ibn Abi Shaybah 8576","","","كتاب الجمعة"
"8577","(۸۵۷۷) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی بِاللَّیْلِ تِسْعَ رَکَعَاتٍ۔ (ترمذی ۴۴۳۔ احمد ۶/۲۵۳)","Sahih","Musannaf Ibn Abi Shaybah 8577","","","كتاب الجمعة"
"8578","(۸۵۷۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : صَلَّی عُمَرُ صَلاَۃً عِنْدَ الْبَیْتِ فَقَرَأَ {لإِیلاَفِ قُرَیْشٍ} فَجَعَلَ یُومِیئُ إلَی الْبَیْتِ وَیَقُولُ : {فَلْیَعْبُدُوا رَبَّ ہَذَا الْبَیْتِ الَّذِی أَطْعَمَہُمْ مِنْ جُوعٍ وَآمَنَہُمْ مِّنْ خَوْفٍ}۔","","Musannaf Ibn Abi Shaybah 8578","","","كتاب الجمعة"
"8579","(۸۵۷۹) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنِ النُّعْمَانِ بْنِ سَالِمٍ، عَنِ ابْنِ أَبِی أَوْسٍ، قَالَ: کَانَ جَدِّی أَوْسٌ أَحْیَانًا یُصَلِّی فَیُشِیرُ إلَیَّ وَہُوَ فِی الصَّلاَۃ فَأُعْطِیہِ نَعْلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 8579","","","كتاب الجمعة"
"8580","(۸۵۸۰) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، عَنْ ہِشَامٍ ، قَالَ : کَانَ أَبِی یُومِیئُ فِی الصَّلاَۃ ، قَالَ : وکَانَتْ عَائِشَۃُ تَفْعَلُہُ۔","","Musannaf Ibn Abi Shaybah 8580","","","كتاب الجمعة"
"8581","(۸۵۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بالإِیمَائِ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8581","","","كتاب الجمعة"
"8582","(۸۵۸۲) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، قَالَ : أَصَابَنِی رُعَافٌ وَأَنَا أَطُوفُ بِالْبَیْتِ فَمَرَرْتُ بِطَاوُوس وَہُوَ یُصَلِّی فَأَشَارَ إلَیَّ أَنِ اغْسِلْہُ بِالْمَائِ ، ثُمَّ عُدْ۔","","Musannaf Ibn Abi Shaybah 8582","","","كتاب الجمعة"
"8583","(۸۵۸۳) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ رُبَّمَا أَشَارَ بِیَدِہِ وَہُوَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8583","","","كتاب الجمعة"
"8584","(۸۵۸۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : الرَّجُلُ یُشِیرُ إلَی الشَّیْئِ فِی الصَّلاَۃ ؟ قَالَ : إنَّ فِی الصَّلاَۃ لَشُغْلاً۔","","Musannaf Ibn Abi Shaybah 8584","","","كتاب الجمعة"
"8585","(۸۵۸۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُومِیئَ الرَّجُلُ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8585","","","كتاب الجمعة"
"8586","(۸۵۸۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ الأَجْلَحِ ، عَنْ عَطَائٍ ، قَالَ :قُلْت لَہُ : تَکُونُ لِی الْحَاجَۃُ وَأَنَا فِی الصَّلاَۃ فَأُومِیئُ إلَی الْجَارِیَۃِ بِیَدَیَّ ، قَالَ : إنَّا لنَفْعَلُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 8586","","","كتاب الجمعة"
"8587","(۸۵۸۷) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنْ أَبِی إِسْحَاقَ، قَالَ: رَأَیْتُُ عَمْرَو بْنَ مَیْمُونٍ وَہُوَ یُصَلِّی فَأَوْمَأَ إلَی رَجُلٍ بِیَدِہِ۔","","Musannaf Ibn Abi Shaybah 8587","","","كتاب الجمعة"
"8588","(۸۵۸۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ قَالَ : صُرِعَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ فَرَسٍ لَہُ فَوَقَعَ عَلَی جِذْعِ نَخْلَۃٍ فَانْفَکَّتْ قَدَمُہُ ، فَدَخَلْنَا عَلَیْہِ نَعُودُہُ وَہُوَ یُصَلِّی فِی مَشْرُبَۃٍ لِعَائِشَۃَ جَالِسًا فَصَلَّیْنَا بِصَلاَتِہِ وَنَحْنُ قِیَامٌ ، ثُمَّ دَخَلْنَا عَلَیْہِ مَرَّۃً أُخْرَی وَہُوَ یُصَلِّی جَالِسًا فَصَلَّیْنَا بِصَلاَتِہِ وَنَحْنُ قِیَامٌ فَأَوْمَأَ إلَیْنَا أَنِ اجْلِسُوا۔","Hasan","Musannaf Ibn Abi Shaybah 8588","","","كتاب الجمعة"
"8589","(۸۵۸۹) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتِ : اشْتَکَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَدَخَلَ عَلَیْہِ نَاسٌ مِنْ أَصْحَابِہِ یَعُودُونَہُ ، فَصَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَالِسًا فَصَلَّوْا بِصَلاَتِہِ قِیَامًا فَأَشَارَ إلَیْہِمْ أَنِ اجْلِسُوا فَجَلَسُوا۔","Sahih","Musannaf Ibn Abi Shaybah 8589","","","كتاب الجمعة"
"8590","(۸۵۹۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إبْرَاہِیمَ : أَنَّہُ سُئِلَ عَنِ الإِیمَائِ فِی الصَّلاَۃ ؟ فَقَالَ : إنَّ فِی الصَّلاَۃ لَشُغْلاً۔","","Musannaf Ibn Abi Shaybah 8590","","","كتاب الجمعة"
"8591","(۸۵۹۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ عُثْمَانَ بْنِ عَبْدِ اللہِ بْنِ سُرَاقَۃَ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : رَأَیْتُُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی عَلَی رَاحِلَتِہِ نَحْوَ الْمَشْرِقِ فِی غَزْوَۃِ أَنْمَارٍ۔ (بخاری۴۱۴۰۔ احمد ۳/۳۰۰)","Sahih","Musannaf Ibn Abi Shaybah 8591","","","كتاب الجمعة"
"8592","(۸۵۹۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنْ عَطِیَّۃَ ، عَنْ أَبِی سَعِیدٍ ۔ وَعَنِ ابْنِ أَبِی لَیْلَی ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَنَّہُ کَانَ یُصَلِّی عَلَی رَاحِلَتِہِ التَّطَوُّعَ فِی السَّفَرِ حَیْثُ تَوَجَّہَتْ بِہِ یُومِیئُ إیمَائً ، السُّجُودُ أَخْفَضُ مِنَ الرُّکُوعِ۔ (مسلم ۳۲)","Da'if","Musannaf Ibn Abi Shaybah 8592","","","كتاب الجمعة"
"8593","(۸۵۹۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَمْرٍو بنِ یَحْیَی بْنِ عُمَارَۃَ الْمَازِنِیِّ ، عَنْ سَعِیدِ بْنِ یَسَارٍ ، عَنِ ابْنِ عُمَرَ قَالَ : رَأَیْتُُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی عَلَی حِمَارٍ نَحْوَ الْمَشْرِقِ وَہُوَ مُتَوَجِّہٌ إلَی خَیْبَرَ۔ (مسلم ۴۸۷۔ ابوداؤد ۱۲۱۹)","Sahih","Musannaf Ibn Abi Shaybah 8593","","","كتاب الجمعة"
"8594","(۸۵۹۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ قَالَ : بَعَثَنِی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی حَاجَۃٍ ، قَالَ : فَجِئْتُہُ وَہُوَ یُصَلِّی عَلَی رَاحِلَتِہِ نَحْوَ الْمَشْرِقِ وَالسُّجُودُ أَخْفَضُ مِنَ الرُّکُوعِ۔ (ترمذی ۳۵۱۔ ابوداؤد ۱۲۲۰)","Sahih","Musannaf Ibn Abi Shaybah 8594","","","كتاب الجمعة"
"8595","(۸۵۹۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی عَلَی رَاحِلَتِہِ فِی السَّفَرِ حَیْثُمَا تَوَجَّہَتْ بِہِ۔ (مالک ۲۶)","Sahih","Musannaf Ibn Abi Shaybah 8595","","","كتاب الجمعة"
"8596","(۸۵۹۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : کَانَ عَلِیٌّ یُصَلِّی عَلَی رَاحِلَتِہِ حَیْثُ تَوَجَّہَتْ بِہِ ، وَیَجْعَلُ السُّجُودَ دُونَ الرُّکُوع۔","Da'if","Musannaf Ibn Abi Shaybah 8596","","","كتاب الجمعة"
"8597","(۸۵۹۷) حَدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ : أَنَّ أَبَا ذَرٍّ کَانَ یُصَلِّی عَلَی رَاحِلَتِہِ وَہُوَ قِبَلَ الْمَشْرِقِ وَہُوَ یَخْفِقُ بِرَأْسِہِ فَقِیلَ لَہُ : کُنْتَ نَائِمًا ؟ قَالَ : لاَ وَلَکِنْ کُنْتُ أُصَلِّی۔","Sahih","Musannaf Ibn Abi Shaybah 8597","","","كتاب الجمعة"
"8598","(۸۵۹۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنَ أَبِی کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ جَابِرٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی عَلَی رَاحِلَتِہِ نَحْوَ الْمَشْرِقِ فَإِذَا أَرَادَ أَنْ یُصَلِّیَ الْمَکْتُوبَۃَ نَزَلَ فَاسْتَقْبَلَ الْقِبْلَۃَ۔ (بخاری ۱۰۹۹۔ مسلم ۳۸۳)","Sahih","Musannaf Ibn Abi Shaybah 8598","","","كتاب الجمعة"
"8599","(۸۵۹۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ رِبْعِیِّ بْنِ الْجَارُودِ بْنِ أَبِی سَبْرَۃَ التَّمِیمِیِّ ، قَالَ : حدَّثَنِی عَمْرُو بْنُ أَبِی الْحَجَّاجِ ، عَنِ الْجَارُودِ بْنِ أَبِی سَبْرَۃَ ، عَنْ أَنَسِ بْنِ مَالِکٍ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا أَرَادَ أَنْ یُصَلِّیَ عَلَی رَاحِلَتِہِ تَطَوُّعًا اسْتَقْبَلَ الْقِبْلَۃَ فَکَبَّرَ لِلصَّلاَۃِ ، ثُمَّ صَلَّی عَلی رَاحِلَتِہِ فَصَلَّی حَیْثُمَا تَوَجَّہَتْ بِہِ۔ (ابوداؤد ۱۲۱۸۔ دارقطنی ۳۹۵)","Hasan","Musannaf Ibn Abi Shaybah 8599","","","كتاب الجمعة"
"8600","(۸۶۰۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَبْدِ الْمَلِکِ ، عَنِ ابْنِ جُبَیْرٍ ، عَنِ ابْنِ عُمَرَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی عَلَی رَاحِلَتِہ حَیْثُ تَوَجَّہَتْ بِہِ ، وَکَانَ ابْنُ عُمَرَ یَفْعَلُ ذَلِکَ۔ (مسلم ۴۸۶۔ ترمذی ۲۹۵۸)","Sahih","Musannaf Ibn Abi Shaybah 8600","","","كتاب الجمعة"
"8601","(۸۶۰۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یُونُسُ بْنُ الْحَارِثِ الطَّائِفِیُّ ، عَنْ أَبِی بُرْدَۃَ بْنِ أَبِی مُوسَی ، عَنْ أَبِیہِ : أَنَّہُ کَانَ یُصَلِّی عَلَی رَاحِلَتِہِ حَیْثُمَا تَوَجَّہَتْ بِہِ فِی السَّفَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 8601","","","كتاب الجمعة"
"8602","(۸۶۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ عَلِیِّ بْنِ عَتِیقٍ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِی مُوسَی : أَنَّہُ کَانَ یُصَلِّی عَلَی رَاحِلَتِہِ فِی السَّفَرِ حَیْثُمَا تَوَجَّہَتْ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 8602","","","كتاب الجمعة"
"8603","(۸۶۰۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : رَأَیْتُُ أَنَسًا یُصَلِّی عَلَی حِمَارٍ یُومِیئُ بِِغَیْرِ الْقِبْلَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 8603","","","كتاب الجمعة"
"8604","(۸۶۰۴) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا عُمَرُ بْنُ شَیْبَۃَ بْنِ قَارِظٍ ، عَنْ عَبْدِ اللہِ الْبَہِیِّ مَوْلَی آلِ الزُّبَیْرِ ، قَالَ : صَحِبْتُ عَبْدَ اللہِ بْنَ عُمَرَ مِنْ مَکَّۃَ إلَی الْمَدِینَۃِ ، فَکَانَ یُصَلِّی عَلَی رَاحِلَتِہِ إلَی غَیْرِ الْقِبْلَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 8604","","","كتاب الجمعة"
"8605","(۸۶۰۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ مُجَاہِدٍ قَالَ : صَحِبْتُ ابْنَ عُمَرَ مِنَ الْمَدِینَۃِ إلَی مَکَّۃَ ، فَکَانَ یُصَلِّی عَلَی دَابَّتِہِ حَیْثُ تَوَجَّہَتْ بِہِ ، فَإِذَا کَانَتِ الْفَرِیضَۃُ نَزَلَ فَصَلَّی۔","Sahih","Musannaf Ibn Abi Shaybah 8605","","","كتاب الجمعة"
"8606","(۸۶۰۶) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ : أَنَّ أَبَا أَیُّوبَ کَانَ یُصَلِّی عَلَی رَاحِلَتِہِ حَیْثُ تَوَجَّہَتْ بِہِ۔","","Musannaf Ibn Abi Shaybah 8606","","","كتاب الجمعة"
"8607","(۸۶۰۷) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الْعَلاَئِ بْنِ زَیْدٍ ، عَنِ الْحَسَنِ أَوْ غَیْرِہِ الشَّکُّ مِنِّی : أَنَّ أَصْحَابَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانُوا یُصَلُّونَ فِی أَسْفَارِہِمْ عَلَی دَوَابِّہِمْ حَیْثُمَا کَانَتْ وُجُوہُہُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 8607","","","كتاب الجمعة"
"8608","(۸۶۰۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یُصَلُّونَ عَلَی رَوَاحِلِہِمْ وَدَوَابِّہِمْ حَیْثُمَا کَانَتْ وُجُوہُہُمْ إِلاَّ الْمَکْتُوبَۃَ وَالْوِتْرَ ، فَإِنَّہُمْ کَانُوا یُصَلُّونَہُمَا بِالأَرْضِ۔","","Musannaf Ibn Abi Shaybah 8608","","","كتاب الجمعة"
"8609","(۸۶۰۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ: سَأَلْتُ الْقَاسِمَ بْنَ مُحَمَّدٍ یُصَلِّی الرَّجُلُ عَلَی رَاحِلَتِہِ ؟ قَالَ: نَعَمْ ، قُلْتُ : یُصَلِّی حَیْثُ کَانَ وَجْہُہُ ؟ قَالَ : نَعَمْ ، قُلْتُ : یَجْعَلُ السُّجُودَ أَخْفَضَ مِنَ الرُّکُوعِ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 8609","","","كتاب الجمعة"
"8610","(۸۶۱۰) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، عَنْ عَبِیْدَۃَ ، قَالَ :یُصَلِّی الرَّجُلُ عَلَی رَاحِلَتِہِ حَیْثُ کَانَ وَجْہُہُ ، فَإِذَا کَانَتِ الْفَرِیضَۃُ نَزَلَ۔","","Musannaf Ibn Abi Shaybah 8610","","","كتاب الجمعة"
"8611","(۸۶۱۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ حُمَیْدٍ ، عَنْ أَبِی جَعْفَرٍ مُحَمَّدِ بْنِ عَلِیٍّ : أَنَّ أَبَاہُ عَلِیَّ بْنَ حُسَیْنٍ کَانَ یُصَلِّی عَلَی رَاحِلَتِہِ فِی السَّفَرِ حَیْثُ تَوَجَّہَتْ بِہِ۔","","Musannaf Ibn Abi Shaybah 8611","","","كتاب الجمعة"
"8612","(۸۶۱۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ بُکَیْرِ بْنِ الأَخْنَسِ ، عَنْ رَجُلٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی فِی السَّفَرِ عَلَی رَاحِلَتِہِ حَیْثُ تَوَجَّہَتْ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 8612","","","كتاب الجمعة"
"8613","(۸۶۱۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَبِی الْہَزْہَازِ : سَأَلْتُ الضَّحَّاکَ عَنِ الصَّلاَۃ عَلَی الدَّابَّۃِ ؟ فَقَالَ : حیْثُ کَانَ وَجْہُہُ یَجْعَلُ السُّجُودَ أَسْفَلَ مِنَ الرُّکُوعِ۔","","Musannaf Ibn Abi Shaybah 8613","","","كتاب الجمعة"
"8614","(۸۶۱۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : کُنَّا نُصَلِّی عَلَی دَوَابِّنَا فِی الْغَزْوِ حَیْثُمَا تَوَجَّہْنا۔","","Musannaf Ibn Abi Shaybah 8614","","","كتاب الجمعة"
"8615","(۸۶۱۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، أَوْ حُدِّثْتُ عَنْہُ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرِ بْنِ رَبِیعَۃَ ، عَنْ أَبِیہِ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی عَلَی رَاحِلَتِہِ حَیْثُمَا تَوَجَّہَتْ بِہِ۔(بخاری ۱۰۹۷۔ مسلم ۴۰)","Da'if","Musannaf Ibn Abi Shaybah 8615","","","كتاب الجمعة"
"8616","(۸۶۱۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ قَالَتْ : مَا أُبَالِی صَلَّیْتُ فِی الْحِجْرِ أَوْ فِی الْکَعْبَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 8616","","","كتاب الجمعة"
"8617","(۸۶۱۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : مَا أُبَالِی صَلَّیْتُ فِی الْحِجْرِ أَوْ فِی الْبَیْتِ۔","Hasan","Musannaf Ibn Abi Shaybah 8617","","","كتاب الجمعة"
"8618","(۸۶۱۸) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ عَبْدِ الْمَلِکِ ، قَالَ : رَأَیْتُُ سَعِیدَ بْنَ جُبَیْرٍ إذَا قَضَی طَوَافَہُ دَخَلَ الْحِجْرَ فَصَلَّی فِیہِ، وَرَأَیْتُ عَلِیَّ بْنَ حُسَیْنٍ یَفْعَلُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 8618","","","كتاب الجمعة"
"8619","(۸۶۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلَ ، عَنِ الْہَیْثُمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : الْحِجْرُ مِنَ الْکَعْبَۃِ۔","","Musannaf Ibn Abi Shaybah 8619","","","كتاب الجمعة"
"8620","(۸۶۲۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ یَحْیَی بْنِ قِمطََۃَ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ : أَنَّہُ قَالَ فِی ہَذِہِ الآیَۃِ (فَلَنُوَلِّیَنَّکَ قِبْلَۃً تَرْضَاہَا) قَالَ : قِبْلَۃُ إبْرَاہِیمَ تَحْتَ الْمِیزَابِ ، یَعْنِی فِی الْحِجْرِ۔","Hasan","Musannaf Ibn Abi Shaybah 8620","","","كتاب الجمعة"
"8621","(۸۶۲۱) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا شَیْبَانُ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنِ الأَسْوَدِ بْنِ یَزِیدَ ، عَنْ عَائِشَۃَ : سَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْحِجْرِ ، فَقَالَ : ہُوَ مِنَ الْبَیْتِ۔ (بخاری ۷۲۴۳۔ مسلم ۴۰۵)","Sahih","Musannaf Ibn Abi Shaybah 8621","","","كتاب الجمعة"
"8622","(۸۶۲۲) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنِ الرَّجُلِ یَنْتَہِی إلَی الْقَوْمِ وَہُمْ جُلُوسٌ فَیُکَبِّرُ ثُمَّ یَجْلِسُ ؟ فَقَالاَ : إذَا قَامَ اعْتَدَّ بِتِلْکَ التَّکْبِیرَۃِ۔","","Musannaf Ibn Abi Shaybah 8622","","","كتاب الجمعة"
"8623","(۸۶۲۳) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی حَصِینٍ ، عَنْ یَحْیَی ، عَنْ مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ بنِ مَسْعُودٍ : أَنَّہُ کَرِہَ التَّعْشِیرَ فِی الْمُصْحَفِ۔","Sahih","Musannaf Ibn Abi Shaybah 8623","","","كتاب الجمعة"
"8624","(۸۶۲۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : کَانَ یُکْرَہُ التَّعْشِیرَ فِی الْمُصْحَفِ ، وَأَنْ یُکْتَبَ فِیہِ شَیْئٌ مِنْ غَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 8624","","","كتاب الجمعة"
"8625","(۸۶۲۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 8625","","","كتاب الجمعة"
"8626","(۸۶۲۶) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ : أَنَّہُ کَانَ یَکْرَہُ أَنْ یُکْتَبَ فِی الْمُصْحَفِ تَعْشِیرٌ أَوْ تَفْصِیل ، وَیَقُولَ : سُورَۃُ الْبَقَرَۃِ ، وَیَقُولُ : السُّورَۃُ الَّتِی یُذْکَرُ فِیہَا الْبَقَرَۃُ۔","","Musannaf Ibn Abi Shaybah 8626","","","كتاب الجمعة"
"8627","(۸۶۲۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ : أَنَّہُ کَانَ یَکْرَہُ التَّعْشِیرَ فِی الْمُصْحَفِ ، أَوْ یُکْتَبَ فِیہِ شَیْئٌ مِنْ غَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 8627","","","كتاب الجمعة"
"8628","(۸۶۲۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ، عَنِ الزِّبْرِقَانِ، قَالَ: قُلْتُ لأَبِی رَزِینٍ: إنَّ عِنْدِی مُصْحَفًا أُرِیدُ أَنْ أَخْتِمَہُ بِالذَّہَبِ وَأَکْتُبَ عِنْدَ أَوَّلِ کُل سُورَۃٍ آیَۃُ کَذَا وَکَذَا، قَالَ أَبُو رَزِینٍ: لاَ تَزِیدن فِیہِ شَیْئًا مِنَ الدُّنْیَا قَلَّ أَوْ کَثُرَ۔","","Musannaf Ibn Abi Shaybah 8628","","","كتاب الجمعة"
"8629","(۸۶۲۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ ہِشَامٍ، عَنْ مُحَمَّدٍ: أَنَّہُ کَانَ یَکْرَہُ الْفَوَاتِحَ وَالْعَوَاشِرَ الَّتِی فِیہَا قَافٌ وَکَافٌ۔","","Musannaf Ibn Abi Shaybah 8629","","","كتاب الجمعة"
"8630","(۸۶۳۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ، عَنْ حَجَّاجٍ، عَنْ شَیْخٍ، عَنْ عَبْدِ اللہِ: أَنَّہُ رَأَی خَطًّا فِی مُصْحَفٍ فَحَکَّہُ وَقَالَ: لاَ تَخْلِطُوا بِہِ غَیْرَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 8630","","","كتاب الجمعة"
"8631","(۸۶۳۱) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَرِہَ التَّعْشِیرَ فِی الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 8631","","","كتاب الجمعة"
"8632","(۸۶۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ : أَنَّہُ کَرِہَ التَّعْشِیرَ فِی الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 8632","","","كتاب الجمعة"
"8633","(۸۶۳۳) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ: أَنَّہُ کَرِہَ النَّقْطَ وَخَاتِمَۃَ سُورَۃِ کَذَا وَکَذَا۔","","Musannaf Ibn Abi Shaybah 8633","","","كتاب الجمعة"
"8634","(۸۶۳۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ أَبِی الزَّعْرَائِ ، عَنِ ابْنِ مَسْعُودٍ قَالَ : جَرِّدُوا الْقُرْآنَ ، وَلاَ تَلْبِسُوا بِہِ مَا لَیْسَ مِنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 8634","","","كتاب الجمعة"
"8635","(۸۶۳۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَش ، عَنْ إبْرَاہِیمَ قَالَ : قَالَ عَبْدُ اللہِ : جَرِّدُوا الْقُرْآنَ۔","Hasan","Musannaf Ibn Abi Shaybah 8635","","","كتاب الجمعة"
"8636","(۸۶۳۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : کَانَ یُقَال : جَرِّدُوا الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 8636","","","كتاب الجمعة"
"8637","(۸۶۳۷) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ : قَالَ عَبْدُ اللہِ : جَرِّدُوا الْقُرْآنَ۔","Hasan","Musannaf Ibn Abi Shaybah 8637","","","كتاب الجمعة"
"8638","(۸۶۳۸) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ : قُلْتُ لِعَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ : مَا مَنَعَک أَنْ تَکُونَ سَأَلْتَ کَمَا سَأَلَ إبْرَاہِیم ؟ فَقَالَ : کَانَ یُقَالُ : جَرِّدُوا الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 8638","","","كتاب الجمعة"
"8639","(۸۶۳۹) حَدَّثَنَا مَالِکٌ وَعَفَّانُ ، قَالاَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ شُعَیْبِ بْنِ الْحَبْحَابِ : أَنَّ أَبَا الْعَالِیَۃِ کَانَ یَکْرَہُ الْجُمَلَ الَّتِی تُکْتَبُ فِی الْمَصَاحِفِ فَاتِحَۃً وَخَاتِمَۃً ، وَقَالَ : جَرِّدُوا الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 8639","","","كتاب الجمعة"
"8640","(۸۶۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلِیٍّ : أَنَّہُ کَرِہَ أَنْ یُکْتَبَ الْقُرْآنُ فِی الْمَصَاحِفِ الصِّغَارِ۔","","Musannaf Ibn Abi Shaybah 8640","","","كتاب الجمعة"
"8641","(۸۶۴۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : کَانَ یُقَالُ : عَظِّمُوا الْقُرْآنَ ، یَعْنِی کَبِّرُوا الْمَصَاحِفَ۔","","Musannaf Ibn Abi Shaybah 8641","","","كتاب الجمعة"
"8642","(۸۶۴۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَلِیُّ بْنُ مُبَارَکٍ ، عَنْ أَبِی حُکَیمَۃَ الْعَبْدِیِّ قَالَ : کُنَّا نَکْتُبُ الْمَصَاحِفَ بِالْکُوفَۃِ فَیَمُرُّ عَلَیْنَا عَلِیٌّ فَیَقُومُ فَیَنْظُرُ فَیُعْجِبُہُ خَطُّنَا وَیَقُولُ : ہَکَذَا نَوِّرُوا مَا نَوَّرَ اللَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 8642","","","كتاب الجمعة"
"8643","(۸۶۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ الْمَلِکِ بْنُ شَدَّادٍ الأَزْدِیُّ ، عَنْ عُبَیْدِ اللہ بْنِ سُلَیْمَانَ الْعَبْدِیِّ ، عَنْ أَبِی حُکَیمَۃَ الْعَبْدِیِّ قَالَ : کُنَّا نَکْتُبُ الْمَصَاحِفَ بِالْکُوفَۃِ فَیَمُرُّ عَلَیْنَا عَلِیٌّ وَنَحْنُ نَکْتُبُ فَیَقُولُ : أَجِلَّ قَلَمَکَ ، قَالَ: فَقَطَطْتُ مِنْہُ ثُمَّ کَتَبْتُ ، فَقَالَ : ہَکَذَا نَوِّرُوا مَا نَوَّرَ اللَّہُ تَعَالَی۔","Hasan","Musannaf Ibn Abi Shaybah 8643","","","كتاب الجمعة"
"8644","(۸۶۴۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلِیٍّ : أَنَّہُ کَرِہَ أَنْ یُکْتَبَ الْقُرْآنُ فِی الْمُصْحَفِ الصَّغِیرِ۔","","Musannaf Ibn Abi Shaybah 8644","","","كتاب الجمعة"
"8645","(۸۶۴۵) حَدَّثَنَا وَکِیعٌ ، وَعُبَیْدُ اللہِ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ : أَنَّہُ کَرِہَ أَنْ یَقُولَ مُصَیْحِفٌ۔","","Musannaf Ibn Abi Shaybah 8645","","","كتاب الجمعة"
"8646","(۸۶۴۶) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ عَاصِمٍ، عَنْ زِرٍّ، عَنْ عَبْدِاللہِ قَالَ: أَدِیمُوا ألنَّظَرَ فِی الْمُصْحَفِ۔","Da'if","Musannaf Ibn Abi Shaybah 8646","","","كتاب الجمعة"
"8647","(۸۶۴۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : انْتَہَیْت إلَیْہِ وَہُوَ یَقْرَأُ فِی الْمُصْحَفِ ، فَقَالَ : ہَذَا حِزْبِی الَّذِی أُرِیدُ أَنْ أَقُومَ بِہِ اللَّیْلَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 8647","","","كتاب الجمعة"
"8648","(۸۶۴۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃَ قَالَ : دَخَلْتُ عَلَی عَبْدِ اللہِ بْنِ عَمْرٍو وَہُوَ یَقْرَأُ فِی الْمُصْحَفِ فَقَالَ : ہَذَا حِزْبِی الَّذِی أُرِیدُ أَنْ أَقُومَ بِہِ اللَّیْلَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 8648","","","كتاب الجمعة"
"8649","(۸۶۴۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، قَالَ : کَانَ خُلُقَ الأَوَّلِینَ النَّظَرُ فِی الْمَصَاحِفِ ، قَالَ : وَکَانَ الأَحْنَفُ بْنُ قَیْسٍ إذَا خَلَی نَظَرَ فِی الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 8649","","","كتاب الجمعة"
"8650","(۸۶۵۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ شُمَیْسَۃَ أُمِّ سَلَمَۃَ ، عَنْ عَائِشَۃَ : أَنَّہَا کَانَتْ تَقْرَأُ فِی الْمُصْحَفِ فَإِذَا مَرَّتْ بِالسَّجْدَۃِ قَامَتْ فَسَجَدَتْ۔","Sahih","Musannaf Ibn Abi Shaybah 8650","","","كتاب الجمعة"
"8651","(۸۶۵۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، قَالَ : حَدَّثَتْنِی سُرِّیَّۃُ الرَّبِیعِ بْنِ خُثَیم قَالَتْ : إِنْ کَانَ الرَّبِیعُ لَیَقْرَأُ فِی الْمُصْحَفِ فَإِذَا دَخَلَ عَلَیْہِ إنْسَانٌ غَطَّاہُ۔","","Musannaf Ibn Abi Shaybah 8651","","","كتاب الجمعة"
"8652","(۸۶۵۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، قَالَ : دَخَلْتُ عَلَی إبْرَاہِیمَ وَہُوَ یَقْرَأُ فِی الْمُصْحَفِ ، فَاسْتَأْذَنَ عَلَیْہِ رَجُلٌ فَغَطَّاہُ ، وقَالَ : لاَ یَرَی ہَذَا أَنِّی أَقْرَأُ فِیہِ کُلَّ سَاعَۃٍ۔","","Musannaf Ibn Abi Shaybah 8652","","","كتاب الجمعة"
"8653","(۸۶۵۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی مُوسَی ، عَنِ الْحَسَنِ ، قَالَ : دَخَلُوا عَلَی عُثْمَانَ وَالْمُصْحَفُ فِی حِجْرِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 8653","","","كتاب الجمعة"
"8654","(۸۶۵۴) حَدَّثَنَا سُلیمَانُ بْنُ حَرْبٍ ، قَالَ : حدَّثَنَا أَبُو ہِلاَلٍ ، قَالَ : حَدَّثَنَا أَبُو صَالِحٍ الْعُقَیْلِیُّ ، قَالَ : کَانَ أَبُو الْعَلاَئِ یَزِیدُ بْنُ عَبْدِ اللہِ بْنِ الشِّخِّیرِ یَقْرَأُ فِی الْمُصْحَفِ حَتَّی یُغْشَی عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 8654","","","كتاب الجمعة"
"8655","(۸۶۵۵) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، قَالَ : رَأَیْتُُ طَلْحَۃَ یَقْرَأُ فِی الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 8655","","","كتاب الجمعة"
"8656","(۸۶۵۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : تَعَاہَدُوا ہَذِہِ الْمَصَاحِفَ ، فَلَہِیَ أَشَدُّ تَفَصِّیًا مِنْ صُدُورِ الرِّجَالِ مِنَ النَّعَمِ مِنْ عُقُلِہِ ، فَلاَ یَقُولُ أَحَدُکُمْ نَسِیتُ آیَۃَ کَیْتَ وَکَیْتَ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : بَلْ ہُوَ نُسِّیَ۔ (مسلم ۲۲۹۔ نسائی ۱۰۵۶۱)","Sahih","Musannaf Ibn Abi Shaybah 8656","","","كتاب الجمعة"
"8657","(۸۶۵۷) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ بُرَیْدِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِی مُوسَی ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَعَاہَدُوا الْقُرْآنَ فَوَالَّذِی نَفْسِی بِیَدِہِ لَہُوَ أَشَدُّ تَفَصِّیًا مِنْ قُلُوبِ الرِّجَالِ مِنَ الإِبِلِ مِنْ عُقُلِہَا۔ (بخاری ۵۰۳۳۔ مسلم ۵۴۵)","Sahih","Musannaf Ibn Abi Shaybah 8657","","","كتاب الجمعة"
"8658","(۸۶۵۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَثَلُ الْقُرْآنِ مَثَلُ الإِبِلِ الْمُعَقَّلَۃِ إِنْ عَقَلَہَا صَاحِبُہَا أَمْسَکَہَا وَإِنْ تَرَکَہَا ذَہَبَتْ۔ (مسلم ۲۲۷۔ احمد ۲/۳۶)","Hasan","Musannaf Ibn Abi Shaybah 8658","","","كتاب الجمعة"
"8659","(۸۶۵۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ ، قَالَتْ : إنِّی لأَقْرَأُ حِزْبِی ، أَوْ عَامَّۃَ حِزْبِی وَأَنَا مُضْطَجِعَۃٌ عَلَی فِرَاشِی۔","Sahih","Musannaf Ibn Abi Shaybah 8659","","","كتاب الجمعة"
"8660","(۸۶۶۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبابِ ، عَنْ مُوسَی بْنِ عُلِیٍّ ، قَالَ : سَمِعْتُ أَبِی یَقُولُ : سَمِعْتُ عُقْبَۃَ بْنَ عَامِرٍ یَقُولُ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : تَعَلَّمُوا الْقُرْآنَ وَاتْلُوہُ ، فَوَالَّذِی نَفْسِی بِیَدِہِ لَہُوَ أَسْرَعُ تَفَصِّیًا مِنْ قُلُوبِ الرِّجَالِ مِنَ النَّعَمِ مِنْ عُقُلِہَا۔ (احمد ۴/۱۴۶۔ طبرانی ۸۰۲)","Sahih","Musannaf Ibn Abi Shaybah 8660","","","كتاب الجمعة"
"8661","(۸۶۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَمَّامٍ ، عَنْ قَتَادَۃَ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ الشِّخِّیرِ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَرَأَ الْقُرْآنَ فِی أَقَلَّ مِنْ ثَلاَثٍ لَمْ یَفْقَہْہُ۔ (ترمذی ۲۹۴۹۔ ابوداؤد ۱۳۸۹)","Sahih","Musannaf Ibn Abi Shaybah 8661","","","كتاب الجمعة"
"8662","(۸۶۶۲) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا مِسْعَرٌ وَسُفْیَانُ ، عَنْ عَلِیِّ بْنِ بَذِیمَۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ قَرَأَ الْقُرْآنَ فِی أَقَلَّ مِنْ ثَلاَثٍ فَہُوَ رَاجِزٌ۔","","Musannaf Ibn Abi Shaybah 8662","","","كتاب الجمعة"
"8663","(۸۶۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حُصَیْنِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، قَالَ : کَانَ ابْنُ مَسْعُودٍ یَقْرَأُ الْقُرْآنَ فِی کُلِّ ثَلاَثٍ وَقَلَّمَا یَسْتَعِینُ بِالنَّہَارِ۔","","Musannaf Ibn Abi Shaybah 8663","","","كتاب الجمعة"
"8664","(۸۶۶۴) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أُبَیٍّ : أَنَّہُ کَانَ یَخْتِمُ الْقُرْآنَ فِی ثَمَانٍ۔","","Musannaf Ibn Abi Shaybah 8664","","","كتاب الجمعة"
"8665","(۸۶۶۵) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَبِی قِلاَبَۃَ : أَنَّہُ کَانَ یَخْتِمُ الْقُرْآنَ فِی ثَمَانٍ ، وَأَنَّ تَمِیمًا الدَّارِیَّ کَانَ یَخْتِمُ الْقُرْآنَ فِی سَبْعٍ۔","","Musannaf Ibn Abi Shaybah 8665","","","كتاب الجمعة"
"8666","(۸۶۶۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ حَفْصَۃَ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : کَانَ مُعَاذٌ یَکْرَہُ أَنْ یُقْرَأ الْقُرْآنَ فِی أَقَلَّ مِنْ ثَلاَثٍ۔","Sahih","Musannaf Ibn Abi Shaybah 8666","","","كتاب الجمعة"
"8667","(۸۶۶۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ الأَسْوَدُ یَقْرَأُ الْقُرْآنَ فِی شَہْرِ رَمَضَانَ فِی لَیْلَتَیْنِ وَیَخْتِمُہُ فِی سِوَی رَمَضَانَ فِی سِتٍّ ، وَکَانَ عَلْقَمَۃُ یَخْتِمُہُ فِی خَمْسٍ۔","","Musannaf Ibn Abi Shaybah 8667","","","كتاب الجمعة"
"8668","(۸۶۶۸) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ : أَنَّہُ کَانَ یَقْرَأُ الْقُرْآنَ فِی خَمْسٍ، وَکَانَ الأَسْوَدُ بْنُ یَزِیدَ یَقْرَؤُہُ فِی سِتٍّ۔","","Musannaf Ibn Abi Shaybah 8668","","","كتاب الجمعة"
"8669","(۸۶۶۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ الرَّحْمَنِ بْنُ یَزِیدَ یَقْرَأُ الْقُرْآنَ فِی کُلِّ سَبْعٍ ، وَکَانَ عَلْقَمَۃُ وَالأَسْوَدُ یَقْرَؤُہُ أَحَدُہُمَا فِی خَمْسٍ وَالأَخَرُ فِی سِتٍّ ، وَکَانَ إبْرَاہِیمُ یَقْرَؤُہُ فِی سَبْعٍ۔","","Musannaf Ibn Abi Shaybah 8669","","","كتاب الجمعة"
"8670","(۸۶۷۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ دَاوُد ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : کَانَ عُرْوَۃُ یَقْرَأُ الْقُرْآنَ فِی کُلِّ سَبْعٍ۔","","Musannaf Ibn Abi Shaybah 8670","","","كتاب الجمعة"
"8671","(۸۶۷۱) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : کَانَ یَؤُمُّ الْحَیَّ فِی رَمَضَانَ وَکَانَ یَخْتِمُ فِی سَبْعٍ۔","","Musannaf Ibn Abi Shaybah 8671","","","كتاب الجمعة"
"8672","(۸۶۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ یَعْلَی الطَّائِفِیُّ ، عَنْ عُثْمَانَ بْنِ عَبْدِ اللہِ بْنِ أَوْسٍ الثَّقَفِیِّ ، عَنْ جَدِّہِ أَوْسِ بْنِ حُذَیْفَۃَ قَالَ : قَدِمَ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَفْدُ ثَقِیفٍ ، قَالَ : فَأَنْزَلَنَا فِی قُبَّۃٍ لَہُ وَنَزَلَ إخْوَانُنَا الأَحْلاَفُ عَلَی المُغِیرَۃِ بْنِ شُعْبَۃَ ، قَالَ : فَکَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَأْتِینَا بَعْدَ الْعِشَائِ فَیُحَدِّثُنَا وَکَانَ أَکْثَرُ حَدِیثِہِ تشَکّیہ قُرَیْشًا وَیَقُولُ : وَلاَ سَوَائَ کُنَّا بِمَکَّۃَ مُسْتَضْعَفِینَ مُسْتَذَلِّینَ ، فَلَمَّا أَتَیْنَا الْمَدِینَۃَ کَانَتِ الْحَرْبُ سِجَالاً عَلَیْنَا وَلَنَا۔n قَالَ : فَأَبْطَأَ عَلَیْنَا ذَاتَ لَیْلَۃٍ فَأَطْوَلَ فَقُلْنَا : یَا رَسُولَ اللہِ أَبْطَأْتَ عَلَیْنَا ، قَالَ : إِنَّہُ طَرَأَ عَلَیَّ حِزْبٌ مِنَ الْقُرْآنِ فَکَرِہْتُ أَنْ أَخْرُجَ حَتَّی أَقْضِیَہُ ، فَسَأَلْنَا أَصْحَابَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَیفَ کَانَ رَسُولُ اللہِ صلی اللہ علیہ یُحَزِّبُ الْقُرْآنَ ؟ فَقَالَ : کَانَ یُحَزِّبُہُ ثَلاَثًا وَخَمْسًا وَسَبْعًا وَتِسْعًا وَإِحْدَی عَشْرَۃَ وَثَلاَثَ عَشْرَۃَ وَحِزْبَ الْمُفَصَّلِ۔ (احمد ۴/۳۴۳۔ ابن ماجہ ۱۳۴۵)","Da'if","Musannaf Ibn Abi Shaybah 8672","","","كتاب الجمعة"
"8673","(۸۶۷۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ عَبْدِ رَبِّہِ بْنِ سَعِیدٍ الأَنْصَارِیِّ ، عَنِ السَّائِبِ ، عَنْ أَبِیہِ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، قَالَ : لأَنْ أَقْرَأَ الْقُرْآنَ فِی شَہْرٍ أَحَبُّ إلَیَّ مِنْ أَنْ أَقْرَأَہُ فِی خَمْسَ عَشْرَۃَ ، وَلأَنْ أَقْرَأَہُ فِی خَمْسَ عَشْرَۃَ أَحَبُّ إلَیَّ مِنْ أَنْ أَقْرَأَہُ فِی عَشْرٍ ، وَلأَنْ أَقْرَأَہُ فِی عَشْرٍ أَحَبُّ إلَیَّ مِنْ أَنْ أَقْرَأَہُ فِی سَبْعٍ أقف وَأَدْعُو۔","Da'if","Musannaf Ibn Abi Shaybah 8673","","","كتاب الجمعة"
"8674","(۸۶۷۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنْ أَبِی الأَحْوَص ، قَالَ : قَالَ عَبْدُ اللہِ : اقَرَإِ الْقُرْآنَ فِی سَبْعٍ وَلاَ تَقْرَأُہُ فِی ثَلاَثٍ۔","Sahih","Musannaf Ibn Abi Shaybah 8674","","","كتاب الجمعة"
"8675","(۸۶۷۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْعَوَّامِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، قَالَ : کَانَ یَخْتِمُ الْقُرْآنَ فِی کُلِّ ثَلاَثٍ ، ثُمَّ یُصْبِحُ الْیَوْمَ الَّذِی یَخْتِمُ فِیہِ صَائِمًا۔","","Musannaf Ibn Abi Shaybah 8675","","","كتاب الجمعة"
"8676","(۸۶۷۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، قَالَ : جَائَ رَجُلٌ إلَی مَسْرُوقٍ فَقَالَ : مَا تَقُولُ فِی رَجُلٍ یَقْرَأُ الْقُرْآنَ فِی جُمُعَۃٍ ؟ فَقَالَ مَسْرُوقٌ : حَسَنٌ لَوْ أَخَذْتَ مُصْحَفًا کُلَّ جُمُعَۃٍ فَأَدْخَلْتَہُ بَیْتًا لأَوْشَکَ أَنْ تَمْلأَہ۔","","Musannaf Ibn Abi Shaybah 8676","","","كتاب الجمعة"
"8677","(۸۶۷۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ : أَنَّ تَمِیمًا الدَّارِیَّ قَرَأَ الْقُرْآنَ کُلَّہُ فِی رَکْعَۃٍ۔","","Musannaf Ibn Abi Shaybah 8677","","","كتاب الجمعة"
"8678","(۸۶۷۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ عُثْمَانَ ، قَالَ : قُمْتُ خَلْفَ الْمَقَامِ أُصَلِّی وَأَنَا أُرِیدُ أَنْ لاَ یَغْلِبَنِی عَلَیْہِ أَحَدٌ تِلْکَ اللَّیْلَۃَ ، فَإِذَا رَجُلٌ مِنْ خَلْفِی یَغْمِزُنِی فَلَمْ أَلْتَفِتْ إلَیْہِ ، ثُمَّ غَمَزَنِی فَالْتَفَتُّ ، فَإِذَا ہُوَ عُثْمَانَ بْنُ عَفَّانَ فَتَنَحَّیْت وَتَقَدَّمَ فَقَرَأَ الْقُرْآنَ کُلَّہُ فِی رَکْعَۃٍ ، ثُمَّ انْصَرَفَ۔","Hasan","Musannaf Ibn Abi Shaybah 8678","","","كتاب الجمعة"
"8679","(۸۶۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَمَّادِ بْنِ أَبِی سُلَیْمَانَ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ جُبَیْرٍ یَقُولُ : قَرَأْتُ الْقُرْآنَ فِی الْکَعْبَۃِ فِی رَکْعَۃٍ۔","","Musannaf Ibn Abi Shaybah 8679","","","كتاب الجمعة"
"8680","(۸۶۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عُثْمَانَ : أَنَّہُ قَرَأَ الْقُرْآنَ فِی رَکْعَۃٍ فِی لَیْلَۃٍ۔","","Musannaf Ibn Abi Shaybah 8680","","","كتاب الجمعة"
"8681","(۸۶۸۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ : أَنَّہُ قَرَأَہُ فِی لَیْلَۃٍ بِمَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 8681","","","كتاب الجمعة"
"8682","(۸۶۸۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ نَحْوَہُ۔","","Musannaf Ibn Abi Shaybah 8682","","","كتاب الجمعة"
"8683","(۸۶۸۳) حَدَّثَنَا مُعْتَمِرٌ، عَنْ أَبِیہِ، عَنْ صَاحِبٍ لَہُ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ، قَالَ: قرَأْتُُ الْقُرْآنَ فِی الْکَعْبَۃِ فِی رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 8683","","","كتاب الجمعة"
"8684","(۸۶۸۴) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ عَلِیٌّ الأَزْدِیُّ یَخْتِمُ الْقُرْآنَ فِی رَمَضَانَ فِی کُلِّ لَیْلَۃٍ۔","","Musannaf Ibn Abi Shaybah 8684","","","كتاب الجمعة"
"8685","(۸۶۸۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ شُتَیْرِ بْنِ شَکَلٍ ، عَنْ عَلِیٍّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ الأَحْزَابِ : شَغَلُونَا عَنِ الصَّلاَۃ الْوُسْطَی صَلاَۃِ الْعَصْرِ مَلأَ اللَّہُ بُیُوتَہُمْ وَقُبُورَہُمْ نَارًا، ثُمَّ صَلاَّہَا بَیْنَ الْعِشَائَیْنِ بَیْنَ الْمَغْرِبِ وَالْعِشَائِ۔ (مسلم ۲۰۵۔ احمد ۱/۸۱)","Sahih","Musannaf Ibn Abi Shaybah 8685","","","كتاب الجمعة"
"8686","(۸۶۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ یَحْیَی بْنِ الْجَزَّارِ ، عَنْ عَلِیٍّ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ عَلَی فُرْضَۃٍ مِنْ فُرَضِ الْخَنْدَقِ ، فَقَالَ : شَغَلُونَا عَنِ الصَّلاَۃ الْوُسْطَی صَلاَۃِ الْعَصْرِ حَتَّی غَابَتِ الشَّمْسُ مَلأَ اللَّہُ بُیُوتَہُمْ وَقُبُورَہُمْ وَبُطُونَہُمْ وَأَجْوَافَہُمْ نَارًا۔ (مسلم ۲۰۴۔ احمد ۱/۱۵۲)","Sahih","Musannaf Ibn Abi Shaybah 8686","","","كتاب الجمعة"
"8687","(۸۶۸۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الصَّلاَۃ الْوُسْطَی صَلاَۃُ الْعَصْرِ۔","","Musannaf Ibn Abi Shaybah 8687","","","كتاب الجمعة"
"8688","(۸۶۸۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو بِشْرٍ ، قَالَ : أَخْبَرَنی رَجُلٌ ، عَنْ سَالِمِ بْنِ عَبْدِ اللہِ : أَنَّ حَفْصَۃَ أُمَّ الْمُؤْمِنِینَ ، قَالَتْ : الصَّلاَۃ الْوُسْطَی صَلاَۃُ الْعَصْرِ {وَقُومُوا لِلَّہِ قَانِتِینَ} ۔","Da'if","Musannaf Ibn Abi Shaybah 8688","","","كتاب الجمعة"
"8689","(۸۶۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ دَاوُدَ بْنِ قَیْسٍ ، عَنْ عَبْدِ اللہِ بْنِ رَافِعٍ، عَنْ أُمِّ سَلَمَۃَ: أَنَّہَا اسْتَکْتَبَتْ مُصْحَفًا، فَلَمَّا بَلَغَتْ {حَافِظُوا عَلَی الصَّلَوَاتِ وَالصَّلاَۃ الْوُسْطَی} ، قَالَتِ : اُکْتُبِ الْعَصْرَ۔","Sahih","Musannaf Ibn Abi Shaybah 8689","","","كتاب الجمعة"
"8690","(۸۶۹۰) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، قَالَ : أَخْبَرَنِی مُوسَی بْنُ یَزِیدَ قَالَ : سَأَلْتُ أَبَا أُمَامَۃَ عَنِ الصَّلاَۃ الْوُسْطَی ، فَقَالَ : لاَ أَحْسَبُہَا إِلاَّ الصُّبْحَ۔","Da'if","Musannaf Ibn Abi Shaybah 8690","","","كتاب الجمعة"
"8691","(۸۶۹۱) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزِّبْرِقَانِ ، عَنْ زُہْرَۃَ ، قَالَ : کُنَّا جُلُوسًا فِی الْمَسْجِدِ مَعَ زَیْدِ بْنِ ثَابِتٍ فَسُئِلَ عَنِ صَلاَۃ الْوُسْطَی فَقَالَ : ہِیَ الظُّہْرُ ، فَمَرَّ أُسَامَۃُ فَسُئِلَ فَقَالَ : ہِیَ الظُّہْرُ ، کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّیہَا بِالْہَجِیرِ۔ (نسائی ۳۵۶۔ احمد ۵/۲۰۶)","Da'if","Musannaf Ibn Abi Shaybah 8691","","","كتاب الجمعة"
"8692","(۸۶۹۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَوْفٌ ، عَنْ أَبِی رَجَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : ہِیَ صَلاَۃُ الْفَجْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 8692","","","كتاب الجمعة"
"8693","(۸۶۹۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَبْدُ الْحَمِیدِ بْنُ جَعْفَرٍ ، عَمَّنْ حَدَّثَہُ عَنْ مَنْظُورِ بْنِ أَبِی ثَعْلَبَۃَ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، قَالَ : ہِیَ الظُّہْرُ۔","Da'if","Musannaf Ibn Abi Shaybah 8693","","","كتاب الجمعة"
"8694","(۸۶۹۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الْعَوَّامُ ، عَنِ الأَنْصَارِیِّ ، عَنْ زَیْدِ بْنِ ثَابِتٍ : أَنَّہُ کَانَ یَقُولُ ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 8694","","","كتاب الجمعة"
"8695","(۸۶۹۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ ، قَالَتِ : الصَّلاَۃ الْوُسْطَی صَلاَۃُ الْعَصْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 8695","","","كتاب الجمعة"
"8696","(۸۶۹۶) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ مُحَمَّدِ بْنِ طَلْحَۃَ ، عَنْ زُبَیْد ، عَنْ مُرَّۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : ہِیَ الْعَصْرُ۔","Sahih","Musannaf Ibn Abi Shaybah 8696","","","كتاب الجمعة"
"8697","(۸۶۹۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَاصِمٍ ، عَنْ زِرِّ بْنِ حُبَیْشٍ : أَنَّ عَبِیْدَۃَ سَأَلَ عَلِیًّا عَنِ الصَّلاَۃ الْوُسْطَی ؟ فَذَکَرَ عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَحْوَ ہَذَا الْحَدِیثِ۔ (بخاری ۲۹۳۱۔ ابوداؤد ۴۱۲)","Da'if","Musannaf Ibn Abi Shaybah 8697","","","كتاب الجمعة"
"8698","(۸۶۹۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : الصَّلاَۃ الْوُسْطَی صَلاَۃُ الْعَصْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 8698","","","كتاب الجمعة"
"8699","(۸۶۹۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عُمَیْرِ بْنِ سَعِیدٍ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ یَقُولُ : {حَافِظُوا عَلَی الصَّلَوَاتِ وَالصَّلاَۃ الْوُسْطَی} صَلاَۃِ الْعَصْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 8699","","","كتاب الجمعة"
"8700","(۸۷۰۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مِسْعَرٍ ، عَنْ سَلَمَۃَ ، عَنْ أَبِی الأَحْوَص ، عَنْ عَلِیٍّ ، قَالَ : ہِیَ الَّتِی فَرَّطَ فِیہَا ابْنُ دَاوُد وَہِیَ الْعَصْرُ۔","Sahih","Musannaf Ibn Abi Shaybah 8700","","","كتاب الجمعة"
"8701","(۸۷۰۱) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : الصَّلاَۃ الْوُسْطَی الَّتِی فَرَّطَ فِیہَا سُلَیْمَانُ صَلاَۃُ الْعَصْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 8701","","","كتاب الجمعة"
"8702","(۸۷۰۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : سُئِلَ شُرَیْحٌ عَنِ الصَّلاَۃ الْوُسْطَی فَقَالَ : حَافِظُوا عَلِیہَا تُصِیبُوہَا۔","","Musannaf Ibn Abi Shaybah 8702","","","كتاب الجمعة"
"8703","(۸۷۰۳) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنْ أَبِی حَیَّانَ ، عَن أَبِیہ ، عَن رَبِیع بن خُثَیم : سُئِلَ عَنِ الصَّلاَۃ الْوُسْطَی ، فَقَالَ : ہِیَ وَاحِدَۃٌ مِنْہُنَّ فَحَافِظُوا عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 8703","","","كتاب الجمعة"
"8704","(۸۷۰۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : ہِیَ الْعَصْرُ۔","","Musannaf Ibn Abi Shaybah 8704","","","كتاب الجمعة"
"8705","(۸۷۰۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، أَنَّہُ کَانَ یَقُولُ : {حَافِظُوا عَلَی الصَّلَوَاتِ وَالصَّلاَۃ الْوُسْطَی} صَلاَۃِ الْعَصْرِ۔nقَالَ : وَکَانَ عَطَائٌ یَرَی أَنَّ الصَّلاَۃ الْوُسْطَی صَلاَۃُ الْغَدَاۃِ۔","","Musannaf Ibn Abi Shaybah 8705","","","كتاب الجمعة"
"8706","(۸۷۰۶) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، قَالَ : حَدَّثَنَا حَیَّانُ الأَزْدِیُّ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ وَسُئِلَ عَنِ الصَّلاَۃ الْوُسْطَی وَقِیلَ لَہُ : إنَّ أَبَا ہُرَیْرَۃَ یَقُولُ : ہِیَ الْعَصْرُ ، فَقَالَ : إنَّ أَبَا ہُرَیْرَۃَ یُکْثِرُ ، ابْنُ عُمَر یَقُولُ : ہِیَ الصُّبْحُ۔","Sahih","Musannaf Ibn Abi Shaybah 8706","","","كتاب الجمعة"
"8707","(۸۷۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن حَفْصٍ ، عَنْ عَاصِمٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ۔ وَعَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنِ ابْنِ عُمَرَ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، قَالَ : الصَّلاَۃ الْوُسْطَی صَلاَۃُ الظُّہْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 8707","","","كتاب الجمعة"
"8708","(۸۷۰۸) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ عَبْدِ الرَّحْمَنِ الْخَیَّاطِ ، قَالَ : سَمِعْتُ عِکْرِمَۃَ یَقُولُ : ہِیَ الظُّہْرُ قَبْلَہَا صَلاَتَانِ وَبَعْدَہَا صَلاَتَانِ۔","","Musannaf Ibn Abi Shaybah 8708","","","كتاب الجمعة"
"8709","(۸۷۰۹) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : ہِیَ الصُّبْحُ۔","","Musannaf Ibn Abi Shaybah 8709","","","كتاب الجمعة"
"8710","(۸۷۱۰) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : الصَّلاَۃ الْوُسْطَی صَلاَۃُ الْعَصْرِ۔","","Musannaf Ibn Abi Shaybah 8710","","","كتاب الجمعة"
"8711","(۸۷۱۱) حَدَّثَنَا شَبَابَۃُ ، عَنْ وَرْقَائَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ {حَافِظُوا عَلَی الصَّلَوَاتِ وَالصَّلاَۃ الْوُسْطَی} الصُّبْحِ۔","","Musannaf Ibn Abi Shaybah 8711","","","كتاب الجمعة"
"8712","(۸۷۱۲) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا ہَمَّامٌ ، قَالَ : حَدَّثَنَا قَتَادَۃُ ، عَنِ الْحَسَنِ ، عَنْ سَمُرَۃََ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الصَّلاَۃ الْوُسْطَی صَلاَۃُ الْعَصْرِ۔ (ترمذی ۱۸۲۔ احمد ۵/۱۲)","Hasan","Musannaf Ibn Abi Shaybah 8712","","","كتاب الجمعة"
"8713","(۸۷۱۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا وَہْبٌ ، قَالَ : حَدَّثَنَا خَالِدٌ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الْمُہَلَّبِ ، عَنْ أُبَیِّ بْنِ کَعْبٍ ، قَالَ : الصَّلاَۃ الْوُسْطَی صَلاَۃُ الْعَصْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 8713","","","كتاب الجمعة"
"8714","(۸۷۱۴) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ، عَنِ التَّیْمِیِّ، عَنْ أَبِی صَالِحٍ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: صَلاَۃ الْوُسْطَی صَلاَۃُ الْعَصْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 8714","","","كتاب الجمعة"
"8715","(۸۷۱۵) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ التَّیْمِیِّ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی أَیُّوبَ ، عَنْ عَائِشَۃَ ، قَالَتِ : صَلاَۃ الْوُسْطَی صَلاَۃُ الْعَصْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 8715","","","كتاب الجمعة"
"8716","(۸۷۱۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مُحَمَّدِ بْنِ طَلْحَۃَ ، عَنْ زُبَیْدٍ ، عَنْ مُرَّۃَ ، عَنْ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : ہِیَ الْعَصْرُ۔ (مسلم ۲۰۶۔ احمد ۱/۳۹۲)","Sahih","Musannaf Ibn Abi Shaybah 8716","","","كتاب الجمعة"
"8717","(۸۷۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ قُرَّۃَ ، قَالَ : حدَّثَنَا أَبُو رَجَائٍ ، قَالَ : صَلَّیْتُ مَعَ ابْنِ عَبَّاسٍ الصُّبْحَ فِی مَسْجِدِ الْبَصْرَۃِ ، فَقَالَ : ہَذِہِ الصَّلاَۃ الْوُسْطَی۔","Sahih","Musannaf Ibn Abi Shaybah 8717","","","كتاب الجمعة"
"8718","(۸۷۱۸) حَدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِیُّ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، قَالَ سَمِعْتُ ابْنُ عُمَرَ یَقُولُ : الْوُسْطَی صَلاَۃُ الصُّبْحِ۔","Sahih","Musannaf Ibn Abi Shaybah 8718","","","كتاب الجمعة"
"8719","(۸۷۱۹) سَمِعْتُ وَکِیعًا یَقُولُ : قَالَ سُفْیَانُ فِی رَجُلٍ زَالَتِ الشَّمْسُ وَہُوَ فِی الْحَضَرِ ، ثُمَّ خَرَجَ إلَی السَّفَرِ کَیْفَ یُصَلِّی ، قَالَ : إِنْ کَانَ فِی وَقْتِ الظُّہْرِ صَلَّی رَکْعَتَیْنِ۔n وَقَالَ حَسَنُ بْنُ صَالِحٍ : إذَا زَالَتَ لہ الشَّمْسُ ہَاہُنَا صَلَّی فِی السَّفَرِ أَرْبَعًا۔n قَالَ : وَقَالَ سُفْیَانُ فِی مُسَافِرٍ دَخَلَ مَعَ مُقِیمٍ فَصَلَّی مَعَہُ رَکْعَۃً ، ثُمَّ رَأَی شَیْئًا فَتَکَلَّمَ فَصَلَّی الإِمَام فَقَالَ : یُعِیدُ الْمُسَافِرُ رَکْعَتَیْنِ ، ثُمَّ یَرْجِعُ إلَی الأَصْلِ الَّذِی کَانَ عَلَیْہِ۔n وَقَالَ الْحَسَنُ بْنُ صَالِحٍ : یُصَلِّی أَرْبَعًا لأَنَّہُ قَدْ أَوْجَبَہَا عَلَی نَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 8719","","","كتاب الجمعة"
"8720","(۸۷۲۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَمِعْتُ سُفْیَانَ یَقُولُ فِی رَجُلٍ دَخَلَ مَعَ الإِمَامِ یَوْمَ الْجُمُعَۃِ فَرَعَفَ فَذَہَبَ فَتَوَضَّأَ ثُمَّ جَائَ وَقَدْ صَلَّی الإِمَام ، وَلَمْ یَتَکَلَّمِ الرَّجُلُ ، قَالَ سُفْیَانُ : یُصَلِّی صَلاَۃَ الإِمَام رَکْعَتَیْنِ۔n وَقَالَ الْحَسَنُ بْنُ صَالِحٍ : یُصَلِّی أَرْبَعًا إِلاَّ أَنْ یَکُونَ قَدْ صَلَّی مَعَہُ رَکْعَۃً۔","","Musannaf Ibn Abi Shaybah 8720","","","كتاب الجمعة"
"8721","(۸۷۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنِ الْحَکَمِ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ کَعْبِ بْنِ عُجْرَۃَ ، قَالَ : قلْنَا : یَا رَسُولَ اللہِ قَدْ عَلِمْنَا کَیْفَ السَّلاَمَ عَلَیْک فَکَیْفَ الصَّلاَۃ عَلَیْک ؟ قَالَ : قُولُوا اللَّہُمَّ صَلِّ عَلَی مُحَمَّدٍ وَعَلَی آلِ مُحَمَّدٍ کَمَا صَلَّیْتَ عَلَی إبْرَاہِیمَ وَآلِ إبْرَاہِیمَ إنَّکَ حَمِیدٌ مَجِیدٌ ، وَبَارِکْ عَلَی مُحَمَّدٍ وَعَلَی آلِ مُحَمَّدٍ کَمَا بَارَکْتَ عَلَی إبْرَاہِیمَ وَآلِ إبْرَاہِیمَ إنَّکَ حَمِیدٌ مَجِیدٌ۔ (بخاری ۶۳۵۷۔ مسلم ۶۶)","Sahih","Musannaf Ibn Abi Shaybah 8721","","","كتاب الجمعة"
"8722","(۸۷۲۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ کَعْبِ بْنِ عُجْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوِہِ۔ (احمد ۴/۲۴۴)","Da'if","Musannaf Ibn Abi Shaybah 8722","","","كتاب الجمعة"
"8723","(۸۷۲۳) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ عَبْدِ اللہِ بْنِ جَعْفَرٍ ، عَنْ یَزِیدَ بْنِ الْہَادِ ، عَنْ عَبْدِ اللہِ بْنِ خَبَّابٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : قلْنَا : یَا رَسُولَ اللہِ ہَذَا السَّلاَمُ عَلَیْک قَدْ عَرَفْنَاہُ فَکَیْفَ الصَّلاَۃ ؟ قَالَ : قُولُوا : اللَّہُمَّ صَلِّ عَلَی مُحَمَّدٍ عَبْدِکَ وَرَسُولِکَ کَمَا صَلَّیْتَ عَلَی إبْرَاہِیمَ وَبَارِکْ عَلَی مُحَمَّدٍ کَمَا بَارَکْتَ عَلَی آلِ إبْرَاہِیمَ۔ (بخاری ۶۳۵۸۔ ابن ماجہ ۹۰۳)","Hasan","Musannaf Ibn Abi Shaybah 8723","","","كتاب الجمعة"
"8724","(۸۷۲۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ مُجَمِّعِ بْنِ یَحْیَی ، عَنْ عُثْمَانَ بْنِ مَوْہَبٍ ، عَنْ مُوسَی بْنِ طَلْحَۃَ ، عَنْ أَبِیہِ ، قَالَ : قلْنَا : یَا رَسُولَ اللہِ قَدْ عَلِمْنَا السَّلاَمَ عَلَیْک فَکَیْفَ الصَّلاَۃ ؟ قَالَ : قُولُوا : اللَّہُمَّ صَلِّ عَلَی مُحَمَّدٍ وَعَلَی آلِ مُحَمَّدٍ کَمَا صَلَّیْتَ عَلَی إبْرَاہِیمَ وَآلِ إبْرَاہِیمَ إنَّکَ حَمِیدٌ مَجِیدٌ ، وَبَارِکْ عَلَی مُحَمَّدٍ وَعَلَی آلِ مُحَمَّدٍ ، کَمَا بَارَکْتَ عَلَی إبْرَاہِیمَ وَعَلَی آلِ إبْرَاہِیمَ إنَّکَ حَمِیدٌ مَجِیدٌ۔ (نسائی ۱۲۱۳۔ احمد ۱/۱۶۲)","Sahih","Musannaf Ibn Abi Shaybah 8724","","","كتاب الجمعة"
"8725","(۸۷۲۵) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللہِ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، قَالَ : حَدَّثَنِی مُحَمَّدُ بْنُ إبْرَاہِیمَ بْنِ الْحَارِثِ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ بْنِ زَیْدٍ ، عَنْ عُقْبَۃَ بْنِ عَمْرٍو ، قَالَ : أَتَی رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلٌ حَتَّی جَلَسَ بَیْنَ یَدَیْہِ ، فَقَالَ : یَا رَسُولَ اللہِ أَمَّا السَّلاَمُ عَلَیْک فَقَدْ عَلِمْنَاہُ۔n وَأَمَّا الصَّلاَۃ فَأَخْبِرْنَا بِہَا کَیْفَ نُصَلِّی عَلَیْک ؟ قَالَ : فَصَمَتَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی وَدِدْنَا أَنَّ الرَّجُلَ الَّذِی سَأَلَہُ لَمْ یَسْأَلْہُ ، ثُمَّ قَالَ : إذَا صَلَّیْتُمْ عَلَیَّ فَقُولُوا : اللَّہُمَّ صَلِّ عَلَی مُحَمَّدٍ النَّبِیِّ الأُمِّیِّ وَعَلَی آلِ مُحَمَّدٍ کَمَا صَلَّیْتَ عَلَی إبْرَاہِیمَ وَعَلَی آلِ إبْرَاہِیمَ ، وَبَارِکْ عَلَی مُحَمَّدٍ النَّبِیِّ الأُمِّیِّ وَعَلَی آلِ مُحَمَّدٍ کَمَا بَارَکْتَ عَلَی إبْرَاہِیمَ وَعَلَی آلِ إبْرَاہِیمَ إنَّکَ حَمِیدٌ مَجِیدٌ۔ (مسلم ۶۵۔ ابوداؤد ۹۷۳)","Hasan","Musannaf Ibn Abi Shaybah 8725","","","كتاب الجمعة"
"8726","(۸۷۲۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ وَمَنْصُورٌ وَعَوْفٌ ، عَنِ الْحَسَنِ : قَالُوا یَا رَسُولَ اللہِ قَدْ عَلِمْنَا السَّلاَمَ عَلَیْک فَکَیْفَ الصَّلاَۃ عَلَیْک ؟ قَالَ : قُولُوا اللَّہُمَّ اجْعَلْ صَلَوَاتِکَ وَبَرَکَاتِکَ عَلَی آلِ مُحَمَّدٍ کَمَا جَعَلْتہَا عَلَی آلِ إبْرَاہِیمَ إنَّکَ حَمِیدٌ مَجِیدٌ۔","","Musannaf Ibn Abi Shaybah 8726","","","كتاب الجمعة"
"8727","(۸۷۲۷) حَدَّثَنَا ہُشَیْمٌ ، أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَانَ إذَا سَلَّمَ أَقْبَلَ عَلَیْنَا بِوَجْہِہِ وَہُوَ یُہَلِّلُ یَقُولُ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ۔","","Musannaf Ibn Abi Shaybah 8727","","","كتاب الجمعة"
"8728","(۸۷۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی عَاصِمٍ الثَّقَفِیِّ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، قَالَ : صَلَّی بِنَا عَلِیٌّ الْعَصْرَ ، فَلَمَّا سَلَّمَ أَقْبَلَ عَلَیْنَا بِوَجْہِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 8728","","","كتاب الجمعة"
"8729","(۸۷۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عُمَیْرِ بْنِ سَعِیدٍ ، قَالَ : سَمِعْتُ أَبَا مُوسَی قَرَأَ فِی الْجُمُعَۃِ بِـ {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} فَقَالَ : سُبْحَانَ رَبِّی الأَعْلَی۔","Sahih","Musannaf Ibn Abi Shaybah 8729","","","كتاب الجمعة"
"8730","(۸۷۳۰) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ مِسْعَرٍ ، عَنْ عُمَیْرِ بْنِ سَعِیدٍ ، قَالَ : صَلَّیْتُ مَعَ أَبِی مُوسَی الْجُمُعَۃَ فَقَرَأَ بِـ {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} فَقَالَ : سُبْحَانَ رَبِّی الأَعْلَی وَہُوَ فِی الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 8730","","","كتاب الجمعة"
"8731","(۸۷۳۱) حَدَّثَنَا عَبْدَۃُ ووَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ السُّدِّیِّ ، عَنْ عَبْدِ خَیْرٍ : أَنَّ عَلِیًّا قَرَأَ {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} فَقَالَ : سُبْحَانَ رَبِّی الأَعْلَی ، قَالَ عَبْدَۃُ : وَہُوَ فِی الصَّلاَۃ۔","Hasan","Musannaf Ibn Abi Shaybah 8731","","","كتاب الجمعة"
"8732","(۸۷۳۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ، قَالَ : سَمِعْتُ ابْنَ الزُّبَیْرِ یَقْرَأُ {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} فَقَالَ : سُبْحَانَ رَبِّی الأَعْلَی وَہُوَ فِی الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 8732","","","كتاب الجمعة"
"8733","(۸۷۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، قَالَ : سَمِعْتُ ابْنَ الزُّبَیْرِ یَقْرَأُ {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} فَقَالَ : سُبْحَانَ رَبِّی الأَعْلَی۔","Sahih","Musannaf Ibn Abi Shaybah 8733","","","كتاب الجمعة"
"8734","(۸۷۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِیہِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّہُ قَرَأَ : {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} فَقَالَ : سُبْحَانَ رَبِّی الأَعْلَی۔","Sahih","Musannaf Ibn Abi Shaybah 8734","","","كتاب الجمعة"
"8735","(۸۷۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ نَجِیحٍ ، عَنْ أَبِی الْمُتَوَکِّلِ ، عَنِ ابْنِ الزُّبَیْرِ مِثْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 8735","","","كتاب الجمعة"
"8736","(۸۷۳۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ الْوَلِیدِ ، عَنْ عُبَیْدِ بْنِ الْحَسَنِ ، قَالَ : کَانَ عُرْوَۃُ بْنُ الْمُغِیرَۃِ إذَا أَمَّ النَّاسَ ہَاہُنَا فَقَرَأَ {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} ، قَالَ : سُبْحَانَ رَبِّی الأَعْلَی۔","","Musannaf Ibn Abi Shaybah 8736","","","كتاب الجمعة"
"8737","(۸۷۳۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الأَصْبَغِ بْنِ زَیْدٍ ، عَنِ الْقَاسِمِ بْنِ أَبِی أَیُّوبَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ : أَنَّہُ کَانَ إذَا قَرَأَ : {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} ، قَالَ : سُبْحَانَ رَبِّی الأَعْلَی۔","","Musannaf Ibn Abi Shaybah 8737","","","كتاب الجمعة"
"8738","(۸۷۳۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْجُرَیرِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ عُمَر ، أَنَّہُ کَانَ إذَا قَرَأَ : {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} ، قَالَ سُبْحَانَ رَبِّی الأَعْلَی۔","","Musannaf Ibn Abi Shaybah 8738","","","كتاب الجمعة"
"8739","(۸۷۳۹) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ مُسْلِمٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا کَانَ لَکَ وِتْرٌ وَلِلإِمَامِ شَفْعٌ فَلاَ تَشَہُّدَ۔","","Musannaf Ibn Abi Shaybah 8739","","","كتاب الجمعة"
"8740","(۸۷۴۰) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ مُسْلِمٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ ابْنِ شِہَابٍ قَالَ : تَتَشَہَّدُ۔","","Musannaf Ibn Abi Shaybah 8740","","","كتاب الجمعة"
"8741","(۸۷۴۱) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ : فِی الرَّجُلِ یُدْرِکُ رَکْعَۃً مَعَ الإِمَامِ ، قَالَ : یَتَشَہَّدُ۔","","Musannaf Ibn Abi Shaybah 8741","","","كتاب الجمعة"
"8742","(۸۷۴۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ عَطَائٍ : فِی الرَّجُلِ یُدْرِکُ مَعَ الإِمَامِ وِتْرًا مِنَ الصَّلاَۃ ، قَالَ : لاَ یَتَشَہَّدُ۔n وَقَالَ عَمْرُو بْنُ دِینَارٍ : وأَنَا أَرَی ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 8742","","","كتاب الجمعة"
"8743","(۸۷۴۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، قَالَ : سَأَلْتُ نَافِعًا وَابْنَ شِہَابٍ عَنِ الرَّجُلِ یُسْبَقُ بِرَکْعَۃٍ فَیَجْلِسُ مَعَ الإِمَامِ ؟ قَالاَ : یَتَشَہَّدُ۔","","Musannaf Ibn Abi Shaybah 8743","","","كتاب الجمعة"
"8744","(۸۷۴۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَکَلَ مِنْ ہَذِہِ الْبَقْلَۃِ الْخَبِیثَۃِ فَلاَ یَقْرَبَنَّ مَسْجِدَنَا ، أَوِ الْمَسْجِدَ۔","Da'if","Musannaf Ibn Abi Shaybah 8744","","","كتاب الجمعة"
"8745","(۸۷۴۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَکَلَ ہَذِہِ الْبَقْلَۃَ فَلاَ یَقْرَبَنَّ الْمَسْجِدَ حَتَّی یَذْہَبَ رِیحُہَا ، یَعْنِی الثُّومَ۔ (بخاری ۴۲۱۵۔ مسلم ۶۹)","Sahih","Musannaf Ibn Abi Shaybah 8745","","","كتاب الجمعة"
"8746","(۸۷۴۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنِ الْحَکَمِ بْنِ عَطِیَّۃَ ، عَنْ أَبِی الرَّبَابِ ، عَنْ مَعْقِلِ بْنِ یَسَارٍ ، قَالَ : سَمِعْتُہُ یَقُولُ : کُنَّا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : مَنْ أَکَلَ مِنْ ہَذِہِ الشَّجَرَۃِ فَلاَ یَقْرَبَنَّ مُصَلاَّنَا ، یَعْنِی الثُّومَ۔ (بخاری ۲۶۴۔ احمد ۵/۲۶)","Da'if","Musannaf Ibn Abi Shaybah 8746","","","كتاب الجمعة"
"8747","(۸۷۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ الْعَدَوِیِّ ، عَنْ أَبِی بُرْدَۃَ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، قَالَ : أَکَلْتُ ثُومًا ، ثُمَّ أَتَیْتُ مُصَلَّی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَوَجَدْتُہُ قَدْ سَبَقَنِی بِرَکْعَۃٍ ، فَلَمَّا قُمْتُ أَقْضِی وَجَدَ رِیحَ الثُّومِ ، فَقَالَ : مَنْ أَکَلَ مِنْ ہَذِہِ الْبَقْلَۃِ فَلاَ یَقْرَبَنَّ مَسْجِدَنَا حَتَّی یَذْہَبَ رِیحُہَا ، وقَالَ مُغِیرَۃُ ، فَلَمَّا قَضَیْتُ الصَّلاَۃ أَتَیْتُہُ فَقُلْتُ : یَا رَسُولَ اللہِ إنَّ لِی عُذْرًافَنَاوِلْنی یَدَکَ ، قَالَ : فَوَجَدْتُہُ وَاللَّہِ سَہْلاً ، فَنَاوَلَنِی یَدَہُ فَأَدْخَلْتہَا فِی کُمِّی إلَی صَدْرِی فَوَجَدَہُ مَعْصُوبًا فَقَالَ : إنَّ لَکَ عُذْرًا۔ (ابوداؤد ۳۸۲۲۔ ابن حبان ۲۰۹۵)","Sahih","Musannaf Ibn Abi Shaybah 8747","","","كتاب الجمعة"
"8748","(۸۷۴۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یُونُسُ بنِ أَبِی إِسْحَاقَ ، عَنْ عُمَیْرِ بْنِ قُمَیمٍ التَّغْلِبِیِّ ، عَنْ شَرِیکِ بْنِ حَنْبَلٍ الْعَبْسِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَکَلَ مِنْ ہَذِہِ الْبَقْلَۃِ الْخَبِیثَۃِ فَلاَ یَقْرَبَنَّ مَسْجِدَنَا ، یَعْنِی الثُّومَ۔","Da'if","Musannaf Ibn Abi Shaybah 8748","","","كتاب الجمعة"
"8749","(۸۷۴۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ الْغَطَفَانِیِّ ، عَنْ مَعْدَانَ بْنِ أَبِی طَلْحَۃَ الْیَعْمُرِیِّ : أَنَّ عُمَرَ بْنَ الْخَطَّابِ قَامَ یَوْمَ جُمُعَۃٍ خَطِیبًا ، أَوْ خَطَبَنَا یَوْمَ جُمُعَۃٍ ، فَقَالَ : یَا أَیُّہَا النَّاس إنَّکُمْ تَأْکُلُونَ شَجَرَتَیْنِ لاَ أُرَاہُمَا إِلاَّ خَبِیثَتَیْنِ ہَذَا الثُّومَ وَہَذَا الْبَصَلَ ، لَقَدْ کُنْتُ أَرَی الرَّجُلَ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُوجَدُ رِیحُہُ مِنْہُ فَیُؤْخَذُ بِیَدِہِ حَتَّی یُخْرَجَ بِہِ إلَی الْبَقِیعِ ، فَمَنْ کَانَ آکِلَہُمَا لاَبُدَّ فَلْیُمِتْہُمَا طَبْخًا۔ (مسلم ۳۹۷۔ احمد ۱/۲۷)","Sahih","Musannaf Ibn Abi Shaybah 8749","","","كتاب الجمعة"
"8750","(۸۷۵۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، عَنْ أَبِیہِ ، عَنْ أُمِّ أَیُّوبَ ، قَالَتْ : صَنَعْتُ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ طَعَامًا فِیہِ مِنْ بَعْض الْبُقُولِ فَلَمْ یَأْکُلْ مِنْہُ ، وَقَالَ : إنِّی أَکْرَہُ أَنْ أُوذِیَ صَاحِبِی۔ (ترمذی ۱۸۱۰۔ احمد ۴۳۳)","Hasan","Musannaf Ibn Abi Shaybah 8750","","","كتاب الجمعة"
"8751","(۸۷۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَحَرَّوْا لَیْلَۃَ الْقَدْرِ فِی الْعَشْرِ الأَوَاخِرِ مِنْ شَہْرِ رَمَضَانَ۔ (بخاری ۲۰۲۰۔ ترمذی ۷۹۲)","Sahih","Musannaf Ibn Abi Shaybah 8751","","","كتاب الجمعة"
"8752","(۸۷۵۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُیَیْنَۃُ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنْ أَبِی بَکْرَۃَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : الْتَمِسُوا لَیْلَۃَ الْقَدْرِ فِی الْعَشْرِ الأَوَاخِرِ مِنْ شَہْرِ رَمَضَانَ ؛ لِتِسْعٍ بَقَیْنَ ، أَوْ لِسَبْعٍ ، أَوْ لِخَمْسٍ ، أَوْ لِثَلاَثٍ ، أَوْ لآخِرِ لَیْلَۃٍ۔ (ترمذی ۷۹۴۔ احمد ۵/۳۶)","Sahih","Musannaf Ibn Abi Shaybah 8752","","","كتاب الجمعة"
"8753","(۸۷۵۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَحَرَّوْا لَیْلَۃَ الْقَدْرِ فِی الْعَشْرِ الأَوَاخِرِ مِنْ شَہْرِ رَمَضَانَ۔ (مسلم ۲۰۶۔ ابوداؤ۹ ۱۳۸۰)","Sahih","Musannaf Ibn Abi Shaybah 8753","","","كتاب الجمعة"
"8754","(۸۷۵۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ جَبَلَۃَ ، وَمُحَارِبٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَحَیَّنُوا لَیْلَۃَ الْقَدْرِ فِی الْعَشْرِ الأَوَاخِرِ مِنْ شَہْرِ رَمَضَانَ۔ (مسلم ۸۱۴۔ احمد ۲/۸۱)","Sahih","Musannaf Ibn Abi Shaybah 8754","","","كتاب الجمعة"
"8755","(۸۷۵۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَوْزَاعِیِّ ، عَنْ مَرْثَدِ بْنِ أَبِی مَرْثَدٍ ، عَنْ أَبِیہِ ، قَالَ : کُنْتُُ مَعَ أَبِی ذَرٍّ عِنْدَ الْجَمْرَۃِ الْوُسْطَی ، فَسَأَلْتُہُ عَنْ لَیْلَۃِ الْقَدْرِ ؟ فَقَالَ : کَانَ أَسْأَلَ النَّاسِ عَنْہَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَا ، قُلْتُ : یَا رَسُولَ اللہِ ، لَیْلَۃُ الْقَدْرِ کَانَتْ تَکُونُ عَلَی عَہْدِ الأَنْبِیَائِ ، فَإِذَا ذَہَبُوا رُفِعَتْ ؟ قَالَ: لاَ ، وَلَکِنْ تَکُونُ إِلَی یَوْمِ الْقِیَامَۃِ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، فَأَخْبِرْنَا بِہَا ، قَالَ : لَوْ أُذِنَ لِی فِیہَا لأَخْبَرْتُکُمْ ، وَلَکِنِ الْتَمِسُوہَا فِی أَحَدِ السَّبْعَیْنِ ، ثُمَّ لاَ تَسْأَلْنِی عَنْہَا بَعْدَ مَقَامِی ، أَوْ مَقَامِکَ ہَذَا ، ثُمَّ أَخَذَ فِی حَدِیثٍ ، فَلَمَّا انْبَسَطَ قُلْتُ : یَا رَسُولَ اللہِ ، أَقْسَمْتُ عَلَیْک إِلاَّ حَدَّثْتنِی بِہَا ، قَالَ أَبُو ذَرٍّ : فَغَضِبَ عَلَیَّ غَضْبَۃً لَمْ یَغْضَبْ عَلَیَّ قَبْلَہَا ، وَلاَ بَعْدَہَا مِثْلَہَا۔ (نسائی ۳۴۲۷۔ ابن خزیمۃ ۲۱۷۰)","Da'if","Musannaf Ibn Abi Shaybah 8755","","","كتاب الجمعة"
"8756","(۸۷۵۶) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی یَعْفُورٍ ، عَنْ أَبِی الصَّلْتِ ، عَنْ أَبِی عَقْرَبٍ الأَسَدِیِّ ، قَالَ : أَتَیْنَا ابْنَ مَسْعُودٍ فِی دَارِہِ فَوَجَدْنَاہُ فَوْقَ الْبَیْتِ فَسَمِعْنَاہُ یَقُولُ قَبْلَ أَنْ یَنْزِلَ : صَدَقَ اللَّہُ وَرَسُولُہُ ، فَقُلْنَا لَہُ : سَمِعْنَاکَ تَقُولُ قَبْلَ أَنْ تَنْزِلَ : صَدَقَ اللَّہُ وَرَسُولُہُ ، فَقَالَ : لَیْلَۃَ الْقَدْرِ فِی السَّبْعِ مِنَ النِّصْفِ الآخِرِ ، وَذَلِکَ أَنَّ الشَّمْسَ تَطْلُعُ یَوْمَئِذٍ بَیْضَائَ لاَ شُعَاعَ لَہَا ، فَنَظَرْتُ إلَی الشَّمْسِ فَرَأَیْتہَا کَمَا حُدِّثْتُ فَکَبَّرْتُ۔ (احمد ۱/۴۰۶۔ طیالسی ۳۹۴)","Da'if","Musannaf Ibn Abi Shaybah 8756","","","كتاب الجمعة"
"8757","(۸۷۵۷) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أُتِیتُ وَأَنَا نَائِمٌ فِی رَمَضَانَ فَقِیلَ لِی : إنَّ اللَّیْلَۃَ لَیْلَۃُ الْقَدْرِ ، قَالَ : فَقُمْتُ وَأَنَا نَاعِسٌ فَتَعَلَّقْتُ بِبَعْضِ أَطْنَابِ فُسْطَاطِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَأَتَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یُصَلِّی ، فَنَظَرْتُ فِی اللَّیْلَۃِ فَإِذَا ہِیَ لَیْلَۃُ ثَلاَثٍ وَعِشْرِینَ ، قَالَ : وَقَالَ ابْنُ عَبَّاسٍ : إنَّ الشَّیْطَانَ یَطْلُعُ مَعَ الشَّمْسِ کُلَّ لَیْلَۃٍ إِلاَّ لَیْلَۃَ الْقَدْرِ ، وَذَلِکَ أَنَّہَا تَطْلُعُ یَوْمَئِذٍ بَیْضَائَ لاَ شُعَاعَ لَہَا۔ (احمد ۱/۲۵۵۔ طبرانی ۱۱۷۷۷)","","Musannaf Ibn Abi Shaybah 8757","","","كتاب الجمعة"
"8758","(۸۷۵۸) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ قَنَانِ بْنِ عَبْدِ اللہِ النَّہْمِیِّ ، قَالَ : سَأَلْتُ زِرًّا عَنْ لَیْلَۃِ الْقَدْرِ ؟ فَقَالَ : کَانَ عُمَرُ وَحُذَیْفَۃُ وَنَاسٌ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ یَشُکُّونَ أَنَّہَا لَیْلَۃُ سَبْعٍ وَعِشْرِینَ ، تَبْقَی ثَلاَثٌ ، قَالَ : قَالَ زِرٌّ : فَوَاصلہَا۔","Hasan","Musannaf Ibn Abi Shaybah 8758","","","كتاب الجمعة"
"8759","(۸۷۵۹) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ ابْنِ أَبِی خَالِدٍ ، عَنْ زِرٍّ ، قَالَ : سَمِعْتُ أُبَیَّ بْنَ کَعْبٍ یَقُولُ : لَیْلَۃُ الْقَدْرِ لَیْلَۃُ سَبْعٍ وَعِشْرِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 8759","","","كتاب الجمعة"
"8760","(۸۷۶۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، وَابْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ مَرْثَدِ بْنِ عَبْدِ اللہِ الْیَزَنِیِّ ، عَنِ الصُّنَابِحِیِّ ، قَالَ : سَأَلْتُ بِلاَلاً عَنْ لَیْلَۃِ الْقَدْرِ ، قَالَ : لَیْلَۃُ الْقَدْرِ ثَلاَثٍ وَعِشْرِینَ۔","","Musannaf Ibn Abi Shaybah 8760","","","كتاب الجمعة"
"8761","(۸۷۶۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ عُمَرَ ، قَالَ : لَقَدْ عَلِمْتُمْ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ فِی لَیْلَۃِ الْقَدْرِ : اُطْلُبُوہَا فِی الْعَشْرِ الأَوَاخِرِ وِتْرًا۔ (احمد ۱/۴۳۔ ابویعلی ۱۶۵)","Hasan","Musannaf Ibn Abi Shaybah 8761","","","كتاب الجمعة"
"8762","(۸۷۶۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَبْدِ اللہِ ، قَالَ : تَحَرَّوْا لَیْلَۃَ الْقَدْرِ لِسَبْعٍ تَبْقَی ، تَحَرَّوْہَا لِتِسْعٍ تَبْقَی ، تَحَرَّوْہَا لإِحْدَی عَشْرَۃَ تَبْقَی صَبِیحَۃَ بَدْرٍ ، فَإِنَّ الشَّمْسَ تَطْلُعُ کُلَّ یَوْمٍ بَیْنَ قَرْنَیْ شَیْطَانٍ إِلاَّ صَبِیحَۃَ بَدْرٍ فَإِنَّہَا تَطْلُعُ بَیْضَائَ لَیْسَ لَہَا شُعَاعٌ۔","Sahih","Musannaf Ibn Abi Shaybah 8762","","","كتاب الجمعة"
"8763","(۸۷۶۳) حَدَّثَنَا عَمْرُو بْنُ طَلْحَۃَ ، عَنْ أَسْبَاطِ بْنِ نَصْرٍ ، عَنْ سِمَاکٍ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اُطْلُبُوا لَیْلَۃَ الْقَدْرِ فِی الْعَشْرِ الأَوَاخِرِ مِنْ رَمَضَانَ۔ (طبرانی ۱۹۴۱)","Hasan","Musannaf Ibn Abi Shaybah 8763","","","كتاب الجمعة"
"8764","(۸۷۶۴) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہُبَیْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا دَخَلَتِ الْعَشْرُ الأَوَاخِرُ أَیْقَظَ أَہْلَہُ ، وَرَفَعَ الْمِئْزَرَ ۔ قِیلَ لأَبِی بَکْرٍ : مَا رَفْعُ الْمِئْزَرِ ؟ قَالَ : اعْتِزَالُ النِّسَائِ۔ (ترمذی ۷۹۵۔ احمد ۱/۹۸)","Hasan","Musannaf Ibn Abi Shaybah 8764","","","كتاب الجمعة"
"8765","(۸۷۶۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابن عُمَر قَالَ : لَیْلَۃُ الْقَدْر فِی کُل شَہْر رَمَضَانَ۔","Sahih","Musannaf Ibn Abi Shaybah 8765","","","كتاب الجمعة"
"8766","(۸۷۶۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہُبَیْرَۃَ ، عَنْ عَلِیٍّ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُوقِظُ أَہْلَہُ فِی الْعَشْرِ الأَوَاخِرِ مِنْ رَمَضَانَ۔ (ترمذی ۷۹۵۔ ابو یعلی ۳۷۲)","Hasan","Musannaf Ibn Abi Shaybah 8766","","","كتاب الجمعة"
"8767","(۸۷۶۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَبْدِ اللہِ ، قَالَ : مَنْ یَقُمِ الْحَوْلَ یُدْرِکْہَا، قَالَ : وَقَالَ أُبَیٌّ : لَقَدْ عَلِمَ عَبْدُ اللہِ أَنَّہَا فِی شَہْرِ رَمَضَانَ ، لَیْلَۃَ سَبْعٍ وَعِشْرِینَ۔ (مسلم ۲۲۰۔ ابوداؤد ۱۳۷۳)","Da'if","Musannaf Ibn Abi Shaybah 8767","","","كتاب الجمعة"
"8768","(۸۷۶۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی خَالِدٍ ، قَالَ : سَمِعْتُ زِرَّ بْنَ حُبَیْشٍ الأَسَدِیَّ یَقُولُ : سَمِعْتُ أُبَیًّا یَقُولُ : ہِیَ لَیْلَۃُ سَبْعٍ وَعِشْرِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 8768","","","كتاب الجمعة"
"8769","(۸۷۶۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ بْنِ شَرِیکٍ الْعَامِرِیِّ ، قَالَ : سَمِعْتُ زِرَّ بْنَ حُبَیْشٍ یَقُولُ : إذَا کَانَتْ لَیْلَۃَ سَبْعٍ وَعِشْرِینَ فَاغْتَسِلُوا ، وَمَنِ اسْتَطَاعَ مِنْکُمْ أَنْ یُؤَخِّرَ فِطْرَہُ إلَی السَّحَرِ فَلْیَفْعَلْ ، وَلْیُفْطِرْ عَلَی ضَیَاح لَبَنٍ۔","","Musannaf Ibn Abi Shaybah 8769","","","كتاب الجمعة"
"8770","(۸۷۷۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْلَۃُ الْقَدْرِ لَیْلَۃٌ بَلْجَۃٌ سَمْحَۃٌ ، تَطْلُعُ شَمْسُہَا لَیْسَ لَہَا شُعَاعٌ۔","","Musannaf Ibn Abi Shaybah 8770","","","كتاب الجمعة"
"8771","(۸۷۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُمَرُ بْنُ شَیْبَۃَ بْنِ قَارِظٍ ، قَالَ : سَمِعْتُ أَبَا بَکْرِ بْنَ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ یَقُولُ : لَیْلَۃُ الْقَدْرِ لَیْلَۃُ سَبْعَ عَشْرَۃَ ، لَیْلَۃَ جُمُعَۃٍ۔","","Musannaf Ibn Abi Shaybah 8771","","","كتاب الجمعة"
"8772","(۸۷۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ وَأَبُوہُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ حُجَیْرٍ التَّغْلِبِیِّ ، عَنِ الأَسْوَدِ ، عَنْ عَبْدِاللہِ، قَالَ: الْتَمِسُوا لَیْلَۃَ الْقَدْرِ لَیْلَۃَ سَبْعَ عَشْرَۃَ ، فَإِنَّہَا صَبِیحَۃُ بَدْرٍ ، یَوْمَ الْفُرْقَانِ ، یَوْمَ الْتَقَی الْجَمْعَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 8772","","","كتاب الجمعة"
"8773","(۸۷۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعَۃَ بْنِ کُلْثُومٍ ، قَالَ : سَمِعْتُ الْحَسَنَ یَقُولُ : ہِیَ فِی کُلِّ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 8773","","","كتاب الجمعة"
"8774","(۸۷۷۴) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، عَنْ عُبَادَۃَ بْنِ الصَّامِتِ ، قَالَ : خَرَجَ عَلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یُرِیدُ أَنْ یُخْبِرَہُمْ بِلَیْلَۃِ الْقَدْرِ ، فَتَلاَحَی رَجُلاَنِ ، فَقَالَ : إنِّی خَرَجْتُ وَأَنَا أُرِیدُ أَنْ أُخْبِرَکُمْ بِلَیْلَۃِ الْقَدْرِ فَتَلاَحَی فُلاَنٌ وَفُلاَنٌ ، وَلَعَلَّ ذَلِکَ أَنْ یَکُونَ خَیْرًا ، الْتَمِسُوہَا فِی التَّاسِعَۃِ وَالسَّابِعَۃِ وَالْخَامِسَۃِ۔ (بخاری ۴۹۔ احمد ۵/۳۱۳)","Sahih","Musannaf Ibn Abi Shaybah 8774","","","كتاب الجمعة"
"8775","(۸۷۷۵) حَدَّثَنَا شَبَابَۃُ ، عَنْ لَیْثِ بْنِ سَعْدٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ خُبَیْبٍ ، عَنْ عَبْدِ اللہِ بْنِ أُنَیْسٍ صَاحِبِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ سُئِلَ عَنْ لَیْلَۃِ الْقَدْرِ ؟ فَقَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : الْتَمِسُوہَا اللَّیْلَۃ ، وَتِلْکَ اللَّیْلَۃ لَیْلَۃ ثَلاَثٍ وَعِشْرِینَ۔ (ابوداؤد ۱۳۷۴۔ احمد ۳/۴۹۵)","Da'if","Musannaf Ibn Abi Shaybah 8775","","","كتاب الجمعة"
"8776","(۸۷۷۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، عَنْ خَالِہِ الْفَلَتَانِ بْنِ عَاصِمٍ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إنِّی رَأَیْتُ لَیْلَۃَ الْقَدْرِ فَأُنْسِیتُہَا، فَاطْلُبُوہَا فِی الْعَشْرِ الأَوَاخِرِ وِتْرًا۔(طبرانی ۸۵۹)","Hasan","Musannaf Ibn Abi Shaybah 8776","","","كتاب الجمعة"
"8777","(۸۷۷۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَجْلَحِ ، عَنِ الشَّعْبِیِّ ، عَنْ زِرِّ بْنِ حُبَیْشٍ ، قَالَ : سَمِعْتُ أُبَیَّ بْنَ کَعْبٍ یَقُولُ: ہِیَ لَیْلَۃُ سَبْعٍ وَعِشْرِینَ ، ہِیَ اللَّیْلَۃُ الَّتِی أَخْبَرَنَا بِہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّ الشَّمْسَ تَطْلُعُ بَیْضَائَ تَرَقْرَقُ۔ (مسلم ۱۷۹۔ ابوداؤد ۱۳۷۳)","Hasan","Musannaf Ibn Abi Shaybah 8777","","","كتاب الجمعة"
"8778","(۸۷۷۸) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُوقِظُ أَہْلَہُ فِی الْعَشْرِ الأَوَاخِرِ مِنْ رَمَضَانَ ، وَیُشَمِّرُ فِیہِنَّ۔","","Musannaf Ibn Abi Shaybah 8778","","","كتاب الجمعة"
"8779","(۸۷۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : أَخْبَرَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ بْنِ یَزِیدَ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَانَتْ تُوقِظُ أَہْلَہَا لَیْلَۃَ ثَلاَثٍ وَعِشْرِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 8779","","","كتاب الجمعة"
"8780","(۸۷۸۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ؛ أَنَّ ابْنَ عَبَّاسٍ کَانَ یَرُشُّ عَلَی أَہْلِہِ الْمَائَ لَیْلَۃَ ثَلاَثٍ وَعِشْرِینَ۔","","Musannaf Ibn Abi Shaybah 8780","","","كتاب الجمعة"
"8781","(۸۷۸۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ یُوقِظُ أَہْلَہُ فِی الْعَشْرِ الأَوَاخِرِ۔","Da'if","Musannaf Ibn Abi Shaybah 8781","","","كتاب الجمعة"
"8782","(۸۷۸۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُیَیْنَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، قَالَ : کَانَ أَبُو بَکْرَۃَ یُصَلِّی فِی رَمَضَانَ کَصَلاَتِہِ فِی سَائِرِ السَّنَۃِ ، فَإِذَا دَخَلَتِ الْعَشْرُ الأَوَاخِرُ اجْتَہَدَ۔","Sahih","Musannaf Ibn Abi Shaybah 8782","","","كتاب الجمعة"
"8783","(۸۷۸۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِیَادٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ : حَدَّثَنَا إبْرَاہِیمُ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَجْتَہِدُ فِی الْعَشْرِ اجْتِہَادًا ، لاَ یَجْتَہِدُ فِی غَیْرِہِ۔ (مسلم۸۔ ترمذی ۷۹۶)","Sahih","Musannaf Ibn Abi Shaybah 8783","","","كتاب الجمعة"
"8784","(۸۷۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ؛ {إنَّا أَنْزَلْنَاہُ فِی لَیْلَۃِ الْقَدْرِ}، قَالَ: لَیْلَۃُ الْحُکْمِ ، {وَمَا أَدْرَاک مَا لَیْلَۃُ الْقَدْرِ} ، قَالَ : لَیْلَۃُ الْحُکْمِ۔","","Musannaf Ibn Abi Shaybah 8784","","","كتاب الجمعة"
"8785","(۸۷۸۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : یَوْمُہَا کَلَیْلَتِہَا ، وَلَیْلَتُہَا کَیَوْمِہَا۔","","Musannaf Ibn Abi Shaybah 8785","","","كتاب الجمعة"
"8786","(۸۷۸۶) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ، قَالَ : مَنْ صَلَّی الْمَغْرِبَ وَالْعِشَائَ فِی جَمَاعَۃٍ لَیْلَۃَ الْقَدْرِ فَقَدْ أَخَذَ بِنَصِیبِہِ مِنْہَا۔","","Musannaf Ibn Abi Shaybah 8786","","","كتاب الجمعة"
"8787","(۸۷۸۷) أَخْبَرَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : حَدَّثَنَا ثَابِتٌ ، قَالَ: قَدِمَ عَلَیْنَا سُلَیْمَانُ مَوْلَی الْحَسَنِ بْنِ عَلِیٍّ زَمَانَ الْحَجَّاجِ ، فحَدَّثَنَا عَنْ عَبْدِ اللہِ بْنِ أَبِی طَلْحَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَائَ ذَاتَ یَوْمٍ وَالْبِشْر یُرَی فِی وَجْہِہِ فَقُلْنَا : یَا رَسُولَ اللہِ ، إنَّا لَنَرَی َالْبِشْرَ فِی وَجْہِکَ ، فَقَالَ : أَتَانِی الْمَلَکُ فَقَالَ : یَا مُحَمَّدُ ، إنَّ رَبَّکَ یَقُولُ : أَمَا یُرْضِیکَ أَنْ لاَ یُصَلِّیَ عَلَیْکَ أَحَدٌ مِنْ أُمَّتِکَ إِلاَّ صَلَّیْتُ عَلَیْہِ عَشْرًا ، وَلاَ یُسَلِّمُ عَلَیْکَ أَحَدٌ إِلاَّ سَلَّمْتُ عَلَیْہِ عَشْرًا ؟ قَالَ : بَلَی۔ (احمد ۴/۲۹۔ دارمی۲۷۷۳)","Da'if","Musannaf Ibn Abi Shaybah 8787","","","كتاب الجمعة"
"8788","(۸۷۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عَاصِمِ بْنِ عُبَیْدِ اللہِ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرِ بْنِ رَبِیعَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ صَلَّی عَلَیَّ لَمْ تَزَلِ الْمَلاَئِکَۃُ تُصَلِّی عَلَیْہِ مَا دَامَ یُصَلِّی عَلَیَّ ، فَلْیُقِلَّ الْعَبْدُ مِنْ ذَلِکَ ، أَوْ لِیُکْثِرْ۔ (احمد ۳/۴۴۶۔ طیالسی ۱۱۴۲)","Da'if","Musannaf Ibn Abi Shaybah 8788","","","كتاب الجمعة"
"8789","(۸۷۸۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ عَبْدِ الرَّحْمَنِ بن یَزِیدَ بْنِ جَابِرٍ ، عَنْ أَبِی الأَشْعَثِ الصَّنْعَانِیِّ ، عَنْ أَوْسِ بْنِ أَوْسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ مِنْ أَفْضَلِ أَیَّامِکُمْ یَوْمَ الْجُمُعَۃِ ، فِیہِ خُلِقَ آدَم ، وَفِیہِ النَّفْخَۃُ ، وَفِیہِ الصَّعْقَۃُ ، فَأَکْثِرُوا عَلَیَّ مِنَ الصَّلاَۃ فِیہِ ، فَإِنَّ صَلاَتَکُمْ مَعْرُوضَۃٌ عَلَیَّ ، فَقَالَ رَجُلٌ : یَا رَسُولَ اللہِ ، کَیْفَ تُعْرَضُ صَلاَتُنَا عَلَیْکَ وَقَدْ أَرَمْتَ ؟ یَعْنِی بَلِیتَ ، فَقَالَ : إنَّ اللَّہَ حَرَّمَ عَلَی الأَرْضِ أَنْ تَأْکُلَ أَجْسَادَ الأَنْبِیَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 8789","","","كتاب الجمعة"
"8790","(۸۷۹۰) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الْعَوَّامِ ، قَالَ : حدَّثَنَا رَجُلٌ مِنْ بَنِی أَسَدٍ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، أَنَّہُ قَالَ : مَنْ صَلَّی عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کُتِبَتْ لَہُ عَشْرُ حَسَنَاتٍ، وَحُطَّ عَنْہُ عَشْرُ سَیِّئَاتٍ، وَرُفِعَ لَہُ عَشْرُ دَرَجَاتٍ۔","Da'if","Musannaf Ibn Abi Shaybah 8790","","","كتاب الجمعة"
"8791","(۸۷۹۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ یَزِیدَ الرَّقَاشِیِّ ؛ أَنَّ مَلَکًا مُوَکَّلٌ بِمَنْ صَلَّی عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنْ یُبَلِّغَ عَنْہُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّ فُلاَنًا مِنْ أُمَّتِکَ صَلَّی عَلَیْکَ۔","","Musannaf Ibn Abi Shaybah 8791","","","كتاب الجمعة"
"8792","(۸۷۹۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو حُرَّۃَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَکْثِرُوا الصَّلاَۃ عَلَیَّ یَوْمَ الْجُمُعَۃِ ، فَإِنَّہَا مَعْرُوضَۃٌ عَلَیَّ۔","","Musannaf Ibn Abi Shaybah 8792","","","كتاب الجمعة"
"8793","(۸۷۹۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو حُرَّۃَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَفَی بِہِ شُحًّا أَنْ أُذْکَرَ عِنْدَہُ ، ثُمَّ لاَ یُصَلِّی عَلَیَّ۔","","Musannaf Ibn Abi Shaybah 8793","","","كتاب الجمعة"
"8794","(۸۷۹۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ صَلَّی عَلَیَّ صَلاَۃً ، صَلَّی اللَّہُ عَلَیْہِ عَشْرَ صَلَوَاتٍ۔","","Musannaf Ibn Abi Shaybah 8794","","","كتاب الجمعة"
"8795","(۸۷۹۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یُونُسَ بْنِ عَمْرٍو ، عَنْ بُرَیدِ بْنِ أَبِی مَرْیَمَ ، عْن أَنَسِ بْنِ مَالِکٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ صَلَّی عَلَیَّ صَلاۃ وَاحِدَۃً صَلَّی اللَّہُ عَلَیْہِ عَشْرَ صَلَوَاتٍ ، وَحَطَّ عَنْہُ عَشْرَ سَیِّئَاتٍ۔ (بخاری ۶۴۳۔ احمد ۳/۲۶۱)","Hasan","Musannaf Ibn Abi Shaybah 8795","","","كتاب الجمعة"
"8796","(۸۷۹۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ کَعْبٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: صَلُّوا عَلَیَّ ، فَإِنَّ صَلاَۃً عَلَیَّ زَکَاۃٌ لَکُمْ۔ (ترمذی ۳۶۱۲۔ احمد ۲/۳۶۵)","Da'if","Musannaf Ibn Abi Shaybah 8796","","","كتاب الجمعة"
"8797","(۸۷۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ السَّائِبِ ، عَنْ زَاذَانَ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ لِلَّہِ مَلاَئِکَۃً سَیَّاحِینَ فِی الأَرْضِ یُبَلِّغُونِی عَنْ أُمَّتِی السَّلاَمَ۔ (احمد ۱/۳۸۷۔ دارمی ۲۷۷۴)","Sahih","Musannaf Ibn Abi Shaybah 8797","","","كتاب الجمعة"
"8798","(۸۷۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنِ الطُّفَیْلِ بْنِ أُبَیٍّ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَجُلٌ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَرَأَیْتَ إِنْ جَعَلْتُ صَلاَتِی کُلَّہَا صَلاَۃً عَلَیْکَ ؟ قَالَ : إذًا یَکْفِیکَ اللَّہُ مَا أَہَمَّکَ مِنْ أَمْرِ دُنْیَاکَ وَآخِرَتِکَ۔ (ترمذی ۲۴۵۷۔ احمد ۵/۱۳۶)","Da'if","Musannaf Ibn Abi Shaybah 8798","","","كتاب الجمعة"
"8799","(۸۷۹۹) حَدَّثَنَا زَیدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنِی مُوسَی بْنُ عُبَیْدَۃَ ، عَنْ قَیْسِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِی صَعْصَعَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِیہِ ، عَنْ جَدِّہِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : سَجَدْتُ شُکْرًا لِرَبِّی فِیمَا أَبْلاَنِی فِی أُمَّتِی ، مَنْ صَلَّی عَلَیَّ صَلاَۃً کُتِبَتْ لَہُ عَشْرُ حَسَنَاتٍ ، وَمُحِیَ عَنْہُ عَشْرُ سَیِّئَاتٍ۔","Da'if","Musannaf Ibn Abi Shaybah 8799","","","كتاب الجمعة"
"8800","(۸۸۰۰) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَنْسَی التَّشَہُّدَ حَتَّی یَخْرُجَ مِنْ صَلاَتِہِ ، فَقَالَ : إِنْ کَانَ خَرَجَ مِنْہَا فَقَدْ تَمَّتْ صَلاَتُہُ ، وَإِنْ لَمْ یَخْرُجْ مِنْہَا تَشَہَّدَ ، قَالَ : کَأَنَّ الْخُرُوجَ عِنْدَہُ أَنْ یَتَکَلَّمَ ، أَوْ یَدْخُلَ فِی صَلاَۃٍ أُخْرَی ، أَوْ یُوَلِّی ظَہْرَہُ الْقِبْلَۃَ۔","","Musannaf Ibn Abi Shaybah 8800","","","كتاب الجمعة"
"8801","(۸۸۰۱) حَدَّثَنَا عُمَرُ بْنُ ہَارُونَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی رَجُلِ نَسِیَ التَّشَہُّدَ فِی صَلاَتِہِ ، فَقَالَ : لاَ شَیْئَ عَلَیْہِ ، صَلاَتُہُ جَائِزَۃٌ۔","","Musannaf Ibn Abi Shaybah 8801","","","كتاب الجمعة"
"8802","(۸۸۰۲) حَدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنِ الرَّجُلِ یَنْسَی التَّشَہُّدَ ؟ فَقَالاَ : أَکُلُّ النَّاسِ یُحْسِنُ یَتَشَہَّد ؟ جَازَتْ صَلاَتُہُ۔","","Musannaf Ibn Abi Shaybah 8802","","","كتاب الجمعة"
"8803","(۸۸۰۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِیہِ ، عَنِ الْحَارِثِ بْنِ شُبیلٍ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ؛ أَنَّ ابْنَ عُمَرَ لَمْ یَجْلِسْ فِی الرَّکْعَتَیْنِ ، فَتَشَہَّدَ فِی آخِرِ صَلاَتِہِ مَرَّتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 8803","","","كتاب الجمعة"
"8804","(۸۸۰۴) حَدَّثَنَا عَلِیُّ بْنُ الْجَعْدِ ، قَالَ : حدَّثَنَا أَبُو جَعْفَرٍ الرَّازِیّ ، عَنْ لَیْثٍ ، عَنْ غَالِبٍ ، عَنْ مُحَمَّدِ بْنِ عَلِیٍّ ، قَالَ : إذَا جَلَسَ قَدْرَ التَّشَہُّدِ ، ثُمَّ أَحْدَثَ فَقَدْ تَمَّتْ صَلاَتُہُ ، لأَنَّ لَیْسَ کُلُّ أَحَدٍ یُحْسِنَ أنْ یَتَشَہَّدَ۔","Hasan","Musannaf Ibn Abi Shaybah 8804","","","كتاب الجمعة"
"8805","(۸۸۰۵) حَدَّثَنَا وَکِیعٌ ، أَوْ غَیْرُہُ ، عَنْ شُعْبَۃَ ، عَنْ مُسْلِمٍ أَبِی النَّضْرِ ، عَنِ ابْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : قَالَ عُمَرُ : لاَ صَلاَۃَ إِلاَّ بِتَشَہُّدٍ۔","Da'if","Musannaf Ibn Abi Shaybah 8805","","","كتاب الجمعة"
"8806","(۸۸۰۶) حَدَّثَنَا جَعْفَرُ بْنُ بُرْقَانَ ، عَنْ عُقْبَۃَ بْنِ نَافِعٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : لَیْسَ مِنْ صَلاَۃٍ إِلاَّ وَفِیہَا قِرَائَۃٌ ، وَجُلُوسٌ فِی الرَّکْعَتَیْنِ ، وَتَشَہُّدٌ وَتَسْلِیمٌ ، فَإِنْ لَمْ تَفْعَلْ ذَلِکَ سَجَدْتَ سَجْدَتَیْنِ بَعْدَ مَا تُسَلِّمُ ، وَأَنْتَ جَالِسٌ۔","Da'if","Musannaf Ibn Abi Shaybah 8806","","","كتاب الجمعة"
"8807","(۸۸۰۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ مُسْلِمٍ أَبِی النَّضْرِ ، قَالَ : سَمِعْتُ حَمَلَۃَ بْنَ عَبْدِ الرَّحْمَنِ یَقُولُ : قَالَ عُمَرُ : لاَ صَلاَۃَ إِلاَّ بِتَشَہُّدٍ۔","Da'if","Musannaf Ibn Abi Shaybah 8807","","","كتاب الجمعة"
"8808","(۸۸۰۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عُثْمَانُ بْنُ حَکِیمٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَا أعْلَمُ الصَّلاَۃَ تَنْبَغِی مِنْ أَحَدٍ عَلَی أَحَدٍ إِلاَّ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 8808","","","كتاب الجمعة"
"8809","(۸۸۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ ، عَنْ نُبَیْحٍ ، عَنْ جَابِرٍ ، قَالَ : أَتَیْتُُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَسْتَعِینُہُ فِی دَیْنٍ کَانَ عَلَی أَبِی ، قَالَ : انْصَرِفْ أَنَا آتِیکُمْ ، فَأَتَانَا وَقَدْ قُلْتُ لِلْمَرْأَۃِ لاَ تُکَلِّمِینَ رَسُولَ اللہِ ، وَلاَ تُؤْذِینَہُ ، فَلَمَّا خَرَجَ ، قَالَتِ الْمَرْأَۃُ : یَا رَسُولَ اللہِ ، صَلِّ عَلَیَّ وَعَلَی زَوْجِی ، فَقَالَ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَلَّی اللَّہُ عَلَیْکِ وَعَلَی زَوْجِکِ ، قَالَتْ : یَا رَسُولَ اللہِ ، تَأْتِینَا وَلاَ تَدْعُو لَنَا ؟ (احمد ۳/۳۰۳۔ دارمی۴۵)","Sahih","Musannaf Ibn Abi Shaybah 8809","","","كتاب الجمعة"
"8810","(۸۸۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنِ ابْنِ أَبِی أَوْفَی ، قَالَ : أَتَیْتُُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِصَدَقَۃِ أَبِی فَقَبِلَہَا ، وَقَالَ : اللَّہُمَّ صَلِّ عَلَی آلِ أَبِی أَوْفَی۔ (بخاری ۱۴۹۷۔ مسلم ۱۷۶)","Sahih","Musannaf Ibn Abi Shaybah 8810","","","كتاب الجمعة"
"8811","(۸۸۱۱) حَدَّثَنَا عَبْدَۃُ بن سُلَیْمَان ، عَنْ سَعِید ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَسْتَرْخِی إزَارُہُ وَہُوَ فِی الصَّلاَۃ ، قَالَ : لاَ یَحِلُّہُ ، وَلاَ یُفَرِّجُہُ وَلَکِنَّہُ یُدْرِجُہُ وَیَرْفَعُہُ۔","","Musannaf Ibn Abi Shaybah 8811","","","كتاب الجمعة"
"8812","(۸۸۱۲) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ مُسْلِمٍ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا أَرَدْتَ أَنْ تَتَّزِرَ وَعَلَیْکَ إزَارٌ وَرِدَائٌ وَأَنْتَ فِی الصَّلاَۃ ، فَأَرْخِ رِدَائَکَ وَاتَّزِرْ ۔ قَالَ : فَذَکَرْتُہُ لِطَاوُوس ، فَقَالَ : ہُوَ خَیْرٌ ، أَوْ ذَاکَ خَیْرٌ۔","","Musannaf Ibn Abi Shaybah 8812","","","كتاب الجمعة"
"8813","(۸۸۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعِ بْنِ صُبَیْحٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَرِہَ أَنْ یُحْدِثَ الرَّجُلُ فِی الصَّلاَۃ شَیْئًا حَتَّی زَرَّ الْقَمِیصِ ۔ قَالَ : وَکَانَ إبْرَاہِیمُ لاَ یَرَی بَأْسًا إذَا اسْتَرْخَی إزَارُہُ فِی الصَّلاَۃ أَنْ یَرْفَعَہُ۔","","Musannaf Ibn Abi Shaybah 8813","","","كتاب الجمعة"
"8814","(۸۸۱۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ السَّلاَمِ بْنُ شَدَّادٍ أَبُو طَالُوتِ الْجُرَیرِیُّ ، عَنْ غَزْوَانَ بْنِ جَرِیرٍ الضَّبِّیِّ ، عَنْ أَبِیہِ ، قَالَ: کَانَ عَلِیٌّ إذَا قَامَ فِی الصَّلاَۃ وَضَعَ یَمِینَہُ عَلَی رُسْغِہِ ، فَلاَ یَزَالُ کَذَلِکَ حَتَّی یَرْکَعَ مِثْلَ مَا رَکَعَ، إِلاَّ أَنْ یُصْلِحَ ثَوْبَہُ ، أَوْ یَحُکَّ جَسَدَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 8814","","","كتاب الجمعة"
"8815","(۸۸۱۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَرِہَ أَنْ یَتَوَشَّحَ ، أَوْ یَرْتَدِیَ وَہُوَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8815","","","كتاب الجمعة"
"8816","(۸۸۱۶) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : قرَأْتُُ عَلَی عَبْدِ اللہِ ، فَقَالَ : رَتِّلْ فِدَاکَ أَبِی وَأُمِّی ، فَإِنَّہُ زَیْنُ الْقُرْآنِ۔","Sahih","Musannaf Ibn Abi Shaybah 8816","","","كتاب الجمعة"
"8817","(۸۸۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ (وَرَتِّلِ الْقُرْآنَ تَرْتِیلاً) ، قَالَ : بَیِّنْہُ تَبْیِینًا۔","Da'if","Musannaf Ibn Abi Shaybah 8817","","","كتاب الجمعة"
"8818","(۸۸۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ؛ (وَرَتِّلَ الْقُرْآنَ تَرْتِیلاً) ، قَالَ : بَعْضُہُ عَلَی إِثْرِ بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 8818","","","كتاب الجمعة"
"8819","(۸۸۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی وَائِلٍ ، قَالَ : جَائَ رَجُلٌ مِنْ بَنِی بَجِیلَۃَ ، یُقَالُ لَہُ : نَہِیکُ بْنُ سِنَانٍ إلَی ابْنِ مَسْعُودٍ ، فَقَالَ : یَا أَبَا عَبْدِ الرَّحْمَنِ ، کَیْفَ تَقْرَأُ ہَذَا الْحَرْفَ ، أَیَائً تَجِدُہُ ، أَمْ أَلِفًا ؟ {مِنْ مَائٍ غَیْرِ یَاسِنٍ} ، أَوْ {مِنْ مَائٍ غَیْرِ آسِنٍ} ؟ قَالَ : فَقَالَ لَہُ عَبْدُ اللہِ : وَکُلَّ الْقُرْآنِ أَحْصَیْتَ غَیْرَ ہَذَا ؟ قَالَ : فَقَالَ لَہُ : إنِّی لأَقْرَأُ الْمُفَصَّلَ فِی رَکْعَۃٍ ، قَالَ : ہَذًّا کَہَذِّ الشِّعْرِ ، إنَّ قَوْمًا یَقْرَؤُونَ الْقُرْآنَ لاَ یَتَجَاوَزُ تَرَاقِیَہُمْ ، وَلَکِنَّ الْقُرْآنَ إذَا وَقَعَ فِی الْقَلْبِ فَرَسَخَ نَفَعَ ، إنَّ أَفْضَلَ الصَّلاَۃ الرُّکُوعُ وَالسُّجُودُ ، قَالَ : وَقَالَ عَبْدُاللہِ: إنِّی لأَعْرِفُ النَّظَائِرَ الَّتِی کَانَ یَقْرَأُ بِہِنَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔(بخاری۷۷۵۔ مسلم ۲۷۶)","Sahih","Musannaf Ibn Abi Shaybah 8819","","","كتاب الجمعة"
"8820","(۸۸۲۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ الأَزْدِیُّ ، عَنْ قَتَادَۃَ ، قَالَ : سُئِلَ أَنَسٌ ، عَنْ قِرَائَۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَقَالَ : کَانَ یَمُدُّ بِہَا صَوْتَہُ مَدًّا۔ (بخاری ۵۰۴۵۔ احمد ۳/۱۱۹)","Sahih","Musannaf Ibn Abi Shaybah 8820","","","كتاب الجمعة"
"8821","(۸۸۲۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ أُمِّ سَلَمَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْرَأُ : بِسْمِ اللہِ الرَّحْمَن الرَّحِیمِ الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ ، تَعْنِی حَرْفًا حَرْفًا۔ (ترمذی ۲۹۲۷۔ ابوداؤد ۳۹۹۷)","","Musannaf Ibn Abi Shaybah 8821","","","كتاب الجمعة"
"8822","(۸۸۲۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، قَالَ : کَانَ مُحَمَّدٌ إذَا قَرَأَ مَضَی فِی قِرَائَتِہِ۔","","Musannaf Ibn Abi Shaybah 8822","","","كتاب الجمعة"
"8823","(۸۸۲۳) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، قَالَ : کَانَ عَطَائٌ وَمُجَاہِدٌ یَہُذَّان الْقُرْآنَ ہَذًّا۔","","Musannaf Ibn Abi Shaybah 8823","","","كتاب الجمعة"
"8824","(۸۸۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ مَوْہَبٍ ، قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ کَعْبٍ الْقُرَظِیَّ یَقُولُ : لأَنْ أَقْرَأَ : {إذَا زُلْزِلَت الأَرْضُ} ، {وَالْقَارِعَۃُ} لَیْلَۃً أُرَدِّدُہُمَا ، وَأَتَفَکَّرُ فِیہِمَا أَحَبُّ إلَیَّ مِنْ أَنْ أَبِیتَ أَہُذُّ الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 8824","","","كتاب الجمعة"
"8825","(۸۸۲۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِیسَی الْحَنَّاطُ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ عَبْدُ اللہِ : لاَ تَہُذُّوا الْقُرْآنَ کَہَذِّ الشِّعْرِ ، وَلاَ تَنْثُرُوہُ نَثْرَ الدَّقَلِ ، وَقِفُوا عِنْدَ عَجَائِبِہِ ، وَحَرِّکُوا بِہِ الْقُلُوبَ۔","Da'if","Musannaf Ibn Abi Shaybah 8825","","","كتاب الجمعة"
"8826","(۸۸۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا نَافِعُ بْنُ عُمَرَ الْجُمَحِیُّ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ بَعْضِ أَزْوَاجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہَا سُئِلَتْ عَنْ قِرَائَۃِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَقَالَتْ : إنَّکُمْ لاَ تَسْتَطِیعُونَہَا ، فَقِیلَ لَہَا : أَخْبِرِینَا بِہَا ، فَقَرَأَتْ قِرَائَۃً تَرَسَّلَتْ فِیہَا۔","","Musannaf Ibn Abi Shaybah 8826","","","كتاب الجمعة"
"8827","(۸۸۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عُبَیْدِ الْمُکْتِبِ ، قَالَ : سُئِلَ مُجَاہِدٌ عَنْ رَجُلَیْنِ قَرَأَ أَحَدُہُمَا الْبَقَرَۃَ ، وَقَرَأَ الأَخَرُ الْبَقَرَۃَ وَآلَ عِمْرَانَ ، فَکَانَ رُکُوعُہُمَا وَسُجُودُہُمَا وَجُلُوسُہُمَا سَوَائً ، أَیُّہُمَا أَفْضَلُ ؟ قَالَ : الَّذِی قَرَأَ الْبَقَرَۃَ ، ثُمَّ قَرَأَ مُجَاہِدٌ : {وَقُرْآنًا فَرَقْنَاہُ لِتَقْرَأَہُ عَلَی النَّاسِ عَلَی مُکْثٍ وَنَزَّلْنَاہُ تَنْزِیلاً}۔","","Musannaf Ibn Abi Shaybah 8827","","","كتاب الجمعة"
"8828","(۸۸۲۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ إسْمَاعِیلَ ، قَالَ : حدَّثَنَا بَیَانٌ ، عَنْ حَکِیمِ بْنِ جَابِرٍ ، قَالَ : قَالَ حُذَیْفَۃُ : إنَّ مِنْ أَقْرَأِ النَّاسِ مُنَافِقًا لاَ یَتْرُکُ وَاوًا ، وَلاَ أَلِفًا یَلْفِتُہُ بِلِسَانِہِ کَمَا تَلْفِتُ الْبَقَرَۃُ الْخَلاَ بِلِسَانِہَا ، لاَ یُجَاوِزُ تَرْقُوَتَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 8828","","","كتاب الجمعة"
"8829","(۸۸۲۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ طَلْحَۃَ بْنِ مُصَرِّفٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْسَجَۃَ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : زَیِّنُوا الْقُرْآنَ بِأَصْوَاتِکُمْ۔ (ابوداؤد ۱۴۶۳۔ نسائی ۱۰۸۸)","Sahih","Musannaf Ibn Abi Shaybah 8829","","","كتاب الجمعة"
"8830","(۸۸۳۰) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی نَہِیکٍ ، عَنْ سَعْدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ مِنَّا مَنْ لَمْ یَتَغَنَّ بِالْقُرْآنِ ۔ یَسْتَغْنِی بِہِ۔ (ابوداؤد ۱۴۶۵۔ احمد ۱/۱۷۹)","Sahih","Musannaf Ibn Abi Shaybah 8830","","","كتاب الجمعة"
"8831","(۸۸۳۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ حَسَّانَ الْمَخْزُومِیُّ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی نَہِیکٍ ، عَنْ سَعْدِ بْنِ أَبِی وَقَّاصٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ مِنَّا مَنْ لَمْ یَتَغَنَّ بِالْقُرْآنِ ۔ یَعْنِی یَسْتَغْنِی بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 8831","","","كتاب الجمعة"
"8832","(۸۸۳۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ سَعِیدِ بْنِ أَبِی ہِنْدٍ ، قَالَ : سَمِعْتُ أَبَا سَلَمَۃَ بْنَ عَبْدِ الرَّحْمَنِ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا أَذِنَ اللَّہُ لِشَیْئٍ کَإِذْنِہِ لِنَبِیٍّ یَتَغَنَّی بِالْقُرْآنِ ، یَجْہَرُ بِالْقرائۃِ۔ (عبدالرزاق ۴۱۶۹)","","Musannaf Ibn Abi Shaybah 8832","","","كتاب الجمعة"
"8833","(۸۸۳۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، بِنَحْوِ حَدِیثِ وَکِیعٍ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ۔ (بخاری۵۰۲۳۔ مسلم ۵۴۵)","Hasan","Musannaf Ibn Abi Shaybah 8833","","","كتاب الجمعة"
"8834","(۸۸۳۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ عَبْدِ الْکَرِیمِ أَبِی أُمَیَّۃَ ، عَنْ طَاوُوسٍ ، قَالَ : سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَیُّ النَّاسِ أَحْسَنُ قِرَائَۃً ؟ قَالَ : الَّذِی إذَا سَمِعْتَہُ یَقْرَأُ رَأَیْتَ أَنَّہُ یَخْشَی اللَّہَ۔ (بزار ۲۳۳۶۔ عبدالرزاق ۴۱۸۵)","Da'if","Musannaf Ibn Abi Shaybah 8834","","","كتاب الجمعة"
"8835","(۸۸۳۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، قَالَ : صَلَّیْت خَلْفَ إبْرَاہِیمَ فَمَا سَمِعْتُہُ یُمَدِّدُ ، وَلاَ یُرَجِّعُ ، وَلاَ یُحَسِّنُ صَوْتَہُ۔","","Musannaf Ibn Abi Shaybah 8835","","","كتاب الجمعة"
"8836","(۸۸۳۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ : حدَّثَنِی أَبِی ، قَالَ : کَانُوا یُخْفُونَ التَّشَہُّدَ ، وَلاَ یَجْہَرُونَ بِہِ۔","","Musannaf Ibn Abi Shaybah 8836","","","كتاب الجمعة"
"8837","(۸۸۳۷) حَدَّثَنَا مُلاَزِمُ بْنُ عَمْرٍو ، عَنْ عَبْدِ اللہِ بْنِ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِیہِ یَحْیَی بْنِ أَبِی کَثِیرٍ ، قَالَ : مَنْ جَہَرَ بِالتَّشَہُّدِ کَانَ کَمَنْ جَہَرَ بِالْقِرَائَۃِ فِی غَیْرِ مَوْضِعِہَا۔","","Musannaf Ibn Abi Shaybah 8837","","","كتاب الجمعة"
"8838","(۸۸۳۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ صَلَّی الْمَغْرِبَ فِی السَّفَرِ رَکْعَتَیْنِ رَکْعَتَیْنِ حَتَّی یرجعَ ، قَالَ : یُعِیدُ کُلَّ صَلاَۃٍ صَلاَّہَا۔","","Musannaf Ibn Abi Shaybah 8838","","","كتاب الجمعة"
"8839","(۸۸۳۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عُلْوَانَ بْنِ أَبِی مَالِکٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَدْبَارَ السُّجُودِ رَکْعَتَانِ بَعْدَ الْمَغْرِبِ ، {وَإِدْبَارَ النُّجُومِ} رَکْعَتَانِ قَبْلَ صَلاَۃِ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 8839","","","كتاب الجمعة"
"8840","(۸۸۴۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إبْرَاہِیم ،َ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 8840","","","كتاب الجمعة"
"8841","(۸۸۴۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنِ الْحَسَنِ بْنِ عَلِیٍّ ، قَالَ : {أَدْبَارَ السُّجُودِ} رَکْعَتَانِ بَعْدَ الْمَغْرِبِ۔","Sahih","Musannaf Ibn Abi Shaybah 8841","","","كتاب الجمعة"
"8842","(۸۸۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، قَالَ : سَمِعْتُ الْحَسَنَ یَقُولُ : {إدْبَارَ النُّجُومِ} الرَّکْعَتَانِ قَبْلَ الْفَجْرِ ، {وَأَدْبَارَ السُّجُودِ} الرَّکْعَتَانِ بَعْدَ الْمَغْرِبِ۔","","Musannaf Ibn Abi Shaybah 8842","","","كتاب الجمعة"
"8843","(۸۸۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعَنْبَسِ ، قَالَ : سَمِعْتُ زَاذَانَ یَقُولُ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 8843","","","كتاب الجمعة"
"8844","(۸۸۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عُثْمَانَ الثَّقَفِیِّ ، عَنْ عَلِیِّ بْنِ رَبِیعَۃَ ، عَنْ عَلِیٍّ ، مِثْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 8844","","","كتاب الجمعة"
"8845","(۸۸۴۵) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : {أَدْبَارَ السُّجُود} رَکْعَتَانِ بَعْدَ الْمَغْرِبِ ، {وَإدْبَارَ النُّجُومِ} رَکْعَتَانِ قَبْلَ الْفَجْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 8845","","","كتاب الجمعة"
"8846","(۸۸۴۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَبِی الْعَنْبَسِ ، عَنْ زَاذَانَ ، عَنِ ابْنِ عُمَرَ ، عَنْ عُمَرَ ، قَالَ : {إدْبَارَ النُّجُومِ} رَکْعَتَانِ قَبْلَ الْفَجْرِ ، {وَأَدْبَارَ السُّجُودِ} رَکْعَتَانِ بَعْدَ الْمَغْرِبِ۔","Sahih","Musannaf Ibn Abi Shaybah 8846","","","كتاب الجمعة"
"8847","(۸۸۴۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ أَوْسِ بْنِ خَالِدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : {إدْبَارَ النُّجُومِ} رَکْعَتَانِ قَبْلَ الْفَجْرِ ، {وَأَدْبَارَ السُّجُودِ} رَکْعَتَانِ بَعْدَ الْمَغْرِبِ۔","Da'if","Musannaf Ibn Abi Shaybah 8847","","","كتاب الجمعة"
"8848","(۸۸۴۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی بِاللَّیْلِ صَلاَتَہُ وَأَنَا مُعْتَرِضَۃٌ بَیْنَہُ وَبَیْنَ الْقِبْلَۃِ ، فَإِذَا أَرَادَ أَنْ یُوتِرَ أَوْقَظَنِی فَأَوْتَرْت۔ (مسلم ۲۶۶)","Sahih","Musannaf Ibn Abi Shaybah 8848","","","كتاب الجمعة"
"8849","(۸۸۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ حَنْظَلَۃَ الْجُمَحِیِّ ، عَنْ سَالِمِ بْنِ عَبْدِ اللہِ ، قَالَ : صَلَّی بِنَا ابْنُ الزُّبَیْرِ ، فَمَرَّتْ بَیْنَ أَیْدِینَا امْرَأَۃٌ بَعْدَ مَا قَدْ صَلَّیْنَا رَکْعَۃً ، أَوْ رَکْعَتَیْنِ فَلَمْ یُبَالِ بِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 8849","","","كتاب الجمعة"
"8850","(۸۸۵۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا طَلْحَۃُ بْنُ یَحْیَی ، عَنْ عُبَیْدِ اللہ بن عَبْدِ اللہِ بْنِ عُتْبَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی بِاللَّیْلِ ، وَأَنَا إلَی جَنْبِہِ وَأَنَا حَائِضٌ ، وَعَلَیَّ مِرْطٌ لِی وَعَلَیْہِ بَعْضُہُ۔ (مسلم ۲۷۴۔ احمد ۶/۶۷)","Hasan","Musannaf Ibn Abi Shaybah 8850","","","كتاب الجمعة"
"8851","(۸۸۵۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ أَبِی جَعْفَرٍ الْفَرَّائِ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنِ الْمَرْأَۃِ تَمُرُّ بَیْنَ یَدَیِ الرَّجُلِ وَہُوَ یُصَلِّی ؟ قَالَ : لاَ یَقْطَعُ الصَّلاَۃ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 8851","","","كتاب الجمعة"
"8852","(۸۸۵۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سِمَاکِ بْنِ حَرْبٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : ذُکِرَ لَہُ أَنَّ الْمَرْأَۃَ وَالْحِمَارَ وَالْکَلْبَ یَقْطَعُونَ الصَّلاَۃ ، قَالَ ابْنُ عَبَّاسٍ : (إلَیْہِ یَصْعَدُ الْکَلِمُ الطَّیِّبُ وَالْعَمَلُ الصَّالِحُ یَرْفَعُہُ) لاَ یَقْطَعُ الصَّلاَۃ شَیْئٌ ، وَلَکِنَّہُ یُکْرَہُ۔","","Musannaf Ibn Abi Shaybah 8852","","","كتاب الجمعة"
"8853","(۸۸۵۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ أَشْعَثَ، عَنِ الشَّعْبِیِّ، قَالَ: الإِمَام یَؤُمُّ الصَّفَّ، وَالصُّفُوفُ یَؤُمُّ بَعْضُہُمْ بَعْضًا۔","","Musannaf Ibn Abi Shaybah 8853","","","كتاب الجمعة"
"8854","(۸۸۵۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ ، قَالَ : بَلَغَنِی عَنْ مَسْرُوقٍ أَنَّہُ قَالَ : النَّاسُ أَئِمَّۃُ بَعْضِہِمْ لِبَعْضٍ فِی الصُّفُوفِ۔","","Musannaf Ibn Abi Shaybah 8854","","","كتاب الجمعة"
"8855","(۸۸۵۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : إذَا رَکَعَ رَکَعَاتٍ لَیْسَ بَیْنَہُنَّ سُجُودٌ ، فَہِیَ رَکْعَۃٌ وَاحِدَۃٌ۔","","Musannaf Ibn Abi Shaybah 8855","","","كتاب الجمعة"
"8856","(۸۸۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ فِی رَجُلٍ صَلَّی الْمَغْرِبَ أَرْبَعًا، قَالَ: یُعِیدُ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8856","","","كتاب الجمعة"
"8857","(۸۸۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ صَلَّی الْمَغْرِبَ أَرْبَعًا ، قَالَ : یَسْجُدُ سَجْدَتَیِ السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 8857","","","كتاب الجمعة"
"8858","(۸۸۵۸) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ سُلَیْمَانَ بْنِ الْمُغِیرَۃِ ، قَالَ : سَأَلَ رَجُلٌ الْحَسَنَ عَنْ رَجُلٍ لاَ یُحْسِنُ إِلاَّ {قُلْ ہُوَ اللَّہُ أَحَدٌ} أَیَؤُمُّ قَوْمَہُ وَیُعِیدُہَا ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 8858","","","كتاب الجمعة"
"8859","(۸۸۵۹) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا لَمْ یَکُنْ مَعَ الرَّجُلِ مِنَ الْقُرْآنِ إِلاَّ سُورَۃٌ وَاحِدَۃٌ ، قَرَأَ بِہَا فِی صَلاَتِہِ وَرَدَّدَہَا۔","","Musannaf Ibn Abi Shaybah 8859","","","كتاب الجمعة"
"8860","(۸۸۶۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدِ ، عَنْ سُلَیْمَانَ بْنِ مُغِیرَۃَ ؛ أَنَّ أَبَا النَّضْرِ سَأَلَ الْحَسَنَ ، فَقَالَ : أَؤُمّ قَوْمِی وَلَسْتُ أَقْرَأُ إِلاَّ : {قُلْ ہُوَ اللَّہُ أَحَدٌ} أُرَدِّدُہَا ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 8860","","","كتاب الجمعة"
"8861","(۸۸۶۱) حَدَّثَنَا ہَارُونُ ، عَنْ عَاصِمٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : السَّطْحُ بِمَنْزِلَۃِ الصَّحْرَائِ ، إذَا لَمْ یَکُنْ حِجَابٌ۔","","Musannaf Ibn Abi Shaybah 8861","","","كتاب الجمعة"
"8862","(۸۸۶۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یُحِبُّونَ إذَا دَخَلُوا مَکَّۃَ أَنْ لاَ یَخْرُجُوا حَتَّی یَخْتِمُوا بِہَا الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 8862","","","كتاب الجمعة"
"8863","(۸۸۶۳) حَدَّثَنَا جَرِیرٌ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ ، قَالَ: قَرَأَ عَلْقَمَۃُ الْقُرْآنَ فِی لَیْلَۃٍ بِمَکَّۃَ ، طَافَ بِالْبَیْتِ سُبوعا، ثُمَّ أَتَی الْمَقَامَ فَصَلَّی عِنْدَہُ ، فَقَرَأَ بِالْمِئِینَ ، ثُمَّ طَافَ سُبوعًا ، ثُمَّ أَتَی الْمَقَامَ فَصَلَّی عِنْدَہُ ، فَقَرَأَ بِالْمَثَانِی ، ثُمَّ طَافَ سبوعًا ، ثُمَّ أَتَی الْمَقَامَ فَصَلَّی عِنْدَہُ ، فَقَرَأَ بَقِیَّۃَ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 8863","","","كتاب الجمعة"
"8864","(۸۸۶۴) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یُعْجِبُہُمْ إذَا قَدِمُوا لِلْحَجِّ ، أَوْ الْعُمْرَۃِ أَنْ لاَ یَخْرُجُوا حَتَّی یَقْرَؤُوا مَا مَعَہُمْ مِنَ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 8864","","","كتاب الجمعة"
"8865","(۸۸۶۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : کَانَ یُحِبُّ ، أَوْ یَسْتَحِبُّ إذَا قَدِمَ شَیْئًا مِنْ ہَذِہِ الْمَسَاجِدِ أَنْ لاَ یَخْرُجَ حَتَّی یَقْرَأَ الْقُرْآنَ فِی الْمَسْجِدِ الْحَرَامِ ، أَوْ مَسْجِدِ الْمَدِینَۃِ ، أَوْ مَسْجِدِ بَیْتِ الْمَقْدِسِ۔","","Musannaf Ibn Abi Shaybah 8865","","","كتاب الجمعة"
"8866","(۸۸۶۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : لَمَّا قَدِمَ وَفْدُ ثَقِیفٍ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَزَلُوا قُبَّۃً کَانَتْ فِی مُؤَخَّرِ الْمَسْجِدِ ، فَلَمَّا حَضَرَتِ الصَّلاَۃ ، قَالَ رَجُلٌ مِنَ الْقَوْمِ : یَا رَسُولَ اللہِ ، حَضَرَتِ الصَّلاَۃ وَہَؤُلاَئِ قَوْمٌ کُفَّارٌ وَہُمْ فِی الْمَسْجِدِ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ الأَرْضَ لاَ تَنْجُسُ ، أَوْ نَحْوَ ہَذَا۔ (ابوداؤد ۱۷)","Hasan","Musannaf Ibn Abi Shaybah 8866","","","كتاب الجمعة"
"8867","(۸۸۶۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّ وَفْدَ ثَقِیفٍ قَدِمُوا عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ فِی الْمَسْجِدِ ، فِی قُبَّۃٍ لَہُ فَقِیلَ لَہُ : یَا رَسُولَ اللہِ ، إنَّہُمْ مُشْرِکُونَ ، فَقَالَ : إنَّ الأَرْضَ لاَ یُنَجِّسُہَا شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 8867","","","كتاب الجمعة"
"8868","(۸۸۶۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ أَبِی عَبْدِ اللہِ الْعَسْقَلاَنِیِّ ، أَنَّہُ أَخْبَرَہُ مَنْ رَأَی ابْنَ مُحَیْرِیزٍ صَافَحَ نَصْرَانِیًّا فِی مَسْجِدِ دِمَشْقَ۔","","Musannaf Ibn Abi Shaybah 8868","","","كتاب الجمعة"
"8869","(۸۸۶۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْہَیْثُمَّ ، عَنْ طَلْحَۃَ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَجْلِسَ أَہْلُ الْکِتَابِ فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 8869","","","كتاب الجمعة"
"8870","(۸۸۷۰) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ حُصَیْنٍ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : لاَ تُجلسْ قَاضیًا فِی مَسْجِدٍ ، یَدْخُلُ عَلَیْہِ الْیَہُودِیُّ وَالنَّصْرَانِیُّ فِیہِ۔","","Musannaf Ibn Abi Shaybah 8870","","","كتاب الجمعة"
"8871","(۸۸۷۱) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، عَنْ مُحَمَّدِ بْنِ طَلْحَۃَ ، عَنْ أَبِیہِ ، عَنْ أَبِی صَالِحٍ ، قَالَ : لَیْسَ لِلْمُشْرِکِینَ أَنْ یَدْخُلُوا الْمَسْجِدَ إِلاَّ خَائِفِینَ۔","","Musannaf Ibn Abi Shaybah 8871","","","كتاب الجمعة"
"8872","(۸۸۷۲) حَدَّثَنَا حُمَیْدٌ ، عَنْ عَبْدِ الرَّحْمَنِ ، عَنِ الْحَسَنِ ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، قَالَ : کَانَ الشَّعْبِیُّ یُصَلِّی وَہُوَ جَالِسٌ ، وَیَقْعُدُ کَمَا تَقْعُدُونَ أَنْتُمْ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8872","","","كتاب الجمعة"
"8873","(۸۸۷۳) حَدَّثَنَا حُمَیْدٌ ، عَنِ الْحَسَنِ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، قَالَ فِی صَلاَۃِ الْقَاعِدِ : یَقْعُدُ کَیْفَ شَائَ۔","","Musannaf Ibn Abi Shaybah 8873","","","كتاب الجمعة"
"8874","(۸۸۷۴) حَدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، مِثْلَ صَنِیعِ الشَّعْبِیِّ ، أَنَّہُ کَانَ یَفْعلہ۔","","Musannaf Ibn Abi Shaybah 8874","","","كتاب الجمعة"
"8875","(۸۸۷۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِیُّ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ الْوَلِیدِ ، قَالَ : حَدَّثَنِی عُمَرُ بْنُ عُمَر بْنِ مُحَمَّدِ بْنِ حَاطِبٍ ، قَالَ : قَدِمَ عَظِیمٌ مِنْ عُظَمَائِ الأَعَاجِمِ عَلَی عُمَرَ فَسَأَلَ عَنْ عُمَرَ ، فَقِیلَ لَہُ : إِنَّہُ خَارِجٌ عَنِ الْمَدِینَۃِ ، فَخَرَجَ إلَیْہِ ، قَالَ : فَلَقِیَہُ وَہُوَ مُقْبِلٌ ، فَأَہْوَی الدِّہْقَانُ فَسَجَدَ ، أَوْ لِیَسْجُدَ ، شَکَّ عَبْدُ اللہِ ، قَالَ : فَقَالَ عُمَرُ : ارْفَعْ رَأْسَک لِلْوَاحِدِ الْقَہَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 8875","","","كتاب الجمعة"
"8876","(۸۸۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سِمَاکٍ ، عَنْ رَجُلٍ یُقَالُ لَہُ : مُثَنَّی ، قَالَ : جَائَ قَسٌّ إلَی عَلِیٍّ فَسَجَدَ لَہُ ، فَنَہَاہُ ، وَقَالَ : اُسْجُدْ لِلَّہِ۔","Da'if","Musannaf Ibn Abi Shaybah 8876","","","كتاب الجمعة"
"8877","(۸۸۷۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی ظَبْیَانَ ، عَنْ مُعَاذٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْ کُنْت آمِرًا أَحَدًا یَسْجُدُ لأَحَدٍ ، لأَمَرْت النِّسَائَ یَسْجُدْنَ لأَزْوَاجِہِنَّ۔n(احمد ۵/۲۲۷۔ طبرانی۳۷۳)","","Musannaf Ibn Abi Shaybah 8877","","","كتاب الجمعة"
"8878","(۸۸۷۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ مَیْسَرَۃَ ؛ أَنَّ الْعَجَمَ کَانُوا إذَا سَجَدُوا لِسَلْمَانَ طَأْطَأَ رَأْسَہُ ، وَقَالَ : خَشَعْت لِلَّہِ۔","","Musannaf Ibn Abi Shaybah 8878","","","كتاب الجمعة"
"8879","(۸۸۷۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْ أَمَرْت أَحَدًا یَسْجُدُ لأَحَدٍ ، لَکَانَ النِّسَائُ لأَزْوَاجِہِنَّ۔ (ابوداؤد ۲)","Da'if","Musannaf Ibn Abi Shaybah 8879","","","كتاب الجمعة"
"8880","(۸۸۸۰) حَدَّثَنَا عَفَّانُ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْ أَمَرْت أَحَدًا یَسْجُدُ لأَحَدٍ ، لأَمَرْت النِّسَائَ أَنْ یَسْجُدْنَ لأَزْوَاجِہِنَّ۔ (احمد ۶/۷۶۔ نسائی ۹۱۴۷)","Da'if","Musannaf Ibn Abi Shaybah 8880","","","كتاب الجمعة"
"8881","(۸۸۸۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا قُرَّۃُ بْنُ خَالِدٍ السَّدُوسِیُّ ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ الْمُزَنِیّ ؛ أَنَّ عُمَرَ اسْتَأْذَنَ عَلَی عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ وَہُوَ یُصَلِّی فِی بَیْتِہِ ، فَقَالَ لَہُ عُمَرُ : أَوْجِزْ۔","","Musannaf Ibn Abi Shaybah 8881","","","كتاب الجمعة"
"8882","(۸۸۸۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ رَجُلٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إذَا جَلَسَ إلَی أَحَدِکُمْ رَجُلٌ وَہُوَ یُصَلِّی فَلْیَنْصَرِفْ۔","Da'if","Musannaf Ibn Abi Shaybah 8882","","","كتاب الجمعة"
"8883","(۸۸۸۳) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا أَبُو جَنَابٍ یَحْیَی بْنُ أَبِی حَیَّۃَ الْکَلْبِیُّ، عَنْ أَبِی الْجُوَیرِیَّۃِ الْجَرْمِیِّ، قَالَ: جَلَسْنَا خَلْفَ ابْنِ عَبَّاسٍ وَہُوَ یُصَلِّی خَلْفَ الْمَقَامِ، وَعَلَیْہِ قَطِیفَۃٌ لَہُ، قَالَ: فَتَکَلَّمْنَا، فَلَمَّا سَمِعَ أَصْوَاتَنَا انْصَرَفَ۔","Da'if","Musannaf Ibn Abi Shaybah 8883","","","كتاب الجمعة"
"8884","(۸۸۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا کَثِیرُ بْنُ زَیْدٍ ، عَنِ الْمُطَّلِبِ بْنِ عَبْدِ اللہِ بْنِ حَنْطَبٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ؛ أَنَّہُ سُئِلَ عَنِ الْقِرَائَۃِ فِی الظُّہْرِ وَالْعَصْرِ ؟ فَقَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُطِیلُ الْقِیَامَ وَیُحَرِّکُ شَفَتَیْہِ۔ (احمد ۵/۱۸۶۔ طبرانی ۴۸۸۶)","","Musannaf Ibn Abi Shaybah 8884","","","كتاب الجمعة"
"8885","(۸۸۸۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ عُمَارَۃَ ، عَنْ أَبِی مَعْمَرٍ ، قَالَ : قُلْنَا لِخَبَّابٍ : بِأَیِّ شَیْئٍ کُنْتُمْ تَعْرِفُونَ قِرَائَۃَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الظُّہْرِ وَالْعَصْرِ ؟ قَالَ : بِاضْطِرَابِ لِحْیَتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 8885","","","كتاب الجمعة"
"8886","(۸۸۸۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنِ الْحَسَنِ الْعُرَنِیِّ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْرَأُ فِی الظُّہْرِ وَالْعَصْرِ۔ (ابوداؤد ۸۰۵۔ احمد ۱/۲۳۴)","Hasan","Musannaf Ibn Abi Shaybah 8886","","","كتاب الجمعة"
"8887","(۸۸۸۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَعْدِ بْنِ عِیَاضٍ الثُّمَالِیِّ ، قَالَ : مَا صَلَّیْت صَلاَۃً إِلاَّ قَرَأْت فِیہَا۔","","Musannaf Ibn Abi Shaybah 8887","","","كتاب الجمعة"
"8888","(۸۸۸۸) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یُحَلَّی الْمُصْحَفُ۔","","Musannaf Ibn Abi Shaybah 8888","","","كتاب الجمعة"
"8889","(۸۸۸۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : أَتَیْتُ عَبْدَ الرَّحْمَن بْنَ أَبِی لَیْلَی بِتِبْرٍ ، فَقَالَ: ہَلْ عَسَیْت أَنـِّی أُحَلِّیَ بِہِ مُصْحَفًا۔","","Musannaf Ibn Abi Shaybah 8889","","","كتاب الجمعة"
"8890","(۸۸۹۰) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : لاَ بَأْسَ أَنْ تُحَلَّی الْمَصَاحِفُ۔","","Musannaf Ibn Abi Shaybah 8890","","","كتاب الجمعة"
"8891","(۸۸۹۱) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ شُعَیْبِ بْنِ أَبِی سَعِیدٍ ، عَنْ أُبَیٍّ ، قَالَ : إذَا حَلَّیْتُمْ مَصَاحِفَکُمْ وَزَوَّقْتُمْ مَسَاجِدَکُمْ ، فَالدّبَارُ عَلَیْکُمْ۔","","Musannaf Ibn Abi Shaybah 8891","","","كتاب الجمعة"
"8892","(۸۸۹۲) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنِ الأَحْوَص بْنِ حَکِیمٍ، عَنْ أَبِی الزَّاہِرِیَّۃِ، عَنْ أَبِی أُمَامَۃَ؛ أَنَّہُ کَرِہَ أَنْ تُحَلَّی الْمَصَاحِفُ۔","Da'if","Musannaf Ibn Abi Shaybah 8892","","","كتاب الجمعة"
"8893","(۸۸۹۳) حَدَّثَنَا مُعَاذٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ قَالَ فِی السَّکْرَانِ یَؤُمُّ الْقَوْمَ ، قَالَ : إذَا أَتَمَّ بِہِمُ الرُّکُوعَ وَالسُّجُودَ فَقَدْ أَجْزَأَ عَنْہُ وَعَنْہُمْ ۔ وَقَالَ مُحَمَّدٌ : یُعِیدُونَ جَمِیعًا وَالإِمَام۔","","Musannaf Ibn Abi Shaybah 8893","","","كتاب الجمعة"
"8894","(۸۸۹۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ مُسْلِمِ بْنِ جُنْدُبٍ ، عَنِ الْحَارِثِ بْنِ بَرْصَائَ ، قَالَ : أُتِیَ بِخُبَیْبٍ فَبِیعَ بِمَکَّۃَ ، فَأَخْرَجُوہُ مِنَ الْحَرَمِ لِیَقْتُلُوہُ ، فَقَالَ : دَعُونِی أُصَلِّی رَکْعَتَیْنِ ، فَتَرَکُوہُ ، فَصَلَّی رَکْعَتَیْنِ ، ثُمَّ قَالَ : لَوْلاَ أَنْ تَظُنُّوا بِی جَزَعًا لَزِدْتُ۔","Sahih","Musannaf Ibn Abi Shaybah 8894","","","كتاب الجمعة"
"8895","(۸۸۹۵) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : لَمَّا اُنْطُلِقَ بِحُجْرٍ إلی مُعَاوِیَۃَ ، قَالَ : السَّلاَمُ عَلَیْک یَا أَمِیرَ الْمُؤْمِنِینَ ، قَالَ : وَأَمِیرُ الْمُؤْمِنِینَ أَنَا ؟ قَالَ : نَعَمْ ، قَالَ : لأَقْتُلَنَّکَ ، قَالَ : ثُمَّ أَمَرَ بِہِ لِیُقْتَلَ ، قَالَ : دَعُونِی أُصَلِّی رَکْعَتَیْنِ ، فَصَلَّی رَکْعَتَیْنِ تَجَوَّزَ فِیہِمَا ، فَقَالَ : لاَ تَرَوْنَ أَنِّی خَفَّفْتُہُمَا جَزَعًا ، وَلَکِنِّی کَرِہْت أَنْ أُطَوِّلَ عَلَیْکُمْ ، ثُمَّ قُتِلَ۔","Sahih","Musannaf Ibn Abi Shaybah 8895","","","كتاب الجمعة"
"8896","(۸۸۹۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : الشَّفَقُ النَّہَارُ۔","","Musannaf Ibn Abi Shaybah 8896","","","كتاب الجمعة"
"8897","(۸۸۹۷) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : کَتَبَ إلَیْنَا عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : صَلُّوا الْمَغْرِبَ حِینَ فِطْر الصَّائِم ، ثُمَّ ذَکَرَ لِی : أَنَّ أُنَاسًا یُعَجِّلُونَ صَلاَۃَ الْعِشَائِ قَبْلَ أَنْ یَذْہَبَ بَیَاضُ الأُفُقِ مِنَ الْمَغْرِبِ ، فَلاَ تُصَلِّیہَا حَتَّی یَذْہَبَ بَیَاضُ الأُفُقِ مِنَ الْمَغْرِبِ ، وَتَغْشَی ظُلْمَۃُ اللَّیْلِ ، وَمَا عَجَّلْت بَعْدَ ذَہَابِ بَیَاضِ الأُفُقِ مِنَ الْمَغْرِبِ ، فَإِنَّہُ أَحْسَنُ وَأَصْوَبُ ، وَاعْلَمْ أَنَّ مِنْ تَمَامِہَا وَإِصَابَۃِ وَقْتِہَا مَا ذَکَرْتُ لَکَ فِی کِتَابِی ہَذَا مِنْ ذَہَابِ بَیَاضِ الأُفُقِ ، فَإِنَّہُ بَقِیَّۃٌ مِنْ بَقِیَّۃِ النَّہَارِ۔","","Musannaf Ibn Abi Shaybah 8897","","","كتاب الجمعة"
"8898","(۸۸۹۸) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ بْنِ خُثَیْمٍ ، عَنِ ابْنِ لبیبَۃَ ، قَالَ : قَالَ لِی أَبُو ہُرَیْرَۃَ : صَلِّ الْعِشَائَ إذَا ذَہَبَ الشَّفَقُ ، وَادْلاَمُ اللَّیْلِ مَا بَیْنَکَ وَبَیْنَ ثُلُثِ اللَّیْلِ ، وَمَا عَجَّلْت بَعْدَ ذَہَابِ بَیَاضِ الأُفُقِ فَہُوَ أَفْضَلُ۔","Da'if","Musannaf Ibn Abi Shaybah 8898","","","كتاب الجمعة"
"8899","(۸۸۹۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ حَنْظَلَۃَ ، قَالَ : کَانَ طَاوُوس یُصَلِّی الْعِشَائَ قَبْلَ أَنْ یَغِیبَ الْبَیَاضُ۔","","Musannaf Ibn Abi Shaybah 8899","","","كتاب الجمعة"
"8900","(۸۹۰۰) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدِ بْنِ شَرِیکٍ ، عَنْ خُصَیْفٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : الشَّفَقُ مَا بَقِیَ مِنَ النَّہَارِ۔","","Musannaf Ibn Abi Shaybah 8900","","","كتاب الجمعة"
"8901","(۸۹۰۱) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ ؛ أَنَّ عَبْدَ اللہِ بْنَ رَبِیعَۃَ کَانَ یَؤُمُّ أَصْحَابَہُ فِی التَّطَوُّعِ ، فِی سِوَی رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 8901","","","كتاب الجمعة"
"8902","(۸۹۰۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ مَحْمُودِ بْنِ رَبِیعٍ ، عَنْ عِتْبَانَ بْنِ مَالِکٍ ، أَنَّہُ قَالَ : یَا رَسُولَ اللہِ ، إنَّ السُّیُولَ تَحُولُ بَیْنِی وَبَیْنَ مَسْجِدِ قَوْمِی ، فَأُحِبُّ أَنْ تَأْتِیَ فَتُصَلِّیَ فِی مَکَان مِنْ بَیْتِی أتَّخِذُہُ مَسْجِدًا ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : سَنَفْعَلُ ، فَلَمَّا أَصْبَحَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ غَدَا عَلَی أَبِی بَکْرٍ فَاسْتَتْبَعَہُ ، فَلَمَّا دَخَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أَیْنَ تُرِیدُ ؟ فَأَشَرْتُ لَہُ إلَی نَاحِیَۃٍ مِنَ الْبَیْتِ ، فَقَامَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَصَفَّفْنَا خَلْفَہُ ، فَصَلَّی بِنَا رَکْعَتَیْنِ۔ (بخاری ۴۲۴۔ مسلم ۴۵۵)","Sahih","Musannaf Ibn Abi Shaybah 8902","","","كتاب الجمعة"
"8903","(۸۹۰۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الرَّبِیعِ بْنِ بَدْرٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَنْ أَبِی مُوسَی ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الاثْنَانِ فَمَا فَوْقَہُمَا جَمَاعَۃٌ۔ (ابن ماجہ ۹۷۲۔ ابو یعلی ۷۱۸۸)","Da'if","Musannaf Ibn Abi Shaybah 8903","","","كتاب الجمعة"
"8904","(۸۹۰۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا صَلَّی الرَّجُلُ مَعَ الرَّجُلِ فَہُمَا جَمَاعَۃٌ ، لَہُمَا التَّضْعِیفُ خَمْسٌ وَعِشْرُونَ دَرَجَۃً۔","","Musannaf Ibn Abi Shaybah 8904","","","كتاب الجمعة"
"8905","(۸۹۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : الثَّلاَثَۃُ جَمَاعَۃٌ۔","","Musannaf Ibn Abi Shaybah 8905","","","كتاب الجمعة"
"8906","(۸۹۰۶) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنِ الْعَلاَئِ بْنِ عَبْدِ الْکَرِیمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا حَکَکْت شَیْئًا مِنْ جَسَدِکَ وَأَنْتَ رَاکِعٌ ، فَلاَ تَرْفَعْ رَأْسَک حَتَّی تُعِیدَ یَدَک إلَی مَوْضِعِہَا۔","","Musannaf Ibn Abi Shaybah 8906","","","كتاب الجمعة"
"8907","(۸۹۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ؛ فِی رَجُلٍ قَالَ : ہَاہْ فِی الصَّلاَۃ ، قَالَ : یُعِیدُ۔","","Musannaf Ibn Abi Shaybah 8907","","","كتاب الجمعة"
"8908","(۸۹۰۸) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَرِہَ التَّأَوُّہَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8908","","","كتاب الجمعة"
"8909","(۸۹۰۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ کَرِہَ الزَّفْرَ فِی الصَّلاَۃ ، قَالَ : یُشَبَّہُ بِالْکَلاَمِ۔","","Musannaf Ibn Abi Shaybah 8909","","","كتاب الجمعة"
"8910","(۸۹۱۰) حَدَّثَنَا حَاتِم بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : مَرَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی بِلاَلٍ وَہُوَ یَقْرَأُ مِنْ ہَذِہِ السُّورَۃِ ، وَمِنْ ہَذِہِ السُّورَۃِ ، فَقَالَ : مَرَرْت بِکَ یَا بِلاَلُ وَأَنْتَ تَقْرَأُ مِنْ ہَذِہِ السُّورَۃِ ، وَمِنْ ہَذِہِ السُّورَۃِ ، فَقَالَ : بِأَبِی أَنْتَ یَا رَسُولَ اللہِ ، إنِّی أَرَدْتُ أَنْ أَخْلِطَ الطَّیِّبَ بِالطَّیِّبِ ، قَالَ : اقْرَإِ السُّورَۃَ عَلَی نَحْوِہَا۔ (ابوداؤد ۱۳۲۴۔ عبدالرزاق ۴۲۱۰)","","Musannaf Ibn Abi Shaybah 8910","","","كتاب الجمعة"
"8911","(۸۹۱۱) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : کَانَ عَمَّارٌ یَخْلِطُ مِنْ ہَذِہِ السُّورَۃِ وَمِنْ ہَذِہِ السُّورَۃِ فَقِیلَ لَہُ ؟ فَقَالَ : أَتَرَوْنی أَخْلِطُ فِیہِ مَا لَیْسَ مِنْہُ ؟","","Musannaf Ibn Abi Shaybah 8911","","","كتاب الجمعة"
"8912","(۸۹۱۲) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سُئِلَ مُحَمَّدٌ عَنِ الَّذِی یَقْرَأُ مِنْ ہَاہُنَا ، وَمِنْ ہَاہُنَا ؟ فَقَالَ : لِیُتقی ، لاَ یَأْثم إِثْمًا عَظِیمًا وَہُوَ لاَ یَشْعُرُ۔","","Musannaf Ibn Abi Shaybah 8912","","","كتاب الجمعة"
"8913","(۸۹۱۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا الْوَلِیدُ بْنُ جُمَیْعٍ ، قَالَ : حَدَّثَنِی رَجُلٌ أَثِقُ بِہِ ؛ أَنَّہُ أَمَّ النَّاسَ بِالْحِیرۃِ خَالِدُ بْنُ الْوَلِیدِ فَقَرَأَ مِنْ سُوَرٍ شَتَّی ، ثُمَّ الْتَفَتَ إلَیْنَا حِینَ انْصَرَفَ ، فَقَالَ : شَغَلَنِی الْجِہَادُ عَنْ تَعَلُّمِ الْقُرْآنِ۔","Da'if","Musannaf Ibn Abi Shaybah 8913","","","كتاب الجمعة"
"8914","(۸۹۱۴) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَقْرَأَ مِنْ سُورَتَیْنِ حَتَّی یَخْتِمَ وَاحِدَۃً، ثُمَّ یَأْخُذَ فِی أُخْرَی۔","","Musannaf Ibn Abi Shaybah 8914","","","كتاب الجمعة"
"8915","(۸۹۱۵) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانُوا یَقُولُونَ فِی الَّذِی یُصَلِّی بِغَیْرِ قِرَائَۃٍ قَوْلاً شَدِیدًا ، أَہَابُ أَنْ أَقُولَہُ۔","","Musannaf Ibn Abi Shaybah 8915","","","كتاب الجمعة"
"8916","(۸۹۱۶) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ، قَالَ: إذَا لَمْ یَقْرَإِ الإِمَام، وَلاَ مَنْ خَلْفَہُ أَعَادُوا الصَّلاَۃ کُلُّہُمْ۔","","Musannaf Ibn Abi Shaybah 8916","","","كتاب الجمعة"
"8917","(۸۹۱۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنِ ابْنِ عَوْنٍ، عَنْ إبْرَاہِیمَ، قَالَ: لَوْ صَلَّیْت خَلْفَ رَجُلٍ لاَ أَعْلَمُ أَنَّہُ یَقْرَأُ أَعَدْت صَلاَتِی۔","","Musannaf Ibn Abi Shaybah 8917","","","كتاب الجمعة"
"8918","(۸۹۱۸) حَدَّثَنَا أَزْہَرُ السَّمَّانُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یَکْرَہُ أَنْ یَقُولَ : فَاتَتْنَا الصَّلاَۃ ، وَیَقُولُ : لَمْ أُدْرِکْ مَعَ بَنِی فُلاَنٍ۔","","Musannaf Ibn Abi Shaybah 8918","","","كتاب الجمعة"
"8919","(۸۹۱۹) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، قَالَ : کَانَ طَاوُوس یُخَوِّی إذَا سَجَدَ ، وَیُجَافِی مِرْفَقَیْہِ عَنْ فَخِذَیْہِ إذَا رَکَعَ۔","","Musannaf Ibn Abi Shaybah 8919","","","كتاب الجمعة"
"8920","(۸۹۲۰) حَدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، قَالَ : کَانَ نَافِعٌ یُجَافِی مِرْفَقَیْہِ عَنْ فَخِذَیْہِ۔","","Musannaf Ibn Abi Shaybah 8920","","","كتاب الجمعة"
"8921","(۸۹۲۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، قَالَ : رَأَیْتُ مُجَاہِدًا یُجَافِی مِرْفَقَیْہِ عَنْ عَارِضِ فَخِذَیْہِ ، وَہُوَ سَاجِدٌ فِی الصَّلاَۃ ، وَرَأَیْتُ عَطَائً یَفْعَلُ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 8921","","","كتاب الجمعة"
"8922","(۸۹۲۲) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ جَابِرٍ، عَنْ عَامِرٍ، وَمُحَمَّدِ بْنِ عَلِیٍّ، وَعَطَائٍ، وَطَاوُوس، وَالْقَاسِمِ، وَمُجَاہِدٍ، قَالُوا: لاَ بَأْسَ أَنْ یُصَلِّیَ الرَّجُلُ الْمَکْتُوبَۃَ وَغَیْرَہَا وَفِی کُمِّہِ الأَلْوَاحُ ، وَالصَّحِیفَۃُ فِیہَا الشَّعَرُ وَأَشْبَاہُہُ۔","","Musannaf Ibn Abi Shaybah 8922","","","كتاب الجمعة"
"8923","(۸۹۲۳) حَدَّثَنَا شَرِیکٌ، عَنْ جَابِرٍ، عَنْ أَبِی جَعْفَرٍ، قَالَ: لاَ بَأْسَ أَنْ یُصَلِّیَ الرَّجُلُ وَفِی حُجْزَتِہِ الأَلْوَاحُ وَالصَّحِیفَۃُ۔","","Musannaf Ibn Abi Shaybah 8923","","","كتاب الجمعة"
"8924","(۸۹۲۴) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الْقَاسِمِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُصَلِّیَ وَفِی حُجْزَتِہِ الدَّرَاہِمُ۔","","Musannaf Ibn Abi Shaybah 8924","","","كتاب الجمعة"
"8925","(۸۹۲۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ یُسَیرِ بْنِ عَمْرٍو ؛ أَنَّہُ کَانَ لاَ یَحُطُّ إذَا سَجَدَ۔","","Musannaf Ibn Abi Shaybah 8925","","","كتاب الجمعة"
"8926","(۸۹۲۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ عُمَرَ أَرَادَ أَنْ لاَ یُحَصِّبَ الْمَسْجِدَ ، فَأَشَارَ عَلَیْہِ سُفْیَانُ بْنُ عَبْدِ اللہِ الثَّقَفِیُّ ، قَالَ : بَلَی ، یَا أَمِیرَ الْمُؤْمِنِینَ ، فَإِنَّہُ أَغْفَرُ لِلنُّخَامَۃِ وَأَوْطَأُ لِلْمَجْلِسِ ، فَقَالَ عُمَرُ : احْصِبُوہُ۔","Sahih","Musannaf Ibn Abi Shaybah 8926","","","كتاب الجمعة"
"8927","(۸۹۲۷) حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوس ، قَالَ : کَانَ أَبِی فِی مَکَانٍ لَیْسَ بِنَظِیفٍ ، وَحَضَرَتْہُ ، فَأَمَرَ بِبِسَاطٍ فَبُسِطَ ، ثُمَّ صَلَّی عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 8927","","","كتاب الجمعة"
"8928","(۸۹۲۸) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، قَالَ : رَآنِی مُجَاہِدٌ وَأَنَا أَنْضَحُ مَکَانًا مِنْ سَطْحٍ لَنَا نُصَلِّی فِیہِ ، فَقَالَ : لاَ تَنْضَحْ ، إنَّ النَّضْحَ لاَ یَزِیدُہُ إِلاَّ شَرًّا ، وَلَکِنِ انْظُرْ إلَی الْمَکَانِ الَّذِی تُرِیدُہُ تَسْجُدُ فِیہِ فَانْفُخْہُ۔","","Musannaf Ibn Abi Shaybah 8928","","","كتاب الجمعة"
"8929","(۸۹۲۹) حَدَّثَنَا أَبُو الأَحْوَصِ، عَنْ أَبِی إِسْحَاقَ، عَنِ الْحَارِثِ، عَنْ عَلِیٍّ، قَالَ: کَانَ عَلِیٌّ یَقُولُ بَیْنَ السَّجْدَتَیْنِ: رَبِّ اغْفِرْ لِی وَارْحَمْنِی وَاجْبُرْنِی وَارْفَعْنِی۔","Da'if","Musannaf Ibn Abi Shaybah 8929","","","كتاب الجمعة"
"8930","(۸۹۳۰) حَدَّثَنَا مُعْتَمِر بْنُ سُلَیْمَانَ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ أَنَّہُ کَانَ یَقُولُ بَیْنَ السَّجْدَتَیْنِ : اللَّہُمَّ اغْفِرْ لِی وَارْحَمْنِی وَاجْبُرْنِی وَارْزُقْنِی۔ (ترمذی ۲۸۴۔ احمد ۳۱۵)","","Musannaf Ibn Abi Shaybah 8930","","","كتاب الجمعة"
"8931","(۸۹۳۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ قَتَادَۃَ ، عَنْ أُمِّ الْحَسَنِ ، عَنْ أُمِّ سَلَمَۃَ ، أَنَّہَا کَانَتْ تَقُولُ بَیْنَ الرَّکْعَتَیْنِ ، أَوِ السَّجْدَتَیْنِ : اللَّہُمَّ اغْفِرْ وَارْحَمْ وَاہْدِ السَّبِیلَ الأَقْوَمَ۔","Hasan","Musannaf Ibn Abi Shaybah 8931","","","كتاب الجمعة"
"8932","(۸۹۳۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوس ، قَالَ : کَانَ أَبِی یَقْرَأُ بَیْنَ السَّجْدَتَیْنِ قُرْآنًا کَثِیرًا۔","","Musannaf Ibn Abi Shaybah 8932","","","كتاب الجمعة"
"8933","(۸۹۳۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ رَجُلٍ ، عَنْ عَطَائٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ بَیْنَ السَّجْدَتَیْنِ : أَسْتَغْفِرُ اللَّہَ ، أَسْتَغْفِرُ اللَّہَ۔ (ابوداؤد ۸۷۰۔ نسائی ۶۵۶)","Da'if","Musannaf Ibn Abi Shaybah 8933","","","كتاب الجمعة"
"8934","(۸۹۳۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَیْسَ فِیہِ شَیْئٌ مُوقتٌ۔","","Musannaf Ibn Abi Shaybah 8934","","","كتاب الجمعة"
"8935","(۸۹۳۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ : أَقْرَأُ بَیْنَ السَّجْدَتَیْنِ شَیْئًا ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 8935","","","كتاب الجمعة"
"8936","(۸۹۳۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ أَبِی مُحَمَّدِ بْنِ عَمْرِو بْنِ حُرَیْثٍ ، عَنْ جَدِّہِ ، سَمِعَ أَبَا ہُرَیْرَۃَ یَقُولُ : إذَا صَلَّی أَحَدُکُمْ فِی أَرْضِ فَلاَۃٍ فَلْیَنْصِبْ عَصًا ، فَإِنْ لَمْ یَکُنْ مَعَہُ عَصًا فَلْیَخُطَّ خَطًّا بِالأَرْضِ ، وَلاَ یَضُرُّہُ مَا مَرَّ بَیْنَ یَدَیْہِ ، قَالَ أَبُو الْقَاسِمِ : یَعْنِی رِوَایَۃً۔ (ابوداؤد ۶۹۰۔ ابن ماجہ ۹۴۳)","Da'if","Musannaf Ibn Abi Shaybah 8936","","","كتاب الجمعة"
"8937","(۸۹۳۷) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ مُسْلِمٍ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، قَالَ : أَرَادَ إنْسَانٌ أَنْ یَنْصِبَ بَیْنَ یَدَیْ طَاوُوس شَیْئًا وَہُوَ یَؤُمُّنَا ، فَمَنَعَہُ۔","","Musannaf Ibn Abi Shaybah 8937","","","كتاب الجمعة"
"8938","(۸۹۳۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا أَبُو ہِلاَلٍ ، قَالَ : حَدَّثَنَا حُمَیْدُ بْنُ ہِلاَلٍ ، عَنْ أَبِی بُرْدَۃَ ؛ أَنَّ أَبَا مُوسَی الأَشْعَرِیَّ دَخَلَ عَلَی أُخْتِہِ وَہِیَ تَسْجُدُ مِنْ غَیْرِ رُکُوعٍ ، فَلَمْ یَعِبْ ذَلِکَ عَلَیْہَا۔","Hasan","Musannaf Ibn Abi Shaybah 8938","","","كتاب الجمعة"
"8939","(۸۹۳۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ؛ أَنَّہُ رَأَی رَجُلاً یُصَلِّی فِی رَکْعَۃٍ ثَلاَثَ سَجَدَاتٍ ، فَقَالَ : إنَّ اللَّہَ رَضِیَ لِکُلِّ رَکْعَۃٍ بِسَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 8939","","","كتاب الجمعة"
"8940","(۸۹۴۰) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : أَرْبَعٌ لاَ یَجْہَرُ بِہِنَّ الإِمَام ؛ بِسْمِ اللہِ الرَّحْمَن الرَّحِیم ، وَالاسْتِعَاذَۃُ ، وَآمِینَ ، وَاللَّہُم رَبَّنَا لَکَ الْحَمْدُ۔","","Musannaf Ibn Abi Shaybah 8940","","","كتاب الجمعة"
"8941","(۸۹۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : خَمْسٌ یُخْفِیہِنَّ الإِمَام ؛ الاسْتِعَاذَۃُ ، وَسُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ ، وَبِسْمِ اللہِ الرَّحْمَن الرَّحِیمِ ، وَآمِینَ ، وَاللَّہُمَّ رَبَّنَا لَکَ الْحَمْدُ۔","","Musannaf Ibn Abi Shaybah 8941","","","كتاب الجمعة"
"8942","(۸۹۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ؛ أَنَّہُمَا کَانَا یُخْفِیَانِ الاسْتِعَاذَۃَ۔","","Musannaf Ibn Abi Shaybah 8942","","","كتاب الجمعة"
"8943","(۸۹۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : سَمِعْتُ عُمَرَ یَقُولُ : إذَا افْتَتَحَ الصَّلاَۃ سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ وَتَبَارَکَ اسْمُک وَتَعَالَی جَدُّک ، وَلاَ إلَہَ غَیْرُک ، قَالَ الأَسْوَدُ : یُسْمِعَنَاہَا۔","Sahih","Musannaf Ibn Abi Shaybah 8943","","","كتاب الجمعة"
"8944","(۸۹۴۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، وَمُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُخْفِی الإِمَام بِسْمِ اللہِ الرَّحْمَن الرَّحِیم ، وَالاسْتِعَاذَۃَ ، وَآمِینَ ، وَرَبَّنَا لَکَ الْحَمْدُ۔","","Musannaf Ibn Abi Shaybah 8944","","","كتاب الجمعة"
"8945","(۸۹۴۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ سَعْدِ بْنِ مَرْزَبَانَ ، قَالَ : حدَّثَنَا أَبُو وَائِلٍ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ یُخْفِی بِسْمِ اللہِ الرَّحْمَن الرَّحِیم ، وَالاسْتِعَاذَۃَ ، وَرَبَّنَا لَکَ الْحَمْدُ۔","Da'if","Musannaf Ibn Abi Shaybah 8945","","","كتاب الجمعة"
"8946","(۸۹۴۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ جَعْفَرٍ الأَحْمَر ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : مَا جَرَی عَلَی لِسَانِ الإِنْسَان فِی الصَّلاَۃ مِمَّا لَہُ أَصْلٌ فِی الْقُرْآنِ ، فَلَیْسَ بِکَلاَمٍ۔","","Musannaf Ibn Abi Shaybah 8946","","","كتاب الجمعة"
"8947","(۸۹۴۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، قَالَ : رَأَیْتُ أَبَا قِلاَبَۃَ عَلَیْہِ جُبَّۃٌ وَمِلْحَفَۃٌ غَسِیلَۃٌ ، وَہُوَ یُصَلِّی مُضْطَبِِعًا ، قَدْ أَخْرَجَ یَدَہُ الْیُمْنَی۔","","Musannaf Ibn Abi Shaybah 8947","","","كتاب الجمعة"
"8948","(۸۹۴۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قِیلَ لِلْحَسَنِ : إنَّہُمْ یَقُولُونَ : یُکْرَہُ أَنْ یُصَلِّیَ الرَّجُلُ وَقَدْ أَخْرَجَ یَدَہُ مِنْ عِنْدِ نَحْرِہِ ، قَالَ الْحَسَنُ : لَوْ وَکَّلَ اللَّہُ دِینَہُ إلَی ہَؤُلاَئِ لَضَیَّقُوا عَلَی عِبَادِہِ۔","","Musannaf Ibn Abi Shaybah 8948","","","كتاب الجمعة"
"8949","(۸۹۴۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ حَیََّانَ بْنِ عُمَیْرٍ ، قَالَ : کُنْتُ مَعَ قَیْسِ بْنِ عُبَادٍ ، فَرَأَی رَجُلاً یُصَلِّی قَدْ أَخْرَجَ یَدَہُ مِنْ عِنْدِ نَحْرِہِ ، فَقَالَ : اذْہَبْ إلَی ذَلِکَ فَقُلْ لَہُ : یَضَعُ یَدَہُ مِنْ مَکَانِ یَدِ الْمَغْلُولِ ، فَأَتَیْتُہُ، فَقُلْتُ : إنَّ قَیْسًا یَقُولُ : ضَعْ یَدَک مِنْ مَکَانِ یَدِ الْمَغْلُولِ ، فَوَضَعَہَا۔","","Musannaf Ibn Abi Shaybah 8949","","","كتاب الجمعة"
"8950","(۸۹۵۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ مُسْلِمٍ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ طَاوُوسٍ ، قَالَ : لَقَدْ رَأَیْتُہُ یُصَلِّی ضَابِعًا بُرْدَہُ مِنْ تَحْتِ عَضُدِہِ۔","","Musannaf Ibn Abi Shaybah 8950","","","كتاب الجمعة"
"8951","(۸۹۵۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَن الشَّیبَانِی ، عَنْ عِکْرِمَۃَ ، قَالَ : قَالَ عُمَرُ : لاَ یَضُرُّہُ لَوِ الْتَحَفَ بِہِ حَتَّی یُخْرِج إحْدَی یَدَیْہِ۔","","Musannaf Ibn Abi Shaybah 8951","","","كتاب الجمعة"
"8952","(۸۹۵۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إِنْ کَانَ عَلَیْک قَمِیصٌ وَمِلْحَفَۃٌ فَتَوَشَّحْ بِالْمِلْحَفَۃِ ، وَإِنْ کَانَ تُبَّانٌ وَمِلْحَفَۃٌ فَالْتَفِعْ بِالْمِلْحَفَۃِ۔","","Musannaf Ibn Abi Shaybah 8952","","","كتاب الجمعة"
"8953","(۸۹۵۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا کَانَ عَلَیْک قَمِیصٌ دَقِیقٌ وَمِلْحَفَۃٌ فَتَوَشَّحْ بِالْمِلْحَفَۃِ ، وَإِنْ کَانَ قَمِیصٌ ضَیِّقٌ وَمِلْحَفَۃٌ فَالْتَفِعْ بِالْمِلْحَفَۃِ۔","","Musannaf Ibn Abi Shaybah 8953","","","كتاب الجمعة"
"8954","(۸۹۵۴) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الْعَوَّامِ ، عَنْ عَبْدِ الْمَلِکِ التَّیْمِیِّ ، عَنْ إبْرَاہِیمَ ، قَالَ : مُبْتَدَأُ الصَّفِّ قَصْدُ الإِمَام ، فَإِنْ لَمْ یَکُنْ مَعَ الإِمَامِ إِلاَّ وَاحِدٌ أَقَامَہُ خَلْفَہُ مَا بَیْنَہُ وَبَیْنَ أَنْ یَرْکَعَ ، فَإِنْ جَائَ أَحَدٌ یُصَلِّی بِہِ ، وَإِنْ لَمْ یَأْتِ أَحَدٌ حَتَّی یَرْکَعَ لَحِقَ الإِمَام فَقَامَ عَنْ یَمِینِہِ ، وَإِنْ جَائَ وَالصَّفُّ تَامٌّ فَلْیَقُمْ قَصْدَ الإِمَام ، فَإِنْ جَائَ أَحَدٌ یُصَلِّی بِہِ ، وَإِنْ لَمْ یَجِیئْ أَحَدٌ فَلْیَدْخُلْ فِی الصَّفِّ ، ثُمَّ کَذَاک وَکَذَاک۔","","Musannaf Ibn Abi Shaybah 8954","","","كتاب الجمعة"
"8955","(۸۹۵۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : حدَّثَنَا یُونُسُ ، عَنِ الْحَسَنِ ، قَالَ : إذَا جَائَ وَقَدْ تَمَّ الصَّفُّ فَلْیَقُمْ بِحِذَائِ الإِمَام۔","","Musannaf Ibn Abi Shaybah 8955","","","كتاب الجمعة"
"8956","(۸۹۵۶) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، قَالَ : سَأَلْتُ ابْنَ سِیرِینَ عَنِ الْمَرْأَۃِ تَکُونُ حَیْضَتُہَا أَیَّامًا مَعْلُومَۃً ، فَتَزِیدُ عَلَی ذَلِکَ ؟ قَالَ : النِّسَائُ أَعْلَمُ بِذَلِکَ۔n قَالَ : وَسَأَلْت قَتَادَۃَ ، قُلْتُ : الْمَرْأَۃُ تَحِیضُ الأَیَّامَ الْمَعْلُومَۃَ ، فَتَزِیدُ عَلَی خَمْسَۃِ أَیَّامٍ ؟ قَالَ : تُصَلِّی ، قُلْتُ : فَأَرْبَعَۃُ أَیَّامٍ ؟ قَالَ : تُصَلِّی ، قُلْتُ : فَثَلاَثَۃُ أَیَّامٍ ؟ قَالَ : تُصَلِّی ، قُلْتُ : فَیَوْمَیْنِ ؟ قَالَ : ذَاکَ مِنْ حَیْضِہَا ، فَرَأَیْتُہُ قَالَ بِرَأْیِہِ۔","","Musannaf Ibn Abi Shaybah 8956","","","كتاب الجمعة"
"8957","(۸۹۵۷) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا إبْرَاہِیمُ بْنُ الزِّبْرِقَانِ ، عَنِ الشَّیْبَانِیِّ ، عَنْ مُوسَی بْنِ أَبِی کَثِیرٍ ، عَنْ طَاوُوسٍ ، قَالَ : إذَا زَادَتِ الْمَرْأَۃُ عَلَی حَیْضِہَا فَلْتَغْتَسِلْ ۔ وَقَالَ حَمَّادٌ فِی الْمَرْأَۃ تُجَاوِزُ أَیَّامَ حَیْضَتِہَا ، قَالَ : لاَ تَغْتَسِلُ ، فَإِنَّ الْمَرْأَۃَ رُبَّمَا فَعَلَتْ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 8957","","","كتاب الجمعة"
"8958","(۸۹۵۸) حَدَّثَنَا حُمَیْدٌ ، عَنِ الْحَسَنِ بْنِ صَالِحٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، عَنْ عُثْمَانَ بْنِ أَبِی الْعَاصِ ، قَالَ : إذَا رَأَتِ الْمَرْأَۃُ الصُّفْرَۃَ فِی أَیَّامِ غَیْرِ حَیْضَتِہَا ، قَالَ : إذَا زَادَتْ عَلَی أَیَّامِ حَیْضَتِہَا یَوْمًا ، أَوْ یَوْمَیْنِ ، عَدَّتْہُ مِنْ حَیْضَتِہَا ، فَإِنْ زَادَتْ عَلَی یَوْمَیْنِ فَہِیَ مُسْتَحَاضَۃٌ ، إذَا کَانَتْ تَحِیضُ سِتَّۃَ أَیَّامٍ فَرَأَتِ الدَّمَ ثَمَانیَۃَ أَیَّامٍ عَدَّتْہُ مِنْ حَیْضَتِہَا ، فَإِنْ رَأَتْہُ أَکْثَرَ مِنْ ثَمَانِیَۃِ أَیَّامٍ فَہِیَ مُسْتَحَاضَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 8958","","","كتاب الجمعة"
"8959","(۸۹۵۹) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، قَالَ : سَمِعْتُ أَیُّوبَ یُحَدِّثُ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ نَبِیُّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یُبَشِّرُ أَصْحَابَہُ : قَدْ جَائَکُمْ رَمَضَانُ شَہْرٌ مُبَارَکٌ ، اُفْتُرِضَ عَلَیْکُمْ صِیَامُہُ ، تُفْتَحُ فِیہِ أَبْوَابُ الْجَنَّۃِ ، وَتُغْلَقُ فِیہِ أَبْوَابُ الْجَحِیمِ ، وَتُغَلُّ فِیہِ الشَّیَاطِینُ ، فِیہِ لَیْلَۃُ الْقَدْرِ خَیْرٌ مِنْ أَلْفِ شَہْرٍ ، مَنْ حُرِمَ خَیْرَہَا فَقَدْ حُرِمَ۔ (مسلم ۷۵۸۔ احمد ۲/۲۳۰)","Sahih","Musannaf Ibn Abi Shaybah 8959","","","كتاب الصيام"
"8960","(۸۹۶۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ عَرْفَجَۃَ ، قَالَ : کُنْتُ عِنْدَ عُتْبَۃَ بْنِ فَرْقَدٍ وَہُوَ یُحَدِّثُنَا عَنْ فَضْلِ رَمَضَانَ ، فَدَخَلَ عَلَیْنَا رَجُلٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَسَکَتَ عُتْبَۃُ وَکَأَنَّہُ ہَابَہُ ، فَلَمَّا جَلَسَ ، قَالَ لَہُ عُتْبَۃُ : یَا أَبَا فُلاَنٍ ، حَدِّثْنَا بِمَا سَمِعْت مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی رَمَضَانَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : تُفْتَحُ فِیہِ أَبْوَابُ الْجَنَّۃِ ، وَتُغْلَقُ فِیہِ أَبْوَابُ النَّارِ ، وَتُصَفَّدُ فِیہِ الشَّیَاطِینُ ، وَیُنَادِی مُنَادٍ فِی کُلِّ لَیْلَۃٍ : یَا بَاغِیَ الْخَیْرِ ہَلُمَّ ، وَیَا بَاغِیَ الشَّرِّ أَقْصِرْ۔ (احمد ۵/۴۱۱)","Da'if","Musannaf Ibn Abi Shaybah 8960","","","كتاب الصيام"
"8961","(۸۹۶۱) حَدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُرَغِّبُ فِی قِیَامِ رَمَضَانَ مِنْ غَیْرِ عَزِیمَۃٍ ، وَقَالَ : إذَا دَخَلَ رَمَضَانُ فُتِّحَتْ أَبْوَابُ الْجَنَّۃِ ، وَغُلِّقَتْ أَبْوَابُ الْجَحِیمِ ، وَسُلْسِلَتِ الشَّیَاطِینُ۔ (بخاری ۱۸۹۸۔ مسلم ۵۲۳)","Sahih","Musannaf Ibn Abi Shaybah 8961","","","كتاب الصيام"
"8962","(۸۹۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ نَضْرِ بْنِ عَلِیٍّ ، عَنْ نَضْرِ بْنِ شَیْبَانَ ، قَالَ : سَأَلْتُ أَبَا سَلَمَۃَ بْنَ عَبْدِ الرَّحْمَنِ ، فَذَکَر عَنْ أَبِیہِ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ صَامَہُ إیمَانًا وَاحْتِسَابًا ، غُفِرَ لَہُ مَا تَقَدَّمَ مِنْ ذَنْبِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 8962","","","كتاب الصيام"
"8963","(۸۹۶۳) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الْفَضْلِ الرَّقَاشِیِّ ، عَنْ عَمِّہِ ، عَنْ أَنَسٍ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: ہَذَا رَمَضَانُ قَدْ جَائَ تُفْتَحُ فِیہِ أَبْوَابُ الْجِنَانِ، وَتُغْلَقُ فِیہِ أَبْوَابُ النَّارِ ، وَتُغَلُّ فِیہِ الشَّیَاطِینُ ، بُعْدًا لِمَنْ أَدْرَکَ رَمَضَانَ لَمْ یُغْفَرْ لَہُ فِیہِ ، إذَا لَمْ یُغْفَرْ لَہُ فِیہِ فَمَتَی ؟ (طبرانی ۷۶۲۳)","Da'if","Musannaf Ibn Abi Shaybah 8963","","","كتاب الصيام"
"8964","(۸۹۶۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُجَالِدٌ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَانَ یَخْطُبُ إذَا حَضَرَ رَمَضَانُ یَقُولُ: ہَذَا الشَّہْرُ الْمُبَارَکُ الَّذِی افْتَرَضَ اللَّہُ عَلَیْکُمْ صِیَامَہُ ، وَلَمْ یَفْتَرِضْ عَلَیْکُمْ قِیَامَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 8964","","","كتاب الصيام"
"8965","(۸۹۶۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُجَالِدٌ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ؛ أَنَّ عُمَرَ کَانَ یَقُولُ مِثْلَ ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 8965","","","كتاب الصيام"
"8966","(۸۹۶۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیْرِیِّ ، عَنْ مُسْلِمِ بْنِ الْعَلاِء ، عَنْ رَجُلٍ مِنْ قُرَیْشٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: أَوَّلُ مَا یُصِیبُ صَاحِبُ رَمَضَانَ الَّذِی یُحْسِنُ قِیَامَہُ وَصِیَامَہُ ، أَنْ یَفْرُغَ مِنْہُ وَہُوَ کَیَوْمِ وَلَدَتْہُ أُمُّہُ مِنَ الذُّنُوبِ۔","Da'if","Musannaf Ibn Abi Shaybah 8966","","","كتاب الصيام"
"8967","(۸۹۶۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَحْیَی بْنِ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ صَامَ رَمَضَانَ إیمَانًا وَاحْتِسَابًا ، غُفِرَ لَہُ مَا تَقَدَّمَ مِنْ ذَنْبِہِ۔ (بخاری ۲۰۱۴۔ مسلم ۱۷۵)","Sahih","Musannaf Ibn Abi Shaybah 8967","","","كتاب الصيام"
"8968","(۸۹۶۸) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، قَالَ : حدَّثَنَا کَثِیرُ بْنُ زَیْدٍ ، عَنْ عَمْرِو بْنِ تَمِیمٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَظَلَّکُمْ شَہْرُکُمْ ہَذَا بِمَحْلُوفِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَا دَخَلَ عَلَی الْمُسْلِمِینَ شَہْرٌ خَیْرٌ لَہُمْ مِنْہُ ، وَلاَ دَخَلَ عَلَی الْمُنَافِقِینَ شَہْرٌ شَرٌّ لَہُمْ مِنْہُ ۔ بِمَحْلُوفِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، إنَّ اللَّہَ یَکْتُبُ أَجْرَہُ وَنَوَافِلَہُ مِنْ قَبْلِ أَنْ یُوجِبَہُ ، وَیَکْتُبُ وِزْرَہُ وَشَقَائَ ہُ قَبْلَ أَنْ یُدْخِلَہُ ، وَذَلِکَ أَنَّ الْمُؤْمِنَ یُعِدُّ لَہُ مِنَ النَّفَقَۃِ فِی الْقُوَّۃِ وَالْعِبَادَۃِ ، وَیُعِدُّ لَہُ الْمُنَافِقُ اتِّبَاعَ غَفَلاَتِ الْمُسْلِمِین ، وَاتِّبَاعَ عَوْرَاتِہِمْ ، فَہُوَ غُنْمٌ لِلْمُؤْمِنِ ، وَنِقْمَۃٌ لِلْفَاجِرِ ، أَوَ قَالَ : یَغْتَنِمُہُ الْفَاجِرُ۔ (احمد ۵۲۴۔ ابن خزیمۃ ۱۸۸۴)","Da'if","Musannaf Ibn Abi Shaybah 8968","","","كتاب الصيام"
"8969","(۸۹۶۹) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، قَالَ : أَخْبَرَنَا إبْرَاہِیمُ بْنُ إسْمَاعِیلَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ قَالَتْ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ صَامَ رَمَضَانَ إیمَانًا وَاحْتِسَابًا ، غُفِرَ لَہُ مَا مَضَی مِنْ عَمَلِہِ۔ (نسائی ۲۵۰۲)","Da'if","Musannaf Ibn Abi Shaybah 8969","","","كتاب الصيام"
"8970","(۸۹۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ، عَنْ أَبِی صَالِحٍ الْحَنَفِیِّ ، عَنْ أَخِیہِ طَلِیقِ بْنِ قَیْسٍ، قَالَ : قَالَ أَبُو ذَرٍّ : إذَا صُمْتَ فَتَحَفَّظْ مَا اسْتَطَعْت ، فَکَانَ طَلِیقٌ إذَا کَانَ یَوْمُ صَوْمِہِ دَخَلَ فَلَمْ یَخْرُجْ إِلاَّ لِصَلاَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 8970","","","كتاب الصيام"
"8971","(۸۹۷۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی حَصِینٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا کَانَ یَوْمُ صَوْمِ أَحَدِکُمْ فَلاَ یَرْفُثْ ، وَلاَ یَجْہَلْ ، فَإِنْ جَہَلَ عَلَیْہِ أَحَدٌ فَلْیَقُلْ : إنِّی امْرُؤٌ صَائِمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 8971","","","كتاب الصيام"
"8972","(۸۹۷۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا کَانَ یَوْمُ صَوْمِ أَحَدِکُمْ فَلاَ یَرْفُثْ ، وَلاَ یَجْہَلْ ، فَإِنْ جَہِلَ عَلَیْہِ أَحَدٌ فَلْیَقُلْ : إنِّی امْرُؤٌ صَائِمٌ۔ (بخاری ۱۹۰۴۔ مسلم ۸۵۷)","Sahih","Musannaf Ibn Abi Shaybah 8972","","","كتاب الصيام"
"8973","(۸۹۷۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، قَالَ : قَالَ جَابِرٌ : إذَا صُمْتَ فَلْیَصُمْ سَمْعُک وَبَصَرُک وَلِسَانُک عَنِ الْکَذِبِ وَالْمَإْثَمِ ، وَدَعْ أَذَی الْخَادِمِ ، وَلْیَکُنْ عَلَیْک وَقَارٌ وَسَکِینَۃٌ یَوْمَ صِیَامِکَ، وَلاَ تَجْعَلْ یَوْمَ فِطْرِکَ وَیَوْمَ صِیَامِکَ سَوَائً۔","","Musannaf Ibn Abi Shaybah 8973","","","كتاب الصيام"
"8974","(۸۹۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ مُسْلِمٍ ، عَنْ أَبِی الْمُتَوَکِّلِ ؛ أَنَّ أَبَا ہُرَیْرَۃَ وَأَصْحَابَہُ کَانُوا إذَا صَامُوا جَلَسُوا فِی الْمَسْجِدِ۔","Sahih","Musannaf Ibn Abi Shaybah 8974","","","كتاب الصيام"
"8975","(۸۹۷۵) حَدَّثَنَا حَفْصٌ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ عُمَرُ : لَیْسَ الصِّیَامُ مِنَ الطَّعَامِ وَالشَّرَابِ وَحْدَہُ ، وَلَکِنَّہُ مِنَ الْکَذِبِ وَالْبَاطِلِ وَاللَّغْوِ وَالْحَلِفِ۔","Da'if","Musannaf Ibn Abi Shaybah 8975","","","كتاب الصيام"
"8976","(۸۹۷۶) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ، عَنْ جَعْفَرٍ، قَالَ: سَمِعْتُ مَیْمُونًا یَقُولُ: إنَّ أَہْوَنَ الصَّوْمِ تَرْکُ الطَّعَامِ وَالشَّرَابِ۔","","Musannaf Ibn Abi Shaybah 8976","","","كتاب الصيام"
"8977","(۸۹۷۷) حَدَّثَنَا ہُشَیْمٌ، قَالَ: أَخْبَرَنَا مُجَالِدٌ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ قَالَ : إِنَّ الصِّیَامَ لَیْسَ مِنَ الطَّعَامِ وَالشَّرَابِ، وَلَکِنْ مِنَ الْکَذِبِ وَالْبَاطِلِ وَاللَّغْوِ۔","Da'if","Musannaf Ibn Abi Shaybah 8977","","","كتاب الصيام"
"8978","(۸۹۷۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُجَالِدٌ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ؛ أَنَّ عُمَرَ قَالَ مِثْلَ ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 8978","","","كتاب الصيام"
"8979","(۸۹۷۹) حَدَّثَنَا وَکِیعٌ ، وَمُحَمَّدُ بْنُ بِشْرٍ ، عَنْ مِسْعَرٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی الْبَخْتَرِیِّ ؛ أَنَّ امْرَأَۃً کَانَتْ تَصُومُ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی لِسَانِہَا ، فَقَالَ : مَا صَامَتْ فَتَحَفَّظَتْ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : قَدْ کَادَتْ ، ثُمَّ تَحَفَّظَتْ ، فَقَالَ : الآنَ۔","","Musannaf Ibn Abi Shaybah 8979","","","كتاب الصيام"
"8980","(۸۹۸۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ، عَنْ مُجَاہِدٍ، قَالَ: خَصْلَتَانِ مَنْ حَفِظَہُمَا سَلِمَ لَہُ صَوْمُہُ؛ الْغِیبَۃُ وَالْکَذِبُ۔","","Musannaf Ibn Abi Shaybah 8980","","","كتاب الصيام"
"8981","(۸۹۸۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَقُولُونَ : الْکَذِبُ یُفْطِرُ الصَّائِمَ۔","","Musannaf Ibn Abi Shaybah 8981","","","كتاب الصيام"
"8982","(۸۹۸۲) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ ہِشَامٍ، عَنْ حَفْصَۃَ، عَنْ أَبِی الْعَالِیَۃِ، قَالَ: الصَّائِمُ فِی عِبَادَۃٍ مَا لَمْ یَغْتَبْ۔","","Musannaf Ibn Abi Shaybah 8982","","","كتاب الصيام"
"8983","(۸۹۸۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنْ یَزِیدَ بْنِ أَبَانَ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا صَامَ مَنْ ظَلَّ یَأْکُلُ لُحُومَ النَّاسِ۔","Da'if","Musannaf Ibn Abi Shaybah 8983","","","كتاب الصيام"
"8984","(۸۹۸۴) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ أَبِی ہِنْدٍ ، قَالَ : حدَّثَنَا مُطَرِّفُ بْنُ عَبْدِ اللہِ بْنِ الشِّخِّیرِ ، قَالَ : أَتَیْتُ عُثْمَانَ بْنَ أَبِی الْعَاصِ فَدَعَا لِی بِلَبَنِ لَقْحَۃٍ ، فَقُلْتُ : إنِّی صَائِمٌ ، فَقَالَ : أَمَا إنِّی سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : الصِّیَامُ جُنَّۃٌ مِنَ النَّارِ ، کَجُنَّۃِ أَحَدِکُمْ مِنَ الْقِتَالِ ، وَصِیَامٌ حَسَنٌ صِیَامُ ثَلاَثَۃِ أَیَّامٍ مِنْ کُلِّ شَہْرٍ۔ (نسائی ۲۵۳۹۔ احمد ۴/۲۱)","Hasan","Musannaf Ibn Abi Shaybah 8984","","","كتاب الصيام"
"8985","(۸۹۸۵) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہُبَیْرَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : الصَّوْمُ جُنَّۃٌ مِنَ النَّارِ کَجُنَّۃِ الرَّجُلِ إذَا حَمَلَ مِنَ السِّلاَحِ مَا أَطَاقَ۔","Hasan","Musannaf Ibn Abi Shaybah 8985","","","كتاب الصيام"
"8986","(۸۹۸۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی سِنَانٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، وَأَبِی سَعِیدٍ قَالاَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ اللَّہَ یَقُولُ : إنَّ الصَّوْمَ لِی وَأَنَا أَجْزِی بِہِ ، إِنَّ لِلصَّائِمِ فَرْحَتَیْنِ ؛ إذَا أَفْطَرَ فَرِحَ ، وَإِذَا لَقِیَ اللَّہَ فَرِحَ ، وَالَّذِی نَفْسُ مُحَمَّدٍ بِیَدِہِ لَخُلُوفُ فَمِ الصَّائِمِ أَطْیَبُ عِنْدَ اللہِ مِنْ رِیحِ الْمِسْکِ۔ (مسلم ۸۰۷۔ احمد ۳/۵)","Sahih","Musannaf Ibn Abi Shaybah 8986","","","كتاب الصيام"
"8987","(۸۹۸۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کُلُّ عَمَلِ ابْنِ آدَمَ یُضَاعَفُ الْحَسَنَۃُ عَشْرُ أَمْثَالِہَا إلَی سَبْعِمِئَۃِ ضِعْفٍ ، قَالَ اللَّہُ تَعَالَی : إِلاَّ الصَّوْمَ فَإِنَّہُ لِی وَأَنَا أَجْزِی بِہِ ، یَدَعُ طَعَامَہُ وَشَرَابَہُ وَشَہْوَتَہُ مِنْ أَجْلِی ، لِلصَّائِمِ فَرْحَتَانِ ؛ فَرْحَۃٌ عِنْدَ فِطْرِہِ، وَفَرْحَۃٌ عِنْدَ لِقَائِ رَبِّہِ ، وَلَخُلُوفُ فِیِہِ أَطْیَبُ عِنْدَ اللہِ مِنْ رِیحِ الْمِسْکِ ، الصَّوْمُ جُنَّۃٌ ، الصَّوْمُ جُنَّۃٌ۔ (مسلم ۱۶۴۔ احمد ۲/۴۴۳)","Sahih","Musannaf Ibn Abi Shaybah 8987","","","كتاب الصيام"
"8988","(۸۹۸۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مَہْدِیِّ بْنِ مَیْمُونٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی یَعْقُوبَ ، عَنْ رَجَائِ بْنِ حَیْوَۃَ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، مُرْنِی بِعَمَلٍ أَدْخُلْ بِہِ الْجَنَّۃَ ، أَوْ نَحْوَ ذَلِکَ ، فَقَالَ : عَلَیْک بِالصَّوْمِ، فَإِنَّہُ لاَ مِثْلَ لَہُ ، قَالَ : فَکَانَ أَبُو أُمَامَۃَ لاَ یُرَی فِی بَیْتِہِ الدُّخَانُ نَہَارًا إِلاَّ إذَا نَزَلَ بِہِ ضَیْفٌ۔ (نسائی ۲۵۳۰۔ احمد ۵/۲۴۹)","Sahih","Musannaf Ibn Abi Shaybah 8988","","","كتاب الصيام"
"8989","(۸۹۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَازِمٍ ، عَنْ سَہْلِ بْنِ سَعْدٍ السَّاعِدِیِّ ، قَالَ : لِلْجَنَّۃِ بَابٌ یُدْعَی الرَّیَّانُ یَدْخُلُ فِیہِ الصَّائِمُونَ ، قَالَ : فَإِذَا دَخَلَ آخِرُہُمْ أُغْلِقَ۔ (طبرانی ۶۔ ابن حبان ۳۴۲۱)","Sahih","Musannaf Ibn Abi Shaybah 8989","","","كتاب الصيام"
"8990","(۸۹۹۰) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ سُلَیْمَانَ بْنِ بِلاَلٍ ، عَنْ أَبِی حَازِمٍ ، عَنْ سَہْلِ بْنِ سَعْدٍ السَّاعِدِیِّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، مِثْلَہُ۔ (بخاری ۱۸۹۶۔ مسلم ۱۶۶)","Hasan","Musannaf Ibn Abi Shaybah 8990","","","كتاب الصيام"
"8991","(۸۹۹۱) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ وَاصِلٍ ، عَنْ بَشََّارِ بْنِ أَبِی سَیْفٍ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عِیَاضِ بْنِ غُطَیْفٍ ، قَالَ : دَخَلْنَا عَلَی أَبِی عُبَیْدَۃَ ، فَقَالَ : الصَّوْمُ جُنَّۃٌ مَا لَمْ تَخْرِقہ۔","Da'if","Musannaf Ibn Abi Shaybah 8991","","","كتاب الصيام"
"8992","(۸۹۹۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا جَرِیرُ بْنُ حَازِمٍ ، قَال : حَدَّثَنَا بَشَّارُ بْنِ أَبِی سَیْف ، عَنِ الْوَلِیدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عِیَاضِ بْنِ غُطَیْفٍ ، قَالَ : دَخَلْنَا عَلَی أَبِی عُبَیْدَۃَ بْنِ الْجَرَّاحِ فِی مَرَضِہِ ، فَقَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : الصَّوْمُ جُنَّۃٌ مَا لَمْ یَخْرِقْہَا۔ (احمد ۱/۱۹۶۔ بیہقی ۱۷۱)","Da'if","Musannaf Ibn Abi Shaybah 8992","","","كتاب الصيام"
"8993","(۸۹۹۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ثَابِتٍ ، عَنْ عَبْدِ اللہِ بْنِ رَبَاحٍ ، قَالَ : خَرَجْنَا وَفْدًا إلَی مُعَاوِیَۃَ ، فَمَرَرْنَا بِرَاہِبٍ یَجِیئُ بِالطَّعَامِ فَأَکَلَ الْقَوْمُ ، وَلَمْ آکُلْ ، فَقَالَ لِی : مَا لَکَ لاَ تَأْکُلُ ؟ فَقُلْتُ : إنِّی صَائِمٌ ، قَالَ : أَلاَ أُلْسِمُکَ عَلَی صَوْمِکَ ، تُوضَعُ الْمَوَائِدُ فَأَوَّلُ مَنْ یَأْکُلُ مِنْہَا الصَّائِمُونَ۔","","Musannaf Ibn Abi Shaybah 8993","","","كتاب الصيام"
"8994","(۸۹۹۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، وَأَبُو أُسَامَۃَ قَالَ : أَخْبَرَنَا ہِشَامُ بْنُ حَسَّانَ ، عَنْ وَاصِلٍ مَوْلَی أَبِی عُیَیْنَۃَ ، قَالَ : حَدَّثَنِی لَقِیطٌ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِی مُوسَی ، قَالَ : کُنَّا فِی الْبَحْرِ فَبَیْنَا نَحْنُ نَسِیرُ وَقَدْ رَفَعْنَا الشِّرَاعَ ، وَلاَ نَرَی جَزِیرَۃً ، وَلاَ شَیْئًا إذْ سَمِعْنَا مُنَادِیًا یُنَادِی : یَا أَہْلَ السَّفِینَۃِ ، قِفُوا أُخْبِرْکُمْ فَقُمْنَا نَنْظُرُ فَلَمْ نَرَ شَیْئًا، فَنَادَی سَبْعًا ، فَلَمَّا کَانَتِ السَّابِعَۃُ قُمْتُ فَقُلْتُ : یَا ہَذَا ، أَخْبِرْنَا مَا تُرِیدُ أَنْ تُخْبِرَنَا بِہِ فَإِنَّک تَرَی حَالَنَا ، وَلاَ نَسْتَطِیعُ أَنْ نَقِفَ عَلَیکَ ، قَالَ : أَلاَ أُخْبِرُکُمْ بِقَضَائٍ قَضَاہُ اللَّہُ عَلَی نَفْسِہِ ؟ أَیُّمَا عَبْدٍ أَظْمَأَ نَفْسَہُ فِی اللہِ فِی یَوْمٍ حَارٍّ أَرْوَاہُ اللَّہُ یَوْمَ الْقِیَامَۃِ ۔ زَادَ أَبُو أُسَامَۃَ : فَکُنْتَ لاَ تَشَائُ أَنْ تَرَی أَبَا مُوسَی صَائِمًا فِی یَوْمٍ بَعِیدٍ مَا بَیْنَ الطَّرَفَیْنِ إِلاَّ رَأَیْتَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 8994","","","كتاب الصيام"
"8995","(۸۹۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعْدَانَ الْجُہَنِیِّ ، عَنْ سَعْدٍ أَبِی مُجَاہِدٍ الطَّائِیِّ ، عَنْ أَبِی مُدِلَّۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الصَّائِمُ لاَ تُرَدُّ دَعْوَتُہُ۔ (ابن ماجہ ۱۷۵۲۔ احمد ۲/۴۴۵)","Hasan","Musannaf Ibn Abi Shaybah 8995","","","كتاب الصيام"
"8996","(۸۹۹۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لِکُلِّ أَہْلِ عَمَلٍ بَابٌ مِنْ أَبْوَابِ الْجَنَّۃِ یُدْعَوْنَ مِنْہُ بِذَلِکَ الْعَمَلِ ، وَلأَہْلِ الصِّیَامِ بَابٌ یُقَالُ لَہُ : الرَّیَّانُ۔ (بخاری ۱۸۹۷۔ مسلم ۸۵)","","Musannaf Ibn Abi Shaybah 8996","","","كتاب الصيام"
"8997","(۸۹۹۷) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ؛ أَنَّ أَبَا طَلْحَۃَ کَانَ یُکْثِرُ الصَّوْمَ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَکَانَ لاَ یُفْطِرُ بَعْدَہُ إِلاَّ مِنْ وَجَعٍ۔","Sahih","Musannaf Ibn Abi Shaybah 8997","","","كتاب الصيام"
"8998","(۸۹۹۸) حَدَّثَنَا عَبْدُالْوَہَّابِ، عَنْ أَیُّوبَ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ کَانَ لاَ یَکَادُ یُفْطِرُ فِی الْحَضَرِ إِلاَّ أَنْ یَمْرَضَ۔","Sahih","Musannaf Ibn Abi Shaybah 8998","","","كتاب الصيام"
"8999","(۸۹۹۹) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ قُرَّۃَ ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ، قَالَ : کَانَ مِمَّنْ یُکْثِرُ الصَّوْمَ ؛ ابْنُ عُمَرَ ، وَعَائِشَۃُ ، وَسَعِیدُ بْنُ الْمُسَیَّبِ۔","","Musannaf Ibn Abi Shaybah 8999","","","كتاب الصيام"
"9000","(۹۰۰۰) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ عُمَرَ سَرَدَ الصَّوْمَ قَبْلَ مَوْتِہِ بِسَنَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 9000","","","كتاب الصيام"
"9001","(۹۰۰۱) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ جُمْہَانَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ : رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لِکُلِّ شَیْئٍ زَکَاۃٌ ، وَزَکَاۃُ الْجَسَدِ الصَّوْمُ۔ (ابن ماجہ ۱۷۴۵)","Da'if","Musannaf Ibn Abi Shaybah 9001","","","كتاب الصيام"
"9002","(۹۰۰۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیق ، قَالَ : قِیلَ لِعَبْدِ اللہِ : إنَّک تُقِلُّ الصَّوْمَ ، فَقَالَ : إنِّی أَخَافُ أَنْ ی[corrupt]مْنَعَنِی مِنْ قِرَائَۃِ الْقُرْآنِ ، وَقِرَائَۃُ الْقُرْآنِ أَحَبُّ إلَیَّ مِنَ الصَّوْمِ۔","Sahih","Musannaf Ibn Abi Shaybah 9002","","","كتاب الصيام"
"9003","(۹۰۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ عَنْ مُہَاجِرٍ ، قَالَ : کَانُوا یَرَوْنَ أَنَّ الصَّوْمَ أَقَلُّ الأَنْوَاعِ أَجْرًا۔","","Musannaf Ibn Abi Shaybah 9003","","","كتاب الصيام"
"9004","(۹۰۰۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا عَمْرُو بْنُ مَیْمُونٍ ، عَنْ أَبِیہِ ؛ أَنَّ رَجُلاً قَالَ لأَبِی ذَرٍّ : الصِّیَامُ ، لاَ أَسْمَعُک ذَکَرْتہ ؟ فَقَالَ أَبُو ذَرٍّ : قُرْبَۃٌ ، وَلَیْسَ ہُنَالِکَ۔","","Musannaf Ibn Abi Shaybah 9004","","","كتاب الصيام"
"9005","(۹۰۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ ، قَالَ : کَانَ مِنْ أَقَلِّ أَعْمَالِہِمَ الصَّوْمُ۔","","Musannaf Ibn Abi Shaybah 9005","","","كتاب الصيام"
"9006","(۹۰۰۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَسَحَّرُوا ، فَإِنَّ فِی السَّحُورِ بَرَکَۃً۔ (مسلم ۷۷۰۔ بخاری ۱۹۲۳)","Sahih","Musannaf Ibn Abi Shaybah 9006","","","كتاب الصيام"
"9007","(۹۰۰۷) حَدَّثَنَا وَکِیعٌ ، وَعَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَسَحَّرُوا ، فَإِنَّ فِی السُّحُورِ بَرَکَۃً۔ (احمد ۲/۴۷۷۔ ابو یعلی ۶۳۶۶)","Da'if","Musannaf Ibn Abi Shaybah 9007","","","كتاب الصيام"
"9008","(۹۰۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُلَیٍّ ، عَنْ أَبِیہِ ، عَنْ أَبِی قَیْسٍ مَوْلَی عَمْرِو بْنِ الْعَاصِ ، عَنْ عمْرِو بْنِ الْعَاصِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فَصْلُ مَا بَیْنَ صِیَامِکُمْ وَصِیَامِ أَہْلِ الْکِتَابِ أَکْلَۃُ السَّحَرِ۔ (مسلم ۷۷۱۔ احمد ۴/۱۹۷)","Sahih","Musannaf Ibn Abi Shaybah 9008","","","كتاب الصيام"
"9009","(۹۰۰۹) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ شَرِیکٍ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ جَابِرٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ: مَنْ أَرَادَ أَنْ یَصُومَ فَلْیَتَسَحَّرْ ، وَلَوْ بِشَیْئٍ۔(ابویعلی ۱۹۲۶۔ احمد ۳/۳۶۷)","Da'if","Musannaf Ibn Abi Shaybah 9009","","","كتاب الصيام"
"9010","(۹۰۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ خَالِدٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنْ رَجُلٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : تَسَحَّرُوا وَلَوْ حَسْوَۃً مِنْ مَائٍ۔ (ابن حبان ۳۴۷۶۔ ابویعلی ۳۳۴۰)","Sahih","Musannaf Ibn Abi Shaybah 9010","","","كتاب الصيام"
"9011","(۹۰۱۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : کَانَتْ تُرْجَی بَرَکَۃُ السُّحُورِ۔","","Musannaf Ibn Abi Shaybah 9011","","","كتاب الصيام"
"9012","(۹۰۱۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ ہِشَامٍ ، عَنْ حَفْصَۃَ ، قالَتْ : تَسَحَّرُوا وَلَوْ بِشَرْبَۃٍ مِنْ مَائٍ ، فَإِنَّہَا قَدْ ذُکِرَتْ فِیہِ دَعْوَۃٌ۔","","Musannaf Ibn Abi Shaybah 9012","","","كتاب الصيام"
"9013","(۹۰۱۳) حَدَّثَنَا مُطَّلِبُ بْنُ زِیَادٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطِیَّۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَسَحَّرُوا ، فَإِنَّ فِی السُّحُورِ بَرَکَۃً۔ (احمد ۳/۳۲)","Da'if","Musannaf Ibn Abi Shaybah 9013","","","كتاب الصيام"
"9014","(۹۰۱۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، عَنْ مُوَرِّقٍ الْعِجْلِیّ ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ : مِنْ أَخْلاَقِ النَّبِیِّینَ الإِبْلاَغَ فِی السُّحُورِ۔","Sahih","Musannaf Ibn Abi Shaybah 9014","","","كتاب الصيام"
"9015","(۹۰۱۵) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنِی مُعَاوِیَۃُ بْنُ صَالِحٍ ، قَالَ : حَدَّثَنِی یُونُسُ بْنُ سَیْفٍ الْعَنْسِیُّ ، عَنِ الْحَارِثِ بْنِ زِیَادٍ ، عَنْ أَبِی رُہْمٍ السَّمَاعِیِّ ، أَنَّہُ سَمِعَ عِرْبَاضَ بْنَ سَارِیَۃَ یَقُولُ : دَعَانَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی شَہْرِ رَمَضَانَ إلَی السَّحُورِ ، فَقَالَ : ہَلُمُّوا إلَی الْغَدَائِ الْمُبَارَکِ۔ (ابوداؤد ۲۳۳۷۔ احمد ۴/۱۲۶)","Da'if","Musannaf Ibn Abi Shaybah 9015","","","كتاب الصيام"
"9016","(۹۰۱۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: إنَّ بِلاَلاً یُؤَذِّنُ بِلَیْلٍ ، فَکُلُوا وَاشْرَبُوا حَتَّی یُؤَذِّنَ ابْنُ أُمِّ مَکْتُومٍ۔ (بخاری ۶۱۷۔ ترمذی ۲۰۳)","Sahih","Musannaf Ibn Abi Shaybah 9016","","","كتاب الصيام"
"9017","(۹۰۱۷) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَمْنَعَنَّ أَحَدَکُمْ أَذَانُ بِلاَلٍ مِنْ سَحُورِہِ ، فَإِنَّہُ یُنَادِی ، أَوْ یُؤَذِّنُ بِلَیْلٍ ، فَیَنْتَبِہُ نَائِمُکُمْ ، وَیَرْجعُ قَائِمُکُمْ۔ (بخاری ۶۲۱۔ ابوداؤد ۲۳۳۹)","Sahih","Musannaf Ibn Abi Shaybah 9017","","","كتاب الصيام"
"9018","(۹۰۱۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ (ح) وَعَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، عَنْ عَائِشَۃَ ؛ أَنَّ بِلاَلاً کَانَ یُؤَذِّنُ بِلَیْلٍ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کُلُوا وَاشْرَبُوا حَتَّی یُؤَذِّنَ ابْنُ أُمِّ مَکْتُومٍ۔ (بخاری ۱۹۱۹۔ مسلم ۷۶۸)","Sahih","Musannaf Ibn Abi Shaybah 9018","","","كتاب الصيام"
