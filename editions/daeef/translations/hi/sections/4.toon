hadiths[400]{hadithnumber,text}:
"609","[AI-translation] ((क्या तुम जानते हो इसे रमज़ान क्यों कहा जाता है? क्योंकि वह गुनाहों को जला देता है))।"
"610","[AI-translation] ((रमज़ान न कहो क्योंकि वह अल्लाह का नाम है; बल्कि तुम्हें 'रमज़ान का महीना' कहना चाहिए))।"
"611","[AI-translation] ((रोज़ा रखो सेहतमन्द हो जाओगे))।"
"612","[AI-translation] ((हर चीज़ की ज़कात है, और जिस्म की ज़कात रोज़ा है))।"
"613","[AI-translation] ((रोज़ेदार का हर बाल उसके लिए अल्लाह की तस्बीह करता है, और क़ियामत के दिन अर्श के नीचे रोज़ा रखने वाले मर्दों और औरतों के लिए सोने का दस्तरख़्वान बिछाया जाएगा))।"
"614","[AI-translation] ((अगर अल्लाह तआला आसमानों और ज़मीन वालों को बोलने की इजाज़त दे तो वे रमज़ान के महीने में रोज़ा रखने वालों को जन्नत की ख़ुशख़बरी देंगे))।"
"615","[AI-translation] ((जो रमज़ान का एक रोज़ा बग़ैर शरई उज़्र छोड़े, उस पर एक महीने के रोज़े हैं))।"
"616","[AI-translation] ((जो रमज़ान का एक रोज़ा छोड़े वह ऊँट की क़ुर्बानी करे))।"
"617","[AI-translation] ((जो रमज़ान का एक रोज़ा छोड़े और क़ज़ा से पहले मर जाए, तो हर दिन के बदले एक मुहताज को एक मुद्द [लगभग आधा किलो] खाना खिलाना वाजिब है))।"
"618","[AI-translation] ((जो हलाल कमाई की खजूर से इफ़्तार करे, उसकी नमाज़ों में चार सौ नमाज़ें बढ़ा दी जाती हैं))।"
"619","[AI-translation] ((जब रमज़ान दुरुस्त हो तो सारा साल दुरुस्त है))।"
"620","[AI-translation] ((रमज़ान के हर दिन अल्लाह तआला छह लाख लोगों को जहन्नम से आज़ाद करता है))।"
"621","[AI-translation] ((रमज़ान में हर रात इफ़्तार के वक़्त अल्लाह तआला दस लाख लोगों को जहन्नम से आज़ाद करता है))।"
"622","[AI-translation] ((रोज़ेदार की इफ़्तार के वक़्त की दुआ रद्द नहीं होती))।"
"623","[AI-translation] ((तीन लोगों से [क़ियामत के दिन] खाने-पीने के बारे में सवाल न होगा: ① रोज़ा खोलने वाला ② सहरी खाने वाला ③ मेहमान की मेज़बानी करने वाला))।"
"624","[AI-translation] ((तीन चीज़ें रोज़ा नहीं तोड़तीं: ① क़ै ② पछना ③ एहतिलाम))।"
"625","[AI-translation] ((जो किसी औरत को इस तरह देखे कि कपड़ों के पीछे से भी उसकी हड्डियों का अन्दाज़ा उसे ज़ाहिर हो जाए, और वह रोज़े से हो, तो उसका रोज़ा टूट गया))।"
"626","[AI-translation] ((जो रमज़ान में सफ़र में रोज़ा रखे वह ऐसा है जैसे मुक़ीम [यानी इक़ामत की हालत में] रोज़ा न रखे))।"
"627","[AI-translation] ((जो इस हाल में मरे कि उस पर रोज़े बाक़ी हों, तो हर दिन के बदले उसकी तरफ़ से ग़रीब को खाना खिलाया जाए))।"
"628","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने मैदान-ए-अरफ़ात में यौम-ए-अरफ़ा का रोज़ा रखने से मना किया))।"
"629","[AI-translation] ((आशूरा [मुहर्रम की 10 तारीख़] के दिन रोज़ा रखो, और यहूदियों की मुख़ालफ़त में उससे एक दिन पहले या एक दिन बाद भी रोज़ा रखो))।"
"630","[AI-translation] ((मामूला पहला परिन्दा है जिसने आशूरा का रोज़ा रखा))।"
"631","[AI-translation] ((जो आशूरा के दिन अपने घरवालों पर सख़ावत करे, अल्लाह तआला उसे पूरे साल फ़राख़ी देगा))।"
"632","[AI-translation] ((जो रजब की एक रात [इबादत में] जागे और एक दिन रोज़ा रखे, अल्लाह तआला उसे जन्नत के फल खिलाएगा))।"
"633","[AI-translation] ((जो रजब में तीन दिन रोज़े रखे, अल्लाह तआला उसके लिए पूरे महीने के रोज़ों का सवाब लिखता है))।"
"634","[AI-translation] ((नबी-ए-करीम (सल्लल्लाहु अलैहि वसल्लम) से पूछा गया: रमज़ान के बाद सबसे अफ़ज़ल रोज़े कौन-से हैं? आप (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: शाबान के महीने के))।"
"635","[AI-translation] ((अय्याम-ए-बीज़ [यानी चाँद की 13, 14, 15 तारीख़] में रोज़े का पहला दिन तीन हज़ार साल के बराबर है, दूसरा दिन दस हज़ार साल के बराबर है, और तीसरा दिन तेरह हज़ार साल के बराबर है))।"
"636","[AI-translation] ((अगर कोई नफ़्ली रोज़ा रखे, चाहे बदले में उसे ज़मीन भर सोना दिया जाए, फिर भी उसका सवाब पूरा न दिया गया))।"
"637","[AI-translation] ((जो नफ़्ली रोज़ा रखे और किसी को ख़बर न हो, अल्लाह तआला बदले में उसे जन्नत से कम कुछ न देकर राज़ी करेगा))।"
"638","[AI-translation] ((रोज़ेदार [हर वक़्त] इबादत में है, चाहे अपने बिस्तर पर सो रहा हो))।"
"639","[AI-translation] ((हज और उमरा दोनों फ़र्ज़ हैं))।"
"640","[AI-translation] ((अगर तू उमरा करे तो तेरे लिए बेहतर है))।"
"641","[AI-translation] ((हज, जिहाद और उमरा नफ़्ली आमाल हैं))।"
"642","[AI-translation] ((जिसके पास बैतुल्लाह के सफ़र की ताक़त हो, जिसमें सफ़र ख़र्च और सवारी शामिल है, फिर भी हज न करे, तो फ़र्क़ नहीं पड़ता वह यहूदी होकर मरे या ईसाई होकर))।"
"643","[AI-translation] ((जो हज से पहले शादी करे उसने गुनाह और नाफ़रमानी शुरू की))।"
"644","[AI-translation] ((जब हाजी अपने घर से निकले तो वह अल्लाह की हिफ़ाज़त में है। अगर हज के अरकान पूरे करने से पहले मर जाए तो अल्लाह उसके पिछले गुनाह बख़्श देता है))।"
"645","[AI-translation] ((अगर लोग जानते कि हाजियों को उन पर क्या फ़ज़ीलत है तो वे उनके पास उनके पैर धोने तक आते))।"
"646","[AI-translation] ((नबी-ए-करीम (सल्लल्लाहु अलैहि वसल्लम) ने मशरिक़ वालों के लिए अक़ीक़ को मीक़ात मुक़र्रर किया))।"
"647","[AI-translation] ((जो मस्जिद-ए-अक़सा से हज या उमरा का एहराम बाँधे और मस्जिद-ए-हराम की तरफ़ जाए, उसके अगले-पिछले सब गुनाह बख़्श दिए जाएँगे, या उसके लिए जन्नत वाजिब हो जाएगी))।"
"648","[AI-translation] ((जब हज़रत काब इब्ने उजरा (रज़ियल्लाहु अन्हु) को सिर में दर्द हुआ तो उन्होंने सिर मुँडाया। इस पर नबी-ए-करीम (सल्लल्लाहु अलैहि वसल्लम) ने उन्हें गाय ज़िबह करने का हुक्म दिया))।"
"649","[AI-translation] ((हमने रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) के साथ हज किया, और औरतें और बच्चे हमारे साथ थे। तो हमने बच्चों की तरफ़ से तलबिया पढ़ा और उनकी तरफ़ से रमी भी की))।"
"650","[AI-translation] ((जब नबी (सल्लल्लाहु अलैहि वसल्लम) तलबिया से फ़ारिग़ होते तो अल्लाह से उसकी रज़ा और जन्नत माँगते, और अल्लाह की रहमत के वसीले से जहन्नम की आग से पनाह माँगते))।"
"651","[AI-translation] ((जब नबी-ए-करीम (सल्लल्लाहु अलैहि वसल्लम) बैतुल्लाह को देखते तो दोनों हाथ उठाते और यह दुआ «اللهم زد هذا البيت تشريفا و تعظيما وتكريما ومهابة ، وزد من شرفه وكرمه ممن حجه واعتمره تشريفا وتعظيما وتكريما وبرا» पढ़ते))।"
"652","[AI-translation] ((बैतुल्लाह का एक रब है जो उसकी हिफ़ाज़त करता है))।"
"653","[AI-translation] ((अल्लाह तआला ने इस घर [यानी काबा] के बारे में वादा किया है कि हर साल [कम से कम] छह लाख लोग उसका हज करेंगे))।"
"654","[AI-translation] ((अल्लाह तआला ने फ़रमाया: जब मैं दुनिया को हलाक करने का इरादा करूँगा तो पहले अपने घर को हलाक करूँगा, फिर उसके बाद दुनिया को हलाक करूँगा))।"
"655","[AI-translation] ((रुक्न-ए-यमानी पर सत्तर हज़ार फ़रिश्ते मुक़र्रर हैं, तो जो [अरबी कलिमात] कहे, सब फ़रिश्ते आमीन कहेंगे। और जो काबा का तवाफ़ करे और सिर्फ़ ये कलिमात [अरबी कलिमात] कहे, उसके दस गुनाह मिटा दिए जाएँगे, उसके लिए दस नेकियाँ लिखी जाएँगी, और उसका दर्जा दस दर्जे बुलन्द किया जाएगा))।"
"656","[AI-translation] ((जो बारिश में एक हफ़्ते तवाफ़ करे, उसके पिछले गुनाह बख़्श दिए जाएँगे))।"
"657","[AI-translation] ((जो अच्छा वुज़ू करे और सफ़ा-मरवा के दरमियान चले, अल्लाह तआला हर क़दम के बदले उसके लिए सत्तर हज़ार दर्जे लिखता है))।"
"658","[AI-translation] ((ज़मज़म का पानी और जहन्नम की आग किसी बन्दे के पेट में कभी जमा नहीं हो सकते))।"
"659","[AI-translation] ((सवार हाजी के लिए उसकी सवारी के हर क़दम पर 70 नेकियाँ हैं, और पैदल चलने वाले के लिए हर क़दम पर 700 नेकियाँ हैं))।"
"660","[AI-translation] ((हज के कमाल में ऊँटों की क़ुर्बानी भी शामिल है))।"
"661","[AI-translation] ((हज के कमाल में यह भी शामिल है कि तू अपने घरवालों और अयाल के इलाक़े से एहराम बाँधे))।"
"662","[AI-translation] ((जो मेरी उम्मत की तरफ़ से हज करे वह मूसा (अलैहिस्सलाम) की वालिदा जैसी है, जो उन्हें दूध पिलाती थीं और फ़िरऔन से इसका मुआवज़ा भी लेती थीं))।"
"663","[AI-translation] ((जो हज करते हुए मक्का के रास्ते में मरे, अल्लाह तआला न उसका सामना करेगा न उसका हिसाब लेगा))।"
"664","[AI-translation] ((जो दोनों हरमों में से किसी में मरे, उसके लिए मेरी शफ़ाअत वाजिब हो जाती है))।"
"665","[AI-translation] ((जो मदीना को 'यस़रिब' कहे वह अल्लाह से तीन बार मग़फ़िरत माँगे))।"
"666","[AI-translation] ((जो मेरी मस्जिद में लगातार चालीस नमाज़ें पढ़े, कोई नमाज़ न छोड़े, उसके लिए आग से बराअत, अज़ाब से नजात और निफ़ाक़ से आज़ादी लिखी जाएगी))।"
"667","[AI-translation] ((जो सवाब की नीयत से मदीना में मेरी ज़ियारत करे, मैं क़ियामत के दिन उसका गवाह और शफ़ीअ हूँगा))।"
"668","[AI-translation] ((जो जानबूझकर मेरी ज़ियारत करे वह क़ियामत के दिन मेरी हिफ़ाज़त में होगा))।"
"669","[AI-translation] ((जो मेरी और मेरे वालिद इब्राहीम (अलैहिस्सलाम) की एक ही साल में ज़ियारत करे वह जन्नत में दाख़िल होगा))।"
"670","[AI-translation] ((जो इस्लाम का [फ़र्ज़] हज करे, मेरी क़ब्र की ज़ियारत करे, जिहाद में शरीक हो, और बैत-उल-मक़दिस पहुँचकर मुझ पर दुरूद भेजे, तो अल्लाह तआला उससे फ़राइज़ के बारे में सवाल न करेगा))।"
"671","[AI-translation] ((जिसके पास ताक़त हो और वह मेरे पास न आए [यानी मेरी क़ब्र की ज़ियारत के लिए], तो उसने मुझसे बेवफ़ाई की))।"
"672","[AI-translation] ((जो अपने वालिदैन की तरफ़ से हज करे या उनका क़र्ज़ अदा करे, अल्लाह तआला उसे क़ियामत के दिन नेकों में उठाएगा))।"
"673","[AI-translation] ((बीमारियाँ बन्दे के लिए अल्लाह की तरफ़ से तोहफ़े हैं, तो बन्दों में अल्लाह को सबसे महबूब वह है जिसे सबसे ज़्यादा तोहफ़े मिलें))।"
"674","[AI-translation] ((बीमारी एकदम उतरती है, लेकिन सेहत थोड़ी-थोड़ी उतरती है))।"
"675","[AI-translation] ((मुसीबत और तकलीफ़ मुसीबतज़दा का चेहरा उस दिन सफ़ेद करेगी जिस दिन चेहरे काले होंगे))।"
"676","[AI-translation] ((अगर इस दुनिया में अल्लाह किसी की बीनाई ले ले, तो अल्लाह पर हक़ है कि उसकी आँखें जहन्नम की आग न देखें))।"
"677","[AI-translation] ((जब कोई तीन दिन बीमार रहे तो वह गुनाहों से ऐसे पाक हो जाता है जैसे उस दिन उसकी माँ ने उसे जना हो))।"
"678","[AI-translation] ((बीमार होने का बहाना न करो, बीमार हो जाओगे; और अपनी क़ब्रें न खोदो, मर जाओगे))।"
"679","[AI-translation] ((पाँच लोगों की दुआएँ क़ुबूल होती हैं: मज़लूम की दुआ यहाँ तक कि बदला ले; हाजी की दुआ यहाँ तक कि लौटे [घर]; मुजाहिद की दुआ यहाँ तक कि घरवालों में बैठे; बीमार की दुआ यहाँ तक कि शिफ़ा पाए; और भाई की भाई के लिए उसकी ग़ैरमौजूदगी में दुआ। फिर नबी (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: इन सब दुआओं में सबसे जल्दी क़ुबूल होने वाली भाई की भाई के लिए उसकी ग़ैरमौजूदगी में दुआ है))।"
"680","[AI-translation] ((बीमारों की इयादत करो और उनसे अपने लिए दुआ कराओ, क्योंकि बीमार की दुआ क़ुबूल होती है और उसके गुनाह बख़्श दिए जाते हैं))।"
"681","[AI-translation] ((जब तुममें से किसी का बीमार कोई खाना चाहे तो उसे खिलाए))।"
"682","[AI-translation] ((जो अच्छा वुज़ू करे फिर सवाब की नीयत से अपने मुसलमान भाई की इयादत करे, उसे जहन्नम से सत्तर (70) साल की दूरी पर रखा जाएगा))।"
"683","[AI-translation] ((नबी-ए-करीम (सल्लल्लाहु अलैहि वसल्लम) बीमारी शुरू होने के तीन दिन बाद बीमारों की इयादत [ख़ैरियत पूछने] जाते))।"
"684","[AI-translation] ((जो बीमार की इयादत करे और थोड़ी देर उसके पास बैठे, अल्लाह तआला उसे हज़ार साल का सवाब देता है))।"
"685","[AI-translation] ((मेरी नज़र में बीमार की इयादत चालीस या पचास साल की इबादत से ज़्यादा महबूब है))।"
"686","[AI-translation] ((बीमारों की इयादत में कोताही न करो))।"
"687","[AI-translation] ((तीन क़िस्म के मरीज़ों की इयादत न करो: आँख के मरीज़ की, दाँत दर्द वाले की, और फोड़े वाले की))।"
"688","[AI-translation] ((उसकी इयादत न करो जो बीमार होने पर तुम्हारी इयादत न करे))।"
"689","[AI-translation] ((जब बीमार की इयादत करो तो उसे मौत के बारे में तसल्ली दो, क्योंकि यह तसल्ली कुछ टालती नहीं, लेकिन मरीज़ की रूह को ख़ुश करती है))।"
"690","[AI-translation] ((जो बीमारी की हालत में मरे वह शहीद की मौत मरा))।"
"691","[AI-translation] ((मुसाफ़िर की मौत शहादत है))।"
"692","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) सात क़िस्म की मौत से पनाह माँगते: अचानक मौत, साँप का काटना, दरिन्दे का हमला, डूबना, जलना, किसी चीज़ पर गिरना या किसी चीज़ का तुझ पर गिरना, और जंग में भागते हुए क़त्ल होना))।"
"693","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) अचानक मौत से पनाह माँगते और मौत से पहले बीमार होना पसन्द करते))।"
"694","[AI-translation] ((मौत अकेली वाइज़ के तौर पर काफ़ी है))।"
"695","[AI-translation] ((महरूम वह है जो असल से महरूम रहा))।"
