hadiths[19]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"4235","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى التَّمِيمِيُّ ، وَمُحَمَّدُ بْنُ رُمْحِ بْنِ الْمُهَاجِرِ ، قَالَا: أَخْبَرَنَا اللَّيْثُ . ح وحَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ ، عَنْ ابْنِ شِهَابٍ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ ، عَنْ ابْنِ عَبَّاسٍ ، أَنَّهُ قَالَ: "" اسْتَفْتَى سَعْدُ بْنُ عُبَادَةَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي نَذْرٍ، كَانَ عَلَى أُمِّهِ تُوُفِّيَتْ قَبْلَ أَنْ تَقْضِيَهُ، قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: فَاقْضِهِ عَنْهَا """"،","Sahih","Sahih Muslim 4235","","","1. باب: نذر کو پورا کرنے کا بیان۔اس شخص کا وصیت نہ کرنا جس کے پاس کوئی ایسی چیز نہیں جس میں وہ وصیت کر سکےChapter: Not Making A Will For One Who Has Nothing To Be Bequeathed"
"4236","وحَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ . ح وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَعَمْرٌو النَّاقِدُ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ ، عَنْ ابْنِ عُيَيْنَةَ . ح وحَدَّثَنِي حَرْمَلَةُ بْنُ يَحْيَى ، أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي يُونُسُ . ح وحَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، وَعَبْدُ بْنُ حُمَيْدٍ ، قَالَا: أَخْبَرَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ . ح وحَدَّثَنَا عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا عَبْدَةُ بْنُ سُلَيْمَانَ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ بَكْرِ بْنِ وَائِلٍ كُلُّهُمْ، عَنْ الزٌّهْرِيِّ بِإِسْنَادِ اللَّيْثِ وَمَعْنَى حَدِيثِهِ.","Sahih","Sahih Muslim 4236","","","1. باب: نذر کو پورا کرنے کا بیان۔نذر پوری کرنے کا حکمChapter: The Command To Fulfill Vows"
"4237","وحَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ إِسْحَاقُ: أَخْبَرَنَا، وقَالَ زُهَيْرٌ حَدَّثَنَا جَرِيرٌ ، عَنْ مَنْصُورٍ ، عَنْ عَبْدِ اللَّهِ بْنِ مُرَّةَ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، قَالَ: "" أَخَذَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَوْمًا يَنْهَانَا عَنِ النَّذْرِ وَيَقُولُ: إِنَّهُ لَا يَرُدُّ شَيْئًا وَإِنَّمَا يُسْتَخْرَجُ بِهِ مِنَ الشَّحِيحِ """".","Sahih","Sahih Muslim 4237","","","2. باب: نذر ماننے کی ممانعت اور اس سے کوئی چیز نہ لوٹنے کا بیان۔نذر پوری کرنے کا حکمChapter: The Command To Fulfill Vows"
"4238","حَدَّثَنَا مُحَمَّدُ بْنُ يَحْيَى ، حَدَّثَنَا يَزِيدُ بْنُ أَبِي حَكِيمٍ ، عَنْ سُفْيَانَ ، عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ ، عَنْ ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، أَنَّهُ قَالَ: "" النَّذْرُ لَا يُقَدِّمُ شَيْئًا وَلَا يُؤَخِّرُهُ، وَإِنَّمَا يُسْتَخْرَجُ بِهِ مِنَ الْبَخِيلِ """".","Sahih","Sahih Muslim 4238","","","2. باب: نذر ماننے کی ممانعت اور اس سے کوئی چیز نہ لوٹنے کا بیان۔نذر کی ممانعت اور یہ کسی چیز (مصیبت )کو نہیں ٹالتیChapter: he Prohibition Of Vows, And Confirmation That They Do Not Avert Anything"
"4239","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَةَ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، وَابْنُ بَشَّارٍ وَاللَّفْظُ لِابْنِ الْمُثَنَّى، حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا شُعْبَةُ ، عَنْ مَنْصُورٍ ، عَنْ عَبْدِ اللَّهِ بْنِ مُرَّةَ ، عَنْ ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ نَهَى عَنِ النَّذْرِ، وَقَالَ: "" إِنَّهُ لَا يَأْتِي بِخَيْرٍ وَإِنَّمَا يُسْتَخْرَجُ بِهِ مِنَ الْبَخِيلِ """"،","Sahih","Sahih Muslim 4239","","","2. باب: نذر ماننے کی ممانعت اور اس سے کوئی چیز نہ لوٹنے کا بیان۔نذر کی ممانعت اور یہ کسی چیز (مصیبت )کو نہیں ٹالتیChapter: he Prohibition Of Vows, And Confirmation That They Do Not Avert Anything"
"4240","وحَدَّثَنِي مُحَمَّدُ بْنُ رَافِعٍ ، حَدَّثَنَا يَحْيَى بْنُ آدَمَ ، حَدَّثَنَا مُفَضَّلٌ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، وَابْنُ بَشَّارٍ ، قَالَا: حَدَّثَنَا عَبْدُ الرَّحْمَنِ ، عَنْ سُفْيَانَ كِلَاهُمَا، عَنْ مَنْصُورٍ بِهَذَا الْإِسْنَادِ نَحْوَ حَدِيثِ جَرِيرٍ.","Sahih","Sahih Muslim 4240","","","2. باب: نذر ماننے کی ممانعت اور اس سے کوئی چیز نہ لوٹنے کا بیان۔نذر کی ممانعت اور یہ کسی چیز (مصیبت )کو نہیں ٹالتیChapter: he Prohibition Of Vows, And Confirmation That They Do Not Avert Anything"
"4241","وحَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا عَبْدُ الْعَزِيزِ يَعْنِي الدَّرَاوَرْدِيَّ ، عَنْ الْعَلَاءِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" لَا تَنْذِرُوا، فَإِنَّ النَّذْرَ لَا يُغْنِي مِنَ الْقَدَرِ شَيْئًا، وَإِنَّمَا يُسْتَخْرَجُ بِهِ مِنَ الْبَخِيلِ """".","Sahih","Sahih Muslim 4241","","","2. باب: نذر ماننے کی ممانعت اور اس سے کوئی چیز نہ لوٹنے کا بیان۔نذر کی ممانعت اور یہ کسی چیز (مصیبت )کو نہیں ٹالتیChapter: he Prohibition Of Vows, And Confirmation That They Do Not Avert Anything"
"4242","وحَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، وَابْنُ بَشَّارٍ ، قَالَا: حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا شُعْبَةُ ، قَالَ: سَمِعْتُ الْعَلَاءَ يُحَدِّثُ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" أَنَّهُ نَهَى عَنِ النَّذْرِ، وَقَالَ: إِنَّهُ لَا يَرُدُّ مِنَ الْقَدَرِ وَإِنَّمَا يُسْتَخْرَجُ بِهِ مِنَ الْبَخِيلِ """".","Sahih","Sahih Muslim 4242","","","2. باب: نذر ماننے کی ممانعت اور اس سے کوئی چیز نہ لوٹنے کا بیان۔نذر کی ممانعت اور یہ کسی چیز (مصیبت )کو نہیں ٹالتیChapter: he Prohibition Of Vows, And Confirmation That They Do Not Avert Anything"
"4243","حَدَّثَنَا يَحْيَى بْنُ أَيُّوبَ ، وَقُتَيْبَةُ بْنُ سَعِيدٍ ، وَعَلِيُّ بْنُ حُجْرٍ ، قَالُوا: حَدَّثَنَا إِسْمَاعِيل وَهُوَ ابْنُ جَعْفَرٍ ، عَنْ عَمْرٍو وَهُوَ ابْنُ أَبِي عَمْرٍو ، عَنْ عَبْدِ الرَّحْمَنِ الْأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" إِنَّ النَّذْرَ لَا يُقَرِّبُ مِنَ ابْنِ آدَمَ شَيْئًا لَمْ يَكُنِ اللَّهُ قَدَّرَهُ لَهُ، وَلَكِنْ النَّذْرُ يُوَافِقُ الْقَدَرَ فَيُخْرَجُ بِذَلِكَ مِنَ الْبَخِيلِ مَا لَمْ يَكُنِ الْبَخِيلُ يُرِيدُ أَنْ يُخْرِجَ """"،","Sahih","Sahih Muslim 4243","","","2. باب: نذر ماننے کی ممانعت اور اس سے کوئی چیز نہ لوٹنے کا بیان۔نذر کی ممانعت اور یہ کسی چیز (مصیبت )کو نہیں ٹالتیChapter: he Prohibition Of Vows, And Confirmation That They Do Not Avert Anything"
"4244","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا يَعْقُوبُ يَعْنِي ابْنَ عَبْدِ الرَّحْمَنِ الْقَارِيَّ ، وَعَبْدُ الْعَزِيزِ يَعْنِي الدَّرَاوَرْدِيَّ كِلَاهُمَا، عَنْ عَمْرِو بْنِ أَبِي عَمْرٍو بِهَذَا الْإِسْنَادِ مِثْلَهُ.","Sahih","Sahih Muslim 4244","","","2. باب: نذر ماننے کی ممانعت اور اس سے کوئی چیز نہ لوٹنے کا بیان۔نذر کی ممانعت اور یہ کسی چیز (مصیبت )کو نہیں ٹالتیChapter: he Prohibition Of Vows, And Confirmation That They Do Not Avert Anything"
"4245","وحَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، وَعَلِيُّ بْنُ حُجْرٍ السَّعْدِيُّ واللفظ لزهير، قَالَا: حَدَّثَنَا إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ، حَدَّثَنَا أَيُّوبُ ، عَنْ أَبِي قِلَابَةَ ، عَنْ أَبِي الْمُهَلَّبِ ، عَنْ عِمْرَانَ بْنِ حُصَيْنٍ ، قَالَ: "" كَانَتْ ثَقِيفُ حُلَفَاءَ لِبَنِى عُقَيْلٍ، فَأَسَرَتْ ثَقِيفُ رَجُلَيْنِ مِنْ أَصْحَابِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، وَأَسَرَ أَصْحَابُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَجُلًا مِنْ بَنِي عُقَيْلٍ وَأَصَابُوا مَعَهُ الْعَضْبَاءَ، فَأَتَى عَلَيْهِ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ فِي الْوَثَاقِ، قَالَ: يَا مُحَمَّدُ فَأَتَاهُ، فَقَالَ: مَا شَأْنُكَ، فَقَالَ: بِمَ أَخَذْتَنِي وَبِمَ أَخَذْتَ سَابِقَةَ الْحَاجِّ، فَقَالَ: إِعْظَامًا لِذَلِكَ أَخَذْتُكَ بِجَرِيرَةِ حُلَفَائِكَ ثَقِيفَ، ثُمَّ انْصَرَفَ عَنْهُ، فَنَادَاهُ فَقَالَ: يَا مُحَمَّدُ، يَا مُحَمَّدُ، وَكَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَحِيمًا رَقِيقًا فَرَجَعَ إِلَيْهِ، فَقَالَ: مَا شَأْنُكَ؟، قَالَ: إِنِّي مُسْلِمٌ، قَالَ: لَوْ قُلْتَهَا وَأَنْتَ تَمْلِكُ أَمْرَكَ أَفْلَحْتَ كُلَّ الْفَلَاحِ، ثُمَّ انْصَرَفَ، فَنَادَاهُ فَقَالَ: يَا مُحَمَّدُ، يَا مُحَمَّدُ فَأَتَاهُ، فَقَالَ: مَا شَأْنُكَ؟ قَالَ: إِنِّي جَائِعٌ، فَأَطْعِمْنِي وَظَمْآنُ فَأَسْقِنِي، قَالَ: هَذِهِ حَاجَتُكَ فَفُدِيَ بِالرَّجُلَيْنِ، قَالَ: وَأُسِرَتِ امْرَأَةٌ مِنْ الْأَنْصَارِ، وَأُصِيبَتِ الْعَضْبَاءُ فَكَانَتِ الْمَرْأَةُ فِي الْوَثَاقِ وَكَانَ الْقَوْمُ يُرِيحُونَ نَعَمَهُمْ بَيْنَ يَدَيْ بُيُوتِهِمْ، فَانْفَلَتَتْ ذَاتَ لَيْلَةٍ مِنَ الْوَثَاقِ، فَأَتَتِ الْإِبِلَ، فَجَعَلَتْ إِذَا دَنَتْ مِنَ الْبَعِيرِ رَغَا، فَتَتْرُكُهُ حَتَّى تَنْتَهِيَ إِلَى الْعَضْبَاءِ، فَلَمْ تَرْغُ، قَالَ: وَنَاقَةٌ مُنَوَّقَةٌ، فَقَعَدَتْ فِي عَجُزِهَا ثُمَّ زَجَرَتْهَا، فَانْطَلَقَتْ وَنَذِرُوا بِهَا، فَطَلَبُوهَا فَأَعْجَزَتْهُمْ، قَالَ: وَنَذَرَتْ لِلَّهِ إِنْ نَجَّاهَا اللَّهُ عَلَيْهَا لَتَنْحَرَنَّهَا، فَلَمَّا قَدِمَتْ الْمَدِينَةَ رَآهَا النَّاسُ، فَقَالُوا: الْعَضْبَاءُ نَاقَةُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَتْ: إِنَّهَا نَذَرَتْ إِنْ نَجَّاهَا اللَّهُ عَلَيْهَا لَتَنْحَرَنَّهَا، فَأَتَوْا رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَذَكَرُوا ذَلِكَ لَهُ، فَقَالَ: سُبْحَانَ اللَّهِ بِئْسَمَا جَزَتْهَا نَذَرَتْ لِلَّهِ إِنْ نَجَّاهَا اللَّهُ عَلَيْهَا لَتَنْحَرَنَّهَا، لَا وَفَاءَ لِنَذْرٍ فِي مَعْصِيَةٍ، وَلَا فِيمَا لَا يَمْلِكُ الْعَبْدُ """" وَفِي رِوَايَةِ ابْنِ حُجْرٍ لَا نَذْرَ فِي مَعْصِيَةِ اللَّهِ،","Sahih","Sahih Muslim 4245","","","3. باب: ایسی نذر جس میں اللہ کی نافرمانی ہو اور جس کو پورا کرنے کی طاقت نہ ہو اس کو پورا کرنے کا بیان۔نذر کی ممانعت اور یہ کسی چیز (مصیبت )کو نہیں ٹالتیChapter: he Prohibition Of Vows, And Confirmation That They Do Not Avert Anything"
"4246","حَدَّثَنَا أَبُو الرَّبِيعِ الْعَتَكِيُّ ، حَدَّثَنَا حَمَّادٌ يَعْنِي ابْنَ زَيْدٍ . ح وحَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، وَابْنُ أَبِي عُمَرَ ، عَنْ عَبْدِ الْوَهَّابِ الثَّقَفِيِّ كِلَاهُمَا، عَنْ أَيُّوبَ بِهَذَا الْإِسْنَادِ نَحْوَهُ، وَفِي حَدِيثِ حَمَّادٍ، قَالَ: كَانَتِ الْعَضْبَاءُ لِرَجُلٍ مِنْ بَنِي عُقَيْلٍ، وَكَانَتْ مِنْ سَوَابِقِ الْحَاجِّ، وَفِي حَدِيثِهِ أَيْضًا، فَأَتَتْ عَلَى نَاقَةٍ ذَلُولٍ مُجَرَّسَةٍ وَفِي حَدِيثِ الثَّقَفِيِّ وَهِيَ نَاقَةٌ مُدَرَّبَةٌ.","Sahih","Sahih Muslim 4246","","","3. باب: ایسی نذر جس میں اللہ کی نافرمانی ہو اور جس کو پورا کرنے کی طاقت نہ ہو اس کو پورا کرنے کا بیان۔اللہ کی نا فرمانی میں نذر پوری کرنی جائز نہیں اور نہ اس چیز میں جو بندے کے اختیار میں نہیںChapter: There is no fulfillment of a vow that involves disobedience towards Allah, or a vow concerning that which a person does not own"
"4247","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى التَّمِيمِيُّ ، أَخْبَرَنَا يَزِيدُ بْنُ زُرَيْعٍ ، عَنْ حُمَيْدٍ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ . ح وحَدَّثَنَا ابْنُ أَبِي عُمَرَ وَاللَّفْظُ لَهُ، حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِيَةَ الْفَزَارِيُّ ، حَدَّثَنَا حُمَيْدٌ ، حَدَّثَنِي ثَابِتٌ ، عَنْ أَنَسٍ : أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَأَى شَيْخًا يُهَادَى بَيْنَ ابْنَيْهِ، فَقَالَ: "" مَا بَالُ هَذَا؟ قَالُوا: نَذَرَ أَنْ يَمْشِيَ، قَالَ: إِنَّ اللَّهَ عَنْ تَعْذِيبِ هَذَا نَفْسَهُ لَغَنِيٌّ، وَأَمَرَهُ أَنْ يَرْكَبَ """".","Sahih","Sahih Muslim 4247","","","4. باب: بیت اللہ کی طرف پیدل چلنے کی نذر کا بیان۔اللہ کی نا فرمانی میں نذر پوری کرنی جائز نہیں اور نہ اس چیز میں جو بندے کے اختیار میں نہیںChapter: There is no fulfillment of a vow that involves disobedience towards Allah, or a vow concerning that which a person does not own"
"4248","وحَدَّثَنَا يَحْيَى بْنُ أَيُّوبَ ، وَقُتَيْبَةُ ، وَابْنُ حُجْرٍ ، قَالُوا: حَدَّثَنَا إِسْمَاعِيلُ وَهُوَ ابْنُ جَعْفَرٍ ، عَنْ عَمْرٍو وَهُوَ ابْنُ أَبِي عَمْرٍو ، عَنْ عَبْدِ الرَّحْمَنِ الْأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، "" أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَدْرَكَ شَيْخًا يَمْشِي بَيْنَ ابْنَيْهِ يَتَوَكَّأُ عَلَيْهِمَا، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: مَا شَأْنُ هَذَا؟، قَالَ ابْنَاهُ: يَا رَسُولَ اللَّهِ، كَانَ عَلَيْهِ نَذْرٌ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: ارْكَبْ أَيُّهَا الشَّيْخُ، فَإِنَّ اللَّهَ غَنِيٌّ عَنْكَ وَعَنْ نَذْرِكَ """"، وَاللَّفْظُ لِقُتَيْبَةَ، وَابْنِ حُجْرٍ،","Sahih","Sahih Muslim 4248","","","4. باب: بیت اللہ کی طرف پیدل چلنے کی نذر کا بیان۔جس نے کعبہ کی طرف پیدل چلنے کی نذر مانیChapter: One Who Vows To Walk To The Ka'bah"
"4249","وحَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا عَبْدُ الْعَزِيزِ يَعْنِي الدَّرَاوَرْدِيَّ، عَنْ عَمْرِو بْنِ أَبِي عَمْرٍو بِهَذَا الْإِسْنَادِ مِثْلَهُ.","Sahih","Sahih Muslim 4249","","","4. باب: بیت اللہ کی طرف پیدل چلنے کی نذر کا بیان۔جس نے کعبہ کی طرف پیدل چلنے کی نذر مانیChapter: One Who Vows To Walk To The Ka'bah"
"4250","وحَدَّثَنَا زَكَرِيَّاءُ بْنُ يَحْيَى بْنِ صَالِحٍ الْمِصْرِيُّ ، حَدَّثَنَا الْمُفَضَّلُ يَعْنِي ابْنَ فَضَالَةَ ، حَدَّثَنِي عَبْدُ اللَّهِ بْنُ عَيَّاشٍ ، عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ ، عَنْ أَبِي الْخَيْرِ ، عَنْ عُقْبَةَ بْنِ عَامِرٍ ، أَنَّهُ قَالَ: "" نَذَرَتْ أُخْتِي أَنْ تَمْشِيَ إِلَى بَيْتِ اللَّهِ حَافِيَةً، فَأَمَرَتْنِي أَنْ أَسْتَفْتِيَ لَهَا رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَاسْتَفْتَيْتُهُ، فَقَالَ: لِتَمْشِ وَلْتَرْكَبْ """"،","Sahih","Sahih Muslim 4250","","","4. باب: بیت اللہ کی طرف پیدل چلنے کی نذر کا بیان۔جس نے کعبہ کی طرف پیدل چلنے کی نذر مانیChapter: One Who Vows To Walk To The Ka'bah"
"4251","وحَدَّثَنِي مُحَمَّدُ بْنُ رَافِعٍ ، حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا ابْنُ جُرَيْجٍ ، أَخْبَرَنَا سَعِيدُ بْنُ أَبِي أَيُّوبَ ، أَنَّ يَزِيدَ بْنَ أَبِي حَبِيبٍ أَخْبَرَهُ: أَنَّ أَبَا الْخَيْرِ حَدَّثَهُ، عَنْ عُقْبَةَ بْنِ عَامِرٍ الْجُهَنِيِّ ، أَنَّهُ قَالَ: نَذَرَتْ أُخْتِي، فَذَكَرَ بِمِثْلِ حَدِيثِ مُفَضَّلٍ وَلَمْ يَذْكُرْ فِي الْحَدِيثِ حَافِيَةً، وَزَادَ وَكَانَ أَبُو الْخَيْرِ لَا يُفَارِقُ عُقْبَةَ،","Sahih","Sahih Muslim 4251","","","4. باب: بیت اللہ کی طرف پیدل چلنے کی نذر کا بیان۔جس نے کعبہ کی طرف پیدل چلنے کی نذر مانیChapter: One Who Vows To Walk To The Ka'bah"
"4252","وحَدَّثَنِيهِ مُحَمَّدُ بْنُ حَاتِمٍ ، وَابْنُ أَبِي خَلَفٍ ، قَالَا: حَدَّثَنَا رَوْحُ بْنُ عُبَادَةَ ، حَدَّثَنَا ابْنُ جُرَيْجٍ ، أَخْبَرَنِي يَحْيَى بْنُ أَيُّوبَ ، أَنَّ يَزِيدَ بْنَ أَبِي حَبِيبٍ أَخْبَرَهُ، بِهَذَا الْإِسْنَادِ مِثْلَ حَدِيثِ عَبْدِ الرَّزَّاقِ.","Sahih","Sahih Muslim 4252","","","4. باب: بیت اللہ کی طرف پیدل چلنے کی نذر کا بیان۔جس نے کعبہ کی طرف پیدل چلنے کی نذر مانیChapter: One Who Vows To Walk To The Ka'bah"
"4253","وحَدَّثَنِي هَارُونُ بْنُ سَعِيدٍ الْأَيْلِيُّ ، وَيُونُسُ بْنُ عَبْدِ الْأَعْلَى ، وَأَحْمَدُ بْنُ عِيسَى ، قَالَ يُونُسُ: أَخْبَرَنَا، وقَالَ الْآخَرَانِ، حَدَّثَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي عَمْرُو بْنُ الْحَارِثِ ، عَنْ كَعْبِ بْنِ عَلْقَمَةَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ شِمَاسَةَ ، عَنْ أَبِي الْخَيْرِ ، عَنْ عُقْبَةَ بْنِ عَامِرٍ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" كَفَّارَةُ النَّذْرِ كَفَّارَةُ الْيَمِينِ """".","Sahih","Sahih Muslim 4253","","","5. باب: نذر کے کفارے کا بیان۔جس نے کعبہ کی طرف پیدل چلنے کی نذر مانیChapter: One Who Vows To Walk To The Ka'bah"
