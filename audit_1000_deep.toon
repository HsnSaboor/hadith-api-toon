"sahih-ibn-khuzaymah","2019","بَابُ إِبَاحَةِ رَمْيِ الْجِمَارِ يَوْمَ النَّحْرِ رَاكِبًادس","بَابُ إِبَاحَةِ رَمْيِ الْجِمَارِ يَوْمَ النَّحْرِ رَاكِبًادس","","","","","","","ذوالحجہ کو سوار ہوکر کنکریاں مارنا جائز ہے","2877","2877"
"sahih-ibn-khuzaymah","2020","بَابُ الزَّجْرِ عَنْ ضَرْبِ النَّاسِ وَطَرْدِهِمْ عِنْدَ رَمْيِ الْجِمَارِجمرات","بَابُ الزَّجْرِ عَنْ ضَرْبِ النَّاسِ وَطَرْدِهِمْ عِنْدَ رَمْيِ الْجِمَارِجمرات","","","","","","","کو کنکریاں مارتے وقت لوگوں کو مارنا اوار دھکے دینا منع ہے","2878","2878"
"sahih-ibn-khuzaymah","2021","بَابُ ذِكْرِ الْمَوْقِفِ الَّذِي يَرْمِي مِنْهُ الْجِمَارَاس","بَابُ ذِكْرِ الْمَوْقِفِ الَّذِي يَرْمِي مِنْهُ الْجِمَارَاس","","","","","","","جگہ کا بیان جہاں کھڑے ہوکر کنکریاں ماری جائیںگی","2879","2879"
"sahih-ibn-khuzaymah","2022","بَابُ اسْتِقْبَالِ الْجَمْرَةِ عِنْدَ رَمْيِهَا وَالْوُقُوفِ عَنْ يَسَارِ الْقِبْلَةِجمرات","بَابُ اسْتِقْبَالِ الْجَمْرَةِ عِنْدَ رَمْيِهَا وَالْوُقُوفِ عَنْ يَسَارِ الْقِبْلَةِجمرات","","","","","","","پر کنکریاں مارتے وقت چہرہ جمرے کی طرف ہونا چاہیے اور بیت اللہ شریف کو بائیں طرف کرکے کھڑے ہونے کا بیان","2880","2880"
"sahih-ibn-khuzaymah","2023","بَابُ التَّكْبِيرِ مَعَ كُلِّ حَصَاةٍ يَرْمِيهَا لِلْجِمَارِجمرات پر ہر کنکری پھنکتے وقت اللهُ أَكْبَرُ","بَابُ التَّكْبِيرِ مَعَ كُلِّ حَصَاةٍ يَرْمِيهَا لِلْجِمَارِجمرات پر ہر کنکری پھنکتے وقت اللهُ أَكْبَرُ","","","","","","","پڑھنا","2881","2881"
