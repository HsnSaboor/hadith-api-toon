hadiths[107]{hadithnumber,text}:
"1","[AI-translation] ((जिसकी नमाज़ उसे बेहयाई और बुराई से न रोके, उसकी कोई नमाज़ नहीं))।"
"2","[AI-translation] ((जिसकी नमाज़ उसे बेहयाई और बुरे कामों से न रोके, वह अल्लाह से दूरी में ही बढ़ता है))।"
"3","[AI-translation] ((मस्जिद में फ़ुज़ूल बातें नेकियों को ऐसे खा जाती हैं जैसे मवेशी घास खा जाते हैं))।"
"4","[AI-translation] ((मस्जिद में बातें करना नेकियों को ऐसे खा जाता है जैसे आग लकड़ी को खा जाती है))।"
"5","[AI-translation] ((अपनी दुनिया के लिए ऐसे अमल कर जैसे तू हमेशा जीएगा, और अपनी आख़िरत के लिए ऐसे अमल कर जैसे तू कल मर जाएगा))।"
"6","[AI-translation] ((मैं हर मुत्तक़ी का जद्द [यानी पेशवा] हूँ))।"
"7","[AI-translation] ((मैं बेशक मुअल्लिम [शिक्षक] बनाकर भेजा गया हूँ))।"
"8","[AI-translation] ((अल्लाह तआला ने दुनिया की तरफ़ वह्य फ़रमाई: जो मेरी ख़िदमत करे उसकी ख़िदमत कर, और जो तेरी ख़िदमत करे उसे थका दे))।"
"9","[AI-translation] ((गोबर पर उगी हरियाली से बचो))। पूछा गया: ((गोबर पर उगी हरियाली क्या है?)) फ़रमाया: ((बुरे माहौल में पली-बढ़ी ख़ूबसूरत औरत))।"
"10","[AI-translation] ((मेरी उम्मत के दो गिरोह सुधर जाएँ तो [सब] लोग सुधर जाएँगे: हुक्मरान और फ़ुक़हा [आलिम]))।"
"12","[AI-translation] ((मेरे जाह [मर्तबे] के वसीले से [माँगो], क्योंकि अल्लाह के नज़दीक मेरा मर्तबा बहुत बड़ा है))।"
"13","[AI-translation] ((जो अपने घर से नमाज़ के लिए निकले और कहे: ऐ अल्लाह! मैं तुझसे सवाल करने वालों के हक़ के वसीले से और अपने इस चलने के हक़ के वसीले से माँगता हूँ, और मैं तकब्बुर और घमंड से नहीं निकला, तो अल्लाह अपनी तवज्जोह से उसकी तरफ़ मुतवज्जेह होता है और हज़ार (1000) फ़रिश्ते उसके लिए मग़फ़िरत माँगते हैं))।"
"14","[AI-translation] ((भलाई मुझमें है और क़ियामत के दिन तक मेरी उम्मत में रहेगी))।"
"15","[AI-translation] ((जो अस्र के बाद सोए फिर उसकी अक़्ल जाती रहे, तो वह अपने सिवा किसी को मलामत न करे))।"
"16","[AI-translation] ((जिसका वुज़ू टूटे और वह वुज़ू न करे उसने मुझसे बेवफ़ाई की, और जिसने वुज़ू किया और नमाज़ न पढ़ी उसने मुझसे बेवफ़ाई की, और जिसने नमाज़ पढ़ी और मुझसे दुआ न माँगी उसने मुझसे बेवफ़ाई की, और जिसने मुझसे माँगा और मैंने उसे न दिया तो मैंने उससे बेवफ़ाई की, और मैं बेवफ़ा रब नहीं हूँ))।"
"17","[AI-translation] ((जिसने बैतुल्लाह का हज किया और मेरी ज़ियारत न की, उसने बेशक मुझसे बेवफ़ाई की))।"
"18","[AI-translation] ((जिसने हज किया और मेरी वफ़ात के बाद मेरी क़ब्र की ज़ियारत की, तो गोया उसने मेरी ज़िन्दगी में मेरी ज़ियारत की))।"
"19","[AI-translation] ((मेरी उम्मत का इख़्तिलाफ़ रहमत है))।"
"20","[AI-translation] ((मेरे सहाबा सितारों की तरह हैं; तुम उनमें से जिसकी पैरवी करोगे हिदायत पाओगे))।"
"21","[AI-translation] ((मेरे सहाबा बेशक सितारों की तरह हैं; तुम उनमें से जिसके क़ौल को थाम लोगे हिदायत पाओगे))।"
"22","[AI-translation] ((जिसने अपने नफ़्स को पहचाना उसने बेशक अपने रब को पहचान लिया))।"
"23","[AI-translation] ((मेरे रब ने मुझे अदब सिखाया और मेरे अदब को बेहतरीन बनाया))।"
"24","[AI-translation] ((सब लोग मुर्दा हैं सिवाय आलिमों के, और सब आलिम हलाक हैं सिवाय अमल करने वालों के, और सब अमल करने वाले डूबे हुए हैं सिवाय मुख़लिसों के, और मुख़लिस भी बड़े ख़तरे में हैं))।"
"25","[AI-translation] ((मोमिन का बचा हुआ [खाना] शिफ़ा है))।"
"26","[AI-translation] ((जब तुम ख़ुरासान की तरफ़ से काले झंडे आते देखो तो उनकी तरफ़ जाओ चाहे तुम्हें बर्फ़ पर घिसटना पड़े, क्योंकि उनमें अल्लाह का ख़लीफ़ा महदी है))।"
"27","[AI-translation] ((तौबा करने वाला अल्लाह का महबूब [दोस्त] है))।"
"28","[AI-translation] ((ख़बरदार! मैं भूलता नहीं, बल्कि मुझे भुलाया जाता है ताकि मैं शरीअत के अहकाम क़ायम करूँ))।"
"29","[AI-translation] ((लोग सोए हुए हैं; जब मरेंगे तो जाग उठेंगे))।"
"30","[AI-translation] ((जो कोई हदीस बयान करे और उस वक़्त [वहाँ] छींक आए तो वह [हदीस] हक़ है))।"
"31","[AI-translation] ((निकाह करो और तलाक़ न दो, क्योंकि तलाक़ से अर्श काँप उठता है))।"
"32","[AI-translation] ((एक दिरहम [की मिक़दार] के बराबर ख़ून की वजह से नमाज़ दोहराई जाएगी [यानी अगर किसी के कपड़े इतने ख़ून से आलूदा हों और वह नमाज़ पढ़ ले तो उस पर नमाज़ दोहराना वाजिब है; और अगर ख़ून इससे कम हो तो दोहराना वाजिब नहीं]))।"
"33","[AI-translation] ((सख़ी अल्लाह की रहमत के क़रीब है, जन्नत के क़रीब है, लोगों के क़रीब है और जहन्नम की आग से दूर है, जबकि बख़ील अल्लाह से दूर है, जन्नत से दूर है, लोगों से दूर है और जहन्नम की आग के क़रीब है। और जाहिल सख़ी अल्लाह तआला को बख़ील आबिद से ज़्यादा महबूब है))।"
"34","[AI-translation] ((मैं अरबी हूँ, क़ुरआन अरबी [ज़बान] में है और जन्नत वालों की ज़बान भी अरबी है))।"
"35","[AI-translation] ((बेशक हर चीज़ का एक दिल है, और क़ुरआन का दिल [सूरत] यासीन है। जो इसे [एक बार] पढ़े तो गोया उसने क़ुरआन दस बार पढ़ा))।"
"36","[AI-translation] ((एक घड़ी का फ़िक्र [ग़ौर-ओ-फ़िक्र] साठ (60) साल की इबादत से बेहतर है))।"
"37","[AI-translation] ((मस्जिद के पड़ोसी की नमाज़ सिर्फ़ मस्जिद में [होती है, घर में नहीं]))।"
"38","[AI-translation] ((हज्र-ए-असवद ज़मीन पर अल्लाह का दायाँ हाथ है; इसके ज़रिए वह अपने बन्दों से मुसाफ़हा करता है))।"
"39","[AI-translation] ((रोज़ा रखो सेहतमन्द हो जाओगे))।"
"40","[AI-translation] ((जिब्रील (अलैहिस्सलाम) ने मुझे पड़ोसी के बारे में यहाँ तक वसीयत की कि चालीस घर तक: इधर से दस, इधर से दस, इधर से दस और इधर से दस))।"
"41","[AI-translation] (([ऐ नबी!] अगर तू न होता तो मैं दुनिया पैदा न करता))।"
"42","[AI-translation] ((जो हर रात सूरत-ए-वाक़िआ पढ़े उसे कभी फ़क़्र [मुहताजी] न पहुँचेगी))।"
"43","[AI-translation] ((जो सुबह करे और उसकी फ़िक्र और ग़म अल्लाह की रज़ा के सिवा किसी और चीज़ के लिए हो तो उसका अल्लाह से कोई ताल्लुक़ नहीं; और जो मुसलमानों का ग़म और फ़िक्र न करे वह उनमें से नहीं))।"
"44","[AI-translation] ((जैसे तुम [ख़ुद] होगे वैसे ही हुक्मरान तुम पर मुक़र्रर किए जाएँगे))।"
"45","[AI-translation] ((बेशक अल्लाह तआला शाबान की पन्द्रहवीं (15) रात को आसमाने-दुनिया की तरफ़ नुज़ूल फ़रमाता है और बनू-कल्ब की बकरियों के बालों की तादाद से ज़्यादा लोगों को बख़्श देता है))।"
"46","[AI-translation] हज़रत आइशा (रज़ियल्लाहु अन्हा) से रिवायत है, वह नबी-ए-करीम (सल्लल्लाहु अलैहि वसल्लम) से रिवायत करती हैं: ((क्या तू जानती है यह कौन-सी रात है [यानी शाबान की पन्द्रहवीं (15) रात]?)) हज़रत आइशा (रज़ियल्लाहु अन्हा) ने अर्ज़ किया: ((ऐ अल्लाह के रसूल! इसमें क्या होता है?)) आप (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: ((इस रात में बनी-आदम में से उन बच्चों के बारे में लिखा जाता है जो इस साल पैदा होंगे; इस रात में बनी-आदम में से हर उस इंसान के बारे में लिखा जाता है जो इस साल मरेगा; इस रात में उनके आमाल उठाए जाते हैं [अल्लाह की तरफ़], और इस रात में उनका रिज़्क़ उतारा जाता है))।"
"47","[AI-translation] हज़रत अबू मूसा अशअरी (रज़ियल्लाहु अन्हु) से रिवायत है कि: ((बेशक शाबान की पन्द्रहवीं रात में अल्लाह ज़मीन वालों की तरफ़ रहमत से देखता है और मुश्रिक या [बिला-वजह] कीना रखने वाले के सिवा अपनी सारी मख़लूक़ को बख़्श देता है))।"
"48","[AI-translation] हज़रत अली इब्ने अबी तालिब (रज़ियल्लाहु अन्हु) से मरफ़ूअ रिवायत में है कि: ((जब शाबान की पन्द्रहवीं रात आए तो उसकी रात में नमाज़ पढ़ो और उसके दिन में रोज़ा रखो। बेशक अल्लाह तआला उस रात सूरज डूबने के बाद आसमाने-दुनिया की तरफ़ नुज़ूल फ़रमाता है और एलान करता है: ख़बरदार! कौन है जो मुझसे मग़फ़िरत माँगे ताकि मैं उसे बख़्श दूँ? कौन है जो मुझसे रिज़्क़ माँगे ताकि मैं उसे रिज़्क़ दूँ? कौन है जो मुसीबत या तकलीफ़ में हो ताकि मैं उसे आफ़ियत दूँ? ख़बरदार! क्या फ़लाँ है, क्या फ़लाँ है — यहाँ तक कि फ़ज्र तुलूअ हो जाए))।"
"49","[AI-translation] हज़रत अबू उमामा (रज़ियल्लाहु अन्हु) से रिवायत है कि: ((पाँच रातें ऐसी हैं जिनमें दुआ रद्द नहीं होती: (1) रजब के महीने की पहली रात, (2) शाबान की पन्द्रहवीं रात, (3) जुमुआ [शुक्रवार] की रात, (4) ईद-उल-फ़ित्र की रात, (5) ईद-उल-अज़हा की रात))।"
"50","[AI-translation] ((जब किसी के यहाँ बच्चा पैदा हो और वह उसके दाएँ कान में अज़ान कहे और बाएँ कान में इक़ामत कहे तो उम्मुस्सिब्यान [एक बीमारी का नाम] उसे नुक़सान न पहुँचाएगी))।"
"51","[AI-translation] ((जो मेरी उम्मत के फ़साद के ज़माने में मेरी सुन्नत को मज़बूती से थामे रखे उसे सौ शहीदों का सवाब मिलेगा))।"
"52","[AI-translation] ((मेरी उम्मत के फ़साद के वक़्त मेरी सुन्नत पर क़ायम रहने वाले को एक शहीद का सवाब मिलेगा))।"
"53","[AI-translation] ((मैं दो ज़बीहों का बेटा हूँ [यानी इस्माईल (अलैहिस्सलाम) और तुम्हारे नबी के वालिद अब्दुल्लाह]))।"
"54","[AI-translation] ((क़ुरआन को देखना इबादत है, वालिदैन को देखना इबादत है, और हज़रत अली इब्ने अबी तालिब (रज़ियल्लाहु अन्हु) को देखना भी इबादत है))।"
"55","[AI-translation] ((जो मेरी मस्जिद [यानी मस्जिद-ए-नबवी] में चालीस नमाज़ें पढ़े और उनमें से एक भी न छूटे, तो उसके लिए आग से बराअत और अज़ाब से नजात लिख दी जाएगी और वह निफ़ाक़ से बरी होगा))।"
"56","[AI-translation] ((क़रीबी रिश्तेदार भलाई [अच्छे सुलूक] के ज़्यादा हक़दार हैं))।"
"57","[AI-translation] ((जन्नत में दाख़िल होने वाला आख़िरी शख़्स क़बीला-ए-जुहैना का एक मर्द होगा, जिसका नाम जुहैना होगा। जन्नती उससे पूछेंगे: क्या कोई बाक़ी है जिसे अज़ाब दिया जा रहा है? वह कहेगा: नहीं। तो वे कहेंगे: जुहैना के पास यक़ीनी ख़बर है))।"
"58","[AI-translation] ((बेहतरीन नाम वे हैं जिनमें बंदगी [यानी अब्दिय्यत, जैसे अब्दुल्लाह] और हम्द [तारीफ़, जैसे मुहम्मद और अहमद] हो))।"
"59","[AI-translation] ((इल्म हासिल करो चाहे चीन जाना पड़े))।"
"60","[AI-translation] ((उनसे मशवरा करो, यानी औरतों से, और उनकी मुख़ालफ़त करो [उनकी राय पर न चलो]))।"
"61","[AI-translation] ((क़ियामत के दिन लोग अपनी माओं [के नाम] से पुकारे जाएँगे पर्दापोशी [ऐब छुपाने] के लिए, क्योंकि अगर वे अपने बापों [के नाम] से पुकारे गए तो मुमकिन है कि जिसे दुनिया में उनका बाप समझा जाता था वह हक़ीक़त में उनका असली बाप न हो, बल्कि कोई और हो, और तब हश्र के मैदान में खुलेआम ज़ाहिर हो जाएगा कि वह नाजायज़ पैदा हुआ है))।"
"62","[AI-translation] ((हाकिम ज़मीन पर अल्लाह का साया है; जो उसकी ख़ैरख़्वाही चाहे वह हिदायत पाएगा, और जो उसे धोखा दे वह गुमराह होगा))।"
"63","[AI-translation] ((जो अल्लाह से डरे, अल्लाह हर चीज़ को उससे डराएगा; और जो अल्लाह से न डरे, अल्लाह उसे हर चीज़ से डराएगा))।"
"64","[AI-translation] अल्लाह तबारक व तआला ने फ़रमाया: ((जो मेरे फ़ैसले पर राज़ी न हो और मेरी आज़माइश पर सब्र न करे तो वह मेरे सिवा कोई और रब तलाश कर ले))।"
"65","[AI-translation] ((फ़ासिक़ और बदकार की ग़ीबत [ममनूअ] ग़ीबत नहीं [यानी खुले गुनाहगार की ग़ीबत में कोई गुनाह नहीं]))।"
"66","[AI-translation] ((जब तुममें से कोई मर जाए और तुम उसे दफ़न करो तो तुममें से एक शख़्स उसके सिरहाने खड़ा हो और कहे: ऐ फ़लाँ औरत के बेटे फ़लाँ! वह बेशक सुनेगा। फिर कहे: ऐ फ़लाँ औरत के बेटे फ़लाँ! वह बेशक सीधा बैठ जाएगा। फिर कहे: ऐ फ़लाँ औरत के बेटे फ़लाँ! वह बेशक कहेगा: मुझे राह बता, मुझे राह बता, अल्लाह तुझ पर रहम करे। फिर कहे: याद कर जिस पर तू इस दुनिया के घर से रुख़सत हुआ, [यानी] इस गवाही को कि अल्लाह के सिवा कोई माबूद नहीं, वह अकेला है, उसका कोई शरीक नहीं, और बेशक मुहम्मद (सल्लल्लाहु अलैहि वसल्लम) उसके बन्दे और उसके रसूल हैं, और क़ियामत आने वाली है जिसमें कोई शक नहीं, और बेशक अल्लाह क़ब्रों वालों को उठाएगा))।"
"67","[AI-translation] ((जिसने इस्तिख़ारा किया वह कभी नाकाम न हुआ, जिसने [दूसरों से] मशवरा किया वह कभी पछताया नहीं, और जिसने मियानारवी अपनाई वह कभी मुहताज न हुआ))।"
"68","[AI-translation] ((जब नबी (सल्लल्लाहु अलैहि वसल्लम) अपने बाल काटते या नाख़ुन तराशते या पछना लगवाते [हिजामा करवाते] तो उन बालों को बक़ीअ-उल-ग़रक़द के क़ब्रिस्तान की तरफ़ भेजते, फिर वह वहीं दफ़न किए जाते))।"
"69","[AI-translation] ((मोमिन ज़हीन, अक़्लमन्द और होशियार होता है))।"
"70","[AI-translation] ((ऐ लोगो! बेशक एक अज़ीम महीना तुम पर साया फ़िगन हुआ है, ऐसा महीना जिसमें एक रात है जो हज़ार महीनों [की इबादत] से बेहतर है। अल्लाह तआला ने उसका रोज़ा फ़र्ज़ किया है और उसकी रात की नमाज़ [यानी तरावीह] नफ़्ल। जो इसमें कोई नेकी करे वह ऐसा है जैसे किसी और महीने में फ़र्ज़ अदा किया, और जो इसमें फ़र्ज़ अदा करे वह ऐसा है जैसे किसी और महीने में सत्तर फ़र्ज़ अदा किए। यह सब्र का महीना है, और सब्र का बदला जन्नत है। यह हमदर्दी का महीना है, और यह वह महीना है जिसमें मोमिन का रिज़्क़ बढ़ा दिया जाता है। जो इसमें किसी रोज़ेदार को इफ़्तार कराए उसके गुनाह बख़्श दिए जाएँगे, उसकी गर्दन जहन्नम की आग से आज़ाद होगी, और उसे रोज़ेदार [जिसे खिलाया] के बराबर सवाब मिलेगा बग़ैर इसके कि रोज़ेदार के सवाब में कोई कमी हो। हमने कहा: ऐ अल्लाह के रसूल! हम सबके पास रोज़ेदार को इफ़्तार कराने का सामान नहीं। रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: अल्लाह तआला यह सवाब उसे देगा जो रोज़ेदार को दूध का एक घूँट, एक खजूर या पानी का एक घूँट इफ़्तार के लिए दे; और जो रोज़ेदार को पेट भर खाना खिलाकर सेर करे, अल्लाह तआला उसे मेरे हौज़ से पिलाएगा, जिसके बाद वह जन्नत में दाख़िल होने तक कभी प्यासा न होगा। यह वह महीना है जिसका अव्वल रहमत है, जिसका वस्त [दरमियान] मग़फ़िरत है और जिसका आख़िर जहन्नम की आग से आज़ादी है। और जो इस महीने में अपने मातहत [ग़ुलाम या नौकर] का बोझ हल्का करे, अल्लाह तआला उसे बख़्श देगा और जहन्नम की आग से आज़ाद करेगा))।"
"71","[AI-translation] ((ऐ जिब्रील! मुझे आग और जहन्नम का हाल बता))। जिब्रील (अलैहिस्सलाम) ने जवाब दिया: ((बेशक अल्लाह तबारक व तआला ने जहन्नम के बारे में हुक्म दिया तो उसे हज़ार साल तक दहकाया गया यहाँ तक कि वह सफ़ेद हो गई। फिर उसके बारे में हुक्म दिया तो उसे हज़ार साल और दहकाया गया यहाँ तक कि वह सुर्ख़ हो गई। फिर [तीसरी बार] उसके बारे में हुक्म दिया तो उसे हज़ार साल और दहकाया गया यहाँ तक कि वह काली हो गई; और अब उसका रंग निहायत काला और तारीक है))।"
"72","[AI-translation] ((अल्लाह के ज़िक्र के सिवा ज़्यादा बातें न करो, क्योंकि अल्लाह के ज़िक्र के बग़ैर ज़्यादा बातें दिल को सख़्त करती हैं; और अल्लाह से सबसे दूर वह शख़्स है जिसका दिल सख़्त है))।"
"73","[AI-translation] ((जब तुममें से कोई सफ़ तक पहुँचे और वह पूरी हो चुकी हो तो वह सफ़ में से एक आदमी को अपनी तरफ़ खींच ले और उसे अपने पहलू में खड़ा करे))।"
"74","[AI-translation] ((इस उम्मत में तीस अब्दाल होंगे, इब्राहीम ख़लील-उर-रहमान (अलैहिस्सलाम) की तरह। जब उनमें से एक मर्द वफ़ात पाएगा तो अल्लाह तबारक व तआला उसकी जगह दूसरा मर्द भेजेगा))।"
"75","[AI-translation] ((अबू बक्र (रज़ियल्लाहु अन्हु) तुम पर रोज़ों और नमाज़ों की कसरत से फ़ज़ीलत नहीं रखते, बल्कि उस चीज़ से जो उनके सीने में थी [यानी ईमान और तक़वा]))।"
"76","[AI-translation] ((बैत [अल्लाह के घर, मस्जिद-ए-हराम में दाख़िल होने वाले] का तहिय्या तवाफ़ ही है [यानी जो तवाफ़ के लिए मस्जिद-ए-हराम में दाख़िल हो उसे बैठने से पहले तहिय्यत-उल-मस्जिद पढ़ने की ज़रूरत नहीं]))।"
"77","[AI-translation] ((बेशक जब बन्दा नमाज़ में खड़ा होता है तो वह रहमान की दोनों आँखों के सामने होता है; और अगर वह इधर-उधर देखे तो रब उससे कहता है: ऐ आदम के बेटे! तू किसकी तरफ़ देखता है? क्या तू उससे बेहतर की तरफ़ देखता है जो तेरे लिए मुझसे बेहतर है? ऐ आदम के बेटे! अपनी नमाज़ की तरफ़ मुतवज्जेह हो, मैं तेरे लिए उससे बेहतर हूँ जिसकी तरफ़ तू देखता है))।"
"78","[AI-translation] मूसा (अलैहिस्सलाम) के दिल में ख़याल आया: क्या अल्लाह तआला भी सोता है? तो अल्लाह तआला ने उनकी तरफ़ एक फ़रिश्ता भेजा, जिसने उन्हें लगातार तीन दिन सुलाए रखा। फिर उसने उन्हें शीशे के दो बर्तन दिए, हर हाथ में एक बर्तन... फिर वह [मूसा] सो गए, उनके हाथ हिले और शीशे के दोनों बर्तन [गिरकर] टूट गए। नबी (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: अल्लाह तआला ने उन्हें यह मिसाल दी कि अगर अल्लाह तआला सोता तो आसमान और ज़मीन क़ायम न रहते [बल्कि गिर पड़ते]।"
"79","[AI-translation] (([ग़ैर-महरम की तरफ़ नज़र] इबलीस के तीरों में से एक तीर है; जो अल्लाह तआला के ख़ौफ़ से उसे छोड़ दे, अल्लाह तआला उसे ऐसा ईमान देगा जिसकी मिठास वह अपने दिल में पाएगा))।"
"80","[AI-translation] ((बहते हुए नकसीर की वजह से वुज़ू दोहराया जाएगा))।"
"81","[AI-translation] ((ईमान महज़ तमन्ना और ज़ीनत का नाम नहीं, बल्कि वह है जो दिल में उतर जाए और जिसकी सच्चाई की [मोमिन के किरदार और] अमल से तस्दीक़ हो))।"
"82","[AI-translation] ((एक जानवर निकलेगा जिसके पास मूसा (अलैहिस्सलाम) की लाठी और सुलैमान (अलैहिस्सलाम) की अँगूठी होगी, और वह कहेगा: यह मोमिन है! यह काफ़िर है))।"
"83","[AI-translation] ((नबी-ए-करीम (सल्लल्लाहु अलैहि वसल्लम) और हज़रत अबू बक्र (रज़ियल्लाहु अन्हु) ग़ार की तरफ़ गए और उसमें दाख़िल हुए। फिर मकड़ी आई और ग़ार के मुँह पर जाला बुन दिया। क़ुरैश के काफ़िर नबी-ए-करीम (सल्लल्लाहु अलैहि वसल्लम) को तलाश करते आए, और जब उन्होंने ग़ार के मुँह पर मकड़ी का जाला देखा तो कहा कि इसमें कोई दाख़िल नहीं हुआ))।"
"84","[AI-translation] नबी-ए-मुहम्मद (सल्लल्लाहु अलैहि वसल्लम) ने एक बू महसूस की और फ़रमाया: ((इस बू वाला शख़्स खड़ा हो और वुज़ू करे))। वह आदमी खड़े होने से शर्माया [इसलिए खड़ा न हुआ], तो रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने [फिर] फ़रमाया: ((इस बू वाला शख़्स खड़ा हो और वुज़ू करे, क्योंकि अल्लाह हक़ से नहीं शर्माता))। हज़रत अब्बास (रज़ियल्लाहु अन्हु) ने कहा: ऐ अल्लाह के रसूल! क्या हम सब खड़े होकर वुज़ू करें? नबी (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: (([हाँ] सब खड़े हो जाओ और वुज़ू करो))।"
"85","[AI-translation] ((जब मेरी उम्मत पन्द्रह ख़स्लतें अपनाएगी तो उस पर बला नाज़िल होगी। [वे ये हैं]: (1) जब माले-ग़नीमत को जाती जायदाद समझा जाए [यानी उसमें से कुछ को दिया जाए और कुछ को महरूम रखा जाए], (2) अमानतों को माले-ग़नीमत समझा जाए [यानी लोग अमानत के माल पर ऐसे क़ब्ज़ा करें जैसे वह जंगी लूट हो], (3) ज़कात को जुर्माना समझा जाए [यानी लोगों को अदा करना भारी लगे, उसे माल की पाकीज़गी या इलाही हुक्म न समझें बल्कि टैक्स या जुर्माना समझें], (4) हर मर्द अपनी बीवी की इताअत करे [हर हलाल और हराम में], (5) लेकिन अपनी माँ की नाफ़रमानी करे, (6) अपने दोस्त से अच्छा सुलूक करे [और उसे क़रीब करे], (7) लेकिन अपने बाप से बुरा सुलूक करे [और उसे दूर करे], (8) मस्जिदों में आवाज़ें बुलन्द हों [झगड़ों, तिजारत और फ़ुज़ूल बातों से], (9) क़ौम का सरदार और निगराँ [यानी उनका लीडर] उनमें सबसे ज़लील और कमीना हो, (10) किसी आदमी की इज़्ज़त उसके शर के डर से की जाए [ताकि उसका नुक़सान उन्हें न पहुँचे], (11) नशावर चीज़ें पी जाएँ, (12) [बिला-ज़रूरत] रेशम पहना जाए, (13) गाने-बजाने वाली औरतें अपनाई जाएँ, और (14) मूसिक़ी के आले हासिल किए जाएँ, (15) इस उम्मत के पिछले लोग अगले [यानी नेक पेशरौ] लोगों पर लानत करें —[यह भी बयान किया गया है कि नेक आमाल के बजाय वे नेक पेशरौ की पैरवी नहीं करेंगे, जो लानत करने के बराबर है]। जब उम्मत के लोग ये काम करने लगें तो वे सुर्ख़ आँधी, ज़मीन में धँसाए जाने और सूरतें बिगाड़ दिए जाने का इंतिज़ार करें, क्योंकि वे ज़रूर ऐसे अज़ाबों में मुब्तला होंगे))।"
"86","[AI-translation] ((दुनिया की मुहब्बत हर गुनाह की जड़ है))।"
