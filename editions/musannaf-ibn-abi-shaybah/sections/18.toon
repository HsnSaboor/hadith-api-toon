hadiths[count]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"17035","(۱۷۰۳۵) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ قَالَ : لاَ یَنْبَغِی لِلرَّجُلِ أَنْ یَجْمَعَ بَیْنَ امْرَأَۃٍ وَعَمَّتِہَا مِنَ الرَّضَاعَۃِ مِمَّا مَلَکَتِ الْیَمِینُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17035","","","كتاب النكاح"
"17036","(۱۷۰۳۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حُسَیْنٍ الْمُعَلِّمِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ یَوْمَ فَتَحَ مَکَّۃَ : لاَ تُنْکَحُ الْمَرْأَۃُ عَلَی عَمَّتِہَا وَلاَ عَلَی خَالَتِہَا۔\n(احمد ۲/۲۰۷۔ عبدالرزاق ۱۰۷۵۱)",": Hasan","Musannaf Ibn Abi Shaybah 17036","","","كتاب النكاح"
"17037","(۱۷۰۳۷) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ حَدَّثَنَا جَعْفَرِ بْنِ بُرْقَانَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تُزَوَّجَ الْمَرْأَۃُ عَلَی عَمَّتِہَا وَلاَ عَلَی خَالَتِہَا۔",": Da'if","Musannaf Ibn Abi Shaybah 17037","","","كتاب النكاح"
"17038","(۱۷۰۳۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ حُسَیْنٍ الْمُعَلِّمِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ أَنَّ رَجُلاً تَزَوَّجَ امْرَأَۃً عَلَی خَالَتِہَا فَضَرَبَہُ عُمَرُ وَفَرَّقَ بَیْنَہُمَا۔",": Hasan","Musannaf Ibn Abi Shaybah 17038","","","كتاب النكاح"
"17039","(۱۷۰۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مَعقِلٍ ، عَنْ عَطَائٍ وَیَزِیدُ بْنُ إِبراہِیم ، عَنِ الْحَسَنِ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تُنْکَحَ الْمَرْأَۃُ عَلَی عَمَّتِہَا ، أَوْ عَلَی خَالَتِہَا۔","","Musannaf Ibn Abi Shaybah 17039","","","كتاب النكاح"
"17040","(۱۷۰۴۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ عَطَائٍ قَالَ : یُکْرَہُ الْجَمْعُ بَیْنَ ابْنَتَیِ الْعَمِّ لِفَسَادٍ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 17040","","","كتاب النكاح"
"17041","(۱۷۰۴۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو أَنَّ الْحَسَنَ بْنَ مُحَمَّدٍ أَخْبَرَہُ أَنَّ ابْنًا لِعَلِیٍّ جَمَعَ بَیْنَ ابْنَتَی عَمٍّ لَہُ قَالَ : فَأُدْخِلَتَا عَلَیْہِ فِی لَیْلَۃٍ۔","","Musannaf Ibn Abi Shaybah 17041","","","كتاب النكاح"
"17042","(۱۷۰۴۲) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ، عَنْ عَمْرٍو، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَکْرَہُ أَنْ یُجْمَعَ بَیْنَ الْقَرَابَۃِ مِنْ أَجْلِ الْقَطِیعَۃِ۔","","Musannaf Ibn Abi Shaybah 17042","","","كتاب النكاح"
"17043","(۱۷۰۴۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرٍو ، عَنْ جَابِرِ بْنِ زَیْدٍ قَالَ : سُئِلَ : ہَلْ یَصْلُحُ لِلْمَرْأَۃِ أَنْ تُزَوَّجَ عَلَی ابْنَۃِ عَمِّہَا ؟ قَالَ : تِلْکَ الْقَطِیعَۃُ وَلاَ تَصْلُحُ الْقَطِیعَۃُ۔","","Musannaf Ibn Abi Shaybah 17043","","","كتاب النكاح"
"17044","(۱۷۰۴۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سُفْیَانَ حَدَّثَنِی خَالِدٌ الْفَأْفَاء ، عَنْ عِیسَی بْنِ طَلْحَۃَ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تُنْکَحَ الْمَرْأَۃُ عَلَی قَرَابَتِہَا مَخَافَۃَ الْقَطِیعَۃِ۔ (ابوداؤد ۲۰۸۔ عبدالرزاق ۱۰۷۶۷)","","Musannaf Ibn Abi Shaybah 17044","","","كتاب النكاح"
"17045","(۱۷۰۴۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، عَنْ أَبِیہِ أَنَّ سِبَاعَ بْنَ ثَابِتٍ تَزَوَّجَ ابْنَۃَ رَبَاحِ بْنِ وَہْبٍ وَلَہُ ابْنٌ مِنْ غَیْرِہَا وَلَہَا ابْنَۃٌ مِنْ غَیْرِہِ فَفَجَرَ الْغُلاَمُ بِالْجَارِیَۃِ فَظَہَرَ بِالْجَارِیَۃِ حَمْلٌ فَرُفِعَا إلَی عُمَرَ بْنِ الْخَطَّابِ فَاعْتَرَفَا فَجَلَدَہُمَا وَحَرَص أَنْ یُجْمَعَ بَیْنَہُمَا فَأَبَی الْغُلاَمُ۔",": Sahih","Musannaf Ibn Abi Shaybah 17045","","","كتاب النكاح"
"17046","(۱۷۰۴۶) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ فِی رَجُلٍ وَامْرَأَۃٍ أَصَابَ کُلُّ وَاحِدٍ مِنْہُمَا مِنَ الآخَرِ حَدًّا ثُمَّ أَرَادَ أَنْ یَتَزَوَّجَہَا ، قَالَ : لاَ بَأْسَ ، أَوَّلُہُ سِفَاحٌ وَآخِرُہُ نِکَاحٌ۔",": Hasan","Musannaf Ibn Abi Shaybah 17046","","","كتاب النكاح"
"17047","(۱۷۰۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ قَالَ : أَوَّلُہُ سِفَاحٌ وَآخِرُہُ نِکَاحٌ۔","","Musannaf Ibn Abi Shaybah 17047","","","كتاب النكاح"
"17048","(۱۷۰۴۸) حَدَّثَنَا وَکِیعٌ ، عَنِ أَبِی جُنَابٍ ، عَنْ بُکَیْرِ بْنِ الأَخْنَسِ ، عَنْ أَبِیہِ قَالَ : قرَأْت مِنَ اللَّیْلِ (حم عسق) فَمَرَرْت بِہَذِہِ الآیَۃِ : {وَہُوَ الَّذِی یَقْبَلُ التَّوْبَۃَ ، عَنْ عِبَادِہِ وَیَعْفُو ، عَنِ السَّیِّئَاتِ وَیَعْلَمُ مَا تَفْعَلُونَ} فَغَدَوْت إلَی عَبْدِ اللہِ أَسْأَلُہُ عَنْہَا فَأَتَاہُ رَجُلٌ فَسَأَلَہُ ، عَنِ الرَّجُلِ یَفْجُرُ بِالْمَرْأَۃِ ثُمَّ یَتَزَوَّجُہَا فَقَرَأَ عَبْدُ اللہِ : {وَہُوَ الَّذِی یَقْبَلُ التَّوْبَۃَ ، عَنْ عِبَادِہِ وَیَعْفُو ، عَنِ السَّیِّئَاتِ}۔",": Da'if","Musannaf Ibn Abi Shaybah 17048","","","كتاب النكاح"
"17049","(۱۷۰۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ عن عُرْوَۃَ بن عَبْدِ اللہِ بْنِ قُشَیرٍ ، عَنْ أَبِی الأَشْعَثِ ، عَنِ ابْنِ عُمَرَ قَالَ : أَوَّلُہُ سِفَاحٌ وَآخِرُہُ نِکَاحٌ أوَ أَوَّلُہُ حَرَامٌ وَآخِرُہُ حَلاَلٌ۔",": Hasan","Musannaf Ibn Abi Shaybah 17049","","","كتاب النكاح"
"17050","(۱۷۰۵۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ رَجُلاً فَجَرَ بِامْرَأَۃٍ وَہُمَا بِکْرَانِ فَجَلَدَہُمَا أَبُو بَکْرٍ وَنَفَاہُمَا ثُمَّ زَوَّجَہَا إیَّاہُ بَعْدَ الْحَوْلِ۔","","Musannaf Ibn Abi Shaybah 17050","","","كتاب النكاح"
"17051","(۱۷۰۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَام ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : لاَ بَأْسَ أَنْ یَتَزَوَّجَہَا۔","","Musannaf Ibn Abi Shaybah 17051","","","كتاب النكاح"
"17052","(۱۷۰۵۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ قَالَ : سَأَلَہُ رَجُلٌ ، عَنْ رَجُلٍ فَجَرَ بِامْرَأَۃٍ ، أَیَتَزَوَّجُہَا ؟ قَالَ : نَعَمْ ، وَتَلاَ ہَذِہِ الآیَۃَ : {وَہُوَ الَّذِی یَقْبَلُ التَّوْبَۃَ ، عَنْ عِبَادِہِ وَیَعْفُو ، عَنِ السَّیِّئَاتِ}۔","","Musannaf Ibn Abi Shaybah 17052","","","كتاب النكاح"
"17053","(۱۷۰۵۳) حَدَّثَنَا جَرِیرٌ ، عَنْ شَیْبَۃَ أَبِی نَعَامَۃَ قَالَ : سُئِلَ سَعِیدُ بْنُ جُبَیْرٍ وَأَنَا أَسْمَعُ ، عَنْ رَجُلٍ فَجَرَ بِامْرَأَۃٍ ، أَیَتَزَوَّجُہَا ؟ قَالَ : أَوَّلُہُ سِفَاحٌ وَآخِرُہُ نِکَاحٌ أَحَلَّہَا لَہُ مَالُہُ۔","","Musannaf Ibn Abi Shaybah 17053","","","كتاب النكاح"
"17054","(۱۷۰۵۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ جَابِرِ بْنِ زَیْدٍ قَالَ : سُئِلَ عَنِ الرَّجُلِ یَفْجُرُ بِالْمَرْأَۃِ ثُمَّ یَتَزَوَّجُہَا ، قَالَ : ہُوَ أَحَقُّ بِہَا ، ہُوَ أَفْسَدَہَا۔","","Musannaf Ibn Abi Shaybah 17054","","","كتاب النكاح"
"17055","(۱۷۰۵۵) حَدَّثَنَا وَکِیعٌ، عَنْ عُمَرَ بْنِ الْوَلِیدِ، عَنْ عِکْرِمَۃَ قَالَ: لاَ بَأْسَ ، ہُوَ بِمَنْزِلَۃِ رَجُلٍ سَرَقَ نَخْلَۃً ثُمَّ اشْتَرَاہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17055","","","كتاب النكاح"
"17056","(۱۷۰۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ حَسَّانَ ، قَالَ : سَمِعْتُ حَنْظَلَۃَ قَالَ : سَأَلْتُ سَالِمًا عَنْہُ ، فَقَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 17056","","","كتاب النكاح"
"17057","(۱۷۰۵۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ قَالَ : إذَا تَابَا وَأَصْلَحَا فَلاَ بَأْسَ بہ۔","","Musannaf Ibn Abi Shaybah 17057","","","كتاب النكاح"
"17058","(۱۷۰۵۸) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ دَاوُدَ ، عَنْ یَزِیدَ بْنِ أَبِی مَنْصُورٍ ، أَوِ ابْنِ مَنْصُورٍ ، عَنْ صِلَۃَ بْنِ أَشْیَمَ قَالَ : لاَ بَأْسَ إِنْ کَانَا تَائِبَیْنِ فَاللَّہُ أَوْلَی بِتَوْبَتِہِمَا ، وَإِنْ کَانَا زَانِیَیْنِ فَالْخَبِیثُ عَلَی الْخَبِیثِ۔","","Musannaf Ibn Abi Shaybah 17058","","","كتاب النكاح"
"17059","(۱۷۰۵۹) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ یَحْیَی بْنِ سَعِیدٍ قَالَ : بَلَغَنِی أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ سُئِلَ عَنِ امْرَأَۃٍ أَصَابَتْ خَطِیئَۃً ثُمَّ رُئِیَ مِنْہَا خَیْرًا ، أَیَنْکِحُہَا الرَّجُلُ ؟ فَقَالَ لَہُ عمر کَمَا بَلَغَنِی : أتظن أنی أنہاک ؟۔","","Musannaf Ibn Abi Shaybah 17059","","","كتاب النكاح"
"17060","(۱۷۰۶۰) حَدَّثَنَا سفیان بْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ قَالَ : سُئِلَ ابْنُ عَبَّاسٍ ، عَنْ رَجُلٍ زَنَی بِامْرَأَۃٍ فَأَرَادَ أَنْ یَتَزَوَّجَہَا ، قَالَ : الآنَ أَصَابَ الْحَلاَلَ۔",": Sahih","Musannaf Ibn Abi Shaybah 17060","","","كتاب النكاح"
"17061","(۱۷۰۶۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ قَالاَ : إذَا فَجَرَ الرَّجُلُ بِالْمَرْأَۃِ فَإِنَّہَا تَحِلُّ لَہُ۔","","Musannaf Ibn Abi Shaybah 17061","","","كتاب النكاح"
"17062","(۱۷۰۶۲) حَدَّثَنَا مُحَمَّدُ بْنُ بشر ، عَنْ سَعِیدٍ حَدَّثَنَا قَتَادَۃُ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ وَجَابِرِ بْنِ عَبْدِ اللہِ وسعید بْنِ جُبَیْرٍ فِی الرَّجُلِ یَفْجُرُ بِالْمَرْأَۃِ ثُمَّ یَتَزَوَّجُہَا قَالُوا : لاَ بَأْسَ بِذَلِکَ إذَا تَابَا وَأَصْلَحَا۔","","Musannaf Ibn Abi Shaybah 17062","","","كتاب النكاح"
"17063","(۱۷۰۶۳) حَدَّثَنَا مُحَمَّدُ بْنُ بشر قَالَ حَدَّثَنَا : سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ فِی الرَّجُلِ یَفْجُرُ بِالْمَرْأَۃِ ثُمَّ یَتَزَوَّجُہَا ، قَالَ : کَانَ أَوَّلَہُ سِفَاحٌ وَآخِرَہُ نِکَاحٌ ، أَوَّلُہُ حَرَامٌ وَآخِرُہُ حَلاَلٌ۔",": Sahih","Musannaf Ibn Abi Shaybah 17063","","","كتاب النكاح"
"17064","(۱۷۰۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عَمْرِو بْنِ مَرْوَانَ ، عَنْ عَبْدِ الرَّحْمَنِ الصُّدَائِیِّ ، عَنْ علِیٍّ قَالَ : جَائَ إلَیْہِ رَجُلٌ ، فَقَالَ : إنَّ لِی ابْنَۃَ عَمٍّ أَہْوَاہَا وَقَدْ کُنْت نِلْت مِنْہَا ، فَقَالَ : إِنْ کَانَ شَیْئًا بَاطِنًا یَعْنِی الْجِمَاعَ فَلاَ ، وَإِنْ کَانَ شَیْئًا ظَاہِرًا یَعْنِی الْقُبْلَۃَ فَلاَ بَأْسَ۔",": Da'if","Musannaf Ibn Abi Shaybah 17064","","","كتاب النكاح"
"17065","(۱۷۰۶۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ عن الحکم ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ قَالَ : لاَ یَزَالاَنِ زَانِیَیْنِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17065","","","كتاب النكاح"
"17066","(۱۷۰۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : قالَتْ عَائِشَۃُ : لاَ یَزَالاَنِ زَانِیَیْنِ مَا اصْطَحَبَا۔",": Sahih","Musannaf Ibn Abi Shaybah 17066","","","كتاب النكاح"
"17067","(۱۷۰۶۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ أَنَّہُ قَالَ : ہُمَا زَانِیَانِ ، لِیَجْعَلَ بَیْنَہُ وَبَیْنَہَا الْبَحْرُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17067","","","كتاب النكاح"
"17068","(۱۷۰۶۸) حَدَّثَنَا أَسْبَاطٌ ، عَنْ مُطَرِّفٍ ، عَنْ أَبِی الْجَہْمِ ، عَنِ الْبَرَائِ فِی الرَّجُلِ یَفْجُرُ بِالْمَرْأَۃِ ثُمَّ یَتَزَوَّجُہَا ، قَالَ : لاَ یَزَالاَنِ زَانِیَیْنِ أَبَدًا۔","","Musannaf Ibn Abi Shaybah 17068","","","كتاب النكاح"
"17069","(۱۷۰۶۹) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنْ عِیسَی بن حِطَّان ، عَنْ مُسْلِمِ بْنِ سَلاَّمٍ ، عَنْ عَلِیِّ بْنِ طَلْقٍ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إنَّ اللَّہَ لاَ یَسْتَحْیِی مِنَ الْحَقِّ ، لاَ تَأْتُوا النِّسَائَ فِی أَعْجَازِہِنَّ ، أَوْ قَالَ : فِی أَدْبَارِہِنَّ۔ (ترمذی ۱۱۶۶۔ دارمی ۱۱۴۱)",": Da'if","Musannaf Ibn Abi Shaybah 17069","","","كتاب النكاح"
"17070","(۱۷۰۷۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الضَّحَّاکِ بْنِ عُثْمَانَ ، عَنْ مَخْرَمَۃَ بْنِ سُلَیْمَانَ ، عَنْ کُرَیْبٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ یَنْظُرُ اللَّہُ إلَی رَجُلٍ أَتَی رَجُلاً ، أَوِ امْرَأَۃً فِی دُبُرِہَا۔\n(ترمذی ۱۱۶۵۔ ابن حبان ۴۴۱۸)",": Hasan","Musannaf Ibn Abi Shaybah 17070","","","كتاب النكاح"
"17071","(۱۷۰۷۱) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تُؤْتَی النِّسَائُ فِی أَعْجَازِہِنَّ وَقَالَ : إنَّ اللَّہَ لاَ یَسْتَحْیِی مِنَ الْحَقِّ۔",": Da'if","Musannaf Ibn Abi Shaybah 17071","","","كتاب النكاح"
"17072","(۱۷۰۷۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی أَیُّوبَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرو قَالَ : ہِیَ اللُّوطِیَّۃُ الصُّغْرَی۔ (نسائی ۸۹۹۷)",": Sahih","Musannaf Ibn Abi Shaybah 17072","","","كتاب النكاح"
"17073","(۱۷۰۷۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عُقْبَۃَ بْنِ وَسَّاجٍ ، قَالَ : قَالَ أَبُو الدَّرْدَائِ : وَہَلْ یَفْعَلُ ذَلِکَ إلاَّ کَافِرٌ۔",": Sahih","Musannaf Ibn Abi Shaybah 17073","","","كتاب النكاح"
"17074","(۱۷۰۷۴) حَدَّثَنَا وَکِیعٌ، عَنْ ہَمَّامِ، عَنْ قَتَادَۃَ، عَنْ عُقْبَۃَ بن وساج، عَنْ أَبِی الدَّرْدَائِ قَالَ: وَہَلْ یَفْعَلُ ذَلِکَ إلاَّ کَافِرٌ۔",": Sahih","Musannaf Ibn Abi Shaybah 17074","","","كتاب النكاح"
"17075","(۱۷۰۷۵) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن أَبِی عَبْدِ اللہِ الشَّقَرِیِّ ، عَنْ أَبِی الْقَعْقَاعِ ، عَنِ ابْنِ مَسْعُودٍ قَالَ : مَحَاشُّ النِّسَائِ عَلَیْکُمْ حَرَامٌ۔",": Da'if","Musannaf Ibn Abi Shaybah 17075","","","كتاب النكاح"
"17076","(۱۷۰۷۶) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : مَنْ أَتَاہُ مِنَ الرِّجَالِ وَالنِّسَائِ فَقَدْ کَفَرَ۔",": Da'if","Musannaf Ibn Abi Shaybah 17076","","","كتاب النكاح"
"17077","(۱۷۰۷۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَکِیمٍ الأَثْرَمِ ، عَنْ أَبِی تَمِیمَۃَ الْہُجَیْمِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : مَنْ أَتَی حَائِضًا ، أَوِ امْرَأَۃً فِی دُبُرِہَا فَقَدْ کَفَرَ بِمَا أُنْزِلَ عَلَی مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ۔\n(ابوداؤد ۳۸۹۹۔ دارمی ۱۱۳۶)","","Musannaf Ibn Abi Shaybah 17077","","","كتاب النكاح"
"17078","(۱۷۰۷۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْوَلِیدِ بْنِ کَثِیرٍ قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عَبْدِ اللہِ بْنِ الْحُصَیْنِ الْخَطْمِیِّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ قَیْسٍ الْخَطْمِیِّ ، عَنْ ہَرَمِی بْنِ عَبْدِ اللہِ ، قَالَ : سَمِعْتُ خُزَیْمَۃَ بْنَ ثَابِتٍ یَقُولُ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إنَّ اللَّہَ لاَ یَسْتَحْیِی مِنَ الْحَقِّ ، لاَ تَأْتُوا النِّسَائَ فِی أعجازہن۔\n(طبرانی ۳۷۴۰۔ بیہقی ۱۹۶)",": Da'if","Musannaf Ibn Abi Shaybah 17078","","","كتاب النكاح"
"17079","(۱۷۰۷۹) حَدَّثَنَا أَحْمَدُ بْنُ إِسْحَاقَ ، عَنْ وُہَیب ، عَنْ سُہَیْلِ بْنِ أَبِی صَالِحٍ ، عَنِ الْحَارِثِ بْنِ مُخَلَّدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَنْظُرُ اللَّہُ إلَی رَجُلٍ جَامَعَ امْرَأَۃً فِی دُبُرِہَا۔\n(ابوداؤد ۲۱۵۵۔ ابن ماجہ ۱۹۲۳)",": Hasan","Musannaf Ibn Abi Shaybah 17079","","","كتاب النكاح"
"17080","(۱۷۰۸۰) حَدَّثَنَا ابْنُ نُمَیْرٍ قَالَ : حَدَّثَنَا الصَّلْتُ بْنِ بَہْرَامَ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنِ مَسْعُودٍ ، عَنْ أَبِی الْمُعْتَمِرِ ، أَوْ أَبِی الْجُوَیْرِیَۃِ قَالَ : نَادَی عَلِیٌّ عَلَی الْمِنْبَرِ ، فَقَالَ : سَلُونِی سَلُونِی ، فَقَالَ رَجُلٌ : أَتُؤْتَی النِّسَائُ فِی أَدْبَارِہِنَّ ؟ فَقَالَ : سَفَلْتَ سَفَّلَ اللَّہُ بِکَ ، أَلَمْ تَرَ أَنَّ اللَّہَ تَعَالَی یَقُولُ : {أَتَأْتُونَ الْفَاحِشَۃَ} الآیَۃَ۔",": Da'if","Musannaf Ibn Abi Shaybah 17080","","","كتاب النكاح"
"17081","(۱۷۰۸۱) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ قَالَتْ : کَانَتْ إحْدَانَا إذَا کَانَتْ حَائِضًا أَمَرَہَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تَتَّزِرَ بِإِزَارٍ ثُمَّ یُبَاشِرُہَا۔ (بخاری ۳۰۰۔ مسلم ۲۴۲)",": Sahih","Musannaf Ibn Abi Shaybah 17081","","","كتاب النكاح"
"17082","(۱۷۰۸۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ قَالَتْ : کَانَتْ إحْدَانَا إذَا کَانَتْ حَائِضًا أَمَرَہَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تَأْتَزِرَ فِی فور حَیْضَتِہَا ثُمَّ یُبَاشِرُہَا ، وَأَیُّکُمْ یَمْلِکُ إرْبَہُ کَمَا کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَمْلِکُ إرْبَہُ۔ (بخاری ۳۰۲۔ مسلم ۲)",": Sahih","Musannaf Ibn Abi Shaybah 17082","","","كتاب النكاح"
"17083","(۱۷۰۸۳) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، وَعَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ قَالَ : أَخْبَرَتْنِی مَیْمُونَۃُ زَوْجُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ النَّبِیِّ بِنَحْوٍ مِنْہُ۔ (بخاری ۳۰۳۔ احمد ۶/۳۳۶)",": Sahih","Musannaf Ibn Abi Shaybah 17083","","","كتاب النكاح"
"17084","(۱۷۰۸۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عَبْدَۃَ أَنَّ أُمَّ سَلَمَۃَ قَالَتْ : نُفِسْتُ وَأَنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَعْنِی حِضْتُ فِی فِرَاشِی فَذَہَبْتُ لأَتَأَخَّرَ ، فَقَالَ : مَکَانَکِ إِنَّما کَانَ یَکْفِیکِ أَنْ تَجْعَلِی عَلَیْکِ ثَوْبًا۔\n(طبرانی ۱۱۶۰۲)","","Musannaf Ibn Abi Shaybah 17084","","","كتاب النكاح"
"17085","(۱۷۰۸۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ خَالِدٍ، عَنْ عِکْرِمَۃَ، عَنْ أُمِّ سَلَمَۃَ فِی مُضَاجَعَۃِ الْحَائِضِ: إذَا کَانَ عَلَی فَرْجِہَا خِرْقَۃٌ۔",": Sahih","Musannaf Ibn Abi Shaybah 17085","","","كتاب النكاح"
"17086","(۱۷۰۸۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، عَنْ عَلِیٍّ قَالَ : مَا فَوْقَ الإِزَارِ۔","","Musannaf Ibn Abi Shaybah 17086","","","كتاب النكاح"
"17087","(۱۷۰۸۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَا فَوْقَ الإِزَارِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17087","","","كتاب النكاح"
"17088","(۱۷۰۸۸) حَدَّثَنَا جریر، عَنْ یَزِید، قَالَ: سَمِعْتُ سَعِیدَ بْنَ جُبَیْرٍ یَقُولُ: لَکَ مَا فَوْقَ الإِزَارِ وَلاَ تَطَّلِعْ عَلَی مَا تَحْتَہُ۔","","Musannaf Ibn Abi Shaybah 17088","","","كتاب النكاح"
"17089","(۱۷۰۸۹) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَوْزَاعِیِّ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، عَنْ عَائِشَۃَ أَنَّہَا سُئِلَتْ : مَا لِلرَّجُلِ مِنِ امْرَأَتِہِ وَہِیَ حَائِضٌ ؟ قَالَتْ : مَا فَوْقَ الإِزَارِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17089","","","كتاب النكاح"
"17090","(۱۷۰۹۰) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ قَالَ : إذَا ألقت عَلَی فَرْجِہَا خِرْقَۃً فَیُبَاشِرُہَا۔","","Musannaf Ibn Abi Shaybah 17090","","","كتاب النكاح"
"17091","(۱۷۰۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّیْبَانِیِّ قَالَ : إذَا کَفَّتِ الْحَائِضَۃُ عَنْہَا الأَذَی فَاصْنَعْ بِہَا مَا شِئْتَ۔","","Musannaf Ibn Abi Shaybah 17091","","","كتاب النكاح"
"17092","(۱۷۰۹۲) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ قَالَ : یَأْتِیہَا مَا أخطأ الدَّمُ۔","","Musannaf Ibn Abi Shaybah 17092","","","كتاب النكاح"
"17093","(۱۷۰۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرِ بْنِ حَبِیبٍ الْجَرْمِیِّ قَالَ : سَأَلْتُ أَبَا قِلاَبَۃَ : مَا لِلرَّجُلِ مِنِ امْرَأَتِہِ وَہِیَ حَائِضٌ؟ قَالَ : یَذْکُرُونَ مَا فَوْقَ الإِزَارِ۔","","Musannaf Ibn Abi Shaybah 17093","","","كتاب النكاح"
"17094","(۱۷۰۹۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الصَّلْتِ بْنِ بَہْرَامَ ، عَنْ إبْرَاہِیمَ قَالَ : لَکَ مَا فَوْقَ الإِزَارِ۔","","Musannaf Ibn Abi Shaybah 17094","","","كتاب النكاح"
"17095","(۱۷۰۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی مَکِینٍ ، عَنْ عِکْرِمَۃَ قَالَ : مَا فَوْقَ الإِزَارِ۔","","Musannaf Ibn Abi Shaybah 17095","","","كتاب النكاح"
"17096","(۱۷۰۹۶) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ أَنَّہُ سَمِعَ رَجُلاً یَسْأَلُ سَعِیدَ بْنَ الْمُسَیَّبِ ، فَقَالَ : أُبَاشِرُ امْرَأَتِی وَہِیَ حَائِضٌ ؟ قَالَ : اجْعَلْ بَیْنَکَ وَبَیْنَ ذَلِکَ مِنْہَا ثَوْبًا ثُمَّ بَاشِرْہَا۔","","Musannaf Ibn Abi Shaybah 17096","","","كتاب النكاح"
"17097","(۱۷۰۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ غَیْلاَنَ ، عَنِ الْحَکَمِ قَالَ : لاَ بَأْسَ أَنْ یَضَعَہُ عَلَی الْفَرْجِ وَلاَ یدْخِلْہُ۔","","Musannaf Ibn Abi Shaybah 17097","","","كتاب النكاح"
"17098","(۱۷۰۹۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ شَیْبَۃَ بْنِ ہِشَامٍ الرَّاسِبِیِّ قَالَ : سَأَلْتُ سَالِمًا ، عَنِ الرَّجُلِ یُضَاجِعُ امْرَأَتَہُ وَہِیَ حَائِضٌ ، فَقَالَ : أَمَّا نَحْنُ آلَ عُمَرَ فَنَعْزِلُہُنَّ۔","","Musannaf Ibn Abi Shaybah 17098","","","كتاب النكاح"
"17099","(۱۷۰۹۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالَ : مَا فَوْقَ الإِزَارِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17099","","","كتاب النكاح"
"17100","(۱۷۱۰۰) حَدَّثَنَا أَسْبَاطٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبِیْدَۃَ ، فِی الْحَائِضِ : لَکَ مَا فَوْقَ الإِزَارِ۔","","Musannaf Ibn Abi Shaybah 17100","","","كتاب النكاح"
"17101","(۱۷۱۰۱) حَدَّثَنَا شَبَابَۃُ ، عَنْ لَیْثِ بْنِ سَعْدٍ ، عَنِ ابْنِ شِہَابٍ ، عَنْ حَبِیبٍ مَوْلَی عُرْوَۃَ ، عَنْ نَدْبَۃَ مَوْلاَۃِ مَیْمُونَۃَ ، عَنْ مَیْمُونَۃَ زَوْجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُبَاشِرُ الْمَرْأَۃَ مِنْ نِسَائِہِ وَہِیَ حَائِضٌ إذَا کَانَ عَلَیْہَا إزَارٌ یَبْلُغُ أَنْصَافَ الْفَخِذَیْنِ ، أَوِ الرُّکْبَتَیْنِ مُحْتَجِرَۃً بِہِ۔\n(ابوداؤد ۲۷۱۔ احمد ۶/۳۳۶)",": Da'if","Musannaf Ibn Abi Shaybah 17101","","","كتاب النكاح"
"17102","(۱۷۱۰۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ قَالَ : لاَ بَأْسَ أنْ یَلعَب عَلَی بَطْنِہَا وَبَیْنَ فَخِذَیْہَا۔","","Musannaf Ibn Abi Shaybah 17102","","","كتاب النكاح"
"17103","(۱۷۱۰۳) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ طَارِقٍ ، عَنْ عَاصِمِ بْنِ عَمْرٍو الْبَجَلِیِّ قَالَ : خَرَجَ نَاسٌ مِنْ أَہْلِ الْعِرَاقِ فَلَمَّا قَدِمُوا عَلَی عُمَرَ قَالَ لَہُمْ : مِمَّنْ أَنْتُمْ ؟ قَالُوا : مِنْ أَہْلِ الْعِرَاقِ ، قَالَ : فَبِإِذْنٍ جِئْتُمْ ؟ قَالُوا ، نَعَمْ ، فَسَأَلُوہ عَمَّا یَحِلُّ لِلرَّجُلِ مِنِ امْرَأَتِہِ وَہِیَ حَائِضٌ ، فَقَالَ : سَأَلْتُمُونِی ، عَنْ خِصَالٍ مَا سَأَلَنِی عنہن أَحَدٌ بَعْدَ أَنْ سَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : أَمَّا مَا لِلرَّجُلِ مِنِ امْرَأَتِہِ وَہِیَ حَائِضٌ فَلَہُ مَا فَوْقَ الإِزَارِ۔","","Musannaf Ibn Abi Shaybah 17103","","","كتاب النكاح"
"17104","(۱۷۱۰۴) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یَقُولُ : إنِّی فِیک لرَاغِبٌ وَإِنِّی أُرِیدُ امْرَأَۃً أَمْرُہَا کَذَا وَکَذَا وَیُعَرِّضُ لَہَا بِالْقَوْلِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17104","","","كتاب النكاح"
"17105","(۱۷۱۰۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ فِی قَوْلِہِ : {وَلاَ جُنَاحَ عَلَیْکُمْ فِیمَا عَرَّضْتُمْ بِہِ مِنْ خِطْبَۃِ النِّسَائِ} قَالَ یَقُولُ : إنَّک جَمِیلَۃٌ وَإِنَّک لَنَافِقَۃٌ إنَّک إلَی خَیْرٍ ، وَیُکْرَہُ أَنْ یَقُولَ : لاَ تَفُوتِینِی بِنَفْسِکِ وَإِنِّی عَلَیْکِ لَحَرِیصٌ۔","","Musannaf Ibn Abi Shaybah 17105","","","كتاب النكاح"
"17106","(۱۷۱۰۶) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِذَلِکَ کُلِّہِ۔","","Musannaf Ibn Abi Shaybah 17106","","","كتاب النكاح"
"17107","(۱۷۱۰۷) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ قَالَ : کَانَ یُکْرَہُ أَنْ یَقُولَ : إذَا انْقَضَتْ عِدَّتُہَا تَزَوَّجْتُکِ وَیَقُولُ مَا شَائَ۔","","Musannaf Ibn Abi Shaybah 17107","","","كتاب النكاح"
"17108","(۱۷۱۰۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالَ : یَقُولُ : إنِّی بِکِ لَمُعْجَبٌ وَإِنِّی فِیک لَرَاغِبٌ فَلاَ تَفُوتِینَا بِنَفْسِک۔","","Musannaf Ibn Abi Shaybah 17108","","","كتاب النكاح"
"17109","(۱۷۱۰۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ قَالَ : یَقُولُ : إنَّک لَجَمِیلَۃٌ وَإِنَّک لَنَافِقَۃٌ وَإِنَّک لإِلَی خَیْرٍ۔","","Musannaf Ibn Abi Shaybah 17109","","","كتاب النكاح"
"17110","(۱۷۱۱۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ فِی الْمَرْأَۃِ یُتَوَفَّی عَنْہَا زَوْجُہَا فَیُرِیدُ الرَّجُلُ خِطْبَتَہَا وَکَلاَمَہَا قَالَ : یَقُولُ : إنِّی بِکِ لَمُعْجَبٌ وَإِنِّی فِیکِ لَرَاغِبٌ وَإِنِّی عَلَیْکِ لَحَرِیصٌ وَأَشْبَاہَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 17110","","","كتاب النكاح"
"17111","(۱۷۱۱۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبِیْدَۃَ فِی قَوْلِہِ : {وَلاَ جُنَاحَ عَلَیْکُمْ فِیمَا عَرَّضْتُمْ بِہِ مِنْ خِطْبَۃِ النِّسَائِ} قَالَ : یَذْکُرُہَا إلَی وَلِیِّہَا وَلاَ یُشْعِرنَہَا۔","","Musannaf Ibn Abi Shaybah 17111","","","كتاب النكاح"
"17112","(۱۷۱۱۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لِفَاطِمَۃَ بِنْتِ قَیْسٍ : انْتَقِلِی إلَی أُمِّ شَرِیکٍ وَلاَ تَفُوتِینَا بِنَفْسِکِ۔ (مسلم ۳۹۔ ابوداؤد ۲۲۸۱)","","Musannaf Ibn Abi Shaybah 17112","","","كتاب النكاح"
"17113","(۱۷۱۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ ، عَنْ مُسْلِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ {إلاَّ أَنْ تَقُولُوا قَوْلاً مَعْرُوفًا} قَالَ : یقول : إنِّی فِیک لَرَاغِبٌ وَإِنِّی لأَرْجُو أَنْ یَجْمَعَ اللَّہُ بَیْنَکِ وَبَیْنِی۔","","Musannaf Ibn Abi Shaybah 17113","","","كتاب النكاح"
"17114","(۱۷۱۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ قَالَ : یَقُولُ : إنَّک لَجَمِیلَۃٌ وَإِنَّک لَنَافِقَۃٌ ، وَإِنْ قَضَی اللَّہُ أَمْرًا کَانَ۔","","Musannaf Ibn Abi Shaybah 17114","","","كتاب النكاح"
"17115","(۱۷۱۱۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ عن إبراہیم قَالَ : لاَ بَأْسَ بالہدیۃ فِی تَعْرِیضِ النِّکَاحِ۔","","Musannaf Ibn Abi Shaybah 17115","","","كتاب النكاح"
"17116","(۱۷۱۱۶) حَدَّثَنَا مُحَمَّدُ بْنُ بشر ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لَفَاطِمَۃَ : لاَ تَفُوتِینَا بِنَفْسِکِ۔","","Musannaf Ibn Abi Shaybah 17116","","","كتاب النكاح"
"17117","(۱۷۱۱۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ {وَلاَ جُنَاحَ عَلَیْکُمْ فِیمَا عَرَّضْتُمْ بِہِ مِنْ خِطْبَۃِ النِّسَائِ} قَالَ : یَعْرِضُ الرَّجُلُ فَیَقُولُ : إنِّی أُرِیدُ أَنْ أَتَزَوَّجَ ، وَلاَ یَنْصِبْ فِی الْخِطْبَۃِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17117","","","كتاب النكاح"
"17118","(۱۷۱۱۸) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ عَمَّارِ بْنِ رُزَیْقٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ فِی قَوْلِہِ : {وَلاَ جُنَاحَ عَلَیْکُمْ فِیمَا عَرَّضْتُمْ بِہِ مِنْ خِطْبَۃِ النِّسَائِ} قَالَ : یَقُولُ ، إنِّی فِیکِ لَرَاغِبٌ وَلَوَدِدْتُ أَنِّی تَزَوَّجْتُکِ حَتَّی یُعْلِمَہَا إِنَّہُ یُرِیدُ تَزْوِیجَہَا مِنْ غَیْرِ أَنْ یُوجِبَ عُقْدَۃً ، أَوْ یُعَاہِدَہَا عَلَی عَہْدٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 17118","","","كتاب النكاح"
"17119","(۱۷۱۱۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ قَالَ : تَلاَ ہَذِہِ الآیَۃَ {وَلاَ جُنَاحَ عَلَیْکُمْ فِیمَا عَرَّضْتُمْ بِہِ مِنْ خِطْبَۃِ النِّسَائِ} قَالَ : یَقُولُ فِی الْعِدَّۃِ : إنِّی عَلَیْکِ لَحَرِیصٌ وَإِنِّی فِیکِ لَرَاغِبٌ وَنَحْوَ ہَذَا۔","","Musannaf Ibn Abi Shaybah 17119","","","كتاب النكاح"
"17120","(۱۷۱۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ : { وَلاَ جُنَاحَ عَلَیْکُمْ فِیمَا عَرَّضْتُمْ بِہِ مِنْ خِطْبَۃِ النِّسَائِ} قَالَ : یَقُولُ : إنَّکِ لَجَمِیلَۃٌ وَإِنَّکِ لَنَافِقَۃٌ ، وَإِنْ قَضَی اللَّہُ شَیْئًا کَانَ۔","","Musannaf Ibn Abi Shaybah 17120","","","كتاب النكاح"
"17121","(۱۷۱۲۱) حَدَّثَنَا شَبَابَۃُ ، عَنْ وَرْقَائَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ : {فِیمَا عَرَّضْتُمْ بِہِ مِنْ خِطْبَۃِ النِّسَائِ} قَالَ: قَوْلُ الرَّجُلِ لِلْمَرْأَۃِ : إنَّکِ لَجَمِیلَۃٌ وَإِنَّکِ لَنَافِقَۃٌ وَإِنَّکِ لإِلَی خَیْرٍ ، وَلْیَکُنْ ذِکْرُ خِطْبَتِہَا فِی نَفْسِہِ ، لاَ یُبْدِیہِ لَہَا ، ہَذَا کُلُّہُ حِلٌّ مَعْرُوفٌ۔","","Musannaf Ibn Abi Shaybah 17121","","","كتاب النكاح"
"17122","(۱۷۱۲۲) حَدَّثَنَا شَرِیکٌ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ أَبِی الضُّحَی فِی قَوْلِہِ : {إلاَّ أَنْ تَقُولُوا قَوْلاً مَعْرُوفًا} قَالَ : یَقُولُ : إنِّی لأَشْتَہِیکِ۔","","Musannaf Ibn Abi Shaybah 17122","","","كتاب النكاح"
"17123","(۱۷۱۲۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنْ عَبْدِ اللہِ بْنِ قَیْسٍ أَنَّ غُلاَمًا لأَبِی مُوسَی ، وَکَانَ صَاحِبَ إبِلِہِ تَزَوَّجَ أَمَۃً لِبَنِی جَعْدَۃَ وَسَاقَ إلَیْہَا خَمْسَ ذَوْدٍ فَحُدِّثَ أَبُو مُوسَی فَأَرْسَلَ إلَیْہِمْ: أَرْسِلُوا إلَیَّ غُلاَمِی وَمَالِی، فَقَالُوا : أَمَّا الْغُلاَمُ فَغُلاَمُکَ ، وَأَمَّا الْمَالُ فَقَدِ اسْتَحَلَّ بِہِ فَرْجَ صَاحِبَتِنَا فَاخْتَصَمُوا إلَی عُثْمَانَ بْنِ عَفَّانَ فَقَضَی لَہُمْ عُثْمَانُ بِخُمُسَی مَا اسْتَحَلَّ بِہِ فَرْجَ صَاحِبَتِہِمْ وَرَدَّ عَلَی أَبِی مُوسَی ثَلاَثَۃَ أَخْمَاسِہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17123","","","كتاب النكاح"
"17124","(۱۷۱۲۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ قَالَ : تَزَوَّجَ عَبْدٌ لأَبِی مُوسَی فِی إمْرَۃِ ع??مَرَ عَلَی خَمْسِ قَلاَئِصَ فَرُفِعَ ذَلِکَ إلَی عُمَرَ فَجَعَلَ لِلْمَرْأَۃِ قَلُوصَیْنِ وَِلأَبِی مُوسَی ثَلاَثَ قَلاَئِصَ ، أَوْ أَعْطَاہَا ثَلاَثَ قَلاَئِصَ وَرَدَّ عَلَی أَبِی مُوسَی قَلُوصَیْنِ قَالَ : أُرَاہُ تَزَوَّجَ بِغَیْرِ إذْنِہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 17124","","","كتاب النكاح"
"17125","(۱۷۱۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ تَمَّامٍ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عُمَرَ قَالَ : لاَ صَدَاقَ لَہَا ، ہِیَ أَبَاحَتْ فَرْجَہَا۔",": Da'if","Musannaf Ibn Abi Shaybah 17125","","","كتاب النكاح"
"17126","(۱۷۱۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ فِرَاسٍ ، عَنْ عَامِرٍ قَالَ : یَأْخُذُ مِنْہَا مَا اسْتَہْلَکَتْ ، وَمَا لَمْ تَسْتَہْلِکْ۔","","Musannaf Ibn Abi Shaybah 17126","","","كتاب النكاح"
"17127","(۱۷۱۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : یُؤْخَذُ مِنْہَا مَا لَمْ تَسْتَہْلِکْ ، فَأَمَّا مَا اسْتَہْلَکَتْ فَلاَ شَیْئَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17127","","","كتاب النكاح"
"17128","(۱۷۱۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا ، عَنِ الْعَبْدِ یَتَزَوَّجُ الْمَرْأَۃَ بِغَیْرِ إذْنِ مَوَالِیہِ ، قَالَ: یُفَرَّقُ بَیْنَہُمَا وَلاَ صَدَاقَ لَہَا ، یُؤْخَذُ مِنْہَا مَا أَخَذَتْ۔","","Musannaf Ibn Abi Shaybah 17128","","","كتاب النكاح"
"17129","(۱۷۱۲۹) حَدَّثَنَا غُنْدَرٌ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ؛ فِی مَمْلُوکٍ تَزَوَّجَ بِغَیْرِ إذْنِ سَیِّدِہِ فَدَخَلَ بِہَا قَالَ لَہَا مَا أَخَذَتْ۔","","Musannaf Ibn Abi Shaybah 17129","","","كتاب النكاح"
"17130","(۱۷۱۳۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ فِی الْعَبْدِ إذَا تَزَوَّجَ بِغَیْرِ إذْنِ سَیِّدِہِ فَلَیْسَ بِنِکَاحٍ وَلَیْسَ لَہَا بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 17130","","","كتاب النكاح"
"17131","(۱۷۱۳۱) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ فِی عَبْدٍ تَزَوَّجَ بِغَیْرِ إذْنِ مَوْلاَہُ وَسَاقَ صَدَاقًا ، قَالَ: إِنْ کَانَ دَخَلَ بِہَا فَلَہَا الصَّدَاقُ ، وَإِنْ لَمْ یَدْخُلْ بِہَا أَخَذَ الْمَوْلَی الصَّدَاقَ۔","","Musannaf Ibn Abi Shaybah 17131","","","كتاب النكاح"
"17132","(۱۷۱۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ جَابِرٍ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : أَیُّمَا عَبْدٍ تَزَوَّجَ بِغَیْرِ إذْنِ مَوْلاَہُ فَہُوَ عَاہِرٌ۔ (ابوداؤد ۲۰۸۰۔ احمد ۳۷۷)",": Da'if","Musannaf Ibn Abi Shaybah 17132","","","كتاب النكاح"
"17133","(۱۷۱۳۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا ہَمَّامٌ قَالَ حَدَّثَنَا الْقَاسِمُ بْنُ عَبْدِ الْوَاحِدِ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ جَابِرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : أَیُّمَا عَبْدٍ تَزَوَّجَ أو قَالَ : نکح بِغَیْرِ إذْنِ أَہْلِہِ فَہُوَ عَاہِرٌ۔ (حاکم ۱۹۴۔ احمد ۳/۳۸۲)",": Da'if","Musannaf Ibn Abi Shaybah 17133","","","كتاب النكاح"
"17134","(۱۷۱۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : نِکَاحُ الْعَبْدِ بِغَیْرِ إذْنِ سَیِّدِہِ زِنًا ، وَیُعَاقَبُ الَّذِی زَوَّجَہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 17134","","","كتاب النكاح"
"17135","(۱۷۱۳۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا سَعِیدُ بْنُ أَبِی عَرُوبَۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ أَنَّہُ کَانَ إذَا تَزَوَّجَ عَبْدُہُ بِغَیْرِ إذْنٍ ضَرَبَہُ الْحَدَّ۔",": Sahih","Musannaf Ibn Abi Shaybah 17135","","","كتاب النكاح"
"17136","(۱۷۱۳۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْجَرِیرِیِّ قَالَ : سَأَلْتُ غُنَیْمَ بْنَ قَیْسٍ ، قُلْتُ : الْعَبْدُ یَتَزَوَّجُ بِغَیْرِ إذْنِ سَیِّدِہِ ، أَزَانٍ ہُوَ ؟ قَالَ : قَدْ عَصَی ، قُلْتُ : أَزَانٍ ہُوَ ؟ قَالَ : قَدْ عَصَی۔",": No Data Available","Musannaf Ibn Abi Shaybah 17136","","","كتاب النكاح"
"17137","(۱۷۱۳۷) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ فِی الْعَبْدِ یَتَزَوَّجُ بِغَیْرِ إذْنِ مَوْلاَہُ ، قَالَ : قدْ کَانَ فِی شَیْئٍ فَسَلُوا عَنْہُ۔","","Musannaf Ibn Abi Shaybah 17137","","","كتاب النكاح"
"17138","(۱۷۱۳۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ عُثْمَانَ بْنِ غِیَاثٍ قَالَ : لاَ یَتَزَوَّجُ الْعَبْدُ إلاَّ بِإِذْنِ مَوْلاَہُ۔","","Musannaf Ibn Abi Shaybah 17138","","","كتاب النكاح"
"17139","(۱۷۱۳۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنِ الشَّعْبِیِّ فِی قَوْلِہِ : {وَلَکِنْ لاَ تُوَاعِدُوہُنَّ سِرًّا} قَالَ : لاَ یَأْخُذُ عَلَیْہَا عَہْدًا وَلاَ مِیثَاقًا أَلاَّ تَزَوَّجَ غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 17139","","","كتاب النكاح"
"17140","(۱۷۱۴۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ فِی قَوْلِہِ : {وَلَکِنْ لاَ تُوَاعِدُوہُنَّ سِرًّا} یَخْطُبُہَا فِی عِدَّتِہَا۔","","Musannaf Ibn Abi Shaybah 17140","","","كتاب النكاح"
"17141","(۱۷۱۴۱) حَدَّثَنَا عبد الوہاب الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ مُحَمَّدٍ قَالَ : {وَلَکِنْ لاَ تُوَاعِدُوہُنَّ سِرًّا} قَالَ : یَلْقَی الْوَلِیَّ فَیَذْکُرُ رَغْبَۃً وَحِرْصًا۔","","Musannaf Ibn Abi Shaybah 17141","","","كتاب النكاح"
"17142","(۱۷۱۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ مُسْلِمٍ الْبَطِینِ ، عَنْ سَعِیدٍ قَالَ : لاَ یُقَاضِیہَا فی الْعِدَّۃِ أَنْ لاَ تَزَوَّجَ غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 17142","","","كتاب النكاح"
"17143","(۱۷۱۴۳) حَدَّثَنَا شَبَابَۃُ ، عَنْ وَرْقَائَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ : (وَلَکِنْ لاَ تُوَاعِدُوہُنَّ سِرًّا) قَوْلُ الرَّجُلِ لِلْمَرْأَۃِ : لاَ تَفُوتِینِی بِنَفْسِکِ فَإِنِّی نَاکِحُکِ ، ہَذَا لاَ یَحِلُّ۔","","Musannaf Ibn Abi Shaybah 17143","","","كتاب النكاح"
"17144","(۱۷۱۴۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مَخْلَدٍ ، وَالْحَسَنِ : {وَلَکِنْ لاَ تُوَاعِدُوہُنَّ سِرًّا} قَالاَ : الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17144","","","كتاب النكاح"
"17145","(۱۷۱۴۵) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عِمْرَانَ ، عَنِ الْحَسَنِ : {وَلَکِنْ لاَ تُوَاعِدُوہُنَّ سِرًّا} قَالَ : الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17145","","","كتاب النكاح"
"17146","(۱۷۱۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنِ الْحَسَنِ قَالَ سَمِعْتُہُ یَقول {وَلَکِنْ لاَ تُوَاعِدُوہُنَّ سِرًّا} قَالَ: الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17146","","","كتاب النكاح"
"17147","(۱۷۱۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ السُّدِّی ، عَنْ إبْرَاہِیمَ قَالَ : الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17147","","","كتاب النكاح"
"17148","(۱۷۱۴۸) حَدَّثَنَا جَرِیرٌ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ قَالَ : الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17148","","","كتاب النكاح"
"17149","(۱۷۱۴۹) حدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ أَبی ہِلال عَن حَیَّانَ الأَعْرَجِ ، عَنْ جَابِرِ بْنِ زَیْدٍ قَالَ : الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17149","","","كتاب النكاح"
"17150","(۱۷۱۵۰) حدَّثَنَا یَحْیَی بْنُ یَمَانٍ، عَنْ سُفْیَانَ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ، عَنِ الضَّحَّاکِ قَالَ: لاَ یُقَاضِیہَا أَنْ لاَ تَزَوَّجَ غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 17150","","","كتاب النكاح"
"17151","(۱۷۱۵۱) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سِمَاکٍ ، عَنْ حَنَش بْنِ الْمُعْتَمِرِ قَالَ : أُتِیَ عَلِیٌّ برَجُلٍ قَدْ أَقَرَّ عَلَی نَفْسِہِ بِالزِّنَا ، فَقَالَ لَہُ علی : أُحْصِنْتَ ؟ قَالَ : نَعَمْ قَالَ : إذًا تُرْجَمُ ، قَالَ فَرَفَعَہُ إلَی السِّجْنِ فَلَمَّا کَانَ الْعَشِیّ دَعَا بِہِ فَقَصَّ أَمْرَہُ عَلَی النَّاسِ ، فَقَالَ رَجُلٌ مِنَ النَّاسِ : إنَّہُ قَدْ تَزَوَّجَ امْرَأَۃً لَمْ یَدْخُلْ بِہَا ، فَفَرِحَ بِذَلِکَ عَلِیٌّ فَضَرَبَہُ الْحَدَّ وَفَرَّقَ بَیْنَہُ وَبَیْنَ امْرَأَتِہِ وَأَعْطَاہَا نِصْفَ الصَّدَاقِ فِیمَا یُرَی سِمَاک۔",": Da'if","Musannaf Ibn Abi Shaybah 17151","","","كتاب النكاح"
"17152","(۱۷۱۵۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ وَعَنْ أَشْعَثَ ، عَنِ الْحَسَنِ أنَّ الْبِکْرَ إذَا زَنَتْ جُلِدَتْ وَفُرِّقَ بَیْنَہَا وَبَیْنَ زَوْجِہَا وَلَیْسَ لَہَا شَیْئٌ ثُمَّ تَأَوَّلَ الْحَسَنُ ہَذِہِ الآیَۃَ : {وَلاَ تَعْضُلُوہُنَّ لِتَذْہَبُوا بِبَعْضِ مَا آتَیْتُمُوہُنَّ إلاَّ أَنْ یَأْتِینَ بِفَاحِشَۃٍ مُبَیِّنَۃٍ}۔",": Da'if","Musannaf Ibn Abi Shaybah 17152","","","كتاب النكاح"
"17153","(۱۷۱۵۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ ، یُفَرَّقُ بَیْنَہُمَا وَلاَ صَدَاقَ لَہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17153","","","كتاب النكاح"
"17154","(۱۷۱۵۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَتَزَوَّجُ الْمَرْأَۃَ ثُمَّ تَزْنِی قَبْلَ أَنْ یَدْخُلَ بِہَا ، قَالَ: یُفَرَّقُ بَیْنَہُمَا وَلاَ صَدَاقَ لَہَا وَجَلْدُ مِئَۃٍ وَنَفْیُ سَنَۃٍ ، وَإِنْ ہُوَ زَنَی فُرِّقَ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 17154","","","كتاب النكاح"
"17155","(۱۷۱۵۵) حَدَّثَنَا جَرِیرٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ قَالَ : ہِیَ امْرَأَتُہُ یُقَامُ عَلَیْہِ الْحَدُّ ، إِنْ شَائَ طَلَّقَ ، وَإِنْ شَائَ أَمْسَکَ کَمَا أَنَّہُ لَوْ فَجَرَ لَمْ تُنْزَعْ عَنْہُ امْرَأَتُہُ۔","","Musannaf Ibn Abi Shaybah 17155","","","كتاب النكاح"
"17156","(۱۷۱۵۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ فِی رَجُلٍ زَنَی قَبْلَ أَنْ یَدْخُلَ بِامْرَأَتِہِ ، فَکَانَ مِنْ رَأْیِہِ أَنْ لاَ یُفَرَّقَ بَیْنَہُ وَبَیْنَ امْرَأَتِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17156","","","كتاب النكاح"
"17157","(۱۷۱۵۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً فَأَصَابَ أَحَدُہُمَا فَاحِشَۃً قَبْلَ أَنْ یَدْخُلَ بِہَا قَالَ : یُجْلَدُ وَلاَ یُفَرَّقُ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 17157","","","كتاب النكاح"
"17158","(۱۷۱۵۸) حدَّثَنَا ابن فُضَیل عَن ابْنِ أَبِی لَیْلَی ، عَنْ نَافِعٍ ، عَنْ صَفِیَّۃَ بِنْتِ أَبِی عُبَیْدٍ قَالَتْ : تَزَوَّجَ رَجُلٌ امْرَأَۃً ثُمَّ فَجَرَ بِأُخْرَی قَبْلَ أَنْ یَدْخُلَ بِامْرَأَتِہِ فَجَلَدَہُ أَبُو بَکْرٍ مِئَۃً وَنَفَاہُ سَنَۃً۔",": Da'if","Musannaf Ibn Abi Shaybah 17158","","","كتاب النكاح"
"17159","(۱۷۱۵۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی الْخَلِیلِ أَنَّ أَبَا عَلْقَمَۃَ الْہَاشِمِیَّ حدَّثَنَا أَنَّ أَبَا سَعِیدٍ الْخُدْرِیَّ حَدَّثَہُمْ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعَثَ یَوْمَ حُنَیْنٍ سَرِیَّۃً فَأَصَابُوا حَیًّا مِنَ الْعَرَبِ یَوْمَ أَوْطَاسٍ فَہَزَمُوہُمْ وَقَتَلُوہُمْ وَأَصَابُوا نِسَائً لَہُنَّ أَزْوَاجٌ من زنی ، فَکَانَ أُنَاسٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تأثموا مِنْ غِشْیَانِہِنَّ مِنْ أَجْلِ أَزْوَاجِہِنَّ فَأَنْزَلَ اللَّہُ : {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ} مِنْہُنَّ فحلال لَکُمْ۔ (مسلم ۳۳۔ ابوداؤد ۲۱۴۸)",": Sahih","Musannaf Ibn Abi Shaybah 17159","","","كتاب النكاح"
"17160","(۱۷۱۶۰) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عن إبْرَاہِیمَ قَالَ : قَالَ عَلِیٌّ ، فِی قولہ تعالی: {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ} قَالَ : ذَوَاتُ الأَزْوَاجِ مِنَ الْمُشْرِکِینَ۔","","Musannaf Ibn Abi Shaybah 17160","","","كتاب النكاح"
"17161","(۱۷۱۶۱) حَدَّثَنَا عبد الوہاب الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنِ ابْنِ مَسْعُودٍ قَالَ : سَبَایَا کَانَ لَہُنَّ أَزْوَاجٌ قَبْلَ أَنْ یُسْبَیْنَ۔","","Musannaf Ibn Abi Shaybah 17161","","","كتاب النكاح"
"17162","(۱۷۱۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، عَنْ أَنَسٍ : {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ} قَالَ : ذَوَاتُ الأَزْوَاجِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17162","","","كتاب النكاح"
"17163","(۱۷۱۶۳) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ زمعۃ ، عَنِ الزُّہْرِیِّ ، عَنِ سعید بْنِ الْمُسَیَّبِ قَالَ : ذَوَاتُ الأَزْوَاجِ ، یَرْجِعُ ذَلِکَ إلَی أَنَّ اللَّہَ تَعَالَی حَرَّمَ الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17163","","","كتاب النكاح"
"17164","(۱۷۱۶۴) حَدَّثَنَا عبد اللہ بْنُ إدْرِیسَ ، عَنْ أَشْعَثَ وَہِشَامٍ ، عَنْ مُحَمَّدٍ ، عَنْ عَبِیدَۃَ : {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ} قَالَ بِیَدِہِ ہَکَذَا وَأَشَارَ بِالأَرْبَعِ : إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17164","","","كتاب النكاح"
"17165","(۱۷۱۶۵) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنِ الصَّلْتِ، عَنْ إبْرَاہِیمَ قَالَ: کُلُّ ذَاتِ زَوْجٍ عَلَیْک حَرَامٌ إلاَّ مَا أَصَبْتَ مِنَ السَّبَایَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17165","","","كتاب النكاح"
"17166","(۱۷۱۶۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ قَالَ : نَزَلَتْ یَوْمَ أَوْطَاسٍ۔","","Musannaf Ibn Abi Shaybah 17166","","","كتاب النكاح"
"17167","(۱۷۱۶۷) حَدَّثَنَا ابْنُ مُسْہِرٍ ، عَنْ أَشْعَثَ ، عَنْ حَسَنٍ قَالَ : کُلُّ ذَاتِ زَوْجٍ عَلَیْک حَرَامٌ إلاَّ مَا مَلَکَتْ یَمِینُک یَعْنِی مِنَ السَّبَایَا۔",": Hasan","Musannaf Ibn Abi Shaybah 17167","","","كتاب النكاح"
"17168","(۱۷۱۶۸) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنِ الْحَسَنِ بْنِ مُحَمَّدٍ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 17168","","","كتاب النكاح"
"17169","(۱۷۱۶۹) حَدَّثَنَا غُنْدَرٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : ہُوَ الزِّنَا ، وَقَالَ مُجَاہِدٌ : ہُوَ الزِّنَا ، وَقَالَ عِکْرِمَۃُ : ہُوَ الزِّنَا {إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ} وَقَالَ ابْنُ عَبَّاسٍ : {إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ} یَنْزِعُ الرَّجُلُ وَلِیدَتہ امْرَأَۃَ عَبْدِہِ وَقَالَ غَیْرُہُ : سَبَایَا الْعَدُوِّ یُوطَأْنَ إذَا مَا سُبِیَتْ أَزْوَاجُہُنَّ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17169","","","كتاب النكاح"
"17170","(۱۷۱۷۰) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ أَشْعَثَ ، عَنْ جَعْفَرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : أَرْبَعٌ۔","","Musannaf Ibn Abi Shaybah 17170","","","كتاب النكاح"
"17171","(۱۷۱۷۱) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ مَکْحُولٍ قَالَ : أَرْبَعٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17171","","","كتاب النكاح"
"17172","(۱۷۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَن عَبْدِ اللہِ : {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ} قَالَ : ذَوَاتُ الأَزْوَاجِ۔","","Musannaf Ibn Abi Shaybah 17172","","","كتاب النكاح"
"17173","(۱۷۱۷۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ فِی قَوْلِہِ : {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ} قَالَ : کُلُّ ذَاتِ زَوْجٍ عَلَیْکَ حَرَامٌ إلاَّ مَا مَلَکَتْ یَمِینُکَ ، أَوْ تَشْتَرِیہَا۔","","Musannaf Ibn Abi Shaybah 17173","","","كتاب النكاح"
"17174","(۱۷۱۷۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ قَالَ : کُلُّ ذَاتِ زَوْجٍ عَلَیْکَ حَرَامٌ إلاَّ مَا مَلَکَتْ یَمِینُکَ مِنَ السَّبَایَا یُرِیدُ {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ}۔",": No Data Available","Musannaf Ibn Abi Shaybah 17174","","","كتاب النكاح"
"17175","(۱۷۱۷۵) حَدَّثَنَا عُبَیْدُ اللہِ قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مَکْحُولٍ : {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ} قَالَ : ذَوَاتُ الأَزْوَاجِ۔","","Musannaf Ibn Abi Shaybah 17175","","","كتاب النكاح"
"17176","(۱۷۱۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ أَبِی السَّوْدَائِ قَالَ : سَأَلْتُ عِکْرِمَۃَ عَنْہَا ، فَقَالَ : لاَ أَدْرِی ، وَسَأَلْتُ الشَّعْبِیَّ ، فَقَالَ : ہِیَ کُلُّ ذَاتِ زَوْجٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17176","","","كتاب النكاح"
"17177","(۱۷۱۷۷) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ : {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ} قَالَ : من النساء کُلِّہِنَّ إلاَّ ذَوَاتِ الأَزْوَاجِ مِنَ السَّبَایَا۔",": Da'if","Musannaf Ibn Abi Shaybah 17177","","","كتاب النكاح"
"17178","(۱۷۱۷۸) حَدَّثَنَا غُنْدَرٌ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ فِی قَوْلِہِ : {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ} قَالَ : الزِّنَا ، وَقَالَ مُجَاہِدٌ : ہُوَ الزِّنَا ، وَقَالَ ابْنُ عَبَّاسٍ : ہُوَ الزِّنَا إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ یَنْزِعُ الرَّجُلُ وَلِیدَتہ امْرَأَۃَ عَبْدِہِ فَیَطَؤُہَا إِنْ شَائَ ، وَقَالَ غَیْرُہُ : سَبَایَا الْعَدُوِّ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17178","","","كتاب النكاح"
"17179","(۱۷۱۷۹) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ قَالَ : حدثنا شَرِیکٌ ، عَنْ سَالِمٍ ، عَنْ سَعِیدٍ فِی قَوْلِہِ : {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ} قَالَ : نَزَلَتْ فِی نِسَائِ أَہْلِ حُنَیْنٍ ، لَمَّا افْتَتَحَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حُنَیْنًا أَصَابَ الْمُسْلِمُونَ السَّبَایَا ، فَکَانَ الرَّجُلُ إذَا أَرَادَ أَنْ یَأْتِیَ الْمَرْأَۃَ مِنْہُنَّ قَالَتْ : إنَّ لِی زَوْجًا فَأَتَوُا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَذَکَرُوا ذَلِکَ لَہُ فَأَنْزَلَ اللَّہُ تَعَالَی : {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ} قَالَ : السَّبَایَا مِنْ ذَوَاتِ الأَزْوَاجِ۔","","Musannaf Ibn Abi Shaybah 17179","","","كتاب النكاح"
"17180","(۱۷۱۸۰) حَدَّثَنَا شَبَابَۃُ، عَنْ وَرْقَائَ، عَنِ ابْنِ أَبِی نَجِیحٍ، عَنْ مُجَاہِدٍ: {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ} نہی، عَنِ الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17180","","","كتاب النكاح"
"17181","(۱۷۱۸۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ یُونُسَ بْنِ أَبِی إِسْحَاقَ ، عَنْ طَارِقٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : لاَ تَغُرَّنَّکُمْ ہَذِہِ الآیَۃُ {إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ} إنَّمَا عَنَی بِہِ الإِمَائَ وَلَمْ یَعْنِ بِہا الْعَبِیدَ۔","","Musannaf Ibn Abi Shaybah 17181","","","كتاب النكاح"
"17182","(۱۷۱۸۲) حَدَّثَنَا جَرِیرٍ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی رَزِینٍ فِی قَوْلِہِ : {لاَ یَحِلُّ لَکَ النِّسَائُ مِنْ بَعْدُ} قَالَ : لاَ یَحِلُّ لَکَ مِنَ الْمُشْرِکَاتِ إلاَّ مَا سَبَیْتَ ، أَوْ مَا مَلَکَتْ یَمِینُکَ۔","","Musannaf Ibn Abi Shaybah 17182","","","كتاب النكاح"
"17183","(۱۷۱۸۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ قَالَ : مِنْ مُسْلِمَۃٍ وَلاَ نَصْرَانِیَّۃٍ وَلاَ کَافِرَۃٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17183","","","كتاب النكاح"
"17184","(۱۷۱۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ قَالَ : {لاَ یَحِلُّ لَکَ النِّسَائُ مِنْ بَعْدُ} قَالَ: نِسَائُ الأُمَمِ مِنْ أَہْلِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 17184","","","كتاب النكاح"
"17185","(۱۷۱۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلِیِّ بْنِ بَذِیْمَۃَ ، قَالَ : سَمِعْتُ مُجَاہِدًا یَقُولُ : {لاَ یَحِلُّ لَکَ النِّسَائُ مِنْ بَعْدُ} قَالَ : مِنْ بَعْدِ ہَذَا السَّبَبِ۔","","Musannaf Ibn Abi Shaybah 17185","","","كتاب النكاح"
"17186","(۱۷۱۸۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی مُوسَی ، عَنْ زِیَادٍ قَالَ : قیل لأُبَیٍّ : لَوْ ہَلَکَ أَزْوَاجُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَلَّ لَہُ أَنْ یَتَزَوَّجَ ؟ قَالَ : وَمَنْ یَمْنَعُہُ ؟ أَحَلَّ اللَّہُ لَہُ ضَرْبًا مِنَ النِّسَائِ ، فَکَانَ یَتَزَوَّجُ مِنْہُنَّ مَنْ شَائَ ، ثُمَّ تَلاَ ہَذِہِ الآیَۃَ : {یَا أَیُّہَا النَّبِیُّ إنَّا أَحْلَلْنَا لَکَ أَزْوَاجَک اللاَّتِی} حَتَّی خَتَمَ الآیَۃَ۔ (طبری ۲۹۔ دارمی ۲۲۴۰)",": Da'if","Musannaf Ibn Abi Shaybah 17186","","","كتاب النكاح"
"17187","(۱۷۱۸۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ قَالَتْ : مَا مَاتَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی أُحِلَّ لَہُ النِّسَائَ۔ (ترمذی ۳۲۱۶۔ احمد ۴۱)",": Sahih","Musannaf Ibn Abi Shaybah 17187","","","كتاب النكاح"
"17188","(۱۷۱۸۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ : {وَلاَ أَنْ تَبَدَّلَ بِہِنَّ مِنْ أَزْوَاجٍ وَلَوْ أَعْجَبَک حُسْنُہُنَّ} قَالَ : لاَ تَبَدَّلُ بِہِنَّ یَہُودِیَّاتٍ وَلاَ نَصْرَانِیَّاتٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17188","","","كتاب النكاح"
"17189","(۱۷۱۸۹) حَدَّثَنَا یَحْیَی بْنُ عَبْدِ الْمَلِکِ بْنِ أَبِی غَنِیۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ قَالَ : مِنْ أَہْلِ الْکِتَابِ ، أَوْ أَعْرَابِیَّۃٍ۔","","Musannaf Ibn Abi Shaybah 17189","","","كتاب النكاح"
"17190","(۱۷۱۹۰) حَدَّثَنَا عُبَیدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنِ السدِّی ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ فِی قَوْلِہِ : {وَلاَ أَنْ تَبَدَّلَ بِہِنَّ مِنْ أَزْوَاجٍ} قَالَ : ذَلِکَ لَوْ طَلَّقَہُنَّ لَمْ یَحِلَّ لَہُ أَنْ یَسْتَبْدِلَ ، قَالَ : وَقَدْ کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْکِحُ مَا شَائَ بَعْدَ مَا نَزَلَتْ ، وَنَزَلَتْ وَتَحْتَہُ تِسْعُ نِسْوَۃٍ وَتَزَوَّجَ أُمَّ حَبِیبَۃَ وَجُوَیْرِیَۃَ۔","","Musannaf Ibn Abi Shaybah 17190","","","كتاب النكاح"
"17191","(۱۷۱۹۱) حَدَّثَنَا عَفَّانُ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنِ الْحَسَنِ : {وَلاَ أَنْ تَبَدَّلَ بِہِنَّ مِنْ أَزْوَاجٍ} قَالَ: قَصَرَہُ اللَّہُ عَلَی نِسَائِہِ التِّسْعِ اللاَّتِی مَاتَ عَنْہُنَّ ، قَالَ : قَالَ عَلِیٌّ : فَأَخْبَرْت بِذَلِکَ عَلِیَّ بْنَ حُسَیْنٍ ، فَقَالَ : بل کَانَ لَہُ أَنْ یَتَزَوَّجَ۔","","Musannaf Ibn Abi Shaybah 17191","","","كتاب النكاح"
"17192","(۱۷۱۹۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ شُبْرُمَۃَ ، عَنْ عِکْرِمَۃَ : (الزَّانِی لاَ یَنْکِحُ إلاَّ زَانِیَۃً) لاَ یَزْنِی الزَّانِی إلاَّ بِزَانِیَۃٍ۔","","Musannaf Ibn Abi Shaybah 17192","","","كتاب النكاح"
"17193","(۱۷۱۹۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : {الزَّانِی لاَ یَنْکِحُ إلاَّ زَانِیَۃً أَوْ مُشْرِکَۃً} قَالَ : کَانَ یُقَالُ نَسَخَتْہَا الَّتِی بَعْدَہَا {وَأَنْکِحُوا الأَیَامَی مِنْکُمْ} قَالَ : وَکَانَ یُقَالُ إنَّہَا مِنْ أَیَامَی الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 17193","","","كتاب النكاح"
"17194","(۱۷۱۹۴) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنْ یَعْلَی بْنِ مُسْلِمٍ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ: لاَ یَزْنِی إلاَّ بِزَانِیَۃٍ ، أَوْ مُشْرِکَۃٍ۔","","Musannaf Ibn Abi Shaybah 17194","","","كتاب النكاح"
"17195","(۱۷۱۹۵) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ، عَنْ مُجَاہِدٍ قَالَ سَمِعْتُہُ یَقُولُ: کُنَّ بَغَایَا فِی الْجَاہِلِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 17195","","","كتاب النكاح"
"17196","(۱۷۱۹۶) حَدَّثَنَا عَبْدَۃَ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ عَاصِمِ بْنِ الْمُنْذِرِ قَالَ : سَأَلْتُ عُرْوَۃَ ، عَنْ قَوْلِہِ : {الزَّانِی لاَ یَنْکِحُ إلاَّ زَانِیَۃً أَوْ مُشْرِکَۃً} قَالَ : کُنَّ نِسَائً بَغَایَا فِی الْجَاہِلِیَّۃِ لَہُنَّ رَایَاتٌ یُعْرَفْنَ بِہَا۔","","Musannaf Ibn Abi Shaybah 17196","","","كتاب النكاح"
"17197","(۱۷۱۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشعبی قَالَ : نِسَائٌ کُنَّ یَکْرِینَ أَنْفُسَہُنَّ فِی الْجَاہِلِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 17197","","","كتاب النكاح"
"17198","(۱۷۱۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سَلَمَۃَ ، عَنِ الضَّحَّاکِ فِی قَوْلِہِ : (الزَّانِی لاَ یَنْکِحُ إلاَّ زَانِیَۃً أَوْ مُشْرِکَۃً وَالزَّانِیَۃُ لاَ یَنْکِحُہَا إلاَّ زَانٍ أَوْ مُشْرِکٌ) قَالَ : لاَ یَزْنِی حِینَ یَزْنِی إلاَّ بِزَانِیَۃٍ وَلاَ تَزْنِی حِینَ تَزْنِی إلاَّ بِزَانٍ مِثْلِہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17198","","","كتاب النكاح"
"17199","(۱۷۱۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ یَعْلَی بْنِ مُسْلِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 17199","","","كتاب النكاح"
"17200","(۱۷۲۰۰) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ شُعْبَۃَ مَوْلَی ابْنِ عَبَّاسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : بَغَایَا کُنَّ فِی الْجَاہِلِیَّۃِ یَجْعَلْنَ عَلَی أَبْوَابِہِنَّ رَایَاتٍ کَرَایَاتِ الْبَیَاطِرَۃِ ، یَأْتِیہِنَّ النَّاسُ ، یُعْرَفْنَ بِذَلِکَ۔",": Da'if","Musannaf Ibn Abi Shaybah 17200","","","كتاب النكاح"
"17201","(۱۷۲۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ عَاصِمِ بْنِ الْمُنْذِرِ ، عَنْ عُرْوَۃَ نَحْوَہُ۔","","Musannaf Ibn Abi Shaybah 17201","","","كتاب النكاح"
"17202","(۱۷۲۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی عَمْرَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : {الزَّانِی لاَ یَنْکِحُ إلاَّ زَانِیَۃً أَوْ مُشْرِکَۃً} یَعْنِی بِالنِّکَاحِ : یُجَامِعُہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 17202","","","كتاب النكاح"
"17203","(۱۷۲۰۳) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ سُفْیَانَ ، عَنْ خَالِدِ بْنِ دِینَارٍ ، عَنِ الْحَارِثِ ، عَنْ إبْرَاہِیمَ قَالَ لاَ یُجَامِعُہَا إلاَّ زَانٍ أَوْ مُشْرِکٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17203","","","كتاب النكاح"
"17204","(۱۷۲۰۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ التَّمَّارُ العُصْفُریّ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ جُبَیْرٍ یَقُولُ : کُنَّ بَغَایَا بِمَکَّۃَ قَبْلَ الإِسْلاَمِ ، فَکَانَ رِجَالٌ یَتَزَوَّجُونَہُنَّ فَیُنْفِقْنَ عَلَیْہِمْ مَا أَصَبْنَ فَلَمَّا جَائَ الإِسْلاَمُ تَزَوَّجَہُنَّ رِجَالٌ مِنْ أَہْلِ الإِسْلاَمِ فَحَرَّمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَلِکَ عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 17204","","","كتاب النكاح"
"17205","(۱۷۲۰۵) حَدَّثَنَا عَفَّانُ قَالَ حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنِ ابْنِ عَبَّاسٍ : (الزَّانِی لاَ یَنْکِحُ إلاَّ زَانِیَۃً أَوْ مُشْرِکَۃً) قَالَ : الزَّانِی لاَ یزنی إلاَّ بِزَانِیَۃٍ ، أَوْ مُشْرِکَۃٍ وَلَکِنَّ اللَّہَ کَنَّی۔","","Musannaf Ibn Abi Shaybah 17205","","","كتاب النكاح"
"17206","(۱۷۲۰۶) حَدَّثَنَا شَبَابَۃُ ، عَنْ وَرْقَائَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ فِی قَوْلِہِ : (الزَّانِی لاَ یَنْکِحُ إلاَّ زَانِیَۃً) بَغَایَا مُتَعَالِنَاتٌ کُنَّ فِی الْجَاہِلِیَّۃِ فَقِیلَ لَہُنَّ : ہَذَا حَرَامٌ فَأَرَادُوا نِکَاحَہُنَّ فَحَرَّمَ اللَّہُ عَلَیْہِمْ نِکَاحَہُنَّ۔","","Musannaf Ibn Abi Shaybah 17206","","","كتاب النكاح"
"17207","(۱۷۲۰۷) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ قَالَ : أَحَلُّ النِّسَائِ للزَّانِی الزَّانِیَۃُ قَالَ : وَسَأَلْتُ الْحَسَنَ ، فَقَالَ : إنا لاَ نُفتِی فِی الْمَسْتُورِ وَلَکِنِ الْمَحْدُودُ لاَ یَتَزَوَّجُ إلاَّ مَحْدُودَۃً۔","","Musannaf Ibn Abi Shaybah 17207","","","كتاب النكاح"
"17208","(۱۷۲۰۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنِ ابْنِ سَابِطٍ أَنَّ عَلِیًّا أُتِیَ بِمَحْدُودٍ تَزَوَّجَ امْرَأَۃً غَیْرَ مَحْدُودَۃٍ فَفَرَّقَ بَیْنَہُمَا۔",": Da'if","Musannaf Ibn Abi Shaybah 17208","","","كتاب النكاح"
"17209","(۱۷۲۰۹) حَدَّثَنَا بَکَّارُ بْنُ عَبْدِ اللہِ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ أَخِیہِ عَبْدِ اللہِ بْنِ عُبَیْدَۃَ أَنَّ مَوْلاَۃً لِبَنِی حَارِثَۃَ جُلِدَتْ حَدَّ الزِّنَا فَأَرَادَ رَجُلٌ أَنْ یَتَزَوَّجَہَا فَاسْتَشَارَ أَبَا ہُرَیْرَۃَ ، فَقَالَ: لاَ، إلاَّ أَنْ تَکُونَ عَمِلْتَ مِثْلَ عَمَلِہَا۔",": Da'if","Musannaf Ibn Abi Shaybah 17209","","","كتاب النكاح"
"17210","(۱۷۲۱۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ أَنَّ رَجُلاً أَرَادَ أَنْ یُزَوِّجَ ابْنَۃً ، فَقَالَتْ : إنِّی أَخْشَی أَنْ أَفْضَحَکَ ، إنِّی قَدْ بَغَیْتُ ، فَأَتَی عُمَرَ ، فَقَالَ : أَلَیْسَتْ قَدْ تَابَتْ ؟ قَالَ : نَعَمْ ، قَالَ : فَزَوِّجْہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 17210","","","كتاب النكاح"
"17211","(۱۷۲۱۱) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ أَنَّ امْرَأَۃَ رِفَاعَۃَ الْقُرَظِیِّ جَائَتْ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : إنِّی کُنْتُ عِنْدَ رِفَاعَۃَ الْقُرَظِیِّ فَطَلَّقَنِی فَبَتَّ طَلاَقِی فَتَزَوَّجْتُ عَبْدَ الرَّحْمَنِ بْنَ الزَّبِیْرِ وَإِنَّمَا مَعَہُ مِثْلُ ہُدْبَۃِ الثَّوْبِ ، فَتَبَسَّمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَقَالَ : تُرِیدِینَ أَنْ تَرْجِعِی إلَی رِفَاعَۃَ ؟ لاَ حَتَّی تَذُوقِی عُسَیْلَتَہُ وَیَذُوقَ عُسَیْلَتَکِ۔ (بخاری ۲۶۳۹۔ مسلم ۱۱۱)",": Sahih","Musannaf Ibn Abi Shaybah 17211","","","كتاب النكاح"
"17212","(۱۷۲۱۲) حَدَّثَنَا أبو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ قَالَتْ : سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْہُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تحل لہ حَتَّی یَذُوقَ الآخر عُسَیْلَتَہَا وَتَذُوقَ عُسَیْلَتَہُ۔ (ابوداؤد ۲۳۰۳۔ احمد ۶/۴۲)",": Sahih","Musannaf Ibn Abi Shaybah 17212","","","كتاب النكاح"
"17213","(۱۷۲۱۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مثل حدیث الأعمش۔ (بخاری ۵۲۶۱۔ مسلم ۱۱۵)",": Sahih","Musannaf Ibn Abi Shaybah 17213","","","كتاب النكاح"
"17214","(۱۷۲۱۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوہ۔\n(بخاری ۵۲۶۵۔ مسلم ۱۱۴)",": Sahih","Musannaf Ibn Abi Shaybah 17214","","","كتاب النكاح"
"17215","(۱۷۲۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنْ سُلَیْمَانَ بْنِ رَزِینٍ ، عَنِ ابْنِ عُمَرَ قَالَ : سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ رَجُلٍ طَلَّقَ امْرَأَتَہُ ثَلاَثًا فَتَزَوَّجَتْ زَوْجًا غَیْرَہُ فَأَغْلَقَ الْبَابَ وَأَرْخَی السِّتْرَ ثُمَّ طَلَّقَہَا قَبْلَ أَنْ یَدْخُلَ بِہَا قَالَ : لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ وَتَذُوقَ عُسَیْلَتَہُ۔\n قَالَ وَکِیعٌ بأخرۃ : رَزِینِ بْنِ سُلَیْمَانَ۔ (احمد ۲/۲۵۔ بیہقی ۳۷۵)",": Da'if","Musannaf Ibn Abi Shaybah 17215","","","كتاب النكاح"
"17216","(۱۷۲۱۶) حَدَّثَنَا شَریک ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : قَالَ عَلِیٌّ : لاَ تَحِلُّ لَہُ حَتَّی یَہُزَّہَا بِہِ ہَزِیزَ الْبِکْرِ ، قَالَ : وَقَالَتْ عَائِشَۃُ : حَتَّی یَذُوقَ الآخَرُ عُسَیْلَتَہَا وَتَذُوقَ عُسَیْلَتَہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 17216","","","كتاب النكاح"
"17217","(۱۷۲۱۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ یَحْیَی بْنِ یَزِیدَ الْہُنَائی ، عَنْ أَنَسٍ قَالَ : لاَ تَحِلُّ لِلأَوَّلِ حَتَّی یُجَامِعَہَا الآخَرُ وَیَدْخُلَ بِہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 17217","","","كتاب النكاح"
"17218","(۱۷۲۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی تِحْیَی ، قَالَ : قَالَ أَبُو ہُرَیْرَۃَ : لاَ تَحِلُّ لِلأَوَّلِ حَتَّی یُجَامِعَہَا الآخَرُ۔",": Hasan","Musannaf Ibn Abi Shaybah 17218","","","كتاب النكاح"
"17219","(۱۷۲۱۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مِسْعَرٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، عَن عَبْدِ اللہِ : لاَ تَحِلُّ لَہُ حَتَّی یُشَفْشِفَہَا بِہِ ، وَقَالَ علی: حَتَّی تَذُوقَ عُسَیْلَتَہُ۔","","Musannaf Ibn Abi Shaybah 17219","","","كتاب النكاح"
"17220","(۱۷۲۲۰) حدَّثَنَا الأَشْیَبُ الْحَسَنُ بْنُ مُوسَی ، عَنْ شَیْبَانَ ، عَنْ یَحْیَی ، عَنْ أَبِی الْحَارِثِ الْغِفَارِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : حَتَّی تَذُوقَ عُسَیْلَتَہُ۔ (ابن جریر ۴۷۷)",": Da'if","Musannaf Ibn Abi Shaybah 17220","","","كتاب النكاح"
"17221","(۱۷۲۲۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خالد عن أَبِی قِلاَبَۃَ ، عَنْ أَنَسٍ قَالَ : إذَا تَزَوَّجَ الرَّجُلُ الْبِکْرَ عَلَی امْرَأَتِہِ أَقَامَ عِنْدَہَا سَبْعًا وَإِذَا تَزَوَّجَ الثَّیِّبَ أَقَامَ عِنْدَہَا ثَلاَثًا ، قَالَ خَالِدٌ : قَالَ أَبُو قِلاَبَۃَ : أَمَا لَوْ قُلْتُ : إنَّہُ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَلَکِنَّہَا سُنَّۃٌ قَالَ خَالِدٌ : فَحَدَّثْتُ بِہِ ابْنَ سِیرِینَ ، فَقَالَ : زِدْتُمْ ہَذِہِ أَرْبَعًا وَہَذِہِ لَیْلَۃً۔\n(بخاری ۵۲۱۳۔ مسلم ۱۰۸۴)",": Sahih","Musannaf Ibn Abi Shaybah 17221","","","كتاب النكاح"
"17222","(۱۷۲۲۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : لِلْبِکْرِ سَبْعًا وَلِلثَّیِّبِ ثَلاَثًا۔ (دارمی ۲۲۰۹۔ مسلم ۱۰۸۴)","","Musannaf Ibn Abi Shaybah 17222","","","كتاب النكاح"
"17223","(۱۷۲۲۳) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ مُحَمَّدِ بْنِ إسحاق ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَنَسٍ ، عَنِ النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بمثلہ۔ (دارمی ۲۲۰۹)","","Musannaf Ibn Abi Shaybah 17223","","","كتاب النكاح"
"17224","(۱۷۲۲۴) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ عن سفیان ، عَنْ مُحَمَّدِ بْنِ أَبِی بَکْرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی بَکْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ أُمِّ سَلَمَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمَّا تَزَوَّجَ أُمَّ سَلَمَۃَ أَقَامَ عِنْدَہَا ثَلاَثًا وَقَالَ لَہَا : إنَّہُ لَیْسَ بِکِ عَلَی أَہْلِکِ ہَوَانٌ ، إِنْ شِئْتِ سَبَّعْتُ لَکِ ، وَإِنْ سَبَّعْتُ لَکِ سَبَّعْتُ لِنِسَائِی۔ (مسلم ۱۰۸۳۔ ابوداؤد ۲۱۱۵)",": Sahih","Musannaf Ibn Abi Shaybah 17224","","","كتاب النكاح"
"17225","(۱۷۲۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ قَالَ : لَمَّا تَزَوَّجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أُمَّ سَلَمَۃَ أَقَامَ عِنْدَہَا ثَلاَثًا وَقَالَ : إِنْ شِئْتِ سَبَّعْتُ لَکِ ، وَإِنْ سَبَّعْتُ لَکِ سَبَّعْتُ لِغَیْرِکِ ، قِیلَ لِلْحَکَمِ : مَنْ حَدَّثَک ہَذَا الْحَدِیثَ ؟ فَقَالَ : ہَذَا الْحَدِیثُ عِنْدَ أَہْلِ الْحِجَازِ مَعْرُوفٌ۔","","Musannaf Ibn Abi Shaybah 17225","","","كتاب النكاح"
"17226","(۱۷۲۲۶) حَدَّثَنَا عَبْدَۃ بن سلیمان ، عَنْ أَبِی سَعِیدٍ ، عَنْ إبْرَاہِیمَ وَالشَّعْبِیِّ قَالاَ : إذَا تَزَوَّجَ الْبِکْرَ عَلَی امْرَأَتِہِ أَقَامَ عِنْدَہَا سَبْعًا وَإِذَا تَزَوَّجَ الثَّیِّبَ عَلَی امْرَأَتِہِ ، أَقَامَ عِنْدَہَا ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 17226","","","كتاب النكاح"
"17227","(۱۷۲۲۷) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسِ بْنِ مَالِکٍ مِثْلَہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 17227","","","كتاب النكاح"
"17228","(۱۷۲۲۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : لِلْبِکْرِ ثَلاَثًا وَلِلثَّیِّبِ لَیلَتَین۔","","Musannaf Ibn Abi Shaybah 17228","","","كتاب النكاح"
"17229","(۱۷۲۲۹) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ قَالَ یُقِیمُ عِنْدَ الْبِکْرِ ثَلاَثًا ولِلثَّیِّبِ لَیْلَتَیْنِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17229","","","كتاب النكاح"
"17230","(۱۷۲۳۰) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ قَالَ : یُقِیمُ عِنْدَ الْبِکْرِ ثَلاَثًا وَیَقْسِمُ وَإِذَا تَزَوَّجَ الثَّیِّبَ أَقَامَ لَیْلَتَیْنِ ثُمَّ یَقْسِمُ۔","","Musannaf Ibn Abi Shaybah 17230","","","كتاب النكاح"
"17231","(۱۷۲۳۱) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ إبْرَاہِیمَ بَلَغَہُ قَالَ : الْبِکْرُ ثَلاَثًا وَالثَّیِّبُ لَیْلَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 17231","","","كتاب النكاح"
"17232","(۱۷۲۳۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنْ سَلَمَۃَ بْنِ وَہْرَام ، عَنْ عِکْرِمَۃَ قَالَ : لِلْبِکْرِ سَبْعًا وَلِلثَّیِّبِ ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 17232","","","كتاب النكاح"
"17233","(۱۷۲۳۳) حَدَّثَنَا أَبُو قَطَنٍ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ وَحَمَّادٍ قَالاَ : ہُمَا سَوَائٌ فِی الْقَسْمِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17233","","","كتاب النكاح"
"17234","(۱۷۲۳۴) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، وَسَعِیدِ بْنِ الْمُسَیَّبِ وَخِلاَسٍ قَالُوا : إذَا تَزَوَّجَ الْبِکْرَ عَلَی امْرَأَتِہِ أَقَامَ عنْدَہَا ثَلاَثًا ثُمَّ یَقْسِمُ ، وَإِذَا تَزَوَّجَ الثَّیِّبَ أَقَامَ لَیْلَتَیْنِ ثُمَّ یَقْسِمُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17234","","","كتاب النكاح"
"17235","(۱۷۲۳۵) حَدَّثَنَا یَزِیدُ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ قَالَ : مِنَ السُّنَّۃِ لِلْبِکْرِ سَبْعًا وَلِلثَّیِّبِ ثَلاَثًا ، قَالَ حُمَیْدٌ : وَقَالَ الْحَسَنُ : سَبْعًا وَلَیْلَتَیْنِ۔",": Sahih","Musannaf Ibn Abi Shaybah 17235","","","كتاب النكاح"
"17236","(۱۷۲۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ غَیْلاَنَ بْنِ جَامِعٍ ، عَنْ عَبْدِ الْمَلِکِ الزرَّاد ، عَنِ الشَّعْبِیِّ ، عَنْ قَمِیر ، عَنْ عَائِشَۃَ قَالَتْ : الْمُسْتَحَاضَۃُ لاَ یَأْتِیہَا زَوْجُہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 17236","","","كتاب النكاح"
"17237","(۱۷۲۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، أَ??َّہُ کَرِہَ أَنْ یُجَامِعَہَا زَوْجُہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17237","","","كتاب النكاح"
"17238","(۱۷۲۳۸) حَدَّثَنَا عَبْدُ الوَہَّاب الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَأْتِیَ الرَّجُلُ امْرَأَتَہُ وَہِیَ مُسْتَحَاضَۃٌ۔","","Musannaf Ibn Abi Shaybah 17238","","","كتاب النكاح"
"17239","(۱۷۲۳۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ قَالَ : لاَ یَغْشَاہَا وَلاَ تَصُومُ۔","","Musannaf Ibn Abi Shaybah 17239","","","كتاب النكاح"
"17240","(۱۷۲۴۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، قَالَ: قَالَ الشَّعْبِیُّ: لاَ تَصُومُ وَلاَ یَغْشَاہَا زَوْجُہَا۔","","Musannaf Ibn Abi Shaybah 17240","","","كتاب النكاح"
"17241","(۱۷۲۴۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ أَیُّوبَ قَالَ: قُلْتُ لِسُلَیْمَانَ بْنِ یَسَارٍ: یَأْتِیہَا زَوْجُہَا؟ قَالَ: مَا نَقُولُ فِیہِ إلاَّ مَا سَمِعْنَا۔","","Musannaf Ibn Abi Shaybah 17241","","","كتاب النكاح"
"17242","(۱۷۲۴۲) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عِکْرِمَۃَ قَالَ : الْمُسْتَحَاضَۃُ یَأْتِیہَا زَوْجُہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17242","","","كتاب النكاح"
"17243","(۱۷۲۴۳) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ قَالَ : بَلَغَنِی أَنَّ الْحَجَّاجَ قَالَ : إذَا شَکَّتْ فِی الْحَیْضِ اغْتَسَلَتْ وَصَلَّتْ وَلاَ یَقْرَبُہَا حَتَّی تَطْہُرَ ، فَقَالَ : بِئْسَ مَا قَالَ ، الصَّلاَۃُ أَعْظَمُ حُرْمَۃً۔","","Musannaf Ibn Abi Shaybah 17243","","","كتاب النكاح"
"17244","(۱۷۲۴۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ قَالَ : یَأْتِیہَا زَوْجُہَا۔",": Da'if","Musannaf Ibn Abi Shaybah 17244","","","كتاب النكاح"
"17245","(۱۷۲۴۵) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ أَشْعَثَ ، عَنْ عَطَائٍ قَالَ : یَأْتِیہَا زَوْجُہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17245","","","كتاب النكاح"
"17246","(۱۷۲۴۶) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ قَالَ : یَغْشَاہَا زَوْجُہَا إِنْ شَائَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17246","","","كتاب النكاح"
"17247","(۱۷۲۴۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ َشُعْبَۃَ ، عَنْ حَمَّادٍ فِی الْمُسْتَحَاضَۃِ : یَأْتِیہَا زَوْجُہَا وَتَصُومُ۔","","Musannaf Ibn Abi Shaybah 17247","","","كتاب النكاح"
"17248","(۱۷۲۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سفیان عن سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ فی المستحاضۃ قَالَ : یَأْتِیہَا ، الصَّلاَۃُ أَعْظَمُ حُرْمَۃً۔","","Musannaf Ibn Abi Shaybah 17248","","","كتاب النكاح"
"17249","(۱۷۲۴۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ سعید بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ فِی الْمُسْتَحَاضَۃِ : تَصُومُ وَتُصَلِّی وَتَقْضِی الْمَنَاسِکَ وَیَغْشَاہَا زَوْجُہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17249","","","كتاب النكاح"
"17250","(۱۷۲۵۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : الْمُسْتَحَاضَۃُ تَصُومُ وَتُصَلِّی وَیَأْتِیہَا زَوْجُہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 17250","","","كتاب النكاح"
"17251","(۱۷۲۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مَعْمَرِ بْنِ مُوسَی ، عَنْ أَبِی جَعْفَرٍ قَالَ : الْمُسْتَحَاضَۃُ یَأْتِیہَا زَوْجُہَا۔","","Musannaf Ibn Abi Shaybah 17251","","","كتاب النكاح"
"17252","(۱۷۲۵۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : قَالَ شُرَیْحٌ : ہُوَ الزَّوْجُ یَعنِِْی {الَّذِی بِیَدِہِ عُقْدَۃُ النِّکَاحِ}۔",": No Data Available","Musannaf Ibn Abi Shaybah 17252","","","كتاب النكاح"
"17253","(۱۷۲۵۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی مُلَیْکَۃَ ، قَالَ : قَالَ سَعِیدُ بْنُ جُبَیْرٍ : {الَّذِی بِیَدِہِ عُقْدَۃُ النِّکَاحِ} ہُوَ الزَّوْجُ۔","","Musannaf Ibn Abi Shaybah 17253","","","كتاب النكاح"
"17254","(۱۷۲۵۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ مُجَاہِدٌ : {الَّذِی بِیَدِہِ عُقْدَۃُ النِّکَاحِ} ہُوَ الزَّوْجُ ، {إلاَّ أَنْ یَعْفُونَ} ترد الْمَرْأَۃُ شَطْرَہَا {أَوْ یَعْفُوَا الَّذِی بِیَدِہِ عُقْدَۃُ النِّکَاحِ} إتْمَامُ الزَّوْجِ الصَّدَاقَ کُلَّہُ۔","","Musannaf Ibn Abi Shaybah 17254","","","كتاب النكاح"
"17255","(۱۷۲۵۵) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنْ شُرَیْحٍ ، وَعن إِسماعیل ، عَنِ الشَّعبی ، عَنْ شُرَیْحٍ وَجُوَیْبِرٌ ، عَنِ الضَّحَّاکِ قَالُوا : ہُوَ الزَّوْجُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 17255","","","كتاب النكاح"
"17256","(۱۷۲۵۶) حَدَّثَنَا عَبْدَۃُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ : {إلاَّ أَنْ یَعْفُونَ أَوْ یَعْفُوَا الَّذِی بِیَدِہِ عُقْدَۃُ النِّکَاحِ} قَالَ : الَّذِی بِیَدِہِ عُقْدَۃُ النِّکَاحِ الزَّوْجُ ، إِنْ شَائَتْ أَنْ تَعْفُوَ ہِیَ فَلاَ تَأْخُذْ مِنْ صَدَاقِہَا شَیْئًا ، وَإِنْ شَائَ فَہُوَ بَیْنَہُمَا نِصْفَیْنِ۔","","Musannaf Ibn Abi Shaybah 17256","","","كتاب النكاح"
"17257","(۱۷۲۵۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عَمرو أَنَّ نَافِعَ بْنَ جُبَیْرٍ طَلَّقَ امْرَأَتَہُ قَبْلَ أَنْ یَدْخُلَ بِہَا فَأَتَمَّ لَہَا الصَّدَاقَ وَقَالَ : أَنَا أَحَقُّ بِالْعَفْوِ۔","","Musannaf Ibn Abi Shaybah 17257","","","كتاب النكاح"
"17258","(۱۷۲۵۸) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ أَفْلَحَ بن سَعِیدٍ ، قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ کَعْبٍ یَقُولُ : {الَّذِی بِیَدِہِ عُقْدَۃُ النِّکَاحِ} ہُوَ الزَّوْجُ ، یُعْطِی مَا عِنْدَہُ عَفْوًا۔","","Musannaf Ibn Abi Shaybah 17258","","","كتاب النكاح"
"17259","(۱۷۲۵۹) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ قَالَ : {الَّذِی بِیَدِہِ عُقْدَۃُ النِّکَاحِ} الزَّوْجُ ، وَأَمَّا قَوْلُہُ : {إلاَّ أَنْ یَعْفُونَ أَوْ یَعْفُوَا الَّذِی بِیَدِہِ عُقْدَۃُ النِّکَاحِ} فَہِیَ الْمَرْأَۃُ یُطَلِّقُہَا زَوْجُہَا قَبْلَ أَنْ یَدْخُلَ بِہَا فَإِمَّا أَنْ تَعْفُوَ ، عَنِ النِّصْفِ لِزَوْجِہَا وَإِمَّا أَنْ یَعْفُوَ زَوْجُہَا فَیُکْمِلَ لَہَا الصَّدَاقَ۔","","Musannaf Ibn Abi Shaybah 17259","","","كتاب النكاح"
"17260","(۱۷۲۶۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، عَنْ شُرَیْحٍ قَالَ : ہُوَ الزَّوْجُ۔","","Musannaf Ibn Abi Shaybah 17260","","","كتاب النكاح"
"17261","(۱۷۲۶۱) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ زُہَیْرٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الشَّعْبِیِّ قَالَ : ہُوَ الزَّوْجُ۔","","Musannaf Ibn Abi Shaybah 17261","","","كتاب النكاح"
"17262","(۱۷۲۶۲) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنْ طَاوُوسٍ ، وَمُجَاہِدٍ قَالاَ: {الَّذِیْ بِیَدِہٖ عُقْدَۃُ النِّکَاحِ} ہُوَ الْوَلِیُّ وَقَالَ سَعِیدُ بْنُ جُبَیْرٍ : ہُوَ الزَّوْجُ ، فَکَلَّمَاہُ فِی ذَلِکَ فَمَا بَرِحَا حَتَّی تَابَعَا سَعِیدًا۔","","Musannaf Ibn Abi Shaybah 17262","","","كتاب النكاح"
"17263","(۱۷۲۶۳) حَدَّثَنَا حُمَیْدٌ ، عَنِ الْحَسَنِ ، عَنْ سَالِمٍ ، عَنْ سَعِیدٍ قَالَ : ہُوَ الزَّوْجُ۔",": Hasan","Musannaf Ibn Abi Shaybah 17263","","","كتاب النكاح"
"17264","(۱۷۲۶۴) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ، عَنْ عَمَّارِ بْنِ أَبِی عَمَّارٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ : {الَّذِیْ بِیَدِہٖ عُقْدَۃُ النِّکَاحِ} الزَّوْجُ۔",": Da'if","Musannaf Ibn Abi Shaybah 17264","","","كتاب النكاح"
