hadiths[1243]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"5499","«ماء البحر طهور»","صحيح","Sahih al-Jami al-Saghir 5499","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5500","«ماء الرجل أبيض وماء المرأة أصفر فإذا اجتمعا فعلا مني الرجل مني المرأة أذكرا بإذن الله وإذا علا مني المرأة مني الرجل أنثا بإذن الله»","صحيح","Sahih al-Jami al-Saghir 5500","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5501","«ماء الرجل غليظ أبيض وماء المرأة رقيق أصفر فأيهما سبق أشبهه الولد»","صحيح","Sahih al-Jami al-Saghir 5501","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5502","«ماء زمزم لما شرب له»","صحيح","Sahih al-Jami al-Saghir 5502","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5503","«ما آتاك الله من أموال السلطان من غير مسألة ولا إشراف فكله وتموله»","صحيح","Sahih al-Jami al-Saghir 5503","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5504","«ما آتاك الله من هذا المال من غير مسألة ولا إشراف فخذه فتموله أو تصدق به وما لا فلا تتبعه نفسك»","صحيح","Sahih al-Jami al-Saghir 5504","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5505","«ما آمن بي من بات شبعان وجاره جائع إلى جنبه وهو يعلم به»","صحيح","Sahih al-Jami al-Saghir 5505","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5506","«ما اجتمع قوم ثم تفرقوا عن غير ذكر الله وصلاة على النبي صلى الله عليه وسلم إلا قاموا عن أنتن من جيفة»","صحيح","Sahih al-Jami al-Saghir 5506","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5507","«ما اجتمع قوم على ذكر فتفرقوا عنه إلا قيل لهم: قوموا مغفورا لكم»","صحيح","Sahih al-Jami al-Saghir 5507","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5508","«ما اجتمع قوم فتفرقوا عن غير ذكر الله إلا كأنما تفرقوا عن جيفة حمار وكان ذلك المجلس عليهم حسرة»","صحيح","Sahih al-Jami al-Saghir 5508","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5509","«ما اجتمع قوم في بيت من بيوت الله يتلون كتاب الله ويتدارسونه بينهم إلا نزلت عليهم السكينة وغشيتهم الرحمة وحفتهم الملائكة وذكرهم الله فيمن عنده»","صحيح","Sahih al-Jami al-Saghir 5509","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5510","«ما اجتمع قوم في مجلس فتفرقوا ولم يذكروا الله ويصلوا على النبي صلى الله عليه وسلم إلا كان مجلسهم ترة عليهم يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 5510","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5511","«ما أجد له في غزوته هذه في الدنيا والآخرة إلا دنانيره التي سمى»","صحيح","Sahih al-Jami al-Saghir 5511","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5512","«ما أحب أن أحدا تحول لي ذهبا يمكث عندي منه دينار فوق ثلاث إلا دينار أرصده لدين»","صحيح","Sahih al-Jami al-Saghir 5512","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5513","«ما أحب أن أحدا عندي ذهبا فيأتي علي ثلاثة وعندي منه شيء إلا شيء أرصده في قضاء دين»","صحيح","Sahih al-Jami al-Saghir 5513","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5514","«ما أحب أن أسلم على الرجل وهو يصلي ولو سلم علي لرددت عليه»","صحيح","Sahih al-Jami al-Saghir 5514","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5515","«ما أحب أني حكيت إنسانا وأن لي كذا وكذا»","صحيح","Sahih al-Jami al-Saghir 5515","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5516","«ما أحب عبد عبدا لله إلا أكرم ربه»","حسن","Sahih al-Jami al-Saghir 5516","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5517","«ما أحد أعظم عندي يدا من أبي بكر واساني بنفسه وماله وأنكحني ابنته»","حسن","Sahih al-Jami al-Saghir 5517","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5518","«ما أحد أكثر من الربا إلا كان عاقبة أمره إلى قلة»","صحيح","Sahih al-Jami al-Saghir 5518","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5519","«ما أحد يدخل الجنة يحب أن يرجع إلى الدنيا وأن له ما على الأرض من شيء غير الشهيد فإنه يتمنى أن يرجع فيقتل عشر مرات لما يرى من الكرامة»","صحيح","Sahih al-Jami al-Saghir 5519","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5520","«ما أحرز الولد أو الوالد فهو لعصبة من كان»","حسن","Sahih al-Jami al-Saghir 5520","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5521","«ما اختلج عرق ولا عين إلا بذنب وما يدفع الله عنه أكثر»","صحيح","Sahih al-Jami al-Saghir 5521","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5522","«ما أخذت الدنيا من الآخرة إلا كما أخذ المخيط غمس في البحر من مائه»","صحيح","Sahih al-Jami al-Saghir 5522","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5523","«ما أخشى عليكم الفقر ولكني أخشى عليكم التكاثر وما أخشى عليكم الخطأ ولكني أخشى عليكم التعمد»","صحيح","Sahih al-Jami al-Saghir 5523","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5524","«ما أدري أتبع أنبيا كان أم لا؟ وما أدري ذا القرنين أنبيا كان أم لا؟ وما أدري الحدود كفارات لأهلها أم لا؟»","صحيح","Sahih al-Jami al-Saghir 5524","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5525","«ما أذن الله لشيء ما أذن لنبي حسن الصوت يتغنى بالقرآن يجهر به»","صحيح","Sahih al-Jami al-Saghir 5525","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5526","«ما أرى الأمر إلا أعجل من ذلك»","صحيح","Sahih al-Jami al-Saghir 5526","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5527","«ما استكبر من أكل معه خادمه وركب الحمار بالأسواق واعتقل الشاة فحلبها»","حسن","Sahih al-Jami al-Saghir 5527","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5528","«ما أسفرتم بالصبح فإنه أعظم للأجر»","صحيح","Sahih al-Jami al-Saghir 5528","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5529","«ما أسفل الكعبين من الإزار ففي النار»","صحيح","Sahih al-Jami al-Saghir 5529","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5530","«ما أسكر كثيره فقليله حرام»","صحيح","Sahih al-Jami al-Saghir 5530","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5531","«ما أسكر منه الفرق فملء الكف منه حرام»","صحيح","Sahih al-Jami al-Saghir 5531","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5532","«ما أصاب الحجام فاعلفوه الناضح»","صحيح","Sahih al-Jami al-Saghir 5532","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5533","ما أصاب بحده فكله وما أصاب بعرضه فقتل فإنه وقيذ فلا تأكله","صحيح","Sahih al-Jami al-Saghir 5533","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5534","«ما أصبحت غداة قط إلا استغفرت الله تعالى فيها مائة مرة»","صحيح","Sahih al-Jami al-Saghir 5534","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5535","«ما أطعمت زوجتك فهو لك صدقة وما أطعمت ولدك فهو لك صدقة وما أطعمت خادمك فهو لك صدقة وما أطعمت نفسك فهو لك صدقة»","صحيح","Sahih al-Jami al-Saghir 5535","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5536","«ما أطيبك من بلد وأحبك إلي ولولا أن قومي أخرجوني منك ما سكنت غيرك» . - قاله لمكة -","صحيح","Sahih al-Jami al-Saghir 5536","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5537","«ما أظلت الخضراء ولا أقلت الغبراء من ذي لهجة أصدق من أبي ذر»","صحيح","Sahih al-Jami al-Saghir 5537","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5538","«ما أظلت الخضراء ولا أقلت الغبراء من ذي لهجة أصدق ولا أوفى من أبي ذر شبه عيسى ابن مريم»","حسن","Sahih al-Jami al-Saghir 5538","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5539","«ما أظن فلانا وفلانا يعرفان من ديننا شيئا»","صحيح","Sahih al-Jami al-Saghir 5539","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5540","«ما أعطى الرجل امرأته فهو صدقة»","صحيح","Sahih al-Jami al-Saghir 5540","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5541","«ما أعطي أهل بيت الرفق إلا نفعهم»","صحيح","Sahih al-Jami al-Saghir 5541","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5542","«ما أعطيكم ولا أمنعكم أنا قاسم أضع حيث أمرت»","صحيح","Sahih al-Jami al-Saghir 5542","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5543","«ما اغبرت قدما عبد في سبيل الله إلا حرم الله عليه النار»","صحيح","Sahih al-Jami al-Saghir 5543","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5544","«ما أقفر من أدم بيت فيه خل»","حسن","Sahih al-Jami al-Saghir 5544","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5545","«ما أكفر رجل رجلا قط إلا باء بها أحدهما»","صحيح","Sahih al-Jami al-Saghir 5545","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5546","ما أكل أحد طعاما قط خيرا من أن يأكل من عمل يده، وإن نبي الله داود كان يأكل من عمل يده","صحيح","Sahih al-Jami al-Saghir 5546","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5547","«ما الدنيا في الآخرة إلا كما يمشي أحدكم إلى اليم فأدخل إصبعه فيه فما خرج منه فهو الدنيا»","صحيح","Sahih al-Jami al-Saghir 5547","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5548","«ما العمل في أيام أفضل منه في عشر ذي الحجة ولا الجهاد في سبيل الله إلا رجل خرج يخاطر بنفسه وماله فلم يرجع من ذلك بشيء»","صحيح","Sahih al-Jami al-Saghir 5548","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5549","«ما المسئول عنها - يعني الساعة - بأعلم من السائل وسأخبرك عن أشراطها إذا ولدت الأمة ربتها فذلك من أشراطها وإذا كانت العراة الحفاة رءوس الناس فذاك من أشراطها وإذا تطأول رعاء البهم في البنيان فذاك من أشراطها في خمس من الغيب لا يعلمهن إلا الله: {إِنَّ اللَّهَ عِنْدَهُ عِلْمُ السَّاعَةِ} الآية»","صحيح","Sahih al-Jami al-Saghir 5549","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5550","«ما أمرت بتشييد المساجد»","صحيح","Sahih al-Jami al-Saghir 5550","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5551","«ما أمرت كلما بلت أن أتوضأ ولو فعلت لكانت سنة»","حسن","Sahih al-Jami al-Saghir 5551","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5552","«ما أمرتكم به فخذوه، وما نهيتكم عنه فانتهوا»","صحيح","Sahih al-Jami al-Saghir 5552","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5553","«ما أمسك عليك فكل»","صحيح","Sahih al-Jami al-Saghir 5553","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5554","«ما أنا حملتكم ولكن الله حملكم وإني والله إن شاء الله لا أحلف على يمين فأرى غيرها خيرا منها إلا كفرت عن يميني وأتيت الذي هو خير»","صحيح","Sahih al-Jami al-Saghir 5554","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5555","«ما أنا والدنيا وما أنا والرقم»","صحيح","Sahih al-Jami al-Saghir 5555","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5556","«ما أنتم بأسمع لما أقول منهم غير أنهم لا يستطيعون أن يردوا علي شيئا»","صحيح","Sahih al-Jami al-Saghir 5556","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5557","«ما أنتم بجزء من مائة ألف جزء ممن يرد علي الحوض»","صحيح","Sahih al-Jami al-Saghir 5557","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5558","«ما أنزل الله داء إلا أنزل له الدواء»","صحيح","Sahih al-Jami al-Saghir 5558","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5559","«ما أنزل الله داء إلا أنزل له شفاء»","صحيح","Sahih al-Jami al-Saghir 5559","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5560","«ما أنزل الله في التوراة ولا في الإنجيل مثل أم القرآن وهي السبع المثاني وهي مقسومة بيني وبين عبدي ولعبدي ما سأل»","صحيح","Sahih al-Jami al-Saghir 5560","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5561","«ما أنزل الله من السماء من بركة إلا أصبح فريق من الناس بها كافرين ينزل الله الغيث فيقولون: بكوكب كذا وكذا»","صحيح","Sahih al-Jami al-Saghir 5561","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5562","«ما أنعم الله على عبد نعمة فحمد الله عليها إلا كان ذلك الحمد أفضل من تلك النعمة.. ... »","حسن","Sahih al-Jami al-Saghir 5562","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5563","«ما أنعم الله تعالى على عبد نعمة فقال: الحمد لله إلا كان الذي أعطي أفضل مما أخذ»","صحيح","Sahih al-Jami al-Saghir 5563","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5564","«ما أنكر قلبك فدعه»","صحيح","Sahih al-Jami al-Saghir 5564","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5565","«ما أنهر الدم وذكر اسم الله عليه فكلوه ليس السن والظفر وسأحدثكم عن ذلك أما السن فعظم وأما الظفر فمدى الحبشة»","صحيح","Sahih al-Jami al-Saghir 5565","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5566","«ما أوتيكم من شيء ولا أمنعكموه إن أنا إلا خازن أضع حيث أمرت»","صحيح","Sahih al-Jami al-Saghir 5566","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5567","«ما أوذي أحد ما أوذيت»","حسن","Sahih al-Jami al-Saghir 5567","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5568","«ما أوذي أحد ما أو ذيت في الله»","حسن","Sahih al-Jami al-Saghir 5568","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5569","«ما أهل مهل قط ولا كبر مكبر قط إلا بشر بالجنة»","حسن","Sahih al-Jami al-Saghir 5569","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5570","«ما بال أحدكم يقوم مستقبل ربه فيتنخع أمامه؟! أيحب أن يستقبل فيتنخع في وجهه؟ فإن تنخع أحدكم فليتنخع عن يساره أو تحت قدمه فإن لم يجد فليقل هكذا» - يعني في ثوبه -","صحيح","Sahih al-Jami al-Saghir 5570","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5571","«ما بال أقوام جأوز بهم القتل اليوم حتى قتلوا الذرية؟ ألا إن خياركم أبناء المشركين ألا لا تقتلوا ذرية ألا لا تقتلوا ذرية كل نسمة تولد على الفطرة فما يزال عليها حتى يعرب عنها لسانها فأبواها يهودانها أو ينصرانها»","صحيح","Sahih al-Jami al-Saghir 5571","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5572","«ما بال أقوام قالوا كذا وكذا؟ لكني أصلي وأنام وأصوم وأفطر وأتزوج النساء فمن رغب عن سنتي فليس مني»","صحيح","Sahih al-Jami al-Saghir 5572","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5573","«ما بال أقوام يتنزهون عن الشيء أصنعه؟! فوالله إني لأعلمهم بالله وأشدهم له خشية»","صحيح","Sahih al-Jami al-Saghir 5573","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5574","«ما بال أقوام يرفعون أبصارهم إلى السماء في صلاتهم؟! لينتهن عن ذلك أو لتخطفن أبصارهم»","صحيح","Sahih al-Jami al-Saghir 5574","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5575","ما بال الذين يرمون بأيديهم في الصلاة كأنها أذناب الخيل الشمس؟ ألا يكفي أحدكم أن يضع يده على فخذه ويسلم عن يمينه وشماله؟","صحيح","Sahih al-Jami al-Saghir 5575","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5576","«ما بال رجال يواصلون؟! إنكم لستم مثلي أما والله لومد لي الشهر لواصلت وصالا يدع المتعمقون تعمقهم»","صحيح","Sahih al-Jami al-Saghir 5576","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5577","«ما بعث الله من نبي إلا أنذر أمته الدجال أنذره نوح والنبيون من بعده وإنه يخرج فيكم فما خفي عليكم من شأنه فليس يخفى عليكم أن ربكم ليس بأعور وإنه أعور العين اليمنى كأن عينه عنبة طافية ألا إن الله حرم عليكم دماءكم وأموالكم كحرمة يومكم هذا في بلدكم هذا في شهركم هذا ألا هل بلغت: اللهم اشهد ثلاثا ويحكم! انظروا لا ترجعوا بعدي كفارا يضرب بعضكم رقاب بعض»","صحيح","Sahih al-Jami al-Saghir 5577","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5578","«ما بعث الله من نبي إلا قد أنذر أمته الدجال الأعور الكذاب ألا وإنه أعور وإن ربكم ليس بأعور مكتوب بين عينيه كافر يقرؤه كل مؤمن»","صحيح","Sahih al-Jami al-Saghir 5578","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5579","«ما بعث الله من نبي ولا استخلف من خليفة إلا كانت له بطانتان: بطانة تأمره بالمعروف وتحضه عليه وبطانة تأمره بالشر وتحضه فالمعصوم من عصمه الله»","صحيح","Sahih al-Jami al-Saghir 5579","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5580","ما بعث الله من نبي ولا كان بعده من خليفة إلا كان له بطانتان: بطانة تأمره بالمعروف وتنهاه عن المنكر وبطانة لا تألوه خبالا فمن وقي بطانة السوء فقد وقي","صحيح","Sahih al-Jami al-Saghir 5580","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5581","«ما بعث الله نبيا إلا رعى الغنم وأنا كنت أرعاها لأهل مكة بالقراريط»","صحيح","Sahih al-Jami al-Saghir 5581","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5582","«ما بلغ أن تؤدي زكاته فزكي فليس بكنز»","حسن","Sahih al-Jami al-Saghir 5582","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5583","«ما بين السرة والركبة عورة»","حسن","Sahih al-Jami al-Saghir 5583","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5584","«ما بين المشرق والمغرب قبلة»","صحيح","Sahih al-Jami al-Saghir 5584","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5585","«ما بين النفختين أربعون ثم ينزل الله من السماء ماء فينبتون كما ينبت البقل وليس من الإنسان شيء إلا يبلى إلا عظم واحد وهو: عجب الذنب منه خلق ومنه يركب يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 5585","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5586","«ما بين بيتي ومنبري روضة من رياض الجنة»","صحيح","Sahih al-Jami al-Saghir 5586","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5587","«ما بين بيتي ومنبري روضة من رياض الجنة ومنبري على حوضي»","صحيح","Sahih al-Jami al-Saghir 5587","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5588","«ما بين خلق آدم إلى قيام الساعة أمر أكبر من الدجال»","صحيح","Sahih al-Jami al-Saghir 5588","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5589","«ما بين لابتي المدينة حرام»","صحيح","Sahih al-Jami al-Saghir 5589","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5590","«ما بين مصراعين من مصاريع الجنة مسيرة أربعين عاما وليأتين عليه يوم وإنه لكظيظ»","صحيح","Sahih al-Jami al-Saghir 5590","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5591","«ما بين منكبي الكافر في النار مسيرة ثلاثة أيام للراكب المسرع»","صحيح","Sahih al-Jami al-Saghir 5591","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5592","«ما بين ناحيتي حوضي كما بين صنعاء والمدينة أو كما بين المدينة وعمان ترى فيه أباريق الذهب والفضة كعدد نجوم السماء أو أكثر»","صحيح","Sahih al-Jami al-Saghir 5592","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5593","«ما تأمرني؟! تأمرني أن آمره أن يدع يده في فيك تقضمها كما يقضم الفحل؟! ادفع يدك حتى يعضها ثم انتزعها»","صحيح","Sahih al-Jami al-Saghir 5593","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5594","«ما تحاب اثنان في الله تعالى إلا كان أفضلهما أشدهما حبا لصاحبه»","صحيح","Sahih al-Jami al-Saghir 5594","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5595","«ما تحت الكعبين من الإزار ففي النار»","صحيح","Sahih al-Jami al-Saghir 5595","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5596","«ما ترفع إبل الحاج رجلا ولا تضع يدا إلا كتب الله تعالى له بها حسنة أو محا عنه سيئة أو رفعه بها درجة»","حسن","Sahih al-Jami al-Saghir 5596","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5597","«ما تركت بعدي فتنة أضر على الرجال من النساء»","صحيح","Sahih al-Jami al-Saghir 5597","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5598","«ما تريدون من علي؟ ما تريدون من علي؟ ما تريدون من علي؟ إن عليا مني وأنا منه وهو ولي كل مؤمن بعدي»","صحيح","Sahih al-Jami al-Saghir 5598","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5599","«ما تستقل الشمس فيبقى شيء من خلق الله إلا سبح الله بحمده إلا ما كان من الشياطين وأغبياء بني آدم»","حسن","Sahih al-Jami al-Saghir 5599","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5600","«ما تصدق أحد بصدقة من طيب ولا يقبل الله إلا الطيب إلا أخذها الرحمن بيمينه وإن كانت تمرة فتربوفي كف الرحمن حتى تكون أعظم من الجبل كما يربي أحدكم فلوه أو فصيله»","صحيح","Sahih al-Jami al-Saghir 5600","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5601","«ما تقولون؟ إن كان أمر دنياكم فشأنكم وإن كان أمر دينكم فإلي»","صحيح","Sahih al-Jami al-Saghir 5601","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5602","«ما تقولون في الشهيد فيكم؟ قالوا: القتل في سبيل الله قال: إن شهداء أمتي إذن لقليل من قتل في سبيل الله فهو شهيد ومن مات في سبيل الله فهو شهيد والمبطون شهيد والمطعون شهيد والغرق شهيد»","صحيح","Sahih al-Jami al-Saghir 5602","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5603","«ما تواد اثنان في الله فيفرق بينهما إلا بذنب يحدثه أحدهما»","صحيح","Sahih al-Jami al-Saghir 5603","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5604","«ما توطن رجل مسلم المساجد للصلاة والذكر إلا تبشبش الله له من حين يخرج من بيته كما يتبشبش أهل الغائب بغائبهم إذا قدم عليهم»","حسن","Sahih al-Jami al-Saghir 5604","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5605","«ما توفى الله نبيا قط إلا دفن حيث يقبض روحه»","صحيح","Sahih al-Jami al-Saghir 5605","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5606","«ما جعل الله منية عبد بأرض إلا جعل له فيها حاجة»","صحيح","Sahih al-Jami al-Saghir 5606","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5607","«ما جلس قوم مجلسا لم يذكروا الله تعالى فيه ولم يصلوا على نبيهم إلا كان عليهم ترة فإن شاء عذبهم وإن شاء غفر لهم»","صحيح","Sahih al-Jami al-Saghir 5607","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5608","«ما جلس قوم يذكرون الله إلا حفتهم الملائكة وغشيتهم الرحمة ونزلت عليهم السكينة وذكرهم الله فيمن عنده»","صحيح","Sahih al-Jami al-Saghir 5608","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5609","«ما جلس قوم يذكرون الله تعالى إلا ناداهم مناد من السماء: قوموا مغفورا لكم»","صحيح","Sahih al-Jami al-Saghir 5609","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5610","ما جلس قوم يذكرون الله تعالى فيقومون حتى يقال لهم: قوموا قد غفر الله لكم ذنوبكم وبدلت سيئاتكم حسنات","صحيح","Sahih al-Jami al-Saghir 5610","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5611","«ما حاك في صدرك فدعه»","صحيح","Sahih al-Jami al-Saghir 5611","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5612","«ما حبست الشمس على بشر قط إلا على يوشع بن نون ليالي سار إلى بيت المقدس»","صحيح","Sahih al-Jami al-Saghir 5612","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5613","«ما حسدتكم اليهود على شيء ما حسدتكم على السلام والتأمين»","صحيح","Sahih al-Jami al-Saghir 5613","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5614","«ما حق امرئ مسلم له شيء يريد أن يوصي فيه يبيت ليلتين إلا ووصيته مكتوبة عنده»","صحيح","Sahih al-Jami al-Saghir 5614","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5615","«ما حق امرئ مسلم له شيء يوصي فيه يبيت ثلاث ليال إلا ووصيته عنده مكتوبة»","صحيح","Sahih al-Jami al-Saghir 5615","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5616","«ما خالط قلب امرئ مسلم رهج في سبيل الله إلا حرم الله عليه النار»","صحيح","Sahih al-Jami al-Saghir 5616","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5617","«ما خرج رجل من بيته يطلب علما إلا سهل الله له طريقا إلى الجنة»","صحيح","Sahih al-Jami al-Saghir 5617","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5618","«ما خلف الكعبين ففي النار»","صحيح","Sahih al-Jami al-Saghir 5618","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5619","«ما خير عمار بين أمرين إلا اختار أرشدهما»","حسن","Sahih al-Jami al-Saghir 5619","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5620","«ما ذئبان جائعان أرسلا في غنم بأفسد لها من حرص المرء على المال والشرف لدينه»","صحيح","Sahih al-Jami al-Saghir 5620","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5621","«ما رأيت في الخير والشر كاليوم قط إنه صورت لي الجنة والنار حتى رأيتهما وراء الحائط»","صحيح","Sahih al-Jami al-Saghir 5621","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5622","«ما رأيت مثل النار نام هاربها ولا مثل الجنة نام طالبها»","حسن","Sahih al-Jami al-Saghir 5622","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5623","«ما رأيت منظرا قط إلا والقبر أفظع منه»","حسن","Sahih al-Jami al-Saghir 5623","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5624","«ما رأيت من ناقصات عقل ولا دين أغلب لذي لب منكن أما نقصان العقل فشهادة امرأتين بشهادة رجل وأما نقصان الدين فإن إحداكن تفطر رمضان وتقيم أياما لا تصلي»","صحيح","Sahih al-Jami al-Saghir 5624","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5625","«ما رأينا من فزع وإن وجدناه لبحرا»","صحيح","Sahih al-Jami al-Saghir 5625","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5626","«ما رزق عبد خيرا له ولا أوسع من الصبر»","صحيح","Sahih al-Jami al-Saghir 5626","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5627","ما زال بكم الذي رأيت من صنيعكم حتى خشيت أن يكتب عليكم ولو كتب عليكم ما قمتم به فصلوا أيها الناس في بيوتكم فإن أفضل صلاة المرء في بيته إلا الصلاة المكتوبة","صحيح","Sahih al-Jami al-Saghir 5627","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5628","«ما زال جبريل يوصيني بالجار حتى ظننت أنه سيورثه»","صحيح","Sahih al-Jami al-Saghir 5628","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5629","«ما زالت أكلة خيبر تعأودني كل عام حتى كان هذا أوان قطع أبهري»","صحيح","Sahih al-Jami al-Saghir 5629","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5630","«ما سأل رجل مسلم الله الجنة ثلاثا إلا قالت الجنة: اللهم أدخله الجنة ولا استجار رجل مسلم الله من النار ثلاثا إلا قالت النار: اللهم أجره مني»","صحيح","Sahih al-Jami al-Saghir 5630","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5631","«ما شأنكم تشيرون بأيديكم كأنها أذناب خيل شمس؟! إذا سلم أحدكم فليلتفت إلى أصحابه ولا يومئ بيده»","صحيح","Sahih al-Jami al-Saghir 5631","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5632","«ما شيء أثقل في ميزان المؤمن يوم القيامة من خلق حسن فإن الله تعالى يبغض الفاحش البذي»","صحيح","Sahih al-Jami al-Saghir 5632","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5633","«ما ضل قوم بعد هدى كانوا عليه إلا أوتوا الجدل»","حسن","Sahih al-Jami al-Saghir 5633","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5634","ما ظهر في قوم الربا والزنا إلا أحلوا بأنفسهم عقاب الله","حسن","Sahih al-Jami al-Saghir 5634","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5635","«ما على أحدكم إن وجد سعة أن يتخذ ثوبين ليوم الجمعة سوى ثوبي مهنته»","صحيح","Sahih al-Jami al-Saghir 5635","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5636","«ما على الأرض أحد يقول لا إله إلا الله والله أكبر ولا حول ولا قوة إلا بالله إلا كفرت عنه خطاياه ولو كانت مثل زبد البحر»","صحيح","Sahih al-Jami al-Saghir 5636","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5637","«ما على الأرض مسلم يدعوالله بدعوة إلا آتاه الله إياها أو صرف عنه من السوء مثلها ما لم يدع بإثم أو قطيعة رحم ما لم يعجل يقول: قد دعوت ودعوت فلم يستجب لي»","حسن","Sahih al-Jami al-Saghir 5637","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5638","«ما على الأرض من نفس تموت ولها عند الله خير تحب أن ترجع إليكم ولها الدنيا إلا القتيل في سبيل الله فإنه يحب أن يرجع فيقتل مرة أخرى لما يرى من ثواب الله له»","صحيح","Sahih al-Jami al-Saghir 5638","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5639","«ما على الأرض نفس منفوسة - يعني اليوم - يأتي عليها مائة سنة»","صحيح","Sahih al-Jami al-Saghir 5639","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5640","«ما على الأرض يمين أحلف عليها فأرى غيرها خيرا منها إلا أتيته»","صحيح","Sahih al-Jami al-Saghir 5640","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5641","«ما علمته إذ كان جاهلا ولا أطعمته إذ كان ساغبا»","صحيح","Sahih al-Jami al-Saghir 5641","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5642","«ما عليها لو انتفعت بإهابها إنما حرم الله أكلها»","صحيح","Sahih al-Jami al-Saghir 5642","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5643","«ما عليكم أن لا تعزلوا فإن الله قدر ما هو خالق إلى يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 5643","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5644","«ما عمل آدمي عملا أنجى له من عذاب الله من ذكر الله»","صحيح","Sahih al-Jami al-Saghir 5644","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5645","«ما عمل ابن آدم شيئا أفضل من الصلاة وصلاح ذات البين وخلق حسن»","صحيح","Sahih al-Jami al-Saghir 5645","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5646","«ما فتح رجل باب عطية بصدقة أو صلة إلا زاده الله تعالى بها كثرة وما فتح رجل باب مسألة يريد بها كثرة إلا زاده الله تعالى بها قلة»","صحيح","Sahih al-Jami al-Saghir 5646","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5647","«ما في الجنة شجرة إلا وساقها من ذهب»","صحيح","Sahih al-Jami al-Saghir 5647","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5648","«ما قال عبد لا إله إلا الله قط مخلصا إلا فتحت له أبواب السماء حتى تفضي إلى العرش ما اجتنب الكبائر»","حسن","Sahih al-Jami al-Saghir 5648","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5649","«ما قبض الله تعالى نبيا إلا في الموضع الذي يحب أن يدفن فيه»","صحيح","Sahih al-Jami al-Saghir 5649","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5650","«ما قدر الله لنفس أن يخلقها إلا هي كائنة»","صحيح","Sahih al-Jami al-Saghir 5650","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5651","«ما قدر في الرحم سيكون»","صحيح","Sahih al-Jami al-Saghir 5651","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5652","«ما قطع من البهيمة وهي حية فهو ميتة»","صحيح","Sahih al-Jami al-Saghir 5652","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5653","«ما قل وكفى خير مما كثر وألهى»","صحيح","Sahih al-Jami al-Saghir 5653","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5654","«ما كان الرفق في شيء إلا زانه ولا نزع من شيء إلا شانه»","صحيح","Sahih al-Jami al-Saghir 5654","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5655","«ما كان الفحش في شيء قط إلا شانه ولا كان الحياء في شيء قط إلا زانه»","صحيح","Sahih al-Jami al-Saghir 5655","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5656","«ما كان من حلف في الجاهلية فتمسكوا به ولا حلف في الإسلام»","صحيح","Sahih al-Jami al-Saghir 5656","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5657","«ما كان من ميراث قسم في الجاهلية فهو على قسمة الجاهلية وما كان من ميراث أدركه الإسلام فهو على قسمة الإسلام»","صحيح","Sahih al-Jami al-Saghir 5657","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5658","«ما كان منها في طريق الميتاء والقرية الجامعة فعرفها سنة فإن جاء طالبها فادفعها إليه وإن لم يأت فهي لك وما كان في الخراب ففيها وفي الركاز الخمس»","حسن","Sahih al-Jami al-Saghir 5658","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5659","«ما كرهت أن يراه الناس منك فلا تفعله بنفسك إذا خلوت»","حسن","Sahih al-Jami al-Saghir 5659","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5660","«ما كسب الرجل كسبا أطيب من عمل يده وما أنفق الرجل على نفسه وأهله وولده وخادمه فهو صدقة»","صحيح","Sahih al-Jami al-Saghir 5660","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5661","«ما لأحد عندنا يد إلا وقد كافأناه ما خلا أبا بكر فإن له عندنا يدا يكافئه الله بها يوم القيامة وما نفعني مال أحد قط ما نفعني مال أبي بكر ولو كنت متخذا خليلا لاتخذت أبا بكر خليلا ألا وإن صاحبكم خليل الله»","صحيح","Sahih al-Jami al-Saghir 5661","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5662","«ما لصبيكم هذا يبكي؟ هلا استرقيتم له من العين»","حسن","Sahih al-Jami al-Saghir 5662","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5663","«ما لكم والمجالس الصعدات اجتنبوا مجالس الصعدات أما لا فأدوا حقها: غض البصر ورد السلام وإهداء السبيل وحسن الكلام»","صحيح","Sahih al-Jami al-Saghir 5663","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5664","«ما لي أرى عليك حلية أهل النار» - يعني خاتم الحديد -","صحيح","Sahih al-Jami al-Saghir 5664","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5665","«ما لي أراكم رافعي أيديكم كأنها أذناب خيل شمس اسكنوا في الصلاة»","صحيح","Sahih al-Jami al-Saghir 5665","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5666","«ما لي أراكم عزين»","صحيح","Sahih al-Jami al-Saghir 5666","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5667","«ما لي رأيتكم أكثرتم التصفيق من نابه شيء في صلاته فليسبح فإنه إذا سبح التفت إليه وإنما التصفيق للنساء»","صحيح","Sahih al-Jami al-Saghir 5667","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5668","«ما لي وللدنيا! ما أنا في الدنيا إلا كراكب استظل تحت شجرة ثم راح وتركها»","صحيح","Sahih al-Jami al-Saghir 5668","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5669","«ما لي وللدنيا وما للدنيا وما لي! والذي نفسي بيده ما مثلي ومثل الدنيا إلا كراكب سار في يوم صائف فاستظل تحت شجرة ساعة من النهار ثم راح وتركها»","صحيح","Sahih al-Jami al-Saghir 5669","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5670","«ما مات نبي إلا دفن حيث يقبض»","صحيح","Sahih al-Jami al-Saghir 5670","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5671","«ما مررت ليلة أسري بي بملأ من الملائكة إلا قالوا: يا محمد مر أمتك بالحجامة»","صحيح","Sahih al-Jami al-Saghir 5671","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5672","«ما مررت ليلة أسري بي بملأ من الملائكة إلا كلهم يقول لي: عليك يا محمد بالحجامة»","صحيح","Sahih al-Jami al-Saghir 5672","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5673","«ما مسخ الله تعالى من شيء فكان له عقب ولا نسل»","صحيح","Sahih al-Jami al-Saghir 5673","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5674","«ما ملأ آدمي وعاء شرا من بطنه بحسب ابن آدم أكلات يقمن صلبه فإن كان لا محالة فثلث لطعامه وثلث لشرابه وثلث لنفسه»","صحيح","Sahih al-Jami al-Saghir 5674","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5675","«ما من آدمي إلا في رأسه حكمة بيد ملك فإذا تواضع قيل للملك ارفع حكمته وإذا تكبر قيل للملك: دع حكمته»","حسن","Sahih al-Jami al-Saghir 5675","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5676","«ما من أحد لا يؤدي زكاة ماله إلا مثل له يوم القيامة شجاعا أقرع حتى يطوق عنقه»","صحيح","Sahih al-Jami al-Saghir 5676","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5677","«ما من أحد يدان دينا يعلم الله منه أنه يريد قضاءه إلا أداه الله عنه في الدنيا»","صحيح","Sahih al-Jami al-Saghir 5677","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5678","«ما من أحد يدعوبدعاء إلا آتاه الله ما سأل أو كف عنه من السوء مثله ما لم يدع بإثم أو قطيعة رحم»","حسن","Sahih al-Jami al-Saghir 5678","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5679","«ما من أحد يسلم علي إلا رد الله علي روحي حتى أرد عليه السلام»","حسن","Sahih al-Jami al-Saghir 5679","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5680","«ما من أربعين من مؤمن يستغفرون لمؤمن إلا شفعهم الله فيه»","صحيح","Sahih al-Jami al-Saghir 5680","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5681","«ما من الأنبياء من نبي إلا وقد أعطي من الآيات ما مثله آمن عليه البشر وإنما كان الذي أوتيته وحيا أوحاه الله إلي فأرجوأن أكون أكثرهم تابعا يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 5681","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5682","«ما من القلوب قلب إلا وله سحابة كسحابة القمر بينما القمر يضيء إذ علته سحابة فأظلم إذ تجلت»","حسن","Sahih al-Jami al-Saghir 5682","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5683","«ما من الناس من مسلم يتوفى له ثلاثة لم يبلغوا الحنث إلا أدخله الله الجنة بفضل رحمته إياهم»","صحيح","Sahih al-Jami al-Saghir 5683","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5684","«ما من الناس من نفس مسلمة يقبضها ربها تحب أن ترجع إليكم وأن لها الدنيا وما فيها غير الشهداء ولأن أقتل في سبيل الله أحب إلي من أن يكون لي أهل الوبر والمدر»","حسن","Sahih al-Jami al-Saghir 5684","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5685","«ما من إمام أو وال يغلق بابه دون ذوي الحاجة والخلة والمسكنة إلا أغلق الله أبواب السماء دون خلته وحاجته ومسكنته»","صحيح","Sahih al-Jami al-Saghir 5685","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5686","«ما من امرئ مسلم تحضره صلاة مكتوبة فيحسن وضوءها وخشوعها وركوعها إلا كانت كفارة لما قبلها من الذنوب ما لم تؤت كبيرة وذلك الدهر كله»","صحيح","Sahih al-Jami al-Saghir 5686","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5687","«ما من امرئ مسلم يعود مسلما إلا ابتعث الله سبعين ألف ملك يصلون عليه في أي ساعات النهار كان حتى يمسي وأي ساعات الليل كان حتى يصبح»","صحيح","Sahih al-Jami al-Saghir 5687","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5688","«ما من امرئ مسلم ينقي لفرسه شعيرا ثم يعلقه عليه إلا كتب الله له بكل حبة حسنة»","صحيح","Sahih al-Jami al-Saghir 5688","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5689","«ما من امرئ يتوضأ فيحسن وضوءه ثم يصلي الصلاة إلا غفر له ما بينه وبين الصلاة الأخرى حتى يصليها»","صحيح","Sahih al-Jami al-Saghir 5689","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5690","ما من امرئ يخذل امرءا مسلما في موطن ينتقص فيه من عرضه وينتهك فيه من حرمته إلا خذله الله تعالى في موطن يحب فيه نصرته، وما من أحد ينصر مسلما في موطن ينتقص فيه من عرضه وينتهك فيه من حرمته إلا نصره الله في موطن يحب فيه نصرته","حسن","Sahih al-Jami al-Saghir 5690","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5691","«ما من امرئ يكون له صلاة بالليل فيغلبه عليها النوم إلا كتب الله تعالى له أجر صلاته وكان نومه عليه صدقة»","صحيح","Sahih al-Jami al-Saghir 5691","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5692","«ما من امرأة تخلع ثيابها في غير بيتها إلا هتكت ما بينها وبين الله»","صحيح","Sahih al-Jami al-Saghir 5692","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5693","«ما من أمة إلا وبعضها في النار وبعضها في الجنة إلا أمتي فإنها كلها في الجنة»","صحيح","Sahih al-Jami al-Saghir 5693","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5694","«ما من أمير إلا وله بطانتان من أهله بطانة تأمره بالمعروف وتنهاه عن المنكر وبطانة لا تألوه خبالا فمن وقي شرها فقد وقي وهو من التي تغلب عليه منهما»","صحيح","Sahih al-Jami al-Saghir 5694","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5695","«ما من أمير عشرة إلا وهو يؤتى به يوم القيامة مغلولا حتى يفكه العدل أو يوبقه الجور»","صحيح","Sahih al-Jami al-Saghir 5695","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5696","«ما من أمير عشرة إلا يؤتى به يوم القيامة ويده مغلولة إلى عنقه»","صحيح","Sahih al-Jami al-Saghir 5696","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5697","«ما من أمير يلي أمر المسلمين ثم لا يجهد لهم وينصح إلا لم يدخل معهم الجنة»","صحيح","Sahih al-Jami al-Saghir 5697","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5698","«ما من أهل بيت يغدوعليهم فدان إلا ذلوا»","صحيح","Sahih al-Jami al-Saghir 5698","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5699","«ما من بعير إلا في ذروته شيطان فإذا ركبتموها فاذكروا نعمة الله تعالى عليكم كما أمركم الله ثم امتهنوها لأنفسكم فإنما يحمل الله تعالى»","حسن","Sahih al-Jami al-Saghir 5699","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5700","«ما من بني آدم مولود إلا يمسه الشيطان حين يولد فيستهل صارخا من مس الشيطان غير مريم وابنها»","صحيح","Sahih al-Jami al-Saghir 5700","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5701","«ما من ثلاثة في قرية ولا بدولا تقام فيهم الصلاة إلا استحوذ عليهم الشيطان فعليكم بالجماعة فإنما يأكل الذئب القاصية»","حسن","Sahih al-Jami al-Saghir 5701","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5702","«ما من خارج خرج من بيته في طلب العلم إلا وضعت له الملائكة أجنحتها رضا بما يصنع حتى يرجع»","صحيح","Sahih al-Jami al-Saghir 5702","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5703","«ما من دعوة يدعوبها العبد أفضل من: اللهم إني أسألك المعافاة في الدنيا والآخرة»","صحيح","Sahih al-Jami al-Saghir 5703","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5704","ما من ذنب أجدر أن يعجل الله تعالى لصاحبه العقوبة في الدنيا مع ما يدخره له في الآخرة من البغي وقطيعة الرحم","صحيح","Sahih al-Jami al-Saghir 5704","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5705","«ما من ذنب أجدر أن يعجل الله تعالى لصاحبه العقوبة في الدنيا مع ما يدخره له في الآخرة من قطيعة الرحم والخيانة والكذب وإن أعجل الطاعة ثوابا لصلة الرحم حتى إن أهل البيت ليكونوا فجرة فتنموأموالهم ويكثر عددهم إذا تواصلوا»","صحيح","Sahih al-Jami al-Saghir 5705","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5706","«ما من راكب يخلو في مسيره بالله وذكره إلا كان ردفه ملك ولا يخلو بشعر ونحوه إلا كان ردفه شيطان»","حسن","Sahih al-Jami al-Saghir 5706","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5707","«ما من رجل له مال لا يؤدي حق ماله إلا جعل له طوقا في عنقه وهو شجاع أقرع وهو يفر منه وهو يتبعه»","صحيح","Sahih al-Jami al-Saghir 5707","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5708","«ما من رجل مسلم يموت فيقوم على جنازته أربعون رجلا لا يشركون بالله شيئا إلا شفعهم الله فيه»","صحيح","Sahih al-Jami al-Saghir 5708","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5709","«ما من رجل مسلم يموت له ثلاثة من ولده لم يبلغوا الحنث إلا أدخله الله الجنة بفضل رحمته إياهم»","صحيح","Sahih al-Jami al-Saghir 5709","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5710","«ما من رجل يتطهر يوم الجمعة كما أمر ثم يخرج من بيته حتى يأتي الجمعة وينصت حتى تقضى صلاته إلا كان كفارة لما قبله من الجمعة»","صحيح","Sahih al-Jami al-Saghir 5710","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5711","«ما من رجل يتعاظم في نفسه ويختال في مشيته إلا لقي الله تعالى وهو عليه غضبان»","صحيح","Sahih al-Jami al-Saghir 5711","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5712","«ما من رجل يجرح في جسده جراحة فيتصدق بها إلا كفر الله عنه مثل ما تصدق»","صحيح","Sahih al-Jami al-Saghir 5712","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5713","«ما من رجل يحفظ علما فكتمه إلا أتى يوم القيامة ملجما بلجام من نار»","صحيح","Sahih al-Jami al-Saghir 5713","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5714","«ما من رجل يدعوبدعاء إلا استجيب له فإما أن يعجل له في الدنيا وإما أن يدخر له في الآخرة،........ ما لم يدع بإثم أو قطيعة رحم أو يستعجل يقول: دعوت ربي فما استجاب لي»","صحيح","Sahih al-Jami al-Saghir 5714","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5715","«ما من رجل يسلك طريقا يطلب فيه علما إلا سهل الله له طريق الجنة ومن أبطأ به عمله لم يسرع به نسبه»","صحيح","Sahih al-Jami al-Saghir 5715","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5716","«ما من رجل يصلي عليه مائة إلا غفر له»","صحيح","Sahih al-Jami al-Saghir 5716","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5717","«ما من رجل يعود مريضا ممسيا إلا خرج معه سبعون ألف ملك يستغفرون له حتى يصبح ومن أتاه مصبحا خرج معه سبعون ألف ملك يستغفرون له حتى يمسي»","صحيح","Sahih al-Jami al-Saghir 5717","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5718","«ما من رجل يلي أمر عشرة فما فوق ذلك إلا أتى الله مغلولا يده إلى عنقه فكه بره أو أوثقه إثمه أولها ملامة وأوسطها ندامة وآخرها خزي يوم القيامة»","حسن","Sahih al-Jami al-Saghir 5718","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5719","«ما من رجل لا يؤدي زكاة ماله إلا جعل الله يوم القيامة في عنقه شجاعا أقرع ومن اقتطع مال أخيه المسلم بيمين لقي الله وهو عليه غضبان»","صحيح","Sahih al-Jami al-Saghir 5719","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5720","«ما من ساعة تمر بابن آدم لم يذكر الله فيها إلا حسر عليها يوم القيامة»","حسن","Sahih al-Jami al-Saghir 5720","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5721","«ما من شيء في الميزان أثقل من حسن الخلق»","صحيح","Sahih al-Jami al-Saghir 5721","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5722","«ما من شيء لم أكن أريته إلا رأيته في مقامي هذا حتى الجنة والنار ولقد أوحي إلى أنكم تفتنون في قبوركم مثل أو قريبا من فتنة المسيح الدجال يؤتى أحدكم فيقال له: ما علمك بهذا الرجل؟ فأما المؤمن أو الموقن فيقول: هو محمد رسول الله جاءنا بالبينات والهدى فأجبنا وآمنا واتبعنا هومحمد ثلاثا فيقال له: نم صالحا قد علمنا إن كنت لموقنا به وأما المنافق أو المرتاب فيقول: لا أدري سمعت الناس يقولون شيئا فقلته»","صحيح","Sahih al-Jami al-Saghir 5722","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5723","ما من شيء يصيب المؤمن حتى الشوكة تصيبه إلا كتب الله له بها حسنة وحط عنه بها خطيئة","صحيح","Sahih al-Jami al-Saghir 5723","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5724","«ما من شيء يصيب المؤمن في جسده يؤذيه إلا كفر الله عنه به من سيئاته»","صحيح","Sahih al-Jami al-Saghir 5724","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5725","«ما من شيء يصيب المؤمن من نصب ولا حزن ولا وصب حتى الهم يهمه إلا يكفر الله به عنه من سيئاته»","صحيح","Sahih al-Jami al-Saghir 5725","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5726","«ما من شيء يوضع في الميزان أثقل من حسن الخلق وإن صاحب حسن الخلق ليبلغ به درجة صاحب الصوم والصلاة»","صحيح","Sahih al-Jami al-Saghir 5726","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5727","«ما من صاحب إبل ولا بقر ولا غنم لا يؤدي زكاتها إلا جاءت يوم القيامة أعظم ما كانت وأسمنه تنطحه بقرونها وتطؤه بأخفافها كلما نفذت أخراها عادت عليه أولاها حتى يقضى بين الناس»","صحيح","Sahih al-Jami al-Saghir 5727","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5728","ما من صاحب إبل لا يفعل فيها حقها إلا جاءت يوم القيامة أكثر ما كانت قط وأقعد لها بقاع قرقر تستن عليه بقوائمها وأخفافها. وما من صاحب بقر لا يفعل فيها حقها إلا جاءت يوم القيامة أكثر ما كانت وأقعد لها بقاع قرقر تنطحه بقرونها وتطؤه بقوائمها. ولا صاحب غنم لا يفعل فيها حقها إلا جاءت يوم القيامة أكثر ما كانت وأقعد لها بقاع قرقر تنطحه بقرونها وتطؤه بأظلافها ليس فيها جماء ولا منكسر قرنها. ولا صاحب كنز لا يفعل فيه حقه إلا جاء كنزه يوم القيامة شجاعا أقرع يتبعه فاغرا فاه فإذا أتاه فر منه فيناديه ربه عز وجل: خذ كنزك الذي خبأته فأنا أغنى منك فإذا رأى أنه لا بد له منه سلك يده في فيه فيقضمها قضم الفحل","صحيح","Sahih al-Jami al-Saghir 5728","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5729","ما من صاحب ذهب ولا فضة لا يؤدي منها حقها إلا إذا كان يوم القيامة صفحت له صفائح من نار فأحمي عليها في نار جهنم فيكوى بها جنبه وجبينه وظهره كلما بردت أعيدت له في يوم كان مقداره خمسين ألف سنة حتى يقضى بين العباد فيرى سبيله إما إلى الجنة وإما إلى النار. ولا صاحب إبل لا يؤدي منها حقها ومن حقها حلبها يوم ورودها إلا إذا كان يوم القيامة بطح لها بقاع قرقر أوفر ما كانت لا يفقد منها فصيلا واحدا تطؤه بأخفافها وتعضه بأفواهها كلما مر عليه أولاها رد عليه أخراها في يوم كان مقداره خمسين ألف سنة حتى يقضى بين العباد فيرى سبيله إما إلى الجنة وإما إلى النار. ولا صاحب بقر ولا غنم لا يؤدي منها حقها إلا إذا كان يوم القيامة بطح لها بقاع قرقر لا يفقد منها شيئا ليس فيها عقصاء ولا جلحاء ولا عضباء تنطحه بقرونها وتطؤه بأظلافها كلما مر عليه أولاها رد عليه أخراها في يوم كان مقداره خمسين ألف سنة حتى يقضى بين العباد فيرى سبيله إما إلى الجنة وإما إلى النار","صحيح","Sahih al-Jami al-Saghir 5729","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5730","«ما من صلاة مفروضة إلا وبين يديها ركعتان»","صحيح","Sahih al-Jami al-Saghir 5730","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5731","«ما من عام إلا والذي بعده شر منه حتى تلقوا ربكم»","صحيح","Sahih al-Jami al-Saghir 5731","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5732","«ما من عبد إلا وله صيت في السماء فإن كان صيته في السماء حسنا وضع في الأرض وإن كان صيته في السماء سيئا وضع في الأرض»","صحيح","Sahih al-Jami al-Saghir 5732","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5733","«ما من عبد قال: لا إله إلا الله ثم مات على ذلك إلا دخل الجنة وإن زنا وإن سرق وإن زنا وإن سرق وإن رغم أنف أبي ذر»","صحيح","Sahih al-Jami al-Saghir 5733","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5734","«ما من عبد كانت له نية في أداء دينه إلا كان له من الله عون»","صحيح","Sahih al-Jami al-Saghir 5734","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5735","«ما من عبد مؤمن إلا وله ذنب يعتاده الفينة بعد الفينة أو ذنب هومقيم عليه لا يفارقه حتى يفارق الدنيا إن المؤمن خلق مفتنا توابا نسيا إذا ذكر ذكر»","صحيح","Sahih al-Jami al-Saghir 5735","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5736","«ما من عبد مسلم توضأ فأسبغ الوضوء ثم صلى لله في كل يوم ثنتي عشرة ركعة تطوعا غير فريضة إلا بنى الله له بيتا في الجنة»","صحيح","Sahih al-Jami al-Saghir 5736","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5737","«ما من عبد مسلم يدعولأخيه بظهر الغيب إلا قال الملك: ولك بمثل»","صحيح","Sahih al-Jami al-Saghir 5737","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5738","«ما من عبد يذنب ذنبا فيتوضأ فيحسن الطهور ثم يقوم فيصلي ركعتين ثم يستغفر الله بذلك الذنب إلا غفر الله له»","صحيح","Sahih al-Jami al-Saghir 5738","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5739","«ما من عبد يرفع يديه........ يسأل الله مسألة إلا آتاه إياها ما لم يعجل يقول: قد سألت وسألت فلم أعط شيئا»","صحيح","Sahih al-Jami al-Saghir 5739","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5740","«ما من عبد يسترعيه الله رعية يموت يوم يموت وهو غاش لرعيته إلا حرم الله عليه الجنة»","صحيح","Sahih al-Jami al-Saghir 5740","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5741","«ما من عبد يسجد لله سجدة إلا رفعه الله بها درجة وحط عنه بها خطيئة»","صحيح","Sahih al-Jami al-Saghir 5741","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5742","«ما من عبد يسجد لله سجدة إلا كتب الله له بها حسنة وحط عنه بها سيئة ورفع له بها درجة فاستكثروا من السجود»","صحيح","Sahih al-Jami al-Saghir 5742","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5743","«ما من عبد يصرع صرعة من مرض إلا بعثه الله منها طاهرا»","صحيح","Sahih al-Jami al-Saghir 5743","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5744","«ما من عبد يصلي علي إلا صلت عليه الملائكة ما دام يصلي علي فليقل العبد من ذلك أو ليكثر»","حسن","Sahih al-Jami al-Saghir 5744","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5745","«ما من عبد يقول في صباح كل يوم ومساء كل ليلة: بسم الله الذي لا يضر مع اسمه شيء في الأرض ولا في السماء وهو السميع العليم ثلاث مرات فيضره شيء»","صحيح","Sahih al-Jami al-Saghir 5745","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5746","«ما من غازية تغزوفي سبيل الله فيصيبون الغنيمة إلا تعجلوا ثلثي أجرهم من الآخرة ويبقى لهم الثلث فإن لم يصيبوا غنيمة تم لهم أجرهم»","صحيح","Sahih al-Jami al-Saghir 5746","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5747","«ما من قلب إلا وهو معلق بين إصبعين من أصابع الرحمن إن شاء أقامه وإن شاء أزاغه والميزان بيد الرحمن يرفع أقواما ويخفض آخرين إلى يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 5747","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5748","«ما من قوم يذكرون الله إلا حفت بهم الملائكة وغشيتهم الرحمة ونزلت عليهم السكينة وذكرهم الله فيمن عنده»","صحيح","Sahih al-Jami al-Saghir 5748","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5749","«ما من قوم يعمل فيهم بالمعاصي هم أعز وأكثر ممن يعمله ثم لم يغيروه إلا عمهم الله تعالى منه بعقاب»","صحيح","Sahih al-Jami al-Saghir 5749","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5750","«ما من قوم يقومون من مجلس لا يذكرون الله تعالى فيه إلا قاموا عن مثل جيفة حمار وكان ذلك المجلس عليهم حسرة يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 5750","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5751","ما من كل الماء يكون الولد وإذا أراد الله خلق شيء لم يمنعه شيء","صحيح","Sahih al-Jami al-Saghir 5751","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5752","«ما من مؤمن إلا أنا أولى به في الدنيا والآخرة اقرءوا إن شئتم: {النَّبِيُّ أولَى بِالْمُؤْمِنِينَ مِنْ أَنْفُسِهِمْ} فأيما مؤمن مات وترك مالا فليرثه عصبته من كانوا ومن ترك دينا أو ضياعا فليأتني فأنا مولاه»","صحيح","Sahih al-Jami al-Saghir 5752","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5753","«ما من مجروح يجرح في سبيل الله والله أعلم بمن يجرح في سبيله إلا جاء يوم القيامة وجرحه كهيئته يوم جرح اللون لون الدم والريح ريح المسك»","صحيح","Sahih al-Jami al-Saghir 5753","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5754","«ما من مسلم يبيت على ذكر طاهرا فيتعار من الليل فيسأل الله تعالى خيرا من أمر الدنيا والآخرة إلا أعطاه إياه»","صحيح","Sahih al-Jami al-Saghir 5754","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5755","«ما من مسلم يتطهر فيتم الطهور الذي كتب الله عليه فيصلي هذه الصلوات الخمس إلا كانت كفارة لما بينهن»","صحيح","Sahih al-Jami al-Saghir 5755","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5756","«ما من مسلم يتوضأ فيحسن وضوءه ثم يقوم فيصلي ركعتين يقبل عليهما بقلبه ووجهه إلا وجبت له الجنة»","صحيح","Sahih al-Jami al-Saghir 5756","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5757","«ما من مسلم يزرع زرعا أو يغرس غرسا فيأكل منه طير أو إنسان أو بهيمة إلا كانت له به صدقة»","صحيح","Sahih al-Jami al-Saghir 5757","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5758","ما من مسلم يشاك شوكة فما فوقها إلا كتبت له بها درجة، ومحيت عنه بها خطيئة","صحيح","Sahih al-Jami al-Saghir 5758","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5759","«ما من مسلم يشهد له ثلاثة إلا وجبت له الجنة قيل واثنان؟ قال: واثنان»","صحيح","Sahih al-Jami al-Saghir 5759","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5760","«ما من مسلم يشيب شيبة في الإسلام إلا كتب الله له بها حسنة وحط عنه بها خطيئة»","صحيح","Sahih al-Jami al-Saghir 5760","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5761","«ما من مسلم يصاب في جسده إلا أمر الله تعالى الحفظة: اكتبوا لعبدي في كل يوم وليلة من الخير ما كان يعمل ما دام محبوسا في وثاقي»","صحيح","Sahih al-Jami al-Saghir 5761","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5762","«ما من مسلم يصلي عليه أمة إلا شفعوا فيه»","حسن","Sahih al-Jami al-Saghir 5762","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5763","«ما من مسلم يصيبه أذى شوكة فما فوقها إلا حط الله له به سيئاته كما تحط الشجرة ورقها»","صحيح","Sahih al-Jami al-Saghir 5763","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5764","«ما من مسلم تصيبه مصيبة فيقول ما أمره الله: {إِنَّا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ} اللهم أجرني في مصيبتي واخلف لي خيرا منها إلا أجره الله في مصيبته وأخلف الله له خيرا منها»","صحيح","Sahih al-Jami al-Saghir 5764","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5765","ما من مسلم يظلم مظلمة فيقاتل فيقتل إلا قتل شهيدا","صحيح","Sahih al-Jami al-Saghir 5765","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5766","«ما من مسلم يعود مريضا لم يحضر أجله فيقول سبع مرات: أسأل الله العظيم رب العرش العظيم أن يشفيك إلا عوفي»","صحيح","Sahih al-Jami al-Saghir 5766","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5767","«ما من مسلم يعود مسلما غدوة إلا صلى عليه سبعون ألف ملك حتى يمسي وإن عاده عشية صلى عليه سبعون ألف ملك حتى يصبح وكان له خريف في الجنة»","صحيح","Sahih al-Jami al-Saghir 5767","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5768","«ما من مسلم يغرس غرسا إلا كان ما أكل منه له صدقة وما سرق منه صدقة وما أكل السبع فهو له صدقة وما أكلت الطيور فهو له صدقة ولا يرزؤه أحد كان له صدقة»","صحيح","Sahih al-Jami al-Saghir 5768","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5769","«ما من مسلم يقرض مسلما قرضا مرتين إلا كان كصدقتها مرة»","صحيح","Sahih al-Jami al-Saghir 5769","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5770","«ما من مسلم يلبي إلا لبى ما عن يمينه وشماله من حجر أو شجر أو مدر حتى تنقطع الأرض من هاهنا وهاهنا»","صحيح","Sahih al-Jami al-Saghir 5770","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5771","ما من مسلم يموت فيقوم على جنازته أربعون رجلا لا يشركون بالله شيئا إلا شفعوا فيه","صحيح","Sahih al-Jami al-Saghir 5771","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5772","«ما من مسلم يموت له ثلاثة من الولد ما لم يبلغوا الحنث إلا تلقوه من أبواب الجنة الثمانية من أيها شاء دخل»","حسن","Sahih al-Jami al-Saghir 5772","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5773","«ما من مسلم يموت يوم الجمعة أو ليلة الجمعة إلا وقاه الله تعالى فتنة القبر»","حسن","Sahih al-Jami al-Saghir 5773","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5774","«ما من مسلم ينفق من كل مال له زوجين في سبيل الله إلا استقبلته حجبة الجنة كلهم يدعوه إلى ما عنده»","صحيح","Sahih al-Jami al-Saghir 5774","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5775","«ما من مسلمين التقيا بأسيافهما إلا كان القاتل والمقتول في النار»","صحيح","Sahih al-Jami al-Saghir 5775","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5776","«ما من مسلمين يتوفى لهما ثلاثة من الولد لم يبلغوا الحنث إلا أدخلهما الله الجنة بفضل رحمته إياهم»","صحيح","Sahih al-Jami al-Saghir 5776","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5777","«ما من مسلمين يلتقيان فيتصافحان إلا غفر لهما قبل أن يتفرقا»","حسن","Sahih al-Jami al-Saghir 5777","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5778","«ما من مسلمين يلتقيان فيسلم أحدهما على صاحبه ويأخذ بيده لا يأخذ بيده إلا لله فلا يفترقان حتى يغفر لهما»","حسن","Sahih al-Jami al-Saghir 5778","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5779","ما من مسلمين يموت بينهما ثلاثة من أولادهما لم يبلغوا الحنث إلا غفر لهما","صحيح","Sahih al-Jami al-Saghir 5779","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5780","«ما من مسلمين يموت لهما ثلاثة أولاد لم يبلغوا الحنث إلا أدخلهما الله بفضل رحمته إياهم الجنة يقال لهم: ادخلوا الجنة فيقولون: حتى يدخل أبوانا فيقال: ادخلوا الجنة أنتم وأبواكم»","صحيح","Sahih al-Jami al-Saghir 5780","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5781","«ما من مسلمين يموت لهما ثلاثة من الولد لم يبلغوا حنثا إلا أدخلهما الله الجنة بفضل رحمته إياهم»","صحيح","Sahih al-Jami al-Saghir 5781","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5782","«ما من مصيبة تصيب المسلم إلا كفر الله بها عنه حتى الشوكة يشاكها»","صحيح","Sahih al-Jami al-Saghir 5782","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5783","«ما من مكلوم يكلم في الله إلا جاء يوم القيامة وكلمه يدمى اللون لون الدم والريح ريح المسك»","صحيح","Sahih al-Jami al-Saghir 5783","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5784","«ما من مولود إلا يولد على الفطرة فأبواه يهودانه أو ينصرانه أو يمجسانه كما تنتج البهيمة بهيمة جمعاء هل تحسون فيها من جدعاء»","صحيح","Sahih al-Jami al-Saghir 5784","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5785","«ما من مولود يولد إلا نخسه الشيطان فيستهل صارخا من نخسة الشيطان إلا ابن مريم وأمه»","صحيح","Sahih al-Jami al-Saghir 5785","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5786","ما من ميت يصلي عليه أمة من المسلمين، يبلغون أن يكونوا مائة فيشفعون له إلا شفعوا فيه","صحيح","Sahih al-Jami al-Saghir 5786","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5787","«ما من ميت يصلي عليه أمة من الناس إلا شفعوا فيه»","حسن","Sahih al-Jami al-Saghir 5787","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5788","«ما من ميت يموت فيقوم باكيهم فيقول: واجبلاه! واسنداه! أو نحوذلك إلا وكل به ملكان يلهزانه: هكذا كنت؟!»","حسن","Sahih al-Jami al-Saghir 5788","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5789","«ما من نبي إلا وقد أنذر أمته الأعور الكذاب ألا إنه أعور وإن ربكم ليس بأعور مكتوب بين عينيه» ك، ف، ر","صحيح","Sahih al-Jami al-Saghir 5789","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5790","«ما من نبي بعثه الله في أمة قبلي إلا كان له من أمته حواريون وأصحاب يأخذون بسنته ويتقيدون بأمره ثم إنها تخلف من بعدهم خلوف يقولون ما لا يفعلون ويفعلون ما لا يؤمرون فمن جاهدهم بيده فهو مؤمن ومن جاهدهم بلسانه فهو مؤمن ومن جاهدهم بقلبه فهو مؤمن ليس وراء ذلك من الإيمان حبة خردل»","صحيح","Sahih al-Jami al-Saghir 5790","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5791","«ما من نبي يمرض إلا خير بين الدنيا والآخرة»","صحيح","Sahih al-Jami al-Saghir 5791","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5792","«ما من نفس تموت لها عند الله خير يسرها أن ترجع إلى الدنيا وأن لها الدنيا وما فيها إلا الشهيد فإنه يتمنى أن يرجع إلى الدنيا فيقتل مرة أخرى لما يرى من فضل الشهادة»","صحيح","Sahih al-Jami al-Saghir 5792","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5793","ما من نفس تموت وهي تشهد أن لا إله إلا الله، وأني رسول الله يرجع ذلك إلى قلب موقن إلا غفر الله له","حسن","Sahih al-Jami al-Saghir 5793","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5794","«ما من نفس منفوسة إلا وقد كتب الله مكانها من الجنة والنار وإلا وقد كتبت شقية أو سعيدة قيل: أفلا نتكل؟ قال: لا اعملوا ولا تتكلوا فكل ميسر لما خلق له أما أهل السعادة فييسرون لعمل أهل السعادة وأما أهل الشقأوة فييسرون لعمل أهل الشقأوة»","صحيح","Sahih al-Jami al-Saghir 5794","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5795","«ما من نفس منفوسة اليوم يأتي عليها مائة سنة وهي يومئذ حية»","صحيح","Sahih al-Jami al-Saghir 5795","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5796","«ما من يوم أكثر من أن يعتق الله فيه عبدا أو أمة من النار من يوم عرفة وإنه ليدنوثم يباهي بهم الملائكة فيقول: ماذا أراد هؤلاء؟»","صحيح","Sahih al-Jami al-Saghir 5796","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5797","«ما من يوم يصبح العباد فيه إلا ملكان ينزلان فيقول أحدهما: اللهم أعط منفقا خلفا ويقول الآخر: اللهم أعط ممسكا تلفا»","صحيح","Sahih al-Jami al-Saghir 5797","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5798","«ما منكم من أحد إلا سيكلمه الله يوم القيامة ليس بينه وبينه ترجمان فينظر أيمن منه فلا يرى إلا ما قدم وينظر أشأم منه فلا يرى إلا ما قدم وينظر بين يديه فلا يرى إلا النار تلقاء وجهه فاتقوا النار ولو بشق تمرة ولو بكلمة طيبة»","صحيح","Sahih al-Jami al-Saghir 5798","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5799","«ما منكم من أحد إلا له منزلان: منزل في الجنة ومنزل في النار فإذا مات فدخل النار ورث أهل الجنة منزله فذلك قوله: {هُمُ الْوَارِثُونَ} »","صحيح","Sahih al-Jami al-Saghir 5799","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5800","«ما منكم من أحد إلا وقد وكل به قرينه من الجن وقرينه من الملائكة قالوا: وإياك؟ قال: وإياي إلا أن الله أعانني عليه فأسلم فلا يأمرني إلا بخير»","صحيح","Sahih al-Jami al-Saghir 5800","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5801","«ما منكم من أحد إلا ومعه شيطان قالوا: وأنت يا رسول الله؟ قال: وأنا إلا أن الله أعانني عليه فأسلم»","صحيح","Sahih al-Jami al-Saghir 5801","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5802","«ما منكم من أحد يتوضأ فيحسن الوضوء ثم يقوم فيركع ركعتين يقبل عليهما بقلبه ووجهه إلا وجبت له الجنة وغفر له»","صحيح","Sahih al-Jami al-Saghir 5802","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5803","«ما منكم من أحد يتوضأ فيسبغ الوضوء ثم يقول حين يفرغ من وضوئه: أشهد أن لا إله إلا الله وحده لا شريك له وأن محمدا عبده ورسوله إلا فتحت له أبواب الجنة الثمانية يدخل من أيها شاء»","صحيح","Sahih al-Jami al-Saghir 5803","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5804","ما منكم من رجل يقرب وضوءه فيتمضمض ويمج ويستنشق فينتثر إلا جرت خطايا وجهه وفيه وخياشيمه ثم إذا غسل وجهه كما أمره الله إلا جرت خطايا وجهه من أطراف لحيته مع الماء ثم يغسل يديه إلى المرفقين إلا جرت خطايا يديه من أطراف أنامله مع الماء ثم يمسح رأسه كما أمره الله إلا جرت خطايا رأسه من أطراف شعره مع الماء ثم يغسل قدميه إلى الكعبين كما أمره الله إلا جرت خطايا رجليه من أطراف أنامله مع الماء فإن هوقام فصلى فحمد الله وأثنى عليه ومجده بالذي هوأهله وفرغ قلبه لله إلا انصرف من خطيئته كهيئته يوم ولدته أمه","صحيح","Sahih al-Jami al-Saghir 5804","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5805","«ما منكن امرأة تقدم بين يديها ثلاثة من ولدها إلا كانوا لها حجابا من النار قالت امرأة: واثنين؟ قال واثنين»","صحيح","Sahih al-Jami al-Saghir 5805","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5806","«ما منعك يا أبي أن تجيبني إذ دعوتك؟ ألم تجد فيما أوحى الله إلي أن {اسْتَجِيبُوا لِلَّهِ وَلِلرَّسُولِ إِذَا دَعَاكُمْ لِمَا يُحْيِيكُمْ} »","صحيح","Sahih al-Jami al-Saghir 5806","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5807","«مانع الزكاة يوم القيامة في النار»","حسن","Sahih al-Jami al-Saghir 5807","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5808","«ما نفعني مال قط ما نفعني مال أبي بكر»","صحيح","Sahih al-Jami al-Saghir 5808","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5809","«ما نقصت صدقة من مال وما زاد الله عبدا بعفوإلا عزا وما تواضع أحد لله إلا رفعه الله»","صحيح","Sahih al-Jami al-Saghir 5809","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5810","«ما نهيتكم عنه فاجتنبوه وما أمرتكم به فافعلوا منه ما استطعتم فإنما أهلك الذين من قبلكم كثرة مسائلهم واختلافهم على أنبيائهم»","صحيح","Sahih al-Jami al-Saghir 5810","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5811","«ما هذا يا صاحب الطعام؟! أفلا جعلته فوق الطعام حتى يراه الناس؟ من غش فليس مني»","صحيح","Sahih al-Jami al-Saghir 5811","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5812","«ما يأمن الذي يرفع رأسه في صلاته قبل الإمام أن يحول الله صورته في صورة حمار؟!»","صحيح","Sahih al-Jami al-Saghir 5812","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5813","«ما يجد الشهيد من مس القتل إلا كما يجد أحدكم من مس القرصة»","حسن","Sahih al-Jami al-Saghir 5813","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5814","«ما يخرج رجل شيئا من الصدقة حتى يفك عنها لحيي سبعين شيطانا»","صحيح","Sahih al-Jami al-Saghir 5814","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5815","«ما يزال البلاء بالمؤمن والمؤمنة في نفسه وولده وماله حتى يلقى الله وما عليه خطيئة»","صحيح","Sahih al-Jami al-Saghir 5815","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5816","«ما يزال الرجل يسأل الناس حتى يأتي يوم القيامة وليس في وجهه مزعة لحم»","صحيح","Sahih al-Jami al-Saghir 5816","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5817","«ما يسرني أن لي أحدا ذهبا يأتي علي ثالثة وعندي منه دينار إلا دينارا أرصده لدين علي»","صحيح","Sahih al-Jami al-Saghir 5817","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5818","«ما يصيب المسلم من نصب ولا وصب ولا هم ولا حزن ولا أذى ولا غم حتى الشوكة يشاكها إلا كفر الله بها من خطاياه»","صحيح","Sahih al-Jami al-Saghir 5818","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5819","«ما يكون عندي من خير فلن أدخره عنكم وإنه من يستعف يعفه الله ومن يستغن يغنه الله ومن يتصبر يصبره الله وما أعطي أحد عطاء خيرا وأوسع من الصبر»","صحيح","Sahih al-Jami al-Saghir 5819","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5820","«ما يمنعك أن تسمعي ما أوصيك به؟ أن تقولي إذا أصبحت وإذا أمسيت: يا حي يا قيوم برحمتك أستغيث أصلح لي شأني كله ولا تكلني إلى نفسي طرفة عين»","حسن","Sahih al-Jami al-Saghir 5820","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5821","«ما ينبغي لنبي أن يقول: إني خير من يونس بن متى»","صحيح","Sahih al-Jami al-Saghir 5821","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5822","«ما ينقم ابن جميل إلا أنه كان فقيرا فأغناه الله وأما خالد فإنكم تظلمون خالدا وقد احتبس أدراعه وأعتده في سبيل الله وأما العباس فهي علي ومثلها معها يا عمر! أما شعرت أن عم الرجل صنو أبيه»","صحيح","Sahih al-Jami al-Saghir 5822","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5823","متعها فإنه لا بد من المتاع ولو نصف صاع من تمر","حسن","Sahih al-Jami al-Saghir 5823","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5824","«متعها ولو بصاع»","حسن","Sahih al-Jami al-Saghir 5824","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5825","«مثل ابن آدم وإلى جنبه تسعة وتسعون منية إن أخطأته المنايا وقع في الهرم حتى يموت»","صحيح","Sahih al-Jami al-Saghir 5825","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5826","«مثل البخيل والمتصدق كمثل رجلين عليهما جبتان من حديد من ثديهما إلى تراقيهما فأما المنفق فلا ينفق شيئا إلا سبغت على جلده حتى تخفي بنانه وتعفوأثره وأما البخيل فلا يريد أن ينفق شيئا إلا لزقت كل حلقة مكانها فهو يوسعها فلا تتسع»","صحيح","Sahih al-Jami al-Saghir 5826","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5827","«مثل البيت الذي يذكر الله فيه والبيت الذي لا يذكر الله فيه مثل الحي والميت»","صحيح","Sahih al-Jami al-Saghir 5827","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5828","«مثل الجليس الصالح كمثل العطار إن لم يعطك من عطره أصابك من ريحه»","صحيح","Sahih al-Jami al-Saghir 5828","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5829","«مثل الجليس الصالح والجليس السوء كمثل صاحب المسك وكير الحداد لا يعدمك من صاحب المسك إما أن تشتريه أو تجد ريحه وكير الحداد يحرق بيتك أو ثوبك أو تجد منه ريحا خبيثة»","صحيح","Sahih al-Jami al-Saghir 5829","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5830","«مثل الصلوات الخمس كمثل نهر جار عذب على باب أحدكم يغتسل فيه كل يوم خمس مرات فما يبقي ذلك من الدنس»","صحيح","Sahih al-Jami al-Saghir 5830","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5831","«مثل العالم الذي يعلم الناس الخير وينسى نفسه كمثل السراج يضيء للناس ويحرق نفسه»","صحيح","Sahih al-Jami al-Saghir 5831","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5832","«مثل القائم على حدود الله والمدهن فيها كمثل قوم استهموا على سفينة في البحر فأصاب بعضهم أعلاها وأصاب بعضهم أسفلها فكان الذين في أسفلها إذا استقوا من الماء مروا على من فوقهم فقال الذين في أعلاها: لا ندعكم تصعدون فتؤذونا فقالوا: لوأنا خرقنا في نصيبنا خرقا ولم نؤذ من فوقنا فإن يتركوهم وما أرادوا هلكوا جميعا وإن أخذوا على أيديهم نجوا ونجوا جميعا»","صحيح","Sahih al-Jami al-Saghir 5832","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5833","«مثل القلب مثل الريشة تقلبها الرياح بفلاة»","صحيح","Sahih al-Jami al-Saghir 5833","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5834","«مثل الذي يتصدق ثم يرجع في صدقته كمثل الكلب يقيء ثم يعود في قيئه فيأكله»","صحيح","Sahih al-Jami al-Saghir 5834","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5835","«مثل الذي يتعلم العلم ثم لا يحدث به كمثل الذي يكنز الكنز فلا ينفق منه»","صحيح","Sahih al-Jami al-Saghir 5835","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5836","«مثل الذي يسترد ما وهب كمثل الكلب يقيء فيأكل قيئه فإذا استرد الواهب فليوقف فليعرف بما استرد ثم ليدفع إليه ما وهب»","حسن","Sahih al-Jami al-Saghir 5836","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5837","«مثل الذي يعلم الناس الخير وينسى نفسه مثل الفتيلة تضيء للناس وتحرق نفسها»","صحيح","Sahih al-Jami al-Saghir 5837","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5838","«مثل الذي يعين قومه على غير الحق مثل بعير تردى وهو يجر بذنبه»","صحيح","Sahih al-Jami al-Saghir 5838","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5839","«مثل المؤمن الذي يقرأ القرآن كمثل الأترجة ريحها طيب وطعمها طيب ومثل المؤمن الذي لا يقرأ القرآن كمثل التمرة طعمها طيب ولا ريح لها ومثل الفاجر الذي يقرأ القرآن كمثل الريحانة ريحها طيب وطعمها مر ومثل الفاجر الذي لا يقرأ القرآن كمثل الحنظلة طعمها مر ولا ريح لها ومثل الجليس الصالح كمثل صاحب المسك إن لم يصبك منه شيء أصابك من ريحه ومثل جليس السوء كمثل صاحب الكير إن لم يصبك من سواده أصابك من دخانه»","صحيح","Sahih al-Jami al-Saghir 5839","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5840","«مثل المؤمن الذي يقرأ القرآن كمثل الأترجة ريحها طيب وطعمها طيب ومثل المؤمن الذي لا يقرأ القرآن كمثل التمرة لا ريح لها وطعمها حلوومثل المنافق الذي يقرأ القرآن كمثل الريحانة ريحها طيب وطعمها مر ومثل المنافق الذي لا يقرأ القرآن كمثل الحنظلة ليس لها ريح وطعمها مر»","صحيح","Sahih al-Jami al-Saghir 5840","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5841","«مثل المؤمن كمثل الخامة من الزرع تفيؤها الريح مرة وتعدلها مرة ومثل المنافق كمثل الأرزة لا تزال حتى يكون انجفافها مرة واحدة»","صحيح","Sahih al-Jami al-Saghir 5841","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5842","«مثل المؤمن كمثل الزرع لا تزال الريح تفيؤه ولا يزال المؤمن يصيبه بلاء ومثل المنافق كمثل شجرة الأرز لا يهتز حتى يستحصد»","صحيح","Sahih al-Jami al-Saghir 5842","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5843","«مثل المؤمن كمثل خامة الزرع من حيث أتتها الريح كفأتها فإذا سكنت اعتدلت وكذلك المؤمن يكفأ بالبلاء ومثل الفاجر كالأرزة صماء معتدلة حتى يقصمها الله تعالى إذا شاء»","صحيح","Sahih al-Jami al-Saghir 5843","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5844","«مثل المؤمن مثل السنبلة تستقيم مرة وتخر مرة ومثل الكافر مثل الأرزة لا تزال مستقيمة حتى تخر ولا تشعر»","صحيح","Sahih al-Jami al-Saghir 5844","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5845","«مثل المؤمن مثل السنبلة تميل أحيانا وتقوم أحيانا»","صحيح","Sahih al-Jami al-Saghir 5845","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5846","«مثل المؤمن مثل النحلة إن أكلت أكلت طيبا وإن وضعت وضعت طيبا وإن وقعت على عود نخر لم تكسره ومثل المؤمن مثل سبيكة الذهب إن نفخت عليها احمرت وإن وزنت لم تنقص»","حسن","Sahih al-Jami al-Saghir 5846","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5847","«مثل المؤمن مثل النحلة لا تأكل إلا طيبا ولا تضع إلا طيبا»","صحيح","Sahih al-Jami al-Saghir 5847","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5848","«مثل المؤمن مثل النخلة ما أخذت منها من شيء نفعك»","صحيح","Sahih al-Jami al-Saghir 5848","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5849","«مثل المؤمنين في توادهم وتراحمهم وتعاطفهم مثل الجسد إذا اشتكى منه عضوتداعى له سائر الجسد بالسهر والحمى»","صحيح","Sahih al-Jami al-Saghir 5849","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5850","«مثل المجاهد في سبيل الله والله أعلم بمن يجاهد في سبيله كمثل الصائم القائم الخاشع الراكع الساجد»","صحيح","Sahih al-Jami al-Saghir 5850","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5851","«مثل المجاهد في سبيل الله والله أعلم بمن يجاهد في سبيله كمثل الصائم القائم الدائم الذي لا يفتر من صيام ولا صدقة حتى يرجع وتوكل الله تعالى للمجاهد في سبيله إن توفاه أن يدخله الجنة أو يرجعه سالما مع أجر أو غنيمة»","صحيح","Sahih al-Jami al-Saghir 5851","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5852","مثل المسلمين واليهود والنصارى كمثل رجل استأجر قوما يعملون له عملا إلى الليل فعملوا إلى نصف النهار فقالوا: لا حاجة لنا إلى أجرك الذي شرطت لنا وما عملنا لك فقال لهم: لا تفعلوا أكملوا بقية عملكم وخذوا أجركم كاملا فأبوا وتركوه فاستأجر أجراء بعدهم فقال: اعملوا بقية يومكم ولكم الذي شرطت لهم من الأجر فعملوا حتى إذا كان حين صلاة العصر قالوا: لك ما عملنا ولك الأجر الذي جعلت لنا فيه فقال: أكملوا بقية عملكم فإنما بقي من النهار شيء يسير فأبوا فاستأجر قوما أن يعملوا له بقية يومهم فعملوا بقية يومهم حتى غابت الشمس واستكملوا أجر الفريقين كليهما فذلك مثلهم ومثل ما قبلوا من هذا النور","صحيح","Sahih al-Jami al-Saghir 5852","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5853","«مثل المنافق كمثل الشاة العائرة بين الغنمين تعير إلى هذه مرة وإلى هذه مرة لا تدري أيهما تتبع»","صحيح","Sahih al-Jami al-Saghir 5853","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5854","«مثل أمتي مثل المطر لا يدرى أوله خير أم آخره»","صحيح","Sahih al-Jami al-Saghir 5854","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5855","«مثل ما بعثني الله به من الهدى والعلم كمثل الغيث الكثير أصاب أرضا فكان منها نقية قبلت الماء فأنبتت الكلأ والعشب الكثير وكانت منها أجادب أمسكت الماء فنفع الله بها الناس شربوا منها وسقوا ورعوا وأصاب طائفة منها أخرى إنما هي قيعان لا تمسك ماء ولا تنبت كلأ فذلكم مثل من فقه في دين الله ونفعه ما بعثني الله به فعلم وعلم ومثل من لم يرفع بذلك رأسا ولم يقبل هدى الله الذي أرسلت به»","صحيح","Sahih al-Jami al-Saghir 5855","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5856","«مثل مؤخرة الرحل يكون بين يدي أحدكم ثم لا يضره من مر بين يديه»","صحيح","Sahih al-Jami al-Saghir 5856","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5857","مثلي في النبيين كمثل رجل بنى دارا فأحسنها، وأكملها وأجملها وترك فيها موضع لبنة لم يضعها فجعل الناس يطوفون بالبنيان ويعجبون منه ويقولون: لو تم موضع هذه اللبنة فأنا في النبيين موضع تلك اللبنة","صحيح","Sahih al-Jami al-Saghir 5857","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5858","«مثلي كمثل رجل استوقد نارا فلما أضاءت ما حولها جعل الفراش وهذه الدواب التي يقعن في النار يقعن فيها وجعل يحجزهن ويغلبنه فيقتحمن فيها فذلك مثلي ومثلكم أنا آخذ بحجزكم عن النار: هلم عن النار هلم عن النار فتغلبوني فتقتحمون فيها»","صحيح","Sahih al-Jami al-Saghir 5858","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5859","«مثلي ومثلكم كمثل رجل أوقد نارا فجعل الفراش والجنادب يقعن فيها وهو يذبهن عنها وأنا آخذ بحجزكم عن النار وأنتم تفلتون من يدي»","صحيح","Sahih al-Jami al-Saghir 5859","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5860","«مثلي ومثل ما بعثني الله به كمثل رجل أتى قوما فقال: يا قوم إني رأيت الجيش بعيني وإني أنا النذير العريان فالنجاء النجاء فأطاعه طائفة من قومه فأدلجوا وانطلقوا على مهلهم فنجوا وكذبته طائفة منهم فأصبحوا مكانهم فصبحهم الجيش فأهلكهم واجتاحهم فذلك مثل من أطاعني فاتبع ما جئت به ومثل من عصاني وكذب بما جئت به من الحق»","صحيح","Sahih al-Jami al-Saghir 5860","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5861","«مدمن الخمر كعابد وثن»","صحيح","Sahih al-Jami al-Saghir 5861","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5862","«مر أختك فلتركب،..... فإن الله عن تعذيب أختك نفسها لغني»","صحيح","Sahih al-Jami al-Saghir 5862","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5863","«مر رجل بغصن شجرة على ظهر طريق فقال: والله لأنحين هذا عن المسلمين لا يؤذيهم فأدخل الجنة»","صحيح","Sahih al-Jami al-Saghir 5863","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5864","«مررت ليلة أسري بي بالملأ الأعلى وجبريل كالحلس البالي من خشية الله تعالى»","حسن","Sahih al-Jami al-Saghir 5864","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5865","«مررت ليلة أسري بي على موسى قائما يصلي في قبره»","صحيح","Sahih al-Jami al-Saghir 5865","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5866","«مروا أبا بكر فليصل بالناس»","صحيح","Sahih al-Jami al-Saghir 5866","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5867","«مروا الصبي بالصلاة إذا بلغ سبع سنين وإذا بلغ عشر سنين فاضربوه عليها»","صحيح","Sahih al-Jami al-Saghir 5867","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5868","مروا أولادكم بالصلاة وهم أبناء سبع سنين واضربوهم عليها وهم أبناء عشر سنين وفرقوا بينهم في المضاجع،........ ...","حسن","Sahih al-Jami al-Saghir 5868","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5869","«مروه فليتكلم وليستظل وليقعد وليتم صومه»","صحيح","Sahih al-Jami al-Saghir 5869","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5870","«مرها فإن يك فيها خير فستفعل ولا تضرب ظعينتك كضرب أمتك»","صحيح","Sahih al-Jami al-Saghir 5870","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5871","«مسألة الغني شين في وجهه يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 5871","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5872","«مستريح ومستراح منه العبد المؤمن يستريح من نصب الدنيا وأذاها إلى رحمة الله تعالى والعبد الفاجر تستريح منه العباد والبلاد والشجر والدواب»","صحيح","Sahih al-Jami al-Saghir 5872","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5873","«مضت الهجرة لأهلها أبايعه على الإسلام والجهاد»","صحيح","Sahih al-Jami al-Saghir 5873","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5874","«مضمضوا من اللبن فإن له دسما»","صحيح","Sahih al-Jami al-Saghir 5874","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5875","«مطل الغني ظلم فإذا أتبع أحدكم على مليء فليتبع»","صحيح","Sahih al-Jami al-Saghir 5875","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5876","«مطل الغني ظلم وإذا أحلت على مليء فاتبعه»","صحيح","Sahih al-Jami al-Saghir 5876","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5877","«مع الغلام عقيقة فأهريقوا عنه دما وأميطوا عنه الأذى»","صحيح","Sahih al-Jami al-Saghir 5877","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5878","«معاذ الله أن يتحدث الناس أني أقتل أصحابي إن هذا وأصحابه يقرءون القرآن لا يجأوز حناجرهم يمرقون من الدين مروق السهم من الرمية»","صحيح","Sahih al-Jami al-Saghir 5878","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5879","«معاذ بن جبل أعلم الناس بحلال الله وحرامه»","صحيح","Sahih al-Jami al-Saghir 5879","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5880","«معاذ بن جبل أمام العلماء يوم القيامة برتوة»","صحيح","Sahih al-Jami al-Saghir 5880","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5881","«معترك المنايا ما بين الستين إلى السبعين»","حسن","Sahih al-Jami al-Saghir 5881","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5882","«معقبات لا يخيب قائلهن: ثلاث وثلاثون تسبيحة وثلاث وثلاثون تحميدة وأربع وثلاثون تكبيرة في دبر كل صلاة مكتوبة»","صحيح","Sahih al-Jami al-Saghir 5882","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5883","«معلم الخير يستغفر له كل شيء حتى الحيتان في البحر»","صحيح","Sahih al-Jami al-Saghir 5883","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5884","مفاتيح الغيب خمس لا يعلمها إلا الله تعالى: لا يعلم أحد ما يكون في غد إلا الله تعالى ولا يعلم أحد ما يكون في الأرحام إلا الله تعالى، ولا يعلم متى تقوم الساعة إلا الله تعالى ولا تدري نفس بأي أرض تموت إلا الله تعالى ولا يدري أحد متى يجيء المطر إلا الله تعالى","صحيح","Sahih al-Jami al-Saghir 5884","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5885","«مفتاح الصلاة الطهور وتحريمها التكبير وتحليلها التسليم»","صحيح","Sahih al-Jami al-Saghir 5885","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5886","«مقام الرجل في الصف في سبيل الله أفضل من عبادة ستين سنة»","صحيح","Sahih al-Jami al-Saghir 5886","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5887","«ملأ الله بيوتهم وقبورهم نارا كما شغلونا عن الصلاة الوسطى حتى غابت الشمس»","صحيح","Sahih al-Jami al-Saghir 5887","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5888","«ملئ عمار إيمانا إلى مشاشه»","صحيح","Sahih al-Jami al-Saghir 5888","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5889","«ملعون من أتى امرأة في دبرها»","صحيح","Sahih al-Jami al-Saghir 5889","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5890","«ملعون من سأل بوجه الله وملعون من سئل بوجه الله ثم منع سائله ما لم يسأل هجرا»","حسن","Sahih al-Jami al-Saghir 5890","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5891","ملعون من سب أباه ملعون من سب أمه ملعون من ذبح لغير الله ملعون من غير تخوم الأرض ملعون من كمه أعمى عن طريق ملعون من وقع على بهيمة ملعون من عمل بعمل قوم لوط","صحيح","Sahih al-Jami al-Saghir 5891","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5892","«من أشد الناس عذابا يوم القيامة الذين يصورون هذه الصور»","صحيح","Sahih al-Jami al-Saghir 5892","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5893","«من أشد أمتي لي حبا ناس يكونون بعدي يود أحدهم لورآني بأهله وماله»","صحيح","Sahih al-Jami al-Saghir 5893","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5894","«من أشراط الساعة الفحش والتفحش وقطيعة الرحم وتخوين الأمين وائتمان الخائن»","صحيح","Sahih al-Jami al-Saghir 5894","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5895","«من أشراط الساعة أن يتباهى الناس في المساجد»","صحيح","Sahih al-Jami al-Saghir 5895","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5896","«من أشراط الساعة أن يمر الرجل في المسجد لا يصلي فيه ركعتين وأن لا يسلم الرجل إلا على من يعرف،.... ... »","صحيح","Sahih al-Jami al-Saghir 5896","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5897","«من أفضل العمل إدخال السرور على المؤمن تقضي عنه دينا تقضي له حاجة تنفس له كربة»","صحيح","Sahih al-Jami al-Saghir 5897","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5898","«من اقتراب الساعة انتفاخ الأهلة»","صحيح","Sahih al-Jami al-Saghir 5898","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5899","«من اقتراب الساعة أن يرى الهلال قبلا فيقال: لليلتين وأن تتخذ المساجد طرقا وأن يظهر موت الفجأة»","حسن","Sahih al-Jami al-Saghir 5899","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5900","«من أكبر الكبائر الشرك بالله واليمين الغموس»","صحيح","Sahih al-Jami al-Saghir 5900","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5901","«من البر أن تصل صديق أبيك»","صحيح","Sahih al-Jami al-Saghir 5901","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5902","«من التمر والبسر خمر»","صحيح","Sahih al-Jami al-Saghir 5902","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5903","«من الحنطة خمر ومن التمر خمر ومن الشعير خمر ومن الزبيب خمر ومن العسل خمر»","صحيح","Sahih al-Jami al-Saghir 5903","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5904","«من الصلاة صلاة من فاتته فكأنما وتر أهله وماله» - يعني العصر -","صحيح","Sahih al-Jami al-Saghir 5904","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5905","«من الغيرة ما يحب الله ومنها ما يكره الله فأما ما يحب فالغيرة في الريبة وأما ما يكره فالغيرة في غير ريبة»","صحيح","Sahih al-Jami al-Saghir 5905","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5906","من الفطرة المضمضة والاستنشاق والسواك، وقص الشارب وتقليم الأظفار ونتف الإبط والاستحداد وغسل البراجم والانتضاح والاختتان","حسن","Sahih al-Jami al-Saghir 5906","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5907","«من الفطرة حلق العانة وتقليم الأظفار وقص الشارب»","صحيح","Sahih al-Jami al-Saghir 5907","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5908","«من الكبائر شتم الرجل والديه: يسب أبا الرجل فيسب أباه ويسب أمه فيسب أمه»","صحيح","Sahih al-Jami al-Saghir 5908","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5909","«من الله تعالى لا من رسوله: لعن الله قاطع السدر»","صحيح","Sahih al-Jami al-Saghir 5909","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5910","«من المذي الوضوء ومن المني الغسل»","صحيح","Sahih al-Jami al-Saghir 5910","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5911","«من حسن إسلام المرء تركه ما لا يعنيه»","صحيح","Sahih al-Jami al-Saghir 5911","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5912","«من حين يخرج أحدكم من منزله إلى مسجده فرجل تكتب حسنة والأخرى تمحوسيئة»","صحيح","Sahih al-Jami al-Saghir 5912","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5913","«من خلفائكم خليفة يحثو المال حثيا لا يعده عدا»","صحيح","Sahih al-Jami al-Saghir 5913","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5914","«من خير طيبكم المسك»","صحيح","Sahih al-Jami al-Saghir 5914","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5915","«من خير معاش الناس لهم رجل ممسك عنان فرسه في سبيل الله يطير على متنه كلما سمع هيعة أو فزعة طار عليه يبتغي القتل والموت مظانه ورجل في غنيمة في رأس شعفة من هذه الشعف أو بطن واد من هذه الأودية يقيم الصلاة ويؤتي الزكاة ويعبد ربه حتى يأتيه اليقين ليس من الناس إلا في خير»","صحيح","Sahih al-Jami al-Saghir 5915","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5916","«من شرار الناس من تدركهم الساعة وهم أحياء»","صحيح","Sahih al-Jami al-Saghir 5916","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5917","«من شر الناس ذوالوجهين: الذي يأتي هؤلاء بوجه وهؤلاء بوجه»","صحيح","Sahih al-Jami al-Saghir 5917","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5918","«من غسله الغسل ومن حمله الوضوء» - يعني الميت -","صحيح","Sahih al-Jami al-Saghir 5918","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5919","«من هاهنا جاءت الفتن - وأشار نحوالمشرق - والجفاء وغلظ القلوب في الفدادين أهل الوبر عند أصول أذناب الإبل والبقر في ربيعة ومضر»","صحيح","Sahih al-Jami al-Saghir 5919","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5920","«منا الذي يصلي عيسى ابن مريم خلفه»","صحيح","Sahih al-Jami al-Saghir 5920","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5921","«من آتاه الله من هذا المال شيئا من غير أن يسأله فليقبله فإنما هورزق ساقه الله إليه»","صحيح","Sahih al-Jami al-Saghir 5921","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5922","«من آذى العباس فقد آذاني إنما عم الرجل صنوأبيه»","حسن","Sahih al-Jami al-Saghir 5922","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5923","«من آذى المسلمين في طرقهم وجبت عليه لعنتهم»","حسن","Sahih al-Jami al-Saghir 5923","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5924","«من آذى عليا فقد آذاني»","صحيح","Sahih al-Jami al-Saghir 5924","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5925","«من آمن بالله ورسوله وأقام الصلاة وآتى الزكاة وصام رمضان كان حقا على الله أن يدخله الجنة هاجر في سبيل الله أو جلس في أرضه التي ولد فيها»","صحيح","Sahih al-Jami al-Saghir 5925","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5926","«من أوى ضالة فهو ضال ما لم يعرفها»","صحيح","Sahih al-Jami al-Saghir 5926","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5927","«من ابتاع طعاما فلا يبعه حتى يستوفيه»","صحيح","Sahih al-Jami al-Saghir 5927","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5928","من ابتاع محفلة أو مصراة فهو بالخيار ثلاثة أيام إن شاء أن يمسكها أمسكها وإن شاء أن يردها ردها وصاعا من تمر لا سمراء","صحيح","Sahih al-Jami al-Saghir 5928","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5929","«من ابتاع نخلا بعد أن تؤبر فثمرتها للبائع إلا أن يشترط المبتاع وإن ابتاع عبدا وله مال فماله للذي باعه إلا أن يشترط المبتاع»","صحيح","Sahih al-Jami al-Saghir 5929","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5930","«من ابتغى العلم ليباهي به العلماء أو يماري به السفهاء أو تقبل أفئدة الناس إليه فإلى النار»","حسن","Sahih al-Jami al-Saghir 5930","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5931","«من ابتلي بشيء من البنات فصبر عليهن كن له حجابا من النار»","صحيح","Sahih al-Jami al-Saghir 5931","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5932","«من ابتلي من هذه البنات بشيء فأحسن إليهن كن له سترا من النار»","صحيح","Sahih al-Jami al-Saghir 5932","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5933","«من أبلي بلاء فذكره فقد شكره وإن كتمه فقد كفره»","صحيح","Sahih al-Jami al-Saghir 5933","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5934","«من أتى أخاه المسلم عائدا مشى في خرافة الجنة حتى يجلس فإذا جلس غمرته الرحمة فإن كان غدوة صلى عليه سبعون ألف ملك حتى يمسي وإن كان مساء صلى عليه سبعون ألف ملك حتى يصبح»","صحيح","Sahih al-Jami al-Saghir 5934","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5935","«من أتى الجمعة فليغتسل»","صحيح","Sahih al-Jami al-Saghir 5935","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5936","«من أتى المسجد لشيء فهو حظه»","صحيح","Sahih al-Jami al-Saghir 5936","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5937","«من أتى إليكم معروفا فكافئوه فإن لم تجدوا فادعوا له»","صحيح","Sahih al-Jami al-Saghir 5937","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5938","«من أتى بهيمة فاقتلوه واقتلوها معه»","صحيح","Sahih al-Jami al-Saghir 5938","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5939","«من أتى عرافا أو كاهنا فصدقه بما يقول فقد كفر بما أنزل على محمد»","صحيح","Sahih al-Jami al-Saghir 5939","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5940","«من أتى عرافا فسأله عن شيء لم تقبل له صلاة أربعين ليلة»","صحيح","Sahih al-Jami al-Saghir 5940","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5941","«من أتى فراشه وهو ينوي أن يقوم يصلي من الليل فغلبته عينه حتى يصبح كتب له ما نوى وكان نومه صدقة عليه من ربه»","حسن","Sahih al-Jami al-Saghir 5941","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5942","«من أتى كاهنا فصدقه بما يقول أو أتى امرأة حائضا أو أتى امرأة في دبرها فقد برئ مما أنزل على محمد»","صحيح","Sahih al-Jami al-Saghir 5942","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5943","«من أتى هذا البيت فلم يرفث ولم يفسق رجع كما ولدته أمه»","صحيح","Sahih al-Jami al-Saghir 5943","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5944","«من أتاكم وأمركم جميع على رجل واحد يريد أن يشق عصاكم ويفرق جماعتكم فاقتلوه»","صحيح","Sahih al-Jami al-Saghir 5944","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5945","«من أتت عليه ستون سنة فقد أعذر الله إليه في العمر»","صحيح","Sahih al-Jami al-Saghir 5945","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5946","«من اتخذ كلبا إلا كلب زرع أو كلب صيد ينقص من أجره كل يوم قيراط»","صحيح","Sahih al-Jami al-Saghir 5946","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5947","«من أتم الوضوء كما أمره الله فالصلوات المكتوبات كفارات لما بينهن»","صحيح","Sahih al-Jami al-Saghir 5947","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5948","«من أتي عند ماله فقوتل فقاتل فقتل فهو شهيد»","صحيح","Sahih al-Jami al-Saghir 5948","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5949","«من أثكل ثلاثة من صلبه في سبيل الله فاحتسبهم على الله وجبت له الجنة»","صحيح","Sahih al-Jami al-Saghir 5949","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5950","«من أثنيتم عليه خيرا وجبت له الجنة ومن أثنيتم عليه شرا وجبت له النار أنتم شهداء الله في الأرض»","صحيح","Sahih al-Jami al-Saghir 5950","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5951","«من أجل سلطان الله أجله الله يوم القيامة»","حسن","Sahih al-Jami al-Saghir 5951","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5952","«من أحاط حائطا على أرض فهي له»","صحيح","Sahih al-Jami al-Saghir 5952","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5953","«من أحب الأنصار أحبه الله ومن أبغض الأنصار أبغضه الله»","صحيح","Sahih al-Jami al-Saghir 5953","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5954","«من أحب الحسن والحسين فقد أحبني ومن بغضهما فقد أبغضني»","حسن","Sahih al-Jami al-Saghir 5954","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5955","«من أحب أن تسره صحيفته فليكثر فيها من الاستغفار»","حسن","Sahih al-Jami al-Saghir 5955","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5956","«من أحب أن يبسط له في رزقه وأن ينسأ له في أثره فليصل رحمه»","صحيح","Sahih al-Jami al-Saghir 5956","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5957","«من أحب أن يتمثل له الرجال قياما فليتبوأ مقعده من النار»","صحيح","Sahih al-Jami al-Saghir 5957","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5958","«من أحب أن يجد طعم الإيمان فليحب المرء لا يحبه إلا لله»","حسن","Sahih al-Jami al-Saghir 5958","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5959","من أحب أن يسأل عن شيء فليسأل عنه فوالله لا تسألوني عن شيء إلا أخبرتكم به ما دمت في مقامي هذا والذي نفسي بيده لقد عرضت على الجنة والنار آنفا في عرض هذا الحائط وأنا أصلي فلم أر كاليوم في الخير والشر","صحيح","Sahih al-Jami al-Saghir 5959","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5960","«من أحب أن يصل أباه في قبره فليصل إخوان أبيه من بعده»","صحيح","Sahih al-Jami al-Saghir 5960","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5961","«من أحب أن يقرأ القرآن غضا كما أنزل فليقرأ على قراءة أم عبد»","صحيح","Sahih al-Jami al-Saghir 5961","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5962","«من أحب أن ينظر إلى شهيد يمشي على وجه الأرض فلينظر إلى طلحة بن عبد الله»","صحيح","Sahih al-Jami al-Saghir 5962","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5963","«من أحب عليا فقد أحبني ومن أبغض عليا فقد أبغضني»","صحيح","Sahih al-Jami al-Saghir 5963","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5964","«من أحب لقاء الله أحب الله لقاءه ومن كره لقاء الله كره الله لقاءه»","صحيح","Sahih al-Jami al-Saghir 5964","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5965","«من أحب لله وأبغض لله وأعطى لله ومنع لله فقد استكمل الإيمان»","صحيح","Sahih al-Jami al-Saghir 5965","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5966","«من أحبني فليحب أسامة»","صحيح","Sahih al-Jami al-Saghir 5966","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5967","«من احتبس فرسا في سبيل الله إيمانا بالله وتصديقا بوعده كان شبعه وريه وروثه وبوله حسنات في ميزانه يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 5967","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5968","«من احتجم لسبع عشرة من الشهر وتسع عشرة وإحدى وعشرين كان له شفاء من كل داء»","حسن","Sahih al-Jami al-Saghir 5968","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5969","«من احتسب ثلاثة من صلبه دخل الجنة قالت امرأة: واثنان؟ قال واثنان»","صحيح","Sahih al-Jami al-Saghir 5969","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5970","«من أحدث في أمرنا هذا ما ليس منه فهو رد»","صحيح","Sahih al-Jami al-Saghir 5970","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5971","«من أحرم بالحج والعمرة أجزأه طواف واحد وسعي واحد منهما ولم يحل حتى يقضي حجه ويحل منهما جميعا»","صحيح","Sahih al-Jami al-Saghir 5971","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5972","«من أحسن الرمي ثم تركه فقد ترك نعمة من النعم»","صحيح","Sahih al-Jami al-Saghir 5972","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5973","«من أحسن في الإسلام لم يؤاخذ بما عمل في الجاهلية ومن أساء في الإسلام أخذ بالأول والآخر»","صحيح","Sahih al-Jami al-Saghir 5973","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5974","من أحيا أرضا ميتة فله فيها أجر وما أكلت العافية منها فهو له صدقة","صحيح","Sahih al-Jami al-Saghir 5974","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5975","«من أحيا أرضا ميتة فهي له»","صحيح","Sahih al-Jami al-Saghir 5975","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5976","«من أحيا أرضا ميتة فهي له وليس لعرق ظالم حق»","صحيح","Sahih al-Jami al-Saghir 5976","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5977","«من أخاف أهل المدينة أخافه الله»","صحيح","Sahih al-Jami al-Saghir 5977","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5978","«من أخاف أهل المدينة فقد أخاف ما بين جنبي»","صحيح","Sahih al-Jami al-Saghir 5978","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5979","«من أخذ السبع فهو خير»","حسن","Sahih al-Jami al-Saghir 5979","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5980","«من أخذ أموال الناس يريد أداءها أدى الله عنه ومن أخذها يريد إتلافها أتلفه الله»","صحيح","Sahih al-Jami al-Saghir 5980","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5981","«من أخذ دينا وهو يريد أن يؤديه أعانه الله»","صحيح","Sahih al-Jami al-Saghir 5981","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5982","«من أخذ على تعليم القرآن قوسا قلده الله مكانها قوسا من نار جهنم يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 5982","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5983","من أخذ من الأرض شيئا بغير حقه خسف به يوم القيامة إلى سبع أرضين","صحيح","Sahih al-Jami al-Saghir 5983","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5984","«من أخذ من الأرض شيئا ظلما جاء يوم القيامة يحمل ترابها إلى المحشر»","صحيح","Sahih al-Jami al-Saghir 5984","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5985","«من أخرج من طريق المسلمين شيئا يؤذيهم كتب الله له به حسنة ومن كتب له عنده حسنة أدخله بها الجنة»","حسن","Sahih al-Jami al-Saghir 5985","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5986","«من ادان دينا ينوي قضاءه أداه الله عنه يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 5986","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5987","«من ادعى إلى غير أبيه أو انتمى إلى غير مواليه فعليه لعنة الله المتتابعة إلى يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 5987","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5988","«من ادعى إلى غير أبيه لم يرح رائحة الجنة وإن ريحها ليوجد من مسيرة خمسمائة عام»","صحيح","Sahih al-Jami al-Saghir 5988","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5989","«من ادعى إلى غير أبيه وهو يعلم فالجنة عليه حرام»","صحيح","Sahih al-Jami al-Saghir 5989","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5990","«من ادعى ما ليس له فليس منا وليتبوأ مقعده من النار»","صحيح","Sahih al-Jami al-Saghir 5990","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5991","«من أدرك ركعة من الجمعة فليصل إليها أخرى»","صحيح","Sahih al-Jami al-Saghir 5991","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5992","«من أدرك ركعة من الصبح قبل أن تطلع الشمس فقد أدرك الصبح ومن أدرك ركعة من العصر قبل أن تغرب الشمس فقد أدرك العصر»","صحيح","Sahih al-Jami al-Saghir 5992","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5993","«من أدرك ركعة من الصلاة مع الإمام فقد أدرك الصلاة»","صحيح","Sahih al-Jami al-Saghir 5993","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5994","«من أدرك ركعة من صلاة الجمعة أو غيرها فقد تمت صلاته»","صحيح","Sahih al-Jami al-Saghir 5994","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5995","«من أدرك عرفة قبل طلوع الفجر فقد أدرك الحج»","صحيح","Sahih al-Jami al-Saghir 5995","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5996","«من أدرك ماله بعينه عند رجل قد أفلس فهو أحق به من غيره»","صحيح","Sahih al-Jami al-Saghir 5996","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5997","«من أدرك معنا هذه الصلاة: صلاة الغداة وقد أتى عرفات قبل ذلك ليلا أو نهارا فقد قضى تفثه وتم حجه»","صحيح","Sahih al-Jami al-Saghir 5997","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5998","«من أدرك من الصلاة ركعة فقد أدرك الصلاة»","صحيح","Sahih al-Jami al-Saghir 5998","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"5999","«من أدرك من صلاة الجمعة ركعة فقد أدرك الصلاة»","صحيح","Sahih al-Jami al-Saghir 5999","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6000","«من أدرك من صلاة ركعة فقد أدركها»","صحيح","Sahih al-Jami al-Saghir 6000","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6001","«من أدرك منكم عيسى ابن مريم فليقرئه مني السلام»","حسن","Sahih al-Jami al-Saghir 6001","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6002","«من أذن ثنتي عشرة سنة وجبت له الجنة وكتب له بتأذينه في كل يوم ستون حسنة وبإقامته ثلاثون حسنة»","صحيح","Sahih al-Jami al-Saghir 6002","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6003","«من أراد الحج فليتعجل»","حسن","Sahih al-Jami al-Saghir 6003","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6004","«من أراد الحج فليتعجل فإنه قد يمرض المريض وتضل الضالة وتعرض الحاجة»","حسن","Sahih al-Jami al-Saghir 6004","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6005","«من أراد أن يصوم فليتسحر بشيء»","صحيح","Sahih al-Jami al-Saghir 6005","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6006","«من أراد أن يعلم ماله عند الله فلينظر ما لله عنده»","حسن","Sahih al-Jami al-Saghir 6006","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6007","«من أراد أهل المدينة بسوء أذابه الله كما يذوب الملح في الماء»","صحيح","Sahih al-Jami al-Saghir 6007","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6008","«من ارتبط فرسا في سبيل الله ثم عالج علفه بيده كان له بكل حبة حسنة»","صحيح","Sahih al-Jami al-Saghir 6008","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6009","«من ارتد عن دينه فاقتلوه»","صحيح","Sahih al-Jami al-Saghir 6009","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6010","«من أرضى الناس بسخط الله وكله الله إلى الناس ومن أسخط الناس برضا الله كفاه الله مؤنة الناس»","صحيح","Sahih al-Jami al-Saghir 6010","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6011","«من أريد ماله بغير حق فقاتل فقتل فهو شهيد»","صحيح","Sahih al-Jami al-Saghir 6011","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6012","«من أسبل إزاره في صلاته خيلاء فليس من الله في حل ولا حرام»","صحيح","Sahih al-Jami al-Saghir 6012","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6013","«من استجمر فليستجمر ثلاثا»","صحيح","Sahih al-Jami al-Saghir 6013","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6014","«من استسن خيرا فاستن به كان له أجره كاملا ومن أجور من استن به ولا ينتقص من أجورهم شيئا ومن استن سنة سيئة فاستن به فعليه وزره كاملا ومن أوزار الذين استنوا به ولا ينتقص من أوزارهم شيئا»","صحيح","Sahih al-Jami al-Saghir 6014","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6015","«من استطاع أن يموت بالمدينة فليمت بها فإني أشفع لمن يموت بها»","صحيح","Sahih al-Jami al-Saghir 6015","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6016","من استطاع منكم أن لا يحول بينه وبين قبلته أحد فليفعل","صحيح","Sahih al-Jami al-Saghir 6016","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6017","«من استطاع منكم أن يستتر من النار ولو بشق تمرة فليفعل»","صحيح","Sahih al-Jami al-Saghir 6017","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6018","«من استطاع منكم أن يكون له خبء من عمل صالح فليفعل»","صحيح","Sahih al-Jami al-Saghir 6018","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6019","«من استطاع منكم أن ينفع أخاه فلينفعه»","صحيح","Sahih al-Jami al-Saghir 6019","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6020","«من استعاذ بالله فأعيذوه ومن سألكم بوجه الله فأعطوه»","حسن","Sahih al-Jami al-Saghir 6020","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6021","«من استعاذكم بالله فأعيذوه ومن سألكم بالله فأعطوه ومن دعاكم فأجيبوه ومن صنع إليكم معروفا فكافئوه فإن لم تجدوا ما تكافئونه فادعوا له حتى تروا أنكم قد كافأتموه»","صحيح","Sahih al-Jami al-Saghir 6021","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6022","«من استعف أعفه الله ومن استغنى أغناه الله ومن سأل الناس وله عدل خمس أواق فقد سأل إلحافا»","صحيح","Sahih al-Jami al-Saghir 6022","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6023","«من استعملناه على عمل فرزقناه رزقا فما أخذ بعد ذلك فهو غلول»","صحيح","Sahih al-Jami al-Saghir 6023","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6024","«من استعملناه منكم على عمل فكتمنا مخيطا فما فوقه كان ذلك غلولا يأتي به يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6024","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6025","«من استعملناه منكم على عمل فليجئ بقليله وكثيره فما أوتي منه أخذ وما نهي عنه انتهى»","صحيح","Sahih al-Jami al-Saghir 6025","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6026","«من استغفر للمؤمنين وللمؤمنات كتب الله له بكل مؤمن ومؤمنة حسنة»","حسن","Sahih al-Jami al-Saghir 6026","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6027","«من استغنى أغناه الله ومن استعف أعفه الله ومن استكفى كفاه الله ومن سأل وله قيمة أوقية فقد ألحف»","صحيح","Sahih al-Jami al-Saghir 6027","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6028","«من استمع إلى حديث قوم وهم له كارهون صب في أذنيه الآنك ومن أرى عينيه في المنام ما لم ير كلف أن يعقد شعيرة»","صحيح","Sahih al-Jami al-Saghir 6028","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6029","«من استودع وديعة فلا ضمان عليه»","حسن","Sahih al-Jami al-Saghir 6029","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6030","«من استيقظ من الليل وأيقظ امرأته فصليا ركعتين جميعا كتبا ليلتئذ من الذاكرين الله كثيرا والذاكرات»","صحيح","Sahih al-Jami al-Saghir 6030","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6031","من أسلف في شيء فليسلف في كيل معلوم ووزن معلوم إلى أجل معلوم","صحيح","Sahih al-Jami al-Saghir 6031","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6032","«من أسلم على شيء فهو له»","صحيح","Sahih al-Jami al-Saghir 6032","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6033","«من أسلم على يدي رجل فله ولاؤه»","حسن","Sahih al-Jami al-Saghir 6033","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6034","«من أشار إلى أخيه بحديدة فإن الملائكة تلعنه وإن كان أخاه لأبيه وأمه»","صحيح","Sahih al-Jami al-Saghir 6034","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6035","«من اشترى شاة مصراة فهو بالخيار ثلاثة أيام فإن ردها رد معها صاعا من طعام لا سمراء»","صحيح","Sahih al-Jami al-Saghir 6035","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6036","«من اشترى شاة مصراة فهو بخير النظرين إن شاء أمسكها وإن شاء ردها وصاعا من تمر لا سمراء»","صحيح","Sahih al-Jami al-Saghir 6036","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6037","«من اشترى شاة مصراة فهو فيها بالخيار ثلاثة أيام إن شاء أمسكها وإن شاء ردها ورد معها صاعا من تمر»","صحيح","Sahih al-Jami al-Saghir 6037","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6038","من أصاب بفمه من ذي حاجة غير متخذ خبئة فلا شيء عليه ومن خرج بشيء منه فعليه غرامة مثليه والعقوبة ومن سرق منه شيئا بعد أن يؤويه الجرين فبلغ ثمن المجن فعليه القطع ومن سرق دون ذلك فعليه غرامة مثليه والعقوبة","حسن","Sahih al-Jami al-Saghir 6038","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6039","«من أصاب ذنبا فأقيم عليه حد ذلك الذنب فهو كفارته»","صحيح","Sahih al-Jami al-Saghir 6039","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6040","«من أصابه هم أو غم أو سقم أو شدة فقال: الله ربي لا شريك له كشف ذلك عنه»","حسن","Sahih al-Jami al-Saghir 6040","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6041","«من أصابته فاقة فأنزلها بالناس لم تسد فاقته ومن أنزلها بالله أوشك الله له بالغنى إما بموت آجل أو غنى عاجل»","حسن","Sahih al-Jami al-Saghir 6041","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6042","«من أصبح منكم آمنا في سربه معافى في جسده عنده قوت يومه فكأنما حيزت له الدنيا بحذافيرها»","حسن","Sahih al-Jami al-Saghir 6042","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6043","«من اضطجع مضجعا لم يذكر الله فيه كان عليه ترة يوم القيامة ومن قعد مقعدا لم يذكر الله فيه كان عليه ترة يوم القيامة»","حسن","Sahih al-Jami al-Saghir 6043","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6044","«من أطاعني فقد أطاع الله ومن عصاني فقد عصى الله ومن يطع الأمير فقد أطاعني ومن يعص الأمير فقد عصاني»","صحيح","Sahih al-Jami al-Saghir 6044","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6045","من أطعمه الله طعاما فليقل: اللهم بارك لنا فيه وأطعمنا خيرا منه ومن سقاه الله لبنا فليقل: اللهم بارك لنا فيه وزدنا منه فإنه ليس شيء يجزي من الطعام والشراب غير اللبن","حسن","Sahih al-Jami al-Saghir 6045","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6046","«من اطلع في بيت قوم بغير إذن ففقئوا عينه فلا دية له ولا قصاص»","صحيح","Sahih al-Jami al-Saghir 6046","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6047","«من اطلع في بيت قوم بغير إذنهم فقد حل لهم أن يفقئوا عينه»","صحيح","Sahih al-Jami al-Saghir 6047","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6048","«من اطلع في دار قوم بغير إذنهم ففقئوا عينه فقد هدرت»","صحيح","Sahih al-Jami al-Saghir 6048","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6049","«من أعان على خصومة بظلم لم يزل في سخط الله حتى ينزع»","صحيح","Sahih al-Jami al-Saghir 6049","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6050","«من أعتق رقبة مؤمنة كانت فداءه من النار»","صحيح","Sahih al-Jami al-Saghir 6050","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6051","«من أعتق رقبة مسلمة أعتق الله له بكل عضومنها عضوا منه من النار حتى فرجه بفرجه»","صحيح","Sahih al-Jami al-Saghir 6051","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6052","من أعتق شركا له في عبد فكان له مال يبلغ ثمن العبد قوم العبد عليه قيمة عدل فأعطى شركاءه حصصهم وعتق عليه العبد وإلا فقد عتق منه ما عتق","صحيح","Sahih al-Jami al-Saghir 6052","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6053","«من أعتق شقصا من مملوك فعليه خلاصه في ماله فإن لم يكن له مال قوم المملوك قيمة عدل ثم استسعى غير مشقوق عليه»","صحيح","Sahih al-Jami al-Saghir 6053","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6054","«من أعتق عبدا وله مال فمال العبد له إلا أن يشترط السيد ماله فيكون له»","صحيح","Sahih al-Jami al-Saghir 6054","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6055","«من أعطي حظه من الرفق فقد أعطي حظه من الخير ومن حرم حظه من الرفق فقد حرم حظه من الخير»","صحيح","Sahih al-Jami al-Saghir 6055","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6056","«من أعطى شيئا فوجد فليجز به ومن لم يجد فليثن به فإن أثنى به فقد شكره وإن كتمه فقد كفره ومن تحلى بما لم يعط فإنه كلابس ثوبي زور»","حسن","Sahih al-Jami al-Saghir 6056","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6057","«من أعمر أرضا ليست لأحد فهو أحق بها»","صحيح","Sahih al-Jami al-Saghir 6057","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6058","«من أعمر رجلا عمرى فهي له ولعقبه يرثها من يرثه من عقبه»","صحيح","Sahih al-Jami al-Saghir 6058","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6059","«من أعمر شيئا فهو لمعمره محياه ومماته ولا ترقبوا فمن أرقب شيئا فهو سبيل الميراث»","صحيح","Sahih al-Jami al-Saghir 6059","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6060","«من أعمر شيئا فهو له حياته وبعد موته»","صحيح","Sahih al-Jami al-Saghir 6060","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6061","«من اغبرت قدماه في سبيل الله حرمه الله على النار»","صحيح","Sahih al-Jami al-Saghir 6061","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6062","«من اغتسل يوم الجمعة ثم أتى الجمعة فصلى ما قدر له ثم أنصت حتى يفرغ الإمام من خطبته ثم يصلي معه غفر له ما بينه وبين الجمعة الأخرى وفضل ثلاثة أيام»","صحيح","Sahih al-Jami al-Saghir 6062","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6063","«من اغتسل يوم الجمعة غسل الجنابة ثم راح في الساعة الأولى فكأنما قرب بدنة ومن راح في الساعة الثانية فكأنما قرب بقرة ومن راح في الساعة الثالثة فكأنما قرب كبشا أقرن ومن راح في الساعة الرابعة فكأنما قرب دجاجة ومن راح في الساعة الخامسة فكأنما قرب بيضة فإذا خرج الإمام حضرت الملائكة يستمعون الذكر»","صحيح","Sahih al-Jami al-Saghir 6063","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6064","«من اغتسل يوم الجمعة فأحسن الغسل وتطهر فأحسن الطهور ولبس من أحسن ثيابه ومس ما كتب الله له من طيب أو دهن أهله ثم أتى المسجد فلم يلغ ولم يفرق بين اثنين غفر الله له ما بينه وبين الجمعة الأخرى»","صحيح","Sahih al-Jami al-Saghir 6064","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6065","«من اغتسل يوم الجمعة كان في طهارة إلى الجمعة الأخرى»","حسن","Sahih al-Jami al-Saghir 6065","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6066","«من اغتسل يوم الجمعة واستاك ومس من طيب إن كان عنده ولبس من أحسن ثيابه ثم خرج حتى يأتي المسجد ولم يتخط رقاب الناس ثم ركع ما شاء الله أن يركع ثم أنصت إذا خرج الإمام فلم يتكلم حتى يفرغ من صلاته كانت كفارة لما بينها وبين الجمعة الأخرى»","صحيح","Sahih al-Jami al-Saghir 6066","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6067","«من اغتسل يوم الجمعة ومس من طيب امرأته إن كان لها ولبس من صالح ثيابه ثم لم يتخط رقاب الناس ولم يلغ عند الموعظة كانت كفارة لما بينها ومن لغا وتخطى رقاب الناس كانت له ظهرا»","صحيح","Sahih al-Jami al-Saghir 6067","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6068","«من أفتى بغير علم كان إثمه على من أفتاه ومن أشار على أخيه بأمر يعلم أن الرشد في غيره فقد خانه»","حسن","Sahih al-Jami al-Saghir 6068","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6069","«من أفتى بفتيا غير ثبت فإنما إثمه على من أفتاه»","حسن","Sahih al-Jami al-Saghir 6069","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6070","«من أفطر في رمضان ناسيا فلا قضاء عليه ولا كفارة»","حسن","Sahih al-Jami al-Saghir 6070","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6071","«من أقال مسلما أقال الله تعالى عثرته»","صحيح","Sahih al-Jami al-Saghir 6071","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6072","«من أقام البينة على أسير فله سلبه»","صحيح","Sahih al-Jami al-Saghir 6072","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6073","«من أقام مع المشركين فقد برئت منه الذمة»","صحيح","Sahih al-Jami al-Saghir 6073","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6074","«من اقتبس علما من النجوم اقتبس شعبة من السحر زاد ما زاد»","صحيح","Sahih al-Jami al-Saghir 6074","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6075","«من اقتطع أرضا ظالما لقي الله وهو عليه غضبان»","صحيح","Sahih al-Jami al-Saghir 6075","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6076","«من اقتطع حق امرئ مسلم بيمينه فقد أوجب الله له النار وحرم عليه الجنة وإن كان قضيبا من أراك»","صحيح","Sahih al-Jami al-Saghir 6076","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6077","«من اقتنى كلبا إلا كلب ماشية أو ضاريا نقص من عمله كل يوم قيراطان»","صحيح","Sahih al-Jami al-Saghir 6077","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6078","«من اقتنى كلبا ليس بكلب صيد ولا ماشية ولا أرض فإنه ينقص من أجره قيراطان كل يوم»","صحيح","Sahih al-Jami al-Saghir 6078","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6079","«من اقتنى كلبا لا يغني عنه زرعا ولا ضرعا نقص من عمله كل يوم قيراط»","صحيح","Sahih al-Jami al-Saghir 6079","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6080","«من أقرض ورقا مرتين كان كعدل صدقة مرة»","صحيح","Sahih al-Jami al-Saghir 6080","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6081","«من اكتوى أو استرقى فقد برئ من التوكل»","صحيح","Sahih al-Jami al-Saghir 6081","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6082","«من أكل أو شرب ناسيا فلا يفطر فإنما هورزق رزقه الله»","صحيح","Sahih al-Jami al-Saghir 6082","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6083","«من أكل برجل مسلم أكلة فإن الله يطعمه مثلها من جهنم ومن اكتسى برجل مسلم ثوبا فإن الله يكسوه مثله من جهنم ومن قام برجل مسلم مقام سمعة ورياء فإن الله يقوم به مقام سمعة ورياء يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6083","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6084","«من أكل ثوما أو بصلا فليعتزلنا وليعتزل مسجدنا وليقعد في بيته»","صحيح","Sahih al-Jami al-Saghir 6084","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6085","«من أكل سبع تمرات مما بين لابتيها حين يصبح لم يضره ذلك اليوم سم حتى يمسي»","صحيح","Sahih al-Jami al-Saghir 6085","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6086","«من أكل طعاما ثم قال: الحمد لله الذي أطعمني هذا الطعام ورزقنيه من غير حول مني ولا قوة غفر له ما تقدم من ذنبه ومن لبس ثوبا فقال: الحمد لله الذي كساني هذا ورزقنيه من غير حول مني ولا قوة غفر له ما تقدم من ذنبه وما تأخر»","حسن","Sahih al-Jami al-Saghir 6086","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6087","«من أكل لحما فليتوضأ»","حسن","Sahih al-Jami al-Saghir 6087","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6088","«من أكل مع قوم تمرا فلا يقرن إلا أن يأذنوا له»","صحيح","Sahih al-Jami al-Saghir 6088","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6089","«من أكل من هذه البقلة: الثوم والبصل والكراث فلا يقربنا في مساجدنا فإن الملائكة تتأذى مما يتأذى منه بنوآدم»","صحيح","Sahih al-Jami al-Saghir 6089","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6090","«من أكل من هذه الشجرة الخبيثة شيئا فلا يقربنا في المسجد: يا أيها الناس إنه ليس لي تحريم ما أحل الله ولكنها شجرة أكره ريحها»","صحيح","Sahih al-Jami al-Saghir 6090","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6091","«من أكل من هذه الشجرة الخبيثة فلا يقربن مسجدنا فإن الملائكة تتأذى مما يتأذى منه الإنس»","صحيح","Sahih al-Jami al-Saghir 6091","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6092","«من أكل من هذه الشجرة الخبيثة فلا يقربن مصلانا حتى يذهب ريحها»","صحيح","Sahih al-Jami al-Saghir 6092","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6093","«من أكل من هذه الشجرة فلا يقربن المساجد»","صحيح","Sahih al-Jami al-Saghir 6093","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6094","«من أكل من هذه الشجرة فلا يقربن مسجدنا ولا يؤذينا بريح الثوم»","صحيح","Sahih al-Jami al-Saghir 6094","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6095","«من أكل من هذه الشجرة فلا يقربنا ولا يصلين معنا»","صحيح","Sahih al-Jami al-Saghir 6095","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6096","من أكل من هذه الشجرة - يعني الثوم - فلا يقربن مسجدنا","صحيح","Sahih al-Jami al-Saghir 6096","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6097","«من التمس رضا الله بسخط الناس كفاه الله مؤنة الناس ومن التمس رضا الناس بسخط الله وكله الله إلى الناس»","صحيح","Sahih al-Jami al-Saghir 6097","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6098","«من أماط أذى عن طريق المسلمين كتب له حسنة ومن تقبلت منه حسنة دخل الجنة»","حسن","Sahih al-Jami al-Saghir 6098","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6099","«من أمركم من الولاة بمعصية فلا تطيعوه»","حسن","Sahih al-Jami al-Saghir 6099","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6100","[من أمسك كلبا فإنه ينقص من عمله كل يوم قيراط إلا كلب حرث أو كلب ماشية]","صحيح","Sahih al-Jami al-Saghir 6100","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6101","«من أم الناس فأصاب الوقت وأتم الصلاة فله ولهم ومن انتقص من ذلك شيئا فعليه ولا عليهم»","صحيح","Sahih al-Jami al-Saghir 6101","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6102","«من أم قوما وهم له كارهون فإن صلاته لا تجأوز ترقوته»","حسن","Sahih al-Jami al-Saghir 6102","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6103","«من أمن رجلا على دمه فقتله فأنا بريء من القاتل وإن كان المقتول كافرا»","صحيح","Sahih al-Jami al-Saghir 6103","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6104","«من انتسب إلى غير أبيه أو تولى غير مواليه فعليه لعنة الله والملائكة والناس أجمعين»","صحيح","Sahih al-Jami al-Saghir 6104","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6105","«من انتهب فليس منا»","صحيح","Sahih al-Jami al-Saghir 6105","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6106","«من أنظر معسرا أو وضع عنه أظله الله في ظله يوم لا ظل إلا ظله»","صحيح","Sahih al-Jami al-Saghir 6106","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6107","«من أنظر معسرا أو وضع له أظله الله يوم القيامة تحت ظل عرشه يوم لا ظل إلا ظله»","صحيح","Sahih al-Jami al-Saghir 6107","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6108","«من أنظر معسرا فله بكل يوم مثله صدقة قبل أن يحل الدين فإذا حل الدين فأنظره فله بكل يوم مثلاه صدقة»","صحيح","Sahih al-Jami al-Saghir 6108","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6109","«من أنفق زوجين في سبيل الله نودي من أبواب الجنة: يا عبد الله هذا خير فمن كان من أهل الصلاة دعي من باب الصلاة ومن كان من أهل الجهاد دعي من باب الجهاد ومن كان من أهل الصيام دعي من باب الريان ومن كان من أهل الصدقة دعي من باب الصدقة ; قال أبو بكر: هل يدعى أحد من تلك الأبواب كلها؟ قال: نعم وأرجوأن تكون منهم»","صحيح","Sahih al-Jami al-Saghir 6109","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6110","«من أنفق نفقة في سبيل الله كتبت له سبعمائة ضعف»","صحيح","Sahih al-Jami al-Saghir 6110","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6111","«من أهان سلطان الله في الأرض أهانه الله»","حسن","Sahih al-Jami al-Saghir 6111","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6112","«من أهان قريشا أهانه الله»","صحيح","Sahih al-Jami al-Saghir 6112","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6113","«من بات على ظهر بيت ليس عليه حجاب فقد برئت منه الذمة»","صحيح","Sahih al-Jami al-Saghir 6113","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6114","«من بات وفي يده ريح غمر فأصابه وضح فلا يلومن إلا نفسه»","حسن","Sahih al-Jami al-Saghir 6114","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6115","«من بات وفي يده غمر فأصابه شيء فلا يلومن إلا نفسه»","صحيح","Sahih al-Jami al-Saghir 6115","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6116","«من باع بيعتين في بيعة فله أوكسهما أو الربا»","حسن","Sahih al-Jami al-Saghir 6116","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6117","«من باع ثمرا فأصابته جائحة فلا يأخذ من مال أخيه شيئا علام يأكل أحدكم مال أخيه المسلم؟!»","حسن","Sahih al-Jami al-Saghir 6117","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6118","«من باع جلد أضحيته فلا أضحية له»","حسن","Sahih al-Jami al-Saghir 6118","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6119","«من باع دارا ثم لم يجعل ثمنها في مثلها لم يبارك له فيها»","حسن","Sahih al-Jami al-Saghir 6119","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6120","«من باع منكم دارا أو عقارا فليعلم أنه مال قمن أن لا يبارك له فيه إلا أن يجعله في مثله»","حسن","Sahih al-Jami al-Saghir 6120","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6121","«من بدأ بالسلام فهو أولى بالله ورسوله»","صحيح","Sahih al-Jami al-Saghir 6121","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6122","«من بدأ بالكلام قبل السلام فلا تجيبوه»","حسن","Sahih al-Jami al-Saghir 6122","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6123","«من بدا جفا»","صحيح","Sahih al-Jami al-Saghir 6123","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6124","«من بدا جفا ومن اتبع الصيد غفل ومن أتى أبواب السلطان افتتن»","صحيح","Sahih al-Jami al-Saghir 6124","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6125","«من بدل دينه فاقتلوه»","صحيح","Sahih al-Jami al-Saghir 6125","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6126","«من بلغ بسهم في سبيل الله فهو له درجة في الجنة»","صحيح","Sahih al-Jami al-Saghir 6126","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6127","«من بنى لله مسجدا بنى الله له بيتا في الجنة»","صحيح","Sahih al-Jami al-Saghir 6127","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6128","«من بنى لله مسجدا ولو كمفحص قطاة أو أصغر بنى الله له بيتا في الجنة»","صحيح","Sahih al-Jami al-Saghir 6128","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6129","«من بنى لله مسجدا ولو كمفحص قطاة لبيضها بنى الله له بيتا في الجنة»","صحيح","Sahih al-Jami al-Saghir 6129","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6130","«من بنى مسجدا لله يذكر الله فيه بنى الله له مثله في الجنة»","صحيح","Sahih al-Jami al-Saghir 6130","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6131","«من بنى مسجدا يبتغي به وجه الله بنى الله له مثله في الجنة»","صحيح","Sahih al-Jami al-Saghir 6131","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6132","«من تاب إلى الله قبل أن يغرغر قبل الله منه»","صحيح","Sahih al-Jami al-Saghir 6132","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6133","«من تاب قبل أن تطلع الشمس من مغربها تاب الله عليه»","صحيح","Sahih al-Jami al-Saghir 6133","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6134","من تبع جنازة حتى يصلي عليها كان له من الأجر قيراط ومن مشى مع الجنازة حتى تدفن كان له من الأجر قيراطان والقيراط مثل أحد","صحيح","Sahih al-Jami al-Saghir 6134","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6135","«من تبع جنازة حتى يصلي عليها ويفرغ منها فله قيراطان ومن تبعها حتى يصلي عليها فله قيراط والذي نفس محمد بيده لهوأثقل في ميزانه من أحد»","صحيح","Sahih al-Jami al-Saghir 6135","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6136","«من تبع جنازة حتى يفرغ منها فله قيراطان فإن رجع قبل أن يفرغ منها فله قيراط»","صحيح","Sahih al-Jami al-Saghir 6136","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6137","«من تبع جنازة فصلى عليها ثم انصرف فله قيراط من الأجر ومن تبعها فصلى عليها ثم قعد حتى فرغ منها ومن دفنها فله قيراطان من الأجر كل واحد منهما أعظم من أحد»","حسن","Sahih al-Jami al-Saghir 6137","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6138","«من تبع جنازة مسلم أيمانا واحتسابا وكان معها حتى يصلي عليها ويفرغ من دفنها فإنه يرجع من الأجر بقيراطين كل قيراط مثل أحد ومن صلى عليها ثم رجع قبل أن تدفن فإنه يرجع بقيراط من الأجر»","صحيح","Sahih al-Jami al-Saghir 6138","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6139","«من تحلم كاذبا كلف يوم القيامة أن يعقد بين شعيرتين ولن يعقد بينهما»","صحيح","Sahih al-Jami al-Saghir 6139","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6140","من ترك الجمعة ثلاث مرات متواليات: من غير ضرورة طبع الله على قلبه","صحيح","Sahih al-Jami al-Saghir 6140","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6141","«من ترك الحيات مخافة طلبهن فليس منا ما سالمناهن منذ حاربناهن»","صحيح","Sahih al-Jami al-Saghir 6141","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6142","«من ترك الرمي بعد ما علمه رغبة عنه فإنها نعمة كفرها»","صحيح","Sahih al-Jami al-Saghir 6142","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6143","«من ترك ثلاث جمع تهأونا بها طبع الله على قلبه»","صحيح","Sahih al-Jami al-Saghir 6143","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6144","«من ترك ثلاث جمعات من غير عذر كتب من المنافقين»","صحيح","Sahih al-Jami al-Saghir 6144","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6145","«من ترك اللباس تواضعا لله وهو يقدر عليه دعاه الله يوم القيامة على رءوس الخلائق حتى يخيره من أي حلل الإيمان شاء يلبسها»","حسن","Sahih al-Jami al-Saghir 6145","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6146","«من ترك صلاة العصر حبط عمله»","صحيح","Sahih al-Jami al-Saghir 6146","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6147","«من ترك مالا فلورثته ومن ترك كلا فإلى الله ورسوله وأنا وارث من لا وارث له أعقل عنه وأرثه والخال وارث من لا وارث له يعقل عنه ويرثه»","حسن","Sahih al-Jami al-Saghir 6147","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6148","«من تزوج فقد استكمل نصف الإيمان فليتق الله في النصف الباقي»","حسن","Sahih al-Jami al-Saghir 6148","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6149","«من تشبه بقوم فهو منهم»","صحيح","Sahih al-Jami al-Saghir 6149","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6150","«من تصبح كل يوم بسبع تمرات عجوة لم يضره في ذلك اليوم سم ولا سحر»","صحيح","Sahih al-Jami al-Saghir 6150","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6151","«من تصدق بشيء من جسده أعطي بقدر ما تصدق»","صحيح","Sahih al-Jami al-Saghir 6151","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6152","«من تصدق بعدل تمرة من كسب طيب ولا يقبل الله إلا الطيب فإن الله يتقبلها بيمينه ثم يربيها لصاحبها كما يربي أحدكم فلوه حتى تكون مثل الجبل»","صحيح","Sahih al-Jami al-Saghir 6152","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6153","«من تطبب ولم يعلم منه طب فهو ضامن»","حسن","Sahih al-Jami al-Saghir 6153","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6154","«من تطهر في بيته ثم أتى مسجد قباء فصلى فيه كان له كأجر عمرة»","صحيح","Sahih al-Jami al-Saghir 6154","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6155","من تطهر في بيته ثم مشى إلى بيت من بيوت الله ليقضي فريضة من فرائض الله كانت خطواته إحداهما تحط خطيئة والأخرى ترفع درجة","صحيح","Sahih al-Jami al-Saghir 6155","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6156","«من تعار من الليل فقال حين يستيقظ: لا إله إلا الله وحده لا شريك له له الملك وله الحمد يحيي ويميت بيده الخير وهو على كل شيء قدير سبحان الله والحمد لله ولا إله إلا الله والله أكبر ولا حول ولا قوة إلا بالله ثم قال: اللهم اغفر لي أو دعا استجيب له فإن قام فتوضأ ثم صلى قبلت صلاته»","صحيح","Sahih al-Jami al-Saghir 6156","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6157","«من تعظم في نفسه واختال في مشيته لقي الله وهو عليه غضبان»","صحيح","Sahih al-Jami al-Saghir 6157","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6158","«من تعلم العلم ليباهي به العلماء أو يماري به السفهاء أو يصرف به وجوه الناس إليه أدخله الله جهنم»","صحيح","Sahih al-Jami al-Saghir 6158","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6159","«من تعلم علما مما يبتغى به وجه الله لا يتعلمه إلا ليصيب به عوضا من الدنيا لم يجد عرف الجنة يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6159","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6160","«من تفل تجاه القبلة جاء يوم القيامة تفله بين عينيه ومن أكل من هذه البقلة الخبيثة فلا يقربن مسجدنا»","صحيح","Sahih al-Jami al-Saghir 6160","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6161","«من تقول علي ما لم أقل فليتبوأ مقعده من النار»","صحيح","Sahih al-Jami al-Saghir 6161","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6162","«من تواضع لله رفعه الله»","صحيح","Sahih al-Jami al-Saghir 6162","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6163","«من توضأ فأحسن الوضوء ثم راح فوجد الناس قد صلوا أعطاه الله مثل أجر من صلاها وحضرها لا ينقص ذلك من أجرهم شيئا»","صحيح","Sahih al-Jami al-Saghir 6163","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6164","«من توضأ فأحسن الوضوء، ... فقال: أشهد أن لا إله إلا الله وحده لا شريك له وأشهد أن محمد عبده ورسوله فتحت له أبواب الجنة يدخل من أيها شاء»","صحيح","Sahih al-Jami al-Saghir 6164","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6165","«من توضأ فأحسن الوضوء ثم صلى ركعتين لا يسهو فيهما غفر الله له ما تقدم من ذنبه»","حسن","Sahih al-Jami al-Saghir 6165","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6166","«من توضأ فأحسن الوضوء ثم صلى ركعتين يقبل عليهما بقلبه ووجهه وجبت له الجنة»","صحيح","Sahih al-Jami al-Saghir 6166","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6167","«من توضأ فأحسن الوضوء ثم قال: أشهد أن لا إله إلا الله وحده لا شريك له وأن محمدا عبده ورسوله اللهم اجعلني من التوابين واجعلني من المتطهرين فتحت له ثمانية أبواب الجنة يدخل من أيها شاء»","صحيح","Sahih al-Jami al-Saghir 6167","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6168","من توضأ فأحسن الوضوء، ... فقال: أشهد أن لا إله إلا الله وحده لا شريك له وأشهد أن محمدا عبده ورسوله فتحت له أبواب الجنة من أيها شاء دخل","صحيح","Sahih al-Jami al-Saghir 6168","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6169","«من توضأ فأحسن الوضوء خرجت خطاياه من جسده حتى تخرج من تحت أظفاره»","صحيح","Sahih al-Jami al-Saghir 6169","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6170","«من توضأ فقال بعد فراغه من وضوئه: سبحانك اللهم وبحمدك أشهد أن لا إله إلا أنت أستغفرك وأتوب إليك كتب في رق ثم جعل في طابع فلم يكسر إلى يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6170","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6171","«من توضأ فليستنثر ومن استجمر فليوتر»","صحيح","Sahih al-Jami al-Saghir 6171","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6172","«من توضأ كما أمر وصلى كما أمر غفر له ما قدم من عمل»","حسن","Sahih al-Jami al-Saghir 6172","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6173","«من توضأ للصلاة فأسبغ الوضوء ثم مشى إلى الصلاة المكتوبة فصلاها مع الناس غفر الله له ذنوبه»","صحيح","Sahih al-Jami al-Saghir 6173","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6174","«من توضأ مثل هذا الوضوء ثم أتى المسجد فركع ركعتين ثم جلس غفر له ما تقدم من ذنبه ولا تغتروا»","صحيح","Sahih al-Jami al-Saghir 6174","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6175","«من توضأ مثل وضوئي هذا ثم قام فصلى ركعتين لا يحدث فيهما نفسه بشيء غفر له ما تقدم من ذنبه»","صحيح","Sahih al-Jami al-Saghir 6175","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6176","«من توضأ نحووضوئي هذا ثم صلى ركعتين لا يحدث فيهما نفسه غفر له ما تقدم من ذنبه»","صحيح","Sahih al-Jami al-Saghir 6176","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6177","«من توضأ هكذا ثم خرج إلى المسجد لا ينهزه إلا الصلاة غفر له ما خلا من ذنبه»","صحيح","Sahih al-Jami al-Saghir 6177","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6178","«من توضأ هكذا غفر له ما تقدم من ذنبه وكانت صلاته ومشيه إلى المسجد نافلة»","صحيح","Sahih al-Jami al-Saghir 6178","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6179","«من توضأ يوم الجمعة فأحسن الوضوء ثم أتى الجمعة فدنا واستمع وأنصت غفر له ما بينه وبين الجمعة الأخرى وزيادة ثلاثة أيام ومن مس الحصى فقد لغا»","صحيح","Sahih al-Jami al-Saghir 6179","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6180","«من توضأ يوم الجمعة فبها ونعمت ومن اغتسل فالغسل أفضل»","حسن","Sahih al-Jami al-Saghir 6180","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6181","«من تولى غير مواليه فقد خلع ربقة الإسلام من عنقه»","صحيح","Sahih al-Jami al-Saghir 6181","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6182","«من تولى قوما بغير إذن مواليه فعليه لعنة الله والملائكة والناس أجمعين لا يقبل الله منه يوم القيامة صرفا ولا عدلا»","صحيح","Sahih al-Jami al-Saghir 6182","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6183","«من ثابر على اثنتي عشرة ركعة من السنة بنى الله له بيتا في الجنة: أربع ركعات قبل الظهر وركعتين بعدها وركعتين بعد المغرب وركعتين بعد العشاء وركعتين قبل الفجر»","صحيح","Sahih al-Jami al-Saghir 6183","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6184","«من جاء مسجدي هذا لم يأته إلا لخير يتعلمه أو يعلمه فهو في منزلة المجاهد في سبيل الله ومن جاءه لغير ذلك فهو بمنزلة الرجل ينظر إلى متاع غيره»","صحيح","Sahih al-Jami al-Saghir 6184","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6185","«من جاء يعبد الله لا يشرك به شيئا ويقيم الصلاة ويؤتي الزكاة ويصوم رمضان ويتقي الكبائر فإن له الجنة قالوا: ما الكبائر؟ قال: الإشراك بالله وقتل النفس المسلمة وفرار يوم الزحف»","صحيح","Sahih al-Jami al-Saghir 6185","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6186","«من جامع المشرك وسكن معه فإنه مثله»","حسن","Sahih al-Jami al-Saghir 6186","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6187","«من جر إزاره لا يريد بذلك إلا المخيلة فإن الله لا ينظر إليه يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6187","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6188","«من جر ثوبه خيلاء لم ينظر الله إليه يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6188","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6189","من جعل الهموم هما واحدا هم المعاد كفاه الله سائر همومه ومن تشعبت به الهموم من أحوال الدنيا لم يبال الله في أي أوديتها هلك","حسن","Sahih al-Jami al-Saghir 6189","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6190","«من جعل قاضيا بين الناس فقد ذبح بغير سكين»","صحيح","Sahih al-Jami al-Saghir 6190","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6191","«من جلب على الخيل يوم الرهان فليس منا»","حسن","Sahih al-Jami al-Saghir 6191","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6192","«من جلس في مجلس فكثر فيه لغطه فقال قبل أن يقوم من مجلسه ذلك: سبحانك اللهم ربنا وبحمدك أشهد أن لا إله إلا أنت أستغفرك وأتوب إليك إلا غفر له ما كان في مجلسه ذلك»","صحيح","Sahih al-Jami al-Saghir 6192","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6193","«من جهز غازيا في سبيل الله فقد غزا ومن خلف غازيا في سبيل الله في أهله بخير فقد غزا»","صحيح","Sahih al-Jami al-Saghir 6193","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6194","«من جهز غازيا في سبيل الله كان له مثل أجره من غير أن ينقص من أجر الغازي شيئا»","صحيح","Sahih al-Jami al-Saghir 6194","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6195","«من حافظ على أربع ركعات قبل الظهر وأربع بعدها حرم على النار»","صحيح","Sahih al-Jami al-Saghir 6195","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6196","من حالت شفاعته دون حد من حدود الله فقد ضاد الله في أمره ومن مات وعليه دين فليس بالدينار والدرهم ولكن بالحسنات والسيئات ومن خاصم في باطل وهو يعلمه لم يزل في سخط الله حتى ينزع ومن قال في مؤمن ما ليس فيه أسكنه الله ردغة الخبال حتى يخرج مما قال وليس بخارج","صحيح","Sahih al-Jami al-Saghir 6196","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6197","«من حج لله فلم يرفث ولم يفسق رجع كيوم ولدته أمه»","صحيح","Sahih al-Jami al-Saghir 6197","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6198","«من حج هذا البيت ... ، فليكن آخر عهده الطواف بالبيت»","صحيح","Sahih al-Jami al-Saghir 6198","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6199","«من حدث عني بحديث يرى أنه كذب فهو أحد الكاذبين»","صحيح","Sahih al-Jami al-Saghir 6199","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6200","«من حفر بئرا فله أربعون ذراعا عطنا لماشيته»","حسن","Sahih al-Jami al-Saghir 6200","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6201","«من حفظ عشر آيات من أول سورة الكهف عصم من فتنة الدجال»","صحيح","Sahih al-Jami al-Saghir 6201","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6202","«من حفظ ما بين فقميه ورجليه دخل الجنة»","صحيح","Sahih al-Jami al-Saghir 6202","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6203","«من حلف بالأمانة فليس منا»","صحيح","Sahih al-Jami al-Saghir 6203","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6204","«من حلف بغير الله فقد أشرك»","صحيح","Sahih al-Jami al-Saghir 6204","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6205","«من حلف على يمين آثمة عند منبري هذا فلتيبوأ مقعده من النار ولو على سواك أخضر»","صحيح","Sahih al-Jami al-Saghir 6205","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6206","«من حلف فاستثنى فإن شاء مضى وإن شاء ترك غير حنث»","صحيح","Sahih al-Jami al-Saghir 6206","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6207","«من حلف على يمين صبر يقتطع بها مال امرئ مسلم هوفيها فاجر لقي الله وهو عليه غضبان»","صحيح","Sahih al-Jami al-Saghir 6207","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6208","«من حلف على يمين فرأى غيرها خيرا منها فليأت الذي هوخير وليكفر عن يمينه»","صحيح","Sahih al-Jami al-Saghir 6208","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6209","«من حلف على يمين فقال: إن شاء الله فقد استثنى»","صحيح","Sahih al-Jami al-Saghir 6209","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6210","«من حلف على يمين فقال: إن شاء الله فهو بالخيار إن شاء مضى وإن شاء ترك»","صحيح","Sahih al-Jami al-Saghir 6210","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6211","«من حلف على يمين فقال: إن شاء الله فهو بالخيار إن شاء مضى وإن شاء ترك غير حنث»","صحيح","Sahih al-Jami al-Saghir 6211","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6212","«من حلف على يمين فقال: إن شاء الله فلا حنث عليه»","صحيح","Sahih al-Jami al-Saghir 6212","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6213","«من حلف على يمين مصبورة كاذبا متعمدا ليقتطع بها مال أخيه المسلم فليتبوأ مقعده من النار»","صحيح","Sahih al-Jami al-Saghir 6213","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6214","«من حلف فليحلف برب الكعبة»","صحيح","Sahih al-Jami al-Saghir 6214","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6215","«من حلف في قطيعة رحم أو فيما لا يصلح فبره أن لا يتم على ذلك»","صحيح","Sahih al-Jami al-Saghir 6215","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6216","«من حلف منكم فقال في حلفه: واللات والعزى فليقل: لا إله إلا الله ومن قال لصاحبه: تعال أقامرك فليتصدق بشيء»","صحيح","Sahih al-Jami al-Saghir 6216","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6217","«من حمل علينا السلاح فليس منا»","صحيح","Sahih al-Jami al-Saghir 6217","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6218","«من حمل علينا السلاح فليس منا ومن غشنا فليس منا»","صحيح","Sahih al-Jami al-Saghir 6218","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6219","«من حوسب عذب»","صحيح","Sahih al-Jami al-Saghir 6219","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6220","«من حوسب يوم القيامة عذب قالت عائشة: أوليس يقول الله: {فَسَوْفَ يُحَاسَبُ حِسَاباً يَسِيراً} ؟ قال: ليس ذلك بالحساب إنما ذلك العرض ولكن من نوقش الحساب يهلك»","صحيح","Sahih al-Jami al-Saghir 6220","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6221","«من خاف أن لا يقوم من آخر الليل فليوتر أوله ومن طمع أن يقوم آخره فليوتر آخر الليل فإن صلاة آخر الليل مشهودة وذلك أفضل»","صحيح","Sahih al-Jami al-Saghir 6221","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6222","«من خاف أدلج ومن أدلج بلغ المنزل ألا إن سلعة الله غالية ألا إن سلعة الله الجنة»","صحيح","Sahih al-Jami al-Saghir 6222","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6223","«من خبب زوجة امرئ أو مملوكه فليس منا»","صحيح","Sahih al-Jami al-Saghir 6223","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6224","«من ختم له بصيام يوم دخل الجنة»","صحيح","Sahih al-Jami al-Saghir 6224","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6225","«من خرج حتى يأتي هذا المسجد مسجد قباء فيصلي فيه كان له عدل عمرة»","صحيح","Sahih al-Jami al-Saghir 6225","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6226","«من خرج مع جنازة من بيتها وصلى عليها ثم تبعها حتى تدفن كان له قيراطان من أجر كل قيراط مثل أحد ومن صلى عليها ثم رجع كان له من الأجر مثل أحد»","صحيح","Sahih al-Jami al-Saghir 6226","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6227","«من خرج من الطاعة وفارق الجماعة فمات مات ميتة جاهلية ومن قاتل تحت راية عمية يغضب لعصبية أو يدعو إلى عصبية أو ينصر عصبية فقتل فقتلته جاهلية ومن خرج على أمتي يضرب برها وفاجرها ولا يتحاشا من مؤمنها ولا يفي لذي عهدة عهده فليس مني ولست منه»","صحيح","Sahih al-Jami al-Saghir 6227","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6228","«من خرج من بيته متطهرا إلى صلاة مكتوبة فأجره كأجر الحاج المحرم ومن خرج إلى تسبيح الضحى لا ينصبه إلا إياه فأجره كأجر المعتمر وصلاة على أثر صلاة لا لغوبينهما كتاب في عليين»","حسن","Sahih al-Jami al-Saghir 6228","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6229","«من خلع يدا من طاعة لقي الله يوم القيامة لا حجة له ومن مات وليس في عنقه بيعة مات ميتة جاهلية»","صحيح","Sahih al-Jami al-Saghir 6229","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6230","«من خلقه الله لواحدة من المنزلتين وفقه لعملها»","صحيح","Sahih al-Jami al-Saghir 6230","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6231","«من دخل السوق فقال: لا إله إلا الله وحده لا شريك له له الملك وله الحمد يحيي ويميت وهو حي لا يموت بيده الخير وهو على كل شيء قدير كتب الله له ألف ألف حسنة ومحا عنه ألف ألف سيئة ورفع له ألف ألف درجة وبنى له بيتا في الجنة»","حسن","Sahih al-Jami al-Saghir 6231","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6232","«من دخل حائطا فليأكل ولا يتخذ خبيئة»","حسن","Sahih al-Jami al-Saghir 6232","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6233","«من دخل في هذا المسجد فبزق فيه أو تنخم فليحفر فليدفنه فإن لم يفعل فليبزق في ثوبه ثم ليخرج به»","صحيح","Sahih al-Jami al-Saghir 6233","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6234","«من دعا إلى هدى كان له من الأجر مثل أجور من تبعه لا ينقص ذلك من أجورهم شيئا ومن دعا إلى ضلالة كان عليه من الإثم مثل آثام من تبعه لا ينقص ذلك من آثامهم شيئا»","صحيح","Sahih al-Jami al-Saghir 6234","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6235","«من دعا لأخيه بظهر الغيب قال الملك الموكل به: آمين ولك بمثله»","صحيح","Sahih al-Jami al-Saghir 6235","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6236","«من دعي إلى طعام وهو صائم فليجب فإن شاء طعم وإن شاء ترك»","صحيح","Sahih al-Jami al-Saghir 6236","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6237","«من دعي إلى عرس أو نحوه فليجب»","صحيح","Sahih al-Jami al-Saghir 6237","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6238","«من دفن ثلاثة من الولد حرم الله عليه النار»","صحيح","Sahih al-Jami al-Saghir 6238","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6239","«من دل على خير فله مثل أجر فاعله»","صحيح","Sahih al-Jami al-Saghir 6239","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6240","«من ذب عن عرض أخيه بالغيبة كان حقا على الله أن يعتقه من النار»","صحيح","Sahih al-Jami al-Saghir 6240","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6241","«من ذبح بعد الصلاة تم نسكه وأصاب سنة المسلمين»","صحيح","Sahih al-Jami al-Saghir 6241","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6242","«من ذبح قبل الصلاة فإنما يذبح لنفسه ومن ذبح بعد الصلاة فقد تم نسكه وأصاب سنة المسلمين»","صحيح","Sahih al-Jami al-Saghir 6242","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6243","«من ذرعه القيء وهو صائم فليس عليه قضاء ومن استقاء فليقض»","صحيح","Sahih al-Jami al-Saghir 6243","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6244","«من ذكر رجلا بما فيه فقد اغتابه»","صحيح","Sahih al-Jami al-Saghir 6244","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6245","«من ذكرت عنده فخطئ الصلاة علي خطئ طريق الجنة»","صحيح","Sahih al-Jami al-Saghir 6245","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6246","«من ذكرت عنده فليصل علي فإنه من صلى علي مرة صلى الله عليه عشرا»","صحيح","Sahih al-Jami al-Saghir 6246","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6247","«من رأى حية فلم يقتلها مخافة طلبها فليس منا»","صحيح","Sahih al-Jami al-Saghir 6247","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6248","من رأى مبتلى فقال: الحمد لله الذي عافاني مما ابتلاك به وفضلني على كثير ممن خلق تفضيلا لم يصبه ذلك البلاء","حسن","Sahih al-Jami al-Saghir 6248","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6249","«من رأى من أميره شيئا يكرهه فليصبر عليه فإنه ليس أحد يفارق الجماعة شبرا فيموت إلا مات ميتة جاهلية»","صحيح","Sahih al-Jami al-Saghir 6249","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6250","«من رأى منكم منكرا فليغيره بيده فإن لم يستطع فبلسانه فإن لم يستطع فبقلبه وذلك أضعف الإيمان»","صحيح","Sahih al-Jami al-Saghir 6250","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6251","«من رأى منكم هلال ذي الحجة وأراد أن يضحي فلا يأخذن من شعره ولا من أظافره حتى يضحي»","صحيح","Sahih al-Jami al-Saghir 6251","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6252","«من رآني فإني أنا هوفإنه ليس للشيطان أن يتمثل بي»","صحيح","Sahih al-Jami al-Saghir 6252","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6253","«من رآني فقد رأى الحق فإن الشيطان لا يتزايا بي»","صحيح","Sahih al-Jami al-Saghir 6253","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6254","«من رآني فقد رأى الحق فإن الشيطان لا يتزايا بي»","صحيح","Sahih al-Jami al-Saghir 6254","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6255","«من رآني في المنام فسيراني في اليقظة ولا يتمثل الشيطان بي»","صحيح","Sahih al-Jami al-Saghir 6255","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6256","من رآني في المنام فقد رآني إنه لا ينبغي للشيطان أن يتمثل في صورتي","صحيح","Sahih al-Jami al-Saghir 6256","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6257","«من رآني في المنام فقد رآني فإن الشيطان لا يتمثل بي»","صحيح","Sahih al-Jami al-Saghir 6257","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6258","«من رأت ذلك منكن فأنزلت فلتغتسل»","صحيح","Sahih al-Jami al-Saghir 6258","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6259","«من رابط يوما وليلة في سبيل الله كان له كأجر صيام شهر وقيامه ومن مات مرابطا جرى له مثل ذلك من الأجر وأجري عليه الرزق وأمن الفتان»","صحيح","Sahih al-Jami al-Saghir 6259","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6260","«من راح روحة في سبيل الله كان له بمثل ما أصابه من الغبار مسكا يوم القيامة»","حسن","Sahih al-Jami al-Saghir 6260","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6261","«من رحم ولو ذبيحة عصفور رحمه الله يوم القيامة»","حسن","Sahih al-Jami al-Saghir 6261","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6262","«من رد عن عرض أخيه رد الله عن وجهه النار يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6262","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6263","«من رد عن عرض أخيه كان له حجابا من النار»","صحيح","Sahih al-Jami al-Saghir 6263","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6264","«من ردته الطيرة عن حاجته فقد أشرك»","صحيح","Sahih al-Jami al-Saghir 6264","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6265","«من رفع حجرا عن الطريق كتب له حسنة ومن كانت له حسنة دخل الجنة»","حسن","Sahih al-Jami al-Saghir 6265","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6266","«من ركع اثنتي عشرة ركعة بني له بيت في الجنة»","صحيح","Sahih al-Jami al-Saghir 6266","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6267","«من رمى العدوبسهم في سبيل الله فبلغ سهمه العدوأصاب أو أخطأ يعدل رقبة»","صحيح","Sahih al-Jami al-Saghir 6267","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6268","«من رمى بسهم في سبيل الله فهو له عدل محرر»","صحيح","Sahih al-Jami al-Saghir 6268","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6269","«من رمى مؤمنا بكفر فهو كقتله»","صحيح","Sahih al-Jami al-Saghir 6269","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6270","«من رمانا بالليل فليس منا»","صحيح","Sahih al-Jami al-Saghir 6270","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6271","«من زار قوما فلا يؤمهم وليؤمهم رجل منهم»","صحيح","Sahih al-Jami al-Saghir 6271","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6272","«من زرع أرضا بغير إذن أهلها فله نفقته وليس له في الزرع شيء»","صحيح","Sahih al-Jami al-Saghir 6272","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6273","«من زرع زرعا فأكل منه طير أو عافية كان له صدقة»","صحيح","Sahih al-Jami al-Saghir 6273","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6274","«من زنى خرج منه الإيمان فإن تاب تاب الله عليه»","حسن","Sahih al-Jami al-Saghir 6274","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6275","«من سأل الله الجنة ثلاث مرات قالت الجنة: اللهم أدخله الجنة ومن استجار من النار ثلاث مرات قالت النار: اللهم أجره من النار»","صحيح","Sahih al-Jami al-Saghir 6275","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6276","«من سأل الله الشهادة بصدق بلغه الله منازل الشهداء وإن مات على فراشه»","صحيح","Sahih al-Jami al-Saghir 6276","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6277","«من سأل الله القتل في سبيل الله صادقا من قلبه أعطاه الله أجر شهيد وإن مات على فراشه»","صحيح","Sahih al-Jami al-Saghir 6277","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6278","«من سأل الناس أموالهم تكثرا فإنما يسأل جمر جهنم فليستقل منه أو ليستكثر»","صحيح","Sahih al-Jami al-Saghir 6278","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6279","من سأل الناس وله ما يغنيه جاء يوم القيامة ومسألته في وجهه خموش أو خدوش أو كدوح قيل: وما الغنى؟ قال: خمسون درهما أو قيمتها من الذهب","صحيح","Sahih al-Jami al-Saghir 6279","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6280","«من سأل شيئا وعنده ما يغنيه فإنما يستكثر من جمر جهنم قالوا: وما يغنيه؟ قال: قدر ما يغديه ويعشيه»","صحيح","Sahih al-Jami al-Saghir 6280","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6281","«من سأل من غير فقر فكأنما يأكل الجمر»","صحيح","Sahih al-Jami al-Saghir 6281","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6282","«من سأل وله أربعون درهما فهو الملحف»","صحيح","Sahih al-Jami al-Saghir 6282","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6283","«من سأل وله قيمة أوقية فقد ألحف»","صحيح","Sahih al-Jami al-Saghir 6283","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6284","«من سئل عن علم فكتمه ألجمه الله يوم القيامة بلجام من نار»","صحيح","Sahih al-Jami al-Saghir 6284","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6285","«من سب أصحابي فعليه لعنة الله والملائكة والناس أجمعين»","حسن","Sahih al-Jami al-Saghir 6285","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6286","من سبح الله في دبر كل صلاة ثلاثا وثلاثين، وحمد الله ثلاثا وثلاثين وكبر الله ثلاثا وثلاثين فتلك تسع وتسعون وقال تمام المائة: لا إله إلا الله وحده لا شريك له له الملك وله الحمد وهو على كل شيء قدير غفرت خطاياه وإن كانت مثل زبد البحر","صحيح","Sahih al-Jami al-Saghir 6286","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6287","«من ستر أخاه المسلم في الدنيا ستره الله يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6287","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6288","«من سره أن يجد حلأوة الإيمان فليحب المرء لا يحبه إلا لله»","حسن","Sahih al-Jami al-Saghir 6288","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6289","«من سره أن يحب الله ورسوله فليقرأ في المصحف»","حسن","Sahih al-Jami al-Saghir 6289","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6290","«من سره أن يستجيب الله له عند الشدائد والكرب فليكثر الدعاء في الرخاء»","حسن","Sahih al-Jami al-Saghir 6290","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6291","«من سره أن يعظم الله رزقه وأن يمد في أجله فليصل رحمه»","صحيح","Sahih al-Jami al-Saghir 6291","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6292","«من سره أن ينظر إلى تواضع عيسى فلينظر إلى أبي ذر»","صحيح","Sahih al-Jami al-Saghir 6292","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6293","«من سره أن ينظر إلى يوم القيامة كأنه رأى عين فليقرأ {إِذَا الشَّمْسُ كُوِّرَتْ} و {إِذَا السَّمَاءُ انْفَطَرَتْ} و {إِذَا السَّمَاءُ انْشَقَّتْ} »","صحيح","Sahih al-Jami al-Saghir 6293","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6294","«من سرته حسنته وساءته سيئته فهو مؤمن»","صحيح","Sahih al-Jami al-Saghir 6294","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6295","«من سرق فوجد سرقته عند رجل غير متهم فإن شاء أخذها بالقيمة وإن شاء اتبع صاحبه»","صحيح","Sahih al-Jami al-Saghir 6295","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6296","«من سكن البادية جفا ومن اتبع الصيد غفل ومن أتى السلطان افتتن»","صحيح","Sahih al-Jami al-Saghir 6296","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6297","«من سلك طريقا يطلب فيه علما سلك الله به طريقا من طرق الجنة وإن الملائكة لتضع أجنحتها لطالب العلم رضا بما يصنع وإن العالم ليستغفر له من في السموات ومن في الأرض والحيتان في جوف الماء وإن فضل العالم على العابد كفضل القمر ليلة البدر على سائر الكواكب وإن العلماء ورثة الأنبياء وإن الأنبياء لم يورثوا دينارا ولا درهما إنما ورثوا العلم فمن أخذه أخذ بحظ وافر»","صحيح","Sahih al-Jami al-Saghir 6297","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6298","من سلك طريقا يلتمس فيه علما سهل الله له طريقا إلى الجنة","صحيح","Sahih al-Jami al-Saghir 6298","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6299","«من سل علينا السيف فليس منا»","صحيح","Sahih al-Jami al-Saghir 6299","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6300","«من سمع النداء فلم يأته فلا صلاة له إلا من عذر»","صحيح","Sahih al-Jami al-Saghir 6300","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6301","«من سمع بالدجال فلينأ عنه فوالله إن الرجل ليأتيه وهو يحسب أنه مؤمن فيتبعه مما يبعث به الشبهات»","صحيح","Sahih al-Jami al-Saghir 6301","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6302","«من سمع رجلا ينشد ضالة في المسجد فليقل: لا ردها الله عليك فإن المساجد لم تبن لهذا»","صحيح","Sahih al-Jami al-Saghir 6302","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6303","«من سمع سمع الله به ومن راءى راءى الله به»","صحيح","Sahih al-Jami al-Saghir 6303","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6304","«من سمع سمع الله به ومن راءى راءى الله به ومن شاق شق الله عليه يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6304","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6305","«من سن في الإسلام سنة حسنة فله أجرها وأجر من عمل بها من بعده من غير أن ينقص من أجورهم شيء ومن سن في الإسلام سنة سيئة فعليه وزرها ووزر من عمل بها من بعده من غير أن ينقص من أوزارهم شيء»","صحيح","Sahih al-Jami al-Saghir 6305","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6306","«من سن سنة حسنة عمل بها بعده كان له أجره ومثل أجورهم من غير أن ينقص من أجورهم شيء ومن سن سنة سيئة فعمل بها بعده كان عليه وزرها ومثل أوزارهم من غير أن ينقص من أوزارهم شيء»","صحيح","Sahih al-Jami al-Saghir 6306","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6307","«من شاب شيبة في الإسلام كانت له نورا يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6307","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6308","«من شاب شيبة في سبيل الله كانت له نورا يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6308","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6309","«من شرب الخمر فاجلدوه فإن عاد الثانية فاجلدوه فإن عاد الثالثة فاجلدوه فإن عاد الرابعة فاقتلوه»","صحيح","Sahih al-Jami al-Saghir 6309","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6310","«من شرب الخمر في الدنيا ثم لم يتب منها حرمها في الآخرة»","صحيح","Sahih al-Jami al-Saghir 6310","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6311","«من شرب الخمر في الدنيا لم يشربها في الآخرة»","صحيح","Sahih al-Jami al-Saghir 6311","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6312","من شرب الخمر لم تقبل له صلاة أربعين صباحا فإن تاب تاب الله عليه فإن عاد لم تقبل له صلاة أربعين صباحا فإن تاب تاب الله عليه فإن عاد لم تقبل له صلاة أربعين صباحا فإن تاب تاب الله عليه فإن عاد الرابعة لم تقبل له صلاة أربعين صباحا فإن تاب لم يتب الله عليه وسقاه من نهر الخبال","صحيح","Sahih al-Jami al-Saghir 6312","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6313","«من شرب الخمر وسكر لم تقبل له صلاة أربعين صباحا فإن مات دخل النار فإن تاب تاب الله عليه وإن عاد فشرب فسكر لم تقبل له صلاة أربعين صباحا فإن مات دخل النار وإن تاب تاب الله عليه وإن عاد فشرب فسكر لم تقبل له صلاة أربعين صباحا فإن مات دخل النار وإن تاب تاب الله عليه فإن عاد كان حقا على الله أن يسقيه من ردغة الخبال يوم القيامة: عصارة أهل النار»","صحيح","Sahih al-Jami al-Saghir 6313","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6314","«من شرب في إناء فضة فكأنما يجرجر في بطنه نار جهنم»","صحيح","Sahih al-Jami al-Saghir 6314","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6315","«من شرب في إناء من ذهب أو فضة فإنما يجرجر في بطنه نارا من جهنم»","صحيح","Sahih al-Jami al-Saghir 6315","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6316","«من شفع لأخيه شفاعة فأهدى له هدية عليها فقبلها منه فقد أتى بابا عظيما من أبواب الربا»","حسن","Sahih al-Jami al-Saghir 6316","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6317","«من شهد الجنازة حتى يصلي عليها فله قيراط ومن شهدها حتى تدفن كان له قيراطان مثل الجبلين العظيمين»","صحيح","Sahih al-Jami al-Saghir 6317","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6318","«من شهد أن لا إله إلا الله دخل الجنة»","صحيح","Sahih al-Jami al-Saghir 6318","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6319","«من شهد أن لا إله إلا الله وأن محمدا رسول الله حرم الله عليه النار»","صحيح","Sahih al-Jami al-Saghir 6319","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6320","«من شهد أن لا إله إلا الله وحده لا شريك له وأن محمدا عبده ورسوله وأن عيسى عبده ورسوله وابن أمته وكلمته ألقاها إلى مريم وروح منه وأن الجنة حق وأن النار حق وأن البعث حق أدخله الله الجنة على ما كان من عمل من أي أبواب الجنة الثمانية شاء»","صحيح","Sahih al-Jami al-Saghir 6320","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6321","«من شهد صلاتنا هذه ووقف معنا حتى ندفع وقد وقف بعرفة قبل ذلك ليلا أو نهارا فقد تم حجه وقضى تفثه»","صحيح","Sahih al-Jami al-Saghir 6321","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6322","«من شهر سيفه ثم وضعه فدمه هدر»","صحيح","Sahih al-Jami al-Saghir 6322","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6323","«من صام الأبد فلا صام ولا أفطر»","صحيح","Sahih al-Jami al-Saghir 6323","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6324","«من صام ثلاثة أيام من كل شهر فقد صام الدهر كله»","صحيح","Sahih al-Jami al-Saghir 6324","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6325","«من صام رمضان إيمانا واحتسابا غفر له ما تقدم من ذنبه [وما تأخر] »","","Sahih al-Jami al-Saghir 6325","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6326","«من صام رمضان إيمانا واحتسابا غفر له ما تقدم من ذنبه»","صحيح","Sahih al-Jami al-Saghir 6326","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6327","«من صام رمضان وأتبعه ستا من شوال كان كصوم الدهر»","صحيح","Sahih al-Jami al-Saghir 6327","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6328","«من صام ستة أيام بعد الفطر كان تمام السنة {مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ عَشْرُ أَمْثَالِهَا} »","صحيح","Sahih al-Jami al-Saghir 6328","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6329","«من صام يوما في سبيل الله باعد الله بذلك اليوم حر جهنم عن وجهه سبعين خريفا»","صحيح","Sahih al-Jami al-Saghir 6329","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6330","«من صام يوما في سبيل الله باعد الله منه جهنم مسيرة مائة عام»","حسن","Sahih al-Jami al-Saghir 6330","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6331","«من صام يوما في سبيل الله باعد الله وجهه من جهنم سبعين عاما»","صحيح","Sahih al-Jami al-Saghir 6331","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6332","«من صام يوما في سبيل الله بعد الله وجهه عن النار سبعين خريفا»","صحيح","Sahih al-Jami al-Saghir 6332","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6333","«من صام يوما في سبيل الله جعل الله بينه وبين النار خندقا كما بين السماء والأرض»","صحيح","Sahih al-Jami al-Saghir 6333","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6334","«من صام يوما في سبيل الله زحزح الله وجهه عن النار بذلك اليوم سبعين خريفا»","صحيح","Sahih al-Jami al-Saghir 6334","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6335","«من صام يوم عرفة غفر الله له سنتين: سنة أمامه وسنة خلفه»","صحيح","Sahih al-Jami al-Saghir 6335","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6336","«من صرع عن دابته فهو شهيد»","صحيح","Sahih al-Jami al-Saghir 6336","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6337","«من صلى البردين دخل الجنة»","صحيح","Sahih al-Jami al-Saghir 6337","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6338","«من صلى الصبح فهو في ذمة الله فلا يتبعنكم الله بشيء من ذمته»","صحيح","Sahih al-Jami al-Saghir 6338","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6339","«من صلى الصبح فهو في ذمة الله فلا يطلبنكم الله من ذمته بشيء فإن من يطلبه من ذمته بشيء يدركه ثم يكبه على وجهه في نار جهنم»","صحيح","Sahih al-Jami al-Saghir 6339","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6340","من صلى الضحى أربعا وقبل الأولى أربعا بني له بيت في الجنة","حسن","Sahih al-Jami al-Saghir 6340","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6341","«من صلى العشاء في جماعة فكأنما قام نصف ليلة ومن صلى الصبح في جماعة فكأنما صلى الليل كله»","صحيح","Sahih al-Jami al-Saghir 6341","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6342","«من صلى العشاء في جماعة كان كقيام نصف ليلة ومن صلى العشاء والفجر في جماعة كان كقيام ليلة»","صحيح","Sahih al-Jami al-Saghir 6342","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6343","«من صلى الغداة كان في ذمة الله حتى يمسي»","صحيح","Sahih al-Jami al-Saghir 6343","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6344","«من صلى الفجر فهو في ذمة الله فلا يطلبنكم الله بشيء من ذمته»","صحيح","Sahih al-Jami al-Saghir 6344","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6345","«من صلى الفجر فهو في ذمة الله وحسابه على الله»","حسن","Sahih al-Jami al-Saghir 6345","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6346","«من صلى الفجر في جماعة ثم قعد يذكر الله حتى تطلع الشمس ثم صلى ركعتين كانت له كأجر حجة وعمرة تامة تامة تامة»","صحيح","Sahih al-Jami al-Saghir 6346","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6347","«من صلى ركعة من الصبح ثم طلعت الشمس فليصل الصبح»","صحيح","Sahih al-Jami al-Saghir 6347","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6348","«من صلى صلاة لم يتمها زيد عليها من سبحاته حتى تتم»","صحيح","Sahih al-Jami al-Saghir 6348","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6349","«من صلى صلاة لم يقرأ فيها بأم القرآن فهي خداج فهي خداج فهي خداج غير تمام»","صحيح","Sahih al-Jami al-Saghir 6349","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6350","«من صلى صلاتنا واستقبل قبلتنا وأكل ذبيحتنا فذاكم المسلم الذي له ذمة الله وذمة رسوله فلا تخفروا الله في ذمته»","صحيح","Sahih al-Jami al-Saghir 6350","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6351","«من صلى صلاتنا ونسك نسكنا فقد أصاب النسك ومن نسك قبل الصلاة فلا نسك له»","صحيح","Sahih al-Jami al-Saghir 6351","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6352","«من صلى على جنازة فله قيراط فإن شهد دفنها فله قيراطان القيراط مثل أحد»","صحيح","Sahih al-Jami al-Saghir 6352","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6353","«من صلى على جنازة فله قيراط ومن انتظرها حتى توضع في اللحد فله قيراطان والقيراطان مثل الجبلين العظيمين»","صحيح","Sahih al-Jami al-Saghir 6353","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6354","«من صلى على جنازة في المسجد فليس له شيء»","صحيح","Sahih al-Jami al-Saghir 6354","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6355","«من صلى على جنازة ولم يتبعها فله قيراط فإن تبعها فله قيراطان»","صحيح","Sahih al-Jami al-Saghir 6355","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6356","«من صلى عليه مائة من المسلمين غفر له»","صحيح","Sahih al-Jami al-Saghir 6356","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6357","«من صلى على حين يصبح عشرا وحين يمسي عشرا أدركته شفاعتي يوم القيامة»","حسن","Sahih al-Jami al-Saghir 6357","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6358","«من صلى علي واحدة صلى الله عليه بها عشرا»","صحيح","Sahih al-Jami al-Saghir 6358","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6359","«من صلى علي واحدة صلى الله عليه عشر صلوات وحط عنه عشر خطيئات ورفع له عشر درجات»","صحيح","Sahih al-Jami al-Saghir 6359","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6360","«من صلى في اليوم والليلة اثنتي عشرة ركعة تطوعا بنى الله له بيتا في الجنة»","صحيح","Sahih al-Jami al-Saghir 6360","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6361","«من صلى في ثوب فليخالف بين طرفيه»","صحيح","Sahih al-Jami al-Saghir 6361","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6362","«من صلى في يوم وليلة ثنتي عشرة ركعة بني له بيت في الجنة: أربعا قبل الظهر وركعتين بعدها وركعتين بعد المغرب وركعتين بعد العشاء وركعتين قبل صلاة الغداة»","صحيح","Sahih al-Jami al-Saghir 6362","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6363","«من صلى قائما فهو أفضل ومن صلى قاعدا فله نصف أجر القائم ومن صلى نائما فله نصف أجر القاعد»","صحيح","Sahih al-Jami al-Saghir 6363","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6364","من صلى قبل الظهر أربعا وبعدها أربعا، حرمه الله على النار","صحيح","Sahih al-Jami al-Saghir 6364","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6365","«من صلى لله أربعين يوما في جماعة يدرك التكبيرة الأولى كتب له براءتان: براءة من النار وبراءة من النفاق»","حسن","Sahih al-Jami al-Saghir 6365","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6366","«من صلى وجلس ينتظر الصلاة لم يزل في صلاة حتى تأتيه الصلاة التي يلاقيها»","صحيح","Sahih al-Jami al-Saghir 6366","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6367","«من صمت نجا»","صحيح","Sahih al-Jami al-Saghir 6367","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6368","«من صنع إليه معروف فقال لفاعله: جزاك الله خيرا فقد أبلغ في الثناء»","صحيح","Sahih al-Jami al-Saghir 6368","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6369","«من صنع أمرا على غير أمرنا فهو رد»","صحيح","Sahih al-Jami al-Saghir 6369","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6370","«من صور صورة عذبه الله بها يوم القيامة حتى ينفخ فيها وليس بنافخ ومن تحلم كلف أن يعقد شعيرتين وليس بعاقد ومن استمع إلى حديث قوم يفرون منه صب في أذنيه الآنك يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6370","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6371","«من صور صورة في الدنيا كلف أن ينفخ فيها الروح يوم القيامة وليس بنافخ»","صحيح","Sahih al-Jami al-Saghir 6371","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6372","«من ضار ضار الله به ومن شاق شاق الله عليه»","حسن","Sahih al-Jami al-Saghir 6372","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6373","«من ضحى قبل الصلاة فإنما ذبح لنفسه ومن ذبح بعد الصلاة فقد تم نسكه وأصاب سنة المسلمين»","صحيح","Sahih al-Jami al-Saghir 6373","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6374","«من ضرب بسوط ظلما اقتص منه يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6374","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6375","«من ضرب غلاما له حدا لم يأته أو لطمه فإن كفارته أن يعتقه»","صحيح","Sahih al-Jami al-Saghir 6375","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6376","«من ضرب مملوكه ظالما أقيد منه يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6376","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6377","«من ضن بالمال أن ينفقه وبالليل أن يكابده فعليه بسبحان الله وبحمده»","صحيح","Sahih al-Jami al-Saghir 6377","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6378","«من ضيق منزلا أو قطع طريقا أو آذى مؤمنا فلا جهاد له»","صحيح","Sahih al-Jami al-Saghir 6378","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6379","«من طاف بالبيت سبعا وصلى ركعتين كان كعتق رقبة»","صحيح","Sahih al-Jami al-Saghir 6379","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6380","من طاف بهذا البيت أسبوعا فأحصاه كان كعتق رقبة لا يضع قدما ولا يرفع أخرى إلا حط الله عنه بها خطيئة وكتب له بها حسنة","صحيح","Sahih al-Jami al-Saghir 6380","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6381","«من طلب الشهادة صادقا أعطيها ولو لم تصبه»","صحيح","Sahih al-Jami al-Saghir 6381","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6382","«من طلب العلم ليباهي به العلماء أو ليماري به السفهاء أو ليصرف به وجوه الناس إليه فهو في النار»","حسن","Sahih al-Jami al-Saghir 6382","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6383","«من طلب العلم ليجاري به العلماء أو ليماري به السفهاء أو يصرف به وجوه الناس إليه أدخله الله في النار»","حسن","Sahih al-Jami al-Saghir 6383","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6384","«من طلب حقا فليطلبه في عفاف واف أو غير واف»","صحيح","Sahih al-Jami al-Saghir 6384","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6385","«من ظلم قيد شبر من الأرض طوقه من سبع أرضين»","صحيح","Sahih al-Jami al-Saghir 6385","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6386","«من عادى عمارا عاداه الله ومن أبغض عمارا أبغضه الله»","صحيح","Sahih al-Jami al-Saghir 6386","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6387","«من عاد مريضا أو زار أخا له في الله ناداه مناد: أن طبت وطاب ممشاك وتبوأت من الجنة منزلا»","حسن","Sahih al-Jami al-Saghir 6387","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6388","«من عاد مريضا لم يحضر أجله فقال عنده سبع مرات: أسأل الله العظيم رب العرش العظيم أن يشفيك إلا عافاه الله من ذلك المرض»","صحيح","Sahih al-Jami al-Saghir 6388","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6389","«من عاد مريضا لم يزل في خرفة الجنة حتى يرجع»","صحيح","Sahih al-Jami al-Saghir 6389","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6390","«من عاذ بالله فقد عاذ بمعاذ»","صحيح","Sahih al-Jami al-Saghir 6390","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6391","«من عال جاريتين حتى يدركا دخلت أنا وهو الجنة كهاتين»","صحيح","Sahih al-Jami al-Saghir 6391","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6392","«من عرض عليه ريحان فلا يرده فإنه خفيف المحمل طيب الريح»","صحيح","Sahih al-Jami al-Saghir 6392","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6393","«من عرض عليه طيب فلا يرده فإنه خفيف المحمل طيب الرائحة»","صحيح","Sahih al-Jami al-Saghir 6393","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6394","«من علق تميمة فقد أشرك»","صحيح","Sahih al-Jami al-Saghir 6394","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6395","«من علم الرمي ثم تركه فليس منا»","صحيح","Sahih al-Jami al-Saghir 6395","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6396","من علم علما فله أجر من عمل به لا ينقص من أجر العامل","صحيح","Sahih al-Jami al-Saghir 6396","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6397","«من عمر من أمتي سبعين سنة فقد أعذر الله إليه في العمر»","صحيح","Sahih al-Jami al-Saghir 6397","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6398","«من عمل عملا ليس عليه أمرنا فهو رد»","صحيح","Sahih al-Jami al-Saghir 6398","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6399","«من غدا إلى المسجد وراح أعد الله له نزلا من الجنة كلما غدا وراح»","صحيح","Sahih al-Jami al-Saghir 6399","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6400","«من غرس غرسا لم يأكل منه آدمي ولا خلق من خلق الله إلا كان له صدقة»","صحيح","Sahih al-Jami al-Saghir 6400","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6401","«من غزا في سبيل الله ولم ينو إلا عقالا فله ما نوى»","صحيح","Sahih al-Jami al-Saghir 6401","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6402","«من غسل الميت فليغتسل ومن حمله فليتوضأ»","صحيح","Sahih al-Jami al-Saghir 6402","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6403","«من غسل ميتا فستره ستره الله من الذنوب ومن كفنه كساه الله من السندس»","حسن","Sahih al-Jami al-Saghir 6403","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6404","«من غسل ميتا فليغتسل»","صحيح","Sahih al-Jami al-Saghir 6404","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6405","«من غسل يوم الجمعة واغتسل ثم بكر وابتكر ومشى ولم يركب ودنا من الإمام واستمع وأنصت ولم يلغ كان له بكل خطوة يخطوها من بيته إلى المسجد عمل سنة أجر صيامها وقيامها»","صحيح","Sahih al-Jami al-Saghir 6405","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6406","«من غش فليس منا»","صحيح","Sahih al-Jami al-Saghir 6406","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6407","«من غشنا فليس منا»","صحيح","Sahih al-Jami al-Saghir 6407","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6408","«من غشنا فليس منا والمكر والخداع في النار»","صحيح","Sahih al-Jami al-Saghir 6408","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6409","«من غل بعيرا أو شاة أتى يحمله يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6409","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6410","«من فارق الجماعة شبرا فقد خلع ربقة الإسلام من عنقه»","صحيح","Sahih al-Jami al-Saghir 6410","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6411","«من فارق الروح جسده وهو بريء من ثلاث دخل الجنة: الكبر والدين والغلول»","صحيح","Sahih al-Jami al-Saghir 6411","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6412","«من فرق بين والدة وولدها فرق الله بينه وبين أحبته يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6412","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6413","«من فصل في سبيل الله فمات أو قتل أو وقصته فرسه أو بعيره أو لدغته هامة أو مات على فراشه بأي حتف شاء الله فإنه شهيد وإن له الجنة»","حسن","Sahih al-Jami al-Saghir 6413","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6414","«من فطر صائما أو جهز غازيا فله مثل أجره»","صحيح","Sahih al-Jami al-Saghir 6414","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6415","«من فطر صائما كان له مثل أجره غير أنه لا ينقص من أجر الصائم شيئا»","صحيح","Sahih al-Jami al-Saghir 6415","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6416","«من قاتل في سبيل الله فواق ناقة فقد وجبت له الجنة ومن سأل الله القتل في سبيل الله من نفسه صادقا ثم مات أو قتل فإنه له أجر شهيد ومن جرح جرحا في سبيل الله أو نكب نكبة فإنها تجيء يوم القيامة كأغزر ما كانت لونها لون الزعفران وريحها ريح المسك ومن خرج به خراج في سبيل الله كان عليه طابع الشهداء»","صحيح","Sahih al-Jami al-Saghir 6416","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6417","«من قاتل لتكون كلمة الله هي العليا فهو في سبيل الله»","صحيح","Sahih al-Jami al-Saghir 6417","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6418","من قال إذا أصبح: لا إله إلا الله وحده لا شريك له له الملك وله الحمد وهو على كل شيء قدير كان له عدل رقبة من ولد إسماعيل وكتبت له بها عشر حسنات وحط عنه بها عشر سيئات ورفع له بها عشر درجات وكان في حرز من الشيطان حتى يمسي وإذا قالها إذا أمسى كان له مثل ذلك حتى يصبح","صحيح","Sahih al-Jami al-Saghir 6418","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6419","«من قال إذا خرج من بيته: بسم الله توكلت على الله لا حول ولا قوة إلا بالله يقال له: كفيت ووقيت وتنحى عنه الشيطان»","صحيح","Sahih al-Jami al-Saghir 6419","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6420","«من قال أنا خير من يونس بن متى فقد كذب»","صحيح","Sahih al-Jami al-Saghir 6420","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6421","«من قال إني بريء من الإسلام فإن كان كاذبا فهو كما قال وإن كان صادقا لم يعد إلى الإسلام سالما»","صحيح","Sahih al-Jami al-Saghir 6421","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6422","«من قال حين يسمع المؤذن: وأنا أشهد أن لا إله إلا الله وحده لا شريك له وأشهد أن محمدا عبده ورسوله رضيت بالله ربا وبمحمد رسولا وبالإسلام دينا غفر الله له ما تقدم من ذنبه»","صحيح","Sahih al-Jami al-Saghir 6422","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6423","«من قال حين يسمع النداء: اللهم رب هذه الدعوة التامة والصلاة القائمة آت محمدا الوسيلة والفضيلة وابعثه مقاما محمودا الذي وعدته حلت له شفاعتي يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6423","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6424","«من قال حين يصبح أو حين يمسي: اللهم أنت ربي لا إله إلا أنت خلقتني وأنا عبدك وأنا على عهدك ووعدك ما استطعت أعوذ بك من شر ما صنعت أبوء لك بنعمتك علي وأبوء بذنبي فاغفر لي فإنه لا يغفر الذنوب إلا أنت فمات من يومه أو ليلته دخل الجنة»","صحيح","Sahih al-Jami al-Saghir 6424","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6425","«من قال حين يصبح وحين يمسي: سبحان الله العظيم وبحمده مائة مرة لم يأت أحد يوم القيامة بأفضل مما جاء به إلا أحد قال مثل ذلك وزاد عليه»","صحيح","Sahih al-Jami al-Saghir 6425","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6426","«من قال حين يمسي: بسم الله الذي لا يضر مع اسمه شيء في الأرض ولا في السماء وهو السميع العليم ثلاث مرات لم يصبه فجأة بلاء حتى يصبح ومن قالها حين يصبح ثلاث مرات لم يصبه فجأة بلاء حتى يمسي»","صحيح","Sahih al-Jami al-Saghir 6426","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6427","«من قال حين يمسي ثلاث مرات: أعوذ بكلمات الله التامات من شر ما خلق لم يضره لدغة حية في تلك الليلة»","صحيح","Sahih al-Jami al-Saghir 6427","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6428","«من قال رضيت بالله ربا وبالإسلام دينا وبمحمد نبيا وجبت له الجنة»","صحيح","Sahih al-Jami al-Saghir 6428","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6429","«من قال: سبحان الله العظيم وبحمده غرست له بها نخلة في الجنة»","صحيح","Sahih al-Jami al-Saghir 6429","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6430","«من قال: سبحان الله وبحمده سبحانك اللهم وبحمدك أشهد أن لا إله إلا أنت أستغفرك وأتوب إليك فإن قالها في مجلس ذكر كانت كالطابع يطبع عليه ومن قالها في مجلس لغوكانت كفارة له»","صحيح","Sahih al-Jami al-Saghir 6430","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6431","«من قال: سبحان الله وبحمده في يوم مائة مرة حطت خطاياه وإن كانت مثل زبد البحر»","صحيح","Sahih al-Jami al-Saghir 6431","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6432","«من قال لصاحبه يوم الجمعة والإمام يخطب: أنصت فقد لغا»","صحيح","Sahih al-Jami al-Saghir 6432","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6433","«من قال: لا إله إلا الله مخلصا دخل الجنة»","صحيح","Sahih al-Jami al-Saghir 6433","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6434","«من قال: لا إله إلا الله نفعته يوما من دهره يصيبه قبل ذلك ما أصابه»","صحيح","Sahih al-Jami al-Saghir 6434","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6435","من قال: لا إله إلا الله وحده لا شريك له له الملك وله الحمد وهو على كل شيء قدير عشرا كان كمن أعتق رقبة من ولد إسماعيل","صحيح","Sahih al-Jami al-Saghir 6435","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6436","«من قال: لا إله إلا الله وحده لا شريك له له الملك وله الحمد،.... وهو على كل شيء قدير عشر مرات كان له بعدل نسمة»","صحيح","Sahih al-Jami al-Saghir 6436","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6437","«من قال: لا إله إلا الله وحده لا شريك له له الملك وله الحمد وهو على كل شيء قدير في يوم مائة مرة كانت له عدل عشر رقاب وكتبت له مائة حسنة ومحيت عنه مائة سيئة وكانت له حرزا من الشيطان يومه ذلك حتى يمسي ولم يأت أحد بأفضل مما جاء به إلا أحد عمل عملا أكثر من ذلك»","صحيح","Sahih al-Jami al-Saghir 6437","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6438","«من قال: لا إله إلا الله وكفر بما يعبد من دون الله حرم ماله ودمه وحسابه على الله عز وجل»","صحيح","Sahih al-Jami al-Saghir 6438","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6439","«من قام بعشر آيات لم يكتب من الغافلين ومن قام بمائة آية كتب من القانتين ومن قام بألف آية كتب من المقنطرين»","صحيح","Sahih al-Jami al-Saghir 6439","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6440","«من قام رمضان إيمانا واحتسابا غفر له ما تقدم من ذنبه»","صحيح","Sahih al-Jami al-Saghir 6440","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6441","«من قام ليلة القدر إيمانا واحتسابا غفر له ما تقدم من ذنبه»","صحيح","Sahih al-Jami al-Saghir 6441","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6442","«من قتل تحت راية عمية ينصر العصبية ويغضب للعصبية فقتلته جاهلية»","صحيح","Sahih al-Jami al-Saghir 6442","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6443","«من قتل خطأ فديته مائة من الإبل ثلاثون بنت مخاض وثلاثون بنت لبون وثلاثون حقة وعشرة بني لبون»","حسن","Sahih al-Jami al-Saghir 6443","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6444","«من قتل دون ماله فهو شهيد»","صحيح","Sahih al-Jami al-Saghir 6444","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6445","«من قتل دون ماله فهو شهيد ومن قتل دون دمه فهو شهيد ومن قتل دون دينه فهو شهيد ومن قتل دون أهله فهو شهيد»","صحيح","Sahih al-Jami al-Saghir 6445","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6446","«من قتل دون ماله مظلوما فله الجنة»","صحيح","Sahih al-Jami al-Saghir 6446","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6447","«من قتل دون مظلمته فهو شهيد»","صحيح","Sahih al-Jami al-Saghir 6447","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6448","«من قتل رجلا من أهل الذمة لم يجد ريح الجنة وإن ريحها ليوجد من مسيرة سبعين عاما»","صحيح","Sahih al-Jami al-Saghir 6448","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6449","«من قتل في سبيل الله فهو شهيد ومن مات في سبيل الله فهو شهيد ومن مات في الطاعون فهو شهيد ومن مات في البطن فهو شهيد ومن غرق فهو شهيد»","صحيح","Sahih al-Jami al-Saghir 6449","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6450","«من قتل في عميا أو رميا يكون بينهم بحجر أو سوط فعقله عقل خطأ ومن قتل عمدا فقود يديه فمن حال بينه وبينه فعليه لعنة الله والملائكة والناس أجمعين»","صحيح","Sahih al-Jami al-Saghir 6450","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6451","«من قتل في عميا في رمى يكون بينهم بحجارة أو بالسياط أو ضرب بعصا فهو خطأ وعقله عقل الخطأ ومن قتل عمدا فهو قود يد ومن حال دونه فعليه لعنة الله وغضبه لا يقبل منه صرفا ولا عدلا»","صحيح","Sahih al-Jami al-Saghir 6451","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6452","«من قتل كافر فله سلبه»","صحيح","Sahih al-Jami al-Saghir 6452","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6453","«من قتل له قتيل فهو بخير النظرين إما أن يقاد وإما أن يفدي»","صحيح","Sahih al-Jami al-Saghir 6453","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6454","«من قتل مؤمنا فاغتبط بقتله لم يقبل الله منه صرفا ولا عدلا»","صحيح","Sahih al-Jami al-Saghir 6454","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6455","«من قتل متعمد دفع إلى أولياء المقتول فإن شاءوا قتلوا وإن شاءوا أخذوا الدية وهي ثلاثون حقة وثلاثون جذعة وأربعون خلفة وما صولحوا عليه فهو لهم»","صحيح","Sahih al-Jami al-Saghir 6455","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6456","«من قتل معاهدا في غير كنهه حرم الله عليه الجنة»","صحيح","Sahih al-Jami al-Saghir 6456","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6457","«من قتل معاهدا لم يرح رائحة الجنة وإن ريحها ليوجد من مسيرة أربعين عاما»","صحيح","Sahih al-Jami al-Saghir 6457","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6458","«من قتل نفسا معاهدة بغير حلها حرم الله عليه الجنة: أن يشم ريحها»","صحيح","Sahih al-Jami al-Saghir 6458","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6459","«من قتل نفسه بحديدة فحديدته في يده يتوجأ بها في بطنه في نار جهنم خالدا مخلدا فيها أبدا ومن شرب سما فقتل نفسه فهو يتحساه في نار جهنم خالدا مخلدا فيها أبدا ومن تردى من جبل فقتل نفسه فهو يتردى في نار جهنم خالدا مخلدا فيها أبدا»","صحيح","Sahih al-Jami al-Saghir 6459","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6460","«من قتل وزغة في أول ضربة كتب له مائة حسنة ومن قتلها في الضربة الثانية فله كذا وكذا حسنة وإن قتلها في الضربة الثالثة فله كذا وكذا حسنة»","صحيح","Sahih al-Jami al-Saghir 6460","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6461","«من قتله بطنه لم يعذب في قبره»","صحيح","Sahih al-Jami al-Saghir 6461","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6462","«من قذف مملوكه بالزنا يقام عليه الحد يوم القيامة إلا أن يكون كما قال»","صحيح","Sahih al-Jami al-Saghir 6462","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6463","«من قذف مملوكه وهو بريء مما قال جلد يوم القيامة حدا إلا أن يكون كما قال»","صحيح","Sahih al-Jami al-Saghir 6463","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6464","«من قرأ آية الكرسي دبر كل صلاة مكتوبة لم يمنعه من دخول الجنة إلا أن يموت»","صحيح","Sahih al-Jami al-Saghir 6464","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6465","«من قرأ الآيتين من آخر سورة البقرة في ليلة كفتاه»","صحيح","Sahih al-Jami al-Saghir 6465","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6466","«من قرأ...... {قُلْ يَا أَيُّهَا الْكَافِرُونَ} عدلت له بربع القرآن ومن قرأ {قُلْ هُوَ اللَّهُ أَحَدٌ} عدلت له بثلث القرآن»","حسن","Sahih al-Jami al-Saghir 6466","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6467","«من قرأ القرآن فليسأل الله به فإنه سيجيء أقوام يقرءون القرآن يسألون به الناس»","حسن","Sahih al-Jami al-Saghir 6467","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6468","«من قرأ بمائة آية في ليلة كتب له قنوت ليلة»","صحيح","Sahih al-Jami al-Saghir 6468","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6469","من قرأ حرفا من كتاب الله فله به حسنة، والحسنة بعشر أمثالها لا أقول: {الم} حرف ولكن: ألف حرف ولام حرف وميم حرف","صحيح","Sahih al-Jami al-Saghir 6469","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6470","«من قرأ سورة الكهف في يوم الجمعة أضاء له من النور ما بين الجمعتين»","صحيح","Sahih al-Jami al-Saghir 6470","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6471","«من قرأ سورة الكهف يوم الجمعة أضاء له النور ما بينه وبين البيت العتيق»","صحيح","Sahih al-Jami al-Saghir 6471","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6472","«من قرأ {قُلْ هُوَ اللَّهُ أَحَدٌ} أحد عشر مرات بنى الله له بيتا في الجنة»","صحيح","Sahih al-Jami al-Saghir 6472","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6473","«من قرأ {قُلْ هُوَ اللَّهُ أَحَدٌ} فكأنما قرأ ثلث القرآن»","صحيح","Sahih al-Jami al-Saghir 6473","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6474","«من قرن بين حجه وعمرته أجزأه لهما طواف واحد»","صحيح","Sahih al-Jami al-Saghir 6474","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6475","«من قطع رحما أو حلف على يمين فاجرة رأى وباله قبل أن يموت»","صحيح","Sahih al-Jami al-Saghir 6475","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6476","«من قطع سدرة صوب الله رأسه في النار»","صحيح","Sahih al-Jami al-Saghir 6476","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6477","من قعد مقعدا لم يذكر الله فيه كانت عليه من الله ترة ومن اضطجع مضجعا لا يذكر الله فيه كانت عليه من الله ترة","صحيح","Sahih al-Jami al-Saghir 6477","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6478","«من كاتب مملوكه على مائة أوقية فأداها إلا عشر أواق ثم عجز فهو رقيق»","حسن","Sahih al-Jami al-Saghir 6478","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6479","«من كان آخر كلامه لا إله إلا الله دخل الجنة»","صحيح","Sahih al-Jami al-Saghir 6479","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6480","«من كان بينه وبين قوم عهد فلا يشد عقدة ولا يحلها حتى ينقضي أمدها أو ينبذ إليهم على سواء»","صحيح","Sahih al-Jami al-Saghir 6480","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6481","«من كان حالفا فلا يحلف إلا بالله»","صحيح","Sahih al-Jami al-Saghir 6481","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6482","«من كان ذبح أضحيته قبل أن يصلي فليذبح مكانها أخرى ومن لم يكن ذبح فليذبح باسم الله»","صحيح","Sahih al-Jami al-Saghir 6482","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6483","«من كان ذبح قبل الصلاة فليعد»","صحيح","Sahih al-Jami al-Saghir 6483","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6484","«من كان سهلا هينا لينا حرمه الله على النار»","صحيح","Sahih al-Jami al-Saghir 6484","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6485","«من كان في المسجد ينتظر الصلاة فهو في الصلاة ما لم يحدث»","صحيح","Sahih al-Jami al-Saghir 6485","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6486","«من كان لنا عاملا فلم يكن له زوجة فليكتسب له زوجة فإن لم يكن له خادم فليكتسب له خادما فإن لم يكن له مسكن فليكتسب مسكنا من اتخذ غير ذلك فهو غال أو سارق»","صحيح","Sahih al-Jami al-Saghir 6486","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6487","«من كان له إمام فقراءة الإمام له قراءة»","حسن","Sahih al-Jami al-Saghir 6487","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6488","«من كان له ثلاث بنات فصبر عليهن وأطعمهن وسقاهن وكساهن من جدته كن له حجابا من النار يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6488","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6489","«من كان له ذبح يذبحه فإذا أهل هلال ذي الحجة فلا يأخذن من شعره ولا من أظفاره شيئا حتى يضحي»","صحيح","Sahih al-Jami al-Saghir 6489","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6490","«من كان له سعة ولم يضح فلا يقربن مصلانا»","صحيح","Sahih al-Jami al-Saghir 6490","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6491","«من كان له شريك في حائط فلا يبع نصيبه من ذلك حتى يعرضه على شريكه»","صحيح","Sahih al-Jami al-Saghir 6491","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6492","«من كان له شريك في ربع أو نخل فليس له أن يبيع حتى يؤذن شريكه فإن رضي أخذ وإن كره ترك»","صحيح","Sahih al-Jami al-Saghir 6492","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6493","«من كان له شعر فليكرمه»","صحيح","Sahih al-Jami al-Saghir 6493","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6494","«من كان له مال فلير عليه أثره»","صحيح","Sahih al-Jami al-Saghir 6494","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6495","«من كان له نخل أو أرض فلا يبعها حتى يعرضها على شريكه»","صحيح","Sahih al-Jami al-Saghir 6495","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6496","«من كان له وجهان في الدنيا كان له يوم القيامة لسانان من نار»","صحيح","Sahih al-Jami al-Saghir 6496","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6497","«من كان معه فضل ظهر فليعد به على من لا ظهر له ومن كان له فضل من زاد فليعد به على من لا زاد له»","صحيح","Sahih al-Jami al-Saghir 6497","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6498","«من كان منكم ذا طول فليتزوج فإنه أغض للبصر وأحصن للفرج ومن لا فالصوم له وجاء»","صحيح","Sahih al-Jami al-Saghir 6498","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6499","«من كان منكم مصليا بعد الجمعة فليصل أربعا»","صحيح","Sahih al-Jami al-Saghir 6499","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6500","«من كان يؤمن بالله واليوم الآخر فإذا شهد أمرا فليتكلم بخير أو ليسكت واستوصوا بالنساء فإن المرأة خلقت من ضلع وإن أعوج شيء في الضلع أعلاه إن ذهبت تقيمه كسرته وإن تركته لم يزل أعوج استوصوا بالنساء»","صحيح","Sahih al-Jami al-Saghir 6500","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6501","«من كان يؤمن بالله واليوم الآخر فليحسن إلى جاره ومن كان يؤمن بالله واليوم الآخر فليكرم ضيفه ومن كان يؤمن بالله واليوم الآخر فليقل خيرا أو ليسكت»","صحيح","Sahih al-Jami al-Saghir 6501","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6502","«من كان يؤمن بالله واليوم الآخر فليكرم ضيفه جائزته يوم وليلة والضيافة ثلاثة أيام فما بعد ذلك فهو صدقة ولا يحل له أن يثوي عنده حتى يخرجه»","صحيح","Sahih al-Jami al-Saghir 6502","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6503","«من كان يؤمن بالله واليوم الآخر فلا يأخذن إلا مثلا بمثل» - يعني الذهب بالذهب","صحيح","Sahih al-Jami al-Saghir 6503","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6504","«من كان يؤمن بالله واليوم الآخر فلا يؤذ جاره واستوصوا بالنساء خيرا»","صحيح","Sahih al-Jami al-Saghir 6504","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6505","«من كان يؤمن بالله واليوم الآخر فلا يدخل الحمام إلا بمئزر»","صحيح","Sahih al-Jami al-Saghir 6505","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6506","«من كان يؤمن بالله واليوم الآخر فلا يدخل الحمام بغير إزار ومن كان يؤمن بالله واليوم الآخر فلا يدخل حليلته الحمام ومن كان يؤمن بالله واليوم الآخر فلا يجلس على مائدة يدار عليها الخمر»","حسن","Sahih al-Jami al-Saghir 6506","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6507","«من كان يؤمن بالله واليوم الآخر فلا يسق ماءه زرع غيره ومن كان يؤمن بالله واليوم الآخر فلا يأت سبيا من السبي حتى يستبرئها ومن كان يؤمن بالله واليوم الآخر فلا يبيعن مغنما حتى يقسم ومن كان يؤمن بالله واليوم الآخر فلا يركبن دابة من فيء المسلمين حتى إذا أعجفها ردها فيه ومن كان يؤمن بالله واليوم الآخر فلا يلبسن ثوبا من فيء المسلمين حتى إذا أخلقه رده فيه»","حسن","Sahih al-Jami al-Saghir 6507","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6508","«من كان يؤمن بالله واليوم الآخر فلا يسق ماءه ولد غيره»","صحيح","Sahih al-Jami al-Saghir 6508","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6509","«من كان يؤمن بالله واليوم الآخر فلا يلبس حريرا ولا ذهبا»","صحيح","Sahih al-Jami al-Saghir 6509","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6510","«من كانت الآخرة همه جعل الله غناه في قلبه وجمع له شمله وأتته الدنيا وهي راغمة ومن كانت الدنيا همه جعل الله فقره بين عينيه وفرق عليه شمله ولم يأته من الدنيا إلا ما قدر له»","صحيح","Sahih al-Jami al-Saghir 6510","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6511","«من كانت لأخيه عنده مظلمة من عرض أو مال فليتحلله اليوم قبل أن يؤخذ منه يوم لا دينار ولا درهم فإن كان له عمل صالح أخذ منه بقدر مظلمته وإن لم يكن له عمل أخذ من سيئات صاحبه فجعلت عليه»","صحيح","Sahih al-Jami al-Saghir 6511","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6512","«من كانت له أرض فأراد بيعها فليعرضها على جاره»","صحيح","Sahih al-Jami al-Saghir 6512","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6513","«من كانت له أرض فليزرعها أو ليزرعها أخاه ولا يكرها بثلث ولا ربع ولا بطعام مسمى»","صحيح","Sahih al-Jami al-Saghir 6513","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6514","«من كانت له أرض فليزرعها فإن لم يستطع أن يزرعها وعجز عنها فليمنحها أخاه المسلم ولا يؤاجرها فإن لم يفعل فليمسك أرضه»","صحيح","Sahih al-Jami al-Saghir 6514","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6515","«من كانت له امرأتان فمال إلى إحداهما جاء يوم القيامة وشقه مائل»","صحيح","Sahih al-Jami al-Saghir 6515","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6516","من كانت همه الآخرة جمع الله له شمله، وجعل غناه في قلبه وأتته الدنيا راغمة ومن كانت همه الدنيا فرق الله عليه أمره وجعل فقره بين عينيه ولم يأته من الدنيا إلا ما كتب الله له","صحيح","Sahih al-Jami al-Saghir 6516","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6517","«من كتم علما عن أهله ألجم يوم القيامة لجاما من نار»","صحيح","Sahih al-Jami al-Saghir 6517","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6518","«من كتم غيظا وهو قادر على أن ينفذه دعاه الله على رءوس الخلائق حتى يخيره من الحور العين يزوجه منها ما شاء»","حسن","Sahih al-Jami al-Saghir 6518","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6519","«من كذب علي متعمدا فليتبوأ مقعده من النار»","صحيح","Sahih al-Jami al-Saghir 6519","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6520","«من كذب في حلمه كلف يوم القيامة عقد شعيرة»","صحيح","Sahih al-Jami al-Saghir 6520","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6521","«من كسر أو مرض أو عرج فقد حل وعليه حجة أخرى من قابل»","صحيح","Sahih al-Jami al-Saghir 6521","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6522","«من كظم غيظا وهو قادر على أن ينفذه دعاه الله على رءوس الخلائق حتى يخيره من الحور العين يزوجه منها ما شاء»","حسن","Sahih al-Jami al-Saghir 6522","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6523","«من كنت مولاه فعلي مولاه»","صحيح","Sahih al-Jami al-Saghir 6523","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6524","«من كنت وليه فعلي وليه»","صحيح","Sahih al-Jami al-Saghir 6524","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6525","«من لبس الحرير في الدنيا لم يلبسه في الآخرة»","صحيح","Sahih al-Jami al-Saghir 6525","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6526","«من لبس ثوب شهرة ألبسه الله يوم القيامة ثوبا مثله ثم يلهب فيه النار»","حسن","Sahih al-Jami al-Saghir 6526","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6527","«من لطم مملوكه أو ضربه فكفارته أن يعتقه»","صحيح","Sahih al-Jami al-Saghir 6527","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6528","«من لعب بالنردشير فكأنما غمس يده في لحم الخنزير ودمه»","صحيح","Sahih al-Jami al-Saghir 6528","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6529","«من لعب بالنرد فقد عصى الله ورسوله»","حسن","Sahih al-Jami al-Saghir 6529","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6530","«من لعب بطلاق أو عتاق فهو كما قال»","حسن","Sahih al-Jami al-Saghir 6530","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6531","«من لقي الله لا يشرك به شيئا دخل الجنة»","صحيح","Sahih al-Jami al-Saghir 6531","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6532","«من لكعب بن الأشرف؟ فإنه قد آذى الله ورسوله»","صحيح","Sahih al-Jami al-Saghir 6532","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6533","«من لم يأخذ من شاربه فليس منا»","صحيح","Sahih al-Jami al-Saghir 6533","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6534","«من لم يبيت الصيام قبل طلوع الفجر فلا صيام له»","صحيح","Sahih al-Jami al-Saghir 6534","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6535","«من لم يبيت الصيام من الليل فلا صيام له»","صحيح","Sahih al-Jami al-Saghir 6535","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6536","«من لم يجد نعلين فليلبس خفين وليقطعهما أسفل من الكعبين»","صحيح","Sahih al-Jami al-Saghir 6536","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6537","«من لم يجد نعلين فليلبس خفين ومن لم يجد إزارا فليلبس سرأويل. - يعني - المحرم»","صحيح","Sahih al-Jami al-Saghir 6537","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6538","«من لم يجمع الصيام قبل الفجر فلا صيام له»","صحيح","Sahih al-Jami al-Saghir 6538","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6539","«من لم يدع قول الزور والعمل به فليس لله حاجة في أن يدع طعامه وشرابه»","صحيح","Sahih al-Jami al-Saghir 6539","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6540","«من لم يرحم صغيرنا ويعرف حق كبيرنا فليس منا»","صحيح","Sahih al-Jami al-Saghir 6540","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6541","«من لم يشكر الناس لم يشكر الله»","صحيح","Sahih al-Jami al-Saghir 6541","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6542","من لم يصل ركعتي الفجر فليصلها بعد ما تطلع الشمس","صحيح","Sahih al-Jami al-Saghir 6542","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6543","«من مات على شيء بعثه الله عليه»","صحيح","Sahih al-Jami al-Saghir 6543","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6544","«من مات مرابطا في سبيل الله أجرى الله عليه عمله الصالح الذي كان يعمل عليه وأجرى عليه رزقه وأمن من الفتان وبعثه الله يوم القيامة آمنا من الفزع»","صحيح","Sahih al-Jami al-Saghir 6544","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6545","«من مات مرابطا في سبيل الله أمنه الله من فتنة القبر»","صحيح","Sahih al-Jami al-Saghir 6545","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6546","«من مات وعليه دينار أو درهم قضي من حسناته ليس ثم دينار ولا درهم»","صحيح","Sahih al-Jami al-Saghir 6546","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6547","«من مات وعليه صيام صام عنه وليه»","صحيح","Sahih al-Jami al-Saghir 6547","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6548","«من مات ولم يغز ولم يحدث نفسه بغزو مات على شعبة من نفاق»","صحيح","Sahih al-Jami al-Saghir 6548","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6549","«من مات وهو مدمن خمر لقي الله وهو كعابد وثن»","صحيح","Sahih al-Jami al-Saghir 6549","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6550","«من مات لا يشرك بالله شيئا دخل الجنة»","صحيح","Sahih al-Jami al-Saghir 6550","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6551","«من مات لا يشرك بالله شيئا دخل الجنة ومن مات يشرك بالله شيئا دخل النار»","صحيح","Sahih al-Jami al-Saghir 6551","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6552","«من مات وهو يعلم أن لا إله إلا الله دخل الجنة»","صحيح","Sahih al-Jami al-Saghir 6552","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6553","«من مس الحصى فقد لغا»","صحيح","Sahih al-Jami al-Saghir 6553","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6554","«من مس ذكره فليتوضأ»","صحيح","Sahih al-Jami al-Saghir 6554","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6555","«من مس فرجه فليتوضأ»","صحيح","Sahih al-Jami al-Saghir 6555","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6556","«من مشى إلى صلاة مكتوبة في الجماعة فهي كحجة ومن مشى إلى صلاة تطوع فهي كعمرة نافلة»","حسن","Sahih al-Jami al-Saghir 6556","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6557","«من ملك ذا رحم محرم فهو حر»","صحيح","Sahih al-Jami al-Saghir 6557","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6558","«من منح منحة غدت بصدقة وراحت بصدقة صبوحها وغبوقها»","صحيح","Sahih al-Jami al-Saghir 6558","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6559","«من منح منحة ورق أو منحة لبن أو أهدى زقاقا فهو كعتق نسمة»","صحيح","Sahih al-Jami al-Saghir 6559","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6560","«من منع فضل ماء أو كلأ منعه الله فضله يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6560","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6561","«من نام عن حزبه أو عن شيء منه فقرأه فيما بين صلاة الفجر وصلاة الظهر كتب الله له كأنما قرأه من الليل»","صحيح","Sahih al-Jami al-Saghir 6561","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6562","«من نام عن وتره أو نسيه فليصله إذا ذكره»","صحيح","Sahih al-Jami al-Saghir 6562","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6563","«من نام عن وتره فليصل إذا أصبح»","صحيح","Sahih al-Jami al-Saghir 6563","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6564","«من نام وفي يده غمر ولم يغسله فأصابه شيء فلا يلومن إلا نفسه»","صحيح","Sahih al-Jami al-Saghir 6564","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6565","«من نذر أن يطيع الله فليطعه ومن نذر أن يعصي الله فلا يعصه»","صحيح","Sahih al-Jami al-Saghir 6565","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6566","من نزلت به فاقة فأنزلها بالناس لم تسد فاقته ومن نزلت به فاقة فأنزلها بالله فيوشك الله له برزق عاجل أو آجل","صحيح","Sahih al-Jami al-Saghir 6566","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6567","«من نزل منزلا فقال: أعوذ بكلمات الله التامات من شر ما خلق لم يضره شيء حتى يرتحل من منزله»","صحيح","Sahih al-Jami al-Saghir 6567","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6568","«من نسي الصلاة علي خطئ طريق الجنة»","صحيح","Sahih al-Jami al-Saghir 6568","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6569","«من نسي الصلاة فليصلها إذا ذكرها فإن الله قال: {وَأَقِمِ الصَّلاةَ لِذِكْرِي}»","صحيح","Sahih al-Jami al-Saghir 6569","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6570","«من نسي شيئا من صلاته فليسجد سجدتين وهو جالس»","حسن","Sahih al-Jami al-Saghir 6570","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6571","«من نسي صلاة أو نام عنها فكفارتها أن يصليها إذا ذكرها»","صحيح","Sahih al-Jami al-Saghir 6571","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6572","«من نسي صلاة فليصلها إذا ذكرها لا كفارة لها إلا ذلك»","صحيح","Sahih al-Jami al-Saghir 6572","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6573","من نسي وهو صائم فأكل أو شرب فليتم صومه، فإنما أطعمه الله وسقاه","صحيح","Sahih al-Jami al-Saghir 6573","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6574","«من نصر أخاه بظهر الغيب نصره الله في الدنيا والآخرة»","حسن","Sahih al-Jami al-Saghir 6574","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6575","«من نصر قومه على غير الحق فهو كالبعير الذي تردى فهو ينزع بذنبه»","صحيح","Sahih al-Jami al-Saghir 6575","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6576","«من نفس عن غريمه أو محا عنه كان في ظل العرش يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6576","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6577","«من نفس عن مؤمن كربة من كرب الدنيا نفس الله عنه كربة من كرب يوم القيامة ومن يسر على معسر يسر الله عليه في الدنيا والآخرة ومن ستر مسلما ستره الله في الدنيا والآخرة والله في عون العبد ما كان العبد في عون أخيه ومن سلك طريقا يلتمس فيه علما سهل الله له طريقا إلى الجنة وما اجتمع قوم في بيت من بيوت الله يتلون كتاب الله ويتدارسونه بينهم إلا نزلت عليهم السكينة وغشيتهم الرحمة وحفتهم الملائكة وذكرهم الله فيمن عنده ومن أبطأ به عمله لم يسرع به نسبه»","صحيح","Sahih al-Jami al-Saghir 6577","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6578","«من نوقش الحساب عذب»","صحيح","Sahih al-Jami al-Saghir 6578","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6579","«من نوقش المحاسبة هلك»","صحيح","Sahih al-Jami al-Saghir 6579","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6580","«من نيح عليه يعذب بما نيح عليه»","صحيح","Sahih al-Jami al-Saghir 6580","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6581","«من هجر أخاه سنة فهو كسفك دمه»","صحيح","Sahih al-Jami al-Saghir 6581","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6582","«من هذا اللاعن بعيره؟! أنزل عنه فلا تصحبنا بملعون لا تدعوا على أنفسكم ولا تدعوا على أولادكم ولا تدعوا على أموالكم لا توافقوا من الله ساعة يسأل فيها عطاء فيستجيب لكم»","صحيح","Sahih al-Jami al-Saghir 6582","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6583","«من وجد تمرا فليفطر عليه ومن لا فليفطر على الماء فإنه طهور»","صحيح","Sahih al-Jami al-Saghir 6583","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6584","«من وجد دابة قد عجز عنها أهلها أن يعلفوها فسيبوها فأخذها فأحياها فهي له»","حسن","Sahih al-Jami al-Saghir 6584","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6585","«من وجد سعة فليكفن في ثوب حبرة»","صحيح","Sahih al-Jami al-Saghir 6585","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6586","«من وجد لقطة فليشهد ذوي عدل ولا يكتم ولا يعبث فإن وجد صاحبها فليردها عليه وإلا فهو مال الله يؤتيه من يشاء»","صحيح","Sahih al-Jami al-Saghir 6586","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6587","«من وجد من هذا الوسواس فليقل: آمنا بالله ورسوله؛ ثلاثا فإن ذلك يذهب عنه»","صحيح","Sahih al-Jami al-Saghir 6587","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6588","«من وجدتموه وقع على بهيمة فاقتلوه واقتلوا البهيمة»","صحيح","Sahih al-Jami al-Saghir 6588","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6589","«من وجدتموه يعمل عمل قوم لوط فاقتلوا الفاعل والمفعول به»","صحيح","Sahih al-Jami al-Saghir 6589","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6590","«من وصل صفا وصله الله ومن قطع صفا قطعه الله»","صحيح","Sahih al-Jami al-Saghir 6590","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6591","«من وضع الخمر.......، ومن أدمن على شربها سقي من الخبال»","صحيح","Sahih al-Jami al-Saghir 6591","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6592","«من وطئ على إزار خيلاء وطئه في النار»","صحيح","Sahih al-Jami al-Saghir 6592","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6593","«من وقاه الله شر ما بين لحييه وشر ما بين رجليه دخل الجنة»","صحيح","Sahih al-Jami al-Saghir 6593","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6594","«من ولي القضاء فقد ذبح بغير سكين»","حسن","Sahih al-Jami al-Saghir 6594","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6595","«من ولي من أمور المسلمين شيئا فاحتجب دون خلتهم وحاجتهم وفقرهم وفاقتهم احتجب الله عنه يوم القيامة دون خلته وحاجته وفاقته وفقره»","صحيح","Sahih al-Jami al-Saghir 6595","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6596","«من ولي منكم عملا فأراد الله به خيرا جعل له وزيرا صالحا إن نسي ذكره وإن ذكر أعانه»","صحيح","Sahih al-Jami al-Saghir 6596","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6597","«من لا يرحم الناس لا يرحمه الله»","صحيح","Sahih al-Jami al-Saghir 6597","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6598","«من لا يرحم لا يرحم»","صحيح","Sahih al-Jami al-Saghir 6598","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6599","«من لا يرحم لا يرحم ومن لا يغفر لا يغفر له»","صحيح","Sahih al-Jami al-Saghir 6599","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6600","«من لا يرحم لا يرحم ومن لا يغفر لا يغفر له ومن لا يتب لا يتب عليه»","صحيح","Sahih al-Jami al-Saghir 6600","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6601","«من لا يشكر الناس لا يشكر الله»","صحيح","Sahih al-Jami al-Saghir 6601","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6602","من لايمكم من خدمكم فأطعموهم مما تأكلون وألبسوهم مما تلبسون ومن لا يلايمكم منهم فبيعوه ولا تعذبوا خلق الله","صحيح","Sahih al-Jami al-Saghir 6602","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6603","«من يتقبل لي بواحدة أتقبل له بالجنة لا يسأل الناس شيئا»","صحيح","Sahih al-Jami al-Saghir 6603","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6604","«من يتكفل لي أن لا يسأل الناس شيئا أتكفل له بالجنة»","صحيح","Sahih al-Jami al-Saghir 6604","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6605","«من يتوكل لي ما بين لحييه وما بين رجليه أتوكل له بالجنة»","صحيح","Sahih al-Jami al-Saghir 6605","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6606","«من يحرم الرفق يحرم الخير كله»","صحيح","Sahih al-Jami al-Saghir 6606","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6607","«من يخفر ذمتي كنت خصمه ومن خاصمته خصمته»","حسن","Sahih al-Jami al-Saghir 6607","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6608","«من يدخل الجنة ينعم فيها لا يبأس لا تبلى ثيابه ولا يفنى شبابه»","صحيح","Sahih al-Jami al-Saghir 6608","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6609","«من يرائي يرائي الله به ومن يسمع يسمع الله به»","صحيح","Sahih al-Jami al-Saghir 6609","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6610","«من يرد الله به خيرا يصب منه»","صحيح","Sahih al-Jami al-Saghir 6610","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6611","«من يرد الله به خيرا يفقهه في الدين»","صحيح","Sahih al-Jami al-Saghir 6611","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6612","«من يرد الله به خيرا يفقهه في الدين وإنما أنا قاسم والله يعطي ولن تزال هذه الأمة قائمة على أمر الله لا يضرهم من خالفهم حتى يأتي أمر الله عز وجل»","صحيح","Sahih al-Jami al-Saghir 6612","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6613","«من يرد هوان قريش أهانه الله»","صحيح","Sahih al-Jami al-Saghir 6613","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6614","«من يسر على معسر يسر الله عليه في الدنيا والآخرة»","صحيح","Sahih al-Jami al-Saghir 6614","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6615","«من يشرب النبيذ منكم فليشربه زبيبا فردا أو تمرا فردا أو بسرا فردا»","صحيح","Sahih al-Jami al-Saghir 6615","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6616","«من يصعد الثنية ثنية المرار فإنه يحط عنه ما حط عن بني إسرائيل»","صحيح","Sahih al-Jami al-Saghir 6616","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6617","«من يضمن لي ما بين لحييه وما بين رجليه أضمن له الجنة»","صحيح","Sahih al-Jami al-Saghir 6617","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6618","من يطيع الله إذا عصيته؟! أيأمنني الله على أهل الأرض ولا تأمنوني؟! إن من ضئضئ هذا قوما يقرءون القرآن لا يجأوز حناجرهم يمرقون من الدين مروق السهم من الرمية يقتلون أهل الإسلام ويدعون أهل الأوثان لئن أنا أدركتهم لأقتلنهم قتل عاد","صحيح","Sahih al-Jami al-Saghir 6618","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6619","«من يكن في حاجة أخيه يكن الله في حاجته»","صحيح","Sahih al-Jami al-Saghir 6619","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6620","«منى مناخ من سبق»","حسن","Sahih al-Jami al-Saghir 6620","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6621","«منبري هذا على ترعة من ترع الجنة»","صحيح","Sahih al-Jami al-Saghir 6621","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6622","«منزلنا غدا إن شاء الله بخيف بني كنانة حيث تقاسموا على الكفر»","صحيح","Sahih al-Jami al-Saghir 6622","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6623","«منعت العراق درهمها وقفيزها ومنعت الشام مدها ودينارها ومنعت مصر أردبها ودينارها وعدتم من حيث بدأتم وعدتم من حيث بدأتم وعدتم من حيث بدأتم»","صحيح","Sahih al-Jami al-Saghir 6623","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6624","«منهومان لا يشبعان: طالب علم وطالب دنيا»","صحيح","Sahih al-Jami al-Saghir 6624","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6625","«مه عليكم بما تطيقون من الأعمال فوالله لا يمل الله حتى تملوا»","صحيح","Sahih al-Jami al-Saghir 6625","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6626","«مه يا عائشة! فإن الله لا يحب الفحش ولا التفحش»","صحيح","Sahih al-Jami al-Saghir 6626","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6627","«مهلا يا عائشة! عليك بالرفق وإياك والعنف والفحش»","صحيح","Sahih al-Jami al-Saghir 6627","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6628","«مهلا يا خالد! لا تسبها فو الذي نفسي بيده لقد تابت توبة لوتابها صاحب مكس لغفر له»","حسن","Sahih al-Jami al-Saghir 6628","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6629","«مهل أهل المدينة من ذي الحليفة وللطريق الآخر الجحفة ومهل أهل العراق من ذات عرق ومهل أهل نجد من قرن ومهل أهل اليمن من يلملم»","صحيح","Sahih al-Jami al-Saghir 6629","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6630","«موالينا منا»","صحيح","Sahih al-Jami al-Saghir 6630","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6631","«موت الفجأة أخذة أسف»","صحيح","Sahih al-Jami al-Saghir 6631","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6632","«موتان الأرض لله ولرسوله فمن أحيا منها شيئا فهو له»","حسن","Sahih al-Jami al-Saghir 6632","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6633","«موسى بن عمران صفي الله»","صحيح","Sahih al-Jami al-Saghir 6633","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6634","«موضع الإزار إلى أنصاف الساقين والعضلة فإن أبيت فأسفل فإن أبيت فمن وراء الساق ولا حق للكعبين في الإزار»","صحيح","Sahih al-Jami al-Saghir 6634","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6635","«موضع سوط في الجنة خير من الدنيا وما فيها»","صحيح","Sahih al-Jami al-Saghir 6635","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6636","«موقف ساعة في سبيل الله خير من قيام ليلة القدر عند الحجر الأسود»","صحيح","Sahih al-Jami al-Saghir 6636","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6637","«مولى القوم من أنفسهم»","صحيح","Sahih al-Jami al-Saghir 6637","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6638","«ميامين الخيل في شقرها»","حسن","Sahih al-Jami al-Saghir 6638","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6639","«ميتة البحر حلال وماؤه طهور»","صحيح","Sahih al-Jami al-Saghir 6639","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6640","«الماء طهور لا ينجسه شيء»","صحيح","Sahih al-Jami al-Saghir 6640","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6641","«الماء لا ينجسه شيء»","صحيح","Sahih al-Jami al-Saghir 6641","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6642","«المائد في البحر الذي يصيبه القيء له أجر شهيد والغريق له أجر شهيدين»","صحيح","Sahih al-Jami al-Saghir 6642","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6643","«المؤذن يغفر له مد صوته وأجره مثل أجر من صلى معه»","صحيح","Sahih al-Jami al-Saghir 6643","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6644","«المؤذن يغفر له مدى صوته ويشهد له كل رطب ويابس وشاهد الصلاة يكتب له خمس وعشرون صلاة ويكفر عنه ما بينهما»","صحيح","Sahih al-Jami al-Saghir 6644","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6645","«المؤذنون أطول الناس أعناقا يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6645","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6646","«المؤذنون أمناء المسلمين على صلاتهم وحاجتهم»","حسن","Sahih al-Jami al-Saghir 6646","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6647","«المؤذنون أمناء المسلمين على فطرهم وسحورهم»","حسن","Sahih al-Jami al-Saghir 6647","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6648","«المؤمن أخوالمؤمن فلا يحل للمؤمن أن يبتاع على بيع أخيه ولا يخطب على خطبة أخيه حتى يذر»","صحيح","Sahih al-Jami al-Saghir 6648","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6649","«المؤمن إذا اشتهى الولد في الجنة كان حمله ووضعه وسنه في ساعة واحدة كما يشتهي»","صحيح","Sahih al-Jami al-Saghir 6649","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6650","«المؤمن القوي خير وأحب إلى الله من المؤمن الضعيف وفي كل خير احرص على ما ينفعك واستعن بالله ولا تعجز وإن أصابك شيء فلا تقل: لو أني فعلت كان كذا وكذا ولكن قل: قدر الله وما شاء فعل فإن لو تفتح عمل الشيطان»","حسن","Sahih al-Jami al-Saghir 6650","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6651","«المؤمن الذي يخالط الناس ويصبر على أذاهم أفضل من المؤمن الذي لا يخالط الناس ولا يصبر على أذاهم»","صحيح","Sahih al-Jami al-Saghir 6651","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6652","«المؤمن بخير على كل حال تنزع نفسه من بين جنبيه وهو يحمد الله»","صحيح","Sahih al-Jami al-Saghir 6652","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6653","«المؤمن غر كريم والفاجر خب لئيم»","حسن","Sahih al-Jami al-Saghir 6653","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6654","«المؤمن للمؤمن كالبنيان يشد بعضه بعضا»","صحيح","Sahih al-Jami al-Saghir 6654","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6655","«المؤمن مرآة المؤمن»","صحيح","Sahih al-Jami al-Saghir 6655","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6656","«المؤمن مرآة المؤمن والمؤمن أخوالمؤمن يكف عليه ضيعته ويحوطه من ورائه»","حسن","Sahih al-Jami al-Saghir 6656","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6657","«المؤمن مكفر»","صحيح","Sahih al-Jami al-Saghir 6657","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6658","«المؤمن من أمنه الناس على أموالهم وأنفسهم والمهاجر من هجر الخطايا والذنوب»","صحيح","Sahih al-Jami al-Saghir 6658","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6659","«المؤمن من أهل الإيمان بمنزلة الرأس من الجسد يألم المؤمن لأهل الإيمان كما يألم الجسد لما في الرأس»","حسن","Sahih al-Jami al-Saghir 6659","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6660","«المؤمن يأكل في معى واحد والكافر يأكل في سبعة أمعاء»","صحيح","Sahih al-Jami al-Saghir 6660","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6661","«المؤمن يألف ولا خير فيمن لا يألف ولا يؤلف»","صحيح","Sahih al-Jami al-Saghir 6661","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6662","المؤمن يألف ويؤلف ولا خير فيمن لا يألف ولا يؤلف، وخير الناس أنفعهم للناس","حسن","Sahih al-Jami al-Saghir 6662","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6663","«المؤمن يشرب في معى واحد والكافر يشرب في سبعة أمعاء»","صحيح","Sahih al-Jami al-Saghir 6663","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6664","«المؤمن يغار والله أشد غيرا»","صحيح","Sahih al-Jami al-Saghir 6664","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6665","«المؤمن يموت بعرق الجبين»","صحيح","Sahih al-Jami al-Saghir 6665","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6666","«المؤمنون تكافأ دماؤهم وهم يد على من سواهم ويسعى بذمتهم أدناهم ألا لا يقتل مؤمن بكافر ولا ذوعهد في عهده من أحدث حدثا فعلى نفسه ومن أحدث حدثا أو أوى محدثا فعليه لعنة الله والملائكة والناس أجمعين»","صحيح","Sahih al-Jami al-Saghir 6666","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6667","«المؤمنون كرجل واحد إن اشتكى رأسه تداعى له سائر الجسد بالحمى والسهر»","صحيح","Sahih al-Jami al-Saghir 6667","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6668","«المؤمنون كرجل واحد إن اشتكى رأسه اشتكى كله وإن اشتكى عينه اشتكى كله»","صحيح","Sahih al-Jami al-Saghir 6668","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6669","«المؤمنون هينون لينون كالجمل الأنف إن قيد انقاد وإذا أنيخ على صخرة استناخ»","حسن","Sahih al-Jami al-Saghir 6669","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6670","«الماهر بالقرآن مع السفرة الكرام البررة والذي يقرؤه ويتعتع فيه وهو عليه شاق له أجران»","صحيح","Sahih al-Jami al-Saghir 6670","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6671","«المتباريان لا يجابان ولا يؤكل طعامهما»","صحيح","Sahih al-Jami al-Saghir 6671","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6672","«المتبايعان بالخيار ما لم يتفرقا إلا أن تكون صفقة خيار ولا يحل له أن يفارق صاحبه خشية أن يستقيله»","صحيح","Sahih al-Jami al-Saghir 6672","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6673","«المتبايعان بالخيار ما لم يتفرقا إلا أن يكون البيع كان عن خيار فإن كان البيع عن خيار فقد وجب البيع»","صحيح","Sahih al-Jami al-Saghir 6673","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6674","«المتبايعان كل واحد منهما بالخيار على صاحبه ما لم يتفرقا إلا بيع الخيار»","صحيح","Sahih al-Jami al-Saghir 6674","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6675","«المتشبع بما لم يعط كلابس ثوبي زور»","صحيح","Sahih al-Jami al-Saghir 6675","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6676","«المتمسك بسنتي عند اختلاف أمتي كالقابض على الجمر»","حسن","Sahih al-Jami al-Saghir 6676","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6677","«المتوفى عنها زوجها لا تلبس المعصفر من الثياب ولا الممشقة ولا الحلي ولا تختضب ولا تكتحل»","صحيح","Sahih al-Jami al-Saghir 6677","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6678","«المجالس بالأمانة»","حسن","Sahih al-Jami al-Saghir 6678","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6679","«المجاهد من جاهد نفسه في الله»","صحيح","Sahih al-Jami al-Saghir 6679","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6680","«المحرمة لا تنتقب ولا تلبس القفازين»","صحيح","Sahih al-Jami al-Saghir 6680","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6681","«المختلعات هن المنافقات»","صحيح","Sahih al-Jami al-Saghir 6681","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6682","«المدعى عليه أولى باليمين إلا أن تقوم عليه البينة»","صحيح","Sahih al-Jami al-Saghir 6682","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6683","«المدينة حرام ما بين عير إلى ثور فمن أحدث فيها حدثا أو أوى فيها محدثا فعليه لعنة الله والملائكة والناس أجمعين لا يقبل الله منه يوم القيامة صرفا ولا عدلا وذمة المسلمين واحدة يسعى بها أدناهم فمن أخفر مسلما فعليه لعنة الله والملائكة والناس أجمعين لا يقبل الله منه يوم القيامة صرفا ولا عدلا ومن ادعى إلى غير أبيه أو انتمى إلى غير مواليه فعليه لعنة الله والملائكة والناس أجمعين لا يقبل الله منه يوم القيامة صرفا ولا عدلا»","صحيح","Sahih al-Jami al-Saghir 6683","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6684","«المدينة حرام ما بين عير إلى ثور لا يختلى خلاها ولا ينفر صيدها ولا تلتقط لقطتها إلا لمن أشاد بها ولا يصلح لرجل أن يحمل فيها سلاحا لقتال ولا يصلح أن يقطع منها شجرة إلا أن يعلف رجل بعيره»","صحيح","Sahih al-Jami al-Saghir 6684","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6685","«المدينة حرام من كذا إلى كذا لا يقطع شجرها ولا يحدث فيها حدث من أحدث فيها حدثا أو أوى محدثا فعليه لعنة الله والملائكة والناس أجمعين لا يقبل الله منه يوم القيامة صرفا ولا عدلا»","صحيح","Sahih al-Jami al-Saghir 6685","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6686","«المدينة حرم آمن»","صحيح","Sahih al-Jami al-Saghir 6686","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6687","«المراء في القرآن كفر»","صحيح","Sahih al-Jami al-Saghir 6687","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6688","«المرء في صلاة ما انتظرها»","صحيح","Sahih al-Jami al-Saghir 6688","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6689","«المرء مع من أحب»","صحيح","Sahih al-Jami al-Saghir 6689","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6690","«المرأة عورة فإذا خرجت استشرفها الشيطان»","صحيح","Sahih al-Jami al-Saghir 6690","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6691","«المرأة لآخر أزواجها»","صحيح","Sahih al-Jami al-Saghir 6691","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6692","«المزدلفة كلها موقف»","صحيح","Sahih al-Jami al-Saghir 6692","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6693","«المزر كله حرام.... ... »","صحيح","Sahih al-Jami al-Saghir 6693","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6694","«المسألة أن ترفع يديك حذو منكبيك والاستغفار أن تشير بأصبع واحدة والابتهال تمد يديك جميعا»","صحيح","Sahih al-Jami al-Saghir 6694","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6695","«المسائل كدوح يكدح بها الرجل وجهه فمن شاء أبقى على وجهه ومن شاء ترك إلا أن يسأل الرجل ذا سلطان أو في أمر لا يجد منه بدا»","صحيح","Sahih al-Jami al-Saghir 6695","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6696","«المستبان شيطانان يتهاتران ويتكاذبان»","صحيح","Sahih al-Jami al-Saghir 6696","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6697","«المستبان ما قالا فعلى البادئ منهما حتى يعتدي المظلوم»","صحيح","Sahih al-Jami al-Saghir 6697","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6698","«المستحاضة تدع الصلاة أيام أقرائها ثم تغتسل وتصلي والوضوء عند كل صلاة»","صحيح","Sahih al-Jami al-Saghir 6698","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6699","«المستحاضة تغتسل من قرء إلى قرء»","صحيح","Sahih al-Jami al-Saghir 6699","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6700","«المستشار مؤتمن»","صحيح","Sahih al-Jami al-Saghir 6700","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6701","«المسجد الذي أسس على التقوى مسجدي هذا»","صحيح","Sahih al-Jami al-Saghir 6701","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6702","«المسجد بيت كل مؤمن»","حسن","Sahih al-Jami al-Saghir 6702","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6703","«المسك أطيب الطيب»","صحيح","Sahih al-Jami al-Saghir 6703","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6704","«المسلم أخو المسلم»","صحيح","Sahih al-Jami al-Saghir 6704","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6705","«المسلم أخو المسلم ولا يحل لمسلم باع من أخيه بيعا فيه عيب إلا بينه له»","صحيح","Sahih al-Jami al-Saghir 6705","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6706","«المسلم أخو المسلم لا يخونه ولا يكذبه ولا يخذله كل المسلم على المسلم حرام عرضه وماله ودمه التقوى هاهنا - وأشار إلى القلب - بحسب امرئ من الشر أن يحقر أخاه المسلم»","صحيح","Sahih al-Jami al-Saghir 6706","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6707","«المسلم أخوالمسلم لا يظلمه ولا يسلمه ومن كان في حاجة أخيه كان الله في حاجته ومن فرج عن مسلم كربة فرج الله عنه بها كربة من كرب يوم القيامة ومن ستر مسلما ستره الله يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6707","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6708","«المسلم إذا سئل في القبر يشهد أن لا إله إلا الله وأن محمدا رسول الله فذلك قوله تعالى: {يُثَبِّتُ اللَّهُ الَّذِينَ آمَنُوا بِالْقَوْلِ الثَّابِتِ فِي الْحَيَاةِ الدُّنْيَا وَفِي الْآخِرَةِ} »","صحيح","Sahih al-Jami al-Saghir 6708","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6709","«المسلم من سلم المسلمون من لسانه ويده»","صحيح","Sahih al-Jami al-Saghir 6709","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6710","«المسلم من سلم المسلمون من لسانه ويده والمؤمن من أمنه الناس على دمائهم وأموالهم»","صحيح","Sahih al-Jami al-Saghir 6710","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6711","«المسلم من سلم المسلمون من لسانه ويده والمهاجر من هجر ما نهى الله عنه»","صحيح","Sahih al-Jami al-Saghir 6711","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6712","«المسلمون تتكافأ دماؤهم يسعى بذمتهم أدناهم ويجير عليهم أقصاهم وهم يد على من سواهم يرد مشدهم على مضعفهم ومسرعهم على قاعدهم لا يقتل مؤمن بكافر ولا ذوعهد في عهده»","حسن","Sahih al-Jami al-Saghir 6712","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6713","«المسلمون شركاء في ثلاثة: في الكلأ والماء والنار»","صحيح","Sahih al-Jami al-Saghir 6713","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6714","«المسلمون على شروطهم»","صحيح","Sahih al-Jami al-Saghir 6714","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6715","«المسلمون عند شروطهم فيما أحل»","صحيح","Sahih al-Jami al-Saghir 6715","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6716","«المسلمون عند شروطهم ما وافق الحق من ذلك»","صحيح","Sahih al-Jami al-Saghir 6716","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6717","«المصائب والأمراض والأحزان في الدنيا جزاء»","صحيح","Sahih al-Jami al-Saghir 6717","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6718","«المطلقة ثلاثا ليس لها سكنى ولا نفقة»","صحيح","Sahih al-Jami al-Saghir 6718","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6719","«المعتدي في الصدقة كمانعها»","صحيح","Sahih al-Jami al-Saghir 6719","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6720","«المغرب وتر النهار فأوتروا صلاة الليل»","صحيح","Sahih al-Jami al-Saghir 6720","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6721","«المقام المحمود الشفاعة»","صحيح","Sahih al-Jami al-Saghir 6721","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6722","«المكاتب عبد ما بقي عليه من كتابته درهم»","حسن","Sahih al-Jami al-Saghir 6722","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6723","«المكاتب يعتق بقدر ما أدى ويقام عليه الحد بقدر ما عتق منه ويرث بقدر ما عتق منه»","صحيح","Sahih al-Jami al-Saghir 6723","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6724","«المكثرون هم الأسفلون يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 6724","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6725","«المكر والخديعة في النار»","صحيح","Sahih al-Jami al-Saghir 6725","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6726","«المكر والخديعة والخيانة في النار»","حسن","Sahih al-Jami al-Saghir 6726","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6727","«الملائكة تصلي على أحدكم ما دام في مصلاه الذي صلى فيه ما لم يحدث أو يقم: اللهم اغفر له اللهم ارحمه»","صحيح","Sahih al-Jami al-Saghir 6727","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6728","«الملائكة شهداء الله في السماء وأنتم شهداء الله في الأرض»","صحيح","Sahih al-Jami al-Saghir 6728","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6729","«الملك في قريش والقضاء في الأنصار والأذان في الحبشة والأمانة في الأزد»","صحيح","Sahih al-Jami al-Saghir 6729","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6730","«المنتعل بمنزلة الراكب»","صحيح","Sahih al-Jami al-Saghir 6730","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6731","«المنتعل راكب»","صحيح","Sahih al-Jami al-Saghir 6731","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6732","«المنحة مردودة والناس على شروطهم ما وافق الحق»","صحيح","Sahih al-Jami al-Saghir 6732","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6733","«المنفق على الخيل في سبيل الله كباسط يديه بالصدقة لا يقبضها»","صحيح","Sahih al-Jami al-Saghir 6733","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6734","«المهدي من عترتي من ولد فاطمة»","صحيح","Sahih al-Jami al-Saghir 6734","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6735","«المهدي منا أهل البيت يصلحه الله في ليلة»","صحيح","Sahih al-Jami al-Saghir 6735","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6736","«المهدي مني أجلى الجبهة أقنى الأنف يملأ الأرض قسطا وعدلا كما ملئت جورا وظلما يملك سبع سنين»","حسن","Sahih al-Jami al-Saghir 6736","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6737","«الميزان بيد الرحمن يرفع أقواما ويضع آخرين»","صحيح","Sahih al-Jami al-Saghir 6737","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6738","«الميت من ذات الجنب شهيد»","صحيح","Sahih al-Jami al-Saghir 6738","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6739","«الميت يبعث في ثيابه التي يموت فيها»","صحيح","Sahih al-Jami al-Saghir 6739","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6740","الميت يعذب ببكاء الحي إذا قالوا: وا عضداه! وا كاسياه! وا ناصراه! وا جبلاه! ونحو هذا يتعتع ويقال أنت كذلك؟! أنت كذلك؟!","حسن","Sahih al-Jami al-Saghir 6740","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
"6741","«الميت يعذب في قبره بما نيح عليه»","صحيح","Sahih al-Jami al-Saghir 6741","","","الأحاديث المبدوءة بحرف الميم Hadith Beginning with the Letter Mim (م)"
