hadiths[578]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"4448","«كافل اليتيم له أو لغيره أنا وهو كهاتين في الجنة»","صحيح","Sahih al-Jami al-Saghir 4448","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4449","«كان الحجر الأسود أشد بياضا من الثلج حتى سودته خطايا بني آدم»","صحيح","Sahih al-Jami al-Saghir 4449","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4450","«كان الرجل قبلكم يؤخذ فيحفر له في الأرض فيجعل فيه فيجاء بالمنشار فيوضع على رأسه فيشق باثنتين ما يصده ذلك عن دينه ويمشط بأمشاط الحديد ما دون لحمه من عظم أو عصب ما يصده ذلك عن دينه والله ليتمن الله هذا الأمر حتى يسير الراكب من صنعاء إلى حضرموت لا يخاف إلا الله والذئب على غنمه ولكنكم تستعجلون»","صحيح","Sahih al-Jami al-Saghir 4450","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4451","«كان أول من أضاف الضيف إبراهيم»","حسن","Sahih al-Jami al-Saghir 4451","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4452","«كان أهل الجاهلية يقولون: إنما الطيرة في المرأة والدابة والدار»","صحيح","Sahih al-Jami al-Saghir 4452","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4453","«كان داود أعبد البشر»","حسن","Sahih al-Jami al-Saghir 4453","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4454","«كان رجل يداين الناس فكان يقول لفتاه: إذا أتيت معسرا فتجأوز عنه لعل الله أن يتجأوز عنا فلقي الله فتجاوز عنه»","صحيح","Sahih al-Jami al-Saghir 4454","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4455","«كان رجلان في بني إسرائيل متواخيان وكان أحدهما مذنبا والآخر مجتهدا في العبادة وكان لا يزال المجتهد يرى الآخر على الذنب فيقول: أقصر فوجده يوما على ذنب فقال له: أقصر فقال: خلني وربي أبعثت علي رقيبا؟ ! فقال: والله لا يغفر الله لك أو لا يدخلك الله الجنة فقبض روحهما فاجتمعا عند رب العالمين فقال لهذا المجتهد: أكنت بي عالما أو كنت على ما في يدي قادرا؟ ! وقال للمذنب: اذهب فادخل الجنة برحمتي وقال للآخر: اذهبوا به إلى النار»","صحيح","Sahih al-Jami al-Saghir 4455","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4456","«كان زكريا نجارا»","صحيح","Sahih al-Jami al-Saghir 4456","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4457","«كان عاشوراء يوما يصومه أهل الجاهلية فمن أحب منكم أن يصومه فليصمه ومن كرهه فليدعه»","صحيح","Sahih al-Jami al-Saghir 4457","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4458","«كان على الطريق غصن شجرة يؤذي الناس فأماطها رجل فأدخل الجنة»","صحيح","Sahih al-Jami al-Saghir 4458","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4459","«كان في بني إسرائيل رجل قتل تسعة وتسعين إنسانا ثم خرج يسأل فأتى راهبا فسأله فقال له: ألي توبة؟ قال: لا فقتله فجعل يسأل فقال له رجل: ائت قرية كذا وكذا فأدركه الموت فنأى بصدره نحوها فاختصمت فيه ملائكة الرحمة وملائكة العذاب فأوحى الله إلى هذه: أن تقربي وأوحى الله إلى هذه: أن تباعدي وقال: قيسوا ما بينهما فوجداه إلى هذه أقرب بشبر فغفر له»","صحيح","Sahih al-Jami al-Saghir 4459","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4460","«كان لكم يومان تلعبون فيهما وقد أبدلكم الله بهما خيرا منهما: يوم الفطر ويوم الأضحى»","صحيح","Sahih al-Jami al-Saghir 4460","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4461","""كان ملك فيمن كان قبلكم وكان له ساحر فلما كبر قال للملك: إني قد كبرت فابعث إلي غلاما أعلمه السحر فبعث إليه غلاما يعلمه فكان في طريقه إذا سلك راهب فقعد إليه وسمع كلامه، فأعجبه، فكان إذا أتى الساحر مر بالراهب وقعد إليه فإذا أتى الساحر ضربه فشكا ذلك إلى الراهب فقال: إذا جئت الساحر فقل: حبسني أهلي وإذا جئت أهلك فقل: حبسني الساحر، فبينما هوكذلك إذ أتى على دابة عظيمة قد حبست الناس فقال: اليوم أعلم الساحر أفضل أم الراهب؟ فأخذ حجرا فقال: اللهم إن كان أمر الراهب أحب إليك من أمر الساحر فاقتل هذه الدابة حتى يمضي الناس فرماها فقتلها ومضى الناس، فأتى الراهب فأخبره فقال له الراهب: أي بني أنت اليوم أفضل مني قد بلغ من أمرك ما أرى وإنك ستبتلى فلا تدل علي، وكان الغلام يبرئ الأكمه والأبرص ويدأوي الناس من سائر الأدواء فسمع جليس للملك كان قد عمي فأتاه بهدايا كثيرة فقال: ما هاهنا أجمع لك إن أنت شفيتني قال: إني لا أشفي أحد إنما يشفي الله عز وجل فإن آمنت بالله دعوت الله فشفاك فآمن بالله فشفاه الله، فأتى الملك فجلس إليه كما كان يجلس فقال له الملك: من رد عليك بصرك؟ قال: ربي قال: ولك رب غيري؟ قال: ربي وربك الله فأخذه فلم يزل يعذبه حتى دل على الغلام فجيء بالغلام فقال له الملك: أي بني قد بلغ من سحرك ما يبرئ الأكمه والأبرص وتفعل وتفعل! فقال: إني لا أشفي أحدا إنما يشفي الله عز وجل، فأخذه فلم يزل يعذبه حتى دل على الراهب فجيء بالراهب فقيل له: ارجع عن دينك فأبى فدعا بالمنشار فوضع المنشار على مفرق رأسه فشقه به حتى وقع شقاه ثم جيء بجليس الملك فقيل له: ارجع عن دينك فأبى فوضع المنشار في مفرق رأسه فشقه حتى وقع شقاه ثم جيء بالغلام فقيل له: ارجع عن دينك فأبى فدفعه إلى نفر من أصحابه فقال: اذهبوا به إلى جبل كذا وكذا فاصعدوا به الجبل فإذا بلغتم به ذروته فإن رجع عن دينه وإلا فاطرحوه، فذهبوا به فصعدوا به الجبل فقال: اللهم اكفنيهم بما شئت فرجف بهم الجبل فسقطوا وجاء يمشي إلى الملك فقال له الملك: ما فعل أصحابك؟ فقال: كفانيهم الله فدفعه إلى نفر من أصحابه فقال: اذهبوا به فاحملوه في قرقور فتوسطوا به البحر فإن رجع عن دينه وإلا فاقذفوه فذهبوا به فقال: اللهم اكفنيهم بما شئت فانكفأت بهم السفينة فغرقوا وجاء يمشي إلى الملك فقال له الملك: ما فعل أصحابك؟ فقال: كفانيهم الله، فقال للملك: إنك لست بقاتلي حتى تفعل ما آمرك به! قال: وما هو؟ قال: تجمع الناس في صعيد واحد وتصلبني على جذع ثم خذ سهما من كنانتي ثم ضع السهم في كبد القوس ثم قل: بسم الله رب الغلام ثم ارم فإنك إذا فعلت ذلك قتلتني، فجمع الناس في صعيد واحد وصلبه على جذع ثم أخذ سهما من كنانته ثم وضع السهم في كبد القوس ثم قال: بسم الله رب الغلام ثم رماه فوقع السهم في صدغه فوضع يده في صدغه موضع السهم فمات، فقال الناس: آمنا برب الغلام، آمنا برب الغلام آمنا برب الغلام فأتى الملك فقيل له: أرأيت ما كنت تحذر؟ قد والله نزل بك حذرك قد آمن الناس! فأمر بالأخدود بأفواه السكك فخدت وأضرم النيران وقال: من لم يرجع عن دينه فأقحموه فيها ففعلوا حتى جاءت امرأة ومعها صبي لها فتقاعست أن تقع فيها فقال لها الغلام: يا أمه اصبري فإنك على الحق ""","صحيح","Sahih al-Jami al-Saghir 4461","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4462","«كان نبي من الأنبياء يخط فمن وافق خطه فذاك»","صحيح","Sahih al-Jami al-Saghir 4462","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4463","«كان هذا الأمر في حمير فنزعه الله منهم وجعله في قريش وسيعود إليهم»","صحيح","Sahih al-Jami al-Saghir 4463","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4464","«كانت امرأة من بني إسرائيل قصيرة تمشي مع امرأتين طويلتين فاتخذت رجلين من خشب وخاتما من ذهب مغلفا بطين ثم حشته مسكا وهو أطيب الطيب فمرت بين المرأتين فلم يعرفوها فقالت بيدها هكذا»","صحيح","Sahih al-Jami al-Saghir 4464","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4465","«كانت امرأتان معهما ابناهما جاء الذئب فذهب بابن إحداهما فقالت صاحبتها: إنما ذهب بابنك وقالت الأخرى إنما ذهب بابنك! فتحاكمتا إلى داود فقضى به للكبرى فخرجتا على سليمان بن داود فأخبرتاه بذلك فقال ائتوني بالسكين أشقه بينهما فقالت الصغرى: لا تفعل يرحمك الله هوابنها فقضى به للصغرى»","صحيح","Sahih al-Jami al-Saghir 4465","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4466",""" كانت بنوإسرائيل تسوسهم الأنبياء كلما هلك نبي خلفه نبي وإنه لا نبي بعدي وسيكون خلفاء فيكثرون قالوا: فما تأمرنا قال: فوا بيعة الأول فالأول وأعطوهم حقهم الذي جعله الله لهم فإن الله سائلهم عما استرعاهم""","صحيح","Sahih al-Jami al-Saghir 4466","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4467","«كانت بنوإسرائيل يغتسلون عراة ينظر بعضهم إلى بعض وكان موسى عليه السلام يغتسل وحده فقالوا: والله ما يمنع موسى أن يغتسل معنا إلا أنه آدر فذهب مرة يغتسل فوضع ثوبه على حجر ففر الحجر بثوبه فجمح موسى في أثره يقول: ثوبي يا حجر ثوبي يا حجر حتى نظرت بنوإسرائيل إلى موسى فقالوا: والله ما بموسى من بأس وأخذ ثوبه فطفق بالحجر ضربا»","صحيح","Sahih al-Jami al-Saghir 4467","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4468","«كأني أنظر إلى موسى في هذا الوادي محرما بين قطوانتين»","حسن","Sahih al-Jami al-Saghir 4468","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4469","«كأني أنظر إليه أسود أفحج ينقضها حجرا حجرا» - يعني الكعبة -","صحيح","Sahih al-Jami al-Saghir 4469","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4470","«كأني أنظر إلى يونس على ناقة خطامها ليف وعليه جبة من صوف وهو يقول: لبيك اللهم لبيك»","صحيح","Sahih al-Jami al-Saghir 4470","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4471","«كبر كبر»","صحيح","Sahih al-Jami al-Saghir 4471","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4472","«كتاب الله القصاص»","صحيح","Sahih al-Jami al-Saghir 4472","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4473","«كتاب الله هوحبل الله الممدود من السماء إلى الأرض»","صحيح","Sahih al-Jami al-Saghir 4473","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4474","«كتب الله تعالى مقادير الخلائق قبل أن يخلق السموات والأرض بخمسين ألف سنة وعرشه على الماء»","صحيح","Sahih al-Jami al-Saghir 4474","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4475","«كتب ربكم على نفسه بيده قبل أن يخلق الخلق: رحمتي سبقت غضبي»","صحيح","Sahih al-Jami al-Saghir 4475","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4476","«كتب على ابن آدم نصيبه من الزنا مدرك ذلك لا محالة فالعينان زناهما النظر والأذنان زناهما الاستماع واللسان زناه الكلام واليد زناها البطش والرجل زناها الخطا والقلب يهوى ويتمنى ويصدق ذلك الفرج ويكذبه»","صحيح","Sahih al-Jami al-Saghir 4476","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4477","«كخ كخ ارم بها أما شعرت أنا لا نأكل الصدقة؟»","صحيح","Sahih al-Jami al-Saghir 4477","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4478","«كسر عظم الميت ككسره حيا»","صحيح","Sahih al-Jami al-Saghir 4478","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4479","«كفى إثما أن تحبس عمن تملك قوته»","صحيح","Sahih al-Jami al-Saghir 4479","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4480","«كفى بالمرء إثما أن يحدث بكل ما يسمع»","صحيح","Sahih al-Jami al-Saghir 4480","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4481","«كفى بالمرء إثما أن يضيع من يقوت»","حسن","Sahih al-Jami al-Saghir 4481","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4482","«كفى بالمرء كذبا أن يحدث بكل ما سمع»","صحيح","Sahih al-Jami al-Saghir 4482","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4483","«كفى ببارقة السيوف على رأسه فتنة»","صحيح","Sahih al-Jami al-Saghir 4483","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4484","«كفاك الحية ضربة بالسوط أصبتها أم أخطأتها»","حسن","Sahih al-Jami al-Saghir 4484","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4485","«كفر بالله تبرؤ من نسب وإن دق»","حسن","Sahih al-Jami al-Saghir 4485","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4486","«كفر بامرئ ادعاء نسب لا يعرف أو جحده وإن دق»","حسن","Sahih al-Jami al-Saghir 4486","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4487","«كفارة المجلس أن يقول العبد: سبحانك اللهم وبحمدك أشهد أن لا إله إلا أنت وحدك لا شريك لك أستغفرك وأتوب إليك»","صحيح","Sahih al-Jami al-Saghir 4487","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4488","«كفارة النذر إذا لم يسم كفارة يمين»","صحيح","Sahih al-Jami al-Saghir 4488","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4489","«كفارات الخطايا: إسباغ الوضوء على المكاره وإعمال الأقدام إلى المساجد وانتظار الصلاة بعد الصلاة»","صحيح","Sahih al-Jami al-Saghir 4489","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4490","«كف شرك عن الناس فإنها صدقة منك على نفسك»","صحيح","Sahih al-Jami al-Saghir 4490","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4491","«كف عنا جشاءك فإن أكثرهم شبعا في الدنيا أطولهم جوعا يوم القيامة»","حسن","Sahih al-Jami al-Saghir 4491","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4492","«كفوا صبيانكم عند العشاء فإن للجن انتشارا وخطفة»","صحيح","Sahih al-Jami al-Saghir 4492","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4493","«كل الثوم.... فلولا أني أناجي الملك لأكلته»","صحيح","Sahih al-Jami al-Saghir 4493","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4494","«كل فلعمري لمن أكل برقية باطل لقد أكلت برقية حق»","صحيح","Sahih al-Jami al-Saghir 4494","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4495","«كل ما ردت عليك قوسك»","صحيح","Sahih al-Jami al-Saghir 4495","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4496","«كل ما فرى الأوداج ما لم يكن قرض سن أو حز ظفر»","صحيح","Sahih al-Jami al-Saghir 4496","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4497","«كل من مال يتيمك غير مسرف ولا مبذر ولا متأثل مالا ولا تق مالك بماله»","حسن","Sahih al-Jami al-Saghir 4497","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4498","«كلوا الزيت وادهنوا به فإنه من شجرة مباركة»","صحيح","Sahih al-Jami al-Saghir 4498","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4499","«كلوا بسم الله من حواليها وأعفوا رأسها فإن البركة تأتيها من فوقها»","صحيح","Sahih al-Jami al-Saghir 4499","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4500","«كلوا جميعا ولا تفرقوا فإن البركة مع الجماعة»","حسن","Sahih al-Jami al-Saghir 4500","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4501","«كلوا جميعا ولا تفرقوا فإن طعام الواحد يكفي الاثنين وطعام الاثنين يكفي الثلاثة والأربعة كلوا جميعا ولا تفرقوا فإن البركة في الجماعة»","حسن","Sahih al-Jami al-Saghir 4501","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4502","«كلوا في القصعة من جوانبها ولا تأكلوا من وسطها فإن البركة تنزل في وسطها»","صحيح","Sahih al-Jami al-Saghir 4502","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4503","«كلوا لحوم الأضاحي وادخروا»","صحيح","Sahih al-Jami al-Saghir 4503","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4504","«كلوا من حواليها وذروا ذروتها يبارك فيها»","صحيح","Sahih al-Jami al-Saghir 4504","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4505","«كلوا واشربوا وتصدقوا والبسوا في غير إسراف ولا مخيلة»","حسن","Sahih al-Jami al-Saghir 4505","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4506","«كلوا واشربوا ولا يهيدنكم الساطع المصعد فكلوا واشربوا حتى يعترض لكم الأحمر»","حسن","Sahih al-Jami al-Saghir 4506","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4507","«كلوه ومن أكل منكم فلا يقرب هذا المسجد حتى يذهب ريحه منه» - يعني الثوم -","صحيح","Sahih al-Jami al-Saghir 4507","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4508","«كل ابن آدم يأكله التراب إلا عجب الذنب منه خلق ومنه يركب»","صحيح","Sahih al-Jami al-Saghir 4508","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4509","«كل المسلم على المسلم حرام ماله وعرضه ودمه حسب امرئ من الشر أن يحقر أخاه المسلم»","صحيح","Sahih al-Jami al-Saghir 4509","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4510","«كل امرء في ظل صدقته حتى يقضى بين الناس»","صحيح","Sahih al-Jami al-Saghir 4510","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4511","«كل امرئ مهيأ لما خلق له»","حسن","Sahih al-Jami al-Saghir 4511","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4512","«كل أمتي معافى إلا المجاهرين وإن من الجهار أن يعمل الرجل بالليل عملا ثم يصبح وقد ستره الله تعالى فيقول: عملت البارحة كذا وكذا وقد بات يستره ربه ويصبح يكشف ستر الله عنه»","صحيح","Sahih al-Jami al-Saghir 4512","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4513","«كل أمتي يدخلون الجنة إلا من أبى من أطاعني دخل الجنة ومن عصاني فقد أبى»","صحيح","Sahih al-Jami al-Saghir 4513","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4514","«كل أهل الجنة يرى مقعده من النار فيقول: لولا أن الله هداني فيكون له شكر وكل أهل النار يرى مقعده من الجنة فيقول: لوأن الله هداني فيكون عليه حسرة»","حسن","Sahih al-Jami al-Saghir 4514","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4515","«كل بني آدم خطاء وخير الخطائين التوابون»","حسن","Sahih al-Jami al-Saghir 4515","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4516","«كل بني آدم يطعن الشيطان في جنبيه بإصبعه حين يولد غير عيسى ابن مريم ذهب يطعن فطعن في الحجاب»","صحيح","Sahih al-Jami al-Saghir 4516","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4517","«كل بني آدم يمسه الشيطان يوم ولدته أمه إلا مريم وابنها»","صحيح","Sahih al-Jami al-Saghir 4517","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4518","«كل بيعين لا بيع بينهما حتى يتفرقا إلا بيع الخيار»","صحيح","Sahih al-Jami al-Saghir 4518","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4519","«كل جسد نبت من سحت فالنار أولى به»","صحيح","Sahih al-Jami al-Saghir 4519","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4520","«كل خطبة ليس فيها تشهد فهي كاليد الجذماء»","صحيح","Sahih al-Jami al-Saghir 4520","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4521","«كل خطوة يخطوها أحدكم إلى الصلاة يكتب له بها حسنة ويمحى عنه بها سيئة»","صحيح","Sahih al-Jami al-Saghir 4521","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4522","«كل خلق الله تعالى حسن»","صحيح","Sahih al-Jami al-Saghir 4522","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4523","«كل دعاء محجوب حتى يصلى على النبي صلى الله عليه وسلم»","حسن","Sahih al-Jami al-Saghir 4523","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4524","«كل ذنب عسى الله أن يغفره إلا من مات مشركا أو قتل مؤمنا متعمدا»","صحيح","Sahih al-Jami al-Saghir 4524","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4525","«كل ذي ناب من السباع فأكله حرام»","صحيح","Sahih al-Jami al-Saghir 4525","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4526","«كل راع مسئول عن رعيته»","صحيح","Sahih al-Jami al-Saghir 4526","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4527","«كل سبب ونسب منقطع يوم القيامة إلا سببي ونسبي»","صحيح","Sahih al-Jami al-Saghir 4527","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4528","«كل سلامى من الناس عليه صدقة كل يوم تطلع فيه الشمس تعدل بين الاثنين صدقة وتعين الرجل على دابته فيحمل عليها أو ترفع له عليها متاعه صدقة والكلمة الطيبة صدقة وكل خطوة تخطوها إلى الصلاة صدقة ودل الطريق صدقة وتميط الأذى عن الطريق صدقة»","صحيح","Sahih al-Jami al-Saghir 4528","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4529","«كل شراب أسكر فهو حرام»","صحيح","Sahih al-Jami al-Saghir 4529","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4530","«كل شرط ليس في كتاب الله تعالى فهو باطل وإن كان مائة شرط»","صحيح","Sahih al-Jami al-Saghir 4530","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4531","«كل شيء بقدر حتى العجز والكيس»","صحيح","Sahih al-Jami al-Saghir 4531","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4532","«كل شيء جأوز الكعبين من الإزار في النار»","صحيح","Sahih al-Jami al-Saghir 4532","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4533","«كل شيء قطع من الحي فهو ميت»","صحيح","Sahih al-Jami al-Saghir 4533","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4534","""كل شيء ليس من ذكر الله لهوولعب إلا أن يكون أربعة: ملاعبة الرجل امرأته وتأديب الرجل فرسه ومشي الرجل بين الغرضين، وتعليم الرجل السباحة ""","صحيح","Sahih al-Jami al-Saghir 4534","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4535","«كل صلاة لا يقرأ فيها بأم الكتاب فهي خداج»","صحيح","Sahih al-Jami al-Saghir 4535","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4536","«كل عرفة موقف وكل منى منحر وكل المزدلفة موقف وكل فجاج مكة طريق ومنحر»","صحيح","Sahih al-Jami al-Saghir 4536","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4537","«كل عرفات موقف وارفعوا عن عرنة وكل مزدلفة موقف وارفعوا عن بطن محسر وكل فجاج منى منحر وكل أيام التشريق ذبح»","صحيح","Sahih al-Jami al-Saghir 4537","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4538","«كل عمل ابن آدم يضاعف الحسنة بعشر أمثالها إلى سبعمائة ضعف إلى ما شاء الله قال الله عز وجل: إلا الصوم فإنه لي وأنا أجزي به يدع شهوته وطعامه من أجلي للصائم فرحتان فرحة عند فطره وفرحة عند لقاء ربه ولخلوف فمه أطيب عند الله من ريح المسك»","صحيح","Sahih al-Jami al-Saghir 4538","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4539","«كل عمل منقطع عن صاحبه إذا مات إلا المرابط في سبيل الله فإنه ينمى له عمله ويجرى عليه رزقه إلى يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 4539","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4540","«كل عين زانية والمرأة إذا استعطرت فمرت بالمجلس فهي زانية»","صحيح","Sahih al-Jami al-Saghir 4540","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4541",""" كل غلام رهينة بعقيقته يذبح عنه يوم سابعه، ويحلق رأسه ويسمى""","صحيح","Sahih al-Jami al-Saghir 4541","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4542","«كل قرض صدقة»","حسن","Sahih al-Jami al-Saghir 4542","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4543","«كل قسم قسم في الجاهلية فهو على ما قسم وكل قسم أدركه الإسلام فإنه على قسم الإسلام»","صحيح","Sahih al-Jami al-Saghir 4543","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4544","«كل كلم يكلمه المسلم في سبيل الله تعالى يكون يوم القيامة كهيئتها إذا طعنت تفجر دما واللون لون الدم والعرف عرف مسك»","صحيح","Sahih al-Jami al-Saghir 4544","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4545","«كل ما أسكر عن الصلاة فهو حرام»","صحيح","Sahih al-Jami al-Saghir 4545","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4546","«كل ما صنعت إلى أهلك فهو صدقة عليهم»","حسن","Sahih al-Jami al-Saghir 4546","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4547","«كل مال النبي صدقة إلا ما أطعمه أهله وكساهم إنا لا نورث»","صحيح","Sahih al-Jami al-Saghir 4547","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4548","«كل مخمر خمر وكل مسكر حرام ومن شرب مسكرا بخست صلاته أربعين صباحا فإن تاب تاب الله عليه فإن عاد الرابعة كان حقا على الله أن يسقيه من طينة الخبال صديد أهل النار ومن سقاه صغيرا لا يعرف حلاله من حرامه كان حقا على الله أن يسقيه من طينة الخبال»","صحيح","Sahih al-Jami al-Saghir 4548","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4549","«كل مستلحق بعد أبيه الذي يدعى له ادعاه ورثته من بعده من كان من أمة يملكها يوم أصابها فقد لحق بمن استلحقه وليس له فيما قسم قبله من الميراث شيء وما أدرك من ميراث لم يقسم فله نصيبه ولا يلحق إذا كان أبوه الذي يدعى له أنكره وإن كان من أمة لا يملكها أو من حرة عاهر بها فإنه لا يلحق ولا يورث وإن كان الذي يدعى له هوادعاه فهو ولد زنا لأهل أمه من كانوا حرة أو أمة»","حسن","Sahih al-Jami al-Saghir 4549","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4550","«كل مسكر حرام»","صحيح","Sahih al-Jami al-Saghir 4550","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4551","«كل مسكر حرام وإن على الله لعهدا لمن شرب المسكر أن يسقيه من طينة الخبال عرق أهل النار»","صحيح","Sahih al-Jami al-Saghir 4551","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4552","«كل مسكر حرام وما أسكر منه الفرق فملء الكف منه حرام»","صحيح","Sahih al-Jami al-Saghir 4552","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4553","«كل مسكر خمر وكل مسكر حرام ومن شرب الخمر في الدنيا فمات وهو يدمنها لم يتب لم يشربها في الآخرة»","صحيح","Sahih al-Jami al-Saghir 4553","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4554","«كل مصور في النار يجعل له بكل صورة صورها نفس فتعذبه في جهنم»","صحيح","Sahih al-Jami al-Saghir 4554","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4555","«كل معروف صدقة»","صحيح","Sahih al-Jami al-Saghir 4555","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4556","«كل معروف صدقة والدال على الخير كفاعله.. ... »","صحيح","Sahih al-Jami al-Saghir 4556","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4557","«كل معروف صدقة وإن من المعروف أن تلقى أخاك ووجهك إليه منبسط وأن تصب من دلوك في إناء جارك»","حسن","Sahih al-Jami al-Saghir 4557","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4558","«كل معروف صنعته إلى غني أو فقير فهو صدقة»","حسن","Sahih al-Jami al-Saghir 4558","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4559","«كل مولود يولد على الفطرة حتى يعرب عنه لسانه فأبواه يهودانه أو ينصرانه أو يمجسانه»","صحيح","Sahih al-Jami al-Saghir 4559","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4560","«كل مولود يولد على الملة فأبواه يهودانه وينصرانه ويشركانه قيل: فمن هلك قبل ذلك؟ قال: الله أعلم بما كانوا عاملين»","صحيح","Sahih al-Jami al-Saghir 4560","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4561","«كل ميسر لما خلق له»","صحيح","Sahih al-Jami al-Saghir 4561","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4562","«كل ميت يختم على عمله إلا الذي مات مرابطا في سبيل الله فإنه ينموله عمله إلى يوم القيامة ويؤمن من فتان القبر»","صحيح","Sahih al-Jami al-Saghir 4562","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4563","«كل نائحة تكذب إلا أم سعد»","صحيح","Sahih al-Jami al-Saghir 4563","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4564","«كل نسب وصهر ينقطع يوم القيامة إلا نسبي وصهري»","صحيح","Sahih al-Jami al-Saghir 4564","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4565","«كل نفس من بني آدم سيد فالرجل سيد أهله والمرأة سيدة بيتها»","صحيح","Sahih al-Jami al-Saghir 4565","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4566","«كل نفقة ينفقها العبد يؤجر فيها إلا البنيان»","صحيح","Sahih al-Jami al-Saghir 4566","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4567","«كل يمين يحلف بها دون الله شرك»","صحيح","Sahih al-Jami al-Saghir 4567","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4568","«كلكم بنوآدم وآدم خلق من تراب لينتهين قوم يفتخرون بآبائهم أو ليكونن أهون على الله من الجعلان»","صحيح","Sahih al-Jami al-Saghir 4568","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4569","«كلكم راع وكلم مسئول عن رعيته فالإمام راع وهو مسئول عن رعيته والرجل راع في أهله وهو مسئول عن رعيته والمرأة راعية في بيت زوجها وهي مسئولة عن رعيتها والخادم راع في مال سيده وهو مسئول عن رعيته والرجل راع في مال أبيه وهو مسئول عن رعيته فكلكم راع وكلكم مسئول عن رعيته»","صحيح","Sahih al-Jami al-Saghir 4569","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4570","«كلكم يدخل الجنة إلا من شرد على الله شراد البعير على أهله»","صحيح","Sahih al-Jami al-Saghir 4570","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4571","«كلمات الفرج: لا إله إلا الله الحليم الكريم لا إله إلا الله العلي العظيم لا إله إلا الله رب السموات السبع ورب العرش الكريم»","صحيح","Sahih al-Jami al-Saghir 4571","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4572","«كلمتان خفيفتان على اللسان ثقيلتان في الميزان حبيبتان إلى الرحمن: سبحان الله وبحمده سبحان الله العظيم»","صحيح","Sahih al-Jami al-Saghir 4572","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4573","«كم من أشعث أغبر ذي طمرين لا يؤبه له لو أقسم على الله لأبره منهم البراء بن مالك»","صحيح","Sahih al-Jami al-Saghir 4573","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4574","«كم من عذق معلق لابن الدحداح في الجنة»","صحيح","Sahih al-Jami al-Saghir 4574","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4575","«كما لا يجتنى من الشوك العنب كذلك لا ينزل الفجار منازل الأبرار فاسلكوا أي طريق شئتم فأي طريق سلكتم وردتم على أهله»","حسن","Sahih al-Jami al-Saghir 4575","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4576","«كما لا يجتنى من الشوك العنب كذلك لا ينزل الفجار منازل الأبرار وهما طريقان فأيهما أخذتم أدركتم إليه»","صحيح","Sahih al-Jami al-Saghir 4576","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4577","«كما يضاعف لنا الأجر كذلك يضاعف علينا البلاء»","حسن","Sahih al-Jami al-Saghir 4577","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4578","«كمل من الرجال كثير ولم يكمل من النساء إلا آسية امرأة فرعون ومريم بنت عمران وإن فضل عائشة على النساء كفضل الثريد على سائر الطعام»","صحيح","Sahih al-Jami al-Saghir 4578","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4579","«كن في الدنيا كأنك غريب أو عابر سبيل»","صحيح","Sahih al-Jami al-Saghir 4579","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4580","«كن ورعا تكن أعبد الناس وكن قنعا تكن أشكر الناس وأحب للناس ما تحب لنفسك تكن مؤمنا وأحسن مجأورة من جأورك تكن مسلما وأقل الضحك فإن كثرة الضحك تميت القلب»","صحيح","Sahih al-Jami al-Saghir 4580","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4581","«كنت نبيا وآدم بين الروح والجسد»","صحيح","Sahih al-Jami al-Saghir 4581","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4582","«كنت نهيتكم عن الأشربة إلا في ظروف الأدم فاشربوا في كل وعاء غير أن لا تشربوا مسكرا»","صحيح","Sahih al-Jami al-Saghir 4582","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4583","«كنت نهيتكم عن الأوعية فانبذوا واجتنبوا كل مسكر»","صحيح","Sahih al-Jami al-Saghir 4583","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4584","«كنت نهيتكم عن زيارة القبور ألا فزوروها فإنها ترق القلب وتدمع العين وتذكر الآخرة ولا تقولوا هجرا»","صحيح","Sahih al-Jami al-Saghir 4584","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4585","«كنت نهيتكم عن لحوم الأضاحي فوق ثلاث ليتسع ذووالطول على من لا طول له فكلوا ما بدا لكم وأطعموا وادخروا»","صحيح","Sahih al-Jami al-Saghir 4585","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4586","«كونوا على مشاعركم هذه فإنكم اليوم على إرث من إرث إبراهيم»","صحيح","Sahih al-Jami al-Saghir 4586","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4587","«كونوا في الصف الذي يليني»","صحيح","Sahih al-Jami al-Saghir 4587","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4588","«كيف أنت إذا كانت عليك أمراء يؤخرون الصلاة عن وقتها؟ صل الصلاة لوقتها فإن أدركتها معهم فصل فإنها لك نافلة»","صحيح","Sahih al-Jami al-Saghir 4588","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4589","«كيف أنتم إذا لم تجتبوا دينارا ولا درهما؟ تنتهك ذمة الله وذمة رسوله يشد الله قلوب أهل الذمة فيمنعون ما في أيديهم»","صحيح","Sahih al-Jami al-Saghir 4589","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4590","«كيف أنتم إذا نزل ابن مريم فيكم فأمكم؟»","صحيح","Sahih al-Jami al-Saghir 4590","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4591","«كيف أنتم إذا نزل ابن مريم فيكم وإمامكم منكم؟»","صحيح","Sahih al-Jami al-Saghir 4591","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4592","«كيف أنتم وصاحب القرن قد التقم القرن وحنا الجبهة وأصغى السمع ينتظر متى يؤمر بالنفخ فينفخ قالوا: كيف نصنع؟ قال قولوا: حسبنا الله ونعم الوكيل على الله توكلنا»","صحيح","Sahih al-Jami al-Saghir 4592","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4593","«كيف بكم إذا أتت عليكم أمراء يصلون الصلاة لغير ميقاتها؟ صل الصلاة لميقاتها واجعل صلاتك معهم سبحة»","صحيح","Sahih al-Jami al-Saghir 4593","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4594","«كيف بكم بزمان يوشك أن يأتي يغربل الناس فيه غربلة ويبقى حثالة من الناس قد مرجت عهودهم وأماناتهم واختلفوا وكانوا هكذا؟ - وشبك بين أصابعه - تأخذون بما تعرفون وتدعون ما تنكرون وتقبلون على أمر خاصتكم وتذرون أمر عامتكم»","صحيح","Sahih al-Jami al-Saghir 4594","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4595","«كيف تقولون لفرح رجل انفلتت منه راحلته تجر زمامها بأرض قفر ليس بها طعام ولا شراب وعليها له طعام وشراب فطلبها فلم يجدها حتى شق عليه ثم مرت بجذل شجرة فتعلق زمامها فوجدها متعلقة به؟ أما والله لله أشد فرحا بتوبة عبده من الرجل براحلته»","صحيح","Sahih al-Jami al-Saghir 4595","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4596","«كيف وقد قيل؟»","صحيح","Sahih al-Jami al-Saghir 4596","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4597","«كيف يقدس الله أمة لا يأخذ ضعيفها حقه من قويها وهو غير متعتع؟»","صحيح","Sahih al-Jami al-Saghir 4597","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4598","«كيف يقدس الله أمة لا يؤخذ من شديدهم لضعيفهم»","صحيح","Sahih al-Jami al-Saghir 4598","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4599","«كيلوا طعامكم فإن البركة في الطعام المكيل»","صحيح","Sahih al-Jami al-Saghir 4599","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4600","«كيلوا طعامكم يبارك لكم فيه»","صحيح","Sahih al-Jami al-Saghir 4600","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4601","«الكبائر: الإشراك بالله وعقوق الوالدين وقتل النفس واليمين الغموس»","صحيح","Sahih al-Jami al-Saghir 4601","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4602","«الكبائر: الإشراك بالله وقذف المحصنة وقتل النفس المؤمنة والفرار يوم الزحف وأكل مال اليتيم وعقوق الوالدين المسلمين وإلحاد بالبيت قبلتكم أحياء وأمواتا»","حسن","Sahih al-Jami al-Saghir 4602","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4603","«الكبائر: الشرك بالله والإياس من روح الله والقنوط من رحمة الله»","حسن","Sahih al-Jami al-Saghir 4603","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4604","«الكبائر: الشرك بالله وقتل النفس وعقوق الوالدين ألا أنبئكم بأكبر الكبائر؟ قول الزور»","صحيح","Sahih al-Jami al-Saghir 4604","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4605","«الكبائر تسع: أعظمهن إشراك بالله وقتل النفس بغير حق وأكل الربا وأكل مال اليتيم وقذف المحصنة والفرار يوم الزحف وعقوق الوالدين واستحلال البيت الحرام: قبلتكم أحياء وأمواتا»","حسن","Sahih al-Jami al-Saghir 4605","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4606","«الكبائر سبع: الإشراك بالله وقتل النفس التي حرم الله إلا بالحق وقذف المحصنة والفرار من الزحف وأكل الربا وأكل مال اليتيم والرجوع إلى الأعرابية بعد الهجرة»","حسن","Sahih al-Jami al-Saghir 4606","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4607","«الكبر الكبر»","صحيح","Sahih al-Jami al-Saghir 4607","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4608","«الكبر من بطر الحق وغمط الناس»","صحيح","Sahih al-Jami al-Saghir 4608","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4609","«الكحل وتر»","صحيح","Sahih al-Jami al-Saghir 4609","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4610","«الكريم ابن الكريم ابن الكريم ابن الكريم: يوسف بن يعقوب بن إسحاق بن إبراهيم»","صحيح","Sahih al-Jami al-Saghir 4610","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4611","«الكلب الأسود البهيم شيطان»","صحيح","Sahih al-Jami al-Saghir 4611","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4612","«الكمأة من المن الذي أنزل الله تعالى على بني إسرائيل وماؤها شفاء للعين»","صحيح","Sahih al-Jami al-Saghir 4612","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4613","«الكمأة من المن وماؤها شفاء للعين»","صحيح","Sahih al-Jami al-Saghir 4613","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4614","«الكوثر نهر أعطانيه الله في الجنة ترابه مسك أبيض من اللبن وأحلى من العسل ترده طائر أعناقها مثل أعناق الجزر آكلها أنعم منها»","صحيح","Sahih al-Jami al-Saghir 4614","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4615","«الكوثر نهر في الجنة حافتاه من ذهب ومجراه على الدر والياقوت تربته أطيب ريحا من المسك وماؤه أحلى من العسل وأشد بياضا من الثلج»","صحيح","Sahih al-Jami al-Saghir 4615","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4616","«كان آخر كلام النبي صلى الله عليه وسلم: الصلاة الصلاة اتقوا الله فيما ملكت أيمانكم»","صحيح","Sahih al-Jami al-Saghir 4616","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4617","«كان آخر ما تكلم به أن قال: قاتل الله اليهود والنصارى اتخذوا قبور أنبيائهم مساجد لا يبقين دينان بأرض العرب»","صحيح","Sahih al-Jami al-Saghir 4617","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4618","«كان أبغض الخلق إليه الكذب»","صحيح","Sahih al-Jami al-Saghir 4618","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4619","«كان أبيض كأنما صيغ من فضة رجل الشعر»","حسن","Sahih al-Jami al-Saghir 4619","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4620","«كان أبيض مشربا بحمرة ضخم الهامة،........ أهداب الأشفار»","حسن","Sahih al-Jami al-Saghir 4620","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4621","«كان أبيض مشربا بياضه بحمرة وكان أسود الحدقة أهدب الأشفار»","صحيح","Sahih al-Jami al-Saghir 4621","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4622","«كان أبيض مليحا مقصدا»","صحيح","Sahih al-Jami al-Saghir 4622","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4623","«كان أحب الألوان إليه الخضرة»","حسن","Sahih al-Jami al-Saghir 4623","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4624","«كان أحب الثياب إليه الحبرة»","صحيح","Sahih al-Jami al-Saghir 4624","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4625","«كان أحب الثياب إليه القميص»","صحيح","Sahih al-Jami al-Saghir 4625","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4626","«كان أحب الدين إليه ما دأوم عليه صاحبه»","صحيح","Sahih al-Jami al-Saghir 4626","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4627","«كان أحب الشراب إليه الحلوالبارد»","صحيح","Sahih al-Jami al-Saghir 4627","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4628","«كان أحب الشهور إليه أن يصومه شعبان ثم يصله برمضان»","صحيح","Sahih al-Jami al-Saghir 4628","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4629","«كان أحب العرق إليه ذراع الشاة»","صحيح","Sahih al-Jami al-Saghir 4629","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4630","«كان أحب العمل إليه ما دووم عليه وإن قل»","صحيح","Sahih al-Jami al-Saghir 4630","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4631","«كان أحب ما استتر به لحاجته هدف أو حائش نخل»","صحيح","Sahih al-Jami al-Saghir 4631","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4632","«كان أحسن الناس خلقا»","صحيح","Sahih al-Jami al-Saghir 4632","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4633","«كان أحسن الناس» صفة وأجملها كان ربعة إلى الطول ما هوبعيد ما بين المنكبين أسيل الخدين شديد سواد الشعر أكحل العينين أهدب الأشفار إذا وطئ بقدمه وطئ بكلها ليس له أخمص إذا وضع رداءه عن منكبيه فكأنه سبيكة فضة،.. ... ""","حسن","Sahih al-Jami al-Saghir 4633","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4634","«كان أحسن الناس وأجود الناس وأشجع الناس»","صحيح","Sahih al-Jami al-Saghir 4634","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4635","«كان أحسن الناس وجها وأحسنهم خلقا ليس بالطويل البائن ولا بالقصير»","صحيح","Sahih al-Jami al-Saghir 4635","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4636","«كان أخف الناس صلاة على الناس وأطول الناس صلاة لنفسه»","صحيح","Sahih al-Jami al-Saghir 4636","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4637","«كان أخف الناس صلاة في تمام»","صحيح","Sahih al-Jami al-Saghir 4637","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4638","«كان إذا أتى باب قوم لم يستقبل الباب من تلقاء وجهه ولكن من ركنه الأيمن أو الأيسر ويقول: السلام عليكم السلام عليكم»","صحيح","Sahih al-Jami al-Saghir 4638","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4639","«كان إذا أتى مريضا أو أتي به قال: أذهب الباس رب الناس اشف وأنت الشافي لا شفاء إلا شفاؤك شفاء لا يغادر سقما»","صحيح","Sahih al-Jami al-Saghir 4639","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4640","«كان إذا أتاه الأمر يسره قال: الحمد لله الذي بنعمته تتم الصالحات وإذا أتاه الأمر يكرهه قال: الحمد لله على كل حال»","صحيح","Sahih al-Jami al-Saghir 4640","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4641","«كان إذا أتاه الرجل وله اسم لا يحبه حوله»","صحيح","Sahih al-Jami al-Saghir 4641","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4642","«كان إذا أتاه الفيء قسمه في يومه فأعطى الآهل حظين وأعطى العزب حظا»","صحيح","Sahih al-Jami al-Saghir 4642","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4643","«كان إذا أتاه قوم بصدقتهم قال:» اللهم صل على آل فلان""","صحيح","Sahih al-Jami al-Saghir 4643","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4644","«كان إذا أتي بباكورة الثمرة وضعها على عينيه ثم على شفتيه، ... ثم يعطيه من يكون عنده من الصبيان»","صحيح","Sahih al-Jami al-Saghir 4644","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4645","«كان إذا أتي بطعام سأل عنه أهدية أم صدقة؟ فإن قيل: صدقة قال لأصحابه:» كلوا [ولم يأكل وإن قيل: هدية ضرب بيده فأكل معهم]","صحيح","Sahih al-Jami al-Saghir 4645","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4646","«كان إذا أخذ أهله الوعك أمر بالحساء فصنع ثم أمرهم فحسوا وكان يقول: إنه ليرتوفؤاد الحزين ويسروعن فؤاد السقيم كما تسروإحداكن الوسخ بالماء عن وجهها»","صحيح","Sahih al-Jami al-Saghir 4646","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4647","«كان إذا أخذ مضجعه جعل يده اليمنى تحت خده الأيمن»","صحيح","Sahih al-Jami al-Saghir 4647","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4648","«كان إذا أخذ مضجعه قرأ {قُلْ يَا أَيُّهَا الْكَافِرُونَ} حتى يختمها»","حسن","Sahih al-Jami al-Saghir 4648","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4649","«كان إذا أخذ مضجعه من الليل قال: بسم الله وضعت جنبي اللهم اغفر لي ذنبي واخسأ شيطاني وفك رهاني وثقل ميزاني واجعلني في الندي الأعلى»","صحيح","Sahih al-Jami al-Saghir 4649","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4650","«كان إذا أخذ مضجعه من الليل وضع يده تحت خده ثم يقول: باسمك اللهم أحيا وباسمك أموت وإذا استيقظ قال: الحمد لله الذي أحيانا بعد ما أماتنا وإليه النشور»","صحيح","Sahih al-Jami al-Saghir 4650","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4651","«كان إذا أراد الحاجة أبعد»","صحيح","Sahih al-Jami al-Saghir 4651","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4652","«كان إذا أراد الحاجة لم يرفع ثوبه حتى يدنومن الأرض»","صحيح","Sahih al-Jami al-Saghir 4652","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4653","«كان إذا أراد أن يباشر امرأة من نسائه وهي حائض أمرها أن تأتزر ثم يباشرها»","صحيح","Sahih al-Jami al-Saghir 4653","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4654","«كان إذا أراد أن يحرم تطيب بأطيب ما يجد»","صحيح","Sahih al-Jami al-Saghir 4654","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4655","«كان إذا أراد أن يدعوعلى أحد أو يدعولأحد قنت بعد الركوع»","صحيح","Sahih al-Jami al-Saghir 4655","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4656","«كان إذا أراد أن يرقد وضع يده اليمنى تحت خده ثم يقول:» اللهم قني عذابك يوم تبعث عبادك "" - ثلاث مرات -","صحيح","Sahih al-Jami al-Saghir 4656","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4657","«كان إذا أراد أن يستودع الجيش قال:» استودع الله دينكم وأمانتكم وخواتيم أعمالكم""","صحيح","Sahih al-Jami al-Saghir 4657","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4658","«كان إذا أراد أن يعتكف صلى الفجر ثم دخل معتكفه»","صحيح","Sahih al-Jami al-Saghir 4658","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4659","«كان إذا أراد أن ينام وهو جنب توضأ وضوءه للصلاة وإذا أراد أن يأكل أو يشرب وهو جنب غسل يديه ثم يأكل ويشرب»","صحيح","Sahih al-Jami al-Saghir 4659","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4660","«كان إذا أراد أن ينام وهو جنب غسل فرجه وتوضأ للصلاة»","صحيح","Sahih al-Jami al-Saghir 4660","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4661","«كان إذا أراد سفرا أقرع بين نسائه فأيتهن خرج سهمها خرج بها معه»","صحيح","Sahih al-Jami al-Saghir 4661","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4662","«كان إذا أراد غزوة ورى بغيرها»","صحيح","Sahih al-Jami al-Saghir 4662","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4663","«كان إذا أراد من الحائض شيئا ألقى على فرجها ثوبا»","صحيح","Sahih al-Jami al-Saghir 4663","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4664","«كان إذا استجد ثوبا سماه باسمه قميصا أو عمامة أو رداء ثم يقول:» اللهم لك الحمد أنت كسوتنيه أسألك من خيره وخير ما صنع له وأعوذ بك من شره وشر ما صنع له ""","صحيح","Sahih al-Jami al-Saghir 4664","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4665","«كان إذا استراث الخبر تمثل ببيت طرفة: ويأتيك بالأخبار من لم تزود»","حسن","Sahih al-Jami al-Saghir 4665","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4666","«كان إذا استسقى قال:» اللهم اسق عبادك وبهائمك وانشر رحمتك وأحيي بلدك الميت""","حسن","Sahih al-Jami al-Saghir 4666","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4667","«كان إذا استفتح الصلاة قال:» سبحانك اللهم وبحمدك وتبارك اسمك وتعالى جدك ولا إله غيرك ""","صحيح","Sahih al-Jami al-Saghir 4667","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4668","«كان إذا استن أعطى السواك الأكبر وإذا شرب أعطى الذي عن يمينه»","صحيح","Sahih al-Jami al-Saghir 4668","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4669","«كان إذا اشتد البرد بكر بالصلاة وإذا اشتد الحر أبرد بالصلاة»","صحيح","Sahih al-Jami al-Saghir 4669","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4670","كان إذا اشتدت الريح قال: [اللهم لقحا لا عقيما]","حسن","Sahih al-Jami al-Saghir 4670","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4671","كان إذا اشتكى أحد رأسه قال: [اذهب فاحتجم وإذا اشتكى رجله قال: اذهب فاخضبها بالحناء]","حسن","Sahih al-Jami al-Saghir 4671","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4672","كان إذا اشتكى رقاه جبريل قال: [بسم الله يبريك من داء يشفيك ومن شر حاسد إذا حسد وشر كل ذي عين]","صحيح","Sahih al-Jami al-Saghir 4672","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4673","«كان إذا اشتكى نفث على نفسه بالمعوذات ومسح عنه بيده»","صحيح","Sahih al-Jami al-Saghir 4673","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4674","كان إذا أصبح وإذا أمسى قال: "" أصبحنا على فطرة الإسلام وكلمة الإخلاص ودين نبينا محمد وملة أبينا إبراهيم حنيفا مسلما وما كان من المشركين""","صحيح","Sahih al-Jami al-Saghir 4674","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4675","«كان إذا اطلع على أحد من أهل بيته كذب كذبة لم يزل معرضا عنه حتى يحدث توبة»","صحيح","Sahih al-Jami al-Saghir 4675","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4676","«كان إذا اعتم سدل عمامته بين كتفيه»","صحيح","Sahih al-Jami al-Saghir 4676","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4677","كان إذا أفطر عند قوم قال: [أفطر عندكم الصائمون وأكل طعامكم الأبرار وتنزلت عليكم الملائكة]","صحيح","Sahih al-Jami al-Saghir 4677","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4678","كان إذا أفطر قال: [ذهب الظمأ وابتلت العروق وثبت الأجر إن شاء الله]","حسن","Sahih al-Jami al-Saghir 4678","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4679","كان إذا أفطر عند قوم قال: [أفطر عندكم الصائمون وصلت عليكم الملائكة]","صحيح","Sahih al-Jami al-Saghir 4679","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4680","«كان إذا اكتحل اكتحل وترا وإذا استجمر استجمر وترا»","صحيح","Sahih al-Jami al-Saghir 4680","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4681","«كان إذا أكل أو شرب قال: الحمد لله الذي أطعم وسقى وسوغه وجعل له مخرجا»","صحيح","Sahih al-Jami al-Saghir 4681","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4682","«كان إذا أكل طعاما لعق أصابعه الثلاث»","صحيح","Sahih al-Jami al-Saghir 4682","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4683","«كان إذا أكل لم تعد أصابعه بين يديه»","صحيح","Sahih al-Jami al-Saghir 4683","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4684","«كان إذا التقى الختانان اغتسل»","صحيح","Sahih al-Jami al-Saghir 4684","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4685","«كان إذا أنزل عليه الوحي كرب لذلك وتربد وجهه»","صحيح","Sahih al-Jami al-Saghir 4685","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4686","«كان إذا أنزل عليه الوحي نكس رأسه ونكس أصحابه رءوسهم فإذا أقلع عنه رفع رأسه»","صحيح","Sahih al-Jami al-Saghir 4686","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4687","«كان إذا انصرف انحرف»","صحيح","Sahih al-Jami al-Saghir 4687","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4688","«كان إذا انصرف من صلاته استغفر ثلاثا ثم قال: اللهم أنت السلام ومنك السلام تباركت يا ذا الجلال والإكرام»","صحيح","Sahih al-Jami al-Saghir 4688","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4689","«كان إذا أوى إلى فراشه قال: الحمد لله الذي أطعمنا وسقانا وكفانا وأوانا فكم ممن لا كافي له ولا مؤوي له»","صحيح","Sahih al-Jami al-Saghir 4689","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4690","«كان إذا بايعه الناس يلقنهم: فيما استطعت»","صحيح","Sahih al-Jami al-Saghir 4690","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4691","«كان إذا بعث أحدا من أصحابه في بعض أمره قال: بشروا ولا تنفروا ويسروا ولا تعسروا»","صحيح","Sahih al-Jami al-Saghir 4691","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4692","«كان إذا بلغه عن الرجل شيء لم يقل: ما بال فلان يقول؟ ولكن يقول: ما بال أقوام يقولون كذا وكذا»","صحيح","Sahih al-Jami al-Saghir 4692","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4693","«كان إذا تضور من الليل قال: لا إله إلا الله الواحد القهار رب السموات والأرض وما بينهما العزيز الغفار»","صحيح","Sahih al-Jami al-Saghir 4693","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4694","«كان إذا تكلم بكلمة أعادها ثلاثا حتى تفهم عنه وإذا أتى على قوم فسلم عليهم سلم عليهم ثلاثا»","صحيح","Sahih al-Jami al-Saghir 4694","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4695","«كان إذا تهجد يسلم بين كل ركعتين»","صحيح","Sahih al-Jami al-Saghir 4695","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4696","""كان إذا توضأ أخذ كفا من ماء فأدخله تحت حنكه فخلل به لحيته وقال: هكذا أمرني ربي""","صحيح","Sahih al-Jami al-Saghir 4696","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4697","«كان إذا توضأ أخذ كفا من ماء فنضح به فرجه»","صحيح","Sahih al-Jami al-Saghir 4697","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4698","«كان إذا توضأ أدار الماء على مرفقيه»","صحيح","Sahih al-Jami al-Saghir 4698","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4699","«كان إذا توضأ خلل لحيته بالماء»","صحيح","Sahih al-Jami al-Saghir 4699","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4700","«كان إذا توضأ دلك أصابع رجليه بخنصره»","صحيح","Sahih al-Jami al-Saghir 4700","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4701","«كان إذا جاءه أمر يسر به خر ساجدا شكرا لله تعالى»","حسن","Sahih al-Jami al-Saghir 4701","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4702","«كان إذا جلس احتبى بيديه»","صحيح","Sahih al-Jami al-Saghir 4702","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4703","«كان إذا حزبه أمر صلى»","حسن","Sahih al-Jami al-Saghir 4703","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4704","«كان إذا حلف على يمين لا يحنث حتى نزلت كفارة اليمين»","صحيح","Sahih al-Jami al-Saghir 4704","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4705","«كان إذا حلف قال: والذي نفس محمد بيده»","صحيح","Sahih al-Jami al-Saghir 4705","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4706","«كان إذا خاف قوما قال: اللهم إنا نجعلك في نحورهم ونعوذ بك من شرورهم»","صحيح","Sahih al-Jami al-Saghir 4706","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4707","«كان إذا خرج من الغائط قال: غفرانك»","حسن","Sahih al-Jami al-Saghir 4707","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4708","«كان إذا خرج من بيته قال: بسم الله توكلت على الله اللهم إنا نعوذ بك من أن نزل أو نضل أو نظلم أو نظلم أو نجهل أو يجهل علينا»","صحيح","Sahih al-Jami al-Saghir 4708","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4709","«كان إذا خرج من بيته قال: بسم الله رب أعوذ بك من أن أزل أو أضل أو أظلم أو أظلم أو أجهل أو يجهل علي»","صحيح","Sahih al-Jami al-Saghir 4709","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4710","«كان إذا خرج يوم العيد في طريق رجع في غيره»","صحيح","Sahih al-Jami al-Saghir 4710","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4711","«كان إذا خطب احمرت عيناه وعلا صوته واشتد غضبه كأنه منذر جيش يقول: صبحكم ومساكم»","صحيح","Sahih al-Jami al-Saghir 4711","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4712","«كان إذا دخل الخلاء قال: اللهم إني أعوذ بك من الخبث والخبائث»","صحيح","Sahih al-Jami al-Saghir 4712","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4713","«كان إذا دخل العشر شد مئزره وأحيا ليله وأيقظ أهله»","صحيح","Sahih al-Jami al-Saghir 4713","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4714","«كان إذا دخل الكنيف قال: بسم الله اللهم إني أعوذ بك من الخبث والخبائث»","صحيح","Sahih al-Jami al-Saghir 4714","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4715","«كان إذا دخل المسجد قال: أعوذ بالله العظيم وبوجهه الكريم وسلطانه القديم من الشيطان الرجيم وقال: إذا قال ذلك حفظ منه سائر اليوم»","صحيح","Sahih al-Jami al-Saghir 4715","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4716","«كان إذا دخل المسجد قال:» ...... اللهم صل على محمد وأزواج محمد ""","صحيح","Sahih al-Jami al-Saghir 4716","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4717","«كان إذا دخل بيته بدأ بالسواك»","صحيح","Sahih al-Jami al-Saghir 4717","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4718","«كان إذا دخل على مريض يعوده قال: لا بأس طهور إن شاء الله»","صحيح","Sahih al-Jami al-Saghir 4718","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4719","«كان إذا دخل قال:» هل عندكم طعام [؟ فإذا قيل لا قال: ] إني صائم""","صحيح","Sahih al-Jami al-Saghir 4719","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4720","«كان إذا دعا بدأ بنفسه»","صحيح","Sahih al-Jami al-Saghir 4720","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4721","«كان إذا دعا جعل باطن كفه إلى وجهه»","صحيح","Sahih al-Jami al-Saghir 4721","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4722","«كان إذا ذبح الشاة يقول: أرسلوا بها إلى أصدقاء خديجة»","صحيح","Sahih al-Jami al-Saghir 4722","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4723","«كان إذا ذكر أحدا فدعا له بدأ بنفسه»","صحيح","Sahih al-Jami al-Saghir 4723","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4724","«كان إذا ذهب المذهب أبعد»","صحيح","Sahih al-Jami al-Saghir 4724","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4725","كان إذا رأى المطر قال: [اللهم صيبا نافعا]","صحيح","Sahih al-Jami al-Saghir 4725","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4726","«كان إذا رأى الهلال قال: اللهم أهله علينا باليمن والإيمان والسلامة والإسلام ربي وربك الله»","حسن","Sahih al-Jami al-Saghir 4726","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4727","«كان إذا رأى ما يحب قال: الحمد لله الذي بنعمته تتم الصالحات وإذا رأى ما يكره قال: الحمد لله على كل حال ... ...»","صحيح","Sahih al-Jami al-Saghir 4727","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4728","«كان إذا راعه شيء قال: الله الله ربي لا شريك له»","صحيح","Sahih al-Jami al-Saghir 4728","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4729","""كان إذا رفأ الإنسان إذا تزوج قال: بارك الله لك، وبارك عليك وجمع بينكما في خير ""","صحيح","Sahih al-Jami al-Saghir 4729","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4730","«كان إذا رفع رأسه من الركوع في صلاة الصبح في آخر ركعة قنت»","صحيح","Sahih al-Jami al-Saghir 4730","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4731","«كان إذا رفعت مائدته قال: الحمد لله حمدا كثيرا طيبا مباركا فيه الحمد لله الذي كفانا وأوانا غير مكفي ولا مكفور ولا مودع ولا مستغنى عنه ربنا»","صحيح","Sahih al-Jami al-Saghir 4731","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4732","«كان إذا ركع سوى ظهره حتى لوصب عليه الماء لاستقر»","صحيح","Sahih al-Jami al-Saghir 4732","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4733","«كان إذا ركع فرج أصابعه وإذا سجد ضم أصابعه»","صحيح","Sahih al-Jami al-Saghir 4733","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4734","«كان إذا ركع قال: سبحان ربي العظيم وبحمده - ثلاثا - وإذا سجد قال: سبحان ربي الأعلى وبحمده -» ثلاثا"" ""","صحيح","Sahih al-Jami al-Saghir 4734","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4735","«كان إذا رمى الجمار مشى إليه ذاهبا وراجعا»","صحيح","Sahih al-Jami al-Saghir 4735","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4736","«كان إذا رمى جمرة العقبة مضى ولم يقف»","صحيح","Sahih al-Jami al-Saghir 4736","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4737","«كان إذا سأل الله جعل باطن كفيه إليه ... ...»","صحيح","Sahih al-Jami al-Saghir 4737","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4738","«كان إذا سجد جافى حتى يرى بياض إبطيه»","صحيح","Sahih al-Jami al-Saghir 4738","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4739","«كان إذا سر استنار وجهه كأنه قطعة قمر»","صحيح","Sahih al-Jami al-Saghir 4739","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4740","«كان إذا سلم لم يقعد إلا بمقدار ما يقول: اللهم أنت السلام ومنك السلام تباركت يا ذا الجلال والإكرام»","صحيح","Sahih al-Jami al-Saghir 4740","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4741","«كان إذا سمع المؤذن قال مثل ما يقول حتى إذا بلغ: حي على الصلاة حي على الفلاح قال:» لا حول ولا قوة إلا بالله ""","صحيح","Sahih al-Jami al-Saghir 4741","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4742","«كان إذا سمع المؤذن يتشهد قال: وأنا وأنا»","صحيح","Sahih al-Jami al-Saghir 4742","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4743","«كان إذا سمع بالاسم القبيح حوله إلى ما هو أحسن منه»","حسن","Sahih al-Jami al-Saghir 4743","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4744",""" كان إذا شرب تنفس ثلاثا ويقول: هو أهنأ وأمرأ, وأبرأ""","صحيح","Sahih al-Jami al-Saghir 4744","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4745","«كان إذا صعد المنبر سلم»","صحيح","Sahih al-Jami al-Saghir 4745","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4746","«كان إذا صلى الغداة جاءه أهل المدينة بآنيتهم فيها الماء فما يؤتى بإناء إلا غمس يده فيه»","صحيح","Sahih al-Jami al-Saghir 4746","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4747","«كان إذا صلى الغداة جلس في مصلاه حتى تطلع الشمس»","صحيح","Sahih al-Jami al-Saghir 4747","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4748","«كان إذا صلى الغداة في سفر مشى عن راحلته قليلا»","صحيح","Sahih al-Jami al-Saghir 4748","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4749","«كان إذا صلى ركعتي الفجر اضطجع على شقه الأيمن»","صحيح","Sahih al-Jami al-Saghir 4749","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4750","«كان إذا صلى صلاة أثبتها»","صحيح","Sahih al-Jami al-Saghir 4750","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4751","«كان إذا طاف بالبيت استلم الحجر والركن في كل طواف»","صحيح","Sahih al-Jami al-Saghir 4751","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4752","«كان إذا عرس وعليه ليل توسد يمينه وإذا عرس قبل الصبح وضع رأسه على كفه اليمنى وأقام ساعده»","صحيح","Sahih al-Jami al-Saghir 4752","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4753","«كان إذا عصفت الريح قال: اللهم إني أسألك خيرها وخير ما فيها وخير ما أرسلت به وأعوذ بك من شرها وشر ما فيها وشر ما أرسلت به»","صحيح","Sahih al-Jami al-Saghir 4753","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4754","«كان إذا عطس حمد الله فيقال له: يرحمك الله فيقول: يهديكم الله ويصلح بالكم»","صحيح","Sahih al-Jami al-Saghir 4754","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4755","«كان إذا عطس وضع يده أو ثوبه على فيه وخفض بها صوته»","صحيح","Sahih al-Jami al-Saghir 4755","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4756","«كان إذا عمل عملا أثبته»","صحيح","Sahih al-Jami al-Saghir 4756","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4757","«كان إذا غزا قال: اللهم أنت عضدي وأنت نصيري بك أحول وبك أصول وبك أقاتل»","صحيح","Sahih al-Jami al-Saghir 4757","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4758","«كان إذا غضب احمرت وجنتاه»","صحيح","Sahih al-Jami al-Saghir 4758","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4759","«كان إذا فاته الأربع قبل الظهر صلاها.... بعد الظهر»","حسن","Sahih al-Jami al-Saghir 4759","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4760","«كان إذا فرغ من دفن الميت وقف عليه فقال: استغفروا الله لأخيكم وسلوا له التثبيت فإنه الآن يسأل»","صحيح","Sahih al-Jami al-Saghir 4760","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4761","«كان إذا قام إلى الصلاة رفع يديه مدا»","صحيح","Sahih al-Jami al-Saghir 4761","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4762","«كان إذا قام على المنبر استقبله أصحابه بوجوههم»","صحيح","Sahih al-Jami al-Saghir 4762","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4763","«كان إذا قام من الليل ليصلي افتتح صلاته بركعتين خفيفتين»","صحيح","Sahih al-Jami al-Saghir 4763","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4764","«كان إذا قام من الليل يشوص فاه بالسواك»","صحيح","Sahih al-Jami al-Saghir 4764","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4765","«كان إذا قدم من سفر تلقي بصبيان أهل بيته»","صحيح","Sahih al-Jami al-Saghir 4765","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4766","«كان إذا قرأ: {سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى} قال: سبحان ربي الأعلى»","صحيح","Sahih al-Jami al-Saghir 4766","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4767","«كان إذا قرأ من الليل رفع طورا وخفض طورا»","حسن","Sahih al-Jami al-Saghir 4767","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4768","«كان إذا قرب إليه طعام قال: بسم الله فإذا فرغ قال: اللهم إنك أطعمت وسقيت وأغنيت وأقنيت وهديت واجتبيت اللهم فلك الحمد على ما أعطيت»","صحيح","Sahih al-Jami al-Saghir 4768","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4769","«كان إذا قفل من غزو أو حج أو عمرة يكبر على كل شرف من الأرض - ثلاث تكبيرات - ثم يقول: لا إله إلا الله وحده لا شريك له له الملك وله الحمد وهو على كل شيء قدير آيبون تائبون عابدون ساجدون لربنا حامدون صدق الله وعده ونصر عبده وهزم الأحزاب وحده»","صحيح","Sahih al-Jami al-Saghir 4769","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4770","«كان إذا كان الرطب لم يفطر إلا على الرطب وإذ لم يكن الرطب لم يفطر إلا على التمر»","صحيح","Sahih al-Jami al-Saghir 4770","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4771","«كان إذا كان راكعا أو ساجدا قال: سبحانك وبحمدك أستغفرك وأتوب إليك»","حسن","Sahih al-Jami al-Saghir 4771","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4772","«كان إذا كان صائما أمر رجلا فأوفى على شيء فإذا قال غابت الشمس أفطر»","","Sahih al-Jami al-Saghir 4772","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4773","«كان إذا كان في وتر من صلاته لم ينهض حتى يستوي قاعدا»","صحيح","Sahih al-Jami al-Saghir 4773","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4774","«كان إذا كان قبل التروية بيوم خطب الناس فأخبرهم بمناسكهم»","صحيح","Sahih al-Jami al-Saghir 4774","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4775","«كان إذا كان مقيما اعتكف العشر الأواخر من رمضان وإذا سافر اعتكف من العام المقبل عشرين»","صحيح","Sahih al-Jami al-Saghir 4775","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4776","«كان إذا كان يوم عيد خالف الطريق»","صحيح","Sahih al-Jami al-Saghir 4776","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4777","«كان إذا كربه أمر قال: يا حي يا قيوم برحمتك أستغيث»","حسن","Sahih al-Jami al-Saghir 4777","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4778","«كان إذا كره شيئا رؤي ذلك في وجهه»","صحيح","Sahih al-Jami al-Saghir 4778","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4779","«كان إذا لبس قميصا بدأ بميامنه»","صحيح","Sahih al-Jami al-Saghir 4779","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4780","«كان إذا لقيه أحد من أصحابه فقام معه قام معه فلم ينصرف حتى يكون الرجل هوالذي ينصرف عنه وإذا لقيه أحد من أصحابه فتنأول يده نأوله إياها فلم ينزع يده منه حتى يكون الرجل هوالذي ينزع يده منه وإذا لقي أحدا من أصحابه فتنأول أذنه نأوله إياها ثم لم ينزعها حتى يكون الرجل هوالذي ينزعها عنه»","حسن","Sahih al-Jami al-Saghir 4780","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4781","«كان إذا لقيه الرجل من أصحابه مسحه ودعا له»","صحيح","Sahih al-Jami al-Saghir 4781","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4782","«كان إذا مر بآية خوف تعوذ وإذا مر بآية رحمة سأل وإذا مر بآية فيها تنزيه الله سبح»","صحيح","Sahih al-Jami al-Saghir 4782","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4783","«كان إذا مرض أحد من أهل بيته نفث عليه بالمعوذات»","صحيح","Sahih al-Jami al-Saghir 4783","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4784","«كان إذا مشى أقلع»","صحيح","Sahih al-Jami al-Saghir 4784","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4785","«كان إذا مشى كأنه يتوكأ»","صحيح","Sahih al-Jami al-Saghir 4785","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4786","«كان إذا مشى لم يلتفت»","صحيح","Sahih al-Jami al-Saghir 4786","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4787","[كان إذا مشى مشى أصحابه أمامه وتركوا ظهره للملائكة]","صحيح","Sahih al-Jami al-Saghir 4787","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4788","«كان إذا نام من الليل أو مرض صلى من النهار اثنتي عشرة ركعة»","صحيح","Sahih al-Jami al-Saghir 4788","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4789","«كان إذا نام نفخ»","صحيح","Sahih al-Jami al-Saghir 4789","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4790","«كان إذا نام وضع يده اليمنى تحت خده وقال: اللهم قني عذابك يوم تبعث عبادك»","صحيح","Sahih al-Jami al-Saghir 4790","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4791","«كان إذا نزل به هم أو غم قال: يا حي يا قيوم برحمتك أستغيث»","حسن","Sahih al-Jami al-Saghir 4791","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4792","""كان إذا نزل عليه الوحي ثقل لذلك وتحدر جبينه عرقا كأنه جمان وإن كان في البرد","صحيح","Sahih al-Jami al-Saghir 4792","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4793","«كان إذا نزل منزلا لم يرتحل حتى يصلي الظهر»","صحيح","Sahih al-Jami al-Saghir 4793","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4794","«كان إذا واقع بعض أهله فكسل أن يقوم ضرب يده على الحائط فتيمم»","صحيح","Sahih al-Jami al-Saghir 4794","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4795","«كان إذا ودع رجلا أخذ بيده فلا يدعها حتى يكون الرجل هوالذي يدع يده ويقول: أستودع الله دينك وأمانتك وخواتيم عملك»","صحيح","Sahih al-Jami al-Saghir 4795","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4796","«كان إذا وضع الميت في لحده قال: بسم الله وبالله وفي سبيل الله وعلى ملة رسول الله»","صحيح","Sahih al-Jami al-Saghir 4796","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4797","«كان أرحم الناس بالصبيان والعيال»","صحيح","Sahih al-Jami al-Saghir 4797","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4798","«كان أزهر اللون كأن عرقه اللؤلؤ إذا مشى تكفأ»","صحيح","Sahih al-Jami al-Saghir 4798","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4799","«كان أشد حياء من العذراء في خدرها»","صحيح","Sahih al-Jami al-Saghir 4799","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4800","«كان أكثر أيمانه:» لا ومصرف القلوب ""","صحيح","Sahih al-Jami al-Saghir 4800","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4801","«كان أكثر دعائه: يا مقلب القلوب ثبت قلبي على دينك» فقيل له في ذلك؟ قال: [إنه ليس آدمي إلا وقلبه بين إصبعين من أصابع الله فمن شاء أقام ومن شاء أزاغ]","صحيح","Sahih al-Jami al-Saghir 4801","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4802",""" كان أكثر دعوة يدعوبها: {رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ}","صحيح","Sahih al-Jami al-Saghir 4802","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4803","«كان أكثر صومه السبت والأحد ويقول: هما يوما عيد المشركين فأحب أن أخالفهم»","حسن","Sahih al-Jami al-Saghir 4803","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4804","«كان أكثر ما يصوم الاثنين والخميس فقيل له؟ فقال: الأعمال تعرض كل اثنين وخميس فيغفر لكل مسلم إلا المتهاجرين فيقول: أخروهما»","صحيح","Sahih al-Jami al-Saghir 4804","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4805","«كان بابه يقرع بالأظافير»","صحيح","Sahih al-Jami al-Saghir 4805","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4806","«كان تنام عيناه ولا ينام قلبه»","صحيح","Sahih al-Jami al-Saghir 4806","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4807","«كان خاتم النبوة في ظهره بضعة ناشزة»","صحيح","Sahih al-Jami al-Saghir 4807","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4808","«كان خاتمه غدة حمراء مثل بيضة الحمامة»","صحيح","Sahih al-Jami al-Saghir 4808","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4809","«كان خاتمه من فضة فصه منه»","صحيح","Sahih al-Jami al-Saghir 4809","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4810","«كان خاتمه من ورق وكان فصه حبشيا»","صحيح","Sahih al-Jami al-Saghir 4810","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4811","«كان خلقه القرآن»","صحيح","Sahih al-Jami al-Saghir 4811","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4812","«كان رايته سوداء ولواؤه أبيض»","حسن","Sahih al-Jami al-Saghir 4812","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4813","«كان ربعة من القوم ليس بالطويل البائن ولا بالقصير أزهر اللون ليس بالأبيض الأمهق ولا بالآدم وليس بالجعد القطط ولا بالسبط»","صحيح","Sahih al-Jami al-Saghir 4813","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4814","«كان رحيما بالعيال»","صحيح","Sahih al-Jami al-Saghir 4814","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4815","«كان رحيما وكان لا يأتيه أحد إلا وعده وأنجز له إن كان عنده»","حسن","Sahih al-Jami al-Saghir 4815","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4816","«كان شبح الذراعين بعيد ما بين المنكبين أهدب أشفار العينين»","حسن","Sahih al-Jami al-Saghir 4816","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4817","«كان شعره دون الجمة وفوق الوفرة»","صحيح","Sahih al-Jami al-Saghir 4817","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4818","«كان شيبه نحوعشرين شعرة»","صحيح","Sahih al-Jami al-Saghir 4818","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4819","«كان ضخم الرأس واليدين والقدمين»","صحيح","Sahih al-Jami al-Saghir 4819","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4820","«كان ضخم الهامة عظيم اللحية»","حسن","Sahih al-Jami al-Saghir 4820","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4821","«كان ضليع الفم أشكل العينين منهوس العقب»","صحيح","Sahih al-Jami al-Saghir 4821","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4822","«كان طويل الصمت قليل الضحك»","حسن","Sahih al-Jami al-Saghir 4822","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4823","«كان في كلامه ترتيل أو ترسيل»","حسن","Sahih al-Jami al-Saghir 4823","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4824","«كان كثير العرق»","صحيح","Sahih al-Jami al-Saghir 4824","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4825","«كان كثير شعر اللحية»","صحيح","Sahih al-Jami al-Saghir 4825","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4826","«كان كلامه كلاما فصلا يفهمه كل من سمعه»","حسن","Sahih al-Jami al-Saghir 4826","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4827","«كان لنعله قبالان»","صحيح","Sahih al-Jami al-Saghir 4827","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4828","«كان له جفنة لها أربع حلق»","صحيح","Sahih al-Jami al-Saghir 4828","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4829","«كان له حمار اسمه عفير»","صحيح","Sahih al-Jami al-Saghir 4829","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4830","«كان له خرقة يتنشف بها بعد الوضوء»","حسن","Sahih al-Jami al-Saghir 4830","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4831","«كان له سكة يتطيب منها»","صحيح","Sahih al-Jami al-Saghir 4831","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4832","«كان له قدح من عيدان تحت سريره يبول فيه بالليل»","صحيح","Sahih al-Jami al-Saghir 4832","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4833","«كان له قصعة يقال لها الغراء يحملها أربعة رجال»","صحيح","Sahih al-Jami al-Saghir 4833","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4834","«كان له مؤذنان: بلال وابن أم مكتوم الأعمى»","صحيح","Sahih al-Jami al-Saghir 4834","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4835","""كان له ملحفة مصبوغة بالورس والزعفران يدور بها على نسائه فإذا كانت ليلة هذه رشتها بالماء وإذا كانت ليلة هذه رشتها بالماء وإذا كانت ليلة هذه رشتها بالماء""","صحيح","Sahih al-Jami al-Saghir 4835","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4836","«كان مما يقول للخادم: ألك حاجة؟»","صحيح","Sahih al-Jami al-Saghir 4836","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4837","«كان وجهه مثل الشمس والقمر وكان مستديرا»","صحيح","Sahih al-Jami al-Saghir 4837","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4838","«كان وسادته التي ينام عليها بالليل من أدم حشوها ليف»","صحيح","Sahih al-Jami al-Saghir 4838","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4839","«كان لا يؤذن له في العيدين»","صحيح","Sahih al-Jami al-Saghir 4839","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4840","«كان لا يأكل متكئا ولا يطأ عقبه رجلان»","صحيح","Sahih al-Jami al-Saghir 4840","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4841","«كان لا يتطير ولكن يتفاءل»","صحيح","Sahih al-Jami al-Saghir 4841","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4842","«كان لا يتعار من الليل إلا أجرى السواك على فيه»","حسن","Sahih al-Jami al-Saghir 4842","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4843","«كان لا يتوضأ بعد الغسل»","حسن","Sahih al-Jami al-Saghir 4843","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4844","«كان لا يجد من الدقل ما يملأ بطنه»","صحيح","Sahih al-Jami al-Saghir 4844","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4845","«كان لا يخرج يوم الفطر حتى يطعم ولا يطعم يوم النحر حتى يذبح»","صحيح","Sahih al-Jami al-Saghir 4845","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4846","«كان لا يدخر شيئا لغد»","صحيح","Sahih al-Jami al-Saghir 4846","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4847","«كان لا يدع أربعا قبل الظهر وركعتين قبل الغداة»","صحيح","Sahih al-Jami al-Saghir 4847","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4848","«كان لا يدع صوم أيام البيض في سفر ولا حضر»","صحيح","Sahih al-Jami al-Saghir 4848","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4849","«كان لا يدع قيام الليل وكان إذا مرض أو كسل صلى قاعدا»","صحيح","Sahih al-Jami al-Saghir 4849","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4850","«كان لا يدفع عنه الناس ولا يضربوا عنه»","صحيح","Sahih al-Jami al-Saghir 4850","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4851","«كان لا يراجع بعد ثلاث»","صحيح","Sahih al-Jami al-Saghir 4851","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4852","«كان لا يرد الطيب»","صحيح","Sahih al-Jami al-Saghir 4852","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4853","«كان لا يرقد من ليل فيستيقظ إلا تسوك»","حسن","Sahih al-Jami al-Saghir 4853","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4854","«كان لا يسأل شيئا إلا أعطاه أو سكت»","صحيح","Sahih al-Jami al-Saghir 4854","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4855","«كان لا يستلم إلا الحجر والركن اليماني»","صحيح","Sahih al-Jami al-Saghir 4855","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4856","«كان لا يصافح النساء في البيعة»","حسن","Sahih al-Jami al-Saghir 4856","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4857","«كان لا يصلي الركعتين بعد الجمعة ولا الركعتين بعد المغرب إلا في أهله»","صحيح","Sahih al-Jami al-Saghir 4857","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4858","«كان لا يصلي المغرب حتى يفطر ولو على شربة من الماء»","صحيح","Sahih al-Jami al-Saghir 4858","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4859","«كان لا يصلي قبل العيد شيئا فإذا رجع إلى منزله صلى ركعتين»","حسن","Sahih al-Jami al-Saghir 4859","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4860","«كان لا يصيبه قرحة ولا شوكة إلا وضع عليها الحناء»","حسن","Sahih al-Jami al-Saghir 4860","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4861","«كان لا يضحك إلا تبسما»","صحيح","Sahih al-Jami al-Saghir 4861","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4862","«كان لا يطرق أهله ليلا»","صحيح","Sahih al-Jami al-Saghir 4862","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4863","«كان لا يطيل الموعظة يوم الجمعة»","صحيح","Sahih al-Jami al-Saghir 4863","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4864","""كان لا يعرف فصل السورة حتى ينزل عليه {بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ}","صحيح","Sahih al-Jami al-Saghir 4864","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4865","«كان لا يغدويوم الفطر حتى يأكل....تمرات»","صحيح","Sahih al-Jami al-Saghir 4865","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4866","«كان لا يقرأ القرآن في أقل من ثلاث»","صحيح","Sahih al-Jami al-Saghir 4866","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4867","«كان لا يقوم من مجلس إلا قال: سبحانك اللهم ربي وبحمدك لا إله إلا أنت أستغفرك وأتوب إليك وقال: لا يقولهن أحد حيث يقوم من مجلسه إلا غفر له ما كان منه في ذلك المجلس»","صحيح","Sahih al-Jami al-Saghir 4867","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4868","«كان لا يكاد يسأل شيئا إلا فعله»","صحيح","Sahih al-Jami al-Saghir 4868","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4869","«كان لا يكاد يقول لشيء لا فإذا هوسئل فأراد أن يفعل قال: نعم وإذا لم يرد أن يفعل سكت»","صحيح","Sahih al-Jami al-Saghir 4869","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4870","«كان لا يلتفت وراءه إذا مشى، ... ...»","صحيح","Sahih al-Jami al-Saghir 4870","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4871","«كان لا يمنع شيئا يسأله»","صحيح","Sahih al-Jami al-Saghir 4871","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4872","«كان لا ينام إلا والسواك عند رأسه فإذا استيقظ بدأ بالسواك»","حسن","Sahih al-Jami al-Saghir 4872","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4873","""كان لا ينام حتى يقرأ {الم، تَنْزِيلُ} السجدة و {تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ}","صحيح","Sahih al-Jami al-Saghir 4873","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4874","«كان لا ينام حتى يقرأ بني إسرائيل والزمر»","صحيح","Sahih al-Jami al-Saghir 4874","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4875","«كان يؤتى بالتمر فيه دود فيفتشه يخرج السوس منه»","صحيح","Sahih al-Jami al-Saghir 4875","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4876","«كان يؤتى بالصبيان فيبرك عليهم ويحنكهم ويدعولهم»","صحيح","Sahih al-Jami al-Saghir 4876","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4877","«كان يأتي ضعفاء المسلمين ويزورهم ويعود مرضاهم ويشهد جنائزهم»","صحيح","Sahih al-Jami al-Saghir 4877","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4878","«كان يأكل البطيخ بالرطب»","صحيح","Sahih al-Jami al-Saghir 4878","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4879","«كان يأكل البطيخ بالرطب ويقول: يكسر حر هذا ببرد هذا وبرد هذا بحر هذا»","صحيح","Sahih al-Jami al-Saghir 4879","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4880","«كان يأكل القثاء بالرطب»","صحيح","Sahih al-Jami al-Saghir 4880","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4881","«كان يأكل الهدية ولا يأكل الصدقة»","صحيح","Sahih al-Jami al-Saghir 4881","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4882","«كان يأكل بثلاث أصابع ويلعق يده قبل أن يمسحها»","صحيح","Sahih al-Jami al-Saghir 4882","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4883","«كان يأكل مما مست النار ثم يصلي ولا يتوضأ»","صحيح","Sahih al-Jami al-Saghir 4883","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4884","«كان يأمر أن نسترقي من العين»","صحيح","Sahih al-Jami al-Saghir 4884","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4885","«كان يأمر بإخراج الزكاة قبل الغدو للصلاة يوم الفطر»","صحيح","Sahih al-Jami al-Saghir 4885","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4886","«كان يأمر بالعتاقة في صلاة الكسوف»","صحيح","Sahih al-Jami al-Saghir 4886","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4887","«كان يأمر بتغيير الشعر مخالفة للأعاجم»","حسن","Sahih al-Jami al-Saghir 4887","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4888","«كان يأمر بناته ونساءه أن يخرجن في العيدين»","صحيح","Sahih al-Jami al-Saghir 4888","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4889","«كان يأمر من أسلم أن يختتن.... ... »","صحيح","Sahih al-Jami al-Saghir 4889","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4890","«كان يأمر....إذا أرادت إحداهن أن تنام أن تحمد ثلاثا وثلاثين وتسبح ثلاثا وثلاثين وتكبر ثلاثا وثلاثين»","صحيح","Sahih al-Jami al-Saghir 4890","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4891","«كان يباشر نساءه فوق الإزار وهن حيض»","صحيح","Sahih al-Jami al-Saghir 4891","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4892","«كان يبدأ إذا أفطر بالتمر»","صحيح","Sahih al-Jami al-Saghir 4892","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4893","«كان يبدوإلى التلاع»","صحيح","Sahih al-Jami al-Saghir 4893","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4894","«كان يبعث إلى المطاهر فيؤتى بالماء فيشربه يرجو بركة أيدي المسلمين»","حسن","Sahih al-Jami al-Saghir 4894","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4895","«كان يبيت الليالي المتتابعة طأويا وأهله لا يجدون عشاء وكان أكثر خبزهم خبز الشعير»","حسن","Sahih al-Jami al-Saghir 4895","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4896","«كان يبيع نخل بني النضير ويحبس لأهله قوت سنتهم»","صحيح","Sahih al-Jami al-Saghir 4896","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4897","«كان يتحرى صيام الاثنين والخميس»","صحيح","Sahih al-Jami al-Saghir 4897","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4898","«كان يتختم بالفضة»","صحيح","Sahih al-Jami al-Saghir 4898","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4899","«كان يتختم في يساره»","صحيح","Sahih al-Jami al-Saghir 4899","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4900","«كان يتختم في يمينه»","صحيح","Sahih al-Jami al-Saghir 4900","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4901","«كان يتخلف في المسير فيزجي الضعيف ويردف ويدعولهم»","صحيح","Sahih al-Jami al-Saghir 4901","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4902","«كان يتعوذ من الجان وعين الإنسان حتى نزلت المعوذتان فلما نزلتا أخذ بهما وترك ما سواهما»","صحيح","Sahih al-Jami al-Saghir 4902","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4903","«كان يتعوذ من جهد البلاء ودرك الشقاء وسوء القضاء وشماتة الأعداء»","صحيح","Sahih al-Jami al-Saghir 4903","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4904","«كان يتفاءل ولا يتطير وكان يحب الاسم الحسن»","صحيح","Sahih al-Jami al-Saghir 4904","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4905","""كان يتمثل بالشعر: ويأتيك بالأخبار من لم تزود""","صحيح","Sahih al-Jami al-Saghir 4905","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4906","«كان يتوضأ ثم يقبل ويصلي ولا يتوضأ»","صحيح","Sahih al-Jami al-Saghir 4906","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4907","«كان يتوضأ عند كل صلاة»","صحيح","Sahih al-Jami al-Saghir 4907","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4908","«كان يتوضأ مما مست النار»","صحيح","Sahih al-Jami al-Saghir 4908","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4909","«كان يتوضأ واحدة واحدة واثنتين اثنتين وثلاثا ثلاثا كل ذلك يفعل»","صحيح","Sahih al-Jami al-Saghir 4909","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4910","«كان يجتهد في العشر الأواخر ما لا يجتهد في غيرها»","صحيح","Sahih al-Jami al-Saghir 4910","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4911","«كان يجعل فصه مما يلي كفه»","صحيح","Sahih al-Jami al-Saghir 4911","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4912","«كان يجعل يمينه لأكله وشربه ووضوئه وثيابه وأخذه وعطائه وشماله لما سوى ذلك»","صحيح","Sahih al-Jami al-Saghir 4912","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4913","«كان يجلس إذا صعد المنبر حتى يفرغ المؤذن ثم يقوم فيخطب ثم يجلس فلا يتكلم ثم يقوم فيخطب»","صحيح","Sahih al-Jami al-Saghir 4913","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4914","«كان يجلس القرفصاء»","حسن","Sahih al-Jami al-Saghir 4914","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4915","«كان يجلس على الأرض ويأكل على الأرض ويعتقل الشاة ويجيب دعوة المملوك على خبز الشعير»","صحيح","Sahih al-Jami al-Saghir 4915","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4916","«كان يجمع بين الخربز والرطب»","صحيح","Sahih al-Jami al-Saghir 4916","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4917","«كان يجمع بين الظهر والعصر والمغرب والعشاء في السفر»","صحيح","Sahih al-Jami al-Saghir 4917","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4918","«كان يحب التيامن ما استطاع في طهوره وتنعله وترجله وفي شأنه كله»","صحيح","Sahih al-Jami al-Saghir 4918","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4919","«كان يحب الحلواء والعسل»","صحيح","Sahih al-Jami al-Saghir 4919","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4920","«كان يحب الدباء»","صحيح","Sahih al-Jami al-Saghir 4920","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4921","«كان يحب الزبد والتمر»","صحيح","Sahih al-Jami al-Saghir 4921","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4922","«كان يحب العراجين ولا يزال في يده منها»","صحيح","Sahih al-Jami al-Saghir 4922","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4923","«كان يحب أن يخرج إذا غزا يوم الخميس»","صحيح","Sahih al-Jami al-Saghir 4923","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4924","«كان يحب أن يليه المهاجرون والأنصار في الصلاة ليحفظوا عنه»","صحيح","Sahih al-Jami al-Saghir 4924","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4925","«كان يحتجم»","صحيح","Sahih al-Jami al-Saghir 4925","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4926","«كان يحتجم على هامته وبين كتفيه ويقول: من أهراق من هذه الدماء فلا يضره أن لا يتدأوى بشيء لشيء»","صحيح","Sahih al-Jami al-Saghir 4926","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4927","«كان يحتجم في الأخدعين والكاهل وكان يحتجم لسبع عشرة وتسع عشرة وإحدى وعشرين»","حسن","Sahih al-Jami al-Saghir 4927","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4928","«كان يحتجم في رأسه ويسميها أم مغيث»","حسن","Sahih al-Jami al-Saghir 4928","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4929","«كان يحدث حديثا لو عده العاد لأحصاه»","صحيح","Sahih al-Jami al-Saghir 4929","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4930","«كان يحلف: لا ومقلب القلوب»","صحيح","Sahih al-Jami al-Saghir 4930","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4931","«كان يحمل ماء زمزم»","صحيح","Sahih al-Jami al-Saghir 4931","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4932","«كان يخرج إلى العيد ماشيا ويرجع ماشيا»","صحيح","Sahih al-Jami al-Saghir 4932","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4933","«كان يخرج إلى العيدين ماشيا ويصلي بغير أذان ولا إقامة ثم يرجع ماشيا في طريق آخر»","صحيح","Sahih al-Jami al-Saghir 4933","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4934","«كان يخرج في العيدين رافعا صوته بالتهليل والتكبير»","حسن","Sahih al-Jami al-Saghir 4934","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4935","«كان يخطب ب» ق [كل جمعة]","صحيح","Sahih al-Jami al-Saghir 4935","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4936","«كان يخطب قائما ويجلس بين الخطبتين ويقرأ آيات ويذكر الناس»","صحيح","Sahih al-Jami al-Saghir 4936","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4937","«كان يخيط ثوبه ويخصف نعله ويعمل ما يعمل الرجال في بيوتهم»","صحيح","Sahih al-Jami al-Saghir 4937","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4938","«كان يدركه الفجر وهو جنب من أهله ثم يغتسل ويصوم»","صحيح","Sahih al-Jami al-Saghir 4938","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4939","«كان يدعى إلى خبز الشعير والإهالة السنخة»","صحيح","Sahih al-Jami al-Saghir 4939","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4940","«كان يدعو عند الكرب: لا إله إلا الله العظيم الحليم لا إله إلا الله رب العرش العظيم لا إله إلا الله رب السموات السبع ورب الأرض ورب العرش الكريم»","صحيح","Sahih al-Jami al-Saghir 4940","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4941","«كان يدور على نسائه في الساعة الواحدة من الليل والنهار»","صحيح","Sahih al-Jami al-Saghir 4941","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4942","«كان يذبح أضحيته بيده»","صحيح","Sahih al-Jami al-Saghir 4942","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4943","«كان يذكر الله تعالى على كل أحيانه»","صحيح","Sahih al-Jami al-Saghir 4943","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4944","«كان يرخي الإزار من بين يديه ويرفعه من ورائه»","صحيح","Sahih al-Jami al-Saghir 4944","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4945","«كان يردف خلفه ويضع طعامه على الأرض ويجيب دعوة المملوك ويركب الحمار»","صحيح","Sahih al-Jami al-Saghir 4945","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4946","«كان يركب الحمار ويخصف النعل ويرفع القميص ويلبس الصوف ويقول:» من رغب عن سنتي فليس مني""","حسن","Sahih al-Jami al-Saghir 4946","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4947","«كان يزور الأنصار ويسلم على صبيانهم ويمسح رءوسهم»","صحيح","Sahih al-Jami al-Saghir 4947","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4948","«كان يستجمر بألوة غير مطراة وبكافور يطرحه مع الألوة»","صحيح","Sahih al-Jami al-Saghir 4948","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4949","«كان يستحب الجوامع من الدعاء ويدع ما سوى ذلك»","صحيح","Sahih al-Jami al-Saghir 4949","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4950","«كان يستحب أن يسافر يوم الخميس»","صحيح","Sahih al-Jami al-Saghir 4950","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4951","«كان يستعذب له الماء من بيوت السقيا; وفي لفظ: يستسقى له الماء العذب من بئر السقيا»","صحيح","Sahih al-Jami al-Saghir 4951","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4952","«كان يستغفر للصف المقدم ثلاثا وللثاني مرة»","صحيح","Sahih al-Jami al-Saghir 4952","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4953","«كان يسلت المني من ثوبه بعرق الإذخر ثم يصلي فيه ويحته من ثوبه يابسا ثم يصلي فيه»","حسن","Sahih al-Jami al-Saghir 4953","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4954","«كان يسمي الأنثى من الخيل فرسا»","صحيح","Sahih al-Jami al-Saghir 4954","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4955","«كان يشتد عليه أن يوجد منه الريح»","صحيح","Sahih al-Jami al-Saghir 4955","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4956","«كان يشرب ثلاثة أنفاس يسمي الله في أوله ويحمد الله في آخره»","صحيح","Sahih al-Jami al-Saghir 4956","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4957","«كان يشير في الصلاة»","صحيح","Sahih al-Jami al-Saghir 4957","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4958","«كان يصغي للهرة الإناء فتشرب ثم يتوضأ بفضلها»","صحيح","Sahih al-Jami al-Saghir 4958","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4959","«كان يصلي الضحى أربعا ويزيد ما شاء الله»","صحيح","Sahih al-Jami al-Saghir 4959","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4960","«كان يصلي الضحى ست ركعات»","صحيح","Sahih al-Jami al-Saghir 4960","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4961","«كان يصلي بالليل ركعتين ركعتين ثم ينصرف فيستاك»","صحيح","Sahih al-Jami al-Saghir 4961","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4962","«كان يصلي بين المغرب والعشاء»","صحيح","Sahih al-Jami al-Saghir 4962","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
"4963","«كان يصلي على الخمرة»","صحيح","Sahih al-Jami al-Saghir 4963","","","الأحاديث المبدوءة بحرف الكاف Hadith Beginning with the Letter Kaf (ك)"
