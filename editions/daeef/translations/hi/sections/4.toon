"739","[AI-translation] ((जब नातमाम बच्चा पैदाइश पर चीख़े तो उसकी नमाज़-ए-जनाज़ा पढ़ी जाएगी और वह वारिस भी बनाया जाएगा))।"
"740","[AI-translation] ((आख़िरी [जनाज़े की] तकबीरें जो नबी-ए-करीम (सल्लल्लाहु अलैहि वसल्लम) ने कहीं वे चार थीं))।"
"741","[AI-translation] ((फ़रिश्तों ने हज़रत आदम (अलैहिस्सलाम) की नमाज़-ए-जनाज़ा पढ़ी और चार तकबीरें कहीं))।"
"742","[AI-translation] ((हमें अपने मुर्दों पर सूरत-ए-फ़ातिहा पढ़ने का हुक्म दिया गया है))।"
"743","[AI-translation] ((जो मस्जिद में नमाज़-ए-जनाज़ा पढ़े, उसके लिए कुछ [सवाब] नहीं))।"
"744","[AI-translation] ((जो डूबकर मरे उसे एक दिन-रात छोड़ दिया जाए, फिर दफ़न किया जाए))।"
"745","[AI-translation] ((अपने मुर्दों को नेक लोगों में दफ़न करो, क्योंकि मुर्दा भी बुरे पड़ोसी से तकलीफ़ पाता है जैसे ज़िन्दा बुरे पड़ोसी से तकलीफ़ पाता है))।"
"746","[AI-translation] ((हर घर का एक दरवाज़ा है, और क़ब्र का दरवाज़ा उसके पैरों की तरफ़ है))।"
"747","[AI-translation] ((औरत के दो पर्दे हैं: क़ब्र और उसका शौहर))।"
"748","[AI-translation] ((क़ब्र का अज़ाब हक़ है, और जो इस पर ईमान न लाए उसे इसमें अज़ाब दिया जाएगा))।"
"749","[AI-translation] ((नबी-ए-करीम (सल्लल्लाहु अलैहि वसल्लम) की क़ब्र पर पानी छिड़का गया। बिलाल (रज़ियल्लाहु अन्हु) ने नबी (सल्लल्लाहु अलैहि वसल्लम) की क़ब्र पर मशकीज़े से पानी छिड़का। उन्होंने सिर की तरफ़ से छिड़कना शुरू किया और पैरों की तरफ़ तक पानी छिड़कते रहे))।"
"750","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने अपने बेटे इब्राहीम की क़ब्र पर पानी छिड़का और उस पर कंकड़ियाँ रखीं))।"
"751","[AI-translation] ((क़ब्रों में मेरी उम्मत का लम्बा ठहरना उनके गुनाहों की सफ़ाई का ज़रिया है))।"
"752","[AI-translation] ((जो मुसीबतज़दा को तसल्ली दे उसे मुसीबतज़दा जैसा सवाब मिलेगा))।"
"753","[AI-translation] ((अपने भाई की मुसीबत पर ख़ुशी न मना; अल्लाह तआला उस पर रहम करेगा और तुझे आज़माइश में डालेगा))।"
"754","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने क़ब्रों की ज़ियारत करने वाली औरतों पर लानत की))।"
"755","[AI-translation] ((जो अपनी माँ की क़ब्र की ज़ियारत करे, गोया उसने उमरा किया))।"
"756","[AI-translation] ((जो मुर्दों को सलाम करे, वे क़ियामत के दिन उसे जवाब देंगे))।"
"757","[AI-translation] ((मुर्दे की हड्डी तोड़ने का गुनाह ज़िन्दा की हड्डी तोड़ने जैसा है))।"
"758","[AI-translation] (([जब अबू रज़ीन ने पूछा तो रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने उन्हें लोगों की क़ब्रों के पास से गुज़रते वक़्त पढ़ने की यह दुआ «السلام عليكم يا اهل القبور» सिखाई: ऐ क़ब्रों वालो तुम पर सलाम हो! तो उन्होंने कहा: ऐ अल्लाह के रसूल! क्या वे सुनते हैं? नबी (सल्लल्लाहु अलैहि वसल्लम) ने जवाब दिया: वे सुनते हैं, लेकिन उनके पास जवाब देने की ताक़त नहीं]))।"
"759","[AI-translation] ((बेशक अल्लाह तआला ज़मीन वालों की दुआ की वजह से क़ब्रों वालों पर पहाड़ों जैसी रहमतें उतारता है))।"
"760","[AI-translation] ((जो ग़ुर्बत के डर से शादी न करे वह हममें से नहीं))।"
"761","[AI-translation] ((जिसमें शादी की ताक़त हो और वह शादी न करे, उसका मुझसे कोई ताल्लुक़ नहीं))।"
"762","[AI-translation] ((दीन के मामलात में बेहतरीन मददगार और साथी नेक बीवी है))।"
"763","[AI-translation] ((अल्लाह के ख़ौफ़ के बाद मोमिन मर्द के लिए बेहतरीन फ़ायदा नेक बीवी है))।"
"764","[AI-translation] ((क्या मैं तुम्हें मर्द के बेहतरीन ख़ज़ाने के बारे में न बताऊँ? [और वह है] नेक बीवी))।"
"765","[AI-translation] ((तुम्हारे कुँवारे सबसे बुरे हैं))।"
"766","[AI-translation] ((अगर मेरी ज़िन्दगी का एक दिन भी बाक़ी रहे, फिर भी अल्लाह तआला के लिए अपनी बीवी से मिलूँगा [अबू हुरैरा (रज़ियल्लाहु अन्हु)]))।"
"767","[AI-translation] ((शादीशुदा की दो रकअतें कुँवारे की सत्तर रकअतों से अफ़ज़ल हैं))।"
"768","[AI-translation] ((कुँवारा जहन्नम की आग की ज़मानत है))।"
"769","[AI-translation] ((एक देहाती ने रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) से शहवत और भूख की शिकायत की, तो आप (सल्लल्लाहु अलैहि वसल्लम) ने उसे हुक्म दिया: पहली बे-शौहर औरत से शादी कर जो तुझे मिले))।"
"770","[AI-translation] ((जब तुममें से कोई किसी औरत से शादी चाहे, जैसे वह उसके चेहरे के बारे में पूछे, वैसे ही उसके बालों के बारे में भी पूछे, क्योंकि बाल भी जमाल की जगह हैं))।"
"771","[AI-translation] ((अरब एक-दूसरे के हम-पल्ला हैं))।"
"772","[AI-translation] ((जो पाकीज़गी की हालत में अल्लाह से मिलना चाहे वह आज़ाद औरतों से शादी करे))।"
"773","[AI-translation] ((आज़ाद औरतें घर की इस्लाह का ज़रिया हैं, और लौंडियाँ घर की बर्बादी का ज़रिया हैं))।"
"774","[AI-translation] ((जो अपनी बेटी की शादी गुनाहगार [बदकार, नाफ़रमान] से करे, उसने यक़ीनन उससे ताल्लुक़ तोड़ लिया))।"
"775","[AI-translation] ((औरतों से सिर्फ़ रिश्तेदारी की बुनियाद पर शादी न करो, क्योंकि यही चीज़ [बाद में] ताल्लुक़ात तोड़ने का सबब बनती है))।"
"776","[AI-translation] ((जो किसी औरत से उसकी इज़्ज़त के लिए शादी करे, अल्लाह उसे सिर्फ़ ज़िल्लत में बढ़ाएगा; जो उसके माल के लिए शादी करे, अल्लाह उसे सिर्फ़ ग़ुर्बत में बढ़ाएगा; जो उसके हुस्न के लिए शादी करे, अल्लाह उसे सिर्फ़ पस्ती में बढ़ाएगा; और जो निगाह नीची रखने, शर्मगाह की हिफ़ाज़त या रिश्तेदारी जोड़ने के लिए शादी करे, अल्लाह उसके लिए औरत में और औरत के लिए उसमें बरकत रखेगा))।"
"777","[AI-translation] ((औरतों से उनके हुस्न के लिए शादी न करो, क्योंकि मुमकिन है उनका हुस्न उन्हें हलाकत में डाले, और उनसे उनके माल के लिए शादी न करो, क्योंकि मुमकिन है उनका माल उन्हें सरकश बनाए। बल्कि उनसे दीन की बुनियाद पर शादी करो, और बेशक नाक छिदी-कटी दीनदार काली लौंडी बे-दीन ख़ूबसूरत मालदार औरत से बेहतर है))।"
"778","[AI-translation] ((बेवक़ूफ़ औरत से शादी न करो, क्योंकि उसकी सोहबत आज़माइश है और उसकी औलाद में नुक़सान है))।"
"779","[AI-translation] ((अपनी नस्ल के लिए [औरतें] समझदारी से चुनो, क्योंकि औरतें ऐसे बच्चे जनती हैं जो उनके भाई-बहनों से मिलते हैं))।"
"780","[AI-translation] ((औरतों से उनकी बेटियों के बारे में मशवरा करो [क्योंकि वे अपनी बेटियों की ज़हनी और अख़लाक़ी हालत बेहतर जानती हैं, इसलिए वे बता सकती हैं कि तुम्हारा उनके साथ निभेगा या नहीं]))।"
"781","[AI-translation] ((उम्मे सलमा और मैमूना (रज़ियल्लाहु अन्हुमा) नबी (सल्लल्लाहु अलैहि वसल्लम) के पास थीं जब अचानक इब्ने उम्मे मक्तूम (रज़ियल्लाहु अन्हु) आए। इस पर नबी (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: तुम दोनों उनसे पर्दा करो। उम्मे सलमा (रज़ियल्लाहु अन्हा) ने कहा: ऐ अल्लाह के रसूल! यह शख़्स नाबीना है; वह हमें नहीं देख सकता। तो नबी (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: क्या तुम दोनों भी नाबीना हो? क्या तुम उसे नहीं देखतीं?))।"
"782","[AI-translation] ((इस्लाम की पहली मुहब्बत नबी-ए-मुहम्मद (सल्लल्लाहु अलैहि वसल्लम) की आइशा (रज़ियल्लाहु अन्हा) से मुहब्बत है))।"
"783","[AI-translation] ((महर दस दिरहम से कम नहीं))।"
"784","[AI-translation] ((तुममें बेहतरीन औरत वह है जिसका महर आसान हो [यानी कम होने की वजह से अदा करना आसान हो]))।"
"785","[AI-translation] ((सबसे बाबरकत औरत वह है जिसके ख़र्चे [यानी महर वग़ैरा] सबसे कम हों))।"
"786","[AI-translation] ((निकाह का एलान करो, उसे मस्जिदों में करो और उसमें दफ़ बजाओ))।"
"787","[AI-translation] ((जब नबी (सल्लल्लाहु अलैहि वसल्लम) किसी औरत से शादी करते तो लोग आपके सिर पर अजवा खजूरें बिखेरते))।"
"788","[AI-translation] ((धोखा, मक्कारी और फ़रेब सिर्फ़ शादी में जायज़ हैं))।"
"789","[AI-translation] ((वे औरतें ज़ानिया हैं जो बग़ैर गवाहों के ख़ुद शादी कर लें))।"
"790","[AI-translation] ((जो किसी औरत से शादी करे वह उसके पास जाने से पहले उसे तोहफ़ा दे, चाहे अपना एक जूता ही हो))।"
"791","[AI-translation] ((जब तुममें से कोई सोहबत करे तो शर्मगाह की तरफ़ न देखे, क्योंकि यह अंधेपन का सबब है))।"
"792","[AI-translation] हज़रत आइशा (रज़ियल्लाहु अन्हा) ने कहा: ((मैंने रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) की शर्मगाह कभी नहीं देखी))।"
"793","[AI-translation] ((जो किसी औरत की शर्मगाह देखे, तो उसकी माँ और बेटी उसके लिए हलाल नहीं रहतीं [यानी अब वह उनमें से किसी से शादी नहीं कर सकता]))।"
"794","[AI-translation] ((तुममें से कोई सोहबत के दौरान ज़्यादा बातें न करे, क्योंकि इससे बच्चा गूँगा पैदा हो सकता है))।"
"795","[AI-translation] ((मर्द पर अपनी बीवी के लिए ज़ीनत करना उसी तरह वाजिब है जैसे औरत पर उसके लिए वाजिब है))।"
"796","[AI-translation] ((मैंने तुम्हें सिर्फ़ माले-ग़नीमत लूटने से रोका है, शादी की दावतों में शरीक होने से नहीं))।"
"797","[AI-translation] ((औरतों की ख़्वाहिश मर्दों से दोगुनी है))।"
"798","[AI-translation] ((किसी उस औरत के लिए जो अल्लाह और आख़िरत के दिन पर ईमान रखती हो, जायज़ नहीं कि अपने बाल या सीने का कोई हिस्सा यहूदी, ईसाई या मजूसी के सामने खोले, और जो ऐसा करे उसमें कोई अमानतदारी नहीं))।"
"799","[AI-translation] ((जो औरत शौहर की इजाज़त के बग़ैर उसके घर से निकले, हर वह चीज़ जिस पर सूरज और चाँद तुलूअ होते हैं उस पर लानत करती है, जब तक उसका शौहर उससे राज़ी न हो जाए))।"
"800","[AI-translation] ((औरत शौहर की इजाज़त के बग़ैर घर से न निकले; अगर ऐसा करे तो आसमान के फ़रिश्ते, रहमत के फ़रिश्ते और अज़ाब के फ़रिश्ते [सब] उसके लौटने तक उस पर लानत करेंगे))।"
"801","[AI-translation] ((औरतों की इताअत पछतावे की तरफ़ ले जाती है))।"
"802","[AI-translation] ((जो अपनी बीवी के बुरे अख़लाक़ पर सब्र करे, अल्लाह तआला उसे अय्यूब (अलैहिस्सलाम) को उनकी आज़माइश पर दिए गए सवाब के बराबर सवाब देगा। और जो औरत अपने शौहर के बुरे अख़लाक़ पर सब्र करे, अल्लाह तआला उसे आसिया (अलैहस्सलाम) को, जो फ़िरऔन की बीवी थीं, दिए गए सवाब के बराबर सवाब देगा))।"
"803","[AI-translation] ((उन्हें [औरतों को] बालाख़ानों में न रखो, न उन्हें लिखना-पढ़ना सिखाओ; उन्हें सूत कातना सिखाओ और उन्हें सूरत-ए-नूर सिखाओ))।"
"804","[AI-translation] ((सिर्फ़ शरीफ़ आदमी औरतों की इज़्ज़त करता है, और सिर्फ़ कमीना उन्हें ज़लील करता है))।"
"805","[AI-translation] ((बीवी का ग़ुलाम हलाक हुआ))।"
"806","[AI-translation] ((उनसे [औरतों से] मशवरा करो लेकिन उनकी मुख़ालफ़त करो))।"
"807","[AI-translation] ((तुममें से कोई कोई काम न करे यहाँ तक कि मशवरा करे, और अगर मशवरे के लिए कोई न हो तो औरत से मशवरा करे, फिर उसकी राय की मुख़ालफ़त करे, क्योंकि उसकी मुख़ालफ़त में बरकत है))।"
"808","[AI-translation] ((औरतों के कपड़े उतारो [ताकि] वे घर के अन्दर अपनी तयशुदा ख़लवत की जगह बैठी रहें))।"
"809","[AI-translation] ((औरतों में नेक बीवी की मिसाल सौ कव्वों में एक कव्वे जैसी है))।"
"810","[AI-translation] ((औरत का जिहाद अपने शौहर की इताअत है [और उसके साथ अच्छे सुलूक़ से पेश आना]))।"
"811","[AI-translation] ((अगर कोई औरत इस हाल में मरे कि उसका शौहर उससे राज़ी हो, वह जन्नत में दाख़िल होगी))।"
"812","[AI-translation] ((मुत्तक़ी बेवा को आसमानों में शहीदा का लक़ब दिया गया है))।"
"813","[AI-translation] ((मुझे चखने वाले मर्द पसन्द नहीं न चखने वाली औरतें। [इमाम इब्ने असीर (रहिमहुल्लाह) ने इसका मतलब वे लोग बताया जो शादी में भी जल्दी करते हैं और तलाक़ में भी जल्दी करते हैं] [النهايته]))।"
"814","[AI-translation] ((जो दो लोगों का निकाह कराने जाए, अल्लाह तआला उसे हर क़दम और हर बात पर एक साल का सवाब देगा, और जो दो लोगों को जुदा करने जाए, तो अल्लाह तआला पर लाज़िम है कि क़ियामत के दिन जहन्नम में उसका सिर हज़ार चट्टानों पर मारे))।"
"815","[AI-translation] ((ऐ मुआज़! अल्लाह तआला ने ज़मीन की सतह पर कोई चीज़ आज़ाद करने [ग़ुलामों] से ज़्यादा महबूब पैदा नहीं की, और अल्लाह तआला ने ज़मीन की सतह पर कोई चीज़ तलाक़ से ज़्यादा नापसन्द पैदा नहीं की))।"
"816","[AI-translation] ((लौंडी की दो तलाक़ें हैं और उसकी इद्दत दो हैज़ हैं))।"
"817","[AI-translation] ((दूध पिलाने [वाली] का हक़ कैसे अदा किया जाए?)) नबी (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: ((ग़ुलाम या लौंडी बतौर मुआवज़ा देकर))।"
"818","[AI-translation] ((बेवक़ूफ़ औरत से अपने बच्चों को दूध न पिलवाओ))।"
"819","[AI-translation] ((चार क़िस्म के लोगों के दरमियान लिआन नहीं: आज़ाद मर्द और लौंडी के दरमियान, आज़ाद औरत और ग़ुलाम के दरमियान, मुसलमान मर्द और यहूदी औरत के दरमियान, और मुसलमान मर्द और ईसाई औरत के दरमियान))।"
"820","[AI-translation] ((शादी करो और बच्चे पैदा करो, क्योंकि क़ियामत के दिन मैं दूसरी उम्मतों के सामने तुम्हारी [कसरत] पर फ़ख़्र करना चाहता हूँ))।"
"821","[AI-translation] ((बेटा अपने बाप का राज़ है))।"
"822","[AI-translation] ((जिस दिन हसन इब्ने अली (रज़ियल्लाहु अन्हुमा) पैदा हुए, नबी-ए-करीम (सल्लल्लाहु अलैहि वसल्लम) ने उनके दाएँ कान में अज़ान कही और बाएँ कान में इक़ामत कही))।"
"823","[AI-translation] ((जो [अपने बच्चे का] मेरे नाम पर नाम रखे वह मेरी कुन्नियत न रखे, और जो मेरी कुन्नियत रखे वह [अपने बच्चे का] मेरे नाम पर नाम न रखे))।"
"824","[AI-translation] ((बेशक क़ियामत के दिन तुम अपने नामों और अपने बापों के नामों से पुकारे जाओगे, तो अपने लिए अच्छे नाम रखो))।"
"825","[AI-translation] ((ख़तना मर्दों के लिए सुन्नत है और औरतों के लिए इज़्ज़त की बात है))।"
"826","[AI-translation] ((बग़ैर ख़तने वाला मर्द इस्लाम में बर्दाश्त न किया जाएगा यहाँ तक कि ख़तना कराए, चाहे अस्सी साल का हो))।"
"827","[AI-translation] ((बग़ैर ख़तने वाला मर्द बैतुल्लाह का हज नहीं कर सकता यहाँ तक कि ख़तना कराए))।"
"828","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ख़तनाशुदा पैदा हुए))।"
"829","[AI-translation] ((जो मुसलमान हो वह ख़तना कराए, चाहे ज़्यादा उम्र का हो))।"
"830","[AI-translation] ((अपने बेटों को तैरना और तीरअन्दाज़ी सिखाओ))।"
"831","[AI-translation] ((आदमी के लिए अपने बच्चों को अच्छे अख़लाक़ सिखाना एक साअ [लगभग ढाई किलो अनाज] सदक़ा करने से बेहतर है))।"
"832","[AI-translation] ((बाप ने अपने बच्चे को अच्छे अख़लाक़ से बेहतर कोई तोहफ़ा नहीं दिया))।"
"833","[AI-translation] ((बच्चे का बाप पर हक़ है कि वह उसे अच्छा नाम दे और अच्छे अख़लाक़ सिखाए))।"
"834","[AI-translation] ((अपने बच्चों को रोने पर न मारो))।"
"835","[AI-translation] ((जो रहम और शफ़क़त से यतीम के सिर पर हाथ रखे, हर बाल जिस पर उसका हाथ गुज़रे, उसके लिए बतौर सवाब एक नेकी है))।"
"836","[AI-translation] ((एक आदमी ने कम औलाद की शिकायत की, तो नबी (सल्लल्लाहु अलैहि वसल्लम) ने उसे अंडे और प्याज़ खाने का हुक्म दिया))।"
"837","[AI-translation] ((बेटियों से मुहब्बत करो, क्योंकि मैं भी बेटियों का बाप हूँ))।"
"838","[AI-translation] ((जो अपने बेटे या बेटी की शादी पर एक दिरहम ख़र्च करे, अल्लाह तआला उसे हर दिरहम के बदले जन्नत में बारह शहर देगा))।"
"839","[AI-translation] ((वह मनी का क़तरा जिससे बच्चा पैदा होता है, सब आज़ा और रगों को कँपा देता है))।"
"840","[AI-translation] ((घरवालों की थोड़ी तादाद आसानी है; उनकी कसरत ग़ुर्बत है))।"
"841","[AI-translation] ((अपने बच्चों को उर्फ़ी नाम पड़ने से पहले कुन्नियत दो))।"
"842","[AI-translation] ((जो बच्चे की परवरिश करे यहाँ तक कि वह कलिमा 'ला-इलाहा-इल्लल्लाह' कहने लगे, अल्लाह तआला उससे हिसाब न लेगा))।"
"843","[AI-translation] ((अल्लाह उस बाप पर रहम करे जो अपने बच्चे की नेक कामों में मदद करे))।"
"844","[AI-translation] ((तोहफ़े देने में अपने बच्चों में बराबरी करो))।"
"845","[AI-translation] ((बाप की अपने बच्चे के लिए दुआ नबी की अपनी उम्मत के लिए दुआ जैसी है))।"
"846","[AI-translation] ((अपने वालिदैन से अच्छा सलूक़ करो और तुम्हारे बेटे तुमसे अच्छा सलूक़ करेंगे))।"
"847","[AI-translation] ((वालिदैन से नेकी नमाज़, रोज़े, हज, उमरा और अल्लाह के रास्ते में जिहाद से अफ़ज़ल है))।"
"848","[AI-translation] ((जन्नत की ख़ुशबू पाँच सौ साल की दूरी से महसूस होगी, लेकिन वालिदैन का नाफ़रमान उसकी ख़ुशबू से महरूम रहेगा))।"
"849","[AI-translation] ((जब कोई अपने वालिदैन के लिए दुआ करना छोड़ दे तो दुनिया में उसकी औलाद से रिज़्क़ कट जाता है))।"
"850","[AI-translation] ((अगर मैं अपने वालिदैन या उनमें से एक को पाऊँ, और मैं इशा की नमाज़ पढ़ रहा हूँ, उसमें सूरत-ए-फ़ातिहा पढ़ चुका हूँ, और वे मुझे पुकारें: ऐ मुहम्मद! तो मैं उन्हें जवाब दूँगा, कहूँगा: हाज़िर हूँ))।"
"851","[AI-translation] ((जो अपनी माँ की दोनों आँखों के दरमियान बोसा दे, यह अमल उसके लिए जहन्नम की आग से रुकावट बनेगा))।"
"852","[AI-translation] ((एक नौजवान की मौत का वक़्त आया; अपनी माँ की नाफ़रमानी की वजह से वह कलिमा न पढ़ सका। फिर नबी-ए-करीम (सल्लल्लाहु अलैहि वसल्लम) ने उसकी माँ से सिफ़ारिश की, और जब वह राज़ी हुई तो वह कलिमा पढ़ सका))।"
"853","[AI-translation] ((जो वालिदैन और रब का फ़रमाँबरदार हो वह इल्लिय्यीन के आला दर्जों में होगा))।"
"854","[AI-translation] ((अगर किसी के वालिदैन या उनमें से एक वफ़ात पाएँ और वह उनका नाफ़रमान था, लेकिन फिर उनके लिए नमाज़ और इस्तिग़फ़ार करता रहे, तो अल्लाह उसे फ़रमाँबरदार और इताअतगुज़ार लिखता है))।"
"855","[AI-translation] ((जो अपने वालिदैन को रहमत की निगाह से देखे, अल्लाह तआला उसे हर निगाह पर मक़बूल हज का सवाब लिखता है। सहाबा ने पूछा: चाहे दिन में सौ (100) बार देखे? नबी (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: हाँ, अल्लाह तआला सबसे बड़ा और सबसे पाक है))।"
"856","[AI-translation] ((वे तेरी जन्नत हैं [अगर उनकी इताअत करे] और तेरा जहन्नम [अगर उनकी नाफ़रमानी करे]))।"
"857","[AI-translation] ((जब हलाल और हराम जमा हों तो हराम ग़ालिब आता है))।"
"858","[AI-translation] ((जो हराम का एक लुक़मा खाए, चालीस दिन उसकी नमाज़ क़ुबूल नहीं होती))।"
"859","[AI-translation] ((जो हराम का एक दिरहम छोड़े, अल्लाह रब्ब-उल-इज़्ज़त उसे जहन्नम की आग से आज़ाद करेगा))।"
"860","[AI-translation] ((जो रोज़ी के मामलात में दुरुस्त न हो वह दीन के मामलात में भी दुरुस्त नहीं))।"
"861","[AI-translation] ((अल्लाह तआला बेकार नौजवान को नापसन्द करता है))।"
"862","[AI-translation] ((अल्लाह तआला बेकार आदमी को नापसन्द करता है))।"
"863","[AI-translation] ((अगर मेरा बन्दा हलाल से शर्माए तो अल्लाह तआला उसे हराम में मुब्तला करता है))।"
"864","[AI-translation] ((जो हराम तरीक़े से माल कमाए, अल्लाह तआला उसे हलाकत में ले जाता है))।"
"865","[AI-translation] ((अल्लाह तआला का एक फ़रिश्ता बैत-उल-मक़दिस में है, जो हर रात एलान करता है कि जिसने हराम खाया, न उसकी कोई नफ़्ल इबादत क़ुबूल होगी न फ़र्ज़))।"
"866","[AI-translation] ((अगर जन्नती तिजारत करें तो कपड़े की तिजारत करेंगे))।"
"867","[AI-translation] ((बुज़दिल ताजिर महरूम है, और बहादुर ताजिर को रिज़्क़ दिया जाता है))।"
"868","[AI-translation] ((ख़ुशख़ती सीखो, क्योंकि वह रिज़्क़ की कुंजी है))।"
"869","[AI-translation] ((बदतरीन लोग ताजिर और किसान हैं))।"
"870","[AI-translation] ((आख़िरी ज़माने में बदतरीन माल ग़ुलाम और लौंडियाँ होंगे))।"
"871","[AI-translation] ((मेरी उम्मत के बख़ील दर्ज़ी हैं))।"
"872","[AI-translation] ((ऐ अल्लाह! हमें अपने ताजिर और मुसाफ़िर की राय न मानने दे, क्योंकि हमारा ताजिर ऊँचे दाम चाहता है और हमारा मुसाफ़िर बारिश नापसन्द करता है))।"
"873","[AI-translation] ((जो मेरी उम्मत पर एक रात भी महँगाई चाहे, अल्लाह तआला उसके चालीस साल के आमाल बर्बाद कर देगा))।"
"874","[AI-translation] ((जो बाज़ार में सामान लाए उसे रिज़्क़ दिया जाता है, और जो ज़ख़ीरा करे उस पर लानत की जाती है))।"
"875","[AI-translation] ((जो चालीस दिन अनाज ज़ख़ीरा करे वह अल्लाह से जुदा होगा, और अल्लाह उससे जुदा होगा))।"
"876","[AI-translation] ((जो मुसलमानों से चालीस दिन अनाज ज़ख़ीरा करे, फिर चाहे वह सब सदक़ा कर दे, वह उसके लिए कफ़्फ़ारा न होगा))।"
"877","[AI-translation] ((हर क़र्ज़ जो फ़ायदा लाए वह सूद है))।"
"878","[AI-translation] ((हया रिज़्क़ रोकती है))।"
"879","[AI-translation] ((बर्तन धोना और सहन साफ़ करना [दोनों काम] ख़ुशहाल बनाते हैं))।"
"880","[AI-translation] ((जब फ़ज्र की नमाज़ पढ़ लो तो रिज़्क़ तलाश करने के बजाय [ग़फ़लत से] न सोओ))।"
"881","[AI-translation] ((दो क़िस्में हैं जिन्हें अल्लाह तआला ने दुनिया और आख़िरत में इज़्ज़त दी: एक सोना और दूसरा चाँदी। अल्लाह तआला ने उन्हें दुनिया वालों के लिए इज़्ज़त का ज़रिया और आख़िरत वालों के लिए ज़ीनत का ज़रिया बनाया))।"
"882","[AI-translation] ((दिरहम इसलिए कहा जाता है क्योंकि वह ग़म का घर है, और दीनार इसलिए कहा जाता है क्योंकि वह आग का घर है))।"
"883","[AI-translation] ((अल्लाह तआला ने जिस्मों की पैदाइश से दो हज़ार साल पहले रिज़्क़ पैदा किया))।"
"884","[AI-translation] ((पानी में मछली न ख़रीदो क्योंकि यह धोखा है))।"
"885","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ने उधार चीज़ के बदले उधार चीज़ की बिक्री से मना किया))।"
"886","[AI-translation] ((जो कोई चीज़ बिन देखे ख़रीदे, फिर देखने के बाद उसे इख़्तियार है [अगर पसन्द आए तो रखे, वरना लौटाए]))।"
"887","[AI-translation] ((ग़ायब या बच्चे के लिए शुफ़आ का हक़ नहीं, और शुफ़आ रस्सी खोलने जैसा है))।"
"888","[AI-translation] ((अल्लाह तआला फ़रमाता है कि मैं दो शरीकों में तीसरा हूँ जब तक उनमें से एक अपने साथी से ख़ियानत न करे))।"
"889","[AI-translation] ((गिरवी रखी चीज़ उसके मालिक से नहीं रोकी जाएगी; उसका फ़ायदा भी उसी के लिए है, और वह उसकी ज़िम्मेदारी का भी ज़िम्मेदार है))।"
"890","[AI-translation] ((खाने से पहले हाथ धोना एक नेकी है, जबकि खाने के बाद हाथ धोना दो नेकियों का सबब है))।"
"891","[AI-translation] ((खाने से पहले हाथ धोना ग़ुर्बत और भूख दूर करता है))।"
"892","[AI-translation] ((खाने से पहले और बाद में हाथ धोना रिज़्क़ में फ़राख़ी और शैतानी तरीक़ों को दूर करने का ज़रिया है))।"
