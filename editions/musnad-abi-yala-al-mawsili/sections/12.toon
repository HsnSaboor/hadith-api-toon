hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"6601","756 - (  6596  ) -  وَبِإِسْنَادِهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :         [11/477]      مَنْ كَانَ عَلَيْهِ دَيْنٌ فَلْيَقْضِهِ إِيَّاهُ  ، أَوْ لِيَتَحَلَّلْ مِنْهُ قَبْلَ أَنْ يَقْضِيَهُ فِي يَوْمٍ لَا ذَهَبَ وَلَا  وَرِقَ  ، قَالُوا : فَمَاذَا يَقْضِيهِ يَا رَسُولَ اللهِ ؟ قَالَ : يُؤْخَذُ مِنْ حَسَنَاتِهِ ، فَإِنْ وَفَّتْ ، وَإِلَّا طُرِحَ عَلَيْهِ مِنْ سَيِّئَاتِ الْآخَرِ  .","","Musnad Abi Ya'la al-Mawsili 6596","","أبو هريرة الدوسي عن سعيد المقبري عن عبد الرحمن بن إسحاق العامري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6602","757 - (  6597  ) -  وَبِإِسْنَادِهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ثَلَاثَةٌ لَا يَنْظُرُ اللهُ إِلَيْهِمْ يَوْمَ الْقِيَامَةِ  : الشَّيْخُ الزَّانِي ، وَالْإِمَامُ الْكَذَّابُ ،  وَالْعَائِلُ  الْمَزْهُوُّ  .","","Musnad Abi Ya'la al-Mawsili 6597","","أبو هريرة الدوسي عن سعيد المقبري عن عبد الرحمن بن إسحاق العامري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6603","758 - (  6598  ) -  وَبِإِسْنَادِهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ  كَانَ إِذَا صَلَّى عَلَى الْجِنَازَةِ ، قَالَ : اللَّهُمَّ عَبْدُكَ وَابْنُ عَبْدِكَ  ، كَانَ يَشْهَدُ أَنْ لَا إِلَهَ إِلَّا أَنْتَ ، وَأَنَّ  مُحَمَّدًا  عَبْدُكَ وَرَسُولُكَ ، وَأَنْتَ أَعْلَمُ بِهِ ، إِنْ كَانَ مُحْسِنًا فَزِدْ فِي إِحْسَانِهِ ، وَإِنْ كَانَ مُسِيئًا فَاغْفِرْ لَهُ ، لَا تَحْرِمْنَا أَجْرَهُ ، وَلَا تَفْتِنَّا بَعْدَهُ  .         [11/478]","","Musnad Abi Ya'la al-Mawsili 6598","","أبو هريرة الدوسي عن سعيد المقبري عن عبد الرحمن بن إسحاق العامري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6604","759 - (  6599  ) -  وَبِإِسْنَادِهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  :  لَيْسَ الْغِنَى عَنْ كَثْرَةِ  الْعَرَضِ  ، إِنَّمَا الْغِنَى غِنَى النَّفْسِ  .","","Musnad Abi Ya'la al-Mawsili 6599","","أبو هريرة الدوسي عن سعيد المقبري عن عبد الرحمن بن إسحاق العامري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6605","760 - (  6600  ) -  وَبِإِسْنَادِهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  وَالَّذِي نَفْسِي بِيَدِهِ ، لَلَّهُ أَفْرَحُ بِتَوْبَةِ عَبْدِهِ مِنْ أَحَدِكُمْ بِضَالَّتِهِ إِذَا وَجَدَهَا فِي الْفَلَاةِ  .         [11/479]","","Musnad Abi Ya'la al-Mawsili 6600","","أبو هريرة الدوسي عن سعيد المقبري عن عبد الرحمن بن إسحاق العامري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6606","761 - (  6601  ) -  وَبِإِسْنَادِهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : يَعْنِي قَالَ اللهُ عَزَّ وَجَلَّ :  إِذَا  تَقَرَّبَ  عَبْدِي شِبْرًا  تَقَرَّبْتُ  إِلَيْهِ ذِرَاعًا  ، وَإِذَا  تَقَرَّبَ  إِلَيَّ ذِرَاعًا  تَقَرَّبْتُ  إِلَيْهِ بَاعًا ، وَإِذَا  تَقَرَّبَ  إِلَيَّ بَاعًا جِئْتُهُ  هَرْوَلَةً  .         [11/480]","","Musnad Abi Ya'la al-Mawsili 6601","","أبو هريرة الدوسي عن سعيد المقبري عن عبد الرحمن بن إسحاق العامري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6607","762 - (  6602  ) -  وَبِإِسْنَادِهِ  ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ،  مَنْ قَاتَلَ فِي  سَبِيلِ  اللهِ أَيَدْخُلُ الْجَنَّةَ  ؟ قَالَ : نَعَمْ ، فَمَكَثَ  هُنَيَّةً  كَأَنَّهُ سَمِعَ شَيْئًا ، فَقَالَ : أَيْنَ السَّائِلُ آنِفًا ؟ فَقَامَ الرَّجُلُ ، فَقَالَ : مَاذَا قُلْتَ ؟ قَالَ :         [11/481]      قُلْتُ : أَرَأَيْتَ مَنْ جَاهَدَ فِي  سَبِيلِ  اللهِ فَقُتِلَ ، أَيَدْخُلُ الْجَنَّةَ ؟ قُلْتَ : نَعَمْ ، قَالَ : فَقَالَ : إِنَّ  جِبْرِيلَ  نَبَّأَنِي ذَلِكَ ، إِلَّا أَنْ يَكُونَ عَلَيْهِ دَيْنٌ  .","","Musnad Abi Ya'la al-Mawsili 6602","","أبو هريرة الدوسي عن سعيد المقبري عن عبد الرحمن بن إسحاق العامري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6608","763 - (  6603  ) -  وَبِإِسْنَادِهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَجْلِسُوا فِي  الصُّعُدَاتِ  وَلَا فِي الْأَفْنِيَةِ  .         [11/482]      قَالُوا : يَا رَسُولَ اللهِ ، لَا نَسْتَطِيعُ ذَلِكَ ، قَالَ : إِمَّا لَا فَأَعْطُوهَا حَقَّهَا ، قَالُوا : يَا نَبِيَّ اللهِ ، وَمَا حَقُّهَا ؟ قَالَ : رَدُّ التَّحِيَّةِ ، وَغَضُّ الْبَصَرِ ، وَتَشْمِيتُ الْعَاطِسِ ،  وَإِرْشَادُ  السَّبِيلِ  .","","Musnad Abi Ya'la al-Mawsili 6603","","أبو هريرة الدوسي عن سعيد المقبري عن عبد الرحمن بن إسحاق العامري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6609","764 - (  6604  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  عَبْدِ اللهِ بْنِ سَعِيدٍ ،  عَنْ  جَدِّهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ ذَرَعَهُ الْقَيْءُ ، فَلَا قَضَاءَ عَلَيْهِ  ، وَمَنِ  اسْتَقَاءَ  فَعَلَيْهِ الْقَضَاءُ  .         [11/483]             [11/484]             [11/485]             [11/486]","","Musnad Abi Ya'la al-Mawsili 6604","","أبو هريرة الدوسي عن أبو سعيد المقبري عن عبد الله بن سعيد بن أبي سعيد المقبري عن حفص بن غياث النخعي عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6610","765 - (  6605  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  حَدَّثَنَا  أَبُو مَعْشَرٍ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ، قَالَ :  رَأَيْنَا  أَبَا هُرَيْرَةَ يَتَوَضَّأُ عَلَى ظَهْرِ الْمَسْجِدِ ، فَقُلْتُ : يَا  أَبَا هُرَيْرَةَ  ، مِمَّ تَتَوَضَّأُ ؟ قَالَ : أَكَلْتُ ثَوْرًا مِنْ أَقِطٍ ، سَمِعْتُ         [11/487]      رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  تَوَضَّئُوا مِمَّا غَيَّرَتِ النَّارُ  .","","Musnad Abi Ya'la al-Mawsili 6605","","أبو هريرة الدوسي عن سعيد المقبري عن نجيح بن عبد الرحمن السندي عن محمد بن بكار الرصافي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6611","766 - (  6606  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  دَاوُدُ الْعَطَّارُ ،  عَنْ  إِسْمَاعِيلَ بْنِ أُمَيَّةَ ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ هَذَا الْمَالَ  خَضِرَةٌ  حُلْوَةٌ  ، فَمَنْ أَخَذَهُ - قَالَ  يَحْيَى  : ذَكَرَ شَيْئًا لَا أَدْرِي مَا هُوَ - بُورِكَ لَهُ فِيهِ ، وَرُبَّ  مُتَخَوِّضٍ  فِي مَالِ اللهِ وَرَسُولِهِ فِيمَا اشْتَهَتْ نَفْسُهُ ، لَهُ النَّارُ يَوْمَ الْقِيَامَةِ  .         [11/488]","","Musnad Abi Ya'la al-Mawsili 6606","","أبو هريرة الدوسي عن أبو سعيد المقبري عن سعيد المقبري عن إسماعيل بن أمية الأموي عن داود ابن النصراني عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6612","767 - (  6607  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ عَرَفَةَ الْعَبْدِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ إِبْرَاهِيمَ الْغِفَارِيُّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  عُرِجَ بِي إِلَى السَّمَاءِ الدُّنْيَا ، فَمَا مَرَرْتُ بِسَمَاءٍ ، إِلَّا وَجَدْتُ فِيهَا اسْمِي  :  مُحَمَّدٌ  رَسُولُ اللهِ ،  وَأَبُو بَكْرٍ الصِّدِّيقُ  مِنْ خَلْفِي  .         [11/489]","","Musnad Abi Ya'la al-Mawsili 6607","","أبو هريرة الدوسي عن سعيد المقبري عن عبد الرحمن بن زيد بن أسلم عن عبد الله بن إبراهيم بن أبي عمرو الغفاري عن الحسن بن عرفة العبدي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6613","768 - (  6608  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَيُّوبَ ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا زَنَتْ أَمَةُ أَحَدِكُمْ فَتَبَيَّنَ زِنَاهَا فَلْيَجْلِدْهَا وَلَا  يُثَرِّبْ  ، ثُمَّ إِنْ زَنَتْ فَلْيَجْلِدْهَا  الْحَدَّ  وَلَا  يُثَرِّبْ  - قَالَ  سُفْيَانُ  :  يَعْنِي لَا يُعَيِّرْهَا  - ثُمَّ إِنْ زَنَتْ فَلْيَجْلِدْهَا  الْحَدَّ  وَلَا  يُثَرِّبْ  ، ثُمَّ إِنْ زَنَتْ فَلْيَبِعْهَا وَلَوْ  بِضَفِيرٍ  .","","Musnad Abi Ya'la al-Mawsili 6608","","أبو هريرة الدوسي عن سعيد المقبري عن أيوب بن موسى الأموي عن سفيان بن عيينة عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6614","769 - (  6609  ) -  حَدَّثَنَا  دَاوُدُ بْنُ عَمْرٍو ،  حَدَّثَنَا  حِبَّانُ بْنُ عَلِيٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ سَعِيدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الرِّكَازُ  : الذَّهَبُ الَّذِي يَنْبُتُ مِنَ الْأَرْضِ  .         [11/490]","","Musnad Abi Ya'la al-Mawsili 6609","","أبو هريرة الدوسي عن سعيد المقبري عن عبد الله بن سعيد بن أبي سعيد المقبري عن حبان بن علي العنزي عن داود بن عمرو المسيبي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6615","770 - (  6610  ) -  حَدَّثَنَا  دَاوُدُ بْنُ عَمْرٍو ،  حَدَّثَنَا  حِبَّانُ بْنُ عَلِيٍّ الْعَنَزِيُّ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا اشْتَرَى أَحَدُكُمْ خَادِمًا ، فَلْيَأْخُذْ بِنَاصِيَتِهَا وَلْيَقُلِ :  اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ خَيْرِهَا وَخَيْرِ مَا  جَبَلْتَهَا  عَلَيْهِ  ، وَإِذَا اشْتَرَى بَعِيرًا فَلْيَأْخُذْ بِذِرْوَةِ سَنَامِهِ وَلْيَقُلْ مِثْلَ ذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 6610","","أبو هريرة الدوسي عن سعيد المقبري عن محمد بن عجلان عن حبان بن علي العنزي عن داود بن عمرو المسيبي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6616","771 - (  6611  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ سَعِيدٍ ،  عَنْ  جَدِّهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَوْ أَنَّ لِابْنِ         [11/491]      آدَمَ وَادِيَيْنِ مِنْ ذَهَبٍ لَتَمَنَّى إِلَيْهِمَا ثَالِثًا  ، وَلَا يَمْلَأُ جَوْفَ ابْنِ آدَمَ إِلَّا التُّرَابُ  .","","Musnad Abi Ya'la al-Mawsili 6611","","أبو هريرة الدوسي عن أبو سعيد المقبري عن عبد الله بن سعيد بن أبي سعيد المقبري عن محمد بن فضيل بن غزوان عن إبراهيم بن سعيد الجوهري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6617","772 - (  6612  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  إِبْرَاهِيمَ بْنِ الْفَضْلِ ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  مَرَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِحَائِطٍ مَائِلٍ ، فَأَسْرَعَ وَقَالَ : إِنِّي أَكْرَهُ مَوْتَ  الْفَوَاتِ  .","","Musnad Abi Ya'la al-Mawsili 6612","","أبو هريرة الدوسي عن سعيد المقبري عن إبراهيم بن الفضل المخزومي عن أبو معاوية الضرير عن إبراهيم بن سعيد الجوهري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6618","773 - (  6613  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ ،  حَدَّثَنَا  صَفْوَانُ ،  عَنْ  عَبْدِ اللهِ بْنِ سَعِيدِ بْنِ أَبِي هِنْدَ ،  عَنْ  مُحَمَّدِ بْنِ عُثْمَانَ الْأَخْنَسِيِّ  ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،         [11/492]      عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ جُعِلَ قَاضِيًا بَيْنَ النَّاسِ ، فَقَدْ  ذُبِحَ  بِغَيْرِ  سِكِّينٍ  .  كذا في طبعة دار المأمون للتراث وسنن النسائي الكبرى ، وقال النسائي : ، والصواب عثمان بن محمد .","","Musnad Abi Ya'la al-Mawsili 6613","","أبو هريرة الدوسي عن سعيد المقبري عن عثمان بن محمد بن المغيرة الأخنسي عن عبد الله بن سعيد بن أبي هند الفزاري عن صفوان بن عيسى عباية عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6619","774 - (  6614  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنِ  ابْنِ عَجْلَانَ ، قَالَ :  سَمِعْتُ  أَبِي  ، وَسَعِيدًا  يُحَدِّثَانِ عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَا مِنْ أَمِيرِ عَشَرَةٍ إِلَّا يُؤْتَى بِهِ يَوْمَ الْقِيَامَةِ مَغْلُولًا  ، يَفُكُّهُ الْعَدْلُ أَوْ يُوبِقُهُ الْجَوْرُ  .","","Musnad Abi Ya'la al-Mawsili 6614","","أبو هريرة الدوسي عن سعيد المقبري عن محمد بن عجلان عن يحيى القطان عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6620","775 - (  6615  ) -  حَدَّثَنَا  سُفْيَانُ بْنُ وَكِيعٍ ،  حَدَّثَنَا  أَبِي  ،  حَدَّثَنَا  يَحْيَى بْنُ عُمَيْرٍ الْمَدِينِيُّ ، قَالَ :  سَمِعْتُ  سَعِيدًا الْمَقْبُرِيَّ  يَقُولُ  :  صَلَّى بِنَا أَبُو هُرَيْرَةَ ، فَكَانَ يُكَبِّرُ كُلَّمَا رَفَعَ وَسَجَدَ  ، فَلَمَّا انْصَرَفَ ، قَالَ : هَكَذَا كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي بِنَا  .         [11/493]","","Musnad Abi Ya'la al-Mawsili 6615","","أبو هريرة الدوسي عن سعيد المقبري عن يحيى بن عمير البزاز عن وكيع بن الجراح عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6621","776 - (  6616  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  سُفْيَانُ ، وَيَحْيَى بْنُ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ  رَجُلًا  قَالَ : يَا رَسُولَ اللهِ عِنْدِي دِينَارٌ ، قَالَ : أَنْفِقْهُ عَلَى نَفْسِكَ  ، قَالَ : عِنْدِي دِينَارٌ آخَرُ ، قَالَ : أَنْفِقْهُ عَلَى امْرَأَتِكَ ، قَالَ : عِنْدِي دِينَارٌ آخَرُ ، قَالَ : أَنْفِقْهُ عَلَى وَلَدِكَ ، قَالَ : عِنْدِي دِينَارٌ آخَرُ ، قَالَ : أَنْفِقْهُ عَلَى خَادِمِكَ ، قَالَ : عِنْدِي دِينَارٌ آخَرُ ، قَالَ : أَنْتَ أَعْلَمُ  .         [11/494]","","Musnad Abi Ya'la al-Mawsili 6616","","أبو هريرة الدوسي عن سعيد المقبري عن محمد بن عجلان عن يحيى القطان عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6622","777 - (  6617  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  أَخْبَرَنِي  سَعِيدُ بْنُ أَبِي سَعِيدٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَقَدْ هَمَمْتُ أَنْ آمُرَ بِالسِّوَاكِ مَعَ الْوُضُوءِ  ، وَأُؤَخِّرَ الصَّلَاةِ إِلَى  شَطْرِ  اللَّيْلِ . أَوْ : إِلَى ثُلُثِ اللَّيْلِ  .","","Musnad Abi Ya'la al-Mawsili 6617","","أبو هريرة الدوسي عن سعيد المقبري عن عبيد الله بن عمر العمري عن يحيى القطان عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6623","778 - (  6618  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  وَكِيعٌ ، قَالَ :  حَدَّثَنِي  إِبْرَاهِيمُ بْنُ الْفَضْلِ الْمَخْزُومِيُّ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ادْرَءُوا الْحُدُودَ مَا اسْتَطَعْتُمْ  .         [11/495]             [11/496]","","Musnad Abi Ya'la al-Mawsili 6618","","أبو هريرة الدوسي عن سعيد المقبري عن إبراهيم بن الفضل المخزومي عن وكيع بن الجراح عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6624","779 - (  6619  ) -  حَدَّثَنَا  عَمْرٌو النَّاقِدُ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ مَنْصُورٍ ،  حَدَّثَنَا  إِسْرَائِيلُ ،  عَنْ  مُعَاوِيَةَ بْنِ إِسْحَاقَ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أُذِنَ لِي أَنْ أُحَدِّثَ عَنْ مَلَكٍ قَدْ مَرَقَتْ رِجْلَاهُ الْأَرْضَ السَّابِعَةَ  ، وَالْعَرْشُ عَلَى مَنْكِبِهِ ، وَهُوَ يَقُولُ : سُبْحَانَكَ أَيْنَ كُنْتَ وَأَيْنَ تَكُونُ  .","","Musnad Abi Ya'la al-Mawsili 6619","","أبو هريرة الدوسي عن سعيد المقبري عن معاوية بن إسحاق بن طلحة التيمي عن إسرائيل بن يونس بن أبي إسحاق عن إسحاق بن منصور السلولي عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6625","780 - (  6620  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عَرْعَرَةَ ،  حَدَّثَنَا  مُحَمَّدُ         [11/497]      بْنُ مَعْنٍ ،  حَدَّثَنَا  أَبِي  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ سَرَّهُ أَنْ  يُنْسَأَ  لَهُ فِي  أَثَرِهِ  ، وَيُبْسَطَ لَهُ فِي رِزْقِهِ ،  فَلْيَصِلْ  رَحِمَهُ  .","","Musnad Abi Ya'la al-Mawsili 6620","","أبو هريرة الدوسي عن سعيد المقبري عن معن بن محمد بن معن الغفاري عن محمد بن معن بن محمد الغفاري عن إبراهيم بن محمد بن عرعرة عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6626","781 - (  6621  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ عِمْرَانَ الْأَخْنَسِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  حَدَّثَنَا  عُمَارَةُ بْنُ الْقَعْقَاعِ ،  عَنْ  أَبِي زُرْعَةَ ،  قَالَ  :  دَخَلْتُ مَعَ أَبِي هُرَيْرَةَ دَارَ  مَرْوَانَ  ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  ذَاكَ وَمَنْ أَظْلَمُ مِمَّنْ خَلَقَ خَلْقًا  ... الْحَدِيثَ  .","","Musnad Abi Ya'la al-Mawsili 6621","","أبو هريرة الدوسي عن أبو زرعة بن عمرو بن جرير الغلابي عن عمارة بن القعقاع عن محمد بن فضيل بن غزوان عن أحمد بن عمران الأخنسي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6627","782 - (  6622  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  يَحْيَى         [11/498]      بْنُ سَعِيدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  حَدَّثَنِي  سَعِيدُ بْنُ أَبِي سَعِيدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ  رَجُلًا  دَخَلَ الْمَسْجِدَ وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْمَسْجِدِ فَصَلَّى ، ثُمَّ جَاءَ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَلَّمَ ، فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ارْجِعْ فَصَلِّ فَإِنَّكَ لَمْ تُصَلِّ  ، فَعَادَ ذَلِكَ ثَلَاثَ مَرَّاتٍ ، فَقَالَ : يَا رَسُولَ اللهِ مَا أُحْسِنُ غَيْرَ هَذَا فَعَلِّمْنِي ، فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِذَا أَرَدْتَ أَنْ تُصَلِّيَ فَكَبِّرْ ، ثُمَّ اقْرَأْ بِمَا تَيَسَّرَ مِنَ الْقُرْآنِ ، ثُمَّ ارْكَعْ حَتَّى تَطْمَئِنَّ رَاكِعًا ، ثُمَّ ارْفَعْ حَتَّى تَعْتَدِلَ قَائِمًا ، ثُمَّ اسْجُدْ حَتَّى تَطْمَئِنَّ سَاجِدًا ، ثُمَّ ارْفَعْ حَتَّى تَسْتَوِيَ جَالِسًا ، ثُمَّ اصْنَعْ فِي صَلَاتِكَ كُلِّهَا هَكَذَا  .","","Musnad Abi Ya'la al-Mawsili 6622","","أبو هريرة الدوسي عن أبو سعيد المقبري عن سعيد المقبري عن عبيد الله بن عمر العمري عن يحيى القطان عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6628","783 - (  6623  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ، قَالَ :  حَدَّثَنِي  مُحَمَّدُ بْنُ عَجْلَانَ ، قَالَ :  حَدَّثَنِي  عَلِيُّ بْنُ يَحْيَى بْنِ خَلَّادٍ ،  عَنْ  أَبِيهِ ،  عَنْ  عَمِّهِ  ، وَكَانَ قَدْ شَهِدَ  بَدْرًا  ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْمَسْجِدِ ، فَدَخَلَ رَجُلٌ فَصَلَّى ، فَجَعَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَرْمُقُهُ  ، فَصَلَّى ثُمَّ جَاءَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَلَّمَ ، فَرَدَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ قَالَ : ارْجِعْ فَصَلِّ فَإِنَّكَ لَمْ تُصَلِّ ، فَرَجَعَ فَصَلَّى ، ثُمَّ جَاءَ إِلَى رَسُولِ اللهِ فَسَلَّمَ ، فَرَدَّ رَسُولُ اللهِ ، ثُمَّ قَالَ : ارْجِعْ فَصَلِّ فَإِنَّكَ لَمْ تُصَلِّ ، فَفَعَلَ ذَلِكَ مَرَّتَيْنِ أَوْ         [11/499]      ثَلَاثًا ، فَقَالَ لَهُ فِي  الثَّانِيَةِ أَوْ فِي الثَّالِثَةِ  : يَا رَسُولَ اللهِ ، قَدْ أَجْهَدْتُ نَفْسِي ، فَعَلِّمْنِي وَأَرِنِي ، فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا أَرَدْتَ أَنْ تُصَلِّيَ فَتَوَضَّأْ فَأَحْسِنْ وُضُوءَكَ  ، ثُمَّ اسْتَقْبِلِ الْقِبْلَةَ فَكَبِّرْ ، ثُمَّ اقْرَأْ ، ثُمَّ ارْكَعْ حَتَّى تَطْمَئِنَّ رَاكِعًا ، ثُمَّ ارْفَعْ حَتَّى تَسْتَوِيَ قَائِمًا ، ثُمَّ اسْجُدْ حَتَّى تَطْمَئِنَّ سَاجِدًا ، ثُمَّ ارْفَعْ حَتَّى تَطْمَئِنَّ جَالِسًا ، ثُمَّ اسْجُدْ حَتَّى تَطْمَئِنَّ سَاجِدًا ، ثُمَّ ارْفَعْ حَتَّى تَطْمَئِنَّ جَالِسًا ، فَإِنْ أَتْمَمْتَ صَلَاتَكَ عَلَى هَذَا فَقَدْ أَتْمَمْتَهَا ، وَمَا انْتَقَصْتَ مِنْ ذَلِكَ مِنْ شَيْءٍ ، فَإِنَّمَا تَنْقُصُهُ مِنْ صَلَاتِكَ  .         [11/500]             [11/501]","","Musnad Abi Ya'la al-Mawsili 6623","","رفاعة بن رافع الزرقي عن يحيى بن خلاد بن رافع الزرقي عن علي بن يحيى بن خلاد عن محمد بن عجلان عن يحيى القطان عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6629","784 - (  6624  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  يَحْيَى ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  حَدَّثَنَا  سَعِيدٌ الْمَقْبُرِيُّ ،  عَنْ  عُمَرَ بْنِ أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ  ،         [11/502]      أَنَّ  عَمَّارَ بْنَ يَاسِرٍ صَلَّى رَكْعَتَيْنِ فَخَفَّفَهُمَا ، فَقَالَ لَهُ  عَبْدُ الرَّحْمَنِ بْنُ الْحَارِثِ  : يَا  أَبَا الْيَقْظَانِ  ، أَرَاكَ قَدْ خَفَّفْتَهُمَا ، قَالَ : إِنِّي بَادَرْتُ بِهِمَا الْوَسْوَاسَ ، وَإِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ  : إِنَّ الرَّجُلَ لَيُصَلِّي الصَّلَاةَ وَلَعَلَّهُ أَنْ لَا يَكُونَ لَهُ مِنْهَا إِلَّا عُشْرُهَا  ، أَوْ تُسْعُهَا ، أَوْ ثُمُنُهَا ، أَوْ سُبُعُهَا ، أَوْ سُدُسُهَا ، حَتَّى أَتَى عَلَى الْعَدَدِ  .         [11/503]","","Musnad Abi Ya'la al-Mawsili 6624","","عمار بن ياسر عن أبو بكر بن عبد الرحمن راهب قريش عن عمر بن أبي بكر بن عبد الرحمن المخزومي عن سعيد المقبري عن عبيد الله بن عمر العمري عن يحيى بن سعيد بن أبان عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6630","785 - (  6625  ) -  حَدَّثَنَا  أَبُو مُوسَى مُحَمَّدُ بْنُ الْمُثَنَّى ،  حَدَّثَنَا  مُؤَمَّلٌ ،  حَدَّثَنَا  عِكْرِمَةُ بْنُ عَمَّارٍ ، قَالَ :  أَخْبَرَنِي  سَعِيدٌ الْمَقْبُرِيُّ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  خَرَجْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي         [11/504]      غَزْوَةِ تَبُوكَ  ، فَنَزَلْنَا  ثَنِيَّةَ الْوَدَاعِ  ، فَرَأَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَصَابِيحَ ، وَرَأَى نِسَاءً يَبْكِينَ ، فَقَالَ : مَا هَذَا ؟ فَقِيلَ : تُمُتِّعَ مِنْهُنَّ يَبْكِينَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  حَرَّمَ - أَوْ قَالَ : هَدَمَ  -  الْمُتْعَةَ  النِّكَاحُ ، وَالطَّلَاقُ ، وَالْعِدَّةُ ، وَالْمِيرَاثُ  .","","Musnad Abi Ya'la al-Mawsili 6625","","أبو هريرة الدوسي عن سعيد المقبري عن عكرمة بن عمار عن مؤمل بن إسماعيل العدوي عن أبو موسى الزمن عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6631","786 - (  6626  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْجُشَمِيُّ ،  حَدَّثَنَا         [11/505]      يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ إِسْحَاقَ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الْأَفْنِيَةِ وَالصُّعُدَاتِ أَنْ يُجْلَسَ بِهَا  ، فَقَالَ لَهُ الْمُسْلِمُونَ : لَا نَسْتَطِيعُ ذَلِكَ ، قَالَ : إِمَّا لَا فَأَعْطُوهَا حَقَّهَا ، قَالُوا : وَمَا حَقُّهَا ؟ قَالَ : رَدُّ التَّحِيَّةِ ، وَتَشْمِيتُ الْعَاطِسِ إِذَا حَمِدَ اللهَ عَزَّ وَجَلَّ ، وَغَضُّ الْبَصَرِ ،  وَإِرْشَادُ  السَّبِيلِ  .","","Musnad Abi Ya'la al-Mawsili 6626","","أبو هريرة الدوسي عن سعيد المقبري عن عبد الرحمن بن إسحاق العامري عن يزيد بن زريع العيشي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6632","787 - (  6627  ) -  وَبِإِسْنَادِهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ اللهَ يُحِبُّ  الْعُطَاسَ  ، وَيَكْرَهُ التَّثَاؤُبَ  ، فَإِذَا تَثَاءَبَ أَحَدُكُمْ فَلَا يَقُلْ آهْ آهْ ، فَإِنَّ الشَّيْطَانَ يَضْحَكُ مِنْهُ  وَيَلْعَبُ  بِهِ  .","","Musnad Abi Ya'la al-Mawsili 6627","","أبو هريرة الدوسي عن سعيد المقبري عن عبد الرحمن بن إسحاق العامري عن يزيد بن زريع العيشي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6633","788 - (  6628  ) -  وَبِإِسْنَادِهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  جَلَسَ         [11/506]      رَجُلَانِ عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَحَدُهُمَا أَشْرَفُ مِنَ الْآخَرِ  ، فَعَطَسَ الشَّرِيفُ مِنْهُمَا فَلَمْ يَحْمَدِ اللهَ ، فَلَمْ يُشَمِّتْهُ ، وَعَطَسَ الْآخَرُ فَحَمِدَ اللهَ ،  فَشَمَّتَهُ  .","","Musnad Abi Ya'la al-Mawsili 6628","","أبو هريرة الدوسي عن سعيد المقبري عن عبد الرحمن بن إسحاق العامري عن يزيد بن زريع العيشي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6634","789 - (  6629  ) -  حَدَّثَنَا  عَمْرُو بْنُ الضَّحَّاكِ بْنِ مَخْلَدٍ ،  حَدَّثَنَا  أَبِي  ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَجْلَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا مِنْ أَمِيرِ عَشَرَةٍ إِلَّا يُؤْتَى بِهِ يَوْمَ الْقِيَامَةِ مَغْلُولًا حَتَّى يَفُكَّ عَنْهُ الْعَدْلُ ، أَوْ يُوبِقَهُ الْجَوْرُ  .","","Musnad Abi Ya'la al-Mawsili 6629","","أبو هريرة الدوسي عن عجلان مولى فاطمة بنت عتبة عن محمد بن عجلان عن أبو عاصم النبيل عن عمرو بن الضحاك بن مخلد عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6635","790 - (  6630  ) -  حَدَّثَنَا  الْأَشَجُّ ،  حَدَّثَنَا  أَبُو خَالِدٍ ،  عَنِ  ابْنِ عَجْلَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَشَكَا إِلَيْهِ جَارًا لَهُ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثَلَاثَ مَرَّاتٍ : اصْبِرْ ، ثُمَّ قَالَ لَهُ فِي  الرَّابِعَةِ أَوِ الثَّالِثَةِ  :  اطْرَحْ مَتَاعَكَ فِي الطَّرِيقِ ، قَالَ : فَجَعَلَ النَّاسُ يَمُرُّونَ عَلَيْهِ فَيَقُولُونَ : مَا لَكَ ؟  قَالَ : آذَاهُ جَارُهُ ، فَجَعَلُوا يَقُولُونَ : لَعَنَهُ اللهُ ، فَجَاءَ جَارُهُ ، فَقَالَ : تَرُدُّ مَتَاعَكَ وَلَا أُوذِيكَ أَبَدًا  .         [11/507]","","Musnad Abi Ya'la al-Mawsili 6630","","أبو هريرة الدوسي عن عجلان مولى فاطمة بنت عتبة عن محمد بن عجلان عن سليمان بن حيان الأحمر عن عبد الله بن سعيد الأشج عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6636","791 - (  6631  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ سَعِيدٍ ،  عَنْ  سَعِيدٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  كَيْفَ أَنْتُمْ إِذَا لَمْ  تَجْتَبُوا  دِينَارًا وَلَا دِرْهَمًا  ؟ قَالُوا : وَتَرَى ذَلِكَ كَائِنًا ؟ قَالَ :  إِي  وَالَّذِي نَفْسُ  أَبِي هُرَيْرَةَ  بِيَدِهِ ، عَنْ قَوْلِ الصَّادِقِ الْمُصَدَّقِ ، قَالُوا : وَعَمَّ يَكُونُ هَذَا ؟ قَالَ :  تُنْتَهَكُ  ذِمَّةُ اللهِ وَذِمَّةُ رَسُولِهِ ، فَيَشُدُّ اللهُ قُلُوبَ أَهْلِ الذِّمَّةِ ، فَيَمْنَعُونَ مَا فِي أَيْدِيهِمْ  .         [11/508]             [11/509]","","Musnad Abi Ya'la al-Mawsili 6631","","أبو هريرة الدوسي عن سعيد بن عمرو بن سعيد بن العاص العذري عن إسحاق بن سعيد بن عمرو السعيدي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6637","792 - (  6632  ) -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَخْبَرَنَا  خَالِدٌ ،  عَنِ  الْجُرَيْرِيِّ ،  عَنْ  مُضَارِبٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  قُلْتُ : هَلْ سَمِعْتَ مِنْ  خَلِيلِكَ  حَدِيثًا تُحَدِّثُهُ ؟ قَالَ : نَعَمْ سَمِعْتُهُ يَقُولُ :  لَا  عَدْوَى  ، وَلَا  طِيَرَةَ ،  وَخَيْرُ الطِّيَرَةِ  الْفَأْلُ  ، وَالْعَيْنُ حَقٌّ ،  وَيُوشِكُ  الصَّلِيبُ أَنْ يُكْسَرَ ، وَيُقْتَلَ الْخِنْزِيرُ ، وَتُوضَعَ الْجِزْيَةُ  .         [11/510]             [11/511]","","Musnad Abi Ya'la al-Mawsili 6632","","أبو هريرة الدوسي عن مضارب بن حزن المجاشعي عن سعيد بن إياس الجريري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6638","793 - (  6633  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ خُثَيْمِ بْنِ عِرَاكِ بْنِ مَالِكٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَهْلًا عَنِ اللهِ ، مَهْلًا  ، فَإِنَّهُ لَوْلَا شُيُوخٌ رُكَّعٌ ، وَشَبَابٌ خُشَّعٌ ، وَأَطْفَالٌ رُضَّعٌ ، وَبَهَائِمُ رُتَّعٌ ، لَصُبَّ عَلَيْكُمُ الْعَذَابُ صَبًّا  .","","Musnad Abi Ya'la al-Mawsili 6633","","أبو هريرة الدوسي عن عراك بن مالك الغفاري عن خثيم بن عراك الغفاري عن إبراهيم بن خثيم الغفاري عن سريج بن يونس المروزي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6639","794 - (  6634  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْمُخَرِّمِيُّ ،  حَدَّثَنَا  يُونُسُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  أَشْعَثُ بْنُ بَرَازٍ ،  حَدَّثَنَا  قَتَادَةُ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَوَّلُ مَا يُرْفَعُ مِنْ هَذِهِ الْأُمَّةِ الْحَيَاءُ وَالْأَمَانَةُ  ، وَآخِرُ مَا يَبْقَى مِنْهَا الصَّلَاةُ ،  يُخَيَّلُ إِلَيَّ أَنْ قَالَ : وَقَدْ يُصَلِّي قَوْمٌ لَا  خَلَاقَ  لَهُمْ  .         [11/512]","","Musnad Abi Ya'la al-Mawsili 6634","","أبو هريرة الدوسي عن عبد الله بن شقيق العقيلي عن قتادة بن دعامة عن أشعث بن براز الهجيمي عن يونس بن محمد بن مسلم البغدادي عن محمد بن عبد الله بن المبارك المخرمي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6640","795 - (  6635  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ سَلَمَةَ الْبَصْرِيُّ ،  حَدَّثَنَا  أَشْعَثُ بْنُ بَرَازٍ ،  عَنِ  الْحَسَنِ ، قَالَ :  لَمَّا نَزَلَتْ هَذِهِ الْآيَةُ :         {      لَتُسْأَلُنَّ يَوْمَئِذٍ عَنِ النَّعِيمِ         }      ، قَالُوا :  يَا رَسُولَ اللهِ ، أَيُّ نَعِيمٍ نُسْأَلُ عَنْهُ ؟ سُيُوفُنَا عَلَى عَوَاتِقِنَا  . وَذَكَرَ الْحَدِيثَ .","","Musnad Abi Ya'la al-Mawsili 6635","","الحسن البصري عن أشعث بن براز الهجيمي عن عبد الله بن سلمة بن عياش البصري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6641","796 - (  6636  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ سَلِمَةَ ،  حَدَّثَنَا  أَشْعَثُ بْنُ بَرَازٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،         [11/513]      عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِمِثْلِ هَذَا .","","Musnad Abi Ya'la al-Mawsili 6636","","أبو هريرة الدوسي عن عبد الله بن شقيق العقيلي عن قتادة بن دعامة عن أشعث بن براز الهجيمي عن عبد الله بن سلمة عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6642","797 - (  6637  ) -  حَدَّثَنَا  صَالِحُ بْنُ مَالِكٍ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ أَبِي الْمُسَاوِرِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ عَطَاءٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا مِنْ مُسْلِمٍ يَتَوَضَّأُ فَيُحْسِنُ الْوُضُوءَ  ، ثُمَّ يَمْشِي إِلَى بَيْتٍ مِنْ بُيُوتِ اللهِ يُصَلِّي فِيهِ صَلَاةً مَكْتُوبَةً ، إِلَّا كُتِبَ لَهُ بِكُلِّ خُطْوَةٍ حَسَنَةٌ ، وَتُمْحَى عَنْهُ بِالْأُخْرَى سَيِّئَةٌ ، وَتُرْفَعُ لَهُ بِالْأُخْرَى دَرَجَةٌ  .         [11/514]","","Musnad Abi Ya'la al-Mawsili 6637","","أبو هريرة الدوسي عن محمد بن عمرو بن عطاء العامري عن عبد الأعلى بن أبي المساور الجرار عن صالح بن مالك الخوارزمي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6643","798 - (  6638  ) -  حَدَّثَنَا  صَالِحُ بْنُ مَالِكٍ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ أَبِي الْمُسَاوِرِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ عَطَاءٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا مِنْ عَبْدٍ يَمْرَضُ مَرَضًا  ، إِلَّا أَمَرَ اللهُ حَافِظَهُ أَنَّ مَا عَمِلَ مِنْ سَيِّئَةٍ فَلَا يَكْتُبْهَا ، وَمَا عَمِلَ مِنْ حَسَنَةٍ أَنْ يَكْتُبَهَا لَهُ عَشْرَ حَسَنَاتٍ ، وَأَنْ يَكْتُبَ لَهُ مِنَ الْعَمَلِ الصَّالِحِ كَمَا كَانَ يَعْمَلُ وَهُوَ صَحِيحٌ ، وَإِنْ لَمْ يَعْمَلْ  .","","Musnad Abi Ya'la al-Mawsili 6638","","أبو هريرة الدوسي عن محمد بن عمرو بن عطاء العامري عن عبد الأعلى بن أبي المساور الجرار عن صالح بن مالك الخوارزمي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6644","799 - (  6639  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى الْوَاسِطِيُّ ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  زَكَرِيَّا ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ ،  يَرْفَعُ الْحَدِيثَ  قَالَ :  الرَّهْنُ يُرْكَبُ         [11/515]      وَيُعْلَفُ  ، وَلَبَنُ  الدَّرِّ  يُشْرَبُ ، وَعَلَى الَّذِي يَشْرَبُهُ النَّفَقَةُ  وَالْعَلَفُ  .         [11/516]","","Musnad Abi Ya'la al-Mawsili 6639","","أبو هريرة الدوسي عن الشعبي عن زكريا بن أبي زائدة الوادعي عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6645","800 - (  6640  ) -  حَدَّثَنَا  زَكَرِيَّا ،  حَدَّثَنَا  دَاوُدُ بْنُ الزِّبْرِقَانِ ،  حَدَّثَنَا  دَاوُدُ بْنُ أَبِي هِنْدَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ صَلَّى عَلَى جِنَازَةٍ فَلَهُ قِيرَاطٌ  ، وَمَنِ انْتَظَرَ حَتَّى تُدْفَنَ فَلَهُ قِيرَاطَانِ ، الْقِيرَاطُ مِثْلُ  أُحُدٍ  .","","Musnad Abi Ya'la al-Mawsili 6640","","أبو هريرة الدوسي عن الشعبي عن داود بن أبي هند عن داود بن الزبرقان عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6646","801 - (  6641  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  وُهَيْبٌ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدَ ،  عَنْ  عَامِرٍ ،         [11/517]      عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ تُنْكَحَ الْمَرْأَةُ عَلَى عَمَّتِهَا  ، وَالْخَالَةُ عَلَى ابْنَةِ أُخْتِهَا ، وَلَا تُنْكَحُ الصُّغْرَى عَلَى الْكُبْرَى ، وَلَا الْكُبْرَى عَلَى الصُّغْرَى  .         [11/518]             [11/519]","","Musnad Abi Ya'la al-Mawsili 6641","","أبو هريرة الدوسي عن الشعبي عن داود بن أبي هند عن وهيب بن خالد الكرابيسي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6647","802 - (  6642  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا  طَلْحَةُ بْنُ سِنَانٍ الْإِيَامِيُّ ،  حَدَّثَنَا  دَاوُدُ بْنُ أَبِي هِنْدَ ،  عَنْ  عَامِرٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ  آدَمَ  لَقِيَهُ  مُوسَى  ، فَقَالَ لَهُ : أَنْتَ  آدَمُ  الَّذِي أَخْرَجْتَ النَّاسَ مِنَ الْجَنَّةِ  ؟  . الْحَدِيثَ  .         [11/520]","","Musnad Abi Ya'la al-Mawsili 6642","","أبو هريرة الدوسي عن الشعبي عن داود بن أبي هند عن طلحة بن سنان بن الحارث الأيامي عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6648","803 - (  6643  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ، أَنَّ زَكَرِيَّا  أَخْبَرَهُمْ  ،  عَنْ  عَامِرٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنِّي أَوَّلُ مَنْ يَرْفَعُ رَأْسَهُ بَعْدَ النَّفْخَةِ الْآخِرَةِ  ، فَإِذَا  مُوسَى  مُتَعَلِّقٌ بِالْعَرْشِ ، فَلَا أَدْرِي أَكَذَلِكَ كَانَ أَمْ بَعْدَ النَّفْخَةِ  .         [11/521]","","Musnad Abi Ya'la al-Mawsili 6643","","أبو هريرة الدوسي عن الشعبي عن زكريا بن أبي زائدة الوادعي عن عبد الرحيم بن سليمان الأشل عن الوليد بن شجاع عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6649","804 - (  6644  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى ،  حَدَّثَنَا  ابْنُ وَهْبٍ ،  حَدَّثَنَا  عَمْرُو بْنُ الْحَارِثِ ، أَنَّ أَبَا السَّمْحِ  حَدَّثَهُ  عَنِ  ابْنِ حُجَيْرَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ :  الْمُؤْمِنُ فِي قَبْرِهِ فِي رَوْضَةٍ  ، وَيُرَحَّبُ لَهُ قَبْرُهُ سَبْعِينَ ذِرَاعًا ، وَيُنَوَّرُ لَهُ كَالْقَمَرِ لَيْلَةَ الْبَدْرِ ، أَتَرَوْنَ فِيمَا أُنْزِلَتْ هَذِهِ الْآيَةُ :         {      فَإِنَّ لَهُ مَعِيشَةً ضَنْكًا وَنَحْشُرُهُ يَوْمَ الْقِيَامَةِ أَعْمَى         }      ، قَالَ : أَتَدْرُونَ مَا الْمَعِيشَةُ الضَّنْكُ ؟ قَالُوا : اللهُ وَرَسُولُهُ         [11/522]      أَعْلَمُ ، قَالَ : عَذَابُ الْكَافِرِ فِي قَبْرِهِ ، وَالَّذِي نَفْسِي بِيَدِهِ إِنَّهُ لَيُسَلَّطُ عَلَيْهِمْ تِسْعَةٌ وَتِسْعُونَ تِنِّينًا ، أَتَدْرُونَ مَا التِّنِّينُ ؟ قَالَ : تِسْعَةٌ وَتِسْعُونَ حَيَّةً ، لِكُلِّ حَيَّةٍ سَبْعَةُ رُءُوسٍ يَنْفُخُونَ فِي جِسْمِهِ وَيَلْسَعُونَهُ وَيَخْدِشُونَهُ إِلَى يَوْمِ الْقِيَامَةِ  .         [11/523]","","Musnad Abi Ya'la al-Mawsili 6644","","أبو هريرة الدوسي عن عبد الرحمن بن حجيرة الخولاني عن دراج أبي السمح عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6650","805 - (  6645  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ أَبِي ثَوْرٍ ،  عَنْ  عَاصِمِ بْنِ بَهْدَلَةَ ،  عَنْ  زِيَادِ بْنِ قَيْسٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  وَيْلٌ لِلْعَرَبِ مِنْ شَرٍّ قَدِ اقْتَرَبَ  ، يَنْقُصُ الْعِلْمُ ، وَيَكْثُرُ  الْهَرْجُ  ، قَالَ : قُلْتُ : مَا يَكْثُرُ  الْهَرْجُ  يَا رَسُولَ اللهِ ؟ قَالَ : الْقَتْلُ ، الْقَتْلُ  .","","Musnad Abi Ya'la al-Mawsili 6645","","أبو هريرة الدوسي عن زياد بن قيس القرشي عن عاصم بن بهدلة عن الوليد بن عبد الله بن أبي ثور المرهبي عن محمد بن بكار الرصافي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6651","806 - (  6646  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  حَدَّثَنَا  عِصَامُ بْنُ         [11/524]      طَلِيقٍ الْبَصْرِيُّ ،  عَنْ  شُعَيْبِ بْنِ الْعَلَاءِ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  قُتِلَ رَجُلٌ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - شَهِيدًا ، قَالَ : فَبَكَتْ عَلَيْهِ بَاكِيَةٌ فَقَالَتْ : وَاشَهِيدَاهُ ، قَالَ : فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَهْ مَا يُدْرِيكِ أَنَّهُ شَهِيدٌ ، وَلَعَلَّهُ كَانَ يَتَكَلَّمُ بِمَا لَا يَعْنِيهِ  ، وَيَبْخَلُ بِمَا لَا يَنْقُصُهُ  .","","Musnad Abi Ya'la al-Mawsili 6646","","أبو هريرة الدوسي عن شعيب بن العلاء عن عصام بن طليق الطفاوي عن محمد بن بكار الرصافي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6652","807 - (  6647  ) -  حَدَّثَنَا  هُدْبَةُ ،  حَدَّثَنَا  سَلَّامُ بْنُ مِسْكِينٍ ،  عَنْ  ثَابِتٍ ،  عَنْ  عَبْدِ اللهِ بْنِ رَبَاحٍ ،  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَارَ إِلَى  مَكَّةَ  لِيَفْتَحَهَا ، قَالَ  لِأَبِي هُرَيْرَةَ  : يَا  أَبَا هُرَيْرَةَ  ،  اهْتِفْ  بِالْأَنْصَارِ  ، فَقَالَ : يَا مَعْشَرَ  الْأَنْصَارِ  ، أَجِيبُوا رَسُولَ اللهِ ، فَجَاءُوا كَأَنَّمَا كَانُوا         [11/525]      عَلَى مِيعَادٍ ، قَالَ : خُذُوا هَذَا الطَّرِيقَ فَلَا يُشْرِفْ لَكُمْ أَحَدٌ إِلَّا أَنَمْتُمُوهُ ، أَيْ : قَتَلْتُمُوهُ ، فَسَارَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَفَتَحَ اللهُ عَلَيْهِ ، قَالَ : فَطَافَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِالْبَيْتِ  وَصَلَّى رَكْعَتَيْنِ ، ثُمَّ خَرَجَ مِنَ الْبَابِ الَّذِي يَلِي  الصَّفَا  ، فَصَعِدَ  الصَّفَا  فَخَطَبَ النَّاسَ ،  وَالْأَنْصَارُ  أَسْفَلَ مِنْهُ ، فَقَالَتِ  الْأَنْصَارُ  بَعْضُهُمْ لِبَعْضٍ : أَمَّا الرَّجُلُ فَقَدْ أَخَذَتْهُ رَأْفَةٌ بِقَوْمِهِ ، وَالرَّغْبَةُ فِي قَرْيَتِهِ ، فَأَنْزَلَ اللهُ تَعَالَى عَلَيْهِ الْوَحْيَ بِمَا قَالَتِ  الْأَنْصَارُ  ، فَقَالَ : يَا مَعْشَرَ  الْأَنْصَارِ  ، تَقُولُونَ : أَمَّا الرَّجُلُ فَقَدْ أَدْرَكَتْهُ الرَّأْفَةُ بِقَوْمِهِ ، وَالرَّغْبَةُ فِي قَرْيَتِهِ ؟ فَمَنْ أَنَا إِذًا ؟  كَلَّا وَاللهِ إِنِّي عَبْدُ اللهِ وَرَسُولُهُ ، وَإِنَّ  الْمَحْيَا  مَحْيَاكُمْ  وَالْمَمَاتَ مَمَاتُكُمْ .  قَالُوا : يَا رَسُولَ اللهِ ، مَا قُلْنَا ذَلِكَ إِلَّا مَخَافَةَ أَنْ تُفَارِقَنَا ، قَالَ : أَنْتُمْ صَادِقُونَ عِنْدَ اللهِ وَعِنْدَ رَسُولِهِ . فَوَاللهِ مَا مِنْهُمْ أَحَدٌ إِلَّا بَلَّ نَحْرَهُ بِدُمُوعٍ مِنْ عَيْنِهِ  .","","Musnad Abi Ya'la al-Mawsili 6647","","أبو هريرة الدوسي عن عبد الله بن رباح الأنصاري عن ثابت البناني عن سلام بن مسكين النمري عن هدبة بن خالد عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6653","808 - (  6648  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْمَقَابِرِيُّ ،  حَدَّثَنَا  إِسْمَاعِيلُ ، قَالَ :  حَدَّثَنِي  مُحَمَّدٌ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَعْقُوبَ مَوْلَى الْحُرَقَةِ ،         [11/526]      عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِزْرَةُ  الْمُؤْمِنِ إِلَى أَنْصَافِ السَّاقَيْنِ  وَأَسْفَلُ ذَلِكَ إِلَى مَا فَوْقَ  الْكَعْبَيْنِ ،  فَمَا كَانَ أَسْفَلَ مِنَ  الْكَعْبَيْنِ  فَفِي النَّارِ  .         [11/527]","","Musnad Abi Ya'la al-Mawsili 6648","","أبو هريرة الدوسي عن عبد الرحمن بن يعقوب الجهني عن محمد بن عمرو بن علقمة بن وقاص الليثي عن إسماعيل بن جعفر بن أبي كثير الزرقي عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6654","809 - (  6649  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا ،  عَنْ  عَاصِمٍ الْأَحْوَلِ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  قَسَمَ رَسُولُ اللهِ صَلَّيِ اللهُ عَلَيْهِ وَسَلَّمَ تَمْرًا ، فَأَصَبَنِي خَمْسُ تَمَرَاتٍ وَحَشَفَةٌ  ، قَالَ : فَرَأَيْتُ الْحَشَفَةَ أَشَدَّهُمْ لِضِرْسِي  .         [11/528]","","Musnad Abi Ya'la al-Mawsili 6649","","أبو هريرة الدوسي عن أبو عثمان النهدي عن عاصم بن سليمان الأحول عن إسماعيل بن زكريا شقوصا عن محمد بن بكار الرصافي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6655","[12/5]      تَابِعْ مُسْنَدَ  أَبِي هُرَيْرَةَ  809 - (  6649  (م)  -  وَقَالَ  أَبُو هُرَيْرَةَ :  إِنَّ أَبْخَلَ النَّاسِ مَنْ بَخِلَ بِالسَّلَامِ  ، وَأَعْجَزَ النَّاسِ مَنْ عَجَزَ عَنِ الدُّعَاءِ  .","","Musnad Abi Ya'la al-Mawsili 6649","","أبو هريرة الدوسي عن أبو عثمان النهدي عن عاصم بن سليمان الأحول عن إسماعيل بن زكريا شقوصا عن محمد بن بكار الرصافي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6656","810 - (  6650  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  ثَابِتٍ ،  عَنْ  أَبِي عُثْمَانَ ،  أَنَّ  أَبَا هُرَيْرَةَ كَانَ فِي سَفَرٍ ، فَلَمَّا نَزَلُوا وَوُضِعَتِ  السُّفْرَةُ  ، بَعَثُوا إِلَيْهِ وَهُوَ يُصَلِّي ، فَقَالَ : إِنِّي صَائِمٌ ، فَلَمَّا كَادُوا أَنْ يَفْرُغُوا ، جَاءَ فَجَعَلَ يَأْكُلُ ، فَنَظَرَ  الْقَوْمُ  إِلَى رَسُولِهِمْ ، فَقَالَ : مَا تَنْظُرُونَ ؟ قَدْ وَاللهِ أَخْبَرَنِي أَنَّهُ صَائِمٌ .  فَقَالَ  أَبُو هُرَيْرَةَ  : صَدَقَ ، سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ صَامَ ثَلَاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ فَقَدْ صَامَ الدَّهْرَ كُلَّهُ  ، وَقَدْ صُمْتُ ثَلَاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ ، فَلِيَ  الشَّهْرُ  كُلُّهُ ، وَوَجَدْتُ تَصْدِيقَ ذَلِكَ فِي كِتَابِ اللهِ عَزَّ وَجَلَّ :         {      مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ عَشْرُ أَمْثَالِهَا         }      ،         [12/6]      وَقَرَأَهُ مَرَّةً أُخْرَى ، فَقَالَ : وَقَدْ صُمْتُ ثَلَاثَةَ أَيَّامٍ مِنْ أَوَّلِ  الشَّهْرِ  ، وَأَنَا مُفْطِرٌ فِي تَخْفِيفِ اللهِ ، صَائِمٌ فِي تَضْعِيفِ اللهِ عَزَّ وَجَلَّ  .         [12/7]","","Musnad Abi Ya'la al-Mawsili 6650","","أبو هريرة الدوسي عن أبو عثمان النهدي عن ثابت البناني عن حماد بن زيد عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6657","811 - (  6651  ) -  حَدَّثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الْجَبَّارِ أَبُو أَيُّوبَ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ الْحَضْرَمِيُّ ،  عَنْ  عَبْدِ السَّلَامِ بْنِ عَجْلَانَ الْهُجَيْمِيِّ ،  حَدَّثَنَا  أَبُو عُثْمَانَ النَّهْدِيُّ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَنَا أَوَّلُ مَنْ يُفْتَحُ لَهُ بَابُ الْجَنَّةِ  ، إِلَّا أَنَّهُ تَأْتِي امْرَأَةٌ تُبَادِرُنِي ، فَأَقُولُ لَهَا : مَا لَكِ ؟ وَمَنْ أَنْتِ ؟ فَتَقُولُ : أَنَا امْرَأَةٌ قَعَدْتُ عَلَى أَيْتَامٍ لِي  .","","Musnad Abi Ya'la al-Mawsili 6651","","أبو هريرة الدوسي عن أبو عثمان النهدي عن صاحب الطعام عبد السلام بن عجلان عن يعقوب بن إسحاق بن زيد الحضرمي عن سليمان بن عبد الجبار الخياط عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6658","812 - (  6652  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ  صَفِيِّي  وَخَلِيلِي  أَبُو الْقَاسِمِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَاحِبُ هَذِهِ الْحُجْرَةِ :  مَا نُزِعَتِ الرَّحْمَةُ إِلَّا مِنْ شَقِيٍّ  .         [12/8]","","Musnad Abi Ya'la al-Mawsili 6652","","أبو هريرة الدوسي عن أبو عثمان التبان عن منصور بن المعتمر عن جرير بن عبد الحميد عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6659","813 - (  6653  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  حَدَّثَنَا  أَبِي  ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  عَبَّاسٍ الْجُرَيْرِيِّ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ :  قَسَمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَيْنَنَا سَبْعَ تَمَرَاتٍ  ، كُنَّا سَبْعَةً وَأَعْطَانَا تَمْرَةً تَمْرَةً  .","","Musnad Abi Ya'la al-Mawsili 6653","","أبو هريرة الدوسي عن أبو عثمان النهدي عن عباس بن فروخ الجريري عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6660","814 - (  6654  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الصَّمَدِ ،  حَدَّثَنَا  الْقَاسِمُ ،  عَنْ  هِشَامٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ قَالَ : كَانَ  يُخْبِرُنَا  عَنْ  ذَكْوَانَ أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَمَّا خَلَقَ اللهُ عَزَّ وَجَلَّ  آدَمَ  ، مَسَحَ عَلَى ظَهْرِهِ فَسَقَطَ مِنْ ظَهْرِهِ كُلُّ  نَسَمَةٍ  هُوَ خَالِقُهَا إِلَى يَوْمِ الْقِيَامَةِ  ، وَجَعَلَ بَيْنَ عَيْنَيْ كُلِّ إِنْسَانٍ مِنْهُمْ  وَبِيصًا  مِنْ نُورٍ ، ثُمَّ عَرَضَهُمْ عَلَى  آدَمَ  ، فَقَالَ : أَيْ رَبِّ مَنْ هَؤُلَاءِ ؟         [12/9]      قَالَ : هَؤُلَاءِ ذُرِّيَّتُكَ ، فَرَأَى رَجُلًا مِنْهُمْ ، فَأَعْجَبَهُ  وَبِيصُ  مَا بَيْنَ عَيْنَيْهِ ، فَقَالَ : أَيْ رَبِّ مَنْ هَذَا ؟ قَالَ : رَجُلٌ مِنْ ذُرِّيَّتِكَ فِي آخِرِ الْأُمَمِ يُقَالُ لَهُ :  دَاوُدُ  ، قَالَ : يَا رَبِّ ، كَمْ جَعَلْتَ عُمُرَهُ ؟ قَالَ : سِتِّينَ سَنَةً ، قَالَ : زِدْهُ مِنْ عُمُرِي أَرْبَعِينَ سَنَةً ، قَالَ : إِذًا يُكْتَبُ وَيُخْتَمُ وَلَا يُبَدَّلُ ، فَلَمَّا انْقَضَى عُمُرُ  آدَمَ  عَلَيْهِ السَّلَامُ جَاءَهُ  مَلَكُ الْمَوْتِ  ، فَقَالَ : أَوَلَمْ يَبْقَ مِنْ عُمُرِي أَرْبَعُونَ سَنَةً ؟ قَالَ : أَوَلَمْ تُعْطِهَا ابْنَكَ  دَاوُدَ  ؟ فَجَحَدَ فَجَحَدَتْ ذُرِّيَّتُهُ ، وَنَسِيَ فَنَسِيَتْ ذُرِّيَّتُهُ ، وَخَطِئَ فَخَطِئَتْ ذُرِّيَّتُهُ  .         [12/10]","","Musnad Abi Ya'la al-Mawsili 6654","","أبو هريرة الدوسي عن ذكوان السمان عن زيد بن أسلم عن هشام بن سعد المخزومي عن القاسم بن الحكم بن كثير عن عبد الله بن عبد الصمد عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6661","815 - (  6655  ) -  حَدَّثَنَا  شُجَاعُ بْنُ مَخْلَدٍ ،  حَدَّثَنَا  مَرْوَانُ ،  عَنْ  أَبِي الْمَلِيحِ الْمَدَنِيِّ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ لَا يَسْأَلِ اللهَ يَغْضَبْ عَلَيْهِ  .         [12/11]","","Musnad Abi Ya'la al-Mawsili 6655","","أبو هريرة الدوسي عن أبو صالح الخوزي عن أبو المليح الخراط عن مروان بن معاوية الفزاري عن شجاع بن مخلد الفلاس عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6662","816 - (  6656  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ رَبِيعَةَ ،  عَنْ  كَامِلٍ أَبِي الْعَلَاءِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  عُمْرُ أُمَّتِي مَا بَيْنَ السِّتِّينَ سَنَةً إِلَى السَّبْعِينَ  .","","Musnad Abi Ya'la al-Mawsili 6656","","أبو هريرة الدوسي عن أبو صالح مولى ضباعة بنت الزبير بن العوام عن كامل بن العلاء التميمي عن محمد بن ربيعة بن سمير الرؤاسي عن إبراهيم بن سعيد الجوهري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6663","817 - (  6657  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ،  عَنْ  مَالِكٍ ،  عَنْ  سُمَيٍّ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْعُمْرَةُ إِلَى الْعُمْرَةِ كَفَّارَةٌ لِمَا بَيْنَهُمَا  ، وَالْحَجُّ  الْمَبْرُورُ  لَيْسَ لَهُ جَزَاءٌ إِلَّا الْجَنَّةَ  .         [12/12]","","Musnad Abi Ya'la al-Mawsili 6657","","أبو هريرة الدوسي عن ذكوان السمان عن سمي المخزومي عن مالك بن أنس عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6664","818 - (  6658  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى الْمِصْرِيُّ ،  حَدَّثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  عُمَارَةَ بْنِ غَزِيَّةَ ،  عَنْ  سُمَيٍّ ،  أَنَّهُ سَمِعَ  أَبَا صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ أَقْرَبَ مَا يَكُونُ الْعَبْدُ مِنْ رَبِّهِ وَهُوَ سَاجِدٌ  ، فَأَكْثِرُوا الدُّعَاءَ  .         [12/13]","","Musnad Abi Ya'la al-Mawsili 6658","","أبو هريرة الدوسي عن ذكوان السمان عن سمي المخزومي عن عمارة بن غزية عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6665","819 - (  6659  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  سُمَيٍّ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ ،  يَبْلُغُ بِهِ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ صَلَّى عَلَى جِنَازَةٍ فَلَهُ قِيرَاطٌ  ، وَمَنْ تَبِعَهَا حَتَّى يُفْرَغَ مِنْهَا فَلَهُ قِيرَاطَانِ ، أَصْغَرُهُمَا أَوْ أَحَدُهُمَا مِثْلُ  أُحُدٍ  .","","Musnad Abi Ya'la al-Mawsili 6659","","أبو هريرة الدوسي عن ذكوان السمان عن سمي المخزومي عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6666","820 - (  6660  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  سُفْيَانُ ،  أَخْبَرَنِي  سُمَيٌّ ،  عَنْ  أَبِي صَالِحٍ ،         [12/14]      عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْحَجُّ  الْمَبْرُورُ  لَيْسَ لَهُ جَزَاءٌ إِلَّا الْجَنَّةَ  ، وَالْعُمْرَةُ إِلَى الْعُمْرَةِ أَوِ الْعُمْرَتَانِ ، تُكَفِّرُ مَا بَيْنَهُمَا  .","","Musnad Abi Ya'la al-Mawsili 6660","","أبو هريرة الدوسي عن ذكوان السمان عن سمي المخزومي عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6667","821 - (  6661  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  سُمَيٍّ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ ،  يَبْلُغُ بِهِ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Musnad Abi Ya'la al-Mawsili 6661","","أبو هريرة الدوسي عن ذكوان السمان عن سمي المخزومي عن سفيان بن عيينة عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6668","822 - (  6662  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ، وَدَاوُدُ بْنُ عَمْرٍو ، قَالَ أَبُو يَعْلَى : نَسَخْتُهُ مِنْ نُسْخَةِ  أَبِي خَيْثَمَةَ  ، قَالَا :  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنَا  سُمَيٌّ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَتَعَوَّذُ مِنْ  جَهْدِ  الْبَلَاءِ  ،  وَدَرَكِ  الشَّقَاءِ ، وَسُوءِ الْقَضَاءِ ،  وَشَمَاتَةِ  الْأَعْدَاءِ  .         [12/15]             [12/16]             [12/17]","","Musnad Abi Ya'la al-Mawsili 6662","","أبو هريرة الدوسي عن ذكوان السمان عن سمي المخزومي عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6669","823 - (  6663  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  خَالِدُ بْنُ الْحَارِثِ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  سُمَيٍّ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا عَطَسَ ،  غَضَّ  بِهَا صَوْتَهُ  ، وَأَمْسَكَ عَلَى وَجْهِهِ  .         [12/18]","","Musnad Abi Ya'la al-Mawsili 6663","","أبو هريرة الدوسي عن ذكوان السمان عن سمي المخزومي عن محمد بن عجلان عن خالد الصدق عن إسحاق ابن راهويه عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6670","824 - (  6664  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَرَجِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الزِّبْرِقَانِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَجْلَانَ ،  عَنْ  سُمَيٍّ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ بَعْضَ أَصْحَابِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالُوا : يَا رَسُولَ اللهِ ،  إِنَّ تَفْرِيجَ الْأَيْدِي يَشُقُّ عَلَيْنَا فِي الصَّلَاةِ  ، فَأَمَرَهُمْ أَنْ يَسْتَعِينُوا بِالرُّكَبِ  .         [12/19]","","Musnad Abi Ya'la al-Mawsili 6664","","أبو هريرة الدوسي عن ذكوان السمان عن سمي المخزومي عن محمد بن عجلان عن محمد بن الزبرقان الأهوازي عن محمد بن الفرج الفراء عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6671","825 - (  6665  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي النَّضْرِ ،  حَدَّثَنَا  أَبُو النَّضْرِ قَالَ :  حَدَّثَنَا  الْمُرَجَّى بْنُ رَجَاءٍ الْيَشْكُرِيُّ ،  حَدَّثَنَا  عِيسَى بْنُ هِلَالٍ ،  عَنْ  بَشِيرِ بْنِ نَهِيكٍ قَالَ :  سَمِعْتُ  أَبَا هُرَيْرَةَ يَقُولُ : حَدَّثَنِي  خَلِيلِي  أَبُو الْقَاسِمِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تَقُومُ السَّاعَةُ حَتَّى يَخْرُجَ عَلَيْهِمْ رَجُلٌ مِنْ أَهْلِ بَيْتِي  ، فَيَضْرِبَهُمْ حَتَّى يَرْجِعُوا إِلَى الْحَقِّ ، قَالَ : قُلْتُ : وَكَمْ يَكُونُ ؟ قَالَ : خَمْسٌ ، وَاثْنَيْنِ ، قَالَ : قُلْتُ : مَا خَمْسٌ وَاثْنَيْنِ ؟ قَالَ : لَا أَدْرِي  .         [12/20]","","Musnad Abi Ya'la al-Mawsili 6665","","أبو هريرة الدوسي عن بشير بن نهيك عن عيسى بن هلال السليحي عن مرجى بن رجاء اليشكري عن هاشم بن القاسم بن مسلم عن أبو بكر بن النضر بن أبي النضر البغدادي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6672","826 - (  6666  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  ثَابِتٍ ،  عَنْ  أَبِي عُثْمَانَ ،  أَنَّ  أَبَا هُرَيْرَةَ ،  كَانَ فِي سَفَرٍ ، فَلَمَّا نَزَلُوا وُضِعَتِ  السُّفْرَةُ  ، فَقَعَدُوا إِلَيْهِ  ، وَذَكَرَ الْحَدِيثَ .","","Musnad Abi Ya'la al-Mawsili 6666","","أبو هريرة الدوسي عن أبو عثمان النهدي عن ثابت البناني عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6673","827 - (  6667  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ حُمَيْدٍ ،  حَدَّثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  عِكْرِمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَرَّ  بِرَجُلٍ  يَسُوقُ بَدَنَةً ، قَالَ : ارْكَبْهَا  ، قَالَ : إِنَّهَا بَدَنَةٌ ، قَالَ : ارْكَبْهَا ، قَالَ : فَلَقَدْ رَأَيْتُهُ يُسَايِرُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَفِي عُنُقِهَا نَعْلٌ  .","","Musnad Abi Ya'la al-Mawsili 6667","","أبو هريرة الدوسي عن عكرمة مولى ابن عباس عن يحيى بن أبي كثير عن معمر بن راشد عن عبد الله بن المبارك عن جعفر بن حميد زنبقة عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6674","828 - (  6668  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ قَالَ :  حَدَّثَنِي  مُوسَى بْنُ عَبْدِ الْعَزِيزِ ، يَعْنِي  عَنِ  الْحَكَمِ بْنِ أَبَانَ قَالَ :  حَدَّثَنِي  عِكْرِمَةُ قَالَ :  حَدَّثَنِي  أَبُو هُرَيْرَةَ قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى الْمِنْبَرِ وَهُوَ يَذْكُرُ السَّاعَةَ الَّتِي فِي الْجُمُعَةِ  ، فَرَأَيْتُهُ يَقْبِضُ أَصَابِعَهُ وَيُقَلِّلُهَا  .         [12/21]","","Musnad Abi Ya'la al-Mawsili 6668","","أبو هريرة الدوسي عن عكرمة مولى ابن عباس عن الحكم بن أبان العدني عن موسى بن عبد العزيز القنباري عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6675","829 - (  6669  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  هِشَامُ بْنُ يُوسُفَ ،  عَنْ  أُمَيَّةَ بْنِ شِبْلٍ ،  عَنِ  الْحَكَمِ بْنِ أَبَانَ ،  عَنْ  عِكْرِمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَحْكِي عَنْ  مُوسَى  عَلَيْهِ السَّلَامُ عَلَى الْمِنْبَرِ قَالَ : وَقَعَ فِي نَفْسِهِ :  هَلْ يَنَامُ اللهُ عَزَّ وَجَلَّ  ؟ فَأَرْسَلَ اللهُ إِلَيْهِ مَلَكًا فَأَرَّقَهُ ثَلَاثًا ، ثُمَّ أَعْطَاهُ قَارُورَتَيْنِ ، فِي كُلِّ يَدٍ قَارُورَةٌ ، وَأَمَرَهُ أَنْ يَحْتَفِظَ بِهَا ، قَالَ : فَجَعَلَ يَنَامُ وَتَكَادُ يَدَاهُ تَلْتَقِيَانِ ، ثُمَّ يَسْتَيْقِظُ فَيَحْبِسُ إِحْدَاهُمَا عَلَى الْأُخْرَى حَتَّى نَامَ نَوْمَةً فَاصْطَفَقَتْ يَدَاهُ ، فَانْكَسَرَتِ الْقَارُورَتَانِ ، قَالَ : ضَرَبَ اللهُ لَهُ مَثَلًا أَنَّ اللهَ عَزَّ وَجَلَّ لَوْ كَانَ يَنَامُ لَمْ تَسْتَمْسِكِ السَّمَاءُ وَالْأَرْضُ  .         [12/22]","","Musnad Abi Ya'la al-Mawsili 6669","","أبو هريرة الدوسي عن عكرمة مولى ابن عباس عن الحكم بن أبان العدني عن أمية بن شبل اليماني عن هشام بن يوسف الأبناوي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6676","830 - (  6670  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  أَبُو عُبَيْدَةَ ،  حَدَّثَنَا  هِشَامُ بْنُ حَسَّانَ ،  عَنْ  مُحَمَّدٍ هُوَ ابْنُ شَبِيبٍ ،  عَنْ  جَعْفَرِ بْنِ أَبِي وَحْشِيَّةَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَوْ كَانَ فِي هَذَا الْمَسْجِدِ مِائَةٌ أَوْ يَزِيدُونَ  ، وَفِيهِ رَجُلٌ مِنَ النَّارِ ، فَتَنَفَّسَ ، فَأَصَابَ         [12/23]      نَفَسُهُ ، لَاحْتَرَقَ الْمَسْجِدُ وَمَنْ فِيهِ  .","","Musnad Abi Ya'la al-Mawsili 6670","","أبو هريرة الدوسي عن سعيد بن جبير الأسدي عن جعفر بن إياس اليشكري عن محمد بن شبيب الزهراني عن هشام بن حسان العتكي عن عبد الواحد بن واصل عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6677","831 - (  6671  ) -  حَدَّثَنَا  بِشْرُ بْنُ سَيْحَانَ ،  حَدَّثَنَا  حَرْبُ بْنُ مَيْمُونٍ ،  حَدَّثَنَا  مُوسَى بْنُ عُبَيْدَةَ الرَّبَذِيُّ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ الْقُرَظِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ :  خَرَجْتُ أَنَا وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَيَدُهُ فِي يَدِي ، فَأَتَى عَلَى  رَجُلٍ  رَثِّ الْهَيْئَةِ قَالَ : أَبُو فُلَانٍ ؟ مَا بَلَغَ بِكَ مَا أَرَى ؟ قَالَ : السَّقَمُ وَالضُّرُّ يَا رَسُولَ اللهِ ، قَالَ :  أَلَا أُعَلِّمُكَ كَلِمَاتٍ يُذْهِبُ اللهُ عَنْكَ السَّقَمَ وَالضُّرَّ  ؟         [12/24]      قَالَ : لَا ، مَا يَسُرُّنِي بِهَا أَنِّي شَهِدْتُ مَعَكَ  بَدْرًا  وَأُحُدًا  ، قَالَ : فَضَحِكَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ قَالَ : وَهَلْ يُدْرِكُ  أَهْلُ بَدْرٍ  وَأَهْلُ أُحُدٍ  مَا يُدْرِكُ الْفَقِيرُ  الْقَانِعُ  ، قَالَ : فَقَالَ  أَبُو هُرَيْرَةَ  : يَا رَسُولَ اللهِ أَنَا فَعَلِّمْنِي ، قَالَ : قُلْ يَا  أَبَا هُرَيْرَةَ  ، تَوَكَّلْتُ عَلَى الْحَيِّ الَّذِي لَا يَمُوتُ ، الْحَمْدُ لِلهِ الَّذِي لَمْ يَتَّخِذْ وَلَدًا ، وَلَمْ يَكُنْ لَهُ شَرِيكٌ فِي الْمُلْكِ ، وَلَمْ يَكُنْ لَهُ وَلِيٌّ مِنَ الذُّلِّ وَكَبِّرْهُ تَكْبِيرًا ، قَالَ : فَأَتَى عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَقَدْ حَسُنَتْ حَالِي ، فَقَالَ : مَهْيَمْ ؟ قَالَ : قُلْتُ : يَا رَسُولَ اللهِ لَمْ أَزَلْ أَقُولُ الْكَلِمَاتِ الَّتِي عَلَّمْتَنِي  .","","Musnad Abi Ya'la al-Mawsili 6671","","أبو هريرة الدوسي عن محمد بن كعب بن سليم القرظي عن موسى بن عبيدة بن نشيط الحميري عن حرب بن ميمون العبدي عن بشر بن سيحان الثقفى عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6678","832 - (  6672  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  زِيَادٍ الْحَارِثِيِّ ،         [12/25]      عَنْ  أَبِي هُرَيْرَةَ قَالَ :  قَالَ لَهُ  رَجُلٌ  :  أَنْتَ الَّذِي تَنْهَى عَنْ صَوْمِ يَوْمِ الْجُمُعَةِ  ؟ قَالَ : لَا وَرَبِّ  هَذِهِ  الْبَنِيَّةِ  ، أَوْ هَذِهِ  الْحُرْمَةِ  ، مَا أَنَا نَهَيْتُ عَنْهُ ، نَهَى عَنْهُ  مُحَمَّدٌ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  .","","Musnad Abi Ya'la al-Mawsili 6672","","أبو هريرة الدوسي عن زياد بن النضر الحارثي عن عبد الملك بن عمير القبطي عن شريك بن عبد الله النخعي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6679","833 - (  6673  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  مُوسَى بْنِ عُلَيٍّ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  نِسَاءُ  قُرَيْشٍ  خَيْرُ نِسَاءٍ رَكِبْنَ الْإِبِلَ  ،  أَحْنَاهُ  عَلَى وَلَدٍ فِي صِغَرِهِ ،  وَأَرْعَاهُ  عَلَى زَوْجٍ فِي ذَاتِ يَدِهِ ، قَالَ  أَبُو هُرَيْرَةَ  : نَقُولُ : قَدْ عَلِمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّ  ابْنَةَ عِمْرَانَ  لَمْ تَرْكَبِ الْإِبِلَ  .         [12/26]             [12/27]","","Musnad Abi Ya'la al-Mawsili 6673","","أبو هريرة الدوسي عن علي بن رباح اللخمي عن موسى بن علي اللخمي عن سعيد بن عبد الرحمن الجمحي عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6680","834 - (  6674  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ قُدَامَةَ قَالَ :  سَمِعْتُ  سُفْيَانَ يَقُولُ :  حَدَّثَنَا  إِسْمَاعِيلُ ،  عَنْ  قَيْسٍ قَالَ :  سَمِعْتُ  أَبَا هُرَيْرَةَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  وَاللهِ لَأَنْ يَأْخُذَ أَحَدُكُمْ حَبْلًا فَيَحْتَطِبَ  ، يَحْمِلُهُ عَلَى ظَهْرِهِ فَيَأْكُلُ وَيَتَصَدَّقُ خَيْرٌ لَهُ مِنْ أَنْ يَأْتِيَ رَجُلًا قَدْ أَغْنَاهُ اللهُ مِنْ فَضْلِهِ يَسْأَلُهُ أَعْطَاهُ أَوْ مَنَعَهُ  .         [12/28]","","Musnad Abi Ya'la al-Mawsili 6674","","أبو هريرة الدوسي عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن محمد بن قدامة الجوهري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6681","835 - (  6675  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ قُدَامَةَ ،  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنَا  أَبُو الزِّنَادِ ،  عَنِ  الْأَعْرَجِ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Musnad Abi Ya'la al-Mawsili 6675","","أبو هريرة الدوسي عن عبد الرحمن بن هرمز الأعرج عن أبو الزناد عن سفيان بن عيينة عن محمد بن قدامة الجوهري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6682","836 - (  6676  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ ،  حَدَّثَنَا  حَاتِمٌ ،  عَنِ  الْحَارِثِ ،  عَنْ  عَمِّهِ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ  أَبُو الْقَاسِمِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ذَرُونِي مَا تَرَكْتُكُمْ  ، وَلَا تَسْأَلُونِي عَنْ شَيْءٍ ، فَإِنَّمَا أَهْلَكَ مَنْ كَانَ قَبْلَكُمْ كَثْرَةُ سُؤَالِهِمْ ، وَاخْتِلَافُهُمْ عَلَى أَنْبِيَائِهِمْ ، فَمَا نَهَيْتُكُمْ عَنْهُ فَاجْتَنِبُوهُ ، وَمَا أَمَرْتُكُمْ بِهِ فَاتَّبِعُوا مِنْهُ مَا اسْتَطَعْتُمْ  .         [12/29]","","Musnad Abi Ya'la al-Mawsili 6676","","أبو هريرة الدوسي عن الحارث بن سعد بن أبي ذباب الدوسي عن الحارث بن عبد الرحمن الدوسي عن حاتم بن إسماعيل الحارثي عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6683","837 - (  6677  ) -  وَبِإِسْنَادِهِ  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا  يَتَنَفَّسْ  أَحَدُكُمْ فِي الْإِنَاءِ إِذَا كَانَ شَرِبَ مِنْهُ  ، وَلَكِنْ إِذَا أَرَادَ أَنْ يَشْرَبَ مِنْهُ ، فَلْيُؤَخِّرْ عَنْهُ ، ثُمَّ  لِيَتَنَفَّسْ  .","","Musnad Abi Ya'la al-Mawsili 6677","","أبو هريرة الدوسي عن عبد الله بن المغيرة بن أبي ذباب الدوسي عن الحارث بن عبد الرحمن الدوسي عن حاتم بن إسماعيل الحارثي عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6684","838 - (  6678  ) -  وَبِإِسْنَادِهِ  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  طُهُورُ إِنَاءِ أَحَدِكُمْ إِذَا  وَلَغَ  الْكَلْبُ أَنْ يَغْسِلَهُ سَبْعَ مَرَّاتٍ  .         [12/30]             [12/31]             [12/32]","","Musnad Abi Ya'la al-Mawsili 6678","","أبو هريرة الدوسي عن الحارث بن سعد بن أبي ذباب الدوسي عن الحارث بن عبد الرحمن الدوسي عن حاتم بن إسماعيل الحارثي عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6685","839 - (  6679  ) -  حَدَّثَنَا  كَامِلُ بْنُ طَلْحَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ الْعُمَرِيُّ ،  عَنْ  سُهَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا تَثَاءَبَ أَحَدُكُمْ فَلْيَضَعْ يَدَهُ عَلَى فِيهِ ، لَا يَدْخُلُ  .","","Musnad Abi Ya'la al-Mawsili 6679","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن عبد الله بن عمر العمري عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6686","840 - (  6680  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  عُبَيْدَةُ ،  حَدَّثَنَا  سُهَيْلٌ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَقُومُ السَّاعَةُ حَتَّى يَقْتَرِبَ  الزَّمَانُ  ، وَتَكُونَ السَّنَةُ كَالشَّهْرِ ، وَالشَّهْرُ         [12/33]      كَالْجُمُعَةِ ، وَالْجُمُعَةُ كَالْيَوْمِ ، وَالْيَوْمُ كَاحْتِرَاقِ  الْخُوصَةِ  ،  يَعْنِي :  السَّعَفَةَ  .","","Musnad Abi Ya'la al-Mawsili 6680","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن عبيدة عن سريج بن يونس المروزي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6687","841 - (  6681  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  حَمْزَةَ بْنِ الْمُغِيرَةِ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنْ  أَبِيهِ  ،         [12/34]      عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَجْعَلُنَّ قَبْرِي وَثَنًا  ، لَعَنَ اللهُ قَوْمًا اتَّخَذُوا  قُبُورَ  أَنْبِيَائِهِمْ مَسَاجِدَ  .","","Musnad Abi Ya'la al-Mawsili 6681","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن حمزة بن المغيرة بن نشيط المخزومي عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6688","842 - (  6682  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ ،  حَدَّثَنَا  سُهَيْلٌ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَعْطُوا         [12/35]      الْأَجِيرَ أَجْرَهُ قَبْلَ أَنْ يَجِفَّ رَشْحُهُ  .         [12/36]","","Musnad Abi Ya'la al-Mawsili 6682","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن عبد الله بن جعفر بن نجيح عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6689","843 - (  6683  ) -  حَدَّثَنَا  الصَّلْتُ بْنُ مَسْعُودٍ الْجَحْدَرِيُّ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  أَخْبَرَنِي  رَبِيعَةُ ،  عَنْ  سُهَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَضَى بِالْيَمِينِ مَعَ الشَّاهِدِ  .         [12/37]             [12/38]","","Musnad Abi Ya'la al-Mawsili 6683","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن ربيعة الرأي عن عبد العزيز بن محمد الدراوردي عن الصلت بن مسعود الجحدري عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6690","844 - (  6684  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عَرْعَرَةَ ،  حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ،  أَخْبَرَنَا  مَعْمَرٌ ،  عَنْ  سُهَيْلٍ ،  عَنْ  أَبِيهِ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تُفْتَحُ أَبْوَابُ الْجَنَّةِ كُلَّ اثْنَيْنِ وَخَمِيسٍ  ، قَالَ  سُهَيْلٌ  فِي حَدِيثِهِ : فَيَغْفِرُ اللهُ لِكُلِّ عَبْدٍ لَا يُشْرِكُ بِاللهِ شَيْئًا إِلَّا الْمُتَشَاحِنَيْنِ ، يَقُولُ اللهُ عَزَّ وَجَلَّ لِمَلَائِكَتِهِ : دَعُوهُمَا حَتَّى يَصْطَلِحَا  ، قَالَ  مَعْمَرٌ  : وَقَالَ غَيْرُ  سُهَيْلٍ  :  وَتُعْرَضُ الْأَعْمَالُ فِي كُلِّ اثْنَيْنِ وَخَمِيسٍ  .         [12/39]","","Musnad Abi Ya'la al-Mawsili 6684","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن معمر بن راشد عن عبد الرزاق الصنعاني عن إبراهيم بن محمد بن عرعرة عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6691","845 - (  6685  ) -  وَبِإِسْنَادِهِ  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ اللهَ إِذَا أَحَبَّ عَبْدًا قَالَ : يَا  جِبْرِيلُ  إِنِّي أُحِبُّ فُلَانًا فَأَحِبَّهُ         [12/40]      قَالَ : فَيَقُولُ  جِبْرِيلُ  لِأَهْلِ السَّمَاءِ : إِنَّ رَبَّكُمْ يُحِبُّ فُلَانًا فَأَحِبُّوهُ ، فَيُحِبُّهُ أَهْلُ السَّمَاءِ ، قَالَ : وَيُوضَعُ لَهُ  الْقَبُولُ  فِي الْأَرْضِ .  قَالَ : وَإِذَا أَبْغَضَ ، فَمِثْلُ ذَلِكَ  .         [12/41]             [12/42]","","Musnad Abi Ya'la al-Mawsili 6685","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن معمر بن راشد عن عبد الرزاق الصنعاني عن إبراهيم بن محمد بن عرعرة عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6692","846 - (  6686  ) -  حَدَّثَنَا  عَمْرُو بْنُ حُصَيْنٍ ،  حَدَّثَنَا  يَحْيَى بْنُ الْعَلَاءِ ،  عَنْ  سُهَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا أَرَادَ أَحَدُكُمْ سَفَرًا فَلْيُسَلِّمْ عَلَى إِخْوَانِهِ  ، فَإِنَّهُمْ يَزِيدُونَهُ بِدُعَائِهِمْ إِلَى دُعَائِهِ خَيْرًا  .","","Musnad Abi Ya'la al-Mawsili 6686","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن يحيى بن العلاء الفوراردي عن عمرو بن الحصين العقيلي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6693","847 - (  6687  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ نَافِعٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنْ  أَبِيهِ  ،         [12/43]      عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الَّذِي يَعْمَلُ عَمَلَ  قَوْمِ لُوطٍ  فَارْجُمُوا الْأَعْلَى وَالْأَسْفَلَ  ، ارْجُمُوهُمَا جَمِيعًا  .         [12/44]","","Musnad Abi Ya'la al-Mawsili 6687","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن عاصم بن عمر بن حفص بن عاصم بن عمر بن الخطاب عن عبد الله بن نافع الصائغ عن محمد بن إسحاق المسيبي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6694","848 - (  6688  ) -  حَدَّثَنَا  أَبُو مُوسَى مُحَمَّدُ بْنُ الْمُثَنَّى ،  حَدَّثَنَا  عَبْدُ الْوَهَّابِ ،  حَدَّثَنَا  عُبَيْدُ اللهِ  عَنْ  سُهَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَدَ  رَجُلًا  مِنْ أَصْحَابِهِ ، ثُمَّ إِنَّهُ لَقِيَهُ ، فَقَالَ : مَا لِي لَمْ أَرَكَ ؟ قَالَ : مَا بِتُّ الْبَارِحَةَ ، لَدَغَتْنِي عَقْرَبٌ ، قَالَ : أَمَا إِنَّكَ لَوْ قُلْتَ حِينَ أَمْسَيْتَ :  أَعُوذُ  بِكَلِمَاتِ  اللهِ  التَّامَّاتِ  مِنْ شَرِّ مَا خَلَقَ  ، لَمْ تَضُرَّكَ .  قَالَ  عُبَيْدُ اللهِ  : وَلَا أَعْلَمُهُ إِلَّا قَالَ فِي الْحَدِيثِ  يَرْفَعُهُ  : فَمَنْ قَالَهَا حِينَ يُمْسِي وَحِينَ يُصْبِحُ لَمْ تَضُرَّهُ  .         [12/45]","","Musnad Abi Ya'la al-Mawsili 6688","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن عبيد الله بن عمر العمري عن عبد الوهاب بن عبد المجيد الثقفي عن أبو موسى الزمن عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6695","849 - (  6689  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  سُهَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ :  قَالُوا : يَا رَسُولَ اللهِ ، هَلْ نَرَى رَبَّنَا يَوْمَ الْقِيَامَةِ ؟  قَالَ : فَقَالَ : هَلْ  تُضَارُّونَ  فِي الْقَمَرِ لَيْلَةَ الْبَدْرِ لَيْسَ دُونَهُ سَحَابٌ ؟ قَالُوا : لَا ، قَالَ : فَهَلْ  تُضَارُّونَ  فِي الشَّمْسِ فِي الظَّهِيرَةِ لَيْسَ دُونَهَا سَحَابٌ ؟ قَالُوا : لَا ،         [12/46]      قَالَ : وَالَّذِي نَفْسُ  مُحَمَّدٍ  بِيَدِهِ لَتَرَوُنَّهُ كَمَا تَرَوُنَّهُمَا  . الْحَدِيثَ .","","Musnad Abi Ya'la al-Mawsili 6689","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6696","850 - (  6690  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  سُهَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  صِنْفَانِ مِنْ أُمَّتِي لَمْ أَرَهُمَا بَعْدُ  : نِسَاءٌ  كَاسِيَاتٌ  عَارِيَاتٌ ،  مَائِلَاتٌ  مُمِيلَاتٌ ، عَلَى رُؤُوسِهِنَّ أَمْثَالُ أَسْنِمَةِ  الْبُخْتِ  الْمَائِلَةِ ، لَا يَدْخُلْنَ الْجَنَّةَ ، وَلَا يَجِدْنَ رِيحَهَا ، وَرِجَالٌ بِأَيْدِيهِمْ أَسْيَاطٌ كَأَذْنَابِ الْبَقَرِ ، يَضْرِبُونَ بِهَا النَّاسَ  .         [12/47]","","Musnad Abi Ya'la al-Mawsili 6690","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن شريك بن عبد الله النخعي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6697","851 - (  6691  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنِ  الْعَلَاءِ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ،  وَسُهَيْلٍ  ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَفْتَحُ أَحَدُكُمْ عَلَى نَفْسِهِ بَابَ مَسْأَلَةٍ إِلَّا فَتَحَ اللهُ عَلَيْهِ بَابَ فَقْرٍ  .","","Musnad Abi Ya'la al-Mawsili 6691","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن محمد بن عبد الرحمن بن المجبر عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","شهر بن حوشب عن أبي هريرة"
"6698","[12/48]      مُسْنَدُ  الْعَبَّاسِ بْنِ عَبْدِ الْمُطَّلِبِ  رَضِيَ اللهُ عَنْهُ .  1 - (  6692  ) -  أَخْبَرَنَا  أَبُو يَعْلَى أَحْمَدُ بْنُ عَلِيِّ بْنِ الْمُثَنَّى         [12/49]             [12/50]      الْمَوْصِلِيُّ ، فِي شَهْرِ رَبِيعٍ الْآخِرِ مِنْ سَنَةِ سِتٍّ وَثَلَاثِمِائَةٍ ،  حَدَّثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ الزُّبَيْرِيُّ قَالَ :  حَدَّثَنِي  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ، وَابْنُ أَبِي حَازِمٍ ،  عَنْ  يَزِيدَ بْنِ الْهَادِ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنِ  الْعَبَّاسِ بْنِ عَبْدِ الْمُطَّلِبِ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  ذَاقَ طَعْمَ الْإِيمَانِ مَنْ رَضِيَ بِاللهِ رَبًّا  ، وَبِالْإِسْلَامِ دِينًا ،  وَبِمُحَمَّدٍ  نَبِيًّا  .         [12/51]","","Musnad Abi Ya'la al-Mawsili 6692","","العباس بن عبد المطلب عم رسول الله عن عامر بن سعد بن أبي وقاص عن محمد بن إبراهيم بن الحارث التيمي عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن عبد العزيز بن أبي حازم المخزومي عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6699","2 - (  6693  ) -  حَدَّثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ قَالَ :  حَدَّثَنِي  ابْنُ الدَّرَاوَرْدِيِّ ، وَابْنُ أَبِي حَازِمٍ ،  عَنْ  يَزِيدَ بْنِ الْهَادِ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنِ  الْعَبَّاسِ بْنِ عَبْدِ الْمُطَّلِبِ ، أَنَّهُ سَمِعَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :         [12/52]      إِذَا سَجَدَ الْعَبْدُ ، سَجَدَ مَعَهُ سَبْعَةُ  آرَابٍ  : وَجْهُهُ ، وَكَفَّاهُ ، وَرُكْبَتَاهُ ، وَقَدَمَاهُ  .         [12/53]","","Musnad Abi Ya'la al-Mawsili 6693","","العباس بن عبد المطلب عم رسول الله عن عامر بن سعد بن أبي وقاص عن محمد بن إبراهيم بن الحارث التيمي عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن عبد العزيز بن أبي حازم المخزومي عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6700","3 - (  6694  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنِ  الْعَبَّاسِ ، أَنَّهُ قَالَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  عَمُّكَ  أَبُو طَالِبٍ  كَانَ  يَحُوطُكَ  ، وَيَفْعَلُ بِكَ ، قَالَ : فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّهُ لَفِي  ضَحْضَاحٍ  مِنَ النَّارِ  ، وَلَوْلَا أَنَا لَكَانَ فِي  الدَّرْكِ  الْأَسْفَلِ  .         [12/54]","","Musnad Abi Ya'la al-Mawsili 6694","","العباس بن عبد المطلب عم رسول الله عن عبد الله بن الحارث بن نوفل عن عبد الملك بن عمير القبطي عن سفيان الثوري عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6701","4 - (  6695  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ قَالَ :  قَالَ  الْعَبَّاسُ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ  أَبَا طَالِبٍ  كَانَ  يَحُوطُكَ  وَيَمْنَعُكَ  ، فَهَلْ نَفَعْتَهُ بِشَيْءٍ ؟ قَالَ : فَقَالَ : وَجَدْتُهُ فِي  الْغَمَرَاتِ  مِنَ النَّارِ ، فَأَخْرَجْتُهُ إِلَى  الضَّحْضَاحِ  .         [12/55]","","Musnad Abi Ya'la al-Mawsili 6695","","العباس بن عبد المطلب عم رسول الله عن عبد الله بن الحارث بن نوفل عن عبد الملك بن عمير القبطي عن سفيان بن عيينة عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6702","5 - (  6696  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ قَالَ :  قَالَ  الْعَبَّاسُ :  يَا رَسُولَ اللهِ ، عَلِّمْنِي شَيْئًا أَسْأَلُهُ رَبِّي ، قَالَ :  سَلْ رَبَّكَ الْعَافِيَةَ  ، قَالَ : ثُمَّ لَبِثَ مَا شَاءَ اللهُ ، ثُمَّ قَالَ : يَا رَسُولَ اللهِ ، عَلِّمْنِي شَيْئًا أَسْأَلُهُ رَبِّي قَالَ : سَلْ رَبَّكَ الْعَافِيَةَ فِي الدُّنْيَا وَالْآخِرَةِ  .","","Musnad Abi Ya'la al-Mawsili 6696","","العباس بن عبد المطلب عم رسول الله عن عبد الله بن الحارث بن نوفل عن يزيد بن أبي زياد القرشي عن محمد بن فضيل بن غزوان عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6703","6 - (  6697  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  حُسَيْنُ         [12/56]      بْنُ عَلِيٍّ ،  عَنْ  زَائِدَةَ ،  عَنْ  يَزِيدَ عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنِ  الْعَبَّاسِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Musnad Abi Ya'la al-Mawsili 6697","","العباس بن عبد المطلب عم رسول الله عن يزيد عبد الله بن الحارث عن زائدة بن قدامة عن الحسين بن علي الجعفي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6704","7 - (  6698  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  مُوسَى بْنِ عُبَيْدَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ ،  عَنِ  ابْنِ الْهَادِ ،  عَنِ  الْعَبَّاسِ بْنِ عَبْدِ الْمُطَّلِبِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَظْهَرُ الدِّينُ ، حَتَّى يُجَاوِزَ الْبِحَارَ  ، وَتُخَاضُ الْبِحَارُ فِي  سَبِيلِ  اللهِ ، ثُمَّ يَأْتِي مِنْ بَعْدِكُمْ أَقْوَامٌ يَقْرَؤُونَ الْقُرْآنَ ، يَقُولُونَ : قَدْ قَرَأْنَا الْقُرْآنَ ، مَنْ أَقْرَأُ مِنَّا ؟  وَمَنْ أَفْقَهُ مِنَّا ؟ أَوْ مَنْ أَعْلَمُ مِنَّا ؟  ثُمَّ الْتَفَتَ إِلَى أَصْحَابِهِ ، فَقَالَ : هَلْ فِي أُولَئِكَ مِنْ خَيْرٍ ؟ قَالُوا : لَا ، قَالَ : أُولَئِكَ مِنْكُمْ ، مِنْ هَذِهِ الْأُمَّةِ ، وَأُولَئِكَ هُمْ وَقُودُ النَّارِ  .         [12/57]","","Musnad Abi Ya'la al-Mawsili 6698","","العباس بن عبد المطلب عم رسول الله عن عبد الله بن شداد بن الهاد الليثي عن محمد بن إبراهيم بن الحارث التيمي عن موسى بن عبيدة بن نشيط الحميري عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6705","8 - (  6699  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ الْكُوفِيُّ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِيُّ ،  عَنِ  ابْنِ كُرَيْبٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  كُنْتُ أَقُودُ ابْنَ عَبَّاسٍ فِي  زُقَاقِ أَبِي لَهَبٍ  فَقَالَ : يَا  كُرَيْبُ  بَلَغْنَا مَكَانَ كَذَا وَكَذَا ؟ قَالَ : أَنْتَ عِنْدَهُ الْآنَ ، فَقَالَ :  حَدَّثَنِي  الْعَبَّاسُ بْنُ عَبْدِ الْمُطَّلِبِ قَالَ : بَيْنَا أَنَا مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي هَذَا الْمَوْضِعِ إِذْ أَقْبَلَ  رَجُلٌ  يَتَبَخْتَرُ بَيْنَ بُرْدَيْهِ وَيَنْظُرُ         [12/58]      إِلَى عِطْفَيْهِ قَدْ أَعْجَبَتْهُ نَفْسُهُ إِذْ خَسَفَ اللهُ بِهِ الْأَرْضَ فِي هَذَا الْمَوْطِنِ ، فَهُوَ  يَتَجَلْجَلُ  فِيهَا إِلَى يَوْمِ الْقِيَامَةِ  .","","Musnad Abi Ya'la al-Mawsili 6699","","العباس بن عبد المطلب عم رسول الله عن عبد الله بن عباس عن كريب بن أبي مسلم الحجازي عن رشدين بن كريب عن عبد الرحمن بن محمد المحاربي عن الحسن بن حماد الوراق عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6706","9 - (  6700  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ مُحَمَّدُ بْنُ الْعَلَاءِ ،  حَدَّثَنَا  رِشْدِينُ بْنُ سَعْدٍ ،  عَنْ  مُعَاوِيَةَ ،  عَنْ  مُعَاذِ بْنِ مُحَمَّدٍ الْأَنْصَارِيِّ ،  عَنِ  ابْنِ صُهْبَانَ ،  عَنِ  الْعَبَّاسِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا  قَوَدَ  فِي الْمَأْمُومَةِ  ، وَلَا  الْجَائِفَةِ  ،  يَعْنِي : وَلَا الْمُنَقِّلَةِ  .         [12/59]","","Musnad Abi Ya'la al-Mawsili 6700","","العباس بن عبد المطلب عم رسول الله عن ابن صهبان ، يقال اسمه عن معاذ بن محمد بن معاذ بن أبي بن كعب الأنصاري عن معاوية بن صالح بن حدير الحضرمي عن رشدين بن سعد المهري عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6707","10 - (  6701  ) -  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدِ بْنِ حَيَّانَ ،  حَدَّثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ ،  عَنِ  ابْنِ أَبِي ذِئْبٍ ،  عَنْ  جَعْفَرِ بْنِ تَمَّامٍ ،  عَنْ  جَدِّهِ الْعَبَّاسِ بْنِ عَبْدِ الْمُطَّلِبِ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ الْوَسْمِ فِي الْوَجْهِ  ، فَقَالَ  الْعَبَّاسُ  :  لَا  أَسِمُ  إِلَّا فِي  الْجَاعِرَتَيْنِ  .         [12/60]","","Musnad Abi Ya'la al-Mawsili 6701","","العباس بن عبد المطلب عم رسول الله عن جعفر بن تمام بن العباس بن عبد المطلب عن محمد بن عبد الرحمن بن المغيرة عن أبو داود الطيالسي عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6708","11 - (  6702  ) -  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  عِيسَى بْنُ إِبْرَاهِيمَ أَبُو عَمْرٍو ،  حَدَّثَنَا  عَفِيفُ بْنُ سَالِمٍ ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  مُعَاذِ بْنِ عَبْدِ الرَّحْمَنِ  ،  عَنِ  ابْنِ صُهْبَانَ ،  عَنِ  الْعَبَّاسِ بْنِ عَبْدِ الْمُطَّلِبِ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَيْسَ فِي  الْجَائِفَةِ  وَلَا الْمُنَقِّلَةِ وَلَا الْمَأْمُومَةِ  قَوَدٌ  ، إِنَّمَا فِيهِنَّ الْعَقْلُ  .  كذا في طبعة دار المأمون للتراث ونسخة السليمانية ، ولعل الصواب : (معاذ بن محمد) وينظر مصادر التخريج .","","Musnad Abi Ya'la al-Mawsili 6702","","العباس بن عبد المطلب عم رسول الله عن ابن صهبان ، يقال اسمه عن معاذ بن محمد بن معاذ بن أبي بن كعب الأنصاري عن عبد الله بن لهيعة عن عفيف بن سالم الموصلي عن عيسى بن إبراهيم البركي عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6709","12 - (  6703  ) -  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ بْنِ عَبْدِ اللهِ الرُّومِيُّ قَالَ :  حَدَّثَنِي  جَابِرُ بْنُ يَزِيدَ بْنِ رِفَاعَةَ ،  عَنْ  هَارُونَ بْنِ أَبِي الْجَوْزَاءِ ،  عَنِ  الْعَبَّاسِ قَالَ :  كُنَّا جُلُوسًا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَحْتَ         [12/61]      شَجَرَةٍ ، فَهَاجَتِ الرِّيحُ ، فَوَقَعَ مَا كَانَ فِيهَا مِنْ وَرَقٍ نَخِرٍ ، وَبَقِيَ فِيهَا مَا كَانَ مِنْ وَرَقٍ أَخْضَرَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا مَثَلُ هَذِهِ الشَّجَرَةِ ؟  قَالَ  الْقَوْمُ  : اللهُ وَرَسُولُهُ أَعْلَمُ ، قَالَ : مَثَلُهَا مَثَلُ الْمُؤْمِنِ ، إِذَا اقْشَعَرَّ مِنْ خَشْيَةِ اللهِ ، وَقَعَتْ عَنْهُ ذُنُوبُهُ وَبَقِيَتْ لَهُ حَسَنَاتُهُ  .         [12/62]","","Musnad Abi Ya'la al-Mawsili 6703","","العباس بن عبد المطلب عم رسول الله عن هارون بن أبي الجوزاء عن جابر بن يزيد العجلي عن محمد بن عمر بن عبد الله بن فيروز عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6710","13 - (  6704  ) -  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  حَدَّثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنِ  ابْنِ أَبِي السَّفَرِ ،  عَنِ  ابْنِ شُرَحْبِيلَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْعَبَّاسِ قَالَ :  دَخَلْتُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعِنْدَهُ نِسَاؤُهُ فَاسْتَتَرْنَ مِنِّي إِلَّا  مَيْمُونَةَ  ، فَدُقَّ لَهُ سَعْطَةٌ فَلُدَّ ، فَقَالَ : لَا يَبْقَيَنَّ فِي الْبَيْتِ أَحَدٌ إِلَّا  لُدَّ  إِلَّا  الْعَبَّاسَ  ، فَإِنَّهُ لَمْ تُصِبْهُ يَمِينِي ، ثُمَّ قَالَ :  مُرُوا  أَبَا بَكْرٍ  يُصَلِّي بِالنَّاسِ  ، فَقَالَتْ  عَائِشَةُ  لِحَفْصَةَ  : قُولِي لَهُ إِنَّ  أَبَا بَكْرٍ  إِذَا قَامَ ذَلِكَ الْمَقَامَ بَكَى ، فَقَالَتْ لَهُ ، فَقَالَ : مُرُوا  أَبَا بَكْرٍ  يُصَلِّي بِالنَّاسِ ، فَصَلَّى  أَبُو بَكْرٍ  ، ثُمَّ وَجَدَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خِفَّةً ، فَخَرَجَ ، فَلَمَّا رَآهُ  أَبُو بَكْرٍ  تَأَخَّرَ ، فَأَوْمَأَ إِلَيْهِ بِيَدِهِ أَيْ مَكَانَكَ ، فَجَاءَ ، فَجَلَسَ إِلَى جَنْبِهِ ، فَقَرَأَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ حَيْثُ انْتَهَى  أَبُو بَكْرٍ  .         [12/63]","","Musnad Abi Ya'la al-Mawsili 6704","","العباس بن عبد المطلب عم رسول الله عن عبد الله بن عباس عن أرقم بن شرحبيل حطام الصفوف عن عبد الله بن أبي السفر الهمداني عن قيس بن الربيع الأسدي عن عبد الله بن رجاء الغداني عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6711","14 - (  6705  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ  حَدَّثَنَا  ابْنُ لَهِيعَةَ  عَنْ  مُعَاذِ بْنِ مُحَمَّدٍ الْأَنْصَارِيِّ قَالَ :  أَخْبَرَنِي  عَمْرُو بْنُ مَعْدِي كَرِبَ :  أَصَابَ رَجُلًا مِنْ  بَنِي كِنَانَةَ  مَأْمُومَةٌ ، فَأَرَادَ  عُمَرُ بْنُ الْخَطَّابِ  أَنْ يُقِيدَ مِنْهُ ،  فَقَالَ  لَهُ الْعَبَّاسُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا  قَوَدَ  فِي مَأْمُومَةٍ وَلَا  جَائِفَةٍ  وَلَا مُنَقِّلَةٍ  ، فَأَغْرَمَهُ الْعَقْلَ  .","","Musnad Abi Ya'la al-Mawsili 6705","","العباس بن عبد المطلب عم رسول الله عن عمرو بن معد يكرب الزبيدي عن معاذ بن محمد بن معاذ بن أبي بن كعب الأنصاري عن عبد الله بن لهيعة عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6712","15 - (  6706  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ،  حَدَّثَنَا  الْخَضِرُ بْنُ مُحَمَّدٍ الْحَرَّانِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  أَبِي الزِّنَادِ ،  عَنِ  الْأَعْرَجِ ،  عَنْ  سُلَيْمَانَ بْنِ عَرِيبٍ قَالَ :         [12/64]      سَمِعْتُ  أَبَا هُرَيْرَةَ يَقُولُ  لِابْنِ عَبَّاسٍ  : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  رُؤْيَا الْمُسْلِمِ  جُزْءٌ  مِنْ أَرْبَعِينَ  جُزْءًا  مِنَ النُّبُوَّةِ  ، قَالَ  ابْنُ عَبَّاسٍ  : مِنْ سِتِّينَ ، فَقَالَ  أَبُو هُرَيْرَةَ  : تَسْمَعُنِي أَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَتَقُولُ : مِنْ سِتِّينَ ؟  16 - (  6707  ) -  فَقَالَ  ابْنُ عَبَّاسٍ : وَأَنَا أَقُولُ :  قَالَ  الْعَبَّاسُ بْنُ عَبْدِ الْمُطَّلِبِ .  قَالَ  أَبُو عُثْمَانَ عَمْرٌو النَّاقِدُ  : قُلْتُ : أَنَا وَأَصْحَابُنَا ، فَهُوَ عِنْدَنَا إِنْ شَاءَ اللهُ ، يَعْنِي  الْعَبَّاسَ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .         [12/65]             [12/66]","","Musnad Abi Ya'la al-Mawsili 6706","","العباس بن عبد المطلب عم رسول الله عن عبد الله بن عباس عن سليمان بن عريب صهر ابن عباس عن عبد الرحمن بن هرمز الأعرج عن أبو الزناد عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن الخضر بن محمد الجزري عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6713","17 - (  6708  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ سَهْمٍ الْأَنْطَاكِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ الصَّنْعَانِيُّ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  كَثِيرِ بْنِ الْعَبَّاسِ قَالَ :  حَدَّثَنِي  أَبِي الْعَبَّاسُ بْنُ عَبْدِ الْمُطَّلِبِ  قَالَ :  شَهِدْتُ  حُنَيْنًا  مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا هُزِمَ الْمُسْلِمُونَ ، وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى بَغْلَةٍ ، أَهْدَاهَا لَهُ  فَرْوَةُ بْنُ نُفَاثَةَ الْجُذَامِيُّ  ، فَجَعَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَرْكُضُهَا فِي وُجُوهِ الْكُفَّارِ ، وَأَنَا آخِذٌ بِلِجَامِهَا         [12/67]      مَخَافَةَ أَنْ تُسْرِعَ ،  وَأَبُو سُفْيَانَ بْنُ الْحَارِثِ بْنِ عَبْدِ الْمُطَّلِبِ  آخِذٌ  بِغَرْزِ  رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  نَادِ فِي  أَصْحَابِ  السَّمُرَةِ  ، فَنَادَيْتُ بِأَعْلَى صَوْتِي : يَا  أَصْحَابَ  السَّمُرَةِ  ، وَدَاعُونَ فِي  الْأَنْصَارِ  : يَا مَعْشَرَ  الْأَنْصَارِ  ، ثُمَّ قُصِرَتِ الدَّعْوَةُ عَلَى  بَنِي الْحَارِثِ بْنِ الْخَزْرَجِ  ، وَكَانُوا أَصْبَرَ عَلَى الْمَوْتِ ، فَقَالُوا : يَا لَبَّيْكَ يَا لَبَّيْكَ ، فَوَاللهِ مَا شَبَّهْتُ عَطْفَهُمْ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا كَعَطْفِ بَقَرٍ عَلَى أَوْلَادِهَا ، قَالَ : فَتَقَدَّمُوا فَاقْتَتَلُوا قِتَالًا شَدِيدًا ، فَلَمَّا رَأَى ذَلِكَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَنَاوَلَ قَبْضَةً مِنْ  حَصْبَاءَ  ، فَرَمَى بِهَا وُجُوهَ  الْقَوْمِ  ، وَقَالَ :  شَاهَتِ  الْوُجُوهُ ، قَالَ : فَوَاللهِ مَا زِلْتُ أَرَى حَدَّهُمْ  كَلِيلًا  ، وَأَمْرَهُمْ مُدْبِرًا حَتَّى هَزَمَهُمُ اللهُ  .         [12/68]             [12/69]","","Musnad Abi Ya'la al-Mawsili 6708","","العباس بن عبد المطلب عم رسول الله عن كثير بن العباس بن عبد المطلب بن هاشم عن الزهري عن معمر بن راشد عن محمد بن كثير بن أبي عطاء عن محمد بن عبد الرحمن بن حكيم الأنطاكي عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6714","18 - (  6709  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  الْحَسَنُ بْنُ عَطِيَّةَ ،         [12/70]      حَدَّثَنَا  قَيْسٌ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنِ  الْأَحْنَفِ بْنِ قَيْسٍ ،  عَنِ  الْعَبَّاسِ بْنِ عَبْدِ الْمُطَّلِبِ قَالَ :  خَرَجْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ  الْمَدِينَةِ  ، فَالْتَفَتَ إِلَيْهَا ، فَقَالَ :  إِنَّ اللهَ قَدْ بَرَّأَ هَذِهِ الْجَزِيرَةَ مِنَ  الشِّرْكِ  ، وَلَكِنْ أَخَافُ أَنْ تُضِلَّهُمُ النُّجُومُ ، قَالُوا : يَا رَسُولَ اللهِ كَيْفَ تُضِلُّهُمُ النُّجُومُ ؟ قَالَ : يَنْزِلُ الْغَيْثُ ، فَيَقُولُونَ : مُطِرْنَا  بِنَوْءِ  كَذَا وَكَذَا  .         [12/71]","","Musnad Abi Ya'la al-Mawsili 6709","","العباس بن عبد المطلب عم رسول الله عن الأحنف بن قيس السعدي عن الحسن البصري عن يونس بن عبيد عن قيس بن الربيع الأسدي عن الحسن بن عطية البزاز عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6715","19 - (  6710  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ قَالَ :  حَدَّثَنَا  أَبُو حَفْصٍ الْأَبَّارُ ،  عَنْ  مَنْصُورِ بْنِ الْمُعْتَمِرِ ،  عَنْ  أَبِي عَلِيٍّ ،  عَنْ  جَعْفَرِ بْنِ تَمَّامٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْعَبَّاسِ قَالَ :  كَانُوا يَدْخُلُونَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَا يَسْتَاكُونَ ، فَقَالَ : تَدْخُلُونَ عَلَيَّ  قُلْحًا  وَلَا تَسْتَاكُونَ ؟ اسْتَاكُوا ،  لَوْلَا أَنْ أَشُقَّ عَلَى أُمَّتِي  لَفَرَضْتُ  عَلَيْهِمُ السِّوَاكَ كَمَا  فَرَضْتُ  عَلَيْهِمُ الْوُضُوءَ  .  وَقَالَتْ  عَائِشَةُ  : مَا زَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَذْكُرُ السِّوَاكَ حَتَّى خَشِينَا أَنْ يَنْزِلَ فِيهِ قُرْآنٌ  .         [12/72]             [12/73]","","Musnad Abi Ya'la al-Mawsili 6710","","العباس بن عبد المطلب عم رسول الله عن تمام بن العباس بن عبد المطلب الهاشمي عن جعفر بن تمام بن العباس بن عبد المطلب عن أبو علي الزراد عن منصور بن المعتمر عن عمر بن عبد الرحمن بن قيس عن سريج بن يونس المروزي عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6716","20 - (  6711  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  قَالَ :  أَخْبَرَنِي  نَافِعٌ قَالَ :  سَمِعْتُ  الْعَبَّاسَ يَقُولُ  لِلزُّبَيْرِ  :  يَا  أَبَا عَبْدِ اللهِ  هَاهُنَا         [12/74]      أَمَرَكَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ تَرْكُزَ  الرَّايَةَ  ،  يَعْنِي : يَوْمَ فَتْحِ مَكَّةَ  .","","Musnad Abi Ya'la al-Mawsili 6711","","العباس بن عبد المطلب عم رسول الله عن نافع بن جبير بن مطعم النوفلي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6717","21 - (  6712  ) -  حَدَّثَنَا  إِسْحَاقُ  حَدَّثَنَا  شَرِيكُ بْنُ عَبْدِ اللهِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَبْدِ اللهِ  عَنِ  الْأَحْنَفِ بْنِ قَيْسٍ  عَنِ  الْعَبَّاسِ بْنِ عَبْدِ الْمُطَّلِبِ  فِي قَوْلِهِ :         {      وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍ ثَمَانِيَةٌ         }      قَالَ : ثَمَانِيَةُ أَمْلَاكٍ فِي صُورَةِ  الْأَوْعَالِ  .         [12/75]","","Musnad Abi Ya'la al-Mawsili 6712","","العباس بن عبد المطلب عم رسول الله عن الأحنف بن قيس السعدي عن عبد الله بن عميرة بن حصن القيسي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6718","22 - (  6713  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ،  عَنْ  يَحْيَى بْنِ الْعَلَاءِ ،  عَنْ  خَالِهِ شُعَيْبِ بْنِ خَالِدٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمِيرَةَ ،  عَنِ  الْعَبَّاسِ بْنِ عَبْدِ الْمُطَّلِبِ قَالَ :  كُنَّا جُلُوسًا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِالْبَطْحَاءِ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : تَدْرُونَ مَا هَذَا ؟ قَالَ : قُلْنَا : السَّحَابُ ، قَالَ : وَالْمُزْنُ ، قُلْنَا : وَالْمُزْنُ ، قَالَ :  وَالْعَنَانُ  ، قَالَ : فَسَكَتْنَا ، فَقَالَ :  هَلْ تَدْرُونَ كَمْ بَيْنَ السَّمَاءِ وَالْأَرْضِ  ؟ قُلْنَا : اللهُ وَرَسُولُهُ أَعْلَمُ ، قَالَ : بَيْنَهُمَا  مَسِيرَةُ  خَمْسِمِائَةِ سَنَةٍ ، وَبَيْنَ كُلِّ سَمَاءٍ إِلَى سَمَاءٍ  مَسِيرَةُ         [12/76]      خَمْسِمِائَةِ سَنَةٍ ، وَكِثَفُ كُلِّ سَمَاءٍ  مَسِيرَةُ  خَمْسِمِائَةِ سَنَةٍ ، وَالسَّمَاءُ السَّابِعَةُ بَيْنَ أَسْفَلِهِ وَأَعْلَاهُ كَمَا بَيْنَ السَّمَاءِ وَالْأَرْضِ ، ثُمَّ فَوْقَ ذَلِكَ ثَمَانِيَةُ  أَوْعَالٍ  ، بَيْنَ رُكَبِهِمْ وَأَظْلَافِهِمْ كَمَا بَيْنَ السَّمَاءِ وَالْأَرْضِ ، ثُمَّ فَوْقَ ذَلِكَ الْعَرْشُ ، وَلَيْسَ يَخْفَى عَلَيْهِ شَيْءٌ مِنْ أَعْمَالِ بَنِي آدَمَ  .         [12/77]","","Musnad Abi Ya'la al-Mawsili 6713","","العباس بن عبد المطلب عم رسول الله عن عبد الله بن عميرة بن حصن القيسي عن سماك بن حرب البكري عن شعيب بن خالد البجلي عن يحيى بن العلاء الفوراردي عن عبد الرزاق الصنعاني عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6719","23 - (  6714  ) -  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدِ بْنِ حَيَّانَ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ ،  حَدَّثَنَا  عُمَرُ بْنُ إِبْرَاهِيمَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنِ  الْعَبَّاسِ بْنِ عَبْدِ الْمُطَّلِبِ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ اللهَ قَدْ طَهَّرَ هَذِهِ الْقَرْيَةَ مِنَ  الشِّرْكِ  ، إِنْ لَمْ تُضِلَّهُمُ النُّجُومُ  .         [12/78]","","Musnad Abi Ya'la al-Mawsili 6714","","العباس بن عبد المطلب عم رسول الله عن الحسن البصري عن قتادة بن دعامة عن عمر بن إبراهيم العبدي عن عبد الصمد بن عبد الوارث التنوري عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6720","24 - (  6715  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ بْنِ نَوْفَلٍ ،  عَنِ  الْعَبَّاسِ بْنِ عَبْدِ الْمُطَّلِبِ قَالَ :  يَا رَسُولَ اللهِ هَلْ نَفَعْتَ  أَبَا طَالِبٍ  ؟ فَإِنَّهُ كَانَ  يَحُوطُكَ  وَيَغْضَبُ لَكَ ، قَالَ :  هُوَ فِي  ضَحْضَاحٍ  مِنَ النَّارِ ، وَلَوْلَايَ لَفِي  الدَّرْكِ  الْأَسْفَلِ  .","","Musnad Abi Ya'la al-Mawsili 6715","","العباس بن عبد المطلب عم رسول الله عن عبد الله بن عميرة بن حصن القيسي عن عبد الملك بن عمير القبطي عن الوضاح بن عبد الله اليشكري عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند العباس بن عبد المطلب رضي الله عنه"
"6721","[12/79]      مُسْنَدُ  الْفَضْلِ بْنِ الْعَبَّاسِ  رَحِمَهُ اللهُ .  1 - (  6716  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  عَبْدِ الْمَلِكِ ،  عَنْ  عَطَاءٍ ،         [12/80]      عَنِ  ابْنِ عَبَّاسٍ قَالَ :  أَفَاضَ  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ  عَرَفَةَ  ، وَرِدْفُهُ  أُسَامَةُ بْنُ زَيْدٍ  ،  وَأَفَاضَ  مِنْ  جَمْعٍ  ، وَرِدْفُهُ  الْفَضْلُ بْنُ عَبَّاسٍ  ، قَالَ الْفَضْلُ :  لَمْ يَزَلْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُلَبِّي حَتَّى رَمَى جَمْرَةَ  الْعَقَبَةِ  .         [12/81]             [12/82]","","Musnad Abi Ya'la al-Mawsili 6716","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6722","2 - (  6717  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ         [12/83]      يَحْيَى بْنِ أَبِي إِسْحَاقَ ،  حَدَّثَنَا  سُلَيْمَانُ بْنُ يَسَارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  ،  أَنَّ  رَجُلًا  قَالَ : يَا رَسُولَ اللهِ ، إِنَّ أَبِي أَدْرَكَهُ الْإِسْلَامُ وَهُوَ شَيْخٌ كَبِيرٌ  ، إِنْ شَدَدْتُهُ عَلَى الرَّحْلِ خِفْتُ عَلَيْهِ أَنْ يَمُوتَ ، وَإِنْ لَمْ أَشُدَّهُ لَمْ يَثْبُتْ ، أَفَأَحُجُّ عَنْهُ ؟ قَالَ : أَرَأَيْتَ لَوْ كَانَ عَلَى أَبِيكَ دَيْنٌ فَقَضَيْتَهُ ، أَكَانَ يُجْزِيهِ ؟ فَقَالَ : نَعَمْ ، قَالَ : فَحُجَّ عَنْ أَبِيكَ  .         [12/84]             [12/85]","","Musnad Abi Ya'la al-Mawsili 6717","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن سليمان بن يسار مولى ميمونة زوج رسول الله عن يحيى بن أبي إسحاق الحضرمي عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6723","3 - (  6718  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  يَحْيَى بْنِ أَبِي إِسْحَاقَ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  عُبَيْدِ اللهِ ، وَالْفَضْلِ بْنِ عَبَّاسٍ ،  أَنَّ  الْغُمَيْصَاءَ  ، أَوِ  الرُّمَيْصَاءَ  ، جَاءَتْ تَشْكُو زَوْجَهَا إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - قَالَتْ : إِنَّهُ لَا يَصِلُ إِلَيْهَا ، قَالَ : فَقَالَ : كَذَبَتْ يَا رَسُولَ اللهِ ، إِنِّي لَأَفْعَلُ ، وَلَكِنَّهَا تُرِيدُ أَنْ تَرْجِعَ إِلَى زَوْجِهَا الْأَوَّلِ ، قَالَ : فَقَالَ رَسُولُ اللهِ         [12/86]      - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : لَا تَحِلُّ لَهُ حَتَّى تَذُوقَ  عُسَيْلَتَهَا  .","","Musnad Abi Ya'la al-Mawsili 6718","","الفضل بن العباس بن عبد المطلب الهاشمي عن سليمان بن يسار مولى ميمونة زوج رسول الله عن يحيى بن أبي إسحاق الحضرمي عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6724","4 - (  6719  ) -  حَدَّثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ الشَّاذَكُونِيُّ أَبُو         [12/87]      أَيُّوبَ ،  حَدَّثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَفْطَرَ  بِعَرَفَةَ  .         [12/88]","","Musnad Abi Ya'la al-Mawsili 6719","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن عطاء بن أبي رباح عن ابن جريج عن حفص بن غياث النخعي عن الشاذكوني عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6725","5 - (  6720  ) -  حَدَّثَنَا  سُلَيْمَانُ الشَّاذَكُونِيُّ ،  حَدَّثَنَا  يَحْيَى بْنُ أَبِي الْهَيْثَمِ ،  حَدَّثَنَا  عُثْمَانُ بْنُ عَطَاءٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  قَالَ :  كُفِّنَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي ثَوْبَيْنِ أَبْيَضَيْنِ  سَحُولِيَّيْنِ  .","","Musnad Abi Ya'la al-Mawsili 6720","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن عطاء الخراساني عن عثمان بن عطاء الخراساني عن يحيى بن أبي الهيثم العطار عن الشاذكوني عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6726","6 - (  6721  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  هَمَّامٌ ،  حَدَّثَنَا  قَتَادَةُ  عَنْ  عَزْرَةَ  عَنِ  الشَّعْبِيِّ  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ ، قَالَ :  كُنْتُ رِدْفَ رَسُولِ اللهِ         [12/89]      - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ  جَمْعٍ  ، فَلَمْ تَرْفَعْ رَاحِلَتُهُ رِجْلَهَا غَادِيَةً حَتَّى أَتَى  جَمْعًا  .","","Musnad Abi Ya'la al-Mawsili 6721","","الفضل بن العباس بن عبد المطلب الهاشمي عن الشعبي عن عزرة بن عبد الرحمن بن زرارة عن قتادة بن دعامة عن همام بن يحيى بن دينار عن هدبة بن خالد عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6727","7 - (  6722  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ جَعْفَرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي حَرْمَلَةَ ،  عَنْ  كُرَيْبٍ مَوْلَى ابْنِ عَبَّاسٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  أَنَّهُ كَانَ رِدْفَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ  عَرَفَاتٍ  ، فَلَمَّا بَلَغَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  شِعْبَ الْأَيْسَرِ  الَّذِي دُونَ  الْمُزْدَلِفَةِ  أَنَاخَ ، قَالَ : ثُمَّ جَاءَ فَصَبَبْتُ عَلَيْهِ الْوَضُوءَ فَتَوَضَّأَ ، قُلْتُ : الصَّلَاةَ يَا رَسُولَ اللهِ ، قَالَ : الصَّلَاةُ أَمَامَكَ ، فَرَكِبَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى أَتَى  الْمُزْدَلِفَةَ  فَصَلَّى ، ثُمَّ رَدِفَ  الْفَضْلُ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - غَدَاةَ  جَمْعٍ  .         [12/90]             [12/91]","","Musnad Abi Ya'la al-Mawsili 6722","","أسامة بن زيد بن حارثة ذو البطين عن كريب بن أبي مسلم الحجازي عن محمد بن أبي حرملة القرشي عن إسماعيل بن جعفر بن أبي كثير الزرقي عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6728","8 - (  6723  ) -  قَالَ  كُرَيْبٌ :  فَأَخْبَرَنِي  عَبْدُ اللهِ بْنُ عَبَّاسٍ ،  عَنِ  الْفَضْلِ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمْ يَزَلْ يُلَبِّي حَتَّى بَلَغَ  الْجَمْرَةَ  .         [12/92]","","Musnad Abi Ya'la al-Mawsili 6723","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن كريب بن أبي مسلم الحجازي عن محمد بن أبي حرملة القرشي عن إسماعيل بن جعفر بن أبي كثير الزرقي عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6729","9 - (  6724  ) -  حَدَّثَنَا  كَامِلٌ ،  حَدَّثَنَا  اللَّيْثُ ،  حَدَّثَنَا  أَبُو الزُّبَيْرِ ،  عَنْ  أَبِي مَعْبَدٍ مَوْلَى ابْنِ عَبَّاسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  ،  وَكَانَ رِدْفَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ فِي عَشِيَّةِ  عَرَفَةَ  وَغَدَاةِ  جَمْعٍ  : أَيُّهَا النَّاسُ ، حِينَ  دَفَعُوا  ، عَلَيْكُمْ  بِالسَّكِينَةِ  ، وَهُوَ كَافٌّ نَاقَتَهُ حَتَّى إِذَا دَخَلَ  مُحَسِّرًا  - وَهُوَ مِنْ  مِنًى  - قَالَ :  عَلَيْكُمْ بِحَصَى  الْخَذْفِ  الَّذِي يُرْمَى بِهِ الْجَمْرَةُ  ، وَلَمْ يَزَلْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُلَبِّي حَتَّى رَمَى الْجَمْرَةَ  .         [12/93]","","Musnad Abi Ya'la al-Mawsili 6724","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن نافذ المكي عن أبو الزبير المكي عن الليث بن سعد عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6730","10 - (  6725  ) -  حَدَّثَنَا  عَمْرُو بْنُ الضَّحَّاكِ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  شُعْبَةَ ،  عَنْ  مُشَاشٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَ ضَعَفَةَ  بَنِي هَاشِمٍ  أَنْ يَنْفِرُوا مِنْ  جَمْعٍ  بِلَيْلٍ  .         [12/94]","","Musnad Abi Ya'la al-Mawsili 6725","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن عطاء بن أبي رباح عن مشاش السليمي عن شعبة بن الحجاج عن أبو عاصم النبيل عن عمرو بن الضحاك بن مخلد عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6731","11 - (  6726  ) -  حَدَّثَنَا  عَمْرُو بْنُ الضَّحَّاكِ ،  حَدَّثَنَا  أَبِي ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ بْنِ عَلِيٍّ ،  عَنِ  الْعَبَّاسِ بْنِ عُبَيْدِ اللهِ بْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ قَالَ :  زَارَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْعَبَّاسَ  فِي بَادِيَةٍ لَنَا  ، فَإِذَا كَلْبٌ وَحِمَارٌ لَنَا يَرْعَى ، فَصَلَّى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْعَصْرَ ، وَهُمَا بَيْنَ يَدَيْهِ وَلَمْ يُزْجَرَا وَلَمْ يُؤَخَّرَا  .         [12/95]","","Musnad Abi Ya'la al-Mawsili 6726","","الفضل بن العباس بن عبد المطلب الهاشمي عن عباس بن عبيد الله بن عباس بن عبد المطلب عن محمد بن عمر بن علي بن أبي طالب عن ابن جريج عن أبو عاصم النبيل عن عمرو بن الضحاك بن مخلد عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6732","12 - (  6727  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ  عَنْ  خُصَيْفٍ  عَنْ  مُجَاهِدٍ قَالَ :  قَالَ  ابْنُ عَبَّاسٍ :  قَالَ  الْفَضْلُ بْنُ عَبَّاسٍ  :  كُنْتُ رَدِيفَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَمَا زِلْتُ أَسْمَعُهُ يُلَبِّي حَتَّى رَمَى جَمْرَةَ  الْعَقَبَةِ  ، فَلَمَّا رَمَى قَطَعَ  .         [12/96]","","Musnad Abi Ya'la al-Mawsili 6727","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن مجاهد بن جبر المخزومي عن خصيف الجزري عن سلام بن سليم الحنفي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6733","13 - (  6728  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  حَفْصٌ ،  عَنْ  جَعْفَرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَلِيِّ بْنِ حُسَيْنٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمْ يَزَلْ يُلَبِّي حَتَّى رَمَى جَمْرَةَ  الْعَقَبَةِ  ، فَرَمَاهَا بِسَبْعِ حَصَيَاتٍ ، يُكَبِّرُ مَعَ كُلِّ حَصَاةٍ  .","","Musnad Abi Ya'la al-Mawsili 6728","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن علي بن الحسين زين العابدين عن أبو جعفر الباقر عن جعفر الصادق عن حفص بن غياث النخعي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6734","14 - (  6729  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  حَفْصٌ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - شَرِبَ يَوْمَ  عَرَفَةَ  .","","Musnad Abi Ya'la al-Mawsili 6729","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن عطاء بن أبي رباح عن ابن جريج عن حفص بن غياث النخعي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6735","15 - (  6730  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  أَبُو خَالِدٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  أَبِي مَعْبَدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  قَالَ :  أَفَاضَ  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ  عَرَفَةَ  ، وَمِنْ  جَمْعٍ  ، وَعَلَيْهِ  السَّكِينَةُ  حَتَّى أَتَى  مِنًى  ، فَلَمَّا هَبَطَ         [12/97]      مُحَسِّرًا  قَالَ :  يَا أَيُّهَا النَّاسُ ، عَلَيْكُمْ حَصَى  الْخَذْفِ  ،  يَعْنِي : حَصَى الْجِمَارِ ، يُشِيرُ بِيَدِهِ حَصَى  الْخَذْفِ  .","","Musnad Abi Ya'la al-Mawsili 6730","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن نافذ المكي عن أبو الزبير المكي عن ابن جريج عن سليمان بن حيان الأحمر عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6736","16 - (  6731  ) -  حَدَّثَنَا  أَبُو بَكْرٍ عَبْدُ اللهِ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  قَبِيصَةُ بْنُ عُقْبَةَ ،  عَنْ  يُونُسَ بْنِ أَبِي إِسْحَاقَ ،  عَنْ  أَبِي إِسْحَاقَ  ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ قَالَ :  كُنْتُ رِدْفَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَعْرَابِيٌّ مَعَهُ ابْنَةٌ لَهُ حَسْنَاءُ  ، فَجَعَلَ يَعْرِضُهَا لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَجَاءَ أَنْ يَتَزَوَّجَهَا ، قَالَ : فَجَعَلْتُ أَلْتَفِتُ إِلَيْهَا ، وَجَعَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْخُذُ بِرَأْسِي فَيَلْوِيهِ ، وَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُلَبِّي حَتَّى رَمَى جَمْرَةَ  الْعَقَبَةِ  .         [12/98]","","Musnad Abi Ya'la al-Mawsili 6731","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن سعيد بن جبير الأسدي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن قبيصة بن عقبة السوائي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6737","17 - (  6732  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  يَعْلَى بْنُ عُبَيْدٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  قَالَ :  أَفَاضَ  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ  عَرَفَاتٍ  وَأُسَامَةُ  رِدْفُهُ ،  فَجَالَتْ  بِهِ النَّاقَةُ وَهُوَ وَاقِفٌ ، فَضَرَبَهَا قَبْلَ أَنْ يُفِيضَ وَهُوَ رَافِعٌ يَدَيْهِ لَا تُجَاوِزَانِ رَأْسَهُ ، فَلَمَّا  أَفَاضَ  ، سَارَ عَلَى  هِينَتِهِ  حَتَّى أَتَى  جَمْعًا  ، ثُمَّ  أَفَاضَ  مِنْ  جَمْعٍ  وَالْفَضْلُ  رِدْفُهُ ، فَقَالَ  الْفَضْلُ  :  مَا زَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُلَبِّي حَتَّى رَمَى جَمْرَةَ  الْعَقَبَةِ  .","","Musnad Abi Ya'la al-Mawsili 6732","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن يعلى بن عبيد الطنافسي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6738","18 - (  6733  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  الْحَسَنُ بْنُ مُوسَى ،  عَنْ  حَمَّادِ بْنِ سَلَمَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَامَ فِي         [12/99]      الْكَعْبَةِ  ، وَلَمْ يَرْكَعْ ، وَلَمْ يَسْجُدْ  .         [12/100]","","Musnad Abi Ya'la al-Mawsili 6733","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن عمرو بن دينار الأثرم عن حماد بن سلمة عن الحسن بن موسى الأشيب عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6739","19 - (  6734  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  مُشَاشٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  قَالَ :  أَمَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ضَعَفَةَ  بَنِي هَاشِمٍ  أَنْ يَتَعَجَّلُوا مِنْ  جَمْعٍ  بِلَيْلٍ  .","","Musnad Abi Ya'la al-Mawsili 6734","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن عطاء بن أبي رباح عن مشاش السليمي عن شعبة بن الحجاج عن عفان بن مسلم الصفار عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6740","20 - (  6735  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  حَفْصٌ ،  عَنْ  جَعْفَرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَلِيِّ بْنِ حُسَيْنٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  قَالَ :  كُنْتُ رِدْفَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَمَى جَمْرَةَ  الْعَقَبَةِ  بِسَبْعِ حَصَيَاتٍ  ، فَكَبَّرَ مَعَ كُلِّ حَصَاةٍ  .         [12/101]","","Musnad Abi Ya'la al-Mawsili 6735","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن علي بن الحسين زين العابدين عن أبو جعفر الباقر عن جعفر الصادق عن حفص بن غياث النخعي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6741","21 - (  6736  ) -  حَدَّثَنَا  مَسْرُوقُ بْنُ الْمَرْزُبَانِ ،  حَدَّثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - شَرِبَ يَوْمَ عَرَفَةَ  .","","Musnad Abi Ya'la al-Mawsili 6736","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن عطاء بن أبي رباح عن ابن جريج عن حفص بن غياث النخعي عن مسروق بن المرزبان الكندي عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6742","22 - (  6737  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ،  حَدَّثَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  حَدَّثَنَا  الْفَضْلُ بْنُ عَبَّاسٍ  قَالَ :  أَتَتِ  امْرَأَةٌ مِنْ خَثْعَمَ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ :  يَا رَسُولَ اللهِ ، إِنَّ أَبِي أَدْرَكَتْهُ فَرِيضَةُ اللهِ فِي  الْحَجِّ  ، وَهُوَ شَيْخٌ كَبِيرٌ لَا يَسْتَطِيعُ أَنْ يَثْبُتَ عَلَى دَابَّتِهِ  ، قَالَ : فَحُجِّي عَنْ أَبِيكِ  .  قَالَ  مَعْمَرٌ  : وَكَانَ  يَحْيَى بْنُ أَبِي إِسْحَاقَ  يُحَدِّثُ أَنَّهُ سَمِعَ  سُلَيْمَانَ بْنَ يَسَارٍ  ، أَنَّهَا امْرَأَةٌ سَأَلَتْ عَنْ أُمِّهَا  .","","Musnad Abi Ya'la al-Mawsili 6737","","الفضل بن العباس بن عبد المطلب الهاشمي عن عبد الله بن عباس عن سليمان بن يسار مولى ميمونة زوج رسول الله عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6743","23 - (  6738  ) -  حَدَّثَنَا  هَارُونُ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ قَالَ :  أَخْبَرَنِي  اللَّيْثُ ،  عَنْ  عَبْدِ رَبِّهِ بْنِ سَعِيدٍ ،  عَنْ  عِمْرَانَ بْنِ أَبِي أَنَسٍ ،  عَنْ  عَبْدِ اللهِ ،  عَنْ  رَبِيعَةَ بْنِ الْحَارِثِ ،         [12/102]      عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ :  الصَّلَاةُ مَثْنَى مَثْنَى ، وَتَشَهَّدُ مُسْتَقْبِلًا فِي كُلِّ رَكْعَتَيْنِ  ، وَتَضَرَّعُ وَتَخَشَّعُ وَتَسَاكَنُ ، ثُمَّ تُقْنِعُ يَدَيْكَ ، يَقُولُ : تَرْفَعُهُمَا إِلَى رَبِّكَ مُسْتَقْبِلًا بِبُطُونِهِمَا وَجْهَكَ ، وَتَقُولُ : يَا رَبِّ يَا رَبِّ ، مَنْ لَمْ يَفْعَلْ ذَلِكَ فَهِيَ  خِدَاجٌ  .         [12/103]             [12/104]","","Musnad Abi Ya'la al-Mawsili 6738","","الفضل بن العباس بن عبد المطلب الهاشمي عن ربيعة بن الحارث الهاشمي عن عبد الله بن نافع بن العمياء عن عمران بن أبي أنس العامري عن عبد ربه بن سعيد النجاري عن الليث بن سعد عن عبد الله بن وهب المصري عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند الفضل بن العباس رحمه الله"
"6744","[12/105]      مُسْنَدُ  فَاطِمَةَ بِنْتِ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِمَا  1 - (  6739  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ،  حَدَّثَنَا  وُهَيْبُ بْنُ خَالِدٍ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،         [12/106]      عَنْ  جَابِرٍ قَالَ :  أَقَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تِسْعًا  بِالْمَدِينَةِ  لَمْ يَحُجَّ ، ثُمَّ أَذَّنَ فِي النَّاسِ بِالْخُرُوجِ  ، فَلَمَّا جَاءَ  ذَا الْحُلَيْفَةِ  صَلَّى  بِذِي الْحُلَيْفَةِ  ، فَوَلَدَتْ  أَسْمَاءُ بِنْتُ عُمَيْسٍ  ،  مُحَمَّدَ بْنَ أَبِي بَكْرٍ  ، وَأَرْسَلَتْ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : اغْتَسِلِي وَاسْتَثْفِرِي بِالثَّوْبِ وَأَهِلِّي ، قَالَ : فَفَعَلَتْ ، فَلَمَّا اطْمَأَنَّ صَدْرُ رَاحِلَةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى ظَهْرِ  الْبَيْدَاءِ  أَهَلَّ وَأَهْلَلْنَا مَعَهُ ، لَا نَعْرِفُ إِلَّا  الْحَجَّ  وَلَهُ خَرَجْنَا ، وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَيْنَ أَظْهُرِنَا ، وَالْقُرْآنُ يَنْزِلُ عَلَيْهِ وَهُوَ يَعْرِفُ تَأْوِيلَهُ ، وَإِنَّمَا يَفْعَلُ مَا أُمِرَ بِهِ .  قَالَ  جَابِرٌ  : فَنَظَرْتُ بَيْنَ يَدَيَّ ، وَمِنْ خَلْفِي ، وَعَنْ يَمِينِي ، وَعَنْ شِمَالِي مَدَّ بَصَرِي ، وَالنَّاسُ مُشَاةٌ وَالرُّكْبَانُ ، فَجَعَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُلَبِّي يَقُولُ :  لَبَّيْكَ  اللَّهُمَّ  لَبَّيْكَ ،  لَبَّيْكَ  لَا شَرِيكَ لَكَ  لَبَّيْكَ ،  إِنَّ الْحَمْدَ وَالنِّعْمَةَ لَكَ وَالْمُلْكَ ، لَا شَرِيكَ لَكَ ، فَلَمَّا قَدِمْنَا  مَكَّةَ  بَدَأَ  فَاسْتَلَمَ  الرُّكْنَ  ، فَسَعَى ثَلَاثَةَ أَطْوَافٍ ، وَمَشَى أَرْبَعًا ، فَلَمَّا فَرَغَ مِنْ طَوَافِهِ وَانْطَلَقَ إِلَى  الْمَقَامِ  ، فَقَالَ : قَالَ اللهُ :         [12/107]             {      وَاتَّخِذُوا مِنْ مَقَامِ إِبْرَاهِيمَ مُصَلًّى         }      صَلَّى خَلْفَ  مَقَامِ إِبْرَاهِيمَ  رَكْعَتَيْنِ .  قَالَ  جَعْفَرُ بْنُ مُحَمَّدٍ  : قَالَ أَبِي : كَانَ يَقْرَأُ فِيهِمَا بِالتَّوْحِيدِ :         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      ، وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      قَالَ : وَلَمْ يُذْكَرْ ذَلِكَ عَنْ  جَابِرٍ  .  قَالَ  جَابِرٌ  : ثُمَّ انْطَلَقَ إِلَى الرُّكْنِ  فَاسْتَلَمَهُ  ، ثُمَّ انْطَلَقَ إِلَى  الصَّفَا  ، فَقَالَ : نَبْدَأُ بِمَا بَدَأَ اللهُ بِهِ :         {      إِنَّ الصَّفَا وَالْمَرْوَةَ مِنْ شَعَائِرِ اللهِ         }      ، فَرَقِيَ عَلَى  الصَّفَا  ، حَتَّى بَدَا لَهُ  الْبَيْتُ  ، وَكَبَّرَ ثَلَاثًا ، وَقَالَ : لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ ، وَلَهُ الْحَمْدُ ، يُحْيِي وَيُمِيتُ ، بِيَدِهِ الْخَيْرُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، ثَلَاثًا ، وَدَعَا فِي ذَلِكَ ثُمَّ هَبَطَ مِنَ  الصَّفَا  ، فَمَشَى حَتَّى إِذَا تَصَوَّبَتْ قَدَمَاهُ فِي بَطْنِ الْمَسِيلِ ، سَعَى حَتَّى إِذَا صَعِدَتْ قَدَمَاهُ فِي بَطْنِ الْمَسِيلِ مَشَى إِلَى  الْمَرْوَةِ  فَرَقِيَ إِلَى  الْمَرْوَةِ  ، حَتَّى بَدَا لَهُ  الْبَيْتُ  ، فَقَالَ مِثْلَ مَا قَالَ عَلَى  الصَّفَا  ، فَطَافَ سَبْعًا ، فَقَالَ : مَنْ لَمْ يَكُنْ مَعَهُ الْهَدْيُ فَلْيَحْلِلْ ، وَمَنْ كَانَ مَعَهُ الْهَدْيُ فَلْيَقُمْ عَلَى إِحْرَامِهِ ، فَإِنِّي لَوْلَا أَنَّ مَعِي هَدْيًا لَأَحْلَلْتُ ، وَلَوْ أَنِّي  اسْتَقْبَلْتُ  مِنْ أَمْرِي مَا اسْتَدْبَرْتُ لَأَهْلَلْتُ بِعُمْرَةٍ .  قَالَ : وَقَدِمَ  عَلِيٌّ  مِنَ  الْيَمَنِ  ، فَقَالَ لَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : بِأَيِّ شَيْءٍ أَهْلَلْتَ يَا  عَلِيُّ  ؟ قَالَ : قُلْتُ : اللَّهُمَّ إِنِّي أُهِلُّ بِمَا أَهَلَّ بِهِ رَسُولُكَ .         [12/108]      قَالَ : فَإِنَّ مَعِيَ هَدْيًا فَلَا تَحِلَّ .  قَالَ  عَلِيٌّ  : فَدَخَلْتُ عَلَى  فَاطِمَةَ  وَقَدِ اكْتَحَلَتْ ، وَلَبِسَتْ ثِيَابًا  صَبِيغًا  ، فَقُلْتُ : مَنْ أَمَرَكِ بِهَذَا ؟ قَالَتْ : أَبِي أَمَرَنِي ، قَالَ : فَكَانَ  عَلِيٌّ  يَقُولُ  بِالْعِرَاقِ  : فَانْطَلَقْتُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  مُحَرِّشًا  عَلَى  فَاطِمَةَ  مُسْتَثْبِتًا فِي الَّذِي قَالَتْ ، فَقَالَ : صَدَقَتْ ، أَنَا أَمَرْتُهَا .  قَالَ : وَنَحَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِائَةَ بَدَنَةٍ مِنْ ذَلِكَ ، بِيَدِهِ ثَلَاثًا وَسِتِّينَ بَدَنَةً ، وَنَحَرَ  عَلِيٌّ  مَا غَبَرَ ، ثُمَّ أَخَذَ مِنْ كُلِّ بَدَنَةٍ قِطْعَةً فَطُبِخُوا جَمِيعًا ، فَأَكَلَا مِنَ اللَّحْمِ ، وَشَرِبَا مِنَ الْمَرَقِ .  قَالَ  سُرَاقَةُ بْنُ مَالِكِ بْنِ جُعْشُمٍ  : يَا رَسُولَ اللهِ ، أَلِعَامِنَا هَذَا أَمْ  لِلْأَبَدِ  ؟ قَالَ : بَلْ  لِلْأَبَدِ  ،  دَخَلَتِ  الْعُمْرَةُ فِي  الْحَجِّ  ،  وَشَبَّكَ  بَيْنَ أَصَابِعِهِ  .","","Musnad Abi Ya'la al-Mawsili 6739","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن وهيب بن خالد الكرابيسي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند فاطمة بنت رسول الله صلى الله عليهما"
"6745","2 - (  6740  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْحَسَنِ بْنِ أَبِي الْحَسَنِ ،  عَنْ  فَاطِمَةَ بِنْتِ رَسُولِ اللهِ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَكَلَ فِي بَيْتِهَا  عَرْقًا  ، فَجَاءَهُ  بِلَالٌ  فَآذَنَهُ بِالصَّلَاةِ ، فَقَامَ لِيُصَلِّيَ ، فَأَخَذْتُ بِثَوْبِهِ ،         [12/109]      فَقُلْتُ : يَا أَبَةِ ، أَلَا تَوَضَّأُ ؟ قَالَ : مِمَّ أَتَوَضَّأُ ، أَيْ بُنَيَّةُ ، فَقُلْتُ : مِمَّا مَسَّتِ النَّارُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَوَلَيْسَ أَطْهَرُ طَعَامِكُمْ مَا مَسَّتْهُ النَّارُ . ؟","","Musnad Abi Ya'la al-Mawsili 6740","","فاطمة الزهراء عن الحسن بن الحسن بن علي بن أبي طالب عن إسحاق بن يسار المازنى عن محمد بن إسحاق عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند فاطمة بنت رسول الله صلى الله عليهما"
"6746","3 - (  6741  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  شَيْبَةَ بْنِ نَعَامَةَ ،  عَنْ  فَاطِمَةَ بِنْتِ الْحُسَيْنِ ،  عَنْ  فَاطِمَةَ الْكُبْرَى ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لِكُلِّ بَنِي أُمٍّ عَصَبَةٌ يَنْتَمُونَ إِلَيْهِ ، إِلَّا وَلَدَ  فَاطِمَةَ  فَأَنَا وَلِيُّهُمْ وَأَنَا عَصَبَتُهُمْ  .         [12/110]","","Musnad Abi Ya'la al-Mawsili 6741","","فاطمة الزهراء عن فاطمة بنت الحسين بن علي بن أبي طالب عن شيبة بن نعامة الضبي عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","مسند فاطمة بنت رسول الله صلى الله عليهما"
"6747","4 - (  6742  ) -  حَدَّثَنَا  الْحُسَيْنُ بْنُ الْأَسْوَدِ ،  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ الْعَنْقَزِيُّ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  يَحْيَى بْنِ جَعْدَةَ قَالَ :  قَالَتْ  فَاطِمَةُ بِنْتُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : قَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ  عِيسَى ابْنَ مَرْيَمَ  مَكَثَ فِي  بَنِي إِسْرَائِيلَ  أَرْبَعِينَ سَنَةً  .","","Musnad Abi Ya'la al-Mawsili 6742","","فاطمة الزهراء عن يحيى بن جعدة بن هبيرة المخزومي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عمرو بن محمد الأحمر عن الحسين بن علي بن الأسود العجلي عن أبو يعلى الموصلي","مسند فاطمة بنت رسول الله صلى الله عليهما"
"6748","5 - (  6743  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي سَمِينَةَ الْبَصْرِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَالِدٍ الْحَنَفِيُّ ،  حَدَّثَنَا  مُوسَى بْنُ يَعْقُوبَ الزَّمْعِيُّ ،  عَنْ  هَاشِمِ بْنِ هَاشِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ وَهْبٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :         [12/111]      جَاءَتْ فَاطِمَةُ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَارَّهَا بِشَيْءٍ فَبَكَتْ ، ثُمَّ سَارَّهَا بِشَيْءٍ فَضَحِكَتْ ، فَسَأَلْتُهَا عَنْهُ ، فَقَالَتْ : أَخْبَرَنِي أَنَّهُ مَقْبُوضٌ فِي هَذِهِ السَّنَةِ ، فَبَكَيْتُ ، فَقَالَ :  مَا يَسُرُّكِ أَنْ تَكُونِي سَيِّدَةَ نِسَاءِ أَهْلِ الْجَنَّةِ إِلَّا فُلَانَةَ ؟  فَضَحِكْتُ  .","","Musnad Abi Ya'la al-Mawsili 6743","","فاطمة الزهراء عن هند بنت أبي أمية زوج رسول الله عن عبد الله بن وهب بن زمعة الغنمي عن هاشم بن هاشم بن عتبة الوقاصي عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن محمد بن خالد بن عثمة الهاشمى عن محمد بن إسماعيل بن أبي سمينة عن أبو يعلى الموصلي","مسند فاطمة بنت رسول الله صلى الله عليهما"
"6749","6 - (  6744  ) -  حَدَّثَنَا  ابْنُ إِسْمَاعِيلَ بْنِ أَبِي سَمِينَةَ ،  حَدَّثَنَا  أَبُو نُعَيْمٍ ،  حَدَّثَنَا  زَكَرِيَّا ،  عَنْ  فِرَاسٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ ، نَحْوَهُ .","","Musnad Abi Ya'la al-Mawsili 6744","","فاطمة الزهراء عن عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن الشعبي عن فراس بن يحيى الخارفي عن زكريا بن أبي زائدة الوادعي عن الفضل بن دكين عن محمد بن إسماعيل بن أبي سمينة عن أبو يعلى الموصلي","مسند فاطمة بنت رسول الله صلى الله عليهما"
"6750","7 - (  6745  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  الْفَضْلُ بْنُ دُكَيْنٍ ،  حَدَّثَنَا  زَكَرِيَّا بْنُ أَبِي زَائِدَةَ ،  عَنْ  فِرَاسٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  أَقْبَلَتْ فَاطِمَةُ تَمْشِي كَأَنَّ مَشْيَهَا مِشْيَةُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : مَرْحَبًا بِابْنَتِي ،  وَأَجْلَسَهَا عَنْ يَمِينِهِ أَوْ عَنْ يَسَارِهِ  ، وَأَسَرَّ إِلَيْهَا حَدِيثًا فَبَكَتْ ، ثُمَّ أَسَرَّ إِلَيْهَا حَدِيثًا         [12/112]      فَضَحِكَتْ ، فَقُلْتُ : مَا رَأَيْتُ كَالْيَوْمِ حُزْنًا أَقْرَبَ مِنْ فَرَحٍ ! أَيُّ شَيْءٍ أَسَرَّ إِلَيْكِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَتْ : مَا كُنْتُ لِأُفْشِيَ سِرَّ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا قُبِضَ سَأَلْتُهَا ، فَقَالَتْ : قَالَ :  إِنَّ  جِبْرِيلَ  كَانَ يَأْتِينِي  فَيُعَارِضُنِي  الْقُرْآنَ مَرَّةً ، وَإِنَّهُ أَتَانِي الْعَامَ فَعَارَضَنِي بِهِ مَرَّتَيْنِ  ، وَلَا أُرَى أَجَلِي إِلَّا قَدْ حَضَرَ ، وَنِعْمَ  السَّلَفُ  أَنَا لَكِ ، وَإِنَّكِ أَوَّلُ أَهْلِ بَيْتِي لُحُوقًا بِي ، فَبَكَيْتُ لِذَلِكَ ، فَقَالَ : أَمَا تَرْضَيْنَ أَنْ تَكُونِي  سَيِّدَةَ نِسَاءِ الْمُؤْمِنِينَ ، أَوْ نِسَاءِ هَذِهِ الْأُمَّةِ ؟  قَالَتْ : فَضَحِكْتُ  .         [12/113]","","Musnad Abi Ya'la al-Mawsili 6745","","فاطمة الزهراء عن عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن الشعبي عن فراس بن يحيى الخارفي عن زكريا بن أبي زائدة الوادعي عن الفضل بن دكين عن زهير بن حرب عن أبو يعلى الموصلي","مسند فاطمة بنت رسول الله صلى الله عليهما"
"6751","8 - (  6746  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ،  حَدَّثَنَا  الْمُفَضَّلُ بْنُ فَضَالَةَ قَالَ :  حَدَّثَنِي  رَبِيعَةُ الْمَعَافِرِيُّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  قَبَرْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمًا ، فَلَمَّا فَرَغَ انْصَرَفَ وَوَقَفَ وَسْطَ الطَّرِيقِ ، فَإِذَا نَحْنُ بِامْرَأَةٍ مُقْبِلَةٍ لَا نَظُنُّ أَنَّهُ عَرَفَهَا ، فَلَمَّا دَنَتْ ، إِذَا هِيَ  فَاطِمَةُ  ، فَقَالَ لَهَا         [12/114]      رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : يَا  فَاطِمَةُ  ، مَا أَخْرَجَكِ مِنْ بَيْتِكِ ؟ قَالَتْ : أَتَيْتُ يَا رَسُولَ اللهِ أَهْلَ هَذَا الْبَيْتِ فَرَحِمْتُ إِلَيْهِمْ مَيِّتَهُمْ ، أَوْ  عَزَّيْتُهُمْ  ، لَا أَحْفَظُ أَيَّ ذَلِكَ قَالَتْ .  قَالَ  رَبِيعَةُ  : فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : لَعَلَّكِ بَلَغْتِ مَعَهُمُ  الْكُدَى  ؟ قَالَتْ : مَعَاذَ اللهِ ، وَقَدْ سَمِعْتُكَ تَذْكُرُ فِيهَا مَا تَذْكُرُ ، قَالَ :  لَوْ بَلَغْتِ  الْكُدَى  مَا رَأَيْتِ الْجَنَّةَ  حَتَّى يَرَاهَا  جَدُّكِ أَبُو أُمِّكِ ، أَوْ أَبُو أَبِيكِ  ،  شَكَّ  أَبُو يَحْيَى  ،  فَسَأَلْتُ  رَبِيعَةَ  عَنِ  الْكُدَى  ، فَقَالَ : أَحْسَبُهَا الْمَقَابِرَ  .  قَالَ :  فَلَمَّا رَأَيْتُ  رَبِيعَةَ  شَكَّ ، لَقِيتُ  يَزِيدَ بْنَ أَبِي حَبِيبٍ  ، فَأَخْبَرْتُهُ بِحَدِيثِ  رَبِيعَةَ  وَسَأَلْتُهُ  الْكُدَى  ، فَقَالَ : هِيَ الْمَقَابِرُ  .         [12/115]      9 - (  6747  ) -  قَالَ  يَزِيدُ بْنُ أَبِي حَبِيبٍ :  وَحَضَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جِنَازَةَ رَجُلٍ ، فَلَمَّا وُضِعَتْ لِيُصَلِّيَ عَلَيْهَا أَبْصَرَ امْرَأَةً ، فَسَأَلَ عَنْهَا ، فَقِيلَ لَهُ : هِيَ أُخْتُ الْمَيِّتِ يَا رَسُولَ اللهِ ، فَقَالَ لَهَا :  ارْجِعِي ، وَلَمْ يُصَلِّ عَلَيْهَا حَتَّى تَوَارَتْ  .  قَالَ  يَزِيدُ  : وَقَدْ حَضَرَتْ  أُمُّ سَلَمَةَ  أَبَا سَلَمَةَ  .","","Musnad Abi Ya'la al-Mawsili 6746","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن ربيعة بن سيف المعافري عن المفضل بن فضالة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند فاطمة بنت رسول الله صلى الله عليهما"
"6752","10 - (  6748  ) -  حَدَّثَنَا  جُبَارَةُ بْنُ مُغَلِّسٍ ،  حَدَّثَنَا  عُبَيْدُ بْنُ         [12/116]      وَسِيمٍ الْجَمَّالُ ،  أَخْبَرَنَا  الْحَسَنُ بْنُ الْحَسَنِ ،  عَنْ  أُمِّهِ فَاطِمَةَ بِنْتِ الْحُسَيْنِ ،  عَنْ  أَبِيهَا حُسَيْنِ بْنِ عَلِيٍّ ،  عَنْ  أُمِّهِ فَاطِمَةَ بِنْتِ مُحَمَّدٍ  ، قَالَتْ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَلُومَنَّ امْرُؤٌ إِلَّا نَفْسَهُ بَاتَ وَفِي يَدِهِ رِيحُ  غَمَرٍ  .","","Musnad Abi Ya'la al-Mawsili 6748","","فاطمة الزهراء عن الحسين بن علي عن فاطمة بنت الحسين بن علي بن أبي طالب عن الحسن بن الحسن بن الحسن بن علي بن أبي طالب عن عبيد بن الوسيم البكري عن جبارة بن المغلس عن أبو يعلى الموصلي","مسند فاطمة بنت رسول الله صلى الله عليهما"
"6753","11 - (  6749  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ الْأَشَجُّ ،  حَدَّثَنَا  ابْنُ إِدْرِيسَ  ،  عَنْ  أَبِي الْجَحَّافِ دَاوُدَ بْنِ أَبِي عَوْفٍ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو الْهَاشِمِيِّ ،  عَنْ  زَيْنَبَ بِنْتِ عَلِيٍّ ،         [12/117]      عَنْ  فَاطِمَةَ بِنْتِ مُحَمَّدٍ قَالَتْ :  نَظَرَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى  عَلِيٍّ  ، فَقَالَ : هَذَا فِي الْجَنَّةِ  ، وَإِنَّ مِنْ شِيعَتِهِ قَوْمًا يَعْلَمُونَ الْإِسْلَامَ ، ثُمَّ يَرْفُضُونَهُ ، لَهُمْ نَبَزٌ يُسَمَّوْنَ الرَّافِضَةَ ، مَنْ لَقِيَهُمْ فَلْيَقْتُلْهُمْ فَإِنَّهُمْ مُشْرِكُونَ  .  قال الشيخ الألباني في الضعيفة : خطأ لا أدري منشأه ، والصواب (أبو إدريس) ، واسمه: (تليد بن سليمان) ، فهو الذي يروي عن (أبي الجحاف).","","Musnad Abi Ya'la al-Mawsili 6749","","فاطمة الزهراء عن زينب بنت على بن أبي طالب الهاشمية عن محمد بن عمرو بن الحسن بن علي بن أبي طالب عن داود بن أبي عوف البرجمي عن تليد بن سليمان المحاربي الأعرج عن عبد الله بن سعيد الأشج عن أبو يعلى الموصلي","مسند فاطمة بنت رسول الله صلى الله عليهما"
"6754","12 - (  6750  ) -  حَدَّثَنَا  عِيسَى بْنُ سَالِمٍ ،  حَدَّثَنَا  وَهْبُ بْنُ عَبْدِ الرَّحْمَنِ الْقُرَشِيُّ  ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ ،  أَنَّهُ دَخَلَ الْمُتَوَضَّأَ  فَأَصَابَ لُقْمَةً - أَوْ قَالَ : كِسْرَةً  - فِي مَجْرَى الْغَائِطِ وَالْبَوْلِ ، فَأَخَذَهَا  ، فَأَمَاطَ عَنْهَا الْأَذَى فَغَسَلَهَا غَسْلًا نِعِمَّا ، ثُمَّ دَفَعَهَا إِلَى غُلَامِهِ ، فَقَالَ : يَا         [12/118]      غُلَامُ ، ذَكِّرْنِي بِهَا إِذَا تَوَضَّأْتُ ، فَلَمَّا تَوَضَّأَ قَالَ لِلْغُلَامِ : يَا غُلَامُ ، نَاوِلْنِي  اللُّقْمَةَ ، أَوْ قَالَ : الْكِسْرَةَ  ، فَقَالَ : يَا مَوْلَايَ أَكَلْتُهَا ، قَالَ : فَاذْهَبْ فَأَنْتَ  حُرٌّ  لِوَجْهِ اللهِ ، قَالَ : فَقَالَ لَهُ الْغُلَامُ : يَا مَوْلَايَ ، لِأَيِّ شَيْءٍ أَعْتَقْتَنِي ؟ قَالَ : لِأَنِّي  سَمِعْتُ  مِنْ فَاطِمَةَ بِنْتِ رَسُولِ اللهِ تَذْكُرُ عَنْ أَبِيهَا رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَخَذَ لُقْمَةً أَوْ كِسْرَةً مِنْ مَجْرَى الْغَائِطِ وَالْبَوْلِ ، فَأَخَذَهَا فَأَمَاطَ عَنْهَا الْأَذَى وَغَسَلَهَا  غَسْلًا نِعِمَّا ثُمَّ أَكَلَهَا لَمْ تَسْتَقِرَّ فِي بَطْنِهِ حَتَّى يُغْفَرَ لَهُ  ، فَمَا كُنْتُ لِأَسْتَخْدِمَ رَجُلًا مِنْ أَهْلِ الْجَنَّةِ  .         [12/119]      وهو (وهب بن وهب بن كثير أبو البختري القاضي) ، كما ذكره ابن حجر في المطالب ، وقال السيوطي في اللآلىء المصنوعة : ""وهب بن عبد الرحمن"" وهو (وهب بن وهب القاضي ) وإنما دلسه عيسى .","","Musnad Abi Ya'la al-Mawsili 6750","","فاطمة الزهراء عن الحسن بن علي سبط رسول الله عن أبو جعفر الباقر عن جعفر الصادق عن وهب بن وهب الزمعي عن عيسى بن سالم الشاشي عن أبو يعلى الموصلي","مسند فاطمة بنت رسول الله صلى الله عليهما"
"6755","13 - (  6751  ) -  حَدَّثَنَا  زُهَيْرُ بْنُ حَرْبٍ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ ،  حَدَّثَنِي  أَبِي  قَالَ  :  أَتَيْنَا جَابِرَ بْنَ عَبْدِ اللهِ ، وَهُوَ فِي  بَنِي سَلِمَةَ  ، فَسَأَلْنَاهُ عَنْ حَجَّةِ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  ،  وَذَكَرَ الْحَدِيثَ بِطُولِهِ ، وَهُوَ عِنْدَنَا مَكْتُوبٌ فِي مُسْنَدِ  جَابِرٍ  .","","Musnad Abi Ya'la al-Mawsili 6751","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","مسند فاطمة بنت رسول الله صلى الله عليهما"
"6756","14 - (  6752  ) -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنِ  الْوَلِيدِ بْنِ جُمَيْعٍ ،  عَنْ  أَبِي الطُّفَيْلِ قَالَ :  جَاءَتْ  فَاطِمَةُ  إِلَى أَبِي بَكْرٍ فَقَالَتْ : يَا  خَلِيفَةَ  رَسُولِ اللهِ ، أَنْتَ وَرِثْتَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمْ أَهْلُهُ ؟ قَالَ : بَلْ أَهْلُهُ ، قَالَتْ : فَمَا بَالُ  سَهْمِ  رَسُولِ اللهِ ؟ قَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا أَطْعَمَ اللهُ نَبِيًّا  طُعْمَةً ،  ثُمَّ قَبَضَهُ ، جَعَلَهُ لِلَّذِي يَقُومُ بَعْدَهُ  ، فَرَأَيْتُ أَنْ أَرُدَّهُ عَلَى الْمُسْلِمِينَ ، فَقَالَتْ : أَنْتَ وَرَسُولُ اللهِ أَعْلَمُ  .","","Musnad Abi Ya'la al-Mawsili 6752","","أبو  بكر الصديق عن عامر بن واثلة عن الوليد بن عبد الله بن جميع الخزاعي عن محمد بن فضيل بن غزوان عن عبد الرحمن بن صالح العتكي عن أبو يعلى الموصلي","مسند فاطمة بنت رسول الله صلى الله عليهما"
"6757","15 - (  6753  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ قَالَ :  حَدَّثَنِي  زِيَادُ بْنُ سَعْدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَلِيِّ بْنِ حُسَيْنٍ ،         [12/120]      أَنَّ أَزْوَاجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اجْتَمَعْنَ إِلَى  فَاطِمَةَ  ، فَقُلْنَ لَهَا :  ائْتِي رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَقُولِي لَهُ : إِنَّ أَزْوَاجَكَ يَنْشُدْنَكَ الْعَدْلَ فِي  بِنْتِ أَبِي قُحَافَةَ  ، فَأَتَتْهُ فَذَكَرَتْ ذَلِكَ لَهُ ، فَقَالَ : أَمَا تُحِبِّينَ مَنْ أُحِبُّ ؟ قَالَتْ : بَلَى ، قَالَ : فَإِنِّي أُحِبُّ هَذِهِ  .         [12/121]","","Musnad Abi Ya'la al-Mawsili 6753","","علي بن الحسين زين العابدين عن الزهري عن زياد بن سعد الخراساني عن سفيان بن عيينة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند فاطمة بنت رسول الله صلى الله عليهما"
"6758","16 - (  6754  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ عَرَفَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  عَنْ  لَيْثِ بْنِ أَبِي سُلَيْمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَسَنِ ،  عَنْ  فَاطِمَةَ بِنْتِ رَسُولِ اللهِ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا دَخَلَ الْمَسْجِدَ قَالَ : بِسْمِ اللهِ  ، وَالسَّلَامُ عَلَى رَسُولِ اللهِ ، اللَّهُمَّ اغْفِرْ لِي ذُنُوبِي ، وَافْتَحْ لِي أَبْوَابَ رَحْمَتِكَ ، وَإِذَا خَرَجَ قَالَ : بِسْمِ اللهِ ، وَالسَّلَامُ عَلَى رَسُولِ اللهِ ، اللَّهُمَّ اغْفِرْ لِي ذُنُوبِي ، وَافْتَحْ لِي أَبْوَابَ فَضْلِكَ  .         [12/122]","","Musnad Abi Ya'la al-Mawsili 6754","","فاطمة الزهراء عن عبد الله بن حسن بن حسن بن علي بن أبي طالب عن ليث بن أبي سليم عن أبو معاوية الضرير عن الحسن بن عرفة العبدي عن أبو يعلى الموصلي","مسند فاطمة بنت رسول الله صلى الله عليهما"
"6759","17 - (  6755  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَعْقُوبُ ،  حَدَّثَنَا  أَبِي ،  عَنْ  أَبِيهِ ،  أَنَّ عُرْوَةَ بْنَ الزُّبَيْرِ  حَدَّثَهُ  ، أَنَّ عَائِشَةَ  حَدَّثَتْهُ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَعَا بِنْتَهُ فَاطِمَةَ ، فَسَارَّهَا فَبَكَتْ ، ثُمَّ سَارَّهَا فَضَحِكَتْ  ، قَالَتْ  عَائِشَةُ  : فَقُلْتُ  لِفَاطِمَةَ  : مَا هَذَا الَّذِي سَارَّكِ بِهِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَبَكَيْتِ ، ثُمَّ سَارَّكِ فَضَحِكْتِ ؟ قَالَتْ : سَارَّنِي فَأَخْبَرَنِي بِمَوْتِهِ ، فَبَكَيْتُ ، ثُمَّ سَارَّنِي فَأَخْبَرَنِي أَنِّي أَوَّلُ مَنْ يَتْبَعُهُ مِنْ أَهْلِهِ ، فَضَحِكْتُ  .","","Musnad Abi Ya'la al-Mawsili 6755","","فاطمة الزهراء عن عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","مسند فاطمة بنت رسول الله صلى الله عليهما"
"6760","18 - (  6756  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  سُهَيْلٍ ،  عَنْ  أَبِيهِ ،         [12/123]      عَنْ  أَبِي هُرَيْرَةَ قَالَ :  سَأَلَتْ  فَاطِمَةُ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَادِمًا ، فَقَالَ : أَلَا أَدُلُّكِ عَلَى مَا هُوَ خَيْرٌ مِنْ ذَلِكَ  ؟ تُسَبِّحِينَ اللهَ ، وَتُكَبِّرِينَ ، وَتَحْمَدِينَ اللهَ إِذَا أَوَيْتِ إِلَى فِرَاشِكِ مِائَةَ مَرَّةٍ  .","","Musnad Abi Ya'la al-Mawsili 6756","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند فاطمة بنت رسول الله صلى الله عليهما"
"6761","[12/124]      مُسْنَدُ  الْحَسَنِ بْنِ عَلِيِّ بْنِ أَبِي طَالِبٍ  .  1 - (  6757  ) -  حَدَّثَنَا  السَّامِيُّ  حَدَّثَنَا  سُكَيْنُ بْنُ عَبْدِ الْعَزِيزِ  حَدَّثَنَا  جَعْفَرٌ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ  :         [12/125]      لَمَّا قُتِلَ  عَلِيٌّ  قَامَ حَسَنُ بْنُ عَلِيٍّ خَطِيبًا  ، فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ثُمَّ قَالَ : أَمَّا بَعْدُ ، وَاللهِ لَقَدْ قَتَلْتُمُ اللَّيْلَةَ رَجُلًا فِي لَيْلَةٍ نَزَلَ فِيهَا الْقُرْآنُ وَفِيهَا رُفِعَ  عِيسَى ابْنُ مَرْيَمَ  وَفِيهَا قُتِلَ  يُوشَعُ بْنُ نُونٍ  فَتَى  مُوسَى  عَلَيْهِ السَّلَامُ  .","","Musnad Abi Ya'la al-Mawsili 6757","","الحسن بن علي سبط رسول الله عن علي بن الحسين زين العابدين عن أبو جعفر الباقر عن جعفر الصادق عن سكين بن عبد العزيز بن قيس المجاشعي عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند الحسن بن علي بن أبي طالب"
"6762","2 - (  6758  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ  حَدَّثَنَا  سُكَيْنٌ قَالَ :  وَحَدَّثَنِي  أَبِي  ،  عَنْ  خَالِدِ بْنِ جَابِرٍ ،  عَنْ  أَبِيهِ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ مِثْلَ هَذَا وَزَادَ فِيهِ :  وَفِيهَا تِيبَ عَلَى  بَنِي إِسْرَائِيلَ  .  وَقَالَ : وَاللهِ مَا سَبَقَهُ أَحَدٌ كَانَ قَبْلَهُ وَلَا لَحِقَهُ أَحَدٌ كَانَ بَعْدَهُ ، وَإِنْ  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَيَبْعَثُهُ فِي السَّرِيَّةِ  وَجِبْرِيلُ  عَنْ يَمِينِهِ         [12/126]      وَمِيكَائِيلُ  عَنْ يَسَارِهِ  ، وَاللهِ مَا تَرَكَ صَفْرَاءَ وَلَا بَيْضَاءَ إِلَّا ثَمَانِمِائَةٍ أَوْ سَبْعَمِائَةِ دِرْهَمٍ  أَرْصَدَهَا  لِخَادِمٍ يَشْتَرِيهَا  .         [12/127]","","Musnad Abi Ya'la al-Mawsili 6758","","الحسن بن علي سبط رسول الله عن جابر الكوفي عن خالد بن جابر عن عبد العزيز بن قيس العبدي عن سكين بن عبد العزيز بن قيس المجاشعي عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند الحسن بن علي بن أبي طالب"
"6763","3 - (  6759  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْخَطَّابِ ،  حَدَّثَنَا  مُؤَمَّلٌ ،  حَدَّثَنَا  شُعْبَةُ ،  حَدَّثَنَا  ابْنُ أَبِي مَرْيَمَ قَالَ :  سَمِعْتُ  السَّعْدِيَّ يَقُولُ :  قُلْتُ  لِلْحَسَنِ :  مَا تَحْفَظُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ : سَمِعْتُهُ يَدْعُو فِي هَذَا الدُّعَاءِ :  اللَّهُمَّ اهْدِنَا فِيمَنْ هَدَيْتَ ، وَعَافِنَا فِيمَنْ عَافَيْتَ ، وَتَوَلَّنَا فِيمَنْ تَوَلَّيْتَ  ، وَبَارِكْ لَنَا فِيمَا أَعْطَيْتَ ، وَقِنَا شَرَّ مَا قَضَيْتَ ، إِنَّكَ تَقْضِي وَلَا يُقْضَى عَلَيْكَ ، وَإِنَّهُ لَا يَذِلُّ مَنْ وَالَيْتَ ، تَبَارَكْتَ وَتَعَالَيْتَ  .         [12/128]             [12/129]","","Musnad Abi Ya'la al-Mawsili 6759","","الحسن بن علي سبط رسول الله عن ربيعة بن شيبان السعدي عن يزيد بن أبي مريم الدمشقي عن شعبة بن الحجاج عن مؤمل بن إسماعيل العدوي عن محمد بن الخطاب البلدي عن أبو يعلى الموصلي","مسند الحسن بن علي بن أبي طالب"
"6764","4 - (  6760  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَرْزُوقٍ قَالَ :  حَدَّثَنِي  حُسَيْنٌ الْأَشْقَرُ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ بُكَيْرٍ ،  عَنْ  حَكِيمِ بْنِ جُبَيْرٍ ،  عَنْ  سَوَّارٍ أَبِي إِدْرِيسَ ،  عَنِ  الْمُسَيِّبِ بْنِ نَجَبَةَ قَالَ :         [12/130]      دَخَلْتُ عَلَى الْحَسَنِ بْنِ عَلِيٍّ ،  فَقَالَ  : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْحَرْبُ  خَدْعَةٌ  .         [12/131]","","Musnad Abi Ya'la al-Mawsili 6760","","الحسن بن علي سبط رسول الله عن المسيب بن نجبة الفزاري عن أبو إدريس المرهبي عن حكيم بن جبير الأسدي عن عبد الله بن بكير الغنوي عن الحسين بن الحسن الأشقر عن محمد بن محمد بن مرزوق الباهلي عن أبو يعلى الموصلي","مسند الحسن بن علي بن أبي طالب"
"6765","5 - (  6761  ) -  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدِ بْنِ حَيَّانَ ،  حَدَّثَنَا  أَبُو بَكْرٍ الْحَنَفِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ نَافِعٍ ،  أَخْبَرَنِي  الْعَلَاءُ بْنُ عَبْدِ الرَّحْمَنِ قَالَ :  سَمِعْتُ  الْحَسَنَ بْنَ عَلِيِّ بْنِ أَبِي طَالِبٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  صَلُّوا فِي بُيُوتِكُمْ ، لَا تَتَّخِذُوهَا  قُبُورًا  ، وَلَا تَتَّخِذُوا بَيْتِي عِيدًا  ، صَلُّوا عَلَيَّ وَسَلِّمُوا ، فَإِنَّ صَلَاتَكُمْ وَسَلَامَكُمْ يَبْلُغُنِي أَيْنَمَا كُنْتُمْ  .         [12/132]","","Musnad Abi Ya'la al-Mawsili 6761","","الحسن بن علي سبط رسول الله عن العلاء بن عبد الرحمن الحرقي عن عبد الله بن نافع مولى عبد الله بن عمر عن عبد الكبير بن عبد المجيد الحنفي عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند الحسن بن علي بن أبي طالب"
"6766","6 - (  6762  ) -  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  عَبْدُ الْمَلِكِ بْنُ عَمْرٍو ،  حَدَّثَنَا  شُعْبَةُ  عَنْ  بُرَيْدِ بْنِ أَبِي مَرْيَمَ قَالَ :  سَمِعْتُ  أَبَا الْحَوْرَاءِ السَّعْدِيَّ قَالَ :  سَأَلْتُ  الْحَسَنَ بْنَ عَلِيٍّ : سَمِعْتَ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ  : وَجَدْتُ تَمْرَةً مِنْ تَمْرِ الصَّدَقَةِ فَأَلْقَيْتُهَا فِي فِيَّ ، فَأَخَذَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ فِيَّ بِلُعَابِهَا ، فَأَلْقَاهَا فِي التَّمْرِ ، فَقِيلَ : يَا رَسُولَ اللهِ لِمَ أَخَذْتَهَا ؟ قَالَ : لِأَنَّ  الصَّدَقَةَ لَا تَحِلُّ  لِآلِ مُحَمَّدٍ  .  وَكَانَ يَقُولُ :  دَعْ مَا  يَرِيبُكَ  إِلَى مَا لَا  يَرِيبُكَ  ، فَإِنَّ الصِّدْقَ طُمَأْنِينَةٌ ، وَإِنَّ الْكَذِبَ رِيبَةٌ  .  قَالَ :  وَكَانَ يُعَلِّمُنَا هَذَا الدُّعَاءَ : اللَّهُمَّ اهْدِنِي فِيمَنْ هَدَيْتَ  ، وَعَافِنِي فِيمَنْ عَافَيْتَ ، وَتَوَلَّنِي فِيمَنْ تَوَلَّيْتَ ، وَبَارِكْ لِي فِيمَا أَعْطَيْتَ ، وَاكْفِنِي شَرَّ مَا قَضَيْتَ ، فَإِنَّكَ تَقْضِي وَلَا يُقْضَى عَلَيْكَ ، وَإِنَّهُ لَا يَذِلُّ مَنْ وَالَيْتَ ، تَبَارَكْتَ وَتَعَالَيْتَ  .         [12/133]             [12/134]","","Musnad Abi Ya'la al-Mawsili 6762","","الحسن بن علي سبط رسول الله عن ربيعة بن شيبان السعدي عن بريد بن أبي مريم السلولي عن شعبة بن الحجاج عن أبو عامر العقدي عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند الحسن بن علي بن أبي طالب"
"6767","7 - (  6763  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  حَدَّثَنَا  سَعْدُ بْنُ طَرِيفٍ ،  عَنْ  عُمَيْرِ بْنِ مَأْمُونِ بْنِ زُرَارَةَ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تُحْفَةُ         [12/135]      الصَّائِمِ الدُّهْنُ  وَالْمِجْمَرُ  .","","Musnad Abi Ya'la al-Mawsili 6763","","الحسن بن علي سبط رسول الله عن عمير بن مأموم الدارمي عن سعد بن طريف الإسكاف عن أبو معاوية الضرير عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند الحسن بن علي بن أبي طالب"
"6768","8 - (  6764  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي يَحْيَى  قَالَ  :  كُنْتُ بَيْنَ  الْحُسَيْنِ  وَالْحَسَنِ  ،  وَمَرْوَانَ  يَتَشَاتَمَانِ ، فَجَعَلَ  الْحَسَنُ  يَكُفُّ  الْحُسَيْنَ  ،  فَقَالَ  مَرْوَانُ  : أَهْلُ بَيْتٍ مَلْعُونُونَ ، فَغَضِبَ الْحَسَنُ ، فَقَالَ : أَقُلْتَ : أَهْلُ بَيْتٍ مَلْعُونُونَ ؟ فَوَاللهِ لَقَدْ لَعَنَكَ اللهُ عَلَى لِسَانِ نَبِيِّهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنْتَ فِي صُلْبِ أَبِيكَ  .         [12/136]","","Musnad Abi Ya'la al-Mawsili 6764","","الحسن بن علي سبط رسول الله عن زياد القرشي الأعرج عن عطاء بن السائب عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند الحسن بن علي بن أبي طالب"
"6769","9 - (  6765  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  بُرَيْدِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  أَبِي الْحَوْرَاءِ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ قَالَ :  عَلَّمَنِي جَدِّي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَلِمَاتٍ أَقُولُهُنَّ فِي  قُنُوتِ  الْوِتْرِ  : اللَّهُمَّ عَافِنِي فِيمَنْ عَافَيْتَ  ، وَتَوَلَّنِي فِيمَنْ تَوَلَّيْتَ ، وَاهْدِنِي فِيمَنْ هَدَيْتَ ، وَقِنِي شَرَّ مَا قَضَيْتَ ، فَإِنَّكَ تَقْضِي وَلَا يُقْضَى عَلَيْكَ ، وَإِنَّهُ لَا يَذِلُّ مَنْ وَالَيْتَ ، سُبْحَانَكَ تَبَارَكْتَ وَتَعَالَيْتَ  .","","Musnad Abi Ya'la al-Mawsili 6765","","الحسن بن علي سبط رسول الله عن ربيعة بن شيبان السعدي عن بريد بن أبي مريم السلولي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند الحسن بن علي بن أبي طالب"
"6770","10 - (  6766  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي يَحْيَى النَّخَعِيِّ ،  أَنَّ  الْحَسَنَ  ،  وَالْحُسَيْنَ  مَرَّ بِهِمَا  مَرْوَانُ  ، فَقَالَ لَهُمَا قَوْلًا قَبِيحًا ،         [12/137]      فَقَالَ  الْحَسَنُ ، أَوِ الْحُسَيْنُ  :  وَاللهِ ، ثُمَّ وَاللهِ ، لَقَدْ لَعَنَكَ اللهُ وَأَنْتَ فِي صُلْبِ الْحَكَمِ عَلَى لِسَانِ نَبِيِّهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : فَسَكَتَ  مَرْوَانُ  .","","Musnad Abi Ya'la al-Mawsili 6766","","الحسين بن علي عن زياد القرشي الأعرج عن عطاء بن السائب عن جرير بن عبد الحميد عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند الحسن بن علي بن أبي طالب"
"6771","11 - (  6767  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عَرْعَرَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ الْهُنَائِيُّ  حَدَّثَنَا  الْبَرَاءُ بْنُ أَبِي فَضَالَةَ  أَخْبَرَنَا  الْحَضْرَمِيُّ ،  عَنْ  أَبِي مَرْيَمَ رَضِيعِ الْجَارُودِ ،  قَالَ  :  كُنْتُ  بِالْكُوفَةِ  فَقَامَ الْحَسَنُ بْنُ عَلِيٍّ خَطِيبًا فَقَالَ : أَيُّهَا النَّاسُ رَأَيْتُ الْبَارِحَةَ فِي مَنَامِي عَجَبًا ،  رَأَيْتُ الرَّبَّ تَعَالَى فَوْقَ عَرْشِهِ فَجَاءَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى قَامَ عِنْدَ قَائِمَةٍ مِنْ قَوَائِمِ الْعَرْشِ  ، فَجَاءَ  أَبُو بَكْرٍ  فَوَضَعَ يَدَهُ عَلَى مَنْكِبِ رَسُولِ اللهِ ، ثُمَّ جَاءَ  عُمَرُ  فَوَضَعَ يَدَهُ عَلَى مَنْكِبِ  أَبِي بَكْرٍ  ، ثُمَّ جَاءَ  عُثْمَانُ  فَكَانَ نَبْذَةً ، فَقَالَ : رَبِّ سَلْ عِبَادَكَ فِيمَ قَتَلُونِي ؟ قَالَ :  فَانْثَعَبَ  مِنَ         [12/138]      السَّمَاءِ مِيزَابَانِ مِنْ دَمٍ فِي الْأَرْضِ ، قَالَ : فَقِيلَ  لِعَلِيٍّ  أَلَا تَرَى مَا يُحَدِّثُ بِهِ  الْحَسَنُ  ، قَالَ : يُحَدِّثُ بِمَا رَأَى  .","","Musnad Abi Ya'la al-Mawsili 6767","","الحسن بن علي سبط رسول الله عن أبو مريم رضيع الجارود عن الحضرمي عن البراء بن أبي فضالة عن محمد بن عباد الهنائي عن إبراهيم بن محمد بن عرعرة عن أبو يعلى الموصلي","مسند الحسن بن علي بن أبي طالب"
"6772","12 - (  6768  ) -  حَدَّثَنَا  سُفْيَانُ بْنُ وَكِيعٍ  حَدَّثَنَا  جُمَيْعُ بْنُ عُمَرَ بْنِ عَبْدِ الرَّحْمَنِ الْعِجْلِيُّ  عَنْ  مُجَاهِدٍ أَوْ مُجَالِدٍ  عَنْ  طُحْرُبٍ الْعِجْلِيِّ  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ قَالَ :  لَا أُقَاتِلُ بَعْدَ رُؤْيَا رَأَيْتُهَا ،  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَاضِعًا يَدَهُ عَلَى الْعَرْشِ ، وَرَأَيْتُ  أَبَا بَكْرٍ  وَاضِعًا يَدَهُ عَلَى النَّبِيِّ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَرَأَيْتُ  عُمَرَ  وَاضِعًا يَدَهُ عَلَى  أَبِي بَكْرٍ  ، وَرَأَيْتُ  عُثْمَانَ  وَاضِعًا يَدَهُ عَلَى  عُمَرَ  ، وَرَأَيْتُ دِمَاءً دُونَهُمْ ، فَقُلْتُ : مَا هَذِهِ الدِّمَاءُ ؟ قِيلَ : دِمَاءُ  عُثْمَانَ  يَطْلُبُ اللهُ بِهِ  .","","Musnad Abi Ya'la al-Mawsili 6768","","الحسن بن علي سبط رسول الله عن طحرب مولى الحسن بن علي عن مجالد بن سعيد عن جميع بن عمير بن عبد الرحمن الضيعي عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","مسند الحسن بن علي بن أبي طالب"
"6773","13 - (  6769  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ سُلَيْمَانَ ،  عَنْ         [12/139]      حَرِيزِ بْنِ عُثْمَانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي عَوْفٍ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ ، أَنَّهُ قَالَ  لِأَبِي الْأَعْوَرِ  : وَيْحَكَ ،  أَلَمْ يَلْعَنْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  رِعْلًا  وَذَكْوَانَ  ، وَعَمْرَو بْنَ سُفْيَانَ .  ؟","","Musnad Abi Ya'la al-Mawsili 6769","","الحسن بن علي سبط رسول الله عن عبد الرحمن بن أبي عوف الجرشي عن حريز بن عثمان الرحبي عن إسحاق بن سليمان الرازي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند الحسن بن علي بن أبي طالب"
"6774","14 - (  6770  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ قَالَ :  دَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَيْتَ  فَاطِمَةَ  ،  وَذَكَرَ الْحَدِيثَ ، وَكَتَبْنَاهُ فِي أَحَادِيثِ  ابْنِ نُمَيْرٍ  فِي الْإِمْلَاءِ .","","Musnad Abi Ya'la al-Mawsili 6770","","الحسن بن علي سبط رسول الله عن إسحاق بن يسار المازنى عن محمد بن إسحاق عن محمد بن فضيل بن غزوان عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند الحسن بن علي بن أبي طالب"
"6775","15 - (  6771  ) -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ مُوسَى بْنِ بِنْتِ         [12/140]      السُّدِّيِّ ،  حَدَّثَنَا  سَعِيدُ بْنُ خُثَيْمٍ الْهِلَالِيُّ ،  عَنِ  الْوَلِيدِ بْنِ يَسَارٍ الْهَمْدَانِيِّ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَلْحَةَ مَوْلَى بَنِي أُمَيَّةَ  قَالَ  : حَجَّ  مُعَاوِيَةُ بْنُ أَبِي سُفْيَانَ  ، وَحَجَّ مَعَهُ  مُعَاوِيَةُ بْنُ حُدَيْجٍ  وَكَانَ مِنْ أَسَبِّ النَّاسِ  لِعَلِيٍّ  ، قَالَ : فَمَرَّ فِي  الْمَدِينَةِ  ، وَحَسَنُ بْنُ عَلِيٍّ وَنَفَرٌ مِنْ أَصْحَابِهِ جَالِسٌ ، فَقِيلَ لَهُ : هَذَا  مُعَاوِيَةُ بْنُ حُدَيْجٍ  السَّابُّ  لِعَلِيٍّ  ، قَالَ : عَلَيَّ الرَّجُلَ قَالَ : فَأَتَاهُ رَسُولٌ ، فَقَالَ : أَجِبْهُ ، قَالَ : مَنْ ؟ قَالَ :  الْحَسَنُ بْنُ عَلِيٍّ  يَدْعُوكَ ، فَأَتَاهُ فَسَلَّمَ عَلَيْهِ ، فَقَالَ لَهُ  الْحَسَنُ  : أَنْتَ  مُعَاوِيَةُ بْنُ حُدَيْجٍ  ؟ قَالَ : نَعَمْ ، قَالَ : فَرَدَّ ذَلِكَ عَلَيْهِ ، قَالَ : فَأَنْتَ السَّابُّ  لِعَلِيٍّ  ؟ قَالَ : فَكَأَنَّهُ اسْتَحْيَا ، فَقَالَ لَهُ  الْحَسَنُ  :  أَمَا وَاللهِ لَئِنْ وَرَدْتَ عَلَيْهِ الْحَوْضَ ، وَمَا أُرَاكَ تَرِدُهُ ،         [12/141]      لَتَجِدَنَّهُ مُشَمِّرًا الْإِزَارَ عَلَى سَاقٍ يَذُودُ عَنْهُ رَايَاتِ الْمُنَافِقِينَ  ذَوْدَ  غَرِيبَةِ  الْإِبِلِ ، قَوْلَ الصَّادِقِ الْمَصْدُوقِ ،         {      وَقَدْ خَابَ مَنِ افْتَرَى         }      .","","Musnad Abi Ya'la al-Mawsili 6771","","الحسن بن علي سبط رسول الله عن علي بن أبي طلحة العباسي عن الوليد بن يسار الهمداني عن سعيد بن خثيم الهلالي عن إسماعيل بن موسى الفزاري عن أبو يعلى الموصلي","مسند الحسن بن علي بن أبي طالب"
"6776","[12/142]      مُسْنَدُ  الْحُسَيْنِ بْنِ عَلِيِّ بْنِ أَبِي طَالِبٍ  1 - (  6772  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ عُمَرَ بْنِ شَقِيقٍ الْجَرْمِيُّ ،  حَدَّثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ ،  عَنِ  النَّضْرِ بْنِ حُمَيْدٍ الْكِنْدِيِّ ،  عَنْ         [12/143]      سَعْدٍ الْإِسْكَافِ ،  عَنْ  أَبِي جَعْفَرٍ مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ :  أَتَى  جِبْرِيلُ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  يَا  مُحَمَّدُ  ، إِنَّ اللهَ يُحِبُّ مِنْ أَصْحَابِكَ ثَلَاثَةً فَأَحِبَّهُمْ  :  عَلِيُّ بْنُ أَبِي طَالِبٍ  ،  وَأَبُو ذَرٍّ  ،  وَالْمِقْدَادُ بْنُ الْأَسْوَدِ  ، قَالَ : فَأَتَاهُ  جِبْرِيلُ  فَقَالَ لَهُ : يَا  مُحَمَّدُ  ، إِنَّ الْجَنَّةَ لَتَشْتَاقُ إِلَى ثَلَاثَةٍ مِنْ أَصْحَابِكَ ، وَعِنْدَهُ  أَنَسُ بْنُ مَالِكٍ  ، فَرَجَا أَنْ يَكُونَ لِبَعْضِ  الْأَنْصَارِ  ، قَالَ : فَأَرَادَ أَنْ يَسْأَلَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْهُمْ ، فَهَابَهُ ، فَخَرَجَ فَلَقِيَ  أَبَا بَكْرٍ  ، فَقَالَ : يَا  أَبَا بَكْرٍ  إِنِّي كُنْتُ عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - آنِفًا ، فَأَتَاهُ  جِبْرِيلُ  ، فَقَالَ : إِنَّ الْجَنَّةَ تَشْتَاقُ إِلَى ثَلَاثَةٍ مِنْ أَصْحَابِكَ ، فَرَجَوْتُ أَنْ يَكُونَ لِبَعْضِ  الْأَنْصَارِ  ، فَهِبْتُهُ أَنْ أَسْأَلَهُ ، فَهَلْ لَكَ أَنْ تَدْخُلَ عَلَى نَبِيِّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَتَسْأَلَهُ ؟ فَقَالَ : إِنِّي أَخَافُ أَنْ أَسْأَلَهُ ، فَلَا أَكُونُ مِنْهُمْ ، وَيَشْمَتُ بِي قَوْمِي ، ثُمَّ لَقِيَنِي  عُمَرُ بْنُ الْخَطَّابِ  ، فَقَالَ لَهُ مِثْلَ قَوْلِ  أَبِي بَكْرٍ  ، قَالَ : فَلَقِيَ  عَلِيًّا  ، فَقَالَ لَهُ  عَلِيٌّ  : نَعَمْ ، إِنْ كُنْتُ مِنْهُمْ فَأَحْمَدُ اللهَ ، وَإِنْ لَمْ أَكُنْ مِنْهُمْ فَحَمِدْتُ اللهَ ، فَدَخَلَ عَلَى نَبِيِّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : إِنَّ  أَنَسًا  حَدَّثَنِي أَنَّهُ كَانَ عِنْدَكَ آنِفًا ، وَإِنَّ  جِبْرِيلَ  أَتَاكَ ، فَقَالَ : يَا  مُحَمَّدُ  ، إِنَّ الْجَنَّةَ لَتَشْتَاقُ إِلَى ثَلَاثَةٍ مِنْ أَصْحَابِكَ ، قَالَ : فَمَنْ هُمْ يَا نَبِيَّ اللهِ ؟ قَالَ : أَنْتَ مِنْهُمْ يَا  عَلِيُّ  ،  وَعَمَّارُ بْنُ يَاسِرٍ  ، وَسَيَشْهَدُ مَعَكَ مَشَاهِدَ بَيِّنٌ فَضْلُهَا ،         [12/144]      عَظِيمٌ خَيْرُهَا ،  وَسَلْمَانُ  وَهُوَ مِنَّا  أَهْلَ الْبَيْتِ  ، وَهُوَ نَاصِحٌ ، فَاتَّخِذْهُ لِنَفْسِكَ  .","","Musnad Abi Ya'la al-Mawsili 6772","","الحسين بن علي عن علي بن الحسين زين العابدين عن أبو جعفر الباقر عن سعد بن طريف الإسكاف عن النضر بن حميد عن جعفر بن سليمان الضبعي عن الحسن بن عمر بن شقيق الجرمي عن أبو يعلى الموصلي","مسند الحسين بن علي بن أبي طالب"
"6777","2 - (  6773  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  حَدَّثَنَا  سُفْيَانُ قَالَ :  قُلْتُ  لِعُبَيْدِ اللهِ بْنِ أَبِي يَزِيدَ :  رَأَيْتَ حُسَيْنَ بْنَ عَلِيٍّ ؟ قَالَ : أَسْوَدَ الرَّأْسِ وَاللِّحْيَةِ إِلَّا شُعَيْرَاتٍ هَاهُنَا فِي مُقَدَّمِ لِحْيَتِهِ  ، فَلَا أَدْرِي أَخَضَبَ وَتَرَكَ ذَلِكَ الْمَكَانَ تَشَبُّهًا بِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَوْ لَمْ يَكُنْ شَابَ مِنْهُ غَيْرُ ذَلِكَ .  قَالَ : وَرَأَيْتُ  حَسَنًا  وَقَدْ أُقِيمَتِ الصَّلَاةُ سَجَدَ بَيْنَ الْإِمَامِ وَبَيْنَ بَعْضِ النَّاسِ ، فَقِيلَ لَهُ : اجْلِسْ ، فَقَالَ : قَدْ قَامَتِ الصَّلَاةُ .         [12/145]","","Musnad Abi Ya'la al-Mawsili 6773","","الحسين بن علي عن عبيد الله بن أبي يزيد الكناني عن سفيان بن عيينة عن إبراهيم بن سعيد الجوهري عن أبو يعلى الموصلي","مسند الحسين بن علي بن أبي طالب"
"6778","3 - (  6774  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  حَدَّثَنَا  فَرَجُ بْنُ فَضَالَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ عَمْرِو بْنِ عُثْمَانَ ،  عَنْ  أُمِّهِ فَاطِمَةَ بِنْتِ الْحُسَيْنِ ،  عَنْ  أَبِيهَا حُسَيْنِ بْنِ عَلِيٍّ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تُدِيمُوا النَّظَرَ إِلَى الْمُجَذَّمِينَ  ، وَإِذَا كَلَّمْتُمُوهُمْ فَلْيَكُنْ بَيْنَكُمْ وَبَيْنَهُمْ  قِيدُ  رُمْحٍ  .         [12/146]","","Musnad Abi Ya'la al-Mawsili 6774","","الحسين بن علي عن فاطمة بنت الحسين بن علي بن أبي طالب عن الديباج ، محمد بن عبد الله بن عمرو عن عبد الله بن عامر الأسلمي عن فرج بن فضالة بن النعمان التنوخي عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند الحسين بن علي بن أبي طالب"
"6779","4 - (  6775  ) -  حَدَّثَنَا  يَعْقُوبُ بْنُ عِيسَى جَارُ  أَحْمَدَ بْنِ حَنْبَلٍ  ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ الْمُطَّلِبِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ عَبْدِ اللهِ ،  عَنْ  زَيْدِ بْنِ عَلِيِّ بْنِ حُسَيْنٍ ،  عَنْ  أَبِي ،  عَنْ  جَدِّهِ  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ قُتِلَ دُونَ حَقِّهِ فَهُوَ  شَهِيدٌ  .         [12/147]","","Musnad Abi Ya'la al-Mawsili 6775","","الحسين بن علي عن علي بن الحسين زين العابدين عن زيد بن علي بن الحسين عن عبد الرحمن بن الحارث المخزومي عن عبد العزيز بن المطلب بن عبد الله بن حنطب المخزومي عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن عيسى المؤدب عن أبو يعلى الموصلي","مسند الحسين بن علي بن أبي طالب"
"6780","5 - (  6776  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  خَالِدُ بْنُ مَخْلَدٍ ،  حَدَّثَنَا  سُلَيْمَانُ بْنُ بِلَالٍ قَالَ :  حَدَّثَنِي  عُمَارَةُ بْنُ غَزِيَّةَ الْأَنْصَارِيُّ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَلِيِّ بْنِ حُسَيْنٍ  يُحَدِّثُ عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الْبَخِيلَ مَنْ ذُكِرْتُ عِنْدَهُ فَلَمْ يُصَلِّ عَلَيَّ  .         [12/148]","","Musnad Abi Ya'la al-Mawsili 6776","","الحسين بن علي عن علي بن الحسين زين العابدين عن عبد الله بن علي بن الحسين بن علي بن أبي طالب عن عمارة بن غزية عن سليمان بن بلال القرشي عن خالد بن مخلد القطواني عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند الحسين بن علي بن أبي طالب"
"6781","6 - (  6777  ) -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلَّامٍ الْجُمَحِيُّ ،  حَدَّثَنَا  هِشَامُ بْنُ زِيَادٍ ،  عَنْ  أُمِّهِ  ،  عَنْ  فَاطِمَةَ بِنْتِ الْحُسَيْنِ ، أَنَّهَا  سَمِعَتْ  أَبَاهَا الْحُسَيْنَ بْنَ عَلِيٍّ  يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا مِنْ مُسْلِمٍ وَلَا مُسْلِمَةٍ تُصِيبُهُ مُصِيبَةٌ  ، وَإِنْ  قَدُمَ         [12/149]      عَهْدُهَا ، فَيُحْدِثُ لَهَا اسْتِرْجَاعًا إِلَّا أَحْدَثَ اللهُ لَهُ عِنْدَ ذَلِكَ وَأَعْطَاهُ ثَوَابَ مَا وَعَدَهُ عَلَيْهَا يَوْمَ أُصِيبَ بِهَا  .         [12/150]","","Musnad Abi Ya'la al-Mawsili 6777","","الحسين بن علي عن فاطمة بنت الحسين بن علي بن أبي طالب عن أم هشام بن أبي الوليد عن هشام بن زياد بن أبي يزيد العثماني عن عبد الرحمن بن سلام الطرسوسي عن أبو يعلى الموصلي","مسند الحسين بن علي بن أبي طالب"
"6782","7 - (  6778  ) -  حَدَّثَنَا  حَوْثَرَةُ ،  حَدَّثَنَا  هِشَامٌ أَبُو الْمِقْدَامِ ،  بِإِسْنَادِهِ  نَحْوَهُ .","","Musnad Abi Ya'la al-Mawsili 6778","","الحسين بن علي عن فاطمة بنت الحسين بن علي بن أبي طالب عن أم هشام بن أبي الوليد عن هشام بن زياد بن أبي يزيد العثماني عن حوثرة بن أشرس بن عومر العدوي عن أبو يعلى الموصلي","مسند الحسين بن علي بن أبي طالب"
"6783","8 - (  6779  ) -  حَدَّثَنَا  جُبَارَةُ ،  حَدَّثَنَا  يَحْيَى بْنُ الْعَلَاءِ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  طَلْحَةَ بْنِ عُبَيْدِ اللهِ الْعُقَيْلِيِّ ،  عَنِ  الْحُسَيْنِ بْنِ عَلِيٍّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ فِي الْجُمُعَةِ لَسَاعَةً لَا يَحْتَجِمُ فِيهَا أَحَدٌ إِلَّا مَاتَ  .","","Musnad Abi Ya'la al-Mawsili 6779","","الحسين بن علي عن طلحة بن عبيد الله العقيلي عن زيد بن أسلم عن يحيى بن العلاء الفوراردي عن جبارة بن المغلس عن أبو يعلى الموصلي","مسند الحسين بن علي بن أبي طالب"
"6784","9 - (  6780  ) -  حَدَّثَنَا  جُبَارَةُ ،  حَدَّثَنَا  يَحْيَى بْنُ الْعَلَاءِ ،  عَنْ  مَرْوَانَ بْنِ سَالِمٍ ،  عَنْ  طَلْحَةَ بْنِ عُبَيْدِ اللهِ ،  عَنْ  حُسَيْنٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ وُلِدَ لَهُ فَأَذَّنَ فِي أُذُنِهِ الْيُمْنَى وَأَقَامَ فِي أُذُنِهِ الْيُسْرَى ، لَمْ تَضُرَّهُ  أُمُّ  الصِّبْيَانِ  .         [12/151]             [12/152]","","Musnad Abi Ya'la al-Mawsili 6780","","الحسين بن علي عن طلحة بن عبيد الله العقيلي عن مروان بن سالم الغفاري عن يحيى بن العلاء الفوراردي عن جبارة بن المغلس عن أبو يعلى الموصلي","مسند الحسين بن علي بن أبي طالب"
"6785","10 - (  6781  ) -  حَدَّثَنَا  جُبَارَةُ ،  حَدَّثَنَا  يَحْيَى بْنُ الْعَلَاءِ ،  عَنْ  مَرْوَانَ بْنِ سَالِمٍ ،  عَنْ  طَلْحَةَ بْنِ عُبَيْدِ اللهِ ،  عَنِ  الْحُسَيْنِ بْنِ عَلِيٍّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَمَانُ أُمَّتِي مِنَ الْغَرَقِ إِذَا رَكِبُوا أَنْ يَقُولُوا :         {      بِسْمِ اللهِ مَجْرَاهَا وَمُرْسَاهَا إِنَّ رَبِّي لَغَفُورٌ رَحِيمٌ         }             {      وَمَا قَدَرُوا اللهَ حَقَّ قَدْرِهِ         }      الْآيَةَ  .         [12/153]","","Musnad Abi Ya'la al-Mawsili 6781","","الحسين بن علي عن طلحة بن عبيد الله العقيلي عن مروان بن سالم الغفاري عن يحيى بن العلاء الفوراردي عن جبارة بن المغلس عن أبو يعلى الموصلي","مسند الحسين بن علي بن أبي طالب"
"6786","11 - (  6782  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَالِمٍ ،  حَدَّثَنَا  حُسَيْنُ بْنُ زَيْدٍ ،  عَنِ  الْحَسَنِ بْنِ زَيْدٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْحُسَيْنِ بْنِ عَلِيٍّ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَتَوَضَّأُ فَغَسَلَ مَوْضِعَ سُجُودِهِ بِالْمَاءِ حَتَّى يُسِيلَهُ عَلَى مَوْضِعِ السُّجُودِ  .","","Musnad Abi Ya'la al-Mawsili 6782","","الحسين بن علي عن زيد بن الحسن بن علي بن أبي طالب عن الحسن بن زيد بن الحسن بن علي بن أبي طالب عن الحسين بن زيد بن علي بن الحسين بن علي بن أبي طالب عن عبد الله بن سالم المفلوج عن أبو يعلى الموصلي","مسند الحسين بن علي بن أبي طالب"
"6787","12 - (  6783  ) -  حَدَّثَنَا  كَامِلُ بْنُ طَلْحَةَ ،  حَدَّثَنَا  أَبُو هِشَامٍ الْقَنَّادُ ،  عَنِ  الْحُسَيْنِ بْنِ عَلِيٍّ ،  يَرْفَعُهُ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْمَغْبُونُ لَا مَحْمُودٌ وَلَا مَأْجُورٌ  .         [12/154]","","Musnad Abi Ya'la al-Mawsili 6783","","الحسين بن علي عن أبو هشام القناد عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند الحسين بن علي بن أبي طالب"
"6788","13 - (  6784  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  مُصْعَبِ بْنِ مُحَمَّدٍ ،  عَنْ  يَعْلَى بْنِ أَبِي يَحْيَى ،  عَنْ  فَاطِمَةَ بِنْتِ حُسَيْنٍ ،  عَنْ  أَبِيهَا  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لِلسَّائِلِ  حَقٌّ ، وَإِنْ جَاءَ عَلَى فَرَسٍ  .","","Musnad Abi Ya'la al-Mawsili 6784","","الحسين بن علي عن فاطمة بنت الحسين بن علي بن أبي طالب عن يعلى بن أبي يحيى المدني عن مصعب بن محمد بن عبد الرحمن العبدري عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند الحسين بن علي بن أبي طالب"
"6789","14 - (  6785  ) -  حَدَّثَنَا  مَنْصُورُ بْنُ أَبِي مُزَاحِمٍ ،  حَدَّثَنَا  عُمَرُ         [12/155]      بْنُ شَبِيبٍ ،  عَنْ  يُوسُفَ الصَّبَّاغِ ،  عَنِ  الْحُسَيْنِ ، وَلَا أَعْلَمُهُ إِلَّا عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ شَهِدَ أَمْرًا فَكَرِهَهُ ، كَانَ كَمَنْ غَابَ عَنْهُ  ، وَمَنْ غَابَ عَنْ أَمْرٍ فَرَضِيَ بِهِ ، كَانَ كَمَنْ شَهِدَهُ  .         [12/156]","","Musnad Abi Ya'la al-Mawsili 6785","","الحسين بن علي عن يوسف بن ميمون الصباغ عن عمر بن شبيب بن عمر المذحجي عن منصور بن أبي مزاحم عن أبو يعلى الموصلي","مسند الحسين بن علي بن أبي طالب"
"6790","15 - (  6786  ) -  حَدَّثَنَا  خَلَفُ بْنُ هِشَامٍ ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  بُرَيْدِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  أَبِي الْحَوْرَاءِ قَالَ :  قَالَ  الْحُسَيْنُ بْنُ عَلِيٍّ :  عَلَّمَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَلِمَاتٍ أَقُولُهُنَّ فِي  قُنُوتِ  الْوِتْرِ  : رَبِّ اهْدِنِي فِيمَنْ هَدَيْتَ  ، وَعَافِنِي فِيمَنْ عَافَيْتَ ، وَتَوَلَّنِي فِيمَنْ تَوَلَّيْتَ ، وَبَارِكْ لِي فِيمَا أَعْطَيْتَ ، وَقِنِي شَرَّ مَا قَضَيْتَ ، فَإِنَّكَ تَقْضِي وَلَا يُقْضَى عَلَيْكَ ، وَإِنَّكَ لَا تُذِلُّ مَنْ وَالَيْتَ ، تَبَارَكْتَ رَبَّنَا وَتَعَالَيْتَ  .","","Musnad Abi Ya'la al-Mawsili 6786","","الحسين بن علي عن ربيعة بن شيبان السعدي عن بريد بن أبي مريم السلولي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن خلف بن هشام البزار عن أبو يعلى الموصلي","مسند الحسين بن علي بن أبي طالب"
"6791","[12/157]      مُسْنَدُ  عَبْدِ اللهِ بْنِ جَعْفَرٍ الْهَاشِمِيِّ  1 - (  6787  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ ،  حَدَّثَنَا         [12/158]      مَهْدِيُّ بْنُ مَيْمُونٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ أَبِي يَعْقُوبَ ،  عَنِ  الْحَسَنِ بْنِ سَعْدٍ مَوْلَى الْحَسَنِ بْنِ عَلِيٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ قَالَ :  أَرْدَفَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ يَوْمٍ خَلْفَهُ ، فَأَسَرَّ إِلَيَّ حَدِيثًا لَا أُحَدِّثُ بِهِ أَحَدًا مِنَ النَّاسِ ، وَكَانَ أَحَبَّ مَا اسْتَتَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِحَاجَتِهِ هَدَفٌ ، أَوْ  حَائِشُ  نَخْلٍ ،  يَعْنِي : حَائِطًا  ، فَدَخَلَ حَائِطًا  لِرَجُلٍ مِنَ الْأَنْصَارِ  فَإِذَا فِيهِ جَمَلٌ ، فَلَمَّا رَأَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَزِعَ  وَذَرَفَتْ  عَيْنَاهُ ، قَالَ : فَأَتَاهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَمَسَحَ رَأْسَهُ إِلَى سَنَامِهِ  وَذِفْرَاهُ  ، فَسَكَنَ ، فَقَالَ : مَنْ رَبُّ هَذَا الْجَمَلِ ، لِمَنْ هَذَا الْجَمَلُ ؟ فَجَاءَ  فَتًى مِنَ         [12/159]      الْأَنْصَارِ  ، فَقَالَ : هُوَ لِي يَا رَسُولَ اللهِ ، قَالَ :  أَفَلَا تَتَّقِي اللهَ فِي هَذِهِ الْبَهِيمَةِ ؟ مَلَّكَكَ اللهُ إِيَّاهَا ، فَإِنَّهُ شَكَا إِلَيَّ أَنَّكَ تُجِيعُهُ  وَتُدْئِبُهُ  .","","Musnad Abi Ya'la al-Mawsili 6787","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن الحسن بن سعد مولى علي بن أبي طالب عن محمد بن عبد الله بن أبي يعقوب عن مهدي بن ميمون المعولي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عبد الله بن جعفر الهاشمي"
"6792","[12/160]      2 - (  6788  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  مَهْدِيٌّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ أَبِي يَعْقُوبَ ،  عَنِ  الْحَسَنِ بْنِ سَعْدٍ مَوْلَى الْحَسَنِ بْنِ عَلِيٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ قَالَ :  أَرْدَفَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ يَوْمٍ خَلْفَهُ ، فَأَسَرَّ إِلَيَّ حَدِيثًا  لَا أُحَدِّثُ بِهِ أَحَدًا مِنَ النَّاسِ ، قَالَ : وَكَانَ أَحَبَّ مَا اسْتَتَرَ بِهِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِحَاجَةٍ هَدَفٌ أَوْ  حَائِشٌ  ، فَذَكَرَ نَحْوَ حَدِيثِ  عَبْدِ اللهِ بْنِ مُحَمَّدٍ  .","","Musnad Abi Ya'la al-Mawsili 6788","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن الحسن بن سعد مولى علي بن أبي طالب عن محمد بن عبد الله بن أبي يعقوب عن مهدي بن ميمون المعولي عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عبد الله بن جعفر الهاشمي"
"6793","3 - (  6789  ) -  حَدَّثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ الزُّبَيْرِيُّ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  إِسْمَاعِيلَ بْنِ عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعَلَيْهِ ثَوْبَانِ مَصْبُوغَانِ بِالزَّعْفَرَانِ  : رِدَاءٌ ، وَعِمَامَةٌ  .         [12/161]             [12/162]","","Musnad Abi Ya'la al-Mawsili 6789","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن إسماعيل بن عبد الله بن جعفر بن أبي طالب الهاشمي عن عبد الله بن مصعب بن ثابت الزبيري عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","مسند عبد الله بن جعفر الهاشمي"
"6794","4 - (  6790  ) -  حَدَّثَنَا  مُصْعَبٌ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي حَازِمٍ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ الْهَادِ ،  عَنْ  مُعَاوِيَةَ بْنِ عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَرَّ بِأُنَاسٍ يَرْمُونَ كَبْشًا بِالنَّبْلِ فَكَرِهَ ذَلِكَ ، فَقَالَ :  لَا تُمَثِّلُوا بِالْبَهَائِمِ  .         [12/163]","","Musnad Abi Ya'la al-Mawsili 6790","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن معاوية بن عبد الله بن جعفر بن أبي طالب عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن عبد العزيز بن أبي حازم المخزومي عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","مسند عبد الله بن جعفر الهاشمي"
"6795","5 - (  6791  ) -  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ ،  حَدَّثَنَا  شُعْبَةُ ،  حَدَّثَنَا  عَاصِمٌ الْأَحْوَلُ قَالَ :  سَمِعْتُ  مُوَرِّقًا ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَدِمَ مِنْ سَفَرٍ ، فَاسْتَقْبَلْتُهُ أَنَا وَغُلَامٌ مِنْ  بَنِي هَاشِمٍ  فَحَمَلَنَا  .","","Musnad Abi Ya'la al-Mawsili 6791","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن مورق العجلي عن عاصم بن سليمان الأحول عن شعبة بن الحجاج عن عبد الصمد بن عبد الوارث التنوري عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند عبد الله بن جعفر الهاشمي"
"6796","6 - (  6792  ) -  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ قَالَ :  حَدَّثَنِي  عَبْدُ اللهِ بْنُ مُسَافِعٍ ، أَنَّ         [12/164]      مُصْعَبَ بْنَ شَيْبَةَ  أَخْبَرَهُ  ،  عَنْ  عُقْبَةَ بْنِ مُحَمَّدِ بْنِ الْحَارِثِ ،         [12/165]      عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ شَكَّ فِي صَلَاةٍ ، فَلْيَسْجُدْ سَجْدَتَيْنِ وَهُوَ جَالِسٌ  .         [12/166]             [12/167]","","Musnad Abi Ya'la al-Mawsili 6792","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عتبة ، ويقال عن مصعب بن شيبة بن جبير الحجبي عن عبد الله بن مسافع الحجبي عن ابن جريج عن روح بن عبادة القيسي عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند عبد الله بن جعفر الهاشمي"
"6797","7 - (  6793  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ ،  حَدَّثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي حَكِيمٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَقُولَنَّ أَحَدٌ إِنِّي خَيْرٌ مِنْ  يُونُسَ بْنِ مَتَّى  .","","Musnad Abi Ya'la al-Mawsili 6793","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن القاسم بن محمد بن أبي بكر الصديق عن إسماعيل بن أبي حكيم القرشي عن محمد بن إسحاق عن يونس بن بكير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن جعفر الهاشمي"
"6798","8 - (  6794  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ ،  حَدَّثَنَا  أَبِي  ،  عَنْ         [12/168]      إِبْرَاهِيمَ بْنِ الْفَضْلِ قَالَ :  حَدَّثَنِي  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَتَخَتَّمُ فِي يَمِينِهِ  .         [12/169]","","Musnad Abi Ya'la al-Mawsili 6794","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عبد الله بن محمد بن عقيل بن أبي طالب عن إبراهيم بن الفضل المخزومي عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن جعفر الهاشمي"
"6799","9 - (  6795  ) -  حَدَّثَنَا  الْقَاسِمُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَشَّرَ  خَدِيجَةَ  بِبَيْتٍ  فِي الْجَنَّةِ مِنْ  قَصَبٍ  .         [12/170]","","Musnad Abi Ya'la al-Mawsili 6795","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن إسحاق عن جرير بن حازم عن وهب بن جرير بن حازم عن قاسم بن محمد بن أبي شيبة العبسي عن أبو يعلى الموصلي","مسند عبد الله بن جعفر الهاشمي"
"6800","10 - (  6796  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ ،  حَدَّثَنَا  الْحَارِثُ بْنُ النُّعْمَانِ ،  حَدَّثَنَا  شَيْبَانُ ،  عَنْ  جَابِرٍ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ قَالَ :  احْتَجَمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى قَرْنِهِ بَعْدَمَا سُمَّ  .","","Musnad Abi Ya'la al-Mawsili 6796","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن أبو جعفر الباقر عن جابر الجعفي عن شيبان بن عبد الرحمن المؤدب عن الحارث بن النعمان بن سالم الأكفاني عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن جعفر الهاشمي"
"6801","11 - (  6797  ) -  حَدَّثَنَا  خَلِيفَةُ بْنُ خَيَّاطٍ ،  حَدَّثَنَا  بَكْرُ بْنُ سُلَيْمَانَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ قَالَ :  حَدَّثَنِي  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ قَالَ :  بَشَّرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [12/171]      خَدِيجَةَ  بِبَيْتٍ  فِي الْجَنَّةِ  مِنْ  قَصَبٍ ،  لَا  صَخَبَ  فِيهِ وَلَا  نَصَبَ  .","","Musnad Abi Ya'la al-Mawsili 6797","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن إسحاق عن بكر بن سليمان الأسواري عن خليفة بن خياط عن أبو يعلى الموصلي","مسند عبد الله بن جعفر الهاشمي"
"6802","12 - (  6798  ) -  حَدَّثَنَا  مُحْرِزُ بْنُ عَوْنِ بْنِ أَبِي عَوْنٍ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ قَالَ :  رَأَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْكُلُ الْقِثَّاءَ بِالرُّطَبِ  .         [12/172]","","Musnad Abi Ya'la al-Mawsili 6798","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعد أبو إسحاق الزهري عن محرز بن عون الهلالي عن أبو يعلى الموصلي","مسند عبد الله بن جعفر الهاشمي"
"6803","13 - (  6799  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ الْفَضْلِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،         [12/173]      عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ قَالَ :  رَأَيْتُ خَاتَمَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي يَمِينِهِ  .","","Musnad Abi Ya'la al-Mawsili 6799","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عبد الله بن محمد بن عقيل بن أبي طالب عن إبراهيم بن الفضل المخزومي عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن جعفر الهاشمي"
"6804","14 - (  6800  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي سَمِينَةَ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مُسَافِعٍ ،  عَنْ  مُصْعَبِ بْنِ شَيْبَةَ ،  عَنْ  عُقْبَةَ بْنِ مُحَمَّدِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا شَكَّ أَحَدُكُمْ فِي صَلَاتِهِ فَلَمْ يَدْرِ كَمْ صَلَّى ، فَلْيَسْجُدْ سَجْدَتَيْنِ إِذَا فَرَغَ مِنْ صَلَاتِهِ  .","","Musnad Abi Ya'la al-Mawsili 6800","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عتبة ، ويقال عن مصعب بن شيبة بن جبير الحجبي عن عبد الله بن مسافع الحجبي عن ابن جريج عن روح بن عبادة القيسي عن محمد بن إسماعيل بن أبي سمينة عن أبو يعلى الموصلي","مسند عبد الله بن جعفر الهاشمي"
"6805","15 - (  6801  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  حَدَّثَنَا  أَبُو إِسْحَاقَ الْفَزَارِيُّ ،  عَنْ  سُفْيَانَ بْنِ عُيَيْنَةَ ،  عَنْ  جَعْفَرِ بْنِ خَالِدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ قَالَ :  لَمَّا نُعِيَ  جَعْفَرٌ  قَالَ رَسُولُ اللهِ         [12/174]      - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اصْنَعُوا  لِآلِ جَعْفَرٍ  طَعَامًا ، فَقَدْ أَتَاهُمْ أَمْرٌ يَشْغَلُهُمْ أَوْ يُشْغَلُونَ بِهِ  .         [12/175]","","Musnad Abi Ya'la al-Mawsili 6801","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن خالد بن سارة المخزومي عن جعفر بن خالد بن سارة المخزومي عن سفيان بن عيينة عن أبو إسحاق الفزاري عن معاوية بن عمرو بن المهلب الأزدي عن مجاهد بن موسى عن أبو يعلى الموصلي","مسند عبد الله بن جعفر الهاشمي"
"6806","16 - (  6802  ) -  حَدَّثَنَا  أَبُو سَلَمَةَ بْنُ السَّبَّاكِ ،  حَدَّثَنَا  مَخْلَدٌ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مُسَافِعٍ ،  عَنْ  عُقْبَةَ بْنِ مُحَمَّدِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ شَكَّ فِي صَلَاتِهِ فَلْيَسْجُدْ سَجْدَتَيْنِ بَعْدَمَا يُسَلِّمُ  .","","Musnad Abi Ya'la al-Mawsili 6802","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عتبة ، ويقال عن عبد الله بن مسافع الحجبي عن ابن جريج عن مخلد بن يزيد الحراني عن جعفر بن مهران السباك عن أبو يعلى الموصلي","مسند عبد الله بن جعفر الهاشمي"
"6807","17 - (  6803  ) -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ سَيْفٍ الْبَصْرِيُّ  ،  حَدَّثَنَا  عُمَرُ بْنُ هَارُونَ الْبَلْخِيُّ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ جَعْفَرٍ ،         [12/176]      عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا رَأَيْتُمْ مَنْ يَزْهَدُ فِي الدُّنْيَا ، فَادْنُوا مِنْهُ ، فَإِنَّهُ يُلَقَّى الْحِكْمَةَ  .  في طبعة دار المأمون للتراث : (يوسف) والمثبت من نسخة السليمانية","","Musnad Abi Ya'la al-Mawsili 6803","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن عبد الله بن عبد الله بن جعفر عن سفيان الثوري عن عمر بن هارون البلخي عن إسماعيل بن سيف القطعي عن أبو يعلى الموصلي","مسند عبد الله بن جعفر الهاشمي"
"6808","18 - (  6804  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  حَدَّثَنَا  طَلْحَةُ بْنُ يَحْيَى ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  حَدَّثَنَا  عَقِيلُ بْنُ أَبِي طَالِبٍ قَالَ :  جَاءَتْ  قُرَيْشٌ  إِلَى  أَبِي طَالِبٍ  ، فَقَالُوا : إِنَّ ابْنَ أَخِيكَ يُؤْذِينَا فِي نَادِينَا ، وَفِي مَسْجِدِنَا ، فَانْهَهُ عَنْ أَذَانَا ، فَقَالَ : يَا  عَقِيلُ  : ائْتِنِي  بِمُحَمَّدٍ  ، فَذَهَبْتُ فَأَتَيْتُهُ بِهِ ، فَقَالَ : يَا ابْنَ أَخِي ، إِنَّ بَنِي عَمِّكَ يَزْعُمُونَ أَنَّكَ تُؤْذِيهِمْ فِي نَادِيهِمْ ، وَفِي مَسْجِدِهِمْ ، فَانْتَهِ عَنْ ذَلِكَ .  قَالَ :  فَحَلَّقَ  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَصَرَهُ إِلَى السَّمَاءِ ، فَقَالَ :  أَتَرَوْنَ هَذِهِ الشَّمْسَ ؟ قَالُوا : نَعَمْ ، قَالَ : مَا أَنَا بِأَقْدَرَ عَلَى أَنْ أَدَعَ لَكُمْ ذَلِكَ عَلَى أَنْ تَسْتَشْعِلُوا لِي مِنْهَا شُعْلَةً  ، قَالَ : فَقَالَ  أَبُو طَالِبٍ  : مَا كَذَبَنَا ابْنُ أَخِي ، فَارْجِعُوا  .","","Musnad Abi Ya'la al-Mawsili 6804","","عقيل بن أبي طالب ابن عم رسول الله عن موسى بن طلحة بن عبيد الله التيمي عن طلحة بن يحيى بن طلحة التيمي عن يونس بن بكير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن جعفر الهاشمي"
"6809","[12/177]      مُسْنَدُ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  رَحِمَهُ اللهُ  1 - (  6805  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  مَعْمَرٌ ،  عَنْ         [12/178]      حَجَّاجٍ ،  عَنِ  الْفُرَاتِ أَبِي عَبْدِ اللهِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ  قَالَ  :  كُنْتُ جَالِسًا عِنْدَ  عَبْدِ اللهِ بْنِ عُتْبَةَ بْنِ مَسْعُودٍ  ، وَكَانَ ابْنُ الزُّبَيْرِ جَعَلَهُ عَلَى قَضَاءِ  الْكُوفَةِ  ، إِذْ جَاءَهُ كِتَابُ  ابْنِ الزُّبَيْرِ  : سَلَامٌ عَلَيْكَ ، أَمَّا بَعْدُ فَإِنَّكَ كُنْتَ تَسْأَلُنِي عَنِ الْجَدِّ ، وَإِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : لَوْ كُنْتُ مُتَّخِذًا مِنْ هَذِهِ الْأُمَّةِ  خَلِيلًا  مِنْ دُونِ رَبِّي ، لَاتَّخَذْتُ  ابْنَ أَبِي قُحَافَةَ  ، وَلَكِنَّهُ أَخِي فِي الدِّينِ ، وَصَاحِبِي فِي الْغَارِ .  وَجَعَلَ الْجَدَّ أَبًا  ، فَأَحَقُّ مَنْ أَخَذْنَا بِهِ قَوْلُ أَبِي بَكْرٍ .         [12/179]","","Musnad Abi Ya'la al-Mawsili 6805","","أبو  بكر الصديق عن عبد الله بن الزبير عن سعيد بن جبير الأسدي عن فرات بن أبي عبد الرحمن القزاز عن حجاج بن أرطاة عن معمر بن راشد عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","مسند عبد الله بن الزبير رحمه الله"
"6810","2 - (  6806  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَدْعُو هَكَذَا ، وَأَشَارَ  بِالسَّبَّاحَةِ  .","","Musnad Abi Ya'la al-Mawsili 6806","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن محمد بن عجلان عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن الزبير رحمه الله"
"6811","3 - (  6807  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنِ  ابْنِ عَجْلَانَ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،         [12/180]      عَنْ  أَبِيهِ  قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا قَعَدَ فِي  التَّشَهُّدِ  قَالَ  هَكَذَا ، وَوَضَعَ يَحْيَى يَدَهُ الْيُمْنَى عَلَى فَخِذِهِ الْيُمْنَى ، وَالْيُسْرَى عَلَى فَخِذِهِ الْيُسْرَى ، وَأَشَارَ  بِالسَّبَّاحَةِ  ، وَلَمْ يُجَاوِزْ بَصَرُهُ إِشَارَتَهُ  .         [12/181]","","Musnad Abi Ya'la al-Mawsili 6807","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن محمد بن عجلان عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن الزبير رحمه الله"
"6812","4 - (  6808  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ  عَنْ  حَبِيبِ بْنِ الشَّهِيدِ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي مُلَيْكَةَ قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ جَعْفَرٍ  لِابْنِ الزُّبَيْرِ  - أَوِ ابْنُ الزُّبَيْرِ  لِابْنِ جَعْفَرٍ  - :  أَتَذْكُرُ يَوْمَ تَلَقَّيْنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَا وَأَنْتَ  وَابْنُ الْعَبَّاسِ  فَحَمَلَنَا وَتَرَكَكَ .  ؟         [12/182]","","Musnad Abi Ya'la al-Mawsili 6808","","عبد الله بن الزبير عن ابن أبي مليكة عن حبيب بن الشهيد عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن الزبير رحمه الله"
"6813","5 - (  6809  ) -  حَدَّثَنَا  زُهَيْرٌ ، وَأَحْمَدُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ قَالَا :  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنْ  سَعِيدِ بْنِ يَزِيدَ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَسِيدٍ قَالَ :         [12/183]      سَمِعْتُ  رَجُلًا قَالَ لِابْنِ الزُّبَيْرِ : أَفْتِنَا فِي نَبِيذِ  الْجَرِّ  ؟ قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ نَبِيذِ  الْجَرِّ  .","","Musnad Abi Ya'la al-Mawsili 6809","","عبد الله بن الزبير عن عبد العزيز بن أسيد الطاحي عن سعيد بن يزيد الطاحي عن إسماعيل ابن علية عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند عبد الله بن الزبير رحمه الله"
"6814","6 - (  6810  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  الْحَجَّاجُ بْنُ أَبِي عُثْمَانَ قَالَ :  حَدَّثَنِي  أَبُو الزُّبَيْرِ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ الزُّبَيْرِ يَخْطُبُ عَلَى هَذَا الْمِنْبَرِ ، وَهُوَ         [12/184]      يَقُولُ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فِي الصَّلَاةِ أَوْ قَالَ : فِي الصَّلَوَاتِ  يَقُولُ : لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ  ، لَهُ الْمُلْكُ ، وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، لَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ ، لَا إِلَهَ إِلَّا اللهُ ، وَلَا نَعْبُدُ إِلَّا اللهَ ، أَهْلَ النِّعْمَةِ وَالْفَضْلِ وَالثَّنَاءِ الْحَسَنِ ، لَا إِلَهَ إِلَّا اللهُ مُخْلِصِينَ لَهُ الدِّينَ وَلَوْ كَرِهَ الْكَافِرُونَ  .","","Musnad Abi Ya'la al-Mawsili 6810","","عبد الله بن الزبير عن أبو الزبير المكي عن حجاج بن أبى عثمان الصواف الكندي عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن الزبير رحمه الله"
"6815","7 - (  6811  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  مَوْلًى لَهُمْ يُكْنَى أَبَا الزُّبَيْرِ ،         [12/185]      أَنَّ  عَبْدَ اللهِ بْنَ الزُّبَيْرِ ،  كَانَ يُهَلِّلُ دُبُرَ كُلِّ صَلَاةٍ ، ثُمَّ يَقُولُ : لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ ، لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ ، وَلَهُ الْحَمْدُ  ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، لَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ ، لَا إِلَهَ إِلَّا اللهُ ، وَلَا نَعْبُدُ إِلَّا اللهَ ، لَهُ النِّعْمَةُ وَلَهُ الْفَضْلُ ، وَلَهُ الثَّنَاءُ الْحَسَنُ ، لَا إِلَهَ إِلَّا اللهُ مُخْلِصِينَ لَهُ الدِّينَ وَلَوْ كَرِهَ الْكَافِرُونَ ، وَيَقُولُ  عَبْدُ اللهِ بْنُ الزُّبَيْرِ  : كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُهَلِّلُ بِهِنَّ دُبُرَ كُلِّ صَلَاةٍ  .","","Musnad Abi Ya'la al-Mawsili 6811","","عبد الله بن الزبير عن أبو الزبير المكي عن هشام بن عروة بن الزبير عن عبدة بن سليمان الكلابي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن الزبير رحمه الله"
"6816","8 - (  6812  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  يُوسُفَ بْنِ الزُّبَيْرِ مَوْلًى لِآلِ الزُّبَيْرِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ قَالَ :  جَاءَ  رَجُلٌ مِنْ خَثْعَمَ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّ أَبِي أَدْرَكَهُ الْإِسْلَامُ وَهُوَ شَيْخٌ لَا يَسْتَطِيعُ رُكُوبَ الرَّحْلِ ، وَالْحَجُّ مَكْتُوبٌ عَلَيْهِ ، أَفَأَحُجُّ عَنْهُ ؟ قَالَ : أَنْتَ أَكْبَرُ وَلَدِهِ ؟ قَالَ : نَعَمْ ، قَالَ :  أَرَأَيْتَ         [12/186]      لَوْ كَانَ عَلَى أَبِيكَ دَيْنٌ قَضَيْتَهُ ، أَكَانَ ذَلِكَ يُجْزِي ؟  قَالَ : نَعَمْ ، قَالَ : فَحُجَّ عَنْهُ  .         [12/187]","","Musnad Abi Ya'la al-Mawsili 6812","","عبد الله بن الزبير عن يوسف بن الزبير الأسدي عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن الزبير رحمه الله"
"6817","9 - (  6813  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  يُوسُفَ بْنِ الزُّبَيْرِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ قَالَ :  كَانَتْ  لِزَمْعَةَ  جَارِيَةٌ يَطَؤُهَا ، وَكَانَتْ  يُظَنُّ  بِرَجُلٍ آخَرَ يَقَعُ عَلَيْهَا ، فَمَاتَ  زَمْعَةُ  وَهِيَ حُبْلَى ، فَوَلَدَتْ غُلَامًا يُشْبِهُ الرَّجُلَ الَّذِي كَانَتْ تُظَنُّ بِهِ ، فَذَكَرَتْهُ  سَوْدَةُ  لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  أَمَّا الْمِيرَاثُ فَلَهُ ، وَأَمَّا أَنْتِ فَاحْتَجِبِي مِنْهُ ، فَإِنَّهُ لَيْسَ لَكِ بِأَخٍ  .         [12/188]             [12/189]","","Musnad Abi Ya'la al-Mawsili 6813","","عبد الله بن الزبير عن يوسف بن الزبير الأسدي عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن الزبير رحمه الله"
"6818","10 - (  6814  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  هَاشِمُ بْنُ الْقَاسِمِ ،  حَدَّثَنَا  اللَّيْثُ بْنُ سَعْدٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  قَالَ :  خَاصَمَ  رَجُلٌ مِنَ الْأَنْصَارِ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي  شِرَاجِ  الْحَرَّةِ  الَّتِي يَسْقُونَ بِهَا النَّخْلَ ، فَقَالَ الْأَنْصَارِيُّ  لِلزُّبَيْرِ  : سَرِّحِ الْمَاءَ ، فَأَبَى ، فَكَلَّمَ بِهِ رَسُولَ اللهِ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اسْقِ يَا  زُبَيْرُ  ، ثُمَّ أَرْسِلْ إِلَى جَارِكَ  ، قَالَ : فَغَضِبَ الْأَنْصَارِيُّ ، فَقَالَ : يَا رَسُولَ اللهِ ، أَنْ كَانَ ابْنَ عَمَّتِكَ ؟ فَتَلَوَّنَ وَجْهُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ قَالَ : يَا  زُبَيْرُ  ، اسْقِ ، وَاحْبِسِ الْمَاءَ حَتَّى يَرْجِعَ إِلَى  الْجَدْرِ  .  قَالَ  الزُّبَيْرُ  : وَاللهِ إِنِّي لَأَحْسَبُ الْآيَةَ نَزَلَتْ فِي أُولَئِكَ :         {      فَلا وَرَبِّكَ لا يُؤْمِنُونَ حَتَّى يُحَكِّمُوكَ فِيمَا شَجَرَ بَيْنَهُمْ         }      إِلَى قَوْلِهِ :         [12/190]      وَيُسَلِّمُوا تَسْلِيمًا  .         [12/191]             [12/192]","","Musnad Abi Ya'la al-Mawsili 6814","","عبد الله بن الزبير عن عروة بن الزبير عن الزهري عن الليث بن سعد عن هاشم بن القاسم بن مسلم عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن الزبير رحمه الله"
"6819","11 - (  6815  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  ثَابِتٍ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ الزُّبَيْرِ وَهُوَ يَخْطُبُ قَالَ : قَالَ  مُحَمَّدٌ  عَلَيْهِ السَّلَامُ :  مَنْ لَبِسَ الْحَرِيرَ فِي الدُّنْيَا لَمْ يَلْبَسْهُ فِي الْآخِرَةِ  .         [12/193]","","Musnad Abi Ya'la al-Mawsili 6815","","عبد الله بن الزبير عن ثابت البناني عن حماد بن زيد عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن الزبير رحمه الله"
"6820","12 - (  6816  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  هِشَامُ بْنُ يُوسُفَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ، أَنَّ عَبْدَ اللهِ بْنَ الزُّبَيْرِ ،  أَخْبَرَهُمْ  قَالَ :  قَدِمَ رَكْبٌ مِنْ  بَنِي تَمِيمٍ  عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ  أَبُو بَكْرٍ  : أَمِّرِ  الْقَعْقَاعَ بْنَ مَعْبَدِ بْنِ زُرَارَةَ  ، وَقَالَ  عُمَرُ  : أَمِّرِ  الْأَقْرَعَ بْنَ حَابِسٍ  ، فَقَالَ  أَبُو بَكْرٍ  : مَا أَرَدْتَ إِلَّا خِلَافِي ، فَقَالَ  عُمَرُ  : مَا أَرَدْتُ خِلَافَكَ ، فَتَمَارَيَا حَتَّى ارْتَفَعَتْ أَصْوَاتُهُمَا ، فَنَزَلَتْ         [12/194]             {      يَا أَيُّهَا الَّذِينَ آمَنُوا لا تُقَدِّمُوا بَيْنَ يَدَيِ اللهِ وَرَسُولِهِ         }      .         [12/195]","","Musnad Abi Ya'la al-Mawsili 6816","","عبد الله بن الزبير عن ابن أبي مليكة عن ابن جريج عن هشام بن يوسف الأبناوي عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند عبد الله بن الزبير رحمه الله"
"6821","13 - (  6817  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  هِشَامٍ ،  عَنْ  حَفْصَةَ بِنْتِ سِيرِينَ ،  عَنْ  أَبِي ذِبْيَانَ قَالَ :  سَمِعْتُ  ابْنَ الزُّبَيْرِ وَهُوَ يَخْطُبُ قَالَ : قَالَ  مُحَمَّدٌ  عَلَيْهِ السَّلَامُ :  مَنْ لَبِسَ الْحَرِيرَ فِي الدُّنْيَا لَمْ يَلْبَسْهُ فِي الْآخِرَةِ  ، قَالَ : وَإِلَى جَنْبِهِ  ابْنُ عُمَرَ  ، فَقَالَ : إِذًا وَاللهِ لَا يَدْخُلُ الْجَنَّةَ ، يَقُولُ اللهُ :         {      وَلِبَاسُهُمْ فِيهَا حَرِيرٌ         }      .         [12/196]","","Musnad Abi Ya'la al-Mawsili 6817","","عبد الله بن الزبير عن خليفة بن كعب البستي عن حفصة بنت سيرين عن هشام بن حسان العتكي عن حماد بن زيد عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند عبد الله بن الزبير رحمه الله"
"6822","14 - (  6818  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ عَبْدِ الصَّمَدِ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  مَوْلًى لِآلِ الزُّبَيْرِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  سَوْدَةَ بِنْتِ زَمْعَةَ قَالَتْ :  دَخَلَ  رَجُلٌ  عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : إِنَّ أَبِي شَيْخٌ كَبِيرٌ لَا يَسْتَطِيعُ أَنْ         [12/197]      يَحُجَّ ، قَالَ :  أَرَأَيْتَ لَوْ كَانَ عَلَى أَبِيكَ دَيْنٌ فَقَضَيْتَهُ عَنْهُ قُبِلَ مِنْهُ ؟  قَالَ : نَعَمْ ، قَالَ : فَاللهُ أَحَقُّ ، فَحُجَّ عَنْ أَبِيكَ  .  15 - (  6819  ) - وَرَوَاهُ  جَرِيرٌ  ، عَنِ  ابْنِ الزُّبَيْرِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - قَالَ أَبُو يَعْلَى :  رُوِيَ هَذَا عَنِ  ابْنِ الزُّبَيْرِ  ، عَنْ  سَوْدَةَ  .","","Musnad Abi Ya'la al-Mawsili 6818","","سودة بنت زمعة زوج رسول الله عن عبد الله بن الزبير عن مولى لآل الزبير عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن عبد العزيز بن عبد الصمد العمي عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عبد الله بن الزبير رحمه الله"
"6823","16 - (  6820  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ الْأَسَدِيُّ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَقُومُ السَّاعَةُ حَتَّى يَخْرُجَ ثَلَاثُونَ كَذَّابًا  : مِنْهُمْ  مُسَيْلِمَةُ  ،         [12/198]      وَالْعَنْسِيُّ  ،  وَالْمُخْتَارُ  ، وَشَرُّ قَبَائِلِ الْعَرَبِ  بَنُو أُمَيَّةَ  ،  وَبَنُو حَنِيفَةَ  ،  وَثَقِيفُ  .","","Musnad Abi Ya'la al-Mawsili 6820","","عبد الله بن الزبير عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن محمد بن الحسن بن الزبير التل عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن الزبير رحمه الله"
"6824","17 - (  6821  ) -  حَدَّثَنَا  أَبُو عُبَيْدَةَ بْنُ فُضَيْلِ بْنِ عِيَاضٍ ،  حَدَّثَنَا  مَالِكُ بْنُ سُعَيْرٍ ،  حَدَّثَنَا  فُرَاتُ بْنُ الْأَحْنَفِ ، قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  أَنَّهُ قَامَ فِي بَابٍ دَاخِلٍ فِيهِ إِلَى الْمَسْجِدِ :  مَسْجِدِ مِنًى  ، فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ :  إِنَّ هَؤُلَاءِ الْأَعْبُدَ الْكُفَّارَ وَالْفُسَّاقَ قَدْ عَمَدُوا عَلَيَّ  ، وَذَكَرَ الْحَدِيثَ .         [12/199]","","Musnad Abi Ya'la al-Mawsili 6821","","عبد الله بن الزبير عن الأحنف أبو بحر الهلالي عن الفرات بن أحنف الهلالى عن مالك بن سعير التميمي عن أبو عبيدة بن الفضيل بن عياض عن أبو يعلى الموصلي","مسند عبد الله بن الزبير رحمه الله"
"6825","18 - (  6822  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنْ  لَيْثِ بْنِ أَبِي سُلَيْمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ حَسَنِ بْنِ حَسَنٍ ،  عَنْ  أُمِّهِ فَاطِمَةَ بِنْتِ حُسَيْنٍ ،  عَنْ  جَدَّتِهَا فَاطِمَةَ بِنْتِ رَسُولِ اللهِ  ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا دَخَلَ الْمَسْجِدَ صَلَّى عَلَى  مُحَمَّدٍ  ، ثُمَّ قَالَ : اللَّهُمَّ اغْفِرْ لِي ذَنْبِي  ، وَافْتَحْ لِي أَبْوَابَ رَحْمَتِكَ ، وَإِذَا خَرَجَ صَلَّى عَلَى  مُحَمَّدٍ  ، ثُمَّ قَالَ : اللَّهُمَّ اغْفِرْ لِي ذُنُوبِي ، وَافْتَحْ لِي أَبْوَابَ رَحْمَتِكَ  .         [12/200]      19 - (  6823  ) -  قَالَ  إِسْمَاعِيلُ : فَلَقِيتُ عَبْدَ اللهِ بْنَ حَسَنٍ ،  فَسَأَلْتُهُ  عَنْ هَذَا الْحَدِيثِ ، فَقَالَ :  كَانَ إِذَا دَخَلَ قَالَ : اللَّهُمَّ افْتَحْ لِي أَبْوَابَ رَحْمَتِكَ  ، وَإِذَا خَرَجَ قَالَ : رَبِّ افْتَحْ لِي أَبْوَابَ فَضْلِكَ  .         [12/201]","","Musnad Abi Ya'la al-Mawsili 6822","","فاطمة الزهراء عن فاطمة بنت الحسين بن علي بن أبي طالب عن عبد الله بن حسن بن حسن بن علي بن أبي طالب عن ليث بن أبي سليم عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن الزبير رحمه الله"
"6826","20 - (  6824  ) -  حَدَّثَنَا  عُبَيْدُ بْنُ جَنَّادٍ ،  حَدَّثَنَا  عَطَاءُ بْنُ مُسْلِمٍ ،  عَنْ  جَعْفَرِ بْنِ بُرْقَانَ ،  عَنْ  عَطَاءٍ ،  عَنِ  الْفَضْلِ بْنِ عَبَّاسٍ قَالَ :  دَخَلْتُ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي مَرَضِهِ ، وَعِنْدَ رَأْسِهِ عِصَابَةٌ  حَمْرَاءُ ، أَوْ قَالَ : صَفْرَاءُ  ، فَقَالَ : ابْنَ عَمِّي ، خُذْ هَذِهِ الْعِصَابَةَ فَاشْدُدْ بِهَا رَأْسِي ، فَشَدَدْتُ بِهَا رَأْسَهُ ، قَالَ : ثُمَّ تَوَكَّأَ عَلَيَّ حَتَّى دَخَلْنَا الْمَسْجِدَ ، فَقَالَ :  يَا أَيُّهَا النَّاسُ ، إِنَّمَا أَنَا بَشَرٌ مِثْلُكُمْ ، وَلَعَلَّهُ أَنْ يَكُونَ قَدْ قَرُبَ مِنِّي  خُفُوفٌ  مِنْ بَيْنِ أَظْهُرِكُمْ  ، فَمَنْ كُنْتُ أَصَبْتُ مِنْ عِرْضِهِ ، أَوْ مِنْ شَعَرِهِ ، أَوْ مِنْ بَشَرِهِ ، أَوْ مِنْ مَالِهِ شَيْئًا ، هَذَا عِرْضُ  مُحَمَّدٍ  وَشَعْرُهُ ، وَبَشَرُهُ ، وَمَالُهُ ، فَلْيَقُمْ فَلْيَقْتَصَّ ، وَلَا يَقُولَنَّ أَحَدٌ مِنْكُمْ إِنِّي أَتَخَوَّفُ مِنْ  مُحَمَّدٍ  الْعَدَاوَةَ  وَالشَّحْنَاءَ  ، أَلَا وَإِنَّهُمَا لَيْسَا مِنْ طَبِيعَتِي وَلَيْسَا مِنْ  خُلُقِي  ، قَالَ : ثُمَّ انْصَرَفَ ، فَلَمَّا كَانَ مِنَ الْغَدِ أَتَيْتُهُ ، فَقَالَ : ابْنَ عَمِّي ، لَا أَحْسَبُ أَنَّ مَقَامِي بِالْأَمْسِ أَجْزَى عَنِّي ، خُذْ هَذِهِ الْعِصَابَةَ فَاشْدُدْ بِهَا رَأْسِي ، قَالَ : فَشَدَدْتُ بِهَا رَأْسَهُ ، قَالَ : ثُمَّ تَوَكَّأَ عَلَيَّ حَتَّى دَخَلَ         [12/202]      الْمَسْجِدَ ، فَقَالَ مِثْلَ مَقَالَتِهِ بِالْأَمْسِ ، ثُمَّ قَالَ : فَإِنَّ أَحَبَّكُمْ إِلَيْنَا مَنِ اقْتَصَّ ، قَالَ : فَقَامَ  رَجُلٌ  ، فَقَالَ : يَا رَسُولَ اللهِ ، أَرَأَيْتَ يَوْمَ أَتَاكَ السَّائِلُ فَسَأَلَكَ ، فَقُلْتَ : مَنْ مَعَهُ شَيْءٌ يُقْرِضُنَا ؟ فَأَقْرَضْتُكَ ثَلَاثَةَ دَرَاهِمَ ، قَالَ : فَقَالَ : يَا  فَضْلُ  ، أَعْطِهِ ، قَالَ : فَأَعْطَيْتُهُ .  قَالَ : ثُمَّ قَالَ : وَمَنْ غَلَبَ عَلَيْهِ شَيْءٌ فَلْيَسْأَلْنَا نَدْعُ لَهُ ، قَالَ : فَقَامَ  رَجُلٌ  فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي رَجُلٌ جَبَانٌ كَثِيرُ النَّوْمِ ، قَالَ : فَدَعَا لَهُ ، قَالَ  الْفَضْلُ  : فَلَقَدْ رَأَيْتُهُ أَشْجَعَنَا وَأَقَلَّنَا نَوْمًا ، قَالَ : ثُمَّ أَتَى بَيْتَ  عَائِشَةَ  فَقَالَ لِلنِّسَاءِ مِثْلَ مَا قَالَ لِلرِّجَالِ ، ثُمَّ قَالَ : وَمَنْ غَلَبَ عَلَيْهِ شَيْءٌ فَلْيَسْأَلْنَا نَدْعُ لَهُ ، قَالَ : فَأَوْمَأَتِ  امْرَأَةٌ  إِلَى لِسَانِهَا ، قَالَ : فَدَعَا لَهَا ، قَالَ : فَلَرُبَّمَا قَالَتْ لِي : يَا  عَائِشَةُ  ، أَحْسِنِي صَلَاتَكِ  .         [12/203]","","Musnad Abi Ya'la al-Mawsili 6824","","الفضل بن العباس بن عبد المطلب الهاشمي عن عطاء بن أبي رباح عن جعفر بن برقان الكلابي عن عطاء بن مسلم عن عبيد بن جناد الرقي عن أبو يعلى الموصلي","مسند عبد الله بن الزبير رحمه الله"
"6827","حَدِيثُ  فَيْرُوزَ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  1 - (  6825  ) -  حَدَّثَنَا  الْحَكَمُ بْنُ مُوسَى ،  حَدَّثَنَا  هِقْلُ بْنُ زِيَادٍ ،  حَدَّثَنَا  الْأَوْزَاعِيُّ قَالَ :  حَدَّثَنِي  يَحْيَى بْنُ أَبِي عَمْرٍو السَّيْبَانِيُّ قَالَ :  حَدَّثَنِي  ابْنُ الدَّيْلَمِيِّ قَالَ :  حَدَّثَنِي  أَبِي فَيْرُوزُ  ،  أَنَّهُ أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  يَا رَسُولَ اللهِ ، إِنَّا مَنْ قَدْ عَلِمْتَ ، وَجِئْنَا مِنْ بَيْنِ ظَهْرَانَيْ مَنْ قَدْ عَلِمْتَ  ، فَمَنْ وَلِيُّنَا ؟ قَالَ : اللهُ وَرَسُولُهُ ، قَالَ : حَسْبُنَا  .         [12/204]","","Musnad Abi Ya'la al-Mawsili 6825","","فيروز الديلمي عن عبد الله بن فيروز عن يحيى بن أبي عمرو السيباني عن أبو عمرو الأوزاعي عن هقل بن زياد السكسكي عن الحكم بن موسى بن أبي زهير النسائي عن أبو يعلى الموصلي","حديث فيروز عن النبي - صلى الله عليه وسلم"
"6828","حَدِيثُ  الْحَكَمِ بْنِ حَزْنٍ الْكُلَفِيِّ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  1 - (  6826  ) -  حَدَّثَنَا  الْحَكَمُ بْنُ مُوسَى ،  حَدَّثَنَا  شِهَابُ بْنُ خِرَاشٍ ،  عَنْ  شُعَيْبِ بْنِ رُزَيْقٍ الطَّائِفِيِّ قَالَ : كُنْتُ جَالِسًا إِلَى         [12/205]      رَجُلٍ يُقَالُ لَهُ الْحَكَمُ بْنُ حَزْنٍ الْكُلَفِيُّ ،  وَلَهُ صُحْبَةٌ  مِنَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَنْشَأَ  يُحَدِّثُنَا  ، قَالَ :  قَدِمْتُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  سَابِعَ سَبْعَةٍ أَوْ تَاسِعَ تِسْعَةٍ  فَأَذِنَ لَنَا ، فَدَخَلْنَا ، فَقُلْنَا : يَا رَسُولَ اللهِ ، أَتَيْنَاكَ لِتَدْعُوَ لَنَا بِخَيْرٍ ، فَدَعَا لَنَا بِخَيْرٍ ، وَأَمَرَ بِنَا فَأُنْزِلْنَا ، فَأَمَرَ لَنَا بِشَيْءٍ مِنْ تَمْرٍ ،  وَالشَّأْنُ  إِذْ ذَاكَ دُونٌ ، فَلَبِثْنَا عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَيَّامًا ، فَشَهِدْنَا بِهَا الْجُمُعَةَ ، فَقَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مُتَوَكِّئًا  عَلَى قَوْسٍ ، أَوْ قَالَ : عَلَى عَصًا  ، فَحَمِدَ اللهَ ، وَأَثْنَى عَلَيْهِ كَلِمَاتٍ طَيِّبَاتٍ خَفِيفَاتٍ مُبَارَكَاتٍ ، ثُمَّ قَالَ :  أَيُّهَا النَّاسُ ، إِنَّكُمْ لَنْ تُطِيقُوا كُلَّ مَا أُمِرْتُمْ بِهِ ، وَلَكِنْ  سَدِّدُوا  وَقَارِبُوا  .         [12/206]","","Musnad Abi Ya'la al-Mawsili 6826","","الحكم بن حزن الكلفي عن شعيب بن رزيق الطائفي عن شهاب بن خراش الحوشبي عن الحكم بن موسى بن أبي زهير النسائي عن أبو يعلى الموصلي","حديث الحكم بن حزن الكلفي عن النبي صلى الله عليه وسلم"
"6829","حَدِيثُ  عِيَاضِ بْنِ غَنْمٍ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  1 - (  6827  ) -  حَدَّثَنَا  الْحَكَمُ بْنُ مُوسَى ،  حَدَّثَنَا  هِقْلٌ ،  عَنِ  الْمُثَنَّى ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،         [12/207]      عَنْ  عِيَاضِ بْنِ غَنْمٍ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ  شَرِبَ  الْخَمْرَ لَمْ تُقْبَلْ لَهُ صَلَاةٌ أَرْبَعِينَ يَوْمًا  ، فَإِنْ مَاتَ فَإِلَى النَّارِ ، فَإِنْ تَابَ قَبِلَ اللهُ مِنْهُ ، وَإِنْ شَرِبَهَا الثَّانِيَةَ لَمْ تُقْبَلْ لَهُ صَلَاةٌ أَرْبَعِينَ يَوْمًا ، فَإِنْ مَاتَ فَإِلَى النَّارِ ، فَإِنْ تَابَ قَبِلَ اللهُ مِنْهُ ، وَإِنْ شَرِبَهَا الثَّالِثَةَ وَالرَّابِعَةَ ، كَانَ حَقًّا عَلَى اللهِ أَنْ يَسْقِيَهُ مِنْ  رَدْغَةِ  الْخَبَالِ  ، فَقِيلَ : يَا رَسُولَ اللهِ ، وَمَا  رَدْغَةُ  الْخَبَالِ  ؟ قَالَ : عُصَارَةُ أَهْلِ النَّارِ  .         [12/208]","","Musnad Abi Ya'la al-Mawsili 6827","","عياض بن غنم بن زهير الفهري عن شهر بن حوشب عن أبو الزبير المكي عن المثنى بن الصباح الأبناوي عن هقل بن زياد السكسكي عن الحكم بن موسى بن أبي زهير النسائي عن أبو يعلى الموصلي","حديث عياض بن غنم عن النبي - صلى الله عليه وسلم"
"6830","حَدِيثُ  عُرْوَةَ بْنِ أَبِي الْجَعْدِ الْبَارِقِيِّ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  1 - (  6828  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  حُصَيْنٍ ،  عَنْ  عَامِرٍ ،  عَنْ  عُرْوَةَ الْبَارِقِيِّ  رَفَعَهُ  قَالَ :  الْإِبِلُ عِزٌّ لِأَهْلِهَا ، وَالْغَنَمُ بَرَكَةٌ  ، وَالْخَيْرُ  مَعْقُودٌ  فِي نَوَاصِي الْخَيْلِ  .         [12/209]","","Musnad Abi Ya'la al-Mawsili 6828","","عروة بن الجعد البارقي عن الشعبي عن حصين بن عبد الرحمن السلمي عن عبد الله بن إدريس الأودي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","حديث عروة بن أبي الجعد البارقي عن النبي - صلى الله عليه وسلم"
"6831","[12/210]      حَدِيثُ  عُقْبَةَ بْنِ مَالِكٍ اللَّيْثِيِّ  1 - (  6829  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْمُغِيرَةِ ،  حَدَّثَنَا  حُمَيْدُ بْنُ هِلَالٍ قَالَ : أَتَانِي  أَبُو الْعَالِيَةِ  ، وَصَاحِبٌ لِي ، فَقَالَ : هَلُمَّا فَإِنَّكُمَا أَشَبُّ شَبَابًا ، وَأَوْعَى لِلْحَدِيثِ مِنِّي ، فَانْطَلَقْنَا حَتَّى  أَتَيْنَا  بِشْرَ بْنَ عَاصِمٍ اللَّيْثِيَّ ، قَالَ  أَبُو الْعَالِيَةِ  : حَدِّثْ هَذَيْنِ حَدِيثًا ، قَالَ  بِشْرٌ  :         [12/211]      حَدَّثَنَا  عُقْبَةُ بْنُ مَالِكٍ اللَّيْثِيُّ ، وَكَانَ مِنْ رَهْطِهِ قَالَ :  بَعَثَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَرِيَّةً فَغَارَتْ عَلَى قَوْمٍ ، فَشَدَّ مِنَ  الْقَوْمِ  رَجُلٌ وَاتَّبَعَهُ  رَجُلٌ  مِنَ السَّرِيَّةِ وَمَعَهُ السَّيْفُ شَاهِرُهُ ، فَقَالَ إِنْسَانٌ مِنَ  الْقَوْمِ  : إِنِّي مُسْلِمٌ ، إِنِّي مُسْلِمٌ ، فَلَمْ يَنْظُرْ فِيهَا ، قَالَ : فَضَرَبَهُ فَقَتَلَهُ ، قَالَ : فَنُمِيَ الْحَدِيثُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ فِيهِ قَوْلًا شَدِيدًا ، فَبَلَغَ الْقَاتِلَ ، قَالَ : فَبَيْنَمَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ ، إِذْ قَالَ الْقَاتِلُ : يَا رَسُولَ اللهِ ، وَاللهِ مَا قَالَ الَّذِي قَالَهُ إِلَّا  تَعَوُّذًا  مِنَ الْقَتْلِ ، فَأَعْرَضَ عَنْهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعَمَّنْ قِبَلَهُ مِنَ النَّاسِ ، وَأَخَذَ فِي خُطْبَتِهِ ، قَالَ : ثُمَّ عَادَ ، فَقَالَ : يَا رَسُولَ اللهِ ، مَا قَالَ الَّذِي قَالَ إِلَّا  تَعَوُّذًا  مِنَ الْقَتْلِ ، فَأَعْرَضَ عَنْهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعَمَّنْ قِبَلَهُ مِنَ النَّاسِ ، فَلَمْ يَصْبِرْ أَنْ قَالَ فِي الثَّالِثَةِ ، فَأَقْبَلَ عَلَيْهِ تُعْرَفُ الْمَسَاءَةُ فِي وَجْهِهِ ، فَقَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ أَبَى عَلَيَّ أَنْ أَقْتُلَ مُؤْمِنًا  ، ثَلَاثَ مَرَّاتٍ  .         [12/212]      حَدِيثُ رَجُلٍ غَيْرِ مُسَمًّى عَنْ جَدِّهِ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ . -","","Musnad Abi Ya'la al-Mawsili 6829","","عقبة بن مالك الليثي عن بشر بن عاصم الليثي عن حميد بن هلال العدوي عن سليمان بن المغيرة القيسي عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","حديث عقبة بن مالك الليثي"
"6832","1 - (  6830  ) -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ النُّكْرِيُّ ،  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  حَدَّثَنَا  حَرْبُ بْنُ سُرَيْجٍ قَالَ :  حَدَّثَنِي  رَجُلٌ مِنْ بَلْعَدَوِيَّةِ قَالَ :         [12/213]      حَدَّثَنِي  جَدِّي  قَالَ :  انْطَلَقْتُ إِلَى  الْمَدِينَةِ  فَنَزَلْتُ عِنْدَ الْوَادِي فَإِذَا رَجُلَانِ بَيْنَهُمَا عَنْزٌ وَاحِدَةٌ ، وَإِذَا الْمُشْتَرِي يَقُولُ لِلْبَائِعِ : أَحْسِنْ مُبَايَعَتِي ، قَالَ : فَقُلْتُ فِي نَفْسِي : هَذَا الْهَاشِمِيُّ الَّذِي أَضَلَّ النَّاسَ أَهُوَ هُوَ ؟ قَالَ : فَنَظَرْتُ ، فَإِذَا رَجُلٌ حَسَنُ الْجِسْمِ ، عَظِيمُ الْجَبْهَةِ ، دَقِيقُ الْأَنْفِ ، دَقِيقُ الْحَاجِبَيْنِ ، وَإِذَا مِنْ  ثُغْرَةِ  نَحْرِهِ إِلَى سُرَّتِهِ مِثْلُ الْخَيْطِ الْأَسْوَدِ شَعَرٌ أَسْوَدُ ، وَإِذَا هُوَ بَيْنَ  طِمْرَيْنِ  ، قَالَ : فَدَنَا مِنَّا ، فَقَالَ : السَّلَامُ عَلَيْكُمْ ، فَرَدُّوا عَلَيْهِ ، فَلَمْ أَلْبَثْ أَنْ دَعَا الْمُشْتَرِي ، فَقَالَ : يَا رَسُولَ اللهِ ، قُلْ لَهُ يُحْسِنْ مُبَايَعَتِي ، فَمَدَّ يَدَهُ وَقَالَ :  أَمْوَالَكُمْ تَمْلِكُونَ ، إِنِّي أَرْجُو أَنْ أَلْقَى اللهَ عَزَّ وَجَلَّ يَوْمَ الْقِيَامَةِ لَا يَطْلُبُنِي أَحَدٌ مِنْكُمْ بِشَيْءٍ ظَلَمْتُهُ فِي مَالٍ  ، وَلَا دَمٍ ، وَلَا عِرْضٍ ، إِلَّا بِحَقِّهِ ، رَحِمَ اللهُ امْرَأً سَهْلَ الْبَيْعِ ، سَهْلَ الشِّرَاءِ ، سَهْلَ الْأَخْذِ ، سَهْلَ الْإِعْطَاءِ ، سَهْلَ الْقَضَاءِ ، سَهْلَ التَّقَاضِي ، ثُمَّ مَضَى ، فَقُلْتُ : وَاللهِ لَأَقُصَّنَّ هَذَا ، فَإِنَّهُ حَسَنُ الْقَوْلِ ، فَتَبِعْتُهُ فَقُلْتُ : يَا  مُحَمَّدُ  ، فَالْتَفَتَ إِلَيَّ بِجَمِيعِهِ ، فَقَالَ : مَا تَشَاءُ ؟ فَقُلْتُ : أَنْتَ الَّذِي أَضْلَلْتَ النَّاسَ وَأَهْلَكْتَهُمْ وَصَدَدْتَهُمْ عَمَّا كَانَ يَعْبُدُ آبَاؤُهُمْ ؟ قَالَ : ذَاكَ اللهُ ،         [12/214]      قُلْتُ : مَا تَدْعُو إِلَيْهِ ؟ قَالَ : أَدْعُو عِبَادَ اللهِ إِلَى اللهِ ، قَالَ : مَا تَقُولُ ؟ قَالَ : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَنِّي  مُحَمَّدٌ  رَسُولُ اللهِ ، وَتُؤْمِنُ بِمَا أَنْزَلَ اللهُ عَلَيَّ ، وَتَكْفُرُ  بِاللَّاتِ  وَالْعُزَّى ، وَتُقِيمُ الصَّلَاةَ ، وَتُؤْتِي الزَّكَاةَ ، قَالَ : قُلْتُ : وَمَا الزَّكَاةُ ؟ قَالَ : يَرُدُّ غَنِيُّنَا عَلَى فَقِيرِنَا ، قَالَ : قُلْتُ : نِعْمَ الشَّيْءُ تَدْعُو إِلَيْهِ ، قَالَ : فَلَقَدْ كَانَ وَمَا فِي الْأَرْضِ أَحَدٌ يَتَنَفَّسُ أَبْغَضَ إِلَيَّ مِنْهُ ، فَمَا بَرِحَ حَتَّى كَانَ أَحَبَّ إِلَيَّ مِنْ وَلَدِي ، وَوَالِدَيَّ ، وَمِنَ النَّاسِ أَجْمَعِينَ .  قَالَ : فَقُلْتُ : قَدْ عَرَفْتُ ، قَالَ : قَدْ عَرَفْتَ ؟ قُلْتُ : نَعَمْ ، قَالَ : تَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَنِّي  مُحَمَّدٌ  رَسُولُ اللهِ ، وَتُؤْمِنُ بِمَا أُنْزِلَ عَلَيَّ ؟ قَالَ : قُلْتُ : نَعَمْ يَا رَسُولَ اللهِ ، إِنِّي أَرِدُ مَاءً عَلَيْهِ كَثِيرٌ مِنَ النَّاسِ فَأَدْعُوهُمْ إِلَى مَا دَعَوْتَنِي إِلَيْهِ ، فَإِنِّي أَرْجُو أَنْ يَتَّبِعُوكَ ، قَالَ : نَعَمْ ، فَادْعُهُمْ ، فَأَسْلَمَ أَهْلُ ذَلِكَ الْمَاءِ رِجَالُهُمْ وَنِسَاؤُهُمْ ، فَمَسَحَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَأْسَهُ  .","","Musnad Abi Ya'la al-Mawsili 6830","","أحد الصحابة عن رجل من بلعدوية عن حرب بن سريج المنقري عن عثمان بن عمر بن فارس عن يعقوب بن إبراهيم بن كثير عن أبو يعلى الموصلي","حديث عقبة بن مالك الليثي"
"6833","[12/215]      حَدِيثُ  مَالِكِ بْنِ هُبَيْرَةَ  1 - (  6831  ) -  حَدَّثَنَا  دَاوُدُ بْنُ عَمْرٍو ،  حَدَّثَنَا  أَبُو شِهَابٍ الْحَنَّاطُ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  مَرْثَدِ بْنِ عَبْدِ اللهِ ،  عَنْ  مَالِكِ بْنِ هُبَيْرَةَ ،  أَنَّهُ كَانَ إِذَا تَبِعَ جِنَازَةً فَاسْتَقْبَلَ أَهْلَهَا ، جَزَّأَهُمْ ثَلَاثَةَ صُفُوفٍ ، ثُمَّ صَلَّى عَلَيْهَا ، وَأَخْبَرَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَا صَلَّى عَلَى مَيِّتٍ ثَلَاثَةُ صُفُوفٍ إِلَّا وَجَبَتْ  .","","Musnad Abi Ya'la al-Mawsili 6831","","مالك بن هبيرة السكوني عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن عبد ربه بن نافع الحناط عن داود بن عمرو المسيبي عن أبو يعلى الموصلي","حديث مالك بن هبيرة"
"6834","[12/216]      حَدِيثُ رَجُلٍ غَيْرِ مُسَمًّى ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  1 - (  6832  ) -  حَدَّثَنَا  عَمْرُو بْنُ الضَّحَّاكِ بْنِ مَخْلَدِ بْنِ         [12/217]      الضَّحَّاكِ ،  حَدَّثَنَا  أَبِي  ،  حَدَّثَنَا  طَالِبُ بْنُ سَلْمَى بْنِ عَاصِمِ بْنِ الْحَكَمِ قَالَ :  حَدَّثَنِي  بَعْضُ أَهْلِي ، أَنَّ جَدِّي  حَدَّثَهُمْ  ،  أَنَّهُ شَهِدَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي حَجَّتِهِ فِي خُطْبَتِهِ ، فَقَالَ :  أَلَا إِنَّ أَمْوَالَكُمْ وَدِمَاءَكُمْ عَلَيْكُمْ حَرَامٌ  كَحُرْمَةِ  هَذَا الْبَلَدِ فِي هَذَا الْيَوْمِ  ، أَلَا فَلَا يُعَرِّفَنَّكُمْ : تَرْجِعُونَ بَعْدِي  كُفَّارًا  يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ ، أَلَا لِيُبَلِّغِ الشَّاهِدُ الْغَائِبَ ، فَإِنِّي لَا أَدْرِي هَلْ أَلْقَاكُمْ هَذَا أَبَدًا بَعْدَ الْيَوْمِ ، اللَّهُمَّ اشْهَدْ عَلَيْهِمُ ، اللَّهُمَّ بَلَّغْتُ  .         [12/218]","","Musnad Abi Ya'la al-Mawsili 6832","","عاصم بن الحكم عن بعض أهل طالب بن سلم بن عاصم عن طالب بن سلم بن عاصم عن أبو عاصم النبيل عن عمرو بن الضحاك بن مخلد عن أبو يعلى الموصلي","حديث رجل غير مسمى عن النبي - صلى الله عليه وسلم"
"6835","2 - (  6833  ) -  حَدَّثَنَا  عَمْرُو بْنُ الضَّحَّاكِ ،  حَدَّثَنَا  أَبِي  ،  حَدَّثَنَا  طَالِبُ بْنُ سَلْمَى بْنِ عَاصِمِ بْنِ الْحَكَمِ  قَالَ :  حَدَّثَنِي  بَعْضُ أَهْلِنَا ،  أَنَّهُ سَمِعَ  جَدِّي  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَئِذٍ :  أَلَا إِنَّ اللهَ نَظَرَ إِلَى هَذَا الْجَمْعِ فَقَبِلَ مِنْ مُحْسِنِهِمْ ، وَشَفَّعَ مُحْسِنَهُمْ فِي مُسِيئِهِمْ  ، فَتَجَاوَزَ عَنْهُمْ جَمِيعًا  .  كذا في طبعة دار المأمون للتراث ، والصواب : ( طالب بن سلم بن عاصم بن الحكم )","","Musnad Abi Ya'la al-Mawsili 6833","","جدي عن بعض أهل طالب بن سلم بن عاصم عن طالب بن سلم بن عاصم عن أبو عاصم النبيل عن عمرو بن الضحاك بن مخلد عن أبو يعلى الموصلي","حديث رجل غير مسمى عن النبي - صلى الله عليه وسلم"
"6836","[12/219]      حَدِيثُ  صُحَارٍ  1 - (  6834  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ عَبْدِ الْأَعْلَى ،  حَدَّثَنَا  سَعِيدُ بْنُ إِيَاسٍ الْجُرَيْرِيُّ ،  عَنْ  أَبِي الْعَلَاءِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ صُحَارٍ قَالَ : وَكَانَ مِنْ  عَبْدِ الْقَيْسِ  ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَقُومُ السَّاعَةُ حَتَّى يُخْسَفَ بِقَبَائِلَ مِنْ بَنِي فُلَانٍ  ، فَعَلِمْتُ أَنَّ بَنِي فُلَانٍ مِنَ الْعَرَبِ ، وَأَنَّ الْعَجَمَ نُسِبَ إِلَى قُرَاهَا  .         [12/220]             [12/221]","","Musnad Abi Ya'la al-Mawsili 6834","","صحار بن العباس العثماني عن عبد الرحمن بن صحار العبدي عن يزيد بن عبد الله بن الشخير العامري عن سعيد بن إياس الجريري عن عبد الأعلى بن عبد الأعلى القرشي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","حديث صحار"
"6837","حَدِيثُ وَالِدِ  حَجَّاجٍ  1 - (  6835  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ أَبُو الْحَارِثِ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  حَجَّاجِ بْنِ حَجَّاجٍ ،  عَنْ  أَبِيهِ  قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، مَا يُذْهِبُ عَنِّي  مَذَمَّةَ  الرَّضَاعِ ؟ قَالَ :  غُرَّةٌ  : عَبْدٌ أَوْ أَمَةٌ  .         [12/222]             [12/223]","","Musnad Abi Ya'la al-Mawsili 6835","","حجاج بن مالك الأسلمي عن حجاج بن حجاج بن مالك الأسلمي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أبو معاوية الضرير عن سريج بن يونس المروزي عن أبو يعلى الموصلي","حديث والد حجاج"
"6838","حَدِيثُ  عَاصِمِ بْنِ عَدِيٍّ  1 - (  6836  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  مَالِكِ بْنِ أَنَسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي الْبَدَّاحِ بْنِ عَاصِمِ بْنِ عَدِيٍّ ،         [12/224]      عَنْ  أَبِيهِ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ لِلرِّعَاءِ فِي الْبَيْتُوتَةِ  ، عَنْ  مِنًى  يَرْمُونَ يَوْمَ النَّحْرِ ، وَيَرْمُونَ الْغَدَ وَبَعْدَ يَوْمَيِ الْغَدِ  .","","Musnad Abi Ya'la al-Mawsili 6836","","عاصم بن عدي العجلاني عن أبو البداح بن عاصم البلوي عن أبو بكر بن محمد الخزرجي عن عبد الله بن أبي بكر بن محمد  ابن حزم عن مالك بن أنس عن عبد الرحمن بن مهدي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","حديث عاصم بن عدي"
"6839","[12/225]      حَدِيثُ  أَبِي سَعِيدِ بْنِ الْمُعَلَّى  1 - (  6837  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  حَدَّثَنَا  شُعْبَةُ قَالَ :  حَدَّثَنِي  خُبَيْبُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  حَفْصِ بْنِ عَاصِمٍ ،  عَنْ  أَبِي سَعِيدِ بْنِ الْمُعَلَّى قَالَ :  كُنْتُ أُصَلِّي فِي الْمَسْجِدِ ، فَدَعَانِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمْ أُجِبْهُ قَالَ : قُلْتُ لَهُ : يَا رَسُولَ اللهِ ، إِنِّي كُنْتُ أُصَلِّي قَالَ :  أَوَلَمْ يَقُلِ اللهُ :         {      اسْتَجِيبُوا لِلهِ وَلِلرَّسُولِ         }      ؟  ثُمَّ قَالَ لِي : أَلَا أُعَلِّمُكَ سُورَةً هِيَ أَعْظَمُ سُورَةٍ فِي الْقُرْآنِ ؟ قَالَ :         {      الْحَمْدُ لِلهِ رَبِّ الْعَالَمِينَ         }      مِنَ  السَّبْعِ  الْمَثَانِي وَالْقُرْآنِ الْعَظِيمِ الَّذِي أُوتِيتُهُ  .","","Musnad Abi Ya'la al-Mawsili 6837","","أبو سعيد بن المعلى الأنصاري عن حفص بن عاصم بن عمر بن الخطاب عن خبيب بن عبد الرحمن الخزرجي عن شعبة بن الحجاج عن يحيى القطان عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","حديث أبي سعيد بن المعلى"
"6840","[12/226]      حَدِيثُ عَمِّ  جَارِيَةَ بْنِ قُدَامَةَ  1 - (  6838  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْأَحْنَفِ بْنِ قَيْسٍ ،  عَنْ  جَارِيَةَ بْنِ قُدَامَةَ ،  أَخْبَرَنِي  عَمُّ أَبِي ، أَنَّهُ قَالَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا رَسُولَ اللهِ ، عَلِّمْنِي شَيْئًا يَنْفَعُنِي اللهُ بِهِ وَأَقْلِلْ لَعَلِّي أَعِي مَا تَقُولُ ، قَالَ لَهُ :  لَا تَغْضَبْ  ، فَأَعَادَ عَلَيْهِ مِرَارًا ، يَقُولُ : لَا تَغْضَبْ  .","","Musnad Abi Ya'la al-Mawsili 6838","","أحد الصحابة عن جارية بن قدامة بن زهير التميمي عن الأحنف بن قيس السعدي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أبو معاوية الضرير عن سريج بن يونس المروزي عن أبو يعلى الموصلي","حديث عم جارية بن قدامة"
"6841","[12/227]             [12/228]             [12/229]      حَدِيثُ رَجُلٍ مِنْ  خَثْعَمَ  لَمْ يُسَمَّ  1 - (  6839  ) -  حَدَّثَنَا  نَافِعُ بْنُ خَالِدٍ الطَّاحِيُّ ،  حَدَّثَنَا  نُوحُ بْنُ قَيْسٍ ،  حَدَّثَنَا  خَالِدُ بْنُ قَيْسٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  رَجُلٍ مِنْ خَثْعَمَ قَالَ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ فِي نَفَرٍ مِنْ أَصْحَابِهِ ، قَالَ : قُلْتُ : أَنْتَ الَّذِي تَزْعُمُ أَنَّكَ رَسُولُ اللهِ ؟ قَالَ : نَعَمْ ، قَالَ : قُلْتُ :  يَا رَسُولَ اللهِ ، أَيُّ الْأَعْمَالِ أَحَبُّ إِلَى اللهِ ؟ قَالَ : إِيمَانٌ بِاللهِ  ، قَالَ : قُلْتُ : يَا رَسُولَ اللهِ ، ثُمَّ  مَهْ  ؟ قَالَ : ثُمَّ صِلَةُ الرَّحِمِ ، قَالَ : قُلْتُ : يَا رَسُولَ اللهِ ، أَيُّ الْأَعْمَالِ أَبْغَضُ إِلَى اللهِ ؟ قَالَ : الْإِشْرَاكُ بِاللهِ ، قَالَ : قُلْتُ : يَا رَسُولَ اللهِ ، ثُمَّ  مَهْ  ؟ قَالَ : ثُمَّ قَطِيعَةُ الرَّحِمِ ،         [12/230]      قَالَ : قُلْتُ : يَا رَسُولَ اللهِ ، ثُمَّ  مَهْ  ؟ قَالَ : ثُمَّ الْأَمْرُ بِالْمُنْكَرِ وَالنَّهْيُ عَنِ الْمَعْرُوفِ  .         [12/231]","","Musnad Abi Ya'la al-Mawsili 6839","","أحد الصحابة عن قتادة بن دعامة عن خالد بن قيس بن رباح الحداني عن نوح بن قيس بن رباح الحداني عن نافع بن خالد الطاحي عن أبو يعلى الموصلي","حديث رجل من خثعم لم يسم"
"6842","حَدِيثُ  مُسْلِمٍ جَدِّ ابْنِ أَبْزَى  1 - (  6840  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ ،  حَدَّثَنَا  أَبُو سَعِيدٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْحَارِثِ بْنِ أَبْزَى قَالَ :  حَدَّثَتْنِي  أُمِّي ،  عَنْ  أَبِيهَا  ،  أَنَّهُ شَهِدَ مَغَانِمَ  حُنَيْنٍ  مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَاسْمُهُ  غُرَابٌ  فَسَمَّاهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  مُسْلِمًا  .         [12/232]","","Musnad Abi Ya'la al-Mawsili 6840","","مسلم القرشي عن رائطة بنت مسلم عن عبد الله بن الحارث بن أبزى المكي عن عبد الرحمن بن عبد الله بن عبيد جردقة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","حديث مسلم جد ابن أبزى"
"6843","حَدِيثُ  قُطْبَةَ  1 - (  6841  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  أَنَّهُ سَمِعَ  عَمَّهُ قُطْبَةَ يَقُولُ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْرَأُ فِي صَلَاةِ الصُّبْحِ         {      وَالنَّخْلَ بَاسِقَاتٍ لَهَا طَلْعٌ نَضِيدٌ         }      .","","Musnad Abi Ya'la al-Mawsili 6841","","قطبة بن مالك الذبيانى عن زياد بن علاقة الثعلبي عن سفيان بن عيينة عن هارون بن معروف المروزي عن أبو يعلى الموصلي","حديث قطبة"
"6844","[12/233]      حَدِيثُ  مَالِكٍ  أَوِ  ابْنِ مَالِكٍ  1 - (  6842  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْجُشَمِيُّ ،  حَدَّثَنَا         [12/234]      يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  عَوْفٌ ،  حَدَّثَنَا  أَبُو الْمِنْهَالِ ،  حَدَّثَنَا  شَهْرُ بْنُ حَوْشَبٍ قَالَ :  كَانَ مِنَّا رَجُلٌ ، مَعْشَرَ  الْأَشْعَرِيِّينَ  ، قَدْ صَحِبَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَشَهِدَ مَعَهُ مَشَاهِدَهُ الْحَسَنَةَ الْجَمِيلَةَ ،  مَالِكٌ ، أَوِ ابْنُ مَالِكٍ  ،  شَكَّ  عَوْفٌ  ، فَأَتَانَا يَوْمًا ، فَقَالَ : أَتَيْتُكُمْ لِأُعَلِّمَكُمْ وَأُصَلِّيَ بِكُمْ ، كَمَا كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي بِنَا ، فَدَعَا بِجَفْنَةٍ عَظِيمَةٍ فَجَعَلَ فِيهَا مِنَ الْمَاءِ ، ثُمَّ دَعَا بِإِنَاءٍ صَغِيرٍ ، فَجَعَلَ  يُفْرِغُ  فِي الْإِنَاءِ الصَّغِيرِ عَلَى أَيْدِينَا ، ثُمَّ قَالَ : أَسْبِغُوا الْآنَ الْوُضُوءَ ، فَتَوَضَّأَ  الْقَوْمُ  ، ثُمَّ قَامَ فَصَلَّى بِنَا صَلَاةً تَامَّةً وَجِيزَةً ، فَلَمَّا انْصَرَفَ قَالَ : قَالَ لَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قَدْ عَلِمْتُ أَنَّ أَقْوَامًا لَيْسُوا بِأَنْبِيَاءَ وَلَا شُهَدَاءَ ، يَغْبِطُهُمُ الْأَنْبِيَاءُ وَالشُّهَدَاءُ بِمَكَانِهِمْ مِنَ اللهِ  ، فَقَالَ  رَجُلٌ  مِنْ حَجْرَةِ  الْقَوْمِ  أَعْرَابِيٌّ ، قَالَ : وَكَانَ يُعْجِبُنَا إِذَا شَهِدْنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَكُونَ فِينَا الْأَعْرَابِيُّ ، لِأَنَّهُمْ يَجْتَرِئُونَ أَنْ يَسْأَلُوا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَا نَجْتَرِئُ ، فَقَالَ : يَا رَسُولَ اللهِ ، سَمِّهِمْ لَنَا ؟ قَالَ : فَرَأَيْنَا وَجْهَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَتَهَلَّلُ ، قَالَ : هُمْ نَاسٌ مِنْ قَبَائِلَ شَتَّى يَتَحَابُّونَ فِي اللهِ ، وَاللهِ إِنَّ وُجُوهَهُمْ لَنُورٌ ، وَإِنَّهُمْ لَعَلَى نُورٍ ، مَا يَخَافُونَ إِذَا خَافَ النَّاسُ ، وَلَا يَحْزَنُونَ إِذَا حَزِنُوا  .","","Musnad Abi Ya'la al-Mawsili 6842","","أبو مالك الأشعري عن شهر بن حوشب عن سيار بن سلامة الرياحي عن عوف بن أبي جميلة عن يزيد بن زريع العيشي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","حديث مالك أو ابن مالك"
"6845","[12/235]      حَدِيثُ  عَمْرِو بْنِ مَالِكٍ الرُّؤَاسِيِّ  1 - (  6843  ) -  حَدَّثَنَا  عُثْمَانُ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  شَيْخٍ يُقَالُ لَهُ طَارِقٌ ،  عَنْ  عَمْرِو بْنِ مَالِكٍ الْأَوْسِيِّ قَالَ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [12/236]      فَقُلْتُ : يَا رَسُولَ اللهِ ، ارْضَ عَنِّي ، فَأَعْرَضَ عَنِّي ثَلَاثًا  ، قَالَ : يَا رَسُولَ اللهِ ، وَاللهِ إِنَّ الرَّبَّ لَيُتَرَضَّى ، قَالَ : فَرَضِيَ عَنِّي  .","","Musnad Abi Ya'la al-Mawsili 6843","","عمرو بن مالك بن قيس الكوفي عن طارق عن الجراح بن مليح الرؤاسي والد وكيع عن وكيع بن الجراح عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","حديث عمرو بن مالك الرؤاسي"
"6846","[12/237]      حَدِيثُ  عَبْدِ الرَّحْمَنِ بْنِ حُبْشِيٍّ  1 - (  6844  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ الضُّبَعِيُّ ،  حَدَّثَنَا  أَبُو التَّيَّاحِ قَالَ :  سَأَلَ  رَجُلٌ عَبْدَ الرَّحْمَنِ بْنَ حُبْشِيٍّ ، وَكَانَ شَيْخًا كَبِيرًا قَالَ :  يَا  ابْنَ حُبْشِيٍّ  كَيْفَ صَنَعَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ كَادَتْهُ         [12/238]      الشَّيَاطِينُ ؟  قَالَ : انْحَدَرَتِ الشَّيَاطِينُ مِنَ الْأَوْدِيَةِ وَالشِّعَابِ يُرِيدُونَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِيهِمْ شَيْطَانٌ مَعَهُ شُعْلَةٌ مِنْ نَارٍ يُرِيدُ أَنْ  يَحْرِقَ  بِهَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا رَآهُمْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَزِعَ ، فَجَاءَهُ  جِبْرِيلُ  ، فَقَالَ : يَا  مُحَمَّدُ  ، قُلْ ، قَالَ : مَا أَقُولُ ؟ قَالَ : قُلْ : أَعُوذُ  بِكَلِمَاتِ  اللهِ  التَّامَّاتِ  الَّتِي لَا يُجَاوِزُهُنَّ بَرٌّ وَلَا فَاجِرٌ ، مِنْ شَرِّ مَا نَزَلَ مِنَ السَّمَاءِ ، وَمِنْ شَرِّ مَا يَعْرُجُ فِيهَا ، وَمِنْ شَرِّ مَا فِي الْأَرْضِ ، وَمِنْ شَرِّ مَا يَخْرُجُ مِنْهَا ، وَمِنْ شَرِّ اللَّيْلِ وَالنَّهَارِ ، وَمِنْ شَرِّ كُلِّ طَارِقٍ إِلَّا طَارِقٍ يَطْرُقُ بِخَيْرٍ يَا رَحْمَنُ ، قَالَ : فَطُفِئَتْ نَارُ الشَّيْطَانِ ، وَهَزَمَهُمُ اللهُ عَزَّ وَجَلَّ  .","","Musnad Abi Ya'la al-Mawsili 6844","","عبد الرحمن بن خنبش التميمي عن يزيد بن حميد الضبعي عن جعفر بن سليمان الضبعي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","حديث عبد الرحمن بن حبشي"
"6847","[12/239]      حَدِيثُ  أَبِي زَيْدٍ عَمْرِو بْنِ أَخْطَبَ  1 - (  6845  ) -  حَدَّثَنَا  عَمْرُو بْنُ الضَّحَّاكِ بْنِ مَخْلَدٍ ،  حَدَّثَنَا  أَبِي  ،  حَدَّثَنَا  عَزْرَةُ بْنُ ثَابِتٍ ،  حَدَّثَنَا  عِلْبَاءُ بْنُ أَحْمَرَ الْيَشْكُرِيُّ ،  حَدَّثَنَا  أَبُو زَيْدٍ قَالَ :  صَلَّى بِنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الصُّبْحَ ، ثُمَّ صَعِدَ الْمِنْبَرَ فَخَطَبَ حَتَّى حَضَرَتِ الظُّهْرُ  ، ثُمَّ نَزَلَ فَصَلَّى ، ثُمَّ         [12/240]      صَعِدَ الْمِنْبَرَ فَخَطَبَنَا حَتَّى حَضَرَتِ الْعَصْرُ ، ثُمَّ نَزَلَ فَصَلَّى ، ثُمَّ صَعِدَ الْمِنْبَرَ فَخَطَبَنَا حَتَّى غَابَتِ الشَّمْسُ ، فَحَدَّثَنَا بِمَا كَانَ وَبِمَا هُوَ كَائِنٌ ، فَأَعْلَمُنَا أَحْفَظُنَا  .","","Musnad Abi Ya'la al-Mawsili 6845","","عمرو بن أخطب بن رفاعة الأعرج عن علباء بن أحمر اليشكري عن عزرة بن ثابت بن أبي زيد الأنصاري عن أبو عاصم النبيل عن عمرو بن الضحاك بن مخلد عن أبو يعلى الموصلي","حديث أبي زيد عمرو بن أخطب"
"6848","2 - (  6846  ) -  حَدَّثَنَا  عَمْرُو بْنُ الضَّحَّاكِ ،  حَدَّثَنَا  أَبِي  ،  حَدَّثَنَا  عَزْرَةُ بْنُ ثَابِتٍ ،  حَدَّثَنَا  عِلْبَاءُ بْنُ أَحْمَرَ ،  حَدَّثَنَا  أَبُو زَيْدٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ادْنُ مِنِّي فَامْسَحْ ظَهْرِي  ، قَالَ : فَكَشَفْتُ عَنْ ظَهْرِهِ ، فَمَسَحْتُ ظَهْرَهُ ، قَالَ : وَجَعَلْتُ الْخَاتَمَ بَيْنَ أَصَابِعِي فَغَمَزْتُهَا ، قَالَ : قِيلَ : وَمَا الْخَاتَمُ ؟ قَالَ : شَعَرٌ مُجْتَمِعٌ عَلَى كَتِفِهِ  .","","Musnad Abi Ya'la al-Mawsili 6846","","عمرو بن أخطب بن رفاعة الأعرج عن علباء بن أحمر اليشكري عن عزرة بن ثابت بن أبي زيد الأنصاري عن أبو عاصم النبيل عن عمرو بن الضحاك بن مخلد عن أبو يعلى الموصلي","حديث أبي زيد عمرو بن أخطب"
"6849","3 - (  6847  ) -  حَدَّثَنَا  عَمْرُو بْنُ الضَّحَّاكِ ،  حَدَّثَنَا  أَبِي  ،  حَدَّثَنَا  عَزْرَةُ بْنُ ثَابِتٍ ،  حَدَّثَنَا  عِلْبَاءُ بْنُ أَحْمَرَ ،         [12/241]      عَنْ  أَبِي زَيْدٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَسَحَ وَجْهَهُ ، وَدَعَا لَهُ بِالْجَمَالِ  .","","Musnad Abi Ya'la al-Mawsili 6847","","عمرو بن أخطب بن رفاعة الأعرج عن علباء بن أحمر اليشكري عن عزرة بن ثابت بن أبي زيد الأنصاري عن أبو عاصم النبيل عن عمرو بن الضحاك بن مخلد عن أبو يعلى الموصلي","حديث أبي زيد عمرو بن أخطب"
"6850","[12/242]      حَدِيثُ  أَشَجِّ عَبْدِ الْقَيْسِ  1 - (  6848  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ ،  حَدَّثَنَا  هُشَيْمٌ ،  أَخْبَرَنَا  يُونُسُ بْنُ عُبَيْدٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرَةَ ،  عَنِ  الْأَشَجِّ أَشَجِّ عَبْدِ الْقَيْسِ قَالَ :  قَالَ لِيَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ فِيكَ  لَخُلُقَيْنِ  يُحِبُّهُمَا اللهُ  ، قُلْتُ : مَا هُمَا يَا رَسُولَ اللهِ ؟ قَالَ :  الْحِلْمُ وَالْحَيَاءُ ، أَوِ الْحِلْمُ وَالْأَنَاةُ  ، قُلْتُ : أَقَدِيمًا كَانَا فِيَّ أَوْ حَدِيثًا ؟ قَالَ : بَلْ قَدِيمٌ ، قُلْتُ : الْحَمْدُ لِلهِ الَّذِي  جَبَلَنِي  عَلَى  خُلُقَيْنِ  يُحِبُّهُمَا  .         [12/243]","","Musnad Abi Ya'la al-Mawsili 6848","","المنذر بن عائذ الأشج عن عبد الرحمن بن أبي بكرة الثقفي عن يونس بن عبيد عن هشيم بن بشير عن محمد بن الصباح الدولابي عن أبو يعلى الموصلي","حديث أشج عبد القيس"
"6851","2 - (  6849  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَرْزُوقٍ ،  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  حَدَّثَنَا  الْحَجَّاجُ بْنُ حَسَّانَ التَّيْمِيُّ قَالَ :  حَدَّثَنَا  الْمُثَنَّى الْعَبْدِيُّ أَبُو مُنَازِلَ أَحَدُ بَنِي غَنْمٍ ،  عَنِ  الْأَشَجِّ الْعَصَرِيِّ ،  أَنَّهُ أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي رُفْقَةٍ مِنْ  عَبْدِ الْقَيْسِ  لِيَزُورَهُ فَأَقْبَلُوا ، فَلَمَّا قَدِمُوا ، رَفَعَ لَهُمُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَنَاخُوا رِكَابَهُمْ وَابْتَدَرَهُ  الْقَوْمُ  وَلَمْ يَلْبَسُوا إِلَّا ثِيَابَ سَفَرِهِمْ ، وَأَقَامَ  الْعَصَرِيُّ  يَعْقِلُ رِكَابَ أَصْحَابِهِ وَبَعِيرَهُ ، ثُمَّ أَخْرَجَ ثِيَابَهُ مِنْ عَيْبَتِهِ ، وَذَلِكَ بِعَيْنِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ أَقْبَلَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [12/244]      فَسَلَّمَ عَلَيْهِ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ فِيكَ  لَخُلُقَيْنِ  يُحِبُّهُمَا اللهُ وَرَسُولُهُ  ، قَالَ : مَا هُمَا يَا رَسُولَ اللهِ ؟ قَالَ : الْأَنَاةُ وَالْحِلْمُ ، قَالَ : شَيْءٌ  جُبِلْتُ  عَلَيْهِ أَوْ شَيْءٌ أَتَخَلَّقُهُ ؟ قَالَ : لَا ، بَلْ  جُبِلْتَ  عَلَيْهِ ، قَالَ : الْحَمْدُ لِلهِ ، قَالَ : مَعْشَرَ  عَبْدِ الْقَيْسِ  مَا لِي أَرَى وُجُوهَكُمْ قَدْ تَغَيَّرَتْ ؟ قَالُوا : يَا نَبِيَّ اللهِ ، نَحْنُ بِأَرْضٍ وَخِمَةٍ ، وَكُنَّا نَتَّخِذُ مِنْ هَذِهِ الْأَنْبِذَةِ مَا يَقْطَعُ اللُّحْمَانَ فِي بُطُونِنَا ، فَلَمَّا نُهِينَا عَنِ الظُّرُوفِ ، فَذَلِكَ الَّذِي تَرَى فِي وُجُوهِنَا ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِنَّ الظُّرُوفَ لَا تُحِلُّ وَلَا تُحَرِّمُ ، وَلَكِنْ كُلُّ مُسْكِرٍ حَرَامٌ ، وَلَيْسَ أَنْ تَجْلِسُوا فَتَشْرَبُوا حَتَّى إِذَا  ثَمِلَتِ  الْعُرُوقُ تَفَاخَرْتُمْ فَوَثَبَ الرَّجُلُ عَلَى ابْنَ عَمِّهِ فَضَرَبَهُ بِالسَّيْفِ ، فَتَرَكَهُ أَعْرَجَ ، قَالَ : وَهُوَ يَوْمَئِذٍ فِي  الْقَوْمِ  الْأَعْرَجُ الَّذِي أَصَابَهُ ذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 6849","","المنذر بن عائذ الأشج عن المثنى بن مازن الغنمي عن حجاج بن حسان القيسي عن روح بن عبادة القيسي عن محمد بن محمد بن مرزوق الباهلي عن أبو يعلى الموصلي","حديث أشج عبد القيس"
"6852","[12/245]      حَدِيثُ جَدِّ هُودٍ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  1 - (  6850  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ صُدْرَانَ أَبُو جَعْفَرٍ ،  حَدَّثَنَا  طَالِبُ بْنُ حُجَيْرٍ الْعَبْدِيُّ ،  حَدَّثَنَا  هُودٌ الْعَصَرِيُّ ،         [12/246]      عَنْ  جَدِّهِ  قَالَ :  بَيْنَمَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُحَدِّثُ أَصْحَابَهُ إِذْ قَالَ : يَطْلُعُ عَلَيْكُمْ مِنْ هَذَا الْوَجْهِ رَكْبٌ مِنْ خَيْرِ  أَهْلِ الْمَشْرِقِ  ، فَقَامَ  عُمَرُ بْنُ الْخَطَّابِ  ، فَتَوَجَّهَ فِي ذَلِكَ الْوَجْهِ فَلَقِيَ ثَلَاثَةَ عَشَرَ رَاكِبًا ، فَرَحَّبَ وَقَرَّبَ ، وَقَالَ : مَنِ  الْقَوْمُ  ؟ قَالُوا : قَوْمٌ مِنْ  عَبْدِ الْقَيْسِ  ، قَالَ : فَمَا أَقْدَمَكُمْ هَذِهِ الْبِلَادَ ؟ التِّجَارَةُ ؟ قَالُوا : لَا ، قَالَ : فَتَبِيعُونَ سُيُوفَكُمْ هَذِهِ ؟ قَالُوا : لَا ، قَالَ : فَلَعَلَّكُمْ إِنَّمَا قَدِمْتُمْ فِي طَلَبِ هَذَا الرَّجُلِ ؟ قَالُوا : أَجَلْ ، فَمَشَى مَعَهُمْ يُحَدِّثُهُمْ حَتَّى نَظَرَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ لَهُمْ : هَذَا صَاحِبُكُمُ الَّذِي تَطْلُبُونَ ، فَرَمَى  الْقَوْمُ  بِأَنْفُسِهِمْ عَنْ رِحَالِهِمْ ، فَمِنْهُمْ مَنْ سَعَى سَعْيًا ، وَمِنْهُمْ مَنْ هَرْوَلَ ، وَمِنْهُمْ مَنْ مَشَى حَتَّى أَتَوْا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَخَذُوا بِيَدِهِ يُقَبِّلُونَهَا ، وَقَعَدُوا إِلَيْهِ ، وَبَقِيَ  الْأَشَجُّ  وَهُوَ أَصْغَرُ  الْقَوْمِ  ، فَأَنَاخَ الْإِبِلَ وَعَقَلَهَا ، وَجَمَعَ مَتَاعَ  الْقَوْمِ  ، ثُمَّ أَقْبَلَ يَمْشِي عَلَى تُؤَدَةٍ حَتَّى أَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَخَذَ بِيَدِهِ فَقَبَّلَهَا ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  فِيكَ  خَصْلَتَانِ  يُحِبُّهُمَا اللهُ وَرَسُولُهُ  ، قَالَ : وَمَا هُمَا يَا نَبِيَّ اللهِ ؟ قَالَ : الْأَنَاةُ وَالتُّؤَدَةُ ، قَالَ : أَجَبْلًا  جُبِلْتُ  عَلَيْهِ أَوْ تَخَلُّقًا مِنِّي ؟ قَالَ : بَلْ جَبْلٌ ، فَقَالَ : الْحَمْدُ لِلهِ الَّذِي  جَبَلَنِي  عَلَى مَا يُحِبُّ اللهُ وَرَسُولُهُ ، وَأَقْبَلَ  الْقَوْمُ  قِبَلَ تَمَرَاتٍ لَهُمْ يَأْكُلُونَهَا ، فَجَعَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [12/247]      يُسَمِّي لَهُمْ هَذَا كَذَا ، وَهَذَا كَذَا ، قَالُوا : أَجَلْ يَا رَسُولَ اللهِ ، مَا نَحْنُ بِأَعْلَمَ بِأَسْمَائِهَا مِنْكَ ، قَالَ : أَجَلْ ، فَقَالُوا لِرَجُلٍ مِنْهُمْ : أَطْعِمْنَا مِنْ بَقِيَّةِ الَّذِي بَقِيَ فِي  نَوْطِكَ ،  فَقَامَ فَأَتَاهُ بِالْبَرْنِيِّ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : هَذَا الْبَرْنِيُّ ، أَمَا إِنَّهُ مِنْ خَيْرِ تَمَرَاتِكُمْ ، إِنَّمَا هُوَ دَوَاءٌ ، وَلَا دَاءَ فِيهِ  .","","Musnad Abi Ya'la al-Mawsili 6850","","مزيدة بن جابر العبدي عن هود بن عبد الله بن سعد العبدي عن طالب بن حجير العبدي عن محمد بن إبراهيم بن صدران الأزدي عن أبو يعلى الموصلي","حديث جد هود عن النبي - صلى الله عليه وسلم"
"6853","[12/248]      حَدِيثُ  عُمَيْرٍ الْعَبْدِيِّ  1 - (  6851  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  ابْنُ         [12/249]      فُضَيْلٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنِ  الْأَشْعَثِ بْنِ عُمَيْرٍ الْعَبْدِيِّ ،  عَنْ  أَبِيهِ  قَالَ :  أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَفْدُ  عَبْدِ الْقَيْسِ  ، فَلَمَّا أَرَادُوا الِانْصِرَافَ ، قَالُوا : قَدْ حَفِظْتُمْ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كُلَّ شَيْءٍ سَمِعْتُمُوهُ مِنْهُ ، فَاسْأَلُوهُ عَنِ النَّبِيذِ ، فَأَتَوْهُ ، فَقَالُوا : يَا رَسُولَ اللهِ ، إِنَّا فِي أَرْضٍ وَخِمَةٍ لَا يُصْلِحُنَا فِيهَا إِلَّا الشَّرَابُ ، قَالَ : وَمَا شَرَابُكُمْ ؟ قَالُوا : النَّبِيذُ ، قَالَ : فِي أَيِّ شَيْءٍ شَرِبْتُمُوهُ ؟ قَالُوا : فِي  النَّقِيرِ  ، فَقَالَ : لَا تَشْرَبُوا فِي  النَّقِيرِ  ، فَخَرَجُوا مِنْ عِنْدِهِ ، قَالُوا : وَاللهِ لَا يُصَالِحُنَا قَوْمُنَا عَلَى هَذَا ، فَرَجَعُوا فَسَأَلُوا ، فَقَالَ لَهُمْ مِثْلَ ذَلِكَ ، فَقَالَ :  لَا تَشْرَبُوا فِي  النَّقِيرِ  ، فَيَضْرِبَ الرَّجُلُ مِنْكُمُ ابْنَ عَمِّهِ ضَرْبَةً لَا يَزَالُ مِنْهَا أَعْرَجَ إِلَى يَوْمِ الْقِيَامَةِ  ، قَالَ : فَضَحِكُوا ، فَقَالَ : أَيَّ شَيْءٍ تَضْحَكُونَ ؟ قَالُوا : يَا رَسُولَ اللهِ ، وَالَّذِي بَعَثَكَ بِالْحَقِّ ، لَقَدْ شَرِبْنَا فِي  نَقِيرٍ  لَنَا ، فَقَامَ بَعْضُنَا إِلَى بَعْضٍ فَضَرَبَهُ ضَرْبَةً هُوَ أَعْرَجُ مِنْهَا إِلَى يَوْمِ الْقِيَامَةِ  .","","Musnad Abi Ya'la al-Mawsili 6851","","عمير بن جودان العبدي عن أشعث بن عمير العبدي عن عطاء بن السائب عن محمد بن فضيل بن غزوان عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث عمير العبدي"
"6854","[12/250]      حَدِيثُ  فَرْوَةَ بْنِ مُسَيْكٍ  1 - (  6852  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  أَبُو         [12/251]      أُسَامَةَ ، قَالَ :  حَدَّثَنِي  الْحَسَنُ بْنُ الْحَكَمِ النَّخَعِيُّ ،  حَدَّثَنَا  أَبُو سَبْرَةَ النَّخَعِيُّ  عَنْ  فَرْوَةَ بْنِ مُسَيْكٍ الْغُطَيْفِيِّ قَالَ :  أَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقُلْتُ : يَا رَسُولَ اللهِ أَلَا أُقَاتِلُ بِمَنْ أَقْبَلَ مِنْ قَوْمِي  ... وَذَكَرَ الْحَدِيثَ .","","Musnad Abi Ya'la al-Mawsili 6852","","فروة بن مسيك الغطيفي عن أبو سبرة النخعي عن الحسن بن الحكم النخعي عن حماد بن أسامة القرشي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","حديث فروة بن مسيك"
"6855","[12/252]      حَدِيثُ  الضَّحَّاكِ بْنِ أَبِي جَبِيرَةَ  1 - (  6853  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ، وَإِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،         [12/253]      وَنُسْخَتُهُ مِنْ حَدِيثِ  إِبْرَاهِيمَ  ، قَالَا :  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  الضَّحَّاكِ بْنِ أَبِي جَبِيرَةَ قَالَ :  كَانَتْ لَهُمْ أَلْقَابٌ فِي الْجَاهِلِيَّةِ ، فَدَعَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَجُلًا بِلَقَبِهِ  ، فَقِيلَ : يَا رَسُولَ اللهِ ، إِنَّهُ يَكْرَهُهُ ، فَأَنْزَلَ اللهُ :         {      وَلا تَنَابَزُوا بِالأَلْقَابِ         }      إِلَى آخِرِ الْآيَةِ  .","","Musnad Abi Ya'la al-Mawsili 6853","","أبو جبيرة بن الضحاك الأنصاري عن الشعبي عن داود بن أبي هند عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","حديث الضحاك بن أبي جبيرة"
"6856","[12/254]             [12/255]      حَدِيثُ  خَرَشَةَ  1 - (  6854  ) -  حَدَّثَنَا  أَبُو طَالِبٍ عَبْدُ الْجَبَّارِ بْنُ عَاصِمٍ ،         [12/256]      حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  ثَابِتِ بْنِ الْعَجْلَانِ الْأَنْصَارِيِّ ، أَنَّ أَبَا كَثِيرٍ الْمُحَارِبِيَّ  حَدَّثَهُ  ،         [12/257]      أَنَّ خَرَشَةَ  حَدَّثَهُ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّهَا سَتَكُونُ بَعْدِي فِتَنٌ النَّائِمُ فِيهَا خَيْرٌ مِنَ الْيَقْظَانِ ، وَالْقَاعِدُ فِيهَا خَيْرٌ مِنَ الْقَائِمِ  ، وَالْقَائِمُ فِيهَا خَيْرٌ مِنَ الْمَاشِي ، فَمَنْ أَتَتْ عَلَيْهِ فَلْيَأْخُذْ بِسَيْفِهِ ثُمَّ لِيَمْشِ إِلَى صَفَاةٍ فَيَضْرِبَهَا بِهِ حَتَّى يَنْكَسِرَ ، ثُمَّ لِيَضْطَجِعْ لَهَا حَتَّى تُجْلَى عَلَى مَا انْجَلَتْ عَلَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 6854","","خرشة بن الحر الفزاري عن أبو كثير المحاربي عن ثابت بن عجلان السلمي عن إسماعيل بن عياش الأحول عن عبد الجبار بن عاصم الخراساني عن أبو يعلى الموصلي","حديث خرشة"
"6857","[12/258]      حَدِيثُ  نُعَيْمِ بْنِ هَمَّارٍ الْغَطَفَانِيِّ  1 - (  6855  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  بَحِيرِ بْنِ سَعْدٍ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنْ  كَثِيرِ بْنِ مُرَّةَ ،  عَنْ  نُعَيْمِ بْنِ هَمَّارٍ ،  أَنَّهُ سَمِعَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَجَاءَهُ  رَجُلٌ  ، فَقَالَ : أَيُّ الشُّهَدَاءِ أَفْضَلُ ؟ قَالَ :  الَّذِينَ يُلْقَوْنَ فِي الصَّفِّ فَلَا يَقْلِبُونَ وُجُوهَهُمْ حَتَّى يُقْتَلُوا  ، أُولَئِكَ  يَتَلَبَّطُونَ  فِي الْغُرَفِ         [12/259]      الْعُلْيَا مِنَ الْجَنَّةِ يَضْحَكُ إِلَيْهِمْ رَبُّكَ ، وَإِذَا ضَحِكَ فِي مَوْطِنٍ فَلَا حِسَابَ عَلَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 6855","","نعيم بن همار الغطفاني عن كثير بن مرة الرهاوي عن خالد بن معدان عن بحير بن سعد عن إسماعيل بن عياش الأحول عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","حديث نعيم بن همار الغطفاني"
"6858","[12/260]      حَدِيثُ  عَطِيَّةَ بْنِ بُسْرٍ  1 - (  6856  ) -  حَدَّثَنَا  أَبُو طَالِبٍ عَبْدُ الْجَبَّارِ بْنُ عَاصِمٍ ،  حَدَّثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  مُعَاوِيَةَ بْنِ يَحْيَى ،  عَنْ  سُلَيْمَانَ بْنِ مُوسَى ،  عَنْ  مَكْحُولٍ ،  عَنْ  غُضَيْفِ بْنِ الْحَارِثِ ،  عَنْ  عَطِيَّةَ بْنِ بُسْرٍ الْمَازِنِيِّ قَالَ :  جَاءَ  عَكَّافُ بْنُ وَدَاعَةَ الْهِلَالِيُّ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا  عَكَّافُ  ، أَلَكَ زَوْجَةٌ ؟  قَالَ : لَا ، قَالَ : وَلَا جَارِيَةٌ ؟ قَالَ : لَا ، قَالَ : وَأَنْتَ صَحِيحٌ مُوسِرٌ ؟ قَالَ : نَعَمْ ، وَالْحَمْدُ لِلهِ ، قَالَ : فَأَنْتَ إِذًا مِنْ إِخْوَانِ الشَّيَاطِينِ : إِمَّا أَنْ تَكُونَ مِنْ رُهْبَانِ النَّصَارَى فَأَنْتَ مِنْهُمْ ، وَإِمَّا أَنْ تَكُونَ مِنَّا فَاصْنَعْ كَمَا         [12/261]      نَصْنَعُ ، فَإِنَّ مِنْ سُنَّتِنَا النِّكَاحَ ، شِرَارُكُمْ عُزَّابُكُمْ ، وَأَرَاذِلُ أَمْوَاتِكُمْ ، عُزَّابُكُمْ آبَاءٌ لِلشَّيَاطِينِ تَمَرَّسُونَ ، مَا لَهُمْ فِي نَفْسِي سِلَاحٌ أَبْلَغُ فِي الصَّالِحِينَ مِنَ الرِّجَالِ وَالنِّسَاءِ إِلَّا الْمُتَزَوِّجُونَ ، أُولَئِكَ الْمُطَهَّرُونَ الْمُبَرَّؤُونَ مِنَ  الْخَنَا  ، وَيْحَكَ يَا  عَكَّافُ  ! إِنَّهُنَّ صَوَاحِبُ  دَاوُدَ  ، وَصَوَاحِبُ  أَيُّوبَ  ، وَصَوَاحِبُ  يُوسُفَ  ، وَصَوَاحِبُ  كُرْسُفَ  ، قَالَ : فَقَالَ : وَمَا  الْكُرْسُفُ  يَا رَسُولَ اللهِ ؟ قَالَ : رَجُلٌ كَانَ فِي  بَنِي إِسْرَائِيلَ  ، عَلَى سَاحِلٍ مِنْ سَوَاحِلِ الْبَحْرِ ، يَصُومُ النَّهَارَ وَيَقُومُ اللَّيْلَ ، لَا يَفْتُرُ مِنْ صَلَاةٍ وَلَا صِيَامٍ ، ثُمَّ كَفَرَ بَعْدَ ذَلِكَ بِاللهِ الْعَظِيمِ فِي سَبَبِ امْرَأَةٍ عَشِقَهَا ، فَتَرَكَ مَا كَانَ عَلَيْهِ مِنْ عِبَادَةِ رَبِّهِ فَتَدَارَكَهُ اللهُ بِمَا سَلَفَ مِنْهُ ، فَتَابَ عَلَيْهِ ، وَيْحَكَ يَا  عَكَّافُ  تَزَوَّجْ ، فَإِنَّكَ مِنَ  الْمُذَبْذَبِينَ  ، قَالَ : فَقَالَ  عَكَّافٌ  : يَا رَسُولَ اللهِ ، لَا أَبْرَحُ حَتَّى تُزَوِّجَنِي مَنْ شِئْتَ ، قَالَ : فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : فَقَدْ زَوَّجْتُكَ عَلَى اسْمِ         [12/262]      اللهِ وَالْبَرَكَةِ  كَرِيمَةَ بِنْتَ كُلْثُومٍ الْحِمْيَرِيِّ  .","","Musnad Abi Ya'la al-Mawsili 6856","","عطية بن بسر المازني عن غضيف بن الحارث عن مكحول بن أبي مسلم عن سليمان بن موسى الأشدق عن معاوية بن يحيى الصدفي عن بقية بن الوليد عن عبد الجبار بن عاصم الخراساني عن أبو يعلى الموصلي","حديث عطية بن بسر"
"6859","[12/263]      حَدِيثُ  الْمُسْتَوْرِدِ بْنِ شَدَّادٍ  1 - (  6857  ) -  حَدَّثَنَا  كَامِلُ بْنُ طَلْحَةَ الْجَحْدَرِيُّ ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  حُدَيْجِ بْنِ أَبِي عَمْرٍو قَالَ :  سَمِعْتُ  الْمُسْتَوْرِدَ بْنَ شَدَّادٍ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لِكُلِّ أُمَّةٍ أَجَلٌ ، وَإِنَّ أَجَلَ أُمَّتِي مِائَةُ سَنَةٍ  ، فَإِذَا مَرَّ عَلَى أُمَّتِي مِائَةُ سَنَةٍ أَتَاهَا مَا وَعَدَهَا اللهُ عَزَّ وَجَلَّ  .         [12/264]","","Musnad Abi Ya'la al-Mawsili 6857","","المستورد بن شداد الفهري عن حديج بن أبي عمرو المصري عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","حديث المستورد بن شداد"
"6860","2 - (  6858  ) -  حَدَّثَنَا  عَمْرُو بْنُ الضَّحَّاكِ ،  حَدَّثَنَا  أَبِي  ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ،  قَالَ  سُلَيْمَانُ بْنُ مُوسَى :  حَدَّثَنَا  وَقَّاصُ بْنُ رَبِيعَةَ ، أَنَّ الْمُسْتَوْرِدَ  حَدَّثَهُمْ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ أَكَلَ بِرَجُلٍ أَكْلَةً ، فَإِنَّ اللهَ يُطْعِمُهُ مِثْلَهَا مِنْ  جَهَنَّمَ  ، فَإِنْ كُسِيَ بِرَجُلٍ ثَوْبًا ، فَإِنَّ اللهَ يَكْسُوهُ مِثْلَهُ مِنْ  جَهَنَّمَ ،  وَمَنْ قَامَ بِرَجُلٍ مَقَامَ  سُمْعَةٍ  ، فَإِنَّ اللهَ يَقُومُ بِهِ مَقَامَ  سُمْعَةٍ  وَرِيَاءٍ يَوْمَ الْقِيَامَةِ  .","","Musnad Abi Ya'la al-Mawsili 6858","","المستورد بن شداد الفهري عن وقاص بن ربيعة العنسي عن سليمان بن موسى الأشدق عن ابن جريج عن أبو عاصم النبيل عن عمرو بن الضحاك بن مخلد عن أبو يعلى الموصلي","حديث المستورد بن شداد"
"6861","[12/265]      حَدِيثُ رَجُلٍ مِنْ  جُذَامٍ  يُقَالُ لَهُ :  عَدِيٌّ  1 - (  6859  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ، وَالْعَبَّاسُ بْنُ الْوَلِيدِ ، وَنَسَخْتُهُ مِنْ حَدِيثِ  عَبْدِ الْأَعْلَى  ، قَالَا :  حَدَّثَنَا  وُهَيْبٌ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ حَرْمَلَةَ قَالَ :  حَدَّثَنِي  رَجُلٌ مِنْهُمْ يُقَالُ لَهُ : عَدِيٌّ ، كَانَ بَيْنَهُ وَبَيْنَ امْرَأَتَيْنِ جِوَارٌ ، فَرَمَى إِحْدَاهُمَا بِحَجَرٍ فَقَتَلَهَا ، فَرَكِبَ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ  بِتَبُوكَ  ، فَسَأَلَهُ عَنْ  شَأْنِ  الْمَرْأَةِ الْمَقْتُولَةِ ، فَقَالَ : تَعْقِلُهَا وَلَا تَرِثُهَا ، قَالَ  عَدِيٌّ  : فَكَأَنِّي أَنْظُرُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى نَاقَةٍ         [12/266]      حَمْرَاءَ  جَدْعَاءَ  ، فَقَالَ :  أَيُّهَا النَّاسُ ، إِنَّمَا الْأَيْدِي ثَلَاثٌ : يَدُ اللهِ هِيَ  الْعُلْيَا  ، وَيَدُ الْمُعْطِي الْوُسْطَى ، وَيَدُ الْمُعْطَى السُّفْلَى  ، فَتَعَفَّفُوا وَلَوْ بِحُزَمِ حَطَبٍ ، ثُمَّ رَفَعَ يَدَيْهِ ، فَقَالَ : اللَّهُمَّ بَلَّغْتُ  .","","Musnad Abi Ya'la al-Mawsili 6859","","عدي بن زيد الجذامي عن عبد الرحمن بن حرملة الأسلمي عن وهيب بن خالد الكرابيسي عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","حديث رجل من جذام يقال له عدي"
"6862","[12/267]      حَدِيثُ  مَعْقِلِ بْنِ أَبِي مَعْقِلٍ الْأَسَدِيِّ  1 - (  6860  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ،  حَدَّثَنَا         [12/268]      وُهَيْبٌ ،  حَدَّثَنَا  عَمْرُو بْنُ يَحْيَى ،  عَنْ  أَبِي زَيْدٍ ،  عَنْ  مَعْقِلِ بْنِ أَبِي مَعْقِلٍ الْأَسَدِيِّ قَالَ :  قِيلَ : يَا رَسُولَ اللهِ ، إِنَّ  أُمَّ مَعْقِلٍ  حَزِنَتْ حِينَ فَاتَهَا  الْحَجُّ  مَعَكَ ، قَالَ :  فَلْتَعْتَمِرْ فِي رَمَضَانَ ، فَإِنَّ عُمْرَةً فِي رَمَضَانَ كَحَجَّةٍ  .","","Musnad Abi Ya'la al-Mawsili 6860","","معقل بن أبي معقل الأسدي عن أبو زيد الثعلبي عن عمرو بن يحيى بن عمارة المازني عن وهيب بن خالد الكرابيسي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","حديث معقل بن أبي معقل الأسدي"
"6863","[12/269]             [12/270]      حَدِيثُ  سَلَمَةَ بْنِ نُفَيْلٍ  1 - (  6861  ) -  حَدَّثَنَا  زِيَادُ بْنُ أَيُّوبَ ،  حَدَّثَنَا  مُبَشِّرٌ ،  عَنْ  أَرْطَأَةَ قَالَ :  سَمِعْتُ  ضَمْرَةَ بْنَ حَبِيبٍ يَقُولُ :  سَمِعْتُ  سَلَمَةَ بْنَ نُفَيْلٍ السَّكُونِيَّ يَقُولُ :  بَيْنَا نَحْنُ         [12/271]      جُلُوسٌ عِنْدَ نَبِيِّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَاءَ  رَجُلٌ  مِنَ النَّاسِ فَقَالَ : يَا نَبِيَّ اللهِ ، هَلْ أُتِيتَ بِطَعَامٍ مِنَ السَّمَاءِ ؟ قَالَ :  أُتِيتُ بِطَعَامٍ  بِمِسْخَنَةٍ  ، قَالَ : فَهَلْ كَانَ فِيهَا فَضْلٌ عَنْكَ ؟ قَالَ : نَعَمْ ، قَالَ : فَمَا فُعِلَ بِهِ ؟ قَالَ : رُفِعَ إِلَى السَّمَاءِ ، وَهُوَ يُوحِي إِلَيَّ أَنِّي غَيْرُ لَابِثٍ فِيكُمْ إِلَّا قَلِيلًا ، وَلَسْتُمْ لَابِثِينَ بَعْدِي إِلَّا قَلِيلًا ، ثُمَّ تَأْتُونَ  أَفْنَادًا  ، وَيُفْنِي بَعْضُكُمْ بَعْضًا ، وَبَيْنَ يَدَيِ السَّاعَةِ  مُوتَانٌ  شَدِيدٌ ، وَبَعْدَهُ سَنَوَاتُ الزَّلَازِلِ  .","","Musnad Abi Ya'la al-Mawsili 6861","","سلمة بن نفيل السكوني عن ضمرة بن حبيب الزبيدي عن أرطاة بن المنذر السكوني عن مبشر بن إسماعيل الحلبي عن دلويه زياد بن أيوب عن أبو يعلى الموصلي","حديث سلمة بن نفيل"
"6864","[12/272]      حَدِيثُ  أَوْسٍ  1 - (  6862  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكٍ ،  عَنِ  النُّعْمَانِ بْنِ سَالِمٍ ،         [12/273]      عَنْ  أَوْسٍ قَالَ :  جَاءَ  رَجُلٌ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فَشَاوَرَهُ أَوْ فَسَارَّهُ  ، وَأَنَا أَسْمَعُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اذْهَبْ إِلَيْهِمْ فَقُلْ لَهُمُ : اقْتُلُوهُ  ، قَالَ : ثُمَّ دَعَاهُ فَرَجَعَ إِلَيْهِ بَعْدَمَا ذَهَبَ ، فَقَالَ لَهُ : لَعَلَّهُ يَقُولُ : لَا إِلَهَ إِلَّا اللهُ ؟ قَالَ : أَجَلْ وَاللهِ ، قَالَ : قُلْ لَهُمْ يُرْسِلُوهُ ، فَإِنَّهُ أُوحِيَ إِلَيَّ أَنْ أُقَاتِلَ النَّاسَ ، فَإِذَا قَالُوا : لَا إِلَهَ إِلَّا اللهُ حُرِّمَتْ عَلَيَّ دِمَاؤُهُمْ إِلَّا بِالْحَقِّ ، وَكَانَ حِسَابُهُمْ عَلَى اللهِ  .","","Musnad Abi Ya'la al-Mawsili 6862","","أوس بن أبي أوس الطائفي عن النعمان بن سالم الطائفي عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","حديث أوس"
"6865","[12/274]      حَدِيثُ  عُرْوَةَ الْفُقَيْمِيِّ  1 - (  6863  ) -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَخْبَرَنَا  عَاصِمُ بْنُ هِلَالٍ ،  عَنْ  غَاضِرَةَ بْنِ عُرْوَةَ الْفُقَيْمِيِّ قَالَ :  أَخْبَرَنِي  أَبِي  قَالَ :  أَتَيْتُ  الْمَدِينَةَ  فَدَخَلْتُ الْمَسْجِدَ ، وَالنَّاسُ يَنْتَظِرُونَ الصَّلَاةَ ، فَخَرَجَ عَلَيْنَا  رَجُلٌ  يَقْطُرُ رَأْسُهُ مِنْ وُضُوءٍ تَوَضَّأَ ، أَوْ غُسْلٍ اغْتَسَلَهُ ، فَصَلَّى بِنَا ، فَلَمَّا صَلَّيْنَا جَعَلَ النَّاسُ يَقُومُونَ إِلَيْهِ يَقُولُونَ : يَا رَسُولَ اللهِ أَرَأَيْتَ كَذَا ؟ أَرَأَيْتَ كَذَا ؟ يُرَدِّدُهَا مَرَّاتٍ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا أَيُّهَا النَّاسُ ، إِنَّ دِينَ اللهِ فِي يُسْرٍ  ، يَا أَيُّهَا النَّاسُ ، إِنَّ دِينَ اللهِ فِي يُسْرٍ  .","","Musnad Abi Ya'la al-Mawsili 6863","","عروة الفقيمي عن غاضرة بن عمرو الفقيمي عن عاصم بن هلال البارقي عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","حديث عروة الفقيمي"
"6866","[12/275]      حَدِيثُ  عَامِرِ بْنِ شَهْرٍ  1 - (  6864  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  حَدَّثَنَا         [12/276]      أَبُو أُسَامَةَ ،  عَنْ  مُجَالِدٍ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  عَنْ  عَامِرِ بْنِ شَهْرٍ قَالَ :  كَانَتْ  هَمْدَانُ  قَدْ تَحَصَّنَتْ فِي جَبَلٍ ، يُقَالُ لَهُ  الْحَقْلُ  ، مِنَ  الْحَبَشِ  ، قَدْ مَنَعَهُمُ اللهُ بِهِ حَتَّى جَاءَتْ  هَمْدَانَ  أَهْلُ فَارِسَ  ، فَلَمْ يَزَالُوا مُحَارِبِينَ حَتَّى هَمَّ  الْقَوْمَ  الْحَرْبُ ، وَطَالَ عَلَيْهِمُ الْأَمْرُ ، وَخَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ لِي  هَمْدَانُ  : يَا  عَامِرُ بْنَ شَهْرٍ  ، إِنَّكَ قَدْ كُنْتَ نَدِيمًا لِلْمُلُوكِ مُذْ كُنْتَ ، فَهَلْ أَنْتَ آتٍ هَذَا الرَّجُلَ ، وَمُرْتَادٌ لَنَا ؟ فَإِنْ رَضِيتَ لَنَا شَيْئًا فَعَلْنَاهُ ، وَإِنْ كَرِهْتَ شَيْئًا كَرِهْنَاهُ ؟ قُلْتُ : نَعَمْ ، حَتَّى قَدِمْتُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْمَدِينَةَ  ، فَجَلَسْتُ عِنْدَهُ فَجَاءَ رَهْطٌ ، فَقَالُوا : يَا رَسُولَ اللهِ ، أَوْصِنَا ، قَالَ :  أُوصِيكُمْ بِتَقْوَى اللهِ ، وَأَنْ تَسْمَعُوا مِنْ قَوْلِ  قُرَيْشٍ  وَتَدَعُوا فِعْلَهُمْ  ، قَالَ : فَاجْتَزَأْتُ بِذَلِكَ ، وَاللهِ ، مِنْ مَسْأَلَتِهِ ، وَرَضِيتُ أَمْرَهُ ، ثُمَّ بَدَا لِي أَنْ أَرْجِعَ إِلَى قَوْمِي حَتَّى أَمُرَّ  بِالنَّجَاشِيِّ  ، وَكَانَ لِي صَدِيقًا ، فَمَرَرْتُ بِهِ ، فَبَيْنَا أَنَا عِنْدَهُ جَالِسٌ إِذْ مَرَّ ابْنٌ لَهُ صَغِيرٌ ، فَاسْتَقْرَأَهُ لَوْحًا مَعَهُ ، فَقَرَأَهُ الْغُلَامُ ، فَضَحِكْتُ ، فَقَالَ  النَّجَاشِيُّ  : مِمَّ ضَحِكْتَ ؟ فَوَاللهِ لَهَكَذَا أُنْزِلَتْ عَلَى لِسَانِ  عِيسَى ابْنِ مَرْيَمَ  : إِنَّ اللَّعْنَةَ تَنْزِلُ فِي الْأَرْضِ إِذَا كَانَ أُمَرَاؤُهَا صِبْيَانًا ، قُلْتُ : مِمَّا قَرَأَ هَذَا الْغُلَامُ ؟ قَالَ : فَرَجَعْتُ وَقَدْ سَمِعْتُ         [12/277]      هَذَا مِنَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهَذَا مِنَ  النَّجَاشِيِّ  ، وَأَسْلَمَ قَوْمِي ، وَنَزَلُوا إِلَى السَّهْلِ ، وَكَتَبَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - هَذَا الْكِتَابَ إِلَى  عُمَيْرٍ ذِي مَرَّانٍ  قَالَ : وَبَعَثَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  مَالِكَ بْنَ مِرَارَةَ الرَّهَاوِيَّ  إِلَى  الْيَمَنِ  جَمِيعًا ، فَأَسْلَمَ  عَكُّ ذِي خَيْوَانَ  قَالَ : فَقِيلَ  لِعَكٍّ  : انْطَلِقْ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَخُذْ مِنْهُ الْأَمَانَ عَلَى قَوْمِكَ وَمَالِكَ ، قَالَ : وَكَانَتْ لَهُ قَرْيَةٌ فِيهَا رَقِيقٌ وَمَالٌ ، فَقَدِمَ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّ  مَالِكَ بْنَ مِرَارَةَ الرَّهَاوِيَّ  قَدِمَ عَلَيْنَا يَدْعُونَا إِلَى الْإِسْلَامِ فَأَسْلَمْنَا ، وَلِي أَرْضٌ فِيهَا رَقِيقٌ وَمَالٌ ، فَاكْتُبْ لِي كِتَابًا ، فَكَتَبَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ ، مِنْ  مُحَمَّدٍ  رَسُولِ اللهِ  لِعَكٍّ ذِي خَيْوَانَ  ، إِنْ كَانَ صَادِقًا فِي أَرْضِهِ وَرَقِيقِهِ وَمَالِهِ ، فَلَهُ الْأَمَانُ وَذِمَّةُ اللهِ وَذِمَّةُ  مُحَمَّدٍ  رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَكَتَبَ  خَالِدُ بْنُ سَعِيدٍ  .","","Musnad Abi Ya'la al-Mawsili 6864","","عامر بن شهر الناعطي عن الشعبي عن مجالد بن سعيد عن حماد بن أسامة القرشي عن إبراهيم بن سعيد الجوهري عن أبو يعلى الموصلي","حديث عامر بن شهر"
"6867","[12/278]      حَدِيثُ  عُقْبَةَ بْنِ رَافِعٍ  1 - (  6865  ) -  حَدَّثَنَا  كَامِلُ بْنُ طَلْحَةَ الْجَحْدَرِيُّ ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عُمَارَةَ بْنِ غَزِيَّةَ ، أَنَّ عَاصِمَ بْنَ عُمَرَ بْنِ قَتَادَةَ ،  حَدَّثَهُ  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  عُقْبَةَ بْنِ رَافِعٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ :  إِنَّ اللهَ إِذَا أَحَبَّ عَبْدًا حَمَاهُ الدُّنْيَا  كَمَا يَحْمِي أَحَدُكُمْ مَرِيضَهُ الْمَاءَ لِيَشْفَى  .","","Musnad Abi Ya'la al-Mawsili 6865","","عقبة بن رافع الأنصاري عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن عمارة بن غزية عن عبد الله بن لهيعة عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","حديث عقبة بن رافع"
"6868","[12/279]             [12/280]      حَدِيثُ رَجُلٍ  1 - (  6866  ) -  حَدَّثَنَا  صَالِحُ بْنُ حَاتِمِ بْنِ وَرْدَانَ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ قَالَ :  حَدَّثَنِي  خَالِدٌ الْحَذَّاءُ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ الْعُقَيْلِيِّ قَالَ :  جَلَسْتُ إِلَى رَهْطٍ أَنَا رَابِعُهُمْ ، فَإِذَا رَجُلٌ  يُحَدِّثُ  قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَيَدْخُلَنَّ الْجَنَّةَ بِشَفَاعَةِ رَجُلٍ مِنْ أُمَّتِي أَكْثَرُ مِنْ  بَنِي تَمِيمٍ  ،  قُلْنَا : سِوَاكَ يَا رَسُولَ اللهِ ؟ قَالَ : سِوَايَ ، فَسَأَلْتُ عَنْهُ بَعْدَمَا قَامَ ، فَقَالَ : هَذَا ابْنُ أَبِي الْجَدْعَاءِ  .","","Musnad Abi Ya'la al-Mawsili 6866","","عبد الله بن أبي الجدعاء ميسرة الفجر عن عبد الله بن شقيق العقيلي عن خالد الحذاء عن يزيد بن زريع العيشي عن صالح بن حاتم بن وردان البصري عن أبو يعلى الموصلي","حديث رجل"
"6869","[12/281]      حَدِيثُ  عَبْدِ اللهِ بْنِ حَوَالَةَ  1 - (  6867  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  زَيْدُ بْنُ حُبَابٍ ،  عَنْ  مُعَاوِيَةَ بْنِ صَالِحٍ قَالَ :  حَدَّثَنِي  ضَمْرَةُ بْنُ حَبِيبٍ قَالَ :  حَدَّثَنِي  زُغْبُ بْنُ فُلَانٍ الْأَزْدِيُّ قَالَ :         [12/282]      نَزَلَ عَلَيْنَا عَبْدُ اللهِ بْنُ حَوَالَةَ الْأَزْدِيُّ ،  فَقُلْتُ لَهُ  : بَلَغَنِي أَنَّهُ فُرِضَ لَكَ فِي مِائَتَيْنِ كُلَّ عَامٍ فَلَمْ تَقْبَلْ ، قَالَ : فَقَالَ : بَعَثَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَوْلَ  الْمَدِينَةِ  لِنَغْنَمَ ، فَرَجَعْنَا وَلَمْ نَغْنَمْ شَيْئًا ، وَعَرَفَ فِينَا  الْجَهْدَ  ، فَقَالَ :  اللَّهُمَّ لَا تَكِلْهُمْ إِلَيَّ فَأَضْعُفَ عَنْهُمْ  ، وَلَا تَكِلْهُمْ إِلَى أَنْفُسِهِمْ فَيَعْجِزُوا عَنْهَا ، وَلَا تَكِلْهُمْ إِلَى النَّاسِ فَيَسْتَأْثِرُوا عَلَيْهِمْ .","","Musnad Abi Ya'la al-Mawsili 6867","","عبد الله بن حوالة الأزدي عن عبد الله بن زغب الإيادي عن ضمرة بن حبيب الزبيدي عن معاوية بن صالح بن حدير الحضرمي عن زيد بن الحباب العكلي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث عبد الله بن حوالة"
"6870","[12/283]      حَدِيثُ  خَالِدِ بْنِ عُرْفُطَةَ  1 - (  6868  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  حَدَّثَنَا  زَكَرِيَّا بْنُ أَبِي زَائِدَةَ ،  حَدَّثَنَا  خَالِدُ بْنُ سَلَمَةَ ، أَنَّ مُسْلِمًا مَوْلَى خَالِدِ بْنِ عُرْفُطَةَ ،  حَدَّثَهُ  ،  أَنَّ  خَالِدَ بْنَ عُرْفُطَةَ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا ،  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 6868","","خالد بن عرفطة القضاعي عن مسلم مولى خالد بن عرفطة عن الفأفأ ، خالد بن سلمة بن العاص عن زكريا بن أبي زائدة الوادعي عن محمد بن بشر بن الفرافصة عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","حديث خالد بن عرفطة"
"6871","[12/284]      حَدِيثُ رَجُلٍ  1 - (  6869  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عِمْرَانَ بْنِ ظِبْيَانَ ،  عَنْ  عَدِيِّ بْنِ ثَابِتٍ قَالَ :  هَشَّمَ رَجُلٌ فَمَ رَجُلٍ عَلَى عَهْدِ  مُعَاوِيَةَ  ، فَأُعْطِيَ دِيَتَهُ ، فَأَبَى أَنْ يَقْبَلَ حَتَّى أُعْطِيَ ثَلَاثًا ،  فَقَالَ  رَجُلٌ : إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ  تَصَدَّقَ  بِدَمٍ أَوْ دُونَهُ ، كَانَ كَفَّارَةً لَهُ  مِنْ يَوْمِ وُلِدَ إِلَى يَوْمِ  تَصَدَّقَ  .         [12/285]","","Musnad Abi Ya'la al-Mawsili 6869","","أحد الصحابة عن عدي بن ثابت الظفري عن عمران بن ظبيان الكوفي عن سفيان بن عيينة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","حديث رجل"
"6872","حَدِيثُ  أَبِي الْحَجَّاجِ الثُّمَالِيِّ  1 - (  6870  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ سُلَيْمَانُ بْنُ دَاوُدَ الْبَغْدَادِيُّ ، لَيْسَ بِالزَّهْرَانِيِّ ،  حَدَّثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ اللهِ بْنِ أَبِي مَرْيَمَ  عَنِ  الْهَيْثَمِ بْنِ مَالِكٍ الطَّائِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَائِذٍ الْأَزْدِيِّ ،         [12/286]      عَنْ  أَبِي الْحَجَّاجِ الثُّمَالِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَقُولُ الْقَبْرُ لِلْمَيِّتِ حِينَ يُوضَعُ فِيهِ : وَيْحَكَ يَا ابْنَ آدَمَ مَا غَرَّكَ بِي ؟ أَلَمْ تَعْلَمْ أَنِّي بَيْتُ الْفِتْنَةِ  ، وَبَيْتُ الظُّلْمَةِ ، مَا غَرَّكَ إِذْ كُنْتَ تَمُرُّ بِي فَدَّادًا ؟ فَإِنْ كَانَ مُصْلِحًا ، أَجَابَ عَنْهُ مُجِيبٌ لِلْقَبْرِ : أَرَأَيْتَ إِنْ كَانَ يَأْمُرُ بِالْمَعْرُوفِ وَيَنْهَى عَنِ الْمُنْكَرِ ؟ قَالَ : فَيَقُولُ الْقَبْرُ : إِنِّي إِذًا أَعُودُ عَلَيْهِ  خَضِرًا  ، وَيَعُودُ جَسَدُهُ نُورًا ، وَتَصْعَدُ رُوحُهُ إِلَى رَبِّ الْعَالَمِينَ ، قَالَ لَهُ  ابْنُ عَائِذٍ  : يَا  أَبَا الْحَجَّاجِ  ، وَمَا  الْفَدَّادُ  ؟ قَالَ : الَّذِي يُقَدِّمُ رِجْلًا وَيُؤَخِّرُ أُخْرَى ، كَمِشْيَتِكَ يَا ابْنَ أَخِي أَحْيَانًا ، قَالَ : وَهُوَ يَوْمَئِذٍ يَلْبَسُ وَيَتَهَيَّأُ  .","","Musnad Abi Ya'la al-Mawsili 6870","","عبد الله بن عبد الثمالي عن عبد الرحمن بن عائذ الثمالي عن الهيثم بن مالك الطائي عن أبو بكر الغساني عن بقية بن الوليد عن سليمان بن داود الأحول عن أبو يعلى الموصلي","حديث أبي الحجاج الثمالي"
"6873","[12/287]      حَدِيثُ  الْأَعْشَى الْمَازِنِيِّ  1 - (  6871  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  حَدَّثَنَا         [12/288]      أَبُو مَعْشَرٍ يُوسُفُ بْنُ يَزِيدَ قَالَ :  حَدَّثَنِي  صَدَقَةُ بْنُ طَيْسَلَةَ ،  حَدَّثَنِي  مَعْنُ بْنُ ثَعْلَبَةَ الْمَازِنِيُّ ، وَالْحَيُّ بَعْدُ ، قَالَ :  حَدَّثَنِي  الْأَعْشَى الْمَازِنِيُّ قَالَ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَنْشَدْتُهُ  :  وَدَيَّانَ  ذِرْبَةً         [12/289]      فَجَعَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَتَمَثَّلُهَا ، وَيَقُولُ :  .","","Musnad Abi Ya'la al-Mawsili 6871","","عبيد الله بن الأعور الأعشى عن معن بن ثعلبة المازني عن صدقة بن طيسلة عن يوسف بن يزيد البراء عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","حديث الأعشى المازني"
"6874","[12/290]      حَدِيثُ  قَيْسِ بْنِ الْحَارِثِ  1 - (  6872  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنِ         [12/291]             [12/292]      ابْنِ أَبِي لَيْلَى ،  عَنْ  حُمَيْضَةَ بْنِ الشَّمَرْدَلِ ،  عَنْ  قَيْسِ بْنِ الْحَارِثِ قَالَ :  أَسْلَمْتُ وَعِنْدِي ثَمَانُ نِسْوَةٍ ، فَأَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقُلْتُ ذَلِكَ لَهُ ، فَقَالَ :  اخْتَرْ مِنْهُنَّ أَرْبَعًا  .         [12/293]","","Musnad Abi Ya'la al-Mawsili 6872","","قيس بن الحارث بن جدار  الأسدي عن حميضة بن الشمردل الأسدي عن محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","حديث قيس بن الحارث"
"6875","2 - (  6873  ) -  حَدَّثَنَا  أَبُو عَبْدِ اللهِ أَحْمَدُ بْنُ إِبْرَاهِيمَ ، قَالَ :  حَدَّثَنِي  يُوسُفُ بْنُ بُهْلُولٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ قَالَ :  قَدِمَ وَفْدُ  بَنِي تَمِيمٍ  عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِيهِمْ قَيْسُ بْنُ الْحَارِثِ  .","","Musnad Abi Ya'la al-Mawsili 6873","","قيس بن الحارث بن جدار  الأسدي عن محمد بن إسحاق الخراساني عن عبد الله بن إدريس الأودي عن يوسف بن بهلول الأنباري عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","حديث قيس بن الحارث"
"6876","3 - (  6874  ) -  قَالَ  أَبُو عَبْدِ اللهِ :  وَحُدِّثْتُ عَنِ  الثَّوْرِيِّ  عَنْ         [12/294]      مُحَمَّدِ بْنِ السَّائِبِ  عَنْ  حُمَيْضَةَ بْنِ الشَّمَرْدَلِ ،  عَنْ  قَيْسِ بْنِ الْحَارِثِ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .","","Musnad Abi Ya'la al-Mawsili 6874","","قيس بن الحارث بن جدار  الأسدي عن حميضة بن الشمردل الأسدي عن محمد بن السائب الكلبي عن سفيان الثوري عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","حديث قيس بن الحارث"
"6877","[12/295]      حَدِيثُ  الْمُطَّلِبِ بْنِ أَبِي وَدَاعَةَ  1 - (  6875  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  كَثِيرِ بْنِ كَثِيرِ بْنِ الْمُطَّلِبِ بْنِ أَبِي وَدَاعَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  أَبِيهِ الْمُطَّلِبِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا فَرَغَ مِنْ سُبُعِهِ ، جَاءَ حَتَّى يُحَاذِيَ بَيْنَهُ وَبَيْنَ  السَّقِيفَةِ  ، فَيُصَلِّي رَكْعَتَيْنِ  فِي حَاشِيَةِ الْمَطَافِ ، وَلَيْسَ بَيْنَهُ وَبَيْنَ الطَّوَافِ أَحَدٌ  .","","Musnad Abi Ya'la al-Mawsili 6875","","المطلب بن أبي وداعة الجمحي عن كثير بن المطلب بن أبي وداعة السهمي عن كثير بن كثير بن المطلب السهمي عن ابن جريج عن حماد بن أسامة القرشي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","حديث المطلب بن أبي وداعة"
"6878","[12/296]      حَدِيثُ  أَبِي رُهْمٍ الْغِفَارِيِّ  ، وَآخَرَ  1 - (  6876  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ         [12/297]      عَيَّاشٍ  عَنْ  إِسْحَاقَ بْنِ أَبِي فَرْوَةَ أَنَّ أَبَا حَازِمٍ مَوْلَى أَبِي رُهْمٍ الْغِفَارِيِّ  أَخْبَرَهُ  ،  عَنْ  أَبِي رُهْمٍ وَآخَرَ  أَنَّهُمَا كَانَا فَارِسَيْنِ  يَوْمَ حُنَيْنٍ  فَأُعْطِيَا سِتَّةَ أَسْهُمٍ ، أَرْبَعَةً لِفَرَسَيْهِمَا وَسَهْمَيْنِ لَهُمَا  ، فَبَاعَا السَّهْمَيْنِ بِبَكْرَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 6876","","وآخر عن دينار مولى أبي رهم الغفاري عن إسحاق بن أبي فروة عن إسماعيل بن عياش الأحول عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","حديث أبي رهم الغفاري وآخر"
"6879","[12/298]      حَدِيثُ  عَمْرِو بْنِ أُمَيَّةَ الضَّمْرِيِّ  1 - (  6877  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ ،  حَدَّثَنَا  حَاتِمٌ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ عَمْرِو بْنِ عَبْدِ اللهِ بْنِ عَمْرِو بْنِ أُمَيَّةَ الضَّمْرِيُّ قَالَ :         [12/299]      حَدَّثَنِي  الزِّبْرِقَانُ بْنُ عَبْدِ اللهِ بْنِ عَمْرِو بْنِ أُمَيَّةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَمْرِو بْنِ أُمَيَّةَ  قَالَ :  مَرَّ  عُثْمَانُ بْنُ عَفَّانَ  ، أَوْ  عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  ، بِمِرْطٍ ، فَاسْتَغْلَاهُ ، فَمُرَّ بِهِ عَلَى  عَمْرِو بْنِ أُمَيَّةَ  ، فَاشْتَرَاهُ ، فَكَسَاهُ امْرَأَتَهُ  سُخَيْلَةَ بِنْتَ عُبَيْدَةَ بْنِ الْحَارِثِ بْنِ الْمُطَّلِبِ  ، فَمَرَّ بِهِ  عُثْمَانُ  ، أَوْ  عَبْدُ الرَّحْمَنِ  ، فَقَالَ : مَا فَعَلَ الْمِرْطُ الَّذِي ابْتَعْتَ ؟ قَالَ  عَمْرٌو  : تَصَدَّقْتُ بِهِ عَلَى  سُخَيْلَةَ بِنْتِ عُبَيْدَةَ  ، فَقَالَ : إِنَّ كُلَّ مَا صَنَعْتَ إِلَى أَهْلِكَ صَدَقَةٌ ، قَالَ  عَمْرٌو  : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ ذَاكَ ، فَذُكِرَ مَا قَالَ  عَمْرٌو  لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  صَدَقَ  عَمْرٌو  ، كُلُّ مَا صَنَعْتَ إِلَى أَهْلِكَ فَهُوَ صَدَقَةٌ عَلَيْهِمْ  .         [12/300]","","Musnad Abi Ya'la al-Mawsili 6877","","عمرو بن أمية بن خويلد الضمري عن عبد الله بن عمرو بن أمية الضمري عن الزبرقان بن عمرو الضمري عن يعقوب بن عمرو بن عبد الله الضمري عن حاتم بن إسماعيل الحارثي عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","حديث عمرو بن أمية الضمري"
"6880","2 - (  6878  ) -  حَدَّثَنَا  زَحْمَوَيْهِ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ، قَالَ ابْنُ شِهَابٍ :  حَدَّثَنَاهُ  عَنْ  جَعْفَرِ بْنِ عَمْرِو بْنِ أُمَيَّةَ الضَّمْرِيِّ ،  عَنْ  أَبِيهِ  ،  أَنَّهُ أَبْصَرَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْكُلُ مِنْ كَتِفٍ يَنْهَسُ مِنْهَا  ، وَيَجِيءُ إِلَى الصَّلَاةِ ، فَيُصَلِّي وَلَمْ يَتَوَضَّأْ  .","","Musnad Abi Ya'la al-Mawsili 6878","","عمرو بن أمية بن خويلد الضمري عن جعفر بن عمرو بن أمية الضمري عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","حديث عمرو بن أمية الضمري"
"6881","[12/301]             [12/302]      مُسْنَدُ  أُمِّ سَلَمَةَ  زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  1 - (  6879  ) -  أَخْبَرَنَا  أَبُو يَعْلَى أَحْمَدُ بْنُ عَلِيِّ بْنِ الْمُثَنَّى         [12/303]      الْمَوْصِلِيُّ ،  حَدَّثَنَا  دَاوُدُ بْنُ عَمْرِو بْنِ زُهَيْرٍ الضَّبِّيُّ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ الضَّرِيرُ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  دَخَلَ عَلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعِنْدَنَا صَبِيٌّ يَشْتَكِي ، فَقَالَ : مَا هَذَا ؟ قَالُوا : نَتَّهِمُ بِهِ الْعَيْنَ ، قَالَ :  أَفَلَا تَسْتَرْقُونَ لَهُ مِنَ الْعَيْنِ . ؟         [12/304]             [12/305]","","Musnad Abi Ya'la al-Mawsili 6879","","هند بنت أبي أمية زوج رسول الله عن عروة بن الزبير عن سليمان بن يسار مولى ميمونة زوج رسول الله عن يحيى بن سعيد الأنصاري عن أبو معاوية الضرير عن داود بن عمرو المسيبي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6882","2 - (  6880  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ أَبُو الْحَارِثِ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ الْأُمَوِيُّ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّمَا أَنَا بَشَرٌ ، وَأَنْتُمْ تَخْتَصِمُونَ إِلَيَّ ، وَلَعَلَّ أَحَدَكُمْ أَنْ يَكُونَ  أَلْحَنَ  بِحُجَّتِهِ مِنْ بَعْضٍ  ، فَأَقْضِي نَحْوَ مَا أَسْمَعُ مِنْهُ ، فَمَنْ قَضَيْتُ لَهُ بِشَيْءٍ مِنْ حَقِّ أَخِيهِ ، فَلَا يَأْخُذَنَّ مِنْهُ شَيْئًا ، فَإِنَّمَا أَقْطَعُ لَهُ قِطْعَةً مِنَ النَّارِ  .         [12/306]             [12/307]             [12/308]","","Musnad Abi Ya'la al-Mawsili 6880","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن يحيى بن سعيد بن أبان عن سريج بن يونس المروزي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6883","3 - (  6881  ) -  حَدَّثَنَا  غَسَّانُ بْنُ الرَّبِيعِ ،  عَنْ  حَمَّادِ بْنِ سَلَمَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّكُمْ تَخْتَصِمُونَ إِلَيَّ ، وَإِنَّمَا أَنَا بَشَرٌ ، وَلَعَلَّ بَعْضَكُمْ أَنْ يَكُونَ  أَلْحَنَ  بِحُجَّتِهِ مِنْ بَعْضٍ  ، فَمَنْ قَضَيْتُ لَهُ مِنْ حَقِّ أَخِيهِ ، فَلَا يَأْخُذْهُ ، فَإِنَّمَا أَقْطَعُ لَهُ قِطْعَةً مِنَ النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 6881","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن غسان بن الربيع الأزدي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6884","4 - (  6882  ) -  حَدَّثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  أَخْبَرَنِي  صَخْرُ بْنُ جُوَيْرِيَةَ ،  عَنْ  نَافِعٍ قَالَ :  حَدَّثَنِي  زَيْدُ بْنُ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ ،         [12/309]      عَنْ  أُمِّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ الَّذِي يَشْرَبُ فِي إِنَاءٍ مِنْ فِضَّةٍ ، فَإِنَّمَا  يُجَرْجِرُ  فِي بَطْنِهِ نَارَ  جَهَنَّمَ  .         [12/310]","","Musnad Abi Ya'la al-Mawsili 6882","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن عبد الرحمن بن أبي بكر الصديق عن زيد بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن صخر بن جويرية الهلالي عن علي بن الجعد عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6885","5 - (  6883  ) -  حَدَّثَنَا  دَاوُدُ بْنُ عَمْرٍو ،  حَدَّثَنَا  حَسَّانُ بْنُ إِبْرَاهِيمَ ،  عَنْ  مُحَمَّدِ بْنِ سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمِنْهَالِ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  أَبِيهِ","","Musnad Abi Ya'la al-Mawsili 6883","","سعد بن أبي وقاص عن عامر بن سعد بن أبي وقاص عن المنهال بن عمرو الأسدي عن سلمة بن كهيل الحضرمي عن محمد بن سلمة بن كهيل الكوفي عن حسان بن إبراهيم الكرماني عن داود بن عمرو المسيبي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6886","5 - (  6883  ) - ( م ) -  وَعَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  قَالَ  لِعَلِيٍّ  :  أَمَا تَرْضَى أَنْ تَكُونَ مِنِّي بِمَنْزِلَةِ  هَارُونَ  مِنْ  مُوسَى  ؟  غَيْرَ أَنَّهُ لَا نَبِيَّ بَعْدِي ؟         [12/311]","","Musnad Abi Ya'la al-Mawsili 6883","","هند بنت أبي أمية زوج رسول الله عن عامر بن سعد بن أبي وقاص عن المنهال بن عمرو الأسدي عن سلمة بن كهيل الحضرمي عن محمد بن سلمة بن كهيل الكوفي عن حسان بن إبراهيم الكرماني عن داود بن عمرو المسيبي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6887","6 - (  6884  ) -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  وُهَيْبٌ ،  عَنْ  خَالِدٍ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّهَا أُمِّ سَلَمَةَ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُصَلِّي عَلَى  الْخُمْرَةِ  .         [12/312]","","Musnad Abi Ya'la al-Mawsili 6884","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو قلابة الجرمي عن خالد الحذاء عن وهيب بن خالد الكرابيسي عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6888","7 - (  6885  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي سَمِينَةَ الْبَصْرِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَالِدٍ الْحَنَفِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ الْمُخَرِّمِيُّ ،  عَنْ  عُثْمَانَ الْأَخْنَسِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَعْدِ بْنِ يَرْبُوعٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  قَالَ لَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فِي حَجَّةِ الْوَدَاعِ  :  إِنَّمَا هِيَ هَذِهِ الْحَجَّةُ ، ثُمَّ الْجُلُوسُ عَلَى ظُهُورِ  الْحُصُرِ  فِي الْبُيُوتِ  ،  قَالَ  ابْنُ أَبِي سَمِينَةَ  :  إِنَّمَا هُوَ  سَعِيدٌ  ، وَلَكِنْ هَكَذَا قَالَ  .","","Musnad Abi Ya'la al-Mawsili 6885","","هند بنت أبي أمية زوج رسول الله عن عبد الرحمن بن سعيد بن يربوع المخزومي عن عثمان بن محمد بن المغيرة الأخنسي عن عبد الله بن جعفر بن عبد الرحمن بن المسور بن مخرمة عن محمد بن خالد بن عثمة الهاشمى عن محمد بن إسماعيل بن أبي سمينة عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6889","8 - (  6886  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَالِدٍ الْحَنَفِيُّ ،  حَدَّثَنَا  مُوسَى بْنُ يَعْقُوبَ الزَّمْعِيُّ ،  عَنْ  هَاشِمِ بْنِ هَاشِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ وَهْبٍ ،         [12/313]      عَنْ  أُمِّ سَلَمَةَ ،  جَاءَتْ فَاطِمَةُ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَارَّهَا بِشَيْءٍ ، فَبَكَتْ ، ثُمَّ سَارَّهَا بِشَيْءٍ فَضَحِكَتْ ، فَسَأَلْتُهَا عَنْهُ ، فَقَالَتْ : أَخْبَرَنِي أَنَّهُ مَقْبُوضٌ فِي هَذِهِ السَّنَةِ ، فَبَكَيْتُ ، فَقَالَ لِي :  مَا يَسُرُّكِ أَنْ تَكُونِي سَيِّدَةَ نِسَاءِ الْجَنَّةِ إِلَّا فُلَانَةَ ؟  فَضَحِكْتُ  .","","Musnad Abi Ya'la al-Mawsili 6886","","فاطمة الزهراء عن هند بنت أبي أمية زوج رسول الله عن عبد الله بن وهب بن زمعة الغنمي عن هاشم بن هاشم بن عتبة الوقاصي عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن محمد بن خالد بن عثمة الهاشمى عن محمد بن إسماعيل بن أبي سمينة عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6890","9 - (  6887  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ ،  حَدَّثَنَا  أَبُو نُعَيْمٍ ،  حَدَّثَنَا  زَكَرِيَّا ،  عَنْ  فِرَاسٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ ، بِنَحْوِهِ .","","Musnad Abi Ya'la al-Mawsili 6887","","فاطمة الزهراء عن عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن الشعبي عن فراس بن يحيى الخارفي عن زكريا بن أبي زائدة الوادعي عن الفضل بن دكين عن محمد بن إسماعيل بن أبي سمينة عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6891","10 - (  6888  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي سَمِينَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ ،  عَنْ  فُضَيْلٍ ،  عَنْ  عَطِيَّةَ ،  عَنْ  أَبِي سَعِيدٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - غَطَّى عَلَى  عَلِيٍّ  وَفَاطِمَةَ  وَحَسَنٍ  وَحُسَيْنٍ  كِسَاءً ، ثُمَّ قَالَ :  هَؤُلَاءِ أَهْلُ بَيْتِي ، إِلَيْكَ لَا إِلَى النَّارِ  ، قَالَتْ  أُمُّ سَلَمَةَ  : فَقُلْتُ : يَا رَسُولَ اللهِ ، وَأَنَا مِنْهُمْ ؟ قَالَ :         [12/314]      لَا ، وَأَنْتِ عَلَى خَيْرٍ  .         [12/315]","","Musnad Abi Ya'la al-Mawsili 6888","","هند بنت أبي أمية زوج رسول الله عن أبو سعيد الخدري عن عطية بن سعد العوفي عن فضيل بن مرزوق الأغر عن عبد الله بن داود الخريبي عن محمد بن إسماعيل بن أبي سمينة عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6892","11 - (  6889  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  حَدَّثَنَا  الْحَسَنُ بْنُ عُبَيْدِ اللهِ ،  عَنْ  هُنَيْدَةَ بْنِ خَالِدٍ الْخُزَاعِيِّ ،  عَنْ  أُمِّهِ  ، قَالَتْ :  دَخَلْتُ عَلَى أُمِّ سَلَمَةَ ،  فَسَأَلْتُهَا  عَنِ الصِّيَامِ ، فَقَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْمُرُ بِصِيَامِ ثَلَاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ مِنْ أَوَّلِهَا  : الِاثْنَيْنِ وَالْخَمِيسِ ، وَيَوْمًا لَا أَحْفَظُهُ  .         [12/316]","","Musnad Abi Ya'la al-Mawsili 6889","","هند بنت أبي أمية زوج رسول الله عن أم هنيدة بن خالد عن هنيدة بن خالد الخزاعي عن الحسن بن عبيد الله النخعي عن محمد بن فضيل بن غزوان عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6893","12 - (  6890  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبِي ،  حَدَّثَنَا  عُبَيْدُ اللهِ قَالَ :  حَدَّثَنِي  نَافِعٌ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  قُلْتُ : يَا رَسُولَ اللهِ ، كَيْفَ بِالنِّسَاءِ ؟ قَالَ : يُرْخِينَ شِبْرًا  ، قَالَتْ : قُلْتُ : يَا رَسُولَ اللهِ ، إِذًا يَنْكَشِفُ عَنْهُنَّ ، قَالَ : فَذِرَاعٌ لَا يَزِدْنَ عَلَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 6890","","هند بنت أبي أمية زوج رسول الله عن سليمان بن يسار مولى ميمونة زوج رسول الله عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6894","13 - (  6891  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  أَيُّوبَ ،  عَنْ  نَافِعٍ ،  عَنْ  صَفِيَّةَ بِنْتِ أَبِي عُبَيْدٍ ،         [12/317]      عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمَّا قَالَ فِي جَرِّ الذَّيْلِ مَا قَالَ ، قَالَتْ : قُلْتُ : يَا رَسُولَ اللهِ ، فَكَيْفَ بِنَا ؟ فَقَالَ :  جُرِّيهِ شِبْرًا  ، فَقَالَتْ : إِذًا تَتَكَشَّفُ الْقَدَمَانِ ؟ قَالَ : فَجُرِّيهِ ذِرَاعًا  .","","Musnad Abi Ya'la al-Mawsili 6891","","هند بنت أبي أمية زوج رسول الله عن صفية بنت أبي عبيد زوج عبد الله بن عمر عن نافع مولى ابن عمر عن أيوب السختياني عن حماد بن زيد عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6895","14 - (  6892  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنِ  الْحَسَنِ ، أَنَّ أُمَّ سَلَمَةَ  حَدَّثَتْهُمْ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - شَبَرَ  لِفَاطِمَةَ  مِنْ نِطَاقِهَا شِبْرًا  .         [12/318]","","Musnad Abi Ya'la al-Mawsili 6892","","هند بنت أبي أمية زوج رسول الله عن الحسن البصري عن علي بن زيد بن جدعان عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6896","15 - (  6893  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ :  رَبِّ اغْفِرْ لِي وَارْحَمْنِي وَاهْدِنِي السَّبِيلَ الْأَقْوَمَ  .","","Musnad Abi Ya'la al-Mawsili 6893","","هند بنت أبي أمية زوج رسول الله عن الحسن البصري عن علي بن زيد بن جدعان عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6897","16 - (  6894  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ ،  حَدَّثَنَا  جُوَيْرِيَةُ ،  عَنْ  نَافِعٍ ،  أَنَّهُ أَخْبَرَهُ  سُلَيْمَانُ بْنُ يَسَارٍ ، أَنَّ رَجُلًا ،  أَخْبَرَهُ  ،  عَنْ  أُمِّ سَلَمَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  أَنَّ  امْرَأَةً  كَانَتْ  تُهَرَاقُ  الدَّمَ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَاسْتَفْتَتْ لَهَا  أُمُّ سَلَمَةَ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لِتَنْظُرْ عَدَدَ الْأَيَّامِ الَّتِي كَانَتْ تَحِيضُهُنَّ قَبْلَ أَنْ يَكُونَ بِهَا الَّذِي كَانَ  ، وَقَدْرَهُنَّ مِنَ         [12/319]      الْأَشْهُرِ ، فَتَتْرُكِ الصَّلَاةَ قَدْرَ ذَلِكَ ، فَإِذَا خَلَّفَتْ ذَلِكَ وَحَضَرَتِ الصَّلَاةُ ، فَلْتَغْتَسِلْ ،  وَلْتَسْتَثْفِرْ  بِثَوْبٍ ، وَتُصَلِّي  .         [12/320]             [12/321]","","Musnad Abi Ya'la al-Mawsili 6894","","هند بنت أبي أمية زوج رسول الله عن رجل عن سليمان بن يسار مولى ميمونة زوج رسول الله عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6898","17 - (  6895  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  أَبِي ،  حَدَّثَنَا  هِشَامٌ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ، قَالَتْ :  دَخَلَتْ  أُمُّ سُلَيْمٍ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ : إِنَّ اللهَ لَا يَسْتَحِي مِنَ الْحَقِّ ، هَلْ عَلَى الْمَرْأَةِ غُسْلٌ إِذَا احْتَلَمَتْ ؟ قَالَ :  نَعَمْ ، إِذَا رَأَتِ الْمَاءَ  ، قَالَتْ  أُمُّ سَلَمَةَ  : وَهَلْ تَحْتَلِمُ الْمَرْأَةُ ؟ فَقَالَ :  تَرِبَتْ  يَمِينُكِ ، فَمِمَّ يُشْبِهُهَا وَلَدُهَا . ؟         [12/322]             [12/323]","","Musnad Abi Ya'la al-Mawsili 6895","","زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6899","18 - (  6896  ) -  حَدَّثَنَا  حُسَيْنُ بْنُ الْأَسْوَدِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ إِسْحَاقَ ،  عَنْ  حَفْصَةَ بِنْتِ أَبِي كَثِيرٍ ،  عَنْ  أَبِيهَا أَبِي كَثِيرٍ  قَالَ :         [12/324]      عَلَّمَتْنِي  أُمُّ سَلَمَةَ ، قَالَتْ :  عَلَّمَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  قُولِي يَا  أُمَّ سَلَمَةَ  عِنْدَ أَذَانِ الْمَغْرِبِ : اللَّهُمَّ عِنْدَ اسْتِقْبَالِ لَيْلِكَ ، وَإِدْبَارِ نَهَارِكَ ، وَأَصْوَاتِ دُعَاتِكَ  ، وَحُضُورِ صَلَوَاتِكَ ، أَسْأَلُكَ أَنْ تَغْفِرَ لِي  .","","Musnad Abi Ya'la al-Mawsili 6896","","هند بنت أبي أمية زوج رسول الله عن أبو كثير مولى أم سلمة عن حفصة بنت أبي كثير المخزومية عن عبد الرحمن بن إسحاق بن سعد  الواسطي عن محمد بن فضيل بن غزوان عن الحسين بن علي بن الأسود العجلي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6900","19 - (  6897  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَزْدِيُّ ،  حَدَّثَنَا  صَفْوَانُ بْنُ عِيسَى ،  حَدَّثَنَا  أُسَامَةُ بْنُ زَيْدٍ اللَّيْثِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ رَافِعٍ مَوْلَى أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ قَالَتْ :  جَاءَ رَجُلَانِ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْتَصِمَانِ فِي مَوَارِيثَ وَأَشْيَاءَ قَدْ دَرَسَتْ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّمَا أَقْضِي بَيْنَكُمَا بِرَأْيِي مَا لَمْ يَنْزِلْ عَلَيَّ ، فَمَنْ قَضَيْتُ         [12/325]      لَهُ بِحُجَّةٍ أُرَاهَا ، فَاقْتَطَعَ بِهَا قِطْعَةً ظُلْمًا  ، فَإِنَّمَا  يَقْتَطِعُ  بِهَا قِطْعَةً مِنَ النَّارِ  إِسْطَامًا  يَأْتِي بِهِ فِي عُنُقِهِ يَوْمَ الْقِيَامَةِ ، قَالَتْ : بَكَى الرَّجُلَانِ ، وَقَالَ كُلُّ وَاحِدٍ مِنْهُمَا : يَا رَسُولَ اللهِ ، حَقِّي هَذَا الَّذِي أَطْلُبُ لِصَاحِبِي ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : لَا ، وَلَكِنِ اذْهَبَا  فَتَوَخَّيَا  ثُمَّ  اسْتَهِمَا ،  ثُمَّ لِيُحَلِّلْ كُلُّ وَاحِدٍ مِنْكُمَا صَاحِبَهُ  .","","Musnad Abi Ya'la al-Mawsili 6897","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن أسامة بن زيد الليثي المدني عن صفوان بن عيسى عباية عن محمد بن عبد الله بن عمار الغامدي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6901","20 - (  6898  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا         [12/326]      عَبْدُ الرَّحِيمِ ،  عَنِ  الْحَسَنِ بْنِ عُبَيْدِ اللهِ ،  عَنِ  الْحُرِّ بْنِ الصَّيَّاحِ ،  عَنْ  هُنَيْدَةَ الْخُزَاعِيِّ ،  عَنِ  امْرَأَتِهِ  ،  عَنْ  أُمِّ سَلَمَةَ قَالَتْ :  قَالَ لَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  صُمْ مِنْ كُلِّ شَهْرٍ ثَلَاثَةَ أَيَّامٍ مِنْ أَوَّلِهِ  : الِاثْنَيْنِ وَالْخَمِيسَ ، وَالْخَمِيسَ الَّذِي يَلِيهِ  .","","Musnad Abi Ya'la al-Mawsili 6898","","هند بنت أبي أمية زوج رسول الله عن امرأة هنيدة بن خالد عن هنيدة بن خالد الخزاعي عن حر بن الصياح النخعي عن الحسن بن عبيد الله النخعي عن عبد الرحيم بن سليمان الأشل عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6902","21 - (  6899  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ آدَمَ ،  عَنْ  حَفْصِ بْنِ غِيَاثٍ ،  عَنْ  هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  أَمَرَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِالصَّدَقَةِ ، فَقَالَتِ  امْرَأَةُ عَبْدِ اللهِ  :  يَا رَسُولَ اللهِ ، أَيُجْزِي مِنَ الصَّدَقَةِ أَنْ أَتَصَدَّقَ عَلَى زَوْجِي وَهُوَ فَقِيرٌ  ، وَعَلَى بَنِي أَخٍ لِي أَيْتَامٍ ، وَإِنَّهَا مُنْفِقَةٌ هَكَذَا وَهَكَذَا ، وَعَلَى كُلِّ حَالٍ ؟ قَالَ : نَعَمْ ، وَكَانَتْ صَنَاعَ الْيَدَيْنِ  .         [12/327]","","Musnad Abi Ya'la al-Mawsili 6899","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حفص بن غياث النخعي عن يحيى بن آدم عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6903","22 - (  6900  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ عَبْدِ الْأَعْلَى ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ قَالَ :  حَدَّثَنِي  سُلَيْمَانُ بْنُ سُحَيْمٍ ،  عَنْ  أُمِّ حَكِيمٍ بِنْتِ أُمَيَّةَ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ أَهَلَّ بِعُمْرَةٍ مِنْ  بَيْتِ الْمَقْدِسِ  ، غُفِرَ لَهُ  .         [12/328]             [12/329]","","Musnad Abi Ya'la al-Mawsili 6900","","هند بنت أبي أمية زوج رسول الله عن حكيمة بنت أمية بن الأخنس عن سليمان بن سحيم  الحجازي عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6904","23 - (  6901  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  دَاوُدَ بْنِ أَبِي عَبْدِ اللهِ ،  عَنِ  ابْنِ جُدْعَانَ ،  عَمَّنْ  حَدَّثَهُ  ، أَوْ  عَنْ  جَدَّتِهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بَعَثَ وَصِيفَةً لَهُ فَأَبْطَأَتْ ، فَقَالَ :  لَوْلَا مَخَافَةُ الْقِصَاصِ لَأَوْجَعْتُكِ بِهَذَا السَّوْطِ  .         [12/330]","","Musnad Abi Ya'la al-Mawsili 6901","","هند بنت أبي أمية زوج رسول الله عن جدة عبد الرحمن بن محمد بن جدعان عن عبد الرحمن بن محمد القرشي عن داود بن أبي عبد الله الهاشمي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6905","24 - (  6902  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  دَاوُدَ بْنِ أَبِي عَبْدِ اللهِ ،  عَنِ  ابْنِ جُدْعَانَ  عَنْ  جَدَّتِهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا  حِلْفَ  فِي الْإِسْلَامِ  ، وَأَيُّمَا  حِلْفٍ  كَانَ فِي الْجَاهِلِيَّةِ ، فَلَمْ يَزِدْ فِي الْإِسْلَامِ إِلَّا شِدَّةً  .         [12/331]","","Musnad Abi Ya'la al-Mawsili 6902","","هند بنت أبي أمية زوج رسول الله عن جدة عبد الرحمن بن محمد بن جدعان عن عبد الرحمن بن محمد القرشي عن داود بن أبي عبد الله الهاشمي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6906","25 - (  6903  ) -  حَدَّثَنَا  أَبُو هِشَامٍ الرِّفَاعِيُّ ،  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  حَدَّثَنَا  أَبُو نَصْرٍ عَبْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  مُسَاوِرٍ الْحِمْيَرِيِّ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَيُّمَا امْرَأَةٍ مَاتَتْ وَزَوْجُهَا عَنْهَا رَاضٍ دَخَلَتِ الْجَنَّةَ  .","","Musnad Abi Ya'la al-Mawsili 6903","","هند بنت أبي أمية زوج رسول الله عن أم مساور الحميرية عن مساور الحميري عن عبد الله بن عبد الرحمن الضبي عن محمد بن فضيل بن غزوان عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6907","26 - (  6904  ) -  حَدَّثَنَا  أَبُو هِشَامٍ ،  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  حَدَّثَنَا  أَبُو نَصْرٍ ،  عَنْ  مُسَاوِرٍ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِعَلِيٍّ  :  لَا         [12/332]      يُحِبُّكَ مُنَافِقٌ ، وَلَا يُبْغِضُكَ مُؤْمِنٌ  .","","Musnad Abi Ya'la al-Mawsili 6904","","هند بنت أبي أمية زوج رسول الله عن أم مساور الحميرية عن مساور الحميري عن عبد الله بن عبد الرحمن الضبي عن محمد بن فضيل بن غزوان عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6908","27 - (  6905  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي صَالِحٍ قَالَ :  سُئِلَتْ  عَائِشَةُ وَأُمُّ سَلَمَةَ : أَيُّ الْعَمَلِ أَحَبُّ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟  قَالَتَا : مَا دَامَ عَلَيْهِ صَاحِبُهُ  .         [12/333]","","Musnad Abi Ya'la al-Mawsili 6905","","هند بنت أبي أمية زوج رسول الله عن ذكوان السمان عن الأعمش عن محمد بن فضيل بن غزوان عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6909","28 - (  6906  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ الْكُوفِيُّ الْوَرَّاقُ ،  حَدَّثَنَا  وَكِيعُ بْنُ الْجَرَّاحِ ،  عَنْ  دَاوُدَ بْنِ أَبِي عَبْدِ اللهِ ،  عَنِ  ابْنِ جُدْعَانَ يَعْنِي  عَنْ  جَدَّتِهِ ،  عَنْ  أُمِّ سَلَمَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْمُسْتَشَارُ مُؤْتَمَنٌ  .         [12/334]","","Musnad Abi Ya'la al-Mawsili 6906","","هند بنت أبي أمية زوج رسول الله عن جدة عبد الرحمن بن محمد بن جدعان عن عبد الرحمن بن محمد القرشي عن داود بن أبي عبد الله الهاشمي عن وكيع بن الجراح عن الحسن بن حماد الوراق عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6910","29 - (  6907  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنِ  ابْنِ عُمَرَ بْنِ أَبِي سَلَمَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  أُمِّ سَلَمَةَ  قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا أَصَابَتْ أَحَدَكُمْ مُصِيبَةٌ فَلْيَقُلْ : إِنَّا لِلهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ  ، اللَّهُمَّ عِنْدَكَ أَحْتَسِبُ مُصِيبَتِي فَأْجُرْنِي فِيهَا وَأَبْدِلْنَا بِهَا خَيْرًا مِنْهَا ، فَلَمَّا قُبِضَ  أَبُو سَلَمَةَ  ، قَالَتْ : قُلْتُ : إِنَّا لِلهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ ، اللَّهُمَّ عِنْدَكَ أَحْتَسِبُ مُصِيبَتِي ، فَأْجُرْنِي فِيهَا ، فَكُنْتُ إِذَا أَرَدْتُ أَنْ أَقُولَ : وَأَبْدِلْنِي بِهَا خَيْرًا ، قُلْتُ : وَمَنْ خَيْرٌ مِنْ  أَبِي سَلَمَةَ  ؟ قَالَتْ : فَلَمْ أَزَلْ حَتَّى قُلْتُهَا ، فَلَمَّا انْقَضَتْ عِدَّتُهَا خَطَبَهَا  أَبُو بَكْرٍ  فَرَدَّتْهُ ، وَخَطَبَهَا  عُمَرُ  فَرَدَّتْهُ ، ثُمَّ بَعَثَ إِلَيْهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَخَطَبَهَا ، فَقَالَتْ : مَرْحَبًا بِرَسُولِ اللهِ وَبِرَسُولِهِ ، أَقْرِئْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَخْبِرْهُ أَنِّي امْرَأَةٌ  غَيْرَى  ، وَأَنِّي  مُصْبِيَةٌ  ، وَأَنَّهُ لَيْسَ لِي أَحَدٌ مِنْ أَوْلِيَائِي شَاهِدٌ ، فَقَالَ لَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَمَّا قَوْلُكِ : إِنِّي  غَيْرَى  فَإِنِّي         [12/335]      أَدْعُو اللهَ عَزَّ وَجَلَّ فَيُذْهِبُ غَيْرَتَكِ ، وَأَمَّا قَوْلُكِ : إِنِّي  مُصْبِيَةٌ  ، فَإِنَّ اللهَ عَزَّ وَجَلَّ سَيَكْفِيكِ صِبْيَانَكِ ، وَأَمَّا أَوْلِيَاؤُكِ فَلَيْسَ أَحَدٌ مِنْهُمْ شَاهِدٌ وَلَا غَائِبٌ إِلَّا سَيَرْضَانِي ، فَقَالَتْ لِابْنِهَا : قُمْ يَا  عُمَرُ  فَزَوِّجْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَزَوَّجَهَا إِيَّاهُ ، وَقَالَ لَهَا : أَمَا لَا أُنْقِصُكِ مِمَّا أَعْطَيْتُ أُخْتَكِ  فُلَانَةَ  : جَرَّتَيْنِ وَوِجَاءَيْنِ وَوِسَادَةً مِنْ أَدَمٍ حَشْوُهَا لِيفٌ ، فَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْتِيهَا وَهِيَ تُرْضِعُ  زَيْنَبَ  ، فَكَانَتْ إِذَا جَاءَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَخَذَتْهَا فَوَضَعَتْهَا فِي حَجْرِهَا ، فَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَيِيًّا كَرِيمًا ، فَفَطِنَ لَهَا  عَمَّارُ بْنُ يَاسِرٍ  ، وَكَانَ أَخَاهَا مِنَ الرَّضَاعَةِ ، فَأَرَادَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَأْتِيَهَا ذَاتَ يَوْمٍ ، فَجَاءَ  عَمَّارٌ  فَدَخَلَ عَلَيْهَا ،  فَانْتَشَطَ  زَيْنَبَ  مِنْ حَجْرِهَا ، وَقَالَ : دَعِي هَذِهِ  الْمَقْبُوحَةَ  الْمَشْقُوحَةَ  الَّتِي قَدْ آذَيْتِ بِهَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَاءَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَدَخَلَ ، فَجَعَلَ يُقَلِّبُ بَصَرَهُ فِي الْبَيْتِ ، وَيَقُولُ : أَيْنَ  زُنَابُ  ؟ مَا فَعَلَتْ  زُنَابُ  ؟ مَا لِي لَا أَرَى  زُنَابَ  ؟ قَالَتْ : جَاءَ         [12/336]      عَمَّارٌ  فَذَهَبَ بِهَا ، فَبَنَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِأَهْلِهِ ، فَقَالَ لَهَا : إِنْ شِئْتِ أَنْ أُسَبِّعَ لَكِ كَمَا  سَبَّعْتُ  لِلنِّسَاءِ . ؟         [12/337]","","Musnad Abi Ya'la al-Mawsili 6907","","هند بنت أبي أمية زوج رسول الله عن عمر بن أبي سلمة المخزومي عن ابن عمر بن أبي سلمة عن ثابت البناني عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6911","30 - (  6908  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْمُغِيرَةِ ،  عَنْ  ثَابِتٍ قَالَ :  حَدَّثَنِي  ابْنُ أُمِّ سَلَمَةَ ،  أَنَّ  أَبَا سَلَمَةَ جَاءَ إِلَى أُمِّ سَلَمَةَ  ، فَقَالَ :  لَقَدْ سَمِعْتُ حَدِيثًا مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَحَبَّ إِلَيَّ مِنْ كَذَا وَكَذَا وَلَا أَدْرِي مَا عَدَلَ بِهِ ، سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّهُ لَا تُصِيبُ أَحَدًا مُصِيبَةٌ فَيَسْتَرْجِعَ عِنْدَ ذَلِكَ ، ثُمَّ يَقُولُ : اللَّهُمَّ عِنْدَكَ أَحْتَسِبُ مُصِيبَتِي هَذِهِ  ، اللَّهُمَّ أَخْلِفْنِي مِنْهَا بِخَيْرٍ مِنْهَا ، إِلَّا أَعْطَاهُ اللهُ عَزَّ وَجَلَّ ، قَالَتْ  أُمُّ سَلَمَةَ  : فَلَمَّا أُصِيبَ  أَبُو سَلَمَةَ  ، قُلْتُ : اللَّهُمَّ عِنْدَكَ أَحْتَسِبُ مُصِيبَتِي هَذِهِ ، وَلَمْ تَطِبْ نَفْسِي أَنْ أَقُولَ : اللَّهُمَّ أَخْلِفْنِي مِنْهَا بِخَيْرٍ مِنْهَا ، قُلْتُ : مَنْ خَيْرٌ مِنْ  أَبِي سَلَمَةَ  ؟ أَلَيْسَ ، وَلَيْسَ ؟ ثُمَّ قَالَتْ ذَلِكَ ، فَلَمَّا انْقَضَتْ عِدَّتُهَا أَرْسَلَ إِلَيْهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُهَا ، فَقَالَتْ : مَرْحَبًا بِرَسُولِ اللهِ ، إِنَّ فِيَّ خِلَالًا ثَلَاثًا : أَنَا امْرَأَةٌ  مُصْبِيَةٌ  ، وَأَنَا امْرَأَةٌ شَدِيدَةُ الْغَيْرَةِ ، وَأَنَا امْرَأَةٌ لَيْسَ هَاهُنَا مِنْ أَوْلِيَائِي أَحَدٌ شَاهِدًا فَيُزَوِّجُنِي ، فَغَضِبَ  عُمَرُ  لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَشَدَّ مِمَّا غَضِبَ لِنَفْسِهِ حِينَ رَدَّتْهُ ، فَأَتَاهَا  عُمَرُ  ، فَقَالَ : أَنْتِ الَّتِي تَرُدِّينَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِمَا تَرُدِّينَهُ ؟         [12/338]      فَقَالَتْ : يَا  ابْنَ الْخَطَّابِ  ، فِيَّ كَذَا وَكَذَا ، أَتَاهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : أَمَّا مَا ذَكَرْتِ مِنْ غَيْرَتِكِ فَإِنِّي أَدْعُو اللهَ أَنْ يُذْهِبَهَا ، وَأَمَّا مَا ذَكَرْتِ مِنْ صِبْيَتِكِ فَإِنَّ اللهَ سَيَكْفِيهِمْ ، وَأَمَّا مَا ذَكَرْتِ أَنَّهُ لَيْسَ مِنْ أَوْلِيَائِكِ أَحَدٌ شَاهِدًا فَإِنَّهُ لَيْسَ مِنْ أَوْلِيَائِكِ أَحَدٌ شَاهِدٌ وَلَا غَائِبٌ يَكْرَهُنِي ، فَقَالَتْ لِابْنِهَا : زَوِّجْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَزَوَّجَهُ ، فَقَالَ : أَمَا إِنِّي لَمْ أُنْقِصْكِ مِمَّا أَعْطَيْتُ  فُلَانَةَ  .  قَالَ  ثَابِتٌ  لِابْنِ أُمِّ سَلَمَةَ  : وَمَا أَعْطَى فُلَانَةَ ؟ قَالَ : جَرَّتَيْنِ تَضَعُ فِيهِمَا حَاجَتَهَا ، وَرَحًى ، وَوِسَادَةً مِنْ أَدَمٍ حَشْوُهَا لِيفٌ .  ثُمَّ انْصَرَفَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ أَقْبَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْتِيهَا ، فَلَمَّا رَأَتْهُ وَضَعَتْ  زَيْنَبَ  ، أَصْغَرَ وَلَدِهَا ، فِي حَجْرِهَا ، فَجَاءَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا رَآهَا انْصَرَفَ ، وَكَانَ حَيِيًّا كَرِيمًا ، ثُمَّ أَقْبَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْتِيهَا ، فَلَمَّا رَأَتْهُ وَضَعَتْهَا فِي حَجْرِهَا ، فَانْصَرَفَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ أَقْبَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْتِيهَا ، فَوَضَعَتْهَا فِي حَجْرِهَا ، فَأَقْبَلَ  عَمَّارٌ  مُسْرِعًا بَيْنَ يَدَيْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَانْتَزَعَهَا مِنْ حَجْرِهَا ، وَقَالَ : هَاتِ هَذِهِ  الْمَشْقُوحَةَ  الَّتِي مَنَعَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَاجَتَهُ ، فَجَاءَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمْ يَرَهَا قَالَ : أَيْنَ  زُنَابُ  ؟ قَالَتْ : أَخَذَهَا  عَمَّارٌ  ، فَدَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى أَهْلِهِ ، فَكَانَتْ فِي النِّسَاءِ كَأَنَّهَا لَيْسَتْ مِنْهُنَّ لَا تَجِدُ مَا يَجِدْنَ مِنَ الْغَيْرَةِ  .         [12/339]","","Musnad Abi Ya'la al-Mawsili 6908","","هند بنت أبي أمية زوج رسول الله عن عمر بن أبي سلمة المخزومي عن ثابت البناني عن سليمان بن المغيرة القيسي عن هدبة بن خالد عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6912","31 - (  6909  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الرَّاسِيُّ ،  حَدَّثَنَا  أَبُو صَالِحٍ ،  حَدَّثَنَا  اللَّيْثُ قَالَ :  حَدَّثَنِي  يُونُسُ ،  عَنِ  ابْنِ شِهَابٍ قَالَ :  أَخْبَرَتْنِي  هِنْدُ بِنْتُ الْحَارِثِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كُنَّ نِسَاءٌ يُصَلِّينَ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَإِذَا سَلَّمَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - انْصَرَفْنَ  ، وَثَبَتَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَنْ صَلَّى مَعَهُ مَا شَاءَ اللهُ ، ثُمَّ يَقُومُ  .         [12/340]             [12/341]","","Musnad Abi Ya'la al-Mawsili 6909","","هند بنت أبي أمية زوج رسول الله عن هند بنت الحارث الفراسية عن الزهري عن يونس بن يزيدالأيلي عن الليث بن سعد عن عبد الله بن صالح المصري عن جعفر بن محمد بن الفضيل الرسعني عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6913","32 - (  6910  ) -  حَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي عَدِيٍّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  عَمْرِو بْنِ مُسْلِمٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ أَهَلَّ هِلَالَ ذِي الْحِجَّةِ وَلَهُ  ذِبْحٌ  يُرِيدُ أَنْ يَذْبَحَهُ  ، فَلْيُمْسِكْ عَنْ شَعَرِهِ وَأَظْفَارِهِ  .         [12/342]             [12/343]             [12/344]","","Musnad Abi Ya'la al-Mawsili 6910","","هند بنت أبي أمية زوج رسول الله عن سعيد بن المسيب عن عمرو بن مسلم بن عمارة الجندعي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن محمد بن إبراهيم بن أبي عدي القسملي عن نصر بن علي بن نصر الجهضمي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6914","33 - (  6911  ) -  حَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ قَالَ :  وَجَدْتُ فِي كِتَابِ  أَبِي  ،  عَنْ  شُعْبَةَ ،  عَنْ  مَالِكِ بْنِ أَنَسٍ ،  عَنْ  عَمْرِو بْنِ مُسْلِمٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .","","Musnad Abi Ya'la al-Mawsili 6911","","هند بنت أبي أمية زوج رسول الله عن سعيد بن المسيب عن عمرو بن مسلم بن عمارة الجندعي عن مالك بن أنس عن شعبة بن الحجاج عن نصر بن علي بن نصر الجهضمي عن علي بن نصر الجهضمي الصغير عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6915","34 - (  6912  ) -  حَدَّثَنَا  حَوْثَرَةُ بْنُ أَشْرَسَ أَبُو عَامِرٍ قَالَ :  أَخْبَرَنِي  عُقْبَةُ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِفَاطِمَةَ  : ائْتِنِي بِزَوْجِكِ وَابْنَيْكِ ، فَجَاءَتْ بِهِمْ ، فَأَلْقَى عَلَيْهِمْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كِسَاءً كَانَ تَحْتِي خَيْبَرِيًّا أَصَبْنَاهُ مِنْ  خَيْبَرَ  ، ثُمَّ قَالَ :  اللَّهُمَّ هَؤُلَاءِ  آلُ مُحَمَّدٍ  عَلَيْهِ السَّلَامُ ، فَاجْعَلْ صَلَاتَكَ وَبَرَكَاتِكَ عَلَى  آلِ مُحَمَّدٍ  ، كَمَا جَعَلْتَهَا عَلَى  آلِ إِبْرَاهِيمَ  إِنَّكَ حَمِيدٌ مَجِيدٌ ، قَالَتْ  أُمُّ سَلَمَةَ  : فَرَفَعْتُ الْكِسَاءَ لِأَدْخُلَ مَعَهُمْ ، فَجَذَبَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ يَدِي ، وَقَالَ : إِنَّكِ عَلَى خَيْرٍ  .         [12/345]","","Musnad Abi Ya'la al-Mawsili 6912","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن عقبة بن عبد الله الأصم عن حوثرة بن أشرس بن عومر العدوي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6916","35 - (  6913  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  جَرِيرٌ ،  حَدَّثَنَا  نَافِعٌ قَالَ :  قَالَتْ  أُمُّ سَلَمَةَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ شَرِبَ فِي إِنَاءٍ مِنْ فِضَّةٍ ، فَإِنَّمَا  يُجَرْجِرُ  فِي بَطْنِهِ نَارَ  جَهَنَّمَ .","","Musnad Abi Ya'la al-Mawsili 6913","","هند بنت أبي أمية زوج رسول الله عن نافع مولى ابن عمر عن جرير بن حازم عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6917","36 - (  6914  ) - حَدَّثَنَا  شَيْبَانُ  قَالَ  جَرِيرٌ  : سَأَلْتُ  عَبْدَ الرَّحْمَنِ السَّرَّاجَ  ، فَقُلْتُ : أَتَدْرِي عَمَّنْ يُحَدِّثُهُ ؟ قَالَ : نَعَمْ ،         [12/346]      حَدَّثَهُ عَنْ  زَيْدِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ  ، عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ الصِّدِّيقِ  قَالَ :  وَكَانَتْ  أُمُّ سَلَمَةَ  خَالَةَ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ  .","","Musnad Abi Ya'la al-Mawsili 6914","","","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6918","37 - (  6915  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي سَمِينَةَ ،  حَدَّثَنَا  مُعْتَمِرٌ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي عُثْمَانَ قَالَ :  قَالَتْ  أُمُّ سَلَمَةَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُحَدِّثُ رَجُلًا ، فَلَمَّا قَامَ قَالَ :  يَا  أُمَّ سَلَمَةَ  مَنْ هَذَا ؟  قُلْتُ :  دِحْيَةُ الْكَلْبِيُّ  ، فَلَمْ أَعْلَمْ أَنَّهُ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، حَتَّى سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُحَدِّثُ أَصْحَابَهُ مَا كَانَ بَيْنَنَا  ، قَالَ : قُلْتُ  لِأَبِي عُثْمَانَ  مَنْ حَدَّثَكَ هَذَا ؟ قَالَ :  حَدَّثَنِي  أُسَامَةُ بْنُ زَيْدٍ  .         [12/347]","","Musnad Abi Ya'la al-Mawsili 6915","","هند بنت أبي أمية زوج رسول الله عن أسامة بن زيد بن حارثة ذو البطين عن أبو عثمان النهدي عن سليمان بن طرخان عن معتمر بن سليمان عن محمد بن إسماعيل بن أبي سمينة عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6919","38 - (  6916  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  الْقَاسِمُ بْنُ الْفَضْلِ الْحُدَّانِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ قَالَ :         [12/348]      كَانَتْ أُمُّ سَلَمَةَ  تَقُولُ  : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْحَجُّ  جِهَادُ  كُلِّ ضَعِيفٍ  .","","Musnad Abi Ya'la al-Mawsili 6916","","هند بنت أبي أمية زوج رسول الله عن أبو جعفر الباقر عن القاسم بن الفضل بن معدان عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6920","39 - (  6917  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذِ بْنِ مُعَاذٍ ،  حَدَّثَنَا  أَبِي ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرٍو اللَّيْثِيُّ ،  عَنْ  عَمْرِو بْنِ مُسْلِمِ بْنِ         [12/349]      عَمَّارِ بْنِ أُكَيْمَةَ قَالَ :  سَمِعْتُ  سَعِيدَ بْنَ الْمُسَيِّبِ يَقُولُ :  سَمِعْتُ  أُمَّ سَلَمَةَ زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ كَانَ لَهُ  ذِبْحٌ  يَذْبَحُهُ ، فَإِذَا أَهَلَّ هِلَالُ ذِي الْحِجَّةِ ، فَلَا يَأْخُذْ مِنْ شَعَرِهِ  وَلَا مِنْ أَظْفَارِهِ حَتَّى يُضَحِّيَ  .","","Musnad Abi Ya'la al-Mawsili 6917","","هند بنت أبي أمية زوج رسول الله عن سعيد بن المسيب عن عمرو بن مسلم بن عمارة الجندعي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6921","40 - (  6918  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ سُلَيْمَانُ بْنُ دَاوُدَ الْبَغْدَادِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ حَرْبٍ قَالَ :  حَدَّثَنِي  مُحَمَّدُ بْنُ الْوَلِيدِ الزُّبَيْدِيُّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ زَوْجِ النَّبِيِّ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِجَارِيَةٍ  كَانَتْ فِي بَيْتِ  أُمِّ سَلَمَةَ  زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَأَى بِوَجْهِهَا  سَفْعَةً  ، فَقَالَ :  بِهَا  نَظْرَةٌ  فَاسْتَرْقُوا  لَهَا  .         [12/350]","","Musnad Abi Ya'la al-Mawsili 6918","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن الزهري عن محمد بن الوليد بن عامر الزبيدي عن محمد بن حرب الأبرش عن سليمان بن داود الأحول عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6922","41 - (  6919  ) -  حَدَّثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الْجَبَّارِ ،  حَدَّثَنَا  أَبُو عَاصِمٍ ،  حَدَّثَنَا  أَبُو كَعْبٍ يَعْنِي صَاحِبَ الْحَرِيرِ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ مِنْ أَكْثَرِ دُعَاءِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا كَانَ فِي بَيْتِي : يَا مُقَلِّبَ الْقُلُوبِ ثَبِّتْ قَلْبِي عَلَى دِينِكَ ، قَالَتْ : قُلْتُ : يَا رَسُولَ اللهِ ، مَا بَالُ هَذَا مِنْ أَكْثَرِ دُعَائِكَ ؟ قَالَ :  إِنَّهُ لَيْسَ مِنْ قَلْبٍ إِلَّا بَيْنَ إِصْبَعَيْنِ مِنْ أَصَابِعِ الرَّبِّ ، مَا شَاءَ أَقَامَ ، وَمَا شَاءَ أَزَاغَ  .","","Musnad Abi Ya'la al-Mawsili 6919","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن عبد ربه بن عبيد الجرموزي عن أبو عاصم النبيل عن سليمان بن عبد الجبار الخياط عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6923","42 - (  6920  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا         [12/351]      حَفْصٌ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  أُمِّ سَلَمَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْرَأُ :         {      بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ         }             {      الْحَمْدُ لِلهِ رَبِّ الْعَالَمِينَ         }      يَعْنِي : حَرْفًا حَرْفًا  .         [12/352]","","Musnad Abi Ya'la al-Mawsili 6920","","هند بنت أبي أمية زوج رسول الله عن ابن أبي مليكة عن ابن جريج عن حفص بن غياث النخعي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6924","43 - (  6921  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  حَدَّثَنَا  إِسْمَاعِيلُ يَعْنِي ابْنَ عَيَّاشٍ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ مُسْلِمٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،         [12/353]      عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يُصَبُّ عَلَى بَوْلِ الْغُلَامِ الْمَاءُ  ، وَيُغْسَلُ بَوْلُ الْجَارِيَةِ  .","","Musnad Abi Ya'la al-Mawsili 6921","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن إسماعيل بن عياش الأحول عن سليمان بن داود العتكي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6925","44 - (  6922  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  يُونُسَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  نَبْهَانَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كُنْتُ أَنَا  وَمَيْمُونَةُ  عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَاءَ  ابْنُ أُمِّ مَكْتُومٍ  يَسْتَأْذِنُ ، وَذَلِكَ بَعْدَ أَنْ ضُرِبَ الْحِجَابُ ، قَالَ : قُومَا ، فَقَالَتَا : إِنَّهُ مَكْفُوفٌ لَا يُبْصِرُنَا ، قَالَ :  أَفَعَمْيَاوَانِ أَنْتُمَا لَا تُبْصِرَانِهِ .  ؟         [12/354]             [12/355]","","Musnad Abi Ya'la al-Mawsili 6922","","هند بنت أبي أمية زوج رسول الله عن نبهان المخزومي مولى أم سلمة عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن المبارك عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6926","45 - (  6923  ) -  حَدَّثَنَا  حَوْثَرَةُ ،  حَدَّثَنَا  مُبَارَكُ بْنُ فَضَالَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّ سَلَمَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ : قَالَ النَّبِيُّ         [12/356]      - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  بَوْلُ الْغُلَامِ يُصَبُّ عَلَيْهِ الْمَاءُ صَبًّا مَا لَمْ يَطْعَمْ  ، وَبَوْلُ الْجَارِيَةِ يُغْسَلُ غَسْلًا طَعِمَتْ أَوْ لَمْ تَطْعَمْ  .","","Musnad Abi Ya'la al-Mawsili 6923","","هند بنت أبي أمية زوج رسول الله عن الحسن البصري عن مبارك بن فضالة عن حوثرة بن أشرس بن عومر العدوي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6927","46 - (  6924  ) -  حَدَّثَنَا  خَالِدُ بْنُ مِرْدَاسٍ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَبَّادِ بْنِ كَثِيرٍ ،  عَنْ  أَبِي عَبْدِ اللهِ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا ابْتُلِيَ أَحَدُكُمْ بِالْقَضَاءِ بَيْنَ الْمُسْلِمِينَ فَلَا يَقْضِ وَهُوَ غَضْبَانُ  ، وَلْيُسَوِّ بَيْنَهُمْ فِي النَّظَرِ ، وَالْمَجْلِسِ ، وَالْإِشَارَةِ ، وَلَا يَرْفَعُ صَوْتَهُ عَلَى أَحَدِ الْخَصْمَيْنِ فَوْقَ الْآخَرِ  .","","Musnad Abi Ya'la al-Mawsili 6924","","هند بنت أبي أمية زوج رسول الله عن عطاء بن يسار الهلالي عن أبو عبد الله مولى إسماعيل بن عبيد المصري عن عباد بن كثير الكاهلي عن إسماعيل بن عياش الأحول عن خالد بن مرداس البغدادي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6928","47 - (  6925  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ الْهُذَلِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَارَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  أُمِّ وَلَدٍ لِإِبْرَاهِيمَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ قَالَتْ :  كُنْتُ أُطِيلُ ذَيْلِي ، فَأَمُرُّ بِالْمَكَانِ الْقَذِرِ وَالْمَكَانِ الطَّيِّبِ ، فَدَخَلْتُ عَلَى أُمِّ سَلَمَةَ ،  فَسَأَلْتُهَا  عَنْ ذَلِكَ ، فَقَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  يُطَهِّرُهُ  مَا بَعْدَهُ  .         [12/357]","","Musnad Abi Ya'la al-Mawsili 6925","","هند بنت أبي أمية زوج رسول الله عن أم ولد عبد الرحمن بن عوف عن محمد بن إبراهيم بن الحارث التيمي عن محمد بن عمارة بن عمرو بن حزم عن عبد الله بن إدريس الأودي عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6929","48 - (  6926  ) -  حَدَّثَنَا  هَارُونُ بْنُ عَبْدِ اللهِ الْحَمَّالُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ سُوقَةَ ،  عَنْ  نَافِعِ بْنِ جُبَيْرٍ ،  سَمِعَ  أُمَّ سَلَمَةَ تَقُولُ :  ذَكَرَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْجَيْشَ الَّذِي يُخْسَفُ بِهِمْ ، قَالَتْ  أُمُّ سَلَمَةَ  : فَقُلْتُ : لَعَلَّ فِيهِمُ الْمُكْرَهَ ؟ قَالَ :  إِنَّهُمْ يُبْعَثُونَ عَلَى نِيَّاتِهِمْ  .         [12/358]             [12/359]","","Musnad Abi Ya'la al-Mawsili 6926","","هند بنت أبي أمية زوج رسول الله عن نافع بن جبير بن مطعم النوفلي عن محمد بن سوقة الغنوي عن سفيان بن عيينة عن هارون بن عبد الله بن مروان الحمال عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6930","49 - (  6927  ) -  حَدَّثَنَا  هَارُونُ ،  حَدَّثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ يُحَنِّسَ قَالَ :  حَدَّثَنِي  يَحْيَى بْنُ أَبِي سُفْيَانَ بْنِ سَعِيدٍ الْأَخْنَسِيُّ ،  عَنْ  جَدَّتِهِ حُكَيْمَةَ  ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّهَا سَمِعَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ أَهَلَّ بِحَجَّةٍ أَوْ عُمْرَةٍ مِنَ  الْمَسْجِدِ الْأَقْصَى  إِلَى  الْمَسْجِدِ الْحَرَامِ  ،  غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ وَمَا تَأَخَّرَ ، أَوْ وَجَبَتْ لَهُ الْجَنَّةُ  ،  شَكَّ  عَبْدُ اللهِ  أَيَّهُمَا قَالَ  .         [12/360]","","Musnad Abi Ya'la al-Mawsili 6927","","هند بنت أبي أمية زوج رسول الله عن حكيمة بنت أمية بن الأخنس عن يحيى بن أبي سفيان الأخنسي عن عبد الله بن عبد الرحمن بن يحنس الحجازي عن محمد بن إسماعيل بن مسلم الديلي عن هارون بن عبد الله بن مروان الحمال عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6931","50 - (  6928  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ الْكُوفِيُّ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  دَاوُدَ بْنِ أَبِي عَبْدِ اللهِ ،  عَنِ  ابْنِ جُدْعَانَ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَعَا خَادِمًا فَأَبْطَأَتْ ، وَفِي يَدِهِ سِوَاكٌ ، فَقَالَ :  لَوْلَا الْقِصَاصُ لَضَرَبْتُكِ بِهَذَا السِّوَاكِ  .","","Musnad Abi Ya'la al-Mawsili 6928","","هند بنت أبي أمية زوج رسول الله عن عبد الرحمن بن محمد القرشي عن داود بن أبي عبد الله الهاشمي عن وكيع بن الجراح عن الحسن بن حماد الوراق عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6932","51 - (  6929  ) -  حَدَّثَنَا  عُمَرُ بْنُ شَبَّةَ أَبُو زَيْدٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَثْمَةَ قَالَ :  حَدَّثَنِي  مُوسَى بْنُ يَعْقُوبَ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ وَهْبٍ ، أَنَّ أَبَاهُ  أَخْبَرَهُ  ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ نَبِيَّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَدْخُلُ عَلَى أَزْوَاجِهِ كُلَّ غَدَاةٍ فَيُسَلِّمُ عَلَيْهِنَّ  ، فَكَانَتْ مِنْهُنَّ  امْرَأَةٌ  عِنْدَهَا عَسَلٌ ، فَكَانَ إِذَا دَخَلَ عَلَيْهَا أَحْضَرَتْ لَهُ مِنْهُ شَيْئًا ، فَيَمْكُثُ عِنْدَهَا ، وَإِنَّ  عَائِشَةَ  وَحَفْصَةَ  وَجَدَتَا مِنْ ذَلِكَ ، فَلَمَّا دَخَلَ عَلَيْهِمَا قَالَتَا : يَا رَسُولَ اللهِ ، إِنَّا نَجِدُ مِنْكَ رِيحَ مَغَافِرَ ، قَالَ : فَتَرَكَ ذَلِكَ الْعَسَلَ  .         [12/361]","","Musnad Abi Ya'la al-Mawsili 6929","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن وهب بن زمعة الغنمي عن يزيد بن عبد الله بن وهب بن زمعة عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن محمد بن خالد بن عثمة الهاشمى عن عمر بن شبة عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6933","52 - (  6930  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  مُوسَى بْنِ أَبِي عَائِشَةَ ،  عَنْ  مَوْلَاةٍ لِأُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا صَلَّى الصُّبْحَ ، ثُمَّ سَلَّمَ قَالَ : اللَّهُمَّ إِنِّي أَسْأَلُكَ عِلْمًا نَافِعًا  ، وَرِزْقًا طَيِّبًا ، وَعَمَلًا مُتَقَبَّلًا  .         [12/362]","","Musnad Abi Ya'la al-Mawsili 6930","","هند بنت أبي أمية زوج رسول الله عن مولى أم سلمة عن موسى بن أبي عائشة المخزومي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6934","53 - (  6931  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  أَبِي نَصْرٍ ،  عَنْ  مُسَاوِرٍ الْحِمْيَرِيِّ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ  :  لَا يُحِبُّ  عَلِيًّا  مُنَافِقٌ ، وَلَا يُبْغِضُهُ مُؤْمِنٌ  .","","Musnad Abi Ya'la al-Mawsili 6931","","هند بنت أبي أمية زوج رسول الله عن أم مساور الحميرية عن مساور الحميري عن عبد الله بن عبد الرحمن الضبي عن محمد بن فضيل بن غزوان عن الحسن بن حماد الوراق عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6935","54 - (  6932  ) -  حَدَّثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  حَدَّثَنَا  يُونُسُ بْنُ         [12/363]      بُكَيْرٍ ،  حَدَّثَنَا  طَلْحَةُ بْنُ يَحْيَى ،  عَنْ  أُمِّ كُلْثُومٍ بِنْتِ عَبْدِ اللهِ بْنِ زَمْعَةَ  ،  أَنَّ  جَدَّتَهَا أُمَّ سَلَمَةَ زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَفَعَتْ إِلَيْهَا  مِخْضَبًا  مِنْ صُفْرٍ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَغْتَسِلُ فِي هَذَا  ،  قَالَ  طَلْحَةُ  :  فَأَرَتْنِيهِ  أُمُّ كُلْثُومٍ  ، كَانَ نَحْوَ الصَّاعِ أَوْ أَكْبَرَ قَلِيلًا  .","","Musnad Abi Ya'la al-Mawsili 6932","","هند بنت أبي أمية زوج رسول الله عن أم كلثوم بنت عبد الله بن زمعة عن طلحة بن يحيى بن طلحة التيمي عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6936","55 - (  6933  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  حَدَّثَنَا  مُحَمَّدٌ يَعْنِي غُنْدَرًا ،  حَدَّثَنَا  شُعْبَةُ قَالَ :  سَمِعْتُ  أَبَا إِسْحَاقَ ،  أَنَّهُ سَمِعَ  أَبَا سَلَمَةَ  يُحَدِّثُ ، عَنْ  أُمِّ سَلَمَةَ ، أَنَّهَا قَالَتْ :  مَا مَاتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى         [12/364]      كَانَتْ أَكْثَرُ صَلَاتِهِ قَاعِدًا غَيْرَ الْفَرِيضَةِ  ، وَكَانَ أَحَبَّ الْعَمَلِ إِلَيْهِ أَدْوَمُهُ وَإِنْ قَلَّ  .","","Musnad Abi Ya'la al-Mawsili 6933","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6937","56 - (  6934  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  أُمِّ مُوسَى ،  عَنْ  أُمِّ سَلَمَةَ قَالَتْ :  وَالَّذِي يُحْلَفُ بِهِ إِنْ كَانَ  عَلِيٌّ  لَأَقْرَبَ النَّاسِ عَهْدًا بِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - ، قَالَتْ : كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَ قُبِضَ فِي بَيْتِ  عَائِشَةَ  ، فَجَعَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - غَدَاةً بَعْدَ غَدَاةٍ يَقُولُ : جَاءَ  عَلِيٌّ  ؟ مِرَارًا ، قَالَتْ : وَأَظُنُّهُ كَانَ بَعَثَهُ فِي حَاجَةٍ ، قَالَ : فَجَاءَ بَعْدُ ، فَظَنَنَّا أَنَّ لَهُ إِلَيْهِ حَاجَةً ، فَخَرَجْنَا مِنَ الْبَيْتِ ، فَقَعَدْنَا عِنْدَ الْبَابِ ، فَكُنْتُ مِنْ أَدْنَاهُمْ ، فَأَكَبَّ عَلَيْهِ  عَلِيٌّ  فَجَعَلَ يُسَارُّهُ وَيُنَاجِيهِ ، ثُمَّ قُبِضَ مِنْ يَوْمِهِ ذَلِكَ  .         [12/365]","","Musnad Abi Ya'la al-Mawsili 6934","","هند بنت أبي أمية زوج رسول الله عن أم موسى سرية علي بن أبي طالب عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6938","57 - (  6935  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ الْبَخْتَرِيِّ الْوَاسِطِيُّ ،  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ الْأَنْصَارِيِّ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  أُمِّ سَلَمَةَ قَالَتْ :  دَخَلَ عَلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعِنْدِي  صَبِيٌّ  يَشْتَكِي ، فَقَالَ : مَا لَهُ ؟ فَقُلْنَا : اتَّهَمْنَا لَهُ الْعَيْنَ ، فَقَالَ :  أَلَا تَسْتَرْقُونَ لَهُ مِنَ الْعَيْنِ . ؟","","Musnad Abi Ya'la al-Mawsili 6935","","هند بنت أبي أمية زوج رسول الله عن عروة بن الزبير عن سليمان بن يسار مولى ميمونة زوج رسول الله عن يحيى بن سعيد الأنصاري عن عبد الله بن نمير عن محمد بن إسماعيل بن البختري الحسانى عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6939","58 - (  6936  ) -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَفِينَةَ مَوْلَى أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ قَالَتْ :  كَانَتْ عَامَّةُ وَصِيَّةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي مَرَضِهِ :  الصَّلَاةَ وَمَا  مَلَكَتْ  أَيْمَانُكُمْ  ، حَتَّى جَعَلَ  يُلَجْلِجُهَا         [12/366]      فِي صَدْرِهِ وَمَا يَفِيضُ بِهَا لِسَانُهُ  .         [12/367]","","Musnad Abi Ya'la al-Mawsili 6936","","هند بنت أبي أمية زوج رسول الله عن سفينة مولى رسول الله عن قتادة بن دعامة عن الوضاح بن عبد الله اليشكري عن عبد الواحد بن غياث عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6940","59 - (  6937  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُعَاوِيَةَ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّ سَلَمَةَ قَالَتْ :  بَيْنَمَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مُضْطَجِعٌ فِي بَيْتِي إِذِ  احْتَفَزَ  جَالِسًا وَهُوَ يَسْتَرْجِعُ ، فَقُلْتُ : بِأَبِي أَنْتَ وَأُمِّي ، مَا شَأْنُكَ تَسْتَرْجِعُ ؟ قَالَ :  لِجَيْشٍ مِنْ أُمَّتِي يَجِيئُونَ مِنْ قِبَلِ  الشَّامِ  يَؤُمُّونَ  الْبَيْتَ  لِرَجُلٍ يَمْنَعُهُمُ اللهُ مِنْهُ  ، حَتَّى إِذَا كَانُوا  بِالْبَيْدَاءِ  مِنْ  ذِي الْحُلَيْفَةِ  خُسِفَ بِهِمْ ، وَمَصَادِرُهُمْ  شَتَّى  ، قُلْتُ : بِأَبِي أَنْتَ ، كَيْفَ يُخْسَفُ بِهِمْ جَمِيعًا وَمَصَادِرُهُمْ  شَتَّى  ؟ قَالَ : إِنَّ مِنْهُمْ مَنْ جُبِرَ ، إِنَّ مِنْهُمْ مَنْ جُبِرَ ، إِنَّ مِنْهُمْ مَنْ جُبِرَ  .         [12/368]","","Musnad Abi Ya'la al-Mawsili 6937","","هند بنت أبي أمية زوج رسول الله عن الحسن البصري عن علي بن زيد بن جدعان عن حماد بن سلمة عن عبد الله بن معاوية الجمحي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6941","60 - (  6938  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُعَاوِيَةَ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي عِمْرَانَ الْجَوْنِيِّ ،  عَنْ  يُوسُفَ بْنِ سَعْدٍ ،  عَنْ  عَائِشَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِمِثْلِهِ .         [12/369]","","Musnad Abi Ya'la al-Mawsili 6938","","عائشة بنت أبي بكر الصديق عن يوسف بن سعد الراسبي عن عبد الملك بن حبيب الجوني عن حماد بن سلمة عن عبد الله بن معاوية الجمحي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6942","61 - (  6939  ) -  حَدَّثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الْجَبَّارِ ،  حَدَّثَنَا  أَبُو عَاصِمٍ ،  عَنْ  عُثْمَانَ بْنِ مُرَّةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  خَالَتِهِ أُمِّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الَّذِي يَشْرَبُ فِي إِنَاءِ فِضَّةٍ  ، إِنَّمَا  يُجَرْجِرُ  فِي بَطْنِهِ نَارَ  جَهَنَّمَ  .","","Musnad Abi Ya'la al-Mawsili 6939","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن عبد الرحمن بن أبي بكر الصديق عن عثمان بن مرة البصري عن أبو عاصم النبيل عن سليمان بن عبد الجبار الخياط عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6943","62 - (  6940  ) -  حَدَّثَنَا  أَبُو هِشَامٍ الرِّفَاعِيُّ ،  حَدَّثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  حَدَّثَنَا  هِشَامُ بْنُ أَبِي عَبْدِ اللهِ ،  عَنْ  قَتَادَةَ ،  عَنْ  صَالِحٍ أَبِي الْخَلِيلِ ،  عَنْ  صَاحِبٍ لَهُ ،  وَرُبَّمَا قَالَ :  صَالِحٌ  ،  عَنْ  مُجَاهِدٍ  ،         [12/370]      عَنْ  أُمِّ سَلَمَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَكُونُ اخْتِلَافٌ عِنْدَ مَوْتِ  خَلِيفَةٍ  ، فَيَخْرُجُ رَجُلٌ مِنْ قُرَيْشٍ مِنْ  أَهْلِ الْمَدِينَةِ  إِلَى  مَكَّةَ  ، فَيَأْتِيهِ نَاسٌ مِنْ  أَهْلِ مَكَّةَ  ، فَيُخْرِجُونَهُ وَهُوَ كَارِهٌ ،  فَيُبَايِعُهُمْ  بَيْنَ  الْمَقَامِ  وَالرُّكْنِ  ، فَيَبْعَثُونَ إِلَيْهِ جَيْشًا مِنَ  الشَّامِ  ، فَإِذَا كَانُوا  بِالْبَيْدَاءِ  خُسِفَ بِهِمْ ، فَإِذَا بَلَغَ النَّاسَ ذَلِكَ ، أَتَاهُ  أَبْدَالُ  أَهْلِ الشَّامِ  ،  وَعَصَائِبُ  مِنْ  أَهْلِ الْعِرَاقِ  فَيُبَايِعُونَهُ  ، وَيَنْشَأُ رَجُلٌ مِنْ  قُرَيْشٍ  ، أَخْوَالُهُ  كَلْبٌ  فَيَبْعَثُ إِلَيْهِمْ  بَعْثًا ، أَوْ قَالَ : جَيْشًا  فِيهِمْ مُؤْمِنُهُمْ ، وَيَظْهَرُونَ عَلَيْهِمْ ، فَيَقْسِمُ بَيْنَ النَّاسِ فَيْئَهُمْ وَيُعْمِلُ فِيهِمْ سُنَّةَ نَبِيِّهِمْ ، وَيُلْقِي الْإِسْلَامُ  بِجِرَانِهِ  إِلَى الْأَرْضِ يَمْكُثُ سَبْعَ سِنِينَ  .","","Musnad Abi Ya'la al-Mawsili 6940","","هند بنت أبي أمية زوج رسول الله عن صاحب صالح بن أبي مريم الضبعي عن صالح بن أبي مريم الضبعي عن قتادة بن دعامة عن هشام الدستوائي عن وهب بن جرير بن حازم عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6944","63 - (  6941  ) -  حَدَّثَنَا  سُفْيَانُ بْنُ وَكِيعٍ ،  حَدَّثَنَا  عَبْدُ الْوَهَّابِ الثَّقَفِيُّ يَعْنِي  عَنْ  خَالِدٍ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  كَانَ مَفْرَشِي حِيَالَ مُصَلَّى رَسُولِ اللهِ وَكَانَ يُصَلِّي وَأَنَا حِيَالُهُ  .         [12/371]","","Musnad Abi Ya'la al-Mawsili 6941","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو قلابة الجرمي عن خالد الحذاء عن عبد الوهاب بن عبد المجيد الثقفي عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6945","64 - (  6942  ) -  حَدَّثَنَا  سُفْيَانُ بْنُ وَكِيعٍ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  دَاوُدَ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ جُدْعَانَ  ،  عَنْ  جَدَّتِهِ  ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَتَاهُ  أَبُو الْهَيْثَمِ الْأَنْصَارِيُّ  فَاسْتَخْدَمَهُ ، فَوَعَدَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِنْ أَصَابَ سَبْيًا ، فَلَقِيَ  عُمَرَ  ، فَقَالَ لَهُ : يَا  أَبَا الْهَيْثَمِ  ، إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَدْ أَصَابَ سَبْيًا ، فَأْتِهِ فَتَنَجَّزْ عِدَتَكَ ، فَمَضَى  أَبُو الْهَيْثَمِ  وَعُمَرُ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ،  أَبُو الْهَيْثَمِ  أَتَاكَ يَتَنَجَّزُ عِدَتَهُ ، فَقَالَ لَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :         [12/372]      وَقَدْ أَصَبْنَا غُلَامَيْنِ أَسْوَدَيْنِ ، اخْتَرْ أَيَّهُمَا شِئْتَ ، قَالَ : فَإِنِّي أَسْتَشِيرُكَ ، فَقَالَ :  الْمُسْتَشَارُ مُؤْتَمَنٌ ، خُذْ هَذَا فَقَدْ صَلَّى عِنْدَنَا وَلَا تَضْرِبْهُ  ، فَإِنَّا نُهِينَا عَنْ ضَرْبِ الْمُصَلِّينَ  .  أشار محقق طبعة دار المأمون إلى أنه كذا في جميع النسخ والمسند ، وصوابه: ( عبد الرحمن بن محمد بن جدعان ) كما دلت عليه جميع كتب التراجم ، ومصادر تخريج الحديث.","","Musnad Abi Ya'la al-Mawsili 6942","","هند بنت أبي أمية زوج رسول الله عن جدة عبد الرحمن بن محمد بن جدعان عن عبد الرحمن بن محمد القرشي عن داود بن أبي عبد الله الهاشمي عن وكيع بن الجراح عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6946","65 - (  6943  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ، وَهُدْبَةُ بْنُ خَالِدٍ ، وَحَوْثَرَةُ بْنُ أَشْرَسَ ، وَعَلِيُّ بْنُ الْجَعْدِ ، وَعَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ، قَالُوا :  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي الْعُشَرَاءِ الدَّارِمِيِّ ،  عَنْ  أَبِيهِ  قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، أَمَا تَكُونُ الذَّكَاةُ إِلَّا بَيْنَ  اللَّبَّةِ  أَوِ الْحَلْقِ ؟ قَالَ :  بَلَى ، لَوْ طَعَنْتَ فِي فَخِذِهَا لَأَجْزَأَ عَنْكَ  .         [12/373]      وَفِي حَدِيثِ  حَوْثَرَةَ  وَالَّذِي نَفْسِي بِيَدِهِ ، لَوْ طَعَنْتَ فِي فَخِذِهَا لَأَجْزَأَ عَنْكَ  .","","Musnad Abi Ya'la al-Mawsili 6943","","مالك بن قهطم الدارمي عن أبو العشراء الدارمي عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6947","66 - (  6944  ) -  حَدَّثَنَا  سُفْيَانُ بْنُ وَكِيعٍ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  دَاوُدَ بْنِ أَبِي عَبْدِ اللهِ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ جُدْعَانَ الْقُرَشِيِّ ،  عَنْ  جَدَّتِهِ  ،  عَنْ  أُمِّ سَلَمَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي بَيْتِي وَكَانَ بِيَدِهِ سِوَاكٌ ، فَدَعَا وَصِيفَةً  لَهُ ، أَوْ لَهَا  ، حَتَّى  اسْتَأْثَرَ  الْغَضَبُ فِي وَجْهِهِ ، فَخَرَجَتْ  أُمُّ سَلَمَةَ  إِلَى الْحُجُرَاتِ ، فَوَجَدَتِ الْوَصِيفَةَ وَهِيَ تَلْعَبُ بِبَهِيمَةٍ ، فَقَالَتْ : أَلَا أَرَاكِ تَلْعَبِينَ بِهَذِهِ الْبَهِيمَةِ وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَدْعُوكِ ؟ فَقَالَتْ : لَا وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا سَمِعْتُكَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَوْلَا خَشْيَةُ الْقَوَدِ ، لَأَوْجَعْتُكِ بِهَذَا السِّوَاكِ . ؟","","Musnad Abi Ya'la al-Mawsili 6944","","هند بنت أبي أمية زوج رسول الله عن جدة عبد الرحمن بن محمد بن جدعان عن عبد الرحمن بن محمد القرشي عن داود بن أبي عبد الله الهاشمي عن وكيع بن الجراح عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6948","67 - (  6945  ) -  حَدَّثَنَا  أَبُو الْحُسَيْنِ الرَّازِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُزَيْزٍ قَالَ :  أَخْبَرَنِي  سَلَامَةُ ،  عَنْ  عُقَيْلٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ أَخْبَرَهُ ، أَنَّ سَفِينَةَ مَوْلَى أُمِّ سَلَمَةَ ، زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَخْبَرَهُ  ،  أَنَّ  أُمَّ سَلَمَةَ زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ : قَالَ رَسُولُ اللهِ         [12/374]      - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَصْحَبُ الْمَلَائِكَةُ رُفْقَةً فِيهَا  جَرَسٌ  .         [12/375]","","Musnad Abi Ya'la al-Mawsili 6945","","هند بنت أبي أمية زوج رسول الله عن سفينة مولى رسول الله عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عقيل بن خالد الأيلي عن سلامة بن روح الأيلي عن محمد بن عزيز بن عبد الله الأيلي عن أبو الحسين الرازي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6949","68 - (  6946  ) -  حَدَّثَنَا  أَبُو مُوسَى مُحَمَّدُ بْنُ الْمُثَنَّى ،  حَدَّثَنَا  يَحْيَى بْنُ كَثِيرٍ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي الْمُجَالِدِ ،  عَنْ  عَبْدِ اللهِ بْنِ شَدَّادِ بْنِ الْهَادِ ،  عَنْ  أُمِّ سَلَمَةَ أَنَّهَا ، قَالَتْ :  صَلَّى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي بَيْتِي رَكْعَتَيْنِ  ، فَقُلْتُ لَهُ : مَا هَاتَانِ ؟ قَالَ : كُنْتُ أُصَلِّيهِمَا قَبْلَ الْعَصْرِ  .         [12/376]             [12/377]             [12/378]             [12/379]","","Musnad Abi Ya'la al-Mawsili 6946","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن شداد بن الهاد الليثي عن عبد الله بن أبي المجالد الكوفي عن شعبة بن الحجاج عن يحيى بن كثير العنبري عن أبو موسى الزمن عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6950","69 - (  6947  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  حَدَّثَنَا  أَبُو مَعْشَرٍ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عُمَرَ بْنِ أَبَانَ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  أَبَانَ بْنِ عُثْمَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ قَالَ :  بَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَالِسٌ  وَعَائِشَةُ  وَرَاءَهُ ، إِذِ اسْتَأْذَنَ  أَبُو بَكْرٍ  فَدَخَلَ ، ثُمَّ اسْتَأْذَنَ  عُمَرُ  فَدَخَلَ ، ثُمَّ اسْتَأْذَنَ  عَلِيٌّ  فَدَخَلَ ، ثُمَّ اسْتَأْذَنَ  سَعْدُ بْنُ مَالِكٍ  فَدَخَلَ ، ثُمَّ اسْتَأْذَنَ  عُثْمَانُ بْنُ عَفَّانَ  فَدَخَلَ ، وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَتَحَدَّثُ كَاشِفًا عَنْ رُكْبَتِهِ ، فَمَدَّ ثَوْبَهُ عَلَى رُكْبَتَيْهِ وَقَالَ لِامْرَأَتِهِ : اسْتَأْخِرِي عَنِّي ، فَتَحَدَّثُوا سَاعَةً ، ثُمَّ خَرَجُوا ، قَالَتْ  عَائِشَةُ  : فَقُلْتُ : يَا رَسُولَ اللهِ ، دَخَلَ عَلَيْكَ         [12/380]      أَصْحَابُكَ فَلَمْ تُصْلِحْ ثَوْبَكَ ، وَلَمْ تُؤَخِّرْنِي عَنْكَ حَتَّى دَخَلَ  عُثْمَانُ  ؟ فَقَالَ :  يَا  عَائِشَةُ  ، أَلَا أَسْتَحِي مِنْ رَجُلٍ تَسْتَحِي مِنْهُ الْمَلَائِكَةُ ؟  وَالَّذِي نَفْسُ  مُحَمَّدٍ  بِيَدِهِ ، إِنَّ الْمَلَائِكَةَ لَتَسْتَحِي مِنْ  عُثْمَانَ  كَمَا تَسْتَحِي مِنَ اللهِ وَرَسُولِهِ ، وَلَوْ دَخَلَ وَأَنْتِ قَرِيبَةٌ مِنِّي ، لَمْ يَرْفَعْ رَأْسَهُ ، وَلَمْ يَتَحَدَّثْ حَتَّى يَخْرُجَ  .         [12/381]","","Musnad Abi Ya'la al-Mawsili 6947","","عبد الله بن عمر بن الخطاب عن أبان بن عثمان بن عفان عن عمر بن أبان بن عثمان بن عفان عن إبراهيم بن عمر بن أبان البصري عن يوسف بن يزيد البراء عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6951","70 - (  6948  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الصَّمَدِ بْنِ أَبِي خِدَاشٍ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ قَالَ :  قَالَتْ  أُمُّ سَلَمَةَ  : لَمَّا مَاتَ  أَبُو سَلَمَةَ  قُلْتُ : غَرِيبٌ ، وَبِأَرْضِ غُرْبَةٍ ، لَأَبْكِيَنَّهُ بُكَاءً يُتَحَدَّثُ بِهِ ، قَالَتْ : فَبَيْنَا أَنَا كَذَلِكَ إِذْ تَهَيَّأْتُ لِلْبُكَاءِ عَلَيْهِ ، إِذْ أَقْبَلَتِ  امْرَأَةٌ  مِنَ الصَّعِيدِ تُرِيدُ أَنْ تُسْعِدَنِي عَلَيْهِ ، فَلَقِيَهَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ لَهَا :  تُرِيدِينَ أَنْ تُدْخِلِي الشَّيْطَانَ بَيْتًا قَدْ أَخْرَجَهُ اللهُ مِنْهُ ؟  فَكَفَفْتُ عَنِ الْبُكَاءِ  .         [12/382]","","Musnad Abi Ya'la al-Mawsili 6948","","هند بنت أبي أمية زوج رسول الله عن عبيد بن عمير بن قتادة الجندعي عن يسار الثقفي مولى الأخنس بن شريق عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن عبد الله بن عبد الصمد عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6952","71 - (  6949  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى الْخُتَّلِيُّ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  حَدَّثَنَا  مُوسَى بْنُ عُبَيْدَةَ الرَّبَذِيُّ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَيَّاشٍ الزُّرَقِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  رَأَيْتُ مَا تَعْمَلُ أُمَّتِي بَعْدِي ، فَاخْتَرْتُ لَهُمُ الشَّفَاعَةَ يَوْمَ الْقِيَامَةِ  .","","Musnad Abi Ya'la al-Mawsili 6949","","هند بنت أبي أمية زوج رسول الله عن أنس بن مالك عن سعيد بن عبد الرحمن بن أبي عياش عن موسى بن عبيدة بن نشيط الحميري عن أبو معاوية الضرير عن مجاهد بن موسى عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6953","72 - (  6950  ) -  حَدَّثَنَا  مُجَاهِدٌ ،  حَدَّثَنِي  بَهْزٌ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  مُوسَى بْنِ أَبِي عَائِشَةَ ،  عَنْ  مَوْلًى لِأُمِّ سَلَمَةَ ،         [12/383]      عَنْ  أُمِّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا أَصْبَحَ قَالَ : اللَّهُمَّ إِنِّي أَسْأَلُكَ عِلْمًا نَافِعًا  ، وَرِزْقًا طَيِّبًا ، وَعَمَلًا مُتَقَبَّلًا  .","","Musnad Abi Ya'la al-Mawsili 6950","","هند بنت أبي أمية زوج رسول الله عن مولى أم سلمة عن موسى بن أبي عائشة المخزومي عن شعبة بن الحجاج عن بهز بن أسد عن مجاهد بن موسى عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6954","73 - (  6951  ) -  حَدَّثَنَا  سَهْلُ بْنُ زَنْجَلَةَ ،  حَدَّثَنَا  ابْنُ أَبِي أُوَيْسٍ قَالَ :  حَدَّثَنِي  أَبِي ،  عَنْ  عِكْرِمَةَ بْنِ عَمَّارٍ ،  عَنْ  أُثَالِ بْنِ قُرَّةَ ،  عَنِ  ابْنِ حَوْشَبٍ الْحَنَفِيِّ قَالَ :  حَدَّثَتْنِي  أُمُّ سَلَمَةَ ، قَالَتْ :  جَاءَتْ  فَاطِمَةُ بِنْتُ النَّبِيِّ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  مُتَوَرِّكَةً  الْحَسَنَ  وَالْحُسَيْنَ  ، فِي يَدِهَا  بُرْمَةٌ  لِلْحَسَنِ  ، فِيهَا  سَخِينٌ  ، حَتَّى أَتَتْ بِهَا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا وَضَعَتْهَا قُدَّامَهُ قَالَ لَهَا : أَيْنَ  أَبُو الْحَسَنِ  ؟ قَالَتْ : فِي الْبَيْتِ ، فَدَعَاهُ ، فَجَلَسَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَعَلِيٌّ  ،  وَفَاطِمَةُ  ،  وَالْحَسَنُ  ،  وَالْحُسَيْنُ  يَأْكُلُونَ ، قَالَتْ  أُمُّ سَلَمَةَ  : وَمَا  سَامَنِي  النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَا أَكَلَ طَعَامًا         [12/384]      قَطُّ إِلَّا وَأَنَا عِنْدَهُ ، إِلَّا سَامَيْتُهُ قَبْلَ ذَلِكَ الْيَوْمِ ، تَعْنِي بِـ""  سَامَنِي  "" : دَعَانِي إِلَيْهِ ، فَلَمَّا فَرَغَ  الْتَفَّ  عَلَيْهِمْ بِثَوْبِهِ ، ثُمَّ قَالَ :  اللَّهُمَّ عَادِ مَنْ عَادَاهُمْ ، وَوَالِ مَنْ وَالَاهُمْ  .","","Musnad Abi Ya'la al-Mawsili 6951","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن أثال بن قرة اليمامي عن عكرمة بن عمار عن عبد الله بن عبد الله بن أويس عن إسماعيل بن أبي أويس عن سهل بن أبي سهل الأشتر عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6955","74 - (  6952  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  حَدَّثَنَا  خُصَيْفٌ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  لَمَّا نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ لُبْسِ الذَّهَبِ ، قُلْنَا : يَا رَسُولَ اللهِ ، أَفَلَا نَرْبِطُ  الْمَسَكَ  بِالذَّهَبِ ؟ قَالَ :  أَفَلَا تَرْبِطُونَهُ بِفِضَّةٍ ثُمَّ تُلَطِّخُونَهُ بِزَعْفَرَانٍ فَيَكُونُ مِثْلَ الذَّهَبِ . ؟         [12/385]","","Musnad Abi Ya'la al-Mawsili 6952","","عائشة بنت أبي بكر الصديق عن مجاهد بن جبر المخزومي عن خصيف الجزري عن محمد بن سلمة الباهلي عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6956","75 - (  6953  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  مُحَمَّدٌ ،  عَنْ  خُصَيْفٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  أُمِّ سَلَمَةَ ، مِثْلَ ذَلِكَ .","","Musnad Abi Ya'la al-Mawsili 6953","","هند بنت أبي أمية زوج رسول الله عن عطاء بن أبي رباح عن خصيف الجزري عن محمد بن سلمة الباهلي عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6957","76 - (  6954  ) -  حَدَّثَنَا  كَامِلٌ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّهَا رَأَتْ نَسِيبًا لَهَا يَنْفُخُ إِذَا أَرَادَ أَنْ يَسْجُدَ ، فَقَالَتْ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ لِغُلَامٍ يُقَالُ لَهُ  رَبَاحٌ  : تَرِّبْ وَجْهَكَ  .         [12/386]             [12/387]             [12/388]","","Musnad Abi Ya'la al-Mawsili 6954","","هند بنت أبي أمية زوج رسول الله عن ذكوان السمان عن عاصم بن بهدلة عن حماد بن سلمة عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6958","77 - (  6955  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ قَالَ :  قَالَتْ  أُمُّ سَلَمَةَ :  لَمَّا مَاتَ  أَبُو سَلَمَةَ  ، قُلْتُ : غَرِيبٌ ، وَبِأَرْضِ غُرْبَةٍ ؟ لَأَبْكِيَنَّهُ بُكَاءً يُتَحَدَّثُ عَنْهُ ، فَبَيْنَا أَنَا كَذَلِكَ إِذْ أَقْبَلَتِ  امْرَأَةٌ  مِنَ الصَّعِيدِ ، فَقَالَ لَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَتُرِيدِينَ أَنْ تُدْخِلِي الشَّيْطَانَ بَيْتًا أَخْرَجَهُ اللهُ مِنْهُ ؟  قَالَتْ : فَكَفَفْتُ عَنْ ذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 6955","","هند بنت أبي أمية زوج رسول الله عن عبيد بن عمير بن قتادة الجندعي عن يسار الثقفي مولى الأخنس بن شريق عن عبد الله بن عبد الله بن أويس عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6959","78 - (  6956  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  نَبْهَانَ ،  عَنْ  أُمِّ سَلَمَةَ ذَكَرَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنْ كَانَ لِإِحْدَاكُنَّ مُكَاتَبٌ ، وَكَانَ عِنْدَهُ مَا يُؤَدِّي ، فَلْتَحْتَجِبْ مِنْهُ  .         [12/389]","","Musnad Abi Ya'la al-Mawsili 6956","","هند بنت أبي أمية زوج رسول الله عن نبهان المخزومي مولى أم سلمة عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6960","79 - (  6957  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  أَيُّوبَ بْنِ مُوسَى ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ رَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّهَا قَالَتْ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنِّي امْرَأَةٌ أَشُدُّ  ضَفْرَ  رَأْسِي ، أَفَأَحُلُّهُ  لِغُسْلِ  الْجَنَابَةِ ؟         [12/390]      قَالَ :  إِنَّمَا يَكْفِيكِ أَنْ تَحْثِي عَلَيْهِ ثَلَاثَ  حَثَيَاتٍ  مِنْ مَاءٍ  ، ثُمَّ تُفِيضِي عَلَيْهِ ، فَإِذَا أَنْتِ قَدْ طَهُرْتِ  .         [12/391]","","Musnad Abi Ya'la al-Mawsili 6957","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن سعيد المقبري عن أيوب بن موسى الأموي عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6961","80 - (  6958  ) -  حَدَّثَنَا  دَاوُدُ بْنُ عَمْرِو بْنِ زُهَيْرٍ الضَّبِّيُّ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  عَنْ  رَجُلٍ مِنْ وَلَدِ أُمِّ سَلَمَةَ وَاسْمُهُ سَلَمَةُ بْنُ عُمَرَ بْنِ أَبِي سَلَمَةَ قَالَ :  قَالَتْ  أُمُّ سَلَمَةَ  :  يَا رَسُولَ اللهِ ، مَا أَسْمَعُ اللهَ ذَكَرَ النِّسَاءَ         [12/392]      فِي الْهِجْرَةِ ؟  فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ :         {      فَاسْتَجَابَ لَهُمْ رَبُّهُمْ أَنِّي لا أُضِيعُ عَمَلَ عَامِلٍ مِنْكُمْ مِنْ ذَكَرٍ أَوْ أُنْثَى         }      إِلَى آخِرِ الْآيَةِ  ،  قَالَ  دَاوُدُ :  قَالَ  سُفْيَانُ :  بِهَذِهِ الْآيَةِ خَرَجَتِ الْخَوَارِجُ ، وَبِهَا خَرَجْنَ النِّسَاءُ  .         [12/393]","","Musnad Abi Ya'la al-Mawsili 6958","","هند بنت أبي أمية زوج رسول الله عن سلمة بن عبد الله المخزومي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن داود بن عمرو المسيبي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6962","81 - (  6959  ) -  حَدَّثَنَا  دَاوُدُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ قَالَ :  قَالَتْ  أُمُّ سَلَمَةَ :  يَا رَسُولَ اللهِ ، يَغْزُو الرِّجَالُ وَلَا نَغْزُو  ، وَإِنَّمَا لَنَا نِصْفُ الْمِيرَاثِ ؟ فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ :         {      وَلا تَتَمَنَّوْا مَا فَضَّلَ اللهُ بِهِ بَعْضَكُمْ عَلَى بَعْضٍ         }      قَالَ : وَنَزَلَتْ فِيهَا هَذِهِ الْآيَةُ         {      إِنَّ الْمُسْلِمِينَ وَالْمُسْلِمَاتِ وَالْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ         }      إِلَى آخِرِ الْآيَةِ  .         [12/394]","","Musnad Abi Ya'la al-Mawsili 6959","","هند بنت أبي أمية زوج رسول الله عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن داود بن عمرو المسيبي عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6963","82 - (  6960  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَالِسًا فِي بَيْتِ  أُمِّ سَلَمَةَ  وَعِنْدَهُ مُخَنَّثٌ جَالِسٌ ، فَقَالَ  لِعَبْدِ اللهِ بْنِ أَبِي أُمَيَّةَ  أَخِي  أُمِّ سَلَمَةَ  : يَا  عَبْدَ اللهِ  ، إِنْ فَتَحَ اللهُ عَلَيْكُمُ  الطَّائِفَ  غَدًا فَإِنِّي أَدُلُّكَ عَلَى  ابْنَةِ غَيْلَانَ  امْرَأَةٍ مِنْ  ثَقِيفَ  ، تُقْبِلُ بِأَرْبَعٍ وَتُدْبِرُ بِثَمَانٍ ،         [12/395]      فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَدْخُلْ هَذَا عَلَيْكُمْ  .         [12/396]","","Musnad Abi Ya'la al-Mawsili 6960","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6964","83 - (  6961  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  حُمَيْدِ بْنِ نَافِعٍ ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّهَا أُمِّ سَلَمَةَ  ، وَأُمِّ حَبِيبَةَ ، زَوْجَتَيِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتَا  : جَاءَتِ  امْرَأَةٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ : يَا رَسُولَ اللهِ ، إِنَّ ابْنَتِي تُوُفِّيَ زَوْجُهَا ، وَأَنَا أَتَخَوَّفُ عَلَى عَيْنِهَا أَفَأَكْحُلُهَا ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قَدْ كَانَتِ الْمَرْأَةُ مِنْكُنَّ تَرْمِي بِالْبَعْرَةِ عَلَى رَأْسِ الْحَوْلِ ،         [12/397]      وَإِنَّمَا هِيَ أَرْبَعَةُ أَشْهُرٍ وَعَشْرٌ  .         [12/398]","","Musnad Abi Ya'la al-Mawsili 6961","","رملة بنت أبي سفيان زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن حميد بن نافع حميد صفيرا عن يحيى بن سعيد الأنصاري عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6965","84 - (  6962  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  يَحْيَى ،  عَنْ  عِرَاكِ بْنِ مَالِكٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي بَكْرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أُمِّ سَلَمَةَ قَالَتْ :  قَدْ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصْبِحُ  جُنُبًا  مِنَ النِّسَاءِ مِنْ غَيْرِ حُلُمٍ ، ثُمَّ يَظَلُّ صَائِمًا  .","","Musnad Abi Ya'la al-Mawsili 6962","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن عبد الملك بن أبي بكر المخزومي عن عراك بن مالك الغفاري عن يحيى بن سعيد الأنصاري عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6966","85 - (  6963  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الْحَكَمِ ،  عَنْ  مِقْسَمٍ ،  عَنْ  أُمِّ سَلَمَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُوتِرُ بِسَبْعٍ وَخَمْسٍ  لَا يَفْصِلُ بَيْنَهُنَّ بِسَلَامٍ وَلَا كَلَامٍ  .         [12/399]             [12/400]","","Musnad Abi Ya'la al-Mawsili 6963","","هند بنت أبي أمية زوج رسول الله عن مقسم بن بجرة عن الحكم بن عتيبة الكندي عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6967","86 - (  6964  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  شَقِيقٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا حَضَرْتُمُ  الْمَرِيضَ أَوِ الْمَيِّتَ  فَقُولُوا خَيْرًا ، فَإِنَّ الْمَلَائِكَةَ يُؤَمِّنُونَ عَلَى مَا تَقُولُونَ  .         [12/401]      فَلَمَّا تُوُفِّيَ  أَبُو سَلَمَةَ  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قُلْتُ : كَيْفَ أَقُولُ ؟ قَالَ : قُولِي : اللَّهُمَّ اغْفِرْ لَنَا وَلَهُ ، وَاعْقُبْنَا مِنْهُ عُقْبَى صَالِحَةً ، فَقُلْتُهَا ، فَأَعْقَبَنِي اللهُ عَزَّ وَجَلَّ  مُحَمَّدًا  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .","","Musnad Abi Ya'la al-Mawsili 6964","","هند بنت أبي أمية زوج رسول الله عن شقيق بن سلمة عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6968","87 - (  6965  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  قُلْتُ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِنَّ  هِشَامَ بْنَ الْمُغِيرَةِ  كَانَ يَصِلُ الرَّحِمَ وَيَقْرِي الضَّيْفَ ، وَيَفُكُّ الْعُنَاةَ ، وَيُطْعِمُ الطَّعَامَ ، وَلَوْ أَدْرَكَ أَسْلَمَ ، هَلْ ذَلِكَ نَافِعُهُ ؟ قَالَ :  لَا ، إِنَّهُ كَانَ         [12/402]      يُعْطِي لِلدُّنْيَا وَذِكْرِهَا وَحَمْدِهَا ، وَلَمْ يَقُلْ يَوْمًا قَطُّ : رَبِّ اغْفِرْ لِي يَوْمَ الدِّينِ  .","","Musnad Abi Ya'la al-Mawsili 6965","","هند بنت أبي أمية زوج رسول الله عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6969","88 - (  6966  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنْ  حَسَّانَ بْنِ مُخَارِقٍ قَالَ :  قَالَتْ  أُمُّ سَلَمَةَ :  اشْتَكَتِ  ابْنَةٌ لِي  فَنَبَذْتُ لَهَا فِي كُوزٍ ، فَدَخَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَغْلِي ، فَقَالَ : مَا هَذَا ؟ فَقُلْتُ : إِنَّ ابْنَتِي اشْتَكَتْ فَنَبَذْنَا لَهَا هَذَا ، فَقَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ لَمْ يَجْعَلْ شِفَاءَكُمْ فِي حَرَامٍ  .         [12/403]","","Musnad Abi Ya'la al-Mawsili 6966","","هند بنت أبي أمية زوج رسول الله عن حسان بن مخارق الكوفي عن سليمان بن فيروز الشيباني عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6970","89 - (  6967  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  لَيْثٍ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنِ  الْمَعْرُورِ بْنِ سُوَيْدٍ ،  عَنْ  أُمِّ الْمُؤْمِنِينَ أُمِّ سَلَمَةَ ، قَالَتْ :  سَأَلْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَمَّنْ مُسِخَ ، أَيَكُونُ لَهُ نَسْلٌ ؟ فَقَالَ :  مَا مُسِخَ أَحَدٌ قَطُّ ، فَكَانَ لَهُ نَسْلٌ وَلَا عَقِبٌ  .         [12/404]","","Musnad Abi Ya'la al-Mawsili 6967","","هند بنت أبي أمية زوج رسول الله عن معرور بن سويد الأسدي عن علقمة بن مرثد الحضرمي عن ليث بن أبي سليم عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6971","90 - (  6968  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  مُغِيرَةَ ،  عَنْ  أُمِّ مُوسَى ، قَالَتْ :  قَالَتْ  أُمُّ سَلَمَةَ :  وَالَّذِي تَحْلِفُ بِهِ  أُمُّ سَلَمَةَ  ، إِنْ كَانَ أَقْرَبَ النَّاسِ عَهْدًا بِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَلِيٌّ  ، فَقَالَتْ لَهَا : كَانَتْ غَدَاةَ قُبِضَ ، فَأَرْسَلَ إِلَيْهِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَكَانَ أُرَى فِي حَاجَةٍ بَعَثَهُ بِهَا ، قَالَتْ : فَجَعَلَ غَدَاةً بَعْدَ غَدَاةٍ يَقُولُ : جَاءَ  عَلِيٌّ  ؟ ثَلَاثَ مَرَّاتٍ ، قَالَتْ : فَجَاءَ قَبْلَ طُلُوعِ الشَّمْسِ ، فَلَمَّا أَنْ جَاءَ عَرَفْنَا أَنَّ لَهُ إِلَيْهِ حَاجَةً فَخَرَجْنَا مِنَ الْبَيْتِ وَكُنَّا عُدْنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي بَيْتِ  عَائِشَةَ  ، قَالَتْ : فَكُنْتُ آخِرَ مَنْ خَرَجَ مِنَ الْبَيْتِ ثُمَّ جَلَسْتُ أَدْنَاهُنَّ مِنَ الْبَابِ ، فَأَكَبَّ عَلَيْهِ  عَلِيٌّ  وَكَانَ آخِرَ النَّاسِ بِهِ عَهْدًا وَجَعَلَ يُسَارُّهُ وَيُنَاجِيهِ  .         [12/405]","","Musnad Abi Ya'la al-Mawsili 6968","","هند بنت أبي أمية زوج رسول الله عن أم موسى سرية علي بن أبي طالب عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6972","91 - (  6969  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  وَكَانَ أَحَبُّ الْعَمَلِ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَا دُووِمَ عَلَيْهِ وَإِنْ قَلَّ  .","","Musnad Abi Ya'la al-Mawsili 6969","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن أبو إسحاق السبيعي عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6973","92 - (  6970  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  سُفْيَانَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  مَا رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَامَ شَهْرًا ، إِلَّا أَنَّهُ كَانَ يَصِلُ شَعْبَانَ بِرَمَضَانَ  .         [12/406]","","Musnad Abi Ya'la al-Mawsili 6970","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن سالم بن أبي الجعد الغطفاني عن منصور بن المعتمر عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6974","93 - (  6971  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  سُفْيَانَ ،  عَنْ  حَبِيبٍ ،  عَنْ  وَهْبٍ مَوْلَى أَبِي أَحْمَدَ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَخَلَ عَلَيْهَا وَهِيَ تَخْتَمِرُ ، فَقَالَ :  لَيَّةً  لَا  لَيَّتَيْنِ  .         [12/407]","","Musnad Abi Ya'la al-Mawsili 6971","","هند بنت أبي أمية زوج رسول الله عن وهب مولى أبي أحمد بن جحش عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6975","94 - (  6972  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  سُفْيَانَ ،  عَنِ  ابْنِ خُثَيْمٍ ،  عَنِ  ابْنِ سَابِطٍ ،  عَنْ  حَفْصَةَ بِنْتِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :         {      نِسَاؤُكُمْ حَرْثٌ لَكُمْ فَأْتُوا حَرْثَكُمْ أَنَّى شِئْتُمْ         }      قَالَ :  سِمَامٌ  وَاحِدٌ ،  سِمَامٌ  وَاحِدٌ  .         [12/408]","","Musnad Abi Ya'la al-Mawsili 6972","","هند بنت أبي أمية زوج رسول الله عن حفصة بنت عبد الرحمن بن أبي بكر الصديق عن عبد الرحمن بن سابط الجمحي عن عبد الله بن عثمان بن خثيم عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6976","95 - (  6973  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ قَالَ :  سَمِعْتُ  أَبَا سَلَمَةَ ،  يُحَدِّثُ عَنْ  أُمِّ سَلَمَةَ قَالَتْ :  مَا مَاتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [12/409]      حَتَّى كَانَ أَكْثَرُ صَلَاتِهِ وَهُوَ جَالِسٌ  ، وَكَانَ أَحَبُّ الْعَمَلِ إِلَى اللهِ عَزَّ وَجَلَّ مَا دَاوَمَ عَلَيْهِ الْعَبْدُ وَإِنْ كَانَ يَسِيرًا  .","","Musnad Abi Ya'la al-Mawsili 6973","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6977","96 - (  6974  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمَّارٍ الدُّهْنِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  قَوَائِمُ الْمِنْبَرِ رَوَاتِبُ فِي الْجَنَّةِ  .","","Musnad Abi Ya'la al-Mawsili 6974","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن عمار بن معاوية الدهني عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6978","97 - (  6975  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،         [12/410]      حَدَّثَنَا  وُهَيْبٌ ،  عَنْ  خَالِدٍ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  قَالَتْ :  كَانَ فِرَاشِي عِنْدَ مُصَلَّى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - فَكَانَ يُصَلِّي وَإِنِّي لَحِيَالَهُ  .","","Musnad Abi Ya'la al-Mawsili 6975","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو قلابة الجرمي عن خالد الحذاء عن وهيب بن خالد الكرابيسي عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6979","98 - (  6976  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  مَالِكٍ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ أَنَّهَا قَدِمَتْ وَهِيَ مَرِيضَةٌ ، فَذَكَرَتْ ذَلِكَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  طُوفِي مِنْ وَرَاءِ النَّاسِ وَأَنْتِ رَاكِبَةٌ  ، قَالَتْ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ عِنْدَ  الْكَعْبَةِ  يَقْرَأُ بِالطُّورِ  .         [12/411]","","Musnad Abi Ya'la al-Mawsili 6976","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن مالك بن أنس عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6980","99 - (  6977  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  نَافِعٍ ،  عَنْ  صَفِيَّةَ بِنْتِ أَبِي عُبَيْدٍ ،         [12/412]      عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ذَيْلُ النِّسَاءِ شِبْرٌ  ، قُلْتُ : يَا رَسُولَ اللهِ ، إِذَنْ يَخْرُجُ قَدَمَاهَا ؟ قَالَ : فَذِرَاعٌ لَا يَزِدْنَ عَلَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 6977","","هند بنت أبي أمية زوج رسول الله عن صفية بنت أبي عبيد زوج عبد الله بن عمر عن نافع مولى ابن عمر عن محمد بن إسحاق عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6981","100 - (  6978  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  أَنَّهُ كَانَ هُوَ ،  وَابْنُ عَبَّاسٍ  ،  وَأَبُو هُرَيْرَةَ  فَتَذَاكَرُوا الْمَرْأَةَ يُتَوَفَّى عَنْهَا زَوْجُهَا وَهِيَ حَامِلٌ ، قَالَ  أَبُو سَلَمَةَ  : فَقُلْتُ : إِذَا وَضَعَتْ فَقَدْ حَلَّتْ ، فَقَالَ  ابْنُ عَبَّاسٍ  : حِلُّهَا آخِرُ الْأَجَلَيْنِ ، فَقَالَ  أَبُو هُرَيْرَةَ  : أَنَا مَعَ ابْنِ أَخِي يَعْنِي :  أَبَا سَلَمَةَ  ،  فَبَعَثُوا  كُرَيْبًا مَوْلَى ابْنِ عَبَّاسٍ إِلَى أُمِّ سَلَمَةَ فَسَأَلُوهَا عَنْ ذَلِكَ ؟  فَقَالَتْ  أُمُّ سَلَمَةَ  :  إِنَّ  سُبَيْعَةَ بِنْتَ الْحَارِثِ الْأَسْلَمِيَّةَ  وَضَعَتْ بَعْدَ وَفَاةِ زَوْجِهَا بِلَيَالٍ  ، فَخَطَبَهَا رَجُلٌ مِنْ  بَنِي عَبْدِ الدَّارِ  يُكَنَّى  أَبَا السَّنَابِلِ  ، وَأَخْبَرَهَا أَنَّهَا قَدْ حَلَّتْ فَأَرَادَتْ أَنْ تَزَوَّجَ غَيْرَهُ ، فَقَالَ لَهَا  أَبُو السَّنَابِلِ  : فَإِنَّكِ لَمْ تَحِلِّي ، فَأَتَتْ  سُبَيْعَةُ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَذَكَرَتْ ذَلِكَ لَهُ ، فَأَمَرَهَا أَنْ تَزَوَّجَ  .         [12/413]             [12/414]","","Musnad Abi Ya'la al-Mawsili 6978","","هند بنت أبي أمية زوج رسول الله عن كريب بن أبي مسلم الحجازي عن أبو سلمة بن عبد الرحمن عن سليمان بن يسار مولى ميمونة زوج رسول الله عن يحيى بن سعيد الأنصاري عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6982","101 - (  6979  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  هَمَّامُ بْنُ يَحْيَى ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْخَلِيلِ ،  عَنْ  سَفِينَةَ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ وَهُوَ فِي الْمَوْتِ ، جَعَلَ يَقُولُ :  الصَّلَاةَ وَمَا  مَلَكَتْ  أَيْمَانُكُمْ  ، فَجَعَلَ يَقُولُهَا وَمَا يَفِيضُ بِهَا لِسَانُهُ  .","","Musnad Abi Ya'la al-Mawsili 6979","","هند بنت أبي أمية زوج رسول الله عن سفينة مولى رسول الله عن صالح بن أبي مريم الضبعي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6983","102 - (  6980  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  هِشَامٌ ،  عَنِ  الْحَسَنِ ،  عَنْ  ضَبَّةَ بْنِ مِحْصَنٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّهُ سَيَكُونُ أُمَرَاءُ تَعْرِفُونَ وَتُنْكِرُونَ  ، فَمَنْ أَنْكَرَ فَقَدْ بَرِئَ ، وَمَنْ كَرِهَ فَقَدْ سَلِمَ ، وَلَكِنْ مَنْ رَضِيَ وَتَابَعَ ، قَالُوا : يَا رَسُولَ اللهِ أَفَلَا نُقَاتِلُهُمْ ؟ قَالَ : لَا ، مَا صَلَّوْا لَكُمُ الْخَمْسَ  .         [12/415]             [12/416]","","Musnad Abi Ya'la al-Mawsili 6980","","هند بنت أبي أمية زوج رسول الله عن ضبة بن محصن العنزي عن الحسن البصري عن هشام بن حسان العتكي عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6984","103 - (  6981  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَارَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  أُمِّ وَلَدٍ لِإِبْرَاهِيمَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ، قَالَتْ :  كُنْتُ أَجُرُّ ذَيْلِي فَأَمُرُّ بِالْمَكَانِ الْقَذِرِ وَالْمَكَانِ الطَّيِّبِ ،  فَسَأَلْتُ  أُمَّ سَلَمَةَ عَنْ ذَلِكَ ، فَقَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  يُطَهِّرُهُ  مَا بَعْدَهُ  .","","Musnad Abi Ya'la al-Mawsili 6981","","هند بنت أبي أمية زوج رسول الله عن أم ولد عبد الرحمن بن عوف عن محمد بن إبراهيم بن الحارث التيمي عن محمد بن عمارة بن عمرو بن حزم عن عبد الله بن إدريس الأودي عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6985","104 - (  6982  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  حَدَّثَنَا  الْحَسَنُ بْنُ عُبَيْدِ اللهِ ،  عَنْ  هُنَيْدَةَ الْخُزَاعِيِّ ،  عَنْ  أُمِّهِ  ، قَالَتْ :  دَخَلْتُ عَلَى أُمِّ سَلَمَةَ  فَسَأَلْتُهَا  عَنِ الصِّيَامِ ، فَقَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْمُرُنِي أَنْ أَصُومَ ثَلَاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ  ، أَوَّلُهَا الِاثْنَيْنِ وَالْخَمِيسُ وَالِاثْنَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 6982","","هند بنت أبي أمية زوج رسول الله عن أم هنيدة بن خالد عن هنيدة بن خالد الخزاعي عن الحسن بن عبيد الله النخعي عن محمد بن فضيل بن غزوان عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6986","105 - (  6983  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  أَخْبَرَنَا  يُونُسُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  هِنْدٍ بِنْتِ الْحَارِثِ ،         [12/417]      عَنْ  أُمِّ سَلَمَةَ ، أَنَّهَا قَالَتْ :  كُنَّ النِّسَاءُ فِي عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا سَلَّمَ مِنَ الْمَكْتُوبَةِ قُمْنَ وَثَبَتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - وَمَنْ صَلَّى خَلْفَهُ مِنَ الرِّجَالِ ، فَإِذَا قَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَامَ الرِّجَالُ  .","","Musnad Abi Ya'la al-Mawsili 6983","","هند بنت أبي أمية زوج رسول الله عن هند بنت الحارث الفراسية عن الزهري عن يونس بن يزيدالأيلي عن عثمان بن عمر بن فارس عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6987","106 - (  6984  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  أَخْبَرَنَا  ثَابِتُ بْنُ عُمَارَةَ قَالَ :  حَدَّثَتْنِي  رَيْطَةُ ،  عَنْ  كَبْشَةَ بِنْتِ أَبِي مَرْيَمَ ، أَنَّهُمْ  سَأَلُوا  أُمَّ سَلَمَةَ عَنِ الْأَشْرِبَةِ ، قَالَتْ :  أُحَدِّثُكُمْ بِمَا كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنْهَى أَهْلَهُ عَنْهُ ، كَانَ يَنْهَانَا أَنْ نَخْلِطَ التَّمْرَ وَالزَّبِيبَ  ، وَأَنْ  نَعْجُمَ  النَّوَى طَبْخًا  .         [12/418]","","Musnad Abi Ya'la al-Mawsili 6984","","هند بنت أبي أمية زوج رسول الله عن كبشة بنت أبي مريم عن ريطة بنت حريث عن ثابت بن عمارة الحنفي عن عثمان بن عمر بن فارس عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6988","107 - (  6985  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ،  أَخْبَرَنَا  ابْنُ يُوسُفَ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّهَا قَالَتْ :  قَرَّبْتُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَنْبًا مَشْوِيًّا ، فَأَكَلَهَا  ثُمَّ خَرَجَ فَصَلَّى وَلَمْ يَتَوَضَّأْ  .         [12/419]","","Musnad Abi Ya'la al-Mawsili 6985","","هند بنت أبي أمية زوج رسول الله عن سليمان بن يسار مولى ميمونة زوج رسول الله عن محمد بن يوسف بن عبد الله الأعرج عن ابن جريج عن عثمان بن عمر بن فارس عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6989","108 - (  6986  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُعَاذُ بْنُ مُعَاذٍ الْعَنْبَرِيُّ ،  حَدَّثَنَا  أَبُو كَعْبٍ صَاحِبُ الْحَرِيرِ قَالَ :  حَدَّثَنِي  شَهْرُ بْنُ حَوْشَبٍ قَالَ :  سَأَلْتُ  أُمَّ سَلَمَةَ ، قُلْتُ : يَا أُمَّ الْمُؤْمِنِينَ مَا أَكْثَرُ دُعَاءِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا كَانَ عِنْدَكِ ؟ قَالَتْ : كَانَ أَكْثَرُ دُعَائِهِ : يَا مُقَلِّبَ الْقُلُوبِ ثَبِّتْ قَلْبِي عَلَى دِينِكَ ، قَالَتْ : فَقُلْتُ لَهُ : يَا رَسُولَ اللهِ مَا أَكْثَرَ دُعَاءَكَ : يَا مُقَلِّبَ الْقُلُوبِ ثَبِّتْ قَلْبِي عَلَى دِينِكَ ،         [12/420]      قَالَ :  يَا  أُمَّ سَلَمَةَ  ، إِنَّهُ لَيْسَ مِنْ آدَمِيٍّ إِلَّا وَقَلْبُهُ بَيْنَ إِصْبَعَيْنِ مِنْ أَصَابِعِ اللهِ ، مَا شَاءَ أَقَامَ وَمَا شَاءَ أَزَاغَ  .","","Musnad Abi Ya'la al-Mawsili 6986","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن عبد ربه بن عبيد الجرموزي عن معاذ بن معاذ بن نصر عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6990","109 - (  6987  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  أَبُو عَاصِمٍ الضَّحَّاكُ بْنُ مَخْلَدٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  يَحْيَى بْنِ عَبْدِ اللهِ بْنِ صَيْفِيٍّ قَالَ :  أَخْبَرَنِي  عِكْرِمَةُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ، أَنَّ أُمَّ سَلَمَةَ  أَخْبَرَتْهُ  ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَلَفَ أَنَّهُ لَا يَدْخُلُ عَلَى بَعْضِ نِسَائِهِ شَهْرًا ، فَلَمَّا كَانَ تِسْعَةٌ وَعِشْرُونَ يَوْمًا غَدَا أَوْ رَاحَ ، قَالَتْ : قُلْتُ : يَا رَسُولَ اللهِ ، إِنَّكَ حَلَفْتَ أَنْ لَا تَدْخُلَ ، قَالَ :  إِنَّ  الشَّهْرَ  يَكُونُ تِسْعَةً وَعِشْرِينَ يَوْمًا  .         [12/421]","","Musnad Abi Ya'la al-Mawsili 6987","","هند بنت أبي أمية زوج رسول الله عن عكرمة بن عبد الرحمن المخزومي عن يحيى بن عبد الله بن محمد بن يحيى بن صيفي المخزومي عن ابن جريج عن أبو عاصم النبيل عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6991","110 - (  6988  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ، وَإِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  هِنْدٍ بِنْتِ الْحَارِثِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ لَيْلَةٍ ، فَقَالَ :  سُبْحَانَ اللهِ ، مَا أَنْزَلَ اللهُ مِنَ الْفِتَنِ ، وَمَاذَا فَتَحَ مِنَ الْخَزَائِنِ  ، أَيْقِظُوا صَوَاحِبَ الْحُجُرَاتِ ، فَرُبَّ  كَاسِيَةٍ  فِي الدُّنْيَا عَارِيَةٍ يَوْمَ الْقِيَامَةِ  ،  قَالَ  إِسْمَاعِيلُ فِي حَدِيثِهِ :  فَرَأَيْتُ  هِنْدًا اتَّخَذَتْ لِكُمِّ دِرْعِهَا أَزْرَارًا  .         [12/422]             [12/423]","","Musnad Abi Ya'la al-Mawsili 6988","","هند بنت أبي أمية زوج رسول الله عن هند بنت الحارث الفراسية عن الزهري عن معمر بن راشد عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6992","111 - (  6989  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ  عَنْ  مُجَاهِدٍ قَالَ :  كَانَتِ الْمَرْأَةُ مِنَ النِّسَاءِ الْأُولَى تَتَّخِذُ لِكُمِّ دِرْعِهَا أَزْرَارًا تَجْعَلُهُ فِي إِصْبَعِهَا  تُغَطِّي بِهِ الْخَاتَمَ  .         [12/424]","","Musnad Abi Ya'la al-Mawsili 6989","","مجاهد بن جبر المخزومي عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6993","112 - (  6990  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنِ  ابْنِ عَوْنٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَقْتُلُ  عَمَّارًا  الْفِئَةُ  الْبَاغِيَةُ  .","","Musnad Abi Ya'la al-Mawsili 6990","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن عبد الله بن عون بن أرطبان عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6994","113 - (  6991  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ، أُرَاهُ  عَنْ  هِشَامٍ الدَّسْتُوَائِيِّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  قَالَتْ :  بَيْنَمَا أَنَا مُضْطَجِعَةٌ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذْ حِضْتُ ،  فَانْسَلَلْتُ  فَأَخَذْتُ ثِيَابَ حَيْضَتِي  ، فَقَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَنَفِسْتِ  ؟ قُلْتُ : نَعَمْ ، فَدَعَانِي فَاضْطَجَعْتُ مَعَهُ فِي  الْخَمِيلَةِ  ، قَالَتْ : وَكَانَتْ هِيَ وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَغْتَسِلَانِ مِنَ الْإِنَاءِ         [12/425]      الْوَاحِدِ ، وَكَانَ يُقَبِّلُهَا وَهُوَ صَائِمٌ  .         [12/426]","","Musnad Abi Ya'la al-Mawsili 6991","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن هشام الدستوائي عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6995","114 - (  6992  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ قَالَ :         [12/427]      قَالَتْ  أُمُّ سَلَمَةَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَشَدَّ تَعْجِيلًا لِلظُّهْرِ مِنْكُمْ  ، وَأَنْتُمْ أَشَدُّ تَعْجِيلًا لِلْعَصْرِ مِنْهُ  .","","Musnad Abi Ya'la al-Mawsili 6992","","هند بنت أبي أمية زوج رسول الله عن ابن أبي مليكة عن ابن جريج عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6996","115 - (  6993  ) -  أَخْبَرَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَبْدِ اللهِ بْنِ رَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  :  إِذَا حَضَرَ  الْعَشَاءُ  وَحَضَرَتِ الصَّلَاةُ ، فَابْدَؤُوا بِالْعَشَاءِ  .         [12/428]","","Musnad Abi Ya'la al-Mawsili 6993","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن محمد بن إسحاق عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6997","116 - (  6994  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  هِشَامٍ قَالَ :  أَخْبَرَنِي  أَبِي  ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّكُمْ تَخْتَصِمُونَ إِلَيَّ ، وَلَعَلَّ أَحَدَكُمْ أَنْ يَكُونَ  أَلْحَنَ  بِحُجَّتِهِ مِنْ بَعْضٍ  ، وَإِنَّمَا أَنَا بَشَرٌ ، فَمَنْ قَضَيْتُ لَهُ مِنْ حَقِّ أَخِيهِ شَيْئًا ، إِنَّمَا أَقْطَعُ لَهُ قِطْعَةً مِنَ النَّارِ ، فَلَا يَأْخُذَنَّهُ  .","","Musnad Abi Ya'la al-Mawsili 6994","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6998","117 - (  6995  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  حَدَّثَنَا  أَبُو يُونُسَ قَالَ :  حَدَّثَنِي  مُهَاجِرُ بْنُ الْقِبْطِيَّةِ  أَنَّهُ سَمِعَ  أُمَّ سَلَمَةَ زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَيُخْسَفَنَّ بِجَيْشٍ يَغْزُونَ هَذَا  الْبَيْتَ  بِبَيْدَاءَ  مِنَ الْأَرْضِ  .","","Musnad Abi Ya'la al-Mawsili 6995","","هند بنت أبي أمية زوج رسول الله عن ابن القبطية ، مهاجر المكي عن حاتم بن أبي صغيرة القشيري عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"6999","118 - (  6996  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى ،  عَنْ         [12/429]      سُفْيَانَ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي بَكْرٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أُمِّ سَلَمَةَ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمَّا تَزَوَّجَ  أُمَّ سَلَمَةَ  أَقَامَ عِنْدَهَا ثَلَاثًا ، ثُمَّ قَالَ :  لَيْسَ بِكِ عَلَى  أَهْلِكِ  هَوَانٌ ، إِنْ شِئْتِ  سَبَّعْتُ  لَكِ  ، وَإِنْ  سَبَّعْتُ  لَكِ  سَبَّعْتُ  لِنِسَائِي  .         [12/430]             [12/431]","","Musnad Abi Ya'la al-Mawsili 6996","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن عبد الملك بن أبي بكر المخزومي عن محمد بن أبي بكر بن محمد بن عمرو بن حزم عن سفيان الثوري عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7000","119 - (  6997  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ قَالَ :  حَدَّثَنِي  مُوسَى بْنُ أَبِي عَائِشَةَ قَالَ :  حَدَّثَنِي  مَوْلًى لِأُمِّ سَلَمَةَ قَالَ :  سَمِعْتُ  أُمَّ سَلَمَةَ تَقُولُ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا صَلَّى الصُّبْحَ قَالَ : اللَّهُمَّ إِنِّي أَسْأَلُكَ عِلْمًا نَافِعًا  ، وَعَمَلًا مُتَقَبَّلًا ، وَرِزْقًا طَيِّبًا  .","","Musnad Abi Ya'la al-Mawsili 6997","","هند بنت أبي أمية زوج رسول الله عن مولى أم سلمة عن موسى بن أبي عائشة المخزومي عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7001","120 - (  6998  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى ،  عَنْ  عُبَيْدِ اللهِ قَالَ :  أَخْبَرَنِي  نَافِعٌ ،  عَنْ  زَيْدِ بْنِ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ ،  عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الَّذِي يَشْرَبُ فِي آنِيَةِ الْفِضَّةِ ، فَإِنَّمَا  يُجَرْجِرُ  فِي بَطْنِهِ نَارَ  جَهَنَّمَ  .","","Musnad Abi Ya'la al-Mawsili 6998","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن عبد الرحمن بن أبي بكر الصديق عن زيد بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7002","121 - (  6999  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ         [12/432]      سَعِيدٍ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَامِرٍ أَخِي أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُصْبِحُ  جُنُبًا  ، ثُمَّ يَصُومُ  .","","Musnad Abi Ya'la al-Mawsili 6999","","هند بنت أبي أمية زوج رسول الله عن عامر بن أبي أمية المخزومي عن سعيد بن المسيب عن قتادة بن دعامة عن شعبة بن الحجاج عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7003","122 - (  7000  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَهَا أَنْ تُوَافِيَ صَلَاةَ الصُّبْحِ  يَوْمَ النَّحْرِ  بِمَكَّةَ  .         [12/433]","","Musnad Abi Ya'la al-Mawsili 7000","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7004","123 - (  7001  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  حَدَّثَنَا  هِشَامٌ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  جَاءَتْ  أُمُّ حَبِيبَةَ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ : يَا رَسُولَ اللهِ ، هَلْ لَكَ فِي أُخْتِي ؟ قَالَ : فَأَصْنَعُ بِهَا مَاذَا ؟ قَالَتْ : تَزَوَّجُهَا ، فَقَالَ لَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : وَتُحِبِّينَ ذَلِكَ ؟ قَالَتْ : فَقُلْتُ : نَعَمْ ، لَسْتُ لَكَ  بِمُخْلِيَةٍ  ، وَأَحَقُّ مَنْ شَارَكَنِي فِي خَيْرٍ أُخْتِي ، فَقَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : لَا تَحِلُّ لِي ، قَالَتْ : فَوَاللهِ لَقَدْ بَلَغَنِي أَنَّكَ تَخْطُبُ  دُرَّةَ بِنْتَ أُمِّ سَلَمَةَ  ، قَالَتْ : فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَوْ أَنَّهَا كَانَتْ تَحِلُّ لَمَا تَزَوَّجْتُهَا ، وَقَدْ أَرْضَعَتْنِي وَأَبَاهَا  ثُوَيْبَةُ مَوْلَاةُ بَنِي هَاشِمٍ  ، فَلَا تَعْرِضْنَ عَلَيَّ بَنَاتِكُنَّ وَلَا أَخَوَاتِكُنَّ  .         [12/434]             [12/435]","","Musnad Abi Ya'la al-Mawsili 7001","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7005","124 - (  7002  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  عَنْ  مُوسَى بْنِ عُبَيْدَةَ الرَّبَذِيِّ ،  عَنْ  سَعِيدِ بْنِ عَبْدِ الرَّحْمَنِ         [12/436]      بْنِ أَبِي عَيَّاشٍ الزُّرَقِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  عَنْ  أُمِّ سَلَمَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أُرِيتُ مَا تَعْمَلُ أُمَّتِي بَعْدِي فَاخْتَرْتُ لَهُمُ الشَّفَاعَةَ  إِلَى يَوْمِ الْقِيَامَةِ  .","","Musnad Abi Ya'la al-Mawsili 7002","","هند بنت أبي أمية زوج رسول الله عن أنس بن مالك عن سعيد بن عبد الرحمن الأسدي عن موسى بن عبيدة بن نشيط الحميري عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7006","125 - (  7003  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  شَقِيقٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  دَخَلَ عَلَيْهَا  عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  فَقَالَ : يَا أُمَّهْ ، قَدْ خِفْتُ أَنْ يُهْلِكَنِي كَثْرَةُ مَالِي ، أَنَا أَكْثَرُ  قُرَيْشٍ  مَالًا ، قَالَتْ : يَا بُنَيَّ أَنْفِقْ ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ مِنْ أَصْحَابِي مَنْ لَمْ يَرَنِي بَعْدَ أَنْ أُفَارِقَهُ  ، فَخَرَجَ  عَبْدُ الرَّحْمَنِ  فَلَقِيَ  عُمَرَ  فَأَخْبَرَهُ بِالَّذِي قَالَتْ  أُمُّ سَلَمَةَ  ، فَجَاءَ  عُمَرُ  فَدَخَلَ عَلَيْهَا ، فَقَالَ : بِاللهِ مِنْهُمْ أَنَا ؟ قَالَتْ : لَا ، وَلَنْ أُبَرِّئَ أَحَدًا بَعْدَكَ  .         [12/437]","","Musnad Abi Ya'la al-Mawsili 7003","","هند بنت أبي أمية زوج رسول الله عن شقيق بن سلمة عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7007","126 - (  7004  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  هِشَامٌ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، قَالَتْ :  جَاءَتْ  أُمُّ سُلَيْمٍ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَأَلَتْهُ عَنِ الْمَرْأَةِ تَرَى فِي مَنَامِهَا مَا يَرَى الرَّجُلُ ، قَالَ :  إِذَا رَأَتِ الْمَاءَ فَلْتَغْتَسِلْ  ، فَقُلْتُ : فَضَحْتِ النِّسَاءَ ، وَهَلْ تَحْتَلِمُ الْمَرْأَةُ ؟ فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَرِبَتْ  يَمِينُكِ ، فَفِيمَ يُشْبِهُهَا وَلَدُهَا إِذًا  .","","Musnad Abi Ya'la al-Mawsili 7004","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7008","127 - (  7005  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  حَدَّثَنَا  أَبُو عَوْنٍ مُحَمَّدُ بْنُ عُبَيْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ شَدَّادٍ قَالَ :  سَمِعْتُ  أَبَا هُرَيْرَةَ يَقُولُ :  تَوَضَّؤُوا مِمَّا مَسَّتِ النَّارُ  ، قَالَ : فَأَرْسَلَ  مَرْوَانُ  إِلَى أُمِّ سَلَمَةَ  فَسَأَلَهَا  ، فَقَالَتْ :  نَهَسَ  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِنْدِي كَتِفًا ، ثُمَّ خَرَجَ إِلَى الصَّلَاةِ  وَلَمْ يَمَسَّ مَاءً  .","","Musnad Abi Ya'la al-Mawsili 7005","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن شداد بن الهاد الليثي عن محمد بن عبيد الله بن سعيد الثقفي عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7009","128 - (  7006  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ ،         [12/438]      حَدَّثَنَا  ابْنُ جُرَيْجٍ قَالَ :  أَخْبَرَنِي  حَبِيبُ بْنُ أَبِي ثَابِتٍ ، أَنَّ عَبْدَ الْحَمِيدِ بْنَ عَبْدِ اللهِ بْنِ أَبِي عَمْرٍو ، وَالْقَاسِمَ بْنَ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ،  أَخْبَرَاهُ  ،  أَنَّهُمَا سَمِعَا  أَبَا بَكْرِ بْنَ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ، يُخْبِرُ أَنَّ أُمَّ سَلَمَةَ زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَخْبَرَتْهُ  ،  أَنَّهَا لَمَّا قَدِمَتِ  الْمَدِينَةَ  أَخْبَرَتْهُمْ أَنَّهَا  ابْنَةُ أَبِي أُمَيَّةَ بْنِ الْمُغِيرَةِ  فَكَذَّبُوهَا ، وَيَقُولُونَ : مَا أَكْذَبَ الْغَرَائِبَ ! حَتَّى أَنْشَأَ نَاسٌ مِنْهُمُ  الْحَجَّ  ، فَقَالُوا : تَكْتُبِينَ إِلَى أَهْلِكِ ؟ فَكَتَبَتْ مَعَهُمْ ، فَرَجَعُوا إِلَى  الْمَدِينَةِ  يُصَدِّقُونَهَا ، فَازْدَادَتْ عَلَيْهِمْ كَرَامَةً ، قَالَتْ : فَلَمَّا وَضَعْتُ  زَيْنَبَ  جَاءَنِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُنِي ، فَقُلْتُ : مِثْلِي تُنْكَحُ ؟ أَمَّا أَنَا فَلَا وَلَدَ فِيَّ ، وَأَنَا  غَيْرَى  ذَاتُ عِيَالٍ ، قَالَ :  أَنَا أَكْبَرُ مِنْكِ ، وَأَمَّا الْغَيْرَةُ فَيُذْهِبُهَا اللهُ ، وَأَمَّا الْعِيَالُ ، فَإِلَى اللهِ وَإِلَى رَسُولِهِ  ، فَتَزَوَّجَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَعَلَ يَأْتِيهَا فَيَقُولُ : أَيْ زُنَابُ ، حَتَّى جَاءَ  عَمَّارٌ  فَاخْتَلَجَهَا  ، فَقَالَ : هَذِهِ تَمْنَعُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَكَانَتْ تُرْضِعُهَا ، فَجَاءَ إِلَيْهَا فَقَالَ : أَيْنَ زُنَابُ ؟ فَقَالَتْ قَرِيبَةُ  بِنْتُ أَبِي أُمَيَّةَ  وَوَافَقَهَا عِنْدَهَا : أَخَذَهَا  ابْنُ يَاسِرٍ  ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِنِّي آتِيكُمُ اللَّيْلَةَ ، قَالَتْ : فَوَضَعْتُ ثِيَابِي فَأَخْرَجْتُ  حَبَّاتٍ  مِنْ شَعِيرٍ كَانَتْ فِي         [12/439]      جَرَّتِي وَأَخْرَجْتُ شَحْمًا فَعَصَدْتُ لَهُ ، قَالَتْ : فَبَاتَ ثُمَّ أَصْبَحَ ، فَقَالَ حِينَ أَصْبَحَ : إِنَّ لَكِ عَلَى أَهْلِكِ كَرَامَةً ، إِنْ شِئْتِ  سَبَّعْتُ  لَكِ ، وَإِنْ أُسَبِّعْ لَكِ أُسَبِّعْ لِنِسَائِي  .","","Musnad Abi Ya'la al-Mawsili 7006","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن القاسم بن محمد بن عبد الرحمن المخزومي عن حبيب بن أبي ثابت الكاهلي عن ابن جريج عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7010","129 - (  7007  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  حَدَّثَنَا  أَبِي ،  حَدَّثَنَا  عَلِيُّ بْنُ زَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ قَالَتْ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اسْتَيْقَظَ مِنْ         [12/440]      مَنَامِهِ وَهُوَ يَسْتَرْجِعُ ، قَالَتْ : فَقُلْتُ : يَا رَسُولَ اللهِ ، مَا شَأْنُكَ ؟ قَالَ :  طَائِفَةٌ مِنْ أُمَّتِي يُخْسَفُ بِهِمْ يُبْعَثُونَ إِلَى رَجُلٍ ، فَيَأْتِي  مَكَّةَ  فَيَمْنَعُهُ اللهُ مِنْهُمْ  ، وَيُخْسَفُ بِهِمْ ، مَصْرَعُهُمْ وَاحِدٌ وَمَصَادِرُهُمْ  شَتَّى  ، قَالَتْ : قُلْتُ : يَا رَسُولَ اللهِ ، كَيْفَ يَكُونُ مَصْرَعُهُمْ وَاحِدًا وَمَصَادِرُهُمْ  شَتَّى  ؟ قَالَ : إِنَّ مِنْهُمْ مَنْ يُكْرَهُ فَيَجِيءُ مُكْرَهًا  .","","Musnad Abi Ya'la al-Mawsili 7007","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن علي بن زيد بن جدعان عن عبد الوارث بن سعيد بن ذكوان عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7011","130 - (  7008  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  ابْنِ إِسْحَاقَ قَالَ :  حَدَّثَنِي  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّهَا أُمِّ سَلَمَةَ  ، قَالَتْ :  قُلْتُ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : يَا رَسُولَ اللهِ ، هَلْ لِي مِنْ أَجْرٍ فِي  بَنِي أَبِي سَلَمَةَ  ؟ فَإِنِّي أُنْفِقُ عَلَيْهِمْ ، وَإِنَّمَا هُمْ بَنِيَّ وَلَسْتُ بِتَارِكَتِهِمْ هَكَذَا وَهَكَذَا ، تَقُولُ : كَانَ لِي أَجْرٌ أَوْ لَمْ يَكُنْ ، فَقَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  نَعَمْ ، لَكِ فِيهِمْ أَجْرٌ مَا أَنْفَقْتِ عَلَيْهِمْ  .         [12/441]","","Musnad Abi Ya'la al-Mawsili 7008","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7012","131 - (  7009  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنِ  ابْنِ إِسْحَاقَ قَالَ :  حَدَّثَنِي  سُلَيْمَانُ بْنُ سُحَيْمٍ مَوْلَى آلِ حُنَيْنٍ ،  عَنْ  يَحْيَى بْنِ أَبِي سُفْيَانَ الْأَخْنَسِيِّ ،  عَنْ  أُمِّهِ أُمِّ حَكِيمٍ بِنْتِ أُمَيَّةَ بْنِ الْأَخْنَسِ  ،  عَنْ  أُمِّ سَلَمَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ أَهَلَّ مِنَ  الْمَسْجِدِ الْأَقْصَى  بِعُمْرَةٍ وَبِحَجَّةٍ ، غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ  ، قَالَ : فَرَكِبَتْ  أُمُّ حَكِيمٍ  عَنْ ذَلِكَ الْحَدِيثِ إِلَى  بَيْتِ الْمَقْدِسِ  حَتَّى أَهَلَّتْ مِنْهُ بِعُمْرَةٍ  .","","Musnad Abi Ya'la al-Mawsili 7009","","هند بنت أبي أمية زوج رسول الله عن حكيمة بنت أمية بن الأخنس عن يحيى بن أبي سفيان الأخنسي عن سليمان بن سحيم  الحجازي عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7013","132 - (  7010  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ         [12/442]      إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  ابْنِ شِهَابٍ قَالَ :  أَخْبَرَتْنِي  هِنْدُ بِنْتُ الْحَارِثِ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا سَلَّمَ قَامَ النِّسَاءُ حِينَ يَقْضِي تَسْلِيمَهُ  ، وَمَكَثَ يَسِيرًا  ،  قَالَ  مُحَمَّدٌ  :  فَنَرَى وَاللهُ أَعْلَمُ أَنَّ مُكْثَهُ ذَلِكَ كَانَ لِكَيْ يَنْفَدَ النِّسَاءُ قَبْلَ أَنْ يُدْرِكَهُنَّ مَنِ انْصَرَفَ مِنَ  الْقَوْمِ  .","","Musnad Abi Ya'la al-Mawsili 7010","","هند بنت أبي أمية زوج رسول الله عن هند بنت الحارث الفراسية عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7014","133 - (  7011  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ الْمُقْرِئُ ،  حَدَّثَنَا  حَيْوَةُ ، وَابْنُ لَهِيعَةَ ، قَالَا :  سَمِعْنَا  يَزِيدَ بْنَ أَبِي حَبِيبٍ يَقُولُ :  حَدَّثَنِي  أَبُو عِمْرَانَ ،  أَنَّهُ حَجَّ مَعَ مَوَالِيهِ ، فَأَتَيْتُ  أُمَّ سَلَمَةَ  أُمَّ الْمُؤْمِنِينَ ، فَقُلْتُ : يَا أُمَّ الْمُؤْمِنِينَ ، إِنِّي لَمْ أَحُجَّ قَطُّ ، فَبِأَيِّهِمَا أَبْدَأُ : بِالْعُمْرَةِ أَمْ بِالْحَجِّ ؟ قَالَتِ : ابْدَأْ بِأَيِّهِمَا شِئْتَ ، قَالَ : ثُمَّ إِنِّي أَتَيْتُ  صَفِيَّةَ  أُمَّ الْمُؤْمِنِينَ فَسَأَلْتُهَا ، فَقَالَتْ لِي مِثْلَ مَا قَالَتْ لِي  أُمُّ سَلَمَةَ  ، قَالَ : ثُمَّ جِئْتُ  أُمَّ سَلَمَةَ  فَأَخْبَرْتُهَا بِقَوْلِ  صَفِيَّةَ  ،  فَقَالَتْ لِي  أُمُّ سَلَمَةَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  يَا  آلَ مُحَمَّدٍ  ، مَنْ حَجَّ مِنْكُمْ ، فَلْيُهِلَّ بِعُمْرَةٍ  فِي حَجَّةٍ ، أَوْ فِي حَجَّتِهِ  .         [12/443]","","Musnad Abi Ya'la al-Mawsili 7011","","هند بنت أبي أمية زوج رسول الله عن أسلم بن يزيد التجيبي عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن عبد الله بن يزيد القصير عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7015","134 - (  7012  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  حَدَّثَنِي  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  حَدَّثَنِي  بُدَيْلٌ ،  عَنِ  الْحَسَنِ بْنِ مُسْلِمٍ ،  عَنْ  صَفِيَّةَ بِنْتِ شَيْبَةَ ،  عَنْ  أُمِّ سَلَمَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْمُتَوَفَّى عَنْهَا لَا تَلْبَسُ الْمُعَصْفَرَ مِنَ الثِّيَابِ  ، وَلَا  الْمُمَشَّقَةَ  ، وَلَا الْحُلِيَّ ، وَلَا تَخْتَضِبُ وَلَا تَكْتَحِلُ  .         [12/444]","","Musnad Abi Ya'la al-Mawsili 7012","","هند بنت أبي أمية زوج رسول الله عن صفية بنت شيبة الحجبية عن الحسن بن مسلم بن يناق عن بديل بن ميسرة العقيلي عن إبراهيم بن طهمان عن يحيى بن أبي بكير عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7016","135 - (  7013  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  حَدَّثَنَا  عِيسَى بْنُ عَبْدِ الرَّحْمَنِ الْبَجَلِيُّ ،  عَنِ  السُّدِّيِّ ،  عَنْ  أَبِي عَبْدِ اللهِ الْجَدَلِيِّ قَالَ :  قَالَتْ  أُمُّ سَلَمَةَ :  أَيُسَبُّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى الْمَنَابِرِ ؟         [12/445]      قُلْتُ : وَأَنَّى ذَلِكَ ؟ قَالَتْ : أَلَيْسَ  يُسَبُّ  عَلِيٌّ  وَمَنْ يُحِبُّهُ ؟ فَأَشْهَدُ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يُحِبُّهُ  .","","Musnad Abi Ya'la al-Mawsili 7013","","هند بنت أبي أمية زوج رسول الله عن عبد بن عبد الجدلي عن السدي الكبير عن عيسى بن عبد الرحمن السلمي عن عبيد الله بن موسى عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7017","136 - (  7014  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الْمُؤْمِنِ بْنُ خَالِدٍ الْحَنَفِيُّ الْخُرَاسَانِيُّ قَالَ : لَقِيتُهُ  بِمَرْوَ  ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ بُرَيْدَةَ الْأَسْلَمِيُّ  عَنْ  أُمِّ سَلَمَةَ قَالَتْ :  مَا كَانَ شَيْءٌ مِنَ الثِّيَابِ أَحَبَّ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ الْقُمُصِ  .         [12/446]","","Musnad Abi Ya'la al-Mawsili 7014","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن بريدة عن عبد المؤمن بن خالد المروزي عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7018","137 - (  7015  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ قَالَ :         [12/447]      قَالَتْ  أُمُّ سَلَمَةَ :  كُنْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي لِحَافِهِ ، فَوَجَدْتُ مَا تَجِدُ النِّسَاءُ ،  فَانْسَلَلْتُ  مِنَ اللِّحَافِ  ، قَالَتْ : فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَنَفِسْتِ  ؟ قُلْتُ : نَعَمْ ، قَالَ : ذَاكَ مَا كُتِبَ عَلَى بَنَاتِ آدَمَ ، فَأَصْلَحْتُ مِنْ شَأْنِي ثُمَّ رَجَعْتُ ، فَقَالَ : تَعَالَيْ وَادْخُلِي مَعِي ، قَالَتْ : فَدَخَلْتُ مَعَهُ فِي اللِّحَافِ  .","","Musnad Abi Ya'la al-Mawsili 7015","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن محمد بن عبيد بن أبي أمية عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7019","138 - (  7016  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو قَالَ :  حَدَّثَنَا  زَائِدَةُ ،  حَدَّثَنَا  عَمَّارُ بْنُ أَبِي مُعَاوِيَةَ الْبَجَلِيُّ ،  عَنْ  أَبِي سَلَمَةَ قَالَ :  حَدَّثَتْنِي  أُمُّ سَلَمَةَ  أَنَّهَا كَانَتْ تَغْتَسِلُ وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ الْجَنَابَةِ فِي إِنَاءٍ وَاحِدٍ  .","","Musnad Abi Ya'la al-Mawsili 7016","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن عمار بن معاوية الدهني عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7020","139 - (  7017  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  حَدَّثَنَا  زَائِدَةُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  رِبْعِيِّ بْنِ حِرَاشٍ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ         [12/448]      سَاهِمُ  الْوَجْهِ  ، قَالَتْ : فَحَسِبْتُ ذَلِكَ مِنْ وَجَعٍ ، قُلْتُ : يَا رَسُولَ اللهِ مَا لَكَ  سَاهِمُ  الْوَجْهِ ؟ قَالَ :  مِنْ أَجْلِ الدَّنَانِيرِ السَّبْعَةِ الَّتِي خَبَّأْنَا أَمْسِ ، أَمْسَيْنَا وَلَمْ نَقْسِمْهَا  ، وَهِيَ فِي  خُصْمِ  الْفِرَاشِ  .","","Musnad Abi Ya'la al-Mawsili 7017","","هند بنت أبي أمية زوج رسول الله عن ربعي بن حراش العبسي عن عبد الملك بن عمير القبطي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7021","140 - (  7018  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  وُهَيْبٌ ،  حَدَّثَنَا  خَالِدٌ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  بَعْضِ وَلَدِ أُمِّ سَلَمَةَ  ،  عَنْ  أُمِّ سَلَمَةَ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُصَلِّي عَلَى  الْخُمْرَةِ  .         [12/449]","","Musnad Abi Ya'la al-Mawsili 7018","","هند بنت أبي أمية زوج رسول الله عن بعض ولد أم سلمة عن أبو قلابة الجرمي عن خالد الحذاء عن وهيب بن خالد الكرابيسي عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7022","141 - (  7019  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  بُهْلُولُ بْنُ مُوَرِّقٍ الشَّامِيُّ ،  حَدَّثَنَا  مُوسَى بْنُ عُبَيْدَةَ قَالَ :  أَخْبَرَنِي  ثَابِتٌ مَوْلَى أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا خَرَجَ مِنْ بَيْتِهِ صَلَّى قَبْلَ الظُّهْرِ رَكْعَتَيْنِ ، وَصَلَّى قَبْلَ الْعَصْرِ رَكْعَتَيْنِ  ، فَأَرْسَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  سَاعِيًا  إِلَى قَوْمٍ ، فَلَمَّا بَلَغَهُمْ أَرَادَ قَوْمٌ مِنْهُمْ أَنْ يُعِينُوهُ وَتَهَيَّؤُوا لِذَلِكَ ، فَلَمَّا بَلَغَ السَّاعِي فَرَأَى  الْقَوْمَ  ، ظَنَّ أَنَّهُمْ سَيَقْتُلُونَهُ فَرَجَعَ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : إِنَّهُمْ مَنَعُونِي صَدَقَتَهُمْ ، وَاحْتَبَسَ السَّاعِي عَلَى  الْقَوْمِ  ، فَجَاؤُوا إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَعْتَذِرُونَ إِلَيْهِ ، وَقَدْ قَضَى صَلَاةَ الظُّهْرِ ، فَجَعَلُوا يَعْتَذِرُونَ إِلَيْهِ حَتَّى صَلَّى الْعَصْرَ ، وَنَسِيَ الرَّكْعَتَيْنِ الَّتِي كَانَ يُصَلِّيهِمَا قَبْلَ الْعَصْرِ ، فَأَرْسَلَتْ  عَائِشَةُ  إِلَى  أُمِّ سَلَمَةَ  : يَا أُخَيَّهْ ، مَا الرَّكْعَتَانِ الَّتِي صَلَّى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي حُجْرَتِكِ بَعْدَ الْعَصْرِ ؟ فَأَخْبَرَتْهَا ، وَقَالَتْ : مَا رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى قَبْلَهَا وَلَا بَعْدَهَا  .","","Musnad Abi Ya'la al-Mawsili 7019","","هند بنت أبي أمية زوج رسول الله عن ثابت مولى أم سلمة عن موسى بن عبيدة بن نشيط الحميري عن بهلول بن مورق الشامى عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7023","142 - (  7020  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  حَبَّانُ بْنُ هِلَالٍ ،  حَدَّثَنَا  هَارُونُ الْقَارِئُ ،  حَدَّثَنَا  ثَابِتٌ ،  عَنْ  شَهْرٍ ،         [12/450]      عَنْ  أُمِّ سَلَمَةَ قَالَتْ :  سَأَلْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ هَذِهِ الْآيَةِ ، فَقَالَ :         {      إِنَّهُ عَمَلٌ غَيْرُ صَالِحٍ         }      .         [12/451]","","Musnad Abi Ya'la al-Mawsili 7020","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن ثابت البناني عن هارون بن موسى العتكي عن حبان بن هلال الباهلي عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7024","143 - (  7021  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَسَدِيُّ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  زُبَيْدٍ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَلَّلَ  عَلِيًّا  ،  وَحَسَنًا  ،  وَحُسَيْنًا  ،  وَفَاطِمَةَ  كِسَاءً ، ثُمَّ قَالَ :  اللَّهُمَّ هَؤُلَاءِ أَهْلُ بَيْتِي  وَحَامَّتِي ،  اللَّهُمَّ أَذْهِبْ عَنْهُمُ الرِّجْسَ وَطَهِّرْهُمْ تَطْهِيرًا  ، فَقَالَتْ  أُمُّ سَلَمَةَ  ، قُلْتُ : يَا رَسُولَ اللهِ ، أَنَا مِنْهُمْ ؟ قَالَ : إِنَّكِ إِلَى خَيْرٍ  .","","Musnad Abi Ya'la al-Mawsili 7021","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن زبيد بن الحارث اليامي عن سفيان الثوري عن محمد بن عبد الله بن الزبير عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7025","144 - (  7022  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ         [12/452]      الْأُمَوِيُّ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي مُلَيْكَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا قَرَأَ قَطَّعَ قِرَاءَتَهُ آيَةً آيَةً         {      بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ             *          الْحَمْدُ لِلهِ رَبِّ الْعَالَمِينَ         }      ،         {      مَالِكِ يَوْمِ الدِّينِ         }      .","","Musnad Abi Ya'la al-Mawsili 7022","","هند بنت أبي أمية زوج رسول الله عن ابن أبي مليكة عن ابن جريج عن يحيى بن سعيد بن أبان عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7026","145 - (  7023  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  شُجَاعُ بْنُ الْوَلِيدِ بْنِ قَيْسٍ ،  عَنْ  عَلِيِّ بْنِ عَبْدِ الْأَعْلَى ،  عَنْ  أَبِي سَهْلٍ ،  عَنْ  مُسَّةَ الْأَزْدِيَّةِ ،  عَنْ  أُمِّ سَلَمَةَ قَالَتْ :  كَانَتِ النُّفَسَاءُ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَجْلِسُ أَرْبَعِينَ يَوْمًا  ، وَكُنَّا نَطْلِي وُجُوهَنَا بِالْوَرْسِ مِنَ الْكَلَفِ  .         [12/453]","","Musnad Abi Ya'la al-Mawsili 7023","","هند بنت أبي أمية زوج رسول الله عن مسة الأزدية عن كثير بن زياد البرساني عن علي بن عبد الأعلى الثعلبي عن شجاع بن الوليد السكوني عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7027","146 - (  7024  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  الْحَسَنُ بْنُ مُوسَى ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عَوْفِ بْنِ الْحَارِثِ ،  عَنْ  أُخْتِهِ رُمَيْثَةَ بِنْتِ الْحَارِثِ  ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تُؤْذِينِي فِي  عَائِشَةَ  ، فَوَاللهِ مَا مِنْكُنَّ امْرَأَةٌ يَنْزِلُ عَلَيَّ الْوَحْيُ وَأَنَا فِي لِحَافِهَا  لَيْسَ  عَائِشَةَ  ، قُلْتُ : لَا  جَرَمَ  ، وَاللهِ لَا أُؤْذِيكَ فِيهَا أَبَدًا  .         [12/454]","","Musnad Abi Ya'la al-Mawsili 7024","","هند بنت أبي أمية زوج رسول الله عن رميثة بنت الحارث بن الطفيل عن عوف بن الحارث بن الطفيل الأزدي عن هشام بن عروة بن الزبير عن حماد بن سلمة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7028","147 - (  7025  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  الْحَسَنُ بْنُ مُوسَى ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنَا  دَرَّاجٌ ،  عَنِ  السَّائِبِ مَوْلَى أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  خَيْرُ صَلَاةِ النِّسَاءِ فِي قَعْرِ بُيُوتِهِنَّ  .","","Musnad Abi Ya'la al-Mawsili 7025","","هند بنت أبي أمية زوج رسول الله عن السائب بن عبد الله مولى أم سلمة عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7029","[12/455]      147 - (  7025  ) - مُكَرَّرٌ ـ  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  ابْنُ عَوْنٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  أُمِّ سَلَمَةَ قَالَتْ :  لَمَّا كَانَ  يَوْمُ الْخَنْدَقِ  وَهُوَ يُعَاطِيهِمُ اللَّبَنَ وَقَدِ اغْبَرَّ شَعَرُهُ تَعْنِي النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ : فَوَاللهِ مَا نَسِيتُ ، وَهُوَ يَقُولُ :  لِلْأَنْصَارِ  وَالْمُهَاجِرَهْ  قَالَتْ : فَدَخَلَ  عَمَّارٌ  ، فَقَالَ :  وَيْحَكَ أَوْ وَيْحَهُ  ، تَقْتُلُهُ  الْفِئَةُ  الْبَاغِيَةُ  .         [12/456]","","Musnad Abi Ya'la al-Mawsili 7025","","هند بنت أبي أمية زوج رسول الله عن خيرة مولاة أم سلمة عن الحسن البصري عن عبد الله بن عون بن أرطبان عن يزيد بن زريع العيشي عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7030","148 - (  7026  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  أَخْبَرَنَا  عَلِيُّ بْنُ زَيْدٍ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِفَاطِمَةَ  : ائْتِنِي بِزَوْجِكِ وَبِابْنَتَيْكِ ، قَالَتْ : فَجَاءَتْ بِهِمْ ، فَأَلْقَى عَلَيْهِمْ كِسَاءً فَدَكِيًّا ثُمَّ وَضَعَ يَدَهُ عَلَيْهِمْ ، فَقَالَ :  اللَّهُمَّ إِنَّ هَؤُلَاءِ  آلُ مُحَمَّدٍ  ، فَاجْعَلْ صَلَوَاتِكَ وَبَرَكَاتِكَ عَلَى  مُحَمَّدٍ  ، وَعَلَى  آلِ مُحَمَّدٍ  ، إِنَّكَ حَمِيدٌ مَجِيدٌ ، قَالَتْ  أُمُّ سَلَمَةَ  : فَرَفَعْتُ الْكِسَاءَ لِأَدْخُلَ فِيهِ ، فَجَذَبَهُ مِنْ يَدِي وَقَالَ : إِنَّكِ عَلَى خَيْرٍ  .","","Musnad Abi Ya'la al-Mawsili 7026","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن علي بن زيد بن جدعان عن حماد بن سلمة عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7031","149 - (  7027  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  زَيْدُ بْنُ الْحُبَابِ الْعُكْلِيُّ قَالَ :  أَخْبَرَنِي  أُسَامَةُ بْنُ زَيْدٍ قَالَ :  حَدَّثَنِي  عَبْدُ اللهِ بْنُ رَافِعٍ قَالَ :  سَمِعْتُ  أُمَّ سَلَمَةَ زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَقُولُ :  كُنْتُ عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَالِسَةً ، فَجَاءَ رَجُلَانِ يَخْتَصِمَانِ فِي أَشْيَاءَ قَدْ دَرَسَتْ وَبَادَتْ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّمَا أَقْضِي بَيْنَكُمَا فِي شَيْءٍ لَمْ يَنْزِلْ عَلَيَّ فِيهِ شَيْءٌ ، مَنْ قَضَيْتُ لَهُ بِحُجَّةٍ أُرَاهَا ،         [12/457]      فَأَقْتَطِعُ  بِهَا مِنْ مَالِ أَخِيهِ  ، فَإِنَّمَا  يَقْتَطِعُ  بِهَا قِطْعَةً مِنَ النَّارِ تَكُونُ  إِسْطَامًا  فِي رَقَبَتِهِ يَوْمَ الْقِيَامَةِ ، فَبَكَى الرَّجُلَانِ ، وَقَالَا : يَا رَسُولَ اللهِ ، حَقِّي الَّذِي أَطْلُبُ لِأَخِي ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : لَا وَلَكِنِ اذْهَبَا فَاقْتَسِمَا وَتَوَخَّيَا ، ثُمَّ لِيُحَلِّلْ كُلُّ وَاحِدٍ مِنْكُمَا صَاحِبَهُ  .","","Musnad Abi Ya'la al-Mawsili 7027","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن رافع المخزومي عن أسامة بن زيد الليثي المدني عن زيد بن الحباب العكلي عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7032","150 - (  7028  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنِ  الْأَزْرَقِ بْنِ قَيْسٍ ،  عَنْ  ذَكْوَانَ ،  عَنْ  أُمِّ سَلَمَةَ قَالَتْ :  صَلَّى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْعَصْرَ ، ثُمَّ دَخَلَ بَيْتِي فَصَلَّى رَكْعَتَيْنِ ، قُلْتُ : يَا رَسُولَ اللهِ ، صَلَّيْتَ صَلَاةً         [12/458]      لَمْ تَكُنْ تُصَلِّيهَا ؟ فَقَالَ :  قَدِمَ عَلَيَّ مَالٌ فَشَغَلَنِي عَنْ رَكْعَتَيْنِ كُنْتُ أَرْكَعُهُمَا بَعْدَ الظُّهْرِ ، فَصَلَّيْتُهُمَا الْآنَ  ، فَقُلْتُ : يَا رَسُولَ اللهِ أَفَنَقْضِيهِمَا إِذَا فَاتَتَا ؟ قَالَ : لَا  .","","Musnad Abi Ya'la al-Mawsili 7028","","هند بنت أبي أمية زوج رسول الله عن ذكوان مولى عائشة بنت أبي بكر عن أزرق بن قيس الحارثي عن حماد بن سلمة عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7033","151 - (  7029  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ يَزِيدَ الْوَاسِطِيُّ ،  عَنِ  الْقَاسِمِ بْنِ الْفَضْلِ ،  عَنْ  أَبِي جَعْفَرٍ مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْحَجُّ  جِهَادُ  كُلِّ ضَعِيفٍ  .","","Musnad Abi Ya'la al-Mawsili 7029","","هند بنت أبي أمية زوج رسول الله عن أبو جعفر الباقر عن القاسم بن الفضل بن معدان عن محمد بن يزيد الكلاعي عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7034","152 - (  7030  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  حَدَّثَنَا  أَبُو إِسْحَاقَ الْفَزَارِيُّ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  قَبِيصَةَ بْنِ ذُؤَيْبٍ ،         [12/459]      عَنْ  أُمِّ سَلَمَةَ قَالَتْ :  دَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى  أَبِي سَلَمَةَ  وَقَدْ  شَقَّ  بَصَرُهُ فَأَغْمَضَهُ ، ثُمَّ قَالَ :  إِنَّ الرُّوحَ إِذَا قُبِضَ تَبِعَهُ الْبَصَرُ  ، فَضَجَّ نَاسٌ مِنْ أَهْلِهِ ، فَقَالَ : لَا تَدْعُوا عَلَى أَنْفُسِكُمْ إِلَّا بِخَيْرٍ ، فَإِنَّ الْمَلَائِكَةَ يُؤَمِّنُونَ عَلَى مَا تَقُولُونَ ، ثُمَّ قَالَ : اللَّهُمَّ اغْفِرْ  لِأَبِي سَلَمَةَ  ، وَارْفَعْ دَرَجَتَهُ فِي الْمَهْدِيِّينَ ،  وَاخْلُفْهُ  فِي عَقِبِهِ فِي الْغَابِرِينَ ، وَاغْفِرْ لَنَا وَلَهُ يَا رَبَّ الْعَالَمِينَ ، اللَّهُمَّ  افْسَحْ  لَهُ فِي قَبْرِهِ ، وَنَوِّرْ لَهُ فِي قَبْرِهِ  .         [12/460]","","Musnad Abi Ya'la al-Mawsili 7030","","هند بنت أبي أمية زوج رسول الله عن قبيصة بن ذؤيب الخزاعي عن أبو قلابة الجرمي عن خالد الحذاء عن أبو إسحاق الفزاري عن معاوية بن عمرو بن المهلب الأزدي عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7035","153 - (  7031  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  الْحَسَنُ بْنُ مُوسَى ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنَا  دَرَّاجٌ ،  عَنِ  السَّائِبِ مَوْلَى أُمِّ سَلَمَةَ ،  أَنَّ  نِسْوَةً دَخَلْنَ عَلَى أُمِّ سَلَمَةَ مِنْ  أَهْلِ حِمْصَ  ، فَسَأَلَتْهُنَّ : مِمَّنْ أَنْتُنَّ ؟ فَقُلْنَ : مِنْ  أَهْلِ حِمْصَ  ، فَقَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  أَيُّمَا امْرَأَةٍ نَزَعَتْ ثِيَابَهَا فِي غَيْرِ بَيْتِهَا ، نَزَعَ اللهُ عَنْهَا سِتْرًا  .","","Musnad Abi Ya'la al-Mawsili 7031","","هند بنت أبي أمية زوج رسول الله عن السائب بن عبد الله مولى أم سلمة عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم سلمة زوج النبي - صلى الله عليه وسلم"
"7036","[12/461]      حَدِيثُ  حَفْصَةَ  أُمِّ الْمُؤْمِنِينَ رَضِيَ اللهُ عَنْهَا  1 - (  7032  ) -  وَبِالْإِسْنَادِ  قَالَ :  أَخْبَرَنَا  أَبُو الْقَاسِمِ زَاهِرُ بْنُ طَاهِرِ بْنِ مُحَمَّدٍ الشَّحَّامِيُّ ،  أَخْبَرَنَا أَبُو سَعْدٍ مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ مُحَمَّدٍ الْجَنْزَرُوذِيُّ  قِرَاءَةً عَلَيْهِ  وَأَنَا أَسْمَعُ مَرَّتَيْنِ  : مَرَّةً فِي جُمَادَى الْأُولَى سَنَةَ إِحْدَى وَخَمْسِينَ وَأَرْبَعِمِائَةٍ ، وَمَرَّةً فِي جُمَادَى الْآخِرَةِ مِنْهَا ، وَالشَّيْخُ أَبُو بَكْرٍ مُحَمَّدُ بْنُ مُحَمَّدِ بْنِ حَمْدُونَ         [12/462]      السُّلَمِيُّ ،  قِرَاءَةً عَلَيْهِ  فِي غُرَّةِ شَعْبَانَ سَنَةَ ثَلَاثٍ وَخَمْسِينَ وَأَرْبَعِمِائَةٍ ،  بِقِرَاءَةِ  الشَّيْخِ أَبِي صَالِحٍ الْمُؤَذِّنِ - رَحِمَهُ اللهُ - قَالَا :  أَخْبَرَنَا  أَبُو عَمْرٍو مُحَمَّدُ بْنُ أَحْمَدَ بْنِ حَمْدَانَ بْنِ عَلِيِّ بْنِ عَبْدِ اللهِ بْنِ سِنَانٍ الْحِيرِيُّ ، قَالَ  الْجَنْزَرُوذِيُّ  بِقِرَاءَةِ  أَبِي جَعْفَرٍ الْعَزَائِمِيِّ فِي رَجَبٍ سَنَةَ خَمْسٍ وَسَبْعِينَ وَثَلَاثِمِائَةٍ فَأَقَرَّ بِهِ وَقَالَ : نَعَمْ ،  أَخْبَرَنَا  أَبُو يَعْلَى أَحْمَدُ بْنُ الْمُثَنَّى الْمَوْصِلِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ ابْنُ أَخِي جُوَيْرِيَةَ ،  حَدَّثَنَا  جُوَيْرِيَةُ ،  عَنْ  نَافِعٍ ،  عَنْ  عَبْدِ اللهِ ،  عَنْ  حَفْصَةَ أُمِّ الْمُؤْمِنِينَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُصَلِّي رَكْعَتَيْنِ إِذَا طَلَعَ الْفَجْرُ  .         [12/463]             [12/464]","","Musnad Abi Ya'la al-Mawsili 7032","","حفصة بنت عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7037","2 - (  7033  ) -  حَدَّثَنَا  عَبْدُ اللهِ ،  حَدَّثَنَا  جُوَيْرِيَةُ ،  عَنْ  نَافِعٍ ، أَنَّ صَفِيَّةَ بِنْتَ أَبِي عُبَيْدٍ ،  حَدَّثَتْهُ  عَنْ  حَفْصَةَ ، أَوْ  عَنْ  عَائِشَةَ ، أَوْ عَنْ كِلْتَيْهِمَا  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا يَحِلُّ لِامْرَأَةٍ  تُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ ، أَوْ تُؤْمِنُ بِاللهِ وَرَسُولِهِ  أَنْ  تُحِدَّ  عَلَى مَيِّتٍ فَوْقَ ثَلَاثَةِ  أَيَّامٍ إِلَّا عَلَى زَوْجِهَا  .         [12/465]","","Musnad Abi Ya'la al-Mawsili 7033","","عائشة بنت أبي بكر الصديق عن صفية بنت أبي عبيد زوج عبد الله بن عمر عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7038","3 - (  7034  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَاصِمِ بْنِ بَهْدَلَةَ ،  عَنْ  سَوَاءٍ ،  عَنْ  حَفْصَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا أَوَى إِلَى فِرَاشِهِ اضْطَجَعَ عَلَى يَمِينِهِ  وَقَالَ : رَبِّ قِنِي عَذَابَكَ يَوْمَ تَبْعَثُ عِبَادَكَ  .         [12/466]","","Musnad Abi Ya'la al-Mawsili 7034","","حفصة بنت عمر بن الخطاب عن سواء الخزاعي عن عاصم بن بهدلة عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7039","4 - (  7035  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدَةُ ،  عَنْ  عَبْدِ اللهِ ،  عَنْ  نَافِعٍ ،  عَنْ  صَفِيَّةَ بِنْتِ أَبِي عُبَيْدٍ ،  عَنْ  حَفْصَةَ بِنْتِ عُمَرَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَحِلُّ لِامْرَأَةٍ تُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ أَنْ  تُحِدَّ  عَلَى مَيِّتٍ فَوْقَ ثَلَاثٍ  ، إِلَّا عَلَى زَوْجٍ  .","","Musnad Abi Ya'la al-Mawsili 7035","","حفصة بنت عمر بن الخطاب عن صفية بنت أبي عبيد زوج عبد الله بن عمر عن نافع مولى ابن عمر عن عبد الله بن عمر العمري عن عبدة بن سليمان الكلابي عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7040","5 - (  7036  ) -  حَدَّثَنَا  أَبُو طَالِبٍ عَبْدُ الْجَبَّارِ بْنُ عَاصِمٍ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو الرَّقِّيُّ ،  عَنْ  عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  حَفْصَةَ بِنْتِ عُمَرَ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا أَذَّنَ الْمُؤَذِّنُ بِالْفَجْرِ ، قَامَ فَصَلَّى رَكْعَتَيِ الْفَجْرِ  ، ثُمَّ خَرَجَ إِلَى الْمَسْجِدِ وَحَرَّمَ الطَّعَامَ ، قَالَ : وَكَانَ لَا يُؤَذِّنُ حَتَّى يُصْبِحَ  .","","Musnad Abi Ya'la al-Mawsili 7036","","حفصة بنت عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الكريم الاصطخري عن عبيد الله بن عمرو بن أبي الوليد عن عبد الجبار بن عاصم الخراساني عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7041","6 - (  7037  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  حُسَيْنُ بْنُ عَلِيٍّ ،  عَنْ  زَائِدَةَ ،  عَنْ  عَاصِمٍ ،  عَنِ  الْمُسَيِّبِ ،         [12/467]      عَنْ  حَفْصَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَصُومُ الِاثْنَيْنِ ، وَالْخَمِيسَ  .","","Musnad Abi Ya'la al-Mawsili 7037","","حفصة بنت عمر بن الخطاب عن المسيب بن رافع الكاهلي عن عاصم بن بهدلة عن زائدة بن قدامة عن الحسين بن علي الجعفي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7042","7 - (  7038  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  شُعَيْبُ بْنُ حَرْبٍ ،  حَدَّثَنَا  شَيْبَانُ أَبُو مُعَاوِيَةَ ،  حَدَّثَنَا  أَبُو يَعْفُورٍ الْعَبْدِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي سَعِيدٍ ،  عَنْ  حَفْصَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ فِي  عُثْمَانَ  :  أَلَا أَسْتَحِي مِنْ رَجُلٍ تَسْتَحِي مِنْهُ الْمَلَائِكَةُ  .         [12/468]","","Musnad Abi Ya'la al-Mawsili 7038","","حفصة بنت عمر بن الخطاب عن عبد الله بن أبي سعيد المدني عن وقدان العبدي أبو يعفور عن شيبان بن عبد الرحمن المؤدب عن شعيب بن حرب الأبناوي عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7043","8 - (  7039  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ  حَفْصَةَ  قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا صَلَّى الْجُمُعَةَ دَخَلَ بَيْتَهَا  فَصَلَّى رَكْعَتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 7039","","حفصة بنت عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7044","9 - (  7040  ) -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عَبْدِ اللهِ بْنِ خَالِدٍ الْقُرَشِيُّ قَالَ :  حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ الْحَسَنِ بْنِ بُكَيْرٍ الثَّقَفِيُّ الرَّقِّيُّ ،  حَدَّثَنَا         [12/469]      خَالِدُ بْنُ حَيَّانَ ،  عَنْ  سُلَيْمَانَ بْنِ أَبِي كَرِيمَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ ،  عَنْ  حَفْصَةَ  قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  الدَّجَّالُ لَا يُخْرِجُهُ إِلَّا غَضْبَةٌ يَغْضَبُهَا  .","","Musnad Abi Ya'la al-Mawsili 7040","","حفصة بنت عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سليمان بن أبي كريمة الشامي عن خالد بن حيان الرقي عن عبيد الله بن الحسن بن بكير الثقفي الرقي عن إسماعيل بن عبد الله بن خالد عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7045","10 - (  7041  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  هَاشِمُ بْنُ الْقَاسِمِ ،  حَدَّثَنَا  الْأَشَجِّيُّ ،  عَنْ  عَمْرِو بْنِ قَيْسٍ ،  عَنِ  الْحُرِّ بْنِ الصَّيَّاحِ ،  عَنْ  هُنَيْدَةَ بْنِ خَالِدٍ ،  عَنْ  حَفْصَةَ قَالَتْ :  أَرْبَعَةٌ لَمْ يَكُنْ يَدَعُهُنَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - : صِيَامَ يَوْمِ عَاشُورَاءَ ، وَالْعَشْرَ ، وَثَلَاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ ، وَالرَّكْعَتَيْنِ قَبْلَ الْغَدَاةِ  .         [12/470]","","Musnad Abi Ya'la al-Mawsili 7041","","حفصة بنت عمر بن الخطاب عن هنيدة بن خالد الخزاعي عن حر بن الصياح النخعي عن عمرو بن قيس الملائي عن أبو إسحاق الأشجعي عن هاشم بن القاسم بن مسلم عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7046","11 - (  7042  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَامِرِ بْنِ زُرَارَةَ الْكُوفِيُّ ،  حَدَّثَنَا  ابْنُ أَبِي زَائِدَةَ ،  عَنْ  أَبِي أَيُّوبَ ،  عَنْ  عَاصِمٍ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ، وَمَعْبَدٍ ،  عَنْ  حَارِثَةَ بْنِ وَهْبٍ الْخُزَاعِيِّ قَالَ :  حَدَّثَتْنِي  حَفْصَةُ زَوْجُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَجْعَلُ يَمِينَهُ لِطَعَامِهِ  ، وَيَجْعَلُ شِمَالَهُ لِمَا سِوَى ذَلِكَ  .         [12/471]","","Musnad Abi Ya'la al-Mawsili 7042","","حفصة بنت عمر بن الخطاب عن حارثة بن وهب الخزاعي عن معبد بن خالد بن مزين الجدلي عن عاصم بن بهدلة عن عبد الله بن علي الأزرق عن يحيى بن زكريا بن أبي زائدة عن عبد الله بن عامر بن زرارة الحضرمي عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7047","12 - (  7043  ) -  حَدَّثَنَا  هَارُونُ بْنُ عَبْدِ اللهِ الْبَزَّازُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أُمَيَّةَ بْنِ صَفْوَانَ ،  سَمِعَ  جَدَّهُ  يَقُولُ :  حَدَّثَتْنِي  حَفْصَةُ ، أَنَّهُ قَالَ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَيَؤُمَّنَّ هَذَا الْبَيْتَ جَيْشٌ يَغْزُونَهُ  ، حَتَّى إِذَا كَانُوا  بِبَيْدَاءَ  مِنَ الْأَرْضِ خُسِفَ بِأَوْسَطِهِمْ ، فَنَادَى أَوَّلُهُمْ وَآخِرُهُمْ فَيُخْسَفُ بِهِمْ جَمِيعًا ، فَلَا يَنْجُو إِلَّا الشَّرِيدُ الَّذِي يُخْبِرُ عَنْهُمْ  .         [12/472]      قَالَ  سُفْيَانُ  :  فَقَامَ إِلَى  أُمَيَّةَ  رَجُلٌ ، فَقَالَ : أَشْهَدُ عَلَيْكَ مَا كَذَبْتَ عَلَى جَدِّكَ ، وَأَشْهَدُ عَلَى جَدِّكَ أَنَّهُ لَمْ يَكْذِبْ عَلَى  حَفْصَةَ  ، وَأَشْهَدُ عَلَى  حَفْصَةَ  أَنَّهَا لَمْ تَكْذِبْ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .","","Musnad Abi Ya'la al-Mawsili 7043","","حفصة بنت عمر بن الخطاب عن عبد الله بن صفوان الجمحي عن أمية بن صفوان بن عبد الله بن صفوان الجمحي عن سفيان بن عيينة عن هارون بن عبد الله بن مروان الحمال عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7048","13 - (  7044  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ شَبِيبٍ ، بَغْدَادِيٌّ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ ،  عَنْ  أُمِّ مُبَشِّرٍ ،  عَنْ  حَفْصَةَ ، أَنَّهَا قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنِّي لَأَرْجُو أَنْ لَا يَدْخُلَ النَّارَ أَحَدٌ إِنْ شَاءَ اللهُ شَهِدَ  بَدْرًا         [12/473]      وَالْحُدَيْبِيَةَ  ، قَالَتْ : فَقُلْتُ : أَلَيْسَ اللهُ عَزَّ وَجَلَّ يَقُولُ :         {      وَإِنْ مِنْكُمْ إِلا وَارِدُهَا كَانَ عَلَى رَبِّكَ حَتْمًا مَقْضِيًّا         }      فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَفَلَمْ تَسْمَعِيهِ يَقُولُ :         {      ثُمَّ نُنَجِّي الَّذِينَ اتَّقَوْا وَنَذَرُ الظَّالِمِينَ فِيهَا جِثِيًّا         }      .","","Musnad Abi Ya'la al-Mawsili 7044","","حفصة بنت عمر بن الخطاب عن أم مبشر الأنصارية عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن أبو معاوية الضرير عن الحسن بن شبيب البغدادي عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7049","14 - (  7045  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  حَدَّثَنَا  أَبُو مَعْشَرٍ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عُمَرَ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،         [12/474]      عَنْ  حَفْصَةَ  زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  أَنَّهَا كَانَتْ قَاعِدَةً  وَعَائِشَةُ  مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : وَدِدْتُ أَنَّ مَعِيَ بَعْضَ أَصْحَابِي نَتَحَدَّثُ ، فَقَالَتْ :  عَائِشَةُ  : أَرْسِلْ إِلَى  أَبِي بَكْرٍ  يَتَحَدَّثْ مَعَكَ ، قَالَ : لَا ، قَالَتْ  حَفْصَةُ  : أَرْسِلْ إِلَى  عُمَرَ  يَتَحَدَّثْ مَعَكَ ، قَالَ : لَا ، وَلَكِنْ أُرْسِلُ إِلَى  عُثْمَانَ  ، فَجَاءَ  عُثْمَانُ  فَدَخَلَ فَقَامَتَا فَأَرْخَتَا السِّتْرَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِعُثْمَانَ  :  إِنَّكَ مَقْتُولٌ مُسْتَشْهَدٌ فَاصْبِرْ صَبَّرَكَ اللهُ ، وَلَا  تَخْلَعَنَّ  قَمِيصًا قَمَّصَكَ اللهُ عَزَّ وَجَلَّ  ثِنْتَيْ عَشْرَةَ سَنَةً وَسِتَّةَ أَشْهُرٍ ، حَتَّى تَلْقَى اللهَ وَهُوَ عَنْكَ رَاضٍ ، قَالَ  عُثْمَانُ  : إِنْ دَعَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِي بِالصَّبْرِ ، فَقَالَ : اللَّهُمَّ صَبِّرْهُ ، فَخَرَجَ  عُثْمَانُ  ، فَلَمَّا أَدْبَرَ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : صَبَّرَكَ اللهُ ، فَإِنَّكَ سَوْفَ تُسْتَشْهَدُ وَتَمُوتُ وَأَنْتَ صَائِمٌ وَتُفْطِرُ مَعِي  .         [12/475]","","Musnad Abi Ya'la al-Mawsili 7045","","حفصة بنت عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن عمرو بن أبان بن عثمان بن عفان عن إبراهيم بن عمر بن أبان البصري عن يوسف بن يزيد البراء عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7050","15 - (  7046  ) -  قَالَ  إِبْرَاهِيمُ :  وَحَدَّثَنِي  أَبِي  ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ ،  أَنَّ  عَائِشَةَ حَدَّثَتْهُ مِثْلَ ذَلِكَ .         [12/476]","","Musnad Abi Ya'la al-Mawsili 7046","","عائشة بنت أبي بكر الصديق عن عبد الرحمن بن أبي بكر الصديق عن عمر بن أبان بن عثمان بن عفان عن إبراهيم بن عمر بن أبان البصري عن يوسف بن يزيد البراء عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7051","16 - (  7047  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ  قَالَ  حَمَّادٌ :  أَخْبَرَنَا  عَاصِمٌ ،  عَنْ  سَوَاءٍ أَخِي مُغِيثٍ ،  عَنْ  حَفْصَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَصُومُ ثَلَاثَةَ أَيَّامٍ مِنَ  الشَّهْرِ  : الِاثْنَيْنِ ، وَالْخَمِيسَ ، وَالِاثْنَيْنِ مِنَ الْجُمُعَةِ الْأُخْرَى  .","","Musnad Abi Ya'la al-Mawsili 7047","","حفصة بنت عمر بن الخطاب عن سواء الخزاعي عن عاصم بن بهدلة عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7052","17 - (  7048  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي النَّضْرِ ،  حَدَّثَنَا  أَبُو النَّضْرِ ،  حَدَّثَنَا  أَبُو إِسْحَاقَ الْأَشْجَعِيُّ ، وَلَيْسَ بِعُبَيْدِ اللهِ ،  عَنْ  عَمْرِو بْنِ قَيْسٍ ،  عَنِ  الْحُرِّ بْنِ الصَّيَّاحِ ،  عَنْ  هُنَيْدَةَ بْنِ خَالِدٍ الْخُزَاعِيِّ ،  عَنْ  حَفْصَةَ ، قَالَتْ :  أَرْبَعٌ لَمْ يَكُنْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [12/477]      يَدَعُهُنَّ  : صِيَامَ الْعَشْرِ ، وَعَاشُورَاءَ ، وَصَوْمَ ثَلَاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ ، وَرَكْعَتَيْنِ قَبْلَ الْغَدَاةِ  .","","Musnad Abi Ya'la al-Mawsili 7048","","حفصة بنت عمر بن الخطاب عن هنيدة بن خالد الخزاعي عن حر بن الصياح النخعي عن عمرو بن قيس الملائي عن أبو إسحاق الأشجعي عن هاشم بن القاسم بن مسلم عن أبو بكر بن النضر بن أبي النضر البغدادي عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7053","18 - (  7049  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  هَاشِمُ بْنُ الْقَاسِمِ ،  حَدَّثَنَا  الْأَشْجَعِيُّ ،  عَنْ  عَمْرِو بْنِ قَيْسٍ ، وَلَمْ يَذْكُرْ فِيهِ مَا ذَكَرَ ابْنُهُ .","","Musnad Abi Ya'la al-Mawsili 7049","","حفصة بنت عمر بن الخطاب عن هنيدة بن خالد الخزاعي عن حر بن الصياح النخعي عن عمرو بن قيس الملائي عن أبو إسحاق الأشجعي عن هاشم بن القاسم بن مسلم عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7054","19 - (  7050  ) -  حَدَّثَنَا  خَلَفُ بْنُ هِشَامٍ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  عُبَيْدِ اللهِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  حَفْصَةَ  قَالَتْ :  لَمَّا أَمَرَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ نَحِلَّ بِعُمْرَةٍ ، قُلْتُ : يَا رَسُولَ اللهِ ، مَا يَمْنَعُكَ أَنْ تَحِلَّ مَعَنَا ؟ قَالَ :  إِنِّي  لَبَّدْتُ  رَأْسِي وَقَلَّدْتُ هَدْيِي ، فَلَا  أَحِلُّ  حَتَّى أَنْحَرَ  .         [12/478]","","Musnad Abi Ya'la al-Mawsili 7050","","حفصة بنت عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن علي بن مسهر القرشي عن خلف بن هشام البزار عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7055","20 - (  7051  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُسْلِمِ بْنِ صُبَيْحٍ ،  عَنْ  شُتَيْرِ بْنِ شَكَلٍ ،  عَنْ  حَفْصَةَ بِنْتِ عُمَرَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُقَبِّلُ وَهُوَ صَائِمٌ  .         [12/479]","","Musnad Abi Ya'la al-Mawsili 7051","","حفصة بنت عمر بن الخطاب عن شتير بن شكل العبسي عن مسلم بن صبيح الهمداني عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7056","21 - (  7052  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  حَفْصَةَ  قَالَتْ :  أَمَرَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ نَحِلَّ بِعُمْرَةٍ ، فَقُلْتُ : يَا رَسُولَ اللهِ ، مَا يَمْنَعُكَ أَنْ تَحِلَّ ؟ قَالَ :  إِنِّي أَهْدَيْتُ  وَلَبَّدْتُ  .","","Musnad Abi Ya'la al-Mawsili 7052","","حفصة بنت عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن محمد بن إسحاق عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7057","22 - (  7053  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  نَافِعٍ ،  عَنْ  صَفِيَّةَ بِنْتِ أَبِي عُبَيْدٍ ،  عَنْ  حَفْصَةَ بِنْتِ عُمَرَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَحِلُّ لِامْرَأَةٍ  تُؤْمِنُ بِاللهِ وَرَسُولِهِ ، أَوْ تُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ  ،         [12/480]      أَنْ  تُحِدَّ  عَلَى مَيِّتٍ فَوْقَ ثَلَاثَةِ  أَيَّامٍ إِلَّا عَلَى زَوْجٍ  .","","Musnad Abi Ya'la al-Mawsili 7053","","حفصة بنت عمر بن الخطاب عن صفية بنت أبي عبيد زوج عبد الله بن عمر عن نافع مولى ابن عمر عن يحيى بن سعيد الأنصاري عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7058","23 - (  7054  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  عُبَيْدِ اللهِ قَالَ :  أَخْبَرَنِي  نَافِعٌ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  أَخْبَرَتْنِي  حَفْصَةُ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُصَلِّي سَجْدَتَيْنِ خَفِيفَتَيْنِ إِذَا طَلَعَ الْفَجْرُ  .","","Musnad Abi Ya'la al-Mawsili 7054","","حفصة بنت عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7059","24 - (  7055  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  مَالِكٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنِ  السَّائِبِ بْنِ يَزِيدَ ،  عَنِ  الْمُطَّلِبِ بْنِ أَبِي وَدَاعَةَ ،  عَنْ  حَفْصَةَ قَالَتْ :  مَا رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى فِي  سُبْحَةٍ  جَالِسًا ، حَتَّى كَانَ قَبْلَ مَوْتِهِ بِعَامٍ  ، فَكَانَ يُصَلِّي جَالِسًا ،         [12/481]      فَيَقْرَأُ السُّورَةَ ،  فَيُرَتِّلُهَا  حَتَّى تَكُونَ أَطْوَلَ مِنْ أَطْوَلَ مِنْهَا  .","","Musnad Abi Ya'la al-Mawsili 7055","","حفصة بنت عمر بن الخطاب عن المطلب بن أبي وداعة الجمحي عن السائب بن يزيد الكندي عن الزهري عن مالك بن أنس عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7060","25 - (  7056  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  مَالِكٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  حَفْصَةَ  ،  أَنَّهَا قَالَتْ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : مَا لَكَ لَمْ تَحِلَّ مِنْ عُمْرَتِكَ ؟ قَالَ :  إِنِّي  لَبَّدْتُ  رَأْسِي ، وَقَلَّدْتُ هَدْيِي ، فَلَا  أَحِلُّ  حَتَّى أَنْحَرَ  .         [12/482]","","Musnad Abi Ya'la al-Mawsili 7056","","حفصة بنت عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7061","26 - (  7057  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَيُّوبُ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  رَأَيْتُ فِي الْمَنَامِ كَأَنَّمَا بِيَدِي قِطْعَةُ إِسْتَبْرَقٍ ، وَلَا أُشِيرُ بِهَا إِلَى مَكَانٍ مِنَ الْجَنَّةِ إِلَّا طَارَتْ بِي إِلَيْهِ ،  قَالَ  : فَقَصَّتْهَا  حَفْصَةُ  عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  إِنَّ أَخَاكِ رَجُلٌ صَالِحٌ  ، أَوْ إِنَّ  عَبْدَ اللهِ  رَجُلٌ صَالِحٌ  .         [12/483]","","Musnad Abi Ya'la al-Mawsili 7057","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7062","27 - (  7058  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمِ بْنِ أَبِي النَّجُودِ ،  عَنْ  سَوَاءٍ الْخُزَاعِيِّ ،  عَنْ  حَفْصَةَ بِنْتِ عُمَرَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا أَوَى إِلَى فِرَاشِهِ وَضَعَ يَدَهُ الْيُمْنَى تَحْتَ خَدِّهِ  ، وَقَالَ : رَبِّ قِنِي عَذَابَكَ يَوْمَ تَبْعَثُ عِبَادَكَ ، ثَلَاثَ مَرَّاتٍ  .         [12/484]","","Musnad Abi Ya'la al-Mawsili 7058","","حفصة بنت عمر بن الخطاب عن سواء الخزاعي عن عاصم بن بهدلة عن حماد بن سلمة عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7063","28 - (  7059  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَاصِمِ بْنِ بَهْدَلَةَ ،  عَنْ  سَوَاءٍ ،  عَنْ  حَفْصَةَ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَصُومُ ثَلَاثَةَ أَيَّامٍ مِنَ  الشَّهْرِ  : الِاثْنَيْنِ ، وَالْخَمِيسَ ، وَالِاثْنَيْنِ مِنَ الْجُمُعَةِ الْأُخْرَى  .","","Musnad Abi Ya'la al-Mawsili 7059","","حفصة بنت عمر بن الخطاب عن سواء الخزاعي عن عاصم بن بهدلة عن حماد بن سلمة عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7064","29 - (  7060  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُعَلَّى بْنُ مَنْصُورٍ ،  حَدَّثَنَا  ابْنُ أَبِي زَائِدَةَ ،  حَدَّثَنَا  أَبُو أَيُّوبَ الْأَفْرِيقِيُّ ،  عَنْ  عَاصِمٍ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ وَمَعْبَدٍ ،  عَنْ  حَارِثَةَ بْنِ وَهْبٍ قَالَ :  حَدَّثَتْنِي  حَفْصَةُ زَوْجُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَجْعَلُ يَمِينَهُ لِطَعَامِهِ وَشَرَابِهِ  ، وَيَجْعَلُ يَسَارَهُ لِمَا سِوَى ذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 7060","","حفصة بنت عمر بن الخطاب عن حارثة بن وهب الخزاعي عن معبد بن خالد بن مزين الجدلي عن عاصم بن بهدلة عن عبد الله بن علي الأزرق عن يحيى بن زكريا بن أبي زائدة عن معلى بن منصور الرازي عن زهير بن حرب عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7065","30 - (  7061  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحُ بْنُ أَسْلَمَ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  أَيُّوبَ ، وَعُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  أَنَّ  ابْنَ عُمَرَ رَأَى  ابْنَ صَائِدٍ  فِي سِكَّةٍ مِنْ سِكَكِ  الْمَدِينَةِ  ، فَسَبَّهُ  ابْنُ عُمَرَ  وَوَقَعَ فِيهِ  فَانْتَفَخَ حَتَّى سَدَّ الطَّرِيقَ ، فَضَرَبَهُ  ابْنُ عُمَرَ  بِعَصًا فَسَكَنَ حَتَّى عَادَ ، فَانْتَفَخَ حَتَّى سَدَّ الطَّرِيقَ ،         [12/485]      فَضَرَبَهُ  ابْنُ عُمَرَ  بِعَصًا مَعَهُ حَتَّى كَسَرَهَا عَلَيْهِ ،  فَقَالَتْ  لَهُ حَفْصَةُ : مَا شَأْنُكَ وَشَأْنُهُ ؟ مَا يُولِعُكَ بِهِ ؟ أَمَا سَمِعْتَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّمَا يَخْرُجُ  الدَّجَّالُ  مِنْ غَضْبَةٍ يَغْضَبُهَا  .         [12/486]","","Musnad Abi Ya'la al-Mawsili 7061","","حفصة بنت عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن حماد بن سلمة عن روح بن أسلم الباهلي عن زهير بن حرب عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7066","31 - (  7062  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الْجَبَّارِ الْخَطَّابِيُّ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  حَفْصَةَ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا أَذَّنَ الْمُؤَذِّنُ صَلَّى رَكْعَتَيْنِ  ، وَحَرَّمَ الطَّعَامَ ، وَكَانَ لَا يُؤَذِّنُ حَتَّى يَطْلُعَ الْفَجْرُ  .","","Musnad Abi Ya'la al-Mawsili 7062","","حفصة بنت عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الكريم الاصطخري عن عبيد الله بن عمرو بن أبي الوليد عن عبد الجبار بن محمد الخطابي عن زهير بن حرب عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7067","32 - (  7063  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  كَثِيرُ بْنُ هِشَامٍ ،  حَدَّثَنَا  جَعْفَرٌ ،  حَدَّثَنَا  نَافِعٌ ، أَنَّ  عَبْدَ اللهِ بْنَ عُمَرَ  أَخْبَرَهُ  ،  أَنَّ  حَفْصَةَ  ، قَالَتْ :  أَمَرَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ  أَحِلَّ  فِي حَجَّتِهِ الَّتِي حَجَّ  .","","Musnad Abi Ya'la al-Mawsili 7063","","حفصة بنت عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جعفر بن برقان الكلابي عن كثير بن هشام الكلابي عن زهير بن حرب عن أبو يعلى الموصلي","حديث حفصة أم المؤمنين رضي الله عنها"
"7068","[12/487]      حَدِيثُ  جُوَيْرِيَةَ بِنْتِ الْحَارِثِ  1 - (  7064  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  شَبَابَةُ ،         [12/488]      عَنْ  شُعْبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي أَيُّوبَ الْعَتَكِيِّ ،  عَنْ  جُوَيْرِيَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَخَلَ عَلَيْهَا وَهِيَ صَائِمَةٌ يَوْمَ الْجُمُعَةِ ، فَقَالَ لَهَا : أَصُمْتِ أَمْسِ ؟  قَالَتْ : لَا ، قَالَ : أَفَتَصُومِينَ غَدًا ؟ قَالَتْ : لَا ، قَالَ : فَأَفْطِرِي  .         [12/489]             [12/490]","","Musnad Abi Ya'la al-Mawsili 7064","","جويرية بنت الحارث المصطلقية عن أبو أيوب المراغي عن قتادة بن دعامة عن شعبة بن الحجاج عن شبابة بن سوار المدائني عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث جويرية بنت الحارث"
"7069","2 - (  7065  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  حَدَّثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي أَيُّوبَ ،  عَنْ  جُوَيْرِيَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِمِثْلِهِ .","","Musnad Abi Ya'la al-Mawsili 7065","","جويرية بنت الحارث المصطلقية عن أبو أيوب المراغي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","حديث جويرية بنت الحارث"
"7070","3 - (  7066  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  هَمَّامٌ ،  حَدَّثَنَا  قَتَادَةُ ،  عَنْ  أَبِي أَيُّوبَ ،  عَنْ  جُوَيْرِيَةَ بِنْتِ الْحَارِثِ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَخَلَ عَلَيْهَا وَهِيَ صَائِمَةٌ يَوْمَ الْجُمُعَةِ فَقَالَ :  هَلْ صُمْتِ أَمْسِ ؟  قَالَتْ : لَا ، قَالَ : أَفَتُرِيدِينَ أَنْ تَصُومِي غَدًا ؟ قَالَتْ : لَا ، قَالَ : فَأَفْطِرِي  .","","Musnad Abi Ya'la al-Mawsili 7066","","جويرية بنت الحارث المصطلقية عن أبو أيوب المراغي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن هدبة بن خالد عن أبو يعلى الموصلي","حديث جويرية بنت الحارث"
"7071","4 - (  7067  ) -  حَدَّثَنَا  زُهَيْرُ بْنُ حَرْبٍ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ بْنِ السَّبَّاقِ ،  عَنْ  جُوَيْرِيَةَ بِنْتِ الْحَارِثِ ، قَالَتْ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : هَلْ مِنْ طَعَامٍ  ؟ فَقَالَتْ : لَا ، إِلَّا عَظْمًا أُعْطِيَتْهُ مَوْلَاتُنَا مِنَ الصَّدَقَةِ ، فَقَالَ : قَرِّبِيهِ فَقَدْ بَلَغَتْ  مَحِلَّهَا  .         [12/491]","","Musnad Abi Ya'la al-Mawsili 7067","","جويرية بنت الحارث المصطلقية عن عبيد بن السباق  العبدري عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","حديث جويرية بنت الحارث"
"7072","5 - (  7068  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ مَوْلَى آلِ طَلْحَةَ قَالَ :  سَمِعْتُ  كُرَيْبًا مَوْلَى ابْنِ عَبَّاسٍ  يُحَدِّثُ عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  جُوَيْرِيَةَ بِنْتِ الْحَارِثِ قَالَتْ :  أَتَى عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - غُدْوَةً وَأَنَا أُسَبِّحُ ، ثُمَّ انْطَلَقَ لِحَاجَتِهِ ، ثُمَّ رَجَعَ قَرِيبًا مِنْ نِصْفِ النَّهَارِ ، فَقَالَ : مَا زِلْتِ قَاعِدَةً ؟ قَالَتْ : قُلْتُ : نَعَمْ ، قَالَ :  أَلَا أُعَلِّمُكِ كَلِمَاتٍ  لَوْ عُدِلْنَ بِهِنَّ عَدَلَتْهُنَّ - أَوْ لَوْ وُزِنَّ بِهِنَّ وَزَنَتْهُنَّ  ؟  يَعْنِي : بِجَمِيعِ مَا سَبَّحْتِ - سُبْحَانَ اللهِ عَدَدَ خَلْقِهِ ثَلَاثَ مَرَّاتٍ ، سُبْحَانَ اللهِ  زِنَةَ  عَرْشِهِ ثَلَاثَ مَرَّاتٍ ، سُبْحَانَ اللهِ رِضَى نَفْسِهِ ثَلَاثَ مَرَّاتٍ ، سُبْحَانَ اللهِ  مِدَادَ  كَلِمَاتِهِ  ثَلَاثَ مَرَّاتٍ  .","","Musnad Abi Ya'la al-Mawsili 7068","","جويرية بنت الحارث المصطلقية عن عبد الله بن عباس عن كريب بن أبي مسلم الحجازي عن محمد بن عبد الرحمن بن عبيد الطلحي عن شعبة بن الحجاج عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","حديث جويرية بنت الحارث"
"7073","[12/492]             [12/493]      حَدِيثُ  صَفِيَّةَ  أُمِّ الْمُؤْمِنِينَ  1 - (  7069  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  سَلَمَةَ ،  عَنْ  أَبِي إِدْرِيسَ ،  عَنِ  ابْنِ صَفْوَانَ ،  عَنْ  صَفِيَّةَ أُمِّ الْمُؤْمِنِينَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَنْتَهِي النَّاسُ عَنْ غَزْوِ هَذَا  الْبَيْتِ  حَتَّى يَغْزُوَهُ جَيْشٌ  ، حَتَّى إِذَا كَانُوا  بِبَيْدَاءَ  مِنَ الْأَرْضِ خُسِفَ بِأَوَّلِهِمْ وَآخِرِهِمْ ، وَلَمْ يَنْجُ أَوْسَطُهُمْ ، قَالَتْ : قُلْتُ : يَا رَسُولَ اللهِ ، أَرَأَيْتَ الْمُكْرَهَ مِنْهُمْ ؟ قَالَ : يَبْعَثُهُمُ اللهُ عَلَى مَا فِي أَنْفُسِهِمْ  .","","Musnad Abi Ya'la al-Mawsili 7069","","صفية بنت حيي زوج رسول الله عن مسلم بن صفوان عن أبو إدريس المرهبي عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","حديث صفية أم المؤمنين"
"7074","[12/494]      حَدِيثُ  سَلْمَى بِنْتِ قَيْسٍ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  1 - (  7070  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  ابْنِ إِسْحَاقَ قَالَ :  حَدَّثَنِي  سَلِيطُ بْنُ أَيُّوبَ ،  عَنْ  أُمِّهِ  ،  عَنْ  سَلْمَى ، وَكَانَتْ إِحْدَى خَالَاتِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [12/495]      قَدْ صَلَّتْ مَعَهُ الْقِبْلَتَيْنِ ، وَكَانَتْ إِحْدَى نِسَاءِ  بَنِي عَدِيِّ بْنِ النَّجَّارِ  ، قَالَتْ :  جِئْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نُبَايِعُهُ  فِي نِسْوَةٍ مِنَ  الْأَنْصَارِ  ، فَلَمَّا شَرَطَ عَلَيْنَا أَنْ لَا نُشْرِكَ بِاللهِ شَيْئًا ، وَلَا نَسْرِقَ ، وَلَا نَزْنِيَ ، وَلَا نَقْتُلَ أَوْلَادَنَا ، وَلَا نَأْتِيَ  بِبُهْتَانٍ  نَفْتَرِيهِ  بَيْنَ أَيْدِينَا وَأَرْجُلِنَا ، وَلَا نَعْصِيَهُ فِي مَعْرُوفٍ قَالَ : وَلَا تَغْشُشْنَ أَزْوَاجَكُنَّ ، قَالَتْ : فَبَايَعْنَاهُ ثُمَّ انْصَرَفْنَا ، فَقُلْتُ  لِامْرَأَةٍ  مِنْهُنَّ : ارْجِعِي فَسَلِي رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَا غِشُّ أَزْوَاجِنَا ؟ قَالَتْ : فَسَأَلَتْهُ ، فَقَالَ : تَأْخُذُ مَالَهُ فَتُحَابِي بِهِ غَيْرَهُ  .","","Musnad Abi Ya'la al-Mawsili 7070","","أم المنذر بنت قيس النجارية عن أم سليط بن أيوب الأنصاري عن سليط بن أيوب الأنصاري عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","حديث سلمى بنت قيس عن النبي - صلى الله عليه وسلم"
"7075","[12/496]      حَدِيثُ  أُمِّ الْفَضْلِ بِنْتِ الْحَارِثِ  1 - (  7071  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أُمِّهِ أُمِّ الْفَضْلِ  ، أَنَّهَا  سَمِعَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْرَأُ فِي الْمَغْرِبِ بِـ         {      وَالْمُرْسَلاتِ عُرْفًا         }      .         [12/497]             [12/498]","","Musnad Abi Ya'la al-Mawsili 7071","","لبابة بنت الحارث الهلالية عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم الفضل بنت الحارث"
"7076","2 - (  7072  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي الْخَلِيلِ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  أُمِّ الْفَضْلِ قَالَتْ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ فِي بَيْتِي ، فَقَالَ : كَانَتْ لِي امْرَأَةٌ فَتَزَوَّجْتُ عَلَيْهَا امْرَأَةً ، فَزَعَمَتِ امْرَأَتِي الْأُولَى أَنَّهَا أَرْضَعَتِ الْحُدْثَى إِمْلَاجَةً أَوْ إِمْلَاجَتَيْنِ ، فَقَالَ :  لَا تُحَرِّمُ الْإِمْلَاجَةُ وَلَا الْإِمْلَاجَتَانِ  .         [12/499]","","Musnad Abi Ya'la al-Mawsili 7072","","لبابة بنت الحارث الهلالية عن عبد الله بن الحارث بن نوفل عن صالح بن أبي مريم الضبعي عن أيوب السختياني عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم الفضل بنت الحارث"
"7077","3 - (  7073  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  سُفْيَانَ ،  عَنْ  سَالِمٍ أَبِي النَّضْرِ ،  عَنْ  عُمَيْرٍ مَوْلَى أُمِّ الْفَضْلِ ،  عَنْ  أُمِّ الْفَضْلِ ،  أَنَّهُمْ تَمَارَوْا فِي صَوْمِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَ عَرَفَةَ  ، فَبَعَثْتُ إِلَيْهِ إِنَاءً مِنْ لَبَنٍ فَشَرِبَ  .         [12/500]","","Musnad Abi Ya'la al-Mawsili 7073","","لبابة بنت الحارث الهلالية عن عمير بن عبد الله الهلالي عن سالم بن أبي أمية التيمي عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم الفضل بنت الحارث"
"7078","4 - (  7074  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  حَدَّثَنَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكٍ ،  عَنْ  قَابُوسَ بْنِ أَبِي الْمُخَارِقِ ،  عَنْ  أُمِّ الْفَضْلِ ، قَالَتْ :  رَأَيْتُ كَأَنَّ فِي بَيْتِي طَبَقًا مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَزِعْتُ مِنْ ذَلِكَ ، فَذَكَرْتُ لَهُ ذَلِكَ ، فَقَالَ : خَيْرٌ إِنْ شَاءَ اللهُ ، تَلِدُ  فَاطِمَةُ  غُلَامًا تَكْفُلِينَهُ بِلَبَنِ ابْنِكِ  قُثَمٍ  ،         [12/501]      قَالَتْ : فَوَلَدَتْ  حَسَنًا  فَأَعْطَتْنِيهِ فَأَرْضَعْتُهُ ، ثُمَّ جِئْتُ بِهِ فَأَجْلَسْتُهُ فِي حِجْرِهِ ، فَبَالَ عَلَيْهِ فَضَرَبْتُ بَيْنَ كَتِفَيْهِ ، فَقَالَ : ارْفُقِي  أَصْلَحَكِ اللهُ ، أَوْ رَحِمَكِ اللهُ  أَوْجَعْتِ ابْنِي ، قَالَتْ : فَقُلْتُ : اخْلَعْ إِزَارَكَ وَالْبَسْ ثَوْبًا غَيْرَهُ حَتَّى أَغْسِلَهُ ، قَالَ :  إِنَّمَا يُغْسَلُ بَوْلُ الْجَارِيَةِ ،  وَيُنْضَحُ  بَوْلُ الْغُلَامِ  .         [12/502]","","Musnad Abi Ya'la al-Mawsili 7074","","لبابة بنت الحارث الهلالية عن قابوس بن أبي المخارق الشيباني عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن يحيى بن أبي بكير عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم الفضل بنت الحارث"
"7079","5 - (  7075  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنِ  ابْنِ إِسْحَاقَ قَالَ :  أَخْبَرَنِي  حُسَيْنُ بْنُ عَبْدِ اللهِ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أُمِّ الْفَضْلِ بِنْتِ الْحَارِثِ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَأَى  أُمَّ حَبِيبَةَ  وَهِيَ فُوَيْقَ  الْفَطِيمِ  ، فَقَالَ :  لَئِنْ بَلَغَتْ بُنَيَّةُ  الْعَبَّاسِ  هَذِهِ وَأَنَا حَيٌّ لَأَتَزَوَّجَنَّهَا  .         [12/503]","","Musnad Abi Ya'la al-Mawsili 7075","","لبابة بنت الحارث الهلالية عن عبد الله بن عباس عن عكرمة مولى ابن عباس عن الحسين بن عبد الله بن عبيد الله بن عباس الهاشمي عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم الفضل بنت الحارث"
"7080","6 - (  7076  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ غَيْلَانَ ،  حَدَّثَنَا  الْمُفَضَّلُ بْنُ فَضَالَةَ قَالَ :  حَدَّثَنِي  يَزِيدُ بْنُ عَبْدِ اللهِ بْنِ الْهَادِ ، أَنَّ هِنْدَ بِنْتَ الْحَارِثِ ،  حَدَّثَتْهُ  عَنْ  أُمِّ الْفَضْلِ بْنِ عَبَّاسٍ ، قَالَتْ :  دَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى عَمِّهِ وَهُوَ شَاكٍ يَتَمَنَّى الْمَوْتَ لِلَّذِي هُوَ فِيهِ مِنْ مَرَضِهِ ، فَضَرَبَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِيَدِهِ عَلَى صَدْرِ  الْعَبَّاسِ  ، ثُمَّ قَالَ :  لَا تَتَمَنَّ الْمَوْتَ يَا عَمَّ رَسُولِ اللهِ ، فَإِنَّكَ إِنْ تَبْقَ تَزْدَدْ خَيْرًا يَكُونُ ذَلِكَ فَهُوَ خَيْرٌ لَكَ  ، وَإِنْ تَبْقَ  تَسْتَعْتِبْ  مِنْ شَيْءٍ يَكُونُ ذَلِكَ خَيْرًا لَكَ  .","","Musnad Abi Ya'la al-Mawsili 7076","","لبابة بنت الحارث الهلالية عن هند بنت الحارث الخثعمية عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن المفضل بن فضالة عن يحيى بن غيلان عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم الفضل بنت الحارث"
"7081","[12/504]      حَدِيثُ  خَدِيجَةَ بِنْتِ خُوَيْلِدٍ  رَضِيَ اللهُ عَنْهَا عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  1 - (  7077  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  سَهْلُ بْنُ زِيَادٍ الْحَرْبِيُّ ، بَصْرِيٌّ  ثِقَةٌ  ، قَالَ :  حَدَّثَنِي  الْأَزْرَقُ بْنُ قَيْسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ نَوْفَلٍ - أَوْ  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ  ،  شَكَّ  سَهْلٌ  -         [12/505]      عَنْ  خَدِيجَةَ بِنْتِ خُوَيْلِدٍ قَالَتْ :  سَأَلْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قُلْتُ : بِأَبِي أَيْنَ أَطْفَالِي مِنْكَ ؟ قَالَ : فِي الْجَنَّةِ  ، قَالَتْ : وَسَأَلْتُهُ أَيْنَ أَطْفَالِي مِنْ أَزْوَاجِي الْمُشْرِكِينَ ؟ قَالَ : فِي النَّارِ ، قُلْتُ : بِغَيْرِ  عَمَلٍ  ؟ قَالَ : اللهُ أَعْلَمُ بِمَا كَانُوا  عَامِلِينَ  .         [12/506]","","Musnad Abi Ya'la al-Mawsili 7077","","أم المؤمنين خديجة الطاهرة عن عبد الله بن بريدة عن أزرق بن قيس الحارثي عن سهل بن زياد الطحان عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث خديجة بنت خويلد رضي الله عنها"
"7082","حَدِيثُ  مَيْمُونَةَ  زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  1 - (  7078  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  مَيْمُونَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سُئِلَ عَنْ  فَأْرَةٍ  وَقَعَتْ فِي سَمْنٍ فَمَاتَتْ ، فَقَالَ :  أَلْقُوهَا وَمَا حَوْلَهَا وَكُلُوهُ  .         [12/507]","","Musnad Abi Ya'la al-Mawsili 7078","","ميمونة بنت الحارث زوج رسول الله عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7083","2 - (  7079  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ ،  عَنِ  ابْنِ عَبَّاسٍ ،         [12/508]      عَنْ  مَيْمُونَةَ :  مَرَّ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِشَاةٍ مَيْتَةٍ فَقَالَ :  أَلَا أَخَذُوا إِهَابَهَا ، فَدَبَغُوهُ فَاسْتَنْفَعُوا بِهِ ؟  قَالُوا : إِنَّهَا مَيْتَةٌ ؟ قَالَ : إِنَّمَا حُرِّمَ أَكْلُهَا  .         [12/509]","","Musnad Abi Ya'la al-Mawsili 7079","","ميمونة بنت الحارث زوج رسول الله عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7084","3 - (  7080  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ         [12/510]             [12/511]      أَخْبَرَتْهُ  مَيْمُونَةُ  أَنَّهَا كَانَتْ تَغْتَسِلُ هِيَ وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ إِنَاءٍ وَاحِدٍ  .         [12/512]","","Musnad Abi Ya'la al-Mawsili 7080","","ميمونة بنت الحارث زوج رسول الله عن عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7085","4 - (  7081  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  مَنْبُوذٍ ،  عَنْ  أُمِّهِ  ، قَالَتْ :  كُنْتُ عِنْدَ مَيْمُونَةَ ، فَدَخَلَ عَلَيْهَا  ابْنُ عَبَّاسٍ  ،  فَقَالَتْ  : أَيْ بُنَيَّ ، مَا لِي أَرَاكَ شَعِثًا رَأْسُكَ ؟ قَالَ :  أُمُّ عَمَّارٍ  مُرَجِّلَتِي حَائِضٌ         [12/513]      ، قَالَتْ : أَيْ بُنَيَّ وَأَيْنَ الْحَيْضَةُ مِنَ الْيَدِ ؟  قَدْ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَدْخُلُ عَلَى إِحْدَانَا وَهِيَ حَائِضٌ فَيَضَعُ رَأْسَهُ فِي حَجْرِهَا  وَهِيَ حَائِضٌ ، وَتَأْتِيهِ إِحْدَانَا  بِخُمْرَتِهِ  فَتَبْسُطُهَا وَهِيَ حَائِضٌ ، أَيْ بُنَيَّ أَيْنَ الْحَيْضَةُ مِنَ الْيَدِ .  ؟","","Musnad Abi Ya'la al-Mawsili 7081","","ميمونة بنت الحارث زوج رسول الله عن أم منبوذ بنت محيصة عن منبوذ بن أبي سليمان السامي عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7086","5 - (  7082  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ شَدَّادٍ قَالَ :  قَالَتْ  مَيْمُونَةُ ،  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَيُبَاشِرُ النِّسَاءَ وَهُنَّ حُيَّضٌ يَأْمُرُهُنَّ أَنْ يَأْتَزِرْنَ  .         [12/514]","","Musnad Abi Ya'la al-Mawsili 7082","","ميمونة بنت الحارث زوج رسول الله عن عبد الله بن شداد بن الهاد الليثي عن سليمان بن فيروز الشيباني عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7087","6 - (  7083  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،         [12/515]      عَنْ  زِيَادِ بْنِ عَمْرِو بْنِ هِنْدٍ ،  عَنْ  عِمْرَانَ بْنِ حُذَيْفَةَ قَالَ :  كَانَتْ مَيْمُونَةُ تَدَّانُ فَتُكْثِرُ ، فَقَالَ لَهَا أَهْلُهَا فِي ذَلِكَ ، وَوَجَدُوا عَلَيْهَا ،  فَقَالَتْ  : لَا أَتْرُكُ وَقَدْ سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا مِنْ أَحَدٍ يَدَّانُ دَيْنًا فَعَلِمَ اللهُ عَزَّ وَجَلَّ أَنَّهُ يُرِيدُ قَضَاءَهُ إِلَّا أَدَّاهُ عَنْهُ فِي الدُّنْيَا  .         [12/516]             [12/517]","","Musnad Abi Ya'la al-Mawsili 7083","","ميمونة بنت الحارث زوج رسول الله عن عمران بن حذيفة عن زياد بن عمرو الجملي عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7088","7 - (  7084  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  يَزِيدَ بْنِ الْأَصَمِّ ،  عَنْ  خَالَتِهِ مَيْمُونَةَ ، قَالَتْ :  أُهْدِيَ لَنَا ضَبٌّ ، قَالَتْ : فَأَتَاهَا رَجُلَانِ مِنْ قَوْمِهَا فَأَمَرَتْ بِهِ ، فَصُنِعَ ثُمَّ قَرَّبَتْهُ إِلَيْهِمَا ، قَالَتْ : فَجَاءَنِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُمَا يَأْكُلَانِ فَرَحَّبَ بِهِمَا ، ثُمَّ أَخَذَ يَأْكُلُ ، فَلَمَّا أَخَذَ اللُّقْمَةَ إِلَى فِيهِ قَالَ : مَا هَذَا ؟ قَالَتْ : ضَبٌّ أُهْدِيَ لَنَا ، قَالَتْ : فَوَضَعَ اللُّقْمَةَ ، فَأَرَادَ الرَّجُلَانِ أَنْ يَطْرَحَا مَا فِي أَفْوَاهِهِمَا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَفْعَلَا ، إِنَّكُمْ  أَهْلَ نَجْدٍ  تَأْكُلُونَهَا ، وَإِنَّا  أَهْلَ تِهَامَةَ  نَعَافُهَا  .         [12/518]","","Musnad Abi Ya'la al-Mawsili 7084","","ميمونة بنت الحارث زوج رسول الله عن يزيد بن الأصم بن عبيد البكائي عن يزيد بن أبي زياد القرشي عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7089","8 - (  7085  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  حَدَّثَنَا  حَنْظَلَةُ السَّدُوسِيُّ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ الْحَارِثِ بْنِ نَوْفَلٍ  يُحَدِّثُ ، أَنَّ  مَيْمُونَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي رَكْعَتَيْنِ قَبْلَ الْعَصْرِ  ، قَالَتْ : وَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا صَلَّى صَلَاةً أَحَبَّ أَنْ يُدَاوِمَ عَلَيْهَا  .         [12/519]","","Musnad Abi Ya'la al-Mawsili 7085","","ميمونة بنت الحارث زوج رسول الله عن عبد الله بن الحارث بن نوفل عن حنظلة بن عبد الله السدوسي عن عباد بن العوام الكلابي عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7090","9 - (  7086  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ ،  حَدَّثَنَا  لَيْثٌ ،  عَنْ  كَثِيرِ بْنِ فَرْقَدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَالِكِ بْنِ حُذَافَةَ ،  عَنْ  أُمِّهِ الْعَالِيَةِ  ،  عَنْ  مَيْمُونَةَ ، قَالَتْ :  مَرَّ بِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رِجَالٌ مِنْ  قُرَيْشٍ  يَجُرُّونَ شَاةً ، قَالَ :  فَهَلَّا انْتَفَعْتُمْ  بِإِهَابِهَا  ؟  قَالُوا : إِنَّهَا مَيْتَةٌ ، قَالَ : يُطَهِّرُهَا الْمَاءُ وَالْقَرَظُ  .         [12/520]","","Musnad Abi Ya'la al-Mawsili 7086","","ميمونة بنت الحارث زوج رسول الله عن العالية بنت سبيع المدنية عن عبد الله بن مالك بن حذافة الحجازي عن كثير بن فرقد المدني عن الليث بن سعد عن يحيى بن عبد الله بن بكير المخزومي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7091","10 - (  7087  ) -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  يُوسُفُ بْنُ خَالِدٍ ،  عَنْ  عُمَرَ بْنِ إِسْحَاقَ ،  أَنَّهُ سَمِعَ  عَطَاءَ بْنَ يَسَارٍ  يُحَدِّثُ ، عَنْ  مَيْمُونَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : قَالَ اللهُ عَزَّ وَجَلَّ :  مَنْ آذَى لِي وَلِيًّا فَقَدِ اسْتَحَقَّ مُحَارَبَتِي  ، وَمَا تَقَرَّبَ إِلَيَّ عَبْدٌ بِمِثْلِ أَدَاءِ فَرَائِضِي ، وَإِنَّهُ لَيَتَقَرَّبُ إِلَيَّ بِالنَّوَافِلِ حَتَّى أُحِبَّهُ ، فَإِذَا أَحْبَبْتُهُ كُنْتُ رِجْلَهُ الَّتِي يَمْشِي بِهَا ، وَيَدَهُ الَّتِي يَبْطِشُ بِهَا ، وَلِسَانَهُ الَّذِي يَنْطِقُ بِهِ ، وَقَلْبَهُ الَّذِي يَعْقِلُ بِهِ ، إِنْ سَأَلَنِي أَعْطَيْتُهُ ، وَإِنْ دَعَانِي أَجَبْتُهُ ، وَمَا تَرَدَّدْتُ عَنْ شَيْءٍ أَنَا فَاعِلُهُ كَتَرَدُّدِي عَنْ مَوْتِهِ ، وَذَاكَ أَنَّهُ يَكْرَهُهُ وَأَنَا أَكْرَهُ مَسَاءَتَهُ  .         [12/521]             [12/522]             [12/523]","","Musnad Abi Ya'la al-Mawsili 7087","","ميمونة بنت الحارث زوج رسول الله عن عطاء بن يسار الهلالي عن عمر بن إسحاق بن يسار المخرمي عن يوسف بن خالد السمتي عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7092","11 - (  7088  ) -  حَدَّثَنَا  أَبُو مُوسَى إِسْحَاقُ بْنُ إِبْرَاهِيمَ الْهَرَوِيُّ ،  حَدَّثَنَا  عِيسَى بْنُ يُونُسَ ،  حَدَّثَنَا  ثَوْرُ بْنُ يَزِيدَ ،  عَنْ  زِيَادِ بْنِ أَبِي سَوْدَةَ ،  عَنْ  أَخِيهِ  ،  عَنْ  مَيْمُونَةَ ، قَالَتْ :  يَا رَسُولَ اللهِ ، أَفْتِنَا فِي  بَيْتِ الْمَقْدِسِ  ، قَالَ :  هُوَ أَرْضُ الْمَحْشَرِ وَأَرْضُ  الْمَنْشَرِ  ، ائْتُوهُ فَصَلُّوا فِيهِ  ، فَإِنَّ صَلَاةً فِيهِ كَأَلْفِ صَلَاةٍ ، قُلْنَا : يَا رَسُولَ اللهِ ، فَمَنْ لَمْ يَسْتَطِعْ أَنْ يَتَحَمَّلَ إِلَيْهِ ؟ قَالَ : مَنْ لَمْ يَسْتَطِعْ أَنْ يَأْتِيَهُ فَلْيُهْدِ إِلَيْهِ زَيْتًا يُسْرَجُ فِيهِ ، فَإِنَّ مَنْ أَهْدَى إِلَيْهِ زَيْتًا كَانَ كَمَنْ قَدْ أَتَاهُ  .         [12/524]             [12/525]","","Musnad Abi Ya'la al-Mawsili 7088","","ميمونة بنت سعد خادمة النبي عن عثمان بن أبي سودة الفلسطيني عن زياد بن أبي سودة المقدسى عن ثور بن يزيد الكلاعي عن عيسى بن يونس بن أبي إسحاق عن إسحاق بن إبراهيم الهروي عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7093","12 - (  7089  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ سَهْمٍ الْأَنْطَاكِيُّ ،  أَخْبَرَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  أَخْبَرَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  نُدْبَةَ مَوْلَاةِ مَيْمُونَةَ ،  عَنْ  مَيْمُونَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُبَاشِرُ الْمَرْأَةَ مِنْ نِسَائِهِ ، وَهِيَ حَائِضٌ تَكُونُ عَلَيْهَا الْخِرْقَةُ  إِلَى نِصْفِ الْفَخِذَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 7089","","ميمونة بنت الحارث زوج رسول الله عن ندبة مولاة ميمونة أم المؤمنين عن الزهري عن معمر بن راشد عن عبد الله بن المبارك عن محمد بن عبد الرحمن بن حكيم الأنطاكي عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7094","[13/5]      13 - (  7090  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى الْوَاسِطِيُّ ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ شَدَّادٍ ،  عَنْ  خَالَتِهِ مَيْمُونَةَ بِنْتِ الْحَارِثِ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي عَلَى  الْخُمْرَةِ  .         [13/6]","","Musnad Abi Ya'la al-Mawsili 7090","","ميمونة بنت الحارث زوج رسول الله عن عبد الله بن شداد بن الهاد الليثي عن سليمان بن فيروز الشيباني عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7095","14 - (  7091  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عَرْعَرَةَ ،  حَدَّثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  حَدَّثَنَا  أَبِي  قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ إِسْحَاقَ  يُحَدِّثُ  ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي رَافِعٍ ،  عَنْ  مَيْمُونَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَا تَزَالُ أُمَّتِي بِخَيْرٍ  ، مُتَمَاسِكٌ أَمْرُهَا مَا لَمْ يَظْهَرْ فِيهِمْ أَوْلَادُ الزِّنَى ، فَإِذَا ظَهَرُوا ، خِفْتُ أَنْ يَعُمَّهُمُ اللهُ بِعِقَابٍ  .         [13/7]","","Musnad Abi Ya'la al-Mawsili 7091","","ميمونة بنت الحارث زوج رسول الله عن عبيد الله بن علي بن أبي رافع المدني عن محمد بن عبد الرحمن بن لبيبة المكي عن الديباج ، محمد بن عبد الله بن عمرو عن محمد بن إسحاق عن جرير بن حازم عن وهب بن جرير بن حازم عن إبراهيم بن محمد بن عرعرة عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7096","15 - (  7092  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ أَخُو حَجَّاجٍ الْأَنْمَاطِيِّ ،  حَدَّثَنَا  عَبْدُ الْوَاحِدِ يَعْنِي ابْنَ زِيَادٍ ،  حَدَّثَنَا  سُلَيْمَانُ الشَّيْبَانِيُّ قَالَ :  حَدَّثَنِي  عَبْدُ اللهِ بْنُ شَدَّادٍ ،  عَنْ  مَيْمُونَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا أَرَادَ أَنْ يُبَاشِرَ امْرَأَةً مِنْ نِسَائِهِ  ، وَهِيَ حَائِضٌ ، أَمَرَهَا فَاتَّزَرَتْ  .","","Musnad Abi Ya'la al-Mawsili 7092","","ميمونة بنت الحارث زوج رسول الله عن عبد الله بن شداد بن الهاد الليثي عن سليمان بن فيروز الشيباني عن عبد الواحد بن زياد عن محمد بن المنهال الأنماطي عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7097","16 - (  7093  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْمُخَرِّمِيُّ ،  حَدَّثَنَا  يُونُسُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي الْفُرَاتِ وَهُوَ ابْنُ دِينَارٍ الطَّاحِيُّ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي حَفْصَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عَبَّاسٍ ،         [13/8]      عَنْ  مَيْمُونَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ :  أَصْبَحَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَاثِرًا ، ثُمَّ أَمْسَى وَهُوَ كَذَلِكَ ، ثُمَّ أَصْبَحَ وَهُوَ كَذَلِكَ .  قَالَتْ : فَقُلْتُ : يَا رَسُولَ اللهِ ! مَا لِي أَرَاكَ خَاثِرًا ؟ قَالَ :  إِنَّ  جِبْرِيلَ  - عَلَيْهِ السَّلَامُ - وَاعَدَنِي أَنْ يَأْتِيَنِي ، وَمَا أَخْلَفَنِي  قَالَ : فَنَظَرُوا ، فَإِذَا جَرْوُ كَلْبٍ تَحْتَ  نَضَدٍ  لَهُمْ ، فَأَمَرَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِذَلِكَ الْمَكَانِ فَغُسِلَ بِالْمَاءِ قَالَ : وَجَاءَهُ  جِبْرِيلُ  - عَلَيْهِ السَّلَامُ - فَقَالَ لَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" وَاعَدْتَنِي أَنْ تَأْتِيَنِي وَمَا أَخْلَفْتَنِي ، فَقَالَ لَهُ  جِبْرِيلُ  - عَلَيْهِ السَّلَامُ - : "" أَوَمَا عَلِمْتَ أَنَّا لَا نَدْخُلُ بَيْتًا فِيهِ كَلْبٌ وَلَا صُورَةٌ  .         [13/9]","","Musnad Abi Ya'la al-Mawsili 7093","","ميمونة بنت الحارث زوج رسول الله عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن محمد بن أبي حفصة البصري عن محمد بن دينار الطاحي عن يونس بن محمد بن مسلم البغدادي عن محمد بن عبد الله بن المبارك المخرمي عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7098","17 - (  7094  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبُو بَكْرٍ الْحَنَفِيُّ ،  حَدَّثَنَا  عُمَرُ بْنُ إِسْحَاقَ بْنِ يَسَارٍ قَالَ :  قَرَأْتُ  لِعَطَاءٍ كِتَابًا مَعَهُ  ، فَإِذَا فِيهِ :  حَدَّثَتْنِي  مَيْمُونَةُ زَوْجُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهَا قَالَتْ :  يَا رَسُولَ اللهِ ! أَيَخْلَعُ الرَّجُلُ خُفَّيْهِ كُلَّ سَاعَةٍ ؟ قَالَ :  لَا "" ، وَلَكِنْ يَمْسَحُهُمَا مَا بَدَا لَهُ  .         [13/10]","","Musnad Abi Ya'la al-Mawsili 7094","","ميمونة بنت الحارث زوج رسول الله عن عطاء بن يسار الهلالي عن عمر بن إسحاق بن يسار المخرمي عن عبد الكبير بن عبد المجيد الحنفي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7099","18 - (  7095  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ قُدَامَةَ ،  حَدَّثَنَا  سُفْيَانُ بْنُ         [13/11]      عُيَيْنَةَ قَالَ :  حَدَّثَنِي  الشَّيْبَانِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ شَدَّادٍ ،  عَنْ  مَيْمُونَةَ :  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى فِي مِرْطٍ بَعْضُهُ عَلَيْهِ وَبَعْضُهُ عَلَيْهَا وَهِيَ حَائِضٌ  .","","Musnad Abi Ya'la al-Mawsili 7095","","ميمونة بنت الحارث زوج رسول الله عن عبد الله بن شداد بن الهاد الليثي عن سليمان بن فيروز الشيباني عن سفيان بن عيينة عن محمد بن قدامة الجوهري عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7100","19 - (  7096  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنِيعٍ ،  حَدَّثَنَا  مَرْوَانُ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ اللهِ الْعَامِرِيِّ ،  عَنْ  يَزِيدَ بْنِ الْأَصَمِّ ،  عَنْ  مَيْمُونَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : "" سَمِعْتُهَا تَقُولُ :  كَانَ         [13/12]      رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا سَجَدَ  خَوَّى  بِيَدِهِ  حَتَّى يُرَى  وَضَحُ  إِبْطَيْهِ مِنْ وَرَائِهِ ، وَإِذَا قَعَدَ اطْمَأَنَّ عَلَى فَخِذِهِ الْيُسْرَى  .         [13/13]","","Musnad Abi Ya'la al-Mawsili 7096","","ميمونة بنت الحارث زوج رسول الله عن يزيد بن الأصم بن عبيد البكائي عن عبد الله بن عبد الله بن الأصم البكائي عن مروان بن معاوية الفزاري عن أحمد بن منيع البغوي عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7101","20 - (  7097  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ اللهِ ابْنِ أَخِي يَزِيدَ بْنِ الْأَصَمِّ ،  عَنْ  عَمِّهِ ،  عَنْ  خَالَتِهِ مَيْمُونَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا سَجَدَ لَوْ شَاءَتْ بَهِيمَةٌ مَرَّتْ مِنْ تَحْتِ يَدَيْهِ  .         [13/14]","","Musnad Abi Ya'la al-Mawsili 7097","","ميمونة بنت الحارث زوج رسول الله عن يزيد بن الأصم بن عبيد البكائي عن عبد الله بن عبد الله بن الأصم البكائي عن سفيان بن عيينة عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7102","21 - (  7098  ) -  حَدَّثَنَا  أَبُو عَامِرٍ عَبْدُ اللهِ بْنُ عَامِرٍ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ مَنْصُورٍ السَّلُولِيُّ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  مَيْمُونَةَ ، قَالَتْ :  أَجْنَبْتُ أَنَا وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَاغْتَسَلْتُ مِنْ جَفْنَةٍ ، فَفَضَلَ فِيهَا ، فَجَاءَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِيَغْتَسِلَ مِنْهَا ، فَقُلْتُ : إِنِّي قَدِ اغْتَسَلْتُ مِنْهَا ، فَقَالَ :  إِنَّ الْمَاءَ لَيْسَتْ عَلَيْهِ جَنَابَةٌ  .         [13/15]","","Musnad Abi Ya'la al-Mawsili 7098","","ميمونة بنت الحارث زوج رسول الله عن عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن إسحاق بن منصور السلولي عن عبد الله بن عامر بن براد الأشعري عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7103","22 - (  7099  ) -  حَدَّثَنَا  الزِّمَّانِيُّ ،  حَدَّثَنَا  عَبْدُ الْوَهَّابِ ،  حَدَّثَنَا  الْمُثَنَّى ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ مَوْلَى مَيْمُونَةَ ،  عَنْ  مَيْمُونَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ الدُّنْيَا حُلْوَةٌ  خَضِرَةٌ  ، فَمَنِ اتَّقَى فِيهَا وَأَصْلَحَ ، وَإِلَّا فَهُوَ كَالْآكِلِ وَلَا يَشْبَعُ ، فَبُعْدُ النَّاسِ كَبُعْدِ الْكَوْكَبَيْنِ : أَحَدُهُمَا يَطْلُعُ مِنَ الْمَشْرِقِ ، وَالْآخَرُ يَغِيبُ بِالْمَغْرِبِ  .         [13/16]","","Musnad Abi Ya'la al-Mawsili 7099","","ميمونة بنت الحارث زوج رسول الله عن سليمان بن يسار مولى ميمونة زوج رسول الله عن عمرو بن شعيب عن المثنى بن الصباح الأبناوي عن عبد الوهاب بن عبد المجيد الثقفي عن محمد بن يحيى بن فياض الزماني عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7104","23 - (  7100  ) -  حَدَّثَنَا  إِسْحَاقُ قَالَ :  سَمِعْتُ  سُفْيَانَ  بِمِنًى  ، يَقُولُ :  حَفِظْتُهُ مِنْ فِي  الزُّهْرِيِّ  يُحَدِّثُ ، عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  مَيْمُونَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَرَّ بِشَاةٍ لِمَوْلَاةٍ لَهَا أُعْطِيَتْهَا مِنَ الصَّدَقَةِ ، فَقَالَ :  أَلَا أَخَذُوا إِهَابَهَا فَدَبَغُوهُ وَانْتَفَعُوا بِهِ  ، قَالُوا : يَا رَسُولَ اللهِ ! إِنَّمَا هِيَ مَيْتَةٌ ؟ قَالَ : "" إِنَّمَا حُرِّمَ أَكْلُهَا "" . قَالَ  أَبُو يَعْقُوبَ  :  وَبَرَعَ  سُفْيَانُ  بِهَذِهِ الْآيَةِ :         {      قُلْ لا أَجِدُ فِي مَا أُوحِيَ إِلَيَّ مُحَرَّمًا عَلَى طَاعِمٍ يَطْعَمُهُ         }      ، قَالَ  سُفْيَانُ  : فَلَوْ لَمْ يَكُنْ إِلَّا هَذِهِ الْآيَةُ اسْتَدْلَلْتُ بِهَا عَلَى فَاسِدِ الْأَكْلِ  .         [13/17]","","Musnad Abi Ya'la al-Mawsili 7100","","ميمونة بنت الحارث زوج رسول الله عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7105","24 - (  7101  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  كُرَيْبٍ ،  حَدَّثَنَا  ابْنُ عَبَّاسٍ ،  عَنْ  خَالَتِهِ ، قَالَتْ :  وَضَعْتُ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - غُسْلًا ، فَاغْتَسَلَ مِنَ الْجَنَابَةِ ، فَأَكْفَأَ الْإِنَاءَ بِشِمَالِهِ عَلَى يَمِينِهِ  ، فَغَسَلَ كَفَّهُ ثَلَاثًا ، ثُمَّ أَفَاضَ عَلَى فَرْجِهِ فَغَسَلَهُ ، ثُمَّ قَالَ بِيَدِهِ عَلَى الْحَائِطِ ، أَوْ عَلَى الْأَرْضِ ، فَدَلَكَهَا ، ثُمَّ مَضْمَضَ وَاسْتَنْشَقَ ، وَغَسَلَ وَجْهَهُ وَذِرَاعَيْهِ ، وَأَفَاضَ عَلَى رَأْسِهِ ، ثُمَّ أَفَاضَ عَلَى سَائِرِ جَسَدِهِ ، ثُمَّ تَنَحَّى فَغَسَلَ رِجْلَيْهِ ، فَأَتَيْتُهُ بِثَوْبٍ ، فَقَالَ بِيَدِهِ : هَكَذَا ، يَعْنِي : رَدَّهُ  .         [13/18]             [13/19]","","Musnad Abi Ya'la al-Mawsili 7101","","ميمونة بنت الحارث زوج رسول الله عن عبد الله بن عباس عن كريب بن أبي مسلم الحجازي عن سالم بن أبي الجعد الغطفاني عن الأعمش عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7106","25 - (  7102  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  جَعْفَرُ بْنُ بُرْقَانَ ،  عَنْ  يَزِيدَ بْنِ الْأَصَمِّ ،  عَنْ  مَيْمُونَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا سَجَدَ جَافَى حَتَّى يَرَى مَنْ خَلْفَهُ بَيَاضَ إِبْطَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 7102","","ميمونة بنت الحارث زوج رسول الله عن يزيد بن الأصم بن عبيد البكائي عن جعفر بن برقان الكلابي عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7107","26 - (  7103  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  حَدَّثَنَا  زُهَيْرُ بْنُ مُحَمَّدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدٍ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  مَيْمُونَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا تَنْبِذُوا فِي  الدُّبَّاءِ  ، وَلَا         [13/20]      فِي  الْجَرِّ  ، وَلَا فِي  الْمُزَفَّتِ  ، وَكُلُّ شَرَابٍ أَسْكَرَ فَهُوَ حَرَامٌ  .         [13/21]","","Musnad Abi Ya'la al-Mawsili 7103","","ميمونة بنت الحارث زوج رسول الله عن عطاء بن يسار الهلالي عن عبد الله بن محمد بن عقيل بن أبي طالب عن زهير بن محمد التميمي عن أبو عامر العقدي عن زهير بن حرب عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7108","27 - (  7104  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  بِشْرُ بْنُ السَّرِيِّ ،  حَدَّثَنَا  لَيْثٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  حَبِيبٍ مَوْلَى عُرْوَةَ ،  عَنْ  نُدْبَةَ مَوْلَى مَيْمُونَةَ ،  عَنْ  مَيْمُونَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُبَاشِرُ الْمَرْأَةَ مِنْ نِسَائِهِ وَهِيَ حَائِضٌ  ، إِذَا كَانَ عَلَيْهَا إِزَارٌ يَبْلُغُ أَنْصَافَ  الْفَخِذَيْنِ ، أَوِ         [13/22]      الرُّكْبَتَيْنِ  مُحْتَجِرَةً بِهِ  .","","Musnad Abi Ya'la al-Mawsili 7104","","ميمونة بنت الحارث زوج رسول الله عن ندبة مولاة ميمونة أم المؤمنين عن حبيب الأعور مولى عروة بن الزبير عن الزهري عن الليث بن سعد عن بشر بن السري عن زهير بن حرب عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7109","28 - (  7105  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  حَدَّثَنَا  أَبِي  قَالَ :  سَمِعْتُ  أَبَا فَزَارَةَ  يُحَدِّثُ ، عَنْ  يَزِيدَ بْنِ الْأَصَمِّ .  عَنْ  مَيْمُونَةَ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَزَوَّجَهَا حَلَالًا ، وَبَنَى بِهَا حَلَالًا  ، وَمَاتَتْ  بِسَرِفَ  فِي اللَّيْلَةِ الَّتِي بَنَى بِهَا - وَكَانَتْ خَالَتِي - فَنَزَلْتُ فِي قَبْرِهَا أَنَا  وَابْنُ عَبَّاسٍ  ، فَلَمَّا وَضَعْنَاهَا فِي اللَّحْدِ مَالَ رَأْسُهَا ، فَأَخَذْتُ رِدَائِي فَجَمَعْتُهُ ، فَوَضَعْتُهُ تَحْتَ رَأْسِهَا ، فَاجْتَذَبَهُ  ابْنُ عَبَّاسٍ  ، فَرَمَى بِهِ ، وَوَضَعَ تَحْتَ رَأْسِهَا كَذَّانَةً قَالَ : وَكَانَتْ حَلَقَتْ فِي  الْحَجِّ  ، فَكَانَ رَأْسُهَا مُحَمَّمًا  .         [13/23]             [13/24]","","Musnad Abi Ya'la al-Mawsili 7105","","ميمونة بنت الحارث زوج رسول الله عن يزيد بن الأصم بن عبيد البكائي عن راشد بن كيسان العبسي عن جرير بن حازم عن وهب بن جرير بن حازم عن زهير بن حرب عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7110","29 - (  7106  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  حَبِيبِ بْنِ الشَّهِيدِ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  عَنْ  يَزِيدَ بْنِ الْأَصَمِّ ،  عَنْ  مَيْمُونَةَ ، قَالَتْ :  تَزَوَّجَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِسَرِفَ  ، وَهُمَا حَلَالَانِ  ، بَعْدَمَا رَجَعْنَا مِنْ  مَكَّةَ  .","","Musnad Abi Ya'la al-Mawsili 7106","","ميمونة بنت الحارث زوج رسول الله عن يزيد بن الأصم بن عبيد البكائي عن ميمون بن مهران الرقي عن حبيب بن الشهيد عن حماد بن سلمة عن أحمد بن إسحاق الحضرمي عن زهير بن حرب عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7111","30 - (  7107  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  هَاشِمُ بْنُ الْقَاسِمِ ،         [13/25]      حَدَّثَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ قَالَ :  قُلْتُ  لِلْقَاسِمِ  :  أُوتِرُ بِثَلَاثٍ حِينَ يُؤَذِّنُ الْمُؤَذِّنُ  ، ثُمَّ أَخْرُجُ إِلَى الصَّلَاةِ ؟ قَالَ : لَا تُصَلِّ إِلَّا بِخَمْسٍ أَوْ سَبْعٍ  .  قَالَ  الْحَكَمُ  : فَأَخْبَرْتُ بِذَلِكَ مُجَاهِدًا ، وَيَحْيَى بْنَ الْجَزَّارِ ، فَقَالَا لِي : سَلْهُ عَمَّنْ هَذَا ؟ فَقَالَ :  عَنِ  الثِّقَةِ ،  عَنْ  عَائِشَةَ ، وَمَيْمُونَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .  كذا في طبعة دار المأمون للتراث ، ولعل الصواب : ( مقسم )","","Musnad Abi Ya'la al-Mawsili 7107","","عائشة بنت أبي بكر الصديق عن الثقة عن مقسم بن بجرة عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن هاشم بن القاسم بن مسلم عن زهير بن حرب عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7112","31 - (  7108  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  كُرَيْبٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،         [13/26]      عَنْ  مَيْمُونَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اغْتَسَلَ فَأُتِيَ بِمِنْدِيلٍ ، فَلَمْ يَمَسَّهُ  ، وَجَعَلَ يَقُولُ بِالْمَاءِ هَكَذَا مِنْ أَصَابِعِهِ ، يَعْنِي : يَنْفُضُ يَدَهُ  .","","Musnad Abi Ya'la al-Mawsili 7108","","ميمونة بنت الحارث زوج رسول الله عن عبد الله بن عباس عن كريب بن أبي مسلم الحجازي عن سالم بن أبي الجعد الغطفاني عن الأعمش عن عبد الله بن إدريس الأودي عن زهير بن حرب عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7113","32 - (  7109  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  الْحَسَنُ بْنُ مُوسَى ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنَا  بُكَيْرُ بْنُ الْأَشَجِّ ،  عَنْ  كُرَيْبٍ مَوْلَى ابْنِ عَبَّاسٍ قَالَ :  سَمِعْتُ  مَيْمُونَةَ ، قَالَتْ :  أَعْتَقْتُ وَلِيدَةً فِي زَمَنِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرْتُ ذَلِكَ لَهُ ، فَقَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَوْ أَعْطَيْتِهَا أَخْوَالَكِ كَانَ أَعْظَمَ لِأَجْرِكِ  .         [13/27]","","Musnad Abi Ya'la al-Mawsili 7109","","ميمونة بنت الحارث زوج رسول الله عن كريب بن أبي مسلم الحجازي عن بكير بن عبد الله بن الأشج القرشي عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7114","33 - (  7110  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ اللهِ بْنِ الْأَصَمِّ ،  عَنْ  يَزِيدَ الْأَصَمِّ  قَالَ  :  ثَقُلَتْ مَيْمُونَةُ زَوْجُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِمَكَّةَ  وَلَيْسَ عِنْدَهَا مِنْ بَنِي         [13/28]      أَخِيهَا  ، فَقَالَتْ : أَخْرِجُونِي مِنْ  مَكَّةَ  ، فَإِنِّي لَا أَمُوتُ بِهَا ، إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَخْبَرَنِي أَنِّي لَا أَمُوتُ  بِمَكَّةَ  قَالَ : فَحَمَلُوهَا حَتَّى أَتَوْا بِهَا  سَرِفَ  إِلَى الشَّجَرَةِ الَّتِي بَنَى بِهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَحْتَهَا فِي مَوْضِعِ  الْقُبَّةِ  .  قَالَ : فَمَاتَتْ ، فَلَمَّا وَضَعْنَاهَا فِي لَحْدِهَا أَخَذْتُ رِدَائِي فَوَضَعْتُهُ تَحْتَ خَدِّهَا فِي اللَّحْدِ ، فَأَخَذَهُ  ابْنُ عَبَّاسٍ  فَرَمَى بِهِ  .","","Musnad Abi Ya'la al-Mawsili 7110","","ميمونة بنت الحارث زوج رسول الله عن يزيد بن الأصم بن عبيد البكائي عن عبد الله بن عبد الله بن الأصم البكائي عن عبد الواحد بن زياد عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7115","34 - (  7111  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  حَدَّثَنَا  عَبَّادٌ ،  عَنْ  حَنْظَلَةَ السَّدُوسِيِّ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ الْحَارِثِ بْنِ نَوْفَلٍ قَالَ :  حَدَّثَتْنِي  مَيْمُونَةُ بِنْتُ الْحَارِثِ زَوْجُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُصَلِّي رَكْعَتَيْنِ قَبْلَ الْعَصْرِ  .","","Musnad Abi Ya'la al-Mawsili 7111","","ميمونة بنت الحارث زوج رسول الله عن عبد الله بن الحارث بن نوفل عن حنظلة بن عبد الله السدوسي عن عباد بن العوام الكلابي عن سعيد بن سليمان سعدويه عن زهير بن حرب عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7116","35 - (  7112  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  حَدَّثَنَا  سُلَيْمَانُ بْنُ كَثِيرٍ ،  حَدَّثَنَا  ابْنُ شِهَابٍ ،  عَنْ  عُبَيْدِ بْنِ السَّبَّاقِ ،  عَنِ  ابْنِ عَبَّاسٍ .         [13/29]      عَنْ  مَيْمُونَةَ بِنْتِ الْحَارِثِ ، قَالَتْ :  دَخَلَ عَلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمًا فَاتِرًا ، قَالَتْ : فَقُلْتُ : يَا رَسُولَ اللهِ ! مَا لِي أَرَاكَ فَاتِرًا ؟ قَالَ :  إِنَّ  جِبْرِيلَ  - عَلَيْهِ السَّلَامُ - وَعَدَنِي أَنْ يَأْتِيَنِي ، وَمَا أَخْلَفَنِي  قَالَتْ : فَمَكَثَ يَوْمَهُ ذَاكَ وَلَيْلَتَهُ .  قَالَتْ : فَاتَّهَمَ جَرْوَ كَلْبٍ كَانَتْ تَحْتَ  نَضَدٍ  لَهُمْ  لِلْحُسَيْنِ  ، فَأَمَرَ بِهِ فَأُخْرِجَ ، وَأَمَرَ بِمَاءٍ  فَنَضَحَ  مَكَانَهُ بِيَدِهِ .  قَالَ : فَخَرَجَ فَإِذَا هُوَ  بِجِبْرِيلَ  عَلَيْهِمَا السَّلَامُ قَالَ : إِنَّكَ وَعَدْتَنِي أَنْ تَأْتِيَنِي ، قَالَ  جِبْرِيلُ  - عَلَيْهِ السَّلَامُ - : إِنَّا لَا نَدْخُلُ بَيْتًا فِيهِ كَلْبٌ وَلَا صُورَةٌ ، وَأَمَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِقَتْلِ الْكِلَابِ حَتَّى إِنْ كَانَ لَيُكَلَّمُ فِي كَلْبِ الْحَائِطِ الصَّغِيرِ ، فَمَا يَأْذَنُ فِيهِ  .         [13/30]","","Musnad Abi Ya'la al-Mawsili 7112","","ميمونة بنت الحارث زوج رسول الله عن عبد الله بن عباس عن عبيد بن السباق  العبدري عن الزهري عن سليمان بن كثير الأصيد عن سعيد بن سليمان سعدويه عن زهير بن حرب عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7117","36 - (  7113  ) -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ قَالَ :  سَمِعْتُ  نَافِعًا  يُحَدِّثُ ، عَنْ  إِبْرَاهِيمَ بْنِ عَبْدِ اللهِ بْنِ مَعْبَدِ بْنِ عَبَّاسٍ ،         [13/31]      عَنْ  مَيْمُونَةَ أَنَّهَا سَمِعَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  صَلَاةٌ فِي مَسْجِدِي هَذَا أَفْضَلُ مِنْ أَلْفِ صَلَاةٍ  فِيمَا سِوَاهُ إِلَّا  الْمَسْجِدَ الْحَرَامَ  .","","Musnad Abi Ya'la al-Mawsili 7113","","ميمونة بنت الحارث زوج رسول الله عن إبراهيم بن عبد الله بن معبد بن عباس بن عبد المطلب عن نافع مولى ابن عمر عن ابن جريج عن أبو عاصم النبيل عن يعقوب بن إبراهيم بن كثير عن أبو يعلى الموصلي","حديث ميمونة زوج النبي - صلى الله عليه وسلم"
"7118","[13/32]             [13/33]      حَدِيثُ  صَفِيَّةَ بِنْتِ حُيَيِّ بْنِ أَخْطَبَ  زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَضِيَ اللهُ عَنْهَا  1 - (  7114  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  سُلَيْمَانُ يَعْنِي ابْنَ الْمُغِيرَةِ ،  حَدَّثَنَا  حُمَيْدٌ يَعْنِي ابْنَ هِلَالٍ  أَنَّ  صَفِيَّةَ ، قَالَتِ :  انْتَهَيْتُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَا مِنَ النَّاسِ أَحَدٌ أَكْرَهَ إِلَيَّ مِنْهُ ، فَقَالَ :  إِنَّ قَوْمَكِ صَنَعُوا كَذَا وَكَذَا  ، قَالَتْ : فَمَا قُمْتُ مِنْ مَقْعَدِي ، وَمَا مِنَ النَّاسِ أَحَدٌ أَحَبَّ إِلَيَّ مِنْهُ  .","","Musnad Abi Ya'la al-Mawsili 7114","","صفية بنت حيي زوج رسول الله عن حميد بن هلال العدوي عن سليمان بن المغيرة القيسي عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","حديث صفية بنت حيي بن أخطب زوج النبي صلى الله عليه وسلم"
"7119","2 - (  7115  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  حَدَّثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنْ  إِسْحَاقَ الْهَاشِمِيِّ .         [13/34]      حَدَّثَتْنَا  صَفِيَّةُ ، قَالَتْ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَرَّبْتُ إِلَيْهِ كَتِفًا بَارِدًا  ، فَكُنْتُ  أَسْحَاهَا  ، فَأَكَلَهَا ثُمَّ قَامَ فَصَلَّى  .","","Musnad Abi Ya'la al-Mawsili 7115","","صفية بنت حيي زوج رسول الله عن إسحاق بن عبد الله بن الحارث النوفلي عن داود بن أبي هند عن جعفر بن سليمان الضبعي عن سليمان بن داود العتكي عن أبو يعلى الموصلي","حديث صفية بنت حيي بن أخطب زوج النبي صلى الله عليه وسلم"
"7120","3 - (  7116  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  سَلَمَةَ ،  عَنْ  أَبِي إِدْرِيسَ ،  عَنِ  ابْنِ صَفْوَانَ ،  عَنْ  صَفِيَّةَ أُمِّ الْمُؤْمِنِينَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَا يَنْتَهِي النَّاسُ عَنْ غَزْوِ هَذَا  الْبَيْتِ  حَتَّى يَغْزُوَهُ جَيْشٌ  ، حَتَّى إِذَا كَانُوا  بِبَيْدَاءَ  مِنَ الْأَرْضِ ، خُسِفَ بِأَوَّلِهِمْ وَآخِرِهِمْ ، وَلَمْ يَنْجُ أَوْسَطُهُمْ "" . قَالَتْ : قُلْتُ : يَا رَسُولَ اللهِ ! أَرَأَيْتَ الْمُكْرَهَ مِنْهُمْ ؟ قَالَ : "" يَبْعَثُهُمُ اللهُ - عَزَّ وَجَلَّ - عَلَى مَا فِي أَنْفُسِهِمْ  .         [13/35]","","Musnad Abi Ya'la al-Mawsili 7116","","صفية بنت حيي زوج رسول الله عن مسلم بن صفوان عن أبو إدريس المرهبي عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","حديث صفية بنت حيي بن أخطب زوج النبي صلى الله عليه وسلم"
"7121","4 - (  7117  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  حَدَّثَنَا  أَبِي  قَالَ :  سَمِعْتُ  يَعْلَى بْنَ حَكِيمٍ  يُحَدِّثُ ، عَنْ  صُهَيْرَةَ بِنْتِ جَيْفَرَ ،  عَنْ  صَفِيَّةَ ، قَالَتْ :  حَرَّمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَبِيذَ  الْجَرِّ  .","","Musnad Abi Ya'la al-Mawsili 7117","","صفية بنت حيي زوج رسول الله عن صهيرة ويقال ضمرة بنت جيفر عن يعلى بن حكيم الثقفي عن جرير بن حازم عن وهب بن جرير بن حازم عن زهير بن حرب عن أبو يعلى الموصلي","حديث صفية بنت حيي بن أخطب زوج النبي صلى الله عليه وسلم"
"7122","5 - (  7118  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  حَدَّثَنَا  هَاشِمٌ الْكُوفِيُّ ،  حَدَّثَنَا  كِنَانَةُ قَالَ :  حَدَّثَتْنِي  صَفِيَّةُ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَعَلَ عِتْقَهَا مَهْرَهَا ،         [13/36]      وَأَنَّهُ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَخَلَ عَلَيْهَا ، وَبِيَدِهَا أَرْبَعَةُ آلَافِ نَوَاةٍ تُسَبِّحُ بِهَا ، فَقَالَ :  لَقَدْ سَبَّحْتُ مُنْذُ قُمْتُ عَلَيْكِ أَكْثَرَ مِمَّا سَبَّحْتِ  قَالَتْ : قُلْتُ : عَلِّمْنِي يَا رَسُولَ اللهِ ؟ قَالَ : "" قُولِي : سُبْحَانَ اللهِ عَدَدَ مَا خَلَقَ  .","","Musnad Abi Ya'la al-Mawsili 7118","","صفية بنت حيي زوج رسول الله عن كنانة مولى صفية بنت حيي عن هاشم بن سعيد الكوفي عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","حديث صفية بنت حيي بن أخطب زوج النبي صلى الله عليه وسلم"
"7123","6 - (  7119  ) -  حَدَّثَنَا  أَبُو هِشَامٍ مُحَمَّدُ بْنُ يَزِيدَ بْنِ رِفَاعَةَ ،         [13/37]      حَدَّثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ إِسْمَاعِيلَ بْنِ مُجَمِّعٍ قَالَ :  حَدَّثَنِي  عُثْمَانُ بْنُ كَعْبٍ ،  عَنْ  رَجُلٍ يُقَالُ لَهُ : رَبِيعٌ ،  عَنْ  صَفِيَّةَ بِنْتِ حُيَيٍّ ، قَالَتْ :  أَرْدَفَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى عَجُزِ نَاقَتِهِ لَيْلًا ، قَالَتْ : فَجَعَلْتُ أَنْعَسُ ، فَيَمَسُّنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِيَدِهِ ، وَيَقُولُ :  يَا هَذِهِ ، يَا  بِنْتَ حُيَيٍّ  وَجَعَلَ يَقُولُ : "" يَا  صَفِيَّةُ  ، إِنِّي أَعْتَذِرُ إِلَيْكِ مِمَّا صَنَعْتُ بِقَوْمِكِ . إِنَّهُمْ قَالُوا لِي كَذَا ، إِنَّهُمْ قَالُوا لِي كَذَا  .         [13/38]","","Musnad Abi Ya'la al-Mawsili 7119","","صفية بنت حيي زوج رسول الله عن ربيع عن عثمان بن كعب القرظي عن إبراهيم بن إسماعيل بن مجمع عن يونس بن بكير عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","حديث صفية بنت حيي بن أخطب زوج النبي صلى الله عليه وسلم"
"7124","7 - (  7120  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  أَخْبَرَنَا  إِبْرَاهِيمُ بْنُ إِسْمَاعِيلَ ، قَالَ :  حَدَّثَنِي  عُثْمَانُ بْنُ كَعْبٍ قَالَ :  حَدَّثَنِي  رَبِيعٌ رَجُلٌ مِنْ بَنِي النَّضِيرِ وَكَانَ فِي حِجْرِ  صَفِيَّةَ  ،  عَنْ  صَفِيَّةَ بِنْتِ حُيَيٍّ ، قَالَتْ :  مَا رَأَيْتُ قَطُّ أَحْسَنَ  خُلُقًا  مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَقَدْ رَأَيْتُهُ رَكِبَ بِي مِنْ  خَيْبَرَ  عَلَى عَجُزِ نَاقَتِهِ لَيْلًا ، فَجَعَلْتُ أَنْعَسُ فَيَضْرِبُ رَأْسِي مُؤْخِرَةَ  الرَّحْلِ  ، فَيَمَسُّنِي بِيَدِهِ ، وَيَقُولُ :  يَا هَذِهِ ، مَهْلًا يَا  بِنْتَ حُيَيٍّ  حَتَّى إِذَا جَاءَ  الصَّهْبَاءَ  قَالَ : "" أَمَا إِنِّي أَعْتَذِرُ إِلَيْكِ يَا  صَفِيَّةُ  مِمَّا صَنَعْتُ بِقَوْمِكِ ، إِنَّهُمْ قَالُوا لِي كَذَا وَكَذَا  .","","Musnad Abi Ya'la al-Mawsili 7120","","صفية بنت حيي زوج رسول الله عن ربيع رجل من بني النضير عن عثمان بن كعب القرظي عن إبراهيم بن إسماعيل بن مجمع عن يونس بن بكير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","حديث صفية بنت حيي بن أخطب زوج النبي صلى الله عليه وسلم"
"7125","8 - (  7121  ) -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَخْبَرَنَا  خَالِدٌ ،  عَنْ         [13/39]      عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَلِيِّ بْنِ حُسَيْنٍ قَالَ :  حَدَّثَتْنِي  صَفِيَّةُ بِنْتُ حُيَيٍّ زَوْجُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ :  جِئْتُ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَتَحَدَّثْتُ عِنْدَهُ وَهُوَ عَاكِفٌ فِي الْمَسْجِدِ ، فَقَامَ مَعِي لَيْلَةً مِنَ اللَّيَالِي يُبَلِّغُنِي بَيْتِي ، فَلَقِيَهُ رَجُلَانِ مِنَ  الْأَنْصَارِ  ، فَلَمَّا رَأَيَاهُ اسْتَحْيَا فَرَجَعَا ، فَقَالَ :  تَعَالَيَا ، فَإِنَّهَا  صَفِيَّةُ  زَوْجُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - . فَقَالَا : نَعُوذُ بِاللهِ ! سُبْحَانَ اللهِ ! قَالَ : "" مَا أَقُولُ لَكُمَا هَذَا أَنْ تَكُونَا تَظُنَّا سُوءًا ، وَلَكِنِّي قَدْ عَلِمْتُ أَنَّ  الشَّيْطَانَ  يَجْرِي مِنَ ابْنِ آدَمَ مَجْرَى الدَّمِ  .","","Musnad Abi Ya'la al-Mawsili 7121","","صفية بنت حيي زوج رسول الله عن علي بن الحسين زين العابدين عن الزهري عن عبد الرحمن بن إسحاق العامري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","حديث صفية بنت حيي بن أخطب زوج النبي صلى الله عليه وسلم"
"7126","[13/40]             [13/41]             [13/42]      حَدِيثُ  أُمِّ حَبِيبَةَ بِنْتِ أَبِي سُفْيَانَ  أُمِّ الْمُؤْمِنِينَ  1 - (  7122  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ زُهَيْرُ بْنُ حَرْبٍ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  حَدَّثَنَا  عَمْرٌو ،  عَنْ  سَالِمِ بْنِ شَوَّالٍ ،  عَنْ  أُمِّ حَبِيبَةَ قَالَتْ :  كُنَّا نَفْعَلُهُ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَعْنِي نُصَلِّي الصُّبْحَ  بِمِنًى  يَوْمَ النَّحْرِ  .         [13/43]","","Musnad Abi Ya'la al-Mawsili 7122","","رملة بنت أبي سفيان زوج رسول الله عن سالم بن شوال المكي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7127","2 - (  7123  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  يَحْيَى ،  عَنْ  حُمَيْدِ بْنِ نَافِعٍ ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّهَا أُمِّ سَلَمَةَ  ، وَأَمِّ حَبِيبَةَ زَوْجَيِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتَا :  جَاءَتِ  امْرَأَةٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ : يَا نَبِيَّ اللهِ ، إِنَّ ابْنَتِي تُوُفِّيَ زَوْجُهَا ، وَإِنَّهَا تَعْتَدُّ ، وَإِنِّي أَخَافُ عَلَى عَيْنِهَا ، أَفَأَكْحُلُهَا ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قَدْ كَانَتِ الْمَرْأَةُ مِنْكُنَّ تَرْمِي بِالْبَعْرَةِ عَلَى رَأْسِ الْحَوْلِ  ، وَإِنَّمَا هِيَ أَرْبَعَةُ أَشْهُرٍ وَعَشْرٌ  "" .","","Musnad Abi Ya'la al-Mawsili 7123","","رملة بنت أبي سفيان زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن حميد بن نافع حميد صفيرا عن يحيى بن سعيد الأنصاري عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7128","3 - (  7124  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  أَخْبَرَنَا  النُّعْمَانُ بْنُ سَالِمٍ ،  عَنْ  عَمْرِو بْنِ أَوْسٍ قَالَ : قَالَ لِي عَنْبَسَةُ بْنُ أَبِي سُفْيَانَ : أَلَا أُحَدِّثُكَ حَدِيثًا         [13/44]      حَدَّثَتْنَاهُ  أُمُّ حَبِيبَةَ بِنْتُ أَبِي سُفْيَانَ ؟ قَالَ : بَلَى . قَالَ : وَمَا رُئِّيتُهُ ؟ قَالَ : وَمَا ذَاكَ إِلَّا كَبِشَارَةٍ إِلَيْكَ . قَالَ : حَدَّثَتْنَا أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ صَلَّى فِي يَوْمٍ ثِنْتَيْ عَشْرَةَ سَجْدَةً تَطَوُّعًا  بُنِيَ لَهُ بِهِنَّ بَيْتٌ فِي الْجَنَّةِ  .  فَقَالَتْ  أُمُّ حَبِيبَةَ  :  فَمَا تَرَكْتُهُنَّ مُنْذُ سَمِعْتُهُنَّ  .  قَالَ  النُّعْمَانُ  :  مَا تَرَكْتُهُنَّ مُنْذُ سَمِعْتُهُنَّ مِنْ  عَمْرٍو  .  قَالَ  دَاوُدُ  : أَمَّا نَحْنُ فَقَدْ نُصَلِّي وَنَتْرُكُ  .         [13/45]","","Musnad Abi Ya'la al-Mawsili 7124","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن عمرو بن أوس بن أبي أوس الثقفي عن النعمان بن سالم الطائفي عن داود بن أبي هند عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7129","4 - (  7125  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  حَدَّثَنَا  عُبَيْدُ اللهِ ، قَالَ :  أَخْبَرَنِي  نَافِعٌ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِي الْجَرَّاحِ ،         [13/46]      عَنْ  أُمِّ حَبِيبَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا تَصْحَبُ الْمَلَائِكَةُ رُفْقَةً فِيهَا  جَرَسٌ  .         [13/47]","","Musnad Abi Ya'la al-Mawsili 7125","","رملة بنت أبي سفيان زوج رسول الله عن أبو الجراح مولى أم حبيبة زوج رسول الله عن سالم بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7130","5 - (  7126  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  هَاشِمُ بْنُ الْقَاسِمِ ،  حَدَّثَنَا  لَيْثٌ قَالَ :  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي حَبِيبٍ ،  عَنْ  سُوَيْدِ بْنِ قَيْسٍ ،  عَنْ  مُعَاوِيَةَ بْنِ حُدَيْجٍ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ  أَنَّهُ  سَأَلَ  أُخْتَهُ أُمَّ حَبِيبَةَ زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  هَلْ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي فِي الثَّوْبِ الَّذِي يُجَامِعُهَا فِيهِ ؟ قَالَتْ : نَعَمْ ، إِذَا لَمْ يَرَ فِيهِ أَذًى  .         [13/48]","","Musnad Abi Ya'la al-Mawsili 7126","","رملة بنت أبي سفيان زوج رسول الله عن معاوية بن أبي سفيان عن معاوية بن حديج السكوني عن سويد بن قيس التجيبي عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن هاشم بن القاسم بن مسلم عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7131","6 - (  7127  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنِي  أَبِي  ،  عَنِ  ابْنِ إِسْحَاقَ قَالَ :  حَدَّثَنِي  مُحَمَّدُ بْنُ طَلْحَةَ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِي الْجَرَّاحِ مَوْلَى أُمِّ حَبِيبَةَ ،  عَنْ  أُمِّ حَبِيبَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  لَوْلَا أَنْ  أَشُقَّ  عَلَى أُمَّتِي لَأَمَرْتُهُمْ بِالسِّوَاكِ عِنْدَ كُلِّ صَلَاةٍ  كَمَا يَتَوَضَّؤُونَ  .         [13/49]","","Musnad Abi Ya'la al-Mawsili 7127","","رملة بنت أبي سفيان زوج رسول الله عن أبو الجراح مولى أم حبيبة زوج رسول الله عن سالم بن عبد الله بن عمر بن الخطاب عن محمد بن طلحة بن يزيد بن ركانة الحجازي عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7132","7 - (  7128  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  ابْنُ أَخِي ابْنِ شِهَابٍ ،  عَنْ  عَمِّهِ قَالَ :  أَخْبَرَنِي  عُرْوَةُ بْنُ الزُّبَيْرِ أَنَّ زَيْنَبَ بِنْتَ أُمِّ سَلَمَةَ  أَخْبَرَتْهُ  أَنَّ أُمَّ حَبِيبَةَ زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَخْبَرَتْهَا  ، قَالَتْ :  يَا رَسُولَ اللهِ ! انْكِحْ أُخْتِي  بِنْتَ أَبِي سُفْيَانَ  ، فَزَعَمَتْ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ لَهَا :  وَتُحِبِّينَ ذَلِكَ  ؟ قَالَتْ : نَعَمْ ، يَا رَسُولَ اللهِ ! لَسْتُ لَكَ  بِمُخْلِيَةٍ ،  وَأَحَبُّ مَنْ شَرِكَنِي فِي خَيْرٍ أُخْتِي ، قَالَتْ : فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" إِنَّ ذَلِكَ لَا يَحِلُّ لِي "" قَالَتْ : فَقُلْتُ : يَا رَسُولَ اللهِ ! فَوَاللهِ إِنَّا لَنَتَحَدَّثُ أَنَّكَ تُرِيدُ أَنْ تَنْكِحَ  دُرَّةَ بِنْتَ أَبِي سَلَمَةَ  ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  ابْنَةُ أُمِّ سَلَمَةَ ؟  "" قَالَتْ : نَعَمْ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" وَايْمُ اللهِ ، لَوْ أَنَّهَا لَمْ تَكُنْ رَبِيبَتِي فِي  حَجْرِي  مَا حَلَّتْ لِي ، إِنَّهَا لَابْنَةُ أَخِي مِنَ الرَّضَاعَةِ ، أَرْضَعَتْنِي  وَأَبَا سَلَمَةَ ثُوَيْبَةُ  ، فَلَا تَعْرِضْنَ عَلَيَّ بَنَاتِكُنَّ ، وَلَا أَخَوَاتِكُنَّ  .         [13/50]","","Musnad Abi Ya'la al-Mawsili 7128","","رملة بنت أبي سفيان زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7133","8 - (  7129  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  ابْنِ إِسْحَاقَ قَالَ :  حَدَّثَنِي  أَبُو جَعْفَرٍ مُحَمَّدُ بْنُ عَلِيٍّ ، وَنَافِعٌ أَنَّ عَمْرَو بْنَ نَافِعٍ مَوْلَى عُمَرَ بْنِ الْخَطَّابِ  حَدَّثَهُمَا  أَنَّهُ كَانَ يَكْتُبُ الْمَصَاحِفَ فِي عَهْدِ أَزْوَاجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - قَالَ : "" فَاسْتَكْتَبَتْنِي حَفْصَةُ مُصْحَفًا ،  وَقَالَتْ لِي  : إِذَا بَلَغْتَ هَذِهِ الْآيَةَ مِنْ سُورَةِ الْبَقَرَةِ ، فَلَا تَكْتُبْهَا حَتَّى تَأْتِيَنِي بِهَا ، فَأُمْلِيَهَا عَلَيْكَ كَمَا حَفِظْتُهَا مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : فَلَمَّا بَلَغْتُهَا جِئْتُهَا بِالْوَرَقَةِ الَّتِي أَكْتُبُهَا ، فَقَالَتِ : اكْتُبْ : ( حَافَظُوا عَلَى الصَّلَوَاتِ وَالصَّلَاةِ الْوُسْطَى وَصَلَاةِ الْعَصْرِ وَقُومُوا لِلهِ قَانِتِينَ )  .         [13/51]             [13/52]","","Musnad Abi Ya'la al-Mawsili 7129","","حفصة بنت عمر بن الخطاب عن عمر بن نافع مولى ابن عمر عن أبو جعفر الباقر عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7134","9 - (  7130  ) -  حَدَّثَنَا  زُهَيْرُ بْنُ حَرْبٍ ،  حَدَّثَنَا  يَزِيدُ بْنُ         [13/53]      هَارُونَ ،  أَخْبَرَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الشُّعَيْثِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَنْ صَلَّى أَرْبَعًا قَبْلَ الظُّهْرِ  ، وَأَرْبَعًا بَعْدَهَا ، حَرَّمَهُ اللهُ عَلَى النَّارِ  .         [13/54]             [13/55]","","Musnad Abi Ya'la al-Mawsili 7130","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن عبد الله بن المهاجر الشعيثي عن محمد بن عبد الله بن المهاجر الشعيثي عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7135","10 - (  7131  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي حَصِينٍ ،  عَنْ  يَحْيَى بْنِ وَثَّابٍ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  أُمِّ حَبِيبَةَ ، زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُصَلِّي عَلَى  الْخُمْرَةِ  .         [13/56]","","Musnad Abi Ya'la al-Mawsili 7131","","رملة بنت أبي سفيان زوج رسول الله عن عبد الله بن حبيب السلمي عن يحيى بن وثاب الأصبهاني عن عثمان بن عاصم بن حصين عن شعبة بن الحجاج عن وهب بن جرير بن حازم عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7136","11 - (  7132  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ يَزِيدَ بْنِ خُنَيْسٍ قَالَ : دَخَلْنَا عَلَى  سُفْيَانَ الثَّوْرِيِّ  نَعُودُهُ مِنْ مَرَضٍ كَانَ بِهِ ، فَدَخَلَ عَلَيْنَا سَعِيدُ بْنُ حَسَّانَ الْمَخْزُومِيُّ ، فَقَالَ لَهُ  سُفْيَانُ  : الَّذِي  حَدَّثْتَنِي عَنْ  أُمِّ صَالِحٍ ، ارْدُدْهُ عَلَيَّ . قَالَ :  فَقَالَ  سَعِيدٌ  : نَعَمْ ،  حَدَّثَتْنِي  أُمُّ صَالِحٍ ،  عَنْ  صَفِيَّةَ بِنْتِ شَيْبَةَ ،  عَنْ  أُمِّ حَبِيبَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  كَلَامُ ابْنِ آدَمَ كُلُّهُ عَلَيْهِ لَا لَهُ إِلَّا أَمْرٌ بِمَعْرُوفٍ  ، أَوْ نَهْيٌ عَنْ مُنْكَرٍ ، أَوْ ذِكْرُ اللهِ - عَزَّ وَجَلَّ  - .         [13/57]","","Musnad Abi Ya'la al-Mawsili 7132","","رملة بنت أبي سفيان زوج رسول الله عن صفية بنت شيبة الحجبية عن أم صالح بنت صالح عن سعيد بن عبد الرحمن بن حسان المخزومي عن محمد بن يزيد المخزومي عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7137","12 - (  7133  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  جُوَيْرِيَةُ ،  عَنْ  نَافِعٍ أَنَّ سَالِمَ بْنَ عَبْدِ اللهِ بْنِ عُمَرَ  حَدَّثَهُ  أَنَّ الْجَرَّاحَ مَوْلَى أُمِّ حَبِيبَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  حَدَّثَ  عَبْدَ اللهِ بْنَ عُمَرَ أَنَّ أُمَّ حَبِيبَةَ  حَدَّثَتْهُ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ         [13/58]      الْعِيرَ  الَّتِي فِيهَا  الْجَرَسُ  لَا تَصْحَبُهَا الْمَلَائِكَةُ  .","","Musnad Abi Ya'la al-Mawsili 7133","","رملة بنت أبي سفيان زوج رسول الله عن عبد الله بن عمر بن الخطاب عن أبو الجراح مولى أم حبيبة زوج رسول الله عن سالم بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7138","13 - (  7134  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ يَزِيدَ بْنِ خُنَيْسٍ الْمَكِّيُّ ،  حَدَّثَنَا  سَعِيدُ بْنُ حَسَّانَ قَالَ :  حَدَّثَتْنِي  أُمُّ صَالِحٍ ،  عَنْ  صَفِيَّةَ بِنْتِ شَيْبَةَ ،  عَنْ  أُمِّ حَبِيبَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  كُلُّ كَلَامِ ابْنِ آدَمَ عَلَيْهِ لَا لَهُ  ، إِلَّا أَمْرٌ بِمَعْرُوفٍ ، أَوْ نَهْيٌ عَنْ مُنْكَرٍ ، أَوْ ذِكْرُ اللهِ  .","","Musnad Abi Ya'la al-Mawsili 7134","","رملة بنت أبي سفيان زوج رسول الله عن صفية بنت شيبة الحجبية عن أم صالح بنت صالح عن سعيد بن حسان المخزومي عن محمد بن يزيد المخزومي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7139","14 - (  7135  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  جَرِيرٌ ،  حَدَّثَنَا  عَبْدُ الْمَلِكِ بْنُ عُمَيْرٍ ،  عَنْ  سَالِمِ بْنِ مُنْقِذٍ ،  عَنْ  عَمْرِو بْنِ أَوْسٍ الثَّقَفِيِّ قَالَ :  دَخَلْتُ عَلَى  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ وَهُوَ يَنْزِعُ ،  فَقَالَ  : مَا أُحِبُّ أَنَّكَ ، وَذَاكَ أَنِّي مُحَدِّثُكَ حَدِيثًا  حَدَّثَتْنِيهِ  أُمُّ حَبِيبَةَ بِنْتُ أَبِي سُفْيَانَ ، حَدَّثَتْنِي أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ صَلَّى ثِنْتَيْ عَشْرَةَ رَكْعَةً مَعَ صَلَاةِ النَّهَارِ  ، بَنَى اللهُ - عَزَّ         [13/59]      وَجَلَّ - لَهُ بَيْتًا فِي الْجَنَّةِ  .","","Musnad Abi Ya'la al-Mawsili 7135","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن عمرو بن أوس بن أبي أوس الثقفي عن سالم بن منقذ عن عبد الملك بن عمير القبطي عن جرير بن حازم عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7140","15 - (  7136  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  هَمَّامٌ ،  حَدَّثَنَا  نَافِعٌ ،  عَنْ  سَالِمٍ ،  عَنِ  الْجَرَّاحِ مَوْلَى أُمِّ حَبِيبَةَ ،  عَنْ  أُمِّ حَبِيبَةَ أَنَّهَا قَالَتْ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  رُفْقَةٌ فِيهَا  جَرَسٌ  لَا تَصْحَبُهَا الْمَلَائِكَةُ  .","","Musnad Abi Ya'la al-Mawsili 7136","","رملة بنت أبي سفيان زوج رسول الله عن أبو الجراح مولى أم حبيبة زوج رسول الله عن سالم بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن همام بن يحيى بن دينار عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7141","16 - (  7137  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  يَحْيَى بْنُ سُلَيْمٍ قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ سَعِيدٍ الْمُؤَذِّنَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَنْبَسَةَ ، يَقُولُ :  سَمِعْتُ  أُمَّ حَبِيبَةَ بِنْتَ أَبِي سُفْيَانَ تَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَنْ حَافَظَ عَلَى أَرْبَعِ رَكَعَاتٍ قَبْلَ الْعَصْرِ بَنَى اللهُ - عَزَّ وَجَلَّ - لَهُ بَيْتًا فِي الْجَنَّةِ  .         [13/60]","","Musnad Abi Ya'la al-Mawsili 7137","","رملة بنت أبي سفيان زوج رسول الله عن عبد الله بن عنبسة عن محمد بن سعيد الطائفي عن يحيى بن سليم الطائفي عن هارون بن معروف المروزي عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7142","17 - (  7138  ) -  حَدَّثَنَا  أَبُو نَصْرٍ عَبْدُ الْمَلِكِ بْنُ عَبْدِ الْعَزِيزِ الْقُشَيْرِيُّ التَّمَّارُ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي صَالِحٍ ،         [13/61]      عَنْ  أُمِّ حَبِيبَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَنْ صَلَّى فِي يَوْمٍ ثِنْتَيْ عَشْرَةَ رَكْعَةً بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  .","","Musnad Abi Ya'la al-Mawsili 7138","","رملة بنت أبي سفيان زوج رسول الله عن ذكوان السمان عن عاصم بن بهدلة عن حماد بن سلمة عن عبد الملك بن عبد العزيز القشيري عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7143","18 - (  7139  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الشُّعَيْثِيُّ أَبُو عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُخْتِهِ أُمِّ حَبِيبَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ : ""  مَنْ صَلَّى أَرْبَعَ رَكَعَاتٍ قَبْلَ الظُّهْرِ وَأَرْبَعًا بَعْدَهَا  ، حَرَّمَهُ اللهُ - عَزَّ وَجَلَّ - عَلَى النَّارِ  ""  .","","Musnad Abi Ya'la al-Mawsili 7139","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن عبد الله بن المهاجر الشعيثي عن محمد بن عبد الله بن المهاجر الشعيثي عن عبد الله بن يزيد القصير عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7144","19 - (  7140  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ قَالَ :  أَخْبَرَنِي  عَطَاءٌ الْخُرَاسَانِيُّ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ  قَالَ  :  دَخَلْتُ عَلَى أُمِّ حَبِيبَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَأَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَائِمًا يُصَلِّي فِي ثَوْبٍ وَاحِدٍ  قَدْ خَالَفَ بَيْنَ طَرَفَيْهِ ، فَقُلْتُ : يَا  أُمَّ حَبِيبَةَ  ، أَيُصَلِّي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي ثَوْبٍ وَاحِدٍ ؟ فَقَالَتْ : نَعَمْ ، وَهُوَ الثَّوْبُ الَّذِي كَانَ فِيهِ مَا كَانَ ، تَعْنِي : الْجِمَاعَ  .         [13/62]             [13/63]","","Musnad Abi Ya'la al-Mawsili 7140","","رملة بنت أبي سفيان زوج رسول الله عن معاوية بن أبي سفيان عن عطاء الخراساني عن إسماعيل بن عياش الأحول عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7145","20 - (  7141  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  أَبِي الْمَلِيحِ بْنِ أُسَامَةَ ،  عَنْ  أُمِّ حَبِيبَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّهُ كَانَ إِذَا سَمِعَ الْمُؤَذِّنَ قَالَ كَمَا يَقُولُ الْمُؤَذِّنُ حَتَّى يَسْكُتَ  .","","Musnad Abi Ya'la al-Mawsili 7141","","رملة بنت أبي سفيان زوج رسول الله عن أبو المليح بن أسامة الهذلي عن جعفر بن إياس اليشكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7146","21 - (  7142  ) -  حَدَّثَنَا  بُنْدَارٌ قَالَ :  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ ، وَبَهْزٌ ،  عَنْ  شُعْبَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  أُمِّ حَبِيبَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّهُ قَالَ كَمَا يَقُولُ الْمُؤَذِّنُ حَتَّى يَسْكُتَ  .         [13/64]","","Musnad Abi Ya'la al-Mawsili 7142","","رملة بنت أبي سفيان زوج رسول الله عن عبد الله بن عتبة بن أبي سفيان الأموي عن أبو المليح بن أسامة الهذلي عن جعفر بن إياس اليشكري عن شعبة بن الحجاج عن بهز بن أسد عن محمد بن بشار بندار عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7147","22 - (  7143  ) -  حَدَّثَنَا  رَوْحُ بْنُ عَبْدِ الْمُؤْمِنِ الْمُقْرِئُ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدِ بْنِ إِبْرَاهِيمَ الْعَوْفِيُّ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ طَلْحَةَ بْنِ يَزِيدَ بْنِ رُكَانَةَ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِي الْجَرَّاحِ مَوْلَى أُمِّ حَبِيبَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّ أُمَّ حَبِيبَةَ بِنْتَ أَبِي سُفْيَانَ  حَدَّثَتْهُ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَوْلَا أَنْ  أَشُقَّ  عَلَى أُمَّتِي ، لَأَمَرْتُهُمْ بِالسِّوَاكِ  عِنْدَ كُلِّ صَلَاةٍ كَمَا يَتَوَضَّؤُونَ  .         [13/65]","","Musnad Abi Ya'la al-Mawsili 7143","","رملة بنت أبي سفيان زوج رسول الله عن أبو الجراح مولى أم حبيبة زوج رسول الله عن سالم بن عبد الله بن عمر بن الخطاب عن محمد بن طلحة بن يزيد بن ركانة الحجازي عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن روح بن عبد المؤمن عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7148","23 - (  7144  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ زَنْجُوَيْهِ ،  حَدَّثَنَا  أَبُو مُسْهِرٍ قَالَ :  حَدَّثَنِي  هَيْثَمُ بْنُ حُمَيْدٍ ،  حَدَّثَنَا  الْعَلَاءُ ،  عَنْ  مَكْحُولٍ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهَا سَمِعَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  مَنْ مَسَّ فَرْجَهُ فَلْيَتَوَضَّأْ  قَالَ الْعَلَاءُ :  قَالَ  مَكْحُولٌ :  مَنْ مَسَّهُ مُتَعَمِّدًا  .         [13/66]","","Musnad Abi Ya'la al-Mawsili 7144","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن مكحول بن أبي مسلم عن العلاء بن الحارث الرمادي عن الهيثم بن حميد الغساني عن عبد الأعلى بن مسهر الغساني عن محمد بن عبد الملك بن زنجويه الغزال عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7149","24 - (  7145  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  حَدَّثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي سُفْيَانَ بْنِ سَعِيدٍ ،  عَنْ  أُمِّ حَبِيبَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَوَضَّأَ مِمَّا مَسَّتِ النَّارُ  .         [13/67]","","Musnad Abi Ya'la al-Mawsili 7145","","رملة بنت أبي سفيان زوج رسول الله عن أبو سفيان بن سعيد بن المغيرة الثقفي عن أبو سلمة بن عبد الرحمن عن الزهري عن محمد بن عبد الرحمن بن المغيرة عن أبو عامر العقدي عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7150","25 - (  7146  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  أَبِي مَلِيحٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  عَمَّتِهِ أُمِّ حَبِيبَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا سَمِعَ الْمُؤَذِّنَ قَالَ كَمَا يَقُولُ حَتَّى يَسْكُتَ  .         [13/68]","","Musnad Abi Ya'la al-Mawsili 7146","","رملة بنت أبي سفيان زوج رسول الله عن عبد الله بن عتبة بن أبي سفيان الأموي عن أبو المليح بن أسامة الهذلي عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7151","26 - (  7147  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  الْحَسَنُ بْنُ مُوسَى ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنَا  دَرَّاجٌ ، عَنْ عُمَرَ بْنِ الْحَكَمِ أَنَّهُ  حَدَّثَهُ  ،  عَنْ  أُمِّ حَبِيبَةَ بِنْتِ أَبِي سُفْيَانَ  أَنَّ نَاسًا مِنَ  الْيَمَنِ  قَدِمُوا عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَعْلَمَهُمُ الصَّلَاةَ وَالسُّنَنَ وَالْفَرَائِضَ ، قَالُوا : يَا رَسُولَ اللهِ ! إِنَّ لَنَا شَرَابًا نَصْنَعُهُ مِنَ  الْقَمْحِ  وَالشَّعِيرِ ؟ قَالَ :  الْغُبَيْرَاءُ  ؟ قَالُوا : نَعَمْ . قَالَ : لَا تَطْعَمُوهُ  ، ثُمَّ لَمَّا كَانَ بَعْدَ ذَلِكَ بِيَوْمَيْنِ ذَكَرُوهَا لَهُ أَيْضًا . قَالَ :  الْغُبَيْرَاءُ  ؟ قَالُوا : نَعَمْ . قَالَ : فَلَا تَطْعَمُوهُ ، ثُمَّ لَمَّا أَرَادُوا أَنْ يَنْطَلِقُوا سَأَلُوهُ عَنْهُ ، فَقَالَ :  الْغُبَيْرَاءُ  ؟ قَالُوا : نَعَمْ . قَالَ : فَلَا تَطْعَمُوهُ ، قَالُوا : فَإِنَّهُمْ لَا يَدَعُونَهَا قَالَ : مَنْ لَمْ يَتْرُكْهَا فَاضْرِبُوا عُنُقَهُ  .","","Musnad Abi Ya'la al-Mawsili 7147","","رملة بنت أبي سفيان زوج رسول الله عن عمر بن الحكم بن رافع الأوسي عن دراج أبي السمح عن عبد الله بن لهيعة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم حبيبة بنت أبي سفيان أم المؤمنين"
"7152","[13/69]      حَدِيثُ  أُمِّ عُمَارَةَ بِنْتِ كَعْبٍ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  1 - (  7148  ) -  حَدَّثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  أَخْبَرَنَا  شُعْبَةُ ،  عَنْ  حَبِيبِ بْنِ زَيْدٍ الْأَنْصَارِيِّ قَالَ :  سَمِعْتُ  مَوْلَاةً لَنَا يُقَالُ لَهَا : لَيْلَى  تُحَدِّثُ عَنْ  أُمِّ عُمَارَةَ بِنْتِ كَعْبٍ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَخَلَ عَلَيْهَا ، فَدَعَتْ لَهُ بِطَعَامٍ قَالَ :  تَعَالَيْ ، فَكُلِي ، فَقَالَتْ : إِنِّي صَائِمَةٌ ، فَقَالَ : "" إِنَّ الصَّائِمَ إِذَا أُكِلَ عِنْدَهُ ،  صَلَّتْ  عَلَيْهِ الْمَلَائِكَةُ  .","","Musnad Abi Ya'la al-Mawsili 7148","","نسيبة بنت كعب الأنصارية عن ليلى مولاة أم عمارة الأنصارية عن حبيب بن زيد بن خلاد الأنصاري عن شعبة بن الحجاج عن علي بن الجعد عن أبو يعلى الموصلي","حديث أم عمارة بنت كعب عن النبي صلى الله عليه وسلم"
"7153","[13/70]             [13/71]      حَدِيثُ  أُمِّ هِشَامٍ بِنْتِ حَارِثَةَ بْنِ النُّعْمَانِ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  1 - (  7149  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرٍ ،  عَنْ  يَحْيَى بْنِ عَبْدِ اللهِ ،  عَنْ  أُمِّ هِشَامٍ بِنْتِ حَارِثَةَ بْنِ النُّعْمَانِ ، قَالَتْ :  قَرَأْتُ         {      ق وَالْقُرْآنِ الْمَجِيدِ         }      مِنْ فِي رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَكَانَ يَقْرَؤُهَا كُلَّ جُمُعَةٍ إِذَا خَطَبَ النَّاسَ  .         [13/72]","","Musnad Abi Ya'la al-Mawsili 7149","","أم هشام بنت حارثة امرأة عمارة بن الحبحاب عن يحيى بن عبد الله بن عبد الرحمن بن سعد الأنصاري عن عبد الله بن أبي بكر بن محمد  ابن حزم عن محمد بن إسحاق عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم هشام بنت حارثة بن النعمان عن النبي صلى الله عليه وسلم"
"7154","2 - (  7150  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  شَبَابَةُ بْنُ سَوَّارٍ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  خُبَيْبِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ مَعْنٍ ،  عَنِ  ابْنَةِ حَارِثَةَ بْنِ النُّعْمَانِ ، قَالَتْ :  كَانَ  تَنُّورُنَا  وَتَنُّورُ  رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَاحِدًا  ، قَالَتْ : فَحَفِظْتُ         {      ق         }      مِنْ فِي رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَ الْجُمُعَةِ  .","","Musnad Abi Ya'la al-Mawsili 7150","","أم هشام بنت حارثة امرأة عمارة بن الحبحاب عن عبد الله بن محمد بن معن الغفاري عن خبيب بن عبد الرحمن الخزرجي عن شعبة بن الحجاج عن شبابة بن سوار المدائني عن زهير بن حرب عن أبو يعلى الموصلي","حديث أم هشام بنت حارثة بن النعمان عن النبي صلى الله عليه وسلم"
"7155","[13/73]      حَدِيثُ  ضُبَاعَةَ بِنْتِ الزُّبَيْرِ بْنِ عَبْدِ الْمُطَّلِبِ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  1 - (  7151  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  هَمَّامٌ ،  حَدَّثَنَا  قَتَادَةُ ،  عَنْ  إِسْحَاقَ بْنِ عَبْدِ اللهِ بْنِ الْحَارِثِ أَنَّ جَدَّتَهُ أُمَّ الْحَكَمِ  حَدَّثَتْهُ  ،  عَنْ  أُخْتِهَا ضُبَاعَةَ بِنْتِ الزُّبَيْرِ  أَنَّهَا رَفَعَتْ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَحْمًا فَانْتَهَسَ مِنْهُ ثُمَّ صَلَّى وَلَمْ يَتَوَضَّأْ  .","","Musnad Abi Ya'la al-Mawsili 7151","","ضباعة بنت الزبير الهاشمية عن صفية الهاشمية بنت عم رسول الله عن إسحاق بن عبد الله بن الحارث النوفلي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن هدبة بن خالد عن أبو يعلى الموصلي","حديث ضباعة بنت الزبير عن النبي صلى الله عليه وسلم"
"7156","[13/74]             [13/75]      حَدِيثُ  أُخْتِ عَبْدِ اللهِ بْنِ رَوَاحَةَ ،  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  1 - (  7152  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  حَدَّثَنَا  يَحْيَى ،  عَنْ  شُعْبَةَ قَالَ :  حَدَّثَنِي  مُحَمَّدُ بْنُ النُّعْمَانِ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنِ  امْرَأَةٍ مِنْ عَبْدِ الْقَيْسِ ،  عَنْ  أُخْتِ عَبْدِ اللهِ بْنِ رَوَاحَةَ ، قَالَتْ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  وَجَبَ الْخُرُوجُ عَلَى كُلِّ ذَاتِ نِطَاقٍ  يَعْنِي : فِي الْعِيدَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 7152","","عمرة بنت رواحة الأنصارية عن امرأة من عبد القيس عن طلحة بن مصرف الهمداني عن محمد بن النعمان عن شعبة بن الحجاج عن يحيى القطان عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","حديث أخت عبد الله بن رواحة عن النبي صلى الله عليه وسلم"
"7157","[13/76]             [13/77]             [13/78]      حَدِيثُ امْرَأَةٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  1 - (  7153  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  هِشَامِ بْنِ أَبِي عَبْدِ اللهِ ،  عَنْ  بُدَيْلِ بْنِ مَيْسَرَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنِ  امْرَأَةٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أُتِيَ  بِوَطْبَةٍ  فَأَخَذَهَا  أَعْرَابِيٌّ  بِثَلَاثِ لُقَمٍ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَمَا إِنَّهُ لَوْ قَالَ : بِاسْمِ اللهِ لَوَسِعَكُمْ  . وَقَالَ : "" إِذَا نَسِيَ أَحَدُكُمُ اسْمَ اللهِ عَلَى طَعَامِهِ ، فَلْيَقُلْ إِذَا         [13/79]      ذَكَرَ : بِاسْمِ اللهِ ، أَوَّلَهُ وَآخِرَهُ  .","","Musnad Abi Ya'la al-Mawsili 7153","","امرأة عن عبد الله بن عتبة بن أبي سفيان الأموي عن بديل بن ميسرة العقيلي عن هشام الدستوائي عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","حديث امرأة عن النبي صلى الله عليه وسلم"
"7158","[13/80]      حَدِيثُ  زَيْنَبَ بِنْتِ جَحْشٍ ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  1 - (  7154  ) -  حَدَّثَنَا  هَارُونُ بْنُ عَبْدِ اللهِ ،  حَدَّثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  حَدَّثَنَا  ابْنُ أَبِي ذِئْبٍ قَالَ :  حَدَّثَنِي  صَالِحٌ مَوْلَى التَّوْأَمَةِ ،  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ لِلنِّسَاءِ  عَامَ حَجَّةِ الْوَدَاعِ  :  هَذِهِ ثُمَّ ظُهُورَ  الْحُصُرِ  .         [13/81]      قَالَ : فَكُنَّ كُلُّهُنَّ يَحْجُجْنَ إِلَّا  سَوْدَةَ بِنْتَ زَمْعَةَ  ،  وَزَيْنَبَ بِنْتَ جَحْشٍ  ، فَإِنَّهُمَا كَانَتَا تَقُولَانِ : وَاللهِ لَا تُحَرِّكُنَا دَابَّةٌ بَعْدَ إِذْ سَمِعْنَا مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .         [13/82]","","Musnad Abi Ya'la al-Mawsili 7154","","أبو هريرة الدوسي عن صالح بن نبهان الجمحي عن محمد بن عبد الرحمن بن المغيرة عن محمد بن إسماعيل بن مسلم الديلي عن هارون بن عبد الله بن مروان الحمال عن أبو يعلى الموصلي","حديث زينب بنت جحش"
"7159","2 - (  7155  ) -  حَدَّثَنَا  إِسْحَاقُ ، وَهَارُونُ الْحَمَّالُ - وَاللَّفْظُ  لِإِسْحَاقَ  - قَالَا :  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  زَيْنَبَ ،  عَنْ  حَبِيبَةَ ،  عَنْ  أُمِّ حَبِيبَةَ ،  عَنْ  زَيْنَبَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اسْتَيْقَظَ مِنْ نَوْمٍ مُحْمَرًّا وَجْهُهُ ، وَهُوَ يَقُولُ :  لَا إِلَهَ إِلَّا اللهُ ! وَيْلٌ لِلْعَرَبِ مِنْ شَرٍّ قَدِ اقْتَرَبَ  ، فُتِحَ الْيَوْمَ مِنْ  رَدْمِ  يَأْجُوجَ  وَمَأْجُوجَ  مِثْلُ هَذِهِ "" قَالَتْ  زَيْنَبُ  : يَا رَسُولَ اللهِ ! أَنَهْلِكُ وَفِينَا الصَّالِحُونَ ؟ قَالَ : "" نَعَمْ ، إِذَا كَثُرَ  الْخَبَثُ  .         [13/83]             [13/84]","","Musnad Abi Ya'la al-Mawsili 7155","","زينب بنت جحش الأسدية عن رملة بنت أبي سفيان زوج رسول الله عن حبيبة بنت عبيد الله بن جحش الأسدية عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن الزهري عن سفيان بن عيينة عن هارون بن عبد الله بن مروان الحمال عن أبو يعلى الموصلي","حديث زينب بنت جحش"
"7160","[13/85]      3 - (  7156  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مَنْصُورُ بْنُ سَلَمَةَ الْخُزَاعِيُّ ،  أَخْبَرَنَا  مَالِكٌ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرٍ ،  عَنْ  حُمَيْدِ بْنِ نَافِعٍ ، عَنْ زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ أَنَّهَا  أَخْبَرَتْهُ  ، قَالَتْ :  دَخَلْتُ عَلَى  زَيْنَبَ بِنْتِ جَحْشٍ حِينَ تُوُفِّيَ أَخُوهَا ، فَدَعَتْ بِطِيبٍ فَمَسَّتْ مِنْهُ ، ثُمَّ قَالَتْ : وَاللهِ مَا لِي بِالطِّيبِ مِنْ حَاجَةٍ ، غَيْرَ أَنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ عَلَى الْمِنْبَرِ :  لَا يَحِلُّ لِامْرَأَةٍ تُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ  تُحِدُّ  عَلَى مَيِّتٍ فَوْقَ ثَلَاثِ لَيَالٍ  إِلَّا عَلَى زَوْجٍ أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا  .         [13/86]","","Musnad Abi Ya'la al-Mawsili 7156","","زينب بنت جحش الأسدية عن زينب بنت أبي سلمة المخزومية عن حميد بن نافع حميد صفيرا عن عبد الله بن أبي بكر بن محمد  ابن حزم عن مالك بن أنس عن منصور بن سلمة بن عبد العزيز عن زهير بن حرب عن أبو يعلى الموصلي","حديث زينب بنت جحش"
"7161","4 - (  7157  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عَبْدِ الْمَجِيدِ الْحَنَفِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْنَبَ بِنْتِ جَحْشٍ  أَنَّهَا كَانَتْ تُرَجِّلُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي  مِخْضَبٍ  مِنْ صُفْرٍ  .         [13/87]             [13/88]","","Musnad Abi Ya'la al-Mawsili 7157","","زينب بنت جحش الأسدية عن محمد بن عبد الله بن جحش الأسدي عن إبراهيم بن محمد بن عبد الله بن جحش بن رئاب الأسدي عن عبد الله بن عمر العمري عن عبيد الله بن عبد المجيد الحنفي عن زهير بن حرب عن أبو يعلى الموصلي","حديث زينب بنت جحش"
"7162","5 - (  7158  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ سُلَيْمَانَ الرَّازِيُّ قَالَ :  سَمِعْتُ  ابْنَ أَبِي ذِئْبٍ ،  عَنْ  صَالِحٍ مَوْلَى التَّوْأَمَةِ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ :  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِنِسَائِهِ :  هَذِهِ الْحَجَّةُ ، ثُمَّ ظُهُورَ  الْحُصُرِ  ، فَكُنَّ كُلُّهُنَّ يَحْجُجْنَ إِلَّا  زَيْنَبَ  ،  وَسَوْدَةَ  ، قَالَتَا : لَا تُحَرِّكُنَا دَابَّةٌ بَعْدَ قَوْلِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَعْنِي : "" هَذِهِ ، ثُمَّ ظُهُورَ  الْحُصُرِ  .","","Musnad Abi Ya'la al-Mawsili 7158","","أبو هريرة الدوسي عن صالح بن نبهان الجمحي عن محمد بن عبد الرحمن بن المغيرة عن إسحاق بن سليمان الرازي عن زهير بن حرب عن أبو يعلى الموصلي","حديث زينب بنت جحش"
"7163","6 - (  7159  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  زَيْنَبَ ،  عَنْ  حَبِيبَةَ ،  عَنْ  أُمِّ حَبِيبَةَ ،  عَنْ  زَيْنَبَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اسْتَيْقَظَ مِنْ نَوْمٍ مُحْمَرًّا وَجْهُهُ ، وَهُوَ يَقُولُ :  لَا إِلَهَ إِلَّا اللهُ ، وَيْلٌ لِلْعَرَبِ مِنْ شَرٍّ قَدِ اقْتَرَبَ  ، فُتِحَ الْيَوْمَ مِنْ  رَدْمِ  يَأْجُوجَ  وَمَأْجُوجَ  مِثْلُ هَذِهِ "" قَالَتْ  زَيْنَبُ  : أَنَهْلِكُ وَفِينَا الصَّالِحُونَ ؟ قَالَ : "" نَعَمْ ، إِذَا كَثُرَ  الْخَبَثُ  .","","Musnad Abi Ya'la al-Mawsili 7159","","زينب بنت جحش الأسدية عن رملة بنت أبي سفيان زوج رسول الله عن حبيبة بنت عبيد الله بن جحش الأسدية عن زينب بنت أبي سلمة المخزومية عن عروة بن الزبير عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","حديث زينب بنت جحش"
"7164","[13/89]      حَدِيثُ  رَزِينَةَ  1 - (  7160  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَتْنَا  عُلَيْلَةُ بِنْتُ الْكُمَيْتِ ، قَالَتْ :  حَدَّثَتْنِي  أُمِّي أَمِينَةُ  أَنَّهَا  حَدَّثَتْهَا  أَمَةُ اللهِ بِنْتُ رَزِينَةَ ،  عَنْ  أُمِّهَا رَزِينَةَ  مَوْلَاةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّ  سَوْدَةَ  الْيَمَانِيَّةَ جَاءَتْ  عَائِشَةَ  تَزُورُهَا - وَعِنْدَهَا  حَفْصَةُ بِنْتُ عُمَرَ  - فَجَاءَتْ  سَوْدَةُ  فِي هَيْئَةٍ وَفِي حَالٍ حَسَنَةٍ ، عَلَيْهَا دِرْعٌ مِنْ بُرُودِ  الْيَمَنِ  ، وَخِمَارٌ كَذَلِكَ ، وَعَلَيْهَا نُقْطَتَانِ مِثْلُ الْعَدَسَتَيْنِ مِنْ صَبِرٍ وَزَعْفَرَانٍ فِي مُؤْقَيْهَا ، قَالَتْ  عَلِيلَةُ  : وَأَدْرَكْتُ النِّسَاءَ يَتَزَيَّنَّ بِهِ ، فَقَالَتْ :  حَفْصَةُ         [13/90]      لِعَائِشَةَ  : يَا أُمَّ الْمُؤْمِنِينَ ، يَجِيءُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَشِقًا ، وَهَذِهِ بَيْنَنَا تَبْرُقُ ؟ فَقَالَتْ لَهَا أُمُّ الْمُؤْمِنِينَ : اتَّقِي اللهَ يَا  حَفْصَةُ  ، اتَّقِي اللهَ يَا  حَفْصَةُ  ، قَالَتْ : لَأُفْسِدَنَّ عَلَيْهَا زِينَتَهَا .  قَالَتْ : مَا تَقُلْنَ ؟ وَكَانَ فِي أُذُنِهَا ثِقَلٌ ، قَالَتْ لَهَا  حَفْصَةُ  : يَا  سَوْدَةُ  خَرَجَ  الْأَعْوَرُ  ، قَالَتْ : نَعَمْ ؟ فَفَزِعَتْ فَزَعًا شَدِيدًا ، فَجَعَلَتْ تَنْتَفِضُ ، قَالَتْ : أَيْنَ أَخْتَبِئُ ؟  قَالَتْ : عَلَيْكِ بِالْخَيْمَةِ - خَيْمَةٌ لَهُمْ مِنْ  سَعَفٍ  يَطْبُخُونَ فِيهَا - فَذَهَبَتْ فَاخْتَبَأَتْ فِيهَا ، وَفِيهَا الْقَذَرُ وَنَسْجُ الْعَنْكَبُوتِ ، فَجَاءَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُمَا تَضْحَكَانِ لَا تَسْتَطِيعَانِ أَنْ تَتَكَلَّمَا مِنَ الضَّحِكِ قَالَ : مَاذَا الضَّحِكُ ؟ ثَلَاثَ مِرَارٍ ، فَأَوْمَأَتَا بِأَيْدِيهِمَا إِلَى الْخَيْمَةِ ، فَذَهَبَ فَإِذَا  سَوْدَةُ  تُرْعِدُ  ، فَقَالَ لَهَا : يَا  سَوْدَةُ  ، مَا لَكِ ؟ قَالَتْ : يَا رَسُولَ اللهِ ! خَرَجَ  الْأَعْوَرُ  . قَالَ :  مَا         [13/91]      خَرَجَ وَلَيَخْرُجَنَّ ، مَا خَرَجَ وَلَيَخْرُجَنَّ مَا خَرَجَ وَلَيَخْرُجَنَّ  ثُمَّ دَخَلَ فَأَخْرَجَهَا ، فَجَعَلَ يَنْفُضُ عَنْهَا الْغُبَارَ وَنَسْجَ الْعَنْكَبُوتِ  .","","Musnad Abi Ya'la al-Mawsili 7160","","رزينة مولاة صفية زوج النبي صلى الله عليه وسلم عن أمة الله بنت رزينة خادم النبي صلى الله عليه وسلم عن أمينة عن عليلة بنت الكميت عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","حديث رزينة"
"7165","2 - (  7161  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ الْجُشَمِيُّ قَالَ :  حَدَّثَتْنَا  عُلَيْلَةُ بِنْتُ الْكُمَيْتِ ، قَالَتْ :  سَمِعْتُ  أُمِّي أَمِينَةَ  ، قَالَتْ :  حَدَّثَتْنِي  أَمَةُ اللهِ بِنْتُ رَزِينَةَ ،  عَنْ  أُمِّهَا رَزِينَةَ  مَوْلَاةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّهُ سَبَى  صَفِيَّةَ  يَوْمَ قُرَيْظَةَ وَالنَّضِيرِ  حِينَ فَتَحَ اللهُ عَلَيْهِ  ، فَجَاءَ بِهَا يَقُودُهَا سَبِيَّةً ، فَلَمَّا رَأَتِ النِّسَاءَ ، قَالَتْ : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَنَّكَ رَسُولُ اللهِ ، فَأَرْسَلَهَا ، وَكَانَ ذِرَاعُهَا فِي يَدِهِ فَأَعْتَقَهَا ، ثُمَّ خَطَبَهَا وَتَزَوَّجَهَا وَأَمْهَرَهَا  .         [13/92]","","Musnad Abi Ya'la al-Mawsili 7161","","رزينة مولاة صفية زوج النبي صلى الله عليه وسلم عن أمة الله بنت رزينة خادم النبي صلى الله عليه وسلم عن أمينة عن عليلة بنت الكميت عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","حديث رزينة"
"7166","3 - (  7162  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ الْقَوَارِيرِيُّ ،  حَدَّثَتْنَا  عُلَيْلَةُ ،  عَنْ  أُمِّهَا  ، قَالَتْ :  قُلْتُ  :  لِأَمَةِ اللهِ بِنْتِ رَزِينَةَ : يَا أَمَةَ اللهِ ،  حَدَّثَتْكِ  أُمُّكِ رَزِينَةُ  أَنَّهَا سَمِعَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَذْكُرُ صَوْمَ عَاشُورَاءَ ؟ قَالَتْ : نَعَمْ ، وَكَانَ يُعَظِّمُهُ حَتَّى يَدْعُوَ بِرُضَعَائِهِ وَرُضَعَاءِ ابْنَتِهِ  فَاطِمَةَ  ، فَيَتْفُلُ فِي أَفْوَاهِهِنَّ ، وَيَقُولُ لِلْأُمَّهَاتِ :  لَا تُرْضِعْنَهُنَّ إِلَى اللَّيْلِ  .","","Musnad Abi Ya'la al-Mawsili 7162","","رزينة مولاة صفية زوج النبي صلى الله عليه وسلم عن أمة الله بنت رزينة خادم النبي صلى الله عليه وسلم عن أم عليلة بنت الكميت عن عليلة بنت الكميت عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","حديث رزينة"
"7167","[13/93]      حَدِيثُ  حَلِيمَةَ بِنْتِ الْحَارِثِ  أُمِّ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  1 - (  7163  ) -  حَدَّثَنَا  مَسْرُوقُ بْنُ الْمَرْزُبَانِ الْكُوفِيُّ ، وَالْحَسَنُ بْنُ حَمَّادٍ ، وَنَسَخْتُهُ مِنْ حَدِيثِ  مَسْرُوقٍ  ،  حَدَّثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ زَائِدَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  جَهْمِ بْنِ أَبِي جَهْمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  عَنْ  حَلِيمَةَ بِنْتِ الْحَارِثِ أُمِّ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - السَّعْدِيَّةِ الَّتِي أَرْضَعَتْهُ ، قَالَتْ :  خَرَجْتُ فِي نِسْوَةٍ مِنْ  بَنِي سَعْدِ بْنِ بَكْرٍ  نَلْتَمِسُ الرُّضَعَاءَ  بِمَكَّةَ  عَلَى  أَتَانٍ  لِي  قَمْرَاءَ  قَدْ  أَذَمَّتْ  ، فَزَاحَمْتُ بِالرَّكْبِ ، قَالَتْ : وَخَرَجْنَا فِي سَنَةٍ  شَهْبَاءَ  لَمْ تُبْقِ شَيْئًا ، وَمَعِي زَوْجِي  الْحَارِثُ بْنُ عَبْدِ الْعُزَّى  ، قَالَتْ : وَمَعَنَا  شَارِفٌ  لَنَا ، وَاللهِ إِنْ  تَبِضُّ  عَلَيْنَا بِقَطْرَةٍ مِنْ         [13/94]      لَبَنٍ ، وَمَعِي صَبِيٌّ لِي إِنْ نَنَامُ لَيْلَتَنَا مَعَ بُكَائِهِ ، مَا فِي ثَدْيِي مَا يُغْنِيهِ ، وَمَا فِي  شَارِفِنَا  مِنْ لَبَنٍ نَغْذُوهُ إِلَّا أَنَّا نَرْجُو ، فَلَمَّا قَدِمْنَا  مَكَّةَ  ، لَمْ تَبْقَ مِنَّا امْرَأَةٌ إِلَّا عُرِضَ عَلَيْهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَتَأْبَاهُ ، وَإِنَّمَا كُنَّا نَرْجُو كَرَامَةَ رَضَاعَةٍ مِنْ وَالِدِ الْمَوْلُودِ - وَكَانَ يَتِيمًا - فَكُنَّا نَقُولُ : مَا عَسَى أَنْ تَصْنَعَ أُمُّهُ ؟ حَتَّى لَمْ يَبْقَ مِنْ صَوَاحِبِي امْرَأَةٌ إِلَّا أَخَذَتْ صَبِيًّا غَيْرِي ، وَكَرِهْتُ أَنْ أَرْجِعَ وَلَمْ آخُذْ شَيْئًا ، وَقَدْ أَخَذَ صَوَاحِبِي ، فَقُلْتُ لِزَوْجِي : وَاللهِ لَأَرْجِعَنَّ إِلَى ذَلِكَ فَلَآخُذَنَّهُ .  قَالَتْ : فَأَتَيْتُهُ ، فَأَخَذْتُهُ ، فَرَجَعْتُهُ إِلَى رَحْلِي ، فَقَالَ زَوْجِي : قَدْ أَخَذْتِهِ ؟ فَقُلْتُ : نَعَمْ ، وَاللهِ ذَاكَ أَنِّي لَمْ أَجِدْ غَيْرَهُ .  فَقَالَ : قَدْ أَصَبْتِ ، فَعَسَى اللهُ أَنْ يَجْعَلَ فِيهِ خَيْرًا ، قَالَتْ : فَوَاللهِ مَا هُوَ إِلَّا أَنْ جَعَلْتُهُ فِي  حَجْرِي  ، قَالَتْ : فَأَقْبَلَ عَلَيْهِ ثَدْيِي بِمَا شَاءَ مِنَ اللَّبَنِ ، قَالَتْ : فَشَرِبَ حَتَّى رَوِيَ ، وَشَرِبَ أَخُوهُ - تَعْنِي : ابْنَهَا - حَتَّى رَوِيَ ، وَقَامَ زَوْجِي إِلَى  شَارِفِنَا  مِنَ اللَّيْلِ ، فَإِذَا بِهَا  حَافِلٌ  ، فَحَلَبَ لَنَا مَا شِئْنَا ، فَشَرِبَ حَتَّى رَوِيَ .         [13/95]      قَالَتْ : وَشَرِبْتُ حَتَّى رَوِيتُ . فَبِتْنَا لَيْلَتَنَا تِلْكَ بِخَيْرٍ شِبَاعًا رِوَاءً ، وَقَدْ نَامَ صِبْيَانُنَا ، قَالَتْ : يَقُولُ أَبُوهُ - تَعْنِي زَوْجَهَا - : وَاللهِ يَا  حَلِيمَةُ  ، مَا أُرَاكِ إِلَّا قَدْ أَصَبْتِ  نَسَمَةً  مُبَارَكَةً ، قَدْ نَامَ صَبِيُّنَا وَرَوِيَ .  قَالَتْ : ثُمَّ خَرَجْنَا ، فَوَاللهِ لَخَرَجَتْ أَتَانِي أَمَامَ الرَّكْبِ قَدْ قَطَعَتْهُنَّ حَتَّى مَا يَبْلُغُونَهَا ، حَتَّى إِنَّهُمْ لَيَقُولُونَ : وَيْحَكِ يَا  بِنْتَ الْحَارِثِ  ، كُفِّي عَلَيْنَا ، أَلَيْسَتْ هَذِهِ  بِأَتَانِكِ  الَّتِي خَرَجْتِ عَلَيْهَا ؟ فَأَقُولُ : بَلَى وَاللهِ ، وَهِيَ قُدَّامُنَا ، حَتَّى قَدِمْنَا مَنَازِلَنَا مِنْ حَاضِرِ  بَنِي سَعْدِ بْنِ بَكْرٍ  ، فَقَدِمْنَا عَلَى أَجْدَبِ أَرْضِ اللهِ ، فَوَالَّذِي نَفْسُ  حَلِيمَةَ  بِيَدِهِ ، إِنْ كَانُوا لَيُسَرِّحُونَ أَغْنَامَهُمْ إِذَا أَصْبَحُوا ، وَيَسْرَحُ رَاعِي غَنَمِي ، فَتَرُوحُ غَنَمِي  بِطَانًا  لُبَّنًا  حُفَّلًا  ، وَتَرُوحُ أَغْنَامُهُمْ جِيَاعًا هَالِكَةً ، مَا بِهَا مِنْ لَبَنٍ ، قَالَتْ : فَنَشْرَبُ مَا شِئْنَا مِنْ لَبَنٍ ، وَمَا مِنَ الْحَاضِرِ أَحَدٌ يَحْلُبُ قَطْرَةً ، وَلَا يَجِدُهَا .  يَقُولُونَ لِرُعَاتِهِمْ : وَيْلَكُمْ ، أَلَا تَسْرَحُونَ حَيْثُ يَسْرَحُ رَاعِي  حَلِيمَةَ  ؟ فَيَسْرَحُونَ فِي الشِّعْبِ الَّذِي يَسْرَحُ فِيهِ رَاعِينَا ، فَتَرُوحُ أَغْنَامُهُمْ جِيَاعًا مَا لَهَا مِنْ لَبَنٍ ، وَتَرُوحُ غَنَمِي لُبَّنًا  حُفَّلًا  .         [13/96]      قَالَتْ : وَكَانَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَشِبُّ فِي الْيَوْمِ شَبَابَ الصَّبِيِّ فِي  الشَّهْرِ  ، وَيَشِبُّ فِي  الشَّهْرِ  شَبَابَ الصَّبِيِّ فِي سَنَةٍ ، فَبَلَغَ سِتًّا وَهُوَ غُلَامٌ  جَفْرٌ  .  قَالَتْ : فَقَدِمْنَا عَلَى أُمِّهِ ، فَقُلْنَا لَهَا ، وَقَالَ لَهَا أَبُوهُ : رُدُّوا عَلَيْنَا ابْنِي ، فَلْنَرْجِعْ بِهِ ، فَإِنَّا نَخْشَى عَلَيْهِ  وَبَاءَ  مَكَّةَ  ، قَالَتْ : وَنَحْنُ أَضَنُّ بِشَأْنِهِ لِمَا رَأَيْنَا مِنْ بَرَكَتِهِ ، قَالَتْ : فَلَمْ يَزَلْ بِهَا حَتَّى قَالَتِ : ارْجِعَا بِهِ ، فَرَجَعْنَا بِهِ ، فَمَكَثَ عِنْدَنَا شَهْرَيْنِ ، قَالَتْ : فَبَيْنَا هُوَ يَلْعَبُ وَأَخُوهُ يَوْمًا خَلْفَ الْبُيُوتِ يَرْعَيَانِ بَهْمًا لَنَا ، إِذْ جَاءَنَا أَخُوهُ يَشْتَدُّ ، فَقَالَ لِي وَلِأَبِيهِ : أَدْرِكَا أَخِي الْقُرَشِيَّ ، قَدْ جَاءَهُ رَجُلَانِ فَأَضْجَعَاهُ ، فَشَقَّا بَطْنَهُ ، فَخَرَجْنَا نَحْوَهُ نَشْتَدُّ ، فَانْتَهَيْنَا إِلَيْهِ وَهُوَ قَائِمٌ مُنْتَقِعٌ لَوْنُهُ ، فَاعْتَنَقَهُ أَبُوهُ وَاعْتَنَقْتُهُ ، ثُمَّ قُلْنَا : مَا لَكَ أَيْ بُنَيَّ ؟ قَالَ :  أَتَانِي رَجُلَانِ عَلَيْهِمَا ثِيَابٌ بِيضٌ         [13/97]      فَأَضْجَعَانِي ، ثُمَّ شَقَّا بَطْنِي  ، فَوَاللهِ مَا أَدْرِي مَا صَنَعَا ، قَالَتْ : فَاحْتَمَلْنَاهُ فَرَجَعْنَا بِهِ ، قَالَتْ : يَقُولُ أَبُوهُ : وَاللهِ يَا  حَلِيمَةُ  مَا أَرَى هَذَا الْغُلَامَ إِلَّا قَدْ أُصِيبَ ، فَانْطَلِقِي فَلْنَرُدَّهُ إِلَى أَهْلِهِ قَبْلَ أَنْ يَظْهَرَ بِهِ مَا نَتَخَوَّفُ عَلَيْهِ ، قَالَتْ : فَرَجَعْنَا بِهِ إِلَيْهَا ، فَقَالَتْ : مَا رَدَّكُمَا بِهِ ؟ وَقَدْ كُنْتُمَا حَرِيصَيْنِ عَلَيْهِ ، قَالَتْ : فَقُلْتُ : لَا وَاللهِ إِلَّا أَنَّا كَفَلْنَاهُ وَأَدَّيْنَا الْحَقَّ الَّذِي يَجِبُ عَلَيْنَا فِيهِ ، ثُمَّ تَخَوَّفْتُ الْأَحْدَاثَ عَلَيْهِ ، فَقُلْنَا : يَكُونُ فِي أَهْلِهِ ، قَالَتْ : فَقَالَتْ  آمِنَةُ  : وَاللهِ مَا ذَاكَ بِكُمَا ، فَأَخْبِرَانِي خَبَرَكُمَا وَخَبَرَهُ ، فَوَاللهِ مَا زَالَتْ بِنَا حَتَّى أَخْبَرْنَاهَا خَبَرَهُ ، قَالَتْ : فَتَخَوَّفْتُمَا عَلَيْهِ ؟ كَلَّا وَاللهِ ، إِنَّ لِابْنِي هَذَا شَأْنًا ، أَلَا أُخْبِرُكُمَا عَنْهُ ؟ إِنِّي حَمَلْتُ بِهِ فَلَمْ أَحْمِلْ حَمْلًا قَطُّ كَانَ  أَخَفَّ ،  وَلَا أَعْظَمَ بَرَكَةً مِنْهُ ، ثُمَّ رَأَيْتُ نُورًا كَأَنَّهُ شِهَابٌ خَرَجَ مِنِّي حِينَ وَضَعْتُهُ أَضَاءَتْ لِي أَعْنَاقُ الْإِبِلِ بِبُصْرَى ، ثُمَّ وَضَعْتُهُ فَمَا وَقَعَ كَمَا يَقَعُ الصِّبْيَانُ : وَقَعَ وَاضِعًا يَدَهُ بِالْأَرْضِ ، رَافِعًا رَأْسَهُ إِلَى السَّمَاءِ ، دَعَاهُ وَالْحَقَا بِشَأْنِكُمَا  .","","Musnad Abi Ya'la al-Mawsili 7163","","حليمة السعدية مرضعة رسول الله صلى الله عليه وسلم عن عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن جهم بن أبي الجهم الجمحي عن محمد بن إسحاق عن يحيى بن زكريا بن أبي زائدة عن الحسن بن حماد سجادة عن أبو يعلى الموصلي","حديث حليمة بنت الحارث أم رسول الله صلى الله عليه وسلم"
"7168","[13/98]             [13/99]             [13/100]      مُسْنَدُ  تَمِيمٍ الدَّارِيِّ  1 - (  7164  ) -  حَدَّثَنَا  مَنْصُورُ بْنُ أَبِي مُزَاحِمٍ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَطَاءِ بْنِ يَزِيدَ ،  عَنْ  تَمِيمٍ الدَّارِيِّ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّمَا الدِّينُ  النَّصِيحَةُ  ، إِنَّمَا الدِّينُ  النَّصِيحَةُ ،  إِنَّمَا الدِّينُ  النَّصِيحَةُ  "" قَالُوا : لِمَنْ يَا رَسُولَ اللهِ ؟ قَالَ : "" لِلهِ وَلِرَسُولِهِ ، وَلِكِتَابِهِ ، وَلِأَئِمَّةِ الْمُسْلِمِينَ وَعَامَّتِهِمْ  "" .         [13/101]             [13/102]","","Musnad Abi Ya'la al-Mawsili 7164","","تميم بن أوس الداري عن عطاء بن يزيد الجندعي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن إسماعيل بن عياش الأحول عن منصور بن أبي مزاحم عن أبو يعلى الموصلي","مسند تميم الداري"
"7169","2 - (  7165  ) -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ الْأَزْدِيُّ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَوْهَبٍ ،  عَنْ  تَمِيمٍ الدَّارِيِّ قَالَ :  سَأَلْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الرَّجُلِ         [13/103]      يُسْلِمُ عَلَى يَدَيِ الرَّجُلِ . قَالَ :  هُوَ  أَوْلَى  النَّاسِ بِمَحْيَاهُ وَمَمَاتِهِ  .         [13/104]             [13/105]             [13/106]             [13/107]","","Musnad Abi Ya'la al-Mawsili 7165","","تميم بن أوس الداري عن عبد الله بن موهب الهمداني عن عبد العزيز بن عمر بن عبد العزيز عن علي بن مسهر القرشي عن عبد الرحمن بن صالح العتكي عن أبو يعلى الموصلي","مسند تميم الداري"
"7170","1 - (  7166  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنِ  الْأَزْرَقِ بْنِ قَيْسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ رَبَاحٍ ،  عَنْ  رَجُلٍ مِنْ أَصْحَابِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى الْعَصْرَ ، فَقَامَ  رَجُلٌ  يُصَلِّي ، فَرَآهُ  عُمَرُ  ، فَقَالَ لَهُ : اجْلِسْ ، فَإِنَّمَا هَلَكَ أَهْلُ الْكِتَابِ بِأَنَّهُ لَمْ يَكُنْ لِصَلَاتِهِمْ فَصْلٌ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَحْسَنَ  ابْنُ الْخَطَّابِ  .         [13/108]","","Musnad Abi Ya'la al-Mawsili 7166","","أحد الصحابة عن عبد الله بن رباح الأنصاري عن أزرق بن قيس الحارثي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند تميم الداري"
"7171","1 - (  7167  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْخَطَّابِ ،  حَدَّثَنَا  الْجُدِّيُّ ،  أَخْبَرَنَا  شُعْبَةُ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ قَالَ :         [13/109]      سَمِعْتُ  عَمِّي يُحَدِّثُ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ سَمِعَ  النِّدَاءَ  يَوْمَ الْجُمُعَةِ  فَلَمْ يَأْتِ - أَوْ لَمْ يُجِبْ  -  ثُمَّ سَمِعَ  النِّدَاءَ  فَلَمْ يَأْتِ - أَوْ لَمْ يُجِبْ  - ثُمَّ سَمِعَ  النِّدَاءَ  فَلَمْ يَأْتِ - أَوْ لَمْ يُجِبْ  - طَبَعَ اللهُ - عَزَّ وَجَلَّ - عَلَى قَلْبِهِ ، فَجُعِلَ قَلْبَ مُنَافِقٍ  .         [13/110]","","Musnad Abi Ya'la al-Mawsili 7167","","يحيى بن أبي أمامة الأنصاري عن محمد بن عبد الرحمن بن سعد بن زرارة عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن شعبة بن الحجاج عن عبد الملك بن إبراهيم الجدي عن محمد بن الخطاب البلدي عن أبو يعلى الموصلي","مسند تميم الداري"
"7172","1 - (  7168  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْخَطَّابِ ،  حَدَّثَنَا  الْجُدِّيُّ ،  أَخْبَرَنَا  شُعْبَةُ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ  يُحَدِّثُ ، عَنْ  رَجُلٍ مِنَ الْأَنْصَارِ ،  عَنْ  رَجُلٍ مِنْ أَصْحَابِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  ثَلَاثٌ حَقٌّ عَلَى كُلِّ مُسْلِمٍ يَوْمَ الْجُمُعَةِ : السِّوَاكُ  ، وَالْغُسْلُ ، وَالطِّيبُ إِنْ وُجِدَ  .","","Musnad Abi Ya'la al-Mawsili 7168","","أحد الصحابة عن رجل من الأنصار عن محمد بن عبد الرحمن بن ثوبان القرشي عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن شعبة بن الحجاج عن عبد الملك بن إبراهيم الجدي عن محمد بن الخطاب البلدي عن أبو يعلى الموصلي","مسند تميم الداري"
"7173","[13/111]      حَدِيثُ  أَبِي وَهْبٍ الْجُشَمِيِّ  1 - (  7169  ) -  حَدَّثَنَا  هَارُونُ بْنُ عَبْدِ اللهِ ،  حَدَّثَنَا  هِشَامُ بْنُ         [13/112]             [13/113]      سَعِيدٍ الطَّالْقَانِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُهَاجِرِ الْأَنْصَارِيُّ قَالَ :  حَدَّثَنِي  عَقِيلُ بْنُ شَبِيبٍ ،  عَنْ  أَبِي وَهْبٍ الْجُشَمِيِّ - وَكَانَتْ  لَهُ صُحْبَةٌ  - قَالَ : "" قَالَ         [13/114]      رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  تَسَمَّوْا بِأَسْمَاءِ الْأَنْبِيَاءِ ، وَأَحَبُّ الْأَسْمَاءِ إِلَى اللهِ : عَبْدُ اللهِ ، وَعَبْدُ الرَّحْمَنِ  ، وَأَصْدَقُهَا : حَارِثٌ ،  وَهَمَّامٌ  ،  وَأَقْبَحُهَا  : حَرْبٌ ، وَمُرَّةُ  .","","Musnad Abi Ya'la al-Mawsili 7169","","أبو وهب الجشمي عن عقيل بن شبيب عن محمد بن مهاجر بن أبي مسلم عن هشام بن سعيد الطالقاني عن هارون بن عبد الله بن مروان الحمال عن أبو يعلى الموصلي","حديث أبي وهب الجشمي"
"7174","2 - (  7170  ) -  وَبِإِسْنَادِهِ  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :         [13/115]      ""  ارْتَبِطُوا الْخَيْلَ  ،  وَامْسَحُوا بِنَوَاصِيهَا وَأَعْجَازِهَا ، أَوْ قَالَ : أَكْفَالِهَا وَقَلِّدُوهَا  ، وَلَا  تُقَلِّدُوهَا  الْأَوْتَارَ  .","","Musnad Abi Ya'la al-Mawsili 7170","","أبو وهب الجشمي عن عقيل بن شبيب عن محمد بن مهاجر بن أبي مسلم عن هشام بن سعيد الطالقاني عن هارون بن عبد الله بن مروان الحمال عن أبو يعلى الموصلي","حديث أبي وهب الجشمي"
"7175","3 - (  7171  ) -  وَبِإِسْنَادِهِ  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  عَلَيْكُمْ بِكُلِّ كُمَيْتٍ أَغَرَّ مُحَجَّلٍ ، أَوْ أَدْهَمَ ، أَغَرَّ مُحَجَّلٍ  .","","Musnad Abi Ya'la al-Mawsili 7171","","أبو وهب الجشمي عن عقيل بن شبيب عن محمد بن مهاجر بن أبي مسلم عن هشام بن سعيد الطالقاني عن هارون بن عبد الله بن مروان الحمال عن أبو يعلى الموصلي","حديث أبي وهب الجشمي"
"7176","[13/116]             [13/117]      مُسْنَدُ  أُسَيْدِ بْنِ ظُهَيْرٍ  1 - (  7172  ) -  حَدَّثَنَا  هَارُونُ بْنُ عَبْدِ اللهِ ،  حَدَّثَنَا  أَبُو أُسَامَةَ قَالَ :  حَدَّثَنِي  عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ الْأَنْصَارِيُّ ،  حَدَّثَنَا  أَبُو الْأَبْرَدِ مَوْلَى بَنِي خَطْمَةَ  أَنَّهُ سَمِعَ  أُسَيْدَ بْنَ ظُهَيْرٍ الْأَنْصَارِيَّ أَنَّهُ سَمِعَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  صَلَاةٌ فِي  مَسْجِدِ قُبَاءٍ  كَعُمْرَةٍ  .","","Musnad Abi Ya'la al-Mawsili 7172","","أسيد بن ظهير الحارثي عن زياد الخطمي عن عبد الحميد بن جعفر الأوسي عن حماد بن أسامة القرشي عن هارون بن عبد الله بن مروان الحمال عن أبو يعلى الموصلي","حديث أسيد بن ظهير"
"7177","[13/118]             [13/119]      حَدِيثُ  الْمُطَّلِبِ بْنِ أَبِي وَدَاعَةَ السَّهْمِيِّ  1 - (  7173  ) -  حَدَّثَنَا  هَارُونُ الْحَمَّالُ ،  حَدَّثَنَا  سُفْيَانُ قَالَ :  حَدَّثَنَا  كَثِيرُ بْنُ كَثِيرِ بْنِ الْمُطَّلِبِ بْنِ أَبِي وَدَاعَةَ ،  عَنْ  بَعْضِ أَهْلِهِ قَالَ :  سَمِعْتُ  الْمُطَّلِبَ بْنَ أَبِي وَدَاعَةَ السَّهْمِيَّ ، يَقُولُ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي مِمَّا يَلِي  بَابَ بَنِي سَهْمٍ  ، وَالنَّاسُ يَمُرُّونَ بَيْنَ يَدَيْهِ  ، وَلَيْسَ بَيْنَهُ وَبَيْنَ الْقِبْلَةِ سُتْرَةٌ  .","","Musnad Abi Ya'la al-Mawsili 7173","","المطلب بن أبي وداعة الجمحي عن بعض أهل كثير بن كثير بن المطلب السهمي عن كثير بن كثير بن المطلب السهمي عن سفيان بن عيينة عن هارون بن عبد الله بن مروان الحمال عن أبو يعلى الموصلي","حديث المطلب بن أبي وداعة السهمي"
"7178","[13/120]             [13/121]      حَدِيثُ  عَمْرِو بْنِ حَزْمٍ  1 - (  7174  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ عُمَرَ بْنِ شَقِيقِ بْنِ أَسْمَاءَ الْجَرْمِيُّ ،  حَدَّثَنَا  جَعْفَرٌ ،  عَنْ  هِشَامٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ قَالَ :  لَمَّا أَرَادَ  مُعَاوِيَةُ  أَنْ يَسْتَخْلِفَ  يَزِيدَ  ، بَعَثَ إِلَى عَامِلِ  الْمَدِينَةِ  أَنْ أَفِدْ إِلَيَّ مَنْ شَاءَ قَالَ : فَوَفَدَ إِلَيْهِ عَمْرُو بْنُ حَزْمٍ الْأَنْصَارِيُّ ، فَاسْتَأْذَنَ ، فَجَاءَ حَاجِبُ  مُعَاوِيَةَ  يَسْتَأْذِنُ ، فَقَالَ : هَذَا  عَمْرٌو  قَدْ جَاءَ يَسْتَأْذِنُ ، فَقَالَ : مَا جَاءَ بِهِمْ إِلَيَّ ؟ فَقَالَ : يَا أَمِيرَ الْمُؤْمِنِينَ ، جَاءَ يَطْلُبُ مَعْرُوفَكَ ، فَقَالَ  مُعَاوِيَةُ  : إِنْ كُنْتَ صَادِقًا فَلْيَكْتُبْ مَا شَاءَ ، فَأَعْطِهِ مَا سَأَلَكَ ، وَلَا أُرَاهُ .  قَالَ : فَخَرَجَ إِلَيْهِ الْحَاجِبُ ، فَقَالَ : مَا حَاجَتُكَ ؟ اكْتُبْ مَا شِئْتَ .         [13/122]      فَقَالَ : سُبْحَانَ اللهِ ! أَجِيءُ إِلَى بَابِ أَمِيرِ الْمُؤْمِنِينَ ، فَأُحْجَبُ عَنْهُ ؟ أُحِبُّ أَنْ أَلْقَاهُ ، فَأُكَلِّمَهُ .  فَقَالَ  مُعَاوِيَةُ  لِلْحَاجِبِ : عِدْهُ يَوْمَ كَذَا وَكَذَا إِذَا صَلَّى الْغَدَاةَ فَلْيَجِئْ قَالَ : فَلَمَّا صَلَّى  مُعَاوِيَةُ  الْغَدَاةَ ، أَمَرَ بِسَرِيرٍ ، فَجُعِلَ فِي إِيوَانٍ لَهُ ، ثُمَّ أَخْرَجَ النَّاسَ عَنْهُ ، فَلَمْ يَكُنْ عِنْدَهُ أَحَدٌ إِلَّا كُرْسِيٌّ وُضِعَ  لِعَمْرٍو  ، فَجَاءَ  عَمْرٌو  ، فَاسْتَأْذَنَ ، فَأَذِنَ لَهُ ، فَسَلَّمَ عَلَيْهِ ، ثُمَّ جَلَسَ عَلَى الْكُرْسِيِّ ، فَقَالَ لَهُ  مُعَاوِيَةُ  : حَاجَتَكَ . قَالَ : فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ : لَعَمْرِي لَقَدْ أَصْبَحَ  يَزِيدُ بْنُ مُعَاوِيَةَ  وَاسِطَ  الْحَسَبِ  فِي  قُرَيْشٍ  ، غَنِيًّا عَنِ الْمَالِ ، غَنِيًّا إِلَّا عَنْ كُلِّ خَيْرٍ ، وَإِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ اللهَ لَمْ يَسْتَرْعِ عَبْدًا رَعِيَّةً إِلَّا وَهُوَ سَائِلُهُ عَنْهَا يَوْمَ الْقِيَامَةِ ، كَيْفَ صَنَعَ فِيهَا  .  وَإِنِّي أُذَكِّرُكَ اللهَ يَا  مُعَاوِيَةُ  فِي أُمَّةِ  مُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِمَنْ تَسْتَخْلِفُ عَلَيْهَا قَالَ : فَأَخَذَ  مُعَاوِيَةَ  رَبْوَةٌ وَنَفَسٌ فِي غَدَاةٍ قَرٍّ حَتَّى  عَرِقَ  ، وَجَعَلَ يَمْسَحُ الْعَرَقَ عَنْ وَجْهِهِ ثَلَاثًا ، ثُمَّ  أَفَاقَ  ، فَحَمِدَ اللهَ ، وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ : أَمَّا بَعْدُ ، فَإِنَّكَ امْرُؤٌ نَاصِحٌ ، قُلْتَ بِرَأْيِكَ ، بَالِغٌ مَا بَلَغَ ، وَإِنَّهُ لَمْ يَبْقَ إِلَّا ابْنِي وَأَبْنَاؤُهُمْ ، وَابْنِي أَحَقُّ مِنْ أَبْنَائِهِمْ ، حَاجَتَكَ . قَالَ : مَا لِي حَاجَةٌ .         [13/123]      قَالَ : ثُمَّ قَالَ لَهُ أَخُوهُ : إِنَّمَا جِئْنَا مِنَ  الْمَدِينَةِ  نَضْرِبُ أَكْبَادَهَا مِنْ أَجْلِ كَلِمَاتٍ ؟ قَالَ : مَا جِئْتُ إِلَّا لِكَلِمَاتٍ . قَالَ : فَأَمَرَ لَهُمْ بِجَوَائِزِهِمْ . قَالَ : وَخَرَجَ  لِعَمْرٍو  مِثْلُهُ .","","Musnad Abi Ya'la al-Mawsili 7174","","عمرو بن حزم بن زيد الخزرجي عن محمد بن سيرين عن هشام بن حسان العتكي عن جعفر بن سليمان الضبعي عن الحسن بن عمر بن شقيق الجرمي عن أبو يعلى الموصلي","حديث عمرو بن حزم"
"7179","2 - (  7175  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ، وَإِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عَرْعَرَةَ - وَنُسْخَتُهُ عَنْ نُسْخَةِ  إِبْرَاهِيمَ  - قَالَا :  حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ،  أَخْبَرَنَا  مَعْمَرٌ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ،  عَنْ  أَبِيهِ  قَالَ :  دَخَلَ عَمْرُو بْنُ حَزْمٍ ، عَلَى  عَمْرِو بْنِ الْعَاصِ  ، فَقَالَ : قُتِلَ  عَمَّارٌ  ، وَقَدْ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَقْتُلُهُ  الْفِئَةُ  الْبَاغِيَةُ  فَدَخَلَ         [13/124]      عَمْرٌو  عَلَى  مُعَاوِيَةَ  ، فَقَالَ : قُتِلَ  عَمَّارٌ  ، قَالَ  مُعَاوِيَةُ  : قُتِلَ  عَمَّارٌ  ، فَمَاذَا ؟ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : "" تَقْتُلُهُ  الْفِئَةُ  الْبَاغِيَةُ  "" قَالَ : دُحِضْتَ فِي بَوْلِكَ ، أَوَنَحْنُ قَتَلْنَاهُ ؟ إِنَّمَا قَتَلَهُ  عَلِيٌّ  ، وَأَصْحَابُهُ  .","","Musnad Abi Ya'la al-Mawsili 7175","","عمرو بن حزم بن زيد الخزرجي عن محمد بن عمرو بن حزم النجاري عن أبو بكر بن محمد الخزرجي عن عبد الله بن طاووس عن معمر بن راشد عن عبد الرزاق الصنعاني عن إبراهيم بن محمد بن عرعرة عن أبو يعلى الموصلي","حديث عمرو بن حزم"
"7180","3 - (  7176  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  حَدَّثَنَا  عُثْمَانُ بْنُ حَكِيمٍ قَالَ :  حَدَّثَنِي  أَبُو بَكْرِ بْنُ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ قَالَ :         [13/125]      عَرَضْتُ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رُقْيَةَ النَّهْشَةِ مِنَ الْحَيَّةِ فَأَمَرَ بِهَا  .","","Musnad Abi Ya'la al-Mawsili 7176","","أبو بكر بن محمد الخزرجي عن عثمان بن حكيم الأحلافي عن عبد الواحد بن زياد عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","حديث عمرو بن حزم"
"7181","[13/126]      حَدِيثُ  بُهَيْسَةَ  ، عَنْ أَبِيهَا  1 - (  7177  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَرْزُوقٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكْرٍ الْبُرْسَانِيُّ ،  حَدَّثَنَا  كَهْمَسُ بْنُ الْحَسَنِ ،  عَنْ  سَيَّارٍ - رَجُلٍ مِنْ بَنِي فَزَارَةَ -  عَنْ  أَبِيهِ  ،  عَنْ  بُهَيْسَةَ ،  عَنْ  أَبِيهَا  ، قَالَتِ :  اسْتَأْذَنَ أَبِي النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَدَخَلَ بَيْنَهُ         [13/127]      وَبَيْنَ قَمِيصِهِ مِنْ خَلْفِهِ ، فَجَعَلَ يَلْتَزِمُهُ ، ثُمَّ جَعَلَ يَقُولُ :  يَا نَبِيَّ اللهِ ، مَا الشَّيْءُ الَّذِي لَا يَحِلُّ مَنْعُهُ ؟ قَالَ : الْمَاءُ  قَالَ : يَا نَبِيَّ اللهِ ، مَا الشَّيْءُ الَّذِي لَا يَحِلُّ مَنْعُهُ ؟ قَالَ : "" الْمِلْحُ "" قَالَ : يَا نَبِيَّ اللهِ ، مَا الشَّيْءُ الَّذِي لَا يَحِلُّ مَنْعُهُ ؟ قَالَ : "" أَنْ تَفْعَلَ الْخَيْرَ خَيْرٌ لَكَ "" .  قَالَ : فَانْتَهَى إِلَى الْمَاءِ وَالْمِلْحِ . قَالَ : فَكَانَ ذَلِكَ الرَّجُلُ لَا يَمْنَعُ شَيْئًا مِنَ الْمَاءِ وَإِنْ قَلَّ  .","","Musnad Abi Ya'la al-Mawsili 7177","","أبو بهيسة الفزاري عن بهيسة الفزارية عن منظور بن سيار الفزاري عن سيار بن منظور الفزاري عن كهمس بن الحسن النمري عن محمد بن بكر بن عثمان البرساني عن محمد بن محمد بن مرزوق الباهلي عن أبو يعلى الموصلي","حديث بهيسة عن أبيها"
"7182","[13/128]             [13/129]      حَدِيثُ  رَزِينِ بْنِ أَنَسٍ السُّلَمِيِّ  1 - (  7178  ) -  أَخْبَرَنَا  أَبُو يَعْلَى أَحْمَدُ بْنُ عَلِيِّ بْنِ الْمُثَنَّى الْمَوْصِلِيُّ ،  حَدَّثَنَا  أَبُو وَائِلٍ خَالِدُ بْنُ مُحَمَّدٍ الْبَصْرِيُّ ،  حَدَّثَنَا  فَهْدُ بْنُ عَوْفٍ  بِمَنْزِلِ بَنِي عَامِرٍ  ،  حَدَّثَنَا  نَائِلُ بْنُ مُطَرِّفِ بْنِ رَزِينِ بْنِ أَنَسٍ السُّلَمِيُّ قَالَ :  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي رَزِينِ بْنِ أَنَسٍ  قَالَ :  لَمَّا ظَهَرَ الْإِسْلَامُ كَانَتْ لَنَا بِئْرٌ ، فَخِفْتُ أَنْ يَغْلِبَنَا عَلَيْهَا مَنْ حَوْلَهَا ، فَأَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقُلْتُ : يَا رَسُولَ اللهِ ! إِنَّ لَنَا بِئْرًا ، وَقَدْ خِفْتُ أَنْ يَغْلِبَنَا عَلَيْهَا مَنْ         [13/130]      حَوْلَهَا ؟ فَكَتَبَ لِي كِتَابًا :  مِنْ  مُحَمَّدٍ  رَسُولِ اللهِ ، أَمَّا بَعْدُ : فَإِنَّ لَهُمْ بِئْرَهُمْ ، إِنْ كَانَ صَادِقًا ، وَلَهُمْ دَارَهُمْ إِنْ كَانَ صَادِقًا  قَالَ : فَمَا قَاضَيْنَا بِهِ إِلَى أَحَدٍ مِنْ  قُضَاةِ الْمَدِينَةِ  إِلَّا قَضَوْا لَنَا بِهِ . قَالَ : وَفِي كِتَابِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - هِجَاءُ "" كَانَ "" : "" كَوُنَ  .","","Musnad Abi Ya'la al-Mawsili 7178","","رزين بن أنس بن عامر السلمي عن والد ونائل بن مطرف بن رزين عن ونائل بن مطرف بن رزين عن زيد بن عوف القطعي عن أبو وائل خالد بن محمد عن أبو يعلى الموصلي","حديث رزين بن أنس السلمي"
"7183","[13/131]      حَدِيثُ رَجُلٍ مِنْ  بَلْقَيْنَ  1 - (  7179  ) -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  بُدَيْلِ بْنِ مَيْسَرَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنْ  رَجُلٍ مِنْ بَلْقَيْنَ قَالَ :  أَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ  بِوَادِي الْقُرَى  ، فَقُلْتُ : يَا رَسُولَ اللهِ بِمَ أُمِرْتَ ؟ قَالَ :  أُمِرْتُ أَنْ تَعْبُدُوا اللهَ لَا تُشْرِكُوا بِهِ شَيْئًا  ، وَأَنْ تُقِيمُوا الصَّلَاةَ ، وَتُؤْتُوا الزَّكَاةَ "" .         [13/132]      قُلْتُ : يَا رَسُولَ اللهِ ! مَنْ هَؤُلَاءِ ؟ فَقَالَ : "" الْمَغْضُوبُ عَلَيْهِمْ ، يَعْنِي : الْيَهُودَ "" ، فَقُلْتُ : مَنْ هَؤُلَاءِ ؟ قَالَ : "" الضَّالِّينَ "" ، يَعْنِي : النَّصَارَى . قُلْتُ : فَلِمَنِ الْمَغْنَمُ يَا رَسُولَ اللهِ ؟ قَالَ : "" لِلهِ - عَزَّ وَجَلَّ -  سَهْمٌ  ، وَلِهَؤُلَاءِ أَرْبَعَةُ أَسْهُمٍ "" قَالَ : قُلْتُ : فَهَلْ أَحَدٌ أَحَقُّ بِالْمَغْنَمِ مِنْ أَحَدٍ ؟ قَالَ : "" لَا ، حَتَّى السَّهْمُ يَأْخُذُهُ أَحَدُكُمْ مِنْ جُعْبَتِهِ فَلَيْسَ بِأَحَقَّ بِهِ مِنْ أَحَدٍ  .","","Musnad Abi Ya'la al-Mawsili 7179","","أحد الصحابة عن عبد الله بن شقيق العقيلي عن بديل بن ميسرة العقيلي عن حماد بن سلمة عن عبد الواحد بن غياث عن أبو يعلى الموصلي","حديث رجل من بلقين"
"7184","[13/133]      حَدِيثُ  الْمِسْوَرِ بْنِ مَخْرَمَةَ  1 - (  7180  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَاصِمِ بْنِ عُمَرَ ،  عَنِ  الْمِسْوَرِ بْنِ مَخْرَمَةَ قَالَ :  وَضَعَتْ  سُبَيْعَةُ  بَعْدَ وَفَاةِ زَوْجِهَا بِأَيَّامٍ قَلَائِلَ ، فَأَتَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَاسْتَأْذَنَتْهُ فِي النِّكَاحِ ، فَأَذِنَ لَهَا  .         [13/134]","","Musnad Abi Ya'la al-Mawsili 7180","","المسور بن مخرمة عن عاصم بن عمر بن الخطاب عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أبو معاوية الضرير عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","حديث المسور بن مخرمة"
"7185","2 - (  7181  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ،  حَدَّثَنَا  حَجَّاجُ بْنُ أَبِي مَنِيعٍ الرُّصَافِيُّ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ أَبِي زِيَادٍ ،  عَنِ  الزُّهْرِيِّ أَنَّ عَلِيَّ بْنَ حُسَيْنٍ  أَخْبَرَهُ  أَنَّ الْمِسْوَرَ بْنَ مَخْرَمَةَ  أَخْبَرَهُ  أَنَّ  عَلِيًّا  خَطَبَ ابْنَةَ  أَبِي جَهْلٍ  ، فَبَلَغَ ذَلِكَ  فَاطِمَةَ  ، فَأَتَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ : إِنَّ النَّاسَ يَزْعُمُونَ أَنَّكَ لَا تَغْضَبُ لِبَنَاتِكَ ، وَهَذَا  عَلِيٌّ  نَاكِحٌ ابْنَةَ  أَبِي جَهْلٍ  ، قَالَ  الْمِسْوَرُ  : فَشَهِدْتُهُ حِينَ تَشَهَّدَ ، فَحَمِدَ اللهَ ، وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ :  أَمَّا بَعْدُ : فَإِنِّي أَنْكَحْتُ  أَبَا الْعَاصِ  ابْنَتِي ، فَحَدَّثَنِي فَصَدَقَنِي ، وَإِنَّمَا  فَاطِمَةُ  بَضْعَةٌ  مِنِّي  ، وَإِنَّهَا وَاللهِ لَا تُجْمَعُ عِنْدَ رَجُلٍ مُسْلِمٍ ابْنَةُ رَسُولِ اللهِ وَابْنَةُ عَدُوِّ اللهِ أَبَدًا "" فَأَمْسَكَ  عَلِيٌّ  عَنِ الْخِطْبَةِ  .         [13/135]             [13/136]             [13/137]","","Musnad Abi Ya'la al-Mawsili 7181","","المسور بن مخرمة عن علي بن الحسين زين العابدين عن الزهري عن عبيد الله بن أبي زياد الرصافي عن حجاج بن يوسف الرصافي عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","حديث المسور بن مخرمة"
"7186","1 - (  7182  ) -  حَدَّثَنَا  الدَّوْرَقِيُّ أَبُو عَبْدِ اللهِ أَحْمَدُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  مُبَشِّرٌ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنِ  الزُّهْرِيِّ ، أُرَاهُ قَالَ :  أَخْبَرَنِي  عَلِيُّ بْنُ حُسَيْنٍ  أَنَّ  ابْنَ عَبَّاسٍ قَالَ :  أَخْبَرَنِي  رَجُلٌ مِنْ أَصْحَابِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ  الْأَنْصَارِ  أَنَّهُمْ بَيْنَمَا هُمْ جُلُوسٌ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذْ رُمِيَ بِنَجْمٍ فَاسْتَنَارَ ، فَقَالَ لَهُمْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" مَا كُنْتُمْ تَقُولُونَ فِي الْجَاهِلِيَّةِ إِذَا رُمِيَ بِمِثْلِ هَذَا ؟ قَالُوا : اللهُ وَرَسُولُهُ أَعْلَمُ ، قَالُوا : كُنَّا نَقُولُ : وُلِدَ اللَّيْلَةَ رَجُلٌ عَظِيمٌ ، وَمَاتَ اللَّيْلَةَ رَجُلٌ عَظِيمٌ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  فَإِنَّهَا لَا يُرْمَى بِهَا لِمَوْتِ أَحَدٍ ، وَلَا لِحَيَاتِهِ ، وَلَكِنَّ رَبَّنَا - عَزَّ وَجَلَّ - إِذَا قَضَى أَمْرًا يُسَبِّحُ حَمَلَةُ الْعَرْشِ  ، ثُمَّ يُسَبِّحُ أَهْلُ السَّمَاءِ الَّذِينَ يَلُونَهُمْ ، حَتَّى يَبْلُغَ التَّسْبِيحُ أَهْلَ السَّمَاءِ الَّذِينَ يَلُونَهُمْ ، ثُمَّ قَالُوا لِلَّذِينَ يَلُونَهُمْ : حَمَلَةَ الْعَرْشِ ، مَاذَا قَالَ رَبُّكُمْ ؟ فَيُخْبِرُونَهُمْ ، وَيَسْتَخْبِرُ أَهْلُ السَّمَاوَاتِ بَعْضُهُمْ بَعْضًا حَتَّى يَبْلُغَ الْخَبَرُ أَهْلَ السَّمَاءِ الدُّنْيَا ،  فَيَخْطَفُ  الْجِنُّ السَّمْعَ ، فَيُلْقُونَهُ إِلَى أَوْلِيَائِهِمْ ، وَيُرْمَوْنَ ، فَمَا جَاؤُوا بِهِ عَلَى وَجْهِهِ فَهُوَ حَقٌّ ، وَلَكِنَّهُمْ  يَقْرِفُونَ مَعَهُ ، أَوْ يَزِيدُونَ  ""  الشَّكُّ مِنْ  مُبَشِّرٍ  .","","Musnad Abi Ya'la al-Mawsili 7182","","أحد الصحابة عن عبد الله بن عباس عن علي بن الحسين زين العابدين عن الزهري عن أبو عمرو الأوزاعي عن مبشر بن إسماعيل الحلبي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","حديث المسور بن مخرمة"
"7187","[13/138]      حَدِيثُ  خَالِدِ بْنِ الْوَلِيدِ  1 - (  7183  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ أَبُو الْحَارِثِ ،  حَدَّثَنَا         [13/139]      هُشَيْمٌ ،  عَنْ  عَبْدِ الْحَمِيدِ بْنِ جَعْفَرٍ ،  عَنْ  أَبِيهِ  قَالَ :  قَالَ  خَالِدُ بْنُ الْوَلِيدِ :  اعْتَمَرْنَا مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي عُمْرَةٍ اعْتَمَرَهَا ، فَحَلَقَ شَعَرَهُ  ، فَاسْتَبَقَ النَّاسُ إِلَى شَعَرِهِ ، فَسَبَقْتُ إِلَى النَّاصِيَةِ فَأَخَذْتُهَا ، فَاتَّخَذْتُ قَلَنْسُوَةً فَجَعَلْتُهَا فِي مُقَدِّمَةِ الْقَلَنْسُوَةِ ، فَمَا وُجِّهْتُ فِي وَجْهٍ إِلَّا فُتِحَ لِي  .","","Musnad Abi Ya'la al-Mawsili 7183","","خالد بن الوليد بن المغيرة عن جعفر بن عبد الله بن الحكم الأوسي عن عبد الحميد بن جعفر الأوسي عن هشيم بن بشير عن سريج بن يونس المروزي عن أبو يعلى الموصلي","حديث خالد بن الوليد"
"7188","2 - (  7184  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ         [13/140]      مُسْلِمٍ ،  عَنْ  شَيْبَةَ بْنِ الْأَحْنَفِ ،  سَمِعَ  أَبَا سَلَّامٍ الْأَسْوَدَ ، يَقُولُ :  أَخْبَرَنِي  أَبُو صَالِحٍ الْأَشْعَرِيُّ أَنَّ أَبَا عَبْدِ اللهِ الْأَشْعَرِيَّ  حَدَّثَهُ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَصُرَ  بِرَجُلٍ  يُصَلِّي لَا يُتِمُّ رُكُوعَهُ وَلَا سُجُودَهُ ، فَقَالَ :  لَوْ مَاتَ هَذَا عَلَى مَا هُوَ عَلَيْهِ ، لَمَاتَ عَلَى غَيْرِ مِلَّةِ  مُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَتِمُّوا الرُّكُوعَ وَالسُّجُودَ  ، فَإِنَّ مَثَلَ الَّذِي لَا يُتِمُّ رُكُوعَهُ وَلَا سُجُودَهُ مَثَلُ الْجَائِعِ لَا يَأْكُلُ إِلَّا التَّمْرَةَ وَالتَّمْرَتَيْنِ ، لَا تُغْنِيَانِ عَنْهُ شَيْئًا  قَالَ  أَبُو صَالِحٍ  : فَلَقِيتُ  أَبَا عَبْدِ اللهِ  ، فَقُلْتُ : مَنْ حَدَّثَكَ هَذَا الْحَدِيثَ أَنَّهُ سَمِعَهُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ :  حَدَّثَنِي  أُمَرَاءُ  الْأَجْنَادِ  : خَالِدُ بْنُ الْوَلِيدِ ، وَشُرَحْبِيلُ بْنُ حَسَنَةَ ، وَعَمْرُو بْنُ الْعَاصِ أَنَّهُمْ سَمِعُوهُ مِنَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .         [13/141]","","Musnad Abi Ya'la al-Mawsili 7184","","عمرو بن العاص بن وائل السهمي عن أبو عبدالله الأشعري عن أبو صالح الأشعري عن ممطور الحبشي عن شيبة بن الأحنف الأوازعي عن الوليد بن مسلم القرشي عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","حديث خالد بن الوليد"
"7189","3 - (  7185  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  يَحْيَى بْنُ زَكَرِيَّا ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  قَالَ  خَالِدُ بْنُ الْوَلِيدِ :  مَا لَيْلَةٌ تُهْدَى إِلَى بَيْتِي فِيهَا عَرُوسٌ أَنَا لَهَا مُحِبٌّ  ، أَوْ أُبَشَّرُ فِيهَا بِغُلَامٍ بِأَحَبَّ إِلَيَّ مِنْ لَيْلَةٍ شَدِيدَةِ  الْجَلِيدِ  فِي سَرِيَّةٍ مِنَ  الْمُهَاجِرِينَ  أُصَبِّحُ بِهَا الْعَدُوَّ  .","","Musnad Abi Ya'la al-Mawsili 7185","","خالد بن الوليد بن المغيرة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى بن زكريا بن أبي زائدة عن سريج بن يونس المروزي عن أبو يعلى الموصلي","حديث خالد بن الوليد"
"7190","4 - (  7186  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  يَحْيَى بْنُ زَكَرِيَّا ،  عَنْ  يُونُسَ بْنِ أَبِي إِسْحَاقَ ،  عَنْ  أَبِي السَّفَرِ  قَالَ  :  نَزَلَ خَالِدُ بْنُ الْوَلِيدِ  الْحِيرَةَ  عَلَى أَمْرِ  بَنِي الْمَرَازِبَةِ  فَقَالُوا لَهُ : احْذَرِ السُّمَّ لَا يَسْقِيكَهُ الْأَعَاجِمُ فَقَالَ :  ائْتُونِي بِهِ فَأُتِيَ بِهِ فَأَخَذَهُ بِيَدِهِ ، ثُمَّ اقْتَحَمَهُ وَقَالَ : بِاسْمِ اللهِ فَلَمْ يَضُرَّهُ شَيْئًا  .         [13/142]","","Musnad Abi Ya'la al-Mawsili 7186","","خالد بن الوليد بن المغيرة عن سعيد بن يحمد الهمداني عن يونس بن أبي إسحاق عن يحيى بن زكريا بن أبي زائدة عن سريج بن يونس المروزي عن أبو يعلى الموصلي","حديث خالد بن الوليد"
"7191","5 - (  7187  ) -  حَدَّثَنَا  سُرَيْجٌ ،  حَدَّثَنَا  يَحْيَى بْنُ زَكَرِيَّا ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ قَالَ :  سَمِعْتُ  خَالِدَ بْنَ الْوَلِيدِ يُحَدِّثُ  الْقَوْمَ  فِي  الْجَرِيدَةِ  قَالَ :  لَقَدْ رَأَيْتُنِي  يَوْمَ مُؤْتَةَ  انْدَقَّ بِيَدَيَّ تِسْعَةُ أَسْيَافٍ ، وَصَبَرَتْ مَعِي صَفِيحَةٌ لِي يَمَانِيَةٌ  .         [13/143]","","Musnad Abi Ya'la al-Mawsili 7187","","خالد بن الوليد بن المغيرة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى بن زكريا بن أبي زائدة عن سريج بن النعمان الجوهري عن أبو يعلى الموصلي","حديث خالد بن الوليد"
"7192","6 - (  7188  ) -  حَدَّثَنَا  سُرَيْجٌ ،  حَدَّثَنَا  يَحْيَى ، قَالَ :  حَدَّثَنِي  إِسْمَاعِيلُ ،  عَنْ  قَيْسٍ قَالَ :  قَالَ  خَالِدُ بْنُ الْوَلِيدِ  :  لَقَدْ مَنَعَنِي كَثِيرًا مِنَ الْقِرَاءَةِ  الْجِهَادُ  فِي  سَبِيلِ  اللهِ  .","","Musnad Abi Ya'la al-Mawsili 7188","","خالد بن الوليد بن المغيرة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى القطان عن سريج بن يونس المروزي عن أبو يعلى الموصلي","حديث خالد بن الوليد"
"7193","6 - (  7188  ) - مُكَرَّرٌ ـ  وَبِهِ  عَنْ  قَيْسٍ قَالَ : أُخْبِرْتُ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا  تَسُبُّوا  خَالِدًا  ، فَإِنَّهُ سَيْفٌ مِنْ سُيُوفِ اللهِ  ، سَلَّهُ اللهُ عَلَى الْكُفَّارِ  "" .         [13/144]             [13/145]","","Musnad Abi Ya'la al-Mawsili 7188","","قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى بن زكريا بن أبي زائدة عن سريج بن يونس المروزي عن أبو يعلى الموصلي","حديث خالد بن الوليد"
"7194","7 - (  7189  ) -  حَدَّثَنَا  أَبُو الْحَارِثِ ،  حَدَّثَنَا  يَحْيَى ، قَالَ :  حَدَّثَنِي  إِسْمَاعِيلُ ،  عَنْ  قَيْسٍ ، قَالَ :  رَأَيْتُ  خَالِدَ بْنَ الْوَلِيدِ يَؤُمُّ النَّاسَ فِي الْجَيْشِ فِي ثَوْبٍ وَاحِدٍ  .         [13/146]","","Musnad Abi Ya'la al-Mawsili 7189","","خالد بن الوليد بن المغيرة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى القطان عن سريج بن يونس المروزي عن أبو يعلى الموصلي","حديث خالد بن الوليد"
"7195","8 - (  7190  ) -  حَدَّثَنَا  أَبُو الْحَارِثِ سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  حَدَّثَنَا  مُجَالِدٌ ،  عَنْ  عَامِرٍ قَالَ :  لَمَّا قُبِضَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَارْتَدَّ مَنِ ارْتَدَّ مِنَ النَّاسِ قَالَ قَوْمٌ : نُصَلِّي وَلَا نُعْطِي الزَّكَاةَ . فَقَالَ النَّاسُ لِأَبِي بَكْرٍ : اقْبَلْ مِنْهُمْ ،  فَقَالَ  :  لَوْ مَنَعُونِي  عَنَاقًا  لَقَاتَلْتُهُمْ  ، فَبَعَثَ  خَالِدَ بْنَ الْوَلِيدِ  وَقَدِمَ  عَدِيُّ بْنُ حَاتِمٍ  بِأَلْفِ رَجُلٍ مِنْ  طَيِّئٍ  حَتَّى أَتَى  الْيَمَامَةَ  قَالَ : وَكَانَتْ  بَنُو عَامِرٍ  قَدْ قَتَلُوا عُمَّالَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَحْرَقُوهُمْ بِالنَّارِ . فَكَتَبَ  أَبُو بَكْرٍ  إِلَى  خَالِدٍ  أَنِ اقْتُلْ  بَنِي عَامِرٍ  وَأَحْرِقْهُمْ  بِالنَّارِ فَفَعَلَ حَتَّى صَاحَتِ النِّسَاءُ ، ثُمَّ مَضَى ، حَتَّى انْتَهَى إِلَى الْمَاءِ ، خَرَجُوا إِلَيْهِ فَقَالُوا : اللهُ أَكْبَرُ ، اللهُ أَكْبَرُ ، نَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، نَشْهَدُ أَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، فَإِذَا سَمِعَ ذَلِكَ كَفَّ عَنْهُمْ فَأَمَرَهُ  أَبُو بَكْرٍ  أَنْ يَسِيرَ حَتَّى يَنْزِلَ  الْحِيرَةَ ،  ثُمَّ يَمْضِي إِلَى  الشَّامِ  فَلَمَّا نَزَلَ  بِالْحِيرَةِ  كَتَبَ إِلَى  أَهْلِ فَارِسَ  ، ثُمَّ قَالَ : إِنِّي لَأُحِبُّ أَنْ لَا أَبْرَحَ حَتَّى أُفْزِعَهُمْ فَأَغَارَ عَلَيْهِمْ حَتَّى انْتَهَى إِلَى  سُورَا         [13/147]      فَقَتَلَ وَسَبَى ، ثُمَّ أَغَارَ عَلَى  عَيْنِ التَّمْرِ  فَقَتَلَ وَسَبَى ، ثُمَّ مَضَى إِلَى  الشَّامِ .  قَالَ  عَامِرٌ  : فَأَخْرَجَ إِلَيَّ  ابْنُ بُقَيْلَةَ  كِتَابَ خَالِدٍ :  بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ ، مِنْ  خَالِدِ بْنِ الْوَلِيدِ  إِلَى  مَرَازِبَةِ أَهْلِ فَارِسَ ،  السَّلَامُ عَلَى مَنِ اتَّبَعَ الْهُدَى ، فَإِنِّي أَحْمَدُ اللهَ الَّذِي لَا إِلَهَ إِلَّا هُوَ بِالْحَمْدِ الَّذِي فَصَلَ حُرُمَكُمْ ، وَفَرَّقَ جَمَاعَتَكُمْ ، وَوَهَّنَ بَأْسَكُمْ ، وَسَلَبَ مُلْكَكُمْ ، فَإِذَا جَاءَكُمْ كِتَابِي هَذَا فَاعْتَقِدُوا مِنِّي الذِّمَّةَ ، وَأَدُّوا إِلَيَّ الْجِزْيَةَ ، وَابْعَثُوا إِلَيَّ بِالرُّهُنِ ، وَإِلَّا فَوَالَّذِي لَا إِلَهَ إِلَّا هُوَ لَأَلْقَيَنَّكُمْ بِقَوْمٍ يُحِبُّونَ الْمَوْتَ كَحُبِّكُمُ الْحَيَاةَ .  سَلَامٌ عَلَى مَنِ اتَّبَعَ الْهُدَى  .         [13/148]","","Musnad Abi Ya'la al-Mawsili 7190","","أبو  بكر الصديق عن الشعبي عن مجالد بن سعيد عن يحيى بن زكريا بن أبي زائدة عن سريج بن يونس المروزي عن أبو يعلى الموصلي","حديث خالد بن الوليد"
"7196","9 - (  7191  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ ،  حَدَّثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ قَالَ :  حَدَّثَنِي  صَفْوَانُ . قَالَ :  حَدَّثَنِي  جُبَيْرُ بْنُ نُفَيْرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  خَالِدِ بْنِ الْوَلِيدِ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمْ يُخَمِّسِ السَّلَبَ  .         [13/149]","","Musnad Abi Ya'la al-Mawsili 7191","","خالد بن الوليد بن المغيرة عن نفير بن مالك بن عامر الحضرمي عن جبير بن نفير بن مالك الحضرمي عن صفوان بن عمرو السكسكي عن بقية بن الوليد عن الوليد بن شجاع عن أبو يعلى الموصلي","حديث خالد بن الوليد"
"7197","10 - (  7192  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ قَالَ :  حَدَّثَنِي  إِسْمَاعِيلُ ،  عَنْ  صَفْوَانَ بْنِ عَمْرٍو ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ جُبَيْرِ بْنِ نُفَيْرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  خَالِدِ بْنِ الْوَلِيدِ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمْ يُخَمِّسِ السَّلَبَ  .","","Musnad Abi Ya'la al-Mawsili 7192","","خالد بن الوليد بن المغيرة عن جبير بن نفير بن مالك الحضرمي عن عبد الرحمن بن جبير الحضرمي عن صفوان بن عمرو السكسكي عن إسماعيل بن عياش الأحول عن الوليد بن شجاع عن أبو يعلى الموصلي","حديث خالد بن الوليد"
"7198","[13/150]      حَدِيثُ  عَامِرِ بْنِ رَبِيعَةَ  1 - (  7193  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ سَهْمٍ الْأَنْطَاكِيُّ ،  أَخْبَرَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  أَخْبَرَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  عَاصِمِ بْنِ عُبَيْدِ اللهِ بْنِ عَاصِمِ بْنِ عُمَرَ بْنِ الْخَطَّابِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَسْتَاكُ وَهُوَ صَائِمٌ  -  مَا لَا أَعُدُّ - أَوْ قَالَ : مَا لَا أُحْصِي  .         [13/151]","","Musnad Abi Ya'la al-Mawsili 7193","","عامر بن ربيعة بن كعب العنزي عن عبد الله بن عامر بن ربيعة العنزي عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن سفيان الثوري عن عبد الله بن المبارك عن محمد بن عبد الرحمن بن حكيم الأنطاكي عن أبو يعلى الموصلي","حديث عامر بن ربيعة"
"7199","2 - (  7194  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْجُشَمِيُّ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ، وَعَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  شُعْبَةَ ،  عَنْ  عَاصِمِ بْنِ عُبَيْدِ اللهِ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَامِرِ بْنِ رَبِيعَةَ  يُحَدِّثُ         [13/152]      عَنْ  أَبِيهِ  أَنَّ  امْرَأَةً مِنْ بَنِي فَزَارَةَ  تَزَوَّجَتْ  رَجُلًا  عَلَى نَعْلَيْنِ ، فَقَالَ لَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي حَدِيثِ  يَحْيَى  :  أَرَضِيتِ مِنْ نَفْسِكِ وَمَالِكِ بِهَذَيْنِ النَّعْلَيْنِ ؟  وَفِي حَدِيثِ  عَبْدِ الرَّحْمَنِ  : "" أَرَضِيتِ مِنْ نَفْسِهِ وَمَالِهِ بِنَعْلَيْنِ ؟ "" قَالَتْ : نَعَمْ ، فَأَجَازَهُ  .","","Musnad Abi Ya'la al-Mawsili 7194","","عامر بن ربيعة بن كعب العنزي عن عبد الله بن عامر بن ربيعة العنزي عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن شعبة بن الحجاج عن عبد الرحمن بن مهدي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","حديث عامر بن ربيعة"
"7200","3 - (  7195  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  حَدَّثَنَا  عَمَّارُ بْنُ رُزَيْقٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عِيسَى ،  عَنْ  أُمَيَّةَ بْنِ هِنْدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ ،  عَنْ  أَبِيهِ  قَالَ :  انْطَلَقْتُ أَنَا  وَسَهْلُ بْنُ حُنَيْفٍ  نَلْتَمِسُ  الْخَمَرَ  ، فَوَجَدْنَا  خَمَرًا  وَغَدِيرًا ، وَكَانَ أَحَدُنَا يَسْتَحْيِي أَنْ يَغْتَسِلَ وَأَحَدٌ يَرَاهُ ،         [13/153]      فَاسْتَتَرَ مِنِّي ، فَنَزَعَ جُبَّةً عَلَيْهِ ، ثُمَّ دَخَلَ الْمَاءَ ، فَنَظَرْتُ إِلَيْهِ ، فَأَصَبْتُهُ مِنْهَا بِعَيْنٍ ، فَدَعَوْتُهُ ، فَلَمْ يُجِبْنِي ، فَأَخْبَرْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَتَاهُ ، فَضَرَبَ صَدْرَهُ ، ثُمَّ قَالَ : "" اللَّهُمَّ ، أَذْهِبْ حَرَّهَا وَبَرْدَهَا ، وَوَصَبَهَا "" ، ثُمَّ قَالَ : "" قُمْ "" ، فَقَامَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا رَأَى أَحَدُكُمْ مِنْ نَفْسِهِ ، أَوْ مَالِهِ ، أَوْ أَخِيهِ مَا يُعْجِبُهُ ، فَلْيَدْعُ بِالْبَرَكَةِ ، فَإِنَّ  الْعَيْنَ  حَقٌّ  .         [13/154]","","Musnad Abi Ya'la al-Mawsili 7195","","عامر بن ربيعة بن كعب العنزي عن عبد الله بن عامر بن ربيعة العنزي عن أمية بن هند المزني عن عبد الله بن عيسى بن عبد الرحمن بن أبي ليلى عن عمار بن رزيق الضبي عن معاوية بن هشام القصار عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث عامر بن ربيعة"
