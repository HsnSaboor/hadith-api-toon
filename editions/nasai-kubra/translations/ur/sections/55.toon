hadiths[165]{hadithnumber,text}:
"8911","ہم سے عباس بن عبدالعظیم نے بیان کیا، انہوں نے کہا کہ مجھ سے خالد بن مخلد نے بیان کیا، انہوں نے کہا کہ مجھ سے سلیمان بن بلال نے بیان کیا، انہوں نے کہا کہ مجھ سے سہیل نے اپنے والد سے اور ابوہریرہ رضی اللہ عنہ سے روایت کی کہ رسول اللہ صلی اللہ علیہ وسلم نے کپڑا پہننے والی عورتوں پر لعنت فرمائی ہے۔ \آدمی\"""""""""
"8912","ہم سے اسحاق بن منصور نے بیان کیا، انہوں نے کہا: میں الندر بن شمائل، عبد الصمد، وہب اور ابوداؤد ہوں۔ انہوں نے کہا: ہم ہشام ہیں، یحییٰ کی سند سے، عکرمہ کی سند سے، ابن عباس کی سند سے، کہ رسول اللہ صلی اللہ علیہ وسلم نے حشرات پر لعنت فرمائی اور فرمایا: انہیں اپنے گھروں سے نکال دو۔ پھر رسول اللہ صلی اللہ علیہ وسلم نے فلاں کو نکالا اور عمر رضی اللہ عنہ نے فلاں کو نکالا۔"
"8913","ہم سے عمرو بن علی نے بیان کیا، کہا ہم سے یحییٰ بن سعید نے بیان کیا، انہوں نے کہا: ہم سے عبدالملک بن ابی سلیمان نے بیان کیا، انہوں نے کہا کہ ہم سے عطاء نے بیان کیا، جابر رضی اللہ عنہ سے، انہوں نے کہا: میں نے رسول اللہ صلی اللہ علیہ وسلم کے ساتھ عید کے دن نماز پڑھی۔ اس نے خطبہ سے پہلے اذان یا اقامت کے بغیر دعا شروع کی۔ جب آپ صلی اللہ علیہ وسلم نماز سے فارغ ہوئے، کھڑے ہوئے، بلال رضی اللہ عنہ کی طرف ٹیک لگائے، اللہ کا شکر ادا کیا اور اس کی حمد و ثنا کی، لوگوں کو نصیحت کی، انہیں نصیحت کی اور ان کی اطاعت کی تلقین کی، پھر آپ صلی اللہ علیہ وسلم چلے گئے۔ عورتوں کی طرف، اور بلال رضی اللہ عنہ اس کے ساتھ تھے۔ آپ صلی اللہ علیہ وسلم نے انہیں خدا سے ڈرنے کا حکم دیا، انہیں نصیحت کی، انہیں نصیحت کی، اور خدا کی حمد و ثنا کی، پھر ان کو اس کی طرف ترغیب دی، اس نے اس کی اطاعت کی، پھر فرمایا: ”صدقہ کرو، کیونکہ تم میں سے اکثر جہنم کی لکڑیاں ہیں۔ پھر سنہرے بالوں والی عورتوں میں سے ایک نے کہا: کیوں، اے؟ خدا کے رسول؟ اس نے کہا: آپ بہت لعنت بھیجتے ہو اور اپنے گھر والوں کے ناشکرے ہو۔ چنانچہ انہوں نے اپنے زیورات، ہار، بالیاں اور انگوٹھیاں اتار کر بلال رضی اللہ عنہ کے لباس میں ڈال دیں، جو وہ صدقہ کرتے ہیں۔"
"8914","ہم سے محمد بن بشار نے بیان کیا، انہوں نے فرمایا: ہم سے محمد نے بیان کیا، انہوں نے فرمایا: ہم سے شعبہ نے بیان کیا، انہوں نے الحکم کی سند سے، انہوں نے کہا: میں نے ذر کو وائل بن مہانہ سے، انہوں نے ابن مسعود رضی اللہ عنہ سے، انہوں نے نبی کریم صلی اللہ علیہ وسلم سے سنا، آپ صلی اللہ علیہ وسلم نے فرمایا: آپ لوگوں کے لیے صدقہ کرنے والی عورتوں کی بڑی تعداد ہو گی۔ ایک عورت نے کہا: یا رسول اللہ، کیوں، یا کیوں؟ آپ صلی اللہ علیہ وسلم نے فرمایا: ”بے شک آپ کثرت سے لعنت بھیجتے ہو اور اپنی بیوی کی ناشکری کرتے ہو۔"
"8915","ہم سے محمد بن منصور نے بیان کیا، انہوں نے فرمایا کہ ہم سے سفیان نے بیان کیا، انہوں نے کہا: ہم نے اسے منصور سے محفوظ کیا، انہوں نے ذر سے سنا، انہوں نے وائل بن مہانہ سے روایت کی، انہوں نے عبداللہ رضی اللہ عنہ سے روایت کی، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ” صدقہ کرو، اے عورتیں، اگرچہ تمہارے لیے آگ کے زیورات میں سے کچھ زیادہ ہی کیوں نہ ہو۔ پھر ایک عورت جو خواتین کے طبقے سے نہیں تھی کہنے لگی: یا رسول اللہ ایسا کیوں ہے؟ اس نے فرمایا: \کیونکہ آپ کثرت سے لعنت بھیجتے ہو اور اپنی شریک حیات کی ناشکری کرتے ہو۔\"""""""""
"8916","ہم سے الفضل بن سہل نے بیان کیا، انہوں نے کہا: ہم سے داؤد بن عمرو نے بیان کیا، انہوں نے کہا: ہم سے منصور بن ابی الاسود نے بیان کیا، انہوں نے الاعمش سے، انہوں نے ذر سے، حسن رضی اللہ عنہ سے وائل بن مہانہ نے، انہوں نے کہا: عبداللہ رضی اللہ عنہ نے کہا: اے خواتین صدقہ کرو۔ اس نے بھی ایسا ہی کیا لیکن اس نے اسے نہیں اٹھایا"
"8917","ہم سے قتیبہ بن سعید نے بیان کیا، انہوں نے کہا: ہم غندر ہیں، عوف کی سند سے، انہوں نے ابو راجہ سے، انہوں نے عمران رضی اللہ عنہ سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”میں نے جہنم میں جھانکا تو دیکھا کہ اس کے اکثر لوگ عورتیں ہیں، اور میں نے جنت میں جھانک کر دیکھا تو اس کے اکثر لوگ غریب تھے۔"
"8918","ہم سے بشر بن ہلال اور عمران بن موسیٰ نے بیان کیا، انہوں نے کہا کہ ہم سے عبدالوارث نے بیان کیا، انہوں نے کہا کہ ہم سے ایوب نے ابو راجہ عطاریدی سے، انہوں نے عمران بن حصین رضی اللہ عنہ سے بیان کیا کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”میں نے جنت میں جھانک کر دیکھا، تو میں نے اس کے اکثر لوگوں کو دیکھا اور اس کے اکثر غریبوں کو دیکھا۔ یہاں کے باشندے خواتین تھیں۔\"" 8919"""""""
"8919","اسحاق بن ابراہیم نے ہمیں بتایا، انہوں نے کہا: عبدالوہاب نے بتایا، ایوب نے، ابو رجاء عطاردی نے، ابن عباس نے، کہ اللہ کے رسول ﷺ نے فرمایا: ""میں نے جنت میں جھانکا، تو دیکھا کہ اس کے اکثر لوگ غریب ہیں، اور جہنم میں جھانکا، تو دیکھا کہ اس کے اکثر لوگ عورتیں ہیں۔"""""""
"8920","ابو داؤد نے ہمیں بتایا، انہوں نے کہا: جعفر (یعنی ابن عون) نے ہمیں بتایا، انہوں نے کہا: سعید نے ہمیں بتایا، انہوں نے کہا: میں نے ابو رجاء کو حدیث سناتے سنا، انہوں نے کہا: ابن عباس نے ہمیں بتایا، کہ رسول اللہ ﷺ نے فرمایا: ""میں نے جہنم میں جھانکا، تو دیکھا کہ اس کے اکثر لوگ عورتیں ہیں، اور جنت میں جھانکا، تو دیکھا کہ اس کے اکثر لوگ مساکین ہیں۔"" یحیی بن مخلد نے ہمیں بتایا، انہوں نے کہا: معافی نے ہمیں بتایا، صخر بن جویریہ نے، انہوں نے کہا: میں نے ابو رجاء عطاردی کو ابن عباس سے سنایا۔"
"8921","اور ہم سے محمد بن معمر نے بیان کیا، انہوں نے کہا کہ ہم سے عثمان بن عمر نے بیان کیا، انہوں نے کہا: ہم سے حماد بن نجیح نے ابوراجہ سے، انہوں نے ابن عباس رضی اللہ عنہما سے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: میں نے جنت میں جھانکا تو دیکھا کہ اس کے اکثر لوگ کمزور ہیں، اور یحییٰ نے کہا: اور میں نے جہنم میں دیکھا۔ پھر میں نے دیکھا کہ اس کے باشندوں میں زیادہ تر عورتیں تھیں۔"
"8922","ہم سے قتیبہ بن سعید نے بیان کیا، انہوں نے کہا: خالد، سلیمان تیمی سے، ابو عثمان سے اسامہ بن زید رضی اللہ عنہ سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”میں نے جنت کی طرف جھانکا تو دیکھا کہ اس کے بہت سے لوگ محنت کش اور غریب تھے۔ جہنم کی طرف دیکھا تو اس کے باشندوں کی اکثریت عورتوں کی ہے۔"
"8923","ہم سے نصیر بن الفراج نے بیان کیا، انہوں نے کہا کہ ہم سے معاذ بن ہشام نے بیان کیا، انہوں نے کہا: مجھ سے میرے والد نے قتادہ سے، وہ یزید بن عبداللہ بن الشخیر سے، انہوں نے عمران بن حصین رضی اللہ عنہ سے بیان کیا، انہوں نے کہا: میں نے رسول اللہ صلی اللہ علیہ وسلم کو سنا، آپ صلی اللہ علیہ وسلم اکثر لوگوں کی عورتوں کو کہتے ہیں:"
"8924","ہم کو محمد بن ولید نے خبر دی، انہوں نے فرمایا: ہم کو محمد بن جعفر نے خبر دی، انہوں نے فرمایا: ہمیں شعبہ نے خبر دی، انہوں نے ابو الطیہ سے، انہوں نے کہا: میں نے مطرف بن الشخیر رضی اللہ عنہ سے سنا، وہ عمران بن حصین رضی اللہ عنہ سے روایت کرتے ہیں، انہوں نے کہا: اللہ تعالیٰ نے کہا: جنتی عورتوں میں سے بہت کم ہیں۔ (صلی اللہ علیہ وآلہ وسلم)"
"8925","ہم سے ابوداؤد نے بیان کیا، انہوں نے کہا: ہم سے سلیمان بن حرب نے بیان کیا، کہا کہ ہم سے حماد بن سلمہ نے بیان کیا، انہوں نے کہا: ہم سے ابو جعفر الخطمی نے بیان کیا، ان سے عمارہ بن خزیمہ بن ثابت نے کہا: ہم عمرو بن العاص رضی اللہ عنہ کے ساتھ حج یا عمرہ پر تھے، اور جب ہم اس کے پاس سے گزر رہے تھے تو ایک عورت نے اس کا ہاتھ پکڑ کر دیکھا، تو وہ اس کے ہاتھ میں تھی۔ ہاودہ جب وہ اترا تو لوگ داخل ہوئے اور ہم بھی اس کے ساتھ داخل ہوئے۔ انہوں نے کہا: ہم رسول اللہ صلی اللہ علیہ وسلم کے ساتھ تھے۔ اس نے ہمیں اس جگہ سلام کیا، اور دیکھو، ہم نے بہت سے کوے دیکھے، جن میں سے ایک بہرا کوا تھا جس کی چونچ اور پاؤں تھے۔ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: اللہ تعالیٰ آپ پر رحمت نازل فرمائے: کوئی عورت جنت میں نہیں جائے گی سوائے اس کوے کی تعداد کے ان کووں کے ساتھ۔"
"8926","ہم سے محمد بن بشار نے بیان کیا، انہوں نے فرمایا: ہم کو محمد نے خبر دی، انہوں نے فرمایا: ہم سے شعبہ نے بیان کیا، انہوں نے ابو مسلمہ رضی اللہ عنہ سے، انہوں نے کہا: میں نے ابو نضرہ رضی اللہ عنہ کو ابو سعید رضی اللہ عنہ سے روایت کرتے ہوئے سنا، انہوں نے نبی اکرم صلی اللہ علیہ وسلم سے روایت کی، آپ صلی اللہ علیہ وسلم نے فرمایا: ”دنیا سرسبز و شاداب ہے، اور اللہ تمہارا جانشین ہے، اس میں تم عورتوں سے ڈرو، اس لیے تم سب سے پہلے دنیا کو دیکھو کہ تم کس قدر ڈرو۔ بنی اسرائیل کا فتنہ عورتوں کے ساتھ تھا۔\"" 8927"""""""
"8927","عمرو بن علی نے ہمیں بتایا، انہوں نے کہا: یزید بن زریع اور یحیی بن سعید نے ہمیں بتایا، انہوں نے کہا: سلیمان تیمی نے ہمیں بتایا، ابو عثمان نے، اسامہ بن زید نے، کہ رسول اللہ ﷺ نے فرمایا: ""میں نے لوگوں میں اپنے بعد کوئی فتنا مردوں کے لئے عورتیں سے زیادہ نقصان دہ نہیں چھوڑا۔"""""""
"8928","ہم سے علی بن حجر نے بیان کیا، انہوں نے کہا: ہم سے اسماعیل نے بیان کیا، انہوں نے کہا: ہم سے عمرو بن ابی عمرو نے ابو سعید مقبری سے، انہوں نے ابوہریرہ رضی اللہ عنہ سے بیان کیا کہ نبی کریم صلی اللہ علیہ وسلم ایک دن صبح کو نکلے اور مسجد میں عورتوں کے پاس تشریف لے گئے اور کہا: میں نے کبھی ان کے ذہنوں میں ایسی عیب نہیں دیکھی اور نہ ہی ان کے بارے میں کہا۔ اور دین، تم میں سے عقل والوں کے دلوں کی پیروی کرو۔ جہاں تک آپ کے دین میں کمی کا تعلق ہے: حیض جو آپ کو تکلیف دیتا ہے، آپ میں سے ایک اسے جاری رکھے گا، جیسا کہ اللہ چاہے گا۔ اگر تم خاموش رہو، نہ نماز پڑھو، نہ روزہ رکھو، یہ تمہارے دین کی کمی ہے۔ جہاں تک تمہاری عقل کی کمی کا تعلق ہے تو تمہاری گواہی عورت کی گواہی سے آدھی ہے۔ \گواہی۔\"" مختصر"""""""
"8929","ہم سے صفوان بن عمرو نے بیان کیا، انہوں نے کہا: ہم انسان ہیں، انہوں نے کہا: مجھ سے میرے والد نے بیان کیا، وہ زہری کی سند سے، انہوں نے کہا: مجھ سے حمزہ بن عبداللہ بن عمر رضی اللہ عنہما نے بیان کیا، انہوں نے عبداللہ بن عمر رضی اللہ عنہما سے روایت کی، انہوں نے کہا: جب رسول اللہ صلی اللہ علیہ وسلم نے اپنی وفات کے وقت کی شکایت کی آپ آپ صلی اللہ علیہ وسلم نے فرمایا: ”لوگوں کو نماز پڑھنے دو۔ ابوبکر۔\ عائشہ رضی اللہ عنہا نے کہا: یا رسول اللہ صلی اللہ علیہ وسلم ابوبکر رضی اللہ عنہ شریف آدمی ہیں اور قرآن پڑھتے وقت اپنے آنسو روک نہیں سکتے، چنانچہ عمر بن خطاب رضی اللہ عنہ نے لوگوں کے لیے دعا کی، آپ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ابوبکر رضی اللہ عنہ لوگوں کو نماز پڑھانے دو۔ عائشہ رضی اللہ عنہا نے ان سے ملاقات کی، تو آپ نے فرمایا: اسے نماز پڑھنے دو۔ ’’لوگوں کے پاس ابوبکر ہیں تو تم یوسف کے ساتھی ہو۔‘‘"""""""
"8930","ہم سے زکریا بن یحییٰ نے بیان کیا، انہوں نے کہا کہ ہم سے اسحاق نے بیان کیا، انہوں نے کہا: میں عبدالرزاق ہوں، انہوں نے کہا: ہم سے معمر نے زہری کی سند سے، حمزہ بن عبداللہ بن عمر رضی اللہ عنہما سے، انہوں نے عائشہ رضی اللہ عنہا سے، انہوں نے کہا: جب رسول اللہ صلی اللہ علیہ وسلم نے ابو بکر رضی اللہ عنہ کو نماز پڑھائی تو میں نے کہا: میں نے لوگوں کو نماز پڑھائی۔ عرض کیا: یا رسول اللہ، ابوبکر ایک شریف آدمی ہیں۔ جب وہ قرآن کی تلاوت کرتا ہے تو اپنے آنسو روک نہیں سکتا۔ اگر آپ ابوبکر کے علاوہ کسی کو حکم دیتے آپ وہ کہتی: میں صرف یہ کر سکتی ہوں۔ لوگ رسول اللہ صلی اللہ علیہ وسلم کے منصب پر فائز ہونے والے پہلے شخص کے بارے میں مایوسی کا شکار ہیں۔ چنانچہ میں نے دو یا تین بار اس سے ملاقات کی، تو اس نے کہا: \جاؤ، ابوبکر نے لوگوں کو نماز پڑھائی، کیونکہ تم یوسف کے ساتھی تھے۔\"""""""""
"8931","مجھ سے محمد بن اسماعیل بن ابراہیم نے بیان کیا، انہوں نے کہا: مجھ سے یزید نے بیان کیا، اس نے کہا: میں حماد ہوں، ابن صخرہ سے، قاسم بن محمد کی روایت سے، عائشہ رضی اللہ عنہا سے، انہوں نے رسول اللہ صلی اللہ علیہ وسلم سے روایت کی، انہوں نے کہا: \عورتوں میں سب سے زیادہ بابرکت وہ ہے جو رزق میں زیادہ ہے۔\"""""""""
"8932","مجھ سے محمد بن جبلہ نے بیان کیا، انہوں نے فرمایا: مجھ سے عبداللہ بن جعفر نے بیان کیا، انہوں نے کہا: مجھ سے عبید اللہ نے اسحاق کی سند سے، زہری کی سند سے، حمزہ بن عبداللہ رضی اللہ عنہ نے اپنے والد سے بیان کیا کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”نحوست تین چیزوں میں پائی جاتی ہے، گھوڑے اور اچھی عورت۔"
"8933","ہم سے ہارون بن سعید نے بیان کیا، انہوں نے کہا کہ مجھ سے خالد بن نزار نے بیان کیا، انہوں نے کہا: مجھ سے القاسم بن مبرور نے بیان کیا، وہ یونس کی سند سے، ابن شہاب نے کہا: حمزہ بن عبداللہ سے، عبداللہ بن عمر رضی اللہ عنہما سے، انہوں نے رسول اللہ صلی اللہ علیہ وسلم سے بیان کیا، انہوں نے کہا: آپ صلی اللہ علیہ وسلم نے فرمایا: ”عورتوں میں گھوڑے کی بدی پائی جاتی ہے۔ \اور گھر\"""""""""
"8934","ہم کو محمد بن مثنیٰ نے خبر دی، انہوں نے فرمایا: مجھے عثمان بن عمر نے خبر دی، انہوں نے کہا: مجھے یونس نے زہری کی سند سے، وہ سالم کی سند سے، ابن عمر رضی اللہ عنہما سے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”کوئی بیماری نہیں ہے، کوئی بیماری نہیں ہے، عورت میں خیانت اور خیانت ہے، تین چیزیں عورت میں پائی جاتی ہیں“۔"
"8935","ہم سے یونس بن عبد العلا نے بیان کیا، انہوں نے کہا: میں ابن وہب ہوں، انہوں نے کہا: مجھ سے یونس اور مالک نے ابن شہاب سے، حمزہ رضی اللہ عنہ سے اور سالم نے ابن عمر رضی اللہ عنہما سے بیان کیا کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”عورتوں میں کوئی بری بیماری نہیں ہوتی، لیکن تین آدمیوں میں کوئی بیماری نہیں ہوتی، لیکن تین آدمیوں میں بیماری نہیں ہوتی۔ گھوڑا اور گھر۔\ ان میں سے ایک لفظ کا اضافہ کرتا ہے۔"""""""
"8936","حارث بن مسکین نے اس کے بارے میں ابن القاسم کی روایت سے پڑھا، انہوں نے کہا: میں مالک ہوں، ابن شہاب کی سند سے، حمزہ کی روایت سے اور سالم کی سند سے، عبداللہ بن عمر کی روایت سے، کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: بد نصیب، گھوڑا اور عورت گھر میں ہے۔"
"8937","ہم سے حسین بن عیسیٰ نے بیان کیا، انہوں نے کہا: ابن ابی فدائک، ابن ابی ذہب کی سند سے، ابن شہاب کی سند سے، محمد بن زید بن قنفود سے، سالم بن عبداللہ رضی اللہ عنہ سے، کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ” پھر میں نے عورت کے بارے میں فرمایا: ” اور میں نے کسی چیز میں یہ کہا: گھوڑا اور تلوار"
"8938","ہم سے محمد بن خالد نے بیان کیا، انہوں نے فرمایا: ہم سے بشر بن شعیب نے بیان کیا، انہوں نے زہری کی سند سے، کہا: مجھ سے سالم نے بیان کیا، وہ عبداللہ بن عمر رضی اللہ عنہما نے، انہوں نے کہا: میں نے رسول اللہ صلی اللہ علیہ وسلم کو فرماتے ہوئے سنا: برائی صرف تین چیزوں میں ہوتی ہے: گھوڑا، عورت اور گھر۔"
"8939","ہمیں قتیبہ بن سعید نے خبر دی، انہوں نے کہا: عبدالواحد نے معمر سے، وہ زہری سے، وہ سلیم سے، انہوں نے اپنے والد سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: اللہ کی دعا تین چیزوں میں پائی جاتی ہے: عورت، گھوڑا اور گھر۔"
"8940","ہم سے محمد بن منصور نے بیان کیا، انہوں نے فرمایا: سفیان زہری کی سند سے، سالم کی سند سے، اپنے والد کی سند سے، رسول اللہ صلی اللہ علیہ وسلم سے، آپ صلی اللہ علیہ وسلم نے فرمایا: بدشگونی تین میں: عورت، گھوڑا اور گھر۔"
"8941","ہم سے محمد بن نصر نے بیان کیا، انہوں نے فرمایا کہ ہم سے ایوب بن سلیمان نے بیان کیا، انہوں نے کہا: مجھ سے ابوبکر نے سلیمان سے، ابن ابی عتیق سے اور موسیٰ بن عقبہ نے، ابن شہاب سے، وہ سلیم اور حمزہ رضی اللہ عنہ سے کہ عبداللہ بن عمر رضی اللہ عنہما نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: میں: گھوڑا، عورت اور گھر۔"
"8942","ہم سے محمد بن نصر نے بیان کیا، انہوں نے فرمایا: مجھ سے ایوب نے بیان کیا، انہوں نے فرمایا: مجھ سے ابوبکر نے بیان کیا، سلیمان سے، یحییٰ نے کہا: اور مجھ سے ابن شہاب نے بیان کیا، انہیں سلیم اور حمزہ نے بیان کیا کہ ان سے عبداللہ بن عمر رضی اللہ عنہما نے بیان کیا۔ انہوں نے کہا: میں نے رسول اللہ صلی اللہ علیہ وسلم کو یہ فرماتے ہوئے سنا: \نحوست گھوڑے میں ہے۔\"" اور عورت، اور گھر۔\"""""""""
"8943","ہم سے اسحاق بن ابراہیم نے بیان کیا، کہا ہم سے وکیع نے بیان کیا، انہوں نے کہا: ہم سے زکریا بن ابی زیدہ نے بیان کیا، وہ مصعب بن شیبہ سے، وہ طلق بن حبیب سے، انہوں نے عبداللہ بن زبیر رضی اللہ عنہ سے، انہوں نے عائشہ رضی اللہ عنہا سے، انہوں نے کہا کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: فطرت: مونچھیں تراشنا، ناخن تراشنا، انگوٹھے دھونا، داڑھی بڑھانا، مسواک کرنا، مسواک کرنا، بغلیں نوچنا، زیر ناف مونڈنا اور پانی کم کرنا۔ مصعب نے کہا: میں دسویں بھول گیا، الا یہ کہ وہ منہ کی کلی کرے۔"
"8944","ہم سے محمد بن عبد العلا نے بیان کیا، انہوں نے فرمایا: ہم سے معتمر نے اپنے والد سے بیان کیا، انہوں نے کہا: میں نے طلق بن حبیب کو دس فطرہ کا ذکر کرتے ہوئے سنا۔ : مسواک، مونچھیں تراشنا، ناخن تراشنا، گٹھلی دھونا، بغلیں نوچنا، ختنہ کرنا، مقعد دھونا، ناف مونڈنا، ’’اور سانس لینا‘‘ اور مجھے ’’منہ کلی کرنے‘‘ میں شک ہوا۔ (صلی اللہ علیہ وآلہ وسلم)"
"8945","ہم سے قتیبہ بن سعید نے بیان کیا، انہوں نے کہا کہ ہم سے ابو عونہ نے بیان کیا، انہوں نے ابو بشر کی سند سے، انہوں نے طلق بن حبیب سے، انہوں نے کہا: دس سنتیں: مسواک، مونچھیں تراشنا، منہ، ناک، داڑھی تراشنا، ناخن تراشنا، طواف کرنا، سر کا طواف کرنا۔ مقعد کو دھونا۔\ ابوعبدالرحمٰن کہتے ہیں: سلیمان تیمی اور جعفر بن ایاس کی حدیث مصعب بن شیبہ کی حدیث سے زیادہ سند کے لائق ہے۔ 5 اور مصعب منکر حدیث 5"""""""
"8946","Humayd bin Masada told us, on the authority of Bishr, he said: Abd al-Rahman bin Ishaq told us, on the authority of Sa`id al-Maqbari, on the authority of Abu Hurairah, he said : The Messenger of God, may God bless him and grant him peace, said: “Five things are part of the fitrah: circumcision, shaving the pubic hair, plucking the fingernail, ناخن تراشنا، اور \پینے والے\"" کو چھوٹا کرنا"""""""
"8947","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، عَنْ مَالِكٍ ، عَنْ سَعِيدٍ الْمَقْبُرِيِّ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : \ خَمْسٌ مِنَ الْفِطْرَةِ : تَقْلِيمُ الأَظْفَارِ ، وَقَصُّ الشَّارِبِ ، وَنَتْفُ الإِبْطِ ، وَحَلْقُ الْعَانَةِ ، وَالْخِتَانُ \"""""""""
"8948","ہم سے محمد بن بشار نے بیان کیا، انہوں نے فرمایا: ہم سے عبدالرحمٰن نے بیان کیا، انہوں نے کہا: ہم سے سفیان نے، وہ عبدالرحمٰن بن علقمہ سے، وہ ابن عمر رضی اللہ عنہما سے کہ نبی کریم صلی اللہ علیہ وسلم نے فرمایا: مونچھیں کٹاؤ اور داڑھی بڑھاؤ۔"
"8949","ہم سے عمرو بن علی نے بیان کیا، انہوں نے کہا: ہم سے عبدالرحمٰن نے بیان کیا، کہا: ہم سے سفیان نے بیان کیا، انہوں نے کہا: میں نے عبدالرحمٰن بن ابی علقمہ رضی اللہ عنہ سے سنا، انہوں نے کہا: میں نے ابن عمر رضی اللہ عنہما کو فرماتے ہوئے سنا: رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: داڑھی کو سنوارو اور مونچھیں کاٹو۔"
"8950","ہم سے محمد بن عبد العلا نے بیان کیا، انہوں نے فرمایا: ہم سے المعتمر نے بیان کیا، انہوں نے کہا: میں نے یوسف بن صہیب کو کہتے ہوئے سنا، وہ حبیب بن یسار سے، انہوں نے زید بن ارقم رضی اللہ عنہ سے روایت کیا کہ میں نے رسول اللہ صلی اللہ علیہ وسلم کو فرماتے سنا: جس نے کوئی چیز نہیں لی وہ ہم میں سے نہیں ہے۔"
"8951","ہم سے اسحاق بن منصور نے بیان کیا، انہوں نے کہا کہ ہم سے وہب بن جریر نے بیان کیا، انہوں نے کہا کہ ہم سے میرے والد نے بیان کیا، انہوں نے کہا: میں نے محمد بن ابی یعقوب رضی اللہ عنہ کو حسن بن سعد سے، انہوں نے عبداللہ بن جعفر رضی اللہ عنہ سے کہتے سنا، انہوں نے کہا: اللہ کے رسول صلی اللہ علیہ وسلم نے ان کے گھر والوں کو تین دن دیے۔ پھر وہ ان کے پاس آیا اور کہا: آج کے بعد میرے بھائی پر مت رونا۔ پھر فرمایا: میرے لیے میرے بھائی کے بیٹوں کو بلاؤ۔ ہمیں ایسے لایا گیا جیسے ہم چھوٹے تھے، تو اس نے کہا: مجھے بلاؤ۔ ’’حجام‘‘ تو اس نے اسے حکم دیا کہ وہ ہمارے سر منڈوا دے۔ مختصر"
"8952","ہم کو اسحاق بن ابراہیم نے خبر دی، کہا ہم کو عبدالرزاق نے خبر دی، انہوں نے کہا کہ ہمیں معمر نے خبر دی، وہ ایوب سے، وہ نافع سے، انہوں نے ابن عمر رضی اللہ عنہما سے کہ نبی کریم صلی اللہ علیہ وسلم نے ایک لڑکے کو دیکھا جس نے اپنے کچھ بال منڈوائے تھے اور کچھ چھوڑ دیا تھا، آپ آپ صلی اللہ علیہ وسلم نے اس سے منع فرمایا اور فرمایا: یا اکیلا چھوڑ دو۔"
"8953","ہم سے محمد بن موسیٰ حراشی نے بیان کیا، انہوں نے فرمایا کہ ہم سے ابوداؤد نے بیان کیا، انہوں نے کہا: ہم سے ہمام نے قتادہ کی سند سے، خلاس کی سند سے، انہوں نے علی رضی اللہ عنہ سے، انہوں نے کہا: اس نے رسول اللہ صلی اللہ علیہ وسلم کو منع کیا اور ایک عورت کو سر منڈوانے کا حکم دیا۔"
"8954","أَخْبَرَنِي عِمْرَانُ بْنُ يَزِيدَ ، قَالَ : حَدَّثنا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدِ بْنِ أَبِي الرِّجَالٍ ، عَنْ عُمَرَ بْنِ نَافِعٍ ، عَنْ أَبِيهِ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \ نَهَانِي اللَّهُ عَزَّ وَجَلَّ عَنِ الْقَزَعِ \"""""""""
"8955","ہم سے اسحاق بن ابراہیم نے بیان کیا، انہوں نے کہا: میں محمد بن بشر ہوں، انہوں نے کہا: ہم سے عبید اللہ نے عمر بن نافع سے، نافع کی سند سے، انہوں نے ابن عمر رضی اللہ عنہما سے۔ اس نے کہا: \رسول اللہ صلی اللہ علیہ وسلم نے قضا کو حرام قرار دیا ہے۔\"""""""""
"8956","ہم سے محمد بن بشار نے بیان کیا، انہوں نے فرمایا کہ ہم سے یحییٰ نے بیان کیا، کہا کہ ہم سے عبید اللہ نے بیان کیا، انہوں نے کہا: مجھ سے عمر بن نافع نے بیان کیا، انہوں نے نافع کی سند سے، انہوں نے ابن عمر رضی اللہ عنہما سے کہ نبی کریم صلی اللہ علیہ وسلم نے غیبت سے منع کیا۔"
"8957","مجھ سے ابراہیم بن الحسن نے بیان کیا، انہوں نے کہا: ہم سے حجاج نے بیان کیا، انہوں نے کہا: ابن جریج نے کہا، مجھے عبید اللہ نے نافع کی سند سے بیان کیا، انہوں نے ان سے، انہوں نے ابن عمر رضی اللہ عنہما کو یہ کہتے ہوئے سنا: میں نے رسول اللہ صلی اللہ علیہ وسلم کو قضا سے منع کرتے ہوئے سنا ہے۔"
"8958","ہم سے احمد بن سلیمان نے بیان کیا، انہوں نے کہا: ہم سے ابوداؤد نے جو الحفاری ہیں، انہوں نے سفیان سے، عبید اللہ سے، نافع سے، انہوں نے ابن عمر رضی اللہ عنہما سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے قضا سے منع فرمایا ہے۔"
"8959","ہم سے احمد بن عبدہ نے بیان کیا، انہوں نے کہا: میں حماد ہوں، انہوں نے کہا: ہم سے عبید اللہ نے نافع سے اور ابن عمر رضی اللہ عنہما سے کہ نبی کریم صلی اللہ علیہ وسلم نے بیزاری سے منع فرمایا۔ ابوعبدالرحمٰن کہتے ہیں: یحییٰ بن سعید اور محمد بن بشر کی احادیث ان کے بعد کی حدیثوں سے زیادہ صحیح ہونے کے لائق ہیں اور خدا ہی بہتر جانتا ہے۔"
"8960","ہم سے محمود بن غیلان نے بیان کیا، انہوں نے کہا کہ ہم سے قبیصہ کے بھائی سفیان نے اور معاویہ بن ہشام نے بیان کیا، انہوں نے کہا: ہم سے سفیان نے عاصم بن کلیب سے، انہوں نے اپنے والد سے، وائل بن حجر رضی اللہ عنہ سے، انہوں نے کہا: میں نبی کریم صلی اللہ علیہ وسلم کے پاس آیا، آپ صلی اللہ علیہ وسلم نے فرمایا: ”میں نے سوچا کہ آپ کے بالوں کی حفاظت فرمائی ہے۔ میرا مطلب تھا چنانچہ میں نے اپنے کچھ بال لیے، پھر میں اس کے پاس گیا، تو اس نے مجھ سے کہا: \میرا مطلب تم سے نہیں تھا، اور یہ بہتر ہے۔\"""""""""
"8961","ہم سے قتیبہ نے مالک کی روایت سے، ربیعہ کی روایت سے اور انس رضی اللہ عنہ سے، انہوں نے انہیں یہ کہتے سنا: رسول اللہ صلی اللہ علیہ وسلم نے \لمبے اور الگ الگ کی قسم، نہ چھوٹے کی، نہ سفید اور البینو کی، نہ انسان کی، نہ کالی بلی کی طرف سے\""۔ مختصر"""""""
"8962","ہم سے محمد بن المثنیٰ نے بیان کیا، انہوں نے فرمایا: ہم سے وہب بن جریر نے بیان کیا، انہوں نے کہا: ہم سے ابی نے بیان کیا، انہوں نے کہا: میں نے قتادہ کو کہتے ہوئے سنا، انہوں نے انس رضی اللہ عنہ سے کہا: وہ شعر تھا۔ رسول اللہ صلی اللہ علیہ وسلم کے کانوں اور کندھوں کے درمیان ایک آدمی کے بال تھے نہ گھنگریالے اور نہ سیدھے۔"
"8963","ہمیں علی بن خشرم نے خبر دی، کہا: میں عیسیٰ ہوں، الاوزاعی کی سند سے، حسن بن عطیہ کی سند سے، محمد بن المنکدر کی سند سے، جابر بن عبداللہ رضی اللہ عنہ سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم ہمارے پاس تشریف لائے اور ایک آدمی کو دیکھا جس کے بال بے ترتیب تھے۔ اس نے کہا: کیا اس شخص کے پاس اپنے بالوں کو پرسکون کرنے کے لیے کچھ نہیں ہے؟"
"8964","ہم سے عمرو بن علی نے بیان کیا، انہوں نے کہا: ہم سے عمر بن علی بن مقدام نے بیان کیا، انہوں نے کہا: ہم سے یحییٰ بن سعید نے محمد بن المنکدر سے، انہوں نے ابو قتادہ رضی اللہ عنہ سے، انہوں نے کہا: ان کی ایک بڑی جماعت تھی، آپ انہوں نے نبی کریم صلی اللہ علیہ وسلم سے پوچھا، آپ صلی اللہ علیہ وسلم نے اسے ہر روز اچھا سلوک کرنے کا حکم دیا۔ ابو عبدالرحمٰن نے کہا: یہ زیادہ حق کی طرح ہے، اور خدا بہتر جانتا ہے۔"
"8965","ہم سے قتیبہ بن سعید نے بیان کیا، انہوں نے کہا: ہم سے ابو عونہ نے بیان کیا، انہوں نے داؤد العودی سے، انہوں نے حمید بن عبدالرحمٰن الحمیری کی سند سے، انہوں نے کہا: میں نے ایک آدمی کو پایا جو رسول اللہ صلی اللہ علیہ وسلم کے ساتھ رہا، جیسا کہ ابوہریرہ رضی اللہ عنہ نے چار سال تک آپ صلی اللہ علیہ وسلم کے ساتھ رہے۔ انہوں نے کہا: \رسول اللہ صلی اللہ علیہ وسلم نے ہمیں اس بات سے منع کیا ہے کہ ہم میں سے ایک ہر روز کنگھی کرے۔\"""""""""
"8966","ہم سے علی بن حجر نے بیان کیا، انہوں نے کہا: ہم سے عیسیٰ بن یونس نے بیان کیا، انہوں نے ہشام بن حسن سے، انہوں نے حسن رضی اللہ عنہ سے، انہوں نے عبداللہ بن مغفل رضی اللہ عنہ سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے اترنے سے منع فرمایا ہے، جب تک کہ یہ حماقت نہ ہو۔"
"8967","ہم سے محمد بن بشار نے بیان کیا، انہوں نے فرمایا کہ ہم سے ابوداؤد نے بیان کیا، انہوں نے کہا: ہم سے حماد بن سلمہ نے قتادہ کی سند سے، انہوں نے حسن رضی اللہ عنہ سے کہ نبی کریم صلی اللہ علیہ وسلم نے بیوقوفی کے علاوہ اترنے سے منع فرمایا۔"
"8968","ہم سے اسماعیل بن مسعود نے بیان کیا، انہوں نے کہا: ہم سے خالد بن حارث نے سرگوشی کی سند سے، انہوں نے عبداللہ بن شقیق رضی اللہ عنہ سے، انہوں نے کہا: صحابہ کرام رضی اللہ عنہم میں سے ایک آدمی مصر میں کام کر رہا تھا۔ آپ کے صحابہ میں سے ایک شخص آپ کے پاس آیا اور دیکھا کہ آپ صلی اللہ علیہ وسلم بکھرے ہوئے ہیں اور آپ کا سر چمک رہا ہے۔ میں نے کہا: میں آپ کو کیوں دیکھوں؟ مشانہ، اور آپ شہزادے ہو؟ ! انہوں نے کہا: اللہ کے نبی صلی اللہ علیہ وسلم نے ہمیں عیش و عشرت سے منع فرمایا ہے۔ ہم نے کہا: عیش و عشرت کیا ہے؟ فرمایا: ہر روز چلنا۔ ابو عبدالرحمٰن نے کہا: اس نے اس کا نام سعید بن ایاس الجریری رکھا۔"
"8969","ہم سے یعقوب بن ابراہیم نے بیان کیا، انہوں نے کہا کہ ہم سے ابن الیہ نے الجریری سے اور عبداللہ بن بریدہ رضی اللہ عنہ سے کہ رسول اللہ صلی اللہ علیہ وسلم کے اصحاب میں سے ایک شخص نے دعا کی کہ اللہ آپ پر رحمت نازل فرمائے۔ اسے عبید کہتے ہیں۔ انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم ہمیں بہت زیادہ عیش و عشرت سے منع فرمایا کرتے تھے۔ ابن بریدہ سے عیش و عشرت کے بارے میں پوچھا گیا تو انہوں نے کہا: اس میں اترنا بھی شامل ہے۔"
"8970","ہم سے محمد بن عبد العلا نے بیان کیا، انہوں نے فرمایا: ہم سے خالد نے بیان کیا، فرمایا: ہم سے شعبہ نے بیان کیا، انہوں نے کہا: مجھ سے اشعث نے بیان کیا، انہوں نے کہا: میں نے اپنے والد کو چوری کے بارے میں اور عائشہ رضی اللہ عنہا سے بات کرتے ہوئے سنا، اور انہوں نے ذکر کیا کہ رسول اللہ صلی اللہ علیہ وسلم نے جب تک آپ صلی اللہ علیہ وسلم کو جوتے پہنائے اور جوتے پہننے پر قادر رہے۔"
"8971","ہم سے محمد بن معمر نے بیان کیا، انہوں نے کہا: ہم سے ابو عاصم نے محمد بن بشر نے، اشعث بن ابی اشعثہ کی سند سے، اسود بن یزید سے، انہوں نے عائشہ رضی اللہ عنہا سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے آپ صلی اللہ علیہ وسلم کو سلام کیا، دائیں ہاتھ کو پیار کیا، دائیں ہاتھ کو پیار کیا اور پیار کیا۔ التیمان اپنے تمام معاملات میں۔\ ابوعبدالرحمٰن نے کہا: اور اس سے پہلے والا صحیح کا زیادہ مستحق ہے۔"""""""
"8972","ہم سے علی بن حجر نے بیان کیا، انہوں نے کہا: میں اسماعیل ہوں، حمید سے، انہوں نے انس رضی اللہ عنہ سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم کے بال آدھے کانوں تک پہنچ گئے تھے۔ \"" 8973"""""""
"8973","اسحاق بن ابراہیم نے ہمیں بتایا، انہوں نے کہا: عبدالرزاق نے ہمیں بتایا، انہوں نے کہا: معمر نے ہمیں بتایا، ثابت نے، انس نے، انہوں نے کہا: ""رسول اللہ ﷺ کے بال آپ کے کانوں کے اوپر تک تھے۔"""""""
"8974","ہم سے محمد بن معمر نے بیان کیا، کہا ہم سے حبان نے بیان کیا، انہوں نے کہا: ہم سے حمام نے بیان کیا، انہوں نے کہا: میں قتادہ نے انس رضی اللہ عنہ سے کہ نبی کریم صلی اللہ علیہ وسلم کے بال کندھوں تک تھے۔"
"8975","ہم سے حاجب بن سلیمان نے وکیع کی سند سے، سفیان کی سند سے، ابواسحاق کی سند سے، انہوں نے البراء کی سند سے، انہوں نے کہا: میں نے رسول اللہ صلی اللہ علیہ وسلم کی چادر میں اس سے زیادہ علم والا کسی کو نہیں دیکھا، اور اس کے کندھوں تک بال ہوتے ہیں۔"
"8976","ہم سے محمد بن عبداللہ بن عمار نے بیان کیا، انہوں نے کہا: ہم سے معفع نے بنی اسرائیل سے، انہوں نے ابواسحاق سے، انہوں نے البراء سے، انہوں نے کہا: میں نے کسی کو سرخ لباس میں رسول اللہ صلی اللہ علیہ وسلم سے زیادہ خوبصورت دیکھا، آپ اللہ آپ کو سلام کرے اور آپ کی سر کی ٹوپی آپ کے سر پر لگے۔"
"8977","ہم سے عبدالحمید بن محمد نے بیان کیا، انہوں نے کہا کہ ہم سے مخلد بن یزید نے بیان کیا، انہوں نے کہا: ہم سے یونس نے اپنے والد سے بیان کیا، انہوں نے کہا: مجھ سے البراء رضی اللہ عنہ نے بیان کیا، انہوں نے کہا: میں نے ایک آدمی کو دیکھا جو رسول اللہ صلی اللہ علیہ وسلم سے بہتر لباس پہنا ہوا تھا۔"
"8978","ہمیں علی بن الحسین الدارہیمی نے امیہ بن خالد سے شعبہ کی روایت سے ابواسحاق نے براء کی سند سے بیان کیا کہ انہوں نے کہا کہ رسول اللہ صلی اللہ علیہ وسلم ایک لمبے قد والے آدمی ہیں، سر کے بالوں کے درمیان گھنے، کندھوں پر چوڑے ہیں۔ میں نے اسے سرخ سوٹ میں دیکھا اور اس سے بہتر کوئی چیز نہیں دیکھی۔"
"8979","ہم سے الحسن بن اسماعیل بن سلیمان المجلیدی الماسی نے بیان کیا، کہا: ہم سے عبدہ بن سلیمان نے العمش کی سند سے اور ابو اسحاق کی سند سے بیان کیا۔ ہبیرہ بن یریم رضی اللہ عنہ سے مروی ہے کہ عبداللہ بن مسعود رضی اللہ عنہ نے کہا: آپ مجھے کس پر قرأت کا حکم دیتے ہو، میں نے رسول اللہ صلی اللہ علیہ وسلم پر قرأت کی ہے۔ اور اس پر 72 سورتیں پڑھی گئیں اور زید دو بھیڑیوں کا مالک تھا جو لڑکوں کے ساتھ کھیلتا تھا۔"
"8980","مجھ سے ابراہیم بن یعقوب نے بیان کیا، انہوں نے کہا: ہم سے سعید بن سلیمان نے بیان کیا، انہوں نے کہا: ہم سے ابو شہاب نے بیان کیا، انہوں نے کہا: ہم سے الاعمش نے بیان کیا، انہوں نے ابووائل کی سند سے، انہوں نے کہا کہ ابن مسعود رضی اللہ عنہ نے ہم سے مخاطب ہو کر کہا: آپ مجھے اس طرح پڑھنے کا حکم کیسے دیتے ہیں جس طرح زید بن ثابت نے تلاوت فرمائی، اور میں نے رسول اللہ صلی اللہ علیہ وسلم سے روایت کی؟ اس نے ستر سورتیں پڑھیں اور زید کے لڑکوں کے ساتھ دو بھیڑیے تھے؟"
"8981","ہم سے ابراہیم بن المستمیر نے بیان کیا، انہوں نے کہا کہ ہم سے السلط بن محمد ابو ہمام نے بیان کیا، انہوں نے کہا کہ ہم سے غسان بن الاثر بن حصین النہشالی نے بیان کیا، انہوں نے کہا: مجھ سے میرے چچا زیاد بن الحسین نے اپنے والد سے روایت کی کہ وہ نبی کریم صلی اللہ علیہ وسلم کے پاس مدینہ منورہ میں تشریف لائے۔ اور اسے سلامتی عطا فرمائی، اس سے کہا: خدا اس پر رحم کرے اور اسے سلامتی عطا فرمائے: \میرے قریب آؤ۔\"" آپ صلی اللہ علیہ وسلم آپ صلی اللہ علیہ وسلم کے پاس آئے، اپنا ہاتھ آپ کے بالوں پر رکھا، پھر اپنا ہاتھ بڑھایا، میں نے آپ صلی اللہ علیہ وسلم پر درود و سلام عرض کیا اور آپ کے لیے دعا کی۔"""""""
"8982","ہم سے احمد بن حرب نے بیان کیا، انہوں نے کہا: ہم سے قاسم نے بیان کیا، انہوں نے کہا: ہم سے سفیان نے عاصم بن کلیب سے، وہ اپنے والد سے، وائل بن حجر رضی اللہ عنہ سے، انہوں نے کہا: میں نبی کریم صلی اللہ علیہ وسلم کے پاس آیا، اور میرے پاس ایک ہجوم تھا۔ اس نے کہا: \مکھی،\"" تو میں نے سوچا کہ اس کا مطلب مجھ سے ہے، تو میں چلا گیا اور اپنے کچھ بال لے لیے۔ اس نے کہا: \""میرا مطلب تم سے نہیں تھا، اور یہ بہتر ہے۔\"""""""""
"8983","ہم سے محمد بن سلمہ نے بیان کیا، انہوں نے فرمایا: ہم سے ابن وہب نے بیان کیا، انہوں نے یونس کی سند سے، وہ زہری سے، انہوں نے عبید اللہ بن عبداللہ سے، انہوں نے ابن عباس رضی اللہ عنہما سے کہ رسول اللہ صلی اللہ علیہ وسلم اپنے بالوں کو جھکاتے تھے، اور مشرکین اور رسول اللہ صلی اللہ علیہ وسلم کے بالوں کو جھاڑتے تھے، اور اللہ کے رسول صلی اللہ علیہ وسلم ان کے بالوں کو تقسیم کرتے تھے۔ اس کے بال نیچے کرنے دو. وہ اہل کتاب کے ساتھ معاہدہ کو پسند کرتا ہے، جب تک کہ اسے اس کے بارے میں کچھ کرنے کا حکم نہ دیا گیا ہو۔ پھر رسول اللہ صلی اللہ علیہ وسلم اس کے بعد علیحدگی اختیار کر گئے۔"
"8984","حارث بن مسکین نے اس کے بارے میں پڑھا اور میں نے ابن القاسم کی روایت سے، مالک کی سند سے، زیاد بن سعد کی سند سے، ابن شہاب کی سند سے سنا ہے کہ انہوں نے انہیں یہ کہتے ہوئے سنا: \رسول اللہ صلی اللہ علیہ وسلم نے اپنی پیشانی کو جھکا دیا، پھر جیسا کہ اللہ نے چاہا، الگ کیا۔\"""""""""
"8985","ہم سے محمد بن سلمہ نے بیان کیا، انہوں نے فرمایا: ہم سے ابن وہب نے حیوہ بن شریح کی سند سے بیان کیا اور ان سے پہلے ایک اور شخص نے عیاش بن عباس رضی اللہ عنہما سے بیان کیا۔ شیام بن بیطان نے ان سے بیان کیا کہ انہوں نے رویفہ بن ثابت رضی اللہ عنہ کو یہ فرماتے ہوئے سنا: رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”اے رویفہ شاید آپہاری عمر میرے بعد دراز ہو جائے، اس لیے لوگوں کو بتاؤ کہ یہ وہ ہے جس نے داڑھی باندھی، یا تار باندھی، یا محمد صلی اللہ علیہ وسلم کے لیے دعا کی، یا کسی جانور سے اپنے آپ کو پاک کیا۔ آپ صلی اللہ علیہ وسلم اس سے بری ہیں۔"
"8986","ہم سے قتیبہ بن سعید نے عبد العزیز الدراوردی المدنی سے، عمارہ بن غازیہ کی سند سے، عمرو بن شعیب سے، اپنے والد سے، اپنے دادا سے، انہوں نے کہا کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا:"
"8987","ہم سے عبید اللہ بن سعد نے بیان کیا، انہوں نے کہا کہ ہم سے میرے چچا نے بیان کیا، انہوں نے کہا: ہم سے میرے والد نے صالح کی سند سے، انہوں نے ابن شہاب کی سند سے، انہوں نے کہا: ابو سلمہ نے کہا: بے شک ابوہریرہ رضی اللہ عنہ نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: اور ہم کو یونس بن عبد العلا نے خبر دی، انہوں نے کہا: ہمیں ابن وہب نے خبر دی، انہوں نے کہا: مجھے یونس نے ابن شہاب کی سند سے، انہیں ابو سلمہ بن عبدالرحمٰن نے ابوہریرہ رضی اللہ عنہ سے خبر دی کہ رسول اللہ صلی اللہ علیہ وسلم نے ان کو خبر دی، آپ صلی اللہ علیہ وسلم نے فرمایا: ”مسیحی اور عیسائی اپنے بالوں کو سرخ نہیں کرتے۔ عبید اللہ نے اپنی حدیث میں کہا: وہ رنگ نہیں کرتے۔ ہم سے اسحاق بن ابراہیم نے بیان کیا، انہوں نے کہا: ہم سے عبدالرزاق نے بیان کیا، انہوں نے کہا: ہم سے معمر نے زہری کی سند سے، ابو سلمہ رضی اللہ عنہ سے، ابوہریرہ رضی اللہ عنہ سے کہ رسول اللہ صلی اللہ علیہ وسلم نے بیان کیا، انہوں نے کہا کہ ہم سے معمر نے بیان کیا۔"
"8988","مجھ سے حسین بن حارث نے بیان کیا، انہوں نے کہا: ہمیں فضل بن موسیٰ نے معمر کی روایت سے، زہری کی سند سے، ابو سلمہ کی سند سے، ابوہریرہ رضی اللہ عنہ سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”یہود و نصاریٰ نے ان کے بالوں کو خراب نہیں کیا، لہٰذا یہود و نصاریٰ نے ان کے بالوں کو خراب نہیں کیا۔ ان کے بال۔\"" 8989"""""""
"8989","اسحاق بن ابراہیم نے ہمیں بتایا، انہوں نے کہا: سفیان نے بتایا، زہری نے، ابو سلمہ اور سلیمان بن یسار نے، کہ انہوں نے ابو ہریرہ کو رسول اللہ ﷺ سے بتاتے سنا، کہ آپ نے فرمایا: ""یہودی اور عیسائی بال نہیں رنگتے، تو ان سے مخالف ہو جاؤ۔"""""""
"8990","ہم سے علی بن خشرم نے بیان کیا، انہوں نے کہا: ہم سے عیسیٰ نے جو ابن یونس ہیں، انہوں نے اوزاعی کی سند سے، وہ الزہری کی سند سے، سلیمان کی سند سے، ابوہریرہ رضی اللہ عنہ سے، انہوں نے نبی اکرم صلی اللہ علیہ وسلم سے بیان کیا، انہوں نے کہا: یہود و نصاریٰ ان کی طرف سے ایسا نہیں کرتے۔\"" 8991"""""""
"8991","عثمان بن عبداللہ نے مجھے بتایا، انہوں نے کہا: احمد بن جناب نے ہمیں بتایا، انہوں نے کہا: عیسی بن یونس نے ہمیں بتایا، ہشام بن عروہ نے، ان کے والد نے، ابن عمر نے، کہ رسول اللہ ﷺ نے فرمایا: ""سفیدی (بالوں کو) بدل دو، اور یہودیوں کی طرح مت بنو۔"""""""
"8992","ہم سے حمید بن مخلد بن زنجویہ بن الحسین نے بیان کیا، انہوں نے کہا کہ ہم سے محمد بن کناسہ نے بیان کیا، انہوں نے کہا کہ ہم سے ہشام بن عروہ نے بیان کیا، انہوں نے عثمان بن عروہ سے، انہوں نے اپنے والد سے، وہ زبیر رضی اللہ عنہ سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”اللہ کے رسول صلی اللہ علیہ وسلم نے فرمایا: ”بالغ بالوں کو نہ مبارک ہو۔ یہودی۔\ یہ دونوں محفوظ نہیں ہیں اور خدا ہی بہتر جانتا ہے۔"""""""
"8993","عبدالرحمٰن بن عبید اللہ حلبی نے ہمیں عبید اللہ کی روایت سے جو ابن عمرو بن عبد الکریم ہیں سعید بن جبیر کی سند سے اور ابن عباس رضی اللہ عنہما سے روایت کی ہے کہ نبی کریم صلی اللہ علیہ وسلم نے فرمایا: ”ایسے لوگ ہیں جو آخر زمانہ میں اپنے بالوں کو سیاہ نہیں کرتے۔ جنت کی خوشبو سونگھو۔\"" 8994"""""""
"8994","یونس بن عبدالاعلی نے ہمیں بتایا، انہوں نے کہا: ابن وھب نے ہمیں بتایا، انہوں نے کہا: ابن جریج نے مجھے بتایا، ابو زبیر نے، جابر نے، انہوں نے کہا: فتح مکہ کے دن ابو قحافہ لائے گئے، ان کا سر اور داڑھی بگولے کی طرح سفید تھی، تو رسول اللہ ﷺ نے فرمایا: ""اس کو کسی چیز سے بدل دو، اور سواد سے پرہیز کرو۔"""""""
"8995","ہم سے محمد بن عبد العلا نے بیان کیا، فرمایا ہم سے خالد نے بیان کیا، انہوں نے فرمایا: ہم سے عزیر نے بیان کیا، اور وہ ابن ثابت ہیں، وہ ابو الزبیر سے، انہوں نے جابر رضی اللہ عنہ سے، انہوں نے کہا: اسے لایا گیا، رسول اللہ صلی اللہ علیہ وسلم نے ابو قحافہ کو دیکھا، ان کا سر اور داڑھی اس طرح تھی جیسے رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: \اسے بدلو، اور اس کی داڑھی کو رنگ دو۔\"""""""""
"8996","ہم سے محمد بن مسلم بن ورہ رازی نے بیان کیا، انہوں نے فرمایا کہ ہم سے یحییٰ بن یعلی نے بیان کیا، انہوں نے کہا: ہم سے میرے والد نے بیان کیا، غیلان بن جمیع سے، انہوں نے ابی اسحاق سے، ابن ابی لیلیٰ سے، انہوں نے ابوذر رضی اللہ عنہ سے، انہوں نے کہا کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ” رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ” رسول اللہ صلی اللہ علیہ وسلم نے ان کے بالوں کو بدل دیا۔ مہندی ہے۔\ اور چھپانا۔"""""""
"8997","ہم سے یعقوب بن ابراہیم نے بیان کیا، انہوں نے کہا کہ ہم سے یحییٰ بن سعید نے عجلہ کی سند سے، عبداللہ بن بریدہ رضی اللہ عنہ سے، ابو الاسود الدلی سے، ابوذر رضی اللہ عنہ سے، انہوں نے نبی اکرم صلی اللہ علیہ وسلم سے بیان کیا، انہوں نے کہا: اللہ کے رسول صلی اللہ علیہ وسلم نے فرمایا: \سب سے اچھی چیز جو آپ کر سکتے ہیں وہ ہے اس سے سرمئی بالوں کو تبدیل کرنا۔\"" \""مہندی اور کٹم\"""""""""
"8998","ہم سے قتیبہ نے بیان کیا، انہوں نے کہا: ہم سے ابطار نے عجلہ کی سند سے، عبداللہ بن بریدہ رضی اللہ عنہ سے، ابو الاسود الدلی سے، ابوذر رضی اللہ عنہ سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”بہترین چیز جو آپ بالوں کو بدلنے کے لیے استعمال کر سکتے ہو وہ ہے۔"
"8999","ہم سے محمد بن عبدالرحمٰن بن اشعث نے بیان کیا، انہوں نے فرمایا کہ مجھ سے محمد بن عیسیٰ نے بیان کیا، انہوں نے کہا کہ ہم سے ہشیم نے بیان کیا، انہوں نے فرمایا: مجھ سے ابن ابی نے لیلیٰ سے بیان کیا، انہوں نے کہا: میں عجلہ سے ملا، انہوں نے مجھ سے ابن بریدہ سے، انہوں نے ابو العوائد رضی اللہ عنہ کی سند سے بیان کیا۔ ذر، انہوں نے کہا: میں نے رسول اللہ صلی اللہ علیہ وسلم کو یہ فرماتے ہوئے سنا: \بالوں کو سفید کرنے کے لیے بہترین چیزیں: مہندی اور کتم\""۔"""""""
"9000","ہم سے قتیبہ نے بیان کیا، انہوں نے کہا: ہم سے ابطار نے اجلہ سے، انہوں نے عبداللہ بن بریدہ رضی اللہ عنہ سے، وہ ابو الاسود الدلی سے، انہوں نے ابوذر رضی اللہ عنہ سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”سب سے بہتر چیز جس سے تم سفید اور سفید بال بدل سکتے ہو وہ ہے۔"
"9001","ہم سے حمید بن مسعدہ نے بیان کیا، انہوں نے کہا کہ ہم سے عبدالوارث نے بیان کیا، انہوں نے کہا: ہم سے الجریری نے عبداللہ بن بریدہ رضی اللہ عنہ سے بیان کیا، انہوں نے کہا: انہوں نے کہا کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”سفید بالوں کو بدلنے والی بہترین چیزیں مہندی اور کتم ہیں۔"
"9002","ہم سے حمید بن مسعدہ نے بیان کیا، انہوں نے کہا: ہم سے سفیان نے، جو ابن حبیب ہیں، انہوں نے خمس کی سند سے، انہوں نے عبداللہ بن بریدہ رضی اللہ عنہ سے، انہوں نے کہا کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”اللہ تعالیٰ آپ پر رحم فرمائے اور آپ صلی اللہ علیہ وسلم کو سفید بال بدلنے کی بہترین چیزیں ہیں: مہندی اور کتم“۔"
"9003","ہم سے محمد بن عبد العلا نے بیان کیا، انہوں نے فرمایا: ہم سے المطمر نے بیان کیا، انہوں نے کہا: میں نے ابن بریدہ رضی اللہ عنہ سے سرگوشی کرتے ہوئے سنا، انہیں بتایا گیا کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”سب سے بہترین چیز جو سفید بالوں کو بدل دیتی ہے وہ مہندی اور کتم ہیں۔"
"9004","ہم سے محمد بن بشار نے بیان کیا، انہوں نے فرمایا کہ ہم سے عبدالرحمٰن بن مہدی نے بیان کیا، انہوں نے کہا: ہم سے سفیان نے عیاض بن لقیط سے، انہوں نے ابو رمثہ رضی اللہ عنہ سے بیان کیا، انہوں نے کہا: میں اور میرے والد نبی کریم صلی اللہ علیہ وسلم کے پاس آئے اور آپ صلی اللہ علیہ وسلم نے اپنی داڑھی میں مہندی لگائی۔"
"9005","ہم سے عمرو بن علی نے بیان کیا، انہوں نے کہا: ہم سے عبدالرحمٰن نے سفیان سے، وہ عیاض بن لقیط سے، انہوں نے ابو رمتہ رضی اللہ عنہ سے، انہوں نے کہا: میں رسول اللہ صلی اللہ علیہ وسلم کے پاس آیا، آپ میں نے آپ صلی اللہ علیہ وسلم کو اپنی داڑھی کو زرد کرتے ہوئے دیکھا۔"
"9006","ہم سے یعقوب بن ابراہیم نے بیان کیا، انہوں نے کہا: ہم سے الدراوردی نے بیان کیا، انہوں نے زید بن اسلم کی سند سے، انہوں نے کہا: میں نے ابن عمر رضی اللہ عنہما کو اپنی داڑھی کو اچھے طریقے سے رنگتے ہوئے دیکھا ہے۔ اس سے کہا گیا: اے ابو عبدالرحمٰن، تم حسن اخلاق سے داڑھی کو پیلا کر رہے ہو! انہوں نے کہا: میں نے رسول اللہ صلی اللہ علیہ وسلم کو دیکھا کہ آپ صلی اللہ علیہ وسلم اپنی داڑھی کو اس سے خضاب لگاتے تھے، آپ کو اس سے زیادہ کوئی رنگ پسند نہیں تھا، آپ صلی اللہ علیہ وسلم اپنے آپام کپڑے اس سے رنگتے ہیں، یہاں تک کہ اپنی پگڑی بھی۔"
"9007","ہم سے یحییٰ بن حکیم البصری نے بیان کیا، انہوں نے کہا کہ ہم سے ابو قتیبہ نے بیان کیا، انہوں نے کہا: ہم سے عبدالرحمٰن بن عبداللہ بن دینار نے بیان کیا، وہ زید بن اسلم سے، وہ عبید سے، جو ابن جریج ہیں، انہوں نے کہا: میں نے ابن عمر رضی اللہ عنہ کو اپنی داڑھی کو خضاب لگاتے ہوئے دیکھا، آپ میں نے آپ صلی اللہ علیہ وسلم سے کہا: میں نے آپ صلی اللہ علیہ وسلم کو اس کے بارے میں فرمایا: اس نے ہیلو کہا، \اس پر سیٹیاں بجائیں۔\"" ابو عبدالرحمٰن نے کہا: یہ اس سے پہلے کے مقابلے میں زیادہ صحیح ہے، اور خدا ہی بہتر جانتا ہے۔"""""""
"9008","مجھ سے عبدہ بن عبد الرحیم المروازی نے بیان کیا، انہوں نے کہا: میں عمرو بن محمد الانقری الکوفی ہوں، انہوں نے کہا: میں ابن ابی رواد ہوں، نافع کی روایت سے، ابن عمر رضی اللہ عنہما سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم صابری کے دن ریت کے ساتھ پہنا کرتے تھے۔ اور زعفران۔\ ابن عمر نے ایسا ہی کیا۔"""""""
"9009","ہم سے محمد بن المثنیٰ نے بیان کیا، انہوں نے فرمایا: ہم سے ابوداؤد نے بیان کیا، انہوں نے کہا: ہم سے ہمام نے قتادہ سے اور انس رضی اللہ عنہ سے بیان کیا کہ انہوں نے ان سے پوچھا: کیا اس نے اپنے بال رنگے تھے؟ کیا رسول اللہ صلی اللہ علیہ وسلم پر درود و سلام ہو؟ اس نے کہا: \وہ اس مقام تک نہیں پہنچا تھا، لیکن اس کے مندروں میں کچھ تھا۔\"""""""""
"9010","ہم سے محمد بن مثنیٰ نے بیان کیا، فرمایا ہم سے عبد الصمد نے بیان کیا، انہوں نے فرمایا: ہم سے المثنیٰ نے بیان کیا، انہوں نے کہا: ہم سے قتادہ نے انس رضی اللہ عنہ سے بیان کیا کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: اللہ ان پر رحمت نازل فرمائے، آپ صلی اللہ علیہ وسلم نے اپنے بالوں کو نہیں رنگا تھا، لیکن ایک چھوٹا سا سر اور سر کے بالوں میں ایک چھوٹا سا حصہ تھا۔"
"9011","ہم سے محمد بن عبد العلا نے بیان کیا، انہوں نے فرمایا: ہم سے المطمر نے بیان کیا، انہوں نے کہا: میں نے الرکین کو القاسم بن حسان سے، اپنے چچا عبدالرحمٰن بن ہرملہ سے، عبداللہ بن مسعود رضی اللہ عنہ سے، انہوں نے کہا کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”ام المومنین علیہم الصلوٰۃ والسلام کی دس چیزیں ہیں۔ سلوک، بال بدلنا، کپڑے کھینچنا، سونا پہننا، ایڑیوں سے مارنا، عمدہ بالوں کی نمائش اور زیب و زینت کے علاوہ جو مناسب ہے۔ اور رقیہ صرف مباشرت، تعویذ پہننے، غلط جگہ سے پانی نکالنے اور اپنے محرم کے علاوہ کسی بچے کے بگڑنے سے ہے۔\"" 9012"""""""
"9012","عمر بن منصور نے ہمیں بتایا، انہوں نے کہا: معلیٰ بن اسد بصری، بہز بن اسد کے بھائی، نے ہمیں بتایا، انہوں نے کہا: مطیع بن میمون نے ہمیں بتایا، انہوں نے کہا: صفیہ بنت عصمہ نے ہمیں بتایا، عائشہ رضی اللہ عنہا سے، کہ ایک عورت نے نبی ﷺ کی طرف کتاب کے ساتھ اپنا ہاتھ بڑھایا، تو آپ نے اپنا ہاتھ کھینچ لیا۔ اس نے کہا: یا رسول اللہ، میں نے آپ کی طرف کتاب کے ساتھ اپنا ہاتھ بڑھایا تھا، لیکن آپ نے اسے نہیں لیا۔ آپ نے فرمایا: ""میں نہیں جانتا تھا کہ یہ عورت کا ہاتھ ہے یا مرد کا ہاتھ؟"" اس نے کہا: بلکہ یہ تو کہا: یہ تو عورت کا ہاتھ ہے۔ آپ نے فرمایا: ""اگر تم عورت ہوتی تو اپنے ناخنوں کو حناء سے رنگتی۔"""""""
"9013","مجھ سے ابراہیم بن یعقوب نے بیان کیا، انہوں نے کہا: ہم سے ابو زید سعید بن الربیع نے بیان کیا، انہوں نے کہا: ہم سے علی بن مبارک نے بیان کیا، انہوں نے کہا: میں نے کریمہ کو سنا، انہوں نے کہا کہ میں نے عائشہ رضی اللہ عنہا سے سنا، اور ایک عورت نے ان سے مہندی رنگنے کے بارے میں پوچھا، تو انہوں نے کہا: اس میں کوئی حرج نہیں ہے، لیکن میں اسے ناپسند کرتا ہوں، اس لیے کہ اللہ تعالیٰ نے اس کی دعا قبول فرمائی۔ سونگھنا، یعنی: نبی کریم صلی اللہ علیہ وسلم"
"9014","ہمیں عبدالرحمٰن بن عبد اللہ بن عبد الحکم نے خبر دی، کہا: ہمیں میرے والد اور ابو الاسود النادر بن عبد الجبار نے خبر دی، کہا: ہم سے مفضل بن فضلہ نے، عیاش بن عباس القبانی کی سند سے، ابو الحسن، ابو الحسن، ابو الحسن، ابو الحسن، ابن عباس رضی اللہ عنہما سے۔ کہا: شفیع شفایاب ہو گئے۔ اس نے اسے کہتے سنا: میں اور میرا ایک دوست ابو عامر نامی ایک معفر کا آدمی تھا، الیاس کے ساتھ نماز پڑھنے نکلے، اور وہ ان کا قصہ سنانے والا تھا۔ العزد کے ایک آدمی نے کہا: ابو ریحانہ، صحابہ میں سے ایک۔ ابو الحسین رضی اللہ عنہ نے کہا: میرا ساتھی مجھ سے پہلے مسجد میں آیا، پھر میں نے اسے پکڑ لیا، تو میں بیٹھ گیا۔ اس کی طرف، اس نے کہا: کیا تم نے ابو ریحانہ کے قصے سنے ہیں؟ تو میں نے کہا نہیں، آپ انہوں نے کہا: میں نے اسے یہ فرماتے ہوئے سنا: رسول اللہ صلی اللہ علیہ وسلم نے دس چیزوں سے منع فرمایا ہے: برش کرنا، گودنا اور نوچنا، اور مرد کا دوسرے مرد سے بغیر احساس کے جماع کرنے کے بارے میں، اور عورت کے بغیر احساس کے عورت سے جماع کرنے کے بارے میں، اور مرد کے لیے اپنے کپڑے کے نچلے حصے کو ریشم یا ریشم کی طرح پہننا چاہیے۔ اور لوٹ مار سے پرہیز کرتا ہے، اور شیروں کی سواری سے پرہیز کرتا ہے، اور انگوٹھی پہنتا ہے، سوائے اس کے جو \سلطان\"""""""""
"9015","ہم سے قتیبہ بن سعید نے بیان کیا، انہوں نے کہا: ہم سے سفیان نے بیان کیا، انہوں نے زہری سے، انہوں نے حمید بن عبدالرحمٰن بن عوف سے، انہوں نے کہا: میں نے معاویہ رضی اللہ عنہ سے سنا، وہ شہر میں منبر پر تھے، انہوں نے اپنی آستین سے اشعار کا ایک ٹکڑا نکالا اور کہا: اے اہل شہر آپہارے علماء کہاں ہیں؟ میں نے رسول اللہ صلی اللہ علیہ وسلم کو اس قسم کی چیزوں سے منع کرتے ہوئے سنا، آپ صلی اللہ علیہ وسلم نے فرمایا: ”بنی اسرائیل اس وقت تباہ ہو گئے جب ان کی عورتوں نے اس طرح کا طریقہ اختیار کیا۔"
"9016","مجھ سے محمد بن المثنیٰ اور محمد بن بشار نے بیان کیا، محمد بن جعفر سے، انہوں نے فرمایا: ہم سے شعبہ نے، عمرو بن مرہ سے، سعید بن المسیب سے، انہوں نے کہا: معاویہ مدینہ آیا اور ہم سے خطاب کیا، اور اس نے کہا: \میں نے ایک بال بھی نکالا جس کو میں نے دیکھا اور کہا: \""میں نے یہ بات نہیں کی کہ میں نے بالوں کو یہ کیا ہو؟ رسول اللہ صلی اللہ علیہ وسلم نے اسے جھوٹ قرار دیا۔"""""""
"9017","ہم کو عمرو بن یحییٰ بن الحارث حمصی نے خبر دی، کہا کہ ہم کو محبوب بن موسیٰ نے خبر دی، کہا: ہمیں ابن المبارک نے خبر دی، وہ یعقوب بن قععہ سے، انہوں نے قتادہ کی سند سے، ابن المسیب کی سند سے، انہوں نے کہا کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: اے لوگو! اور اسے سلامتی عطا فرما، آپ کو باطل سے منع فرمایا، فرمایا: \اور اس نے ایک کالا چیتھڑا لا کر ان کے ہاتھوں میں پھینکا، اور کہا: یہ وہی ہے جو عورت کو اپنے سر پر رکھنا چاہیے، پھر \""تم اس کے خلاف شراب پی رہے ہو\""۔"""""""
"9018","ہم سے محمد بن عبد العلا نے بیان کیا، انہوں نے فرمایا: ہم سے خالد نے بیان کیا، انہوں نے ہشام سے، انہوں نے کہا: ہم سے قتادہ نے سعید بن المسیب کی سند سے، انہوں نے معاویہ رضی اللہ عنہ سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے جھوٹ سے منع فرمایا۔"
"9019","ہم سے محمد بن عبداللہ بن عبدالرحیم البرقی نے بیان کیا، انہوں نے کہا کہ ہم سے اسد بن موسیٰ نے بیان کیا، انہوں نے کہا: ہم سے حماد بن سلمہ نے بیان کیا، وہ ہشام بن ابی عبداللہ الدستوی سے، انہوں نے قتادہ کے واسطہ سے، وہ ابن المسیب کے واسطہ سے، انہوں نے کہا کہ رسول اللہ صلی اللہ علیہ وسلم نے معاویہ رضی اللہ عنہ کے لیے دعا فرمائی۔ جھوٹ، اور جھوٹ: ایک عورت جو اپنے بالوں کو گھماتی ہے۔"
"9020","ہم کو احمد بن عمرو بن سرح نے خبر دی، کہا: ہمیں ابن وہب نے خبر دی، کہا: مجھے مخرمہ بن بکیر نے اپنے والد سے اور سعید مقبری سے روایت کی، انہوں نے کہا: میں نے معاویہ بن ابی سفیان کو منبر پر دیکھا، تو ان کے ہاتھ میں ایک عورت کے بال تھے، انہوں نے کہا: کیا بات ہے؟ کیا مسلمان عورتیں ایسا کرتی ہیں؟ میں نے رسول اللہ صلی اللہ علیہ وسلم کو فرماتے سنا: ”جو عورت اپنے سر کے بال جوڑے جو اس کے نہیں ہیں تو یہ جھوٹ ہے“۔"
"9021","ہم سے محمد بن المثنی نے بیان کیا، انہوں نے فرمایا کہ ہم سے یحییٰ نے بیان کیا، انہوں نے ہشام بن عروہ سے، انہوں نے کہا: مجھ سے فاطمہ بنت المنذر رضی اللہ عنہا نے بیان کیا کہ اسماء رضی اللہ عنہا سے روایت ہے کہ ایک عورت رسول اللہ صلی اللہ علیہ وسلم کے پاس آئی اور عرض کیا: یا رسول اللہ صلی اللہ علیہ وسلم، میری ایک بیٹی کے پاس شادی کی انگوٹھی ہے، تو اس نے شکایت کی۔ اس کے بال، اگر میں اس کے بالوں کو چھوؤں تو کیا مجھ پر کوئی الزام ہے؟ اس نے کہا: \خدا اس پر لعنت کرے جو جڑے ہوئے ہے اور جو ہمیشہ یہاں رہتا ہے۔\"""""""""
"9022","مجھ سے محمد بن اسماعیل بن ابراہیم نے بیان کیا، انہوں نے کہا: ہم سے ابو النضر نے بیان کیا، انہوں نے کہا: ہم سے شعبہ نے بیان کیا، وہ ہشام بن عروہ سے، انہوں نے ان کی اہلیہ فاطمہ رضی اللہ عنہا سے، انہوں نے اسماء بنت ابوبکر رضی اللہ عنہ سے کہا کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا کہ جو عورت جوڑتی ہے اس پر لعنت ہے۔"
"9023","ہم سے اسحاق بن ابراہیم نے بیان کیا، انہوں نے کہا کہ ہم سے محمد بن بشر نے بیان کیا، انہوں نے کہا: ہم سے عبید اللہ نے نافع کی سند سے، انہوں نے ابن عمر رضی اللہ عنہما سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم پر لعنت بھیجی گئی، انہوں نے کہا کہ جو شخص جڑا ہوا ہے، جڑنے والا، جوڑنے والا، طاغوت کرنے والا اور طاغوت کرنے والا۔"
"9024","ہم سے عباس بن عبدالعظیم نے بیان کیا، انہوں نے کہا: ہم سے عبداللہ نے جو محمد بن اسماء کے بیٹے ہیں، انہوں نے کہا کہ ہم سے جویریہ بن اسماء نے بیان کیا، انہیں ولید بن ابی ہشام نے نافع کی سند سے بیان کیا کہ انہیں خبر ملی کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”ایک عورت نے آپ صلی اللہ علیہ وسلم کی نماز پڑھی اور آپ صلی اللہ علیہ وسلم نے فرمایا: ” اور ٹیٹو کرنے والی، اور ٹیٹو والی عورت۔\"" 9025"""""""
"9025","ہم سے محمد بن وہب نے بیان کیا، انہوں نے فرمایا کہ ہم سے مسکین بن بکیر نے بیان کیا، انہوں نے کہا: ہم سے شعبہ نے عمرو بن مرہ سے، انہوں نے حسن بن مسلمہ سے، صفیہ بنت شیبہ رضی اللہ عنہا سے، انہوں نے عائشہ رضی اللہ عنہا سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ” اللہ کے رسول صلی اللہ علیہ وسلم نے فرمایا: ” اللہ تعالیٰ نے ایک شخص کو جو اس پر رحمت نازل فرمائی ہے، اس کو جوڑا۔ منسلک ہے۔"""
"9026","عمر بن منصور نے ہمیں بتایا، انہوں نے کہا: خلف بن موسی نے ہمیں بتایا، وہ موسی بن عمی کا بیٹا ہے، انہوں نے کہا: میرے والد نے ہمیں بتایا، قتادہ سے، عزرہ سے، حسن عرنی سے، یحیٰ بن جزار سے، مسروق سے، کہ ایک عورت عبداللہ بن مسعود رضی اللہ عنہ کے پاس آئی، اس نے کہا: میں ایک عورت ہوں جس کے بال گھنگرالے ہیں، کیا میرے لئے بالوں کو سیدھا کرنا جائز ہے؟ انہوں نے کہا: نہیں۔ اس نے کہا: کیا یہ کچھ ہے جو آپ نے رسول اللہ ﷺ سے سنا ہے، یا آپ اسے اللہ کی کتاب میں پاتے ہیں؟ انہوں نے کہا: نہیں، بلکہ میں نے اسے رسول اللہ ﷺ سے سنا ہے، اور اسے اللہ کی کتاب میں پاتا ہوں۔ اور حدیث کو آگے بڑھایا۔"
"9027","ہم سے عبدالرحمٰن بن محمد بن سلام نے بیان کیا، انہوں نے فرمایا: ہم سے ابوداؤد حفاری نے بیان کیا، انہوں نے سفیان سے، منصور سے، ابراہیم سے، علقمہ سے، انہوں نے عبداللہ رضی اللہ عنہ سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے عورتوں پر لعنت بھیجی، عورتوں پر لعنت بھیجی۔ اور بے نقاب خواتین \اچھی چیزوں کے لئے جو بدلتی ہیں۔\"""""""""
"9028","مجھ سے محمد بن بشار نے بیان کیا، انہوں نے فرمایا: ہم سے محمد نے بیان کیا، انہوں نے فرمایا: ہم سے شعبہ نے، منصور کی سند سے، ابراہیم کی سند سے، علقمہ کی سند سے، عبداللہ رضی اللہ عنہ سے، انہوں نے کہا: \خدا ان عورتوں پر لعنت کرے جو چہرے بناتی ہیں اور ظاہر کرتی ہیں، کیا میں اس پر لعنت نہ کروں جس نے رسول اللہ صلی اللہ علیہ وسلم پر لعنت بھیجی ہے؟\"""""""""
"9029","مجھ سے احمد بن سعید رباطی نے بیان کیا، انہوں نے کہا کہ ہم سے وہب بن جریر نے بیان کیا، انہوں نے کہا: ہم سے میرے والد نے بیان کیا، انہوں نے کہا: میں نے عماش رضی اللہ عنہ کو ابراہیم رضی اللہ عنہ سے، علقمہ رضی اللہ عنہ سے، عبداللہ رضی اللہ عنہ سے روایت کرتے ہوئے سنا، انہوں نے کہا: اللہ کے رسول صلی اللہ علیہ وسلم ان عورتوں پر جن کی رحمتیں نازل ہوئیں، ان پر اللہ کی رحمتیں نازل ہوں۔ چہرے، وہ خواتین جو اپنے بالوں کو ظاہر کرتی ہیں، اور وہ خواتین جو اپنے بال بدلتی ہیں۔\ خدا کی مخلوق"""""""
"9030","ہم سے احمد بن یحییٰ بن محمد نے بیان کیا، انہوں نے کہا: ہم سے عمر بن حفص نے بیان کیا، انہوں نے کہا: ہم سے ابی نے بیان کیا، انہوں نے کہا: ہم سے امش نے ابراہیم کی سند سے، انہوں نے ابو عبیدہ رضی اللہ عنہ سے۔ عبداللہ کی طرف سے، انہوں نے کہا: \خدا کی لعنت ہو ان عورتوں پر جو چھونے والی ہیں، ٹیٹو بنانے والی عورتوں پر، اور ان عورتوں پر جو اللہ کی تخلیق کو بدل دیتی ہیں\"" تو ایک عورت ان کے پاس آئی۔ اس نے کہا: کیا تم وہ ہو جو فلاں فلاں کہتی ہو؟ اس نے کہا: میں کیوں نہ کہوں جو رسول اللہ صلی اللہ علیہ وسلم نے فرمایا ہے؟ ! ابو عبدالرحمٰن نے کہا: منصور کی حدیث کے صحیح ہونے کا زیادہ امکان ہے، اور خدا ہی بہتر جانتا ہے۔"""""""
"9031","ہم سے محمد بن المثنیٰ نے بیان کیا، فرمایا کہ ہم سے محمد بن جعفر نے بیان کیا، انہوں نے فرمایا: ہم سے شعبہ نے بیان کیا، سلیمان عماش سے، انہوں نے ابراہیم کی سند سے، انہوں نے کہا: وہ خدا کے بندے تھے، وہ فرماتے ہیں: ”خدا نے گودنے والی عورتوں پر لعنت کی ہے، ان عورتوں پر جو اپنے چہرے کو ظاہر کرتی ہیں، اور میں اس پر لعنت نہیں کرتا جو رسول کے منہ پر لعنت بھیجتی ہے۔ خدا کی طرف سے، خدا اس پر رحم کرے اور اسے سلامتی عطا فرمائے؟!\ (صلی اللہ علیہ وآلہ وسلم)"""""""
"9032","ہم سے احمد بن حرب نے بیان کیا، انہوں نے کہا: ہم سے ابو معاویہ نے بیان کیا، انہوں نے الاعمش کی سند سے، انہوں نے ابراہیم کی سند سے، انہوں نے کہا: عبداللہ رضی اللہ عنہ نے کہا: اللہ ان عورتوں پر لعنت کرے جو اپنے بال بچھاتی ہیں۔ حدیث کا سلسلہ"
"9033","ہم سے محمد بن عبد العلا نے بیان کیا، انہوں نے فرمایا: ہم سے خالد نے بیان کیا، انہوں نے کہا: ہم سے ابان نے جو ابن سمعہ ہیں، اپنی والدہ سے بیان کیا، انہوں نے کہا: میں نے عائشہ رضی اللہ عنہا سے سنا، وہ کہتی ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے گودنے والی عورت، گودنے والی عورت، طاغوت والی عورت، طاغوت والی عورت، طاغوت والی عورت سے منع فرمایا۔ hyphenated عورت، نامکمل ٹیٹو کے ساتھ، اور ingrown عورت"
"9034","ہم سے اسماعیل بن مسعود نے بیان کیا، انہوں نے کہا کہ ہم سے خالد نے شعبہ کی سند سے، انہوں نے سلیمان کی سند سے، انہوں نے کہا: میں نے عبداللہ بن مرہ رضی اللہ عنہ کو کہتے سنا، حارث کی سند سے، انہوں نے عبداللہ رضی اللہ عنہ سے کہا: سود کھانے والا، سود دینے والا، اور اسے لکھنے والا اور لکھنے والے کو معلوم ہو، اور اگر وہ اسے لکھے تو وہ سب جانتے ہیں۔ ٹیٹو خوبصورت چیزیں۔\ \""صدقہ جمع کرنے والا اور ہجرت کے بعد مرتد عرب پر قیامت کے دن محمد صلی اللہ علیہ وسلم کی زبانی لعنت ہو گی۔\"""""""""
"9035","ہم کو زیاد بن ایوب نے خبر دی، انہوں نے کہا کہ ہم سے ہشیم نے بیان کیا، انہوں نے کہا: ہم کو حسین، مغیرہ اور ابن عون نے خبر دی، انہیں شعبی کی سند سے، حارث رضی اللہ عنہ سے، انہوں نے علی رضی اللہ عنہ سے کہ رسول اللہ صلی اللہ علیہ وسلم نے بیان کیا، انہوں نے کہا کہ ہمیں کھانے والے پر لعنت بھیجنے والے پر لعنت ہے۔ نیچے، وہ جو صدقہ سے روکتا تھا، اور نوحہ کرنے سے منع کرتا تھا۔\"" 9036"""""""
"9036","حمیڈ بن مسعدہ نے ہمیں بتایا، انہوں نے کہا: یزید نے ہمیں بتایا، یعنی ابن زریع، انہوں نے کہا: ابن عون نے ہمیں بتایا، شعبی سے، حارث سے، انہوں نے کہا: ""محمد ﷺ نے لعنت کی: سود کھانے والے پر، سود دینے والے پر، اس کی گواہی دینے والے پر، اس کو لکھنے والے پر، گودنا گوندھنے والی عورت پر اور گودنا گوندھوانے والی عورت پر۔"" انہوں نے کہا: میں نے پوچھا: کیا بیماری کی صورت میں؟ انہوں نے کہا: جی ہاں، ""اور حلالہ کرنے والے پر اور جس کے لئے حلالہ کیا جائے پر، اور زکات روکنے والے پر، اور رونے پیٹنے سے منع فرمایا""، اور ""لعنت"" نہیں کہا۔"
"9037","ہم سے قتیبہ بن سعید نے بیان کیا، انہوں نے کہا کہ ہم سے خلف یعنی ابن خلیفہ نے بیان کیا، انہوں نے عطاء بن السائب کی سند سے، انہوں نے الشعبی کی سند سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”رسول اللہ صلی اللہ علیہ وسلم نے ان پر لعنت کی، اللہ تعالیٰ اس پر لعنت فرمائے اور اس پر جو سود کھاتا ہے، سود لینے والا، دو لکھنے والا۔ اس پر گواہی دینے والا، حلال کرنے والا، حلال کرنے والا، سود دینے والا، اس نے نوحہ کرنے والا، اور اس نے اپنے ساتھی پر لعنت نہیں کی۔"
"9038","ہم کو اسحاق بن ابراہیم نے خبر دی، انہوں نے کہا: ہم کو جریر نے عمارہ سے، انہوں نے ابو زرعہ سے، انہوں نے ابوہریرہ رضی اللہ عنہ سے، انہوں نے کہا: عمر رضی اللہ عنہ کو ایک عورت سونگھ رہی تھی، انہوں نے کہا: میں آپہیں خدا کی قسم دیتا ہوں، کیا آپ میں سے کسی نے رسول اللہ صلی اللہ علیہ وسلم سے سنا ہے؟ ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ میں نے کہا: اے امیر المومنین، میں نے اسے سنا۔ اس نے کہا: تم نے کیا سنا؟ تو میں نے کہا: میں نے اسے یہ کہتے ہوئے سنا: \بدبو نہ آؤ اور نہ ہی ٹیٹو کرو۔\"""""""""
"9039","ہم سے ابو علی محمد بن یحییٰ المروزی نے بیان کیا، کہا کہ ہم سے عبداللہ بن عثمان نے ابو حمزہ محمد بن میمون السکری سے، انہوں نے عبد الملک بن عمیر کے واسطہ سے، عریان بن الہیثم کے واسطہ سے، انہوں نے قبیصہ بن مسیب رضی اللہ عنہ سے کہ میں نے رسول اللہ صلی اللہ علیہ وسلم سے سنا۔ خدا کی دعا اور سلامتی ہو آپ پر، \لعنت ہے وہ عورتیں جو اپنے آپ کو زیب تن کرتی ہیں، وہ عورتیں جو اپنے آپ کو ظاہر کرتی ہیں، اور وہ عورتیں جو ٹیٹو بنواتی ہیں جو اللہ تعالی کی تخلیق کو بدل دیتی ہیں۔\"""""""""
"9040","ہم سے محمد بن معمر نے بیان کیا، انہوں نے کہا کہ ہم سے یحییٰ بن حماد نے بیان کیا، انہوں نے کہا: ہم سے ابو عوانہ نے عبدالمالک بن عمیر سے، انہوں نے عریان بن الہیثم سے، انہوں نے قبیصہ بن جبیر رضی اللہ عنہ سے بیان کیا، انہوں نے کہا کہ عبداللہ رضی اللہ عنہ نے کہا: میں نے رسول اللہ صلی اللہ علیہ وسلم کو عورتوں سے استغفار کرتے ہوئے سنا۔ \"" 9041"""""""
"9041","ابراہیم بن یعقوب نے ہمیں بتایا، انہوں نے کہا: علی بن حسن بن شقِیق نے ہمیں بتایا، انہوں نے کہا: میں حسین بن واقد ہوں، انہوں نے کہا: عبدالملک بن عمیر نے، عریان بن ہیتھم سے، قبیصہ بن جابر سے، انہوں نے کہا: ابن مسعود رضی اللہ عنہ نے کہا: میں نے رسول اللہ ﷺ کو یہ کہتے سنا: ""اللہ نے ان عورتوں پر لعنت بھیجی جو بھونہیں بنواتی ہیں، جو دانتوں میں خلا پیدا کرتی ہیں، اور جو گودنا گوندھتی ہیں جو اللہ عزوجل کی مخلوق کو بدلتی ہیں۔"""""""
"9042","ہم سے محمد بن حاتم المروازی نے بیان کیا، فرمایا کہ ہم سے حبان بن موسیٰ المروازی نے بیان کیا، کہا: میں عبداللہ ہوں، حیوہ بن شریح سے، انہوں نے کہا: مجھ سے عیاش بن عباس الکتبانی نے ابو الحسین حمیری سے بیان کیا، انہوں نے ان سے بیان کیا کہ وہ ابو الحسین رضی اللہ عنہ سے اپنے ایک دوست کے بارے میں سیکھ رہے تھے۔ اس نے کہا: میرا دوست ایک دن آیا، لیکن میں حاضر نہیں ہوا۔ تو میرے دوست نے مجھ سے بیان کیا کہ اس نے ابو ریحانہ کو کہتے سنا: \رسول اللہ صلی اللہ علیہ وسلم نے چاٹنے، گودنے اور نوچنے سے منع فرمایا ہے۔\"""""""""
"9043","ہم سے احمد بن عمرو بن سرح نے بیان کیا، انہوں نے کہا: میں ابن وہب ہوں، انہوں نے کہا: مجھے لیث نے خبر دی، یزید بن ابی حبیب سے، میرے والد الحسین الحمیری سے اور ابو ریحانہ کی سند سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے آپ صلی اللہ علیہ وسلم پر رحمت نازل فرمائی۔"
"9044","ہم سے قتیبہ بن سعید نے بیان کیا، انہوں نے کہا: ہم سے لیث نے بیان کیا، وہ یزید بن ابی حبیب سے، انہوں نے ابو الحسین الحمیری سے، انہوں نے ابو ریحانہ کی سند سے، انہوں نے کہا: ہمیں معلوم ہوا کہ رسول اللہ صلی اللہ علیہ وسلم نے طاغوت سے منع فرمایا ہے۔"
"9045","ہم سے قتیبہ بن سعید نے بیان کیا، کہا: ہم سے داؤد نے، جو عبدالرحمٰن ابو سلیمان العطار کے بیٹے ہیں، انہوں نے عبداللہ بن عثمان بن خثیم سے، وہ سعید بن جبیر سے، انہوں نے ابن عباس رضی اللہ عنہما سے بیان کیا کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: آپ صلی اللہ علیہ وسلم نے فرمایا: ”آپ صلی اللہ علیہ وسلم نے فرمایا: ithmid \یہ نظر کو تیز کرتا ہے اور بالوں کو بڑھاتا ہے۔\"""""""""
"9046","ہم سے محمد بن المثنیٰ نے بیان کیا، انہوں نے فرمایا: ہم سے ابوداؤد جو الطیالسی ہیں، انہوں نے کہا: ہم سے شعبہ نے بیان کیا، انہوں نے سماک کی سند سے، انہوں نے کہا: میں نے جابر بن سمرہ رضی اللہ عنہ کو سنا، ان سے نبی کریم صلی اللہ علیہ وسلم کے سفید بالوں کے بارے میں پوچھا گیا۔ آپ صلی اللہ علیہ وسلم نے فرمایا: ”جب اس نے اپنے سر پر تیل لگایا تو اس میں سے کچھ نظر نہ آئے گا اور اگر اس نے تیل نہ لگایا تو اس کا کچھ حصہ نظر آئے گا۔"
"9047","ہم سے محمد بن علی بن میمون الرقی نے بیان کیا، انہوں نے کہا کہ ہم سے القنبی نے بیان کیا، انہوں نے کہا: ہم سے عبداللہ بن زید نے اپنے والد سے بیان کیا کہ ابن عمر رضی اللہ عنہما اپنے کپڑوں کو زعفران سے رنگ رہے تھے، اور ان سے کہا گیا: انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم وفات پا رہے تھے۔"
"9048","ہم سے ابو عبیدہ بن ابی الصفار نے عبد الصمد بن عبد الوارث کی سند سے بیان کیا، انہوں نے کہا: ہم سے بکر المزلق نے بیان کیا، انہوں نے کہا: ہم سے عبداللہ نے بیان کیا، ان سے ابن عطا الہاشمی نے، انہوں نے محمد بن علی رضی اللہ عنہ سے روایت کی، انہوں نے کہا: میں نے عائشہ رضی اللہ عنہا سے پوچھا: کیا رسول اللہ صلی اللہ علیہ وسلم نے اسے استعمال کیا تھا؟ اس نے کہا: ہاں، \عطر کو یاد کرنا: کستوری اور عنبر۔\"""""""""
"9049","ہم سے احمد بن سلیمان نے بیان کیا، انہوں نے کہا: ہم سے ابوداؤد یعنی الحفاری نے بیان کیا، انہوں نے سفیان کی سند سے، وہ الجریری کی سند سے، ابو نادرہ نے ایک آدمی کی سند سے، انہوں نے ابوہریرہ رضی اللہ عنہ سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”اس کا مفہوم صحیح ہے، اور یہ صحیح ہے۔ عورتوں کا عطر وہ ہے جو اس کا رنگ ظاہر اور پوشیدہ ہوتا ہے۔\ \""اس کی خوشبو\"""""""""
"9050","ہم سے محمد بن علی بن میمون الرقی نے بیان کیا، انہوں نے کہا: ہم سے محمد بن یوسف نے بیان کیا، یعنی الفریابی نے، انہوں نے کہا: ہم سے سفیان نے الجریری سے، انہوں نے ابو نضرہ سے، الطفوی سے، ابوہریرہ رضی اللہ عنہ سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: مرد کی خوشبو اس وقت تک ہے جب تک اس کی خوشبو ظاہر ہو اور اس کا رنگ چھپا ہو اور عورتوں کے لیے عطر اس وقت تک ہے جب تک اس کا رنگ ظاہر ہو اور اس کی خوشبو لطیف ہو۔"
"9051","ہم سے اسحاق بن ابراہیم نے بیان کیا، انہوں نے کہا: میں وکیع ہوں، انہوں نے کہا: ہم سے عذرہ بن ثابت نے بیان کیا، وہ ثمامہ بن عبداللہ بن انس سے، انہوں نے انس بن مالک رضی اللہ عنہ سے روایت کی کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”جب خوشبو لایا جاتا آپ اسے واپس نہیں کرتے تھے۔"
"9052","مجھ سے عبید اللہ بن فضلہ بن ابراہیم نے بیان کیا۔ اس نے کہا: میں عبداللہ بن یزید المقری ہوں۔ فرمایا: سعید ابی ایوب کے بیٹے ہیں۔ انہوں نے کہا: مجھے عبید اللہ بن ابی جعفر نے العرج کی سند سے، ابوہریرہ رضی اللہ عنہ سے، رسول اللہ صلی اللہ علیہ وسلم سے روایت کی کہ آپ صلی اللہ علیہ وسلم نے فرمایا: جس شخص کو خوشبو لگائی جاتی ہے، لیکن وہ اسے رد نہیں کرتا، کیونکہ اس کی طبیعت ہلکی ہوتی ہے اور اس میں نرمی ہوتی ہے۔"
"9053","ہم سے عبدالرحمٰن بن محمد بن سلام نے بیان کیا، انہوں نے فرمایا کہ ہم سے شبابہ بن سیور نے بیان کیا، انہوں نے کہا: ہم سے شعبہ نے بیان کیا، وہ خالد بن جعفر ثقہ ہیں، انہوں نے ابو نضرہ رضی اللہ عنہ سے، انہوں نے ابو سعید خدری رضی اللہ عنہ سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے بعثت رضی اللہ عنہ سے فرمایا: ”میں نے ایک عورت سے پوچھا: ایک سونے کی انگوٹھی اور اس میں کستوری بھری۔ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: \یہ بہترین خوشبو ہے۔\"""""""""
"9054","ہم سے ابوبکر بن اسحاق الصغانی نے بیان کیا، انہوں نے کہا: مجھ سے عبدالرحمٰن بن غزوان نے بیان کیا، وہ قراد تھے، انہوں نے کہا: میں شعبہ ہوں، خالد رضی اللہ عنہ سے۔ ابن جعفر، اور المستمل البصری، ابو نضرہ سے، ابو سعید کی روایت سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے ایک عورت کا ذکر کیا جس نے اس سے ہمبستری کی، آپ صلی اللہ علیہ وسلم نے اس کا اختتام کستوری سے کیا، اور فرمایا: یہ بہترین خوشبو ہے۔"
"9055","ہمیں محمد بن عمر بن علی بن مقدام نے خبر دی، کہا کہ ہم سے زکریا بن یحییٰ بن یحییٰ بن عمارہ الانصاری نے بیان کیا، انہوں نے عبدالعزیز بن صہیب سے، انہوں نے انس رضی اللہ عنہ سے، انہوں نے کہا کہ رسول اللہ صلی اللہ علیہ وسلم نے آدمی کو اپنی کھال پر زعفران منڈوانے سے منع فرمایا ہے۔"
"9056","ہم سے اسحاق بن ابراہیم نے اسماعیل کی سند سے، عبدالعزیز کی سند سے، انہوں نے انس رضی اللہ عنہ سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے آدمی کے لیے دم گھٹنے سے منع فرمایا ہے۔"
"9057","ہم سے محمد بن منصور نے بیان کیا، انہوں نے فرمایا: ہم سے سفیان نے بیان کیا، انہوں نے عمران بن ذبیان سے، انہوں نے حکیم بن سعد سے، انہوں نے ابوہریرہ رضی اللہ عنہ سے، انہوں نے کہا: ایک آدمی نبی کریم صلی اللہ علیہ وسلم کے پاس آیا اور اس نے دوسری مخلوقات کی ڈھال پہن رکھی تھی۔ نبی کریم صلی اللہ علیہ وسلم نے اس سے کہا: \جاؤ، وہ اسے ختم کر دے گا۔\"" پھر وہ اس کے پاس آیا۔ آپ آپ صلی اللہ علیہ وسلم نے فرمایا: ”جاؤ اور اسے پہنا دو۔ پھر وہ اس کے پاس آیا، اور اس نے کہا: جاؤ، اسے پہناؤ۔ پھر وہ اس کے پاس آیا، اور کہا: جاؤ، اسے پہناؤ، پھر واپس نہ آنا۔ \"""""""""
"9058","ہم سے محمد بن عبد العلا نے بیان کیا، فرمایا کہ ہم سے خالد بن حارث نے بیان کیا، انہوں نے کہا: ہم سے شعبہ نے بیان کیا، وہ عطاء بن السائب کی سند سے، انہوں نے کہا: میں نے ابو حفص بن عمرو کو سنا، پھر انہوں نے کہا: ان کے بعد انہوں نے علی بن مرہ رضی اللہ عنہ سے روایت کی، کہ وہ نبی کریم صلی اللہ علیہ وسلم کے پاس سے گزرے، آپ صلی اللہ علیہ وسلم ایک اضطراب کی حالت میں تھے۔ کہا آپہاری بیوی ہے؟ میں نے کہا: نہیں، آپ صلی اللہ علیہ وسلم نے فرمایا: ”آپ اسے دھو، پھر اسے دھو، پھر واپس نہ آنا۔"
"9059","ہم سے محمود بن غیلان نے بیان کیا، انہوں نے کہا: ہم سے ابوداؤد نے بیان کیا، انہیں شعبہ نے، انہوں نے عطاء کی سند سے، انہوں نے کہا: میں نے ابو حفص عمر رضی اللہ عنہ سے سنا کہ وہ یعلیٰ بن ایک مرتبہ رسول اللہ صلی اللہ علیہ وسلم سے سنا، انہوں نے ایک آدمی کو پراگندہ حالت میں دیکھا، آپ آپ صلی اللہ علیہ وسلم نے فرمایا: ”جاؤ اور وہ واپس نہ آیا۔ ہم سے محمد بن المثنیٰ نے بیان کیا، انہوں نے فرمایا: ہم سے ابوداؤد نے بیان کیا، کہا ہم سے شعبہ نے بیان کیا، وہ عطاء کے واسطہ سے، ابو عمرو رضی اللہ عنہ سے، ایک آدمی سے، انہوں نے علی رضی اللہ عنہ کی طرف سے۔"
"9060","ہم سے محمد بن نضر بن مسور نے بیان کیا، انہوں نے فرمایا: ہم سے سفیان نے عطاء بن السائب سے، عبداللہ بن حفص سے اور یعلیٰ بن ثقفی کی سند سے بیان کیا، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے ایک مرتبہ فرمایا: اے اللہ کے رسول صلی اللہ علیہ وسلم نے ایک عورت یا علی رضی اللہ عنہ کی موجودگی کو دیکھا، آپ نے فرمایا: کیا آپ کے پاس عورت ہے؟ میں نے کہا: نہیں، آپ صلی اللہ علیہ وسلم نے فرمایا: ”اسے دھو، پھر نہ دہراؤ، پھر اسے دھوؤ، پھر نہ دو، پھر اسے دھوؤ، پھر اسے نہ دو۔ اس نے کہا: تو میں نے اسے دھویا، پھر دوبارہ نہ کرو۔ میں واپس آیا، پھر میں نے اسے دھویا، پھر میں نے اسے دوبارہ نہیں کیا، پھر میں نے اسے دھویا، پھر میں نے اسے دوبارہ نہیں کیا۔"
"9061","مجھ سے اسماعیل بن یعقوب الصبی نے بیان کیا، انہوں نے کہا: ہم سے محمد بن موسیٰ بن عیان نے بیان کیا، انہوں نے فرمایا: ہم سے میرے والد نے عطاء بن سائب سے، انہوں نے عبداللہ بن حفص رضی اللہ عنہ سے، انہوں نے یعلی رضی اللہ عنہ سے کہا: میں رسول اللہ صلی اللہ علیہ وسلم کے پاس سے گزرا، آپ صلی اللہ علیہ وسلم نے فرمایا: کیا آپ عورت ہو؟\ میں نے کہا: نہیں، آپ صلی اللہ علیہ وسلم نے فرمایا: ”جاؤ اسے دھو لو، پھر اسے دھو لو، پھر اسے دھو لو، پھر واپس نہ آنا“۔ اس نے کہا: تو میں نے جا کر اسے غسل دیا۔ پھر میں نے اسے دھویا، پھر میں نے اسے دھویا، پھر میں نے اسے دوبارہ نہیں دھویا۔"""""""
"9062","ہم سے اسماعیل بن مسعود نے بیان کیا، انہوں نے کہا: ہم سے خالد نے بیان کیا، انہوں نے کہا: ہم سے ثابت نے جو ابن عمارہ ہیں، انہوں نے غنم بن قیس سے، انہوں نے اشعری رضی اللہ عنہ سے کہا: رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”جو عورت خوشبو لگائے اور اس کے پاس سے گزرے وہ بالغ ہو سکتی ہے“۔ \"" 9063"""""""
"9063","محمد بن اسماعیل بن ابراہیم نے ہمیں بتایا، انہوں نے کہا: سلیمان نے ہمیں بتایا، اور وہ داؤد بن علی بن عبداللہ بن عباس ہاشمی کے بیٹے ہیں، انہوں نے کہا: ابراہیم بن سعد نے ہمیں بتایا، انہوں نے کہا: میں نے صفوان بن سلیم کو سنا، اور میں نے صفوان سے اس کے سوا کچھ نہیں سنا، وہ بتاتے ہیں، پانچ قابل اعتماد مردوں سے، ابو ہریرہ رضی اللہ عنہ سے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: ""جب عورت مسجد میں جائے تو وہ خوشبو نہ لگائے، جیسے وہ جنابت سے غسل کرتی ہے۔"" مختصر۔"
"9064","ہم سے محمد بن ہشام بن عیسیٰ البغدادی نے بیان کیا، انہوں نے فرمایا کہ ہم سے ابو علقمہ الفروی عبداللہ بن محمد نے بیان کیا، انہوں نے کہا: یزید بن خصیفہ، بسر بن سعید سے، انہوں نے ابوہریرہ رضی اللہ عنہ سے، انہوں نے کہا: رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”جو عورت ہم سے جلنے والی عورت کے ساتھ نہ ہو، اس نے کہا: ابوعبدالرحمٰن کہتے ہیں: ہم نہیں جانتے کہ کسی نے یزید بن خصیفہ کی پیروی کی ہو، اس نے ابوہریرہ کی روایت سے، اور یعقوب بن عبد نے اس سے اختلاف کیا۔ اللہ بن اشجج نے بسر بن سعید سے اور زینب ثقفیہ سے روایت کی ہے۔"
"9065","مجھ سے ہلال بن علاء بن ہلال نے بیان کیا، انہوں نے کہا: ہم سے معاذ بن اسد البصری نے بیان کیا، انہوں نے کہا: ہم سے وہیب نے محمد بن عجلان سے، انہوں نے یعقوب بن عبداللہ بن اشجع رضی اللہ عنہ سے، بسر بن سعید رضی اللہ عنہ سے، انہوں نے کہا کہ رسول اللہ صلی اللہ علیہ وسلم اور عبداللہ رضی اللہ عنہ کی بیوی پر رحمت نازل ہوئی۔ اسے سلامتی عطا فرما، عورتوں کے لیے فرمایا: ’’جب تم میں سے کوئی عشاء کی نماز میں حاضر ہو تو خوشبو کو ہاتھ نہ لگائے‘‘۔"
"9066","ہم سے عبید اللہ بن سعید نے بیان کیا، انہوں نے کہا کہ ہم سے یحییٰ بن سعید نے بیان کیا، انہوں نے ابن عجلان سے، انہوں نے کہا: مجھ سے بکر بن عبداللہ بن اشجج نے بیان کیا، انہوں نے بسر بن سعید سے، انہوں نے عبداللہ رضی اللہ عنہ کی بیوی زینب رضی اللہ عنہا سے روایت کی کہ میں نے رسول اللہ صلی اللہ علیہ وسلم سے فرمایا: آپ میں سے رات کے کھانے میں شرکت کرتے ہیں خوشبو کو مت چھونا کرو۔\"" 9067"""""""
"9067","اسحاق بن ابراہیم نے ہمیں بتایا، انہوں نے کہا: جریر بن عبدالحمید نے مجھے بتایا، ابن عجلان سے، بکیر بن عبداللہ بن الاشج سے، بشر بن سعید سے، زینب سے، جو عبداللہ کی بیوی تھی، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: ""جب تم میں سے کوئی عشاء کی نماز کے لئے حاضر ہو تو خوشبو کو نہ چھوئے۔"" ابو عبدالرحمن نے کہا: اور یحیٰ بن سعید اور جریر کی حدیث وہیب بن خالد کی حدیث سے زیادہ صحیح ہے، اور اللہ تعالیٰ بہتر جانتا ہے۔"
"9068","ہم سے قتیبہ بن سعید نے بیان کیا، انہوں نے کہا: ہم سے لیث نے بیان کیا، انہوں نے عبید اللہ بن ابی جعفر سے، وہ بکیر بن عبداللہ الاشجع سے، انہوں نے بسر بن سعید سے، انہوں نے زینب ثقفیہ رضی اللہ عنہا سے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”اللہ تعالیٰ نے مسجد سے باہر نکلنے کی اجازت نہیں دی۔ عطر پیش کریں۔\"" 9069"""""""
"9069","احمد بن سعید بن یعقوب حمصی نے مجھے بتایا، انہوں نے کہا: عثمان بن سعید نے ہمیں بتایا، انہوں نے کہا: لیتھ نے ہمیں بتایا، بکیر بن الاشج سے، بشر بن سعید سے، زینب ثقفیہ سے، کہ اللہ کے نبی ﷺ نے فرمایا: ""تم میں سے جو عورت مسجد میں نکلے، تو وہ خوشبو کے قریب نہ جائے۔"" ابو عبدالرحمن نے کہا: اور قتیبہ کی حدیث اس کے بعد والی حدیث سے زیادہ صحیح ہے، اور اللہ بہتر جانتا ہے۔"
"9070","ہم سے عمرو بن علی نے بیان کیا، انہوں نے کہا کہ ہم سے ابوداؤد نے بیان کیا، انہوں نے کہا: ہم سے ابراہیم بن سعد نے بیان کیا، وہ محمد بن عبداللہ القرشی سے، وہ بکیر بن اشجع سے، انہوں نے بسر بن سعید سے، انہوں نے زینب ثقفی رضی اللہ عنہ سے کہ رسول اللہ صلی اللہ علیہ وسلم نے ان کی بیوی کو سلام کیا۔ \اسے حکم دیا\"" \""کہ جب وہ آخرت کے لیے باہر نکلے تو وہ عطر کو ہاتھ نہ لگائے۔\"""""""""
"9071","ہم سے احمد بن سعید الرباطی نے بیان کیا، کہا کہ ہم سے یعقوب بن ابراہیم نے بیان کیا، انہوں نے کہا: ہم سے ابی نے صالح کی سند سے، محمد بن عبداللہ بن عمرو بن ہشام سے، بکر بن عبداللہ بن اشجع کے واسطہ سے، انہوں نے کہا: بسر بن صعیفہ خاتون نے بیان کیا۔ مجھے عبداللہ رضی اللہ عنہ نے بتایا کہ رسول اللہ صلی اللہ علیہ وسلم نے ان سے فرمایا: ”جب آپ رات کے کھانے کے لیے باہر جاؤ تو تروتازہ نہ ہو۔"
"9072","ہم سے ابوبکر بن علی نے بیان کیا، انہوں نے کہا کہ ہم سے منصور بن ابی مظہم نے بیان کیا، انہوں نے کہا: ہم سے ابراہیم بن سعد نے اپنے والد سے، محمد بن عبداللہ بن عمرو بن ہشام سے، بقیر سے، بسر بن سعید کے واسطہ سے، انہوں نے زینب رضی اللہ عنہا سے کہ اللہ کے رسول صلی اللہ علیہ وسلم ان پر رحمت نازل فرمائیں۔ آپ صلی اللہ علیہ وسلم نے فرمایا: ”اگر کوئی عورت آخرت کے لیے نکلے تو اسے خوشبو کو ہاتھ نہیں لگانا چاہیے۔ ابوعبدالرحمٰن نے کہا: یعقوب کی حدیث کے صحیح ہونے کا زیادہ امکان ہے، اور اللہ ہی بہتر جانتا ہے۔"
"9073","مجھ سے یوسف بن سعید نے بیان کیا، انہوں نے کہا: انہوں نے مجھے حجاج کی سند سے، ابن جریج کی سند سے، زیاد بن سعد نے ابن شہاب کی سند سے، بسر بن سعید نے، زینب ثقفیہ سے، انہوں نے مجھے خبر دی، رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: \جب آپ میں سے کوئی نماز پڑھے تو خوشبو کو ہاتھ نہ لگائے۔\"" ابو عبدالرحمٰن نے کہا: یہ زہری کی حدیث سے محفوظ نہیں ہے، اور خدا بہتر جانتا ہے۔"""""""
"9074","ہم کو احمد بن عمرو بن سرح ابو طاہر نے خبر دی، کہا کہ ہمیں ابن وہب نے خبر دی، کہا: مجھے مخرمہ نے اپنے والد سے اور نافع کی سند سے خبر دی، انہوں نے کہا: ابن عمر رضی اللہ عنہ کہتے تھے کہ اگر وہ اپنے بدن کو بغیر چھلے ہوئے مسببر سے اور کافور سے صاف کرتے آپ اسے مسببر سے پھینک دیتے، پھر رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: اجتمار کرنا"
"9075","ہم سے وہب بن بیان نے بیان کیا، انہوں نے کہا: ہم سے ابن وہب نے بیان کیا، انہوں نے کہا: ہم سے عمرو بن حارث نے بیان کیا، کہ ابو اشعنہ المعفری ہے۔ انہوں نے بیان کیا کہ میں نے عقبہ بن عامر رضی اللہ عنہ کو یہ کہتے ہوئے سنا کہ رسول اللہ صلی اللہ علیہ وسلم اپنے گھر والوں سے زیورات اور ریشم روک رہے تھے۔ وہ کہتا ہے: ’’اگر تمہیں جنت کے زیورات اور ریشم پسند ہیں تو انہیں دنیا میں مت پہنو۔‘‘"
