hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"4201","1445 - (  4200  ) -  حَدَّثَنَا  الْوَلِيدُ بْنُ شُجَاعٍ أَبُو هَمَّامٍ ،  حَدَّثَنَا  بَقِيَّةُ ،  حَدَّثَنِي  عُثْمَانُ بْنُ زُفَرَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَمَّنْ  سَمِعَ  أَنَسَ بْنَ مَالِكٍ ، يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا جَامَعَ أَحَدُكُمْ أَهْلَهُ  فَلْيُصْدِقْهَا  ، فَإِنْ سَبَقَهَا فَلَا يُعْجِلْهَا  .","","Musnad Abi Ya'la al-Mawsili 4200","","أنس بن مالك عن عمن عن ابن جريج عن عثمان بن زفر الجهني عن بقية بن الوليد عن الوليد بن شجاع عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4202","1446 - (  4201  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ ،  حَدَّثَنَا  عَبْدُ الْمَجِيدِ بْنُ عَبْدِ الْعَزِيزِ بْنِ أَبِي رَوَّادٍ ،  عَنِ  ابْنِ جُرَيْجٍ ، عَمَّنْ  حَدَّثَهُ  ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا جَامَعَ أَحَدُكُمْ         [7/209]      أَهْلَهُ  فَلْيُصْدِقْهَا  ، ثُمَّ إِذَا قَضَى حَاجَتَهُ قَبْلَ أَنْ تَقْضِيَ حَاجَتَهَا فَلَا يُعْجِلْهَا حَتَّى تَقْضِيَ حَاجَتَهَا  .","","Musnad Abi Ya'la al-Mawsili 4201","","أنس بن مالك عن عمن عن ابن جريج عن عبد المجيد بن عبد العزيز بن أبي رواد عن الوليد بن شجاع عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4203","1447 - (  4202  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ الْعَبْدِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي حَمْزَةَ جَارِنَا  يُحَدِّثُ ، عَنْ  أَنَسِ بْنِ مَالِكٍ ،  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِمُعَاذِ بْنِ جَبَلٍ  :  اعْلَمْ أَنَّهُ مَنْ شَهِدَ أَنْ لَا إِلَهَ إِلَّا اللهُ دَخَلَ الْجَنَّةَ  .","","Musnad Abi Ya'la al-Mawsili 4202","","أنس بن مالك عن عبد الرحمن بن عبد الله المازني عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4204","1448 - (  4203  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  مُوَرِّقٍ ،  عَنْ  أَنَسٍ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي سَفَرٍ ، فَمِنَّا الصَّائِمُ ، وَمِنَّا الْمُفْطِرُ ، فَنَزَلْنَا مَنْزِلًا فِي يَوْمٍ حَارٍّ ، أَكْثَرُنَا ظِلًّا لَأَصْحَابُ الْكِسَاءِ ، فَمِنَّا مَنْ يَتَّقِي الشَّمْسَ بِيَدِهِ ، قَالَ : فَسَقَطَ الصُّوَّامُ وَقَامَ الْمُفْطِرُونَ ، فَضَرَبُوا الْأَبْنِيَةَ ، وَسَقَوُا الرِّكَابَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ذَهَبَ الْمُفْطِرُونَ الْيَوْمَ بِالْأَجْرِ  .         [7/210]","","Musnad Abi Ya'la al-Mawsili 4203","","أنس بن مالك عن مورق العجلي عن عاصم بن سليمان الأحول عن أبو معاوية الضرير عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4205","1449 - (  4204  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  زَيْدٍ الْعَمِّيِّ ،  عَنْ  أَبِي إِيَاسٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لِكُلِّ أُمَّةٍ  رَهْبَانِيَّةٌ  ، وَرَهْبَانِيَّةُ هَذِهِ الْأُمَّةِ  الْجِهَادُ  فِي  سَبِيلِ  اللهِ  .         [7/211]","","Musnad Abi Ya'la al-Mawsili 4204","","أنس بن مالك عن معاوية بن قرة عن زيد بن الحواري العمي عن سفيان الثوري عن عبد الله بن المبارك عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4206","1450 - (  4205  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو دَاوُدَ الْحَفَرِيُّ عُمَرُ بْنُ سَعْدٍ ،  عَنْ  سُفْيَانَ الثَّوْرِيِّ ،  عَنْ  خَالِدٍ ،  عَنْ  أَبِي نَعَامَةَ ،  عَنْ  أَنَسٍ ، قَالَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأَبُو بَكْرٍ  ،  وَعُمَرُ  لَا يَقْرَءُونَ "" بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ  .","","Musnad Abi Ya'la al-Mawsili 4205","","أنس بن مالك عن قيس بن عباية الرماني عن خالد الحذاء عن سفيان الثوري عن عمر بن سعد بن عبيد الحفري عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4207","1451 - (  4206  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  ابْنُ عُلَيَّةَ ،  عَنِ  ابْنِ عَوْنٍ ،  عَنْ  أَنَسِ بْنِ سِيرِينَ ،  عَنْ  عَبْدِ الْحَمِيدِ بْنِ الْمُنْذِرِ بْنِ الْجَارُودِ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  صَنَعَ بَعْضُ عُمُومَتِي لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - طَعَامًا ، فَقَالَ : إِنِّي أُحِبُّ أَنْ تَأْكُلَ فِي بَيْتِي  وَتُصَلِّيَ فِيهِ ، قَالَ : فَأَتَاهُ وَفِي الْبَيْتِ  فَحْلٌ  مِنْ تِلْكَ الْفُحُولِ ، فَأَمَرَ بِجَانِبٍ مِنْهُ فَكُنِسَ وَرُشَّ ، فَصَلَّى وَصَلَّيْنَا مَعَهُ  .         [7/212]","","Musnad Abi Ya'la al-Mawsili 4206","","أنس بن مالك عن عبد الحميد بن المنذر العبدي عن أنس بن سيرين عن عبد الله بن عون بن أرطبان عن إسماعيل ابن علية عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4208","1452 - (  4207  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  حَدَّثَنَا  مَهْدِيُّ بْنُ مَيْمُونٍ ،         [7/213]      وَحَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  مَهْدِيِّ بْنِ مَيْمُونٍ ،  عَنْ  غَيْلَانَ ،  عَنْ  أَنَسٍ قَالَ :  إِنَّكُمْ تَعْمَلُونَ أَعْمَالًا هِيَ أَدَقُّ فِي أَعْيُنِكُمْ مِنَ الشَّعَرِ ، كُنَّا نَعُدُّهَا عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْمُوبِقَاتِ  .","","Musnad Abi Ya'la al-Mawsili 4207","","أنس بن مالك عن غيلان بن جرير المعولي عن مهدي بن ميمون المعولي عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4209","1453 - (  4208  ) -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ مُوسَى السُّدِّيُّ ،  حَدَّثَنَا  عَلِيُّ بْنُ عَابِسٍ ،  عَنْ  مُسْلِمٍ ،  عَنْ  أَنَسٍ ، قَالَ :  اسْتُنْبِئَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَ الِاثْنَيْنِ ، وَصُلِّيَ عَلَيْهِ يَوْمَ الثُّلَاثَاءِ  .","","Musnad Abi Ya'la al-Mawsili 4208","","أنس بن مالك عن مسلم بن كيسان البراد عن علي بن عابس الملائي عن إسماعيل بن موسى الفزاري عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4210","1454 - (  4209  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا         [7/214]      حَمَّادٌ ،  أَخْبَرَنَا  حُمَيْدٌ ،  عَنْ  مُوسَى بْنِ أَنَسِ بْنِ مَالِكٍ ،  عَنْ  أَنَسٍ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَقَدْ تَرَكْتُمْ  بِالْمَدِينَةِ  رِجَالًا مَا سِرْتُمْ مِنْ مَسِيرٍ ، وَلَا أَنْفَقْتُمْ مِنْ نَفَقَةٍ ، وَلَا قَطَعْتُمْ مِنْ وَادٍ إِلَّا كَانُوا مَعَكُمْ فِيهِ  ، قَالُوا : يَا رَسُولَ اللهِ ، وَكَيْفَ يَكُونُونَ مَعَنَا وَهُمْ  بِالْمَدِينَةِ  ؟ قَالَ : حَبَسَهُمُ الْعُذْرُ  .","","Musnad Abi Ya'la al-Mawsili 4209","","أنس بن مالك عن موسى بن أنس بن مالك الأنصاري عن حميد الطويل عن حماد بن سلمة عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4211","1455 - (  4210  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  سَلَّامُ بْنُ مِسْكِينٍ ،  حَدَّثَنَا  أَبُو ظِلَالٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ عَبْدًا فِي  جَهَنَّمَ  لَيُنَادِي أَلْفَ سَنَةٍ : يَا حَنَّانُ ، يَا مَنَّانُ ، قَالَ : فَيَقُولُ اللهُ : يَا  جِبْرِيلُ  ، ائْتِ عَبْدِي  ، قَالَ : فَيَنْطَلِقُ  جِبْرِيلُ  فَيَرَى أَهْلَ النَّارِ مُنْكَبِّينَ عَلَى وُجُوهِهِمْ ، قَالَ : فَيَرْجِعُ ، فَيَقُولُ : يَا رَبِّ ، لَمْ أَرَهُ ، قَالَ : فَيَقُولُ اللهُ : فَإِنَّهُ فِي مَكَانِ كَذَا وَكَذَا ، قَالَ : فَيَأْتِيهِ ، فَيَجِيءُ رَبَّهُ ، فَيَقُولُ اللهُ لَهُ : يَا عَبْدِي ، كَيْفَ وَجَدْتَ مَكَانَكَ وَمَقِيلَكَ ؟ قَالَ : فَيَقُولُ : يَا رَبِّ شَرَّ مَكَانٍ ، وَشَرَّ مَقِيلٍ ، قَالَ : فَيَقُولُ : رُدُّوا عَبْدِي ، فَيَقُولُ : يَا رَبِّ ، مَا كُنْتُ أَرْجُو أَنْ تَرُدَّنِي إِذْ أَخْرَجْتَنِي ، فَيَقُولُ : دَعُوا عَبْدِي  .         [7/215]","","Musnad Abi Ya'la al-Mawsili 4210","","أنس بن مالك عن هلال بن أبي هلال القسملي عن سلام بن مسكين النمري عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4212","1456 - (  4211  ) -  حَدَّثَنَا  زُهَيْرُ بْنُ حَرْبٍ ،  حَدَّثَنَا  يَزِيدُ ،  أَخْبَرَنَا  أَبُو ظِلَالٍ ، قَالَ  : دَخَلْتُ عَلَى أَنَسِ بْنِ مَالِكٍ ،  قَالَ لِي  : مَتَى ذَهَبَ بَصَرُكَ ؟ قَالَ : وَأَنَا ابْنُ سَنَتَيْنِ فِيمَا حَدَّثَنِي أَهْلِي ، قَالَ : أَفَلَا أُبَشِّرُكَ ؟ فَقُلْتُ : بَلَى ، فَقَالَ : مَرَّ  ابْنُ أُمِّ مَكْتُومٍ  عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَلَّمَ عَلَيْهِ ثُمَّ مَضَى ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ اللهَ يَقُولُ : مَا لِمَنْ أَخَذْتُ  كَرِيمَتَيْهِ  عِنْدِي جَزَاءٌ إِلَّا الْجَنَّةُ  .","","Musnad Abi Ya'la al-Mawsili 4211","","أنس بن مالك عن هلال بن أبي هلال القسملي عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4213","1457 - (  4212  ) -  حَدَّثَنَا  الصَّلْتُ بْنُ مَسْعُودٍ الْجَحْدَرِيُّ ،  حَدَّثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ ،  حَدَّثَنِي  أَبُو ظِلَالٍ ، قَالَ :  حَدَّثَنِي  أَنَسٌ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  سَلَكَ رَجُلَانِ         [7/216]      مَفَازَةً : أَحَدُهُمَا عَابِدٌ ، وَالْآخَرُ بِهِ  رَهَقٌ ،  فَعَطِشَ الْعَابِدُ حَتَّى سَقَطَ  ، فَجَعَلَ صَاحِبُهُ يَنْظُرُ إِلَيْهِ وَمَعَهُ مِيضَأَةٌ فِيهَا شَيْءٌ مِنْ مَاءٍ ، فَجَعَلَ يَنْظُرُ إِلَيْهِ وَهُوَ صَرِيعٌ ، فَقَالَ : وَاللهِ لَئِنْ مَاتَ هَذَا الْعَبْدُ الصَّالِحُ عَطَشًا وَمَعِي مَاءٌ ، لَا أُصِيبُ مِنَ اللهِ خَيْرًا أَبَدًا ، وَإِنْ سَقَيْتُهُ مَائِي لَأَمُوتَنَّ ، فَتَوَكَّلَ عَلَى اللهِ عَزَّ وَجَلَّ ، وَعَزَمَ وَرَشَّ عَلَيْهِ مِنْ مَائِهِ وَسَقَاهُ مِنْ فَضْلِهِ ، قَالَ : فَقَامَ حَتَّى قَطَعَا الْمَفَازَةَ ، قَالَ : فَيُوقَفُ الَّذِي بِهِ  رَهَقٌ  يَوْمَ الْقِيَامَةِ لِلْحِسَابِ ، فَيُؤْمَرُ بِهِ إِلَى النَّارِ ، فَتَسُوقُهُ الْمَلَائِكَةُ ، فَيَرَى الْعَابِدَ ، فَيَقُولُ : يَا فُلَانُ ، أَمَا تَعْرِفُنِي ؟ قَالَ : يَقُولُ : مَنْ أَنْتَ ؟ قَالَ : أَنَا فُلَانٌ الَّذِي آثَرْتُكَ عَلَى نَفْسِي يَوْمَ الْمَفَازَةِ ، قَالَ : يَقُولُ : بَلَى ، أَعْرِفُكَ ، قَالَ : فَيَقُولُ لِلْمَلَائِكَةِ : قِفُوا ، قَالَ : فَيُوقَفُ ، وَيَجِيءُ حَتَّى يَقِفَ وَيَدْعُوَ رَبَّهُ ، يَقُولُ : يَا رَبِّ ، قَدْ تَعْرِفُ يَدَهُ عِنْدِي ، وَكَيْفَ آثَرَنِي عَلَى نَفْسِهِ ، يَا رَبِّ هَبْهُ لِي ، فَيَقُولُ : هُوَ لَكَ ، قَالَ : وَيَجِيءُ فَيَأْخُذُ بِيَدِهِ فَيُدْخِلُهُ الْجَنَّةَ  .  قَالَ  الصَّلْتُ  : قَالَ  جَعْفَرٌ  : قُلْتُ : حَدَّثَكَ  أَنَسٌ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ : نَعَمْ .         [7/217]","","Musnad Abi Ya'la al-Mawsili 4212","","أنس بن مالك عن هلال بن أبي هلال القسملي عن جعفر بن سليمان الضبعي عن الصلت بن مسعود الجحدري عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4214","1458 - (  4213  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ زِيَادٍ الْبُرْجُمِيُّ ،  عَنْ  أَبِي الظِّلَالِ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  عَنْ  أُمِّهِ  ، قَالَ :  كَانَتْ لَهَا شَاةٌ ، فَجَمَعَتْ مِنْ سَمْنِهَا فِي  عُكَّةٍ  ، فَمَلَأَتِ  الْعُكَّةَ  ثُمَّ بَعَثَتْ بِهَا مَعَ  رَبِيبَةَ  ، فَقَالَتْ : يَا  رَبِيبَةُ  ، أَبْلِغِي هَذِهِ  الْعُكَّةَ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْتَدِمُ بِهَا ، فَانْطَلَقَتْ بِهَا  رَبِيبَةُ  حَتَّى أَتَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ : يَا         [7/218]      رَسُولَ اللهِ ،  عُكَّةُ  سَمْنٍ بَعَثَتْ بِهَا إِلَيْكَ  أُمُّ سُلَيْمٍ  ، قَالَ : فَرِّغُوا لَهَا  عُكَّتَهَا  ، فَفُرِّغَتِ  الْعُكَّةُ  ، فَدُفِعَتْ إِلَيْهَا ، فَانْطَلَقَتْ بِهَا ، فَجَاءَتْ  أُمُّ سُلَيْمٍ  ، فَرَأَتِ  الْعُكَّةَ  مُمْتَلِئَةً تَقْطُرُ ، فَقَالَتْ  أُمُّ سُلَيْمٍ  : يَا  رَبِيبَةُ  ، أَلَيْسَ أَمَرْتُكِ أَنْ تَنْطَلِقِي بِهَا إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ فَقَالَتْ : قَدْ فَعَلْتُ ، فَإِنْ لَمْ تُصَدِّقِينِي ، فَانْطَلِقِي فَسَلِي رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَانْطَلَقَتْ  أُمُّ سُلَيْمٍ  وَمَعَهَا  رَبِيبَةُ  ، فَقَالَتْ : يَا رَسُولَ اللهِ ، إِنِّي بَعَثَتْ إِلَيْكَ مَعَهَا  بِعُكَّةٍ  فِيهَا سَمْنٌ ، قَالَ : قَدْ فَعَلَتْ ، قَدْ جَاءَتْ بِهَا ، فَقَالَتْ : وَالَّذِي بَعَثَكَ بِالْهُدَى وَدِينِ الْحَقِّ إِنَّهَا لَمُمْتَلِئَةٌ تَقْطُرُ سَمْنًا ، قَالَ : فَقَالَ لَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَتَعْجَبِينَ أَنْ كَانَ اللهُ أَطْعَمَكِ كَمَا أَطْعَمْتِ نَبِيَّهُ ، كُلِي وَأَطْعِمِي  ، قَالَتْ : فَجِئْتُ الْبَيْتَ ، فَقَسَمْتُ فِي قَعْبٍ لَنَا كَذَا وَكَذَا ، وَتَرَكْتُ فِيهَا مَا ائْتَدَمْنَا مِنْهُ  شَهْرًا أَوْ شَهْرَيْنِ  .         [7/219]","","Musnad Abi Ya'la al-Mawsili 4213","","أم سليم أم أنس بن مالك عن أنس بن مالك عن هلال بن أبي هلال القسملي عن محمد بن زياد البرجمي عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4215","1459 - (  4214  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَسَدِيُّ ،  عَنْ  مُحَمَّدِ بْنِ سُلَيْمٍ ،  عَنْ  نَجِيحٍ أَبِي عَلِيٍّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  رَجَمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  وَأَبُو بَكْرٍ  ،  وَعُمَرُ  ، وَأَمْرُهُمَا سُنَّةٌ  .","","Musnad Abi Ya'la al-Mawsili 4214","","أنس بن مالك عن نجيح أبو علي عن محمد بن سليم الراسبي عن محمد بن عبد الله بن الزبير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4216","1460 - (  4215  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا         [7/220]      مُحَمَّدُ بْنُ الْحَسَنِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ سُلَيْمٍ ،  عَنْ  نَجِيحٍ أَبِي عَلِيٍّ ،  عَنْ  أَنَسٍ ، قَالَ :  رَجَمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  وَأَبُو بَكْرٍ  ،  وَعُمَرُ  ، وَأَمْرُهُمَا سُنَّةٌ  .","","Musnad Abi Ya'la al-Mawsili 4215","","أنس بن مالك عن نجيح أبو علي عن محمد بن سليم الراسبي عن محمد بن الحسن بن الزبير التل عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4217","1461 - (  4216  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  رَوْحٌ ،  حَدَّثَنَا  أُسَامَةُ بْنُ زَيْدٍ ،  عَنْ  حَفْصِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  أَنَسٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تُصَلُّوا عِنْدَ طُلُوعِ الشَّمْسِ ، وَلَا عِنْدَ غُرُوبِهَا  ، فَإِنَّهَا تَطْلُعُ وَتَغْرُبُ عَلَى قَرْنِ  شَيْطَانٍ  ، وَصَلُّوا بَيْنَ ذَلِكَ مَا شِئْتُمْ  .","","Musnad Abi Ya'la al-Mawsili 4216","","أنس بن مالك عن حفص بن عبيد الله بن أنس بن مالك الأنصاري عن أسامة بن زيد الليثي المدني عن روح بن عبادة القيسي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4218","1462 - (  4217  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  أَبُو خَالِدٍ ،  عَنِ  الْحَسَنِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  ثَعْلَبَةَ ،         [7/221]      عَنْ  أَنَسٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  عَجَبًا لِلْمُؤْمِنِ مَا يُقْضَى لَهُ قَضَاءٌ إِلَّا كَانَ خَيْرًا لَهُ  .","","Musnad Abi Ya'la al-Mawsili 4217","","أنس بن مالك عن ثعلبة بن مالك الكوفي عن الحسن بن عبيد الله النخعي عن سليمان بن حيان الأحمر عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4219","1463 - (  4218  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  جَرِيرٌ ،  حَدَّثَنَا  الْحَسَنُ بْنُ عُبَيْدِ اللهِ ،  عَنْ  ثَعْلَبَةَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  تَبَسَّمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ قَالَ :  عَجِبْتُ لِلْمُؤْمِنِ ، إِنَّ اللهَ لَا يَقْضِي لَهُ قَضَاءً إِلَّا كَانَ خَيْرًا لَهُ  .","","Musnad Abi Ya'la al-Mawsili 4218","","أنس بن مالك عن ثعلبة بن مالك الكوفي عن الحسن بن عبيد الله النخعي عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4220","1464 - (  4219  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  سَلَّامُ بْنُ مِسْكِينٍ ،  حَدَّثَنَا  يَزِيدُ الضَّبِّيُّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ  :  مَا صَلَّيْتُ خَلْفَ أَحَدٍ بَعْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَخَفَّ صَلَاةً مِنْ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَا أَوْجَزَ فِي تَمَامٍ  .         [7/222]","","Musnad Abi Ya'la al-Mawsili 4219","","أنس بن مالك عن يزيد بن نعامة الضبي عن سلام بن مسكين النمري عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4221","1465 - (  4220  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  يُونُسُ بْنُ مُحَمَّدٍ ،  عَنْ  فُلَيْحِ بْنِ سُلَيْمَانَ ،  عَنْ  هِلَالِ بْنِ عَلِيٍّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  لَمْ يَكُنْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  سَبَّابًا  وَلَا فَحَّاشًا  ، كَانَ يَقُولُ لِأَحَدِنَا عِنْدَ  الْمَعْتَبَةِ :  مَا لَهُ ،  تَرِبَتْ  يَمِينُهُ  .","","Musnad Abi Ya'la al-Mawsili 4220","","أنس بن مالك عن هلال بن علي بن أسامة عن فليح بن سليمان عن يونس بن محمد بن مسلم البغدادي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4222","1466 - (  4221  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  سَلَّامٌ ،         [7/223]      قَالَ :  حَدَّثَنِي  عَبْدُ الْعَزِيزِ بْنُ أَبِي جَمِيلَةَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، أَنَّهُ قَالَ :  إِنِّي لَأَعْرِفُ دَعْوَةَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِي ، أَنْ يُبَارِكَ لِي فِي مَالِي وَوَلَدِي  .","","Musnad Abi Ya'la al-Mawsili 4221","","أنس بن مالك عن عبد العزيز بن أبي جميلة الأنصاري عن سلام بن مسكين النمري عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4223","1467 - (  4222  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى الْخُتَّلِيُّ ،  حَدَّثَنَا  السَّهْمِيُّ أَبُو وَهْبٍ ،  حَدَّثَنَا  سُلَيْمَانُ الْحَضْرَمِيُّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا أَرَادَ اللهُ بِقَوْمٍ خَيْرًا ابْتَلَاهُمْ  .         [7/224]","","Musnad Abi Ya'la al-Mawsili 4222","","أنس بن مالك عن سليمان الحضرمي عن عبد الله بن بكر بن حبيب عن مجاهد بن موسى عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4224","1468 - (  4223  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  حَدَّثَنَا  مَرْوَانُ الْفَزَارِيُّ ،  حَدَّثَنَا  هِلَالٌ أَبُو مُعَلَّى بْنُ هِلَالٍ ، قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ ، وَهُوَ يَقُولُ :  أُهْدِيَتْ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثَلَاثُ طَوَائِرَ ، فَأَطْعَمَ خَادِمَهُ طَائِرًا ، فَلَمَّا كَانَ مِنَ الْغَدِ أَتَتْهُ بِهَا ، فَقَالَ لَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَلَمْ أَنْهَكِ أَنْ تَرْفَعِي شَيْئًا لِغَدٍ ، فَإِنَّ اللهَ يَأْتِي بِرِزْقِ كُلِّ غَدٍ  ؟  .         [7/225]","","Musnad Abi Ya'la al-Mawsili 4223","","أنس بن مالك عن هلال بن سويد الأحمري عن مروان بن معاوية الفزاري عن مجاهد بن موسى عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4225","1469 - (  4224  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ زُهَيْرُ بْنُ حَرْبٍ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  لَيْثٍ ،  عَنْ  عَبْدِ الْوَارِثِ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يُؤْتَى بِأَرْبَعَةٍ يَوْمَ الْقِيَامَةِ : بِالْمَوْلُودِ ،  وَبِالْمَعْتُوهِ  ، وَبِمَنْ مَاتَ فِي الْفَتْرَةِ ، وَالشَّيْخِ الْفَانِي  ، كُلُّهُمْ يَتَكَلَّمُ بِحُجَّتِهِ ، فَيَقُولُ الرَّبُّ تَبَارَكَ وَتَعَالَى لِعُنُقٍ مِنَ النَّارِ : ابْرُزْ ، فَيَقُولُ لَهُمْ : إِنِّي كُنْتُ أَبْعَثُ إِلَى عِبَادِي رُسُلًا مِنْ أَنْفُسِهِمْ ، وَإِنِّي رَسُولُ نَفْسِي إِلَيْكُمُ ، ادْخُلُوا هَذِهِ ، فَيَقُولُ مَنْ كُتِبَ عَلَيْهِ الشَّقَاءُ : يَا رَبِّ ، أَيْنَ نَدْخُلُهَا ، وَمِنْهَا كُنَّا نَفِرُّ ؟ قَالَ : وَمَنْ كُتِبَتْ عَلَيْهِ السَّعَادَةُ يَمْضِي ، فَيَتَقَحَّمُ فِيهَا مُسْرِعًا ، قَالَ : فَيَقُولُ تَبَارَكَ وَتَعَالَى : أَنْتُمْ لِرُسُلِي أَشَدُّ تَكْذِيبًا وَمَعْصِيَةً ، فَيُدْخِلُ هَؤُلَاءِ الْجَنَّةَ ، وَهَؤُلَاءِ النَّارَ  .         [7/226]","","Musnad Abi Ya'la al-Mawsili 4224","","أنس بن مالك عن عبد الوارث الأنصاري مولى أنس بن مالك عن ليث بن أبي سليم عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4226","1470 - (  4225  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ ،  أَخْبَرَنَا  شَرِيكٌ ،  عَنْ  لَيْثٍ ،  عَنْ  عَبْدِ الْوَارِثِ ،  عَنْ  أَنَسٍ ، قَالَ :  مَرَّ بِنَا  أَبُو طَيْبَةَ  فِي رَمَضَانَ ، فَقُلْنَا : مِنْ أَيْنَ جِئْتَ ؟ قَالَ :  حَجَمْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  .","","Musnad Abi Ya'la al-Mawsili 4225","","أنس بن مالك عن عبد الوارث الأنصاري مولى أنس بن مالك عن ليث بن أبي سليم عن شريك بن عبد الله النخعي عن محمد بن الصباح الدولابي عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4227","1471 - (  4226  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  عَبْدُ الْمُؤْمِنِ بْنُ عُبَيْدِ اللهِ السَّدُوسِيُّ ، قَالَ :  حَدَّثَنِي  أَخْشَنُ السَّدُوسِيُّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  وَالَّذِي نَفْسِي بِيَدِهِ لَوْ أَخْطَأْتُمْ حَتَّى تَمْلَأَ خَطَايَاكُمْ مَا بَيْنَ السَّمَاءِ         [7/227]      وَالْأَرْضِ ، ثُمَّ اسْتَغْفَرْتُمُ اللهَ يَغْفِرُ لَكُمْ  ، وَالَّذِي نَفْسُ  مُحَمَّدٍ  بِيَدِهِ لَوْ لَمْ تُخْطِئُوا لَجَاءَ اللهُ بِقَوْمٍ يُخْطِئُونَ ثُمَّ يَسْتَغْفِرُونَ اللهَ فَيَغْفِرُ لَهُمْ  .","","Musnad Abi Ya'la al-Mawsili 4226","","أنس بن مالك عن أخشن السدوسي عن عبد المؤمن بن عبيد الله السدوسي عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4228","1472 - (  4227  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  ابْنُ عُلَيَّةَ ،  عَنِ  ابْنِ عَوْنٍ ،  عَنْ  أَنَسِ بْنِ سِيرِينَ ،  عَنْ  عَبْدِ الْحَمِيدِ بْنِ الْمُنْذِرِ بْنِ الْجَارُودِ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  صَنَعَ بَعْضُ عُمُومَتِي لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - طَعَامًا ، فَقَالَ : إِنِّي أُحِبُّ أَنْ يَأْكُلَ فِي بَيْتِي وَيُصَلِّيَ  ، قَالَ :         [7/228]      فَأَتَاهُ ، وَفِي الْبَيْتِ  فَحْلٌ  مِنْ تِلْكَ الْفُحُولِ ، فَأَمَرَ بِجَانِبٍ مِنْهُ فَكُنِسَ وَرُشَّ ، فَصَلَّى وَصَلَّيْنَا مَعَهُ  .","","Musnad Abi Ya'la al-Mawsili 4227","","أنس بن مالك عن عبد الحميد بن المنذر العبدي عن أنس بن سيرين عن عبد الله بن عون بن أرطبان عن إسماعيل ابن علية عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4229","1473 - (  4228  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  الصَّعْقُ بْنُ حَزْنٍ ،  حَدَّثَنَا  عَلِيُّ بْنُ الْحَكَمِ الْبُنَانِيُّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  أَتَانِي  جِبْرِيلُ  بِمِثْلِ الْمِرْآةِ الْبَيْضَاءِ فِيهَا  نُكْتَةٌ  سَوْدَاءُ ، قُلْتُ : يَا  جِبْرِيلُ  : مَا هَذِهِ ؟ قَالَ : هَذِهِ الْجُمُعَةُ  ، جَعَلَهَا اللهُ عِيدًا لَكَ وَلِأُمَّتِكَ ، فَأَنْتُمْ قَبْلَ الْيَهُودِ وَالنَّصَارَى ، فِيهَا سَاعَةٌ لَا يُوَافِقُهَا عَبْدٌ يَسْأَلُ اللهَ فِيهَا خَيْرًا إِلَّا أَعْطَاهُ إِيَّاهُ ، قَالَ : قُلْتُ : مَا هَذِهِ  النُّكْتَةُ  السَّوْدَاءُ ؟ قَالَ : هَذَا يَوْمُ الْقِيَامَةِ ، تَقُومُ فِي يَوْمِ الْجُمُعَةِ ، وَنَحْنُ نَدْعُوهُ عِنْدَنَا الْمَزِيدَ ، قَالَ : قُلْتُ : مَا يَوْمُ الْمَزِيدِ ؟ قَالَ : إِنَّ اللهَ جَعَلَ فِي الْجَنَّةِ وَادِيًا  أَفْيَحَ  ، وَجَعَلَ فِيهِ  كُثْبَانًا  مِنَ الْمِسْكِ الْأَبْيَضِ ، فَإِذَا كَانَ يَوْمُ الْجُمُعَةِ يَنْزِلُ اللهُ فِيهِ ، فَوُضِعَتْ فِيهِ مَنَابِرُ مِنْ ذَهَبٍ لِلْأَنْبِيَاءِ ، وَكَرَاسِيُّ مِنْ دُرٍّ لِلشُّهَدَاءِ ، وَيَنْزِلْنَ  الْحُورُ  الْعِينُ  مِنَ الْغُرَفِ فَحَمِدُوا اللهَ وَمَجَّدُوهُ ، قَالَ : ثُمَّ يَقُولُ اللهُ : اكْسُوا عِبَادِي ، فَيُكْسَوْنَ ، وَيَقُولُ : أَطْعِمُوا عِبَادِي ، فَيُطْعَمُونَ ، وَيَقُولُ : اسْقُوا عِبَادِي ، فَيُسْقَوْنَ ، وَيَقُولُ : طَيِّبُوا عِبَادِي فَيُطَيَّبُونَ ، ثُمَّ يَقُولُ : مَاذَا         [7/229]      تُرِيدُونَ ؟ فَيَقُولُونَ : رَبَّنَا رِضْوَانَكَ ، قَالَ : يَقُولُ : رَضِيتُ عَنْكُمْ ، ثُمَّ يَأْمُرُهُمْ فَيَنْطَلِقُونَ ، وَتَصْعَدُ  الْحُورُ  الْعِينُ  الْغُرَفَ ، وَهِيَ مِنْ زُمُرُّدَةٍ خَضْرَاءَ ، وَمِنْ يَاقُوتَةٍ حَمْرَاءَ  .","","Musnad Abi Ya'la al-Mawsili 4228","","أنس بن مالك عن علي بن الحكم البناني عن الصعق بن حزن البكري عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4230","1474 - (  4229  ) -  حَدَّثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  أَخْبَرَنَا  سَلَّامٌ ،  حَدَّثَنِي  عُمَرُ بْنُ مَعْدَانَ ، وَثَابِتٌ الْبُنَانِيُّ كِلَاهُمَا ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  شَهِدْتُ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلِيمَةً ، مَا فِيهَا خُبْزٌ وَلَا لَحْمٌ  .","","Musnad Abi Ya'la al-Mawsili 4229","","أنس بن مالك عن ثابت البناني عن سلام بن مسكين النمري عن علي بن الجعد عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4231","1475 - (  4230  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  سُكَيْنٌ ،  حَدَّثَنَا  الْمُثَنَّى الْقَطَّانُ ،  حَدَّثَنِي  عَبْدُ الْعَزِيزِ         [7/230]      يَعْنِي أَبَا سُكَيْنٍ ، قَالَ :  أَتَيْتُ أَنَسَ بْنَ مَالِكٍ ، فَقُلْتُ :  أَخْبِرْنِي  عَنْ صَلَاةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فَأَمَرَ أَهْلَ بَيْتِهِ ، فَصَلَّى بِنَا الظُّهْرَ وَالْعَصْرَ ، فَقَرَأَ بِنَا قِرَاءَةً هَمْسًا ، فَقَرَأَ بِالْمُرْسَلَاتِ  ،         {      وَالنَّازِعَاتِ         }      ، وَ         {      عَمَّ يَتَسَاءَلُونَ         }      ، وَنَحْوِهَا مِنَ السُّوَرِ  .","","Musnad Abi Ya'la al-Mawsili 4230","","أنس بن مالك عن عبد العزيز بن قيس العبدي عن المثنى بن دينار القطان عن سكين بن عبد العزيز بن قيس المجاشعي عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4232","1476 - (  4231  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  سُكَيْنُ بْنُ عَبْدِ الْعَزِيزِ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  عُمُرُ  الذُّبَابِ  أَرْبَعُونَ لَيْلَةً ،  وَالذُّبَابُ  كُلُّهُ فِي النَّارِ إِلَّا النَّحْلَ  .         [7/231]","","Musnad Abi Ya'la al-Mawsili 4231","","أنس بن مالك عن عبد العزيز بن قيس العبدي عن سكين بن عبد العزيز بن قيس المجاشعي عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4233","1477 - (  4232  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  سِنَانٍ أَبِي رَبِيعَةَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَخَلَ عَلَى  أَعْرَابِيٍّ  يَعُودُهُ وَهُوَ مَحْمُومٌ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كَفَّارَةٌ وَطَهُورٌ ، فَقَالَ الْأَعْرَابِيُّ : بَلْ حُمَّى  تَفُورُ  عَلَى شَيْخٍ كَبِيرٍ تُزِيرُهُ الْقُبُورَ  ، فَقَامَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَتَرَكَهُ  .         [7/232]","","Musnad Abi Ya'la al-Mawsili 4232","","أنس بن مالك عن سنان بن ربيعة صاحب السابري عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4234","1478 - (  4233  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  سِنَانٍ أَبِي رَبِيعَةَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا ابْتَلَى اللهُ الْمُسْلِمَ بِبَلَاءٍ فِي جَسَدِهِ ، قَالَ لِلْمَلَكِ : اكْتُبْ لَهُ صَالِحَ عَمَلِهِ الَّذِي كَانَ يَعْمَلُ  ، فَإِنْ شَفَاهُ غَسَلَهُ وَطَهَّرَهُ ، وَإِنْ قَبَضَهُ غَفَرَ لَهُ وَرَحِمَهُ  .","","Musnad Abi Ya'la al-Mawsili 4233","","أنس بن مالك عن سنان بن ربيعة صاحب السابري عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4235","1479 - (  4234  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ بَكْرٍ ،  عَنْ  سِنَانِ بْنِ رَبِيعَةَ الْحَضْرَمِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  أَنَّ  امْرَأَةً  أَتَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ : يَا رَسُولَ اللهِ ، ابْنَةٌ لِي كَذَا وَكَذَا ، فَذَكَرَتْ مِنْ حُسْنِهَا وَجَمَالِهَا ، فَآثَرْتُكَ بِهَا ، قَالَ :  قَدْ قَبِلْتُهَا ، فَلَمْ تَزَلْ تَمْدَحُهَا حَتَّى ذَكَرَتْ أَنَّهَا لَمْ تُصْدَعْ وَلَمْ تَشْتَكِ شَيْئًا قَطُّ ، قَالَ : لَا حَاجَةَ لِي فِي ابْنَتِكِ  .         [7/233]","","Musnad Abi Ya'la al-Mawsili 4234","","أنس بن مالك عن سنان بن ربيعة صاحب السابري عن عبد الله بن بكر بن حبيب عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4236","1480 - (  4235  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  سِنَانٍ أَبِي رَبِيعَةَ ،  عَنْ  أَنَسٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا ابْتَلَى اللهُ الْعَبْدَ بِبَلَاءٍ فِي جَسَدِهِ ، قَالَ لِلْمَلَكِ : اكْتُبْ لَهُ صَالِحَ عَمَلِهِ الَّذِي كَانَ يَعْمَلُ  ، فَإِنْ شَفَاهُ غَسَلَهُ وَطَهَّرَهُ ، وَإِنْ قَبَضَهُ غَفَرَ لَهُ وَرَحِمَهُ  .","","Musnad Abi Ya'la al-Mawsili 4235","","أنس بن مالك عن سنان بن ربيعة صاحب السابري عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4237","1481 - (  4236  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  سِنَانِ بْنِ رَبِيعَةَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  انْطَلَقَتْ بِي أُمِّي إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ : يَا رَسُولَ اللهِ ، خُوَيْدِمُكَ فَادْعُ اللهَ لَهُ ، فَقَالَ :  اللَّهُمَّ أَكْثِرْ مَالَهُ وَوَلَدَهُ ، وَأَطِلْ عُمُرَهُ ، وَاغْفِرْ لَهُ  ، قَالَ : فَكَثُرَ مَالِي حَتَّى صَارَ يُطْعِمُ فِي السَّنَةِ مَرَّتَيْنِ ، وَكَثُرَ وَلَدِي حَتَّى قَدْ دَفَنْتُ مِنْ صُلْبِي أَكْثَرَ مِنْ مِائَةٍ ، وَطَالَ عُمُرِي حَتَّى قَدِ اسْتَحْيَيْتُ مِنْ أَهْلِي ، وَاشْتَقْتُ لِقَاءَ رَبِّي ، وَأَمَّا الرَّابِعَةَ ،  يَعْنِي الْمَغْفِرَةَ  .","","Musnad Abi Ya'la al-Mawsili 4236","","أنس بن مالك عن سنان بن ربيعة صاحب السابري عن حماد بن زيد عن سليمان بن داود العتكي عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4238","1482 - (  4237  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  سَعِيدُ بْنُ سُلَيْمٍ الضَّبِّيُّ ،         [7/234]      حَدَّثَنَا  أَنَسُ بْنُ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : قَالَ اللهُ :  إِذَا أَخَذْتُ كَرِيمَتَيْ عَبْدِي لَمْ أَرْضَ لَهُ ثَوَابًا دُونَ الْجَنَّةِ  ، قَالَ : قُلْتُ : يَا رَسُولَ اللهِ ، وَإِنْ كَانَتْ وَاحِدَةً ؟ قَالَ : وَإِنْ كَانَتْ وَاحِدَةً  .","","Musnad Abi Ya'la al-Mawsili 4237","","أنس بن مالك عن سعيد بن سليم الضبي عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4239","1483 - (  4238  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  سَعِيدُ بْنُ سُلَيْمٍ الضَّبِّيُّ ،  حَدَّثَنَا  أَنَسُ بْنُ مَالِكٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  جَهَّزَ  جَيْشًا إِلَى الْمُشْرِكِينَ ، فِيهِمْ  أَبُو بَكْرٍ  ،  وَعُمَرُ  ، أَمَّرَهُمَا وَالنَّاسُ كُلُّهُمْ ، قَالَ لَهُمْ :  أَجِدُّوا السَّيْرَ ، فَإِنَّ بَيْنَكُمْ وَبَيْنَ الْمُشْرِكِينَ مَاءً ،  إِنْ سَبَقَ         [7/235]      الْمُشْرِكُونَ إِلَى ذَلِكَ الْمَاءِ شَقَّ عَلَى النَّاسِ وَغُلِبْتُمْ عَطَشًا شَدِيدًا أَنْتُمْ وَدَوَابُّكُمْ وَرِكَابُكُمْ .  وَتَخَلَّفَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي ثَمَانِيَةٍ هُوَ تَاسِعُهُمْ ، فَقَالَ لِأَصْحَابِهِ : هَلْ لَكُمْ أَنْ نُعَرِّسَ قَلِيلًا ، ثُمَّ نَلْحَقَ بِالنَّاسِ ؟ قَالُوا : نَعَمْ ، يَا رَسُولَ اللهِ ،  فَعَرَّسُوا  فَمَا أَيْقَظَهُمْ إِلَّا حَرُّ الشَّمْسِ ، فَاسْتَيْقَظَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَاسْتَيْقَظَ أَصْحَابُهُ ، فَقَالَ لَهُمْ : قُومُوا وَاقْضُوا حَاجَتَكُمْ ، فَفَعَلُوا ، ثُمَّ رَجَعُوا إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ لَهُمْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : هَلْ مَعَ أَحَدٍ مِنْكُمْ مَاءٌ ؟ قَالَ  رَجُلٌ  مِنْهُمْ : يَا رَسُولَ اللهِ ، مَيْضَأَةٌ فِيهَا شَيْءٌ مِنْ مَاءٍ ، قَالَ : جِئْ بِهَا ، فَجَاءَ بِهَا ، فَأَخَذَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَمَسَحَهَا بِكَفَّيْهِ وَدَعَا بِالْبَرَكَةِ ، ثُمَّ قَالَ لِأَصْحَابِهِ : تَعَالَوْا فَتَوَضَّئُوا ، فَجَاءُوا فَجَعَلَ يَصُبُّ عَلَيْهِمْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى تَوَضَّئُوا ، وَأَذَّنَ  رَجُلٌ  مِنْهُمْ وَأَقَامَ ، قَالَ : فَصَلَّى بِهِمْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَقَالَ لِصَاحِبِ الْمَيْضَأَةِ :  ازْدَهِرْ  بِمَيْضَأَتِكَ ، فَسَيَكُونُ لَهَا نَبَأٌ ، فَرَكِبَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَصْحَابُهُ قَبْلَ النَّاسِ ، فَقَالَ لِأَصْحَابِهِ : مَا تَرَوْنَ النَّاسَ فَعَلُوا ؟ قَالُوا : اللهُ وَرَسُولُهُ أَعْلَمُ ، قَالَ لَهُمْ : إِنَّ فِيهِمْ  أَبَا بَكْرٍ  ،  وَعُمَرَ  ، وَسَيُرْشِدَانِ النَّاسَ .  فَقَدِمَ النَّاسُ وَقَدْ سَبَقَ الْمُشْرِكُونَ إِلَى ذَلِكَ الْمَاءِ ، فَشَقَّ عَلَى النَّاسِ ، وَعَطِشُوا عَطَشًا شَدِيدًا وَرِكَابُهُمْ وَدَوَابُّهُمْ ، فَقَالَ         [7/236]      رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَيْنَ صَاحِبُ الْمَيْضَأَةِ ؟ قَالَ : هَا هُوَ ذَا يَا رَسُولَ اللهِ ، قَالَ : جِئْ بِمَيْضَأَتِكَ ، فَجَاءَ بِهَا وَفِيهَا شَيْءٌ مِنْ مَاءٍ ، فَقَالَ لَهُمْ كُلِّهِمْ : تَعَالَوْا فَاشْرَبُوا ، فَجَعَلَ يَصُبُّ لَهُمْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى شَرِبُوا كُلُّهُمْ ، وَسَقَوْا دَوَابَّهُمْ وَرِكَابَهُمْ ، وَمَلَئُوا كُلَّ  إِدَاوَةٍ  وَقِرْبَةٍ وَمَزَادَةٍ ، ثُمَّ نَهَضَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَصْحَابُهُ إِلَى الْمُشْرِكِينَ ، فَبَعَثَ اللهُ رِيحًا فَضَرَبَتْ وُجُوهَ الْمُشْرِكِينَ ، وَأَنْزَلَ اللهُ تَبَارَكَ وَتَعَالَى نَصْرَهُ ، وَأَمْكَنَ مِنْ أَدْبَارِهِمْ ، فَقَتَلُوا مِنْهُمْ مَقْتَلَةً عَظِيمَةً ، وَأَسَرُوا أُسَارَى كَثِيرَةً ، وَاسْتَاقُوا غَنَائِمَ كَثِيرَةً ، وَرَجَعَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَالنَّاسُ وَافِرِينَ صَالِحِينَ  .","","Musnad Abi Ya'la al-Mawsili 4238","","أنس بن مالك عن سعيد بن سليم الضبي عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4240","1484 - (  4239  ) -  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدِ بْنِ حَيَّانَ ،  حَدَّثَنَا  عَبْدُ الْمَلِكِ بْنُ عَمْرٍو ،  حَدَّثَنَا  سَعِيدُ بْنُ سُلَيْمٍ الضَّبِّيُّ ، قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ ، يَقُولُ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا سَافَرَ ، أَوْ غَزَا ، أَرْدَفَ كُلَّ يَوْمٍ رَجُلًا مِنْ أَصْحَابِهِ ، قَالَ : فَكَانَ رَدِيفُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  مُعَاذَ بْنَ جَبَلٍ  ، فَنَادَاهُ وَهُوَ رَدِيفُهُ ، فَقَالَ : يَا  مُعَاذُ بْنَ جَبَلٍ  ، قُلْتُ : لَبَّيْكَ يَا رَسُولَ اللهِ ، قَالَ :  هَلْ تَدْرِي مَا  حَقُّ  اللهِ عَلَى الْعِبَادِ ؟ أَنْ يَشْهَدُوا أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَنَّ  مُحَمَّدًا         [7/237]      عَبْدُهُ وَرَسُولُهُ  ، وَأَنْ يَعْبُدُوهُ لَا يُشْرِكُوا بِهِ شَيْئًا .  فَكَرَّرَ هَذَا الْحَدِيثَ ثَلَاثَ مَرَّاتٍ ، ثُمَّ نَادَى ، فَقَالَ : يَا  مُعَاذُ  ، قَالَ : لَبَّيْكَ يَا رَسُولَ اللهِ ، قَالَ : هَلْ تَدْرِي مَا  حَقُّ  الْعِبَادِ عَلَى اللهِ إِذَا فَعَلُوا ذَلِكَ ، قَالَ : اللهُ وَرَسُولُهُ أَعْلَمُ ، قَالَ : فَإِنَّ  حَقَّ  الْعِبَادِ عَلَى اللهِ إِذَا فَعَلُوا ذَلِكَ أَنْ لَا يُعَذِّبَهُمْ ، وَأَنْ يُدْخِلَهُمُ الْجَنَّةَ  .","","Musnad Abi Ya'la al-Mawsili 4239","","أنس بن مالك عن سعيد بن سليم الضبي عن أبو عامر العقدي عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4241","1485 - (  4240  ) -  حَدَّثَنَا  أَبُو عُبَيْدَةَ بْنُ فُضَيْلِ بْنِ عِيَاضٍ ،  حَدَّثَنَا  أَبُو سَعِيدٍ مَوْلَى بَنِي هَاشِمٍ ،  حَدَّثَنَا  زَرْبِيٌّ أَبُو يَحْيَى ، قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ ، يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَكْمَلُ الْمُؤْمِنِينَ إِيمَانًا أَحْسَنُهُمْ  خُلُقًا  .         [7/238]","","Musnad Abi Ya'la al-Mawsili 4240","","أنس بن مالك عن زربي بن عبد الله الأزدي عن عبد الرحمن بن عبد الله بن عبيد جردقة عن أبو عبيدة بن الفضيل بن عياض عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4242","1486 - (  4241  ) -  حَدَّثَنَا  أَبُو عُبَيْدَةَ ،  حَدَّثَنَا  أَبُو سَعِيدٍ ،  حَدَّثَنَا  زَرْبِيٌّ أَبُو يَحْيَى ،  عَنْ  أَنَسٍ ، قَالَ  : بَيْنَمَا نَحْنُ عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذْ رَفَعَ رَأْسَهُ فَإِذَا هُوَ  شَيْخٌ  قَدْ أَقْبَلَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَيْسَ مِنَّا مَنْ لَمْ يُوَقِّرْ كَبِيرَنَا ، وَيَرْحَمْ صَغِيرَنَا  .","","Musnad Abi Ya'la al-Mawsili 4241","","أنس بن مالك عن زربي بن عبد الله الأزدي عن عبد الرحمن بن عبد الله بن عبيد جردقة عن أبو عبيدة بن الفضيل بن عياض عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4243","1487 - (  4242  ) -  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدِ بْنِ حَيَّانَ ،  حَدَّثَنَا  عُبَيْدُ بْنُ وَاقِدٍ ،  حَدَّثَنَا  زَرْبِيٌّ ، قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ ، قَالَ :  جَاءَ  شَيْخٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي حَاجَتِهِ فَأَبْطَئُوا عَنِ الشَّيْخِ أَنْ يُوَسِّعُوا لَهُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَيْسَ مِنَّا مَنْ لَمْ يَرْحَمْ صَغِيرَنَا ، وَيُوَقِّرْ كَبِيرَنَا  .","","Musnad Abi Ya'la al-Mawsili 4242","","أنس بن مالك عن زربي بن عبد الله الأزدي عن عبيد بن واقد القيسي عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4244","1488 - (  4243  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  فُضَيْلُ بْنُ عِيَاضٍ ،  عَنْ  مُسْلِمٍ الْبَرَّادِ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُجِيبُ الْعَبْدَ ، وَيَعُودُ الْمَرِيضَ ، وَيَرْكَبُ الْحِمَارَ  .         [7/239]","","Musnad Abi Ya'la al-Mawsili 4243","","أنس بن مالك عن مسلم بن كيسان البراد عن الفضيل بن عياض عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4245","1489 - (  4244  ) -  حَدَّثَنَا  سَعِيدُ بْنُ الْأَشْعَثِ ،  أَخْبَرَنِي  عِيسَى بْنُ صَدَقَةَ بْنِ عَبَّادٍ الْيَشْكُرِيُّ ، قَالَ :  دَخَلْتُ مَعَ أَبِي عَلَى أَنَسِ بْنِ مَالِكٍ ، فَقُلْنَا لَهُ : حَدِّثْنَا حَدِيثًا يَنْفَعُنَا اللهُ بِهِ ،  فَسَمِعْتُهُ  يَقُولُ : مَنِ اسْتَطَاعَ مِنْكُمْ أَنْ يَمُوتَ وَلَا دَيْنَ عَلَيْهِ فَلْيَفْعَلْ ، فَإِنِّي رَأَيْتُ نَبِيَّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأُتِيَ بِجِنَازَة  رَجُلٍ  وَعَلَيْهِ دَيْنٌ ، فَقَالَ :  لَا أُصَلِّي عَلَيْهِ حَتَّى تَضْمَنُوا دَيْنَهُ ، فَإِنَّ صَلَاتِي عَلَيْهِ تَنْفَعُهُ  ، فَلَمْ يَضْمَنُوا دَيْنَهُ ، وَلَمْ يُصَلِّ عَلَيْهِ ، وَقَالَ : إِنَّهُ مُرْتَهَنٌ فِي قَبْرِهِ  .         [7/240]","","Musnad Abi Ya'la al-Mawsili 4244","","أنس بن مالك عن عيسى بن صدقة الحنفي عن سعيد بن أبى الربيع السمان عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4246","1490 - (  4245  ) -  حَدَّثَنَا  سَعِيدُ بْنُ أَبِي الرَّبِيعِ ، قَالَ :  حَدَّثَنِي  عِيسَى بْنُ صَدَقَةَ قَالَ :  سَمِعْتُ  أَنَسًا يَقُولُ :  اتَّقُوا اللهَ وَأَدُّوا الْأَمَانَاتِ إِلَى أَهْلِهَا  .  قَالَ أَبُو يَعْلَى :  وَأَكْبَرُ ظَنِّي أَنَّ  الْمُعَلَّى  حَدَّثَنِي بِهِ عَنْ  عِيسَى  وَلَكِنْ لَمْ أَجِدْ  .","","Musnad Abi Ya'la al-Mawsili 4245","","أنس بن مالك عن عيسى بن صدقة الحنفي عن سعيد بن أبى الربيع السمان عن أبو يعلى الموصلي","أبو عمران الجوني عن أنس"
"4247","[7/241]      جَعْفَرُ بْنُ عَمْرِو بْنِ أُمَيَّةَ  عَنْ  أَنَسٍ  1491 - (  4246  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  أَنَسُ بْنُ عِيَاضٍ ،  حَدَّثَنِي  يُوسُفُ بْنُ أَبِي ذَرَّةَ ،  عَنْ  جَعْفَرِ بْنِ عَمْرِو بْنِ أُمَيَّةَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَا مِنْ مُسْلِمٍ يُعَمَّرُ فِي الْإِسْلَامِ أَرْبَعِينَ سَنَةً إِلَّا صَرَفَ اللهُ عَنْهُ ثَلَاثَةَ أَنْوَاعٍ مِنَ         [7/242]      الْبَلَاءِ  : الْجُذَامُ ، وَالْجُنُونُ ، وَالْبَرَصُ ، فَإِذَا بَلَغَ الْخَمْسِينَ لَيَّنَ اللهُ عَلَيْهِ الْحِسَابَ ، فَإِذَا بَلَغَ السِّتِّينَ رَزَقَهُ اللهُ الْإِنَابَةَ بِمَا يُحِبُّ ، فَإِذَا بَلَغَ السَّبْعِينَ أَحَبَّهُ اللهُ وَأَحَبَّهُ أَهْلُ السَّمَاءِ ، فَإِذَا بَلَغَ الثَّمَانِينَ قَبِلَ اللهُ حَسَنَاتِهِ وَتَجَاوَزَ عَنْ سَيِّئَاتِهِ ، فَإِذَا بَلَغَ التِّسْعِينَ غَفَرَ اللهُ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ وَمَا تَأَخَّرَ ، وَسُمِّيَ أَسِيرَ اللهِ فِي الْأَرْضِ ، وَشَفَعَ لِأَهْلِ بَيْتِهِ  .","","Musnad Abi Ya'la al-Mawsili 4246","","أنس بن مالك عن جعفر بن عمرو بن أمية الضمري عن يوسف بن أبي ذرة الأنصاري عن أنس بن عياض الليثي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","جعفر بن عمرو بن أمية عن أنس"
"4248","1492 - (  4247  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  أَنَسُ بْنُ عِيَاضٍ ، نَحْوَهُ ، قَالَ أَبُو خَيْثَمَةَ :  قَالَ  أَنَسُ بْنُ عِيَاضٍ :  أَنَا أَسِيرُ اللهِ فِي أَرْضِهِ  .","","Musnad Abi Ya'la al-Mawsili 4247","","أنس بن مالك عن جعفر بن عمرو بن أمية الضمري عن يوسف بن أبي ذرة الأنصاري عن أنس بن عياض الليثي عن زهير بن حرب عن أبو يعلى الموصلي","جعفر بن عمرو بن أمية عن أنس"
"4249","1493 - (  4248  ) -  حَدَّثَنَا  أَبُو عُبَيْدَةَ بْنُ فُضَيْلِ بْنِ عِيَاضٍ ،  حَدَّثَنَا  عَبْدُ الْمَلِكِ بْنُ إِبْرَاهِيمَ الْجُدِّيُّ ،  أَخْبَرَنِي  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الْمَوَالِ ، قَالَ :  حَدَّثَنِي  مُحَمَّدُ بْنُ مُوسَى ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ عَمْرِو بْنِ عُثْمَانَ ،  عَنْ  جَعْفَرِ بْنِ عَمْرٍو الضَّمْرِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ عَمَّرَهُ اللهُ أَرْبَعِينَ سَنَةً فِي الْإِسْلَامِ كَفَّ اللهُ عَنْهُ أَنْوَاعَ الْبَلَاءِ : الْجُذَامِ ، وَالْبَرَصِ  ، وَخَتْرِ الشَّيْطَانِ ، وَمَنْ عَمَّرَهُ اللهُ خَمْسِينَ فِي         [7/243]      الْإِسْلَامِ لَيَّنَ اللهُ عَلَيْهِ الْحِسَابَ يَوْمَ الْقِيَامَةِ ، وَمَنْ عَمَّرَهُ اللهُ سِتِّينَ سَنَةً فِي الْإِسْلَامِ رَزَقَهُ اللهُ الْإِنَابَةَ إِلَى اللهِ بِمَا يُحِبُّ اللهُ ، وَمَنْ عَمَّرَهُ اللهُ سَبْعِينَ سَنَةً فِي الْإِسْلَامِ أَحَبَّهُ أَهْلُ السَّمَاءِ وَأَهْلُ الْأَرْضِ ، وَمَنْ عَمَّرَهُ اللهُ ثَمَانِينَ سَنَةً فِي الْإِسْلَامِ مَحَا اللهُ عَنْهُ سَيِّئَاتِهِ وَكَتَبَ حَسَنَاتِهِ ، وَمَنْ عَمَّرَهُ اللهُ تِسْعِينَ سَنَةً فِي الْإِسْلَامِ غَفَرَ اللهُ ذُنُوبَهُ ، وَكَانَ أَسِيرَ اللهِ فِي أَرْضِهِ ، وَشَفَعَ لِأَهْلِ بَيْتِهِ يَوْمَ الْقِيَامَةِ  .","","Musnad Abi Ya'la al-Mawsili 4248","","أنس بن مالك عن جعفر بن عمرو بن أمية الضمري عن الديباج ، محمد بن عبد الله بن عمرو عن محمد بن موسى الفطري عن عبد الرحمن بن أبي الموال مولى علي بن أبي طالب عن عبد الملك بن إبراهيم الجدي عن أبو عبيدة بن الفضيل بن عياض عن أبو يعلى الموصلي","جعفر بن عمرو بن أمية عن أنس"
"4250","1494 - (  4249  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  يَحْيَى بْنُ سُلَيْمٍ ، قَالَ :  حَدَّثَنِي  رَجُلَانِ مِنْ  أَهْلِ حَرَّانَ  مِنْ أَهْلِ الْعِلْمِ ، وَكَانَا عِنْدِي  ثِقَةٌ  ،  عَنْ  زُفَرَ بْنِ مُحَمَّدٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ عَمْرِو بْنِ عُثْمَانَ بْنِ عَفَّانَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا مِنْ مُعَمَّرٍ يُعَمَّرُ فِي الْإِسْلَامِ أَرْبَعِينَ سَنَةً إِلَّا دَفَعَ اللهُ عَنْهُ أَنْوَاعَ الْبَلَاءِ : الْجُنُونِ ، وَالْجُذَامِ  ، وَالْبَرَصِ ، فَإِذَا بَلَغَ الْخَمْسِينَ هَوَّنَ اللهُ عَلَيْهِ الْحِسَابَ ، فَإِذَا بَلَغَ السِّتِّينَ رَزَقَهُ اللهُ الْإِنَابَةَ إِلَى اللهِ بِمَا يُحِبُّ         [7/244]      اللهُ ، فَإِذَا بَلَغَ السَّبْعِينَ أَحَبَّهُ اللهُ وَأَحَبَّهُ أَهْلُ السَّمَاءِ ، فَإِذَا بَلَغَ الثَّمَانِينَ كُتِبَتْ حَسَنَاتُهُ وَمُحِيَتْ سَيِّئَاتُهُ ، فَإِذَا بَلَغَ التِّسْعِينَ غَفَرَ اللهُ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ وَمَا تَأَخَّرَ ، وَكَانَ أَسِيرَ اللهِ فِي أَرْضِهِ ، وَشُفِّعَ فِي أَهْلِ بَيْتِهِ  .","","Musnad Abi Ya'la al-Mawsili 4249","","أنس بن مالك عن الديباج ، محمد بن عبد الله بن عمرو عن زفر بن محمد الفهري المديني عن رجلان عن يحيى بن سليم الطائفي عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","جعفر بن عمرو بن أمية عن أنس"
"4251","1495 - (  4250  ) -  قَالَ  يَحْيَى بْنُ سُلَيْمٍ :  وَأَخْبَرَنِي  أَيْضًا عَبْدُ اللهِ بْنُ عُثْمَانَ ،  عَنْ  سَعْدِ بْنِ أَبِي الْحَكَمِ الْمَدَنِيِّ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ عَمْرِو بْنِ عُثْمَانَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، بِمِثْلِ حَدِيثِ الْحَرَّانِيَّيْنِ .","","Musnad Abi Ya'la al-Mawsili 4250","","أنس بن مالك عن الديباج ، محمد بن عبد الله بن عمرو عن سعد بن أبي الحكم المدني عن عبد الله بن عثمان بن خثيم عن يحيى بن سليم الطائفي عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","جعفر بن عمرو بن أمية عن أنس"
"4252","سَعِيدُ بْنُ سِنَانٍ  عَنْ  أَنَسِ بْنِ مَالِكٍ  1496 - (  4251  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  يُونُسُ ،  عَنْ  لَيْثٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنِ  ابْنِ سِنَانٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تُقْبَلُ         [7/245]      صَدَقَةٌ مِنْ غُلُولٍ ، وَلَا صَلَاةٌ بِغَيْرِ طُهُورٍ  .","","Musnad Abi Ya'la al-Mawsili 4251","","أنس بن مالك عن سعد بن سنان الكندي عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن يونس بن محمد بن مسلم البغدادي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4253","1497 - (  4252  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا         [7/246]      يَزِيدُ بْنُ هَارُونَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  سَعِيدِ بْنِ سِنَانٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ يَقُولُ :  مَا هُوَ بِمُؤْمِنٍ مَنْ لَمْ يَأْمَنْ جَارُهُ  بَوَائِقَهُ  .         [7/247]","","Musnad Abi Ya'la al-Mawsili 4252","","أنس بن مالك عن سعد بن سنان الكندي عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن يزيد بن هارون عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4254","1498 - (  4253  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  شَبَابَةُ ،  عَنْ  لَيْثٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  سَعِيدِ بْنِ سِنَانٍ ،  عَنْ  أَنَسٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  عِظَمُ الْجَزَاءِ مَعَ عِظَمِ الْبَلَاءِ  .","","Musnad Abi Ya'la al-Mawsili 4253","","أنس بن مالك عن سعد بن سنان الكندي عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن شبابة بن سوار المدائني عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4255","1499 - (  4254  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  شَبَابَةُ ،  عَنْ  لَيْثٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  سَعِيدِ بْنِ سِنَانٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ اللهَ إِذَا أَرَادَ بِعَبْدٍ خَيْرًا عَجَّلَ لَهُ الْعُقُوبَةَ فِي الدُّنْيَا  ، وَإِذَا أَرَادَ اللهُ بِعَبْدٍ شَرًّا أَمْسَكَ عَلَيْهِ بِذَنْبِهِ حَتَّى يُوَافِيَهُ يَوْمَ الْقِيَامَةِ  .","","Musnad Abi Ya'la al-Mawsili 4254","","أنس بن مالك عن سعد بن سنان الكندي عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن شبابة بن سوار المدائني عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4256","1500 - (  4255  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  يُونُسُ بْنُ مُحَمَّدٍ ،  عَنْ  لَيْثٍ ،  عَنْ  يَزِيدَ ،  عَنِ  ابْنِ سِنَانٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ كَانَ يَقُولُ : فَذَكَرَ نَحْوَهُ .","","Musnad Abi Ya'la al-Mawsili 4255","","أنس بن مالك عن سعد بن سنان الكندي عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن يونس بن محمد بن مسلم البغدادي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4257","1501 - (  4256  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  يُونُسُ ،  عَنْ         [7/248]      لَيْثٍ ،  عَنْ  يَزِيدَ ،  عَنِ  ابْنِ سِنَانٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  التَّأَنِّي مِنَ اللهِ ، وَالْعَجَلَةُ مِنَ الشَّيْطَانِ ، وَمَا شَيْءٌ أَكْثَرَ مَعَاذِيرَ مِنَ اللهِ  ، وَمَا مِنْ شَيْءٍ أَحَبَّ إِلَى اللهِ مِنَ الْحَمْدِ  .","","Musnad Abi Ya'la al-Mawsili 4256","","أنس بن مالك عن سعد بن سنان الكندي عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن يونس بن محمد بن مسلم البغدادي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4258","1502 - (  4257  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  يُونُسُ ،  عَنْ  لَيْثٍ ،  عَنْ  يَزِيدَ ،  عَنِ  ابْنِ سِنَانٍ ،         [7/249]      عَنْ  أَنَسِ بْنِ مَالِكٍ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ  :  تَقَبَّلُوا لِي سِتًّا أَتَقَبَّلْ لَكُمْ بِالْجَنَّةِ ، قَالُوا : مَا هِيَ ؟ قَالَ : إِذَا حَدَّثَ أَحَدُكُمْ فَلَا يَكْذِبْ  ، وَإِذَا وَعَدَ فَلَا يُخْلِفْ ، وَإِذَا اؤْتُمِنَ فَلَا يَخُنْ ، وَغُضُّوا أَبْصَارَكُمْ ، وَكُفُّوا أَيْدِيَكُمْ ، وَاحْفَظُوا  فُرُوجَكُمْ  .         [7/250]","","Musnad Abi Ya'la al-Mawsili 4257","","أنس بن مالك عن سعد بن سنان الكندي عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن يونس بن محمد بن مسلم البغدادي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4259","1503 - (  4258  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنِ  ابْنِ سِنَانٍ سَعْدٍ الْكِنْدِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  وَالَّذِي نَفْسِي بِيَدِهِ ، لَا يَضَعُ اللهُ رَحْمَتَهُ إِلَّا عَلَى رَحِيمٍ  ، قَالُوا : يَا رَسُولَ اللهِ ، كُلُّنَا يَرْحَمُ ، قَالَ : لَيْسَ بِرَحْمَةِ أَحَدِكُمْ صَاحِبَهُ يُرْحَمُ النَّاسُ كَافَّةً  .","","Musnad Abi Ya'la al-Mawsili 4258","","أنس بن مالك عن سعد بن سنان الكندي عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن عبد الرحمن بن محمد المحاربي عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4260","1504 - (  4259  ) -  حَدَّثَنَا  أَبُو عَلِيٍّ الْحَسَنُ صَاحِبٌ لَنَا ،         [7/251]      حَدَّثَنَا  يُونُسُ ،  حَدَّثَنَا  لَيْثٌ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنِ  ابْنِ سِنَانٍ ،  عَنْ  أَنَسٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْمُسْتَبَّانِ مَا قَالَا ، فَعَلَى الْبَادِئِ حَتَّى يَعْتَدِيَ الْمَظْلُومُ  .         [7/252]","","Musnad Abi Ya'la al-Mawsili 4259","","أنس بن مالك عن سعد بن سنان الكندي عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن يونس بن محمد بن مسلم البغدادي عن الحسن بن عرفة العبدي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4261","1505 - (  4260  ) -  حَدَّثَنَا  أَبُو عَلِيٍّ الْحَسَنُ ،  حَدَّثَنَا  يُونُسُ ،  حَدَّثَنَا  لَيْثٌ ،  عَنْ  يَزِيدَ ،  عَنْ  سَعْدِ بْنِ سِنَانٍ ،  عَنْ  أَنَسٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ :  بَيْنَ يَدَيِ السَّاعَةِ فِتَنٌ  كَقِطَعِ  اللَّيْلِ الْمُظْلِمِ ، يُصْبِحُ الرَّجُلُ مُؤْمِنًا ، وَيُمْسِي كَافِرًا  ، وَيُصْبِحُ كَافِرًا ، وَيُمْسِي مُؤْمِنًا ، وَيَبِيعُ قَوْمٌ دِينَهُمْ بِعَرَضٍ مِنَ الدُّنْيَا يَسِيرٍ  .","","Musnad Abi Ya'la al-Mawsili 4260","","أنس بن مالك عن سعد بن سنان الكندي عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن يونس بن محمد بن مسلم البغدادي عن الحسن بن عرفة العبدي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4262","1506 - (  4261  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  مُعَاذُ بْنُ مُعَاذٍ ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ،  عَنْ  أَبِي مِجْلَزٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  قَنَتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - شَهْرًا فِي صَلَاةِ الصُّبْحِ بَعْدَ الرُّكُوعِ ، يَدْعُو عَلَى  رِعْلٍ  ،  وَذَكْوَانَ  .         [7/253]","","Musnad Abi Ya'la al-Mawsili 4261","","أنس بن مالك عن لاحق بن حميد عن سليمان بن طرخان عن معاذ بن معاذ بن نصر عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4263","1507 - (  4262  ) -  حَدَّثَنَا  زُهَيْرُ بْنُ حَرْبٍ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  سُلَيْمَانَ ،  عَنْ  أَبِي مِجْلَزٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  قَنَتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - شَهْرًا بَعْدَ الرُّكُوعِ ، يَدْعُو عَلَى  رِعْلٍ  ،  وَذَكْوَانَ  ،  وَعُصَيَّةَ  عَصَتِ اللهَ وَرَسُولَهُ  .","","Musnad Abi Ya'la al-Mawsili 4262","","أنس بن مالك عن لاحق بن حميد عن سليمان بن طرخان عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4264","1508 - (  4263  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذِ بْنِ مُعَاذٍ ،  حَدَّثَنَا  الْمُعْتَمِرُ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي مِجْلَزٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  قَنَتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - شَهْرًا بَعْدَ الرُّكُوعِ ، يَدْعُو عَلَى  رِعْلٍ  ،  وَذَكْوَانَ  ،  وَعُصَيَّةَ  عَصَتِ اللهَ وَرَسُولَهُ  .","","Musnad Abi Ya'la al-Mawsili 4263","","أنس بن مالك عن لاحق بن حميد عن سليمان بن طرخان عن معتمر بن سليمان عن عبيد الله بن معاذ بن معاذ عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4265","1509 - (  4264  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  مُعَاذُ بْنُ مُعَاذٍ ،  حَدَّثَنَا  سُلَيْمَانُ التَّيْمِيُّ ،  عَنْ  أَبِي مِجْلَزٍ ،  عَنْ  أَنَسٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  قَنَتَ شَهْرًا ، يَدْعُو عَلَى  رِعْلٍ  وَذَكْوَانَ  .","","Musnad Abi Ya'la al-Mawsili 4264","","أنس بن مالك عن لاحق بن حميد عن سليمان بن طرخان عن معاذ بن معاذ بن نصر عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4266","1510 - (  4265  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَحْرٍ الْبَصْرِيُّ فِي  بَلْهُجَيْمٍ  ،  حَدَّثَنَا  عَبْدُ الْمَجِيدِ بْنُ عَبْدِ الْعَزِيزِ بْنِ أَبِي رَوَّادٍ ،  عَنِ  ابْنِ         [7/254]      جُرَيْجٍ ،  عَنِ  الْمُطَّلِبِ بْنِ عَبْدِ اللهِ بْنِ حَنْطَبٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  عُرِضَتْ عَلَيَّ أُجُورُ أُمَّتِي حَتَّى الْقَذَاةُ يُخْرِجُهَا الرَّجُلُ مِنَ الْمَسْجِدِ  ، وَعُرِضَتْ عَلَيَّ ذُنُوبُ أُمَّتِي فَلَمْ أَرَ ذَنْبًا أَعْظَمَ مِنَ الْآيَةِ وَالسُّورَةِ يَتَعَلَّمُهَا الرَّجُلُ ثُمَّ يَنْسَاهَا  .         [7/255]","","Musnad Abi Ya'la al-Mawsili 4265","","أنس بن مالك عن المطلب بن عبد الله بن حنطب المخزومي عن ابن جريج عن عبد المجيد بن عبد العزيز بن أبي رواد عن محمد بن عثمان بن بحر العقيلي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4267","1511 - (  4266  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  حَدَّثَنَا  عَبْدُ الْحَكِيمِ بْنُ مَنْصُورٍ ،  حَدَّثَنَا  زِيَادُ بْنُ أَبِي حَسَّانَ ، قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَغَاثَ  مَلْهُوفًا  كَتَبَ اللهُ لَهُ ثَلَاثَةً وَسَبْعِينَ حَسَنَةً  : وَاحِدَةً مِنْهُنَّ يُصْلِحُ اللهُ بِهَا لَهُ أَمْرَ دُنْيَاهُ وَآخِرَتِهِ ، وَاثْنَتَيْنِ وَسَبْعِينَ فِي الدَّرَجَاتِ  .         [7/256]","","Musnad Abi Ya'la al-Mawsili 4266","","أنس بن مالك عن زياد بن أبي حسان النبطي عن عبد الحكيم بن منصور الخزاعي عن سليمان بن داود العتكي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4268","1512 - (  4267  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  عَنِ  الْعَلَاءِ بْنِ مُحَمَّدٍ الثَّقَفِيِّ  قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ ، يَقُولُ :  كُنَّا مَعَ رَسُولِ         [7/257]      اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِتَبُوكَ  ، فَطَلَعَتِ الشَّمْسُ بِضِيَاءٍ وَشُعَاعٍ وَنُورٍ لَمْ يَرَهَا طَلَعَتْ فِيمَا مَضَى بِمِثْلِهِ ، فَأَتَى  جِبْرِيلُ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  يَا  جِبْرِيلُ  ، مَا لِيَ أَرَى الشَّمْسَ الْيَوْمَ طَلَعَتْ بِضِيَاءٍ وَنُورٍ وَشُعَاعٍ لَمْ أَرَهَا طَلَعَتْ فِيمَا مَضَى  ؟ قَالَ : إِنَّ ذَلِكَ أَنَّ  مُعَاوِيَةَ بْنَ مُعَاوِيَةَ اللَّيْثِيَّ  مَاتَ  بِالْمَدِينَةِ  الْيَوْمَ ، فَبَعَثَ اللهُ إِلَيْهِ أَلْفَ مَلَكٍ يُصَلُّونَ عَلَيْهِ ، قَالَ : وَفِيمَ ذَاكَ ؟ قَالَ : قَالَ : كَانَ يُكْثِرُ قِرَاءَةَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      فِي اللَّيْلِ وَالنَّهَارِ ، وَفِي مَمْشَاهُ ، وَقِيَامِهِ وَقُعُودِهِ ، فَهَلْ لَكَ يَا رَسُولَ اللهِ أَنْ  أَقْبِضَ  لَكَ الْأَرْضَ فَتُصَلِّيَ عَلَيْهِ ؟ قَالَ : نَعَمْ ، فَصَلَّى عَلَيْهِ  .         [7/258]      كذا في طبعة دار المأمون للتراث والمقصد العلي ، وترجمه البخاري في التاريخ وابن حبان في المجروحين ، ولعل الصواب : (العلاء أبو محمد) وهو ابن زيد ، وينظر مصادر التخريج ، والله أعلم .","","Musnad Abi Ya'la al-Mawsili 4267","","أنس بن مالك عن العلاء بن زيد  ابن زيدل عن يزيد بن هارون عن محمد بن إسحاق المسيبي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4269","1513 - (  4268  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ السَّامِيُّ ،  بِعَبَّادَانَ  ،  حَدَّثَنَا  عُثْمَانُ بْنُ الْهَيْثَمِ ، مُؤَذِّنُ مَسْجِدِ الْجَامِعِ  بِالْبَصْرَةِ  عِنْدِي ،  عَنْ  مَحْبُوبِ بْنِ هِلَالٍ ،  عَنْ  عَطَاءِ بْنِ أَبِي مَيْمُونَةَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ  :  نَزَلَ  جِبْرِيلُ  عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : مَاتَ  مُعَاوِيَةُ بْنُ مُعَاوِيَةَ اللَّيْثِيُّ  ، فُتُحِبُّ أَنْ تُصَلِّيَ عَلَيْهِ  ؟ قَالَ : نَعَمْ ، قَالَ : ضَرَبَ بِجَنَاحِهِ الْأَرْضَ فَلَمْ يَبْقَ شَجَرَةٌ وَلَا أَكَمَةٌ إِلَّا تَضَعْضَعَتْ ، فَرَفَعَ سَرِيرَهُ ، فَنَظَرَ إِلَيْهِ فَكَبَّرَ عَلَيْهِ وَخَلْفَهُ صَفَّانِ مِنَ الْمَلَائِكَةِ ، فِي كُلِّ صَفٍّ سَبْعُونَ أَلْفَ مَلَكٍ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : يَا  جِبْرِيلُ  ، بِمَ نَالَ هَذِهِ الْمَنْزِلَةَ مِنَ اللهِ ؟ قَالَ : بِحُبِّهِ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      ، وَقِرَاءَتِهِ إِيَّاهَا ذَاهِبًا وَجَائِيًا ،         [7/259]      وَقَائِمًا وَقَاعِدًا ، وَعَلَى كُلِّ حَالٍ  .","","Musnad Abi Ya'la al-Mawsili 4268","","أنس بن مالك عن عطاء بن أبي ميمونة البصرى عن محبوب بن هلال المزني عن عثمان بن الهيثم بن جهم الأشج عن محمد بن إبراهيم السامي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4270","1514 - (  4269  ) -  حَدَّثَنَا  أَبُو طَالِبٍ عَبْدُ الْجَبَّارِ بْنُ عَاصِمٍ ،  حَدَّثَنَا  أَبُو الْمَلِيحِ الرَّقِّيُّ ،  عَنِ  الْوَلِيدِ بْنِ زَرْوَانَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  وَضَّأْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا غَسَلَ وَجْهَهُ أَخَذَ كَفًّا مِنْ مَاءٍ ، فَخَلَّلَ لِحْيَتَهُ بِهَا مِنْ بَاطِنِهَا  ، وَقَالَ : هَكَذَا أَمَرَنِي رَبِّي تَبَارَكَ وَتَعَالَى  .","","Musnad Abi Ya'la al-Mawsili 4269","","أنس بن مالك عن الوليد بن زوران السلمي عن الحسن بن عمر الفزاري عن عبد الجبار بن عاصم الخراساني عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4271","1515 - (  4270  ) -  حَدَّثَنَا  عَلِيُّ بْنُ الْحُسَيْنِ الْخَوَّاصُ ،  حَدَّثَنَا  بَقِيَّةُ ،  عَنْ  عُثْمَانَ بْنِ زُفَرَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عَبْدِ الْعَزِيزِ ،  سَمِعَ  أَنَسَ بْنَ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا أَتَى         [7/260]      أَحَدُكُمْ أَهْلَهُ  فَلْيُصْدِقْهَا  ، فَإِنْ سَبَقَهَا فَلَا يُعْجِلْهَا  .","","Musnad Abi Ya'la al-Mawsili 4270","","أنس بن مالك عن ابن جريج عن عثمان بن زفر الجهني عن بقية بن الوليد عن علي بن الحسين الخواص عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4272","1516 - (  4271  ) -  حَدَّثَنَا  ابْنُ جَامِعٍ مُحَمَّدٌ أَبُو عَبْدِ اللهِ بْنُ أَبِي كَامِلٍ ،  حَدَّثَنَا  الْحَسَنُ بْنُ مُوسَى ،  حَدَّثَنَا  اللَّيْثُ بْنُ سَعْدٍ ،  حَدَّثَنَا  بُكَيْرُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ أَبِي سُلَيْمٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ  :  صَلَّيْتُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِمِنًى  رَكْعَتَيْنِ ، وَمَعَ  عُمَرَ  رَكْعَتَيْنِ  ، وَمَعَ  عُثْمَانَ  صَدْرًا مِنْ إِمَارَتِهِ  .","","Musnad Abi Ya'la al-Mawsili 4271","","أنس بن مالك عن محمد بن عبد الله بن أبي سليم المدني عن بكير بن عبد الله بن الأشج القرشي عن الليث بن سعد عن الحسن بن موسى الأشيب عن محمد بن جامع العطار عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4273","1517 - (  4272  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي سَمِينَةَ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  هِشَامُ بْنُ حَسَّانَ ،  عَنْ         [7/261]      عَبْدِ اللهِ بْنِ دِهْقَانَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى أَنْ يَأْكُلَ الرَّجُلُ بِشِمَالِهِ ، أَوْ يَشْرَبَ بِشِمَالِهِ  .","","Musnad Abi Ya'la al-Mawsili 4272","","أنس بن مالك عن عبد الله ، أو عبيد الله بن دهقان مولى أنس بن مالك عن هشام بن حسان العتكي عن عبد الأعلى بن عبد الأعلى القرشي عن محمد بن إسماعيل بن أبي سمينة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4274","1518 - (  4273  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  عَبْدِ اللهِ بْنِ دِهْقَانَ ،         [7/262]      عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا أَكَلَ أَحَدُكُمْ فَلْيَأْكُلْ بِيَمِينِهِ وَلْيَشْرَبْ بِيَمِينِهِ  ، فَإِنَّ الشَّيْطَانَ يَأْكُلُ بِشِمَالِهِ وَيَشْرَبُ بِشِمَالِهِ  .","","Musnad Abi Ya'la al-Mawsili 4273","","أنس بن مالك عن عبد الله ، أو عبيد الله بن دهقان مولى أنس بن مالك عن هشام بن حسان العتكي عن يزيد بن هارون عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4275","1519 - (  4274  ) -  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدِ بْنِ حَيَّانَ الْبَصْرِيُّ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  هِشَامٌ ،  عَنْ  عَبْدِ اللهِ بْنِ دِهْقَانَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى أَنْ يَأْكُلَ الرَّجُلُ بِشِمَالِهِ ، أَوْ يَشْرَبَ بِشِمَالِهِ  .","","Musnad Abi Ya'la al-Mawsili 4274","","أنس بن مالك عن عبد الله ، أو عبيد الله بن دهقان مولى أنس بن مالك عن هشام بن حسان العتكي عن عبد الأعلى بن عبد الأعلى القرشي عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4276","1520 - (  4275  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  عَنْ  سَعِيدِ بْنِ مَيْسَرَةَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَقَدْ مَرَّ بِالصَّخْرَةِ مِنِ  الرَّوْحَاءِ  سَبْعُونَ نَبِيًّا حُفَاةً عَلَيْهِمُ الْعَبَاءَةُ ، يَؤُمُّونَ  بَيْتَ اللهِ الْعَتِيقَ  ، مِنْهُمْ  مُوسَى  نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ  .         [7/263]","","Musnad Abi Ya'la al-Mawsili 4275","","أنس بن مالك عن سعيد بن ميسرة البكري عن يونس بن بكير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4277","1521 - (  4276  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  حَدَّثَنَا  سَلْمٌ الْعَلَوِيُّ ، قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ ، قَالَ :  لَمَّا نَزَلَتْ آيَةُ الْحِجَابِ كُنْتُ أَدْخُلُ كَمَا كُنْتُ أَدْخُلُ ، فَقَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  وَرَاءَكَ يَا بُنَيَّ  .         [7/264]","","Musnad Abi Ya'la al-Mawsili 4276","","أنس بن مالك عن سلم بن قيس العلوي عن حماد بن زيد عن سليمان بن داود العتكي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4278","1522 - (  4277  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  سَلْمٌ الْعَلَوِيُّ ، قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ ، قَالَ :  قُرِّبَتْ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَحْفَةٌ فِيهَا قَرْعٌ ، وَكَانَ يُعْجِبُهُ ، قَالَ : فَلَقَدْ رَأَيْتُهُ يُدْخِلُ إِصْبَعَهُ يَلْتَمِسُ الْقَرْعَ ، قَالَ :  فَدَخَلَ عَلَيْهِ رَجُلٌ ، فَرَأَى عَلَيْهِ أَثَرَ صُفْرَةٍ فَكَرِهَهَا رَسُولُ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَكَانَ لَا يُوَاجِهُ رَجُلًا فِي وَجْهِهِ بِشَيْءٍ يَكْرَهُهُ ، فَلَمَّا قَامَ ، قَالَ لِبَعْضِ  الْقَوْمِ  : لَوْ أَمَرْتُمْ هَذَا أَنْ يَدَعَ هَذِهِ الصُّفْرَةَ  .","","Musnad Abi Ya'la al-Mawsili 4277","","أنس بن مالك عن سلم بن قيس العلوي عن حماد بن زيد عن سليمان بن داود العتكي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4279","1523 - (  4278  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  أَبِي دَاوُدَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ  : سُئِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : كَيْفَ يُحْشَرُ         [7/265]      النَّاسُ عَلَى وُجُوهِهِمْ ؟ فَقَالَ :  إِنَّ الَّذِي أَمْشَاهُمْ عَلَى أَقْدَامِهِمْ قَادِرٌ عَلَى أَنْ يُمْشِيَهُمْ عَلَى وُجُوهِهِمْ  .","","Musnad Abi Ya'la al-Mawsili 4278","","أنس بن مالك عن نفيع بن الحارث الأعمى عن إسماعيل بن أبي خالد عن يزيد بن هارون عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4280","1524 - (  4279  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ ،  أَخْبَرَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  أَبِي دَاوُدَ الْأَعْمَى ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  سُئِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : كَيْفَ يُحْشَرُ النَّاسُ عَلَى وُجُوهِهِمْ ؟ قَالَ :  إِنَّ الَّذِي أَمْشَاهُمْ عَلَى أَقْدَامِهِمْ قَادِرٌ أَنْ يُمْشِيَهُمْ عَلَى وُجُوهِهِمْ  .","","Musnad Abi Ya'la al-Mawsili 4279","","أنس بن مالك عن نفيع بن الحارث الأعمى عن إسماعيل بن أبي خالد عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4281","1525 - (  4280  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَصَمِّ ، قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ ، يَقُولُ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأَبُو بَكْرٍ  ،  وَعُمَرُ  لَا يُنْقِصُونَ التَّكْبِيرَ  .         [7/266]","","Musnad Abi Ya'la al-Mawsili 4280","","أنس بن مالك عن عبد الرحمن بن الأصم المدائني عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4282","1526 - (  4281  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَصَمِّ ،  عَنْ  أَنَسٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأَبَا بَكْرٍ  ،  وَعُمَرَ  ،  وَعُثْمَانَ  كَانُوا يُتِمُّونَ التَّكْبِيرَ ، إِذَا رَفَعُوا وَإِذَا وَضَعُوا  .","","Musnad Abi Ya'la al-Mawsili 4281","","أنس بن مالك عن عبد الرحمن بن الأصم المدائني عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4283","1527 - (  4282  ) -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ الْقَطَّانُ ،  عَنْ  نَوْفَلٍ ، قَالَ :  دَخَلْنَا عَلَى  أَنَسٍ ، فَقُلْنَا : حَدِّثْنَا مَا سَمِعْتَ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ثَلَاثٌ مَنْ كُنَّ فِيهِ حُرِّمَ عَلَى النَّارِ ، وَحُرِّمَتِ النَّارُ عَلَيْهِ : إِيمَانٌ بِاللهِ  ، وَحُبٌّ فِي اللهِ ، وَأَنْ يُلْقَى فِي النَّارِ فَيَحْتَرِقَ أَحَبُّ إِلَيْهِ مِنْ أَنْ يَرْجِعَ فِي الْكُفْرِ  .         [7/267]","","Musnad Abi Ya'la al-Mawsili 4282","","أنس بن مالك عن نوفل بن مسعود السهمي عن يحيى القطان عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4284","1528 - (  4283  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبِ بْنِ شَابُورَ ،  حَدَّثَنَا  سَعِيدُ بْنُ خَالِدِ بْنِ أَبِي طَوِيلٍ الْقُرَشِيُّ ، قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ يُحَدِّثُ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ :  مَنْ حَرَسَ لَيْلَةً عَلَى سَاحِلِ الْبَحْرِ كَانَ أَفْضَلَ مِنْ عِبَادَةِ رَجُلٍ فِي أَهْلِهِ أَلْفَ سَنَةٍ  ، السَّنَةُ ثَلَاثُ مِائَةٍ وَسِتُّونَ يَوْمًا ، كُلُّ يَوْمٍ أَلْفُ سَنَةٍ  .         [7/268]","","Musnad Abi Ya'la al-Mawsili 4283","","أنس بن مالك عن سعيد بن خالد الصيداوي عن محمد بن شعيب بن شابور القرشي عن الوليد بن شجاع عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4285","1529 - (  4284  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمِقْدَامِ الْعِجْلِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ حُمْرانَ ،  حَدَّثَنَا  الْحَارِثُ بْنُ زِيَادٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  خَرَجْنَا مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي جِنَازَةٍ ، فَرَأَى نِسْوَةً ، فَقَالَ : أَتَحْمِلْنَهُ ؟ قُلْنَ : لَا ، قَالَ : تَدْفِنَّهُ ؟ قُلْنَ : لَا ، قَالَ :  فَارْجِعْنَ مَأْزُورَاتٍ غَيْرَ مَأْجُورَاتٍ  .  في طبعة دار المأمون للتراث : (حمدان) وقد تقدم عند المصنف (1301) على الصواب ، والله أعلم .","","Musnad Abi Ya'la al-Mawsili 4284","","أنس بن مالك عن الحارث بن زياد عن محمد بن حمران القيسي عن أحمد بن المقدام العجلي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4286","1530 - (  4285  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  حَدَّثَنَا  نُوحُ بْنُ قَيْسٍ ،  حَدَّثَنَا  أَشْعَثُ الْحُدَّانِيُّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : قَالَ رَبُّكُمْ :  مَنْ أَذْهَبْتُ  كَرِيمَتَيْهِ  ، ثُمَّ صَبَرَ  وَاحْتَسَبَ  ، كَانَ ثَوَابُهُ الْجَنَّةَ  .","","Musnad Abi Ya'la al-Mawsili 4285","","أنس بن مالك عن أشعث بن عبد الله بن جابر الحداني عن نوح بن قيس بن رباح الحداني عن سليمان بن داود العتكي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4287","1531 - (  4286  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  حَدَّثَنَا  حَنْظَلَةُ بْنُ عَبْدِ اللهِ ،  عَنْ  أَنَسٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَنَتَ فِي صَلَاةِ الصُّبْحِ بَعْدَ         [7/269]      الرُّكُوعِ  ، قَالَ : فَسَمِعْتُهُ يَدْعُو فِي  قُنُوتِهِ  عَلَى الْكَفَرَةِ ، قَالَ : وَسَمِعْتُهُ يَقُولُ : وَاجْعَلْ قُلُوبَهُمْ كَقُلُوبِ نِسَاءٍ  كَوَافِرَ  .","","Musnad Abi Ya'la al-Mawsili 4286","","أنس بن مالك عن حنظلة بن عبد الله السدوسي عن حماد بن زيد عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4288","1532 - (  4287  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  حَنْظَلَةَ ،  عَنْ  أَنَسٍ ، قَالَ  :  قِيلَ : يَا رَسُولَ اللهِ ، أَيَنْحَنِي بَعْضُنَا لِبَعْضٍ إِذَا الْتَقَيْنَا ؟ قَالَ : لَا  ، قَالَ : فَيَلْتَزِمُ بَعْضُنَا لِبَعْضٍ ؟ قَالَ : لَا ، قَالَ : فَيُصَافِحُ بَعْضُنَا لِبَعْضٍ ؟ قَالَ : تَصَافَحُوا  .         [7/270]","","Musnad Abi Ya'la al-Mawsili 4287","","أنس بن مالك عن حنظلة بن عبد الله السدوسي عن حماد بن زيد عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4289","1533 - (  4288  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  حَنْظَلَةُ ،  عَنْ  أَنَسٍ ،  أَنَّ  امْرَأَةً  أَتَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَمَسَحَ وَجْهَهَا ، وَكَانُوا يَأْتُونَهُ فَيَمْسَحُ وُجُوهَهُنَّ وَيَدْعُو لَهُنَّ  ، فَقَالَتْ : يَا رَسُولَ اللهِ ، طَأْطِئْ يَدَكَ ، قَالَ : فَدَفَعَهَا ، وَقَالَ : إِلَيْكِ عَنِّي  .","","Musnad Abi Ya'la al-Mawsili 4288","","أنس بن مالك عن حنظلة بن عبد الله السدوسي عن حماد بن زيد عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4290","1534 - (  4289  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  حَدَّثَنَا  حَمَّادٌ ، قَالَ :  سَمِعْتُ  حَنْظَلَةَ بْنَ عَبْدِ اللهِ ، قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ ، يَقُولُ :  قِيلَ : يَا رَسُولَ اللهِ ، أَيَنْحَنِي بَعْضُنَا لِبَعْضٍ إِذَا الْتَقَيْنَا ؟ قَالَ : لَا  ، قُلْتُ : فَيَلْتَزِمُ بَعْضُنَا لِبَعْضٍ ؟ قَالَ : لَا ، قَالَ : فَيُصَافِحُ بَعْضُنَا بَعْضًا ؟ قَالَ : نَعَمْ  .         [7/271]","","Musnad Abi Ya'la al-Mawsili 4289","","أنس بن مالك عن حنظلة بن عبد الله السدوسي عن حماد بن زيد عن سليمان بن داود العتكي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4291","1535 - (  4290  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ الْأَشَجُّ ،  حَدَّثَنَا  عُقْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنِي  عَنْبَسَةُ الْقَاصُّ ،  حَدَّثَنَا  حَنْظَلَةُ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  عُمُرُ  الذُّبَابِ  أَرْبَعُونَ يَوْمًا ،  وَالذُّبَابُ  كُلُّهُ فِي النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 4290","","أنس بن مالك عن حنظلة بن عبد الله السدوسي عن عنبسة بن سعيد الواسطي عن عقبة بن خالد بن عقبة عن عبد الله بن سعيد الأشج عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4292","1536 - (  4291  ) -  حَدَّثَنَا  صَالِحُ بْنُ حَرْبٍ أَبُو مَعْمَرٍ ،  حَدَّثَنَا  سَلَّامُ بْنُ أَبِي خُبْزَةَ ،  حَدَّثَنَا  حَنْظَلَةُ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَكَلَ مِنْ هَاتَيْنِ الشَّجَرَتَيْنِ : الثُّومِ وَالْبَصَلِ فَلَا يَقْرَبَنَّ مِنْ مُصَلَانَا  ، وَلْيَأْتِنِي أَمْسَحْ وَجْهَهُ وَأُعَوِّذْهُ  .","","Musnad Abi Ya'la al-Mawsili 4291","","أنس بن مالك عن حنظلة بن عبد الله السدوسي عن سلام بن أبي خبزة البصري عن صالح بن حرب بن خالد الهاشمي مولاهم عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4293","1537 - (  4292  ) -  حَدَّثَنَا  وَاصِلُ بْنُ عَبْدِ الْأَعْلَى الْكُوفِيُّ ،         [7/272]      حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنِ  الْحُسَيْنِ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  زَارَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أُمَّ سُلَيْمٍ  فَصَلَّى فِي بَيْتِهَا صَلَاةَ تَطَوُّعٍ ، فَقَالَ : يَا  أُمَّ سُلَيْمٍ  ،  إِذَا صَلَّيْتِ الْمَكْتُوبَةَ ، فَقُولِي : سُبْحَانَ اللهِ عَشْرًا ، وَاللهُ أَكْبَرُ عَشْرًا  ، ثُمَّ سَلِي مَا شِئْتِ ، فَإِنَّهُ يَقُولُ لَكِ : نَعَمْ ، ثَلَاثَ مَرَّاتٍ  .","","Musnad Abi Ya'la al-Mawsili 4292","","أنس بن مالك عن الحسين بن أبي سفيان عن عبد الرحمن بن إسحاق بن سعد  الواسطي عن محمد بن فضيل بن غزوان عن واصل بن عبد الأعلى الأسدي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4294","1538 - (  4293  ) -  حَدَّثَنَا  مَنْصُورُ بْنُ أَبِي مُزَاحِمٍ ،  حَدَّثَنَا  عُمَرُ بْنُ أَبِي خَلِيفَةَ ، عَنْ ضِرَارِ بْنِ مُسْلِمٍ ، قَالَ :  سَمِعْتُهُ  ذَكَرَهُ ،         [7/273]      عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  أَوْصَانِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  يَا  أَنَسُ  ، أَسْبِغِ الْوُضُوءَ يُزَدْ فِي عُمُرِكَ ، يَا  أَنَسُ  صَلِّ صَلَاةَ الضُّحَى ، فَإِنَّهَا صَلَاةُ  الْأَوَّابِينَ  مِنْ قَبْلِكَ  ، يَا  أَنَسُ  ، سَلِّمْ عَلَى أَهْلِ بَيْتِكَ تَكْثُرْ حَسَنَاتُكَ ، يَا  أَنَسُ  ، سَلِّمْ عَلَى مَنْ لَقِيتَ مِنْ أُمَّتِي تَكْثُرْ حَسَنَاتُكَ ، يَا  أَنَسُ  ، أَكْثِرِ الصَّلَاةَ بِاللَّيْلِ وَالنَّهَارِ يُحِبَّكَ حَافِظَاكَ ، يَا  أَنَسُ  ، بِتْ وَأَنْتَ طَاهِرٌ ، فَإِنْ مُتَّ مُتَّ شَهِيدًا ، يَا  أَنَسُ  ، وَقِّرِ الْكَبِيرَ ، وَارْحَمِ الصَّغِيرَ  .         [7/274]","","Musnad Abi Ya'la al-Mawsili 4293","","أنس بن مالك عن ضرار بن مسلم الباهلي عن عمر بن أبي خليفة العبدي عن منصور بن أبي مزاحم عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4295","1539 - (  4294  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ الْأَشَجُّ ، قَالَ :  حَدَّثَنِي  عُقْبَةُ بْنُ خَالِدٍ ، قَالَ :  حَدَّثَنِي  يُوسُفُ بْنُ إِبْرَاهِيمَ التَّمِيمِيُّ ،  أَنَّهُ سَمِعَ  أَنَسَ بْنَ مَالِكٍ ، يَقُولُ :  سُئِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَيُّ أَهْلِ بَيْتِكَ أَحَبُّ إِلَيْكَ ؟ قَالَ :  الْحَسَنُ  وَالْحُسَيْنُ  ، قَالَ : فَكَانَ يَقُولُ  لِفَاطِمَةَ  : ادْعِي ابْنَيَّ ، فَيَشُمُّهُمَا وَيَضُمُّهُمَا إِلَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 4294","","أنس بن مالك عن يوسف بن إبراهيم الجوهري عن عقبة بن خالد بن عقبة عن عبد الله بن سعيد الأشج عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4296","1540 - (  4295  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ ،  حَدَّثَنَا  شُبَيْلُ بْنُ عَزْرَةَ ، قَالَ : دَخَلْتُ أَنَا  وَقَتَادَةُ  عَلَى  أَنَسِ بْنِ مَالِكٍ  ،  فَحَدَّثَنَا  أَنَسُ بْنُ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَثَلُ الْجَلِيسِ الصَّالِحِ مَثَلُ الْعَطَّارِ ، إِنْ أَصَابَكَ مِنْهُ ، وَإِلَّا أَصَابَكَ مِنْ رِيحِهِ  ، وَمَثَلُ الْجَلِيسِ السَّوْءِ         [7/275]      مَثَلُ الْقَيْنِ ، إِنْ أَصَابَكَ مِنْهُ ، وَإِلَّا أَصَابَكَ مِنْ  دُخَانِهِ  .","","Musnad Abi Ya'la al-Mawsili 4295","","أنس بن مالك عن شبيل بن عزرة الضبعي عن جعفر بن سليمان الضبعي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4297","1541 - (  4296  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ بْنِ مَيْسَرَةَ ،  حَدَّثَنَا  السَّكَنُ بْنُ إِسْمَاعِيلَ الْأَصَمُّ ،  حَدَّثَنَا  زِيَادٌ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الدَّالُّ عَلَى الْخَيْرِ كَفَاعِلِهِ ، وَاللهُ يُحِبُّ إِغَاثَةَ  اللهْفَانِ  .         [7/276]","","Musnad Abi Ya'la al-Mawsili 4296","","أنس بن مالك عن زياد الفاكهي عن السكن بن إسماعيل البرجمي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4298","1542 - (  4297  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ،  حَدَّثَنَا  بِشْرُ بْنُ السَّرِيِّ ،  حَدَّثَنَا  عُمَارَةُ بْنُ زَاذَانَ ،  عَنْ  زِيَادٍ النُّمَيْرِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  إِذَا عَلَا  نَشَزًا  مِنَ الْأَرْضِ ، يَقُولُ : اللَّهُمَّ لَكَ الشَّرَفُ عَلَى كُلِّ شَرَفٍ  ، وَلَكَ الْحَمْدُ عَلَى كُلِّ حَالٍ  .         [7/277]","","Musnad Abi Ya'la al-Mawsili 4297","","أنس بن مالك عن زياد بن عبد الله النميري عن عمارة بن زاذان الصيدلاني عن بشر بن السري عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4299","1543 - (  4298  ) -  حَدَّثَنَا  نَافِعُ بْنُ خَالِدٍ الطَّاحِيُّ ، وَمُحَمَّدُ بْنُ بَحْرٍ ، قَالَا :  حَدَّثَنَا  نُوحُ بْنُ قَيْسٍ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ مَوْلَى قَيْسٍ ،  عَنْ  زِيَادٍ النُّمَيْرِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ :  مَنْ بَنَى لِلهِ مَسْجِدًا ، صَغِيرًا كَانَ أَوْ كَبِيرًا ، بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  .","","Musnad Abi Ya'la al-Mawsili 4298","","أنس بن مالك عن زياد بن عبد الله النميري عن عبدالرحمن القيسي عن نوح بن قيس بن رباح الحداني عن محمد بن بحر الهجيمي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4300","1544 - (  4299  ) -  حَدَّثَنَا  أَبُو الْجَهْمِ الْأَزْرَقُ بْنُ عَلِيٍّ ،  حَدَّثَنَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  حَدَّثَنَا  الْحَسَنُ بْنُ صَالِحٍ ،  عَنْ  جَابِرٍ الْجُعْفِيِّ ،  عَنْ  زِيَادٍ النُّمَيْرِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  أَتَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - شَجَرَةً ، فَهَزَّهَا حَتَّى تَسَاقَطَ مِنْ وَرَقِهَا مَا شَاءَ اللهُ أَنْ يَتَسَاقَطَ  ، ثُمَّ قَالَ : الْأَوْجَاعُ وَالْمُصِيبَاتُ أَسْرَعُ فِي ذُنُوبِ ابْنِ آدَمَ مِنِّي فِي هَذِهِ الشَّجَرَةِ  .         [7/278]","","Musnad Abi Ya'la al-Mawsili 4299","","أنس بن مالك عن زياد بن عبد الله النميري عن جابر الجعفي عن الحسن بن صالح بن صالح بن حي عن يحيى بن أبي بكير عن الأزرق بن علي بن مسلم الحنفي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4301","1545 - (  4300  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَحْرٍ فِي  بَلْهُجَيْمٍ  بِالْبَصْرَةِ  ،  حَدَّثَنِي  عَدِيُّ بْنُ أَبِي عُمَارَةَ الْجَرْمِيُّ ،  حَدَّثَنَا  زِيَادٌ النُّمَيْرِيُّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَدَخَلَ دَارًا مِنْ دُورِ  بَنِي النَّجَّارِ  ، فَخَرَجَ إِلَيْنَا مُنْتَقِعًا لَوْنُهُ ، فَقَالَ : مَنْ أَهْلُ هَذِهِ الْقُبُورِ ؟ قَالُوا : قُبُورٌ ، مَاتُوا فِي الْجَاهِلِيَّةِ ، قَالَ : ثُمَّ أَقْبَلَ عَلَيْنَا ، فَقَالَ :  تَعَوَّذُوا بِاللهِ مِنْ عَذَابِ الْقَبْرِ ، فَوَالَّذِي نَفْسِي بِيَدِهِ لَقَدْ رَأَيْتُ أَبْدَانَهُمْ كَيْفَ يُعَذَّبُونَ فِي قُبُورِهِمْ  .","","Musnad Abi Ya'la al-Mawsili 4300","","أنس بن مالك عن زياد بن عبد الله النميري عن عدي بن أبي عمارة القسام عن محمد بن بحر الهجيمي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4302","1546 - (  4301  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَحْرٍ ،  حَدَّثَنَا  عَدِيُّ بْنُ أَبِي عُمَارَةَ ،  حَدَّثَنَا  زِيَادٌ النُّمَيْرِيُّ ،         [7/279]      عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الشَّيْطَانَ وَاضِعٌ خَطْمَهُ عَلَى قَلْبِ ابْنِ آدَمَ ، فَإِنْ ذَكَرَ اللهَ  خَنَسَ  ، وَإِنْ نَسِيَ الْتَقَمَ قَلْبَهُ فَذَلِكَ الْوَسْوَاسُ الْخَنَّاسُ  .","","Musnad Abi Ya'la al-Mawsili 4301","","أنس بن مالك عن زياد بن عبد الله النميري عن عدي بن أبي عمارة القسام عن محمد بن بحر الهجيمي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4303","1547 - (  4302  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُعَلَّى بْنُ مَنْصُورٍ ،  أَخْبَرَنِي  مُحَمَّدُ بْنُ مُسْلِمٍ ، قَالَ :  سَمِعْتُ  زِيَادًا النُّمَيْرِيَّ  يُحَدِّثُ ، عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  بَيْنَمَا رَجُلٌ مِمَّنْ كَانَ قَبْلَكُمْ يَخْرُجُ فِي بُرْدَيْنِ ، فَاخْتَالَ فِيهِمَا ، فَأَمَرَ اللهُ الْأَرْضَ فَأَخَذَتْهُ  ، فَهُوَ  يَتَجَلْجَلُ  فِيهَا إِلَى يَوْمِ الْقِيَامَةِ  .         [7/280]","","Musnad Abi Ya'la al-Mawsili 4302","","أنس بن مالك عن زياد بن عبد الله النميري عن محمد بن مسلم بن أبي الوضاح القضاعي عن معلى بن منصور الرازي عن زهير بن حرب عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4304","1548 - (  4303  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُعَلَّى بْنُ مَنْصُورٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ أَبُو سَعِيدٍ ، قَالَ :  حَدَّثَنِي  زِيَادٌ النُّمَيْرِيُّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  اشْتَكَتِ النَّارُ إِلَى رَبِّهَا ، فَقَالَتْ : رَبِّ ، أَكَلَ بَعْضِي بَعْضًا ، فَجَعَلَ لَهَا نَفَسَيْنِ  : نَفَسًا فِي الشِّتَاءِ ، وَنَفَسًا فِي الصَّيْفِ ، فَشِدَّةُ مَا تَجِدُونَ مِنَ الْحَرِّ حَرُّهَا ، وَشِدَّةُ مَا تَجِدُونَ مِنَ الْبَرْدِ مِنْ زَمْهَرِيرِهَا  .         [7/281]","","Musnad Abi Ya'la al-Mawsili 4303","","أنس بن مالك عن زياد بن عبد الله النميري عن محمد بن مسلم بن أبي الوضاح القضاعي عن معلى بن منصور الرازي عن زهير بن حرب عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4305","1549 - (  4304  ) -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  حَدَّثَنَا  أَبُو جَنَابٍ ، قَالَ :  حَدَّثَنِي  زِيَادٌ النُّمَيْرِيُّ ، قَالَ  أَبُو جَنَابٍ  : حَلَفَ ثَلَاثَةَ أَيْمَانٍ بِاللهِ الَّذِي لَا إِلَهَ إِلَّا هُوَ الرَّحْمَنُ الرَّحِيمُ ،  أَنَّهُ سَمِعَ  أَنَسَ بْنَ مَالِكٍ ، وَحَلَفَ بِاللهِ الَّذِي لَا إِلَهَ إِلَّا هُوَ الرَّحْمَنُ الرَّحِيمُ ، أَنَّهُ سَمِعَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  الشَّفَاعَةُ لِأَهْلِ الْكَبَائِرِ مِنْ أُمَّتِي  .","","Musnad Abi Ya'la al-Mawsili 4304","","أنس بن مالك عن زياد بن عبد الله النميري عن يحيى بن أبي حية عن عبد الواحد بن غياث عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4306","1550 - (  4305  ) -  وَعَنْ  أَنَسٍ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  أَنَا  سَيِّدُ  وَلَدِ آدَمَ وَلَا  فَخْرَ ،  وَأَنَا أَوَّلُ مَنْ تَنْشَقُّ عَنْهُ الْأَرْضُ وَلَا  فَخْرَ  ، وَأَنَا أَوَّلُ مَنْ يَأْخُذُ بِحَلْقَةِ بَابِ الْجَنَّةِ وَلَا  فَخْرَ ،  وَلِوَاءُ  الْحَمْدِ  بِيَدِي وَلَا  فَخْرَ  .         [7/282]","","Musnad Abi Ya'la al-Mawsili 4305","","أنس بن مالك عن زياد بن عبد الله النميري عن عون بن ذكوان القصاب عن عبد الواحد بن غياث عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4307","1551 - (  4306  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  عَبْدِ اللهِ بْنِ عِيسَى ،  عَنْ  عَبْدِ اللهِ بْنِ جَبْرٍ ،         [7/283]      عَنْ  أَنَسٍ ، قَالَ  : كَانَ  شَابٌّ يَهُودِيٌّ  يَخْدُمُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَمَرِضَ ،  فَأَتَاهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَعُودُهُ ، فَقَالَ : أَتَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَنِّي رَسُولُ اللهِ  ؟ قَالَ : فَجَعَلَ يَنْظُرُ إِلَى أَبِيهِ ، فَقَالَ لَهُ : قُلْ كَمَا يَقُولُ لَكَ  مُحَمَّدٌ  ، فَقَالَ : فَقَبِلَ ثُمَّ مَاتَ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِأَصْحَابِهِ : صَلُّوا عَلَى صَاحِبِكُمْ  .         [7/284]","","Musnad Abi Ya'la al-Mawsili 4306","","أنس بن مالك عن عبد الله بن عبد الله بن جابر بن عتيك الحجازي عن عبد الله بن عيسى بن عبد الرحمن بن أبي ليلى عن شريك بن عبد الله النخعي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4308","1552 - (  4307  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  شُجَاعُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  أَبُو خَالِدٍ الَّذِي يَكُونُ فِي  بَنِي دَالَانَ  ،  عَنْ  عَبْدِ اللهِ بْنِ عِيسَى ،  عَنْ  عَبْدِ اللهِ بْنِ جَبْرٍ الْأَنْصَارِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  يَكْفِي أَحَدَكُمْ مِنَ الْوُضُوءِ مُدٌّ ، وَمَنَ الْغُسْلِ صَاعٌ  .         [7/285]","","Musnad Abi Ya'la al-Mawsili 4307","","أنس بن مالك عن عبد الله بن عبد الله بن جابر بن عتيك الحجازي عن عبد الله بن عيسى بن عبد الرحمن بن أبي ليلى عن أبو خالد الدالاني عن شجاع بن الوليد السكوني عن زهير بن حرب عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4309","1553 - (  4308  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ زُهَيْرُ بْنُ حَرْبٍ ، وَأَبُو سَعِيدٍ الْقَوَارِيرِيُّ ، وَاللَّفْظُ  لِأَبِي خَيْثَمَةَ  ، قَالَا :  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ جَبْرٍ ، قَالَ :  سَمِعْتُ  أَنَسًا ، يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  آيَةُ الْمُؤْمِنِ حُبُّ         [7/286]      الْأَنْصَارِ  ، وَآيَةُ الْمُنَافِقِ بُغْضُ  الْأَنْصَارِ  .","","Musnad Abi Ya'la al-Mawsili 4308","","أنس بن مالك عن عبد الله بن عبد الله بن جابر بن عتيك الحجازي عن شعبة بن الحجاج عن عبد الرحمن بن مهدي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4310","1554 - (  4309  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ جَبْرٍ ، قَالَ :  سَمِعْتُ  أَنَسًا ، يَقُولُ  :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَبَعْضُ أَزْوَاجِهِ يَغْتَسِلَانِ مِنْ إِنَاءٍ وَاحِدٍ  .","","Musnad Abi Ya'la al-Mawsili 4309","","أنس بن مالك عن عبد الله بن عبد الله بن جابر بن عتيك الحجازي عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4311","1555 - (  4310  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ، قَالَ :  حَدَّثَنِي  سُلَيْمَانُ بْنُ أَبِي سُلَيْمَانَ مَوْلَى ابْنِ عَبَّاسٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَمَّا خَلَقَ اللهُ الْأَرْضَ جَعَلَتْ  تَمِيدُ  ، فَخَلَقَ الْجِبَالَ فَأَلْقَاهَا عَلَيْهَا فَاسْتَقَرَّتْ  ، فَتَعَجَّبَتِ الْمَلَائِكَةُ مِنْ خَلْقِ الْجِبَالِ ، فَقَالَتْ : يَا رَبِّ ، هَلْ مِنْ خَلْقِكَ شَيْءٌ أَشَدُّ مِنَ الْجِبَالِ ؟ قَالَ : نَعَمِ ، الْحَدِيدُ ، قَالَتْ : يَا رَبِّ ، فَهَلْ مِنْ خَلْقِكَ شَيْءٌ أَشَدُّ مِنَ الْحَدِيدِ ؟ قَالَ : نَعَمِ ، النَّارُ ، قَالَتْ : يَا رَبِّ ، فَهَلْ مِنْ خَلْقِكَ شَيْءٌ أَشَدُّ مِنَ النَّارِ ؟ قَالَ : نَعَمِ ،         [7/287]      الْمَاءُ ، قَالَتْ : يَا رَبِّ ، فَهَلْ مِنْ خَلْقِكَ شَيْءٌ أَشَدُّ مِنَ الْمَاءِ ؟ قَالَ : نَعَمِ ، الرِّيحُ ، قَالَتْ : يَا رَبِّ ، فَهَلْ مِنْ خَلْقِكَ شَيْءٌ أَشَدُّ مِنَ الرِّيحِ ؟ قَالَ : نَعَمِ ، الْإِنْسَانُ يَتَصَدَّقُ بِيَمِينِهِ وَيُخْفِيهَا مِنْ شِمَالِهِ  .","","Musnad Abi Ya'la al-Mawsili 4310","","أنس بن مالك عن سليمان بن أبي سليمان مولى ابن عباس عن العوام بن حوشب عن يزيد بن هارون عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4312","1556 - (  4311  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو خَيْثَمَةَ زُهَيْرُ بْنُ حَرْبٍ ، قَالَا :  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  جَعْفَرِ بْنِ بُرْقَانَ ،  عَنِ  ابْنِ أَبِي نُشْبَةَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ثَلَاثٌ مِنْ أَصْلِ الْإِسْلَامِ : الْكَفُّ عَمَّنْ قَالَ : لَا إِلَهَ إِلَّا اللهُ ، لَا يُكَفِّرُهُ بِذَنْبٍ  ، وَلَا يُخْرِجُهُ مِنَ الْإِسْلَامِ بِعَمَلٍ ،  وَالْجِهَادُ  مَاضٍ مُنْذُ بَعَثَنِي اللهُ إِلَى أَنْ يُقَاتِلَ آخِرُ أُمَّتِي  الدَّجَّالَ  لَا يُبْطِلُهُ جَوْرُ جَائِرٍ وَلَا عَدْلُ عَادِلٍ ، وَالْإِيمَانُ بِالْأَقْدَارِ كُلِّهَا  .","","Musnad Abi Ya'la al-Mawsili 4311","","أنس بن مالك عن يزيد بن أبي نشبة السلمي عن جعفر بن برقان الكلابي عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4313","1557 - (  4312  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  حَدَّثَنَا  جَعْفَرُ بْنُ بُرْقَانَ ،  عَنِ  ابْنِ أَبِي نُشْبَةَ ،         [7/288]      عَنْ  أَنَسٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ثَلَاثٌ مِنْ أَصْلِ الْإِيمَانِ : الْكَفُّ عَمَّنْ قَالَ : لَا إِلَهَ إِلَّا اللهُ ، لَا يُكَفِّرُهُ بِذَنْبٍ  ، وَلَا يُخْرِجُهُ مِنَ الْإِسْلَامِ بِفِعْلٍ ،  وَالْجِهَادُ  مَاضٍ مُنْذُ بَعَثَنِي اللهُ إِلَى أَنْ تُقَاتِلَ أُمَّتِي  الدَّجَّالَ  لَا يُبْطِلُهُ جَوْرُ جَائِرٍ وَلَا عَدْلُ عَادِلٍ ، وَالْإِيمَانُ بِالْأَقْدَارِ كُلِّهَا  .","","Musnad Abi Ya'la al-Mawsili 4312","","أنس بن مالك عن يزيد بن أبي نشبة السلمي عن جعفر بن برقان الكلابي عن أبو معاوية الضرير عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4314","1558 - (  4313  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الْقَاسِمِ بْنِ شُرَيْحٍ ،  عَنْ  أَبِي بَحْرٍ ،  عَنْ  أَنَسٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  عَجَبًا لِلْمُؤْمِنِ ، إِنَّ اللهَ لَا يَقْضِي لَهُ قَضَاءً إِلَّا كَانَ خَيْرًا لَهُ  .","","Musnad Abi Ya'la al-Mawsili 4313","","أنس بن مالك عن ثعلبة بن مالك الكوفي عن القاسم بن شريح عن سفيان الثوري عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4315","1559 - (  4314  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  مَهْدِيُّ بْنُ مَيْمُونٍ ،  عَنْ  غَيْلَانَ بْنِ جَرِيرٍ ،  عَنْ  أَنَسٍ قَالَ :  إِنَّكُمْ لَتَعْمَلُونَ أَعْمَالًا هِيَ أَدَقُّ فِي أَعْيُنِكُمْ مِنَ الشَّعَرِ  ، كُنَّا نَعُدُّهَا عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ  الْمُوبِقَاتِ  .","","Musnad Abi Ya'la al-Mawsili 4314","","أنس بن مالك عن غيلان بن جرير المعولي عن مهدي بن ميمون المعولي عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4316","1560 - (  4315  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا         [7/289]      وَكِيعٌ ،  عَنْ  عُثْمَانَ بْنِ سَعْدٍ ، قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ ، يَقُولُ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا نَزَلَ مَنْزِلًا لَمْ يَرْتَحِلْ مِنْهُ حَتَّى يُوَدِّعَهُ بِرَكْعَتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 4315","","أنس بن مالك عن عثمان بن سعد التميمي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4317","1561 - (  4316  ) -  حَدَّثَنَا  سُفْيَانُ بْنُ وَكِيعِ بْنِ الْجَرَّاحِ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  عُثْمَانَ بْنِ سَعْدٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا سَافَرَ فَنَزَلَ مَنْزِلًا فَأَرَادَ أَنْ يَرْتَحِلَ وَدَّعَ الْمَنْزِلَ بِرَكْعَتَيْنِ  .         [7/290]","","Musnad Abi Ya'la al-Mawsili 4316","","أنس بن مالك عن عثمان بن سعد التميمي عن وكيع بن الجراح عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4318","1562 - (  4317  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ بْنِ حِسَابٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  أَنَسٍ ، قَالَ :  قَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : يَا بُنَيَّ  .","","Musnad Abi Ya'la al-Mawsili 4317","","أنس بن مالك عن الجعد بن دينار اليشكري عن الوضاح بن عبد الله اليشكري عن محمد بن عبيد بن حساب الغبري عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4319","1563 - (  4318  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  فُضَيْلُ بْنُ عِيَاضٍ ،  عَنْ  مَنْصُورٍ ،  عَنْ  رِبْعِيِّ بْنِ حِرَاشٍ ،  عَنْ  أَبِي الْأَبْيَضِ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  كُنَّا نُصَلِّي مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْعَصْرَ وَالشَّمْسُ بَيْضَاءُ  مُحَلِّقَةٌ  ، فَآتِي عَشِيرَتِي فَأَجِدُهُمْ جُلُوسًا ، فَأَقُولُ لَهُمْ : قُومُوا فَصَلُّوا ، فَقَدْ صَلَّى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  .         [7/291]","","Musnad Abi Ya'la al-Mawsili 4318","","أنس بن مالك عن أبو الأبيض العنسي عن ربعي بن حراش العبسي عن منصور بن المعتمر عن الفضيل بن عياض عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4320","1564 - (  4319  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  هِشَامٍ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَنَسٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا أَكَلُوا عِنْدَ أَهْلِ بَيْتٍ ، قَالَ : أَفْطَرَ عِنْدَكُمُ الصَّائِمُونَ  ، وَأَكَلَ طَعَامَكُمُ الْأَبْرَارُ ، وَصَلَّتْ عَلَيْكُمُ الْمَلَائِكَةُ  .         [7/292]","","Musnad Abi Ya'la al-Mawsili 4319","","أنس بن مالك عن يحيى بن أبي كثير عن هشام الدستوائي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4321","1565 - (  4320  ) -  حَدَّثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  حَدَّثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  حَدَّثَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا أَفْطَرَ عِنْدَ أَهْلِ بَيْتٍ ، قَالَ : أَفْطَرَ عِنْدَكُمُ الصَّائِمُونَ  ، وَأَكَلَ طَعَامَكُمُ الْأَبْرَارُ ، وَتَنَزَّلَتْ عَلَيْكُمُ الْمَلَائِكَةُ  .","","Musnad Abi Ya'la al-Mawsili 4320","","أنس بن مالك عن يحيى بن أبي كثير عن هشام الدستوائي عن يونس بن بكير عن عقبة بن مكرم عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4322","1566 - (  4321  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا أَفْطَرَ عِنْدَ قَوْمٍ ، قَالَ : أَفْطَرَ عِنْدَكُمُ الصَّائِمُونَ  ، وَأَكَلَ طَعَامَكُمُ الْأَبْرَارُ ، وَتَنَزَّلَتْ عَلَيْكُمُ الْمَلَائِكَةُ  .","","Musnad Abi Ya'la al-Mawsili 4321","","أنس بن مالك عن يحيى بن أبي كثير عن هشام الدستوائي عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4323","1567 - (  4322  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى الْمِصْرِيُّ ،         [7/293]      حَدَّثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  الْخَلِيلُ بْنُ مُرَّةَ ، أَنَّ يَحْيَى بْنَ أَبِي كَثِيرٍ الْيَمَامِيَّ  حَدَّثَهُ  ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا أَفْطَرَ عِنْدَ أَهْلِ بَيْتٍ ، قَالَ : أَفْطَرَ عِنْدَكُمُ الصَّائِمُونَ  ، وَأَكَلَ طَعَامَكُمُ الْأَبْرَارُ ، وَتَنَزَّلَتْ عَلَيْكُمُ الْمَلَائِكَةُ  .","","Musnad Abi Ya'la al-Mawsili 4322","","أنس بن مالك عن يحيى بن أبي كثير عن الخليل بن مرة الضبعي عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4324","1568 - (  4323  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ ، قَالَ :  حَدَّثَنِي  عَبْدُ اللهِ بْنُ نَافِعٍ ،  عَنْ  عُمَرَ بْنِ ذَكْوَانَ ،  عَنْ  دَاوُدَ بْنِ بَكْرٍ ،  عَنْ  زِيَادِ بْنِ أَبِي زِيَادٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّهُ سَيَكُونُ بَعْدِي أَئِمَّةٌ فَسَقَةٌ ، يُصَلُّونَ الصَّلَاةَ لِغَيْرِ وَقْتِهَا ، فَإِذَا فَعَلُوا ذَلِكَ فَصَلُّوا الصَّلَاةَ لِوَقْتِهَا  ، وَاجْعَلُوا الصَّلَاةَ مَعَهُمْ نَافِلَةً  .         [7/294]","","Musnad Abi Ya'la al-Mawsili 4323","","أنس بن مالك عن زياد بن أبي زياد المخزومي عن داود بن بكر بن أبي الفرات الأشجعي عن عمر بن حفص بن ذكوان العبدي عن عبد الله بن نافع الصائغ عن محمد بن إسحاق المسيبي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4325","1569 - (  4324  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  شُعْبَةَ ،  عَنْ  حَمْزَةَ الضَّبِّيِّ ، قَالَ :  سَمِعْتُ  أَنَسًا ، يَقُولُ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  إِذَا نَزَلَ مَنْزِلًا لَمْ يَرْتَحِلْ حَتَّى يُصَلِّيَ الظُّهْرَ  ، قَالَ : فَقَالَ لَهُ  مُحَمَّدُ بْنُ عَمْرٍو  :  وَإِنْ كَانَ بِنِصْفِ النَّهَارِ ؟ قَالَ : وَإِنْ كَانَ بِنِصْفِ النَّهَارِ  .","","Musnad Abi Ya'la al-Mawsili 4324","","أنس بن مالك عن حمزة بن عمرو العائذي عن شعبة بن الحجاج عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4326","1570 - (  4325  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  حَمْزَةَ الضَّبِّيِّ ، قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ ، يَقُولُ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا نَزَلَ مَنْزِلًا لَمْ يَرْتَحِلْ حَتَّى يُصَلِّيَ الظُّهْرَ  ، فَقَالَ لَهُ  مُحَمَّدُ بْنُ عَمْرٍو  :  يَا  أَبَا حَمْزَةَ  ، وَإِنْ كَانَ بِنِصْفِ النَّهَارِ ؟ قَالَ : وَإِنْ كَانَ بِنِصْفِ النَّهَارِ  .         [7/295]","","Musnad Abi Ya'la al-Mawsili 4325","","أنس بن مالك عن حمزة بن عمرو العائذي عن شعبة بن الحجاج عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4327","1571 - (  4326  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى ،  عَنْ  شُعْبَةَ ،  عَنْ  حَمْزَةَ الْعَائِذِيِّ ، قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا نَزَلَ مَنْزِلًا لَمْ يَرْتَحِلْ مِنْهُ حَتَّى يُصَلِّيَ الظُّهْرَ  ،  قَالَ : فَقَالَ لَهُ رَجُلٌ : وَإِنْ كَانَ بِنِصْفِ النَّهَارِ ؟ قَالَ : وَإِنْ كَانَ بِنِصْفِ النَّهَارِ  .","","Musnad Abi Ya'la al-Mawsili 4326","","أنس بن مالك عن حمزة بن عمرو العائذي عن شعبة بن الحجاج عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4328","1572 - (  4327  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  شُعْبَةَ ،  عَنْ  عَتَّابٍ مَوْلَى هُرْمُزَ ، قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ ، يَقُولُ :  بَايَعْنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى السَّمْعِ وَالطَّاعَةِ  ، فَقَالَ : فِيمَا اسْتَطَعْتُمْ  .","","Musnad Abi Ya'la al-Mawsili 4327","","أنس بن مالك عن عتاب مولى هرمز عن شعبة بن الحجاج عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4329","1573 - (  4328  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنِ  الْحَكَمِ بْنِ عَطِيَّةَ ،  عَنْ  أَبِي الْمُخَيِّسِ الْيَشْكُرِيِّ ،         [7/296]      عَنْ  أَنَسِ بْنِ مَالِكٍ ،  قِيلَ : يَا رَسُولَ اللهِ ، اسْتُشْهِدَ فُلَانٌ مَوْلَاكَ ، قَالَ : كَلَّا  ، إِنِّي رَأَيْتُ عَلَيْهِ عَبَاءَةً غَلَّهَا يَوْمَ  كَذَا وَكَذَا  .","","Musnad Abi Ya'la al-Mawsili 4328","","أنس بن مالك عن أبو المخيس اليشكري عن الحكم بن عطية العيشي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4330","1574 - (  4329  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  زَيْدُ بْنُ الْحُبَابِ ، قَالَ :  حَدَّثَنِي  فُلَيْحُ بْنُ سُلَيْمَانَ الْمَدِينِيُّ ،  حَدَّثَنَا  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  أَنَّهُ سَمِعَ  أَنَسَ بْنَ مَالِكٍ ، يَقُولُ :  كُنَّا نُصَلِّي مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْجُمُعَةَ إِذَا مَالَتِ الشَّمْسُ  .         [7/297]","","Musnad Abi Ya'la al-Mawsili 4329","","أنس بن مالك عن عثمان بن عبد الرحمن بن عثمان التيمي عن فليح بن سليمان عن زيد بن الحباب العكلي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4331","1575 - (  4330  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يُونُسُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  فُلَيْحٌ ،  عَنْ  عُثْمَانَ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّ أَنَسَ بْنَ مَالِكٍ  أَخْبَرَهُ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُصَلِّي الْعَصْرَ بِقَدْرِ مَا يَذْهَبُ الرَّجُلُ إِلَى  بَنِي حَارِثَةَ بْنِ الْحَارِثِ  ، وَيَرْجِعُ قَبْلَ غُرُوبِ الشَّمْسِ ، وَبِقَدْرِ مَا يَنْحَرُ الرَّجُلُ  الْجَزُورَ  وَيُعَضِّيهَا لِغُرُوبِ الشَّمْسِ ، وَكَانَ لَا يُصَلِّي الْجُمُعَةَ حَتَّى تَمِيلَ الشَّمْسُ ، وَكَانَ إِذَا خَرَجَ إِلَى  مَكَّةَ  صَلَّى الظُّهْرَ بِالشَّجَرَةِ رَكْعَتَيْنِ  .         [7/298]","","Musnad Abi Ya'la al-Mawsili 4330","","أنس بن مالك عن عثمان بن عبد الرحمن بن عثمان التيمي عن فليح بن سليمان عن يونس بن محمد بن مسلم البغدادي عن زهير بن حرب عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4332","1576 - (  4331  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  سَعْدِ بْنِ سَعِيدٍ ،  حَدَّثَنِي  أَنَسُ بْنُ مَالِكٍ ، قَالَ :  بَعَثَنِي  أَبُو طَلْحَةَ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِأَدْعُوَهُ ، وَقَدْ جَعَلَ لَهُ طَعَامًا ، قَالَ : فَأَقْبَلْتُ وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَعَ النَّاسِ ، قَالَ : فَنَظَرَ إِلَيَّ فَاسْتَحْيَيْتُ ، فَقُلْتُ : أَجِبْ  أَبَا طَلْحَةَ  ، فَقَالَ لِلنَّاسِ : قُومُوا ،  فَقَالَ  أَبُو طَلْحَةَ  : يَا رَسُولَ اللهِ ، إِنَّمَا صَنَعْتُ شَيْئًا لَكَ ، قَالَ : فَمَسَّهَا رَسُولُ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَدَعَا لَهَا فِيهِ بِالْبَرَكَةِ ، وَقَالَ : أَدْخِلْ نَفَرًا مِنْ أَصْحَابِي عَشَرَةً ، قَالَ : كُلُوا ، فَأَخْرَجَ لَهُمْ شَيْئًا بَيْنَ أَصَابِعِهِ ، فَأَكَلُوا حَتَّى شَبِعُوا ، وَخَرَجُوا ، فَمَا زَالَ يُدْخِلُ عَشَرَةً وَيُخْرِجُ عَشَرَةً حَتَّى لَمْ يَبْقَ مِنْهُمْ أَحَدٌ إِلَّا دَخَلَ فَأَكَلَ حَتَّى شَبِعَ ، قَالَ : ثُمَّ هَيَّأَهَا فَإِذَا هِيَ مِثْلُهَا حِينَ أَكَلُوا مِنْهَا  .","","Musnad Abi Ya'la al-Mawsili 4331","","أنس بن مالك عن سعد بن سعيد بن قيس الأنصاري عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4333","1577 - (  4332  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ، وَمُحَمَّدُ بْنُ بِشْرٍ ،  عَنْ  زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  سَعِيدِ بْنِ أَبِي بُرْدَةَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ اللهَ لَيَرْضَى         [7/299]      عَنِ الْعَبْدِ يَأْكُلُ الْأَكْلَةَ أَوْ يَشْرَبُ الشَّرْبَةَ فَيَحْمَدُهُ عَلَيْهَا  .","","Musnad Abi Ya'la al-Mawsili 4332","","أنس بن مالك عن سعيد بن أبي بردة الأشعري عن زكريا بن أبي زائدة الوادعي عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4334","1578 - (  4333  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  حَدَّثَنَا  زَكَرِيَّا ، قَالَ :  حَدَّثَنِي  سَعِيدُ بْنُ أَبِي بُرْدَةَ ،  عَنْ  أَنَسٍ ، قَالَ :  خَدَمْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تِسْعَ سِنِينَ ، فَمَا أَعْلَمُهُ قَالَ لِي قَطُّ : مَا فَعَلْتَ كَذَا وَكَذَا  ؟ أَوْ عَابَ عَلَيَّ شَيْئًا قَطُّ  .         [7/300]","","Musnad Abi Ya'la al-Mawsili 4333","","أنس بن مالك عن سعيد بن أبي بردة الأشعري عن زكريا بن أبي زائدة الوادعي عن محمد بن بشر بن الفرافصة عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4335","1579 - (  4334  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ يُوسُفَ ،  حَدَّثَنَا  زَكَرِيَّا ،  عَنْ  سَعِيدِ بْنِ أَبِي بُرْدَةَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ اللهَ لَيَرْضَى عَنِ الْعَبْدِ أَنْ يَأْخُذَ الْأَكْلَةَ فَيَحْمَدَ اللهَ عَلَيْهَا ، أَوْ يَشْرَبَ الشَّرْبَةَ  .","","Musnad Abi Ya'la al-Mawsili 4334","","أنس بن مالك عن سعيد بن أبي بردة الأشعري عن زكريا بن أبي زائدة الوادعي عن إسحاق بن يوسف الأزرق عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4336","1580 - (  4335  ) -  حَدَّثَنَا  زُهَيْرُ بْنُ حَرْبٍ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ يُوسُفَ ،  حَدَّثَنَا  زَكَرِيَّا بْنُ أَبِي زَائِدَةَ ،  عَنْ  سَعِيدِ بْنِ أَبِي بُرْدَةَ ،  عَنْ  أَنَسٍ ، قَالَ :  خَدَمْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تِسْعَ سِنِينَ ، فَمَا أَعْلَمُهُ قَالَ لِي قَطُّ : لِمَ فَعَلْتَ كَذَا وَكَذَا  ؟ وَلَا عَابَ عَلَيَّ شَيْئًا قَطُّ  .","","Musnad Abi Ya'la al-Mawsili 4335","","أنس بن مالك عن سعيد بن أبي بردة الأشعري عن زكريا بن أبي زائدة الوادعي عن إسحاق بن يوسف الأزرق عن زهير بن حرب عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4337","1581 - (  4336  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  مُعَلَّى بْنُ مَنْصُورٍ ، وَخَالِدُ بْنُ مَخْلَدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُحَمَّدِ بْنِ سَعْدٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  صَلَاةُ الْقَاعِدِ عَلَى مِثْلِ نِصْفِ صَلَاةِ الْقَائِمِ  .         [7/301]","","Musnad Abi Ya'la al-Mawsili 4336","","أنس بن مالك عن إسماعيل بن محمد بن سعد عن عبد الله بن جعفر بن عبد الرحمن بن المسور بن مخرمة عن خالد بن مخلد القطواني عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4338","1582 - (  4337  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي سَمِينَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  حَدَّثَنَا  أَبَانُ بْنُ خَالِدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ رَوَاحَةَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَا يُصَلِّي الضُّحَى إِلَّا أَنْ يَقْدَمَ مِنْ سَفَرٍ  أَوْ يَخْرُجَ  .         [7/302]","","Musnad Abi Ya'la al-Mawsili 4337","","أنس بن مالك عن عبيد الله بن رواحة البصري عن أبان بن خالد السعدي عن عبد الرحمن بن مهدي عن محمد بن إسماعيل بن أبي سمينة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4339","1583 - (  4338  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  زَيْدُ بْنُ الْحُبَابِ ، قَالَ :  حَدَّثَنِي  الرَّبِيعُ بْنُ سُلَيْمٍ ، قَالَ :  حَدَّثَنِي  أَبُو عَمْرٍو مَوْلَى أَنَسِ بْنِ مَالِكٍ ،  أَنَّهُ سَمِعَ  أَنَسَ بْنَ مَالِكٍ يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ خَزَنَ لِسَانَهُ سَتَرَ اللهُ  عَوْرَتَهُ  ، وَمَنْ كَفَّ غَضَبَهُ كَفَّ اللهُ عَنْهُ عَذَابَهُ  ، وَمَنِ اعْتَذَرَ إِلَى اللهِ قَبِلَ اللهُ مِنْهُ عُذْرَهُ  .         [7/303]","","Musnad Abi Ya'la al-Mawsili 4338","","أنس بن مالك عن أبو عمرو عن الربيع بن سليم الكوفي عن زيد بن الحباب العكلي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4340","1584 - (  4339  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَوْنٍ الْخَرَّازُ ،  حَدَّثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  نُفَيْعٍ ،  عَنْ  أَنَسٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَا مِنْ أَحَدٍ يَوْمَ الْقِيَامَةِ غَنِيٍّ وَلَا فَقِيرٍ ، إِلَّا وَدَّ أَنَّمَا كَانَ أُوتِيَ فِي الدُّنْيَا قُوتًا  .","","Musnad Abi Ya'la al-Mawsili 4339","","أنس بن مالك عن نفيع بن الحارث الأعمى عن إسماعيل بن أبي خالد عن مروان بن معاوية الفزاري عن عبد الله بن عون الهلالي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4341","1585 - (  4340  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  حَدَّثَنَا  الْحُسَيْنُ بْنُ وَاقِدٍ ، قَالَ :  حَدَّثَنِي  مُعَاذُ بْنُ حَرْمَلَةَ الْأَزْدِيُّ ، قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَأْتِي         [7/304]      عَلَى النَّاسِ زَمَانٌ يُمْطَرُ النَّاسُ مَطَرًا عَامًّا ، وَلَا تُنْبِتُ الْأَرْضُ شَيْئًا  .","","Musnad Abi Ya'la al-Mawsili 4340","","أنس بن مالك عن معاذ بن حرملة الأنصاري عن الحسين بن واقد المروزي عن زيد بن الحباب العكلي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4342","1586 - (  4341  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَوْنٍ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  أَبِي دَاوُدَ ،  عَنْ  أَنَسٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا مِنْ ذِي غِنًى إِلَّا سَيَوَدُّ يَوْمَ الْقِيَامَةِ لَوْ كَانَ إِنَّمَا أُوتِيَ فِي الدُّنْيَا قُوتًا  .","","Musnad Abi Ya'la al-Mawsili 4341","","أنس بن مالك عن نفيع بن الحارث الأعمى عن إسماعيل بن أبي خالد عن أبو معاوية الضرير عن عبد الله بن عون الهلالي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4343","1587 - (  4342  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عُبَيْدُ بْنُ سَعِيدٍ ، قَالَ :  سَمِعْتُ  شُعْبَةَ يَذْكُرُ ،  عَنْ  أَبِي مَسْلَمَةَ الْأَزْدِيِّ ، قَالَ :  سَأَلْتُ  أَنَسَ بْنَ مَالِكٍ :  أَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي فِي نَعْلَيْهِ ؟ قَالَ : نَعَمْ  .         [7/305]","","Musnad Abi Ya'la al-Mawsili 4342","","أنس بن مالك عن سعيد بن يزيد الطاحي عن شعبة بن الحجاج عن عبيد بن سعيد بن أبان القرشي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4344","1588 - (  4343  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ يَعْنِي الْمُقْرِئَ ،  حَدَّثَنَا  سَعِيدٌ ، قَالَ :  حَدَّثَنِي  الضَّحَّاكُ بْنُ شُرَحْبِيلَ الْعَكِّيُّ ،  عَنْ  أَعْيَنَ الْبَصْرِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ تَرَكَ -  يَعْنِي مَالًا  - فَلِأَهْلِهِ ، وَمَنْ تَرَكَ دَيْنًا فَعَلَى اللهِ وَرَسُولِهِ  .","","Musnad Abi Ya'la al-Mawsili 4343","","أنس بن مالك عن أعين أبو يحيى البصري عن الضحاك بن شرحبيل الغافقي عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن هارون بن معروف المروزي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4345","1589 - (  4344  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْمَاعِيلَ  ،  عَنْ  عُمَارَةَ بْنِ عَاصِمٍ ، قَالَ :  دَخَلْتُ عَلَى أَنَسِ بْنِ مَالِكٍ بَيْتَهُ فَسَأَلْتُهُ عَنِ النَّبِيذِ ؟ فَقَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ  الدُّبَّاءِ  وَالْمُزَفَّتِ  ، قُلْتُ :  وَالْحَنْتَمُ  ؟ فَأَعَادَهَا عَلَيَّ ، قُلْنَا : مَا الْحَنْتَمُ ؟ قَالَ :  الْجَرُّ  الْأَخْضَرُ .         [7/306]      قَالَ  أَنَسُ بْنُ مَالِكٍ  : يَا جَارِيَةُ ، ائْتِنِي بِذَاكَ  الْجَرِّ  الْأَخْضَرِ ، فَأَتَتْهُ بِجَرٍّ ، فَصَبَّ لِي فِيهِ قَدَحَ نَبِيذٍ فَشَرِبْتُهُ ، ثُمَّ قَالَ : مَا رَأَيْتُ جَرًّا أَخْضَرَ حَتَّى ذَهَبَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَكِنَّ الْحَنْتَمَ جِرَارٌ خُضْرٌ كَانَتْ تَأْتِينَا مِنْ  مِصْرَ  ، ثُمَّ أَتَتْهُ الْجَارِيَةُ ، فَقَالَتِ : الصَّلَاةَ ، أَصْلَحَكَ اللهُ ، قَالَ : أَيُّ الصَّلَاةِ ؟ قَالَتْ : صَلَاةُ الْعَصْرِ ، فَقُلْتُ : قَدْ صَلَّيْتُهَا قَبْلَ أَنْ أَدْخُلَ إِلَيْكِ ، قَالَ : اسْتَأْخِرِي عَنِّي ، لَمْ تَأْتِ الْعَصْرُ بَعْدُ ، ثُمَّ رَاجَعَتْهُ ، فَقَالَ لَهَا مِثْلَ قَوْلِهِ الْأَوَّلِ ، ثُمَّ رَاجَعَتْهُ فَقَالَتْ لَهُ ، فَقَالَ : قَدْ سَمِعْتُ مَا قُلْتِ ، نَاوِلِينِي وَضُوءًا فَإِنَّ النَّاسَ يُصَلُّونَ هَذِهِ الصَّلَاةَ قَبْلَ وَقْتِهَا ، ثُمَّ صَلَّى  .  كذا في طبعة دار المأمون للتراث ، والصواب: (محمد بن أبي إسماعيل). كما في مصادر التخريج.","","Musnad Abi Ya'la al-Mawsili 4344","","أنس بن مالك عن عمارة بن عاصم العنزى عن محمد بن أبي إسماعيل السلمي عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4346","1590 - (  4345  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  الْحَسَنُ بْنُ مُوسَى ،  حَدَّثَنَا  زُهَيْرٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي أَسْمَاءَ الصَّيْقَلِ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  خَرَجْنَا نَصْرُخُ بِالْحَجِّ ، فَلَمَّا قَدِمْنَا  مَكَّةَ  أَمَرَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ نَجْعَلَهَا عُمْرَةً وَقَالَ :  لَوْ أَنِّي         [7/307]      اسْتَقْبَلْتُ  مِنْ أَمْرِي مَا اسْتَدْبَرْتُ لَجَعَلْتُهَا عُمْرَةً  ، وَلَكِنِّي سُقْتُ الْهَدْيَ ، وَقَرَنْتُ  الْحَجَّ  وَالْعُمْرَةَ  .","","Musnad Abi Ya'la al-Mawsili 4345","","أنس بن مالك عن أبو أسماء الصيقل عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4347","1591 - (  4346  ) -  حَدَّثَنَا  عَمْرُو بْنُ الضَّحَّاكِ بْنِ مَخْلَدٍ ،  حَدَّثَنَا  أَبِي  ،  حَدَّثَنَا  شَبِيبُ بْنُ بِشْرٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  عَيْنَانِ لَا تَمَسُّهُمَا         [7/308]      النَّارُ أَبَدًا  : عَيْنٌ بَاتَتْ تَكْلَأُ الْمُسْلِمِينَ فِي  سَبِيلِ  اللهِ ، وَعَيْنٌ بَكَتْ مِنْ خَشْيَةِ اللهِ  .","","Musnad Abi Ya'la al-Mawsili 4346","","أنس بن مالك عن شبيب بن بشر البجلي عن أبو عاصم النبيل عن عمرو بن الضحاك بن مخلد عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4348","1592 - (  4347  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  الْفَضْلُ بْنُ دُكَيْنٍ ،  عَنْ  زُهَيْرٍ ،  عَنْ  عُثْمَانَ بْنِ حَكِيمٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ حَاطِبٍ ،  عَنْ  أَبِي طَلْحَةَ الْأَسَدِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَرَجَ فَرَأَى  قُبَّةً  مُشْرِفَةً ، فَقَالَ : مَا هَذِهِ ؟ قَالَ لَهُ أَصْحَابُهُ : هَذِهِ  لِرَجُلٍ مِنَ الْأَنْصَارِ  ، فَمَكَثَ وَحَمَلَهَا فِي نَفْسِهِ ، حَتَّى إِذَا جَاءَ صَاحِبُهَا رَسُولَ         [7/309]      اللهِ فَسَلَّمَ فِي النَّاسِ أَعْرَضَ عَنْهُ ، فَصَنَعَ ذَلِكَ بِهِ مِرَارًا ، حَتَّى عَرَفَ الرَّجُلُ الْغَضَبَ فِيهِ وَالْإِعْرَاضَ عَنْهُ ، فَشَكَا ذَلِكَ إِلَى أَصْحَابِهِ ، فَقَالَ : وَاللهِ إِنِّي لَأُنْكِرُ نَظَرَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَا أَدْرِي مَا حَدِيثٌ فِيَّ وَمَا صَنَعْتُ ؟ قَالُوا : خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَأَى  قُبَّتَكَ  ، فَقَالَ : لِمَنْ هَذِهِ ؟ فَأَخْبَرْنَاهُ ، فَرَجَعَ إِلَى  قُبَّتِهِ  فَسَوَّاهَا بِالْأَرْضِ ، فَخَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ يَوْمٍ ، فَلَمْ يَرَ  الْقُبَّةَ  ، فَقَالَ :  مَا فَعَلَتِ  الْقُبَّةُ  الَّتِي كَانَتْ هَاهُنَا  ؟ قَالَ : شَكَا إِلَيْنَا صَاحِبُهَا إِعْرَاضَكَ عَنْهُ فَأَخْبَرْنَاهُ ، فَهَدَمَهَا ، قَالَ : إِنَّ كُلَّ بِنَاءٍ بُنِيَ  وَبَالٌ  عَلَى صَاحِبِهِ يَوْمَ الْقِيَامَةِ إِلَّا مَا لَا بُدَّ مِنْهُ  .         [7/310]","","Musnad Abi Ya'la al-Mawsili 4347","","أنس بن مالك عن أبو طلحة الأسدي عن إبراهيم بن محمد بن حاطب الجمحي عن عثمان بن حكيم الأحلافي عن زهير بن معاوية بن حديج عن الفضل بن دكين عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4349","1593 - (  4348  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَعْفَرُ بْنُ عَوْنٍ ،  حَدَّثَنَا  أَبُو الْعُمَيْسِ ،  حَدَّثَنَا  أَبُو طَلْحَةَ  قَالَ  :  قَدِمَ أَنَسٌ  الْكُوفَةَ  قَالَ : فَأَتَاهُ النَّاسُ فَقَالُوا : حَدِّثْنَا مَا سَمِعْتَ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : وَهُوَ يَقُولُ :  إِلَيْكُمْ عَنِّي أَيُّهَا النَّاسُ حَتَّى أَلْجَئُوهُ إِلَى حَائِطِ الْقَصْرِ  ، ثُمَّ قَالَ : يَا أَيُّهَا النَّاسُ لَوْ تَعْلَمُونَ مَا أَعْلَمُ لَضَحِكْتُمْ قَلِيلًا وَلَبَكَيْتُمْ كَثِيرًا ، أَيُّهَا النَّاسُ انْصَرِفُوا عَنِّي ، فَانْصَرَفُوا  .","","Musnad Abi Ya'la al-Mawsili 4348","","أنس بن مالك عن أبو طلحة الأسدي عن عتبة بن عبد الله بن عتبة المسعودي عن جعفر بن عون المخزومي عن زهير بن حرب عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4350","1594 - (  4349  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ الْبَخْتَرِيُّ الْوَاسِطِيُّ أَبُو عَبْدِ اللهِ الْمَكْفُوفُ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ بْنُ زَيْدٍ الْعَمِّيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ تَزَوَّجَ فَقَدْ أُعْطِيَ نِصْفَ الْعِبَادَةِ  .         [7/311]","","Musnad Abi Ya'la al-Mawsili 4349","","أنس بن مالك عن زيد بن الحواري العمي عن عبد الرحيم بن زيد بن الحواري العمي عن يزيد بن هارون عن محمد بن إسماعيل بن البختري الحسانى عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4351","1595 - (  4350  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  مَعْبَدُ بْنُ هِلَالٍ الْعَنَزِيُّ ، قَالَ :  اجْتَمَعَ رَهْطٌ مِنْ  أَهْلِ الْبَصْرَةِ  وَأَنَا فِيهِمْ ، فَأَتَيْنَا أَنَسَ بْنَ مَالِكٍ وَشَفِعْنَا إِلَيْهِ  بِثَابِتٍ الْبُنَانِيِّ  ، فَدَخَلْنَا عَلَيْهِ ، فَأَجْلَسَ  ثَابِتًا  مَعَهُ عَلَى السَّرِيرِ ، فَقُلْتُ : لَا تَسْأَلُوهُ عَنْ شَيْءٍ غَيْرِ هَذَا الْحَدِيثِ ، فَقَالَ  ثَابِتٌ  : يَا  أَبَا حَمْزَةَ  ، إِخْوَانُكَ مِنْ  أَهْلِ الْبَصْرَةِ  جَاءُوا يَسْأَلُونَكَ عَنْ حَدِيثِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الشَّفَاعَةِ ، فَقَالَ : حَدَّثَنَا  مُحَمَّدٌ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا كَانَ يَوْمُ الْقِيَامَةِ مَاجَ النَّاسُ بَعْضُهُمْ فِي بَعْضٍ  ، فَيُؤْتَى  آدَمُ  ، فَيَقُولُونَ : يَا  آدَمُ  ، اشْفَعْ لِذُرِّيَّتِكَ ، فَيَقُولُ : لَسْتُ لَهَا ، وَلَكِنِ ائْتُوا  إِبْرَاهِيمَ  ، فَإِنَّهُ  خَلِيلُ  اللهِ ، فَيُؤْتَى  إِبْرَاهِيمُ  ، فَيَقُولُ : لَسْتُ لَهَا ، وَلَكِنْ عَلَيْكُمْ  بِمُوسَى  فَإِنَّهُ كَلِيمُ اللهِ ، فَيُؤْتَى  مُوسَى  صَفْوَةُ اللهِ ، فَيَقُولُ : لَسْتُ لَهَا ، وَلَكِنْ عَلَيْكُمْ  بِعِيسَى  فَإِنَّهُ رُوحُ اللهِ وَكَلِمَتُهُ ، فَيُؤْتَى  عِيسَى  ، فَيَقُولُ : لَسْتُ لَهَا ، وَلَكِنْ عَلَيْكُمْ  بِمُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأُوتَى ، فَأَقُولُ : أَنَا لَهَا ، فَأَنْطَلِقُ فَأَسْتَأْذِنُ عَلَى رَبِّي ، فَيُؤْذَنُ لِي عَلَيْهِ ، فَأَقُومُ بَيْنَ يَدَيْهِ مَقَامًا ،  فَيُلْهِمُنِي  فِيهِ مَحَامِدَ لَا أَقْدِرُ عَلَيْهَا الْآنَ ، فَأَحْمَدُهُ بِتِلْكَ الْمَحَامِدِ ، ثُمَّ أَخِرُّ لَهُ سَاجِدًا ، فَيُقَالُ لِي : يَا  مُحَمَّدُ  ، ارْفَعْ رَأْسَكَ ، وَقُلْ يُسْمَعْ لَكَ ، وَسَلْ تُعْطَ ، وَاشْفَعْ تُشَفَّعْ ، فَأَقُولُ : أَيْ رَبِّ ، أُمَّتِي أُمَّتِي ، فَيُقَالُ لِي : انْطَلِقْ ، فَمَنْ كَانَ فِي         [7/312]      قَلْبِهِ  مِثْقَالُ  بُرَّةٍ ، أَوْ  مِثْقَالُ  شَعِيرَةٍ  مِنْ إِيمَانٍ فَأَخْرِجْهُ ، فَأَنْطَلِقُ فَأَفْعَلُ ، ثُمَّ أَعُودُ فَأَحْمَدُهُ بِتِلْكَ الْمَحَامِدِ ، فَأَخِرُّ لَهُ سَاجِدًا ، فَيُقَالُ : يَا  مُحَمَّدُ  ، ارْفَعْ رَأْسَكَ ، وَقُلْ يُسْمَعْ ، وَسَلْ تُعْطَ ، وَاشْفَعْ تُشَفَّعْ ، فَأَقُولُ : أَيْ رَبِّ ، أُمَّتِي أُمَّتِي فَيُقَالُ لِي : انْطَلِقْ ، فَمَنْ كَانَ فِي قَلْبِهِ  مِثْقَالُ  ذَرَّةٍ أَوْ  مِثْقَالُ  خَرْدَلَةٍ  مِنْ إِيمَانٍ فَأَخْرِجْهُ مِنْهَا ، فَأَنْطَلِقُ فَأَفْعَلُ ، ثُمَّ أَرْجِعُ ، فَأَحْمَدُهُ بِتِلْكَ الْمَحَامِدِ ، ثُمَّ أَخِرُّ لَهُ سَاجِدًا ، فَيُقَالُ : يَا  مُحَمَّدُ  ، ارْفَعْ رَأْسَكَ ، وَقُلْ يُسْمَعْ لَكَ ، وَسَلْ تُعْطَ ، وَاشْفَعْ تُشَفَّعْ ، فَأَقُولُ : أَيْ رَبِّ ، أُمَّتِي أُمَّتِي ، فَيُقَالُ لِي : انْطَلِقْ ، فَمَنْ كَانَ فِي قَلْبِهِ أَدْنَى أَدْنَى مِنْ  مِثْقَالِ  حَبَّةِ  خَرْدَلٍ مِنْ إِيمَانٍ فَأَخْرِجْهُ مِنَ النَّارِ ، مِنَ النَّارِ ، مِنَ النَّارِ .  فَلَمَّا رَجَعْنَا مِنْ عِنْدِ  أَنَسٍ  ، قُلْتُ لِأَصْحَابِي : هَلْ لَكُمْ فِي  الْحَسَنِ  ؟ وَهُوَ مُسْتَخْفٍ فِي  مَنْزِلِ أَبِي خَلِيفَةَ  فِي  عَبْدِ الْقَيْسِ  ، فَأَتَيْنَاهُ فَدَخَلْنَا عَلَيْهِ ، فَقُلْنَا : جِئْنَا مِنْ عِنْدِ أَخِيكَ  أَنَسٍ  ، فَلَمْ نَسْمَعْ مِثْلَ مَا حَدَّثَنَا فِي الشَّفَاعَةِ ، قَالَ : كَيْفَ حَدَّثَكُمْ ؟ قَالَ : فَحَدَّثْنَاهُ الْحَدِيثَ حَتَّى إِذَا بَلَغْنَا ، قَالَ : هِيهِ ! قُلْنَا : لَمْ يَزِدْنَا عَلَى هَذَا .  1596 - (  4351  ) - قَالَ : قَدْ حَدَّثَنَا هَذَا الْحَدِيثَ وَهُوَ جَمِيعٌ ، حَدَّثَنِي مُنْذُ عِشْرِينَ سَنَةً ، وَلَقَدْ تَرَكَ شَيْئًا فَلَا أَدْرِي أَنَسِيَ الشَّيْخُ أَمْ كَرِهَ أَنْ يُحَدِّثَكُمُوهُ فَتَتَّكِلُوا .         [7/313]      حَدَّثَنِي ، ثُمَّ قَالَ فِي الرَّابِعَةِ : ثُمَّ أَعُودُ فَأَخِرُّ لَهُ سَاجِدًا ، ثُمَّ أَحْمَدُ بِتِلْكَ الْمَحَامِدِ ، فَيُقَالُ لِي : يَا  مُحَمَّدُ  ، ارْفَعْ رَأْسَكَ ، وَقُلْ يُسْمَعْ ، وَسَلْ تُعْطَ ، وَاشْفَعْ تُشَفَّعْ ، فَأَقُولُ : أَيْ رَبِّ ، ائْذَنْ فِيمَنْ قَالَ : لَا إِلَهَ إِلَّا اللهُ بِهَا صَادِقًا ، قَالَ : فَيُقَالُ : لَيْسَ لَكَ ، وَعِزَّتِي وَكِبْرِيَائِي وَعَظَمَتِي لَأُخْرِجَنَّ مِنْهَا مَنْ قَالَ : لَا إِلَهَ إِلَّا اللهُ  .  قَالَ : فَأَشْهَدُ عَلَى  الْحَسَنِ  الْحَدِيثَ لَحَدَّثَنَا بِهَذَا الْحَدِيثِ يَوْمَ حَدَّثَ  أَنَسٌ  .","","Musnad Abi Ya'la al-Mawsili 4350","","أنس بن مالك عن معبد بن هلال العنزي عن حماد بن زيد عن سليمان بن داود العتكي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4352","1597 - (  4352  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  عُقْبَةُ بْنُ عَبْدِ اللهِ الرِّفَاعِيُّ الْأَصَمُّ ،  عَنِ  الْجَعْدِ أَبِي عُثْمَانَ ،  قَالَ  :  صَلَّى أَنَسُ بْنُ مَالِكٍ فِي  مَسْجِدِ بَنِي رِفَاعَةَ  هَاهُنَا ، فَأَمَرَ  رَجُلًا  مِنْ أَصْحَابِهِ أَنْ يُؤَذِّنَ ، فَصَلَّى بِهِمُ الصُّبْحَ ، فَلَمَّا أَنْ فَرَغَ مِنْ صَلَاتِهِ أَقْبَلَ عَلَى  الْقَوْمِ  ، فَقَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا صَلَّى بِأَصْحَابِهِ أَقْبَلَ عَلَى  الْقَوْمِ  ، فَقَالَ : اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ عَمَلٍ يُخْزِينِي  ، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ غِنًى يُطْغِينِي ، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ صَاحِبٍ يُرْدِينِي ، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ أَمْرٍ يُلْهِينِي ، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ فَقْرٍ يُنْسِينِي  .         [7/314]","","Musnad Abi Ya'la al-Mawsili 4352","","أنس بن مالك عن الجعد بن دينار اليشكري عن عقبة بن عبد الله الأصم عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4353","1598 - (  4353  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَحْرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْلَى ،  حَدَّثَنَا  عَنْبَسَةُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنِ  ابْنِ عَلَاقٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَعَشَّوْا وَلَوْ بِكَفٍّ مِنْ حَشَفٍ  ، فَإِنَّ تَرْكَ الْعَشَاءِ  مَهْرَمَةٌ  .","","Musnad Abi Ya'la al-Mawsili 4353","","أنس بن مالك عن عبد الملك بن علاق عن عنبسة بن عبد الرحمن بن عنبسة الأموي عن زنبور ، محمد بن يعلى السلمي عن محمد بن بحر الهجيمي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4354","1599 - (  4354  ) -  حَدَّثَنَا  قَطَنُ بْنُ نُسَيْرٍ الْغُبَرِيُّ ،  حَدَّثَنَا         [7/315]      جَعْفَرٌ ،  حَدَّثَنَا  الْجَعْدُ أَبُو عُثْمَانَ الْيَشْكُرِيُّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  سَمِعَتْ  أُمُّ سُلَيْمٍ  كَلَامَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ : بِأَبِي أَنْتَ وَأُمِّي يَا رَسُولَ اللهِ ، لَوْ دَعَوْتَ اللهَ لَهُ دَعَوَاتٍ  ، قَالَ  أَنَسٌ  : فَدَعَا لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِثَلَاثِ دَعَوَاتٍ ، قَدْ رَأَيْتُ ثِنْتَيْنِ فِي الدُّنْيَا ، وَأَرْجُو أَنْ أَرَى الثَّالِثَةَ فِي الْآخِرَةِ  .","","Musnad Abi Ya'la al-Mawsili 4354","","أنس بن مالك عن الجعد بن دينار اليشكري عن جعفر بن سليمان الضبعي عن قطن بن نسير الغبري عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4355","1600 - (  4355  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنِ  الْجَعْدِ أَبِي عُثْمَانَ قَالَ :  مَرَّ بِنَا أَنَسُ بْنُ مَالِكٍ فِي  مَسْجِدِ بَنِي ثَعْلَبَةَ  فَقَالَ  : أَصَلَّيْتُمْ ؟ قَالَ : قُلْنَا :  نَعَمْ ، وَذَاكَ صَلَاةُ الصُّبْحِ ، فَأَمَرَ رَجُلًا فَأَذَّنَ وَأَقَامَ ثُمَّ صَلَّى بِأَصْحَابِهِ  .","","Musnad Abi Ya'la al-Mawsili 4355","","أنس بن مالك عن الجعد بن دينار اليشكري عن حماد بن زيد عن سليمان بن داود العتكي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4356","1601 - (  4356  ) -  حَدَّثَنَا  عَمَّارٌ أَبُو يَاسِرٍ ،  حَدَّثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ الضُّبَعِيُّ ،  حَدَّثَنَا  الْجَعْدُ أَبُو عُثْمَانَ ،         [7/316]      حَدَّثَنَا  أَنَسُ بْنُ مَالِكٍ ، قَالَ :  أَعْرَسَ  النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِبَعْضِ نِسَائِهِ ، قَالَ : فَصَنَعَتْ لَهُ  أُمُّ سُلَيْمٍ  حَيْسًا ، ثُمَّ جَعَلَتْهُ فِي  تَوْرٍ  ، ثُمَّ قَالَتْ لِي : اذْهَبْ بِهَذَا إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَقْرِئْهُ مِنَّا السَّلَامَ ، وَأَخْبِرْهُ أَنَّ هَذَا لَنَا مِنْهُ قَلِيلٌ .  قَالَ  أَنَسٌ  : وَكَانُوا يَوْمَئِذٍ فِي  جَهْدٍ  شَدِيدٍ ، قَالَ : فَجِئْتُ بِهِ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقُلْتُ : يَا رَسُولَ اللهِ ، إِنَّهُ بَعَثَتْ بِهَا إِلَيْكَ  أُمُّ سُلَيْمٍ  ، وَهِيَ  تُقْرِئُكَ  السَّلَامَ ، وَتَقُولُ :  إِنَّ هَذَا لَكَ مِنَّا قَلِيلٌ  ، قَالَ : فَنَظَرَ إِلَيْهِ ، قَالَ : ضَعْهُ ، قَالَ : فَوَضَعْتُهُ ، ثُمَّ قَالَ لِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : اذْهَبْ ، فَادْعُ فُلَانًا وَفُلَانًا ، حَتَّى سَمَّى رِجَالًا كَثِيرًا ، وَمَنْ لَقِيتُ ، قَالَ : فَجِئْتُ وَالْبَيْتُ ، وَالصُّفَّةُ ، وَالْحُجْرَةُ مَلْأَى مِنَ النَّاسِ  .","","Musnad Abi Ya'la al-Mawsili 4356","","أنس بن مالك عن الجعد بن دينار اليشكري عن جعفر بن سليمان الضبعي عن عمار بن هارون المستملي عن أبو يعلى الموصلي","سعيد بن سنان عن أنس بن مالك"
"4357","[7/317]      مُسْنَدُ  عَائِشَةَ  1 - (  4357  ) -  أَخْبَرَنَا  أَبُو يَعْلَى أَحْمَدُ بْنُ عَلِيِّ بْنِ الْمُثَنَّى الْمَوْصِلِيُّ ،  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  حَدَّثَنَا  نَافِعٌ ،  عَنْ  مَوْلَاةٍ لِفَاكِهِ بْنِ الْمُغِيرَةَ ،  أَنَّهَا دَخَلَتْ عَلَى         [7/318]      عَائِشَةَ ، فَرَأَتْ فِي بَيْتِهَا رُمْحًا مَوْضُوعًا ، فَقُلْتُ :  يَا أُمَّ الْمُؤْمِنِينَ ، مَا تَصْنَعِينَ بِهَذَا الرُّمْحِ ؟ فَقَالَتْ : نَقْتُلُ بِهِ هَذِهِ  الْأَوْزَاغَ  ، فَإِنَّ نَبِيَّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَخْبَرَنَا أَنَّ  إِبْرَاهِيمَ  حِينَ أُلْقِيَ فِي النَّارِ لَمْ تَكُنْ دَابَّةٌ فِي الْأَرْضِ إِلَّا تُطْفِئُ عَنْهُ غَيْرَ  الْوَزَغِ  ، كَانَ يَنْفُخُ عَلَيْهِ ، فَأَمَرَنَا نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِقَتْلِهِ  .         [7/319]      قَالَ : وَأَخْبَرَنِي  عَبْدُ الرَّحْمَنِ السِّرَاجُ  : أَنَّ اسْمَهَا  سَائِبَةُ  ، قَالَ  شَيْبَانُ  :  يَعْنِي اسْمَ مَوْلَاةِ فَاكِهٍ  .","","Musnad Abi Ya'la al-Mawsili 4357","","عائشة بنت أبي بكر الصديق عن سائبة مولاة الفاكه بن المغيرة عن نافع مولى ابن عمر عن جرير بن حازم عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4358","2 - (  4358  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  جَرِيرٌ ،  حَدَّثَنَا  نَافِعٌ ،  عَنْ  مَوْلَاةٍ لِفَاكِهِ بْنِ الْمُغِيرَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ قَتْلِ الْحَيَّاتِ الَّتِي تَكُونُ فِي الْبُيُوتِ غَيْرَ ذِي  الطُّفْيَتَيْنِ  وَالْبَتْرَاءِ  ، فَإِنَّهُمَا يَطْمِسَانِ الْأَبْصَارَ ، وَيَقْتُلَانِ أَوْلَادَ الْحَبَالَى فِي بُطُونِهِنَّ ، وَمَنْ لَمْ يَقْتُلْهُمَا فَلَيْسَ مِنَّا  .         [7/320]","","Musnad Abi Ya'la al-Mawsili 4358","","عائشة بنت أبي بكر الصديق عن سائبة مولاة الفاكه بن المغيرة عن نافع مولى ابن عمر عن جرير بن حازم عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4359","3 - (  4359  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  جَرِيرٌ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا تَصَدَّقَتِ الْمَرْأَةُ مِنْ بَيْتِ زَوْجِهَا غَيْرَ مُفْسِدَةٍ فَلَهَا أَجْرُهَا  ، وَلِزَوْجِهَا أَجْرُ مَا         [7/321]      اكْتَسَبَ ، وَلَهَا أَجْرُ مَا نَوَتْ ، وَلِلْخَازِنِ مِثْلُ ذَلِكَ  .         [7/322]","","Musnad Abi Ya'la al-Mawsili 4359","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن جرير بن حازم عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4360","4 - (  4360  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  مَهْدِيُّ بْنُ مَيْمُونٍ ،  حَدَّثَنَا  أَبُو عُثْمَانَ الْأَنْصَارِيُّ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ ، أَنَّهَا سَمِعَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  كُلُّ مُسْكِرٍ حَرَامٌ  ، وَمَا أَسْكَرَ مِنْهُ  الْفَرَقُ  فَمِلْءُ الْكَفِّ مِنْهُ حَرَامٌ  .         [7/323]             [7/324]","","Musnad Abi Ya'la al-Mawsili 4360","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عمرو بن سالم الأنصاري عن مهدي بن ميمون المعولي عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4361","5 - (  4361  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ،  عَنْ  مَالِكٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَفْرَدَ  الْحَجَّ  .         [7/325]","","Musnad Abi Ya'la al-Mawsili 4361","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن مالك بن أنس عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4362","6 - (  4362  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  مَالِكٍ ،  عَنْ  أَبِي الْأَسْوَدِ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ نَوْفَلٍ ، كَانَ يَتِيمًا فِي  حِجْرِ  عُرْوَةَ  ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَفْرَدَ  الْحَجَّ  .         [7/326]","","Musnad Abi Ya'la al-Mawsili 4362","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن مالك بن أنس عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4363","7 - (  4363  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  مَالِكٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  أَنَّ  عَبْدَ اللهِ بْنَ مُحَمَّدِ بْنِ أَبِي بَكْرٍ الصِّدِّيقِ ،  أَخْبَرَ  عَبْدَ اللهِ بْنَ عُمَرَ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  أَلَمْ تَرَيْ إِلَى قَوْمِكِ حِينَ بَنَوُا  الْكَعْبَةَ  اقْتَصَرُوا عَنْ قَوَاعِدِ  إِبْرَاهِيمَ  ؟  قَالَتْ : قُلْتُ : يَا رَسُولَ اللهِ ، أَفَلَا تَرُدُّهَا عَلَى قَوَاعِدِ  إِبْرَاهِيمَ  ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : لَوْلَا حَدَاثَةُ قَوْمِكِ بِالْكُفْرِ ، قَالَ : فَقَالَ  عَبْدُ اللهِ بْنُ عُمَرَ  : لَئِنْ كَانَتْ  عَائِشَةُ  سَمِعَتْ هَذَا مِنْ رَسُولِ اللهِ مَا أُرَى         [7/327]      رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَرَكَ اسْتِلَامَ الرُّكْنَيْنِ اللَّذَيْنِ يَلِيَانِ الْحِجْرَ ، إِلَّا أَنَّ  الْبَيْتَ  لَمْ يُتَمَّمْ عَلَى قَوَاعِدِ  إِبْرَاهِيمَ  .         [7/328]","","Musnad Abi Ya'la al-Mawsili 4363","","عائشة بنت أبي بكر الصديق عن عبد الله بن محمد بن أبي بكر الصديق عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن مالك بن أنس عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4364","8 - (  4364  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  مَالِكٍ  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ أَنَّهَا قَالَتْ :  مَا  أُبَالِي  صَلَّيْتُ فِي  الْحِجْرِ  أَوْ فِي  الْبَيْتِ  .         [7/329]","","Musnad Abi Ya'la al-Mawsili 4364","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن مالك بن أنس عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4365","9 - (  4365  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  طَيِّبُ بْنُ سَلْمَانَ ، قَالَ :  سَمِعْتُ  عَمْرَةَ ، تَقُولُ :         [7/330]      سَمِعْتُ  أُمَّ الْمُؤْمِنِينَ ، تَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ صَلَّى  الْفَجْرَ - أَوْ قَالَ : الْغَدَاةَ  - فَقَعَدَ فِي مَقْعَدِهِ فَلَمْ يَلْغُ بِشَيْءٍ مِنْ أَمْرِ الدُّنْيَا  ، وَيَذْكُرُ اللهَ حَتَّى يُصَلِّيَ الضُّحَى أَرْبَعَ رَكَعَاتٍ خَرَجَ مِنْ ذُنُوبِهِ كَيَوْمِ وَلَدَتْهُ أُمُّهُ لَا ذَنْبَ لَهُ  .","","Musnad Abi Ya'la al-Mawsili 4365","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن الطيب بن سلمان عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4366","10 - (  4366  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  طَيِّبُ بْنُ سَلْمَانَ ، قَالَ :  قَالَتْ  عَمْرَةُ ،  سَمِعْتُ  أُمَّ الْمُؤْمِنِينَ ، تَقُولُ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي الضُّحَى أَرْبَعَ رَكَعَاتٍ  ، لَا يَفْصِلُ بَيْنَهُنَّ بِكَلَامٍ  .         [7/331]","","Musnad Abi Ya'la al-Mawsili 4366","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن الطيب بن سلمان عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4367","11 - (  4367  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  طَيِّبُ بْنُ سَلْمَانَ ، قَالَ :  سَمِعْتُ  عَمْرَةَ ، قَالَتْ :  وَسَمِعْتُ  عَائِشَةَ ، تَقُولُ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَنْهَى عَنِ  الْوِصَالِ  فِي الصِّيَامِ  ، وَيَأْمُرُ بِتَبْكِيرِ الْإِفْطَارِ ، وَتَأْخِيرِ السَّحُورِ  .         [7/332]","","Musnad Abi Ya'la al-Mawsili 4367","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن الطيب بن سلمان عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4368","12 - (  4368  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  أَبُو الرَّبِيعِ السَّمَّانُ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  نَبَاتُ الشَّعَرِ فِي الْأَنْفِ أَمَانٌ مِنَ الْجُذَامِ  .","","Musnad Abi Ya'la al-Mawsili 4368","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أشعث السمان عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4369","13 - (  4369  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  حَرْبُ بْنُ سُرَيْجٍ ، قَالَ :  حَدَّثَتْنِي  زَيْنَبُ بِنْتُ يَزِيدَ بْنِ وَاسِقٍ الْعَتَكِيَّةُ ،         [7/333]      أَنَّهَا سَمِعَتْ  عَائِشَةَ ، تَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الْأُمَمَ السَّالِفَةَ : الْمِائَةُ أُمَّةٌ  ، إِذَا شَهِدُوا لِعَبْدٍ بِخَيْرٍ وَجَبَتْ لَهُ الْجَنَّةُ ، وَإِنَّ أُمَّتِي الْخَمْسُونَ مِنْهُمْ أُمَّةٌ ، فَإِذَا شَهِدُوا لِعَبْدٍ بِخَيْرٍ وَجَبَتْ لَهُ الْجَنَّةُ  .  وَقَالَتْ  زَيْنَبُ  :  قَالَ  رَجُلٌ مِنْ نُسَّاكِ  أَهْلِ الشَّامِ  يُقَالُ لَهُ : شَهْرُ بْنُ حَوْشَبٍ :  مَا كَانَ  خُلُقُ  رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَا أُمَّ الْمُؤْمِنِينَ ؟ قَالَتِ :  الْقُرْآنُ يَا بُنَيَّ  ، قَالَتْ : فَقَالَ  شَهْرٌ  : حَسْبُكُمْ ، وَمَنْ يُطِيقُ الْقُرْآنَ ؟ قَالَتْ : مَنْ طَوَّقَهُ اللهُ يَا بُنَيَّ  .         [7/334]","","Musnad Abi Ya'la al-Mawsili 4369","","عائشة بنت أبي بكر الصديق عن زينب بنت يزيد بن واسق العتكية عن حرب بن سريج المنقري عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4370","14 - (  4370  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ، قَالَ :  قَالَتْ  عَائِشَةُ :  قَدْ أَوْتَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ كُلِّ اللَّيْلِ  ، ثُمَّ انْتَهَى  وِتْرُهُ  إِلَى السَّحَرِ  .         [7/335]","","Musnad Abi Ya'la al-Mawsili 4370","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن الوضاح بن عبد الله اليشكري عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4371","15 - (  4371  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ بْنِ يَزِيدَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  خَيَّرَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَاخْتَرْنَاهُ ، فَلَمْ يَجْعَلْهُ طَلَاقًا  .         [7/336]             [7/337]","","Musnad Abi Ya'la al-Mawsili 4371","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن إسماعيل بن زكريا شقوصا عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4372","16 - (  4372  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ ، بِمِثْلِهِ .","","Musnad Abi Ya'la al-Mawsili 4372","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن إسماعيل بن زكريا شقوصا عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4373","17 - (  4373  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  بُدَيْلِ بْنِ مَيْسَرَةَ ،  عَنْ  أَبِي الْجَوْزَاءِ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ لَا يَزِيدُ فِي الرَّكْعَتَيْنِ عَلَى  التَّشَهُّدِ  .         [7/338]","","Musnad Abi Ya'la al-Mawsili 4373","","عائشة بنت أبي بكر الصديق عن أوس بن عبد الله الربعي عن بديل بن ميسرة العقيلي عن عبد السلام بن حرب الملائي عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4374","18 - (  4374  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ ،  حَدَّثَنَا  عَلِيُّ بْنُ هَاشِمٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَحْرُمُ مِنَ الرَّضَاعَةِ مَا يَحْرُمُ مِنَ الْوِلَادَةِ  .         [7/339]","","Musnad Abi Ya'la al-Mawsili 4374","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن عبد الله بن أبي بكر بن محمد  ابن حزم عن هشام بن عروة بن الزبير عن علي بن هاشم العائذي عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4375","19 - (  4375  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ ،  عَنْ  عَلِيِّ بْنِ هَاشِمٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  بَكْرِ بْنِ وَائِلٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  مَا ضَرَبَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - امْرَأَةً قَطُّ  ، وَلَا ضَرَبَ خَادِمًا لَهُ قَطُّ ، وَلَا ضَرَبَ بِيَدِهِ شَيْئًا قَطُّ ، إِلَّا أَنْ يُجَاهِدَ فِي         [7/340]      سَبِيلِ  اللهِ ، وَمَا نِيلَ مِنْهُ شَيْءٌ  فَانْتَقَمَهُ  مِنْ صَاحِبِهِ إِلَّا أَنْ  تُنْتَهَكَ  مَحَارِمُ اللهِ فَيَنْتَقِمَ  .","","Musnad Abi Ya'la al-Mawsili 4375","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن بكر بن وائل التيمي عن هشام بن عروة بن الزبير عن علي بن هاشم العائذي عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4376","20 - (  4376  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي حَازِمٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُسْلِمِ بْنِ قُرْطٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا ذَهَبَ أَحَدُكُمْ         [7/341]      إِلَى الْخَلَاءِ فَلْيَسْتَطِبْ بِثَلَاثَةِ أَحْجَارٍ  ، فَإِنَّهَا تُجْزِئُهُ  .","","Musnad Abi Ya'la al-Mawsili 4376","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن مسلم بن قرط الحجازي عن سلمة بن دينار الأعرج عن عبد العزيز بن أبي حازم المخزومي عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4377","21 - (  4377  ) -  حَدَّثَنَا  يَحْيَى بْنُ مَعِينٍ ،  حَدَّثَنَا  عَبْدَةُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتِ :  اسْتَأْذَنَ  حَسَّانُ بْنُ ثَابِتٍ  رَسُولَ         [7/342]      اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي هِجَاءِ الْمُشْرِكِينَ ، قَالَ : فَكَيْفَ بِنَسَبِي فِيهِمْ  ؟ قَالَ :  لَأَسُلَّنَّكَ  مِنْهُمْ كَمَا تُسَلُّ الشَّعَرَةُ مِنَ الْعَجِينِ  .","","Musnad Abi Ya'la al-Mawsili 4377","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبدة بن سليمان الكلابي عن يحيى بن معين عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4378","22 - (  4378  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدَةُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ  الْوِصَالِ  ، قَالُوا : يَا رَسُولَ اللهِ : إِنَّكَ تُوَاصِلُ ؟ قَالَ : إِنَّمَا هِيَ رَحْمَةٌ رَحِمَكُمُ اللهُ ، إِنِّي لَسْتُ مِثْلَكُمْ ، إِنِّي أَظَلُّ عِنْدَ اللهِ يُطْعِمُنِي وَيَسْقِينِي  .         [7/343]","","Musnad Abi Ya'la al-Mawsili 4378","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبدة بن سليمان الكلابي عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4379","23 - (  4379  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدَةُ ، وَحُمَيْدٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  قَالَ :  حَدَّثَتْنِي  عَائِشَةُ ،  أَنَّ يَدَ سَارِقٍ لَمْ تُقْطَعْ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا فِي ثَمَنِ حَجَفَةٍ أَوْ تُرْسٍ  .","","Musnad Abi Ya'la al-Mawsili 4379","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حميد بن عبد الرحمن الرؤاسي عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4380","24 - (  4380  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  حِزَامِ بْنِ هِشَامٍ ،  أَخْبَرَنِي  أَبِي  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  لَقَدْ رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - غَضِبَ فِيمَا كَانَ مِنْ  شَأْنِ  بَنِي كَعْبٍ  غَضَبًا لَمْ أَرَهُ غَضِبَهُ مُنْذُ زَمَانٍ ، وَقَالَ :  لَا نَصَرَنِي اللهُ إِنْ لَمْ أَنْصُرْ  بَنِي كَعْبٍ  ، قَالَتْ : وَقَالَ لِي : قُولِي  لِأَبِي بَكْرٍ  ،  وَعُمَرَ  يَتَجَهَّزَا لِهَذَا الْغَزْوِ ، قَالَ : فَجَاءَا إِلَى  عَائِشَةَ  ، فَقَالَا : أَيْنَ يُرِيدُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ : فَقَالَتْ : لَقَدْ رَأَيْتُهُ غَضِبَ فِيمَا كَانَ مِنْ  شَأْنِ  بَنِي كَعْبٍ         [7/344]      غَضَبًا لَمْ أَرَهُ غَضِبَ مُنْذُ زَمَانٍ مِنَ الدَّهْرِ  .","","Musnad Abi Ya'la al-Mawsili 4380","","عائشة بنت أبي بكر الصديق عن هشام بن حبيش المخزومي عن حزام بن هشام القديدي عن عبد الله بن إدريس الأودي عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4381","25 - (  4381  ) -  حَدَّثَنَا  يَحْيَى بْنُ مَعِينٍ ،  حَدَّثَنَا  سَعِيدُ بْنُ الْحَكَمِ ،  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ، قَالَ :  حَدَّثَنِي  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  عَمْرَةَ بِنْتِ عَبْدِ الرَّحْمَنِ ،  قَالَتْ  :  كَانَ  بِمَكَّةَ  امْرَأَةٌ  مَزَّاحَةٌ فَنَزَلَتْ عَلَى  امْرَأَةٍ  مِثْلِهَا ، فَبَلَغَ ذَلِكَ عَائِشَةَ ، فَقَالَتْ : صَدَقَ حِبِّي ، سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  الْأَرْوَاحُ  جُنُودٌ  مُجَنَّدَةٌ  ، فَمَا تَعَارَفَ مِنْهَا ائْتَلَفَ ، وَمَا تَنَاكَرَ مِنْهَا اخْتَلَفَ  ، قَالَ : وَلَا أَعْلَمُ إِلَّا قَالَ فِي الْحَدِيثِ : وَلَا تُعْرَفُ تِلْكَ الْمَرْأَةُ  .         [7/345]","","Musnad Abi Ya'la al-Mawsili 4381","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن يحيى بن سعيد الأنصاري عن يحيى بن أيوب الغافقي عن سعيد بن الحكم الجمحي عن يحيى بن معين عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4382","26 - (  4382  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  قَرَأْتُ عَلَى  مَالِكِ بْنِ أَنَسٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ زَوْجِ النَّبِيِّ ، أَنَّهَا قَالَتْ :  مَا خُيِّرَ بَيْنَ أَمْرَيْنِ إِلَّا اخْتَارَ أَيْسَرَهُمَا مَا لَمْ يَكُنْ إِثْمًا  ، فَإِنْ كَانَ إِثْمًا كَانَ أَبْعَدَ النَّاسِ         [7/346]      عَنْهُ ، وَمَا  انْتَقَمَ  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِنَفْسِهِ إِلَّا أَنْ  تُنْتَهَكَ  حُرْمَةُ  اللهِ فَيَنْتَقِمَ لِلهِ بِهَا  .         [7/347]","","Musnad Abi Ya'la al-Mawsili 4382","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن مالك بن أنس عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4383","27 - (  4383  ) -  حَدَّثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ بْنِ مُصْعَبٍ الزُّبَيْرِيُّ ،  حَدَّثَنِي  ابْنُ الدَّرَاوَرْدِيِّ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ،  عَنْ  عَائِشَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَأَى صَبِيًّا قَدْ أَعْلَقُوا عَلَيْهِ ، فَقَالَ :  عَلَامَ تَقْتُلُونَ صِبْيَانَكُمْ ؟ عَلَيْكُمْ بِالْقُسْطِ الْهِنْدِيِّ بِمَاءٍ ، ثُمَّ يُسْعَطُهُ  .","","Musnad Abi Ya'la al-Mawsili 4383","","عائشة بنت أبي بكر الصديق عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن موسى بن عقبة عن عبد العزيز بن محمد الدراوردي عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4384","28 - (  4384  ) -  حَدَّثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ ،  حَدَّثَنِي  هِشَامُ بْنُ عَبْدِ اللهِ بْنِ عِكْرِمَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اطْلُبُوا الرِّزْقَ فِي خَبَايَا الْأَرْضِ  .         [7/348]","","Musnad Abi Ya'la al-Mawsili 4384","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن هشام بن عبد الله بن عكرمة بن خالد عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4385","29 - (  4385  ) -  حَدَّثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ ،  حَدَّثَنِي  ابْنُ الدَّرَاوَرْدِيِّ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كُلُوا وَاشْرَبُوا حَتَّى يُؤَذِّنَ  بِلَالٌ  .         [7/349]","","Musnad Abi Ya'la al-Mawsili 4385","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد العزيز بن محمد الدراوردي عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4386","30 - (  4386  ) -  حَدَّثَنَا  مُصْعَبٌ ،  حَدَّثَنِي  بِشْرُ بْنُ السَّرِيِّ ،  عَنْ  مُصْعَبِ بْنِ ثَابِتٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ اللهَ يُحِبُّ إِذَا عَمِلَ أَحَدُكُمْ عَمَلًا أَنْ يُتْقِنَهُ  .         [7/350]","","Musnad Abi Ya'la al-Mawsili 4386","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن مصعب بن ثابت بن عبد الله بن الزبير بن العوام عن بشر بن السري عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4387","31 - (  4387  ) -  حَدَّثَنَا  مُصْعَبٌ ، قَالَ :  حَدَّثَنِي  بِشْرُ بْنُ السَّرِيِّ ،  عَنْ  مُصْعَبِ بْنِ ثَابِتٍ ،  عَنْ  هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ارْهَقُوا  الْقِبْلَةَ  .","","Musnad Abi Ya'la al-Mawsili 4387","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن مصعب بن ثابت بن عبد الله بن الزبير بن العوام عن بشر بن السري عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4388","32 - (  4388  ) -  حَدَّثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَحْيَى بْنِ عَبَّادٍ ،         [7/351]      عَنْ  عَائِشَةَ ، قَالَتْ :  تَهَجَّدَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي بَيْتِهِ ، وَتَهَجَّدَ  عَبَّادُ بْنُ بِشْرٍ  فِي الْمَسْجِدِ ، فَسَمِعَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَوْتَهُ ، فَقَالَ :  يَا  عَائِشَةُ  ، هَذَا  عَبَّادُ بْنُ بِشْرٍ  ؟ فَقُلْتُ : نَعَمْ ، فَقَالَ : اللَّهُمَّ ارْحَمْ  عَبَّادًا  .","","Musnad Abi Ya'la al-Mawsili 4388","","عائشة بنت أبي بكر الصديق عن يحيى بن عباد بن عبد الله بن الزبير بن العوام عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4389","33 - (  4389  ) -  حَدَّثَنَا  مُصْعَبٌ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَحْيَى بْنِ عَبَّادٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  ثَلَاثَةٌ مِنَ  الْأَنْصَارِ  كُلُّهُمْ مِنْ  بَنِي عَبْدِ الْأَشْهَلِ  لَمْ يَكُنْ أَحَدٌ يَعْتَدُّ عَلَيْهِمْ فَضْلًا بَعْدَ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  سَعْدُ بْنُ مُعَاذٍ  ،  وَأُسَيْدُ بْنُ حُضَيْرٍ  ،  وَعَبَّادُ بْنُ بِشْرٍ  .         [7/352]","","Musnad Abi Ya'la al-Mawsili 4389","","عائشة بنت أبي بكر الصديق عن عباد بن عبد الله بن الزبير بن العوام عن يحيى بن عباد بن عبد الله بن الزبير بن العوام عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4390","34 - (  4390  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ، قَالَ :  وَأَخْبَرَنِي  عَمْرٌو ،  عَنْ  سَعِيدِ بْنِ أَبِي هِلَالٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ ،  أَنَّ  أَبَا مُسْلِمٍ الْخَوْلَانِيَّ حَجَّ ، فَدَخَلَ عَلَى عَائِشَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَعَلَتْ تَسْأَلُهُ عَنِ  الشَّامِ  ، وَعَنْ بَرْدِهَا ، فَجَعَلَ يُخْبِرُهَا ، فَقَالَتْ : كَيْفَ يَصْبِرُونَ عَلَى بَرْدِهَا ؟ فَقَالَ : يَا أُمَّ الْمُؤْمِنِينَ ، إِنَّهُمْ يَشْرَبُونَ شَرَابًا يُقَالُ لَهُ :  الطِّلَاءُ  ، فَقَالَتْ : صَدَقَ اللهُ وَبَلَّغَ حِبِّي ، سَمِعْتُ حِبِّي ، يَقُولُ :  إِنَّ نَاسًا مِنْ أُمَّتِي يَشْرَبُونَ الْخَمْرَ ، يُسَمُّونَهَا بِغَيْرِ اسْمِهَا  .  قَالَتْ : وَكَيْفَ يَصْنَعُ النِّسَاءُ ؟ قَالَ : يَدْخُلْنَ الْحَمَّامَاتِ ، قَالَتْ : صَدَقَ اللهُ وَبَلَّغَ حِبِّي ، سَمِعْتُ حِبِّي ، يَقُولُ : مَا مِنِ امْرَأَةٍ تَضَعُ ثَوْبَهَا فِي غَيْرِ بَيْتِهَا إِلَّا لَمْ يَحْبُهَا مِنَ اللهِ سِتْرٌ  .         [7/353]","","Musnad Abi Ya'la al-Mawsili 4390","","عائشة بنت أبي بكر الصديق عن عبد الله بن ثوب الخولاني عن محمد بن عبد الله بن مسلم عن سعيد بن أبي هلال الليثي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4391","35 - (  4391  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  ضَمْرَةُ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  طَيَّبْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِإِحْرَامِهِ  ، وَطَيَّبْتُهُ لِإِحْلَالِهِ طِيبًا لَا يُشْبِهُ طِيبَكُمْ هَذَا  ،  يَعْنِي : لَيْسَ لَهُ بَقَاءٌ  .         [7/354]","","Musnad Abi Ya'la al-Mawsili 4391","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن أبو عمرو الأوزاعي عن ضمرة بن ربيعة الفلسطيني عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4392","36 - (  4392  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ سَهْمٍ ،         [7/355]      حَدَّثَنَا  أَبُو إِسْحَاقَ الْفَزَارِيُّ ،  عَنْ  أَبِي سَعْدٍ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي الْبَخْتَرِيِّ الطَّائِيِّ ،         [7/356]      عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ذِمَّةُ  الْمُسْلِمِينَ وَاحِدَةٌ  ، فَإِنْ أَجَارَتْ عَلَيْهِمْ جَارِيَةٌ فَلَا تَخْفِرُوهَا ، فَإِنَّ لِكُلِّ غَادِرٍ  لِوَاءً  يُعْرَبُ  بِهِ يَوْمَ الْقِيَامَةِ  .         [7/357]","","Musnad Abi Ya'la al-Mawsili 4392","","عائشة بنت أبي بكر الصديق عن سعيد بن فيروز الطائي عن عمرو بن مرة المرادي عن سعيد بن المرزبان عن أبو إسحاق الفزاري عن محمد بن عبد الرحمن بن حكيم الأنطاكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4393","37 - (  4393  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  أَخْبَرَنَا  يُونُسُ بْنُ يَزِيدَ ،  عَنِ  الزُّهْرِيِّ ،  أَخْبَرَنِي  عُرْوَةُ بْنُ الزُّبَيْرِ ،  قَالَ  :  جَلَسَ  رَجُلٌ  بِفِنَاءِ حُجْرَةِ عَائِشَةَ ، فَجَعَلَ يَتَحَدَّثُ ، قَالَ : فَقَالَتْ  عَائِشَةُ  : لَوْلَا أَنِّي كُنْتُ أُسَبِّحُ لَقُلْتُ لَهُ :  مَا كَانَ رَسُولُ اللهِ  يَسْرُدُ  الْحَدِيثَ  كَسَرْدِكُمْ  ، إِنَّمَا كَانَ حَدِيثُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَصْلًا ، تَفْهَمُهُ الْقُلُوبُ  .","","Musnad Abi Ya'la al-Mawsili 4393","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن المبارك عن محمد بن عبد الرحمن بن حكيم الأنطاكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4394","38 - (  4394  ) -  حَدَّثَنَا  دَاوُدُ بْنُ عَمْرٍو الضَّبِّيُّ ،  حَدَّثَنَا         [7/358]      حَسَّانُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  إِنْ كُنْتُ لَأَفْتِلُ قَلَائِدَ بُدْنِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، ثُمَّ يَبْعَثُ بِالْهَدْيِ  وَهُوَ مُقِيمٌ عِنْدَنَا لَا يَجْتَنِبُ شَيْئًا مِمَّا يَجْتَنِبُ الْمُحْرِمُ .  بَلَغَنَا أَنَّ  زِيَادًا  بَعَثَ بِهَدْيٍ ، وَتَجَرَّدَ ، فَقَالَتْ : وَهَلْ كَانَتْ لَهُ كَعْبَةٌ يَطُوفُ بِهَا حِينَ لَبِسَ الثِّيَابَ ؟ فَإِنَّا لَا نَعْلَمُ أَحَدًا تَحْرُمُ عَلَيْهِ الثِّيَابُ ثُمَّ تَحِلُّ لَهُ حَتَّى يَطُوفَ  بِالْكَعْبَةِ  .         [7/359]             [7/360]","","Musnad Abi Ya'la al-Mawsili 4394","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حسان بن إبراهيم الكرماني عن داود بن عمرو المسيبي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4395","39 - (  4395  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  ابْنُ أَبِي زَائِدَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُصْعَبِ بْنِ شَيْبَةَ ،  عَنْ  مُسَافِعِ بْنِ عَبْدِ اللهِ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ ،  أَنَّ  امْرَأَةً  قَالَتْ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : هَلْ تَغْتَسِلُ الْمَرْأَةُ إِذَا احْتَلَمَتْ وَأَبْصَرَتِ الْمَاءَ ؟ قَالَ : نَعَمْ ، فَقَالَتْ لَهَا  عَائِشَةُ  :  تَرِبَتْ  يَدَاكِ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  دَعِيهَا ، وَهَلْ يَكُونُ الشَّبَهُ إِلَّا مِنْ قِبَلِ         [7/361]      ذَلِكَ  ؟ إِذَا عَلَا مَاؤُهَا مَاءَ الرَّجُلِ أَشْبَهَ الرَّجُلُ أَخْوَالَهُ ، وَإِذَا عَلَا مَاءُ الرَّجُلِ مَاءَ الْمَرْأَةِ أَشْبَهَهُ  .","","Musnad Abi Ya'la al-Mawsili 4395","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن مسافع بن عبد الله الأكبر الحجبي عن مصعب بن شيبة بن جبير الحجبي عن زكريا بن أبي زائدة الوادعي عن يحيى بن زكريا بن أبي زائدة عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4396","40 - (  4396  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي سَمِينَةَ الْبَصْرِيُّ ،  حَدَّثَنَا  عَبْدُ الْوَهَّابِ ،  حَدَّثَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كُنَّا نَنْبِذُ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي سِقَاءٍ يُوكَى         [7/362]      أَعْلَاهُ  ، وَلَهُ  عَزْلَاءُ ،  نَنْبِذُهُ بِالْغَدَاةِ فَيَشْرَبُهُ بِالْعَشِيِّ ، وَنَنْبِذُهُ بِالْعَشِيِّ فَيَشْرَبُهُ بِالْغَدَاةِ  .","","Musnad Abi Ya'la al-Mawsili 4396","","عائشة بنت أبي بكر الصديق عن خيرة مولاة أم سلمة عن الحسن البصري عن يونس بن عبيد عن عبد الوهاب بن عبد المجيد الثقفي عن محمد بن إسماعيل بن أبي سمينة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4397","41 - (  4397  ) -  حَدَّثَنَا  مَسْرُوقُ بْنُ الْمَرْزُبَانِ ،  حَدَّثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  يُونُسَ بْنِ يَزِيدَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا أَرَادَ أَنْ يُسَافِرَ         [7/363]      أَقْرَعَ بَيْنَ نِسَائِهِ  ، فَأَيَّتُهُنَّ خَرَجَ سَهْمُهَا أَخْرَجَهَا  .","","Musnad Abi Ya'la al-Mawsili 4397","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن المبارك عن مسروق بن المرزبان الكندي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4398","42 - (  4398  ) -  حَدَّثَنَا  أَبُو طَالِبٍ عَبْدُ الْجَبَّارِ بْنُ عَاصِمٍ ،         [7/364]      حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَائِشَةَ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا يَمُوتُ أَحَدٌ مِنَ الْمُسْلِمِينَ فَيُصَلِّي عَلَيْهِ أُمَّةٌ مِنَ الْمُسْلِمِينَ يَبْلُغُونَ أَنْ يَكُونُوا مِائَةً فَيَشْفَعُوا لَهُ إِلَّا شُفِّعُوا فِيهِ  .         [7/365]","","Musnad Abi Ya'la al-Mawsili 4398","","عائشة بنت أبي بكر الصديق عن عبد الله بن يزيد رضيع عائشة عن أبو قلابة الجرمي عن أيوب السختياني عن عبيد الله بن عمرو بن أبي الوليد عن عبد الجبار بن عاصم الخراساني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4399","43 - (  4399  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَرُزِّيُّ ،  حَدَّثَنَا  أَبُو زُكَيْرٍ الْمَدَنِيُّ ، قَالَ :  سَمِعْتُ  هِشَامَ بْنَ عُرْوَةَ  يَذْكُرُ ، عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كُلُوا  الْبَلَحَ  بِالتَّمْرِ  ، فَإِنَّ الشَّيْطَانَ إِذَا أَكَلَ ابْنُ آدَمَ غَضِبَ ، يَقُولُ : بَقِيَ ابْنُ آدَمَ حَتَّى أَكَلَ الْخَلَقَ بِالْجَدِيدِ  .         [7/366]","","Musnad Abi Ya'la al-Mawsili 4399","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن يحيى بن محمد بن قيس المحاربي عن محمد بن عبد الله الأرزي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4400","44 - (  4400  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  رُفِعَ الْقَلَمُ عَنْ ثَلَاثَةٍ  : عَنِ النَّائِمِ حَتَّى يَسْتَيْقِظَ ، وَعَنِ الْغُلَامِ حَتَّى يَحْتَلِمَ ، وَعَنِ الْمَجْنُونِ حَتَّى يُفِيقَ  .         [7/367]","","Musnad Abi Ya'la al-Mawsili 4400","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن حماد بن أبي سليمان عن حماد بن سلمة عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4401","45 - (  4401  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  تُبَالَةَ بِنْتِ يَزِيدَ الْعَبْشَمِيَّةِ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ يُنْبَذُ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي سِقَاءٍ ، فَنَأْخُذُ قَبْضَةً مِنْ زَبِيبٍ أَوْ قَبْضَةً مِنْ تَمْرٍ فَنَطْرَحُهَا فِي السِّقَاءِ  ، ثُمَّ نَصُبُّ عَلَيْهَا الْمَاءَ لَيْلًا فَيَشْرَبُهُ نَهَارًا ، أَوْ نَهَارًا فَيَشْرَبُهُ لَيْلًا  .","","Musnad Abi Ya'la al-Mawsili 4401","","عائشة بنت أبي بكر الصديق عن بنانة بنت يزيد العبشمية عن عاصم بن سليمان الأحول عن أبو معاوية الضرير عن سريج بن يونس المروزي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4402","46 - (  4402  ) -  حَدَّثَنَا  سُرَيْجٌ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كُفِّنَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي ثَلَاثَةِ أَثْوَابٍ بِيضٍ  ،  سَحُولِيَّةٍ  مِنْ  كُرْسُفٍ  ، لَيْسَ فِيهَا قَمِيصٌ وَلَا عِمَامَةٌ ، أَمَّا  الْحُلَّةُ  فَإِنَّمَا شُبِّهَ عَلَى النَّاسِ فِيهَا أَنَّهَا اشْتُرِيَتْ لَهُ لِيُكَفَّنَ فِيهَا ، فَتُرِكَتِ         [7/368]      الْحُلَّةُ  ، فَأَخَذَهَا  عَبْدُ اللهِ بْنُ أَبِي بَكْرٍ  ، قَالَ : أَحْبِسُهَا أُكَفَّنُ فِيهَا ، ثُمَّ قَالَ : لَوْ رَضِيَهَا اللهُ لِرَسُولِهِ لَكُفِّنَ فِيهَا ، فَبَاعَهَا وَتَصَدَّقَ بِثَمَنِهَا  .         [7/369]","","Musnad Abi Ya'la al-Mawsili 4402","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أبو معاوية الضرير عن سريج بن يونس المروزي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4403","47 - (  4403  ) -  حَدَّثَنَا  سُرَيْجٌ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  قَدِمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ سَفَرٍ ، قَالَتْ : فَعَلَّقْتُ عَلَى بَابِي  قِرَامَ  سِتْرٍ فِيهِ الْخَيْلُ أُولَاتُ الْأَجْنِحَةِ ، فَلَمَّا رَآهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ لِي :  تَنْزِعِيهِ  .         [7/370]","","Musnad Abi Ya'la al-Mawsili 4403","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أبو معاوية الضرير عن سريج بن يونس المروزي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4404","48 - (  4404  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ ضِجَاعُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الَّذِي يَنَامُ         [7/371]      عَلَيْهِ بِاللَّيْلِ مِنْ أَدَمٍ مَحْشُوًّا لِيفًا  .","","Musnad Abi Ya'la al-Mawsili 4404","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن هشيم بن بشير عن سريج بن يونس المروزي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4405","49 - (  4405  ) -  حَدَّثَنَا  الْحَكَمُ بْنُ مُوسَى ،  حَدَّثَنَا  هِقْلٌ ،  عَنِ  الْأَوْزَاعِيِّ ، قَالَ :  حَدَّثَنِي  الزُّهْرِيُّ ،  حَدَّثَنِي  عُرْوَةُ بْنُ الزُّبَيْرِ ،  عَنْ  عَمْرَةَ بِنْتِ عَبْدِ الرَّحْمَنِ بْنِ سَعْدِ بْنِ زُرَارَةَ ،  عَنْ  عَائِشَةَ ، قَالَتِ :  اسْتُحِيضَتْ  أُمُّ حَبِيبَةَ بِنْتُ جَحْشٍ  ، وَكَانَتْ تَحْتَ  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  سَبْعَ سِنِينَ ، فَاشْتَكَتْ ذَلِكَ إِلَى رَسُولِ اللهِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ هَذَا لَيْسَ         [7/372]      بِالْحَيْضَةِ ، إِنَّمَا هُوَ  عِرْقٌ  ، فَإِذَا أَقْبَلَتِ الْحَيْضَةُ فَدَعِي الصَّلَاةَ ، فَإِذَا أَدْبَرَتْ فَاغْتَسِلِي ثُمَّ صَلِّي .  قَالَتْ  عَائِشَةُ  : فَكَانَتْ تَغْتَسِلُ عِنْدَ كُلِّ صَلَاةٍ ، وَكَانَتْ تَقْعُدُ فِي  مِرْكَنٍ  لِأُخْتِهَا  زَيْنَبَ بِنْتِ جَحْشٍ  حَتَّى إِنَّ حُمْرَةَ الدَّمِ لَتَعْلُو الْمَاءَ  .         [7/373]             [7/374]","","Musnad Abi Ya'la al-Mawsili 4405","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن عروة بن الزبير عن الزهري عن أبو عمرو الأوزاعي عن هقل بن زياد السكسكي عن الحكم بن موسى بن أبي زهير النسائي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4406","50 - (  4406  ) -  حَدَّثَنَا  غَسَّانُ بْنُ الرَّبِيعِ ،  عَنْ  ثَابِتٍ يَعْنِي ابْنَ يَزِيدَ ،  عَنْ  بُرْدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتِ :  اسْتَفْتَحْتُ الْبَابَ ، وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي تَطَوُّعًا ، وَالْبَابُ فِي الْقِبْلَةِ  ، فَمَشَى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَنْ يَمِينِهِ ، أَوْ عَنْ يَسَارِهِ  ، حَتَّى فَتَحَ الْبَابَ ، ثُمَّ رَجَعَ إِلَى صَلَاتِهِ  .","","Musnad Abi Ya'la al-Mawsili 4406","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن برد بن سنان عن ثابت بن يزيد الأحول العطار عن غسان بن الربيع الأزدي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4407","51 - (  4407  ) -  حَدَّثَنَا  هُدْبَةُ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  سُلَيْمَانَ الْأَعْمَشِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  عُرْوَةَ ،         [7/375]      عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَتَوَضَّأُ ، ثُمَّ يُقَبِّلُ ، ثُمَّ يُصَلِّي ، وَلَا يُحْدِثُ وُضُوءًا  .         [7/376]             [7/377]             [7/378]             [7/379]","","Musnad Abi Ya'la al-Mawsili 4407","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن حبيب بن أبي ثابت الكاهلي عن الأعمش عن أبو بكر بن عياش عن هدبة بن خالد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4408","52 - (  4408  ) -  حَدَّثَنَا  حَوْثَرَةُ بْنُ أَشْرَسَ أَبُو عَامِرٍ ،  أَخْبَرَنِي  جَعْفَرُ بْنُ كَيْسَانَ أَبُو مَعْرُوفٍ ،  عَنْ  عَمْرَةَ الْعَدَوِيَّةِ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تَفْنَى أُمَّتِي إِلَّا  بِالطَّعْنِ  وَالطَّاعُونِ  ، قُلْنَا : يَا رَسُولَ اللهِ ، قَدْ عَرَفْنَا الطَّعْنَ ، فَمَا الطَّاعُونُ ؟ قَالَ :  غُدَّةٌ  كَغُدَّةِ  الْإِبِلِ ، الْمُقِيمُ بِهَا كَالشَّهِيدِ ، وَالْفَارُّ         [7/380]      مِنْهَا كَالْفَارِّ مِنَ  الزَّحْفِ  .","","Musnad Abi Ya'la al-Mawsili 4408","","عائشة بنت أبي بكر الصديق عن عمرة بنت قيس العدوية عن جعفر بن كيسان العدوي عن حوثرة بن أشرس بن عومر العدوي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4409","53 - (  4409  ) -  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي سَلَمَةَ بْنِ عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ بْنِ الْخَطَّابِ ، قَالَ :  حَدَّثَنِي  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا مُسْتَقِرَّةٌ بِقِرَامِ صُوَرٍ ، فَتَلَوَّنَ وَجْهُهُ ، ثُمَّ تَنَاوَلَ السِّتْرَ فَهَتَكَهُ ، ثُمَّ قَالَ :  إِنَّ مِنْ أَشَدِّ النَّاسِ عَذَابًا يَوْمَ الْقِيَامَةِ الَّذِينَ يُشَبِّهُونَ بِخَلْقِ اللهِ  .         [7/381]","","Musnad Abi Ya'la al-Mawsili 4409","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن عبد العزيز بن أبي سلمة الماجشون عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4410","54 - (  4410  ) -  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي سَلَمَةَ الْعُمَرِيُّ ،  حَدَّثَنِي  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  جَاءَتْ  أُمُّ حَبِيبَةَ بِنْتُ جَحْشٍ  ، وَكَانَتِ  اسْتُحِيضَتْ  سَبْعَ سِنِينَ ، إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَشَكَتْ ذَلِكَ إِلَيْهِ ، وَاسْتَفْتَتْهُ فِيهِ ، فَقَالَ :  إِنَّ هَذَا لَيْسَ بِالْحَيْضَةِ ، وَلَكِنْ هَذَا  عِرْقٌ  ، فَاغْتَسِلِي ، ثُمَّ صَلِّي  . قَالَ : فَكَانَتْ تَغْتَسِلُ لِكُلِّ صَلَاةٍ ، وَكَانَتْ تَجْلِسُ فِي الْمِرْكَنِ فَتَعْلُو حُمْرَةُ الدَّمِ الْمَاءَ ، ثُمَّ تُصَلِّي  .","","Musnad Abi Ya'la al-Mawsili 4410","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن عبد العزيز بن أبي سلمة الماجشون عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4411","55 - (  4411  ) -  حَدَّثَنَا  عَبْدُ الْعَزِيزِ الْعُمَرِيُّ ،  حَدَّثَنِي  إِبْرَاهِيمُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تُقْطَعُ الْيَدُ فِي رُبُعِ دِينَارٍ فَصَاعِدًا  .         [7/382]             [7/383]             [7/384]","","Musnad Abi Ya'la al-Mawsili 4411","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن عبد العزيز بن أبي سلمة الماجشون عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4412","56 - (  4412  ) -  حَدَّثَنَا  عَبْدُ الْعَزِيزِ ،  حَدَّثَنِي  إِبْرَاهِيمُ ،  عَنِ  الزُّهْرِيِّ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَغْتَسِلُ مِنْ إِنَاءٍ هُوَ  الْفَرَقُ  ، قَالَتْ : وَكُنْتُ أَغْتَسِلُ مَعَهُ فِي الْإِنَاءِ الْوَاحِدِ  .  قَالَ  إِبْرَاهِيمُ  : قَالَ  الزُّهْرِيُّ  :  وَأَظُنُّ  الْفَرَقَ  يَوْمَئِذٍ نَحْوًا مِنْ خَمْسَةِ أَقْسَاطٍ  .         [7/385]             [7/386]","","Musnad Abi Ya'la al-Mawsili 4412","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن عبد العزيز بن أبي سلمة الماجشون عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4413","57 - (  4413  ) -  حَدَّثَنَا  عَبْدُ الْعَزِيزِ ،  حَدَّثَنِي  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَحْيَى بْنِ عَبَّادٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كُنْتُ أَصْدَعُ فَرْقَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ قَرْنِ  يَافُوخِهِ  ، وَأَسْدُلُ لَهُ إِذَا دَهَنْتُ نَاصِيَتَهُ  .","","Musnad Abi Ya'la al-Mawsili 4413","","عائشة بنت أبي بكر الصديق عن عباد بن عبد الله بن الزبير بن العوام عن يحيى بن عباد بن عبد الله بن الزبير بن العوام عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن عبد العزيز بن أبي سلمة الماجشون عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4414","58 - (  4414  ) -  حَدَّثَنَا  عَبْدُ الْعَزِيزِ الْعُمَرِيُّ ،  حَدَّثَنِي  إِبْرَاهِيمُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  صَلَّى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي  خَمِيصَةٍ  لَهَا أَعْلَامٌ ، فَنَظَرَ إِلَى أَعْلَامِهَا نَظْرَةً ، فَلَمَّا سَلَّمَ ، قَالَ :  اذْهَبُوا  بِخَمِيصَتِي  هَذِهِ إِلَى  أَبِي جَهْمٍ  ، فَإِنَّهَا أَلْهَتْنِي آنِفًا عَنْ صَلَاتِي ،         [7/387]      وَائْتُونِي  بِأَنْبِجَانِيِّ  أَبِي جَهْمٍ  .         [7/388]             [7/389]","","Musnad Abi Ya'la al-Mawsili 4414","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن عبد العزيز بن أبي سلمة الماجشون عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4415","59 - (  4415  ) -  حَدَّثَنَا  عَبْدُ الْعَزِيزِ الْعُمَرِيُّ ،  حَدَّثَنِي  إِبْرَاهِيمُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  قَدْ كَانَ نِسَاءٌ مِنْ نِسَاءِ الْمُؤْمِنَاتِ يُصَلِّينَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  مُتَلَفِّعَاتٍ  بِمُرُوطِهِنَّ  ، ثُمَّ يَرْجِعْنَ إِلَى بُيُوتِهِنَّ ، وَمَا يُعْرَفْنَ مِنَ  الْغَلَسِ  .         [7/390]","","Musnad Abi Ya'la al-Mawsili 4415","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن عبد العزيز بن أبي سلمة الماجشون عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4416","60 - (  4416  ) -  حَدَّثَنَا  إِسْحَاقُ ، وَعِدَّةٌ ، قَالُوا :  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ،  أَنَّ نِسَاءً مِنَ الْمُؤْمِنَاتِ كُنَّ يُصَلِّينَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الصُّبْحَ  مُتَلَفِّعَاتٍ  بِمُرُوطِهِنَّ  ، ثُمَّ يَرْجِعْنَ إِلَى أَهْلِيهِنَّ ، وَلَا يَعْرِفُهُنَّ أَحَدٌ  .","","Musnad Abi Ya'la al-Mawsili 4416","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن سفيان بن عيينة عن عدة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4417","61 - (  4417  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى الْمِصْرِيُّ ،  حَدَّثَنَا         [7/391]      عَبْدُ اللهِ بْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي جَعْفَرٍ ،  عَنْ  مُحَمَّدِ بْنِ جَعْفَرِ بْنِ الزُّبَيْرِ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ مَاتَ وَعَلَيْهِ صِيَامٌ صَامَ عَنْهُ وَلِيُّهُ  .","","Musnad Abi Ya'la al-Mawsili 4417","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن محمد بن جعفر بن الزبير بن العوام عن عبيد الله بن أبي جعفر الكناني عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4418","62 - (  4418  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،         [7/392]      عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا نَفَعَنَا مَالُ أَحَدٍ مَا نَفَعَنَا مَالُ  أَبِي بَكْرٍ  .","","Musnad Abi Ya'la al-Mawsili 4418","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4419","63 - (  4419  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتِ :  اخْتَصَمَ  سَعْدٌ  ،  وَعَبْدُ بْنُ زَمْعَةَ  عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ  سَعْدٌ  : إِنَّ أَخِي أَوْصَانِي إِذَا قَدِمْتُ  مَكَّةَ  أَنْ آخُذَ ابْنَ أَمَةِ  زَمْعَةَ  ، وَإِنَّهُ ابْنِي ، فَقَالَ  عَبْدُ بْنُ زَمْعَةَ  : يَا رَسُولَ اللهِ ، أَخِي وَابْنُ أَمَةِ أَبِي ، وُلِدَ عَلَى فِرَاشِ أَبِي ، فَرَأَى شَبَهًا بَيِّنًا  بِعُتْبَةَ  ، قَالَ : فَقَالَ :  هُوَ لَكَ ، الْوَلَدُ  لِلْفِرَاشِ  ، وَاحْتَجِبِي مِنْهُ يَا  سَوْدَةُ  .         [7/393]","","Musnad Abi Ya'la al-Mawsili 4419","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4420","64 - (  4420  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي صَلَاةَ الْعَصْرِ         [7/394]      وَالشَّمْسُ طَالِعَةٌ فِي حُجْرَتِهَا لَمْ يَظْهَرِ الْفَيْءُ  .","","Musnad Abi Ya'la al-Mawsili 4420","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4421","65 - (  4421  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتِ :  اسْتَأْذَنَ رَهْطٌ مِنَ الْيَهُودِ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالُوا :  السَّامُ  عَلَيْكَ ، قَالَتْ  عَائِشَةُ  : فَقُلْتُ : عَلَيْكُمُ         [7/395]      السَّامُ  وَاللَّعْنَةُ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا  عَائِشَةُ  ، إِنَّ اللهَ يُحِبُّ  الرِّفْقَ  فِي الْأَمْرِ كُلِّهِ  ، قَالَتْ : قُلْتُ : أَلَمْ تَسْمَعْ مَا قَالُوا ؟ قَالَ : قُلْتُ : وَعَلَيْكُمْ  .","","Musnad Abi Ya'la al-Mawsili 4421","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4422","66 - (  4422  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،         [7/396]      عَنْ  عَائِشَةَ ، قَالَتْ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ يَوْمٍ مَسْرُورًا ، يَقُولُ :  أَيْ  عَائِشَةُ  أَلَمْ تَرَيْ إِلَى  مُجَزِّزٍ الْمُدْلِجِيِّ  ؟ دَخَلَ عَلَيَّ ، فَرَأَى  أُسَامَةَ  وَزَيْدًا  عَلَيْهِمَا قَطِيفَةٌ قَدْ غَطَّيَا رُءُوسَهُمَا وَبَدَتْ أَقْدَامُهُمَا ، فَقَالَ : إِنَّ هَذِهِ أَقْدَامٌ بَعْضُهَا مِنْ بَعْضٍ  .         [7/397]","","Musnad Abi Ya'la al-Mawsili 4422","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4423","67 - (  4423  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ :  جَاءَتِ  امْرَأَةُ رِفَاعَةَ الْقُرَظِيِّ  إِلَى رَسُولِ اللهِ ، فَقَالَتْ : إِنَّ  رِفَاعَةَ  طَلَّقَنِي فَبَتَّ طَلَاقِي ، فَتَزَوَّجْتُ بَعْدَهُ  عَبْدَ الرَّحْمَنِ بْنَ الزَّبِيرِ  ، وَإِنَّ مَا مَعَهُ مِثْلُ  هُدْبَةِ  الثَّوْبِ ، فَتَبَسَّمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  تُرِيدِينَ أَنْ تَرْجِعِي إِلَى  رِفَاعَةَ  ؟ لَا ، حَتَّى يَذُوقَ مِنْ  عُسَيْلَتِكِ  وَتَذُوقِي مِنْ  عُسَيْلَتِهِ  .         [7/398]","","Musnad Abi Ya'la al-Mawsili 4423","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4424","68 - (  4424  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا يَحِلُّ لِامْرَأَةٍ تُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ أَنْ  تُحِدَّ  عَلَى مَيِّتٍ فَوْقَ ثَلَاثٍ  ، إِلَّا عَلَى زَوْجٍ  .         [7/399]","","Musnad Abi Ya'la al-Mawsili 4424","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4425","69 - (  4425  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  دَخَلْتُ الْجَنَّةَ ، فَسَمِعْتُ فِيهَا قِرَاءَةً ، فَقُلْتُ : مَا هَذِهِ ؟ قَالُوا :  حَارِثَةُ بْنُ النُّعْمَانِ  ، كَذَاكُمُ  الْبِرُّ  ، كَذَاكُمُ  الْبِرُّ  ، كَذَاكُمُ  الْبِرُّ  ، وَكَانَ بَرًّا بِأُمِّهِ  .         [7/400]","","Musnad Abi Ya'la al-Mawsili 4425","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4426","70 - (  4426  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  ابْنِ عَجْلَانَ ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ ،  عَنْ  أَبِي سَلَمَةَ ،  قَالَ  :  تَوَضَّأَ  عَبْدُ الرَّحْمَنِ  عِنْدَ عَائِشَةَ ، فَقَالَتْ : يَا  عَبْدَ الرَّحْمَنِ  ، أَسْبِغِ الْوُضُوءَ ، إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  وَيْلٌ لِلْعَرَاقِيبِ مِنَ النَّارِ  .         [7/401]","","Musnad Abi Ya'la al-Mawsili 4426","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن سعيد المقبري عن محمد بن عجلان عن سفيان بن عيينة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4427","71 - (  4427  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ،  حَدَّثَنَا  مُسْلِمُ بْنُ خَالِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي يُونُسَ مَوْلَى عَائِشَةَ ،  أَنَّ  عَائِشَةَ ، قَالَتْ :  سَأَلَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  رَجُلٌ  ، وَأَنَا قَائِمَةٌ وَرَاءَ الْبَابِ أَسْمَعُ ، فَقَالَ : إِنَّ الصَّلَاةَ تُدْرِكُنِي وَأَنَا  جُنُبٌ  ، وَأَنَا أُرِيدُ الصِّيَامَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  وَأَنَا تُدْرِكُنِي الصَّلَاةُ وَأَنَا  جُنُبٌ  ، وَأَنَا أُرِيدُ الصِّيَامَ ، ثُمَّ أَغْتَسِلُ وَأَصُومُ  ، فَقَالَ الرَّجُلُ : لَسْتُ مِثْلَكَ قَدْ غَفَرَ اللهُ لَكَ مَا تَقَدَّمَ مِنْ ذَنْبِكَ وَمَا تَأَخَّرَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : وَإِنِّي لَأَرْجُو أَنْ أَكُونَ أَتْقَاكُمْ لِلهِ ، وَأَعْلَمَكُمْ بِحُدُودِ اللهِ  .         [7/402]","","Musnad Abi Ya'la al-Mawsili 4427","","عائشة بنت أبي بكر الصديق عن أبو يونس المدني مولى عائشة عن عبد الله بن عبد الرحمن بن معمر الأنصاري عن مسلم بن خالد الزنجي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4428","72 - (  4428  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  عُمَرُ بْنُ عَلِيٍّ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  إِنْ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَيُقَبِّلُ بَعْضَ أَزْوَاجِهِ وَهُوَ صَائِمٌ  ، ثُمَّ ضَحِكَتْ  .         [7/403]             [7/404]             [7/405]","","Musnad Abi Ya'la al-Mawsili 4428","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عمر بن علي بن عطاء عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4429","73 - (  4429  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  عُمَرُ بْنُ عَلِيٍّ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  إِنْ كُنْتُ لَأَغْتَسِلُ أَنَا وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ إِنَاءٍ وَاحِدٍ  ، نَشْرَعُ فِيهِ جَمِيعًا  .","","Musnad Abi Ya'la al-Mawsili 4429","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عمر بن علي بن عطاء عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4430","74 - (  4430  ) -  وَبِإِسْنَادِهِ  ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ         [7/406]      إِذَا أَرَادَ أَنْ يَغْتَسِلَ مِنَ الْجَنَابَةِ أَفْرَغَ عَلَى يَدَيْهِ فَغَسَلَهُمَا  ، ثُمَّ يَتَوَضَّأُ وُضُوءَهُ لِلصَّلَاةِ ، ثُمَّ وَضَعَ يَدَيْهِ فِي الْإِنَاءِ وَضْعًا ، ثُمَّ أَخْرَجَهُمَا فَأَدْخَلَهُمَا فِي رَأْسِهِ ، فَيَتَتَبَّعُ أُصُولَ الشَّعَرِ حَتَّى إِذَا بَلَّ بَشَرَةَ شَعَرِهِ وَخُيِّلَ إِلَيْهِ أَنَّهُ قَدْ أَنْقَى ، أَفْرَغَ عَلَى رَأْسِهِ ثَلَاثَ  حَثَيَاتٍ  مِنْ مَاءٍ ، ثُمَّ أَفْرَغَ مَا بَقِيَ عَلَى جَسَدِهِ  .         [7/407]      وَقَالَ عُرْوَةُ مِنْ قِبَلِهِ :  إِذَا غَسَلَ كَفَّيْهِ فَلْيَغْسِلْ فَرْجَهُ ، ثُمَّ يَتَوَضَّأُ وُضُوءَهُ لِلصَّلَاةِ  .","","Musnad Abi Ya'la al-Mawsili 4430","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عمر بن علي بن عطاء عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4431","75 - (  4431  ) -  وَعَنْ  عَائِشَةَ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا حَضَرَتِ الصَّلَاةُ وَوُضِعَ  الْعَشَاءُ  ، فَابْدَءُوا بِالْعَشَاءِ  .","","Musnad Abi Ya'la al-Mawsili 4431","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عمر بن علي بن عطاء عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4432","76 - (  4432  ) -  حَدَّثَنَا  عَلِيُّ بْنُ الْجَعْدِ ، وَهُدْبَةُ ، قَالَا :  حَدَّثَنَا         [7/408]      سُلَيْمَانُ بْنُ الْمُغِيرَةِ ،  عَنْ  حُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  أَبِي بُرْدَةَ ،  قَالَ  :  دَخَلْنَا عَلَى عَائِشَةَ ، فَأَخْرَجَتْ إِلَيْنَا إِزَارًا غَلِيظًا مِمَّا يُصْنَعُ  بِالْيَمَنِ  ، وَكِسَاءً مِنْ هَذِهِ الَّتِي تَدْعُونَهَا  الْمُلَبَّدَةَ  ، فَقَالَتْ :  قُبِضَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي هَذَيْنِ الثَّوْبَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 4432","","عائشة بنت أبي بكر الصديق عن أبو بردة بن أبي موسى الأشعري عن حميد بن هلال العدوي عن سليمان بن المغيرة القيسي عن هدبة بن خالد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4433","77 - (  4433  ) -  حَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ الْجَهْضَمِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ الطُّفَاوِيُّ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَتْ  سَوْدَةُ  امْرَأَةً جَسِيمَةً ، إِذَا خَرَجَتْ أَشْرَفَتْ عَلَى النِّسَاءِ ، فَرَآهَا  عُمَرُ بْنُ الْخَطَّابِ  ، فَقَالَ لَهَا : انْظُرِي كَيْفَ تَخْرُجِينَ ، فَوَاللهِ مَا تَخْفَيْنَ عَلَيْنَا إِذَا خَرَجْتِ ، فَذَكَرَتْ ذَلِكَ  سَوْدَةُ  لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَفِي يَدِهِ عَرْقٌ ، قَالَ : فَمَادَ الْعَرْقُ مِنْ يَدِهِ         [7/409]      مِنْ فَزَعِ الْوَحْيِ ، فَقَالَ :  إِنَّ اللهَ قَدْ جَعَلَ لَكُنَّ رُخْصَةً أَنْ تَخْرُجْنَ لِحَوَائِجِكُنَّ  .         [7/410]","","Musnad Abi Ya'la al-Mawsili 4433","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن عبد الرحمن الطفاوي عن نصر بن علي بن نصر الجهضمي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4434","78 - (  4434  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  عَنْ  مَالِكٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ :  أَنَّ  رَجُلًا  ، قَالَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِنَّ أُمِّي  افْتُلِتَتْ  نَفْسُهَا ، وَأُرَاهَا لَوْ تَكَلَّمَتْ تَصَدَّقَتْ ، أَفَأَتَصَدَّقُ عَنْهَا ؟  فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : نَعَمْ  .         [7/411]","","Musnad Abi Ya'la al-Mawsili 4434","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن مالك بن أنس عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4435","79 - (  4435  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  عَنْ  مَالِكٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتْ :  جَاءَتْنِي  بَرِيرَةُ  ، فَقَالَتْ : إِنِّي كَاتَبْتُ أَهْلِي عَلَى تِسْعِ أَوَاقٍ : فِي كُلِّ عَامٍ أُوقِيَّةٌ ، فَأَعِينِينِي ، فَقَالَتْ لَهَا  عَائِشَةُ  : إِنْ أَحَبَّ أَهْلُكِ أَنْ أَعُدَّهَا لَهُمْ عَدَّةً وَاحِدَةً وَيَكُونَ وَلَاؤُكِ لِي فَعَلْتُ ، فَذَهَبَتْ  بَرِيرَةُ  إِلَى أَهْلِهَا ، فَقَالَتْ لَهُمْ ، فَأَبَوْا إِلَّا أَنْ يَكُونَ الْوَلَاءُ لَهُمْ ، فَسَمِعَ ذَلِكَ رَسُولُ اللهِ ، فَسَأَلَهَا ، فَأَخْبَرَتْهُ  عَائِشَةُ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : خُذِيهَا وَاشْتَرِطِي لَهُمُ الْوَلَاءَ ، فَإِنَّمَا الْوَلَاءُ لِمَنْ أَعْتَقَ .  قَالَتْ  عَائِشَةُ  : فَقَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي النَّاسِ ، فَحَمِدَ اللهَ ، ثُمَّ قَالَ :  أَمَّا بَعْدُ ، فَمَا بَالُ رِجَالٍ يَشْتَرِطُونَ شُرُوطًا لَيْسَتْ فِي  كِتَابِ  اللهِ ؟ فَمَا كَانَ لَيْسَ فِي  كِتَابِ  اللهِ فَهُوَ بَاطِلٌ ، وَإِنْ كَانَ مِائَةَ  شَرْطٍ  ، وَقَالَ : قَضَاءُ اللهِ أَحَقُّ ، وَشَرْطُ اللهِ أَوْثَقُ ، وَإِنَّمَا الْوَلَاءُ لِمَنْ أَعْتَقَ  .         [7/412]             [7/413]             [7/414]","","Musnad Abi Ya'la al-Mawsili 4435","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن مالك بن أنس عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4436","80 - (  4436  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ،  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  حَدَّثَنَا  أُسَامَةُ بْنُ زَيْدٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ :  أَنَّ  بَرِيرَةَ  كَانَتْ مُكَاتَبَةً لِأُنَاسٍ مِنَ  الْأَنْصَارِ  ، قَالَتْ : فَأَرَدْتُ أَنْ أَبْتَاعَهَا  فَأُعْتِقَهَا  ، فَأَمَرْتُهَا أَنْ تَأْتِيَهُمْ فَتُخْبِرَهُمْ ، فَقَالُوا : إِنْ جَعَلْتِ لَنَا وَلَاءَهَا بِعْنَاهَا ، فَاسْتَفْتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  اشْتَرِيهَا فَأَعْتِقِيهَا ، فَإِنَّمَا الْوَلَاءُ لِمَنْ أَعْطَى الثَّمَنَ  ، قَالَتْ : فَكَانَتْ تَحْتَ عَبْدٍ ، فَلَمَّا أُعْتِقَتُ ، قَالَ لَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : اخْتَارِي : إِنْ شِئْتِ تَسْتَقِرِّي تَحْتَ هَذَا الْعَبْدِ ، وَإِنْ شِئْتِ أَنْ تُفَارِقِيهِ ، قَالَتْ : فَإِنِّي قَدْ فَارَقْتُهُ ، قَالَتْ : فَدَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَالْمِرْجَلُ  يَفُورُ  بِاللَّحْمِ ، فَقَالَ : مَا هَذَا يَا  عَائِشَةُ  ؟ فَقَالَتْ : أَهْدَتْهُ لَنَا  بَرِيرَةُ  تُصُدِّقَ بِهِ عَلَيْهَا ، فَقَالَ : هُوَ  لِبَرِيرَةَ  صَدَقَةٌ ، وَهُوَ لَنَا هَدِيَّةٌ  .","","Musnad Abi Ya'la al-Mawsili 4436","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن أسامة بن زيد الليثي المدني عن عثمان بن عمر بن فارس عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4437","81 - (  4437  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  حَدَّثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  يَحْيَى بْنِ سَعِيدِ بْنِ الْعَاصِ ،  عَنْ  أَبِيهِ  ،         [7/415]      عَنْ  عَائِشَةَ ، قَالَتْ :  جَاءَ  أَبُو بَكْرٍ  يَسْتَأْذِنُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعَلَيْهِ مِرْطُ أُمِّ الْمُؤْمِنِينَ  ، فَأَذِنَ لَهُ ، فَقَضَى إِلَيْهِ حَاجَتَهُ ، ثُمَّ خَرَجَ ، فَاسْتَأْذَنَ عَلَيْهِ  عُمَرُ  ، فَأَذِنَ لَهُ ، وَهُوَ عَلَى تِلْكَ الْحَالَةِ ، فَقَضَى إِلَيْهِ حَاجَتَهُ ، ثُمَّ خَرَجَ ، فَاسْتَأْذَنَ  عُثْمَانُ  ، فَاسْتَوَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ  لِعَائِشَةَ  : اجْمَعِي عَلَيْكِ ثِيَابَكِ ، فَأَذِنَ لَهُ ، فَلَمَّا خَرَجَ ، قَالَتْ لَهُ  عَائِشَةُ  : مَا لَكَ لَمْ تَفْزَعْ  لِأَبِي بَكْرٍ  ،  وَعُمَرَ  كَمَا  فَزِعْتَ  لِعُثْمَانَ  ؟ فَقَالَ : إِنَّ  عُثْمَانَ  حَيِيٌّ ، وَلَوْ أَذِنْتُ لَهُ عَلَى ذَلِكَ الْحَالِ لَخَشِيتُ أَنْ لَا يَبْلُغَ فِي حَاجَتِهِ  .         [7/416]","","Musnad Abi Ya'la al-Mawsili 4437","","عائشة بنت أبي بكر الصديق عن عكة العسل ، سعيد بن العاص بن أبي أحيحة عن يحيى بن سعيد بن العاص القرشي عن الزهري عن محمد بن عبد الرحمن بن المغيرة عن عثمان بن عمر بن فارس عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4438","82 - (  4438  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  حَدَّثَنَا  عُثْمَانُ بْنُ مُرَّةَ ،  عَنِ  الْقَاسِمِ ، قَالَ :  قَالَتْ  عَائِشَةُ :  اشْتَرَيْتُ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نُمْرُقَةً ،  فَأَلْقَيْتُهَا لَهُ ، فَكَأَنَّهُ كَرِهَ ذَلِكَ ، فَقَالَتْ  عَائِشَةُ  : أَعُوذُ بِاللهِ مِنْ  سُخْطِ  اللهِ  وَسُخْطِ  رَسُولِهِ ، فَقَالَ : مَا هَذِهِ يَا  عَائِشَةُ  ؟ فَقَالَتْ : إِذَا دَخَلَ عَلَيْكَ دَاخِلٌ أَوْ جَاءَكَ وَفْدٌ ، فَقَالَ :  يَا  عَائِشَةُ  ، إِنَّ أَصْحَابَ هَذِهِ الصُّوَرِ يُعَذَّبُونَ عَذَابًا لَا يُعَذَّبُهُ أَحَدٌ مِنَ الْعَالَمِينَ  ، يُقَالُ لَهُمْ : أَحْيُوا مَا خَلَقْتُمْ  .","","Musnad Abi Ya'la al-Mawsili 4438","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عثمان بن مرة البصري عن عثمان بن عمر بن فارس عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4439","83 - (  4439  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  عُمَرُ بْنُ عَلِيٍّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ ، قَالَ :  سَمِعْتُ  الْقَاسِمَ  يُحَدِّثُ ، عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنِ اسْتُعْمِلَ عَلَى عَمَلٍ فَأَرَادَ اللهُ بِهِ خَيْرًا ، جَعَلَ اللهُ لَهُ وَزِيرَ صِدْقٍ  ، إِنْ نَسِيَ ذَكَّرَهُ ، وَإِنْ ذَكَرَ أَعَانَهُ  .         [7/417]","","Musnad Abi Ya'la al-Mawsili 4439","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن أبي بكر الجدعاني عن عمر بن علي بن عطاء عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4440","84 - (  4440  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  مُحَمَّدُ بْنُ بَحْرٍ ،  حَدَّثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  أَخَذَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِيَدِي وَأَشَارَ إِلَى الْقَمَرِ ، فَقَالَ :  يَا  عَائِشَةُ  ، تَعَوَّذِي بِاللهِ مِنْ شَرِّ هَذَا  الْغَاسِقِ  إِذَا  وَقَبَ  .         [7/418]","","Musnad Abi Ya'la al-Mawsili 4440","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن الحارث بن عبد الرحمن العامري عن محمد بن عبد الرحمن بن المغيرة عن محمد بن بحر الهجيمي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4441","85 - (  4441  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  شُعَيْبُ بْنُ حَرْبٍ ،  حَدَّثَنَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  حَدَّثَنَا  مُجَاهِدٌ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَحْشٌ ، فَكَانَ يُقْبِلُ وَيُدْبِرُ  ، فَإِذَا دَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَبَضَ فَلَمْ  يَتَرَمْرَمْ  كَرَاهِيَةَ أَنْ يُؤْذِيَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .         [7/419]","","Musnad Abi Ya'la al-Mawsili 4441","","عائشة بنت أبي بكر الصديق عن مجاهد بن جبر المخزومي عن يونس بن أبي إسحاق عن شعيب بن حرب الأبناوي عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4442","86 - (  4442  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  هَاشِمُ بْنُ الْقَاسِمِ ،  عَنْ  أَبِي عَقِيلٍ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  حَدَّثَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمًا حَدِيثًا ، فَقَالَتِ  امْرَأَةٌ  مِنْهُنَّ : يَا رَسُولَ اللهِ ، كَأَنَّ هَذَا الْحَدِيثَ حَدِيثُ  خُرَافَةَ  . قَالَ :  أَتَدْرِينَ مَا  خُرَافَةُ  ؟ إِنَّ  خُرَافَةَ  كَانَ رَجُلًا مِنْ  عُذْرَةَ  ، أَسَرَتْهُ الْجِنُّ فِي الْجَاهِلِيَّةِ  ، فَمَكَثَ فِيهِمْ دَهْرًا ، ثُمَّ رَدُّوهُ إِلَى الْإِنْسِ ، فَكَانَ يُحَدِّثُ النَّاسَ بِمَا رَأَى فِيهِمْ مِنَ الْأَعَاجِيبِ ، فَقَالَ         [7/420]      النَّاسُ : حَدِيثُ  خُرَافَةَ  .","","Musnad Abi Ya'la al-Mawsili 4442","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن الشعبي عن مجالد بن سعيد عن عبد الله بن عقيل مولى عثمان بن المغيرة عن هاشم بن القاسم بن مسلم عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4443","87 - (  4443  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  حَفْصٌ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  مَا رَأَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُسْرِعُ إِلَى شَيْءٍ مِنَ النَّوَافِلِ إِسْرَاعَهُ إِلَى رَكْعَتَيِ الْفَجْرِ  ، وَلَا إِلَى غَنِيمَةٍ  .         [7/421]","","Musnad Abi Ya'la al-Mawsili 4443","","عائشة بنت أبي بكر الصديق عن عبيد بن عمير بن قتادة الجندعي عن عطاء بن أبي رباح عن ابن جريج عن حفص بن غياث النخعي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4444","88 - (  4444  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  عَنِ  ابْنِ إِسْحَاقَ ،  عَنْ  ثَوْرٍ ،  عَنْ  مُحَمَّدِ بْنِ عُبَيْدِ بْنِ أَبِي صَالِحٍ ،  عَنْ  صَفِيَّةَ بِنْتِ شَيْبَةَ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا طَلَاقَ وَلَا عَتَاقَ فِي  إِغْلَاقٍ  .         [7/422]             [7/423]","","Musnad Abi Ya'la al-Mawsili 4444","","عائشة بنت أبي بكر الصديق عن صفية بنت شيبة الحجبية عن محمد بن عبيد بن أبي صالح المكي عن ثور بن يزيد الكلاعي عن محمد بن إسحاق عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4445","89 - (  4445  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  زَيْدُ بْنُ حُبَابٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْمُؤَمَّلِ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَبِي مُلَيْكَةَ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  نِعْمَ  الْإِدَامُ  الْخَلُّ  .","","Musnad Abi Ya'la al-Mawsili 4445","","عائشة بنت أبي بكر الصديق عن ابن أبي مليكة عن عبد الله بن المؤمل العائذي عن زيد بن الحباب العكلي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4446","90 - (  4446  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي مُزَرِّدٍ ،  عَنْ  يَزِيدَ بْنِ رُومَانَ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الرَّحِمُ مُعَلَّقَةٌ بِالْعَرْشِ  ، تَقُولُ : مَنْ وَصَلَنِي وَصَلَهُ اللهُ ، وَمَنْ قَطَعَنِي قَطَعَهُ اللهُ  .         [7/424]             [7/425]","","Musnad Abi Ya'la al-Mawsili 4446","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن يزيد بن رومان الأسدي عن معاوية بن أبي مزرد الهاشمي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4447","91 - (  4447  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  قَالُوا : يَا رَسُولَ اللهِ ، إِنَّ الْأَعْرَابَ يَأْتُونَنَا بِلَحْمٍ لَا نَدْرِي ذَكَرُوا اسْمَ اللهِ عَلَيْهِ أَمْ لَا ؟ قَالَ :  فَسَمُّوا أَنْتُمْ عَلَيْهِ ، وَكُلُوا  .         [7/426]","","Musnad Abi Ya'la al-Mawsili 4447","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الرحيم بن سليمان الأشل عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4448","92 - (  4448  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  يَزِيدُ بْنُ الْمِقْدَامِ ،  عَنِ  الْمِقْدَامِ بْنِ شُرَيْحٍ ،  عَنْ  أَبِيهِ  ، أَنَّهُ  سَأَلَ  عَائِشَةَ :  أَكَانَ رَسُولُ اللهِ يُصَلِّي عَلَى الْحَصِيرِ  ؟ فَإِنِّي سَمِعْتُ فِي كِتَابِ اللهِ         {      وَجَعَلْنَا جَهَنَّمَ لِلْكَافِرِينَ حَصِيرًا         }      ، قَالَتْ : لَمْ يَكُنْ يُصَلِّي عَلَيْهِ  .         [7/427]","","Musnad Abi Ya'la al-Mawsili 4448","","عائشة بنت أبي بكر الصديق عن شريح بن هانئ المذحجي عن المقدام بن شريح الحارثي عن يزيد بن المقدام بن شريح الحضرمي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4449","93 - (  4449  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  حُسَيْنُ بْنُ عَلِيٍّ ،  عَنْ  زَائِدَةَ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عِكْرِمَةَ ،  عَنْ  عَائِشَةَ : أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَمُرُّ بِالْقِدْرِ فَيَتَنَاوَلُ مِنْهَا الْعَرْقَ فَيُصِيبُ مِنْهُ ، ثُمَّ يُصَلِّي وَلَا يَتَوَضَّأُ  .         [7/428]","","Musnad Abi Ya'la al-Mawsili 4449","","عائشة بنت أبي بكر الصديق عن عكرمة مولى ابن عباس عن ابن أبي مليكة عن عبد العزيز بن رفيع الطائفي عن زائدة بن قدامة عن الحسين بن علي الجعفي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4450","94 - (  4450  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  سُكَيْنٌ ،  حَدَّثَنَا  حَوْشَبُ بْنُ عَقِيلٍ ،  عَنْ  غَنِيَّةَ بِنْتِ الرَّضِيِّ ،  قَالَتْ  :  دَخَلْتُ عَلَى أُمِّ الْمُؤْمِنِينَ عَائِشَةَ فِي نِسْوَةٍ مِنْ  عَبْدِ الْقَيْسِ  ، فَسَأَلْنَاهَا عَنِ النَّبِيذِ ، فَقَالَتْ : لَا نَفَعَكُنَّ اللهُ يَا  عَبْدَ         [7/429]      الْقَيْسِ  بِالنَّبِيذِ ،  نَهَى رَسُولُ اللهِ عَنِ الْحَنْتَمِ ،  وَالدُّبَّاءِ  ،  وَالنَّقِيرِ  ، قَالَتْ : وَلَكِنِ اشْرَبْنَ فِي الْأَدَمِ كُلِّهِ ، أَوْ مَا أَوْكَيْتُنَّ أَوْ عَلَّقْتُنَّ  .","","Musnad Abi Ya'la al-Mawsili 4450","","عائشة بنت أبي بكر الصديق عن غنية بنت رضى عن حوشب الجرمي عن سكين بن عبد العزيز بن قيس المجاشعي عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4451","95 - (  4451  ) -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  حَدَّثَنَا         [7/430]      وُهَيْبٌ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  دَخَلْتُ عَلَى  أَبِي بَكْرٍ  فَرَأَيْتُ بِهِ الْمَوْتَ ، فَقُلْتُ : هَيْجٌ هَيْجٌ .  مُقَنَّعًا  فَقَالَ لَهَا : لَا تَقُولِي ذَلِكَ ، وَلَكِنْ قُولِي :         {      وَجَاءَتْ سَكْرَةُ الْمَوْتِ بِالْحَقِّ ذَلِكَ مَا كُنْتَ مِنْهُ تَحِيدُ         }      ، ثُمَّ قَالَ :  فِي أَيِّ يَوْمٍ تُوُفِّيَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟  قَالَتْ : قُلْتُ : يَوْمَ الِاثْنَيْنِ  ، قَالَ : أَرْجُو فِيمَا بَيْنِي وَبَيْنَ اللَّيْلِ ، قَالَ : فَلَمْ يُتَوَفَّ حَتَّى أَمْسَى لَيْلَةَ الثُّلَاثَاءِ ، فَدُفِنَ قَبْلَ أَنْ يُصْبِحَ .  قَالَتْ : وَقَدْ قَالَ قَبْلَ ذَلِكَ : فِي كَمْ كُفِّنَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قُلْتُ : فِي ثَلَاثَةِ أَثْوَابٍ بِيضٍ  سَحُولِيَّةٍ  ، لَيْسَ فِيهَا قَمِيصٌ وَلَا عِمَامَةٌ ، فَنَظَرَ إِلَى ثَوْبٍ كَانَ يُمَرَّضُ فِيهِ ، فِيهِ  رَدْعٌ  مِنْ زَعْفَرَانَ ، أَوْ  مِشْقٌ  ، فَقَالَ : اغْسِلُوا ثَوْبِي هَذَا فَزِيدُوا عَلَيْهِ ثَوْبَيْنِ وَكَفِّنُونِي فِيهَا .         [7/431]      قَالَتْ : قُلْتُ : إِنَّ هَذَا خَلَقٌ ، قَالَ : الْحَيُّ أَحَقُّ بِالْجَدِيدِ مِنَ الْمَيِّتِ ، إِنَّمَا هُوَ لِلْمُهْلَةِ  .","","Musnad Abi Ya'la al-Mawsili 4451","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن وهيب بن خالد الكرابيسي عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4452","96 - (  4452  ) -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  حَدَّثَنَا         [7/432]      فُضَيْلُ بْنُ عِيَاضٍ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُحَمَّدِ بْنِ شِهَابٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  مَا رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مُنْتَصِرًا مِنْ ظُلَامَةٍ ظُلِمَهَا قَطُّ إِلَّا أَنْ  يُنْتَهَكَ  مِنْ مَحَارِمِ اللهِ شَيْءٌ  ، فَإِذَا انْتُهِكَ مِنْ مَحَارِمِ اللهِ شَيْءٌ كَانَ أَشَدَّهُمْ فِي ذَلِكَ ، وَمَا خُيِّرَ بَيْنَ أَمْرَيْنِ قَطُّ إِلَّا اخْتَارَ أَيْسَرَهُمَا  .","","Musnad Abi Ya'la al-Mawsili 4452","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن منصور بن المعتمر عن الفضيل بن عياض عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4453","97 - (  4453  ) -  حَدَّثَنَا  الْعَبَّاسُ ،  حَدَّثَنَا  عَبْدُ الْجَبَّارِ بْنُ الْوَرْدِ ، قَالَ :  سَمِعْتُ  ابْنَ أَبِي مُلَيْكَةَ ، يَقُولُ :  قَالَتْ  عَائِشَةُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  كُلُّ مَنْ حُوسِبَ يَوْمَئِذٍ فَقَدْ هَلَكَ  ، فَقُلْتُ : يَا رَسُولَ اللهِ ، فَإِنَّ اللهَ يَقُولُ :         {      يُحَاسَبُ حِسَابًا يَسِيرًا         }      ، قَالَ : إِنَّمَا ذَلِكَ الْعَرْضُ يَا  عَائِشَةُ  ، فَأَمَّا كُلُّ مَنْ  نُوقِشَ  الْحِسَابَ يَوْمَئِذٍ فَقَدْ هَلَكَ  .         [7/433]","","Musnad Abi Ya'la al-Mawsili 4453","","عائشة بنت أبي بكر الصديق عن ابن أبي مليكة عن عبد الجبار بن الورد المخزومي عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4454","98 - (  4454  ) -  حَدَّثَنَا  الْعَبَّاسُ ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  مَيْمُونٍ أَبِي حَمْزَةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ دَعَا  عَلَى مَنْ ظَلَمَهُ - أَوْ قَالَ : عَلَى الظَّالِمِ -  فَقَدِ انْتَصَرَ  .","","Musnad Abi Ya'la al-Mawsili 4454","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن ميمون القصاب عن سلام بن سليم الحنفي عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4455","99 - (  4455  ) -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  يَحْيَى بْنُ         [7/434]      سُلَيْمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُثْمَانَ بْنِ خُثَيْمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي مُلَيْكَةَ ، قَالَ :  سَمِعْتُ  عَائِشَةَ ، تَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ وَهُوَ بَيْنَ ظَهْرَانَيْ أَصْحَابِهِ :  أَنَا  فَرَطُكُمْ  عَلَى الْحَوْضِ  ، أَنْتَظِرُ مَنْ يَرِدُ عَلَيَّ مِنْكُمْ ، فَوَاللهِ  لَيُقْتَطَعَنَّ  رِجَالٌ دُونِي ، فَلَأَقُولَنَّ : رَبِّ ، مِنِّي وَمِنْ أُمَّتِي ، فَيُقَالُ : إِنَّكَ لَا تَدْرِي مَا أَحْدَثُوا بَعْدَكَ ، مَا زَالُوا يَرْجِعُونَ عَلَى أَعْقَابِهِمْ  .","","Musnad Abi Ya'la al-Mawsili 4455","","عائشة بنت أبي بكر الصديق عن ابن أبي مليكة عن عبد الله بن عثمان بن خثيم عن يحيى بن سليم الطائفي عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4456","100 - (  4456  ) -  حَدَّثَنَا  أُمَيَّةُ بْنُ بِسْطَامٍ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  حَبِيبٌ الْمُعَلِّمُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اسْتَخْلَفَ  ابْنَ أُمِّ مَكْتُومٍ  عَلَى  الْمَدِينَةِ  يُصَلِّي بِالنَّاسِ  .         [7/435]","","Musnad Abi Ya'la al-Mawsili 4456","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حبيب المعلم مولى معقل بن يسار عن يزيد بن زريع العيشي عن أمية بن بسطام عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4457","101 - (  4457  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى الْوَاسِطِيُّ ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  عَبْدِ الْمَلِكِ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كُنْتُ أَغْتَسِلُ أَنَا وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ الْجَنَابَةِ مِنْ إِنَاءٍ وَاحِدٍ نَشْرَعُ فِيهِ جَمِيعًا  ، وَلَكِنَّهُ كَانَ يَبْدَأُ فَيَتَوَضَّأُ  .","","Musnad Abi Ya'la al-Mawsili 4457","","عائشة بنت أبي بكر الصديق عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4458","102 - (  4458  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى الْوَاسِطِيُّ ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  أَمَرَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ أَغْسِلَ وَجْهَ  أُسَامَةَ بْنِ زَيْدٍ  يَوْمًا وَهُوَ صَبِيٌّ  ، قَالَتْ : وَمَا وَلَدْتُ وَلَا أَعْرِفُ كَيْفَ يُغْسَلُ الصِّبْيَانُ ، قَالَتْ : فَآخُذُهُ فَأَغْسِلُهُ غَسْلًا لَيْسَ بِذَاكَ ، قَالَتْ : فَأَخَذَهُ فَجَعَلَ يَغْسِلُ وَجْهَهُ ، وَيَقُولُ : لَقَدْ أُحْسِنَ بِنَا إِذْ لَمْ تَكُ جَارِيَةً ، وَلَوْ كُنْتَ جَارِيَةً لَحَلَّيْتُكَ وَأَعْطَيْتُكَ  .         [7/436]","","Musnad Abi Ya'la al-Mawsili 4458","","عائشة بنت أبي بكر الصديق عن الشعبي عن مجالد بن سعيد عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4459","103 - (  4459  ) -  حَدَّثَنَا  زَكَرِيَّا ،  عَنْ  هُشَيْمٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا عَادَ مَرِيضًا يَضَعُ يَدَهُ عَلَى الْمَكَانِ الَّذِي يَشْتَكِي الْمَرِيضُ ، ثُمَّ يَقُولُ :  بِسْمِ اللهِ ، لَا بَأْسَ لَا بَأْسَ ، أَذْهِبِ الْبَأْسَ رَبَّ النَّاسِ ، وَاشْفِ أَنْتَ الشَّافِي ، لَا شِفَاءَ إِلَّا شِفَاؤُكَ شِفَاءً لَا يُغَادِرُ سَقَمًا  ، قَالَتْ  عَائِشَةُ  : فَلَمَّا مَرِضَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَضَعْتُ يَدِي عَلَيْهِ لِأَقُولَ هَؤُلَاءِ الْكَلِمَاتِ ، فَنَزَعَ يَدِي عَنْهُ ، وَقَالَ : اللَّهُمَّ أَنْتَ  الرَّفِيقُ  الْأَعْلَى  .         [7/437]             [7/438]","","Musnad Abi Ya'la al-Mawsili 4459","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4460","104 - (  4460  ) -  حَدَّثَنَا  زَكَرِيَّا ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ، قَالَ :  سَأَلْتُ  عَائِشَةَ :  هَلْ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَتَمَثَّلُ ؟ قَالَتْ : كَانَ يَقُولُ إِذَا دَخَلَ بَيْتَهُ يَتَمَثَّلُ ، يَقُولُ :  لَوْ كَانَ لِابْنِ آدَمَ وَادِيَانِ مِنْ ذَهَبٍ لَابْتَغَى إِلَيْهِمَا ثَالِثًا  ، وَلَا يَمْلَأُ جَوْفَ ابْنِ آدَمَ إِلَّا التُّرَابُ ، وَيَتُوبُ اللهُ عَلَى مَنْ تَابَ ، إِنَّمَا جُعِلَ الْمَالُ لِتُقْضَى بِهِ الصَّلَاةُ ، وَتُؤْتَى بِهِ الزَّكَاةُ ، قَالَتْ : فَكُنَّا نَرَى أَنَّهُ مِمَّا نُسِخَ مِنَ الْقُرْآنِ  .","","Musnad Abi Ya'la al-Mawsili 4460","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن الشعبي عن مجالد بن سعيد عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4461","105 - (  4461  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا         [7/439]      عُبَيْدُ بْنُ سَعِيدٍ الْقُرَشِيُّ ،  عَنْ  سُفْيَانَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  أُهْدِيَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ضَبٌّ فَلَمْ يَأْكُلْ مِنْهُ  ، فَقُلْتُ : يَا رَسُولَ اللهِ ، أَلَا أُطْعِمُهُ السُّؤَّالَ ؟ قَالَ : لَا أُطْعِمُ السُّؤَّالَ إِلَّا مَا آكُلُ مِنْهُ  .","","Musnad Abi Ya'la al-Mawsili 4461","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن سفيان الثوري عن عبيد بن سعيد بن أبان القرشي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4462","106 - (  4462  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  عُبَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ  الدُّبَّاءِ  وَالْمُزَفَّتِ  .         [7/440]","","Musnad Abi Ya'la al-Mawsili 4462","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن سفيان الثوري عن عبيد بن سعيد بن أبان القرشي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4463","107 - (  4463  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  ابْنُ إِدْرِيسَ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْحَكَمِ ،  عَنْ  عُرْوَةَ ،         [7/441]      عَنْ  عَائِشَةَ ، قَالَتْ :  جَاءَهَا سَائِلٌ ، فَأَمَرَتْ لَهُ  عَائِشَةُ  بِشَيْءٍ ، فَلَمَّا جَاءَ الْخَادِمُ دَعَتْهَا فَنَظَرَتْ ، فَقَالَ لَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَوَمَا يَخْرُجُ شَيْءٌ إِلَّا بِعِلْمِكِ ؟ قَالَتْ : إِنِّي لَأَعْلَمُ ، قَالَ :  لَا تُحْصِي فَيُحْصِيَ اللهُ عَلَيْكِ  .","","Musnad Abi Ya'la al-Mawsili 4463","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الحكم بن عتيبة الكندي عن الأعمش عن عبد الله بن إدريس الأودي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4464","108 - (  4464  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  حَجَّاجٍ ،  عَنْ  عَطَاءٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا رَمَى الْجَمْرَةَ وَذَبَحَ وَحَلَقَ فَقَدْ حَلَّ لَهُ كُلُّ شَيْءٍ إِلَّا النِّسَاءَ  .         [7/442]","","Musnad Abi Ya'la al-Mawsili 4464","","عطاء بن أبي رباح عن حجاج بن أرطاة عن أبو معاوية الضرير عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4465","109 - (  4465  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  حَجَّاجٍ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ اللهِ بْنِ أَبِي الْجَهْمِ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ ، عَنِ النَّبِيِّ ، بِمِثْلِهِ .","","Musnad Abi Ya'la al-Mawsili 4465","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن أبو بكر بن عبد الله بن أبي الجهم العدوي عن حجاج بن أرطاة عن أبو معاوية الضرير عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4466","110 - (  4466  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ بْنِ يَزِيدَ ، قَالَ :  سَأَلْتُ عَائِشَةَ عَنِ الْأَوْعِيَةِ الَّتِي نَهَى عَنْهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ فَقَالَتِ : الْقَرْعُ  وَالْمُزَفَّتُ  : وَهِيَ جِرَارٌ خُضْرٌ  مُزَفَّتَةٌ  ، يُجَاءُ بِهَا مِنْ  مِصْرَ  .         [7/443]","","Musnad Abi Ya'la al-Mawsili 4466","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن حماد بن أبي سليمان عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4467","111 - (  4467  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  أَنَّ  عَائِشَةَ ، قَالَتْ :  لَمَّا نَزَلَتْ سُورَةُ الْبَقَرَةِ نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الْخَمْرِ وَالرِّبَا  .         [7/444]","","Musnad Abi Ya'la al-Mawsili 4467","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4468","112 - (  4468  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدَ ،  عَنْ  عَزْرَةَ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  سَعْدِ بْنِ هِشَامٍ ،  عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتْ :  كَانَ عَلَى بَابِي سِتْرٌ فِيهِ تَمَاثِيلُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَلْقُوا هَذَا فَإِنَّهُ يُذَكِّرُنِي الدُّنْيَا  ، قَالَتْ : وَكَانَ لَنَا قَطِيفَةٌ فِيهَا حَرِيرٌ  .","","Musnad Abi Ya'la al-Mawsili 4468","","عائشة بنت أبي بكر الصديق عن سعد بن هشام بن عامر الأنصاري عن حميد بن عبد الرحمن الحميري عن عزرة بن عبد الرحمن بن زرارة عن داود بن أبي هند عن حماد بن زيد عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4469","113 - (  4469  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدِ ،         [7/445]      عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  أَشَدُّ النَّاسِ عَذَابًا يَوْمَ الْقِيَامَةِ الَّذِينَ يُضَاهُونَ بِخَلْقِ اللهِ  .","","Musnad Abi Ya'la al-Mawsili 4469","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4470","114 - (  4470  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَحْيَى بْنِ عَبَّادٍ ،  عَنْ  عَائِشَةَ ،  أَنَّ  النَّجَاشِيَّ  أَهْدَى إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - هَدِيَّةً فِيهَا خَاتَمٌ مِنْ ذَهَبٍ ، فِيهِ فَصٌّ  حَبَشِيٌّ  ، فَأَخَذَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِعُودٍ فَدَفَعَهُ إِلَى  أُمَامَةَ  كَالْمُعْرِضِ عَنْهَا ، فَقَالَ : تَحَلَّيْ بِهَذَا  .","","Musnad Abi Ya'la al-Mawsili 4470","","عائشة بنت أبي بكر الصديق عن يحيى بن عباد بن عبد الله بن الزبير بن العوام عن محمد بن إسحاق عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4471","115 - (  4471  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  أُمِّ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أُهْدِيَتْ إِلَيْهِ هَدِيَّةٌ فِيهَا قِلَادَةُ جَزْعٍ  ، فَقَالَ : لَأَدْفَعَنَّهَا إِلَى أَحَبِّ  أَهْلِ الْبَيْتِ  إِلَيَّ ، فَقَالَتِ النِّسَاءُ : ذَهَبَتْ بِهَا  بِنْتُ أَبِي قُحَافَةَ  ، فَدَعَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أُمَامَةَ         [7/446]      بِنْتَ زَيْنَبَ  فَأَعْلَقَهَا فِي عُنُقِهَا  .","","Musnad Abi Ya'la al-Mawsili 4471","","عائشة بنت أبي بكر الصديق عن أمية بنت عبد الله ، ويقال عن علي بن زيد بن جدعان عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4472","116 - (  4472  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  أَبِي عُثْمَانَ النَّهْدِيِّ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَقُولُ :  اللَّهُمَّ اجْعَلْنِي مِنَ الَّذِينَ إِذَا أَحْسَنُوا اسْتَبْشَرُوا  ، وَإِذَا أَسَاءُوا اسْتَغْفَرُوا  .","","Musnad Abi Ya'la al-Mawsili 4472","","عائشة بنت أبي بكر الصديق عن أبو عثمان النهدي عن علي بن زيد بن جدعان عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4473","117 - (  4473  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  جَبْرِ بْنِ حَبِيبٍ ، وَسَعِيدٍ الْجُرَيْرِيِّ ،  عَنْ  أُمِّ كُلْثُومٍ بِنْتِ أَبِي بَكْرٍ ،  عَنْ  عَائِشَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَّمَهَا أَنْ تَقُولَ : اللَّهُمَّ أَسْأَلُكَ مِنَ الْخَيْرِ كُلِّهِ ، عَاجِلِهِ وَآجِلِهِ  ، مَا عَلِمْتُ مِنْهُ وَمَا لَمْ أَعْلَمْ ، وَأَعُوذُ بِكَ مِنَ الشَّرِّ كُلِّهِ ، عَاجِلِهِ وَآجِلِهِ ، مَا عَلِمْتُ مِنْهُ وَمَا لَمْ أَعْلَمْ ،         [7/447]      اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنَ الْخَيْرِ مَا سَأَلَكَ مِنْهُ عَبْدُكَ وَنَبِيُّكَ ، وَأَعُوذُ بِكَ مِنَ الشَّرِّ مَا اسْتَعَاذَكَ مِنْهُ عَبْدُكَ وَنَبِيُّكَ ، وَأَسْأَلُكَ الْجَنَّةَ وَمَا قَرَّبَ إِلَيْهَا مِنْ قَوْلٍ أَوْ عَمَلٍ ، وَأَعُوذُ بِكَ مِنَ النَّارِ وَمَا قَرَّبَ إِلَيْهَا مِنْ قَوْلٍ أَوْ عَمَلٍ ، وَأَسْأَلُكَ أَنْ تَجْعَلَ كُلَّ قَضَاءٍ تَقْضِيهِ لِي بِخَيْرٍ  .","","Musnad Abi Ya'la al-Mawsili 4473","","عائشة بنت أبي بكر الصديق عن أم كلثوم بنت أبي بكر الصديق عن سعيد بن إياس الجريري عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4474","118 - (  4474  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَقُولُ :  اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ عَذَابِ النَّارِ ، وَمِنْ فِتْنَةِ النَّارِ  ، وَأَعُوذُ بِكَ مِنْ عَذَابِ الْقَبْرِ ، وَمِنْ فِتْنَةِ الْقَبْرِ ، وَأَعُوذُ بِكَ مِنَ  الْمَسِيحِ الدَّجَّالِ  ، وَمِنَ الْكَسَلِ ،  وَالْهَرَمِ  ،  وَالْمَأْثَمِ  ،  وَالْمَغْرَمِ ،  وَمِنْ شَرِّ فِتْنَةِ الْغِنَى ، وَالْفَقْرِ ، اللَّهُمَّ  اغْسِلْنِي  مِنَ الْخَطَايَا بِمَاءِ  الثَّلْجِ  وَالْبَرَدِ ،         [7/448]      اللَّهُمَّ بَاعِدْ بَيْنِي وَبَيْنَ خَطَايَايَ كَمَا بَاعَدْتَ بَيْنَ الْمَشْرِقِ وَالْمَغْرِبِ  .","","Musnad Abi Ya'la al-Mawsili 4474","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4475","119 - (  4475  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  دَاوُدَ         [7/449]      بْنِ أَبِي هِنْدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ  أَنَّ  عَائِشَةَ قَالَتْ  لِلسَّائِبِ  :  ثَلَاثُ خِصَالٍ لَتَدَعْهُنَّ أَوْ  لَأُنَاجِزَنَّكَ  . قَالَ : وَمَا هِيَ ؟ قَالَتْ :  إِيَّاكَ وَالسَّجْعَ لَا تَسْجَعْ ، فَإِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَصْحَابَهُ لَا يَسْجَعُونَ  ، وَإِذَا أَتَيْتَ قَوْمًا يَتَحَدَّثُونَ فَلَا تَقْطَعَنَّ حَدِيثَهُمْ ، وَلَا تُمِلَّ النَّاسَ مِنْ كِتَابِ اللهِ ، وَلَا تُحَدِّثْ فِي الْجُمُعَةِ إِلَّا مَرَّةً ، فَإِنْ أَبَيْتَ فَمَرَّتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 4475","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن الشعبي عن داود بن أبي هند عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4476","120 - (  4476  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  يَحْيَى بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ ،  أَنَّ  عَائِشَةَ ، قَالَتْ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِخَزِيرَةٍ قَدْ طَبَخْتُهَا لَهُ  ، فَقُلْتُ  لِسَوْدَةَ  - وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَيْنِي وَبَيْنَهَا - : كُلِي ، فَأَبَتْ ، فَقُلْتُ : لَتَأْكُلِنَّ ، أَوْ لَأُلَطِّخَنَّ وَجْهَكِ ، فَأَبَتْ ، فَوَضَعْتُ يَدِي فِي الْخَزِيرَةِ ، فَطَلَيْتُ وَجْهَهَا ، فَضَحِكَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَوَضَعَ بِيَدِهِ لَهَا ، وَقَالَ لَهَا : الْطَخِي وَجْهَهَا ، فَضَحِكَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَهَا ، فَمَرَّ  عُمَرُ  ، فَقَالَ : يَا عَبْدَ اللهِ يَا عَبْدَ اللهِ ، فَظَنَّ أَنَّهُ سَيَدْخُلُ ، فَقَالَ : قُومَا فَاغْسِلَا         [7/450]      وُجُوهَكُمَا ، فَقَالَتْ  عَائِشَةُ  : فَمَا زِلْتُ أَهَابُ  عُمَرَ  لِهَيْبَةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .","","Musnad Abi Ya'la al-Mawsili 4476","","عائشة بنت أبي بكر الصديق عن يحيى بن عبد الرحمن بن حاطب اللخمي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4477","121 - (  4477  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ،  عَنْ  عَائِشَةَ ،  أَنَّ  سَعْدَ بْنَ مُعَاذٍ  رُمِيَ فِي  أَكْحَلِهِ  ، فَضَرَبَ لَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خِبَاءً فِي الْمَسْجِدِ لِيَعُودَهُ مِنْ قَرِيبٍ  ، فَقَالَ  سَعْدٌ  : اللَّهُمَّ إِنَّكَ تَعْلَمُ أَنَّ أَحَبَّ النَّاسِ إِلَيَّ قِتَالًا قَوْمٌ كَذَّبُوا نَبِيَّكَ ، وَأَخْرَجُوهُ ، وَفَعَلُوا وَفَعَلُوا ، وَإِنِّي أَظُنُّ أَنْ قَدْ  وَضَعْتَ  الْحَرْبَ بَيْنَنَا         [7/451]      وَبَيْنَهُمُ ، اللَّهُمَّ إِنْ كُنْتَ أَبْقَيْتَ بَيْنَنَا وَبَيْنَهُمْ حَرْبًا فَأَبْقِنِي لَهُمْ ، وَإِنْ كُنْتَ قَدْ  وَضَعْتَ  الْحَرْبَ بَيْنَنَا وَبَيْنَهُمْ فَافْجُرْ هَذَا الْكَلْمَ ، وَاجْعَلْ مَوْتِي فِيهِ ، فَبَيْنَمَا هُوَ ذَاتَ لَيْلَةٍ إِذِ انْفَجَرَ كَلْمُهُ مِنْ  لَبَّتِهِ  ، وَإِلَى جَنْبِهِ أَهْلُ خِبَاءٍ ، فَسَالَ الدَّمُ حَتَّى دَخَلَ الْخِبَاءَ فَنَادَوْهُمْ : يَا أَهْلَ الْخِبَاءِ مَا هَذَا الَّذِي يَجِيئُنَا مِنْ  قِبَلِكُمْ  ؟ فَنَظَرُوا فَإِذَا  سَعْدُ بْنُ مُعَاذٍ  قَدِ انْفَجَرَ كَلْمُهُ مِنْ  لَبَّتِهِ  ، وَإِذَا لِدَمِهِ هَدِيرٌ وَدَوِيٌّ ، قَالَ : فَمَاتَ عَنْهُ .         [7/452]","","Musnad Abi Ya'la al-Mawsili 4477","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4478","122 - (  4478  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ فِي مَرَضِهِ :  لِيَؤُمَّ النَّاسَ  أَبُو بَكْرٍ  ، فَقَالَتْ  عَائِشَةُ  لِحَفْصَةَ  : قُولِي لَهُ : إِنَّ  أَبَا بَكْرٍ  رَجُلٌ  رَقِيقُ  الْقَلْبِ ، وَإِنَّهُ إِذَا قَامَ مَقَامَكَ لَمْ يُسْمِعِ النَّاسَ مِنَ الْبُكَاءِ ، فَمُرْ  عُمَرَ  فَلْيَؤُمَّ النَّاسَ ، فَقَالَتْ  حَفْصَةُ  ذَلِكَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : لِيَؤُمَّ النَّاسَ  أَبُو بَكْرٍ  ، فَقَالَتْ  عَائِشَةُ  لِحَفْصَةَ  مِثْلَ مَقَالَتِهَا الْأُولَى ، فَقَالَ : لِيَؤُمَّ النَّاسَ  أَبُو بَكْرٍ  ، فَأَعَادَتْ  عَائِشَةُ  لِحَفْصَةَ  مِثْلَ مَقَالَتِهَا لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : دَعِينِي ، إِنَّكُنَّ لَأَنْتُنَّ صَوَاحِبُ  يُوسُفَ  ، لِيَؤُمَّ النَّاسَ  أَبُو بَكْرٍ  .         [7/453]             [7/454]             [7/455]","","Musnad Abi Ya'la al-Mawsili 4478","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4479","123 - (  4479  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  أَيُّوبَ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عَائِشَةَ بِمِثْلِهِ ، ثُمَّ قَالَ  ابْنُ أَبِي مُلَيْكَةَ  :  وَأَيَّةُ خِلَافَةٍ أَبْيَنُ مِنْ هَذَا  .","","Musnad Abi Ya'la al-Mawsili 4479","","عائشة بنت أبي بكر الصديق عن ابن أبي مليكة عن أيوب السختياني عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4480","124 - (  4480  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي الْعَصْرَ         [7/456]      وَالشَّمْسُ طَالِعَةٌ فِي حُجْرَتِي  .","","Musnad Abi Ya'la al-Mawsili 4480","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4481","125 - (  4481  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  أَنَّ  عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا أَرَادَ أَنْ يَغْتَسِلَ مِنَ الْجَنَابَةِ غَسَلَ يَدَيْهِ ثَلَاثًا ، ثُمَّ أَخَذَ الْمَاءَ بِيَمِنِهِ  ، ثُمَّ  يُفْرِغُهُ  عَلَى يَسَارِهِ فَيَغْسِلُ فَرْجَهُ حَتَّى يُنْقِيَهُ ، ثُمَّ يَغْسِلُ يَسَارَهُ غَسْلًا حَسَنًا ، ثُمَّ يُمَضْمِضُ ثَلَاثًا ،  وَيَسْتَنْشِقُ  ثَلَاثًا ، وَيَغْسِلُ وَجْهَهُ ، وَيَغْسِلُ ذِرَاعَيْهِ ثَلَاثًا ثَلَاثًا ، ثُمَّ يَصُبُّ عَلَى رَأْسِهِ الْمَاءَ ثَلَاثًا ، ثُمَّ يَغْسِلُ جَسَدَهُ ، فَإِذَا فَرَغَ مِنْ مُغْتَسَلِهِ غَسَلَ قَدَمَيْهِ  .         [7/457]","","Musnad Abi Ya'la al-Mawsili 4481","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن عطاء بن السائب عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4482","126 - (  4482  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا أَرَادَ أَنْ يَغْتَسِلَ مِنَ الْجَنَابَةِ  تَوَضَّأَ  وُضُوءَهُ لِلصَّلَاةِ  ، ثُمَّ يُدْخِلُ يَدَهُ فِي الْإِنَاءِ فَيَتَتَبَّعُ أُصُولَ الشَّعَرِ بِيَدِهِ الْأَيْمَنِ مِنْ شِقِّهِ ، وَيَأْخُذُ بِيَسَارِهِ فَيَتَتَبَّعُ أُصُولَ الشَّعَرِ مِنْ شِقِّهِ الْأَيْسَرِ ، حَتَّى إِذَا ظَنَّ أَنَّهُ اسْتَبْرَأَ الْبَشَرَةَ كُلَّهَا ، صَبَّ عَلَى رَأْسِهِ .  قَالَ  هِشَامٌ  : غَيْرَ أَنَّهُ يَبْدَأُ قَبْلَ ذَلِكَ بِغَسْلِ يَدَيْهِ ثَلَاثًا ثَلَاثًا ، وَبِغَسْلِ فَرْجِهِ  .","","Musnad Abi Ya'la al-Mawsili 4482","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن زيد عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4483","127 - (  4483  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  قَتَادَةَ ، وَعَاصِمٍ الْأَحْوَلِ ،  عَنْ  مُعَاذَةَ الْعَدَوِيَّةِ ،  أَنَّ  عَائِشَةَ ، قَالَتْ :  كُنْتُ أَغْتَسِلُ أَنَا وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ إِنَاءٍ وَاحِدٍ  ، قَالَ  عَاصِمٌ  : قَالَتْ  عَائِشَةُ  : فَيُبَادِرُنِي مُبَادَرَةً  .         [7/458]","","Musnad Abi Ya'la al-Mawsili 4483","","عائشة بنت أبي بكر الصديق عن معاذة بنت عبد الله العدوية عن عاصم بن سليمان الأحول عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4484","128 - (  4484  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ،  أَنَّ  عَائِشَةَ ، قَالَتْ :  كُنْتُ أَغْتَسِلُ أَنَا وَرَسُولُ اللهِ مِنْ إِنَاءٍ وَاحِدٍ  .","","Musnad Abi Ya'la al-Mawsili 4484","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4485","129 - (  4485  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  أَبِي حَمْزَةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُصَلِّي فَوَجَدَ الْقَرَّ ، فَقَالَ : يَا  عَائِشَةُ  ، أَرْخِي عَلَيَّ مِرْطَكِ  ، قَالَتْ : إِنِّي حَائِضٌ ، قَالَ : عِلَّةً وَبُخْلًا ؟ إِنَّ حَيْضَتَكِ لَيْسَتْ فِي يَدَيْكِ  .","","Musnad Abi Ya'la al-Mawsili 4485","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن ميمون القصاب عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4486","130 - (  4486  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،         [7/459]      عَنْ  عَائِشَةَ ،  أَنَّ  فَاطِمَةَ بِنْتَ أَبِي حُبَيْشٍ  ، قَالَتْ : يَا رَسُولَ اللهِ ، إِنِّي امْرَأَةٌ أُسْتَحَاضُ ، فَأَتْرُكُ الصَّلَاةَ ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِنَّمَا ذَاكَ  عِرْقٌ  ، وَلَيْسَتْ بِحَيْضَةٍ ،  فَإِذَا أَقْبَلَتِ الْحَيْضَةُ فَاتْرُكِي الصَّلَاةَ ، وَإِذَا ذَهَبَ فَوْرُهَا فَاغْسِلِي الدَّمَ عَنْكِ وَتَوَضَّئِي وَصَلِّي  .         [7/460]","","Musnad Abi Ya'la al-Mawsili 4486","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4487","131 - (  4487  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  أَبِي عِمْرَانَ الْجَوْنِيِّ ،  عَنْ  يَزِيدَ بْنِ بَابَنُوسَ ،  أَنَّ  عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنَالُ مِنْ رَأْسِي وَأَنَا حَائِضٌ وَبَيْنِي وَبَيْنَهُ ثَوْبٌ  .","","Musnad Abi Ya'la al-Mawsili 4487","","عائشة بنت أبي بكر الصديق عن يزيد بن بابنوس البصري عن عبد الملك بن حبيب الجوني عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4488","132 - (  4488  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  ثَابِتِ بْنِ عُبَيْدٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ لَهَا : نَاوِلِينِي  الْخُمْرَةَ  ، قَالَتْ : إِنِّي حَائِضٌ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ  حَيْضَتَكِ  لَيْسَتْ فِي يَدَيْكِ  .         [7/461]","","Musnad Abi Ya'la al-Mawsili 4488","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن ثابت بن عبيد الأنصاري عن حجاج بن أرطاة عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4489","133 - (  4489  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  أَنَّ  عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا صَلَّى صَلَاةً أَثْبَتَهَا  .         [7/462]             [7/463]","","Musnad Abi Ya'la al-Mawsili 4489","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4490","134 - (  4490  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ،  أَنَّ  عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي وَأَنَا مُعْتَرِضَةٌ بَيْنَهُ وَبَيْنَ الْقِبْلَةِ  كَاعْتِرَاضِ الْجِنَازَةِ تَحْتَ قَطِيفَتِي  .         [7/464]","","Musnad Abi Ya'la al-Mawsili 4490","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4491","135 - (  4491  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ قَالَتْ :  أَجَعَلْتُمُونَا بِمَنْزِلَةِ الْكَلْبِ وَالْحِمَارِ !  لَقَدْ رَأَيْتُنِي تَحْتَ كِسَائِي بَيْنَ يَدَيْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَبَيْنَ الْقِبْلَةِ ، وَهُوَ         [7/465]      يُصَلِّي  ، فَأَكْرَهُ أَنْ  أَسْنَحَ  بَيْنَ يَدَيْهِ حَتَّى  أَنْسَلَّ  مِنْ تَحْتِ الْكِسَاءِ انْسِلَالًا  .","","Musnad Abi Ya'la al-Mawsili 4491","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن حماد بن أبي سليمان عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4492","136 - (  4492  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ،  عَنْ  عَائِشَةَ :  أَنَّ  رَجُلًا  قَامَ لَيْلَةً فَقَرَأَ فَرَفَعَ صَوْتَهُ بِالْقُرْآنِ ، فَلَمَّا أَصْبَحَ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَرْحَمُ اللهُ فُلَانًا ،  كَأَيِّنْ  مِنْ آيَةٍ ذَكَّرَنِيهَا اللَّيْلَةَ كُنْتُ قَدْ أَسْقَطْتُهَا  .         [7/466]","","Musnad Abi Ya'la al-Mawsili 4492","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4493","137 - (  4493  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  عَمْرَةَ بِنْتِ عَبْدِ الرَّحْمَنِ الْأَنْصَارِيَّةِ ،  أَنَّ  عَائِشَةَ ، قَالَتْ :  لَوْ رَأَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ النِّسَاءِ مَا نَرَى لَمَنَعَهُنَّ مِنَ الْمَسَاجِدِ  كَمَا مَنَعَتْ  بَنُو إِسْرَائِيلَ  نِسَاءَهَا ، لَقَدْ رَأَيْتُنَا نُصَلِّي مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْفَجْرَ فِي  مُرُوطِنَا  ، وَنَنْصَرِفُ وَمَا         [7/467]      يَعْرِفُ بَعْضُنَا وُجُوهَ بَعْضٍ  .","","Musnad Abi Ya'la al-Mawsili 4493","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن عبيد الله بن عمر العمري عن حماد بن زيد عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4494","138 - (  4494  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَحْيَى بْنِ عَبَّادٍ ،         [7/468]      عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتِ :  اخْتَلَفُوا فِي غَسْلِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأُلْقِيَ عَلَيْهُمُ النَّوْمُ  ، فَمَا مِنْهُمْ أَحَدٌ إِلَّا وَذَقْنُهُ فِي صَدْرِهِ ، فَنُودُوا مِنْ نَاحِيَةِ الْبَيْتِ : أَنِ اغْسِلُوهُ مِنْ وَرَاءِ قَمِيصِهِ ، قَالَتْ  عَائِشَةُ  :  لَوِ  اسْتَقْبَلْتُ  مِنْ أَمْرِي مَا اسْتَدْبَرْتُ ، مَا غَسَّلَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا نِسَاؤُهُ  .         [7/469]","","Musnad Abi Ya'la al-Mawsili 4494","","عائشة بنت أبي بكر الصديق عن يحيى بن عباد بن عبد الله بن الزبير بن العوام عن محمد بن إسحاق عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4495","139 - (  4495  ) -  حَدَّثَنَا  إِبْرَاهِيمُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ،  عَنْ  عَائِشَةَ ،  أَنَّ  أَبَا بَكْرٍ  ،  قَالَ  لِعَائِشَةَ  : فِي أَيِّ يَوْمٍ مَاتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ فَقَالَتْ : فِي يَوْمِ الِاثْنَيْنِ  ، فَقَالَ : أَيُّ يَوْمٍ هَذَا ؟ قَالَتْ : يَوْمُ الِاثْنَيْنِ ، فَقَالَ : مَا شَاءَ اللهُ أَرْجُو فِيمَا بَيْنِي وَبَيْنَ اللَّيْلِ ، وَقَالَ لَهُمْ : فَبِمَ كَفَّنْتُمُوهُ ؟ فَقَالَتْ : فِي ثَلَاثَةِ أَثْوَابٍ  سَحُولِيَّةٍ  يَمَانِيَةٍ بِيضٍ لَيْسَ فِيهَا قَمِيصٌ وَلَا عِمَامَةٌ ، فَقَالَ  أَبُو بَكْرٍ  : اغْسِلُوا ثَوْبِي هَذَا مِنْ عَهْدِ  رَدْعٍ  مِنْ زَعْفَرَانٍ ، أَوْ  مِشْقٍ  ، وَمَعَهُ ثَوْبَيْنِ آخَرَيْنِ ، فَقَالَتْ  عَائِشَةُ  : يَا أَبَهْ ، هَذَا خَلَقٌ ، فَقَالَ : إِنَّ الْحَيَّ أَحَقُّ بِالْجَدِيدِ ، فَقَالَ : إِنَّمَا هُوَ لِلْمُهْلَةِ .  وَكَانَ  عَبْدُ اللهِ بْنُ أَبِي بَكْرٍ  أَعْطَاهُمْ  حُلَّةً  حِبَرَةً فَأُدْرِجَ رَسُولُ         [7/470]      اللهِ فِيهَا ، ثُمَّ أُخْرِجَ مِنْهَا ، فَكُفِّنَ فِي ثَلَاثَةِ أَثْوَابٍ  سَحُولِيَّةٍ  يَمَانِيَةٍ بِيضٍ ، فَوَجَدَ عَبْدُ اللهِ  الْحُلَّةَ  ، فَقَالَ : لَأُكَفِّنَنَّ نَفْسِي فِي شَيْءٍ مَسَّ جِلْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ قَالَ بَعْدَ ذَلِكَ : لَا وَاللهِ ، لَا أُكَفِّنُ نَفْسِي فِي شَيْءٍ مَنَعَهُ اللهُ رَسُولَهُ أَنْ يُكَفَّنَ فِيهِ ، فَمَاتَ  أَبُو بَكْرٍ  لَيْلَةَ الثُّلَاثَاءِ ، فَدُفِنَ لَيْلًا  .","","Musnad Abi Ya'la al-Mawsili 4495","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4496","140 - (  4496  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  هِشَامٌ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  دَخَلَ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَصْحَابُهُ فِي مَرَضِهِ وَهُوَ يُصَلِّي قَاعِدًا ، فَقَامُوا يُصَلُّونَ خَلْفَهُ ، فَأَوْمَأَ إِلَيْهِمْ بِيَدِهِ أَنِ اجْلِسُوا ، فَجَلَسُوا ، فَلَمَّا قَضَى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّمَا الْإِمَامُ لِيُؤْتَمَّ بِهِ ، فَإِذَا رَكَعَ فَارْكَعُوا ، وَإِذَا سَجَدَ فَاسْجُدُوا  ، وَإِنْ صَلَّى قَائِمًا فَصَلُّوا قِيَامًا ، وَإِنْ صَلَّى قَاعِدًا فَصَلُّوا قُعُودًا  .         [7/471]","","Musnad Abi Ya'la al-Mawsili 4496","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن زيد عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4497","141 - (  4497  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا اغْتَسَلَ مِنْ جَنَابَةٍ  يُفْرِغُ  بِيَمِينِهِ عَلَى شِمَالِهِ فَيَغْسِلُ فَرْجَهُ  ، وَرُبَّمَا  كَنَّتْ  عَنِ الْفَرْجِ ، ثُمَّ يَتَوَضَّأُ كَوُضُوئِهِ لِلصَّلَاةِ ، ثُمَّ يُدْخِلُ يَدَهُ فِي الْمَاءِ ، ثُمَّ يَقُولُ بِهِ فِي شَعَرِهِ ، فَإِنْ ظَنَّ أَنَّهُ قَدْ مَسَّ الْبَشَرَةَ الْمَاءُ أَفْرَغَ عَلَى رَأْسِهِ الْمَاءَ ثَلَاثًا ، وَأَفْضَلَ فِي الْإِنَاءِ فَضْلَةً فَصَبَّهَا عَلَيْهِ بَعْدَمَا  يَفْرُغُ  .","","Musnad Abi Ya'la al-Mawsili 4497","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن زيد عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4498","142 - (  4498  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  هِشَامٌ ،  عَنْ  أَبِيهِ  ،         [7/472]      عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أُرِيتُكِ فِي الْمَنَامِ  ، قُلْتُ : لَمَّا جَاءَ بِكِ الْمَلَكُ فِي  سَرَقَةٍ  مِنْ حَرِيرٍ ، فَيَقُولُ : هَذِهِ امْرَأَتُكَ ، فَلَمَّا كَشَفْتُ عَنْ وَجْهِكِ فَإِذَا أَنْتَ هِيَ ، فَأَقُولُ : إِنْ يَكُنْ مِنْ عِنْدِ اللهِ ، يُمْضِهِ  .","","Musnad Abi Ya'la al-Mawsili 4498","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن زيد عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4499","143 - (  4499  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  هِشَامٌ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّهُ ذُكِرَ عِنْدَهَا قَوْلُ  ابْنِ عُمَرَ  فِي  الْمُعَوَّلِ  عَلَيْهِ ، فَقَالَتْ : يَرْحَمُ اللهُ  أَبَا عَبْدِ الرَّحْمَنِ  ، سَمِعَ الْحَدِيثَ فَلَمْ يَحْفَظْهُ ، إِنَّمَا قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمُرَّ عَلَيْهِ بِجِنَازَةِ يَهُودِيٍّ وَأَهْلُهُ يَبْكُونَ         [7/473]      عَلَيْهِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّهُمْ لَيَبْكُونَ ، وَإِنَّهُ لَيُعَذَّبُ  .","","Musnad Abi Ya'la al-Mawsili 4499","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4500","144 - (  4500  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  هِشَامٌ ،  عَنْ  أَبِيهِ  ،         [7/474]      عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتْ :  يَا رَسُولَ اللهِ ، كُلُّ نِسَائِكَ لَهُنَّ  كُنًى  غَيْرِي ، قَالَ : فَاكْتَنِي بِابْنِكِ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، فَكَانَتْ تُكَنَّى  أُمَّ عَبْدِ اللهِ  .         [7/475]","","Musnad Abi Ya'la al-Mawsili 4500","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن زيد عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4501","145 - (  4501  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  هِشَامٌ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّ أَخَا  أَبِي قُعَيْسٍ  ، اسْتَأْذَنَ عَلَيْهَا فَأَبَتْ أَنْ تَأْذَنَ لَهُ  ، فَذَكَرَتْ ذَلِكَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : إِنَّهُ عَمُّكِ فَأَدْخِلِيهِ ، فَقَالَتْ : يَا رَسُولَ اللهِ ، إِنَّمَا أَرْضَعَتْنِي الْمَرْأَةُ وَلَمْ يُرْضِعِ الرَّجُلُ ؟ قَالَ : إِنَّهُ عَمُّكِ فَأَدْخِلِيهِ  .         [7/476]             [7/477]","","Musnad Abi Ya'la al-Mawsili 4501","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن زيد عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4502","146 - (  4502  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّ  حَمْزَةَ بْنَ عَمْرٍو الْأَسْلَمِيَّ  سَأَلَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي رَجُلٌ  أَسْرُدُ  الصَّوْمَ أَفَأَصُومُ فِي السَّفَرِ ؟ قَالَ :  صُمْ إِنْ شِئْتَ ، وَأَفْطِرْ إِنْ شِئْتَ  .         [7/478]","","Musnad Abi Ya'la al-Mawsili 4502","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن زيد عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4503","147 - (  4503  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  هِشَامٌ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  خَمْسٌ  فَوَاسِقُ         [7/479]      يُقْتَلْنَ فِي  الْحَرَمِ  : الْعَقْرَبُ ،  وَالْفَأْرَةُ  ، وَالْحُدَيَّا ، وَالْغُرَابُ ، وَالْكَلْبُ  الْعَقُورُ  .         [7/480]","","Musnad Abi Ya'la al-Mawsili 4503","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن زيد عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4504","148 - (  4504  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  هِشَامٌ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  خَرَجْنَا مُوَافِينَ لِهِلَالِ ذِي الْحِجَّةِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ شَاءَ أَنْ يُهِلَّ بِحَجٍّ أَهَلَّ بِحَجٍّ ، وَمَنْ شَاءَ أَنْ يُهِلَّ بِعُمْرَةٍ فَلْيُهِلَّ بِعُمْرَةٍ  ، فَكُنْتُ فِيمَنْ أَهَلَّ بِعُمْرَةٍ ، فَذَكَرَتْ أَنَّهَا لَمَّا كَانَتْ  بِسَرِفَ  حَاضَتْ ، قَالَتْ : فَدَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا أَبْكِي ، قَالَ : فَقُلْتُ : وَدِدْتُ أَنِّي لَمْ أَخْرُجِ الْعَامَ ، فَقَالَ : انْقُضِي رَأْسَكِ ، وَارْفُضِي عُمْرَتَكِ ، وَامْتَشِطِي ، وَافْعَلِي مَا يَفْعَلُ الْمُسْلِمُونَ فِي حَجِّهِمْ ، فَأَطَاعَتِ اللهَ وَرَسُولَهُ ، فَلَمَّا كَانَ لَيْلَةُ  النَّفْرِ  أَمَرَ  عَبْدَ الرَّحْمَنِ بْنَ أَبِي بَكْرٍ  أَنْ يُخْرِجَهَا إِلَى  التَّنْعِيمِ  ، فَأَخْرَجَهَا إِلَى  التَّنْعِيمِ  ، فَأَهَلَّتْ مِنْهُ بِعُمْرَةٍ  .","","Musnad Abi Ya'la al-Mawsili 4504","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4505","[8/5]      تَابِعْ [ مُسْنَدَ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا ]  149 - (  4505  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  كَأَنِّي أَنْظُرُ إِلَيَّ أَفْتِلُ قَلَائِدَ هَدْيِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ لَا يُمْسِكُ عَنْ شَيْءٍ يُمْسِكُ عَنْهُ الْحَرَامُ  .","","Musnad Abi Ya'la al-Mawsili 4505","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن زيد عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4506","150 - (  4506  ) -  حَدَّثَنَا  سُوَيْدٌ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ يَعْنِي الدَّرَاوَرْدِيَّ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا أَرَادَ أَنْ يَعْتَكِفَ ، صَلَّى الصُّبْحَ ، فَدَخَلَ مُعْتَكَفَهُ  ، فَلَمَّا كَانَ صَبِيحَةَ إِحْدَى وَعِشْرِينَ ، انْصَرَفَ مِنَ الصُّبْحِ ، فَدَخَلَ الْمَسْجِدَ ، فَرَأَى أَخْبِيَةً ، خِبَاءَ  عَائِشَةَ  وَكَانَتْ قَدِ اسْتَأْذَنَتْهُ ،  وَزَيْنَبَ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  الْبِرَّ  تُرِدْنَ بِهِنَّ ؟ "" فَأَخَّرَ اعْتِكَافَهُ إِلَى شَوَّالٍ  .         [8/6]","","Musnad Abi Ya'la al-Mawsili 4506","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن يحيى بن سعيد الأنصاري عن عبد العزيز بن محمد الدراوردي عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4507","151 - (  4507  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  مُسْلِمُ بْنُ خَالِدٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ ،  عَنْ  مُحَمَّدِ بْنِ جَعْفَرِ بْنِ الزُّبَيْرِ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  إِنَّ أَمْدَادَ الْعَرَبِ كَثُرَتْ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَاضْطَرُّوهُ إِلَى بَيْتِ  عَائِشَةَ  ، فَقَالَ : "" اللَّهُمَّ الْعَنْهُمْ "" ، فَقَالَتْ         [8/7]      عَائِشَةُ  : يَا رَسُولَ اللهِ ، هَلَكَ  الْقَوْمُ  ، فَقَالَ : كَلَّا وَاللهِ ، يَا  بِنْتَ الصِّدِّيقِ  ، لَقَدِ اشْتَرَطْتُ إِلَى رَبِّي شَرْطًا لَا خُلْفَ لَهُ ، قُلْتُ :  اللَّهُمَّ إِنِّي بَشَرٌ أَضِيقُ بِمَا يَضِيقُ بِهِ الْبَشَرُ  ، وَأَعْجَلُ بِمَا يَعْجَلُ بِهِ الْبَشَرُ ، فَأَيُّمَا امْرِئٍ بَدَرَتْ مِنِّي بَادِرَةٌ فَاجْعَلْهَا لَهُ كَفَّارَةً  .","","Musnad Abi Ya'la al-Mawsili 4507","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن محمد بن جعفر بن الزبير بن العوام عن عبد الرحمن بن الحارث المخزومي عن مسلم بن خالد الزنجي عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4508","152 - (  4508  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  ابْنُ أَبِي حَازِمٍ ،  عَنْ  أَبِيهِ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتْ :  وَاعَدَ رَسُولُ اللهِ  جِبْرِيلَ  صَلَّى اللهُ عَلَيْهِمَا فِي سَاعَةٍ يَأْتِيهِ فِيهَا ، فَجَاءَتْ تِلْكَ السَّاعَةُ وَلَمْ يَأْتِ وَفِي يَدِهِ عَصًا فَأَلْقَاهَا مِنْ يَدِهِ ، وَقَالَ : مَا يُخْلِفُ اللهُ وَعْدَهُ وَلَا رُسُلُهُ ،         [8/8]      ثُمَّ الْتَفَتَ فَإِذَا جَرْوُ كَلْبٍ تَحْتَ السَّرِيرِ ، فَقَالَ :  يَا  عَائِشَةُ  مَتَى دَخَلَ هَذَا الْكَلْبُ هَاهُنَا ؟  قَالَتْ : وَاللهِ مَا رَأَيْتُ بِهِ ، فَأَمَرَ بِهِ ، فَأُخْرِجَ ، فَجَاءَ  جِبْرِيلُ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : وَاعَدْتَنِي ، فَجَلَسْتُ لَكَ ، فَلَمْ تَأْتِ قَالَ : مَنَعَنِي الْكَلْبُ الَّذِي كَانَ فِي بَيْتِكَ ، إِنَّا لَا نَدْخُلُ بَيْتًا فِيهِ كَلْبٌ ، وَلَا صُورَةٌ  .","","Musnad Abi Ya'la al-Mawsili 4508","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن سلمة بن دينار الأعرج عن عبد العزيز بن أبي حازم المخزومي عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4509","153 - (  4509  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  يَحْيَى بْنُ سُلَيْمٍ ،  عَنِ  ابْنِ خُثَيْمٍ ،  عَنْ  يُوسُفَ بْنِ مَاهَكَ ، أَنَّ حَفْصَةَ بِنْتَ عَبْدِ الرَّحْمَنِ ،  حَدَّثَتْهُ  ،  عَنْ  عَائِشَةَ ،  أَنَّهَا سَمِعَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْمُرُ  بِالْفَرَعَةِ  مِنَ الْغَنَمِ مِنْ خَمْسَةٍ وَاحِدَةٌ  .         [8/9]","","Musnad Abi Ya'la al-Mawsili 4509","","عائشة بنت أبي بكر الصديق عن حفصة بنت عبد الرحمن بن أبي بكر الصديق عن يوسف بن ماهك الفارسي عن عبد الله بن عثمان بن خثيم عن يحيى بن سليم الطائفي عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4510","154 - (  4510  ) -  حَدَّثَنَا  سُوَيْدٌ ،  حَدَّثَنَا  رِشْدِينُ بْنُ سَعْدٍ ،  عَنِ  ابْنِ الْهَادِ ،  عَنْ  مُوسَى بْنِ سَرْجِسَ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَمُوتُ وَعِنْدَهُ قَدَحٌ فِيهِ مَاءٌ ، فَأَدْخَلَ يَدَهُ فِي الْقَدَحِ ، ثُمَّ مَسَحَ بِهِ وَجْهَهُ ، ثُمَّ يَقُولُ :  اللَّهُمَّ أَعِنِّي عَلَى سَكَرَاتِ الْمَوْتِ  .         [8/10]","","Musnad Abi Ya'la al-Mawsili 4510","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن موسى بن سرجس المدني عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن رشدين بن سعد المهري عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4511","155 - (  4511  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  صَالِحُ بْنُ مُوسَى الطَّلْحِيُّ ،  عَنْ  مُعَاوِيَةَ بْنِ إِسْحَاقَ ،  عَنْ  عَائِشَةَ بِنْتِ طَلْحَةَ ،  عَنْ  عَائِشَةَ أُمِّ الْمُؤْمِنِينَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  جِهَادُ  النِّسَاءِ  الْحَجُّ  .","","Musnad Abi Ya'la al-Mawsili 4511","","عائشة بنت أبي بكر الصديق عن عائشة بنت طلحة التيمية عن معاوية بن إسحاق بن طلحة التيمي عن صالح بن موسى الطلحي عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4512","156 - (  4512  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  صَالِحُ بْنُ         [8/11]      مُوسَى ،  عَنْ  مُعَاوِيَةَ بْنِ إِسْحَاقَ ،  عَنْ  عَائِشَةَ بِنْتِ طَلْحَةَ ،  عَنْ  عَائِشَةَ أُمِّ الْمُؤْمِنِينَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  أَسْرَعُ  الْبِرِّ  ثَوَابًا صِلَةُ الرَّحِمِ  ، وَأَسْرَعُ الشَّرِّ عُقُوبَةً الْبَغْيُ  .","","Musnad Abi Ya'la al-Mawsili 4512","","عائشة بنت أبي بكر الصديق عن عائشة بنت طلحة التيمية عن معاوية بن إسحاق بن طلحة التيمي عن صالح بن موسى الطلحي عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4513","157 - (  4513  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  بَقِيَّةُ ،  عَنْ  مُحَمَّدِ بْنِ زِيَادٍ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ أَبِي قَيْسٍ قَالَ :  سَمِعْتُ  عَائِشَةَ ، تَقُولُ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ  الْوِصَالِ  فِي الصِّيَامِ  .         [8/12]","","Musnad Abi Ya'la al-Mawsili 4513","","عائشة بنت أبي بكر الصديق عن عبد الله بن أبي قيس النصري عن محمد بن زياد الألهاني عن بقية بن الوليد عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4514","158 - (  4514  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكْرٍ ،  حَدَّثَنَا  ابْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  مُعَاذَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  مُرْنَ أَزْوَاجَكُنَّ أَنْ يَغْسِلُوا أَثَرَ الْغَائِطِ ، وَالْبَوْلِ  ، فَإِنِّي أَسْتَحْيِي مِنْهُمْ  ،  وَإِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَفْعَلُهُ  .         [8/13]","","Musnad Abi Ya'la al-Mawsili 4514","","عائشة بنت أبي بكر الصديق عن معاذة بنت عبد الله العدوية عن قتادة بن دعامة عن سعيد بن أبي عروبة عن محمد بن بكر بن عثمان البرساني عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4515","159 - (  4515  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  هَارُونُ الْأَعْوَرُ ،  عَنْ  بُدَيْلِ بْنِ مُيَسَّرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنْ  عَائِشَةَ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّهُ قَرَأَ :         {      فَرَوْحٌ وَرَيْحَانٌ         }      .         [8/14]","","Musnad Abi Ya'la al-Mawsili 4515","","عائشة بنت أبي بكر الصديق عن عبد الله بن شقيق العقيلي عن بديل بن ميسرة العقيلي عن هارون بن موسى العتكي عن يزيد بن زريع العيشي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4516","160 - (  4516  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ أَحَبَّ الشَّرَابِ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْحُلْوُ الْبَارِدُ  .","","Musnad Abi Ya'la al-Mawsili 4516","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن معمر بن راشد عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4517","161 - (  4517  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  وَكِيعُ بْنُ الْجَرَّاحِ ،  حَدَّثَنَا  زَكَرِيَّا بْنُ أَبِي زَائِدَةَ ،  عَنْ  مُصْعَبِ بْنِ شَيْبَةَ ،  عَنْ  طَلْقِ بْنِ حَبِيبٍ ،  عَنِ  ابْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  عَشْرٌ مِنَ  الْفِطْرَةِ  : قَصُّ الشَّارِبِ ،  وَإِعْفَاءُ  اللِّحْيَةِ ، وَالسِّوَاكُ ، وَالِاسْتِنْشَاقُ ، وَقَصُّ         [8/15]      الْأَظْفَارِ ، وَغَسْلُ  الْبَرَاجِمِ ،  وَنَتْفُ الْإِبْطِ ، وَحَلْقُ الْعَانَةِ ،  وَالْانْتِقَاصُ  بِالْمَاءِ  .  قَالَ  وَكِيعٌ  :  يَعْنِي الِاسْتِنْجَاءَ بِالْمَاءِ يَنْقُصُ الْبَوْلَ  .  قَالَ  زَكَرِيَّا  : قَالَ  مُصْعَبٌ  : وَنَسِيتُ الْعَاشِرَةَ إِلَّا أَنْ تَكُونَ الْمَضْمَضَةَ .","","Musnad Abi Ya'la al-Mawsili 4517","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن طلق بن حبيب العنزي عن مصعب بن شيبة بن جبير الحجبي عن زكريا بن أبي زائدة الوادعي عن وكيع بن الجراح عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4518","162 - (  4518  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَقَدْ عَلِمُوا أَنَّ الَّذِي كُنْتُ أَدْعُوهُمْ فِي الدُّنْيَا إِلَيْهِ حَقٌّ  ، وَقَدْ قَالَ اللهُ :         {      إِنَّكَ لا تُسْمِعُ الْمَوْتَى         }      .         [8/16]","","Musnad Abi Ya'la al-Mawsili 4518","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4519","163 - (  4519  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنْ  يُوسُفَ بْنِ مَاهَكَ ،  عَنْ  أُمِّهِ مُسَيْكَةَ  ،  عَنْ  عَائِشَةَ قَالَتْ :  قُلْنَا يَا رَسُولَ اللهِ ، أَلَا نَبْنِي لَكَ بَيْتًا يُظِلُّكَ ؟ قَالَ : "" لَا ،  مِنًى  مُنَاخٌ لِمَنْ سَبَقَ  .         [8/17]","","Musnad Abi Ya'la al-Mawsili 4519","","عائشة بنت أبي بكر الصديق عن مسيكة المكية عن يوسف بن ماهك الفارسي عن إبراهيم بن مهاجر بن جابر البجلي عن إسرائيل بن يونس بن أبي إسحاق عن وكيع بن الجراح عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4520","164 - (  4520  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ قَالَتِ :  اشْتَرَيْتُ  بَرِيرَةَ  لِأُعْتِقَهَا  ، فَاشْتَرَطَ أَهْلُهَا وَلَاءَهَا ، فَذَكَرْتُ ذَلِكَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  أَعْتِقِيهَا ، فَإِنَّ الْوَلَاءَ لِمَنْ أَعْتَقَ  ، وَكَانَ زَوْجُهَا حُرًّا وَهِيَ مَمْلُوكَةٌ ، فَخَيَّرَهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Musnad Abi Ya'la al-Mawsili 4520","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن جرير بن عبد الحميد عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4521","165 - (  4521  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبْدُ الْمَجِيدِ بْنُ عَبْدِ الْعَزِيزِ بْنِ أَبِي رَوَّادٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  عَمْرَةَ ،         [8/18]      عَنْ  عَائِشَةَ قَالَتْ :  يُعَقُّ  عَنِ الْغُلَامِ شَاتَانِ  مُكَافِئَتَانِ ،  وَعَنِ الْجَارِيَةِ شَاةٌ  ، قَالَتْ  عَائِشَةُ  :  فَعَقَّ  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ  الْحَسَنِ  ،  وَالْحُسَيْنِ  ، شَاتَيْنِ شَاتَيْنِ يَوْمَ السَّابِعِ ، وَأَمَرَ أَنْ يُمَاطَ عَنْ رَأْسِهِ  الْأَذَى  ، وَقَالَ : "" اذْبَحُوا عَلَى اسْمِهِ ، وَقُولُوا : بِاسْمِ اللهِ ، اللهُ أَكْبَرُ ، اللَّهُمَّ مِنْكَ وَلَكَ ، هَذِهِ  عَقِيقَةُ  فُلَانٍ "" .  قَالَ : وَكَانُوا فِي الْجَاهِلِيَّةِ تُؤْخَذُ قُطْنَةٌ تُجْعَلُ فِي دَمِ  الْعَقِيقَةِ  ، ثُمَّ تُوضَعُ عَلَى رَأْسِهِ ، فَأَمَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَجْعَلُوا مَكَانَ الدَّمِ خَلُوقًا  .         [8/19]","","Musnad Abi Ya'la al-Mawsili 4521","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن يحيى بن سعيد الأنصاري عن ابن جريج عن عبد المجيد بن عبد العزيز بن أبي رواد عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4522","166 - (  4522  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا أَرَادَ أَنْ يَنَامَ وَهُوَ  جُنُبٌ  ، تَوَضَّأَ وُضُوءَهُ لِلصَّلَاةِ  .         [8/20]","","Musnad Abi Ya'la al-Mawsili 4522","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4523","167 - (  4523  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَائِشَةَ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  كُلُّ شَرَابٍ أَسْكَرَ ، فَهُوَ حَرَامٌ  .","","Musnad Abi Ya'la al-Mawsili 4523","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4524","168 - (  4524  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،         [8/21]      عَنْ  عَائِشَةَ قَالَتْ :  دَخَلَ عَلَيَّ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَقَدِ اسْتَتَرْتُ  بِقِرَامٍ  فِيهِ تَمَاثِيلُ ، فَلَمَّا رَآهُ ، تَلَوَّنَ وَجْهُهُ وَهَتَكَهُ ، وَقَالَ :  إِنَّ أَشَدَّ النَّاسِ عَذَابًا يَوْمَ الْقِيَامَةِ الَّذِينَ يُشَبِّهُونَ بِخَلْقِ اللهِ  .","","Musnad Abi Ya'la al-Mawsili 4524","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4525","169 - (  4525  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ سُلَيْمَانَ ،  عَنِ  الْمُغِيرَةِ بْنِ زِيَادٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَنْ  ثَابَرَ  عَلَى ثِنْتَيْ عَشْرَةَ رَكْعَةً مِنَ السُّنَّةِ ، سِوَى الْفَرِيضَةِ ، بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  : أَرْبَعًا قَبْلَ الظُّهْرِ ، وَرَكْعَتَيْنِ بَعْدَ الظُّهْرِ ، وَرَكْعَتَيْنِ بَعْدَ الْعِشَاءِ ، وَرَكْعَتَيْنِ قَبْلَ الْفَجْرِ  .         [8/22]","","Musnad Abi Ya'la al-Mawsili 4525","","عائشة بنت أبي بكر الصديق عن عطاء بن أبي رباح عن المغيرة بن زياد البجلي عن إسحاق بن سليمان الرازي عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4526","170 - (  4526  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  حَسَّانُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي مَا بَيْنَ الْعِشَاءِ ثَلَاثَ عَشْرَةَ رَكْعَةً  ، يُوتِرُ مِنْهَا ، بِخَمْسٍ يُسَلِّمُ فِي الْخَامِسَةِ  .","","Musnad Abi Ya'la al-Mawsili 4526","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حسان بن إبراهيم الكرماني عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4527","171 - (  4527  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ رَبِّهِ بْنِ سَعِيدٍ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ قَالَتْ : إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا اشْتَكَى الْإِنْسَانُ ، قَالَ         [8/23]      بِرِيقِهِ ، ثُمَّ قَالَ بِهِ فِي التُّرَابِ ، وَيَقُولُ :  تُرْبَةُ أَرْضِنَا بِرِيقَةِ بَعْضِنَا يُشْفَى سَقِيمُنَا بِإِذْنِ رَبِّنَا  .","","Musnad Abi Ya'la al-Mawsili 4527","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن عبد ربه بن سعيد النجاري عن سفيان بن عيينة عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4528","172 - (  4528  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  مَعْنٌ الْقَزَّازُ ،  عَنْ  فُلَانِ بْنِ مُحَمَّدِ بْنِ خَالِدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كَانَ لَا يُفَسِّرُ شَيْئًا مِنَ الْقُرْآنِ بِرَأْيِهِ  ، إِلَّا آيًا بِعَدَدٍ ، عَلَّمَهُنَّ إِيَّاهُ  جِبْرِيلُ  .         [8/24]","","Musnad Abi Ya'la al-Mawsili 4528","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن فلان بن محمد بن خالد عن معن بن عيسى عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4529","173 - (  4529  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبْدُ الْوَارِثِ بْنُ سَعِيدٍ ،  حَدَّثَنَا  يَزِيدُ الرِّشْكُ ،  عَنْ  مُعَاذَةَ ،  عَنْ  عَائِشَةَ ، أَنَّهَا سَأَلَتْهَا :  كَمْ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي الضُّحَى ؟ قَالَتْ : أَرْبَعَ رَكَعَاتٍ  ، وَيَزِيدُ مَا شَاءَ اللهُ  .","","Musnad Abi Ya'la al-Mawsili 4529","","عائشة بنت أبي بكر الصديق عن معاذة بنت عبد الله العدوية عن يزيد بن أبي يزيد الرشك عن عبد الوارث بن سعيد بن ذكوان عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4530","174 - (  4530  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ مِهْزَمٍ الشَّعَّابُ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْقَاسِمِ ،  حَدَّثَنَا  الْقَاسِمُ ،  عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  أَمَا إِنَّهُ مَنْ أُعْطِيَ حَظَّهُ مِنَ  الرِّفْقِ  ، فَقَدْ أُعْطِيَ حَظَّهُ مِنْ خَيْرِ الدُّنْيَا وَالْآخِرَةِ  ، وَمَنْ حُرِمَ حَظَّهُ مِنَ  الرِّفْقِ  ، فَقَدْ حُرِمَ حَظَّهُ مِنْ خَيْرِ الدُّنْيَا وَالْآخِرَةِ  .         [8/25]","","Musnad Abi Ya'la al-Mawsili 4530","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن محمد بن مهزم البصري عن عبد الصمد بن عبد الوارث التنوري عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4531","175 - (  4531  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ لَا يَتَوَضَّأُ بَعْدَ الْغُسْلِ  .","","Musnad Abi Ya'la al-Mawsili 4531","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4532","176 - (  4532  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  النَّضْرُ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ قَالَ :  سَمِعْتُ  طَلْحَةَ بْنَ عُبَيْدِ اللهِ ، قَالَ :         [8/26]      سَمِعْتُ  عَائِشَةَ قَالَتْ :  أَهْوَى إِلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِيُقَبِّلَنِي ، وَأَنَا صَائِمَةٌ  ، فَقُلْتُ : إِنِّي صَائِمَةٌ ، فَقَالَ : "" وَأَنَا صَائِمٌ "" . فَقَبَّلَنِي  .","","Musnad Abi Ya'la al-Mawsili 4532","","عائشة بنت أبي بكر الصديق عن طلحة بن عبيد الله بن كريز الخزاعي عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن شعبة بن الحجاج عن النضر بن شميل عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4533","177 - (  4533  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  النَّضْرُ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  سَعْدٍ قَالَ :  سَمِعْتُ  أَبَا سَلَمَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  سُئِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَيُّ الْعَمَلِ أَحَبُّ إِلَى اللهِ ؟ قَالَ : "" أَدْوَمُهُ وَإِنْ قَلَّ  .         [8/27]             [8/28]","","Musnad Abi Ya'la al-Mawsili 4533","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن شعبة بن الحجاج عن النضر بن شميل عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4534","178 - (  4534  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  النَّضْرُ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  سَعْدٍ قَالَ :  سَمِعْتُ  عُرْوَةَ بْنَ الزُّبَيْرِ قَالَ :  قَالَتْ  عَائِشَةُ :  كُنَّا نَسْمَعُ أَنَّ نَبِيًّا لَا يَمُوتُ حَتَّى يُخَيَّرَ بَيْنَ الدُّنْيَا وَالْآخِرَةِ  ، قَالَتْ : وَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي وَجَعِهِ الَّذِي تُوُفِّيَ فِيهِ أَخَذَتْهُ  بُحَّةٌ  ، فَسَمِعْتُهُ ، يَقُولُ :         {      مَعَ الَّذِينَ أَنْعَمَ اللهُ عَلَيْهِمْ مِنَ النَّبِيِّينَ وَالصِّدِّيقِينَ وَالشُّهَدَاءِ وَالصَّالِحِينَ وَحَسُنَ أُولَئِكَ رَفِيقًا         }      ، فَعَلِمْتُ أَنَّهُ خُيِّرَ  .         [8/29]","","Musnad Abi Ya'la al-Mawsili 4534","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن شعبة بن الحجاج عن النضر بن شميل عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4535","179 - (  4535  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،         [8/30]      عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا كَانَ مِنْ شَرْطٍ لَيْسَ فِي كِتَابِ اللهِ فَهُوَ بَاطِلٌ  ، وَإِنْ كَانَ مِائَةَ شَرْطٍ  .","","Musnad Abi Ya'la al-Mawsili 4535","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن وكيع بن الجراح عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4536","180 - (  4536  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  مَسْرُوقٍ قَالَ :  قَالَتْ  عَائِشَةُ :  مَا رَأَيْتُ أَشَدَّ وَجَعًا مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .","","Musnad Abi Ya'la al-Mawsili 4536","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن شقيق بن سلمة عن الأعمش عن جرير بن عبد الحميد عن إسحاق بن إسماعيل الطالقاني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4537","181 - (  4537  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنِ  ابْنِ أَبِي ذِئْبٍ ،  عَنْ  مَخْلَدِ بْنِ خُفَافٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  قَضَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّ  الْخَرَاجَ  بِالضَّمَانِ  .         [8/31]             [8/32]             [8/33]","","Musnad Abi Ya'la al-Mawsili 4537","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن مخلد بن خفاف بن أيماء الغفاري عن محمد بن عبد الرحمن بن المغيرة عن وكيع بن الجراح عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4538","182 - (  4538  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ  قَالَ  :  دَخَلْتُ عَلَى عَائِشَةَ ، فَدَعَتْ لِي بِطَعَامٍ ، فَقَالَتْ لِي : كُلْ ، فَإِنِّي مَا شَبِعْتُ مِنْ طَعَامٍ فَأَشَاءُ أَنْ أَبْكِيَ إِلَّا بَكَيْتُ ، قُلْتُ : مِمَّ ذَاكَ ؟ قَالَتْ : أَذْكُرُ الْحَالَ الَّتِي فَارَقَ عَلَيْهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الدُّنْيَا ،  مَا شَبِعَ رَسُولُ اللهِ مِنْ خُبْزِ بُرٍّ فِي يَوْمٍ مَرَّتَيْنِ ، حَتَّى لَحِقَ بِاللهِ  .","","Musnad Abi Ya'la al-Mawsili 4538","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن الشعبي عن مجالد بن سعيد عن حماد بن زيد عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4539","183 - (  4539  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  مَا شَبِعَ  آلُ مُحَمَّدٍ  مُذْ قَدِمَ  الْمَدِينَةَ  مِنْ طَعَامِ بُرٍّ ثَلَاثَ لَيَالٍ تِبَاعًا حَتَّى قُبِضَ  .         [8/34]","","Musnad Abi Ya'la al-Mawsili 4539","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4540","184 - (  4540  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  حَجَّاجٌ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ قَالَتْ :  مَا شَبِعَ  آلُ مُحَمَّدٍ  غَدَاءً ، وَلَا عَشَاءً  ، مِنْ خُبْزِ الشَّعِيرِ ثَلَاثَةَ أَيَّامٍ مُتَتَابِعَاتٍ ، حَتَّى لَحِقَ بِاللهِ  .         [8/35]","","Musnad Abi Ya'la al-Mawsili 4540","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن حجاج بن محمد الأعور عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4541","185 - (  4541  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ قَالَتْ :  مَا شَبِعَ رَسُولُ اللهِ يَوْمَيْنِ مِنْ خُبْزِ الشَّعِيرِ حَتَّى مَاتَ  .","","Musnad Abi Ya'la al-Mawsili 4541","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن عبد الصمد بن عبد الوارث التنوري عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4542","186 - (  4542  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  تُوُفِّيَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَمْ يَتْرُكْ دِينَارًا ، وَلَا دِرْهَمًا  ، وَلَا شَاةً ، وَلَا بَعِيرًا ، وَلَمْ يُوصِ بِشَيْءٍ  .         [8/36]","","Musnad Abi Ya'la al-Mawsili 4542","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن شقيق بن سلمة عن الأعمش عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4543","187 - (  4543  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مَسْلَمَةَ بْنِ قَعْنَبٍ ،  حَدَّثَنَا  مَالِكُ بْنُ أَنَسٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَفْرَدَ  الْحَجَّ  .","","Musnad Abi Ya'la al-Mawsili 4543","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4544","188 - (  4544  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُلَيْمُ بْنُ أَخْضَرَ ،  عَنْ  عَوْفٍ ،  عَنْ  أَوْفَى بْنِ دَلْهَمٍ الْعَدَوِيِّ ،  عَنْ  مُعَاذَةَ ،  عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنَالُ مِنْ وُجُوهِنَا وَهُوَ صَائِمٌ  .","","Musnad Abi Ya'la al-Mawsili 4544","","عائشة بنت أبي بكر الصديق عن معاذة بنت عبد الله العدوية عن أوفى بن دلهم العدوي عن عوف بن أبي جميلة عن سليم بن أخضر البصري عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4545","189 - (  4545  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَسْتَعِيذُ مِنَ الدَّيْنِ  ، فَقُلْتُ :         [8/37]      يَا رَسُولَ اللهِ ، أَرَاكَ تَسْتَعِيذُ مِنَ الدَّيْنِ ، فَقَالَ : نَعَمْ ، إِنَّ الدَّائِنَ إِذَا حَدَّثَ كَذَبَ ، وَإِذَا وَعَدَ  أَخْلَفَ  .","","Musnad Abi Ya'la al-Mawsili 4545","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن سفيان بن عيينة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4546","190 - (  4546  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ ،  حَدَّثَنَا  سُفْيَانُ قَالَ :  سَمِعْتُهُ مِنَ  الزُّهْرِيِّ ، وَاللهِ كَمَا أَخْبَرْتُكَ قَالَ :  حَدَّثَنِي  عُرْوَةُ ،  عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَغْتَسِلُ فِي الْقَدَحِ  ،  وَهُوَ  الْفَرَقُ  ، قَالَتْ : وَكُنْتُ أَغْتَسِلُ أَنَا وَهُوَ مِنْ إِنَاءٍ وَاحِدٍ  .","","Musnad Abi Ya'la al-Mawsili 4546","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن سفيان بن عيينة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4547","191 - (  4547  ) -  قَالَ  سُفْيَانُ : وَزَادَ عَاصِمٌ الْأَحْوَلُ قَالَ :  حَدَّثَتْنِي  مُعَاذَةُ ،  عَنْ  عَائِشَةَ قَالَتْ : فَأَقُولُ لَهُ : أَبْقِ لِي ، أَبْقِ لِي .         [8/38]","","Musnad Abi Ya'la al-Mawsili 4547","","عائشة بنت أبي بكر الصديق عن معاذة بنت عبد الله العدوية عن عاصم بن سليمان الأحول عن سفيان بن عيينة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4548","192 - (  4548  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ ،  حَدَّثَنَا  سُفْيَانُ قَالَ :  حَفِظْتُ مِنَ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْتِينَا كُلَّ يَوْمٍ طَرَفَيِ النَّهَارِ  ، فَأَتَانَا يَوْمًا فِي بَحْرِ الظَّهِيرَةِ ، فَقَالَ : يَا  أَبَا بَكْرٍ  ، هَلْ عَلَيَّ مِنْ عَيْنٍ ؟ قَالَ : يَا رَسُولَ اللهِ ، إِنَّمَا هِيَ  أُمُّ رُومَانَ  ،  وَأَسْمَاءُ  ،  وَعَائِشَةُ  قَالَ : فَإِنَّ رَبِّي تَبَارَكَ وَتَعَالَى قَدْ أَذِنَ لِي فِي الْخُرُوجِ ، قَالَ : الصُّحْبَةُ يَا رَسُولَ اللهِ ، قَالَ : الصُّحْبَةُ .  وَكَانَ  أَبُو بَكْرٍ  قَدِ اتَّخَذَ رَاحِلَتَيْنِ ، فَقَالَ : يَا رَسُولَ اللهِ ، خُذْ إِحْدَى رَاحِلَتَيَّ ، فَارْكَبْهَا قَالَ : لَا ، بَلِ الثَّمَنُ يَا  أَبَا بَكْرٍ  .         [8/39]","","Musnad Abi Ya'la al-Mawsili 4548","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن سفيان بن عيينة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4549","193 - (  4549  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أُتِيَ  بِسَارِقٍ - أَوْ سَارِقَةٍ -  فَأَمَرَ بِهَا ، فَقُطِعَتْ  ، وَقَالَ : لَوْ كَانَتْ  فَاطِمَةُ  ، لَأَقَمْتُ عَلَيْهَا  الْحَدَّ  .         [8/40]","","Musnad Abi Ya'la al-Mawsili 4549","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن سفيان بن عيينة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4550","194 - (  4550  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ رَبِّهِ بْنِ سَعِيدٍ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا كَانَ فِي يَدِ الرَّجُلِ الْقُرْحَةُ أَوِ الشَّيْءُ ، قَالَ بِإِصْبَعِهِ هَكَذَا ، ثُمَّ قَالَ :  بِاسْمِ اللهِ ، تُرْبَةُ أَرْضِنَا بِرِيقَةِ بَعْضِنَا  ، وَيَشْفَى سَقِيمُنَا بِإِذْنِ رَبِّنَا  .","","Musnad Abi Ya'la al-Mawsili 4550","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن عبد ربه بن سعيد النجاري عن سفيان بن عيينة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4551","195 - (  4551  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  سُمَيٍّ ،  سَمِعَ  أَبَا بَكْرِ بْنَ عَبْدِ الرَّحْمَنِ ،  يُخْبِرُ عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُدْرِكُهُ الصُّبْحُ وَهُوَ  جُنُبٌ  ، ثُمَّ يَصُومُ  .","","Musnad Abi Ya'la al-Mawsili 4551","","عائشة بنت أبي بكر الصديق عن أبو بكر بن عبد الرحمن راهب قريش عن سمي المخزومي عن سفيان بن عيينة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4552","196 - (  4552  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ ،  حَدَّثَنَا  أَبُو سَعِيدٍ ،         [8/41]      عَنِ  ابْنِ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنِ  الْقَاسِمِ ،  عَنْ  عَائِشَةَ قَالَتْ :  مَا أَحَبَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا ذَا تُقًى  .","","Musnad Abi Ya'la al-Mawsili 4552","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن عبد الرحمن بن عبد الله بن عبيد جردقة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4553","197 - (  4553  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  طَلْحَةَ ،  عَنْ  عَمَّتِهِ عَائِشَةَ بِنْتِ طَلْحَةَ ،  عَنْ  عَائِشَةَ أُمِّ الْمُؤْمِنِينَ ، قَالَتْ :  أُتِيَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِصَبِيٍّ مِنْ صِبْيَانِ الْأَنْصَارِ  يُصَلِّي عَلَيْهِ ، فَقُلْتُ : يَا رَسُولَ اللهِ ، طُوبَى لِهَذَا ، لَمْ يُدْرِكْ شَرًّا  وَلَمْ يَرَهُ - أَوْ لَمْ يَعْقِلْهُ ، أَوْ يَفْعَلْهُ  - فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا  عَائِشَةُ  ، أَوَغَيْرَ ذَلِكَ ؟ ! خَلَقَ اللهُ الْجَنَّةَ وَخَلَقَ لَهَا أَهْلًا  ، وَخَلَقَهَا لَهُمْ وَهُمْ فِي  أَصْلَابِ  آبَائِهِمْ ، وَخَلَقَ النَّارَ وَخَلَقَ لَهَا أَهْلًا ، خَلَقَهَا لَهُمْ وَهُمْ فِي  أَصْلَابِ  آبَائِهِمْ  .         [8/42]","","Musnad Abi Ya'la al-Mawsili 4553","","عائشة بنت أبي بكر الصديق عن عائشة بنت طلحة التيمية عن طلحة بن يحيى بن طلحة التيمي عن سفيان بن عيينة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4554","198 - (  4554  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ ،  حَدَّثَنَا  سُفْيَانُ قَالَ :  سَمِعْتُهُ مِنْ  عَبْدِ رَبِّهِ بْنِ سَعِيدٍ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ الْقَطْعُ فِي رُبُعِ دِينَارٍ فَصَاعِدًا  .","","Musnad Abi Ya'la al-Mawsili 4554","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن عبد ربه بن سعيد النجاري عن سفيان بن عيينة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4555","199 - (  4555  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  عَنْ  عَمَّارِ بْنِ رُزَيْقٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ قَالَتْ :  أَدْلَجْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَيْلَةَ الْبَطْحَاءِ  .","","Musnad Abi Ya'la al-Mawsili 4555","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن عمار بن رزيق الضبي عن معاوية بن هشام القصار عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4556","200 - (  4556  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  عَبْدَةُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،         [8/43]      عَنْ  عَائِشَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَرَّ بِأَرْضٍ تُسَمَّى  غَدِرَةَ  فَسَمَّاهَا  خَضِرَةَ  .","","Musnad Abi Ya'la al-Mawsili 4556","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبدة بن سليمان الكلابي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4557","201 - (  4557  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ ،  حَدَّثَنَا  أَبُو الْجَوَّابِ ،  عَنْ  سُلَيْمَانَ بْنِ قَرْمٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ قَالَتْ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ  الدُّبَّاءِ  ،  وَالْحَنْتَمِ  ،  وَالْمُزَفَّتِ  .","","Musnad Abi Ya'la al-Mawsili 4557","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن سليمان بن قرم الضبي عن أحوص بن جواب الضبي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4558","202 - (  4558  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا         [8/44]      يُونُسُ بْنُ بُكَيْرٍ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَتْ أُمِّي  تُعَالِجُنِي  بِالسُّمْنَةِ تُرِيدُ أَنْ تُدْخِلَنِي عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  . فَمَا اسْتَقَامَ لَهَا ذَلِكَ حَتَّى أَكَلْتُ الرُّطَبَ بِالْقِثَّاءِ ، فَسَمِنْتُ كَأَحْسَنِ السُّمْنَةِ  .","","Musnad Abi Ya'la al-Mawsili 4558","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن يونس بن بكير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4559","203 - (  4559  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ رُومَانَ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْحَرْبُ  خَدْعَةٌ  .","","Musnad Abi Ya'la al-Mawsili 4559","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن يزيد بن رومان الأسدي عن محمد بن إسحاق عن يونس بن بكير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4560","204 - (  4560  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ ،  حَدَّثَنَا  هَاشِمُ بْنُ الْقَاسِمِ ،  عَنْ  مُحَمَّدِ بْنِ مُسْلِمِ بْنِ أَبِي الْوَضَّاحِ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،         [8/45]      عَنْ  عَائِشَةَ قَالَتْ :  سَلُوا اللهَ كُلَّ شَيْءٍ حَتَّى  الشِّسْعَ  ، فَإِنَّ اللهَ إِنْ لَمْ يُيَسِّرْهُ لَمْ يَتَيَسَّرْ  .  كذا في طبعة دار المأمون للتراث ، وساق ابن حجر في المطالب ، والبوصيري في إتحاف الخيرة المهرة ، والهيثمي في مجمع الزوائد عن أبي يعلى عن ( محمد بن عبيد الله بن المنادي) ، وعلق محقق الكتاب على كلام الهيثمي : وليس في إسناد أبي يعلى (محمد بن عبيد الله المنادي) ، فالله أعلم.","","Musnad Abi Ya'la al-Mawsili 4560","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن مسلم بن أبي الوضاح القضاعي عن هاشم بن القاسم بن مسلم عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4561","205 - (  4561  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ،  حَدَّثَنَا  حَيْوَةُ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سُئِلَ فِي  غَزْوَةِ تَبُوكَ  عَنْ سُتْرَةِ الْمُصَلِّي ، فَقَالَ : كَمُؤْخِرَةِ  الرَّحْلِ  .","","Musnad Abi Ya'la al-Mawsili 4561","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4562","206 - (  4562  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ،  حَدَّثَنَا  حَيْوَةُ ،  حَدَّثَنِي  نَافِعُ بْنُ سُلَيْمَانَ ، أَنَّ مُحَمَّدَ بْنَ أَبِي صَالِحٍ ،  أَخْبَرَهُ  ،  عَنْ  أَبِيهِ ،  أَنَّهُ سَمِعَ  عَائِشَةَ زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :         [8/46]      الْإِمَامُ  ضَامِنٌ ،  وَالْمُؤَذِّنُ  مُؤْتَمَنٌ ،  فَأَرْشَدَ اللهُ الْأَئِمَّةَ ، وَعَفَا عَنِ الْمُؤَذِّنِينَ  .","","Musnad Abi Ya'la al-Mawsili 4562","","عائشة بنت أبي بكر الصديق عن ذكوان السمان عن محمد بن ذكوان السمان عن نافع بن سليمان القرشي عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4563","207 - (  4563  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  طَلْحَةَ بْنِ يَحْيَى ،  عَنْ  عَائِشَةَ بِنْتِ طَلْحَةَ ،  عَنْ  عَائِشَةَ أُمِّ الْمُؤْمِنِينَ ، قَالَتْ :  رُبَّمَا دَخَلَ عَلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ لَنَا :  هَلْ عِنْدَكُمْ مِنْ شَيْءٍ ؟ فَنَقُولُ : لَا ، فَيَقُولُ : إِنِّي إِذًا صَائِمٌ  .  قَالَتْ : وَدَخَلَ عَلَيْنَا مَرَّةً ، فَقُلْنَا لَهُ : أُهْدِيَ لَنَا حَيْسٌ ، فَخَبَّأْنَا لَكَ         [8/47]      مِنْهُ ، فَقَالَ : هَلُمُّوهُ ، فَإِنِّي قَدْ كُنْتُ صَائِمًا ، قَالَتْ : فَأَكَلَ  .","","Musnad Abi Ya'la al-Mawsili 4563","","عائشة بنت أبي بكر الصديق عن عائشة بنت طلحة التيمية عن طلحة بن يحيى بن طلحة التيمي عن عباد بن عباد بن حبيب عن سريج بن يونس المروزي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4564","208 - (  4564  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عَرْعَرَةَ ،  حَدَّثَنَا  أَبُو بَكْرٍ الْحَنَفِيُّ ،  حَدَّثَنَا  عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ ،  عَنِ  الْأَسْوَدِ بْنِ الْعَلَاءِ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَنْ يَذْهَبَ اللَّيْلُ وَالنَّهَارُ حَتَّى يُعْبَدَ  اللَّاتُ  وَالْعُزَّى  .         [8/48]      قَالَتْ : قُلْتُ : يَا رَسُولَ اللهِ ، فَقَدْ كُنْتُ أَظُنُّ حِينَ قَالَ اللهُ :         {      هُوَ الَّذِي أَرْسَلَ رَسُولَهُ بِالْهُدَى وَدِينِ الْحَقِّ لِيُظْهِرَهُ عَلَى الدِّينِ كُلِّهِ وَلَوْ كَرِهَ الْمُشْرِكُونَ         }      أَنَّ ذَلِكَ تَامًّا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : سَيَكُونُ مِنْ ذَلِكَ مَا شَاءَ اللهُ ، ثُمَّ يَبْعَثُ اللهُ رِيحًا طَيِّبَةً ، فَتَقْبِضُ رُوحَ مَنْ كَانَ فِي قَلْبِهِ  مِثْقَالُ  حَبَّةٍ  مِنْ خَرْدَلٍ مِنْ خَيْرٍ ، وَيَبْقَى الْآخَرُونَ ، فَيَرْجِعُونَ إِلَى دِينِ آبَائِهِمْ  .","","Musnad Abi Ya'la al-Mawsili 4564","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن الأسود بن العلاء الثقفي عن عبد الحميد بن جعفر الأوسي عن عبد الكبير بن عبد المجيد الحنفي عن إبراهيم بن محمد بن عرعرة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4565","209 - (  4565  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  حَدَّثَنَا  أَبُو أُسَامَةَ قَالَ :  حَدَّثَنَا  عُبَيْدُ اللهِ ،  أَخْبَرَنِي  مُحَمَّدُ بْنُ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ الْأَعْرَجِ ،  عَنْ  أَبِي هُرَيْرَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  فَقَدْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ لَيْلَةٍ مِنَ الْفِرَاشِ ، فَالْتَمَسْتُهُ بِيَدِي ، فَوَقَعَتْ يَدِي عَلَى قَدَمَيْهِ وَهُمَا مَنْصُوبَتَانِ وَهُوَ سَاجِدٌ ، وَهُوَ يَقُولُ :  اللَّهُمَّ إِنِّي أَعُوذُ بِمُعَافَاتِكَ مِنْ عُقُوبَتِكَ  ، وَأَعُوذُ  بِرِضَاكَ  مِنْ سَخَطِكَ ، وَأَعُوذُ بِكَ مِنْكَ ، لَا  أُحْصِي  ثَنَاءً عَلَيْكَ ، أَنْتَ كَمَا أَثْنَيْتَ عَلَى نَفْسِكَ  .         [8/49]","","Musnad Abi Ya'la al-Mawsili 4565","","عائشة بنت أبي بكر الصديق عن أبو هريرة الدوسي عن عبد الرحمن بن هرمز الأعرج عن محمد بن يحيى بن حبان عن عبيد الله بن عمر العمري عن حماد بن أسامة القرشي عن مجاهد بن موسى عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4566","210 - (  4566  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  هَمَّامٌ ،  عَنْ  إِسْحَاقَ بْنِ عَبْدِ اللهِ بْنِ أَبِي طَلْحَةَ ،  عَنْ  شَيْبَةَ الْخُضْرِيِّ ،  أَنَّهُ شَهِدَ  عُرْوَةَ ،  يُحَدِّثُ  عُمَرَ بْنَ عَبْدِ الْعَزِيزِ ،  عَنْ  عَائِشَةَ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  ثَلَاثٌ أَحْلِفُ عَلَيْهِنَّ ، لَا يَجْعَلُ اللهُ مَنْ لَهُ  سَهْمٌ  فِي الْإِسْلَامِ كَمَنْ لَا  سَهْمَ  لَهُ  ، وَسِهَامُ الْإِسْلَامِ ثَلَاثَةٌ : الصَّوْمُ ، وَالصَّلَاةُ ، وَالصَّدَقَةُ ، لَا يَتَوَلَّى اللهُ عَبْدًا فَيُوَلِّيهِ غَيْرَهُ يَوْمَ الْقِيَامَةِ ، وَلَا يُحِبُّ رَجُلٌ قَوْمًا إِلَّا جَاءَ مَعَهُمْ يَوْمَ الْقِيَامَةِ ، وَالرَّابِعَةُ لَوْ حَلَفْتُ عَلَيْهَا لَمْ أَخَفْ أَنْ آثَمَ ، لَا         [8/50]      يَسْتُرُ اللهُ عَلَى عَبْدِهِ فِي الدُّنْيَا إِلَّا سَتَرَ عَلَيْهِ فِي الْآخِرَةِ  . فَقَالَ  عُمَرُ بْنُ عَبْدِ الْعَزِيزِ  : إِذَا سَمِعْتُمْ مِثْلَ هَذَا مِنْ مِثْلِ  عُرْوَةَ  فَاحْفَظُوهُ .","","Musnad Abi Ya'la al-Mawsili 4566","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن شيبة المحاربي عن إسحاق بن عبد الله بن أبي طلحة الخزرجي عن همام بن يحيى بن دينار عن هدبة بن خالد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4567","211 - (  4567  ) -  قَالَ  إِسْحَاقُ :  وَحَدَّثَنِي  عَبْدُ اللهِ بْنُ عُتْبَةَ بْنِ مَسْعُودٍ ،  عَنِ  ابْنِ مَسْعُودٍ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِمِثْلِهِ .","","Musnad Abi Ya'la al-Mawsili 4567","","عبد الله بن مسعود عن عبد الله بن عتبة بن مسعود عن إسحاق بن عبد الله بن أبي طلحة الخزرجي عن همام بن يحيى بن دينار عن هدبة بن خالد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4568","212 - (  4568  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا         [8/51]      مُحَمَّدُ بْنُ خَالِدِ بْنِ عَثْمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مُنِيبٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَحِلُّ لِمُسْلِمٍ أَنْ يَهْجُرَ أَخَاهُ فَوْقَ ثَلَاثٍ  .","","Musnad Abi Ya'la al-Mawsili 4568","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن المنيب الأنصاري عن محمد بن خالد بن عثمة الهاشمى عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4569","213 - (  4569  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  حُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  إِبْرَاهِيمَ بْنِ إِسْمَاعِيلَ ،  عَنْ  دَاوُدَ بْنِ الْحُصَيْنِ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  السِّوَاكُ مَطْهَرَةٌ لِلْفَمِ مَرْضَاةٌ لِلرَّبِّ  ، وَفِي  الْحَبَّةِ  السَّوْدَاءِ  شِفَاءٌ مِنْ كُلِّ دَاءٍ إِلَّا  السَّامَ  ، قُلْتُ : وَمَا  السَّامُ  ؟ قَالَ : الْمَوْتُ  .         [8/52]","","Musnad Abi Ya'la al-Mawsili 4569","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن داود بن الحصين الأموي عن إبراهيم بن إسماعيل الأنصاري عن حميد بن عبد الرحمن الرؤاسي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4570","214 - (  4570  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  أَبِي ،  حَدَّثَنَا  ابْنُ إِسْحَاقَ ،  عَنْ  ثَوْرِ بْنِ زَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ         [8/53]      عُبَيْدِ بْنِ أَبِي صَالِحٍ  قَالَ  : بَعَثَنِي  عَدِيُّ بْنُ عَدِيٍّ  ، إِلَى صَفِيَّةَ بِنْتِ شَيْبَةَ ، أَسْأَلُهَا عَنْ أَشْيَاءَ كَانَتْ تَرْوِيهَا ، عَنْ  عَائِشَةَ  قَالَتْ :  حَدَّثَتْنِي  عَائِشَةُ ، أَنَّهَا سَمِعَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا طَلَاقَ ، وَلَا عَتَاقَ فِي  إِغْلَاقٍ  .","","Musnad Abi Ya'la al-Mawsili 4570","","عائشة بنت أبي بكر الصديق عن صفية بنت شيبة الحجبية عن محمد بن عبيد بن أبي صالح المكي عن ثور بن يزيد الكلاعي عن محمد بن إسحاق عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4571","215 - (  4571  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  حَدَّثَنِي  عَمْرُو بْنُ عُثْمَانَ بْنِ هَانِئٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ قَالَ :  قُلْتُ لَهَا : يَا أُمَّهْ اكْشِفِي لِي عَنْ قَبْرِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَصَاحِبَيْهِ ، فَكَشَفَتْ عَنْ ثَلَاثَةِ قُبُورٍ ، لَاطِئَةٍ  ، مَبْطُوحَةٍ بِبَطْحَاءِ الْعَرْصَةِ الْحَمْرَاءِ ، فَرَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مُقَدَّمًا ،  وَأَبَا بَكْرٍ  رَأْسُهُ بَيْنَ كَتِفَيِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَعُمَرُ  رَأْسُهُ عِنْدَ رِجْلَيِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Musnad Abi Ya'la al-Mawsili 4571","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عمرو بن عثمان بن هانئ المدني عن محمد بن إسماعيل بن مسلم الديلي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4572","216 - (  4572  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ ،         [8/54]      عَنْ  عَائِشَةَ قَالَتْ :  لَمْ يَكُنْ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ هَاجَرَ مِنْ  مَكَّةَ  إِلَى  الْمَدِينَةِ  ، إِلَّا  أَبُو بَكْرٍ  ،  وَعَامِرُ بْنُ فُهَيْرَةَ  ،  وَرَجُلٌ مِنْ بَنِي الدِّيلِ  مُشْرِكٌ كَانَ دَلِيلَهُمْ  .","","Musnad Abi Ya'la al-Mawsili 4572","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن يونس بن بكير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4573","217 - (  4573  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي صَالِحٍ قَالَ :  سُئِلَتْ  عَائِشَةُ ، وَأُمُّ سَلَمَةَ ،  أَيُّ الْعَمَلِ أَحَبُّ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَتَا : مَا دَامَ عَلَيْهِ صَاحِبُهُ وَإِنْ قَلَّ  .","","Musnad Abi Ya'la al-Mawsili 4573","","هند بنت أبي أمية زوج رسول الله عن ذكوان السمان عن الأعمش عن محمد بن فضيل بن غزوان عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4574","218 - (  4574  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  خَلَّادٌ ،  عَنْ  عُبَيْدِ اللهِ بْنِ سَعِيدٍ أَبِي مُسْلِمٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خِفْتُ أَنْ أَكُونَ أُمِرَ فِيَّ بِشَيْءٍ  ، فَخَيَّرَنِي ، فَقُلْتُ : هَلْ ذَكَرْتَ هَذَا لِأَحَدٍ قَبْلِي ؟ قَالَ : لَا ، قُلْتُ : فَإِنِّي قَدِ اخْتَرْتُكَ ، وَخَيَّرَ نِسَاءَهُ كُلَّهُنَّ ،         [8/55]      فَاخْتَرْنَهُ ، فَلَمْ يَعُدَّهُ شَيْئًا  .","","Musnad Abi Ya'la al-Mawsili 4574","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن عبيد الله بن سعيد بن مسلم الجعفي عن خلاد بن يزيد الجعفي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4575","219 - (  4575  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  ابْنُ إِدْرِيسَ ،  حَدَّثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنْ  مَخْلَدِ بْنِ خُفَافٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  قَضَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّ  الْخَرَاجَ  بِالضَّمَانِ  .","","Musnad Abi Ya'la al-Mawsili 4575","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن مخلد بن خفاف بن أيماء الغفاري عن محمد بن عبد الرحمن بن المغيرة عن عبد الله بن إدريس الأودي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4576","220 - (  4576  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ بْنِ شَرُوسٍ الْحَلَبِيُّ ،  عَنِ  ابْنِ مِينَاءَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  رَأَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْتَزَمَ  عَلِيًّا  وَقَبَّلَهُ  ، وَيَقُولُ : بِأَبِي الْوَحِيدُ الشَّهِيدُ ! بِأَبِي الْوَحِيدُ الشَّهِيدُ  .","","Musnad Abi Ya'la al-Mawsili 4576","","عائشة بنت أبي بكر الصديق عن أبو عمر بن ميناء عن عمر بن ميناء عن محمد بن عبد الرحيم بن شروس الصنعاني عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4577","221 - (  4577  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ مِهْرَانَ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ الزُّبَيْرِ ،  عَنْ  عُرْوَةَ ،         [8/56]      عَنْ  عَائِشَةَ قَالَتْ :  كُنْتُ إِذَا أَرَدْتُ أَنْ أَفْرُقَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَدَعْتُ الْفَرْقَ مِنْ  يَافُوخِهِ  ، وَأَرْسَلْتُ نَاصِيَتَهُ بَيْنَ كَتِفَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 4577","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن محمد بن جعفر بن الزبير بن العوام عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن جعفر بن مهران السباك عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4578","222 - (  4578  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ مِهْرَانَ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  يَحْيَى بْنِ عَبَّادِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ عَبَّادِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ قَالَتْ  لَمَّا نَزَلَتْ :         {      وَذَرْنِي وَالْمُكَذِّبِينَ أُولِي النَّعْمَةِ وَمَهِّلْهُمْ قَلِيلا         }      ، قَالَ : لَمْ يَكُنْ إِلَّا يَسِيرًا حَتَّى كَانَتْ وَقْعَةُ  بَدْرٍ  .","","Musnad Abi Ya'la al-Mawsili 4578","","عائشة بنت أبي بكر الصديق عن عباد بن عبد الله بن الزبير بن العوام عن يحيى بن عباد بن عبد الله بن الزبير بن العوام عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن جعفر بن مهران السباك عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4579","223 - (  4579  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ مِهْرَانَ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  حَدَّثَنِي  الزُّهْرِيُّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  رَجَعَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ  الْبَقِيعِ  ، فَدَخَلَ عَلَيَّ فَوَجَدَنِي وَأَنَا أَجِدُ صُدَاعًا فِي رَأْسِي ، وَأَنَا أَقُولُ : وَارَأْسَاهُ         [8/57]      قَالَ :  بَلْ أَنَا وَاللهِ يَا  عَائِشَةُ  ، وَارَأْسَاهُ ، ثُمَّ قَالَ : وَمَا يَضُرُّكِ لَوْ مُتِّ قَبْلِي ، فَقُمْتُ عَلَيْكِ فَكَفَّنْتُكِ ، ثُمَّ صَلَّيْتُ عَلَيْكِ ، وَدَفَنْتُكِ ؟  قَالَتْ : وَاللهِ لَكَأَنِّي بِكَ لَوْ فَعَلْتَ ذَلِكَ قَدْ رَجَعْتَ إِلَى بَيْتِي  فَأَعْرَسْتَ  فِيهِ بِبَعْضِ نِسَائِكَ قَالَ : فَتَبَسَّمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : وَتَتَامَّ بِهِ وَجَعُهُ حَتَّى  اسْتَعَرَّ  بِهِ وَهُوَ فِي بَيْتِ  مَيْمُونَةَ  ، فَدَعَا نِسَاءَهُ ، فَسَأَلَهُنَّ أَنْ يَأْذَنَّ لَهُ أَنْ يُمَرَّضَ فِي بَيْتِي ، فَأَذِنَّ لَهُ ، فَخَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَمْشِي بَيْنَ رَجُلَيْنِ مِنْ أَهْلِهِ أَحَدُهُمَا ،  الْفَضْلُ بْنُ عَبَّاسٍ  ، وَرَجُلٌ آخَرُ تَخُطُّ قَدَمَاهُ ، عَاصِبًا رَأْسَهُ حَتَّى جَاءَ بَيْتِي .  قَالَ  عُبَيْدُ اللهِ  : فَحَدَّثْتُ هَذَا الْحَدِيثَ عَبْدَ اللهِ بْنَ عَبَّاسٍ قَالَ : تَدْرِي مَنِ الرَّجُلُ الْآخَرُ ؟ قَالَ : قُلْتُ : لَا . قَالَ :  عَلِيٌّ  ، ثُمَّ غُمِيَ عَلَى رَسُولِ اللهِ ، وَاشْتَدَّ بِهِ وَجَعُهُ ، ثُمَّ  أَفَاقَ  ، قَالَ : أَهْرِيقُوا عَلَيَّ سَبْعَ قِرَبٍ مِنْ آبَارٍ شَتَّى حَتَّى أَخْرُجَ إِلَى النَّاسِ ، فَأَعْهَدَ إِلَيْهِمْ . قَالَتْ : فَأَقْعَدْنَاهُ فِي  مِخْضَبٍ  لِحَفْصَةَ بِنْتِ عُمَرَ  ، فَصَبَبْنَا عَلَيْهِ الْمَاءَ حَتَّى طَفِقَ يَقُولُ بِيَدِهِ : حَسْبُكُمْ ، حَسْبُكُمْ .  قَالَ  مُحَمَّدٌ  : ثُمَّ خَرَجَ ، كَمَا حَدَّثَنِي  أَيُّوبُ بْنُ بَشِيرٍ  ، عَاصِبًا رَأْسَهُ فَجَلَسَ عَلَى الْمِنْبَرِ ، فَكَانَ أَوَّلَ مَا تَكَلَّمَ بِهِ ، أَنْ صَلَّى عَلَى         [8/58]      أَصْحَابِ أُحُدٍ  ، فَأَكْثَرَ الصَّلَاةَ عَلَيْهِمْ ، ثُمَّ قَالَ : إِنَّ عَبْدًا مِنْ عِبَادِ اللهِ خَيَّرَهُ اللهُ بَيْنَ الدُّنْيَا وَبَيْنَ مَا عِنْدَ اللهِ ، فَاخْتَارَ مَا عِنْدَ اللهِ قَالَ : فَفَهِمَهَا  أَبُو بَكْرٍ  ، فَبَكَى ، وَعَرَفَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَفْسَهُ يُرِيدُ ، قَالَ : عَلَى رِسْلِكَ يَا  أَبَا بَكْرٍ  ، انْظُرُوا هَذِهِ الْأَبْوَابَ اللَّاصِقَةَ فِي الْمَسْجِدِ ، فَسُدُّوهَا ، إِلَّا مَا كَانَ مِنْ بَيْتِ  أَبِي بَكْرٍ  ، فَإِنِّي لَا أَعْلَمُ أَحَدًا كَانَ أَفْضَلَ عِنْدِي فِي الصُّحْبَةِ مِنْهُ  .","","Musnad Abi Ya'la al-Mawsili 4579","","عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن جعفر بن مهران السباك عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4580","224 - (  4580  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ مِهْرَانَ ،  حَدَّثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  يَزِيدَ الرِّشْكِ ،  عَنْ  مُعَاذَةَ ،  عَنْ  عَائِشَةَ :  أَنَّ  امْرَأَةً  سَأَلَتْ  عَائِشَةَ  عَنْ  وِصَالِ  صِيَامِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ : أَتَعْمَلِينَ كَعَمَلِهِ  ، فَإِنَّهُ قَدْ غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ وَمَا تَأَخَّرَ ، وَكَانَ عَمَلُهُ نَافِلَةً ؟ ثُمَّ قَالَتْ  عَائِشَةُ  : أَمَّا أَنَا فَوَاللهِ ، مَا صُمْتُ لَيْلًا قَطُّ ، إِنَّ اللهَ قَالَ :         {      ثُمَّ أَتِمُّوا الصِّيَامَ إِلَى اللَّيْلِ         }      .","","Musnad Abi Ya'la al-Mawsili 4580","","عائشة بنت أبي بكر الصديق عن معاذة بنت عبد الله العدوية عن يزيد بن أبي يزيد الرشك عن عبد الوارث بن سعيد بن ذكوان عن جعفر بن مهران السباك عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4581","225 - (  4581  ) -  حَدَّثَنَا  جَعْفَرٌ ،  حَدَّثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ         [8/59]      يَزِيدَ الرِّشْكِ ،  عَنْ  مُعَاذَةَ ،  أَنَّ  امْرَأَةً  سَأَلَتْ  عَائِشَةَ :  أَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَصُومُ مِنْ كُلِّ شَهْرٍ ثَلَاثَةَ أَيَّامٍ ؟ قَالَتْ : نَعَمْ  ، قُلْتُ : أَيَّ أَيَّامِ  الشَّهْرِ  كَانَ يَصُومُ ؟ قَالَتْ : مَا كَانَ  يُبَالِي  مِنْ أَيِّ أَيَّامِ  الشَّهْرِ  صَامَ  .","","Musnad Abi Ya'la al-Mawsili 4581","","عائشة بنت أبي بكر الصديق عن معاذة بنت عبد الله العدوية عن يزيد بن أبي يزيد الرشك عن عبد الوارث بن سعيد بن ذكوان عن جعفر بن مهران السباك عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4582","226 - (  4582  ) -  حَدَّثَنَا  أَبُو مُوسَى مُحَمَّدُ بْنُ الْمُثَنَّى ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  الْأَوْزَاعِيُّ ،  حَدَّثَنَا  الزُّهْرِيُّ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،         [8/60]      عَنْ  عَائِشَةَ قَالَتْ :  أُدْرِجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي ثَوْبٍ حِبَرَةٍ  ، ثُمَّ أُخِّرَ عَنْهُ  ، قَالَ الْقَاسِمُ :  فَإِنَّ بَقَايَا ذَلِكَ الثَّوْبِ لَعِنْدَنَا  .","","Musnad Abi Ya'la al-Mawsili 4582","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن الزهري عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن أبو موسى الزمن عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4583","227 - (  4583  ) -  حَدَّثَنَا  أَبُو مُوسَى ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَثْمَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُنِيبٍ يَعْنِي الْمَدَنِيَّ ،  أَخْبَرَنِي  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا يَكُونُ لِمُسْلِمٍ أَنْ         [8/61]      يَهْجُرَ مُسْلِمًا فَوْقَ ثَلَاثَةِ أَيَّامٍ  ، فَإِذَا لَقِيَهُ فَسَلَّمَ عَلَيْهِ ثَلَاثَ مَرَّاتٍ كُلُّ ذَلِكَ لَا يَرُدُّ عَلَيْهِ ، فَقَدْ  بَاءَ  بِإِثْمِهِ مَعَ إِثْمِهِ  .","","Musnad Abi Ya'la al-Mawsili 4583","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن المنيب الأنصاري عن محمد بن خالد بن عثمة الهاشمى عن أبو موسى الزمن عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4584","228 - (  4584  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ مِهْرَانَ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنِ  ابْنِ شِهَابٍ ،  حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتْ :  كَانَ آخِرُ كَلَامِهِ كَلِمَةً سَمِعْتُهَا مِنْهُ ، وَهُوَ يَقُولُ : بَلِ  الرَّفِيقَ  الْأَعْلَى مِنَ الْجَنَّةِ  .  قَالَتْ : قُلْتُ : إِذًا وَاللهِ ، لَا يَخْتَارُنَا ، وَعَرَفْتُ أَنَّ الَّذِي كَانَ يَقُولُ لَنَا : إِنَّ نَبِيَّ اللهِ لَا يُقْبَضُ حَتَّى يُخَيَّرَ  .","","Musnad Abi Ya'la al-Mawsili 4584","","عائشة بنت أبي بكر الصديق عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن جعفر بن مهران السباك عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4585","229 - (  4585  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ مِهْرَانَ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  حَدَّثَنِي  يَعْقُوبُ بْنُ عُتْبَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  رَجَعَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَاضْطَجَعَ فِي حُجْرَتِي فِي ذَلِكَ الْيَوْمِ حِينَ دَخَلَ مِنَ الْمَسْجِدِ ، فَدَخَلَ عَلَيَّ         [8/62]      رَجُلٌ مِنْ آلِ أَبِي بَكْرٍ  وَفِي يَدِهِ سِوَاكٌ أَخْضَرُ ، قَالَتْ : فَنَظَرَ إِلَيْهِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ فِي يَدِهِ ، نَظَرًا عَرَفْتُ أَنَّهُ يُرِيدُهُ ، قُلْتُ :  يَا رَسُولَ اللهِ ، أَتُحِبُّ أَنْ أُعْطِيَكَ هَذَا السِّوَاكَ ؟ قَالَ : نَعَمْ ، فَأَخَذْتُهُ فَمَضَغْتُهُ لَهُ حَتَّى لَيَّنْتُهُ ، ثُمَّ أَعْطَيْتُهُ إِيَّاهُ  .  قَالَتْ : فَاسْتَنَّ بِهِ كَأَحْسَنِ مَا رَأَيْتُهُ  يَسْتَنُّ  بِسِوَاكٍ قَبْلَهُ .  قَالَتْ : ثُمَّ وَضَعَهُ ، فَوَجَدْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَثْقُلُ فِي حِجْرِي ، قَالَتْ : فَذَهَبْتُ أَنْظُرُ فِي وَجْهِهِ ، فَإِذَا بَصَرُهُ قَدْ  شَخَصَ  ، وَهُوَ يَقُولُ : بَلِ  الرَّفِيقَ  الْأَعْلَى مِنَ الْجَنَّةِ .  قَالَتْ : فَقُلْتُ : خُيِّرْتَ ، فَاخْتَرْتَ ، وَالَّذِي بَعَثَكَ بِالْحَقِّ .  قَالَتْ : وَقُبِضَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .         [8/63]","","Musnad Abi Ya'la al-Mawsili 4585","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن يعقوب بن عتبة بن المغيرة الثقفي عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن جعفر بن مهران السباك عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4586","230 - (  4586  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ مِهْرَانَ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  حَدَّثَنِي  يَحْيَى بْنُ عَبَّادِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ عَبَّادٍ  قَالَ :  سَمِعْتُ  عَائِشَةَ تَقُولُ :  مَاتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَيْنَ  سَحْرِي  وَنَحْرِي  ، وَفِي بَيْتِي لَمْ أَظْلِمْ فِيهِ أَحَدًا ، فَمِنْ سَفَهِي وَحَدَاثَةِ سِنِّي أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قُبِضَ وَهُوَ فِي حِجْرِي ثُمَّ وَضَعْتُ رَأْسَهُ عَلَى وِسَادَةٍ وَقُمْتُ  أَلْتَدِمُ  مَعَ النِّسَاءِ وَأَضْرِبُ وَجْهِي  .","","Musnad Abi Ya'la al-Mawsili 4586","","عائشة بنت أبي بكر الصديق عن عباد بن عبد الله بن الزبير بن العوام عن يحيى بن عباد بن عبد الله بن الزبير بن العوام عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن جعفر بن مهران السباك عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4587","231 - (  4587  ) -  حَدَّثَنَا  جَعْفَرٌ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرٍ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ .         [8/64]","","Musnad Abi Ya'la al-Mawsili 4587","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن عبد الله بن أبي بكر بن محمد  ابن حزم عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن جعفر بن مهران السباك عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4588","232 - (  4588  ) -  وَعَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ،  عَنْ  أَبِيهِ  ، قَالَ :  قَالَتْ  عَائِشَةُ :  لَمَّا نَزَلَتْ آيَةُ الرَّجْمِ وَرَضَاعَةِ الْكَبِيرِ عَشْرًا فَلَقَدْ كَانَتْ فِي صَحِيفَةٍ تَحْتَ سَرِيرِي  ، فَلَمَّا مَاتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَشَاغَلْنَا بِمَوْتِهِ فَدَخَلَ  دَاجِنٌ  فَأَكَلَهَا  .","","Musnad Abi Ya'la al-Mawsili 4588","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن جعفر بن مهران السباك عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4589","233 - (  4589  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  أَبَانُ ،  حَدَّثَنَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ، أَنَّ زَيْدًا  حَدَّثَهُ  ، أَنَّ أَبَا سَلَّامٍ  حَدَّثَهُ  ، أَنَّ عَبْدَ اللهِ بْنَ فَرُّوخَ  حَدَّثَهُ  ، أَنَّ عَائِشَةَ  حَدَّثَتْهُ  ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  خُلِقَ ابْنُ آدَمَ عَلَى ثَلَاثِمِائَةٍ وَسِتِّينَ مَفْصِلًا  ، فَإِذَا حَمِدَ اللهَ ،         [8/65]      وَهَلَّلَ اللهَ ، وَاسْتَغْفَرَ اللهَ ، وَحَمِدَ اللهَ ، وَعَزَلَ  الشَّوْكَةَ  عَنْ طَرِيقِ الْمُسْلِمِينَ ، وَالْحَجَرَ مِنْ طَرِيقِ الْمُسْلِمِينَ ، وَأَمَرَ بِالْمَعْرُوفِ ، وَنَهَى عَنِ الْمُنْكَرِ ، عَدَدَ تِلْكَ السِّتِّينَ وَالثَّلَاثِمِائَةِ مَفْصِلٍ ، فَقَدْ زُحْزِحَ عَنِ النَّارِ ،  وَأَحْرَزَ - أَوْ أَحْذَرَ  - نَفْسَهُ يَوْمَئِذٍ مِنَ النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 4589","","عائشة بنت أبي بكر الصديق عن عبد الله بن فروخ مولى عائشة بنت أبي بكر الصديق عن ممطور الحبشي عن زيد بن سلام الحبشي عن يحيى بن أبي كثير عن أبان بن يزيد العطار عن هدبة بن خالد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4590","234 - (  4590  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ الْكِنْدِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ طَلْحَةَ ،  عَنْ  زُبَيْدٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا زَالَ  جِبْرِيلُ  يُوصِينِي بِالْجَارِ حَتَّى ظَنَنْتُ أَنَّهُ يُوَرِّثُهُ  .         [8/66]             [8/67]","","Musnad Abi Ya'la al-Mawsili 4590","","عائشة بنت أبي بكر الصديق عن مجاهد بن جبر المخزومي عن زبيد بن الحارث اليامي عن محمد بن طلحة بن مصرف الهمداني عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4591","235 - (  4591  ) -  حَدَّثَنَا  أَبُو إِبْرَاهِيمَ إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ التَّرْجُمَانِيُّ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الزِّنَادِ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَضَعُ  لِحَسَّانَ بْنِ ثَابِتٍ  مِنْبَرًا فِي الْمَسْجِدِ يُنْشِدُ عَلَيْهِ قَائِمًا  ، يُنَافِحُ عَنْ رَسُولِ اللهِ ، ثُمَّ يَقُولُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِنَّ اللهَ  يُؤَيِّدُ  حَسَّانَ  بِرُوحِ الْقُدُسِ  مَا  نَافَحَ  عَنْ رَسُولِ اللهِ  .         [8/68]","","Musnad Abi Ya'la al-Mawsili 4591","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن عبد الرحمن بن أبي الزناد عن إسماعيل بن إبراهيم الترجماني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4592","236 - (  4592  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  حَكِيمُ بْنُ نَافِعٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  سَجْدَتَا السَّهْوِ تُجْزِئُ فِي الصَّلَاةِ مِنْ كُلِّ زِيَادَةٍ وَنُقْصَانٍ  .         [8/69]","","Musnad Abi Ya'la al-Mawsili 4592","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حكيم بن نافع الرقي عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4593","237 - (  4593  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ الْبَزَّارُ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  عَاصِمِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  فَقَدْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَاتَّبَعْتُهُ ، فَأَتَى  الْبَقِيعَ  ، فَقَالَ :  السَّلَامُ عَلَيْكُمْ  دَارَ  قَوْمٍ مُؤْمِنِينَ  ، أَنْتُمْ لَنَا  فَرَطٌ  ، وَإِنَّا بِكُمْ  لَاحِقُونَ  ، اللَّهُمَّ لَا تَحْرِمْنَا أَجْرَهُمْ ، وَلَا تَفْتِنَّا بَعْدَهُمْ  .         [8/70]","","Musnad Abi Ya'la al-Mawsili 4593","","عائشة بنت أبي بكر الصديق عن عبد الله بن عامر بن ربيعة العنزي عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن شريك بن عبد الله النخعي عن محمد بن الصباح الدولابي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4594","238 - (  4594  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَحْدَثَ فِي أَمْرِنَا هَذَا مَا لَيْسَ فِيهِ ، فَهُوَ  رَدٌّ  .         [8/71]","","Musnad Abi Ya'la al-Mawsili 4594","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعد أبو إسحاق الزهري عن محمد بن الصباح الدولابي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4595","239 - (  4595  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  يُونُسَ بْنِ يَزِيدَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،         [8/72]      عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا أَرَادَ أَنْ يَنَامَ وَهُوَ  جُنُبٌ  ، لَمْ يَنَمْ حَتَّى يَتَوَضَّأَ  ، وَإِذَا أَرَادَ أَنْ يَأْكُلَ ، غَسَلَ يَدَيْهِ ، ثُمَّ أَكَلَ  .","","Musnad Abi Ya'la al-Mawsili 4595","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن المبارك عن محمد بن الصباح الدولابي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4596","240 - (  4596  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا ،  عَنْ  طَلْحَةَ بْنِ يَحْيَى ،  عَنْ  عَائِشَةَ بِنْتِ طَلْحَةَ ،  عَنْ  عَائِشَةَ أُمِّ الْمُؤْمِنِينَ ، قَالَتْ :  إِنْ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَيَدْخُلُ عَلَيْنَا ، فَيَقُولُ :  هَلْ أَصْبَحَ عِنْدَكُمْ شَيْءٌ ؟ فَنَقُولُ : لَا ، فَيَقُولُ : إِنِّي صَائِمٌ  .  قَالَتْ : وَلَقَدْ دَخَلَ عَلَيْنَا ذَاتَ يَوْمٍ ، فَقَالَ : هَلْ عِنْدَكُمْ شَيْءٌ ؟ قَالَتْ : قُلْتُ : نَعَمْ ، حَيْسٌ أُهْدِيَ لَنَا ، فَقَالَ : لَقَدْ أَصْبَحْتُ وَأَنَا صَائِمٌ ، ثُمَّ دَعَا بِهِ ، فَطَعِمَ  .","","Musnad Abi Ya'la al-Mawsili 4596","","عائشة بنت أبي بكر الصديق عن عائشة بنت طلحة التيمية عن طلحة بن يحيى بن طلحة التيمي عن إسماعيل بن زكريا شقوصا عن محمد بن الصباح الدولابي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4597","241 - (  4597  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنِ  الْعَبَّاسِ بْنِ ذَرِيحٍ ،  عَنِ  الْبَهِيِّ ،  عَنْ  عَائِشَةَ قَالَتْ :  عَثَرَ  أُسَامَةُ  بِعَتَبَةِ  الْبَابِ ، فَشُجَّ فِي وَجْهِهِ ، فَقَالَ لِيَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا  عَائِشَةُ  ، أَمِيطِي عَنْهُ الْأَذَى  ، فَقَذَرْتُهَا ،         [8/73]      فَجَعَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَمُصُّ شَجَّتَهُ وَيَمُجُّهَا ، وَيَقُولُ : لَوْ كَانَ  أُسَامَةُ  جَارِيَةً ، لَحَلَّيْتُهُ وَكَسَوْتُهُ ، حَتَّى أُنَفِّقَهُ  .","","Musnad Abi Ya'la al-Mawsili 4597","","عائشة بنت أبي بكر الصديق عن عبد الله البهي مولى مصعب بن الزبير عن عباس بن ذريح الكلبي عن شريك بن عبد الله النخعي عن محمد بن الصباح الدولابي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4598","242 - (  4598  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ ،  حَدَّثَنَا  إِسْمَاعِيلُ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ أَبِي عَتِيقٍ قَالَ :  سَمِعْتُ  عَائِشَةَ ، تَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  السِّوَاكُ مَطْهَرَةٌ لِلْفَمِ ، مَرْضَاةٌ لِلرَّبِّ  .","","Musnad Abi Ya'la al-Mawsili 4598","","عائشة بنت أبي بكر الصديق عن عبد الله بن أبي عتيق التيمي عن محمد بن إسحاق عن إسماعيل ابن علية عن محمد بن الصباح الدولابي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4599","243 - (  4599  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ ،  حَدَّثَنَا  حَاتِمٌ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي مُزَرِّدٍ ،  عَنْ  يَزِيدَ بْنِ رُومَانَ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الرَّحِمَ  شِجْنَةٌ  مِنَ الرَّحْمَنِ  ، مَنْ وَصَلَهَا وَصَلَهُ ، وَمَنْ قَطَعَهَا قَطَعَهُ  .         [8/74]","","Musnad Abi Ya'la al-Mawsili 4599","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن يزيد بن رومان الأسدي عن معاوية بن أبي مزرد الهاشمي عن حاتم بن إسماعيل الحارثي عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4600","244 - (  4600  ) -  حَدَّثَنَا  حَوْثَرَةُ بْنُ أَشْرَسَ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  أُتِيتُ فِيمَا يَرَى النَّائِمُ بِجَارِيَةٍ فِي  سَرَقَةٍ  مِنْ حَرِيرٍ ، فَفَتَّشْتُهَا ، فَإِذَا هِيَ أَنْتِ  ، فَقُلْتُ : إِنْ يَكُنْ مِنْ عِنْدِ اللهِ يُمْضِهِ ،  مَرَّتَيْنِ أَوْ ثَلَاثًا  .  فَقَالَتْ  عَائِشَةُ  : فَتَزَوَّجَنِي بَعْدَ وَفَاةِ  خَدِيجَةَ  ، وَقَبْلَ مَخْرَجِهِ إِلَى  الْمَدِينَةِ  بِسَنَتَيْنِ أَوْ ثَلَاثًا  ، وَأَنَا بِنْتُ سَبْعِ سِنِينَ ، فَلَمَّا قَدِمْنَا جَاءَنِي نِسْوَةٌ وَأَنَا أَلْعَبُ عَلَى  أُرْجُوحَةٍ  ، فَهَيَّأْنَنِي وَصَنَعْنَنِي ، ثُمَّ أَتَيْنَ بِي رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَبَنَى بِي وَأَنَا بِنْتُ تِسْعِ سِنِينَ  .","","Musnad Abi Ya'la al-Mawsili 4600","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن حوثرة بن أشرس بن عومر العدوي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4601","245 - (  4601  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنِيعٍ ،  حَدَّثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  إِسْحَاقَ بْنِ يَحْيَى ،  عَنْ  أَبِي بَكْرِ بْنِ حَزْمٍ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  لَعَنَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الرَّاشِيَ  ، وَالْمُرْتَشِيَ  .         [8/75]","","Musnad Abi Ya'la al-Mawsili 4601","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن أبو بكر بن محمد الخزرجي عن إسحاق بن يحيى بن طلحة التيمي عن مروان بن معاوية الفزاري عن أحمد بن منيع البغوي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4602","246 - (  4602  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنِيعٍ ،  حَدَّثَنَا  مَرْوَانُ ،  عَنْ  رَزِينٍ الْبَكْرِيِّ قَالَ :  حَدَّثَتْنَا  مَوْلَاةٌ لَنَا يُقَالُ لَهَا سَلْمَى مِنْ بَكْرِ بْنِ وَائِلٍ ،  أَنَّهَا سَمِعَتْ  عَائِشَةَ ، تَقُولُ :  دَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  يَا  عَائِشَةُ  ، هَلْ مِنْ كِسْرَةٍ ؟  فَأَتَيْتُهُ بِقُرْصٍ فَوَضَعَهُ عَلَى فِيهِ ، وَقَالَ : يَا  عَائِشَةُ  ، هَلْ دَخَلَ بَطْنِي مِنْهُ شَيْءٌ ؟ كَذَلِكَ قُبْلَةُ الصَّائِمِ ، إِنَّمَا         [8/76]      الْإِفْطَارُ مِمَّا دَخَلَ ، وَلَيْسَ مِمَّا خَرَجَ  .","","Musnad Abi Ya'la al-Mawsili 4602","","عائشة بنت أبي بكر الصديق عن سلمى البكرية عن رزين بن حبيب الجهني عن مروان بن معاوية الفزاري عن أحمد بن منيع البغوي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4603","247 - (  4603  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنِيعٍ ،  حَدَّثَنَا  مَرْوَانُ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  عَمِّهِ ،  عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُصَلِّي رَكْعَتَيِ الْفَجْرِ وَيُخَفِّفُهُمَا  ، حَتَّى أَقُولَ : أَقَرَأَ فِيهِمَا بِفَاتِحَةِ الْكِتَابِ .  ؟         [8/77]","","Musnad Abi Ya'la al-Mawsili 4603","","عائشة بنت أبي بكر الصديق عن واسع بن حبان بن منقذ المازني عن محمد بن يحيى بن حبان عن يحيى بن سعيد الأنصاري عن مروان بن معاوية الفزاري عن أحمد بن منيع البغوي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4604","248 - (  4604  ) -  حَدَّثَنَا  دَاوُدُ بْنُ عَمْرٍو الضَّبِّيُّ ،  حَدَّثَنَا  نَافِعُ بْنُ عُمَرَ الْجُمَحِيُّ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ قَالَ :  قَالَتْ  عَائِشَةُ :  تُوُفِّيَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي بَيْتِي ، وَفِي يَوْمِي ، وَبَيْنَ  سَحْرِي  وَنَحْرِي  ، وَجَمَعَ اللهُ بَيْنَ رِيقِي وَرِيقِهِ ، قَالَتْ  عَائِشَةُ  : دَخَلَ  عَبْدُ الرَّحْمَنِ بْنُ أَبِي بَكْرٍ  بِسِوَاكٍ ، فَضَعُفَ عَنْهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَخَذْتُهُ ثُمَّ مَضَغْتُهُ ، ثُمَّ سَنَنْتُهُ بِهِ  .","","Musnad Abi Ya'la al-Mawsili 4604","","عائشة بنت أبي بكر الصديق عن ابن أبي مليكة عن نافع بن عمر بن عبد الله بن جميل الجمحي عن داود بن عمرو المسيبي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4605","249 - (  4605  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ بْنِ حِسَابٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عُمَرَ بْنِ أَبِي سَلَمَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا رَأَى الرِّيحَ قَدِ اشْتَدَّتْ تَغَيَّرَ وَجْهُهُ  .         [8/78]","","Musnad Abi Ya'la al-Mawsili 4605","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن عمر بن أبي سلمة الزهري عن الوضاح بن عبد الله اليشكري عن محمد بن عبيد بن حساب الغبري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4606","250 - (  4606  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،  عَنْ  عَائِشَةَ ، ذَكَرَ أَنَّهُ سَمِعَهُ مِنْهَا ،  أَنَّهَا رَأَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَدْعُو رَافِعًا يَدَيْهِ ، يَقُولُ :  اللَّهُمَّ إِنَّمَا أَنَا بَشَرٌ فَلَا تُعَاقِبْنِي ، أَيُّمَا رَجُلٍ مِنَ الْمُسْلِمِينَ آذَيْتُهُ ، أَوْ شَتَمْتُهُ فَلَا تُعَاقِبْنِي  .","","Musnad Abi Ya'la al-Mawsili 4606","","عائشة بنت أبي بكر الصديق عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4607","251 - (  4607  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُعَاوِيَةَ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  حَدَّثَنَا  عَلِيُّ بْنُ زَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَائِشَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَكَرَ  جَهْدًا  شَدِيدًا يَكُونُ بَيْنَ يَدَيِ  الدَّجَّالِ  ، فَقُلْتُ : يَا رَسُولَ اللهِ ، فَأَيْنَ الْعَرَبُ يَوْمَئِذٍ ؟ فَقَالَ :  يَا  عَائِشَةُ  ، إِنَّ الْعَرَبَ يَوْمَئِذٍ قَلِيلٌ  ، قُلْتُ : فَمَا يُجْزِئُ الْمُؤْمِنَ يَوْمَئِذٍ مِنَ الطَّعَامِ ؟ قَالَ : التَّسْبِيحُ وَالتَّهْلِيلُ وَالتَّكْبِيرُ ، قُلْتُ :         [8/79]      فَأَيُّ الْمَالِ يَوْمَئِذٍ خَيْرٌ ؟ قَالَ : غُلَامٌ يَسْقِي أَهْلَهُ مِنَ الْمَاءِ ، أَمَّا الطَّعَامُ فَلَا طَعَامَ  .","","Musnad Abi Ya'la al-Mawsili 4607","","عائشة بنت أبي بكر الصديق عن الحسن البصري عن علي بن زيد بن جدعان عن حماد بن سلمة عن عبد الله بن معاوية الجمحي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4608","252 - (  4608  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ ،  حَدَّثَنَا  حُسَيْنٌ يَعْنِي الْجُعْفِيَّ ،  عَنِ  ابْنِ السَّمَّاكِ ،  عَنْ  عَائِذٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ مَاتَ فِي هَذَا الْوَجْهِ بِحَجٍّ أَوْ عُمْرَةٍ ، فَمَاتَ فِيهِ لَمْ يُعْرَضْ ، وَلَمْ يُحَاسَبْ  ، وَقِيلَ : ادْخُلِ الْجَنَّةَ  .         [8/80]","","Musnad Abi Ya'la al-Mawsili 4608","","عائشة بنت أبي بكر الصديق عن عطاء بن أبي رباح عن عائذ بن نسير عن محمد بن صبيح بن السماك الكوفي عن الحسين بن علي الجعفي عن الحسن بن حماد سجادة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4609","253 - (  4609  ) -  قَالَتْ  : وَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ اللهَ  يُبَاهِي  بِالطَّائِفِينَ  .","","Musnad Abi Ya'la al-Mawsili 4609","","عائشة بنت أبي بكر الصديق عن عطاء بن أبي رباح عن عائذ بن نسير عن محمد بن صبيح بن السماك الكوفي عن الحسين بن علي الجعفي عن الحسن بن حماد سجادة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4610","254 - (  4610  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عُيَيْنَةَ ،  عَنْ  صَالِحِ بْنِ حَسَّانَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ قَالَتْ :  جَلَسْتُ أَبْكِي عِنْدَ رَأْسِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ لِي :  مَا يُبْكِيكِ ؟ إِنْ كُنْتِ تُرِيدِينَ اللُّحُوقَ بِي فَلْيَكْفِكِ مِنَ الدُّنْيَا مِثْلُ زَادِ الرَّاكِبِ  ، وَلَا تُخَالِطِي الْأَغْنِيَاءَ  .","","Musnad Abi Ya'la al-Mawsili 4610","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن صالح بن حسان النضري عن إبراهيم بن عيينة الهلالي عن الحسن بن حماد سجادة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4611","255 - (  4611  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ حَاتِمٍ الطَّوِيلُ ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  عَطَاءٍ ،         [8/81]      عَنْ  عَائِشَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَمِعَ  رَجُلًا  يُلَبِّي عَنْ  شُبْرُمَةَ  قَالَ : وَمَا  شُبْرُمَةُ  ؟  فَذَكَرَ قَرَابَةً ، فَقَالَ : أَحَجَجْتَ عَنْ نَفْسِكَ ؟ قَالَ : لَا ، قَالَ : فَاحْجُجْ عَنْ نَفْسِكَ ، ثُمَّ احْجُجْ عَنْ  شُبْرُمَةَ  .","","Musnad Abi Ya'la al-Mawsili 4611","","عائشة بنت أبي بكر الصديق عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن أحمد بن حاتم بن يزيد الحناط عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4612","256 - (  4612  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ حَاتِمٍ ،  حَدَّثَنَا  يُوسُفُ بْنُ الْمَاجِشُونِ ،  أَخْبَرَنِي  أَبِي ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  جَدَّتِهِ رُمَيْثَةَ  ، قَالَتْ :  أَصْبَحْتُ عِنْدَ عَائِشَةَ ، فَلَمَّا أَصْبَحْنَا ، قَامَتْ فَاغْتَسَلَتْ ، ثُمَّ دَخَلَتْ بَيْتًا لَهَا ،  وَأَجَافَتِ  الْبَابَ دُونِي  ، فَقُلْتُ : يَا أُمَّ الْمُؤْمِنِينَ ، مَا أَصْبَحْتُ عِنْدَكَ إِلَّا مِنْ أَجْلِ هَذِهِ السَّاعَةِ ،  قَالَتْ  : فَادْخُلِي ، فَدَخَلْتُ ، فَصَلَّتْ ثَمَانَ رَكَعَاتٍ ، لَا أَدْرِي أَقِيَامُهُنَّ أَطْوَلُ         [8/82]      أَمْ رُكُوعُهُنَّ أَمْ سُجُودُهُنَّ ، ثُمَّ الْتَفَتَتْ إِلَيَّ ، فَضَرَبَتْ فَخِذِي ، ثُمَّ قَالَتْ : يَا  رُمَيْثَةُ  ، رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّيهِنَّ ، وَلَوْ نُشِرَ لِي أَبِي عَلَى تَرْكِهِنَّ مَا تَرَكْتُهُنَّ  .","","Musnad Abi Ya'la al-Mawsili 4612","","عائشة بنت أبي بكر الصديق عن رميثة بنت عمرو الأنصارية عن عاصم بن عمر الظفري عن يعقوب بن أبي سلمة الماجشون عن يوسف بن يعقوب بن أبي سلمة الماجشون عن أحمد بن حاتم بن يزيد الحناط عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4613","257 - (  4613  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ حَاتِمٍ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ الدَّرَاوَرْدِيُّ ،  عَنْ  هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يُسْتَقَى لَهُ الْعَذْبُ مِنْ بِئْرِ  السُّقْيَا  ، وَرُبَّمَا قَالَ :  يُسْتَعْذَبُ  لَهُ الْمَاءُ  .","","Musnad Abi Ya'la al-Mawsili 4613","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد العزيز بن محمد الدراوردي عن أحمد بن حاتم بن يزيد الحناط عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4614","258 - (  4614  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ حَاتِمٍ ،  حَدَّثَنَا  مُسْلِمُ بْنُ         [8/83]      خَالِدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْخَرَاجُ  بِالضَّمَانِ  .","","Musnad Abi Ya'la al-Mawsili 4614","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن مسلم بن خالد الزنجي عن أحمد بن حاتم بن يزيد الحناط عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4615","259 - (  4615  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ حَاتِمٍ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  عَلْقَمَةَ بْنِ أَبِي عَلْقَمَةَ ،  عَنْ  أُمِّهِ ،  عَنْ  عَائِشَةَ قَالَتْ :  قُلْتُ : يَا رَسُولَ اللهِ ، إِنِّي أُحِبُّ أَنْ أُصَلِّيَ فِي  الْبَيْتِ  ، فَأَخَذَ بِيَدِي حَتَّى أَدْخَلَنِي  الْحِجْرَ  ، فَقَالَ :  صَلِّي هَاهُنَا ، فَإِنَّ هَذَا مِنَ  الْبَيْتِ  ، وَلَكِنَّ  قَوْمَكِ - أَوْ قَوْمَهُ  - اسْتَقْصَرُوا فَأَخْرَجُوهُ مِنَ  الْبَيْتِ  .","","Musnad Abi Ya'la al-Mawsili 4615","","عائشة بنت أبي بكر الصديق عن مرجانة المدنية أم علقمة عن علقمة بن أبي علقمة مولى عائشة عن عبد العزيز بن محمد الدراوردي عن أحمد بن حاتم بن يزيد الحناط عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4616","260 - (  4616  ) -  حَدَّثَنَا  هَارُونُ أَبُو مُوسَى الْحَمَّالُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  قَيْسِ بْنِ مُسْلِمٍ الْجَدَلِيِّ ،  عَنِ  الْحَسَنِ بْنِ مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  عَائِشَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أُهْدِيَ لَهُ  وَشِيقَةُ  ظَبْيٍ وَهُوَ         [8/84]      مُحْرِمٌ ، فَرَدَّهَا  .","","Musnad Abi Ya'la al-Mawsili 4616","","عائشة بنت أبي بكر الصديق عن الحسن بن محمد بن علي بن أبي طالب عن قيس بن مسلم الجدلي عن عبد الكريم الاصطخري عن سفيان بن عيينة عن هارون بن عبد الله بن مروان الحمال عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4617","261 - (  4617  ) -  حَدَّثَنَا  أَبُو مُوسَى ،  حَدَّثَنَا  سُفْيَانُ ، فِي الْمَوْسِمِ عَلَى رُؤُوسِ الْمَلَأِ .  حَدَّثَنَا  أَبُو مُوسَى هَارُونُ الْبَزَّارُ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكْرٍ الْبُرْسَانِيُّ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  قَيْسِ بْنِ مُسْلِمٍ ،  عَنِ  الْحَسَنِ بْنِ مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  عَائِشَةَ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ . قَالَ  هَارُونُ  : وَسَمِعْتُ  سُفْيَانَ  ، يَقُولُ :  الْوَشِيقَةُ  ، لَحْمٌ يُطْبَخُ ثُمَّ يُيَبَّسُ  .         [8/85]","","Musnad Abi Ya'la al-Mawsili 4617","","عائشة بنت أبي بكر الصديق عن الحسن بن محمد بن علي بن أبي طالب عن قيس بن مسلم الجدلي عن عبد الكريم بن أبي المخارق عن ابن جريج عن محمد بن بكر بن عثمان البرساني عن هارون بن عبد الله بن مروان الحمال عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4618","262 - (  4618  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ الْكِنْدِيُّ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  دَخَلَ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  رَجُلٌ  ، فَقَرَّبَهُ وَأَدْنَى مَجْلِسَهُ ، فَلَمَّا خَرَجَ مِنْ عِنْدِهِ ، قَالَتْ : يَا رَسُولَ اللهِ ، أَلَسْتَ كُنْتَ تَشْكُو هَذَا ؟ قَالَ :  بَلَى ، وَلَكِنْ مِنْ شِرَارِ النَّاسِ الَّذِينَ يُكْرَمُونَ اتِّقَاءَ شَرِّهِمْ  .","","Musnad Abi Ya'la al-Mawsili 4618","","عائشة بنت أبي بكر الصديق عن مجاهد بن جبر المخزومي عن الأعمش عن شريك بن عبد الله النخعي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4619","263 - (  4619  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  شَرِيكٌ ،         [8/86]      عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  قَامَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ فِرَاشِهِ فِي بَعْضِ اللَّيْلِ ، فَظَنَنْتُ أَنَّهُ يُرِيدُ بَعْضَ نِسَائِهِ ، فَتَبِعْتُهُ حَتَّى قَامَ عَلَى الْمَقَابِرِ ، فَقَالَ :  السَّلَامُ عَلَيْكُمْ  دَارَ  قَوْمٍ مُؤْمِنِينَ ، وَإِنَّا بِكُمْ  لَاحِقُونَ  ، ثُمَّ قَالَ : اللَّهُمَّ لَا تَحْرِمْنَا أَجْرَهُمْ ، وَلَا تَفْتِنَّا بَعْدَهُمْ ، قَالَتْ : ثُمَّ الْتَفَتَ فَرَآنِي ، فَأَبْصَرَنِي ، فَقَالَ : وَيْحَهَا لَوْ تَسْتَطِيعُ مَا فَعَلَتْ  .         [8/87]","","Musnad Abi Ya'la al-Mawsili 4619","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن يحيى بن سعيد الأنصاري عن شريك بن عبد الله النخعي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4620","264 - (  4620  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  عَاصِمِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  فَقَدْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ اللَّيْلِ فَاتَّبَعْتُهُ ، فَإِذَا هُوَ  بِالْبَقِيعِ  ، فَسَمِعْتُهُ يَقُولُ :  سَلَامٌ  عَلَيْكُمْ  دَارَ  قَوْمٍ مُؤْمِنِينَ ، أَنْتُمْ لَنَا  فَرَطٌ  وَإِنَّا  لَاحِقُونَ  ، اللَّهُمَّ لَا تَحْرِمْنَا أَجْرَهُمْ ، وَلَا تَفْتِنَّا بَعْدَهُمْ . ثُمَّ الْتَفَتَ ، فَنَظَرَ إِلَيَّ ، فَقَالَ : وَيْحَهَا لَوْ تَسْتَطِيعُ مَا فَعَلَتْ  .","","Musnad Abi Ya'la al-Mawsili 4620","","عائشة بنت أبي بكر الصديق عن عبد الله بن عامر بن ربيعة العنزي عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن شريك بن عبد الله النخعي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4621","265 - (  4621  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ :  أَنَّ  سَوْدَةَ  لَمَّا كَبِرَتْ ، وَهَبَتْ يَوْمَهَا  لِعَائِشَةَ  قَالَتْ :  وَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْسِمُ لِي يَوْمِي وَيَوْمَهَا ، وَكَانَتْ أَوَّلَ امْرَأَةٍ تَزَوَّجَتْ  .         [8/88]","","Musnad Abi Ya'la al-Mawsili 4621","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن شريك بن عبد الله النخعي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4622","266 - (  4622  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  خَيْثَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  أَمَرَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ أُدْخِلَ امْرَأَةً عَلَى زَوْجِهَا ، وَلَمْ تَقْبِضْ مِنْ صَدَاقِهَا شَيْئًا  الْحَدِيثَ .","","Musnad Abi Ya'la al-Mawsili 4622","","عائشة بنت أبي بكر الصديق عن خيثمة بن عبد الرحمن الجعفي عن طلحة بن مصرف الهمداني عن منصور بن المعتمر عن شريك بن عبد الله النخعي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4623","267 - (  4623  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُؤْتَى بِالصِّبْيَانِ يَدْعُو لَهُمْ ، وَيُبَرِّكُ عَلَيْهِمْ  ، فَأُتِيَ بِصَبِيٍّ ، فَبَالَ عَلَيْهِ ، فَدَعَا بِمَاءٍ فَأَتْبَعَهُ إِيَّاهُ  .         [8/89]","","Musnad Abi Ya'la al-Mawsili 4623","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن شريك بن عبد الله النخعي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4624","268 - (  4624  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي الرَّكْعَتَيْنِ قَبْلَ الْفَجْرِ ، وَيُخَفِّفُهُمَا  حَتَّى أَرَى أَنَّهُ  مَا قَرَأَ فِيهَا شَيْئًا إِلَّا بِفَاتِحَةِ الْكِتَابِ ، أَوْ مَا قَرَأَ فَاتِحَةَ الْكِتَابِ  .","","Musnad Abi Ya'la al-Mawsili 4624","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن يحيى بن سعيد الأنصاري عن شريك بن عبد الله النخعي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4625","269 - (  4625  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  أَبُو عَقِيلٍ يَحْيَى بْنُ الْمُتَوَكِّلِ ،  عَنْ  بُهَيَّةَ ،         [8/90]      أَنَّهَا سَمِعَتِ  امْرَأَةً  تَسْأَلُ عَائِشَةَ عَنِ امْرَأَةٍ فَسَدَ حَيْضُهَا ، فَلَا تَدْرِي كَيْفَ تُصَلِّي ، فَقَالَتْ لَهَا  عَائِشَةُ  : سَأَلْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي امْرَأَةٍ فَسَدَ حَيْضُهَا ، وَأُهَرِيقَتْ دَمًا ، فَلَا تَدْرِي كَيْفَ تُصَلِّي ،  فَأَمَرَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ آمُرَهَا فَلْتَنْظُرْ قَدْرَ مَا كَانَتْ تَحِيضُ فِي كُلِّ شَهْرٍ مَرَّةً  ، وَحَيْضُهَا مُسْتَقِيمٌ ، فَلْتَقْعُدْ مِثْلَ ذَلِكَ مِنَ اللَّيَالِي وَالْأَيَّامِ ، ثُمَّ لِتَدَعِ الصَّلَاةَ فِيهِنَّ وَتُقَدِّرْهُنَّ ، ثُمَّ لِتَغْتَسِلْ طُهْرَهَا ، ثُمَّ  تَسْتَثْفِرْ  بِثَوْبٍ ، ثُمَّ تُصَلِّي ، فَإِنِّي أَرْجُو أَنَّ هَذَا مِنَ الشَّيْطَانِ ، وَأَنْ يُذْهِبَهُ اللهُ عَنْهَا إِنْ شَاءَ اللهُ ، قَالَتْ : فَأَمَرْتُهَا بِفِعْلِهِ ، فَأَذْهَبَ اللهُ عَنْهَا ، فَمُرِي صَاحِبَتَكِ بِذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 4625","","عائشة بنت أبي بكر الصديق عن بهية مولاة أبي بكر عن يحيى بن المتوكل الحذاء عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4626","270 - (  4626  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ الْكِنْدِيُّ ،  حَدَّثَنَا  أَبُو حَفْصٍ عُمَرُ ،  عَنْ  سُلَيْمَانَ الشَّيْبَانِيِّ ،  عَنْ  عَلِيِّ بْنِ زَيْدِ بْنِ جُدْعَانَ ،  عَنْ  جَدَّتِهِ  ،         [8/91]      عَنْ  عَائِشَةَ أَنَّهَا قَالَتْ :  لَقَدْ أُعْطِيتُ تِسْعًا مَا أُعْطِيَتْهَا امْرَأَةٌ إِلَّا  مَرْيَمَ بِنْتَ عِمْرَانَ  ؛ لَقَدْ نَزَلَ  جِبْرِيلُ  بِصُورَتِي فِي رَاحَتِهِ حَتَّى أَمَرَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَتَزَوَّجَنِي ، وَلَقَدْ تَزَوَّجَنِي بِكْرًا وَمَا تَزَوَّجَ بِكْرًا غَيْرِي ، وَلَقَدْ قُبِضَ وَرَأْسُهُ لَفِي حِجْرِي ، وَلَقَدْ قَبَرْتُهُ فِي بَيْتِي ، وَلَقَدْ حَفَّتِ الْمَلَائِكَةُ بَيْتِي ، وَإِنْ كَانَ الْوَحْيُ لَيَنْزِلُ عَلَيْهِ وَهُوَ فِي أَهْلِهِ فَيَتَفَرَّقُونَ عَنْهُ ، وَإِنْ كَانَ لَيَنْزِلُ عَلَيْهِ وَإِنِّي لَمَعَهُ فِي لِحَافِهِ ، وَإِنِّي لَابْنَةُ خَلِيفَتِهِ وَصِدِّيقِهِ ، وَلَقَدْ نَزَلَ عُذْرِي مِنَ السَّمَاءِ ، وَلَقَدْ خُلِقْتُ طَيِّبَةً وَعِنْدَ طَيِّبٍ ، وَلَقَدْ وُعِدْتُ مَغْفِرَةً وَرِزْقًا كَرِيمًا  .","","Musnad Abi Ya'la al-Mawsili 4626","","عائشة بنت أبي بكر الصديق عن أمية بنت عبد الله ، ويقال عن علي بن زيد بن جدعان عن سليمان بن فيروز الشيباني عن عمر بن عبد الرحمن بن قيس عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4627","271 - (  4627  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ ،  عَنِ  الْأَسْوَدِ بْنِ يَزِيدَ ،  عَنْ  عَائِشَةَ قَالَتْ :  سَأَلْتُ عَنِ الْجِدَارِ ، أَمِنَ  الْبَيْتِ  هُوَ ؟ قَالَ : نَعَمْ ، فَقُلْتُ : فَمَا لَهُمْ لَمْ يُدْخِلُوهُ فِي  الْبَيْتِ  ؟ قَالَ :  إِنَّ قَوْمَكِ         [8/92]      قَصَّرَتْ بِهِمُ النَّفَقَةُ  ، قَالَتْ : فَقُلْتُ لَهُ : مَا  شَأْنُ  بَابِهِ مُرْتَفِعٌ ؟ قَالَ : فَعَلَ ذَلِكَ قَوْمُكِ لِيُدْخِلُوا مَنْ شَاءُوا ، وَلَوْلَا أَنَّ قَوْمَكِ حَدِيثٌ عَهْدُهُمْ بِجَاهِلِيَّةٍ فَأَخَافُ أَنْ تُنْكِرَ قُلُوبُهُمْ ، لَنَظَرْتُ أَنْ أُدْخِلَ  الْحِجْرَ  فِي  الْبَيْتِ  ، وَأَنْ أُلْزِقَ بَابَهُ بِالْأَرْضِ  .","","Musnad Abi Ya'la al-Mawsili 4627","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن أشعث بن أبي الشعثاء عن سلام بن سليم الحنفي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4628","272 - (  4628  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  بِشْرُ بْنُ السَّرِيِّ ،  عَنْ  سَلِيمِ بْنِ حَيَّانَ ،  عَنْ  سَعِيدِ بْنِ مِينَاءَ ،  عَنِ  ابْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ لَهَا :  لَوْلَا  حِدْثَانُ  قَوْمِكِ بِالْجَاهِلِيَّةِ ، لَأَلْزَقْتُ بِالْأَرْضِ  ، وَزِدْتُ فِي  الْبَيْتِ  مِنَ الْحِجْرِ سِتَّةَ أَذْرُعٍ ، وَجَعَلْتُ لَهَا بَابًا شَرْقِيًّا  .","","Musnad Abi Ya'la al-Mawsili 4628","","عائشة بنت أبي بكر الصديق عن عبد الله بن الزبير عن سعيد بن مينا الحجازي عن سليم بن حيان بن بسطام الهذلي عن بشر بن السري عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4629","273 - (  4629  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  يَحْيَى ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  أَخْبَرَنِي  أَبِي ،  عَنْ  عَائِشَةَ ،  أَنَّ  أُمَّ حَبِيبَةَ  ،  وَأُمَّ سَلَمَةَ  ، ذَكَرَتَا كَنِيسَةً  بِالْحَبَشَةِ  رَأَيْنَهَا فِيهَا تَصَاوِيرُ ، فَذَكَرَتَا ذَلِكَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  إِنَّ أُولَئِكَ إِذَا كَانَ فِيهِمُ الرَّجُلُ الصَّالِحُ فَمَاتَ ، بَنَوْا عَلَى قَبْرِهِ         [8/93]      مَسْجِدًا  ، وَصَوَّرُوا فِيهِ تِلْكَ الصُّوَرَ ، أُولَئِكَ شِرَارُ  الْخَلْقِ  عِنْدَ اللهِ يَوْمَ الْقِيَامَةِ  .","","Musnad Abi Ya'la al-Mawsili 4629","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن يحيى القطان عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4630","274 - (  4630  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  سَالِمٍ أَبِي النَّضْرِ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  إِذَا كُنْتُ مُسْتَيْقِظَةً حَدَّثَنِي ، وَإِذَا كُنْتُ نَائِمَةً اضْطَجَعَ  ،  يَعْنِي : إِذَا أَوْتَرَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .         [8/94]","","Musnad Abi Ya'la al-Mawsili 4630","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن سالم بن أبي أمية التيمي عن سفيان بن عيينة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4631","275 - (  4631  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  مَيْمُونٍ أَبِي حَمْزَةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ دَعَا عَلَى مَنْ ظَلَمَهُ فَقَدِ انْتَصَرَ  .","","Musnad Abi Ya'la al-Mawsili 4631","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن ميمون القصاب عن سلام بن سليم الحنفي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4632","276 - (  4632  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  يَحْيَى ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  أَخْبَرَنِي  أَبِي ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُفْضِي إِلَيَّ رَأْسَهُ وَهُوَ  مُجَاوِرٌ  فِي الْمَسْجِدِ  ، فَأُرَجِّلُهُ وَأَنَا حَائِضٌ  .         [8/95]","","Musnad Abi Ya'la al-Mawsili 4632","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن يحيى القطان عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4633","277 - (  4633  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  ابْنِ أَبِي لَبِيدٍ ،  عَنْ  أَبِي سَلَمَةَ قَالَ :  سَأَلْتُ  عَائِشَةَ ، عَنْ صِيَامِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ :  كَانَ يَصُومُ حَتَّى نَقُولَ قَدْ صَامَ ، وَيُفْطِرُ حَتَّى نَقُولَ قَدْ أَفْطَرَ  ، وَلَمْ أَرَهُ صَامَ مِنْ شَهْرٍ قَطُّ أَكْثَرَ مِنْ صِيَامِهِ مِنْ شَعْبَانَ ، كَانَ يَصُومُ شَعْبَانَ كُلَّهُ ، كَانَ يَصُومُ شَعْبَانَ إِلَّا قَلِيلًا  .         [8/96]","","Musnad Abi Ya'la al-Mawsili 4633","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن عبد الله بن أبي لبيد مولى الأخنس بن شريق عن سفيان بن عيينة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4634","278 - (  4634  ) -  أَخْبَرَنَا  أَبُو يَعْلَى أَحْمَدُ بْنُ عَلِيِّ بْنِ الْمُثَنَّى الْمَوْصِلِيُّ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ ،  عَنْ  أَبِيهِ ،  عَنْ  مَسْرُوقٍ قَالَ :  قَالَتْ  عَائِشَةُ :  سَأَلْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الِالْتِفَاتِ فِي         [8/97]      الصَّلَاةِ ، فَقَالَ :  اخْتِلَاسٌ يَخْتَلِسُهُ الشَّيْطَانُ مِنْ صَلَاةِ الْعَبْدِ  .","","Musnad Abi Ya'la al-Mawsili 4634","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن سليم بن أسود المحاربي عن أشعث بن أبي الشعثاء عن سلام بن سليم الحنفي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4635","279 - (  4635  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  أَخْبَرَنِي  أَبِي ،  عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْحُمَّى مِنْ  فَيْحِ  جَهَنَّمَ ،  فَأَبْرِدُوهَا بِالْمَاءِ  .         [8/98]","","Musnad Abi Ya'la al-Mawsili 4635","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن يحيى القطان عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4636","280 - (  4636  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  يَحْيَى ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  أَخْبَرَنِي  أَبِي  ،  عَنْ  عَائِشَةَ ،  أَنَّ  هِنْدَ بِنْتَ عُتْبَةَ  ، قَالَتْ : يَا رَسُولَ اللهِ ، إِنَّ  أَبَا سُفْيَانَ  رَجُلٌ  شَحِيحٌ  ، وَلَيْسَ يُعْطِينِي مَا يَكْفِينِي وَوَلَدِي ، وَأَنَا آخُذُ مِنْهُ ، وَلَا يَعْلَمُ ، فَقَالَ :  خُذِي مَا يَكْفِيكِ وَوَلَدَكِ بِالْمَعْرُوفِ  .         [8/99]","","Musnad Abi Ya'la al-Mawsili 4636","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن يحيى القطان عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4637","281 - (  4637  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  سُمَيٍّ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُدْرِكُهُ الصُّبْحُ وَهُوَ  جُنُبٌ  ،         [8/100]      ثُمَّ يُصْبِحُ صَائِمًا  .","","Musnad Abi Ya'la al-Mawsili 4637","","عائشة بنت أبي بكر الصديق عن أبو بكر بن عبد الرحمن راهب قريش عن سمي المخزومي عن سفيان بن عيينة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4638","282 - (  4638  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  أَخْبَرَنِي  أَبِي  ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ يَوْمُ عَاشُورَاءَ يَوْمًا تَصُومُهُ  قُرَيْشٌ  فِي الْجَاهِلِيَّةِ ، فَكَانَ رَسُولُ اللهِ يَصُومُهُ  ، فَلَمَّا قَدِمَ  الْمَدِينَةَ  صَامَهُ ، وَأَمَرَ بِصِيَامِهِ ، فَلَمَّا نَزَلَ صَوْمُ رَمَضَانَ كَانَ رَمَضَانُ هُوَ الْفَرِيضَةَ ، وَتَرَكَ عَاشُورَاءَ ، فَكَانَ مَنْ شَاءَ صَامَهُ ، وَمَنْ شَاءَ لَمْ يَصُمْهُ  .         [8/101]","","Musnad Abi Ya'la al-Mawsili 4638","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن يحيى القطان عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4639","283 - (  4639  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  كَثِيرُ بْنُ هِشَامٍ ،  حَدَّثَنَا  جَعْفَرُ بْنُ بُرْقَانَ ،  حَدَّثَنَا  الزُّهْرِيُّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كُنْتُ أَنَا  وَحَفْصَةُ  صَائِمَتَيْنِ ، فَعَرَضَ لَنَا طَعَامٌ اشْتَهَيْنَاهُ ، فَأَكَلْنَا مِنْهُ ، فَجَاءَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَبَدَرَتْنِي إِلَيْهِ  حَفْصَةُ  وَكَانَتِ ابْنَةَ  أَبِيهَا  ، فَقَالَتْ : يَا نَبِيَّ اللهِ ، إِنَّا كُنَّا صَائِمَتَيْنِ الْيَوْمَ ، فَعَرَضَ لَنَا طَعَامٌ اشْتَهَيْنَاهُ ، فَأَكَلْنَا مِنْهُ ، فَقَالَ :  اقْضِيَا يَوْمًا آخَرَ  .         [8/102]             [8/103]","","Musnad Abi Ya'la al-Mawsili 4639","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن جعفر بن برقان الكلابي عن كثير بن هشام الكلابي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4640","284 - (  4640  ) -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  حَدَّثَنَا  مُسْلِمُ بْنُ خَالِدٍ الزَّنْجِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ السَّائِبِ بْنِ بَرَكَةَ ،  عَنْ  أُمِّهِ  أَنَّهَا  طَافَتْ مَعَ عَائِشَةَ ثَلَاثَةَ أَسْبُعٍ ، كُلَّمَا طَافَتْ سُبُعًا تَعَوَّذَتْ بَيْنَ الْبَابِ  وَالْحِجْرِ  حَتَّى أَكْمَلَتْ لِكُلِّ سُبُعٍ رَكْعَتَيْنِ  وَمَعَهَا نِسْوَةٌ ، فَذَكَرْنَ  حَسَّانَ بْنَ ثَابِتٍ  فَوَقَعْنَ فِيهِ وَسَبَبْنَهُ ، فَقَالَتْ : لَا تَسُبُّوهُ قَدْ أَصَابَهُ مَا قَالَ اللهُ : لَهُ عَذَابٌ أَلِيمٌ .         [8/104]      وَقَدْ عَمِيَ ، وَاللهِ إِنِّي أَرْجُو أَنْ يُدْخِلَهُ اللهُ الْجَنَّةَ بِكَلِمَاتٍ قَالَهُنَّ  لِمُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ يَقُولُ  لِأَبِي سُفْيَانَ بْنِ الْحَارِثِ  :  وَعِرْضِي","","Musnad Abi Ya'la al-Mawsili 4640","","عائشة بنت أبي بكر الصديق عن أم محمد بن السائب بن بركة عن محمد بن السائب بن بركة الحجازي عن مسلم بن خالد الزنجي عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4641","285 - (  4641  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  مُعَاذُ بْنُ هِشَامٍ ،  حَدَّثَنِي  أَبِي ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  عِمْرَانَ بْنِ حِطَّانَ ، أَنَّ عَائِشَةَ أُمَّ الْمُؤْمِنِينَ ،  حَدَّثَتْهُ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمْ يَكُنْ يَتْرُكُ فِي بَيْتِهِ شَيْئًا فِيهِ  تَصْلِيبٌ  إِلَّا نَقَضَهُ  .         [8/105]      قَالَ : فَحَدَّثَنِي مَرَّةً قَالَ :  بَيْنَمَا أَنَا أَطُوفُ  بِالْبَيْتِ  مَعَ أُمِّ الْمُؤْمِنِينَ ، إِذْ فُطِنَ لَهَا ، فَقَالَتْ : أَعْطِنِي ثَوْبًا  ، فَأَعْطَيْتُهَا ثَوْبًا ، فَقَالَتْ : فِيهِ  تَصْلِيبٌ  ؟ قُلْتُ : نَعَمْ ، فَأَبَتْ أَنْ تَلْبَسَهُ  .","","Musnad Abi Ya'la al-Mawsili 4641","","عائشة بنت أبي بكر الصديق عن عمران بن حطان السدوسي عن يحيى بن أبي كثير عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4642","286 - (  4642  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  أَخْبَرَنِيهِ  أُسَامَةُ بْنُ زَيْدٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ .  قَالَ :  وَحَدَّثَنِي  أُسَامَةُ بْنُ زَيْدٍ ، أَنَّ حَفْصَ بْنَ عُبَيْدِ اللهِ بْنِ أَنَسٍ  حَدَّثَهُ  قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ ، يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَلَا أُخْبِرُكُمْ بِصَلَاةِ الْمُنَافِقِ ؟ يَدَعُ الْعَصْرَ حَتَّى إِذَا كَانَتْ  بَيْنَ  قَرْنَيْ  شَيْطَانٍ  - أَوْ عَلَى  قَرْنَيْ  شَيْطَانٍ  - قَامَ فَنَقَرَهُنَّ كَنَقَرَاتِ الدِّيكِ ،         [8/106]      لَا يَذْكُرُ اللهَ فِيهِنَّ إِلَّا قَلِيلًا  .","","Musnad Abi Ya'la al-Mawsili 4642","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن أسامة بن زيد الليثي المدني عن عبد الله بن وهب المصري عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4643","287 - (  4643  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ عُمَرَ بْنِ شَقِيقٍ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  أَبِي لُبَابَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْرَأُ كُلَّ لَيْلَةٍ "" تَنْزِيلُ "" السَّجْدَةَ ، وَ "" الزُّمَرَ  "" .","","Musnad Abi Ya'la al-Mawsili 4643","","عائشة بنت أبي بكر الصديق عن مروان الوراق مولى عائشة بنت أبي بكر عن حماد بن زيد عن الحسن بن عمر بن شقيق الجرمي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4644","288 - (  4644  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ عُمَرَ بْنِ شَقِيقٍ ،  حَدَّثَنَا  جَعْفَرُ         [8/107]      بْنُ سُلَيْمَانَ ،  عَنْ  هَارُونَ الْأَعْوَرِ ،  عَنْ  بُدَيْلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْرَأُ هَذَا الْحَرْفَ :         {      فَرَوْحٌ وَرَيْحَانٌ         }      .","","Musnad Abi Ya'la al-Mawsili 4644","","عائشة بنت أبي بكر الصديق عن عبد الله بن شقيق العقيلي عن بديل بن ميسرة العقيلي عن هارون بن موسى العتكي عن جعفر بن سليمان الضبعي عن الحسن بن عمر بن شقيق الجرمي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4645","289 - (  4645  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ،  حَدَّثَنَا  عَبْدُ الْوَهَّابِ بْنُ عَبْدِ الْمَجِيدِ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ، أَنَّ عُرْوَةَ بْنَ الزُّبَيْرِ  حَدَّثَهُ  ،  عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتْ :  إِنَّ أَوَّلَ مَا فُرِضَتِ الصَّلَاةُ فِي السَّفَرِ وَالْحَضَرِ رَكْعَتَيْنِ ، فَزِيدَ فِي الْحَضَرِ  ، وَأُقِرَّتْ فِي السَّفَرِ كَمَا هِيَ  .","","Musnad Abi Ya'la al-Mawsili 4645","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن يحيى بن سعيد الأنصاري عن عبد الوهاب بن عبد المجيد الثقفي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4646","290 - (  4646  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  هِشَامٍ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ قَالَتْ :  قَدِمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ سَفَرٍ ، فَعَلَّقْتُ عَلَى بَابِي دُرْنُوكًا فِيهِ الْخَيْلُ ذَوَاتُ الْأَجْنِحَةِ  ، فَأَمَرَنِي فَنَزَعْتُهُ  .","","Musnad Abi Ya'la al-Mawsili 4646","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن سفيان بن عيينة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4647","291 - (  4647  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  حَدَّثَنَا  شُعْبَةُ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْأَصْبَهَانِيِّ قَالَ :  سَمِعْتُ  مُجَاهِدَ بْنَ وَرْدَانَ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ،  أَنَّ مَوْلًى لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تُوُفِّيَ ، فَجِيءَ بِمَالِهِ         [8/108]      إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  هَاهُنَا أَحَدٌ مِنْ أَهْلِ قَرَابَتِهِ ؟  قَالُوا : نَعَمْ ، فَأَعْطَاهُمْ مَالَهُ  .","","Musnad Abi Ya'la al-Mawsili 4647","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن مجاهد بن وردان المدني عن عبد الرحمن بن عبد الله بن الأصبهاني عن شعبة بن الحجاج عن عثمان بن عمر بن فارس عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4648","292 - (  4648  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  مُسْلِمُ بْنُ خَالِدٍ ،  حَدَّثَنِي  ابْنُ خُثَيْمٍ ،  عَنْ  يُوسُفَ بْنِ مَاهَكَ ،  عَنْ  حَفْصَةَ بِنْتِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ ،  عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتْ :  أَمَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِالْعَقِيقَةِ  عَنِ         [8/109]      الْغُلَامِ شَاتَانِ  مُكَافِئَتَانِ  ، وَعَنِ الْجَارِيَةِ شَاةٌ  .","","Musnad Abi Ya'la al-Mawsili 4648","","عائشة بنت أبي بكر الصديق عن حفصة بنت عبد الرحمن بن أبي بكر الصديق عن يوسف بن ماهك الفارسي عن عبد الله بن عثمان بن خثيم عن مسلم بن خالد الزنجي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4649","293 - (  4649  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  مَعْمَرٌ قَالَ :  سَمِعْتُ  لَيْثًا ،  يُحَدِّثُ عَنْ  شَهْرِ بْنِ حَوْشَبَ ،  أَنَّ  رَجُلًا ، قَالَ لِعَائِشَةَ : إِنَّ أَحَدَنَا يُحَدِّثُ نَفْسَهُ بِشَيْءٍ ، لَوْ تَكَلَّمَ بِهِ ذَهَبَتْ آخِرَتُهُ  ، وَلَوْ ظَهَرَ عَلَيْهِ لَقُتِلَ قَالَ : فَكَبَّرَتْ ثَلَاثًا  ، ثُمَّ قَالَتْ : سُئِلَ عَنْهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَكَبَّرَ ثَلَاثًا ، ثُمَّ قَالَ :  إِنَّمَا يُخْتَبَرُ بِهَذَا الْمُؤْمِنُ  .         [8/110]","","Musnad Abi Ya'la al-Mawsili 4649","","عائشة بنت أبي بكر الصديق عن شهر بن حوشب عن ليث بن أبي سليم عن معمر بن راشد عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4650","294 - (  4650  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي الزِّنَادِ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ :  أَنَّ صَلَاةَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ اللَّيْلِ ثَمَانُ رَكَعَاتٍ  ، سِوَى  الْوِتْرِ  .         [8/111]             [8/112]             [8/113]             [8/114]             [8/115]","","Musnad Abi Ya'la al-Mawsili 4650","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الرحمن بن أبي الزناد عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4651","295 - (  4651  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي الزِّنَادِ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ،  أَنَّهَا  كَانَتْ عِنْدَ عَائِشَةَ  امْرَأَةٌ مِنْ بَنِي أَسَدٍ  ، فَدَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : مَنْ هَذِهِ ؟ قَالَتْ  عَائِشَةُ  : هَذِهِ فُلَانَةُ ، وَلَا تَنَامُ تَذْكُرُ مِنْ صَلَاتِهَا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  عَلَيْكُمْ مَا تُطِيقُونَ ، فَإِنَّ اللهَ لَا  يَمَلُّ  حَتَّى  تَمَلُّوا  ،  قَالَتْ  عَائِشَةُ : أَحَبُّ الدِّينِ الَّذِي يَدُومُ عَلَيْهِ صَاحِبُهُ .         [8/116]","","Musnad Abi Ya'la al-Mawsili 4651","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الرحمن بن أبي الزناد عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4652","296 - (  4652  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  شُجَاعُ بْنُ الْوَلِيدِ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  يَحْيَى بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَائِشَةَ قَالَتْ :  خَرَجْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى أَنْوَاعٍ ثَلَاثَةٍ : مِنَّا مَنْ أَهَلَّ بِحَجَّةٍ وَعُمْرَةً مَعًا  ، وَمِنَّا مَنْ أَهَلَّ بِحَجٍّ مُفْرَدٍ ، وَمِنَّا مَنْ أَهَلَّ بِعُمْرَةٍ مُفْرَدَةٍ .  فَمَنْ كَانَ أَهَلَّ بِحَجٍّ وَعُمْرَةٍ مَعًا لَمْ يَحْلِلْ مِنْ شَيْءٍ حَرُمَ عَلَيْهِ حَتَّى يَقْضِيَ  مَنَاسِكَ  الْحَجِّ  ، وَمَنْ أَهَلَّ بِحَجٍّ مُفْرَدٍ لَمْ يَحْلِلْ مِنْ شَيْءٍ مِمَّا حَرُمَ مِنْهُ حَتَّى يَقْضِيَ  مَنَاسِكَ  الْحَجِّ  ، وَمَنْ أَهَلَّ بِعُمْرَةٍ مُفْرَدَةً فَطَافَ  بِالْبَيْتِ  وَسَعَى بَيْنَ  الصَّفَا  وَالْمَرْوَةِ  أَحَلَّ  مِمَّا حَرُمَ مِنْهُ حَتَّى يَسْتَقْبِلَ حَجًّا  .         [8/117]","","Musnad Abi Ya'la al-Mawsili 4652","","عائشة بنت أبي بكر الصديق عن يحيى بن عبد الرحمن بن حاطب اللخمي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن شجاع بن الوليد السكوني عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4653","297 - (  4653  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  عُمَرُ بْنُ عَلِيٍّ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ ،  أَنَّهُ قِيلَ لَهَا : مَا كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَصْنَعُ فِي أَهْلِهِ ؟ قَالَتْ :  كَانَ يَخِيطُ ثَوْبَهُ  وَيَخْصِفُ  نَعْلَهُ  ، أَوْ نَحْوَ ذِي  .         [8/118]","","Musnad Abi Ya'la al-Mawsili 4653","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عمر بن علي بن عطاء عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4654","298 - (  4654  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  عُمَرَ بْنِ عَلِيٍّ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ ،  أَنَّ  حَمْزَةَ بْنَ عَمْرٍو الْأَسْلَمِيَّ  ، سَأَلَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : إِنِّي أُسَافِرُ ، أَفَأَصُومُ ؟ قَالَ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Musnad Abi Ya'la al-Mawsili 4654","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عمر بن علي بن عطاء عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4655","299 - (  4655  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  رِبْعِيٍّ ،  عَنِ  الطُّفَيْلِ أَخِي عَائِشَةَ مِنْ أُمِّهَا ،  عَنْ  عَائِشَةَ  ، فِيمَا يَعْلَمُ  عُثْمَانُ  ،  أَنَّ يَهُودِيًّا رَأَى فِي الْمَنَامِ ، نِعْمَ  الْقَوْمُ  أُمَّةُ  مُحَمَّدٍ  ، لَوْلَا أَنَّهُمْ يَقُولُونَ : مَا شَاءَ اللهُ وَشَاءَ  مُحَمَّدٌ  قَالَ : فَذُكِرَ ذَلِكَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  لَا تَقُولُوا :         [8/119]      مَا شَاءَ اللهُ وَشَاءَ  مُحَمَّدٌ  ، قُولُوا : مَا شَاءَ اللهُ وَحْدَهُ  .","","Musnad Abi Ya'la al-Mawsili 4655","","عائشة بنت أبي بكر الصديق عن الطفيل بن سخبرة الأزدي عن ربعي بن حراش العبسي عن عبد الملك بن عمير القبطي عن شعبة بن الحجاج عن عثمان بن عمر بن فارس عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4656","300 - (  4656  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ ، إِنْ شَاءَ اللهُ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  أَبْرِدُوا  بِالظُّهْرِ فِي الْحَرِّ  ،         [8/120]      قَالَ أَبُو يَعْلَى :  هَكَذَا حَدَّثَنَا  عَبْدُ الْأَعْلَى  بِشَكٍّ  .","","Musnad Abi Ya'la al-Mawsili 4656","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن داود الخريبي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4657","301 - (  4657  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ قَالَ :  سَمِعْتُ  هِشَامَ بْنَ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  فِيمَا يَظُنُّ  أَبُو يَحْيَى  ،  عَنْ  عَائِشَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَوْتَرَ بِخَمْسِ رَكَعَاتٍ  ، وَلَا يَجْلِسُ إِلَّا فِي آخِرِهَا ، قَامَ فِيهَا كُلِّهَا إِلَّا الْخَامِسَةَ  ، وَصَفَهُ  ابْنُ دَاوُدَ  .","","Musnad Abi Ya'la al-Mawsili 4657","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن داود الخريبي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4658","302 - (  4658  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  كُنْتُ أَفْتِلُ قَلَائِدَ هَدْيِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَيَبْعَثُ بِهَا وَيُقِيمُ  ، فَيَأْتِي مَا يَأْتِي الْحَلَالُ قَبْلَ أَنْ يَبْلُغَ الْهَدْيُ  مَكَّةَ  .","","Musnad Abi Ya'la al-Mawsili 4658","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن الشعبي عن داود بن أبي هند عن يزيد بن هارون عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4659","303 - (  4659  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  يَزِيدُ بْنُ         [8/121]      هَارُونَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ قَالَتْ :  فَتَلْتُ قَلَائِدَ هَدْيِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِيَدَيَّ ، فَبَعَثَ بِهَا وَأَقَامَ  ، فَمَا تَرَكَ شَيْئًا كَانَ يَصْنَعُهُ  .","","Musnad Abi Ya'la al-Mawsili 4659","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن يحيى بن سعيد الأنصاري عن يزيد بن هارون عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4660","304 - (  4660  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  حَدَّثَنَا  يُونُسُ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ لِآلِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَحْشٌ ، فَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا خَرَجَ لَعِبَ وَاشْتَدَّ  ، وَأَقْبَلَ وَأَدْبَرَ ، فَإِذَا  أَحَسَّ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَدْ دَخَلَ ، رَبَضَ فَلَمْ  يَتَرَمْرَمْ  مَا دَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْبَيْتِ ، مَخَافَةَ أَنْ يُؤْذِيَهُ  .","","Musnad Abi Ya'la al-Mawsili 4660","","عائشة بنت أبي بكر الصديق عن مجاهد بن جبر المخزومي عن يونس بن أبي إسحاق عن محمد بن عبد الله بن الزبير عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4661","305 - (  4661  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عُثَيْمٍ أَبَا زَرٍّ الْحَضْرَمِيَّ قَالَ :  حَدَّثَنِي  عُثَيْمٌ ،  عَنْ  عُثْمَانَ بْنِ عَطَاءٍ الْخُرَاسَانِيِّ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَتْ لَيْلَتِي مِنْ رَسُولِ         [8/122]      اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فَانْسَلَّ  ، فَظَنَنْتُ أَنَّمَا  انْسَلَّ  إِلَى بَعْضِ نِسَائِهِ ، فَخَرَجْتُ  غَيْرَى  ، فَإِذَا أَنَا بِهِ سَاجِدٌ كَالثَّوْبِ الطَّرِيحِ ، فَسَمِعْتُهُ يَقُولُ :  سَجَدَ لَكَ سَوَادِي وَخَيَالِي ، وَآمَنَ بِكَ فُؤَادِي ، رَبِّ هَذِهِ يَدِي وَمَا جَنَيْتُ عَلَى نَفْسِي  ، يَا عَظِيمُ تُرْجَى لِكُلِّ عَظِيمٍ ، فَاغْفِرِ الذَّنْبَ الْعَظِيمَ ، قَالَتْ : فَرَفَعَ رَأْسَهُ ، فَقَالَ : مَا أَخْرَجَكِ ؟ قَالَتْ : ظَنٌّ ظَنَنْتُهُ قَالَ : إِنَّ بَعْضَ الظَّنِّ إِثْمٌ ، وَاسْتَغْفِرِي اللهَ ، إِنَّ  جِبْرِيلَ  أَتَانِي فَأَمَرَنِي أَنْ أَقُولَ هَذِهِ الْكَلِمَاتِ الَّتِي سَمِعْتِ ، فَقُولِيهَا فِي سُجُودِكِ ، فَإِنَّهُ مَنْ قَالَهَا لَمْ يَرْفَعْ رَأْسَهُ حَتَّى يُغْفَرَ  أَظُنُّهُ قَالَ : لَهُ  .         [8/123]","","Musnad Abi Ya'la al-Mawsili 4661","","عائشة بنت أبي بكر الصديق عن عطاء الخراساني عن عثمان بن عطاء الخراساني عن عثيم عن محمد بن عثيم النجرانى عن معتمر بن سليمان عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4662","306 - (  4662  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  مِسْعَرٍ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  مَا  أَلْفَاهُ  السَّحَرَ عِنْدِي ، إِلَّا نَائِمًا  . قَالَ أَبُو يَعْلَى :  تَعْنِي : النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .         [8/124]","","Musnad Abi Ya'la al-Mawsili 4662","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن مسعر بن كدام عن سفيان بن عيينة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4663","307 - (  4663  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  عَبْدُ الْوَهَّابِ قَالَ :  سَمِعْتُ  يَحْيَى بْنَ سَعِيدٍ ،  أَخْبَرَنِي  عَبْدُ الرَّحْمَنِ بْنُ الْقَاسِمِ ، أَنَّ مُحَمَّدَ بْنَ جَعْفَرِ بْنِ الزُّبَيْرِ ،  أَخْبَرَهُ  أَنَّ عَبَّادَ بْنَ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  حَدَّثَهُ  سَمِعَ  عَائِشَةَ ، تَقُولُ :  أَتَى  رَجُلٌ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ، قَدِ  احْتَرَقْتُ ،  فَسَأَلَهُ : مَا لَهُ ؟  قَالَ : أَفْطَرْتُ فِي رَمَضَانَ ، ثُمَّ إِنَّهُ جَلَسَ فَأُتِي  بِمِكْتَلٍ  عَظِيمٍ يُدْعَى  الْعَرَقَ  فِيهِ تَمْرٌ ، فَقَالَ : أَيْنَ الْمُحْتَرِقُ ؟ فَقَامَ الرَّجُلُ ، فَقَالَ :  تَصَدَّقْ  بِهِ  .","","Musnad Abi Ya'la al-Mawsili 4663","","عائشة بنت أبي بكر الصديق عن عباد بن عبد الله بن الزبير بن العوام عن محمد بن جعفر بن الزبير بن العوام عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن يحيى بن سعيد الأنصاري عن عبد الوهاب بن عبد المجيد الثقفي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4664","[8/125]      308 - (  4664  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ قَالَ :  سَمِعْتُ  لَيْثًا  يُحَدِّثُ ، عَنْ  صَاحِبٍ لَهُ ،  عَنْ  عَطَاءٍ قَالَ :  قَالَتْ  عَائِشَةُ :  ذُكِرَ الطَّاعُونُ ، فَذَكَرْتُ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  وَخْزَةٌ تُصِيبُ أُمَّتِي مِنْ أَعْدَائِهِمْ مِنَ الْجِنِّ ،  غُدَّةٌ  كَغُدَّةِ  الْإِبِلِ  ، مَنْ أَقَامَ عَلَيْهِ كَانَ مُرَابِطًا ، وَمَنْ أُصِيبَ بِهِ كَانَ شَهِيدًا ، وَمَنْ فَرَّ مِنْهُ كَالْفَارِّ مِنَ  الزَّحْفِ  .","","Musnad Abi Ya'la al-Mawsili 4664","","عائشة بنت أبي بكر الصديق عن عطاء بن أبي رباح عن صاحب ليث بن أبي سليم عن ليث بن أبي سليم عن معتمر بن سليمان عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4665","309 - (  4665  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  وَكِيعُ بْنُ         [8/126]      الْجَرَّاحِ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ فِي دُعَائِهِ : اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ عَذَابِ النَّارِ  ، وَمِنْ فِتْنَةِ الْقَبْرِ ، وَعَذَابِ الْقَبْرِ ، وَمِنْ شَرِّ الْغِنَى وَالْفَقْرِ ، وَمِنْ شَرِّ الْمَحْيَا وَالْمَمَاتِ ، وَمِنْ فِتْنَةِ  الْمَسِيحِ الدَّجَّالِ  . اللَّهُمَّ  اغْسِلْ  خَطَايَايَ بِمَاءِ  الثَّلْجِ  وَالْبَرَدِ ، وَنَقِّ قَلْبِي مِنَ الْخَطَايَا كَمَا يُنَقَّى الثَّوْبُ الْأَبْيَضُ مِنَ الدَّنَسِ ، وَبَاعِدْ بَيْنِي وَبَيْنَ خَطَايَايَ ، كَمَا بَاعَدْتَ بَيْنَ الْمَغْرِبِ وَالْمَشْرِقِ . اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْكَسَلِ ،  وَالْهَرَمِ  ،  وَالْمَغْرَمِ  ،  وَالْمَأْثَمِ  .","","Musnad Abi Ya'la al-Mawsili 4665","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن وكيع بن الجراح عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4666","310 - (  4666  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ قَالَ :  سَمِعْتُ  لَيْثًا  يُحَدِّثُ ، عَنْ  ثَابِتٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  نَاوِلِينِي  الْخُمْرَةَ  مِنَ الْمَسْجِدِ  ، قُلْتُ : إِنِّي حَائِضٌ قَالَ : لَيْسَتِ الْحَيْضَةُ بِيَدِكِ  .","","Musnad Abi Ya'la al-Mawsili 4666","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن ثابت بن عبيد الأنصاري عن ليث بن أبي سليم عن معتمر بن سليمان عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4667","311 - (  4667  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  يَزِيدُ بْنُ         [8/127]      هَارُونَ ،  حَدَّثَنَا  حُسَيْنٌ الْمُعَلِّمُ ،  عَنْ  بُدَيْلٍ ،  عَنْ  أَبِي الْجَوْزَاءِ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَفْتَتِحُ الصَّلَاةَ بِالتَّكْبِيرِ وَالْقِرَاءَةَ بِـ         {      الْحَمْدُ لِلهِ رَبِّ الْعَالَمِينَ         }      ، وَكَانَ إِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ لَمْ يَسْجُدْ حَتَّى يَسْتَوِيَ قَائِمًا ، وَكَانَ إِذَا سَجَدَ رَفَعَ رَأْسَهُ لَمْ يَسْجُدْ حَتَّى يَسْتَوِيَ جَالِسًا ، وَكَانَ يَقُولُ فِي كُلِّ رَكْعَتَيْنِ التَّحِيَّةَ ، وَكَانَ يَنْهَى عَنْ  عَقِبِ  الشَّيْطَانِ ، وَكَانَ يَنْهَانَا أَنْ يُفْرِشَ رِجْلَهُ الْيُسْرَى رِجْلَهُ الْيُمْنَى ، وَكَانَ يَخْتِمُ الصَّلَاةَ بِالتَّسْلِيمِ  .         [8/128]","","Musnad Abi Ya'la al-Mawsili 4667","","عائشة بنت أبي بكر الصديق عن أوس بن عبد الله الربعي عن بديل بن ميسرة العقيلي عن حسين المعلم عن يزيد بن هارون عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4668","312 - (  4668  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ الرَّجُلَ لَيَعْمَلُ بِعَمَلِ أَهْلِ الْجَنَّةِ ، وَإِنَّهُ لَمَكْتُوبٌ فِي الْكِتَابِ أَنَّهُ مِنْ أَهْلِ النَّارِ  ، فَإِذَا كَانَ قَبْلَ مَوْتِهِ تَحَوَّلَ فَعَمِلَ بِعَمَلِ أَهْلِ النَّارِ ، فَيَدْخُلُ النَّارَ ، وَإِنَّ الرَّجُلَ لَيَعْمَلُ بِعَمَلِ أَهْلِ النَّارِ ، وَإِنَّهُ لَمَكْتُوبٌ فِي الْكِتَابِ أَنَّهُ مِنْ أَهْلِ الْجَنَّةِ ، فَإِذَا كَانَ قَبْلَ مَوْتِهِ تَحَوَّلَ فَعَمِلَ بِعَمَلِ أَهْلِ الْجَنَّةِ ، فَدَخَلَ الْجَنَّةَ  .","","Musnad Abi Ya'la al-Mawsili 4668","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4669","313 - (  4669  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  أُمِّ مُحَمَّدٍ ،         [8/129]      عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُكْثِرُ أَنْ يَقُولَ : يَا مُقَلِّبَ الْقُلُوبِ ، ثَبِّتْ قَلْبِي عَلَى دِينِكَ وَطَاعَتِكَ  ، فَقُلْتُ : يَا رَسُولَ اللهِ ، إِنَّكَ تُكْثِرُ أَنْ تَدْعُوَ بِهَذَا فَهَلْ تَخْشَى ؟ قَالَ : وَمَا يُؤَمِّنُنِي وَقُلُوبُ الْعِبَادِ بَيْنَ إِصْبَعَيْنِ مِنْ أَصَابِعِ اللهِ ، إِذَا أَرَادَ أَنْ يُقَلِّبَ قَلْبَ عَبْدٍ قَلَّبَهُ  .","","Musnad Abi Ya'la al-Mawsili 4669","","عائشة بنت أبي بكر الصديق عن أمية بنت عبد الله ، ويقال عن علي بن زيد بن جدعان عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4670","314 - (  4670  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ عُمَرَ بْنِ شَقِيقِ بْنِ أَسْمَاءَ الْجَرْمِيُّ الْبَصْرِيُّ ،  حَدَّثَنَا  سَلَمَةُ بْنُ الْفَضْلِ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَحْيَى بْنِ عَبَّادِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتْ :  وَكَانَ مَتَاعِي فِيهِ خِفٌّ ، وَكَانَ عَلَى جَمَلٍ نَاجٍ ، وَكَانَ مَتَاعُ  صَفِيَّةَ  فِيهِ ثِقَلٌ ، وَكَانَ عَلَى جَمَلٍ ثَقَالٍ بَطِيءٍ يَتَبَطَّأُ بِالرَّكْبِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  حَوِّلُوا مَتَاعَ  عَائِشَةَ  عَلَى جَمَلِ  صَفِيَّةَ  ، وَحَوِّلُوا مَتَاعَ  صَفِيَّةَ  عَلَى جَمَلِ  عَائِشَةَ  حَتَّى يَمْضِيَ الرَّكْبُ .         [8/130]      قَالَتْ  عَائِشَةُ  : فَلَمَّا رَأَيْتُ ذَلِكَ ، قُلْتُ : يَا لَعِبَادِ اللهِ غَلَبَتْنَا هَذِهِ الْيَهُودِيَّةُ عَلَى رَسُولِ اللهِ .  قَالَتْ : فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : يَا  أُمَّ عَبْدِ اللهِ  ، إِنَّ مَتَاعَكِ كَانَ فِيهِ خَفٌّ وَكَانَ مَتَاعُ  صَفِيَّةَ  فِيهِ ثِقَلٌ ، فَأَبْطَأَ بِالرَّكْبِ ، فَحَوَّلْنَا مَتَاعَهَا عَلَى بَعِيرِكِ ، وَحَوَّلْنَا مَتَاعَكِ عَلَى بَعِيرِهَا ، قَالَتْ : فَقُلْتُ : أَلَسْتَ تَزْعُمُ أَنَّكَ رَسُولُ اللهِ ؟ قَالَتْ : فَتَبَسَّمَ قَالَ : أَوَفِي شَكٍّ أَنْتِ يَا  أُمَّ عَبْدِ اللهِ  ؟ قَالَتْ : قُلْتُ : أَلَسْتَ تَزْعُمُ أَنَّكَ رَسُولُ اللهِ ؟ أَفَهَلَا عَدَلْتَ ؟ وَسَمِعَنِي  أَبُو بَكْرٍ  وَكَانَ فِيهِ غَرْبٌ ، أَيْ حِدَّةٌ ، فَأَقْبَلَ عَلَيَّ فَلَطَمَ وَجْهِي ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : مَهْلًا يَا  أَبَا بَكْرٍ  ، فَقَالَ : يَا رَسُولَ اللهِ ، أَمَا سَمِعْتَ مَا قَالَتْ ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِنَّ  الْغَيْرَى  لَا تُبْصِرُ أَسْفَلَ الْوَادِي مِنْ أَعْلَاهُ  .","","Musnad Abi Ya'la al-Mawsili 4670","","عائشة بنت أبي بكر الصديق عن عباد بن عبد الله بن الزبير بن العوام عن يحيى بن عباد بن عبد الله بن الزبير بن العوام عن محمد بن إسحاق عن سلمة بن الفضل الأبرش عن الحسن بن عمر بن شقيق الجرمي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4671","315 - (  4671  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا         [8/131]      أَبِي ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  عُمَارَةَ ،  عَنْ  أَبِي عَطِيَّةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  إِنِّي لَأَعْلَمُ كَيْفَ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُلَبِّي ، فَكَانَتْ تُلَبِّي :  لَبَّيْكَ  اللَّهُمَّ  لَبَّيْكَ  ،  لَبَّيْكَ  لَا شَرِيكَ لَكَ  لَبَّيْكَ ،  إِنَّ الْحَمْدَ وَالنِّعْمَةَ لَكَ  .         [8/132]","","Musnad Abi Ya'la al-Mawsili 4671","","عائشة بنت أبي بكر الصديق عن مالك بن عامر الهمداني عن عمارة بن عمير التيمي عن الأعمش عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4672","316 - (  4672  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  أَبُو رَبِيعَةَ ،  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  قُلْتُ : يَا رَسُولَ اللهِ ، إِنَّ  ابْنَ جُدْعَانَ  ، كَانَ يَقْرِي الضَّيْفَ ، وَيُحْسِنُ الْجِوَارَ ، وَيَصِلُ الرَّحِمَ ، وَيَكُفُّ الْأَذَى ، فَهَلْ يَنْفَعُهُ ذَلِكَ شَيْئًا ؟ قَالَ :  لَا ، يَا  عَائِشَةُ  ، إِنَّهُ لَمْ يَقُلْ يَوْمًا قَطُّ : رَبِّ اغْفِرْ لِي يَوْمَ الدِّينِ  .","","Musnad Abi Ya'la al-Mawsili 4672","","عائشة بنت أبي بكر الصديق عن عبيد بن عمير بن قتادة الجندعي عن طلحة بن نافع العراقي عن الأعمش عن عبد الواحد بن زياد عن أبو ربيعة عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4673","317 - (  4673  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَامِرِ بْنِ زُرَارَةَ الْحَضْرَمِيُّ ،  حَدَّثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  يَحْيَى بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ ،  عَنْ  عَائِشَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَزَوَّجَهَا وَهِيَ بِنْتُ سِتِّ         [8/133]      سِنِينَ  ، وَبَنَى بِهَا وَهِيَ بِنْتُ تِسْعِ سِنِينَ ، زَوَّجَهَا إِيَّاهُ  أَبُو بَكْرٍ  .","","Musnad Abi Ya'la al-Mawsili 4673","","عائشة بنت أبي بكر الصديق عن يحيى بن عبد الرحمن بن حاطب اللخمي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يحيى بن زكريا بن أبي زائدة عن عبد الله بن عامر بن زرارة الحضرمي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4674","318 - (  4674  ) -  حَدَّثَنَا  مُحْرِزُ بْنُ عَوْنٍ ،  حَدَّثَنَا  حَسَّانُ بْنُ         [8/134]      إِبْرَاهِيمَ ،  عَنْ  يُونُسَ بْنِ يَزِيدَ ،  عَنِ  الزُّهْرِيِّ ،  أَخْبَرَنِي  عُرْوَةُ بْنُ الزُّبَيْرِ ، أَنَّ عَائِشَةَ زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَخْبَرَتْهُ  :  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قُبِضَ وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ  .         [8/135]      قَالَ : وَأَخْبَرَنِي  ابْنُ الْمُسَيِّبِ  بِذَلِكَ .","","Musnad Abi Ya'la al-Mawsili 4674","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن يونس بن يزيدالأيلي عن حسان بن إبراهيم الكرماني عن محرز بن عون الهلالي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4675","319 - (  4675  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرٌو ، أَنَّ بَكْرَ بْنَ سَوَادَةَ ،  حَدَّثَهُ  ، أَنَّ يَزِيدَ بْنَ أَبِي حَبِيبٍ  حَدَّثَهُ  ،  عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ ،  عَنْ  عَائِشَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّ  رَجُلًا  تَلَا هَذِهِ الْآيَةَ :         {      مَنْ يَعْمَلْ سُوءًا يُجْزَ بِهِ         }      فَقَالَ : إِنَّا لَنُجْزَى بِكُلِّ مَا عَمِلْنَا ؟ هَلَكْنَا إِذًا ، فَبَلَغَ ذَلِكَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  نَعَمْ ، يُجْزَى بِهِ الْمُؤْمِنُ فِي الدُّنْيَا ، فِي مُصِيبَتِهِ فِي جَسَدِهِ ، فِيمَا يُؤْذِيهِ  .         [8/136]","","Musnad Abi Ya'la al-Mawsili 4675","","عائشة بنت أبي بكر الصديق عن عبيد بن عمير بن قتادة الجندعي عن يزيد بن أبي حبيب الأزدي عن بكر بن سوادة عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4676","320 - (  4676  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ غَالِبٍ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَحِلُّ دَمُ امْرِئٍ مُسْلِمٍ إِلَّا بِإِحْدَى ثَلَاثٍ  : النَّفْسُ بِالنَّفْسِ ،  وَالثَّيِّبُ  الزَّانِي ، وَالتَّارِكُ لِدِينِهِ  .","","Musnad Abi Ya'la al-Mawsili 4676","","عائشة بنت أبي بكر الصديق عن عمرو بن غالب الهمداني عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4677","321 - (  4677  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ قَالَ :         [8/137]      جَلَسَ  أَبُو هُرَيْرَةَ  إِلَى حُجْرَةِ عَائِشَةَ وَهِيَ تُصَلِّي وَهُوَ يُحَدِّثُ وَهُوَ يَقُولُ : أَلَا تَسْمَعِي يَا رَبَّةَ الْحُجْرَةِ ؟ فَلَمَّا تَمَّتْ صَلَاتَهَا قَالَتْ : يَا  عُرْوَةُ  أَلَا تَسْمَعُ إِلَى هَذَا وَإِلَى حَدِيثِهِ ؟  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يُحَدِّثُ حَدِيثًا لَوْ عَدَّهُ الْعَادُّ لَأَحْصَاهُ  .","","Musnad Abi Ya'la al-Mawsili 4677","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن سفيان بن عيينة عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4678","322 - (  4678  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ ،  حَدَّثَنَا  أَبُو سُفْيَانَ الْمَعْمَرِيُّ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ :  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَ بِسَدِّ الْأَبْوَابِ ، إِلَّا  بَابَ  أَبِي بَكْرٍ  ، أَوْ  خَوْخَةِ  أَبِي بَكْرٍ  قَالَ : وَقَالَتْ  عَائِشَةُ  : مَا أَدْرَكْتُ أَبَوَيَّ إِلَّا وَهُمَا يَدِينَانِ هَذَا الدِّينَ  .","","Musnad Abi Ya'la al-Mawsili 4678","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن معمر بن راشد عن محمد بن حميد اليشكري عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4679","323 - (  4679  ) -  حَدَّثَنَا  أَبُو هِشَامٍ مُحَمَّدُ بْنُ يَزِيدَ بْنِ         [8/138]      رِفَاعَةَ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ سُلَيْمَانَ الرَّازِيُّ ،  حَدَّثَنَا  مُعَاوِيَةُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قَرِّبِي إِلَيْنَا  الْغَدَاءَ  الْمُبَارَكَ  ، يَعْنِي : السَّحُورَ ، وَرُبَّمَا لَمْ يَكُنْ إِلَّا تَمْرَتَيْنِ ، قَالَ  الزُّهْرِيُّ  : السَّحُورُ سُنَّةٌ  .","","Musnad Abi Ya'la al-Mawsili 4679","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن معاوية بن يحيى الصدفي عن إسحاق بن سليمان الرازي عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4680","324 - (  4680  ) -  وَعَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَيُّمَا امْرَأَةٍ وَضَعَتْ ثِيَابَهَا فِي غَيْرِ بَيْتِ  بَعْلِهَا  ، فَقَدْ هَتَكَتْ كُلَّ سِتْرٍ بَيْنَهَا وَبَيْنَ اللهِ  .         [8/139]","","Musnad Abi Ya'la al-Mawsili 4680","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن معاوية بن يحيى الصدفي عن إسحاق بن سليمان الرازي عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4681","325 - (  4681  ) -  حَدَّثَنَا  أَبُو هِشَامٍ ،  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  حَدَّثَنَا  مُجَالِدٌ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ قَالَ :  سَمِعْتُ  عَائِشَةَ تَبْكِي ، فَقُلْتُ : يَا أُمَّ الْمُؤْمِنِينَ ، مَا يُبْكِيكِ ؟ قَالَتْ : شَبِعْتُ الْيَوْمَ  ، فَذَكَرْتُ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمْ يَشْبَعْ فِي يَوْمٍ مَرَّتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 4681","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن الشعبي عن مجالد بن سعيد عن محمد بن فضيل بن غزوان عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4682","326 - (  4682  ) -  حَدَّثَنَا  أَبُو هِشَامٍ ،  حَدَّثَنَا  أَبُو عَامِرٍ ،  حَدَّثَنَا  زَمْعَةُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَيُّمَا امْرَأَةٍ نُكِحَتْ بِغَيْرِ إِذْنِ وَلِيِّهَا ، فَنِكَاحُهَا بَاطِلٌ  .","","Musnad Abi Ya'la al-Mawsili 4682","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن زمعة بن صالح الجندي عن أبو عامر العقدي عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4683","327 - (  4683  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ مُحَمَّدُ بْنُ الْعَلَاءِ الْهَمْدَانِيُّ ،  حَدَّثَنَا  خَلَّادٌ الْجُعْفِيُّ ،  عَنْ  زُهَيْرٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّهَا كَانَتْ تَحْمِلُ مِنْ مَاءِ زَمْزَمَ فِي الْقَوَارِيرِ  ، وَتَذْكُرُ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَحْمِلُ  .         [8/140]","","Musnad Abi Ya'la al-Mawsili 4683","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن زهير بن معاوية بن حديج عن خلاد بن يزيد الجعفي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4684","328 - (  4684  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  حَفْصُ بْنُ بِشْرٍ الْأَسَدِيُّ قَالَ :  حَدَّثَنَا  حَكِيمُ بْنُ نَافِعٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  سَجْدَتَا السَّهْوِ تُجْزِئَانِ مِنْ كُلِّ زِيَادَةٍ وَنُقْصَانٍ  .","","Musnad Abi Ya'la al-Mawsili 4684","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حكيم بن نافع الرقي عن حفص بن بشر الأسدي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4685","329 - (  4685  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  سَعِيدُ بْنُ شُرَحْبِيلَ ،  عَنْ  لَيْثِ بْنِ سَعْدٍ ،  عَنْ  خَالِدِ بْنِ يَزِيدَ ،  عَنْ  سَعِيدِ بْنِ أَبِي هِلَالٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَخْطُبُ النَّاسَ يَقُولُ :  لَمَكَانُكُمْ مِنَ الْجَنَّةِ  يَعْنِي : مَنْ حَفِظَ مَا بَيْنَ لَحْيَيْهِ وَحَفِظَ مَا بَيْنَ رِجْلَيْهِ  .         [8/141]","","Musnad Abi Ya'la al-Mawsili 4685","","عائشة بنت أبي بكر الصديق عن عبد الله بن عباس عن سعيد بن أبي هلال الليثي عن خالد بن يزيد الجمحي عن الليث بن سعد عن سعيد بن شرحبيل الكندي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4686","330 - (  4686  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  ابْنُ أَبِي زَائِدَةَ ،  عَنْ  سُفْيَانَ ،  عَنْ  مَنْصُورِ بْنِ صَفِيَّةَ ،  عَنْ  أُمِّهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَوْلَمَ عَلَى بَعْضِ نِسَائِهِ بِمُدَّيْنِ مِنْ شَعِيرٍ  .         [8/142]","","Musnad Abi Ya'la al-Mawsili 4686","","عائشة بنت أبي بكر الصديق عن صفية بنت شيبة الحجبية عن منصور بن عبد الرحمن بن طلحة الحجبي عن سفيان بن عيينة عن يحيى بن زكريا بن أبي زائدة عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4687","331 - (  4687  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  ابْنُ أَبِي زَائِدَةَ ،         [8/143]      عَنْ  حَارِثَةَ بْنِ مُحَمَّدٍ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ يَقُومُ لِلْوُضُوءِ ، يَكْفَأُ الْإِنَاءَ ، فَيُسَمِّي اللهَ  ، ثُمَّ يُسْبِغُ الْوُضُوءَ  .         [8/144]","","Musnad Abi Ya'la al-Mawsili 4687","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن حارثة بن أبي الرجال النجاري عن يحيى بن زكريا بن أبي زائدة عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4688","332 - (  4688  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ زَيْدٍ ،  عَنْ  رِشْدِينَ بْنِ سَعْدٍ ،  عَنْ  يَزِيدَ بْنِ الْهَادِ ،  عَنْ  مُوسَى بْنِ سَرْجِسَ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَمُوتُ ، وَعِنْدَهُ قَدَحٌ فِيهِ مَاءٌ ، يُدْخِلُ يَدَهُ وَيَمْسَحُ وَجْهَهُ ، ثُمَّ يَقُولُ :  اللَّهُمَّ أَعِنِّي عَلَى سَكَرَاتِ الْمَوْتِ  .         [8/145]","","Musnad Abi Ya'la al-Mawsili 4688","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن موسى بن سرجس المدني عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن رشدين بن سعد المهري عن محمد بن يزيد الحزامي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4689","333 - (  4689  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  عَنْ  عِمْرَانَ بْنِ أَنَسٍ ؛ أَبِي أَنَسٍ الْمَكِّيِّ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِأَصْحَابِهِ :  تَدْرُونَ أَزْنَى الزِّنَا عِنْدَ اللهِ ؟  قَالُوا : اللهُ وَرَسُولُهُ أَعْلَمُ قَالَ : فَإِنَّ أَزْنَى الزِّنَا عِنْدَ اللهِ اسْتِحْلَالُ عِرْضِ امْرِئٍ مُسْلِمٍ ، ثُمَّ قَرَأَ :         {      وَالَّذِينَ يُؤْذُونَ الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ بِغَيْرِ مَا اكْتَسَبُوا         }      .","","Musnad Abi Ya'la al-Mawsili 4689","","عائشة بنت أبي بكر الصديق عن ابن أبي مليكة عن عمران بن أنس المكي عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4690","334 - (  4690  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  عَنْ  حَمْزَةَ الزَّيَّاتِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : اللَّهُمَّ عَافِنِي فِي جَسَدِي  ، وَعَافِنِي فِي بَصَرِي ، وَاجْعَلْهُ الْوَارِثَ مِنِّي ، لَا إِلَهَ إِلَّا اللهُ الْحَلِيمُ الْكَرِيمُ ، سُبْحَانَ اللهِ رَبِّ الْعَرْشِ الْعَظِيمِ ، الْحَمْدُ لِلهِ رَبِّ الْعَالَمِينَ  .         [8/146]","","Musnad Abi Ya'la al-Mawsili 4690","","عائشة بنت أبي بكر الصديق عن عروة المزنى عن حبيب بن أبي ثابت الكاهلي عن حمزة الزيات عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4691","335 - (  4691  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  مُصْعَبُ بْنُ الْمِقْدَامِ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  إِبْرَاهِيمَ بْنِ الْمُهَاجِرِ ،  عَنْ  جَابِرٍ الْعَلَّافِ ،  حَدَّثَنَا  ابْنُ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  صَلَاةٌ فِي مَسْجِدِي خَيْرٌ مِنْ أَلْفِ صَلَاةٍ فِيمَا سِوَاهُ  .         [8/147]","","Musnad Abi Ya'la al-Mawsili 4691","","عائشة بنت أبي بكر الصديق عن عبد الله بن الزبير عن جابر العلاف عن إبراهيم بن مهاجر بن جابر البجلي عن إسرائيل بن يونس بن أبي إسحاق عن مصعب بن المقدام الخثعمي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4692","336 - (  4692  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  حَجَّاجٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .","","Musnad Abi Ya'la al-Mawsili 4692","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن حجاج بن أرطاة عن عبد الله بن المبارك عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4693","336 - (  4692  ) - ( م ) -  وَعَنْ  حَجَّاجٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَا : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا نِكَاحَ إِلَّا بِوَلِيٍّ  .         [8/148]      وَفِي حَدِيثِ  عُرْوَةَ  : وَالسُّلْطَانُ وَلِيُّ مَنْ لَا وَلِيَّ لَهُ  .","","Musnad Abi Ya'la al-Mawsili 4692","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن حجاج بن أرطاة عن عبد الله بن المبارك عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4694","337 - (  4693  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  صَيْفِيُّ بْنُ رِبْعِيٍّ الْأَنْصَارِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنِ  الْقَاسِمِ ،  عَنْ  عَائِشَةَ قَالَتْ :  ذَكَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَسْفًا ، وَمَسْخًا ، وَقَذْفًا ، يَكُونُ فِي آخِرِ هَذِهِ الْأُمَّةِ ، قُلْتُ : يَا رَسُولَ اللهِ ، أَنَهْلِكُ وَفِينَا الصَّالِحُونَ ؟ قَالَ :  نَعَمْ ، إِذَا ظَهَرَ الْخَبَثُ  .         [8/149]","","Musnad Abi Ya'la al-Mawsili 4693","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبيد الله بن عمر العمري عن عبد الله بن عمر العمري عن صيفي بن ربعي الأنصاري عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4695","338 - (  4694  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ خَالِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنِ  الْقَاسِمِ ،  عَنْ  عَائِشَةَ قَالَتْ :  سُئِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الرَّجُلِ يَرَى فِي الْمَنَامِ أَنَّهُ قَدِ احْتَلَمَ ، وَلَا يَرَى بَلَلًا قَالَ : لَا غُسْلَ عَلَيْهِ ، قَالَتْ  أُمُّ سُلَيْمٍ  : يَا رَسُولَ اللهِ ، وَالْمَرْأَةُ تَرَى ذَلِكَ ؟ قَالَ :  النِّسَاءُ  شَقَائِقُ  الرِّجَالِ  .         [8/150]","","Musnad Abi Ya'la al-Mawsili 4694","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبيد الله بن عمر العمري عن عبد الله بن عمر العمري عن حماد بن خالد الخياط عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4696","339 - (  4695  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  خَالِدُ بْنُ حَيَّانَ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ أَبِي الْمُهَاجِرِ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  عَنْ  أَبِي هُرَيْرَةَ ، وَعَائِشَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَوَضَّأَ ثَلَاثًا ثَلَاثًا  .","","Musnad Abi Ya'la al-Mawsili 4695","","عائشة بنت أبي بكر الصديق عن ميمون بن مهران الرقي عن سالم بن عبد الله الرقي عن خالد بن حيان الرقي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4697","340 - (  4696  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ قُدَامَةَ قَالَ :  سَمِعْتُ  سُفْيَانَ ، يَقُولُ :  قُلْتُ  لِعَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ :  أَسَمِعْتَ  أَبَاكَ  يُخْبِرُ عَنْ  عَائِشَةَ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُقَبِّلُ وَهُوَ صَائِمٌ  ؟ قَالَ : فَسَكَتَ عَنِّي شَيْئًا ، ثُمَّ قَالَ لِي : نَعَمْ ، كَأَنَّهُ اسْتَصْغَرَنِي  .","","Musnad Abi Ya'la al-Mawsili 4696","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن سفيان بن عيينة عن محمد بن قدامة بن أعين المصيصي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4698","341 - (  4697  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  ابْنُ أَبِي زَائِدَةَ ،         [8/151]      وَعَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ،  عَنْ  أُمِّ كُلْثُومٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَالَطَهَا مِنْ غَيْرِ أَنْ يُنْزِلَ ، قَالَتْ : فَاغْتَسَلْنَا  .         [8/152]","","Musnad Abi Ya'la al-Mawsili 4697","","عائشة بنت أبي بكر الصديق عن أم كلثوم بنت أبي بكر الصديق عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن أشعث بن سوار عن عبد الرحيم بن سليمان الأشل عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4699","342 - (  4698  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  حُسَيْنُ بْنُ عَلِيٍّ ،  عَنْ  زَائِدَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَ بِبِنَاءِ الْمَسْجِدِ فِي الدُّورِ أَنْ تُنَظَّفَ  وَتُطَيَّبَ  .","","Musnad Abi Ya'la al-Mawsili 4698","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن زائدة بن قدامة عن الحسين بن علي الجعفي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4700","343 - (  4699  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  ابْنُ أَبِي زَائِدَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  خَالِدِ بْنِ سَلَمَةَ ،  عَنِ  الْبَهِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَذْكُرُ اللهَ عَلَى كُلِّ أَحْيَانِهِ  .         [8/153]","","Musnad Abi Ya'la al-Mawsili 4699","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن عبد الله البهي مولى مصعب بن الزبير عن الفأفأ ، خالد بن سلمة بن العاص عن زكريا بن أبي زائدة الوادعي عن يحيى بن زكريا بن أبي زائدة عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4701","344 - (  4700  ) -  حَدَّثَنَا  أُمَيَّةُ بْنُ بِسْطَامٍ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  رَوْحُ بْنُ الْقَاسِمِ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ قَالَ :  قَالَتْ  عَائِشَةُ :  مَا رَأَيْتُ أَحَدًا قَطُّ أَصْدَقَ مِنْ  فَاطِمَةَ  غَيْرَ أَبِيهَا  ، وَكَانَ بَيْنَهُمَا شَيْءٌ ، فَقَالَتْ : يَا رَسُولَ اللهِ سَلْهَا ، فَإِنَّهَا لَا تَكْذِبُ  .         [8/154]","","Musnad Abi Ya'la al-Mawsili 4700","","عائشة بنت أبي بكر الصديق عن عمرو بن دينار الأثرم عن روح بن القاسم العنبري عن يزيد بن زريع العيشي عن أمية بن بسطام عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4702","345 - (  4701  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ جَنَابٍ ،  حَدَّثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ قَالَ :  حَدَّثَنِي  أَخِي عَبْدُ اللهِ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتِ :  اجْتَمَعْنَ إِحْدَى عَشْرَةَ امْرَأَةً فَتَعَاهَدْنَ ، وَتَعَاقَدْنَ أَنْ لَا يَكْتُمْنَ مِنْ أَخْبَارِ أَزْوَاجِهِنَّ شَيْئًا ، فَقَالَتِ الْأُولَى : زَوْجِي لَحْمُ جَمَلٍ  غَثٍّ ،  عَلَى رَأْسِ جَبَلٍ ، لَا سَهْلٍ فَيُرْتَقَى ، وَلَا سَمِينٍ  فَيُنْتَقَلُ  .  قَالَتِ الثَّانِيَةُ : زَوْجِي لَا  أَبُثُّ  خَبَرَهُ ، إِنِّي أَخَافُ أَنْ لَا  أَذَرَهُ  ، إِنْ أَذْكُرْهُ أَذْكُرْ  عُجَرَهُ  وَبُجَرَهُ  .  قَالَتِ الثَّالِثَةُ : زَوْجِي  الْعَشَنَّقُ  ، إِنْ أَسْكُتْ  أُعَلَّقْ  ، وَإِنْ أَنْطِقْ أُطَلَّقْ .  قَالَتِ الرَّابِعَةُ : زَوْجِي كَلَيْلِ  تِهَامَةَ  ، لَا حَرٌّ وَلَا قَرٌّ ، وَلَا مَخَافَةَ وَلَا  سَآمَةَ  .         [8/155]      قَالَتِ الْخَامِسَةُ : زَوْجِي إِنْ أَكَلَ  لَفَّ ،  وَإِنْ شَرِبَ  اشْتَفَّ ،  وَإِنْ نَامَ  الْتَفَّ  ، وَلَا  يُولِجُ  الْكَفَّ لِيَعْلَمَ  الْبَثَّ  .  قَالَتِ السَّادِسَةُ : زَوْجِي  غَيَايَاءُ - أَوْ عَيَايَاءُ  ،  شَكَّ  عِيسَى  -  طَبَاقَاءُ ،  كُلُّ دَاءٍ لَهُ دَاءٌ ،  شَجَّكِ ،  أَوْ فَلَّكِ ، أَوْ جَمَعَ كُلًّا لَكِ .  قَالَتِ السَّابِعَةُ : زَوْجِي إِنْ دَخَلَ  أَسِدَ  ، وَإِنْ خَرَجَ  فَهِدَ ،  وَلَا يَسْأَلُ عَمَّا  عَهِدَ  .  قَالَتِ الثَّامِنَةُ : زَوْجِي  الْمَسُّ  مَسُّ  أَرْنَبٍ ، وَالرِّيحُ رِيحُ  زَرْنَبٍ  .         [8/156]      قَالَتِ التَّاسِعَةُ : زَوْجِي رَفِيعُ  الْعِمَادِ ،  طَوِيلُ  النِّجَادِ ،  عَظِيمُ  الرَّمَادِ ،  قَرِيبُ الْبَيْتِ مِنَ  النَّادِي  .  قَالَتِ الْعَاشِرَةُ : زَوْجِي مَالِكٌ ، وَمَا مَالِكٌ خَيْرٌ مِنْ ذَلِكَ ، لَهُ إِبِلٌ قَلِيلَاتُ  الْمَسَارِحِ  كَثِيرَاتُ الْمَبَارِكِ ، إِذَا سَمِعْنَ صَوْتَ  الْمِزْهَرِ  أَيْقَنَّ أَنَّهُنَّ هَوَالِكُ .  قَالَتِ الْحَادِيَةُ عَشْرَةَ : زَوْجِي  أَبُو زَرْعٍ  ، وَمَا  أَبُو زَرْعٍ  ،  أَنَاسَ  مِنْ حُلِيٍّ أُذُنَيَّ ، وَمَلَأَ مِنْ  شَحْمٍ  عَضُدَيَّ ،  وَبَجَّحَنِي  فَبَجِحَتْ إِلَيَّ نَفْسِي ، فَوَجَدَنِي فِي أَهْلِ غُنَيْمَةٍ  بِشِقٍّ ،  فَجَعَلَنِي فِي أَهْلِ  صَهِيلٍ ،  وَأَطِيطٍ  ،  وَدَائِسٍ ،  وَمُنَقٍّ ،  وَعِنْدَهُ         [8/157]      أَقُولُ فَلَا  أُقَبَّحُ  ، وَأَرْقُدُ  فَأَتَصَبَّحُ ،  وَأَشْرَبُ  فَأَتَقَمَّحُ  .  أُمُّ أَبِي زَرْعٍ  ، وَمَا  أُمُّ أَبِي زَرْعٍ  ؟  عُكُومُهَا  رَدَاحٌ ،  وَبَيْتُهَا فَسَاحٌ .  ابْنُ أَبِي زَرْعٍ  ، فَمَا  ابْنُ أَبِي زَرْعٍ  ؟ مَضْجَعُهُ كَمَسَلِّ  شَطْبَةٍ ،  وَيُشْبِعُهُ ذِرَاعُ  الْجَفْرَةِ  .         [8/158]      ابْنَةُ أَبِي زَرْعٍ  ، وَمَا  ابْنَةُ أَبِي زَرْعٍ  ؟ طَوْعُ أَبِيهَا ، وَطَوْعُ أُمِّهَا ، وَمِلْءُ كِسَائِهَا ،  وَغَيْظُ  جَارَتِهَا  .  جَارِيَةُ  أَبِي زَرْعٍ  ، وَمَا جَارِيَةُ  أَبِي زَرْعٍ  ؟ لَا  تَبُثُّ  حَدِيثَنَا تَبْثِيثًا ، وَلَا تَنْقُلُ مِيرَتَنَا تَنْقِيثًا ، وَلَا تَمْلَأُ بَيْتَنَا  تَعْشِيشًا  .  خَرَجَ  أَبُو زَرْعٍ  وَالْأَوْطَابُ  تُمْخَضُ ، فَلَقِيَ امْرَأَةً مَعَهَا وَلَدَانِ لَهَا كَالْفَهْدَيْنِ ، يَلْعَبَانِ مِنْ تَحْتِ خَصْرِهَا  بِرُمَّانَتَيْنِ ،  فَطَلَّقَنِي وَنَكَحَهَا ، فَنَكَحْتُ بَعْدَهُ رَجُلًا  سَرِيًّا ،  رَكِبَ شَرِيًّا ، وَأَخَذَ  خَطِّيًّا ،  وَأَرَاحَ  عَلَيَّ نَعَمًا  ثَرِيًّا  قَالَ : كُلِي  أُمَّ زَرْعٍ  ، وَمِيرِي أَهْلَكِ .  قَالَتْ : فَإِنْ جَمَعْتُ كُلَّ شَيْءٍ أَعْطَانِيهِ ، مَا بَلَغَ أَصْغَرَ آنِيَةِ  أَبِي زَرْعٍ  .         [8/159]      قَالَتْ  عَائِشَةُ  : قَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا  عَائِشُ  ، كُنْتُ لَكِ  كَأَبِي زَرْعٍ  لِأُمِّ زَرْعٍ  .         [8/160]","","Musnad Abi Ya'la al-Mawsili 4701","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن عبد الله بن عروة بن الزبير بن العوام عن هشام بن عروة بن الزبير عن عيسى بن يونس بن أبي إسحاق عن أحمد بن جناب المصيصي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4703","346 - (  4702  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَيْحَانُ بْنُ سَعِيدٍ النَّاجِيُّ ،  عَنْ  عَبَّادِ بْنِ مَنْصُورٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، بِحَدِيثِ  أُمِّ زَرْعٍ  أَيْ قَرِيبٍ مِنْهُ .","","Musnad Abi Ya'la al-Mawsili 4702","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عباد بن منصور الناجي عن ريحان بن سعيد الناجي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4704","347 - (  4703  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  دَاوُدَ بْنِ شَابُورَ ،  عَنْ  عُمَرَ بْنِ عَبْدِ اللهِ بْنِ عُرْوَةَ ،  عَنْ  جَدِّهِ عُرْوَةَ بْنِ الزُّبَيْرِ  ،  عَنْ  عَائِشَةَ ،  أَنَّهَا حَدَّثَتْ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ  أَبِي زَرْعٍ  ،  وَأُمِّ زَرْعٍ  ، وَذَكَرَتْ شِعْرَ  أَبِي زَرْعٍ  عَلَى  أُمِّ زَرْعٍ  .","","Musnad Abi Ya'la al-Mawsili 4703","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن عمر بن عبد الله بن عروة بن الزبير بن العوام عن داود بن شابور المكي عن سفيان بن عيينة عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4705","348 - (  4704  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَامِرِ بْنِ زُرَارَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْأَجْلَحِ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ الشَّيْطَانَ يَأْتِي أَحَدَكُمْ ، فَيَقُولُ : مَنْ خَلَقَ السَّمَاوَاتِ  ؟ فَيَقُولُ : اللهُ ، فَيَقُولُ : مَنْ         [8/161]      خَلَقَ الْأَرْضَ ؟ فَيَقُولُ : اللهُ ، فَيَقُولُ : مَنْ خَلَقَ اللهَ ؟ فَإِذَا كَانَ ذَلِكَ ، فَلْيَقُلْ : آمَنْتُ بِاللهِ وَرُسُلِهِ  .","","Musnad Abi Ya'la al-Mawsili 4704","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن الأجلح عن عبد الله بن عامر بن زرارة الحضرمي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4706","349 - (  4705  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ زَيْدٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ خَالِدٍ ،  عَنْ  أَفْلَحَ بْنِ حُمَيْدٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ أُمِّ الْمُؤْمِنِينَ ، قَالَتْ :  وَقَعَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى بَعْضِ نِسَائِهِ ، ثُمَّ نَامَ حَتَّى أَصْبَحَ وَهُوَ  جُنُبٌ  ، فَاغْتَسَلَ وَصَامَ يَوْمَهُ  .         [8/162]","","Musnad Abi Ya'la al-Mawsili 4705","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن أفلح ابن صفيراء عن حماد بن خالد الخياط عن أحمد بن زيد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4707","350 - (  4706  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  شُعَيْبُ بْنُ إِسْحَاقَ الدِّمَشْقِيُّ ،  حَدَّثَنَا  عَبَّادُ بْنُ مَنْصُورٍ ،  عَنْ  عَطَاءٍ ،  أَنَّ  مَسْرُوقًا  سَأَلَ  عَائِشَةَ قَالَ :  يَا أُمَّتَاهُ ، الرَّجُلُ يُصْبِحُ  جُنُبًا  ، هَلْ يَصُومُ يَوْمَهُ ذَلِكَ  ؟ فَقَالَتْ : أَصْبَحَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  جُنُبًا  مِنْ جِمَاعٍ غَيْرِ احْتِلَامٍ ، فَرِيضَةً غَيْرَ تَطَوُّعٍ ، فَاغْتَسَلَ وَصَلَّى ، وَأَتَمَّ صَوْمَهُ  .","","Musnad Abi Ya'la al-Mawsili 4706","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن عطاء بن أبي رباح عن عباد بن منصور الناجي عن شعيب بن إسحاق الدمشقي عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4708","351 - (  4707  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  أَبُو حَفْصٍ الْأَبَّارُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصْبِحُ وَهُوَ  جُنُبٌ  فَيُتِمُّ صَوْمَهُ  .","","Musnad Abi Ya'la al-Mawsili 4707","","عائشة بنت أبي بكر الصديق عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن عمر بن عبد الرحمن بن قيس عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4709","352 - (  4708  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمِ بْنِ بَهْدَلَةَ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْرُجُ إِلَى صَلَاةِ         [8/163]      الْفَجْرِ ، وَرَأْسُهُ يَقْطُرُ  مِنْ جِمَاعٍ لَا احْتِلَامٍ ، ثُمَّ يَصُومُ  .","","Musnad Abi Ya'la al-Mawsili 4708","","عائشة بنت أبي بكر الصديق عن ذكوان السمان عن عاصم بن بهدلة عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4710","353 - (  4709  ) -  حَدَّثَنَا  دَاوُدُ بْنُ عَمْرِو بْنِ زُهَيْرٍ ،  حَدَّثَنَا  صَالِحُ بْنُ عُمَرَ ،  حَدَّثَنَا  مُطَرِّفٌ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَبِيتُ ، فَيُنَادِيهِ  بِلَالٌ  بِالْأَذَانِ ، فَيَقُومُ فَيَغْتَسِلُ  ، فَإِنِّي لَأَرَى الْمَاءَ يَنْحَدِرُ عَلَى جِلْدِهِ وَشَعَرِهِ ، ثُمَّ يَخْرُجُ فَيُصَلِّي فَأَسْمَعُ بُكَاءَهُ ، ثُمَّ يَظَلُّ صَائِمًا  .  قَالَ :  قُلْتُ لِلشَّعْبِيِّ : فِي رَمَضَانَ ؟ قَالَ : سَوَاءٌ  .","","Musnad Abi Ya'la al-Mawsili 4709","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن الشعبي عن مطرف بن طريف عن صالح بن عمر الواسطي عن داود بن عمرو المسيبي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4711","354 - (  4710  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  سَعِيدٌ ،  عَنْ  قَتَادَةَ قَالَ :  كَتَبْنَا  إِلَى إِبْرَاهِيمَ بْنِ يَزِيدَ نَسْأَلُهُ عَنِ الرَّضَاعِ فَكَتَبَ  إِنَّ شُرَيْحًا  حَدَّثَ  :  أَنَّ  عَلِيًّا وَابْنَ مَسْعُودٍ كَانَا يَقُولَانِ :  يُحَرِّمُ مِنَ الرَّضَاعَةِ قَلِيلُهُ وَكَثِيرُهُ  قَالَ : وَكَانَ فِي كِتَابِهِ أَنَّ أَبَا الشَّعْثَاءِ الْمُحَارِبِيَّ  حَدَّثَ  : أَنَّ عَائِشَةَ  حَدَّثَتْ  : أَنَّ نَبِيَّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ :  لَا تُحَرِّمُ  الْخَطْفَةُ  وَالْخَطْفَتَانِ  .         [8/164]","","Musnad Abi Ya'la al-Mawsili 4710","","عائشة بنت أبي بكر الصديق عن سليم بن أسود المحاربي عن إبراهيم النخعي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4712","355 - (  4711  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ  عَبْدَ اللهِ بْنَ عُمَرَ  ، لَمَّا مَاتَ  رَافِعُ بْنُ خَدِيجٍ  قَالَ : لَا تَبْكُوا عَلَيْهِ ، فَإِنَّ بُكَاءَ الْحَيِّ عَلَى الْمَيِّتِ عَذَابٌ عَلَى الْمَيِّتِ  ،  فَقَالَتْ  عَائِشَةُ : إِنَّمَا قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِيَهُودِيَّةٍ  أَهْلُهَا يَبْكُونَ عَلَيْهَا :  إِنَّهُمْ لَيَبْكُونَ عَلَيْهَا ، وَإِنَّهَا لَتُعَذَّبُ فِي قَبْرِهَا  .","","Musnad Abi Ya'la al-Mawsili 4711","","عائشة بنت أبي بكر الصديق عن أبو بكر بن محمد الخزرجي عن عبد الله بن أبي بكر بن محمد  ابن حزم عن سفيان بن عيينة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4713","356 - (  4712  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ،  عَنْ  أَبِيهِ ،         [8/165]      سَمِعَ  عَائِشَةَ ، وَبَسَطَتْ يَدَيْهَا ، تَقُولُ :  طَيَّبْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِيَدَيَّ هَاتَيْنِ  لِحُرْمِهِ  حِينَ أَحْرَمَ  ، وَلِحِلِّهِ قَبْلَ أَنْ يَطُوفَ  بِالْبَيْتِ  .","","Musnad Abi Ya'la al-Mawsili 4712","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن سفيان بن عيينة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4714","357 - (  4713  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  بِشْرُ بْنُ مَنْصُورٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا رَأَى  مَخِيلَةً  فَزِعَ لَهَا وَتَغَيَّرَ لَهَا لَوْنُهُ ، وَأَقْبَلَ وَأَدْبَرَ  ، وَدَخَلَ وَخَرَجَ ، فَإِذَا أَمْطَرَتْ  سُرِّيَ  عَنْهُ ، قَالَتْ  عَائِشَةُ  : فَسَأَلْتُهُ عَنْ ذَلِكَ ، فَقَالَ : وَمَا يُدْرِيكِ ، لَعَلَّهُ كَمَا قَالَ :         {      فَلَمَّا رَأَوْهُ عَارِضًا مُسْتَقْبِلَ أَوْدِيَتِهِمْ قَالُوا هَذَا عَارِضٌ مُمْطِرُنَا         }      الْآيَةَ .","","Musnad Abi Ya'la al-Mawsili 4713","","عائشة بنت أبي بكر الصديق عن عطاء بن أبي رباح عن ابن جريج عن بشر بن منصور السليمي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4715","358 - (  4714  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ قَالَ :  قُلْتُ  لِعَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ :  أَسَمِعْتَ  أَبَاكَ  يُخْبِرُ عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُقَبِّلُهَا وَهُوَ صَائِمٌ  ؟ قَالَ : نَعَمْ  .         [8/166]","","Musnad Abi Ya'la al-Mawsili 4714","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن سفيان بن عيينة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4716","359 - (  4715  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ،  عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُقَبِّلُ وَهُوَ صَائِمٌ  .","","Musnad Abi Ya'la al-Mawsili 4715","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4717","360 - (  4716  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ سَلَّامُ بْنُ سُلَيْمٍ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُقَبِّلُ فِي شَهْرِ الصَّوْمِ  .","","Musnad Abi Ya'la al-Mawsili 4716","","عائشة بنت أبي بكر الصديق عن عمرو بن ميمون الأودي عن زياد بن علاقة الثعلبي عن سلام بن سليم الحنفي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4718","361 - (  4717  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  حَبِيبِ بْنِ أَبِي عَمْرَةَ ،  عَنْ  عَائِشَةَ بِنْتِ طَلْحَةَ ،  عَنْ  عَائِشَةَ أُمِّ الْمُؤْمِنِينَ ،  أَنَّهَا قَالَتْ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَرَى  الْجِهَادَ  أَفْضَلَ الْعَمَلِ ، أَفَلَا نُجَاهِدُ ؟ قَالَ :  لَكِنَّ أَفْضَلَ  الْجِهَادِ  حَجٌّ  مَبْرُورٌ  .","","Musnad Abi Ya'la al-Mawsili 4717","","عائشة بنت أبي بكر الصديق عن عائشة بنت طلحة التيمية عن حبيب بن أبي عمرة القصاب عن خالد بن عبد الله الطحان عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4719","362 - (  4718  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ قَالَ :  سَأَلْتُ  عَائِشَةَ ، عَنِ الْمُبَاشَرَةِ لِلصَّائِمِ فَكَرِهَتْهَا  ، فَقُلْتُ لَهَا :         [8/167]      بَلَغَنِي أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يُبَاشِرُ وَهُوَ صَائِمٌ ؟ فَقَالَتْ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ أَمْلَكَ لِإِرْبِهِ مِنَ النَّاسِ أَجْمَعِينَ  .","","Musnad Abi Ya'la al-Mawsili 4718","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن حماد بن أبي سليمان عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4720","363 - (  4719  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ،  عَنْ  أَبِيهِ  قَالَ :  قَالَتْ  عَائِشَةُ :  خَرَجْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَا نَرَى إِلَّا  الْحَجَّ  ، فَلَمَّا كُنَّا  بِسَرِفَ  - أَوْ قَرِيبًا مِنْهُ - حِضْتُ ، فَدَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا أَبْكِي ، فَقَالَ :  مَا لَكِ  أَنَفِسْتِ  ؟  فَقُلْتُ : نَعَمْ . قَالَ : إِنَّ هَذَا أَمْرٌ كَتَبَهُ اللهُ عَلَى بَنَاتِ آدَمَ ، فَاقْضِي مَا يَقْضِي الْحَاجُّ غَيْرَ أَنْ لَا تَطُوفِي  بِالْبَيْتِ  ، حَتَّى تَغْتَسِلِي ، فَلَمَّا كُنَّا  بِمِنًى  ضَحَّى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ نِسَائِهِ الْبَقَرَ  .","","Musnad Abi Ya'la al-Mawsili 4719","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن سفيان بن عيينة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4721","364 - (  4720  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  أَبِي سِنَانٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي الْهُذَيْلِ قَالَ :  كَانُوا يُحِبُّونَ إِذَا قَضَى الرَّجُلُ الصَّلَاةَ ، أَنْ يَقُولَ : اللَّهُمَّ         [8/168]      أَنْتَ السَّلَامُ وَمِنْكَ السَّلَامُ  ، تَبَارَكْتَ يَا ذَا  الْجَلَالِ  وَالْإِكْرَامِ  .","","Musnad Abi Ya'la al-Mawsili 4720","","عبد الله بن أبي الهذيل الغنوي عن ضرار بن مرة الشيباني عن خالد بن عبد الله الطحان عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4722","365 - (  4721  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  خَالِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  عَائِشَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّهُ كَانَ يَقُولُ هَؤُلَاءِ الْكَلِمَاتِ  .         [8/169]","","Musnad Abi Ya'la al-Mawsili 4721","","عائشة بنت أبي بكر الصديق عن عبد الله بن الحارث الأنصاري عن خالد الحذاء عن خالد بن عبد الله الطحان عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4723","366 - (  4722  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  وُهَيْبٌ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ،  عَنْ  عَائِشَةَ قَالَتْ :  مَا رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي شَيْئًا مِنْ صَلَاةِ اللَّيْلِ جَالِسًا  ، حَتَّى إِذَا دَخَلَ فِي السِّنِّ صَلَّى فَقَرَأَ ، فَإِذَا بَقِيَ عَلَيْهِ مِنَ السُّورَةِ ثَلَاثُونَ آيَةً أَوْ أَرْبَعُونَ آيَةً ، قَامَ فَقَرَأَ ، ثُمَّ رَكَعَ .         [8/170]","","Musnad Abi Ya'la al-Mawsili 4722","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن وهيب بن خالد الكرابيسي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4724","367 - (  4723  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ،  عَنْ  أَبِيهِ ،         [8/171]      عَنْ  عَائِشَةَ قَالَتْ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ سَفَرٍ ، وَقَدِ اسْتَتَرْتُ  بِقِرَامٍ  عَلَى  سَهْوَةٍ  لِي ، فِيهِ تَمَاثِيلُ ، فَلَمَّا رَآهُ هَتَكَهُ بِيَدِهِ ، وَقَالَ :  أَشَدُّ النَّاسِ عَذَابًا عِنْدَ اللهِ يَوْمَ الْقِيَامَةِ الَّذِينَ يُضَاهُونَ بِخَلْقِ اللهِ  ، فَقَالَتْ  عَائِشَةُ  : فَقَطَعْنَاهُ ، فَجَعَلْنَا مِنْهُ وِسَادَةً أَوْ وِسَادَتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 4723","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن سفيان بن عيينة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4725","368 - (  4724  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  خَالِدٌ ،  عَنِ  الْمُغِيرَةِ ،  عَنْ  أُمِّ مُوسَى قَالَتْ :  رَأَيْتُ  عَلِيَّ بْنَ أَبِي طَالِبٍ يُصَلِّي بَعْدَ الْعَصْرِ  .","","Musnad Abi Ya'la al-Mawsili 4724","","علي بن أبي طالب عن أم موسى سرية علي بن أبي طالب عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4726","369 - (  4725  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  خَالِدٌ ،  عَنِ  الْمُغِيرَةِ ،  عَنْ  أُمِّ مُوسَى ، قَالَتْ :  إِنَّ  نَاجِيَةَ بِنْتَ قَرَظَةَ  أَرْسَلَتْنِي إِلَى عَائِشَةَ ، أَسْأَلُهَا عَنِ الصَّلَاةِ بَعْدَ الْعَصْرِ ، قَالَتْ : فَأَتَيْتُهَا وَمَا  أُبَالِي  مَا قَالَتْ بَعْدَ الَّذِي رَأَيْتُ مِنْ  عَلِيٍّ  ،  قَالَتْ  : فَأَخْبَرَتْ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُصَلِّي بَعْدَ الْعَصْرِ  .         [8/172]","","Musnad Abi Ya'la al-Mawsili 4725","","عائشة بنت أبي بكر الصديق عن أم موسى سرية علي بن أبي طالب عن المغيرة بن مقسم الضبي عن خالد بن عبد الله الطحان عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4727","370 - (  4726  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  هِشَامٌ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  كُنْتُ أَغْتَسِلُ أَنَا وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَغْتَرِفُ مِنْهُ وَنَحْنُ  جُنُبٌ  .","","Musnad Abi Ya'la al-Mawsili 4726","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن وكيع بن الجراح عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4728","371 - (  4727  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أُمِّهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَضَعُ رَأْسَهُ فِي حِجْرِ إِحْدَانَا وَهِيَ حَائِضٌ  ، ثُمَّ يَتْلُو الْقُرْآنَ  .         [8/173]","","Musnad Abi Ya'la al-Mawsili 4727","","عائشة بنت أبي بكر الصديق عن صفية بنت شيبة الحجبية عن منصور بن عبد الرحمن بن طلحة الحجبي عن سفيان بن عيينة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4729","372 - (  4728  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  وُهَيْبُ بْنُ خَالِدٍ ،  حَدَّثَنَا  حُمَيْدٌ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُصَلِّي قَائِمًا وَقَاعِدًا ، فَإِذَا صَلَّى قَائِمًا رَكَعَ قَائِمًا  ، وَإِذَا صَلَّى قَاعِدًا رَكَعَ قَاعِدًا  .         [8/174]","","Musnad Abi Ya'la al-Mawsili 4728","","عائشة بنت أبي بكر الصديق عن عبد الله بن شقيق العقيلي عن حميد الطويل عن وهيب بن خالد الكرابيسي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4730","373 - (  4729  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  وَكِيعُ بْنُ الْجَرَّاحِ ،  عَنْ  سُفْيَانَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنَامُ  جُنُبًا  كَهَيْئَتِهِ  لَا يَمَسُّ مَاءً  .         [8/175]","","Musnad Abi Ya'la al-Mawsili 4729","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن أبو إسحاق السبيعي عن سفيان الثوري عن وكيع بن الجراح عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4731","374 - (  4730  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،         [8/176]      عَنْ  عَائِشَةَ قَالَتْ :  قُلْتُ لَهَا : مَا  أُبَالِي  يَا أُمَّهْ أَنْ لَا أَطَّوَّفَ بَيْنَ  الصَّفَا  وَالْمَرْوَةِ  ، قَالَتْ :  بِئْسَ مَا قُلْتَ يَا ابْنَ أُخْتِي إِنَّهُ كَانَ مَنْ أَهَلَّ لِمَنَاةَ الَّتِي  بِالْمُشَلَّلِ  لَمْ  يَطُفْ بَيْنَهُمَا - أَوْ يَطَّوَّفُ بَيْنَهُمَا  ،  شَكَّ  سُفْيَانُ  - فَأَنْزَلَ اللهُ :         {      إِنَّ الصَّفَا وَالْمَرْوَةَ مِنْ شَعَائِرِ اللهِ         }      الْآيَةَ ، قَدْ طَافَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَيْنَهُمَا فَهِيَ سُنَّةٌ  .         [8/177]","","Musnad Abi Ya'la al-Mawsili 4730","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن سفيان بن عيينة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4732","375 - (  4731  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  جَعْفَرِ بْنِ بُرْقَانَ ،  عَنْ  فُرَاتِ بْنِ سَلْمَانَ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَوَّلُ مَا يُكْفَأُ الْإِسْلَامُ ، كَمَا يُكْفَأُ الْإِنَاءُ فِي شَرَابٍ يُقَالُ لَهُ :  الطِّلَاءُ  .         [8/178]","","Musnad Abi Ya'la al-Mawsili 4731","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن فرات بن سلمان الجزري عن جعفر بن برقان الكلابي عن وكيع بن الجراح عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4733","376 - (  4732  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  وُهَيْبٌ ،  حَدَّثَنَا  سَعِيدٌ أَبُو مَسْعُودٍ الْجُرَيْرِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ قَالَ :  قُلْتُ  لِعَائِشَةَ : يَا أُمَّ الْمُؤْمِنِينَ أَيُّ صَحَابَةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ أَحَبَّ إِلَيْهِ ؟ قَالَتْ :  أَبُو بَكْرٍ  . قُلْتُ : ثُمَّ مَنْ ؟ قَالَتْ : ثُمَّ  عُمَرُ  . قَالَ : قُلْتُ : ثُمَّ مَنْ ؟ قَالَتْ : ثُمَّ  أَبُو عُبَيْدَةَ بْنُ الْجَرَّاحِ  . قَالَ : قُلْتُ : ثُمَّ مَنْ ؟ قَالَ : فَسَكَتَتْ  .","","Musnad Abi Ya'la al-Mawsili 4732","","عائشة بنت أبي بكر الصديق عن عبد الله بن شقيق العقيلي عن سعيد بن إياس الجريري عن وهيب بن خالد الكرابيسي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4734","377 - (  4733  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أُمِّهِ  ،  عَنْ  عَائِشَةَ  أَنَّ  امْرَأَةً  سَأَلَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ غُسْلِهَا مِنَ         [8/179]      الْمَحِيضِ ، فَأَمَرَهَا كَيْفَ تَغْتَسِلُ ، ثُمَّ قَالَ :  خُذِي  فِرْصَةً  مِنْ مِسْكٍ فَتَطَهَّرِي بِهَا  ، قَالَتْ : كَيْفَ أَتَطَهَّرُ بِهَا ؟ قَالَتْ : فَسَتَرَ وَجْهَهُ بِطَرَفِ ثَوْبِهِ ، وَقَالَ : سُبْحَانَ اللهِ تَطَهَّرِي بِهَا ، قَالَتْ  عَائِشَةُ  : فَاجْتَذَبْتُ الْمَرْأَةَ ، فَقُلْتُ : تَتَبَّعِي بِهَا أَثَرَ الدَّمِ  .         [8/180]","","Musnad Abi Ya'la al-Mawsili 4733","","عائشة بنت أبي بكر الصديق عن صفية بنت شيبة الحجبية عن منصور بن عبد الرحمن بن طلحة الحجبي عن سفيان بن عيينة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4735","378 - (  4734  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُقَبِّلُ بَعْضَ أَزْوَاجِهِ وَهُوَ صَائِمٌ  ، ثُمَّ تَضْحَكُ  .","","Musnad Abi Ya'la al-Mawsili 4734","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن سفيان بن عيينة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4736","379 - (  4735  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  وَكِيعٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  شِمْرِ بْنِ عَطِيَّةَ ،  عَنْ  يَحْيَى بْنِ وَثَّابٍ ،  عَنْ  عَائِشَةَ :  أَنَّهَا رَكِبَتْ بَعِيرًا فَلَعَنَتْهُ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَرْكَبِيهِ  .","","Musnad Abi Ya'la al-Mawsili 4735","","عائشة بنت أبي بكر الصديق عن يحيى بن وثاب الأصبهاني عن شمر بن عطية الكاهلي عن الأعمش عن وكيع بن الجراح عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4737","380 - (  4736  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنْ  سَعِيدِ بْنِ يَسَارٍ ،  عَنْ  زَيْدِ بْنِ خَالِدٍ ،  عَنْ  أَبِي طَلْحَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تَدْخُلُ الْمَلَائِكَةُ بَيْتًا فِيهِ كَلْبٌ أَوْ تَمَاثِيلُ  .  قَالَ : فَقُلْتُ : انْطَلِقُوا بِنَا إِلَى عَائِشَةَ ، فَأَخْبَرْنَاهَا بِمَا قَالَ  أَبُو         [8/181]      طَلْحَةَ  ، فَقَالَتْ : لَا أَدْرِي ، وَسَأُحَدِّثُكُمْ بِمَا رَأَيْتُهُ فَعَلَ .  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي بَعْضِ غَزَوَاتِهِ ، فَكُنْتُ  أَتَحَيَّنُ  قُفُولَهُ ، فَأَخَذْتُ نَمَطًا لَنَا فَسَتَرْتُ بِهِ عَلَى الْعَرْضِ ، قَالَتْ : فَلَمَّا أَقْبَلَ قُمْتُ ، فَقُلْتُ : السَّلَامُ عَلَيْكَ يَا رَسُولَ اللهِ ، الْحَمْدُ لِلهِ الَّذِي أَعَزَّكَ ، وَنَصَرَكَ وَأَكْرَمَكَ ، قَالَتْ : فَرَفَعَ رَأْسَهُ فَنَظَرَ إِلَى النَّمَطِ ، فَلَمْ يَرُدَّ عَلَيَّ شَيْئًا ، عَرَفْتُ الْكَرَاهِيَةَ فِي وَجْهِهِ ، فَانْطَلَقَ حَتَّى هَتَكَ النَّمَطَ ، ثُمَّ قَالَ : يَا  عَائِشَةُ  ، إِنَّ اللهَ لَمْ يَأْمُرْنَا فِيمَا رَزَقَنَا أَنْ نَكْسُوَ الْحِجَارَةَ وَاللَّبِنَ ، قَالَتْ : فَأَخَذْتُهُ فَجَعَلْتُهُ وِسَادَةً ثُمَّ حَشَوْتُهَا لِيفًا ، فَلَمْ يَعِبْ ذَلِكَ عَلَيَّ  .         [8/182]","","Musnad Abi Ya'la al-Mawsili 4736","","عائشة بنت أبي بكر الصديق عن زيد بن خالد الجهني عن سعيد بن يسار مولى ميمونة زوج رسول الله عن سهيل بن أبي صالح السمان عن خالد بن عبد الله الطحان عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4738","381 - (  4737  ) -  حَدَّثَنَا  هَنَّادُ بْنُ السَّرِيِّ ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي مِنَ اللَّيْلِ تِسْعَ رَكَعَاتٍ  .","","Musnad Abi Ya'la al-Mawsili 4737","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن سلام بن سليم الحنفي عن هناد بن السري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4739","382 - (  4738  ) -  حَدَّثَنَا  أَبُو هِشَامٍ الرِّفَاعِيُّ ،  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  مُعَاوِيَةُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ يُفَضِّلُ الصَّلَاةَ الَّتِي يَسْتَاكُ لَهَا ، عَلَى الصَّلَاةِ الَّتِي لَا يَسْتَاكُ سَبْعِينَ ضِعْفًا .  وَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُفَضِّلُ الذِّكْرَ  الْخَفِيَّ  الَّذِي لَا يَسْمَعُهُ         [8/183]      الْحَفَظَةُ سَبْعِينَ ضِعْفًا ، فَيَقُولُ :  إِذَا كَانَ يَوْمُ الْقِيَامَةِ وَجَمَعَ اللهُ الْخَلَائِقَ لِحِسَابِهِمْ ، وَجَاءَتِ الْحَفَظَةُ بِمَا حَفِظُوا وَكَتَبُوا  ، قَالَ اللهُ لَهُمُ : انْظُرُوا ، هَلْ بَقِيَ لَهُ مِنْ شَيْءٍ ؟ فَيَقُولُونَ : رَبَّنَا مَا تَرَكْنَا شَيْئًا مِمَّا عَلِمْنَاهُ وَحَفِظْنَاهُ إِلَّا وَقَدْ أَحْصَيْنَاهُ وَكَتَبْنَاهُ ، فَيَقُولُ اللهُ تَبَارَكَ وَتَعَالَى لَهُ : إِنَّ لَكَ عِنْدِي خَبْئًا لَا تَعْلَمُهُ ، وَأَنَا أَجْزِيكَ بِهِ ، وَهُوَ الذِّكْرُ  الْخَفِيُّ  .         [8/184]","","Musnad Abi Ya'la al-Mawsili 4738","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن معاوية بن يحيى الصدفي عن إسحاق بن سليمان الرازي عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4740","383 - (  4739  ) -  حَدَّثَنَا  أَبُو هِشَامٍ الرِّفَاعِيُّ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ سُلَيْمَانَ الرَّازِيُّ ،  عَنْ  مُعَاوِيَةَ بْنِ يَحْيَى الصَّدَفِيِّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي فِي بَيْتِي ، فَأَقْبَلَ  عَلِيُّ بْنُ أَبِي طَالِبٍ  ، فَقَامَ إِلَى جَنْبِهِ عَنْ يَمِينِهِ  ، فَأَقْبَلَتْ عَقْرَبٌ نَحْوَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا دَنَتْ مِنْهُ صُدَّتْ عَنْهُ ، ثُمَّ أَقْبَلَتْ نَحْوَ  عَلِيٍّ  ، فَأَخَذَ النَّعْلَ فَقَتَلَهَا وَهُوَ يُصَلِّي ، فَلَمَّا قَضَى صَلَاتَهُ قَالَ : قَاتَلَهَا اللهُ أَقْبَلَتْ نَحْوَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ صُدَّتْ عَنْهُ ، ثُمَّ أَقْبَلَتْ إِلَيَّ تُرِيدُنِي ، فَلَمْ يَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِقَتْلِهَا فِي الصَّلَاةِ بَأْسًا  .         [8/185]","","Musnad Abi Ya'la al-Mawsili 4739","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن معاوية بن يحيى الصدفي عن إسحاق بن سليمان الرازي عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4741","384 - (  4740  ) -  حَدَّثَنَا  أَبُو هِشَامٍ ،  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  مُعَاوِيَةُ ،  عَنِ  الزُّهْرِيِّ ،  أَخْبَرَنِي  عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  وَاللهِ لَقَدْ رَاجَعْتُ رَسُولَ اللهِ  وَمَا حَمَلَنِي عَلَى كَثْرَةِ مُرَاجَعَتِهِ إِلَّا أَنِّي لَمْ يَكُنْ يَقَعُ فِي نَفْسِي أَنْ يُحِبَّ النَّاسُ رَجُلًا قَامَ مَقَامَهُ أَبَدًا  .         [8/186]","","Musnad Abi Ya'la al-Mawsili 4740","","عائشة بنت أبي بكر الصديق عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن معاوية بن يحيى الصدفي عن إسحاق بن سليمان الرازي عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4742","385 - (  4741  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ الْأَشَجُّ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  أَخْبَرَنِي  أَبِي  ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُحِبُّ الْحَلْوَاءَ وَالْعَسَلَ  .         [8/187]","","Musnad Abi Ya'la al-Mawsili 4741","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن أسامة القرشي عن عبد الله بن سعيد الأشج عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4743","386 - (  4742  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ ،  حَدَّثَنَا  أَبُو خَالِدٍ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  أُهْدِيَ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - هَدِيَّةٌ وَهُوَ صَائِمٌ  ، فَقُلْنَا : يَا رَسُولَ اللهِ ، لَوْلَا صِيَامُكَ لَأَتْحَفْنَاكَ بِشَيْءٍ قَالَ : هَاتِي  .","","Musnad Abi Ya'la al-Mawsili 4742","","عائشة بنت أبي بكر الصديق عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن سليمان بن حيان الأحمر عن عبد الله بن سعيد الأشج عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4744","387 - (  4743  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ الْأَشَجُّ ،  حَدَّثَنَا  أَبُو خَالِدٍ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَطْلُبُ الْغَدَاءَ  ، فَنَقُولُ : لَيْسَ ... فَيَقُولُ : إِنِّي صَائِمٌ  .","","Musnad Abi Ya'la al-Mawsili 4743","","عائشة بنت أبي بكر الصديق عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن سليمان بن حيان الأحمر عن عبد الله بن سعيد الأشج عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4745","388 - (  4744  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ ،  حَدَّثَنَا  أَبُو خَالِدٍ         [8/188]      سُلَيْمَانُ بْنُ حَيَّانَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  أَفَاضَ  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ آخِرِ يَوْمِهِ حِينَ صَلَّى الظُّهْرَ  ، ثُمَّ رَجَعَ ، فَمَكَثَ  بِمِنًى  لَيَالِيَ أَيَّامِ  التَّشْرِيقِ  يَرْمِي الْجَمْرَةَ إِذَا زَالَتِ الشَّمْسُ ، كُلُّ جَمْرَةٍ سَبْعُ حَصَيَاتٍ ، وَيَقِفُ عِنْدَ الْأُولَى وَعِنْدَ الثَّانِيَةِ ، فَيُطِيلُ الْقِيَامَ وَيَتَضَرَّعُ ، ثُمَّ يَرْمِي الْجَمْرَةَ الثَّالِثَةَ ، وَلَا يَقِفُ عِنْدَهَا  .","","Musnad Abi Ya'la al-Mawsili 4744","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن محمد بن إسحاق عن سليمان بن حيان الأحمر عن عبد الله بن سعيد الأشج عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4746","389 - (  4745  ) -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ مُوسَى السُّدِّيُّ ،  حَدَّثَنَا  عُمَرُ بْنُ سَعْدٍ النَّصْرِيُّ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،         [8/189]      عَنْ  عَائِشَةَ قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  وَيْلٌ لِلْأُمَرَاءِ وَيْلٌ  لِلْعُرَفَاءِ  وَيْلٌ لِلْأُمَنَاءِ  لَيَأْتِيَنَّ عَلَى أَحَدِهِمْ يَوْمٌ وَدَّ أَنَّهُ مُعَلَّقٌ بِالنَّجْمِ ، وَأَنَّهُ لَمْ يَلِ عَمَلًا  .","","Musnad Abi Ya'la al-Mawsili 4745","","عائشة بنت أبي بكر الصديق عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن عمر بن سعد بن أبي الضيزم النصري عن إسماعيل بن موسى الفزاري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4747","390 - (  4746  ) -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ مُوسَى ،  حَدَّثَنَا  ابْنُ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَضَعُ  لِحَسَّانَ  مِنْبَرًا فِي الْمَسْجِدِ يَقُومُ عَلَيْهِ قَائِمًا  يُفَاخِرُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَوْ يُنَافِحُ  ، وَيَقُولُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ اللهَ  يُؤَيِّدُ  حَسَّانَ  بِرُوحِ  الْقُدُسِ  مَا         [8/190]      نَافَحَ  - أَوْ فَاخَرَ  - عَنْ رَسُولِ اللهِ  .","","Musnad Abi Ya'la al-Mawsili 4746","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن إسماعيل بن موسى الفزاري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4748","391 - (  4747  ) -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ مُوسَى ،  حَدَّثَنَا  شَرِيكٌ ،  عَنِ  الْمِقْدَامِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَبْدُو  إِلَى هَذِهِ  التِّلَاعِ  .","","Musnad Abi Ya'la al-Mawsili 4747","","عائشة بنت أبي بكر الصديق عن شريح بن هانئ المذحجي عن المقدام بن شريح الحارثي عن شريك بن عبد الله النخعي عن إسماعيل بن موسى الفزاري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4749","392 - (  4748  ) -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ مُوسَى ،  حَدَّثَنَا         [8/191]      شَرِيكٌ ،  عَنْ  عَاصِمِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  فَقَدْتُهُ مِنَ اللَّيْلِ - تَعْنِي النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَإِذَا هُوَ  بِالْبَقِيعِ  ، فَقَالَ :  سَلَامٌ  عَلَيْكُمْ  دَارَ  قَوْمٍ مُؤْمِنِينَ ، أَنْتُمْ لَنَا  فَرَطٌ  ، وَإِنَّا بِكُمْ  لَاحِقُونَ  ، اللَّهُمَّ لَا تَحْرِمْنَا أَجْرَهُمْ ، وَلَا تَفْتِنَّا بَعْدَهُمْ  .","","Musnad Abi Ya'la al-Mawsili 4748","","عائشة بنت أبي بكر الصديق عن عبد الله بن عامر بن ربيعة العنزي عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن شريك بن عبد الله النخعي عن إسماعيل بن موسى الفزاري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4750","393 - (  4749  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  عَلِيُّ بْنُ ثَابِتٍ ،  حَدَّثَنَا  مِنْدَلٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا نِكَاحَ إِلَّا بِوَلِيٍّ  ، وَالسُّلْطَانُ وَلِيُّ مَنْ لَا وَلِيَّ لَهُ  .","","Musnad Abi Ya'la al-Mawsili 4749","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن مندل بن علي عن علي بن ثابت الجزري عن سريج بن يونس المروزي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4751","394 - (  4750  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَنْصَارِيُّ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  سُلَيْمَانُ بْنُ مُوسَى ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تُنْكَحُ الْمَرْأَةُ إِلَّا بِإِذْنِ وَلِيِّهَا  ، فَإِنْ نُكِحَتْ ، فَنِكَاحُهَا بَاطِلٌ ، وَإِنْ أَصَابَهَا ، فَلَهَا مَهْرُهَا         [8/192]      بِمَا أَصَابَ مِنْهَا ، وَإِنِ اشْتَجَرُوا ، فَالسُّلْطَانُ وَلِيُّ مَنْ لَا وَلِيَّ لَهُ  .","","Musnad Abi Ya'la al-Mawsili 4750","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن سليمان بن موسى الأشدق عن ابن جريج عن محمد بن عبد الله بن المثنى الخزرجي عن سريج بن يونس المروزي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4752","395 - (  4751  ) -  حَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ ،  حَدَّثَنَا  ابْنُ دَاوُدَ ،  عَنْ  ثَوْرِ بْنِ يَزِيدَ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنْ  رَبِيعَةَ الْجُرَشِيِّ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَصُومُ شَعْبَانَ ، وَرَمَضَانَ ،  وَيَتَحَرَّى  صَوْمَ الِاثْنَيْنِ وَالْخَمِيسِ  .         [8/193]","","Musnad Abi Ya'la al-Mawsili 4751","","عائشة بنت أبي بكر الصديق عن ربيعة بن عمرو الجرشي عن خالد بن معدان عن ثور بن يزيد الكلاعي عن عبد الله بن داود الخريبي عن نصر بن علي بن نصر الجهضمي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4753","396 - (  4752  ) -  حَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ ،  أَخْبَرَنَا  ابْنُ دَاوُدَ ،  عَنِ  الْمُغِيرَةِ بْنِ زِيَادٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُوتِرُ بِوَاحِدَةٍ  .","","Musnad Abi Ya'la al-Mawsili 4752","","عائشة بنت أبي بكر الصديق عن عطاء بن أبي رباح عن المغيرة بن زياد البجلي عن عبد الله بن داود الخريبي عن نصر بن علي بن نصر الجهضمي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4754","397 - (  4753  ) -  حَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ الْجَهْضَمِيُّ ،         [8/194]      حَدَّثَتْنِي  غِبْطَةُ أُمُّ عَمْرٍو الْمُجَاشِعِيَّةُ ، قَالَتْ :  حَدَّثَتْنِي  عَمَّتِي ،  عَنْ  جَدَّتِي  ،  عَنْ  عَائِشَةَ قَالَتْ :  سَأَلْتُهَا عَنِ  الْوَاصِلَةِ  ، فَقَالَتْ :  لَعَنَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْوَاصِلَةَ  وَالْمُسْتَوْصِلَةَ  .","","Musnad Abi Ya'la al-Mawsili 4753","","عائشة بنت أبي بكر الصديق عن جدة أم الحسن عمة غبطة عن أم الحسن عمة غبطة بنت عمرو المجاشعية عن غبطة بنت عمرو المجاشعية عن نصر بن علي بن نصر الجهضمي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4755","398 - (  4754  ) -  حَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ ،  حَدَّثَتْنِي  غِبْطَةُ أُمُّ         [8/195]      عَمْرٍو - عَجُوزٌ مِنْ بَنِي مُجَاشِعٍ -  حَدَّثَتْنِي  عَمَّتِي ،  عَنْ  جَدَّتِي  ،  عَنْ  عَائِشَةَ قَالَتْ :  جَاءَتْ  هِنْدُ بِنْتُ عُتْبَةَ بْنِ رَبِيعَةَ  ، إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِتُبَايِعَهُ  ، فَنَظَرَ إِلَى يَدَيْهَا ، فَقَالَ لَهَا : اذْهَبِي فَغَيِّرِي يَدَكِ ، قَالَتْ : فَذَهَبَتْ فَغَيَّرَتْهَا بِحِنَّاءٍ ، ثُمَّ جَاءَتْ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  أُبَايِعُكِ  عَلَى أَنْ لَا تُشْرِكِي بِاللهِ شَيْئًا  ، وَلَا تَسْرِقِي ، وَلَا تَزْنِي ، قَالَتْ : أَوَتَزْنِي الْحُرَّةُ ؟ قَالَ : وَلَا تَقْتُلْنَ أَوْلَادَكُنَّ خَشْيَةَ إِمْلَاقٍ ، قَالَتْ : وَهَلْ تَرَكْتَ لَنَا أَوْلَادًا نَقْتُلُهُمْ ؟ قَالَ : فَبَايَعَتْهُ ، ثُمَّ قَالَتْ لَهُ وَعَلَيْهَا سِوَارَانِ مِنْ ذَهَبٍ : مَا تَقُولُ فِي هَذَيْنِ السِّوَارَيْنِ ؟ قَالَ : جَمْرَتَانِ مِنْ جَمْرِ  جَهَنَّمَ  .","","Musnad Abi Ya'la al-Mawsili 4754","","عائشة بنت أبي بكر الصديق عن جدة أم الحسن عمة غبطة عن أم الحسن عمة غبطة بنت عمرو المجاشعية عن غبطة بنت عمرو المجاشعية عن نصر بن علي بن نصر الجهضمي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4756","399 - (  4755  ) -  حَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ ،  حَدَّثَنَا  الْحَارِثُ بْنُ مُرَّةَ الْحَنَفِيُّ ،  عَنْ  عِسْلِ بْنِ سُفْيَانَ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،         [8/196]      عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ لَمْ  يَتَغَنَّ  بِالْقُرْآنِ فَلَيْسَ مِنَّا  .","","Musnad Abi Ya'la al-Mawsili 4755","","عائشة بنت أبي بكر الصديق عن ابن أبي مليكة عن عسل بن سفيان اليربوعي عن الحارث بن مرة اليمامي عن نصر بن علي بن نصر الجهضمي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4757","400 - (  4756  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عَبْدِ الْمَجِيدِ الْحَنَفِيُّ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ مَوْهَبٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ :  أَنَّهَا أَرَادَتْ أَنْ  تُعْتِقَ  مَمْلُوكَيْنِ لَهَا زَوْجٌ ، فَذَكَرَتْ ذَلِكَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  ابْدَئِي بِالرَّجُلِ  .         [8/197]","","Musnad Abi Ya'la al-Mawsili 4756","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبيد الله بن عبد الرحمن بن عبد الله بن موهب عن عبيد الله بن عبد المجيد الحنفي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4758","401 - (  4757  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عَبْدِ الْمَجِيدِ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ مَوْهَبٍ قَالَ :  سَمِعْتُ  مَالِكَ بْنَ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ قَالَ :  سَمِعْتُ  عَمْرَةَ بِنْتَ عَبْدِ الرَّحْمَنِ ،  تُحَدِّثُ عَنْ  عَائِشَةَ أَنَّهَا قَالَتْ :  وَجَدْتُ فِي قَائِمِ سَيْفِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كِتَابًا :  إِنَّ أَشَدَّ النَّاسِ عُتُوًّا مَنْ ضَرَبَ غَيْرَ ضَارِبِهِ  ، وَرَجُلٌ قَتَلَ غَيْرَ قَاتِلِهِ ، وَرَجُلٌ تَوَلَّى غَيْرَ أَهْلِ نِعْمَتِهِ ، فَمَنْ فَعَلَ ذَلِكَ ، فَقَدْ كَفَرَ بِاللهِ وَرَسُولِهِ ، لَا يَقْبَلُ اللهُ مِنْهُ  صَرْفًا  وَلَا  عَدْلًا ،  وَفِي الْأَجْرِ الْمُؤْمِنُونَ تَكَافَأُ دِمَاؤُهُمْ ، وَيَسْعَى  بِذِمَّتِهِمْ  أَدْنَاهُمْ ، لَا يُقْتَلُ مُسْلِمٌ بِكَافِرٍ ، وَلَا ذُو  عَهْدٍ  فِي عَهْدِهِ ، وَلَا يَتَوَارَثُ أَهْلُ  مِلَّتَيْنِ ،  وَلَا تُنْكَحُ الْمَرْأَةُ عَلَى عَمَّتِهَا ، وَلَا عَلَى خَالَتِهَا ، وَلَا صَلَاةَ بَعْدَ         [8/198]      الْعَصْرِ حَتَّى تَغْرُبَ الشَّمْسُ ، وَلَا تُسَافِرُ امْرَأَةٌ ثَلَاثَ لَيَالٍ مَعَ غَيْرِ ذِي  مَحْرَمٍ  .         [8/199]","","Musnad Abi Ya'la al-Mawsili 4757","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن مالك بن أبى الرجال عن عبيد الله بن عبد الرحمن بن عبد الله بن موهب عن عبيد الله بن عبد المجيد الحنفي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4759","402 - (  4758  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ جَعْفَرٍ ،  أَخْبَرَنِي  شَرِيكُ بْنُ أَبِي نَمِرٍ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتْ  :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كُلَّمَا كَانَتْ لَيْلَتُهَا مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْرُجُ مِنْ آخِرِ اللَّيْلِ  إِلَى  الْبَقِيعِ  ، فَيَقُولُ : السَّلَامُ عَلَيْكُمْ  دَارَ  قَوْمٍ مُؤْمِنِينَ ، أَتَاكُمْ مَا تُوعَدُونَ غَدًا مُؤَجَّلُونَ ، وَإِنَّا إِنْ شَاءَ اللهُ بِكُمْ  لَاحِقُونَ ،  اللَّهُمَّ اغْفِرْ لِأَهْلِ  بَقِيعِ الْغَرْقَدِ  .","","Musnad Abi Ya'la al-Mawsili 4758","","عائشة بنت أبي بكر الصديق عن عطاء بن يسار الهلالي عن شريك بن عبد الله بن أبي نمر الكناني عن إسماعيل بن جعفر بن أبي كثير الزرقي عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4760","403 - (  4759  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  إِسْمَاعِيلُ ،  عَنْ  خَيْرَةَ بِنْتِ مُحَمَّدِ بْنِ ثَابِتِ بْنِ سِبَاعٍ  ،  عَنْ  أُمِّهَا  ،  عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  اطْلُبُوا الْخَيْرَ عِنْدَ حِسَانِ الْوُجُوهِ  .         [8/200]      كذا في طبعة دار المأمون للتراث ، والذي في المطالب عن المصنف : ( جبرة ) وقال المحقق : تصحفت في جميع النسخ إلى خيرة وما أثبته الصحيح من المؤتلف والمختلف للدارقطني 1 / 383 والمشتبه للذهبي 1 / 132  كذا في طبعة دار المأمون للتراث ، ونسخة السليمانية ، والذي في المطالب ، وإتحاف البوصيري : ( أبيها ) فالله أعلم","","Musnad Abi Ya'la al-Mawsili 4759","","عائشة بنت أبي بكر الصديق عن محمد بن ثابت بن سباع الخزاعي عن خيرة بنت محمد بن سباع عن إسماعيل بن عياش الأحول عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4761","404 - (  4760  ) -  حَدَّثَنَا  عَبَّادُ بْنُ مُوسَى الْخُتَّلِيُّ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ ثَابِتٍ ،  عَنْ  هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  سُئِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الشِّعْرِ ، فَقَالَ :  هُوَ كَلَامٌ ، فَحَسَنُهُ حَسَنٌ ، وَقَبِيحُهُ قَبِيحٌ  .","","Musnad Abi Ya'la al-Mawsili 4760","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الرحمن بن ثابت العنسي عن عباد بن موسى الختلي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4762","405 - (  4761  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي جَعْفَرٍ ،  عَنْ  مُحَمَّدِ بْنِ جَعْفَرِ بْنِ الزُّبَيْرِ ،  عَنْ  عُرْوَةَ ،         [8/201]      عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ مَاتَ وَعَلَيْهِ صِيَامٌ ، صَامَ عَنْهُ وَلِيُّهُ  .","","Musnad Abi Ya'la al-Mawsili 4761","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن محمد بن جعفر بن الزبير بن العوام عن عبيد الله بن أبي جعفر الكناني عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4763","406 - (  4762  ) -  حَدَّثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  حَدَّثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ  قَالَ :  سَمِعْتُ  عُمَرَ بْنَ الْخَطَّابِ  بِمِنًى  يَقُولُ :  أَيُّهَا النَّاسُ ، إِنَّ  النَّفْرَ  غَدًا فَلَا يَنْفِرَنَّ أَحَدٌ حَتَّى يَطُوفَ بِالْبَيْتِ  ، فَإِنَّ آخِرَ  النُّسُكِ  الطَّوَافُ  .","","Musnad Abi Ya'la al-Mawsili 4762","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن محمد بن إسحاق عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4764","407 - (  4763  ) -  حَدَّثَنَا  عُقْبَةُ ،  حَدَّثَنَا  يُونُسُ ،  أَخْبَرَنِي  هِشَامُ بْنُ عُرْوَةَ ، وَعَبْدُ اللهِ بْنُ عَامِرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،         [8/202]      عَنْ  عَائِشَةَ ،  وَعَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِمِثْلِهِ غَيْرَ أَنَّهُ قَالَ :  فَلْتَنْفِرْ  .         [8/203]","","Musnad Abi Ya'la al-Mawsili 4763","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن الزهري عن عبد الله بن عامر الأسلمي عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4765","408 - (  4764  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ عُمَرَ بْنِ شَقِيقٍ ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  أَبُو لُبَابَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْرَأُ كُلَّ لَيْلَةٍ : ""تَنْزِيلُ"" السَّجْدَةَ ، وَالزُّمَرَ  .","","Musnad Abi Ya'la al-Mawsili 4764","","عائشة بنت أبي بكر الصديق عن مروان الوراق مولى عائشة بنت أبي بكر عن حماد بن زيد عن الحسن بن عمر بن شقيق الجرمي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4766","409 - (  4765  ) -  حَدَّثَنَا  الْحِمَّانِيُّ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنِ  الْمِقْدَامِ بْنِ شُرَيْحٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْمَاءُ لَا يُنَجِّسُهُ شَيْءٌ  .         [8/204]             [8/205]","","Musnad Abi Ya'la al-Mawsili 4765","","عائشة بنت أبي بكر الصديق عن شريح بن هانئ المذحجي عن المقدام بن شريح الحارثي عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4767","410 - (  4766  ) -  حَدَّثَنَا  خَلَفُ بْنُ هِشَامٍ الْبَزَّارُ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  زُرَارَةَ ،  عَنْ  سَعْدِ بْنِ هِشَامٍ ،  عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  رَكْعَتَا الْفَجْرِ خَيْرٌ مِنَ الدُّنْيَا وَمَا فِيهَا  .         [8/206]","","Musnad Abi Ya'la al-Mawsili 4766","","عائشة بنت أبي بكر الصديق عن سعد بن هشام بن عامر الأنصاري عن زرارة بن أوفى عن قتادة بن دعامة عن الوضاح بن عبد الله اليشكري عن خلف بن هشام البزار عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4768","411 - (  4767  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ أَبُو عَبْدِ اللهِ النُّكْرِيُّ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  سُفْيَانَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  وَاللهِ الَّذِي لَا إِلَهَ غَيْرُهُ ، لَا يَحِلُّ دَمُ امْرِئٍ مُسْلِمٍ يَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ  ، وَأَنِّي رَسُولُ اللهِ  .         [8/207]","","Musnad Abi Ya'la al-Mawsili 4767","","عبد الله بن مسعود عن عبد الله بن مرة الخارفي عن الأعمش عن سفيان الثوري عن عبد الرحمن بن مهدي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4769","412 - (  4768  ) -  قَالَ  الْأَعْمَشُ :  فَحَدَّثْتُ بِهِ  إِبْرَاهِيمَ  فَحَدَّثَنِي عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ ، بِنَحْوِهِ .","","Musnad Abi Ya'la al-Mawsili 4768","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن سفيان الثوري عن عبد الرحمن بن مهدي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4770","413 - (  4769  ) -  حَدَّثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  حَدَّثَنَا  يُونُسُ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ جَعْفَرِ بْنِ الزُّبَيْرِ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ  عِرْقُ  الْكُلْيَةِ وَهِيَ  الْخَاصِرَةُ  تَأْخُذُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - شَهْرًا ، مَا يَسْتَطِيعُ أَنْ يَخْرُجَ إِلَى النَّاسِ ، وَلَقَدْ رَأَيْتُهُ يَكْرُبُ حَتَّى آخُذَ بِيَدِهِ ، فَأَتْفُلُ فِيهَا بِالْقُرْآنِ ، ثُمَّ أَكُبُّهَا عَلَى وَجْهِهِ ، أَلْتَمِسُ بِذَلِكَ بَرَكَةَ الْقُرْآنِ ، وَبَرَكَةَ يَدِهِ ، فَأَقُولُ : يَا رَسُولَ اللهِ ، إِنَّكَ مُجَابُ الدَّعْوَةِ ، فَادْعُ اللهَ يُفَرِّجْ عَنْكَ مَا أَنْتَ فِيهِ ، فَيَقُولُ :  يَا  عَائِشَةُ  ، أَنَا أَشَدُّ النَّاسِ بَلَاءً  .","","Musnad Abi Ya'la al-Mawsili 4769","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن محمد بن جعفر بن الزبير بن العوام عن محمد بن إسحاق عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4771","414 - (  4770  ) -  حَدَّثَنَا  عُقْبَةُ ،  حَدَّثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَيُّوبَ بْنِ بَشِيرٍ ،         [8/208]      عَنْ  مُحَمَّدِ بْنِ جَعْفَرٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ فِي مَرَضِهِ :  صُبُّوا عَلَيَّ سَبْعَ قِرَبٍ مِنْ مَاءِ سَبْعَةِ آبَارٍ شَتَّى  ، فَفَعَلُوا  .","","Musnad Abi Ya'la al-Mawsili 4770","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن محمد بن جعفر بن الزبير بن العوام عن أيوب بن بشير بن سعد المعاوي عن الزهري عن محمد بن إسحاق عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4772","415 - (  4771  ) -  حَدَّثَنَا  عُقْبَةُ ،  حَدَّثَنَا  يُونُسُ ،  حَدَّثَنَا  مِسْعَرُ بْنُ كِدَامٍ ،  عَنِ  الْمِقْدَامِ بْنِ شُرَيْحِ بْنِ هَانِئٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُؤْتَى بِالْإِنَاءِ فَآخُذُهُ  ، فَأَضَعُ شَفَتَيَّ عَلَيْهِ ، ثُمَّ يَأْخُذُهُ فَيَضَعُ شَفَتَيْهِ عَلَى مَوْضِعِ شَفَتَيَّ ، وَآخُذُ الْعَظْمَ فَأَعَضُّ مِنْهُ ، ثُمَّ يَضَعُ فَاهُ عَلَى مَوْضِعِ فِيَّ ، وَأَنَا حَائِضٌ  .         [8/209]","","Musnad Abi Ya'la al-Mawsili 4771","","عائشة بنت أبي بكر الصديق عن المقدام بن شريح الحارثي عن مسعر بن كدام عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4773","416 - (  4772  ) -  حَدَّثَنَا  عُقْبَةُ ،  حَدَّثَنَا  يُونُسُ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا أَوَى إِلَى فِرَاشِهِ فَأَرَادَ أَنْ يَنَامَ  ، وَهُوَ  جُنُبٌ  قَبْلَ أَنْ يَغْتَسِلَ ، أَسْبَغَ الْوُضُوءَ ، ثُمَّ نَامَ  .","","Musnad Abi Ya'la al-Mawsili 4772","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن محمد بن إسحاق عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4774","417 - (  4773  ) -  حَدَّثَنَا  عُقْبَةُ ،  حَدَّثَنَا  يُونُسُ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا أَقْبَلُ هَدِيَّةً مِنْ أَعْرَابِيٍّ  ، فَجَاءَتْهُ  أُمُّ سُنْبُلَةَ الْأَسْلَمِيَّةُ  بِوَطْبِ  لَبَنٍ ،         [8/210]      أَهْدَتْهُ لَهُ ، فَقَالَ : أَفْرِغِي مِنْهُ فِي هَذَا الْقَعْبِ ، فَأَفْرَغَتْ ، فَتَنَاوَلَهُ فَشَرِبَ ، فَقُلْتُ : أَلَمْ تَقُلْ : لَا أَقْبَلُ هَدِيَّةً مِنْ أَعْرَابِيٍّ ؟ فَقَالَ : إِنَّ أَعْرَابَ  أَسْلَمَ  لَيْسُوا بِأَعْرَابٍ ، وَلَكِنَّهُمْ أَهْلُ بَادِيَتِنَا ، وَنَحْنُ أَهْلُ حَاضِرَتِهِمْ ، إِنْ دَعَوْنَا أَجَبْنَاهُمْ ، وَإِنْ دَعَوْنَاهُمْ أَجَابُونَا  .","","Musnad Abi Ya'la al-Mawsili 4773","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن صالح بن كيسان الدوسي عن محمد بن إسحاق عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4775","418 - (  4774  ) -  حَدَّثَنَا  عُقْبَةُ ،  حَدَّثَنَا  يُونُسُ ،  حَدَّثَنَا  السَّرِيُّ بْنُ إِسْمَاعِيلَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْمُرُ بِفِرَاشِهِ ، فَيُفْرَشُ لَهُ ، فَيَسْتَقْبِلُ الْقِبْلَةَ  ، فَإِذَا أَوَى إِلَيْهِ تَوَسَّدَ كَفَّهُ الْيُمْنَى ، ثُمَّ هَمَسَ ، مَا نَدْرِي مَا يَقُولُ ، فَإِذَا كَانَ فِي آخِرِ ذَلِكَ رَفَعَ صَوْتَهُ ، فَقَالَ : اللَّهُمَّ رَبَّ السَّمَاوَاتِ السَّبْعِ ، وَرَبَّ الْعَرْشِ الْعَظِيمِ ،  إِلَهَ - أَوْ رَبَّ  - كُلِّ شَيْءٍ ، مُنْزِلَ التَّوْرَاةِ وَالْإِنْجِيلِ  وَالْفُرْقَانِ  ،  فَالِقَ         [8/211]      الْحَبِّ وَالنَّوَى ، أَعُوذُ بِكَ مِنْ شَرِّ كُلِّ شَيْءٍ أَنْتَ آخِذٌ بِنَاصِيَتِهِ .  اللَّهُمَّ أَنْتَ الْأَوَّلُ الَّذِي لَيْسَ قَبْلَكَ شَيْءٌ ، وَالْآخِرُ الَّذِي لَيْسَ بَعْدَكَ شَيْءٌ ، وَأَنْتَ الظَّاهِرُ فَلَيْسَ فَوْقَكَ شَيْءٌ ، وَأَنْتَ الْبَاطِنُ فَلَيْسَ دُونَكَ شَيْءٌ ، اقْضِ عَنَّا الدَّيْنَ ، وَأَغْنِنَا مِنَ الْفَقْرِ  .","","Musnad Abi Ya'la al-Mawsili 4774","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن الشعبي عن السري بن إسماعيل الهمداني عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4776","419 - (  4775  ) -  حَدَّثَنَا  عُقْبَةُ ،  حَدَّثَنَا  يُونُسُ ،  حَدَّثَنَا  الْحَجَّاجُ بْنُ أَبِي زَيْنَبَ ،  عَنْ  طَلْحَةَ مَوْلَى ابْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ قَالَتْ :  مَاتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ خَمِيصُ الْبَطْنِ  .         [8/212]","","Musnad Abi Ya'la al-Mawsili 4775","","عائشة بنت أبي بكر الصديق عن طلحة مولى ابن الزبير عن حجاج  بن أبي زينب الصيقل عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4777","420 - (  4776  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ ،  حَدَّثَنَا  جُوَيْرِيَةُ ،  عَنْ  نَافِعٍ ، أَنَّ سَائِبَةَ ،  أَخْبَرَتْهُ  أَنَّ  عَائِشَةَ زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ قَتْلِ الْحَيَّاتِ ، إِلَّا الْأَبْتَرَ وَذَا  الطُّفْيَتَيْنِ  ، إِنَّهُمَا يَخْطَفَانِ الْأَبْصَارَ ، وَيُسْقِطَانِ مَا فِي بُطُونِ النِّسَاءِ ، فَمَنْ تَرَكَهُمَا فَلَيْسَ مِنَّا  .","","Musnad Abi Ya'la al-Mawsili 4776","","عائشة بنت أبي بكر الصديق عن سائبة مولاة الفاكه بن المغيرة عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4778","421 - (  4777  ) -  حَدَّثَنَا  مَسْرُوقُ بْنُ الْمَرْزُبَانِ ،  حَدَّثَنَا  ابْنُ أَبِي زَائِدَةَ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  يَحْيَى بْنِ عَبَّادٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  دَخَلَ عَلَيَّ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَتَغَشَّاهُ مِنَ اللهِ مَا كَانَ يَتَغَشَّاهُ  ،  فَسُجِّيَ  بِثَوْبِهِ ، وَوُضِعَتْ وِسَادَةٌ مِنْ أَدِيمٍ تَحْتَ رَأْسِهِ ، ثُمَّ جَلَسَ وَإِنَّهُ لَيَتَحَدَّرُ مِنْهُ مِثْلُ  الْجُمَانِ  ، وَهُوَ يَمْسَحُ عَنْهُ  .         [8/213]","","Musnad Abi Ya'la al-Mawsili 4777","","عائشة بنت أبي بكر الصديق عن عباد بن عبد الله بن الزبير بن العوام عن يحيى بن عباد بن عبد الله بن الزبير بن العوام عن محمد بن إسحاق عن يحيى بن زكريا بن أبي زائدة عن مسروق بن المرزبان الكندي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4779","422 - (  4778  ) -  حَدَّثَنَا  مَسْرُوقُ بْنُ الْمَرْزُبَانِ ،  حَدَّثَنَا  ابْنُ أَبِي زَائِدَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا نَزَلَ عَلَيْهِ ، وَجَدَ مَا قَالَ اللهُ عَزَّ وَجَلَّ :         {      إِنَّا سَنُلْقِي عَلَيْكَ قَوْلا ثَقِيلا         }      .","","Musnad Abi Ya'la al-Mawsili 4778","","عائشة بنت أبي بكر الصديق عن عمرو بن علقمة بن وقاص الليثي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يحيى بن زكريا بن أبي زائدة عن مسروق بن المرزبان الكندي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4780","423 - (  4779  ) -  حَدَّثَنَا  سُفْيَانُ بْنُ وَكِيعٍ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي حُمَيْدٍ ،  عَنْ  أَبِي مَلِيحٍ قَالَ :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ رَبَاحٍ الْأَنْصَارِيُّ ،  أَنَّ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي الرَّكْعَتَيْنِ قَبْلَ طُلُوعِ الْفَجْرِ  ، ثُمَّ يَقُولُ فِي مُصَلَاهُ : اللَّهُمَّ رَبَّ  جِبْرِيلَ  وَمِيكَائِيلَ  ، وَرَبَّ  إِسْرَافِيلَ  ، وَرَبَّ  مُحَمَّدٍ  ، أَعُوذُ بِكَ مِنَ النَّارِ ، ثُمَّ يَخْرُجُ إِلَى صَلَاتِهِ  .         [8/214]","","Musnad Abi Ya'la al-Mawsili 4779","","عائشة بنت أبي بكر الصديق عن عبد الله بن رباح الأنصاري عن أبو المليح بن أسامة الهذلي عن عبيد الله بن أبي حميد الهذلي عن وكيع بن الجراح عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4781","424 - (  4780  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي عُبَيْدَةَ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  تَمِيمٍ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ قَالَ :  قَالَتْ  عَائِشَةُ :  تَبَارَكَ الَّذِي وَسِعَ سَمْعُهُ كُلَّ شَيْءٍ ، إِنِّي لَأَسْمَعُ كَلَامَ  خَوْلَةَ بِنْتِ ثَعْلَبَةَ  وَيَخْفَى عَلَيَّ بَعْضُهُ  ، وَهِيَ تَشْتَكِي زَوْجَهَا إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهِيَ تَقُولُ : يَا رَسُولَ اللهِ ، أَكَلَ شَبَابِي ،  وَنَثَرْتُ  لَهُ بَطْنِي ، حَتَّى إِذَا كَبِرَ سِنِّي ، وَانْقَطَعَ وَلَدِي ، ظَاهَرَ مِنِّي ، اللَّهُمَّ إِنِّي أَشْكُو إِلَيْكَ ، قَالَتْ : فَمَا بَرِحَتْ حَتَّى نَزَلَ  جِبْرِيلُ  بِهَذِهِ الْآيَاتِ :         {      قَدْ سَمِعَ اللهُ قَوْلَ الَّتِي تُجَادِلُكَ فِي زَوْجِهَا وَتَشْتَكِي إِلَى اللهِ         }      .         [8/215]","","Musnad Abi Ya'la al-Mawsili 4780","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن تميم بن سلمة السلمي عن الأعمش عن عبد الملك بن معن المسعودي عن محمد بن أبي عبيدة المسعودي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4782","425 - (  4781  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا  عَبْدَةُ ،  عَنْ  هِشَامٍ ،  عَنْ  صَالِحِ بْنِ رَبِيعَةَ بْنِ هُدَيْرٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  أُوحِيَ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا مَعَهُ ، فَقُمْتُ ،  فَأَجَفْتُ  الْبَابَ بَيْنِي وَبَيْنَهُ ، فَلَمَّا رَحُبَ عَنْهُ قَالَ :  يَا  عَائِشَةُ  ، إِنَّ  جِبْرِيلَ  يُقْرِئُكِ  السَّلَامَ  .         [8/216]","","Musnad Abi Ya'la al-Mawsili 4781","","عائشة بنت أبي بكر الصديق عن صالح بن ربيعة بن الهدير التيمي عن هشام بن عروة بن الزبير عن عبدة بن سليمان الكلابي عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4783","426 - (  4782  ) -  حَدَّثَنَا  عَبَّادُ بْنُ مُوسَى ،  حَدَّثَنَا  ابْنُ الْمُبَارَكِ ،  أَخْبَرَنِيهِ  يُونُسُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا أَرَادَ أَنْ يَنَامَ وَهُوَ  جُنُبٌ  ، تَوَضَّأَ وُضُوءَهُ لِلصَّلَاةِ  ، فَإِذَا أَرَادَ أَنْ يَأْكُلَ غَسَلَ يَدَيْهِ ، ثُمَّ أَكَلَ  .","","Musnad Abi Ya'la al-Mawsili 4782","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن المبارك عن عباد بن موسى الختلي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4784","427 - (  4783  ) -  حَدَّثَنَا  عَبَّادُ بْنُ مُوسَى ،  حَدَّثَنَا  ابْنُ الْمُبَارَكِ ،  أَخْبَرَنِي  يُونُسُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَائِشَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا وَفَاءَ لِنَذْرٍ فِي مَعْصِيَةِ         [8/217]      اللهِ  ، وَكَفَّارَتُهُ كَفَّارَةُ يَمِينٍ  .         [8/218]","","Musnad Abi Ya'la al-Mawsili 4783","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن المبارك عن عباد بن موسى الختلي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4785","428 - (  4784  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ،  حَدَّثَنَا  أَبُو أَحْمَدَ الزُّبَيْرِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ يَعْلَى الطَّائِفِيُّ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْقَاسِمِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  مَا نَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَبْلَ الْعِشَاءِ  ، وَلَا  سَمَرَ  بَعْدَهَا  .         [8/219]","","Musnad Abi Ya'la al-Mawsili 4784","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن عبد الله بن عبد الرحمن بن يعلى الطائفي عن محمد بن عبد الله بن الزبير عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4786","429 - (  4785  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى ،  حَدَّثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  أَفْلَحُ بْنُ حُمَيْدٍ ،  أَنَّهُ سَمِعَ  الْقَاسِمَ بْنَ مُحَمَّدٍ  يُحَدِّثُ ، عَنْ  عَائِشَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَاقَعَ أَهْلَهُ وَلَمْ يَغْتَسِلْ حَتَّى أَصْبَحَ  ، ثُمَّ اغْتَسَلَ وَصَلَّى ، وَصَامَ يَوْمَهُ ذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 4785","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن أفلح ابن صفيراء عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4787","430 - (  4786  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى ،  حَدَّثَنَا  بِشْرُ بْنُ بَكْرٍ ،  حَدَّثَنِي  الْأَوْزَاعِيُّ ،  حَدَّثَنِي  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  حَدَّثَنِي  أَبُو سَلَمَةَ ،  حَدَّثَتْنِي  عَائِشَةُ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي رَكْعَتَيْنِ         [8/220]      خَفِيفَتَيْنِ بَيْنَ  النِّدَاءِ  وَالْإِقَامَةِ  .","","Musnad Abi Ya'la al-Mawsili 4786","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن بشر بن بكر التنيسي عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4788","431 - (  4787  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى ،  حَدَّثَنَا  بِشْرُ بْنُ بَكْرٍ ،  حَدَّثَنِي  الْأَوْزَاعِيُّ ،  حَدَّثَنِي  الزُّهْرِيُّ ،  حَدَّثَنِي  عُرْوَةُ بْنُ الزُّبَيْرِ ،  حَدَّثَتْنِي  عَائِشَةُ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي فِيمَا بَيْنَ صَلَاةِ الْعِشَاءِ الْآخِرَةِ إِلَى أَنْ يَنْصَدِعَ الْفَجْرُ إِحْدَى عَشْرَةَ رَكْعَةً  يُسَلِّمُ بَيْنَ كُلِّ ثِنْتَيْنِ ، وَيُوتِرُ بِوَاحِدَةٍ ، وَيَمْكُثُ فِي سُجُودِهِ بِقَدْرِ مَا         [8/221]      يَقْرَأُ أَحَدُكُمْ خَمْسِينَ آيَةً ، فَإِذَا سَكَتَ الْمُؤَذِّنُ الْأَوَّلُ لِصَلَاةِ الْفَجْرِ ، قَامَ فَرَكَعَ رَكْعَتَيْنِ خَفِيفَتَيْنِ ، ثُمَّ اضْطَجَعَ عَلَى شِقِّهِ الْأَيْمَنِ حَتَّى يَأْتِيَهُ الْمُؤَذِّنُ  .","","Musnad Abi Ya'la al-Mawsili 4787","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن أبو عمرو الأوزاعي عن بشر بن بكر التنيسي عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4789","432 - (  4788  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  ابْنُ وَهْبٍ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  أَبِي النَّضْرِ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَائِشَةَ :  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَرَجَ لَيْلَةً مِنْ رَمَضَانَ إِلَى الْمَسْجِدِ بَعْدَ الْعِشَاءِ فَصَلَّى ، فَرَآهُ نَاسٌ فَصَلَّوْا بِصَلَاتِهِ ، فَلَمَّا كَانَتِ الثَّانِيَةُ خَرَجَ أَيْضًا ، فَرَآهُ النَّاسُ فَثَابُوا وَكَبَّرُوا وَصَلَّوْا بِصَلَاتِهِ ، فَلَمَّا كَانَتِ اللَّيْلَةُ الثَّالِثَةُ مُلِئَ الْمَسْجِدُ ، فَلَمْ يَخْرُجْ عَلَيْهِمْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَعَلُوا كَأَنَّهُمْ يُؤْذِنُونَهُ لِيَخْرُجَ إِلَيْهِمْ ، فَقَالَ : يَا  عَائِشَةُ  ، مَا بَالُ النَّاسِ ؟ فَقُلْتُ : يَا رَسُولَ اللهِ ، صَلَّوْا مَعَكَ هَاتَيْنِ اللَّيْلَتَيْنِ ، فَأَحَبُّوا أَنْ تَخْرُجَ إِلَيْهِمْ ، ثُمَّ خَرَجَ إِلَيْهِمْ ، فَقَالَ :  أَيُّهَا النَّاسُ ، عَلَيْكُمْ مِنَ الْأَعْمَالِ مَا تُطِيقُونَ ، فَإِنَّ اللهَ لَا  يَمَلُّ  حَتَّى  تَمَلُّوا  ، وَإِنَّ أَحَبَّ الْأَعْمَالِ إِلَى اللهِ دَوْمُهَا وَإِنْ قَلَّ ، مَا زِلْتُمْ حَتَّى خَشِيتُ أَنْ تُكْتَبَ عَلَيْكُمْ .  قَالَتْ  عَائِشَةُ  : فَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي إِحْدَى عَشْرَةَ         [8/222]      قَائِمًا ، وَرَكْعَتَيْنِ جَالِسًا ، فَإِذَا أَرَادَ أَنْ يَرْكَعَ قَامَ فَقَرَأَ ، ثُمَّ رَكَعَ ، ثُمَّ يُوتِرُ بِوَاحِدَةٍ .  قَالَ  أَبُو سَلَمَةَ  : فَقُلْتُ : كَيْفَ كَانَتْ صَلَاتُهُ فِي شَهْرِ رَمَضَانَ ؟ قَالَتْ : مَا كَانَ يَزِيدُ فِي شَهْرِ رَمَضَانَ عَلَى هَذَا .         [8/223]","","Musnad Abi Ya'la al-Mawsili 4788","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن سالم بن أبي أمية التيمي عن عبد الله بن عمر العمري عن عبد الله بن وهب المصري عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4790","433 - (  4789  ) -  حَدَّثَنَا  عَمْرٌو النَّاقِدُ ،  حَدَّثَنَا  مُعَمَّرُ بْنُ سُلَيْمَانَ الرَّقِّيُّ ،  حَدَّثَنَا  خُصَيْفٌ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ لُبْسِ الْحَرِيرِ ، وَالذَّهَبِ  ، وَالشُّرْبِ فِي آنِيَةِ الْفِضَّةِ ، وَعَنِ الْمِيثَرَةِ الْحَمْرَاءِ ، قَالَتْ  عَائِشَةُ  : قُلْتُ : يَا رَسُولَ اللهِ ، شَيْءٌ  ذَفِيفٌ  مِنَ الذَّهَبِ يُرْبَطُ بِهِ  الْمَسَكُ  ؟ قَالَ : اجْعَلِيهِ فِضَّةً ، وَصَفِّرِيهِ بِشَيْءٍ مِنْ زَعْفَرَانَ .","","Musnad Abi Ya'la al-Mawsili 4789","","عائشة بنت أبي بكر الصديق عن مجاهد بن جبر المخزومي عن خصيف الجزري عن معمر بن سليمان النخعي عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4791","434 - (  4790  ) -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنِ  الْمِقْدَامِ بْنِ شُرَيْحٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  مَنْ حَدَّثَكَ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَبُولُ         [8/224]      قَائِمًا ، فَكَذِّبْهُ  ، إِنِّي رَأَيْتُهُ يَبُولُ قَاعِدًا  .         [8/225]","","Musnad Abi Ya'la al-Mawsili 4790","","عائشة بنت أبي بكر الصديق عن شريح بن هانئ المذحجي عن المقدام بن شريح الحارثي عن شريك بن عبد الله النخعي عن عبد الرحمن بن صالح العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4792","435 - (  4791  ) -  حَدَّثَنَا  عَبْدُ الْجَبَّارِ بْنُ عَاصِمٍ قَالَ :  حَدَّثَنِي  مُوسَى بْنُ أَعْيَنَ الْحَرَّانِيُّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُصَلِّي بِاللَّيْلِ تِسْعَ رَكَعَاتٍ  .","","Musnad Abi Ya'la al-Mawsili 4791","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن موسى بن أعين الجزري عن عبد الجبار بن عاصم الخراساني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4793","436 - (  4792  ) -  حَدَّثَنَا  عَبْدُ الْجَبَّارِ بْنُ عَاصِمٍ ،  حَدَّثَنِي  بَقِيَّةُ بْنُ الْوَلِيدِ الْحِمْصِيُّ أَبُو يُحْمِدَ ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ الزُّبَيْدِيِّ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  رُبَّمَا اكْتَحَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ صَائِمٌ  .         [8/226]","","Musnad Abi Ya'la al-Mawsili 4792","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن سعيد بن عبد الجبار الزبيدي عن بقية بن الوليد عن عبد الجبار بن عاصم الخراساني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4794","437 - (  4793  ) -  حَدَّثَنَا  هَنَّادُ بْنُ السَّرِيِّ ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي مِنَ اللَّيْلِ تِسْعَ رَكَعَاتٍ  .","","Musnad Abi Ya'la al-Mawsili 4793","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن سلام بن سليم الحنفي عن هناد بن السري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4795","438 - (  4794  ) -  حَدَّثَنَا  الْمُعَلَّى بْنُ مَهْدِيٍّ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْأَسْوَدِ قَالَ :  سَأَلْتُ  عَائِشَةَ عَنْ صَلَاةِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِاللَّيْلِ ؟ فَقَالَتْ :  كَانَ يَنَامُ أَوَّلَ اللَّيْلِ ، وَيَقُومُ آخِرَهُ ، فَيُصَلِّي مَا قُضِيَ لَهُ ، فَإِذَا قَضَى صَلَاتَهُ ، مَالَ إِلَى فِرَاشِهِ  ، فَإِنْ كَانَتْ لَهُ حَاجَةٌ إِلَى أَهْلِهِ أَتَى أَهْلَهُ ، ثُمَّ نَامَ كَهَيْئَتِهِ لَمْ يَمَسَّ مَاءً ، فَإِذَا سَمِعَ الْأَذَانَ الْأَوَّلَ - أَوِ الْمُنَادِيَ - قَامَ ، فَإِنْ كَانَ  جُنُبًا  ، اغْتَسَلَ ، وَإِنْ لَمْ يَكُنْ  جُنُبًا  ، تَوَضَّأَ وُضُوءَهُ لِلصَّلَاةِ ، ثُمَّ صَلَّى رَكْعَتَيْنِ ، ثُمَّ خَرَجَ إِلَى الْمَسْجِدِ  .         [8/227]","","Musnad Abi Ya'la al-Mawsili 4794","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن أبو إسحاق السبيعي عن الوضاح بن عبد الله اليشكري عن معلى بن مهدي الموصلي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4796","439 - (  4795  ) -  حَدَّثَنَا  هَنَّادُ بْنُ السَّرِيِّ ،  حَدَّثَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ،  عَنِ  الْمَسْعُودِيِّ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَعْقِلٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا صَلَّى قَائِمًا رَكَعَ قَائِمًا  ، وَإِذَا صَلَّى قَاعِدًا رَكَعَ قَاعِدًا  .","","Musnad Abi Ya'la al-Mawsili 4795","","عائشة بنت أبي بكر الصديق عن عبد الله بن معقل المحاربي عن يونس بن عبيد عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن عبدة بن سليمان الكلابي عن هناد بن السري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4797","440 - (  4796  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  ابْنُ أَبِي زَائِدَةَ ،  عَنْ  حَارِثَةَ بْنِ مُحَمَّدٍ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ يَقُومُ لِلْوُضُوءِ يَكْفَأُ الْإِنَاءَ ، فَيُسَمِّي اللهَ  ، ثُمَّ يُسْبِغُ الْوُضُوءَ  .         [8/228]","","Musnad Abi Ya'la al-Mawsili 4796","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن حارثة بن أبي الرجال النجاري عن يحيى بن زكريا بن أبي زائدة عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4798","441 - (  4797  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى بْنِ عَبْدِ اللهِ بْنِ أَبِي سَعِيدٍ الرَّقَاشِيُّ بَصْرِيٌّ ،  حَدَّثَنَا  ابْنُ هِلَالٍ أَبُو النَّضْرِ ،  حَدَّثَنَا  أَيُّوبُ السَّخْتِيَانِيُّ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ فِي الصَّلَاةِ عَلَى الْمَيِّتِ : اللَّهُمَّ اغْفِرْ لَهُ ، وَصَلِّ عَلَيْهِ  ، وَبَارِكْ فِيهِ ، وَأَوْرِدْهُ حَوْضَ رَسُولِكَ  .","","Musnad Abi Ya'la al-Mawsili 4797","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أيوب السختياني عن عاصم بن هلال البارقي عن زكريا بن يحيى بن عبد الله الرقاشي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4799","442 - (  4798  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى الرَّقَاشِيُّ ،  حَدَّثَنَا  يُوسُفُ بْنُ خَالِدٍ ،  حَدَّثَنَا  مُوسَى الْمَكِّيُّ ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنْ  عَائِشَةَ بِنْتِ سَعْدٍ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لِيُصَلِّ  أَبُو بَكْرٍ  بِالنَّاسِ  ، قَالُوا : يَا رَسُولَ اللهِ ، لَوْ أَمَرْتَ غَيْرَهُ أَنْ يُصَلِّيَ ؟ قَالَ : لَا يَنْبَغِي لِأُمَّتِي أَنْ يَؤُمَّهُمْ إِمَامٌ وَفِيهِمْ  أَبُو بَكْرٍ  .         [8/229]","","Musnad Abi Ya'la al-Mawsili 4798","","عائشة بنت أبي بكر الصديق عن عائشة بنت سعد بن أبي وقاص عن موسى بن طلحة بن عبيد الله التيمي عن موسى بن دينار المكي عن يوسف بن خالد السمتي عن زكريا بن يحيى بن عبد الله الرقاشي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4800","443 - (  4799  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى ،  حَدَّثَنَا  وَكِيعٌ ، وَعَبْدُ اللهِ بْنُ دَاوُدَ ، وَعَثَّامُ بْنُ عَلِيٍّ ، وَعُبَيْدُ اللهِ بْنُ مُوسَى ،  عَنِ  الْأَعْمَشِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تُصَلِّي الْمُسْتَحَاضَةُ ، وَإِنْ قَطَرَ الدَّمُ عَلَى الْحَصِيرِ  . قَالَ  ابْنُ دَاوُدَ  :  قَطْرًا  .","","Musnad Abi Ya'la al-Mawsili 4799","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن حبيب بن أبي ثابت الكاهلي عن الأعمش عن عبيد الله بن موسى عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
