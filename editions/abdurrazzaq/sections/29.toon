hadiths[605]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"16941","عَنِ ابْنِ جُرَيْجٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ،  أَنَّهُ كَانَيُسَاوِي بَيْنَ الأَسْنَانِ فِي الْعَقْلِ ""","","","","","Book of Blood Money (Diyat)"
"16942","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  قَضَى فِيالسِّنِّ بِخَمْسٍ مِنَ الإِبِلِ "", قَالَ طَاوُسٌ : وَتَفْضُلُ كُلُّ سَنٍّ عَلَى الَّتِي تَلِيهَا بِمَا يَرَى أَهْلُ الرَّأْيِ وَالْمَشُورَةِ""","","","","","Book of Blood Money (Diyat)"
"16943","عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : قُلْتُ لَهُ : مِنْ أَيْنَ نَبْدَأُ ؟ قَالَ : الثَّنِيَّتَانِ خَيْرُ الأَسْنَانِ ""","","","","","Book of Blood Money (Diyat)"
"16944","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، عَنْ عَلِيٍّ , قَالَ :  فِيالسِّنِّ خَمْسٌ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"16945","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، عَنْ شُرَيْحٍ ، أَنَّ عُمَرَ , كَتَبَ إِلَيْهِ :  أَنَّالأَسْنَانَ سَوَاءٌ ""","","","","","Book of Blood Money (Diyat)"
"16946","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ , قَالا :  فِيكُلِّ سَنٍّ خَمْسٌ مِنَ الإِبِلِ ، وَالأَضْرَاسُ ، وَالأَسْنَانُ سَوَاءٌ ""","","","","","Book of Blood Money (Diyat)"
"16947","عَنْ مَالِكٍ ، عَنْ دَاوُدَ بْنِ الْحُصَيْنِ ، عَنْ أَبِي غَطَفَانَ : أَنَّ مَرْوَانَ أَرْسَلَهُ إِلَى ابْنِ عَبَّاسٍ , يَسْأَلُهُمَاذَا جَعَلَ فِي الضِّرْسِ ؟ فَقَالَ :  فِيهِ خَمْسٌ مِنَ الإِبِلِ "" , قَالَ : فَرَدَّنِي إِلَى ابْنِ عَبَّاسٍ , فَقَالَ : أَتَجْعَلُ مُقَدَّمَ الْفَمِ مِثْلَ الأَضْرَاسِ ؟ فَقَالَ ابْنُ عَبَّاسٍ : "" لَوْ أَنَّكَ لا تَعْتَبِرُ ذَلِكَ إِلا بِالأَصَابِعِ ، عَقْلُهَا سَوَاءٌ ""","","","","","Book of Blood Money (Diyat)"
"16948","عَنِ ابْنِ جُرَيْجٍ ، وَالثَّوْرِيِّ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ مُسْلِمِ بْنِ جُنْدُبٍ ، عَنْ أَسْلَمَ مَوْلَى عُمَرَ , أَنَّ عُمَرَ , قَالَ :  وَفِيالضِّرْسِ جَمَلٌ ""","","","","","Book of Blood Money (Diyat)"
"16949","عَنْ مَعْمَرٍ ، عَنِ ابْنِ شُبْرُمَةَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ  جَعَلَ فِيكُلِّ ضِرْسٍ خَمْسًا مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"16950","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :الأَسْنَانُ ؟ قَالَ :  فِي الثَّنِيَّتَيْنِ ، وَالرُّبَاعِيَّتَيْنِ ، وَالنَّابَيْنِ , خَمْسٌ خَمْسٌ ، وَفِيمَا بَقِي بَعِيرَانِ بَعِيرَانِ ، أَعْلَى الْفَمِ وَأَسْفَلُهُ ، كُلُّ ذَلِكَ سَوَاءٌ وَالأَضْرَاسُ سَوَاءٌ ""","","","","","Book of Blood Money (Diyat)"
"16951","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ شُعَيْبٍ ، عَنْ أَبِيهِ ، عَنْ جَدِّهِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو , قَالَ :  قَضَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيالأَصَابِعِ ، وَالأَسْنَانِ سَوَاءٌ ""","","","","","Book of Blood Money (Diyat)"
"16952","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ , قَالَ : سَمِعْتُ مَكْحُولا , يَقُولُ : الأَصَابِعُ سَوَاءٌ ، وَالأَسْنَانُ سَوَاءٌ "", عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ أَبِي نَجِيحٍ ، أَنَّهُ كَانَ يَقُولُ مِثْلَ قَوْلِ عَطَاءٍ""","","","","","Book of Blood Money (Diyat)"
"16953","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  فِيالسِّنِّ خَمْسٌ مِنَ الإِبِلِ , أَوْ عَدْلُهَا مِنَ الذَّهَبِ ، أَوِ الْوَرِقِ , أَوِ الشَّاءِ ""","","","","","Book of Blood Money (Diyat)"
"16954","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : سَمِعْتُ ابْنَ أَبِي مُلَيْكَةَ , يَقُولُ : خَالَفَنِي الْحَارِثُ بْنُ عَبْدِ اللَّهِ بْنِ أَبِي رَبِيعَةَ , عِنْدَ عَلْقَمَةَ فِي الأَسْنَانِ , فَقَالَ : فَضَّلَ مُعَاوِيَةُ الأَضْرَاسَ عَلَى غَيْرِهَا "", فَقُلْتُ : كَلا ، وَلَوْ كَانَ مُفَضِّلا لَفَضَّلَ الثَّنَايَا""","","","","","Book of Blood Money (Diyat)"
"16955","عَنِ ابْنِ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى , قَالَ : فِي كِتَابٍ لِعُمَرَ بْنِ عَبْدِ الْعَزِيزِ  وَفِيالأَسْنَانِ خَمْسٌ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"16956","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ مُسْلِمٍ ، أَنَّهُ سَمِعَ طَاوُسًا , يَقُولُ : يُفَضَّلُ النَّابُ فِي أَعْلَى الْفَمِ ، وَأَسْفَلِهِ عَلَى الأَضْرَاسِ "" , وَأَنَّهُ قَالَ : "" فِي الأَضْرَاسِ صِغَارُ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"16957","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَسْنَانُ الْمَرْأَةِ تُصَابُ جَمِيعًا ؟ قَالَ : "" خَمْسُونَ ""","","","","","Book of Blood Money (Diyat)"
"16958","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ سَعِيدٍ , قَالَ : قَالَ سَعِيدُ بْنُ الْمُسَيِّبِ :  قَضَى عُمَرُ بْنُ الْخَطَّابِفِيمَا أَقْبَلَ مِنَ الْفَمِ , أَعْلَى الْفَمِ وَأَسْفَلِهِ بِخَمْسِ قَلائِصَ ، وَفِي الأَضْرَاسِ بِبَعِيرٍ بَعِيرٍ "" ، حَتَّى إِذَا كَانَ مُعَاوِيَةُ ، وَأُصِيبَتْ أَضْرَاسُهُ , قَالَ : أَنَا أَعْلَمُ بِالأَضْرَاسِ مِنْ عُمَرَ , فَقَضَى فِيهَا بِخَمْسٍ خَمْسٍ، قَالَ سَعِيدٌ : "" وَلَوْ أُصِيبَ الْفَمُ كُلُّهُ فِي قَضَاءِ عُمَرَ , لَنَقَصَتِ الدِّيَةُ , وَلَوْ أُصِيبَ فِي قَضَاءِ مُعَاوِيَةَ لَزَادَتْ ، وَلَوْ كُنْتُ أَنَا لَجَعَلْتُ فِي الأَضْرَاسِ بَعِيرَيْنِ بَعِيرَيْنِ , فَذَلِكَ الدِّيَةُ كَامِلَةً ""","","","","","Book of Blood Money (Diyat)"
"16959","عَنِ الثَّوْرِيِّ ، عَنْ أَزْهَرَ بْنِ مُحَارِبٍ , قَالَ : اخْتَصَمَ إِلَى شُرَيْحٍرَجُلانِ أَصَابَ أَحَدُهُمَا ثَنِيَّةَ الآخَرِ ، وَأَصَابَ الآخَرُ ضِرْسَهُ ، فَقَالَ شُرَيْحٌ :  الثَّنِيَّةُ ، وَجَمَالُهَا ، وَالضِّرْسُ وَمَنْفَعَتُهُ , سِنًّا بِسِنٍّ قُرِنَا "", قَالَ الثَّوْرِيُّ : وَقَالَ غَيْرُهُ : "" الثَّنِيَّةُ بِالثَّنِيَّةِ ، وَالضِّرْسُ بِالضِّرْسِ ""","","","","","Book of Blood Money (Diyat)"
"16960","عَنِ الْحَجَّاجِ بْنِ أَرْطَاةَ ، عَنْ مَكْحُولٍ ، عَنْ زَيْدِ بْنِ ثَابِتٍ , قَالَ :  فِيالسِّنِّ يُسْتَأْنَى بِهَا سَنَةً ، فَإِنِ اسْوَدَّتْ فَفِيهَا الْعَقْلُ كَامِلا ، وَإِلا فَمَا اسْوَدَّ مِنْهَا فَبِحِسَابِ ذَلِكَ "", عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنْ مُحَمَّدٍ ، عَنْ شُرَيْحٍ ، مِثْلَهِ""","","","","","Book of Blood Money (Diyat)"
"16961","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : يُسْتَأْنَى بِهَا سَنَةً ، فَإِنِ اسْوَدَّتْ فَفِيهَا دِيَتُهَا ، وَإِلا فَفِيهَا الْحُكْمُ ""","","","","","Book of Blood Money (Diyat)"
"16962","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْعَزِيزِ بْنُ عُمَرَ , أَنَّ فِي كِتَابٍ لِعُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ , قَالَ :  وَفِيالسِّنِّ خَمْسٌ مِنَ الإِبِلِ , أَوْ عَدْلُهَا مِنَ الذَّهَبِ , أَوِ الْوَرِقِ ، فَإِنِ اسْوَدَّتْ فَقَدْ تَمَّ عَقْلُهَا ، فَإِنْ كُسِرَ مِنْهَا إِذَا لَمْ تَسْوَدَّ فَبِحِسَابِ ذَلِكَ ، وَفِي سَنِّ الْمَرْأَةِ مِثْلُ ذَلِكَ ""","","","","","Book of Blood Money (Diyat)"
"16963","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ :  فِيالسِّنِّ يُسْتَأْنَى بِهَا ، فَإِنِ اسْوَدَّتْ فِيمَا بَيْنَهَا وَبَيْنَ سَنَةٍ تَمَّ عَقْلُهَا ""","","","","","Book of Blood Money (Diyat)"
"16964","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ :  إِنْقُصِمَتِ السِّنُّ ، وَلَمْ تَسْوَدَّ فَعَلَى حِسَابِ مَا نَقَصَ مِنْهَا "" , وَقَالَ قَتَادَةُ : "" مَا كَسَرَهُ مِنَ الثَّنِيَّةِ فَبِحِسَابِهِ ""","","","","","Book of Blood Money (Diyat)"
"16965","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ :  إِنْسَقَطَتْ سَنٌّ , أَوْ رَجَفَتْ , أَوِ اسْوَدَّتْ فَسَوَاءٌ ، قَدْ مَاتَتْ ""","","","","","Book of Blood Money (Diyat)"
"16966","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ ، عَنْ عَلِيٍّ :  فِيالسِّنِّ تُصَابُ , قَالَ : "" إِنِ اسْوَدَّتْ فَنَذْرُهَا وَافٍ ""","","","","","Book of Blood Money (Diyat)"
"16967","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي دَاوُدُ بْنُ أَبِي عَاصِمٍ , قَالَ : كَفَتْكَ ، أَنَّ عَبْدَ الْمَلِكِ  قَضَى فِيالسِّنِّ تُصَابُ فَتَسْوَدُّ , بِنَذْرِهَا وَافِيًا ""","","","","","Book of Blood Money (Diyat)"
"16968","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ شِهَابٍ  فِيالسِّنِّ إِذَا اسْوَدَّتْ فَقَدْ تَمَّ عَقْلُهَا ""","","","","","Book of Blood Money (Diyat)"
"16969","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْعَزِيزِ بْنُ عُمَرَ , قَالَ : مِمَّا اجْتَمَعَ لِعُمَرَ بْنِ عَبْدِ الْعَزِيزِ , قَالَ : فَإِنْ أُصِيبَتِ السِّنُّ فَانْصَدَعَتْ وَهِيَ بَيْضَاءُ صَحِيحَةٌ ، وَلَمْ يَسْقُطْ مِنْهَا شَيْءٌ , فَفِي صَدْعِهَا نِصْفُ دِيَتِهَا ""","","","","","Book of Blood Money (Diyat)"
"16970","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ , قَالَ أَبُو سَعِيدٍ : أَظُنُّهُ عَنْ عَلِيٍّ , قَالَ :  فِيالسِّنِّ تُصَابَ وَيَخْشَوْنَ أَنْ تَسْوَدَّ يَنْتَظِرُ بِهَا سَنَةً ، فَإِنِ اسْوَدَّتْ فَفِيهَا نَذْرُهَا وَافِيًا ، وَإِنْ لَمْ تَسْوَدَّ فَلَيْسَ فِيهَا شَيْءٌ "", قَالَ عَبْدُ الْكَرِيمِ : وَيَقُولُونَ : "" فَإِنِ اسْوَدَّتْ بَعْدَ سَنَةٍ فَلَيْسَ فِيهَا شَيْءٌ ""","","","","","Book of Blood Money (Diyat)"
"16971","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ :  قَضَى عُمَرُ بْنُ الْخَطَّابِ فِيالسِّنِّ السَّوْدَاءِ ، إِذَا كُسِرَتْ وَالْعَيْنِ الْقَائِمَةِ ، وَالْيَدِ الشَّلاءِ بِثُلُثِ دِيَتِهَا "", عَنْ عُثْمَانَ بْنِ مَطَرٍ ، عَنْ سَعِيدٍ ، عَنْ قَتَادَةَ ، عَنْ عَبْدِ اللَّهِ بْنِ بُرَيْدَةَ ، عَنْ يَحْيَى بْنِ يَعْمُرَ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ عُمَرَ ، مِثْلَهِ""","","","","","Book of Blood Money (Diyat)"
"16972","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ :  فِيالسِّنِّ السَّوْدَاءِ ، إِذَا كُسِرَتْ حُكُومَةُ عَدْلٍ ""","","","","","Book of Blood Money (Diyat)"
"16973","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ :  فِيالسِّنِّ إِذَا أُصِيبَتْ ، فَإِنِ اسْوَدَّتْ فَفِيهَا عَقْلُهَا كَامِلا ، فَإِنْ أُصِيبَتِ الثَّانِيَةُ فَفِيهَا الْعَقْلُ أَيْضًا كَامِلا ""","","","","","Book of Blood Money (Diyat)"
"16974","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :السِّنُّ السَّوْدَاءُ تُطْرَحُ ؟ قَالَ :  فِيهَا شَيْءٌ فِي جَمَالِهَا وَمَسَدُّهَا مَكَانَهَا ، وَلَمْ يَبْلُغْهُ فِي ذَلِكَ شَيْءٌ "" , قُلْتُ لَهُ : فِيهَا شَيْءٌ وَإِنْ كَانَ صَاحِبُهَا قَدْ أَخَذَ بِنَذْرِهَا ؟ قَالَ : "" نَعَمْ ""","","","","","Book of Blood Money (Diyat)"
"16975","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ , قَالَ : إِنِ اسْوَدَّتِ السِّنُّ أَوْ رَجَفَتْ ، ثُمَّ طُرِحَتْ فَنِصْفُ نَذْرِهَا ، وَإِنْ كَانَ أَخَذَ فِيهَا نَذْرَهَا أَوَّلَ مَرَّةٍ "", وَأَمَّا مَعْمَرٌ فَذَكَرَ , عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ : "" فِي السِّنِّ السَّوْدَاءِ رُبُعُ دِيَتِهَا ""","","","","","Book of Blood Money (Diyat)"
"16976","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي دَاوُدُ بْنُ أَبِي عَاصِمٍ ، أَنَّ عَبْدَ الْمَلِكِ  قَضَى فِيالسِّنِّ تُصَابُ فَتَسْوَدُّ بِنَذْرِهَا وَافِيًا ، فَإِنْ طُرِحَتْ بَعْدُ فَذَهَبَتْ , أَنَّ فِيهَا نَذْرَهَا وَافِيًا ""","","","","","Book of Blood Money (Diyat)"
"16977","عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ شِهَابٍ ، عَمَّنْ أَخْبَرَهُ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ :  فِيالسِّنِّ السَّوْدَاءِ تُطْرَحُ ثُلُثُ دِيَتِهَا ""","","","","","Book of Blood Money (Diyat)"
"16978","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ  أَنَّهُ قَضَى فِيالسِّنِّ السَّوْدَاءِ ، إِذَا انْكَسَرَتْ بِثُلُثِ دِيَتِهَا ""","","","","","Book of Blood Money (Diyat)"
"16979","قَالَ الْحَجَّاجُ : عَنْ مَكْحُولٍ ، عَنْ زَيْدِ بْنِ ثَابِتٍ , قَالَ :  فِيالسِّنِّ الزَّائِدَةِ ثُلُثُ السِّنِّ "", عَنِ ابْنِ جُرَيْجٍ ، عَنْ مَكْحُولٍ ، عَنْ زَيْدٍ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"16980","عَنْ مَعْمَرٍ ، سُئِلَ عَنْرَجُلٍ أَصَابَ سَنَّ رَجُلٍ وَهِيَ تَرْفُلُ , قَالَ :  فِيهَا خَمْسٌ وَعِشْرُونَ دِينَارًا ""","","","","","Book of Blood Money (Diyat)"
"16981","عَنْ مَعْمَرٍ ، فِيرَجُلٍ أَصَابَ سَنَّ رَجُلٍ حَتَّى سَأَلَتْ , قَالَ :  فِيهَا حُكْمٌ "" , وَقَالَ : "" إِنِ اصْفَرَّتْ فَفِيهَا حُكْمٌ ""","","","","","Book of Blood Money (Diyat)"
"16982","عَنِ الثَّوْرِيِّ ، عَنِ الشَّعْبِيِّ ،  فِيأَسْنَانِ الصَّبِيِّ الَّذِي لَمْ يُثْغِرْ , قَالَ : لَيْسَ عَلَيْهِ شَيْءٌ "", وَقَالَ غَيْرُهُ : "" حُكْمٌ ""","","","","","Book of Blood Money (Diyat)"
"16983","عَنْ حُمَيْدٍ ، عَنِ الْحَجَّاجِ ، عَنْ عَمْرِو بْنِ مَالِكٍ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ  جَعَلَ فِيأَسْنَانِ الصَّبِيِّ الَّذِي لَمْ يُثْغِرْ بَعِيرًا بَعِيرًا ""","","","","","Book of Blood Money (Diyat)"
"16984","عَنْ أَبِي حَنِيفَةَ , قَالَ :  فِيهِ حُكْمٌ "" , قَالَ زَيْدُ بْنُ ثَابِتٍ :"" فِيهِ عَشَرَةُ دَنَانِيرَ ""","","","","","Book of Blood Money (Diyat)"
"16985","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي هِشَامٌ ، عَنِ ابْنِ سِيرِينَ ، عَنْ عُبَيْدَةَ  أَنَّهُ جَعَلَ فِيأَسْنَانِ الصَّغِيرِ الَّذِي لَمْ يُثْغِرْ شَيْئًا لا يَحْفَظُهُ "" . عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مَكْحُولٌ , أَنَّهُ قَالَ : "" فِي أَسْنَانِ الَّذِي لَمْ يُثْغِرْ فِي كُلِّ سَنٍّ قَلُوصٌ سَوَاءٌ كُلُّهَا ""","","","","","Book of Blood Money (Diyat)"
"16986","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ , قَالَ :  إِنْأَصَابَ أَسْنَانَ غُلامٍ لَمْ يُثْغِرْ "" , قَالَ : "" يَنْتَظِرُ بِهِ الْحَوْلَ ، فَإِنْ نَبَتَتْ ، فَلا دِيَةَ فِيهَا ، وَلا قَوَدَ ""","","","","","Book of Blood Money (Diyat)"
"16987","عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ شِهَابٍ ، فِيصَبِيٍّ كَسَرَ سَنَّ صَبِيٍّ لَمْ يُثْغِرْ , قَالَ :  عَلَيْهِ غُرْمٌ بِقَدْرِ مَا يَرَى الْحَاكِمُ ""","","","","","Book of Blood Money (Diyat)"
"16988","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ مِنْ عُلَمَاءِ الْكُوفَةِ ،  فِيأَسْنَانِ الَّذِي لَمْ يُثْغِرْ فِي كُلِّ سَنٍّ بَعِيرٌ "", وَقَالَ غَيْرُهُ : "" خُمْسُ الدِّيَةِ فِي كُلِّ سَنٍّ ""","","","","","Book of Blood Money (Diyat)"
"16989","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قَالَ عَطَاءٌ :  فِيالسِّنِّ تُنْزَعُ قَوَدًا فَيُعِيدُهَا صَاحِبُهَا مَكَانَهَا فَتَثْبُتُ , قَالَ : لا بَأْسَ بِذَلِكَ "", قَالَ عَبْدُ الرَّزَّاقِ : قَالَ سُفْيَانُ : يَقْلَعُهَا مَرَّةً أُخْرَى""","","","","","Book of Blood Money (Diyat)"
"16990","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَبُو بَكْرٍ ، عَنْ غَيْرِ وَاحِدٍ ، عَنِ ابْنِ الْمُسَيِّبِ ، أَنَّهُ قَالَ : لا تُنْزَعُ , إِنَّمَا كَانَ ذَلِكَ فِي الَّذِي لا يَكُونُ الْقَوَدُ فِي نَزْعِ أَصْلِهِ , كَهَيْئَةِ الْيَدِ تُكْسَرُ ، فَيُقَادُ مِنْهَا , فَتَبْرَأُ الَّتِي أُقِيدَ مِنْهَا ، وَتَشَلُّ الَّتِي أُسْتَقِيدَ لَهَا "", عَنْ مَعْمَرٍ ، عَنْ عَطَاءٍ الْخُرَاسَانِيِّ ، مِثْلَ قَوْلِ عَطَاءٍ , قَالَ مَعْمَرٌ : وَبَلَغَنِي عَنِ ابْنِ الْمُسَيِّبِ ، أَنَّهُ قَالَ : "" لا تُنْزَعُ إِلا مَرَّةً وَاحِدَةً ""","","","","","Book of Blood Money (Diyat)"
"16991","قَالَ سُفْيَانُ :  فِيالَّذِي يُصِيبُ ثَنِيَّةَ الرَّجُلِ فَتَذْهَبُ "" , قَالَ : "" يُقْتَصُّ مِنْهُ وَلا يَدَعُهُ يُعِيدُ ثَنِيَّتَهُ مَكَانَهَا "" , قَالَ : "" يُذْهِبُهَا كَمَا ذَهَبَتْ ثَنِيَّتُهُ ، فَإِنْ أَصَابَ ثَنِيَّةَ رَجُلٍ فَنَبَتَتْ مَكَانَهَا , كَانَ لِلَّذِي أُصِيبَتْ ثَنِيَّتُهُ أَنْ يَقْلَعَ ثَنِيَّتَهُ الأُخْرَى ""","","","","","Book of Blood Money (Diyat)"
"16992","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : أَخْبَرَنِي صَفْوَانُ بْنُ يَعْلَى بْنِ أُمَيَّةَ ، عَنْ يَعْلَى بْنِ أُمَيَّةَ , قَالَ : غَزَوْتُ مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ غَزْوَةَ الْعُسْرَةَ , قَالَ : وَكَانَ يَعْلَى يَقُولُ : تِلْكَ الْغَزْوَةُ أَوْثَقُ عَمَلِي , قَالَ : وَكَانَ لِي أَجِيرٌ ,فَقَاتَلَ إِنْسَانًا , فَعَضَّ أَحَدُهُمَا يَدَ الآخَرِ ، فَانْتَزَعَ الْمَعْضُوضُ يَدَهُ مِنْ فِي الْعَاضِّ ، فَانْتَزَعَ إِحْدَى ثَنِيَّتَيْهِ , فَأَتَيَا النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَأَهْدَرَ ثَنِيَّتَهُ , قَالَ : وَحَسِبْتُ أَنَّهُ قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  فَيَدَعُ يَدَهُ فِي فِيكَ تَقْضِمُهَا ؟ كَأَنَّهَا فِي فَحَلٍّ يَقْضَمُهَا ""","","","","","Book of Blood Money (Diyat)"
"16993","عَنِ الثَّوْرِيِّ ، عَنْ حُمَيْدٍ الأَعْرَجِ ، عَنْ مُجَاهِدٍ , قَالَ : كَانَ أَجِيرٌ لِيَعْلَى بْنِ أُمَيَّةَعَضَّ يَدَ رَجُلٍ ، فَاجْتَذَبَ الآخَرُ يَدَهُ , فَقَطَعَ ثَنِيَّتَيْهُ جَمِيعًا ، فَأَتَيَا النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  أَيَعَضُّ أَحَدُكُمْ أَخَاهُ عَضِيضَ الْفَحْلِ ، ثُمَّ يُرِيدُ الْعَقْلَ ؟ فَأَبْطَلَهَا ""","","","","","Book of Blood Money (Diyat)"
"16994","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ عِمْرَانَ بْنِ حُصَيْنٍ ، قَالَ :عَضَّ رَجُلٌ رَجُلا فَانْتَزَعَ ثَنِيَّتَهُ ، فَأَبْطَلَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَقَالَ :  أَرَدْتَ أَنَّ تَقْضَمَ يَدَ أَخِيكَ كَمَا يَقْضِمُ الْفَحْلُ "", عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنْ عِمْرَانَ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"16995","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، أَنَّ عَلِيًّا , قَالَ : إِنْ شِئْتَ أَمْكَنْتَ يَدَكَ فَعَضَّهَا ، ثُمَّ تَنْزِعُهَا وَأَبْطَلَ دِيَتَهُ ""","","","","","Book of Blood Money (Diyat)"
"16996","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ أَبِي مُلَيْكَةَ ،  أَنَّ إِنْسَانًا أَتَى أَبَا بَكْرٍ الصِّدِّيقِ ،وَعَضَّهُ إِنْسَانٌ , فَانْتَزَعَ يَدَهُ , فَنَدَرَتْ سِنُّهُ , فَقَالَ أَبُو بَكْرٍ : "" فُقِدِتْ يَمِينُهُ ""","","","","","Book of Blood Money (Diyat)"
"16997","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنْ أَبِي الضُّحَى , قَالَ : قَالَ شُرَيْحٌ : انْتَزَعْ يَدَكَ مِنْ فِي السَّبُعِ ""","","","","","Book of Blood Money (Diyat)"
"16998","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، فِيرَجُلٍ عَضَّ رَجُلا فَشَلَّتْ إِصْبَعُهُ , قَالَ :  يَقْتَصُّ صَاحِبُهُ ، فَإِنْ شَلَّتْ فَقَدِ اسْتَكْمَلَ الْقَوَدَ ، وَإِنْ لَمْ تَشَلَّ غَرِمَ لَهُ صَاحِبُهُ دِيَةَ إِصْبَعِهِ الَّتِي شَلَّتْ ، فَإِنْ شَلَّتْ يَدُ الَّذِي اسْتُقِيدَ مِنْهُ بِمَا أَصَابَ فَفِي ذَلِكَ الْعَقْلُ ، وَإِنْ بَلَغَ النَّفْسَ , لأَنَّ اللَّهَ هُوَ الَّذِي أَمَرَ بِالْقَوَدِ ، وَلَيْسَ عَلَى الْمُسْتَقِيدِ فِي فَرَضٍ أَصَابَهُ ، إِلا الْعَقْلَ , لَيْسَ عَلَيْهِ الْقَوَدُ ، فَإِنْ كَانَ مِنْ يَسْتَقِيدُ عَدَا فَوْقَ حَدِّهِ فَعَدَاؤُهُ ذَلِكَ قَوَدٌ ""","","","","","Book of Blood Money (Diyat)"
"16999","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : اللِّسَانُ يُقْطَعُ كُلُّهُ ؟ قَالَ : الدِّيَةُ , قُلْتُ : يُقْطَعُ مِنْهُ مَا يُذْهِبُ الْكَلامَ ، وَبَقِي مِنَ اللِّسَانِ ؟ قَالَ : مَا أَرَى إِلا أَنَّ فِيهِ الدِّيَةَ إِذْ ذَهَبَ الْكَلامُ ""","","","","","Book of Blood Money (Diyat)"
"17000","عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ , قَالَ :  فِياللِّسَانِ الدِّيَةُ كَامِلَةً ، فَإِنْ قُطِعَتْ أَسْلَتُهُ فَبَيَّنَ بَعْضَ الْكَلامِ ، وَلَمْ يُبَيِّنْ بَعْضًا ، فَإِنَّهُ يُحْسَبُ بِالْحُرُوفِ , إِنْ بَيَّنَ نِصْفَ الْحُرُوفِ فَنِصْفُ الدِّيَةِ ، وَإِنْ بَيَّنَ الثُّلُثَيْنِ فَثُلُثُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17001","عَنِ الثَّوْرِيِّ ، عَنْ رَجُلٍ ، عَنْ مُجَاهِدٍ , قَالَ :  إِنَّاللِّسَانَ إِذَا أُصِيبَ مِنْهُ شَيْءٌ حُسِبَ عَلَى الْحُرُوفِ , عَلَى ثَمَانِيَةٍ وَعِشْرِينَ حَرْفًا "", قَالَ : وَقَالَ غَيْرُهُ : فِي ذَلِكَ حُكْمٌ""","","","","","Book of Blood Money (Diyat)"
"17002","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنَا ابْنُ أَبِي نَجِيحٍ  أَنَّاللِّسَانَ إِذَا قُطِعَ مِنْهُ مَا يُذْهِبُ الْكَلامَ أَنَّ فِيهِ الدِّيَةَ "" , قُلْتُ : عَمَّنْ ؟ قَالَ : "" هُوَ قَوْلُ النَّاسِ "" , قَالَ : "" فَإِنْ ذَهَبَ بَعْضُ الْكَلامِ ، وَبَقِي بَعْضٌ فَبِحِسَابِ الْكَلامِ , وَالْكَلامُ مِنْ ثَمَانِيَةٍ وَعِشْرِينَ حَرْفًا "" , قُلْتُ : عَمَّنْ ؟ قَالَ : "" لا أَدْرِي ""","","","","","Book of Blood Money (Diyat)"
"17003","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى , قَالَ : فِي كِتَابِ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ فِيٍالأَجْنَادِ  مَا قُطِعَ مِنَ اللِّسَانِ ، فَبَلَغَ أَنْ يَمْنَعَ الْكَلامَ كُلَّهُ فَفِيهِ الدِّيَةُ كَامِلَةً ، وَمَا نَقَصَ دُونَ ذَلِكَ فَبِحِسَابِهِ ""","","","","","Book of Blood Money (Diyat)"
"17004","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ :  قَضَى أَبُو بَكْرٍ فِياللِّسَانِ ، إِذَا قُطِعَ بِالدِّيَةِ إِذَا نُزِعَ مِنْ أَصْلِهِ ، وَإِذَا قُطِعَتْ أَسْلَتُهُ فَتَكَلَّمَ صَاحِبُهُ فَفِيهِ نِصْفُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17005","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ :  فِياللِّسَانِ إِذَا اسْتُؤْصِلَ الدِّيَةُ تَامَّةً ، وَمَا أُصِيبَ مِنَ اللِّسَانِ ، فَبَلَغَ أَنْ يَمْنَعَ الْكَلامَ , فَفِيهِ الدِّيَةُ تَامَّةً ، وَفِي لِسَانِ الْمَرْأَةِ الدِّيَةُ كَامِلَةً "", وَقَصَّ هَذِهِ الْقِصَّةَ كَامِلَةً كُلَّهَا""","","","","","Book of Blood Money (Diyat)"
"17006","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، عَنْ عَلِيٍّ , قَالَ :  فِياللِّسَانِ الدِّيَةُ ""","","","","","Book of Blood Money (Diyat)"
"17007","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ , قَالَ : قَضَى أَبُو بَكْرٍ :  فِياللِّسَانِ إِذَا قُطِعَ الدِّيَةُ ، فَإِنْ قُطِعَتْ أَسْلَتُهُ فَبَيَّنَ بَعْضَ الْكَلامِ ، وَلَمْ يُبَيِّنْ بَعْضًا , فَنِصْفُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17008","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ  فِيلِسَانِ الأَعْجَمِ ثُلُثُ الدِّيَةِ ، وَفِي ذَكَرِ الْخَصِيِّ ثُلُثُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17009","عَنِ ابْنِ جُرَيْجٍ ، عَنْ رَجُلٍ ، عَنْ مَكْحُولٍ , قَالَ : قَضَى عُمَرُ بْنُ الْخَطَّابِ :  فِيلِسَانِ الأَخْرَسِ يُسْتَأْصَلُ بِثُلُثِ الدِّيَةِ "", قَالَ سُفْيَانُ : "" فِي لِسَانِ الأَخْرَسِ ، وَفِي ذَكَرِ الْخَصِيِّ حُكْمٌ عَدْلٌ ""","","","","","Book of Blood Money (Diyat)"
"17010","عَنْ غَيْرِ وَاحِدٍ ، عَنِ الْحَجَّاجِ ، عَنْ مَكْحُولٍ ، عَنْ زَيْدِ بْنِ ثَابِتٍ :  فِيالصَّعَرِ ، إِذَا لَمْ يَلْتَفِتِ الدِّيَةُ كَامِلَةً ""","","","","","Book of Blood Money (Diyat)"
"17011","عَنْ مَعْمَرٍ , قَالَ :  سَمِعْتُ أَنَّالرَّجُلَ يُضْرَبُ فَيُصَعَّرُ أَنَّ فِيهِ نِصْفَ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17012","قَالَ سُفْيَانُ :  فِيالصَّعَرِ ، إِذَا لَمْ يَلْتَفِتْ حُكْمٌ ""","","","","","Book of Blood Money (Diyat)"
"17013","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْعَزِيزِ بْنُ عُمَرَ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ ، قَالَ :  فِيالصَّعَرِ ، إِذَا لَمْ يَلْتَفِتِ الرَّجُلُ إِلا مُنْحَرِفًا نِصْفُ الدِّيَةِ , خَمْسُمِائَةِ دِينَارٍ ""","","","","","Book of Blood Money (Diyat)"
"17014","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قُلْتُ :الضَّرْبَةُ تَذْهَبُ بِالصَّوْتِ , قَالَ :  لَمْ أَسْمَعْ فِي ذَلِكَ شَيْئًا "", قَالَ سُفْيَانُ : "" فِي الصَّوْتِ إِذَا انْقَطَعَ حُكْمٌ ""","","","","","Book of Blood Money (Diyat)"
"17015","عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ , قَالَ :  فِيالصَّوْتِ إِذَا انْقَطَعَ مِنْ ضَرْبَةٍ الدِّيَةُ كَامِلَةً ""","","","","","Book of Blood Money (Diyat)"
"17016","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْعَزِيزِ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، أَنَّهُ قَالَ :  فِيالْحَنْجَرَةِ إِذَا كُسِرَتْ ، فَانْقَطَعَ الصَّوْتُ الدِّيَةُ كَامِلَةً ""","","","","","Book of Blood Money (Diyat)"
"17017","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ مَكْحُولٍ ، عَنْ قَبِيصَةَ بْنِ ذُؤَيْبٍ ، عَنْ زَيْدِ بْنِ ثَابِتٍ :  فِيالرَّجُلِ يُضْرَبُ حَتَّى يَذْهَبَ عَقْلُهُ , الدِّيَةُ كَامِلَةً ، أَوْ يُضْرَبُ حَتَّى يَغَنَّ ، فَلا يَفْهَمُ , الدِّيَةُ كَامِلَةً ""","","","","","Book of Blood Money (Diyat)"
"17018","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَبْدِ الْكَرِيمِ ، وَدَاوُدَ بْنِ أَبِي عَاصِمٍ :  فِيالصَّوْتِ إِذَا انْقَطَعَ الدِّيَةُ كَامِلَةً ""","","","","","Book of Blood Money (Diyat)"
"17019","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الشَّعْبِيِّ  فِياللَّحْيِ ، إِذَا انْكَسَرَ أَرْبَعُونَ دِينَارًا "", عَنِ ابْنِ جُرَيْجٍ ، عَنْ رَجُلٍ ، عَنِ الشَّعْبِيِّ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"17020","عَنْ مَعْمَرٍ ، وَابْنِ جُرَيْجٍ , عَنْ رَجُلٍ ، عَنِ ابْنِ الْمُسَيِّبِ ، فِيفَقْمَيِ الإِنْسَانِ , قَالَ :  يُثْنِي إِبْهَامَهُ ، ثُمَّ يَجْعَلُ قَصَبَتَهَا السُّفْلَى ، وَيَفْتَحُ فَاهُ فَيَجْعَلُهَا بَيْنَ لَحْيَيْهِ ، فَمَا نَقَصَ مِنْ فَتَحِهِ فَاهُ مِنْ قَصَبَةِ إِبْهَامِهِ السُّفْلَى فَبِالْحِسَابِ ""","","","","","Book of Blood Money (Diyat)"
"17021","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْعَزِيزِ بْنُ عُمَرَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، أَنَّهُ قَالَ :  فِيالذَّقَنِ ثُلُثُ الدِّيَةِ "", قَالَ سُفْيَانُ : "" فِي الذَّقَنِ حُكْمٌ ""","","","","","Book of Blood Money (Diyat)"
"17022","عَنِ ابْنِ جُرَيْجٍ ، وَمَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ مُسْلِمِ بْنِ جُنْدُبٍ ، عَنْ أَسْلَمَ مَوْلَى عُمَرَ , أَنَّهُ قَالَ :  فِيالتَّرْقُوَةِ جَمَلٌ ""","","","","","Book of Blood Money (Diyat)"
"17023","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ :  فِيالتَّرْقُوَةِ أُخْبِرْتُ عِشْرِينَ دِينَارًا ، وَإِنْ كَانَ فِيهَا عَثْمٌ فَأَرْبَعُونَ دِينَارًا , فِي كُلِّ وَاحِدٍ مِنْهُمَا ""","","","","","Book of Blood Money (Diyat)"
"17024","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَهُ عَبْدُ الْكَرِيمِ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ :  إِنْقُطِعَتِ التَّرْقُوَةُ فَلَمْ يَعِشْ , فَلَهُ الدِّيَةُ كَامِلَةً ، فَإِنْ عَاشَ فَفِيهَا خَمْسُونَ مِنَ الإِبِلِ ، وَفِيهِمَا جَمِيعًا الدِّيَةُ ""","","","","","Book of Blood Money (Diyat)"
"17025","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ الْكَرِيمِ ، عَنْ عَامِرٍ ، وَمُجَاهِدٍ , قَالا : إِنْ كُسِرَتْ فَأَرْبَعُونَ دِينَارًا ""","","","","","Book of Blood Money (Diyat)"
"17026","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ  فِيصَدْعِهَا أَرْبَعَةُ أَخْمَاسِ دِيَتِهَا ، فَإِنْ نَقَصَتِ الْيَدُ مِنْ قَبْلِ كَسْرِ التَّرْقُوَةِ ، فَبِقَدْرِ دِيَةِ الْيَدِ مَا نَقَصَ مِنَ الْيَدِ ""","","","","","Book of Blood Money (Diyat)"
"17027","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، عَنْ مَسْرُوقٍ , قَالَ :  فِيالتَّرْقُوَةِ حُكْمٌ ""","","","","","Book of Blood Money (Diyat)"
"17028","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  فِيحَلَمَةِ ثَدْيِ الرَّجُلِ ؟ قَالَ : لا أَدْرِي ""","","","","","Book of Blood Money (Diyat)"
"17029","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ :  فِيحَلَمَةِ الرَّجُلِ خَمْسٌ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"17030","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ ، أَنَّ أَبَا بَكْرٍ رَضِي اللَّهُ عَنْهُ  جَعَلَ فِيحَلَمَةِ الرَّجُلِ خَمْسِينَ دِينَارًا ، وَفِي حَلَمَةِ الْمَرْأَةِ مِائَةَ دِينَارٌ "", عَنْ مَعْمَرٍ ، عَنْ عَطَاءٍ الْخُرَاسَانِيِّ , قَالَ : وَسَمِعْتُهُ يَقُولُ مِثْلَ ذَلِكَ , قَالَ : وَقَالَ إِبْرَاهِيمُ : "" حُكْمٌ ""","","","","","Book of Blood Money (Diyat)"
"17031","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَضَى أَبُو بَكْرٍ : فِيثَدْيِ الرَّجُلِ ، إِذَا ذَهَبَتْ حَلَمَتُهُ بِخَمْسٍ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"17032","عَنِ الثَّوْرِيِّ ، عَنْ إِبْرَاهِيمَ  فِيثَدْيِ الرَّجُلِ حُكْمٌ ""","","","","","Book of Blood Money (Diyat)"
"17033","عَنِ الثَّوْرِيِّ ، عَنْ سُلَيْمَانَ الشَّيْبَانِيِّ ، عَنِ الشَّعْبِيِّ  فِيثَدْيَيِ الْمَرْأَةِ الدِّيَةُ ، وَفِي أَحَدِهِمَا النِّصْفُ ""","","","","","Book of Blood Money (Diyat)"
"17034","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الْكَرِيمِ ، عَنْ إِبْرَاهِيمَ ، مِثْلَ قَوْلِ الشَّعْبِيّ :  فِيثَدْيَيِ الْمَرْأَةِ الدِّيَةُ ، وَفِي أَحَدِهِمَا نِصْفُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17035","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ مَكْحُولٍ ، عَنْ قَبِيصَةَ بْنِ ذُؤَيْبٍ ، عَنْ زَيْدٍ , قَالَ :  فِيحَلَمَةِ الثَّدْيِ رُبُعُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17036","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي دَاوُدُ بْنُ أَبِي عَاصِمٍ ، أَنَّ عَبْدَ الْمَلِكِ  قَضَى فِيقِتَالِ غَسَّانَ ، وَأَصَابُوا النِّسَاءَ ، قَضَى فِي الثَّدْيِ بِخَمْسِينَ "", قُلْتُ : لِدَاوُدَ الْحَلَمَةُ مِنَ ثَدْيِ الرَّجُلِ وَالْمَرْأَةِ , قَالَ : "" لا أَدْرِي ""","","","","","Book of Blood Money (Diyat)"
"17037","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ ، قَالَ : قَضَى أَبُو بَكْرٍ :  فِيثَدْيِ الْمَرْأَةِ بِعَشْرٍ مِنَ الإِبِلِ ، إِذَا لَمْ يُصِبْ إِلا حَلَمَةَ ثَدْيِهَا ، فَإِذَا قُطِعَ مِنْ أَصْلِهِ فَخَمْسَ عَشْرَةَ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"17038","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ  فِيالصُّلْبِ إِذَا كُسِرَ الدِّيَةُ كَامِلَةً ""","","","","","Book of Blood Money (Diyat)"
"17039","عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ  فِيالصُّلْبِ إِذَا كُسِرَ فَذَهَبَ مَاؤُهُ , الدِّيَةُ كَامِلَةً , وَإِنْ لَمْ يَذْهَبِ الْمَاءُ فَنِصْفُ الدِّيَةِ "", قَالَ : قَضَى بِذَلِكَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ""","","","","","Book of Blood Money (Diyat)"
"17040","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ ، عَنْ أَبِي بَكْرٍ ، أَوْ عَنْ عُمَرَ , قَالَ : إِذَا لَمْ يُولَدْ لَهُ فَالدِّيَةُ , وَإِنْ وُلِدَ لَهُ فَنِصْفُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17041","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ :  فِيالصُّلْبِ يُكْسَرُ الدِّيَةُ "" , قُلْتُ لَهُ : فَكُسِرَ ثُمَّ كَانَ فِيهِ مَيْلٌ ؟ قَالَ : "" فَلا يُزَادُ عَلَى الدِّيَةِ ، وَإِنِ انْجَبَرَ لَمْ يَنْقُصْ مِنْهَا ""","","","","","Book of Blood Money (Diyat)"
"17042","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ الْحَارِثِ بْنِ سُفْيَانَ ، أَنَّ مُحَمَّدَ بْنَ عَبْدِ الرَّحْمَنِ بْنِ أَبِي رَبِيعَةَ , قَالَ : حَضَرْتَ عَبْدَ اللَّهِ بْنِ الزُّبَيْرِ قَضَى فِيرَجُلٍ كُسِرَ صُلْبُهُ فَاحْدَوْدَبَ , وَلَمْ يَقْعُدْ ، وَهُوَ يَمْشِي ، وَهُوَ مُحْدَوْدَبٌ  , قَالَ : "" فَمَشَى فَقَضَى لَهُ بِثُلُثَيِ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17043","عَنِ ابْنِ جُرَيْجٍ ، عَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ ، أَنَّ أَبَا بَكْرٍ ، أَوْ عُمَرَ  قَضَى فِيالصُّلْبِ إِذَا لَمْ يُولَدْ لَهُ بِالدِّيَةِ ، فَإِنْ وُلِدَ لَهُ فَنِصْفُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17044","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ , قَالَ : إِنْ كُسِرَ الصُّلْبُ فَجُبِرَ ، وَانْقَطَعَ مَنِيُّهُ , فَالدِّيَةُ وَافِيَةً ، وَإِنْ لَمْ يَنْقَطِعْ مَنِيُّهُ ، وَكَانَ فِي الظُّهْرِ مَيْلٌ فَجُرْحٌ يُرَى فِيهِ ""","","","","","Book of Blood Money (Diyat)"
"17045","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ الْحَارِثِ بْنِ سُفْيَانَ ، أَنَّ مُحَمَّدَ بْنَ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللَّهِ بْنِ أَبِي رَبِيعَةَ قَالَ : حَضَرْتَ عَبْدَ اللَّهِ بْنَ الزُّبَيْرِ قَضَى  فِيرَجُلٍ كُسِرَ صُلْبُهُ فَاحْدَوْدَبَ ، وَلَمْ يَقْعُدْ وَهُوَ يَمْشِي مُحْدَوْدَبًا , بِثُلُثَيِ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17046","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَبْدُ الْكَرِيمِ : إِنْ لَمْ يَسْتَطِعْ أَنْ يُمْسِكَ رِجْلاهُ , فَالدِّيَةُ وَافِيَةً ""","","","","","Book of Blood Money (Diyat)"
"17047","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَضَى أَبُو بَكْرٍ :  فِيصُلْبِ الرَّجُلِ إِذَا كُسِرَ ثُمَّ جُبِرَ بِالدِّيَةِ كَامِلَةً ، إِذَا كَانَ لا يَحْمِلُ لَهُ , وَبِنِصْفِ الدِّيَةِ ، إِذَا كَانَ يَحْمِلُ لَهُ ""","","","","","Book of Blood Money (Diyat)"
"17048","عَنِ الْحَجَّاجِ بْنِ أَرْطَاةَ ، عَنْ مَكْحُولٍ ، عَنْ زَائِدَةَ ، أَنَّهُ قَالَ فِيالْفَقَارِ :  فِي كُلِّ فَقَارَةٍ أَحَدٌ وَثَلاثُونَ دِينَارًا ، وَرُبُعُ دِينَارٍ ""","","","","","Book of Blood Money (Diyat)"
"17049","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرْتُ عَنِ الشَّعْبِيِّ ، أَنَّ زَيْدًا  قَضَى فِيفَقَارِ الظُّهْرِ كُلِّهِ بِالدِّيَةِ كَامِلَةً ، وَهِيَ أَلْفُ دِينَارٍ ، وَهِيَ اثْنَتَانِ وَثَلاثُونَ فَقَارَةً , كُلُّ فَقَارَةٍ أَحَدٌ وَثَلاثُونَ دِينَارًا ، إِذَا كُسِرَتْ ، ثُمَّ بَرَأَتْ عَلَى غَيْرِ عَثْمٍ ، فَإِنْ بَرَأَتْ عَلَى عَثْمٍ فَفِي كَسْرِهَا أَحَدٌ وَثَلاثُونَ دِينَارًا وَرُبُعُ دِينَارٍ , وَفِي عَثْمِهَا مَا فِيهِ مِنَ الْحُكْمِ الْمُسْتَقْبَلِ سِوَى ذَلِكَ "", قَالَ عَبْدُ الرَّزَّاقِ : قَالَ سُفْيَانُ : "" فِي الْفَقَارَةِ حُكْمٌ ""","","","","","Book of Blood Money (Diyat)"
"17050","عَنِ ابْنِ جُرَيْجٍ ، وَمَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ مُسْلِمِ بْنِ جُنْدُبٍ ، عَنْ أَسْلَمَ مَوْلَى عُمَرَ , قَالَ : قَالَ عُمَرُ :  فِيالضِّلْعِ جَمَلٌ ""","","","","","Book of Blood Money (Diyat)"
"17051","عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ , قَالَ :  فِيالضِّلْعِ إِذَا كُسِرَ بَعِيرٌ ""","","","","","Book of Blood Money (Diyat)"
"17052","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ  فِيالضِّلْعِ إِذَا كُسِرَتْ ، ثُمَّ جُبِرَتْ عِشْرُونَ دِينَارًا ، فَإِنْ كَانَ فِيهَا عَثْمٌ فَأَرْبَعُونَ ""","","","","","Book of Blood Money (Diyat)"
"17053","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْعَزِيزِ بْنُ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، عَنْ أَبِيهِ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ  أَنَّهُ قَضَى فِيالضِّلْعِ بِبَعِيرٍ ""","","","","","Book of Blood Money (Diyat)"
"17054","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، عَنْ مَسْرُوقٍ , قَالَ :  فِيالضِّلْعِ حُكْمٌ ""","","","","","Book of Blood Money (Diyat)"
"17055","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ :  فِيضِلْعِ الْمَرْأَةِ ، إِذَا كُسِرَتْ عَشَرَةُ دَنَانِيرَ ""","","","","","Book of Blood Money (Diyat)"
"17056","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ , قَالَ : سَمِعْتُ مَكْحُولا , يَقُولُ : إِذَا كَانَتْ خَطَأً فَفِيهَا ثُلُثُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17057","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : كَمْ فِي الْجَائِفَةِ ؟ قَالَ : الثُّلُثُ , قَالَتْ : فَنَفَذَتْ مِنَ الشِّقِّ الآخَرِ , قَالَ : فَلَعَلَّهُ أَنْ يَكُونَ فِيهَا حِينَئِذٍ الثُّلُثَانِ ""","","","","","Book of Blood Money (Diyat)"
"17058","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ , قَالَ :  فِيالْجَائِفَةِ الثُّلُثُ ، فَإِنْ نَفَذَتْ فَالثُّلُثَانِ "", عَنِ ابْنِ عُيَيْنَةَ ، عَنِ ابْنِ أَبِي نَجِيحٍ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"17059","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ أَبِي بَكْرٍ , قَالَ : إِذَا نَفَذَتْ فَهِيَ جَائِفَتَانِ ""","","","","","Book of Blood Money (Diyat)"
"17060","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : جَائِفَتَانِ , فَفِيهِمَا ثُلُثَا الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17061","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ ، عَنْ أَبِيهِ ، عَنْ جَدِّهِ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  قَضَى فِيالْجَائِفَةِ بِثُلُثِ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17062","عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ , قَالَ :  فِيالْجَائِفَةِ فِي الْجَنْبِ وَالأَنْفِ الثُّلُثُ ، فَإِنْ نَفَذَتْ فَفِيهَا ثُلُثَا الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17063","عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ طَاوُسٍ ، قَالَ : عِنْدَ أَبِي كِتَابٌ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  فِيالْجَائِفَةِ ثَلاثَةً وَثَلاثُونَ ""","","","","","Book of Blood Money (Diyat)"
"17064","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، عَنْ عَلِيٍّ , قَالَ :  فِيالْجَائِفَةِ ثُلُثُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17065","عَنِ الثَّوْرِيِّ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ ، عَنِ ابْنِ الْمُسَيِّبِ ، أَوْ غَيْرِهِ , أَنَّ أَبَا بَكْرٍ  قَضَى فِيالْجَائِفَةِ الَّتِي نَفَذَتْ بِثُلُثَيِ الدِّيَةِ ، إِذَا نَفَذَتِ الْخَصْيَتَيْنِ كِلاهُمَا ، وَبَرِئَ صَاحِبُهَا "", قَالَ سُفْيَانُ : "" لا أَرَى , وَلا تَكُونُ الْجَائِفَةُ إِلا فِي الْجَوْفِ "" , سَمِعْنَا ذَلِكَ""","","","","","Book of Blood Money (Diyat)"
"17066","عَنِ ابْنِ جُرَيْجٍ ، وَالثَّوْرِيِّ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ :  فِيكُلِّ نَافِذَةِ عُضْوٍ فِيهَا ثُلُثُ دِيَةِ ذَلِكَ الْعُضْوِ ""","","","","","Book of Blood Money (Diyat)"
"17067","عَنِ ابْنِ جُرَيْجٍ ، وَابْنِ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ , قَالَ : سَمِعْتُ النَّاسَ ، يَقُولُونَ :  فِيجَائِفَةٍ مُمِخَّةٍ الثُّلُثُ ""","","","","","Book of Blood Money (Diyat)"
"17068","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ سَعِيدٍ , قَالَ :  رَأَيْتُ النَّاسَ يَجْعَلُونَ فِيالْجَائِفَةِ الْمُمِخَّةِ ثُلُثُ دِيَةِ ذَلِكَ الْعُضْوِ ""","","","","","Book of Blood Money (Diyat)"
"17069","عَنِ ابْنِ أَبِي حَنِيفَةَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , أَنَّهُ قَالَ : إِذَا نَفَذَتْ فَفِيهَا الثُّلُثَانِ ""","","","","","Book of Blood Money (Diyat)"
"17070","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَضَى أَبُو بَكْرٍ :  فِيالْجَائِفَةِ الَّتِي تَكُونُ فِي الْجَوْفِ , فَتَكُونُ نَافِذَةً بِثُلُثَيِ الدِّيَةِ "" , وَقَالَ : "" هُمَا جَائِفَتَانِ ""","","","","","Book of Blood Money (Diyat)"
"17071","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ دَاوُدَ بْنِ أَبِي عَاصِمٍ , قَالَ : سَمِعْتُ ابْنَ الْمُسَيِّبِ , يَقُولُ : قَضَى أَبُو بَكْرٍ :  فِيالْجَائِفَةِ ، إِذَا نَفَذَتِ الْخُصْيَتَيْنِ فِي الْجَوْفِ مِنْ كُلِّ الشِّقَّيْنِ بِثُلُثَيِ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17072","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  فِيالْجَائِفَةِ إِذَا كَانَتْ فِي الْجَوْفِ ثُلُثُ الْعَقْلِ , ثَلاثَةٌ وَثَلاثُونَ مِنَ الإِبِلِ ، أَوْ عَدْلُهَا مِنَ الذَّهَبِ ، أَوِ الْوَرِقِ ، أَوِ الشَّاءِ "", عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ مِثْلَهُ , وَفِي : "" الْجَائِفَةِ مِنَ الْمَرْأَةِ ثُلُثُ دِيَتِهَا ""","","","","","Book of Blood Money (Diyat)"
"17073","عَنْ مَعْمَرٍ ، عَنْ سُلَيْمَانَ بْنِ حَبِيبٍ , قَالَ : قَضَى مُعَاوِيَةُ :  فِيكُلِّ نَافِذَةٍ فِي عُضْوٍ مُمَخَّةٍ ثُلُثَ دِيَةِ ذَلِكَ الْعُضْوِ ، فَإِنْ نَفَذَتْ مِنَ الْجَانِبِ الآخَرِ فَثُلُثُ وَعُشْرُ دِيَةِ ذَلِكَ الْعُضْوِ ، وَقَضَى فِي كُلِّ نَافِذَةٍ فِي الْجَوْفِ بِثُلُثِ الدِّيَةِ وَعُشْرِ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17074","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : قَضَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : فِي الذَّكَرِ بِالدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17075","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، عَنْ عَلِيٍّ  أَنَّهُ قَضَى فِيالْحَشَفَةِ بِالدِّيَةِ كَامِلَةً ""","","","","","Book of Blood Money (Diyat)"
"17076","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، عَنْ عَلِيٍّ , قَالَ :  فِيالذَّكَرِ الدِّيَةُ ""","","","","","Book of Blood Money (Diyat)"
"17077","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ , قَالَ : عِنْدَ أَبِي كِتَابٌ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيهِ : وَإِذَا قُطِعَ الذَّكَرُ فَفِيهِ مِائَةُ نَاقَةٍ , قَدِ انْقَطَعَتْ شَهْوَتُهُ ، وَذَهَبَ نَسْلُهُ ""","","","","","Book of Blood Money (Diyat)"
"17078","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ :  فِيالْحَشَفَةِ الدِّيَةُ إِذَا أُصِيبَتْ "" , قُلْتُ : فَاسْتُؤْصِلَ الذَّكَرُ ؟ قَالَ : "" الدِّيَةُ "" , قُلْتُ : أَرَأَيْتَ إِنِ اسْتُؤْصِلَتِ الْحَشَفَةُ ثُمَّ أُصِيبَ شَيْءٌ مِمَّا بَقِي بَعْدُ ؟ قَالَ : "" جُرْحٌ يُرَى فِيهِ ""","","","","","Book of Blood Money (Diyat)"
"17079","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ , قَالَ :  فِيالذَّكَرِ الدِّيَةُ وَفِي حَشَفَتِهِ وَحْدِهَا الدِّيَةُ ""","","","","","Book of Blood Money (Diyat)"
"17080","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَضَى أَبُو بَكْرٍ :  فِيذَكَرِ الرَّجُلِ بِدِيَتِهِ , مِائَةٍ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"17081","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ  فِيالذَّكَرِ الدِّيَةُ ، فَمَا كَانَ دُونَ ذَلِكَ فَبِحِسَابِهِ ""","","","","","Book of Blood Money (Diyat)"
"17082","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :كَمْ فِي ذَكَرِ الرَّجُلِ الَّذِي لا يَأْتِي النِّسَاءَ ؟ قَالَ :  مِثْلُ مَا فِي ذَكَرِ الَّذِي يَأْتِي النِّسَاءَ "" , قُلْتُ : أَرَأَيْتَ الْكَبِيرَ الَّذِي قَدِ انْقَطَعَ ذَلِكَ مِنْهُ , أَلَيْسَ يُوفِّي نَذَرَهُ ؟ قَالَ : "" بَلَى ""","","","","","Book of Blood Money (Diyat)"
"17083","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ  فِيذَكَرِ الَّذِي لا يَأْتِي النِّسَاءَ ثُلُثُ مَا فِي ذَكَرِ الَّذِي يَأْتِي النِّسَاءَ "" , كَانَ يَقِيسُهُ بِالْعَيْنِ الْقَائِمَةِ , وَالسِّنِّ السَّوْدَاءِ , قَالَ : "" وَكَذَلِكَ فِي لِسَانِ الأَخْرَسِ , ثُلُثُ مَا فِي لِسَانِ الصَّحِيحِ ""","","","","","Book of Blood Money (Diyat)"
"17084","عَنِ ابْنِ جُرَيْجٍ ، عَنْ رَجُلٍ ، سَمِعَ مَكْحُولا , يَقُولُ : قَضَى عُمَرُ بْنُ الْخَطَّابِ :  فِيالْيَدِ الشَّلاءِ , وَلِسَانِ الأَخْرَسِ ، وَذَكَرِ الْخَصِيِّ يُسْتَأْصَلُ , بِثُلُثِ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17085","عَنِ الثَّوْرِيِّ :  فِيذَكَرِ الْخَصِيِّ حُكْمٌ ""","","","","","Book of Blood Money (Diyat)"
"17086","عَنْ أَبِي حَنِيفَةَ , عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , قَالَ :  فِيذَكَرِ الْخَصِيِّ حُكْمٌ ""","","","","","Book of Blood Money (Diyat)"
"17087","عَنِ الثَّوْرِيِّ ، وَمَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، عَنْ عَلِيٍّ , قَالَ :  فِيالْبَيْضَةِ النِّصْفُ ""","","","","","Book of Blood Money (Diyat)"
"17088","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ :  فِيالْبَيْضَتَيْنِ الدِّيَةُ كَامِلَةً ""","","","","","Book of Blood Money (Diyat)"
"17089","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الْبَيْضَتَانِ ؟ قَالَ : خَمْسُونَ خَمْسُونَ فِي كُلِّ بَيْضَةٍ ""","","","","","Book of Blood Money (Diyat)"
"17090","عَنِ ابْنِ جُرَيْجٍ ، وَمَعْمَرٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ , قَالَ :  فِيالْبَيْضَتَيْنِ الدِّيَةُ وَافِيَةً , خَمْسُونَ خَمْسُونَ "", قَالَ ابْنُ جُرَيْجٍ : قُلْتُ لَهُ : أَحَفِظْتَ الْبَيْضَتَيْنِ يَفَضَّلُ بَيْنَهُمَا ؟ قَالَ : "" لا ""","","","","","Book of Blood Money (Diyat)"
"17091","عَنْ إِبْرَاهِيمَ بْنِ طَهْمَانَ ، عَنْ أَشْعَثَ بْنِ سَوَّارٍ ، عَنِ الشَّعْبِيِّ ، عَنِ ابْنِ مَسْعُودٍ , قَالَ : الانْثِيَانِ سَوَاءٌ "", عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ مِثْلَهُ ، عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"17092","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ :  فِيالْيُسْرَى مِنَ الْبَيْضَتَيْنِ الثُّلُثَانِ ""","","","","","Book of Blood Money (Diyat)"
"17093","عَنِ الثَّوْرِيِّ ، عَنْ لَيْثِ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ ، عَنْ أَبِيهِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرِو بْنِ الْعَاصِ ، عَنْ عُمَرَ  أَنْهُ حَكَمَ فِيالْبَيْضَةِ يُصَابُ جَانِبُهَا الأَعْلَى بِسُدُسٍ مِنَ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17094","عَنْ مَعْمَرٍ ، عَنِ ابْنِ رَاشِدٍ ، عَنِ الشَّعْبِيِّ , قَالَ :  فِيالْمَثَانَةِ إِذَا خُرِقَتْ ثُلُثُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17095","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ رَجُلٍ ، عَنِ الشَّعْبِيِّ ، أَنَّهُ قَالَ :  فِيالْمَثَانَةِ إِذَا خُرِقَتْ فَلَمْ تُمْسِكِ الْبَوْلَ ثُلُثُ الدِّيَةِ "" , قَالَ : وَأَقُولُ أَنَا : "" الدِّيَةُ وَافِيَةٌ "", وَقَالَهُ أَهْلُ الشَّامِ""","","","","","Book of Blood Money (Diyat)"
"17096","عَنِ الثَّوْرِيِّ , قَالَ : إِذَا لَمْ يُمْسِكِ الرَّجُلُ الْبَوْلَ فَالدِّيَةُ ، وَالْمَرْأَةُ وَالرَّجُلُ فِي ذَلِكَ سَوَاءٌ "" , وَقَالَ : "" فِي الَّذِي لا يَسْتَطِيعُ أَنْ يَمْسِكَ خَلاءَهُ الدِّيَةُ ""","","","","","Book of Blood Money (Diyat)"
"17097","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَبْدِ الْكَرِيمِ , قَالَ : إِذَا لَمْ يَسْتَطِعْ أَنْ يُمْسِكَ خَلاءَهُ فَالدِّيَةُ "", عَنِ الثَّوْرِيِّ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"17098","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ ، أَنَّهُ قَالَ :  فِيالإِلْيَتَيْنِ إِذَا قُطِعَتَا حَتَّى يَبْدُوَ الْعَظْمُ فَالدِّيَةُ كَامِلَةٌ ، وَفِي إِحْدَاهُمَا النِّصْفُ ""","","","","","Book of Blood Money (Diyat)"
"17099","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ،  قَالَ عَبْدُ الرَّزَّاقِ لا أَعْلَمُهُ إِلا عَبْدَ الْكَرِيمِ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ :  فِيالإِلْيَتَيْنِ إِذَا قُطِعَتَا حَتَّى يَبْلُغَ الْعَظْمَ الدِّيَةُ ""","","","","","Book of Blood Money (Diyat)"
"17100","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الْكَرِيمِ ، عَنْ إِبْرَاهِيمَ , قَالَ :  فِيالإِلْيَتَيْنِ الدِّيَةُ ""","","","","","Book of Blood Money (Diyat)"
"17101","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :كَمْ فِي قُبُلِ الْمَرْأَةِ ؟ قَالَ :  مَا عَلِمْتُ فِيهِ شَيْئًا بِبِلادِنَا ""","","","","","Book of Blood Money (Diyat)"
"17102","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ الْحَارِثِ بْنِ سُفْيَانَ , قَالَ :  يُقْضَى فِيشُفْرِ قُبُلِهَا ، إِذَا أُوعِبَ حَتَّى بَلَغَ الْعَظْمَ شَطْرَ دِيَتِهِا ، وَبِدِيَتِهِا فِي شُفْرَيْهَا ، إِذَا بَلَغَ الْعَظْمَ ، وَإِنْ كَانَتْ عَاقِرًا لا تَحْمِلُ ""","","","","","Book of Blood Money (Diyat)"
"17103","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : اجْتَمَعَ لِعُمَرَ :  فِيرَكَبِهَا إِذَا قُطِعَ بِالدِّيَةِ كَامِلَةً , مِنْ أَجْلِ أَنَّهُ يَمْنَعُ الْمَرْأَةَ اللَّذَّةَ مِنَ الْجِمَاعِ ""","","","","","Book of Blood Money (Diyat)"
"17104","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْعَزِيزِ بْنُ عُمَرَ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ , قَالَ :  فِيإِفْضِاءِ الْمَرْأَةِ الدِّيَةُ كَامِلَةً ، مِنْ أَجْلِ أَنَّهَا تَمْنَعُ لَذَّةَ الْجِمَاعِ ""","","","","","Book of Blood Money (Diyat)"
"17105","عَنْ عَبْدِ اللَّهِ بْنِ مُحَرَّرٍ ، عَنْ قَتَادَةَ ، أَنَّ زَيْدَ بْنَ ثَابِتٍ , قَالَ فِيالْمَرْأَةِ يُفْضِيهَا زَوْجُهَا :  إِنْ حَبَسَتِ الْحَاجَتَيْنِ ، وَالْوَلَدَ , فَفِيهَا ثُلُثُ الدِّيَةِ ، وَإِنْ لَمْ يَحْبِسِ الْحَاجَتَيْنِ ، وَالْوَلَدَ فَفِيهَا الدِّيَةُ كَامِلَةً ""","","","","","Book of Blood Money (Diyat)"
"17106","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ , قَالَ : قَضَى عُمَرُ بْنُ الْخَطَّابِ :  فِيالْمَرْأَةِ إِذَا غُلِبَتْ عَلَى نَفْسِهَا , فَأُفْضِيَتْ ، أَوْ ذَهَبَ عَذْرَتُهَا بِثُلُثِ دِيَتِهِا "" ، وَقَالَ : "" لا حَدَّ عَلَيْهِا ""","","","","","Book of Blood Money (Diyat)"
"17107","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ قَتَادَةَ ,  فِيالرَّجُلِ يُصِيبُ الْمَرْأَةَ فَيُفْضِيهَا , قَالَ : "" ثُلُثُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17108","عَنْ هُشَيْمٍ ، عَنْ دَاوُدَ بْنِ أَبِي عَاصِمٍ , قَالَ : حَدَّثَنَا عَمْرُو بْنُ شُعَيْبٍ ،  أَنَّرَجُلا اسْتَكْرَهَ امْرَأَةً فَأَفْضَاهَا ، فَضَرَبَهُ عُمَرُ بْنُ الْخَطَّابِ الْحَدَّ ، وَأَغْرَمَهُ ثُلُثَ دِيَتِهِا ""","","","","","Book of Blood Money (Diyat)"
"17109","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْعَزِيزِ بْنُ عُمَرَ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ , اجْتَمَعَ لَهُ الْعُلَمَاءُ فِي خِلافَتِهِ  أَنَّ فِيالْعَفَلَةِ تَكُونُ مِنَ الضَّرْبَةِ الدِّيَةُ كَامِلَةً , مِنْ أَجْلِ أَنَّهَا تَمْنَعُ اللَّذَّةَ وَالْجِمَاعَ ""","","","","","Book of Blood Money (Diyat)"
"17110","عَنِ ابْنِ جُرَيْجٍ ، عَنْ رَجُلٍ ، عَنِ الشَّعْبِيِّ , قَالَ :  فِيالْمَنْكِبِ ، إِذَا كُسِرَ أَرْبَعُونَ دِينَارًا ""","","","","","Book of Blood Money (Diyat)"
"17111","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ ، أَنَّهُ اجْتَمَعَ لِعُمَرَ بْنِ عَبْدِ الْعَزِيزِ :  فِيالْمَنْكِبِ إِذَا كُسِرَ ، ثُمَّ جُبِرَ فِي غَيْرِ عَثْمٍ أَرْبَعُونَ دِينَارًا ""، قَالَ سُفْيَانُ : "" فِي الْمَنْكِبِ حُكْمٌ ""","","","","","Book of Blood Money (Diyat)"
"17112","عَنِ الثَّوْرِيِّ ، عَنْ زُهَيْرِ ، عَنْ أَبِي عَوْنٍ ، عَنْ شُرَيْحٍ , قَالَ :  فِيالْفَتْقِ ثُلُثُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17113","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : مَنْ قُطِعَتْ يَدُهُ فِي سَبِيلِ اللَّهِ ، ثُمَّ قَطَعَ إِنْسَانٌ يَدَهُ الأُخْرَى ، غُرِمَ لَهُ دِيَتَيْنِ ، فَإِنْ قُطِعَتْ يَدُهُ فِي حَدٍّ فَقَطَعَ إِنْسَانٌ يَدَهُ الأُخْرَى ، غُرِمَ لَهُ دِيَةَ الَّتِي قَطَعَ ""","","","","","Book of Blood Money (Diyat)"
"17114","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , فِيرَجُلٍ مَقْطُوعٍ قُطِعَتْ يَدُهُ بَعْدَ ذَلِكَ , قَالَ :  لَوْ أُعْطِي عَقْلُ يَدَيْنِ ، رَأَيْتُ ذَلِكَ غَيْرَ بَعِيدٍ مِنَ السَّدَادِ ، وَلَمْ أَسْمَعْ فِيهِ سُنَّةً ""","","","","","Book of Blood Money (Diyat)"
"17115","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ :  فِيالْيَدِ تُسْتَأْصَلُ خَمْسُونَ مِنَ الإِبِلِ ، إِذَا قُطِعَتْ مِنَ الْمَنْكِبِ ، وَالرِّجْلُ مِثْلُهَا ""","","","","","Book of Blood Money (Diyat)"
"17116","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  قَضَى فِيالْيَدَيْنِ بِالدِّيَةِ ، وَفِي الرِّجْلَيْنَ بِالدِّيَةِ""","","","","","Book of Blood Money (Diyat)"
"17117","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ ، عَنْ أَبِيهِ ، عَنْ جَدِّهِ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَتَبَ لَهُمْ كِتَابًا فِيهِ : وَالْيَدُ خَمْسُونَ مِنَ الإِبِلِ ، وَالرِّجْلُ خَمْسُونَ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"17118","عَنْ مَعْمَرٍ ، وَالثَّوْرِيَّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، عَنْ عَلِيٍّ , قَالَ :  وَفِيالْيَدِ نِصْفُ الدِّيَةِ ، وَفِي الرِّجْلِ نِصْفُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17119","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ  فِيالْيَدِ تُسْتَأْصَلُ خَمْسُونَ مِنَ الإِبِلِ "" ، قُلْتُ : مِنْ أَيْنَ ؟ أَمِنَ الْمَنْكِبِ ، أَمْ مِنَ الْكَفِّ ؟ قَالَ : "" بَلْ مِنَ الْمَنْكِبِ ""","","","","","Book of Blood Money (Diyat)"
"17120","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ , قَالَ : كَانَ عِنْدَ أَبِي كِتَابٌ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيهِ :  وَفِيالْيَدِ خَمْسُونَ ، وَفِي الرِّجْلِ خَمْسُونَ ""","","","","","Book of Blood Money (Diyat)"
"17121","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  فِيالْيَدِ نِصْفُ الْعَقْلِ ، وَفِي الرِّجْلِ نِصْفُ الْعَقْلِ ، خَمْسُونَ مِنَ الإِبِلِ ، أَوْ عَدْلُهَا مِنَ الذَّهَبِ ، أَوِ الْوَرِقِ ، أَوِ الْبَقَرِ ، أَوِ الشَّاءِ ""","","","","","Book of Blood Money (Diyat)"
"17122","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ , قَالَ :  وَفِيالْيَدِ نِصْفُ الدِّيَةِ ، وَفِي الرِّجْلِ نِصْفُ الدِّيَةِ ، أَوْ عَدْلُ ذَلِكَ مِنَ الذَّهَبِ , أَوِ الْوَرِقِ ""","","","","","Book of Blood Money (Diyat)"
"17123","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ :  فِيالْيَدَيْنِ الدِّيَةُ كَامِلَةً , وَفِي الرِّجْلَيْنِ الدِّيَةُ كَامِلَةً "", قَالَ مَعْمَرٌ : وَسَمِعْتُ مِنْ يَقُولُ : "" إِنْ نُقِصَتْ رِجْلُهُ إِصْبَعًا فَخُمْسُ دِيَةِ الرِّجْلِ ، وَإِنْ نُقِصَتْ إِصْبَعَيْنِ فَخُمُسَا دِيَةِ رِجْلِهِ ، وَإِنْ نَقَصَتْ ثَلاثَةَ أَصَابِعٍ فَثَلاثَةُ أَخْمَاسِ دِيَةِ رِجْلِهِ ""","","","","","Book of Blood Money (Diyat)"
"17124","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : سَوَاءٌ مِنْ أَيْنَ قُطِعَتِ الْيَدُ , مِنَ الْمَنْكِبِ , أَوْ مِمَّا دُونَهُ إِلَى مَوْضِعِ السِّوَارِ , وَالرِّجْلُ كَذَلِكَ مِنَ الْفَخِذِ إِلَى الْكَعْبِ ""","","","","","Book of Blood Money (Diyat)"
"17125","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَإِنْ قُطِعَتِ الْيَدُ مِنْ شَطْرِ الذِّرَاعِ ؟ قَالَ :  خَمْسُونَ "" , قُلْتُ : فَقُطِعَ شَيْءٌ مِمَّا بَقِي بَعْدُ ؟ قَالَ : "" جُرْحٌ ، لا أَحْسِبُهُ إِلا ذَلِكَ ، إِلا أَنْ يَكُونَ قَدْ مَضَتْ فِي ذَلِكَ سُنَّةٌ ""","","","","","Book of Blood Money (Diyat)"
"17126","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ :  فِيالإِعْرَجِ إِذَا لَمْ يَطَأْ بِهَا فَقَدْ تَمَّ عَقْلُهَا , فَمَا نَقَصَ فَبِحِسَابِ ذَلِكَ ""","","","","","Book of Blood Money (Diyat)"
"17127","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ إِنْ قَطَعَ الْكَفَّ فَخَمْسُونَ مِنَ الإِبِلِ ، فَإِنْ قَطَعَ مَا بَقِي مِنَ الْيَدِ كُلِّهَا إِلا الذِّرَاعَ ، أَوْ قَطَعَ نِصْفَ الذِّرَاعِ ، فَنِصْفُ نَذْرِ الْيَدِ , خَمْسٌ وَعِشْرُونَ ، فَإِنْ كَانَتْ إِنَّمَا قُطِعَتْ مِنْ شَطْرِ ذِرَاعِهَا ، أَوِ الذِّرَاعِ بَعْدَ الْكَفِّ "" ، فَمُجَاهِدٌ يَقُولُ ذَلِكَ : "" فَنِصْفُ نَذَرِ الْيَدِ ، فَإِنْ قَطَعَ مَا بَقِي بَعْدُ فَجُرْحٌ يُرَى فِيهِ ""، فَحَدَّثْتُ بِهِ عَطَاءً , فَقَالَ : مَا كُنْتُ أَحْسِبُ إِلا أَنَّهُ جُرْحٌ""","","","","","Book of Blood Money (Diyat)"
"17128","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ , وَعَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ , قَالُوا :  فِيالْيَدِ إِذَا شَلَّتْ دِيَتُهَا كَامِلَةً ""","","","","","Book of Blood Money (Diyat)"
"17129","عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ شُبْرُمَةَ , قَالَ : إِذَا نَقَصَتِ الرِّجْلُ عَنْ صَاحِبَتِهَا ، فَأَعْطِهِ بِحِسَابِ مَا نَقَصَتْ ، أَوْ زَادَتْ عَلَى صَاحِبَتِهَا ""","","","","","Book of Blood Money (Diyat)"
"17130","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ ، عَنْ عُمَرَ :  فِيالْيَدِ وَالرِّجْلِ إِذَا نَقَصَتْ فَالْحِسَابُ ""","","","","","Book of Blood Money (Diyat)"
"17131","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، عَنْ عَلِيٍّ , قَالَ :  وَفِيالأَصَابِعِ عَشْرٌ عَشْرٌ ""","","","","","Book of Blood Money (Diyat)"
"17132","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرِ بْنِ مُحَمَّدٍ ، عَنْ أَبِيهِ ، عَنْ جَدِّهِ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَتَبَ لَهُمْ كِتَابًا فِيهِ :  وَفِيأَصَابِعِ الْيَدَيْنِ ، وَالرِّجْلَيْنِ فِي كُلِّ إِصْبَعٍ مِمَّا هُنَالِكَ عَشْرٌ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"17133","قَالَ : أَخْبَرَنِي ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ , قَالَ : عِنْدَ أَبِي كِتَابٌ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيهِ :  وَفِيالأَصَابِعِ عَشْرٌ عَشْرٌ ""","","","","","Book of Blood Money (Diyat)"
"17134","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  فِيالأَصَابِعِ عَشْرٌ عَشْرٌ فِي كُلِّ إِصْبَعٍ , لا زِيَادَةَ بَيْنَهُنَّ , أَوْ قِيمَةُ ذَلِكَ مِنَ الذَّهَبِ , أَوِ الْوَرِقِ , أَوِ الشَّاءِ "", قَالَ : وَقُضِي عُمَرُ بْنُ الْخَطَّابِ : فِي كُلِّ إِصْبَعٍ عَشْرٌ مِنَ الإِبِلِ""","","","","","Book of Blood Money (Diyat)"
"17135","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ :  فِيكُلِّ إِصْبَعٍ مِمَّا هُنَالِكَ عَشْرٌ مِنَ الإِبِلِ ، أَوْ عَدْلُهَا مِنَ الذَّهَبِ أَوِ الْوَرِقِ ، وَفِي كُلِّ قَصَبَةٍ قُطِعَتْ مِنْ قَصَبِ الأَصَابِعِ ، أَوْ شَلَّتْ ثُلُثُ عَقْلِ الإِصْبَعِ فِي كُلِّ إِصْبَعٍ ، قُطِعَتْ مِنْ أَصَابِعِ يَدِ الْمَرْأَةِ أَوْ رِجْلِهَا ، أَوْ عَدْلُ ذَلِكَ مِنَ الذَّهَبِ أَوِ الْوَرِقِ ، وَفِي كُلِّ قَصَبَةٍ مِنْ قَصَبِ أَصَابِعِ الْمَرْأَةِ ثُلُثُ عَقْلِ دِيَةِ الإِصْبَعِ ، أَوْ عَدْلُ ذَلِكَ مِنَ الذَّهَبِ أَوِ الْوَرِقِ ""","","","","","Book of Blood Money (Diyat)"
"17136","عَنِ الثَّوْرِيِّ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، أَنَّ عُمَرَ جَعَلَ فِي الإِبْهَامِ خَمْسَ عَشْرَةَ ، وَفِي السَّبَّابَةِ عَشْرًا ، وَفِي الْوُسْطَى عَشْرًا ، وَفِي الْبِنْصَرِ تِسْعًا ، وَفِي الْخِنْصَرِ سِتًّا ، حَتَّى وَجَدْنَا كِتَابًا عِنْدَ آلِ حَزْمٍ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  أَنَّالأَصَابِعَ كُلَهَا سَوَاءٌ "", فَأَخَذَ بِهِ""","","","","","Book of Blood Money (Diyat)"
"17137","عَنْ إِبْرَاهِيمَ بْنِ طَهْمَانَ ، عَنِ الأَشْعَثِ بْنِ سَوَّارٍ ، عَنِ الشَّعْبِيِّ ، أَنَّ ابْنَ مَسْعُودٍ , قَالَ : الأَسْنَانُ سَوَاءٌ ، وَالأَصَابِعُ سَوَاءٌ ، وَالْعَيْنَانُ سَوَاءٌ ، وَالْيَدَانِ سَوَاءٌ ، وَالرَّجْلانِ سَوَاءٌ ، وَالأُنْثَيَانِ سَوَاءٌ ""","","","","","Book of Blood Money (Diyat)"
"17138","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، عَنْ شُرَيْحٍ ، أَنَّ عُمَرَ كَتَبَ إِلَيْهِ  أَنَّالأَصَابِعَ سَوَاءٌ ""","","","","","Book of Blood Money (Diyat)"
"17139","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ , قَالَ : سَمِعْتُ مَكْحُولا ، يَقُولُ :  فِيكُلِّ إِصْبَعٍ عَشْرٌ ، وَفِي كُلِّ سَنٍّ خَمْسٌ مِنَ الإِبِلِ ، وَالأَصَابِعِ سَوَاءٌ , وَالأَسْنَانُ سَوَاءٌ "", قَالَ مُحَمَّدٌ : وَأَخْبَرَنِي سُلَيْمَانُ بْنُ مُوسَى ، عَنْ عَمْرِو بْنِ شُعَيْبٍ ، عَنْ أَبِيهِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"17140","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِيِّ ، قَالَ : أَشْهَدُ عَلَى مَسْرُوقٍ , وَشُرَيْحٍ , أَنَّهُمَا قَالا : الأَصَابِعُ سَوَاءٌ , عَشْرًا عَشْرًا مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"17141","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ :  فِيكُلِّ مَفْصِلٍ مِنَ الأَصَابِعِ ثُلُثُ دِيَةِ الإِصْبَعِ إِلا الإِبْهَامَ ، فَإِنَّهَا مَفْصِلانِ , فِي كُلِّ مَفْصِلٍ النِّصْفُ ""","","","","","Book of Blood Money (Diyat)"
"17142","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، وَعَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ , قَالَ :  فِيكُلِّ أُنْمُلَةٍ ثُلُثُ دِيَةِ الإِصْبَعِ "", قَالَ : وَفِي حَدِيثِ عِكْرِمَةَ عَنْ عُمَرَ : "" ثَلاثُ قَلائِصَ ، وَثُلُثُ قَلُوصٍ ""","","","","","Book of Blood Money (Diyat)"
"17143","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبْدِ الرِّحْمَنِ الأَنْصَارِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : قَضَى عُمَرُ بْنُ الْخَطَّابِ فِي الأَصَابِعِ بِقَضَاءٍ ، ثُمَّ أَخْبَرَ بِكِتَابٍ كَتَبَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لآلِ حَزْمٍ :  فِيكُلِّ أُصْبُعٍ مِمَّا هُنَالِكَ عَشْرٌ مِنَ الإِبِلِ ""، فَأَخَذَ بِهِ ، وَتَرَكَ أَمَرَهُ الأَوَّلَ""","","","","","Book of Blood Money (Diyat)"
"17144","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ , قَالَ : إِذَا قُطِعَتِ الإِبْهَامُ ، وَالَّتِي تَلِيهَا فَفِيهمَا نِصْفُ الدِّيَةِ ، وَإِذَا قُطِعَتِ إِحْدَاهُمَا فَفِيهِا عَشْرٌ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"17145","عَنِ ابْنِ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى , قَالَ : فِي كِتَابِ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ إِلَى الإِجْنَادِ  فِيكُلِّ قَصَبَةٍ مِنَ قَصَبِ الأَصَابِعِ ، إِذَا قُطِعَتْ أَوْ شَلَّتْ ثُلُثُ دِيَةِ الإِصْبَعِ ، إِلا مَا كَانَ مِنَ الإِبْهَامِ ، فَإِنَّمَا هِيَ قَصَبَتَانِ ، فَفِي كُلِّ قَصَبَةٍ مِنَ الإِبْهَامِ نِصْفُ دِيَتِهِا ""","","","","","Book of Blood Money (Diyat)"
"17146","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ :  فِيالإِصْبَعِ الشَّلاءِ ، تُقْطَعُ شَيْءٌ لِجَمَالِهَا ""","","","","","Book of Blood Money (Diyat)"
"17147","عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ  فِيالْيَدِ الشَّلاءِ ثُلُثُ دِيَتِهِا ""","","","","","Book of Blood Money (Diyat)"
"17148","قَالَ : أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ دَاوُدَ بْنِ أَبِي عَاصِمٍ ، عَنِ ابْنِ الْمُسَيِّبِ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ  قَضَى فِيالْيَدِ الشَّلاءِ تُقْطَعُ بِثُلُثِ دِيَتِهِا ، وَفِي الرِّجْلِ الشَّلاءِ بِثُلُثِ دِيَتِهِا ""","","","","","Book of Blood Money (Diyat)"
"17149","عَنِ ابْنِ جُرَيْجٍ ، عَمَّنْ أَخْبَرَهُ ، عَنِ ابْنِ شِهَابٍ ، أَنَّ عُمَرَ  قَضَى فِيالْيَدِ الشَّلاءِ تُقْطَعُ بِثُلُثِ دِيَتِهِا ، وَفِي الرِّجْلِ الشَّلاءِ بِثُلُثِ دِيَتِهِا ""","","","","","Book of Blood Money (Diyat)"
"17150","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، فِيرَجُلٍ أَشَلَّ قُطِعَتْ يَدُهُ الصَّحِيحَةُ , قَالَ :  يَغْرَمُ لَهُ دِيَةَ يَدَيْنِ ""","","","","","Book of Blood Money (Diyat)"
"17151","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : قَضَى عُمَرُ بْنُ الْخَطَّابِ :  فِيالْيَدِ الشَّلاءِ ، إِذَا قُطِعَتْ بِثُلُثِ دِيَتِهِا "", عَنْ عُثْمَانَ بْنِ مَطَرٍ ، عَنْ سَعِيدٍ ، عَنْ قَتَادَةَ ، عَنْ عَبْدِ اللَّهِ بْنِ بُرَيْدَةَ ، عَنْ يَحْيَى بْنِ يَعْمُرَ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ عُمَرَ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"17152","عَنِ الثَّوْرِيِّ ، عَمَّنْ حَدَّثَهُ ، عَنِ ابْنِ الْمُسَيِّبِ ، عَنْ عُمَرَ :  فِيالْيَدِ الشَّلاءِ ، وَالسِّنِّ السَّوْدَاءِ ، وَالْعَيْنِ الْقَائِمَةِ , ثُلُثُ دِيَتِهِا ""","","","","","Book of Blood Money (Diyat)"
"17153","عَنْ أَبِي حَنِيفَةَ , عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ  فِيالْعَيْنِ الَّتِي قَدْ ذَهَبَ ضَوْءُهَا ، وَالسِّنِّ السَّوْدَاءِ ، وَالْيَدِ الشَّلاءِ ، وَذَكَرِ الْخَصِيِّ ، وَلِسَانِ الأَخْرَسِ , حُكْمٌ ""","","","","","Book of Blood Money (Diyat)"
"17154","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ  فِيالإِصْبَعِ الشَّلاءِ تُقْطَعُ نِصْفُ دِيَتِهِا ""","","","","","Book of Blood Money (Diyat)"
"17155","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ رَجُلٍ ، عَنْ مَكْحُولٍ ، عَنْ زَيْدٍ ، أَنَّهُ قَالَ :  فِيالإِصْبَعِ الزَّائِدَةِ ثُلُثُ دِيَةِ الإِصْبَعِ ""","","","","","Book of Blood Money (Diyat)"
"17156","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَنْ أَهْلِ الْعِلْمِ ، يَقُولُونَ :  فِيالإِصْبَعِ الزَّائِدَةِ ، وَالسِّنِّ الزَّائِدَةِ تُقْطَعُ , أَوْ تُطْرَحُ السِّنُّ , لَيْسَ فِيهَا شَيْءٌ ، إِلا أَنْ يَكُونَ مَكَانَهَا قَدْ شَانَ فَيَرَى فِيهِ ""","","","","","Book of Blood Money (Diyat)"
"17157","عَنْ مَعْمَرٍ , قَالَ : بَلَغَنِي :  فِيالسِّنِّ الزَّائِدَةِ ، وَالإِصْبَعِ الزَّائِدَةِ ثُلُثُ دِيَتِهِا "", قَالَ : وَقَالَ سُفْيَانُ : "" فِي الإِصْبَعِ الزَّائِدَةِ حُكْمٌ ""","","","","","Book of Blood Money (Diyat)"
"17158","عَنْ رَجُلٍ ، عَنْ مُحَمَّدِ بْنِ جَابِرٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ فِيرَجُلٍ أَشَلِّ الأَصَابِعِ قُطِعَتْ يَدُهُ عَمْدًا , قَالَ :  يُودَى مَا فِيهَا مِنَ الصِّحَّةِ , وَفِي الشَّلَلِ صُلْحٌ ""","","","","","Book of Blood Money (Diyat)"
"17159","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ :  فِيكَسْرِ الْيَدِ وَالرِّجْلِ وَالتَّرْقُوَةِ ، ثُمَّ تُجْبَرُ فَتَسْتَوِي , فِي ذَلِكَ شَيْءٌ "", وَمَا بَلَغَنِي مَا هُوَ""","","","","","Book of Blood Money (Diyat)"
"17160","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : إِذَا كُسِرَتِ الْيَدُ أَوِ الرِّجْلُ , وَإِذَا كُسِرَتِ الذِّرَاعُ , أَوِ الْفَخِذُ , أَوِ الْعَضُدُ , أَوِ السَّاقُ ، ثُمَّ جُبِرَتْ فَاسْتَوَتْ , فَفِي كُلِّ وَاحِدَةٍ عِشْرُونَ دِينَارًا "", قَالَ مَعْمَرٌ : وَبَلَغَنِي أَنَّ قَتَادَةَ ذَكَرَهُ عَنْ سُلَيْمَانَ بْنِ يَسَارٍ ، عَنْ عُمَرَ ، قَالَ قَتَادَةُ : "" فَإِنْ كَانَ فِيهَا عَثْمٌ فَأَرْبَعُونَ دِينَارًا""","","","","","Book of Blood Money (Diyat)"
"17161","كَانَ شُرَيْحٌ , يَقُولُ : إِذَا جُبِرَتْ فَلَيْسَ فِيهِ شَيْءٌ "", قَالَ : حِينَئِذٍ أَشَدُّهَا""","","","","","Book of Blood Money (Diyat)"
"17162","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عِكْرِمَةُ بْنُ خَالِدٍ : أَنَّ نَافِعَ بْنَ عَلْقَمَةَ  أُتِيَ فِي رِجْلٍ كُسِرَتْ ، فَقَالَ : كُنَّا نَقْضِي فِيهِ بِخَمْسِمِائَةِ دِرْهَمٍ "" ، حَتَّى أَخْبَرَنِي عَاصِمُ بْنُ سُفْيَانَ ، أَنَّ سُفْيَانَ بْنَ عَبْدِ اللَّهِ كَتَبَ إِلَى عُمَرَ بْنِ الْخَطَّابِ فَكَتَبَ ""بِخَمْسِ أَوَاقٍ فِي الْيَدِ ، أَوِ الرِّجْلِ تُكْسَرُ ، ثُمَّ تُجْبَرُ وَتَسْتَقِيمُ ""، قُلْتُ لِعِكْرِمَةَ : فَلا يَكُونُ فِيهِ عِوَجٌ وَلا شَلَلٌ ؟ قَالَ : "" نَعَمْ "" , قَالَ : فَقَضَى ابْنُ عَلْقَمَةَ فِيهِ بِمِائَتَيْ دِرْهَمٍ""","","","","","Book of Blood Money (Diyat)"
"17163","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبِي لَيْلَى ، عَنْ عِكْرِمَةَ بْنِ خَالِدٍ ، عَنْ رَجُلٍ ، عَنْ عُمَرَ ، أَنَّهُ قَالَ :  فِيالسَّاقِ أَوِ الذِّرَاعِ إِذَا انْكَسَرَتْ ، ثُمَّ جُبِرَتْ , فَاسْتَوَتْ فِي غَيْرِ عَثْمٍ , عِشْرُونَ دِينَارًا ، أَوْ حِقَّتَانِ ""","","","","","Book of Blood Money (Diyat)"
"17164","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي بِشْرُ بْنُ عَاصِمٍ ،  أَنَّغُلامًا لَهُمْ كَانَ يُؤَاجِرُ فِي مَكَّةَ , يَدَعُ بِذَوْدٍ عَنْ حَرْثٍ لَهُ ، فَدَخَلَ صِبْيَانٌ فَسَعَى عَلَيْهِمْ , فَضَرَبَ أَحَدَهُمْ فَدَقَّ عَضُدَهُ ، ثُمَّ جُبِرَتْ ، وَاسْتَوَتْ لَيْسَ فِيها جَوْرٌ ، وَلا بَأْسٌ , فَقَضَى ابْنُ عَلْقَمَةَ فِيها بِخَمْسِمِائَةِ دِرْهَمٍ ""، فَكَتَبَ إِلَيْهِ عَامِرٌ بِكِتَابٍ لا أَدْرِي مَا هُوَ , فَرَدَّهُ نَافِعٌ إِلَى مِائَتَيْ دِرْهَمٍ""","","","","","Book of Blood Money (Diyat)"
"17165","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ بِشْرِ بْنِ عَاصِمٍ ، عَنْ عِكْرِمَةَ بْنِ خَالِدٍ ، عَنْ عَاصِمِ بْنِ سُفْيَانَ ، أَنَّ عُمَرَ كَتَبَ إِلَى سُفْيَانَ بْنِ عَبْدِ اللَّهِ  فِيأَحَدِ الزِّنْدَيْنِ مِنَ الْيَدِ , إِذَا انْجَبَرَ عَلَى غَيْرِ عَثْمٍ مِائَتَا دِرْهَمٍ ""","","","","","Book of Blood Money (Diyat)"
"17166","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ مَعْمَرٍ ، عَنِ الْجَحْشِيِّ ، عَنْ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ، قَالَ : قَضَى مَرْوَانُ  فِيرَجُلٍ كَسَرَ رِجْلَ رَجُلٍ , ثُمَّ جُبِرَتْ بِفَرِيضَتَيْنِ , يَعْنِي قَلُوصَتَيْنِ ""","","","","","Book of Blood Money (Diyat)"
"17167","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ قَالَ :  كَتَبَ سُفْيَانُ بْنُ عَبْدِ اللَّهِ إِلَى عُمَرَ ، وَهُوَ عَامِلُهُ بِالطَّائِفِ يَسْتَشِيرُهُ ، فِييَدِ رَجُلٍ كُسِرَتْ ، فَكَتَبَ إِلَيْهِ عُمَرُ "" إِنْ كَانَتْ جُبِرَتْ صَحِيحَةً ، فَلَهُ حِقَّتَانِ ""","","","","","Book of Blood Money (Diyat)"
"17168","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، وَدَاوُدُ بْنُ قَيْسٍ ، عَنْ سَعْدِ بْنِ سَعِيدٍ ، أَخِي يَحْيَى بْنِ سَعِيدٍ ، أَنَّ عَمْرَةَ بِنْتَ عَبْدِ الرَّحْمَنِ أَخْبَرَتْهُ , عَنْ عَائِشَةَ ، أَنَّهَا سَمِعْتِ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  إِنَّكَسْرَ عَظْمِ الْمَيِّتِ مَيِّتًا كَمَثَلِ كَسْرِهِ حَيًّا ، يَعْنِي فِي الإِثْمِ "", أَخْبَرَنَا أَبُو بَكْرِ بْنُ مُحَمَّدٍ ، عَنْ سَعْدِ بْنِ سَعِيدٍ ، عَنْ عَمْرَةَ ، عَنْ عَائِشَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِهِ""","","","","","Book of Blood Money (Diyat)"
"17169","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ :  سَمِعْتُ فِيالظُّفْرِ شَيْئًا , فَمَا أَدْرِي مَا هُوَ ""","","","","","Book of Blood Money (Diyat)"
"17170","عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ , قَالَ :  إِنِاسْوَدَّتِ الظُّفْرُ ، أَوِ اعْوَرَّتْ فَنَاقَةٌ ""","","","","","Book of Blood Money (Diyat)"
"17171","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ ، أَنَّهُ كَانَ يَقُولُ : إِذَا يَبِسَتِ الظُّفْرُ فَفِيهِ نَاقَةٌ ""","","","","","Book of Blood Money (Diyat)"
"17172","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ ، عَنْ مُجَاهِدٍ ، أَنَّهُ كَانَ يَقُولُ : إِذَا لَمْ تَنْبُتْ فَنَاقَتَانِ ، وَإِنْ نَبَتَتْ عَمَّا لَيْسَ لَهَا ، وَبِيصٌ فَنَاقَةٌ ""","","","","","Book of Blood Money (Diyat)"
"17173","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : إِنْ نَبَتَتِ الظُّفْرُ فَبَعِيرٌ ، وَإِنِ اعْوَرَّتْ فَبَعِيرَانِ ""","","","","","Book of Blood Money (Diyat)"
"17174","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ الْحَارِثِ بْنِ سُفْيَانَ ، عَنْ أُذَيْنَةَ ، أَنَّهُ كَانَ يَقُولُ فِي الظُّفْرِ : إِذَا طُرِحَتْ فَلَمْ تَنْبُتِ ابْنَةُ مَخَاضٍ ، فَإِنْ لَمْ تَكُنْ فَابْنُ لَبُونٍ ""","","","","","Book of Blood Money (Diyat)"
"17175","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، عَنْ أُذَيْنَةَ ، أَنَّهُ كَانَ يَقُولُ : فِيها فَرْشٌ مِنَ الإِبِلِ , يَعْنِي صَغِيرًا ""","","","","","Book of Blood Money (Diyat)"
"17176","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ , أَنَّ عُمَرَ بْنَ الْخَطَّابِ  قَضَى فِيالظُّفْرِ إِذَا اعْوَرَّ ، وَفَسَدَ , بِقَلُوصٍ ""","","","","","Book of Blood Money (Diyat)"
"17177","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَضَى عُمَرُ بْنُ الْخَطَّابِ :  فِيالظُّفْرِ إِذَا اعْرَنْجَمَ ، وَإِذَا فَسَدَ بِقَلُوصٍ ""","","","","","Book of Blood Money (Diyat)"
"17178","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ  أَنَّهُ اجْتَمَعَ لَهُ فِيالظُّفْرِ ، إِذَا نُزِعَ فَعَرَّ ، أَوْ سَقَطَ ، أَوِ اسْوَدَّ , الْعُشْرُ مِنْ دِيَةِ الإِصْبَعِ , عَشَرَةُ دَنَانِيرَ ""","","","","","Book of Blood Money (Diyat)"
"17179","عَنِ الثَّوْرِيِّ ، عَنْ خَالِدٍ الْحَذَّاءِ ، عَنْ عَمْرِو بْنِ هَرِمٍ ، عَنْ جَابِرِ بْنِ زَيْدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ :  فِيالظُّفْرِ إِذَا اعْوَرَّ خُمْسُ دِيَةِ الإِصْبَعِ ""","","","","","Book of Blood Money (Diyat)"
"17180","قَالَ الْحَجَّاجُ ، عَنْ مَكْحُولٍ ، عَنْ زَيْدِ بْنِ ثَابِتٍ :  فِيالظُّفْرِ يُقَلَعُ : إِنْ خَرَجَ أَسْوَدَ ، أَوْ لَمْ يَخْرُجْ فَفِيهِ عَشَرَةُ دَنَانِيرَ ، وَإِنْ خَرَجَ أَبْيَضَ فَفِيهِ خَمْسَةُ دَنَانِيرَ ""","","","","","Book of Blood Money (Diyat)"
"17181","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : دِيَةُ الرَّجُلِ وَالْمَرْأَةِ سَوَاءٌ , حَتَّى يَبْلُغَ ثُلُثَ الدِّيَةِ ، وَذَلِكَ فِي الْجَائِفَةِ ، فَإِذَا بَلَغَ ذَلِكَ فِدْيَةُ الْمَرْأَةِ عَلَى النِّصْفِ مِنْ دِيَةِ الرَّجُلِ ""","","","","","Book of Blood Money (Diyat)"
"17182","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ , قَالَ : ثُلُثُ دِيَةِ الرَّجُلِ ""","","","","","Book of Blood Money (Diyat)"
"17183","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، عَنْ شُرَيْحٍ , قَالَ : كَتَبَ إِلَيَّ عُمَرُ بِخَمْسٍ مِنْ صَوَافِي الأُمَرَاءِ :  أَنَّالأَسْنَانَ سَوَاءٌ ، وَالأَصَابِعَ سَوَاءٌ ، وَفِي عَيْنِ الدَّابَّةِ رُبُعُ ثَمَنِهَا ، وَعَنِ الرَّجُلِ يُسْأَلُ عَنْ وَلَدِهِ عِنْدَ مَوْتِهِ فَأَصْدَقُ مَا يَكُونُ عِنْدَ مَوْتِهِ ، وَعَنْ جِرَاحَاتِ الرِّجَالِ ، وَالنِّسَاءِ سَوَاءٌ ، إِلَى الثُّلُثِ مِنْ دِيَةِ الرِّجَالِ ""","","","","","Book of Blood Money (Diyat)"
"17184","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ رَبِيعَةَ , قَالَ : سَأَلْتُ ابْنَ الْمُسَيِّبِ ,كَمْ فِي إِصْبَعٍ مِنْ أَصَابِعِ الْمَرْأَةِ ؟ قَالَ :  عَشْرٌ مِنَ الإِبِلِ "" , قَالَ : قُلْتُ : فِي إِصْبَعَيْنِ ؟ قَالَ : "" عِشْرُونَ "" , قَالَ : قُلْتُ : فَثَلاثٌ ؟ قَالَ : "" ثَلاثُونَ "" ، قُلْتُ : فَأَرْبَعٌ ؟ قَالَ : "" عِشْرُونَ "" , قَالَ : قُلْتُ : حِينَ عَظُمَ جُرْحُهَا ، وَاشْتَدَّتْ بَلِيَّتُهَا نَقَصَ عَقْلُهَا ؟ قَالَ : "" أَعِرَاقِيٌّ أَنْتَ ؟ "" , قَالَ : قُلْتُ : بَلْ عَالِمٌ مُتَبَيِّنٌ أَوْ جَاهِلٌ مُتَعَلِّمٌ , قَالَ : "" السُّنَّةُ "", أَخْبَرَنَا مَعْمَرٌ ، عَنْ رَبِيعَةَ ، عَنِ ابْنِ الْمُسَيِّبِ ، بِمِثْلِهِ , إِلا أَنَّهُ قَالَ : قُلْتُ : الْآنَ حِينَ عَظُمَتْ مُصِيبَتُهَا ، وَاشْتَدَّ كَلْمُهَا نَقَصَ عَقْلُهَا ؟ قَالَ : "" مِنْ أَيْنَ أَنْتَ ؟ "" , قَالَ : قُلْتُ : إِمَّا جَاهِلٌ مُتَعَلِّمٌ ، أَوْ عَالِمٌ مُتَثَبِّتٌ , قَالَ : "" السُّنَّةُ يَا ابْنَ أَخِي ! ""","","","","","Book of Blood Money (Diyat)"
"17185","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي رَبِيعَةُ ، أَنَّهُ سَمِعَ ابْنَ الْمُسَيِّبِ , يَقُولُ : يُعَاقِلُ الرَّجُلُ وَالْمَرْأَةُ ، فِيمَا دُونَ ثُلُثِ دِيَتِهِ "" , قَالَ : وَلَمْ أَسْمَعْهُ يَنُصُّهُ إِلَى أَحَدٍ""","","","","","Book of Blood Money (Diyat)"
"17186","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي هِشَامُ بْنُ عُرْوَةَ ، عَنْ عُرْوَةَ ، أَنَّهُ كَانَ يَقُولُ : دِيَةُ الْمَرْأَةِ مِثْلُ دِيَةِ الرَّجُلِ حَتَّى يَبْلُغَ الثُّلُثَ ، فَإِذَا بَلَغَ الثُّلُثَ كَانَ دِيَتُهَا مِثْلَ نِصْفِ دِيَةِ الرَّجُلِ ، تَكُونُ دِيَتُهَا فِي الْجَائِفَةِ ، وَالْمَأْمُومَةِ مِثْلَ نِصْفِ دِيَةِ الرَّجُلِ ""","","","","","Book of Blood Money (Diyat)"
"17187","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَبْدِ الْعَزِيزِ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ , قَالَ : إِنْ أُصِيبَتْ إِصْبِعَانِ مِنْ أَصَابِعِ الْمَرْأَةِ جَمِيعًا , فَفِيهما عِشْرُونَ مِنَ الإِبِلِ ، فَإِنْ أُصِيبَتْ ثَلاثٌ فَفِيهما خَمْسَ عَشْرَةَ ، فَإِنْ أُصِيبَتْ أَرْبَعٌ جَمِيعًا , فَفِيهِنَّ عِشْرُونَ مِنَ الإِبِلِ ، فَإِنْ أُصِيبَتْ أَصَابِعُهَا كُلُّهَا , فَفِيها نِصْفُ دِيَتِهِا ، وَعَقَلُ الرَّجُلِ ، وَالْمَرْأَةِ سَوَاءٌ حَتَّى يَبْلُغَ الثُّلُثَ ، ثُمَّ يُفَرَّقُ عَقْلُ الرَّجُلِ وَالْمَرْأَةِ عِنْدَ ذَلِكَ فَيُفَرَّقُ ، فَيَكُونُ عَقْلُ الرَّجُلِ فِي دِيَتِهِ ، وَعَقَلُ الْمَرْأَةِ فِي دِيَتِهِا ""","","","","","Book of Blood Money (Diyat)"
"17188","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : سَأَلْتُ عَطَاءً :حَتَّى مَتَى تُعَاقِلُ الْمَرْأَةُ الرَّجُلَ ؟ قَالَ :  عَقْلُهَا سَوَاءٌ حَتَّى يَبْلُغَ ثُلُثَ دِيَتِهِا فَمَا دُونَهُ , فَإِذَا بَلَغَتْ جُرُوحُهَا ثُلُثَ دِيَتِهِا ، كَانَ فِي جِرَاحِهَا مِنْ جِرَاحِهِ النِّصْفُ ""","","","","","Book of Blood Money (Diyat)"
"17189","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلْتُ عَطَاءً  عَنْأَرْبَعٍ مِنْ بَنَانِهَا تُصَابُ جَمِيعًا نَمِرَهُ , قَالَ : "" فِيها عِشْرُونَ ""","","","","","Book of Blood Money (Diyat)"
"17190","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : عَقْلُ الْمَرْأَةِ مِثْلُ عَقْلِ الرَّجُلِ حَتَّى يَبْلُغَ ثُلُثَ دِيَتِهِا ، وَذَلِكَ فِي الْمَنْقُولَةِ ، فَمَا زَادَ عَلَى الْمَنْقُولَةِ ، فَهُوَ نِصْفُ عَقْلِ الرَّجُلِ مَا كَانَ "", عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"17191","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، وَعُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، قَالا : تُعَاقِلُ الْمَرْأَةُ الرَّجُلَ فِي جِرَاحِهَا إِلَى ثُلُثِ دِيَتِهِا "", عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ ذَكْوَانَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"17192","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَلِيٍّ , قَالَ : جِرَاحَاتُ الْمَرْأَةِ عَلَى النِّصْفِ مِنْ جِرَاحَاتِ الرَّجُلِ "", قَالَ : وَقَالَ ابْنُ مَسْعُودٍ : "" يَسْتَوِيَانِ فِي السِّنِّ ، وَالْمُوضِحَةِ ، وَفِيمَا سِوَى ذَلِكَ عَلَى النِّصْفِ "" ، وَكَانَ زَيْدُ بْنُ ثَابِتٍ , يَقُولُ : "" إِلَى الثُّلُثِ ""","","","","","Book of Blood Money (Diyat)"
"17193","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ ، عَنِ ابْنِ مَسْعُودٍ , قَالَ : هُمَا سَوَاءٌ إِلَى خَمْسٍ مِنَ الإِبِلِ "", قَالَ : وَقَالَ عَلِيٌّ : "" النِّصْفُ مِنْ كُلِّ شَيْءٍ ""","","","","","Book of Blood Money (Diyat)"
"17194","عَنِ الثَّوْرِيِّ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : مُوضِحَةُ الْمَرْأَةِ ، وَسِنُّهَا ، وَمُنَقِّلَتُهَا , تَسْتَوِيَانِ إِلَى ثُلُثِ الْعَقْلِ ""","","","","","Book of Blood Money (Diyat)"
"17195","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : إِلَى ثُلُثِ دِيَةِ الرَّجُلِ ""","","","","","Book of Blood Money (Diyat)"
"17196","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ : مَا أَرَى الدِّيَةَ إِلا لِلْعَصَبَةِ لأَنَّهُمْ يَعْقِلُونَ عَنْهُ ، فَهَلْ سَمِعَ أَحَدٌ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي ذَلِكَ شَيْئًا ؟  ، فَقَالَ الضَّحَّاكُ ابْنُ سُفْيَانَ الْكِلابِيُّ وَكَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ اسْتَعْمَلَهُ عَلَى الأَعْرَابِ : كَتَبَ إِلَيَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" أَنْأُوَرِّثَ امْرَأَةَ أَشْيَمَ الضِّبَابِيِّ مِنْ دِيَةِ زَوْجِهَا ""، فَأَخَذَ بِذَلِكَ عُمَرُ ، عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ شِهَابٍ ، عَنِ ابْنِ الْمُسَيِّبِ ، عَنْ عُمَرَ مِثْلَهُ وَزَادَ فِيهِ ، وَقَالَ : خَطَأٌ""","","","","","Book of Blood Money (Diyat)"
"17197","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : الْمَرْأَةُ يَعْقِلُهَا عَصَبَتُهَا ، وَلا يَرِثُونَ إِلا مَا فَضَلَ مِنْ وَرَثَتِهَا ، وَهُمْ يَقْتُلُونَ قَاتِلَهَا ، وَالْمَرْأَةُ تَرِثُ مِنْ مَالِ زَوْجِهَا ، وَعَقْلِهِ ، وَيَرِثُ مِنْ مَالِهَا وَعَقْلِهَا ، مَا لَمْ يَقْتُلْ أَحَدُهُمَا صَاحِبَهُ "" , فَإِنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : "" لَيْسَ لِقَاتِلٍ مِيرَاثٌ ""","","","","","Book of Blood Money (Diyat)"
"17198","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ الْمُغِيرَةِ بْنِ شُعْبَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : الْمَرْأَةُ يَعْقِلُهَا عَصَبَتُهَا ، وَيَرِثُهَا بَنُوهَا ""","","","","","Book of Blood Money (Diyat)"
"17199","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : الْعَقْلُ عَلَى الْعَصَبَةِ ، وَالدِّيَةُ عَلَى الْمِيرَاثِ ""","","","","","Book of Blood Money (Diyat)"
"17200","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : الْعَقْلُ كَهَيْئَةِ الْمِيرَاثِ "" , قُلْتُ لَهُ : وَيَرِثُ مِنْهُ الإِخْوَةُ مِنَ الأُمِّ ؟ قَالَ : "" نَعَمْ ""","","","","","Book of Blood Money (Diyat)"
"17201","أَخْبَرَنَا مَعْمَرٌ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ أَبِي سَلَمَةَ  أَنَّهُ كَانَلا يُوَرَّثُ الإِخْوَةُ ، مِنَ الأُمِّ مِنَ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17202","أنا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، أَنَّهُ سَمِعَ عَبْدَ اللَّهِ بْنَ مُحَمَّدِ بْنِ عَلِيِّ بْنِ أَبِي طَالِبٍ , يَقُولُ : قَالَ عَلِيُّ : قَدْ ظَلَمَ الإِخْوَةَ مِنَ الأُمِّ مَنْ لَمْ يَجْعَلْ لَهُمْ مِنَ الدِّيَةِ مِيرَاثًا ""","","","","","Book of Blood Money (Diyat)"
"17203","عَنْ مَعْمَرٍ , قَالَ : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ , إِلَى عَامِلِهِ فِي امْرَأَةٍ قُتِلَ زَوْجُهَا عَمْدًا ، أَوْ رَجُلٍ قُتِلَتِ امْرَأَتُهُ عَمْدًا ، إِنِ اصْطَلَحُوا عَلَى الدِّيَةِ , فَوَرَّثَهُ مِنْ دِيَةِ امْرَأَتِهِ النِّصْفَ ، إِلا أَنْ يَكُونَ لَهَا وَلَدٌ فَوَرَّثَهُ الرّبُعَ , وَوَرَّثَهَا مِنْ دِيَةِ زَوْجِهَا الرّبُعَ ، فَإِنْ كَانَ لَهُ وَلَدٌ فَالثُّمُنُ ، فَإِنْ أَحَبُّوا أَنْ يَقْتُلُوا قَتَلُوا ، وَإِنْ أَحَبُّوا أَنْ يَعْفُوا عَفَوْا "", قَالَ : وَأَخْبَرَنِي رَجُلٌ مِنْ أَهْلِ الْجَزِيرَةِ ، أَنَّ عُمَرَ كَتَبَ بِهِ إِلَيْهِمْ""","","","","","Book of Blood Money (Diyat)"
"17204","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ ، أَنَّهُ قَالَ : وَيَقْضِي أَنَّ الْوُرَّاثَ أَجْمَعِينَ يَرِثُونَ مِنَ الْعَقْلِ , مِثْلَ مَا يَرِثُونَ مِنَ الْمِيرَاثِ ، قَالَ ابْنُ طَاوُسٍ : وَسَمِعْتُ أَهْلَ الْمَدِينَةِ يَأْثِرُونَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَرَّثَ امْرَأَةً مِنْ دِيَةِ زَوْجِهَا ، وَرَجُلا مِنْ دِيَةِ امْرَأَتِهِ ""","","","","","Book of Blood Money (Diyat)"
"17205","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : فَإِنْ قُتِلَتِ امْرَأَةٌ فَعَقْلُهَا بَيْنَ وَرَثَتِهَا , وَهُمْ يَثْأَرُونَ بِهَا ، وَيَقْتُلُونَ قَاتِلَهَا ، وَالْمَرْأَةُ تَرِثُ زَوْجَهَا مِنْ مَالِهِ ، وَعَقْلِهِ ، وَيَرِثُهَا مِنْ مَالِهَا ، وَعَقْلِهَا ، مَا لَمْ يَقْتُلْ أَحَدُهُمَا الآخَرَ "" ، وَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" الْعَقْلُ مِيرَاثٌ بَيْنَ وَرَثَةِ الْقَتِيلِ عَلَى قِسْمَةِ فَرَائِضِهِمْ فَمَا فَضَلَ لِلْعَصَبَةِ ""","","","","","Book of Blood Money (Diyat)"
"17206","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : وَيَعْقِلُ عَنِ الْمَرْأَةِ عَصَبَتُهَا مَنْ كَانُوا ، وَلا يَرِثُونَ مِنْهَا إِلا مَا فَضَلَ مِنْ وَرَثَتِهَا ""","","","","","Book of Blood Money (Diyat)"
"17207","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ :  فِيالرَّجُلِ يَقْتُلُ ابْنَهُ عَمْدًا : لا يَرِثُ مِنْ دِيَتِهِ ، وَلا مِنْ مَالِهِ شَيْئًا ، وَإِنْ قَتَلَهُ خَطَأً فَإِنَّهُ يَرِثُ مِنَ الْمَالِ ، وَلا يَرِثُ مِنَ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17208","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ ، وَعَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ ، قَالا : مَنْ قَتَلَ رَجُلا خَطَأً فَإِنَّهُ يَرِثُ مِنْ مَالِهِ ، وَلا يَرِثُ مِنْ دِيَتِهِ ، فَإِنْ قَتَلَهُ عَمْدًا لَمْ يَرِثْ مِنْ مَالِهِ ، وَلا مِنْ دِيَتِهِ ""","","","","","Book of Blood Money (Diyat)"
"17209","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ ،  أَنَّرَجُلا مِنْ بَنِي مُدْلِجٍ قَتَلَ ابْنَهُ ، فَلَمْ يُقِدْهُ مِنْهُ عُمَرُ بْنُ الْخَطَّابِ ، وَأَغْرَمَهُ دِيَتَهُ ، وَلَمْ يُوَرِّثْهُ مِنْهُ وَوَرَّثَهُ أُمَّهُ ، وَأَخَاهُ لأَبِيهِ ""","","","","","Book of Blood Money (Diyat)"
"17210","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ ، وَعَنْ قَتَادَةَ ، قَالا : اسْمُ الرَّجُلِ الَّذِي قَتَلَ عَرْفَجَةُ , فَقَالَ عُمَرُ : لا أُقِيدُ بِهِ مِنْهُ "" , فَقَالَ سُرَاقَةُ بْنُ مَالِكِ بْنِ جُعْشُمٍ : يَا أَمِيرَ الْمُؤْمِنِينَ , قَدْ قَتَلَهُ وَإِنَّهُ لأَحَبُّ إِلَيْهِ مِنْ بَصَرِهِ ، وَلَكِنَّهُ كَانَتْ عِنْدَهُ عَصَبِيَّةٌ فَقَتَلَهُ ، وَهُوَ لا يُرِيدُ قَتَلَهُ , فَأَمَرَ بِجَمِيعِ مَالِهِ ، ثُمَّ غَلَّظَ عَلَيْهِ الْعَقْلَ , قَالُوا : فَمَنْ يَرِثُهُ يَا أَمِيرَ الْمُؤْمِنِينَ ؟ قَالَ : "" فِي عَرْفَجَةَ التُّرَابُ , فَوَرَّثَهُ أُمَّهُ وَأَخَاهُ ""","","","","","Book of Blood Money (Diyat)"
"17211","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ الْكَرِيمِ ، وَذَكَرَ أَنَّ قَتَادَةَ الْمُدْلِجِيَّكَانَتْ لَهُ جَارِيَةٌ فَجَاءَتْ بِرَجُلَيْنِ فَبَلَغَا ، ثُمَّ تَزَوَّجَا ، فَقَالَتِ امْرَأَتُهُ لا أَرْضَى حَتَّى تَأْمُرَهَا بِسَرْحِ الْغَنَمِ , فَأَمَرَهَا ، فَقَالَ ابْنُهَا : نَحْنُ نَكْفِي مَا كَلَّفْتَ أُمَّنَا ، فَلَمْ تُسَرَّحْ أُمُّهُمَا , فَأَمَرَهَا الثَّانِيَةَ , فَلَمْ تَفْعَلْ ، وَسَرَّحَ ابْنُهَا فَغَضِبَ , وَأَخَذَ السَّيْفَ وَأَصَابَ سَاقَ ابْنِهِ ، فَنَزَفَ فَمَاتَ ، فَجَاءَ سُرَاقَةُ عُمَرَ بْنَ الْخَطَّابِ فِي ذَلِكَ ، فَقَالَ :  وَافَنِي بِقُدَيْدٍ بِعِشْرِينَ وَمِائَةِ بَعِيرٍ ، فَإِنِّي نَازِلٌ عَلَيْكُمْ ، فَأَخَذَ أَرْبَعِينَ خَلِفَةً ثَنِيَّةً إِلَى بَازِلِ عَامِهَا ، وَثَلاثِينَ جَذَعَةً ، وَثَلاثِينَ حِقَّةً , ثُمَّ قَالَ لأَخِيهِ : هِيَ لَكَ ، وَلَيْسَ لأَبِيكَ مِنْهَا شَيْءٌ ، وَذَكَرُوا أَنَّهُمْ عَذَرُوا قَتَادَةَ عِنْدَ عُمَرَ , فَقَالُوا : لَمْ يَتَعَمَّدْهُ , إِنَّمَا أَرَادَ الْحَدَبَ فَأَخْطَأَتْهُ ، فَغَلَّظَ عُمَرُ دِيَتَهُ فَجَعَلَهَا شِبْهَ الْعَمْدِ ""","","","","","Book of Blood Money (Diyat)"
"17212","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي عَبْدُ رَبِّهِ بْنُ سَعِيدٍ ، أَنَّ عُمَرَ , قَالَ : فِي حَدِيثِ قَتَادَةَ ، يَقُولُ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : لَيْسَ لِقَاتِلٍ شَيْءٌ ""","","","","","Book of Blood Money (Diyat)"
"17213","عَنْ مَالِكٍ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ : أَنَّ سُرَاقَةَ بْنَ جُعْشُمٍ أَتَى عُمَرَ بْنَ الْخَطَّابِ رَضِي اللَّهُ عَنْهُ فَأَخْبَرَهُ : أَنَّ رَجُلا مِنْهُمْ يُدْعَى قَتَادَةَ حَذَفَ ابْنَهُ بِسَيْفٍ , فَأَصَابَ سَاقَيْهِ ، فَنُزِي مِنْهُ فَمَاتَ , فَأَعْرَضَ عَنْهُ عُمَرُ ، فَقَالَ لَهُ سُرَاقَةُ : لَئِنْ كُنْتَ وَالِيًا لَتُقْبِلَنَّ عَلَيْنَا ، وَإِنْ كَانَ غَيْرُكَ فَأَمْرُنَا إِلَيْهِ , قَالَ : فَأَقْبَلَ إِلَيْهِ عُمَرُ , فَعَرَضَ عَلَيْهِ الأَمْرَ ، فَقَالَ عُمَرُ : اعْدُدْ لِي بِقُدَيْدٍ عِشْرِينَ وَمِائَةً ، فَلَمَّا جَاءَهُ أَخَذَ مِنْهَا ثَلاثِينَ حِقَّةً ، وَثَلاثِينَ جَذَعَةً ، وَأَرْبَعِينَ خَلِفَةً ، ثُمَّ قَالَ : أَيْنَ أَخُ الْمَقْتُولِ ؟ خُذْهَا ! ثُمَّ قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : لَيْسَ لِقَاتِلٍ مِيرَاثٌ ""","","","","","Book of Blood Money (Diyat)"
"17214","عَنِ الثَّوْرِيِّ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ ، أَنَّ عُمَرَ , قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : لَيْسَ لِقَاتِلٍ مِيرَاثٌ ""","","","","","Book of Blood Money (Diyat)"
"17215","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ , قَالَ :قَتَلَ رَجُلٌ أَخَاهُ فِي زَمَنِ عُمَرَ بْنِ الْخَطَّابِ , فَلَمْ يُوَرِّثْهُ ، فَقَالَ : يَا أَمِيرَ الْمُؤْمِنِينَ , إِنَّمَا قَتَلْتُهُ خَطَأً , قَالَ :  لَوْ قَتَلْتَهُ عَمْدًا أَقَدْنَاكَ بِهِ "", عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : "" لَيْسَ لِقَاتِلٍ مِيرَاثٌ "" , وَذَكَرَهُ عَنِ ابْنِ عَبَّاسٍ""","","","","","Book of Blood Money (Diyat)"
"17216","عَنِ الثَّوْرِيِّ ، عَنْ لَيْثٍ ، عَنْ طَاوُسٍ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : لا يَرِثُ الْقَاتِلُ مِنَ الْمَقْتُولِ شَيْئًا ""","","","","","Book of Blood Money (Diyat)"
"17217","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : مَنْ قَتَلَ قَتِيلا فَإِنَّهُ لا يَرِثُهُ ، وَإِنْ لَمْ يَكُنْ لَهُ وَارِثٌ غَيْرُهُ ، وَإِنْ كَانَ وَالِدَهُ أَوْ وَلَدَهُ ، قَضَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ : لَيْسَ لِقَاتِلٍ مِيرَاثٌ ، وَقَضَى أَنْ لا يُقْتَلَ مُسْلِمٌ بِكَافِرٍ ""","","","","","Book of Blood Money (Diyat)"
"17218","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , فِيالَّذِي يَقْتُلُ ابْنَهُ عَمْدًا , قَالَ :  لا يَرِثُ مِنْ دِيَتِهِ ، وَلا مِنْ مَالِهِ ""","","","","","Book of Blood Money (Diyat)"
"17219","عَنْ أَبِي بَكْرِ بْنِ عَيَّاشٍ ، عَنْ مُطَرِّفِ ، عَنِ الشَّعْبِيِّ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ : لا يَرِثُ الْقَاتِلُ مِنَ الْمَقْتُولِ شَيْئًا ، وَإِنْ قَتَلَهُ عَمْدًا أَوْ قَتَلَهُ خَطَأً ""","","","","","Book of Blood Money (Diyat)"
"17220","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : لا يَرِثُ الْقَاتِلُ مِنَ الدِّيَةِ ، وَلا مِنَ الْمَالِ عَمْدًا ، كَانَ أَمْ خَطَأً "", عَنِ الثَّوْرِيِّ ، وَنَحْنُ عَلَى ذَلِكَ , لا يَرِثُ عَلَى حَالٍ , عَنْ هُشَيْمٍ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"17221","عَنْ أَبِي حَنِيفَةَ , عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : الْقَاتِلُ وَإِنْ كَانَ خَطَأً لا يَرِثُ مِنَ الدِّيَةِ ، وَلا مِنَ الْمَالِ شَيْئًا ""","","","","","Book of Blood Money (Diyat)"
"17222","عَنِ الثَّوْرِيِّ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ عُبَيْدَةَ , قَالَ : أَوْلُ مَا قُضِي أَنْ لا يَرِثَ الْقَاتِلُ فِي صَاحِبِ بَنِي إِسْرَائِيلَ ""","","","","","Book of Blood Money (Diyat)"
"17223","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ عُبَيْدَةَ , قَالَ فِي حَدِيثِهِ : فَلَمْ يُورَثْ مِنْهُ ، وَلا نَعْلَمُ قَاتِلا وَرِثَ بَعْدَهُ ""","","","","","Book of Blood Money (Diyat)"
"17224","عَنْ عُثْمَانَ بْنِ مَطَرٍ ، أَوْ غَيْرِهِ , عَنْ شُعْبَةَ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ : أَنَّرَجُلا رَمَى أُمَّهُ بِحَجَرٍ فَقَتَلَهَا ، فَرُفِعَ ذَلِكَ إِلَى عَلِيِّ بْنِ أَبِي طَالِبٍ ،  فَقَضَى عَلَيْهِ بِالدِّيَةِ ، وَلَمْ يُوَرِّثْهُ مِنْهَا شَيْئًا "" ، وَقَالَ : "" نَصِيبُكَ مِنْ مِيرَاثِهَا الْجَمْرُ "" , أَوْ قَالَ : "" الْحَجَرُ ""","","","","","Book of Blood Money (Diyat)"
"17225","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حُدِّثْتُ أَنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ : لأَقْتُلَنَّهُ , قَالَ : لَيْسَ ذَلِكَ لَكَ , حَضَرْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : يُقِيدُ الأَبَ مِنَ ابْنِهِ ، وَلا يُقِيدُ الابْنَ مِنْ أَبِيهِ ""","","","","","Book of Blood Money (Diyat)"
"17226","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ قَتَلَ قَتِيلا فَإِنَّهُ لا يَرِثُهُ ، وَإِنْ لَمْ يَكُنْ لَهُ وَارِثٌ غَيْرُهُ ، وَإِنْ كَانَ وَالِدَهُ أَوْ وَلَدَهُ "" ، وَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" لَيْسَ لِقَاتِلٍ شَيْءٌ ""","","","","","Book of Blood Money (Diyat)"
"17227","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي هِشَامُ بْنُ عُرْوَةَ ، عَنْ عُرْوَةَ , قَالَ : سَأَلْنَا عَنِالرَّجُلِ يَقْتُلُ مَنْ هُوَ لَهُ وَارِثٌ خَطَأً , هَلْ يَرِثُ مِنْ دِيَتِهِ شَيْئًا ؟ قَالَ :  لا ، وَلَوْ كَانَ ذَلِكَ يَجُوزُ ، قَتَلَ الرَّجُلُ مَنْ يَكْرَهُ مِنْ أَهْلِهِ ""","","","","","Book of Blood Money (Diyat)"
"17228","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , فِيرَجُلٍ قَتَلَ أَبَاهُ , أَوْ أَخَاهُ , قَالَ :  كَانَ سَلَفُ هَذِهِ الأُمَّةِ يُغَلِّظُونَ عَلَيْهِمُ الدِّيَةَ , أَتْهَمَتْهَمُ الأَئِمَّةُ ""","","","","","Book of Blood Money (Diyat)"
"17229","عَنْ سُفْيَانَ ، أَنَّهُ قَالَ : فِيرَجُلٍ قَتَلَ ابْنَهُ عَمْدًا , قَالَ :  الدِّيَةُ فِي مَالِهِ خَاصَّةً , لَيْسَ عَلَى الْعَاقِلَةِ شَيْءٌ ، فَإِنْ كَانَ خَطَأً فَهُوَ عَلَى الْعَاقِلَةِ ""","","","","","Book of Blood Money (Diyat)"
"17230","عَنْ مُحَمَّدِ بْنِ يَحْيَى ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَةَ ، أَنَّهُ سَمِعَ رَجُلا مِنْ جُذَامٍ يُحَدِّثُ , عَنْ رَجُلٍ مِنْهُمْ يُقَالُ لَهُ : عَدِيٌّ , أَنَّهُرَمَى امْرَأَةً لَهُ بِحَجَرٍ فَمَاتَتْ , فَتَبِعَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِتَبُوكٍ , فَقَصَّ عَلَيْهِ أَمَرَهُ ، فَقَالَ لَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  تَعْقِلُهَا ، وَلا تَرِثُهَا ""","","","","","Book of Blood Money (Diyat)"
"17231","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبَّاسُ بْنُ عَبْدِ اللَّهِ ، أَنَّ عُمَرَ , قَالَ :  فِيالَّذِي يَقْتُلُ عَمْدًا ، ثُمّ لا يَقَعُ عَلَيْهِ الْقِصَاصُ "" يُجْلَدُ مِائَةً "" , قُلْتُ : كَيْفَ ؟ قَالَ : "" فِي الْحُرِّ يَقْتُلُ الْعَبْدَ عَمْدًا ، وَأَشْبَاهِ ذَلِكَ ""","","","","","Book of Blood Money (Diyat)"
"17232","عَنِ ابْنِ جُرَيْجٍ ، عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ , قَالَ : سَمِعْتُ  أَنَّالَّذِي يَقْتُلُ عَبْدًا يُسْجَنُ ، وَيُضْرَبُ مِائَةً ""","","","","","Book of Blood Money (Diyat)"
"17233","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : ضَرَبَ عُمَرُ بْنُ الْخَطَّابِ حُرًّا ، قَتَلَ عَبْدًا مِائَةً ، وَنَفَاهُ عَامًا ""","","","","","Book of Blood Money (Diyat)"
"17234","عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ شِهَابٍ , قَالَ : إِنْ قَتَلَ حُرٌّ عَبْدًا عَمْدًا ، عُوقِبَ بِجَلْدٍ وَجِيعٍ , وَسِجْنٍ , وَعِتْقِ رَقَبَةٍ ، فَإِنْ لَمْ يَجِدْ فَصِيَامُ شَهْرَيْنِ مُتَتَابِعَيْنِ ، وَإِنْ قَتَلَهُ خَطَأً أُمِرَ بِعِتْقِ رَقَبَةٍ , أَوْ صِيَامِ شَهْرَيْنِ مُتَتَابِعَيْنِ ، وَلَمْ تَكُنْ عَلَيْهِ عُقُوبَةٌ ""","","","","","Book of Blood Money (Diyat)"
"17235","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : لا قَوَدَ بَيْنَ الْحُرِّ وَالْمَمْلُوكِ ، وَلَكِنِ الْعُقُوبَةَ ، وَالنَّكَالَ ، وَغُرْمَ مَا أَصَابَ ، وَيُعْتِقُ رَقَبَةً "", وَقَضَى بِذَلِكَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ""","","","","","Book of Blood Money (Diyat)"
"17236","عَنْ مَعْمَرٍ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , قَالَ : لا تَحْمِلُ الْعَاقِلَةُ الاعْتِرَافَ ""","","","","","Book of Blood Money (Diyat)"
"17237","عَنِ ابْنِ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ  قَضَى أَنَّالْعَاقِلَةَ ، لا تَحْمِلُ الاعْتِرَافَ ، وَلا الصُّلْحَ إِلا أَنْ يَشَاءُوا ""","","","","","Book of Blood Money (Diyat)"
"17238","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ ، عَنْ عُمَرَ , قَالَ : الدِّيَةُ عَلَى الأَوْلِيَاءِ فِي كُلِّ جَرِيرَةٍ جَرَّهَا ""","","","","","Book of Blood Money (Diyat)"
"17239","عَنِ الثَّوْرِيِّ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِيِّ , قَالَ : أَرْبَعَةٌ لَيْسَ فِيهِنَّ عَقْلٌ عَلَى الْعَاقِلَةِ ، هِيَ فِي خَاصَّةِ مَالِهِ : الْعَمْدُ ، وَالاعْتِرَافُ ، وَالصُّلْحُ ، وَالْمَمْلُوكُ ""","","","","","Book of Blood Money (Diyat)"
"17240","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : الْعَمْدُ , وَشِبْهُ الْعَمْدِ ، وَالاعْتِرَافُ ، وَالصُّلْحُ لا تَحْمِلُهُ عَنْهُ الْعَاقِلَةُ ، هُوَ عَلَيْهِ فِي مَالِهِ إِلا أَنْ تُعِينَهُ الْعَاقِلَةُ ، وَعَلَيْهِمْ أَنْ يُعِينُوهُ , كَمَا بَلَغَنَا أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ فِي كِتَابِهِ الَّذِي كَتَبَهُ بَيْنِ قُرَيْشٍ وَالأَنْصَارِ :لا يَتْرُكُونَ مُفْرَحًا أَنْ يُعِينُوهُ فِي فَكَاكٍ ، أَوْ عَقْلٍ , قَالَ : وَالْمُفْرَحُ كُلُّ مَا لا تَحْمِلُهُ الْعَاقِلَةُ","","","","","Book of Blood Money (Diyat)"
"17241","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ : لَيْسَ لَهُمْ أَنْ يَخْذِلُوهُ عِنْدَ شَيْءٍ أَصَابَهُ , يَعْنِي : فِي الصُّلْحِ ""","","","","","Book of Blood Money (Diyat)"
"17242","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبِي لَيْلَى , قَالَ : شِبْهُ الْعَمْدِ عَلَى الرَّجُلِ فِي مَالِهِ دُونَ الْعَاقِلَةِ "", قَالَ سُفْيَانُ : وَأَصْحَابُنَا يَرَوْنَ ذَلِكَ عَلَى الْعَاقِلَةِ""","","","","","Book of Blood Money (Diyat)"
"17243","عَنْ أَبِي حَنِيفَةَ , عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : لا تَعْقِلُ الْعَاقِلَةُ مَا دُونَ الْمُوضِحَةِ ، وَلا تَعْقِلُ الْعَمْدَ ، وَلا الصُّلْحَ ، وَلا الاعْتِرَافَ ""","","","","","Book of Blood Money (Diyat)"
"17244","عَنِ الثَّوْرِيِّ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِيِّ , قَالَ : كُلُّ جِرَاحَةٍ لا يُقَادُ مِنْهَا فَهِيَ مِنْ مَالِ الْمُصِيبِ إِذَا كَانَ عَمْدًا "", وَقَالَهُ ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ""","","","","","Book of Blood Money (Diyat)"
"17245","قَالَ سُفْيَانُ : مَا دُونَ الْمُوضِحَةِ فَهُوَ عَلَى الَّذِي أَصَابَ ، وَالْمُوضِحَةُ فَمَا فَوْقَهَا عَلَى الْعَاقِلَةِ ""، وَقَضَى عُمَرُ بْنُ عَبْدِ الْعَزِيزِ : "" بِالْمُوضِحَةِ عَلَى الْعَاقِلَةِ ""","","","","","Book of Blood Money (Diyat)"
"17246","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : الثُّلُثُ فَمَا دُونَهُ فِي خَاصَّةِ مَالِهِ ، وَمَا زَادَ فَهُوَ عَلَى الْعَاقِلَةِ ""","","","","","Book of Blood Money (Diyat)"
"17247","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : إِذَا بَلَغَ الثُّلُثَ فَهُوَ عَلَى الْعَاقِلَةِ "", قَالَ : وَقَالَ لِي ذَلِكَ ابْنُ أَيْمَنَ ، وَلا أَشُكُّ أَنَّهُ قَالَ : "" وَمَا لَمْ يَبْلُغِ الثُّلُثَ ، فَعَلَى قَوْمِ الرَّجُلِ خَاصَّةً ""","","","","","Book of Blood Money (Diyat)"
"17248","عَنِ ابْنِ جُرَيْجٍ ، وَمَعْمَرٍ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عُمَرَ , قَالَ : إِنَّهُمْ مُجْتَمِعُونَ ، أَوْ قَالَ عَبْدُ الرَّزَّاقِ قَالَ : كِدْنَا أَنْ نَجْتَمِعَ أَنَّمَا دُونَ الثُّلُثِ فِي مَالِهِ خَاصَّةً, قَالَ سُفْيَانُ :  فِي جِنَايَةِ الصَّبِيِّ مَا كَانَ مِنْ مَالٍ فَهُوَ فِي مَالِهِ ، وَمَا كَانَ مِنْ جِرَاحٍ فَهُوَ عَلَى الْعَاقِلَةِ , ح "" , قَالَ : وَقَالَ ابْنُ أَبِي لَيْلَى : "" فِي صَبِيٍّ افْتَضَّ صَبِيَّةً , هُوَ فِي مَالِ الصَّبِيِّ ""","","","","","Book of Blood Money (Diyat)"
"17249","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : إِنْ قَتَلَ رَجُلٌ عَبْدًا خَطَأً فَهُوَ عَلَى عَاقِلَتِهِ ، وَإِنْ قَتَلَ دَابَّةً خَطَأً فَهُوَ عَلَى عَاقِلَتِهِ "", قَالَ ابْنُ جُرَيْجٍ : وَقَالَ عَمْرُو بْنُ دِينَارٍ : وَسُلَيْمَانُ بْنُ مُوسَى : "" لا تَحْمِلُهُ الْعَاقِلَةُ , هُوَ عَلَيْهِ فِي مَالِهِ , لأَنَّهُ مَالٌ ""","","","","","Book of Blood Money (Diyat)"
"17250","عَنْ مَعْمَرٍ ، عَنْ بَعْضِ عُلَمَاءِ أَهْلِ الْكُوفَةِ , قَالَ : الْمُوضِحَةُ فَمَا فَوْقَهَا عَلَى الْعَاقِلَةِ ، إِذَا كَانَ خَطَأً ""","","","","","Book of Blood Money (Diyat)"
"17251","عَنِ ابْنِ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى ، فِيالرَّجُلِ يَقْتُلُ الرَّجُلَ عَمْدًا فَيَرْضَى مِنْهُ بِالدِّيَةِ , قَالَ :  لا تَعْقِلُهُ الْعَاقِلَةُ إِلا أَنْ يَشَاءُوا "" , قَالَ : "" وَالاعْتِرَافُ كَذَلِكَ "", قَالَ : وَقَضَى بِذَلِكَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ""","","","","","Book of Blood Money (Diyat)"
"17252","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : سَمِعْتُهُ أَوْ قَالَ : بَلَغَنِي عَنْهُ , قَالَ : الثُّلُثُ فَمَا دُونَهُ فِي خَاصَّةِ مَالِهِ ""","","","","","Book of Blood Money (Diyat)"
"17253","عَنْ زَمْعَةَ ، عَنْ زِيَادٍ الْخُرَاسَانِيِّ ، عَنِ الزُّهْرِيِّ , قَالَ : الثُّلُثُ فَمَا دُونَهُ مِنْ خَاصَّةِ مَالِهِ ، وَمَا زَادَ عَلَى ذَلِكَ فَعَلَى أَهْلِ الدِّيوَانِ ""","","","","","Book of Blood Money (Diyat)"
"17254","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ ، فِيالرَّجُلِ يُصِيبُ نَفْسَهُ ، قَالا : عَنْ عُمَرُ  يَدٌ مِنْ أَيْدِي الْمُسْلِمِينَ ""","","","","","Book of Blood Money (Diyat)"
"17255","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ :  أَنَّرَجُلا فَقَأَ عَيْنَ نَفْسِهَ خَطَأً , فَقَضَى لَهُ عُمَرُ "" بِدِيَتِهِا عَلَى عَاقِلَتِهِ ""","","","","","Book of Blood Money (Diyat)"
"17256","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : كَانَ رَاجِزٌ يَرْجُزُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَ : فَنَزَلَ ابْنُهُ بَعْدَمَا مَاتَ ، فَقَالَ : أَرْجُزُ بِكَ يَا رَسُولَ اللَّهِ ؟ قَالَ :  نَعَمْ "" , قَالَ : فَقَالَ عُمَرُ : انْظُرْ مَاذَا تَقُولُ ؟ قَالَ : أَقُولُ : تَالَلَهُ لَوْلا اللَّهُ مَا اهْتَدَيْنَا فَقَالَ عُمَرُ : صَدَقْتَ . وَلا تَصَدَّقْنَا وَلا صَلَّيْنَا فَقَالَ عُمَرُ : صَدَقْتَ , فَأَنْزِلَنْ سَكِينَةً عَلَيْنَا وَثَبِّتِ الأَقْدَامَ إِنْ لاقَيْنَا وَالْمُشْرِكُونَ قَدْ بَغَوْا عَلَيْنَا إِذَا يَقُولُوا اكْفُرُوا أَبَيْنَا ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" مَنْ يَقُولُ هَذَا ؟ "" , قَالَ : أَبِي يَا رَسُولَ اللَّهِ ، قَالَهَا! قَالَ : "" رَحِمَهُ اللَّهُ "" , قَالَ : يَا رَسُولَ اللَّهِ ،قَدْ يَأْبَى النَّاسُ الصَّلاةَ عَلَيْهِ , مَخَافَةَ أَنْ يَكُونَ قَتَلَ نَفْسَهُ ، فَقَالَ : "" كَلا بَلْ مَاتَ مُجَاهِدًا لَهُ أَجْرَانِ اثْنَانِ "", قَالَ الزُّهْرِيُّ : كَانَ ضَرَبَ رَجُلا مِنَ الْمُشْرِكِينَ بِسَيْفِهِ فَأَصَابَ نَفْسَهُ بِسَيْفِهِ فَمَاتَ""","","","","","Book of Blood Money (Diyat)"
"17257","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ , فِيرَجُلٍ قَتَلَ رَجُلا عَمْدًا ، ثُمَّ فَرَّ ، فَلَمْ يَقْدِرْ عَلَيْهِ حَتَّى مَاتَ ، وَتَرَكَ مَالا , قَالَ :  لَيْسَ لَهُمْ إِلا الْقَوَدُ ""","","","","","Book of Blood Money (Diyat)"
"17258","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : إِنْ قَتَلَ رَجُلٌ رَجُلا عَمْدًا فَفَرَّ , فَلَمْ يَقْدِرْ عَلَيْهِ حَتَّى مَاتَ ، وَتَرَكَ مَالا , فَدِيَتُهُ فِي مَالِهِ دِيَةُ الْمَقْتُولِ "" ، قِيلَ لَهُ : فَسُجِنَ الْقَاتِلُ حَتَّى مَاتَ ؟ قَالَ : قَدْ قَتَلُوهُ حَبَسُوهُ فِي السِّجْنِ حَتَّى مَاتَ ، وَأَقُولُ أَنَا : "" إِنْ حَبَسُوهُ لأَنْ يَتَثَبَّتُوا فِي شَأْنِهِ , فَلَمْ يَتَثَبَّتُوا ، ثُمَّ قَامَتِ الْبَيِّنَةُ بَعْدَمَا مَاتَ أَنَّهُ قُتِلَ ، كَانَتْ دِيَةُ الْمَقْتُولِ فِي مَالِهِ ، وَإِنْ حَبَسُوهُ ، وَقَدْ تَثَبَّتُوا أَنَّهُ الْقَاتِلُ حَتَّى مَاتَ , فَلا حَقَّ لِلْمَقْتُولِ ""","","","","","Book of Blood Money (Diyat)"
"17259","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي هِشَامُ بْنُ عُرْوَةَ , قَالَ : سَأَلْتُهُ عَنِالرَّجُلِ ، إِذَا قَتَلَ أَحَدًا , أَمِنْ مَالِهِ يَعْقِلُ عَنْهُ ؟ أَوْ تَعْقِلُ عَنْهُ الْعَشِيرَةُ ؟ قَالَ :  مَا كَانَ مِنْ عَمْدٍ فَلا تَعْقِلُهُ الْعَشِيرَةُ ، إِلا أَنْ يَشَاءُوا ""","","","","","Book of Blood Money (Diyat)"
"17260","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ : كُلُّ شَيْءٍ لَيْسَ فِيهِ قَوَدٌ عَقْلُهُ فِي مَالِ الْمُصِيبِ ، فَإِنْ لَمْ يَكُنْ لَهُ مَالٌ فَعَلَى عَاقِلَةِ الْمُصِيبِ إِنْ قَطَعَ يَمِينَهُ عَمْدًا ، وَكَانَتْ يَمِينُ الْقَاطِعِ قَدْ قُطِعَتْ قَبْلَ ذَلِكَ ، فَعَقْلُهَا فِي مَالِ الْقَاطِعِ ، فَإِنْ لَمْ يَكُنْ لَهُ مَالٌ فَعَلَى عَاقِلَتِهِ ، وَإِنْ كَانَتْ لَهُ يَدٌ يُسْرَى لَمْ يُقَدْ مِنْهَا ، وَالْعَقْلُ كَذَلِكَ فِي الأَعَضَاءِ كُلِّهَا "", وَقَالَ مِثْلَ ذَلِكَ ابْنُ شِهَابٍ""","","","","","Book of Blood Money (Diyat)"
"17261","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , فِيرَجُلِ يَقْتُلُ ابْنَهُ خَطَأً , قَالَ :  يَغْرَمُ دِيَتَهُ عَاقِلَتُهُ إِذَا قَامَتِ الْبَيِّنَةُ ""عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، مِثْلَ قَوْلِ الزُّهْرِيّ""","","","","","Book of Blood Money (Diyat)"
"17262","قَالَ ابْنُ جُرَيْجٍ : فَقُلْتُ لِعَطَاءٍ :وَالْعَبْدُ يَقْتُلُ ابْنَهُ حُرًّا , قَالَ :  لا بُدَّ أَنْ يُودَى ""","","","","","Book of Blood Money (Diyat)"
"17263","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , فِيرَجُلٍ فَقَأَ عَيْنَ ابْنِهِ خَطَأً , أَوْ كَسَرَ يَدَهُ خَطَأً , قَالَ :  إِنْ قَامَتْ بَيِّنَةٌ عَلَى ذَلِكَ كَانَ عَقْلُهُ عَلَى عَاقِلَتِهِ ، وَإِنْ لَمْ تَقُمْ بَيِّنَةٌ فَلا شَيْءَ لَهُ , إِلا أَنْ يَكُونَ فِي خَاصَّةِ مَالِهِ ""","","","","","Book of Blood Money (Diyat)"
"17264","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَطَاءً ، يَقُولُ : إِنَّهُ لا يُقَادُ الابْنُ مِنْ أَبِيهِ ، وَتُقَادُ الْمَرْأَةُ مِنْ زَوْجِهَا ""","","","","","Book of Blood Money (Diyat)"
"17265","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الرَّجُلُ يُصِيبُ نَفْسَهُ بِالْجُرْحِ خَطَأً , قَالَ :  يَعْقِلُهُ عَاقِلَتُهُ "" ، يُقَالُ : يَدٌ مِنْ أَيْدِي الْمُسْلِمِينَ ، ثُمَّ أَخْبَرَنِي : بَيْنَا رَجُلٌ يَسِيرُ عَلَى دَابَّتِهِ ضَرَبَهَا ، فَرَجَعَتْ ثَمَرَةُ سَوْطِهِ , فَفَقَأَتْ عَيْنَهُ ، فَكَتَبَ فِيهِا عَمْرُو بْنُ الْعَاصِ إِلَى عُمَرَ , فَكَتَبَ عُمَرُ : ""إِنْ قَامَتِ الْبَيِّنَةُ ، أَنَّهُ أَصَابَ نَفْسَهُ خَطَأً فَلْيُودَ "" ، قَالَ عُمَرُ : "" يَدٌ مِنْ أَيْدِي الْمُسْلِمِينَ "", قَالَ : وَأَمَّا عَمْرُو بْنُ شُعَيْبٍ , فَقَالَ : ضَرَبَ رَجُلٌ دَابَّتَهُ بِعَصًا فَرَجَعَتْ عَلَى عَيْنِهِ ، ثُمَّ حَدَّثَ نَحْوَ هَذَا""","","","","","Book of Blood Money (Diyat)"
"17266","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ فِيرَجُلٍ قَتَلَ رَجُلا خَطَأً ، ثُمَّ قَتَلَ آخَرَ عَمْدًا , قَالَ :  يُقْتَلُ ، ثُمَّ تَكُونُ دِيَةُ الْخَطَإِ عَلَى عَاقِلَتِهِ ، وَإِنْ قَتَلَ رَجُلا عَمْدًا ، ثُمَّ قَتَلَ آخَرَ ، خَطَأً فَكَذَلِكَ ""، قَالَ قَتَادَةُ : وَقَالَ عَطَاءُ بْنُ أَبِي رَبَاحٍ : مَا كُنْتُ لأُخَيِّبَ أَهْلَ الأَوَّلِ مِنَ الدِّيَةِ ، إِذَا فَاتَهُمُ الْقَوَدُ , قَالَ مَعْمَرٌ : وَقَالَهُ الزُّهْرِيُّ""","","","","","Book of Blood Money (Diyat)"
"17267","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , فِيرَجُلٍ قَتَلَ رَجُلا عَمْدًا ، ثُمَّ حُبِسَ فِي الْحَبْسِ ، فَجَاءَهُ رَجُلٌ فَقَتَلَهُ خَطَأً , قَالَ :  تَكُونُ الدِّيَةُ عَلَى الَّذِي قَتَلَهُ لأَوْلِيَاءِ الرَّجُلِ الَّذِي قَتَلَ عَمْدًا , حِينَ سَبَقَهُمُ الْقَوَدُ الَّذِي كَانَ عَلَيْهِ ""","","","","","Book of Blood Money (Diyat)"
"17268","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ عَطَاءٌ : إِنْ قَتَلَ رَجُلٌ رَجُلا خَطَأً ، ثُمَّ قَتَلَ آخَرَ عَمْدًا ، فَلْيُودَ الْخَطَأُ مِنْ أَجْلِ أَنَّهُ قَدْ كَانَ ثَبَتَ عَقْلُهُ قَبْلَ الْعَمْدِ ""","","","","","Book of Blood Money (Diyat)"
"17269","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ : فِيرَجُلٍ قَتَلَ رَجُلا عَمْدًا ، فَجَاءَ الآخَرُ فَقَتَلَ الْقَاتِلَ عَمْدًا , قَالَ :  لأَهْلِ الْقَتِيلِ الَّذِي قَتَلَ عَلَى قَاتَلِهِمُ الدِّيَةُ ""","","","","","Book of Blood Money (Diyat)"
"17270","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : إِنْ قَتَلَ عَمْدًا ، ثُمَّ قُتِلَ هُوَ خَطَأً , فَلَهُمَا الدِّيَةُ ، إِذَا فَاتَهُمُ الْقَوَدُ الأَوَّلُ ""، وَكَذَلِكَ قَالَ قَتَادَةُ : عَنْ عَطَاءٍ""","","","","","Book of Blood Money (Diyat)"
"17271","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ , قَالَ : إِنَّمَا كَانَ لَهُمُ الْقَوَدُ ، فَلا شَيْءَ لَهُمْ إِنَّمَا دِيَتُهُ لِوَرَثَةِ الَّذِي قَتَلَ خَطَأً "", وَهُوَ قَوْلُ : قَتَادَةَ""","","","","","Book of Blood Money (Diyat)"
"17272","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , فِيرَجُلٍ قَتَلَ رَجُلا عَمْدًا ، ثُمَّ قَتَلَ آخَرَ خَطَأً , قَالَ :  يُقْتَلُ بِهِ ، وَتَكُونُ الدِّيَةُ لِلأَوَّلِينَ عَلَى هَؤُلاءِ الَّذِينَ اسْتَقَادُوا مِنْ صَاحِبِهِمْ ""، قَالَ مَعْمَرٌ : وَقَالَ الْحَسَنُ : "" لا قَوَدَ ، وَلا دِيَةَ ""","","","","","Book of Blood Money (Diyat)"
"17273","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنْ عَطَاءِ بْنِ أَبِي رَبَاحٍ , فِيرَجُلٍ قَتَلَ رَجُلا عَمْدًا ، ثُمَّ جَاءَ آخَرُ فَقَتَلَهُ خَطَأً , قَالَ :  تَكُونُ الدِّيَةُ لأَهْلِ الأَوَّلِ ""","","","","","Book of Blood Money (Diyat)"
"17274","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , فِيرَجُلٍ قَتَلَ عَمْدًا ، ثُمَّ قَتَلَ خَطَأً , قَالَ :  لا يُودَى مِنْ أَجْلِ أَنَّهُ أَغْلَقَ دِيَتَهُ ""","","","","","Book of Blood Money (Diyat)"
"17275","عَنِ الثَّوْرِيِّ , فِيرَجُلٍ قَتَلَ رَجُلا , فَجَاءَ رَجُلٌ فَقَتَلَ الْقَاتِلَ , قَالَ :  يُقْتَلُ بِهِ الَّذِي قَتَلَهُ ، وَيَبْطُلُ دَمُ الأَوَّلِ ، إِنَّمَا كَانَ لَهُمُ الْقَوَدُ فَفَاتَهُمْ ""","","","","","Book of Blood Money (Diyat)"
"17276","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , فِيرَجُلٍ قَتَلَ رَجُلا , فَلَقِيَهُ وَلِيُّ الْمَقْتُولِ فَقَتَلَهُ ، وَلَمْ يُبْلِغْهُ السُّلْطَانَ ، أَوْ قَالَ الإِمَامَ ، قَالَ :  عَلَيْهِ الْعُقُوبَةُ وَلا يُقْتَلُ ""","","","","","Book of Blood Money (Diyat)"
"17277","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , فِيرَجُلٍ سَرَقَ , فَعَدَا عَلَيْهِ رَجُلٌ فَقَطَعَ يَدَهُ , قَالَ :  تُقْطَعُ يَدُ الَّذِي عَدَا عَلَيْهِ ، وَتُقْطَعُ رِجْلُ السَّارِقِ ""، قَالَ مَعْمَرٌ : وَسَمِعْتُ مَنْ يَقُولُ : "" عَلَى الَّذِي قَطَعَ السَّارِقَ الدِّيَةُ ، وَلَيْسَ عَلَى السَّارِقِ غَيْرُ مَا صُنِعَ بِهِ "" , قَالَ : وَقَالَ ابْنُ أَبِي لَيْلَى : فِي رَجُلٍ قَطَعَ يَدَ رَجُلٍ , فَجَاءَ أَبُو الْمَقْطُوعِ ، فَقَطَعَ يَدَ الْقَاطِعِ , قَالَ : "" يُقْطَعُ ""","","","","","Book of Blood Money (Diyat)"
"17278","عَنِ الثَّوْرِيِّ , قَالَ : إِذَا قُطِعَ السَّارِقُ ، وَقُتِلَ الزَّانِي قَبْلَ أَنْ يُبْلِغَهُ السُّلْطَانَ , فَعَلَيْهِ الْقِصَاصُ ، وَلَيْسَ عَلَى السَّارِقِ وَالزَّانِي غَيْرُ ذَلِكَ ، لأَنَّ الَّذِي عَلَيْهِمَا قَدْ أُخِذَ مِنْهُمَا ، وَإِذَا قُتِلَ الْمُرْتَدُّ قَبْلَ أَنْ يَرْفَعَهُ إِلَى السُّلْطَانِ , فَلَيْسَ عَلَى قَاتَلِهِ شَيْءٌ ""","","","","","Book of Blood Money (Diyat)"
"17279","عَنِ الثَّوْرِيِّ , فِيرَجُلٍ قَتَلَ رَجُلا وَلَهُ أَخَوَانِ , فَعَفَا أَحَدُهُمَا ، ثُمَّ قَتَلَهُ الآخَرُ قَبْلَ أَنْ يَرْفَعَهُ إِلَى الإِمَامِ , قَالَ :  هُوَ خَطَأٌ , عَلَيْهِ الدِّيَةُ , يُؤْخَذُ مِنْهُ نِصْفُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"17280","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :أَبَى الْقَوْمُ أَنْ يَعْقِلُوا عَنْ مَوْلاهُمْ , أَيَكُونُ مَوْلَى مَنْ عَقَلَ عَنْهُ ؟ قَالَ : قَالَ مُعَاوِيَةُ :  إِمَّا أَنْ يَعْقِلُوا عَنْهُ ، وَإِمَّا أَنْ نُعَاقِلَ عَنْهُ ، وَهُوَ مَوْلانَا ""، قَالَ عَطَاءٌ : "" فَإِنْ أَبَى أَهْلُهُ أَنْ يَعْقِلُوا عَنْهُ ، وَأَبَى النَّاسُ أَنْ يَعْقِلُوا عَنْهُ , فَهُوَ مَوْلَى الْمُصَابِ ""","","","","","Book of Blood Money (Diyat)"
"17281","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ ، قَالَ : قَضَى عُمَرُ بْنُ الْخَطَّابِ أَنَّهُ مَا أَصَابَ أَحَدٌ مِنَ الْمُسْلِمِينَ مِنْ عَقْلٍ كَانَ عَلَيْهِ فِي شَيْءٍ , إِنْ أَصَابَهُ فَهُوَ عَقْلٌ عَلَى عَاقِلَتِهِ ، إِنْ شَاءُوا ، وَإِنْ أَبَوْا فَلَيْسَ لَهُمْ أَنْ يَخْذِلُوهُ عِنْدَ شَيْءٍ أَصَابَهُ ""","","","","","Book of Blood Money (Diyat)"
"17282","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ , قَالَ : الدِّيَةُ عَلَى أَوْلِيَائِهِ فِي كُلِّ جَرِيرَةٍ جَرَّهَا ""","","","","","Book of Blood Money (Diyat)"
"17283","عَنِ الثَّوْرِيِّ , قَالَ : إِذَا أَبَتِ الْعَاقِلَةُ أَنْ يَعْقِلُوا عَنْ مَوْلاهُمْ ، جُبِرُوا عَلَى ذَلِكَ ""","","","","","Book of Blood Money (Diyat)"
"17284","عَنْ مَعْمَرٍ , قَالَ : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ  أَنَّالْمَوَالِي لا تَحْمِلُ أَنْسَابُهَا مَعَاقِلَهَا ، وَلَكِنَّهُ عَلَى مَوَالِيهِمْ وَعَاقِلَتِهِمْ ""","","","","","Book of Blood Money (Diyat)"
"17285","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرْتُ عَنْ أَبِي وَائِلٍ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ : جَعَلَ الدِّيَةَ الْكَامِلَةَ فِي ثَلاثِ سِنِينَ ، وَجَعَلَ نِصْفَ الدِّيَةِ فِي سَنَتَيْنِ ، وَمَا دُونَ النِّصْفَ فِي سَنَةٍ ""، قَالَ ابْنُ جُرَيْجٍ : وَجَعَلَ عُمَرُ : "" الثُّلُثَيْنِ فِي سَنَتَيْنِ ""","","","","","Book of Blood Money (Diyat)"
"17286","عَنِ الثَّوْرِيِّ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِيِّ ، أَنَّ عُمَرَ جَعَلَ الدِّيَةَ فِي الأُعْطِيَةِ فِي ثَلاثِ سِنِينَ وَالنِّصْفَ ، وَالثُّلُثَيْنِ فِي سَنَتَيْنِ ، وَالثُّلُثَ فِي سَنَةٍ ، وَمَا دُونَ الثُّلُثِ فَهُوَ مِنْ عَامِهِ ""","","","","","Book of Blood Money (Diyat)"
"17287","عَنِ الثَّوْرِيِّ ، عَنْ أَيُّوبَ بْنِ مُوسَى ، عَنْ مَكْحُولٍ ، عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، أَنَّهُ سَمِعَ مَكْحُولا يُحَدِّثُ بِهِ , عَنْ عُمَرَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ : الدِّيَةُ اثْنَا عَشَرَ أَلْفًا عَلَى أَهْلِ الدَّرَاهِمِ ، وَعَلَى أَهْلِ الدَّنَانِيرِ أَلْفُ دِينَارٍ ، وَعَلَى أَهْلِ الإِبِلِ مِائَةٌ مِنَ الإِبِلِ ، وَعَلَى أَهْلِ الْبَقَرِ مِائَتَا بَقَرَةٍ ، وَعَلَى أَهْلِ الشَّاءِ أَلْفًا شَاةٍ ، وَعَلَى أَهْلِ الْحُلَلِ مِائَتَا حُلَّةٍ ، وَقَضَى بِالدِّيَةِ الثُّلُثَيْنِ فِي سَنَتَيْنِ ، وَالنِّصْفَ فِي سَنَتَيْنِ ، وَالثُّلُثَ فِي سَنَةٍ ، وَمَا كَانَ أَقَلَّ مِنَ الثُّلُثِ فَهُوَ فِي عَامِهِ ذَلِكَ ""","","","","","Book of Blood Money (Diyat)"
"17288","عَنْ مَعْمَرٍ ، عَنْ حَمَّادٍ ، أَوْ غَيْرِهِ , عَنِ النَّخَعِيِّ , قَالَ : إِذَا كَانَ ثُلُثُ الدِّيَةِ فَفِي سَنَةٍ ، وَإِذَا كَانَ ثُلُثَا الدِّيَةِ أَوْ نِصْفُ الدِّيَةِ فَفِي سَنَتَيْنِ ""","","","","","Book of Blood Money (Diyat)"
"17289","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , قَالَ : تُؤْخَذُ الدِّيَةُ فِي ثَلاثِ سِنِينَ ""","","","","","Book of Blood Money (Diyat)"
"17290","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، قَالَ : سَمِعْتُ جَعْفَرًا , يَقُولُ : قَضَى عُثْمَانُ أَيُّمَا رَجُلٍ جَالَسَ أَعْمَى فَأَصَابَهُ بِشَيْءٍ فَهُوَ هَدَرٌ ""","","","","","Book of Blood Money (Diyat)"
"17291","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : يَغْرَمُ الْقَائِدُ عَنْ يَدِهَا ، وَلا يَغْرَمُ عَنْ رِجْلِهَا "" , قَالَ : قُلْتُ لَهُ : فَكَانَتِ الدَّابَّةُ عَارَمَةً فَضَرَبَتْ بِيَدِهَا إِنْسَانًا ، وَهِيَ تُقَادُ , قَالَ : "" يَغْرَمُ الْقَائِدُ ""","","","","","Book of Blood Money (Diyat)"
"17292","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :السَّائِقُ يَغْرَمُ عَنِ الْيَدِ وَالرَّجُلِ ؟ قَالَ :  زَعَمُوا أَنَّهُ يَغْرَمُ عَنِ الْيَدِ ، فَرَادَدْتُهُ "" ، فَقَالَ : يَقُولُ : "" الطَّرِيقَ الطَّرِيقَ ""","","","","","Book of Blood Money (Diyat)"
"17293","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : يَغْرَمُ الْقَائِدُ مَا أَوْطَأَ بِيَدٍ أَوْ رِجْلٍ ، فَإِذَا نَفَحَتْ لَمْ يُغْرَمْ "" , قَالَ : "" وَالرَّاكِبُ كَذَلِكَ إِلا أَنْ يَكْفَحَ بِالْعَنَانِ فَتَنْفَحَ , فَيُغَرَمَ ""","","","","","Book of Blood Money (Diyat)"
"17294","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، فِيالرَّدِيفَيْنِ , قَالَ :  إِذَا أَصَابَتْ دَابَّتُهُمَا أَحَدًا غُرِمَا جَمِيعًا ""","","","","","Book of Blood Money (Diyat)"
"17295","عَنِ الثَّوْرِيِّ ، عَنْ سُلَيْمَانَ الشَّيْبَانِيِّ ، عَنِ الشَّعْبِيِّ , قَالَ : يَضْمَنُ الرَّادِفُ مَعَ صَاحِبِهِ "", عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"17296","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الرَّاكِبُ أَتُرَاهُ كَهَيْئَةِ الْقَائِدِ فِي الْغُرْمِ عَنْ يَدِهَا ؟ قَالَ : نَعَمْ ""","","","","","Book of Blood Money (Diyat)"
"17297","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي حُصَيْنٍ ، عَنْ شُرَيْحٍ , قَالَ : يَضْمَنُ الْقَائِدُ , وَالسَّائِقُ , وَالرَّاكِبُ ، وَلا يَضْمَنُ الدَّابَّةَ إِذَا عَاقَبَتْ "" , قُلْتُ : وَمَا عَاقَبَتْ ؟ قَالَ : "" إِذَا ضَرَبَهَا رَجُلٌ فَأَصَابَتْهُ ""","","","","","Book of Blood Money (Diyat)"
"17298","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ الرَّحْمَنِ ، عَنْ قَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ , قَالَ : نَخَسَ رَجُلٌ دَابَّةً عَلَيْهِا رَجُلٌ , فَنَفَحَتْ إِنْسَانًا فَجَرَحَتْهُ ، فَأَتَوْا سَلْمَانَ بْنَ رَبِيعَةَ ، فَقَالَ : "" يَغْرَمُ الرَّاكِبُ "" , فَأَتَوُا ابْنَ مَسْعُودٍ ، فَقَالَ : "" يَغْرَمُ النَّاخِسُ""","","","","","Book of Blood Money (Diyat)"
"17299","عَنِ ابْنِ مُجَاهِدٍ ، عَنْ أَبِيهِ ، قَالَ : رَكِبَتْ جَارِيَةٌ جَارِيَةً فَنَخَسَتْ بِهَا أُخْرَى ، فَوَقَعَتْ فَمَاتَتْ ، فَضَمَّنَ عَلَى النَّاخِسَةِ وَالْمَنْخُوسَةِ ""","","","","","Book of Blood Money (Diyat)"
"17300","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي قَيْسِ عَنْ هُذَيْلِ بْنِ شُرَحْبِيلٍ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : الْمَعْدِنُ جُبَارٌ ، وَالْبِئْرُ جُبَارٌ ، وَالسَّائِبَةُ جُبَارٌ ، وَفِي الرَّاكْزَةِ الْخُمُسُ ، وَالرَّجْلُ جُبَارٌ ، يَعْنِي : رِجْلَ الدَّابَّةِ ، وَالْجُبَارُ : الْهَدَرُ ""","","","","","Book of Blood Money (Diyat)"
"17301","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ أَبِي فَرْوَةَ , قَالَ : سَمِعْتُ الشَّعْبِيَّ , يَقُولُ : الرَّجْلُ جُبَارٌ ""","","","","","Book of Blood Money (Diyat)"
"17302","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : إِذَا نَفَحَتْ إِنْسَانًا فَلا ضَمَانَ عَلَيْهِ ""، قَالَ سُفْيَانُ : وَتَفْسِيرُهُ عِنْدَنَا إِذَا كَانَ يَسِيرًا ، وَقَالَ غَيْرُ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ : وَضَمِنَ مَا أَصَابَتْ بِيَدِهَا""","","","","","Book of Blood Money (Diyat)"
"17303","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , فِي قَائِدٍ وَرَاكِبٍ أَوْطَآ إِنْسَانًا , قَالَ : يَغْرَمُ الْقَائِدُ وَالرَّاكِبُ ، فَإِنْ كَانَ الرَّاكِبُ أَعْمَى لا يُبْصِرُ ، أَوْ مَرِيضًا لا يَسْتَطِيعُ أَنْ يَصْرِفَ دَابَّتَهُ عَنِ الرَّجُلِ الَّذِي أَرْهَقَهُ بِهِ الْقَائِدُ ، فَنَرَى أَنَّ الْغُرْمَ عَلَى الْقَائِدِ ""","","","","","Book of Blood Money (Diyat)"
"17304","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ،  فِيإِنْسَانٍ كَانَ رَاكِبًا مَعَ رُمْحٍ , فَأَصَابَ الرُّمْحُ إِنْسَانًا , قَالَ : يَضْمَنُ ""","","","","","Book of Blood Money (Diyat)"
"17305","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , فِيرَجُلٍ قَادَ الدَّوَابَّ , فَتَبِعَتْهَا دَوَابُّ فَأَصَابَتْ إِنْسَانًا , قَالَ :  يَضْمَنُ , وَإِنِ انْفَلَتَتْ فَلا ضَمَانَ عَلَيْهِ ""","","","","","Book of Blood Money (Diyat)"
"17306","عَنْ يَحْيَى ، عَنِ الثَّوْرِيِّ ، عَنْ أَشْعَثَ ، عَنِ الْحَكَمِ ، عَنْ إِبْرَاهِيمَ , قَالَ : إِذَا خَرَجَ الرَّجُلُ عَلَى دَابَّةٍ تَتْبَعُهَا فَلَوْ فَأَصَابَ الْفَلُوُّ إِنْسَانًا , قَالَ : "" يَضْمَنُ ""، قَالَ سُفْيَانُ : "" إِذَا انْفَلَتَتِ الدَّابَّةُ فَلا ضَمَانَ عَلَى صَاحِبِهَا ""","","","","","Book of Blood Money (Diyat)"
"17307","عَنْ مَعْمَرٍ ، قَالَ : لا أَعْلَمُ الزُّهْرِيَّ ، إِلا قَالَ : إِذَا كَانَ طَارِدًا أَوْ رَاكِبًا ، فَأَصَابَتِ الدَّابَّةُ بِيَدِهَا ، أَوْ رِجْلِهَا غُرِمَ ، فَإِنْ كَانَ قَائِدًا فَلا غُرْمَ ""","","","","","Book of Blood Money (Diyat)"
"17308","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : رَجُلٌ أَمَرَ عَبْدَهُ أَنْ يَقْتُلَ رَجُلا ؟ قَالَ : عَلَى الآمِرِ , سَمِعْتُ أَبَا هُرَيْرَةَ , يَقُولُ : يُقْتَلُ الْحُرُّ الآمِرُ ، وَلا يُقْتَلُ الْعَبْدُ ، أَرَأَيْتَ لَوْ أَنَّ رَجُلا أَرْسَلَ بِهَدِيَّةٍ مَعَ عَبْدِهِ إِلَى رَجُلٍ , مَنْ أَهْدَاهَا ؟ "" ، قُلْتُ : فَأَمَرَ أَجِيرَهُ , قَالَ : "" أَرَى أَجِيرَهُ مِثْلَ عَبْدِهِ "" ، قُلْتُ : فَأَمَرَ رَجُلا حُرًّا ، أَوْ عَبْدًا لا يَمْلِكُهُ ، وَلَيْسَا بِأَجِيرَيْنِ ؟ قَالَ : "" عَلَى الْمَأْمُورِ إِذَا لَمْ يَمْلِكْهُمَا ، أَوْ يَكُونَا أَجِيرَيْنِ ""، قَالَ عَطَاءٌ بَعْدُ : إِنْ أَمَرَ حُرًّا قُتِلَ الْمَأْمُورُ الْحُرُّ ، وَلَمْ يَبْلُغْهُ فِي عَبْدٍ غَيْرِهِ ، وَلا فِي الأَجِيرِ شَيْءٌ""","","","","","Book of Blood Money (Diyat)"
"17309","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , فِيرَجُلٍ أَمَرَ رَجُلا حُرًّا , فَقَتَلَ رَجُلا , قَالَ :  يُقْتَلُ الْقَاتِلُ ، وَلَيْسَ عَلَى الآمْرِ شَيْءٌ ""","","","","","Book of Blood Money (Diyat)"
"17310","عَنِ ابْنِ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى , قَالَ : لَوْ أَمَرَ رَجُلٌ عَبْدًا لَهُ , فَقَتَلَ رَجُلا , لَمْ يُقْتَلِ الآمِرُ ، وَلَكِنَّهُ يَدِيهِ ، وَيُعَاقَبُ ، وَيُحْبَسُ ، فَإِنْ أَمَرَ رَجُلا حُرًّا ، فَإِنَّ الْحُرَّ إِنْ شَاءَ أَطَاعَهُ ، وَإِنْ شَاءَ لا ، فَلا يُقْتَلُ الآمِرُ ""","","","","","Book of Blood Money (Diyat)"
"17311","عَنْ مَعْمَرٍ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , فِيرَجُلٍ أَمَرَ عَبْدَهُ فَقَتَلَ رَجُلا , قَالَ :  يُقْتَلُ الْعَبْدُ وَيُعَاقَبُ السَّيِّدُ ""","","","","","Book of Blood Money (Diyat)"
"17312","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , فِيرَجُلٍ أَمَرَ عَبْدَهُ فَقَتَلَ رَجُلا , قَالَ :  يُقْتَلُ الْعَبْدُ , وَلَيْسَ عَلَى السَّيِّدِ شَيْءٌ "", قَالَ سُفْيَانُ : وَنَحْنُ نَرَى أَنَّ عَلَى السَّيِّدِ تَعْزِيرَهُ""","","","","","Book of Blood Money (Diyat)"
"17313","قَالَ سُفْيَانُ فِيالَّذِي يَقُولُ لِعَبْدِ الرَّجُلِ : اقْتُلْ مَوْلاكَ , فَقَتَلَ , قَالَ :  لَيْسَ عَلَيْهِ غُرْمٌ ، وَلَمْ يُخْرِجْهُ مِنْ شَيْءٍ ، وَلَكِنَّهُ يُعَزَّرُ الآمِرُ , فَإِذَا قَالَ لِعَبْدِ غَيْرِهِ : اقْتُلْ فُلانًا فَقَتَلَهُ : قُتِلَ الْعَبْدُ ، وَيُغَرَّمُ الآمِرُ لِسَيِّدِ الْعَبْدِ ثَمَنَهُ ""","","","","","Book of Blood Money (Diyat)"
"17314","قَالَ سُفْيَانُ  فِيالَّذِي يَقُولُ لِعَبْدِ رَجُلٍ : اقْتُلْ فُلانًا خَطَأً , فَقَتَلَهُ , قَالَ : لَيْسَ عَلَى الآمِرِ شَيْءٌ ""","","","","","Book of Blood Money (Diyat)"
"17315","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , فِيرَجُلٍ يَأْمُرُ عَبْدَهُ يَقْتُلُ رَجُلا , قَالَ : سَمِعْتُ أَبَا هُرَيْرَةَ , يَقُولُ :  يُقْتَلُ الْحُرُّ الآمِرَ ، وَلا يُقْتَلُ الْعَبْدُ ""، أَرَأَيْتَ أَبُو هُرَيْرَةَ الْقَائِلُ : "" لَوْ أَنَّ رَجُلا أَرْسَلَ بِهَدِيَّةٍ ، مَعَ عَبْدِهِ إِلَى رَجُلٍ مَنْ أَهْدَاهَا ؟ ""","","","","","Book of Blood Money (Diyat)"
"17316","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَمَرَ رَجُلا لا يَمْلِكُهُ قَدْ بَلَغَ أَنْ يُجْرِيَ لَهُ فَرَسًا ، فَمَاتَ حِينَ جَرْيِهِ ذَلِكَ ؟ قَالَ : "" زَعَمُوا أَنَّهُ عَلَى الآمِرِ ""","","","","","Book of Blood Money (Diyat)"
"17317","عَنْ أَبِي حَنِيفَةَ ، وَسُئِلَ  عَنْرَجُلٍ أَخَذَ غُلامًا بِغَيْرِ إِذَنِ أَهْلِهِ ، فَأَجْرَى لَهُ فَرَسًا فَمَاتَ , قَالَ : "" يَضْمَنُ ""","","","","","Book of Blood Money (Diyat)"
"17318","قَالَ الثَّوْرِيُّ : فِيرَجُلٍ أَمَرَ صَبِيًّا أَنْ يَقْتُلَ رَجُلا , قَالَ :  يَكُونُ عَقْلُهُ فِي مَالِ الصَّبِيِّ ، وَيَغْرَمُ لَهُ الَّذِي أَمَرَهُ مِثْلَ عَقْلِهِ ""","","","","","Book of Blood Money (Diyat)"
"17319","عَنْ مَعْمَرٍ ، عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ ، رَفَعَ الْحَدِيثَ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : يُقْتَلُ الْقَاتِلُ ، وَيُصْبَرُ الصَّابِرُ ""","","","","","Book of Blood Money (Diyat)"
"17320","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :رَجُلٌ أَمْسَكَ رَجُلا حَتَّى قَتَلَهُ آخَرُ , قَالَ : قَالَ عَلِيٌّ : يُقْتَلُ الْقَاتِلُ ، وَيُحْبَسُ الْمُمْسِكُ فِي السِّجْنِ حَتَّى يَمُوتَ  ، قُلْتُ : إِنْ بَلَغَا مِنْهُ شَيْئًا دُونَ نَفْسِهِ ؟ قَالَ : "" يُقَادُ مِنَ السَّاطِي ، وَيُعَاقَبُ الْمُمْسِكُ "" ، قُلْتُ : فَإِنْ قَتَلَهُ قَتْلا , قَالَ : "" فَلا يُقْتَلُ الْمُمْسِكُ أَيْضًا "" , قَالَ : لَمْ يُمْسِكْهُ ، وَلَمْ يَدُلَّ ، وَلَكِنَّهُ مَشَى مَعَ الْقَاتِلِ ، وَتَكَلَّمَ ، وَمَنْعَهُ مِنْ ضَرْبٍ أُرِيدَ بِهِ , قَالَ : "" لا يُقْتَلُ يَعْنِي السَّاطِيَّ الَّذِي يَسْطُو بِيَدِهِ فَيَضْرِبُ حَتَّى يَقْتُلَ ""","","","","","Book of Blood Money (Diyat)"
"17321","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : قَضَى عَلِيٌّ  أَنْيُقْتَلَ الْقَاتِلُ ، وَيُحْبَسَ الْحَابِسُ لِلْمَوْتِ ""","","","","","Book of Blood Money (Diyat)"
"17322","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي إِسْمَاعِيلُ بْنُ أُمَيَّةَ ، خَبَرًا أَثْبَتَهُ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :يُحْبَسُ الصَّابِرُ لِلْمَوْتِ كَمَا حَبَسَ , وَيُقْتَلُ الْقَاتِلُ","","","","","Book of Blood Money (Diyat)"
"17323","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ عَطَاءٌ : إِذَا اسْتَعَانَ رَجُلا حُرًّا قَدْ عَقِلَ فِي عَوْنٍ فَمَاتَ , لَمْ يَغْرَمْهُ ""، وَعَمْرٌو , قُلْتُ لِعَطَاءٍ : مَا وَقْتُ ذَلِكَ ؟ قَالَ : "" أَنْ يَعْقِلَ ""","","","","","Book of Blood Money (Diyat)"
"17324","عَنْ مَعْمَرٍ ، عَنْ حَمَّادٍ , قَالَ : مَنِ اسْتَعَانَ عَبْدًا أَوْ صَبِيًّا بِغَيْرِ إِذْنِ أَهْلِهِ فَقَدْ ضَمِنَهُ "", عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"17325","عَنْ مَعْمَرٍ ، عَنْ حَمَّادٍ , فِيرَجُلٍ أَمَرَ صَبِيَّيْنِ أَنْ يَصْطَرِعَا , فَجَرَحَ أَحَدُهُمَا صَاحِبَهُ , قَالَ :  تَكُونُ دِيَةُ الْمَجْرُوحِ عَلَى الْجَارِحِ ، وَيَغْرَمُ لَهُ الرَّجُلُ الَّذِي أَمَرَهُ بِمِثْلِ ذَلِكَ ""","","","","","Book of Blood Money (Diyat)"
"17326","عَنِ الثَّوْرِيِّ ، عَنْ أَشْعَثَ ، عَنِ الْحَكَمِ ، عَنْ إِبْرَاهِيمَ , قَالَ : مَنِ اسْتَعَانَ مَمْلُوكًا بِغَيْرِ إِذْنِ مَوَالِيهِ ضَمِنَ ""","","","","","Book of Blood Money (Diyat)"
"17327","قَالَ أَبُو حَنِيفَةَ , عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ مِنِ اسْتَعَانَ مَمْلُوكًا بِغَيْرِ إِذْنِ أَهْلِهِ ضَمِنَ , قَالَ : وَالصَّبِيُّ بِتِلْكَ الْمَنْزِلَةِ ""","","","","","Book of Blood Money (Diyat)"
"17328","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَسُئِلَ عَنْرَجُلٍ اسْتَعَانَ قَوْمًا عَلَى هَدْمِ حَائِطٍ , فَتَلَفَ بَعْضُهُمْ فِيهِ , قَالَ :  لَيْسَ عَلَى الَّذِي اسْتَعَانَهُمْ شَيْءٌ ، وَهُوَ عَلَى أَصْحَابِهِ الَّذِينَ نَجَوْا مِنَ الحَائِطِ لَمْ يُعِينُوا ""","","","","","Book of Blood Money (Diyat)"
"17329","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :اسْتَأْجَرْتُ غُلامًا فِي عَمِلٍ قَدْ عَلِمَ أَهْلُهُ أَنَّهُ يَعْمَلُهُ , فَقَتَلَهُ ذَلِكَ الْعَمَلُ , قَالَ :  يَغْرَمُ "" , قُلْتُ لَهُ : فَخَلَّوْهُ يَكْسِبُ وَيَعْمَلُ , فَاسْتَأْجَرْتُهُ فَقَتَلَهُ عَمَلُهُ ذَلِكَ ؟ قَالَ : "" لا يَغْرَمُ "" , قُلْتُ : خَادِمُ قَوْمٍ لَمْ يَأْذَنُوا لَهُ بِعَمَلٍ ، فَاسْتَأْجَرْتُهُ فِي عَمِلٍ بِغَيْرِ أَمْرِهِمْ ؟ قَالَ : "" يَغْرَمُ ""","","","","","Book of Blood Money (Diyat)"
"17330","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ , فيرجل استأجر عمالا في حفر ركية ، أو هدم حائط , فوقع الحائط عليهم , فمات بعضهم ، قَالا :  لَيْسَ عَلَى الَّذِي اسْتَأْجَرَهُمْ ضَمَانٌ ، وَلَكِنْ يَعْقِلُ الْحَيُّ مِنْهُمُ الْمَيِّتَ ""","","","","","Book of Blood Money (Diyat)"
"17331","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي بَعْضُ مَنْ أُخِذَ عَنْهُ : لَوْ أَنَّ رَجُلَيْنِ حَفَرَا بِأَصْلِ جِدَارٍ فَخَرَّ عَلَيْهِمَا , فَمَاتَ أَحَدُهُمَا ، كَانَتِ الدِّيَةُ شَطْرَيْنِ بَيْنَهُمَا ""","","","","","Book of Blood Money (Diyat)"
"17332","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , فِيرَجُلٍ اسْتَأْجَرَ عُمَّالا يَعْمَلُونَ لَهُ , فَرَفَعُوا حَجَرًا ، فَعَجَزُوا عَنْهُ ، فَسَقَطَ الْحَجَرُ عَلَى بَعْضِهِمْ , قَالَ :  لَيْسَ عَلَى الَّذِي اسْتَأْجَرَهَمُ غُرْمٌ ، إِنَّمَا الْغُرْمُ عَلَى مَنْ أَعْنَتَ ، فَإِنْ كَانَ بَعْضُهُمْ أَعْنَتَ بَعْضًا فَعَلَيْهِ مَا أَصَابَ ""","","","","","Book of Blood Money (Diyat)"
"17333","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , فِيرَجُلٍ اسْتَأْجَرَ قَوْمًا يَهْدِمُونَ لَهُ جِدَارًا فَسَقَطَ نَاحِيَةٌ مِنَ الْجِدَارِ ، فَقَتَلَ بَعْضًا ، وَجَرَحَ بَعْضًا , قَالَ :  يُعْطُونَ دِيَةَ قَتْلاهُمَ ، وَيَغْرَمُونَ جِرَاحَ مَنْ جُرِحَ مِنْهُمْ ""","","","","","Book of Blood Money (Diyat)"
"17334","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :رَجُلٌ نَادَى صَبِيًّا عَلَى جِدَارٍ أَنِ اسْتَأْخِرْ فَخَرَّ , فَمَاتَ ؟ قَالَ : يُرْوَى عَنْ عَلِيٍّ , أَنَّهُ قَالَ :  يَغْرَمُهُ "" , قَالَ : يُفْزِعُهُ ، قُلْتُ : فَنَادَى كَبِيرًا ؟ قَالَ : "" مَا أُرَاهُ إِلا مِثْلَهُ ، رَادَدْتُهُ , فَكَانَ يَرَى أَنْ يَغْرَمَ ""","","","","","Book of Blood Money (Diyat)"
"17335","عَنِ الثَّوْرِيِّ ، عَنْ إِسْمَاعِيلَ ، عَنِ الشَّعْبِيِّ ، سُئِلَ عَنْعَبْدٍ قَتَلَ رَجُلا , فَأَعْتَقَ الْعَبْدَ سَيِّدُهُ , قَالَ :  عَلَى السَّيِّدِ الدِّيَةُ "", قَالَ : وَقَالَ الْحَكَمُ وَغَيْرُهُ : الثَّمَنُ ثَمَنُ الْعَبْدِ , قَالَ : وَيَقُولُونَ : إِنْ عَلِمَ فَالدِّيَةُ ، وَإِنْ لَمْ يَعْلَمْ فَالْقِيمَةُ""","","","","","Book of Blood Money (Diyat)"
"17336","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عمَرّدُ ، أَنَّ حُيَيَّ بْنَ يَعْلَى أَخْبَرَهُ , أَنَّهُ سَمِعَ يَعْلَى يُخْبِرُ ، أَنَّرَجُلا أَتَى يَعْلَى ، فَقَالَ : قَاتِلَ أَخِي ، فَدَفَعَهُ إِلَيْهِ فَجَدَعَهُ بِالسَّيْفِ ، حَتَّى رَأَى أَنَّهُ قَدْ قَتَلَهُ وَبِهِ رَمَقٌ , فَأَخَذَهُ أَهْلُهُ فَدَاوَوْهُ حَتَّى بَرَأَ , فَجَاءَ يَعْلَى ، فَقَالَ : قَاتِلَ أَخِي ، فَقَالَ : أَوْ لَيْسَ قَدْ دَفَعْتُهُ إِلَيْكَ ؟ فَأَخْبَرَهُ خَبَرَهُ , فَدَعَاهُ يَعْلَى ، فَإِذَا بِهِ قَدْ سَلَكَ , فَحُشِيَتْ جُرُوحُهُ , فَوَجَدَ فِيهِ الدِّيَةَ ، فَقَالَ لَهُ يَعْلَى :  إِنْ شِئْتَ فَادْفَعْ إِلَيْهِ دِيَتَهُ ، واقْتُلْهُ ، وَإِلا فَدَعْهُ "" ، فَلَحِقَ بِعُمَرَ فَاسْتَأْدَى عَلَى يَعْلَى فَكَتَبَ عُمَرُ إِلَى يَعَلَى : أَنْ أَقْدِمَ عَلِيَّ , فَقَدْمَ عَلَيْهِ , فَأَخْبَرَهُ الْخَبَرَ , فَاسْتَشَارَ عُمَرُ عَلِيَّ بْنَ أَبِي طَالِبٍ , فَأَشَارَ عَلَيْهِ بِمَا قَضَى بِهِ يَعْلَى ، فَاتَّفَقَ عُمَرُ وَعَلِيٌّ عَلَى قَضَاءِ يَعْلَى , أَنْ يَدْفَعَ إِلَيْهِ الدِّيَةَ ، وَيَقْتُلَهُ ، أَوْ يَدَعَهُ فَلا يَقْتُلَهُ ، وَقَالَ عُمَرُ لِيَعْلَى : إِنَّكَ لَقَاضٍ ، ثُمَّ رَدَّهُ عَلَى عَمَلِهِ. عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عُثْمَانُ بْنُ أَبِي سُلَيْمَانَ ، عَنْ نَافِعِ بْنِ جُبَيْرٍ ، عَنْ عِكْرِمَةَ بْنِ يَعْلَى : "" أَنَّ هَذَا الْقَاتِلَ أَدِينَهُ أَهْلُهُ فَبَرَأَ ، فَجَاءُوا بِهِ يَعْلَى ، فَذَكَرَ ، فَأَبَى عُمَرُ أَنْ يَقْتُلَ لَهُمُ الثَّانِيَةَ ""","","","","","Book of Blood Money (Diyat)"
"17337","قَالَ سُفْيَانُ : فِيالَّذِي لا يُدَفَّفُ عَلَيْهِ فَيَبْرَأُ , قَالَ :  يُقْتَلُ وَلا يَغْرَمُ جِرَاحَةً ""","","","","","Book of Blood Money (Diyat)"
"17338","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :الرَّجُلُ يَجِدُ عَلَى امْرَأَتِهِ رَجُلا فَيَقْتُلُهُ أَيُهْدَرُ ؟ قَالَ :  مَا مِنْ أَمَرٍ إِلا بِالْبَيِّنَةِ ""","","","","","Book of Blood Money (Diyat)"
"17339","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ  أَنَّهُ كَانَيُنْكِرُ أَنْ يَكُونَ عُمَرُ أَهْدَرَ دَمَهُ إِلا بِالْبَيِّنَةِ ""","","","","","Book of Blood Money (Diyat)"
"17340","عَنِ ابْنِ جُرَيْجٍ ، وَالثَّوْرِيِّ ، قَالا : أَخْبَرَنَا يَحْيَى بْنُ سَعِيدٍ , قَالَ : سَمِعْتُ ابْنَ الْمُسَيِّبِ , يَقُولُ : إِنَّ رَجُلا مِنْ أَهْلِ الشَّامِ يُدْعَى جُبَيْرًا ،وَجَدَ مَعَ امْرَأَتِهِ رَجُلا فَقَتَلَهُ ، أَوْ قَتَلَهُمَا ، قَالَ الثَّوْرِيُّ : فَقَتَلَهُ ، وَإِنَّ مُعَاوِيَةَ رَضِي اللَّهُ عَنْهُ ، أَشْكَلَ عَلَيْهِ الْقَضَاءُ فِيهِ ، فَكَتَبَ إِلَى أَبِي مُوسَى الأَشْعَرِيِّ أَنْ يَسْأَلَ لَهُ عَلِيًّا عَنْ ذَلِكَ ، فَسَأَلَ عَلِيًّا , فَقَالَ : مَا هَذَا بِبِلادِنَا , لَتُخْبِرَنِّي ، فَقَالَ : إِنَّهُ كَتَبَ إِلَيّ أَنْ أَسْأَلَكَ عَنْهُ , فَقَالَ : أَنَا أَبُو حَسَنٍ الْقَرْمُ  يُدْفَعُ بِرُمَّتِهِ إِلا أَنْ يَأْتِيَ بِأَرْبَعَةِ شُهَدَاءَ "", عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنِ ابْنِ الْمُسَيِّبِ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"17341","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، قَالَ : سَأَلَ رَجُلٌ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ الرَّجُلُ :يَجِدُ مَعَ امْرَأَتِهِ رَجُلا فَيَقْتُلُهُ ؟ فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  إِلا بِالْبَيِّنَةِ "" ، فَقَالَ سَعْدُ بْنُ عُبَادَةَ ، وَأَيُّ بَيِّنَةٍ أَبْيَنُ مِنَ السَّيْفِ ؟ فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" أَلا تَسْمَعُونَ إِلَى مَا يَقُولُ سَيِّدُكُمْ "" , قَالُوا : لا تَلُمْهُ يَا رَسُولَ اللَّهِ , فَإِنَّهُ رَجُلٌ غَيُورٌ ، وَاللَّهِ مَا تَزَوَّجَ امْرَأَةً قَطُّ إِلا بِكْرًا ، وَلا طَلَّقَ امْرَأَةً قَطُّ ، فَاسْتَطَاعَ أَحَدٌ مِنَّا أَنْ يَتَزَوَّجَهَا ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" يَأْبَى اللَّهُ إِلا بِالْبَيِّنَةِ ""","","","","","Book of Blood Money (Diyat)"
"17342","عَنْ مَعْمَرٍ ، عَنْ كَثِيرِ بْنِ زِيَادٍ ، عَنِ الْحَسَنِ ، فِيالرَّجُلِ يَجِدُ مَعَ امْرَأَتِهِ رَجُلا , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  كَفَى بِالسَّيْفِ شَا "" , يُرِيدُ أَنْ يَقُولَ : شَاهِدًا , فَلَمْ يُتِمَّ الْكَلامَ حَتَّى قَالَ : "" إِذًا يَتَبَايَعُ فِيهِ السَّكْرَانُ وَالْغَيْرَانُ ""","","","","","Book of Blood Money (Diyat)"
"17343","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ , قَالَ : أَحْسِبُهُ عَنْ عُبَيْدِ بْنِ عُمَيْرٍ , قَالَ :اسْتَضَافَ رَجُلٌ نَاسًا مِنْ هُذَيْلٍ ، فَأَرْسَلُوا جَارِيَةً لَهُمْ تَحْتَطِبُ ، فَأَعْجَبَتِ الضَّيْفَ فَتَبِعَهَا ، فَأَرَادَهَا عَلَى نَفْسِهَا ، فَامْتَنَعَتْ , فَعَارَكَهَا سَاعَةً , فَانْفَلَتَتْ مِنْهُ انْفِلاتَةً ، فَرَمَتْهُ بِحَجَرٍ ، فَفَضَّتْ كَبِدَهُ فَمَاتَ ، ثُمَّ جَاءَتْ إِلَى أَهْلِهَا ، فَأَخْبَرَتْهُمْ , فَذَهَبَ أَهْلُهَا إِلَى عُمَرَ ، فَأَخْبَرُوهُ ، فَأَرْسَلَ عُمَرُ فَوَجَدَ آثَارَهُمَا ، فَقَالَ عُمَرُ :  قَتِيلُ اللَّهِ لا يُودَى أَبَدًا ""، قَالَ الزُّهْرِيُّ : ثُمَّ قَضَتِ الْقُضَاةُ بَعْدُ بِأَنْ يُودَى""","","","","","Book of Blood Money (Diyat)"
"17344","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ أَبَا عَبْدِ اللَّهِ بْنَ عُبَيْدٍ ، يُحَدِّثُ نَحْوًا مِنْ هَذَا , وَأَقُولُ أَنَا وَصَاحِبُ الْعِرَاقِ :  وَأَشْعَثُ غَرَّهُ الإِسْلامُ مِنِّي لَهَوْتُ بِعِرْسِهِ لَيْلَ التِّمَامِ أَبِيتُ عَلَى تَرَائِبِهَا وَيَطْوِي عَلَى حَمْرَا قَابِلَهِ الْحِزَامِ كَأنَ مُجَامِعَ الرَّبَلاتِ مِنْهَا فِئَامٌ يَنْهَضُونَ إِلَى فِئَام ""","","","","","Book of Blood Money (Diyat)"
"17345","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ بْنِ النُّعْمَانِ ، عَنْ هَانِئِ بْنِ حِزَامٍ :  أَنَّرَجُلا وَجَدَ مَعَ امْرَأَتِهِ رَجُلا ، فَقَتَلَهُمَا ، فَكَتَبَ عُمَرُ بِكِتَابٍ فِي الْعَلانِيَةِ "" أَنْ أَقِيدُوهُ "" ، وَكِتَابًا فِي السِّرِّ : "" أَنْ أَعْطُوهُ الدِّيَةَ ""","","","","","Book of Blood Money (Diyat)"
"17346","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ , قَالَ : وَأَخْبَرَنِي رَجُلٌ ، عَنْ مَكْحُولٍ بِبَعْضِهِ , قَالَ :وَجَدَ رَجُلٌ مِنْ خُزَاعَةَ رَجُلا مِنْ أَسْلَمَ فِي بَيْتِهِ بَعْدَ الْعَتَمَةِ مَطْوِيًّا فِي حَصِيرٍ ، فَطَرَقَ بِهِ عُمَرُ بْنُ الْخَطَّابِ  فَجَلَدَهُ مِائَةً ، وَغَرَّبَهُ سَنَةً ""","","","","","Book of Blood Money (Diyat)"
"17347","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ , قَالَ : سَمِعْتُ مَكْحُولا يُحَدِّثُ :  أَنَّرَجُلا وَجَدَ فِي بَيْتِهِ رَجُلا بَعْدَ الْعَتَمَةِ , مُلَفَّفًا فِي حَصِيرٍ "" فَضَرَبَهُ عُمَرُ مِائَةً ""","","","","","Book of Blood Money (Diyat)"
"17348","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ : أَنَّ رَجُلا يُقَالِ لَهُ جُنْدُبٌ :أَخَذَ شَابًّا مِنْ شَبَابِ قَوْمِهِ , يُقَالُ لَهُ : سَبْرَةُ فِي بَيْتِهِ ، فَضَرَبَهُ ضَرْبَةً شَدِيدَةً ، وَأَوْثَقَهُ ، وَرَضَّ أُنْثَيَيْهِ بِفِهْرٍ ، فَذَهَبَ قَوْمُهُ إِلَى سُفْيَانَ بْنِ عَبْدِ اللَّهِ ، وَهُوَ عَامَلٌ عَلَيْهِمْ لِعُمَرَ ، فَأَبْطَلَ كُلَّ شَيْءٍ أُصِيبَ بِهِ سَبْرَةُ ، فَانْطَلَقَ قَوْمُهُ ، فَأَتَوْا عُمَرَ بِضَجْنَانَ ، فَقَالَ سَبْرَةُ : يَا أَمِيرَ الْمُؤْمِنِينَ , إِنَّ جُنْدُبًا أَخَذَنِي عِنْدَ ابْنَةِ عَمَّتِي أَسْأَلُهَا الْعِشَاءَ , فَفَعَلَ بِي كَذَا وَكَذَا , فَأَبْطَلَ ذَلِكَ سُفْيَانُ ، فَقَالَ عُمَرُ لِسُفْيَانَ : سَلْ عَنْ هَذَا , فَإِنْ كَانَ بَعْدَ الْعَتَمَةِ فَاجْلِدْهُ مِائَةَ جَلْدَةٍ ""","","","","","Book of Blood Money (Diyat)"
"17349","عَنْ إِبْرَاهِيمَ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ أَبِي جَعْفَرٍ ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ ، عَنْ جُنْدُبٍ : أَنَّهُأَخَذَ فِي بَيْتِهِ رَجُلا فَرَضَّ أُنْثَيَيْهِ , فَأَهْدَرَهُ عُمَرُ, قَالَ : وَأَخْبَرَنِي صَالِحُ بْنُ كَيْسَانَ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ :  أَنَّ رَجُلا وَجَدَ فِي بَيْتِهِ رَجُلا فَدَقَّ كُلَّ فَقَارِ ظَهْرِهِ ، فَأَهْدَرَهُ عُمَرُ بْنُ الْخَطَّابِ ""","","","","","Book of Blood Money (Diyat)"
"17350","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلَ حَيَّانُ الْعَبْدِيُّ عَطَاءً ، عَنْرَجُلٍ شَجَّ عَبْدًا لَهُ وَكَسَرَهُ , قَالَ :  لِيَكْسِهِ ثَوْبًا ، أَوْ لِيُطْعِمْهُ شَيْئًا "" ، فَقَالَ حَيَّانُ : هَكَذَا أَخْبَرَنِي جَابِرُ بْنُ يَزِيدَ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ حَيَّانُ : فَفَقَأَ عَيْنَهُ ؟ قَالَ : "" أَحَبُّ إِلَيَّ أَنْ يُعْتِقَهُ ""","","","","","Book of Blood Money (Diyat)"
"17351","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : مَنْ مَثَّلَ بِعَبْدٍ لَهُ عَتَقَ ""","","","","","Book of Blood Money (Diyat)"
"17352","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ , قَالَ :أَشْعَلَ رَجُلٌ فِي جَوْفِ عَبْدِهِ نَارًا ، فَقَامَ الْعَبْدُ فَزِعًا ، حَتَّى أَتَى بِئْرًا ، فَأَلْقَى نَفْسَهُ فِيهِا  ، فَلَمَّا أَصْبَحَ أَتَى عُمَرَ : "" فَأَعْتَقَهُ ، فَأُتِي عُمَرُ بِسَبْيٍ بَعْدَ ذَلِكَ , فَأَعْطَاهُ عَبْدًا ""، قَالَ الْحَسَنُ : كَانُوا يُعَاقَبُونَ ، وَيُعْقَبُونَ يَعْنِي : لَمَّا أَعْتَقَهُ أَعْقَبَهُ عُمَرُ مَكَانَهُ""","","","","","Book of Blood Money (Diyat)"
"17353","عَنِ الثَّوْرِيِّ ، عَنْ يُونُسَ ، عَنِ الْحَسَنِ ،  أَنَّرَجُلا كَوَى غُلامًا لَهُ بِالنَّارِ ، فَأَعْتَقَهُ عُمَرُ ""","","","","","Book of Blood Money (Diyat)"
"17354","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ , قَالَ : وَقَعَ سُفْيَانُ بْنُ الأَسْوَدِ بْنِ عَبْدِ الأَسْوَدِ عَلَى أَمَةٍ لَهُ , فَأَقْعَدَهَا عَلَى مِقْلًى ، فَاحْتَرَقَ عَجُزُهَا ، فَأَعْتَقَهَا عُمَرُ بْنُ الْخَطَّابِ وَأَوْجَعَهُ ضَرْبًا ""","","","","","Book of Blood Money (Diyat)"
"17355","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ ، عَنْ رَجُلٍ مِنْهُمْ ، عَنْ عُمَرَ  أَنَّرَجُلا أَقْعَدَ جَارِيَةً لَهُ عَلَى النَّارِ فَأَعْتَقَهَا عُمَرُ ""","","","","","Book of Blood Money (Diyat)"
"17356","عَنْ مَعْمَرٍ ، وَابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ ، عَنْ أَبِيهِ ، عَنْ جَدِّهِ عَبْدِ اللَّهِ بْنِ عَمْرٍو ، أَنَّ زِنْبَاعًا أَبَا رَوْحِ بْنَ زِنْبَاعٍوَجَدَ غُلامًا لَهُ مَعَ جَارِيَةٍ ، فَقَطَعَ ذَكَرَهُ وَجَدَّعَ أَنْفَهُ ، فَأَتَى الْعَبْدُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ ذَلِكَ لَهُ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَهُ :  مَا حَمَلَكَ عَلَى هَذَا ؟ "" , قَالَ : فَعَلَ كَذَا وَكَذَا , قَالَ : "" اذْهَبْ فَأَنْتَ حُرٌّ "", قَالَ عَبْدُ الرَّزَّاقِ : وَسَمِعْتُ أَنَا مُحَمَّدَ بْنَ عُبَيْدِ اللَّهِ الْعَرْزَمِيَّ يُحَدِّثُ بِهِ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ""","","","","","Book of Blood Money (Diyat)"
"17357","عَنْ مَعْمَرٍ , قَالَ : أَخْبَرَنِي مَنْ سَمِعَ عِكْرِمَةَ , يَقُولُ : مَرَّ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِأَبِي مَسْعُودٍ الأَنْصَارِيِّ ، وَهُوَيَضْرِبُ خَادِمَهُ , فَنَادَاهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : اعْلَمْ أَبَا مَسْعُودٍ ! فَلَمَّا سَمِعَهُ أَلْقَى السَّوْطَ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  وَاللَّهِ لَلَّهُ أَقْدَرُ عَلَيْكَ مِنْكَ عَلَى هَذَا "" , قَالَ : "" وَنَهَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يُمَثِّلَ الرَّجُلُ بِعَبْدِهِ فَيُعْوِرَ ، أَوْ يَجْدَعَ "" ، وَقَالَ : "" أَشْبِعُوهُمْ وَلا تُجَوِّعُوهُمْ ، وَاكْسُوهُمْ وَلا تُعَرُّوهُمْ ، وَلا تُكْثِرُوا ضَرْبَهُمْ , فَإِنَّكُمْ مَسْئُولُونَ عَنْهُمْ ، وَلا تَفْدَحُوهُمْ بِالْعَمَلِ ، فَمَنْ كَرِهَ عَبْدَهُ فَلْيَبِعْهُ ، وَلا يَجْعَلْ رِزْقَ اللَّهِ عَلَيْهِ عَنَاءً ""","","","","","Book of Blood Money (Diyat)"
"17358","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ , قَالَ : أَخْبَرَنَا دَاوُدُ بْنُ أَبِي عَاصِمٍ , قَالَ : بَلَغَنِي أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : صَهٍ ! أَطَّتِ السَّمَاءُ "" , قَالَ : وَأُخْبِرْتُ أَنَّهُ قَالَ : "" وَحُقَّ لَهَا أَنْ تَئِطَّ , مَا فِي السَّمَاءِ مَوْضِعُ كَفٍّ "" ، أَوْ قَالَ : "" شِبْرٍ , إِلا عَلَيْهِ مَلَكٌ سَاجِدٌ , فَاتَّقُوا اللَّهُ ، وَأَحْسِنُوا إِلَى مَا مَلَكَتْ أَيْمَانُكُمْ , أَطْعِمُوهُمْ ، مِمَّا تَأْكُلُونَ ، وَاكْسُوهُمْ مِمَّا تَلْبَسُونَ ، وَلا تُكَلِّفُوهُمْ مَا لا يُطِيقُونَ ، فَإِنْ جَاءُوا بِشَيْءٍ مِنْ أَخْلاقِهِمْ يُخَالِفُ شَيْئًا مِنْ أَخْلاقِكُمْ ، فَوَلُّوا شَرَّهُمْ غَيْرَكُمْ ، وَلا تُعَذِّبُوا عِبَادَ اللَّهُ ""","","","","","Book of Blood Money (Diyat)"
"17359","عَنِ الثَّوْرِيِّ ، عَنْ عَاصِمِ بْنِ عُبَيْدِ اللَّهِ بْنِ عَاصِمٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، عَنْ أَبِيهِ , قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي حَجَّةِ الْوَدَاعِ : أَرِقَّاءَكُمْ ، أَرِقَّاءَكُمْ ، أَطْعِمُوهُمْ مِمَّا تَأْكُلُونَ ، وَاكْسُوهُمْ مِمَّا تَلْبَسُونَ ، وَإِنْ جَاءُوا بِذَنْبٍ لا تُرِيدُونَ ، أَنْ تَغْفِرُوهُ ، فَبِيعُوا عِبَادَ اللَّهُ ، وَلا تُعَذِّبُوهُمْ ""","","","","","Book of Blood Money (Diyat)"
"17360","عَنِ الثَّوْرِيِّ ، عَنْ فِرَاسٍ ، عَنْ أَبِي صَالِحٍ ، عَنْ زَاذَانَ , قَالَ : كُنْتُ جَالِسًا عِنْدَ ابْنِ عُمَرَ ، فَدَعَا بِعَبْدٍ لَهُ فَأَعْتَقَهُ ، فَقَالَ : مَا لِي مِنْ أَجْرِهِ مَا يَزِنُ هَذَا ، أَوْ يُسَاوِي هَذَا ، وَأَخَذَ شَيْئًا بِيَدِهِ ، أَنِّي سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : مَنْ ضَرَبَ عَبْدًا لَهُ حَدًّا لَمْ يَأْتِهِ ، أَوْ لَطَمَهُ , فَكَفَّارَتُهُ أَنْ يَعْتِقَهُ ""","","","","","Book of Blood Money (Diyat)"
"17361","عَنِ الثَّوْرِيِّ ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ ، عَنْ مُعَاوِيَةَ بْنِ سُوَيْدِ بْنِ مُقَرِّنٍ ، عَنْ سُوَيْدِ بْنِ مُقَرِّنٍ , قَالَ :كُنَّا بَنِي مُقَرِّنٍ سَبْعَةً عَلَى عَهْدِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَلَنَا خَادِمٌ , لَيْسَ لَنَا غَيْرُهَا , فَلَطَمَهَا أَحَدُنَا ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  أَعْتِقُوهَا "" , فَقُلْنَا : لَيْسَ لَنَا خَادِمٌ غَيْرُهَا يَا رَسُولَ اللَّهِ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" تَخْدِمُكُمْ حَتَّى تَسْتَغْنُوا عَنْهَا ، ثُمَّ خَلُّوا سَبِيلَهَا ""","","","","","Book of Blood Money (Diyat)"
"17362","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , أَنَّ عُمَرَ بْنَ الْخَطَّابِ  كَانَيَضْرِبُ النِّسَاءَ وَالْخَدَمَ "", عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ شِهَابٍ ، عَنْ عُمَرَ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"17363","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ , قَالَ : سُئِلَ نَافِعٌهَلْ كَانَ ابْنُ عُمَرَ يَضْرِبُ رَقِيقَهُ ؟ قَالَ :  نَعَمْ ، وَيُعْتِقُ فِي السَّاعَةِ الْوَاحِدَةِ كَذَا وَكَذَا ""","","","","","Book of Blood Money (Diyat)"
"17364","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، أَنَّ الزُّبَيْرَ  كَانَيَضْرِبُ نِسَاءَهُ حَتَّى يَكْسِرَ عَلَى إِحْدَاهُنَّ أَعْوَادَ الْمِشْجَبِ ""","","","","","Book of Blood Money (Diyat)"
"17365","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ , قَالَتْ : مَا ضَرَبَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خَادِمًا لَهُ ، وَلا امْرَأَةً ، وَلا ضَرَبَ بِيَدِهِ شَيْئًا قَطُّ ، إِلا أَنْ يُجَاهِدَ فِي سَبِيلِ اللَّهُ ، وَلا خُيِّرَ بَيْنَ أَمْرَيْنِ قَطُّ ، إِلا كَانَ أُحِبُّهُمَا إِلَيْهِ أَيْسَرَهُمَا ، حَتَّى يَكُونَ إِثْمًا ، فَإِذَا كَانَ إِثْمًا ، كَانَ أَبْعَدَ النَّاسِ مِنَ الإِثْمِ ، وَلا انْتَقَمَ لِنَفْسِهَ مِنْ شَيْءٍ يُؤْتَى إِلَيْهِ , حَتَّى يُنْتَهَكَ حُرْمَةُ اللَّهُ فَيَكُونَ هُوَ يَنْتَقِمُ لِلَّهُ ""","","","","","Book of Blood Money (Diyat)"
"17366","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَمَا يَسْتَحْيِي أَحَدُكُمْ أَنْ يَضْرِبَ امْرَأَتَهُ كَمَا يَضْرِبُ الْعَبْدَ , يَضْرِبُهَا أَوَّلَ النَّهَارِ ، ثُمَّ يُضَاجِعُهَا آخِرَهُ , أَمَا يَسْتَحْيِي "", عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي هِشَامُ بْنُ عُرْوَةَ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَحْوَهُ""","","","","","Book of Blood Money (Diyat)"
"17367","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ إِيَاسِ بْنِ عَبْدِ اللَّهِ بْنِ أَبِي ذُبَابٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا تَضْرِبُوا إِمَاءَ اللَّهُ "" , قَالَ : فَذَئِرَ النِّسَاءُ ، وَسَاءَتْ أَخْلاقُهُنَّ عَلَى أَزْوَاجِهِنَّ ، فَقَالَ عُمَرُ : يَا رَسُولَ اللَّهِ ، ذَئِرَ النِّسَاءُ ، وَسَاءَتْ أَخْلاقُهُنَّ عَلَى أَزْوَاجِهِنَّ مُنْذُ نَهَيْتَ عَنْ ضَرْبِهِنَّ , قَالَ : فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" فَاضْرِبُوهُنَّ , فَضَرَبَ النَّاسُ نِسَاءَهُمْ تِلْكَ اللَّيْلَةَ "" , فَأَتَى نِسَاءٌ كَثِيرٌ يَشْتَكِينَ الضَّرْبَ , فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حِينَ أَصْبَحَ : "" لَقَدْ طَافَ بِآلِ مُحَمَّدٍ اللَّيْلَةَ سَبْعُونَ امْرَأَةً ، كُلُهُنَّ يَشْتَكِينَ الضَّرْبَ ، وَايْمُ اللَّهُ لا تَجِدُونَ أُولَئِكَ خِيَارَكُمْ ""","","","","","Book of Blood Money (Diyat)"
"17368","عَنْ مَعْمَرٍ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ , قَالَ :  خَدَمْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَشْرَ سِنِينَ ، لا وَاللَّهُمَا سَبَّنِي سَبَّةً قَطُّ ، وَلا قَالَ لِي : أُفٍّ قَطُّ ، وَلا قَالَ لِي : لِشَيْءٍ فَعَلْتُهُ : لِمَ فَعَلْتَهُ ؟ وَلا لِشَيْءٍ لَمْ أَفْعَلْهُ : أَلا فَعَلْتَهُ ! ""","","","","","Book of Blood Money (Diyat)"
"17369","عَنْ جَعْفَرِ بْنِ سُلَيْمَانَ , قَالَ : حَدَّثَنِي ثَابِتٌ ، عَنْ أَنَسٍ , قَالَ : سَمِعْتُهُ يَقُولُ :  خَدَمْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَشْرَ سِنِينَ ، فَلا وَاللَّهُمَا قَالَ لِي لِشَيْءٍ صَنَعْتُهُ : لِمَ صَنَعْتَهُ ؟ وَلا لِشَيْءٍ لَمْ أَصْنَعْهُ : أَلا صَنَعْتَهُ ! وَلا لامَنِي , فَإِنْ لامَنِي بَعْضُ أَهْلِهِ قَالَ : "" دَعْهُ , مَا قُدِّرَ فَهُوَ كَائِنٌ ، أَوْ مَا قُضِي فَهُوَ كَائِنٌ ""","","","","","Book of Blood Money (Diyat)"
"17370","عَنْ مَعْمَرٍ , قَالَ : سُئِلَ الزُّهْرِيُّ عَنْضَرْبِ الْخَدَمِ , فَقَالَ :  كَانُوا يَضْرِبُونَهُمْ وَلا يَلْعَنُونَهُمْ ""","","","","","Book of Blood Money (Diyat)"
"17371","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ , قَالَ : مَرَّ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِحِمَارٍ قَدْ وُسِمَ فِي وَجْهِهِ ، تُدَخِّنُ مَنْخِرَاهُ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  لَعَنَ اللَّهُ مَنْ فَعَلَ هَذَا ,لا يَسِمَنَّ أَحَدٌ الْوَجْهَ ، وَلا يَضْرِبَنَّ أَحَدٌ الْوَجْهَ ""","","","","","Book of Blood Money (Diyat)"
"17372","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا ضَرَبْتُمْ ، فَاتَّقُوا الْوَجْهَ ، فَإِنَّ اللَّهُ خَلَقَ وَجْهَ آدَمَ عَلَى صُورَتِهِ ""","","","","","Book of Blood Money (Diyat)"
"17373","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ عَطِيَّةَ الْعَوْفِيِّ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا قَاتَلَ أَحَدُكُمْ فَلْيَجْتَنِبِ الْوَجْهَ ""","","","","","Book of Blood Money (Diyat)"
"17374","عَنْ يَحْيَى الْبَجَلِيِّ ، عَنِ ابْنِ عَجْلانَ ، عَنِ الْقَعْقَاعِ بْنِ حَكِيمٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا ضَرَبَ أَحَدُكُمْ فَلْيَجْتَنِبِ الْوَجْهَ ، وَلا يَقُولَنَّ : قَبَّحَ اللَّهُ وَجْهَكَ ، وَوَجْهَ مَنْ أَشْبَهُ وَجْهَكَ ؛ فَإِنَّ اللَّهُ خَلَقَ آدَمَ عَلَى صُورَتِهِ ""","","","","","Book of Blood Money (Diyat)"
"17375","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ ، أَنَّهُيَنْهَى  عَنِ الرَّجُلِ , يَقُولُ لِلرَّجُلِ : قَبَّحَ اللَّهُ وَجْهَكَ ""","","","","","Book of Blood Money (Diyat)"
"17376","عَنِ الثَّوْرِيِّ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، عَنْ مَيْمُونِ بْنِ أَبِي شَبِيبٍ ، عَنْ عَمَّارِ بْنِ يَاسِرٍ , قَالَ : لا يَضْرِبُ رَجُلٌ عَبْدًا لَهُ ظُلْمًا , إِلا أُقِيدَ مِنْهُ يَوْمَ الْقِيَامَةِ ""","","","","","Book of Blood Money (Diyat)"
"17377","عَنْ مَعْمَرٍ , قَالَ : رَأَيْتُ عِنْدَ الزُّهْرِيِّ غُلامًا لَهُ بَرْبَرِيًّا مُقَيَّدًا بِالْحَدِيدِ ""","","","","","Book of Blood Money (Diyat)"
"17378","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، أَنَّ أَبَا هُرَيْرَةَ ، كَانَ يَقُولُ : أَشَدُّ النَّاسِ عَلَى الرَّجُلِ يَوْمَ الْقِيَامَةِ مَمْلُوكُهُ ""","","","","","Book of Blood Money (Diyat)"
"17379","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ , قَالَ :بَيْنَا رَجُلٌ يَضْرِبُ غُلامًا لَهُ وَهُوَ يَقُولُ : أَعُوذُ بِاللَّهُ , إِذْ بَصُرَ بِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : أَعُوذُ بِرَسُولِ اللَّهِ , فَأَلْقَى مَا فِي يَدِهِ , وَخَلَّى عَنِ الْعَبْدِ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  أَمَا وَاللَّهِ لَلَّهُ أَحَقُّ أَنْ يُعَاذَ مَنِ اسْتَعَاذَ بِهِ مِنِّي "" , قَالَ : فَقَالَ الرَّجُلُ : يَا رَسُولَ اللَّهِ ، فَهُوَ لِوَجْهِ اللَّهُ , قَالَ : "" وَالَّذِي نَفْسِي بِيَدِهِ لَوْ لَمْ تَفْعَلْ لَوَاقَعَ وَجْهُكَ سَفْعَ النَّارِ ""","","","","","Book of Blood Money (Diyat)"
"17380","عَنِ الثَّوْرِيِّ , قَالَ : أَخْبَرَنِي . . . عَنْ إِبْرَاهِيمَ التَّيْمِيِّ , قَالَ : مَرَّ أَبُو ذَرٍّ عَلَىرَجُلٍ يَضْرِبُ غُلامًا لَهُ ، فَقَالَ لَهُ أَبُو ذَرٍّ :  إِنِّي لأَعْلَمُ مَا أَنْتَ قَائِلٌ لِرَبِّكَ ، وَمَا هُوَ قَائِلٌ لَكَ ، تَقُولُ : اللَّهُمَّ اغْفِرْ لِي ، فَيَقُولُ : أَكُنْتَ تَغْفِرُ ؟ فَتَقُولُ : اللَّهُمَّ ارْحَمْنِي , فَيَقُولُ : أَكُنْتَ تَرْحَمُ ؟""","","","","","Book of Blood Money (Diyat)"
"17381","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ التَّيْمِيِّ ، عَنْ أَبِيهِ ، عَنْ أَبِي مَسْعُودٍ الأَنْصَارِيِّ ، قَالَ : بَيْنَا أَنَاأَضْرِبُ غُلامًا لِي ، إِذْ سَمِعْتُ صَوْتًا مِنْ وَرَائِي : اعْلَمْ أَبَا مَسْعُودٍ , اعْلَمْ أَبَا مَسْعُودٍ ، ثَلاثًا ، فَالْتَفَتُ أَنَا بِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  وَاللَّهِ لَلَّهُ أَقْدَرُ عَلَيْكَ مِنْكَ عَلَى هَذَا "", فَحَلَفْتُ أَنْ لا أَضْرِبَ مَمْلُوكًا لِي أَبَدًا""","","","","","Book of Blood Money (Diyat)"
"17382","عَنْ سُفْيَانَ الثَّوْرِيِّ , قَالَ : قَالَ لِي الشَّعْبِيُّ : مَا ضَرَبْتُ غُلامًا لِي قَطُّ ""","","","","","Book of Blood Money (Diyat)"
"17383","عَنِ ابْنِ عُيَيْنَةَ , قَالَ الشَّعْبِيُّ : إِذَا سَمِعْتَنِي أَقُولُ لِغُلامِي أَخْزَاكَ اللَّهُ فَهُوَ حُرٌّ ""","","","","","Book of Blood Money (Diyat)"
"17384","عَنِ الثَّوْرِيِّ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ , قَالَ : كَانَ يُقَالُ : لا تَجْمَعُوا عَلَى الْخَدَمِ اللَّيْلَ وَالنَّهَارَ ""","","","","","Book of Blood Money (Diyat)"
"17385","عَنْ يَحْيَى بْنِ الْعَلاءِ ، عَنِ ابْنِ أَبِي لَيْلَى ، عَنْ دَاوُدَ بْنِ عَلِيٍّ ، عَنْ أَبِيهِ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : عَلِّقُوا السَّوْطَ حَيْثُ يَرَاهَا أَهْلُ الْبَيْتِ ""","","","","","Book of Blood Money (Diyat)"
"17386","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ حُمَيْدِ بْنِ نَافِعٍ ، عَنْ أَسْمَاءَ بِنْتِ أَبِي بَكْرٍ , قَالَتْ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :إِنِّي لأَكْرَهُ أَنْ أَرَى الرَّجُلَ نَايِرًا ، فَرَبِصَ رَقَبَةً قَائِمًا عَلَى مَرَسِهِ يَضْرِبُهَا","","","","","Book of Blood Money (Diyat)"
"17387","أَخْبَرَنَا يَحْيَى , قَالَ : حَدَّثَنَا الأَعْمَشُ ، عَنْ مَعْرُورِ بْنِ سُوَيْدٍ , قَالَ : مَرَرْتُ بِالرّبَذَةِ فَرَأَيْتُ أَبَا ذَرٍّ عَلَيْهِ بُرْدَةٌ ، وَعَلَى غُلامِهِ أُخْتُهَا ، فَقُلْتُ : يَا أَبَا ذَرٍّ لَوْ جَمَعْتَ هَاتَيْنِ فَكَانَتْ حُلَّةً ، فَقَالَ : سَأُخْبِرُكَ عَنْ ذَلِكَ , إِنِّيسَابَبْتُ رَجُلا مِنْ أَصْحَابِي ، وَكَانَتْ أُمُّهُ أَعْجَمِيَّةً , فَنِلْتُ مِنْهَا ، فَأَتَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِيُعْذِرَهُ مِنِّي ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  يَا أَبَا ذَرٍّ , إِنَّ فِيكَ جَاهِلِيَّةً "" , قَالَ : قُلْتُ : يَا رَسُولَ اللَّهِ ، أَعَلَى سِنِّي هَذِهِ مِنَ الكِبَرِ ؟ فَقَالَ : "" إِنَّكَ امْرُؤٌ فِيكَ جَاهِلِيَّةٌ , إِنَّهُمْ إِخْوَانُكُمْ , جَعَلَهُمُ اللَّهُ فِتْيَةً لَكُمْ تَحْتَ أَيْدِيكُمْ ، فَمَنْ كَانَ أَخُوهُ تَحْتَ يَدِهِ , فَلْيُطْعِمْهُ مِنْ طَعَامِهِ ، وَلْيُلْبِسْهُ مِنْ ثِيَابِهِ ، وَلا يُكَلِّفْهُ مَا يَغْلِبُهُ فَإِنْ فَعَلَ فَلْيُعِنْهُ عَلَيْهِ ""","","","","","Book of Blood Money (Diyat)"
"17388","عَنْ إِبْرَاهِيمَ بْنِ عُمَرَ ، عَنْ عَبْدِ الْكَرِيمِ ، عَنْ مُجَاهِدٍ ، أَنَّ أَبَا ذَرٍّ ، كَانَ يُصَلِّي وَعَلَيْهِ بُرْدُ قُطْنٍ وَشَمْلَةٌ ، وَلَهُ غُنَيْمَةٌ ، وَعَلَى غُلامِهِ بُرْدُ قُطْنٍ وَشَمْلَةٌ ، فَقِيلَ لَهُ : فَقَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : أَطْعِمُوهُمْ مِمَّا تَأْكُلُونَ ، وَاكْسُوهُمْ مِمَّا تَلْبَسُونَ ، وَلا تُكَلِّفُوهُمْ مَا لا يُطِيقُونَ ، فَإِنْ فَعَلْتُمْ فَأَعِينُوهُمْ ، وَإِنْ كَرِهْتُمُوهُمْ فَبِيعُوهُمْ ، وَاسْتَبْدِلُوهُمْ ، وَلا تُعَذِّبُوا خَلْقًا أَمْثَالَكُمْ ""","","","","","Book of Blood Money (Diyat)"
"17389","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ ابْنِ عَجْلانَ ، عَنْ بُكَيْرِ بْنِ عَبْدِ اللَّهِ بْنِ الأَشَجِّ ، عَنْ عَجْلانَ أَبِي مُحَمَّدٍ , قَالَ : سَمِعْتُ أَبَا هُرَيْرَةَ يُحَدِّثُ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ : لِلْمَمْلُوكِ طَعَامُهُ ، وَكِسْوَتُهُ ، وَلا تُكَلِّفُوهُ مِنَ الْعَمَلِ إِلا مَا يُطِيقُ ""","","","","","Book of Blood Money (Diyat)"
"17390","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي حَبِيبُ بْنُ أَبِي ثَابِتٍ , أَنَّهُ سَمِعَ :  أَنَّالإِنْسَانَ إِذَا ضَرَبَ مَمْلُوكَهُ فَوْقَ أَرْبَعِينَ سَوْطًا ، فَإِنَّهُ عَدَا ""","","","","","Book of Blood Money (Diyat)"
"17391","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، أَنَّهُ  كَانَيُقَيِّدُ غُلامَهُ بِالْقَيْدِ الْخَفِيفِ ""","","","","","Book of Blood Money (Diyat)"
"17392","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ : أَنَّامْرَأَةً قَذَفَتْ وَلِيدَةً , فَقَالَتْ لَهَا : يَا زَانِيَةُ , أَوْ رَجُلٌ قَذَفَ أَمَتَهُ ، فَقَالَ عَبْدُ اللَّهِ بْنُ عُمَرَ :  أَرَأَيْتَهَا تَزْنِي ؟ "" , قَالَ : لا ، فَقَالَ : "" وَالَّذِي نَفْسِي بِيَدِهِ لَتُجْلَدَنَّ لَهَا يَوْمَ الْقِيَامَةِ ثَمَانِينَ ""","","","","","Book of Blood Money (Diyat)"
"17393","عَنْ يَحْيَى بْنِ الْعَلاءِ ، عَنْ يَحْيَى , قَالَ : حَدَّثَنَا رَبِيعَةُ , قَالَ : سَمِعْتُ ابْنَ الْمُسَيِّبِ , يَقُولُ : مَنْ قَذَفَ أَمَتَهُ جُلِدَ يَوْمَ الْقِيَامَةِ ثَمَانِينَ سَوْطًا بِسَوْطٍ مِنْ حَدِيدٍ ""","","","","","Book of Blood Money (Diyat)"
"17394","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ عِكْرِمَةَ : أَنَّامْرَأَةً قَذَفَتْ وَلِيَدَتَهَا ، فَقَالَتْ : يَا زَانِيَةُ ، أَوْ رَجُلٌ قَذَفَ أَمَتَهُ ، فَقَالَ عَبْدُ اللَّهِ بْنُ عُمَرَ :  أَرَأَيْتَهَا تَزْنِي ؟ "" , قَالَ : لا , قَالَ : "" وَالَّذِي نَفْسِي بِيَدِهِ لَتُجْلَدَنَّ لَهَا يَوْمَ الْقِيَامَةِ ثَمَانِينَ ""","","","","","Book of Blood Money (Diyat)"
"17395","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : وَالْمَرْأَةُ تُقْتَلُ بِالرَّجُلِ لَيْسَ بَيْنَهُمَا فَضْلٌ ""، وَعَمْرٌو""","","","","","Book of Blood Money (Diyat)"
"17396","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : لا تُقَادُ الْمَرْأَةُ مِنْ زَوْجِهَا فِي الأَدَبِ "" , يَقُولُ : "" لَوْ ضَرَبَهَا فَشَجَّهَا ، وَلَكِنْ إِنِ اعْتَدَى عَلَيْهِا فَقَتَلَهَا كَانَ الْقَوَدُ ""","","","","","Book of Blood Money (Diyat)"
"17397","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ : قَتَلَ رَجُلا بِامْرَأَةٍ ""","","","","","Book of Blood Money (Diyat)"
"17398","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ , قَالَ : وَتُقَادُ الْمَرْأَةُ مِنَ الرَّجُلِ فِي كُلِّ عَمَدٍ يَبْلُغُ نَفْسًا فَمَا فَوْقَهَا مِنَ الْجِرَاحِ ، فَإِنِ اصْطَلَحُوا عَلَى الْعَقْلِ أَدَّى فِي عَقْلِ الْمَرْأَةِ فِي دِيَتِهِا ، فَمَا زَادَ فِي الصُّلْحِ فِي دِيَتِهِا ، فَلَيْسَ عَلَى الْعَاقِلَةِ مِنْهُ شَيْءٌ إِلا أَنْ يَشَاءُوا ""","","","","","Book of Blood Money (Diyat)"
"17399","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ : لَيْسَ بَيْنَ الرِّجَالِ وَالنِّسَاءِ قِصَاصٌ ، إِلا فِي النَّفْسِ , وَلا بَيْنَ الأَحْرَارِ وَالْعَبِيدِ قِصَاصٌ إِلا فِي النَّفْسِ ""","","","","","Book of Blood Money (Diyat)"
"17400","عَنِ الثَّوْرِيِّ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ , قَالَ : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ  أَنَّالْقِصَاصَ ، بَيْنَ الرَّجُلِ وَالْمَرْأَةِ فِي الْعَمْدِ حَتَّى فِي النَّفْسِ ""، قَالَ سُفْيَانُ : "" الْقِصَاصُ فِي النَّفْسِ ، وَمَا دُونَهَا بَيْنَ الرَّجُلِ وَالْمَرْأَةِ "" , فِي قَوْلِ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ""","","","","","Book of Blood Money (Diyat)"
"17401","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَلِيٍّ , قَالَ : مَا كَانَ بَيْنَ الرَّجُلِ وَالْمَرْأَةِ ، فَفِيهِ الْقِصَاصُ مِنْ جِرَاحَاتٍ ، أَوْ قَتْلِ النَّفْسِ ، أَوْ غَيْرِهَا , إِذَا كَانَ عَمْدًا ""","","","","","Book of Blood Money (Diyat)"
"17402","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ ، عَنْ عَلِيٍّ  أَنَّبَيْنَهُمَا سِتَّةَ آلافٍ ""","","","","","Book of Blood Money (Diyat)"
"17403","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ : الْقِصَاصُ بَيْنَ الرِّجَالِ وَالنِّسَاءِ فِي الْعَمْدِ "", قَالَ : وَقَالَهُ جَابِرٌ , عَنِ الشَّعْبِيِّ""","","","","","Book of Blood Money (Diyat)"
"17404","عَنْ أَبِي حَنِيفَةَ , عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : لَيْسَ بَيْنَ الرِّجَالِ وَالنِّسَاءِ قِصَاصٌ ، إِلا فِي النَّفْسِ ، وَلا بَيْنَ الأَحْرَارِ وَالْعَبِيدِ قِصَاصٌ ، إِلا فِي النَّفْسِ ""","","","","","Book of Blood Money (Diyat)"
"17405","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ :  وَالْجُرُوحَ قِصَاصٌ ، وَلَيْسَ لِلإِمَامِ أَنْ يَضْرِبَهُ ، وَلا يَسْجِنَهُ ، إِنَّمَا هُوَ الْقِصَاصُ ، وَمَا كَانَ اللَّهُ نَسِيًّا , لَوْ شَاءَ لأَمَرَ بِالضَّرْبِ وَالسِّجْنِ ""","","","","","Book of Blood Money (Diyat)"
"17406","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، وَابْنِ أَبِي مُلَيْكَةَ ، قَالا : إِنْ قَتَلَ رَجُلٌ رَجُلا ، وَجَرَحَ الْمَقْتُولُ بِالْقَاتِلِ جُرْحًا ، قُتِلَ الْقَاتِلُ ، وَوَدَى أَهْلُ الْمَقْتُولِ مَا جَرَحَ بِالْقَاتِلِ ""","","","","","Book of Blood Money (Diyat)"
"17407","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : يَنْتَظِرُ بِالْقَوَدِ أَنْ يَبْرَأَ صَاحِبُهُ ""","","","","","Book of Blood Money (Diyat)"
"17408","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، أَنَّ مُحَمَّدَ بْنَ طَلْحَةَ بْنِ يَزِيدَ بْنِ رُكَانَةَ أَخْبَرَهُمْ ,  أَنَّرَجُلا طَعَنَ رَجُلا بِقَرْنٍ فِي رِجْلِهِ ، فَجَاءَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" أَقِدْنِي "" ، قَالَ : لا حَتَّى تَبْرَأَ ، قَالَ : "" أَقِدْنِي , فَأَقَادَهُ "" , ثُمَّ عَرَجَ , فَجَاءَ الْمُسْتَقِيدُ ، فَقَالَ : حَقِّي ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" لا شَيْءَ لَكَ "", عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ مُحَمَّدِ بْنِ طَلْحَةَ مِثْلَهُ . عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" أَبْعَدَكَ اللَّهُ ! أَنْتَ عَجَّلْتَ ""","","","","","Book of Blood Money (Diyat)"
"17409","عَنِ الثَّوْرِيِّ ، عَنْ حُمَيْدٍ الأَعْرَجِ ، عَنْ مُجَاهِدٍ ،  أَنَّرَجُلا وَجَأَ رَجُلا بِقَرْنٍ فِي فَخِذِهِ , فَجَاءَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَطَلَبَ إِلَيْهِ أَنْ يُقِيدَهُ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" حَتَّى تَبْرَأَ "" , فَأَبَى إِلا أَنْ يُقِيدَهُ , فَأَقَادَهُ ، فَأَفْلَتَ ، فَشُلَّتْ رِجْلُهُ بَعْدُ ، فَجَاءَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : "" مَا أَرَى لَكَ شَيْئًا قَدْ أَخَذْتَ حَقَّكَ ""","","","","","Book of Blood Money (Diyat)"
"17410","عَنِ الثَّوْرِيِّ ، عَنْ عِيسَى بْنِ الْمُغِيرَةِ ، عَنْ يَزِيدَ بْنِ وَهْبٍ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ كَتَبَ إِلَى طَرِيفِ بْنِ رَبِيعَةَ ، وَكَانَ قَاضِيًا بِالشَّامِ ، أَنَّ صَفْوَانَ بْنَ الْمُعَطِّلِ ضَرَبَ حَسَّانَ بْنَ ثَابِتٍ بِالسَّيْفِ ، فَجَاءَتِ الأَنْصَارُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَقَالُوا : الْقَوَدَ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :تَنْتَظِرُونَ ، فَإِنْ بَرَأَ صَاحِبُكُمْ تَقْتَصُّوا ، وَإِنْ يَمُتْ نُقِدْكُمْ , فَعُوفِيَ , فَقَالَتِ الأَنْصَارُ : قَدْ عَلِمْتُمْ أَنَّ هَوَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الْعَفْوِ ، قَالَ : فَعَفَوْا عَنْهُ, فَأَعْطَاهُ صَفْوَانُ جَارِيَةً , فَهِيَ أُمُّ عَبْدِ الرِّحْمَنِ بْنِ حَسَّانَ","","","","","Book of Blood Money (Diyat)"
"17411","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَضَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيرَجُلٍ طَعَنَ آخَرَ بِقَرْنٍ فِي رِجْلِهِ ، فَقَالَ : يَا رَسُولَ اللَّهِ ، أَقِدْنِي ، فَقَالَ :  حَتَّى تَبْرَأَ جِرَاحُكَ "" , فَأَبَى الرَّجُلُ إِلا أَنْ يَسْتَقِيدَ , فَأَقَادَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَصَحَّ الْمُسْتَقَادُ مِنْهُ ، وَعَرَجَ الْمُسْتَقِيدُ ، فَقَالَ : عَرِجْتُ وَبَرَأَ صَاحِبِي ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" أَلَمْ آمُرْكَ أَنْ لا تَسْتَقِيدَ حَتَّى تَبْرَأَ جِرَاحُكَ فَعَصَيْتَنِي ، فَأَبْعَدَكَ اللَّهُ وَبَطَلَ عَرْجُكَ "" ، ثُمَّ أَمَرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" مَنْ كَانَ بِهِ جُرْحٌ بَعْدَ الرَّجُلِ الَّذِي عَرَجَ أَنْ لا يَسْتَقِيدَ حَتَّى يَبْرَأَ جُرْحُ صَاحِبِهِ "" ، فَالْجِرَاحُ عَلَى مَا بَلَغَ حِينَ يَبْرَأُ ، فَمَا كَانَ مِنْ شَلَلٍ ، أَوْ عَرَجٍ ، فَلا قَوَدَ فِيهِ , وَهُوَ عَقْلٌ ، وَمَنِ اسْتَقَادَ جُرْحًا فَأُصِيبَ الْمُسْتَقَادُ مِنْهُ ، فَعَقْلُ مَا فَضَلَ عَلَى دِيَتِهِ عَلَى جُرْحِ صَاحِبِهِ لَهُ, سَمِعْتُ الْمُثَنَّى يَقُولُ : أَخْبَرَنِيهِ عَمْرُو بْنُ شُعَيْبٍ""","","","","","Book of Blood Money (Diyat)"
"17412","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، سَمِعَ عِكْرِمَةَ ، قَالَ : طَعَنَ رَجُلٌ رَجُلا بِقَرْنٍ ، فَجَاءَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : أَقِدْنِي ، فَقَالَ : "" دَعْهُ ، حَتَّى تَبْرَأَ "" , فَأَعَادَهَا عَلَيْهِ مَرَّتَيْنِ ، أَوْ ثَلاثًا ، وَالنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : "" دَعْهُ حَتَّى تَبْرَأَ "" , فَأَقَادَهُ بِهِ ، ثُمَّ عَرَجَ الْمُسْتَقِيدُ , فَجَاءَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : بَرَأَ صَاحِبِي وَعَرِجْتُ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" أَلَمْ آمُرْكَ أَنْ لا تَسْتَقِيدَ حَتَّى تَبْرَأَ جِرَاحُكَ , فَالْجِرَاحُ عَلَى مَا بَلَغَ ، وَمَا كَانَ مِنْ شَلَلٍ أَوْ عَرَجٍ فَلا قَوَدَ فِيهِ ، وَهُوَ عَقْلٌ ، وَمَنِ اسْتَقَادَ جُرْحًا فَأُصِيبَ الْمُسْتَقَادُ مِنْهُ ، فَعَقْلُ مَا نَقَصَ مِنْ جُرْحِ صَاحِبِهِ لَهُ ، وَقَضَى أَنَّ الْوَلاءَ لِمَنْ أَعْتَقَ ""","","","","","Book of Blood Money (Diyat)"
"17413","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :رَجُلٌ اسْتَقَادَ مِنْ رَجُلٍ قَبْلَ أَنْ يَبْرَأَ صَاحِبُهُ ، ثُمَّ مَاتَ الْمُسْتَقِيدُ مِنَ الَّذِي أَصَابَهُ , قَالَ :  أَرَى أَنْ يُودَى فَضْلُ عَقْلِ الْمُسْتَقِيدِ ""","","","","","Book of Blood Money (Diyat)"
"17414","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الرَّجُلُ يَسْتَقِيدُ مِنَ الرَّجُلِ , فَيَمُوتُ الْمُسْتَقَادُ مِنْهُ , قَالَ : "" أَرَى أَنْ يُؤْدَى "", قَالَ : وَقَالَ لِي عَمْرُو بْنُ دِينَارٍ : "" أَظُنُّ أَنَّهُ سَيُودِي ""","","","","","Book of Blood Money (Diyat)"
"17415","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : لَوْ أَنَّ رَجُلا اسْتَقَادَ مِنْ آخَرَ ، ثُمَّ مَاتَ الْمُسْتَقَادُ مِنْهُ , غَرِمَ دِيَتَهُ ""","","","","","Book of Blood Money (Diyat)"
"17416","عَنْ مَعْمَرٍ ، وَابْنِ أَبِي نَجِيحٍ ، عَنِ ابْنِ شِهَابٍ , قَالَ : السُّنَّةُ أَنْ يُودَى ""","","","","","Book of Blood Money (Diyat)"
"17417","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , فِيرَجُلٍ أَشَلَّ إِصْبَعَ رَجُلٍ , قَالَ :  يَسْتَقِيدُ مِنْهُ , فَإِنْ شَلَّتْ إِصْبَعُهُ , وَإِلا غَرِمَ لَهُ الدِّيَةَ ""","","","","","Book of Blood Money (Diyat)"
"17418","عَنْ هُشَيْمٍ ، عَنْ أَبِي إِسْحَاقَ الشَّيْبَانِيِّ ، أَوْ غَيْرِهِ , أَنَا أَشُكُّ ، عَنِ الشَّعْبِيِّ , فِيرَجُلٍ جَرَحَ رَجُلا فَاقْتَصَّ مِنْهُ ، ثُمَّ هَلَكَ الْمُسْتَقَادُ مِنْهُ , قَالَ :  عَقْلُهُ عَلَى الَّذِي اسْتَقَادَهُ مِنْهُ ، وَيَطْرَحُ عَلَيْهِ دِيَةَ جُرْحِهِ مِنْ ذَلِكَ ، فَمَا فَضَلَ مِنْ عَقْلِهِ فَهُوَ عَلَيْهِ ""","","","","","Book of Blood Money (Diyat)"
"17419","عَنْ مَعْمَرٍ ، عَنِ ابْنِ شُبْرُمَةَ ، عَنِ الْحَارِثِ الْعُكْلِيِّ , فِيالَّذِي يُسْتَقَادُ مِنْهُ ، ثُمَّ يَمُوتُ , قَالَ :  يَغْرَمُ دِيَتَهُ لأَنَّ النَّفْسَ خَطَأٌ ""","","","","","Book of Blood Money (Diyat)"
"17420","عَنِ الثَّوْرِيِّ ، عَنْ يُونُسَ ، عَنِ الْحَسَنِ , قَالَ : مَنْ مَاتَ فِي قِصَاصٍ ، فَلا دِيَةَ لَهُ ""","","","","","Book of Blood Money (Diyat)"
"17421","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ ، عَنْ عُمَرَ , قَالَ : قَتْلُهُ حَقٌّ "" , يَعْنِي : أَنْ لا دِيَةَ""","","","","","Book of Blood Money (Diyat)"
"17422","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : كَانَ يَرْوِيهِ عَنْ بَعْضِهِمْ , يَقُولُ : لا يَغْرَمُهُ إِنَّمَا هُوَ لَحَدٌّ أَتَى عَلَى أَجَلِهِ ""","","","","","Book of Blood Money (Diyat)"
"17423","عَنْ عُثْمَانَ بْنِ مَطَرٍ ، عَنْ سَعِيدٍ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ ، عَنْ عُمَرَ , قَالَ : لا يُودَى , قَتْلُهُ حَقٌّ ""","","","","","Book of Blood Money (Diyat)"
"17424","قَالَ قَتَادَةُ : وَأَخْبَرَنِي رَجُلٌ ، عَنْ عَلِيِّ بْنِ أَبِي طَالِبٍ , قَالَ : قَتَلَهُ كِتَابُ اللَّهُ ""","","","","","Book of Blood Money (Diyat)"
"17425","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنْ عُمَرَ ، وَعَلِيٍّ ، قَالا : لا يَغْرَمُهُ "" ، أَوْ قَالَ أَحَدُهُمَا : "" قَتْلُهُ حَقٌّ "" ، وَقَالَ الآخَرُ "" : قَتَلَهُ كِتَابُ اللَّهُ ""","","","","","Book of Blood Money (Diyat)"
"17426","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي حُصَيْنٍ ، عَنْ عُمَيْرِ بْنِ سَعْدٍ , قَالَ : قَالَ عَلِيٌّ : مَا كُنْتُ لأُقِيمَ عَلَى أَحَدٍ حَدًّا فَيَمُوتَ ، فَأَجِدَ فِي نَفْسِي إِلا صَاحِبَ الْخَمْرِ , فَلَوْ مَاتَ وَدَيْتُهُ ، وَذَلِكَ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَمْ يَسُنَّهُ ""","","","","","Book of Blood Money (Diyat)"
"17427","عَنْ مَعْمَرٍ ، عَنْ سَعِيدٍ ، عَنْ أَبِي مَعْشَرٍ ، عَنْ إِبْرَاهِيمَ ، عَنِ ابْنِ مَسْعُودٍ , قَالَ : عَلَى الَّذِي اقْتَصَّ مِنْهُ دِيَتُهُ , غَيْرَ أَنَّهُ يُطْرَحُ عَنْهُ دِيَةُ جُرْحِهِ ""","","","","","Book of Blood Money (Diyat)"
"17428","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مُحَمَّدٌ ، أَنَّ عَلِيًّا ، وَعُمَرَ اجْتَمَعَا عَلَى أَنَّهُ : مَنْ مَاتَ فِي الْقِصَاصِ فَلا حَقَّ لَهُ , كِتَابُ اللَّهُ قَتَلَهُ "", قُلْتُ لَهُ : مَنْ مُحَمَّدٌ ؟ قَالَ : أَظُنُّهُ مُحَمَّدَ بْنَ عُبَيْدِ اللَّهُ الْعَرْزَمِيَّ""","","","","","Book of Blood Money (Diyat)"
"17429","عَنْ مَعْمَرٍ ، عَنْ مَطَرٍ الْوَرَّاقِ ، وَغَيْرِهِ ، عَنِ الْحَسَنِ , قَالَ : أَرْسَلَ عُمَرُ بْنُ الْخَطَّابِ إِلَى امْرَأَةٍ مُغَيَّبَةٍ كَانَ يُدْخَلُ عَلَيْهِا ، فَأَنْكَرَ ذَلِكَ ، فَأَرْسَلَ إِلَيْهَا ، فَقِيلَ لَهَا : أَجِيبِي عُمَرَ ، فَقَالَتْ : يَا وَيْلَهَا مَا لَهَا وَلِعُمَرَ ! قَالَ : فَبَيْنَا هِيَ فِي الطَّرِيقِ , فَزِعَتْ , فَضَرَبَهَا الطَّلْقُ , فَدَخَلَتْ دَارًا فَأَلْقَتْ وَلَدَهَا ، فَصَاحَ الصَّبِيُّ صَيْحَتَيْنِ ، ثُمَّ مَاتَ ، فَاسْتَشَارَ عُمَرُ أَصْحَابَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَأَشَارَ عَلَيْهِ بَعْضُهُمْ ، أَنْ لَيْسَ عَلَيْكَ شَيْءٌ ، إِنَّمَا أَنْتَ وَالٍ وَمُؤَدِّبٌ , قَالَ : وَصَمَتَ عَلِيٌّ , فَأَقْبَلَ عَلَيْهِ ، فَقَالَ : مَا تَقُولُ ؟ قَالَ : إِنْ كَانُوا قَالُوا : بِرَأْيِهِمْ فَقَدْ أَخْطَأَ رَأْيُهُمْ ، وَإِنْ كَانُوا قَالُوا : فِي هَوَاكَ فَلَمْ يَنْصَحُوا لَكَ ، أَرَى أَنَّ دِيَتَهُ عَلَيْكَ , فَإِنَّكَ أَنْتَ أَفْزَعْتَهَا ، وَأَلْقَتْ وَلَدَهَا فِي سَبَبِكَ , قَالَ : فَأَمَرَ عَلِيًّا أَنْ يَقْسِمَ عَقْلَهُ عَلَى قُرَيْشٍ ""، يَعْنِي : يَأْخُذُ عَقْلَهُ مِنْ قُرَيْشٍ لأَنَّهُ خَطَأٌ . عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ الأَعْمَشَ يُحَدِّثُ بِمَشُورَةِ عَلِيٍّ عَلَيْهِ , وَإِسْقَاطِهَا , وَأَمْرِهِ إِيَّاهُ أَنْ : "" يَضْرِبَ الدِّيَةَ عَلَى قُرَيْشٍ ""","","","","","Book of Blood Money (Diyat)"
"17430","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :أَيُقَادُ مِنَ الْمَأْمُومَةِ ؟ قَالَ :  مَا سَمِعْنَا أَحَدًا أَقَادَ مِنْهَا قَبْلَ ابْنِ الزُّبَيْرِ ""","","","","","Book of Blood Money (Diyat)"
"17431","عَنِ الثَّوْرِيِّ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، أَنَّ ابْنَ الزُّبَيْرِ ، أَقَادَ مِنَ الْمَأْمُومَةِ ""","","","","","Book of Blood Money (Diyat)"
"17432","عَنْ مَعْمَرٍ ، عَنْ سَعِيدِ بْنِ عَبْدِ الرَّحْمَنِ الْجَحْشِيِّ ، عَنْ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ , قَالَ : كَسَرَ رَجُلٌ فَخِذَ رَجُلٍ , فَسَأَلْتُ بِالْمَدِينَةِ ، فَأَمَرَنِي أَكْثَرُ مَنْ سَأَلْتُ بِالْقَوَدِ , فَأَقَدْتُ مِنْهُ ""","","","","","Book of Blood Money (Diyat)"
"17433","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : لا يُقَادُ مِنَ الْمَنْقُولَةِ ، وَالْجَائِفَةِ ""","","","","","Book of Blood Money (Diyat)"
"17434","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :فَاللَّحْيُ يُكْسَرُ ، وَالصُّلْبُ , وَالْيَدُ , وَالأَنْفُ , قَالَ :  لا يُقَادُ مِنْ ذَلِكَ كُلِّهِ ""","","","","","Book of Blood Money (Diyat)"
"17435","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : كُلُّ شَيْءٍ إِذَا أَقَدْتَ مِنْهُ جَاءَ مِثْلَ الَّذِي أَصَابَ سَوَاءً فَأَقِدْ مِنْهُ ، وَكُلُّ شَيْءٍ لا يُسْتَطَاعُ أَنْ يَأْتِي مِثْلَهُ ، فَلا تُقِدْ مِنْهُ "" ، قُلْتُ : فَالْعَيْنُ ؟ قَالَ : "" نَعَمْ ، وَالسِّنُّ "", فَذَكَرْتُ ذَلِكَ لِعَمْرٍو ، قَوْلَ عَطَاءٍ , قَالَ : نِعْمَ ، مَا قَالَ""","","","","","Book of Blood Money (Diyat)"
"17436","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : لا قَوَدَ فِي الْجَائِفَةِ وَلا الْمَأْمُومَةِ ""","","","","","Book of Blood Money (Diyat)"
"17437","عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ شِهَابٍ , قَالَ : لا قَوَدَ فِي الْمَأْمُومَةِ ""","","","","","Book of Blood Money (Diyat)"
"17438","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : لا قِصَاصَ فِي الْهَاشِمَةِ ، وَلا الْمُنَقِّلَةِ ، وَلا الْجَائِفَةِ ، وَلا الْمَأْمُومَةِ ، وَلا الْيَدِ الشَّلاءِ ، وَلا الرِّجْلِ الشَّلاءِ ، وَفِي ذَلِكَ الدِّيَةُ ""","","","","","Book of Blood Money (Diyat)"
"17439","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ ، يَبْلُغُ بِهِ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :لا قَوَدَ فِي الشَّلَلِ ، وَلا فِي الْعَرَجِ ، وَلا فِي الْكَسْرِ , وَفِيهِ الْعَقْلُ, عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ","","","","","Book of Blood Money (Diyat)"
"17440","عَنِ الثَّوْرِيِّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، وَالشَّعْبِيِّ ، أنهما قَالا : لا قِصَاصَ فِي عَظْمٍ مَا خَلا الرّأْسَ ""","","","","","Book of Blood Money (Diyat)"
"17441","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , قَالَ : لَيْسَ فِي الْعِظَامِ قِصَاصٌ "", عَنِ الْحَسَنِ بْنِ عُمَارَةَ ، عَنِ الْحَكَمِ ، عَنْ إِبْرَاهِيمَ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"17442","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، أَنَّ جلوازًا لِشُرَيْحٍ ضَرَبَ إِنْسَانًا بِالسَّوْطِ ، فَأَقَادَ مِنْهُ ، قَالَ سُفْيَانُ : وَأَصْحَابُنَا يَقُولُونَ : لا قَوَدَ فِي اللَّطْمَةِ ، وَلا فِي أَشْبَاهِهَا ، وَلا فِي السَّوْطِ ، وَالْعَصَا ، وَفِي ذَلِكَ حُكْمٌ ""","","","","","Book of Blood Money (Diyat)"
"17443","عَنْ مَعْمَرٍ ، عَنِ ابْنِ شُبْرُمَةَ , قَالَ : لا قَوَدَ فِي الْمُنَقِّلَةِ ، وَالْجَائِفَةِ ، وَالْمَأْمُومَةِ ، وَلا قَوَدَ فِي كَسْرِ عَظْمٍ ""","","","","","Book of Blood Money (Diyat)"
"17444","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ ابْنِ شُبْرُمَةَ , قَالَ : لا يُقْتَصُّ مِنَ اللَّطْمَةِ ""، وَقَالَ ابْنُ أَبِي لَيْلَى : "" لا قَوَدَ فِيها ""","","","","","Book of Blood Money (Diyat)"
"17445","عَنْ مَعْمَرٍ ، عَنِ الْحَسَنِ ، وَقَتَادَةَ ، قَالا : لا قِصَاصَ فِي اللَّطْمَةِ ، وَلا الْوَكْزَةِ ""","","","","","Book of Blood Money (Diyat)"
"17446","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ الْمُخَارِقِ بْنِ عَبْدِ اللَّهِ ، قَالَ : سَمِعْتُ طَارِقَ بْنَ شِهَابٍ , يَقُولُ :لَطَمَ عَمُّ خَالِدِ بْنِ الْوَلِيدِ رَجُلا مِنَّا , فَجَاءَ عَمُّهُ إِلَى خَالِدٍ ، فَقَالَ : يَا مَعْشَرَ قُرَيْشٍ ,  إِنَّ اللَّهُ لَمْ يَجْعَلْ لوُجُوهِكُمْ فَضْلا عَلَى وُجُوهِنَا ، إِلا مَا فَضَّلَ اللَّهُ بِهِ نَبِيَّهُ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ خَالِدٌ : "" اقْتَصَّ "" ، فَقَالَ الرَّجُلُ لابْنِ أَخِيهِ : الْطُمْ واشْدُدْ , فَلَمَّا رَفَعَ يَدَهُ قَالَ : "" دَعْهَا لِلَّهُ ""","","","","","Book of Blood Money (Diyat)"
"17447","وَسَمِعْتُ مَوْلًى لِسُلَيْمَانَ , يَقُولُ : يُخْبِرُ مَعْمَرًا : إِنَّ سُلَيْمَانَ بْنَ حَبِيبٍ قَضَى  فِيالصَّكَّةِ إِنِ احْمَرَّتْ , أَوِ اسْوَدَّتْ , أَوِ اخْضَرَّتْ , بِسِتَّةِ دَنَانِيرَ ""","","","","","Book of Blood Money (Diyat)"
"17448","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَعَثَ أَبَا جَهْمِ بْنِ حُذَيْفَةَ مُصَدِّقًا فَلاجَّهُ رَجُلٌ فِي صَدَقَتِهِ , فَضَرَبَهُ أَبُو جَهْمٍ فَشَجَّهُ ، فَأَتَوُا النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالُوا : الْقَوَدَ يَا رَسُولَ اللَّهِ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  لَكُمْ كَذَا وَكَذَا "" , فَلَمْ يَرْضَوْا , قَالَ : "" لَكُمْ كَذَا وَكَذَا "" , فَلَمْ يَرْضَوْا , قَالَ : "" فَلَكُمْ كَذَا وَكَذَا "" , فَرَضَوْا ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" إِنِّي خَاطِبٌ عَلَى النَّاسِ ، وَمُخْبِرُهُمْ بِرِضَاكُمْ "" , قَالُوا : نَعَمْ ، فَخَطَبَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :"" إِنَّ هَؤُلاءِ اللَّيْثِيِّينَ أَتَوْنِي يُرِيدُونَ الْقَوَدَ , فَعَرَضْتُ عَلَيْهِمْ كَذَا وَكَذَا , فَرَضُوا , أَرَضِيتُمْ ؟ "" , قَالُوا : لا ، فَهَمَّ الْمُهَاجِرُونَ بِهِمْ ، فَأَمَرَهُمُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يَكُفُّوا , فَكَفُّوا ، ثُمَّ دَعَاهُمْ فَزَادَهُمْ ، وَقَالَ : "" أَرَضِيتُمْ ؟ "" , قَالُوا : "" نَعَمْ ""","","","","","Book of Blood Money (Diyat)"
"17449","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبْدِ الرِّحْمَنِ الأَنْصَارِيِّ ، عَنْ عُرْوَةَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَعَثَ أَبَا جَهْمٍ عَلَى غَنَائِمَ حُنَيْنٍ ، فَبَلَغَ أَبَا جَهْمٍ ، أَنَّ مَالِكَ بْنَ الْبَرْصَاءِ , أَوِ الْحَارِثَ بْنَ الْبَرْصَاءِ ، غَلَّ مِنَ الْغَنَائِمِ ، فَضَرَبَهُ أَبُو جَهْمٍ فَشَجَّهُ مَنْقُولَةً ، فَأَتَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَسْأَلُهُ الْقَوَدَ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :ضَرْبَكَ عَلَى ذَنْبٍ أَذْنَبْتَهُ , لا قَوَدَ لَكَ ، لَكَ مِائَةُ شَاةٍ ، فَلَمْ يَرْضَ , قَالَ : فَلَكَ مِائَتَا شَاةٍ , فَلَمْ يَرْضَ , قَالَ : فَلَكَ ثَلاثُمِائَةٍ , لا أَزِيدُكَ, حَسِبْتُ أَنَّهُ قَالَ : فَرَضِي الرَّجُلُ , قَالَ : وَعِلْمِي أَنَّهُ ذَكَرَهُ عَنْ عُرْوَةَ أَيْضًا","","","","","Book of Blood Money (Diyat)"
"17450","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عُبَيْدِ بْنِ عُمَيْرٍ , قَالَ : خَرَجَ سَاعٍ عَلَى عَهْدِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَخَرَجَ مَعَهُ أَبُو جُنْدُبِ بْنُ الْبَرْصَاءِ ، وَأَبُو جَهْمِ بْنُ غَانِمٍ فَافْتَخَرَ أَبُو جُنْدُبِ بْنُ الْبَرْصَاءِ سَلَفَا ابْنِ قَيْسٍ ، فَقَامَ إِلَيْهِ أَبُو جَهْمٍ فَأَمَّهُ بِلَحْيَيْ بَعِيرٍ ، فَلَمَّا قَدْمُوا الْمَدِينَةَ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَرْضَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ جُنْدُبًا وَأَصْحَابَهُ ، ثُمَّ قَالَ : "" أَرَضِيتُمْ ؟ "" , قَالُوا : نَعَمْ , قَالَ : "" فَإِنِّي ذَاكِرٌ عَلَى الْمِنْبَرِ رِضَاكُمْ ، فَإِذَا ذَكَرْتُهُ , فَقُولُوا : نَعَمُ ، فَقَامَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى الْمِنْبَرِ فَذَكَرَ رِضَاهُمْ ، قَالَ : أَرَضِيتُمْ ؟ قَالُوا : لا ، فَنَزَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : أَلَمْ تَزْعُمُوا أَنَّكُمْ قَدْ رَضِيتُمْ فَهَلا اسْتَزَدْتُمُونِي , ثُمَّ زَادَهُمْ ، فَقَالَ : أَرَضِيتُمْ ؟ قَالُوا : نَعَمْ , قَالَ : فَإِنِّي قَائِمٌ عَلَى الْمِنْبَرِ فَذَاكِرٌ رِضَاكُمْ فَإِذَا سَأَلْتُكُمْ أَرَضِيتُمْ ؟ فَقُولُوا : نَعَمْ ، فَقَامَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ رِضَاهُمْ ، وَقَالَ : أَرَضِيتُمْ ؟ قَالُوا : نَعَمْ ، وَلَمْ يُقِدْ مِنْهُ ""","","","","","Book of Blood Money (Diyat)"
"17451","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، عَنِ الْمُغِيرَةِ بْنِ سُلَيْمَانَ :  أَنَّعَامِلا لِعُمَرَ ضَرَبَ رَجُلا فَأَقَادَهُ مِنْهُ ، فَقَالَ عَمْرُو بْنُ الْعَاصِ : "" يَا أَمِيرَ الْمُؤْمِنِينَ , أَتُقَيِّدُ مِنْ عُمَّالِكَ "" , قَالَ : "" نَعَمْ "" , قَالَ : "" إِذًا لا نَعْمَلُ لَكَ "" , قَالَ : "" وَإِنْ لَمْ تَعْمَلُوا "" , قَالَ : "" أَوْ تُرْضِيَهِ "" , قَالَ : "" أَوْ أَرَضِيهِ ""","","","","","Book of Blood Money (Diyat)"
"17452","عَنْ قَيْسِ بْنِ الرّبِيعِ ، عَنْ أَبِي حُصَيْنٍ ، عَنْ حَبِيبِ بْنِ صُهْبَانَ , قَالَ : سَمِعْتُ عُمَرَ ، يَقُولُ : ظُهُوَرُ الْمُسْلِمِينَ حِمَى اللَّهُ لا تَحِلُّ لأَحَدٍ ، إِلا أَنْ يُخْرِجَهَا حَدٌّ ""","","","","","Book of Blood Money (Diyat)"
"17453","قَالَ :  وَلَقَدْرَأَيْتُ بَيَاضَ إِبْطِهِ قَائِمًا يُقِيدُ مِنْ نَفْسِهِ ""","","","","","Book of Blood Money (Diyat)"
"17454","عَنْ مَعْمَرٍ ، عَنْ أَبِي هَارُونَ الْعَبْدِيِّ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ :خَرَجَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ مَنْزِلِهِ يُرِيدُ الصَّلاةَ , فَأَخَذَ رَجُلٌ بِزِمَامِ نَاقَتِهِ ، فَقَالَ : حَاجَتِي يَا رَسُولَ اللَّهِ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : دَعْنِي فَسَتُدْرِكُ حَاجَتَكَ , فَفَعَلَ ذَلِكَ ثَلاثَ مَرَّاتٍ ، وَالرَّجُلُ يَأْبَى , فَرَفَعَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَيْهِ السَّوْطَ فَضَرَبَهُ ، وَقَالَ : دَعْنِي سَتُدْرِكُ حَاجَتَكَ , فَصَلَّى بِالنَّاسِ , فَلَمَّا فَرَغَ , قَالَ : أَيْنَ الرَّجُلُ الَّذِي جَلَدْتُهُ آنِفًا ؟ , قَالَ : فَنَظَرَ النَّاسُ بَعْضُهُمْ إِلَى بَعْضٍ ، وَقَالُوا : مَنْ هَذَا الَّذِي جَلَدَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ؟ فَجَاءَ الرَّجُلُ مِنْ آخَرِ الصُّفُوفِ ، فَقَالَ : أَعُوذُ بِاللَّهُ مِنْ غَضَبِ اللَّهُ وَغَضِبِ رَسُولِهِ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : ادْنُ فَاقْتَصَّ ! , فَرَمَى إِلَيْهِ بِالسَّوْطِ , قَالَ : بَلْ أَعْفُو , قَالَ : أَوْ تَعْفُو ؟ , فَقَالَ : إِنِّي قَدْ عَفَوْتُ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : وَالَّذِي نَفْسِي بِيَدِهِ ، لا يَظْلِمُ مُؤْمِنٌ مُؤْمِنًا ، فَلا يُعْطِيهِ مَظْلَمَتَهُ فِي الدُّنْيَا , إِلا انْتَقَمَ اللَّهُ لَهُ مِنْهُ يَوْمَ الْقِيَامَةِ , قَالَ : فَقَالَ أَبُو ذَرٍّ : يَا نَبِيَّ اللَّهُ , أَتَذْكُرُ لَيْلَةَ كُنْتُ أَقُودُ بِكَ الرَّاحِلَةَ ، فَإِذَا قُدْتُهَا أَبْطَأتْ ، وَإِذَا سُقْتُهَا اعْتَرَضَتْ ، وَأَنْتَ نَاعِسٌ عَلَيْهِا , فَخَفَقْتُ رَأْسَكَ بِالْمِخْفَقَةِ ، وَقُلْتُ : إِيَّاكَ ، إِيَّاكَ وَالْقَوْمَ , قَالَ : نَعَمْ , قَالَ : فَاسْتَقِدْ مِنِّي يَا رَسُولَ اللَّهِ , قَالَ : بَلْ أَعْفُو , قَالَ : بَلِ اسْتَقِدْ مِنِّي أَحَبُّ إِلَيَّ , قَالَ : فَضَرَبَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ضَرْبَةً بِالسَّوْطِ ، رَأَيْتُهُ يَتَضَوَّرُ مِنْهَا","","","","","Book of Blood Money (Diyat)"
"17455","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَقِي رَجُلا مُخْتَضِبًا بِصُفْرَةٍ ، وَفِي يَدِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ جَرِيدَةٌ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" حُطَّ وَرْسٌ "" , قَالَ : فَطَعَنَ بِالْجَرِيدَةِ فِي بَطْنِ الرَّجُلِ ، وَقَالَ : "" أَلَمْ أَنْهَكَ عَنْ هَذَا ؟ "" , قَالَ : فَأَثَّرَ فِي بَطْنِهِ ، وَمَا أَدْمَاهَا ، فَقَالَ الرَّجُلُ : الْقَوَدَ يَا رَسُولَ اللَّهِ ، فَقَالَ النَّاسُ : أَمِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ تَقْتَصُّ ؟ فَقَالَ : "" مَا بَشْرَةُ أَحَدٍ فَضَّلَ اللَّهُ عَلَى بَشْرَتِي "" , قَالَ : فَكَشَفَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ بَطْنِهِ ، ثُمَّ قَالَ : "" اقْتَصَّ "" , فَقَبَّلَ الرَّجُلُ بَطْنَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَقَالَ : أَدَعُهَا لَكَ تَشْفَعُ لِي بِهَا يَوْمَ الْقِيَامَةِ""","","","","","Book of Blood Money (Diyat)"
"17456","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ , قَالَ :  كَانَ رَجُلٌ مِنَ الأَنْصَارِ يُقَالُ لَهُ : سَوَادَةُ بْنُ عَمْرٍو يَتَخَلَّقُ كَأنَهُ عُرْجُونٌ ، وَكَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا رَآهُ يَعَضُّ لَهُ , قَالَ :فَجَاءَ يَوْمًا وَهُوَ مُتَخَلِّقٌ فَأَهْوَى لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِعُودٍ كَانَ فِي يَدِهِ فَجَرَحَهُ ، فَقَالَ : الْقِصَاصُ يَا رَسُولَ اللَّهِ ، فَأَعْطَاهُ الْعُودَ , وَكَانَ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَمِيصَانِ , قَالَ : فَجَعَلَ يَرْفَعُهُمَا , قَالَ : فَنَهَرَهُ النَّاسُ , قَالَ : فَكَشَفَ عَنْهُ حَتَّى انْتَهَى إِلَى الْمَكَانَ الَّذِي جَرَحَهُ فَرَمَى بِالْقَضِيبِ ، وَعَلِقَ يُقَبِّلُهُ ، وَقَالَ : يَا نَبِيَّ اللَّهُ , بَلْ أَدَعُهَا لَكَ تَشْفَعُ لِي بِهَا يَوْمَ الْقِيَامَةِ ""","","","","","Book of Blood Money (Diyat)"
"17457","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ , قَالَ : لَمَّا قَدْمَ عُمَرُ الشَّامَ جَاءَهُ رَجُلٌ يَسْتَأْدِي عَلَى بَعْضِ عُمَّالِهِ ، فَأَرَادَ أَنْ يُقِيدَهُ ، فَقَالَ لَهُ عَمْرُو بْنُ الْعَاصِ :  إِذَنْ لا يَعْمَلُ لَكَ "" , قَالَ : وَإِنْ , أَنَا لا أُقيدُهُ ؟ وَقَدْ رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : ""يُعْطِي الْقَوَدَ مِنْ نَفْسِهِ ""، قَالَ عَمْرٌو : فَهَلا غَيْرَ ذَلِكَ تُرْضِيهِ قَالَ : أَوْ أُرْضِيهِ""","","","","","Book of Blood Money (Diyat)"
"17458","أَخْبَرَنَا مَعْمَرٌ ، وَابْنُ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ , قَالَ : سَمِعْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ , يَقُولُ :  كُنَّا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي غَزَاةٍ ,فَكَسَعَ رَجُلٌ مِنَ الْمُهَاجِرِينَ رَجُلا مِنَ الأَنْصَارِ ، فَقَالَ الأَنْصَارِيُّ : يَا لَلأَنْصَارِ ! وَقَالَ الْمُهَاجِرِيُّ : يَا لَلْمُهَاجِرِينَ ! فَسَمِعَ ذَلِكَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" مَا بَالُ دَعْوَى الْجَاهِلِيَّةِ ؟ "" فَأَخْبَرُوهُ بِالَّذِي كَانَ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" دَعُوهَا فَإِنَّهَا مُنْتِنَةٌ "" , قَالَ : وَكَانَ الْمُهَاجِرُونَ لَمَّا قَدْمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْمَدِينَةَ أَقَلَّ مِنَ الأَنْصَارِ ، ثُمَّ إِنَّ الْمُهَاجِرِينَ كَثُرُوا بَعْدُ ، فَسَمِعَ بِذَلِكَ عَبْدُ اللَّهِ بْنُ أُبَيٍّ , قَالَ : قَدْ فَعَلُوهَا ؟ وَاللَّهُ لَئِنْ رَجَعْنَا إِلَى الْمَدِينَةِ لَيُخْرِجَنَّ الأَعَزُّ مِنْهَا الأَذَلَّ , قَالَ : فَقَالَ عُمَرُ : دَعْنِي يَا رَسُولَ اللَّهِ ، فَأَضْرِبْ عُنُقَ هَذَا الْمُنَافِقِ ، فَقَالَ : "" دَعْهُ , لا يَتَحَدَّثُ النَّاسُ أَنَّ مُحَمَّدًا يَقْتُلُ أَصْحَابَهُ ""","","","","","Book of Blood Money (Diyat)"
"17459","أَخْبَرَنَا مُحَمَّدُ بْنُ مُسْلِمٍ ، عَنْ يَزِيدَ بْنِ عَبْدِ اللَّهِ بْنِ أُسَامَةَ ، عَنْ سَعْدِ بْنِ إِبْرَاهِيمَ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَقَادَ مِنْ نَفْسِهِ ""، وَأَنَّ أَبَا بَكْرٍ رَضِي اللَّهُ عَنْهُ أَقَادَ رَجُلا مِنْ نَفْسِهِ ، وَأَنَّ عُمَرَ أَقَادَ سَعْدًا مِنْ نَفْسِهِ ""","","","","","Book of Blood Money (Diyat)"
"17460","عَنْ إِبْرَاهِيمَ بْنِ عُمَرَ , قَالَ : حَدَّثَنَا حَفْصُ بْنُ مَيْسَرَةَ , قَالَ : أَسْنَدَهُ لِي فَنَسِيتُ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خَرَجَ يَوْمًا عَاصِبًا رَأْسَهُ بِعِصَابَةٍ حَمْرَاءَ , مُتَّكِئًا ، أَوْ قَالَ : مُعْتَمِدًا عَلَى الْفَضْلِ بْنِ عَبَّاسٍ ، فَقَالَ :  الصَّلاةُ جَامِعَةٌ , فَاجْتَمَعَ النَّاسُ فَصَعِدَ الْمِنْبَرَ ، وَقَالَ : ""أَحْمَدُ إِلَيْكُمُ اللَّهُ الَّذِي لا إِلَهُ إِلا هُوَ ، وَقَدْ دَنَا مِنِّي حُقُوقٌ ، مِنْ بَيْنَ أَظْهُرِكُمْ ، فَمَنْ شَتَمْتُ لَهُ عِرْضًا , فَهَذَا عِرْضِي فَلْيَسْتَقِدْ مِنْهُ ، وَمَنْ ضَرَبْتُ لَهُ ظَهْرًا فَهَذَا ظَهْرِي فَلْيَسْتَقِدْ مِنْهُ ، وَمَنْ أَخَذْتُ لَهُ مَالا فَهَذَا مَالِي فَلْيَأْخُذْ مِنْهُ ، وَلا يَقُولَنَّ أَحَدُكُمْ : إِنِّي أَتَخَوَّفُ الشَّحْنَاءَ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , أَلا وَإِنَّهَا لَيْسَتْ مِنْ طَبِيعَتِي ، وَلا مِنْ خُلُقِي ، وَإِنَّ أَحَبَّكُمْ إِلَيَّ مَنْ أَخَذَ حَقًّا إِنْ كَانَ لَهُ ، أَوْ حَلَّلَنِي , فَلَقِيتُ رَبِّي ، وَأَنَا طَيِّبُ النَّفْسِ "" ، فَقَامَ رَجُلٌ فَقَالَ : أَنَا أَسْأَلُكَ ثَلاثَةَ دَرَاهِمَ ، فَقَالَ : "" مِنْ أَيْنَ ؟ "" , قَالَ : أَسْلَفْتُكُمْ يَوْمَ كَذَا وَكَذَا , فَأَمَرَ الْفَضْلَ بْنَ عَبَّاسٍ أَنْ يَقْضِيَهَا إِيَّاهُ""","","","","","Book of Blood Money (Diyat)"
"17461","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْعَزِيزِ بْنُ عُمَرَ ، عَنْ كِتَابٍ لِعُمَرَ بْنِ عَبْدِ الْعَزِيزِ فِيهِ : بَلَغَنَا أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :أَيُّمَا مُتَطَبِّبٍ لَمْ يَكُنْ بِالطِّبِّ مَعْرُوفًا ، يَتَطَبَّبُ عَلَى أَحَدٍ مِنَ الْمُسْلِمِينَ ، بِحَدِيدَةِ النمَاسِ الْمثالة ، فَأَصَابَ نَفْسًا فَمَا دُونَهَا , فَعَلَيْهِ دِيَةُ مَا أَصَابَ","","","","","Book of Blood Money (Diyat)"
"17462","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ ، عَنْ أَبِي مَلِيحِ بْنِ أُسَامَةَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ : ضَمِنَ رَجُلا كَانَ يَخْتِنُ الصِّبْيَانَ ، فَقَطَعَ مِنْ ذَكَرِ الصَّبِيِّ فَضَمَّنَهُ ""، قَالَ مَعْمَرٌ : وَسَمِعْتُ غَيْرَ أَيُّوبَ يَقُولُ : "" كَانَتِ امْرَأَةٌ تَخْفِضُ النِّسَاءَ فَأَعْنَقَتْ جَارِيَةً , فَضَمَّنَهَا عُمَرُ ""","","","","","Book of Blood Money (Diyat)"
"17463","عَنِ ابْنِ مُجَاهِدٍ ، عَنْ أَبِيهِ ، أَنَّ عَلِيًّا , قَالَ فِيالطَّبِيبِ :  إِنْ لَمْ يُشْهِدْ عَلَى مَا يُعَالِجُ ، فَلا يَلُومَنَّ إِلا نَفْسَهُ "" , يَقُولُ : "" يَضْمَنُ ""","","","","","Book of Blood Money (Diyat)"
"17464","عَنْ يَحْيَى بْنِ الْعَلاءِ ، عَنْ جُوَيْبِرٍ ، عَنِ الضَّحَّاكِ بْنِ مُزَاحِمٍ , قَالَ : خَطَبَ عَلِيٌّ النَّاسَ , فَقَالَ : يَا مَعْشَرَ الأَطِبَّاءِ , الْبَيَاطِرَةِ ، وَالْمُتَطَبِّبِينَ مَنْ عَالَجَ مِنْكُمْ إِنْسَانًا ، أَوْ دَابَّةً فَلْيَأْخُذْ لِنَفْسِهِ الْبَرَاءَةَ ، فَإِنَّهُ كَانَ عَالَجَ شَيْئًا ، وَلَمْ يَأْخُذْ لِنَفْسِهِ الْبَرَاءَةَ فَعَطَبَ فَهُوَ ضَامِنٌ ""","","","","","Book of Blood Money (Diyat)"
"17465","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : سُئِلَ عَنْرَجُلٍ أَنْعَلَ دَابَّةً فَعَنَّتَ ؟ قَالَ :  إِنْ كَانَ يَفْعَلُ فَلا شَيْءَ عَلَيْهِ ، وَإِنْ كَانَ إِنَّمَا تَكَلَّفَ لَيْسَ ذَلِكَ عَمَلَهُ فَقَدْ ضَمِنَ ""","","","","","Book of Blood Money (Diyat)"
"17466","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ :  فِيالطَّبِيبِ إِنْ عَمِلَ بِيَدِهِ عَمَلا فَلا ضَمَانَ عَلَيْهِ إِلا أَنْ يَتَعَدَّى ""","","","","","Book of Blood Money (Diyat)"
"17467","عَنِ الثَّوْرِيِّ ، عَنْ يُونُسَ ، وَجَابِرٍ ، عَنِ الشَّعْبِيِّ , قَالَ : لَيْسَ عَلَى الْمُدَاوِي ضَمَانٌ "" ، قَالَ يُونُسُ : عَنِ الشَّعْبِيِّ : "" وَلا عَلَى الْحَجَّامِ ضَمَانٌ ""","","","","","Book of Blood Money (Diyat)"
"17468","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يُونُسَ ، عَنْ أَبِي إِسْحَاقَ , 25 قَالَ : سَمِعْتُ الشَّعْبِيَّ , يَقُولُ : لَيْسَ عَلَى مُدَاوٍ , وَلا بَيْطَارٍ ، وَلا حَجَّامٍ , ضَمَانٌ ، وَمَنْ دَخَلَ دَارَ قَوْمٍ بِغَيْرِ إِذْنِهِمْ ، فَعَقَرَهُ كَلْبُهُمْ , فَلا ضَمَانَ عَلَيْهِمْ ، وَإِنْ دَخَلَ بِإِذْنِهِمْ ضَمِنُوا ، وَمَنِ اطَّلَعَ فِي دَارِ قَوْمٍ بِغَيْرِ إِذْنِهِمْ فَفَقَئُوا عَيْنَهُ فَلا شَيْءَ عَلَيْهِمْ ""","","","","","Book of Blood Money (Diyat)"
"17469","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الطَّبِيبُ يَبُطُّ الْجُرْحَ فَيَمُوتُ فِي يَدِهِ , قَالَ : لَيْسَ عَلَيْهِ عَقْلٌ "", وَعَمْرُو بْنُ دِينَارٍ""","","","","","Book of Blood Money (Diyat)"
"17470","عَنِ ابْنِ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى , قَالَ : مَنْ عَاقَبَ عُقُوبَةً فِي غَيْرِ إِسْرَافٍ فَلا دِيَةَ عَلَيْهِ ""","","","","","Book of Blood Money (Diyat)"
"17471","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : لا يُقَادُ الْعَبْدُ مِنَ الْحُرِّ "", قَالَ : وَقَالَ إِبْرَاهِيمُ : "" لا يَقْتَصُّ الْعَبْدُ مِنَ الْحُرِّ ""","","","","","Book of Blood Money (Diyat)"
"17472","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : قُلْتُ لَهُ : عَبْدٌ يَشُجُّ الْحُرَّ أَوْ يَفْقَأُ عَيْنَهُ , قَالَ : لا يَسْتَقِيدُ حُرٌّ مِنْ عَبْدٍ "", وَقَالَ ذَلِكَ مُجَاهِدٌ , وَسُلَيْمَانُ بْنُ مُوسَى""","","","","","Book of Blood Money (Diyat)"
"17473","عَنِ ابْنِ جُرَيْجٍ ، عَنْ رَجُلٍ ، عَنْ سَالِمِ بْنِ عَبْدِ اللَّهِ , قَالَ : لا يَسْتَقِيدُ الْعَبْدُ مِنَ الْحُرِّ ، وَلَكِنْ يَعْقِلُهُ إِنْ قَتَلَهُ أَوْ جَرَحَهُ ، وَعَقْلُ الْمَمْلُوكِ فِي ثَمَنِهِ , مِثْلُ عَقْلِ الْحُرِّ فِي دِيَتِهِ ""","","","","","Book of Blood Money (Diyat)"
"17474","عَنْ مَعْمَرٍ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , قَالَ : لَيْسَ بَيْنَ الْحُرِّ وَالْعَبْدِ قِصَاصٌ "", قَالَ مَعْمَرٌ : وَقَالَهُ الزُّهْرِيُّ""","","","","","Book of Blood Money (Diyat)"
"17475","عَنْ مَعْمَرٍ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , قَالَ : لَوْ صَكَّ حُرٌّ عَبْدًا ، أَوْ عَبْدٌ حُرًّا , أُرْضِي بَيْنَهُمَا بِصُلْحٍ ، وَلا قِصَاصَ بَيْنَهُمَا ""","","","","","Book of Blood Money (Diyat)"
"17476","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , قَالَ : لا يُقَادُ الْعَبْدُ ، وَلا الذِّمِّيُّ مِنَ الْحُرِّ الْمُسْلِمِ "", عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"17477","عَنْ أَبِي حَنِيفَةَ , عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : لَيْسَ بَيْنَ الأَحْرَارِ ، وَالْعَبِيدِ قِصَاصٌ إِلا فِي النَّفْسِ ""","","","","","Book of Blood Money (Diyat)"
"17478","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ , قَالَ : لا يُقَادُ الْعَبْدُ مِنَ الْحُرِّ ، وَتُقَادُ الْمَرْأَةُ مِنَ الرَّجُلِ فِي كُلِّ عَمَدٍ يَبْلُغُ نَفْسًا ، فَمَا دُونَهَا مِنَ الْجِرَاحِ ""","","","","","Book of Blood Money (Diyat)"
"17479","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي إِبْرَاهِيمُ بْنُ مَيْسَرَةَ , أَنَّهُ كَانَ بَيْنَ نَاسٍ مِنْ أَهْلِهِ وَبَيْنَ السَّهْمِيِّينَ أَنْأَصَابَ غُلامٌ لَمْ يَحْتَلِمْ سِنَّ رَجُلٍ , فَأَبَى إِلا أَنْ يُقَادَ مِنْهُ ، فَكَتَبَ فِي ذَلِكَ عُثْمَانُ بْنُ رَبِيعَةَ إِلَى عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، وَهُوَ يَلِي الْمَدِينَةَ , فَكَتَبَ أَنْ :  لا يُقَادَ مِنْهُ ""","","","","","Book of Blood Money (Diyat)"
"17480","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْعَزِيزِ بْنُ عُمَرَ ، أَنَّ فِي كِتَابٍ لِعُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ أَنَّهُ : لا قَوَدَ ، وَلا قِصَاصَ فِي جِرَاحٍ ، وَلا قَتْلَ ، وَلا حَدَّ وَلا نَكَالَ عَلَى مَنْ لَمْ يَبْلُغِ الْحُلُمَ , حَتَّى يَعْلَمَ مَا لَهُ فِي الإِسْلامِ وَمَا عَلَيْهِ ""","","","","","Book of Blood Money (Diyat)"
"17481","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , فِيالصَّبِيِّ ضَرَبَ رَجُلا بِالسَّيْفِ فَقَتَلَهُ ، فَطَلَبَ الصَّبِيَّ فَامْتَنَعَ بِسَيْفِهِ , فَقَتَلَهُ رَجُلٌ ، فَقَالَ :  مَضَتِ السُّنَّةُ أَنَّ عَمَدَ الصَّبِيِّ خَطَأٌ ، وَمَنْ قَتَلَ صَبِيًّا لَمْ يَبْلُغِ الْحُلُمَ أَقَدْنَاهُ بِهِ ""، قَالَ مَعْمَرٌ : فَلَمْ يُعْجِبْنِي مَا قَالَ الزُّهْرِيُّ , قَالَ مَعْمَرٌ : "" اجْعَلْ عَلَى قَاتَلِهِ دِيَةً لأَهْلِ الصَّبِيِّ ، وَعَلَى عَاقِلَةِ الصَّبِيِّ دِيَةٌ لأَهْلِ الْمَقْتُولِ ""","","","","","Book of Blood Money (Diyat)"
"17482","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : عَمَدُ الصَّبِيِّ خَطَأٌ ""، قَالَ سُفْيَانُ : "" لا تُقَامُ الْحُدُودُ إِلا عَلَى مَنْ بَلَغَ الْحُلُمَ "" , جَاءَتْ بِهِ الأَحَادِيثُ""","","","","","Book of Blood Money (Diyat)"
"17483","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : مَضَتِ السُّنَّةُ أَنَّ عَمَدَ الصَّبِيِّ خَطَأٌ ""","","","","","Book of Blood Money (Diyat)"
"17484","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ أَبِي مُلَيْكَةَ : أَنَّسِتَّةَ رِجَالٍ وَامْرَأَةً قَتَلُوا رَجُلا بِصَنْعَاءَ ، فَكَتَبَ فِيهِمْ يَعْلَى إِلَى عُمَرَ ، فَكَتَبَ فِيهِمْ عُمَرُ  : أَنِ اقْتُلْهُمْ جَمِيعًا ، فَلَوْ قَتَلَهُ أَهْلُ صَنْعَاءَ جَمِيعًا قَتَلْتُهُمْ ""","","","","","Book of Blood Money (Diyat)"
"17485","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عُمَرُ ، أَنَّ حَيَّ بْنَ يَعْلَى أَخْبَرَهُ , أَنَّهُ سَمِعَ يَعْلَى يُخْبِرُ ، أَنَّهُ كَتَبَ إِلَى عُمَرَ فِيرَجُلٍ وَامْرَأَةٍ قَتْلا رَجُلا ، فَكَتَبَ إِلَيْهِ :  أَنِ اقْتُلْهُمَا , فَلَوِ اشْتَرَكَ فِي دَمِهَ أَهْلُ صَنْعَاءَ جَمِيعًا قَتَلْتُهُمْ ""","","","","","Book of Blood Money (Diyat)"
"17486","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : كَانَ عُمَرُ بْنُ الْخَطَّابِ ، يَقُولُ  فِيالنَّفْرِ يَقْتُلُونَ الرَّجُلَ جَمِيعًا : يُقْتَلُونَ بِهِ ""","","","","","Book of Blood Money (Diyat)"
"17487","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : يُقْتَلُ الرَّجُلانِ بِالرَّجُلِ ""","","","","","Book of Blood Money (Diyat)"
"17488","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ : أَقَادَ الرَّجُلَ بِثَلاثَةٍ مِنْ صَنْعَاءَ ، وَقَالَ : "" لَوْ تَمَالأَ عَلَيْهِ أَهْلُ صَنْعَاءَ قَتَلْتُهُمْ ""، قَالَ الزُّهْرِيُّ : "" ثُمَّ مَضَتِ السُّنَّةُ بَعْدَ ذَلِكَ أَلا يُقْتَلُ إِلا وَاحِدٌ ""","","","","","Book of Blood Money (Diyat)"
"17489","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ , قَالَ : قَتَلَ عُمَرُ سَبْعَةً بِوَاحِدٍ بِصَنْعَاءَ ""","","","","","Book of Blood Money (Diyat)"
"17490","عَنِ الثَّوْرِيِّ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : رُفِعَ إِلَى عُمَرَسَبْعَةُ نَفَرٍ قَتَلُوا رَجُلا بِصَنْعَاءَ , قَالَ : فَقَتَلَهُمْ بِهِ , وَقَالَ :  لَوْ تَمَالأَ عَلَيْهِ أَهْلُ صَنْعَاءَ قَتَلْتُهُمْ بِهِ "", قَالَ : وَأَخْبَرَنِي مَنْصُورٌ ، عَنْ إِبْرَاهِيمَ ، عَنْ عُمَرَ مِثْلَهُ ، قَالَ سُفْيَانُ : وَبِهِ نَأْخُذُ""","","","","","Book of Blood Money (Diyat)"
"17491","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ عُبَيْدِ اللَّهِ بْنِ أَبِي مُلَيْكَةَ : أَنَّامْرَأَةً كَانَتْ بِالْيَمَنِ لَهَا سِتَّةُ أَخِلاءَ , فَقَالَتْ : لا تَسْتَطِيعُونَ ذَلِكَ مِنْهَا حَتَّى تَقْتُلُوا ابْنَ بَعْلِهَا ، فَقَالُوا : أَمْسِكِيهِ لَنَا عِنْدَكِ ، فَأَمْسَكَتْهُ , فَقَتَلُوهُ عِنْدَهَا وَأَلْقَوْهُ فِي بِئْرٍ , فَدَلَّ عَلَيْهِ الذِّبَّانُ , فَاسْتَخْرَجُوهُ ، فَاعْتَرَفُوا بِقَتْلِهِ ، فَكَتَبَ يَعْلَى بْنُ أُمَيَّةَ بِشَأْنِهِمْ هَكَذَا إِلَى عُمَرَ بْنِ الْخَطَّابِ ، فَكَتَبَ عُمَرُ  أَنِ اقْتُلْهُمُ , الْمَرْأَةَ وَإِيَّاهُمْ , فَلَوْ قَتَلَهُ أَهْلُ صَنْعَاءَ أَجْمَعُونَ قَتَلْتُهُمْ بِهِ ""","","","","","Book of Blood Money (Diyat)"
"17492","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرٌو ، أَنَّ حَيَّ بْنَ يَعْلَى أَخْبَرَهُ ، أَنَّهُ سَمِعَ يَعْلَى يُخْبِرُ بِهَذَا الْخَبَرِ ، قَالَ : اسْمُ الْمَقْتُولِ أَصِيلٌ ، وَأَلْقَوْهُ فِي بِئْرٍ بِغَمَدَانَ , فَدَلَّ عَلَيْهِ الذِّبَّانُ الأَخْضَرُ ، فَطَافَتِ امْرَأَةُ أَبِيهِ عَلَى حِمَارٍ بِصَنْعَاءَ أَيَّامًا ، تَقُولُ : اللَّهُمَّ لا تُخْفِي عَلَى مَنْ قَتَلَ أَصِيلا ، قَالَ عُمَرُ : إِنَّ يَعْلَى كَانَ يَقُولُ : كَانَ لَهَا خَلِيلٌ وَاحِدٌ , فَقَتَلَهُ هُوَ وَامْرَأَةُ أَبِيهِ ، فَقَالَ حَيٌّ : سَمِعْتُ يَعْلَى يَقُولُ : كَتَبَ إِلَيَّ عُمَرَ : "" أَنِ اقْتُلْهُمْ , فَلَوِ اشْتَرَكَ فِي دَمِّهِ أَهْلُ صَنْعَاءَ أَجْمَعُونَ قَتَلْتُهُمْ ""، قَالَ ابْنُ جُرَيْجٍ : وَأَخْبَرَنِي عَبْدُ الْكَرِيمِ , أَنَّ عُمَرَ كَانَ يَشُكُّ فِيهِا , حَتَّى قَالَ لَهُ عَلِيٌّ : "" يَا أَمِيرَ الْمُؤْمِنِينَ , أَرَأَيْتَ لَوْ أَنَّ نَفَرًا اشْتَرَكُوا فِي سَرَقَةِ جَزُورٍ فَأَخَذَ هَذَا عُضْوًا ، وَهَذَا عُضْوًا , أَكُنْتَ قَاطِعَهُمْ ؟ "" , قَالَ : "" نَعَمْ "" , قَالَ : فَذَلِكَ حِينَ اسْتَمْدَحَ لَهُ الرَّأْيُ , قَالَ ابْنُ جُرَيْجٍ : وَأَخْبَرَنِي أَبُو بَكْرٍ , بِمِثْلِ خَبَرِ عَبْدِ الْكَرِيمِ , عَنْ عَلِيٍّ""","","","","","Book of Blood Money (Diyat)"
"17493","عَنْ مَعْمَرٍ , قَالَ : أَخْبَرَنِي زِيَادِ بْنِ جَبَلٍ ، عَمَّنْ شَهِدَ ذَلِكَ , قَالَ : كَانَتِامْرَأَةٌ بِصَنْعَاءَ لَهَا رَبِيبٌ , فَغَابَ زَوْجُهَا ، وَكَانَ رَبِيبُهَا عِنْدَهَا , وَكَانَ لَهَا خَلِيلٌ ، فَقَالَتْ : إِنَّ هَذَا الْغُلامَ فَاضِحُنَا ، فَانْظُرُوا كَيْفَ تَصْنَعُونَ بِهِ , فَتَمَالُوا عَلَيْهِ وَهُمْ سَبْعَةٌ مَعَ الْمَرْأَةِ , قَالَ : قُلْتُ لَهُ : كَيْفَ تَمَالُوا عَلَيْهِ ؟ قَالَ : لا أَدْرِي , غَيْرَ أَنَّ أَحَدَهُمْ قَدْ أُعْطِيَ شَفْرَةٌ , قَالَ : فَقَتَلُوهُ وَأَلْقَوْهُ فِي بِئْرٍ بِغَمَدَانَ , قَالَ : تَفْقِدُ الْغُلامَ , قَالَ : فَخَرَجَتِ امْرَأَةُ أَبِيهِ تَطُوفُ عَلَى حِمَارٍ ، وَهِيَ الَّتِي قَتَلَتْهُ مَعَ الْقَوْمِ ، وَهِيَ تَقُولُ : اللَّهُمَّ لا تُخْفِي دَمَ أَصِيلٍ , قَالَ : وَخَطَبَ يَعْلَى النَّاسَ ، فَقَالَ : انْظُرُوا هَلْ تَحِسُّونَ هَذَا الْغُلامَ أَوْ يَذْكُرُ لَكُمْ , قَالَ : فَيَمُرُّ رَجُلٌ بِبِئْرِ غَمَدَانَ بَعْدَ أَيَّامٍ ، فَإِذَا هُوَ بِذُبِابٍ أَخْضَرَ يَطْلُعُ مَرَّةً مِنَ الْبِئْرِ ، وَيَهْبِطُ أُخْرَى ، فَأَشْرَفَ عَلَى الْبِئْرِ فَوَجَدَ رِيحًا أَنْكَرَهَا ، فَأَتَى يَعْلَى ، فَقَالَ : مَا أَظُنُّ إِلا أَنِّي قَدْ قَدَرْتُ لَكُمْ عَلَى صَاحِبِكُمْ , قَالَ : وَأَخْبَرَهُ الْخَبَرَ , قَالَ : فَخَرَجَ يَعْلَى حَتَّى وَقَفَ عَلَى الْبِئْرِ وَالنَّاسُ مَعَهُ , قَالَ : فَقَالَ الرَّجُلُ الَّذِي قَتَلَهُ صَدِيقُ الْمَرْأَةِ : دَلُّونِي بِحَبْلٍ , قَالَ : فَدَلُّوهُ فَأَخَذَ الْغُلامَ فَغَيَّبَهُ فِي سِرْبٍ فِي الْبِئْرِ ، ثُمَّ قَالَ : ارْفَعُونِي , فَرَفَعُوهُ ، فَقَالَ : لَمْ أَقْدِرْ عَلَى شَيْءٍ ، فَقَالَ الْقَوْمُ : الآنَ الرِّيحُ مِنْهَا أَشَدُّ مِنْ حِينَ جِئْنَا ، فَقَالَ رَجُلٌ آخَرُ : دَلُّونِي , فَلَمَّا أَرَادُوا أَنْ يُدَلُّوهُ أَخَذَتِ الآخَرَ رِعْدَةٌ , فَاسْتَوْثَقُوا مِنْهُ وَدَلُّوا صَاحِبَهُمْ , فَلَمَّا هَبَطَ فِيهَا اسْتَخْرَجَهُ إِلَيْهِمْ ، ثُمَّ خَرَجَ ، فَاعْتَرَفَ الرَّجُلُ خَلِيلُ الْمَرْأَةِ ، وَاعْتَرَفْتِ الْمَرْأَةُ ، وَاعْتَرَفُوا كُلُهُمْ ، فَكَتَبَ يَعْلَى إِلَى عُمَرَ ، فَكَتَبَ إِلَيْهِ  أَنِ اقْتُلْهُمْ ، فَلَوْ تَمَالأَ بِهِ أَهْلُ صَنْعَاءَ قَتَلْتُهُمْ "", قَالَ : فَقَتَلَ السَّبْعَةَ""","","","","","Book of Blood Money (Diyat)"
"17494","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرِ ، عَنِ الْحَكَمِ ، عَنْ إِبْرَاهِيمَ فِيالنَّفْرِ يَقْتُلُونَ الرَّجُلَ , قَالَ :  يَقْتُلُ أَوْلِيَاؤُهُ مِنْ شَاءُوا ، وَيَعْفُونَ عَمَّنْ شَاءُوا ، وَيَأْخُذُونَ الدِّيَةَ مِمَّنْ شَاءُوا "", عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"17495","عَنْ إِبْرَاهِيمَ ، عَنْ دَاوُدَ بْنِ الْحُصَيْنِ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : لَوْ أَنَّ مِائَةً قَتَلُوا رَجُلا , قُتِلُوا بِهِ ""","","","","","Book of Blood Money (Diyat)"
"17496","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : لا يُقْتَلُ رَجُلانِ بِرَجُلٍ ، وَلا تُقْطَعُ يَدَانِ بِيَدٍ ""، قَالَ سُفْيَانُ فِي قَوْمٍ قَطَعُوا رَجُلا , قَالَ : "" لا يُقَادُ مِنْهُمْ ، وَتَكُونُ الدِّيَةُ عَلَيْهِمْ جَمِيعًا ""","","","","","Book of Blood Money (Diyat)"
"17497","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : إِذَا قَتَلَ النَّفْرُ أَحَدًا اخْتَارُوا أَيَّهُمْ شَاءُوا "", قَالَ : وَقَالَهُ غَيْرُهُ أَيْضًا""","","","","","Book of Blood Money (Diyat)"
"17498","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ , قَالَ :  كَانَ ابْنُ الزُّبَيْرِ , وَعَبْدُ الْمَلِكِ ,لا يَقْتُلانِ مِنْهُمْ إِلا رَجُلا وَاحِدًا ، وَمَا عَلِمْتُ أَحَدًا قَتَلَهُمْ جَمِيعًا ، إِلا مَا قَالُوا فِي عُمَرَ ""","","","","","Book of Blood Money (Diyat)"
"17499","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرِّحْمَنِ ، قَالَ ،  فِيرَجُلٍ قَتَلَ ثَلاثَةً : أَيُقْتَلُ بِهِمْ ؟ قَالَ مَعْمَرٌ : نَعَمْ ""، وَقَالَهُ الْحَسَنُ , وَقَتَادَةُ""","","","","","Book of Blood Money (Diyat)"
"17500","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الرَّجُلُ قَتَلَ رَجُلَيْنِ حُرَّيْنِ , قَالَ : "" هُوَ بِهِمَا قَطُّ ""","","","","","Book of Blood Money (Diyat)"
"17501","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ أَبِي سَلَمَةَ ،  فِيرَجُلَيْنِ قَتْلا رَجُلا , قَالَ : "" هُمَا بِهِ ""","","","","","Book of Blood Money (Diyat)"
"17502","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، عَنْ عَلِيٍّ فِيرَجُلٍ قَتَلَ رَجُلا وَحَبَسَهُ آخَرُ , قَالَ :  يُقْتَلُ الْقَاتِلُ ، وَيُحْبَسُ الآخَرُ فِي السِّجْنِ حَتَّى يَمُوتَ "", عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، أَنَّ عَلِيًّا ، قَضَى بِمِثْلِهِ""","","","","","Book of Blood Money (Diyat)"
"17503","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :رَجُلٌ أَمْسَكَ رَجُلا لآخَرَ حَتَّى قَتَلَهُ , قَالَ : ذَكَرُوا أَنَّ عَلِيًّا كَانَ يَقُولُ :  يُمْسَكُ الْمُمْسِكُ فِي السِّجْنِ حَتَّى يَمُوتَ ، وَيُقْتَلُ الآخَرُ ""، قُلْتُ لِعَطَاءٍ : إِنْ بَلَغَ مِنْهُ شَيْئًا دُونَ نَفْسِهِ , أَيُمْسَكُ الْمُمْسِكُ فِي السِّجْنِ حَتَّى يَمُوتَ ؟ قَالَ : "" لا يُقَادُ مِنَ السَّاطِي , وَيُعَاقَبُ الْمُمْسِكُ ، وَلا يُقَادُ مِنْهُ "" ، قُلْتُ : فَإِنْ قَتَلَهُ قَتْلا ؟ قَالَ : "" فَلا أَرَى أَنْ يُقْتَلَ الْمُمْسِكُ أَيْضًا "" , قَالَ : قُلْتُ لَهُ : لِمَ يُمْسِكْهُ ، وَلَمْ يَدُلَّ عَلَيْهِ ، وَلَكِنَّهُ مَشَى مَعَ الْقَاتِلِ , فَذَهَبَ وَتَكَلَّمَ ، وَمَنْعَهُ مِنْ ضَرْبٍ أُرِيدَ بِهِ ؟ قَالَ : "" لا يُقْتَلُ ""","","","","","Book of Blood Money (Diyat)"
"17504","عَنْ مَعْمَرٍ ، وَابْنِ جُرَيْجٍ ، عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ , قَالَ : أُخْبِرْتُ خَبَرًا ، قَدْ سَمِعْتُهُ وَأُثْبِتْهُ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :يُحْبَسُ الصَّابِرُ لِلْمَوْتِ كَمَا حَبَسَ ، وَيُقْتَلُ الْقَاتِلُ","","","","","Book of Blood Money (Diyat)"
"17505","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , فِيقَوْمٍ اجْتَمَعُوا عَلَى رَجُلٍ , فَأَمْسَكَهُ بَعْضُهُمْ ، وَفَقَأَ عَيْنَهُ بَعْضُهُمْ , قَالَ :  تُفْقَأُ عَيْنُ الَّذِي فَقَأَ عَيْنَهُ ، وَيُعَاقَبُ الآخَرُونَ عُقُوبَةً مُوجِعَةً مُنَكِّلَةً ، فَإِنْ أَحَبَّ الدِّيَةَ فَهِيَ عَلَيْهِمْ جَمِيعًا ""","","","","","Book of Blood Money (Diyat)"
"17506","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ , فِيالنَّفْرِ يَقْتُلُونَ الرَّجُلَ خَطَأً , قَالَ :  عَلَى كُلِّ وَاحِدٍ مِنْهُمْ كَفَّارَةٌ "", عَنِ الثَّوْرِيِّ ، عَنْ يُونُسَ ، عَنِ الْحَسَنِ مِثْلَهُ , عَنِ الثَّوْرِيِّ ، عَنْ أَشْعَثَ ، عَنِ الْحَكَمِ ، عَنْ إِبْرَاهِيمَ مِثْلَهُ , عَنْ مَعْمَرٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنِ الْحَكَمِ ، عَنْ إِبْرَاهِيمَ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"17507","عَنِ الثَّوْرِيِّ ، عَنْ أَشْعَثَ ، عَنِ الْحَكَمِ ، عَنِ ابْنِ شُبْرُمَةَ ، عَنِ الْحَارِثِ الْعُكْلِيِّ ، قَالَ : عَلَى كُلِّ وَاحِدٍ مِنْهُمْ كَفَّارَةٌ "", عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ عِكْرِمَةَ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"17508","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ نُصَيْرٍ ، وَالصَّلْتُ : أَنَّ رَجُلا بِالْبَصْرَةِ رَأَى إِنْسَانًا , فَظَنَّ أَنَّهُ كَلْبٌ , فَرَجَمَهُ فَقَتَلَهُ ، فَإِذَا هُوَ إِنْسَانٌ , فَلَمْ يَدْرِ النَّاسُ مَنْ قَتَلَهُ ، فَجَاءَ عَدِيُّ بْنُ أَرْطَاةَ فَأَخْبَرَهُ أَنَّهُ قَتَلَهُ , فَسَجَنَهُ ، وَكَتَبَ فِيهِ إِلَى عُمَرَ بْنِ عَبْدِ الْعَزِيزِ , فَكَتَبَ عُمَرُ :  إِنَّكَبِئْسَ مَا صَنَعْتَ حِينَ سَجَنْتَ ، وَقَدْ جَاءَ مِنْ قِبَلِ نَفْسِهِ ، فَأَخْبَرَكَ أَنَّهُ قَاتَلَهُ , فَخَلِّ سَبِيلَهُ ، وَاجْعَلْ دِيَتَهُ عَلَى الْعَشِيرَةِ "", وَزَعَمَ الصَّلْتُ أَنَّهُمَا مِنَ الأَسَدِ ، الْقَاتِلَ وَالْمَقْتُولَ ، وَأَنَّ الْمَقْتُولَ كَانَ عَاسًّا يَعُسُّ""","","","","","Book of Blood Money (Diyat)"
"17509","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ بَعْضَ أَصْحَابِنَا يَذْكُرُ ، أَنَّ الْحَارِثَ بْنَ أَبِي رَبِيعَةَ  أُسْتِشِيرَ فِيرَجُلٍ دَعَا امْرَأَتَهِ إِلَى أَنْ تَقْعُدَ عَلَى ذَكَرِهِ ، فَفَتَقَتْهُ ، فَقَضَى عَلَيْهِ الدِّيَةَ بَيْنَهُمَا بِشَطْرَيْنِ ""","","","","","Book of Blood Money (Diyat)"
"17510","عَنِ الثَّوْرِيِّ ، عَنْ عِيسَى بْنِ أَبِي عَزَّةَ ، عَنِ الشَّعْبِيِّ , قَالَ : سَأَلَهُ ابْنُ أَشْوَعَ عَنْ رَجُلٍ أَبْرَكَ امْرَأَتَهُ , فَجَامَعَهَا وَكَسَرَ ثَنِيَّتَهَا , قَالَ الشَّعْبِيُّ : "" يَغْرَمُ ""","","","","","Book of Blood Money (Diyat)"
"17511","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , فِيرَجُلٍ تَزَوَّجَ جَارِيَةً , فَدَخَلَ عَلَيْهَا سِرًّا مِنْ أَهْلِهَا ، فَأَفْزَعَهَا فَمَاتَتْ , قَالَ :  عَلَيْهِ دِيَتُهَا بِوُقُوعِهِ عَلَيْهِا قَبْلَ أَنْ تُطِيقَ ""","","","","","Book of Blood Money (Diyat)"
"17512","عَنِ ابْنِ جُرَيْجٍ ، عَنْ رَجُلٍ ، عَنْ مَكْحُولٍ , قَالَ : إِنْ قَتَلَ حُرٌّ وَعَبْدٌ حُرًّا خَطَأً فَدِيَتُهُ مِنْ حِسَابِ ثَمَنِ الْعَبْدِ ، وَحِصَّةِ الْحُرِّ فِي دِيَتِهِ ""","","","","","Book of Blood Money (Diyat)"
"17513","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :حُرٌّ وَعَبْدٌ قَتْلا حُرًّا عَمْدًا , قَالَ :  الْحُرُّ يُقْتَلُ بِهِ ، وَالْعَبْدُ لأَهْلِهِ ""","","","","","Book of Blood Money (Diyat)"
"17514","عَنْ أَبِي حَنِيفَةَ , عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , فِيحُرٍّ وَعَبْدٍ قَتْلا رَجُلا عَمْدًا , قَالَ : يُقْتَلانِ بِهِ، قَالَ سُفْيَانُ :  يُقْتَلانِ بِهِ إِذَا كَانَ عَمْدًا ، فَإِنْ كَانَ خَطَأً أُخِذَ الْعَبْدُ بِرُمَّتِهِ ، وَعَلَى الْحُرِّ نِصْفُ الدِّيَةِ ، إِلا أَنْ يسامُوا إِلَى الْعَبْدِ أَنْ يَفْدُوهُ ""","","","","","Book of Blood Money (Diyat)"
"17515","عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ , فِيحُرٍّ وَعَبْدٍ قَتْلا حُرًّا , قَالَ :  الدِّيَةُ عَلَى الْحُرِّ ، إِلا مَا بَلَغَ ثَمَنَ الْعَبْدِ "", قَالَ : وَقَالَ غَيْرُ مُجَاهِدٍ : "" هُوَ بَيْنَهُمَا شَطْرَيْنِ ""","","","","","Book of Blood Money (Diyat)"
"17516","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : إِنْ شَاءُوا قَتَلُوا الْحُرَّ ، وَاسْتَرَقُّوا الْعَبْدَ ، وَإِنْ شَاءُوا قَتَلُوهُمَا جَمِيعًا ، وَإِنْ شَاءُوا عَفَوْا عَنْ وَاحِدٍ ، وَقَتَلُوا الآخَرَ ""","","","","","Book of Blood Money (Diyat)"
"17517","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , فِيحُرٍّ قَتَلَهُ حُرٌّ وَعَبْدٌ , قَالَ :  يُقْتَلُ الْحُرُّ ، وَإِنْ شَاءَ أَهْلُ الْقَتِيلِ قَتَلُوا الْعَبْدَ ، وَإِنْ شَاءُوا اسْتَخْدَمُوهُ ""","","","","","Book of Blood Money (Diyat)"
"17518","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَبُو فَرْوَةَ ، عَنْ أَبِيهِ , أَنَّ نَاسًا كَانُوايَسْقُونَ ظَهْرًا فِي فَجٍّ مِنْ فِجَاجِ مَكَّةَ ، فَأَصَابَ الظَّهْرُ رَجُلَيْنِ , عَبْدًا وَحُرًّا , فَقَضَى عَبْدُ الْمَلِكِ  بِدِيَتِهِ بَيْنَهُمْ بِالْحِصَصِ ثَمَنُ الْعَبْدِ وَالْحُرِّ عَلَى ثَمَنِ الْعَبْدِ وَدِيَةِ الْحُرِّ ""","","","","","Book of Blood Money (Diyat)"
"17519","عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ , فِيعَبْدٍ قَتَلَ حُرًّا خَطَأً , قَالَ :  إِنْ شَاءَ أَهْلُ الْعَبْدِ أَسْلَمُوا الْعَبْدَ بِجَرِيرَتِهِ ، وَإِنْ شَاءُوا فَدَوْهُ بِدِيَةِ الْحُرِّ ""عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"17520","قَالَ قَتَادَةُ وَإِنْ كَانَ عَمْدًا فَأَهَلُ الْمَقْتُولِ أَحَقُّ بِالْعَبْدِ , إِنْ شَاءُوا قَتَلُوهُ ، وَإِنْ شَاءُوا اسْتَرَقُّوهُ ""","","","","","Book of Blood Money (Diyat)"
"17521","عَنْ مَعْمَرٍ ، أَنَّهُ بَلَغَهُ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ , قَالَ : إِنْ شَاءَ سَيِّدُهُ فَدَاهُ بِثَمَنِ الْعَبْدِ ""","","","","","Book of Blood Money (Diyat)"
"17522","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ ، قَالا : الْعَبِيدُ سُنَّتُهُمْ سُنَّةُ الأَحْرَارِ فِي الْقَوَدِ ""","","","","","Book of Blood Money (Diyat)"
"17523","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :عَبْدٌ قَتَلَ حُرًّا عَمْدًا , قَالَ :  فَالْعَبْدُ لَهُمْ "" ، قُلْتُ : فَأَرَادَ سَيِّدُ الْعَبْدِ أَنْ يُعْطِيَ الدِّيَةَ وَيَفْدِيَ عَبْدَهُ ، وَأَبَى أَهْلُ الْحُرِّ إِلا الْعَبْدَ , قَالَ : "" هُمْ أَحَقُّ بِهِ , هُوَ لَهُمْ , أَبَى إِلا ذَلِكَ "" ، قُلْتُ : فَإِنْ أَرَادُوا بَعْدُ أَنْ يُسَلِّمَ إِلَيْهِمْ قَتْلَهُ ؟ قَالَ : "" يَقْتُلُونَهُ إِنْ شَاءُوا "" ، فَقُلْتُ : يُقْتَلُ عَبْدٌ بِحُرٍّ ؟ قَالَ : "" يُكْرَهُ ذَلِكَ ""","","","","","Book of Blood Money (Diyat)"
"17524","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : عَبْدٌ فَقَأَ عَيْنَ حُرٍّ ، أَفَتَسْتَحِبُّ أَنْ يَسْتَقِيدَهُ ؟ قَالَ : لا ""","","","","","Book of Blood Money (Diyat)"
"17525","عَنِ الثَّوْرِيِّ ، عَنْ طَارِقٍ ، عَنِ الشَّعْبِيِّ , قَالَ : جِنَايَةُ الْعَبْدِ فِي رَقَبَتِهِ ، إِنْ شَاءَ مَوَالِيهِ أَسْلَمُوهُ بِجِنَايَتِهِ ، وَإِنْ شَاءُوا غَرَمُوا عَنْهُ ""","","","","","Book of Blood Money (Diyat)"
"17526","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، قَالَ فِيمَمْلُوكٍ قَتَلَ رَجُلا , قَالَ :  إِنْ شَاءَ أَوْلِيَاءُ الْمَقْتُولِ اسْتَرَقُّوا الْعَبْدَ "", قَالَ : وَقَالَ إِبْرَاهِيمُ : "" لَيْسَ لَهُمْ إِلا الْقَوَدُ ، أَوِ الْعَفْوُ "" ، وَبِهِ يَأْخُذُ سُفْيَانُ بِقَوْلِ إِبْرَاهِيمَ ، وَقَالَ ابْنُ جُرَيْجٍ , عَنْ عَطَاءٍ ، مِثْلَ قَوْلِ الشَّعْبِيِّ""","","","","","Book of Blood Money (Diyat)"
"17527","سَمِعْتُ أَبَا حَنِيفَةَ ، يُسْأَلُ عَنْ عَبْدٍ أَبَقَ ، فَقَتَلَ رَجُلا خَطَأً ، فَقَالَ أَخْبَرَنِي حَمَّادٌ ، عَنْ إِبْرَاهِيمَ , قَالَ : يُدْفَعُ إِلَى أَوْلِيَاءِ الْمَقْتُولِ ، فَإِنْ شَاءُوا قَتَلُوهُ ، وَإِنْ شَاءُوا عَفَوْا عَنْهُ ، فَإِنْ عَفَوْا عَنْهُ ، فَهُوَ لِسِادَتِهِ الأَوَّلِينَ ، لَيْسَ لأَهْلِ الْمَقْتُولِ أَنْ يَسْتَرِقُّوهُ ""","","","","","Book of Blood Money (Diyat)"
"17528","عَنْ إِبْرَاهِيمَ ، عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ ، عَنْ أَبِيهِ ، عَنْ عَلِيٍّ ، قَالَ : إِنْ شَاءُوا اسْتَرَقُّوهُ ""","","","","","Book of Blood Money (Diyat)"
"17529","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :عَبِيدٌ قَتَلُوا حُرًّا عَمْدًا , أَسُنَّتُهُمْ سُنَّةُ الأَحْرَارِ يَقْتُلُونَ الْحُرَّ عَمْدًا ؟ قَالَ :  مَا أَرَى إِلا أَنَّهُمْ لأَهْلِهِ , مِنْ أَجْلِ أَنَّهُمْ مَالٌ ، لَيْسُوا كَهَيْئَةِ الأَحْرَارِ قَتَلُوا حُرًّا ""","","","","","Book of Blood Money (Diyat)"
"17530","قَالَ ابْنُ جُرَيْجٍ : وَقَالَ لِي عَمْرُو بْنُ دِينَارٍ : مَا أَرَى الْعَبِيدَ يَقْتُلُونَ الْحُرَّ عَمْدًا ، إِلا كَأَمْرِ الأَحْرَارِ يَقْتُلُونَ الْحُرَّ عَمْدًا لَهُمْ أَحَدُهُمْ ""","","","","","Book of Blood Money (Diyat)"
"17531","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : حُرٌّ قَتَلَ حُرًّا ، وَعَبْدًا خَطَأً ؟ قَالَ : دِيَةُ الْحُرِّ ، وَدِيَةُ الْعَبْدِ "" ، قُلْتُ : فَعَمْدًا ؟ قَالَ : "" يُقْتَلُ بِالْحُرِّ ، وَيَغْرَمُ الْعَبْدَ , إِلا أَنْ يَكُونَ مَضَتِ السُّنَّةُ بِغَيْرِ ذَلِكَ ، وَلَوْ قَتَلَ حُرَّيْنِ كَانَ قَطُّ , قَالَ : قُلْتُ : فَكَيْفَ يُقْتَلُ بِالْحُرِّ وَيَغْرَمُ أَهْلُ الْحُرِّ ثَمَنَ الْمَمْلُوكِ ؟ وَلا أَعْلَمُ هَذَا إِلا عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : "" لا أَعْلَمُ إِلا أَنْ يُقْتَلَ بِالْحُرِّ ، وَيَغْرَمَ ثَمَنَ الْمَمْلُوكِ ""","","","","","Book of Blood Money (Diyat)"
"17532","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ :  فِيحُرٍّ قَتَلَ حُرًّا وَعَبْدًا عَمْدًا : يُقْتَلُ بِالْحُرِّ ، وَيَغْرَمُ ثَمَنَ الْعَبْدِ فِي مَالِهِ ""","","","","","Book of Blood Money (Diyat)"
"17533","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , فِيعَبْدٍ بَيْنَ رَجُلَيْنِ أَعْتَقَهُ أَحَدُهُمَا وَقَتْلَهُ الآخَرُ , قَالَ :  هُوَ بِمَنْزِلَةِ الْحُرِّ , يَغْرَمُ الْمُعْتِقُ ، لِلَّذِي قَتَلَ نِصْفَ دِيَتِهِ ، وَتَكُونُ دِيَتُهُ عَلَى الْقَاتِلِ لِوَرَثَتِهِ ""، قَالَ مَعْمَرٌ : وَقَالَ الزُّهْرِيُّ : "" هُوَ عَبْدٌ حَتَّى يُعْتِقَهُ كُلُهُمْ ""","","","","","Book of Blood Money (Diyat)"
"17534","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , فِيرَجُلٍ وَصَبِيٍّ قَتَلا رَجُلا عَمْدًا , قَالَ :  يُقْتَلُ الْقَاتِلُ ، وَتَكُونُ الدِّيَةُ عَلَى أَهْلِ الصَّبِيِّ ، إِنَّ عَمَدَ الصَّبِيِّ خَطَأٌ ""، قَالَ الْحَسَنُ : "" دِيَةٌ وَلا قَتْلٌ ""","","","","","Book of Blood Money (Diyat)"
"17535","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ كَثِيرٌ مِنَ النَّاسِ : لا يُقْتَلُ بِهِ , مِنْ أَجْلِ أَنَّهُ لا يَدْرِي لَعَلَّ الصَّبِيَّ هُوَ الَّذِي قَتَلَهُ , كَمَا لَوْ أَرْسَلْنَا كَلْبًا مُعَلَّمًا عَلَى صَيْدٍ ، فَعَرَضَ لِلصَّيْدِ مَعَ هَذَا الْكَلْبِ كَلْبٌ غَيْرُ مُعَلَّمٍ ، فَاجْتَمَعَا فِي قَتْلِهِ لَمْ يُؤْكَلْ ""","","","","","Book of Blood Money (Diyat)"
"17536","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ : فِيكَبِيرٍ وَصَغِيرٍ قَتَلا رَجُلا , قَالَ :  لا يُقْتَلُ وَاحِدٌ مِنْهُمَا , لأَنَّهُ لا يَدْرِي أَيُّهُمَا الَّذِي أَجَازَ عَلَيْهِ ، وَعَلَيْهِمَا الدِّيَةُ , حِصَّةُ الصَّغِيرِ عَلَى الْعَاقِلَةِ ، وَحِصَّةُ الآخَرِ فِي مَالِهِ ""، وَقَالَهُ إِبْرَاهِيمُ""","","","","","Book of Blood Money (Diyat)"
"17537","عَنْ مَعْمَرٍ , قَالَ : وَقَالَ هِشَامٌ ، عَنِ الْحَسَنِ إِذَا دَخَلَ عَمْدًا فِي خَطَاءٍ ، كَانَتِ الدِّيَةُ ""","","","","","Book of Blood Money (Diyat)"
"17538","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ ، يَرْوِيهِ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ قَتَلَ عَبْدَهُ قَتَلْنَاهُ ، وَمَنْ جَدَعَهُ جَدَعْنَاهُ فَرَاجَعُوهُ "" , قَالَ : "" قَضَى اللَّهُ النَّفْسَ بِالنَّفْسِ ""","","","","","Book of Blood Money (Diyat)"
"17539","عَنِ الثَّوْرِيِّ ، عَنْ سُهَيْلِ بنِ أَبِي صَالِحٍ , قَالَ : سَأَلْتُ ابْنَ الْمُسَيِّبِ ,  عَنْرَجُلٍ قَتَلَ عَبْدًا عَمْدًا , قَالَ : "" يُقْتَلُ بِهِ "" , فَعَاوَدْتُهُ ، فَقَالَ : "" لَوِ اجْتَمَعَ عَلَيْهِ أَهْلُ الْيَمَنِ لَقَتَلْتُهُمْ ""","","","","","Book of Blood Money (Diyat)"
"17540","عَنِ ابْنِ سَمْعَانَ ، عَنْ سُهَيْلِ بْنِ أَبِي صَالِحٍ ، أَنَّ زَيْدَ بْنَ أَسْلَمَ ، وَعَلِيَّ بْنَ أَبِي كَثِيرٍ ، أرسلاه إلى ابن المسيب يسأله عَنْ ذَلِكَ , قَالَ :  يُقْتَلُ بِهِ "" , قَالَ : فَرَجَعْتُ إِلَيْهِمَا فَأَخْبَرْتُهُمَا ، قَالا : وَهِمْتَ , فَارْجِعْ فَاسْأَلْهُ ! قَالَ : فَرَجَعْتُ إِلَيْهِ فَسَأَلْتُهُ ، فَقَالَ : "" مَنْ أَنْتَ ؟ "" , قَالَ : فَأَخْبَرْتُهُ ، فَقَالَ : ""يُقْتَلُ بِهِ يَا ابْنَ أَخِي ! لَوْ كَانُوا مِائَةً لَقَتَلْتُهُمْ بِهِ ""، عَنْ مَعْمَرٍ ، عَنْ سُهَيْلِ بْنِ أَبِي صَالِحٍ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : "" يُقْتَلُ بِهِ ""","","","","","Book of Blood Money (Diyat)"
"17541","عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، وَعَمْرِو بْنِ دِينَارٍ ، أَوْ أَحَدِهِمَا , عَنِ ابْنِ عَبَّاسٍ , قَالَ عَبْدُ الرَّزَّاقِ : وَأَخْبَرَنَا ابْنُ سَمْعَانَ ، عَنْ مُجَاهِدٍ ، عَنِ ابْنِ عَبَّاسٍ , فِي قَوْلِهِ :  وَكَتَبْنَا عَلَيْهِمْ فِيهَا أَنَّ النَّفْسَ بِالنَّفْسِ "", قَالَ : فَأَخْبَرَنِي ابْنُ سَمْعَانَ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : "" كَتَبَ ذَلِكَ عَلَى بَنِي إِسْرَائِيلَ ، فَهَذِهِ الآيَةُ لَنَا ، وَلَهُمْ ""","","","","","Book of Blood Money (Diyat)"
"17542","عَنْ أَبِي حَنِيفَةَ , عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ : يُقْتَلُ بِهِ إِذَا كَانَ عَمْدًا ""، قَالَ الثَّوْرِيُّ : "" إِنْ قَتَلَ عَبْدَهُ أَوْ عَبْدَ غَيْرِهِ قُتِلَ بِهِ "" ، وَهُوَ قَوْلُنَا""","","","","","Book of Blood Money (Diyat)"
"17543","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : لا قَوَدَ بَيْنَ الْحُرِّ وَالْمَمْلُوكِ ، وَلَكِنِ الْعُقُوبَةَ ، وَالنَّكَالَ , وَغُرْمَ مَا أَصَابَ ""","","","","","Book of Blood Money (Diyat)"
"17544","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، فِيرَجُلٍ قَتَلَ عَبْدَهُ عَمْدًا , قَالَ :  يُعَاقِبُ عُقُوبَةً مُوجِعَةً وَيُسْجَنُ ""","","","","","Book of Blood Money (Diyat)"
"17545","عَنِ الثَّوْرِيِّ ، عَنْ يُونُسَ ، عَنِ الْحَسَنِ ،  فِيرَجُلٍ قَتَلَ عَبْدَ نَفْسِهِ , قَالَ : "" لا يُقْتَلُ بِهِ ""","","","","","Book of Blood Money (Diyat)"
