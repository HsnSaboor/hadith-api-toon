"850","(۸۵۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الْعَلاَئِ ، عَنْ عَطَائٍ ، قَالَ : لَیْسَ عَلَیْہَا الْغُسْلُ ، قَالَ : وَقَالَ حَمَّادٌ ، عَنْ إبْرَاہِیمَ : عَلَیْہَا الْغُسْلُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 850","","","كتاب الطهارة"
"851","(۸۵۱) حَدَّثَنَا یَزِیدُ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ عَنِ الْمَرْأَۃِ تُجنبُ ، ثُمَّ تَحِیضُ قَبْلَ أَنْ تَغْتَسِلَ ؟ قَالَ : وَإِنْ حَاضَتْ ، فَإِنَّہُ حَقٌّ عَلَیْہَا أَنْ تَغْتَسِلَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 851","","","كتاب الطهارة"
"852","(۸۵۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ ، عَنْ عَامِرٍ ، قَالَ: إِنْ شَائَتِ اغْتَسَلَتْ ، وَإِنْ شَائَ تْ لَمْ تَغْتَسِلْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 852","","","كتاب الطهارة"
"853","(۸۵۳) حَدَّثَنَا مُحَمَّد بن مُیَسَّر ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : تَغْتَسِلُ مِنَ الْجَنَابَۃِ ، فَإِذَا طَہُرَتِ اغْتَسَلَتْ مِنَ الْحَیْضِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 853","","","كتاب الطهارة"
"854","(۸۵۴) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا احْتَلَمَ وَلَمْ یَرَ بَلَلاً فَلاَ غُسْلَ عَلَیْہِ ، وَإِذَا رَأَی بَلَلاً ، وَلَمْ یَرَ أَنَّہُ احْتَلَمَ فَعَلَیْہِ الْغُسْلُ۔",": Da'if","Musannaf Ibn Abi Shaybah 854","","","كتاب الطهارة"
"855","(۸۵۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی حَمْزَۃَ ، قَالَ : بَیْنَمَا أَنَا أَسِیرُ عَلَی رَاحِلَتِی ، وَأَنَا بَیْنَ النَّائِمِ وَالْیَقِظَانِ إذْ وَجَدْتُ شَہْوَۃً ، فَأَنْکَرْتُ نَفْسِی ، فَخَرَجَ مِنِّی مَائٌ بَلَّ بَادِّی ، وَمَا ہُنَاکَ ، فَسَأَلْت ابْنَ عَبَّاسٍ ؟ فَقَالَ : اغْسِلْ ذَکَرَک، وَمَا أَصَابَ مِنْک ، وَلَمْ یَأْمُرْنِی بِالْغُسْلِ۔ (عبدالرزاق ۶۰۹)",": Da'if","Musannaf Ibn Abi Shaybah 855","","","كتاب الطهارة"
"856","(۸۵۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا اسْتَیْقَظَ وَقَدْ رَأَی أَنَّہُ قَدْ جَامَعَ ، فَلَمْ یَرَ بَلَلاً فَلاَ غُسْلَ عَلَیْہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 856","","","كتاب الطهارة"
"857","(۸۵۷) حَدَّثَنَا أَبُو بَکْرٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، مِثْلَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 857","","","كتاب الطهارة"
"858","(۸۵۸) حَدَّثَنَا أَبُو بَکْرٍ ، عَنْ أَبِی حَیَّانَ ، عَنِ الشَّعْبِیِّ ، مِثْلَ ذَلِکَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 858","","","كتاب الطهارة"
"859","(۸۵۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا سَعِیدُ بْنُ أَبِی عَرُوبَۃَ ، عَنْ عَلِیِّ بْنِ ثَابِتٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ اسْتَیْقَظَ مِنْ مَنَامِہِ فَرَأَی بِلَّۃً ؟ قَالَ : لَوْ وَجَدْتُ ذَلِکَ لاَغْتَسَلْتُ مِنْہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 859","","","كتاب الطهارة"
"860","(۸۶۰) حَدَّثَنَا جَرِیرٌ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَجِدُ الْبَلَلَ بَعْدَ النَّوْمِ ، قَالَ : یَغْتَسِلُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 860","","","كتاب الطهارة"
"861","(۸۶۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ؛ قَالَ : لاَ یَغْتَسِلُ حَتَّی یَسْتَیْقِنَ ، أَنَّہُ قَدْ أَجْنَبَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 861","","","كتاب الطهارة"
"862","(۸۶۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، وَعَطَائٍ قَالاَ : إذَا رَأَی بَلَلاً فَلْیَغْتَسِلْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 862","","","كتاب الطهارة"
"863","(۸۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنِ الرَّجُلِ یَسْتَیْقِظُ فَیَجِدُ الْبِلَّۃَ ؟ قَالَ الْحَکَمُ : لاَ یَغْتَسِلُ ، وَقَالَ حَمَّادٌ : إِنْ کَانَ یَرَی أَنَّہُ قَدِ احْتَلَمَ اغْتَسَلَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 863","","","كتاب الطهارة"
"864","(۸۶۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَمِعْتُ سُفْیَانَ یَقُولُ : یَغْتَسِلُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 864","","","كتاب الطهارة"
"865","(۸۶۵) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ مَعْمَرٍ ، عَنْ قَتَادَۃَ قَالَ : لاَ یَغْتَسِلُ حَتَّی یَسْتَیْقِنَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 865","","","كتاب الطهارة"
"866","(۸۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ بْنِ یَحْیَی ، عَنْ مُعَاوِیَۃَ بْنِ إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : إنَّمَا الْغُسْلُ مِنَ الشَّہْوَۃِ وَالْفَتْرَۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 866","","","كتاب الطهارة"
"867","(۸۶۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ؛ فِی الرَّجُلِ یُصْبِحُ فَیَرَی عَلَی ذَکَرِہِ الْبِلَّۃَ ، قَالَ : إِنْ کَانَ یَرَی أَنَّہُ احْتَلَمَ اغْتَسَلَ ، وَإِنْ لَمْ یَکُنْ یَرَی أَنَّہُ احْتَلَمَ لَمْ یَغْتَسِلْ۔\n وَقَالَ قَتَادَۃُ: إِنْ کَانَ مَائً دَافِقًا اغْتَسَلَ، فَقُلْتُ لِقَتَادَۃَ: کَیْفَ یَعْلَمُ؟ قَالَ: یَشَمُّہ، وَقَالَ الْحَکَمُ: لاَ یَغْتَسِلُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 867","","","كتاب الطهارة"
"868","(۸۶۸) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ الْعُمَرِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ قَالَ : إذَا اسْتَیْقَظَ أَحَدُکُمْ فَرَأَی بَلَلاً ، وَلَمْ یَرَ أَنَّہُ احْتَلَمَ فَلْیَغْتَسِلْ ، وَإِذَا رَأَی أَنَّہُ احْتَلَمَ ، وَلَمْ یَرَ بَلَلاً فَلاَ غُسْلَ عَلَیْہِ۔ (احمد ۲۵۶۔ ابوداؤد ۶۴۰)",": Da'if","Musannaf Ibn Abi Shaybah 868","","","كتاب الطهارة"
"869","(۸۶۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ صَفِیَّۃَ ابْنَۃِ شَیْبَۃَ ، عَنْ عَائِشَۃَ قَالَتْ : دَخَلَتْ أَسْمَائُ ابْنَۃُ شَکَلٍ عَلَی رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فَقَالَتْ : یَا رَسُولَ اللہِ کَیْفَ تَغْتَسِلُ إحْدَانَا إذَا طَہُرَتْ مِنَ الْمَحِیضِ ؟ قَالَ : تَأْخُذُ سِدْرَتَہَا وَمَائَہَا فَتَتَوَضَّأُ ، وَتَغْسِلُ رَأْسَہَا ، وَتَدْلُکُہُ حَتَّی یَبْلُغَ الْمَائُ أُصُولَ شَعَرِہَا ، ثُمَّ تُفِیضُ الْمَائَ عَلَی جَسَدِہَا ، ثُمَّ تَأْخُذُ فِرْصَتَہَا فَتَطَہَّرُ بِہَا ، فَقَالَتْ : یَا رَسُولَ اللہِ ، کَیْفَ أَتَطَہَّرُ بِہَا ؟ قَالَ : تَطَہَّرِی بِہَا ، قَالَتْ عَائِشَۃُ : فَعَرَفْت الَّذِی یَکْنِی عَنْہُ ، فَقُلْتُ لَہَا : تَتَبَّعِی آثَارَ الدَّمِ۔(بخاری ۳۱۴۔ مسلم ۶۱)",": Hasan","Musannaf Ibn Abi Shaybah 869","","","كتاب الطهارة"
"870","(۸۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لَہَا فِی الْحَیْضِ : اُنْقُضِی شَعَرَکِ وَاغْتَسِلِی۔ (ابن ماجہ ۶۴۱)",": Sahih","Musannaf Ibn Abi Shaybah 870","","","كتاب الطهارة"
"871","(۸۷۱) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنِی مِسْعَرٌ ، عَنْ أَبِی بَکْرِ بْنِ عُمَارَۃَ بْنِ رُوَیْبَۃَ ، عَنِ امْرَأَۃٍ ، عَنْ أُمِّ سَلَمَۃَ قَالَتْ : إِنْ کَانَتْ إحْدَانَا إذَا اغْتَسَلَتْ مِنَ الْجَنَابَۃِ لَتُبقِّی ضَفِیرَتَہَا۔",": Da'if","Musannaf Ibn Abi Shaybah 871","","","كتاب الطهارة"
"872","(۸۷۲) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ؛ أَنَّہُ سُئِلَ عَنِ الْمَرْأَۃِ الثَّقِیلَۃِ ، أَوْ الْعَظِیمَۃِ لاَ تَنَالُ یَدُہَا ظَہرَہا عِنْدَ الْغُسْلِ مِنَ الْجَنَابَۃِ، أَوِ الْحَیْضِ؟ فَقَالَ: إنَّا لَنَرْجُوا مِنْ رَحْمَۃِ اللہِ مَا ہُوَ أَعْظَمُ مِنْ ذَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 872","","","كتاب الطهارة"
"873","(۸۷۳) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ دِینَارٍ ، قَالَ : قُلْتُ لِلْحَسَنِ : الْجَارِیَۃُ الْعَجَمِیَّۃُ لاَ تُحْسِنُ تَغْتَسِلُ ، قَالَ : مُرْہَا فَلْتَمْسَحْ قُبُلَہَا بِخِرْقَۃٍ وَلِتَغْسِلْہُ بِالْمَائِ دَاخِلاً وَخَارِجًا ، وَتَوَضَّأُ وُضُوئَہَا لِلصَّلاَۃِ ، ثُمَّ تَغْتَسِلُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 873","","","كتاب الطهارة"
"874","(۸۷۴) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنْ أَبِی الْمُتَوَکِّلِ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : إذَا جَامَعَ أَحَدُکُمْ أَہْلَہُ مِنَ اللَّیْلِ ، ثُمَّ أَرَادَ أَنْ یَعُودَ فَلْیَتَوَضَّأْ بَیْنَہُمَا وُضُوئً ا۔\n(ابوداؤد ۲۲۲۔ ترمذی ۱۴۱)",": Sahih","Musannaf Ibn Abi Shaybah 874","","","كتاب الطهارة"
"875","(۸۷۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، عَنْ سَلْمَانَ بْنِ رَبِیعَۃَ قَالَ : قَالَ لِی عُمَرُ : یَا سَلْمَانُ ! إذَا أَتَیْتَ أَہْلَک ، ثُمَّ أَرَدْت أَنْ تَعُودَ کَیْفَ تَصْنَعُ ؟ قُلْتُ : کَیْفَ أَصْنَعُ ؟ قَالَ : تَوَضَّأْ بَیْنَہُمَا وُضُوئً ا۔",": Sahih","Musannaf Ibn Abi Shaybah 875","","","كتاب الطهارة"
"876","(۸۷۶) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ نَافِعٍ ؛ أَنَّ ابْنَ عُمَرَ کَانَ إذَا أَتَی أَہْلَہُ ، ثُمَّ أَرَادَ أَنْ یَعُودَ غَسَلَ وَجْہَہُ وَذِرَاعَیْہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 876","","","كتاب الطهارة"
"877","(۸۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ مُحَارِبٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : إذَا أَرَدْت أَنْ تَعُودَ تَوَضَّأْ۔",": Sahih","Musannaf Ibn Abi Shaybah 877","","","كتاب الطهارة"
"878","(۸۷۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُجَامِعَ الرَّجُلُ امْرَأَتَہُ ثُمَّ یَعُودَ قَبْلَ أَنْ یَتَوَضَّأَ ، قَالَ : وَکَانَ ابْنُ سِیرِینَ یَقُولُ : لاَ أَعْلَمُ بِذَلِکَ بَأْسًا ، قَالَ : إنَّمَا قِیلَ ذَلِکَ لإِنَّہُ أَحْرَی أَنْ یَعُودَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 878","","","كتاب الطهارة"
"879","(۸۷۹) حَدَّثَنَا وَکِیعٌ ، عَنِ عمر بن الولید الشَّنِّی ، قَالَ : سَمِعْتُ عِکْرِمَۃَ یَقُولُ : إذَا أَرَادَت أَنْ یَعُودَ تَوَضَّأْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 879","","","كتاب الطهارة"
"880","(۸۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عُرَیفِ بْنِ دِرْہَمٍ ، عَنْ إبْرَاہِیمَ قَالَ : یَتَوَضَّأُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 880","","","كتاب الطهارة"
"881","(۸۸۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ قَالَ : إذَا أَرَادَ أَنْ یَعُودَ تَوَضَّأَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 881","","","كتاب الطهارة"
"882","(۸۸۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنِ الْمُحَارِبِیِّ ، عَنِ ابْنِ عُمَرَ قَالَ : إذَا أَرَادَ أَنْ یَعُودَ تَوَضَّأَ۔",": Sahih","Musannaf Ibn Abi Shaybah 882","","","كتاب الطهارة"
"883","(۸۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ زَیْنَبَ بِنْتِ أُمِّ سَلَمَۃَ ، عَنْ أُمِّ سَلَمَۃَ ، قَالَتْ : جَائَتْ أُمُّ سُلَیْمٍ إلَی النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فَسَأَلَتْہُ عَنِ الْمَرْأَۃِ تَرَی فِی مَنَامِہَا مَا یَرَی الرَّجُلُ ؟ فَقَالَ : إذَا رَأَتِ الْمَائَ فَلْتَغْتَسِلْ ، فَقُلْتُ لَہَا : فَضَحْت النِّسَائَ ، وَہَلْ تَحْتَلِمُ الْمَرْأَۃُ ؟ فَقَالَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : تَرِبَتْ یَمِینُک ، فَبِمَا یُشْبِہُہَا وَلَدُہَا إذنْ۔ (بخاری ۱۳۰۔ مسلم ۲۵۱)",": Sahih","Musannaf Ibn Abi Shaybah 883","","","كتاب الطهارة"
"884","(۸۸۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخبرنَا سَعِیدُ بْنُ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، أَنَّ أُمَّ سُلَیْمٍ سأَلَتْ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ عَنِ الْمَرْأَۃِ تَرَی فِی مَنَامِہَا مَا یَرَی الرَّجُلُ ؟ فَقَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : إذَا رَأَتْ ذَلِکَ فَأَنْزَلَتْ فَعَلَیْہَا الْغُسْلُ ، فَقَالَتْ أُمُّ سَلَمَۃَ : یَا رَسُولَ اللہِ أَیَکُونُ ہَذَا ؟ قَالَ : نَعَمْ، مَائُ الرَّجُلِ غَلِیظٌ أَبْیَضُ ، وَمَائُ الْمَرْأَۃِ رَقِیقٌ أَصْفَرُ ، فَأَیُّہُمَا سَبَقَ ، أَوْ عَلاَ ، أَشْبَہَہُ الْوَلَدُ۔\n(مسلم ۳۰۔ نسائی ۲۰۲)",": Sahih","Musannaf Ibn Abi Shaybah 884","","","كتاب الطهارة"
"885","(۸۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ خَوْلَۃَ بِنْتِ حَکِیمٍ ؛ أَنَّہَا سَأَلَتِ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ عَنِ الْمَرْأَۃِ تَرَی فِی مَنَامِہَا مَا یَرَی الرَّجُلُ ؟ فَقَالَ : إِنَّہُ لَیْسَ عَلَیْہَا غُسْلٌ حَتَّی تُنْزِلَ ، کَمَا أَنَّ الرَّجُلَ لَیْسَ عَلَیْہِ غُسْلٌ حَتَّی یُنْزِلَ۔ (احمد ۶/۴۰۹۔ ابن ماجہ ۶۰۲)",": Da'if","Musannaf Ibn Abi Shaybah 885","","","كتاب الطهارة"
"886","(۸۸۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِیُّ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ عَامِرٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : جَائَتِ امْرَأَۃٌ یُقَالُ لَہَا بُسْرَۃُ إلَی النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : یَا رَسُولَ اللہِ إحْدَانَا تَرَی أَنَّہَا مَعَ زَوْجِہَا فِی الْمَنَامِ ؟ فَقَالَ : إذَا وَجَدْتِ بَلَلاً فَاغْتَسِلِی یَا بُسْرَۃُ۔",": Da'if","Musannaf Ibn Abi Shaybah 886","","","كتاب الطهارة"
"887","(۸۸۷) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ عَطَائٍ وَأَبِی سَلَمَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، وَمُجَاہِدٍ قَالُوا : إنَّ أُمَّ سُلَیْمٍ ، قَالَتْ : یَا رَسُولَ اللہِ ! الْمَرْأَۃُ تَرَی فِی مَنَامِہَا مَا یَرَی الرَّجُلُ ، أَیَجِبُ عَلَیْہَا الْغُسْلُ ؟ قَالَ : ہَلْ تَجِدُ شَہْوَۃً ؟ قَالَتْ : لَعَلَّہُ ! قَالَ : ہَلْ تَجِدُ بَلَلاً ؟ قَالَتْ : لَعَلَّہُ ! قَالَ : فَلْتَغْتَسِلْ فَلَقِیَتْہَا نِسْوَۃٌ فَقُلْنَ لَہَا : فَضَحْتینَا عِنْدَ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : وَاللَّہِ مَا کُنْتُ لأَنْتَہِیَ حَتَّی أَعْلَمَ فِی حِلٍّ أَنَا ، أَوْ فِی حَرَامٍ۔","","Musannaf Ibn Abi Shaybah 887","","","كتاب الطهارة"
"888","(۸۸۸) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ؛ قَالَ : إذَا تَنَوَّمَتِ الْمَرْأَۃُ فَرَأَتْ مَا یَرَی الرَّجُلُ فَلْتَغْتَسِلْ۔","","Musannaf Ibn Abi Shaybah 888","","","كتاب الطهارة"
"889","(۸۸۹) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، قَالَ : سَأَلْتُ عَنْہُ سَالِمًا وَمُجَاہِدًا وَعَطَائً قَالُوا : تَغْتَسِلُ إذَا رَأَتْ مَا یَرَی الرَّجُلُ۔","","Musannaf Ibn Abi Shaybah 889","","","كتاب الطهارة"
"890","(۸۹۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : کَانَ إبْرَاہِیمُ یُنْکِرُ احْتِلاَمَ النِّسَائِ۔","","Musannaf Ibn Abi Shaybah 890","","","كتاب الطهارة"
"891","(۸۹۱) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ، عَنْ سُفْیَانَ، عَنْ جَابِرٍ، عَنْ عَامِرٍ ، قَالَ: إذَا رَأَتِ الْمَرْأَۃُ مَا یَرَی الرَّجُلُ فَلْتَغْتَسِلْ۔","","Musannaf Ibn Abi Shaybah 891","","","كتاب الطهارة"
"892","(۸۹۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ مُعَرِّفٍ ، عَنْ إسْمَاعِیلَ بْنِ رَجَائٍ ، عَنْ إبْرَاہِیمَ قَالَ : لَیْسَ عَلَیْہَا غُسْلٌ ، وَقَالَ ذَرٌّ تَغْتَسِلُ۔","","Musannaf Ibn Abi Shaybah 892","","","كتاب الطهارة"
"893","(۸۹۳) حَدَّثَنَا حَفْصٌ ، عَنْ أَبِی سَبْرَۃَ ، عَنْ أَبِی الضُّحَی ؛ قَالَ : سُئِلَ عَلِیٌّ عَنِ الْمَرْأَۃِ تَرَی فِی مَنَامِہَا مَا یَرَی الرَّجُلُ ، أَتَغْتَسِلُ ؟ قَالَ : نَعَمْ ، إذَا رَأَتِ الْبِلَّۃَ۔","","Musannaf Ibn Abi Shaybah 893","","","كتاب الطهارة"
"894","(۸۹۴) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا رَأَتِ الْمَرْأَۃُ مَا یَرَی الرَّجُلُ ، ثُمَّ أَنْزَلَتْ فَلْتَغْتَسِلْ۔",": Da'if","Musannaf Ibn Abi Shaybah 894","","","كتاب الطهارة"
"895","(۸۹۵) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ أَبِی إِسْحَاقَ، عَنِ الْحَارِثِ، عَنْ عَلِیٍّ، قَالَ: إذَا رَأَتِ الْمَائَ فَلْتَغْتَسِلْ۔",": Da'if","Musannaf Ibn Abi Shaybah 895","","","كتاب الطهارة"
"896","(۸۹۶) حَدَّثَنَا عُبَیْدُ اللہِ قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، قَالَ : إذَا رَأَتِ الْمَرْأَۃُ مَا یَرَی الرَّجُلُ ، فَلْتَغْتَسِلْ۔","","Musannaf Ibn Abi Shaybah 896","","","كتاب الطهارة"
"897","(۸۹۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَبِی سِنَانٍ ضِرَارٍ ، عَنْ مُحَارِبٍ ، عَنِ ابْنِ عُمَرَ قَالَ : مَنِ اغْتَرَفَ مِنْ مَائٍ وَہُوَ جُنُبٌ فَمَا بَقِیَ مِنْہُ نَجَسٌ ، وَلاَ تَدْخُلُ الْمَلاَئِکَۃُ بَیْتًا فِیہِ بَوْلٌ۔","","Musannaf Ibn Abi Shaybah 897","","","كتاب الطهارة"
"898","(۸۹۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الْجُنُبِ یُدْخِلُ یَدَہُ فِی الإِنَائِ قَبْلَ أَنْ یَغْسِلَہَا ، أَوِ الرَّجُلِ یَقُومُ مِنْ مَنَامِہِ فَیُدْخِلُ یَدَہُ فِی الإِنَائِ قَبْلَ أَنْ یَغْسِلَہَا ، قَالَ : إِنْ شَائَ تَوَضَّأَ ، وَإِنْ شَائَ أَہْرَاقَہُ۔","","Musannaf Ibn Abi Shaybah 898","","","كتاب الطهارة"
"899","(۸۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْجُرَیْرِیِّ ، عَمَّنْ سَمِعَ سَعِیدَ بْنَ الْمُسَیَّبِ یَقُولُ : لاَ بَأْسَ أَنْ یَغْمِسَ الْجُنُبُ یَدَہُ فِی الإِنَائِ قَبْلَ أَنْ یَغْسِلَہَا۔","","Musannaf Ibn Abi Shaybah 899","","","كتاب الطهارة"
"900","(۹۰۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ الْجَعْدِ ، عَنْ عَائِشَۃَ ابْنَۃِ سَعْدٍ قَالَتْ : کَانَ سَعْدٌ یَأْمُرُ جَارِیَتَہُ فَتُنَاوِلُہُ الطَّہُورَ مِنَ الْجَرَّۃِ ، فَتَغْمِسُ یَدَہَا فِیہَا فَیُقَالُ : إِنَّہَا حَائِضٌ ! فَیَقُولُ : إنَّ حَیْضَتَہَا لَیْسَتْ فِی یَدِہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 900","","","كتاب الطهارة"
"901","(۹۰۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ قَالَ : کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یُدْخِلُونَ أَیْدِیَہُمْ فِی الإِنَائِ وَہُمْ جُنُبٌ ، وَالنِّسَائُ وَہُنَّ حُیَّضٌ ، لاَ یَرَوْنَ بِذَلِکَ بَأْسًا ، یَعْنِی : قَبْلَ أَنْ یَغْسِلُوہَا۔",": Da'if","Musannaf Ibn Abi Shaybah 901","","","كتاب الطهارة"
"902","(۹۰۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا أَجْنَبَ الرَّجُلُ فِی ثَوْبِہِ فَرَأَی فِیہِ أَثَرًا فَلْیَغْسِلْہُ ، وَإِنْ لَمْ یَرَ فِیہِ أَثَرًا فَلْیَنْضَحْہُ۔","","Musannaf Ibn Abi Shaybah 902","","","كتاب الطهارة"
"903","(۹۰۳) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ قَالَ : قَالَ رَجُلٌ مِنَ الْحَیِّ لإِبِی مَیْسَرَۃَ : إنِّی أُجْنِبُ فِی ثَوْبِی فَأَنْظُرُ فَلاَ أَرَی شَیْئًا ؟ قَالَ : إذَا اغْتَسَلْت فَتَلَفَّفْ بِہِ وَأَنْتَ رَطْبٌ فَإِنَّ ذَلِکَ یُجْزِئُکَ۔","","Musannaf Ibn Abi Shaybah 903","","","كتاب الطهارة"
"904","(۹۰۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ طَلْحَۃَ بْنِ عَبْدِ اللہِ بْنِ عَوْفٍ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّہُ کَانَ یَقُولُ فِی الْجَنَابَۃِ فِی الثَّوْبِ : إِنْ رَأَیْت أَثَرَہُ فَاغْسِلْہُ ، وَإِنْ عَلِمْت أَنْ قَدْ أَصَابَہُ ، ثُمَّ خَفِیَ عَلَیْک فَاغْسِلِ الثَّوْبَ ، وَإِنْ شَکَکْت فَلَمْ تَدْرِ أَصَابَ الثَّوْبَ أَمْ لاَ ، فَانْضَحْہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 904","","","كتاب الطهارة"
"905","(۹۰۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : إِنْ خَفِیَ عَلَیْہِ مَکَانُہُ وَعَلِمَ أَنَّہُ قَدْ أَصَابَہُ ، غَسَلَ الثَّوْبَ کُلَّہُ۔","","Musannaf Ibn Abi Shaybah 905","","","كتاب الطهارة"
"906","(۹۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ زُیَیْدِ بْنِ الصَّلْتِ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ غَسَلَ مَا رَأَی ، وَنَضَحَ مَا لَمْ یَرَ ، وَأَعَادَ بَعْدَ مَا أَضْحَی مُتَمَکِّنًا۔",": Sahih","Musannaf Ibn Abi Shaybah 906","","","كتاب الطهارة"
"907","(۹۰۷) حَدَّثَنَا وَکِیعٌ ، عَنِ السَّرِیِّ بْنِ یَحْیَی ، عَنْ عَبْدِ الْکَرِیمِ بْنِ رَشِیدٍ ، عَنْ أَنَسٍ ؛ فِی رَجُلٍ أَجْنَبَ فِی ثَوْبِہِ فَلَمْ یَرَ أَثَرَہُ ، قَالَ : یَغْسِلُہُ کُلَّہُ۔",": Hasan","Musannaf Ibn Abi Shaybah 907","","","كتاب الطهارة"
"908","(۹۰۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی الْجَنَابَۃِ فِی الثَّوْبِ ، قَالَ : إِنْ رَأَیْتہ فَاغْسِلْہُ ، وَإِنْ ضَلَلْت فَانْضَحْ۔","","Musannaf Ibn Abi Shaybah 908","","","كتاب الطهارة"
"909","(۹۰۹) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ؛ فِی الرَّجُلِ تُصِیبُ ثَوْبَہُ الْجَنَابَۃُ ، ثُمَّ تَخْفَی عَلَیْہِ ؟ قَالَ : اغْسِلْہُ أَجْمَعَ۔","","Musannaf Ibn Abi Shaybah 909","","","كتاب الطهارة"
"910","(۹۱۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَحْتَلِمُ فِی الثَّوْبِ فَلاَ یَدْرِی أَیْنَ مَوْضِعُہُ ؟ قَالَ : یَنْضَحُ الثَّوْبَ بِالْمَائِ۔","","Musannaf Ibn Abi Shaybah 910","","","كتاب الطهارة"
"911","(۹۱۱) حَدَّثَنَا جَرِیرٌ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ یَزِیدُہُ النَّضْحُ إِلاَّ شَرًّا۔","","Musannaf Ibn Abi Shaybah 911","","","كتاب الطهارة"
"912","(۹۱۲) حَدَّثَنَا مَحْبُوبٌ الْقَوَارِیرِیُّ ، عَنْ مَالِکِ بْنِ حَبِیبٍ ، عَنْ سَالِمٍ ، قَالَ : سَأَلَہُ رَجُلٌ فَقَالَ : إنِّی احْتَلَمْت فِی ثَوْبِی ؟ قَالَ : اغْسِلْہُ ، قَالَ : خَفِیَ عَلَیَّ ؟ قَالَ : رُشَّہ بِالْمَائِ۔","","Musannaf Ibn Abi Shaybah 912","","","كتاب الطهارة"
"913","(۹۱۳) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : لاَ یَنْضَحْہُ بِالْمَائِ۔","","Musannaf Ibn Abi Shaybah 913","","","كتاب الطهارة"
"914","(۹۱۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخبرنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، قَالَ : حَدَّثَنَا سَعِیدُ بْنُ عُبَیْدِ بْنِ السَّبَّاقِ ، عَنْ أَبِیہِ ، عَنْ سَہْلِ بْنِ حُنَیْفٍ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ فَکَیْفَ بِمَا یُصِیبُ ثَوْبِی مِنْہُ ؟ قَالَ : إنَّمَا یَکْفِیک کَفٌّ مِنْ مَائٍ تَنْضَحُ بِہِ مِنْ ثَوْبِکَ حَیْثُ تَرَی أَنَّہُ أَصَابَ۔ (احمد ۴۸۵۔ ابوداؤد ۲۱۲)",": Hasan","Musannaf Ibn Abi Shaybah 914","","","كتاب الطهارة"
"915","(۹۱۵) حَدَّثَنَا شَرِیکٌ ، عَنْ سَالِمٍ ، قَالَ : قُلْتُ لِسَعِیدِ بْنِ جُبَیْرٍ : إنِّی أَحْتَلِمُ فِی ثَوْبِی ، قَالَ : إِنْ وَجَدْتہ فَاغْسِلْہُ وَالأَ فَخَلِّ طَرِیقَہُ ، قَالَ : قُلْتُ : أَطْرَحُہُ وَأَلْبَسُ ثَوْبًا غَیْرَہُ ؟ قَالَ : إنَّک لَکَثِیرُ الْمَلاَحِفِ۔","","Musannaf Ibn Abi Shaybah 915","","","كتاب الطهارة"
"916","(۹۱۶) حَدَّثَنَا ابْنُ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ؛ فِی الْجَنَابَۃِ فِی الثوب ، قَالَ : إِنْ رَأَیْتہ فَاغْسِلْہُ ، وَإِنْ لَمْ تَرَہُ فَدَعْہُ ، وَلاَ تَنْضَحْہُ بِالْمَائِ فَإِنَّ النَّضْحَ لاَ یَزِیدُہُ إِلاَّ قَذَرًا۔","","Musannaf Ibn Abi Shaybah 916","","","كتاب الطهارة"
"917","(۹۱۷) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ ہِلاَلِ بْنِ مَیْمُونٍ قَالَ : سَأَلْتُ عَطَائَ بْنَ یَزِیدَ اللَّیْثِیَّ عَنِ الْجَنَابَۃِ تَکُونُ فِی الثَّوْبِ ؟ قَالَ : تَنْضَحُہُ بِالْمَائِ۔","","Musannaf Ibn Abi Shaybah 917","","","كتاب الطهارة"
"918","(۹۱۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَمْرِو بْنِ مَیْمُونَ ، قَالَ : سَأَلْتُ سُلَیْمَانَ بْنَ یَسَارٍ عَنِ الثَّوْبِ یُصِیبُہُ الْمَنِیُّ، أَیَغْسِلُہُ أَوْ یَغْسِلُ الثَوْبَ کُلَّہُ ؟ قَالَ سُلَیْمَانُ : قَالَتْ عَائِشَۃُ : کَانَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یُصِیبُ ثَوْبَہُ فَیَغْسِلُہُ مِنْ ثَوْبِہِ ، ثُمَّ یَخْرُجُ فِی ثَوْبِہِ إلَی الصَّلاَۃِ ، وَأَنَا أَرَی أَثَرَ الْغَسْلِ فِیہِ۔ (بخاری ۲۲۹۔ مسلم ۲۳۹)",": Sahih","Musannaf Ibn Abi Shaybah 918","","","كتاب الطهارة"
"919","(۹۱۹) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ؛ أَنَّ ابْنَ مَسْعُودٍ کَانَ یَغْسِلُ أَثَرَ الإِحْتِلاَمِ مِنْ ثَوْبِہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 919","","","كتاب الطهارة"
"920","(۹۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : اغْسِلِ الْمَنِیَّ مِنْ ثَوْبِک۔","","Musannaf Ibn Abi Shaybah 920","","","كتاب الطهارة"
"921","(۹۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ زُبَیدٍ ؛ أَنَّ ابْنَ عُمَرَ رضی اللہ عنہما غَسَلَ مَا رَأَی۔",": Sahih","Musannaf Ibn Abi Shaybah 921","","","كتاب الطهارة"
"922","(۹۲۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ قَالَتْ : لَقَدْ رَأَیْتُنِی أَجِدُہُ فِی ثَوْبِ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فَأَحُتُّہُ عَنْہُ ۔ تَعْنِی الْمَنِیَّ۔ (ابوداؤد ۳۷۵۔ مسلم ۲۳۹)",": Sahih","Musannaf Ibn Abi Shaybah 922","","","كتاب الطهارة"
"923","(۹۲۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، عَنْ مَصْعَبِ بْنِ سَعْدٍ ، عَنْ سَعْدٍ ؛ أَنَّہُ کَانَ یَفْرُکُ الْجَنَابَۃَ مِنْ ثَوْبِہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 923","","","كتاب الطهارة"
"924","(۹۲۴) حَدَّثَنَا جَرِیرٌ، عَنْ مَنْصُورٍ، عَنْ مُجَاہِدٍ، عَنْ مُصْعَبِ بْنِ سَعْدٍ، عَنْ سَعْدٍ؛ أَنَّہُ کَانَ یَفْرُکُ الْجَنَابَۃَ مِنْ ثَوْبِہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 924","","","كتاب الطهارة"
"925","(۹۲۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن ہَمَّامٍ قَالَ : نَزَلَ بِعَائِشَۃَ ضَیْفٌ فَأَمَرَتْ لَہُ بِمِلْحَفَۃٍ صَفْرَائَ ، فَاحْتَلَمَ فِیہَا ، فَاسْتَحْیَی أَنْ یُرْسِلَ بِہَا وَفِیہَا أَثَرُ الإِحْتِلاَمِ ، فَغَمَسَہَا فِی الْمَائِ ، ثُمَّ أَرْسَلَ بِہَا ، فَقَالَتْ عَائِشَۃُ : لِمَ أَفْسَدَ عَلَیْنَا ثَوْبَنَا ؟ إنَّمَا کَانَ یَکْفِیہِ أَنْ یَفْرُکَہُ بِإِصْبَعِہِ ، رُبَّمَا فَرَکْتُہُ مِنْ ثَوْبِ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ بِإِصْبَعِی۔ (ترمذی ۱۱۶۔ مسلم ۱۰۶)",": Sahih","Musannaf Ibn Abi Shaybah 925","","","كتاب الطهارة"
"926","(۹۲۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ قَالَ : بَیْنَمَا نَحْنُ عِنْدَ عَبْدِ اللہِ بْنِ عُمَرَ بَعْدَ مَا صَلَّی إذْ جَعَلَ یَدْلُکُ ثَوْبَہُ ، فَقَالَ : إنِّی طَلَبْت ہَذَا الْبَارِحَۃَ فَلَمْ أَجِدْہُ ، قَالَ مُجَاہِدٌ : مَا أُرَاہُ إِلاَّ مَنِیًّا۔",": Da'if","Musannaf Ibn Abi Shaybah 926","","","كتاب الطهارة"
"927","(۹۲۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ سَعْدِ بْنِ طَارِقٍ قَالَ : قُلْتُ لِلشَّعْبِیِّ : أَصْبَحْت وَفِی ثَوْبِی لُمْعَۃُ جَنَابَۃٍ ؟ قَالَ : اُعْرُکْہُ ثُمَّ انْفُضْہُ ، قَالَ : قُلْتُ : أَغْسِلُہُ ؟ قَالَ : تَزِیدُہُ نَتْناً ، قَالَ أَبُو مَالِکٍ : فَظَنَنْت أَنَّہُ لَوْ کَانَ رَطْبًا أَمَرَہُ بِغَسْلِہِ۔","","Musannaf Ibn Abi Shaybah 927","","","كتاب الطهارة"
"928","(۹۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی الْمَنِیِّ قَالَ : امْسَحْہُ بِإِذْخِرَۃٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 928","","","كتاب الطهارة"
"929","(۹۲۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ أَخبرنَا حَجَّاجٌ ، وَابْنُ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی الْجَنَابَۃِ تُصِیبُ الثَّوْبَ ، قَالَ : إنَّمَا ہُوَ کَالنُّخَامَۃِ ، أَوِ النُّخَاعَۃِ ، أَمِطْہُ عَنْک بِخِرْقَۃٍ ، أَوْ بِإِذْخِرَۃٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 929","","","كتاب الطهارة"
"930","(۹۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الأَعْلَی ، عَنِ ابْنِ الْحَنَفِیَّۃِ قَالَ : إِنْ کَانَ یَابِسًا فَحُتَّہُ۔","","Musannaf Ibn Abi Shaybah 930","","","كتاب الطهارة"
"931","(۹۳۱) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ؛ فِی الْجَنَابَۃِ ت??صِیبُ الثَّوْبَ ، قَالَ : یَغْسِلُہَا ، أَوْ یَمْسَحُہَا بِإِذْخِرَۃٍ۔","","Musannaf Ibn Abi Shaybah 931","","","كتاب الطهارة"
"932","(۹۳۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنِ الْعَبَّاسِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ جُبَیْرِ بْنِ نُفَیْرٍ الْحَضْرَمِیِّ ؛ أَنَّہُ أَرْسَلَ إلَی عَائِشَۃَ یَسَأَلُہَا عَنِ الْمِرْفَقَۃِ یُجَامِعُ عَلَیْہَا الرَّجُلُ ، أَیَقْرَأُ عَلَیْہَا الْمُصْحَف ؟ قَالَتْ : وَمَا یَمْنَعُک مِنْ ذَلِکَ ؟ إِنْ رَأَیْتہ فَاغْسِلْہُ ، وَإِنْ شِئْتَ فَاحْکُکْہُ ، وَإِنْ رَابَک فَرُشَّہُ۔","","Musannaf Ibn Abi Shaybah 932","","","كتاب الطهارة"
"933","(۹۳۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ خَالِدِ بْنِ أَبِی عَزَّۃَ قَالَ : سَأَلَ رَجُلٌ عُمَرَ بْنَ الْخَطَّابِ فَقَالَ : إنِّی احْتَلَمْتُ عَلَی طِنْفِسَۃٍ ؟ فَقَالَ : إِنْ کَانَ رَطْبًا فَاغْسِلْہُ ، وَإِنْ کَانَ یَابِسًا فَاحْکُکْہُ ، وَإِنْ خَفِیَ عَلَیْک فَارْشُشْہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 933","","","كتاب الطهارة"
"934","(۹۳۴) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ عَلِیِّ بْنِ زَیْدِ بْنِ جُدْعَانَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عَائِشَۃَ قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : إذَا جَلَسَ بَیْنَ الشُّعَبِ الأَرْبَعِ ، ثُمَّ أَلْزَقَ الْخِتَانَ بِالْخِتَانِ ، فَقَدْ وَجَبَ الْغُسْلُ۔ (احمد ۶/۱۳۵۔ ترمذی ۱۰۹)",": Da'if","Musannaf Ibn Abi Shaybah 934","","","كتاب الطهارة"
"935","(۹۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْیدِ اللہِ بْنِ أَبِی زِیَادٍ ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ قَالَتْ : إذَا جَاوَزَ الْخِتَانُ الْخِتَانَ فَقَدْ وَجَبَ الْغُسْلُ ، فَقَدْ کَانَ ذَلِکَ یَکُونُ مِنِّی وَمِنَ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فَنَغْتَسِلُ۔\n(احمد ۶/۱۶۱۔ ترمذی ۱۰۸)",": Da'if","Musannaf Ibn Abi Shaybah 935","","","كتاب الطهارة"
"936","(۹۳۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ أَبِی رَافِعٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ قَالَ : إذَا جَلَسَ بَیْنَ شُعَبِہَا الأَرْبَعِ ، ثُمَّ جَہَدَہَا فَقَدْ وَجَبَ الْغُسْلُ۔ (بخاری ۲۹۱۔ مسلم ۸۷)",": Sahih","Musannaf Ibn Abi Shaybah 936","","","كتاب الطهارة"
"937","(۹۳۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ یُونُسُ : وَلاَ أَعْلَمُہُ إِلاَّ قَدْ رَفَعَہُ ، قَالَ : إذَا جَلَسَ بَیْنَ فُرُوجِہَا الأَرْبَعِ ، ثُمَّ اجْتَہَدَ وَجَبَ الْغُسْلُ ، أَنْزَلَ ، أَوْ لَمْ یُنْزِلْ۔","","Musannaf Ibn Abi Shaybah 937","","","كتاب الطهارة"
"938","(۹۳۸) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَلِیٍّ قَالَ : إذَا الْتَقَی الْخِتَانَانِ فَقَدْ وَجَبَ الْغُسْلُ۔",": Da'if","Musannaf Ibn Abi Shaybah 938","","","كتاب الطهارة"
"939","(۹۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ حَنْظَلَۃَ الْجُمَحِیِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ قَالَ : قَالَ عُمَرُ : إذَا اسْتَخْلَطَ الرَّجُلُ أَہْلَہُ فَقَدْ وَجَبَ الْغُسْلُ۔",": Sahih","Musannaf Ibn Abi Shaybah 939","","","كتاب الطهارة"
"940","(۹۴۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ قَالَ : قالَتْ عَائِشَۃُ : إذَا الْتَقَی الْخِتَانَانِ فَقَدْ وَجَبَ الْغُسْلُ۔",": Sahih","Musannaf Ibn Abi Shaybah 940","","","كتاب الطهارة"
"941","(۹۴۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، وَعَنْ نَافِعٍ قَالاَ : قَالَتْ عَائِشَۃُ : إِذَا خَالَفَ الْخِتَانُ الْخِتَانَ فَقَدْ وَجَبَ الْغُسْلُ۔",": Sahih","Musannaf Ibn Abi Shaybah 941","","","كتاب الطهارة"
"942","(۹۴۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ حَبِیبِ بْنِ شِہَابٍ ، عَنْ أَبِیہِ قَالَ : قَالَ أَبُو ہُرَیْرَۃَ : إذَا غَابَتِ الْمُدَوَّرَۃُ فَقَدْ وَجَبَ الْغُسْلُ۔",": Hasan","Musannaf Ibn Abi Shaybah 942","","","كتاب الطهارة"
"943","(۹۴۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ قَالَ : أَمَّا أَنَا فَإِذَا بَلَغْتُ ذَلِکَ مِنْہَا اغْتَسَلْت۔",": Sahih","Musannaf Ibn Abi Shaybah 943","","","كتاب الطهارة"
"944","(۹۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ مَعْبَدِ بْنِ خَالِدٍ ، عَنْ عَلِیٍّ ، وَعَنْ غَالِبٍ أَبِی الْہُذَیْلِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلِیٍّ قَالَ : إذَا جَاوَزَ الْخِتَانُ الْخِتَانَ فَقَدْ وَجَبَ الْغُسْلُ۔","","Musannaf Ibn Abi Shaybah 944","","","كتاب الطهارة"
"945","(۹۴۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ بُکَیْرِ بْنِ الأَخْنَسِ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قَالَ عُمَرُ : لاَ أُوتِیَ بِرَجُلٍ فَعَلَہُ ، یَعْنِی : جَامَعَ ثُمَّ لَمْ یُنْزِلْ ، وَلَمْ یَغْتَسِلْ ، إِلاَّ نَہَکْتُہ عُقُوبَۃً۔",": Sahih","Musannaf Ibn Abi Shaybah 945","","","كتاب الطهارة"
"946","(۹۴۶) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی جَعْفَرٍ قَالَ : اجْتَمَعَ الْمُہَاجِرُونَ ؛ أَبُو بَکْرٍ ، وَعُمَرُ ، وَعُثْمَانَ ، وَعَلِیٌّ ؛ أَنَّ مَا أَوْجَبَ الْحَدَّیْنِ الْجَلْد ، وَالرَّجْم أَوْجَبَ الْغُسْلَ۔","","Musannaf Ibn Abi Shaybah 946","","","كتاب الطهارة"
"947","(۹۴۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، قَالَ : سَمِعْتُ یَقُولُ : یُوجِبُ الْقَتْلَ وَالرَّجْمَ ، وَلاَ یُوجِبُ إنَائً مِنْ مَائٍ؟","","Musannaf Ibn Abi Shaybah 947","","","كتاب الطهارة"
"948","(۹۴۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ شُرَیْحٌ : أَیُوجِبُ أَرْبَعَۃَ آلاَفٍ ، وَلاَ یُوجِبُ إنَائً مِنْ مَائٍ ؟ یَعْنِی : الَّذِی یُخَالِطُ ، ثُمَّ لاَ یُنْزِلُ۔","","Musannaf Ibn Abi Shaybah 948","","","كتاب الطهارة"
"949","(۹۴۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الشَّعْبِیِّ قَالَ : قَالَ شُرَیْحٌ : یُوجِبُ أَرْبَعَۃَ آلاَفٍ ، وَلاَ یُوجِبُ إنَائً مِنْ مَائٍ ؟ یَعْنِی : الَّذِی یُخَالِطُ ، ثُمَّ لاَ یُنْزِلُ۔","","Musannaf Ibn Abi Shaybah 949","","","كتاب الطهارة"
"950","(۹۵۰) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ قَالَ : سَأَلْتُ عَبِیْدَۃَ : مَا یُوجِبُ الْغُسْلَ ؟ قَالَ : الْخِلاَطُ وَالدَّفْقُ۔","","Musannaf Ibn Abi Shaybah 950","","","كتاب الطهارة"
"951","(۹۵۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ وَہِشَامٌ ، عَنْ مُحَمَّدٍ ، عَنْ عَبِیْدَۃَ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 951","","","كتاب الطهارة"
"952","(۹۵۲) حَدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاق ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ مَعْمَرِ بْنِ أَبِی حُیَیَّۃَ ، مَوْلَی ابْنَۃِ صَفْوَانَ ، عَنْ عُبَیْدِ بْنِ رِفَاعَۃَ بْنِ رَافِعٍ ، عَنْ أَبِیہِ رِفَاعَۃَ بْنِ رَافِعٍ ؛ قَالَ : بَیْنَا أَنَا عِنْدَ عُمَرَ بْنِ الْخَطَّابِ إذْ دَخَلَ عَلَیْہِ رَجُلٌ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، ہَذَا زَیْدُ بْنُ ثَابِتٍ یُفْتِی النَّاسَ فِی الْمَسْجِدِ بِرَأْیِہِ فِی الْغُسْلِ مِنَ الْجَنَابَۃِ ، فَقَالَ عُمَرُ : عَلَیَّ بِہِ ، فَجَائَ زَیْدٌ ، فَلَمَّا رَآہُ عُمَرُ قَالَ : أَیْ عَدُوَّ نَفْسِہِ ، قَدْ بَلَغْتَ أَنْ تُفْتِیَ النَّاسَ بِرَأْیِکَ ؟ فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، بِاللَّہِ مَا فَعَلْتُ ، ولَکِنِّی سَمِعْتُ مِنْ أَعْمَامِی حَدِیثًا ، فَحَدَّثْتُ بِہِ ؛ مِنْ أَبِی أَیُّوبَ ، وَمِنْ أُبَیِّ بْنِ کَعْبٍ ، وَمِنْ رِفَاعَۃَ بْنِ رَافِعٍ ، فَأَقْبَلَ عُمَرُ عَلَی رِفَاعَۃَ بْنِ رَافِعٍ فَقَالَ : وَقَدْ کُنْتُمْ تَفْعَلُونَ ذَلِکَ ، إذَا أَصَابَ أَحَدُکُمْ مِنَ الْمَرْأَۃِ فَأَکْسَلَ لَمْ یَغْتَسِلْ ؟ فَقَالَ : قَدْ کُنَّا نَفْعَلُ ذَلِکَ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، فَلَمْ یَأْتِنَا مِنَ اللہِ فِیہِ تَحْرِیمٌ ، وَلَمْ یَکُنْ مِنْ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فِیہِ نَہْیٌ ، قَالَ : ورَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَعْلَمُ ذَاکَ ؟ قَالَ : لاَ أَدْرِی ، فَأَمَرَ عُمَرُ بِجَمْعِ الْمُہَاجِرِینَ وَالأَنْصَارِ ، فَجُمِعُوا لَہُ ، فَشَاوَرَہُمْ ، فَأَشَارَ النَّاسُ ، أَنْ لاَ غُسْلَ فِی ذَلِکَ ، إِلاَّ مَا کَانَ مِنْ مُعَاذٍ ، وَعَلِیٍّ ، فَإِنَّہُمَا قَالاَ : إذَا جَاوَزَ الْخِتَانُ الْخِتَانَ فَقَدْ وَجَبَ الْغُسْلُ ، فَقَالَ عُمَرُ : ہَذَا وَأَنْتُمْ أَصْحَابُ بَدْرٍ ، وَقَدِ اخْتَلَفْتُمْ ، فَمَنْ بَعْدَکُمْ أَشَدُّ اخْتِلاَفًا ، قَالَ : فَقَالَ عَلِیٌّ : یَا أَمِیرَ الْمُؤْمِنِینَ ، إِنَّہُ لَیْسَ أَحَدٌ أَعْلَمَ بِہَذَا مِنْ شَأْنِ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، مِنْ أَزْوَاجِہِ ، فَأَرْسَلَ إلَی حَفْصَۃَ فَقَالَتْ : لاَ عِلْمَ لِی بِہَذَا ، فَأَرْسَلَ إلَی عَائِشَۃَ فَقَالَتْ : إذَا جَاوَزَ الْخِتَانُ الْخِتَانَ فَقَدْ وَجَبَ الْغُسْلُ ، فَقَالَ عُمَرُ : لاَ أَسْمَعُ بِرَجُلٍ فَعَلَ ذَلِکَ ، إِلاَّ أَوْجَعْتُہُ ضَرْبًا۔ (احمد ۵/۱۱۵)",": Hasan","Musannaf Ibn Abi Shaybah 952","","","كتاب الطهارة"
"953","(۹۵۳) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ شُعْبَۃَ ، عَنْ سَیْفِ بْنِ وَہْبٍ ، عَنْ أَبِی حَرْبِ بْنِ أَبِی الأَسْوَدِ الدِّیلی ، عَنْ عَمِیرَۃَ بْنِ یَثْرِبِی ، عَنْ أُبَیٍّ قَالَ : إذَا الْتَقَی مُلْتَقَاہُمَا مِنْ وَرَائِ الْخِتَانِ وَجَبَ الْغُسْلُ۔",": Da'if","Musannaf Ibn Abi Shaybah 953","","","كتاب الطهارة"
"954","(۹۵۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ کَعْبٍ ، عَنْ مَحْمُودِ بْنِ لَبِیدٍ قَالَ : سَأَلْتُ زَیْدَ بْنَ ثَابِتٍ عَنِ الرَّجُلِ یُجَامِعُ ، ثُمَّ لاَ یُنْزِلُ ؟ قَالَ : عَلَیْہِ الْغُسْلُ ، قَالَ : قُلْتُ لَہُ : إنَّ أُبَیًّا کَانَ لاَ یَرَی ذَلِکَ ، فَقَالَ : إنَّ أُبَیًّا نَزَعَ عَنْ ذَلِکَ قَبْلَ أَنْ یَمُوتَ۔",": Hasan","Musannaf Ibn Abi Shaybah 954","","","كتاب الطهارة"
"955","(۹۵۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ یَقُولُ : أَمَّا أَنَا فَإِذَا خَالَطْت أَہْلِی اغْتَسَلْتُ۔",": Sahih","Musannaf Ibn Abi Shaybah 955","","","كتاب الطهارة"
"956","(۹۵۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : إذَا جَاوَزَ الْخِتَانُ الْخِتَانَ وَجَبَ الْغُسْلُ۔",": Sahih","Musannaf Ibn Abi Shaybah 956","","","كتاب الطهارة"
"957","(۹۵۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَہْلِ بْنِ سَعْدٍ قَالَ : إنَّمَا کَانَ قَوْلُ الأَنْصَارِ : الْمَائُ مِنَ الْمَائِ : أَنَّہَا کَانَتْ رُخْصَۃً فِی أَوَّلِ الأَسْلاَمِ ، ثُمَّ کَانَ الْغُسْلُ بَعْدُ۔",": Sahih","Musannaf Ibn Abi Shaybah 957","","","كتاب الطهارة"
"958","(۹۵۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ،عَنْ شُعبۃ ، عَنْ أَبِی عَوْنٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ؛ أَنَّہُ سَمِعَہُ مِنْ عُمَرَ ، أَوْ مِنْ أَخِیہِ سَمِعَہُ مِنْ عُمَرَ ، قَالَ : إذَا جَاوَزَ الْخِتَانُ الْخِتَانَ فَقَدْ وَجَبَ الْغُسْلُ۔","","Musannaf Ibn Abi Shaybah 958","","","كتاب الطهارة"
"959","(۹۵۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی عَبْدِ اللہِ الشَّامِیِّ ، قَالَ : سَمِعْتُ النُّعْمَانَ بْنَ بَشِیرٍ یَقُولُ ؛ فِی الرَّجُلِ إذَا أَکْسَلَ فَلَمْ یُنْزِلْ ، قَالَ : یَغْتَسِلُ۔",": Da'if","Musannaf Ibn Abi Shaybah 959","","","كتاب الطهارة"
"960","(۹۶۰) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ الرَّازِیّ ، عَنْ حَنْظَلَۃَ قَالَ : قِیلَ لِلْقَاسِمِ : إنَّ الأَنْصَارَ لاَ یَغْتَسِلُونَ إِلاَّ مِن الْمَائِ، فَقَالَ : لَکِنَّا نَعُوذُ بِاللَّہِ أَنْ نَصْنَعَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 960","","","كتاب الطهارة"
"961","(۹۶۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : إذَا الْتَقَی الْخِتَانَانِ وَتَوَارَتِ الْحَشَفَۃُ فَقَدْ وَجَبَ الْغُسْلُ۔ (احمد ۲/۱۷۸۔ ابن ماجہ ۶۱۱)","","Musannaf Ibn Abi Shaybah 961","","","كتاب الطهارة"
"962","(۹۶۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن عَطَائِ بْنِ یَسَارٍ ، عَنْ زَیْدٍ بْنِ خَالِدٍ الْجُہَنِیِّ ؛ سَأَلَ خَمْسَۃً مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فَکُلُّہُمْ یَقُولُ : الْمَائُ مِنَ الْمَائِ ، مِنْہُمْ عَلِیُّ بْنُ أَبِی طَالِبٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 962","","","كتاب الطهارة"
"963","(۹۶۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ رَجُلٍ مِنْ أَہْلِ الْجَدْرِ ، عَنِ ابْنِ عَبَّاسٍ ؛ الْمَائُ مِنَ الْمَائِ۔",": Da'if","Musannaf Ibn Abi Shaybah 963","","","كتاب الطهارة"
"964","(۹۶۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنْ أَبِیہِ قَالَ : قَالَ عَبْدُ اللہِ : الْمَائُ مِنَ الْمَائِ۔",": Sahih","Musannaf Ibn Abi Shaybah 964","","","كتاب الطهارة"
"965","(۹۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سُلَیْمِ بْنِ عَبْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ ؛ قَالَ : الْمَائُ مِنَ الْمَائِ۔",": Sahih","Musannaf Ibn Abi Shaybah 965","","","كتاب الطهارة"
"966","(۹۶۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ ذَکْوَانَ ، عَنْ أَبِی سَعِیدٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ مَرَّ عَلَی رَجُلٍ مِنَ الأَنْصَارِ فَأَرْسَلَ إلَیْہِ فَخَرَجَ وَرَأْسُہُ یَقْطُرُ ، فَقَالَ : لَعَلَّنَا أَعْجَلْنَاک ؟ فَقَالَ : نَعَمْ یَا رَسُولَ اللہِ ، قَالَ: إذَا أُعْجِلْت ، أَوْ أُقْحِطْتَ فَعَلَیْک الْوُضُوئُ ، وَلاَ غُسْلَ عَلَیْک۔(بخاری ۱۸۰۔ احمد ۳/۲۱)",": Sahih","Musannaf Ibn Abi Shaybah 966","","","كتاب الطهارة"
"967","(۹۶۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ خَرَشَۃَ بْنِ حَبِیبٍ ، عَنْ عَلِیٍّ ، أَنَّہُ قَالَ فِی الْغُسْلِ مِنَ الْجِمَاعِ إذَا لَمْ یُنْزِلْ ، فَلَمْ یَغْتَسِلْ ؟ قِیلَ : وَإِنْ ہَزَّہَا بِہِ ؟ قَالَ : وَإِنْ ہَزَّہَا بِہِ حَتَّی یَہْتَزَّ قُرْطَاہَا۔",": Da'if","Musannaf Ibn Abi Shaybah 967","","","كتاب الطهارة"
"968","(۹۶۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، قَالَ : سَمِعْتُ ہِلالاً یُحَدِّثُ ، عَنِ الْمُرَقِّعِ ، عَنْ أُمِّ وَلَدٍ لِسَعْدِ بْن أَبِی وَقَّاصٍ ؛ أَنَّ سَعْدًا کَانَ یَأْتِیہَا ، فَإِذَا لَمْ یُنْزِلْ لَمْ یَغْتَسِلْ۔",": Da'if","Musannaf Ibn Abi Shaybah 968","","","كتاب الطهارة"
"969","(۹۶۹) حَدَّثَنَا سُوَیْد بْنِ عَمْرٍو ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ أَبِی أَیُّوبَ ، عَنْ أُبَیِّ بْنِ کَعْبٍ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لَیْسَ فِی الإِکْسَالِ إِلاَّ الطَّہُورُ۔\n(احمد ۵/۱۱۳۔ بخاری ۲۹۳)",": Sahih","Musannaf Ibn Abi Shaybah 969","","","كتاب الطهارة"
"970","(۹۷۰) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ شَیْبَانَ ، عَنْ یَحْیَی ، عَنْ أَبِی سَلَمَۃَ ؛ أَنَّ عَطَائَ بْنَ یَسَارٍ أَخْبَرَہُ ، أَنَّ زَیْدَ بْنَ خَالِدٍ الْجُہَنِیَّ أَخْبَرَہُ ، أَنَّہُ سَأَلَ عُثْمَانَ بْنَ عَفَّانَ ، قَالَ : قُلْتُ : أَرَأَیْت إذْا جَامَعَ الرَّجُلُ الْمَرْأَۃَ فَلَمْ یُمْنِ ؟ فَقَالَ عُثْمَانُ : یَتَوَضَّأُ کَما یَتَوَضَّأُ لِلصَّلاَۃِ ، وَیَغْسِلُ ذَکَرَہُ ، وَقَالَ عُثْمَانُ : سَمِعْتُ مِنْ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : وَسَأَلْتُ عَنْ ذَلِکَ عَلِیًّا وَالزُّبَیْرَ وَطَلْحَۃَ وَأُبَیَّ بْنَ کَعْبٍ فَأَمَرُوہُ بِذَلِکَ۔\n(بخاری ۱۷۹۔ مسلم ۲۷۰)",": Sahih","Musannaf Ibn Abi Shaybah 970","","","كتاب الطهارة"
"971","(۹۷۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یْزِید بْنِ أَبِی زِیَادٍ ، قَالَ : حدَّثَنِی عَبْدُ الرَّحْمَنِ بْنُ أَبِی لَیْلَی ، عَنْ عَلِیٍّ ، قَالَ : سُئِلَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ عَنِ الْمَذْیِ ؟ فَقَالَ : فِیہِ الْوُضُوئُ ، وَفِی الْمَنِیِّ الْغُسْلُ۔ (ترمذی ۱۱۴۔ احمد ۱۲۱)",": Da'if","Musannaf Ibn Abi Shaybah 971","","","كتاب الطهارة"
"972","(۹۷۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنِ الْحَسَنِ ، عَنْ عَلِیٍّ ، قَالَ : کُنْتُ أَجِدُ مَذْیًا فَأَمَرْتُ الْمِقْدَادَ أَنْ یَسْأَلَ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ عَنْ ذَلِکَ ، لأَنَّ ابْنَتَہُ عِنْدِی فَاسْتَحْیَیْت أَنْ أَسْأَلَہُ ، فَسَأَلَہُ ، فَقَالَ : إنَّ کُلَّ فَحْلٍ یُمْذِی فَإِذَا کَانَ الْمَنِیُّ فَفِیہِ الْغُسْلُ ، وَإِذَا کَانَ الْمَذْیُ فَفِیہِ الْوُضُوئُ۔",": Hasan","Musannaf Ibn Abi Shaybah 972","","","كتاب الطهارة"
"973","(۹۷۳) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الأَعْمَشِ ، عَنْ مُنْذِرٍ ، عَنْ مُحَمَّدِ بْنِ الْحَنَفِیَّۃِ ، قَالَ : سَمِعْتُہُ یُحَدِّثُ ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِ حَدِیثِ الْحَسَنِ۔ (بخاری ۱۳۲۔ مسلم ۱۸)",": Sahih","Musannaf Ibn Abi Shaybah 973","","","كتاب الطهارة"
"974","(۹۷۴) حَدَّثَنَا مُحَمَّدُ بْنِ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ مُصْعَبِ بْنِ شَیْبَۃَ ، عَنْ أَبِی حَبِیبِ بْنِ یَعْلَی بْنِ مُنْیَۃ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ أَتَی أُبَیًّا وَمَعَہُ عُمَرُ ، فَخَرَجَ عَلَیْہِمَا فَقَالَ : إنِّی وَجَدْتُ مَذْیًا فَغَسَلْتُ ذَکَرِی وَتَوَضَّأْت ، فَقَالَ عُمَرُ : أَوَ یُجْزِئُک ذَلِکَ ؟ قَالَ : نَعَمْ ، قَالَ : سَمِعْتَہُ مِنَ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : نَعَمْ۔ (ابن ماجہ ۵۰۷)",": Da'if","Musannaf Ibn Abi Shaybah 974","","","كتاب الطهارة"
"975","(۹۷۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ سُلَیْمَانَ بْنِ مُسْہِرٍ ، عَنْ خَرَشَۃَ بْنِ الْحُرِّ ، قَالَ : سُئِلَ عُمَر عَنِ الْمَذْیِ ؟ فَقَالَ : ذَاکَ الْفَطْر ، وَمِنْہُ الْوُضُوئُ۔",": Sahih","Musannaf Ibn Abi Shaybah 975","","","كتاب الطهارة"
"976","(۹۷۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ النَّہْدِیِّ ، أَنَّ سلمَانَ بْنَ رَبِیعَۃَ تَزَوَّجَ امْرَأَۃً مِنْ بَنِی عُقَیْلٍ ، فَرَآہَا فَلاَعَبَہَا ، قَالَ : فَخَرَجَ مِنْہُ مَا یَخْرُجُ مِنَ الرَّجُلِ - قَالَ سُلَیْمَانُ : أَوَ قَالَ : الْمَذْیُ - قَالَ : فَاغْتَسَلْتُ ، ثُمَّ أَتَیْتُ عُمَرَ ، فَسَأَلتُہُ ؟ فَقَالَ : لَیْسَ عَلَیْک فِی ذَلِکَ غُسْلٌ ، ذَلِکَ النُّشُر۔",": Sahih","Musannaf Ibn Abi Shaybah 976","","","كتاب الطهارة"
"977","(۹۷۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ عُبَیْدِ بْنِ السَّبَّاقِ ، عَنْ أَبِیہِ ، عَنْ سَہْلِ بْنِ حُنَیْفٍ ، قَالَ : کُنْتُ أَلْقَی مِنَ الْمَذْیِ شِدَّۃً ، فَأُکْثِرُ مِنْہُ الاغْتِسَالَ ، فَسَأَلْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنَّمَا یُجْزِئُکَ مِنْ ذَلِکَ الْوُضُوئُ۔",": Hasan","Musannaf Ibn Abi Shaybah 977","","","كتاب الطهارة"
"978","(۹۷۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : الْمَنِیُّ یُغْتَسَلُ مِنْہُ ، وَالْمَذْیُ یَغْسِلُ مِنْہُ فَرْجَہُ وَیَتَوَضَّأُ ، وَالَّذِی مِنَ الشَّہْوَۃِ لاَ أَدْرِی مَا ہُوَ؟۔",": Sahih","Musannaf Ibn Abi Shaybah 978","","","كتاب الطهارة"
"979","(۹۷۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ عَمِّہِ أَبِی الْمُہَلَّبِ ، قَالَ : کَانَ مِنْ أَہْلِہِ إنْسَانٌ یَغْتَسِلُ مِنَ الَّذیِ یَخْرُجُ بَعْدَ الْبَوْلِ ، فَقَالَ لَہُ : أَمَا إنَّ الْوُضُوئَ یُجْزِیء عَنْہُ۔","","Musannaf Ibn Abi Shaybah 979","","","كتاب الطهارة"
"980","(۹۸۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الْقَاسِمِ ، قَالَ : الَّذی مِنَ الشَّہْوَۃِ لاَ أَدْرِی مَا ہُوَ ؟۔","","Musannaf Ibn Abi Shaybah 980","","","كتاب الطهارة"
"981","(۹۸۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : ذَکَرُوا عِنْدَ ابْنِ عُمَرَ الْبِلَّۃَ ، وَالْمَذْیَ ، وَبَعْضَ مَا یَجِدُ الرَّجُلُ ، فَقَالَ : إنَّکُمْ لَتَذْکُرُونَ شَیْئًا مَا أَجِدُہُ ، وَلَوْ وَجَدْتُہ لاَغْتَسَلْت مِنْہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 981","","","كتاب الطهارة"
"982","(۹۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ ، عَنْ عَبْدِ رَبِّہِ بْنِ مُوسَی ، عَنْ أُمِّہِ ، عَنْ عَائِشَۃَ ، قَالَتِ : الْمَنِیُّ مِنْہُ الْغُسْلُ ، وَالْمَذْیُ وَالْوَدْیُ یُتَوَضَّأُ مِنْہُمَا۔",": Da'if","Musannaf Ibn Abi Shaybah 982","","","كتاب الطهارة"
"983","(۹۸۳) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّہُ سُئِلَ عَنِ الْمَذْیِ ؟ فَقَالَ : ذَاکَ النَّشَاطُ ، فِیہِ الْوُضُوئُ۔",": Da'if","Musannaf Ibn Abi Shaybah 983","","","كتاب الطهارة"
"984","(۹۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْتَبْرَقَ ، قَالَ : سَأَلْتُ سَالِمًا عَنِ الْمَذْیِ ؟ فَقَالَ : یُتَوَضَّأُ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 984","","","كتاب الطهارة"
"985","(۹۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ وَعُمَرَ بْنِ الْوَلِیدِ الشَّنِّیِّ ، عَنْ عِکْرِمَۃَ ، قَالَ : الْمَنِیُّ وَالْوَدْیُ وَالْمَذْیُ، فَأَمَّا الْمَنِیُّ فَفِیہِ الْغُسْلُ ، وَأَمَّا الْمَذْیُ وَالْوَدْیُ فَیَغْسِلُ ذَکَرَہُ وَیَتَوَضَّأُ۔","","Musannaf Ibn Abi Shaybah 985","","","كتاب الطهارة"
"986","(۹۸۶) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سِمَاکٍ ، قَالَ : قُلْتُ لِلْحَسَنِ الْبَصْرِیِّ : أَرَأَیْت الرَّجُلَ إذَا أَمْذَی کَیْفَ یَصْنَعُ؟ فَقَالَ : کُلُّ فَحْلٍ یُمْذِی ، فَإِذَا کَانَ ذَلِکَ فَلْیَغْسِلْ ذَکَرَہُ۔","","Musannaf Ibn Abi Shaybah 986","","","كتاب الطهارة"
"987","(۹۸۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، قَالَ : الْمَنِیُّ وَالْوَدْیُ وَالْمَذْیُ ، فَفِی الْمَنِیِّ الْغُسْلُ ، وَالْوَدْیِ وَالْمَذْیِ الْوُضُوئُ۔","","Musannaf Ibn Abi Shaybah 987","","","كتاب الطهارة"
"988","(۹۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زِیَادِ بْنِ فَیَّاضٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ قَالَ فِی الْمَذْیِ : یَغْسِلُ الْحَشَفَۃَ ثَلاَثًا ، وَیَتَوَضَّأُ۔","","Musannaf Ibn Abi Shaybah 988","","","كتاب الطهارة"
"989","(۹۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الْمَنِیُّ وَالْوَدْیُ وَالْمَذْیُ ، فَأَمَّا الْمَنِیُّ فَفِیہِ الْغُسْلُ ، وَأَمَّا الْمَذْیُ وَالْوَدْیُ فَفِیہِمَا الْوُضُوئُ ، وَیَغْسِلُ ذَکَرَہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 989","","","كتاب الطهارة"
"990","(۹۹۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنِ الرُّکَیْنِ ، عَنْ حُصَیْنِ بْنِ قَبِیصَۃَ الْفَزَارِیِّ ، عَنْ عَلِیٍّ ، قَالَ : کُنْتُ رَجُلاً مَذَّائً ، وَکَانَتْ تَحْتِی بِنْتُ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فَکُنْت أَسْتَحْیِی أَنْ أَسْأَلَہُ ، فَأَمَرْتُ رَجُلاً فَسَأَلَہُ ؟ فَقَالَ : إذَا رَأَیْتَ الْمَذْیَ فَتَوَضَّأْ وَاغْسِلْ ذَکَرَک ، وَإِذَا رَأَیْت فَضْخَ الْمَائِ فَاغْتَسِلْ۔\n(احمد ۱/۱۲۵۔ نسائی ۲۰۰)",": Sahih","Musannaf Ibn Abi Shaybah 990","","","كتاب الطهارة"
"991","(۹۹۱) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَنِ الرُّکَیْنِ ، عَنْ حُصَیْنِ بْنِ قَبِیصَۃَ ، عَنْ عَلِیٍّ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ؛ بِمِثْلِہِ۔ (ابوداؤد ۲۰۸۔ ابن حبان ۱۱۰۷)",": Sahih","Musannaf Ibn Abi Shaybah 991","","","كتاب الطهارة"
"992","(۹۹۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنِ أَبِی حَصِینٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ عَلِیٍّ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ؛ بِمِثْلِہِ۔ (بخاری ۲۶۹۔ احمد ۱/۱۲۵)",": Sahih","Musannaf Ibn Abi Shaybah 992","","","كتاب الطهارة"
"993","(۹۹۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنِ الْحَارِثِ بْنِ شُبَیْلٍ ، قَالَ : قَالَ عَلِیٌّ : کُنْتُ رَجُلاً مَذَّائً فَکُنْت إذَا رَأَیْتُ شَیْئًا مِنْ ذَلِکَ اغْتَسَلْت ، فَبَلَغَ ذَلِکَ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فَأَمَرَنِی أَنْ أَتَوَضَّأَ۔",": Sahih","Musannaf Ibn Abi Shaybah 993","","","كتاب الطهارة"
"994","(۹۹۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عَطَائٍ ؛ فِیمَا یُصِیبُ الْمَرْأَۃَ مِنْ مَائِ زَوْجِہَا تَغْسِلُہُ ، وَلاَ تَغْسِلُ إِلاَّ أَنْ یَدْخُلَ الْمَائُ فَرْجَہَا ، فَإِنْ دَخَلَ فَلْتَغْتَسِلْ۔","","Musannaf Ibn Abi Shaybah 994","","","كتاب الطهارة"
"995","(۹۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یُجَامِعُ امْرَأَتَہُ دُونَ فَرْجِہَا ، قَالَ : یَغْتَسِلُ وَتَغْسِلُ فَرْجَہَا ، إِلاَّ أَنْ تُنْزِلَ۔","","Musannaf Ibn Abi Shaybah 995","","","كتاب الطهارة"
"996","(۹۹۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ فِی الرَّجُلِ یَحْتَلِمُ وَامْرَأَتُہُ إلَی جَنْبِہِ فَیُصِیبُہَا مِنْ مَائِہِ ، إِنَّہُ لَیْسَ عَلَیْہَا غُسْلٌ ، وَتَغْسِلُ حَیْثُ أَصَابَہَا ، إِلاَّ أَنْ یُصِیبَ فَرْجَہَا ، فَتَغْتَسِلَ ۔","","Musannaf Ibn Abi Shaybah 996","","","كتاب الطهارة"
"997","(۹۹۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ زَکَرِیَّا ، عَنْ فِرَاسٍ ، قَالَ : اشْتَرَیْت جَارِیَۃً صَغِیرَۃً فَکُنْت أُصِیبُ مِنْہَا مِنْ غَیْرِ أَنْ أُخَالِطَہَا ، فَسَأَلْت الشَّعْبِیَّ ؟ فَقَالَ : أَمَّا أَنْتَ فَاغْتَسِلْ ، وَأَمَّا ہِیَ فَیَکْفِیہَا الْوُضُوئُ۔","","Musannaf Ibn Abi Shaybah 997","","","كتاب الطهارة"
"998","(۹۹۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یُصِیبُ مِنَ الْمَرْأَۃِ فِی غَیْرِ فَرْجِہَا ، قَالَ : إِنْ ہِیَ أَنْزَلَتِ اغْتَسَلَتْ ، وَإِنْ ہِیَ لَمْ تُنْزِلْ تَوَضَّأَتْ وَغَسَلَتْ مَا أَصَابَ مِنْ جَسَدِہَا مِنْ مَائِ الرَّجُلِ۔","","Musannaf Ibn Abi Shaybah 998","","","كتاب الطهارة"
"999","(۹۹۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : تَنْضَحُ فَرْجَہَا وَتَتَوَضَّأُ ، فَإِنْ کَانَ دَمًا عَبیطاً عَلَیْہَا اغْتَسَلَتْ وَاحْتَشَتْ ، فَإِنَّمَا ہِیَ رَکْضَۃٌ مِنَ الشَّیْطَانِ ، فَإِذَا فَعَلَتْ ذَلِکَ مَرَّۃً ، أَوْ مَرَّتَیْنِ ذَہَبَ۔",": Da'if","Musannaf Ibn Abi Shaybah 999","","","كتاب الطهارة"
"1000","(۱۰۰۰) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا رَأَتِ الْمَرْأَۃُ بَعْدَ مَا تَطْہُرُ مِنَ الْحَیْضِ مِثْلَ غُسَالَۃِ اللَّحْمِ ، أَوْ قَطْرَۃِ الرُّعَافِ ، أَوْ فَوْقَ ذَلِکَ ، أَوْ دُونَ ذَلِکَ فَلْتَنْضَحْ بِالْمَائِ ، ثُمَّ لِتَتَوَضَّأْ وَلْتُصَلِّ ، وَلاَ تَغْتَسِلْ ، إِلاَّ أَنْ تَرَی دَمًا عَبیطاً ، فَإِنَّمَا ہِیَ رَکْضَۃٌ مِنَ الشَّیْطَانِ فِی الرَّحِمِ۔",": Da'if","Musannaf Ibn Abi Shaybah 1000","","","كتاب الطهارة"
"1001","(۱۰۰۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبَّادِ بْنِ إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ ، عَنْ عَمْرَۃَ ، قَالَتْ : کَانَتْ عَائِشَۃُ تَنْہَی النِّسَائَ أَنْ یَنْظُرْنَ إلَی أَنْفُسِہِنَّ فِی الْمَحِیضِ لَیْلاً ، وَتَقُولُ : إِنَّہُ قَدْ تَکُونُ الصُّفْرَۃُ وَالْکُدْرَۃُ۔",": Hasan","Musannaf Ibn Abi Shaybah 1001","","","كتاب الطهارة"
"1002","(۱۰۰۲) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الْمَرْأَۃِ \n تَغْتَسِلُ ، ثُمَّ تَرَی الصُّفْرَۃَ ، قَالَ : تَغْتَسِلُ وَتُصَلِّی۔","","Musannaf Ibn Abi Shaybah 1002","","","كتاب الطهارة"
