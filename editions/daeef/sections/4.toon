hadiths[400]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"609","تدرون لم سمى رمضان لأنه يرمض الذنوب","","Majmu'a Da'eef Ahadith 609","","","Reason for naming Ramadan"
"610","لا تقولوا رمضان فإنه اسم من أسماء الله ولكن قولوا شهر رمضان","","Majmu'a Da'eef Ahadith 610","","","Ramadan is Allah's name"
"611","صوموا تصحوا","","Majmu'a Da'eef Ahadith 611","","","Fasting as a source of health"
"612","لكل شىء زكاة و زكاة الجسد الصوم","","Majmu'a Da'eef Ahadith 612","","","Fasting is the zakat of the body"
"613","يسبح للصائم كل شعرة منه ويوضع للصائمين والصائمات يوم القيامة تحت العرش مائدة من ذهب","","Majmu'a Da'eef Ahadith 613","","","Golden tablecloth for the fasting person"
"614","لو أذن الله لأهل السموات والارض أن يتكلموا لبشروا صوام شهر رمضان بالجنة","","Majmu'a Da'eef Ahadith 614","","","Glad tidings from the heavens for those who fast"
"615","من أفطر يوما من رمضان من غير عذر فعليه صيام شهر","","Majmu'a Da'eef Ahadith 615","","","One who skips a fast without reason"
"616","من أفطر يوما من رمضان فليهد بدنة","","Majmu'a Da'eef Ahadith 616","","","One who skips a fast without reason"
"617","من أفطر يوما من رمضان فمات قبل أن يقضيه فعليه بكل يوم مد لمسكين","","Majmu'a Da'eef Ahadith 617","","","One who skips a fast without reason"
"618","من أفطر على تمرة من حلال زيد فى صلاته أربعمائة صلاة","","Majmu'a Da'eef Ahadith 618","","","Virtue of breaking fast with lawful dates"
"619","اذا سلم رمضان سلمت السنة","","Majmu'a Da'eef Ahadith 619","","","Ramadan's safety is safety for the whole year"
"620","ان لله فى كل يوم من رمضان ستمائة الف عتيق من النار","","Majmu'a Da'eef Ahadith 620","","","Three million freed from Hell daily in Ramadan"
"621","ان الله فى كل ليلة من رمضان عند الإفطار الف الف عتيق من النار","","Majmu'a Da'eef Ahadith 621","","","One million freed from Hell at iftar"
"622","أن للصائم عند فطره لدعوة ما ترد","","Majmu'a Da'eef Ahadith 622","","","Acceptance of supplication at iftar"
"623","ثلاثة لا يسألون عن نعيم المطعم والمشرب ؛ المفطر والمتسحر وصاحب الضيف","","Majmu'a Da'eef Ahadith 623","","","Three exempt from being asked about eating/drinking"
"624","ثلاث لا يفطرن ؛ القىء والحجامة و الاحتلام","","Majmu'a Da'eef Ahadith 624","","","Three things do not break the fast"
"625","من تأمل خلق امرأة حتى يستبين له حجم عظامها من وراء ثيابها وهو صائم فقد أفطر","","Majmu'a Da'eef Ahadith 625","","","Looking at a woman lustfully breaks the fast"
"626","صائم رمضان فى السفر كالمفطر فى الحضر","","Majmu'a Da'eef Ahadith 626","","","Fasting while traveling"
"627","من مات وعليه صيام أطعم عنه مكان كل يوم مسكينا","","Majmu'a Da'eef Ahadith 627","","","Feeding the poor in place of missed fasts for the deceased"
"628","نهى رسول الله صلى الله عليه وسلم عن صوم عرفة بعرفات","","Majmu'a Da'eef Ahadith 628","","","Prohibition of fasting on Arafah in Arafat"
"629","صوموا يوم عاشوراء وحالفوا فيه اليهود صوموا قبله يوما أو بعده يوما","","Majmu'a Da'eef Ahadith 629","","","Fasting an extra day with Ashura"
"630","الصرد أول طير صام عاشوراء","","Majmu'a Da'eef Ahadith 630","","","First bird for one who fasts on Ashura"
"631","من وسع على عياله يوم عاشوراء وسع الله عليه سائر سنته","","Majmu'a Da'eef Ahadith 631","","","Generosity to family on Ashura"
"632","من أحيا ليلة من رجب وصام يوما أطعمه الله من ثمار الجنة . . .","","Majmu'a Da'eef Ahadith 632","","","Worship on a night of Rajab"
"633","من صام ثلاثة أيام من رجب كتب الله له صيام شهر . . .","","Majmu'a Da'eef Ahadith 633","","","Three fasts in Rajab"
"634","سئل النبى صلى الله عليه وسلم أى الصوم أفضل بعد رمضان فقال شعبان","","Majmu'a Da'eef Ahadith 634","","","Best fasts after Ramadan are in Sha'ban"
"635","صوم البيض أول يوم يعدل ثلاثة آلاف سنة واليوم الثانى يعدل عشرة آلاف سنة واليوم الثالث يعدل ثلاث عشرة ألف سنة","","Majmu'a Da'eef Ahadith 635","","","Virtue of fasting on white days"
"636","من صام يوما تطوعا فلو أعطى ملء الأرض ذهبا ما وفى بأجره","","Majmu'a Da'eef Ahadith 636","","","Reward for one voluntary fast"
"637","من صام يوما تطوعا لم يطلع عليه أحد لم يرض الله له بثواب دون الجنة","","Majmu'a Da'eef Ahadith 637","","","Reward for one voluntary fast"
"638","الصائم فى عبادة وإن كان راقدا على فراشه","","Majmu'a Da'eef Ahadith 638","","","Every moment of the fasting person is worship"
"639","الحج والعمرة فريضتان","","Majmu'a Da'eef Ahadith 639","","","Hajj and Umrah are obligatory"
"640","ان تعتمر خير لك","","Majmu'a Da'eef Ahadith 640","","","Umrah is better but not obligatory"
"641","الحج جهاد والعمرة تطوع","","Majmu'a Da'eef Ahadith 641","","","Hajj is jihad"
"642","من ملك زادا وراحلة تبلغه الى بيت الله ولم يحج فلا عليه أن يموت يهوديا أو نصرانيا","","Majmu'a Da'eef Ahadith 642","","","Not performing Hajj despite ability"
"643","من تزوج قبل أن يحج فقد بدأ بالمعصية","","Majmu'a Da'eef Ahadith 643","","","Harm of marrying before Hajj"
"644","اذا خرج الحاج من بيته كان فى حرز الله فان مات قبل أن يقضى نسكه غفر الله له ما تقدم من ذنبه . . .","","Majmu'a Da'eef Ahadith 644","","","Pilgrim is under Allah's protection"
"645","لو يعلم الناس ما للحجاج من الفضل عليهم لأتوهم حتى يغسلوا أرجلهم","","Majmu'a Da'eef Ahadith 645","","","Virtue of pilgrims"
"646","أن النبى صلى الله عليه وسلم وقت لأهل المشرق العقيق","","Majmu'a Da'eef Ahadith 646","","","Aqiq is the miqat for the East"
"647","من أهل بحجة أو عمرة من المسجد الأقصى إلى المسجد الحرام غفر له ما تقدم من ذنبه وما تأخر . أو وجبت له الجنة","","Majmu'a Da'eef Ahadith 647","","","Virtue of entering ihram from Al-Aqsa Mosque"
"648","قد أصابه فى رأسه أذى فحلق فأمره النبى صلى الله عليه وسلم أن يهدى هديا بقرة","","Majmu'a Da'eef Ahadith 648","","","Shaving head in ihram requires sacrificing a cow"
"649","حججنا مع رسول الله صلى الله عليه وسلم ومعنا النساء والصبيان ، فلبينا عن الصبيان ورمينا عنهم","","Majmu'a Da'eef Ahadith 649","","","Children reciting talbiyah"
"650","أنه كان إذا فرغ من تلبيته سأل الله رضوانه والجنة واستعفاه برحمته من النار","","Majmu'a Da'eef Ahadith 650","","","Supplication after finishing talbiyah"
"651","كان اذا رأى البيت رفع يديه ثم قال : اللهم زد هذا البيت تشريفا و تعظيما وتكريما ومهابة ، وزد من شرفه وكرمه ممن حجه واعتمره تشريفا وتعظيما وتكريما وبرا","","Majmu'a Da'eef Ahadith 651","","","Supplicating upon seeing the Kaaba"
"652","للبيت رب يحميه","","Majmu'a Da'eef Ahadith 652","","","Allah protects the Kaaba"
"653","ان الله قد وعد هذا البيت أن يحجه فى كل سنة ستمائة ألف . . .","","Majmu'a Da'eef Ahadith 653","","","Allah's promise regarding the Kaaba"
"654","قال الله تعالى : اذا أردت أن اخرب الدنيا بدات ببيتى فخربته ثم اخرب الدنيا على اثره","","Majmu'a Da'eef Ahadith 654","","","First destruction of the Kaaba"
"655","رکن یمانی کے پاس ستر ہزار فرشتے مقرر کے گئے ہیں لہٰذا جس نے کہا : «اللهم انى أسئلك العفو والعافية فى الدنيا والاخرة ربنا اتنا . . . » تو تمام فرشتے آمین کہیں گے ۔ اور جس نے بیت اللہ کا طواف کیا اورصرف یہ کلمات کہے «سبحان الله ، والحمدلله ، ولا اله الا الله ، والله اكبر، ولا حول ولا قوة الا بالله» اس کی دس برائیاں مٹا دی جائیں گی ، دس نیکیاں لکھ دی جائیں گی اور دس درجے بلند کر دئیے جائیں گے ۔","","Majmu'a Da'eef Ahadith 655","","","Seventy thousand angels at Rukn Yamani and tawaf supplication"
"656","من طاف أسبوعا فى المطر غفر له ما سلف من ذنوبه","","Majmu'a Da'eef Ahadith 656","","","Virtue of tawaf for a week in rain"
"657","من توضأ فأحسن الوضوء ومشى بين الصفا والمروة كتب الله له بكل قدم سبعين ألف درجة","","Majmu'a Da'eef Ahadith 657","","","Virtue of excellent ablution and sa'i between Safa and Marwah"
"658","لا يجتمع ماء زمزم و نار جهنم فى جوف عبد أبدا . . .","","Majmu'a Da'eef Ahadith 658","","","Zamzam and Hellfire cannot be together in one belly"
"659","ان للحاج الراكب بكل خطوة تخطوها راحلته سبعين حسنة والماشى بكل خطوة يخطوها سبع مائة حسنة","","Majmu'a Da'eef Ahadith 659","","","Virtue of performing Hajj on foot"
"660","من تمام الحج ضرب الجمال","","Majmu'a Da'eef Ahadith 660","","","Completing Hajj by striking the camel"
"661","من تمام الحج أن تحرم من دويرة أهلك","","Majmu'a Da'eef Ahadith 661","","","Completing Hajj by entering ihram from one's area"
"662","مثل الذى يحج عن امتى كمثل ام موسىٰ كانت ترضعه وتأخذ الكراء من فرعون","","Majmu'a Da'eef Ahadith 662","","","Performing Hajj on behalf of another"
"663","من مات فى طريق مكة حاجا لم يعرضه الله ولم يحاسبه","","Majmu'a Da'eef Ahadith 663","","","Pilgrim dying on the way to Makkah"
"664","من مات فى أحد الحرمين استو جبت شفاعتى . . .","","Majmu'a Da'eef Ahadith 664","","","Dying in the Haramain"
"665","من قال للمدينة يثرب فليستغفر الله ثلاث مرات","","Majmu'a Da'eef Ahadith 665","","","Seek forgiveness for calling Madinah ""Yathrib"""
"666","من صلى فى مسجدى أربعين صلاة لا يفوته صلاة كتبت له براءة من النار ونجاة من العذاب وبرئ من النفاق","","Majmu'a Da'eef Ahadith 666","","","Virtue of forty prayers in the Prophet's Mosque"
"667","من زارنى بالمدينة محتسبا كنت له شهيدا وشفيعا يوم القيامة","","Majmu'a Da'eef Ahadith 667","","","Virtue of visiting the Prophet's grave"
"668","من زارنى متعمدا كان فى جوارى يوم القيامة","","Majmu'a Da'eef Ahadith 668","","","Virtue of visiting the Prophet's grave"
"669","من زارنى و زار أبى ابراهيم فى عام واحد دخل الجنة","","Majmu'a Da'eef Ahadith 669","","","Virtue of visiting the Prophet's grave"
"670","من حج حجة الاسلام و زار قبرى و غزا غزوة وصلى على فى بيت المقدس لم يسأله الله عما افترض عليه","","Majmu'a Da'eef Ahadith 670","","","Benefit of Hajj and visiting the Prophet's grave"
"671","من وجد سعة ولم يفد الى فقد جفانى","","Majmu'a Da'eef Ahadith 671","","","Not visiting the Prophet's grave despite ability"
"672","من حج عن والديه أو قضى عنهما مغرما بعثه الله يوم القيامة مع الأبرار","","Majmu'a Da'eef Ahadith 672","","","Reward of Hajj on behalf of parents"
"673","الأمراض هدايا من الله للعبد فأحب العباد الى الله اكثرهم هدية","","Majmu'a Da'eef Ahadith 673","","","Diseases are gifts from Allah"
"674","المرض ينزل جملة واحدة والبرء ينزل قليلا قليلا","","Majmu'a Da'eef Ahadith 674","","","Illness descends only once"
"675","المصيبة تبيض وجه صاحبها يوم تسود الوجوه","","Majmu'a Da'eef Ahadith 675","","","Whiteness of face in exchange for hardship"
"676","من أذهب الله بصره فى الدنيا كان حقا على الله واجبا أن لا ترى عيناه نار جهنم","","Majmu'a Da'eef Ahadith 676","","","Blindness leads to freedom from Hell"
"677","اذا مرض العبد ثلاثة أيام خرج من ذنوبه كيوم ولدته أمه","","Majmu'a Da'eef Ahadith 677","","","Reward for enduring illness for three days"
"678","لا تمار ضوا فتمر ضوا ولا تحفروا قبوركم فتموتوا","","Majmu'a Da'eef Ahadith 678","","","Pretending to be ill"
"679","خمس دعوات يستجاب لهن : دعوة المظلوم حتى ينتصر ودعوة الحاج حتى يصدر و دعوة المجاهد حتى يقعد ”ودعوة المريض حتى يبرأ“ ودعوة الأخ لأخيه بظهر الغيب ثم قال واسرع هذه الدعوات إجابة دعوة الأخ بظهر الغيب","","Majmu'a Da'eef Ahadith 679","","","Acceptance of the sick person's supplication"
"680","عودوا المرضى ومروهم فليدعوا لكم فان دعوة المريض مستجابة و ذنبه مغفور","","Majmu'a Da'eef Ahadith 680","","","Visit the sick"
"681","اذا اشتهى مريض أحدكم شيئا فليطعمه","","Majmu'a Da'eef Ahadith 681","","","Consider the patient's desire in food"
"682","من توضأ فأحسن الوضوء وعاد أخاه المسلم محتسبا يوعد من جهنم مسيرة سبعين خريفا","","Majmu'a Da'eef Ahadith 682","","","Visit the sick in a state of ablution"
"683","كان النبى صلى الله عليه وسلم لا يعود مريضا إلا بعد ثلاث","","Majmu'a Da'eef Ahadith 683","","","Visit the sick after three days"
"684","من عاد مريضا وجلس عنده ساعة أجرى الله له عمل ألف سنة . . .","","Majmu'a Da'eef Ahadith 684","","","Virtue of visiting the sick"
"685","عيادة مريض أحب الى من عبادة أربعين أو خمسين سنة","","Majmu'a Da'eef Ahadith 685","","","Visiting the sick equals forty years of worship"
"686","أغبوا فى العيادة","","Majmu'a Da'eef Ahadith 686","","","Skipping visiting the sick"
"687","ثلاث لا يعاد صاحبهن الرمد وصاحب الضرس وصاحب الدمل","","Majmu'a Da'eef Ahadith 687","","","Prohibition of visiting three types of patients"
"688","لا تعد من لا يعودك","","Majmu'a Da'eef Ahadith 688","","","Do not visit one who does not visit you"
"689","اذا دخلتم على المريض فنفسوا له فى أجله فإن ذالك لا يرد شيئا ويطيب نفسه","","Majmu'a Da'eef Ahadith 689","","","Comforting the patient"
"690","من مات مريضا مات شهيدا","","Majmu'a Da'eef Ahadith 690","","","Martyrdom for the dying patient"
"691","موت الغريب شهادة","","Majmu'a Da'eef Ahadith 691","","","Martyrdom for the dying traveler"
"692","أنه استعاذ من سبع موتات : موت الفجأة ومن لدغ الحية ومن السبع ومن الغرق ومن الحرق ومن أن يخر على شىء أو يخر عليه شىء ومن القتل عند فرار الزحف","","Majmu'a Da'eef Ahadith 692","","","Seeking refuge from seven types of death"
"693","كان يتعوذ من موت الفجأة وكان يعجبه أن يمرض قبل أن يموت","","Majmu'a Da'eef Ahadith 693","","","Seeking refuge from sudden death and wishing for death in illness"
"694","كفى بالموت واعظا","","Majmu'a Da'eef Ahadith 694","","","Death is sufficient as a reminder"
"695","المحروم من حرم وصيته","","Majmu'a Da'eef Ahadith 695","","","Deprived of will is truly deprived"
"696","اپنے مرنے والوں کو یہ کلمات کہنے کی تلقین کرو، «لا اله الا الله الحليم الكريم سبحان الله رب العرش العظيم الحمد لله رب العالمين»","","Majmu'a Da'eef Ahadith 696","","","Prompting the dying"
"697","من مات فى بيت المقدس فكأنما مات فى السماء","","Majmu'a Da'eef Ahadith 697","","","Death in Jerusalem"
"698","لو أن قطرة من الم الموت وضعت على جبال الأرض كلها لذابت","","Majmu'a Da'eef Ahadith 698","","","Severity of the Angel of Death"
"699","إن نفس المؤمن اذا قبضت تلقاها أهل الرحمة . . .","","Majmu'a Da'eef Ahadith 699","","","Departure of the believer's soul"
"700","الموت كفارة لكل مسلم","","Majmu'a Da'eef Ahadith 700","","","Death as expiation for sins"
"701","الموت كفارة للمؤمن","","Majmu'a Da'eef Ahadith 701","","","Death as expiation for sins"
"702","اقرأوا على موتاكم يٰسٓ","","Majmu'a Da'eef Ahadith 702","","","Reciting Surah Yasin near the dying"
"703","ما من ميت يموت فيقرأ عنده (يٰسٓ) إلا هون الله عليه","","Majmu'a Da'eef Ahadith 703","","","Reciting Surah Yasin near the dying"
"704","إن أعمالكم تعرض على أقاربكم وعشائركم من الأموات فإن كان خيرا استبشروا وإن كان غير ذالك اللهم لا تمتهم حتى تهديهم كما هديتنا","","Majmu'a Da'eef Ahadith 704","","","Deeds presented to relatives"
"705","لا تفضحوا أمواتكم بسيئات أعمالكم فإنها تعرض على أوليائكم من أهل القبور","","Majmu'a Da'eef Ahadith 705","","","Deeds presented to relatives"
"706","من استرجع عند المصيبة جبر الله مصيبته وأحسن عقباه وجعل له خلفا يرضاه","","Majmu'a Da'eef Ahadith 706","","","Saying ""Inna lillah"" at calamity"
"707","أعطيت أمتى شيئا لم يعطه أحد من الأمم عند المصيبة : إنا لله وإنا اليه راجعون","","Majmu'a Da'eef Ahadith 707","","","Saying ""Inna lillah"" at calamity"
"708","الميت ينضح عليه الحميم ببكاء الحى","","Majmu'a Da'eef Ahadith 708","","","Torture to the deceased due to wailing"
"709","ثلاث لا تؤخروهن . . . الجنازة اذا حضرت . . .","","Majmu'a Da'eef Ahadith 709","","","Do not delay in carrying the funeral"
"710","لا ينبغى لجيفة مسلم أن تحبس بين ظهرانى أهله","","Majmu'a Da'eef Ahadith 710","","","Do not delay in carrying the funeral"
"711","افعلوا بموتاكم كما تفعلون بعروسكم","","Majmu'a Da'eef Ahadith 711","","","Treating the dead like brides"
"712","من غسل ميتا خرج من ذنوبه كيوم ولدته أمه","","Majmu'a Da'eef Ahadith 712","","","Virtue of washing the deceased"
"713","اذا ماتت المرأة مع الرجال ليس معهم امرأة غيرها والرجل مع النساء ليس معهن رجل غيره فإنهما ييممان ويدفنان وهما بمنزلة من لايجد الماء","","Majmu'a Da'eef Ahadith 713","","","If a woman dies among men or vice versa"
"714","أن فاطمة رضى الله عنها غسلت نفسها قبل موتها ولبست كفنها فاكتفى على رضى الله عنه بذالك","","Majmu'a Da'eef Ahadith 714","","","Lady Fatima washed herself"
"715","اغسلوا قتلاكم","","Majmu'a Da'eef Ahadith 715","","","Wash the martyrs"
"716","لا تبرز فخذك ولا تنظر إلى فخذ حيى ولا ميت","","Majmu'a Da'eef Ahadith 716","","","Do not look at the thigh of living or dead"
"717","لا تغالوا فى الكفن فإنه يسلب سريعا","","Majmu'a Da'eef Ahadith 717","","","Giving fine and valuable shroud"
"718","حسنوا أكفان موتاكم فإنهم يتزاورون فى القبور","","Majmu'a Da'eef Ahadith 718","","","Giving fine and valuable shroud"
"719","أن النبى صلى الله عليه وسلم كفن فى سبعة أثواب","","Majmu'a Da'eef Ahadith 719","","","Prophet was shrouded in seven garments"
"720","أنه رأى جنازة يسرعون بها فقال لتكن عليكم السكينة","","Majmu'a Da'eef Ahadith 720","","","Speed in carrying the funeral"
"721","ما دون الخبب","","Majmu'a Da'eef Ahadith 721","","","Speed in carrying the funeral"
"722","من اتبع جنازة فليحمل بجوانب السرير كلها","","Majmu'a Da'eef Ahadith 722","","","Shoulder all sides of the bier when walking"
"723","من حمل جوانب السرير الأربع كفر الله عنه أربعين كبيرة","","Majmu'a Da'eef Ahadith 723","","","Shoulder all sides of the bier when walking"
"724","زودوا موتاكم لا اله الا الله","","Majmu'a Da'eef Ahadith 724","","","Reciting kalima while walking with the funeral"
"725","لم يكن يسمع من رسول الله صلى الله عليه وسلم وهو يمشى خلف الجنازة الا قول لا اله الا الله","","Majmu'a Da'eef Ahadith 725","","","Reciting kalima while walking with the funeral"
"726","اول ما يجازى به العبد بعد موته أن يغفر لجميع من اتبع جنازته","","Majmu'a Da'eef Ahadith 726","","","Forgiveness for those who walk with the funeral"
"727","كرامة المؤمن على الله أن يغفر لمشيعه","","Majmu'a Da'eef Ahadith 727","","","Forgiveness for those who walk with the funeral"
"728","الا تستحيون إن ملائكة الله تعالىٰ يمشون على اقدامهم وأنتم ركبان","","Majmu'a Da'eef Ahadith 728","","","Angels walk with the funeral"
"729","لا يمشى بين يديها","","Majmu'a Da'eef Ahadith 729","","","Should walk behind the funeral"
"730","كان يمشى خلف الجنازة","","Majmu'a Da'eef Ahadith 730","","","Should walk behind the funeral"
"731","دعها يا عمر !","","Majmu'a Da'eef Ahadith 731","","","Women attending funerals"
"732","فاذا نسوة جلوس قال ما يجلسكن قلن ننتظر الجنازة . . .","","Majmu'a Da'eef Ahadith 732","","","Women attending funerals"
"733","لا خير فى جماعة النساء الا فى مسجد أو فى جنازة قتيل","","Majmu'a Da'eef Ahadith 733","","","Women attending funerals"
"734","ليس للنساء فى اتباع الجنائز أجر","","Majmu'a Da'eef Ahadith 734","","","Women attending funerals"
"735","من رأى جنازة فقال الله اكبر صدق الله ورسوله . . .","","Majmu'a Da'eef Ahadith 735","","","Supplication upon seeing a funeral"
"736","ما أباح لنا رسول الله صلى الله عليه وسلم ولا أبوبكر ولا عمر فى شىء ما أباحوا فى الصلاة على الميت يعنى لم يوقت","","Majmu'a Da'eef Ahadith 736","","","No fixed time for funeral prayer"
"737","صلوا على أطفالكم","","Majmu'a Da'eef Ahadith 737","","","Funeral prayer for children"
"738","الطفل لا يصلى عليه","","Majmu'a Da'eef Ahadith 738","","","Funeral prayer for children"
"739","اذا استهل السقط صلى عليه وورث","","Majmu'a Da'eef Ahadith 739","","","Funeral prayer for incomplete child"
"740","آخر ما كبر النبى صلى الله عليه وسلم أربع تكبيرات","","Majmu'a Da'eef Ahadith 740","","","Prophet's last act: four takbirs in funeral"
"741","صلت الملائكة على آدم فكبرت عليه أربعا","","Majmu'a Da'eef Ahadith 741","","","Angels say four takbirs in funeral prayer"
"742","أمرنا أن نقرأ على ميتنا بفاتحة الكتاب","","Majmu'a Da'eef Ahadith 742","","","Reciting Surah Fatiha in funeral prayer"
"743","من صلى على جنازة فى المسجد فلا شىء له","","Majmu'a Da'eef Ahadith 743","","","Funeral in the mosque"
"744","يتروك الغريق يوما وليلة ويدفن","","Majmu'a Da'eef Ahadith 744","","","Bury drowned person after a day and night"
"745","ادفنوا موتاكم وسط قوم صالحين فإن الميت يتأذى بجار السوء كما يتأذى الحى بجار السوء","","Majmu'a Da'eef Ahadith 745","","","Burial among righteous people"
"746","إن لكل بيت بابا وباب القبر من تلقاء رجليه","","Majmu'a Da'eef Ahadith 746","","","Grave's door at the feet"
"747","للمرأة ستران : القبر و الزوج","","Majmu'a Da'eef Ahadith 747","","","One veil for woman in grave"
"748","عذاب القبر حق فمن لم يؤمن به عذب فيه","","Majmu'a Da'eef Ahadith 748","","","No belief in grave punishment, no salvation"
"749","رش قبر النبى صلى الله عليه وسلم وكان الذى رش الماء على قبره بلال بن رباح ، بدأ من قبل رأسه حتى انتهى إلى رجليه","","Majmu'a Da'eef Ahadith 749","","","Sprinkling water on the grave"
"750","أن رسول الله صلى الله عليه وسلم رش على قبر ابنه إبراهيم الماء ووضع عليه الحصباء","","Majmu'a Da'eef Ahadith 750","","","Sprinkling water on the grave"
"751","طول مقام أمتى فى قبورهم تمحيص لذنوبهم","","Majmu'a Da'eef Ahadith 751","","","Long stay in the grave"
"752","من عزى مصابا فله مثل أجره","","Majmu'a Da'eef Ahadith 752","","","Reward for offering condolences"
"753","لا تظهر الشماتة لأخيك فيرحمه الله ويبتليك","","Majmu'a Da'eef Ahadith 753","","","Harm in rejoicing at brother's calamity"
"754","لعن رسول الله صلى الله عليه وسلم زائرات القبور","","Majmu'a Da'eef Ahadith 754","","","Women visiting graves"
"755","من زار قبر أمه كان له عمرة","","Majmu'a Da'eef Ahadith 755","","","Reward for visiting mother's grave"
"756","لا يسلم عليهم أحد الا ردوا اليه يوم القيامة","","Majmu'a Da'eef Ahadith 756","","","Saying salam to the dead"
"757","كسر عظم الميت ككسره حيا فى الاثم","","Majmu'a Da'eef Ahadith 757","","","Sin of breaking the dead's bones"
"758","ويسمعون ؟ قال ويسمعون ولكن لا يستطيعون أن يجيبوا","","Majmu'a Da'eef Ahadith 758","","","The dead hear"
"759","إن الله تعالىٰ ليدخل على أهل القبور من دعاء أهل الأرض أمثال الجبال . . .","","Majmu'a Da'eef Ahadith 759","","","Mercy descends on the dead in mountains"
"760","من ترك التزوج مخافة العيلة فليس منا","","Majmu'a Da'eef Ahadith 760","","","Not marrying due to fear of poverty"
"761","من كان موسرا لأن ينكح فلم ينكح فليس منى","","Majmu'a Da'eef Ahadith 761","","","Not marrying despite ability"
"762","نعم العون على الدين المرأة الصالحة","","Majmu'a Da'eef Ahadith 762","","","Pious wife helps in religious matters"
"763","ما استفاد المؤمن بعد تقوى الله خيرا له من زوجة صالحة","","Majmu'a Da'eef Ahadith 763","","","Attaining a pious wife is great benefit"
"764","ألا أخبرك بخير ما يكنز المرء ؟ المرأة الصالحة","","Majmu'a Da'eef Ahadith 764","","","Pious wife is the best treasure"
"765","شراركم عزابكم","","Majmu'a Da'eef Ahadith 765","","","Unmarried are the worst people"
"766","لو لم يبق من أجلى الا يوم واحد للقيت الله بزوجة","","Majmu'a Da'eef Ahadith 766","","","Last day of life with wife"
"767","ركعتان من المتزوج أفضل من سبعين ركعة من الأعزب","","Majmu'a Da'eef Ahadith 767","","","Superiority of married person's prayer"
"768","الأعزب فراشة فى نار","","Majmu'a Da'eef Ahadith 768","","","Unmarried is destined for Hell"
"769","أن أعرابيا شكا الى رسول الله صلى الله عليه وسلم الشبق والجوع فأمره أن يتزوج أول امرأة يلقاها لا زوج لها . . .","","Majmu'a Da'eef Ahadith 769","","","Marriage removes poverty"
"770","اذا تزوج أحدكم المرأة فليسأل عن شعرها كما يسأل عن وجهها فإن الشعر أحد الجمالين","","Majmu'a Da'eef Ahadith 770","","","Questioning about women's hair"
"771","العرب أكفاء بعضهم لبعض . . .","","Majmu'a Da'eef Ahadith 771","","","Arabs are suitable for each other"
"772","من أحب أن يلقى الله طاهرا مطهرا فليتزوج الحرائر","","Majmu'a Da'eef Ahadith 772","","","Marriage to free women"
"773","الحرائر صلاح البيت والاماء هلاك البيت","","Majmu'a Da'eef Ahadith 773","","","Marriage to free women"
"774","من زوج كريمته من فاسق فقد قطع رحمها","","Majmu'a Da'eef Ahadith 774","","","Marrying daughter to a sinner"
"775","لا تزوجوا النساء على قرابتهن فإنه يكون من ذالك القطيعة","","Majmu'a Da'eef Ahadith 775","","","Marriage based on kinship"
"776","من تزوج امرأة لعزها لم يزده الله الا ذلا ومن تزوجها لمالها لم يزده الله الا فقرا ومن تزوجها لحسنها لم يزده الله الا دناءة ومن تزوج امرأة لم يتزوجها الا ليغض بصره أو ليحصن فرجه أو يصل رحمه بارك الله له فيها وبارك لها فيه","","Majmu'a Da'eef Ahadith 776","","","Marriage for honor, wealth, or beauty"
"777","لا تزوجوا النساء لحسنهن فعسى حسنهن أن يرديهن ولا تزوجوهن لأموالهن فعسى أموالهن أن تطغيهن ولكن تزوجوهن على الدين ولأمة خرماء سوداء ذات دين أفضل","","Majmu'a Da'eef Ahadith 777","","","Marriage for honor, wealth, or beauty"
"778","لا تتزوجوا الحمقاء فإن صحبتها بلاء وفى ولدها ضياع","","Majmu'a Da'eef Ahadith 778","","","Prohibition of marrying a foolish woman"
"779","تخيروا لنطفكم فإن النساء يلدن أشباه اخوانهن و أخواتهن","","Majmu'a Da'eef Ahadith 779","","","Choose a wife thoughtfully"
"780","آمروا النساء فى بناتهن","","Majmu'a Da'eef Ahadith 780","","","Consult mothers about their daughters"
"781",". . . أفعمياوان أنتما ؟ ألستما تبصرانه","","Majmu'a Da'eef Ahadith 781","","","Woman looking at non-mahram man"
"782","أول حب فى الاسلام حب النبى صلى الله عليه وسلم لعائشة","","Majmu'a Da'eef Ahadith 782","","","First love in Islam"
"783","لا مهر دون عشرة دراهم","","Majmu'a Da'eef Ahadith 783","","","Minimum amount of dowry"
"784","خير كن أيسركن صداقا","","Majmu'a Da'eef Ahadith 784","","","Best woman is with least dowry"
"785","أعظم النساء بركة أيسرهن مؤونة","","Majmu'a Da'eef Ahadith 785","","","Best woman is with least dowry"
"786","أعلنوا هذا النكاح واجعلوه فى المساجد واضربوا عليه بالدفوف","","Majmu'a Da'eef Ahadith 786","","","Marriage in the Prophet's Mosque"
"787","تزوج امرأة فشروا على رأسه تمر عجوة","","Majmu'a Da'eef Ahadith 787","","","Scattering dates"
"788","لا يصح المكر والخداع الا فى النكاح","","Majmu'a Da'eef Ahadith 788","","","Deception is allowed in marriage"
"789","البغايا اللاتى ينكحن أنفسهن بغير بينة","","Majmu'a Da'eef Ahadith 789","","","Women marrying without witnesses are adulteresses"
"790","من تزوج امرأة فلا يدخل عليها حتى يعطيها شيئا ولو لم يجد الا أحد نعليه","","Majmu'a Da'eef Ahadith 790","","","Gift before intimacy"
"791","اذا جامع أحدكم فلا ينظر الى الفرج فانه يورث العمى","","Majmu'a Da'eef Ahadith 791","","","Looking at private parts during intimacy"
"792","ما رأيت فرج رسول الله صلى الله عليه وسلم قط","","Majmu'a Da'eef Ahadith 792","","","Looking at private parts during intimacy"
"793","من نظر الى فرج امرأة لم تحل له أمها ولا ابنتها","","Majmu'a Da'eef Ahadith 793","","","Looking at a woman's private part forbids mother and daughter"
"794","لا يكثرن أحدكم الكلام عند المجامعة فإنه يكون منه خرس الولد","","Majmu'a Da'eef Ahadith 794","","","Talking much during intimacy"
"795","يجب على الرجل لامرأته ما يجب له عليها أن يتزين لها","","Majmu'a Da'eef Ahadith 795","","","Adornment obligatory for men"
"796","أنما نهيتكم عن نهبة العساكر ولم أنهكم عن نهبة الولائم","","Majmu'a Da'eef Ahadith 796","","","Returning wedding feast invitation"
"797","شهوة النساء تضاعف شهوة الرجال","","Majmu'a Da'eef Ahadith 797","","","Women's desire is double men's"
"798","لا يحل لامرأة تؤمن باالله واليوم الاخر تكشف شعرها ولا شيئا من صدرها عند يهودية ولا نصرانية ولا مجوسية فمن فعلت ذالك فلا أمانة لها","","Majmu'a Da'eef Ahadith 798","","","Prohibition of exposing hair and chest for women"
"799","أيما امرأة خرجت من بيت زوجها بغير اذنه لعنها كل شىء طلعت عليه الشمس والقمر الا أن يرضى عنها زوجها","","Majmu'a Da'eef Ahadith 799","","","Curse on woman leaving home without husband's permission"
"800","لا تخرج من بيتها الا باذنه فان فعلت لعنتها ملائكة السماء و ملائكة الرحمة و ملائكة العذاب حتى ترجع","","Majmu'a Da'eef Ahadith 800","","","Curse on woman leaving home without husband's permission"
"801","طاعة النساء ندامة","","Majmu'a Da'eef Ahadith 801","","","Obeying women leads to regret"
"802","من صبر على سوء خلق امرأته أعطاه الله من الأجر مثل ما أعطى أيوب على بلائه ومن صبرت على سوء خلق زوجها أعطاها الله مثل ثواب آسية امراة فرعون","","Majmu'a Da'eef Ahadith 802","","","Effect of patience on spouse's bad character"
"803","لا تسكنوهن الغرف ولاتعلموهن الكتابة و علموهن الغزل و سورة النور","","Majmu'a Da'eef Ahadith 803","","","Do not keep women in upper rooms; teach spinning"
"804","ما أكرم النساء إلا كريم ولا أهانهن إلا لئيم","","Majmu'a Da'eef Ahadith 804","","","Only one who honors women is honorable"
"805","تعس عبد الزوجة","","Majmu'a Da'eef Ahadith 805","","","Death of wife's slave"
"806","شاوروهن و خالفوهن","","Majmu'a Da'eef Ahadith 806","","","Opposing women"
"807","لا يفعلن أحدكم أمرا حتى يستشير فإن لم يجد من يستشيره فليستشر امرأة ثم ليخالفها فإن فى خلافها البركة","","Majmu'a Da'eef Ahadith 807","","","Opposing women"
"808","أعروا النساء يلزمن الحجال","","Majmu'a Da'eef Ahadith 808","","","Removing women's clothes"
"809","مثل المرأة الصالحة فى النساء كمثل الغراب بين مائة غراب","","Majmu'a Da'eef Ahadith 809","","","Example of a pious woman is like a crow"
"810","جهاد المرأة حسن التبعل لزوجها","","Majmu'a Da'eef Ahadith 810","","","Woman's jihad is obedience to husband"
"811","ايما امرأة ماتت و زوجها عنها راض دخلت الجنة","","Majmu'a Da'eef Ahadith 811","","","Woman pleasing husband enters Paradise"
"812","الأرملة الصالحة سميت فى السموات شهيدة","","Majmu'a Da'eef Ahadith 812","","","Pious widow called ""martyr"" in heaven"
"813","لا أحب الذواقين من الرجال والذواقات من النساء","","Majmu'a Da'eef Ahadith 813","","","Hasty in divorce are disliked"
"814","من مشى فى تزويج اثنين أعطاه الله بكل خطوة وبكل كلمة عبادة سنة ومن مشى فى تفريق بين اثنين كان حقا على الله أن يضرب رأسه يوم القيامة بألف صخرة من جهنم","","Majmu'a Da'eef Ahadith 814","","","End of one who causes divorce"
"815","يا معاذ ! ما خلق الله شيئا على وجه الأرض أحب اليه من العتاق ولا خلق الله شيئا على وجه الأرض أبغض اليه من الطلاق","","Majmu'a Da'eef Ahadith 815","","","Most hated thing in universe is divorce"
"816","طلاق الأمة اثنتان وعدتها حيضتان","","Majmu'a Da'eef Ahadith 816","","","Divorce of a slave woman"
"817","ما يذهب عنى مذمة الرضاع فقال غرة عبدا أو أمة","","Majmu'a Da'eef Ahadith 817","","","How to fulfill the right of breastfeeding?"
"818","لا ترضع لكم الحمقى فإن اللبن يعدى","","Majmu'a Da'eef Ahadith 818","","","Do not let a foolish woman breastfeed"
"819","أربعة ليس بينهم لعان : ليس بين الحر والأمة لعان . . .","","Majmu'a Da'eef Ahadith 819","","","No lian among four people"
"820","تناكحوا تناسلوا اباهى بكم الأمم يوم القيامة","","Majmu'a Da'eef Ahadith 820","","","Encouragement to have children"
"821","الولد سر أبيه","","Majmu'a Da'eef Ahadith 821","","","A son is the father's secret"
"822","أن النبى صلى الله عليه وسلم أذن فى أذن الحسن بن على يوم ولد فأذن فى أذن اليمنى وأقام فى أذنه اليسرى","","Majmu'a Da'eef Ahadith 822","","","Prophet calling adhan and iqamah in Hasan’s ear"
"823","من تسمى باسمى فلا يتكنى بكنيتى ومن اكتنى بكنيتى فلا يتسمى باسمى","","Majmu'a Da'eef Ahadith 823","","","Naming and giving kunya after the Prophet"
"824","انكم تدعون يوم القيامة بأسمائكم وأسمائكم آبائكم فأحسنوا أسمائكم","","Majmu'a Da'eef Ahadith 824","","","Called by fathers’ names on the Day of Judgment"
"825","الختان سنة للرجال مكرمة للنساء","","Majmu'a Da'eef Ahadith 825","","","Female circumcision as a mark of honor"
"826","أن الأقلف لا يترك فى الاسلام حتى يختتن ولو بلغ ثمانين سنة","","Majmu'a Da'eef Ahadith 826","","","Uncircumcised man not tolerated in Islam"
"827","لا يحج بيت الله حتى يختتن","","Majmu'a Da'eef Ahadith 827","","","Uncircumcised man cannot perform Hajj"
"828","ولد النبى صلى الله عليه وسلم مختونا","","Majmu'a Da'eef Ahadith 828","","","Prophet born circumcised"
"829","من أسلم فليختتن ولو كان كبيرا","","Majmu'a Da'eef Ahadith 829","","","Circumcision for all converts except children"
"830","علموا بنيكم السباحة والرمى . . .","","Majmu'a Da'eef Ahadith 830","","","Teaching children swimming and archery"
"831","لأن يؤدب الرجل ولده خير له من أن يتصدق بصاع","","Majmu'a Da'eef Ahadith 831","","","Teaching manners to children better than charity"
"832","ما نحل والد ولدا أفضل من أدب حسن","","Majmu'a Da'eef Ahadith 832","","","Best gift from father is good manners"
"833","حق الولد على الوالد أن يحسن اسمه ويحسن أدبه","","Majmu'a Da'eef Ahadith 833","","","Teaching good manners is child’s right"
"834","لا تضربوا أولادكم على بكائهم . . .","","Majmu'a Da'eef Ahadith 834","","","Do not beat children for crying"
"835","من وضع يده على رأس يتيم ترحما كانت له بكل شعرة تمر عليها يده حسنة","","Majmu'a Da'eef Ahadith 835","","","Virtue of stroking an orphan’s head"
"836","شكا رجل قلة الولد فأمره أن يأكل البيض والبصل","","Majmu'a Da'eef Ahadith 836","","","Egg and onion for low offspring"
"837","أحبوا البنات فأنا أبو البنات","","Majmu'a Da'eef Ahadith 837","","","Loving daughters"
"838","من انفق على تزويج ابنه أو ابنته درهما أعطاه الله بكل درهم اثنتى وعشرة مدينة فى الجنة","","Majmu'a Da'eef Ahadith 838","","","Reward for spending on children’s marriage"
"839","النطفة التى يخلق منها الولد ترعدلها الأعضاء والعروق كلها","","Majmu'a Da'eef Ahadith 839","","","Progeny from sperm"
"840","قلة العيال أحد اليسارين وكثرته أحد الفقرين","","Majmu'a Da'eef Ahadith 840","","","Fewer children, easier life"
"841","بادروا أولادكم بالكنى قبل أن تغلب عليهم الألقاب","","Majmu'a Da'eef Ahadith 841","","","Hastening to give children a kunya"
"842","من ربى صبيا حتى يقول لا اله الا الله لم يحاسبه الله","","Majmu'a Da'eef Ahadith 842","","","Great reward for righteous upbringing"
"843","رحم الله والدا أعان ولده على بره","","Majmu'a Da'eef Ahadith 843","","","Prayer for parents who help children in goodness"
"844","ساووا بين أولادكم فى العطية","","Majmu'a Da'eef Ahadith 844","","","Equality among children in gifts"
"845","دعاء الوالد لولده مثل دعاء النبى لأمته","","Majmu'a Da'eef Ahadith 845","","","Father’s prayer like Prophet’s prayer"
"846","بروا آبائكم تبركم أبناؤكم","","Majmu'a Da'eef Ahadith 846","","","Be good to parents to have good children"
"847","بر الوالدين أفضل من الصلاة والصوم والحج والعمرة والجهاد فى سبيل الله","","Majmu'a Da'eef Ahadith 847","","","Kindness to parents better than prayer, fasting, jihad"
"848","ان الجنة يوجد ريحها من مسيرة خمسمائة عام ولا يجد ريحها عاق","","Majmu'a Da'eef Ahadith 848","","","Disobedient to parents deprived of Paradise’s fragrance"
"849","اذا ترك العبد الدعاء للوالدين فإنه ينقطع عن الولد الرزق فى الدنيا","","Majmu'a Da'eef Ahadith 849","","","Not praying for parents cuts off sustenance"
"850","لو ادركت والدى أو أحدهما وأنا فى الصلاة صلاة العشاء وقد قرأت فيها فاتحة الكتاب ينادى يا محمد ! لأجبته : لبيك","","Majmu'a Da'eef Ahadith 850","","","If parents call me during prayer"
"851","من قبل بين عين امه كان له سترا من النار","","Majmu'a Da'eef Ahadith 851","","","Virtue of kissing mother’s forehead"
"852","شاب حضره الموت ولم يقدر على كلمة الشهادة بسبب عق أمه فشفع النبى صلى الله عليه وسلم الى امه فرضيت فقدر عليها","","Majmu'a Da'eef Ahadith 852","","","Disobedient to mother could not recite shahada at death"
"853","العبد المطيع لوالديه والمطيع لربه فى أعلى عليين","","Majmu'a Da'eef Ahadith 853","","","Obedient to parents in Illiyin"
"854","ان العبد ليموت أبواه أو أحدهما وأنه لعاق فلا يزال يدعو لهما و يستغفر لهما حتى يكتب عند الله بارا","","Majmu'a Da'eef Ahadith 854","","","Disobedience turns to obedience by prayer and forgiveness"
"855","ما من ولد بار ينظر الى والديه نظرة رحمة الا كتب الله له بكل نظرة حجة مبرورة قالوا وان نظر كل يوم مائة مرة ؟ قال نعم ، الله اكبر وأطيب","","Majmu'a Da'eef Ahadith 855","","","Looking at parents with love equals Hajj Mabroor"
"856","هما جنتك ونارك","","Majmu'a Da'eef Ahadith 856","","","Parents are means to Paradise or Hell"
"857","ما اجتمع الحلال والحرام الا غلب الحرام","","Majmu'a Da'eef Ahadith 857","","","Haram overtaking halal"
"858","من اكل لقمة من حرام لم تقبل منه صلاة أربعين ليلة","","Majmu'a Da'eef Ahadith 858","","","One bite of haram wastes forty prayers"
"859","من ترك درهما من حرام أعتقه الله من النار . . .","","Majmu'a Da'eef Ahadith 859","","","Virtue of leaving one dirham of haram"
"860","من لم يقم فى أمر معيشته لم يقم بأمر دينه","","Majmu'a Da'eef Ahadith 860","","","Weak in livelihood, weak in faith"
"861","ان الله يبغض الشاب الفارغ","","Majmu'a Da'eef Ahadith 861","","","Allah dislikes idle youth"
"862","ان الله يكره الرجل البطال","","Majmu'a Da'eef Ahadith 862","","","Allah dislikes idle youth"
"863","ما من عبد من عبادى استحيى من الحلال الا ابتلاه الله بالحرام","","Majmu'a Da'eef Ahadith 863","","","Shy from halal falls into haram"
"864","من أصاب مالا من نهاوش أذهبه الله فى نهابر","","Majmu'a Da'eef Ahadith 864","","","Earning haram leads to destruction"
"865","ان الله ملكا على بيت المقدس ينادى كل ليلة من اكل حراما لم يقبل منه صرف ولا عدل","","Majmu'a Da'eef Ahadith 865","","","Worship of haram eater not accepted"
"866","لو اتجر أهل الجنة لا تجروا فى البز","","Majmu'a Da'eef Ahadith 866","","","Trade of the people of Paradise"
"867","التاجر الجبان محروم والتاجر الجسور مرزوق","","Majmu'a Da'eef Ahadith 867","","","Cowardly and brave traders"
"868","عليكم بحسن الخط فانه مفاتيح الرزق","","Majmu'a Da'eef Ahadith 868","","","Calligraphy is key to sustenance"
"869","شرار الناس التجار والزراع","","Majmu'a Da'eef Ahadith 869","","","Worst people: traders and farmers"
"870","شر المال فى آخر الزمان المماليك","","Majmu'a Da'eef Ahadith 870","","","Worst wealth in end times"
"871","بخلاء أمتى الخياطون","","Majmu'a Da'eef Ahadith 871","","","Tailors are the misers of the ummah"
"872","اللهم لا تطع فينا تاجرا ولا مسافرا فإن تاجرنا يحب الغلاء ومسافرنا يكره المطر","","Majmu'a Da'eef Ahadith 872","","","Desire for trader and traveler"
"873","من تمنى الغلاء على أمت ليلة أحبط الله عمله أربعين سنة","","Majmu'a Da'eef Ahadith 873","","","Deeds wasted by wishing for high prices"
"874","الجالب مرزوق والمحتكر ملعون","","Majmu'a Da'eef Ahadith 874","","","Hoarder"
"875","من احتكر طعاما أربعين ليلة فقد برئ من الله وبرئ الله منه","","Majmu'a Da'eef Ahadith 875","","","Hoarder"
"876","من احتكر طعاما أربعين يوما عل المسلمين ثم تصدق به لم يكن له كفارة","","Majmu'a Da'eef Ahadith 876","","","Hoarder"
"877","كل قرض جر منفعة فهو ربا","","Majmu'a Da'eef Ahadith 877","","","Interest in profit-making loans"
"878","الحياء يمنع الرزق","","Majmu'a Da'eef Ahadith 878","","","Modesty stops sustenance"
"879","غسل الاناء وطهارة الفناء يورثان الغنى","","Majmu'a Da'eef Ahadith 879","","","Cleaning utensils and yard brings wealth"
"880","اذا صليتم الفجر فلا تناموا عن طلب أرزاقكم","","Majmu'a Da'eef Ahadith 880","","","Seeking sustenance after Fajr"
"881","نوعان اكرمهما الله فى الدنيا والاخرة الذهب والفضة فجعلهما شرفا لأهل الدنيا وزينه لأهل الاخرة","","Majmu'a Da'eef Ahadith 881","","","Honor in this world and next for gold and silver"
"882","انما سمى الدرهم لأنه دارهم وانما سمى الدينار لانه دار نار","","Majmu'a Da'eef Ahadith 882","","","Reason for naming dirham and dinar"
"883","خلق الله الأرزاق قبل الأجساد بألفى عام . . .","","Majmu'a Da'eef Ahadith 883","","","Sustenance created before bodies"
"884","لا تشتروا السمك فى الماء فانه غرر","","Majmu'a Da'eef Ahadith 884","","","Prohibition of buying fish in water"
"885","نهى عن بيع الكالى بالكالى","","Majmu'a Da'eef Ahadith 885","","","Prohibition of credit for credit sale"
"886","من اشترى مالم يره فله الخيار اذا راه","","Majmu'a Da'eef Ahadith 886","","","Option for buyer without seeing goods"
"887","لا شفعة لغائب ولا لصغير والشفعة كحل العقال","","Majmu'a Da'eef Ahadith 887","","","Right of preemption like untying a rope"
"888","قال الله تعالى : أنا ثالث الشريكين ما لم يخن أحدهما صاحبه","","Majmu'a Da'eef Ahadith 888","","","Allah is third partner with two partners"
"889","لا يغلق الرهن من صاحبه الذى رهنه له غنمه وعليه غرمه","","Majmu'a Da'eef Ahadith 889","","","Prohibition of withholding pledged item if debt unpaid"
"890","الوضوء قبل الطعام حسنة و بعد الطعام حسنتان","","Majmu'a Da'eef Ahadith 890","","","Benefit of ablution before eating"
"891","الوضوء قبل الطعام وبعده ينفى الفقر","","Majmu'a Da'eef Ahadith 891","","","Benefit of ablution before eating"
"892","سعة فى الرزق وردع سنة الشيطان الوضوء قبل الطعام و بعده","","Majmu'a Da'eef Ahadith 892","","","Benefit of ablution before eating"
"893","بركة الطعام الوضوء قبله و بعده","","Majmu'a Da'eef Ahadith 893","","","Benefit of ablution before eating"
"894","من نسىى أن يسمى قبل الطعام فليقرأ قل هو الله أحد اذا فرغ","","Majmu'a Da'eef Ahadith 894","","","Recite Ikhlas if Bismillah forgotten before eating"
"895","يا على ! عليك بالملح فانه شفاء من سبعين داء : الجذام و البرص و الجنون","","Majmu'a Da'eef Ahadith 895","","","Seventy diseases cured by salt"
"896","من ابتدأ غداءه بالملح أذهب الله عنه سبعين نوعا من البلاء","","Majmu'a Da'eef Ahadith 896","","","Seventy diseases cured by salt"
"897","سيد ادامكم الملح","","Majmu'a Da'eef Ahadith 897","","","Salt is the chief of condiments"
"898","من اكل ما يسقط من الخوان أو القصعة أمن من الفقر والبرص والجذام","","Majmu'a Da'eef Ahadith 898","","","Benefit of eating fallen morsel"
"899","من اكل فى قصعة ثم لحسها استغفرت له القصعة","","Majmu'a Da'eef Ahadith 899","","","Utensil prays when licked after eating"
"900","كان اذا فرغ من طعامه قال : الحمد لله الذى أطعمنا وسقانا وجعلنا مسلمين","","Majmu'a Da'eef Ahadith 900","","","Supplication after eating"
"901","اذا أكلت طعاما أو شربت شرابا فقل بسم الله الذى لا يضر مع اسمه شىء فى الارض ولا فى السماء يا حى يا قيوم الا لم يصبك منه داء ولو كان فى سم","","Majmu'a Da'eef Ahadith 901","","","Supplication while eating and drinking protects from all diseases"
"902","الأكل فى السوق دناءة","","Majmu'a Da'eef Ahadith 902","","","Eating in the market is disgraceful"
"903","أكرموا الخبز فان الله أنزل له بركات السماء وأخرج له بركات الأرض","","Majmu'a Da'eef Ahadith 903","","","Respect bread"
"904","أكرموا الخبز فان الله أكرمه فمن أكرم الخبز أكرمه الله","","Majmu'a Da'eef Ahadith 904","","","Respect bread"
"905","ما استخف قوم بحق الخبز الا ابتلاهم الله بالجوع","","Majmu'a Da'eef Ahadith 905","","","Respect bread"
"906","لا تقطعوا الخبز بالسكين كما يقطعه الأعاجم","","Majmu'a Da'eef Ahadith 906","","","Prohibition of cutting bread with knife"
"907","صغروا الخبز وأكثروا عدده يبارك لكم فيه","","Majmu'a Da'eef Ahadith 907","","","Eating many small pieces of bread"
"908","اللهم أمتعنا بالاسلام والخبز فلو لا الخبز ما صمنا ولا صلينا ولا حججنا ولا غزونا","","Majmu'a Da'eef Ahadith 908","","","No prayer, fasting, or Hajj without bread"
"909","ثلاث لا يحاسب عليه العبد : أكلة السحور وما أفطر عليه وما أكل مع الاخوان","","Majmu'a Da'eef Ahadith 909","","","No reckoning for three foods"
"910","النفخ فى الطعام يذهب بالبركة","","Majmu'a Da'eef Ahadith 910","","","Blowing on food removes blessing"
"911","ما بات قوم شباعا الاحسنت أخلاقهم ولا بات قوم جياعا قط الا ساءت اخلاقهم","","Majmu'a Da'eef Ahadith 911","","","Good character from sleeping full"
"912","كان اذا تغدى لم يتعش واذا تعشى لم يتغد","","Majmu'a Da'eef Ahadith 912","","","Prophet ate in morning, not in evening"
"913","كان لا يأكل طعاما الا حمد الله عزوجل وقال اللهم بارك لنا فيه و أطعمنا أطيب منه","","Majmu'a Da'eef Ahadith 913","","","Always praise Allah with food"
"914","سيد طعام أهل الدنيا وأهل الجنة اللحم","","Majmu'a Da'eef Ahadith 914","","","Meat is the chief of foods"
"915","ان للقلب فرحة عند أكل اللحم","","Majmu'a Da'eef Ahadith 915","","","Meat brings joy to the heart"
"916","اللحم ينبت اللحم ومن ترك اللحم أربعين يوما ساء خلقه","","Majmu'a Da'eef Ahadith 916","","","Harm of leaving meat for forty days"
"917","كلوا الزيت وادهنوا به فانه طيب مبارك","","Majmu'a Da'eef Ahadith 917","","","Encouragement to eat olives"
"918","شرب اللبن محض الايمان من شربه فى منامه فهو على الايمان و الفطرة","","Majmu'a Da'eef Ahadith 918","","","Drinking milk in a dream"
"919","من التواضع أن يشرب الرجل من سؤر أخيه و من شرب من سؤر أخيه ابتغاء وجه الله رفعت له سبعون درجة . . .","","Majmu'a Da'eef Ahadith 919","","","Virtue of drinking brother’s leftover water"
"920","من سقى مسلما شربة من ماء حيث يوجد الماء فكأنما أعتق رقبة و من سقى مسلما شربة من ماء حيث لا يوجد الماء فكأنما أحيا نسمة مؤمنة","","Majmu'a Da'eef Ahadith 920","","","Virtue of giving a sip of water to a Muslim"
"921","اسق الماء على الماء فى اليوم الصائف تنتشر ذنوبك كما ينتشر الورق من الشجر فى الريح العاصف","","Majmu'a Da'eef Ahadith 921","","","Giving water in summer"
"922","الأرزفى الطعام كالسيد فى القوم . . .","","Majmu'a Da'eef Ahadith 922","","","Virtue of rice"
"923","الأرز منى وانا من الأرز خلقت الأرز من بقية نورى . . .","","Majmu'a Da'eef Ahadith 923","","","Virtue of rice"
"924","من اكل الأرز أربعين يوما ظهرت ينابيع الحكمة من قلبه على لسانه","","Majmu'a Da'eef Ahadith 924","","","Virtue of rice"
"925","عليكم بالعدس فإنه مبارك مقدس","","Majmu'a Da'eef Ahadith 925","","","Excellence of lentils"
"926","عليكم بالعدس فإنه قدس على لسان سبعين نبيا","","Majmu'a Da'eef Ahadith 926","","","Excellence of lentils"
"927","الباذنجان شفاء من كل داء ولا داء فيه","","Majmu'a Da'eef Ahadith 927","","","Healing in eggplant"
"928","كلوا الباذنجان واكثروا منه فإنه أول شجرة رأيتها فى جنة المأوى","","Majmu'a Da'eef Ahadith 928","","","Healing in eggplant"
"929","البطيخ قبل الطعام يغسل البطن غسلا و يذهب بالداء أصلا","","Majmu'a Da'eef Ahadith 929","","","Benefit of eating melon before food"
"930","ربيع أمتى العنب والبطيخ","","Majmu'a Da'eef Ahadith 930","","","Grapes and melon are spring of my ummah"
"931","عليكم بالقرع فإنه يزيد فى العقل","","Majmu'a Da'eef Ahadith 931","","","Gourd sharpens intellect"
"932","يا على ! اذا تزودت فلا تنسى البصل","","Majmu'a Da'eef Ahadith 932","","","Importance and benefit of onion"
"933","عليكم بالبصل فإنه يطيب النطفة و يصبح الولد","","Majmu'a Da'eef Ahadith 933","","","Importance and benefit of onion"
"934","من أكل القثاء بلحم وقى الجذام","","Majmu'a Da'eef Ahadith 934","","","Benefit of eating cucumber with meat"
"935","قلب المؤمن حلو يحب الحلاوة","","Majmu'a Da'eef Ahadith 935","","","Believer loves sweets"
"936","ان أهل الجوع فى الدنيا هم أهل الشبع فى الاخرة","","Majmu'a Da'eef Ahadith 936","","","Hungry in world, full in Hereafter"
"937","الجبن داء و الجوز داء فاذا اجتمعا صارا شفاءين","","Majmu'a Da'eef Ahadith 937","","","Walnut and cheese together are healing"
"938","سيد الأدهان البنفسج وان فضل البنفسج عل سائر الأدهان كفضل الاسلام عل سائر الأديان","","Majmu'a Da'eef Ahadith 938","","","Violet is chief of oils"
"939","من كان فى بيته شاة كان فى بيته بركة","","Majmu'a Da'eef Ahadith 939","","","Goat brings blessing to home"
"940","لا تسبوا الديك فانه صديقى وانا صديقه","","Majmu'a Da'eef Ahadith 940","","","Rooster is my friend"
"941","أن النبى صلى الله عليه وسلم كان يطير الحمام","","Majmu'a Da'eef Ahadith 941","","","Flying pigeons"
"942","لا باس بأكل كل طير ما خلا البوم و الرخم","","Majmu'a Da'eef Ahadith 942","","","Eat all birds except owl and vulture"
"943","القنفذ . . . هو خبيثة من الخبائث","","Majmu'a Da'eef Ahadith 943","","","Porcupine is a filthy animal"
"944","ان من السرف أن تأكل كلما اشتهيت","","Majmu'a Da'eef Ahadith 944","","","What is extravagance in eating"
"945","أكل الطين يورث النفاق","","Majmu'a Da'eef Ahadith 945","","","Harm of eating soil"
"946","أكل الطين حرام على كل مسلم","","Majmu'a Da'eef Ahadith 946","","","Harm of eating soil"
"947","من أكل الطين واغتسل به فقد أكل لحم أبيه (آدم) واغتسل بدمه","","Majmu'a Da'eef Ahadith 947","","","Harm of eating soil"
"948","قالوا يا رسول الله ما هذه الأضاحى ؟ قال : سنة أبيكم ابراهيم ، قالوا ما لنا منها قال بكل شعرة حسنة","","Majmu'a Da'eef Ahadith 948","","","Qurbani is your father Ibrahim’s sunnah"
"949","أن رجلا سأل ابن عمر عن الأضحية أواجبة هى ؟ فقال ضحى رسول الله صلى الله عليه وسلم و المسلمون فأعادها عليه فقال أتعقل ؟ ضحى رسول الله صلى الله عليه وسلم و المسلمون","","Majmu'a Da'eef Ahadith 949","","","Is sacrifice obligatory?"
"950","أقام رسول الله صلى الله عليه وسلم بالمدينة عشر سنين يضحى","","Majmu'a Da'eef Ahadith 950","","","Ten years in Madinah and sacrifice"
"951","ما عمل ابن آدم يوم النحر احب الى الله من اراقة دم وانها لتأتى يوم القيامة بقرونها و أظلافها و أشعارها و ان الدم ليقع من الله عزوجل بمكان قبل ان يقع على الأرض فطيبوا بها نفسا","","Majmu'a Da'eef Ahadith 951","","","Virtue of sacrifice"
"952","ان رسول الله صلى الله عليه وسلم أوصانى أن أضحى عنه فأنا أضحى عنه","","Majmu'a Da'eef Ahadith 952","","","Sacrifice on behalf of the Prophet"
"953","ان العود و الصندل و المسك و العنبر و الكافور من لباس آدم الذى نزل به من الجنة","","Majmu'a Da'eef Ahadith 953","","","Adam’s clothing"
"954","الركبة من العورة","","Majmu'a Da'eef Ahadith 954","","","Knee is part of awrah"
"955","صلاة بعمامة تعدل خمسا و عشرين و جمعة بعمامة تعدل سبعين جمعة","","Majmu'a Da'eef Ahadith 955","","","Virtue of wearing turban in prayer and Friday"
"956","صلاة على كور العمامة يعدل ثوابها عند الله غزوة فى سبيل الله","","Majmu'a Da'eef Ahadith 956","","","Virtue of wearing turban in prayer and Friday"
"957","اعتموا تزدادوا حلما","","Majmu'a Da'eef Ahadith 957","","","Wearing turban increases forbearance"
"958","عليكم بالعمائم فانها سيما الملائكة . . .","","Majmu'a Da'eef Ahadith 958","","","Turban is sign of angels"
"959","فرق ما بيننا و بين المشركين العمائم على القلانس","","Majmu'a Da'eef Ahadith 959","","","Tying turban over cap"
"960","لباس الملائكة الى أنصاف سوقها","","Majmu'a Da'eef Ahadith 960","","","Length of angels’ clothing"
"961","اطووا ثيابكم ترجع اليها أرواحها فان الشيطان اذا وجد ثوبا مطويا لم يلبسه وان وجده منشورا لبسه","","Majmu'a Da'eef Ahadith 961","","","Shaitan does not wear wrapped clothes"
"962","من سره أن يجلس مع الله فليجلس مع أهل الصوف","","Majmu'a Da'eef Ahadith 962","","","Sitting with wool-wearers is like sitting with Allah"
"963","مات النبى صلى الله عليه وسلم فى الصوف . . .","","Majmu'a Da'eef Ahadith 963","","","Prophet died in woolen garment"
"964","كان يلبس المنطقة","","Majmu'a Da'eef Ahadith 964","","","Prophet tied belt on waist"
"965","من اعتقل البعير ولبس الصوف فقد برى من الكبر","","Majmu'a Da'eef Ahadith 965","","","Wearing wool and tying camel removes pride"
"966","من لبس نعلا صفراء لم يزل فى سرور ما دام لا بسها","","Majmu'a Da'eef Ahadith 966","","","Yellow shoes bring happiness"
"967","علامة المنافق تطويل سراويله","","Majmu'a Da'eef Ahadith 967","","","Long trousers are sign of hypocrisy"
"968","صلاة بخاتم تعدل سبعين بغير خاتم","","Majmu'a Da'eef Ahadith 968","","","Virtue of wearing ring in prayer"
"969","تختموا بالعقيق فانه مبارك","","Majmu'a Da'eef Ahadith 969","","","Wearing aqeeq ring brings blessing"
"970","أكثر خرز الجنة العقيق","","Majmu'a Da'eef Ahadith 970","","","Most gems in Paradise are aqeeq"
"971","من تختم بالعقيق لم يزل يرى خيرا","","Majmu'a Da'eef Ahadith 971","","","Aqeeq wearer always sees good"
"972","من اتخذ خاتما فصه ياقوت نفى الله عنه الفقر","","Majmu'a Da'eef Ahadith 972","","","Benefit of wearing ruby ring"
"973","تختموا بالزمرد فانه يسر لا عسر فيه","","Majmu'a Da'eef Ahadith 973","","","Encouragement to wear emerald"
"974","نفقة الدرهم فى سبيل الله بسبعمائة و نفقة درهم فى خضاب بسبعة آلاف","","Majmu'a Da'eef Ahadith 974","","","Virtue of spending on hair dye"
"975","من مات مخضوبا لم يدخل القبر الامنكر و نكير لا يسألانه","","Majmu'a Da'eef Ahadith 975","","","Dying hair protects from grave’s questions"
"976","من طول شاربه فى الدنيا طول الله ندامته يوم القيامة","","Majmu'a Da'eef Ahadith 976","","","Long mustache, long regret"
"977","ملائكة السماء يستغفرون لذوائب النساء ولحى الرجل ؛ يقولون : سبحان الذى زين الرجال باللحى والنساء بالذوائب","","Majmu'a Da'eef Ahadith 977","","","Angels seek forgiveness for bearded men"
"978","لا يأخذ أحدكم لحيته ولكن من الصدغين","","Majmu'a Da'eef Ahadith 978","","","Prohibition of shaving hair and beard except temples"
"979","كان يأخذ من لحيته من عرضها و طولها","","Majmu'a Da'eef Ahadith 979","","","Prophet used to trim beard"
"980","من سرح رأسه و لحيته بالمشط فى كل ليلة عوفى من انواع البلاء وزيد فى عمره","","Majmu'a Da'eef Ahadith 980","","","Benefit of combing head and beard every night"
"981","من امتشط قائما ركبه الدين","","Majmu'a Da'eef Ahadith 981","","","Harm of combing while standing"
"982","كان لا يفارقه المشط فى حضر ولا سفر","","Majmu'a Da'eef Ahadith 982","","","Prophet always kept a comb"
"983","من قلم أطفاره يوم السبت خرج منه الداء و دخل فيه الشفاء . . .","","Majmu'a Da'eef Ahadith 983","","","Benefit of cutting nails"
"984","ان الورد خلق من عرق النبى صلى الله عليه وسلم","","Majmu'a Da'eef Ahadith 984","","","Rose created from Prophet’s sweat"
"985","ليلة أسرى بى سقط الى الأرض من عرقى فنبت منه الورد فمن أحب أن يشم رائحتى فليشم الورد","","Majmu'a Da'eef Ahadith 985","","","Rose created from Prophet’s sweat"
"986","اذا أتى أحدكم بالطيب فليصب منه و اذا أتى بالحلوى فليصب منها","","Majmu'a Da'eef Ahadith 986","","","Use perfume and sweets"
"987","سيد ريحان الجنة الحناء","","Majmu'a Da'eef Ahadith 987","","","Henna is chief of fragrant plants in Paradise"
"988","الكندر طيبى و طيب الملائكة . . .","","Majmu'a Da'eef Ahadith 988","","","Frankincense is angels’ fragrance"
"989","شموا النرجس ولو فى اليوم مرة ولو فى الشهر مرة ولو فى السنة مرة ولو فى الدهر مرة","","Majmu'a Da'eef Ahadith 989","","","Smell narcissus at least once in life"
"990","كان يكتحل كل ليلة و يحتجم كل شهر و يشرب الدواء كل سنة","","Majmu'a Da'eef Ahadith 990","","","Cupping monthly and medicine yearly"
"991","الحجامة فى الرأس من الجنون و الجذام و البرص . . .","","Majmu'a Da'eef Ahadith 991","","","Cupping on the head"
"992","من أراد الحجامة فليتحر سبعة عشر أو تسعة عشر أو احدى وعشرين","","Majmu'a Da'eef Ahadith 992","","","Specific dates for cupping"
"993","احتجموا لخمس عشرة أو لسبع عشرة أو لتسع عشرة أو احدى و عشرين","","Majmu'a Da'eef Ahadith 993","","","Cupping on 15th, 17th, 19th, or 21st of lunar month"
"994","نهى عن الحجامة يوم السبت و يوم الأربعاء","","Majmu'a Da'eef Ahadith 994","","","Prohibited days for cupping"
"995","فى الجمعة ساعة لا يوافقها رجل يحتجم فيها الامات","","Majmu'a Da'eef Ahadith 995","","","Cupping on Friday risks death"
"996","حمى يوم كفارة سنة للذنوب","","Majmu'a Da'eef Ahadith 996","","","One day fever expiates a year’s sins"
"997","الشرب من فضل وضوء المؤمن فيه شفاء من كل داء أدناها الهم","","Majmu'a Da'eef Ahadith 997","","","Healing in leftover water of believer’s ablution"
"998","ريق المؤمن شفاء","","Majmu'a Da'eef Ahadith 998","","","Healing in believer’s saliva"
"999","طعام البخيل داء و طعام السخى شفاء","","Majmu'a Da'eef Ahadith 999","","","Healing in generous person’s food"
"1000","المعدة بيت الداء والحمية أصل الدواء","","Majmu'a Da'eef Ahadith 1000","","","Stomach is home of diseases"
"1001","المعدة حوض البدن و العروق اليها واردة ، فاذا صحت المعدة صدرت العروق بالصحة و اذا فسدت المعدة صدرت العروق بالسقم","","Majmu'a Da'eef Ahadith 1001","","","If stomach is healthy, all veins are healthy"
"1002","دواء العين ترك مسها","","Majmu'a Da'eef Ahadith 1002","","","Do not touch eye medicine"
"1003","ذهاب البصر مغفرة للذنوب و ذهاب السمع مغفرة للذنوب وما قنقص من الجسد فعلى مقدار ذالك","","Majmu'a Da'eef Ahadith 1003","","","Every bodily harm forgives sins"
"1004","ذهاب احدى رجلى الرجل غفران نصف ذنوبه و ذهابهما كلاهما غفران ذنوبه كلها","","Majmu'a Da'eef Ahadith 1004","","","Losing one foot forgives half the sins"
"1005","من لعق العسل ثلاث غدوات كل شهر لم يصبه عظيم من البلاء","","Majmu'a Da'eef Ahadith 1005","","","Drinking honey prevents major illness"
"1006","أن النبى صلى الله عليه وسلم أخذ بيد مجزوم فوضعها معه فى القصعة وقال : كل ثقة بالله و توكلا عليه","","Majmu'a Da'eef Ahadith 1006","","","Prophet ate with leper"
"1007","آخر الطب الكى","","Majmu'a Da'eef Ahadith 1007","","","Last treatment in medicine"
"1008","فاتحة الكتاب شفاء من كل داء","","Majmu'a Da'eef Ahadith 1008","","","Surah Fatiha heals every disease"
