hadiths[137]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3272","(حديث مقطوع) حَدَّثَنَا قَبِيصَةُ، أنبأنا سُفْيَانُ، عَنْ فِرَاسٍ، عَنْ الشَّعْبِيِّ:فِي الْمَرْأَةِ تَمُوتُ، قَالَ: ""تُكَفَّنُ مِنْ مَالِهَا، لَيْسَ عَلَى الزَّوْجِ شَيْءٌ"".""","Sahih","Sunan al-Darimi 3272","","","21. کفن کا خرچ تمام مال میں سے ہو گا"
"3273","(حديث مقطوع) حَدَّثَنَا سَعِيدُ بْنُ الْمُغِيرَةِ، عَنْ ابْنِ الْمُبَارَكِ، عَنْ ابْنِ جُرَيْجٍ، عَنْ عَطَاءٍ، قَالَ: الْحَنُوطُ، وَالْكَفَنُ مِنْ رَأْسِ الْمَالِ"".""","Da'if","Sunan al-Darimi 3273","","","21. کفن کا خرچ تمام مال میں سے ہو گا"
"3274","(حديث مقطوع) حَدَّثَنَا مُحَمَّدُ بْنُ عُيَيْنَةَ، عَنْ عَلِيِّ بْنِ مُسْهِرٍ، عَنْ إِسْمَاعِيل، عَنْ الْحَسَنِ، قَالَ: الْكَفَنُ مِنْ وَسَطِ الْمَالِ، يكفن على قدر ما كان يلبس في حياته، ثم يخرج الدين، ثم الثلث"".""","Da'if","Sunan al-Darimi 3274","","","21. کفن کا خرچ تمام مال میں سے ہو گا"
"3275","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا هُشَيْمٌ، أَنْبَأَنَا مَنْصُورٌ، عَنِ الْحَسَنِ، أَنَّهُ كَانَ يَقُولُ: إِذَا أَوْصَى الرَّجُلُ إِلَى الرَّجُلِ وَهُوَ غَائِبٌ، فَلْيَقْبَلْ وَصِيَّتَهُ، وَإِنْ كَانَ حَاضِرًا، فَهُوَ بِالْخِيَارِ: إِنْ شَاءَ، قَبِلَ، وَإِنْ شَاء، َتَرَكَ"".""","Hasan","Sunan al-Darimi 3275","","","22. کوئی آدمی ایسے شخص کے لئے وصیت کرے جو غائب ہو"
"3276","(حديث مقطوع) حَدَّثَنَا صَالِحُ بْنُ عَبْدِ اللَّهِ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ، عَنْ أَيُّوبَ، قَالَ: سَأَلْتُ الْحَسَنَ، وَمُحَمَّدًا عَنِالرَّجُلِ يُوصِي إِلَى الرَّجُلِ، قَالَا: نَخْتَارُ أَنْ يَقْبَلَ"".""","Sahih","Sunan al-Darimi 3276","","","22. کوئی آدمی ایسے شخص کے لئے وصیت کرے جو غائب ہو"
"3277","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا مُحَمَّدُ بْنُ أَسْعَدَ، حَدَّثَنَا أَبُو بَكْرٍ، عَنْ هِشَامٍ، عَنِ الْحَسَنِ، قَالَ: إِذَا أَوْصَى الرَّجُلُ إِلَى الرَّجُلِ وَهُوَ غَائِبٌ، فَإِذَا قَدِمَ فَإِنْ شَاءَ، قَبِلَ، فَإِذَا قَبِلَ، لَمْ يَكُنْ لَهُ أَنْ يَرُدَّ"".""","Hasan","Sunan al-Darimi 3277","","","22. کوئی آدمی ایسے شخص کے لئے وصیت کرے جو غائب ہو"
"3278","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا الْوَضَّاحُ بْنُ يَحْيَى، حَدَّثَنَا أَبُو بَكْرٍ، عَنْ هِشَامٍ، عَنْ الْحَسَنِ، قَالَ: إِذَا أَوْصَى الرَّجُلُ إِلَى الرَّجُلِ، فَعُرِضَتْ عَلَيْهِ الْوَصِيَّةُ، وَكَانَ غَائِبًا فَقَبِلَ، لَمْ يَكُنْ لَهُ أَنْ يَرْجِعَ"".""","","Sunan al-Darimi 3278","","","22. کوئی آدمی ایسے شخص کے لئے وصیت کرے جو غائب ہو"
"3279","(حديث مقطوع) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ، عَنْ شعبة، عَنْ أَبِي مَعْشَرٍ، عَنْ إِبْرَاهِيمَ، قَالَ: إِذَا أَوْصَى الرَّجُلُ لِإِنْسَانٍ، وَهُوَ غَائِبٌ، وَكَانَ مَيِّتًا، وَهُوَ لَا يَدْرِي، فَهِيَ رَاجِعَةٌ"".""","Sahih","Sunan al-Darimi 3279","","","23. مرے ہوئے آدمی کے لئے وصیت کرنے کا بیان"
"3280","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا يَزِيدُ بْنُ زُرَيْعٍ، حَدَّثَنَا يُونُسُ، عَنْ الْحَسَنِ، قَالَ: إِذَا أَوْصَى لِعَبْدِهِ ثُلُثَ مَالِهِ، رُبُعَ مَالِهِ، خُمُسَ مَالِهِ، فَهُوَ مِنْ مَالِهِ دَخَلَتْهُ عَتَاقَةٌ"".""","Hasan","Sunan al-Darimi 3280","","","24. غلام کے لئے وصیت کرنے کا بیان"
"3281","(حديث مقطوع) حَدَّثَنَا يَعْلَى، عَنْ إِسْمَاعِيل، عَنْ قَيْسٍ، قَالَ: كَانَ يُقَالُ: إِنَّ الرَّجُلَ لَيُحْرَمُ بَرَكَةَ مَالِهِ فِي حَيَاتِهِ، فَإِذَا كَانَ عِنْدَ الْمَوْتِ، تَزَوَّدَ بِفَجْرَةٍ"".""","Sahih","Sunan al-Darimi 3281","","","25. جن لوگوں نے موت کے وقت مال خرچ کرنے کو ناپسند کیا ہے"
"3282","(حديث موقوف) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللَّهِ، حَدَّثَنَا أَبُو زُبَيْدٍ، حَدَّثَنَا حُصَيْنٌ، عَنْ إِبْرَاهِيمَ التَّيْمِيِّ، عَنْ أَبِيهِ، قَالَ: قَالَ عَبْدُ اللَّهِ: الْمُرَّانِ: الْإِمْسَاكُ فِي الْحَيَاةِ، وَالتَّبْذِيرُ عِنْدَ الْمَوْتِ"". قَالَ أَبُو مُحَمَّد: يُقَالُ: مُرٌّ فِي الْحَيَاةِ، وَمُرٌّ عِنْدَ الْمَوْتِ.""","Sahih","Sunan al-Darimi 3282","","","25. جن لوگوں نے موت کے وقت مال خرچ کرنے کو ناپسند کیا ہے"
"3283","(حديث مقطوع) حَدَّثَنَا عُبَيْدُ اللَّهِ، عَنْ إِسْرَائِيلَ، عَنْ مَنْصُورٍ، عَنْ إِبْرَاهِيمَ، قَالَ: إِذَا أَوْصَى الرَّجُلُ لِآخَرَ بِمِثْلِ نَصِيبِ ابْنِهِ، فَلَا يَتِمُّ لَهُ مِثْلُ نَصِيبِهِ، حَتَّى يَنْقُصَ مِنْهُ"".""","Sahih","Sunan al-Darimi 3283","","","26. کوئی آدمی اس طرح وصیت کرے کہ فلاں کو فلاں کی طرح حصہ دیا جائے"
"3284","(حديث مقطوع) حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، عَنْ دَاوُدَ بْنِ أَبِي هِنْدٍ، عَنْ الشَّعْبِيِّ:فِي رَجُلٍ كَانَ لَهُ ثَلَاثَةُ بَنِينَ، فَأَوْصَى لِرَجُلٍ مِثْلَ نَصِيبِ أَحَدِهِمْ لَوْ كَانُوا أَرْبَعَةً، قَالَ الشَّعْبِيُّ: يُعْطَى الْخُمُسَ"".""","Sahih","Sunan al-Darimi 3284","","","26. کوئی آدمی اس طرح وصیت کرے کہ فلاں کو فلاں کی طرح حصہ دیا جائے"
"3285","(حديث مقطوع) حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا يَزِيدُ بْنُ زُرَيْعٍ، حَدَّثَنَا دَاوُدُ بْنُ أَبِي هِنْدٍ، قَالَ:سَأَلْنَا عَامِرًا عَنْ رَجُلٍ تَرَكَ ابْنَيْنِ، وَأَوْصَى بِمِثْلِ نَصِيبِ أَحَدِهِمْ لَوْ كَانُوا ثَلَاثَةً، قَالَ: أَوْصَى بِالرُّبُعِ"".""","Sahih","Sunan al-Darimi 3285","","","26. کوئی آدمی اس طرح وصیت کرے کہ فلاں کو فلاں کی طرح حصہ دیا جائے"
"3286","(حديث مقطوع) حَدَّثَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا أَبُو عَوَانَةَ، عَنْ مُغِيرَةَ، عَنْ إِبْرَاهِيمَ، قَالَ:فِي رَجُلٍ أَوْصَى بِمِثْلِ نَصِيبِ بَعْضِ الْوَرَثَةِ، قَالَ: لَا يَجُوزُ، وَإِنْ كَانَ أَقَلَّ مِنْ الثُّلُثِ""، قَالَ أَبُو مُحَمَّد: هُوَ حَسَنٌ.""","Sahih","Sunan al-Darimi 3286","","","26. کوئی آدمی اس طرح وصیت کرے کہ فلاں کو فلاں کی طرح حصہ دیا جائے"
"3287","(حديث مقطوع) حَدَّثَنَا قَبِيصَةُ، أنبأنا سُفْيَانُ، عَنْ ابْنِ أَبِي السَّفَرِ، عَنْ الشَّعْبِيِّ:فِي رَجُلٍ أَوْصَى فِي غَلَّةِ عَبْدِهِ بِدِرْهَمٍ، وَغَلَّتُهُ سِتَّةٌ، قَالَ: لَهُ سُدُسُهُ"".""","Sahih","Sunan al-Darimi 3287","","","27. کوئی آدمی کسی کے لئے اپنے غلام کی اجرت کی وصیت کرے"
"3288","(حديث مقطوع) أخبرنا قَبِيصَةُ، قَالَ: سَمِعْتُ سُفْيَانَ، يَقُولُ: إِذَا أَقَرَّ لِوَارِثٍ وَلِغَيْرِ وَارِثٍ بِمِائَةِ دِرْهَمٍ، قَالَ: أَرَى أَنْ أُبْطِلَهُمَا جَمِيعًا"".""","Sahih","Sunan al-Darimi 3288","","","28. وارث کے لئے وصیت کرنے کا بیان"
"3289","(حديث مقطوع) حَدَّثَنَا مُسْلِمٌ، حَدَّثَنَا هَمَّامٌ، حَدَّثَنَا قَتَادَةُ، عَنْ ابْنِ سِيرِينَ، عَنْ شُرَيْحٍ، قَالَ: لَا يَجُوزُ إِقْرَارٌ لِوَارِثٍ، قَالَ: وقال الْحَسَنُ: أَحَقُّ مَا جَازَ عَلَيْهِ عِنْدَ مَوْتِهِ: أَوَّلَ يَوْمٍ مِنْ أَيَّامِ الْآخِرَةِ، وَآخِرَ يَوْمٍ مِنْ أَيَّامِ الدُّنْيَا"".""","Hasan","Sunan al-Darimi 3289","","","28. وارث کے لئے وصیت کرنے کا بیان"
"3290","(حديث مقطوع) حَدَّثَنَا عَمْرُو بْنُ عَوْنٍ، أنبأنا خَالِدٌ، عَنْ خَالِدٍ، عَنْ أَبِي قِلَابَةَ، قَالَ: لَا يَجُوزُ لِوَارِثٍ وَصِيَّةٌ"".""","Sahih","Sunan al-Darimi 3290","","","28. وارث کے لئے وصیت کرنے کا بیان"
"3291","(حديث مقطوع) حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ، عَنْ حُمَيْدٍ:أَنَّ رَجُلًا يُكْنَى أَبَا ثَابِتٍ أَقَرَّ لِامْرَأَتِهِ عِنْدَ مَوْتِهِ أَنَّ لَهَا عَلَيْهِ أَرْبَعَ مِائَةِ دِرْهَمٍ مِنْ صَدَاقِهَا، فَأَجَازَهُ الْحَسَنُ"".""","Sahih","Sunan al-Darimi 3291","","","28. وارث کے لئے وصیت کرنے کا بیان"
"3292","(حديث مرفوع) حَدَّثَنَا مُسْلِمُ بْنُ إِبْرَاهِيمَ، حَدَّثَنَا هِشَامٌ الدَّسْتَوَائِيُّ، حَدَّثَنَا قَتَادَةُ، عَنْ شَهْرِ بْنِ حَوْشَبٍ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ، عَنْ عَمْرِو بْنِ خَارِجَةَ، قَالَ: كُنْتُ تَحْتَ نَاقَةِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهِيَ تَقْصَعُ بِجِرَّتِهَا، وَلُعَابُهَا يَنُوصُ بَيْنَ كَتِفَيَّ، سَمِعْتُهُ يَقُولُ: أَلَا إِنَّ اللَّهَ قَدْ أَعْطَى كُلَّ ذِي حَقٍّ حَقَّهُ، فَلَا يَجُوزُ وَصِيَّةٌ لِوَارِثٍ"".""","Hasan","Sunan al-Darimi 3292","","","28. وارث کے لئے وصیت کرنے کا بیان"
"3293","(حديث مقطوع) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، أنبأنا هَمَّامٌ، عَنْ قَتَادَةَ، قَال: إِذَا حَضَرَ أَحَدَكُمُ الْمَوْتُ إِنْ تَرَكَ خَيْرًا الْوَصِيَّةُ لِلْوَالِدَيْنِ وَالأَقْرَبِينَ بِالْمَعْرُوفِ حَقًّا عَلَى الْمُتَّقِينَ سورة البقرة آية 180، فَأَمَرَ أَنْ يُوصِيَ لِوَالِدَيْهِ وَأَقَارِبِهِ، ثُمَّ نُسِخَ بَعْدَ ذَلِكَ فِي سُورَةِ النِّسَاءِ، فَجَعَلَ لِلْوَالِدَيْنِ نَصِيبًا مَعْلُومًا، وَأَلْحَقَ لِكُلِّ ذِي مِيرَاثٍ نَصِيبَهُ مِنْهُ، وَلَيْسَتْ لَهُمْ وَصِيَّةٌ، فَصَارَتْ الْوَصِيَّةُ لِمَنْ لَا يَرِثُ مِنْ قَرِيبٍ وَغَيْرِهِ.""","Sahih","Sunan al-Darimi 3293","","","28. وارث کے لئے وصیت کرنے کا بیان"
"3294","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا وَرْقَاءُ، عَنْ ابْنِ أَبِي نَجِيحٍ، عَنْ عَطَاءٍ، عَنْ ابْنِ عَبَّاسٍ، قَالَ: كَانَ الْمَالُ لِلْوَلَدِ، وَكَانَتْ الْوَصِيَّةُ لِلْوَالِدَيْنِ وَالْأَقْرَبِينَ، فَنَسَخَ اللَّهُ مِنْ ذَلِكَ مَا أَحَبَّ، فَجَعَلَ لِلذَّكَرِ مِثْلَ حَظِّ الْأُنْثَيَيْنِ، وَجَعَلَ لِلْأَبَوَيْنِ لِكُلِّ وَاحِدٍ مِنْهُمَا السُّدُسَ وَالثُّلُثَ، وَجَعَلَ لِلْمَرْأَةِ الثُّمُنَ وَالرُّبُعَ، وَلِلزَّوْجِ الشَّطْرَ وَالرُّبُعَ"".""","Sahih","Sunan al-Darimi 3294","","","28. وارث کے لئے وصیت کرنے کا بیان"
"3295","(حديث مقطوع) حَدَّثَنَا أَحْمَدُ بْنُ إِسْمَاعِيل، حَدَّثَنَا أَبُو تُمَيْلَةَ، عَنْ الْحُسَيْنِ بْنِ وَاقِدٍ، عَنْ يَزِيدَ، عَنْ عِكْرِمَةَ، وَالْحَسَنِ: إِنْ تَرَكَ خَيْرًا الْوَصِيَّةُ لِلْوَالِدَيْنِ وَالأَقْرَبِينَ سورة البقرة آية 180، فكانت الوصية كذلك، حتى نسختها آية الميراث.""","Sahih","Sunan al-Darimi 3295","","","28. وارث کے لئے وصیت کرنے کا بیان"
"3296","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، عَنْ حُمَيْدٍ، عَنْ الْحَسَنِ،سُئِلَ عَنْ رَجُلٍ أَوْصَى وَلَهُ أَخٌ مُوسِرٌ، أَيُوصِ لَهُ؟ قَالَ: نَعَمْ، وَإِنْ كَانَ رَبَّ عِشْرِينَ أَلْفًا، ثُمَّ قَالَ: وَإِنْ كَانَ رَبَّ مِائَةِ أَلْفٍ، فَإِنَّ غِنَاهُ لَا يَمْنَعُهُ الْحَقَّ"".""","Sahih","Sunan al-Darimi 3296","","","29. مال دار کے لئے وصیت کرنے کا بیان"
"3297","(حديث مقطوع) حَدَّثَنَا عَفَّانُ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، حَدَّثَنَا قَتَادَةُ، عَنْ الْحَسَنِ، وَسَعِيدُ بْنُ الْمُسَيِّبِ:في رجل قَالَ: سَيْفِي لِفُلَانٍ، فَإِنْ مَاتَ فُلَانٌ، فَلِفُلَانٍ، فَإِنْ مَاتَ فُلَانٌ، فَمَرْجِعُهُ إِلَيَّ، قَالَا: هُوَ لِلْأَوَّلِ"". قَالَ: وَقَالَ حُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ: يُمْضَى كَمَا قَالَ.""","Sahih","Sunan al-Darimi 3297","","","30. کوئی آدمی اس طرح وصیت کرے کہ یہ فلاں کے لئے ہے وہ مر جائے تو فلاں کے لئے"
"3298","(حديث مقطوع) حَدَّثَنَا عَفَّانُ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، حَدَّثَنَا هِشَامُ بْنُ عُرْوَةَ: أَنَّ عُرْوَةَ، قَالَ:فِي الرَّجُلِ يُعْطِي الرَّجُلَ الْعَطَاءَ، فَيَقُولُ: هُوَ لَكَ، فَإِذَا مُتَّ، فَلِفُلَانٍ، فَإِذَا مَاتَ فُلَانٌ، فَلِفُلَانٍ، وَإِذَا مَاتَ فُلَانٌ، فَمَرْجِعُهُ إِلَيَّ. قَالَ: يُمْضَى كَمَا قَالَ، وَإِنْ كَانُوا مِائَةً"".""","Sahih","Sunan al-Darimi 3298","","","30. کوئی آدمی اس طرح وصیت کرے کہ یہ فلاں کے لئے ہے وہ مر جائے تو فلاں کے لئے"
"3299","(حديث مقطوع) حَدَّثَنَا مُسْلِمُ بْنُ إِبْرَاهِيمَ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ، حَدَّثَنَا شَيْبَةُ بْنُ هِشَامٍ الرَّاسِبِيُّ، وَكَثِيرُ بْنُ مَعْدَانَ، قَالَا: سَأَلْنَا سَالِمَ بْنَ عَبْدِ اللَّهِ عَنْالرَّجُلِ يُوصِي فِي غَيْرِ قَرَابَتِهِ، فَقَالَ سَالِمٌ: هِيَ حَيْثُ جَعَلَهَا، قَالَ: فَقُلْنَا: إِنَّ الْحَسَنَ يَقُولُ: يُرَدُّ عَلَى الْأَقْرَبِينَ، فَأَنْكَرَ ذَلِكَ، وَقَالَ قَوْلًا شَدِيدًا"".""","Sahih","Sunan al-Darimi 3299","","","31. کوئی آدمی اپنے غیر رشتے دار کے لئے وصیت کرے تو؟"
"3300","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللَّهِ، حَدَّثَنَا أَبُو شِهَابٍ، عَنْ عَمْرٍو، عَنْ الْحَسَنِ، قَالَ: إِذَا أَوْصَى الرَّجُلُ فِي قَرَابَتِهِ، فَهُوَ لِأَقْرَبِهِمْ بِبَطْنٍ: الذَّكَرُ وَالْأُنْثَى فِيهِ سَوَاءٌ"".""","Da'if","Sunan al-Darimi 3300","","","31. کوئی آدمی اپنے غیر رشتے دار کے لئے وصیت کرے تو؟"
"3301","(حديث مقطوع) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللَّهِ، حَدَّثَنَا أَبُو بَكْرٍ، عَنْ مُطَرِّفٍ، عَنْ الشَّعْبِيِّ:فِي رَجُلٍ قَالَ: أَحَدُ غُلَامَيَّ حُرٌّ ثُمَّ مَاتَ، وَلَمْ يُبَيِّنْ، قَالَ: الْوَرَثَةُ بِمَنْزِلَتِهِ يُعْتِقُونَ أَيَّهُمَا أَحَبُّوا"".""","Hasan","Sunan al-Darimi 3301","","","32. جب کوئی شخص اس طرح وصیت کرے: میرے غلاموں میں سے ایک میرے مرنے کے بعد آزاد ہے"
"3302","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، عَنْ يُونُسَ، عَنْ الْحَسَنِ:أَنَّ رَجُلًا قَالَ فِي مَرَضِهِ: لِفُلَانٍ كَذَا وَلِفُلَانٍ كَذَا، وَعَبْدِي فُلَانٌ حُرٌّ، وَلَمْ يَقُلْ: إِنْ حَدَثَ بِي حَدَثٌ، فَبَرَأَ، قَالَ: هُوَ مَمْلُوكٌ"".""","Hasan","Sunan al-Darimi 3302","","","33. جب کوئی آدمی بیماری میں آزادی کی وصیت کرے پھر تندرست ہو جائے؟"
"3303","(حديث مقطوع) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللَّهِ، حَدَّثَنَا أَبُو بَكْرٍ، عَنْ مُطَرِّفٍ، عَنْ الشَّعْبِيِّ:فِي رَجُلٍ أَعْتَقَ غُلَامَهُ عِنْدَ الْمَوْتِ، وَلَيْسَ لَهُ غَيْرُهُ، وَعَلَيْهِ دَيْنٌ، قَالَ: يَسْعَى لِلْغُرَمَاءِ فِي ثَمَنِهِ"".""","Hasan","Sunan al-Darimi 3303","","","34. کوئی آدمی اپنے غلام کو اپنی موت کے وقت آزاد کر دے اور اس کا کوئی اور مال نہ ہو"
"3304","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا أَبُو الْوَلِيدِ، حَدَّثَنَا هَمَّامٌ، حَدَّثَنَا قَتَادَةُ، عَنْ الْحَسَنِ:أَنَّ رَجُلًا اشْتَرَى عَبْدًا بِتِسْعِ مِائَةِ دِرْهَمٍ، فَأَعْتَقَهُ وَلَمْ يَقْضِ ثَمَنَ الْعَبْدِ، وَلَمْ يَتْرُكْ شَيْئًا، فَقَالَ عَلِيٌّ: يَسْعَى الْعَبْدُ فِي ثَمَنِهِ"".""","Sahih","Sunan al-Darimi 3304","","","34. کوئی آدمی اپنے غلام کو اپنی موت کے وقت آزاد کر دے اور اس کا کوئی اور مال نہ ہو"
"3305","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا مَنْصُورُ بْنُ سَلَمَةَ، عَنْ شَرِيكٍ، عَنْ الْأَشْعَثِ، عَنْ نَافِعٍ، عَنْ ابْنِ عُمَرَ، قَالَ: الْمُدَبَّرُ مِنْ الثُّلُثِ"".""","Da'if","Sunan al-Darimi 3305","","","35. جن علماء نے یہ کہا: کہ مدبر صرف ثلث میں سے آزاد ہو گا"
"3306","(حديث مقطوع) حَدَّثَنَا مَنْصُورُ بْنُ سَلَمَةَ، عَنْ شَرِيكٍ، عَنْ مَنْصُورٍ، عَنْ إِبْرَاهِيمَ، قَالَ: الْمُدَبَّرُ مِنْ الثُّلُثِ"".""","Hasan","Sunan al-Darimi 3306","","","35. جن علماء نے یہ کہا: کہ مدبر صرف ثلث میں سے آزاد ہو گا"
"3307","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ، عَنْ كَثِيرٍ، عَنْ الْحَسَنِ، قَالَ: الْمُعْتَقُ عَنْ دُبُرٍ مِنَ الثُّلُثِ"".""","Hasan","Sunan al-Darimi 3307","","","35. جن علماء نے یہ کہا: کہ مدبر صرف ثلث میں سے آزاد ہو گا"
"3308","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، عَنْ حُمَيْدٍ، عَنْ الْحَسَنِ، قَالَ: الْمُعْتَقَةُ عَنْ دُبُرٍ وَوَلَدُهَا مِنْ الثُّلُثِ"".""","Sahih","Sunan al-Darimi 3308","","","35. جن علماء نے یہ کہا: کہ مدبر صرف ثلث میں سے آزاد ہو گا"
"3309","(حديث مقطوع) حَدَّثَنَا أَبُو الْوَلِيدِ، حَدَّثَنَا شُعْبَةُ، قَالَ: مَنْصُورٌ أَخْبَرَنِي، عَنْ إِبْرَاهِيمَ، قَالَ: الْمُعْتَقُ عَنْ دُبُرٍ مِنَ الثُّلُثِ"".""","Sahih","Sunan al-Darimi 3309","","","35. جن علماء نے یہ کہا: کہ مدبر صرف ثلث میں سے آزاد ہو گا"
"3310","(حديث مقطوع) حَدَّثَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ، عَنْ أَبِي عَبْدِ اللَّهِ الشَّقَرِيِّ، وَأَبِي هَاشِمٍ، عَنْ إِبْرَاهِيمَ، قَالَ: الْمُدَبَّرُ مِنْ جَمِيعِ الْمَالِ"".""","Sahih","Sunan al-Darimi 3310","","","35. جن علماء نے یہ کہا: کہ مدبر صرف ثلث میں سے آزاد ہو گا"
"3311","(حديث موقوف) أَخْبَرَنَا الْحَكَمُ بْنُ الْمُبَارَكِ، أَنْبَأَنَا أَبُو عَوَانَةَ، عَنْ أَبِي بِشْرٍ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ، قَالَ: الْمُعْتَقُ عَنْ دُبُرٍ مِنْ جَمِيعِ الْمَالِ"". سُئِلَ أَبُو مُحَمَّد: بِأَيِّهِمَا تَقُولُ؟ قَالَ: مِنَ الثُّلُثِ.""","Sahih","Sunan al-Darimi 3311","","","35. جن علماء نے یہ کہا: کہ مدبر صرف ثلث میں سے آزاد ہو گا"
"3312","(حديث موقوف) أَخْبَرَنَا أَخْبَرَنَا سَعِيدُ بْنُ الْمُغِيرَةِ، حَدَّثَنَا مَخْلَدٌ، عَنْ هِشَامٍ، عَنْ الْحَسَنِ، قَالَ: لَا تَشْهَدْ عَلَى وَصِيَّةٍ حَتَّى تُقْرَأَ عَلَيْكَ، وَلَا تَشْهَدْ عَلَى مَنْ لَا تَعْرِفُ"".""","Hasan","Sunan al-Darimi 3312","","","36. وصیت پر اس وقت تک گواہ نہ بنو جب تک کہ پڑھ نہ لو"
"3313","(حديث موقوف) أَخْبَرَنَا أَخْبَرَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، عَنْ حُمَيْدٍ، عَنْ الْحَسَنِ: أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَوْصَى لِأُمَّهَاتِ أَوْلَادِهِ بِأَرْبَعَةِ آلَافٍ، أَرْبَعَةِ آلَافٍ، لِكُلِّ امْرَأَةٍ مِنْهُنَّ"".""","Hasan","Sunan al-Darimi 3313","","","37. اولاد کی ماؤں کے لئے وصیت کرنے کا بیان"
"3314","(حديث مقطوع) حَدَّثَنَا يَحْيَى بْنُ حَسَّانَ، أنبأنا ابْنُ أَبِي الزِّنَادِ، عَنْ أَبِيهِ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ: أَنَّهُ أَجَازَ وَصِيَّةَ ابْنِ ثَلَاثَ عَشْرَةَ سَنَةً"".""","Hasan","Sunan al-Darimi 3314","","","38. نوعمر لڑکے کی وصیت کا بیان"
"3315","(حديث مقطوع) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا زُهَيْرٌ، عَنْ أَبِي إِسْحَاق، قَالَ:أَوْصَى غُلَامٌ مِنْ الْحَيِّ ابْنُ سَبْعِ سِنِينَ، فَقَالَ شُرَيْحٌ: إِذَا أَصَابَ الْغُلَامُ فِي وَصِيَّتِهِ، جَازَتْ"". قَالَ أَبُو مُحَمَّد: يُعْجِبُنِي، وَالْقُضَاةُ لَا يُجِيزُونَ.""","Sahih","Sunan al-Darimi 3315","","","38. نوعمر لڑکے کی وصیت کا بیان"
"3316","(حديث مقطوع) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ، أَخْبَرَنَا يُونُسُ، حَدَّثَنَا أَبُو إِسْحَاق أَنَّهُشَهِدَ شُرَيْحًا أَجَازَ وَصِيَّةَ عَبَّاسِ بْنِ إِسْمَاعِيل بْنِ مَرْثَدٍ لِظِئْرِهِ مِنْ أَهْلِ الْحِيرَةِ""، وَعَبَّاسٌ صَبِيٌّ.""","Sahih","Sunan al-Darimi 3316","","","38. نوعمر لڑکے کی وصیت کا بیان"
"3317","(حديث مقطوع) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ، أنبأنا يُونُسُ، حَدَّثَنَا أَبُو إِسْحَاق، قَالَ: قَالَ شُرَيْحٌ: إِذَا اتَّقَى الصَّبِيُّ الرَّكِيَّةَ، جَازَتْ وَصِيَّتُهُ"".""","Sahih","Sunan al-Darimi 3317","","","38. نوعمر لڑکے کی وصیت کا بیان"
"3318","(حديث مقطوع) حَدَّثَنَا قَبِيصَةُ، حَدَّثَنَا سُفْيَانُ، عَنْ أَبِي إِسْحَاق:أَنَّ غُلَامًا مِنْهُمْ حِينَ ثُغِرَ يُقَالُ لَهُ مَرْثَدٌ: أَوْصَى لِظِئْرٍ لَهُ مِنْ أَهْلِ الْحِيرَةِ بِأَرْبَعِينَ دِرْهَمًا، فأجازه شريح، وَقَالَ: مَنْ أَصَابَ الْحَقَّ، أَجَزْنَاهُ"".""","Sahih","Sunan al-Darimi 3318","","","38. نوعمر لڑکے کی وصیت کا بیان"
"3319","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا يَزِيدُ بْنُ هَارُونَ، أَخْبَرَنَا يَحْيَى: أَنَّ أَبَا بَكْرِ بْنَ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ أَخْبَرَهُ:أَنَّ غُلَامًا بِالْمَدِينَةِ حَضَرَهُ الْمَوْتُ وَوَرَثَتُهُ بِالشَّامِ، وَأَنَّهُمْ ذَكَرُوا لِعُمَرَ أَنَّهُ يَمُوتُ، فَسَأَلُوهُ أَنْ يُوصِيَ، فَأَمَرَهُ عُمَرُ أَنْ يُوصِيَ، فَأَوْصَى بِبِئْرٍ يُقَالُ لَهَا: بِئْرُ جُشَمَ، وَإِنَّ أَهْلَهَا بَاعُوهَا بِثَلَاثِينَ أَلْفًا، ذَكَرَ أَبُو بَكْرٍ أَنَّ الْغُلَامَ كَانَ ابْنَ عَشْرِ سِنِينَ، أَوْ ثِنْتَيْ عَشْرَةَ"".""","","Sunan al-Darimi 3319","","","38. نوعمر لڑکے کی وصیت کا بیان"
"3320","(حديث مقطوع) حَدَّثَنَا يَزِيدُ، عَنْ هِشَامٍ الدَّسْتَوَائِيِّ، عَنْ حَمَّادٍ، عَنْ إِبْرَاهِيمَ، قَالَ: يَجُوزُ وَصِيَّةُ الصَّبِيِّ في ماله في الثلث، فما دونه، وإنما يمنعه وليه ذلك في الصحة رهبة الفاقة عليه، فأما عند الموت، فليس له أن يمنعه"".""","Sahih","Sunan al-Darimi 3320","","","38. نوعمر لڑکے کی وصیت کا بیان"
"3321","(حديث مقطوع) حَدَّثَنَا قَبِيصَةُ، حَدَّثَنَا سُفْيَانُ، عَنْ خالد الحذاء، وَأَيُّوبَ، عَنْ ابْنِ سِيرِينَ، عَنْ عَبْدِ اللَّهِ بْنِ عُتْبَةَ:أَنَّهُ أُتِيَ فِي جَارِيَةٍ أَوْصَتْ، فَجَعَلُوا يُصَغِّرُونَهَا، فَقَالَ: مَنْ أَصَابَ الْحَقَّ، أَجَزْنَاهُ"".""","Sahih","Sunan al-Darimi 3321","","","38. نوعمر لڑکے کی وصیت کا بیان"
"3322","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا قَبِيصَةُ، أَنْبَأَنَا سُفْيَانُ، عَنْ يَحْيَى بْنِ سَعِيدٍ، عَنْ أَبِي بَكْرٍ:أَنَّ سُلَيْمًا الْغَسَّانِيَّ مَاتَ وَهُوَ ابْنُ عَشْرٍ، أَوْ ثِنْتَيْ عَشْرَةَ سَنَةً، فَأَوْصَى بِبِئْرٍ لَهُ قِيمَتُهَا ثَلاثُونَ أَلْفًا""، فَأَجَازَهَا عُمَرُ بْنُ الْخَطَّابِ، قَالَ أَبُو مُحَمَّدٍ: النَّاسُ يَقُولُونَ: عَمْرُو بْنُ سُلَيْمٍ.""","Sahih","Sunan al-Darimi 3322","","","38. نوعمر لڑکے کی وصیت کا بیان"
"3323","(حديث موقوف) حَدَّثَنَا قَبِيصَةُ، حَدَّثَنَا سُفْيَانُ، عَنْ ابْنَيْهِ: عَبْدِ اللَّهِ، وَمُحَمَّدٍ ابْنَيْ أَبِي بَكْرٍ، عَنْ أَبِيهِمَا مِثْلَ ذَلِكَ، غَيْرَ أَنَّ أَحَدَهُمَا قَالَ: ابْنُ ثَلَاثَ عَشْرَةَ، وَقَالَ الْآخَرُ: قَبْلَ أَنْ يَحْتَلِمَ. قَالَ أَبُو مُحَمَّد: عَنْ ابْنَيْهِ، يَعْنِي: ابْنَيْ أَبِي بَكْرٍ.","","Sunan al-Darimi 3323","","","38. نوعمر لڑکے کی وصیت کا بیان"
"3324","(حديث مقطوع) حَدَّثَنَا نَصْرُ بْنُ عَلِيٍّ، حَدَّثَنَا عَبْدُ الْأَعْلَى، عَنْ مَعْمَرٍ، عَنْ الزُّهْرِيِّ، أَنَّهُ كَانَ يَقُولُ: وَصِيَّتُهُ لَيْسَتْ بِجَائِزَةٍ إِلَّا مَا لَيْسَ بِذِي بَالٍ، يَعْنِي: الْغُلَامَ قَبْلَ أَنْ يَحْتَلِمَ"".""","Sahih","Sunan al-Darimi 3324","","","39. جن علماء نے کہا بچے کی وصیت قابل عمل نہ ہو گی"
"3325","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا عَمْرُو بْنُ عَوْنٍ، أَنْبَأَنَا هُشَيْمٌ، عَنْ يُونُسَ، عَنِ الْحَسَنِ، قَالَ: لَا يَجُوزُ طَلَاقُ الْغُلَامِ وَلَا وَصِيَّتُهُ، وَلَا هِبَتُهُ، وَلَا صَدَقَتُهُ، وَلَا عَتَاقَتُهُ، حَتَّى يَحْتَلِمَ"".""","Hasan","Sunan al-Darimi 3325","","","39. جن علماء نے کہا بچے کی وصیت قابل عمل نہ ہو گی"
"3326","(حديث موقوف) حَدَّثَنَا سَعِيدُ بْنُ الْمُغِيرَةِ، عَنْ حَفْصِ بْنِ غِيَاثٍ، عَنْ حَجَّاجٍ، عَنْ عَطَاءٍ، عَنْ ابْنِ عَبَّاسٍ، قَالَ: لَا يَجُوزُ طَلَاقُ الصَّبِيِّ، وَلَا عِتْقُهُ، وَلَا وَصِيَّتُهُ، وَلَا شِرَاؤُهُ، وَلَا بَيْعُهُ، وَلَا شَيْءٌ"".""","Da'if","Sunan al-Darimi 3326","","","39. جن علماء نے کہا بچے کی وصیت قابل عمل نہ ہو گی"
"3327","(حديث مقطوع) حَدَّثَنَا أَبُو الْوَلِيدِ، حَدَّثَنَا هَمَّامٌ، عَنْ قَتَادَةَ، عَنْ حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ الْحِمْيَرِيِّ، قَالَ: لَا يَجُوزُ طَلَاقٌ، وَلَا وَصِيَّةٌ، إِلَّا فِي عَقْلٍ، إِلَّا النَّشْوَانَ، يَعْنِي: السَّكْرَانَ، فَإِنَّهُ يَجُوزُ طَلَاقُهُ، وَيُضْرَبُ ظَهْرُهُ"".""","Sahih","Sunan al-Darimi 3327","","","39. جن علماء نے کہا بچے کی وصیت قابل عمل نہ ہو گی"
"3328","(حديث مقطوع) حَدَّثَنَا عَمْرُو بْنُ عَوْنٍ، عَنْ خَالِدِ بْنِ عَبْدِ اللَّهِ، عَنْ يَحْيَى بْنِ أَبِي إِسْحَاق، قَالَ:سَأَلْتُ الْقَاسِمَ بْنَ عَبْدِ الرَّحْمَنِ، وَمُعَاوِيَةَ بْنَ قُرَّةَ عَنْ رَجُلٍ قَالَ فِي وَصِيَّتِهِ:""كُلُّ لِي حُرٌّ، وَلَهُ مَمْلُوكٌ آبِقٌ، فَقَالَا: هُوَ حُرٌّ""، قَالَ الْحَسَنُ، وَإِيَاسٌ، وَبَكْرُ بْنُ عَبْدِ اللَّهِ: ليس بحر.""","Sahih","Sunan al-Darimi 3328","","","40. کوئی شخص اپنے بھاگے ہوئے غلام کی آزادی کی وصیت کرے"
"3329","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ، حَدَّثَنَا عَبْدُ اللَّهِ الْعُمَرِيُّ، عَنْ نَافِعٍ، عَنْ ابْنِ عُمَرَ:أَنَّ عُمَرَ أَوْصَى إِلَى حَفْصَةَ أُمِّ الْمُؤْمِنِينَ"".""","Hasan","Sunan al-Darimi 3329","","","41. عورتوں کے لئے وصیت کا بیان"
"3330","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا سُفْيَانُ، عَنْ لَيْثٍ، عَنْ نَافِعٍ، عَنْ ابْنِ عُمَرَ:أَنَّ صَفِيَّةَ أَوْصَتْ لِنَسِيبٍ لَهَا يَهُودِيٍّ"".""","Sahih","Sunan al-Darimi 3330","","","42. اہل الذمہ کے لئے وصیت کا بیان"
"3331","(حديث مقطوع) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا زُهَيْرٌ، عَنْ أَبِي إِسْحَاق، قَالَ:أَوْصَى غُلَامٌ مِنَ الْحَيِّ، يُقَالُ لَهُ: عَبَّاسُ بْنُ مَرْثَدٍ ابْنُ سَبْعِ سِنِينَ لِظِئْرٍ لَهُ يَهُودِيَّةٍ مِنْ أَهْلِ الْحِيرَةِ بِأَرْبَعِينَ دِرْهَمًا، فَقَالَ شُرَيْحٌ: إِذَا أَصَابَ الْغُلَامُ فِي وَصِيَّتِهِ، جَازَتْ وَإِنَّمَا أَوْصَى لِذِي حَقٍّ""، قَالَ أَبُو مُحَمَّد: أَنَا أَقُولُ بِهِ.""","Sahih","Sunan al-Darimi 3331","","","42. اہل الذمہ کے لئے وصیت کا بیان"
"3332","(حديث موقوف) أَخْبَرَنَا أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ سَعِيدٍ، حَدَّثَنَا أَبُو أُسَامَةَ، عَنْ هِشَامٍ، عَنْ أَبِيهِ:أَنَّ الزُّبَيْرَ جَعَلَ دُورَهُ صَدَقَةً عَلَى بَنِيهِ، لَا تُبَاعُ وَلَا تُوَرَّثُ، وَأَنَّ لِلْمَرْدُودَةِ مِنْ بَنَاتِهِ أَنْ تَسْكُنَ غَيْرَ مُضِرَّةٍ وَلَا مُضَارٍّ بِهَا، فَإِنْ هِيَ اسْتَغْنَتْ بِزَوْجٍ، فَلَا حَقَّ لَهَا"".""","Sahih","Sunan al-Darimi 3332","","","43. وقف کا بیان"
"3333","(حديث مقطوع) حَدَّثَنَا الْحَكَمُ بْنُ الْمُبَارَكِ، أنبأنا الْوَلِيدُ، عَنْ حَفْصٍ، عَنْ مَكْحُولٍ:فِي الرَّجُلِ يُوصِي لِلرَّجُلِ بِدَنَانِيرَ فِي سَبِيلِ اللَّهِ، فَيَمُوتُ الْمُوصَى لَهُ قَبْلَ أَنْ يَخْرُجَ بِهَا مِنْ أَهْلِهِ، قَالَ: هِيَ إِلَى أَوْلِيَاءِ الْمُتَوَفَّى الْمُوصِي، يُنْفِذُونَهَا فِي سَبِيلِ اللَّهِ"".""","Da'if","Sunan al-Darimi 3333","","","44. وصیت کرنے والے سے پہلے اگر موصی لہ کا انتقال ہو جائے"
"3334","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا مُحَمَّدُ بْنُ عُيَيْنَةَ، عَنْ عَلِيِّ بْنِ مُسْهِرٍ، عَنْ أَشْعَثَ، عَنْ الْحَسَنِ:فِي الرَّجُلِ يُوصِي لِلرَّجُلِ بِالْوَصِيَّةِ، فَيَمُوتُ الْمُوصَى لَهُ قَبْلَ الْمُوصِي، قَالَ: هِيَ جَائِزَةٌ لِوَرَثَةِ الْمُوصَى لَهُ.""","Hasan","Sunan al-Darimi 3334","","","44. وصیت کرنے والے سے پہلے اگر موصی لہ کا انتقال ہو جائے"
"3335","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ عُيَيْنَةَ، عَنْ عَلِيِّ بْنِ مُسْهِرٍ، عَنْ أَشْعَثَ، عَنْ أَبِي إِسْحَاق السَّبِيعِيِّ، قَالَ: حُدِّثْتُ أَنَّ عَلِيًّا كَانَ يُجِيزُهَا مِثْلَ قَوْلِ الْحَسَنِ.","Da'if","Sunan al-Darimi 3335","","","44. وصیت کرنے والے سے پہلے اگر موصی لہ کا انتقال ہو جائے"
"3336","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا الْحَكَمُ بْنُ الْمُبَارَكِ، أَنْبَأَنَا عَبْدُ الْعَزِيزِ هُوَ ابْنُ مُحَمَّدٍ، عَنْ مُوسَى هُوَ ابْنُ عُقْبَةَ، عَنْ نَافِعٍ:أَنَّ رَجُلًا جَاءَ إِلَى ابْنِ عُمَرَ فَقَالَ: إِنَّ رَجُلًا أَوْصَى إِلَيَّ وَجَعَلَ نَاقَةً فِي سَبِيلِ اللَّهِ، وَلَيْسَ هَذَا زَمَانًا يُخْرَجُ إِلَى الْغَزْوِ، فَأَحْمِلُ عَلَيْهَا فِي الْحَجِّ؟ فَقَالَ ابْنُ عُمَرَ: الْحَجُّ وَالْعُمْرَةُ فِي سَبِيلِ اللَّهِ"".""","Sahih","Sunan al-Darimi 3336","","","45. جب کوئی آدمی فی سبیل اللہ کسی چیز کی وصیت کرے؟"
"3337","(حديث موقوف) أَخْبَرَنَا أَخْبَرَنَا عُبَيْدُ اللَّهِ بْنُ مُوسَى، عَنْ مُوسَى بْنِ عُبَيْدَةَ، عَنْ وَاقِدِ بْنِ مُحَمَّدِ بْنِ زَيْدِ بْنِ عَبْدِ اللَّهِ بْنِ عُمَرَ:أَنَّ رَجُلًا أَوْصَى بِمَالِهِ فِي سَبِيلِ اللَّهِ، فَسَأَلَ الْوَصِيُّ عَنْ ذَلِكَ عُمَرَ، فَقَالَ: أَعْطِهِ عُمَّالَ اللَّهِ، قَالَ: وَمَنْ عُمَّالُ اللَّهِ؟ قَالَ: حَاجُّ بَيْتِ اللَّهِ"".""","Da'if","Sunan al-Darimi 3337","","","45. جب کوئی آدمی فی سبیل اللہ کسی چیز کی وصیت کرے؟"
"3338","(حديث مرفوع) حَدَّثَنَا عَمْرُو بْنُ زُرَارَةَ، حَدَّثَنَا جَرِيرٌ، عَنْ قَابُوسَ، عَنْ أَبِيهِ، عَنْ ابْنِ عَبَّاسٍ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: إِنَّ الرَّجُلَ الَّذِي لَيْسَ فِي جَوْفِهِ مِنْ الْقُرْآنِ شَيْءٌ كَالْبَيْتِ الْخَرِبِ"".""","Hasan","Sunan al-Darimi 3338","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3339","(حديث موقوف) أَخْبَرَنَا أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ خَالِدِ بْنِ حَازِمٍ، حَدَّثَنَا مُحَمَّدُ بْنُ مسْلَمَةَ، حَدَّثَنَا أَبُو سِنَانٍ، عَنْ أَبِي إِسْحَاق، عَنْ أَبِي الْأَحْوَصِ، عَنْ عَبْدِ اللَّهِ، قَالَ: إِنَّ هَذَا الْقُرْآنَ مَأْدُبَةُ اللَّهِ، فَخُذُوا مِنْهُ مَا اسْتَطَعْتُمْ، فَإِنِّي لَا أَعْلَمُ شَيْئًا أَصْفَرَ مِنْ خَيْرٍ، مِنْ بَيْتٍ لَيْسَ فِيهِ مِنْ كِتَابِ اللَّهِ شَيْءٌ، وَإِنَّ الْقَلْبَ الَّذِي لَيْسَ فِيهِ مِنْ كِتَابِ اللَّهِ شَيْءٌ، خَرِبٌ كَخَرَابِ الْبَيْتِ الَّذِي لَا سَاكِنَ لَهُ"".""","","Sunan al-Darimi 3339","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3340","(حديث موقوف) حَدَّثَنَا أَبُو عَامِرٍ قَبِيصَةُ، أَنْبَأَنَا سُفْيَانُ، عَنْ عَطَاءِ بْنِ السَّائِبِ، عَنْ أَبِي الْأَحْوَصِ، عَنْ عَبْدِ اللَّهِ، قَالَ: تَعَلَّمُوا هَذَا الْقُرْآنَ، فَإِنَّكُمْ تُؤْجَرُونَ بِتِلَاوَتِهِ بِكُلِّ حَرْفٍ عَشْرَ حَسَنَاتٍ، أَمَا إِنِّي لَا أَقُولُ بِ (الم)، وَلَكِنْ بِأَلِفٍ، وَلَامٍ، وَمِيمٍ، بِكُلِّ حَرْفٍ عَشْرُ حَسَنَاتٍ"".""","Hasan","Sunan al-Darimi 3340","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3341","(حديث موقوف) حَدَّثَنَا مُعَاذُ بْنُ هَانِئٍ، حَدَّثَنَا حَرْبُ بْنُ شَدَّادٍ، حَدَّثَنَا يَحْيَى هُوَ ابْنُ أَبِي كَثِيرٍ، حَدَّثَنِي حَفْصُ بْنُ عِنَانٍ الْحَنَفِيُّ: أَنَّ أَبَا هُرَيْرَةَ كَانَ يَقُولُ: إِنَّ الْبَيْتَ لَيَتَّسِعُ عَلَى أَهْلِهِ وَتَحْضُرُهُ الْمَلَائِكَةُ وَتَهْجُرُهُ الشَّيَاطِينُ، وَيَكْثُرُ خَيْرُهُ أَنْ يُقْرَأَ فِيهِ الْقُرْآنُ، وَإِنَّ الْبَيْتَ لَيَضِيقُ عَلَى أَهْلِهِ وَتَهْجُرُهُ الْمَلَائِكَةُ، وَتَحْضُرُهُ الشَّيَاطِينُ، وَيَقِلُّ خَيْرُهُ، أَنْ لَا يُقْرَأَ فِيهِ الْقُرْآنُ"".""","Sahih","Sunan al-Darimi 3341","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3342","(حديث مرفوع) حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يَزِيدَ، حَدَّثَنَا ابْنُ لَهِيعَةَ، عَنْ مِشْرَحِ بْنِ هَاعَانَ، قَالَ: سَمِعْتُ عُقْبَةَ بْنَ عَامِرٍ، يَقُولُ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: لَوْ جُعِلَ الْقُرْآنُ فِي إِهَابٍ، ثُمَّ أُلْقِيَ فِي النَّارِ، مَا احْتَرَقَ"".""","Da'if","Sunan al-Darimi 3342","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3343","(حديث مرفوع) حَدَّثَنَا عَبْدُ اللَّهِ بْنُ جَعْفَرٍ الرَّقِّيُّ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَمْرٍو، عَنْ زَيْدِ بْنِ أَبِي أُنَيْسَةَ، عَنْ عَاصِمٍ، عَنْ أَبِي صَالِحٍ، قَالَ: سَمِعْتُ أَبَا هُرَيْرَةَ، يَقُولُ: اقْرَءُوا الْقُرْآنَ، فَإِنَّهُ نِعْمَ الشَّفِيعُ يَوْمَ الْقِيَامَةِ""، إِنَّهُ يَقُولُ يَوْمَ الْقِيَامَةِ: يَا رَبِّ، حَلِّهِ حِلْيَةَ الْكَرَامَةِ، فَيُحَلَّى حِلْيَةَ الْكَرَامَةِ، يَا رَبِّ، اكْسُهُ كِسْوَةَ الْكَرَامَةِ، فَيُكْسَى كِسْوَةَ الْكَرَامَةِ، يَا رَبِّ، أَلْبِسْهُ تَاجَ الْكَرَامَةِ، يَا رَبِّ، ارْضَ عَنْهُ، فَلَيْسَ بَعْدَ رِضَاكَ شَيْءٌ"".""","Hasan","Sunan al-Darimi 3343","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3344","(حديث مرفوع) حَدَّثَنَا مُوسَى بْنُ خَالِدٍ، حَدَّثَنَا إِبْرَاهِيمُ بْنُ مُحَمَّدٍ الْفَزَارِيُّ، عَنْ سُفْيَانَ، عَنْ عَاصِمٍ، عَنْ مُجَاهِدٍ، عَنْ ابْنِ عُمَرَ، قَالَ: يَجِيءُ الْقُرْآنُ يَشْفَعُ لِصَاحِبِهِ، يَقُولُ: يَا رَبِّ لِكُلِّ عَامِلٍ عُمَالَةٌ مِنْ عَمَلِهِ، وَإِنِّي كُنْتُ أَمْنَعُهُ اللَّذَّةَ وَالنَّوْمَ، فَأَكْرِمْهُ، فَيُقَالُ: ابْسُطْ يَمِينَكَ، فَتُمْلَأُ مِنْ رِضْوَانِ اللَّهِ، ثُمَّ يُقَالُ: ابْسُطْ شِمَالَكَ، فَتُمْلَأُ مِنْ رِضْوَانِ اللَّهِ، وَيُكْسَى كِسْوَةَ الْكَرَامَةِ، وَيُحَلَّى بِحِلْيَةِ الْكَرَامَةِ، وَيُلْبَسُ تَاجَ الْكَرَامَةِ"".""","Hasan","Sunan al-Darimi 3344","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3345","(حديث مرفوع) أَخْبَرَنَا مُوسَى بْنُ خَالِدٍ، حَدَّثَنَا إِبْرَاهِيمُ بْنُ مُحَمَّدٍ الْفَزَارِيُّ، عَنْ الْحَسَنِ بْنِ عُبَيْدِ اللَّهِ، عَنْ الْمُسَيَّبِ بْنِ رَافِعٍ، عَنْ أَبِي صَالِحٍ، قَالَ: الْقُرْآنُ يَشْفَعُ لِصَاحِبِهِ، فَيُكْسَى حُلَّةَ الْكَرَامَةِ، ثُمَّ يَقُولُ: رَبِّ زِدْهُ، فَيُكْسَى تَاجَ الْكَرَامَةِ، قَالَ: فَيَقُولُ: رَبِّ زِدْهُ، فَآتِهِ، وَآتِهِ... قَالَ: يَقُولُ: رِضَائِي"". قَالَ أَبُو مُحَمَّد: قَالَ وُهَيْبُ بْنُ الْوَرْدِ: اجْعَلْ قِرَاءَتَكَ الْقُرْآنَ عِلْمًا، وَلَا تَجْعَلْهُ عَمَلًا.""","Sahih","Sunan al-Darimi 3345","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3346","(حديث مرفوع) حَدَّثَنَا مُوسَى بْنُ خَالِدٍ، حَدَّثَنَا إِبْرَاهِيمُ الْفَزَارِيُّ، عَنْ الْأَعْمَشِ، عَنْ أَبِي صَالِحٍ، عَنْ أَبِي هُرَيْرَةَ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: أَيُحِبُّ أَحَدُكُمْ إِذَا أَتَى أَهْلَهُ أَنْ يَجِدَ ثَلَاثَ خَلِفَاتٍ سِمَانٍ، قَالُوا: نَعَمْ يَا رَسُولَ اللَّهِ، قَالَ:""فَثَلَاثُ آيَاتٍ يَقْرَؤُهُنَّ أَحَدُكُمْ، خَيْرٌ لَهُ مِنْهُنَّ"".""","Sahih","Sunan al-Darimi 3346","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3347","(حديث موقوف) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ، حَدَّثَنَا إِبْرَاهِيمُ هُوَ الْهَجَرِيُّ، عَنْ أَبِي الْأَحْوَصِ، عَنْ عَبْدِ اللَّهِ، قَالَ: إِنَّ هَذَا الْقُرْآنَ مَأْدُبَةُ اللَّهِ، فَتَعَلَّمُوا مِنْ مَأْدُبَتِهِ مَا اسْتَطَعْتُمْ، إِنَّ هَذَا الْقُرْآنَ حَبْلُ اللَّهِ، وَالنُّورُ الْمُبِينُ، وَالشِّفَاءُ النَّافِعُ، عِصْمَةٌ لِمَنْ تَمَسَّكَ بِهِ، وَنَجَاةٌ لِمَنْ اتَّبَعَهُ، لَا يَزِيغُ فَيَسْتَعْتِبُ، وَلَا يَعْوَجُّ فَيُقَوَّمُ، وَلَا تَنْقَضِي عَجَائِبُهُ، وَلَا يَخْلَقُ عَنْ كَثْرَةِ الرَّدِّ، فَاتْلُوهُ، فَإِنَّ اللَّهَ يَأْجُرُكُمْ عَلَى تِلَاوَتِهِ بِكُلِّ حَرْفٍ عَشْرَ حَسَنَاتٍ، أَمَا إِنِّي لَا أَقُولُ (الم) وَلَكِنْ بِأَلِفٍ، وَلَامٍ، وَمِيمٍ"".""","Da'if","Sunan al-Darimi 3347","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3348","(حديث مرفوع) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ، حَدَّثَنَا أَبُو حَيَّانَ، عَنْ يَزِيدَ بْنِ حَيَّانَ، عَنْ زَيْدِ بْنِ أَرْقَمَ، قَالَ: قَامَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَوْمًا خَطِيبًا فَحَمِدَ، اللَّهَ وَأَثْنَى عَلَيْهِ، ثُمَّ قَالَ:يَا أَيُّهَا النَّاسُ، إِنَّمَا أَنَا بَشَرٌ يُوشِكُ أَنْ يَأْتِيَنِي رَسُولُ رَبِّي، فَأُجِيبَهُ، وَإِنِّي تَارِكٌ فِيكُمْ الثَّقَلَيْنِ: أَوَّلُهُمَا كِتَابُ اللَّهِ فِيهِ الْهُدَى وَالنُّورُ، فَتَمَسَّكُوا بِكِتَابِ اللَّهِ، وَخُذُوا بِهِ""فَحَثَّ عَلَيْهِ وَرَغَّبَ فِيهِ، ثُمَّ قَالَ:""وَأَهْلَ بَيْتِي، أُذَكِّرُكُمْ اللَّهَ فِي أَهْلِ بَيْتِي، ثَلَاثَ مَرَّاتٍ"".""","Sahih","Sunan al-Darimi 3348","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3349","(حديث موقوف) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ، أَنْبَأَنَا الْأَعْمَشُ، عَنْ أَبِي وَائِلٍ، قَالَ: قَالَ عَبْدُ اللَّهِ: إِنَّ هَذَا الصِّرَاطَ مُحْتَضَرٌ، تَحْضُرُهُ الشَّيَاطِينُ يُنَادُونَ: يَا عِبَادَ اللَّهِ، هَذَا الطَّرِيقُ، فَاعْتَصِمُوا بِحَبْلِ اللَّهِ، فَإِنَّ حَبْلَ اللَّهِ الْقُرْآنُ"".""","Sahih","Sunan al-Darimi 3349","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3350","(حديث مرفوع) أَخْبَرَنَا أَبُو الْمُغِيرَةِ، حَدَّثَتْنَا عَبْدَةُ، عَنْ خَالِدِ بْنِ مَعْدَانَ، قَالَ: إِنَّ قَارِئَ الْقُرْآنِ وَالْمُتَعَلِّمَ تُصَلِّي عَلَيْهِمْ الْمَلَائِكَةُ حَتَّى يَخْتِمُوا السُّورَةَ، فَإِذَا أَقْرَأَ أَحَدُكُمْ السُّورَةَ، فَلْيُؤَخِّرْ مِنْهَا آيَتَيْنِ حَتَّى يَخْتِمَهَا مِنْ آخِرِ النَّهَارِ كَيْ مَا تُصَلِّي الْمَلَائِكَةُ عَلَى الْقَارِئِ وَالْمُقْرِئِ مِنْ أَوَّلِ النَّهَارِ إِلَى آخِرِهِ"".""","","Sunan al-Darimi 3350","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3351","(حديث مرفوع) أَخْبَرَنَا الْحَكَمُ بْنُ نَافِعٍ، أَنْبَأَنَا حَرِيزٌ، عَنْ شُرَحْبِيلَ بْنِ مُسْلِمٍ الْخَوْلَانِيِّ، عَنْ أَبِي أُمَامَةَ: أَنَّهُ كَانَ يَقُولُ: اقْرَءُوا الْقُرْآنَ، وَلَا يَغُرَّنَّكُمْ هَذِهِ الْمَصَاحِفُ الْمُعَلَّقَةُ، فَإِنَّ اللَّهَ لَنْ يُعَذِّبَ قَلْبًا وَعَى الْقُرْآنَ"".""","Sahih","Sunan al-Darimi 3351","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3352","(حديث مرفوع) حَدَّثَنَا عَبْدُ اللَّهِ بْنُ صَالِحٍ، حَدَّثَنِي مُعَاوِيَةُ بْنُ صَالِحٍ، عَنْ سُلَيْمِ بْنِ عَامِرٍ، عَنْ أَبِي أُمَامَةَ الْبَاهِلِيِّ، قَالَ: : اقْرَءُوا الْقُرْآنَ، وَلَا يَغُرَّنَّكُمْ هَذِهِ الْمَصَاحِفُ الْمُعَلَّقَةُ، فَإِنَّ اللَّهَ لَا يُعَذِّبُ قَلْبًا وَعَى الْقُرْآنَ"".""","Da'if","Sunan al-Darimi 3352","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3353","(حديث موقوف) أَخْبَرَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا مِسْعَرٌ، عَنْ مَعْنِ بْنِ عَبْدِ الرَّحْمَنِ، عَنْ ابْنِ مَسْعُودٍ، قَالَ: لَيْسَ مِنْ مُؤَدِّبٍ إِلَّا وَهُوَ يُحِبُّ أَنْ يُؤْتَى أَدَبُهُ، وَإِنَّ أَدَبَ اللَّهِ الْقُرْآنُ"".""","Sahih","Sunan al-Darimi 3353","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3354","(حديث موقوف) حَدَّثَنَا سَهْلُ بْنُ حَمَّادٍ، حَدَّثَنَا شُعْبَةُ، عَنْ عَبْدِ الْمَلِكِ بْنِ مَيْسَرَةَ، عَنْ أَبِي الْأَحْوَصِ، قَالَ: كَانَ عَبْدُ اللَّهِ، يَقُولُ: إِنَّ هَذَا الْقُرْآنَ مَأْدُبَةُ اللَّهِ، فَمَنْ دَخَلَ فِيهِ، فَهُوَ آمِنٌ"".""","Sahih","Sunan al-Darimi 3354","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3355","(حديث موقوف) أَخْبَرَنَا يَحْيَى بْنُ حَمَّادٍ، حَدَّثَنَا أَبُو عَوَانَةَ، عَنْ الْأَعْمَشِ، عَنْ إِبْرَاهِيمَ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ، عَنْ عَبْدِ اللَّهِ، قَالَ: مَنْ أَحَبَّ الْقُرْآنَ، فَلْيُبْشِرْ"".""","Sahih","Sunan al-Darimi 3355","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3356","(حديث موقوف) حَدَّثَنَا يَعْلَى، حَدَّثَنَا الْأَعْمَشُ، عَنْ إِبْرَاهِيمَ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ، عَنْ عَبْدِ اللَّهِ، قَالَ: مَنْ أَحَبَّ الْقُرْآنَ، فَلْيُبْشِرْ"".""","Sahih","Sunan al-Darimi 3356","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3357","(حديث موقوف) حَدَّثَنَا يَزِيدُ بْنُ هَارُونَ، أَنْبَأَنَا هَمَّامٌ، عَنْ عَاصِمِ بْنِ أَبِي النُّجُودِ، عَنِ الشَّعْبِيِّ: أَنَّ ابْنَ مَسْعُودٍ كَانَ يَقُولُ: يَجِيءُ الْقُرْآنُ يَوْمَ الْقِيَامَةِ فَيَشْفَعُ لِصَاحِبِهِ، فَيَكُونُ لَهُ قَائِدًا إِلَى الْجَنَّةِ، وَيَشْهَدُ عَلَيْهِ، وَيَكُونُ لَهُ سَائِقًا إِلَى النَّارِ"".""","Hasan","Sunan al-Darimi 3357","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3358","(حديث مرفوع) حَدَّثَنَا مُسْلِمُ بْنُ إِبْرَاهِيمَ، حَدَّثَنَا الْحَسَنُ بْنُ أَبِي جَعْفَرٍ، حَدَّثَنَا بُدَيْلٌ، عَنْ أَنَسٍ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: إِنَّ لِلَّهِ أَهْلِينَ مِنَ النَّاسِ، قِيلَ: يَا رَسُولَ اللَّهِ، مَنْ هُمْ؟ قَالَ: أَهْلُ الْقُرْآنِ"".""","Hasan","Sunan al-Darimi 3358","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3359","(حديث موقوف) حَدَّثَنَا عَمْرُو بْنُ عَاصِمٍ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، عَنْ عَاصِمِ بْنِ بَهْدَلَةَ، عَنْ مُغِيثٍ، عَنْ كَعْبٍ، قَالَ: عَلَيْكُمْ بِالْقُرْآنِ، فَإِنَّهُ فَهْمُ الْعَقْلِ، وَنُورُ الْحِكْمَةِ، وَيَنَابِيعُ الْعِلْمِ، وَأَحْدَثُ الْكُتُبِ بِالرَّحْمَنِ عَهْدًا، وَقَالَ فِي التَّوْرَاةِ: يَا مُحَمَّدُ، إِنِّي مُنَزِّلٌ عَلَيْكَ تَوْرَاةً حَدِيثَةً، تَفْتَحُ فِيهَا أَعْيُنًا عُمْيًا، وَآذَانًا صُمًّا، وَقُلُوبًا غُلْفًا"".""","Hasan","Sunan al-Darimi 3359","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3360","(حديث موقوف) حَدَّثَنَا سَهْلُ بْنُ حَمَّادٍ، حَدَّثَنَا شُعْبَةُ، حَدَّثَنَا زِيَادُ بْنُ مِخْرَاقٍ، عَنْ أَبِي إِيَاسٍ، عَنْ أَبِي كِنَانَةَ، عَنْ أَبِي مُوسَى، أَنَّهُ قَالَ: إِنَّ هَذَا الْقُرْآنَ كَائِنٌ لَكُمْ أَجْرًا، وَكَائِنٌ لَكُمْ ذِكْرًا، وَكَائِنٌ بِكُمْ نُورًا، وَكَائِنٌ عَلَيْكُمْ وِزْرًا، اتَّبِعُوا الْقُرْآنَ، وَلَا يَتَّبِعْكُمْ الْقُرْآنُ، فَإِنَّهُ مَنْ يَتَّبِعْ الْقُرْآنَ، يَهْبِطْ بِهِ فِي رِيَاضِ الْجَنَّةِ، وَمَنْ اتَّبَعَهُ الْقُرْآنُ يَزُخُّ فِي قَفَاهُ، فَيَقْذِفُهُ فِي جَهَنَّمَ"". قَالَ أَبُو مُحَمَّد: يَزُخُّ: يَدْفَعُ.""","","Sunan al-Darimi 3360","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3361","(حديث موقوف) حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يَزِيدَ، حَدَّثَنَا مُوسَى بْنُ أَيُّوبَ، قَالَ سَمِعْتُ عَمِّي إِيَاسَ بْنَ عَامِرٍ، يَقُولُ: أَخَذَ عَلِيُّ بْنُ أَبِي طَالِبٍ بِيَدِي، ثُمَّ قَالَ: إِنَّكَ إِنْ بَقِيتَ، سَيَقْرَأُ الْقُرْآنَ ثَلَاثَةُ أَصْنَافٍ: فَصِنْفٌ لِلَّهِ، وَصِنْفٌ لِلْجِدَالِ، وَصِنْفٌ لِلدُّنْيَا، وَمَنْ طَلَبَ بِهِ أَدْرَكَ"".""","Sahih","Sunan al-Darimi 3361","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3362","(حديث موقوف) حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، عَنْ حَمَّادِ بْنِ زَيْدٍ، عَنْ أَيُّوبَ، عَنْ أَبِي قِلَابَةَ: أَنَّ رَجُلًا قَالَ لِأَبِي الدَّرْدَاءِ:إِنَّ إِخْوَانَكَ مِنْ أَهْلِ الْكُوفَةِ، مِنْ أَهْلِ الذِّكْرِ، يُقْرِئُونَكَ السَّلَامَ. فَقَالَ: وَعَلَيْهِمْ السَّلَامُ، وَمُرْهُمْ فَلْيُعْطُوا الْقُرْآنَ بِخَزَائِمِهِمْ، فَإِنَّهُ يَحْمِلُهُمْ عَلَى الْقَصْدِ وَالسُّهُولَةِ، وَيُجَنِّبُهُمْ الْجَوْرَ وَالْحُزُونَةَ"".""","Da'if","Sunan al-Darimi 3362","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3363","(حديث مرفوع) أَخْبَرَنَا مُحَمَّدُ بْنُ يَزِيدَ الرِّفَاعِيُّ، حَدَّثَنَا الْحُسَيْنُ الْجُعْفِيُّ، عَنْ حَمْزَةَ الزَّيَّاتِ، عَنْ أَبِي الْمُخْتَارِ الطَّائِيِّ، عَنْ ابْنِ أَخِي الْحَارِثِ، عَنْ الْحَارِثِ، قَالَ: دَخَلْتُ الْمَسْجِدَ، فَإِذَا أُنَاسٌ يَخُوضُونَ فِي أَحَادِيثَ، فَدَخَلْتُ عَلَى عَلِيٍّ، فَقُلْتُ: أَلَا تَرَى أَنَّ أُنَاسًا يَخُوضُونَ فِي الْأَحَادِيثِ فِي الْمَسْجِدِ؟ فَقَالَ: قَدْ فَعَلُوهَا؟ قُلْتُ: نَعَمْ، قَالَ: أَمَا إِنِّي سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: سَتَكُونُ فِتَنٌ""، قُلْتُ: وَمَا الْمَخْرَجُ مِنْهَا؟ قَالَ: كِتَابُ اللَّهِ، كِتَابُ اللَّهِ فِيهِ نَبَأُ مَا قَبْلَكُمْ، وَخَبَرُ مَا بَعْدَكُمْ، وَحُكْمُ مَا بَيْنَكُمْ، هُوَ الْفَصْلُ لَيْسَ بِالْهَزْلِ، هُوَ الَّذِي مَنْ تَرَكَهُ مِنْ جَبَّارٍ، قَصَمَهُ اللَّهُ، وَمَنْ ابْتَغَى الْهُدَى فِي غَيْرِهِ، أَضَلَّهُ اللَّهُ، فَهُوَ حَبْلُ اللَّهِ الْمَتِينُ، وَهُوَ الذِّكْرُ الْحَكِيمُ، وَهُوَ الصِّرَاطُ الْمُسْتَقِيمُ، وَهُوَ الَّذِي لَا تَزِيغُ بِهِ الْأَهْوَاءُ، وَلَا تَلْتَبِسُ بِهِ الْأَلْسِنَةُ، وَلَا يَشْبَعُ مِنْهُ الْعُلَمَاءُ، وَلَا يَخْلَقُ عَنْ كَثْرَةِ الرَّدِّ، وَلَا تَنْقَضِي عَجَائِبُهُ، وَهُوَ الَّذِي لَمْ يَنْتَهِ الْجِنُّ إِذْ سَمِعَتْهُ أَنْ قَالُوا: إِنَّا سَمِعْنَا قُرْءَانًا عَجَبًا سورة الجن آية 1، هُوَ الَّذِي مَنْ قَالَ بِهِ صَدَقَ، وَمَنْ حَكَمَ بِهِ عَدَلَ، وَمَنْ عَمِلَ بِهِ أُجِرَ، وَمَنْ دَعَا إِلَيْهِ هُدِيَ إِلَى صِرَاطٍ مُسْتَقِيمٍ"" خُذْهَا إِلَيْكَ يَا أَعْوَرُ.""","","Sunan al-Darimi 3363","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3364","(حديث مرفوع) حَدَّثَنَا مُحَمَّدُ بْنُ الْعَلَاءِ، حَدَّثَنَا زَكَرِيَّا بْنُ عَدِيٍّ، حَدَّثَنَا مُحَمَّدُ بْنُ سَلَمَةَ، عَنْ ابْنِ سِنَانٍ، عَنْ عَمْرِو بْنِ مُرَّةَ، عَنْ أَبِي الْبَخْتَرِيِّ، عَنِ الْحَارِثِ، عَنْ عَلِيٍّ، قَالَ: قِيلَ: يَا رَسُولَ اللَّهِ، إِنَّ أُمَّتَكَ سَتُفْتَتَنُ مِنْ بَعْدِكَ، قَالَ: فَسَأَلَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَوْ سُئِلَ: مَا الْمَخْرَجُ مِنْهَا؟ قَالَ: الْكِتَابُ الْعَزِيزُ الَّذِي لا يَأْتِيهِ الْبَاطِلُ مِنْ بَيْنِ يَدَيْهِ وَلا مِنْ خَلْفِهِ تَنْزِيلٌ مِنْ حَكِيمٍ حَمِيدٍ سورة فصلت آية 42 مَنِ ابْتَغَى الْهُدَى فِي غَيْرِهِ، فَقَدْ أَضَلَّهُ اللَّهُ، وَمَنْ وَلِيَ هَذَا الْأَمْرَ مِنْ جَبَّارٍ فَحَكَمَ بِغَيْرِهِ، قَصَمَهُ اللَّهُ، هُوَ الذِّكْرُ الْحَكِيمُ، وَالنُّورُ الْمُبِينُ، وَالصِّرَاطُ الْمُسْتَقِيمُ، فِيهِ خَبَرُ مَنْ قَبْلَكُمْ، وَنَبَأُ مَا بَعْدَكُمْ، وَحُكْمُ مَا بَيْنَكُمْ، وَهُوَ الْفَصْلُ لَيْسَ بِالْهَزْلِ، وَهُوَ الَّذِي سَمِعَتْهُ الْجِنُّ فَلَمْ تَتَنَاهَ أَنْ قَالُوا: إِنَّا سَمِعْنَا قُرْءَانًا عَجَبًا سورة الجن آية 1، وَلَا يَخْلَقُ عَنْ كَثْرَةِ الرَّدِّ، وَلَا تَنْقَضِي عِبَرُهُ، وَلَا تَفْنَى عَجَائِبُهُ""، ثُمَّ قَالَ عَلِيٌّ لِلْحَارِثِ: خُذْهَا إِلَيْكَ يَا أَعْوَرُ.""","Hasan","Sunan al-Darimi 3364","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3365","(حديث مقطوع) أَخْبَرَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا سُفْيَانُ، عَنْ أَبِي حمزة، عَنْ إِبْرَاهِيمَ: وَمَنْ يُؤْتَ الْحِكْمَةَ فَقَدْ أُوتِيَ خَيْرًا كَثِيرًا سورة البقرة آية 269، قَالَ: الْفَهْمَ بِالْقُرْآنِ"".""","Da'if","Sunan al-Darimi 3365","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3366","(حديث مقطوع) أَخْبَرَنَا مُحَمَّدُ بْنُ يُوسُفَ، عَنْ وَرْقَاءَ، عَنْ ابْنِ أَبِي نَجِيحٍ، عَنْ مُجَاهِدٍ: يُؤْتِي الْحِكْمَةَ مَنْ يَشَاءُ سورة البقرة آية 269، قَالَ: الْكِتَابَ يُؤْتِي إِصَابَتَهُ مَنْ يَشَاءُ"".""","Sahih","Sunan al-Darimi 3366","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3367","(حديث مقطوع) أَخْبَرَنَا مُحَمَّدُ بْنُ يَزِيدَ، حَدَّثَنَا أَبُو بَكْرٍ، عَنْ الْأَعْمَشِ، عَنْ خَيْثَمَةَ، قَالَ: قَالَ لِامْرَأَتِهِ: إِيَّاكِ أَنْ تُدْخِلِي بَيْتِي مَنْ يَشْرَبُ الْخَمْرَ، بَعْدَ أَنْ كَانَ يُقْرَأُ فِيهِ الْقُرْآنُ كُلَّ ثَلَاثٍ"".""","Hasan","Sunan al-Darimi 3367","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3368","(حديث موقوف) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا فِطْرٌ، عَنْ الْحَكَمِ، عَنْ مِقْسَمٍ، عَنْ ابْنِ عَبَّاسٍ، قَالَ: مَا يَمْنَعُ أَحَدَكُمْ إِذَا رَجَعَ مِنْ سُوقِهِ، أَوْ مِنْ حَاجَتِهِ، فَاتَّكَأَ عَلَى فِرَاشِهِ، أَنْ يَقْرَأَ ثَلَاثَ آيَاتٍ مِنْ الْقُرْآنِ؟!"".""","Sahih","Sunan al-Darimi 3368","","","1. جو قرآن پڑھے اس کی فضیلت کا بیان"
"3369","(حديث مرفوع) أَخْبَرَنَا مُسْلِمُ بْنُ إِبْرَاهِيمَ، حَدَّثَنَا عَبْدُ الْوَاحِدِ، حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ إِسْحَاق، حَدَّثَنَا النُّعْمَانُ بْنُ سَعْدٍ، عَنْ عَلِيٍّ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: خَيْرُكُمْ مَنْ تَعَلَّمَ الْقُرْآنَ وَعَلَّمَهُ"".""","Da'if","Sunan al-Darimi 3369","","","2. تم میں سے سب سے بہتر وہ ہے جو قرآن پڑھے اور پڑھائے"
"3370","(حديث مرفوع) حَدَّثَنَا الْحَجَّاجُ بْنُ مِنْهَالٍ، حَدَّثَنَا شُعْبَةُ، أَخْبَرَنِي عَلْقَمَةُ بْنُ مَرْثَدٍ، قَالَ: سَمِعْتُ سَعْدَ بْنَ عُبَيْدَةَ، عَنْ أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ، عَنْ عُثْمَانَ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: إِنَّ خَيْرَكُمْ مَنْ عَلَّمَ الْقُرْآنَ، أَوْ تَعَلَّمَهُ"". قَالَ: أَقْرَأَ أَبُو عَبْدِ الرَّحْمَنِ فِي إِمْرَةِ عُثْمَانَ حَتَّى كَانَ الْحَجَّاجُ، قَالَ: ذَاكَ أَقْعَدَنِي مَقْعَدِي هَذَا.""","Sahih","Sunan al-Darimi 3370","","","2. تم میں سے سب سے بہتر وہ ہے جو قرآن پڑھے اور پڑھائے"
"3371","(حديث مرفوع) حَدَّثَنَا الْمُعَلَّى بْنُ أَسَدٍ، حَدَّثَنَا الْحَارِثُ بْنُ نَبْهَانَ، حَدَّثَنَا عَاصِمُ بْنُ بَهْدَلَةَ، عَنْ مُصْعَبِ بْنِ سَعْدٍ، عَنْ أَبِيهِ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: خِيَارُكُمْ مَنْ تَعَلَّمَ الْقُرْآنَ، وَعَلَّمَ الْقُرْآنَ""، قَالَ: فَأَخَذَ بِيَدِي، فَأَقْعَدَنِي هَذَا الْمَقْعَدَ أُقْرِئُ.""","Sahih","Sunan al-Darimi 3371","","","2. تم میں سے سب سے بہتر وہ ہے جو قرآن پڑھے اور پڑھائے"
"3372","(حديث مرفوع) حَدَّثَنَا سَعِيدُ بْنُ عَامِرٍ، عَنْ شُعْبَةَ، عَنْ يَزِيدَ بْنِ أَبِي زِيَادٍ، عَنْ عِيسَى، عَنْ رَجُلٍ، عَنْ سَعْدِ بْنِ عُبَادَةَ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: مَا مِنْ رَجُلٍ يَتَعَلَّمُ الْقُرْآنَ ثُمَّ يَنْسَاهُ، إِلَّا لَقِيَ اللَّهَ يَوْمَ الْقِيَامَةِ وَهُوَ أَجْذَمُ""، قَالَ أَبُو مُحَمَّد: عِيسَى وهُوَ ابْنُ فَائِدٍ.""","","Sunan al-Darimi 3372","","","3. جو کوئی قرآن پڑھے پھر بھول جائے"
"3373","(حديث موقوف) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ، حَدَّثَنَا مُوسَى بْنُ عُبَيْدَةَ، عَنْ صَفْوَانَ بْنِ سُلَيْمٍ، عَنْ نَاجِيَةَ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ، عَنْ أَبِيهِ، عَنْ عَبْدِ اللَّهِ، قَالَ: أَكْثِرُوا تِلَاوَةَ الْقُرْآنِ قَبْلَ أَنْ يُرْفَعَ، قَالُوا: هَذِهِ الْمَصَاحِفُ تُرْفَعُ، فَكَيْفَ بِمَا فِي صُدُورِ الرِّجَالِ؟ قَالَ: يُسْرَى عَلَيْهِ لَيْلًا فَيُصْبِحُونَ مِنْهُ فُقَرَاءَ، وَيَنْسَوْنَ قَوْلَ: لَا إِلَهَ إِلَّا اللَّهُ، وَيَقَعُونَ فِي قَوْلِ الْجَاهِلِيَّةِ وَأَشْعَارِهِمْ، وَذَلِكَ حِينَ يَقَعُ عَلَيْهِمْ الْقَوْلُ"".""","Da'if","Sunan al-Darimi 3373","","","4. قرآن پاک کی نسیان سے حفاظت کرنے کا بیان"
"3374","(حديث مقطوع) حَدَّثَنَا الْمُعَلَّى بْنُ أَسَدٍ، حَدَّثَنَا سَلَّامٌ يَعْنِي ابْنَ أَبِي مُطِيعٍ، قَالَ: كَانَ قَتَادَةُ، يَقُولُ: اعْمُرُوا بِهِ قُلُوبَكُمْ، وَاعْمُرُوا بِهِ بُيُوتَكُمْ""، قَالَ: أُرَاهُ يَعْنِي: الْقُرْآنَ.""","","Sunan al-Darimi 3374","","","4. قرآن پاک کی نسیان سے حفاظت کرنے کا بیان"
"3375","(حديث موقوف) حَدَّثَنَا عَمْرُو بْنُ عَاصِمٍ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، عَنْ عَاصِمٍ، عَنْ زِرٍّ، عَنْ ابْنِ مَسْعُودٍ، قَالَ: لَيُسْرَيَنَّ عَلَى الْقُرْآنِ ذَاتَ لَيْلَةٍ، فَلَا يُتْرَكُ آيَةٌ فِي مُصْحَفٍ، وَلَا فِي قَلْبِ أَحَدٍ، إِلَّا رُفِعَتْ"".""","Hasan","Sunan al-Darimi 3375","","","4. قرآن پاک کی نسیان سے حفاظت کرنے کا بیان"
"3376","(حديث مقطوع) حَدَّثَنَا مُحَمَّدُ بْنُ كَثِيرٍ، عَنْ عَبْدِ اللَّهِ بْنِ وَاقِدٍ، عَنْ قَتَادَةَ، قَالَ: مَا جَالَسَ الْقُرْآنَ أَحَدٌ فَقَامَ عَنْهُ، إِلَّا بِزِيَادَةٍ أَوْ نُقْصَانٍ، ثُمَّ قَرَأَ: وَنُنَزِّلُ مِنَ الْقُرْءَانِ مَا هُوَ شِفَاءٌ وَرَحْمَةٌ لِلْمُؤْمِنِينَ وَلا يَزِيدُ الظَّالِمِينَ إِلا خَسَارًا سورة الإسراء آية 82.""","Da'if","Sunan al-Darimi 3376","","","4. قرآن پاک کی نسیان سے حفاظت کرنے کا بیان"
"3377","(حديث مقطوع) حَدَّثَنَا مَرْوَانُ بْنُ مُحَمَّدٍ، حَدَّثَنَا رِفْدَةُ الْغَسَّانِيُّ، حَدَّثَنَا ثَابِتُ بْنُ عَجْلَانَ الْأَنْصَارِيُّ، قَالَ: كَانَ يُقَالُ: إِنَّ اللَّهَ لَيُرِيدُ الْعَذَابَ بِأَهْلِ الْأَرْضِ، فَإِذَا سَمِعَ تَعْلِيمَ الصِّبْيَانِ الْحِكْمَةَ، صَرَفَ ذَلِكَ عَنْهُمْ"". قَالَ مَرْوَانُ: يَعْنِي بِالْحِكْمَةِ: الْقُرْآنَ.""","Da'if","Sunan al-Darimi 3377","","","4. قرآن پاک کی نسیان سے حفاظت کرنے کا بیان"
"3378","(حديث موقوف) أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُبَارَكِ، حَدَّثَنَا صَدَقَةُ بْنُ خَالِدٍ، عَنْ ابْنِ جَابِرٍ، حَدَّثَنَا شَيْخٌ يُكَنَّى أَبَا عَمْرٍو، عَنْ مُعَاذِ بْنِ جَبَلٍ، قَالَ: سَيَبْلَى الْقُرْآنُ فِي صُدُورِ أَقْوَامٍ كَمَا يَبْلَى الثَّوْبُ، فَيَتَهَافَتُ، يَقْرَءُونَهُ لَا يَجِدُونَ لَهُ شَهْوَةً وَلَا لَذَّةً، يَلْبَسُونَ جُلُودَ الضَّأْنِ عَلَى قُلُوبِ الذِّئَابِ، أَعْمَالُهُمْ طَمَعٌ لَا يُخَالِطُهُ خَوْفٌ، إِنْ قَصَّرُوا، قَالُوا: سَنَبْلُغُ، وَإِنْ أَسَاءُوا، قَالُوا: سَيُغْفَرُ لَنَا، إِنَّا لَا نُشْرِكُ بِاللَّهِ شَيْئًا"".""","Sahih","Sunan al-Darimi 3378","","","4. قرآن پاک کی نسیان سے حفاظت کرنے کا بیان"
"3379","(حديث مرفوع) حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ عَبْدِ الْمَجِيدِ، عَنْ شُعْبَةَ، عَنْ مَنْصُورٍ قَالَ: سَمِعْتُ أَبَا وَائِلٍ، عَنْ عَبْدِ اللَّهِ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: قَالَ بِئْسَمَا لِأَحَدِكُمْ أَنْ يَقُولَ: نَسِيتُ آيَةَ كَيْتَ وَكَيْتَ، بَلْ هُوَ نُسِّيَ، وَاسْتَذْكِرُوا الْقُرْآنَ، فَإِنَّهُ أَسْرَعُ تَفَصِّيًا مِنْ صُدُورِ الرِّجَالِ مِنْ النَّعَمِ مِنْ عُقُلِهَا"".""","Sahih","Sunan al-Darimi 3379","","","4. قرآن پاک کی نسیان سے حفاظت کرنے کا بیان"
"3380","(حديث مرفوع) حَدَّثَنَا وَهْبُ بْنُ جَرِيرٍ، حَدَّثَنَا مُوسَى يَعْنِي ابْنَ عُلَيٍّ، قَالَ: سَمِعْتُ أَبِي، قَالَ: سَمِعْتُ عُقْبَةَ بْنَ عَامِرٍ، يَقُول: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: تَعَلَّمُوا كِتَابَ اللَّهِ وَتَعَاهَدُوهُ، وَتَغَنَّوْا بِهِ وَاقْتَنُوهُ، فَوَالَّذِي نَفْسِي بِيَدِهِ أَوْ: فَوَالَّذِي نَفْسُ مُحَمَّدٍ بِيَدِهِ لَهُوَ أَشَدُّ تَفَلُّتًا مِن الْمَخَاضِ فِي الْعُقُلِ"".""","Sahih","Sunan al-Darimi 3380","","","4. قرآن پاک کی نسیان سے حفاظت کرنے کا بیان"
"3381","(حديث مرفوع) حَدَّثَنَا عَبْدُ اللَّهِ بْنُ صَالِحٍ، قَالَ حَدَّثَنِي مُوسَى عَنْ أَبِيهِ، عَنْ عُقْبَةَ بْنِ عَامِرٍ: أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: تَعَلَّمُوا كِتَابَ اللَّهِ تَعَالَى وَتَعَاهَدُوهُ، وَاقْتَنُوهُ وَتَغَنَّوْا بِهِ، فَوَالَّذِي نَفْسِي بِيَدِهِ، لَهُوَ أَشَدُّ تَفَلُّتًا مِنْ الْمَخَاضِ فِي الْعُقُلِ"".""","Da'if","Sunan al-Darimi 3381","","","4. قرآن پاک کی نسیان سے حفاظت کرنے کا بیان"
"3382","(حديث موقوف) أَخْبَرَنَا أَخْبَرَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ، عَنْ أَيُّوبَ، عَنْ ابْنِ أَبِي مُلَيْكَةَ:أَنَّ عِكْرِمَةَ بْنَ أَبِي جَهْلٍ كَانَ يَضَعُ الْمُصْحَفَ عَلَى وَجْهِهِ، وَيَقُولُ: كِتَابُ رَبِّي، كِتَابُ رَبِّي"".""","","Sunan al-Darimi 3382","","","4. قرآن پاک کی نسیان سے حفاظت کرنے کا بیان"
"3383","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا مُسْلِمُ بْنُ إِبْرَاهِيمَ، حَدَّثَنَا هَمَّامٌ، حَدَّثَنَا ثَابِتٌ، قَالَ:كَانَ عَبْدُ الرَّحْمَنِ بْنُ أَبِي لَيْلَى إِذَا صَلَّى الصُّبْحَ، قَرَأَ الْمُصْحَفَ حَتَّى تَطْلُعَ الشَّمْسُ""، قَالَ: وَكَانَ ثَابِتٌ يَفْعَلُهُ.""","Sahih","Sunan al-Darimi 3383","","","4. قرآن پاک کی نسیان سے حفاظت کرنے کا بیان"
"3384","(حديث مقطوع) أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ الرَّقَاشِيُّ، عَنْ يَزِيدَ بْنِ زُرَيْعٍ، عَنْ سَعِيدٍ، عَنْ قَتَادَةَ، قَالَ: إِنَّ اللَّهَ لا يَسْتَحْيِي أَنْ يَضْرِبَ مَثَلا مَا بَعُوضَةً فَمَا فَوْقَهَا فَأَمَّا الَّذِينَ آمَنُوا فَيَعْلَمُونَ أَنَّهُ الْحَقُّ مِنْ رَبِّهِمْ وَأَمَّا الَّذِينَ كَفَرُوا فَيَقُولُونَ مَاذَا أَرَادَ اللَّهُ بِهَذَا مَثَلا يُضِلُّ بِهِ كَثِيرًا وَيَهْدِي بِهِ كَثِيرًا وَمَا يُضِلُّ بِهِ إِلا الْفَاسِقِينَ سورة البقرة آية 26، قَالَ: أَيْ يَعْلَمُونَ أَنَّهُ كَلَامُ الرَّحْمَنِ"".""","","Sunan al-Darimi 3384","","","5. قرآن پاک اللہ کا کلام ہے"
"3385","(حديث مرفوع) حَدَّثَنَا عَبْدُ اللَّهِ بْنُ صَالِحٍ، عَنْ مُعَاوِيَةَ بْنِ صَالِحٍ، عَنْ أَبِي بَكْرِ بْنِ أَبِي مَرْيَمَ، عَنْ عَطِيَّةَ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: مَا مِنْ كَلَامٍ أَعْظَمُ عِنْدَ اللَّهِ مِنْ كَلَامِهِ، وَمَا رَدَّ الْعِبَادُ إِلَى اللَّهِ كَلَامًا أَحَبَّ إِلَيْهِ مِنْ كَلَامِهِ"".""","Da'if","Sunan al-Darimi 3385","","","5. قرآن پاک اللہ کا کلام ہے"
"3386","(حديث مرفوع) حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ، عَنْ إِسْرَائِيلَ، حَدَّثَنَا عُثْمَانُ بْنُ الْمُغِيرَةِ الثَّقَفِيُّ، عَنْ سَالِمِ بْنِ أَبِي الْجَعْدِ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ، قَالَ: كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَعْرِضُ نَفْسَهُ فِي الْمَوْسِمِ عَلَى النَّاسِ فِي الْمَوْقِفِ، فَيَقُولُ: هَلْ مِنْ رَجُلٍ يَحْمِلُنِي إِلَى قَوْمِهِ؟ فَإِنَّ قُرَيْشًا مَنَعُونِي أَنْ أُبَلِّغَ كَلَامَ رَبِّي؟"".""","Sahih","Sunan al-Darimi 3386","","","5. قرآن پاک اللہ کا کلام ہے"
"3387","(حديث موقوف) حَدَّثَنَا إِسْحَاق، حَدَّثَنَا جَرِيرٌ، عَنْ لَيْثٍ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ، عَنْ أَبِي الزَّعْرَاءِ، قَالَ: قَالَ عُمَرُ بْنُ الْخَطَّابِ: إِنَّ هَذَا الْقُرْآنَ كَلَامُ اللَّهِ، فَلَا أَعْرِفَنَّكُمْ فِيمَا عَطَفْتُمُوهُ عَلَى أَهْوَائِكُمْ"".""","Da'if","Sunan al-Darimi 3387","","","5. قرآن پاک اللہ کا کلام ہے"
"3388","(حديث قدسي) أَخْبَرَنَا إِسْمَاعِيل بْنُ إِبْرَاهِيمَ التَّرْجُمَانِيُّ، حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ الْهَمْدَانِيُّ، عَنْ عَمْرِو بْنِ قَيْسٍ، عَنْ عَطِيَّةَ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: مَنْ شَغَلَهُ قِرَاءَةُ الْقُرْآنِ عَنْ مَسْأَلَتِي وَذِكْرِي، أَعْطَيْتُهُ أَفْضَلَ ثَوَابِ السَّائِلِينَ، وَفَضْلُ كَلَامِ اللَّهِ عَلَى سَائِرِ الْكَلَامِ، كَفَضْلِ اللَّهِ عَلَى خَلْقِهِ"".""","Hasan","Sunan al-Darimi 3388","","","6. دیگر کلاموں پر اللہ کے کلام کی فضیلت کا بیان"
"3389","(حديث مرفوع) حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، عَنْ أَشْعَثَ الْحُدَّانِيِّ، عَنْ شَهْرِ بْنِ حَوْشَبٍ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: فَضْلُ كَلَامِ اللَّهِ عَلَى كَلَامِ خَلْقِهِ، كَفَضْلِ اللَّهِ عَلَى خَلْقِهِ"".""","Hasan","Sunan al-Darimi 3389","","","6. دیگر کلاموں پر اللہ کے کلام کی فضیلت کا بیان"
"3390","(حديث مرفوع) حَدَّثَنَا عَبْدُ اللَّهِ بْنُ صَالِحٍ، حَدَّثَنَا يَحْيَى بْنُ أَيُّوبَ، عَنْ عُبَيْدِ اللَّهِ بْنِ أَبِي جَعْفَرٍ، عَنْ رَجُلٍ مِنْ شُيُوخِ مِصْرَ، أَنَّهُ حَدَّثَهُ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، أَنَّهُ قَالَ: الْقُرْآنُ أَحَبُّ إِلَى اللَّهِ مِنْ السَّمَوَاتِ وَالْأَرْضِ وَمَنْ فِيهِنَّ"".""","Da'if","Sunan al-Darimi 3390","","","6. دیگر کلاموں پر اللہ کے کلام کی فضیلت کا بیان"
"3391","(حديث مرفوع) أَخْبَرَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا هَارُونُ الْأَعْوَرُ، عَنْ أَبِي عِمْرَانَ الْجَوْنِيِّ، عَنْ جُنْدُبٍ: أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: اقْرَءُوا الْقُرْآنَ مَا ائْتَلَفْتُمْ عَلَيْهِ، فَإِذَا اخْتَلَفْتُمْ فِيهِ، فَقُومُوا"".""","Sahih","Sunan al-Darimi 3391","","","7. جب قرآن پاک پڑھنے سے دل اُچٹ جائے تو مجلس برخاست کر دو"
"3392","(حديث موقوف) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، حَدَّثَنَا هَمَّامٌ، حَدَّثَنَا أَبُو عِمْرَانَ الْجَوْنِيُّ، عَنْ جُنْدُبِ بْنِ عَبْدِ اللَّهِ، قَالَ: اقْرَءُوا الْقُرْآنَ مَا ائْتَلَفَتْ عَلَيْهِ قُلُوبُكُمْ، فَإِذَا اخْتَلَفْتُمْ فِيهِ، فَقُومُوا"".""","Sahih","Sunan al-Darimi 3392","","","7. جب قرآن پاک پڑھنے سے دل اُچٹ جائے تو مجلس برخاست کر دو"
"3393","(حديث مرفوع) حَدَّثَنَا أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيل، حَدَّثَنَا أَبُو قُدَامَةَ، حَدَّثَنَا أَبُو عِمْرَانَ الْجَوْنِيُّ، عَنْ جُنْدُبٍ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: اقْرَءُوا الْقُرْآنَ مَا ائْتَلَفَتْ عَلَيْهِ قُلُوبُكُمْ، فَإِذَا اخْتَلَفْتُمْ، فِيهِ فَقُومُوا"".""","Sahih","Sunan al-Darimi 3393","","","7. جب قرآن پاک پڑھنے سے دل اُچٹ جائے تو مجلس برخاست کر دو"
"3394","(حديث موقوف) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا فِطْرٌ، عَنْ أَبِي إِسْحَاق، عَنْ الْحَارِثِ، عَنْ عَلِيٍّ رَضِيَ اللَّهُ عَنْهُ، قَالَ: مِنَ النَّاسِ مَنْ يُؤْتَى الْإِيمَانَ وَلَا يُؤْتَى الْقُرْآنَ، وَمِنْهُمْ مَنْ يُؤْتَى الْقُرْآنَ وَلَا يُؤْتَى الْإِيمَانَ، وَمِنْهُمْ مَنْ يُؤْتَى الْقُرْآنَ وَالْإِيمَانَ، وَمِنْهُمْ مَنْ لَا يُؤْتَى الْقُرْآنَ وَلَا الْإِيمَانَ، ثُمَّ ضَرَبَ لَهُمْ مَثَلًا، قَالَ: فَأَمَّا مَنْ أُوتِيَ الْإِيمَانَ وَلَمْ يُؤْتَ الْقُرْآنَ، فَمَثَلُهُ مَثَلُ التَّمْرَةِ حُلْوَةُ الطَّعْمِ، لَا رِيحَ لَهَا، وَأَمَّا مَثَلُ الَّذِي أُوتِيَ الْقُرْآنَ، وَلَمْ يُؤْتَ الْإِيمَانَ، فَمَثَلُ الْآسَةِ طَيِّبَةُ الرِّيحِ، مُرَّةُ الطَّعْمِ، وَأَمَّا الَّذِي أُوتِيَ الْقُرْآنَ وَالْإِيمَانَ، فَمَثَلُ الْأُتْرُجَّةِ، طَيِّبَةُ الرِّيحِ، حُلْوَةُ الطَّعْمِ، وَأَمَّا الَّذِي لَمْ يُؤْتَ الْقُرْآنَ وَلَا الْإِيمَانَ، فَمَثَلُهُ مَثَلُ الْحَنْظَلَةِ، مُرَّةُ الطَّعْمِ، لَا رِيحَ لَهَا"".""","Da'if","Sunan al-Darimi 3394","","","8. اس مؤمن کی مثال جو قرآن پڑھتا ہے"
"3395","(حديث مرفوع) حَدَّثَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا أَبُو عَوَانَةَ، عَنْ قَتَادَةَ، عَنْ أَنَسِ بْنِ مَالِكٍ، عَنْ أَبِي مُوسَى الْأَشْعَرِيِّ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: مَثَلُ الْمُؤْمِنِ الَّذِي يَقْرَأُ الْقُرْآنَ، مَثَلُ الْأُتْرُجَّةِ، طَعْمُهَا طَيِّبٌ، وَرِيحُهَا طَيِّبٌ، وَمَثَلُ الْمُؤْمِنِ الَّذِي لَا يَقْرَأُ الْقُرْآنَ، مَثَلُ التَّمْرَةِ، طَعْمُهَا حُلْوٌ، وَلَيْسَ لَهَا رِيحٌ، وَمَثَلُ الْمُنَافِقِ الَّذِي يَقْرَأُ الْقُرْآنَ، مَثَلُ الرَّيْحَانَةِ، رِيحُهَا طَيِّبٌ، وَطَعْمُهَا مُرٌّ، وَمَثَلُ الْمُنَافِقِ الَّذِي لَا يَقْرَأُ الْقُرْآنَ، مَثَلُ الْحَنْظَلَةِ، لَيْسَ لَهَا رِيحٌ، وَطَعْمُهَا مُرٌّ"".""","Sahih","Sunan al-Darimi 3395","","","8. اس مؤمن کی مثال جو قرآن پڑھتا ہے"
"3396","(حديث موقوف) أَخْبَرَنَا عُبَيْدُ اللَّهِ، عَنْ إِسْرَائِيلَ، عَنْ أَبِي إِسْحَاق، عَنْ الْحَارِثِ، عَنْ عَلِيٍّ، قَالَ: مَثَلُ الَّذِي أُوتِيَ الْإِيمَانَ وَلَمْ يُؤْتَ الْقُرْآنَ مَثَلُ التَّمْرَةِ، طَعْمُهَا طَيِّبٌ، وَلَا رِيحَ لَهَا، وَمَثَلُ الَّذِي أُوتِيَ الْقُرْآنَ وَلَمْ يُؤْتَ الْإِيمَانَ مَثَلُ الرَّيْحَانَةِ الْآسَةِ، رِيحُهَا طَيِّبٌ، وَطَعْمُهَا مُرٌّ، وَمَثَلُ الَّذِي أُوتِيَ الْقُرْآنَ وَالْإِيمَانَ مَثَلُ الْأُتْرُجَّةِ، رِيحُهَا طَيِّبٌ، وَطَعْمُهَا طَيِّبٌ، وَمَثَلُ الَّذِي لَمْ يُؤْتَ الْإِيمَانَ وَلَا الْقُرْآنَ مَثَلُ الْحَنْظَلَةِ، رِيحُهَا خَبِيثٌ، وَطَعْمُهَا خَبِيثٌ"".""","Sahih","Sunan al-Darimi 3396","","","8. اس مؤمن کی مثال جو قرآن پڑھتا ہے"
"3397","(حديث مرفوع) أَخْبَرَنَا الْحَكَمُ بْنُ نَافِعٍ، عَنْ شُعَيْبِ بْنِ أَبِي حَمْزَةَ، عَنْ الزُّهْرِيِّ، حَدَّثَنِي عَامِرُ بْنُ وَاثِلَةَ: أَنَّ نَافِعَ بْنَ عَبْدِ الْحَارِثِ لَقِيَ عُمَرَ بْنَ الْخَطَّابِ بِعُسْفَانَ، وَكَانَ عُمَرُ اسْتَعْمَلَهُ عَلَى أَهْلِ مَكَّةَ، فَسَلَّمَ عَلَى عُمَرَ، فَقَالَ لَهُ عُمَرُ: مَنْ اسْتَخْلَفْتَ عَلَى أَهْلِ الْوَادِي؟ فَقَالَ نَافِعٌ: اسْتَخْلَفْتُ عَلَيْهِمْ ابْنَ أَبْزَى، فَقَالَ عُمَرُ: وَمَنْ ابْنُ أَبْزَى؟ فَقَالَ: مَوْلًى مِنْ مَوَالِينَا، فَقَالَ عُمَرُ: فَاسْتَخْلَفْتَ عَلَيْهِمْ مَوْلًى؟ فَقَالَ: يَا أَمِيرَ الْمُؤْمِنِينَ، إِنَّهُ قَارِئٌ لِكِتَابِ اللَّهِ، عَالِمٌ بِالْفَرَائِضِ، فَقَالَ عُمَرُ: أَمَا إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: إِنَّ اللَّهَ يَرْفَعُ بِهَذَا الْكِتَابِ أَقْوَامًا، وَيَضَعُ بِهِ آخَرِينَ"".""","Sahih","Sunan al-Darimi 3397","","","9. اللہ تعالیٰ اس قرآن کے ذریعہ بعض قوموں کو اٹھائے گا اور بعض کو گرا دے گا"
"3398","(حديث موقوف) حَدَّثَنَا أَبُو الْمُغِيرَةِ، حَدَّثَنَا عَبْدَةُ، عَنْ خَالِدِ بْنِ مَعْدَانَ، قَالَ: إِنَّ الَّذِي يَقْرَأُ الْقُرْآنَ لَهُ أَجْرٌ، وَإِنَّ الَّذِي يَسْتَمِعُ لَهُ أَجْرَانِ"".""","","Sunan al-Darimi 3398","","","10. جو قرآن سنے اس کی فضیلت کا بیان"
"3399","(حديث موقوف) حَدَّثَنَا رَزِينُ بْنُ عَبْدِ اللَّهِ بْنِ حُمَيْدٍ، عَنْ عَبْدِ الرَّزَّاقِ، عَنْ ابْنِ جُرَيْجٍ، عَنْ عَطَاءٍ، عَنْ ابْنِ عَبَّاسٍ، قَالَ: مَنْ اسْتَمَعَ إِلَى آيَةٍ مِنْ كِتَابِ اللَّهِ، كَانَتْ لَهُ نُورًا"".""","Da'if","Sunan al-Darimi 3399","","","10. جو قرآن سنے اس کی فضیلت کا بیان"
"3400","(حديث مرفوع) أَخْبَرَنَا مُسْلِمُ بْنُ إِبْرَاهِيمَ، حَدَّثَنَا هِشَامٌ، وَهَمَّامٌ، قَالَا: حَدَّثَنَا قَتَادَةُ، عَنْ زُرَارَةَ بْنِ أَوْفَى، عَنْ سَعْدِ بْنِ هِشَامٍ، عَنْ عَائِشَةَ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: الَّذِي يَقْرَأُ الْقُرْآنَ وَهُوَ مَاهِرٌ بِهِ، فَهُوَ مَعَ السَّفَرَةِ الْكِرَامِ الْبَرَرَةِ، وَالَّذِي يَقْرَؤُهُ وَهُوَ يَشْتَدُّ عَلَيْهِ، فَلَهُ أَجْرَانِ"".""","Sahih","Sunan al-Darimi 3400","","","11. اس کی فضیلت جو قرآن پڑھے اور وہ اس پر دشوار ہو"
"3401","(حديث مقطوع) حَدَّثَنَا مَرْوَانُ بْنُ مُحَمَّدٍ، حَدَّثَنَا سَعِيدٌ هُوَ ابْنُ عَبْدِ الْعَزِيزِ، عَنْ إِسْمَاعِيل بْنِ عُبَيْدِ اللَّهِ، عَنْ وَهْبٍ الذِّمَارِيِّ، قَالَ: مَنْ آتَاهُ اللَّهُ الْقُرْآنَ، فَقَامَ بِهِ آنَاءَ اللَّيْلِ، وَآنَاءَ النَّهَارِ، وَعَمِلَ بِمَا فِيهِ، وَمَاتَ عَلَى الطَّاعَةِ، بَعَثَهُ اللَّهُ يَوْمَ الْقِيَامَةِ مَعَ السَّفَرَةِ وَالْأَحْكَامِ. قَالَ سَعِيدٌ: السَّفَرَةُ: الْمَلَائِكَةُ، وَالْأَحْكَامُ: الْأَنْبِيَاءُ، قَالَ: وَمَنْ كَانَ حَرِيصًا وَهُوَ يَتَفَلَّتُ مِنْهُ، وَهُوَ لَا يَدَعُهُ، أُوتِيَ أَجْرَهُ مَرَّتَيْنِ، وَمَنْ كَانَ عَلَيْهِ حَرِيصًا وَهُوَ يَتَفَلَّتُ مِنْهُ وَمَاتَ عَلَى الطَّاعَةِ، فَهُوَ مِنْ أَشْرَافِهِمْ، وَفُضِّلُوا عَلَى النَّاسِ، كَمَا فُضِّلَتْ النُّسُورُ عَلَى سَائِرِ الطَّيْرِ، وَكَمَا فُضِّلَتْ مَرْجَةٌ خَضْرَاءُ عَلَى مَا حَوْلَهَا مِنْ الْبِقَاعِ، فَإِذَا كَانَ يَوْمُ الْقِيَامَةِ، قِيلَ: أَيْنَ الَّذِينَ كَانُوا يَتْلُونَ كِتَابِي لَمْ يُلْهِهِمْ اتِّبَاعُ الْأَنْعَامِ؟ فَيُعْطَى الْخُلْدَ وَالنَّعِيمَ، فَإِنْ كَانَ أَبَوَاهُ مَاتَا عَلَى الطَّاعَةِ، جُعِلَ عَلَى رُءُوسِهِمَا تَاجُ الْمُلْكِ، فَيَقُولَانِ: رَبَّنَا مَا بَلَغَتْ هَذَا أَعْمَالُنَا؟ فَيَقُولان: بَلَى، إِنَّ ابْنَكُمَا كَانَ يَتْلُو كِتَابِي"".""","","Sunan al-Darimi 3401","","","11. اس کی فضیلت جو قرآن پڑھے اور وہ اس پر دشوار ہو"
"3402","(حديث مرفوع) أَخْبَرَنَا قَبِيصَةُ، أَخْبَرَنَا سُفْيَانُ، عَنْ عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: فِي فَاتِحَةِ الْكِتَابِ، شِفَاءٌ مِنْ كُلِّ دَاءٍ"".""","Sahih","Sunan al-Darimi 3402","","","12. سورہ فاتحہ کی فضیلت کا بیان"
"3403","(حديث مرفوع) حَدَّثَنَا بِشْرُ بْنُ عُمَرَ الزَّهْرَانِيُّ، حَدَّثَنَا شُعْبَةُ، عَنْ خُبَيْبِ بْنِ عَبْدِ الرَّحْمَنِ، عَنْ حَفْصِ بْنِ عَاصِمٍ، عَنْ أَبِي سَعِيدِ بْنِ الْمُعَلَّى الْأَنْصَارِيِّ، قَالَ:مَرَّ بِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: ""أَلَمْ يَقُلْ اللَّهُ عَزَّ وَجَلَّ: يَأَيُّهَا الَّذِينَ آمَنُوا اسْتَجِيبُوا لِلَّهِ وَلِلرَّسُولِ إِذَا دَعَاكُمْ لِمَا يُحْيِيكُمْ وَاعْلَمُوا أَنَّ اللَّهَ يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ وَأَنَّهُ إِلَيْهِ تُحْشَرُونَ سورة الأنفال آية 24، قَالَ: أَلَا أُعَلِّمُكَ أَعْظَمَ سُورَةٍ فِي الْقُرْآنِ قَبْلَ أَنْ أَخْرُجَ مِنْ الْمَسْجِدِ؟، فَلَمَّا أَرَادَ أَنْ يَخْرُجَ، قَالَ: الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ سورة الفاتحة آية 2 وَهِيَ السَّبْعُ الْمَثَانِي، وَالْقُرْآنُ الْعَظِيمُ الَّذِي أُوتِيتُمْ"".""","","Sunan al-Darimi 3403","","","12. سورہ فاتحہ کی فضیلت کا بیان"
"3404","(حديث مرفوع) حَدَّثَنَا مُحَمَّدُ بْنُ سَعِيدٍ، حَدَّثَنَا أَبُو أُسَامَةَ، عَنْ عَبْدِ الْحَمِيدِ بْنِ جَعْفَرٍ، عَنْ الْعَلَاءِ بْنِ عَبْدِ الرَّحْمَنِ، عَنْ أَبِيهِ، عَنْ أَبِي هُرَيْرَةَ، عَنْ أُبَيِّ بْنِ كَعْبٍ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: فَاتِحَةُ الْكِتَابِ هِيَ السَّبْعُ الْمَثَانِي"".""","Sahih","Sunan al-Darimi 3404","","","12. سورہ فاتحہ کی فضیلت کا بیان"
"3405","(حديث مرفوع) حَدَّثَنَا نُعَيْمُ بْنُ حَمَّادٍ، حَدَّثَنَا عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ، عَنْ الْعَلَاءِ بْنِ عَبْدِ الرَّحْمَنِ، عَنْ أَبِيهِ، عَنْ أَبِي هُرَيْرَةَ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: مَا أُنْزِلَتْ فِي التَّوْرَاةِ وَلَا فِي الْإِنْجِيلِ وَالزَّبُورِ وَالْقُرْآنِ مِثْلُهَا يَعْنِي: أُمَّ الْقُرْآنِ وَإِنَّهَا لَسَبْعٌ مِنْ الْمَثَانِي، وَالْقُرْآنُ الْعَظِيمُ الَّذِي أُعْطِيتُ"".""","Hasan","Sunan al-Darimi 3405","","","12. سورہ فاتحہ کی فضیلت کا بیان"
"3406","(حديث مرفوع) أَخْبَرَنَا أَبُو عَلِيٍّ الْحَنَفِيُّ، حَدَّثَنِي ابْنُ أَبِي ذِئْبٍ، عَنْ الْمَقْبُرِيِّ، عَنْ أَبِي هُرَيْرَةَ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: الْحَمْدُ لِلَّهِ أُمُّ الْقُرْآنِ، وَأُمُّ الْكِتَابِ، وَالسَّبْعُ الْمَثَانِي"".""","Sahih","Sunan al-Darimi 3406","","","12. سورہ فاتحہ کی فضیلت کا بیان"
"3407","(حديث موقوف) أَخْبَرَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا فِطْرٌ، عَنْ أَبِي إِسْحَاق، عَنْ أَبِي الْأَحْوَصِ، عَنْ عَبْدِ اللَّهِ، قَالَ: مَا مِنْ بَيْتٍ يُقْرَأُ فِيهِ سُورَةُ الْبَقَرَةِ، إِلَّا خَرَجَ مِنْهُ الشَّيْطَانُ وَلَهُ ضَرِيطٌ"".""","Sahih","Sunan al-Darimi 3407","","","13. سورہ البقرہ کی فضیلت کا بیان"
"3408","(حديث موقوف) حَدَّثَنَا أَبُو الْمُغِيرَةِ، حَدَّثَتْنَا عَبْدَةُ، عَنْ خَالِدِ بْنِ مَعْدَانَ، قَالَ: سُورَةُ الْبَقَرَةِ تَعْلِيمُهَا بَرَكَةٌ، وَتَرْكُهَا حَسْرَةٌ، وَلَا يَسْتَطِيعُهَا الْبَطَلَةُ، وَهِيَ فُسْطَاطُ الْقُرْآنِ"".""","","Sunan al-Darimi 3408","","","13. سورہ البقرہ کی فضیلت کا بیان"
