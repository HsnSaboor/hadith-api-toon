hadiths[25]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"915","أَخْبَرَنَا سُلَيْمَانُ بْنُ حَرْبٍ، نا حَمَّادُ بْنُ سَلَمَةَ، عَنْ عَمَّارِ بْنِ أَبِي عَمَّارٍ، عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ، عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: ((إِذَا أَطَاعَ الْعَبْدُ رَبَّهُ وَسَيِّدَهُ لَهُ أَجْرَانِ)) .","","Musnad Ishaq ibn Rahwayh 915","","","A slave receives double reward explained"
"916","أَخْبَرَنَا رَوْحُ بْنُ عُبَادَةَ، نا حَمَّادُ بْنُ سَلَمَةَ، عَنْ عَلِيِّ بْنِ زَيْدٍ، عَنْ أَوْسِ بْنِ خَالِدٍ، عَنْ أَبِي هُرَيْرَةَ، عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: "" مَثَلُ الَّذِي يَسْمَعُ الْحِكْمَةَ، ثُمَّ لَا يَحْمِلُ إِلَّا شَرَّ مَا يَسْمَعُ، كَمَثَلِ رَجُلٍ أَتَى رَاعِيًا فَقَالَ: يَا رَاعِي أَجْزِرْ لِي شَاةً مِنْ غَنَمِكَ، قَالَ: اذْهَبْ فَخُذْ خَيْرَ شَاةٍ، فَذَهَبَ فَأَخَذَ بِأُذُنِ كَلْبِ الْغَنَمِ "".","","Musnad Ishaq ibn Rahwayh 916","","","Statement about misunderstanding words of wisdom"
"917","أَخْبَرَنَا أَبُو أُسَامَةَ، قَالَ: سَمِعْتُ الْأَعْمَشَ، يُحَدِّثُ، عَنْ عُمَارَةَ بْنِ الْقَعْقَاعِ، عَنْ أَبِي زُرْعَةَ، عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ، عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: ((اللَّهُمَّ اجْعَلْ رِزْقَ آلِ مُحَمَّدٍ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَفَافًا)) .","","Musnad Ishaq ibn Rahwayh 917","","","Supplicating for sustenance according to one's needs"
"918","أَخْبَرَنَا عُبَيْدُ اللَّهِ بْنُ مُوسَى، نا إِسْرَائِيلُ، عَنْ أَبِي إِسْحَاقَ، عَنْ كُمَيْلِ بْنِ زِيَادٍ، عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ قَالَ: كُنْتُ أَمْشِي مَعَ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي نَخْلٍ مِنْ نَخْلِ الْمَدِينَةِ، فَقَالَ: يَا أَبَا هُرَيْرَةَ ((هَلَكَ الْمُكْثِرُونَ، إِنَّ الْمُكْثِرِينَ هُمُ الْأَسْفَلُونَ إِلَّا مَنْ قَالَ بِالْمَالِ هَكَذَا وَهَكَذَا وَهَكَذَا)) ، يَعْنِي بَيْنَ يَدَيْهِ وَخَلْفَهُ، وَعَنْ يَمِينِهِ، وَعَنْ يَسَارِهِ، ثُمَّ ذَكَرَ مِثْلَهُ إِلَى آخِرِهِ.","","Musnad Ishaq ibn Rahwayh 918","","","Wealth and riches are a cause of destruction"
"919","أَخْبَرَنَا سُفْيَانُ، وَجَرِيرٌ، عَنْ عَطَاءِ بْنِ السَّائِبِ، عَنِ الْأَغَرِّ أَبِي مُسْلِمٍ، عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ، عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: "" يَقُولُ اللَّهُ تَعَالَى: الْكِبْرِيَاءُ رِدَائِي وَالْعِزُّ إِزَارِي، فَمَنْ نَازَعَنِي وَاحِدًا مِنْهُمَا قَظَمْتُهُ أَلْقَيْتُهُ فِي النَّارِ "".","","Musnad Ishaq ibn Rahwayh 919","","","Statement about avoiding arrogance"
"920","أَخْبَرَنَا أَبُو مُعَاوِيَةَ، نا حَمْزَةُ الزَّيَّاتُ، عَنْ أَبِي مُجَاهِدٍ سَعْدٍ الطَّائِيِّ، عَنْ أَبِي الْمُدَلَّهِ، عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ قَالَ: قُلْنَا: يَا رَسُولَ اللَّهِ مَا لَنَا إِذَا كُنَّا عِنْدَكَ كَأَنَّ قُلُوبَنَا فِي الْآخِرَةِ، وَإِذَا خَرَجْنَا مِنْ عِنْدِكَ فَلَقِينَا الْأَهْلَ وَالْوَلَدَ ذَهَبَ ذَلِكَ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: لَوْ كُنْتُمْ إِذَا خَرَجْتُمْ مِنْ عِنْدِي تَكُونُونَ كَمَا تَكُونُونَ عِنْدِي لَصَافَحَتْكُمُ الْمَلَائِكَةُ بِأَكُفِّهَا وَلَزَارَتْكُمْ فِي بُيُوتِكُمْ، وَلَوْ لَمْ تُذْنِبُوا لَجَاءَ اللَّهُ بِقَوْمٍ يُذْنِبُونَ فَيَغْفِرَ لَهُمْ ""، قُلْتُ: يَا رَسُولَ اللَّهِ أَخْبِرْنِي مِمَّا خُلِقَ الْخَلْقُ، فَقَالَ: ((مِنَ الْمَاءِ)) ، قُلْتُ: يَا رَسُولَ اللَّهِ أَخْبِرْنِي عَنِ الْجَنَّةِ مَا بِنَاؤُهَا، فَذَكَرَ مِثْلَ حَدِيثِ عِيسَى إِلَى آخِرِهِ سَوَاءً، وَقَالَ: ((الْمِسْكُ الْإِذْخِرُ وَحَصْبَاؤُهَا اللُّؤْلُؤُ وَالْيَاقُوتُ)) ، وَقَالَ: ((وَالْإِمَامُ الْمُقْسِطُ لَا تُرَدُّ دَعْوَتُهُ)).","","Musnad Ishaq ibn Rahwayh 920","","","Encouragement to always remain engaged in the remembrance of Allah"
"921","أَخْبَرَنَا الْمُقْرِئُ، نا الْأَفْرِيقِيُّ، نا عُمَارَةُ بْنُ رَاشِدِ بْنِ مُسْلِمٍ، عَنْ أَبِي هُرَيْرَةَ، عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: ((شَرُّ أُمَّتِي الَّذِينَ غُذُّوا فِي النِّعَمِ وَنَبَتَتْ عَلَيْهِمْ أَجْسَامُهُمْ)) .","","Musnad Ishaq ibn Rahwayh 921","","","Statement about those who grow up in blessings"
"922","أَخْبَرَنَا وَكِيعٌ، نا سُفْيَانُ، عَنِ الْحَجَّاجِ بْنِ فُرَافِصَةَ، عَنْ مَكْحُولٍ، عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ، عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: ((مَنْ طَلَبَ الدُّنْيَا حَلَالًا اسْتِعْفَافًا عَنِ الْمَسْأَلَةِ وَسَعْيًا عَلَى أَهْلِهِ وَتَعَطُّفًا عَلَى جَارِهِ جَاءَ يَوْمَ الْقِيَامَةِ وَجْهُهُ كَالْقَمَرِ لَيْلَةَ الْبَدْرِ، وَمَنْ طَلَبَ الدُّنْيَا حَلَالًا مُفَاخِرًا مُكَاثِرًا مُرَائِيًا لَقِيَ اللَّهَ وَهُوَ عَلَيْهِ غَضْبَانُ)) .","","Musnad Ishaq ibn Rahwayh 922","","","Statement about those who seek the world through lawful means"
"923","وَبِهَذَا، عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: ((إِنَّ اللَّهَ الْحَكَمُ الْمُتَحَكِّمُ الْعَفِيفُ الْمُتَعَفِّفُ، وَيَكْرَهُ الْفَاحِشَ الْمُتَفَحِّشَ الْبَذِيءَ السَّائِلَ الْمُلْحِفَ)).","","Musnad Ishaq ibn Rahwayh 923","","","Whom Allah likes and dislikes"
"924","وَبِهَذَا، عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: ((إِلَى ذِكْرِ اللَّهِ فَانْتَهُوا)) .","","Musnad Ishaq ibn Rahwayh 924","","","Statement about turning towards the remembrance of Allah"
"925","وَبِهَذَا، عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ لَهُمْ: ((أَتَدْرُونَ مَا النَّمِيمَةُ؟)) فَقَالُوا: اللَّهُ وَرَسُولُهُ أَعْلَمُ، قَالَ: ((نَقْلُ حَدِيثِ النَّاسِ بَعْضِهِمْ إِلَى بَعْضٍ لِيُفْسِدَ بَيْنَهُمْ))وَقَالَ: لَوْ أَنَّ لِابْنِ آدَمَ وَادِيَيْنِ مِنْ مَالٍ لَابْتَغَى وَادِيًا ثَالِثًا، وَلَا يَمْلَأُ نَفْسَ بَنِي آدَمَ إِلَّا التُّرَابُ، وَيَعْفُوا اللَّهُ عَنْ مَنْ يَشَاءُ "".","","Musnad Ishaq ibn Rahwayh 925","","","Tale-bearing is forbidden"
"926","وَبِهَذَا، عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: ((إِنَّ الشَّيْطَانَ يَتَنَقَّلُ فِي جِسْمِ ابْنِ آدَمَ فَإِذَا عَصَمَهُ اللَّهُ مِنْ بَابٍ تَحَوَّلَ لَهُ مِنْ بَابٍ آخَرَ حَتَّى يُهْلِكَهُ لِغَضَبِهِ)).","","Musnad Ishaq ibn Rahwayh 926","","","Statement about Satan moving within the human body"
"927","أَخْبَرَنَا عِيسَى بْنُ يُونُسَ، نا ابْنُ جُرَيْجٍ، عَنْ عَطَاءٍ، قَالَ: سَمِعْتُ ابْنَ عَبَّاسٍ، يَقُولُ: ((عَجَبًا لِتَرْكِ النَّاسِ هَذَا الْإِهْلَالَ، وَلِتَكْبِيرِهِمْ مَا بِي إِلَّا أَنْ يَكُونَ التَّكْبِيرَةُ حَسَنًا وَلَكِنَّ الشَّيْطَانَ يَأْتِي الْإِنْسَانَ مِنْ قِبَلِ الْإِثْمِ، فَإِذَا عُصِمَ مِنْهُ جَاءَهُ مِنْ نَحْوِ الْبِرِّ لِيَدَعَ سُنَّةً وَلِيَبْتَدِعَ بِدْعَةً)) .","","Musnad Ishaq ibn Rahwayh 927","","","Statement about Satan's attack and committing innovations"
"928","أَخْبَرَنَا كُلْثُومٌ، نا عَطَاءٌ، عَنْ أَبِي هُرَيْرَةَ، عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: ((دَخَلْتُ الْجَنَّةَ فَوَجَدْتُ أَكْثَرَ أَهْلِهَا وَسُكَّانِهَا الْمَسَاكِينَ)).","","Musnad Ishaq ibn Rahwayh 928","","","The majority of the inhabitants of Paradise will be the poor"
"929","وَبِهَذَا، عَنْ رَسُولِ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ قَالَ: وَالَّذِی نَفْسِی بِیَدِهِ لَصَلَاةٌ فِی مَسْجِدِ الْمَدِینَةِ أَفْضَلُ مِنْ أَلْفِ صَلَاۃٍ فِیمَا سِوَاهُ لَیْسَ الْکَعْبَةَ.","","Musnad Ishaq ibn Rahwayh 929","","","Virtue of praying in the Prophet's Mosque"
"930","أَخْبَرَنَا النَّضْرُ، نا حَمَّادُ بْنُ سَلَمَةَ، أنا مُحَمَّدُ بْنُ زِيَادٍ، عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ، عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: ((لَوْ تَعْلَمُونَ مَا أَعْلَمُ لَضَحِكْتُمْ قَلِيلَا وَلَبَكَيتُمْ كَثِيرًا وَلَكِنْ قَارِبُوا وَسَدِّدُوا وَأَبْشِرُوا)) .","","Musnad Ishaq ibn Rahwayh 930","","","Statement about avoiding excessive laughter"
"931","أَخْبَرَنَا عَبْدُ الرَّزَّاقِ، نا مَعْمَرٌ، عَنِ ابْنِ خُثَيْمٍ، عَنْ شَهْرِ بْنِ حَوْشَبٍ، عَنْ أَسْمَاءَ بِنْتِ يَزِيدَ عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: ((أَلَا أُخْبِرُكُمْ بِخِيَارِكُمْ؟)) فَقَالُوا: بَلَى، فَقَالَ: ((الَّذِينَ إِذَا رُؤُوا ذُكِرَ اللَّهُ، أَلَا أُخْبِرُكُمْ بِشِرَارِكُمْ؟)) ، فَقَالُوا: بَلَى يَا رَسُولَ اللَّهِ، فَقَالَ: ((الْمَاشُونَ بِالنَّمِيمَةِ الْمُفْسِدُونَ بَيْنَ الْأَحِبَّةِ، الْبَاغُونَ الْبُرَآءَ الْعَنَتَ)).","","Musnad Ishaq ibn Rahwayh 931","","","Statement about the best and worst people"
"932","أَخْبَرَنَا عِيسَى بْنُ يُونُسَ، نا زَكَرِيَّا وَهُوَ ابْنُ أَبِي زَائِدَةَ، عَنِ الشَّعْبِيِّ، حَدَّثَنِي شُرَيْحُ بْنُ هَانِئٍ أَنَّ عَائِشَةَ، حَدَّثَتْهُ عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: ((مَنْ أَحَبَّ لِقَاءَ اللَّهِ أَحَبَّ اللَّهُ لِقَاءَهُ، وَمَنْ كَرِهَ لِقَاءَ اللَّهِ كَرِهَ اللَّهُ لِقَاءَهُ، وَالْمَوْتُ قَبْلَ لِقَاءِ اللَّهِ)).","","Musnad Ishaq ibn Rahwayh 932","","","Whom Allah loves to meet"
"933","أَخْبَرَنَا يَحْيَى بْنُ يَحْيَى، أنا هُشَيْمٌ، عَنِ الْمُجَالِدِ، عَنِ الشَّعْبِيِّ، عَنْ مَسْرُوقٍ قَالَ: دَخَلْتُ عَلَى عَائِشَةَ وَهِيَ تَبْكِي، فَقُلْتُ لَهَا: يَا أُمَّ الْمُؤْمِنِينَ، مَا يُبْكِيكِ؟ فَقَالَتْ: مَا أَشْبَعُ مِنْ طَعَامٍ وَأَشْتَهِي أَنْ أَبْكِيَ إِلَّا بَكَيْتُ وَذَلِكَ أَنَّ رَسُولَ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمْ يَشْبَعْ مِنْ خُبْزِ بُرٍّ فِي يَوْمٍ مَرَّتَيْنِ حَتَّى قُبِضَ.","","Musnad Ishaq ibn Rahwayh 933","","","Statement about asceticism, seeking forgiveness, and contentment"
"934","أَخْبَرَنَا يَحْيَى بْنُ يَحْيَى، أَخْبَرَنَا صَالِحُ بْنُ مُوسَى الطُّلَحِيُّ، عَنْ مُعَاوِيَةَ قَالَ يَحْيَى: وَهُوَ عِنْدَنَا ابْنُ إِسْحَاقَ، عَنْ عَائِشَةَ بِنْتِ طَلْحَةَ، عَنْ عَائِشَةَ عَنْ رَسُولِ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ: ((أَسْرَعُ الْخَيْرِ ثَوَابًا الْبِرُّ وَصِلَةُ الرَّحِمِ، وَأَسْرَعُ الشَّرِّ عُقَوبَةً، الْبَغْيُ وَقَطِيعَةُ الرَّحِمِ)).","","Musnad Ishaq ibn Rahwayh 934","","","Virtue of good conduct and maintaining family ties"
"935","أَخْبَرَنَا جَرِيرٌ، عَنْ حُصَيْنِ بْنِ عَبْدِ الرَّحْمَنِ السُّلَمِيِّ، عَنْ خَيْثَمَةَ، عَنِ ابْنٍ لِحُذَيْفَةَ، عَنْ عَمَّةٍ لَهُ قَالَتْ: مَرِضَ رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَتَيْتُهُ فِي نِسْوَةٍ مِنَ الْمُهَاجِرَاتِ وَقَدْ عَلَّقَ سِقَاءً وَهُوَ يَقْطُرُ عَلَى فُؤَادِهِ، فَقُلْتُ: يَا رَسُولَ اللَّهِ، قَدْ آذَاكَ هَذَا، فَادْعُ اللَّهَ أَنْ يَكْشِفَهُ عَنْكَ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: ((إِنَّ أَعْظَمَ النَّاسِ بَلَاءً الْأَنْبِيَاءُ، ثُمَّ الَّذِينَ يَلُونَهُمْ، ثُمَّ الَّذِينَ يَلُونَهُمْ)).","","Musnad Ishaq ibn Rahwayh 935","","","Statement about trials and tribulations"
"936","أَخْبَرَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ، نا شُعْبَةُ، عَنْ حُصَيْنٍ، عَنْ أَبِي عُبَيْدَةَ بْنِ حُذَيْفَةَ، عَنْ عَمَّتِهِ فَاطِمَةَ قَالَتْ: أَتَيْتُ رَسُولَ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَعُودُهُ فِي نِسْوَةٍ وَقَدْ عَلَّقَ سِقَاءً، فَذَكَرَ نَحْوَهُ.","","Musnad Ishaq ibn Rahwayh 936","","","Statement about trials and tribulations"
"937","أَخْبَرَنَا النَّضْرُ، نا شُعْبَةُ، عَنْ حُصَيْنٍ، عَنْ أَبِي عُبَيْدَةَ، عَنْ عَمَّتِهِ، قَالَتْ: أَتَيْتُ رَسُولَ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَعَ نِسْوَةٍ، فَإِذَا هُوَ قَدْ عَلَّقَ سِقَاءً يَقْطُرُ عَلَيْهِ مِنْ مَائِهِ مِنْ شِدَّةِ مَا يَجِدُهُ، فَقُلْتُ: يَا رَسُولَ اللَّهِ، لَوْ دَعَوْتَ اللَّهَ أَنْ يُفَرِّجَ عَنْكَ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: ((إِنَّ أَشَدَّ النَّاسِ بَلَاءً الْأَنْبِيَاءُ، ثُمَّ الَّذِينَ يَلُونَهُمْ، ثُمَّ الَّذِينَ يَلُونَهُمْ، ثُمَّ الَّذِينَ يَلُونَهُمْ)).","","Musnad Ishaq ibn Rahwayh 937","","","Statement about trials and tribulations"
"938","أَخْبَرَنَا النَّضْرُ، نا مُحَمَّدُ بْنُ عَمْرٍو، عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ الْمَقْبُرِيِّ، عَنْ عُبَيْدِ سَنُوطَا قَالَ: دَخَلْتُ عَلَى أُمِّ مُحَمَّدٍ , وَكَانَتْ تَحْتَ حَمْزَةَ بْنِ عَبْدِ الْمُطَّلِبِ، تَزَوَّجَهَا بَعْدَهُ رَجُلٌ يُقَالُ لَهُ: حَنْظَلَةُ فَقَالَتْ: جَاءَ رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمًا إِلَى بِنْتِ حَمْزَةَ، فَذَكَرَتْ لَهُ الْأَمَارَاتِ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: ((إِنَّ الدُّنْيَا خَضِرَةٌ حُلْوَةٌ، فَمَنْ أَخَذَ بِحَقِّهَا بَارَكَ اللَّهُ لَهُ فِيهَا، وَرُبَّ مُتَخَوِّضٍ فِي مَالِ اللَّهِ فِيمَا اشْتَهَتْ نَفْسُهُ لَهُ النَّارُ يَوْمَ الْقِيَامَةِ)).","","Musnad Ishaq ibn Rahwayh 938","","","Statement about blessings in lawful wealth"
"939","اَخْبَرَنَا الْفَضْلُ بْنُ مُوْسٰی، نَا طَلْحَةُ، عَنْ عَطَاءٍ، عَنِ ابْنِ عَبَّاسٍ قَالَ: کَانَ رَسُوْلُ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ کَثِیْرًا مَا یَقُوْلُ، فَـلَا اَدْرِیْ اَهُوْ شَیْئٌ یَسْتَحِبُّهٗ، اَوْ هُوَ مِنْ کِتَابِ اللّٰهِ لَوْ کَانَ لِابْنِ آدَمَ وَادِیَانِ مِنْ مَّالٍ لَتَمَنَّی عَلَی اللّٰهِ مِثْلَهٗ، وَلَا یَمْلَأُ نَفْسَهٗ اِلَّا التُّرَابُ، وَیَتُوْبُ اللّٰهُ عَلٰی مَنْ تَابَ.","","Musnad Ishaq ibn Rahwayh 939","","","Statement about greed for wealth"
