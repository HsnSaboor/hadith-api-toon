hadiths[165]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3136","أنبأ عَلِيُّ بْنُ حُجْرٍ ، قَالَ : أنبأ إسْمَاعِيلُ ، عَنْ أَيُّوبَ ، عَنْ عِكْرِمَةَ ، قَالَ : احْتَجَمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ صَائِمٌ ، وَاحْتَجَمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ مُحْرِمٌ """"""","","Sunan al-Kubra al-Nasai 3136","","أَخْبَرَنَا مُحَمَّدُ بْنُ يَحْيَى بْنِ مُحَمَّدٍ قَالَ حَدَّثَنَا يَحْيَى بْنُ يَعْلَى بْنِ الْحَارِثِ الْمُحَارِبِيُّ قَالَ حَدَّثَنَا زَائِدَةُ عَنْ عَاصِمٍ الْأَحْوَلِ عَنْ أَبِي قِلَابَةَ عَنْ أَبِي الْأَشْعَثِ عَنْ أَبِي أَسْمَاءَ الرَّحَبِيِّ عَنْ شَدَّادِ بْنِ أَوْسٍ قَالَ","The Book of Fasting"
"3137","أنبأ أَحْمَدُ بْنُ سَعْدِ بْنِ الْحَكَمِ ، قَالَ : حدَّثَنَا عَمِّي ، قَالَ : أنبأ يَحْيَى بْنُ أَيُّوبَ ، قَالَ : حَدَّثَنِي جَعْفَرُ بْنُ رَبِيعَةَ ، أَنَّهُ سَمِعَ عِكْرِمَةَ ، يَقُولُ : احْتَجَمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ صَائِمٌ ""مِقْسَمٌ ، عَنِ ابْنِ عَبَّاسٍ""","","Sunan al-Kubra al-Nasai 3137","","أَخْبَرَنَا عَبْدُ اللهِ بْنُ الصَّبَّاحِ بْنِ عَبْدِ اللهِ الْعَطَّارُ الْبَصْرِيُّ قَالَ حَدَّثَنَا عَبْدُ الْأَعْلَى قَالَ حَدَّثَنَا هِشَامٌ عَنْ عَاصِمٍ الْأَحْوَلِ عَنْ أَبِي قِلَابَةَ عَنْ أَبِي الْأَشْعَثِ الصَّنْعَانِيِّ عَنْ شَدَّادِ بْنِ أَوْسٍ قَالَ","The Book of Fasting"
"3138","أنبأ عَمْرُو بْنُ يَزِيدَ ، قَالَ : أنبأ بَهْزٌ ، قَالَ : أنبأ شُعْبَةُ ، عَنِ الْحَكَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : احْتَجَمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ صَائِمٌ """"""","","Sunan al-Kubra al-Nasai 3138","","أَخْبَرَنِي عَبْدَةُ بْنُ عَبْدِ الرَّحِيمِ الْمَرْوَزِيُّ قَالَ أَخْبَرَنَا ابْنُ شُمَيْلٍ قَالَ أَخْبَرَنَا شُعْبَةُ عَنْ عَاصِمٍ وَخَالِدٍ عَنْ أَبِي قِلَابَةَ عَنْ أَبِي الْأَشْعَثِ عَنْ شَدَّادِ بْنِ أَوْسٍ","The Book of Fasting"
"3139","أنبأ إِسْمَاعِيلُ بْنُ مَسْعُودٍ ، قَالَ : حَدَّثَنَا خالِدٌ ، عَنْ شُعْبَةَ ، عَنْ يَزِيدَ بْنِ أَبِي زِيَادٍ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : احْتَجَمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ صَائِمٌ ""جَمَعَ الْحَدِيثَيْنِ مُحَمَّدُ بْنُ جَعْفَرٍ""","","Sunan al-Kubra al-Nasai 3139","","أَخْبَرَنَا الْحَسَنُ بْنُ قَزَعَةَ قَالَ حَدَّثَنَا سُفْيَانُ بْنُ حَبِيبٍ عَنْ عَاصِمٍ وَخَالِدٍ عَنْ أَبِي قِلَابَةَ عَنْ أَبِي الْأَشْعَثِ عَنْ شَدَّادِ بْنِ أَوْسٍ قَالَ","The Book of Fasting"
"3140","أنبأ مُحَمَّدُ بْنُ الْمُثَنَّى ، عَنْ مُحَمَّدِ بْنِ َجعْفَرٍ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنْ يَزِيدَ وَهُوَ ابْنُ أَبِي زِيَادٍ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : احْتَجَمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مُحْرِمًا صَائِمًا """"""","","Sunan al-Kubra al-Nasai 3140","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا ابْنُ أَبِي عَدِيٍّ عَنْ خَالِدٍ عَنْ أَبِي قِلَابَةَ عَنْ أَبِي الْأَشْعَثِ عَنْ شَدَّادِ بْنِ أَوْسٍ","The Book of Fasting"
"3141","أنبأ مُحَمَّدُ بْنُ الْمُثَنَّى ، عَنْ مُحَمَّدٍ قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنِ الْحَكَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ احْتَجَمَ صَائِمًا مُحْرِمًا ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : يَزِيدُ بْنُ أَبِي زِيَادٍ لا يُحْتَجُّ بِحَدِيثِهِ ، وَالْحَكَمُ لَمْ يَسْمَعْهُ مِنْ مِقْسَمٍ""","","Sunan al-Kubra al-Nasai 3141","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا يَزِيدُ وَهُوَ ابْنُ زُرَيْعٍ قَالَ حَدَّثَنَا خَالِدٌ عَنْ أَبِي قِلَابَةَ عَنْ أَبِي الْأَشْعَثِ عَنْ شَدَّادِ بْنِ أَوْسٍ قَالَ","The Book of Fasting"
"3142","أَخْبَرَنِي أَبُو بَكْرِ بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا خلَفُ بْنُ سَالِمٍ ، قَالَ : حَدَّثَنَا أَبُو أَحْمَدَ ، قَالَ : حَدَّثَنَا شَرِيكٌ ، عَنْ خُصَيْفٍ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : احْتَجَمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ صَائِمٌ مُحْرِمٌ ""سَعِيدُ بْنُ جُبَيْرٍ ، عَنِ ابْنِ عَبَّاسٍ""","","Sunan al-Kubra al-Nasai 3142","","أَخْبَرَنَا أَبُو عَاصِمٍ قَالَ حَدَّثَنَا عَبْدُ الرَّزَّاقِ عَنْ إِسْمَاعِيلَ بْنِ عَبْدِ اللهِ عَنْ خَالِدٍ عَنْ أَبِي قِلَابَةَ عَنْ أَبِي أَسْمَاءَ عَنْ شَدَّادِ بْنِ أَوْسٍ قَالَ","The Book of Fasting"
"3143","أنبأ مَحْمُودُ بْنُ غَيْلانَ ، قَالَ : حَدَّثَنَا قَبِيصَةُ ، قَالَ : حَدَّثَنَا الثَّوْرِيُّ ، عَنْ حَمَّادٍ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ احْتَجَمَ وَهُوَ صَائِمٌ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : هَذَا خَطَأٌ لا نَعْلَمُ أَحَدًا ، رَوَاهُ عَنْ سُفْيَانَ غَيْرُ قَبِيصَةَ ، وَقَبِيصَةُ كَثِيرُ الْخَطَأِ ، وَقَدْ رَوَاهُ أَبُو هَاشِمٍ ، عَنْ حَمَّادٍ مُرْسَلا""","","Sunan al-Kubra al-Nasai 3143","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ الْمُبَارَكِ قَالَ حَدَّثَنَا إِسْحَاقُ الْأَزْرَقُ عَنْ أَيُّوبَ عَنْ قَتَادَةَ عَنْ أَبِي قِلَابَةَ عَنْ أَبِي أَسْمَاءَ عَنْ شَدَّادِ بْنِ أَوْسٍ قَالَ","The Book of Fasting"
"3144","أنبأ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا خَلَفٌ ، عَنْ أَبِي هَاشِمٍ ، عَنْ حَمَّادِ بْنِ أَبِي سُلَيْمَانَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ احْتَجَمَ وَهُوَ صَائِمٌ ""مَيْمُونُ بْنُ مِهْرَانَ ، عَنِ ابْنِ عَبَّاسٍ""","","Sunan al-Kubra al-Nasai 3144","","وَقَدْ رَوَاهُ يَزِيدُ بْنُ هَارُونَ عَنْ أَبِي الْعَلَاءِ عَنْ قَتَادَةَ عَنْ شَهْرٍ عَنْ بِلَالٍ [325] 3144 أَخْبَرَنِي زَكَرِيَّا بْنُ يَحْيَى قَالَ حَدَّثَنَا إِسْحَاقُ قَالَ أَخْبَرَنَا يَزِيدُ قَالَ أَخْبَرَنَا أَيُّوبُ عَنْ قَتَادَةَ عَنْ شَهْرٌ عَنْ بِلَالٍ","The Book of Fasting"
"3145","أنبأ مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ : حَدَّثَنِي محَمَّدُ بْنُ عَبْدِ اللَّهِ ، قَالَ : حَدَّثَنَا حَبِيبُ بْنُ الشَّهِيدِ ، عَنْ مَيْمُونِ بْنِ مِهْرَانَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ احْتَجَمَ وَهُوَ مُحْرِمٌ صَائِمٌ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : هَذَا مُنْكَرٌ ، وَلا أَعْلَمُ أَحَدًا رَوَاهُ عَنْ حَبِيبٍ غَيْرَ الأَنْصَارِيِّ ، وَلَعَلَّهُ أَرَادَ أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ "" تَزَوَّجَ مَيْمُونَةَ """"""","","Sunan al-Kubra al-Nasai 3145","","أَخْبَرَنَا مُحَمَّدُ بْنُ مَعْمَرٍ بَصْرِيٌّ قَالَ حَدَّثَنَا حِبَّانُ قَالَ حَدَّثَنَا هَمَّامٌ عَنْ قَتَادَةَ عَنْ شَهْرٍ عَنْ ثَوْبَانَ","The Book of Fasting"
"3146","أنبأ حُمَيْدُ بْنُ مَسْعَدَةَ ، عَنْ سُفْيَانَ بْنِ َحبِيبٍ ، عَنْ حَبِيبِ بْنِ الشَّهِيدِ ، عَنْ مَيْمُونِ بْنِ مِهْرَانَ ، عَنْ يَزِيدَ بْنِ الأَصَمِّ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ تَزَوَّجَ مَيْمُونَةَ وَهُوَ مُحِلٌّ ""ذِكْرُ حَدِيثِ جَابِرِ بْنِ عَبْدِ اللَّهِ""","","Sunan al-Kubra al-Nasai 3146","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ قَالَ حَدَّثَنَا خَالِدٌ عَنْ سَعِيدٍ عَنْ قَتَادَةَ عَنْ شَهْرٍ عَنْ عَبْدِ الرَّحْمَنِ بْنِ غُنْمٍ عَنْ ثَوْبَانَ","The Book of Fasting"
"3147","أنبأ أَحْمَدُ بْنُ أَبِي عُبَيْدِ اللَّهِ ، قَالَ : حدَّثَنَا أَبُو قُتَيْبَةَ ، عَنْ هِشَامٍ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرٍ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ احْتَجَمَ وَهُوَ صَائِمٌ ""خَالَفَهُ خَالِدُ بْنُ الْحَارِثِ""","","Sunan al-Kubra al-Nasai 3147","","أَخْبَرَنَا عُبَيْدُ اللهِ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا حِبَّانُ قَالَ حَدَّثَنَا بُكَيْرُ بْنُ أَبِي السُّمَيْطِ قَالَ حَدَّثَنَا قَتَادَةُ عَنْ سَالِمٍ عَنْ مَعْدَانَ بْنِ أَبِي طَلْحَةَ عَنْ ثَوْبَانَ","The Book of Fasting"
"3148","أنبأ مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى ، قَالَ : حَدَّثَنَا خالِدٌ ، قَالَ : حَدَّثَنَا هِشَامٌ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرٍ ، قَالَ : احْتَجَمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ مُحْرِمٌ مِنْ وَثْءٍ كَانَ بِظَهْرِهِ أَوْ بِوَرِكِهِ """"""","","Sunan al-Kubra al-Nasai 3148","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا اللَّيْثُ عَنْ قَتَادَةَ عَنِ الْحَسَنِ عَنْ ثَوْبَانَ","The Book of Fasting"
"3149","أنبأ مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ الْمُبَارَكِ ، قَالَ : حَدَّثَنَا أَبُو الْوَلِيدِ ، حَدَّثَنَا يَزِيدُ بْنُ إِبْرَاهِيمَ ، قَالَ : حَدَّثَنَا أَبُو الزُّبَيْرِ ، عَنْ جَابِرٍ ،  أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَاحْتَجَمَ وَهُوَ مُحْرِمٌ مِنْ وَثْءٍ كَانَ بِهِ ""خَالَفَهُمَا اللَّيْثُ بْنُ سَعْدٍ فَرَوَاهُ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ عَطَاءٍ ، عَنِ ابْنِ عَبَّاسٍ""","","Sunan al-Kubra al-Nasai 3149","","أَخْبَرَنَا الْحَسَنُ بْنُ أَحْمَدَ قَالَ حَدَّثَنَا شَاذُّ بْنُ فَيَّاضٍ بَصْرِيٌّ عَنْ عُمَرَ بْنِ إِبْرَاهِيمَ بَصْرِيٌّ عَنْ قَتَادَةَ عَنِ الْحَسَنِ عَنْ عَلِيٍّ","The Book of Fasting"
"3150","أنبأ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا اللَّيْثُ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ عَطَاءٍ ، عَنِ ابْنِ عَبَّاسٍ ،  أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَاحْتَجَمَ وَهُوَ مُحْرِمٌ ""ذِكْرُ حَدِيثِ أَبِي سَعِيدٍ""","","Sunan al-Kubra al-Nasai 3150","","أَخْبَرَنِي أَبُو بَكْرِ بْنُ عَلِيٍّ قَالَ حَدَّثَنَا سُرَيْجٌ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ يَزِيدَ عَنْ أَبِي الْعَلَاءِ عَنْ قَتَادَةَ عَنِ الْحَسَنِ عَنْ عَلِيٍّ قَالَ","The Book of Fasting"
"3151","أنبأ إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ مَخْلَدِ بْنِ إِبْرَاهِيمَ ، َقالَ : أنبأ الْمُعْتَمِرُ ، قَالَ : سَمِعْتُ حُمَيْدًا ، عَنْ أَبِي الْمُتَوَكِّلِ ، عَنْ أَبِي سَعِيدٍ ، قَالَ : رَخَّصَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الْقُبْلَةِ لِلصَّائِمِ وَرَخَّصَ فِي الْحِجَامَةِ لِلْصَائِمِ ""وَقَفَهُ بِشْرٌ ، وَإِسْمَاعِيلُ ، وَابْنُ أَبِي عَدِيٍّ""","","Sunan al-Kubra al-Nasai 3151","","أَخْبَرَنَا زَكَرِيَّا بْنُ يَحْيَى سِجِسْتَانِيٌّ قَالَ حَدَّثَنَا عَمْرُو بْنُ عِيسَى قَالَ حَدَّثَنَا عَبْدُ الْأَعْلَى قَالَ حَدَّثَنَا سَعِيدٌ عَنْ قَتَادَةَ عَنِ الْحَسَنِ عَنْ عَلِيٍّ قَالَ","The Book of Fasting"
"3152","أنبأ حُمَيْدُ بْنُ مَسْعَدَةَ ، عَنْ بِشْرٍ ، قَالَ : حَدَّثَنَا حُمَيْدٌ ، عَنْ أَبِي الْمُتَوَكِّلِ ، أَنَّهُ سَأَلَ أَبَا سَعِيدٍعَنِ الْحِجَامَةِ لِلصَّائِمِ ، فَقَالَ :  لا بَأْسَ بِهِ "" ، وَعَنِ الْقُبْلَةِ لِلصَّائِمِ ، فَقَالَ : "" لا بَأْسَ بِهِ """"""","","Sunan al-Kubra al-Nasai 3152","","أَخْبَرَنِي أَبُو بَكْرِ بْنُ عَلِيٍّ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ الْمِنْهَالِ قَالَ حَدَّثَنَا يَزِيدُ بْنُ زُرَيْعٍ قَالَ حَدَّثَنَا ابْنُ أَبِي عَرُوبَةَ عَنْ مَطَرٍ عَنِ الْحَسَنِ عَنْ عَلِيٍّ","The Book of Fasting"
"3153","أنبأ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا ابْنُ أَبِي عَدِيٍّ ، عَنْ حُمَيْدٍ ، عَنْ أَبِي الْمُتَوَكِّلِ ، عَنْ أَبِي سَعِيدٍ ، أَنَّهُ  كَانَلا يَرَى بِالْقُبْلَةِ لِلصَّائِمِ بَأْسًا """"""","","Sunan al-Kubra al-Nasai 3153","","أَخْبَرَنَا أَحْمَدُ بْنُ عَبْدَةَ قَالَ حَدَّثَنَا سُلَيْمٌ بْنُ أَخْضَرَ قَالَ حَدَّثَنَا أَشْعَثُ عَنِ الْحَسَنِ عَنْ أُسَامَةَ بْنِ زَيْدٍ قَالَ","The Book of Fasting"
"3154","أنبأ عَلِيُّ بْنُ حُجْرٍ ، قَالَ : حَدَّثَنَا إِسْمَاعِيلُ ، عَنْ حُمَيْدٍ ، عَنْ أَبِي الْمُتَوَكِّلِ ، أَنَّهُ سَأَلَ أَبَا سَعِيدٍ عَنِالصَّائِمِ يَحْتَجِمُ ، فَقَالَ :  لا بَأْسَ بِهِ ""الاخْتِلافُ عَلَى خَالِدٍ الْحَذَّاءِ""","","Sunan al-Kubra al-Nasai 3154","","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ قَالَ حَدَّثَنِي أَبُو دَاوُدَ قَالَ حَدَّثَنَا سُلَيْمَانُ بْنُ مُعَاذٍ عَنْ عَطَاءِ بْنِ السَّائِبِ قَالَ شَهِدَ عِنْدِي نَفَرٌ مِنْ أَهْلِ الْبَصْرَةِ مِنْهُمْ الْحَسَنُ عَنْ مَعْقِلِ بْنِ يَسَارٍ","The Book of Fasting"
"3155","أنبأ إِبْرَاهِيمُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا إسْحَاقُ بْنُ يُوسُفَ ، عَنْ سُفْيَانَ ، عَنْ خَالِدٍ ، عَنْ أَبِي الْمُتَوَكِّلِ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ،  أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَرَخَّصَ فِي الْحِجَامَةِ لِلصَّائِمِ """"""","","Sunan al-Kubra al-Nasai 3155","","أَخْبَرَنَا يَحْيَى بْنُ مُوسَى وَأَحْمَدُ بْنُ حَرْبٍ وَاللَّفْظُ لَهُ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ فُضَيْلٍ عَنْ عَطَاءٍ قَالَ شَهِدَ عِنْدِي نَفَرٌ مِنْ أَهْلِ الْبَصْرَةِ مِنْهُمْ الْحَسَنُ بْنُ أَبِي الْحَسَنِ عَنْ مَعْقِلِ بْنِ سِنَانٍ الْأَشْجَعِيِّ","The Book of Fasting"
"3156","أنبأ مُحَمَّدُ بْنُ حَاتِمٍ ، قَالَ : أنبأ حِبَّانُ ، قَالَ : أنبأ عَبْدُ اللَّهِ ، عَنْ خَالِدٍ الْحَذَّاءِ ، عَنْ أَبِي الْمُتَوَكِّلِ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ : لا بَأْسَ بِالْحِجَامَةِ لِلصَّائِمِ ""خَالَفَهُ حَسَنُ بْنُ عِيسَى""","","Sunan al-Kubra al-Nasai 3156","","أَخْبَرَنِي زَكَرِيَّا بْنُ يَحْيَى قَالَ حَدَّثَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا عَبْدُ الرَّحْمَنِ قَالَ حَدَّثَنَا أَبُو حَرَّةَ عَنِ الْحَسَنِ قَالَ","The Book of Fasting"
"3157","أَخْبَرَنِي زَكَرِيَّا بْنُ يَحْيَى ، قَالَ : حَدَّثَنَا الْحَسَنُ بْنُ عِيسَى بْنُ ماسَرْجِسَ ، قَالَ : أنبأ ابْنُ الْمُبَارَكِ ، قَالَ : أنبأ خَالِدُ الْحَذَّاءُ ، عَنْ أَبِي نَضْرَةَ ، عَنْ أَبِي سَعِيدٍ ،  أَنَّهُ أَنَلا يَرَى بِالْحِجَامَةِ لِلصَّائِمِ بَأْسًا ""وَقَفَهُ قَتَادَةُ""","","Sunan al-Kubra al-Nasai 3157","","أَخْبَرَنِي زَكَرِيَّا بْنُ يَحْيَى قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ مَنْصُورٍ قَالَ حَدَّثَنَا بِشْرُ بْنُ السَّرِيِّ قَالَ حَدَّثَنَا أَبُو حُرَّةَ قَالَ أَمَرَنِي مَطَرٌ الْوَرَّاقُ","The Book of Fasting"
"3158","أنبأ مُحَمَّدُ بْنُ حَاتِمٍ ، قَالَ : حَدَّثَنَا حِبَّانُ ، قَالَ : أنبأ عَبْدُ اللَّهِ ، عَنْ شُعْبَةَ ، عَنْ قَتَادَةَ ، عَنْ أَبِي الْمُتَوَكِّلِ ، عَنْ أَبِي سَعِيدٍ ، قَالَ : لا بَأْسَ بِالْحِجَامَةِ لِلصَّائِمِ إِذَا لَمْ يَجِدْ ضَعْفًا """"""","","Sunan al-Kubra al-Nasai 3158","","أَخْبَرَنِي أَبُو بَكْرِ بْنُ عَلِيٍّ قَالَ حَدَّثَنَا سُرَيْجٌ قَالَ حَدَّثَنَا أَبُو قَطَنٍ عَنْ أَبِي حُرَّةَ قَالَ قُلْتُ لِلْحَسَنِ قَوْلُكَ «§أَفْطَرَ الْحَاجِمُ وَالْمَحْجُومُ» عَمَّنْ؟ قَالَ","The Book of Fasting"
"3159","أنبأ عُبَيْدُ اللَّهِ بْنُ عَبْدِ الْكَرِيمِ أَبُو زُرْعَةَ الرَّازِيُّ ، قَالَ : حَدَّثَنِي عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْمَلِكِ ، قَالَ : حَدَّثَنِي يُونُسُ بْنُ يَحْيَى بْنِ نُبَاتَةَ ، عَنِ ابْنِ أَبِي ذِئْبٍ ، عَنِ ابْنِ شِهَابٍ ، عَنْ عَبْدِ اللَّهِ بْنِ ثَعْلَبَةَ بْنِ صُعَيْرِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ لَمْ يَدَعْ قَوْلَ الزُّورِ وَالْعَمَلَ بِهِ وَالْجَهْلَ ، فَلَيْسَ اللَّهِ حَاجَةٌ أَنْ يَدَعَ طَعَامَهُ وَلا شَرَابَهُ """"""","","Sunan al-Kubra al-Nasai 3159","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى قَالَ حَدَّثَنَا الْمُعْتَمِرُ عَنْ أَبِيهِ عَنِ الْحَسَنِ","The Book of Fasting"
"3160","أَنْبَأَ سُوَيْدُ بْنُ نَصْرٍ ، قَالَ : أَنْبَأَ عَبْدُ اللَّهِ ، قَالَ : أَنْبَأَ ابْنُ أَبِي ذِئْبٍ ، عَنْ سَعِيدٍ الْمَقْبُرِيِّ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ لَمْ يَدَعْ قَوْلَ الزُّورِ وَالْعَمَلَ بِهِ ، فَلَيْسَ اللَّهِ حَاجَةٌ بِأَنْ يَدَعَ طَعَامَهُ وَلا شَرَابَهُ """"""","","Sunan al-Kubra al-Nasai 3160","","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ قَالَ حَدَّثَنَا عَبْدُ الْوَهَّابِ عَنْ يُونُسَ عَنِ الْحَسَنِ عَنْ أَبِي هُرَيْرَةَ","The Book of Fasting"
"3161","أَنْبَأَ الرَّبِيعُ بْنُ سُلَيْمَانَ ، قَالَ : حَدَّثَنَا ابْنُ وَهْبٍ ، قَالَ : أَخْبَرَنِي ابْنُ أَبِي ذِئْبٍ ، عَنْ سَعِيدٍ الْمَقْبُرِيِّ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ لَمْ يَدَعْ قَوْلَ الزُّورِ وَالْعَمَلَ بِهِ وَالْجَهْلَ فِي الصَّوْمِ ، فَلَيْسَ اللَّهِ حَاجَةٌ بِأَنْ يَدَعَ طَعَامَهُ وَشَرَابَهُ """"""","","Sunan al-Kubra al-Nasai 3161","","أَخْبَرَنَا أَبُو بَكْرِ بْنُ عَلِيٍّ قَالَ حَدَّثَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ قَالَ حَدَّثَنَا بِشْرُ بْنُ الْمُفَضَّلِ عَنْ يُونُسَ عَنِ الْحَسَنِ قَالَ","The Book of Fasting"
"3162","أَنْبَأَ أَحْمَدُ بْنُ عَمْرِو بْنِ السَّرْحِ ، قَالَ : حَدَّثَنَا ابْنُ وَهْبٍ ، قَالَ : حَدَّثَنِي ابْنُ أَبِي ذِئْبٍ ، عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ لَمْ يَدَعْ قَوْلَ الزُّورِ وَالْعَمَلَ بِهِ وَالْجَهْلَ فِي الصَّوْمِ فَلَيْسَ اللَّهِ حَاجَةٌ فِي تَرْكِ طَعَامِهِ وَشَرَابِهِ """"""","","Sunan al-Kubra al-Nasai 3162","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ وَمُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى قَالَا حَدَّثَنَا الْمُعْتَمِرُ عَنْ أَبِيهِ عَنْ أَبِي عَمْرٍو عَنْ أَبِيهِ عَنْ أَبِي هُرَيْرَةَ","The Book of Fasting"
"3163","أَنْبَأَ مُحَمَّدُ بْنُ حَاتِمٍ ، قَالَ : أَنْبَأَ حِبَّانُ ، قَالَ : أَنْبَأَ عَبْدُ اللَّهِ ، عَنْ أُسَامَةَ بْنِ زَيْدٍ ، عَنْ سَعِيدٍ الْمَقْبُرِيِّ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : رُبَّ صَائِمٍ لَيْسَ لَهُ مِنْ صِيَامِهِ إِلا الْجُوعُ ، وَرُبَّ قَائِمٍ لَيْسَ لَهُ مِنْ قِيَامِهِ إِلا السَّهَرُ "". أَنْبَأَ مُحَمَّدُ بْنُ عَبْدِ اللَّهِ الْمَخْرَمِيُّ ، قَالَ : حَدَّثَنَا يَحْيَى يَعْنِي ابْنَ آدَمَ ، قَالَ : حَدَّثَنَا ابْنُ الْمُبَارَكِ ، عَنْ أُسَامَةَ ، عَنْ سَعِيدٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ سَوَاءٌ . أَنْبَأَ مُحَمَّدُ بْنُ حَاتِمٍ ، قَالَ : أَنْبَأَ سُوَيْدٌ ، قَالَ : أَنْبَأَ عَبْدُ اللَّهِ ، عَنْ أُسَامَةَ بْنِ زَيْدٍ ، عَنْ سَعِيدٍ الْمَقْبُرِيِّ ، عَنْ أَبِي هُرَيْرَةَ ، مِثْلَهُ سَوَاءٌ ، وَلَمْ يَرْفَعْهُ""","","Sunan al-Kubra al-Nasai 3163","","أَخْبَرَنَا أَحْمَدُ بْنُ فَضَالَةَ النَّسَائِيُّ قَالَ أَخْبَرَنَا أَبُو عَاصِمٍ قَالَ أَخْبَرَنَا ابْنُ جُرَيْجٍ عَنْ صَفْوَانَ بْنِ سُلَيْمٍ عَنْ أَبِي سَعِيدٍ مَوْلَى بَنِي عَامِرٍ عَنْ أَبِي هُرَيْرَةَ","The Book of Fasting"
"3164","أَنْبَأَ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا مُغِيرَةُ ، عَنْ أَبِي الزِّنَادِ ، عَنِ الأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : الصِّيَامُ جُنَّةٌ ، فَإِذَا كَانَ أَحَدُكُمْ صَائِمًا فَلا يَرْفُثْ وَلا يَجْهَلْ ، فَإِنِ امْرُؤٌ قَاتَلَهُ وَشَاتَمَهُ ، فَلْيَقُلْ : إِنِّي صَائِمٌ إِنِّي صَائِمٌ """"""","","Sunan al-Kubra al-Nasai 3164","","أَخْبَرَنَا أَيُّوبُ بْنُ مُحَمَّدٍ الْوَزَّانُ قَالَ حَدَّثَنَا مَعْمَرُ بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا عَبْدُ اللهِ بْنُ بِشْرٍ عَنِ الْأَعْمَشِ عَنْ أَبِي صَالِحٍ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Fasting"
"3165","أَنْبَأَ مُحَمَّدُ بْنُ سَلَمَةَ ، قَالَ : أَنْبَأَ ابْنُ الْقَاسِمِ ، عَنْ مَالِكٍ ، عَنْ أَبِي الزِّنَادِ ، عَنِ الأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : الصِّيَامُ جُنَّةٌ ، فَإِذَا كَانَ أَحَدُكُمْ صَائِمًا فَلا يَرْفُثْ وَلا يَجْهَلْ ، فَإِنِ امْرُؤٌ قَاتَلَهُ أَوْ شَاتَمَهُ فَلْيَقُلْ : إِنِّي صَائِمٌ إِنِّي صَائِمٌ ""وَقَفَهُ أَبُو حَصِينٍ""","","Sunan al-Kubra al-Nasai 3165","","أَخْبَرَنَا أَحْمَدُ بْنُ حَفْصِ بْنِ عَبْدِ اللهِ نَيْسَابُورِيُّ مُرْجِئٌ قَالَ حَدَّثَنِي أَبِي قَالَ حَدَّثَنِي إِبْرَاهِيمُ بْنُ طَهْمَانَ هَرَوِيٌّ مُرْجِئٌ عَنِ الْأَعْمَشِ عَنْ أَبِي صَالِحٍ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Fasting"
"3166","أَنْبَأَ هَنَّادُ بْنُ السَّرِيِّ ، عَنْ أَبِي بَكْرٍ ، عَنْ أَبِي حَصِينٍ وَاسْمُهُ عُثْمَانُ بْنُ عَاصِمٍ كُوفِيٌّ ، عَنْ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : إِذَا كَانَ يَوْمُ صَوْمِ أَحَدِكُمْ فَلا يَرْفُثْ وَلا يَجْهَلْ ، فَإِنْ جُهِلَ عَلَيْهِ فَلْيَقُلْ : إِنِّي صَائِمٌ """"""","","Sunan al-Kubra al-Nasai 3166","","أَخْبَرَنَا مُحَمَّدُ بْنُ حَاتِمٍ قَالَ أَخْبَرَنَا حِبَّانُ قَالَ أَخْبَرَنَا عَبْدُ اللهِ عَنْ مَعْمَرٍ وَأَخْبَرَنِي زَكَرِيَّا بْنُ يَحْيَى قَالَ حَدَّثَنَا الْحَسَنُ بْنُ عِيسَى قَالَ أَخْبَرَنَا ابْنُ الْمُبَارَكِ قَالَ أَخْبَرَنَا مَعْمَرٌ عَنْ خَلَّادٍ عَنْ شَقِيقِ بْنِ ثَوْرٍ عَنْ أَبِيهِ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Fasting"
"3167","أَخْبَرَنِي إِبْرَاهِيمُ بْنُ الْحَسَنِ ، عَنْ حَجَّاجٍ ، قَالَ ابْنُ جُرَيْجٍ : أَخْبَرَنِي عَطَاءٌ ، عَنْ أَبِي صَالِحٍ ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ ، يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا كَانَ يَوْمُ صِيَامِ أَحَدِكُمْ فَلا يَرْفُثْ وَلا يَصْخَبْ ، فَإِنْ شَاتَمَهُ أَحَدٌ أَوْ قَاتَلَهُ فَلْيَقُلْ : إِنِّي صَائِمٌ """"""","","Sunan al-Kubra al-Nasai 3167","","أَخْبَرَنَا حَفْصُ بْنُ عُمَرَ الرَّازِيُّ قَالَ حَدَّثَنَا أَبُو أَحْمَدَ عَنْ رَبَاحِ بْنِ أَبِي مَعْرُوفٍ عَنْ عَطَاءٍ عَنْ أَبِي هُرَيْرَةَ","The Book of Fasting"
"3168","أَنْبَأَ مُحَمَّدُ بْنُ حَاتِمٍ ، قَالَ : أَنْبَأَ سُوَيْدٌ ، قَالَ : أَنْبَأَ عَبْدُ اللَّهِ ، عَنِ ابْنِ جُرَيْجٍ قِرَاءَةً ، عَنْ عَطَاءٍ ، أَنْبَأَ عَطَاءٌ الزَّيَّاتُ ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ ، يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا كَانَ يَوْمُ صَوْمِ أَحَدِكُمْ فَلا يَرْفُثْ حِينَئِذٍ ، وَلا يَصْخَبْ ، فَإِنْ شَاتَمَهُ أَحَدٌ أَوْ قَاتَلَهُ فَلْيَقُلْ إِنِّي امْرُؤٌ صَائِمٌ إِنِّي امْرُؤٌ صَائِمٌ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : ابْنُ الْمُبَارَكِ أَجَلُّ وَأَنْبَلُ عِنْدَنَا مِنْ حَجَّاجٍ ، وَحَدِيثُ حَجَّاجٍ أَوْلَى بِالصَّوَابِ""","","Sunan al-Kubra al-Nasai 3168","","أَخْبَرَنَا مُحَمَّدُ بْنُ إِدْرِيسَ أَبُو حَاتِمٍ الرَّازِيُّ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَنْصَارِيُّ عَنِ ابْنِ جُرَيْجٍ عَنْ عَطَاءٍ عَنْ أَبِي هُرَيْرَةَ","The Book of Fasting"
"3169","أَنْبَأَ عَبْدُ الرَّحْمَنِ بْنُ إِبْرَاهِيمَ ، عَنِ الْوَلِيدِ ، عَنِ ابْنِ نَمِرٍ وَاسْمُهُ عَبْدُ الرَّحْمَنِ ،  قَالَ أَبُو عَبْدِ الرَّحْمَنِ : لَمْ يَرْوِ عَنْهُ غَيْرُ الْوَلِيدِ فِيمَا عَلِمْنَاهُ ، قَالَ الزُّهْرِيُّ : أَخْبَرَنِي سَعِيدُ بْنُ الْمُسَيِّبِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : إِذَا سُبَّ أَحَدُكُمْ وَهُوَ صَائِمٌ فَلْيَقُلْ : إِنِّي صَائِمٌ ""، يَنْهَى بِذَلِكَ عَنْ مُرَاجَعَةِ الصَّائِمِ""","","Sunan al-Kubra al-Nasai 3169","","أَخْبَرَنَا أَبُو بَكْرِ بْنُ عَلِيٍّ قَالَ حَدَّثَنَا عَبْدُ الْأَعْلَى قَالَ حَدَّثَنَا دَاوُدُ بْنُ عَبْدِ الرَّحْمَنِ عَنِ ابْنِ جُرَيْجٍ عَنْ عَطَاءٍ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Fasting"
"3170","أَنْبَأَ مُحَمَّدُ بْنُ يَزِيدَ ، قَالَ : حَدَّثَنَا مَعْنٌ ، عَنْ خَارِجَةَ بْنِ سُلَيْمَانَ ، عَنْ يَزِيدَ بْنِ رُومَانَ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : الصِّيَامُ جُنَّةٌ مِنَ النَّارِ ، فَمَنْ أَصْبَحَ صَائِمًا فَلا يَجْهَلْ يَوْمَئِذٍ ، وَإِنْ جَهِلَ أَحَدٌ عَلَيْهِ فَلا يَشْتُمْهُ وَلا يَسُبَّهُ ، وَلْيَقُلْ إِنِّي صَائِمٌ ، وَالَّذِي نَفْسُ مُحَمَّدٍ بِيَدِهِ ، لَخُلُوفُ فَمِ الصَّائِمِ أَطْيَبُ عِنْدِ اللَّهِ مِنْ رِيحِ الْمِسْكِ """"""","","Sunan al-Kubra al-Nasai 3170","","أَخْبَرَنَا سُلَيْمَانُ بْنُ سَلْمٍ الْبَلْخِيُّ قَالَ أَخْبَرَنَا النَّضْرُ قَالَ أَخْبَرَنَا ابْنُ جُرَيْجٍ عَنْ عَطَاءٍ عَنْ أَبِي هُرَيْرَةَ قَالَ «§أَفْطَرَ الْحَاجِمُ وَالْمُحْجُومُ» قَالَ","The Book of Fasting"
"3171","أَنْبَأَ مُحَمَّدُ بْنُ حَاتِمٍ ، قَالَ : أَنْبَأَ حِبَّانُ ، قَالَ : أَنْبَأَ عَبْدُ اللَّهِ ، عَنِ ابْنِ أَبِي ذِئْبٍ ، عَنْ عَجْلانَ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : لا تُسَابَّ وَأَنْتَ صَائِمٌ ، فَإِنْ سَبَّكَ أَحَدٌ ، فَقُلْ : إِنِّي صَائِمٌ ، وَإِنْ كُنْتَ قَائِمًا فَاجْلِسْ """"""","","Sunan al-Kubra al-Nasai 3171","","أَخْبَرَنَا مُحَمَّدُ بْنُ يَحْيَى بْنِ عَبْدِ اللهِ قَالَ حَدَّثَنَا عَبْدُ الرَّزَّاقِ قَالَ أَخْبَرَنَا ابْنُ جُرَيْجٍ عَنْ عَطَاءٍ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Fasting"
"3172","أَنْبَأَ مُحَمَّدُ بْنُ مَعْدَانَ ، قَالَ : حَدَّثَنَا الْحَسَنُ بْنُ أَعْيَنَ حَرَّانِيٌّ ثِقَةٌ ، قَالَ : حَدَّثَنَا مَعْقِلٌ ، عَنْ عَطَاءٍ ، قَالَ : سَمِعْتُ أَبَا هُرَيْرَةَ ، يَقُولُ : إِذَا كَانَ أَحَدُكُمْ صَائِمًا فَسَابَّهُ أَحَدٌ ، فَلْيَقُلْ : إِنِّي صَائِمٌ """"""","","Sunan al-Kubra al-Nasai 3172","","أَخْبَرَنَا إِبْرَاهِيمُ بْنُ الْحَسَنِ عَنْ حَجَّاجٍ عَنِ ابْنِ جُرَيْجٍ عَنْ عَطَاءٍ عَنْ أَبِي هُرَيْرَةَ وَلَمْ يَسْمَعْهُ مِنْهُ قَالَ «§أَفْطَرَ الْحَاجِمُ وَالْمَحْجُومُ» خَالَفَهُ ابْنُ أَبِي حُسَيْنٍ فَرَوَاهُ عَنْ عَطَاءٍ قَالَ","The Book of Fasting"
"3173","أَنْبَأَ نُوحُ بْنُ حَبِيبٍ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، قَالَ : أَنْبَأَ مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : قَالَ اللَّهُ : كُلُّ عَمَلِ ابْنِ آدَمَ لَهُ إِلا الصِّيَامُ لِي وَأَنَا أَجْزِي بِهِ ، وَخُلُوفُ فَمِ الصَّائِمِ أَطْيَبُ عِنْدَ اللَّهِ مِنْ رِيحِ الْمِسْكِ """"""","","Sunan al-Kubra al-Nasai 3173","","أَخْبَرَنَا الْحَسَنُ بْنُ إِسْحَاقَ مَرْوَزِيٌّ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللهِ الرَّقَاشِيُّ قَالَ حَدَّثَنَا وُهَيْبٌ عَنِ ابْنِ أَبِي حُسَيْنٍ عَنْ عَطَاءٍ قَالَ سَمِعْتُ أَبَا هُرَيْرَةَ يَقُولُ «§أَفْطَرَ الْحَاجِمُ وَالْمَحْجُومُ» قَالَ أَبُو عَبْدِ الرَّحْمَنِ وَالصَّوَابُ رِوَايَةُ حَجَّاجٍ","The Book of Fasting"
"3174","أَنْبَأَ مُحَمَّدُ بْنُ حَاتِمٍ ، قَالَ : أَنْبَأَ سُوَيْدٌ ، قَالَ : أَنْبَأَ عَبْدُ اللَّهِ ، عَنِ ابْنِ جُرَيْجٍ قِرَاءَةً ، عَنْ عَطَاءٍ ، قَالَ : أَنْبَأَ عَطَاءٌ الزَّيَّاتُ ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ ، ، يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  وَالَّذِي نَفْسُ مُحَمَّدٍ بِيَدِهِ ،لَخُلُوفُ فَمِ الصَّائِمِ أَطْيَبُ عِنْدَ اللَّهِ مِنْ رِيحِ الْمِسْكِ """"""","","Sunan al-Kubra al-Nasai 3174","","أَخْبَرَنِي إِبْرَاهِيمُ بْنُ الْحَسَنِ عَنْ حَجَّاجٍ قَالَ حَدَّثَنِي شُعْبَةُ عَنْ عَمْرِو بْنِ دِينَارٍ عَنْ عَطَاءٍ عَنْ رَجُلٍ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Fasting"
"3175","أَنْبَأَ عُبَيْدُ اللَّهِ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا يحْيَى ، عَنْ عُبَيْدِ اللَّهِ ، قَالَ : أَخْبَرَنِي نَافِعٌ ، عَنِ ابْنِ عُمَرَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَاصَلَ فِي رَمَضَانَ ، فَوَاصَلَ النَّاسُ ، فَنَهَاهُمْ عَنِ الْوِصَالِ ، فَقَالُوا : إِنَّكَ تُوَاصِلُ ، فَقَالَ : إِنِّي لَسْتُ مِثْلَكُمْ ، إِنِّي أُطْعَمُ وَأُسْقَى ""ذِكْرُ الاخْتِلافِ عَلَى الزُّهْرِيِّ فِي حَدِيثِ أَبِي هُرَيْرَةَ فِي الْوِصَالِ""","","Sunan al-Kubra al-Nasai 3175","","أَخْبَرَنِي مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ إِبْرَاهِيمَ عَنْ يَزِيدَ قَالَ أَخْبَرَنَا عَبْدُ الْمَلِكِ بْنُ أَبِي سُلَيْمَانَ عَنْ عَطَاءٍ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Fasting"
"3176","أَخْبَرَنِي عَمْرُو بْنُ عُثْمَانَ بْنِ سَعِيدٍ ، قَالَ : حدَّثَنَا أَبِي ، عَنْ شُعَيْبٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : حَدَّثَنِي أَبُو سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّ أَبَا هُرَيْرَةَ قَالَ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الْوِصَالِ فَقَالَ رَجُلٌ مِنَ الْمُسْلِمِينَ : وَإِنَّكَ تُوَاصِلُ يَا رَسُولَ اللَّهِ ، قَالَ : أَيُّكُمْ مِثْلِي ؟ ! إِنِّي أَبِيتُ يُطْعِمُنِي رَبِّي وَيَسْقِينِي "" ، فَلَمَّا أَبَوْا أَنْ يَنْتَهُوا وَاصَلَ بِهِمْ يَوْمًا ثُمَّ يَوْمًا ثُمَّ رَأَوْا هِلالا ، فَقَالَ : "" لَو تَأَخَّرَ لَزِدْتُكُمْ "" ، كَالتَّنْكِيلِ بِهِمْ حِينَ أَبَوْا أَنْ يَنْتَهُوا""","","Sunan al-Kubra al-Nasai 3176","","أَخْبَرَنَا مُحَمَّدُ بْنُ حَاتِمٍ قَالَ أَخْبَرَنَا حِبَّانُ قَالَ أَخْبَرَنَا عَبْدُ اللهِ عَنْ عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ عَنْ عَطَاءٍ عَنْ أَبِي هُرَيْرَةَ قَالَ «§أَفْطَرَ الْحَاجِمُ وَالْمَحْجُومُ» قَالَ","The Book of Fasting"
"3177","أَنْبَأَ عَبْدُ الرَّحْمَنِ بْنُ إِبْرَاهِيمَ ، عَنِ الْوَلِيدِ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ نَمِرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : أَخْبَرَنِي سَعِيدٌ ، وَأَبُو سَلَمَةَ ، أَنَّ أَبَا هُرَيْرَةَ قَالَ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الْوِصَالِ فِي الصِّيَامِ ، قَالَ نَاسٌ : فَإِنَّكَ تُوَاصِلُ ، قَالَ : إِنِّي أَبِيتُ يُطْعِمُنِي رَبِّي وَيَسْقِينِي """"""","","Sunan al-Kubra al-Nasai 3177","","أَخْبَرَنِي أَبُو بَكْرِ بْنُ عَلِيٍّ قَالَ حَدَّثَنَا إِسْحَاقُ قَالَ حَدَّثَنَا خَالِدٌ عَنْ عَبْدِ الْمَلِكِ عَنْ عَطَاءٍ قَالَ","The Book of Fasting"
"3178","أَنْبَأَ إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أَنْبَأَ عَبْدَةُ بْنُ سُلَيْمَانَ ، قَالَ : حَدَّثَنَا هِشَامُ بْنُ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنْ عَائِشَةَ ، قَالَتْ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الْوِصَالِ رَحْمَةً ، قَالُوا : يَا رَسُولَ الل0َّهِ ، إِنَّكَ تُوَاصِلُ ، قَالَ : إِنِّي لَسْتُ كَأَحَدِكُمْ يُطْعِمُنِي رَبِّي وَيَسْقِينِي """"""","","Sunan al-Kubra al-Nasai 3178","","أَخْبَرَنَا سَعِيدُ بْنُ يَعْقُوبَ الطَّالَقَانِيُّ قَالَ حَدَّثَنَا خَالِدٌ عَنْ لَيْثٍ عَنْ عَطَاءٍ عَنْ عَائِشَةَ","The Book of Fasting"
"3179","أَنْبَأَ مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى ، قَالَ : حَدَّثَنَا خالِدٌ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنْ حَبِيبٍ ، عَنْ لَيْلَى جَدَّةِ حَبِيبٍ أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ دَخَلَ عَلَيْهَا فَأَتَتْهُ بِطَعَامٍ ، فَقَالَ لَهَا :  كُلِي "" ، فَقَالَتْ : إِنِّي صَائِمَةٌ ، فَقَالَ : ""إِنَّ الصَّائِمَ إِذَا أُكِلَ عِنْدَهُ صَلَّتْ عَلَيْهِ الْمَلائِكَةُ حَتَّى يَفْرُغُوا """"""","","Sunan al-Kubra al-Nasai 3179","","أَخْبَرَنِي أَبُو بَكْرِ بْنُ عَلِيٍّ قَالَ حَدَّثَنَا خَلَفُ بْنُ سَالِمٍ قَالَ حَدَّثَنَا أَبُو النَّضْرِ قَالَ حَدَّثَنَا أَبُو مُعَاوِيَةَ عَنْ لَيْثٍ عَنْ عَطَاءٍ عَنْ عَائِشَةَ قَالَتْ","The Book of Fasting"
"3180","أَنْبَأَ عَلِيُّ بْنُ حُجْرٍ ، قَالَ : أَنْبَأَ شَرِيكٌ ، عَنْ حَبِيبِ بْنِ زَيْدٍ ، عَنْ لَيْلَى ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : الصَّائِمُ إِذَا أُكِلَ عِنْدَهُ صَلَّتْ عَلَيْهِ الْمَلائِكَةُ """"""","","Sunan al-Kubra al-Nasai 3180","","أَخْبَرَنِي إِبْرَاهِيمُ بْنُ يَعْقُوبَ قَالَ حَدَّثَنَا الْحَسَنُ بْنُ مُوسَى قَالَ حَدَّثَنَا شَيْبَانُ عَنْ لَيْثٍ عَنْ عَطَاءٍ عَنْ عَائِشَةَ قَالَ وَحَدَّثَنَا شَيْبَانُ عَنْ لَيْثٍ عَنْ عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عُمَيْرٍ عَنْ عُرْوَةَ بْنِ عِيَاضِ عَنْ عَائِشَةَ قَالَتْ","The Book of Fasting"
"3181","أَنْبَأَ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، عَنْ أَبِي الزِّنَادِ ، عَنِ الأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، يَرْفَعُهُ ، قَالَ : إِذَا أَصْبَحَ أَحَدُكُمْ يَوْمًا صَائِمًا فَلا يَرْفُثْ وَلا يَجْهَلْ ، وَإِنِ امْرُؤٌ شَاتَمَهُ أَوْ قَاتَلَهُ فَلْيَقُلْ : إِنِّي صَائِمٌ ، وَإِذَا دُعِيَ أَحَدُكُمْ إِلَى طَعَامٍ وَهُوَ صَائِمٌ ، فَلْيَقُلْ : إِنِّي صَائِمٌ """"""","","Sunan al-Kubra al-Nasai 3181","","أَخْبَرَنَا أَبُو بَكْرِ بْنُ عَلِيٍّ قَالَ حَدَّثَنَا عَبَّاسٌ النَّرْسِيُّ قَالَ حَدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ قَالَ حَدَّثَنَا لَيْثٌ عَنْ عَطَاءٍ قَالَ كَانَتْ عَائِشَةُ تَقُولُ «§أَفْطَرَ الْحَاجِمُ وَالْمَحْجُومُ» خَالَفَهُمْ عَبْدُ اللهِ بْنُ لَهِيعَةَ بْنِ عُقْبَةَ فَرَوَاهُ عَنْ عَطَاءٍ عَنْ أَبِي الدَّرْدَاءِ رَوَاهُ عَنْهُ الْوَلِيدِ بْنِ مُسْلِمٍ خَالَفَهُمْ فِطْرُ بْنُ خَلِيفَةَ إِنْ كَانَ قَبِيصَةُ حَفِظَ عَنْهُ فَرَوَاهُ عَنْ عَطَاءٍ عَنِ ابْنِ عَبَّاسٍ","The Book of Fasting"
"3182","أَنْبَأَ عَلِيُّ بْنُ حُجْرٍ ، قَالَ : أَنْبَأَ إِسْمَاعِيلُ ، عَنْ هِشَامٍ ، عَنِ ابْنِ سِيرِينَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا دُعِيَ أَحَدُكُمْ إِلَى الدَّعْوَةِ فَلْيُجِبْ ، فَإِنْ كَانَ صَائِمًا فَلْيُصَلِّ ، وَإِنْ كَانَ مُفْطِرًا فَلْيَطْعَمْ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : يُصَلِّي مَعْنَاهُ يَدْعُو""","","Sunan al-Kubra al-Nasai 3182","","أَخْبَرَنَا عُقْبَةُ بْنُ قَبِيصَةَ قَالَ حَدَّثَنِي أَبِي قَالَ حَدَّثَنَا فِطْرٌ عَنْ عَطَاءٍ عَنِ ابْنِ عَبَّاسٍ قَالَ","The Book of Fasting"
"3183","أَنْبَأَ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا عَبْثَرٌ وَهُوَ ابْنُ الْقَاسِمِ ، أَبُو زُبَيْدٍ كُوفِيٌّ ثِقَةٌ ، عَنْ سُلَيْمَانَ التَّيْمِيِّ ، عَنْ أَبِي الْعَلاءِ بْنِ الشِّخِّيرِ ، عَنْ عَائِشَةَ ،  أَنَّهَاصَامَتْ فِي رَمَضَانَ فَاجْتَهَدَتْ فَأَمَرَهَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ تُفْطِرَ """"""","","Sunan al-Kubra al-Nasai 3183","","أَخْبَرَنَا أَحْمَدُ بْنُ الْأَزْهَرِ النَّيْسَابُورِيُّ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ قَالَ حَدَّثَنَا فِطْرٌ عَنْ عَطَاءٍ قَالَ كُنَّا","The Book of Fasting"
"3184","أَنْبَأَ مُحَمَّدُ بْنُ عَمْرِو بْنِ حَنَانِ حِمْصِيٌّ ، قَالَ : حَدَّثَنَا بَقِيَّةُ ، قَالَ : حَدَّثَنِي يَزِيدُ بْنُ هَارُونَ ، عَنْ سُلَيْمَانَ التَّيْمِيِّ ، عَنْ أَبِي الْعَلاءِ ، عَنْ عَائِشَةَ ،  أَنَّهَاضَعُفَتْ يَوْمًا عَنْ صَوْمِ رَمَضَانَ فَأَمَرَهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ تَقْضِيَ مَكَانَهُ يَوْمَيْنِ """"""","","Sunan al-Kubra al-Nasai 3184","","أَخْبَرَنِي هَارُونُ بْنُ عَبْدِ اللهِ قَالَ أَخْبَرَنَا أَبُو مَالِكٍ بِشْرُ بْنُ الْحَسَنِ ثِقَةٌ أَخُو حُسَيْنِ بْنِ حَسَنٍ قَالَ حَدَّثَنَا ابْنُ جُرَيْجٍ عَنْ عَطَاءٍ عَنِ ابْنِ عَبَّاسٍ","The Book of Fasting"
"3185","أَنْبَأَ مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ : حَدَّثَنَا عَبْدُ الأَعْلَى ، قَالَ : حَدَّثَنَا خَالِدٌ ، عَنْ أَبِي الْعَلاءِ ، عَنْ عَائِشَةَ ، أَنَّهَا قَالَتْ : أَفْطَرْتُ يَوْمًا فَأُمِرْتُ أَنْ أَقْضِيَ يَوْمًا "" ، أَوْ قَالَتْ : "" يَوْمَيْنِ ""، قَالَ خَالِدٌ : وَأَنَا أَجْرَأُ عَلَى يَوْمَيْنِ""","","Sunan al-Kubra al-Nasai 3185","","أَخْبَرَنَا مُحَمَّدُ بْنُ حَاتِمٍ قَالَ أَخْبَرَنَا حِبَّانُ قَالَ أَخْبَرَنَا عَبْدُ اللهِ عَنِ الْحَسَنِ بْنِ يَحْيَى عَنِ الضَّحَّاكِ عَنِ ابْنِ عَبَّاسٍ أَنَّهُ «§لَمْ يَكُنْ يَرَى بِالْحِجَامَةِ لِلصَّائِمِ بَأْسًا» قَالَ أَبُو عَبْدِ الرَّحْمَنِ الضَّحَّاكُ لَمْ يَسْمَعْ مِنَ ابْنِ عَبَّاسٍ وَحَدِيثُ بِشْرِ بْنِ حَسَنٍ عِنْدِي وَاللهُ أَعْلَمُ وَهْمٌ وَلَعَلَّهُ أَنْ يَكُونَ أَرَادَ","The Book of Fasting"
"3186","أَنْبَأَ مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ : حَدَّثَنَا عَبْدُ الْوَهَّابِ ، قَالَ : حَدَّثَنَا خَالِدٌ ، عَنْ يَزِيدَ بْنِ عَبْدِ اللَّهِ بْنِ الشِّخِّيرِ ، أَنَّ عَائِشَةَصَامَتْ يَوْمًا فَجَهَدَهَا الصَّوْمُ فَأَفْطَرَتْ ، فَقَالَتْ حَفْصَةُ : لأَذْكُرَنَّ ذَلِكَ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَتْ عَائِشَةُ : لا تَفْعَلِي حَتَّى أَكُونَ أَنَا أَذْكُرُهُ لَهُ ، فَأَحْسِبُهُ أَمَرَهَا أَنْ تَصُومَ يَوْمًا أَوْ يَوْمَيْنِ","","Sunan al-Kubra al-Nasai 3186","","أَخْبَرَنَا أَحْمَدُ بْنُ نَصْرٍ النَّيْسَابُورِيُّ قَالَ حَدَّثَنَا عُبَيْدُ اللهِ بْنُ مُوسَى عَنِ ابْنِ جُرَيْجٍ عَنْ عَطَاءٍ عَنِ ابْنِ عَبَّاسٍ","The Book of Fasting"
"3187","أَنْبَأَ إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أَنْبَأَ عيسَى بْنُ يُونُسَ ، قَالَ : حَدَّثَنَا عَوْفٌ ، عَنْ مُحَمَّدٍ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : إِذَا أَكَلَ الصَّائِمُ نَاسِيًا أَوْ شَرِبَ نَاسِيًا فَلْيُتِمَّ صِيَامَهُ فَإِنَّمَا أَطْعَمُهُ اللَّهُ وَسَقَاهُ "". أَنْبَأَ إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أَنْبَأَ عِيسَى بْنُ يُونُسَ ، عَنْ هِشَامٍ ، عَنْ مُحَمَّدٍ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ""","","Sunan al-Kubra al-Nasai 3187","","أَخْبَرَنَا حُمَيْدُ بْنُ مَسْعَدَةَ البَصْرِيٌّ عَنْ سُفْيَانَ عَنِ ابْنِ جُرَيْجٍ عَنْ عَطَاءٍ","The Book of Fasting"
"3188","أَنْبَأَ يُوسُفُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنِي عَلِيُّ بْنُ بَكَّارٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي هُرَيْرَةَ ، رَفَعَهُ فِيالرَّجُلِ يَأْكُلُ فِي شَهْرِ رَمَضَانَ نَاسِيًا ، قَالَ :  اللَّهُ أَطْعَمُهُ وَسَقَاهُ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : هَذَا حَدِيثٌ مُنْكَرٌ مِنْ حَدِيثِ مُحَمَّدِ بْنِ عَمْرٍو""","","Sunan al-Kubra al-Nasai 3188","","أَخْبَرَنِي سُلَيْمَانُ بْنُ أَيُّوبَ بْنِ سُلَيْمَانَ دِمَشْقِيٌّ قَالَ حَدَّثَنَا يَزِيدُ وَهُوَ الدِّمَشْقِيُّ قَالَ حَدَّثَنَا الْوَلِيدُ قَالَ ابْنُ عَمْرٍو الْأَوْزَاعِيُّ حَدَّثَنِي يَحْيَى بْنُ أَبِي كَثِيرٍ قَالَ حَدَّثَنِي عَطَاءٌ قَالَ","The Book of Fasting"
"3189","أَنْبَأَ عَمْرُو بْنُ مَنْصُورٍ ، قَالَ : حَدَّثَنَا أَبُو ُنعَيْمٍ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، عَنْ أَبِي الْمُطَوِّسِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ أَفْطَرَ يَوْمًا مِنْ رَمَضَانَ مِنْ غَيْرِ مَرَضٍ وَلا رُخْصَةٍ لَمْ يَقْضِهِ صِيَامُ الدَّهْرِ كُلِّهِ إِنْ صَامَهُ """"""","","Sunan al-Kubra al-Nasai 3189","","أَخْبَرَنِي شُعَيْبُ بْنُ شُعَيْبِ بْنِ إِسْحَاقَ دِمَشْقِيٌّ قَالَ حَدَّثَنَا أَبُو الْمُغِيرَةِ قَالَ حَدَّثَنَا الْأَوْزَاعِيُّ عَنْ عَطَاءٍ عَنِ ابْنِ عَبَّاسٍ","The Book of Fasting"
"3190","أَنْبَأَ مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ : حَدَّثَنَا يَحْيَى ، وعَبْدُ الرَّحْمَنِ ، قَالا : حَدَّثَنَا سُفْيَانُ ثُمَّ ذَكَرَ كَلِمَةَ مَعْنَاهَا ، عَنْ حَبِيبٍ ، قَالَ : حَدَّثَهُ أَبُو الْمُطَوِّسِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ أَفْطَرَ يَوْمًا مِنْ رَمَضَانَ مِنْ غَيْرِ رُخْصَةٍ وَلا مَرَضٍ ، لَمْ يَقْضِ عَنْهُ صِيَامُ الدَّهْرِ وَإِنْ صَامَهُ """"""","","Sunan al-Kubra al-Nasai 3190","","أَخْبَرَنَا هَنَّادُ بْنُ السَّرِيِّ عَنِ ابْنِ أَبِي زَائِدَةَ قَالَ حَدَّثَنَا ابْنُ إِسْحَاقَ عَنْ أَبَانَ بْنِ صَالِحٍ عَنْ مُجَاهِدٍ وَعَطَاءٍ عَنِ ابْنِ عَبَّاسٍ قَالَ","The Book of Fasting"
"3191","أَنْبَأَ مَحْمُودُ بْنُ غَيْلانَ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، وَأَبُو دَاوُدَ ، عَنِ الثَّوْرِيِّ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، عَنِ أَبِي الْمُطَوِّسِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ أَفْطَرَ يَوْمًا مِنْ رَمَضَانَ مِنْ غَيْرِ عُذْرٍ وَلا رُخْصَةٍ لَمْ يَقْضِهِ ، وَإِنْ صَامَ الدَّهْرَ كُلَّهُ ""، قَالَ عَبْدُ الرَّزَّاقِ فِيهِ : "" مِنْ غَيْرِ مَرَضٍ "" ذِكْرُ الاخْتِلافِ عَلَى شُعْبَةَ""","","Sunan al-Kubra al-Nasai 3191","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا سُفْيَانُ عَنْ عَمْرٍو عَنْ طَاوُسٍ وَعَطَاءٍ عَنِ ابْنِ عَبَّاسٍ","The Book of Fasting"
"3192","أَنْبَأَ مُؤَمَّلُ بْنُ هِشَامٍ ، قَالَ : حَدَّثَنَا إسْمَاعِيلُ ، عَنْ شُعْبَةَ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، عَنْ عُمَارَةَ بْنِ عُمَيْرٍ ، عَنِ أَبِي الْمُطَوِّسِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ أَفْطَرَ يَوْمًا مِنْ رَمَضَانَ مِنْ غَيْرِ رُخْصَةٍ رَخَّصَهَا اللَّهُ لَهُ لَمْ يَقْضِ عَنْهُ صَوْمُ الدَّهْرِ """"""","","Sunan al-Kubra al-Nasai 3192","","أَخْبَرَنَا مُحَمَّدُ بْنُ مَنْصُورٍ مَكِّيٌّ عَنْ سُفْيَانَ قَالَ أَخْبَرَنَا عَمْرٌو قَالَ سَمِعْتُ عَطَاءً قَالَ","The Book of Fasting"
"3193","أَنْبَأَ أَحْمَدُ بْنُ عَبْدِ اللَّهِ بْنِ الْحَكَمِ بَصْرِيٌّ ، عَنْ مُحَمَّدٍ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، عَنْ عُمَارَةَ بْنِ عُمَيْرٍ ، عَنِ أَبِي الْمُطَوِّسِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ أَفْطَرَ يَوْمًا مِنْ رَمَضَانَ مِنْ غَيْرِ رُخْصَةٍ لَمْ يَقْضِ عَنْهُ صِيَامُ الدَّهْرِ """"""","","Sunan al-Kubra al-Nasai 3193","","أَخْبَرَنَا مُحَمَّدُ بْنُ مَعْدَانَ بْنِ عِيسَى قَالَ حَدَّثَنَا الْحَسَنُ بْنُ أَعْيَنَ قَالَ حَدَّثَنَا مَعْقِلٌ عَنْ عَطَاءٍ عَنِ ابْنِ عَبَّاسٍ قَالَ","The Book of Fasting"
"3194","أَنْبَأَ مَحْمُودُ بْنُ غَيْلانَ ، قَالَ : حَدَّثَنَا أَبُو َداوُدَ ، قَالَ : أَنْبَأَ شُعْبَةُ ، قَالَ : أَخْبَرَنِي حَبِيبٌ ، قَالَ : سَمِعْتُ عُمَارَةَ بْنَ عُمَيْرٍ يُحَدِّثُ ، عَنْ أَبِي الْمُطَوِّسِ ، قَالَ : وَقَدْ رَأَيْتُ أَبَا الْمُطَوِّسِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ أَفْطَرَ يَوْمًا مِنْ رَمَضَانَ مِنْ غَيْرِ رُخْصَةٍ اللَّهُ لَمْ يَقْضِ عَنْهُ وَإِنْ صَامَ الدَّهْرَ كُلَّهُ """"""","","Sunan al-Kubra al-Nasai 3194","","أَخْبَرَنَا عِيسَى بْنُ حَمَّادٍ قَالَ أَخْبَرَنَا اللَّيْثُ قَالَ حَدَّثَنِي أَبُو الزُّبَيْرِ عَنْ عَطَاءٍ عَنِ ابْنِ عَبَّاسٍ","The Book of Fasting"
"3195","أَخْبَرَنِي هِلالُ بْنُ الْعَلاءِ ، قَالَ : حَدَّثَنَا أَبِي ، قَالَ : حَدَّثَنَا عُبَيْدُ اللَّهِ ، عَنْ زَيْدٍ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، عَنْ عَلِيِّ بْنِ الْحُسَيْنِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّرَجُلا أَفْطَرَ فِي شَهْرِ رَمَضَانَ فَأَتَى أَبَا هُرَيْرَةَ ، فَقَالَ :  لا يُقْبَلُ مِنْهُ صَوْمُ سَنَةٍ ""وَقَفَهُ عَبْدُ الرَّحْمَنِ ، عَنْ يَعْقُوبَ""","","Sunan al-Kubra al-Nasai 3195","","أَخْبَرَنَا الْحَسَنُ بْنُ إِسْحَاقَ قَالَ حَدَّثَنَا رَوْحُ بْنُ عِبَادَةَ قَالَ حَدَّثَنَا سَعِيدُ بْنُ أَبِي عَرُوبَةَ عَنْ مَطَرٍ عَنْ بَكْرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ عَنْ أَبِي رَافِعٍ قَالَ","The Book of Fasting"
"3196","أَخْبَرَنِي زَكَرِيَّا بْنُ يَحْيَى ، قَالَ : حَدَّثَنَا عُمَرُ ْبنُ مُحَمَّدِ بْنِ الْحَسَنِ ، قَالَ : حَدَّثَنَا أَبِي ، قَالَ : حَدَّثَنَا شَرِيكٌ ، عَنِ الْعَلاءِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : مَنْ أَفْطَرَ يَوْمًا مِنْ رَمَضَانَ لَمْ يَقْضِهِ يَوْمٌ مِنْ أَيَّامِ الدُّنْيَا """"""","","Sunan al-Kubra al-Nasai 3196","","","The Book of Fasting"
"3197","أَخْبَرَنِي مَحْمُودُ بْنُ خَالِدٍ ، قَالَ : حَدَّثَنَا الْوَلِيدُ ، قَالَ : حَدَّثَنَا ابْنُ جَابِرٍ ، قَالَ : حَدَّثَنِي سُلَيْمُ بْنُ عَامِرٍ ، قَالَ : حَدَّثَنِي أَبُو أُمَامَةَ ، قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : بَيْنَمَا أَنَا نَائِمٌ إِذْ أَتَانِي رَجُلانِ فَأَخَذَا بِضَبْعَيَّ ""  ، وَسَاقَ الْحَدِيثَ ، وَقَالَ فِيهِ : "" ثُمَّ انْطَلَقَا بِي فَإِذَا قَوْمٌ مُعَلَّقُونَ بِعَرَاقِيبِهِمْ ، مُشَقَّقَةٌ أَشْدَاقُهُمْ تُسِّيلُ أَشَدَاقُهُمْ دَمًا ، قُلْتُ : "" مَنْ هَؤُلاءِ ؟ "" قَالَ : هَؤُلاءِ الَّذِينَ يُفْطِرُونَ قَبْلَ تَحِلَّةِ صَوْمِهِمْ ، فَقَالَ : خَابَتِ الْيَهُودُ ، وَالنَّصَارَى ""، قَالَ سُلَيْمٌ : فَلا أَدْرِي شَيْءٌ سَمِعَهُ أَبُو أُمَامَةَ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَوْ شَيْءٌ مِنْ رَأْيِهِ ؟ مُخْتَصَرٌ""","","Sunan al-Kubra al-Nasai 3197","","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ قَالَ حَدَّثَنَا عَبْدُ الْأَعْلَى قَالَ حَدَّثَنَا سَعِيدٌ عَنْ بَعْضِ أَصْحَابِهِ عَنْ ابْنِ بُريدَةَ عَنْ أَبِي مُوسَى","The Book of Fasting"
"3198","أَنْبَأَ عَبْدُ اللَّهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، قَالَ : حَدَّثَنَا أَبُو الزِّنَادِ ، عَنْ مُوسَى بْنِ أَبِي عُثْمَانَ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : لا تَصُومُ الْمَرْأَةُ وَزَوْجُهَا شَاهِدٌ يَوْمًا مِنْ غَيْرِ شَهْرِ رَمَضَانَ إِلا بِإِذْنِهِ ""خَالَفَهُ قُتَيْبَةُ بْنُ سَعِيدٍ""","","Sunan al-Kubra al-Nasai 3198","","أَخْبَرَنَا أَحْمَدُ بْنُ الْأَزْهَرِ قَالَ حَدَّثَنَا سَعِيدُ بْنُ عَامِرٍ عَنْ سَعِيدٍ عَنْ صَاحِبٍ لَهُ عَنْ عَبْدِ اللهِ بْنِ بُرَيْدَةَ قَالَ","The Book of Fasting"
"3199","أَنْبَأَ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، عَنْ أَبِي الزِّنَادِ ، عَنِ الأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : لا تَصُومُ الْمَرْأَةُ وَزَوْجُهَا شَاهِدٌ يَوْمًا مِنْ غَيْرِ شَهْرِ رَمَضَانَ إِلا بِإِذْنِهِ ""أَرْسَلَهُ جَعْفَرُ بْنُ رَبِيعَةَ""","","Sunan al-Kubra al-Nasai 3199","","أَخْبَرَنَا حُسَيْنُ بْنُ مَنْصُورٍ النَّيْسَابُورِيُّ قَالَ حَدَّثَنَا حَفْصٌ قَالَ حَدَّثَنَا سَعِيدُ بْنُ أَبِي عَرُوبَةَ عَنْ أَبِي مَالِكٍ عَنْ ابن بُريدَةَ قَالَ","The Book of Fasting"
"3200","أَنْبَأَ الرَّبِيعُ بْنُ سُلَيْمَانَ ، قَالَ : حَدَّثَنَا شعَيْبُ بْنُ اللَّيْثِ ، عَنِ اللَّيْثِ ، عَنْ جَعْفَرِ بْنِ رَبِيعَةَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ هُرْمُزَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا تَصُومُ الْمَرْأَةُ وَزَوْجُهَا شَاهِدٌ إِلا بِإِذْنِهِ """"""","","Sunan al-Kubra al-Nasai 3200","","أَخْبَرَنَا أَبُو بَكْرِ بْنُ عَلِيٍّ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ بَشَّارٍ قَالَ حَدَّثَنَا عَبْدُ الرَّحْمَنِ عَنْ شُعْبَةَ عَنْ قَتَادَةَ عَنْ بَكْرِ بْنِ عَبْدِ اللهِ عَنْ أَبِي رَافِعٍ قَالَ","The Book of Fasting"
"3201","أَنَا الرَّبِيعُ بْنُ سُلَيْمَانَ ، قَالَ : حَدَّثَنَا ابْنُ وَهْبٍ ، قَالَ : أَخْبَرَنِي حَيْوَةُ ، وَعُمَرُ بْنُ مَالِكٍ ، عَنِ ابْنِ الْهَادِ ، قَالَ : حَدَّثَنِي زُمَيْلٌ مَوْلَى عُرْوَةَ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، قَالَتْ : أُهْدِيَ لِي وَلِحَفْصَةَ طَعَامٌ ، وَكُنَّا صَائِمَتَيْنِ فَأَفْطَرْنَا ، ثُمَّ دَخَلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقُلْنَا : يَا رَسُولَ اللَّهِ ، إِنَّا أُهْدِيَتْ لَنَا هَدِيَّةٌ فَاشْتَهَيْنَاهَا فَأَفْطَرْنَا ، فَقَالَ : لا عَلَيْكُمَا صُومَا يَوْمًا آخَرَ مَكَانَهُ ""ذِكْرُ الاخْتِلافِ عَلَى الزُّهْرِيِّ فِي هَذَا الْحَدِيثِ""","","Sunan al-Kubra al-Nasai 3201","","أَخْبَرَنَا حُمَيْدُ بْنُ مَسْعَدَةَ قَالَ حَدَّثَنَا بِشْرٌ قَالَ حَدَّثَنَا حُمَيْدٌ عَنْ بَكْرٍ عَنْ أَبِي الْعَالِيَةِ","The Book of Fasting"
"3202","أَنْبَأَ إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أَنْبَأَ كثِيرُ بْنُ هِشَامٍ ، قَالَ : حَدَّثَنَا جَعْفَرُ بْنُ بُرْقَانَ ، قَالَ : حَدَّثَنَا الزُّهْرِيُّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، قَالَتْ : كُنْتُ أَنَا وَحَفْصَةُ صَائِمَتَيْنِ ، فَعَرَضَ لَنَا طَعَامٌ فَاشْتَهَيْنَاهُ فَأَفْطَرْنَا ، فَدَخَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَبَادَرَتْ إِلَيْهِ حَفْصَةُ وَكَانَتِ ابْنَةَ أَبِيهَا ، فَقَالَتْ : يَا رَسُولَ اللَّهِ ، إِنَّا أَصْبَحْنَا الْيَوْمَ صَائِمَتَيْنِ فَعَرَضَ لَنَا طَعَامٌ فَاشْتَهَيْنَاهُ ، فَقَالَ : اقْضِيَا يَوْمًا آخَرَ """"""","","Sunan al-Kubra al-Nasai 3202","","أَخْبَرَنَا بِشْرُ بْنُ هِلاَلٍ قَالَ حَدَّثَنَا عَبْدُ الْوَارِثِ قَالَ حَدَّثَنَا أَيُّوبُ عَنْ عِكْرِمَةَ عَنِ ابْنِ عَبَّاسٍ","The Book of Fasting"
"3203","أَنْبَأَ مُحَمَّدُ بْنُ الْمُثَنَّى ، عَنْ يَزِيدَ ، قَالَ : أَنْبَأَ سُفْيَانُ بْنُ حُسَيْنٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، قَالَتْ : أُهْدِيَتْ لِحَفْصَةَ شَاةٌ وَنَحْنُ صَائِمَتَانِ فَأَفْطَرَتْنِي وَكَانَتِ ابْنَةَ أَبِيهَا ، فَلَمَّا دَخَلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَيْنَا ذَكَرْنَا ذَلِكَ لَهُ ، فَقَالَ : أَبْدِلا يَوْمًا مَكَانَهُ "". أَنْبَأَ مُحَمَّدُ بْنُ مَنْصُورٍ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، قَالَ : سَمِعْنَاهُ مِنْ صَالِحِ بْنِ أَبِي الأَخْضَرِ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ أَصْبَحْتُ أَنَا وَحَفْصَةُ صَائِمَتَيْنِ فَأُهْدِيَ لَنَا طَعَامٌ مَحْرُوصٌ عَلَيْهِ ، قَالَ : وَحَدَّثَنَا سُفْيَانُ ، قَالَ : وَأَنَا شَاهِدٌ أَهُوَ سَأَلُوا الزُّهْرِيَّ عَنْ عُرْوَةَ ؟ قَالَ : لا . قَالَ أَبُو عَبْدِ الرَّحْمَنِ : الصَّوَابُ مَا رَوَى ابْنُ عُيَيْنَةَ عَنِ الزُّهْرِيُّ ، وَصَالِحُ بْنُ أَبِي الأَخْضَرِ ضَعِيفٌ فِي الزُّهْرِيِّ وَفِي غَيْرِ الزُّهْرِيِّ ، وَسُفْيَانُ بْنُ حُسَيْنٍ ، وَجَعْفَرُ بْنُ بُرْقَانَ لَيْسَا بِالْقَوِّيَيْنِ فِي الزُّهْرِيِّ ، وَلا بَأْسَ بِهِمَا فِي غَيْرِ الزُّهْرِيِّ""","","Sunan al-Kubra al-Nasai 3203","","أَخْبَرَنَا أَبُو بَكْرِ بْنُ عَلِيٍّ قَالَ حَدَّثَنَا سُرَيْجٌ قَالَ حَدَّثَنَا عَبْدُ اللهِ بْنُ رَجَاءٍ عَنْ هِشَامٍ عَنْ عِكْرِمَةَ عَنِ ابْنِ عَبَّاسٍ","The Book of Fasting"
"3204","أَنْبَأَ مُحَمَّدُ بْنُ سَهْلِ بْنِ عَسْكَرٍ ، قَالَ : حَدَّثَنَا ابْنُ أَبِي مَرْيَمَ ، قَالَ : أَنْبَأَ يَحْيَى بْنُ أَيُّوبَ ، عَنْ إِسْمَاعِيلَ بْنِ عُقْبَةَ ، قَالَ : وَعِنْدِي فِي مَوْضِعٍ آخَرَ : إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ، عَنِ ابْنِ شِهَابٍ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ أَنَّهُ أُهْدِيَ لَهَا وَلِحَفْصَةَ طَعَامٌ ، وَهُمَا صَائِمَتَانِ فَأَفْطَرَتَا عَلَيْهِ ، فَسَأَلَتْ حَفْصَةُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَكَانَتِ ابْنَةَ عُمَرَ ، فَأَمَرَهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  أَنْتَصُومَ يَوْمًا مَكَانَهُ ""، قَالَ يَحْيَى بْنُ أَيُّوبَ : وَسَمِعْتُ صَالِحَ بْنَ كَيْسَانَ ، بِمِثْلِهِ ، وَجَدْتُهُ عِنْدِي فِي مَوْضِعٍ آخَرَ : حَدَّثَنِي صَالِحُ بْنُ كَيْسَانَ ، وَيَحْيَى بْنُ سَعِيدٍ مِثْلَهُ ، وَهَذَا أَيْضًا خَطَأٌ""","","Sunan al-Kubra al-Nasai 3204","","أَخْبَرَنَا بِشْرُ بْنُ هِلَالٍ قَالَ حَدَّثَنَا عَبْدُ الْوَارِثِ قَالَ حَدَّثَنَا أَيُّوبُ عَنْ عِكْرِمَةَ عَنِ ابْنِ عَبَّاسٍ","The Book of Fasting"
"3205","أَخْبَرَنَا أَحْمَدُ بْنُ عِيسَى ، عَنِ ابْنِ وَهْبٍ ، عَنْ جَرِيرِ بْنِ حَازِمٍ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ عَمْرَةَ ، عَنْ عَائِشَةَ ، قَالَتْ : أَصْبَحْتُ صَائِمَةً أَنَا وَحَفْصَةَ ، أُهْدِيَ لِنَا طَعَامٌ ، فَأَعْجَبَنَا ، فَأَفْطَرْنَا ، فَدَخَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَبَدَرَتْنِي حَفْصَةُ ، فَسَأَلَتْهُ ، فَقَالَ : صُومَا يَوْمًا مَكَانَهُ قَالَ أَبُو عَبْدِ الرَّحْمَنِ : هُمَا جَمِيعًا خَطَأٌ ""، أَرْسَلَهُ مَعْمَرٌ . أَنْبَأَ مُحَمَّدُ بْنُ حَاتِمٍ ، قَالَ : أنبأ سُوَيْدٌ ، قَالَ : أنبأ عَبْدُ اللَّهِ ، عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : قَالَتْ عَائِشَةُ : أَصْبَحْتُ أَنَا وَحَفْصَةُ ، صَائِمَتَيْنِ وَسَاقَ الْحَدِيثَ""","","Sunan al-Kubra al-Nasai 3205","","أَخْبَرَنَا مُحَمَّدُ بْنُ مَعْمَرٍ قَالَ حَدَّثَنَا حِبَّانُ قَالَ حَدَّثَنَا وُهَيْبٌ عَنْ أَيُّوبَ عَنْ عِكْرِمَةَ عَنِ ابْنِ عَبَّاسٍ","The Book of Fasting"
"3206","أَنْبَأَ عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا يَحْيَى ، قَالَ : حَدَّثَنَا عُبَيْدُ اللَّهِ ، قَالَ : حَدَّثَنِي الزُّهْرِيُّ ، أَنَّ عَائِشَةَ ، وَحَفْصَةَ صَامَتَا يَوْمًا تَطَوُّعًا فَأَفْطَرَتَا ، قَالَتْ عَائِشَةُ : فَأَرَدْنَا أَنْ نَسْأَلَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَبَادَرَتْنِي حَفْصَةُ وَكَانَتِ ابْنَةَ أَبِيهَا فَسَأَلَتْ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَأَمَرَهَا بِقَضَاءِ ذَلِكَ الْيَوْمِ"" مُرْسَلا "" ، الْحَارِثُ بْنُ مِسْكِينٍ قِرَاءَةً عَلَيْهِ وَأَنَا أَسْمَعُ ، عَنِ ابْنِ الْقَاسِمِ ، قَالَ : حَدَّثَنِي مَالِكٌ ، عَنِ ابْنِ شِهَابٍ ، أَنَّ عَائِشَةَ ، وَحَفْصَةَ ، نَحْوَهُ مُرْسَلٌ""","","Sunan al-Kubra al-Nasai 3206","","أَخْبَرَنَا قَطَنُ بْنُ إِبْرَاهِيمَ النَّيْسَابُورِيُّ قَالَ حَدَّثَنَا الْحُسَيْنُ بْنُ الْوَلِيدِ النَّيْسَابُورِيُّ قَالَ حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ عَنْ أَيُّوبَ عَنْ عِكْرِمَةَ عَنِ ابْنِ عَبَّاسٍ قَالَ","The Book of Fasting"
"3207","أَنْبَأَ أَحْمَدُ بْنُ عِيسَى ، عَنِ ابْنِ وَهْبٍ ، عَنْ جَرِيرِ بْنِ حَازِمٍ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، قَالَتْ : أَصْبَحْتُ صَائِمَةً أَنَا وَحَفْصَةُ ، فَأُهْدِيَ لَنَا طَعَامٌ فَأَعْجَبَنَا فَأَفْطَرْنَا ، فَدَخَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَبَادَرَتْنِي حَفْصَةُ فَسَأَلَتْهُ ، فَقَالَ : صُومَا يَوْمًا مَكَانَهُ """"""","","Sunan al-Kubra al-Nasai 3207","","أَخْبَرَنِي أَبُو بَكْرِ بْنُ عَلِيٍّ قَالَ حَدَّثَنَا الْقَوَارِيرِيُّ قَالَ حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ عَنْ أَيُّوبَ عَنْ عِكْرِمَةَ","The Book of Fasting"
"3208","أَنْبَأَ مُحَمَّدُ بْنُ مَنْصُورٍ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، عَنْ طَلْحَةَ بْنِ يَحْيَى ، عَنْ عَمَّتِهِ عَائِشَةَ بِنْتِ طَلْحَةَ ، عَنْ عَائِشَةَ ، قَالَت : دَخَلَ عَلَيْنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقُلْنَا : إِنَّ عِنْدَنَا حَيْسًا قَدْ خَبَأْنَاهُ لَكَ ، قَالَ :  قَرِّبُوهُ "" ، فَأَكَلَ ، وَقَالَ : "" إِنِّيقَدْ كُنْتُ أَرَدْتُ الصَّوْمَ وَلَكِنْ أَصُومُ يَوْمًا مَكَانَهُ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : هَذَا اللَّفْظُ خَطَأ ، قَدْ رَوَى هَذَا الْحَدِيثَ جَمَاعَةٌ ، عَنْ طَلْحَةَ فَلَمْ يَذْكُرْ أَحَدٌ مِنْهُمْ "" وَلَكِنْ أَصُومُ يَوْمًا مَكَانَهُ "" ، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : هَذَا اللَّفْظُ خَطَأٌ ، قَدْ رَوَى هَذَا الْحَدِيثُ جَمَاعَةٌ ، عَنْ طَلْحَةَ ، فَلَمْ يَذْكُرْ أَحَدٌ مِنْهُمْ : "" وَلَكِنْ أَصُومُ يَوْمًا مَكَانَهُ """"""","","Sunan al-Kubra al-Nasai 3208","","أَخْبَرَنَا مُحَمَّدُ بْنُ حَاتِمٍ قَالَ أَخْبَرَنَا حِبَّانُ قَالَ أَخْبَرَنَا عَبْدُ اللهِ عَنْ مَعْمَرٍ عَنْ أَيُّوبَ عَنْ عِكْرِمَةَ","The Book of Fasting"
"3209","أَنْبَأَ عَلِيُّ بْنُ عُثْمَانَ ، قَالَ : حَدَّثَنَا الْمُعَافَى بْنُ سُلَيْمَانَ ، قَالَ : حَدَّثَنَا خَطَّابُ بْنُ الْقَاسِمِ ، عَنْ خُصَيْفٍ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ دَخَلَ عَلَى حَفْصَةَ ، وَعَائِشَةَ وَهُمَا صَائِمَتَانِ ، ثُمَّ خَرَجَ فَرَجَعَ وَهُمَا تَأْكُلانِ ، فَقَالَ :  أَلَمْ تَكُونَا صَائِمَتَيْنِ ؟ "" قَالَتَا : بَلَى ، وَلَكِنْ أُهْدِيَ لَنَا طَعَامٌ فَأَعْجَبَنَا فَأَكَلْنَا مِنْهُ ، قَالَ : ""صُومَا يَوْمًا مَكَانَهُ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : هَذَا الْحَدِيثُ مُنْكَرٌ وَخُصَيْفٌ ضَعِيفٌ فِي الْحَدِيثِ ، وَخَطَّابٌ لا عِلْمَ لِي بِهِ ، وَالصَّوَابُ حَدِيثُ مَعْمَرٍ ، وَمَالِكٍ ، وَعُبَيْدِ اللَّهِ""","","Sunan al-Kubra al-Nasai 3209","","أَخْبَرَنَا عَلِيُّ بْنُ حُجْرٍ قَالَ أَخْبَرَنَا إِسْمَاعِيلُ عَنْ أَيُّوبَ عَنْ عِكْرِمَةَ قَالَ","The Book of Fasting"
"3210","أَنْبَأَ مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنْ جَعْدَةَ ، عَنْ أُمِّ هَانِئٍ وَهِيَ جَدَّتُهُ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ دَخَلَ عَلَيْهَا يَوْمَ الْفَتْحِ فَأُتِيَ بِإِنَاءٍ فَشَرِبَ ، ثُمَّ نَاوَلَنِي ، فَقُلْتُ : إِنِّي صَائِمَةٌ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : الْمُتَطَوِّعُ أَمِيرُ نَفْسِهِ ، فَإِنْ شِئْتِ فَصُومِي ، وَإِنْ شِئْتِ فَأَفْطِرِي ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : لَمْ يَسْمَعْهُ جَعْدَةُ مِنْ أُمِّ هَانِئٍ . أَنْبَأَ مُحَمَّدُ بْنُ الْمُثَنَّى ، عَنْ أَبِي دَاوُدَ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، قَالَ : أَخْبَرَنِي جَعْدَةُ ، عَنْ جَدَّتِهِ أُمِّ هَانِئٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ دَخَلَ عَلَيْهَا وَذَكَرَ الْحَدِيثَ ، قُلْتُ لَهُ : أَسَمِعْتَهُ مِنْ أُمِّ هَانِئٍ ، قَالَ : حَدَّثَنَاهُ أَهْلُنَا ، وَأَبُو صَالِحٍ ، عَنْ أُمِّ هَانِئٍ ، قَالَ شُعْبَةُ : وَكَانَ سِمَاكٌ يَقُولُ : حَدَّثَنِي ابْنَا أُمِّ هَانِئٍ فَرَوَيْتُهُ أَنَا عَنْ أَفْضَلِهِمَا ذِكُرُ حَدِيثِ سِمَاكٍ""","","Sunan al-Kubra al-Nasai 3210","","أَخْبَرَنَا أَحْمَدُ بْنُ سَعْدِ بْنِ الْحَكَمِ قَالَ حَدَّثَنَا عَمِّي قَالَ أَخْبَرَنَا يَحْيَى بْنُ أَيُّوبَ قَالَ حَدَّثَنِي جَعْفَرُ بْنُ رَبِيعَةَ","The Book of Fasting"
"3211","أَنْبَأَ مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ : حَدَّثَنَا أَبُو الْوَلِيدِ ، قَالَ : حَدَّثَنَا أَبُو عَوَانَةَ ، عَنْ سِمَاكٍ ، عَنِ ابْنِ أُمِّ هَانِئٍ ، عَنْ جَدَّتِهِ أُمِّ هَانِئٍ سَمِعَهُ مِنْهَا ، أَنَّهَا قَالَتْ : إِنَّ نَبِيَّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أُتِيَ بِشَرَابٍ يَوْمَ فَتْحِ مَكَّةَ فَشَرِبَ ، ثُمَّ نَاوَلَنِي فَشَرِبْتُ ، وَكُنْتُ صَائِمَةً وَكَرِهْتُ أَنْ أَرُدَّ فَضْلَ سُؤْرِهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقُلْتُ : بِأَبِي أَنْتَ إِنِّي كُنْتُ صَائِمَةً ، قَالَ لَهَا : أَكُنْتِ قَضَيْتِ شَيْئًا ؟ "" قَالَتْ : لا ، قَالَ : "" فَلا يَضُرُّكِ """"""","","Sunan al-Kubra al-Nasai 3211","","أَخْبَرَنَا عَمْرُو بْنُ يَزِيدَ قَالَ حَدَّثَنَا بَهْزٌ قَالَ حَدَّثَنَا شُعْبَةُ عَنِ الْحَكَمِ عَنْ مِقْسَمٍ عَنِ ابْنِ عَبَّاسٍ قَالَ","The Book of Fasting"
"3212","أَنْبَأَ الرَّبِيعُ بْنُ سُلَيْمَانَ ، قَالَ : حَدَّثَنَا يحْيَى بْنُ حَسَّانَ ، قَالَ : حَدَّثَنَا حَمَّادٌ ، عَنْ سِمَاكِ بْنِ حَرْبٍ ، عَنْ هَارُونَ بْنِ أُمِّ هَانِئٍ ، عَنْ أُمِّ هَانِئٍ ، قَالَتْ : دَخَلَ عَلَيَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَأَنَا صَائِمَةٌ فَأُتِيَ بِإِنَاءٍ مِنْ لَبَنٍ فَشَرِبَ ثُمَّ نَاوَلَنِي فَشَرِبْتُ ، فَقُلْتُ : يَا رَسُولَ اللَّهِ ، إِنِّي كُنْتُ صَائِمَةً وَلَكِنِّي كَرِهْتُ أَنْ أَرُدَّ سُؤْرَكَ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِنْ كَانَ مِنْ قَضَاءِ رَمَضَانَ فَاقْضِي يَوْمًا مَكَانَهُ ، وَإِنْ كَانَ مِنْ غَيْرِ قَضَاءِ رَمَضَانَ فَإِنْ شِئْتِ فَاقْضِي ، وَإِنْ شِئْتِ فَلا تَقْضِي """"""","","Sunan al-Kubra al-Nasai 3212","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ قَالَ حَدَّثَنَا خَالِدٌ عَنْ شُعْبَةَ عَنْ يَزِيدَ بْنِ أَبِي زِيَادٍ عَنْ مِقْسَمٍ عَنِ ابْنِ عَبَّاسٍ قَالَ","The Book of Fasting"
"3213","أَنْبَأَ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا أَبُو لأَحْوَصِ ، عَنْ سِمَاكٍ ، عَنِ ابْنِ أُمِّ هَانِئٍ ، عَنْ أُمِّ هَانِئٍ ، قَالَتْ : كُنْتُ قَاعِدَةً عِنْدَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَفَأُتِيَ بِشَرَابٍ فَشَرِبَ ثُمَّ نَاوَلَنِي فَشَرِبْتُ مِنْهُ ، فَقُلْتُ : إِنِّي أَذْنَبْتُ فَاسْتَغْفِرْ لِي ، قَالَ :  وَمَا ذَاكَ ؟ "" قَالَتْ : كُنْتُ صَائِمَةً فَأَفْطَرْتُ ، فَقَالَ : "" أَمِنْ قَضَاءٍ كُنْتِ تَقْضِينَهُ ؟ "" ، قَالَتْ : لا ، قَالَ : "" لا يَضُرُّكِ """"""","","Sunan al-Kubra al-Nasai 3213","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى عَنْ مُحَمَّدِ بْنِ جَعْفَرٍ قَالَ حَدَّثَنَا شُعْبَةُ عَنْ يَزِيدَ وَهُوَ بْنُ أَبِي زِيَادٍ عَنْ مِقْسَمٍ عَنِ ابْنِ عَبَّاسٍ قَالَ","The Book of Fasting"
"3214","أَنْبَأَ أَحْمَدُ بْنُ عُثْمَانَ ، قَالَ : حَدَّثَنَا عَمْرٌو ، عَنْ أَسْبَاطٍ ، عَنْ سِمَاكٍ ، عَنْ رَجُلٍ ، عَنْ يَحْيَى بْنِ جَعْدَةَ ، عَنْ أُمِّ هَانِئٍ ، أَنَّهَا قَالَتْ دَخَلَتْ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَوْمَ فَتْحِ مَكَّةَ ،فَأُتِيَ بِشَرَابٍ فَشَرِبَ مِنْهُ ثُمَّ نَاوَلَهَا فَشَرِبَتْ مِنْهُ ، قَالَتْ : إِنِّي كُنْتُ صَائِمَةً وَلَكِنْ كَرِهْتُ أَنْ أَرُدَّ عَلَيْكَ شَرَابَكَ ، قَالَ :  أَكُنْتِ تَقْضِينَ ؟ لا يَضُرُّكِ "". أَنْبَأَ زَكَرِيَّا بْنُ يَحْيَى ، قَالَ : حَدَّثَنَا إِسْحَاقُ ، قَالَ : أَنْبَأَ أَبُو أَيُّوبَ يَحْيَى بْنُ أَبِي الْحَجَّاجِ ، قَالَ : حَدَّثَنَا أَبُو يُونُسَ ، عَنْ سِمَاكٍ ، عَنْ أَبِي صَالِحٍ ، عَنْ أُمِّ هَانِئٍ ، قَالَتْ : كُنْتُ عِنْدَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَأُتِيَ بِإِنَاءٍ فِيهِ شَرَابٌ ثُمَّ نَاوَلَنِي وَكُنْتُ صَائِمَةً فَشَرِبْتُ ، نَحْوَهُ""","","Sunan al-Kubra al-Nasai 3214","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى عَنْ مُحَمَّدٍ قَالَ حَدَّثَنَا شُعْبَةُ عَنِ الْحَكَمِ عَنْ مِقْسَمٍ عَنِ ابْنِ عَبَّاسٍ","The Book of Fasting"
"3215","أَنْبَأَ مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى ، قَالَ : حَدَّثَنَا خَالِدٌ ، قَالَ : حَدَّثَنَا حَاتِمٌ ، عَنْ سِمَاكٍ ، عَنْ أَبِي صَالِحٍ ، قَالَ : لَمَّا افْتَتَحَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَكَّةَ كَانَ أَوَّلَ بَيْتٍ دَخَلَهُ بَيْتُ أُمِّ هَانِئٍ فَدَعَا بِمَاءٍ فَشَرِبَهُ ، وَكَانَتْ أُمُّ هَانِئٍ عَنْ يَمِينِهِ فَدَفَعَ فَضْلَهُ إِلَى أُمِّ هَانِئٍ فَشَرِبَتْهُ أُمُّ هَانِئٍ ، ثُمَّ قَالَتْ : يَا رَسُولَ اللَّهِ ، وَاللَّهِ لَقَدْ فَعَلْتُ فَعْلَةً ، وَاللَّهِ مَا أَدْرِي أَصَبْتُ أَمْ لا ، إِنِّي شَرِبْتُ فَضْلَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَكُنْتُ صَائِمَةً ، فَقَالَ :  أَقَضَاءٌ مِنْ رَمَضَانَ أَوْ تَطَوُّعٍ ؟ "" ، قُلْتُ : يَا رَسُولَ اللَّهِ ، بَلْ تَطَوُّعٌ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : ""إِنَّ الْمُتَطَوِّعَ بِالْخِيَارِ إِنْ شَاءَ صَامَ وَإِنْ شَاءَ أَفْطَرَ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : هَذَا الْحَدِيثُ مُضْطَرِبٌ ، وَالأَوَّلُ مِثْلُهُ ، أَمَّا حَدِيثُ عُرْوَةَ فَمُرْسَلٌ لَيْسَ بِالْمَشْهُورِ ، وَأَمَّا حَدِيثُ الزُّهْرِيِّ الَّذِي أَسْنَدَهُ جَعْفَرُ بْنُ بُرْقَانَ ، وَسُفْيَانُ بْنُ حُسَيْنٍ فَلَيْسَا بِالْقَوِيَّيْنِ فِي الزُّهْرِيِّ خَاصَّةً ، وَقَدْ خَالَفَهُمَا مَالِكٌ ، وَعُبَيْدُ اللَّهِ بْنُ عَمْرٍو ، وَسُفْيَانُ بْنُ عُيَيْنَةَ ، وَهَؤُلاءِ أَثْبَتُ وَأَحْفَظُ مِنْ سُفْيَانَ بْنِ حُسَيْنٍ ، وَمِنْ جَعْفَرِ بْنِ بُرْقَانَ ، وَأَمَّا حَدِيثُ أُمِّ هَانِئٍ فَقَدِ اخْتُلِفَ عَلَى سِمَاكِ بْنِ حَرْبٍ فِيهِ ، فَسِمَاكُ بْنُ حَرْبٍ لَيْسَ مِمَّنْ يُعْتَمَدُ عَلَيْهِ إِذَا انْفَرَدَ بِالْحَدِيثِ لأَنَّهُ كَانَ يَقْبَلُ التَّلْقِينَ ، وَأَمَّا حَدِيثُ جَعْدَةَ ، فَإِنَّهُ لَمْ يَسْمَعْهُ مِنْ أُمِّ هَانِئٍ ، ذَكَرَهُ ، عَنْ أَبِي صَالِحٍ ، عَنْ أُمِّ هَانِئٍ ، وَأَبُو صَالِحٍ هَذَا اسْمُهُ : بَاذَانُ وَقِيلَ : مَاذَامُ ، وَهُوَ ضَعْيفُ الْحَدِيثِ وَهُوَ مَوْلَى أُمِّ هَانِئٍ ، وَهُوَ الَّذِي يَرْوِي عَنْهُ الْكَلْبِيُّ ، قَالَ : ابْنُ عُيَيْنَةَ ، عَنْ مُحَمَّدِ بْنِ قَيْسٍ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، قَالَ : كُنَّا نُسَمِّي أَبَا صَالِحٍ دروزن وَهُوَ بِالْفَارِسِيَّةِ كَذَّابٌ إِلا أَنَّ يَحْيَي بْنَ سَعِيدٍ لَمْ يَتْرُكْهُ ، وَقَدْ حَدَّثَ عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ عَنْهُ ، وَقَدْ رُوِيَ أَنَّهُ قَالَ فِي مَرَضَهِ : كُلُّ شَيْءٍ حَدَّثْتُكُمْ بِهِ ، فَهُوَ كَذِبٌ ، وَأَبُو صَالِحٍ وَالِدُ سُهَيْلِ بْنِ أَبِي صَالِحٍ اسْمُهُ ذَكْوَانُ ثِقَةٌ مَأْمُونٌ ، وَأَمَّا حَدِيثُ يَحْيَى بْنِ أَيُّوبَ الَّذِي ذَكَرْنَاهُ فَإِنَّهُ لَيْسَ مِمَّنْ يُعْتَمَدُ عَلَيْهِ وَعِنْدَهُ غَيْرُ حَدِيثٍ مُنْكَرٍ""","","Sunan al-Kubra al-Nasai 3215","","أَخْبَرَنِي أَبُو بَكْرِ بْنُ عَلِيٍّ قَالَ حَدَّثَنَا خَلَفُ بْنُ سَالِمٍ قَالَ حَدَّثَنَا أَبُو أَحْمَدَ قَالَ حَدَّثَنَا شَرِيكٌ عَن خُصَيْفٍ عَنْ مِقْسَمٍ عَنِ ابْنِ عَبَّاسٍ قَالَ","The Book of Fasting"
"3216","أَنْبَأَ إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أَنْبَأَ َوكِيعٌ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنْ عَاصِمِ بْنِ عُمَرَ ، عَنْ أَبِيهِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : إِذَا جَاءَ اللَّيْلُ مِنْ هَهُنَا ، وَذَهَبَ النَّهَارُ مِنْ هَهُنَا ، فَقَدْ أَفْطَرَ الصَّائِمُ """"""","","Sunan al-Kubra al-Nasai 3216","","أَخْبَرَنَا مَحْمُودُ بْنُ غَيْلَانَ قَالَ حَدَّثَنَا قَبِيصَةُ قَالَ حَدَّثَنَا الثَّوْرِيُّ عَنْ حَمَّادٍ عَنْ سَعِيدِ بْنِ جُبَيْرٍ عَنِ ابْنِ عَبَّاسٍ","The Book of Fasting"
"3217","أَنْبَأَ مُحَمَّدُ بْنُ مَنْصُورٍ ، عَنْ سُفْيَانَ عَنْ أَبِي إِسْحَاقَ الشَّيْبَانِيِّ ، قَالَ : سَمِعْتُ عَبْدَ اللَّهِ بْنَ أَبِي أَوْفَى ، يَقُولُ : كُنَّا مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ ، فَقَالَ لِرَجُلٍ :  انْزِلْ فَاجْدَحْ لَنَا "" ، قَالَ : الشَّمْسُ يَا رَسُولَ اللَّهِ ، ثُمَّ قَالَ لَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" انْزِلْ فَاجْدَحْ "" ، قَالَ : الشَّمْسُ يَا رَسُولَ اللَّهِ ، ثُمَّ قَالَ : "" انْزِلْ فَاجْدَحْ "" ، فَنَزَلَ فَجَدَحَ فَشَرِبَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : ""إِذَا رَأَيْتُمُ اللَّيْلَ قَدْ أَقْبَلَ مِنْ هَهُنَا وَأَشَارَ بِيَدِهِ إِلَى الأُفُقِ فَقَدْ أَفْطَرَ الصَّائِمُ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : وَحَدِيثُ عَاصِمِ بْنِ عُمَرَ ، وَحَدِيثُ ابْنِ أَبِي أَوْفَى صَحِيحَانِ""","","Sunan al-Kubra al-Nasai 3217","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا خَلَفٌ عَنْ أَبِي هَاشِمٍ عَنْ حَمَّادِ بْنِ أَبِي سُلَيْمَانَ","The Book of Fasting"
"3218","أَنْبَأَ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا يَعْقُوبُ ، عَنْ أَبِي حَازِمٍ ، عَنْ سَهْلِ بْنِ سَعْدٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا يَزَالُ النَّاسُ بِخَيْرٍ مَا عَجَّلُوا فِطْرَهُمْ """"""","","Sunan al-Kubra al-Nasai 3218","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللهِ قَالَ حَدَّثَنَا حَبِيبُ بْنُ الشَّهِيدِ عَنْ مَيْمُونِ بْنِ مِهْرَانَ عَنِ ابْنِ عَبَّاسٍ","The Book of Fasting"
"3219","أَخْبَرَنِي شُعَيْبُ بْنُ يُوسُفَ ، قَالَ : حَدَّثَنَا يَزِيدُ ، عَنْ مُحَمَّدٍ ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا يَزَالُ الدِّينُ ظَاهِرًا مَا عَجَّلَ النَّاسُ الْفِطْرَ ، إِنَّ الْيَهُودَ يُؤَخِّرُونَ """"""","","Sunan al-Kubra al-Nasai 3219","","أَخْبَرَنَا حُمَيْدُ بْنُ مَسْعَدَةَ عَنْ سُفْيَانَ بْنِ حَبِيبٍ عَنْ حَبِيبِ بْنِ الشَّهِيدِ عَنْ مَيْمُونِ بْنِ مِهْرَانَ عَنْ يَزِيدَ بْنِ الْأَصَمِّ","The Book of Fasting"
"3220","أَنْبَأَ سُلَيْمَانُ بْنُ عُبَيْدِ اللَّهِ ، قَالَ : أَنْبَأَ أَبُو قُتَيْبَةَ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، قَالَ : حَدَّثَنَا هِشَامٌ ، عَنْ حَفْصَةَ ، عَنْ سَلْمَانَ بْنِ عَامِرٍ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : إِذَا وَجَدْتُمُ التَّمْرَ ، فَأَفْطِرُوا عَلَيْهِ ، فَإِنْ لَمْ تَجِدُوا التَّمْرَ فَالْمَاءُ ، فَإِنَّ الْمَاءَ طَهُورٌ """"""","","Sunan al-Kubra al-Nasai 3220","","أَخْبَرَنَا أَحْمَدُ بْنُ أَبِي عُبَيْدِ اللهِ قَالَ حَدَّثَنَا أَبُو قُتَيْبَةَ عَنْ هِشَامٍ عَنْ أَبِي الزُّبَيْرِ عَنْ جَابِرٍ","The Book of Fasting"
"3221","أَنْبَأَ مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ : حَدَّثَنَا مُحَمَّدٌ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنْ عَاصِمٍ ، عَنْ حَفْصَةَ ، عَنْ سَلْمَانَ بْنِ عَامِرٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ وَجَدَ تَمْرًا فَلْيُفْطِرْ عَلَيْهِ ، وَمَنْ لَمْ يَجِدْ تَمْرًا فَلْيُفْطِرْ عَلَى الْمَاءِ فَإِنَّ الْمَاءَ طَهُورٌ """"""","","Sunan al-Kubra al-Nasai 3221","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى قَالَ حَدَّثَنَا خَالِدٌ قَالَ حَدَّثَنَا هِشَامٌ عَنْ أَبِي الزُّبَيْرِ عَنْ جَابِرٍ قَالَ","The Book of Fasting"
"3222","أَخْبَرَنِي إِبْرَاهِيمُ بْنُ يَعْقُوبَ ، قَالَ : حَدَّثَنَا سعِيدُ بْنُ عَامِرٍ ، عَنْ شُعْبَةَ ، عَنْ خَالِدٍ ، عَنْ حَفْصَةَ ، عَنْ سَلْمَانَ بْنِ عَامِرٍ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ وَجَدَ تَمْرًا فَلْيُفْطِرْ عَلَيْهِ ، فَإِنْ لَمْ يَجِدْ فَلْيُفْطِرْ عَلَى مَاءٍ ، فَإِنَّهُ طَهُورٌ """"""","","Sunan al-Kubra al-Nasai 3222","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ الْمُبَارَكِ قَالَ حَدَّثَنَا أَبُو الْوَلِيدِ قَالَ حَدَّثَنَا يَزِيدُ بْنُ إِبْرَاهِيمَ قَالَ حَدَّثَنَا أَبُو الزُّبَيْرِ عَنْ جَابِرٍ","The Book of Fasting"
"3223","أَنَا مُحَمَّدُ بْنُ عُمَرَ بْنِ عَلِيِّ بْنِ مُقَدَّمٍ ، قَالَ : حدَّثَنَا سَعِيدُ بْنُ عَامِرٍ ، عَنْ شُعْبَةَ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ صُهَيْبٍ ، عَنْ أَنَسٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ وَجَدَ تَمْرًا فَلْيُفْطِرْ عَلَيْهِ ، وَمَنْ لا فَلْيُفْطِرْ عَلَى مَاءٍ فَإِنَّهُ طَهُورٌ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : حَدِيثُ شُعْبَةَ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ صُهَيْبٍ خَطَأٌ ، وَالصَّوَابُ الَّذِي قَبْلَهُ""","","Sunan al-Kubra al-Nasai 3223","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا اللَّيْثُ عَنْ أَبِي الزُّبَيْرِ عَنْ عَطَاءٍ عَنِ ابْنِ عَبَّاسٍ","The Book of Fasting"
"3224","أَنْبَأَ مُوسَى بْنُ حِزَامٍ التِّرْمِذِيُّ ، قَالَ : أَنْبَأَ يَحْيَى وَهُوَ ابْنُ آدَمَ ، قَالَ : حَدَّثَنَا يَزِيدُ بْنُ عَبْدِ الْعَزِيزِ ، عَنْ رَقَبَةَ ، عَنْ بُريدَ بْنِ أَبِي مَرْيَمَ ، عَنْ أَنَسٍ ،  أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَيَبْدَأُ إِذَا أَفْطَرَ بِالتَّمْرِ ""، هَذَا الْحَدِيثُ رَوَاهُ شُعْبَةُ ، عَنْ بُريدَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مُرْسَلا ، وَشُعْبَةُ أَحْفَظُ مِمَّنْ رَوَى هَذَا الْحَدِيثَ""","","Sunan al-Kubra al-Nasai 3224","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ مَخْلَدِ بْنِ إِبْرَاهِيمَ قَالَ أَخْبَرَنَا الْمُعْتَمِرُ قَالَ سَمِعْتُ حُمَيْدًا عَنْ أَبِي الْمُتَوَكِّلِ عَنْ أَبِي سَعِيدٍ قَالَ","The Book of Fasting"
"3225","أَنْبَأَ يَحْيَى بْنُ حَبِيبٍ بْنِ عَرَبِيٍّ ، قَالَ : حَدَّثَنَا حَمَّادٌ ، عَنْ عَاصِمٍ ، عَنْ حَفْصَةَ بِنْتِ سِيرِينَ ، عَنِ الرَّبَابِ ، عَنْ سَلْمَانَ بْنِ عَامِرٍ ، يَرْفَعُهُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : إِذَا أَفْطَرَ أَحَدُكُمْ فَلْيُفْطِرْ عَلَى تَمْرٍ فَإِنْ لَمْ يَجِدْ فَلْيُفْطِرْ عَلَى مَاءٍ فَإِنَّ الْمَاءَ طَهُورٌ """"""","","Sunan al-Kubra al-Nasai 3225","","أَخْبَرَنَا حُمَيْدُ بْنُ مَسْعَدَةَ عَنْ بِشْرٍ قَالَ حَدَّثَنَا حُمَيْدٌ عَنْ أَبِي الْمُتَوَكِّلِ أَنَّهُ سَأَلَ أَبَا سَعِيدٍ عَنِ الْحِجَامَةِ لِلصَّائِمِ فَقَالَ §لَا بَأْسَ بِهِ وَعَنِ الْقُبْلَةِ لِلصَّائِمِ فَقَالَ","The Book of Fasting"
"3226","أَنْبَأَ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، عَنْ عَاصِمٍ ، عَنْ حَفْصَةَ بِنْتِ سِيرِينَ ، عَنِ الرَّبَابِ ، عَنْ عَمِّهَا سَلْمَانَ بْنِ عَامِرٍ يَبْلُغُ بِهِ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : إِذَا أَفْطَرَ أَحَدُكُمْ فَلْيُفْطِرْ عَلَى تَمْرٍ ، فَإِنَّهُ بَرَكَةٌ ، وَإِنْ لَمْ يَجِدْ تَمْرًا فَالْمَاءُ فَإِنَّهُ طَهُورٌ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : هَذَا الْحَرْفُ "" فَإِنَّهُ بَرَكَةٌ "" ، لا نَعْلَمُ أَنْ أَحَدًا ذَكَرَهُ غَيْرُ ابْنِ عُيَيْنَةَ وَلا أَحْسِبُهُ مَحْفُوظًا""","","Sunan al-Kubra al-Nasai 3226","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا ابْنُ أَبِي عَدِيٍّ عَنْ حُمَيْدٍ عَنْ أَبِي الْمُتَوَكِّلِ عَنْ أَبِي سَعِيدٍ","The Book of Fasting"
"3227","أَنْبَأَ أَحْمَدُ بْنُ حَرْبٍ ، قَالَ : حَدَّثَنَا ابْنُ عُلَيَّةَ ، عَنْ هِشَامٍ ، عَنْ حَفْصَةَ بِنْتِ سِيرِينَ ، عَنِ الرَّبَابِ ، عَنْ سَلْمَانَ بْنِ عَامِرٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا أَفْطَرَ أَحَدُكُمْ فَلْيُفْطِرْ عَلَى تَمْرٍ فَإِنْ لَمْ يَجِدْ فَلْيُفْطِرْ عَلَى مَاءٍ طَهُورٍ """"""","","Sunan al-Kubra al-Nasai 3227","","أَخْبَرَنَا عَلِيُّ بْنُ حُجْرٍ قَالَ حَدَّثَنَا إِسْمَاعِيلُ عَنْ حُمَيْدٍ عَنْ أَبِي الْمُتَوَكِّلِ أَنَّهُ سَأَلَ أَبَا سَعِيدٍ عَنِ الصَّائِمِ يَحْتَجِمُ فَقَالَ","The Book of Fasting"
"3228","أَنْبَأَ عَلِيُّ بْنُ حُجْرٍ ، قَالَ : أَنْبَأَ قُرَّانُ ْبنُ تَمَّامٍ ، عَنْ هِشَامٍ ، عَنْ حَفْصَةَ ، عَنِ الرَّبَابِ ، عَنْ عَمِّهَا سَلْمَانَ بْنِ عَامِرٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا صَامَ أَحَدُكُمْ فَأَفْطَرَ فَلْيُفْطِرْ عَلَى تَمْرٍ أَوْ عَلَى مَاءٍ فَإِنَّ الْمَاءَ طَهُورٌ """"""","","Sunan al-Kubra al-Nasai 3228","","أَخْبَرَنَا إِبْرَاهِيمُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا إِسْحَاقُ بْنُ يُوسُفَ عَنْ سُفْيَانَ عَنْ خَالِدٍ عَنْ أَبِي الْمُتَوَكِّلِ عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ","The Book of Fasting"
"3229","أَنْبَأَ الْحُسَيْنُ بْنُ مُحَمَّدٍ ، قَالَ : حَدَّثَنَا خَالِدٌ ، عَنْ هِشَامٍ ، عَنْ حَفْصَةَ ، عَنْ أُمِّ الرَّائِحِ ، عَنْ سَلْمَانَ بْنِ عَامِرٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا أَفْطَرْتَ فَأَفْطِرْ عَلَى تَمْرٍ فَإِنْ لَمْ تَجِدْ فَعَلَى مَاءٍ فَإِنَّ الْمَاءَ طَهُورٌ """"""","","Sunan al-Kubra al-Nasai 3229","","أَخْبَرَنَا مُحَمَّدُ بْنُ حَاتِمٍ قَالَ أَخْبَرَنَا حِبَّانُ قَالَ أَخْبَرَنَا عَبْدُ اللهِ عَنْ خَالِدٍ الْحَذَّاءِ عَنْ أَبِي الْمُتَوَكِّلِ عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ","The Book of Fasting"
"3230","أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ الْهَيْثَمِ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ مَسْعَدَةَ ، عَنْ هِشَامٍ ، عَنْ حَفْصَةَ ، عَنْ سَلْمَانَ بْنِ عَامِرٍ ، قَالَ : إِذَا كَانَ أَحَدُكُمْ صَائِمًا فَلْيُفْطِرْ عَلَى تَمْرٍ فَإِنْ لَمْ يَجِدْ تَمْرًا فَلْيُفْطِرْ عَلَى مَاءٍ فَإِنَّ الْمَاءَ هُوَ طَهُورٌ ""، أَنَا عَبْدُ اللَّهِ بْنُ الْهَيْثَمِ ، قَالَ : حَدَّثَنَا حَمَّادٌ ، عَنْ هِشَامٍ ، قَالَ : حَدَّثَنِي عَاصِمٌ ، بِهَذَا الْحَدِيثِ يَرْفَعُهُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ""","","Sunan al-Kubra al-Nasai 3230","","أَخْبَرَنَا زَكَرِيَّا بْنُ يَحْيَى قَالَ حَدَّثَنَا الْحَسَنُ بْنُ عِيسَى بْنِ مَاسِرْجِسَ قَالَ أَخْبَرَنَا ابْنُ الْمُبَارَكِ قَالَ أَخْبَرَنَا خَالِدٌ الْحَذَّاءُ عَنْ أَبِي نَضْرَةَ عَنْ أَبِي سَعِيدٍ","The Book of Fasting"
"3231","أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ الْهَيْثَمِ ، قَالَ : حدَّثَنَا يُوسُفُ بْنُ يَعْقُوبَ ، قَالَ : حَدَّثَنَا هِشَامٌ ، عَنْ حَفْصَةَ ، عَنِ الرَّبَابِ ، عَنْ سَلْمَانَ ، أَنَّهُ قَالَ : إِذَا أَفْطَرَ أَحَدُكُمْ فَلْيُفْطِرْ عَلَى تَمْرٍ ، فَإِنْ لَمْ يَجِدْ تَمْرًا فَلْيُفْطِرْ عَلَى مَاءٍ فَإِنَّ الْمَاءَ طَهُورٌ ""، قَالَ هِشَامٌ : حَدَّثَنِي عَاصِمٌ الأَحْوَلُ أَنَّ حَفْصَةَ تَرْفَعُهُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ""","","Sunan al-Kubra al-Nasai 3231","","أَخْبَرَنَا مُحَمَّدُ بْنُ حَاتِمٍ قَالَ أَخْبَرَنَا حِبَّانُ قَالَ أَخْبَرَنَا عَبْدُ اللهِ عَنْ شُعْبَةَ عَنْ قَتَادَةَ عَنْ أَبِي الْمُتَوَكِّلِ عَنْ أَبِي سَعِيدٍ قَالَ","The Book of Fasting"
"3232","أَنْبَأَ إِبْرَاهِيمُ بْنُ الْحَسَنِ ، عَنْ حَجَّاجٍ ، قَالَ ابْنُ جُرَيْجٍ : أَخْبَرَنِي عَطَاءٌ ، عَنْ أَبِي صَالِحٍ الزَّيَّاتِ ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ ، يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لِلصَّائِمِ فَرْحَتَانِ يَفْرَحُهُمَا : إِذَا أَفْطَرَ فَرِحَ بِفِطْرِهِ وَإِذَا لَقِيَ رَبَّهُ فَرِحَ بِصَوْمِهِ """"""","","Sunan al-Kubra al-Nasai 3232","","أَخْبَرَنَا عُبَيْدُ اللهِ بْنُ عَبْدِ الْكَرِيمِ أَبُو زُرْعَةَ الرَّازِيُّ قَالَ حَدَّثَنِي عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْمَلِكِ قَالَ حَدَّثَنِي يُونُسُ بْنُ يَحْيَى بْنِ نُبَاتَةَ عَنِ ابْنِ أَبِي ذِئْبٍ عَنِ ابْنِ شِهَابٍ عَنْ عَبْدِ اللهِ بْنِ ثَعْلَبَةَ بْنِ صُعَيْرِ عَنْ أَبِي هُرَيْرَةَ","The Book of Fasting"
"3233","أَنْبَأَ مُحَمَّدُ بْنُ حَاتِمٍ ، قَالَ : أَنْبَأَ سُوَيْدٌ ، قَالَ : أَنْبَأَ عَبْدُ اللَّهِ ، عَنِ ابْنِ جُرَيْجٍ قِرَاءَةً ، عَنْ عَطَاءٍ ، قَالَ : أَنْبَأَ عَطَاءٌ الزَّيَّاتِ ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ ، يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لِلصَّائِمِ فَرْحَتَانِ يُفْرَحُ بِهِمَا : إِذَا أَفْطَرَ فَرِحَ بِفِطْرِهِ ، وَإِذَا لَقِيَ رَبَّهُ فَرِحَ بِصَوْمِهِ """"""","","Sunan al-Kubra al-Nasai 3233","","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ قَالَ أَخْبَرَنَا عَبْدُ اللهِ قَالَ أَخْبَرَنَا ابْنُ أَبِي ذِئْبٍ عَنْ سَعِيدٍ الْمَقْبُرِيِّ عَنْ أَبِيهِ عَنْ أَبِي هُرَيْرَةَ","The Book of Fasting"
"3234","أَخْبَرَنِي قُرَيْشُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ : أَنْبَأَ عَلِيُّ بْنُ الْحَسَنِ ، قَالَ : أَنْبَأَ الْحُسَيْنُ بْنُ وَاقِدٍ ، قَالَ : أَنْبَأَ مَرْوَانُ الْمُقَفَّعُ ، قَالَ : رَأَيْتُ عَبْدَ اللَّهِ بْنَ عُمَرَ قَبَضَ عَلَى لِحْيَتِهِ فَقَطَعَ مَا زَادَ عَلَى الْكَفِّ ، وَقَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا أَفْطَرَ ، قَالَ : ذَهَبَ الظَّمَأُ ، وَابْتَلَّتِ الْعُرُوقُ ، وَثَبَتَ الأَجْرُ إِنْ شَاءَ اللَّهُ """"""","","Sunan al-Kubra al-Nasai 3234","","أَخْبَرَنَا الرَّبِيعُ بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا ابْنُ وَهْبٍ قَالَ أَخْبَرَنِي ابْنُ أَبِي ذِئْبٍ عَنْ سَعِيدٍ الْمَقْبُرِيِّ عَنْ أَبِيهِ عَنْ أَبِي هُرَيْرَةَ","The Book of Fasting"
"3235","أَنْبَأَ إِسْمَاعِيلُ بْنُ مَسْعُودٍ ، عَنْ يَزِيدَ وَهُوَ ابْنُ زُرَيْعٍ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَطَاءٍ ، عَنْ زَيْدِ بْنِ خَالِدٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ جَهَّزَ غَازِيًا أَوْ حَاجًّا أَوْ خَلَفَهُ فِي أَهْلِهِ أَوْ فَطَّرَ صَائِمًا كَانَ لَهُ مِثْلُ أَجْرِهِ مِنْ غَيْرِ أَنْ يَنْقُصَ مِنْ أُجُورِهِمْ شَيْءٌ """"""","","Sunan al-Kubra al-Nasai 3235","","أَخْبَرَنَا أَحْمَدُ بْنُ عَمْرِو بْنِ السَّرْحِ قَالَ حَدَّثَنَا ابْنُ وَهْبٍ قَالَ حَدَّثَنِي ابْنُ أَبِي ذِئْبٍ عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ عَنْ أَبِي هُرَيْرَةَ","The Book of Fasting"
"3236","أَنْبَأَ عَلِيُّ بْنُ الْحُسَيْنِ ، قَالَ : حَدَّثَنَا خَالِدٌ ، قَالَ : حَدَّثَنَا عَبْدُ الْمَلِكِ ، عَنْ عَطَاءٍ ، عَنْ زَيْدِ بْنِ خَالِدٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : مَنْ فَطَّرَ صَائِمًا فَلَهُ أَجْرُهُ ، إِنَّهُ لا يَنْتَقِصُ مِنْ أَجْرِ الصَّائِمِ شَيْءٌ """"""","","Sunan al-Kubra al-Nasai 3236","","أَخْبَرَنَا مُحَمَّدُ بْنُ حَاتِمٍ قَالَ أَخْبَرَنَا حِبَّانُ قَالَ أَخْبَرَنَا عَبْدُ اللهِ عَنْ أُسَامَةَ بْنِ زَيْدٍ عَنْ سَعِيدٍ الْمَقْبُرِيِّ عَنْ أَبِيهِ عَنْ أَبِي هُرَيْرَةَ","The Book of Fasting"
"3237","أَنْبَأَ أَحْمَدُ بْنُ سُلَيْمَانَ ، قَالَ : حَدَّثَنَا يَزِيدُ قَالَ : أَنْبَأَ حُسَيْنٌ ، عَنْ عَطَاءٍ ، عَنْ عَائِشَةَ ، قَالَتْ : مَنْ فَطَّرَ صَائِمًا كَانَ لَهُ مِثْلُ أَجْرِهِ مِنْ غَيْرِ أَنْ يَنْتَقِصَ مِنْ أَجْرِ الصَّائِمِ شَيْئًا """"""","","Sunan al-Kubra al-Nasai 3237","","","The Book of Fasting"
"3238","أَنْبَأَ مُحَمَّدُ بْنُ حَاتِمٍ ، قَالَ : أَنْبَأَ سُوَيْدٌ ، قَالَ : أَنْبَأَ عَبْدُ اللَّهِ ، عَنْ أُسَامَةَ بْنِ زَيْدٍ ، عَنْ سَعِيدٍ الْمَقْبُرِيِّ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : رُبَّ صَائِمٍ لَيْسَ لَهُ مِنٍ صِيَامِهِ إِلا الْجُوعُ ، وَرُبَّ قَائِمٍ لَيْسَ لَهُ مِنْ قِيَامِهِ إِلا السَّهَرُ """"""","","Sunan al-Kubra al-Nasai 3238","","","The Book of Fasting"
"3239","أَنْبَأَ مُحَمَّدُ بْنُ يَحْيَى بْنِ مُحَمَّدٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ مُوسَى ، قَالَ : قَرَأَ عَلَيَّ أَبِي ، عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عَلِيِّ بْنِ حُسَيْنٍ ، عَنْ صَفِيَّةَ زَوْجِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ اعْتَكَفَ الْعَشْرَ الْغَوَابِرَ مِنْ رَمَضَانَ """"""","","Sunan al-Kubra al-Nasai 3239","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا مُغِيرَةُ عَنْ أَبِي الزِّنَادِ عَنِ الْأَعْرَجِ عَنْ أَبِي هُرَيْرَةَ","The Book of I'tikaf"
"3240","أَنْبَأَ إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أَنْبَأَ عبْدُ الرَّزَّاقِ ، قَالَ : أَنْبَأَ مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ . وَعَنِ ابْنِ الْمُسَيِّبِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالا :  كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَعْتَكِفُ الْعَشْرَ الأَوَاخِرَ مِنْ شَهْرِ رَمَضَانَ حَتَّى قَبَضَهُ اللَّهُ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : خَالَفَهُ ابْنُ جُرَيْجٍ""","","Sunan al-Kubra al-Nasai 3240","","أَخْبَرَنَا مُحَمَّدُ بْنُ سَلَمَةَ قَالَ أَخْبَرَنَا ابْنُ الْقَاسِمِ عَنْ مَالِكٍ عَنْ أَبِي الزِّنَادِ عَنِ الْأَعْرَجِ عَنْ أَبِي هُرَيْرَةَ","The Book of I'tikaf"
"3241","أَخْبَرَنِي إِبْرَاهِيمُ بْنُ الْحَسَنِ ، قَالَ : حَدَّثَنَا حجَّاجٌ ، قَالَ ابْنُ جُرَيْجٍ : حَدَّثَنِي ابْنُ شِهَابٍ ، عَنِ الاعْتِكَافِ وَكَيْفَ سُنَّتُهُ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، وَعُرْوَةَ بْنِ الزُّبَيْرِ ، عَنْ عَائِشَةَ أَنَّهَا أَخْبَرَتْهُمَا ،  أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَيَعْتَكِفُ الْعَشْرَ الأَوَاخِرَ مِنْ رَمَضَانَ حَتَّى تَوَفَّاهُ اللَّهُ ثُمَّ اعْتَكَفَ أَزْوَاجُهُ مِنْ بَعْدِهِ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : رَوَاهُ اللَّيْثُ ، عَنِ الزُّهْرِيِّ ، عَنْ سَعِيدٍ مُرْسَلا""","","Sunan al-Kubra al-Nasai 3241","","أَخْبَرَنَا هَنَّادُ بْنُ السَّرِيِّ عَنْ أَبِي بَكْرٍ عَنْ أَبِي حَصِينٍ وَاسْمُهُ عُثْمَانُ بْنُ عَاصِمٍ كُوفِيٌّ عَنْ أَبِي صَالِحٍ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of I'tikaf"
"3242","أَنْبَأَ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا اللَّيْثُ ، عَنِ ابْنِ شِهَابٍ ، أَنَّ سَعِيدَ بْنَ الْمُسَيِّبِ ، قَالَ : إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  كَانَيَعْتَكِفُ الْعَشْرَ الأَوَاخِرَ مِنْ رَمَضَانَ حَتَّى تَوَفَّاهُ اللَّهُ ، ثُمَّ اعْتَكَفَ أَزْوَاجُهُ مِنْ بَعْدِهِ """"""","","Sunan al-Kubra al-Nasai 3242","","أَخْبَرَنِي إِبْرَاهِيمُ بْنُ الْحَسَنِ عَنْ حَجَّاجٍ قَالَ ابْنُ جُرَيْجٍ أَخْبَرَنِي عَطَاءٌ عَنْ أَبِي صَالِحٍ أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ يَقُولُ","The Book of I'tikaf"
"3243","أَنْبَأَ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا اللَّيْثُ ، عَنْ عُقَيْلٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ،  أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَيَعْتَكِفُ الْعَشْرَ الأَوَاخِرَ مِنْ رَمَضَانَ حَتَّى تَوَفَّاهُ اللَّهُ ، ثُمَّ اعْتَكَفَ أَزْوَاجُهُ مِنْ بَعْدِهِ """"""","","Sunan al-Kubra al-Nasai 3243","","أَخْبَرَنَا مُحَمَّدُ بْنُ حَاتِمٍ قَالَ أَخْبَرَنَا سُوَيْدٌ قَالَ أَخْبَرَنَا عَبْدُ اللهِ عَنْ ابْنِ جُرَيْجٍ قِرَاءَةً عَنْ عَطَاءٍ أَخْبَرَنَا عَطَاءٌ الزَّيَّاتُ أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ يَقُولُ","The Book of I'tikaf"
"3244","أَخْبَرَنِي عِمْرَانُ بْنُ بَكَّارٍ ، قَالَ : حَدَّثَنَا أَبُو الْمُغِيرَةِ ، قَالَ : حَدَّثَنَا الأَوْزَاعِيُّ ، قَالَ : حَدَّثَنِي الزُّهْرِيُّ ، عَنْ عُرْوَةَ ، قَالَ : كَانَتْ عَائِشَةُ تَعْتَكِفُ الْعَشْرَ الأَوَاخِرَ فَلا تَدْخُلُ بَيْتِهَا إِلا لِحَاجَةِ الإِنْسَانِ الَّتِي لا بُدَّ مِنْهَا """"""","","Sunan al-Kubra al-Nasai 3244","","أَخْبَرَنَا عَبْدُ الرَّحْمَنِ بْنُ إِبْرَاهِيمَ عَنِ الْوَلِيدِ عَنِ ابْنِ نَمِرٍ وَاسْمُهُ عَبْدُ الرَّحْمَنِ قَالَ","The Book of I'tikaf"
"3245","أَنْبَأَ مُحَمَّدُ بْنُ حَاتِمٍ ، قَالَ : أَنْبَأَ حِبَّانُ ، قَالَ : أَنْبَأَ عَبْدُ اللَّهِ ، عَنِ الأَوْزَاعِيِّ ، عَنِ الزُّهْرِيِّ ، قَالَ : حَدَّثَنِي عُرْوَةُ ، وَعُمْرَةُ ، عَنْ عَائِشَةَ ،  كَانَتْإِذَا اعْتَكَفَتْ ، اعْتَكَفَتْ فِي الْمَسْجِدِ وَكَانَتْ تَعْتَكِفُ الْعَشْرَ الْغَوَابِرَ مِنْ رَمَضَانَ ، فَلا تَدْخُلُ بَيْتَهَا إِلا لِحَاجَةِ الإِنْسَانِ الَّتِي لا بُدَّ مِنْهَا """"""","","Sunan al-Kubra al-Nasai 3245","","أَخْبَرَنِي مُحَمَّدُ بْنُ يَزِيدَ قَالَ حَدَّثَنَا مَعْنٌ عَنْ خَارِجَةَ بْنِ سُلَيْمَانَ عَنْ يَزِيدَ بْنِ رُومَانَ عَنْ عُرْوَةَ عَنْ عَائِشَةَ","The Book of I'tikaf"
"3246","أَنْبَأَ مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ : حَدَّثَنِي يوسُفُ بْنُ يَعْقُوبَ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنْ أَبِي الْحَسَنِ ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي سَعِيدٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : يُعْتَكَفُ الْعَشْرُ الأَوَاخِرُ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ مُحَمَّدُ بْنُ عَمْرٍو فَإِنْ كَانَ مُحَمَّدُ بْنُ عَمْرٍو كُنْيَتُهُ أَبُو الْحَسَنِ فَلَعَلَّهُ ، مُهَاجِرٌ كُنْيَتُهُ أَبُو الْحَسَنُ ، وَقَدْ رَوَى عَنْهُ شُعْبَةُ""","","Sunan al-Kubra al-Nasai 3246","","أَخْبَرَنَا مُحَمَّدُ بْنُ حَاتِمٍ قَالَ أَخْبَرَنَا حِبَّانُ قَالَ أَخْبَرَنَا عَبْدُ اللهِ عَنِ ابْنِ أَبِي ذِئْبٍ عَنْ عَجْلَانَ عَنْ أَبِي هُرَيْرَةَ","The Book of I'tikaf"
"3247","أَنْبَأَ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا بَكْرُ بْنُ مُضَرَ ، عَنِ ابْنِ الْهَادِ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ بْنَ الْحَارِثِ التَّيْمِيِّ ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ :  كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُجَاوِرُ فِي الْعَشْرِ الَّتِي فِي وَسَطِ الشَّهْرِ ، فَإِذَا كَانَ مِنْ حِينِ تَمْضِي عِشْرُونَ لَيْلَةً وَيَسْتَقْبِلُ إِحْدَى وَعِشْرِينَ يَرْجِعُ إِلَى مَسْكَنِهِ وَرَجَعَ مَنْ كَانَ يُجَاوِرُ مَعَهُ ، وَإِنَّهُ أَقَامَ فِي شَهْرٍ جَاوَرَ فِي تِلْكَ اللَّيْلَةِ الَّتِي كَانَ يَرْجِعُ فِيهَا ، فَخَطَبَ النَّاسَ ثُمَّ أَمَرَهُمْ بِمَا شَاءَ اللَّهُ ، ثُمَّ قَالَ : ""إِنِّي كُنْتُ أُجَاوِرُ هَذِهِ الْعَشْرِ ثُمَّ بَدَا لِي أَنْ أُجَاوِرَ هَذِهِ الْعَشْرَ الأَوَاخِرَ ، فَمَنْ كَانَ اعْتَكَفَ مَعِي فَلْيَثْبُتْ فِي مُعْتَكَفِهِ ، وَقَدْ رَأَيْتُ هَذِهِ اللَّيْلَةَ ، فَأُنْسِيتُهَا فَالْتَمِسُوهَا فِي الْعَشْرِ الأَوَاخِرِ فِي كُلِّ وِتْرٍ ، وَقَدْ رَأَيْتُنِي أَسْجُدُ فِي مَاءٍ وَطِينٍ "" ، قَالَ أَبُو سَعِيدٍ الْخُدْرِيُّ : مُطِرْنَا لَيْلَةَ إِحْدَى وَعِشْرِينَ فَوَكَفَ الْمَسْجِدُ فِي مُصَلَّى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَنَظَرْتُ إِلَيْهِ وَقَدِ انْصَرَفَ مِنْ صَلاةِ الصُّبْحِ وَوَجْهُهُ مُبْتَلٌّ طِينًا وَمَاءً""","","Sunan al-Kubra al-Nasai 3247","","أَخْبَرَنَا مُحَمَّدُ بْنُ مَعْدَانَ قَالَ حَدَّثَنَا الْحَسَنُ بْنُ أَعْيَنَ حَرَّانِيٌّ ثِقَةٌ قَالَ حَدَّثَنَا مَعْقِلٌ عَنْ عَطَاءٍ قَالَ","The Book of I'tikaf"
"3248","أَنْبَأَ مُوسَى بْنُ حِزَامٍ التِّرْمِذِيُّ ثِقْةٌ ، قَالَ : أَنْبَأَ يَحْيَى وَهُوَ ابْنُ آدَمَ ، قَالَ : حَدَّثَنَا أَبُو بَكْرِ بْنُ عَيَّاشٍ ، عَنْ أَبِي حَصِينٍ ، عَنْ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ،  أَنَّهُ كَانَيَعْتَكِفُ الْعَشْرَ الأَوَاخِرَ مِنْ شَهْرِ رَمَضَانَ ، فَلَمَّا كَانَ الْعَامُ الَّذِي قُبِضَ فِيهِ اعْتَكَفَ عِشْرِينَ """"""","","Sunan al-Kubra al-Nasai 3248","","أَخْبَرَنَا نُوحُ بْنُ حَبِيبٍ قَالَ حَدَّثَنَا عَبْدُ الرَّزَّاقِ قَالَ أَخْبَرَنَا مَعْمَرٌ عَنِ الزُّهْرِيِّ عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of I'tikaf"
"3249","أَنْبَأَ يَعْقُوبُ بْنُ إِبْرَاهِيمَ ، قَالَ : حَدَّثَنَا عبْدُ الرَّحْمَنِ ، عَنْ حَمَّادِ بْنِ سَلَمَةَ ، عَنْ ثَابِتٍ ، عَنْ أَبِي رَافِعٍ ، عَنْ أُبَيِّ بْنِ كَعْبٍ ،  أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَيَعْتَكِفُ الْعَشْرَ الأَوَاخِرَ مِنْ رَمَضَانَ ، فَسَافَرَ عَامًا فَلَمْ يَعْتَكِفْ ، فَلَمَّا كَانَ الْعَامُ الْمُقْبِلُ اعْتَكَفَ عِشْرِينَ """"""","","Sunan al-Kubra al-Nasai 3249","","أَخْبَرَنَا مُحَمَّدُ بْنُ حَاتِمٍ قَالَ أَخْبَرَنَا سُوَيْدٌ قَالَ أَخْبَرَنَا عَبْدُ اللهِ عَنِ ابْنِ جُرَيْجٍ قِرَاءَةً عَنْ عَطَاءٍ قَالَ أَخْبَرَنَا عَطَاءٌ الزَّيَّاتُ أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ يَقُولُ","The Book of I'tikaf"
"3250","أَنْبَأَ أَحْمَدُ بْنُ سُلَيْمَانَ أَبُو الْحُسَيْنِ الرُّهَاوِيُّ ، قَالَ : حَدَّثَنَا مِسْكِينُ بْنُ بُكَيْرٍ الْحَرَّانِيُّ ، عَنِ الأَوْزَاعِيِّ ، قَالَ : حَدَّثَنَا يَحْيَى بْنُ سَعِيدٍ ، عَنْ عَمْرَةَ بِنْتِ عَبْدِ الرَّحْمَنِ ، عَنْ عَائِشَةَ ، أَنَّهَا قَالَتْ : ذُكِرَ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  يَعْتَكِفُ الْعَشْرَ الأَوَاخِرَ مِنْ شَهْرِ رَمَضَانَ "" ، فَاسْتَأْذَنَتْهُ فَأَذِنَ لَهَا فَسَأَلَتْ حَفْصَةُ عَائِشَةَ أَنْ تَسْتَأْذِنَ لَهَا فَفَعَلَتْ ، فَلَمَّا رَأَتْ زَيْنَبُ بِنْتُ جَحْشٍ أَمَرَتْ بِبِنَائِهَا فَبُنِيَ ، وَكَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا صَلَّى انْصَرَفَ إِلَى بِنَائِهِ فَبَصُرَ بِالأَبْنِيَةِ ، فَقَالَ : "" مَا هَذَا ؟ "" فَقَالُوا : بِنَاءُ عَائِشَةَ ، وَحَفْصَةَ ، وَزَيْنَبَ ، فَقَالَ : ""آلْبِرَّ يُرِدْنَ بِهَذَا ؟ مَا أَنَا بِمُعْتَكِفٍ "" ، فَرَجَعَ ، فَلَمَّا أَفْطَرَ اعْتَكَفَ عَشْرًا مِنْ شَوَّالٍ""","","Sunan al-Kubra al-Nasai 3250","","أَخْبَرَنَا عُبَيْدُ اللهِ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا يَحْيَى عَنْ عُبَيْدِ اللهِ قَالَ أَخْبَرَنِي نَافِعٌ عَنِ ابْنِ عُمَرَ","The Book of I'tikaf"
"3251","أَنْبَأَ قُتَيْبَةُ بْنُ سَعِيدٍ ، وأنبا أَبُو الأَشْعَثِ مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ بَزِيعٍ وَاللَّفْظُ لَهُ ، قَالُوا : أَنْبَأَ يَزِيدُ بْنُ زُرَيْعٍ ، قَالَ : حَدَّثَنَا خَالِدٌ ، عَنْ عِكْرِمَةَ ، عَنْ عَائِشَةَ ، قَالَتْ : اعْتَكَفَتْ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ امْرَأَةٌ مِنْ أَزْوَاجِهِ مُسْتَحَاضَةٌ ، فَكَانَتْ تَرَى الْحُمْرَةَ وَالصُّفْرَةَ ، فَرُبَّمَا وَضَعَتِ الطَّسْتَ تَحْتَهَا وَهِيَ تُصَلِّي """"""","","Sunan al-Kubra al-Nasai 3251","","أَخْبَرَنِي عَمْرُو بْنُ عُثْمَانَ بْنِ سَعِيدٍ قَالَ حَدَّثَنَا أَبِي عَنْ شُعَيْبٍ عَنِ الزُّهْرِيِّ قَالَ حَدَّثَنِي أَبُو سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ أَنَّ أَبَا هُرَيْرَةَ قَالَ","The Book of I'tikaf"
"3252","أَنْبَأَ مُحَمَّدُ بْنُ مَنْصُورٍ ، عَنْ سُفْيَانَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ عَمْرَةَ ، عَنْ عَائِشَةَ ، قَالَتْ :أَرَادَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يَعْتَكِفَ فِي الْعَشْرِ الأوَّلِ مِنْ شَهْرِ رَمَضَانَ فَاسْتَأْذَنَتْهُ عَائِشَةُ فَأَذِنَ لَهَا ، ثُمَّ اسْتَأْذَنَتْهُ حَفْصَةُ فَأَذِنَ لَهَا ، وَكَانَتْ زَيْنَبُ لَمْ تَكُنِ اسْتَأْذَنَتْهُ فَسَمِعَتْ بِذَلِكَ فَاسْتَأْذَنَتْ ، وَكَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا صَلَّى الصُّبْحَ ، أَتَى مُعْتَكَفَهُ ، فَلَمَّا صَلَّى الصُّبْحَ إِذَا هُوَ بِأَرْبَعَةِ أَبْنِيَةٍ ، فَقَالَ :  لِمَنْ هَذَا ؟ "" ، قَالُوا : لِعَائِشَةَ ، وَحَفْصَةَ ، وَزَيْنَبَ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" آلْبِرَّ تَقُولُونَ يُرِدْنَ بِهَذَا "" ، فَلَمْ يَعْتَكِفْ فِي ذَلِكَ الْعَشْرِ وَاعْتَكَفَ فِي الْعَشْرِ مِنْ شَوَّالٍ""","","Sunan al-Kubra al-Nasai 3252","","أَخْبَرَنَا عَبْدُ الرَّحْمَنِ بْنُ إِبْرَاهِيمَ عَنِ الْوَلِيدِ قَالَ حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ نَمِرٍ عَنِ الزُّهْرِيِّ قَالَ أَخْبَرَنِي سَعِيدٌ وَأَبُو سَلَمَةَ أَنَّ أَبَا هُرَيْرَةَ قَالَ","The Book of I'tikaf"
"3253","أَنْبَأَ مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى ، قَالَ : حَدَّثَنَا مُعْتَمِرٌ ، قَالَ : حَدَّثَنِي عُمَارَةُ بْنُ غَزِيَّةَ الأَنْصَارِيُّ ، قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ إِبْرَاهِيمَ يُحَدِّثُ ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ : إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ اعْتَكَفَ الْعَشْرَ الأُوَلَ مِنْ رَمَضَانَ ، ثُمَّ اعْتَكَفَ الْعَشْرَ الْوَسَطَ فِي قُبَّةِ تُرْكِيَّةٍ عَلَى سُدَّتِهَا قِطْعَةُ حَصِيرٍ ، قَالَ : فَأَخَذَ الْحَصِيرَ بِيَدِهِ ، فَنَحَّاهَا فِي نَاحِيَةِ الْقُبَّةِ ، ثُمَّ أَطْلَعَ رَأْسَهُ فَكَلَّمَ النَّاسَ فَدَنَوْا مِنْهُ ، فَقَالَ : إِنِّي أَعْتَكِفُ الْعَشْرَ الأُوَلَ أَلْتَمِسُ هَذِهِ اللَّيْلَةَ ، ثُمَّ اعْتَكَفْتُ الْعَشْرَ الْوَسَطَ ثُمَّ أَتَيْتُ فَقِيلَ لِي : إِنَّهَا فِي الْعَشْرِ الأَوَاخِرِ ، فَمَنْ أَحَبَّ مِنْكُمْ أَنْ يَعْتَكِفَ فَلْيَعْتَكِفْ "" ، فَاعْتَكَفَ النَّاسُ مَعَهُ ، قَالَ : وَإِنِّي أُرِيتُهَا لَيْلَةَ وِتْرٍ ، وَإِنِّي ، ثُمَّ ذَكَرَ كَلِمَةً مَعْنَاهَا أَسْجُدُ صَبِيحَتَهَا فِي طَينٍ وَمَاءٍ "" ، فَأَصْبَحَ مِنْ إِحْدَى وَعِشْرِينَ وَقَدْ قَامَ إِلَى الصُّبْحِ ، وَمَطَرَتِ السَّمَاءِ ، فَوَكَفَ الْمَسْجِدُ ، فَأَبْصَرْتُ الطِّينَ وَالْمَاءَ ، فَخَرَجَ حِينَ فَرَغَ مِنْ صَلاةِ الصُّبْحِ وَجَبِينُهُ وَرَوْثَةُ أَنْفِهِ فِيهِمَا الطِّينُ وَالْمَاءُ ، وَإِذًا هِيَ لَيْلَةُ إِحْدَى وَعِشْرِينَ مِنَ الْعَشْرِ الأَوَاخِرِ""","","Sunan al-Kubra al-Nasai 3253","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ أَخْبَرَنَا عَبْدَةُ بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا هِشَامُ بْنُ عُرْوَةَ عَنْ أَبِيهِ عَنْ عَائِشَةَ قَالَتْ","The Book of I'tikaf"
"3254","أَنْبَأَ إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أَنْبَأَ حَفْصُ بْنُ غِيَاثٍ ، عَنْ عُبَيْدِ اللَّهِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنْ عُمَرَ ، قَالَ : قُلْتُ يَا رَسُولَ اللَّهِ ، إِنِّينَذَرْتُ أَنْ أَعْتَكِفَ لَيْلَةً فِي الْمَسْجِدِ الْحَرَامِ ، وَقَدْ جَاءَ اللَّهُ بِالإِسْلامِ ، فَقَالَ :  أَوْفِ بِنَذْرِكَ """"""","","Sunan al-Kubra al-Nasai 3254","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى قَالَ حَدَّثَنَا خَالِدٌ قَالَ حَدَّثَنَا شُعْبَةُ عَنْ حَبِيبٍ عَنْ لَيْلَى عَنْ جَدَّةِ حَبِيبٍ","The Book of I'tikaf"
"3255","أَنْبَأَ يَعْقُوبُ بْنُ إِبْرَاهِيمَ ، قَالَ : حَدَّثَنَا يحْيَى ، عَنْ عُبَيْدِ اللَّهِ بْنُ عُمَرَ ، قَالَ : حَدَّثَنِي نَافِعٌ ، عَنِ ابْنِ عُمَرَ ، أَنَّهُ سَأَلَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : يَا رَسُولَ اللَّهِ ، إِنِّينَذَرْتُ أَنْ أَعْتَكِفَ لَيْلَةً فِي الْمَسْجِدِ الْحَرَامِ فِي الْجَاهِلِيَّةِ ، قَالَ :  أَوْفِ بِنَذْرِكَ """"""","","Sunan al-Kubra al-Nasai 3255","","أَخْبَرَنَا عَلِيُّ بْنُ حُجْرٍ قَالَ أَخْبَرَنَا شَرِيكٌ عَنْ حَبِيبِ بْنِ زَيْدٍ عَنْ لَيْلَى","The Book of I'tikaf"
"3256","أَنْبَأَ أَحْمَدُ بْنُ عَبْدِ اللَّهِ بْنِ الْحَكَمِ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، قَالَ : سَمِعْتُ عُبَيْدَ اللَّهِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ عُمَرَ ، كَانَ قَدْجَعَلَ عَلَيْهِ يَوْمًا يَعْتَكِفُهُ فِي الْجَاهِلِيَّةِ فَسَأَلَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، عَنْ ذَلِكَ  فَأَمَرَهُ أَنْ يَعْتَكِفَ ""ذِكْرُ الاخْتِلافِ عَلَى أَيُّوبَ""","","Sunan al-Kubra al-Nasai 3256","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا سُفْيَانُ عَنْ أَبِي الزِّنَادِ عَنِ الْأَعْرَجِ عَنْ أَبِي هُرَيْرَةَ يَرْفَعُهُ قَالَ","The Book of I'tikaf"
"3257","أَنْبَأَ إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : حَدَّثَنَا عبْدُ الرَّزَّاقِ ، قَالَ : حَدَّثَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لَمَّا قَفَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ حُنَيْنٍ  سَأَلَ عُمَرُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ،عَنْ نَذْرٍ كَانَ نَذَرَهُ فِي الْجَاهِلِيَّةِ اعْتِكَافَ يَوْمٍ فَأَمَرَهُ بِهِ """"""","","Sunan al-Kubra al-Nasai 3257","","أَخْبَرَنَا عَلِيُّ بْنُ حُجْرٍ قَالَ أَخْبَرَنَا إِسْمَاعِيلُ عَنْ هِشَامٍ عَنِ ابْنِ سِيرِينَ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of I'tikaf"
"3258","أَنْبَأَ مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ يَزِيدَ ، قَالَ : حدَّثَنَا سُفْيَانُ ، قَالَ : حَدَّثَنَا أَيُّوبُ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : كَانَ عَلَى عُمَرَنَذْرٌ فِي اعْتِكَافِ لَيْلَةٍ فِي الْمَسْجِدِ الْحَرَامِ ،  فَسَأَلَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَأَمَرَهُ أَنْ يَعْتَكِفَ """"""","","Sunan al-Kubra al-Nasai 3258","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ أَخْبَرَنَا عَبْثَرٌ وَهُوَ ابْنُ الْقَاسِمِ أَبُو زُبَيْدٍ كُوفِيٌّ ثِقَةٌ عَنْ سُلَيْمَانَ التَّيْمِيِّ عَنْ أَبِي الْعَلَاءِ بْنِ الشِّخِّيرِ عَنْ عَائِشَةَ","The Book of I'tikaf"
"3259","أَنْبَأَ إِسْحَاقُ بْنُ مُوسَى ، قَالَ : حَدَّثَنَا سُفْيَانُ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنْ عُمَرَ ،  أَنَّهُ كَانَعَلَيْهِ لَيْلَةُ نَذْرٍ فِي الْجَاهِلِيَّةِ فَسَأَلَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَأَمَرَهُ أَنْ يَعْتَكِفَ """"""","","Sunan al-Kubra al-Nasai 3259","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَمْرِو بْنِ حَنَانَ حِمْصِيٌّ قَالَ حَدَّثَنَا بَقِيَّةُ قَالَ حَدَّثَنِي يَزِيدُ بْنُ هَارُونَ عَنْ سُلَيْمَانَ التَّيْمِيِّ عَنْ أَبِي الْعَلَاءِ عَنْ عَائِشَةَ «أَنَّهَا §ضَعُفَتْ يَوْمًا","The Book of I'tikaf"
"3260","أَنْبَأَ أَبُو بَكْرِ بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا الْحَسَنُ بْنُ حَمَّادٍ الْوَرَّاقُ ، قَالَ : أَنْبَأَ عَمْرُو بْنُ مُحَمَّدٍ الْعَنْقَزِيُّ ، عَنْ عَبْدِ اللَّهِ بْنِ بُدَيْلِ بْنِ وَرْقَاءَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ عُمَرَ سَأَلَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِاعْتِكَافٍ عَلَيْهِ فَأَمَرَهُ أَنْ يَعْتَكِفَ وَيَصُومُ ""","","Sunan al-Kubra al-Nasai 3260","","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ قَالَ حَدَّثَنَا عَبْدُ الْأَعْلَى قَالَ حَدَّثَنَا خَالِدٌ عَنْ أَبِي الْعَلَاءِ عَنْ عَائِشَةَ أَنَّهَا «§أَفْطَرَتْ يَوْمًا فَأُمِرَتْ أَنْ تَقْضِيَ يَوْمًا» أَوْ قَالَ «يَوْمَيْنِ» قَالَ","The Book of I'tikaf"
"3261","أَنْبَأَ مُحَمَّدُ بْنُ خَالِدِ بْنِ خَلِيٍّ ، قَالَ : حَدَّثَنَا بشْرُ بْنُ شُعَيْبٍ ، عَنْ أَبِيهِ ، عَنِ الزُّهْرِيِّ ، قَالَ : أَخْبَرَنِي عَلِيُّ بْنُ حُسَيْنٍ ، أَنَّ صَفِيَّةَ بِنْتَ حُيَيٍّ أَخْبَرَتْهُ ، أَنَّهَا جَاءَتْ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ تَزُورُهُ وَهُوَ مُعْتَكِفٌ فِي الْغَوَابِرِ مِنْ رَمَضَانَ فَتَحَدَّثَتْ عِنْدَهُ سَاعَةً مِنَ الْعِشَاءِ ، ثُمَّ قَامَتْ تَنْقَلِبُ ، فَقَامَ مَعَهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقْلِبُهَا ، حَتَّى إِذَا بَلَغَتْ بَابَ الْمَسْجِدِ الَّذِي عِنْدَ مَسْكَنِ أُمِّ سَلَمَةَ زَوْجِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَرَّ بِهِمَا رَجُلانِ مِنَ الأَنْصَارِ فَسَلَّمَا عَلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ثُمَّ نَفَذَا ، فَقَالَ لَهُمَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  عَلَى رِسْلِكُمَا ، إِنَّمَا هِي صَفِيَّةُ بِنْتُ حُيَيٍّ "" ، فَقَالا : سُبْحَانَ اللَّهِ يَا رَسُولَ اللَّهِ ، وَكَبُرَ عَلَيْهِمَا ذَلِكَ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" إِنَّالشَّيْطَانَ يَبْلُغُ مِنَ الإِنْسَانِ مَبْلَغَ الدَّمِ ، إِنِّي خَشِيتُ أَنْ يَقْذِفَ فِي قُلُوبِكُمَا شَيْئًا """"""","","Sunan al-Kubra al-Nasai 3261","","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ قَالَ حَدَّثَنَا عَبْدُ الْوَهَّابِ قَالَ حَدَّثَنَا خَالِدٌ عَنْ يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ الشِّخِّيرِ أَنَّ عَائِشَةَ «§صَامَتْ يَوْمًا فَجَهَدَهَا الصَّوْمُ فَأَفْطَرَتْ» فَقَالَتْ حَفْصَةُ لَأَذْكُرَنَّ ذَلِكَ لِلنَّبِيِّ ﷺ فَقَالَتْ","The Book of I'tikaf"
"3262","أَنْبَأَ إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أَنْبَأَ عَبْدُ الرَّزَّاقِ ، عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عَلِيِّ بْنِ حُسَيْنٍ ، عَنْ صَفِيَّةَ بِنْتِ حُيَيٍّ ، قَالَتْ : كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مُعْتَكِفًا فَأَتَيْتُهُ أَزُورُهُ لَيْلا فَحَدَّثْتُهُ ، ثُمَّ قُمْتُ فَانْقَلَبْتُ ، فَقَامَ مَعِي يَقْلِبُنِي ، وَكَانَ مَسْكَنُهَا فِي دَارِ أُسَامَةَ بْنِ زَيْدٍ ، فَمَرَّ رَجُلانِ مِنَ الأَنْصَارِ ، فَلَمَّا رَأَيَا النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَسْرَعَا ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  عَلَى رِسْلِكُمَا ، إِنَّهَا صَفِيَّةُ بِنْتُ حُيَيٍّ "" ، فَقَالا : سُبْحَانَ اللَّهِ يَا رَسُولَ اللَّهِ ، فَقَالَ : "" إِنَّالشَّيْطَانَ يَجْرِي مِنَ الإِنْسَانِ مَجْرَى الدَّمِ ، وَإِنِّي خَشِيتُ أَنَّ يقْذِفَ فِي قُلُوبِكُمَا شَرًّا أَوْ قَالَ شَيْئًا ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : أَرْسَلَهُ سُفْيَانُ بْنُ عُيَيْنَةَ""","","Sunan al-Kubra al-Nasai 3262","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ أَخْبَرَنَا عِيسَى بْنُ يُونُسَ قَالَ حَدَّثَنَا عَوْفٌ عَنْ مُحَمَّدٍ عَنْ أَبِي هُرَيْرَةَ","The Book of I'tikaf"
"3263","أَنْبَأَ مُحَمَّدُ بْنُ حَاتِمٍ ، قَالَ : أَنْبَأَ حِبَّانُ ، قَالَ : أَنْبَأَ عَبْدُ اللَّهِ ، عَنِ ابْنِ عُيَيْنَةَ ، عَنِ الزُّهْرِيِّ ، عَنْ عَلِيِّ بْنِ حُسَيْنٍ ، قَالَ : كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مُعْتَكِفًا فَأَتَتْهُ صَفِيَّةُ ذَاتَ لَيْلَةٍ فَلَمَّا رَجَعَتْ مَشَى مَعَهَا لَيْلا فَأَبْصَرَهُ رَجُلٌ مِنَ الأَنْصَارِ فَدَعَاهُ ، فَقَالَ لَهُ :  تَعَالَهْ ، إِنَّهَا صَفِيَّةُ ، إِنَّالشَّيْطَانَ يَجْرِي مِنَ الإِنْسَانِ مَجْرَى الدَّمِ ""، أَنْبَأَ مُحَمَّدُ بْنُ حَاتِمٍ ، قَالَ : أَنْبَأَ حِبَّانُ ، قَالَ : أَنْبَأَ عَبْدُ اللَّهِ ، عَنْ مَعْمَرٍ ، بِهَذَا الإِسْنَادِ نَحْوَهُ""","","Sunan al-Kubra al-Nasai 3263","","","The Book of I'tikaf"
"3264","أَنْبَأَ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا بَكْرٌ َيعْنِي ابْنَ مُضَرَ ، عَنِ ابْنِ الْهَادِ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ ، عَنْ عَطَاءِ بْنِ يَسَارٍ ، عَنْ رَجُلٍ مِنَ الأَنْصَارِ ، ِأَنَّهُ سَمِعَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ مُجَاوِرٌ فِي المَسْجِدٍ يَوْمًا فَوَعَظَ النَّاسَ وَحَذَّرَهُمْ وَرَغَّبَهُمْ ، ثُمَّ قَالَ : إِنَّهُ لَيْسَ مِنْ مُصَلٍّ إِلا وَهُوَ يُنَاجِي رَبَّهُ فلا يَجْهَرْ بَعْضُكُمْ عَلَى بَعْضٍ بِالْقُرْآنِ "". أَنْبَأَ مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ عَبْدِ الْحَكَمِ ، عَنْ شُعَيْبٍ ، عَنِ اللَّيْثِ ، قَالَ : أَنْبَأَ ابْنُ الْهَادِ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ ، عَنْ عَطَاءِ بْنِ يَسَارٍ ، عَنْ رَجُلٍ مِنَ الأَنْصَارِ مِنْ بَنِي بَيَاضَةَ أَنَّهُ سَمِعَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ نَحْوَهُ . أَنْبَأَ مُحَمَّدُ بْنُ عَبْدِ اللَّهِ ، عَنْ شُعَيْبٍ ، قَالَ : حَدَّثَنَا اللَّيْثُ ، قَالَ : أَنْبَأَ ابْنُ الْهَادِ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ ، عَنْ أَبِي حَازِمٍ مَوْلَى الْغِفَارِيِّينَ ، أَنَّهُ حَدَّثَهُ هَذَا الْحَدِيثَ الْبَيَاضِيُّ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : خَالَفَهُ عَبْدُ رَبِّهِ بْنُ سَعِيدٍ فَرَوَاهُ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ ، عَنْ أَبِي سَلَمَةَ""","","Sunan al-Kubra al-Nasai 3264","","أَخْبَرَنَا يُوسُفُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا عَلِيُّ بْنُ بَكَّارٍ عَنْ مُحَمَّدِ بْنِ عَمْرٍو عَنْ أَبِي سَلَمَةَ","The Book of I'tikaf"
"3265","أَنْبَأَ مَحْمُودُ بْنُ غَيْلانَ ، قَالَ : حَدَّثَنَا أَبُو َداوُدَ ، قَالَ : أَنْبَأَ شُعْبَةُ ، عَنْ عَبْدِ رَبِّهِ بْنِ سَعِيدٍ ، قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ إِبْرَاهِيمَ ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ رَجُلٍ مِنْ بَنِي بَيَاضَةَ مِنَ الأَنْصَارِ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَاعْتَكَفَ الْعَشْرَ مِنْ رَمَضَانَ ، وَقَالَ :  إِنَّ أَحَدُكُمْ إِذَا كَانَ فِي الصَّلاةِ ، فَإِنَّمَا يُنَاجِي رَبَّهُ فَلا تَرْفَعُوا أَصْوَاتَكُمْ بِالْقُرْآنِ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : خَالَفَهُ يَحْيَى بْنُ سَعِيدٍ فَرَوَاهُ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ ، عَنْ أَبِي حَازِمٍ""","","Sunan al-Kubra al-Nasai 3265","","أَخْبَرَنَا عَمْرُو بْنُ مَنْصُورٍ قَالَ حَدَّثَنَا أَبُو نُعَيْمٍ قَالَ حَدَّثَنَا سُفْيَانُ عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ عَنْ أَبِي الْمُطَوِّسِ عَنْ أَبِيهِ عَنْ أَبِي هُرَيْرَةَ","The Book of I'tikaf"
"3266","أَنْبَأَ مُحَمَّدُ بْنُ سَلَمَةَ ، قَالَ : أَنْبَأَ ابْنُ الْقَاسِمِ ، عَنْ مَالِكٍ ، قَالَ : حَدَّثَنِي يَحْيَى بْنُ سَعِيدٍ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ بْنِ الْحَارِثِ ، عَنْ أَبِي حَازِمٍ التَّمَّارِ ، عَنِ الْبَيَاضِيِّ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خَرَجَ عَلَى النَّاسِ وَهُمْ يُصَلُّونَ وَقَدْ عَلَتْ أَصْوَاتَهُمْ بِالْقِرَاءَةِ ، فَقَالَ :  إِنَّالْمُصَلِّيَ يُنَاجِي رَبَّهُ فَلْيَنْظُرْ مَاذَا يُنَاجِيهِ بِهِ ، ولا يَجْهَرْ بَعْضُكُمْ عَلَى بَعْضٍ بِالْقُرْآنِ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : أَرْسَلَهُ اللَّيْثُ بْنُ سَعِيدٍ ، وَيَزِيدُ بْنُ هَارُونَ . أَنْبَأَ سُوَيْدُ بْنُ نَصْرٍ ، قَالَ : أَنْبَأَ عَبْدُ اللَّهِ وَهُوَ ابْنُ الْمُبَارَكِ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ ، عَنْ أَبِي حَازِمٍ ، مُرْسَلا . أَنْبَأَ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا اللَّيْثُ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ ، عَنْ أَبِي حَازِمٍ مَوْلَى الأَنْصَارِ ، وَكَانَ قَدِيمًا : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : "" إِنَّ الْمُصَلِّيَ "" ، َذَكَرَ نَحْوَهُ . أَنْبَأَ أَحْمَدُ بْنُ سُلَيْمَانَ ، قَالَ : ثَنَا يَزِيدُ ، قَالَ : أَنْبَأَ يَحْيَى ، أَنَّ مُحَمَّدَ بْنَ إِبْرَاهِيمَ أَخْبَرَهُ ، عَنْ أَبِي حَازِمٍ مَوْلَى الأَنْصَارِ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ ، فَذَكَرَ نَحْوَهُ ، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : وَرَوَاهُ ابْنُ نُمَيْرٍ ، عَنْ يَحْيَى بْنِ سَعِيدٍ وَلَمْ يَذْكُرْ أَبَا حَازِمٍ . أَنْبَأَ حُسَيْنُ بْنُ مَنْصُورٍ ، قَالَ : ثَنَا عَبْدُ اللَّهِ بْنُ نُمَيْرٍ ، قَالَ : حَدَّثَنَا يَحْيَى ، عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ ، عَنْ رَجُلٍ مِنْ قَوْمِهِ نَحْوَهُ""","","Sunan al-Kubra al-Nasai 3266","","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ قَالَ حَدَّثَنَا يَحْيَى وَعَبْدُ الرَّحْمَنِ قَالَا حَدَّثَنَا سُفْيَانُ ثُمَّ ذَكَرَ كَلِمَةَ مَعْنَاهَا عَنْ حَبِيبٍ قَالَ حَدَّثَنِي أَبُو الْمُطَوِّسِ عَنْ أَبِيهِ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of I'tikaf"
"3267","أَنْبَأَ يُوسُفُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا حَجَّاجٌ ، عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي زِيَادُ بْنُ سَعْدٍ ، عَنِ ابْنِ شِهَابٍ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ كَانَ إِذَا اعْتَكَفَ لَمْ يَدْخُلْ بَيْتَهُ إِلا لِحَاجَةِ الإِنْسَانِ الَّتِي لا بُدَّ مِنْهَا """"""","","Sunan al-Kubra al-Nasai 3267","","أَخْبَرَنَا مَحْمُودُ بْنُ غَيْلَانَ قَالَ حَدَّثَنَا عَبْدُ الرَّزَّاقِ وَأَبُو دَاوُدَ عَنِ الثَّوْرِيِّ عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ عَنِ أَبِي الْمُطَوِّسِ عَنْ أَبِيهِ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of I'tikaf"
"3268","أَنْبَأَ أَبُو دَاوُدَ ، قَالَ : حَدَّثَنَا عُثْمَانُ هُوَ ابْنُ عُمَرَ ، قَالَ : أَنْبَأَ يُونُسُ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، قَالَتْ :  إِنْ كُنْتُ لآتِي الْبَيْتَ وَفِيهِ الْمَرِيضُ ، فَمَا أَسْأَلُ إِلا وَأَنَا قَائِمَةٌ ، وَإِنْ كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَلَيُدْخِلُ عَلَيَّ رَأْسَهُ فَأُرَجِّلُهُ ، وَكَانَ لا يَأْتِي الْبَيْتَ إِلا لِحَاجَةٍ إِذَا أَرَادَ الْوُضُوءَ وَهُوَ مُعْتَكِفٌ """"""","","Sunan al-Kubra al-Nasai 3268","","أَخْبَرَنَا مُؤَمَّلُ بْنُ هِشَامٍ قَالَ حَدَّثَنَا إِسْمَاعِيلُ عَنْ شُعْبَةَ عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ عَنْ عُمَارَةَ بْنِ عُمَيْرٍ عَنِ أَبِي الْمُطَوِّسِ عَنْ أَبِيهِ عَنْ أَبِي هُرَيْرَةَ","The Book of I'tikaf"
"3269","الْحَارِثُ بْنُ مِسْكِينٍ قِرَاءَةً عَلَيْهِ وَأَنَا أَسْمَعُ ، عَنِ ابْنِ الْقَاسِمِ ، قَالَ : حَدَّثَنَا مَالِكٌ ، عَنِ ابْنِ شِهَابٍ ، عَنْ عَمْرَةَ ، عَنْ عَائِشَةَ ،  أَنَّهَا كَانَتْإِذَا اعْتَكَفَتْ لا تَسْأَلُ عَنِ الْمَرِيضِ إِلا وَهِيَ تَمْشِي ، لا تَقْفُ """"""","","Sunan al-Kubra al-Nasai 3269","","أَخْبَرَنَا أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ الْحَكَمِ بَصْرِيٌّ عَنْ مُحَمَّدٍ قَالَ حَدَّثَنَا شُعْبَةُ عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ عَنْ عُمَارَةَ بْنِ عُمَيْرٍ عَنِ أَبِي الْمُطَوِّسِ عَنْ أَبِيهِ عَنْ أَبِي هُرَيْرَةَ","The Book of I'tikaf"
"3270","أَخْبَرَنِي مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ إِبْرَاهِيمَ ، قَالَ : حَدَّثَنَا يَزِيدُ ، قَالَ : أَنْبَأَ سُفْيَانُ بْنُ حُسَيْنٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَمُعْتَكِفًا ، وَكَانَ لا يَدْخُلُ الْبَيْتَ إِلا لِحَاجَةٍ لا بُدَّ مِنْهَا ، وَغَسَلْتُ رَأْسَهُ وَإِنَّ بَيْنِي وَبَيْنَهُ لَعَتَبَةُ الْبَيْتِ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : سُفْيَانُ بْنُ حَسَنٍ لا بَأْسَ بِهِ فِي غَيْرِ الزُّهْرِيِّ ، وَلَيْسَ هُوَ فِي الزُّهْرِيِّ بِالْقَوِيِّ ، وَنَظِيرُهُ فِي الزُّهْرِيِّ سُلَيْمَانُ بْنُ كَثِيرٍ ، وَجَعْفَرُ بْنُ بُرْقَانَ وَلَيْسَ بِهِمَا بَأْسٌ فِي غَيْرِ الزُّهْرِيِّ""","","Sunan al-Kubra al-Nasai 3270","","أَخْبَرَنَا مَحْمُودُ بْنُ غَيْلَانَ قَالَ حَدَّثَنَا أَبُو دَاوُدَ قَالَ حَدَّثَنَا شُعْبَةُ قَالَ أَخْبَرَنِي حَبِيبُ بْنُ أَبِي ثَابِتٍ قَالَ سَمِعْتُ عُمَارَةَ بْنَ عُمَيْرٍ يُحَدِّثُ عَنْ أَبِي الْمُطَوِّسِ قَالَ وَقَدْ رَأَيْتُ أَبَا الْمُطَوِّسِ عَنْ أَبِيهِ عَنْ أَبِي هُرَيْرَةَ","The Book of I'tikaf"
"3271","أَنْبَأَ يَعْقُوبُ بْنُ إِبْرَاهِيمَ ، قَالَ : حَدَّثَنَا عبْدُ الرَّحْمَنِ ، عَنْ مَالِكٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ،  أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَإِذَا اعْتَكَفَ يُدْنِي إِلَيَّ رَأْسَهُ فَأُرَجِّلُهُ ، وَكَانَ لا يَدْخُلُ الْبَيْتَ إِلا لِحَاجَةِ الإِنْسَانِ """"""","","Sunan al-Kubra al-Nasai 3271","","أَخْبَرَنِي هِلَالُ بْنُ الْعَلَاءِ قَالَ حَدَّثَنَا أَبِي قَالَ حَدَّثَنَا عُبَيْدُ اللهِ بْنُ عَمْرٍو عَنْ زَيْدٍ عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ عَنْ عَلِيِّ بْنِ الْحُسَيْنِ عَنْ أَبِي هُرَيْرَةَ أَنَّ رَجُلًا أَفْطَرَ فِي شَهْرِ رَمَضَانَ فَأَتَى أَبَا هُرَيْرَةَ فَقَالَ","The Book of I'tikaf"
"3272","أَنْبَأَ مُحَمَّدُ بْنُ سَلَمَةَ ، وَالْحَارِثُ بْنُ مِسْكِينٍ ، قِرَاءَةً عَلَيْهِ وَأَنَا أَسْمَعُ ، عَنِ ابْنِ الْقَاسِمِ ، قَالَ : حَدَّثَنِي مَالِكٌ ، عَنِ ابْنِ شِهَابٍ ، عَنْ عُرْوَةَ ، عَنْ عَمْرَةَ بِنْتِ عَبْدِ الرَّحْمَنِ ، عَنْ عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَإِذَا اعْتَكَفَ يُدْنِي إِلَيَّ رَأْسَهُ فَأُرَجِّلُهُ ، وَكَانَ لا يَدْخُلُ الْبَيْتَ إِلا لِحَاجَةِ الإِنْسَانِ """"""","","Sunan al-Kubra al-Nasai 3272","","أَخْبَرَنِي زَكَرِيَّا بْنُ يَحْيَى قَالَ حَدَّثَنَا عُمَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ قَالَ حَدَّثَنَا أَبِي قَالَ حَدَّثَنَا شَرِيكٌ عَنِ الْعَلَاءِ عَنْ أَبِيهِ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of I'tikaf"
"3273","أَنْبَأَ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا اللَّيْثُ ، عَنِ ابْنِ شِهَابٍ ، عَنْ عُرْوَةَ ، عَنْ عَمْرَةَ ، عَنْ عَائِشَةَ ، قَالَتْ :  إِنْ كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَيُدْخِلُ عَلَيَّ رَأْسَهُ وَهُوَ فِي الْمَسْجِدِ فَأُرَجِّلُهُ ، وَكَانَلا يَدْخُلُ الْبَيْتَ إِلا لِحَاجَةٍ إِذَا كَانَ مُعْتَكِفًا """"""","","Sunan al-Kubra al-Nasai 3273","","أَخْبَرَنِي مَحْمُودُ بْنُ خَالِدٍ قَالَ حَدَّثَنَا الْوَلِيدُ قَالَ حَدَّثَنَا ابْنُ جَابِرٍ قَالَ حَدَّثَنِي سُلَيْمُ بْنُ عَامِرٍ قَالَ حَدَّثَنِي أَبُو أُمَامَةَ قَالَ","The Book of I'tikaf"
"3274","أَنْبَأَ إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أَنْبَأَ عَبْدُ الرَّزَّاقِ ، قَالَ : حَدَّثَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ،  أَنَّهَا كَانَتْتُرَجِّلُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُخْرِجُ إِلَيْهَا رَأْسَهُ وَهِيَ فِي حُجْرَتِهَا وَهُوَ فِي الْمَسْجِدِ """"""","","Sunan al-Kubra al-Nasai 3274","","ما جاء في صوم المرأة بغير إذن زوجها 3274 أَخْبَرَنَا عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ قَالَ حَدَّثَنَا سُفْيَانُ قَالَ حَدَّثَنَا أَبُو الزِّنَادِ عَنْ مُوسَى بْنِ أَبِي عُثْمَانَ عَنْ أَبِيهِ عَنْ أَبِي هُرَيْرَةَ","The Book of I'tikaf"
"3275","أَنْبَأَ نَصْرُ بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا عَبْدُ الأَعْلَى ، قَالَ : أَنْبَأَ مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ،  أَنَّهَا كَانَتْتُرَجِّلُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهِيَ حَائِضٌ وَهُوَ مُعْتَكِفٌ ، فَيُنَاوِلُهَا رَأْسَهُ وَهِيَ فِي حُجْرَتِهَا """"""","","Sunan al-Kubra al-Nasai 3275","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا سُفْيَانُ عَنْ أَبِي الزِّنَادِ عَنِ الْأَعْرَجِ عَنْ أَبِي هُرَيْرَةَ","The Book of I'tikaf"
"3276","أَنْبَأَ عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا يَحْيَى ، قَالَ : حَدَّثَنَا سُفْيَانُ ، قَالَ : حَدَّثَنِي مَنْصُورٌ ، عَنْ إِبْرَاهِيمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيُدْنِي إِلَيَّ رَأْسَهُ وَهُوَ مُعْتَكِفٌ فَأَغْسِلُهُ فَيَأْمُرُنِي وَأَنَا حَائِضٌ """"""","","Sunan al-Kubra al-Nasai 3276","","أَخْبَرَنَا الرَّبِيعُ بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا شُعَيْبُ بْنُ اللَّيْثِ عَنِ اللَّيْثِ عَنْ جَعْفَرِ بْنِ رَبِيعَةَ عَنْ عَبْدِ الرَّحْمَنِ بْنِ هُرْمُزَ قَالَ","The Book of I'tikaf"
"3277","أَنْبَأَ مَحْمُودُ بْنُ غَيْلانَ ، قَالَ : حَدَّثَنَا يَحْيَى ْبنُ آدَمَ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيُخْرِجُ رَأْسَهُ إِلَيَّ مِنَ الْمَسْجِدِ وَهُوَ مُعْتَكِفٌ فَيَأْمُرُنِي فَأَغْسِلُهُ وَأَنَا حَائِضٌ """"""","","Sunan al-Kubra al-Nasai 3277","","أَخْبَرَنَا الرَّبِيعُ بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا ابْنُ وَهْبٍ قَالَ أَخْبَرَنِي حَيْوَةُ وَعُمَرُ بْنُ مَالِكٍ عَنِ ابْنِ الْهَادِ قَالَ حَدَّثَنِي زُمَيْلٌ مَوْلَى عُرْوَةَ عَنْ عُرْوَةَ عَنْ عَائِشَةَ قَالَتْ","The Book of I'tikaf"
"3278","أَنْبَأَ مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّحْمَنِ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيُخْرِجُ إِلَيَّ رَأْسَهُ وَأَنَا حَائِضٌ فَأَغْسِلُهُ """"""","","Sunan al-Kubra al-Nasai 3278","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ حَدَّثَنَا كَثِيرُ بْنُ هِشَامٍ قَالَ حَدَّثَنَا جَعْفَرُ بْنُ بُرْقَانَ قَالَ حَدَّثَنَا الزُّهْرِيُّ عَنْ عُرْوَةَ عَنْ عَائِشَةَ قَالَتْ","The Book of I'tikaf"
"3279","أَنْبَأَ الرَّبِيعُ بْنُ سُلَيْمَانَ ، قَالَ : حَدَّثَنَا ابْنُ وَهْبٍ ، عَنْ يُونُسَ ، عَنِ ابْنِ شِهَابٍ ، قَالَ : حَدَّثَنِي عُرْوَةُ ، عَنْ عَائِشَةَ ، قَالَتْ :  كُنْتُأُرَجِّلُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ فِي الْمَسْجِدِ فَيُدْخِلُ رَأْسَهُ عَلَى عَتَبَةِ الْحُجْرَةِ فَأُرَجِّلُهُ """"""","","Sunan al-Kubra al-Nasai 3279","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى عَنْ يَزِيدَ قَالَ أَخْبَرَنَا سُفْيَانُ بْنُ حُسَيْنٍ عَنِ الزُّهْرِيِّ عَنْ عُرْوَةَ عَنْ عَائِشَةَ قَالَتْ","The Book of I'tikaf"
"3280","أَنْبَأَ عَمْرُو بْنُ عُثْمَانَ ، قَالَ : حَدَّثَنَا الْوَلِيدُ ، عَنِ الأَوْزَاعِيِّ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَأْتِينِي وَهُوَ مُعْتَكِفٌ فِي الْمَسْجِدِ فَيَتَّكِئُ عَلَى عَتَبَةِ بَابِ حُجْرَتِي فَأَغْسِلُ رَأْسَهُ وَأَنَا فِي حُجْرَتِي وَسَائِرُهُ فِي الْمَسْجِدِ """"""","","Sunan al-Kubra al-Nasai 3280","","","The Book of I'tikaf"
"3281","أَنْبَأَ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا الفُضَيْلُ هُوَ ابْنُ عِيَاضٍ ، عَنِ الأَعْمَشِ ، عَنْ تَمِيمِ بْنِ سَلَمَةَ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ،  أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَيُخْرِجُ رَأْسَهُ مِنَ الْمَسْجِدِ وَهُوَ مُعْتَكِفٌ فَأَغْسِلُهُ وَأَنَا حَائِضٌ """"""","","Sunan al-Kubra al-Nasai 3281","","أَخْبَرَنَا مُحَمَّدُ بْنُ سَهْلِ بْنِ عَسْكَرٍ قَالَ حَدَّثَنَا ابْنُ أَبِي مَرْيَمَ قَالَ أَخْبَرَنَا يَحْيَى بْنُ أَيُّوبَ عَنْ إِسْمَاعِيلَ بْنِ عُقْبَةَ قَالَ وَعِنْدِي فِي مَوْضِعٍ آخَرَ إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ عَنِ ابْنِ شِهَابٍ عَنْ عُرْوَةَ عَنْ عَائِشَةَ","The Book of I'tikaf"
"3282","أَنْبَأَ مُحَمَّدُ بْنُ سَلَمَةَ ، قَالَ : حَدَّثَنَا ابْنُ وَهْبٍ ، عَنْ عَمْرِو بْنِ الْحَارِثِ ، وَذَكَرَ آخَرُ ، عَنْ أَبِي الأَسْوَدِ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيُخْرِجُ إِلَيَّ رَأْسَهُ مِنَ الْمَسْجِدِ وَهُوَ مُجَاوِرٌ فَأَغْسِلُهُ وَأَنَا حَائِضٌ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : رَوَاهُ هِشَامُ بْنُ عُرْوَةَ وَلَمْ يَذْكُرْ : وَهُوَ مُجَاوِرٌ""","","Sunan al-Kubra al-Nasai 3282","","أَخْبَرَنَا أَحْمَدُ بْنُ عِيسَى عَنِ ابْنِ وَهْبٍ عَنْ جَرِيرِ بْنِ حَازِمٍ عَنْ يَحْيَى بْنِ سَعِيدٍ عَنْ عَمْرَةَ عَنْ عَائِشَةَ قَالَتْ","The Book of I'tikaf"
"3283","أَنْبَأَ قُتَيْبَةُ بْنُ سَعِيدٍ ، عَنْ مَالِكٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنْ عَائِشَةَ ، قَالَتْ :  كُنْتُأُرَجِّلُ رَأْسَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَأَنَا حَائِضٌ """"""","","Sunan al-Kubra al-Nasai 3283","","","The Book of I'tikaf"
"3284","أَخْبَرَنِي أَبُو بَكْرِ بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا إبْرَاهِيمُ بْنُ الْحَجَّاجِ ، قَالَ : حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَمُعْتَكِفًا فِي الْمَسْجِدِ فَيُخْرِجُ رَأْسَهُ فَأَغْسِلُهُ بِالْخِطْمِيِّ وَأَنَا حَائِضٌ """"""","","Sunan al-Kubra al-Nasai 3284","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا يَحْيَى قَالَ حَدَّثَنَا عُبَيْدُ اللهِ قَالَ حَدَّثَنِي الزُّهْرِيُّ أَنَّ عَائِشَةَ وَحَفْصَةَ صَامَتًا يَوْمًا تَطَوُّعًا فَأَفْطَرَتَا قَالَتْ عَائِشَةُ فَأَرَدْنَا","The Book of I'tikaf"
"3285","أَنْبَأَ مُحَمَّدُ بْنُ سَلَمَةَ ، وَالْحَارِثُ بْنُ مِسْكِينٍ قِرَاءَةً عَلَيْهِ وَاللَّفْظُ لَهُ وَأَنَا أَسْمَعُ ، عَنِ ابْنِ الْقَاسِمِ ، قَالَ : حَدَّثَنِي مَالِكٌ ، عَنْ يَزِيدَ بْنِ عَبْدِ اللَّهِ بْنِ الْهَادِ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ بْنِ الْحَارِثِ التَّيْمِيِّ ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ :  كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَعْتَكِفُ فِي الْعَشْرِ الْوَسَطِ مِنْ رَمَضَانَ ، فَاعْتَكَفَ عَامًا حَتَّى إِذَا كَانَ لَيْلَةُ إِحْدَى وَعِشْرِينَ وَهِيَ اللَّيْلَةُ الَّتِي يَخْرُجُ مِنْ صَبِيحَتِهَا مِنِ اعْتِكَافِهِ "" ، قَالَ : "" مَنْ كَانَ اعْتَكَفَ مَعِي فَلْيَعْتَكِفِ الْعَشْرَ الأَوَاخِرَ ، فَأُرِيتُ هَذِهِ اللَّيْلَةَ ثُمَّ أُنْسِيتُهَا ، وَقَدْ رَأَيْتُنِي أَسْجُدُ مِنْ صَبِيحَتِهَا فِي مَاءٍ وَطِينٍ ، فَالْتَمِسُوهَا فِي الْعَشْرِ الأَوَاخِرِ ، وَالْتَمِسُوهَا فِي كُلِّ وِتْرٍ "" ، قَالَ أَبُو سَعِيدٍ : فَأَمْطَرَتِ السَّمَاءُ تِلْكَ اللَّيْلَةَ وَكَانَ الْمَسْجِدُ عَلَى عَرِيشٍ ، فَوَكَفَ الْمَسْجِدُ ، قَالَ أَبُو سَعِيدٍ : فَبَصُرَتْ عَيْنَايَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى جَبِينِهِ وَأَنْفِهِ أَثَرُ الطِّينِ وَالْمَاءِ مِنْ صَبِيحَةِ إِحْدَى وَعِشْرِينَ""","","Sunan al-Kubra al-Nasai 3285","","","The Book of I'tikaf"
"3286","أَنْبَأَ مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى ، قَالَ : حَدَّثَنَا خالِدٌ ، قَالَ : حَدَّثَنَا هِشَامٌ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : تَذَاكَرْنَا لَيْلَةَ الْقَدْرِ فِي نَفَرٍ مِنْ قُرَيْشٍ ، فَأَتَيْتُ أَبَا سَعِيدٍ الْخُدْرِيَّ وَكَانَ صَدِيقًا لِي ، فَقُلْتُ : أَلا تَخْرُجُ بِنَا إِلَى النَّخْلِ ؟ فَخَرَجَ وَعَلَيْهِ خَمِيصَةٌ ، فَقُلْتُ : سَمِعْتَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَذْكُرُ لَيْلَةَ الْقَدْرِ ؟ قَالَ : نَعَمْ ، اعْتَكَفْنَا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الْعَشْرِ الأَوَاسِطِ مِنْ رَمَضَانَ فَخَرَجْنَا صَبِيحَةَ عِشْرِينَ ، فَخَطَبَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنِّي رَأَيْتُ لَيْلَةَ الْقَدْرِ ، وَإِنِّي أُنْسِيتُهَا ، وَهِيَ فِي الْعَشْرِ الأَوَاخِرِ فِي وِتْرٍ ، وَإِنِّي رَأَيْتُ أَنِّي أَسْجُدُ فِي مَاءٍ وَطِينٍ ، وَمَنْ كَانَ اعْتَكَفَ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَلْيَرْجِعْ "" ، فَجَاءَتْ سَحَابَةٌ فَمُطِرْنَا حَتَّى سَالَ سَقْفُ الْمَسْجِدِ وَكَانَ مِنْ جَرِيدِ النَّخْلِ ، وَأُقِيمَتِ الصَّلاةُ ، وَكَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَسْجُدُ فِي الْمَاءِ وَالطِّينِ حَتَّى رَأَيْتُ أَثَرَ الطِّينِ فِي جَبْهَتِهِ""","","Sunan al-Kubra al-Nasai 3286","","أَخْبَرَنَا مُحَمَّدُ بْنُ مَنْصُورٍ قَالَ حَدَّثَنَا سُفْيَانُ عَنْ طَلْحَةَ بْنِ يَحْيَى عَنْ عَمَّتِهِ عَائِشَةَ بِنْتِ طَلْحَةَ عَنْ عَائِشَةَ قَالَتْ","The Book of I'tikaf"
"3287","أَنْبَأَ هَارُونُ بْنُ عَبْدِ اللَّهِ ، قَالَ : حَدَّثَنَا أبُو دَاوُدَ ، قَالَ : حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ ، عَنْ ثَابِتٍ ، عَنْ أَبِي رَافِعٍ ، عَنْ أُبَيِّ بْنِ كَعْبٍ ،  أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَيَعْتَكِفُ الْعَشْرَ مِنْ رَمَضَانَ فَسَافَرَ عَامًا فَلَمْ يَعْتَكِفْ ، فَلَمَّا كَانَ قَابِلٌ اعْتَكَفَ عِشْرِينَ لَيْلَةً """"""","","Sunan al-Kubra al-Nasai 3287","","أَخْبَرَنَا عَلِيُّ بْنُ عُثْمَانَ قَالَ حَدَّثَنَا الْمُعَافَى بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا خَطَّابُ بْنُ الْقَاسِمِ عَنْ خُصَيْفٍ عَنْ عِكْرِمَةَ عَنِ ابْنِ عَبَّاسٍ","The Book of I'tikaf"
"3288","أَنْبَأَ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ، عَنِ الْحَسَنِ بْنِ عُبَيْدِ اللَّهِ ، قَالَ : سَمِعْتُ إِبْرَاهِيمَ ، يَقُولُ : سَمِعْتُ الأَسْوَدَ بْنَ يَزِيدَ ، يَقُولُ : قَالَتْ عَائِشَةُ :  كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَجْتَهِدُ فِي الْعَشْرِ مَا لا يَجْتَهِدُ فِي غَيْرِهَا """"""","","Sunan al-Kubra al-Nasai 3288","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ قَالَ حَدَّثَنَا شُعْبَةُ عَنْ جَعْدَةَ عَنْ أُمِّ هَانِئٍ وَهِيَ جَدَّتُهُ","The Book of I'tikaf"
"3289","أَنْبَأَ مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ يَزِيدَ ، قَالَ : حدَّثَنَا سُفْيَانُ ، عَنْ أَبِي يَعْفُورٍ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ، قَالَ : قَالَتْ عَائِشَةُ :  كَانَتْ إِذَا دَخَلَتِ الْعَشْرُأَحْيَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ اللَّيْلَ وَأَيْقَظَ أَهْلَهُ وَشَدَّ الْمِئْزَرَ """"""","","Sunan al-Kubra al-Nasai 3289","","","The Book of I'tikaf"
"3290","أَنْبَأَ عَمْرُو بْنُ سَوَّادِ بْنِ الأَسْوَدِ بْنِ عَمْرٍو ، وَالْحَارِثُ بْنُ مِسْكِينٍ قِرَاءَةً عَلَيْهِ وَأَنَا أَسْمَعُ وَاللَّفْظُ لَهُ ، عَنِ ابْنِ وَهْبٍ ، قَالَ : أَخْبَرَنِي يُونُسُ ، عَنِ ابْنِ شِهَابٍ ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : أُرِيتُ لَيْلَةَ الْقَدْرِ ، ثُمَّ أَيْقَظَنِي أَهْلِي فَنَسِيتُهَا ، فَالْتَمِسُوهَا فِي الْعَشْرِ الْغَوَابِرِ """"""","","Sunan al-Kubra al-Nasai 3290","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ حَدَّثَنَا أَبُو الْوَلِيدِ قَالَ حَدَّثَنَا أَبُو عَوَانَةَ عَنْ سِمَاكٍ عَنِ ابْنِ أُمِّ هَانِئٍ عَنْ جَدَّتِهِ أُمِّ هَانِئٍ سَمِعَهُ مِنْهَا","The Book of I'tikaf"
"3291","أَنْبَأَ إِسْحَاقُ بْنُ مَنْصُورٍ ، وَمُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ ، عَنْ بِشْرِ بْنِ شُعَيْبٍ ، قَالَ : حَدَّثَنِي أَبِي ، عَنِ الزُّهْرِيِّ ، قَالَ : أَخْبَرَنِي أَبُو سَلَمَةَ ، أَنَّ أَبَا هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أُرِيتُ لَيْلَةَ الْقَدْرِ ثُمَّ نُسِّيتُهَا فَالْتَمِسُوهَا فِي الْعَشْرِ الْغَوَابِرِ """"""","","Sunan al-Kubra al-Nasai 3291","","أَخْبَرَنَا الرَّبِيعُ بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا يَحْيَى بْنُ حَسَّانَ قَالَ حَدَّثَنَا حَمَّادٌ عَنْ سِمَاكِ بْنِ حَرْبٍ عَنْ هَارُونَ بْنِ أُمِّ هَانِئٍ عَنْ أُمِّ هَانِئٍ قَالَتْ","The Book of I'tikaf"
"3292","أَنْبَأَ عَلِيُّ بْنُ حُجْرٍ ، قَالَ : حَدَّثَنَا إِسْمَاعِيلُ ، قَالَ : حَدَّثَنَا حُمَيْدٌ ، عَنْ أَنَسٍ ، قَالَ : أَخْبَرَنِي عُبَادَةُ بْنُ الصَّامِتِ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خَرَجَ لِيُخْبِرَنَا بِلَيْلَةِ الْقَدْرِ ، فَتَلاحَى رَجُلانِ مِنَ الْمُسْلِمِينَ ، فَقَالَ : إِنِّي خَرَجْتُ لآمُرَكَمْ بِلَيْلَةِ الْقَدْرِ ، وَإِنَّهُ تَلاحَى فُلانٌ وَفُلانٌ فَرُفِعَتْ وَعَسَى أَنْ يَكُونَ خَيْرًا لَكُمْ ، فَالْتَمِسُوهَا فِي التِّسْعِ وَالسَّبْعِ وَالْخَمْسِ """"""","","Sunan al-Kubra al-Nasai 3292","","أَخْبَرَنِي قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا أَبُو الْأَحْوَصِ عَنْ سِمَاكٍ عَنِ ابْنِ أُمِّ هَانِئٍ عَنْ أُمِّ هَانِئٍ قَالَتْ","The Book of I'tikaf"
"3293","أَنْبَأَ عِمْرَانُ بْنُ مُوسَى ، قَالَ : حَدَّثَنَا يَزِيدُ وَهُوَ ابْنُ زُرَيْعٍ ، قَالَ : حَدَّثَنَا حُمَيْدٌ ، عَنْ أَنَسٍ ، وأنبا مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ : حَدَّثَنَا خَالِدٌ ، قَالَ : حَدَّثَنَا حُمَيْدٌ ، قَالَ : حَدَّثَنَا أَنَسٌ ، عَنْ عُبَادَةَ ، قَالَ : خَرَجَ نَبِيُّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِيُخْبِرَنَا بِلَيْلَةِ الْقَدْرِ ، فَتَلاحَى رَجُلانِ مِنَ الْمُسْلِمِينَ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خَرَجْتُ وَأَنَا أُرِيدُ أَنْ أُخْبِرَكُمْ بِلَيْلَةِ الْقَدْرِ فَتَلاحَى فُلانٌ وَفُلانٌ فَرُفِعَتْ ، وَعَسَى أَنْ يَكُونَ خَيْرًا ، فَالْتَمِسُوهَا فِي التَّاسِعَةِ وَالسَّابِعَةِ وَالْخَامِسَةِ ""وَاللَّفْظُ لابْنِ الْمُثَنَّى""","","Sunan al-Kubra al-Nasai 3293","","أَخْبَرَنَا أَحْمَدُ بْنُ عُثْمَانَ قَالَ حَدَّثَنَا عَمْرٌو عَنْ أَسْبَاطٍ عَنْ سِمَاكٍ عَنْ رَجُلٍ عَنْ يَحْيَى بْنِ جَعْدَةَ عَنْ أُمِّ هَانِئٍ","The Book of I'tikaf"
"3294","أَنْبَأَ مُحَمَّدُ بْنُ سَلَمَةَ ، قَالَ : أَنْبَأَ عَبْدُ الرَّحْمَنِ بْنُ الْقَاسِمِ ، عَنْ مَالِكٍ ، عَنْ حُمَيْدٍ الطَّوِيلِ ، عَنْ أَنَسِ بْنِ مَالِكٍ ، قَالَ : خَرَجَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي رَمَضَانَ ، فَقَالَ : إِنِّي أُرِيتُ هَذِهِ اللَّيْلَةَ حَتَّى تَلاحَى رَجُلانِ فَرُفِعَتْ ، فَالْتَمِسُوهَا فِي التَّاسِعَةِ وَالسَّابِعَةِ وَالْخَامِسَةِ """"""","","Sunan al-Kubra al-Nasai 3294","","","The Book of I'tikaf"
"3295","أَنْبَأَ الرَّبِيعُ بْنُ سُلَيْمَانَ ، قَالَ : حَدَّثَنَا ابْنُ وَهْبٍ ، قَالَ : أَخْبَرَنِي يُونُسُ ، عَنِ ابْنِ شِهَابٍ ، قَالَ : أَخْبَرَنِي سَالِمٌ ، أَنَّ عَبْدَ اللَّهِ بْنَ عُمَرَ قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : إِنَّ نَاسًا مِنْكُمْ قَدْ أُرُوا أَنَّهَا فِي السَّبْعِ الأُوَلِ وَأُرِيَ نَاسٌ مِنْكُمْ أَنَّهَا فِي التَّاسِعَةِ وَالسَّابِعَةِ وَالْخَامِسَةِ """"""","","Sunan al-Kubra al-Nasai 3295","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى قَالَ حَدَّثَنَا خَالِدٌ قَالَ حَدَّثَنَا حَاتِمٌ عَنْ سِمَاكٍ عَنْ أَبِي صَالِحٍ قَالَ","The Book of I'tikaf"
"3296","أَنْبَأَ الرَّبِيعُ بْنُ سُلَيْمَانَ ، قَالَ : حَدَّثَنَا ابْنُ وَهْبٍ ، قَالَ : أَخْبَرَنِي يُونُسُ ، عَنِ ابْنِ شِهَابٍ ، قَالَ : أَخْبَرَنِي سَالِمٌ ، أَنَّ عَبْدَ اللَّهِ بْنَ عُمَرَ قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : إِنَّ نَاسًا مِنْكُمْ قَدْ أُرُوا أَنَّهَا فِي السَّبْعِ الأُوَلِ ، وَأُرِيَ نَاسٌ مِنْكُمْ أَنَّهَا فِي السَّبْعِ الْغَوَابِرِ فَالْتَمِسُوهَا فِي السَّبْعِ الْغَوَابِرِ """"""","","Sunan al-Kubra al-Nasai 3296","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ أَخْبَرَنَا وَكِيعٌ عَنْ هِشَامِ بْنِ عُرْوَةَ عَنْ أَبِيهِ عَنْ عَاصِمِ بْنِ عُمَرَ عَنْ أَبِيهِ","The Book of I'tikaf"
"3297","أَنْبَأَ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا اللَّيْثُ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : أُرِيَ رِجَالٌ مِنْ أَصْحَابِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الْمَنَامِ أَنَّ لَيْلَةَ الْقَدْرِ فِي السَّبْعِ الأَوَاخِرِ مِنْ رَمَضَانَ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَسْمَعُ رُؤْيَاكُمْ قَدْ تَوَاطَأَتْ أَنَّهَا فِي السَّبْعِ الأَوَاخِرِ ، فَمَنْ كَانَ مُتَحَرِّيَهَا فَلْيَتَحَرَّهَا فِي السَّبْعِ الأَوَاخِرِ """"""","","Sunan al-Kubra al-Nasai 3297","","أَخْبَرَنَا مُحَمَّدُ بْنُ مَنْصُورٍ عَنْ سُفْيَانَ عَنْ أَبِي إِسْحَاقَ الشَّيْبَانِيِّ قَالَ","The Book of I'tikaf"
"3298","أَنْبَأَ مُحَمَّدُ بْنُ سَلَمَةَ ، قَالَ : أَنْبَأَ عَبْدُ الرَّحْمَنِ بْنُ الْقَاسِمِ ، قَالَ : حَدَّثَنِي مَالِكٌ ، عَنْ نَافِعٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، أَنَّ رَجُلا مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أُرِيَ لَيْلَةَ الْقَدْرِ فِي الْمَنَامِ فِي السَّبْعِ الأَوَاخِرِ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَرَى رُؤْيَاكُمْ قَدْ تَوَاطَأَتْ فِي السَّبْعِ الأَوَاخِرِ ، فَمَنْ كَانَ مُتَحَرِّيَهَا فَلْيَتَحَرَّهَا فِي السَّبْعِ الأَوَاخِرِ """"""","","Sunan al-Kubra al-Nasai 3298","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا يَعْقُوبُ عَنْ أَبِي حَازِمٍ عَنْ سَهْلِ بْنِ سَعْدٍ قَالَ","The Book of I'tikaf"
"3299","أَنْبَأَ مُحَمَّدُ بْنُ سَلَمَةَ ، قَالَ : أَنْبَأَ عَبْدُ الرَّحْمَنِ بْنُ الْقَاسِمِ ، عَنْ مَالِكٍ ، قَالَ : حَدَّثَنِي عَبْدُ اللَّهِ بْنُ دِينَارٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  إِنَّلَيْلَةَ الْقَدْرِ فِي السَّبْعِ الأَوَاخِرِ """"""","","Sunan al-Kubra al-Nasai 3299","","أَخْبَرَنِي شُعَيْبُ بْنُ يُوسُفَ قَالَ حَدَّثَنَا يَزِيدُ عَنْ مُحَمَّدٍ عَنْ أَبِي سَلَمَةَ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of I'tikaf"
"3300","أَخْبَرَنِي مُحَمَّدُ بْنُ عَقِيلٍ ، عَنْ حَفْصٍ مِنْ بَنِي سَلَمَةَ ، قَالَ : حَدَّثَنِي إِبْرَاهِيمُ ، عَنْ عَبَّادِ بْنِ إِسْحَاقَ ، عَنِ الزُّهْرِيِّ ، عَنْ ضَمْرَةَ بْنِ عَبْدِ اللَّهِ بْنِ أُنَيْسٍ ، عَنْ أَبِيهِ ، قَالَ : كُنْتُ فِي مَجْلِسٍ مِنْ بَنِي سَلِمَةَ ، وَأَنَا أَصْغَرُهُمْ ، فَقَالُوا : مَنْ يَسْأَلُ لَنَا رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، عَنْ لَيْلَةِ الْقَدْرِ ، وَذَلِكَ صَبِيحَةَ إِحْدَى وَعِشْرِينَ مِنْ رَمَضَانَ ؟ فَجِئْتُ فَوَافَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلاةَ الْمَغْرِبِ ، ثُمَّ قُمْتُ بِبَابِ بَيْتِهِ فَمَرَّ بِي ، فَقَالَ :  ادْخُلْ "" ، فَدَخَلْتُ ، فَأُتِيَ بِعَشَائِهِ فَرَأَيْتُنِي أَكُفُّ عَنْهُ مِنْ قِلَّتِهِ ، فَلَمَّا فَرَغَ ، قَالَ : "" نَاوِلْنِي نَعْلِي "" ، فَقَامَ وَقُمْتُ مَعَهُ ، قَالَ : ""كَأَنَّ لَكَ حَاجَةً ؟ "" قُلْتُ : أَجَلْ ، أَرْسَلَنِي إِلَيْكَ رَهْطٌ مِنْ بَنِي سَلِمَةَ يَسْأَلُونَكَ عَنْ لَيْلَةِ الْقَدْرِ ، قَالَ : "" كَمِ اللَّيْلَةُ ؟ "" قُلْتُ : اثْنَتَانِ وَعِشْرُونَ ، قَالَ : "" هِي اللَّيْلَةُ "" ، ثُمَّ رَجَعَ ، فَقَالَ : "" أَوِ الْقَابِلَةُ ""، يُرِيدُ لَيْلَةَ ثَلاثٍ وَعِشْرِينَ ، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : خَالَفَهُ مُوسَى بْنُ يَعْقُوبَ""","","Sunan al-Kubra al-Nasai 3300","","أَخْبَرَنَا سُلَيْمَانُ بْنُ عُبَيْدِ اللهِ قَالَ حَدَّثَنَا أَبُو قُتَيْبَةَ قَالَ حَدَّثَنَا شُعْبَةُ قَالَ حَدَّثَنَا هِشَامٌ عَنْ حَفْصَةَ عَنْ سُلَيْمَانَ بْنِ عَامِرٍ","The Book of I'tikaf"
