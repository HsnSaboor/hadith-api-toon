hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"18601","423  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  زَبَّانَ بْنِ فَائِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، عَنْ رَسُولِ اللهِ         [20/191]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  أَنَّهُ أَمَرَ أَصْحَابَهُ بِالْغَزْوِ ، فَرَأَى  رَجُلًا  تَخَلَّفَ ، قَالَ : حَتَّى أُصَلِّيَ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الظُّهْرَ  ، ثُمَّ أُسَلِّمَ عَلَيْهِ وَأُوَدِّعَهُ فَيَدْعُوَ لِي بِدَعْوَةٍ تَكُونُ سَابِقَةً يَوْمَ الْقِيَامَةِ ، فَلَمَّا صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَقْبَلَ الرَّجُلُ مُسَلِّمًا عَلَيْهِ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" تَدْرِي بِكَمْ سَبَقَكَ أَصْحَابُكَ ؟ "" قَالَ : نَعَمْ سَبَقُونِي بِغُدْوَتِهِمُ الْبَارِحَةَ وَالْيَوْمِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" وَالَّذِي نَفْسِي بِيَدِهِ ، لَقَدْ سَبَقُوكَ بِأَبْعَدَ مَا بَيْنَ الْمَشْرِقَيْنِ وَالْمَغْرِبَيْنِ فِي الْفَضِيلَةِ  .","","Al-Mu'jam al-Kabir 423","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن عبد الله بن لهيعة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","معاذ بن أنس الجهني"
"18602","424  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وُهَيْبٍ الْغَزِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ ،  ثَنَا  رِشْدِينُ ،  عَنْ  زَبَّانَ بْنِ فَايِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 424","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن رشدين بن سعد المهري عن محمد بن المتوكل بن ابى السرى عن عبد الله بن وهيب الجذامي عن الطبراني","معاذ بن أنس الجهني"
"18603","425  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  زَبَّانَ بْنِ فَايِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ،  أَنَّهُ سَأَلَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ أَفْضَلِ الْإِيمَانِ ؟ قَالَ :  أَفْضَلُ الْإِيمَانِ أَنْ تُحِبَّ لِلهِ ، وَتُبْغِضَ لِلهِ ، وَتُعْمِلَ لِسَانَكَ فِي ذِكْرِ اللهِ  ، قَالَ : وَمَاذَا يَا رَسُولَ اللهِ ؟ قَالَ : "" وَأَنْ تُحِبَّ لِلنَّاسِ مَا تُحِبُّ لِنَفْسِكَ ، وَتَكْرَهَ لَهُمْ مَا تَكْرَهُ لِنَفْسِكَ ، وَأَنْ تَقُولَ خَيْرًا أَوْ تَصْمُتَ  .","","Al-Mu'jam al-Kabir 425","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن عبد الله بن لهيعة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","معاذ بن أنس الجهني"
"18604","426  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وُهَيْبٍ الْغَزِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ ،  ثَنَا  رِشْدِينُ ،  عَنْ  زَبَّانَ بْنِ فَايِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، عَنْ رَسُولِ         [20/192]      اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 426","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن رشدين بن سعد المهري عن محمد بن المتوكل بن ابى السرى عن عبد الله بن وهيب الجذامي عن الطبراني","معاذ بن أنس الجهني"
"18605","427  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  زَبَّانَ بْنِ فَائِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَلَا أُخْبِرُكُمْ لِمَ سَمَّى اللهُ  إِبْرَاهِيمَ  خَلِيلَهُ  الَّذِي وَفَّى ؟  لِأَنَّهُ كَانَ يَقُولُ كُلَّمَا أَصْبَحَ أَوْ أَمْسَى :         {      فَسُبْحَانَ اللهِ حِينَ تُمْسُونَ وَحِينَ تُصْبِحُونَ         }      حَتَّى خَتَمَ الْآيَةَ  .","","Al-Mu'jam al-Kabir 427","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن عبد الله بن لهيعة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","معاذ بن أنس الجهني"
"18606","428  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وُهَيْبٍ الْغَزِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ ،  ثَنَا  رِشْدِينُ ،  عَنْ  زَبَّانَ بْنِ فَائِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذٍ ،  عَنْ  أَبِيهِ  ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، نَحْوَهُ .","","Al-Mu'jam al-Kabir 428","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن رشدين بن سعد المهري عن محمد بن المتوكل بن ابى السرى عن عبد الله بن وهيب الجذامي عن الطبراني","معاذ بن أنس الجهني"
"18607","429  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  زَبَّانَ بْنِ فَائِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ كَانَ يَقُولُ :  آيَةُ الْعِزَّةِ لِلهِ :         {      وَقُلِ الْحَمْدُ لِلهِ الَّذِي لَمْ يَتَّخِذْ وَلَدًا وَلَمْ يَكُنْ لَهُ شَرِيكٌ فِي الْمُلْكِ وَلَمْ يَكُنْ لَهُ وَلِيٌّ مِنَ الذُّلِّ وَكَبِّرْهُ تَكْبِيرًا         }      .","","Al-Mu'jam al-Kabir 429","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن عبد الله بن لهيعة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","معاذ بن أنس الجهني"
"18608","430  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  رِشْدِينُ بْنُ سَعْدٍ ،  عَنْ  زَبَّانَ بْنِ فَائِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  آيَةُ الْعِزَّةِ :         {      وَقُلِ الْحَمْدُ لِلهِ الَّذِي لَمْ يَتَّخِذْ وَلَدًا وَلَمْ يَكُنْ لَهُ شَرِيكٌ فِي الْمُلْكِ وَلَمْ يَكُنْ لَهُ وَلِيٌّ مِنَ الذُّلِّ وَكَبِّرْهُ تَكْبِيرًا         }      .         [20/193]","","Al-Mu'jam al-Kabir 430","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن رشدين بن سعد المهري عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","معاذ بن أنس الجهني"
"18609","431  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَبْنَا  اللَّيْثُ بْنُ سَعْدٍ ، (  ح  )  وَحَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  اللَّيْثُ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ارْكَبُوا هَذِهِ الدَّوَابَّ سَالِمَةً ، وَايْتَدِعُوهَا سَالِمَةً  .","","Al-Mu'jam al-Kabir 431","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن سعيد بن الحكم الجمحي عن يوسف بن يزيد القراطيسي عن الطبراني","معاذ بن أنس الجهني"
"18610","432  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وُهَيْبٍ الْغَزِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ ،  ثَنَا  رِشْدِينُ ،  عَنْ  زَبَّانَ بْنِ فَايِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  مَرَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى قَوْمٍ عَلَى دَوَابَّ لَهُمْ وَرَوَاحِلَ ، وَهُمْ وُقُوفٌ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ارْكَبُوهَا سَالِمَةً ، وَانْزِلُوا عَنْهَا سَالِمَةً  ، وَلَا تَتَّخِذُوهَا كَرَاسِيَّ لِأَحَادِيثِكُمْ وَمَجَالِسِكُمْ ، فَلَرُبَّ مَرْكُوبَةٍ خَيْرٌ مِنْ رَاكِبِهَا ، وَأَكْثَرُ ذِكْرًا لِلهِ مِنْهُ  .         [20/194]","","Al-Mu'jam al-Kabir 432","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن رشدين بن سعد المهري عن محمد بن المتوكل بن ابى السرى عن عبد الله بن وهيب الجذامي عن الطبراني","معاذ بن أنس الجهني"
"18611","433  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  يَحْيَى بْنِ أَيُّوبَ ،  عَنْ  عَبْدِ اللهِ بْنِ سُلَيْمَانَ ، أَنَّ إِسْمَاعِيلَ بْنَ يَحْيَى الْمَعَافِرِيَّ  حَدَّثَهُ  ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ حَمَى مُؤْمِنًا مِنْ مُنَافِقٍ يَغْتَابُهُ بَعَثَ اللهُ مَلَكًا يَحْمِي لَحْمَهُ يَوْمَ الْقِيَامَةِ مِنْ نَارِ  جَهَنَّمَ  ، وَمَنْ قَفَّا مُسْلِمًا بِشَيْءٍ يُرِيدُ شَيْنَهُ بِهِ حَبَسَهُ اللهُ عَلَى جِسْرِ  جَهَنَّمَ  حَتَّى يَخْرُجَ مِمَّا قَالَ  .","","Al-Mu'jam al-Kabir 433","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن إسماعيل بن يحيى المعافري عن عبد الله بن سليمان بن زرعة الحميري عن يحيى بن أيوب الغافقي عن عبد الله بن المبارك عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","معاذ بن أنس الجهني"
"18612","434  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  أَسِيدِ بْنِ عَبْدِ الرَّحْمَنِ الْخَثْعَمِيِّ ،  عَنْ  سَهْلِ بْنِ مُعَاذٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  غَزَوْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ غَزْوَةَ كَذَا وَكَذَا ، فَضَيَّقَ النَّاسُ الْمَنَازِلَ وَقَطَعُوا الطَّرِيقَ ، فَبَعَثَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُنَادِيًا فَنَادَى فِي النَّاسِ :  أَنَّ مَنْ ضَيَّقَ مَنْزِلًا أَوْ قَطَعَ طَرِيقًا فَلَا  جِهَادَ  لَهُ  .","","Al-Mu'jam al-Kabir 434","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن أسيد بن عبد الرحمن الخثعمي عن إسماعيل بن عياش الأحول عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","معاذ بن أنس الجهني"
"18613","435  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ الْحِمْصِيُّ ،  ثَنَا  عَمْرُو بْنُ عُثْمَانَ ،  ثَنَا  بَقِيَّةُ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  أَسِيدِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  قُرَّةَ بْنِ مُجَاهِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  غَزَوْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَبَعَثَ مُنَادِيًا :  مَنْ ضَيَّقَ مَنْزِلًا أَوْ قَطَعَ طَرِيقًا فَلَا  جِهَادَ  لَهُ  .","","Al-Mu'jam al-Kabir 435","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن فروة بن مجاهد اللخمي عن أسيد بن عبد الرحمن الخثعمي عن أبو عمرو الأوزاعي عن بقية بن الوليد عن عمرو بن عثمان بن سعيد الحمصي عن إبراهيم بن محمد بن عرق الحمصي عن الطبراني","معاذ بن أنس الجهني"
"18614","436  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ         [20/195]      ثَنَا  رِشْدِينُ ،  عَنْ  زَبَّانَ بْنِ فَايِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا سَمِعْتُمُ الْمُؤَذِّنَ  يُثَوِّبُ  بِالصَّلَاةِ فَقُولُوا كَمَا يَقُولُ  .","","Al-Mu'jam al-Kabir 436","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن رشدين بن سعد المهري عن محمد بن المتوكل بن ابى السرى عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","معاذ بن أنس الجهني"
"18615","437  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ غُلَيْبٍ الْمِصْرِيُّ ،  ثَنَا  سَعِيدُ بْنُ عُفَيْرٍ ،  ثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  زَبَّانَ بْنِ فَايِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مِنَ الْعِبَادِ عِبَادٌ لَا يُكَلِّمُهُمُ اللهُ يَوْمَ الْقِيَامَةِ وَلَا  يُزَكِّيهِمْ  ، وَلَا يَنْظُرُ إِلَيْهِمْ  ، قَالُوا : مَنْ أُولَئِكَ يَا رَسُولَ اللهِ ؟ قَالَ : "" مُتَبَرِّئٌ مِنْ وَالِدَيْهِ رَاغِبٌ عَنْهُمَا ، وَمُتَبَرِّئٌ مِنْ وَلَدِهِ ، وَرَجُلٌ أَنْعَمَ عَلَيْهِ قَوْمٌ نِعْمَةً فَكَفَرَ بِنِعْمَتِهِمْ وَتَبَرَّأَ مِنْهُمْ  .","","Al-Mu'jam al-Kabir 437","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن يحيى بن أيوب الغافقي عن سعيد بن كثير بن عفير عن الحسن بن غليب المصري عن الطبراني","معاذ بن أنس الجهني"
"18616","439  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وُهَيْبٍ الْغَزِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ ،  ثَنَا  رِشْدِينُ ،  عَنْ  زَبَّانَ بْنِ فَايِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَنْ تَزَالَ أُمَّتِي عَلَى شَرِيعَةٍ حَسَنَةٍ مَا لَمْ يَظْهَرْ فِيهِمْ ثَلَاثٌ  : مَا لَمْ يُقْبَضْ مِنْهُمُ الْعِلْمُ ، وَيَكْثُرْ فِيهِمْ وَلَدُ الْحِنْثِ ، وَيَظْهَرْ فِيهِمُ  الصَّقَّارُونَ  "" ، قِيلَ : يَا نَبِيَّ اللهِ ، وَمَا  الصَّقَّارُونَ  ؟ قَالَ : "" نَشْءٌ يَكُونُ فِي آخِرِ الزَّمَانِ تَحِيَّتُهُمْ بَيْنَهُمُ التَّلَاعُنُ  .","","Al-Mu'jam al-Kabir 439","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن رشدين بن سعد المهري عن محمد بن المتوكل بن ابى السرى عن عبد الله بن وهيب الجذامي عن الطبراني","معاذ بن أنس الجهني"
"18617","440  -  حَدَّثَنَا  عُمَرُ بْنُ عَبْدِ الْعَزِيزِ بْنِ مِقْلَاصٍ ،  حَدَّثَنِي  أَبِي  ، (  ح  )  وَحَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ ،  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَا :  ثَنَا  ابْنُ         [20/196]      وَهْبٍ ،  حَدَّثَنِي  سَعِيدُ بْنُ أَبِي أَيُّوبَ ،  عَنْ  خَيْرِ بْنِ نُعَيْمٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعَثَ سَرِيَّةً فَجَاءَتِ  امْرَأَةٌ  فَقَالَتْ : يَا رَسُولَ اللهِ ، إِنَّ زَوْجِي يَخْرُجُ فِي هَذِهِ السَّرِيَّةِ ، وَإِنِّي كُنْتُ أُصَلِّي بِصَلَاتِهِ ، وَأَصُومُ بِصِيَامِهِ ، وَأَتَعَبَّدُ بِعِبَادَتِهِ ، فَدُلَّنِي عَلَى عَمَلٍ أُدْرِكُ بِهِ عَمَلَهُ ، فَقَالَ :  فَهَلْ تَسْتَطِيعِينَ أَنْ تَقُومِي فَلَا تَفْتُرِي ، وَتَصُومِي فَلَا تُفْطِرِي ، وَتَذْكُرِي فَلَا تَغْفُلِي ؟  قَالَتْ : يَا رَسُولَ اللهِ ، وَهَلْ يَسْتَطِيعُ ذَاكَ أَحَدٌ ؟ فَقَالَ : "" لَوْ طُوِّقْتِ ذَاكَ وَالَّذِي نَفْسِي بِيَدِهِ لَمْ يَبْلُغِ الْعُشْرَ مِنْ ذَلِكَ  .","","Al-Mu'jam al-Kabir 440","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن خير بن نعيم الناهضى عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن وهب المصري عن عبد العزيز بن عمران المصري عن عمر بن عبد العزيز الخزاعي عن الطبراني","معاذ بن أنس الجهني"
"18618","441  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وُهَيْبٍ الْغَزِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ ،  ثَنَا  رِشْدِينُ ،  عَنْ  زَبَّانَ بْنِ فَائِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ  امْرَأَةً  أَتَتِ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَتْ : إِنَّ زَوْجِي انْطَلَقَ غَازِيًا فِي  سَبِيلِ  اللهِ وَكُنْتُ أَقْتَدِي بِصَلَاتِهِ إِذَا صَلَّى وَبِفِعْلِهِ ، فَأَخْبِرْنِي بِعَمَلٍ يُبْلِغُنِي عَمَلَهُ حَتَّى يَرْجِعَ ؟ قَالَ لَهَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَتَسْتَطِيعِينَ أَنْ تَقُومِي فَلَا تَقْعُدِي ، وَتَذْكُرِي فَلَا تَفْتُرِي ، وَتَصُومِي وَلَا تُفْطِرِي حَتَّى يَرْجِعَ ؟  فَقَالَتْ : مَا أَسْتَطِيعُ هَذَا يَا رَسُولَ اللهِ ، قَالَ : "" فَوَالَّذِي نَفْسِي بِيَدِهِ ، لَوْ فَعَلْتِ مَا بَلَغْتِ الْعُشْرَ مِنْ عَمَلِهِ حَتَّى يَرْجِعَ  .","","Al-Mu'jam al-Kabir 441","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن رشدين بن سعد المهري عن محمد بن المتوكل بن ابى السرى عن عبد الله بن وهيب الجذامي عن الطبراني","معاذ بن أنس الجهني"
"18619","442  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  ابْنُ         [20/197]      لَهِيعَةَ ،  عَنْ  زَبَّانَ بْنِ فَايِدٍ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ وُهَيْبٍ الْغَزِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ ،  ثَنَا  رِشْدِينُ ،  عَنْ  زَبَّانَ بْنِ فَايِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ قَعَدَ فِي مُصَلَّاهُ حِينَ يُصَلِّي الْغَدَاةَ حَتَّى يُصَلِّيَ الضُّحَى لَا يَقُولُ إِلَّا خَيْرًا ؛ غُفِرَتْ لَهُ خَطَايَاهُ  ، وَإِنْ كَانَتْ أَكْثَرَ مِنْ زَبَدِ الْبَحْرِ  وَاللَّفْظُ لِحَدِيثِ  رِشْدِينَ  .","","Al-Mu'jam al-Kabir 442","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","معاذ بن أنس الجهني"
"18620","443  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وُهَيْبٍ الْغَزِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ ،  ثَنَا  رِشْدِينُ ،  عَنْ  زَبَّانَ بْنِ فَايِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ قَرَأَ أَوَّلَ سُورَةِ الْكَهْفِ وَآخِرَهَا كَانَتْ لَهُ نُورًا مِنْ قَدَمِهِ إِلَى رَأْسِهِ  ، وَمَنْ قَرَأَهَا كُلَّهَا كَانَتْ لَهُ نُورًا مِنْ قَدَمِهِ إِلَى رَأْسِهِ مِنَ الْأَرْضِ إِلَى السَّمَاءِ  .","","Al-Mu'jam al-Kabir 443","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن رشدين بن سعد المهري عن محمد بن المتوكل بن ابى السرى عن عبد الله بن وهيب الجذامي عن الطبراني","معاذ بن أنس الجهني"
"18621","444  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وُهَيْبٍ الْغَزِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ ،  ثَنَا  رِشْدِينُ ،  عَنْ  زَبَّانَ بْنِ فَايِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  .         [20/198]","","Al-Mu'jam al-Kabir 444","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن رشدين بن سعد المهري عن محمد بن المتوكل بن ابى السرى عن عبد الله بن وهيب الجذامي عن الطبراني","معاذ بن أنس الجهني"
"18622","445  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وُهَيْبٍ الْغَزِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ ،  ثَنَا  رِشْدِينُ ،  عَنْ  زَبَّانَ بْنِ فَائِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ قَالَ سُبْحَانَ اللهِ الْعَظِيمِ بُنِيَ لَهُ غَرْسٌ فِي الْجَنَّةِ  ، وَمَنْ قَرَأَ الْقُرْآنَ فَأَحْكَمَهُ وَعَمِلَ بِمَا فِيهِ أَلْبَسَ اللهُ وَالِدَيْهِ يَوْمَ الْقِيَامَةِ تَاجًا ضَوْءُهُ أَحْسَنُ مِنْ هَذَا الْقَمَرِ  .","","Al-Mu'jam al-Kabir 445","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن رشدين بن سعد المهري عن محمد بن المتوكل بن ابى السرى عن عبد الله بن وهيب الجذامي عن الطبراني","معاذ بن أنس الجهني"
"18623","446  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو نُعَيْمٍ ضِرَارُ بْنُ صُرَدٍ ،  عَنْ  يَحْيَى بْنِ أَيُّوبَ ،  عَنْ  زَبَّانَ بْنِ فَائِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ عَلَّمَ عِلْمًا فَلَهُ أَجْرُ مَا عَمِلَ بِهِ عَامَلٌ  ، وَلَا يَنْقُصُ مِنْ أَجْرِ الْعَامِلِ  .","","Al-Mu'jam al-Kabir 446","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن يحيى بن أيوب الغافقي عن ضرار بن صرد التيمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","معاذ بن أنس الجهني"
"18624","447  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  رِشْدِينُ بْنُ سَعْدٍ ،  عَنْ  زَبَّانَ بْنِ فَائِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ         [20/199]      قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ بَرَّ وَالِدَيْهِ طُوبَى لَهُ  ، زَادَ اللهُ فِي عُمُرِهِ  .","","Al-Mu'jam al-Kabir 447","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن زبان بن فائد الحمراوي عن رشدين بن سعد المهري عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","معاذ بن أنس الجهني"
"18625","مَا  أَسْنَدَ  مَعْقِلُ بْنُ يَسَارٍ  الْحَسَنُ بْنُ أَبِي الْحَسَنِ  ، عَنْ  مَعْقِلٍ  قَتَادَةُ  ، عَنِ  الْحَسَنِ  448  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  مُحَمَّدُ بْنُ حُمَيْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُخْتَارِ ،  عَنْ  شُعْبَةَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَعْطَى الْجَدَّةَ سُدُسًا  .","","Al-Mu'jam al-Kabir 448","","معقل بن يسار المزني عن الحسن البصري عن قتادة بن دعامة عن شعبة بن الحجاج عن حبويه ، إبراهيم بن المختار عن محمد بن حميد الرازي عن عبد الله بن أحمد بن حنبل عن الطبراني","قتادة عن الحسن"
"18626","449  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ الْجُنْدَيْسَابُورِيُّ ،  ثَنَا  مَحْمُودُ بْنُ غَيْلَانَ ،  ثَنَا  مُؤَمَّلُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ         [20/200]      مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَا مِنْ عَبْدٍ يُسْتَرْعَى رَعِيَّةً فَيَمُوتُ وَهُوَ لَهَا غَاشٌّ إِلَّا دَخَلَ النَّارَ  .","","Al-Mu'jam al-Kabir 449","","معقل بن يسار المزني عن الحسن البصري عن قتادة بن دعامة عن حماد بن سلمة عن مؤمل بن إسماعيل العدوي عن محمود بن غيلان المروزي عن محمد بن جابان الجند يسابوري عن الطبراني","قتادة عن الحسن"
"18627","يُونُسُ بْنُ عُبَيْدٍ  ، عَنِ  الْحَسَنِ  ، عَنْ  مَعْقِلٍ  450  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، وَالْفَضْلُ بْنُ الْحُبَابِ الْجُمَحِيُّ ، قَالَا :  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  يُونُسُ بْنُ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ، قَالَ :  بَيْنَمَا مَعْقِلُ بْنُ يَسَارٍ يَتَغَدَّى إِذْ سَقَطَتْ مِنْهُ لُقْمَةٌ ، فَأَخَذَهَا فَأَمَاطَ مَا كَانَ فِيهَا مِنَ الْأَذَى وَأَكَلَهَا ، فَقِيلَ لَهُ : أَصْلَحَ اللهُ الْأَمِيرَ ، إِنَّ هَؤُلَاءِ  الْأَعْلَاجَ  يَتَغَامَزُونَ مِنْ أَكْلِكَ اللُّقْمَةَ ، وَبَيْنَ يَدَيْكَ هَذَا الطَّعَامُ ، قَالَ : "" إِنِّي لَمْ أَكُنْ لِأَدَعَ مَا سَمِعْتُ لِهَؤُلَاءِ  الْأَعْلَاجِ  ،  إِنَّا كُنَّا نُؤْمَرُ إِنْ أَحَدُنَا سَقَطَتْ لُقْمَتُهُ أَنْ يَأْخُذَهَا فَيُمِيطَ مَا كَانَ بِهَا مِنَ الْأَذَى وَيَأْكُلَهَا وَلَا يَدَعَهَا لِلشَّيْطَانِ  .","","Al-Mu'jam al-Kabir 450","","معقل بن يسار المزني عن الحسن البصري عن يونس بن عبيد عن يزيد بن زريع العيشي عن مسدد بن مسرهد عن الفضل بن الحباب الجمحي عن الطبراني","يونس بن عبيد عن الحسن عن معقل"
"18628","451  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  عَامِرُ بْنُ صَالِحٍ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : كُنَّا نُؤْمَرُ ، فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 451","","معقل بن يسار المزني عن الحسن البصري عن يونس بن عبيد عن عامر بن أبي صالح الخزاز عن محمد بن أبي بكر المقدمي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","يونس بن عبيد عن الحسن عن معقل"
"18629","452  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مَرْزُوقٍ ،  ثَنَا  عَتَّابُ بْنُ حَرْبٍ ،  ثَنَا  الْمَضَاءِ الْخَزَّازُ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  إِذَا سَقَطَتْ لُقْمَةُ أَحَدِكُمْ  فَلْيُمِطْ  مَا كَانَ بِهَا مِنَ الْأَذَى ، وَلْيَأْكُلْهَا وَلَا يُعِدْهَا لِلشَّيْطَانِ  .         [20/201]","","Al-Mu'jam al-Kabir 452","","معقل بن يسار المزني عن الحسن البصري عن يونس بن عبيد عن مضاء الخراز عن عتاب بن حرب المديني عن محمد بن مرزوق بن النعمان البصري عن إبراهيم بن هاشم البغوي عن الطبراني","يونس بن عبيد عن الحسن عن معقل"
"18630","453  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْهَيْجَمِيُّ ،  ثَنَا  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الْجُمَحِيُّ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِذَا سَقَطَتْ لُقْمَةُ أَحَدِكُمْ  فَلْيُمِطْ  مَا كَانَ عَلَيْهَا مِنَ الْأَذَى وَلْيَأْكُلْهَا  .","","Al-Mu'jam al-Kabir 453","","معقل بن يسار المزني عن الحسن البصري عن يونس بن عبيد عن عثمان بن عبد الرحمن بن عبد الله الجمحي عن محمد بن بحر الهجيمي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","يونس بن عبيد عن الحسن عن معقل"
"18631","454  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مَرْزُوقٍ ،  ثَنَا  عَتَّابُ بْنُ حَرْبٍ ،  عَنِ  الْمَضَاءِ الْخَزَّازِ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ، قَالَ :  قَالَ  مَعْقِلُ بْنُ يَسَارٍ :  كُنْتُ  يَوْمَ بَيْعَةِ الرِّضْوَانِ  رَافِعًا غُصْنًا مِنْ أَغْصَانِ الشَّجَرَةِ ، عَنْ رَأْسِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ  يُبَايِعُ  النَّاسَ ،  لَمْ  يُبَايِعْهُمْ  عَلَى الْمَوْتِ ، بَايَعَهُمْ عَلَى أَنْ لَا يَفِرُّوا ، وَكَانَ يُصَافِحُ النِّسَاءَ مِنْ تَحْتِ الثَّوْبِ  .","","Al-Mu'jam al-Kabir 454","","معقل بن يسار المزني عن الحسن البصري عن يونس بن عبيد عن مضاء الخراز عن عتاب بن حرب المديني عن محمد بن مرزوق بن النعمان البصري عن إبراهيم بن هاشم البغوي عن الطبراني","يونس بن عبيد عن الحسن عن معقل"
"18632","455  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  خَلَفُ بْنُ هِشَامٍ ،  ثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ،  أَنَّ  مَعْقِلَ بْنَ يَسَارٍ ، مَرِضَ فَأَتَاهُ  عُبَيْدُ اللهِ بْنُ زِيَادٍ  يَعُودُهُ ، فَقَالَ لَهُ  مَعْقِلٌ  : لَأُحَدِّثَنَّكَ بِحَدِيثٍ لَمْ أُحَدِّثْكَ ، إِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَا مِنْ عَبْدٍ اسْتَرْعَاهُ اللهُ رَعِيَّةً ، فَمَاتَ وَهُوَ غَاشٌّ لَهَا إِلَّا حَرَّمَ اللهُ عَلَيْهِ الْجَنَّةَ  .","","Al-Mu'jam al-Kabir 455","","معقل بن يسار المزني عن الحسن البصري عن يونس بن عبيد عن خالد بن عبد الله الطحان عن خلف بن هشام البزار عن موسى بن هارون الحمال عن الطبراني","يونس بن عبيد عن الحسن عن معقل"
"18633","456  -  حَدَّثَنَا  يَحْيَى بْنُ مُحَمَّدٍ الْحِنَّائِيُّ ،  ثَنَا  أَبُو كَامِلٍ الْجَحْدَرِيُّ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ قَالَ :  دَخَلَ  عُبَيْدُ اللهِ بْنُ زِيَادٍ  عَلَى  مَعْقِلِ بْنِ يَسَارٍ  يَعُودُهُ وَنَحْنُ عِنْدَهُ ،  فَقَالَ  مَعْقِلٌ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  أَيُّمَا رَجُلٍ اسْتَرْعَاهُ اللهُ رَعِيَّةً ، فَمَاتَ وَهُوَ غَاشٌّ لَهَا حَرَّمَ اللهُ عَلَيْهِ الْجَنَّةَ  .         [20/202]","","Al-Mu'jam al-Kabir 456","","معقل بن يسار المزني عن الحسن البصري عن يونس بن عبيد عن يزيد بن زريع العيشي عن فضيل بن حسين الجحدري عن يحيى بن محمد بن البختري الحنائي عن الطبراني","يونس بن عبيد عن الحسن عن معقل"
"18634","457  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  أَبُو إِسْرَائِيلَ الْمُلَائِيُّ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَنْ يَسْتَرْعِيَ اللهُ عَبْدًا رَعِيَّةً يَمُوتُ وَهُوَ غَاشٌّ لَهَا إِلَّا حَرَّمَ اللهُ عَلَيْهِ الْجَنَّةَ  .","","Al-Mu'jam al-Kabir 457","","معقل بن يسار المزني عن الحسن البصري عن يونس بن عبيد عن إسماعيل بن خليفة الملائي عن إسماعيل بن عمرو البجلي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","يونس بن عبيد عن الحسن عن معقل"
"18635","458  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  إِسْمَاعِيلُ ابْنُ عُلَيَّةَ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 458","","معقل بن يسار المزني عن الحسن البصري عن يونس بن عبيد عن إسماعيل ابن علية عن عثمان ابن أبي شيبة عن الحسن بن علي بن شبيب المعمري عن الطبراني","يونس بن عبيد عن الحسن عن معقل"
"18636","459  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ الْجُذُوعِيُّ ،  ثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ عِيسَى ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 459","","معقل بن يسار المزني عن الحسن البصري عن يونس بن عبيد عن عبد الله بن عيسى بن خالد الخزاز عن عقبة بن مكرم عن الجذوعى محمد بن محمد بن إسماعيل عن الطبراني","يونس بن عبيد عن الحسن عن معقل"
"18637","460  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ عِيسَى ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ،  أَنَّهُ دَخَلَ عَلَى  عُبَيْدِ اللهِ بْنِ زِيَادٍ  يَعُودُهُ فَقَالَ لَهُ  مَعْقِلٌ  : إِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ عُقُوبَةَ هَذِهِ الْأُمَّةِ السَّيْفُ  ، وَمَوْعِدَهُمُ السَّاعَةُ ، وَالسَّاعَةُ أَدْهَى وَأَمَرُّ  .","","Al-Mu'jam al-Kabir 460","","معقل بن يسار المزني عن الحسن البصري عن يونس بن عبيد عن عبد الله بن عيسى بن خالد الخزاز عن عقبة بن مكرم عن عبد الله بن أحمد الجواليقي عن الطبراني","يونس بن عبيد عن الحسن عن معقل"
"18638","461  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ الرَّقِّيُّ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَعْطَى الْجَدَّةَ السُّدُسَ  .         [20/203]","","Al-Mu'jam al-Kabir 461","","معقل بن يسار المزني عن الحسن البصري عن يونس بن عبيد عن يزيد بن زريع العيشي عن محمد بن الفضل السدوسي عن حفص بن عمر سنجة ألف عن الطبراني","يونس بن عبيد عن الحسن عن معقل"
"18639","462  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ،  أَنَّ  عُمَرَ  قَالَ : مَنْ يَعْلَمُ قَضِيَّةَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْجَدِّ ؟  فَقَالَ  مَعْقِلُ بْنُ يَسَارٍ :  قَضَى لَهُ بِالسُّدُسِ  .","","Al-Mu'jam al-Kabir 462","","معقل بن يسار المزني عن الحسن البصري عن يونس بن عبيد عن عبد الأعلى بن عبد الأعلى القرشي عن أبو بكر ابن أبي شيبة عن عبد الله بن أحمد الجواليقي عن الطبراني","يونس بن عبيد عن الحسن عن معقل"
"18640","463  -  حَدَّثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  عَامِرُ بْنُ صَالِحٍ  ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ،  أَنَّ  عُمَرَ  ، قَالَ :  مَنْ يَعْلَمُ مِنْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَضَى فِي الْجَدِّ ؟  فَقَالَ  لَهُ مَعْقِلُ بْنُ يَسَارٍ : أَنَا ، قَالَ لَهُ : كَمْ لَهُ ؟ قَالَ : "" السُّدُسُ "" ، قَالَ : مَنْ مَعَهُ ؟ قَالَ : لَا أَدْرِي ، قَالَ : لَا دَرَيْتَ  .  كذا في طبعة مكتبة ابن تيمية ، ولعل الصواب: ( ابن أبي صالح ) .","","Al-Mu'jam al-Kabir 463","","معقل بن يسار المزني عن الحسن البصري عن يونس بن عبيد عن عامر بن أبي صالح الخزاز عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","يونس بن عبيد عن الحسن عن معقل"
"18641","464  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ، وَمُحَمَّدُ بْنُ يَحْيَى بْنِ مَنْدَهْ الْأَصْبَهَانِيُّ قَالَا :  ثَنَا  مُحَمَّدُ بْنُ حُمَيْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُخْتَارِ ،  عَنْ  شُعْبَةَ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَعْطَى الْجَدَّ السُّدُسَ  .","","Al-Mu'jam al-Kabir 464","","معقل بن يسار المزني عن الحسن البصري عن يونس بن عبيد عن شعبة بن الحجاج عن حبويه ، إبراهيم بن المختار عن محمد بن حميد الرازي عن محمد بن يحيى بن مندة عن الطبراني","يونس بن عبيد عن الحسن عن معقل"
"18642","465  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَالِدٍ الْمِصِّيصِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عِيسَى الطَّبَّاعُ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّزِايُّ ،  ثَنَا  الْهَيْثَمُ بْنُ يَمَانٍ قَالَا :  ثَنَا  هُشَيْمٌ ،  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ قَالَ :  قَضَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي جَدٍّ كَانَ بَيْنَنَا بِالسُّدُسِ  .         [20/204]","","Al-Mu'jam al-Kabir 465","","معقل بن يسار المزني عن الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن الهيثم بن اليمان الرازي عن علي بن سعيد بن بشير عليك عن الطبراني","يونس بن عبيد عن الحسن عن معقل"
"18643","466  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَا :  ثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  ثَنَا  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الْجُمَحِيُّ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، إِنِّي لَآخُذُ الْعَنْزَ لِأَذْبَحَهَا فَأَرْحَمَهَا ، قَالَ : "" وَإِنْ رَحِمْتَهَا رَحِمَكَ اللهُ  .","","Al-Mu'jam al-Kabir 466","","معقل بن يسار المزني عن الحسن البصري عن يونس بن عبيد عن عثمان بن عبد الرحمن بن عبد الله الجمحي عن سويد بن سعيد الحدثاني عن الحسين بن إسحاق التستري عن الطبراني","يونس بن عبيد عن الحسن عن معقل"
"18644","467  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  سَلَمَةُ بْنُ شَبِيبٍ ،  ثَنَا  يَزِيدُ بْنُ أَبِي حَكِيمٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ طَهْمَانَ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ،  فِي قَوْلِ اللهِ عَزَّ وَجَلَّ :         {      فَلا تَعْضُلُوهُنَّ أَنْ يَنْكِحْنَ أَزْوَاجَهُنَّ إِذَا تَرَاضَوْا بَيْنَهُمْ بِالْمَعْرُوفِ         }      قَالَ :  حَدَّثَنِي  مَعْقِلُ بْنُ يَسَارٍ أَنَّهَا فِيهِ نَزَلَتْ ، قَالَ : زَوَّجْتُ أُخْتًا لِي مِنْ رَجُلٍ فَطَلَّقَهَا ، ثُمَّ تَرَكَهَا حَتَّى إِذَا انْقَضَتْ عِدَّتُهَا خَطَبَهَا ، فَقُلْتُ : زَوَّجْتُكَ وَفَرَشْتُكَ وَأَكْرَمْتُكَ فَطَلَّقْتَهَا ، ثُمَّ جِئْتَ تَخْطُبُهَا ؟ لَا وَاللهِ لَا تَعُودُ إِلَيْكَ أَبَدًا ، وَكَانَ رَجُلًا لَا بَأْسَ بِهِ ، وَكَانَتْ تُرِيدُ أَنْ تَرْجِعَ إِلَيْهِ ، فَأَنْزَلَ اللهُ هَذِهِ الْآيَةَ ، فَقُلْتُ : "" الْآنَ أَفْعَلُ يَا رَسُولَ اللهِ ، فَزَوَّجْتُهَا إِيَّاهُ  .","","Al-Mu'jam al-Kabir 467","","معقل بن يسار المزني عن الحسن البصري عن يونس بن عبيد عن إبراهيم بن طهمان عن يزيد بن أبي حكيم الكناني عن سلمة بن شبيب المسمعي عن عبد الله بن أحمد بن حنبل عن الطبراني","يونس بن عبيد عن الحسن عن معقل"
"18645","عَبَّادُ بْنُ رَاشِدٍ  ، عَنِ  الْحَسَنِ  468  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ الْجُذُوعِيُّ الْقَاضِي ،  ثَنَا  عُقْبَةُ بْنُ         [20/205]      مُكْرَمٍ الْعَمِّيُّ ،  ثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ الْحَضْرَمِيُّ ، (  ح  )  وَحَدَّثَنَا  الْعَبَّاسُ بْنُ حَمْدَانَ الْأَصْبَهَانِيُّ ،  ثَنَا  هِلَالُ بْنُ بِشْرٍ ،  ثَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ، قَالَا :  ثَنَا  عَبَّادُ بْنُ رَاشِدٍ ،  عَنِ  الْحَسَنِ ،  ثَنَا  مَعْقِلُ بْنُ يَسَارٍ ، قَالَ :  كَانَتْ عِنْدِي أُخْتٌ لِي تُخْطَبُ فَأَمْنَعُهَا مِنَ النَّاسِ  ، فَجَاءَنِي ابْنُ عَمٍّ لِي فَزَوَّجْتُهَا إِيَّاهُ ، فَاصْطَحَبَا مَا شَاءَ اللهُ ، ثُمَّ طَلَّقَهَا طَلَاقًا لَهُ عَلَيْهَا رَجْعَةٌ ، فَلَمَّا انْقَضَتْ عِدَّتُهَا أَتَانِي يَخْطُبُهَا مَعَ الْخُطَّابِ ، فَقُلْتُ لَهُ : مَنَعْتُهَا مِنَ النَّاسِ وَآثَرْتُكَ بِهَا فَزَوَّجْتُكَ ، ثُمَّ طَلَّقْتَهَا ، وَاللهِ لَا أُزَوِّجُكَهَا أَبَدًا ، فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ :         {      وَإِذَا طَلَّقْتُمُ النِّسَاءَ فَبَلَغْنَ أَجَلَهُنَّ فَلا تَعْضُلُوهُنَّ أَنْ يَنْكِحْنَ أَزْوَاجَهُنَّ         }      . فَكَفَّرْتُ عَنْ يَمِينِي وَأَنْكَحْتُهَا  "" .","","Al-Mu'jam al-Kabir 468","","معقل بن يسار المزني عن الحسن البصري عن عباد بن راشد الكليبى عن أبو عامر العقدي عن هلال بن بشر بن محبوب الأحدب عن العباس بن حمدان الأصبهاني عن الطبراني","عباد بن راشد عن الحسن"
"18646","أَبُو عَتَّابٍ  ، عَنِ  الْحَسَنِ  ، عَنْ  مَعْقِلٍ  469  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  سَلَّامُ بْنُ مِسْكِينٍ أَبُو رَوْحٍ ،  ثَنَا  أَبُو عَتَّابٍ ،  عَنِ  الْحَسَنِ قَالَ :  دَخَلَ  زِيَادٌ  عَلَى مَعْقِلِ بْنِ يَسَارٍ وَهُوَ مَرِيضٌ يَعُودُهُ ، فَحَدَّثَهُ وَسَأَلَهُ ، وَلَاطَفَهُ ، فَبَيْنَا هُمْ كَذَلِكَ إِذْ قَالَ  مَعْقِلٌ  : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَا مِنْ وَالٍ وَلِيَ أَمْرَ الْمُسْلِمِينَ شَيْئًا فَلَمْ يُحِطْ مَنْ وَرَائِهِمْ  بِالنَّصِيحَةِ  إِلَّا أَكَبَّهُ اللهُ فِي  جَهَنَّمَ  عَلَى وَجْهِهِ يَوْمَ يَجْمَعُ اللهُ الْأَوَّلِينَ وَالْآخِرِينَ  .","","Al-Mu'jam al-Kabir 469","","معقل بن يسار المزني عن الحسن البصري عن منصور بن المعتمر عن سلام بن مسكين النمري عن شيبان بن فروخ الحبطي عن موسى بن هارون الحمال عن الطبراني","أبو عتاب عن الحسن عن معقل"
"18647","عَبْدُ السَّلَامِ بْنُ أَبِي الْجَنُوبِ  ، عَنِ  الْحَسَنِ  470  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  أَبُو مَعْشَرٍ ،  عَنْ  عَبْدِ السَّلَامِ بْنِ أَبِي الْجَنُوبِ ،  عَنِ  الْحَسَنِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمَدِينَةُ  مُهَاجَرِي وَمَضْجَعِي فِي         [20/206]      الْأَرْضِ  ، حَقٌّ عَلَى أُمَّتِي أَنْ يُكْرِمُوا جِيرَانِي مَا اجْتَنَبُوا الْكَبَائِرَ ، فَمَنْ لَمْ يَفْعَلْ ذَلِكَ مِنْهُمْ سَقَاهُ اللهُ مِنْ طِينَةِ  الْخَبَالِ  . "" قُلْنَا : يَا  أَبَا يَسَارٍ  ، مَا طِينَةُ  الْخَبَالِ  ؟ قَالَ : "" عُصَارَةُ أَهْلِ النَّارِ  .","","Al-Mu'jam al-Kabir 470","","معقل بن يسار المزني عن الحسن البصري عن عبد السلام بن أبي الجنوب المدني عن نجيح بن عبد الرحمن السندي عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","عبد السلام بن أبي الجنوب عن الحسن"
"18648","471  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ ، وَعَبْدُ اللهِ بْنُ الصَّبَّاحِ الْأَصْبَهَانِيُّ قَالَا :  ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  ثَنَا  أَبُو ضَمْرَةَ أَنَسُ بْنُ عِيَاضٍ ،  عَنْ  عَبْدِ السَّلَامِ بْنِ أَبِي الْجَنُوبِ ،  عَنِ  الْحَسَنِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُسْلِمُونَ  يَدٌ  عَلَى مَنْ سِوَاهُمْ  ،  تَتَكَافَأُ  دِمَاؤُهُمْ ، لَا يُقْتَلُ مُؤْمِنٌ بِكَافِرٍ ، وَلَا ذُو  عَهْدٍ  فِي عَهْدِهِ  .","","Al-Mu'jam al-Kabir 471","","معقل بن يسار المزني عن الحسن البصري عن عبد السلام بن أبي الجنوب المدني عن أنس بن عياض الليثي عن إبراهيم بن سعيد الجوهري عن عبد الله بن الصباح الأصبهاني عن الطبراني","عبد السلام بن أبي الجنوب عن الحسن"
"18649","هِشَامُ بْنُ حَسَّانَ  ، عَنِ  الْحَسَنِ  472  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ، (  ح  )  وَحَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ، وَعَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ، قَالَا :  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ، (  ح  )  وَحَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ ،  ثَنَا  أَبُو مُوسَى مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَا :  ثَنَا  عَبْدُ الْقُدُّوسِ بْنُ الْجَوَارِيِّ أَبُو الْحَوَارِيِّ ، قَالَا :  ثَنَا  هِشَامُ بْنُ حَسَّانَ ،  عَنِ  الْحَسَنِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنِ اسْتَرْعَاهُ اللهُ رَعِيَّةً ، فَمَاتَ وَهُوَ غَاشٌّ لَهَا إِلَّا حَرَّمَ اللهُ عَلَيْهِ الْجَنَّةَ  .         [20/207]","","Al-Mu'jam al-Kabir 472","","معقل بن يسار المزني عن الحسن البصري عن هشام بن حسان العتكي عن عبد القدوس بن الحواري عن أبو موسى الزمن عن الفضل بن الحباب الجمحي عن الطبراني","هشام بن حسان عن الحسن"
"18650","عَوْفُ بْنُ أَبِي جَمِيلَةَ  ، عَنِ  الْحَسَنِ  473  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ، وَمُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ، قَالَا :  ثَنَا  هَوْذَةُ بْنُ خَلِيفَةَ ،  ثَنَا  عَوْفٌ ،  عَنِ  الْحَسَنِ ، قَالَ :  مَرِضَ مَعْقِلُ بْنُ يَسَارٍ مَرَضًا ثَقُلَ فِيهِ ، فَأَتَاهُ  ابْنُ زِيَادٍ  يَعُودُهُ ،  فَقَالَ  : إِنِّي مُحَدِّثُكَ حَدِيثًا سَمِعْتُهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنِ اسْتُرْعِيَ رَعِيَّةً فَلَمْ يُحِطْهُمْ  بِنَصِيحَةٍ  لَمْ يَجِدْ رِيحَ الْجَنَّةِ  ، فَإِنَّ رِيحَهَا لَيُوجَدُ مِنْ  مَسِيرَةِ  مِائَةِ عَامٍ "" . فَقَالَ  ابْنُ زِيَادٍ  : أَلَا كُنْتَ حَدَّثْتَنِي بِهَذَا قَبْلَ الْآنَ ، قَالَ : "" فَالْآنَ لَوْلَا الَّذِي أَنَا عَلَيْهِ لَمْ أُحَدِّثْكَ بِهِ  .","","Al-Mu'jam al-Kabir 473","","معقل بن يسار المزني عن الحسن البصري عن عوف بن أبي جميلة عن هوذة بن خليفة البكراوي عن لحية الليف محمد بن العباس عن الطبراني","عوف بن أبي جميلة عن الحسن"
"18651","أَبُو الْأَشْهَبِ جَعْفَرُ بْنُ حَيَّانَ الْعُطَارِدِيُّ  ، عَنِ  الْحَسَنِ  474  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ ، وَمُوسَى بْنُ هَارُونَ ، قَالَا :  ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ، قَالَا :  ثَنَا  أَبُو الْأَشْهَبِ ،  عَنِ  الْحَسَنِ ، قَالَ :  عَادَ  عُبَيْدُ اللهِ بْنُ زِيَادٍ  مَعْقِلَ بْنَ يَسَارٍ فِي مَرَضِهِ الَّذِي قُبِضَ فِيهِ ، فَقَالَ  مَعْقِلٌ  : إِنِّي مُحَدِّثُكَ بِحَدِيثٍ سَمِعْتُهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، لَوْ عَلِمْتُ أَنَّ لِي حَيَاةً مَا حَدَّثْتُكَ بِهِ ، سَمِعْتُهُ يَقُولُ :  مَا مِنْ عَبْدٍ يَسْتَرْعِيهِ اللهُ رَعِيَّةً يَمُوتُ يَوْمَ يَمُوتُ غَاشًّا  لِرَعِيَّتِهِ إِلَّا حَرَّمَ اللهُ عَلَيْهِ الْجَنَّةَ  .  وَاللَّفْظُ  لِعَلِيِّ بْنِ الْجَعْدِ  .","","Al-Mu'jam al-Kabir 474","","معقل بن يسار المزني عن الحسن البصري عن جعفر بن حيان العطاردي عن علي بن الجعد عن موسى بن هارون الحمال عن الطبراني","أبو الأشهب جعفر بن حيان العطاردي عن الحسن"
"18652","[20/208]      الْفَضْلُ بْنُ دَلْهَمٍ  ، عَنِ  الْحَسَنِ  475  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  وَكِيعٌ ،  عَنِ  الْفَضْلِ بْنِ دَلْهَمٍ ،  عَنِ  الْحَسَنِ  ، عَنْ  مَعْقِلِ بْنِ يَسَارٍ ،  أَنَّ  أُخْتَهُ طَلَّقَهَا زَوْجُهَا ، فَأَرَادَ أَنْ يُرَاجِعَهَا فَمَنَعَهَا  مَعْقِلٌ  ، فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ فِي ذَلِكَ :         {      وَإِذَا طَلَّقْتُمُ النِّسَاءَ فَبَلَغْنَ أَجَلَهُنَّ فَلا تَعْضُلُوهُنَّ أَنْ يَنْكِحْنَ أَزْوَاجَهُنَّ إِذَا تَرَاضَوْا بَيْنَهُمْ بِالْمَعْرُوفِ         }      "" .","","Al-Mu'jam al-Kabir 475","","معقل بن يسار المزني عن الحسن البصري عن الفضل بن دلهم القصاب عن وكيع بن الجراح عن يحيى بن عبد الحميد عن موسى بن هارون الحمال عن الطبراني","الفضل بن دلهم عن الحسن"
"18653","مُبَارَكُ بْنُ فَضَالَةَ  ، عَنِ  الْحَسَنِ  476  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  مُبَارَكُ بْنُ فَضَالَةَ ،  عَنِ  الْحَسَنِ ،  أَنَّ  عُبَيْدَ اللهِ بْنَ زِيَادٍ  أَتَى مَعْقِلَ بْنَ يَسَارٍ يَعُودُهُ فِي مَرَضِهِ الَّذِي مَاتَ فِيهِ ، فَقَالَ : كَيْفَ تَجِدُكَ ؟  قَالَ  مَعْقِلٌ  : مَا أُرَانِي لِمَا بِي ، وَسَأُحَدِّثُكَ حَدِيثًا سَمِعْتُهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : وَمَا هُوَ ؟ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَا مِنْ أَحَدٍ اسْتَرْعَى رَعِيَّةً يَمُوتُ يَوْمَ يَمُوتُ  وَهُوَ غَاشٌّ لَهَا ،  إِلَّا لَمْ يَجِدْ رِيحَ الْجَنَّةِ - أَوْ قَالَ : مِنْ أَهْلِ النَّارِ  - "" قَالَ : فَهَلَّا حَدَّثْتَنِي بِهَذَا الْحَدِيثِ قَبْلَ هَذَا الْيَوْمِ ؟ قَالَ : "" لَوْلَا مَا بِي مَا حَدَّثْتُكَ  .","","Al-Mu'jam al-Kabir 476","","معقل بن يسار المزني عن الحسن البصري عن مبارك بن فضالة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","مبارك بن فضالة عن الحسن"
"18654","477  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  مُبَارَكُ بْنُ فَضَالَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ الْمُزَنِيِّ ،  أَنَّهُ  زَوَّجَ أُخْتَهُ  رَجُلًا  عَلَى عَهْدِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَكَانَتْ عِنْدَهُ مَا كَانَتْ  ، ثُمَّ طَلَّقَهَا تَطْلِيقَةً فَلَمْ         [20/209]      يُرَاجِعْهَا حَتَّى انْقَضَتِ الْعِدَّةَ ، فَهَوَاهَا وَهَوَتْهُ ، ثُمَّ خَطَبَهَا مَعَ الْخُطَّابِ ، فَقَالَ لَهُ : "" يَا  لُكَعُ  ، أَكْرَمْتُكَ بِهَا وَزَوَّجْتُكَهَا فَطَلَّقْتَهَا ، وَاللهِ لَا تَرْجِعُ إِلَيْكَ أَبَدًا آخِرُ مَا عَلَيْكَ "" ، فَعَلِمَ اللهُ حَاجَتَهُ إِلَيْهَا ، وَحَاجَتَهَا إِلَيْهِ فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ :         {      وَإِذَا طَلَّقْتُمُ النِّسَاءَ فَبَلَغْنَ أَجَلَهُنَّ فَلا تَعْضُلُوهُنَّ أَنْ يَنْكِحْنَ أَزْوَاجَهُنَّ إِذَا تَرَاضَوْا بَيْنَهُمْ بِالْمَعْرُوفِ         }      . إِلَى آخِرِ الْآيَةِ "" ، فَلَمَّا سَمِعَهَا  مَعْقِلٌ  قَالَ : "" سَمْعٌ لِرَبِّي وَطَاعَةٌ "" ، ثُمَّ دَعَاهُ فَقَالَ : "" أُزَوِّجُكَ وَأُكْرِمُكُ ""  .","","Al-Mu'jam al-Kabir 477","","معقل بن يسار المزني عن الحسن البصري عن مبارك بن فضالة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","مبارك بن فضالة عن الحسن"
"18655","الرَّبِيعُ بْنُ صُبَيْحٍ  ، عَنِ  الْحَسَنِ  478  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  الرَّبِيعُ بْنُ صُبَيْحٍ ،  عَنِ  الْحَسَنِ ،  أَنَّ  عُبَيْدَ اللهِ بْنَ زِيَادٍ  دَخَلَ عَلَى مَعْقِلِ بْنِ يَسَارٍ وَهُوَ ثَقِيلٌ ،  فَقَالَ  : أَمَا إِنِّي سَأُحَدِّثُكَ بِحَدِيثٍ لَوْلَا الْحَالُ الَّتِي أَنَا عَلَيْهَا مَا حَدَّثْتُ بِهِ ، سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنِ اسْتَرْعَاهُ اللهُ رَعِيَّةً لَمْ يُحِطْ مَنْ وَرَاءَهَا  بِالنَّصِيحَةِ  فَهُوَ مِنْ أَهْلِ النَّارِ "" قَالَ : أَفَلَا كَانَ هَذَا قَبْلَ هَذَا ؟  .","","Al-Mu'jam al-Kabir 478","","معقل بن يسار المزني عن الحسن البصري عن الربيع بن صبيح عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","الربيع بن صبيح عن الحسن"
"18656","زَيْدٌ أَبُو الْمُعَلَّى  ، عَنِ  الْحَسَنِ  479  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  يَحْيَى بْنُ مَعِينٍ ، (  ح  )         [20/210]      وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ، قَالَ :  سَمِعْتُ  زَيْدًا أَبَا الْمُعَلَّى  يُحَدِّثُ ، عَنِ  الْحَسَنِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ دَخَلَ فِي سِعْرٍ مِنْ أَسْعَارِ الْمُؤْمِنِينَ لِيُغْلِيَهُ عَلَيْهِمْ كَانَ حَقًّا عَلَى اللهِ أَنْ يُعَذِّبَهُ  فِي عُظْمِ  جَهَنَّمَ  .","","Al-Mu'jam al-Kabir 479","","معقل بن يسار المزني عن الحسن البصري عن زيد بن أبي ليلى العدوي عن معتمر بن سليمان عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","زيد أبو المعلى عن الحسن"
"18657","480  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  إِبْرَاهِيمُ بْنُ أَعْيَنَ ،  عَنْ  أَبِي الْمُعَلَّى ، قَالَ :  سَمِعْتُ  الْحَسَنَ بْنَ أَبِي الْحَسَنِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ دَخَلَ فِي شَيْءٍ مِنْ أَسْعَارِ الْمُسْلِمِينَ لِيُغْلِيَهُ عَلَيْهِمْ  ، فَإِنَّ عَلَى اللهِ أَنْ يَقْذِفَهُ فِي مُعْظَمٍ مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 480","","معقل بن يسار المزني عن الحسن البصري عن زيد بن أبي ليلى العدوي عن إبراهيم بن أعين عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","زيد أبو المعلى عن الحسن"
"18658","481  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ  ،  ثَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  ثَنَا  زَيْدُ بْنُ أَبِي لَيْلَى أَبُو الْمُعَلَّى ،  عَنِ  الْحَسَنِ ،  عَنْ  مَعْقِلٍ - يَعْنِي : ابْنَ يَسَارٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .  في طبعة مكتبة ابن تيمية : (يسار) والرسم يحتمل الوجهين في النسخة الخطية ، والمثبت هو الصحيح وينظر مصادر الترجمة ، والله أعلم .","","Al-Mu'jam al-Kabir 481","","معقل بن يسار المزني عن الحسن البصري عن زيد بن أبي ليلى العدوي عن أبو عامر العقدي عن محمد بن بشار بندار عن محمد بن صالح النرسي عن الطبراني","زيد أبو المعلى عن الحسن"
"18659","عَطَاءُ بْنُ السَّائِبِ  ، عَنِ  الْحَسَنِ  482  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  ابْنُ الْأَصْبَهَانِيِّ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنِ  الْحَسَنِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَفْطَرَ  الْحَاجِمُ ،  وَالْمَحْجُومُ  .","","Al-Mu'jam al-Kabir 482","","معقل بن يسار المزني عن الحسن البصري عن عطاء بن السائب عن محمد بن فضيل بن غزوان عن محمد بن سعيد حمدان عن بشر بن موسى بن صالح الأسدي عن الطبراني","عطاء بن السائب عن الحسن"
"18660","483  -  حَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ ،  ثَنَا  أَبُو مُوسَى مُحَمَّدُ بْنُ الْمُثَنَّى ،  ثَنَا  أَبُو دَاوُدَ الطَّيَالِسِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ مُعَاذٍ ،  ثَنَا  عَطَاءُ بْنُ         [20/211]      السَّائِبِ ، قَالَ :  شَهِدَ عِنْدِي  نَفَرٌ مِنْ  أَهْلِ الْبَصْرَةِ  - مِنْهُمُ الْحَسَنُ - عَلَى مَعْقِلِ بْنِ يَسَارٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَتَى عَلَى  رَجُلٍ  وَهُوَ يَحْتَجِمُ وَهُوَ صَائِمٌ ، فَقَالَ :  أَفْطَرَ  الْحَاجِمُ ،  وَالْمَحْجُومُ  .","","Al-Mu'jam al-Kabir 483","","معقل بن يسار المزني عن الحسن البصري عن عطاء بن السائب عن سليمان بن قرم الضبي عن أبو داود الطيالسي عن أبو موسى الزمن عن الفضل بن الحباب الجمحي عن الطبراني","عطاء بن السائب عن الحسن"
"18661","مُحَمَّدُ بْنُ سِيرِينَ  ، عَنْ  مَعْقِلِ بْنِ يَسَارٍ  484  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنِ  الْفَضْلِ بْنِ دَلْهَمٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنِ  الْوَاصِلَةِ  ، وَالْمَوْصُولَةِ  .","","Al-Mu'jam al-Kabir 484","","معقل بن يسار المزني عن محمد بن سيرين عن الفضل بن دلهم القصاب عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","محمد بن سيرين عن معقل بن يسار"
"18662","485  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  وَكِيعٌ ،  عَنِ  الْفَضْلِ بْنِ دَلْهَمٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَعَنَ  الْوَاصِلَةَ  وَالْمُتَوَاصِلَةَ  .","","Al-Mu'jam al-Kabir 485","","معقل بن يسار المزني عن محمد بن سيرين عن الفضل بن دلهم القصاب عن وكيع بن الجراح عن محمد بن عبد الله بن نمير عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن سيرين عن معقل بن يسار"
"18663","أَبُو الْعَلَاءِ يَزِيدُ بْنُ عَبْدِ اللهِ بْنِ الشِّخِّيرِ  ، عَنْ  مَعْقِلِ بْنِ يَسَارٍ  486  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  أَنَا  النَّضْرُ         [20/212]      بْنُ شُمَيْلٍ ،  ثَنَا  شَدَّادُ بْنُ سَعِيدٍ الرَّاسِبِيُّ ، قَالَ :  سَمِعْتُ  يَزِيدَ بْنَ عَبْدِ اللهِ بْنِ الشِّخِّيرِ يَقُولُ :  سَمِعْتُ  مَعْقِلَ بْنَ يَسَارٍ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَأَنْ يُطْعَنَ فِي رَأْسِ أَحَدِكُمْ بِمِخْيَطٍ  مِنْ حَدِيدٍ خَيْرٌ لَهُ مِنْ أَنْ يَمَسَّ امْرَأَةً لَا تَحِلُّ لَهُ  .","","Al-Mu'jam al-Kabir 486","","معقل بن يسار المزني عن يزيد بن عبد الله بن الشخير العامري عن شداد بن سعيد الراسبي عن النضر بن شميل عن إسحاق ابن راهويه عن موسى بن هارون الحمال عن الطبراني","أبو العلاء يزيد بن عبد الله بن الشخير عن معقل بن يسار"
"18664","487  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  نَصْرُ بْنُ عَلِيٍّ ، قَالَ :  أَنَا  أَبِي  ،  ثَنَا  شَدَّادُ بْنُ سَعِيدٍ ،  عَنْ  أَبِي الْعَلَاءِ ،  حَدَّثَنِي  مَعْقِلُ بْنُ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَأَنْ يُطْعَنَ فِي رَأْسِ رَجُلٍ بِمِخْيَطٍ مِنْ حَدِيدٍ خَيْرٌ لَهُ مِنْ أَنْ يَمَسَّ امْرَأَةً  لَا تَحِلُّ لَهُ  .","","Al-Mu'jam al-Kabir 487","","معقل بن يسار المزني عن يزيد بن عبد الله بن الشخير العامري عن شداد بن سعيد الراسبي عن علي بن نصر الجهضمي الكبير عن نصر بن علي بن نصر الجهضمي عن عبد الله بن أحمد الجواليقي عن الطبراني","أبو العلاء يزيد بن عبد الله بن الشخير عن معقل بن يسار"
"18665","مُعَاوِيَةُ بْنُ قُرَّةَ  ، عَنْ  مَعْقِلِ بْنِ يَسَارٍ  488  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَيُوسُفُ الْقَاضِي ، قَالَا :  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنِ  الْمُعَلَّى بْنِ زِيَادٍ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْعِبَادَةُ فِي  الْهَرْجِ  كَهِجْرَةٍ إِلَيَّ  .","","Al-Mu'jam al-Kabir 488","","معقل بن يسار المزني عن معاوية بن قرة عن معلى بن زياد القردوسي عن حماد بن زيد عن محمد بن الفضل السدوسي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18666","489  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  عَدِيُّ بْنُ الْفَضْلِ ،  عَنِ  الْمُعَلَّى بْنِ زِيَادٍ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْعَمَلُ فِي  الْهَرْجِ  كَهِجْرَةٍ إِلَيَّ  .","","Al-Mu'jam al-Kabir 489","","معقل بن يسار المزني عن معاوية بن قرة عن معلى بن زياد القردوسي عن عدي بن الفضل التيمي عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18667","490  -  حَدَّثَنَا  بَكْرُ بْنُ أَحْمَدَ بْنِ مُقْبِلٍ الْبَصْرِيُّ ،  ثَنَا  بُنْدَارٌ ،  ثَنَا  يُوسُفُ بْنُ يَعْقُوبَ السِّلَفِيُّ ،  ثَنَا  هِشَامُ بْنُ حَسَّانَ ،  عَنِ  الْمُعَلَّى بْنِ زِيَادٍ ،  عَنْ         [20/213]      مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْعِبَادَةُ فِي  الْهَرْجِ  كَهِجْرَةٍ إِلَيَّ  .","","Al-Mu'jam al-Kabir 490","","معقل بن يسار المزني عن معاوية بن قرة عن معلى بن زياد القردوسي عن هشام بن حسان العتكي عن يوسف بن يعقوب بن أبي القاسم السلعي عن محمد بن بشار بندار عن بكر بن أحمد بن مقبل الهاشمي عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18668","491  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ بْنِ حِسَابٍ ،  ثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ ،  عَنِ  الْمُعَلَّى بْنِ زِيَادٍ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْعِبَادَةُ فِي  الْهَرْجِ  كَهِجْرَةٍ إِلَيَّ  .","","Al-Mu'jam al-Kabir 491","","معقل بن يسار المزني عن معاوية بن قرة عن معلى بن زياد القردوسي عن جعفر بن سليمان الضبعي عن محمد بن عبيد بن حساب الغبري عن عبد الله بن أحمد الجواليقي عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18669","492  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  ثَنَا  مَسْلَمَةُ بْنُ سَعِيدٍ الثَّقَفِيُّ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْعِبَادَةُ فِي الْفِتْنَةِ كَهِجْرَةٍ إِلَيَّ  .","","Al-Mu'jam al-Kabir 492","","معقل بن يسار المزني عن معاوية بن قرة عن مسلمة بن سعيد الثقفي عن يزيد بن هارون عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18670","493  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ ، وَأَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرِ ابْنِ بِنْتِ يَزِيدَ بْنِ هَارُونَ ،  ثَنَا  سُرُورُ بْنُ الْمُغِيرَةِ ،  عَنْ  سُلَيْمَانَ الثَّقَفِيِّ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْعِبَادَةُ فِي الْفِتْنَةِ كَهِجْرَةٍ إِلَيَّ  .","","Al-Mu'jam al-Kabir 493","","معقل بن يسار المزني عن معاوية بن قرة عن سليمان بن طرخان عن سرور بن المغيرة بن زاذان السلمي عن محمد بن كثير ابن بنت يزيد بن هارون عن البزار عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18671","494  -  حَدَّثَنَا  أَبُو يَعْلَى مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ شَاذَانَ ،  ثَنَا  أَبِي  ،  ثَنَا  سَعْدُ بْنُ الصَّلْتِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  عِبَادَةٌ فِي  الْهَرْجِ  - أَوِ الْفِتْنَةِ - كَهِجْرَةٍ إِلَيَّ  .","","Al-Mu'jam al-Kabir 494","","معقل بن يسار المزني عن معاوية بن قرة عن الأعمش عن سعد بن الصلت بن برد البجلي عن شاذان إسحاق بن إبراهيم بن محمد النهشلي عن أبو يعلى محمد بن إسحاق بن إبراهيم شاذان عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18672","495  -  حَدَّثَنَا  مُحَمَّدُ بْنُ حَبَّانَ الْمَازِنِيُّ ، وَإِبْرَاهِيمُ بْنُ نَائِلَةَ         [20/214]      وَعَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالُوا :  ثَنَا  مُحَمَّدُ بْنُ أُبَيٍّ الْمُقَدَّمِيُّ  ،  ثَنَا  أَغْلَبُ بْنُ تَمِيمٍ ،  عَنْ  مُعَلَّى بْنِ زِيَادٍ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صِنْفَانِ مِنْ أُمَّتِي لَا تَنَالُهُمَا شَفَاعَتِي : سُلْطَانٌ ظَلُومٌ غَشُومٌ  ، وَغَالٍ فِي الدِّينِ يَشْهَدُ عَلَيْهِمْ فَيَتَبَرَّأُ مِنْهُمْ  .  كذا في طبعة مكتبة ابن تيمية ولعل ثمة سقط في طبعة مكتبة ابن تيمية ، والصواب (بن أبي بكر المقدمي) شيخ أحمد كما دلت عليه باقي طرق الحديث.","","Al-Mu'jam al-Kabir 495","","معقل بن يسار المزني عن معاوية بن قرة عن معلى بن زياد القردوسي عن أغلب بن تميم الشعوذي عن محمد بن أبي بكر المقدمي عن عبد الله بن أحمد بن حنبل عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18673","496  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ ،  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  أَخْبَرَنِي  مَنِيعٌ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ قُرَّةَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  رَجُلَانِ مِنْ أُمَّتِي لَا يَنَالُهُمَا شَفَاعَتِي : سُلْطَانٌ ظَلُومٌ غَشُومٌ  ، وَآخَرُ غَالٍ فِي الدِّينِ  مَارِقٌ  مِنْهُ  .         [20/215]","","Al-Mu'jam al-Kabir 496","","معقل بن يسار المزني عن معاوية بن قرة عن منيع بن عبد الله عن عبد الله بن المبارك عن نعيم بن حماد الخزاعي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18674","497  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ، وَأَبُو عُبَيْدَةَ عَبْدُ الْوَارِثِ بْنُ إِبْرَاهِيمَ الْعَسْكَرِيُّ ، قَالَا :  ثَنَا  دَاوُدُ بْنُ بَكْرٍ التُّسْتَرِيُّ ،  ثَنَا  حِبَّانُ بْنُ أَغْلَبَ بْنِ تَمِيمٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمُعَلَّى بْنِ زِيَادٍ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لِكُلِّ شَيْءٍ مِفْتَاحٌ ، وَمِفْتَاحُ السَّمَاوَاتِ قَوْلُ لَا إِلَهَ إِلَّا اللهُ  .","","Al-Mu'jam al-Kabir 497","","معقل بن يسار المزني عن معاوية بن قرة عن معلى بن زياد القردوسي عن أغلب بن تميم الشعوذي عن حبان بن أغلب بن تميم السعدي عن داود بن بكر التستري عن عبد الوارث بن إبراهيم العسكري عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18675","498  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ، وَأَبُو عُبَيْدَةَ عَبْدُ الْوَارِثِ بْنُ إِبْرَاهِيمَ ، قَالَا :  ثَنَا  دَاوُدُ بْنُ بَكْرٍ التُّسْتَرِيُّ ،  ثَنَا  حِبَّانُ بْنُ أَغْلَبَ بْنِ تَمِيمٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمُعَلَّى بْنِ زِيَادٍ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَيُّمَا قَوْمٍ نُودِيَ فِيهِمْ بِالْأَذَانِ صَبَاحًا إِلَّا كَانُوا فِي أَمَانِ اللهِ حَتَّى يُمْسُوا  ، وَأَيُّمَا قَوْمٍ نُودِيَ عَلَيْهِمْ بِالْأَذَانِ مَسَاءً إِلَّا كَانُوا فِي أَمَانِ اللهِ حَتَّى يُصْبِحُوا  .","","Al-Mu'jam al-Kabir 498","","معقل بن يسار المزني عن معاوية بن قرة عن معلى بن زياد القردوسي عن أغلب بن تميم الشعوذي عن حبان بن أغلب بن تميم السعدي عن داود بن بكر بن أبي الفرات الأشجعي عن عبد الله بن أحمد الجواليقي عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18676","499  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  سَلَّامُ         [20/216]      بْنُ سُلَيْمٍ الطَّوِيلُ ،  عَنْ  زَيْدٍ الْعَمِّيِّ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْحِجَامَةُ يَوْمَ الثُّلَاثَاءِ لِسَبْعَ عَشْرَةَ مِنَ  الشَّهْرِ  دَوَاءٌ لِدَاءِ سَنَةٍ  .","","Al-Mu'jam al-Kabir 499","","معقل بن يسار المزني عن معاوية بن قرة عن زيد بن الحواري العمي عن سلام بن سلم الطويل عن أحمد بن عبد الله اليربوعي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18677","500  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ، قَالَا :  ثَنَا  سَلَّامٌ الطَّوِيلُ ،  عَنْ  زَيْدٍ الْعَمِّيِّ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" قَالَ رَبُّكُمْ تَعَالَى :  ابْنَ آدَمَ تَفَرَّغْ لِعِبَادَتِي أَمْلَأْ قَلْبَكَ غِنًى ، وَأَمْلَأْ يَدَيْكَ رِزْقًا  ، ابْنَ آدَمَ لَا تَبَاعَدْ عَنِّي فَأَمْلَأَ قَلْبَكَ فَقْرًا ، وَأَمْلَأَ يَدَيْكَ شُغْلًا  .","","Al-Mu'jam al-Kabir 500","","معقل بن يسار المزني عن معاوية بن قرة عن زيد بن الحواري العمي عن سلام بن سلم الطويل عن سليمان بن داود العتكي عن الحسين بن إسحاق التستري عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18678","501  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  ثَنَا  سَلَّامٌ الطَّوِيلُ ،  عَنْ  زَيْدٍ الْعَمِّيِّ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَأْذَنُ اللهُ لِشَيْءٍ أَذَنَهُ لِأَذَانِ الْمُؤَذِّنِينَ وَالصَّوْتِ الْحَسَنِ بِالْقُرْآنِ  .","","Al-Mu'jam al-Kabir 501","","معقل بن يسار المزني عن معاوية بن قرة عن زيد بن الحواري العمي عن سلام بن سلم الطويل عن سعيد بن سليمان سعدويه عن محمد بن الفضل بن جابر السقطى عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18679","502  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عَرْعَرَةَ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  الْعَبَّاسُ بْنُ عَبْدِ الْعَظِيمِ الْعَنْبَرِيُّ ، (  ح  )         [20/217]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي سَمِينَةَ ، قَالُوا :  ثَنَا  الْخَلِيلُ بْنُ أَحْمَدَ  - وَقَالَ  الْعَبَّاسُ الْعَنْبَرِيُّ  : حَدَّثَنِي  الْخَلِيلُ بْنُ أَحْمَدَ بْنِ بَشِيرِ بْنِ الْمُسْتَنِيرِ السُّلَمِيُّ -  ثَنَا  الْمُسْتَنِيرُ بْنُ أَخْضَرَ بْنِ مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  كُنْتُ مَعَ مَعْقِلِ بْنِ يَسَارٍ فِي بَعْضِ الطُّرُقَاتِ ، فَمَرَرْنَا بِأَذًى فَأَمَاطَهُ - أَوْ نَحَّاهُ - عَنِ الطَّرِيقِ ، فَرَأَيْتُ مِثْلَهُ فَأَخَذْتُهُ فَنَحَّيْتُهُ ، فَأَخَذَ بِيَدِي فَقَالَ : يَا ابْنَ أَخِي ، مَا حَمَلَكَ عَلَى مَا صَنَعْتَ ؟ قُلْتُ : يَا عَمِّ رَأَيْتُكَ صَنَعْتَ شَيْئًا فَصَنَعْتُ مِثْلَهُ ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ أَمَاطَ أَذًى عَنْ طَرِيقِ الْمُسْلِمِينَ كُتِبَتْ لَهُ حَسَنَةٌ  ، وَمَنْ تُقُبِّلَتْ مِنْهُ حَسَنَةٌ دَخَلَ الْجَنَّةَ "" .  وَاللَّفْظُ لِحَدِيثِ  الْعَبَّاسِ الْعَنْبَرِيِّ  .","","Al-Mu'jam al-Kabir 502","","معقل بن يسار المزني عن أبو المستنير بن أخضر بن معاوية البصري عن المستنير بن أخضر بن معاوية البصري عن الخليل بن أحمد بن بشر بن المستنير المزني عن إبراهيم بن محمد بن عرعرة عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18680","503  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ أَبُو مَعْمَرٍ الْقَطِيعِيُّ ،  ثَنَا  الْمُفَضَّلُ بْنُ عُبَيْدِ اللهِ ،  ثَنَا  عُمَرُ بْنُ عَامِرٍ ،  عَنْ  دَاوُدَ بْنِ يَسَارٍ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لَمَّا افْتَتَحَ  خَيْبَرَ  ، أَصَابَ النَّاسُ حُمُرًا  فَانْتَهَبُوهَا حَتَّى عَلَتِ الْقُدُورَ ، فَأَتَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقِيلَ : إِنَّ حُمُرَ النَّاسِ قَدْ نُحِرَتْ ، "" فَنَهَى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ لُحُومِ الْحُمُرِ  الْأَهْلِيَّةِ  "" ، فَجَعَلَ الرَّجُلُ يَكْفَأُ الْإِنَاءَ بِسِنَّةِ قَوْسِهِ وَعَمُودِ بَيْتِهِ  .","","Al-Mu'jam al-Kabir 503","","معقل بن يسار المزني عن معاوية بن قرة عن داود بن يسار عن عمر بن عامر الأحول عن المفضل بن عبد الله الحبطي عن إسماعيل بن إبراهيم المقعد عن عبد الله بن أحمد بن حنبل عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18681","504  -  حَدَّثَنَا  أَبُو زُرْعَةَ الدِّمَشْقِيُّ ،  ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  ثَنَا  الْمُثَنَّى بْنُ عَوْفٍ ،  ثَنَا  أَبُو عَبْدِ اللهِ الْجَسْرِيُّ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ  أَنَّهُ سَأَلَهُ عَنِ الشَّرَابِ ،         [20/218]      فَقَالَ : كُنَّا  بِالْمَدِينَةِ  ، فَكَانَتْ كَثِيرَةَ  الثَّمَرِ  ،  فَحَرَّمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْفَضِيخَ  .","","Al-Mu'jam al-Kabir 504","","معقل بن يسار المزني عن حميري بن بشير الجسري عن المثنى بن عوف العنزي عن عفان بن مسلم الصفار عن أبو زرعة الدمشقي عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18682","505  -  حَدَّثَنَا  الْفَضْلُ بْنُ الْحُبَابِ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ،  ثَنَا  جَامِعُ بْنُ مَطَرٍ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  أَنَّ  مَعْقِلَ بْنَ يَسَارٍ ، قَالَ :  حُرِّمَتِ الْخَمْرُ وَنَحْنُ نَشْرَبُ الْفَضِيخَ  ، فَجَعَلْتُ أُهْرِيقَهَا وَأَقُولُ : هَذَا آخِرُ الْعَهْدِ بِالْخَمْرِ  "" .","","Al-Mu'jam al-Kabir 505","","معقل بن يسار المزني عن معاوية بن قرة عن جامع بن مطر الحبطي عن حفص بن عمر الحوضى عن الفضل بن الحباب الجمحي عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18683","506  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  أَبُو شَيْبَةَ بْنُ أَبِي بَكْرٍ ،  ثَنَا  عُبَيْدُ بْنُ مُحَمَّدٍ النَّحَّاسُ ،  ثَنَا  خَالِدُ بْنُ عَجْلَانَ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : "" سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَيْسَ رَجُلٌ يَلِي قَوْمًا ثُمَّ لَا يَحُوطُهُمْ كَمَا يَحُوطُ نَفْسَهُ  وَأَهْلَهُ إِلَّا أَدْخَلَهُ اللهُ نَارَ  جَهَنَّمَ  .","","Al-Mu'jam al-Kabir 506","","معقل بن يسار المزني عن معاوية بن قرة عن خالد بن عجلان عن عبيد بن محمد المحاربي عن إبراهيم بن عبد الله أبو شيبة العبسي عن أحمد بن يحيى بن زهير التستري عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18684","507  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ الْقَطَّانُ ،  عَنِ  الْحَسَنِ بْنِ دِينَارٍ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ :  كُنَّا عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذْ دَخَلَ  الْمُغِيرَةُ بْنُ شُعْبَةَ  وَعَلَيْهِ خُفَّانِ  ، فَكَانَ أَوَّلَ مَنْ رَأَيْتُ عَلَيْهِ الْخُفَّيْنِ فِي الْإِسْلَامِ  الْمُغِيرَةُ  ، فَجَعَلَ  الْقَوْمُ  يَمْسَحُونَهَا وَيَقُولُونَ : مَا هَذَا ؟ قَالُوا : هَذِهِ الْخِفَافُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِنَّكُمْ "" سَيَكْثُرُ لَكُمْ مِنَ الْخِفَافِ "" . قَالُوا : يَا رَسُولَ اللهِ ، فَمَا تَأْمُرُنَا بِالْوُضُوءِ لِلصَّلَاةِ ؟ قَالَ : "" تَمْسَحُونَ أَوْ تَوَضَّؤُوا عَلَيْهَا  .         [20/219]","","Al-Mu'jam al-Kabir 507","","معقل بن يسار المزني عن معاوية بن قرة عن الحسن بن دينار التميمي عن يحيى القطان عن محمد بن مصفى بن بهلول عن الحسين بن إسحاق التستري عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18685","508  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ هُودٍ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  الْمُسْتَلِمُ بْنُ سَعِيدٍ ،  عَنْ  مَنْصُورِ بْنِ زَاذَانَ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ،  أَنَّ  رَجُلًا  ذَكَرَ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ أَصَابَ  امْرَأَةً  ذَاتَ جَمَالٍ وَمَنْصِبٍ ، غَيْرَ أَنَّهَا لَا تَلِدُ فَنَهَاهُ عَنْهَا ، ثُمَّ عَادَ فَنَهَاهُ عَنْهَا ، وَقَالَ :  تَزَوَّجُوا الْوَلُودَ الْوَدُودَ فَإِنِّي مُكَاثِرٌ بِكُمْ  .","","Al-Mu'jam al-Kabir 508","","معقل بن يسار المزني عن معاوية بن قرة عن منصور بن زاذان الثقفي عن مستلم بن سعيد الواسطي عن يزيد بن هارون عن إسماعيل بن إبراهيم بن هود عن محمود بن محمد بن منويه المفيد عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18686","509  -  حَدَّثَنَا  أَبُو زُرْعَةَ الدِّمَشْقِيُّ ،  ثَنَا  أَبُو الْيَمَانِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَطَاءِ بْنِ عَجْلَانَ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ،  أَنَّ  عُثْمَانَ بْنَ عَفَّانَ  ، كَانَ يَلْقَى مِنَ الْمَذْيِ شِدَّةً ، فَسَدَّدَ  رَجُلًا  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ذَاكَ الْمَذْيُ ، وَكُلُّ فَحْلٍ يُمْذِي ، تَغْسِلُهُ بِالْمَاءِ وَتَوَضَّأْ وَصَلِّ  .","","Al-Mu'jam al-Kabir 509","","معقل بن يسار المزني عن معاوية بن قرة عن عطاء بن عجلان العطار عن إسماعيل بن عياش الأحول عن أبو اليمان الحكم بن نافع عن أبو زرعة الدمشقي عن الطبراني","معاوية بن قرة عن معقل بن يسار"
"18687","أَبُو أَبِي عُثْمَانَ  ، عَنْ  مَعْقِلِ بْنِ يَسَارٍ  510  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  ثَنَا  سُلَيْمَانُ التَّيْمِيُّ ،  عَنْ  أَبِي عُثْمَانَ - وَلَيْسَ بِالنَّهْدِيِّ -  عَنْ  أَبِيهِ  ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اقْرَؤُوهَا عَلَى مَوْتَاكُمْ  يَعْنِي         {      يس         }      .         [20/220]","","Al-Mu'jam al-Kabir 510","","معقل بن يسار المزني عن أبو أبو عثمان السلي عن أبو عثمان السلي عن سليمان بن طرخان عن عبد الله بن المبارك عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو أبي عثمان عن معقل بن يسار"
"18688","511  -  حَدَّثَنَا  سَهْلُ بْنُ مُوسَى شِيرَانُ الرَّامَهُرْمُزِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  رَجُلٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْبَقَرَةُ سَنَامُ الْقُرْآنِ وَذُرْوَتُهُ  ، وَنَزَلَ مَعَ كُلِّ آيَةٍ مِنْهَا ثَمَانُونَ مَلَكًا ، وَاسْتُخْرِجَتِ :         {      اللهُ لا إِلَهَ إِلا هُوَ الْحَيُّ الْقَيُّومُ         }      مِنْ تَحْتِ الْعَرْشِ فَوُصِلَ بِهَا - أَوْ وُصِلَتْ - بِسُورَةِ الْبَقَرَةِ ، وَ         {      يس         }      قَلْبُ الْقُرْآنِ ، لَا يَقْرَؤُهَا رَجُلٌ يُرِيدُ اللهَ وَالدَّارَ الْآخِرَةَ إِلَّا غَفَرَ اللهُ لَهُ ، وَاقْرَؤُوهَا عَلَى مَوْتَاكُمْ  .","","Al-Mu'jam al-Kabir 511","","معقل بن يسار المزني عن أبيه عن رجل عن سليمان بن طرخان عن معتمر بن سليمان عن محمد بن عبد الأعلى القيسي عن شيران سهل بن موسى الرامهرمزي عن الطبراني","أبو أبي عثمان عن معقل بن يسار"
"18689","عُبَيْدُ اللهِ بْنُ مَعْقِلِ بْنِ يَسَارٍ  ، عَنْ  مَعْقِلِ بْنِ يَسَارٍ  512  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  ثَنَا  عِمْرَانُ الْقَطَّانُ ،  عَنْ  عُبَيْدِ اللهِ بْنِ مَعْقِلِ بْنِ يَسَارٍ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ قَالَ : قَالَ         [20/221]      رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اعْمَلُوا بِكِتَابِ اللهِ وَلَا تُكَذِّبُوا بِشَيْءٍ مِنْهُ  ، فَمَا اشْتَبَهَ مِنْهُ عَلَيْكُمْ فَسَلُوا عَنْهُ أَهْلَ الْعِلْمِ يُخْبِرُوكُمْ ، وَآمِنُوا بِالتَّوْرَاةِ وَالْإِنْجِيلِ ؛ فَإِنَّ فِيهِ الْبَيَانَ وَهُوَ شَافِعٌ  وَمَاحِلٌ  يُصَدَّقُ  .","","Al-Mu'jam al-Kabir 512","","معقل بن يسار المزني عن عبيد الله بن معقل بن يسار عن عمران بن داور القطان عن عبد الله بن رجاء الغداني عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبيد الله بن معقل بن يسار عن معقل بن يسار"
"18690","ابْنُ عَمِّ مَعْقِلِ بْنِ يَسَارٍ  ، عَنْ  مَعْقِلٍ  513  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَمِّ مَعْقِلِ بْنِ يَسَارٍ ، قَالَ :  دَخَلَ عَلَيْهِ  زِيَادٌ ،  فَقَالَ : إِنَّ اللهَ كَانَ يَنْفَعُنَا بِالْعِلْمِ بِمُجَالَسَتِكَ ، وَكُنْتَ تُحَدِّثُنَا عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فَقَالَ  مَعْقِلٌ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ وَلِيَ مِنْ أَمْرِ الْمُسْلِمِينَ شَيْئًا فَلَمْ يُحِطْهُمْ  بِنَصِيحَةٍ  كَمَا يُحِيطُ أَهْلَ بَيْتِهِ  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  قَالَ : مَا سَمِعْتُ هَذَا مِنْكَ قَبْلَ الْيَوْمِ ، قَالَ : "" مَا كُنْتُ لِأُحَدِّثَكَ بِهِ إِلَّا وَأَنَا عَلَى حَالَتِي هَذِهِ "" ، قَالَ : فَخَرَجَ  زِيَادٌ  يَجُرُّ ثَوْبَهُ .","","Al-Mu'jam al-Kabir 513","","معقل بن يسار المزني عن ابن عم معقل بن يسار عن إبراهيم بن مهاجر بن جابر البجلي عن إسماعيل بن إبراهيم بن مهاجر النخعي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ابن عم معقل بن يسار عن معقل"
"18691","بِنْتُ مَعْقِلِ بْنِ يَسَارٍ  ، عَنْ أَبِيهَا  514  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  أَخْبَرَنِي  إِسْمَاعِيلُ الْأَوْدِيُّ ، قَالَ :  كُنْتُ فِي دَارِ  مَعْقِلِ بْنِ يَسَارٍ  بِالْبَصْرَةِ  ،  فَحَدَّثَتْنِي  ابْنَتُهُ  أَنَّ  أَبَاهَا  ثَقُلَ فَبَلَغَ ذَلِكَ  زِيَادًا  ، فَجَاءَ حَتَّى اسْتَأْذَنَ عَلَى الْبَابِ ، وَجَلَسْتُ عِنْدَ أَبِي فَدَخَلَ  زِيَادٌ  فَعَرَفَ فِي وَجْهِ أَبِي الْمَوْتَ ، فَقَالَ : يَا  مَعْقِلُ  ، أَلَا تُزَوِّدُنَا مِنْكَ ؟ فَقَدْ كَانَ اللهُ يَنْفَعُنَا بِأَشْيَاءَ نَسْمَعُهَا مِنْكَ ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَا مِنْ وَالِي أُمَّةٍ كَثُرَتْ أَوْ قَلَّتْ لَمْ يَعْدِلْ فِيهِمْ إِلَّا أَكَبَّهُ اللهُ عَلَى وَجْهِهِ فِي النَّارِ  . فَنَكَّسَ رَأْسَهُ سَاعَةً ثُمَّ  أَطْرَقَ  ، ثُمَّ رَفَعَ رَأْسَهُ ، فَقَالَ : يَا  مَعْقِلُ  ، أَشَيْءٌ سَمِعْتَهُ         [20/222]      مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ أَمْ مِنْ وَرَاءَ وَرَاءَ ؟ فَقَالَ : بَلْ سَمِعْتُهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 514","","معقل بن يسار المزني عن ابنة معقل بن يسار عن إسماعيل بن إبراهيم الأودي عن إسماعيل بن أبي خالد عن مروان بن معاوية الفزاري عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","بنت معقل بن يسار عن أبيها"
"18692","515  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  إِسْمَاعِيلَ الْأَوْدِيِّ ،  أَخْبَرَتْنِي  بِنْتُ مَعْقِلِ بْنِ يَسَارٍ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 515","","معقل بن يسار المزني عن ابنة معقل بن يسار عن إسماعيل بن إبراهيم الأودي عن إسماعيل بن أبي خالد عن عبد الله بن نمير عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","بنت معقل بن يسار عن أبيها"
"18693","516  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  رَجُلٍ مِنْ مُزَيْنَةَ ،  عَنْ  بِنْتِ مَعْقِلِ بْنِ يَسَارٍ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، نَحْوَهُ .","","Al-Mu'jam al-Kabir 516","","معقل بن يسار المزني عن ابنة معقل بن يسار عن رجل من مزينة عن إسماعيل بن أبي خالد عن معتمر بن سليمان عن محمد بن أبي بكر المقدمي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","بنت معقل بن يسار عن أبيها"
"18694","517  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  يَعْلَى بْنُ عُبَيْدٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  إِسْمَاعِيلَ الْكِنْدِيِّ ، قَالَ :  أَتَيْتُ  الْبَصْرَةَ  فَنَزَلْتُ دَارَ  مَعْقِلِ بْنِ يَسَارٍ ،  فَحَدَّثَتْنِي  ابْنَتُهُ هِنْدٌ ، قَالَتْ : لَمَّا ثَقُلَ أَبِي  بَلَغَ ذَلِكَ  زِيَادَ بْنَ أَبِي سُفْيَانَ  ، فَجَاءَ يَعُودُهُ ، فَقَالَ : إِنَّ اللهَ كَانَ يَنْفَعُنَا بِحَدِيثِكَ فَحَدِّثْنَا شَيْئًا سَمِعْتَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَا مِنْ وَالٍ اسْتُعْمِلَ عَلَى أُمَّةٍ مِنْ أُمَّتِي قَلَّتْ أَوْ كَثُرَتْ ،  فَلَمْ يَعْدِلْ فِيهِمْ إِلَّا أَكَبَّهُ اللهُ عَلَى وَجْهِهِ فِي النَّارِ  .","","Al-Mu'jam al-Kabir 517","","معقل بن يسار المزني عن ابنة معقل بن يسار عن إسماعيل بن إياس بن عفيف الكندي عن إسماعيل بن أبي خالد عن يعلى بن عبيد الطنافسي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","بنت معقل بن يسار عن أبيها"
"18695","518  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  مُحَمَّدُ بْنُ سَعِيدٍ الْأَصْبَهَانِيُّ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  حَدَّثَنِي  إِسْمَاعِيلُ الْأَزْرَقُ ،  عَنْ  بِنْتِ مَعْقِلِ بْنِ يَسَارٍ ،  عَنْ  أَبِيهَا  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَا مِنْ وَالٍ وَلِيَ عَلَى أُمَّةٍ قَلَّتْ أَوْ كَثُرَتْ ، ثُمَّ لَمْ يَعْدِلْ فِيهِمْ إِلَّا كَبَّهُ اللهُ فِي النَّارِ  .         [20/223]","","Al-Mu'jam al-Kabir 518","","معقل بن يسار المزني عن ابنة معقل بن يسار عن إسماعيل بن سلمان بن أبي المغيرة الأزرق عن إسماعيل بن أبي خالد عن حماد بن أسامة القرشي عن محمد بن سعيد حمدان عن بشر بن موسى بن صالح الأسدي عن الطبراني","بنت معقل بن يسار عن أبيها"
"18696","519  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  أَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  عَمَّارٍ الدُّهْنِيِّ ،  عَنْ  إِسْمَاعِيلَ بْنِ إِبْرَاهِيمَ ،  حَدَّثَتْنِي  بِنْتُ مَعْقِلِ بْنِ يَسَارٍ ، قَالَتْ :  مَرِضَ أَبِي مَرَضَهُ الَّذِي مَاتَ فِيهِ ، فَأَتَاهُ  زِيَادٌ  يَعُودُهُ ، فَقَالَ : ائْذَنُوا لَهُ وَحْدَهُ ، فَأَذِنُوا لَهُ ، فَلَمَّا دَخَلَ عَلَيْهِ قَالَ : إِنَّهُ كَانَ يَنْفَعُنَا حَدِيثُكَ فَحَدِّثْنَا بِشَيْءٍ سَمِعْتَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَا مِنْ وَالٍ يَعْمَلُ عَلَى أُمَّةٍ مِنْ أُمَّتِي قَلَّتْ أَوْ كَثُرَتْ  ، فَلَمْ يَعْدِلْ فِيهِمْ إِلَّا كَبَّهُ اللهُ عَلَى وَجْهِهِ فِي النَّارِ "" ، فَسَاءَهُ ذَلِكَ فَقَالَ : أَشَيْءٌ سَمِعْتَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمْ سَمِعْتَهُ مِنْ أَصْحَابِهِ ؟ فَقَالَ : بَلْ شَيْءٌ سَمِعْتُهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 519","","معقل بن يسار المزني عن ابنة معقل بن يسار عن إسماعيل بن إبراهيم الأودي عن عمار بن معاوية الدهني عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن إسحاق ابن راهويه عن موسى بن هارون الحمال عن الطبراني","بنت معقل بن يسار عن أبيها"
"18697","أَبُو الرَّبَابِ مَوْلَى مَعْقِلِ بْنِ يَسَارٍ  ، عَنْ  مَعْقِلٍ  520  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلَطِيُّ ،  ثَنَا  أَبُو نُعَيْمٍ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، (  ح  )  وَحَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ قَالُوا :  ثَنَا  الْحَكَمُ بْنُ طَهْمَانَ أَبُو عَزَّةَ الدَّبَّاغُ ،  ثَنَا  أَبُو الرَّبَابِ ، مَوْلَى مَعْقِلِ بْنِ يَسَارٍ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَتَيْنَا عَلَى مَكَانٍ فِيهِ الثُّومُ  ، فَأَصَابَ نَاسٌ مِنْهُ ، ثُمَّ جَاؤُوا إِلَى الْمُصَلَّى ، فَوَجَدَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ         [20/224]      وَسَلَّمَ رِيحَهَا فَقَالَ : "" مَنْ أَكَلَ مِنْ هَذِهِ الشَّجَرَةِ فَلَا يَقْرَبَنَّ مُصَلَّانَا  .  وَاللَّفْظُ لِحَدِيثِ  أَبِي الْوَلِيدِ  .","","Al-Mu'jam al-Kabir 520","","معقل بن يسار المزني عن أبو الرباب مولى معقل بن يسار عن الحكم بن أبي القاسم الدباغ عن مسلم بن إبراهيم الشحام عن الفضل بن الحباب الجمحي عن الطبراني","أبو الرباب مولى معقل بن يسار عن معقل"
"18698","أَبُو عَبْدِ اللهِ الْجَسْرِيُّ  ، عَنْ  مَعْقِلِ بْنِ يَسَارٍ  521  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ الْمُخَرِّمِيُّ ،  ثَنَا  عَفَّانُ ،  ثَنَا  الْمُثَنَّى بْنُ عَوْفٍ ،  ثَنَا  أَبُو عَبْدِ اللهِ الْجَسْرِيُّ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ،  أَنَّهُ سَأَلَهُ عَنِ الشَّرَابِ قَالَ : كُنَّا  بِالْمَدِينَةِ  ، وَكَانَتْ كَثِيرَةَ  الثَّمَرِ  ، "" فَحَرَّمَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْفَضِيخَ  .","","Al-Mu'jam al-Kabir 521","","معقل بن يسار المزني عن حميري بن بشير الجسري عن المثنى بن عوف العنزي عن عفان بن مسلم الصفار عن يعقوب بن إسحاق البيهسي عن الطبراني","أبو عبد الله الجسري عن معقل بن يسار"
"18699","522  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ الْعَنْبَرِيُّ ، (  ح  )  وَحَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ،  ثَنَا  مُوسَى بْنُ حَبَّانَ الْبَصْرِيُّ ، قَالَا :  ثَنَا  سَلْمُ بْنُ قُتَيْبَةَ ،  عَنْ  عِمْرَانَ الْقَطَّانِ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي عَبْدِ اللهِ الْجَسْرِيِّ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ جَلَّ وَعَزَّ كَرِهَ لَكُمْ  قِيلَ  وَقَالَ ، وَكَثْرَةَ  السُّؤَالِ  ، وَإِضَاعَةَ الْمَالِ  .","","Al-Mu'jam al-Kabir 522","","معقل بن يسار المزني عن حميري بن بشير الجسري عن قتادة بن دعامة عن عمران بن داور القطان عن سلم بن قتيبة الشعيري عن موسى بن محمد بن سعيد البصري عن إبراهيم بن هاشم البغوي عن الطبراني","أبو عبد الله الجسري عن معقل بن يسار"
"18700","523  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَيْثَمَةَ ،  ثَنَا  أَبُو هَمَّامٍ الْوَلِيدُ بْنُ شُجَاعٍ ،  ثَنَا  سَعِيدُ بْنُ الْفَضْلِ الْقُرَشِيُّ ،  ثَنَا  سَعِيدُ بْنُ إِيَاسٍ الْجُرَيْرِيُّ ،  عَنْ  أَبِي عَبْدِ اللهِ الْعَنَزِيِّ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ         [20/225]      عَلَيْهِ وَسَلَّمَ :  مَنِ اشْتَرَى رَقَبَةً  لِيُعْتِقَهَا  فَلَا يَشْتَرِطْ لِأَهْلِهَا الْعِتْقَ  ، فَإِنَّهُ عَقْدُهُ مِنَ الرِّقِّ  .","","Al-Mu'jam al-Kabir 523","","معقل بن يسار المزني عن حميري بن بشير الجسري عن سعيد بن إياس الجريري عن سعيد بن الفضل القرشي مولاهم عن الوليد بن شجاع عن محمد بن أحمد بن أبي خيثمة النسائي عن الطبراني","أبو عبد الله الجسري عن معقل بن يسار"
"18701","أَبُو الْمَلِيحِ بْنُ أُسَامَةَ الْهُذَلِيُّ  ، عَنْ  مَعْقِلِ بْنِ يَسَارٍ  524  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ، (  ح  )  وَحَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالَا :  ثَنَا  بُنْدَارٌ قَالَا :  ثَنَا  مُعَاذُ بْنُ هِشَامٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ أَمِيرٍ اسْتُرْعِيَ رَعِيَّةً لَمْ يُحِطْ بِهَا  وَيَنْصَحْ لَهُمْ إِلَّا لَمْ يَدْخُلْ مَعَهُمُ الْجَنَّةَ  .","","Al-Mu'jam al-Kabir 524","","معقل بن يسار المزني عن أبو المليح بن أسامة الهذلي عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن محمد بن بشار بندار عن عبد الله بن أحمد الجواليقي عن الطبراني","أبو المليح بن أسامة الهذلي عن معقل بن يسار"
"18702","525  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ الْجُذُوعِيُّ الْقَاضِي ،  ثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  ثَنَا  أَبُو بَكْرٍ الْحَنَفِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ أَبِي حُمَيْدٍ الْهُذَلِيُّ ،  ثَنَا  أَبُو الْمَلِيحِ الْهُذَلِيُّ ،  حَدَّثَنِي  مَعْقِلُ بْنُ يَسَارٍ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  اعْمَلُوا بِالْقُرْآنِ ، وَأَحِلُّوا حَلَالَهُ ، وَحَرِّمُوا حَرَامَهُ ، وَاقْتَدُوا بِهِ ، وَلَا تَكْفُرُوا بِشَيْءٍ مِنْهُ  ، وَمَا تَشَابَهَ عَلَيْكُمْ فَرُدُّوهُ إِلَى اللهِ أَوْ إِلَى الْأَمِيرِ مِنْ بَعْدِي كَيْمَا يُخْبِرُونَكُمْ ، وَآمِنُوا بِالتَّوْرَاةِ وَالْإِنْجِيلِ وَالزَّبُورِ ، وَمَا أُوتِيَ النَّبِيُّونَ مِنْ رَبِّهِمْ ، وَلْيَشْفِكُمُ الْقُرْآنُ وَمَا فِيهِ مِنَ الْبَيَانِ ، فَإِنَّهُ شَافِعٌ مُشَفَّعٌ ،  وَمَاحِلٌ  مُصَدَّقٌ ، وَلِكُلِّ آيَةٍ مِنْهُ نُورٌ إِلَى يَوْمِ الْقِيَامَةِ ، أَمَا إِنِّي أُعْطِيتُ سُورَةَ الْبَقَرَةِ مِنَ الذِّكْرِ ،         [20/226]      وَأُعْطِيتُ         {      طه         }      وَ "" الطُّورَ "" مِنْ أَلْوَاحِ  مُوسَى  ، وَأُعْطِيتُ فَاتِحَةَ الْكِتَابِ وَخَوَاتِيمَ الْبَقَرَةِ مِنْ كَنْزٍ تَحْتَ الْعَرْشِ ، وَأُعْطِيتُ الْمُفَصَّلَ نَافِلَةً  .","","Al-Mu'jam al-Kabir 525","","معقل بن يسار المزني عن أبو المليح بن أسامة الهذلي عن عبيد الله بن أبي حميد الهذلي عن عبد الكبير بن عبد المجيد الحنفي عن عقبة بن مكرم عن الجذوعى محمد بن محمد بن إسماعيل عن الطبراني","أبو المليح بن أسامة الهذلي عن معقل بن يسار"
"18703","526  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ نَاجِيَةَ ،  ثَنَا  مُحَمَّدُ بْنُ مَرْزُوقٍ  ،  ثَنَا  بَكْرُ بْنُ إِبْرَاهِيمَ  ،  ثَنَا  عُبَيْدُ اللهِ بْنُ أَبِي حُمَيْدٍ ،  عَنْ  أَبِي الْمَلِيحِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ :  حَجَجْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَوَجَدَ  عَائِشَةَ  تَنْزِعُ ثِيَابَهَا  ، فَقَالَ لَهَا : "" مَا لَكِ ؟ "" . قَالَتْ : أُنْبِئْتُ أَنَّكَ قَدْ أَحْلَلْتَ وَأَحْلَلْتَ أَهْلَكَ ، قَالَ : "" أَجَلْ ، مَنْ لَيْسَ مَعَهُ هَدْيٌ ، وَأَمَّا نَحْنُ فَلَمْ نَحِلَّ ، إِنَّ مَعَنَا بُدْنًا حَتَّى نَبْلُغَ  عَرَفَاتٍ  .  كذا في طبعة مكتبة ابن تيمية ونسخة أحمد الثالث ، والصواب : ( إبراهيم بن مرزوق ) وينظر شرح معاني الآثار]  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( مكي بن إبراهيم )","","Al-Mu'jam al-Kabir 526","","معقل بن يسار المزني عن أبو المليح بن أسامة الهذلي عن عبيد الله بن أبي حميد الهذلي عن مكي بن إبراهيم عن إبراهيم بن مرزوق بن دينار الأموي عن عبد الله بن محمد بن ناجية البربري عن الطبراني","أبو المليح بن أسامة الهذلي عن معقل بن يسار"
"18704","حِمْيَرِيُّ بْنُ بَشِيرٍ  ، عَنْ  مَعْقِلِ بْنِ يَسَارٍ  527  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ شُعَيْبٍ ،  ثَنَا  الْحَسَنُ بْنُ بِشْرٍ الْبَجَلِيُّ ،  ثَنَا  الْحَكَمُ بْنُ عَبْدِ الْمَلِكِ ،  عَنْ  قَتَادَةَ ،  عَنْ  حِمْيَرِيِّ بْنِ بَشِيرٍ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَرِهَ اللهُ لَكُمْ ثَلَاثًا :  عُقُوقَ  الْأُمَّهَاتِ ،  وَوَأْدَ  الْبَنَاتِ ،  وَمَنَعَ  وَهَاتِ  .","","Al-Mu'jam al-Kabir 527","","معقل بن يسار المزني عن حميري بن بشير الجسري عن قتادة بن دعامة عن الحكم بن عبد الملك القرشي عن الحسن بن بشر الكاهلي عن محمد بن علي بن شعيب السمسار عن الطبراني","حميري بن بشير عن معقل بن يسار"
"18705","عِيَاضٌ أَبُو خَالِدٍ الْبَجَلِيُّ  ، عَنْ  مَعْقِلِ بْنِ يَسَارٍ  528  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  شُعْبَةَ ،  حَدَّثَنِي  عِيَاضٌ أَبُو خَالِدٍ ، قَالَ :  كَانَ بَيْنَ جَارَيْنِ لِي يَمِينٌ ، فَصَارَتِ         [20/227]      الْيَمِينُ عَلَى أَحَدِهِمَا ،  فَسَمِعْتُ  مَعْقِلَ بْنَ يَسَارٍ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ حَلَفَ عَلَى يَمِينٍ  يَقْتَطِعُ  بِهَا مَالَ أَخِيهِ لَقِيَ اللهَ وَهُوَ عَلَيْهِ غَضْبَانُ  .","","Al-Mu'jam al-Kabir 528","","معقل بن يسار المزني عن عياض البجلي عن شعبة بن الحجاج عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عياض أبو خالد البجلي عن معقل بن يسار"
"18706","529  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عِيَاضٍ أَبِي خَالِدٍ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 529","","معقل بن يسار المزني عن عياض البجلي عن شعبة بن الحجاج عن وهب بن جرير بن حازم عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","عياض أبو خالد البجلي عن معقل بن يسار"
"18707","الْحَكَمُ الْأَعْرَجُ  ، عَنْ  مَعْقِلِ بْنِ يَسَارٍ  530  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  خَالِدٌ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنِ  الْحَكَمِ الْأَعْرَجِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ :  بَايَعْنَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ الْحُدَيْبِيَةِ  وَأَنَا أَرْفَعُ غُصْنَ الشَّجَرَةِ عَنْ وَجْهِهِ  ، فَبَايَعْنَاهُ عَلَى أَنْ لَا نَفِرَّ وَلَمْ  نُبَايِعْهُ  عَلَى الْمَوْتِ "" ، فَقُلْنَا لَهُ : كَمْ كُنْتُمْ ؟ قَالَ : أَلْفٌ وَأَرْبَعُمِائَةٍ  .","","Al-Mu'jam al-Kabir 530","","معقل بن يسار المزني عن الحكم بن عبد الله بن إسحاق الأعرج عن خالد الحذاء عن خالد بن عبد الله الطحان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","الحكم الأعرج عن معقل بن يسار"
"18708","531  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ، قَالَا :  ثَنَا  عَبْدُ الْوَهَّابِ الثَّقَفِيُّ ،  ثَنَا  خَالِدٌ الْحَذَّاءُ ،  عَنِ  الْحَكَمِ بْنِ عَبْدِ اللهِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ قَالَ :  كُنْتُ رَافِعًا أَغْصَانَ الشَّجَرَةِ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، "" فَبَايَعَ النَّاسُ عَلَى أَنْ لَا يَفِرُّوا "" وَهُمْ يَوْمَئِذٍ أَلْفٌ وَأَرْبَعُمِائَةٍ  .","","Al-Mu'jam al-Kabir 531","","معقل بن يسار المزني عن الحكم بن عبد الله بن إسحاق الأعرج عن خالد الحذاء عن عبد الوهاب بن عبد المجيد الثقفي عن محمد بن أبي بكر المقدمي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","الحكم الأعرج عن معقل بن يسار"
"18709","532  -  حَدَّثَنَا  يَحْيَى بْنُ مُحَمَّدٍ الْحِنَّائِيُّ ،  ثَنَا  أَبُو كَامِلٍ الْجَحْدَرِيُّ         [20/228]      ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنِ  الْحَكَمِ بْنِ عَبْدِ اللهِ بْنِ الْأَعْرَجِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ قَالَ :  لَقَدْ رَأَيْتُنِي يَوْمَ الشَّجَرَةِ وَالنَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ""  يُبَايِعُ  النَّاسَ  ، وَأَنَا رَافِعٌ غُصْنًا مِنْ أَغْصَانِهَا عَنْ رَأْسِهِ ، لَمْ  نُبَايِعْهُ  عَلَى الْمَوْتِ ، وَلَكِنْ بَايَعْنَاهُ عَلَى أَنْ لَا نَفِرَّ  .","","Al-Mu'jam al-Kabir 532","","معقل بن يسار المزني عن الحكم بن عبد الله بن إسحاق الأعرج عن خالد الحذاء عن يزيد بن زريع العيشي عن فضيل بن حسين الجحدري عن يحيى بن محمد بن البختري الحنائي عن الطبراني","الحكم الأعرج عن معقل بن يسار"
"18710","أَبُو الْأَسْوَدِ الدُّؤَلِيُّ  ، عَنْ  مَعْقِلٍ  533  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ، (  ح  )  وَحَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ، قَالَا :  ثَنَا  سَوَادَةُ بْنُ أَبِي الْأَسْوَدِ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَا مِنْ رَاعٍ  غَشَّ  رَعِيَّتَهُ إِلَّا وَهُوَ فِي النَّارِ  .","","Al-Mu'jam al-Kabir 533","","معقل بن يسار المزني عن مسلم بن مخراق القطان عن سوادة بن أبي الأسود القطان عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","أبو الأسود الدؤلي عن معقل"
"18711","534  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ الْجُذُوعِيُّ ،  ثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  ثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ الْحَضْرَمِيُّ ،  ثَنَا  سَوَادَةُ بْنُ أَبِي الْأَسْوَدِ ،  عَنْ  أَبِيهِ  ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 534","","معقل بن يسار المزني عن مسلم بن مخراق القطان عن سوادة بن أبي الأسود القطان عن يعقوب بن إسحاق بن زيد الحضرمي عن عقبة بن مكرم عن الجذوعى محمد بن محمد بن إسماعيل عن الطبراني","أبو الأسود الدؤلي عن معقل"
"18712","أَبُو طَلِيقٍ  ، عَنْ  مَعْقِلٍ  535  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  نَصْرُ بْنُ طَرِيفٍ ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ،  حَدَّثَنِي  طَلِيقٌ ،  عَنْ  أَبِيهِ  ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ فَرَّقَ فَلَيْسَ مِنَّا  .  قَالَ  أَسَدٌ  : ""  يُفَرِّقُ بَيْنَ الْوَلَدِ وَأُمِّهِ وَبَيْنَ الْإِخْوَةِ  "" .         [20/229]","","Al-Mu'jam al-Kabir 535","","معقل بن يسار المزني عن عمران بن حصين بن عبيد بن خلف الخزاعي عن طليق بن عمران الخزاعي عن سليمان بن طرخان عن نصر بن طريف القصاب عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","أبو طليق عن معقل"
"18713","عَمْرُو بْنُ مَيْمُونٍ الْأَوْدِيُّ  ، عَنْ  مَعْقِلٍ  536  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالَا :  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  شَبَابَةُ بْنُ سَوَّارٍ ،  ثَنَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ الْمُزَنِيِّ ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أُتِيَ بِفَرِيضَةٍ فِيهَا جَدٌّ فَأَعْطَاهُ ثُلُثًا أَوْ سُدُسًا  .","","Al-Mu'jam al-Kabir 536","","معقل بن يسار المزني عن عمرو بن ميمون الأودي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن شبابة بن سوار المدائني عن أبو بكر ابن أبي شيبة عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن ميمون الأودي عن معقل"
"18714","نَافِعُ بْنُ أَبِي نَافِعٍ  ، عَنْ  مَعْقِلِ بْنِ يَسَارٍ  537  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَسَدِيُّ ،  ثَنَا  خَالِدُ بْنُ طَهْمَانَ ،  عَنْ  نَافِعِ بْنِ أَبِي نَافِعٍ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ قَالَ حِينَ يُصْبِحُ ثَلَاثَ مَرَّاتٍ : أَعُوذُ بِالسَّمِيعِ الْعَلِيمِ مِنَ الشَّيْطَانِ الرَّجِيمِ  ، وَقَرَأَ ثَلَاثَ مِرَارٍ آخِرَ سُورَةِ الْحَشْرِ ، وَكَّلَ اللهُ بِهِ سَبْعِينَ أَلْفَ مَلَكٍ يُصَلُّونَ عَلَيْهِ حَتَّى يُمْسِيَ ، إِنْ مَاتَ فِي ذَلِكَ الْيَوْمِ مَاتَ  شَهِيدًا  ، فَإِنْ قَالَهَا حِينَ يُمْسِي كَانَ مِثْلَ ذَلِكَ  .","","Al-Mu'jam al-Kabir 537","","معقل بن يسار المزني عن نافع بن أبي نافع البزاز عن خالد بن طهمان السلولي عن محمد بن عبد الله بن الزبير عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","نافع بن أبي نافع عن معقل بن يسار"
"18715","538  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي         [20/230]      شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَسَدِيُّ ،  ثَنَا  خَالِدُ بْنُ طَهْمَانَ ،  عَنْ  نَافِعِ بْنِ أَبِي نَافِعٍ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ قَالَ :  وَضَّأْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَاتَ يَوْمٍ ، فَقَالَ لِي : "" هَلْ لَكَ فِي  فَاطِمَةَ  "" ؟ -  يَعْنِي ابْنَتَهَ  - قُلْتُ : نَعَمْ ، فَقَامَ مُتَوَكِّئًا عَلَيَّ فَقَالَ :  أَمَا إِنَّهُ سَيَحْمِلُ الثِّقْلَ غَيْرُكَ وَيَكُونُ الْأَجْرُ لَكَ  ، فَكَأَنَّهُ لَمْ يَكُنْ عَلَيَّ شَيْءٌ حَتَّى دَخَلْنَا عَلَى  فَاطِمَةَ  ، فَقَالَ لَهَا : "" كَيْفَ تَجِدِينَكِ ؟ "" فَقَالَتْ : وَاللهِ لَقَدِ اشْتَدَّ حُزْنِي ، وَاشْتَدَّتْ  فَاقَتِي  ، وَطَالَ سُقْمِي ، فَقَالَ : "" أَمَا تَرْضَيْنَ أَنْ زَوَّجْتُكِ أَقْدَمَ أُمَّتِي سِلْمًا ، وَأَكْثَرَهُمْ عِلْمًا ، وَأَحْلَمَهُمْ حِلْمًا . "" ؟","","Al-Mu'jam al-Kabir 538","","معقل بن يسار المزني عن نافع بن أبي نافع البزاز عن خالد بن طهمان السلولي عن محمد بن عبد الله بن الزبير عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","نافع بن أبي نافع عن معقل بن يسار"
"18716","539  -  حَدَّثَنَا  أَبُو عَرُوبَةَ ،  ثَنَا  أَبُو الْمُعَافَى مُحَمَّدُ بْنُ وَهْبِ بْنِ أَبِي كَرِيمَةَ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي عَبْدِ الرَّحِيمِ ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  نُفَيْعِ بْنِ الْحَارِثِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ قَالَ :  أَمَرَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ أَقْضِيَ بَيْنَ قَوْمِي ، فَقُلْتُ : مَا أُحْسِنُ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اللهُ مَعَ الْقَاضِي مَا لَمْ يَحِفْ عَمْدًا  .","","Al-Mu'jam al-Kabir 539","","معقل بن يسار المزني عن نفيع بن الحارث الأعمى عن زيد بن أبي أنيسة الجزري عن خالد بن يزيد الحراني عن محمد بن سلمة الباهلي عن محمد بن وهب بن عمر الحراني عن الحسين بن محمد بن أبي معشر الجزري عن الطبراني","نافع بن أبي نافع عن معقل بن يسار"
"18717","540  -  حَدَّثَنَا  عَبْدَانُ بْنُ مُحَمَّدٍ الْمَرْوَزِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  أَنَا  حَمْزَةُ بْنُ عُمَيْرٍ ،  ثَنَا  أَيُّوبُ بْنُ إِبْرَاهِيمَ أَبُو يَحْيَى الْمُعَلِّمُ ،  عَنْ  إِبْرَاهِيمَ الصَّائِغِ ،  عَنْ  أَبِي خَالِدِ بْنِ خَالِدٍ الضَّبِّيِّ ،  عَنْ  أَبِي دَاوُدَ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ :  أَمَرَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ أَقْضِيَ بَيْنَ قَوْمِي ، فَقُلْتُ : مَا أُحْسِنُ الْقَضَاءَ ، فَقَالَ :  اقْضِ بَيْنَهُمْ ، فَإِنَّ اللهَ عَزَّ وَجَلَّ مَعَ الْقَاضِي مَا لَمْ يَحِفْ عَمْدًا  .","","Al-Mu'jam al-Kabir 540","","معقل بن يسار المزني عن نفيع بن الحارث الأعمى عن محمد بن خالد الضبي عن إبراهيم بن ميمون الصائغ عن أيوب بن إبراهيم عبدويه عن حمزة بن الحارث العدوي عن إسحاق ابن راهويه عن عبدان بن محمد الجنوجردى عن الطبراني","نافع بن أبي نافع عن معقل بن يسار"
"18718","رَجُلٌ لَمْ يُسَمَّ ، عَنْ  مَعْقِلِ بْنِ يَسَارٍ  541  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ         [20/231]      الْمُقَدَّمِيُّ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِيهِ  ،  حَدَّثَنِي  رَجُلٌ ،  عَنْ  أَبِيهِ  ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْبَقَرَةُ سَنَامُ الْقُرْآنِ وَذُرْوَتُهُ  ، وَنَزَلَ مَعَ كُلِّ آيَةٍ مِنْهَا ثَمَانُونَ مَلَكًا ، وَاسْتُخْرِجَتِ :         {      اللهُ لا إِلَهَ إِلا هُوَ الْحَيُّ الْقَيُّومُ         }      مِنْ تَحْتِ الْعَرْشِ ، فَوُصِلَتْ بِهَا سُورَةُ الْبَقَرَةِ ، وَ         {      يس         }      قَلْبُ الْقُرْآنِ ، لَا يَقْرَؤُهَا رَجُلٌ يُرِيدُ اللهَ وَالدَّارَ الْآخِرَةَ إِلَّا غَفَرَ اللهُ لَهُ ، اقْرَؤُوهَا عَلَى مَوْتَاكُمْ  .","","Al-Mu'jam al-Kabir 541","","معقل بن يسار المزني عن أبيه عن رجل عن سليمان بن طرخان عن معتمر بن سليمان عن محمد بن أبي بكر المقدمي عن إبراهيم بن هاشم البغوي عن الطبراني","رجل لم يسم عن معقل بن يسار"
"18719","مَعْقِلُ بْنُ سِنَانٍ الْأَشْجَعِيُّ  542  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  دَاوُدَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَلْقَمَةَ ،  عَنِ  ابْنِ مَسْعُودٍ قَالَ : ""  لَهَا صَدَاقُ نِسَائِهَا ، لَا  وَكْسَ ،  وَلَا  شَطَطَ ،  وَعَلَيْهَا الْعِدَّةُ ، وَلَهَا الْمِيرَاثُ  "" ، فَقَامَ أَبُو سِنَانٍ الْأَشْجَعِيُّ فِي رَهْطٍ مِنْ  أَشْجَعَ  ، فَشَهِدُوا "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَضَى بِذَلِكَ فِي  بَرْوَعَ بِنْتِ وَاشِقٍ الْأَشْجَعِيِّ  ""  .","","Al-Mu'jam al-Kabir 542","","معقل بن سنان بن مظهر الأشجعي عن علقمة بن قيس النخعي عن الشعبي عن داود بن أبي هند عن حماد بن سلمة عن أبو الوليد الطيالسي عن أبو مسلم الكجي عن الطبراني","معقل بن سنان الأشجعي"
"18720","543  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ قَالَ :  أُتِيَ عَبْدُ اللهِ بْنُ مَسْعُودٍ فَسُئِلَ عَنْ  رَجُلٍ  تَزَوَّجَ  امْرَأَةً  وَلَمْ يَفْرِضْ لَهَا  ، وَلَمْ يُصِبْهَا حَتَّى مَاتَ ، فَرَدَّدَهُمْ ، ثُمَّ قَالَ : فَإِنِّي أَقُولُ فِيهَا بِرَأْيِي ، فَإِنْ كَانَ صَوَابًا فَمِنَ اللهِ ، وَإِنْ كَانَ خَطَأً فَمِنِّي ؛ أَرَى لَهَا صَدَاقَ امْرَأَةٍ مِنْ نِسَائِهَا - لَا  وَكْسَ  وَلَا  شَطَطَ  - وَعَلَيْهَا الْعِدَّةُ         [20/232]      ، وَلَهَا الْمِيرَاثُ  "" ، فَقَامَ مَعْقِلُ بْنُ سِنَانٍ الْأَشْجَعِيُّ  فَقَالَ  : "" أَشْهَدُ لَقَضَيْتَ فِيهَا بِقَضَاءِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  بَرْوَعَ بِنْتِ وَاشِقٍ  ""  امْرَأَةٌ مِنْ  بَنِي رُوَاسٍ حَيٍّ مِنْ بَنِي عَامِرِ بْنِ صَعْصَعَةَ  وَبِهِ يَأْخُذُ  سُفْيَانُ  .","","Al-Mu'jam al-Kabir 543","","معقل بن سنان بن مظهر الأشجعي عن علقمة بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","معقل بن سنان الأشجعي"
"18721","544  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  سُفْيَانُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  أَنَّ  ابْنَ مَسْعُودٍ ،  أُتِيَ فِي  رَجُلٍ  هَلَكَ وَتَرَكَ  امْرَأَتَهُ  وَلَمْ يَكُنْ دَخَلَ بِهَا ، وَلَمْ يَفْرِضْ لَهَا صَدَاقًا  ، فَتَرَدَّدُوا إِلَيْهِ فِيهَا شَهْرًا لَا يَقُولُ فِيهَا شَيْئًا ، فَقَالَ : أَقُولُ فِيهَا بِرَأْيِي ، فَإِنْ يَكُنْ خَطَأً فَمِنْ نَفْسِي ، وَإِنْ يَكُنْ صَوَابًا فَمِنَ اللهِ ، أَقُولُ : "" لَهَا مَهْرُ نِسَائِهَا ، وَعَلَيْهَا الْعِدَّةُ ، وَلَهَا الْمِيرَاثُ  "" ، فَقَامَ مَعْقِلُ بْنُ يَسَارٍ الْأَشْجَعِيُّ ،  فَقَالَ  :  قَضَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  بَرْوَعَ بِنْتِ وَاشِقٍ  مِثْلَ مَا قَضَيْتَ  ، فَفَرِحَ  ابْنُ مَسْعُودٍ  .","","Al-Mu'jam al-Kabir 544","","معقل بن سنان بن مظهر الأشجعي عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن سفيان الثوري عن موسى بن مسعود النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","معقل بن سنان الأشجعي"
"18722","545  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  فِرَاسٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ، قَالَ :  أُتِيَ عَبْدُ اللهِ فِي  رَجُلٍ  تَرَكَ  امْرَأَتَهُ  وَلَمْ يَكُنْ دَخَلَ بِهَا  ، فَتَرَدَّدُوا إِلَيْهِ فِيهَا شَهْرًا لَا يَقْضِي فِيهَا بِشَيْءٍ ، فَقَالَ : أَقُولُ فِيهَا بِرَأْيِي ، فَإِنْ يَكُنْ خَطَأً فَمِنْ نَفْسِي ، وَإِنْ يَكُنْ صَوَابًا فَمِنَ اللهِ ، "" مِثْلُ مَهْرِ نِسَائِهَا ، وَعَلَيْهَا الْعِدَّةُ ، وَلَهَا الْمِيرَاثُ  "" ، فَقَامَ أَبُو سِنَانٍ الْأَشْجَعِيُّ  فَقَالَ  :  قَضَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  بَرْوَعَ بِنْتِ وَاشِقٍ  بِذَلِكَ  فَفَرِحَ بِذَلِكَ  عَبْدُ اللهِ  .","","Al-Mu'jam al-Kabir 545","","معقل بن سنان بن مظهر الأشجعي عن مسروق بن الأجدع عن الشعبي عن فراس بن يحيى الخارفي عن سفيان الثوري عن موسى بن مسعود النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","معقل بن سنان الأشجعي"
"18723","546  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، وَأَبُو عُبَيْدَةَ عَبْدُ الْوَارِثِ بْنُ إِبْرَاهِيمَ الْعَسْكَرِيُّ قَالَا :  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  الْمُحَارِبِيُّ         [20/233]      ،  ثَنَا  يَزِيدُ بْنُ عَبْدِ الرَّحْمَنِ الدَّالَانِيُّ ،  عَنْ  فِرَاسٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ،  فِي  رَجُلٍ  تَزَوَّجَ  امْرَأَةً  فَمَاتَ عَنْهَا ، وَلَمْ يَدْخُلْ بِهَا وَلَمْ يَفْرِضْ لَهَا  ، فَقَالَ : "" لَهَا الصَّدَاقُ كَامِلًا ، وَعَلَيْهَا الْعِدَّةُ ، وَلَهَا الْمِيرَاثُ  "" ،  فَقَالَ  مَعْقِلُ بْنُ سِنَانٍ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" قَضَى بِهِ فِي  بَرْوَعَ بِنْتِ وَاشِقٍ  .","","Al-Mu'jam al-Kabir 546","","معقل بن سنان بن مظهر الأشجعي عن مسروق بن الأجدع عن الشعبي عن فراس بن يحيى الخارفي عن أبو خالد الدالاني عن عبد الرحمن بن محمد المحاربي عن سليمان بن داود العتكي عن عبد الوارث بن إبراهيم العسكري عن الطبراني","معقل بن سنان الأشجعي"
"18724","547  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  ثَنَا  عَطَاءُ بْنُ السَّائِبِ قَالَ :  شَهِدَ عِنْدِي  نَفَرٌ مِنْ  أَهْلِ الْبَصْرَةِ  - فِيهِمُ الْحَسَنُ بْنُ أَبِي الْحَسَنِ -  عَنْ  مَعْقِلِ بْنِ سِنَانٍ الْأَشْجَعِيِّ قَالَ :  مَرَّ عَلَيَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَنَا أَحْتَجِمُ فِي ثَمَانِيَ عَشْرَةَ خَلَتْ مِنْ رَمَضَانَ فَقَالَ :  أَفْطَرَ  الْحَاجِمُ  وَالْمَحْجُومُ  .","","Al-Mu'jam al-Kabir 547","","معقل بن سنان بن مظهر الأشجعي عن الحسن البصري عن عطاء بن السائب عن محمد بن فضيل بن غزوان عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","معقل بن سنان الأشجعي"
"18725","548  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ الدِّمَشْقِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  عَنْ  مُوسَى بْنِ يَعْقُوبَ ، (  ح  )  وَحَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ الْعَطَّارُ الْمَكِّيُّ ، وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَا :  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  حَدَّثَنَا  مَعْنُ بْنُ عِيسَى ،  حَدَّثَنَا  مُوسَى بْنُ يَعْقُوبَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْحُوَيْرِثِ ،  عَنْ  نَافِعِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ قَالَ : جَاءَنِي مَعْقِلُ بْنُ سِنَانٍ ،  فَأَخْبَرَنِي  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  غِفَارُ  ،  وَأَسْلَمُ  ،  وَجُهَيْنَةُ  ،  وَمُزَيْنَةُ  مَوَالِي  اللهِ عَزَّ وَجَلَّ وَرَسُولِهِ  .","","Al-Mu'jam al-Kabir 548","","معقل بن سنان بن مظهر الأشجعي عن نافع بن جبير بن مطعم النوفلي عن عبد الرحمن بن معاوية النوفلي عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن معن بن عيسى عن إبراهيم بن المنذر الحزامي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","معقل بن سنان الأشجعي"
"18726","[20/234]      مَعْقِلُ بْنُ أَبِي مَعْقِلٍ الْأَسَدِيُّ  549  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الصَّنْعَانِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  يَحْيَى بْنُ عَمْرٍو ،  عَنْ  أَبِي عَمَّارٍ الْأَنْصَارِيِّ ، أَنَّ أَبَا زَيْدٍ ، مَوْلَى ثَعْلَبَةَ  أَخْبَرَهُ  ، أَنَّ مَعْقِلَ بْنَ أَبِي مَعْقِلٍ الْأَسَدِيَّ ، مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  حَدَّثَهُ  "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى أَنْ تُسْتَقْبَلَ الْقِبْلَتَانِ بِالْغَائِطِ وَالْبَوْلِ  .","","Al-Mu'jam al-Kabir 549","","معقل بن أبي معقل الأسدي عن أبو زيد الثعلبي عن أبو عمار الأنصاري عن يحيى بن عمرو عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","معقل بن أبي معقل الأسدي"
"18727","550  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَنَا  دَاوُدُ بْنُ عَبْدِ الرَّحْمَنِ الْعَطَّارُ ،  عَنْ  عَمْرِو بْنِ يَحْيَى ،  عَنْ  أَبِي زَيْدٍ ، مَوْلَى ثَعْلَبَةَ ، عَنْ مَعْقِلِ بْنِ أَبِي مَعْقِلٍ الْأَسَدِيِّ  أَنَّهُ حَدَّثَهُ  ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى أَنْ تُسْتَقْبَلَ الْقِبْلَتَانِ بِغَائِطٍ أَوْ بَوْلٍ  .","","Al-Mu'jam al-Kabir 550","","معقل بن أبي معقل الأسدي عن أبو زيد الثعلبي عن عمرو بن يحيى بن عمارة المازني عن داود ابن النصراني عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","معقل بن أبي معقل الأسدي"
"18728","551  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ  ،  عَنْ  مُحَمَّدِ بْنِ أَبِي إِسْمَاعِيلَ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  مَعْقِلِ بْنِ أَبِي مَعْقِلٍ ،  أَنَّ أُمَّهُ  زَيْنَبَ  أَتَتْ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَتْ : يَا رَسُولَ اللهِ ، إِنَّ  أَبَا مَعْقِلٍ  كَانَ وَعَدَنِي أَنْ لَا يَحُجَّ إِلَّا وَأَنَا مَعَهُ ، فَحَجَّ عَلَى رَاحِلَتِهِ وَلَمْ أُطِقْ ، فَسَأَلْتُهُ  جِدَادَ  نَخْلِهِ         [20/235]      فَقَالَ : هُوَ قُوتُ عِيَالِي ، وَسَأَلْتُهُ  بَكْرًا  عِنْدَهُ فَقَالَ : هُوَ فِي  سَبِيلِ  اللهِ لَسْتُ أُعْطِيكِهِ ، فَقَالَ : ""  أَبَا مَعْقِلٍ  ، مَا تَقُولُ  أُمُّ مَعْقِلٍ  ؟ "" فَقَالَ : صَدَقَتْ ، قَالَ :  أَعْطِهَا بَكْرَكَ فَإِنَّ  الْحَجَّ  سَبِيلُ  اللهِ  ، فَأَعْطَاهَا بَكْرَهُ ، فَقَالَتْ : إِنِّي امْرَأَةٌ قَدْ سَقِمْتُ وَكَبُرْتُ ، وَأَخَافُ أَنْ لَا أُدْرِكَ  الْحَجَّ  حَتَّى أَمُوتَ ، فَهَلْ شَيْءٌ يُجْزِئُ عَنِ  الْحَجِّ  ؟ فَقَالَ : "" نَعَمْ عُمْرَةٌ فِي رَمَضَانَ تَعْدِلُ حَجَّةً  ، فَاعْتَمَرْتُ فِي رَمَضَانَ .  كذا في طبعة مكتبة ابن تيمية ، ولعل الصواب: ( بن نمير ) .","","Al-Mu'jam al-Kabir 551","","معقل بن أبي معقل الأسدي عن أبو بكر بن عبد الرحمن راهب قريش عن إبراهيم بن مهاجر بن جابر البجلي عن محمد بن أبي إسماعيل السلمي عن عبد الله بن نمير عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","معقل بن أبي معقل الأسدي"
"18729","مَنِ اسْمُهُ  مِقْدَادٌ  مِقْدَادُ بْنُ عَمْرِو بْنِ الْأَسْوَدِ بَدْرِيٌّ "" وَقِيلَ : أَبُو عَمْرٍو حَلِيفُ بَنِي زُهْرَةَ  ، وَقَدِ اخْتُلِفَ فِي نَسَبِهِ : مُهَاجِرِيٌّ أَوْ بَدْرِيٌّ "" .  552  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ، ""  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  :  الْمِقْدَادُ بْنُ عَمْرٍو  .","","Al-Mu'jam al-Kabir 552","","","نسبة المقداد وذكر صفته وسنه ووفاته"
"18730","553  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ  ، قَالَ : ""  الْمِقْدَادُ بْنُ الْأَسْوَدِ بْنِ عَمْرٍو  "" .","","Al-Mu'jam al-Kabir 553","","","نسبة المقداد وذكر صفته وسنه ووفاته"
"18731","نِسْبَةُ  الْمِقْدَادِ  ، وَذِكْرُ صِفَتِهِ وَسِنِّهِ وَوَفَاتِهِ  554  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحِيمِ الْبَرْقِيُّ  ،  ثَنَا  عَبْدُ الْمَلِكِ بْنُ هِشَامٍ السَّدُوسِيُّ ،  ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ الْبَكَّائِيُّ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ :  الْمِقْدَادُ بْنُ عَمْرِو بْنِ ثَعْلَبَةَ بْنِ رَبِيعَةَ بْنِ ثُمَامَةَ بْنِ مَطْرُودِ بْنِ عَمْرِو بْنِ سَعْدِ بْنِ زُهَيْرِ بْنِ ثَوْرِ بْنِ ثَعْلَبَةَ بْنِ مَالِكِ بْنِ هَزْلِ بْنِ قَابِسِ بْنِ دُرَيْمِ بْنِ الْقَيْنِ بْنِ أَهْوَدَ بْنِ بَهْرَاءَ بْنِ عَمْرِو بْنِ الْحَافِ بْنِ قُضَاعَةَ  ، وَإِنَّمَا نُسِبَ إِلَى  الْأَسْوَدِ بْنِ عَبْدِ يَغُوثَ بْنِ وَهْبِ بْنِ عَبْدِ مَنَافِ بْنِ زُهْرَةَ ؛  لِأَنَّهُ  تَبَنَّاهُ  وَحَالَفَهُ ، وَكَانَ آدَمَ أَبْطَنَ يُصَفِّرُ لِحْيَتَهُ ،  أَقْنَى  طَوِيلَ الْأَنْفِ ، مَاتَ  بِالْمَدِينَةِ  وَهُوَ ابْنُ سَبْعِينَ سَنَةً ، وَصَلَّى عَلَيْهِ  عُثْمَانُ بْنُ عَفَّانَ  رَضِيَ اللهُ عَنْهُمَا  "" .         [20/236]","","Al-Mu'jam al-Kabir 554","","المقداد بن عمرو بن ثعلبة البهراني عن محمد بن إسحاق عن زياد بن عبد الله البكائي عن عبد الملك بن هشام الذهلي عن أحمد بن عبد الله ابن البرقي عن الطبراني","نسبة المقداد وذكر صفته وسنه ووفاته"
"18732","555  - حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ  ، ثَنَا  غُنْدَرٌ  ، عَنْ  شُعْبَةَ  ، عَنْ  مَنْصُورٍ  ، عَنْ  إِبْرَاهِيمَ  ، عَنْ  هَمَّامِ بْنِ الْحَارِثِ  قَالَ : ""  رَأَيْتُ  الْمِقْدَادَ  وَكَانَ ضَخْمًا  "" .","","Al-Mu'jam al-Kabir 555","","","نسبة المقداد وذكر صفته وسنه ووفاته"
"18733","556  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  بَقِيَّةُ ،  عَنْ  حَرِيزِ بْنِ عُثْمَانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ مَيْسَرَةَ ،  حَدَّثَنِي  أَبُو رَاشِدٍ الْحُبْرَانِيُّ قَالَ :  رَأَيْتُ الْمِقْدَادَ فَارِسَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَالِسًا عَلَى تَابُوتٍ مِنْ تَوَابِيتِ الصَّيَارِفَةِ  بِحِمْصَ  قَدْ أَفْصَلَ عَنْهَا مِنْ عِظَمِهِ يُرِيدُ الْغَزْوَ ، فَقُلْتُ : لَقَدْ  أَعْذَرَ  اللهُ إِلَيْكَ ، قَالَ : "" أَبَتْ عَلَيْنَا سُورَةُ الْبُعُوثِ :         {      انْفِرُوا خِفَافًا وَثِقَالا         }      "" .","","Al-Mu'jam al-Kabir 556","","المقداد بن عمرو بن ثعلبة البهراني عن أخضر الحبراني عن عبد الرحمن بن ميسرة الحمصي عن حريز بن عثمان الرحبي عن بقية بن الوليد عن عبد الوهاب بن نجدة عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","نسبة المقداد وذكر صفته وسنه ووفاته"
"18734","557  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ  ، حَدَّثَنِي  اللَّيْثُ  ، عَنْ  عُقَيْلٍ  ، عَنِ  ابْنِ شِهَابٍ  قَالَ : ""  كَانَ  الْمِقْدَادُ بْنُ الْأَسْوَدِ  مِنْ  كِنْدَةَ  "" .","","Al-Mu'jam al-Kabir 557","","","نسبة المقداد وذكر صفته وسنه ووفاته"
"18735","558  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ،  ثَنَا  سَعِيدُ بْنُ عُفَيْرٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنِ  ابْنِ شِمَاسَةَ ،  عَنْ  سُفْيَانَ بْنِ صُهْبَانَةَ         [20/237]      الْمَهْرِيِّ ، قَالَ :  كُنْتُ صَاحِبَ الْمِقْدَادِ بْنِ الْأَسْوَدِ فِي الْجَاهِلِيَّةِ  ، وَكَانَ رَجُلًا مِنْ  بَهْرَاءَ  ، فَأَصَابَ فِيهِمْ دَمًا فَهَرَبَ إِلَى  كِنْدَةَ  ، فَحَالَفَهُمْ ، ثُمَّ أَصَابَ فِيهِمْ دَمًا فَهَرَبَ إِلَى  مَكَّةَ  فَحَالَفَ  الْأَسْوَدَ بْنَ عَبْدِ يَغُوثَ  "" .","","Al-Mu'jam al-Kabir 558","","المقداد بن عمرو بن ثعلبة البهراني عن سفيان بن صهبانة المهري عن عبد الرحمن بن شماسة المهري عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن سعيد بن كثير بن عفير عن روح بن الفرج القطان عن الطبراني","نسبة المقداد وذكر صفته وسنه ووفاته"
"18736","559  -  حَدَّثَنَا  مُحَمَّدُ بْنُ حَيَّانَ الْمَازِنِيُّ ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  مَسْلَمَةُ بْنُ عَلْقَمَةَ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّ  الْمِقْدَادَ بْنَ الْأَسْوَدِ  اسْتَقْرَضَ مِنْ  عُثْمَانَ بْنِ عَفَّانَ  سَبْعَةَ آلَافٍ ، فَلَمَّا طَلَبَهَا مِنْهُ قَالَ : إِنَّمَا هِيَ أَرْبَعَةُ آلَافٍ  ، فَخَاصَمَهُ إِلَى عُمَرَ ، فَقَالَ  عُثْمَانُ  : أَقْرَضْتُهُ سَبْعَةَ آلَافٍ ، وَقَالَ  الْمِقْدَادُ  : تَحْلِفُ أَنَّهَا سَبْعَةُ آلَافٍ ؟ فَقَالَ : قَدْ أَنْصَفْتَ ، فَأَبَى أَنْ يَحْلِفَ ، فَقَالَ : خُذْ مَا أَعْطَاكَ ، فَقَالَ : وَاللهِ الَّذِي لَا إِلَهَ غَيْرُهُ إِنَّمَا هِيَ سَبْعَةُ آلَافٍ ؟ قَالَ : فَمَا يَمْنَعُكَ أَنْ تَحْلِفَ : أَنَّ هَذَا اللَّيْلُ وَهَذَا النَّهَارُ ؟ ""  .","","Al-Mu'jam al-Kabir 559","","عمر بن الخطاب عن الشعبي عن داود بن أبي هند عن مسلمة بن علقمة المازني عن مسدد بن مسرهد عن محمد بن حيان المازني عن الطبراني","نسبة المقداد وذكر صفته وسنه ووفاته"
"18737","560  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  قَالَ : ""  تُوُفِّيَ  الْمِقْدَادُ بْنُ الْأَسْوَدِ  بِالْجُرُفِ  ، وَحَمَلَهُ الرِّجَالُ إِلَى  الْمَدِينَةِ  عَلَى أَرْقَابِهِمْ فِي سَنَةِ ثَلَاثٍ وَثَلَاثِينَ ، وَصَلَّى عَلَيْهِ  عُثْمَانُ بْنُ عَفَّانَ  ، يُكْنَى  أَبَا مَعْبَدٍ  وَسِنُّهُ نَحْوٌ مِنْ سَبْعِينَ  "" .","","Al-Mu'jam al-Kabir 560","","","نسبة المقداد وذكر صفته وسنه ووفاته"
"18738","مَا أَسْنَدَ  الْمِقْدَادُ بْنُ الْأَسْوَدِ  عَلِيُّ بْنُ أَبِي طَالِبٍ  ، عَنِ  الْمِقْدَادِ بْنِ الْأَسْوَدِ  561  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  ثَنَا  أَبُو يَعْلَى الثَّوْرِيُّ ،  عَنْ  مُحَمَّدٍ ابْنِ الْحَنَفِيَّةِ ،  أَنَّ  عَلِيًّا قَالَ  :         [20/238]      اسْتَحْيَيْتُ أَنْ أَسْأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الْمَذْيِ  ، وَكَانَتِ ابْنَتُهُ تَحْتِي ، فَأَمَرْتُ  الْمِقْدَادَ  فَسَأَلَهُ ، فَقَالَ : "" فِيهِ الْوُضُوءُ  .","","Al-Mu'jam al-Kabir 561","","علي بن أبي طالب عن ابن الحنفية عن المنذر بن يعلى الثوري عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","علي بن أبي طالب عن المقداد بن الأسود"
"18739","562  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَائِشِ بْنِ أَنَسٍ ، قَالَ :  قَالَ  عَلِيُّ بْنُ أَبِي طَالِبٍ لِلْمِقْدَادِ : سَلْ لِي رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الرَّجُلِ يُلَاعِبُ امْرَأَتَهُ وَيُكَلِّمُهَا فَيُمْذِي ، فَلَوْلَا أَنِّي أَسْتَحْيِي مِنْهُ ، وَأَنَّ ابْنَتَهُ تَحْتِي لَسَأَلْتُهُ ، فَسَأَلَهُ  الْمِقْدَادُ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لِيَغْسِلْ ذَكَرَهُ ثُمَّ لْيَتَوَضَّأْ ، ثُمَّ  لْيَنْضَحْ  فَرْجَهُ  .","","Al-Mu'jam al-Kabir 562","","المقداد بن عمرو بن ثعلبة البهراني عن علي بن أبي طالب عن عائش بن أنس البكري عن عطاء بن أبي رباح عن عمرو بن دينار الأثرم عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","علي بن أبي طالب عن المقداد بن الأسود"
"18740","563  -  حَدَّثَنَا  إِسْحَاقُ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ، وَابْنِ جُرَيْجٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ، أَنَّ  عَلِيًّا قَالَ :  قُلْتُ  لِلْمِقْدَادِ : سَلْ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَإِنِّي لَوْلَا أَنَّ تَحْتِي ابْنَتَهُ لَسَأَلْتُهُ ، عَنْ أَحَدِنَا إِذَا مَا اقْتَرَبَ مِنِ امْرَأَتِهِ فَأَمْذَى ، وَلَمْ يَمْلِكْ ذَلِكَ وَلَمْ يَمَسَّهَا ؟ فَسَأَلَ  الْمِقْدَادُ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا أَمْذَى أَحَدُكُمْ وَلَمْ يَمَسَّهَا فَلْيَغْسِلْ ذَكَرَهُ وَأُنْثَيَيْهِ  .","","Al-Mu'jam al-Kabir 563","","المقداد بن عمرو بن ثعلبة البهراني عن علي بن أبي طالب عن عروة بن الزبير عن هشام بن عروة بن الزبير عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","علي بن أبي طالب عن المقداد بن الأسود"
"18741","564  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمِقْدَادِ ، قَالَ :  قَالَ لِي  عَلِيٌّ  : سَلْ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الرَّجُلِ يُلَاعِبُ أَهْلَهُ فَيَخْرُجُ مِنْهُ الْمَذْيُ ؟ فَقُلْتُ : يَا رَسُولَ اللهِ ، أَرَأَيْتَ الرَّجُلَ يُلَاعِبُ أَهْلَهُ فَيَخْرُجُ مِنْهُ الْمَذْيُ ؟ فَقَالَ :  يَغْسِلُ فَرْجَهُ ، وَيَتَوَضَّأُ وُضُوءَهُ لِلصَّلَاةِ  .","","Al-Mu'jam al-Kabir 564","","المقداد بن عمرو بن ثعلبة البهراني عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن إسحاق عن يزيد بن هارون عن إدريس بن جعفر العطار عن الطبراني","علي بن أبي طالب عن المقداد بن الأسود"
"18742","[20/239]      ابْنُ عَبَّاسٍ  ، عَنِ  الْمِقْدَادِ  565  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَمْرُو بْنُ عَوْنٍ الْوَاسِطِيُّ ،  ثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  جَاءَ  رَجُلٌ  فَمَدَحَ  عُثْمَانَ  ، فَقَامَ الْمِقْدَادُ يَحْثُو فِي وَجْهِهِ  التُّرَابَ ،  فَقَالَ لَهُ  عُثْمَانُ  : مَا لَكَ ؟ قَالَ : أَمَّا أَنَا فَلَا أَدَعُ شَيْئًا سَمِعْتُهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  احْثُوا  فِي وُجُوهِ الْمَدَّاحِينَ  التُّرَابَ  .","","Al-Mu'jam al-Kabir 565","","المقداد بن عمرو بن ثعلبة البهراني عن عبد الله بن عباس عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن خالد بن عبد الله الطحان عن عمرو بن عون الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ابن عباس عن المقداد"
"18743","566  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْحُسَيْنِ الْمِصِّيصِيُّ ،  ثَنَا  آدَمُ بْنُ أَبِي إِيَاسٍ ،  ثَنَا  بَكْرُ بْنُ خُنَيْسٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الْمِقْدَادِ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  احْثُوا  فِي وُجُوهِ الْمَدَّاحِينَ  التُّرَابَ  .","","Al-Mu'jam al-Kabir 566","","المقداد بن عمرو بن ثعلبة البهراني عن عبد الله بن عباس عن عكرمة مولى ابن عباس عن يزيد بن أبي زياد القرشي عن بكر بن خنيس الكوفي عن آدم بن أبي إياس عن عبد الله بن الحسين بن جابر المصيصي عن الطبراني","ابن عباس عن المقداد"
"18744","الْمُسْتَوْرِدُ بْنُ شَدَّادٍ الْفِهْرِيُّ  ، عَنِ  الْمِقْدَادِ  567  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، وَأَبُو حَاتِمٍ رَوْحُ بْنُ الْفَرَجِ الْبَغْدَادِيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ زُنْبُورٍ ،  ثَنَا  مُحَمَّدُ بْنُ جَابِرٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنِ  الْمُسْتَوْرِدِ بْنِ شَدَّادٍ قَالَ :  قَالَ  الْمِقْدَادُ بْنُ الْأَسْوَدِ قَالَ :  لَمَّا هَاجَرْنَا إِلَى  الْمَدِينَةِ  قَسَمَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَشَرَةً عَشَرَةً  ، فَكُنْتُ فِي الْعَشَرَةِ الَّذِينَ عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ         [20/240]      وَسَلَّمَ ، فَكَانَتْ لَنَا شَاةٌ نَشْرَبُ لَبَنَهَا بَيْنَنَا ، فَأَبْطَأَ عَلَيْنَا لَيْلَةً وَقَدْ رَفَعْنَا لَهُ نَصِيبَهُ ، فَقُمْتُ إِلَيْهِ وَأَنَا جَائِعٌ فَشَرِبْتُهُ ، فَجَاءَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَمْ أَنَمْ - فَأَتَى الْإِنَاءَ الَّذِي كُنَّا نَضَعُ فِيهِ اللَّبَنَ ، فَنَظَرَ فَلَمْ يَجِدْ فِيهِ شَيْئًا ، فَوَثَبْتُ فَقُلْتُ : يَا رَسُولَ اللهِ ، أَلَا أَذْبَحُهَا لَكَ ؟ قَالَ : "" لَا  .","","Al-Mu'jam al-Kabir 567","","المقداد بن عمرو بن ثعلبة البهراني عن المستورد بن شداد الفهري عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن محمد بن جابر بن سيار عن محمد بن زنبور الهاشمي عن روح بن الفرج بن زكريا البغدادي عن الطبراني","المستورد بن شداد الفهري عن المقداد"
"18745","طَارِقُ بْنُ شِهَابٍ الْأَحْمَسِيُّ  ، عَنِ  الْمِقْدَادِ  568  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عُمَرُ بْنُ حَفْصِ بْنِ غِيَاثٍ ،  حَدَّثَنِي  أَبِي  ،  حَدَّثَنِي  الْأَعْمَشُ ،  عَنْ  قَيْسِ بْنِ مُسْلِمٍ ،  عَنْ  طَارِقِ بْنِ شِهَابٍ ،  عَنِ  الْمِقْدَادِ بْنِ الْأَسْوَدِ قَالَ :  كُنَّا مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَكَانَ "" جَزَّأَنَا عَشَرَةً فِي بَيْتٍ  ، عَشَرَةً فِي بَيْتٍ ، فَكُنْتُ أَنَا عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَكَانَتْ عِنْدَنَا شَاةٌ نَقُوتُهَا  .","","Al-Mu'jam al-Kabir 568","","المقداد بن عمرو بن ثعلبة البهراني عن طارق بن شهاب الأحمسي عن قيس بن مسلم الجدلي عن الأعمش عن حفص بن غياث النخعي عن عمر بن حفص بن غياث عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","طارق بن شهاب الأحمسي عن المقداد"
"18746","569  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  الْأَسْوَدُ بْنُ عَامِرٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  سُلَيْمَانَ بْنِ مَيْسَرَةَ ،  عَنْ  طَارِقِ بْنِ شِهَابٍ ،  عَنِ  الْمِقْدَادِ ، قَالَ :  لَمَّا نَزَلْنَا  الْمَدِينَةَ  عَشَّرَنَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَشَرَةً عَشَرَةً فِي كُلِّ بَيْتٍ ، فَكُنْتُ فِي الْعَشَرَةِ الَّذِينَ كَانَ النَّبِيُّ مِنْهُمْ ، قَالَ : وَلَمْ يَكُنْ لَنَا إِلَّا شَاةٌ نَتَجَزَّأُ لَبَنَهَا ، فَكُنَّا إِذَا أَبْطَأَ عَلَيْنَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ شَرِبْنَا ، وَبَقَّيْنَا لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَصِيبَهُ ، فَلَمَّا كَانَ ذَاتَ لَيْلَةٍ أَبْطَأَ عَلَيْنَا ، قَالَ : وَنِمْنَا ، فَقَالَ  الْمِقْدَادُ  : لَقَدْ أَطَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مَا أُرَاهُ يَجِيءُ اللَّيْلَةَ ، لَعَلَّ إِنْسَانًا دَعَاهُ ، قَالَ : فَشَرِبْتُهُ ، فَلَمَّا ذَهَبَ اللَّيْلُ جَاءَ فَدَخَلَ ، فَلَمَّا دَخَلَ سَلَّمَ وَلَمْ يَشُدَّ ، ثُمَّ قَامَ إِلَى         [20/241]      الْقَدَحِ ، فَلَمَّا لَمْ يَرَ شَيْئًا سَكَتَ ، ثُمَّ قَالَ :  اللَّهُمَّ أَطْعِمْ مَنْ أَطْعَمَنَا اللَّيْلَةَ  فَوَثَبْتُ فَأَخَذْتُ  السِّكِّينَ  فَأَتَيْتُهُ بِهَا ، فَمَسَحَ ضَرْعَهَا فَخَرَجَ شَيْءٌ ثُمَّ شَرِبَ ثُمَّ نَامَ  .","","Al-Mu'jam al-Kabir 569","","المقداد بن عمرو بن ثعلبة البهراني عن طارق بن شهاب الأحمسي عن سليمان بن ميسرة الأحمسي عن الأعمش عن أبو بكر بن عياش عن الأسود بن عامر شاذان عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","طارق بن شهاب الأحمسي عن المقداد"
"18747","سَعِيدُ بْنُ الْعَاصِ  ، عَنِ  الْمِقْدَادِ  570  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  سَعِيدِ بْنِ الْعَاصِ قَالَ :  بَعَثَ وَفْدٌ مِنْ  أَهْلِ الْعِرَاقِ  إِلَى  عُثْمَانَ  فَجَعَلُوا يُثْنُونَ عَلَيْهِ ، فَجَعَلَ الْمِقْدَادُ يَحْثُو فِي وُجُوهِهِمُ  التُّرَابَ  ، وَقَالَ :  أَمَرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ نَحْثُوَ فِي وُجُوهِ الْمَدَّاحِينَ  التُّرَابَ  .","","Al-Mu'jam al-Kabir 570","","المقداد بن عمرو بن ثعلبة البهراني عن عكة العسل ، سعيد بن العاص بن أبي أحيحة عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سعيد بن العاص عن المقداد"
"18748","السَّائِبُ بْنُ يَزِيدَ  ، عَنِ  الْمِقْدَادِ  571  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  مُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ ،  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنْ  مُحَمَّدِ بْنِ يُوسُفَ ،  عَنِ  السَّائِبِ بْنِ يَزِيدَ ، قَالَ :  صَحِبْتُ طَلْحَةَ بْنَ عُبَيْدِ اللهِ ، وَالْمِقْدَادَ بْنَ الْأَسْوَدِ فَمَا سَمِعْتُ أَحَدًا مِنْهُمْ يُحَدِّثُ عَنْ رَسُولِ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، إِلَّا أَنِّي سَمِعْتُ  طَلْحَةَ  يُحَدِّثُ عَنْ  يَوْمِ أُحُدٍ  "" .","","Al-Mu'jam al-Kabir 571","","المقداد بن عمرو بن ثعلبة البهراني عن السائب بن يزيد الكندي عن محمد بن يوسف بن عبد الله الأعرج عن حاتم بن إسماعيل الحارثي عن محمد بن عباد بن الزبرقان المكي عن عبد الله بن أحمد بن حنبل عن الطبراني","السائب بن يزيد عن المقداد"
"18749","[20/242]      عَبْدُ الرَّحْمَنِ بْنُ أَبِي لَيْلَى  ، عَنِ  الْمِقْدَادِ  572  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، وَجَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ، قَالَا :  ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنِ  الْمِقْدَادِ بْنِ عَمْرٍو ، قَالَ :  قَدِمْتُ  الْمَدِينَةَ  أَنَا وَصَاحِبَانِ لِي ، فَجَعَلْنَا نَتَعَرَّضُ لِلنَّاسِ فَلَمْ يُضِفْنَا أَحَدٌ ، فَأَتَيْنَا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقُلْنَا : يَا رَسُولَ اللهِ ، أَصَابَنَا جُوعٌ شَدِيدٌ فَتَعَرَّضْنَا لِلنَّاسِ فَلَمْ يُضِفْنَا أَحَدٌ ، فَذَهَبَ بِنَا إِلَى مَنْزِلِهِ وَعِنْدَهُ أَرْبَعَةُ أَعْنُزٍ ، فَقَالَ : "" يَا  مِقْدَادُ  ، احْلِبْهُنَّ "" وَجَزَّأَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِكُلِّ إِنْسَانٍ مِنَّا جُزْءًا ، فَكُنْتُ أَفْعَلُ ذَلِكَ ، فَرَفَعْتُ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جُزْأَهُ فَأَبْطَأَ عَلَيْنَا فَاضْطَجَعْتُ عَلَى فِرَاشِي ، فَقَالَتْ لِي نَفْسِي : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَتَى أَهْلَ بَيْتٍ مِنَ  الْأَنْصَارِ  فَأَكَلَ عِنْدَهُمْ وَشَرِبَ ، وَلَوْ أَنَّكَ شَرِبْتَ هَذِهِ الشَّرْبَةَ ؟ فَلَمْ تَزَلْ نَفْسِي حَتَّى شَرِبْتُهَا ، فَلَمَّا تَقَارَّ فِي بَطْنِي أَخَذَنِي مَا  قَدُمَ  وَمَا  حَدُثَ  ، قَالَتْ لِي نَفْسِي : يَجِيءُ الْآنَ ظَمْآنَ ، فَلَا يَجِدُ شَيْئًا ، فَاضْطَجَعْتُ وَسَجَّيْتُ الثَّوْبَ عَلَيَّ ، فَجَاءَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَسَلَّمَ تَسْلِيمًا يُسْمِعُ الْيَقْظَانَ ، وَلَا يُوقِظُ النَّائِمَ ، ثُمَّ أَتَى الْإِنَاءَ فَكَشَفَ عَنْهُ فَلَمْ يَرَ شَيْئًا ، فَقَالَ :  اللَّهُمَّ أَطْعِمْ مَنْ أَطْعَمَنِي وَاسْقِ مَنْ سَقَانِي  فَاغْتَنَمْتُ دَعْوَتَهُ فَنَهَضْتُ فَأَخَذْتُ الشَّفْرَةَ فَدَنَوْتُ مِنَ الْغَنَمِ ، فَنَظَرْتُ أَيُّهُنَّ أَسْمَنُ لِأَذْبَحَهَا ، فَدَنَوْتُ مِنْ وَاحِدَةٍ فَجَسَسْتُهَا فَنَظَرْتُ فَإِذَا هِيَ  حَافِلٌ  ، وَنَظَرْتُ إِلَى الْأُخْرَى ، فَإِذَا هِيَ  حَافِلٌ  ، فَنَظَرْتُ إِلَى الْأُخْرَى إِذَا هِيَ  حَافِلٌ  ،         [20/243]      فَنَظَرْتُ كُلَّهُنَّ فَإِذَا هُنَّ حُفَّلٌ ، فَحَلَبْتُ فِيهِ فَقُلْتُ : اشْرَبْ ، فَقَالَ : "" الْخَبَرَ يَا  مِقْدَادُ  "" ، فَقُلْتُ : اشْرَبْ ثُمَّ الْخَبَرَ ، فَقَالَ : "" بَعْضُ سَوْآتِكَ يَا  مِقْدَادُ  "" فَشَرِبَ ثُمَّ قَالَ : "" اشْرَبْ "" ، فَقُلْتُ : اشْرَبْ يَا رَسُولَ اللهِ ، فَشَرِبَ حَتَّى  تَضَلَّعَ  ، ثُمَّ أَخَذْتُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَشَرِبْتُ ، ثُمَّ أَخْبَرْتُهُ الْخَبَرَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" هَذِهِ بَرَكَةٌ نَزَلَتْ مِنَ السَّمَاءِ ، أَفَلَا أَخْبَرْتَنِي حَتَّى أَسْقِيَ صَاحِبَيْكَ ؟ "" فَقُلْتُ : إِذَا أُصِبْتُ أَنَا وَأَنْتَ مَا  أُبَالِي  مَنْ أَخْطَأَتْ  .","","Al-Mu'jam al-Kabir 572","","المقداد بن عمرو بن ثعلبة البهراني عن عبد الرحمن بن أبي ليلى عن ثابت البناني عن حماد بن سلمة عن هدبة بن خالد عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","عبد الرحمن بن أبي ليلى عن المقداد"
"18750","573  -  حَدَّثَنَا  مُحَمَّدُ بْنُ حَيَّانَ الْمَازِنِيُّ ،  ثَنَا  أَبُو طَالِبٍ عَبْدُ السَّلَامِ بْنُ مُطَهَّرٍ ،  ثَنَا  سُلَيْمَانُ بْنُ الْمُغِيرَةِ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنِ  الْمِقْدَادِ ، قَالَ :  أَقْبَلْتُ أَنَا وَصَاحِبَانِ لِي وَقَدْ ذَهَبَتْ أَسْمَاعُنَا وَأَبْصَارُنَا مِنَ  الْجَهْدِ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، فَانْطَلَقَ إِلَى أَهْلِهِ فَإِذَا فِيهِ أَعْنُزٌ فَقَالَ : "" أَصْلِحْ  . فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 573","","المقداد بن عمرو بن ثعلبة البهراني عن عبد الرحمن بن أبي ليلى عن ثابت البناني عن سليمان بن المغيرة القيسي عن عبد السلام بن مطهر الأزدي عن محمد بن حيان المازني عن الطبراني","عبد الرحمن بن أبي ليلى عن المقداد"
"18751","مَيْمُونُ بْنُ أَبِي شَبِيبٍ  ، عَنِ  الْمِقْدَادِ  574  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  حَجَّاجُ بْنُ نُصَيْرٍ ،  ثَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ،  عَنْ  مَيْمُونِ بْنِ أَبِي شَبِيبٍ ، قَالَ :  جَاءَ  رَجُلٌ  يُثْنِي عَلَى عَامَلِ  عُثْمَانَ بْنِ عَفَّانَ  عِنْدَ الْمِقْدَادِ ، فَحَثَا  الْمِقْدَادُ  فِي وَجْهِهِ  التُّرَابَ  ، وَقَالَ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا رَأَيْتُمُ الْمَدَّاحِينَ  فَاحْثُوا  فِي وُجُوهِهِمُ  التُّرَابَ  .","","Al-Mu'jam al-Kabir 574","","المقداد بن عمرو بن ثعلبة البهراني عن ميمون بن أبي شبيب عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن حجاج بن نصير الفساطيطي عن أبو مسلم الكجي عن الطبراني","ميمون بن أبي شبيب عن المقداد"
"18752","هَمَّامُ بْنُ الْحَارِثِ  ، عَنِ  الْمِقْدَادِ  575  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَعَبْدُ اللهِ بْنُ أَحْمَدَ         [20/244]      بْنِ حَنْبَلٍ ، قَالَا :  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عُبَيْدُ اللهِ الْأَشْجَعِيُّ ،  عَنْ  سُفْيَانَ ،  عَنِ  الْأَعْمَشِ ، وَمَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هَمَّامِ بْنِ الْحَارِثِ ،  عَنِ  الْمِقْدَادِ بْنِ عَمْرٍو قَالَ :  أَمَرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا رَأَيْنَا الْمَدَّاحِينَ أَنْ نَحْثُوَ فِي وُجُوهِهِمُ  التُّرَابَ  .","","Al-Mu'jam al-Kabir 575","","المقداد بن عمرو بن ثعلبة البهراني عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن سفيان الثوري عن عبيد الله بن عبيد الرحمن الأشجعي عن عثمان ابن أبي شيبة عن عبد الله بن أحمد بن حنبل عن الطبراني","همام بن الحارث عن المقداد"
"18753","576  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هَمَّامِ بْنِ الْحَارِثِ ،  عَنِ  الْمِقْدَادِ بْنِ الْأَسْوَدِ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  احْثُوا  فِي وُجُوهِ الْمَدَّاحِينَ  التُّرَابَ  .","","Al-Mu'jam al-Kabir 576","","المقداد بن عمرو بن ثعلبة البهراني عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","همام بن الحارث عن المقداد"
"18754","577  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ، (  ح  )  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هَمَّامِ بْنِ الْحَارِثِ ،  عَنِ  الْمِقْدَادِ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  احْثُوا  فِي وُجُوهِ الْمَدَّاحِينَ  التُّرَابَ  .","","Al-Mu'jam al-Kabir 577","","المقداد بن عمرو بن ثعلبة البهراني عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","همام بن الحارث عن المقداد"
"18755","578  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  أَحْمَدُ بْنُ عُثْمَانَ بْنِ جَابِرٍ الْأَوْدِيُّ ،  ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  مُغِيرَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هَمَّامِ بْنِ الْحَارِثِ ،  عَنِ  الْمِقْدَادِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا رَأَيْتُمُ الْمَدَّاحِينَ  فَاحْثُوا  فِي وُجُوهِهِمُ  التُّرَابَ  .","","Al-Mu'jam al-Kabir 578","","المقداد بن عمرو بن ثعلبة البهراني عن همام بن الحارث بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن المغيرة بن مقسم الضبي عن قيس بن الربيع الأسدي عن مالك بن إسماعيل النهدي عن أحمد بن عثمان بن جابر الأودي عن أحمد بن يحيى بن زهير التستري عن الطبراني","همام بن الحارث عن المقداد"
"18756","أَبُو مَعْمَرٍ عَبْدُ اللهِ بْنُ سَخْبَرَةَ  ، عَنِ  الْمِقْدَادِ  579  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا         [20/245]      عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أَبِي مَعْمَرٍ ،  عَنِ  الْمِقْدَادِ بْنِ عَمْرٍو ، قَالَ :  أَمَرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ نَحْثُوَ فِي وُجُوهِ الْمَدَّاحِينَ  التُّرَابَ  .","","Al-Mu'jam al-Kabir 579","","المقداد بن عمرو بن ثعلبة البهراني عن عبد الله بن سخبرة عن مجاهد بن جبر المخزومي عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن عبد الرحمن بن مهدي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو معمر عبد الله بن سخبرة عن المقداد"
"18757","580  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، وَأَبُو عَبْدِ الرَّحْمَنِ عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَا :  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  الْوَلِيدُ بْنُ عُقْبَةَ ،  ثَنَا  حَمْزَةُ الزَّيَّاتُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  الْحَجَّاجِ  ،  عَنْ  أَبِي مَعْمَرٍ الْأَزْدِيِّ قَالَ :  قَامَ  رَجُلٌ  يَمْدَحُ أَمِيرًا مِنَ الْأُمَرَاءِ ، فَقَامَ الْمِقْدَادُ بْنُ الْأَسْوَدِ فَحَثَا فِي وَجْهِهِ  التُّرَابَ  ، وَقَالَ :  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" أَمَرَنَا أَنْ نَحْثُوَ فِي وُجُوهِ الْمَدَّاحِينَ  التُّرَابَ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( أبي الحجاج )","","Al-Mu'jam al-Kabir 580","","المقداد بن عمرو بن ثعلبة البهراني عن عبد الله بن سخبرة عن مجاهد بن جبر المخزومي عن حبيب بن أبي ثابت الكاهلي عن حمزة الزيات عن الوليد بن عقبة بن المغيرة عن عثمان ابن أبي شيبة عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو معمر عبد الله بن سخبرة عن المقداد"
"18758","يَزِيدُ بْنُ شَرِيكٍ التَّيْمِيُّ  ، عَنِ  الْمِقْدَادِ  581  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ،  ثَنَا  هِشَامُ بْنُ يُونُسَ اللُّؤْلُؤِيُّ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنْ  أَبِيهِ  قَالَ :  دَخَلَ  رَجُلٌ  عَلَى  عُثْمَانَ  وَعِنْدَهُ الْمِقْدَادُ بْنُ الْأَسْوَدِ الْكِنْدِيُّ ، فَأَثْنَى الرَّجُلُ عَلَى  عُثْمَانَ  فِي وَجْهِهِ ، فَمَا زَالَ  الْمِقْدَادُ  يَحْثُو عَلَى الرَّجُلِ  التُّرَابَ  حَتَّى اسْتَتَرَ  عُثْمَانُ  بِمِطْرَفٍ مِنْ خَزٍّ ، ثُمَّ قَالَ  الْمِقْدَادُ  : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِذَا سَمِعْتُمُ الْمَدَّاحِينَ  فَاحْثُوا  فِي وُجُوهِهِمُ  التُّرَابَ  .","","Al-Mu'jam al-Kabir 581","","المقداد بن عمرو بن ثعلبة البهراني عن يزيد بن شريك بن طارق التيمي عن إبراهيم بن يزيد بن شريك التيمي عن الأعمش عن حفص بن غياث النخعي عن هشام بن يونس بن وابل النهشلي عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","يزيد بن شريك التيمي عن المقداد"
"18759","عَبْدُ اللهِ الْبَهِيُّ مَوْلَى مُصْعَبِ بْنِ الزُّبَيْرِ  ، عَنِ  الْمِقْدَادِ  582  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ، (  ح  )         [20/246]      وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبِي  قَالَا :  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  وَائِلِ بْنِ دَاوُدَ ، (  ح  )  وَحَدَّثَنَا  الْمِقْدَادُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  ثَنَا  وَائِلُ بْنُ دَاوُدَ ،  ثَنَا  عَبْدُ اللهِ الْبَهِيُّ ، مَوْلَى مُصْعَبِ بْنِ الزُّبَيْرِ قَالَ :  وَقَفَ رَكْبٌ عَلَى  عُثْمَانَ  فَأَثْنَوْا عَلَيْهِ وَمَدَحُوهُ - وَثَمَّ الْمِقْدَادُ بْنُ الْأَسْوَدِ - فَأَخَذَ  قَبْضَةً  مِنَ الْأَرْضِ فَحَثَا فِي وُجُوهِهِمُ  التُّرَابَ  ، وَقَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِذَا رَأَيْتُمُ الْمَدَّاحِينَ  فَاحْثُوا  فِي وُجُوهِهِمُ  التُّرَابَ  .","","Al-Mu'jam al-Kabir 582","","المقداد بن عمرو بن ثعلبة البهراني عن عبد الله البهي مولى مصعب بن الزبير عن وائل بن داود التيمي عن يحيى القطان عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عبد الله البهي مولى مصعب بن الزبير عن المقداد"
"18760","عُبَيْدُ اللهِ بْنُ عَدِيِّ بْنِ الْخِيَارِ  ، عَنِ  الْمِقْدَادِ  583  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَطَاءِ بْنِ يَزِيدَ اللَّيْثِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَدِيِّ بْنِ الْخِيَارِ ،  عَنِ  الْمِقْدَادِ بْنِ الْأَسْوَدِ قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، أَرَأَيْتَ إِنِ اخْتَلَفْتُ أَنَا وَرَجُلٌ مِنَ الْمُشْرِكِينَ ضَرْبَتَيْنِ فَقَطَعَ يَدَيَّ ، فَلَمَّا أَهْوَيْتُ إِلَيْهِ لِأَضْرِبَهُ قَالَ : لَا إِلَهَ إِلَّا اللهُ ، أَقْتُلُهُ أَمْ أَدَعُهُ ؟ قَالَ : "" بَلْ دَعْهُ "" ، قُلْتُ : وَإِنْ قَطَعَ يَدَيَّ ؟ قَالَ : "" وَإِنْ فَعَلَ "" ، فَرَاجَعْتُهُ مَرَّتَيْنِ أَوْ ثَلَاثًا ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ قَتَلْتَهُ بَعْدَ أَنْ قَالَ : لَا إِلَهَ إِلَّا اللهُ فَأَنْتَ مِثْلُهُ قَبْلَ أَنْ يَقُولَهَا  ، وَهُوَ مِثْلُكَ إِنْ قَتَلْتَهُ  .","","Al-Mu'jam al-Kabir 583","","المقداد بن عمرو بن ثعلبة البهراني عن عبيد الله بن عدي بن الخيار النوفلي عن عطاء بن يزيد الجندعي عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عبيد الله بن عدي بن الخيار عن المقداد"
"18761","584  -  حَدَّثَنَا  أَبُو أُسَامَةَ الْحَلَبِيُّ ،  ثَنَا  حَجَّاجُ بْنُ أَبِي مَنِيعٍ الرُّصَافِيُّ ،  ثَنَا  جَدِّي  ،  عَنِ  الزُّهْرِيِّ ،  ثَنَا  عَطَاءُ بْنُ يَزِيدَ الْجُنْدَعِيُّ ، أَنَّ عُبَيْدَ اللهِ بْنَ عَدِيِّ بْنِ         [20/247]      الْخِيَارِ  أَخْبَرَهُ  ،  عَنِ  الْمِقْدَادِ بْنِ عَمْرٍو فَارِسِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ رَجُلٌ مِنْ  كِنْدَةَ  ، وَهُوَ حَلِيفٌ  لِبَنِي زُهْرَةَ  - قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، أَرَأَيْتَ إِنْ لَقِيتُ رَجُلًا مِنَ الْمُشْرِكِينَ فَاخْتَلَفْتُ أَنَا وَهُوَ ضَرْبَتَيْنِ ، فَأَبَانَ إِحْدَى يَدَيَّ فَضَرَبْتُهُ ، ثُمَّ قَدَرْتُ عَلَى قَتْلِهِ ، فَقَالَ حِينَ أَرَدْتُ أَنْ أَهْوِيَ إِلَيْهِ بِسِلَاحِي : لَا إِلَهَ إِلَّا اللهُ ، أَقْتُلُهُ أَمْ أَتْرُكُهُ ؟ قَالَ : "" بَلِ اتْرُكْهُ "" ، قُلْتُ : يَا رَسُولَ اللهِ ، وَإِنْ قَطَعَ إِحْدَى يَدَيَّ ؟ قَالَ : "" وَإِنْ فَعَلَ "" ، فَرَاجَعْتُهُ فَقَالَ :  إِنْ قَتَلْتَهُ بَعْدَ أَنْ يَقُولَ : لَا إِلَهَ إِلَّا اللهُ فَأَنْتَ بِمَنْزِلَتِهِ قَبْلَ أَنْ يَقُولَهَا  ، وَهُوَ بِمَنْزِلَتِكَ قَبْلَ أَنْ تَقْتُلَهُ  .","","Al-Mu'jam al-Kabir 584","","المقداد بن عمرو بن ثعلبة البهراني عن عبيد الله بن عدي بن الخيار النوفلي عن عطاء بن يزيد الجندعي عن الزهري عن عبيد الله بن أبي زياد الرصافي عن حجاج بن يوسف الرصافي عن عبد الله بن محمد بن أبي أسامة الحلبي عن الطبراني","عبيد الله بن عدي بن الخيار عن المقداد"
"18762","585  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  شُعَيْبُ بْنُ يَحْيَى ،  أَنَا  اللَّيْثُ ، (  ح  )  وَحَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  ابْنُ شِهَابٍ ،  عَنْ  عَطَاءِ بْنِ يَزِيدَ اللَّيْثِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَدِيِّ بْنِ الْخِيَارِ ،  عَنِ  الْمِقْدَادِ أَنَّهُ أَخْبَرَهُ ، أَنَّهُ قَالَ :  يَا رَسُولَ اللهِ ، أَرَأَيْتَ إِنْ لَقِيتُ رَجُلًا مِنَ الْكُفَّارِ فَقَاتَلَنِي فَضَرَبَ إِحْدَى يَدَيَّ بِالسَّيْفِ فَقَطَعَنِي ، ثُمَّ لَاذَ مِنِّي بِشَجَرَةٍ ، قَالَ : أَسْلَمْتُ لِلهِ ، أَفَأَقْتُلُهُ يَا رَسُولَ اللهِ بَعْدَ أَنْ قَالَهَا ؟ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَا تَقْتُلْهُ "" ، فَقُلْتُ : يَا رَسُولَ اللهِ ، إِنَّهُ قَطَعَ يَدِي ، ثُمَّ قَالَ ذَلِكَ بَعْدَ أَنْ قَطَعَهَا أَقْتُلُهُ ؟ قَالَ :  لَا تَقْتُلْهُ ؛ فَإِنَّهُ بِمَنْزِلَتِكَ قَبْلَ أَنْ تَقْتُلَهُ  ، وَأَنْتَ بِمَنْزِلَتِهِ قَبْلَ أَنْ يَقُولَ الْكَلِمَةَ الَّتِي قَالَهَا  .","","Al-Mu'jam al-Kabir 585","","المقداد بن عمرو بن ثعلبة البهراني عن عبيد الله بن عدي بن الخيار النوفلي عن عطاء بن يزيد الجندعي عن الزهري عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","عبيد الله بن عدي بن الخيار عن المقداد"
"18763","586  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ الْمِصْرِيُّ ،  ثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ،  ثَنَا  خَالِدُ بْنُ حَيَّانَ ،  عَنْ  سُلَيْمَانَ بْنِ أَبِي دَاوُدَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَطَاءِ بْنِ يَزِيدَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَدِيِّ بْنِ الْخِيَارِ ، قَالَ :  قَالَ  الْمِقْدَادُ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : يَا نَبِيَّ اللهِ ، أَرَأَيْتَ إِنْ لَقِيتُ رَجُلًا مِنَ الْكُفَّارِ فَقَاتَلَنِي فَضَرَبَ إِحْدَى         [20/248]      يَدَيَّ بِالسَّيْفِ فَقَطَعَهَا ، ثُمَّ لَاذَ مِنِّي بِشَجَرَةٍ ، وَقَالَ : أَسْلَمْتُ لِلهِ ، أَفَأَقْتُلُهُ بَعْدَ أَنْ قَالَهَا يَا نَبِيَّ اللهِ ؟ قَالَ : "" لَا تَقْتُلْهُ "" ، قَالَ : إِنَّهُ قَطَعَ يَدِي ، ثُمَّ قَالَ ذَلِكَ بَعْدَ مَا قَطَعَهَا ؟ قَالَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَقْتُلْهُ ، فَإِنَّكَ إِنْ قَتَلْتَهُ كَانَ بِمَنْزِلَتِكَ قَبْلَ أَنْ تَقْتُلَهُ  ، وَكُنْتَ أَنْتَ بِمَنْزِلَتِهِ قَبْلَ أَنْ يَقُولَ كَلِمَتَهُ الَّتِي قَالَ  .","","Al-Mu'jam al-Kabir 586","","المقداد بن عمرو بن ثعلبة البهراني عن عبيد الله بن عدي بن الخيار النوفلي عن عطاء بن يزيد الجندعي عن الزهري عن سليمان بن أبي داود الحراني بومة عن خالد بن حيان الرقي عن علي بن معبد العبدي عن يحيى بن عثمان بن صالح عن الطبراني","عبيد الله بن عدي بن الخيار عن المقداد"
"18764","587  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ الْمِصْرِيُّ ،  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  أُسَامَةُ بْنُ زَيْدٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عَطَاءِ بْنِ يَزِيدَ اللَّيْثِيِّ ثُمَّ الْجُنْدَعِيِّ ، أَنَّ عُبَيْدَ اللهِ بْنَ عَدِيِّ بْنِ الْخِيَارِ  أَخْبَرَهُ  ، أَنَّ الْمِقْدَادَ بْنَ عَمْرٍو الْكِنْدِيَّ - كَانَ حَلِيفًا  لِبَنِي زُهْرَةَ  ، وَكَانَ مِمَّنْ شَهِدَ  بَدْرًا  مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  حَدَّثَهُ  أَنَّهُ قَالَ :  يَا رَسُولَ اللهِ ، إِنْ لَقِيتُ رَجُلًا مِنَ الْكُفَّارِ فَاقْتَتَلْنَا فَضَرَبَ إِحْدَى يَدَيَّ بِالسَّيْفِ فَقَطَعَهَا ثُمَّ لَاذَ مِنِّي بِشَجَرَةٍ ، فَقَالَ : أَسْلَمْتُ لِلهِ ، أَأَقْتُلُهُ يَا رَسُولَ اللهِ بَعْدَ أَنْ قَالَهَا ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَا تَقْتُلْهُ "" ، فَقَالَ : يَا رَسُولَ اللهِ إِنَّهُ قَطَعَ إِحْدَى يَدَيَّ ، ثُمَّ قَالَ بَعْدَ مَا قَطَعَهَا أَفَأَقْتُلُهُ ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَقْتُلْهُ ، فَإِنَّكَ إِنْ قَتَلْتَهُ ، فَإِنَّهُ بِمَنْزِلَتِكَ قَبْلَ أَنْ تَقْتُلَهُ  ، وَأَنْتَ بِمَنْزِلَتِهِ قَبْلَ أَنْ يَقُولَ كَلِمَتَهُ الَّتِي قَالَ  .","","Al-Mu'jam al-Kabir 587","","المقداد بن عمرو بن ثعلبة البهراني عن عبيد الله بن عدي بن الخيار النوفلي عن عطاء بن يزيد الجندعي عن الزهري عن أسامة بن زيد الليثي المدني عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل بن الحسن الخفاف المصري عن الطبراني","عبيد الله بن عدي بن الخيار عن المقداد"
"18765","588  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ،  ثَنَا  عَمْرُو بْنُ أَبِي عَاصِمٍ ،  حَدَّثَنِي  أَبِي  ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  ابْنُ شِهَابٍ ،  عَنْ  عَطَاءِ بْنِ يَزِيدَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَدِيِّ بْنِ الْخِيَارِ أَخْبَرَهُ ، أَنَّ الْمِقْدَادَ بْنَ الْأَسْوَدِ  أَخْبَرَهُ  ،  أَنَّهُ سَأَلَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : أَرَأَيْتَ رَجُلًا مِنَ الْكُفَّارِ فَقَاتَلَنِي فَاخْتَلَفْنَا ضَرْبَتَيْنِ فَضَرَبَ إِحْدَى يَدَيَّ بِالسَّيْفِ فَقَطَعَهَا ، ثُمَّ لَاذَ مِنِّي بِشَجَرَةٍ فَقَالَ : أَسْلَمْتُ ،         [20/249]      أَفَأَقْتُلُهُ يَا رَسُولَ اللهِ بَعْدَ أَنْ قَالَهَا ؟ قَالَ :  لَا تَقْتُلْهُ ، فَإِنَّكَ إِنْ قَتَلْتَهُ كَانَ بِمَنْزِلَتِكَ قَبْلَ أَنْ تَقْتُلَهُ  ، وَكُنْتَ بِمَنْزِلَتِهِ قَبْلَ أَنْ يَقُولَ كَلِمَتَهُ الَّتِي قَالَ  .","","Al-Mu'jam al-Kabir 588","","المقداد بن عمرو بن ثعلبة البهراني عن عبيد الله بن عدي بن الخيار النوفلي عن عطاء بن يزيد الجندعي عن الزهري عن ابن جريج عن أبو عاصم النبيل عن عمرو بن الضحاك بن مخلد عن الحسن بن علي بن شبيب المعمري عن الطبراني","عبيد الله بن عدي بن الخيار عن المقداد"
"18766","589  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَنْبَرٍ الْمِصْرِيُّ  ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  أَبُو بَكْرٍ الْحَنَفِيُّ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ ،  ثَنَا  الزُّهْرِيُّ ،  عَنْ  عَطَاءِ بْنِ يَزِيدَ اللَّيْثِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَدِيِّ بْنِ الْخِيَارِ ،  عَنِ  الْمِقْدَادِ بْنِ عَمْرٍو الْكِنْدِيِّ - وَكَانَ مِمَّنْ شَهِدَ  بَدْرًا  - أَنَّهُ أَخْبَرَهُ ، أَنَّهُ قَالَ :  يَا رَسُولَ اللهِ ، أَرَأَيْتَ إِنْ لَقِيتُ رَجُلًا مِنَ الْكُفَّارِ فَقَاتَلْتُهُ فَقَطَعَ يَدِي ، ثُمَّ لَاذَ مِنِّي بِشَجَرَةٍ ، فَقَالَ : أَسْلَمْتُ لِلهِ ، أَقْتُلُهُ يَا رَسُولَ اللهِ بَعْدَ أَنْ قَالَهَا ؟ قَالَ :  لَا تَقْتُلْهُ ، فَإِنَّكَ إِنْ قَتَلْتَهُ ، فَإِنَّكَ بِمَنْزِلَتِهِ قَبْلَ أَنْ يَقُولَ كَلِمَتَهُ الَّتِي قَالَهَا  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : (البصري).","","Al-Mu'jam al-Kabir 589","","المقداد بن عمرو بن ثعلبة البهراني عن عبيد الله بن عدي بن الخيار النوفلي عن عطاء بن يزيد الجندعي عن الزهري عن عبد الحميد بن جعفر الأوسي عن عبد الكبير بن عبد المجيد الحنفي عن محمد بن أبي بكر المقدمي عن أحمد بن ابراهيم بن عنبر البصري عن الطبراني","عبيد الله بن عدي بن الخيار عن المقداد"
"18767","590  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ الْعَطَّارُ الْمَكِّيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  عَمْرُو بْنُ عُثْمَانَ بْنِ مُوسَى التَّيْمِيُّ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ شِهَابٍ ،  أَخْبَرَنِي  عَطَاءُ بْنُ يَزِيدَ الْجُنْدَعِيُّ ، أَنَّ عُبَيْدَ اللهِ بْنَ عَدِيِّ بْنِ الْخِيَارِ  أَخْبَرَهُ  ،  عَنِ  الْمِقْدَادِ بْنِ عَمْرٍو فَارِسِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ رَجُلٌ مِنْ  كِنْدَةَ  ، وَهُوَ حَلِيفٌ  لِبَنِي زُهْرَةَ  - أَنَّهُ قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، أَرَأَيْتَ إِنْ لَقِيتُ رَجُلًا مِنَ الْكُفَّارِ فَاخْتَلَفْتُ أَنَا وَهُوَ ضَرْبَتَيْنِ فَضَرَبَنِي فَأَبَانَ إِحْدَى يَدَيَّ ، فَضَرَبْتُهُ ، ثُمَّ قَدَرْتُ عَلَى قَتْلِهِ فَقَالَ حِينَ أَرَدْتُ أَنْ أَهْوِيَ إِلَيْهِ بِسِلَاحِي : لَا إِلَهَ إِلَّا اللهُ ، أَقْتُلُهُ أَمْ أَتْرُكُهُ ؟ قَالَ : "" لَا ، بَلِ اتْرُكْهُ "" ، فَقُلْتُ : يَا رَسُولَ اللهِ ، وَإِنْ قَطَعَ إِحْدَى يَدَيَّ ؟ قَالَ : "" وَإِنْ فَعَلَ "" ، قُلْتُ : يَا رَسُولَ اللهِ وَإِنْ قَطَعَ إِحْدَى يَدَيَّ ؟ قَالَ : "" وَإِنْ فَعَلَ "" ، فَرَاجَعْتُهُ فَقَالَ :  إِنْ قَتَلْتَهُ بَعْدَ أَنْ يَقُولَ : لَا إِلَهَ إِلَّا اللهُ فَأَنْتَ بِمَنْزِلَتِهِ قَبْلَ أَنْ يَقُولَهَا  ، وَهُوَ بِمَنْزِلَتِكَ قَبْلَ أَنْ تَقْتُلَهُ  .","","Al-Mu'jam al-Kabir 590","","المقداد بن عمرو بن ثعلبة البهراني عن عبيد الله بن عدي بن الخيار النوفلي عن عطاء بن يزيد الجندعي عن الزهري عن عثمان بن عمر بن موسى التيمي عن عمر بن عثمان بن عمر عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","عبيد الله بن عدي بن الخيار عن المقداد"
"18768","591  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ الْمِصْرِيُّ ،  ثَنَا  أَحْمَدُ         [20/250]      بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  يُونُسُ ،  عَنِ  ابْنِ شِهَابٍ ،  حَدَّثَنِي  عَطَاءُ بْنُ يَزِيدَ اللَّيْثِيُّ ، ثُمُّ الْجُنْدَعِيُّ ، أَنَّ عُبَيْدَ اللهِ بْنَ عَدِيِّ بْنِ الْخِيَارِ  أَخْبَرَهُ  ، أَنَّ الْمِقْدَادَ بْنَ عَمْرٍو الْكِنْدِيَّ - وَكَانَ حَلِيفًا  لِبَنِي زُهْرَةَ  ، وَكَانَ مِمَّنْ شَهِدَ  بَدْرًا  مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَخْبَرَهُ  قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ،  أَرَأَيْتَ إِنْ لَقِيتُ رَجُلًا مِنَ الْكُفَّارِ ، فَاقْتَتَلْنَا فَضَرَبَ إِحْدَى يَدَيَّ بِالسَّيْفِ فَقَطَعَهَا  ، فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 591","","المقداد بن عمرو بن ثعلبة البهراني عن عبيد الله بن عدي بن الخيار النوفلي عن عطاء بن يزيد الجندعي عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل بن الحسن الخفاف المصري عن الطبراني","عبيد الله بن عدي بن الخيار عن المقداد"
"18769","592  -  حَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ الْمِصْرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُزَيْزٍ الْأَيْلِيُّ ،  ثَنَا  سَلَامَةُ بْنُ رَوْحٍ ،  عَنْ  عُقَيْلٍ ،  أَخْبَرَنِي  ابْنُ شِهَابٍ ، أَنَّ عَطَاءَ بْنَ يَزِيدَ اللَّيْثِيَّ ثُمَّ الْجُنْدَعِيَّ  أَخْبَرَهُ  ، أَنَّ عُبَيْدَ اللهِ بْنَ عَدِيِّ بْنِ الْخِيَارِ  أَخْبَرَهُ  ،  أَنَّ  الْمِقْدَادَ بْنَ عَمْرٍو الْكِنْدِيَّ حَلِيفَ  بَنِي زُهْرَةَ  قَالَ :  يَا رَسُولَ اللهِ ، أَرَأَيْتَ إِنْ لَقِيتُ رَجُلًا مِنَ الْكُفَّارِ فَقَاتَلَنِي فَضَرَبَ إِحْدَى يَدَيَّ فَقَطَعَهَا ، ثُمَّ لَاذَ مِنِّي بِشَجَرَةٍ ، قَالَ : أَسْلَمْتُ لِلهِ ، أَقْتُلُهُ يَا رَسُولَ اللهِ ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَا تَقْتُلْهُ "" ، قَالَ : يَا رَسُولَ اللهِ ، إِنَّهُ قَطَعَ إِحْدَى يَدَيَّ ، ثُمَّ قَالَ ذَلِكَ بَعْدَ مَا قَطَعَهَا ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  فَإِنْ قَتَلْتَهُ فَإِنَّكَ بِمَنْزِلَتِهِ قَبْلَ أَنْ يَقُولَ كَلِمَتَهُ الَّتِي قَالَ  ، وَهُوَ بِمَنْزِلَتِكَ قَبْلَ أَنْ تَقْتُلَهُ  .","","Al-Mu'jam al-Kabir 592","","المقداد بن عمرو بن ثعلبة البهراني عن عبيد الله بن عدي بن الخيار النوفلي عن عطاء بن يزيد الجندعي عن الزهري عن عقيل بن خالد الأيلي عن سلامة بن روح الأيلي عن محمد بن عزيز بن عبد الله الأيلي عن عمرو بن أبي الطاهر المصري عن الطبراني","عبيد الله بن عدي بن الخيار عن المقداد"
"18770","593  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  حَدَّثَنِي  ابْنُ شِهَابٍ ، أَنَّ عَطَاءَ بْنَ يَزِيدَ  أَخْبَرَهُ  ، أَنَّ عُبَيْدَ اللهِ بْنَ عَدِيٍّ  أَخْبَرَهُ  ، أَنَّ الْمِقْدَادَ بْنَ عَمْرٍو  أَخْبَرَهُ  ،  أَنَّهُ قَالَ : يَا رَسُولَ اللهِ ، أَرَأَيْتَ إِنْ لَقِيتُ رَجُلًا مِنَ الْمُشْرِكِينَ فَقَاتَلَنِي فَضَرَبَ إِحْدَى يَدَيَّ فَقَطَعَهَا ، ثُمَّ لَاذَ مِنِّي بِشَجَرَةٍ ، وَقَالَ : أَسْلَمْتُ لِلهِ ، أَقْتُلُهُ بَعْدَ أَنْ قَالَهَا ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَا تَقْتُلْهُ بَعْدَ أَنْ قَالَهَا "" ، قَالَ : يَا رَسُولَ اللهِ ، إِنَّهُ قَطَعَ إِحْدَى يَدَيَّ ثُمَّ قَالَ ذَلِكَ بَعْدَ أَنْ قَطَعَهَا ، فَقَالَ رَسُولُ اللهِ صَلَّى         [20/251]      اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ قَتَلْتَهُ فَإِنَّهُ بِمَنْزِلَتِكَ قَبْلَ أَنْ تَقْتُلَهُ  ، وَإِنَّكَ بِمَنْزِلَتِهِ قَبْلَ أَنْ يَقُولَ كَلِمَتَهُ الَّتِي قَالَ  .","","Al-Mu'jam al-Kabir 593","","المقداد بن عمرو بن ثعلبة البهراني عن عبيد الله بن عدي بن الخيار النوفلي عن عطاء بن يزيد الجندعي عن الزهري عن صالح بن كيسان الدوسي عن إبراهيم بن سعد أبو إسحاق الزهري عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","عبيد الله بن عدي بن الخيار عن المقداد"
"18771","594  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ سَعْدٍ ،  ثَنَا  عَمِّي ،  ثَنَا  ابْنُ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ ،  أَخْبَرَنِي  عَطَاءُ بْنُ يَزِيدَ اللَّيْثِيُّ ثُمَّ الْجُنْدَعِيُّ ، أَنَّ عُبَيْدَ اللهِ بْنَ عَدِيِّ بْنِ الْخِيَارِ  أَخْبَرَهُ  ، أَنَّ الْمِقْدَادَ بْنَ عَمْرٍو - كَانَ حَلِيفًا  لِبَنِي زُهْرَةَ  ، وَكَانَ مِمَّنْ شَهِدَ  بَدْرًا  مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَخْبَرَهُ  ، أَنَّهُ قَالَ :  يَا رَسُولَ اللهِ ، أَرَأَيْتَ إِنْ لَقِيتُ رَجُلًا مِنَ الْكُفَّارِ ، فَاقْتَتَلْنَا فَضَرَبَ إِحْدَى يَدَيَّ بِالسَّيْفِ فَقَطَعَهَا ، ثُمَّ لَاذَ مِنِّي بِشَجَرَةٍ ، فَقَالَ : أَسْلَمْتُ لِلهِ ، أَقْتُلُهُ يَا رَسُولَ اللهِ بَعْدَ أَنْ قَالَهَا ؟ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَقْتُلْهُ فَإِنْ قَتَلْتَهُ ، فَإِنَّهُ بِمَنْزِلَتِكَ قَبْلَ أَنْ تَقْتُلَهُ  ، وَإِنَّكَ بِمَنْزِلَتِهِ قَبْلَ أَنْ يَقُولَ كَلِمَتَهُ الَّتِي قَالَ .","","Al-Mu'jam al-Kabir 594","","المقداد بن عمرو بن ثعلبة البهراني عن عبيد الله بن عدي بن الخيار النوفلي عن عطاء بن يزيد الجندعي عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن عبيد الله بن سعد بن إبراهيم الزهري عن أحمد بن يحيى بن زهير التستري عن الطبراني","عبيد الله بن عدي بن الخيار عن المقداد"
"18772","595  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ مُوسَى الْأَنْصَارِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  الْأَوْزَاعِيُّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَدِيِّ بْنِ الْخِيَارِ ،  عَنِ  الْمِقْدَادِ بْنِ الْأَسْوَدِ ، قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ،  لَقِيتُ رَجُلًا مِنَ الْمُشْرِكِينَ فَقَطَعَ يَدِي ، فَلَاذَ مِنِّي بِشَجَرَةٍ ، قَالَ : أَسْلَمْتُ لِلهِ  ، فَذَكَرَ مِثْلَ الْحَدِيثِ قَبْلَهُ  .","","Al-Mu'jam al-Kabir 595","","المقداد بن عمرو بن ثعلبة البهراني عن عبيد الله بن عدي بن الخيار النوفلي عن حميد بن عبد الرحمن القرشي عن الزهري عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن إسحاق بن موسى الخطمي عن الحسن بن علي بن شبيب المعمري عن الطبراني","عبيد الله بن عدي بن الخيار عن المقداد"
"18773","سُلَيْمَانُ بْنُ يَسَارٍ  ، عَنِ  الْمِقْدَادِ  596  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ ، (  ح  )         [20/252]      وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ، كُلُّهُمْ  عَنْ  مَالِكِ بْنِ أَنَسٍ ،  عَنْ  أَبِي النَّضْرِ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنِ  الْمِقْدَادِ ،  أَنَّ  عَلِيًّا  أَمَرَهُ أَنْ يَسْأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الرَّجُلِ إِذَا دَنَا مِنِ امْرَأَتِهِ ، فَخَرَجَ مِنْهُ الْمَذْيُ ، مَاذَا عَلَيْهِ ؟ فَإِنَّ عِنْدِيَ ابْنَتَهُ ، وَأَنَا أَسْتَحْيِي أَنْ أَسْأَلَهُ ، قَالَ  الْمِقْدَادُ  : فَسَأَلْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ ذَلِكَ فَقَالَ :  إِذَا وَجَدَ أَحَدُكُمْ  فَلْيَنْضَحْ  فَرْجَهُ ، وَلْيَتَوَضَّأْ وُضُوءَهُ لِلصَّلَاةِ  .","","Al-Mu'jam al-Kabir 596","","المقداد بن عمرو بن ثعلبة البهراني عن سليمان بن يسار مولى ميمونة زوج رسول الله عن سالم بن أبي أمية التيمي عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سليمان بن يسار عن المقداد"
"18774","أَبُو الْمُعَارِكِ الْمِصْرِيُّ  ، عَنِ  الْمِقْدَادِ  597  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  هَارُونُ بْنُ مَعْرُوفٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  عَيَّاشِ بْنِ عَبَّاسٍ ،  عَنْ  أَبِي الْمُعَارِكِ ،  أَنَّ  رَجُلًا مِنْ غَافِقٍ  كَانَ لَهُ عَلَى  رَجُلٍ مِنْ مَهْرَةَ  مِائَةُ دِينَارٍ فِي زَمَنِ  عُثْمَانَ  ، فَغَنِمُوا غَنِيمَةً حَسَنَةً ، قَالَ الْمَهْرِيُّ : أُعَجِّلُ لَكَ سَبْعِينَ دِينَارًا عَلَى أَنْ تَمْحُوَ عَنِّي الْمِائَةَ ، وَكَانَتِ الْمِائَةُ مُشَاجَرَةً ، فَرَضِيَ بِذَلِكَ الْغَافِقِيُّ ، فَمَرَّ بِهِمَا الْمِقْدَادُ فَأَخَذَ بِلِجَامِ دَابَّتِهِ لِيُشْهِدَهُ ، فَلَمَّا قَصَّ عَلَيْهِ الْحَدِيثَ قَالَ : "" كِلَاكُمَا قَدْ أُذِنَ بِحَرْبٍ مِنَ اللهِ وَرَسُولِهِ ""  .","","Al-Mu'jam al-Kabir 597","","المقداد بن عمرو بن ثعلبة البهراني عن على بن المعارك الوادي عن عياش بن عباس القتباني عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن هارون بن معروف المروزي عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو المعارك المصري عن المقداد"
"18775","جُبَيْرُ بْنُ نُفَيْرٍ  ، عَنِ  الْمِقْدَادِ بْنِ الْأَسْوَدِ  598  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي         [20/253]      مُعَاوِيَةُ بْنُ صَالِحٍ ، أَنَّ  عَبْدَ الرَّحْمَنِ بْنَ جُبَيْرِ بْنِ نُفَيْرٍ  حَدَّثَهُ  ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمِقْدَادِ بْنِ الْأَسْوَدِ قَالَ :  جَاءَنَا  الْمِقْدَادُ بْنُ الْأَسْوَدِ  لِحَاجَةٍ لَهُ ، فَقُلْنَا : اجْلِسْ عَافَاكَ اللهُ حَتَّى تَطْلُبَ حَاجَتَكَ ، قَالَ : الْعَجَبُ مِنْ قَوْمٍ مَرَرْتُ بِهِمْ آنِفًا يَتَمَنَّوْنَ الْفِتْنَةَ ، يَزْعُمُونَ لِيَبْتَلِيَهُمُ اللهُ فِيهَا بِمَا ابْتَلَى رَسُولَهُ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابَهُ ، وَايْمُ اللهِ لَقَدْ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ السَّعِيدَ لَمَنْ جُنِّبَ الْفِتَنَ  - يُرَدِّدُهَا ثَلَاثَ مَرَّاتٍ - وَإِنِ ابْتُلِيَ فَصَبَرَ "" وَايْمُ اللهِ ، لَا أَشْهَدُ لِأَحَدٍ مِنْ أَهْلِ الْجَنَّةِ حَتَّى أَعْلَمَ مَا يَمُوتُ عَلَيْهِ بَعْدَ حَدِيثٍ سَمِعْتُهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَقَلْبُ ابْنِ آدَمَ أَسْرَعُ انْقِلَابًا مِنَ الْقِدْرِ إِذَا اسْتَجْمَعَتْ غَلْيًا  .","","Al-Mu'jam al-Kabir 598","","المقداد بن عمرو بن ثعلبة البهراني عن جبير بن نفير بن مالك الحضرمي عن عبد الرحمن بن جبير الحضرمي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","جبير بن نفير عن المقداد بن الأسود"
"18776","599  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ الْحِمْصِيُّ ،  ثَنَا  عَمْرُو بْنُ عُثْمَانَ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  ثَنَا  عَبْدُ اللهِ بْنُ سَالِمٍ ،  عَنْ  أَبِي سَلَمَةَ سُلَيْمَانَ بْنِ سُلَيْمٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ جُبَيْرِ بْنِ نُفَيْرٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمِقْدَادِ بْنِ الْأَسْوَدِ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَقَلْبُ ابْنِ آدَمَ أَسْرَعُ تَقَلُّبًا مِنَ الْقِدْرِ إِذَا اسْتَجْمَعَتْ غَلْيًا  .","","Al-Mu'jam al-Kabir 599","","المقداد بن عمرو بن ثعلبة البهراني عن جبير بن نفير بن مالك الحضرمي عن عبد الرحمن بن جبير الحضرمي عن سليمان بن سليم الكناني عن عبد الله بن سالم الوحاظي عن بقية بن الوليد عن عمرو بن عثمان بن سعيد الحمصي عن إبراهيم بن محمد بن عرق الحمصي عن الطبراني","جبير بن نفير عن المقداد بن الأسود"
"18777","600  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ، (  ح  )         [20/254]      وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  صَفْوَانَ بْنِ عَمْرٍو ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ جُبَيْرِ بْنِ نُفَيْرٍ ،  عَنْ  أَبِيهِ  قَالَ :  جَلَسْنَا إِلَى الْمِقْدَادِ بْنِ الْأَسْوَدِ يَوْمًا فَمَرَّ بِهِ  رَجُلٌ  وَاسْتَمَعْتُ  فَقَالَ : طُوبَى لِهَاتَيْنِ الْعَيْنَيْنِ اللَّتَيْنِ رَأَتَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَاللهِ لَوَدِدْتُ أَنَّا رَأَيْنَا مَا رَأَيْتَ ، وَشَهِدْنَا مَا شَهِدْتَ ، فَأَقْبَلَ إِلَيْهِ فَقَالَ : مَا يَحْمِلُ الرَّجُلَ أَنْ يَتَمَنَّى مَحْضَرًا غَيَّبَهُ اللهُ عَنْهُ ، لَا يَدْرِي لَوْ شَهِدَهُ كَيْفَ يَكُونُ فِيهِ ؟ وَاللهِ لَقَدْ حَضَرَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَقْوَامٌ كَبَّهُمُ اللهُ عَلَى مَنَاخِرِهِمْ فِي  جَهَنَّمَ  لَمْ يُجِيبُوهُ وَلَمْ يُصَدِّقُوهُ ، أَلَا يَحْرِمُ اللهُ أَحَدَكُمْ ؟ أَلَا تَعْرِفُونَ  آلَاءَ  رَبِّكُمْ مُصَدِّقِينَ لِمَا جَاءَ بِهِ نَبِيُّكُمْ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَدْ كُفِيتُمُ الْبَلَاءَ بِغَيْرِكُمْ ، وَاللهِ لَقَدْ بُعِثَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى أَشَدِّ حَالٍ بُعِثَ نَبِيٌّ مِنَ الْأَنْبِيَاءِ فِي  فَتْرَةٍ  وَجَاهِلِيَّةٍ ، مَا يَرَوْنَ أَنَّ دِينًا أَفْضَلُ مِنْ عِبَادَةِ الْأَوْثَانِ ، فَجَاءَ  بِفُرْقَانٍ  فَرَقَ بَيْنَ الْحَقِّ وَالْبَاطِلِ ، وَفَرَّقَ بَيْنَ الْوَالِدِ وَوَلَدِهِ ، حَتَّى إِنْ كَانَ الرَّجُلُ يَرَى وَالِدَهُ أَوْ وَلَدَهُ وَأَخَاهُ كَافِرًا قَدْ فَتَحَ اللهُ لَهُ قُفْلَ قَلْبِهِ بِالْإِيمَانِ ، لَيَعْلَمَ أَنَّهُ قَدْ هَلَكَ مَنْ دَخَلَ فِي النَّارِ ، فَلَا تُسَرُّ عَيْنُهُ وَهُوَ يَعْلَمُ أَنَّ حَمِيمَهُ فِي النَّارِ ، وَأَنَّهَا الَّتِي قَالَ اللهُ عَزَّ وَجَلَّ :         {      رَبَّنَا هَبْ لَنَا مِنْ أَزْوَاجِنَا وَذُرِّيَّاتِنَا قُرَّةَ أَعْيُنٍ         }      .","","Al-Mu'jam al-Kabir 600","","المقداد بن عمرو بن ثعلبة البهراني عن جبير بن نفير بن مالك الحضرمي عن عبد الرحمن بن جبير الحضرمي عن صفوان بن عمرو السكسكي عن عبد الله بن المبارك عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","جبير بن نفير عن المقداد بن الأسود"
"18778","سَلِيمُ بْنُ عَامِرٍ أَبُو يَحْيَى الْكَلَاعِيُّ  ، عَنِ  الْمِقْدَادِ  601  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ         [20/255]      ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ بْنِ جَابِرٍ ،  أَنَّهُ سَمِعَ  سُلَيْمَ بْنَ عَامِرٍ يُحَدِّثُ ،  أَنَّهُ سَمِعَ  الْمِقْدَادَ بْنَ الْأَسْوَدِ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا يَبْقَى عَلَى وَجْهِ الْأَرْضِ بَيْتُ مَدَرٍ وَلَا وَبَرٍ  إِلَّا أَدْخَلَ اللهُ عَلَيْهِمُ الْإِسْلَامَ بِعِزِّ عَزِيزٍ وَبِذُلِّ ذَلِيلٍ ، إِمَّا يُعِزُّهُمْ وَيَهْدِيهِمْ إِلَى الْإِسْلَامِ ، وَإِمَّا يُذِلُّهُمْ فَيُؤَدُّوا الْجِزْيَةَ  .","","Al-Mu'jam al-Kabir 601","","المقداد بن عمرو بن ثعلبة البهراني عن سليم بن عامر الخبائري عن عبد الرحمن بن يزيد الداراني عن الوليد بن مسلم القرشي عن نعيم بن حماد الخزاعي عن يحيى بن عثمان بن صالح عن الطبراني","سليم بن عامر أبو يحيى الكلاعي عن المقداد"
"18779","602  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْحَكَمُ بْنُ مُوسَى ،  ثَنَا  يَحْيَى بْنُ حَمْزَةَ ، (  ح  )  وَحَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  ابْنُ الْمُبَارَكِ كِلَاهُمَا ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ بْنِ جَابِرٍ ،  حَدَّثَنِي  سَلِيمُ بْنُ عَامِرٍ ،  حَدَّثَنِي  الْمِقْدَادُ بْنُ الْأَسْوَدِ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  تُدْنَا الشَّمْسُ يَوْمَ الْقِيَامَةِ مِنَ الْخَلْقِ حَتَّى يَكُونَ مِنْهُمْ كَمِقْدَارِ  مِيلٍ  - قَالَ  سُلَيْمٌ  : وَاللهِ مَا أَدْرِي مَا عَنَى بِالْمِيلِ ؟ مَسَافَةً مِنَ الْأَرْضِ ؟ أَمِ الْمِيلَ الَّذِي يُكْحَلُ بِهِ الْعَيْنُ ؟ - قَالَ : "" فَيَكُونُ النَّاسُ عَلَى قَدْرِ أَعْمَالِهِمْ فِي الْعَرَقِ ، فَمِنْهُمْ مَنْ يَكُونُ إِلَى كَعْبَيْهِ ، وَمِنْهُمْ مَنْ يَكُونُ إِلَى رُكْبَتَيْهِ ، وَمِنْهُمْ مَنْ يَكُونُ إِلَى حَقْوَيْهِ ، وَمِنْهُمْ مَنْ يُلجَمُ الْعَرَقَ إِلْجَامًا "" . وَأَشَارَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى فِيهِ  .","","Al-Mu'jam al-Kabir 602","","المقداد بن عمرو بن ثعلبة البهراني عن سليم بن عامر الخبائري عن عبد الرحمن بن يزيد الداراني عن عبد الله بن المبارك عن نعيم بن حماد الخزاعي عن يحيى بن عثمان بن صالح عن الطبراني","سليم بن عامر أبو يحيى الكلاعي عن المقداد"
"18780","603  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ الْمِصْرِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ، (  ح  )  وَحَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ قَالَا :  ثَنَا  فَرَجُ بْنُ فَضَالَةَ ،  عَنْ  سُلَيْمِ بْنِ عَامِرٍ ،  عَنِ  الْمِقْدَادِ بْنِ الْأَسْوَدِ ، قَالَ :  لَا أَقُولُ فِي أَحَدٍ خَيْرًا ،         [20/256]      وَلَا شَرًّا حَتَّى أَنْظُرَ مَا يُخْتَمُ بِهِ عَمَلُهُ ، بَعْدَ شَيْءٍ سَمِعْتُهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : وَمَا سَمِعْتَ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَقَلْبُ ابْنِ آدَمَ أَشَدُّ انْقِلَابًا مِنَ الْقِدْرِ إِذَا اسْتَجْمَعَتْ غَلْيًا  .","","Al-Mu'jam al-Kabir 603","","المقداد بن عمرو بن ثعلبة البهراني عن سليم بن عامر الخبائري عن فرج بن فضالة بن النعمان التنوخي عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","سليم بن عامر أبو يحيى الكلاعي عن المقداد"
"18781","604  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  أَحْمَدُ بْنُ أَشْكِيبَ الْكُوفِيُّ ،  ثَنَا  أَبُو خَالِدٍ الْأَحْمَرُ ،  عَنْ  يَزِيدَ بْنِ سِنَانٍ أَبِي فَرْوَةَ ،  عَنْ  أَبِي يَحْيَى الْكَلَاعِيِّ ،  عَنْ  سُلَيْمِ بْنِ عَامِرٍ ،  حَدَّثَنِي  الْمِقْدَادُ بْنُ الْأَسْوَدِ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يُحْشَرُ النَّاسُ مَا بَيْنَ  السِّقْطِ  إِلَى الشَّيْخِ الْفَانِي  أَبْنَاءَ ثَلَاثٍ وَثَلَاثِينَ فِي خَلْقِ  آدَمَ  ، وَحُسْنِ  يُوسُفَ  ،  وَخُلُقِ  أَيُّوبَ  ، مُكَحَّلِينَ ذَوِي  أَفَانِينَ  .","","Al-Mu'jam al-Kabir 604","","المقداد بن عمرو بن ثعلبة البهراني عن سليم بن عامر الخبائري عن يزيد بن سنان الرهاوي عن سليمان بن حيان الأحمر عن أحمد بن إشكاب الصفار عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","سليم بن عامر أبو يحيى الكلاعي عن المقداد"
"18782","أَبُو ظَبْيَةَ الْكَلَاعِيُّ  عَنِ  الْمِقْدَادِ  .  605  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ،  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ، (  ح  )         [20/257]      وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ ،  ثَنَا  أَحْمَدُ بْنُ أَشْكِيبَ الْكُوفِيُّ ، (  ح  )  وَحَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ قَالُوا :  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  ثَنَا  مُحَمَّدُ بْنُ سَعْدٍ الْأَنْصَارِيُّ ، قَالَ :  سَمِعْتُ  أَبَا ظَبْيَةَ الْكَلَاعِيَّ يَقُولُ :  سَمِعْتُ  الْمِقْدَادَ بْنَ الْأَسْوَدِ يُحَدِّثُ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَأَلَهُمْ عَنِ الزِّنَا ، فَقَالُوا : حَرَامٌ حَرَّمَهُ اللهُ وَرَسُولُهُ ، فَقَالَ :  لَأَنْ يَزْنِيَ الرَّجُلُ بِعَشْرِ نِسْوَةٍ خَيْرٌ لَهُ مِنْ أَنْ يَزْنِيَ بِامْرَأَةِ جَارِهِ  . قَالَ : وَسَأَلَهُمْ عَنِ السَّرِقَةِ فَقَالُوا : حَرَامٌ ، حَرَّمَهَا اللهُ وَرَسُولُهُ ، فَقَالَ : "" لَأَنْ يَسْرِقَ الرَّجُلُ مِنْ عَشَرَةِ أَبْيَاتٍ أَيْسَرُ عَلَيْهِ مِنْ أَنْ يَسْرِقَ مِنْ بَيْتِ جَارِهِ  .","","Al-Mu'jam al-Kabir 605","","المقداد بن عمرو بن ثعلبة البهراني عن أبو ظبية السلفي عن محمد بن سعد الأنصاري عن محمد بن فضيل بن غزوان عن محمد بن عبد الله بن نمير عن عبد الله بن أحمد الجواليقي عن الطبراني","أبو ظبية الكلاعي عن المقداد"
"18783","شُرَيْحُ بْنُ عُبَيْدٍ الْحَضْرَمِيُّ  عَنِ  الْمِقْدَادِ  606  -  حَدَّثَنَا  مُحَمَّدُ بْنُ هَارُونَ بْنِ بَكَّارٍ الدِّمَشْقِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ عُتْبَةَ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  عَبْدُ الْجَبَّارِ بْنُ عَاصِمٍ قَالَا :  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  صَفْوَانَ بْنِ عَمْرٍو ،  عَنْ  شُرَيْحِ بْنِ عُبَيْدٍ ،  عَنِ  الْمِقْدَادِ بْنِ الْأَسْوَدِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَحَبَّ اللهَ وَرَسُولَهُ صَادِقًا غَيْرَ كَاذِبٍ  ، وَلَقِيَ الْمُؤْمِنِينَ فَأَحَبَّهُمْ ، وَكَانَ أَمْرُ الْجَاهِلِيَّةِ عِنْدَهُ كَمَنْزِلَةِ نَارٍ أُلْقِيَ         [20/258]      فِيهَا  فَقَدْ طَعِمَ طَعْمَ الْإِيمَانِ "" - أَوْ قَالَ : "" فَقَدْ بَلَغَ ذِرْوَةَ الْإِيمَانِ  -  الشَّكُّ مِنْ  صَفْوَانَ  .","","Al-Mu'jam al-Kabir 606","","المقداد بن عمرو بن ثعلبة البهراني عن شريح بن عبيد المقرائي عن صفوان بن عمرو السكسكي عن بقية بن الوليد عن الوليد بن عتبة الأشجعي عن محمد بن هارون بن محمد الدمشقي عن الطبراني","شريح بن عبيد الحضرمي عن المقداد"
"18784","عَمْرُو بْنُ الْأَسْوَدِ  عَنِ  الْمِقْدَادِ  607  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَمْزَةَ الدِّمَشْقِيُّ ،  ثَنَا  حَيْوَةُ بْنُ شُرَيْحٍ الْحِمْصِيُّ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  إِسْمَاعِيلَ بْنِ عَيَّاشٍ ،  عَنْ  ضَمْضَمِ بْنِ زُرْعَةَ أَبِي زُرْعَةَ ،  عَنْ  شُرَيْحِ بْنِ عُبَيْدٍ ،  عَنْ  جُبَيْرِ بْنِ نُفَيْرٍ ، وَعَمْرِو بْنِ الْأَسْوَدِ ،  عَنِ  الْمِقْدَادِ بْنِ الْأَسْوَدِ ، وَأَبِي أُمَامَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ الْإِمَامَ إِذَا ابْتَغَى الْفِتْنَةَ فِي النَّاسِ أَفْسَدَهُمْ  .","","Al-Mu'jam al-Kabir 607","","أبو أمامة الباهلي عن جبير بن نفير بن مالك الحضرمي عن شريح بن عبيد المقرائي عن ضمضم بن زرعة الحضرمي عن إسماعيل بن عياش الأحول عن بقية بن الوليد عن حيوة المقرئ عن أحمد بن محمد بن يحيى البتلهي عن الطبراني","عمرو بن الأسود عن المقداد"
"18785","عَبْدُ الرَّحْمَنِ بْنُ مَيْسَرَةَ  ، عَنِ  الْمِقْدَادِ  608  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  أَحْمَدُ بْنُ سَعِيدِ بْنِ يَعْقُوبَ الْكِنْدِيُّ الْحِمْصِيُّ ،  ثَنَا  عُثْمَانُ بْنُ سَعِيدِ بْنِ كَثِيرِ بْنِ دِينَارٍ ،  ثَنَا  حَرِيزُ بْنُ عُثْمَانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ مَيْسَرَةَ ، قَالَ :  مَرَّ بِالْمِقْدَادِ  نَاسٌ - أَوْ  رَجُلٌ  - فَقَالَ : لَقَدْ أَفْلَحَتْ هَاتَانِ الْعَيْنَانِ ، رَأَتَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَاسْتَجْمَعَ  الْمِقْدَادُ  غَضَبًا ، وَقَالَ :  يَا أَيُّهَا النَّاسُ ، لَا تَتَمَنَّوْا أَمْرًا قَدْ غَيَّبَهُ اللهُ  ، فَكَمْ مَنْ قَدْ رَآهُ وَلَمْ يَنْتَفِعْ بِرُؤْيَتِهِ ""  .","","Al-Mu'jam al-Kabir 608","","المقداد بن عمرو بن ثعلبة البهراني عن عبد الرحمن بن ميسرة الحمصي عن حريز بن عثمان الرحبي عن عثمان بن سعيد بن كثير عن أحمد بن سعيد بن يعقوب الكندي عن عبد الله بن أحمد بن حنبل عن الطبراني","عبد الرحمن بن ميسرة عن المقداد"
"18786","عُمَيْرُ بْنُ إِسْحَاقَ  ، عَنِ  الْمِقْدَادِ  609  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  الْوَلِيدُ بْنُ         [20/259]      الْعَبَّاسِ النَّرْسِيُّ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  صَالِحُ بْنُ حَاتِمِ بْنِ وَرْدَانَ ، قَالَا :  ثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَوْنٍ ،  عَنْ  عُمَيْرِ بْنِ إِسْحَاقَ ،  عَنِ  الْمِقْدَادِ بْنِ الْأَسْوَدِ ، قَالَ :  بَعَثَنِي النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَبْعَثًا ، فَلَمَّا رَجَعْتُ قَالَ لِي :  كَيْفَ تَجِدُ نَفْسَكَ "" ؟  قُلْتُ : مَا زِلْتُ حَتَّى ظَنَنْتُ أَنَّ مَعِيَ  خَوَلًا  لِي ، وَأَيْمُ اللهِ ، لَا أَعْمَلُ عَلَى رَجُلَيْنِ بَعْدَهَا أَبَدًا  .","","Al-Mu'jam al-Kabir 609","","المقداد بن عمرو بن ثعلبة البهراني عن عمير بن إسحاق الهاشمي عن عبد الله بن عون بن أرطبان عن بشر بن المفضل عن صالح بن حاتم بن وردان البصري عن الحسين بن إسحاق التستري عن الطبراني","عمير بن إسحاق عن المقداد"
"18787","ضُبَاعَةُ بِنْتُ الْمِقْدَادِ  ، عَنْ أَبِيهَا  610  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  عَلِيُّ بْنُ عَيَّاشٍ ،  ثَنَا  الْوَلِيدُ بْنُ كَامِلٍ أَبُو عُبَيْدَةَ الْبَجَلِيُّ ،  عَنِ  الْمُهَلَّبِ بْنِ حُجْرٍ النَّهَرَانِيِّ ،  عَنْ  ضُبَاعَةَ بِنْتِ الْمِقْدَادِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهَا  قَالَ :  مَا رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" يُصَلِّي إِلَى عَمُودٍ  ، وَلَا عُودٍ ، وَلَا شَجَرَةٍ إِلَّا وَهُوَ يَجْعَلُهُ عَلَى حَاجِبِهِ الْأَيْمَنِ ، وَحَاجِبِهِ الْأَيْسَرِ ، وَلَا يَصْمُدُ إِلَيْهِ صَمْدًا  .","","Al-Mu'jam al-Kabir 610","","المقداد بن عمرو بن ثعلبة البهراني عن ضباعة بنت المقداد عن المهلب بن حجر البهراني عن الوليد بن كامل بن معاذ البجلي عن علي بن عياش الألهاني عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","ضباعة بنت المقداد عن أبيها"
"18788","ضُبَاعَةُ بِنْتُ الزُّبَيْرِ بْنِ عَبْدِ الْمُطَّلِبِ امْرَأَةُ الْمِقْدَادِ  ، عَنِ  الْمِقْدَادِ  611  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  خَالِدُ بْنُ مَخْلَدٍ ،  ثَنَا  مُوسَى بْنُ يَعْقُوبَ الزَّمْعِيُّ ،  حَدَّثَتْنِي  عَمَّتِي  قَرِيبَةُ بِنْتُ عَبْدِ اللهِ         [20/260]      بْنِ وَهْبٍ ،  عَنْ  أُمِّهَا كَرِيمَةَ بِنْتِ الْمِقْدَادِ بْنِ عَمْرٍو  ،  عَنْ  ضُبَاعَةَ بِنْتِ الزُّبَيْرِ  ، - وَكَانَتْ تَحْتَ  الْمِقْدَادِ  - قَالَتْ :  كَانَ النَّاسُ إِنَّمَا يَذْهَبُونَ لِحَاجَتِهِمْ  فَرْطَ  الْيَوْمَيْنِ وَالثَّلَاثَةِ ، فَيَبْعَرُونَ كَمَا تَبْعَرُ الْبَعِيرُ ، فَلَمَّا كَانَ ذَاتَ يَوْمٍ خَرَجَ الْمِقْدَادُ لِحَاجَتِهِ حَتَّى بَلَغَ  الْخَبْخَبَةَ  - وَهُوَ  بِبَقِيعِ الْغَرْقَدِ  - فَدَخَلَ خَرِبَةً لِحَاجَتِهِ ، فَبَيْنَمَا هُوَ جَالِسٌ إِذْ أَخْرَجَ جُرَذٌ مِنْ جُحْرٍ دِينَارًا ، فَلَمْ يَزَلْ يُخْرِجُ دِينَارًا دِينَارًا حَتَّى بَلَغَ سَبْعَةَ عَشَرَ دِينَارًا ، فَخَرَجْتُ بِهَا حَتَّى جِئْتُ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَخْبَرْتُهُ خَبَرَهَا فَقَالَ :  هَلْ أَتْبَعْتَ يَدَكَ الْجُحْرَ ؟  فَقُلْتُ : لَا وَالَّذِي بَعَثَكَ بِالْحَقِّ ، فَقَالَ : "" لَا صَدَقَةَ عَلَيْكَ فِيهَا ، بَارَكَ اللهُ لَكَ فِيهَا "" .  قَالَتْ  ضُبَاعَةُ  : "" فَمَا فَنِيَ آخِرُهَا حَتَّى رَأَيْتُ غَدَائِرَ الْوَرِقِ فِي بَيْتِ  الْمِقْدَادِ  "" .","","Al-Mu'jam al-Kabir 611","","المقداد بن عمرو بن ثعلبة البهراني عن ضباعة بنت الزبير الهاشمية عن كريمة بنت المقداد الكندية عن قريبة بنت عبد الله بن وهب الأسدية عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن خالد بن مخلد القطواني عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","ضباعة بنت الزبير بن عبد المطلب امرأة المقداد عن المقداد"
"18789","612  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ الدِّمَشْقِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  حَدَّثَنِي  مُوسَى بْنُ يَعْقُوبَ الزَّمْعِيُّ ،  عَنْ  عَمَّتِهِ  قَرِيبَةَ بِنْتِ عَبْدِ اللهِ ،  عَنْ  أُمِّهَا كَرِيمَةَ بِنْتِ الْمِقْدَادِ  ،  عَنْ  ضُبَاعَةَ بِنْتِ الزُّبَيْرِ أَنَّهَا  أَخْبَرَتْهُ  ، قَالَتْ :  ذَهَبَ الْمِقْدَادُ لِحَاجَتِهِ فَدَخَلَ خَرِبَةً ، فَإِذَا الْجُرَذُ يُخْرِجُ مِنْ جُحْرٍ دِينَارًا دِينَارًا ، حَتَّى أَخْرَجَ سَبْعَةَ عَشَرَ دِينَارًا ، ثُمَّ أَخْرَجَ طَرَفَ خِرْقَةٍ خَضْرَاءَ ، قَالَ  الْمِقْدَادُ  : فَقُمْتُ فَمَدَدْتُ طَرَفَ الْخِرْقَةِ فَوَجَدْتُ فِيهَا دِينَارًا ، فَكَانَتْ ثَمَانِيَةَ عَشَرَ دِينَارًا ، فَذَهَبَ بِهَا  الْمِقْدَادُ  وَاسْتَأْذَنَ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا دَخَلَ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَخْبَرَهُ خَبَرَهَا ، وَقَالَ : خُذْ صَدَقَتَهَا يَا رَسُولَ اللهِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هَلْ أَهْوَيْتَ بِيَدِكَ إِلَى الْجُحْرِ ؟  . قَالَ  الْمِقْدَادُ  : لَا وَالَّذِي بَعَثَكَ بِالْحَقِّ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعْدَ ذَلِكَ  لِلْمِقْدَادِ  : "" بَارَكَ اللهُ لَكَ فِيهَا  .","","Al-Mu'jam al-Kabir 612","","المقداد بن عمرو بن ثعلبة البهراني عن ضباعة بنت الزبير الهاشمية عن كريمة بنت المقداد الكندية عن قريبة بنت عبد الله بن وهب الأسدية عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن محمد بن إسماعيل بن مسلم الديلي عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","ضباعة بنت الزبير بن عبد المطلب امرأة المقداد عن المقداد"
"18790","613  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  أَبُو بَكْرِ         [20/261]      بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ قَالَا :  ثَنَا  خَالِدُ بْنُ مَخْلَدٍ ،  ثَنَا  مُوسَى بْنُ يَعْقُوبَ ،  حَدَّثَتْنِي  عَمَّتِي  قَرِيبَةُ بِنْتُ عَبْدِ اللهِ بْنِ وَهْبٍ ،  عَنْ  أُمِّهَا كَرِيمَةَ بِنْتِ الْمِقْدَادِ  ،  عَنْ  ضُبَاعَةَ بِنْتِ الزُّبَيْرِ بْنِ عَبْدِ الْمُطَّلِبِ - وَكَانَتْ تَحْتَ  الْمِقْدَادِ  -  عَنِ  الْمِقْدَادِ  ، قَالَ :  قُلْتُ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : شَيْءٌ سَمِعْتُهُ مِنْكَ شَكَكْتُ فِيهِ ، قَالَ :  فَإِذَا شَكَّ أَحَدُكُمْ فِي الْأَمْرِ فَلْيَسْأَلْنِي عَنْهُ  ، قَالَ : قَوْلُكَ فِي أَزْوَاجِكَ : "" إِنِّي لَأَرْجُو لَهُنَّ مِنْ بَعْدِي الصِّدِّيقِينَ "" ، قَالَ : "" وَمَنْ تَعُدُّونَ الصِّدِّيقِينَ ؟ "" فَقُلْنَا : أَوْلَادُنَا الَّذِينَ يَهْلِكُونَ صِغَارًا ، قَالَ : "" وَلَكِنَّ الصِّدِّيقِينَ هُمُ الْمُتَصَدِّقُونَ "" . قَالَهَا ثَلَاثًا  .","","Al-Mu'jam al-Kabir 613","","المقداد بن عمرو بن ثعلبة البهراني عن ضباعة بنت الزبير الهاشمية عن كريمة بنت المقداد الكندية عن قريبة بنت عبد الله بن وهب الأسدية عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن خالد بن مخلد القطواني عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","ضباعة بنت الزبير بن عبد المطلب امرأة المقداد عن المقداد"
"18791","614  -  حَدَّثَنَا  حَجَّاجُ بْنُ عِمْرَانَ السَّدُوسِيُّ الْبَصْرِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ الشَّاذَكُونِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُمَرَ الْوَاقِدِيُّ ،  ثَنَا  مُوسَى بْنُ يَعْقُوبَ الزَّمْعِيُّ ،  عَنْ  عَمَّتِهِ  قَرِيبَةَ بِنْتِ عَبْدِ اللهِ بْنِ وَهْبٍ ،  عَنْ  أُمِّهَا كَرِيمَةَ بِنْتِ الْمِقْدَادِ  ،  عَنْ  ضُبَاعَةَ بِنْتِ الزُّبَيْرِ بْنِ عَبْدِ الْمُطَّلِبِ ،  عَنِ  الْمِقْدَادِ بْنِ عَمْرٍو  ،  أَنَّهُ  كَانَ  يَوْمَ بَدْرٍ  عَلَى فَرَسِ - يُقَالُ لَهَا :  سُبْحَةٌ  - "" فَأَسْهَمَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِفَرَسِهِ سَهْمًا ، وَلَهُ سَهْمًا  .","","Al-Mu'jam al-Kabir 614","","المقداد بن عمرو بن ثعلبة البهراني عن ضباعة بنت الزبير الهاشمية عن كريمة بنت المقداد الكندية عن قريبة بنت عبد الله بن وهب الأسدية عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن الواقدي عن الشاذكوني عن حجاج بن عمران السدوسي عن الطبراني","ضباعة بنت الزبير بن عبد المطلب امرأة المقداد عن المقداد"
"18792","الْمِقْدَامُ بْنُ مَعْدِيكَرِبَ الْكِنْدِيُّ ، يُكْنَى أَبَا كَرِيمَةَ ، وَقَدْ قِيلَ : أَبَا يَحْيَى  ، نَزَلَ  الشَّامَ  وَمَاتَ بِهَا  615  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ  ،  ثَنَا  أَبِي         [20/262]      ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ  ، عَنْ  شُرَحْبِيلَ بْنِ مُسْلِمٍ  ، ""  أَنَّ  خَالِدَ بْنَ يَزِيدَ  قَالَ  لِلْمِقْدَامِ بْنِ مَعْدِيكَرِبَ  : يَا  أَبَا كَرِيمَةَ  "" .","","Al-Mu'jam al-Kabir 615","","","المقدام بن معدي كرب الكندي"
"18793","616  -  حَدَّثَنَا  مُوسَى بْنُ زَكَرِيَّا التُّسْتَرِيُّ  ،  ثَنَا  شَبَابٌ الْعُصْفُرِيُّ  ،  قَالَ  : ""  الْمِقْدَامُ بْنُ مَعْدِيكَرِبَ يُكْنَى أَبَا يَحْيَى  مَاتَ  الْمِقْدَامُ بْنُ مَعْدِيكَرِبَ  سَنَةَ سَبْعٍ وَثَمَانِينَ وَهُوَ ابْنُ إِحْدَى وَتِسْعِينَ  ""  .","","Al-Mu'jam al-Kabir 616","","","المقدام بن معدي كرب الكندي"
"18794","617  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  شُرَحْبِيلَ بْنِ مُسْلِمٍ ، قَالَ :  رَأَيْتُ خَمْسَةً مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" يَقُمُّونَ شَوَارِبَهُمْ  ، وَيُعْفُونَ لِحَاهُمْ وَيُصَفِّرُونَهَا ، مِنْهُمُ الْمِقْدَامُ بْنُ مَعْدِيكَرِبَ  "" .","","Al-Mu'jam al-Kabir 617","","المقدام بن معدي كرب الكندي عن شرحبيل بن مسلم الخولاني عن إسماعيل بن عياش الأحول عن عبد الوهاب بن نجدة عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","المقدام بن معدي كرب الكندي"
"18795","618  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  يَحْيَى بْنُ حَمْزَةَ ،  ثَنَا  أَبُو طَرَفَةَ عَبَّادُ بْنُ الرَّيَّانِ اللَّخْمِيُّ الْحِمْصِيُّ ،  قَالَ  :  أَتَيْتُ الْمِقْدَامَ بْنَ مَعْدِيكَرِبَ وَهُوَ فِي قَرْيَةٍ عَلَى أَمْيَالٍ مِنْ  حِمْصَ  يَوْمَ عِيدٍ ، فَقُلْنَا : "" اخْرُجْ فَصَلِّ بِنَا الْعِيدَ ، فَقَالَ : "" لَا ، صَلُّوا فُرَادَى ""  .","","Al-Mu'jam al-Kabir 618","","المقدام بن معدي كرب الكندي عن عباد بن الريان اللخمي عن يحيى بن حمزة بن البتلهي عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","المقدام بن معدي كرب الكندي"
"18796","619  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ تَقِيِّ بْنِ أَبِي تَقِيٍّ الْحِمْصِيُّ ،  حَدَّثَنِي  جَدِّي أَبُو تَقِيٍّ هِشَامُ بْنُ عَبْدِ الْمَلِكِ  ،  ثَنَا  مُحَمَّدُ بْنُ حَرْبٍ ،  عَنْ  حُمَيْدِ بْنِ رَبِيعَةَ الْقُرَشِيِّ ،  قَالَ  :  رَأَيْتُ أَبَا أُمَامَةَ الْبَاهِلِيَّ ، وَالْمِقْدَامَ بْنَ مَعْدِيكَرِبَ وَعَلَيْهِمَا  بُرْنُسَانِ  "" .         [20/263]","","Al-Mu'jam al-Kabir 619","","المقدام بن معدي كرب الكندي عن حميد بن ربيعة القرشي الشامي عن محمد بن حرب الأبرش عن هشام بن عبد الملك اليزني عن حسين بن تقي الكفرتكيسي عن الطبراني","المقدام بن معدي كرب الكندي"
"18797","620  -  حَدَّثَنَا  مُوسَى بْنُ عِيسَى بْنِ الْمُنْذِرِ ،  ثَنَا  أَبِي  ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ رَاشِدٍ ، قَالَ :  سَمِعْتُ  الْمِقْدَامَ بْنَ مَعْدِيكَرِبَ صَاحِبَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَكْثَرُ النَّاسِ يَقُولُونَ : الْقَضَاءُ فِي مِائَةِ عَامٍ -  يَعْنُونَ بَعْدَ مِائَةِ سَنَةٍ تَكُونُ الْقِيَامَةُ  - فَقَالَ  الْمِقْدَامُ  :  قَدْ أَكْثَرْتُمْ ، لَنْ يَعْجَزَ اللهُ أَنْ يُؤَخِّرَ هَذِهِ الْأُمَّةَ نِصْفَ يَوْمٍ  .  يَعْنِي خَمْسَمِائَةِ عَامٍ  .","","Al-Mu'jam al-Kabir 620","","المقدام بن معدي كرب الكندي عن عبد الملك بن راشد الحمصي عن بقية بن الوليد عن عيسى بن المنذر السلمي عن موسى بن عيسى بن المنذر الحمصي عن الطبراني","المقدام بن معدي كرب الكندي"
"18798","الشَّعْبِيُّ  ، عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ  621  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  خَلَّادُ بْنُ يَحْيَى ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَبِشْرُ بْنُ مُوسَى قَالَا :  ثَنَا  أَبُو نُعَيْمٍ ، قَالَا :  ثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  الْمِقْدَامِ أَبِي كَرِيمَةَ الشَّامِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْلَةُ الضَّيْفِ  حَقٌّ  وَاجِبٌ  عَلَى كُلِّ مُسْلِمٍ  ، فَإِنْ أَصْبَحَ بِفِنَائِهِ فَهُوَ دَيْنٌ عَلَيْهِ ، إِنْ شَاءَ اقْتَضَاهُ ، وَإِنْ شَاءَ تَرَكَهُ  .","","Al-Mu'jam al-Kabir 621","","المقدام بن معدي كرب الكندي عن الشعبي عن منصور بن المعتمر عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","الشعبي عن المقدام بن معدي كرب"
"18799","622  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  أَبِي كَرِيمَةَ ، أَنَّهُ سَمِعَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَيْلَةُ الضَّيْفِ  حَقٌّ  عَلَى كُلِّ مُسْلِمٍ  ، وَمَنْ أَصْبَحَ الضَّيْفُ بِفِنَائِهِ فَهُوَ  حَقٌّ  أَوْ دَيْنٌ ، إِنْ شَاءَ اقْتَضَاهُ ، وَإِنْ شَاءَ تَرَكَهُ  .","","Al-Mu'jam al-Kabir 622","","المقدام بن معدي كرب الكندي عن الشعبي عن منصور بن المعتمر عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن أحمد بن داود بن موسى السدوسي عن الطبراني","الشعبي عن المقدام بن معدي كرب"
"18800","623  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَالِدٍ الْمِصِّيصِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عِيسَى الطَّبَّاعُ ، (  ح  )         [20/264]      وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ قَالَا :  ثَنَا  الْحَجَّاجُ بْنُ الْمِنْهَالِ ، (  ح  )  وَحَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْوَهَّابِ الْحَجَبِيُّ ، قَالُوا :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  أَبِي كَرِيمَةَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَيْلَةُ الضَّيْفِ وَاجِبَةٌ عَلَى كُلِّ مُسْلِمٍ  ، فَمَنْ أَصْبَحَ بِفِنَائِهِ فَهُوَ لَهُ عَلَيْهِ دَيْنٌ ، إِنْ شَاءَ اقْتَضَى وَإِنْ شَاءَ تَرَكَ  .","","Al-Mu'jam al-Kabir 623","","المقدام بن معدي كرب الكندي عن الشعبي عن منصور بن المعتمر عن الوضاح بن عبد الله اليشكري عن عبد الله بن عبد الوهاب الحجبي عن الفضل بن الحباب الجمحي عن الطبراني","الشعبي عن المقدام بن معدي كرب"
"18801","624  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ، وَجَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  الْمِقْدَامِ أَبِي كَرِيمَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْلَةُ الضَّيْفِ  حَقٌّ  ، فَإِنْ أَصْبَحَ بِفِنَائِهِ فَهُوَ عَلَيْهِ دَيْنٌ  ، إِنْ شَاءَ اقْتَضَاهُ ، وَإِنْ شَاءَ تَرَكَهُ  .","","Al-Mu'jam al-Kabir 624","","المقدام بن معدي كرب الكندي عن الشعبي عن منصور بن المعتمر عن جرير بن عبد الحميد عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","الشعبي عن المقدام بن معدي كرب"
"18802","أَبُو عَامِرٍ الْهَوْزَنِيُّ  ، عَنِ  الْمِقْدَامِ  625  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ .  (  ح  )         [20/265]      وَحَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ قَالَا :  ثَنَا  شُعْبَةُ ،  عَنْ  بُدَيْلِ بْنِ مَيْسَرَةَ ، قَالَ :  سَمِعْتُ  عَلِيَّ بْنَ أَبِي طَلْحَةَ ،  عَنْ  رَاشِدِ بْنِ سَعْدٍ ،  عَنْ  أَبِي عَامِرٍ الْهَوْزَنِيِّ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ تَرَكَ  كَلًّا  فَإِلَى اللهِ وَإِلَى رَسُولِهِ - أَوْ قَالَ : فَإِلَيْنَا  - وَمَنْ تَرَكَ مَالًا فَلِوَرَثَتِهِ ، وَأَنَا وَارِثُ مَنْ لَا وَارِثَ لَهُ ، أَرِثُ مَالَهُ وَأَفُكُّ  عَانَهُ  ، وَالْخَالُ مَوْلَى مَنْ لَا مَوْلَى لَهُ يَرِثُ مَالَهُ وَيَفُكُّ  عَانَهُ  .","","Al-Mu'jam al-Kabir 625","","المقدام بن معدي كرب الكندي عن عبد الله بن لحي الهوزني عن راشد بن سعد المقرائي عن علي بن أبي طلحة العباسي عن بديل بن ميسرة العقيلي عن شعبة بن الحجاج عن حفص بن عمر الحوضى عن الفضل بن الحباب الجمحي عن الطبراني","أبو عامر الهوزني عن المقدام"
"18803","626  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، وَيُوسُفُ الْقَاضِي قَالَا :  ثَنَا  مُسَدَّدٌ قَالَا :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  بُدَيْلِ بْنِ مَيْسَرَةَ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَلْحَةَ ،  عَنْ  رَاشِدِ بْنِ سَعْدٍ ،  عَنْ  أَبِي عَامِرٍ الْهَوْزَنِيِّ ،  عَنِ  الْمِقْدَامِ الْكِنْدِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَنَا أَوْلَى بِكُلِّ مُؤْمِنٍ مِنْ نَفْسِهِ ، مَنْ تَرَكَ دَيْنًا أَوْ ضَيْعَةً فَإِلَيَّ  ، وَمَنْ تَرَكَ مَالًا فَلِوَرَثَتِهِ ، وَأَنَا وَلِيُّ مَنْ لَا مَوْلَى لَهُ ، أَرِثُ مَالَهُ ، وَأَفُكُّ  عَانَهُ  ، وَالْخَالُ مَوْلَى مَنْ لَا مَوْلَى لَهُ ، يَرِثُ مَالَهُ وَيَفُكُّ  عَانَهُ  .","","Al-Mu'jam al-Kabir 626","","المقدام بن معدي كرب الكندي عن عبد الله بن لحي الهوزني عن راشد بن سعد المقرائي عن علي بن أبي طلحة العباسي عن بديل بن ميسرة العقيلي عن حماد بن زيد عن مسدد بن مسرهد عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","أبو عامر الهوزني عن المقدام"
"18804","627  -  حَدَّثَنَا  عَمْرُو بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ بْنِ زِبْرِيقٍ ،  ثَنَا  أَبِي  ، (  ح  )  وَحَدَّثَنَا  عُمَارَةُ بْنُ وَثِيمَةَ الْمِصْرِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ زِبْرِيقٍ         [20/266]      الْحِمْصِيُّ ،  ثَنَا  عَبْدُ الْوَارِثِ ،  أَنَا  عَبْدُ اللهِ بْنُ سَالِمٍ ،  عَنِ  الزُّبَيْدِيِّ ،  ثَنَا  رَاشِدُ بْنُ سَعْدٍ ،  عَنِ  ابْنِ عَائِذٍ حَدَّثَهُ ، أَنَّ الْمِقْدَامَ  حَدَّثَهُمْ  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ تَرَكَ دَيْنًا أَوْ ضَيْعَةً فَإِلَيَّ ، وَمَنْ تَرَكَ مَالًا فَلِوَارِثِهِ  ، وَأَنَا مَوْلَى مَنْ لَا مَوْلَى لَهُ ، أَفُكُّ  عَانَهُ  وَأَرِثُ مَالَهُ ، وَالْخَالُ مَوْلَى مَنْ لَا مَوْلَى لَهُ ، يَفُكُّ  عَانَهُ  ، وَيَرِثُ مَالَهُ  .","","Al-Mu'jam al-Kabir 627","","المقدام بن معدي كرب الكندي عن عبد الرحمن بن عائذ الثمالي عن راشد بن سعد المقرائي عن محمد بن الوليد بن عامر الزبيدي عن عبد الله بن سالم الوحاظي عن عبد الوارث عن إسحاق بن إبراهيم بن العلاء عن عمارة بن وثيمة المصري عن الطبراني","أبو عامر الهوزني عن المقدام"
"18805","628  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  رَاشِدِ بْنِ سَعْدٍ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ الْكِنْدِيِّ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ تَرَكَ دَيْنًا أَوْ ضَيْعَةً فَإِلَيَّ  ، وَمَنْ تَرَكَ مَالًا فَلِوَرَثَتِهِ ، وَأَنَا مَوْلَى مَنْ لَا مَوْلَى لَهُ ، أَفُكُّ  عَانَهُ  وَأَرِثُ مَالَهُ  .","","Al-Mu'jam al-Kabir 628","","المقدام بن معدي كرب الكندي عن راشد بن سعد المقرائي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","أبو عامر الهوزني عن المقدام"
"18806","خَالِدُ بْنُ مَعْدَانَ  ، عَنِ  الْمِقْدَامِ  629  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ         [20/267]      إِسْمَاعِيلَ بْنِ عَيَّاشٍ ،  عَنْ  بَحِيرِ بْنِ سَعْدٍ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ لِلشَّهِيدِ عِنْدَ اللهِ  تِسْعَ خِصَالٍ - أَوْ قَالَ : عَشْرَ خِصَالٍ  - يُغْفَرُ لَهُ فِي أَوَّلِ دُفْعَةٍ مِنْ دَمِهِ ، وَيَرَى مَقْعَدَهُ مِنَ الْجَنَّةِ ، وَيُحَلَّى حِلْيَةَ الْإِيمَانِ ، وَيُجَارُ مِنْ عَذَابِ الْقَبْرِ ، وَيُزَوَّجُ مِنَ  الْحُورِ  الْعِينِ  ، وَيَأْمَنُ يَوْمَ الْفَزَعِ الْأَكْبَرِ ، وَيُوضَعُ عَلَى رَأْسِهِ تَاجُ  الْوَقَارِ :  الْيَاقُوتَةُ خَيْرٌ مِنَ الدُّنْيَا وَمَا فِيهَا ، وَيُزَوَّجُ اثْنَتَيْنِ وَتِسْعِينَ زَوْجَةً مِنَ الْحُورِ  الْعِينِ  ، وَيُشَفَّعُ فِي سَبْعِينَ إِنْسَانًا مِنْ أَقَارِبِهِ  .","","Al-Mu'jam al-Kabir 629","","المقدام بن معدي كرب الكندي عن خالد بن معدان عن بحير بن سعد عن إسماعيل بن عياش الأحول عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","خالد بن معدان عن المقدام"
"18807","630  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ ،  ثَنَا  حَيْوَةُ بْنُ شُرَيْحٍ الْحِمْصِيُّ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  بَحِيرِ بْنِ سَعْدٍ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ رُكُوبٍ عَلَى جُلُودِ  السِّبَاعِ  .","","Al-Mu'jam al-Kabir 630","","المقدام بن معدي كرب الكندي عن خالد بن معدان عن بحير بن سعد عن بقية بن الوليد عن حيوة المقرئ عن أبو زرعة الدمشقي عن الطبراني","خالد بن معدان عن المقدام"
"18808","631  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  بَحِيرِ بْنِ سَعْدٍ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا أَكَلَ أَحَدٌ طَعَامًا خَيْرًا مِنْ أَنْ يَأْكُلَ مِنْ عَمَلِ يَدِهِ  ، وَكَانَ  دَاوُدُ  لَا يَأْكُلُ إِلَّا مِنْ عَمَلِ يَدِهِ  .","","Al-Mu'jam al-Kabir 631","","المقدام بن معدي كرب الكندي عن خالد بن معدان عن بحير بن سعد عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","خالد بن معدان عن المقدام"
"18809","632  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ، وَسُلَيْمَانُ بْنُ أَيُّوبَ         [20/268]      بْنِ حَذْلَمٍ الدِّمَشْقِيُّ ، قَالَا ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  بَحِيرِ بْنِ سَعْدٍ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ،  أَنَّهُ رَأَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُشِيرُ بِيَدِهِ يَقُولُ :  مَا أَكَلَ أَحَدٌ مِنْكُمْ طَعَامًا فِي الدُّنْيَا خَيْرٌ لَهُ مِنْ أَنْ يَأْكُلَ مِنْ عَمَلِ يَدَيْهِ  .","","Al-Mu'jam al-Kabir 632","","المقدام بن معدي كرب الكندي عن خالد بن معدان عن بحير بن سعد عن إسماعيل بن عياش الأحول عن سليمان بن عبد الرحمن التميمي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","خالد بن معدان عن المقدام"
"18810","633  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ،  ثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُحَمَّدٍ الْمُوَقَّرِيُّ ،  عَنْ  ثَوْرِ بْنِ يَزِيدَ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَا أَكَلَ أَحَدٌ مِنْ بَنِي آدَمَ طَعَامًا هُوَ خَيْرٌ لَهُ مِنْ أَنْ يَأْكُلَ مِنْ عَمَلِ يَدَيْهِ  - قَالَ نَبِيُّ اللهِ : - وَكَانَ  دَاوُدُ  عَلَيْهِ السَّلَامُ يَأْكُلُ مِنْ عَمَلِ يَدَيْهِ  .","","Al-Mu'jam al-Kabir 633","","المقدام بن معدي كرب الكندي عن خالد بن معدان عن ثور بن يزيد الكلاعي عن الوليد بن محمد الموقرى عن سويد بن سعيد الحدثاني عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","خالد بن معدان عن المقدام"
"18811","634  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ السَّمَيْدَعِ الْأَنْطَاكِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُبَارَكِ الصُّورِيُّ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  بَحِيرِ بْنِ سَعْدٍ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّكَ مَا أَطْعَمْتَ زَوْجَتَكَ فَهُوَ لَكَ صَدَقَةٌ  ، وَمَا أَطْعَمْتَ وَلَدَكَ فَهُوَ لَكَ صَدَقَةٌ ، وَمَا أَطْعَمْتَ خَادِمَكَ فَهُوَ لَكَ صَدَقَةٌ ، وَمَا أَطْعَمْتَ نَفْسَكَ فَهُوَ لَكَ صَدَقَةٌ  .","","Al-Mu'jam al-Kabir 634","","المقدام بن معدي كرب الكندي عن خالد بن معدان عن بحير بن سعد عن بقية بن الوليد عن محمد بن المبارك القلانسي عن الحسين بن السميدع البجلي عن الطبراني","خالد بن معدان عن المقدام"
"18812","635  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ، وَإِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ الْحِمْصِيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ،  ثَنَا  بَقِيَّةُ ،  عَنْ  بَحِيرِ بْنِ سَعْدٍ ،  عَنْ  خَالِدِ بْنِ         [20/269]      مَعْدَانَ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  حَسَنٌ  مِنِّي ،  وَحُسَيْنٌ  مِنْ  عَلِيٍّ  .","","Al-Mu'jam al-Kabir 635","","المقدام بن معدي كرب الكندي عن خالد بن معدان عن بحير بن سعد عن بقية بن الوليد عن محمد بن مصفى بن بهلول عن إبراهيم بن محمد بن عرق الحمصي عن الطبراني","خالد بن معدان عن المقدام"
"18813","636  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ الْحِمْصِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ،  ثَنَا  بَقِيَّةُ ،  عَنْ  بَحِيرِ بْنِ سَعْدٍ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ، قَالَ :  وَفَدَ الْمِقْدَامُ بْنُ مَعْدِيكَرِبَ ،  وَعَمْرُو بْنُ الْأَسْوَدِ  - رَجُلٌ مِنَ  الْأَسْدِ  مِنْ  أَهْلِ قِنَّسْرِينَ  مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى  مُعَاوِيَةَ  رَحِمَهُ اللهُ ، فَقَالَ  مُعَاوِيَةُ  لِلْمِقْدَامِ  : أَمَا عَلِمْتَ أَنَّ  الْحَسَنَ بْنَ عَلِيٍّ  تُوُفِّيَ ؟ قَالَ :  فَاسْتَرْجَعَ  الْمِقْدَامُ  ، فَقَالَ لَهُ  مُعَاوِيَةُ  : أَتَرَاهَا مُصِيبَةً ؟ قَالَ : وَلِمَ لَا أَرَاهَا مُصِيبَةً ؟ وَقَدْ وَضَعَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي حِجْرِهِ فَقَالَ :  هَذَا مِنِّي ،  وَحُسَيْنٌ  مِنْ  عَلِيٍّ  ، فَقَالَ  لِلْأَسْدِيِّ  : مَا تَقُولُ أَنْتَ ؟ فَقَالَ : جَمْرَةٌ أَطْفَأَهَا اللهُ ، فَقَالَ  الْمِقْدَامُ  : أَمَّا أَنَا فَلَا أَبْرَحُ حَتَّى أَغَيِظَكَ الْيَوْمَ وَأُسْمِعَكَ مَا تَكْرَهُ .  ثُمَّ قَالَ : إِنْ أَنَا صَدَقْتَ فَصَدِّقْنِي ، وَإِنْ أَنَا كَذَبْتُ فَكَذِّبْنِي ، فَقَالَ : أَفْعَلُ ، فَقَالَ :  أَنْشُدُكَ  اللهَ ، هَلْ سَمِعْتَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" يَنْهَى عَنْ لُبْسِ الذَّهَبِ ؟ "" قَالَ : نَعَمْ .  قَالَ :  وَأَنْشُدُكَ  بِاللهِ ، هَلْ تَعْلَمُ "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْ جُلُودِ  السِّبَاعِ  وَالرُّكُوبِ عَلَيْهَا ؟ "" قَالَ : نَعَمْ قَالَ : "" فَوَاللهِ لَقَدْ رَأَيْتُ هَذَا كُلَّهُ فِي بَيْتِكَ يَا  مُعَاوِيَةُ  "" ، فَقَالَ  مُعَاوِيَةُ  : "" قَدْ عَرَفْتُ أَنِّي لَنْ أَنْجُوَ مِنْهَا الْيَوْمَ يَا  مِقْدَامُ  "" ، قَالَ  خَالِدٌ  : وَأَمَرَ لَهُ  مُعَاوِيَةُ  بِمَالٍ ، وَلَمْ يَأْمُرْ لِصَاحِبِهِ ،  وَفَرَضَ  لِابْنِهِ ، قَالَ : فَفَرَّقَهَا  الْمِقْدَامُ  عَلَى أَصْحَابِهِ وَلَمْ يُعْطِ  الْأَسْدِيَّ  شَيْئًا مِمَّا أَخَذَ ، فَبَلَغَ ذَلِكَ  مُعَاوِيَةَ  ، فَقَالَ : "" أَمَّا  الْمِقْدَامُ  فَرَجُلٌ كَرِيمٌ بَسِيطٌ يَدَيْهِ ، وَأَمَّا  الْأَسْدِيُّ  فَرَجُلٌ حَسَنُ الْإِمْسَاكِ لِنَفْسِهِ "" .         [20/270]","","Al-Mu'jam al-Kabir 636","","المقدام بن معدي كرب الكندي عن خالد بن معدان عن بحير بن سعد عن بقية بن الوليد عن محمد بن مصفى بن بهلول عن إبراهيم بن محمد بن عرق الحمصي عن الطبراني","خالد بن معدان عن المقدام"
"18814","637  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  أَبِي  ، (  ح  )  وَحَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ ،  ثَنَا  حَيْوَةُ بْنُ شُرَيْحٍ ، (  ح  )  وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ قَالُوا :  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  بَحِيرِ بْنِ سَعْدٍ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  عَنْ  إِسْمَاعِيلَ بْنِ عَيَّاشٍ ،  عَنْ  بَحِيرِ بْنِ سَعْدٍ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ يُوصِيكُمْ بِآبَائِكُمْ ، إِنَّ اللهَ يُوصِيكُمْ بِأُمَّهَاتِكُمْ  ، إِنَّ اللهَ يُوصِيكُمْ بِالْأَقْرَبِ فَالْأَقْرَبِ  .","","Al-Mu'jam al-Kabir 637","","المقدام بن معدي كرب الكندي عن خالد بن معدان عن بحير بن سعد عن بقية بن الوليد عن حيوة المقرئ عن أبو زرعة الدمشقي عن الطبراني","خالد بن معدان عن المقدام"
"18815","638  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  يَحْيَى بْنُ حَمْزَةَ ،  حَدَّثَنِي  ثَوْرُ بْنُ يَزِيدَ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ "" اللهَ عَزَّ وَجَلَّ يُوصِيكُمْ بِأُمَّهَاتِكُمْ  - ثَلَاثَ مَرَّاتٍ - ، إِنَّ اللهَ يُوصِيكُمْ بِآبَائِكُمْ - مَرَّتَيْنِ - إِنَّ اللهَ يُوصِيكُمْ بِالْأَقْرَبِ فَالْأَقْرَبِ  .","","Al-Mu'jam al-Kabir 638","","المقدام بن معدي كرب الكندي عن خالد بن معدان عن ثور بن يزيد الكلاعي عن يحيى بن حمزة بن البتلهي عن هشام بن عمار عن الحسين بن إسحاق التستري عن الطبراني","خالد بن معدان عن المقدام"
"18816","639  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَمْزَةَ الدِّمَشْقِيُّ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ ثَوْرٍ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ يُوصِيكُمْ بِأُمَّهَاتِكُمْ  ، إِنَّ اللهَ يُوصِيكُمْ بِأُمَّهَاتِكُمْ ، إِنَّ اللهَ يُوصِيكُمْ بِآبَائِكُمْ ، إِنَّ اللهَ يُوصِيكُمْ بِالْأَقْرَبِ فَالْأَقْرَبِ  .         [20/271]","","Al-Mu'jam al-Kabir 639","","المقدام بن معدي كرب الكندي عن خالد بن معدان عن ثور بن يزيد الكلاعي عن يحيى بن حمزة بن البتلهي عن محمد بن يحيى بن حمزة الحضرمي عن أحمد بن محمد بن يحيى البتلهي عن الطبراني","خالد بن معدان عن المقدام"
"18817","640  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ عَلِيِّ بْنِ خَلَفٍ الدِّمَشْقِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  حَدَّثَتْنِي  أُمُّ عَبْدِ اللهِ بِنْتُ خَالِدِ بْنِ مَعْدَانَ ،  عَنْ  أَبِيهَا  ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ الْكِنْدِيِّ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ يُوصِيكُمْ بِأُمَّهَاتِكُمْ  ، إِنَّ اللهَ يُوصِيكُمْ بِأُمَّهَاتِكُمْ ، إِنَّ اللهَ يُوصِيكُمْ بِآبَائِكُمْ ، إِنَّ اللهَ يُوصِيكُمْ بِالْأَقْرَبِ فَالْأَقْرَبِ  .","","Al-Mu'jam al-Kabir 640","","المقدام بن معدي كرب الكندي عن خالد بن معدان عن عبدة بنت خالد بن معدان عن إسماعيل بن عياش الأحول عن سليمان بن عبد الرحمن التميمي عن الحسين بن علي بن خلف الدمشقي عن الطبراني","خالد بن معدان عن المقدام"
"18818","641  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  بَحِيرِ بْنِ سَعْدٍ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  عَلَيْكُمْ بِالسَّحُورِ فَإِنَّهُ الْغِذَاءُ الْمُبَارَكُ  .","","Al-Mu'jam al-Kabir 641","","المقدام بن معدي كرب الكندي عن خالد بن معدان عن بحير بن سعد عن بقية بن الوليد عن نعيم بن حماد الخزاعي عن يحيى بن عثمان بن صالح عن الطبراني","خالد بن معدان عن المقدام"
"18819","642  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ أَيُّوبَ بْنِ حَذْلَمٍ الدِّمَشْقِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  خَالِدُ بْنُ يَزِيدَ بْنِ أَبِي مَالِكٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ،  أَنَّهُ كَانَ غَازِيًا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَنَزَلُوا إِلَى جَانِبِ حَظَائِرِ يَهُودَ  بِخَيْبَرٍ  ، فَتَنَاوَلَ أَصْحَابُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْهَا ، فَانْطَلَقَتِ الْيَهُودُ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَشَكَوْا ذَلِكَ إِلَيْهِ ، فَبَعَثَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  خَالِدَ بْنَ الْوَلِيدِ  فَنَادَى : "" الصَّلَاةُ جَامِعَةٌ ، وَلَا يَدْخُلُ الْجَنَّةَ إِلَّا مُسْلِمٌ "" ، فَقَامَ فِينَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ثُمَّ قَالَ :  مَاذَا يَحِلُّ لَكُمْ مِنْ أَمْوَالِ الْمُعَاهِدِينَ لِغَيْرِ حَقِّهَا ؟  يَقُولُونَ : مَا وَجَدْنَا فِي كِتَابِ اللهِ مِنْ حَلَالٍ         [20/272]      أَحْلَلْنَاهُ ، وَمَا وَجَدْنَاهُ مِنْ حَرَامٍ حَرَّمْنَاهُ ، أَلَا وَإِنِّي أُحَرِّمُ أَمْوَالَ الْمُعَاهِدِينَ وَكُلَّ ذِي نَابٍ مِنَ  السِّبَاعِ  ، وَمَا سُخِّرَ مِنَ الدَّوَابِّ إِلَّا مَا سَمَّى اللهُ  .","","Al-Mu'jam al-Kabir 642","","المقدام بن معدي كرب الكندي عن خالد بن معدان عن يزيد بن عبد الرحمن بن أبي مالك عن خالد بن يزيد الهمداني عن سليمان بن عبد الرحمن التميمي عن سليمان بن أيوب بن سليمان بن داود الأسدي عن الطبراني","خالد بن معدان عن المقدام"
"18820","643  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ أَيُّوبَ بْنِ حَذْلَمٍ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  ثَوْرِ بْنِ يَزِيدَ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  كِيلُوا طَعَامَكُمْ يُبَارَكْ لَكُمْ فِيهِ  .","","Al-Mu'jam al-Kabir 643","","المقدام بن معدي كرب الكندي عن خالد بن معدان عن ثور بن يزيد الكلاعي عن الوليد بن مسلم القرشي عن سليمان بن عبد الرحمن التميمي عن سليمان بن أيوب بن سليمان بن داود الأسدي عن الطبراني","خالد بن معدان عن المقدام"
"18821","يَحْيَى بْنُ جَابِرٍ الطَّائِيُّ  ، عَنِ  الْمِقْدَامِ  644  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ ، وَأَحْمَدُ بْنُ زَيْدٍ الْحَوْطِيَّانِ ، قَالَا :  ثَنَا  أَبُو الْمُغِيرَةِ ،  ثَنَا  أَبُو سَلَمَةَ سُلَيْمَانُ بْنُ سُلَيْمٍ الْكَتَّانِيُّ  ،  حَدَّثَنِي         [20/273]      يَحْيَى بْنُ جَابِرٍ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ الْكِنْدِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مَلَأَ آدَمِيٌّ وِعَاءً شَرًّا مِنْ بَطْنٍ  ، حَسْبُ ابْنِ آدَمَ أُكُلَاتٌ يُقِمْنَ صُلْبَهُ ، فَإِنْ كَانَ لَا مَحَالَةَ فَثُلُثًا طَعَامًا ، وَثُلُثًا شَرَابًا ، وَثُلُثًا لِنَفَسِهِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( الكناني) .","","Al-Mu'jam al-Kabir 644","","المقدام بن معدي كرب الكندي عن يحيى بن جابر بن حسان عن سليمان بن سليم الكناني عن عبد القدوس بن الحجاج عن أحمد بن عبد الرحيم بن يزيد الحوطي عن الطبراني","يحيى بن جابر الطائي عن المقدام"
"18822","645  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  يَحْيَى بْنِ جَابِرٍ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا  وَعَى  ابْنُ آدَمَ وِعَاءً شَرًّا مِنْ بَطْنٍ  ، بِحَسْبِ الْمُسْلِمِ أُكُلَاتٌ يُقِمْنَ صُلْبَهُ ، فَإِنْ كَانَ لَا مَحَالَةَ فَثُلُثًا لِطَعَامِهِ ، وَثُلُثًا لِشَرَابِهِ ، وَثُلُثًا لِنَفَسِهِ  .","","Al-Mu'jam al-Kabir 645","","المقدام بن معدي كرب الكندي عن يحيى بن جابر بن حسان عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","يحيى بن جابر الطائي عن المقدام"
"18823","646  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ قِيرَاطٍ الدِّمَشْقِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  سُلَيْمَانَ بْنِ سُلَيْمٍ الْكِنَانِيِّ ، وَحَبِيبِ بْنِ         [20/274]      صَالِحٍ ،  عَنْ  يَحْيَى بْنِ جَابِرٍ الطَّائِيِّ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 646","","المقدام بن معدي كرب الكندي عن يحيى بن جابر بن حسان عن حبيب بن صالح الطائي عن إسماعيل بن عياش الأحول عن سليمان بن عبد الرحمن التميمي عن إسماعيل بن محمد بن عبيد الله العذري عن الطبراني","يحيى بن جابر الطائي عن المقدام"
"18824","647  -  حَدَّثَنَا  طَالِبُ بْنُ قُرَّةَ الْأَذَنِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عِيسَى الطَّبَّاعُ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  سُلَيْمَانَ بْنِ سُلَيْمٍ الْكِنَانِيِّ ،  عَنْ  يَحْيَى بْنِ جَابِرٍ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  تَعَوَّذُوا بِاللهِ مِنْ طَمَعٍ يَهْدِي إِلَى  طَبْعٍ  ، وَمِنْ طَمَعٍ يَهْدِي إِلَى غَيْرِ مَطْمَعٍ  .","","Al-Mu'jam al-Kabir 647","","المقدام بن معدي كرب الكندي عن يحيى بن جابر بن حسان عن سليمان بن سليم الكناني عن إسماعيل بن عياش الأحول عن ابن الطباع ، محمد بن عيسى بن نجيح البغدادي عن طالب بن قرة الأذني عن الطبراني","يحيى بن جابر الطائي عن المقدام"
"18825","648  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ الْحِمْصِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَا :  ثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ حَرْبٍ ،  عَنْ  سُلَيْمَانَ بْنِ سُلَيْمٍ ،  عَنْ  يَحْيَى بْنِ جَابِرٍ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَامَ فِي النَّاسِ فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ثُمَّ قَالَ :  إِنَّ اللهَ يُوصِيكُمْ بِالنِّسَاءِ خَيْرًا  ، إِنَّ اللهَ يُوصِيكُمْ بِالنِّسَاءِ خَيْرًا ، فَإِنَّهُنَّ أُمَّهَاتُكُمْ وَبَنَاتُكُمْ وَخَالَاتُكُمْ ، إِنَّ الرَّجُلَ مِنْ أَهْلِ الْكِتَابِ يَتَزَوَّجُ الْمَرْأَةَ وَمَا  تُعَلِّقُ  يَدَاهَا الْخَيْطَ ، فَمَا يَرْغَبُ وَاحِدٌ مِنْهُمَا عَنْ صَاحِبِهِ  .","","Al-Mu'jam al-Kabir 648","","المقدام بن معدي كرب الكندي عن يحيى بن جابر بن حسان عن سليمان بن سليم الكناني عن محمد بن حرب الأبرش عن داود بن رشيد الخوارزمي عن الحسين بن إسحاق التستري عن الطبراني","يحيى بن جابر الطائي عن المقدام"
"18826","الْحَسَنُ بْنُ جَابِرٍ  ، عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ  649  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُعَاوِيَةُ         [20/275]      بْنُ صَالِحٍ ،  ثَنَا  الْحَسَنُ بْنُ جَابِرٍ ،  أَنَّهُ سَمِعَ  الْمِقْدَامَ بْنَ مَعْدِيكَرِبَ ، يَقُولُ :  حَرَّمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَشْيَاءَ  يَوْمَ خَيْبَرٍ  مِنْهَا : الْحُمُرُ  الْأَهْلِيَّةُ  وَغَيْرُهَا "" .  قَالَ :  وَيُوشِكُ  مُتَّكِئٌ عَلَى  أَرِيكَتِهِ  يُحَدَّثُ بِحَدِيثِي  فَيَقُولُ : بَيْنَنَا وَبَيْنَكُمْ كِتَابُ اللهِ ، فَمَا وَجَدْنَا فِيهِ مِنْ حَلَالٍ أَحْلَلْنَاهُ ، وَمِنْ حَرَامٍ حَرَّمْنَاهُ ، أَلَا وَإِنَّ مَا حَرَّمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلُ مَا حَرَّمَ اللهُ عَزَّ وَجَلَّ  .","","Al-Mu'jam al-Kabir 649","","المقدام بن معدي كرب الكندي عن الحسن بن جابر اللخمي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","الحسن بن جابر عن المقدام بن معدي كرب"
"18827","650  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  عَنْ  مُعَاوِيَةَ بْنِ صَالِحٍ ،  عَنِ  الْحَسَنِ بْنِ جَابِرٍ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَرَّمَ أَشْيَاءَ حَتَّى ذَكَرَ الْحُمُرَ  الْأَهْلِيَّةَ  .","","Al-Mu'jam al-Kabir 650","","المقدام بن معدي كرب الكندي عن الحسن بن جابر اللخمي عن معاوية بن صالح بن حدير الحضرمي عن زيد بن الحباب العكلي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","الحسن بن جابر عن المقدام بن معدي كرب"
"18828","شُرَيْحُ بْنُ عُبَيْدٍ الْحَضْرَمِيُّ  ، عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ  651  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ السَّمَيْدَعِ الْأَنْطَاكِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُبَارَكِ الصُّورِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  ضَمْضَمِ بْنِ زُرْعَةَ ،  عَنْ  شُرَيْحِ بْنِ عُبَيْدٍ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، وَأَبِي أُمَامَةَ ، قَالَا : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْإِمَامُ إِذَا ابْتَغَى  الرِّيبَةَ  فِي النَّاسِ أَفْسَدَهُمْ  .","","Al-Mu'jam al-Kabir 651","","أبو أمامة الباهلي عن شريح بن عبيد المقرائي عن ضمضم بن زرعة الحضرمي عن إسماعيل بن عياش الأحول عن محمد بن المبارك القلانسي عن الحسين بن السميدع البجلي عن الطبراني","شريح بن عبيد الحضرمي عن المقدام بن معدي كرب"
"18829","652  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ الطَّبَرَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ         [20/276]      إِسْمَاعِيلَ بْنِ عَيَّاشٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  ضَمْضَمِ بْنِ زُرْعَةَ ،  عَنْ  شُرَيْحِ بْنِ عُبَيْدٍ ،  عَنِ  الْمِقْدَامِ ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا يَكُونُ رَجُلٌ عَلَى قَوْمٍ إِلَّا جَاءَ يَقْدُمُهُمْ يَوْمَ الْقِيَامَةِ بَيْنَ يَدَيْهِ رَايَةٌ يَحْمِلُهَا  ، وَهُمْ يَتَّبِعُونَهُ فَيُسْأَلُ عَنْهُمْ وَيُسْأَلُونَ عَنْهُ  .","","Al-Mu'jam al-Kabir 652","","المقدام بن معدي كرب الكندي عن شريح بن عبيد المقرائي عن ضمضم بن زرعة الحضرمي عن إسماعيل بن عياش الأحول عن محمد بن إسماعيل بن عياش العنسي عن هاشم بن مرثد الطيالسي عن الطبراني","شريح بن عبيد الحضرمي عن المقدام بن معدي كرب"
"18830","653  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ الطَّبَرَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ عَيَّاشٍ ،  حَدَّثَنِي  أَبِي  ، عَنْ  ضَمْضَمِ بْنِ زُرْعَةَ ،  عَنْ  شُرَيْحِ بْنِ عُبَيْدٍ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، وَأَبِي أُمَامَةَ الْبَاهِلِيِّ ،  أَنَّ  رَجُلًا  أَتَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، إِنَّ هَذَا الْأَمْرَ فِي قَوْمِكَ فَأَوْصِهِمْ بِنَا ، فَقَالَ لَهُمْ :  أُذَكِّرُكُمُ اللهَ لَا تَبْغُوا عَلَى أُمَّتِي مِنْ بَعْدِي  ، ثُمَّ قَالَ لِلنَّاسِ : "" سَيَكُونُ مِنْ بَعْدِي أُمَرَاءُ ، فَأَدُّوا طَاعَتَهُمْ ، فَإِنَّ الْأَمِيرَ مِثْلُ  الْمِجَنِّ  يُتَّقَى بِهِ ، فَإِنْ أَصْلَحُوا وَأَمَرُوكُمْ بِخَيْرٍ فَلَكُمْ وَلَهُمْ ، وَإِنْ أَسَاؤُوا فِيمَا أَمَرُوكُمْ فَهُوَ عَلَيْهِمْ وَأَنْتُمْ مِنْهُ بَرَاءٌ ، إِنَّ الْأَمِيرَ إِذَا اتَّبَعَ  الرِّيبَةَ  فِي النَّاسِ أَفْسَدَهُمْ  .","","Al-Mu'jam al-Kabir 653","","المقدام بن معدي كرب الكندي عن شريح بن عبيد المقرائي عن ضمضم بن زرعة الحضرمي عن إسماعيل بن عياش الأحول عن محمد بن إسماعيل بن عياش العنسي عن هاشم بن مرثد الطيالسي عن الطبراني","شريح بن عبيد الحضرمي عن المقدام بن معدي كرب"
"18831","عَبْدُ الرَّحْمَنِ بْنُ مَيْسَرَةَ  ، عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ  654  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ ، وَأَبُو زَيْدٍ الْحَوْطِيَّانِ قَالَا :  ثَنَا  أَبُو الْمُغِيرَةِ ،  ثَنَا  حَرِيزُ بْنُ عُثْمَانَ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ         [20/277]      مَيْسَرَةَ ، قَالَ :  سَمِعْتُ  الْمِقْدَامَ بْنَ مَعْدِيكَرِبَ يَقُولُ :  أُتِيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِوَضُوءٍ فَتَوَضَّأَ  ، فَغَسَلَ كَفَّيْهِ ثَلَاثًا ، ثُمَّ غَسَلَ وَجْهَهُ ثَلَاثًا ، ثُمَّ غَسَلَ ذِرَاعَيْهِ ثَلَاثًا فَمَضْمَضَ ، وَاسْتَنْشَقَ ثَلَاثًا ثَلَاثًا ، ثُمَّ مَسَحَ بِرَأْسِهِ وَأُذُنَيْهِ : ظَاهِرِهِمَا وَبَاطِنِهِمَا ، وَغَسَلَ رِجْلَيْهِ ثَلَاثًا ثَلَاثًا  .","","Al-Mu'jam al-Kabir 654","","المقدام بن معدي كرب الكندي عن عبد الرحمن بن ميسرة الحمصي عن حريز بن عثمان الرحبي عن عبد القدوس بن الحجاج عن أحمد بن عبد الرحيم بن يزيد الحوطي عن الطبراني","عبد الرحمن بن ميسرة عن المقدام بن معدي كرب"
"18832","655  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ الطَّبَرَانِيُّ ،  ثَنَا  صَفْوَانُ بْنُ صَالِحٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  حَرِيزُ بْنُ عُثْمَانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ مَيْسَرَةَ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 655","","المقدام بن معدي كرب الكندي عن عبد الرحمن بن ميسرة الحمصي عن حريز بن عثمان الرحبي عن الوليد بن مسلم القرشي عن صفوان بن صالح الدمشقي عن هاشم بن مرثد الطيالسي عن الطبراني","عبد الرحمن بن ميسرة عن المقدام بن معدي كرب"
"18833","656  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  يَعْقُوبُ بْنُ كَعْبٍ الْحَلَبِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  حَرِيزِ بْنِ عُثْمَانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ مَيْسَرَةَ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ  ، فَلَمَّا بَلَغَ مَسْحَ رَأْسِهِ وَضَعَ كَفَّيْهِ عَلَى مُقَدَّمِ رَأْسِهِ ، ثُمَّ أَمَرَّهُمَا حَتَّى بَلَغَ الْقَفَا ، ثُمَّ رَدَّهُمَا إِلَى الْمَكَانِ الَّذِي مِنْهُ بَدَأَ  .","","Al-Mu'jam al-Kabir 656","","المقدام بن معدي كرب الكندي عن عبد الرحمن بن ميسرة الحمصي عن حريز بن عثمان الرحبي عن الوليد بن مسلم القرشي عن يعقوب بن كعب الأنطاكي عن يحيى بن عثمان بن صالح عن الطبراني","عبد الرحمن بن ميسرة عن المقدام بن معدي كرب"
"18834","657  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ ،  ثَنَا  عَمْرُو بْنُ عُثْمَانَ ،  ثَنَا  أَبِي  ،  ثَنَا  حَرِيزُ بْنُ عُثْمَانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ مَيْسَرَةَ ،  قَالَ  :  مَرَّ بِالْمِقْدَامِ رَجُلٌ فَقَالَ : أَفْلَحَتْ هَاتَانِ الْعَيْنَانِ اللَّتَانِ رَأَتَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَاجْتَمَعَ  الْمِقْدَامُ  غَضَبًا ، وَقَالَ :  يَا أَيُّهَا النَّاسُ ، لَا تَمَنَّوْا أَمْرًا غَيَّبَهُ اللهُ عَنْكُمْ  "" .         [20/278]","","Al-Mu'jam al-Kabir 657","","المقدام بن معدي كرب الكندي عن عبد الرحمن بن ميسرة الحمصي عن حريز بن عثمان الرحبي عن عثمان بن سعيد بن كثير عن عمرو بن عثمان بن سعيد الحمصي عن إبراهيم بن محمد بن عرق الحمصي عن الطبراني","عبد الرحمن بن ميسرة عن المقدام بن معدي كرب"
"18835","حَبِيبُ بْنُ عُبَيْدٍ الرَّحَبِيُّ  ، عَنِ  الْمِقْدَامِ  658  -  حَدَّثَنَا  عَمْرُو بْنُ إِسْحَاقَ بْنِ زِبْرِيقٍ الْحِمْصِيُّ ،  ثَنَا  أَبِي  ، (  ح  )  وَحَدَّثَنَا  عُمَارَةُ بْنُ وَثِيمَةَ الْمِصْرِيُّ ، وَعَبْدُ الرَّحْمَنِ بْنُ مُعَاوِيَةَ الْعُتْبِيُّ ، قَالَا :  ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ زِبْرِيقٍ الْحِمْصِيُّ ،  ثَنَا  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ سَالِمٍ ،  عَنِ  الزُّبَيْدِيِّ ،  حَدَّثَنِي  الْفُضَيْلُ بْنُ فَضَالَةَ ، أَنَّ حَبِيبَ بْنَ عُبَيْدٍ  حَدَّثَهُ  ، أَنَّ الْمِقْدَامَ  حَدَّثَهُمْ  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَطِيعُوا أُمَرَاءَكُمْ مَهْمَا كَانَ  ، فَإِنْ أَمَرُوكُمْ بِشَيْءٍ مِمَّا جِئْتُكُمْ بِهِ فَإِنَّهُمْ يُؤْجَرُونَ عَلَيْهِ وَتُؤْجَرُونَ بِطَاعَتِهِمْ ، وَإِنْ أَمَرُوكُمْ بِشَيْءٍ مِمَّا لَمْ آتِكُمْ بِهِ فَإِنَّهُ عَلَيْهِمْ وَأَنْتُمْ مِنْهُ بَرَاءٌ ، ذَلِكَ بِأَنَّكُمْ إِذَا لَقِيتُمُ اللهَ قُلْتُمْ : رَبَّنَا ، لَا ظُلْمَ ، فَيَقُولُ : لَا ظُلْمَ ، فَتَقُولُونَ : رَبَّنَا ، أَرْسَلْتَ إِلَيْنَا رُسُلًا فَأَطَعْنَاهُمْ بِإِذْنِكَ ، وَاسْتَخْلَفْتَ عَلَيْنَا خُلَفَاءَ فَأَطَعْنَاهُمْ بِإِذْنِكَ ، وَأَمَّرْتَ عَلَيْنَا أُمَرَاءَ فَأَطَعْنَاهُمْ لَكَ ، فَيَقُولُ : صَدَقْتُمْ هُوَ عَلَيْهِمْ ، وَأَنْتُمْ مِنْهُ بَرَاءٌ  .","","Al-Mu'jam al-Kabir 658","","المقدام بن معدي كرب الكندي عن حبيب بن عبيد الرحبي عن فضيل بن فضالة الهوزني عن محمد بن الوليد بن عامر الزبيدي عن عبد الله بن سالم الوحاظي عن عمرو بن الحارث الزبيدي عن إسحاق بن إبراهيم بن العلاء عن عمرو بن إسحاق بن إبراهيم الزبيدي عن الطبراني","حبيب بن عبيد الرحبي عن المقدام"
"18836","659  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عِرْقٍ الْيَحْصَبِيُّ الْحِمْصِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  أَبِي بَكْرِ بْنِ أَبِي         [20/279]      مَرْيَمَ ،  عَنْ  حَبِيبِ بْنِ عُبَيْدٍ ،  عَنِ  الْمِقْدَامِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يَأْتِي عَلَى النَّاسِ زَمَانٌ ، مَنْ لَمْ يَكُنْ مَعَهُ أَصْفَرُ وَلَا أَبْيَضُ  لَمْ يَتَهَنَّ بِالْعَيْشِ  .","","Al-Mu'jam al-Kabir 659","","المقدام بن معدي كرب الكندي عن حبيب بن عبيد الرحبي عن أبو بكر الغساني عن بقية بن الوليد عن محمد بن الحارث بن محمد ابن عرق عن أحمد بن محمد بن الحارث اليحصبي عن الطبراني","حبيب بن عبيد الرحبي عن المقدام"
"18837","660  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ أَحْمَدَ الْوَكِيعِيُّ ،  ثَنَا  بَكْرُ بْنُ مُحَمَّدٍ الْقُرَشِيُّ ،  ثَنَا  بَقِيَّةُ ،  ثَنَا  عَبْدُ الْجَبَّارِ الزُّبَيْدِيُّ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي مَرْيَمَ ،  عَنْ  حَبِيبِ بْنِ عُبَيْدٍ ،  قَالَ  :  رَأَيْتُ الْمِقْدَامَ بْنَ مَعْدِيكَرِبَ جَالِسًا فِي السُّوقِ ، وَجَارِيَةٌ لَهُ تَبِيعُ لَبَنًا وَهُوَ جَالِسٌ يَأْخُذُ الدَّرَاهِمَ ، فَقِيلَ لَهُ فِي ذَلِكَ ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِذَا كَانَ فِي آخِرِ الزَّمَانِ لَا بُدَّ لِلنَّاسِ فِيهَا مِنَ الدَّرَاهِمِ وَالدَّنَانِيرِ  يُقِيمُ الرَّجُلُ بِهَا دِينَهُ وَدُنْيَاهُ  .","","Al-Mu'jam al-Kabir 660","","المقدام بن معدي كرب الكندي عن حبيب بن عبيد الرحبي عن أبو بكر الغساني عن عبد الجبار بن سليم الفوزي عن بقية بن الوليد عن بكر بن محمد القرشي عن إبراهيم بن أحمد بن عمر الوكيعي عن الطبراني","حبيب بن عبيد الرحبي عن المقدام"
"18838","661  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  ثَوْرِ بْنِ يَزِيدَ ،  حَدَّثَنِي  حَبِيبُ بْنُ عُبَيْدٍ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ الْكِنْدِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا أَحَبَّ أَحَدُكُمْ أَخَاهُ فَلْيُعْلِمْهُ ذَاكَ  .","","Al-Mu'jam al-Kabir 661","","المقدام بن معدي كرب الكندي عن حبيب بن عبيد الرحبي عن ثور بن يزيد الكلاعي عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","حبيب بن عبيد الرحبي عن المقدام"
"18839","662  -  حَدَّثَنَا  الْحَسَنُ بْنُ الْعَبَّاسِ الرَّازِيُّ ،  ثَنَا  عَلِيُّ بْنُ مَيْسَرَةَ         [20/280]      الرَّازِيُّ ،  ثَنَا  حَسَّانُ بْنُ حَسَّانَ ،  عَنْ  حَرِيزِ بْنِ عُثْمَانَ ،  عَنْ  حَبِيبِ بْنِ عُبَيْدٍ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا مَلَأَ أَحَدٌ وِعَاءً شَرًّا مِنْ بَطْنٍ  ، فَإِنْ غَلَبَتْهُ نَفْسُهُ فَلْيَدَعْ ثُلُثًا لِنَفَسِهِ  .","","Al-Mu'jam al-Kabir 662","","المقدام بن معدي كرب الكندي عن حبيب بن عبيد الرحبي عن حريز بن عثمان الرحبي عن حسان بن حسان الواسطي عن علي بن أبي عيسى عن الجمال الحسن بن العباس عن الطبراني","حبيب بن عبيد الرحبي عن المقدام"
"18840","سَلِيمُ بْنُ عَامِرٍ الْخَبَائِرِيُّ  ، عَنْهُ  663  -  حَدَّثَنَا  عَمْرُو بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ بْنِ الْعَلَاءِ ،  حَدَّثَنِي  أَبِي  ، (  ح  )  وَحَدَّثَنَا  عُمَارَةُ بْنُ وَثِيمَةَ الْمِصْرِيُّ ، وَعَبْدُ الرَّحْمَنِ بْنُ مُعَاوِيَةَ الْعُتْبِيُّ قَالَا :  ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ زِبْرِيقٍ الْحِمْصِيُّ ،  ثَنَا  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ سَالِمٍ ،  عَنِ  الزُّبَيْدِيِّ ،  ثَنَا  سَلِيمُ بْنُ عَامِرٍ ، أَنَّ الْمِقْدَامَ بْنَ مَعْدِيكَرِبَ  حَدَّثَهُمْ  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا مِنْ أَحَدٍ يَمُوتُ  سِقْطًا  وَلَا هَرِمًا  - وَإِنَّمَا النَّاسُ فِيمَا بَيْنَ ذَلِكَ - إِلَّا بُعِثَ ابْنَ ثَلَاثِينَ سَنَةً ، فَمَنْ كَانَ مِنْ أَهْلِ الْجَنَّةِ كَانَ عَلَى مَسْحَةِ  آدَمَ  ، وَصُورَةِ  يُوسُفَ  ، وَقَلْبِ  أَيُّوبَ  ، وَمَنْ كَانَ مِنْ أَهْلِ النَّارِ عُظِّمُوا وَفُخِّمُوا كَالْجِبَالِ  .","","Al-Mu'jam al-Kabir 663","","المقدام بن معدي كرب الكندي عن سليم بن عامر الخبائري عن محمد بن الوليد بن عامر الزبيدي عن عبد الله بن سالم الوحاظي عن عمرو بن الحارث الزبيدي عن إسحاق بن إبراهيم بن العلاء عن عبد الرحمن بن معاوية العتبي عن الطبراني","سليم بن عامر الخبائري عنه"
"18841","664  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  أَيُّوبُ بْنُ مُحَمَّدٍ الْوَزَّانُ الرَّقِّيُّ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْبَزَّارُ الْأَصْبَهَانِيُّ ،  ثَنَا  دَاوُدُ بْنُ رُشَيْدٍ قَالَا :  ثَنَا         [20/281]      مَرْوَانُ بْنُ مُعَاوِيَةَ ،  ثَنَا  يَزِيدُ بْنُ سِنَانٍ ،  ثَنَا  أَبُو يَحْيَى سَلِيمُ بْنُ عَامِرٍ الْكَلَاعِيُّ ،  قَالَ  :  قُلْنَا لِلْمِقْدَامِ بْنِ مَعْدِيكَرِبَ الْكِنْدِيِّ : يَا  أَبَا كَرِيمَةَ  ، إِنَّ النَّاسَ يَدَّعُونَ أَنَّكَ لَمْ تَرَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : بَلَى وَاللهِ ، لَقَدْ رَأَيْتُهُ ، وَلَقَدْ أَخَذَ  بِشَحْمَةِ  أُذُنِي هَذِهِ وَإِنِّي لَأَمْشِي مَعَ عَمٍّ لِي ، ثُمَّ قَالَ لِعَمِّي : "" أَتَرَى أَنَّهُ يَذْكُرُهُ "" ؟ قُلْنَا : يَا  أَبَا كَرِيمَةَ  حَدِّثْنَا مَا سَمِعْتَ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : سَمِعْتُهُ يَقُولُ :  يُحْشَرُ مَا بَيْنَ  السِّقْطِ  إِلَى الشَّيْخِ الْفَانِي يَوْمَ الْقِيَامَةِ فِي خَلْقِ  آدَمَ  ، وَقَلْبِ  أَيُّوبَ  ، وَحُسْنِ  يُوسُفَ ،  مُرْدًا مُكَحَّلِينَ "" . قُلْنَا : يَا رَسُولَ اللهِ ، فَكَيْفَ بِالْكَافِرِ ؟ قَالَ : "" يُعَظَّمُ لِلنَّارِ حَتَّى يَصِيرَ غِلَظُ جِلْدِهِ أَرْبَعِينَ ذِرَاعًا ، وَقَرِيضَةُ النَّابِ مِنْ أَسْنَانِهِ مِثْلُ أُحُدٍ  .","","Al-Mu'jam al-Kabir 664","","المقدام بن معدي كرب الكندي عن سليم بن عامر الخبائري عن يزيد بن سنان الرهاوي عن مروان بن معاوية الفزاري عن داود بن رشيد الخوارزمي عن أحمد بن محمد البزاز عن الطبراني","سليم بن عامر الخبائري عنه"
"18842","665  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ سَعْدٍ الرَّقِّيُّ ،  ثَنَا  أَبُو فَرْوَةَ يَزِيدُ بْنُ مُحَمَّدِ بْنِ سِنَانٍ ،  ثَنَا  أَبِي ،  عَنْ  أَبِيهِ  ،  ثَنَا  أَبُو يَحْيَى الْكَلَاعِيُّ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْلَةُ الضَّيْفِ  حَقٌّ  وَاجِبٌ  ، فَإِنْ أَصْبَحَ مَحْرُومًا بِفِنَائِهِ وَجَبَتْ نُصْرَتُهُ عَلَى الْمُسْلِمِينَ حَتَّى يَأْخُذُوا لَهُ بِحَقِّهِ مِنْ زَرْعِهِ وَضَرْعِهِ ، لِمَا حُرِمَهُ مِنْ حَقِّ الضِّيَافَةِ  .","","Al-Mu'jam al-Kabir 665","","المقدام بن معدي كرب الكندي عن سليم بن عامر الخبائري عن يزيد بن سنان الرهاوي عن محمد بن يزيد بن سنان بن يزيد الرهاوي عن يزيد بن محمد ابن يزيد الرهاوي عن عبد الله بن سعد بن يحيى الكريزي عن الطبراني","سليم بن عامر الخبائري عنه"
"18843","666  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ الْحِمْصِيُّ ،  ثَنَا  عَمْرُو بْنُ عُثْمَانَ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  ثَنَا  عُمَرُ بْنُ خَثْعَمَ ،  حَدَّثَنِي  سَلِيمُ بْنُ عَامِرٍ ،  عَنِ  الْمِقْدَامِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  تَدْنُو الشَّمْسُ مِنَ         [20/282]      النَّاسِ يَوْمَ الْقِيَامَةِ حَتَّى تَكُونَ مِنَ النَّاسِ عَلَى قَدْرِ مِيلَيْنِ  ، وَيَزْدَادَ فِي حَرِّهَا فَتَصْحَرَهُمْ فَيَكُونُوا فِي الْعَرَقِ بِقَدْرِ أَعْمَالِهِمْ ، فَمِنْهُمْ مَنْ يَأْخُذُهُ الْعَرَقُ إِلَى كَعْبَيْهِ ، وَمِنْهُمْ مَنْ يَأْخُذُهُ إِلَى رُكْبَتَيْهِ ، وَمِنْهُمْ مَنْ يَأْخُذُهُ إِلَى حِقْوَيْهِ ، وَمِنْهُمْ مَنْ  يُلْجِمُهُ  الْعَرَقُ إِلْجَامًا "" قَالَ : وَرَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُشِيرُ بِيَدَيْهِ إِلَى فِيهِ  .  قَالَ  إِبْرَاهِيمُ بْنُ عِرْقٍ  : هَكَذَا رَوَاهُ  عُمَرُ بْنُ خَثْعَمَ  ، عَنْ  سُلَيْمٍ  ، عَنِ  الْمِقْدَامِ  .","","Al-Mu'jam al-Kabir 666","","المقدام بن معدي كرب الكندي عن سليم بن عامر الخبائري عن عمر بن جعثم اليحصبي عن بقية بن الوليد عن عمرو بن عثمان بن سعيد الحمصي عن إبراهيم بن محمد بن عرق الحمصي عن الطبراني","سليم بن عامر الخبائري عنه"
"18844","عَبْدُ الرَّحْمَنِ بْنُ أَبِي عَوْفٍ الْجُرَشِيُّ  ، عَنِ  الْمِقْدَامِ  667  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَمْزَةَ الدِّمَشْقِيُّ ،  ثَنَا  حَيْوَةُ بْنُ شُرَيْحٍ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنِ  الزُّبَيْدِيِّ ، (  ح  )  وَحَدَّثَنَا  طَالِبُ بْنُ قُرَّةَ الْأَذَنِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عِيسَى الطَّبَّاعُ ،  ثَنَا  الْقَاسِمُ بْنُ مُوسَى ،  عَنْ  مُحَمَّدِ بْنِ الْوَلِيدِ الزُّبَيْدِيِّ ،  حَدَّثَنِي  مَرْوَانُ بْنُ رُؤْبَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي عَوْفٍ الْجُرَشِيِّ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَيُّمَا رَجُلٍ ضَافَ قَوْمًا فَلَمْ يَقْرُوهُ ، فَإِنَّ لَهُ أَنْ يَطْلُبَهُمْ بِمِثْلِ قِرَاهُ  .","","Al-Mu'jam al-Kabir 667","","المقدام بن معدي كرب الكندي عن عبد الرحمن بن أبي عوف الجرشي عن مروان بن رؤبة التغلبي عن محمد بن الوليد بن عامر الزبيدي عن القاسم بن موسى عن ابن الطباع ، محمد بن عيسى بن نجيح البغدادي عن طالب بن قرة الأذني عن الطبراني","عبد الرحمن بن أبي عوف الجرشي عن المقدام"
"18845","668  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  عُثْمَانُ بْنُ سَعِيدِ بْنِ كَثِيرِ بْنِ دِينَارٍ ،  عَنْ  حَرِيزِ بْنِ عُثْمَانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي عَوْفٍ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ نَزَلَ بِقَوْمٍ فَعَلَيْهِمْ أَنْ يَقْرُوهُ  ، فَإِنْ لَمْ يَقْرُوهُ فَإِنَّ لَهُ أَنْ يُعَاقِبَهُمْ بِمِثْلِ قِرَاهُ  .         [20/283]","","Al-Mu'jam al-Kabir 668","","المقدام بن معدي كرب الكندي عن عبد الرحمن بن أبي عوف الجرشي عن حريز بن عثمان الرحبي عن عثمان بن سعيد بن كثير عن نعيم بن حماد الخزاعي عن يحيى بن عثمان بن صالح عن الطبراني","عبد الرحمن بن أبي عوف الجرشي عن المقدام"
"18846","669  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَا :  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  يَحْيَى بْنُ حَمْزَةَ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ الْوَلِيدِ الزُّبَيْدِيُّ ،  عَنْ  عَمْرِو بْنِ رُؤْبَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي عَوْفٍ الْجُرَشِيِّ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أُوتِيتُ الْكِتَابَ وَمَا يَعْدِلُهُ  ،  يُوشِكُ  شَبْعَانُ عَلَى  أَرِيكَتِهِ  يَقُولُ : بَيْنَنَا وَبَيْنَكُمْ هَذَا الْكِتَابُ ، فَمَا كَانَ فِيهِ مِنْ حَلَالٍ أَحْلَلْنَاهُ ، وَمَا كَانَ فِيهِ مِنْ حَرَامٍ حَرَّمْنَاهُ ، أَلَا وَإِنَّهُ لَيْسَ كَذَلِكَ ، لَا يَحِلُّ ذُو نَابٍ مِنَ  السِّبَاعِ  ، وَلَا الْحُمُرُ  الْأَهْلِيَّةُ  ، وَلَا اللُّقَطَةُ مِنَ الْمُعَاهِدِ إِلَّا أَنْ يَسْتَغْنِيَ عَنْهَا ، وَأَيُّمَا رَجُلٍ ضَافَ قَوْمًا وَلَمْ يَقْرُوهُ فَعَلَيْهِ أَنْ يَغْصِبَهُمْ بِمِثْلِ قِرَاهُ  .","","Al-Mu'jam al-Kabir 669","","المقدام بن معدي كرب الكندي عن عبد الرحمن بن أبي عوف الجرشي عن عمر بن رؤبة التغلبي عن محمد بن الوليد بن عامر الزبيدي عن يحيى بن حمزة بن البتلهي عن هشام بن عمار عن الحسين بن إسحاق التستري عن الطبراني","عبد الرحمن بن أبي عوف الجرشي عن المقدام"
"18847","670  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ ،  ثَنَا  عَلِيُّ بْنُ عَيَّاشٍ الْحِمْصِيُّ ، (  ح  )  وَحَدَّثَنَا  أَبُو زَيْدٍ أَحْمَدُ بْنُ عَبْدِ الرَّحِيمِ بْنِ زَيْدٍ الْحَوْطِيُّ ،  ثَنَا  أَبُو الْيَمَانِ الْحَكَمُ بْنُ نَافِعٍ ، قَالَا :  ثَنَا  حَرِيزُ بْنُ عُثْمَانَ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عَلِيُّ بْنُ بَحْرٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  حَرِيزُ بْنُ عُثْمَانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي عَوْفٍ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أُوتِيتُ الْكِتَابَ  وَمِثْلَهُ  ، أَلَا  يُوشِكُ  شَبْعَانُ عَلَى  أَرِيكَتِهِ  يَقُولُ : عَلَيْكُمْ بِالْقُرْآنِ  ، فَمَا وَجَدْتُمْ فِيهِ مِنْ حَلَالٍ فَأَحِلُّوهُ ، وَمَا وَجَدْتُمْ فِيهِ مِنْ حَرَامٍ فَحَرِّمُوهُ ، أَلَا لَا يَحِلُّ لَكُمُ الْحِمَارُ الْأَهْلِيُّ ،         [20/284]      وَلَا كُلُّ ذِي نَابٍ مِنَ  السِّبَاعِ  ، وَلَا لُقَطَةُ مُعَاهَدٍ إِلَّا أَنْ يَسْتَغْنِيَ عَنْهَا صَاحِبُهَا ، وَمَنْ نَزَلَ بِقَوْمٍ فَعَلَيْهِمْ أَنْ يَقْرُوهُ  .","","Al-Mu'jam al-Kabir 670","","المقدام بن معدي كرب الكندي عن عبد الرحمن بن أبي عوف الجرشي عن حريز بن عثمان الرحبي عن الوليد بن مسلم القرشي عن علي بن بحر بن بري القطان عن الحسين بن إسحاق التستري عن الطبراني","عبد الرحمن بن أبي عوف الجرشي عن المقدام"
"18848","رَاشِدُ بْنُ سَعْدٍ  ، عَنِ  الْمِقْدَامِ  671  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  مَسْلَمَةُ بْنُ عُلَيٍّ ،  ثَنَا  الزُّبَيْدِيُّ ،  عَنْ  رَاشِدِ بْنِ سَعْدٍ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِيكَرِبَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّكُمْ سَتَفْتَحُونَ آفَاقًا فِيهَا بُيُوتٌ يُقَالُ لَهَا الْحَمَّامَاتُ  ، حَرَامٌ عَلَى أُمَّتِي دُخُولُهَا "" ، فَقَالُوا : يَا رَسُولَ اللهِ ، إِنَّهَا تُذْهِبُ الْوَصَبَ ، وَتُنَقِّي  الدَّرَنَ  ، قَالَ : "" فَإِنَّهَا حَلَالٌ لِذُكُورِ أُمَّتِي فِي الْأُزُرِ ، حَرَامٌ عَلَى إِنَاثِ أُمَّتِي  .","","Al-Mu'jam al-Kabir 671","","المقدام بن معدي كرب الكندي عن راشد بن سعد المقرائي عن محمد بن الوليد بن عامر الزبيدي عن مسلمة بن علي بن خلف الخشني عن هشام بن عمار عن أحمد بن المعلى الأسدي عن الطبراني","راشد بن سعد عن المقدام"
"18849","مَنِ اسْمُهُ مُطَّلِبٌ  مُطَّلِبُ بْنُ رَبِيعَةَ بْنِ الْحَارِثِ بْنِ عَبْدِ الْمُطَّلِبِ بْنِ هِشَامِ بْنِ عَبْدِ مَنَافٍ "" وَيُقَالُ : عَبْدُ الْمُطَّلِبِ ، وَالصَّوَابُ : الْمُطَّلِبُ  ، وَمَاتَ  بِدِمَشْقَ  ، وَكَانَ يَسْكُنُ بِهَا ، فَتُوُفِّيَ سَنَةَ إِحْدَى وَسِتِّينَ "" .  672  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سُوَيْدٍ الشِّبَامِيُّ ،  ثَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  الثَّوْرِيُّ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنِ  الْمُطَّلِبِ بْنِ أَبِي         [20/285]      وَدَاعَةَ ، (  ح  )  وَحَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  أَبِي عَلِيُّ بْنُ عَاصِمٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنِ  الْمُطَّلِبِ بْنِ رَبِيعَةَ ، قَالَ :  كُنْتُ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَدَخَلَ عَلَيْهِ  الْعَبَّاسُ بْنُ عَبْدِ الْمُطَّلِبِ  وَهُوَ مُغْضَبٌ ، فَقَالَ : يَا رَسُولَ اللهِ ، مَا لَنَا  وَلِقُرَيْشٍ  ؟ إِذَا تَلَاقَوْا بَيْنَهُمْ تَلَاقَوْا بِوُجُوهٍ مُبْشِرَةٍ ، وَإِذَا لَقُونَا لَقُونَا بِغَيْرِ ذَلِكَ ؟ قَالَ : فَغَضِبَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى احْمَرَّ وَجْهُهُ . قَالَ :  لَا يَدْخُلُ قَلْبَ رَجُلٍ الْإِيمَانُ حَتَّى يُحِبَّكُمْ لِلهِ وَرَسُولِهِ  ، عَمُّ الرَّجُلِ  صِنْوُ  أَبِيهِ  .","","Al-Mu'jam al-Kabir 672","","عبد المطلب بن ربيعة ابن ابن عم رسول الله عن عبد الله بن الحارث بن نوفل عن يزيد بن أبي زياد القرشي عن علي بن عاصم بن صهيب عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","مطلب بن ربيعة بن الحارث بن عبد المطلب"
"18850","673  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  الْحَكَمُ بْنُ مَرْوَانَ الْكُوفِيُّ ،  ثَنَا  عَمْرُو بْنُ ثَابِتٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ بْنِ نَوْفَلٍ ،  عَنْ  عَبْدِ الْمُطَّلِبِ بْنِ رَبِيعَةَ ، قَالَ :  دَخَلَ  الْعَبَّاسُ  عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّ  قُرَيْشًا  تَلَاقَى بِوُجُوهٍ مُشْرِقَةٍ ، وَتَلْقَانَا بِخِلَافِ ذَلِكَ ، فَغَضِبَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى  دَرَّ  الْعِرْقُ الَّذِي بَيْنَ عَيْنَيْهِ ثُمَّ قَالَ :  لَا يَذُوقُ عَبْدٌ طَعْمَ الْإِيمَانِ حَتَّى يُحِبَّكُمْ لِلهِ وَلِرَسُولِهِ  .","","Al-Mu'jam al-Kabir 673","","عبد المطلب بن ربيعة ابن ابن عم رسول الله عن عبد الله بن الحارث بن نوفل عن يزيد بن أبي زياد القرشي عن عمرو  بن أبي المقدام عن الحكم بن مروان الكوفي عن أبو مسلم الكجي عن الطبراني","مطلب بن ربيعة بن الحارث بن عبد المطلب"
"18851","674  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَزِيدُ ،  عَنْ  جَرِيرٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ الْمُطَّلِبِ بْنِ رَبِيعَةَ ، قَالَ :  جَاءَ  الْعَبَّاسُ  إِلَى نَبِيِّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ مُغْضَبٌ ، فَقَالَ : "" مَا أَتَى بِكَ ؟ "" قَالَ : يَا رَسُولَ اللهِ ، مَا لَنَا  وَلِقُرَيْشٍ  ؟ قَالَ : "" مَا لَكَ وَلَهُمْ حَتَّى أَتَى بِكَ ؟ "" قَالَ : يَلْقَى بَعْضُهُمْ بَعْضًا بِوُجُوهٍ مُشْرِقَةٍ ، فَإِذَا لَقُونَا لَقُونَا بِغَيْرِ ذَلِكَ ، فَغَضِبَ حَتَّى اسْتَدَرَّ  عِرْقٌ  بَيْنَ عَيْنَيْهِ ، فَلَمَّا  سُرِّيَ  عَنْهُ قَالَ :  وَالَّذِي نَفْسِي بِيَدِهِ ، لَا يَدْخُلُ قَلْبَ رَجُلٍ إِيمَانٌ حَتَّى         [20/286]      يُحِبَّكُمْ لِلهِ وَلِرَسُولِهِ  ، ثُمَّ قَالَ : "" مَا بَالُ رِجَالٍ يُؤْذُونِي فِي  الْعَبَّاسِ  ؟ فَإِنَّ عَمَّ الرَّجُلِ  صِنْوُ  أَبِيهِ  .","","Al-Mu'jam al-Kabir 674","","عبد المطلب بن ربيعة ابن ابن عم رسول الله عن عبد الله بن الحارث بن نوفل عن يزيد بن أبي زياد القرشي عن جرير بن حازم عن يزيد بن هارون عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","مطلب بن ربيعة بن الحارث بن عبد المطلب"
"18852","675  -  حَدَّثَنَا  سَعِيدُ بْنُ مُحَمَّدِ بْنِ الْمُغِيرَةِ الْمِصْرِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ الْوَاسِطِيُّ ، (  ح  )  وَحَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبَانَ ، قَالَا :  ثَنَا  يَزِيدُ بْنُ عَطَاءٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنِ  الْمُطَّلِبِ بْنِ رَبِيعَةَ بْنِ الْحَارِثِ  ، قَالَ :  أَتَى نَاسٌ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنَ  الْأَنْصَارِ  فَقَالُوا : يَا رَسُولَ اللهِ ، إِنَّا نَسْمَعُ مِنْ قَوْمٍ جَفَاءً ، يَقُولُ الْقَائِلُ مِنْهُمْ : إِنَّمَا مَثَلُ  مُحَمَّدٍ  كَمَثَلِ نَخْلَةٍ نَبَتَتْ فِي  كِبَاءٍ  ، فَقَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : "" يَا أَيُّهَا النَّاسُ ، مَنْ أَنَا ؟ "" قَالُوا : أَنْتَ رَسُولُ اللهِ ، قَالَ : "" أَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الْمُطَّلِبِ  - فَمَا سَمِعْنَاهُ يَنْتَمِي قَبْلَهَا -  إِنَّ اللهَ خَلَقَ خَلْقَهُ فَجَعَلَنِي مِنْ خَيْرِ خَلْقِهِ  ، ثُمَّ جَعَلَهُمْ فِرْقَتَيْنِ ، فَجَعَلَنِي فِي خَيْرِ الْفِرْقَتَيْنِ ، ثُمَّ جَعَلَهُمْ قَبَائِلَ ، فَجَعَلَنِي مِنْ خَيْرِهِمْ قَبِيلَةً ، ثُمَّ جَعَلَهُمْ بُيُوتًا فَجَعَلَنِي فِي خَيْرِ بَيْتٍ ، فَأَنَا خَيْرُكُمْ بَيْتًا ، وَخَيْرُكُمْ نَفْسًا  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : (عبد المطلب بن ربيعة بن الحارث) . كما في مصادر الترجمة .","","Al-Mu'jam al-Kabir 675","","عبد المطلب بن ربيعة ابن ابن عم رسول الله عن عبد الله بن الحارث بن نوفل عن يزيد بن أبي زياد القرشي عن يزيد بن عطاء بن يزيد اليشكري عن محمد بن أبان بن عمران السلمي عن محمود بن محمد بن منويه المفيد عن الطبراني","مطلب بن ربيعة بن الحارث بن عبد المطلب"
"18853","676  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ بْنِ نَوْفَلٍ ،  عَنْ  عَبْدِ الْمُطَّلِبِ بْنِ رَبِيعَةَ ،  أَنَّ نَاسًا مِنَ  الْأَنْصَارِ  قَالُوا لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : مَا نَسْمَعُ مِنْ أُنَاسٍ مِنْ  قُرَيْشٍ  حَتَّى يَقُولَ الْقَائِلُ مِنْهُمْ : إِنَّمَا مَثَلُ  مُحَمَّدٍ         [20/287]      مَثَلُ نَخْلَةٍ أُنْبِتَتْ فِي  كِبَاءٍ  ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَيُّهَا النَّاسُ ، مَنْ أَنَا "" ؟ قَالُوا : أَنْتَ رَسُولُ اللهِ ، فَقَالَ : "" أَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الْمُطَّلِبِ  - قَالُوا : فَمَا سَمِعْنَاهُ  انْتَمَى  قَبْلَهَا قَطُّ - ثُمَّ قَالَ : إِنَّ  اللهَ خَلَقَ خَلْقَهُ ثُمَّ فَرَّقَهُمْ فِرْقَتَيْنِ ، فَجَعَلَنِي مِنْ خَيْرِ الْفِرْقَتَيْنِ  ، ثُمَّ جَعَلَهُمْ قَبَائِلَ فَجَعَلَنِي مِنْ خَيْرِهِمْ قَبِيلَةً ، فَأَنَا خَيْرُكُمْ بَيْتًا ، وَخَيْرُكُمْ نَفْسًا  .","","Al-Mu'jam al-Kabir 676","","عبد المطلب بن ربيعة ابن ابن عم رسول الله عن عبد الله بن الحارث بن نوفل عن يزيد بن أبي زياد القرشي عن محمد بن فضيل بن غزوان عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","مطلب بن ربيعة بن الحارث بن عبد المطلب"
"18854","677  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدٌ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ رَبِيعَةَ ،  عَنْ  عَبْدِ الْمُطَّلِبِ بْنِ رَبِيعَةَ ، قَالَ :  اجْتَمَعَ  بَنُو عَبْدِ الْمُطَّلِبِ  فَقَالُوا : أَلَا تَسْأَلُوا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَجْعَلْ فِيكُمْ مَا جَعَلَ فِي بَنِي فُلَانٍ ، يَجْعَلْ فِيكُمُ السِّعَايَةَ ؟ فَلَقُوا  عَلِيًّا  فَكَلَّمُوهُ فَقَالَ : إِنَّ اللهَ عَزَّ وَجَلَّ أَبَى ذَلِكَ لَكُمْ وَرَسُولُهُ أَنْ يَجْعَلَ لَكُمْ  أَوْسَاخَ أَيْدِي النَّاسِ - أَوْ قَالَ : غُسَالَةَ أَيْدِي النَّاسِ  - قَالَ  عَبْدُ الْمُطَّلِبِ  لِأَبِيهِ : أَرْسِلْنِي ، فَأَرْسَلَ  الْعَبَّاسُ  ابْنَهُ  الْفَضْلَ  ، فَأَتَيْنَا عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَدَخَلْنَا ، فَخَصَّ كُلَّ وَاحِدٍ مِنَّا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَا  تُصَرِّرَانِ  هَاهُنَا ؟ "" فَقُلْتُ : يَا رَسُولَ اللهِ ، بَعَثَنَا قَوْمُكَ وَبَنُو عَمِّكَ لِتَجْعَلَ فِيهِمْ مَا جَعَلْتَ فِي النَّاسِ مِنَ السِّعَايَةِ ، فَقَالَ :  إِنَّ اللهَ أَبَى ذَلِكَ لَكُمْ وَرَسُولُهُ أَنْ تَأْكُلُوا  أَوْسَاخَ - أَوْ قَالَ : غُسَالَةَ - أَيْدِي النَّاسِ  .","","Al-Mu'jam al-Kabir 677","","عبد المطلب بن ربيعة ابن ابن عم رسول الله عن عبد الله بن عبد المطلب بن ربيعة الهاشمي عن عبد الله بن الحارث بن نوفل عن يزيد بن أبي زياد القرشي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","مطلب بن ربيعة بن الحارث بن عبد المطلب"
"18855","678  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،         [20/288]      عَنْ  عَبْدِ الْمُطَّلِبِ بْنِ رَبِيعَةَ بْنِ الْحَارِثِ بْنِ عَبْدِ الْمُطَّلِبِ قَالَ : بَعَثَ  الْعَبَّاسُ  ابْنَهُ  الْفَضْلَ  وَبَعَثَنِي أَبِي  رَبِيعَةُ بْنُ الْحَارِثِ  ، فَانْطَلَقْنَا حَتَّى دَخَلْنَا عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 678","","عبد المطلب بن ربيعة ابن ابن عم رسول الله عن عبد الله بن الحارث بن نوفل عن يزيد بن أبي زياد القرشي عن محمد بن فضيل بن غزوان عن محمد بن عبد الله بن نمير عن محمد بن عبد الله مطين الحضرمي عن الطبراني","مطلب بن ربيعة بن الحارث بن عبد المطلب"
"18856","مُطَّلِبُ بْنُ أَبِي وَدَاعَةَ السَّهْمِيُّ  "" وَهُوَ  الْمُطَّلِبُ بْنُ أَبِي وَدَاعَةَ بْنِ صُبَيْرَةَ بْنِ سَعِيدِ بْنِ سَعْدِ بْنِ سَهْمِ بْنِ عَمْرِو بْنِ هُصَيْصِ بْنِ كَعْبِ بْنِ لُؤَيِّ بْنِ غَالِبِ بْنِ فَهْمٍ  ، أَسْلَمَ يَوْمَ الْفَتْحِ ""  679  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  عِكْرِمَةَ بْنِ خَالِدٍ ،  عَنِ  الْمُطَّلِبِ بْنِ أَبِي وَدَاعَةَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَجَدَ فِي النَّجْمِ  فَسَجَدَ النَّاسُ مَعَهُ "" . قَالَ  الْمُطَّلِبُ  : "" وَلَمْ أَسْجُدْ مَعَهُمْ "" - وَهُوَ يَوْمَئِذٍ مُشْرِكٌ - قَالَ  الْمُطَّلِبُ  : "" فَلَا أَدَعُ أَنْ أَسْجُدَ فِيهَا أَبَدًا  .","","Al-Mu'jam al-Kabir 679","","المطلب بن أبي وداعة الجمحي عن عكرمة بن خالد بن العاص عن عبد الله بن طاووس عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","مطلب بن أبي وداعة السهمي"
"18857","680  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  عَمْرِو بْنِ قَيْسٍ ،  أَخْبَرَنِي  كَثِيرُ بْنُ كَثِيرِ بْنِ الْمُطَّلِبِ بْنِ أَبِي وَدَاعَةَ السَّهْمِيُّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي فِي  الْمَسْجِدِ الْحَرَامِ  وَالنَّاسُ يَطُوفُونَ  بِالْبَيْتِ  بَيْنَهُ وَبَيْنَ الْقِبْلَةِ بَيْنَ يَدَيْهِ ، لَيْسَ بَيْنَهُ وَبَيْنَهُمْ سُتْرَةٌ  .         [20/289]","","Al-Mu'jam al-Kabir 680","","المطلب بن أبي وداعة الجمحي عن كثير بن المطلب بن أبي وداعة السهمي عن كثير بن كثير بن المطلب السهمي عن عمرو بن قيس الملائي عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","مطلب بن أبي وداعة السهمي"
"18858","681  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،  عَنْ  كَثِيرِ بْنِ كَثِيرٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، مِثْلَهُ ، إِلَّا أَنَّهُ قَالَ :  رَأَيْتُهُ يُصَلِّي مِمَّا يَلِي بَابَ  بَنِي سَهْمٍ  .","","Al-Mu'jam al-Kabir 681","","المطلب بن أبي وداعة الجمحي عن كثير بن المطلب بن أبي وداعة السهمي عن كثير بن كثير بن المطلب السهمي عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","مطلب بن أبي وداعة السهمي"
"18859","682  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عُمَيْرٍ ،  عَنْ  كَثِيرِ بْنِ كَثِيرِ بْنِ الْمُطَّلِبِ بْنِ أَبِي وَدَاعَةَ ،  عَنْ  أَبِيهِ ،  عَنِ  الْمُطَّلِبِ  أَنَّهُ رَأَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي إِلَى  الْبَيْتِ  وَلَيْسَ بَيْنَهُ وَبَيْنَ الطَّوَافِ أَحَدٌ  .","","Al-Mu'jam al-Kabir 682","","المطلب بن أبي وداعة الجمحي عن كثير بن المطلب بن أبي وداعة السهمي عن كثير بن كثير بن المطلب السهمي عن محمد بن عبد الله بن عبيد الليثي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","مطلب بن أبي وداعة السهمي"
"18860","683  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْحَكَمِ ،  أَنَا  اللَّيْثُ بْنُ سَعْدٍ ، (  ح  )  وَحَدَّثَنَا  الْمُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  كَثِيرِ بْنِ كَثِيرِ بْنِ الْمُطَّلِبِ ،  عَنْ  أَبِيهِ كَثِيرٍ ،  عَنِ  الْمُطَّلِبِ بْنِ أَبِي         [20/290]      وَدَاعَةَ  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى فِي  حَاشِيَةِ  الطَّوَافِ ،  وَلَيْسَ بَيْنَهُ وَبَيْنَ الطَّوَافِ سُتْرَةٌ "" . هَذَا لَفْظُ  ابْنِ صَالِحٍ  ، وَقَالَ  ابْنُ عَبْدِ الْحَكَمِ  فِي حَدِيثِهِ : قَالَ : رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمَّا قَضَى سَعْيَهُ صَلَّى فِي  حَاشِيَةِ  الطَّوَافِ لَيْسَ بَيْنَهُ وَبَيْنَ الطَّائِفِينَ سُتْرَةٌ  .","","Al-Mu'jam al-Kabir 683","","المطلب بن أبي وداعة الجمحي عن كثير بن المطلب بن أبي وداعة السهمي عن كثير بن كثير بن المطلب السهمي عن ابن جريج عن الليث بن سعد عن عبد الله بن عبد الحكم بن أعين عن يوسف بن يزيد القراطيسي عن الطبراني","مطلب بن أبي وداعة السهمي"
"18861","684  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  حَدَّثَنِي  كَثِيرُ بْنُ كَثِيرِ بْنِ الْمُطَّلِبِ ،  عَنْ  أَبِيهِ  ،  حَدَّثَنِي  أَعْيَانُ الْمُطَّلِبِ ،  عَنِ  الْمُطَّلِبِ بْنِ أَبِي وَدَاعَةَ ، قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي حِيَالَ  الرُّكْنِ  ، وَالرِّجَالُ يَمُرُّونَ بَيْنَ يَدَيْهِ  .","","Al-Mu'jam al-Kabir 684","","المطلب بن أبي وداعة الجمحي عن أعيان المطلب عن كثير بن المطلب بن أبي وداعة السهمي عن كثير بن كثير بن المطلب السهمي عن ابن جريج عن حماد بن زيد عن محمد بن أبي بكر المقدمي عن أحمد بن داود بن موسى السدوسي عن الطبراني","مطلب بن أبي وداعة السهمي"
"18862","685  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَنْدَهْ الْأَصْبَهَانِيُّ ،  ثَنَا  زَيْدُ بْنُ أَخْزَمَ ،  ثَنَا  عَبْدُ الْقَاهِرِ بْنُ شُعَيْبٍ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  كَثِيرِ بْنِ الْمُطَّلِبِ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَرَجَ مِنَ  الْكَعْبَةِ  فَقَامَ حِيَالَ  الرُّكْنِ  فَصَلَّى رَكْعَتَيْنِ ، وَالنَّاسُ يَمُرُّونَ بَيْنَ يَدَيْهِ يَطُوفُونَ  بِالْبَيْتِ  : الرِّجَالُ وَالنِّسَاءُ  .  سَالِمُ بْنُ عَبْدِ اللهِ هَذَا هُوَ سَالِمٌ الْخَيَّاطُ  .","","Al-Mu'jam al-Kabir 685","","المطلب بن أبي وداعة الجمحي عن كثير بن المطلب بن أبي وداعة السهمي عن كثير بن كثير بن المطلب السهمي عن سالم بن عبد الله الخياط عن هشام بن حسان العتكي عن عبد القاهر بن شعيب المعولي عن زيد بن أخزم الطائي عن محمد بن يحيى بن مندة عن الطبراني","مطلب بن أبي وداعة السهمي"
"18863","686  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ،  ثَنَا  أَحْمَدُ بْنُ حَاتِمِ بْنِ عِيسَى ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  ثَنَا  عَمْرُو بْنُ دِينَارٍ ،  عَنْ  عَبَّادِ بْنِ الْمُطَّلِبِ ،  عَنِ  الْمُطَّلِبِ بْنِ أَبِي وَدَاعَةَ  ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يُصَلِّي حِيَالَ  الرُّكْنِ  عِنْدَ السِّقَايَةِ  ، وَالرِّجَالُ وَالنِّسَاءُ يَمُرُّونَ بَيْنَ يَدَيْهِ  .","","Al-Mu'jam al-Kabir 686","","المطلب بن أبي وداعة الجمحي عن عباد بن المطلب عن عمرو بن دينار الأثرم عن حماد بن زيد عن أحمد بن حاتم بن عيسى عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","مطلب بن أبي وداعة السهمي"
"18864","687  -  حَدَّثَنَا  وَرْدُ بْنُ أَحْمَدَ بْنِ لَبِيدٍ الْبَيْرُوتِيُّ ،  ثَنَا  صَفْوَانُ بْنُ صَالِحٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  سَالِمٌ الْخَيَّاطُ ، وَزُهَيْرُ بْنُ مُحَمَّدٍ ، قَالَا :  ثَنَا  كَثِيرُ         [20/291]      بْنُ كَثِيرٍ ،  عَنْ  أَبِيهِ ،  حَدَّثَنِي  الْمُطَّلِبُ بْنُ أَبِي وَدَاعَةَ  ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي  حَذْوَ  الرُّكْنِ الْأَسْوَدِ  ، وَالرِّجَالُ وَالنِّسَاءُ يَمُرُّونَ بَيْنَ يَدَيْهِ مَا بَيْنَهُ وَبَيْنَهُمْ سُتْرَةٌ  .","","Al-Mu'jam al-Kabir 687","","المطلب بن أبي وداعة الجمحي عن كثير بن المطلب بن أبي وداعة السهمي عن كثير بن كثير بن المطلب السهمي عن زهير بن محمد التميمي عن الوليد بن مسلم القرشي عن صفوان بن صالح الدمشقي عن محمد بن أحمد بن لبيد عن الطبراني","مطلب بن أبي وداعة السهمي"
"18865","688  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ ، وَسَعِيدُ بْنُ مُحَمَّدِ بْنِ الْمُغِيرَةِ الْمِصْرِيُّ ، قَالَا :  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ الْوَاسِطِيُّ ،  عَنْ  صَالِحِ بْنِ عُمَرَ ،  ثَنَا  صَالِحُ بْنُ أَبِي الْأَخْضَرِ ،  عَنِ  الزُّهْرِيِّ ،  عَنِ  السَّائِبِ بْنِ يَزِيدَ ،  عَنِ  الْمُطَّلِبِ بْنِ أَبِي وَدَاعَةَ ، قَالَ :  رَأَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَجُلًا  قَاعِدًا ، فَقَالَ :  صَلَاةُ الْقَاعِدِ عَلَى نِصْفِ صَلَاةِ الْقَائِمِ  . فَتَجَشَّمَ النَّاسُ الْقِيَامَ  .","","Al-Mu'jam al-Kabir 688","","المطلب بن أبي وداعة الجمحي عن السائب بن يزيد الكندي عن الزهري عن صالح بن أبي الأخضر اليمامي عن صالح بن عمر الواسطي عن سعيد بن سليمان سعدويه عن سعيد بن محمد بن المغيرة المصري عن الطبراني","مطلب بن أبي وداعة السهمي"
"18866","689  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  أَبُو شِهَابٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنِ  الْمُطَّلِبِ بْنِ أَبِي وَدَاعَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُتِيَ بِإِنَاءِ نَبِيذٍ  فَصَبَّ عَلَيْهِ الْمَاءَ حَتَّى تَدَفَّقَ ، ثُمَّ شَرِبَ مِنْهُ  .","","Al-Mu'jam al-Kabir 689","","المطلب بن أبي وداعة الجمحي عن ذكوان السمان عن الأعمش عن عبد ربه بن نافع الحناط عن أحمد بن عبد الله اليربوعي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","مطلب بن أبي وداعة السهمي"
"18867","690  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  خَالِدُ بْنُ يَزِيدَ         [20/292]      الْعُمَرِيُّ ،  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنِ  الْكَلْبِيِّ ،  عَنْ  أَبِي صَالِحٍ ،  عَنِ  الْمُطَّلِبِ بْنِ أَبِي وَدَاعَةَ ، قَالَ :  طَافَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالْبَيْتِ فِي يَوْمٍ صَائِفٍ وَعَطِشَ  وَاسْتَسْقَى ، فَقَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، عِنْدَنَا شَرَابٌ مِنْ هَذَا الزَّبِيبِ ، أَفَأَسْقِيكَ مِنْهُ ؟ قَالَ : "" بَلَى "" ، فَبَعَثَ الرَّجُلُ إِلَى بَيْتِهِ فَأُتِيَ بِقَدَحٍ عَظِيمٍ "" فَأَدْنَاهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ فِيهِ فَوَجَدَ لَهُ رِيحًا شَدِيدَةً فَكَرِهَهُ فَرَدَّهُ  .","","Al-Mu'jam al-Kabir 690","","المطلب بن أبي وداعة الجمحي عن باذام عن محمد بن السائب الكلبي عن سفيان الثوري عن خالد بن يزيد الحذاء عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","مطلب بن أبي وداعة السهمي"
"18868","مَنِ اسْمُهُ مُطِيعٌ  مُطِيعُ بْنُ الْأَسْوَدِ الْعَدَوِيُّ الْقُرَشِيُّ  ، وَهُوَ  مُطِيعُ بْنُ الْأَسْوَدِ بْنِ حَارِثَةَ بْنِ نَضْلَةَ بْنِ جَرْيَانَ بْنِ عَوْفِ بْنِ عُبَيْدِ عُوَيْجِ بْنِ عَدِيِّ بْنِ كَعْبٍ  ، وَأُمُّهُ  الْعَجْمَاءُ بِنْتُ يَمَانِ بْنِ الْفَضْلِ بْنِ عَفِيفِ بْنِ كَلْبِ بْنِ حَسَسَةَ الْخُزَاعِيِّ  .  691  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ أَيُّوبَ ، صَاحِبُ الْمَغَازِي ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  حَدَّثَنِي  شُعْبَةُ بْنُ الْحَجَّاجِ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي السَّفَرِ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ مُطِيعِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ مُطِيعٍ -  وَكَانَ اسْمُهُ  الْعَاصِ  فَسَمَّاهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مُطِيعًا  - قَالَ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِينَ قَتَلَ هَؤُلَاءِ الرَّهْطَ يَقُولُ :  لَا  تُغْزَى  مَكَّةُ  بَعْدَ هَذَا الْعَامِ  ، وَلَا يُقْتَلُ مِنْ  قُرَيْشٍ  بَعْدَ هَذَا الْعَامِ صَبْرًا أَحَدٌ  .","","Al-Mu'jam al-Kabir 691","","مطيع بن الأسود بن حارثة الأسدي عن عبد الله بن مطيع بن الأسود العدوي عن الشعبي عن عبد الله بن أبي السفر الهمداني عن شعبة بن الحجاج عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن أحمد بن محمد بن أيوب عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مطيع بن الأسود العدوي القرشي"
"18869","692  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ         [20/293]      عَبْدِ اللهِ بْنِ مُطِيعِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ  ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  يَوْمَ الْفَتْحِ  :  لَا  يُقْتَلُ  قُرَشِيٌّ بَعْدَ هَذَا الْيَوْمِ صَبْرًا  .","","Al-Mu'jam al-Kabir 692","","مطيع بن الأسود بن حارثة الأسدي عن عبد الله بن مطيع بن الأسود العدوي عن الشعبي عن زكريا بن أبي زائدة الوادعي عن قيس بن الربيع الأسدي عن أبو الوليد الطيالسي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","مطيع بن الأسود العدوي القرشي"
"18870","693  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا ،  عَنْ  زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  ثَنَا  عَامِرٌ ،  عَنْ  عَبْدِ اللهِ بْنِ مُطِيعٍ ، قَالَ :  سَمِعْتُ  مُطِيعًا  يَقُولُ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ فَتْحِ  مَكَّةَ  يَقُولُ :  لَا  يُقْتَلُ  قُرَشِيٌّ صَبْرًا بَعْدَ هَذَا الْيَوْمِ إِلَى يَوْمِ الْقِيَامَةِ  ، وَلَمْ يُدْرِكْ أَحَدٌ الْإِسْلَامَ مِنْ عُصَاةِ  قُرَيْشٍ  غَيْرَ  مُطِيعٍ  ، وَكَانَ اسْمُهُ  الْعَاصِ  ، فَسَمَّاهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مُطِيعًا  .","","Al-Mu'jam al-Kabir 693","","مطيع بن الأسود بن حارثة الأسدي عن عبد الله بن مطيع بن الأسود العدوي عن الشعبي عن زكريا بن أبي زائدة الوادعي عن يحيى بن زكريا بن أبي زائدة عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","مطيع بن الأسود العدوي القرشي"
"18871","694  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  حَدَّثَنِي  أَبِي  ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ مُطِيعٍ ، قَالَ :  سَمِعْتُ  مُطِيعًا  ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 694","","مطيع بن الأسود بن حارثة الأسدي عن عبد الله بن مطيع بن الأسود العدوي عن الشعبي عن زكريا بن أبي زائدة الوادعي عن يحيى بن زكريا بن أبي زائدة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","مطيع بن الأسود العدوي القرشي"
"18872","695  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَزْدَادَ التَّوَّزِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ عُمَرَ بْنِ خَالِدٍ الرَّقِّيُّ ،  ثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ مُطِيعٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ الْفَتْحِ  :  لَا يَنْبَغِي أَنْ  يُقْتَلَ  قُرَشِيٌّ بَعْدَ يَوْمِي هَذَا صَبْرًا  .","","Al-Mu'jam al-Kabir 695","","مطيع بن الأسود بن حارثة الأسدي عن عبد الله بن مطيع بن الأسود العدوي عن الشعبي عن مجالد بن سعيد عن عيسى بن يونس بن أبي إسحاق عن سليمان بن عمر بن خالد المخرمي عن محمد بن يزداد التوزي عن الطبراني","مطيع بن الأسود العدوي القرشي"
"18873","مَنِ اسْمُهُ  مِحْجَنٌ  مِحْجَنٌ أَبُو بُسْرٍ الدَّيْلِيُّ  696  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  بِشْرِ بْنِ مِحْجَنٍ الدِّيلِيِّ ،  عَنْ  أَبِيهِ ،  قَالَ :  أَتَيْتُ النَّبِيَّ صَلَّى         [20/294]      اللهُ عَلَيْهِ وَسَلَّمَ وَقَدْ صَلَّيْتُ فِي أَهْلِي ، فَأُقِيمَتِ الصَّلَاةُ فَجَلَسْتُ ، فَلَمَّا صَلَّى قَالَ : "" أَلَسْتَ مُسْلِمًا ؟ "" قُلْتُ : بَلَى ، قَالَ : "" مَا مَنَعَكَ أَنْ تُصَلِّيَ مَعَ النَّاسِ ؟ "" قَالَ : كُنْتُ صَلَّيْتُ فِي أَهْلِي ، قَالَ :  فَصَلِّ مَعَ النَّاسِ وَإِنْ كُنْتَ قَدْ صَلَّيْتَ فِي أَهْلِكَ  .  كَذَا رَوَاهُ  سُفْيَانُ  ، عَنْ  زَيْدِ بْنِ أَسْلَمَ  ، عَنْ  بِشْرِ بْنِ مِحْجَنٍ  ،  وَوَهِمَ  فِيهِ ، إِنَّمَا هُوَ  بُسْرُ بْنُ مِحْجَنٍ  ، هَكَذَا رَوَاهُ  مَالِكٌ  ، وَأَصْحَابُ  زَيْدِ بْنِ أَسْلَمَ  .","","Al-Mu'jam al-Kabir 696","","محجن بن أبي محجن الديلي عن بسر أو بشر بن محجن الديلي عن زيد بن أسلم عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","محجن أبو بسر الديلي"
"18874","697  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ ، (  ح  )  وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْحَكَمِ ،  ثَنَا  مَالِكٌ ، (  ح  )  وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  أَنَا  مَالِكٌ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  مَالِكٌ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  رَجُلٍ مِنْ  بَنِي الدِّيلِ  يُقَالُ لَهُ :  بُسْرُ بْنُ مِحْجَنٍ ،  عَنْ  أَبِيهِ  ،  أَنَّهُ كَانَ فِي مَجْلِسٍ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأُوذِنَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِلصَّلَاةِ ، فَقَامَ فَصَلَّى بِهِمْ ، ثُمَّ رَجَعَ  وَمِحْجَنٌ  فِي مَجْلِسِهِ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَا مَنَعَكَ أَنْ تُصَلِّيَ مَعَ النَّاسِ ؟ أَلَسْتَ بِرَجُلٍ مُسْلِمٍ ؟ "" قَالَ : بَلَى يَا رَسُولَ اللهِ ، وَلَكِنْ صَلَّيْتُ فِي أَهْلِي ، قَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا جِئْتَ فَصَلِّ مَعَ النَّاسِ وَإِنْ كُنْتَ قَدْ صَلَّيْتَ  .","","Al-Mu'jam al-Kabir 697","","محجن بن أبي محجن الديلي عن بسر أو بشر بن محجن الديلي عن زيد بن أسلم عن مالك بن أنس عن عبد الله بن عبد الحكم بن أعين عن يوسف بن يزيد القراطيسي عن الطبراني","محجن أبو بسر الديلي"
"18875","698  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ، وَدَاوُدَ بْنِ قَيْسٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنِ  ابْنِ مِحْجَنٍ الدِّيلِيِّ ،  عَنْ  أَبِيهِ  ،         [20/295]      قَالَ :  صَلَّيْتُ  الظُّهْرَ - أَوِ الْعَصْرَ  - فِي بَيْتِي ، ثُمَّ جِئْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَجَلَسْتُ عِنْدَهُ ، فَأُقِيمَتِ الصَّلَاةُ ، فَصَلَّى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَلَمْ أُصَلِّ ، فَلَمَّا انْصَرَفَ قَالَ : "" أَلَسْتَ مُسْلِمًا ؟ "" قُلْتُ : بَلَى ، قَالَ : "" فَمَا لَكَ لَمْ تُصَلِّ ؟ "" قُلْتُ : إِنِّي قَدْ صَلَّيْتُ فِي بَيْتِي ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا أُقِيمَتِ الصَّلَاةُ فَصَلِّ ، وَإِنْ كُنْتَ قَدْ صَلَّيْتَ  .","","Al-Mu'jam al-Kabir 698","","محجن بن أبي محجن الديلي عن بسر أو بشر بن محجن الديلي عن زيد بن أسلم عن داود بن قيس الدباغ عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","محجن أبو بسر الديلي"
"18876","699  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  بُسْرِ بْنِ مِحْجَنٍ ،  عَنْ  أَبِيهِ  قَالَ :  أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَكَلَّمْتُهُ فِي حَاجَةٍ ، ثُمَّ أُقِيمَتِ الصَّلَاةُ وَأَنَا جَالِسٌ فَصَلَّى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ انْصَرَفَ فَوَجَدَنِي جَالِسًا ، فَقَالَ لِي : "" مَا أَنْتَ مُسْلِمٌ ؟ "" قُلْتُ : بَلَى يَا رَسُولَ اللهِ ، قَالَ :  فَمَا مَنَعَكَ أَنْ تُصَلِّيَ مَعَنَا ؟ "" قُلْتُ : إِنِّي صَلَّيْتُ فِي رَحْلِي  ، قَالَ : "" وَإِنْ كُنْتَ قَدْ صَلَّيْتَ فِي رَحْلِكَ  .","","Al-Mu'jam al-Kabir 699","","محجن بن أبي محجن الديلي عن بسر أو بشر بن محجن الديلي عن زيد بن أسلم عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","محجن أبو بسر الديلي"
"18877","700  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَمُحَمَّدُ بْنُ يَحْيَى بْنِ الْمُنْذِرِ ، قَالَا :  ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  بُسْرِ بْنِ مِحْجَنٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  صَلَّيْتُ فِي بَيْتِي  الظُّهْرَ - أَوِ الْعَصْرَ  - ثُمَّ خَرَجْتُ إِلَى الْمَسْجِدِ فَوَجَدْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَالِسًا وَحَوْلَهُ نَاسٌ ، فَجَلَسْتُ مَعَهُمْ ، ثُمَّ أُقِيمَتِ الصَّلَاةُ ، فَدَخَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَصَلَّى لِلنَّاسِ ، ثُمَّ خَرَجَ فَوَجَدَنِي جَالِسًا فِي مَجْلِسِي الَّذِي عَهِدَنِي فِيهِ فَقَالَ :  أَلَسْتَ رَجُلًا مُسْلِمًا ؟ "" فَقُلْتُ : بَلَى يَا رَسُولَ اللهِ ، إِنِّي لَمُسْلِمٌ  ، قَالَ : "" فَمَا مَنَعَكَ أَنْ تَدْخُلَ فَتُصَلِّيَ مَعَ النَّاسِ ؟ "" قُلْتُ : إِنِّي قَدْ صَلَّيْتُ فِي أَهْلِي ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِذَا صَلَّيْتَ فِي أَهْلِكَ ، ثُمَّ جِئْتَ إِلَى الْمَسْجِدِ فَوَجَدْتَ النَّاسَ يُصَلُّونَ فَصَلِّ مَعَهُمْ  .         [20/296]","","Al-Mu'jam al-Kabir 700","","محجن بن أبي محجن الديلي عن بسر أو بشر بن محجن الديلي عن زيد بن أسلم عن سليمان بن بلال القرشي عن عبد الله بن مسلمة القعنبي عن محمد بن يحيى بن المنذر القزاز عن الطبراني","محجن أبو بسر الديلي"
"18878","701  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  أَخْبَرَنِي  بُسْرُ بْنُ مِحْجَنٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 701","","محجن بن أبي محجن الديلي عن بسر أو بشر بن محجن الديلي عن زيد بن أسلم عن محمد بن جعفر بن أبي كثير الزرقي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","محجن أبو بسر الديلي"
"18879","702  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  ثَنَا  حَفْصُ بْنُ مَيْسَرَةَ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  بُسْرِ بْنِ مِحْجَنٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 702","","محجن بن أبي محجن الديلي عن بسر أو بشر بن محجن الديلي عن زيد بن أسلم عن حفص بن ميسرة العقيلي عن سويد بن سعيد الحدثاني عن الحسين بن إسحاق التستري عن الطبراني","محجن أبو بسر الديلي"
"18880","مِحْجَنُ بْنُ الْأَدْرَعِ السُّلَمِيُّ  703  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو مَعْمَرٍ الْمُقْعَدُ ،  ثَنَا  عَبْدُ الْوَارِثِ ،  ثَنَا  حُسَيْنٌ الْمُعَلِّمُ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ  ،  حَدَّثَنِي  حَنْظَلَةُ بْنُ عَلِيٍّ ، أَنَّ مِحْجَنَ بْنَ الْأَدْرَعِ  حَدَّثَهُ  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ دَخَلَ الْمَسْجِدَ فَإِذَا هُوَ رَجُلٌ قَدْ قَضَى صَلَاتَهُ وَهُوَ يَتَشَهَّدُ وَهُوَ يَقُولُ : اللَّهُمَّ إِنِّي أَسْأَلُكَ بِاللهِ الْأَحَدِ الصَّمَدِ الَّذِي لَمْ يَلِدْ وَلَمْ يُولَدْ وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ ، أَنْ تَغْفِرَ لِي ذُنُوبِي إِنَّكَ الْغَفُورُ الرَّحِيمُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قَدْ غُفِرَ لَهُ ، قَدْ غُفِرَ لَهُ ، قَدْ غُفِرَ لَهُ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : (عبد الله بن بريدة). كما في مصادر التخريج.","","Al-Mu'jam al-Kabir 703","","محجن بن الأدرع الأسلمي عن حنظلة بن علي بن الأسقع الأسلمي عن عبد الله بن بريدة عن حسين المعلم عن عبد الوارث بن سعيد بن ذكوان عن عبد الله بن عمرو المقعد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","محجن بن الأدرع السلمي"
"18881","704  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ الْبَصْرِيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ شُعَيْبٍ السِّمْسَارُ ،  ثَنَا  خَالِدُ بْنُ خِدَاشٍ ، قَالَا :  ثَنَا         [20/297]      أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنْ  رَجَاءِ بْنِ أَبِي رَجَاءٍ الْبَاهِلِيِّ ،  عَنْ  مِحْجَنِ بْنِ الْأَدْرَعِ ، قَالَ :  أَخَذَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى صَعِدْنَا  أُحُدًا  ، وَأَشْرَفَ عَلَى  الْمَدِينَةِ  قَالَ :  وَيْحَ أُمِّهَا مِنْ قَرْيَةٍ يَدَعُهَا أَهْلُهَا أَعْمَرَ مَا تَكُونُ  ، يَأْتِيهَا  الدَّجَّالُ  فَيَجِدُ عَلَى كُلِّ نَقْبٍ مِنْ  أَنْقَابِهَا  مَلَكًا مُصْلِتًا "" ، ثُمَّ انْحَدَرَ حَتَّى أَتَى الْمَسْجِدَ ، فَإِذَا هُوَ بِرَجُلٍ قَائِمٍ يُصَلِّي وَيَقْرَأُ فَقَالَ : "" تَرَاهُ  عَبْدَ اللهِ بْنَ قَيْسٍ  ؟ إِنَّهُ لَأَوَّاهٌ حَلِيمٌ "" ، قُلْتُ : يَا رَسُولَ اللهِ ، أَلَا أُبَشِّرُهُ ؟ قَالَ : "" احْذَرْ لَا تُسْمِعْهُ فَتُهْلِكَهُ "" ، ثُمَّ انْحَدَرَ فَلَمَّا انْتَهَيْنَا إِلَى الْمَسْجِدِ فَوَجَدْنَاهُ  بُرَيْدَةَ الْأَسْلَمِيَّ  عَلَى بَابٍ مِنْ أَبْوَابِ الْمَسْجِدِ ، وَكَانَ فِي الْمَسْجِدِ رَجُلٌ يُطِيلُ الصَّلَاةَ ، وَكَانَ  بُرَيْدَةُ  صَاحِبَ مُزَاحَاتٍ ، فَقَالَ : يَا  مِحْجَنُ  ، أَلَا تُصَلِّي كَمَا يُصَلِّي  سُكْبَةُ  ؟ فَلَمْ يَرُدَّ عَلَيْهِ شَيْئًا وَرَجَّعَ ، فَلَمَّا أَتَى بَيْتَهُ قَالَ : "" خَيْرُ دِينِنَا أَيْسَرُهُ ، خَيْرُ دِينِكُمْ أَيْسَرُهُ ، خَيْرُ دِينِكُمْ أَيْسَرُهُ ، خَيْرُ دِينِكُمْ أَيْسَرُهُ "" ، ثَلَاثًا  .","","Al-Mu'jam al-Kabir 704","","محجن بن الأدرع الأسلمي عن رجاء بن أبي رجاء الباهلي عن عبد الله بن شقيق العقيلي عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن أبو الوليد الطيالسي عن محمد بن محمد بن حيان التمار عن الطبراني","محجن بن الأدرع السلمي"
"18882","705  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنْ  رَجَاءِ بْنِ أَبِي رَجَاءٍ ،  عَنْ  مِحْجَنِ بْنِ الْأَدْرَعِ قَالَ : أَخَذَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِيَدِي . فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 705","","محجن بن الأدرع الأسلمي عن رجاء بن أبي رجاء الباهلي عن عبد الله بن شقيق العقيلي عن جعفر بن إياس اليشكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","محجن بن الأدرع السلمي"
"18883","706  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ حَمَّادٍ الشُّعَيْثِيُّ ،  ثَنَا  كَهْمَسُ بْنُ الْحَسَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنْ  مِحْجَنِ بْنِ الْأَدْرَعِ ، قَالَ :  بَعَثَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِحَاجَةٍ ، ثُمَّ عَرَضَ لِي وَأَنَا خَارِجٌ مِنْ طَرِيقِ  الْمَدِينَةِ ،  فَأَخَذَ بِيَدِي فَانْطَلَقْنَا حَتَّى صَعِدْنَا إِلَى  أُحُدٍ  ، فَأَقْبَلَ         [20/298]      عَلَى  الْمَدِينَةِ  فَقَالَ :  وَيْلُ أُمِّهَا قَرْيَةً ، يَدَعُهَا أَهْلُهَا كَأَيْنَعِ مَا يَكُونُ  ، قُلْتُ : يَا نَبِيَّ اللهِ ، مَنْ يَأْكُلُ  ثَمَرَهَا  ؟ قَالَ : "" عَافِيَةُ الطَّيْرِ وَالسِّبَاعِ ، وَلَا يَدْخُلُهَا  الدَّجَّالُ  ، كُلَّمَا أَرَادَ أَنْ يَدْخُلَهَا تَلَقَّاهُ بِكُلِّ نَقْبٍ مِنْ  أَنْقَابِهَا  مَلَكٌ مُصْلِتٌ "" ، ثُمَّ أَقْبَلَ حَتَّى كَانَ بِبَابِ الْمَسْجِدِ إِذَا  رَجُلٌ  يُصَلِّي فَقَالَ : "" أَيَقُولُهُ صَادِقًا "" ؟ قُلْتُ : يَا رَسُولَ اللهِ ، هَذَا فُلَانٌ ، هَذَا أَكْثَرُ  أَهْلِ الْمَدِينَةِ  صَلَاةً ، قَالَ : "" لَا تُسْمِعْهُ فَتُهْلِكَهُ  .","","Al-Mu'jam al-Kabir 706","","محجن بن الأدرع الأسلمي عن عبد الله بن شقيق العقيلي عن كهمس بن الحسن النمري عن عبد الرحمن بن حماد الشعيثي عن أبو مسلم الكجي عن الطبراني","محجن بن الأدرع السلمي"
"18884","707  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  أَبُو عُمَرَ الضَّرِيرُ ، (  ح  )  وَحَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  دَاوُدُ بْنُ شَبِيبٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  أَنَا  سَعِيدٌ الْجُرَيْرِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنْ  مِحْجَنِ بْنِ الْأَدْرَعِ السُّلَمِيِّ قَالَ :  بَعَثَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى حَاجِزٍ يَمِينَ  الْمَدِينَةِ  فِي حَاجَةٍ ، فَلَمَّا رَجَعْتُ ذَهَبْتُ مَعَهُ حَتَّى صَعِدَ  أُحُدًا  فَأَشْرَفَ عَلَى  الْمَدِينَةِ ،  فَقَالَ :  وَيْلُ أُمِّكِ قَرْيَةً ، يَدَعُكِ أَهْلُكِ وَأَنْتِ خَيْرُ مَا يَكُونُ  ، ثُمَّ نَزَلَ وَنَزَلْتُ مَعَهُ حَتَّى أَتَيْنَا بِبَابِ الْمَسْجِدِ ، فَرَأَى  رَجُلًا  يُصَلِّي فَوَضَعَ يَدَهُ عَلَى مَنْكِبِي فَأَنَارَهُ بِضَوْئِهِ ، فَقَالَ : "" أَيَقُولُهُ صَادِقًا ؟ "" قَالَهَا ثَلَاثًا ، قُلْتُ : يَا رَسُولَ اللهِ ، هَذَا ؟ وَهَذَا أَعْبُدُ  أَهْلِ الْمَدِينَةِ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" اتَّقِ ، لَا تُسْمِعْهُ فَتُهْلِكَهُ "" . قَالَهَا ثَلَاثًا . ثُمَّ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِنَّ اللهَ تَعَالَى رَضِيَ لِهَذِهِ الْأُمَّةِ الْيُسْرَ ، وَكَرِهَ لَهَا الْعُسْرَ "" . قَالَهَا ثَلَاثًا  .","","Al-Mu'jam al-Kabir 707","","محجن بن الأدرع الأسلمي عن عبد الله بن شقيق العقيلي عن سعيد بن إياس الجريري عن حماد بن سلمة عن داود بن شبيب عن الفضل بن الحباب الجمحي عن الطبراني","محجن بن الأدرع السلمي"
"18885","مَنِ اسْمُهُ مِرْدَاسٌ  مِرْدَاسٌ الْأَسْلَمِيُّ  708  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ جَعْفَرٍ الْقَتَّاتُ الْكُوفِيُّ ،  ثَنَا  عَبْدُ الْحَمِيدِ         [20/299]      بْنُ صَالِحٍ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  مِرْدَاسٍ الْأَسْلَمِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَذْهَبُ الصَّالِحُونَ أَسْلَافًا حَتَّى لَا يَبْقَى إِلَّا  حُثَالَةٌ  كَحُثَالَةِ  التَّمْرِ وَالشَّعِيرِ ، لَا  يُبَالِي  اللهُ بِهِمْ  .","","Al-Mu'jam al-Kabir 708","","مرداس بن مالك الأسلمي عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن حفص بن غياث النخعي عن عبد الحميد بن صالح البرجمي عن الحسين بن جعفر القتات عن الطبراني","مرداس الأسلمي"
"18886","709  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالَا :  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدٌ ،  عَنْ  بَيَانَ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  مِرْدَاسٍ الْأَسْلَمِيِّ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَذْهَبُ الصَّالِحُونَ أَسْلَافًا ، وَيُقْبَضُ الصَّالِحُونَ الْأَوَّلَ فَالْأَوَّلَ  ، حَتَّى تَبْقَى  حُثَالَةٌ  كَحُثَالَةِ  التَّمْرِ وَالشَّعِيرِ ، لَا  يُبَالِي  اللهُ بِهِمْ  .","","Al-Mu'jam al-Kabir 709","","مرداس بن مالك الأسلمي عن قيس بن أبي حازم عن بيان بن بشر الأحمسي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن عبد الله بن أحمد بن حنبل عن الطبراني","مرداس الأسلمي"
"18887","مِرْدَاسُ بْنُ عُرْوَةَ  710  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  جَعْفَرُ بْنُ حُمَيْدٍ ،  ثَنَا  الْوَلِيدُ بْنُ أَبِي ثَوْرٍ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  مِرْدَاسِ بْنِ عُرْوَةَ ، قَالَ :  رَمَى  رَجُلٌ  أَخَاهُ فَفَرَّ ، فَوَجَدْنَاهُ عِنْدَ  أَبِي بَكْرٍ  ، فَانْطَلَقْنَا بِهِ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَقَادَنَا مِنْهُ  .","","Al-Mu'jam al-Kabir 710","","مرداس بن عروة العامري عن زياد بن علاقة الثعلبي عن الوليد بن عبد الله بن أبي ثور المرهبي عن جعفر بن حميد زنبقة عن عبد الله بن أحمد الجواليقي عن الطبراني","مرداس بن عروة"
"18888","مَنِ اسْمُهُ مُنْقَعٌ  مُنْقَعٌ التَّيْمِيُّ  711  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ،  ثَنَا  أَبُو غَسَّانَ النَّهْدِيُّ  ، ""  زَعَمُوا أَنَّهُ يَعْنِي  الْمُنْقَعَ بْنُ تَمِيمٍ  "" .         [20/300]","","Al-Mu'jam al-Kabir 711","","","منقع التيمي"
"18889","712  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ ،  ثَنَا  سَيْفُ بْنُ هَارُونَ الْبُرْجُمِيُّ ،  ثَنَا  عِصْمَةُ بْنُ بِشْرٍ الْبُرْجُمِيُّ ،  أَخْبَرَنِي  الْفَزَعُ  ، - قَالَ  سَيْفٌ  : أَظُنُّهُ قَدْ شَهِدَ  الْقَادِسِيَّةَ  -  عَنِ  الْمُنْقَعِ قَالَ :  أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِصَدَقَةِ إِبِلِنَا ، فَأَمَرَ بِهَا فَقُبِضَتْ ، فَقُلْتُ : إِنَّ فِيهَا نَاقَتَيْنِ هَدِيَّةً لَكَ ، فَعَزَلْتُ الْهَدِيَّةُ مِنَ الصَّدَقَةِ ، فَمَكَثَ أَيَّامًا وَخَاضَ النَّاسُ : أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَاعِثٌ  خَالِدَ بْنَ الْوَلِيدِ  إِلَى  رَقِيقِ  مِصْرَ  - أَوْ قَالَ :  مِصْرَ  ،  شَكَّ  أَبُو غَسَّانَ  - فَيُصَدِّقُهُمْ ، فَقُلْتُ : وَاللهِ إِنَّ لَنَا وَمَا عِنْدَ أَهْلِنَا مِنْ مَالٍ وَلَا صَدَقَتَهُمْ هَاهُنَا ، فَأَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ عَلَى نَاقَةٍ لَهُ ، وَمَعَهُ  أَسْوَدٌ  قَدْ حَاذَى رَأْسُهُ رَأْسَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مَا رَأَيْتُ أَحَدًا مِنَ النَّاسِ أَطْوَلَ مِنْهُ ، فَلَمَّا دَنَوْتُ كَأَنَّهُ أَهْوَى إِلَيَّ ، فَكَفَّهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقُلْتُ : إِنَّ النَّاسَ قَدْ خَاضُوا فِي كَذَا وَكَذَا ، فَرَفَعَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَدَهُ حَتَّى نَظَرْتُ إِلَى بَيَاضِ إِبْطَيْهِ ، فَقَالَ :  اللَّهُمَّ لَا أُحِلُّ لَهُمْ أَنْ يَكْذِبُوا عَلَيَّ  قَالَ  الْمُنَقَّعُ  : "" فَلَمْ أُحَدِّثْ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا حَدِيثًا نَطَقَ بِهِ كِتَابٌ ، أَوْ جَرَتْ بِهِ سُنَّةٌ ، يُكْذَبُ عَلَيْهِ فِي حَيَاتِهِ ، فَكَيْفَ بَعْدَ مَوْتِهِ ؟  .  في طبعة مكتبة ابن تيمية : (المفرع) والمثبت من النسخة الخطية وينظر مصادر التخريج والترجمة . والله أعلم .","","Al-Mu'jam al-Kabir 712","","منقع بن الحصين السعدي عن فزع عن عصمة بن بشير البرجمي عن سيف بن هارون البرجمي عن زكريا بن يحيى زحمويه عن عبد الله بن أحمد بن حنبل عن الطبراني","منقع التيمي"
"18890","قَيْسُ بْنُ أَبِي حَازِمٍ  ، عَنِ  الْمُسْتَوْرِدِ بْنِ شَدَّادٍ الْفِهْرِيِّ  إِسْمَاعِيلُ  ، عَنْ  قَيْسٍ  713  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ ، (  ح  )  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ، قَالَا :  ثَنَا  سُفْيَانُ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنِ  الْمُسْتَوْرِدِ الْفِهْرِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا الدُّنْيَا فِي الْآخِرَةِ إِلَّا كَمَا يَجْعَلُ أَحَدُكُمْ إِصْبَعَهُ فِي الْبَحْرِ فَلْيَنْظُرْ بِمَ يَرْجِعُ  ؟  .","","Al-Mu'jam al-Kabir 713","","المستورد بن شداد الفهري عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","إسماعيل عن قيس"
"18891","714  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى  ثَنَا  إِسْمَاعِيلُ ،  حَدَّثَنِي  قَيْسٌ قَالَ :  سَمِعْتُ  الْمُسْتَوْرِدَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا الدُّنْيَا فِي الْآخِرَةِ إِلَّا مِثْلُمَا يَجْعَلُ أَحَدُكُمْ إِصْبَعَهُ فِي الْبَحْرِ  ، فَلْيَنْظُرْ بِمَ يَرْجِعُ إِلَيْهِ ؟ "" فَقَبَضَ لِي عَلَى مِفْصَلَيْنِ مِنَ السَّبَّابَةِ  .  في طبعة مكتبة ابن تيمية : (بن) والمثبت من النسخة الخطية .","","Al-Mu'jam al-Kabir 714","","المستورد بن شداد الفهري عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","إسماعيل عن قيس"
"18892","715  -  حَدَّثَنَا  الْمِقْدَادُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  أَنَا  ابْنُ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ،  عَنِ  الْمُسْتَوْرِدِ ، أَخِي بَنِي فِهْرٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا الدُّنْيَا فِي الْآخِرَةِ إِلَّا مِثْلُ مَا يَجْعَلُ أَحَدُكُمْ إِصْبَعَهُ فِي هَذَا الْبَحْرِ ، فَلْيَنْظُرْ بِمَ يَرْجِعُ  ؟  .         [20/302]","","Al-Mu'jam al-Kabir 715","","المستورد بن شداد الفهري عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن مروان بن معاوية الفزاري عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","إسماعيل عن قيس"
"18893","716  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ، قَالَ :  سَمِعْتُ  الْمُسْتَوْرِدَ ، يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَشَارَ بِإِصْبَعِهِ - :  وَاللهِ مَا الدُّنْيَا فِي الْآخِرَةِ إِلَّا مِثْلُ مَا يَجْعَلُ أَحَدُكُمْ إِصْبَعَهُ فِي الْبَحْرِ ، ثُمَّ يُخْرِجُهَا ، فَلْيَنْظُرْ بِمَ يَرْجِعُ  ؟  .","","Al-Mu'jam al-Kabir 716","","المستورد بن شداد الفهري عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","إسماعيل عن قيس"
"18894","717  -  حَدَّثَنَا  الْحَسَنُ بْنُ الْعَبَّاسِ الرَّازِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُسْلِمِ بْنِ وَارَةَ ،  ثَنَا  مُحَمَّدُ بْنُ سَعِيدِ بْنِ سَابِقٍ ،  ثَنَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ الْمُهَاجِرِ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنِ  الْمُسْتَوْرِدِ بْنِ شَدَّادٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا الدُّنْيَا فِي الْآخِرَةِ إِلَّا كَمَا يَمْشِي أَحَدُكُمْ إِلَى  الْيَمِّ  فَيُدْخِلُ إِصْبَعَهُ  .","","Al-Mu'jam al-Kabir 717","","المستورد بن شداد الفهري عن قيس بن أبي حازم عن إبراهيم بن مهاجر بن جابر البجلي عن عمرو بن أبي قيس عن محمد بن سعيد القزويني عن ابن وارة عن الجمال الحسن بن العباس عن الطبراني","إسماعيل عن قيس"
"18895","718  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ أَحْمَدَ بْنِ عَمْرٍو الْوَكِيعِيُّ ،  ثَنَا  سَعِيدُ بْنُ زُنْبُورٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ مُجَالِدٍ ،  عَنْ  بَيَانٍ ، وَإِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنِ  الْمُسْتَوْرِدِ بْنِ شَدَّادٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَذْهَبُ الصَّالِحُونَ الْأَوَّلَ فَالْأَوَّلَ ، حَتَّى يَبْقَى مِثْلُ  حُثَالَةِ  التَّمْرِ لَا  يُبَالِي  اللهُ بِهَا  .","","Al-Mu'jam al-Kabir 718","","المستورد بن شداد الفهري عن قيس بن أبي حازم عن بيان بن بشر الأحمسي عن إسماعيل بن مجالد بن سعيد الهمداني عن سعد بن زنبور البغدادي عن إبراهيم بن أحمد بن عمر الوكيعي عن الطبراني","إسماعيل عن قيس"
"18896","719  -  حَدَّثَنَا  عُبَيْدُ بْنُ مُحَمَّدِ بْنِ صُبَيْحٍ الزَّيَّاتُ الْكُوفِيُّ ،  ثَنَا  عُمَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ ،  ثَنَا  أَبِي  ،  ثَنَا  شَرِيكٌ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنِ  الْمُسْتَوْرِدِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَذْهَبُ الصَّالِحُونَ أَسْلَافًا  .         [20/303]","","Al-Mu'jam al-Kabir 719","","المستورد بن شداد الفهري عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن شريك بن عبد الله النخعي عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن عبيد بن صبيح الكناني عن الطبراني","إسماعيل عن قيس"
"18897","720  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَمْرُو بْنُ عَوْنٍ ،  ثَنَا  أَبُو بَكْرٍ الدَّاهِرِيُّ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنِ  الْمُسْتَوْرِدِ الْفِهْرِيِّ ،  أَنَّ  رَجُلًا  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَبِهِ النَّقْرَسُ فَشَكَا إِلَيْهِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَذَّبَتْكَ  الْهَوَاجِرُ  .","","Al-Mu'jam al-Kabir 720","","المستورد بن شداد الفهري عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن عبد الله بن حكيم الداهري عن عمرو بن عون الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","إسماعيل عن قيس"
"18898","721  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَمْرُو بْنُ عَوْنٍ ،  ثَنَا  أَبُو بَكْرٍ الدَّاهِرِيُّ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنِ  الْمُسْتَوْرِدِ الْفِهْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  رُدُّوا الْمِخْيَطَ  وَالْخِيَاطَ  ، مَنْ غَلَّ مِخْيَطًا أَوْ  خِيَاطًا  كُلِّفَ  أَنْ يَجِيءَ بِهِ وَلَيْسَ بِجَاءٍ  .","","Al-Mu'jam al-Kabir 721","","المستورد بن شداد الفهري عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن عبد الله بن حكيم الداهري عن عمرو بن عون الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","إسماعيل عن قيس"
"18899","مُجَالِدُ بْنُ سَعِيدٍ  ، عَنْ  قَيْسٍ  ، عَنِ  الْمُسْتَوْرِدِ  722  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، وَيُوسُفُ الْقَاضِي ، قَالَا :  ثَنَا  مُسَدَّدٌ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  مُجَالِدٍ ،  عَنْ  قَيْسٍ ،  عَنِ  الْمُسْتَوْرِدِ - رَجُلٌ مِنْ بَنِي فِهْرٍ كَانَتْ لَهُ صُحْبَةٌ - أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  وَالَّذِي نَفْسِي بِيَدِهِ ، مَا الدُّنْيَا فِي الْآخِرَةِ إِلَّا كَرَجُلٍ وَضَعَ إِصْبَعَهُ فِي  الْيَمِّ  ، ثُمَّ رَجَعَتْ إِلَيْهِ  .         [20/304]","","Al-Mu'jam al-Kabir 722","","المستورد بن شداد الفهري عن قيس بن أبي حازم عن مجالد بن سعيد عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجالد بن سعيد عن قيس عن المستورد"
"18900","723  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، وَيُوسُفُ الْقَاضِي ، قَالَا :  ثَنَا  مُسَدَّدٌ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  مُجَالِدٍ ،  عَنْ  قَيْسٍ ،  عَنِ  الْمُسْتَوْرِدِ ، قَالَ :  إِنِّي لَفِي الرَّكْبِ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَتَى عَيْنُهُ عَلَى سَخْلَةٍ مَنْبُوذَةٍ أَلْقَوْهَا ، فَقَالَ : "" أَتَرَوْنَ هَذِهِ هَانَتْ عَلَى أَهْلِهَا ؟ "" قَالُوا : مِنْ هَوَانِهَا أَلْقَوْهَا قَالَ :  وَالَّذِي نَفْسِي بِيَدِهِ لَلدُّنْيَا أَهْوَنُ عَلَى اللهِ مِنْ هَذِهِ عَلَى أَهْلِهَا  .","","Al-Mu'jam al-Kabir 723","","المستورد بن شداد الفهري عن قيس بن أبي حازم عن مجالد بن سعيد عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجالد بن سعيد عن قيس عن المستورد"
"18901","724  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ الرَّحْمَنِ الْأَرْحَبِيُّ ،  عَنْ  عُبَيْدَةَ بْنِ الْأَسْوَدِ ،  عَنْ  مُجَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنِ  الْمُسْتَوْرِدِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بُعِثْتُ أَنَا وَالسَّاعَةُ كَهَاتَيْنِ السَّبَّابَةِ وَالْوُسْطَى  .","","Al-Mu'jam al-Kabir 724","","المستورد بن شداد الفهري عن قيس بن أبي حازم عن مجالد بن سعيد عن عبيدة بن الأسود بن سعيد الهمداني عن يحيى بن عبد الرحمن بن مالك الأرحبي عن أبو كريب محمد بن العلاء عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجالد بن سعيد عن قيس عن المستورد"
"18902","عَبْدُ الرَّحْمَنِ بْنُ جُبَيْرِ بْنِ نُفَيْرٍ  ، عَنِ  الْمُسْتَوْرِدِ  725  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو خَلِيفَةَ قَالَا :  ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنِ  الْحَارِثِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ جُبَيْرٍ ، قَالَ : كُنَّا فِي مَجْلِسٍ فِيهِ  الْمُسْتَوْرِدُ  ،  وَعَمْرُو بْنُ غَيْلَانَ بْنِ سَلَمَةَ  ، فَقَالَ  الْمُسْتَوْرِدُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ وَلِيَ لَنَا عَمَلًا وَلَمْ يَكُنْ لَهُ زَوْجَةٌ فَلْيَتَّخِذْ زَوْجَةً  ، وَمَنْ لَمْ يَكُنْ لَهُ خَادِمٌ فَلْيَتَّخِذْ لَهُ خَادِمًا ، وَمَنْ لَمْ يَكُنْ لَهُ مَسْكَنٌ فَلْيَتَّخِذْ لَهُ مَسْكَنًا ، وَمَنْ لَمْ يَكُنْ لَهُ دَابَّةٌ فَلْيَتَّخِذْ دَابَّةً "" . قَالَ  أَبُو بَكْرٍ  :         [20/305]      أَكْثَرْتَ يَا رَسُولَ اللهِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَنْ أَصَابَ سِوَى ذَلِكَ فَهُوَ غَالٌّ  .","","Al-Mu'jam al-Kabir 725","","المستورد بن شداد الفهري عن عبدالرحمن بن جبير الفرضي عن الحارث بن يزيد الحضرمي عن عبد الله بن لهيعة عن عبد الله بن مسلمة القعنبي عن الفضل بن الحباب الجمحي عن الطبراني","عبد الرحمن بن جبير بن نفير عن المستورد"
"18903","726  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  ابْنُ لَهِيعَةَ ،  ثَنَا  ابْنُ هُبَيْرَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ جُبَيْرِ بْنِ نُفَيْرٍ ، قَالَ : كُنْتُ فِي مَجْلِسٍ فِيهِ  الْمُسْتَوْرِدُ بْنُ شَدَّادٍ  ،  وَعَمْرُو بْنُ غَيْلَانَ  ، فَسَمِعْتُ  الْمُسْتَوْرِدَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ وَلِيَ لَنَا عَمَلًا فَلَمْ يَكُنْ لَهُ زَوْجَةٌ فَلْيَتَزَوَّجْ  ، أَوْ خَادِمٌ فَلْيَتَّخِذْ خَادِمًا ، أَوْ مَسْكَنٌ فَلْيَتَّخِذْ مَسْكَنًا ، أَوْ دَابَّةٌ فَلْيَتَّخِذْ دَابَّةً ، فَمَنْ أَصَابَ سِوَى ذَلِكَ فَهُوَ غَالٌّ أَوْ سَارِقٌ  .","","Al-Mu'jam al-Kabir 726","","المستورد بن شداد الفهري عن عبد الرحمن بن جبير الحضرمي عن عبد الله بن هبيرة السبئي عن عبد الله بن لهيعة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","عبد الرحمن بن جبير بن نفير عن المستورد"
"18904","727  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ،  ثَنَا  مُوسَى بْنُ مَرْزُوقٍ         [20/306]      الرَّقِّيُّ  ،  ثَنَا  الْمُعَافَى بْنُ عِمْرَانَ ،  ثَنَا  الْأَوْزَاعِيُّ ،  ثَنَا  الْحَارِثُ بْنُ يَزِيدَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ جُبَيْرِ بْنِ نُفَيْرٍ ،  عَنِ  الْمُسْتَوْرِدِ بْنِ شَدَّادٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ كَانَ لَنَا عَامِلًا فَلْيَكْتَسِبْ زَوْجَةً  ، فَإِنْ لَمْ يَكُنْ لَهُ خَادِمٌ فَلْيَكْتَسِبْ خَادِمًا ، وَمَنْ لَمْ يَكُنْ لَهُ مَسْكَنٌ فَلْيَكْتَسِبْ مَسْكَنًا  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( موسى بن مروان )","","Al-Mu'jam al-Kabir 727","","المستورد بن شداد الفهري عن عبد الرحمن بن جبير الحضرمي عن الحارث بن يزيد الحضرمي عن أبو عمرو الأوزاعي عن المعافى بن عمران عن موسى بن مروان التمار عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","عبد الرحمن بن جبير بن نفير عن المستورد"
"18905","أَبُو عَبْدِ الرَّحْمَنِ الْحُبُلِيُّ  ، عَنِ  الْمُسْتَوْرِدِ  728  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِي ، (  ح  )  وَحَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ، قَالَا :  ثَنَا  ابْنُ لَهِيعَةَ ،  ثَنَا  يَزِيدُ بْنُ عَمْرٍو الْمَعَافِرِيُّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنِ  الْمُسْتَوْرِدِ بْنِ شَدَّادٍ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" إِذَا تَوَضَّأَ خَلَّلَ أَصَابِعَ رِجْلَيْهِ بِخِنْصَرِهِ  .","","Al-Mu'jam al-Kabir 728","","المستورد بن شداد الفهري عن عبد الله بن يزيد المعافري عن يزيد بن عمرو المعافري عن عبد الله بن لهيعة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","أبو عبد الرحمن الحبلي عن المستورد"
"18906","حُدَيْجُ بْنُ عَمْرٍو  ، عَنِ  الْمُسْتَوْرِدِ  729  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  سُلَيْمَانُ بْنُ أَحْمَدَ الْوَاسِطِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنِ  الْحَارِثِ بْنِ يَزِيدَ ،  عَنْ  حُدَيْجِ بْنِ عَمْرٍو ، قَالَ :  سَمِعْتُ  الْمُسْتَوْرِدَ بْنَ شَدَّادٍ ، يُحَدِّثُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ         [20/307]      وَسَلَّمَ قَالَ :  لِكُلِّ أُمَّةٍ أَجَلٌ ، وَإِنَّ أَجَلَ أُمَّةِ  مُحَمَّدٍ  مِائَةُ سَنَةٍ  ، قَالَ : "" فَإِذَا جَازَتِ الْمِائَةَ أَتَاهَا مَا وَعَدَهَا اللهُ بِهِ  .","","Al-Mu'jam al-Kabir 729","","المستورد بن شداد الفهري عن حديج بن أبي عمرو المصري عن الحارث بن سعيد العتقي عن عبد الله بن لهيعة عن الوليد بن مسلم القرشي عن سليمان بن أحمد الدمشقي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","حديج بن عمرو عن المستورد"
"18907","730  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  كَامِلُ بْنُ طَلْحَةَ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  حُدَيْجِ بْنِ أَبِي عَمْرٍو ، قَالَ :  سَمِعْتُ  الْمُسْتَوْرِدَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ لِكُلِّ أُمَّةٍ أَجَلًا ، وَإِنَّ أَجَلَ أُمَّتِي مِائَةُ سَنَةٍ  ، فَإِذَا مَرَّتْ عَلَى أُمَّتِي مِائَةُ سَنَةٍ ، أَتَاهَا مَا وَعَدَهَا اللهُ  .  قَالَ  ابْنُ لَهِيعَةَ  : ""  يَعْنِي كَثْرَةَ الْفِتَنِ  "" .","","Al-Mu'jam al-Kabir 730","","المستورد بن شداد الفهري عن حديج بن أبي عمرو المصري عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن كامل بن طلحة الجحدري عن موسى بن هارون الحمال عن الطبراني","حديج بن عمرو عن المستورد"
"18908","أَبُو إِسْحَاقَ السَّبِيعِيُّ  ، عَنِ  الْمُسْتَوْرِدِ  .  731  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  ثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ زَحْرٍ ،  عَنْ  أَبِي إِسْحَاقَ الْهَمْدَانِيِّ ،  عَنِ  الْمُسْتَوْرِدِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا مَثَلُ الدُّنْيَا فِي الْآخِرَةِ إِلَّا كَمَا يُدْخِلُ رَجُلٌ إِصْبَعَهُ فِي الْبَحْرِ ثُمَّ يُخْرِجُهَا ، فَبِمَ يَرْجِعُ  ؟  .","","Al-Mu'jam al-Kabir 731","","المستورد بن شداد الفهري عن أبو إسحاق السبيعي عن عبيد الله بن زحر الضمري عن يحيى بن أيوب الغافقي عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","أبو إسحاق السبيعي عن المستورد"
"18909","[20/308]      عَامِرٌ  الشَّعْبِيُّ  ، عَنِ  الْمُسْتَوْرِدِ  732  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ شَبِيبٍ الْعَسَّالُ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  حِبَّانُ بْنُ عَلِيٍّ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  الْمُسْتَوْرِدِ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  بُعِثْتُ فِي  نَفَسِ  السَّاعَةِ ، فَسَبَقْتُهَا كَمَا تَسْبِقُ هَذِهِ  ، وَأَشَارَ بِإِصْبَعَيْهِ السَّبَّابَةِ وَالْوُسْطَى  .","","Al-Mu'jam al-Kabir 732","","المستورد بن شداد الفهري عن الشعبي عن مجالد بن سعيد عن حبان بن علي العنزي عن إسماعيل بن عمرو البجلي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","عامر الشعبي عن المستورد"
"18910","733  -  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ التُّسْتَرِيُّ ،  ثَنَا  طَاهِرُ بْنُ خَالِدِ بْنِ نِزَارٍ ،  ثَنَا  آدَمُ بْنُ أَبِي إِيَاسٍ ،  ثَنَا  بَكْرُ بْنُ خُنَيْسٍ ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  الْمُسْتَوْرِدِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا أَخَذَتِ الدُّنْيَا مِنَ الْآخِرَةِ إِلَّا كَمَا أَخَذَ مِخْيَطٌ غُرِسَ فِي الْبَحْرِ مِنْ مَائِهِ  .","","Al-Mu'jam al-Kabir 733","","المستورد بن شداد الفهري عن الشعبي عن أشعث بن سوار عن بكر بن خنيس الكوفي عن آدم بن أبي إياس عن طاهر بن خالد بن نزار الأيلي عن سعيد بن عبد الرحمن التستري عن الطبراني","عامر الشعبي عن المستورد"
"18911","وَقَّاصُ بْنُ رَبِيعَةَ  ، عَنِ  الْمُسْتَوْرِدِ  734  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  سُلَيْمَانَ بْنِ مُوسَى ،  عَنْ  وَقَّاصِ بْنِ رَبِيعَةَ ،  عَنِ  الْمُسْتَوْرِدِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ  أَكَلَ  بِأَخِيهِ أَكْلَةً ، أَطْعَمَهُ اللهُ أَكْلَةً مِثْلَهَا مِنْ نَارِ  جَهَنَّمَ  .","","Al-Mu'jam al-Kabir 734","","المستورد بن شداد الفهري عن وقاص بن ربيعة العنسي عن سليمان بن موسى الأشدق عن ابن جريج عن أبو عاصم النبيل عن أبو مسلم الكجي عن الطبراني","وقاص بن ربيعة عن المستورد"
"18912","[20/309]      735  -  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ الْبَاقِي الْمِصِّيصِيُّ ، وَإِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ ، قَالَا :  ثَنَا  يَحْيَى بْنُ عُثْمَانَ الْحِمْصِيُّ ،  ثَنَا  بَقِيَّةُ ،  عَنِ  ابْنِ ثَوْبَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَقَّاصِ بْنِ رَبِيعَةَ ، عَنِ الْمُسْتَوْرِدِ  أَنَّهُ حَدَّثَهُ  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ أَكَلَ بِرَجُلٍ مُسْلِمٍ أَكْلَةً فِي الدُّنْيَا ، أَطْعَمَهُ اللهُ مِثْلَهَا فِي  جَهَنَّمَ  ، وَمَنْ كُسِيَ بِرَجُلٍ مُسْلِمٍ ثَوْبًا كَسَاهُ اللهُ مِثْلَهُ مِنْ  جَهَنَّمَ ،  وَمَنْ قَامَ بِمُسْلِمٍ مَقَامَ رِيَاءٍ أَقَامَهُ اللهُ مَقَامَ  سُمْعَةٍ  وَرِيَاءٍ  .","","Al-Mu'jam al-Kabir 735","","المستورد بن شداد الفهري عن وقاص بن ربيعة العنسي عن مكحول بن أبي مسلم عن ثابت بن ثوبان العبسي عن عبد الرحمن بن ثابت العنسي عن بقية بن الوليد عن يحيى بن عثمان بن سعيد الحمصي عن إبراهيم بن محمد بن عرق الحمصي عن الطبراني","وقاص بن ربيعة عن المستورد"
"18913","عَبْدُ الْكَرِيمِ بْنُ الْحَارِثِ الْمِصْرِيُّ  ، عَنِ  الْمُسْتَوْرِدِ  736  -  حَدَّثَنَا  عُمَرُ بْنُ عَبْدِ الْعَزِيزِ بْنِ مِقْلَاصٍ الْمِصْرِيُّ ،  ثَنَا  أَبِي ،  ثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ، (  ح  )  وَحَدَّثَنَا  إِبْرَاهِيمُ بْنُ مَتُّوَيْهِ الْأَصْبَهَانِيُّ ،  ثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ وَهْبٍ ،  ثَنَا  عَمِّي عَبْدُ اللهِ بْنُ وَهْبٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ شُرَيْحٍ ،  عَنْ  عَبْدِ الْكَرِيمِ بْنِ الْحَارِثِ ،  أَنَّ  الْمُسْتَوْرِدَ بْنَ شَدَّادٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : ""  تَقُومُ السَّاعَةُ  وَالرُّومُ  أَكْثَرُ النَّاسِ  فَبَلَغَ ذَلِكَ  عَمْرَو بْنَ الْعَاصِ  فَقَالَ : "" مَا هَذِهِ الْأَحَادِيثُ الَّتِي تُذْكَرُ عَنْكَ ؟ "" فَقَالَ لَهُ  الْمُسْتَوْرِدُ  : قُلْتُ الَّذِي سَمِعْتُ مِنْ         [20/310]      رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ عَمْرٌو : ""  لَئِنْ قُلْتَ ذَاكَ لِأَحْلَمِ النَّاسِ عِنْدَ فِتْنَةٍ  ، وَأَصْبَرِ النَّاسِ عِنْدَ مُصِيبَةٍ ، وَخَيْرِ النَّاسِ لِضُعَفَائِهِمْ وَلِمَسَاكِينِهِمْ  "" .","","Al-Mu'jam al-Kabir 736","","عمرو بن العاص بن وائل السهمي عن عبد الكريم بن الحارث بن يزيد الحضرمي عن عبد الرحمن بن شريح المعافري عن عبد الله بن وهب المصري عن عبد العزيز بن عمران المصري عن عمر بن عبد العزيز الخزاعي عن الطبراني","عبد الكريم بن الحارث المصري عن المستورد"
"18914","عُلَيُّ بْنُ رَبَاحٍ اللَّخْمِيُّ  ، عَنِ  الْمُسْتَوْرِدِ  737  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ حَمْدَانَ الْحَنَفِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْمُخَرِّمِيُّ ،  ثَنَا  حُجَيْنُ بْنُ الْمُثَنَّى ،  ثَنَا  لَيْثُ بْنُ سَعْدٍ ،  عَنْ  مُوسَى بْنِ عُلَيٍّ ،  عَنْ  أَبِيهِ ،  عَنِ  الْمُسْتَوْرِدِ الْفِهْرِيِّ ،  أَنَّهُ قَالَ  لِعَمْرِو بْنِ الْعَاصِ  :  تَقُومُ السَّاعَةُ  وَالرُّومُ  أَكْثَرُ النَّاسِ  ، قَالَ : انْظُرْ مَا تَقُولُ ؟ قَالَ : لَا أَقُولُ إِلَّا مَا سَمِعْتُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَذْهَبُ الصَّالِحُونَ أَسْلَافًا ، وَتَبْقَى  حُثَالَةٌ  كَحُثَالَةِ  التَّمْرِ وَالشَّعِيرِ ، لَا  يُبَالِي  اللهُ بِهِمْ  .","","Al-Mu'jam al-Kabir 737","","المستورد بن شداد الفهري عن علي بن رباح اللخمي عن موسى بن علي اللخمي عن الليث بن سعد عن حجين اللؤلؤي عن محمد بن عبد الله بن المبارك المخرمي عن العباس بن حمدان الأصبهاني عن الطبراني","علي بن رباح اللخمي عن المستورد"
"18915","مَنِ اسْمُهُ مِخْنَفُ  مِخْنَفُ بْنُ سُلَيْمٍ الْغَامِدِيُّ  738  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنِ  ابْنِ عَوْنٍ ،  عَنْ  رَجُلٍ ، مِنْ  أَهْلِ الْكُوفَةِ  يُقَالُ لَهُ : أَبُو رَمْلَةَ ،  عَنْ  مِخْنَفِ بْنِ سُلَيْمٍ ، قَالَ :  خَطَبَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِعَرَفَةَ  فَقَالَ :  عَلَى كُلِّ أَهْلِ بَيْتٍ مِنَ الْمُسْلِمِينَ أَضْحَى  وَعَتِيرَةٌ  ، تَدْرُونَ مَا  الْعَتِيرَةُ  ؟ الَّتِي تَقُولُونَ  الرَّجَبِيَّةَ  .         [20/311]","","Al-Mu'jam al-Kabir 738","","مخنف بن سليم الغامدي عن عامر أبو رملة ، شيخ لابن عون عن عبد الله بن عون بن أرطبان عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مخنف بن سليم الغامدي"
"18916","739  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى بْنِ مُعَاذٍ ،  ثَنَا  أَبِي  ، (  ح  )  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُعَاذٌ ،  عَنِ  ابْنِ عَوْنٍ ، قَالَ :  أَنْبَأَنِي  أَبُو رَمْلَةَ ،  عَنْ  مِخْنَفِ بْنِ سُلَيْمٍ ، قَالَ :  كُنَّا وُقُوفًا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  يَا أَيُّهَا النَّاسُ ، إِنَّ عَلَى كُلِّ أَهْلِ بَيْتٍ فِي كُلِّ عَامٍ أَضْحَى  وَعَتِيرَةً  ، أَتَدْرُونَ مَا  الْعَتِيرَةُ  ؟ هِيَ الَّتِي يُسَمِّيهَا النَّاسُ  الرَّجَبِيَّةَ  .","","Al-Mu'jam al-Kabir 739","","مخنف بن سليم الغامدي عن عامر أبو رملة ، شيخ لابن عون عن عبد الله بن عون بن أرطبان عن معاذ بن معاذ بن نصر عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","مخنف بن سليم الغامدي"
"18917","740  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  ابْنُ جُرَيْجٍ ،  أَخْبَرَنِي  عَبْدُ الْكَرِيمِ ،  عَنْ  حَبِيبِ بْنِ مِخْنَفٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  انْتَهَيْتُ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمَ عَرَفَةَ وَهُوَ يَقُولُ : "" هَلْ تَعْرِفُونَهَا ؟ "" وَلَا أَدْرِي مَا رَجَعُوا عَلَيْهِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  عَلَى أَهْلِ كُلِّ بَيْتٍ أَنْ يَذْبَحُوا شَاةً فِي كُلِّ رَجَبٍ  ، وَفِي كُلِّ أَضْحَى شَاةٌ  .","","Al-Mu'jam al-Kabir 740","","مخنف بن سليم الغامدي عن حبيب بن مخنف الغامدي عن عبد الكريم بن أبي المخارق عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","مخنف بن سليم الغامدي"
"18918","مَنِ اسْمُهُ مُحَيِّصَةُ  مُحَيِّصَةُ بْنُ مَسْعُودٍ الْأَنْصَارِيُّ  741  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى بْنِ حَمَّادٍ الْبَرْبَرِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ         [20/312]      بْنُ صَالِحٍ الْأَزْدِيُّ ،  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ إِسْحَاقَ ،  حَدَّثَنِي  مَوْلَى يِزَيْدَ بْنِ ثَابِتٍ ،  حَدَّثَتْنِي  بِنْتُ مُحَيِّصَةَ ،  عَنْ  أَبِيهَا  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ ظَفِرْتُمْ بِهِ مِنْ رِجَالِ يَهُودَ فَاقْتُلُوهُ  . فَوَثَبَ  مُحَيِّصَةُ  عَلَى  ابْنِ سُنَيْنَةَ  - رَجُلٌ مِنْ تُجَّارِ يَهُودَ كَانَ يُلَابِسُهُمْ وَيُبَايِعُهُمْ - فَقَتَلَهُ ، وَكَانَ  حُوَيِّصَةُ  إِذْ ذَاكَ لَمْ يُسْلِمْ ، وَكَانَ أَسَنَّ مِنْ  مُحَيِّصَةَ  ، فَلَمَّا قَتَلَهُ جَعَلَ  حُوَيِّصَةُ  يَضْرِبُهُ وَيَقُولُ : أَيْ عَدُوَّ اللهِ قَتَلْتَهُ ؟ أَمَا وَاللهِ لَرُبَّ شَحْمٍ فِي بَطْنِكَ مِنْ مَالِهِ ، فَقُلْتُ : "" وَاللهِ لَوْ أَمَرَنِي بِقَتْلِكَ لَضَرَبْتُ عُنُقَكَ "" ، قَالَ : فَوَاللهِ إِنْ كَانَ لَأَوَّلَ إِسْلَامِ  حُوَيِّصَةَ  ، قَالَ : وَاللهِ لَئِنْ أَمَرَكَ  مُحَمَّدٌ  بِقَتْلِي لَتَقْتُلَنِي ؟ قَالَ  مُحَيِّصَةُ  : "" نَعَمْ وَاللهِ "" ، قَالَ  حُوَيِّصَةُ  : فَوَاللهِ إِنَّ دِينًا بَلَغَ هَذَا إِنَّهُ لَعَجَبٌ ، فَأَسْلَمَ  حُوَيِّصَةُ  .","","Al-Mu'jam al-Kabir 741","","محيصة بن مسعود بن كعب الخزرجي عن ابنة محيصة بن مسعود عن محمد بن أبي محمد الأنصاري عن محمد بن إسحاق عن يونس بن بكير عن عبد الرحمن بن صالح العتكي عن محمد بن موسى بن حماد البربري عن الطبراني","محيصة بن مسعود الأنصاري"
"18919","742  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  أَبُو صَالِحٍ عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي حَبِيبٍ ،  عَنْ  أَبِي عُفَيْرٍ الْأَنْصَارِيِّ ،  عَنْ  مُحَمَّدِ بْنِ سَهْلِ بْنِ أَبِي حَثْمَةَ ،  عَنْ  مُحَيِّصَةَ بْنِ مَسْعُودٍ الْأَنْصَارِيِّ ، أَنَّهُ  كَانَ لَهُ غُلَامٌ حَجَّامٌ يُقَالُ لَهُ :  نَافِعٌ أَبُو طَيْبَةَ  ، فَانْطَلَقَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَسْأَلُهُ عَنْ خَرَاجِهِ ، فَقَالَ : "" لَا تَقْرَبْهُ "" ، فَرَدَّ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  اعْلِفْ بِهِ  النَّاضِحَ  ، اجْعَلْهُ فِي كِرْشِهِ  .","","Al-Mu'jam al-Kabir 742","","محيصة بن مسعود بن كعب الخزرجي عن محمد بن سهل بن أبي حثمة الأوسي عن أبو عفير الأنصاري مولى رافع بن خديج عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","محيصة بن مسعود الأنصاري"
"18920","743  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ،  ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  حَرَامِ بْنِ         [20/313]      سَاعِدَةَ ،  عَنْ  مُحَيِّصَةَ بْنِ مَسْعُودٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ مُحَيِّصَةَ  ، قَالَ :  كَانَ لِي غُلَامٌ حَجَّامٌ يُقَالُ لَهُ :  أَبُو طَيْبَةَ  ، فَكَسِبَ كَسْبًا كَثِيرًا ، فَلَمَّا نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ كَسْبِ الْحَجَّامِ ، اسْتَرْخَصَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَبَى عَلَيْهِ ، فَلَمْ يَزَلْ يُكَلِّمُهُ وَيَذْكُرُ لَهُ الْحَاجَةَ حَتَّى قَالَ لَهُ :  الْقِ كَسْبَهُ فِي بَطْنِ  نَاضِحِكَ  .","","Al-Mu'jam al-Kabir 743","","محيصة بن مسعود بن كعب الخزرجي عن سعد بن محيصة الأنصاري عن حرام بن سعد بن محيصة الحارثي عن الزهري عن محمد بن إسحاق عن يزيد بن هارون عن الحسن بن علي الريحاني عن محمد بن علي بن زيد الصائغ عن الطبراني","محيصة بن مسعود الأنصاري"
"18921","744  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  الْحُسَيْنُ بْنُ سَلَمَةَ بْنِ أَبِي كَبْشَةَ ،  ثَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  ثَنَا  رَبِيعَةُ بْنُ صَالِحٍ  ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  حَرَامِ بْنِ سَعْدِ بْنِ مُحَيِّصَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  أَنَّهُ اسْتَأْذَنَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي خَرَاجِ الْحَجَّامِ ، فَمَنَعَهُ إِيَّاهُ  ، فَلَمْ يَزَلْ يُرَاجِعُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَيَذْكُرُ لَهُ حَاجَتَهُ حَتَّى أَذِنَ لَهُ أَنْ يَعْلِفَهَ  نَاضِحَهُ  وَرَقِيقَهُ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( زمعة )","","Al-Mu'jam al-Kabir 744","","محيصة بن مسعود بن كعب الخزرجي عن سعد بن محيصة الأنصاري عن حرام بن سعد بن محيصة الحارثي عن الزهري عن زمعة بن صالح الجندي عن أبو عامر العقدي عن الحسين بن سلمة اليحمدي عن محمد بن صالح النرسي عن الطبراني","محيصة بن مسعود الأنصاري"
"18922","مُخَارِقٌ أَبُو قَابُوسَ .  745  -  حَدَّثَنَا  أَبُو حَصِينٍ مُحَمَّدُ بْنُ الْحُسَيْنِ الْوَدَاعِيُّ الْقَاضِي ،  ثَنَا  عَلِيُّ بْنُ حَكِيمٍ الْأَوْدِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  قَابُوسَ بْنِ مُخَارِقٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا  قُدِّسَتْ  أُمَّةٌ لَا يُؤْخَذُ فِيهَا لِلضَّعِيفِ حَقُّهُ غَيْرَ  مُتَعْتَعٍ  .","","Al-Mu'jam al-Kabir 745","","مخارق بن سليم الشيباني عن قابوس بن أبي المخارق الشيباني عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن علي بن حكيم بن ذبيان عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","مخارق أبو قابوس"
"18923","746  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ، (  ح  )  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ         [20/314]      سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  قَابُوسَ بْنِ مُخَارِقٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَجُلٌ  فَقَالَ : يَا رَسُولَ اللهِ ، الرَّجُلُ يَأْتِينِي يُرِيدُ مَالِي ؟ قَالَ : "" ذَكِّرْهُ اللهَ "" ، قَالَ : فَلَمْ يَذَّكَّرْ ؟ قَالَ :  فَاسْتَعِنْ عَلَيْهِ مَنْ حَوْلَكَ مِنَ الْمُسْلِمِينَ  ، قَالَ : فَإِنْ لَمْ يَكُنْ حَوْلِي أَحَدٌ ؟ قَالَ : "" فَاسْتَعِنْ عَلَيْهِ بِالسُّلْطَانِ "" ، قَالَ : فَإِنْ بَاعَنِي السُّلْطَانُ ؟ فَقَالَ : رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" قَاتِلْ دُونَ مَالِكَ حَتَّى تَكُونَ فِي شُهَدَاءِ الْآخِرَةِ أَوْ تَمْنَعَ ذَلِكَ  .  سقط من طبعة مكتبة ابن تيمية ، والمثبت من النسخة الخطية","","Al-Mu'jam al-Kabir 746","","مخارق بن سليم الشيباني عن قابوس بن أبي المخارق الشيباني عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","مخارق أبو قابوس"
"18924","747  -  حَدَّثَنَا  أَبُو عُبَيْدَةَ عَبْدُ الْوَارِثِ بْنُ إِبْرَاهِيمَ الْعَسْكَرِيُّ ،  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ أَبِي ثَوْرٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  قَابُوسَ بْنِ الْمُخَارِقِ ،  عَنْ  أَبِيهِ  ، قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ إِنْ جَاءَنِي رَجُلٌ يُرِيدُ مَالِي كَيْفَ تَأْمُرُنِي ؟ قَالَ : "" فَذَكِّرْهُ بِاللهِ "" ، قُلْتُ : أَرَأَيْتَ إِنْ فَعَلْتُ فَلَمْ يَنْتَهِ ؟ قَالَ : "" تَسْتَغِيثُ بِالْمُسْلِمِينَ "" ، قُلْتُ : أَرَأَيْتَ إِنْ فَعَلْتُ فَلَمْ أَجِدْ أَحَدًا مِنَ الْمُسْلِمِينَ ؟ قَالَ : "" تَسْتَغِيثُ بِالسُّلْطَانِ "" . قُلْتُ أَرَأَيْتَ إِنْ بَاعَنِي السُّلْطَانُ وَأَبَى إِلَّا أَنْ يَغْصِبَنِي مَالِي ؟ قَالَ :  فَقَاتِلْهُ حَتَّى تَمْنَعَ مَالَكَ أَوْ تَكُونَ مِنْ شُهَدَاءِ الْآخِرَةِ  .","","Al-Mu'jam al-Kabir 747","","مخارق بن سليم الشيباني عن قابوس بن أبي المخارق الشيباني عن سماك بن حرب البكري عن الوليد بن عبد الله بن أبي ثور المرهبي عن سليمان بن داود العتكي عن عبد الوارث بن إبراهيم العسكري عن الطبراني","مخارق أبو قابوس"
"18925","748  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ الطَّائِيُّ ،  ثَنَا  عَبْدُ الْمَلِكِ بْنُ عَبْدِ رَبِّهِ الطَّائِيُّ ،  ثَنَا  ابْنُ سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : أَرَأَيْتَ الرَّجُلَ يَلْقَانِي بِأَرْضِ فَلَاةٍ يُرِيدُ مَالِي ؟ قَالَ : "" ذَكِّرْهُ بِاللهِ "" ، قَالَ : يَا رَسُولَ اللهِ فَإِنْ لَمْ يَذَّكَّرْ ؟ قَالَ :  فَاسْتَعِنْ عَلَيْهِ مَنْ سِوَاكَ مِنَ الْمُسْلِمِينَ  ، قَالَ : فَإِنْ لَمْ يَكُنْ حَوْلِي أَحَدٌ ؟ قَالَ : "" فَاسْتَعِنْ عَلَيْهِ بِالسُّلْطَانِ "" ، قَالَ : أَرَأَيْتَ إِنْ أَبَى السُّلْطَانُ عَنِّي ؟ قَالَ : "" فَقَاتِلْ دُونَ مَالِكَ حَتَّى تَكُونَ مِنْ شُهَدَاءِ الْآخِرَةِ أَوْ تَمْنَعَ مَالَكَ  .         [20/315]","","Al-Mu'jam al-Kabir 748","","سماك بن حرب البكري عن سعيد بن سماك بن حرب عن عبد الملك بن عبد ربه الطائي عن أحمد بن القاسم بن محمد الطائي عن الطبراني","مخارق أبو قابوس"
"18926","749  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِسْحَاقَ السَّرَّاجُ النَّيْسَابُورِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  ثَنَا  مُصْعَبُ بْنُ الْمِقْدَامِ الْخَثْعَمِيُّ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  قَابُوسَ بْنِ الْمُخَارِقِ ،  عَنْ  أَبِيهِ ،  قَالَ :  جَاءَ  رَجُلٌ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : أَرَأَيْتَ إِنْ جَاءَنِي رَجُلٌ يُرِيدُ أَنْ يَأْخُذَ مَالِي ؟ قَالَ : "" ذَكِّرْهُ بِاللهِ "" ، قَالَ : أَرَأَيْتَ إِنْ ذَكَّرْتُهُ بِاللهِ فَلَمْ يَذَّكَّرْ ؟ قَالَ : "" اسْتَعِنْ عَلَيْهِ بِالسُّلْطَانِ "" ، قَالَ : أَرَأَيْتَ إِنْ كَانَ السُّلْطَانُ بَاعَنِي ؟ قَالَ : "" اسْتَعِنْ مَنْ بِحَضْرَتِكَ مِنَ الْمُسْلِمِينَ "" ، قَالَ : أَرَأَيْتَ إِنْ لَمْ يَحْضُرْنِي ؟ قَالَ :  فَقَاتِلْ دُونَ مَالِكَ أَوْ تُقْتَلَ فَتَكُونَ مِنْ شُهَدَاءِ الْآخِرَةِ  .","","Al-Mu'jam al-Kabir 749","","مخارق بن سليم الشيباني عن قابوس بن أبي المخارق الشيباني عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن مصعب بن المقدام الخثعمي عن إسحاق ابن راهويه عن إسماعيل بن إسحاق السراج عن الطبراني","مخارق أبو قابوس"
"18927","مَنِ اسْمُهُ مُرَّةُ  مُرَّةُ بْنُ كَعْبٍ السُّلَمِيُّ ثُمَّ الْبَهْزِيُّ  ، وَقَدِ اخْتُلِفَ فِي اسْمِهِ فَقِيلَ :  كَعْبُ بْنُ مُرَّةَ  ، وَالصَّوَابُ :  مُرَّةُ بْنُ كَعْبٍ  750  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ، (  ح  )  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، قَالَا :  ثَنَا  أَبُو هِلَالٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنْ  مُرَّةَ الْبَهْزِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَخْتَلِجُ  عَلَى الْأَرْضِ فِتْنَةٌ  كَصَيَاصِي  الْبَقَرِ  . فَمَرَّ رَجُلٌ  مُقَنَّعٌ  ، فَقَالَ : "" هَذَا وَأَصْحَابُهُ يَوْمَئِذٍ عَلَى الْهُدَى "" فَإِذَا  عُثْمَانُ بْنُ عَفَّانَ  .","","Al-Mu'jam al-Kabir 750","","كعب بن مرة البهزي عن عبد الله بن شقيق العقيلي عن قتادة بن دعامة عن محمد بن سليم الراسبي عن سليمان بن حرب الواشحي عن أبو مسلم الكجي عن الطبراني","مرة بن كعب السلمي"
"18928","751  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا         [20/316]      خَالِدُ بْنُ الْحَارِثِ بْنِ سُلَيْمٍ ،  ثَنَا  كَهْمَسُ بْنُ الْحَسَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  ثَنَا  هَرِمُ بْنُ الْحَارِثِ ، وَأُسَامَةُ بْنُ خُرَيْمٍ - وَكَانَا يُضَارِبَانِ عَلَى مُرَّةَ الْبَهْزِيِّ -  قَالَ  :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي طَرِيقِ  الْمَدِينَةِ ،  فَقَالَ :  كَيْفَ تَصْنَعُونَ فِي فِتْنَةٍ تَكُونُ فِي أَقْطَارِ الْأَرْضِ كَأَنَّهَا  صَيَاصِي  بَقَرٍ  ؟ "" قُلْنَا : يَا رَسُولَ اللهِ كَيْفَ نَصْنَعُ ؟ وَبَيْنَ يَدَيْهِ رَجُلٌ فَقَالَ : "" اتَّبِعُوا هَذَا وَأَصْحَابَهُ "" ، فَانْطَلَقْتُ إِلَيْهِ وَهُوَ مُسْرِعٌ فَأَخَذْتُ الرَّجُلَ فَعَطَفْتُهُ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقُلْتُ : هَذَا يَا رَسُولَ اللهِ ؟ قَالَ : "" نَعَمْ "" ، قَالَ : وَهُوَ  عُثْمَانُ بْنُ عَفَّانَ  .","","Al-Mu'jam al-Kabir 751","","كعب بن مرة البهزي عن أسامة بن خريم الشامي عن عبد الله بن شقيق العقيلي عن كهمس بن الحسن النمري عن خالد الصدق عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مرة بن كعب السلمي"
"18929","752  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو أُسَامَةَ ،  حَدَّثَنِي  كَهْمَسُ بْنُ الْحَسَنِ ،  حَدَّثَنِي  هَرِمُ بْنُ الْحَارِثِ ، وَأُسَامَةُ بْنُ خُرَيْمٍ - وَكَانَا يُضَارِبَانِ - فَحَدَّثَانِي حَدِيثًا وَلَا يَشْعُرُ أَحَدُهُمَا أَنَّ صَاحِبَهُ حَدَّثَنِيهِ ،  عَنْ  مُرَّةَ الْبَهْزِيِّ ، قَالَ :  بَيْنَمَا نَحْنُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي طَرِيقِ  الْمَدِينَةِ  فَقَالَ :  كَيْفَ تَصْنَعُونَ بِفِتْنَةٍ تَثُورُ فِي أَقْطَارِ الْأَرْضِ كَأَنَّهَا  صَيَاصِي  بَقَرٍ  ؟ "" قَالُوا : فَنَصْنَعُ مَاذَا يَا رَسُولَ اللهِ ؟ قَالَ : "" عَلَيْكُمْ بِهَذَا وَأَصْحَابِهِ - وَاتَّبِعُوا هَذَا وَأَصْحَابَهُ - "" ، وَأَسْرَعْتُ حَتَّى عَطَفْتُ الرَّجُلَ ، فَقُلْتُ : يَا نَبِيَّ اللهِ هَذَا ؟ قَالَ : "" هَذَا "" ، فَإِذَا هُوَ  عُثْمَانُ بْنُ عَفَّانَ  .","","Al-Mu'jam al-Kabir 752","","كعب بن مرة البهزي عن أسامة بن خريم الشامي عن كهمس بن الحسن النمري عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","مرة بن كعب السلمي"
"18930","753  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ، (  ح  )  وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَا :  ثَنَا  مُعَاوِيَةُ بْنُ صَالِحٍ ،  حَدَّثَنِي  سَلِيمُ بْنُ عَامِرٍ ،  عَنْ  جُبَيْرِ بْنِ نُفَيْرٍ  قَالَ  :  كُنَّا مُعَسْكِرِينَ مَعَ  مُعَاوِيَةَ  بَعْدَ قَتْلِ  عُثْمَانَ  رَضِيَ اللهُ عَنْهُمَا ، فَقَامَ مُرَّةُ بْنُ كَعْبٍ الْبَهْزِيُّ فَقَالَ : أَمَا وَاللهِ         [20/317]      لَوْلَا شَيْءٌ سَمِعْتُهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَا قُمْتُ هَذَا الْمَقَامَ ، قَالَ : فَلَمَّا سَمِعَ  مُعَاوِيَةُ  ذِكْرَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَجْلَسَ النَّاسَ ، فَقَالَ : بَيْنَا نَحْنُ عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جُلُوسٌ إِذْ مَرَّ  عُثْمَانُ  مُرَجِّلًا مُعْدِقًا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَتَخْرُجَنَّ فِتْنَةٌ مِنْ  تَحْتِ رِجْلَيْ - أَوْ مِنْ تَحْتِ قَدَمَيْ  - هَذَا وَمَنِ اتَّبَعَهُ يَوْمَئِذٍ عَلَى الْهُدَى  ، فَقُمْتُ حَتَّى أَخَذْتُ بِمَنْكِبِ  عُثْمَانَ  حَتَّى لَفَتُّهُ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقُلْتُ : هَذَا ؟ قَالَ : "" نَعَمْ ، هَذَا وَمَنِ اتَّبَعَهُ يَوْمَئِذٍ عَلَى الْهُدَى "" ، فَقَامَ عَبْدُ اللهِ بْنُ حَوَالَةَ الْأَنْصَارِيُّ مِنْ عِنْدِ الْمِنْبَرِ فَقَالَ : "" إِنَّكَ لَصَاحِبُ هَذَا ؟ "" قَالَ : نَعَمْ ، قَالَ : "" أَمَا وَاللهِ إِنِّي حَاضِرٌ ذَلِكَ الْمَجْلِسَ ، وَلَوْ كُنْتُ أَعْلَمُ أَنَّ لِي فِي الْجَيْشِ مُصَدِّقًا لَكُنْتُ أَوَّلَ مَنْ تَكَلَّمَ بِهِ  .","","Al-Mu'jam al-Kabir 753","","عبد الله بن حوالة الأزدي عن جبير بن نفير بن مالك الحضرمي عن سليم بن عامر الخبائري عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","مرة بن كعب السلمي"
"18931","754  -  حَدَّثَنَا  حُصَيْنُ بْنُ وَهْبٍ الْأُرْسُوفِيُّ ،  ثَنَا  زَكَرِيَّا بْنُ نَافِعٍ         [20/318]      الْأُرْسُوفِيُّ ،  ثَنَا  عَبَّادُ بْنُ عَبَّادٍ الرَّمْلِيُّ ،  عَنْ  أَبِي زُرْعَةَ السَّيْبَانِيِّ ،  عَنْ  أَبِي زُرْعَةَ الْوَعْلَانِيِّ ،  عَنْ  كُرَيْبٍ السَّحُولِيِّ ، قَالَ :  حَدَّثَنِي  مُرَّةُ الْبَهْزِيُّ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا تَزَالُ  طَائِفَةٌ  مِنْ أُمَّتِي عَلَى الْحَقِّ ظَاهِرِينَ عَلَى مَنْ نَاوَأَهُمْ  ، وَهُمْ كَالْإِنَاءِ بَيْنَ الْأَكَلَةِ حَتَّى يَأْتِيَ أَمْرُ اللهِ وَهُمْ كَذَلِكَ "" ، قُلْنَا : يَا رَسُولَ اللهِ وَأَيْنَ هُمْ ؟ قَالَ : ""  بِأَكْنَافِ  بَيْتِ الْمَقْدِسِ  "" قَالَ : وَحَدَّثَنِي أَنَّ "" الرَّمْلَةَ هِيَ الرَّبْوَةُ ، ذَلِكَ أَنَّهَا مُغَرِّبَةٌ وَمُشَرِّقَةٌ  .","","Al-Mu'jam al-Kabir 754","","كعب بن مرة البهزي عن كريب السحولي عن أبو وعلة الوعلانى عن يحيى بن أبي عمرو السيباني عن عباد بن عباد الأرسوفي عن زكريا بن نافع الأرسوفي عن حصين بن وهب الأرسوفي عن الطبراني","مرة بن كعب السلمي"
"18932","755  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ، قَالَ :  سَمِعْتُ  سَالِمَ بْنَ أَبِي الْجَعْدِ  يُحَدِّثُ ، عَنْ  شُرَحْبِيلَ بْنِ السِّمْطِ ،  عَنْ  كَعْبِ بْنِ مُرَّةَ ، أَوْ مُرَّةَ بْنِ كَعْبٍ  ، قَالَ :  دَعَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى  مُضَرَ  ، فَقُلْتُ : يَا رَسُولَ اللهِ قَدْ أَعْطَاكَ اللهُ وَاسْتَجَابَ لَكَ ، وَإِنَّ قَوْمَكَ قَدْ هَلَكُوا ، فَادْعُ لَهُمْ أَنْ يَسْقِيَهُمْ ، فَقَالَ :  اللَّهُمَّ اسْقِنَا غَيْثًا مُغِيثًا  مَرِيئًا  سَرِيعًا  غَدَقًا  طَبَقًا  عَاجِلًا  غَيْرَ  رَائِثٍ  ، نَافِعًا غَيْرَ ضَارٍّ "" . قَالَ : فَمَا كَانَتْ جُمُعَةٌ أَوْ نَحْوُهَا حَتَّى مُطِرْنَا  .","","Al-Mu'jam al-Kabir 755","","كعب بن مرة البهزي عن شرحبيل بن السمط الكندي عن سالم بن أبي الجعد الغطفاني عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن أبو مسلم الكجي عن الطبراني","مرة بن كعب السلمي"
"18933","فَقِيلَ  لِمُرَّةَ بْنِ كَعْبٍ : حَدِّثْنَا حَدِيثًا سَمِعْتَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِلهِ أَبُوكَ ، وَاحْذَرْ ، قَالَ : سَمِعْتُ رَسُولَ         [20/319]      اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَا مِنْ عَبْدٍ أَعْتَقَ رَقَبَةً مُسْلِمَةً إِلَّا كَانَ فِكَاكَهُ مِنَ النَّارِ  ، يُجْزَى بِكُلِّ عَظْمٍ مِنْ عِظَامِهَا عَظْمًا مِنْ عِظَامِهِ ، وَأَيُّمَا رَجُلٍ مُسْلِمٍ أَعْتَقَ امْرَأَتَيْنِ مُسْلِمَتَيْنِ إِلَّا كَانَتَا فَكَاكًا لَهُ مِنَ النَّارِ ، يُجْزَى بِكُلِّ عَظْمَيْنِ مِنْ عِظَامِهِمَا عَظْمًا مِنْ عِظَامِهِ ، وَأَيُّمَا امْرَأَةٍ مُسْلِمَةٍ أَعْتَقَتِ امْرَأَةً مُسْلِمَةً كَانَتْ فِكَاكَهَا مِنَ النَّارِ ، يُجْزَى بِكُلِّ عَظْمٍ مِنْ عِظَامِهَا عَظْمًا مِنْ عِظَامِهَا  .","","Al-Mu'jam al-Kabir 18933","","كعب بن مرة البهزي عن شرحبيل بن السمط الكندي عن سالم بن أبي الجعد الغطفاني عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن أبو مسلم الكجي عن الطبراني","مرة بن كعب السلمي"
"18934","756  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  عَبْدُ اللهِ بْنُ الصَّبَّاحِ الْعَطَّارُ ،  ثَنَا  بَدَلُ بْنُ الْمُحَبَّرِ ،  ثَنَا  شُعْبَةُ ،  أَخْبَرَنِي  عَمْرُو بْنُ مُرَّةَ ، وَمَنْصُورُ بْنُ الْمُعْتَمِرِ ، وَقَتَادَةُ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  يُحَدِّثُ ، عَنِ  ابْنِ السِّمْطِ ،  قَالَ  : قُلْتُ  لِكَعْبِ بْنِ مُرَّةَ ، أَوْ مُرَّةَ بْنِ كَعْبٍ السُّلَمِيِّ  -  شَكَّ  شُعْبَةُ  - : حَدِّثْنَا حَدِيثًا سَمِعْتَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِلهِ أَبُوكَ وَاحْذَرْ ، قَالَ :  دَعَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى  مُضَرَ  ، فَأَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقُلْتُ : يَا رَسُولَ اللهِ قَدْ أَعْطَاكَ اللهُ وَاسْتَجَابَ لَكَ وَنَصَرَكَ ، وَإِنَّ قَوْمَكَ قَدْ هَلَكُوا فَادْعُ اللهَ لَهُمْ أَنْ يَسْقِيَهُمْ ، فَقَالَ :  اللَّهُمَّ اسْقِنَا غَيْثًا مُغِيثًا ،  مَرِيئًا  مَرِيعًا  ،  غَدَقًا  طَبَقًا ،  عَاجِلًا غَيْرَ  رَائِثٍ  ، نَافِعًا غَيْرَ ضَارٍّ "" . قَالَ : فَمَا أَتَتْ عَلَيْنَا جُمُعَةٌ حَتَّى مُطِرْنَا  .","","Al-Mu'jam al-Kabir 756","","كعب بن مرة البهزي عن شرحبيل بن السمط الكندي عن سالم بن أبي الجعد الغطفاني عن قتادة بن دعامة عن شعبة بن الحجاج عن بدل بن المحبر عن عبد الله بن الصباح المربدي عن عبد الله بن أحمد الجواليقي عن الطبراني","مرة بن كعب السلمي"
"18935","فَقُلْتُ  : حَدِّثْنَا حَدِيثًا سَمِعْتَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِلهِ أَبُوكَ وَاحْذَرْ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَا مِنْ عَبْدٍ مُسْلِمٍ  يُعْتِقُ  رَجُلًا مُسْلِمًا إِلَّا كَانَ فِكَاكَهُ مِنَ النَّارِ  ، يُجْزَى بِكُلِّ عَظْمٍ مِنْ عِظَامِهِ عَظْمًا مِنْ عِظَامِهِ ، وَمَا مِنْ عَبْدٍ مُسْلِمٍ  يُعْتِقُ  امْرَأَتَيْنِ مُسْلِمَتَيْنِ إِلَّا كَانَتَا فِكَاكَهُ مِنَ النَّارِ ، يُجْزَى كُلُّ عَظْمَيْنِ مِنْ عِظَامِهِمَا عَظْمًا مِنْ عِظَامِهِ ، وَمَا مِنِ امْرَأَةٍ مُسْلِمَةٍ  تُعْتِقُ  امْرَأَةً مُسْلِمَةً إِلَّا كَانَتْ فِكَاكَهَا مِنَ النَّارِ ، يُجْزَى كُلُّ عَظْمٍ مِنْ عِظَامِهَا عَظْمًا مِنْ عِظَامِهَا مِنَ النَّارِ  .         [20/320]","","Al-Mu'jam al-Kabir 18935","","كعب بن مرة البهزي عن شرحبيل بن السمط الكندي عن سالم بن أبي الجعد الغطفاني عن قتادة بن دعامة عن شعبة بن الحجاج عن بدل بن المحبر عن عبد الله بن الصباح المربدي عن عبد الله بن أحمد الجواليقي عن الطبراني","مرة بن كعب السلمي"
"18936","757  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  رَجُلٍ ، مِنْ أَهْلِ الشَّامِ ،  عَنْ  مُرَّةَ بْنِ كَعْبِ بْنِ مُرَّةَ الْبَهْزِيِّ ، قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ؟  أَيُّ اللَّيْلِ  أَسْمَعُ  ؟ قَالَ : ""  جَوْفُ  اللَّيْلِ الْآخِرُ  ، ثُمَّ الصَّلَاةُ مَقْبُولَةٌ حَتَّى يَطْلُعَ الْفَجْرُ ، ثُمَّ لَا صَلَاةَ حَتَّى تَكُونَ الشَّمْسُ عَلَى قَدْرِ رُمْحٍ أَوْ رُمْحَيْنِ ، ثُمَّ الصَّلَاةُ مَقْبُولَةٌ حَتَّى يَقُومَ الظِّلُّ قِيَامَ الرُّمْحِ ، ثُمَّ لَا صَلَاةَ حَتَّى تَزُولَ الشَّمْسُ ، ثُمَّ الصَّلَاةُ مَقْبُولَةٌ حَتَّى تَكُونَ الشَّمْسُ  قِيدَ  رُمْحٍ أَوْ رُمْحَيْنِ  ، ثُمَّ لَا صَلَاةَ حَتَّى تَغْرُبَ الشَّمْسُ  .","","Al-Mu'jam al-Kabir 757","","كعب بن مرة البهزي عن رجل من أهل الشام عن سالم بن أبي الجعد الغطفاني عن منصور بن المعتمر عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","مرة بن كعب السلمي"
"18937","مُرَّةُ الْفِهْرِيُّ ، وَهُوَ مُرَّةُ بْنُ عَمْرِو بْنِ حَبِيبِ بْنِ وَاثِلَةَ بْنِ عَمْرِو بْنِ شَيْبَانَ بْنِ مُحَارِبِ بْنِ فِهْرٍ  ، أَسْلَمَ يَوْمَ الْفَتْحِ  758  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  الْحُمَيْدِيُّ ، (  ح  )  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ ،  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ، قَالَا :  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  صَفْوَانَ بْنِ سُلَيْمٍ ،  عَنِ  امْرَأَةٍ يُقَالُ لَهَا : أُنَيْسَةُ ،  عَنْ  أُمِّ سَعْدٍ بِنْتِ مُرَّةَ الْفِهْرِيِّ ،  عَنْ  أَبِيهَا  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَنَا  وَكَافِلُ  الْيَتِيمِ لَهُ أَوْ لِغَيْرِهِ فِي الْجَنَّةِ كَهَاتَيْنِ  وَأَشَارَ  سُفْيَانُ  بِإِصْبَعَيْهِ .","","Al-Mu'jam al-Kabir 758","","مرة بن عمرو بن حبيب الفهري عن أم سعيد بنت مرة الفهرية عن أنيسة عن صفوان بن سليم القرشي عن سفيان بن عيينة عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","مرة الفهري"
"18938","759  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنِي  أَبُو حَفْصٍ الْأَبَّارُ ،  عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ         [20/321]      بِنْتٍ لِمُرَّةَ ،  عَنْ  أَبِيهَا  ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  كَافِلُ  الْيَتِيمِ لَهُ أَوْ لِغَيْرِهِ إِذَا اتَّقَى مَعِي فِي الْجَنَّةِ كَهَاتَيْنِ  ،  يَعْنِي الْمُسَبِّحَةَ وَالْوُسْطَى  .","","Al-Mu'jam al-Kabir 759","","مرة بن عمرو بن حبيب الفهري عن أم سعيد بنت مرة الفهرية عن محمد بن عجلان عن محمد بن جحادة الأودي عن عمر بن عبد الرحمن بن قيس عن سريج بن يونس المروزي عن عبد الله بن أحمد بن حنبل عن الطبراني","مرة الفهري"
"18939","مَنِ اسْمُهُ مُعْتَمِرٌ  مُعْتَمِرٌ أَبُو حَنَشٍ  760  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  حَجَّاجُ بْنُ إِبْرَاهِيمَ الْأَزْرَقُ ،  ثَنَا  صَالِحُ بْنُ عُمَرَ الْوَاسِطِيُّ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  حَنَشِ بْنِ الْمُعْتَمِرِ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" يُصَلِّي عَلَى جِنَازَةٍ ، فَجَاءَتِ  امْرَأَةٌ  بِمِجْمَرٍ تُرِيدُ الْجِنَازَةَ ، فَصَاحَ بِهَا حَتَّى دَخَلَتْ فِي آجَامِ  الْمَدِينَةِ  .","","Al-Mu'jam al-Kabir 760","","معتمر الكناني والد حنش عن حنش بن المعتمر الكناني عن إسماعيل بن أبي خالد عن صالح بن عمر الواسطي عن حجاج بن إبراهيم الأبناوي عن يوسف بن يزيد القراطيسي عن الطبراني","معتمر أبو حنش"
"18940","مَنِ اسْمُهُ مَخْرَفَةُ  مَخْرَفَةُ الْعَبْدِيُّ  761  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُعَلَّى بْنُ مَهْدِيٍّ الْمَوْصِلِيُّ ،  ثَنَا  أَيُّوبُ بْنُ جَابِرٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  مَخْرَفَةَ الْعَبْدِيِّ قَالَ :  خَرَجْنَا مَعَ قَوْمٍ تُجَّارٍ يَبِيعُونَ الْبَزَّ وَمَعَهُمْ وَزَّانٌ يَزِنُ بِالْأَجْرِ ، فَقَدِمْنَا  مَكَّةَ  فَاشْتَرَى مِنْهُمُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَرَاوِيلَ ، فَقَالَ لِلْوَزَّانِ :  زِنْ وَأَرْجِحْ  .         [20/322]","","Al-Mu'jam al-Kabir 761","","مخرفة العبدي عن سماك بن حرب البكري عن أيوب بن جابر السحيمي عن معلى بن مهدي الموصلي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مخرفة العبدي"
"18941","مَنِ اسْمُهُ مِشْرَحٌ  مِشْرَحٌ أَبُو مِيلٍ  762  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ الْبَصْرِيُّ ،  ثَنَا  يُونُسُ بْنُ مُوسَى السَّامِيُّ ، وَسُلَيْمَانُ بْنُ دَاوُدَ الشَّاذَكُونِيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ بْنِ مَسْمُولٍ ،  حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ سَلَمَةَ بْنِ وَهْرَامٍ ،  عَنْ  مِيلَ بِنْتِ مِشْرَحٍ ،  قَالَتْ  :  رَأَيْتُ أَبِي قَلَّمَ أَظْفَارَهُ ، ثُمَّ دَفَنَهَا وَقَالَ : أَيْ بُنَيَّةُ ، هَكَذَا رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَفْعَلُ  .","","Al-Mu'jam al-Kabir 762","","مشرح الأشعري عن ميل بنت مشرح الأشعري عن عبيد الله بن سلمة بن وهرام عن محمد بن سليمان المسمولي عن الشاذكوني عن محمد بن محمد بن حيان التمار عن الطبراني","مشرح أبو ميل"
"18942","مَنِ اسْمُهُ مُخَوَّلٌ  مُخَوَّلٌ السُّلَمِيُّ ثُمَّ الْبَهْزِيُّ  763  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ ، وَيَحْيَى بْنُ مُوسَى اللَّخْمِيُّ ، (  ح  )  وَحَدَّثَنَا  أَبُو عُبَيْدَةَ عَبْدُ الْوَارِثِ بْنُ إِبْرَاهِيمَ الْعَسْكَرِيُّ ،  ثَنَا  يُونُسُ بْنُ مُوسَى السَّامِيُّ ، قَالُوا :  ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ بْنِ مَسْمُولٍ الْمَخْزُومِيُّ ،  بِمَكَّةَ  ،  ثَنَا  الْقَاسِمُ         [20/323]      بْنُ مُخَوَّلٍ الْبَهْزِيُّ ثُمَّ السُّلَمِيُّ ، قَالَ :  سَمِعْتُ  أَبِي  يُحَدِّثُ - وَكَانَ أَدْرَكَ الْجَاهِلِيَّةَ وَالْإِسْلَامَ - قَالَ :  نَصَبْتُ حَبَائِلَ لِي  بِالْأَبْوَاءِ  ، فَوَقَعَ فِي حَبْلٍ مِنْهَا ظَبْيٌ ، فَانْقَلَبَ الْحَبْلُ ، فَخَرَجْنَا فِي أَثَرِهِ أَقْفُوهُ ، فَوَجَدْتُ  رَجُلًا  قَدْ أَخَذَهُ ، فَتَنَازَعْنَا إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَوَجَدْنَاهُ نَازِلًا  بِأَبْوَاءَ  تَحْتَ شَجَرَةٍ قَدِ اسْتَظَلَّ بِنِطَعٍ ، فَقَضَى بِهِ بَيْنَنَا  شَطْرَيْنِ  ، فَقُلْتُ : يَا رَسُولَ اللهِ ، هَذِهِ حَبَائِلِي فِي رِجْلِهِ ، قَالَ : "" هُوَ ذَاكَ "" ، قُلْتُ : يَا رَسُولَ اللهِ ، إِنَّا نَكُونُ عَلَى الْمَاءِ فَتَرِدُ عَلَيْنَا الْإِبِلُ وَهِيَ عِطَاشٌ فَنَسْقِيهَا مِنَ الْمَاءِ ، هَلْ لَنَا فِي ذَلِكَ مِنْ أَجْرٍ ؟ قَالَ :  نَعَمْ ، فِي كُلِّ ذَاتِ كَبِدٍ  حَرَّى  أَجْرٌ  ، قُلْتُ : يَا رَسُولَ اللهِ ، الْإِبِلُ الطِّوَالُ تَلَقَّانَا وَهِيَ  مُصَرَّاةٌ  وَنَحْنُ جِيَاعٌ ، قَالَ : "" قُلْ : يَا صَاحِبَ الْإِبِلِ ، يَا صَاحِبَ الْإِبِلِ - ثَلَاثًا - فَإِنْ جَاءَ وَإِلَّا فَحَلَّ  صِرَارُهَا  ، فَاحْلُبْ وَاشْرَبْ وَأَعِدْ  صِرَارَهَا  ، وَبَقِّ لِلَّبَنِ دَوَاعِيَهُ "" .  ثُمَّ أَنْشَأَ يُحَدِّثُنَا صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : "" يَأْتِي عَلَى النَّاسِ زَمَانٌ يَكُونُ خَيْرُ الْمَالِ فِيهِ غَنَمٌ بَيْنَ الْمَسْجِدَيْنِ -  يَعْنِي  مَسْجِدَ الْمَدِينَةِ  وَمَسْجِدَ مَكَّةَ  - تَأْكُلُ الشَّجَرَ ، وَتَرِدُ الْمِيَاهَ ، يَأْكُلُ صَاحِبُهَا مِنْ سُلَالِهَا  وَيَلْبَسُ مِنْ أَصْوَافِهَا - أَوْ قَالَ : مِنْ أَشْعَارِهَا  - وَالْفِتَنُ تَرْتَهِشُ بَيْنَ  جَرَاثِيمِ  الْعَرَبِ ، وَالدِّمَاءُ تُسْفَكُ "" ، يَقُولُهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثَلَاثًا . قُلْتُ : يَا رَسُولَ اللهِ أَوْصِنِي ، قَالَ :  اتَّقِ اللهَ ، وَأَقِمِ الصَّلَاةَ  ، وَائْتِ الزَّكَاةَ ، وَحُجَّ الْبَيْتَ وَاعْتَمِرْ ، وَبِرَّ وَالِدَيْكَ ، وَصِلْ رَحِمَكَ ، وَأَقْرِ الضَّيْفَ ، وَأْمُرْ بِالْمَعْرُوفِ ، وَانْهَ عَنِ الْمُنْكَرِ ، وَزُلْ مَعَ الْحَقِّ حَيْثُمَا زَالَ  وَاللَّفْظُ لِحَدِيثِ  يُونُسَ بْنِ مُوسَى  .","","Al-Mu'jam al-Kabir 763","","مخول بن يزيد البهزي عن القاسم بن مخول البهزى عن محمد بن سليمان المسمولي عن يونس بن موسى بن سليمان الكديمي عن عبد الوارث بن إبراهيم العسكري عن الطبراني","مخول السلمي ثم البهزي"
"18943","مَنِ اسْمُهُ مُجَاشِعٌ  مُجَاشِعُ بْنُ مَسْعُودٍ السُّلَمِيُّ  764  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سُوَيْدٍ الشِّبَامِيُّ ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا         [20/324]      الثَّوْرِيُّ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  كُنَّا فِي غَزَاةٍ وَمَعَنَا رَجُلٌ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُقَالُ لَهُ : مُجَاشِعٌ مِنْ بَنِي سُلَيْمٍ ، فَعَزَّتِ الْغَنَمُ فَأَمَرَ مُنَادِيًا فَنَادَى : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ  الْجَذَعَةَ  تُوفِي مِمَّا تُوفِي مِنْهُ الثَّنِيَّةُ  .","","Al-Mu'jam al-Kabir 764","","مجاشع بن مسعود البهزي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إبراهيم بن محمد بن عبد الله الشبامي عن الطبراني","مجاشع بن مسعود السلمي"
"18944","765  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  خَالِدٌ الْحَذَّاءُ ،  عَنْ  أَبِي عُثْمَانَ النَّهْدِيِّ ،  عَنْ  مُجَاشِعِ بْنِ مَسْعُودٍ السُّلَمِيِّ ،  أَنَّهُ جَاءَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ الْفَتْحِ  ، فَقَالَ : يَا رَسُولَ اللهِ ، هَذَا أَخِي  مُجَالِدُ بْنُ مَسْعُودٍ  فَبَايِعْهُ عَلَى الْهِجْرَةِ ، فَقَالَ :  لَا  هِجْرَةَ  بَعْدَ فَتْحِ  مَكَّةَ  ، وَلَكِنْ  أُبَايِعُهُ  عَلَى الْإِسْلَامِ  .","","Al-Mu'jam al-Kabir 765","","مجاشع بن مسعود البهزي عن أبو عثمان النهدي عن خالد الحذاء عن يزيد بن زريع العيشي عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاشع بن مسعود السلمي"
"18945","766  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عِقَالٍ الْحَرَّانِيُّ ،  ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ، (  ح  )         [20/325]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  قَالَا :  ثَنَا  زُهَيْرُ بْنُ مُعَاوِيَةَ ،  ثَنَا  عَاصِمٌ الْأَحْوَلُ ،  عَنْ  أَبِي عُثْمَانَ ،  حَدَّثَنِي  مُجَاشِعٌ قَالَ :  أَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِأَخِي  مَعْبَدٍ  لِيُبَايِعَهُ  عَلَى الْهِجْرَةِ ، فَقَالَ :  ذَهَبَ أَهْلُ الْهِجْرَةِ بِمَا فِيهَا  ، فَقُلْتُ : فَعَلَى أَيِّ شَيْءٍ  تُبَايِعُهُ  ؟ قَالَ : ""  أُبَايِعُهُ  عَلَى  الْإِسْلَامِ - أَوِ الْإِيمَانِ  -  وَالْجِهَادِ  "" فَلَقِيتُ  مَعْبَدًا  بَعْدُ ، فَسَأَلْتُهُ - وَكَانَ أَكْبَرَهُمَا - فَقَالَ : صَدَقَ  .","","Al-Mu'jam al-Kabir 766","","مجاشع بن مسعود البهزي عن أبو عثمان النهدي عن عاصم بن سليمان الأحول عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","مجاشع بن مسعود السلمي"
"18946","767  -  حَدَّثَنَا  الْحَسَنُ بْنُ الْعَبَّاسِ الرَّازِيُّ ،  ثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ بْنِ سَعْدٍ الدَّشْتَكِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  عُثْمَانَ  ،  عَنْ  مُجَاشِعِ بْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( أبو عثمان )","","Al-Mu'jam al-Kabir 767","","مجاشع بن مسعود البهزي عن أبو عثمان النهدي عن عاصم بن سليمان الأحول عن عمرو بن أبي قيس عن عبد الرحمن بن عبد الله الدشتكي عن أحمد بن عبد الرحمن حمدون الدشتكي عن الجمال الحسن بن العباس عن الطبراني","مجاشع بن مسعود السلمي"
"18947","768  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْقَلَانِسِيُّ ،  ثَنَا  آدَمُ بْنُ أَبِي إِيَاسٍ ،  ثَنَا  شَيْبَانُ ، (  ح  )  وَحَدَّثَنَا  الْعَبَّاسُ بْنُ حَمْدَانَ الْحَنَفِيُّ الْأَصْبَهَانِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ أَبِي يَعْقُوبَ الْكَرْمَانِيُّ ،  ثَنَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  ثَنَا  شَيْبَانُ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  أَخْبَرَنِي  يَحْيَى بْنُ أَبِي إِسْحَاقَ  ،  عَنْ  مُجَاشِعِ بْنِ مَسْعُودٍ ،  أَنَّهُ أَتَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِيُبَايِعَهُ  عَلَى الْهِجْرَةِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا ، بَلْ  نُبَايِعُ  عَلَى الْإِسْلَامِ ، فَإِنَّهُ لَا  هِجْرَةَ  بَعْدَ الْفَتْحِ  ، فَتَكُونَ مِنَ التَّابِعِينَ بِالْإِحْسَانِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( يحيى بن إسحاق )","","Al-Mu'jam al-Kabir 768","","مجاشع بن مسعود البهزي عن يحيى بن إسحاق الأنصاري ابن أخي رافع بن خديج عن يحيى بن أبي كثير عن شيبان بن عبد الرحمن المؤدب عن يحيى بن أبي بكير عن عبد الله بن يعقوب الكرماني عن العباس بن حمدان الأصبهاني عن الطبراني","مجاشع بن مسعود السلمي"
"18948","مَنِ اسْمُهُ مُجَالِدٌ  مُجَالِدُ بْنُ مَسْعُودٍ السُّلَمِيُّ  769  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا         [20/326]      يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  خَالِدٌ الْحَذَّاءُ ،  عَنْ  أَبِي عُثْمَانَ النَّهْدِيِّ ،  عَنْ  مُجَاشِعٍ السُّلَمِيِّ ،  أَنَّهُ جَاءَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ الْفَتْحِ  ، فَقَالَ : يَا رَسُولَ اللهِ ، هَذَا أَخِي  مُجَالِدُ بْنُ مَسْعُودٍ  ، فَبَايِعْهُ عَلَى الْهِجْرَةِ ، فَقَالَ :  لَا  هِجْرَةَ  بَعْدَ فَتْحِ  مَكَّةَ  ، وَلَكِنِّي  أُبَايِعُهُ  عَلَى الْإِسْلَامِ  .","","Al-Mu'jam al-Kabir 769","","مجاشع بن مسعود البهزي عن أبو عثمان النهدي عن خالد الحذاء عن يزيد بن زريع العيشي عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجالد بن مسعود السلمي"
"18949","مَنِ اسْمُهُ مُحَرِّشٌ  مُحَرِّشٌ الْكَعْبِيُّ  770  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَنَا  نَافِعُ بْنُ يَزِيدَ ،  أَخْبَرَنِي  ابْنُ جُرَيْجٍ ،  أَخْبَرَنِي  مُزَاحِمُ بْنُ أَبِي مُزَاحِمٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ عَبْدِ اللهِ ،  عَنْ  مُحَرِّشٍ الْكَعْبِيِّ ، أَنَّهُ قَالَ :  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَيْلَةَ خَرَجَ مِنَ  الْجِعْرَانَةِ  حَتَّى أَمْسَى مُعْتَمِرًا  ، فَدَخَلَ  مَكَّةَ  لَيْلًا فَقَضَى عُمْرَتَهُ ، ثُمَّ خَرَجَ مِنْ تَحْتِ لَيْلَتِهِ فَأَصْبَحَ  بِالْجِعْرَانَةِ  كَبَائِتٍ ، حَتَّى إِذَا زَالَتِ الشَّمْسُ خَرَجَ مِنَ  الْجِعْرَانَةِ  فِي بَطْنِ  سَرِفَ  حَتَّى جَامَعَ الطَّرِيقُ طَرِيقَ  الْمَدِينَةِ  بِسَرِفَ  . قَالَ  مُحَرِّشٌ  : "" فَلِذَلِكَ خَفِيَتْ عُمْرَتُهُ عَلَى كَثِيرٍ مِنَ النَّاسِ ""  .","","Al-Mu'jam al-Kabir 770","","محرش بن عبد الله الخزاعي عن عبد العزيز بن عبد الله بن خالد الأموي عن مزاحم بن أبي مزاحم مولى عمر بن عبد العزيز عن ابن جريج عن نافع بن يزيد الكلاعي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","محرش الكعبي"
"18950","771  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  دَاوُدُ بْنُ عَبْدِ الرَّحْمَنِ الْعَطَّارُ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  مُزَاحِمِ بْنِ زُفَرَ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ عَبْدِ اللهِ ،  عَنْ  مُحَرِّشٍ الْكَعْبِيِّ قَالَ :  اعْتَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنَ  الْجِعْرَانَةِ  ، ثُمَّ رَجَعَ كَبَائِتٍ  ، فَلِذَلِكَ خَفِيَتْ عُمْرَتُهُ عَلَى كَثِيرٍ مِنَ النَّاسِ  .         [20/327]","","Al-Mu'jam al-Kabir 771","","محرش بن عبد الله الخزاعي عن عبد العزيز بن عبد الله بن خالد الأموي عن مزاحم بن زفر الجعفري عن ابن جريج عن داود ابن النصراني عن أحمد بن عبد الله اليربوعي عن محمد بن عثمان بن أبي شيبة عن الطبراني","محرش الكعبي"
"18951","772  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  سُفْيَانُ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أُمَيَّةَ ،  عَنْ  مُزَاحِمِ بْنِ أَبِي مُزَاحِمٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ عَبْدِ اللهِ بْنِ خَالِدِ بْنِ أَسِيدٍ ،  عَنْ  مُحَرِّشٍ ، قَالَ :  اعْتَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنَ  الْجِعْرَانَةِ  فَنَظَرْتُ إِلَى ظَهْرِهِ كَأَنَّهُ سَبِيكَةُ فِضَّةٍ  ، وَأَصْبَحَ كَبَائِتٍ  .","","Al-Mu'jam al-Kabir 772","","محرش بن عبد الله الخزاعي عن عبد العزيز بن عبد الله بن خالد الأموي عن مزاحم بن أبي مزاحم مولى عمر بن عبد العزيز عن إسماعيل بن أمية الأموي عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","محرش الكعبي"
"18952","مَنِ اسْمُهُ مَرْثَدٌ  مَرْثَدُ بْنُ أَبِي مَرْثَدٍ الْغَنَوِيُّ ، حَلِيفُ حَمْزَةَ بْنِ عَبْدِ الْمُطَّلِبِ  بَدْرِيٌّ اسْتُشْهِدَ يَوْمَ الرَّجِيعِ  773  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مَرْثَدُ بْنُ أَبِي مَرْثَدٍ الْغَنَوِيُّ  .","","Al-Mu'jam al-Kabir 773","","","مرثد بن أبي مرثد الغنوي"
"18953","774  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ ، قَالَ :  بَعَثَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مَرْثَدَ بْنَ أَبِي مَرْثَدٍ الْغَنَوِيَّ حَلِيفَ حَمْزَةَ بْنِ عَبْدِ الْمُطَّلِبِ  إِلَى حَيٍّ مِنْ  هُذَيْلٍ  ، فَقُتِلَ فِيهَا مِنَ الْمُسْلِمِينَ ثُمَّ مِنْ  بَنِي هَاشِمٍ  مَرْثَدُ بْنُ أَبِي مَرْثَدٍ  .","","Al-Mu'jam al-Kabir 774","","عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","مرثد بن أبي مرثد الغنوي"
"18954","775  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ ،  ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  حَدَّثَنِي  عَاصِمُ بْنُ عُمَرَ بْنِ قَتَادَةَ ، قَالَ :  قَدِمَ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعْدَ  أُحُدٍ  نَفَرٌ مِنْ  عَضَلٍ  وَالْقَارَةِ  ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّ فِينَا إِسْلَامًا فَابْعَثْ مَعَنَا نَفَرًا مِنْ أَصْحَابِكَ يُفَقِّهُونَا فِي الدِّينِ ، وَيُقْرِئُونَا الْقُرْآنَ ، وَيُعَلِّمُونَنَا شَرَائِعَ الْإِسْلَامِ ، "" فَبَعَثَ رَسُولُ اللهِ صَلَّى         [20/328]      اللهُ عَلَيْهِ وَسَلَّمَ نَفَرًا سِتَّةً مِنْ أَصْحَابِهِ :  مَرْثَدَ بْنَ أَبِي مَرْثَدٍ الْغَنَوِيَّ - حَلِيفَ حَمْزَةَ بْنِ عَبْدِ الْمُطَّلِبِ  - فَذَكَرَ الْقِصَّةَ قَالَ : وَأَمَّا  مَرْثَدُ بْنُ أَبِي مَرْثَدٍ  ،  وَخَالِدُ بْنُ الْبُكَيْرِ  ،  وَعَاصِمُ بْنُ ثَابِتٍ  فَقَالُوا : وَاللهِ لَا نَقْبَلُ مِنْ مُشْرِكٍ عَهْدًا ، وَلَا عَقْدًا أَبَدًا ، فَقَاتَلُوهُمْ حَتَّى قَتَلُوهُمْ  .","","Al-Mu'jam al-Kabir 775","","عاصم بن عمر الظفري عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن عبد الله بن محمد النفيلي عن أبو شعيب الحراني عن الطبراني","مرثد بن أبي مرثد الغنوي"
"18955","776  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ،  ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  ،  فِي تَسْمِيَةِ مَنْ قُتِلَ يَوْمَ الرَّجِيعِ :  مَرْثَدُ بْنُ  أَبِي مَرْثَدٍ الْغَنَوِيُّ  .","","Al-Mu'jam al-Kabir 776","","","مرثد بن أبي مرثد الغنوي"
"18956","مَا  أَسْنَدَ  مَرْثَدُ بْنُ أَبِي مَرْثَدٍ الْغَنَوِيُّ  777  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  عَمِّي الْقَاسِمُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَحْيَى بْنُ يَعْلَى ، (  ح  )  وَحَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْأَزْدِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبَانَ الْوَرَّاقُ ،  ثَنَا  يَحْيَى بْنُ يَعْلَى الْأَسْلَمِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ مُوسَى ،  عَنِ  الْقَاسِمِ الشَّامِيِّ ،  عَنْ  مَرْثَدِ بْنِ أَبِي مَرْثَدٍ الْغَنَوِيِّ - وَكَانَ بَدْرِيًّا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ سَرَّكُمْ أَنْ تُقْبَلَ صَلَاتُكُمْ ، فَلْيَؤُمَّكُمْ خِيَارُكُمْ ، فَإِنَّهُمْ وَفْدُكُمْ فِيمَا بَيْنَكُمْ وَبَيْنَ رَبِّكُمْ  .","","Al-Mu'jam al-Kabir 777","","مرثد بن أبي مرثد الغنوي عن القاسم بن عبد الرحمن الدمشقي عن عبد الله بن موسى بن إبراهيم الطلحي عن يحيى بن يعلى القطواني عن إسماعيل بن أبان عن محمد بن يحيى بن أبي حاتم عن محمود بن محمد بن منويه المفيد عن الطبراني","ما أسند مرثد بن أبي مرثد الغنوي"
"18957","778  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَا :  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  الْحَسَنُ بْنُ يَحْيَى الْخُشَنِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ سُلَيْمَانَ بْنِ أَبِي السَّائِبِ ،  عَنْ  أَبِي عَوْنٍ  عَنْ  أَبِي إِدْرِيسَ ،  عَنْ  مَرْثَدٍ ، - وَكَانَ         [20/329]      مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  خَطَّ اللهُ خَطَّيْنِ فِي كِتَابِهِ ثُمَّ رَفَعَ الْقَلَمَ وَكَتَبَ فِي أَحَدِهِمَا الْخَلْقَ  ، وَكَتَبَ فِي الْآخَرِ مَا الْخَلْقُ عَامِلُونَ  .","","Al-Mu'jam al-Kabir 778","","مرثد بن أبي مرثد الغنوي عن عائذ الله بن عبد الله الخولاني عن عبد الله بن أبي عبد الله الشامي الأعور عن الوليد بن سليمان بن أبي السائب عن الحسن بن يحيى الخشني عن هشام بن عمار عن أحمد بن المعلى الأسدي عن الطبراني","ما أسند مرثد بن أبي مرثد الغنوي"
"18958","مَنِ اسْمُهُ مُهَاجِرُ  مُهَاجِرُ بْنُ قُنْفُذٍ التَّيْمِيُّ ،  وَيُقَالُ  لِقُنْفُذٍ  : شَارِبُ الذَّهَبِ ،  قُنْفُذُ بْنُ عُمَيْرِ بْنِ جُدْعَانَ بْنِ عَمْرِو بْنِ كَعْبِ بْنِ سَعْدِ بْنِ تَيْمِ بْنِ مُرَّةَ بْنِ كَعْبِ بْنِ لُؤَيِّ بْنِ غَالِبٍ  779  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، (  ح  )  وَحَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  أَنَا  حُمَيْدٌ ، وَغَيْرُهُ ،  عَنِ  الْحَسَنِ ،  عَنِ  الْمُهَاجِرِ بْنِ قُنْفُذٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَبُولُ - أَوْ قَالَ : مَرَرْتُ بِهِ وَقَدْ بَالَ  - فَسَلَّمْتُ عَلَيْهِ  ، فَلَمْ يَرُدَّ عَلَيَّ حَتَّى فَرَغَ مِنْ وُضُوئِهِ ثُمَّ رَدَّ عَلَيَّ  .","","Al-Mu'jam al-Kabir 779","","المهاجر بن قنفذ القرشي عن الحسن البصري عن حميد الطويل عن حماد بن سلمة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","مهاجر بن قنفذ التيمي"
"18959","780  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  ثَنَا  مُعَاذُ بْنُ هِشَامٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  حُضَيْنِ بْنِ الْمُنْذِرِ أَبِي سَاسَانَ ،  عَنِ  الْمُهَاجِرِ بْنِ قُنْفُذٍ ،  أَنَّهُ "" سَلَّمَ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَبُولُ فَلَمْ يَرُدَّ عَلَيْهِ حَتَّى تَوَضَّأَ  .","","Al-Mu'jam al-Kabir 780","","المهاجر بن قنفذ القرشي عن حضين بن المنذر الرقاشي عن الحسن البصري عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن عبيد الله بن عمر القواريري عن عبد الله بن أحمد بن حنبل عن الطبراني","مهاجر بن قنفذ التيمي"
"18960","781  -  حَدَّثَنَا  أَبُو يَزِيدَ يُوسُفُ بْنُ يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  الْعَبَّاسُ بْنُ طَالِبٍ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  حُضَيْنِ بْنِ الْمُنْذِرِ ،  عَنْ  مُهَاجِرِ بْنِ قُنْفُذٍ ، قَالَ :  مَرَرْتُ بِرَسُولِ         [20/330]      اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَسَلَّمْتُ وَهُوَ يَتَوَضَّأُ فَسَلَّمْتُ عَلَيْهِ فَلَمْ يَرُدَّ عَلَيَّ ، فَلَمَّا فَرَغَ رَدَّ عَلَيَّ وَاعْتَذَرَ إِلَيَّ وَقَالَ :  إِنَّهُ لَمْ يَمْنَعْنِي أَنْ أَرُدَّ عَلَيْكَ إِلَّا أَنِّي كَرِهْتُ أَنْ أَذْكُرَ اللهَ وَأَنَا عَلَى غَيْرِ طَهَارَةٍ  .","","Al-Mu'jam al-Kabir 781","","المهاجر بن قنفذ القرشي عن حضين بن المنذر الرقاشي عن الحسن البصري عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن العباس بن طالب البصري عن يوسف بن يزيد القراطيسي عن الطبراني","مهاجر بن قنفذ التيمي"
"18961","782  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  أَبُو مُعَاوِيَةَ مُحَمَّدُ بْنُ خَازِمٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُسْلِمٍ ،  عَنِ  الْحَسَنِ ،  عَنِ  الْمُهَاجِرِ بْنِ قُنْفُذٍ ، قَالَ :  رَأَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثَلَاثَةً عَلَى دَابَّةٍ فَقَالَ :  الثَّالِثُ مَلْعُونٌ  .","","Al-Mu'jam al-Kabir 782","","المهاجر بن قنفذ القرشي عن الحسن البصري عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن أبو معاوية الضرير عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","مهاجر بن قنفذ التيمي"
"18962","مُهَاجِرٌ مَوْلَى أُمِّ سَلَمَةَ زَوْجِ النَّبِيِّ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  783  -  حَدَّثَنَا  رَوْحُ بْنُ الْفَرَجِ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ بْنِ بُكَيْرٍ ،  حَدَّثَنِي  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ ، قَالَ :  سَمِعْتُ  بُكَيْرًا ، يَقُولُ :  سَمِعْتُ  مُهَاجِرًا مَوْلَى أُمِّ سَلَمَةَ يَقُولُ :  خَدَمْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سِنِينَ ، فَلَمْ يَقُلْ لِي لِشَيْءٍ صَنَعْتُهُ : لِمَ صَنَعْتَهُ ؟ وَلَا لِشَيْءٍ تَرَكْتُهُ : لِمَ تَرَكْتَهُ  ؟  قَالَ  ابْنُ بُكَيْرٍ  : ""  بُكَيْرٌ  هَذَا الَّذِي هُوَ فِي الْحَدِيثِ جَدِّي ""  .","","Al-Mu'jam al-Kabir 783","","المهاجر المصري مولى أم سلمة عن بكير بن عبد الله بن الأشج القرشي عن إبراهيم بن عبد الله عن يحيى بن عبد الله بن بكير المخزومي عن روح بن الفرج القطان عن الطبراني","مهاجر مولى أم سلمة زوج النبي صلى الله عليه وسلم"
"18963","مَنِ اسْمُهُ مَسْعُودٌ  مَسْعُودٌ مَوْلَى فَرْوَةَ الْأَسْلَمِيُّ  784  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ بْنِ مُحَمَّدِ بْنِ يَحْيَى بْنِ سَعِيدٍ الْقَطَّانُ ،  ثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  حَدَّثَنِي  أَفْلَحُ بْنُ سَعِيدٍ ،  حَدَّثَنِي  بُرَيْدَةُ بْنُ سُفْيَانَ         [20/331]      الْأَسْلَمِيُّ ،  عَنْ  مَسْعُودٍ - غُلَامِ جَدِّهِ فَرْوَةَ أَبِي تَمِيمٍ - قَالَ :  مَرَّ بِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَأَبُو بَكْرٍ  ، فَقَالَ لِي  أَبُو بَكْرٍ  : يَا  مَسْعُودُ  ، ائْتِ  أَبَا تَمِيمٍ  مَوْلَاكَ  ، فَقُلْ لَهُ يَبْعَثْ مَعَنَا دَلِيلًا يَأْخُذُ بِنَا أَخْفَى الطَّرِيقِ ، وَبَعِيرًا وَزَادًا ، فَأَتَيْتُ مَوْلَايَ فَقُلْتُ لَهُ ، فَبَعَثَنِي وَبَعَثَ مَعِي بِبَعِيرٍ  وَوَطْبٍ  مِنْ لَبَنٍ ، فَجِئْتُهُمَا "" فَقَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي ،  وَأَبُو بَكْرٍ  عَنْ يَمِينِهِ - فَقُمْتُ خَلْفَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَأَبِي بَكْرٍ  ، فَدَفَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي صَدْرِ  أَبِي بَكْرٍ  فَقُمْنَا خَلْفَهُ  .","","Al-Mu'jam al-Kabir 784","","مسعود بن هبيرة الأسلمي عن بريدة بن سفيان بن فروة الأسلمي عن أفلح بن سعيد الأنصاري عن زيد بن الحباب العكلي عن عبدان بن أحمد بن محمد بن يحيى بن سعيد القطان عن الطبراني","مسعود مولى فروة الأسلمي"
"18964","مَسْعُودُ بْنُ الضَّحَّاكِ اللَّخْمِيُّ  785  -  حَدَّثَنَا  أَبُو مَسْعُودٍ عَبْدُ الرَّحْمَنِ بْنُ الْمُثَنَّى [  حَدَّثَنِي  الْمُثَنَّى ]  ،  عَنْ  أَبِيهِ مُطَاعٍ ،  عَنْ  أَبِيهِ عِيسَى ،  عَنْ  أَبِيهِ مُطَاعٍ ،  عَنْ  أَبِيهِ زِيَادٍ ،  عَنْ  جَدِّهِ مَسْعُودٍ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَمَّاهُ  مُطَاعًا  وَقَالَ لَهُ :  يَا  مُطَاعُ  ، أَنْتَ مُطَاعٌ فِي قَوْمِكَ  . وَقَالَ لَهُ : "" امْضِ إِلَى أَصْحَابِكَ "" ، وَحَمَلَهُ عَلَى فَرَسٍ أَبْلَقَ ، وَأَعْطَاهُ  الرَّايَةَ  ، وَقَالَ : "" مَنْ دَخَلَ تَحْتَ رَايَتِي هَذِهِ فَقَدْ أَمِنَ مِنَ الْعَذَابِ  .  سقط من طبعة مكتبة ابن تيمية والنسخة الخطية ، والمثبت من المعجم الأوسط للمصنف وبنحوه في الصغير له ، والله أعلم .","","Al-Mu'jam al-Kabir 785","","مسعود بن الضحاك بن عدي اللخمي عن زياد عن مطاع بن زيادة اللخمي عن عيسى بن مطاع بن زائدة اللخمي عن مطاع بن عيسى بن مطاع عن المثنى عن عبد الرحمن بن المثنى اللخمي عن الطبراني","مسعود بن الضحاك اللخمي"
"18965","مَسْعُودٌ أَبُو مُحَمَّدٍ الْأَنْصَارِيُّ ثُمَّ الْخَزْرَجِيُّ  بَدْرِيٌّ  786  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحِيمِ الْبَرْقِيُّ  ،  ثَنَا  عَبْدُ الْمَلِكِ بْنُ هِشَامٍ السَّدُوسِيُّ  ،  ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ  ، ثُمَّ مِنْ  بَنِي الْخَزْرَجِ  ، ثُمَّ مِنْ  بَنِي النَّجَّارِ  :  أَبُو مُحَمَّدٍ الْأَنْصَارِيُّ وَاسْمُهُ مَسْعُودُ بْنُ أَوْسِ بْنِ أَصْرَمَ بْنِ زَيْدِ بْنِ ثَعْلَبَةَ بْنِ غَنْمِ بْنِ مَالِكِ بْنِ النَّجَّارِ  .","","Al-Mu'jam al-Kabir 786","","","مسعود أبو محمد الأنصاري"
"18966","[20/332]      787  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنِي  يَزِيدُ بْنُ عَمْرٍو الْمَعَافِرِيُّ ،  عَنْ  مَوْلًى لِرُفَيْعِ بْنِ ثَابِتٍ ،  أَنَّ  رَجُلًا ، مِنْ أَصْحَابِ النَّبِيِّ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ اشْتَرَى  جَارِيَةً بَرْبَرِيَّةً  بِمِائَتَيْ دِينَارٍ ، فَبَعَثَ بِهَا إِلَى أَبِي مُحَمَّدٍ الْبَدْرِيِّ - مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَكَانَ بَدْرِيًّا - فَوَهَبَ لَهُ الْجَارِيَةَ الْبَرْبَرِيَّةَ ، فَلَمَّا جَاءَتْهُ قَالَ :  هَذِهِ مِنَ الْمَجُوسِ الَّتِي نَهَى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْهُمْ وَالَّذِينَ أَشْرَكُوا  . فَحَدَّثْتُ بِهَذَا الْحَدِيثِ رَجُلًا ، فَحَدَّثَنِي أَنَّ  يَحْيَى بْنَ سَعِيدٍ  حَدَّثَهُ  أَنَّ عَمًّا لَهُ مَاتَ  بِالْمَغْرِبِ  وَكَانَ بَدْرِيًّا  .","","Al-Mu'jam al-Kabir 787","","أبو محمد النجاري حليف بني حارثة بن الحارث بن الأوس عن مولى لرفيع بن ثابت عن يزيد بن عمرو المعافري عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن يحيى بن عثمان بن صالح عن الطبراني","مسعود أبو محمد الأنصاري"
"18967","مَسْعُودُ بْنُ سَعْدِ بْنِ خَالِدٍ الْأَنْصَارِيُّ ثُمَّ الزُّرَقِيُّ  ، اسْتُشْهِدَ  يَوْمَ خَيْبَرٍ  مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .  788  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ ،  فِي تَسْمِيَةِ مَنِ اسْتُشْهِدَ  يَوْمَ خَيْبَرٍ  مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنَ  الْأَنْصَارِ  ثُمَّ مِنْ  بَنِي زُرَيْقٍ  : مَسْعُودُ بْنُ سَعْدِ بْنِ خَالِدٍ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : (مسعود بن سعد بن خلدة).  كذا في طبعة مكتبة ابن تيمية ، والصواب : (مسعود بن سعد بن خلدة).","","Al-Mu'jam al-Kabir 788","","مسعود بن سعد الزرقي عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","مسعود بن سعد بن خالد الأنصاري"
"18968","789  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنِ  ابْنِ شِهَابٍ  فِي تَسْمِيَةِ مَنِ اسْتُشْهِدَ  يَوْمَ خَيْبَرٍ  مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنَ  الْأَنْصَارِ  ، ثُمَّ مِنْ  بَنِي زُرَيْقٍ  : مَسْعُودُ بْنُ سَعْدِ بْنِ قَيْسٍ  .","","Al-Mu'jam al-Kabir 789","","مسعود بن سعد الزرقي عن الزهري عن موسى بن عقبة عن محمد بن فليح بن سليمان الأسلمي عن محمد بن إسحاق المسيبي عن الحسن بن هارون بن سليمان الأصبهاني عن الطبراني","مسعود بن سعد بن خالد الأنصاري"
"18969","[20/333]      مَسْعُودُ بْنُ عَمْرٍو  790  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالَا :  ثَنَا  حُمَيْدُ بْنُ مَسْعَدَةَ ،  ثَنَا  حُصَيْنُ بْنُ نُمَيْرٍ ،  ثَنَا  ابْنُ أَبِي لَيْلَى ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  سَعِيدِ بْنِ يَزِيدَ ،  عَنْ  مَسْعُودِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَزَالُ الْعَبْدُ يَسْأَلُ وَهُوَ غَنِيٌّ حَتَّى يَحْلِقَ وَجْهَهُ فَمَا يَكُونُ لَهُ عِنْدَ اللهِ وَجْهٌ  .","","Al-Mu'jam al-Kabir 790","","مسعود بن عمرو القاري عن سعيد بن يزيد عن عبد الكريم بن أبي المخارق عن محمد بن عبد الرحمن بن أبي ليلى عن حصين بن نمير الأنصاري عن حميد السامي عن عبد الله بن أحمد الجواليقي عن الطبراني","مسعود بن عمرو"
"18970","مَسْعُودُ بْنُ الْأَسْوَدِ الْعَدَوِيُّ "" وَهُوَ مَسْعُودُ بْنُ الْأَسْوَدِ بْنِ حَارِثَةَ بْنِ نَضْلَةَ بْنِ عَوْفِ بْنِ عُبَيْدِ بْنِ عُوَيْجِ بْنِ عَدِيِّ بْنِ كَعْبٍ ، وَأُمُّهُ الْعَجْمَاءُ بِنْتُ عَامِرٍ  ""  791  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ، (  ح  )  وَحَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  كَامِلُ بْنُ طَلْحَةَ الْجَحْدَرِيُّ ،  ثَنَا  لَيْثُ بْنُ سَعْدٍ ،  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي حَبِيبٍ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ طَلْحَةَ بْنِ يَزِيدَ بْنِ رُكَانَةَ ، أَنَّ خَالَتَهُ بِنْتَ مَسْعُودِ بْنِ الْعَجْمَاءِ  حَدَّثَتْهُ  ،  أَنَّ  أَبَاهَا قَالَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  الْمَخْزُومِيَّةِ  الَّتِي سَرَقَتْ قَطِيفَةً : نَفْدِيهَا بِأَرْبَعِينَ أُوقِيَّةً ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تُطَهَّرُ خَيْرٌ لَهَا "" ، وَأَمَرَ بِهَا فَقُطِعَتْ يَدُهَا  .","","Al-Mu'jam al-Kabir 791","","مسعود بن الأسود بن حارثة القرشي عن عائشة بنت مسعود بن الأسود العدوية عن محمد بن طلحة بن يزيد بن ركانة الحجازي عن محمد بن إسحاق عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن كامل بن طلحة الجحدري عن موسى بن هارون الحمال عن الطبراني","مسعود بن الأسود العدوي"
"18971","792  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  أَحْمَدُ بْنُ خَالِدٍ الْوَهْبِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ طَلْحَةَ بْنِ يَزِيدَ بْنِ رُكَانَةَ ،  عَنْ  أُمِّهِ عَائِشَةَ بِنْتِ مَسْعُودِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهَا  ، قَالَ :  لَمَّا سَرَقَتِ  الْمَرْأَةُ  الْقَطِيفَةَ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَعْظَمْنَا ذَلِكَ ، وَكَانَتْ مِنْ  قُرَيْشٍ  ، فَجِئْنَا إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَكَلَّمْنَاهُ فَقُلْنَا : يَا رَسُولَ         [20/334]      اللهِ نَفْدِيهَا بِأَرْبَعِينَ أُوقِيَّةً ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" تُطَهَّرُ خَيْرٌ لَهَا "" ، فَلَمَّا سَمِعْنَاهَا لِينَ قَوْلِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ انْطَلَقْنَا إِلَى  أُسَامَةَ بْنِ زَيْدٍ  وَكَلَّمْنَاهُ فَقُلْنَا : اشْفَعْ لَنَا إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  شَأْنِ  هَذِهِ الْمَرْأَةِ ، وَنَفْدِيهَا بِأَرْبَعِينَ أُوقِيَّةً ، فَلَمَّا رَأَى ذَلِكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَامَ فِينَا خَطِيبًا فَقَالَ :  يَا أَيُّهَا النَّاسُ ، مَا إِكْثَارُكُمْ فِي حَدٍّ مِنْ حُدُودِ اللهِ وَقَعَ عَلَى أَمَةٍ مِنْ إِمَاءِ اللهِ  ؟ فَوَالَّذِي نَفْسِي بِيَدِهِ ، لَوْ أَنَّ  فَاطِمَةَ بِنْتَ مُحَمَّدٍ  قَرِفَتْ بِمَا نَزَلَتْ بِهِ هَذِهِ لَقَطَعْتُ يَدَهَا "" فَيَئِسَ النَّاسُ فَقَطَعَ يَدَهَا  .","","Al-Mu'jam al-Kabir 792","","مسعود بن الأسود بن حارثة القرشي عن عائشة بنت مسعود بن الأسود العدوية عن محمد بن طلحة بن يزيد بن ركانة الحجازي عن محمد بن إسحاق عن أحمد بن خالد بن موسى الوهبي عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","مسعود بن الأسود العدوي"
"18972","793  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ ،  ثَنَا  أَحْمَدُ بْنُ خَالِدٍ الْوَهْبِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ، (  ح  )  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  أَبِي  كُلُّهُمْ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ طَلْحَةَ بْنِ يَزِيدَ بْنِ رُكَانَةَ ،  عَنْ  أُمِّهِ عَائِشَةَ بِنْتِ مَسْعُودِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهَا مَسْعُودٍ  قَالَ :  لَمَّا سَرَقَتِ  الْمَرْأَةُ  تِلْكَ الْقَطِيفَةَ مِنْ بَيْتِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَمَرَ بِقَطْعِهَا أَعْظَمْنَا ذَلِكَ ، وَكَانَتِ امْرَأَةً مِنْ  قُرَيْشٍ  ، فَجِئْنَا إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [20/335]      فَكَلَّمْنَاهُ فَقُلْنَا : نَحْنُ نَفْدِيهَا بِأَرْبَعِينَ أُوقِيَّةً ، فَقَالَ :  تُطَهَّرُ خَيْرٌ لَهَا  ، فَلَمَّا سَمِعْنَا لِينَ قَوْلِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَتَيْنَا  أُسَامَةَ بْنَ زَيْدٍ  فَقُلْنَا لَهُ : كَلِّمْ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  شَأْنِ  هَذِهِ الْمَرْأَةِ وَنَحْنُ نَفْدِيهَا بِأَرْبَعِينَ أُوقِيَّةً ، فَلَمَّا رَأَى ذَلِكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَامَ خَطِيبًا فَقَالَ : "" يَا أَيُّهَا النَّاسُ ، مَا إِكْثَارُكُمْ عَلَيَّ فِي حَدٍّ مِنْ حُدُودِ اللهِ وَقَعَ عَلَى أَمَةٍ مِنْ إِمَاءِ اللهِ ؟ وَالَّذِي نَفْسِي بِيَدِهِ ، لَوْ كَانَتْ  فَاطِمَةُ بِنْتُ رَسُولِ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَزَلَتْ بِالَّذِي نَزَلَتْ هَذِهِ الْمَرْأَةُ لَأَقَمْتُ عَلَيْهَا  الْحَدَّ  .","","Al-Mu'jam al-Kabir 793","","مسعود بن الأسود بن حارثة القرشي عن عائشة بنت مسعود بن الأسود العدوية عن محمد بن طلحة بن يزيد بن ركانة الحجازي عن محمد بن إسحاق عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","مسعود بن الأسود العدوي"
"18973","مَسْعُودُ بْنُ خَالِدٍ الْخُزَاعِيُّ  794  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ،  ثَنَا  أَبُو مَالِكِ بْنُ أَبِي فَارَةَ الْخُزَاعِيُّ ،  حَدَّثَنِي  أَبِي أَبُو فَارَةَ ،  عَنْ  أَبِيهِ الْوَلِيدِ ،  عَنْ  جَدِّهِ مَسْعُودِ بْنِ خَالِدٍ  ، قَالَ :  بَعَثْتُ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ شَاةً ، ثُمَّ ذَهَبْتُ فِي حَاجَةٍ فَرَدَّ إِلَيْهِمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  شَطْرَهَا  ، فَرَجَعْتُ إِلَى  أُمِّ خُنَاسٍ  - زَوْجَتِهِ - فَإِذَا عِنْدَهَا لَحْمٌ ، فَقُلْتُ : يَا  أُمَّ خُنَاسٍ  ، مَا هَذَا اللَّحْمُ ؟ قَالَتْ : هَذَا اللَّحْمُ رَدَّهُ إِلَيْنَا  خَلِيلُكَ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنَ الشَّاةِ الَّتِي بَعَثْتَ بِهَا إِلَيْهِ ، قَالَ : مَا لَكِ لَا تَطْعَمُهُ عِيَالُكِ مُنْذُ غُدْوَةٍ ؟ قَالَتْ : هَذَا  سُؤْرُهُمْ  ، وَكُلُّهُمْ قَدْ أَطْعَمْتُ ، وَكَانُوا يَذْبَحُونَ الشَّاتَيْنِ وَالثَّلَاثَةَ وَلَا تُجْزِئُ عَنْهُمْ  .","","Al-Mu'jam al-Kabir 794","","مسعود بن خالد الخزاعي عن الوليد عن أبو فارة الخزاعي عن أبو مالك بن أبي فارة الخزاعي عن محمد بن علي بن زيد الصائغ عن الطبراني","مسعود بن خالد الخزاعي"
"18974","مَنِ اسْمُهُ مَسْرُوقٌ  مَسْرُوقُ بْنُ وَائِلٍ الْحَضْرَمِيُّ  795  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  كَثِيرُ بْنُ عُبَيْدٍ الْحَذَّاءُ ،  ثَنَا  بَقِيَّةُ         [20/336]      بْنُ الْوَلِيدِ ،  عَنْ  عُتْبَةَ بْنِ أَبِي عُتْبَةَ ،  عَنْ  سُلَيْمَانَ بْنِ عَمْرٍو ،  عَنِ  الضَّحَّاكِ بْنِ النُّعْمَانِ بْنِ سَعْدٍ ،  أَنَّ  مَسْرُوقَ بْنَ وَائِلٍ ، قَدِمَ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِالْمَدِينَةِ  بِالْعَقِيقِ  فَأَسْلَمَ وَحَسُنَ إِسْلَامُهُ ، قَالَ : يَا رَسُولَ اللهِ ، إِنِّي أُحِبُّ أَنْ تَبْعَثَ إِلَى قَوْمِي رَجُلًا يَدْعُوهُمْ إِلَى الْإِسْلَامِ ، وَأَنْ تَكْتُبَ لَنَا كِتَابًا إِلَى قَوْمِي عَسَى اللهُ أَنْ يَهْدِيَهُمْ بِهَا ، فَقَالَ  لِمُعَاوِيَةَ  : "" اكْتُبْ لَهُ :  بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ ، إِلَى  الْأَفْنَادِ  مِنْ  حَضْرَمَوْتَ  بِإِقَامِ الصَّلَاةِ  ، وَإِيتَاءِ الزَّكَاةِ ، وَالصَّدَقَةِ عَلَى السَّعَةِ ،  وَالتِّيمَةِ  فِي  السُّيُوبِ  الْخُمُسُ ، وَفِي  الْبَعْلِ  الْعُشْرُ ، لَا  خِلَاطَ  وَلَا  وِرَاطَ ،  وَلَا شِغَارَ وَلَا  شِنَاقَ ،  وَلَا  جَنَبَ  وَلَا  جَلَبَ  ، وَلَا يُجْمَعُ بَيْنَ بَعِيرَيْنِ فِي  عِقَالٍ  ، مَنْ أَجْبَى فَقَدْ  أَرْبَى  ، وَكُلُّ مُسْكِرٍ حَرَامٌ "" . وَبَعَثَ إِلَيْهِمْ  زِيَادَ بْنَ لَبِيدٍ الْأَنْصَارِيَّ ،  أَمَّا  الْخِلَاطُ  : فَلَا تُجْمَعُ الْمَاشِيَةُ ، وَأَمَّا  الْوِرَاطُ  : فَلَا يُقَوِّمُهَا بِالْقِيمَةِ ، وَأَمَّا  الشِّغَارُ  : فَيُزَوِّجُ الرَّجُلُ ابْنَتَهُ وَيُنْكِحُهُ الْآخَرُ ابْنَتَهُ بِلَا مَهْرٍ ، وَالشِّنَاقُ : أَنْ يَعْقِلَهَا فِي مَبَارِكِهَا ، وَالْإِجْبَاءُ : أَنْ تُبَاعَ  الثَّمَرَةُ  قَبْلَ أَنْ تُؤْمَنَ عَلَيْهَا  الْعَاهَةُ  .","","Al-Mu'jam al-Kabir 795","","مسروق بن وائل الحضرمي عن الضحاك بن النعمان عن سليمان بن عمرو عن عتبة بن أبي عتبة المدني عن بقية بن الوليد عن كثير بن عبيد المذحجي عن عبد الله بن أحمد الجواليقي عن الطبراني","مسروق بن وائل الحضرمي"
"18975","مَنِ اسْمُهُ مِخْمَرٌ  مِخْمَرُ بْنُ حَيْدَةَ الْقُشَيْرِيُّ  796  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَا :  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  ثَنَا  سُلَيْمَانُ بْنُ سُلَيْمٍ الْكِنَانِيُّ ،  عَنْ  حَكِيمِ بْنِ مُعَاوِيَةَ ،  عَنْ  عَمِّهِ مِخْمَرِ بْنِ حَيْدَةَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا شُؤْمَ ، وَقَدْ يَكُونُ الْيُمْنُ فِي         [20/337]      ثَلَاثٍ : فِي الْمَرْأَةِ  ، وَالْفَرَسِ ، وَالدَّارِ  .","","Al-Mu'jam al-Kabir 796","","مخمر بن معاوية النميري عن حكيم بن معاوية النميري عن سليمان بن سليم الكناني عن إسماعيل بن عياش الأحول عن هشام بن عمار عن الحسين بن إسحاق التستري عن الطبراني","مخمر بن حيدة القشيري"
"18976","797  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو ،  ثَنَا  أَبُو الْجُمَاهِرِ مُحَمَّدُ بْنُ عُثْمَانَ ،  ثَنَا  سَعِيدُ بْنُ بَشِيرٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  حَكِيمِ بْنِ مُعَاوِيَةَ ،  عَنْ  عَمِّهِ مِخْمَرِ بْنِ حَيْدَةَ ، قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، إِنِّي أَغِيبُ  الشَّهْرَ  عَنِ الْمَاءِ وَمَعِي أَهْلِي فَأُصِيبُ مِنْهُمْ ؟ قَالَ : "" نَعَمْ "" ، قُلْتُ : يَا رَسُولَ اللهِ ، إِنِّي أَغِيبُ أَشْهُرًا ، قَالَ :  وَإِنْ غِبْتَ ثَلَاثِينَ سَنَةً  .","","Al-Mu'jam al-Kabir 797","","مخمر بن معاوية النميري عن حكيم بن معاوية بن حيدة القشيري عن قتادة بن دعامة عن سعيد بن بشير الأزدي عن محمد بن عثمان الكفرسوسي عن أبو زرعة الدمشقي عن الطبراني","مخمر بن حيدة القشيري"
"18977","مَنِ اسْمُهُ مَازِنٌ  مَازِنُ بْنُ الْغَضُوبَةِ الْأَزْدِيُّ  798  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَاصِمٍ الْأَصْبَهَانِيُّ ،  ثَنَا  عَلِيُّ بْنُ حَرْبٍ الْمَوْصِلِيُّ ،  ثَنَا  حُصَيْنُ بْنُ كَثِيرٍ  ،  حَدَّثَنِي  جَدِّي كَثِيرُ بْنُ يَحْيَى  ، عَنْ  عَبْدِ الرَّحْمَنِ بْنِ نَجْدَةَ الْحِمْصِيِّ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِيهِ صَالِحِ بْنِ الْمُتَوَكِّلِ  ، قَالَ :  سَمِعْتُ  مَازِنَ بْنَ الْغَضُوبَةِ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  عَلَيْكُمْ بِالصِّدْقِ فَإِنَّهُ يَهْدِي إِلَى الْجَنَّةِ  .  كذا في طبعة مكتبة ابن تيمية والنسخة الخطية ، والصواب : (حسن بن كثير) كما في الأوسط للمصنف ، والله أعلم .  كذا في طبعة مكتبة ابن تيمية والنسخة الخطية ، والصواب : (يحيى بن كثير) كما في الأوسط للمصنف ، والله أعلم .","","Al-Mu'jam al-Kabir 798","","مازن بن الغضوبة بن غراب النبهاني عن صالح بن المتوكل مولى مازن بن الغضوبة عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن عبد الرحمن بن نجدة عن يحيى بن كثير الطائي عن الحسن بن كثير عن علي بن حرب الطائي عن محمد بن عاصم بن يحيى الأصبهاني عن الطبراني","مازن بن الغضوبة الأزدي"
"18978","799  -  حَدَّثَنَا  مُوسَى بْنُ جُمْهُورٍ التِّنِّيسِيُّ السِّمْسَارُ ،  ثَنَا  عَلِيُّ         [20/338]      بْنُ حَرْبٍ الْمَوْصِلِيُّ ،  ثَنَا  هِشَامُ بْنُ مُحَمَّدِ بْنِ السَّائِبِ الْكَلْبِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ الْعُمَانِيِّ ،  عَنْ  مَازِنِ بْنِ الْغَضُوبَةِ ، قَالَ :  كُنْتُ أَسْدِنُ صَنَمًا يُقَالُ لَهُ  بَاحَرٌ  بِسَمَائِلَ  - قَرْيَةٌ  بِعُمَانَ  - فَعَتَرْنَا ذَاتَ يَوْمٍ عِنْدَهُ  عَتِيرَةً  -  وَهِيَ الذَّبِيحَةُ  - فَسَمِعْتُ صَوْتًا مِنَ الصَّنَمِ يَقُولُ : يَا  مَازِنُ  اسْمَعْ تُسَرَّ ، ظَهَرَ خَيْرٌ ، وَبَطَنَ شَرٌّ ، بُعِثَ نَبِيٌّ مِنْ  مُضَرَ  ، بِدِينِ اللهِ  الْكَبِرِ  الْكَبِرِ  ، فَدَعْ نَحِيتًا مِنْ حَجَرٍ ، تَسْلَمْ مِنْ سَقَرَ ، قَالَ : فَفَزِعْتُ لِذَلِكَ ، فَقُلْتُ : إِنَّ هَذَا لَعَجَبٌ ، ثُمَّ عَتَرْتُ بَعْدَ أَيَّامٍ  عَتِيرَةً  فَسَمِعْتُ صَوْتًا مِنَ الصَّنَمِ يَقُولُ : أَقْبِلْ إِلَيَّ أَقْبِلْ ، تَسْمَعْ مَا لَا تَجْهَلْ ، هَذَا نَبِيٌّ مُرْسَلْ ، جَاءَ بِحَقٍّ مُنْزَلْ ، فَآمِنْ بِهِ كَيْ تَعْدِلْ ، عَنْ حَرِّ نَارٍ تُشْعَلْ ، وَقُودُهَا بِالْجَنْدَلْ ، فَقُلْتُ : إِنَّ هَذَا لَعَجَبٌ . وَإِنَّهُ لَخَيْرٌ يُرَادُ بِي ، فَبَيْنَا نَحْنُ كَذَلِكَ إِذْ قَدِمَ  رَجُلٌ مِنَ الْحِجَازِ  ، قُلْنَا : مَا الْخَبَرُ وَرَاءَكَ ؟ قَالَ : ظَهَرَ رَجُلٌ يُقَالُ لَهُ :  أَحْمَدُ  ، يَقُولُ لِمَنْ أَتَاهُ :  أَجِيبُوا دَاعِيَ اللهِ  . قُلْتُ : هَذَا نَبَأُ مَا قَدْ سَمِعْتُ ، فَسِرْتُ إِلَى الصَّنَمِ فَكَسَّرْتُهُ  أَجْذَاذًا  ، وَرَكِبْتُ رَاحِلَتِي ، فَقَدِمْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَشَرَحَ لِيَ الْإِسْلَامَ فَأَسْلَمْتُ وَقُلْتُ :  بَاحَرَ  أَجْذَاذًا  بَاحَرٌ  قَالَ -  يَعْنِي  عَمْرَو بْنَ الصَّلْتِ  وَإِخْوَتَهُ  بَنِي خُطَامَةَ  - قَالَ  مَازِنٌ  : فَقُلْتُ : يَا رَسُولَ اللهِ ، إِنِّي امْرُؤٌ  مُولَعٌ  بِالطَّرَبِ وَبِشُرْبِ الْخَمْرِ  وَبِالْهَلُوكِ  - قَالَ  ابْنُ الْكَلْبِيِّ  :  وَالْهَلُوكُ  : الْفَاجِرَةُ مِنَ النِّسَاءِ -  وَأَلَحَّتْ عَلَيْنَا السِّنُونَ ، فَأَذْهَبَتِ الْأَهْوَالَ ، وَأَهْزَلْنَ الذَّرَارِي وَالْعِيَالَ ، وَلَيْسَ لِي وَلَدٌ ، فَادْعُ اللهَ أَنْ يُذْهِبَ عَنِّي مَا أَجِدُ ، وَيَأْتِيَنَا بِالْحَيَاءِ ، وَيَهَبَ لِي وَلَدًا ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اللَّهُمَّ أَبْدِلْهُ بِالطَّرَبِ قِرَاءَةَ الْقُرْآنِ ، وَبِالْحَرَامِ الْحَلَالَ  ،  وَبِالْعُهْرِ  عِفَّةَ  الْفَرْجِ ، وَبِالْخَمْرِ رِيَاءً لَا إِثْمَ فِيهِ ، وَائْتِهِ بِالْحَيَاءِ ، وَهَبْ لَهُ وَلَدًا "" . قَالَ  مَازِنٌ  : "" فَأَذْهَبَ اللهُ عَنِّي         [20/339]      مَا كُنْتُ أَجِدُ ، وَأَتَانَا بِالْحَيَاءِ ، وَتَعَلَّمْتُ  شَطْرَ  الْقُرْآنِ ، وَخَصِبَ  عُمَانُ  ، وَحَجَجْتُ حَجًّا حِجَجًا ، وَوَهَبَ اللهُ لِي  حَيَّانَ بْنَ مَازِنٍ  وَأَنْشَأْتُ أَقُولُ :  الْفَيَافِي  بِالرَّغْبِ  مُولَعًا  وَبِالْعُهْرِ  إِحْصَانًا  الْجِهَادِ  فَلَمَّا قَدِمْتُ عَلَى قَوْمِي أَنَّبُونِي وَشَتَمُونِي ، وَأَمَرُوا شَاعِرًا لَهُمْ فَهَجَانِي ، فَقُلْتُ : إِنْ رَدَدْتُ عَلَيْهِ فَإِنَّمَا الْهَجْوُ لِنَفْسِي ، فَاعْتَزَلْتُهُمْ إِلَى سَاحِلِ الْبَحْرِ وَقُلْتُ :  نَشِبَ  وَغَرٌ  وَالْإِحَنُ  فَأَتَتْنِي مِنْهُمْ  أَزْفَلَةٌ  عَظِيمَةٌ ، فَقَالُوا : يَا ابْنَ عَمِّ ، عِبْنَا عَلَيْكَ أَمْرًا وَكَرِهْنَاهُ لَكَ ، فَإِنْ أَبَيْتَ فَشَأْنُكَ وَدِينُكَ ، فَارْجِعْ فَأَقِمْ أُمُورَنَا ، فَكُنْتُ الْقَيِّمَ بِأُمُورِهِمْ ، فَرَجَعْتُ مَعَهُمْ ثُمَّ هَدَاهُمُ اللهُ بَعْدُ إِلَى الْإِسْلَامِ  .  كذا في طبعة مكتبة ابن تيمية والنسخة الخطية ومجمع الزوائد ، والذي في كتب اللغة والغريب : ( مر مذاقته ) ولم أقف على ما يرجح أحد الوجهين وكلاهما موجه ، والله أعلم  في طبعة مكتبة ابن تيمية ( وبغضكم عندنا ) والمثبت من النسخة الخطية وهي كذلك في كتب اللغة ، والله أعلم","","Al-Mu'jam al-Kabir 799","","مازن بن الغضوبة بن غراب النبهاني عن عبد الله العماني عن محمد بن السائب الكلبي عن هشام بن محمد بن السائب الكلبي عن علي بن حرب الطائي عن موسى بن جمهور بن زريق البغدادي عن الطبراني","مازن بن الغضوبة الأزدي"
"18979","مَازِنُ بْنُ خَيْثَمَةَ  ،  وَهَبِيلٌ السَّكُونِيَّانِ  .  800  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ ،  ثَنَا         [20/340]      أَبُو الْيَمَانِ الْحَكَمُ بْنُ نَافِعٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  صَفْوَانَ بْنِ عَمْرٍو ،  عَنْ  عَمْرِو بْنِ قَيْسِ بْنِ ثَوْرِ بْنِ مَازِنٍ ،  أَنَّ  جَدَّهُ مَازِنَ بْنَ خَيْثَمَةَ ، وَهَبِيلَ بْنَ كَعْبٍ - أَحَدُ  بَنِي مَازِنٍ  - بَعَثَهُمَا  مُعَاذُ بْنُ جَبَلٍ  يَوْمَ نَزَلَ بَيْنَ  السَّكُونِ  وَالسَّكَاسِكِ  ، وَقَاتَلَ حَتَّى أَسْلَمَ النَّاسُ وَافِدِينَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فَآخَى بَيْنَ  السَّكُونِ  وَالسَّكَاسِكِ  .","","Al-Mu'jam al-Kabir 800","","هبيل بن كعب المازني عن عمرو بن قيس بن ثور السكوني عن صفوان بن عمرو السكسكي عن إسماعيل بن عياش الأحول عن أبو اليمان الحكم بن نافع عن أبو زرعة الدمشقي عن الطبراني","مازن بن خيثمة وهبيل السكونيان"
"18980","مَنِ اسْمُهُ مَعْبَدٌ  مَعْبَدٌ الْجُذَامِيُّ  801  -  حَدَّثَنَا  مُحَمَّدُ بْنُ دَاوُدَ التَّوَّزِيُّ ،  ثَنَا  الْحَسَنُ بْنُ حَمَّادٍ الْبَجَلِيُّ سَجَّادَةٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ الْأُمَوِيُّ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  حُمَيْدِ بْنِ مَازِنٍ ،  عَنْ  نَعْجَةَ بْنِ زَيْدٍ الْجُذَامِيِّ ،  عَنْ  أَبِيهِ  قَالَ :  وَفَدَ  رِفَاعَةُ بْنُ زَيْدٍ الْجُذَامِيُّ  عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَكَتَبَ لَهُ كِتَابًا فِيهِ :  بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ ، هَذَا كِتَابٌ مِنْ  مُحَمَّدٍ  رَسُولِ اللهِ  لِرَفَاعَةَ بْنِ زَيْدٍ  ،  إِنِّي بَعَثْتُهُ إِلَى قَوْمِهِ عَامَّةً ، وَمَنْ دَخَلَ فِيهِمْ ، يَدْعُوهُمْ إِلَى اللهِ وَإِلَى رَسُولِهِ ، فَمَنْ آمَنَ فَفِي حِزْبِ اللهِ وَفِي حِزْبِ رَسُولِهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَمَنْ أَدْبَرَ فَلَهُ أَمَانُ شَهْرَيْنِ "" فَلَمَّا قَدِمَ عَلَى قَوْمِهِ أَجَابُوهُ ، ثُمَّ سَارَ حَتَّى نَزَلَ  الْحَرَّةَ  -  حَرَّةَ الرَّجْلَاءِ  - ثُمَّ لَمْ يَلْبَثْ أَنْ أَقْبَلَ  دِحْيَةُ الْكَلْبِيُّ  مِنْ عِنْدِ  قُرَيْظَةَ  حِينَ بَعَثَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، حَتَّى إِذَا كَانَ بِوَادٍ مِنْ         [20/341]      أَوْدِيَتِهِمْ يُقَالُ لَهُ :  شِنَانُ  - وَمَعَهُ تِجَارَةٌ لَهُ أَغَارَ عَلَيْهِ  الْهُنَيْدُ بْنُ عُوَيْصٍ  ، وَأَبُوهُ  الْعُوَيْصُ الضُّبَعِيُّ  - بَطْنٌ مِنْ  جُذَامٍ  - وَأَصَابُوا كُلَّ شَيْءٍ مَعَهُ ، ثُمَّ إِنَّ نَفَرًا مِنْ قَوْمِ  رِفَاعَةَ  نَفَرُوا إِلَيْهِ ، فَأَقْبَلَ إِلَيْهِ فِيمَنْ أَقْبَلَ  النُّعْمَانُ بْنُ أَبِي جِعَالٍ  حَتَّى لَقَوْهُمْ فَاقْتَتَلُوا ، وَرَمَى  قُرَّةُ بْنُ أَشْقَرَ الضَّلَعِيُّ  النُّعْمَانَ بْنَ أَبِي جِعَالٍ  بِحَجَرٍ فَأَصَابَ كَعْبَهُ وَدَمَّاهُ ، وَقَالَ : أَنَا  ابْنُ أُثَالَةَ  ، ثُمَّ رَمَاهُ  النُّعْمَانُ بْنُ أَبِي جِعَالٍ  بِسَهْمٍ فَأَصَابَ رُكْبَتَهُ وَقَالَ : أَنَا  ابْنُ إِقَالَةَ  ، وَقَدْ كَانَ  حَسَّانُ بْنُ مِلَّةَ الضَّبِّيُّ  صَحِبَ مَعَهُ  دِحْيَةَ الْكَلْبِيَّ  قَبْلَ ذَلِكَ فَعَلَّمَهُ أُمَّ الْكِتَابِ ، وَاسْتَنْقَذُوا مَا فِي أَيْدِيهِمْ فَرَدُّوهُ عَلَى  دِحْيَةَ  ، ثُمَّ إِنَّ  دِحْيَةَ  قَدِمَ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَخْبَرَهُ خَبَرَهُمْ ، وَاسْتَسْقَاهُ دَمَ  الْهُنَيْدِ  وَأَبِيهِ  عُوَيْصٍ  وَذَلِكَ الَّذِي هَاجَ  زَيْدٌ  وَجُذَامُ  ، فَبَعَثَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  زَيْدَ بْنَ حَارِثَةَ  وَبَعَثَ مَعَهُ جَيْشًا ، وَقَدْ تَوَجَّهَتْ  غَطَفَانُ  وَجُذَامُ  وَوَائِلُ  ، وَمَنْ كَانَ مِنْ  سَلْمَانَ  ،  وَسَعْدِ بْنِ هُذَيْلٍ  حِينَ جَاءَهُمْ  رِفَاعَةُ  بِكِتَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَنَزَلَ  الْحَرَّةَ  -  حَرَّةَ الرَّجْلَاءِ  -  وَرِفَاعَةُ  بِكُرَاعِ الْغَمِيمِ  وَمَعَهُ  فَارِسٌ مِنْ بَنِي الضُّبَيْبِ  ، وَسَائِرُ  بَنِي الضُّبَيْبِ  بِوَادِي مَدَارِقَ  مِنْ نَاحِيَةِ  الْحَرَّةِ  .","","Al-Mu'jam al-Kabir 801","","معبد بن فلان الجذامي عن نعجة بن زيد الجذامي عن حميد بن مازن عن محمد بن إسحاق عن يحيى بن سعيد بن أبان عن الحسن بن حماد سجادة عن محمد بن يزداد التوزي عن الطبراني","معبد الجذامي"
"18981","مَعْبَدُ بْنُ هَوْذَةَ الْأَنْصَارِيُّ  802  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَلِيُّ بْنُ ثَابِتٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ النُّعْمَانِ بْنِ مَعْبَدِ بْنِ هَوْذَةَ الْأَنْصَارِيِّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  -  رَفَعَهُ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَمَرَ بِالْإِثْمِدِ الْمَسْرُوحِ عِنْدَ النَّوْمِ ، وَقَالَ : "" لِيَتَّقِهِ الصَّائِمُ .","","Al-Mu'jam al-Kabir 802","","معبد بن هوذة الأنصاري عن النعمان بن معبد بن هوذة الأنصاري عن عبد الرحمن بن النعمان بن معبد الأنصاري عن علي بن ثابت الجزري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","معبد بن هوذة الأنصاري"
"18982","[20/342]      مَعْبَدٌ الْقُرَشِيُّ  803  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  مَعْبَدٍ الْقُرَشِيِّ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِقُدَيْدٍ  ، فَأَتَاهُ  رَجُلٌ  فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَطَعِمْتَ الْيَوْمَ شَيْئًا لِيَوْمِ عَاشُورَاءَ  ؟ "" فَقَالَ : لَا ، إِلَّا أَنِّي شَرِبْتُ مَاءً ، قَالَ : "" فَلَا تَطْعَمْ شَيْئًا حَتَّى تَغْرُبَ الشَّمْسُ ، وَأْمُرَنَّ مَنْ وَرَاءَكَ أَنْ يَصُومُوا هَذَا الْيَوْمَ  .","","Al-Mu'jam al-Kabir 803","","معبد بن حمران عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","معبد القرشي"
"18983","مَنِ اسْمُهُ مَدْلُوكٌ  مَدْلُوكٌ أَبُو سُفْيَانَ  804  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ، وَأَبُو عَبْدِ الْمَلِكِ الْقُرَشِيُّ الدِّمَشْقِيُّ قَالَا :  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ ،  حَدَّثَنِي  مَطَرُ بْنُ الْعَلَاءِ ،  حَدَّثَتْنِي  عَمَّتِي آمِنَةُ بِنْتُ أَبِي الشَّعْثَاءِ ، وَقُطْبَةُ مَوْلَاتُهَا أَنَّهُمَا رَأَيَا مَدْلُوكًا أَبَا سُفْيَانَ  فَسَمِعَاهُ  ، يَقُولُ :  أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَعَ مَوَالِيَ فَأَسْلَمْتُ ، قَالَتْ  آمِنَةُ  : "" فَرَأَيْتُ مَا مَسَحَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ رَأْسِهِ أَسْوَدَ ، وَقَدِ ابْيَضَّ مَا سِوَى ذَلِكَ  .","","Al-Mu'jam al-Kabir 804","","مدلوك الفزاري مولاهم عن آمنة بنت أبي الشعثاء عن مطر بن العلاء الفزاري عن سليمان بن عبد الرحمن التميمي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","مدلوك أبو سفيان"
"18984","مَنِ اسْمُهُ مُنِيبٌ  مُنِيبٌ الْأَزْدِيُّ  805  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ         [20/343]      عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ ،  ثَنَا  عُتْبَةُ بْنُ حَمَّادٍ ،  ثَنَا  مُنِيبُ بْنُ مُدْرِكِ بْنِ مُنِيبٍ الْأَزْدِيُّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْجَاهِلِيَّةِ وَهُوَ يَقُولُ لِلنَّاسِ :  قُولُوا : لَا إِلَهَ إِلَّا اللهُ تُفْلِحُوا  ، فَمِنْهُمْ مَنْ  تَفَلَ  فِي وَجْهِهِ ، وَمِنْهُمْ مَنْ حَثَا عَلَيْهِ التُّرَابَ ، وَمِنْهُمْ مَنْ  سَبَّهُ  ، حَتَّى انْتَصَفَ النَّهَارُ ، فَأَقْبَلَتْ جَارِيَةٌ  بِعُسٍّ  مِنْ مَاءٍ فَغَسَلَ وَجْهَهُ أَوْ يَدَيْهِ وَقَالَ : "" يَا بُنَيَّةُ ، لَا تَخْشَيْ عَلَى أَبِيكِ عَيْلَةً وَلَا ذِلَّةً "" فَقُلْتُ : مَنْ هَذِهِ ؟ قَالُوا :  زَيْنَبُ بِنْتُ رَسُولِ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَهِيَ جَارِيَةٌ  وَضِيئَةٌ  .","","Al-Mu'jam al-Kabir 805","","منيب الغامدى عن مدرك بن منيب الأزدي عن منيب بن مدرك الشامي عن عتبة بن حماد بن خليد عن سليمان بن عبد الرحمن التميمي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","منيب الأزدي"
"18985","مَنِ اسْمُهُ مُدْرِكَةُ  مُدْرِكَةُ  بْنُ الْحَارِثِ الْأَزْدِيُّ  806  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ،  ثَنَا  هِشَامُ بْنُ خَالِدٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  عَبْدُ الْغَفَّارِ بْنُ إِسْمَاعِيلَ بْنِ عَبْدِ اللهِ ،  عَنِ  الْوَلِيدِ بْنِ عَبْدِ الرَّحْمَنِ الْجُرَشِيِّ ،  عَنْ  مُدْرِكَةَ  بْنِ الْحَارِثِ ، قَالَ :  حَجَجْتُ مَعَ أَبِي فَلَمَّا كُنَّا بِمِنًى إِذَا جَمَاعَةٌ ، فَقُلْتُ لِأَبِي : مَا هَذِهِ الْجَمَاعَةُ ؟ قَالَ : عَلَى هَذَا الصَّابِئِ ، فَإِذَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَا أَيُّهَا النَّاسُ ، قُولُوا : لَا إِلَهَ إِلَّا اللهُ تُفْلِحُوا  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : (مدرك).  كذا في طبعة مكتبة ابن تيمية ، والصواب : (مدرك).","","Al-Mu'jam al-Kabir 806","","مدرك بن الحارث الغامدي عن الوليد بن عبد الرحمن الجرشي عن عبد الغفار بن إسماعيل الدمشقي عن الوليد بن مسلم القرشي عن هشام بن خالد السلامي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","مدركة بن الحارث الأزدي"
"18986","مَنِ اسْمُهُ مَطَرٌ  مَطَرُ بْنُ عُكَامِسٍ ، وَيُقَالُ : عُكَابِسٍ  وَقَدِ اخْتُلِفَ فِي صُحْبَتِهِ  807  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ، (  ح  )         [20/344]      وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ... قَالَا :  ثَنَا  أَبُو عُتْبَةَ الْأَزْرَقُ عَبَّادُ بْنُ مُوسَى ، قَالَا :  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  مَطَرِ بْنِ عُكَامِسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا قَضَى اللهُ عَزَّ وَجَلَّ لِرَجُلٍ أَنْ يَمُوتَ بِأَرْضٍ جَعَلَ لَهُ بِهَا حَاجَةً  .","","Al-Mu'jam al-Kabir 807","","مطر بن عكامس السلمي عن أبو إسحاق السبيعي عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","مطر بن عكامس"
"18987","808  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ الْعِجْلِيُّ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  مَطَرِ بْنِ عُكَامِسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا قَضَى اللهُ عَزَّ وَجَلَّ مَنِيَّةَ عَبْدٍ بِأَرْضٍ جَعَلَ لَهُ بِهَا حَاجَةً  .","","Al-Mu'jam al-Kabir 808","","مطر بن عكامس السلمي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن صالح العجلي عن لحية الليف محمد بن العباس عن الطبراني","مطر بن عكامس"
"18988","مَنِ اسْمُهُ مَاعِزٌ  مَاعِزٌ التَّمِيمِيُّ  809  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي مُوسَى ،  عَنْ  أَبِي مَسْعُودٍ الْجُرَيْرِيِّ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ الشِّخِّيرِ ،  عَنْ  مَاعِزٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  سُئِلَ :  أَيُّ الْأَعْمَالِ أَفْضَلُ ؟ قَالَ : "" الْإِيمَانُ بِاللهِ وَحْدَهُ  ، ثُمَّ  الْجِهَادُ  ، ثُمَّ حَجَّةٌ بَرَّةٌ         [20/345]      تَفْضُلُ سَائِرَ الْعَمَلِ ، كَمَا بَيْنَ مَطْلِعِ الشَّمْسِ إِلَى مَغْرِبِهَا  .","","Al-Mu'jam al-Kabir 809","","ماعز البكائي عن يزيد بن عبد الله بن الشخير العامري عن سعيد بن إياس الجريري عن أيوب بن موسى الأموي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","ماعز التميمي"
"18989","810  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدٌ ،  عَنِ  الْجُرَيْرِيِّ ،  عَنْ  حَيَّانَ بْنِ عُمَيْرٍ ،  عَنْ  مَاعِزٍ ، قَالَ :  سَأَلَ  رَجُلٌ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَيُّ الْأَعْمَالِ أَفْضَلُ ؟ قَالَ : "" الْإِيمَانُ بِاللهِ ،  وَالْجِهَادُ  فِي سَبِيلِهِ  ، ثُمَّ أَرْعَدَتْ ثُمَّ قَالَ :  مَهْ  ؟ قَالَ : "" ثُمَّ عَمَلٌ هُوَ أَفْضَلُ مِنْ سَائِرِ الْأَعْمَالِ إِلَّا كَمَثَلِ حَجَّةٍ بَارَّةٍ  .","","Al-Mu'jam al-Kabir 810","","ماعز البكائي عن حيان بن عمير الجريري عن سعيد بن إياس الجريري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن عبد الله بن أحمد بن حنبل عن الطبراني","ماعز التميمي"
"18990","811  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ الْجُذُوعِيُّ الْقَاضِي ،  ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  وُهَيْبُ بْنُ خَالِدٍ ،  ثَنَا  سَعِيدٌ الْجُرَيْرِيُّ ،  عَنْ  حَيَّانَ بْنِ عُمَيْرٍ ،  ثَنَا  مَاعِزٌ ،  أَنَّ  رَجُلًا  سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَيُّ الْأَعْمَالِ أَفْضَلُ ؟ قَالَ : "" إِيمَانٌ بِاللهِ ،  وَجِهَادٌ  فِي سَبِيلِهِ  ، ثُمَّ أَرْعَدَتْ فَخِذُ السَّائِلِ ، فَقَالَ : ثُمَّ  مَهْ  ؟ قَالَ : "" ثُمَّ عَمَلٌ أَفْضَلُ مِنْ سَائِرِ الْأَعْمَالِ إِلَّا كَمَثَلِ حَجَّةٍ بَارَّةٍ  .","","Al-Mu'jam al-Kabir 811","","ماعز البكائي عن حيان بن عمير الجريري عن سعيد بن إياس الجريري عن وهيب بن خالد الكرابيسي عن هدبة بن خالد عن الجذوعى محمد بن محمد بن إسماعيل عن الطبراني","ماعز التميمي"
"18991","مَنِ اسْمُهُ مَزِيدَةُ  مَزِيدَةُ ، جَدُّ هُودٍ الْعَصَرِيُّ ، وَيُقَالُ : الْعَبْدِيُّ  812  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ صُدْرَانَ ،  ثَنَا  طَالِبُ بْنُ حُجَيْرٍ الْعَبْدِيُّ ،  حَدَّثَنِي  هُودٌ الْعَصَرِيُّ ،  عَنْ  جَدِّهِ  قَالَ :  بَيْنَمَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُحَدِّثُ أَصْحَابَهُ إِذْ قَالَ لَهُمْ :  سَيَطْلُعُ عَلَيْكُمْ مِنْ هَذَا الْوَجْهِ رَكْبٌ هُمْ خَيْرُ أَهْلِ الْمَشْرِقِ  ، فَقَامَ  عُمَرُ بْنُ الْخَطَّابِ  يَتَوَجَّهُ فِي ذَلِكَ الْوَجْهِ ، فَلَقِيَ ثَلَاثَةَ عَشَرَ رَاكِبًا ، فَرَحَّبَ وَقَرَّبَ وَقَالَ : مَنِ  الْقَوْمُ  ؟         [20/346]      قَالُوا : نَفَرٌ مِنْ  عَبْدِ الْقَيْسِ  ، قَالَ : فَمَا أَقْدَمَكُمْ هَذِهِ الْبِلَادَ ، التِّجَارَةُ ؟ قَالُوا : لَا ، قَالَ : فَتَبِيعُونَ سُيُوفَكُمْ هَذِهِ ؟ قَالُوا : لَا ، قَالَ : فَلَعَلَّكُمْ إِنَّمَا قَدِمْتُمْ فِي طَلَبِ هَذَا الرَّجُلِ ؟ قَالُوا : أَجَلْ ، فَمَشَى يُحَدِّثُهُمْ حَتَّى إِذَا نَظَرَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : هَذَا صَاحِبُكُمُ الَّذِي تَطْلُبُونَ ، فَرَمَى  الْقَوْمُ  بِأَنْفُسِهِمْ عَنْ رِحَالِهِمْ ، فَمِنْهُمْ مَنْ سَعَى ، وَمِنْهُمْ مَنْ هَرْوَلَ ، وَمِنْهُمْ مَنْ مَشَى حَتَّى أَتَوُا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَخَذُوا بِيَدِهِ فَقَبَّلُوهَا وَقَعَدُوا إِلَيْهِ ، وَبَقِيَ  الْأَشَجُّ  - وَهُوَ أَصْغَرُ  الْقَوْمِ  - فَأَنَاخَ الْإِبِلَ وَعَقَلَهَا وَجَمَعَ مَتَاعَ  الْقَوْمِ  ، ثُمَّ أَقْبَلَ يَمْشِي عَلَى تُؤَدَةٍ حَتَّى أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَخَذَ بِيَدِهِ فَقَبَّلَهَا ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" فِيكَ  خَصْلَتَانِ  يُحِبُّهُمَا اللهُ وَرَسُولُهُ "" ، قَالَ : مَا هُمَا يَا نَبِيَّ اللهِ ؟ قَالَ : "" الْأَنَاةُ وَالتُّؤَدَةُ "" ، فَقَالَ : يَا نَبِيَّ اللهِ ، أَجَبْلٌ  جُبِلْتُ  عَلَيْهِ ؟ أَوْ  خُلُقٌ  مِنِّي ؟ قَالَ : "" بَلْ جَبْلٌ  جُبِلْتَ  عَلَيْهِ "" ، فَقَالَ : الْحَمْدُ لِلهِ الَّذِي  جَبَلَنِي  عَلَى مَا يُحِبُّ اللهُ وَرَسُولُهُ ، وَأَقْبَلَ  الْقَوْمُ  عَلَى تَمَرَاتٍ لَهُمْ يَأْكُلُونَهَا فَجَعَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُحَدِّثُهُمْ بِهَا ، يُسَمِّي لَهُمْ : هَذَا كَذَا ، وَهَذَا كَذَا ، قَالُوا : أَجَلْ يَا نَبِيَّ اللهِ ، مَا نَحْنُ بِأَعْلَمَ بِأَسْمَائِهَا مِنْكَ ، فَقَالَ : "" أَجَلْ "" ، فَقَالُوا  لِرَجُلٍ  مِنْهُمْ : أَطْعِمْنَا مِنْ بَقِيَّةِ  الْقَوْسِ  الَّذِي بَقِيَ مِنْ  نَوْطِكَ ،  فَأَتَاهُمْ بِالْبَرْنِيِّ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" هَذَا الْبَرْنِيُّ ، أَمَا إِنَّهُ مِنْ خَيْرِ تَمْرِكُمْ ، دَوَاءٌ لَا دَاءَ فِيهِ  .","","Al-Mu'jam al-Kabir 812","","مزيدة بن جابر العبدي عن هود بن عبد الله بن سعد العبدي عن طالب بن حجير العبدي عن محمد بن إبراهيم بن صدران الأزدي عن الحسين بن إسحاق التستري عن الطبراني","مزيدة جد هود العصري"
"18992","813  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مَتُّوَيْهِ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ صُدْرَانَ ،  ثَنَا  طَالِبُ بْنُ حُجَيْرٍ ،  ثَنَا  هُودٌ الْعَصَرِيُّ ،  عَنْ  جَدِّهِ  ،  أَنَّ النَّبِيَّ صَلَّى         [20/347]      اللهُ عَلَيْهِ وَسَلَّمَ دَخَلَ  مَكَّةَ  يَوْمَ الْفَتْحِ  وَعَلَى سَيْفِهِ ذَهَبٌ وَفِضَّةٌ  .","","Al-Mu'jam al-Kabir 813","","مزيدة بن جابر العبدي عن هود بن عبد الله بن سعد العبدي عن طالب بن حجير العبدي عن محمد بن إبراهيم بن صدران الأزدي عن عبد الله بن أحمد الجواليقي عن الطبراني","مزيدة جد هود العصري"
"18993","814  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  مُحَمَّدُ بْنُ اللَّيْثِ الْهَدَادِيُّ ،  ثَنَا  يَحْيَى بْنُ رَاشِدٍ ،  ثَنَا  أَبُو بَكْرٍ طَالِبُ بْنُ حُجَيْرٍ ،  ثَنَا  هُودٌ الْعَصَرِيُّ قَالَ :  سَمِعْتُ  جَدِّي مَزِيدَةَ الْعَبْدِيَّ ،  يَقُولُ :  إِنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَقَدَ رَايَاتِ  الْأَنْصَارِ  فَجَعَلَهُنَّ صُفَرًا  .","","Al-Mu'jam al-Kabir 814","","مزيدة بن جابر العبدي عن هود بن عبد الله بن سعد العبدي عن طالب بن حجير العبدي عن يحيى بن راشد المستملي عن محمد بن الليث السرخسي عن عبد الله بن أحمد الجواليقي عن الطبراني","مزيدة جد هود العصري"
"18994","مَنِ اسْمُهُ مُسَيَّبٌ  مُسَيِّبُ بْنُ حَزْنِ بْنِ أَبِي وَهْبِ بْنِ عَمْرِو بْنِ عَائِذِ بْنِ عِمْرَانَ بْنِ مَخْزُومٍ  وَأُمُّهُ  أُمُّ الْحَارِثِ بِنْتُ شُعْبَةَ بْنِ عَبْدِ اللهِ بْنِ أَبِي قَيْسِ بْنِ عَبْدِ وُدِّ بْنِ نَصْرِ بْنِ مَالِكِ بْنِ حَسَلٍ  ، وَهُوَ  أَبُو سَعِيدِ بْنِ الْمُسَيِّبِ  وَكَانَ مِمَّنْ بَايَعَ تَحْتَ الشَّجَرَةِ  815  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  طَارِقِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ :  قُلْتُ  لِسَعِيدِ بْنِ الْمُسَيِّبِ : أَيْنَ  مَسْجِدُ الشَّجَرَةِ  ؟ فَضَحِكَ وَقَالَ : مَا نَدْرِي ، ثُمَّ قَالَ :  أَخْبَرَنِي  أَبِي  أَنَّهُ كَانَ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَلِكَ الْعَامَ وَأَنَّهُمْ أُنْسُوهَا  .","","Al-Mu'jam al-Kabir 815","","المسيب بن حزن المخزومي عن سعيد بن المسيب عن طارق بن عبد الرحمن البجلي عن سفيان الثوري عن موسى بن مسعود النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مسيب بن حزن بن أبي وهب"
"18995","816  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  طَارِقِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ :         [20/348]      خَرَجْتُ حَاجًّا فَمَرَرْتُ بِقَوْمٍ يُصَلُّونَ عِنْدَ مَسْجِدٍ يَقُولُونَ : هَذِهِ شَجَرَةُ بَيْعَةِ الرِّضْوَانِ حِينَ بَايَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَتَيْتُ  سَعِيدَ بْنَ الْمُسَيِّبِ  فَأَخْبَرْتُهُ  فَقَالَ :  حَدَّثَنِي  أَبِي  أَنَّهُ "" كَانَ فِيمَنْ بَايَعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَحْتَ الشَّجَرَةِ "" قَالَ : فَلَمَّا خَرَجْنَا مِنَ الْعَامِ الْمُقْبِلِ نَسِينَاهَا ، فَلَمْ نَقْدِرْ عَلَيْهَا  ، قَالَ  سَعِيدٌ  : "" فَإِنْ كَانَ أَصْحَابُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمْ يَعْلَمُوهَا وَعَلِمْتُمُوهَا فَأَنْتُمْ أَعْلَمُ ""  .","","Al-Mu'jam al-Kabir 816","","المسيب بن حزن المخزومي عن سعيد بن المسيب عن طارق بن عبد الرحمن البجلي عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","مسيب بن حزن بن أبي وهب"
"18996","817  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  شَبَابَةُ ،  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ  الشَّجَرَةَ  ثُمَّ أَتَيْتُهَا بَعْدُ فَلَمْ أَعْرِفْهَا  "" .","","Al-Mu'jam al-Kabir 817","","المسيب بن حزن المخزومي عن سعيد بن المسيب عن قتادة بن دعامة عن شعبة بن الحجاج عن شبابة بن سوار المدائني عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","مسيب بن حزن بن أبي وهب"
"18997","818  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ الْأَصْبَهَانِيُّ ،  ثَنَا  عُبَيْدُ بْنُ الْحَجَّاجِ بْنِ الْمِنْهَالِ ،  ثَنَا  يَحْيَى بْنُ سَلَمَةَ بْنِ حَمَّادٍ ،  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِيهِ  ،  أَنَّ أَبَاهُ أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : "" مَا اسْمُكَ ؟ "" قُلْتُ :  حَزْنٌ  ، قَالَ : "" أَنْتَ  سَهْلٌ  "" ، قَالَ : لَا أَدَعُ اسْمَهَا قَالَ :  سَعِيدٌ  : "" تِلْكَ  الْحُزُونَةُ  فِينَا إِلَى السَّاعَةِ  .","","Al-Mu'jam al-Kabir 818","","حزن بن أبي وهب المخزومي عن المسيب بن حزن المخزومي عن سعيد بن المسيب عن قتادة بن دعامة عن همام بن يحيى بن دينار عن يحيى بن سلمة بن حماد عن عبيد بن الحجاج بن المنهال عن محمد بن العباس ابن الأخرم عن الطبراني","مسيب بن حزن بن أبي وهب"
"18998","819  -  حَدَّثَنَا  عَبْدَانُ بْنُ مُحَمَّدٍ الْمَرْوَزِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،         [20/349]      عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِيهِ  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ لِجَدِّهِ : "" مَا اسْمُكَ ؟ "" قَالَ :  حَزْنٌ  ،  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" بَلْ أَنْتَ  سَهْلٌ  "" ، قَالَ : لَا أُغَيِّرُ اسْمًا سَمَّانِيهِ أَبِي "" .  فَمَا زَالَتْ تِلْكَ  الْحُزُونَةُ  فِينَا بَعْدُ  .","","Al-Mu'jam al-Kabir 819","","المسيب بن حزن المخزومي عن سعيد بن المسيب عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","مسيب بن حزن بن أبي وهب"
"18999","820  -  حَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ ،  ثَنَا  مُحَمَّدُ بْنُ الصَّلْتِ أَبُو يَعْلَى التَّوَّزِيُّ ،  ثَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِيهِ  ، قَالَ :  لَمَّا حَضَرَتْ  أَبَا طَالِبٍ  الْوَفَاةُ وَعِنْدَهُ  أَبُو جَهْلِ بْنُ هِشَامٍ  ،  وَعَبْدُ اللهِ بْنُ أَبِي أُمَيَّةَ  أَتَاهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  يَا عَمِّ ، قُلْ : لَا إِلَهَ إِلَّا اللهُ ، كَلِمَةً أُحَاجُّ لَكَ بِهَا عِنْدَ اللهِ  ، قَالُوا : يَا  أَبَا طَالِبٍ  ، أَتَرْغَبُ عَنْ مِلَّةِ  عَبْدِ الْمُطَّلِبِ  ؟ فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ :         {      إِنَّكَ لا تَهْدِي مَنْ أَحْبَبْتَ وَلَكِنَّ اللهَ يَهْدِي مَنْ يَشَاءُ وَهُوَ أَعْلَمُ بِالْمُهْتَدِينَ         }      .","","Al-Mu'jam al-Kabir 820","","المسيب بن حزن المخزومي عن سعيد بن المسيب عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن محمد بن الصلت التوزي عن الفضل بن الحباب الجمحي عن الطبراني","مسيب بن حزن بن أبي وهب"
"19000","مَنِ اسْمُهُ مُعَيْقِيبٌ  مُعَيْقِيبُ بْنُ أَبِي فَاطِمَةَ الدَّوْسِيُّ  مِنْ  مُهَاجِرَةِ الْحَبَشَةِ  ، حَلِيفُ  بَنِي سَعِيدِ بْنِ الْعَاصِ الْأَكْبَرِ  ، وَكَانَ جَارًا  لِعُمَرَ بْنِ الْخَطَّابِ  عَلَى بَيْتِ الْمَالِ  .  821  -  حَدَّثَنَا  بِذَلِكَ  أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحِيمِ الْبَرْقِيُّ  ،  ثَنَا  عَبْدُ الْمَلِكِ بْنُ هِشَامٍ السَّدُوسِيُّ  ،  ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ الْبَكَّائِيُّ  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ  .","","Al-Mu'jam al-Kabir 821","","","معيقيب بن أبي فاطمة الدوسي"
"19001","[20/350]      مَا  أَسْنَدَ  مُعَيْقِيبٌ  822  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  أَيُّوبُ بْنُ عُتْبَةَ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءَ ،  ثَنَا  أَيُّوبُ بْنُ عُتْبَةَ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  مُعَيْقِيبٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  وَيْلٌ  لِلْأَعْقَابِ  مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 822","","معيقيب بن أبي فاطمة البدري عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أيوب بن عتبة اليمامي عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","ما أسند معيقيب"
"19002","823  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وُهَيْبٍ الْغَزِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ ،  ثَنَا  مُبَشِّرُ بْنُ إِسْمَاعِيلَ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ  ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  مُعَيْقِيبٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  وَيْلٌ  لِلْأَعْقَابِ  مِنَ النَّارِ  .  زاد بعده في طبعة مكتبة ابن تيمية : (عن أبي كثير) خطأ والمثبت من النسخة الخطية .","","Al-Mu'jam al-Kabir 823","","معيقيب بن أبي فاطمة البدري عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن مبشر بن إسماعيل الحلبي عن محمد بن المتوكل بن ابى السرى عن عبد الله بن وهيب الجذامي عن الطبراني","ما أسند معيقيب"
"19003","824  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ ، وَأَبُو زَيْدٍ الْحَوْطِيَّانِ قَالَا :  ثَنَا  أَبُو الْمُغِيرَةِ ،  ثَنَا  الْأَوْزَاعِيُّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ، قَالَ :  حَدَّثَنِي  مُعَيْقِيبٌ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ كُنْتَ فَاعِلًا فَمَرَّةً  .  يَعْنِي مَسْحَ الْحَصَا  .         [20/351]","","Al-Mu'jam al-Kabir 824","","معيقيب بن أبي فاطمة البدري عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن عبد القدوس بن الحجاج عن أحمد بن عبد الرحيم بن يزيد الحوطي عن الطبراني","ما أسند معيقيب"
"19004","825  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْحَسَنِ الْمِصِّيصِيُّ ،  ثَنَا  الْحَسَنُ بْنُ مُوسَى الْأَشْيَبُ ،  ثَنَا  شَيْبَانُ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  حَدَّثَنِي  مُعَيْقِيبٌ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ فِي الرَّجُلِ يُسَوِّي الْحَصَا وَالتُّرَابَ حَيْثُ يَسْجُدُ قَالَ :  إِنْ كُنْتَ لَا بُدَّ فَاعِلًا فَوَاحِدَةً  .","","Al-Mu'jam al-Kabir 825","","معيقيب بن أبي فاطمة البدري عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن شيبان بن عبد الرحمن المؤدب عن الحسن بن موسى الأشيب عن عبد الله بن الحسين بن جابر المصيصي عن الطبراني","ما أسند معيقيب"
"19005","826  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  ثَنَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  مُعَيْقِيبٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا تَمْسَحْ وَأَنْتَ تُصَلِّي ، وَإِنْ كُنْتَ لَا بُدَّ فَاعِلًا فَوَاحِدَةً تَسْوِيَةَ الْحَصَا  .","","Al-Mu'jam al-Kabir 826","","معيقيب بن أبي فاطمة البدري عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن هشام الدستوائي عن مسلم بن إبراهيم الشحام عن أبو مسلم الكجي عن الطبراني","ما أسند معيقيب"
"19006","827  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ الْمُنْذِرِ الْقَزَّازُ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ،  ثَنَا  هَمَّامٌ ،  ثَنَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  مُعَيْقِيبٍ ، أَنَّهُ  سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الْمَسْحِ فِي الصَّلَاةِ ، فَقَالَ :  وَاحِدَةً وَإِلَّا فَذَرْ  .","","Al-Mu'jam al-Kabir 827","","معيقيب بن أبي فاطمة البدري عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن همام بن يحيى بن دينار عن حفص بن عمر الحوضى عن محمد بن يحيى بن المنذر القزاز عن الطبراني","ما أسند معيقيب"
"19007","828  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُعَاذٍ الْحَلَبِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنَا  حَرْبُ بْنُ شَدَّادٍ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  مُعَيْقِيبٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ لَهُ فِي الْمَسْحِ فِي الصَّلَاةِ :  إِنْ كُنْتَ فَاعِلًا فَوَاحِدَةً  .","","Al-Mu'jam al-Kabir 828","","معيقيب بن أبي فاطمة البدري عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن حرب بن شداد اليشكري عن عبد الله بن رجاء الغداني عن محمد بن معاذ بن سفيان العنزي عن الطبراني","ما أسند معيقيب"
"19008","829  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ جَابِرٍ الْمُحَارِبِيُّ ،  ثَنَا  يَحْيَى بْنُ يَعْلَى ،  عَنْ  أَبِيهِ ،  عَنْ  غَيْلَانَ بْنِ جَامِعٍ ،  عَنْ  أَبِي عَبْدِ اللهِ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  مُعَيْقِيبٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اهْتَزَّ  الْعَرْشُ  لِمَوْتِ  سَعْدِ بْنِ مُعَاذٍ  .         [20/352]","","Al-Mu'jam al-Kabir 829","","معيقيب بن أبي فاطمة البدري عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن إسماعيل بن أبي خالد عن غيلان بن جامع المحاربي عن يعلى بن الحارث بن حرب المحاربي عن يحيى بن يعلى بن الحارث المحاربي عن محمد بن جابر بن بجير المحاربي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ما أسند معيقيب"
"19009","830  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ أَحْمَدَ بْنِ يُونُسَ الْأَهْوَازِيُّ الْكَاتِبُ ،  ثَنَا  النَّضْرُ بْنُ يَزِيدَ النَّهَرَتِيرِيُّ ،  ثَنَا  مُبَشِّرُ بْنُ إِسْمَاعِيلَ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  مُعَيْقِيبٍ ، قَالَ :  اعْتَكَفَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  قُبَّةٍ  مِنْ خُوصٍ ، بَابُهَا مِنْ حَصِيرٍ ، وَالنَّاسُ فِي الْمَسْجِدِ  .","","Al-Mu'jam al-Kabir 830","","معيقيب بن أبي فاطمة البدري عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن مبشر بن إسماعيل الحلبي عن النضر بن يزيد النهرتيري عن الحسين بن أحمد بن يونس الأهوازي الكاتب عن الطبراني","ما أسند معيقيب"
"19010","831  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  أَبُو الْخَطَّابِ زِيَادُ بْنُ يَحْيَى ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ، قَالُوا :  ثَنَا  سَهْلُ بْنُ حَمَّادٍ أَبُو عَتَّابٍ الدَّلَّالُ ،  ثَنَا  أَبُو مَكِينٍ نُوحُ بْنُ رَبِيعَةَ ،  حَدَّثَنِي  إِيَاسُ بْنُ الْحَارِثِ بْنِ مُعَيْقِيبٍ ،  عَنْ  جَدِّهِ مُعَيْقِيبٍ  ، قَالَ :  كَانَ خَاتَمُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ حَدِيدٍ مَلْوِيٍّ عَلَيْهِ فِضَّةٌ  ، فَرُبَّمَا كَانَ فِي يَدِي "" . وَكَانَ  مُعَيْقِيبٌ  عَلَى خَاتَمِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 831","","معيقيب بن أبي فاطمة البدري عن إياس بن الحارث بن معيقيب الدوسي عن نوح بن ربيعة الأنصاري عن سهل بن حماد الدلال عن الحسن بن علي الريحاني عن محمد بن عثمان بن أبي شيبة عن الطبراني","ما أسند معيقيب"
"19011","832  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  أَبُو أُمَيَّةَ بْنُ يَعْلَى الثَّقَفِيُّ ،  عَنْ  مُحَمَّدِ بْنِ مُعَيْقِيبٍ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  حُرِّمَتِ النَّارُ عَلَى الْهَيِّنِ اللَّيِّنِ السَّهْلِ الْقَرِيبِ  .","","Al-Mu'jam al-Kabir 832","","معيقيب بن أبي فاطمة البدري عن محمد بن معيقيب عن إسماعيل بن يعلى الثقفي عن شيبان بن فروخ الحبطي عن عبد الله بن أحمد بن حنبل عن الطبراني","ما أسند معيقيب"
"19012","[20/353]      مَنِ اسْمُهُ مَيْسَرَةُ  مَيْسَرَةُ الْفَجْرِ الْعُقَيْلِيُّ  833  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ الرَّقِّيُّ ، وَأَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ سِنَانٍ الْعَوَقِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  بُدَيْلِ بْنِ مَيْسَرَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنْ  مَيْسَرَةَ الْفَجْرِ ، قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، مَتَى كُنْتَ نَبِيًّا ؟ قَالَ :  وَآدَمُ  بَيْنَ الرُّوحِ وَالْجَسَدِ  "" .","","Al-Mu'jam al-Kabir 833","","عبد الله بن أبي الجدعاء ميسرة الفجر عن عبد الله بن شقيق العقيلي عن بديل بن ميسرة العقيلي عن إبراهيم بن طهمان عن محمد بن سنان الباهلي عن أحمد بن داود بن موسى السدوسي عن الطبراني","ميسرة الفجر العقيلي"
"19013","834  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  يَحْيَى بْنُ مَعِينٍ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عَلِيُّ بْنُ بَحْرٍ ، قَالُوا :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  ثَنَا  مَنْصُورُ بْنُ سَعْدٍ ،  عَنْ  بُدَيْلِ بْنِ مَيْسَرَةَ الْعُقَيْلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنْ  مَيْسَرَةَ الْفَجْرِ ، قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، "" مَتَى كُنْتَ نَبِيًّا ؟ قَالَ : ""  وَآدَمُ  بَيْنَ الرُّوحِ وَالْجَسَدِ  .","","Al-Mu'jam al-Kabir 834","","عبد الله بن أبي الجدعاء ميسرة الفجر عن عبد الله بن شقيق العقيلي عن بديل بن ميسرة العقيلي عن منصور بن سعد اللؤلؤي عن عبد الرحمن بن مهدي عن علي بن بحر بن بري القطان عن الحسين بن إسحاق التستري عن الطبراني","ميسرة الفجر العقيلي"
"19014","مَنِ اسْمُهُ مَيْمُونٌ  مَيْمُونُ بْنُ سِنْبَاذَ  835  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  سُلَيْمَانُ بْنُ أَيُّوبَ ، صَاحِبُ         [20/354]      الْبَصْرِيِّ ،  ثَنَا  هَارُونُ بْنُ دِينَارٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  سَمِعْتُ  رَجُلًا مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُقَالُ لَهُ مَيْمُونُ بْنُ سِنْبَاذَ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قِوَامُ أُمَّتِي بِشِرَارِهَا  .","","Al-Mu'jam al-Kabir 835","","ميمون بن سنباذ الأسلع عن دينار أبو هارون عن هارون بن دينار بن أبي المغيرة العجلي عن سليمان بن أيوب بن سليمان عن موسى بن هارون الحمال عن الطبراني","ميمون بن سنباد"
"19015","مَنِ اسْمُهُ مِهْرَانُ  مِهْرَانُ مَوْلَى رَسُولِ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقَدِ اخْتُلِفَ فِي اسْمِهِ فَقَالُوا :  كَيْسَانُ  أَوْ  هُرْمُزُ  ، وَالصَّوَابُ عِنْدِي  مِهْرَانُ  ؛ لِأَنَّ  الثَّوْرِيَّ  أَتْقَنُ مَنْ رَوَاهُ .  836  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  حَدَّثَتْنِي  أُمُّ كُلْثُومِ بِنْتُ عَلِيٍّ ، - وَأَتَيْتُهَا بِصَدَقَةٍ كَانَ أَمَرَ بِهَا - فَقَالَتِ : احْذَرْ شَبَابَنَا ،  فَإِنَّ  مَيْمُونًا أَوْ مِهْرَانًا  مَوْلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَخْبَرَنِي  أَنَّهُ مَرَّ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  يَا  مَيْمُونُ  - أَوْ  مِهْرَانُ  - إِنَّا أَهْلُ بَيْتٍ نُهِينَا عَنِ الصَّدَقَةِ  ، وَإِنَّ مَوَالِيَنَا مِنْ أَنْفُسِنَا ، فَلَا تَأْكُلِ الصَّدَقَةَ  .","","Al-Mu'jam al-Kabir 836","","ميمون مولى رسول الله عن أم كلثوم بنت علي بن أبي طالب عن عطاء بن السائب عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","مهران مولى رسول الله صلى الله عليه وسلم"
"19016","837  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  وَرْقَاءُ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ، قَالَ :  دَخَلْتُ عَلَى أُمِّ كُلْثُومِ بِنْتِ عَلِيٍّ بِشَيْءٍ مِنَ الصَّدَقَةِ فَقَالَتْ : إِنَّ مَوْلًى لَنَا يُقَالُ لَهُ :  كَيْسَانُ - أَوْ هُرْمُزُ  -  أَخْبَرَنِي  ، أَنَّهُ مَرَّ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : فَدَعَانِي فَجِئْتُ فَقَالَ :  يَا فُلَانُ ، إِنَّا أَهْلُ بَيْتٍ قَدْ نُهِينَا أَنْ نَأْخُذَ الصَّدَقَةَ ، وَإِنَّ  مَوْلَى  الْقَوْمِ  مِنْ أَنْفُسِهِمْ ، فَلَا تَأْكُلِ الصَّدَقَةَ  .","","Al-Mu'jam al-Kabir 837","","ذكوان مولى رسول الله صلى الله عليه وسلم عن أم كلثوم بنت علي بن أبي طالب عن عطاء بن السائب عن ورقاء بن عمر عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","مهران مولى رسول الله صلى الله عليه وسلم"
"19017","[20/355]      مَنِ اسْمُهُ مُنَيْذِرٌ  مُنَيْذِرٌ الْأَسْلَمِيُّ  838  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  الْجَرَّاحُ بْنُ مَخْلَدٍ ،  ثَنَا  أَحْمَدُ بْنُ سُلَيْمَانَ ،  ثَنَا  رِشْدِينُ بْنُ سَعْدٍ ،  عَنْ  حَيِّ بْنِ عَبْدِ اللهِ الْمَعَافِرِيِّ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنِ  الْمُنَيْذِرِ ، صَاحِبِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَكَانَ يَكُونُ  بِإِفْرِيقِيَّةَ  - قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ قَالَ إِذَا أَصْبَحَ : رَضِيتُ بِاللهِ رَبًّا ، وَبِالْإِسْلَامِ دِينًا ،  وَبِمُحَمَّدٍ  نَبِيًّا ،  فَأَنَا  الزَّعِيمُ  ، لَآخُذَ بِيَدِهِ حَتَّى أُدْخِلَهُ الْجَنَّةَ  .","","Al-Mu'jam al-Kabir 838","","المنيذر الأسلمي عن عبد الله بن يزيد المعافري عن حيي بن عبدالله المعافري عن رشدين بن سعد المهري عن أحمد بن أبي الطيب عن الجراح بن مخلد عن عبد الله بن أحمد الجواليقي عن الطبراني","منيذر الأسلمي"
"19018","مَنِ اسْمُهُ مُنْذِرٌ  مُنْذِرُ بْنُ سَاوَى  كَانَ عَامِلَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى  الْبَحْرَيْنِ  839  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ ،  ثَنَا  الْحَسَنُ بْنُ إِدْرِيسَ الْحُلْوَانِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ سُلَيْمَانَ الرَّازِيُّ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي مِجْلَزٍ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كَتَبَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  الْمُنْذِرِ بْنِ سَاوَى  :  مَنْ صَلَّى صَلَاتَنَا ، وَاسْتَقْبَلَ قِبْلَتَنَا ، وَأَكَلَ ذَبِيحَتَنَا فَذَاكُمُ الْمُسْلِمُ  ، لَهُ ذِمَّةُ اللهِ ، وَذِمَّةُ الرَّسُولِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  "" .","","Al-Mu'jam al-Kabir 839","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن لاحق بن حميد عن قتادة بن دعامة عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن إسحاق بن سليمان الرازي عن الحسن بن إدريس الحلواني عن أحمد بن يحيى بن إسحاق الحلواني عن الطبراني","منذر بن ساوى"
"19019","مُنْذِرُ بْنُ عَمْرٍو الْأَنْصَارِيُّ ثُمَّ السَّاعِدِيُّ  اسْتُشْهِدَ  يَوْمَ بِئْرِ مَعُونَةَ  وَكَانَ أَمِيرَ السَّرِيَّةِ .  840  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا         [20/356]      ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ قَالَ :  ثُمَّ غَزْوَةُ  الْمُنْذِرِ بْنِ عَمْرٍو أَخِي بَنِي سَاعِدَةَ  إِلَى  بِئْرِ مَعُونَةَ  ، وَبَعَثَ مَعَهُمُ  الْمُطَّلِبَ السُّلَمِيَّ  لِيَدُلَّهُمْ عَلَى الطَّرِيقِ ، فَبَعَثَ أَعْدَاءُ اللهِ إِلَى  عَامِرِ بْنِ الطُّفَيْلِ  يَسْتَمِدُّونَهُ فَأَمَدَّهُمْ عَلَى الْمُسْلِمِينَ ، فَقُتِلَ  الْمُنْذِرُ بْنُ عَمْرٍو  وَأَصْحَابُهُ ، إِلَّا  عَمْرَو بْنَ أُمَيَّةَ الضَّمْرِيَّ  فَإِنَّهُمْ أَسَرُوهُ فَاسْتَحْيَوْهُ حَتَّى قَدِمُوا بِهِ  مَكَّةَ  فَهُوَ دَفَنَ  خُبَيْبَ بْنَ عَدِيٍّ  ، وَعَرَضَ الْمُشْرِكُونَ عَلَى  عُرْوَةَ بْنِ الصَّلْتِ  يَوْمَ بِئْرِ مَعُونَةَ  أَنْ يُؤَمِّنُوهُ فَأَبَى فَقَتَلُوهُ ، فَذُكِرَ لَنَا أَنَّ الْمُسْلِمِينَ قَالُوا  يَوْمَ بِئْرِ مَعُونَةَ  حِينَ أَحَاطَ بِهِمُ الْعَدُوُّ :  اللَّهُمَّ إِنَّا لَا نَجِدُ مَنْ يُبَلِّغُ عَنَّا رَسُولَكَ غَيْرُكَ ، اللَّهُمَّ فَاقْرَأْ عَلَيْهِ مِنَّا السَّلَامَ وَأَخْبِرْهُ خَبَرَنَا  .","","Al-Mu'jam al-Kabir 840","","عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","منذر بن عمرو الأنصاري"
"19020","841  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ ،  ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ قَالَ :  أَقَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعْدَ  أُحُدٍ  بَقِيَّةَ شَوَّالٍ ، وَذَا الْقَعْدَةِ ، وَذَا الْحِجَّةِ وَوَلِيَ تِلْكَ الْحَجَّةَ الْمُشْرِكُونَ ، وَالْمُحَرَّمَ ، ثُمَّ بَعَثَ أَصْحَابَ  بِئْرِ مَعُونَةَ  فِي صَفَرٍ عَلَى رَأْسِ أَرْبَعَةِ أَشْهُرٍ مِنْ  أُحُدٍ  "" .  فَكَانَ مِنْ حَدِيثِهِمْ كَمَا  حَدَّثَنِي  أَبِي إِسْحَاقُ بْنُ يَسَارٍ ،  عَنِ  الْمُغِيرَةِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ، وَعَبْدُ اللهِ بْنُ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ وَغَيْرِهِمْ مِنْ أَهْلِ الْعِلْمِ قَالُوا : قَدِمَ  أَبُو بَرَاءٍ عَامِرُ بْنُ مَالِكِ بْنِ جَعْفَرٍ  مُلَاعِبُ الْأَسِنَّةِ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْمَدِينَةَ  فَعَرَضَ عَلَيْهِ الْإِسْلَامَ فَلَمْ يُسْلِمْ وَلَمْ يَبْعُدْ مِنَ الْإِسْلَامِ ، فَقَالَ : يَا  مُحَمَّدُ  ، لَوْ بَعَثْتَ رِجَالًا مِنْ أَصْحَابِكَ إِلَى  أَهْلِ نَجْدٍ  فَدَعَوْهُمْ إِلَى الْإِيمَانِ ، رَجَوْتُ أَنْ يَسْتَجِيبُوا لَكَ ، فَابْعَثْهُمْ فَلْيَدْعُوا النَّاسَ إِلَى أَمْرِكَ ، فَبَعَثَ رَسُولُ اللهِ صَلَّى         [20/357]      اللهُ عَلَيْهِ وَسَلَّمَ  الْمُنْذِرَ بْنَ عَمْرٍو أَخَا بَنِي سَاعِدَةَ بْنِ كَعْبِ بْنِ الْخَزْرَجِ  الْمُعْنِقَ لِيَمُوتَ فِي أَرْبَعِينَ رَجُلًا مِنَ الْمُسْلِمِينَ مِنْ خِيَارِهِمْ ، مِنْهُمُ  الْحَارِثُ بْنُ الصِّمَّةِ  ،  وَحَرَامُ بْنُ مِلْحَانَ أَخُو بَنِي عَدِيِّ بْنِ النَّجَّارِ  ،  وَعُرْوَةُ بْنُ أَسْمَاءَ بْنِ الصَّلْتِ السُّلَمِيُّ  ،  وَنَافِعُ بْنُ بُدَيْلِ بْنِ وَرْقَاءَ الْخُزَاعِيُّ  ،  وَعَامِرُ بْنُ فُهَيْرَةَ مَوْلَى أَبِي بَكْرٍ  ، وَرِجَالٌ مُسَمَّوْنَ مِنْ خِيَارِ الْمُسْلِمِينَ ، فَسَارُوا حَتَّى نَزَلُوا  بِئْرَ مَعُونَةَ  - وَهِيَ بَيْنَ أَرْضِ  بَنِي عَامِرٍ  ، وَحَّرَةِ  بَنِي سُلَيْمٍ  ، كِلَا الْبَلَدَيْنِ مِنْهَا قَرِيبٌ ، وَهِيَ مِنْ  سُلَيْمٍ  أَقْرَبُ - فَلَمَّا نَزَلُوهَا بَعَثُوا  حَرَامَ بْنَ مِلْحَانَ  بِكِتَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  عَامِرِ بْنِ الطُّفَيْلِ  ، فَلَمَّا أَتَاهُمْ لَمْ يَنْظُرْ فِي كِتَابِهِ إِلَى أَنْ عَدَا عَلَى الرَّجُلِ فَقَتَلَهُ ، ثُمَّ اسْتَصْرَخَ عَلَيْهِمْ  بَنِي عَامِرٍ  فَأَبَوْا أَنْ يُجِيبُوهُ إِلَى مَا دَعَاهُمْ ، وَقَالُوا : لَنْ نُخْفِرَ  أَبَا بَرَاءٍ  ، وَقَدْ عَقَدَ لَهُمْ عَقْدًا وَجِوَارًا ، فَاسْتَصْرَخَ عَلَيْهِمْ قَبَائِلَ  بَنِي سُلَيْمٍ  :  عُصَيَّةَ  ،  وَرِعْلًا  وَذَكْوَانًا  ، فَأَجَابُوهُ إِلَى ذَلِكَ فَخَرَجُوا حَتَّى غَشُوا  الْقَوْمَ  ، فَأَحَاطُوا بِهِمْ فِي رِحَالِهِمْ ، فَلَمَّا رَأَوْهُمْ أَخَذُوا أَسْيَافَهُمْ ثُمَّ قَاتَلُوهُمْ حَتَّى قُتِلُوا عَنْ آخِرِهِمْ ، إِلَّا  كَعْبَ بْنَ زَيْدٍ أَخَا بَنِي دِينَارِ بْنِ النَّجَّارِ  ، فَإِنَّهُمْ تَرَكُوهُ فِيهِ رَمَقٌ ،  فَارْتُثَّ  مِنْ بَيْنِ الْقَتْلَى فَعَاشَ حَتَّى قُتِلَ  يَوْمَ الْخَنْدَقِ  ، فَكَانَ فِي  سَرْحِ  الْقَوْمِ  عَمْرُو بْنُ أُمَيَّةَ الضَّمْرِيُّ  ،  وَرَجُلٌ مِنَ الْأَنْصَارِ  - أَحَدُ  بَنِي عَمْرِو بْنِ عَوْفٍ  - فَلَمْ يُنَبِّئْهُمَا بِمُصَابِ إِخْوَتِهِمَا إِلَّا الطَّيْرُ تَحُومُ عَلَى الْعَسْكَرِ ، فَقَالَ : وَاللهِ إِنَّ لِهَذِهِ الطَّيْرِ لَشَأْنًا ، فَأَقْبَلَا لِيَنْظُرَا فَإِذَا  الْقَوْمُ  فِي دِمَائِهِمْ ، فَإِذَا الْخَيْلُ الَّتِي أَصَابَتْهُمْ وَاقِفَةٌ ، فَقَالَ الْأَنْصَارِيُّ  لِعَمْرِو بْنِ أُمَيَّةَ  : مَا تَرَى ؟ قَالَ : أَرَى أَنْ نَلْحَقَ بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَنُخْبِرَهُ الْخَبَرَ ، فَقَالَ الْأَنْصَارِيُّ : لَكِنِّي مَا كُنْتُ أَرْغَبُ بِنَفْسِي عَنْ مَوْطِنٍ قُتِلَ فِيهِ  الْمُنْذِرُ بْنُ عَمْرٍو  ، وَمَا كُنْتُ لَتُخْبِرَنِي عَنْهُ الرِّجَالُ ، ثُمَّ قَاتَلَ  الْقَوْمَ  حَتَّى قُتِلَ ، وَأَخَذَ  عَمْرُو بْنُ أُمَيَّةَ  أَسِيرًا ، فَلَمَّا أَخْبَرَهُمْ أَنَّهُ مِنْ مُضَرَ أَطْلَقَهُ  عَامِرُ بْنُ         [20/358]      الطُّفَيْلِ  وَجَزَّ نَاصِيَتَهُ ، وَأَعْتَقَهُ عَنْ رَقَبَةٍ زَعَمَ أَنَّهَا كَانَتْ عَلَى أُمِّهِ ، فَخَرَجَ  عَمْرُو بْنُ أُمَيَّةَ  حَتَّى إِذَا كَانَ  بِالْقَرْقَرَةِ  مِنْ صَدْرِ قَنَاةٍ أَقْبَلَ رَجُلَانِ مِنْ  بَنِي عَامِرٍ  حَتَّى نَزَلَا مَعَهُ فِي ظِلٍّ هُوَ فِيهِ ، وَكَانَ  لِلْعَامِرِيِّيِّنَ  عَقْدٌ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَجِوَارٌ ، فَلَمْ يَعْلَمْ بِهِ  عَمْرُو بْنُ أُمَيَّةَ  وَقَدْ سَأَلَهُمَا حِينَ نَزَلَا : مِمَّنْ أَنْتُمَا ؟ قَالَا : مِنْ  بَنِي عَامِرٍ  ، فَأَمْهَلَهُمَا حَتَّى إِذَا نَامَا عَدَا عَلَيْهِمَا فَقَتَلَهُمَا ، وَهُوَ يَرَى أَنَّهُ أَصَابَ بِهِمَا ثَأْرَهُ مِنْ  بَنِي عَامِرٍ  لِمَا أَصَابُوا مِنْ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا قَدِمَ  عَمْرُو بْنُ أُمَيَّةَ  عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَخْبَرَهُ الْخَبَرَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَئِنْ قَتَلْتَ قَتِيلَيْنِ لَأَدِيَنَّهُمَا "" ، ثُمَّ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هَذَا عَمَلُ  أَبِي بَرَاءٍ  ، قَدْ كُنْتُ لَهَا كَارِهًا مُتَخَوِّفًا  فَبَلَغَ ذَلِكَ  أَبَا بَرَاءٍ  فَشَقَّ عَلَيْهِ إِخْفَارُ  عَامِرٍ  إِيَّاهُ ، وَمَا أُصِيبَ مِنْ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَبَبِهِ وَجِوَارِهِ .  وَقَالَ  حَسَّانُ بْنُ ثَابِتٍ  يُحَرِّضُ  بَنِي أَبِي بَرَاءٍ  عَلَى  عَامِرِ بْنِ الطُّفَيْلِ  :  ذَوَائِبِ  فَحَمَلَ  رَبِيعَةُ بْنُ عَامِرٍ  عَلَى  عَامِرِ بْنِ الطُّفَيْلِ  فَطَعَنَهُ بِالرُّمْحِ فَوَقَعَ فِي فَخِذِهِ  وَأَشْوَاهُ  وَوَقَعَ عَنْ فَرَسِهِ ، فَقَالَ : "" هَذَا عَمَلُ  أَبِي بَرَاءٍ  ، إِنْ أَمُتْ فَدَمِي لِعَمِّي ، فَلَا يُتْبَعَنَّ بِهِ ، وَإِنْ أَعِشْ فَسَأَرَى رَأْيِي فِيمَا أَتَى إِلَيَّ  .","","Al-Mu'jam al-Kabir 841","","عبد الله بن أبي بكر بن محمد  ابن حزم عن إسحاق بن يسار المازنى عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن عبد الله بن محمد النفيلي عن أبو شعيب الحراني عن الطبراني","منذر بن عمرو الأنصاري"
"19021","[20/359]      مَنِ اسْمُهُ مَرْوَانُ  مَرْوَانُ بْنُ الْحَكَمِ بْنِ الْعَاصِ بْنِ أُمَيَّةَ بْنِ عَبْدِ شَمْسِ بْنِ عَبْدِ مَنَافٍ  842  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  أَخْبَرَنِي  عُرْوَةُ بْنُ الزُّبَيْرِ ،  عَنِ  الْمِسْوَرِ بْنِ مَخْرَمَةَ ، وَمَرْوَانِ بْنِ الْحَكَمِ قَالَا :  خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابُهُ مِنَ  الْحُدَيْبِيَةِ  فِي  بِضْعِ  عَشَرَةٍ وَمِائَةٍ مِنْ أَصْحَابِهِ  ، حَتَّى إِذَا كَانُوا  بِذِي الْحُلَيْفَةِ  "" قَلَّدَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْهَدْيَ وَأَشْعَرَ ، ثُمَّ أَحْرَمَ بِالْعُمْرَةِ  .","","Al-Mu'jam al-Kabir 842","","المسور بن مخرمة عن عروة بن الزبير عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","مروان بن الحكم بن العاص"
"19022","مَرْوَانُ بْنُ قَيْسٍ الْأَسَدِيُّ  843  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ السَّرَّاجُ ، وَمُحَمَّدُ بْنُ الْحَسَنِ بْنِ مُكْرَمٍ ، قَالَا :  ثَنَا  سَعِيدُ بْنُ يَحْيَى بْنِ سَعِيدٍ الْأُمَوِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عِمْرَانُ بْنُ يَحْيَى الْأَسَدِيُّ  ، قَالَ :  سَمِعْتُ  عَمِّي مَرْوَانَ بْنَ قَيْسٍ - وَقَدْ أَخَذَ الرَّعِيَّةَ عَنْ أَهْلِهِ فِي عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  جَاءَ  رَجُلٌ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّ أَبِي تُوُفِّيَ ، وَقَدْ جَعَلَ عَلَيْهِ أَنْ يَمْشِيَ إِلَى  مَكَّةَ  ، وَأَنْ يَنْحَرَ بَدَنَةً ، وَلَمْ يَتْرُكْ مَالًا ، فَهَلْ يَقْضِي عَنْهُ أَنْ نَمْشِيَ عَنْهُ وَأَنْ نَقْضِيَ عَنْهُ بَدَنَةً مِنْ مَالِي ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  نَعَمِ ، اقْضِ عَنْهُ وَانْحَرْ وَامْشِ ، أَرَأَيْتَ لَوْ كَانَ عَلَى أَبِيكَ دَيْنٌ لِرَجُلٍ فَقَضَيْتَ عَنْهُ مِنْ مَالِكَ  ، أَلَيْسَ يَرْجِعُ الرَّجُلُ رَاضِيًا ؟ وَاللهُ أَحَقُّ أَنَّ يَرْضَى  .         [20/360]      كذا في طبعة مكتبة ابن تيمية ، والصواب : (عمران بن أبي يحيى).","","Al-Mu'jam al-Kabir 843","","مروان بن قيس الأسدي عن عمران بن أبي يحيى عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن محمد بن الحسين بن مكرم البارع عن الطبراني","مروان بن قيس الأسدي"
"19023","مَنِ اسْمُهُ مَرْزُوقٌ  مَرْزُوقٌ الصَّيْقَلُ  844  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَا :  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  مُحَمَّدُ بْنُ حِمْيَرَ ،  حَدَّثَنِي  أَبُو الْحَكَمِ الصَّيْقَلُ ،  حَدَّثَنِي  مَرْزُوقٌ الصَّيْقَلُ ،  أَنَّهُ "" صَقَلَ سَيْفَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَا  الْفَقَارِ  ،  وَكَانَتْ لَهُ  قَبِيعَةٌ  مِنْ فِضَّةٍ وَحِلَقٌ فِي قَيْدِهِ وَبَكْرَةٌ فِي وَسَطِهِ مِنْ فِضَّةٍ  .","","Al-Mu'jam al-Kabir 844","","مرزوق الصيقل عن أبو الحكم الصيقل عن محمد بن حمير القضاعي عن هشام بن عمار عن الحسين بن إسحاق التستري عن الطبراني","مرزوق الصيقل"
"19024","مَنِ اسْمُهُ مُنْكَدِرٌ  مُنْكَدِرٌ أَبُو مُحَمَّدٍ التَّيْمِيُّ  ،  تَيْمُ قُرَيْشٍ  845  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  حُرَيْثُ بْنُ السَّائِبِ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُنْكَدِرِ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ طَافَ حَوْلَ  الْبَيْتِ  أُسْبُوعًا  لَا يَلْغُو فِيهِ كَانَ  كَعَدْلِ  رَقَبَةٍ  يُعْتِقُهَا  .","","Al-Mu'jam al-Kabir 845","","المنكدر بن عبد الله بن الهدير القرشي عن محمد بن المنكدر عن حريث بن السائب الأسيدي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","منكدر أبو محمد التيمي"
"19025","846  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ الْأَصْبَهَانِيُّ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْمِهْرِقَانِيُّ ،  ثَنَا  الْقَاسِمُ بْنُ الْحَكَمِ الْعُرَنِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَمْرِو بْنِ مُرَّةَ الْجَمَلِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سُوقَةَ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  أَبِيهِ  ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ         [20/361]      وَسَلَّمَ أَنَّهُ خَرَجَ ذَاتَ لَيْلَةٍ وَقَدْ أَخَّرَ صَلَاةَ الْعِشَاءِ حَتَّى ذَهَبَ مِنَ اللَّيْلِ  هُنَيْهَةٌ أَوْ سَاعَةٌ  ، وَالنَّاسُ يَنْتَظِرُونَ فِي الْمَسْجِدِ ، فَقَالَ : "" مَا تَنْتَظِرُونَ ؟ "" قَالُوا : نَنْتَظِرُ الصَّلَاةَ ، قَالَ : "" أَمَا إِنَّكُمْ فِي صَلَاةٍ مَا انْتَظَرْتُمُوهَا "" ، ثُمَّ قَالَ : "" أَمَا إِنَّهَا صَلَاةٌ لَمْ يُصَلِّهَا أَحَدٌ مِمَّنْ كَانَ قَبْلَكُمْ مِنَ الْأُمَمِ "" . ثُمَّ رَفَعَ رَأْسَهُ إِلَى السَّمَاءِ فَقَالَ :  النُّجُومُ أَمَانُ السَّمَاءِ ، فَإِنْ طُمِسَتِ النُّجُومُ أَتَى السَّمَاءَ مَا يُوعَدُونَ  ، وَأَنَا أَمَانُ أَصْحَابِي فَإِذَا قُبِضْتُ أَتَى أَصْحَابِي مَا يُوعَدُونَ ، وَأَصْحَابِي أَمَانُ أُمَّتِي ، فَإِذَا قُبِضَ أَصْحَابِي أَتَى أُمَّتِي مَا يُوعَدُونَ ، يَا  بِلَالُ  أَقِمْ  .","","Al-Mu'jam al-Kabir 846","","المنكدر بن عبد الله بن الهدير القرشي عن محمد بن المنكدر عن محمد بن سوقة الغنوي عن عبد الله بن عمرو بن مرة الجملي عن القاسم بن الحكم بن كثير عن حفص بن عمر المهرقاني عن محمد بن شعيب التاجر عن الطبراني","منكدر أبو محمد التيمي"
"19026","مَنِ اسْمُهُ مَثْعَبٌ  مَثْعَبٌ  غَيْرُ مَنْسُوبٍ  847  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  عُبَيْدُ بْنُ يَعِيشَ ،  ثَنَا  يَحْيَى بْنُ يَعْلَى ،  عَنْ  أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ ،  عَنْ  مَثْعَبٍ قَالَ :  كَانَ غَزْوٌ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَلَمْ يَكُنْ أَحَدٌ مِنْهُمْ إِلَّا وَلَهُ رَاحِلَتُهُ  يَعْتَقِبُ  عَلَيْهَا غَيْرِي ، قَالَ : فَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَنْزِلُ ثُمَّ يَقُولُ لِي : "" ارْكَبْ "" ، فَأَقُولُ : إِنَّ بِي قُوَّةً ، حَتَّى يَفْعَلَ ذَلِكَ مَرَّتَيْنِ أَوْ ثَلَاثًا ، فَيَقُولُ :  مَا أَنْتَ إِلَّا  مَثْعَبٌ  "" قَالَ : "" فَكَانَ مِنْ أَحَبِّ أَسْمَائِي إِلَيَّ  . قَالَ : فَكُنْتُ "" أُسَافِرُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابِهِ فَيَصُومُ بَعْضُهُمْ وَيُفْطِرُ بَعْضُهُمْ ، فَلَمْ يَعِبِ الصَّائِمُ عَلَى الْمُفْطِرِ ، وَلَا الْمُفْطِرُ عَلَى الصَّائِمِ  .         [20/362]","","Al-Mu'jam al-Kabir 847","","مثعب السلمي عن أشعث بن أبي الشعثاء عن يحيى بن يعلى بن الحارث المحاربي عن عبيد بن يعيش عن محمد بن عثمان بن أبي شيبة عن الطبراني","مثعب غير منسوب"
"19027","مَنِ اسْمُهُ مُصْعَبٌ  مُصْعَبُ بْنُ عُمَيْرٍ الْقُرَشِيُّ ثُمَّ الْعَدَوِيُّ ، وَهُوَ مُصْعَبُ بْنُ عُمَيْرِ بْنِ هَاشِمِ بْنِ عَبْدِ مَنَافِ بْنِ عَبْدِ الدَّارِ بْنِ قُصَيٍّ  ، مِنَ  الْمُهَاجِرِينَ  الْأُوَلِ ، اسْتُشْهِدَ  يَوْمَ أُحُدٍ  مِنْ أَخْبَارِهِ  848  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْبَرَاءِ ، قَالَ :  وَكَانَ أَوَّلَ مَنْ قَدِمَ عَلَيْنَا مِنَ الْمُهَاجِرِينَ  مُصْعَبُ بْنُ عُمَيْرٍ  - أَحَدُ  بَنِي عَبْدِ الدَّارِ بْنِ قُصَيٍّ  - فَقُلْتُ لَهُ : مَا فَعَلَ رَسُولُ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : "" هُوَ مَكَانَهُ ، وَأَصْحَابُهُ عَلَى أَثَرِي  .","","Al-Mu'jam al-Kabir 848","","مصعب بن عمير بن هاشم العبدري عن البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","من أخباره"
"19028","849  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ قَالَ :  فَلَمَّا حَضَرَ الْمَوْسِمُ حَجَّ نَفَرٌ مِنَ  الْأَنْصَارِ  مِنْ  بَنِي مَالِكِ بْنِ النَّجَّارِ  مِنْهُمْ :  مُعَاذُ بْنُ عَفْرَاءَ  ،  وَأَسْعَدُ بْنُ زُرَارَةَ  ، وَمِنْ  بَنِي زُرَيْقٍ  :  رَافِعُ بْنُ مَالِكٍ  ،  وَذَكْوَانُ بْنُ عَبْدِ قَيْسٍ  ، وَمِنْ  بَنِي عَبْدِ الْأَشْهَلِ  :  أَبُو الْهَيْثَمِ بْنُ التَّيِّهَانِ  ، وَمِنْ  بَنِي عَمْرِو بْنِ عَوْفٍ  :  عُوَيْمُ بْنُ سَاعِدَةَ  ، فَأَتَاهُمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" فَأَخْبَرَهُمْ خَبَرَهُ الَّذِي اصْطَفَاهُ اللهُ مِنْ نُبُوَّتِهِ وَكَرَامَتِهِ ، وَقَرَأَ عَلَيْهِمُ الْقُرْآنَ ، فَلَمَّا سَمِعُوا قَوْلَهُ  أَنْصَتُوا  ، وَاطْمَأَنَّتْ أَنْفُسُهُمْ إِلَى دَعْوَتِهِ ، وَعَرَفُوا مَا كَانُوا يَسْمَعُونَ مِنْ أَهْلِ الْكِتَابِ مِنْ ذِكْرِهِمْ         [20/363]      إِيَّاهُ بِصِفَتِهِ ، وَمَا يَدْعُوهُمْ إِلَيْهِ ، فَصَدَّقُوهُ وَآمَنُوا بِهِ وَكَانُوا مِنْ أَسْبَابِ الْخَيْرِ "" . ثُمَّ قَالُوا لَهُ : قَدْ عَلِمْتَ الَّذِي بَيْنَ  الْأَوْسِ  وَالْخَزْرَجِ  مِنَ الدِّمَاءِ ، وَنَحْنُ نُحِبُّ مَا أَرْشَدَ اللهُ بِهِ أَمْرَكَ ، وَنَحْنُ لِلهِ وَلَكَ مُجْتَهِدُونَ ، وَإِنَّا نُشِيرُ عَلَيْكَ بِمَا تَرَى ، فَامْكُثْ عَلَى اسْمِ اللهِ حَتَّى نَرْجِعَ إِلَى قَوْمِنَا فَنُخْبِرَهُمْ بِشَأْنِكَ ، وَنَدْعُوَهُمْ إِلَى اللهِ وَرَسُولِهِ ، فَلَعَلَّ اللهَ يُصْلِحُ بَيْنَنَا وَيَجْمَعُ أَمْرَنَا ، فَإِنَّا الْيَوْمَ مُتَبَاعِدُونَ مُتَبَاغِضُونَ ، وَإِنْ تَقْدَمْ عَلَيْنَا الْيَوْمَ وَلَمْ نَصْطَلِحْ لَمْ يَكُنْ لَنَا جَمَاعَةٌ عَلَيْكَ ، وَلَكِنْ نُوَاعِدُكَ الْمَوْسِمَ مِنَ الْعَامِ الْمُقْبِلِ ، فَرَضِيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الَّذِي قَالُوا ، فَرَجَعُوا إِلَى قَوْمِهِمْ فَدَعَوْهُمْ سِرًّا وَأَخْبَرُوهُمْ بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَالَّذِي بَعَثَهُ اللهُ بِهِ ، وَدَعَا إِلَيْهِ بِالْقُرْآنِ حَتَّى قَلَّ دَارٌ مِنْ  دُورِ  الْأَنْصَارِ  إِلَّا أَسْلَمَ فِيهَا نَاسٌ - لَا مَحَالَةَ - ثُمَّ بَعَثُوا إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَنِ ابْعَثْ إِلَيْنَا رَجُلًا مِنْ قِبَلِكَ فَيَدْعُو النَّاسَ بِكِتَابِ اللهِ فَإِنَّهُ أَدْنَى أَنْ يُتَّبَعَ ، "" فَبَعَثَ إِلَيْهِمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مُصْعَبَ بْنَ عُمَيْرٍ  أَخَا  بَنِي عَبْدِ الدَّارِ ،  فَنَزَلَ فِي  بَنِي غَنْمٍ  عَلَى  أَسْعَدَ بْنِ زُرَارَةَ ،  فَجَعَلَ يَدْعُو النَّاسَ سِرًّا ، وَيَفْشُو الْإِسْلَامُ ، وَيَكْثُرُ أَهْلُهُ ، وَهُمْ فِي ذَلِكَ مُسْتَخْفُونَ بِدُعَائِهِمْ ، ثُمَّ إِنَّ  أَسْعَدَ بْنَ زُرَارَةَ  أَقْبَلَ هُوَ  وَمُصْعَبُ بْنُ عُمَيْرٍ  حَتَّى أَتَيَا  بِئْرَ مُرِّيٍّ  - أَوْ قَرِيبًا مِنْهَا  - فَجَلَسْنَا هُنَالِكَ وَبَعَثَا إِلَى رَهْطٍ مِنْ أَهْلِ الْأَرْضِ فَأَتَوْهُمْ مُسْتَخْفِينَ ، فَبَيْنَمَا  مُصْعَبُ بْنُ عُمَيْرٍ  يُحَدِّثُهُمْ وَيَقُصُّ عَلَيْهِمُ الْقُرْآنَ أُخْبِرَ بِهِمْ  سَعْدُ بْنُ مُعَاذٍ  ، فَأَتَاهُمْ فِي لِأْمَتِهِ مَعَهُ الرُّمْحُ حَتَّى وَقَفَ عَلَيْهِمْ فَقَالَ : عَلَامَ يَأْتِينَا فِي دُورِنَا بِهَذَا الْوَحِيدِ الْفَرِيدِ الطَّرِيحِ الْغَرِيبِ يُسَفِّهُ ضُعَفَاءَنَا بِالْبَاطِلِ ، وَيَدْعُوهُمْ إِلَيْهِ ؟ لَا أَرَاكُمْ بَعْدَهَا بِشَيْءٍ مِنْ جِوَارِنَا ، فَرَجَعُوا ثُمَّ إِنَّهُمْ عَادُوا الثَّانِيَةَ  بِبِئْرِ مُرِّيٍ  - أَوْ قَرِيبًا مِنْهَا  - فَأُخْبِرَ بِهِمْ  سَعْدُ بْنُ مُعَاذٍ  الثَّانِيَةَ فَوَاعَدَهُمْ بِوَعِيدٍ دُونَ الْوَعِيدِ الْأَوَّلِ ، فَلَمَّا رَأَى  أَسْعَدُ  مِنْهُ         [20/364]      ليِنًا قَالَ : يَا ابْنَ خَالَةٍ اسْمَعْ مِنْ قَوْلِهِ ، فَإِنْ سَمِعْتَ مُنْكَرًا ، فَارْدُدْهُ يَا هَذَا مِنْهُ ، وَإِنْ سَمِعْتَ خَيْرًا فَأَجِبْ إِلَيْهِ ، فَقَالَ : مَاذَا يَقُولُ ؟ فَقَرَأَ عَلَيْهِمْ  مُصْعَبُ بْنُ عُمَيْرٍ  :         {      حم             *          وَالْكِتَابِ الْمُبِينِ             *          إِنَّا جَعَلْنَاهُ قُرْآنًا عَرَبِيًّا لَعَلَّكُمْ تَعْقِلُونَ         }      ، فَقَالَ  سَعْدُ بْنُ مُعَاذٍ  : مَا أَسْمَعُ إِلَّا مَا أَعْرِفُ ، فَرَجَعَ وَقَدْ هَدَاهُ اللهُ ، وَلَمْ يُظْهِرْ لَهُمُ الْإِسْلَامَ حَتَّى رَجَعَ إِلَى قَوْمِهِ ، فَدَعَا  بَنِي عَبْدِ الْأَشْهَلِ  إِلَى الْإِسْلَامِ ، وَأَظْهَرَ إِسْلَامَهُ ، وَقَالَ : مَنْ شَكَّ فِيهِ مِنْ صَغِيرٍ أَوْ كَبِيرٍ أَوْ ذَكَرٍ أَوْ أُنْثَى فَلْيَأْتِنَا بِأَهْدَى مِنْهُ نَأْخُذْ بِهِ ، فَوَاللهِ لَقَدْ جَاءَ أَمْرٌ لَتُحَزَّنَّ فِيهِ الرِّقَابُ ، فَأَسْلَمَتْ  بَنُو عَبْدِ الْأَشْهَلِ  عِنْدَ إِسْلَامِ  سَعْدٍ  وَدُعَائِهِ - إِلَّا مَنْ لَا يُذْكَرُ - فَكَانَتْ أَوَّلَ  دُورٍ  مِنْ  دُورِ  الْأَنْصَارِ  أَسْلَمَتْ  بِأَسْرِهَا  ، ثُمَّ إِنَّ  بَنِي النَّجَّارِ  أَخْرَجُوا  مُصْعَبَ بْنَ عُمَيْرٍ  وَاشْتَدُّوا عَلَى  أَسْعَدَ بْنِ زُرَارَةَ  فَانْتَقَلَ  مُصْعَبُ بْنُ عُمَيْرٍ  إِلَى  سَعْدِ بْنِ مُعَاذٍ  ، فَلَمْ يَزَلْ عِنْدَهُ يَدْعُو وَيَهْدِي اللهُ عَلَى يَدَيْهِ ، حَتَّى قَلَّ دَارٌ مِنْ  دُورِ  الْأَنْصَارِ  إِلَّا أَسْلَمَ فِيهَا نَاسٌ - لَا مَحَالَةَ - وَأَسْلَمَ أَشْرَافُهُمْ وَأَسْلَمَ  عَمْرُو بْنُ الْجَمُوحِ  ، وَكُسِرَتَ أَصْنَامُهُمْ ، فَكَانَ الْمُسْلِمُونَ أَعَزَّ أَهْلِهَا ، وَصَلُحَ أَمْرُهُمْ وَرَجَعَ  مُصْعَبُ بْنُ عُمَيْرٍ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَكَانَ يُدْعَى  الْمُقْرِئَ  .","","Al-Mu'jam al-Kabir 849","","عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","من أخباره"
"19029","850  -  حَدَّثَنَا  عَمْرُو بْنُ حَفْصٍ السَّدُوسِيُّ ،  ثَنَا  أَبُو بِلَالٍ الْأَشْعَرِيُّ ،  ثَنَا  يَحْيَى بْنُ الْعَلَاءِ ،  عَنْ  عَبْدِ الْأَعْلَى بْنِ عَبْدِ اللهِ بْنِ أَبِي فَرْوَةَ ،  عَنْ  فُطِنِ بْنِ وَهْبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَيْرٍ  قَالَ :  مَرَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى  مُصْعَبِ بْنِ عُمَيْرٍ  حِينَ رَجَعَ مِنْ  أُحُدٍ  ، فَوَقَفَ عَلَيْهِ وَعَلَى أَصْحَابِهِ فَقَالَ :  أَشْهَدُ أَنَّكُمْ أَحْيَاءُ عِنْدَ اللهِ فَرُدُّوهُمْ وَصَلُّوا عَلَيْهِمْ ،  فَوَالَّذِي نَفْسُ  مُحَمَّدٍ  بِيَدِهِ لَا يُسَلِّمُ عَلَيْهِمْ إِلَّا رَدُّوا عَلَيْهِ إِلَى يَوْمِ الْقِيَامَةِ  .         [20/365]      كذا في طبعة مكتبة ابن تيمية ، ولعل الصواب: (عبيد بن عمير) .","","Al-Mu'jam al-Kabir 850","","عبيد بن عمير بن قتادة الجندعي عن قطن بن وهب الخزاعي عن عبد الأعلى بن عبد الله بن أبي فروة الأموي عن يحيى بن العلاء الفوراردي عن أبو بلال الأشعري عن عمر بن حفص السدوسي عن الطبراني","من أخباره"
"19030","مُصْعَبٌ الْأَسْلَمِيُّ  851  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  سَمِعْتُ  عَبْدَ الْمَلِكِ بْنَ عُمَيْرٍ  يُحَدِّثُ ، عَنْ  مُصْعَبٍ الْأَسْلَمِيِّ قَالَ :  انْطَلَقَ  غُلَامٌ  مِنَّا فَأَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنِّي سَائِلُكَ سُؤَالًا ، قَالَ : "" وَمَا هُوَ ؟ "" قَالَ : أَسْأَلُكَ أَنْ تَجْعَلَنِي مِمَّنْ تَشْفَعُ لَهُ يَوْمَ الْقِيَامَةِ ، قَالَ : ""  مَنْ أَمَرَكَ بِهَا - أَوْ مَنْ عَلَّمَكَ بِهَذَا ؟ - أَوْ مَنْ دَلَّكَ عَلَى هَذَا  - ؟ "" قَالَ : مَا أَمَرَنِي بِهَذَا أَحَدٌ إِلَّا نَفْسِي ، قَالَ :  فَإِنَّكَ مِمَّنْ أَشْفَعُ لَهُ يَوْمَ الْقِيَامَةِ  ، فَذَهَبَ الْغُلَامُ جَذْلَانَ لِيُخْبِرَ أَهْلَهُ ، فَلَمَّا وَلَّى قَالَ : "" رُدُّوا عَلَيَّ الْغُلَامَ "" . فَرَدُّوهُ كَئِيبًا مَخَافَةَ أَنْ يَكُونَ قَدْ حَدَثَ فِيهِ شَيْءٌ قَالَ : "" أَعِنِّي عَلَى نَفْسِكَ بِكَثْرَةِ السُّجُودِ  .","","Al-Mu'jam al-Kabir 851","","مصعب الأسلمي عن عبد الملك بن عمير القبطي عن جرير بن حازم عن شيبان بن فروخ الحبطي عن عبد الله بن أحمد الجواليقي عن الطبراني","مصعب الأسلمي"
"19031","مَنِ اسْمُهُ مَعْدَانُ  مَعْدَانُ أَبُو خَالِدٍ  يُقَالُ لَهُ صُحْبَةٌ  852  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ شُعَيْبٍ الرِّحَابِيُّ  ،  ثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ الْبَحْرَانِيُّ ،  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  ابْنُ جُرَيْجٍ ،  عَنْ  زِيَادٍ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ  رَفِيقٌ  يُحِبُّ  الرِّفْقَ  ، وَيَرْضَاهُ وَيُعِينُ عَلَيْهِ مَا لَا يُعِينُ عَلَى  الْعُنْفِ  ، فَإِذَا رَكِبْتُمْ هَذِهِ الدَّوَابَّ الْعُجْمَ ، فَنَزِّلُوهَا مَنَازِلَهَا ، فَإِنْ  أَجْدَبَتِ  الْأَرْضُ فَانْجُوا عَلَيْهَا ، فَإِنَّ الْأَرْضَ  تُطْوَى  بِاللَّيْلِ مَا لَا  تُطْوَى  بِالنَّهَارِ ، وَإِيَّاكُمْ وَالتَّعْرِيسَ بِالطَّرِيقِ ، فَإِنَّهُ طَرِيقُ الدَّوَابِّ وَمَأْوَى الْحَيَّاتِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( الرجاني).","","Al-Mu'jam al-Kabir 852","","معدان الكلاعي عن خالد بن معدان عن زياد بن سعد الخراساني عن ابن جريج عن روح بن عبادة القيسي عن محمد بن معمر بن ربعي البحراني عن عبد الله بن محمد بن شعيب الرجاني عن الطبراني","معدان أبو خالد"
"19032","[20/366]      مَنِ اسْمُهُ مَخْلَدٌ  مَخْلَدٌ الْغِفَارِيُّ  853  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْخَلَّالِ الْمَكِّيُّ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  الْحَسَنِ بْنِ مُحَمَّدٍ ،  عَنْ  مَخْلَدٍ الْغِفَارِيِّ ،  أَنَّ ثَلَاثَةَ أَعْبُدٍ  لِبَنِي غِفَارٍ  شَهِدُوا مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بَدْرًا  ، فَكَانَ  عُمَرُ  يُعْطِيهِمْ أَلْفًا لِكُلِّ رَجُلٍ  .","","Al-Mu'jam al-Kabir 853","","مخلد بن خفاف بن أيماء الغفاري عن الحسن بن محمد بن علي بن أبي طالب عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","مخلد الغفاري"
"19033","مَنِ اسْمُهُ الْمُغِيرَةُ  مُغِيرَةُ أَبُو سُفْيَانَ بْنُ الْحَارِثِ بْنِ عَبْدِ الْمُطَّلِبِ بْنِ هَاشِمِ بْنِ عَبْدِ مَنَافٍ  أَسْلَمَ يَوْمَ الْفَتْحِ ، لَقِيَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الطَّرِيقِ فَكَانَ مِمَّنْ ثَبَتَ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ حُنَيْنٍ  .  تُوُفِّيَ سَنَةَ عِشْرِينَ  854  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْأَحْمَرِ النَّاقِدُ الْبَصْرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقُطَعِيُّ ،  ثَنَا  وَهْبُ بْنُ جَرِيرِ بْنِ حَازِمٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  كَثِيرِ بْنِ الْعَبَّاسِ ،  عَنْ  أَبِيهِ  ، قَالَ :  الْتَفَتَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  أَبِي سُفْيَانَ بْنِ الْحَارِثِ  يَوْمَ حُنَيْنٍ  فَقَالَ :  مَنْ أَنْتَ ؟ "" فَقَالَ : ابْنُ أُمِّكَ ، فَقَالَ لَهُ خَيْرًا  .","","Al-Mu'jam al-Kabir 854","","العباس بن عبد المطلب عم رسول الله عن كثير بن العباس بن عبد المطلب بن هاشم عن الزهري عن محمد بن إسحاق عن جرير بن حازم عن وهب بن جرير بن حازم عن محمد بن يحيى بن أبي حزم القطعي عن غلام طالوت محمد بن علي بن الحسن عن الطبراني","مغيرة أبو سفيان بن الحارث بن عبد المطلب"
"19034","مُغِيرَةُ بْنُ شُعْبَةَ الثَّقَفِيُّ  855  - حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحِيمِ الْبَرْقِيُّ  ، ثَنَا  عَبْدُ الْمَلِكِ بْنُ هِشَامٍ  ، عَنْ  أَبِي عُبَيْدَةَ  ، قَالَ : ""  الْمُغِيرَةُ بْنُ شُعْبَةَ بْنِ أَبِي عَامِرِ بْنِ         [20/367]      مَسْعُودِ بْنِ مُعَتِّبِ بْنِ مَالِكِ بْنِ كَعْبِ بْنِ عَمْرِو بْنِ مَعْدِ بْنِ عَوْفِ بْنِ قَيْسِ بْنِ مُنَبِّهٍ يُكَنَّى أَبَا عَبْدِ اللهِ  ، أُمُّهُ امْرَأَةٌ مِنْ  بَنِي نَصْرِ بْنِ مُعَاوِيَةَ  ، وَلِيَ  الْبَصْرَةَ  نَحْوًا مِنْ سَنَتَيْنِ ، ثُمَّ وَلِيَ  الْكُوفَةَ  وَمَاتَ بِهَا سَنَةَ خَمْسِينَ . أَوَّلُ مَشَاهِدِهِ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْحُدَيْبِيَةُ  "" .","","Al-Mu'jam al-Kabir 855","","","مغيرة بن شعبة الثقفي"
"19035","856  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  قَالَ : ""  تُوُفِّيَ  الْمُغِيرَةُ  سَنَةَ خَمْسِينَ  ""  .","","Al-Mu'jam al-Kabir 856","","","مغيرة بن شعبة الثقفي"
"19036","857  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ شَبِيبٍ الْعَسَّالُ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  حِبَّانُ بْنُ عَلِيٍّ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ قَالَ :  بَعَثَ عُمَرُ بْنُ الْخَطَّابِ أَوَّلَ مَا بَعَثَ إِلَى  الْكُوفَةِ  أَبَا عُبَيْدٍ الثَّقَفِيَّ  -  أَبَا الْمُخْتَارِ  - فَقُتِلَ  ، فَبَعَثَ  سَعْدَ بْنَ أَبِي وَقَّاصٍ  فَمَكَثَ خَمْسَ سِنِينَ ثُمَّ نَزَعَهُ ، ثُمَّ بَعَثَ  عَمَّارَ بْنَ يَاسِرٍ  فَمَكَثَ سَنَةً ، ثُمَّ نَزَعَهُ ، وَبَعَثَ  الْمُغِيرَةَ بْنَ شُعْبَةَ  فَمَكَثَ سَنَةً ، ثُمَّ قُتِلَ  عُمَرُ  ، فَلَمَّا وُلِّيَ عُثْمَانُ بَعَثَ  سَعْدًا  إِلَى  الْكُوفَةِ  فَمَكَثَ سَنَةً ثُمَّ نَزَعَهُ ، وَبَعَثَ  الْوَلِيدَ بْنَ عُقْبَةَ  فَمَكَثَ خَمْسَ سِنِينَ ، ثُمَّ نَزَعَهُ ، وَبَعَثَ  سَعِيدَ بْنَ الْعَاصِ  فَمَكَثَ خَمْسَ سِنِينَ ثُمَّ نَزَعَهُ ، وَبَعَثَ  أَبَا مُوسَى الْأَشْعَرِيَّ  فَمَكَثَ سَنَةً ، ثُمَّ قُتِلَ  عُثْمَانُ  رَضِيَ اللهُ عَنْهُ وَكَانَتِ الْفِتْنَةُ ، ثُمَّ كَانَ أَوَّلَ مَنْ أَمَّرَهُ مُعَاوِيَةُ عَلَى  الْكُوفَةِ  الْمُغِيرَةُ بْنُ شُعْبَةَ  تِسْعَ سِنِينَ ثُمَّ مَاتَ ، ثُمَّ بَعَثَ  زِيَادَ بْنَ أَبِيهِ  فَمَكَثَ أَرْبَعَ سِنِينَ ثُمَّ مَاتَ ، فَبَعَثَ  الضَّحَّاكَ بْنَ قَيْسٍ  فَمَكَثَ ثَلَاثَ سِنِينَ ثُمَّ نَزَعَهُ ، ثُمَّ بَعَثَ  النُّعْمَانَ بْنَ بَشِيرٍ  فَمَكَثَ أَرْبَعَةَ أَشْهُرٍ ثُمَّ هَلَكَ  مُعَاوِيَةُ  وَكَانَتِ الْفِتْنَةُ ، ثُمَّ كَانَ أَمَرُ  مُسْلِمِ بْنِ عَقِيلٍ  وَأَصْحَابِهِ  ""  .","","Al-Mu'jam al-Kabir 857","","معاوية بن أبي سفيان عن الشعبي عن مجالد بن سعيد عن حبان بن علي العنزي عن إسماعيل بن عمرو البجلي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","مغيرة بن شعبة الثقفي"
"19037","[20/368]      مَا  أَسْنَدَ  الْمُغِيرَةُ بْنُ شُعْبَةَ  أَبُو أُمَامَةَ الْبَاهِلِيُّ  ، عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  858  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ زَحْرٍ ،  عَنْ  عَلِيِّ بْنِ يَزِيدَ ،  عَنِ  الْقَاسِمِ ،  عَنْ  أَبِي أُمَامَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  عَرَضَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِحَاجَتِهِ ، وَعَرَضْتُ مَعَهُ  بِإِدَاوَةِ  مَاءٍ  ، وَعَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جُبَّةٌ شَامِيَّةٌ ، فَلَمَّا أَنْ قَضَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَاجَتَهُ ، تَوَضَّأَ وَمَسَحَ عَلَى الْخُفَّيْنِ  .","","Al-Mu'jam al-Kabir 858","","المغيرة بن شعبة عن أبو أمامة الباهلي عن القاسم بن عبد الرحمن الدمشقي عن علي بن يزيد الألهاني عن عبيد الله بن زحر الضمري عن يحيى بن أيوب الغافقي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","أبو أمامة الباهلي عن المغيرة بن شعبة"
"19038","859  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  أَبُو الْمُغِيرَةِ ،  ثَنَا  مُعَانُ بْنُ رِفَاعَةَ ،  عَنْ  عَلِيِّ بْنِ يَزِيدَ ،  عَنِ  الْقَاسِمِ ،  عَنْ  أَبِي أُمَامَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ قَالَ فِي جِلْدِ الْمَيْتَةِ :  دِبَاغُهُ طُهُورُهُ  .","","Al-Mu'jam al-Kabir 859","","المغيرة بن شعبة عن أبو أمامة الباهلي عن القاسم بن عبد الرحمن الدمشقي عن علي بن يزيد الألهاني عن معان بن رفاعة السلامي عن عبد القدوس بن الحجاج عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","أبو أمامة الباهلي عن المغيرة بن شعبة"
"19039","الْمِسْوَرُ بْنُ مَخْرَمَةَ  ، عَنِ  الْمُغِيرَةِ  860  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمِسْوَرِ بْنِ مَخْرَمَةَ ،  أَنَّ  عُمَرَ  اسْتَشَارَ النَّاسَ فِي  إِمْلَاصِ  الْمَرْأَةِ ، فَقَالَ الْمُغِيرَةُ بْنُ شُعْبَةَ :  شَهِدْتُ رَسُولَ اللهِ صَلَّى اللهُ         [20/369]      عَلَيْهِ وَسَلَّمَ قَضَى  بِغُرَّةٍ  : عَبْدٍ أَوْ أَمَةٍ  . فَقَالَ : أَتَأْتِينِي بِمَنْ يَشْهَدُ مَعَكَ ؟ فَشَهِدَ لَهُ مُحَمَّدُ بْنُ مَسْلَمَةَ  .","","Al-Mu'jam al-Kabir 860","","محمد بن مسلمة بن سلمة الخزرجي عن المسور بن مخرمة عن عروة بن الزبير عن هشام بن عروة بن الزبير عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","المسور بن مخرمة عن المغيرة"
"19040","قُرَّةُ بْنُ إِيَاسٍ الْمُزَنِيُّ  ، عَنِ  الْمُغِيرَةِ  861  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ الْجُذُوعِيُّ الْقَاضِي ، وَدَاوُدُ بْنُ مُحَمَّدِ بْنِ صَالِحٍ الْمَرْوَزِيُّ ، وَجَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ قَالُوا :  ثَنَا  أُمَيَّةُ بْنُ بِسْطَامٍ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  حَجَّاجٌ الصَّوَّافُ ،  حَدَّثَنِي  أَبُو إِيَاسٍ مُعَاوِيَةُ بْنُ قُرَّةَ ،  عَنْ  أَبِيهِ قُرَّةَ  قَالَ :  لَمَّا كَانَ  أَيَّامُ الْقَادِسِيَّةِ  بَعَثَ الْمُغِيرَةُ بْنُ شُعْبَةَ إِلَى صَاحِبِ فَارِسٍ فَقَالَ : ابْعَثُوا مَعِي عَشَرَةً  ، قَالَ : فَشَدَّ عَلَيْهِ ثِيَابَهُ وَأَخَذَ مَعَهُ جُحْفَةً ، ثُمَّ انْطَلَقَ حَتَّى أَتَوْهُ ، فَقَالَ لِلْقَوْمِ : أَلْقُوا إِلَيَّ  بُرْنُسًا  فَجَلَسَ عَلَيْهِ ، فَقَالَ الْعِلْجُ : إِنَّكُمْ مَعَاشِرَ الْعَرَبِ قَدْ عَرَفْتُ الَّذِي حَمَلَكُمْ عَلَى الْجِيئَةِ إِلَيْنَا ، أَنْتُمْ قَوْمٌ لَا تَجِدُونَ فِي بِلَادِكُمْ مِنَ الطَّعَامِ مَا تَشْبَعُونَ مِنْهُ ، فَخُذُوا نُعْطِكُمْ مِنَ الطَّعَامِ حَاجَتَكُمْ ، فَإِنَّا قَوْمٌ مَجُوسٌ ، وَإِنَّا نَكْرَهُ قَتْلَكُمْ ، إِنَّكُمْ تَتَحَسُّونَ عَلَيْنَا أَرْضَنَا ، فَقَالَ  الْمُغِيرَةُ  : وَاللهِ مَا ذَاكَ جَاءَ بِنَا ، وَلَكِنَّا كُنَّا قَوْمًا نَعْبُدُ الْحِجَارَةَ وَالْأَوْثَانَ ، فَإِذَا رَأَيْنَا حَجَرًا أَحْسَنَ مِنْ حَجَرٍ أَلْقَيْنَاهُ وَأَخَذْنَا غَيْرَهُ ، وَلَا نَعْرِفُ رَبًّا حَتَّى بَعَثَ اللهُ إِلَيْنَا رَسُولًا مِنْ أَنْفُسِنَا فَدَعَانَا إِلَى الْإِسْلَامِ فَاتَّبَعْنَاهُ ، وَأَمَرَنَا بِقِتَالِ عَدُوِّنَا مِمَّنْ تَرَكَ الْإِسْلَامَ ، وَلَمْ نَجِئْ لِلطَّعَامِ وَلَكِنْ جِئْنَا نَقْتُلُ مُقَاتِلَتَكُمْ وَنَسْبِي ذَرَارِيَّكُمْ ، فَأَمَّا مَا ذَكَرْتَ مِنَ الطَّعَامِ ، فَإِنَّا كُنَّا لَعَمْرِي لَا نَجِدُ مِنَ الطَّعَامِ مَا نَشْبَعُ بِهِ ، وَرُبَّمَا لَمْ نَجِدْ رِيًّا مِنَ الْمَاءِ أَحْيَانًا ، فَجِئْنَا إِلَى أَرْضِكُمْ هَذِهِ فَوَجَدْنَا فِيهَا طَعَامًا كَثِيرًا ، فَلَا وَاللهِ لَا نَبْرَحُهَا حَتَّى تَكُونَ لَنَا أَوْ لَكُمْ ،         [20/370]      قَالَ الْعِلْجُ بِالْفَارِسِيَّةِ : صَدَقَ ، وَأَنْتَ  تُفْقَأُ  عَيْنُكَ غَدًا  بِالْقَادِسِيَّةِ  ،  فَفُقِئَتْ  عَيْنُهُ مِنَ الْغَدِ ، أَصَابَتْهُ نُشَّابَةٌ  .","","Al-Mu'jam al-Kabir 861","","المغيرة بن شعبة عن قرة بن إياس بن هلال المزني عن معاوية بن قرة عن حجاج بن أبى عثمان الصواف الكندي عن يزيد بن زريع العيشي عن أمية بن بسطام عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","قرة بن إياس المزني عن المغيرة"
"19041","أَبُو فِرَاسٍ الْأَسْلَمِيُّ  ، عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  862  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  عَلِيُّ بْنُ نَصْرٍ ،  ثَنَا  أَبُو هَمَّامٍ الصَّلْتُ بْنُ مُحَمَّدٍ الْخَارَكِيُّ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ فَرْوَةَ ،  ثَنَا  أَبُو عِمْرَانَ الْجَوْنِيُّ ،  عَنْ  أَبِي فِرَاسٍ ، رَجُلٍ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  جِئْتُ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُرِيدُ النِّسَاءَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ائْتِ فُلَانًا فَانْظُرْ إِلَى مَا بِهِمْ ، فَإِنَّهُ أَثْبَتُ لِلْوُدِّ ، فَإِنْ رَضِيتَهَا أَنْكَحْتُكَ ،  فَأَتَاهُمْ فَسَلَّمَ عَلَيْهِمْ ، فَقَالَ : أَرْسَلَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَمَرَكَ أَنْ يَرَوْكَ إِيَّايَ ؟ قُلْتُ : نَعَمْ ، فَكَشَفْتُ عَنْ خِدْرِهَا ، وَقَالَتِ : انْظُرْ ، فَتَزَوَّجْتُهَا ، فَمَا تَزَوَّجْتُ شَيْئًا قَطُّ أَحَبَّ إِلَيَّ مِنْهَا ، وَلَقَدْ تَزَوَّجْتُ سِتِّينَ امْرَأَةً  .","","Al-Mu'jam al-Kabir 862","","المغيرة بن شعبة عن ربيعة بن كعب الأسلمي عن عبد الملك بن حبيب الجوني عن عبد الحميد بن عبد الرحمن بن فروة العجلي عن الصلت بن محمد الخاركي عن علي بن نصر الجهضمي الصغير عن الحسين بن إسحاق التستري عن الطبراني","أبو فراس الأسلمي عن المغيرة بن شعبة"
"19042","ابْنُ أَبِي مَرْحَبٍ  ، لَهُ  صُحْبَةٌ  ، عَنِ  الْمُغِيرَةِ  863  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ أَيُّوبَ ، صَاحِبُ الْمَغَازِي ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  ثَنَا  سُفْيَانُ بْنُ سَعِيدٍ الثَّوْرِيُّ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ أَبِي مَرْحَبٍ قَالَ :  نَزَلَ فِي قَبْرِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَرْبَعَةٌ  : أَحَدُهُمْ  عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  ، وَقَدْ كَانَ  الْمُغِيرَةُ بْنُ شُعْبَةَ  يُدْعَى         [20/371]      أَحْدَثَ النَّاسِ عَهْدًا بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَكُونُ آخِرَ النَّاسِ بِهِ عَهْدًا  "" .","","Al-Mu'jam al-Kabir 863","","مرحب الأنصاري عن الشعبي عن إسماعيل بن أبي خالد عن سفيان الثوري عن إبراهيم بن سعد أبو إسحاق الزهري عن أحمد بن محمد بن أيوب عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ابن أبي مرحب عن المغيرة"
"19043","عُرْوَةُ بْنُ الْمُغِيرَةِ  ، عَنْ أَبِيهِ  الشَّعْبِيُّ  ، عَنْ  عُرْوَةَ  864  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَبِشْرُ بْنُ مُوسَى ، قَالَا :  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  زَكَرِيَّا بْنُ أَبِي زَائِدَةَ ،  عَنْ  عَامِرٍ ،  عَنْ  عُرْوَةَ بْنِ الْمُغِيرَةِ بْنِ شُعْبَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  كُنْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَاتَ لَيْلَةٍ فِي سَفَرٍ فَقَالَ : "" أَوَمَعَكَ مَاءٌ ؟ "" فَقُلْتُ : نَعَمْ ، فَنَزَلَ عَنْ رَاحِلَتِهِ فَمَشَى حَتَّى تَوَارَى عَنِّي فِي سَوَادِ اللَّيْلِ ، ثُمَّ جَاءَ فَأَفْرَغْتُ عَلَيْهِ مِنْ مَاءِ الْإِدَوَاةِ ، فَغَسَلَ يَدَيْهِ وَوَجْهَهُ وَعَلَيْهِ جُبَّةٌ مِنْ صُوفٍ ، فَلَمْ يَسْتَطِعْ أَنْ يُخْرِجَ ذِرَاعَيْهِ مِنْ ضِيقِهَا حَتَّى أَخْرَجَهُمَا مِنْ أَسْفَلِ الْجُبَّةِ ، وَغَسَلَ ذِرَاعَيْهِ وَمَسَحَ بِرَأْسِهِ ، ثُمَّ أَهْوَيْتُ لِأَنْزِعَ خُفَّهُ ، فَقَالَ :  دَعْهُمَا فَإِنِّي أَدْخَلْتُهُمَا طَاهِرَتَيْنِ  . فَمَسَحَ عَلَيْهِمَا  .","","Al-Mu'jam al-Kabir 864","","المغيرة بن شعبة عن عروة بن المغيرة بن شعبة عن الشعبي عن زكريا بن أبي زائدة الوادعي عن الفضل بن دكين عن بشر بن موسى بن صالح الأسدي عن الطبراني","الشعبي عن عروة"
"19044","865  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عُرْوَةَ بْنِ الْمُغِيرَةِ بْنِ شُعْبَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  كُنْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ فَتَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 865","","المغيرة بن شعبة عن عروة بن المغيرة بن شعبة عن الشعبي عن يونس بن أبي إسحاق عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","الشعبي عن عروة"
"19045","866  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  عَنْ  عُرْوَةَ بْنِ الْمُغِيرَةِ بْنِ شُعْبَةَ ،  عَنْ  أَبِيهِ  ،         [20/372]      أَنَّهُ كَانَ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَنَزَلَ فَقَالَ : "" هَلْ مِنْ طَهُورٍ ؟ "" فَأَتَيْتُهُ بِمَاءٍ فَغَسَلَ يَدَيْهِ وَوَجْهَهُ ، ثُمَّ ذَهَبَ لِيَغْسِلَ ذِرَاعَيْهِ فَضَاقَتْ بِهِ الْجُبَّةُ ، وَكَانَتْ جُبَّةٌ مِنْ جِبَابِ  الرُّومِ  ، فَأَدْرَعَ يَدَيْهِ مِنْ تَحْتِ الْجُبَّةِ أَدْرُعًا ، فَغَسَلَ ذِرَاعَيْهِ ، فَأَهْوَيْتُ إِلَى الْخُفَّيْنِ ، فَقَالَ :  دَعِ الْخُفَّيْنِ فَإِنِّي قَدْ أَدْخَلْتُ الْقَدَمَيْنِ الْخُفَّيْنِ وَهُمَا طَاهِرَتَانِ  ، فَمَسَحَ عَلَى الْخُفَّيْنِ  .","","Al-Mu'jam al-Kabir 866","","المغيرة بن شعبة عن عروة بن المغيرة بن شعبة عن الشعبي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","الشعبي عن عروة"
"19046","867  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  الْحُمَيْدِيُّ ، (  ح  )  وَحَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ ،  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ، قَالَا :  ثَنَا  سُفْيَانُ ،  عَنْ  حُصَيْنٍ ، وَيُونُسَ ،  عَنْ  أَبِي إِسْحَاقَ ، وَزَكَرِيَّا بْنِ أَبِي يَحْيَى  ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عُرْوَةَ بْنِ الْمُغِيرَةِ بْنِ شُعْبَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ ، فَقُلْتُ :  يَا رَسُولَ اللهِ ، أَتَمْسَحُ عَلَى خُفَّيْكَ ؟ قَالَ : نَعَمْ ، إِنِّي أَدْخَلْتُهُمَا وَهُمَا طَاهِرَتَانِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( زكريا أبو يحيى )","","Al-Mu'jam al-Kabir 867","","المغيرة بن شعبة عن عروة بن المغيرة بن شعبة عن الشعبي عن زكريا بن أبي زائدة الوادعي عن يونس بن أبي إسحاق عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","الشعبي عن عروة"
"19047","868  -  حَدَّثَنَا  مُحَمَّدُ بْنُ زَكَرِيَّا الْغَلَّابِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  ثَنَا  عُمَرُ بْنُ أَبِي زَائِدَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ أَبِي السَّفَرِ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عُرْوَةَ بْنِ الْمُغِيرَةِ ،  عَنْ  أَبِيهِ  ، قَالَ :  كُنَّا فِي مَسِيرٍ ، فَقَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَمَعَكَ مَاءٌ ؟ "" . قُلْتُ : نَعَمْ ، فَنَزَلَ عَنْ رَاحِلَتِهِ ثُمَّ مَشَى حَتَّى تَوَارَى عَنِّي ، فَلَمَّا أَقْبَلَ اسْتَقْبَلْتُهُ بِالْمِطْهَرَةِ فَتَوَضَّأَ وَغَسَلَ كَفَّيْهِ ، وَغَسَلَ وَجْهَهُ ، وَكَانَتْ عَلَيْهِ جُبَّةٌ شَامِيَّةٌ ضَيِّقَةُ الْيَدَيْنِ ، فَأَخْرَجَ يَدَهُ مِنْ تَحْتِ الْجُبَّةِ ، وَغَسَلَ ذِرَاعَيْهِ وَمَسَحَ بِرَأْسِهِ ، ثُمَّ أَهْوَيْتُ إِلَى خُفَّيْهِ لِأَنْزِعَهُمَا ، فَقَالَ :  دَعْهُمَا ، فَإِنِّي أَدْخَلْتُهُمَا وَهُمَا طَاهِرَتَانِ  . فَمَسَحَ عَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 868","","المغيرة بن شعبة عن عروة بن المغيرة بن شعبة عن الشعبي عن عبد الله بن أبي السفر الهمداني عن عمر بن أبي زائدة الهمداني عن عبد الله بن رجاء الغداني عن محمد بن زكريا بن دينار الإخباري عن الطبراني","الشعبي عن عروة"
"19048","869  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ الْبَرَاءِ ،  ثَنَا  الْمُعَافَى بْنُ سُلَيْمَانَ ،  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عُرْوَةَ بْنِ الْمُغِيرَةِ         [20/373]      بْنِ شُعْبَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  كُنْتُ أَسِيرُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَيْلَةً فَقَالَ : "" مَنْ هَذَا ؟ "" فَقُلْتُ : أَنَا  الْمُغِيرَةُ بْنُ شُعْبَةَ  ، فَقَالَ : "" أَمْسِكْ "" ، فَأَمْسَكْتُ لَهُ نَاقَتَهُ وَانْطَلَقَ حَتَّى مَا رَأَيْتُهُ ، ثُمَّ جَاءَ فَوَضَّأْتُهُ  فَحَسَرَ  عَنْ ذِرَاعَيْهِ ، فَضَاقَ كُمُّ الْجُبَّةِ ، فَأَخْرَجَ يَدَيْهِ مِنْ تَحْتِهَا ، فَتَوَضَّأَ فَغَسَلَ يَدَيْهِ وَوَجْهَهُ وَذِرَاعَيْهِ وَمَسَحَ عَلَى خُفَّيْهِ ، فَقُلْتُ :  أَلَا تَنْزِعُ خُفَّيْكَ ؟ فَقَالَ : "" إِنِّي أَدْخَلْتُهُمَا طَاهِرَتَيْنِ  .","","Al-Mu'jam al-Kabir 869","","المغيرة بن شعبة عن عروة بن المغيرة بن شعبة عن الشعبي عن إسماعيل بن أبي خالد عن موسى بن أعين الجزري عن المعافى بن سليمان الرسعني عن محمد بن أحمد بن البراء العبدي عن الطبراني","الشعبي عن عروة"
"19049","870  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى بْنِ مُعَاذٍ الْعَنْبَرِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ عَوْنٍ ،  عَنْ  مُحَمَّدٍ ، وَالشَّعْبِيِّ - قَالَ  ابْنُ عَوْنٍ  : لَا أَحْفَظُ حَدِيثَ هَذَا مِنْ حَدِيثِ هَذَا ، فَكَانَ حَدِيثُ  الشَّعْبِيِّ  أَقْرَبَهُمَا  إِسْنَادًا  - حَدَّثَ  الشَّعْبِيُّ  ،  عَنْ  عُرْوَةَ بْنِ الْمُغِيرَةِ ، وَرَدَّ  مُحَمَّدٌ  الْحَدِيثَ إِلَى الْمُغِيرَةِ ، - قَالَ  ابْنُ عَوْنٍ  : ذَكَرَ ذَاكَ الْمَسِيرَ - قَالَ :  فَقَرَعَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ظَهْرِي بِعَصًا كَانَ مَعَهُ ، فَعَدَلَ وَعَدَلْتُ حَتَّى بَلَغَنَا - لَا أَدْرِي أَيْنَ مِنَ الْأَرْضِ - فَأَنَاخَ فَنَزَلَ فَانْطَلَقَ حَتَّى تَوَارَى عَنِّي ، ثُمَّ جَاءَ فَقَالَ :  أَمَعَكَ مَاءٌ ؟ "" وَمَعِي  سَطِيحَةٌ  لِي ، فَأَفْرَغْتُ عَلَيْهِ فَغَسَلَ كَفَّيْهِ وَغَسَلَ وَجْهَهُ  وَذَهَبَ يَغْسِلُ ذِرَاعَيْهِ وَعَلَيْهِ جُبَّةٌ شَامِيَّةٌ ضَيِّقَةُ الْكُمَّيْنِ ، فَأَخْرَجَ يَدَيْهِ مِنْ تَحْتِ  الْبَدَنِ  ، فَغَسَلَ يَدَيْهِ وَغَسَلَ وَجْهَهُ ، وَغَسَلَ ذِرَاعَيْهِ وَمَسَحَ - قَالَ  ابْنُ عَوْنٍ  : وَذَكَرَ مِنْ نَاصِيَتِهِ وَعِمَامَتِهِ شَيْئًا ،  لَا أَدْرِي أَصَبْتُهُ أَمْ لَا  - وَمَسَحَ عَلَى خُفَّيْهِ ثُمَّ قَالَ : "" حَاجَتَكَ ؟ "" قُلْتُ : يَا رَسُولَ اللهِ ، مَا لِي حَاجَةٌ ، فَانْطَلَقْنَا فَأَتَيْنَا النَّاسَ ، وَقَدْ أَمَّهُمُ  ابْنُ عَوْفٍ  فِي صَلَاةِ الصُّبْحِ فَصَلَّى بِهِمْ رَكْعَةً ، فَذَهَبْتُ لِأُوذِنَهُ فَمَنَعَنِي ، فَصَلَّيْنَا مَا أَدْرَكْنَا ، وَقَضَيْنَا مَا سُبِقْنَا  .","","Al-Mu'jam al-Kabir 870","","المغيرة بن شعبة عن محمد بن سيرين عن عبد الله بن عون بن أرطبان عن المثنى بن معاذ بن معاذ العنبري عن معاذ بن المثنى العنبري عن الطبراني","الشعبي عن عروة"
"19050","871  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ مُسَاوِرٍ الْجَوْهَرِيُّ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  عُبَيْدَةُ بْنُ الْأَسْوَدِ ،  عَنِ  الْقَاسِمِ بْنِ الْوَلِيدِ ، وَمُجَالِدٍ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  حَدَّثَنِي  عُرْوَةُ بْنُ الْمُغِيرَةِ ،  عَنْ  أَبِيهِ  ، قَالَ :         [20/374]      خَرَجْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَامَ لِحَاجَتِهِ وَعَلَيْهِ جُبَّةٌ رُومِيَّةٌ ، فَتَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ ، وَقَالَ :  إِنِّي لَبِسْتُهُمَا وَأَنَا  عَلَى طُهْرٍ أَوْ عَلَى طَهُورٍ  .","","Al-Mu'jam al-Kabir 871","","المغيرة بن شعبة عن عروة بن المغيرة بن شعبة عن الشعبي عن مجالد بن سعيد عن عبيدة بن الأسود بن سعيد الهمداني عن عبد الله بن عمر مشكدانة عن عبد الله بن أحمد الجواليقي عن الطبراني","الشعبي عن عروة"
"19051","872  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَعُمَرُ بْنُ إِبْرَاهِيمَ الْبَغْدَادِيُّ ، وَأَحْمَدُ بْنُ عَلِيٍّ الْجَارُودِيُّ الْأَصْبَهَانِيُّ ، قَالُوا :  ثَنَا  أَبُو الْأَسْبَاطِ الْكُوفِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي حَمَّادٍ ،  ثَنَا  مِنْدَلُ بْنُ عَلِيٍّ ،  عَنْ  بُكَيْرِ بْنِ عَامِرٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عُرْوَةَ بْنِ الْمُغِيرَةِ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  قَالَ :  وَضَّأْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَمَسَحَ عَلَى خُفَّيْهِ ، فَقُلْتُ :  يَا رَسُولَ اللهِ نَسِيتَ ؟ قَالَ : "" بَلْ أَنْتَ نَسِيتَ ، بِذَا أَمَرَنِي رَبِّي جَلَّ وَعَزَّ  .","","Al-Mu'jam al-Kabir 872","","المغيرة بن شعبة عن عروة بن المغيرة بن شعبة عن الشعبي عن بكير بن عامر البجلي عن مندل بن علي عن عبد الرحمن بن شكيل عن يعقوب بن إبراهيم الكوفى عن الجارودي أحمد بن علي الأصبهاني عن الطبراني","الشعبي عن عروة"
"19052","873  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ شُعَيْبٍ الرِّحَابِيُّ  ،  ثَنَا  يَحْيَى بْنُ حَكِيمٍ  ،  ثَنَا  يَحْيَى بْنُ حَكِيمٍ الْمُقَوِّمُ  ،  ثَنَا  مَكِّيُّ بْنُ إِبْرَاهِيمَ ،  ثَنَا  دَاوُدُ بْنُ يَزِيدَ الْأَوْدِيُّ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  عَنْ  عُرْوَةَ بْنِ الْمُغِيرَةِ بْنِ شُعْبَةَ ،  سَمِعَ  أَبَاهُ  ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَذَهَبَ لِحَاجَتِهِ ، ثُمَّ أَشَارَ إِلَيَّ فَأَتَيْتُهُ بِمَاءٍ وَعَلَيْهِ جُبَّةٌ شَامِيَّةٌ ، لَيْسَ لَهَا يَدَانِ ، فَأَلْقَاهَا عَلَى عَاتِقِهِ فَقَالَ :  صُبَّ عَلَيَّ ، فَصَبَبْتُ عَلَيْهِ فَتَوَضَّأَ وَمَسَحَ عَلَى الْخُفَّيْنِ  ، وَكَانَتْ سُنَّةً : الْمُسَافِرُ ثَلَاثَةُ أَيَّامٍ وَلَيَالِيهِنَّ ، وَلِلْمُقِيمِ يَوْمٌ وَلَيْلَةٌ  .  كذا في طبعة مكتبة ابن تيمية ، والذي في نسخة أحمد الثالث أقرب إلى : ( الرجاني ) وهو الصواب وينظر الأنساب للسمعاني .  كذا في طبعة مكتبة ابن تيمية والنسخة الخطية والظاهر أنه تكرار . والله أعلم .  كذا في طبعة مكتبة ابن تيمية والنسخة الخطية والظاهر أنه تكرار . والله أعلم .","","Al-Mu'jam al-Kabir 873","","المغيرة بن شعبة عن عروة بن المغيرة بن شعبة عن الشعبي عن داود بن يزيد الزعافري عن مكي بن إبراهيم عن يحيى بن حكيم المقوم عن عبد الله بن محمد بن شعيب الرجاني عن الطبراني","الشعبي عن عروة"
"19053","874  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدَانَ بْنِ أَحْمَدَ ،  ثَنَا  مُحَمَّدُ بْنُ غَالِبٍ ،  ثَنَا  عَبْدُ الصَّمَدِ بْنُ النُّعْمَانِ ،  ثَنَا  سُلَيْمٌ ، مَوْلَى الشَّعْبِيِّ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عُرْوَةَ بْنِ الْمُغِيرَةِ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 874","","المغيرة بن شعبة عن عروة بن المغيرة بن شعبة عن الشعبي عن سليم الكوفي عن عبد الصمد بن النعمان البغدادي عن محمد بن غالب التمتام عن عبد الله بن أحمد الجواليقي عن الطبراني","الشعبي عن عروة"
"19054","[20/375]      نَافِعُ بْنُ جُبَيْرِ بْنِ مُطْعِمٍ  ، عَنْ  عُرْوَةَ بْنِ الْمُغِيرَةِ بْنِ شُعْبَةَ  ، عَنْ أَبِيهِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  875  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ ،  ثَنَا  شُعَيْبُ بْنُ يَحْيَى ،  أَنَا  اللَّيْثُ ، (  ح  )  وَحَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  نَافِعِ بْنِ جُبَيْرٍ ،  عَنْ  عُرْوَةَ بْنِ الْمُغِيرَةِ بْنِ شُعْبَةَ ،  عَنْ  أَبِيهِ الْمُغِيرَةِ بْنِ شُعْبَةَ  ،  عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  أَنَّهُ خَرَجَ لِحَاجَتِهِ وَتَبِعَهُ  الْمُغِيرَةُ  بِالْإِدَاوَةِ  فِيهَا مَاءٌ ، فَصَبَّ عَلَيْهِ  حَتَّى فَرَغَ مِنْ حَاجَتِهِ فَتَوَضَّأَ وَمَسَحَ عَلَى الْخُفَّيْنِ  .","","Al-Mu'jam al-Kabir 875","","المغيرة بن شعبة عن عروة بن المغيرة بن شعبة عن نافع بن جبير بن مطعم النوفلي عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن يحيى بن سعيد الأنصاري عن الليث بن سعد عن شعيب بن يحيى التجيبي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","نافع بن جبير بن مطعم عن عروة بن المغيرة بن شعبة عن أبيه المغيرة بن شعبة"
"19055","876  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ الْحَجَّاجِ بْنِ رِشْدِينَ الْمِصْرِيُّ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  عَمْرِو بْنِ الْحَارِثِ ، أَنَّ يَحْيَى بْنَ سَعِيدٍ  حَدَّثَهُ  ، أَنَّ نَافِعَ بْنَ جُبَيْرٍ  حَدَّثَهُ  ، أَنَّ  عُرْوَةَ بْنَ الْمُغِيرَةِ بْنِ شُعْبَةَ  حَدَّثَهُ  ،  عَنْ  أَبِيهِ  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ وَمَسَحَ عَلَى الْخُفَّيْنِ  .","","Al-Mu'jam al-Kabir 876","","المغيرة بن شعبة عن عروة بن المغيرة بن شعبة عن نافع بن جبير بن مطعم النوفلي عن يحيى بن سعيد الأنصاري عن عمرو بن الحارث بن يعقوب عن رشدين بن سعد المهري عن حجاج بن رشدين المصري عن محمد بن الحجاج بن رشدين المهري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","نافع بن جبير بن مطعم عن عروة بن المغيرة بن شعبة عن أبيه المغيرة بن شعبة"
"19056","877  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  نَافِعِ بْنِ جُبَيْرٍ ،  عَنْ  عُرْوَةَ بْنِ الْمُغِيرَةِ ،  عَنْ  أَبِيهِ  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ وَمَسَحَ عَلَى الْخُفَّيْنِ  .","","Al-Mu'jam al-Kabir 877","","المغيرة بن شعبة عن عروة بن المغيرة بن شعبة عن نافع بن جبير بن مطعم النوفلي عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن يحيى بن سعيد الأنصاري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","نافع بن جبير بن مطعم عن عروة بن المغيرة بن شعبة عن أبيه المغيرة بن شعبة"
"19057","[20/376]      878  -  حَدَّثَنَا  مُحَمَّدُ بْنُ هِشَامِ بْنِ أَبِي الدُّمَيْكِ ،  ثَنَا  بِشْرُ بْنُ الْوَلِيدِ الْكِنْدِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي سَلَمَةَ الْمَاجِشُونُ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  نَافِعِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ ،  عَنْ  عُرْوَةَ بْنِ الْمُغِيرَةِ بْنِ شُعْبَةَ ،  عَنِ  الْمُغِيرَةِ  ،  أَنَّهُ سَكَبَ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ إِنَائِهِ ، فَغَسَلَ وَجْهَهُ  ، ثُمَّ ذَهَبَ يَغْسِلُ ذِرَاعَيْهِ فَضَاقَ كُمَّاهُ عَنْ ذِرَاعَيْهِ ، فَأَخْرَجَهُمَا مِنْ تَحْتِ الْجُبَّةِ ، وَكَانَتْ مِنْ صُوفٍ ، ثُمَّ غَسَلَهُمَا وَمَسَحَ عَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 878","","المغيرة بن شعبة عن عروة بن المغيرة بن شعبة عن نافع بن جبير بن مطعم النوفلي عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن عبد العزيز بن عبد الله الماجشون عن بشر بن الوليد الكندي عن ابن أبى الدميك محمد بن هشام بن علي عن الطبراني","نافع بن جبير بن مطعم عن عروة بن المغيرة بن شعبة عن أبيه المغيرة بن شعبة"
"19058","879  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُرْوَةَ بْنِ الْمُغِيرَةِ بْنِ شُعْبَةَ ،  عَنْ  أَبِيهِ  ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 879","","المغيرة بن شعبة عن عروة بن المغيرة بن شعبة عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعد أبو إسحاق الزهري عن نعيم بن حماد الخزاعي عن يحيى بن عثمان بن صالح عن الطبراني","نافع بن جبير بن مطعم عن عروة بن المغيرة بن شعبة عن أبيه المغيرة بن شعبة"
"19059","عَبَّادُ بْنُ زِيَادٍ  ، عَنْ  عُرْوَةَ بْنِ الْمُغِيرَةِ  880  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  ابْنُ جُرَيْجٍ ،  أَخْبَرَنِي  ابْنُ شِهَابٍ ،  عَنْ  عَبَّادِ بْنِ زِيَادٍ ، أَنَّ  عُرْوَةَ بْنَ الْمُغِيرَةِ بْنِ شُعْبَةَ  أَخْبَرَهُ  أَنَّ الْمُغِيرَةَ بْنَ شُعْبَةَ  أَخْبَرَهُ  ،  أَنَّهُ غَزَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  غَزْوَةَ تَبُوكَ  ، فَتَبَرَّزَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قِبَلَ الْغَائِطِ ، فَحَمَلْتُ مَعَهُ  بِإِدَاوَةٍ  قَبْلَ صَلَاةِ الْفَجْرِ ، فَلَمَّا رَجَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَيَّ أَخَذْتُ أُهْرِيقُ عَلَى يَدَيْهِ مِنَ  الْإِدَاوَةِ  ، "" فَغَسَلَ يَدَيْهِ ثَلَاثَ مِرَارٍ ، ثُمَّ تَمَضْمَضَ وَاسْتَنْشَقَ ، ثُمَّ غَسَلَ وَجْهَهُ ، ثُمَّ ذَهَبَ يُخْرِجُ جُبَّتَهُ عَنْ ذِرَاعَيْهِ فَضَاقَ كُمَّا جُبَّتِهِ ، فَأَدْخَلَ يَدَيْهِ فِي الْجُبَّةِ إِلَى الْمِرْفَقَيْنِ ، ثُمَّ تَوَضَّأَ عَلَى خُفَّيْهِ ثُمَّ أَقْبَلَ         [20/377]      فَأَقْبَلْتُ مَعَهُ حَتَّى نَجِدَ النَّاسَ قَدْ قَدَّمُوا  عَبْدَ الرَّحْمَنِ بْنَ عَوْفٍ  يُصَلِّي لَهُمْ ، فَأَدْرَكَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِحْدَى الرَّكْعَتَيْنِ فَصَلَّى مَعَ النَّاسِ الرَّكْعَةَ الْآخِرَةَ ، فَلَمَّا سَلَّمَ  عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  قَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُتِمُّ صَلَاتَهُ ، فَأَفْزَعَ ذَلِكَ الْمُسْلِمِينَ فَأَكْثَرُوا التَّسْبِيحَ ، فَلَمَّا قَضَى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَاتَهُ أَقْبَلَ عَلَيْهِمْ ثُمَّ قَالَ :  أَحْسَنْتُمْ "" أَوْ قَالَ : "" أَصَبْتُمْ  "" ، يَغْبِطُهُمْ أَنْ صَلَّوُا الصَّلَاةَ لِوَقْتِهَا  .  قَالَ  ابْنُ شِهَابٍ  :  فَحَدَّثَنِي  إِسْمَاعِيلُ بْنُ مُحَمَّدِ بْنِ سَعْدٍ ،  عَنْ  حَمْزَةَ بْنِ الْمُغِيرَةِ بْنِ شُعْبَةَ  بِمِثْلِ حَدِيثِ  عَبَّادِ بْنِ زِيَادٍ .  وَزَادَ : قَالَ الْمُغِيرَةُ : فَبَادَرْتُ لِأُخْبِرَ  عَبْدَ الرَّحْمَنِ بْنَ عَوْفٍ  ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" دَعْهُ "" .  فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 880","","المغيرة بن شعبة عن عروة بن المغيرة بن شعبة عن عباد بن زياد السجستاني عن الزهري عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عباد بن زياد عن عروة بن المغيرة"
"19060","881  -  حَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ الْمِصْرِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  يُونُسُ بْنُ يَزِيدَ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عَبَّادِ بْنِ زِيَادٍ ،  عَنْ  حَمْزَةَ بْنِ الْمُغِيرَةِ بْنِ شُعْبَةَ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 881","","المغيرة بن شعبة عن حمزة بن المغيرة بن شعبة عن عباد بن زياد السجستاني عن الزهري عن يونس بن يزيدالأيلي عن الليث بن سعد عن عبد الله بن صالح المصري عن هارون بن كامل المصري عن الطبراني","عباد بن زياد عن عروة بن المغيرة"
"19061","أَبُو الزِّنَادِ  ، عَنْ  عُرْوَةَ بْنِ الْمُغِيرَةِ  ، عَنِ  الْمُغِيرَةِ  882  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ الدَّوْلَابِيُّ ، (  ح  )         [20/378]      وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ الْهَاشِمِيُّ ، (  ح  )  وَحَدَّثَنَا  الْحُصَيْنُ الْقَاضِي  ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ قَالُوا :  ثَنَا  ابْنُ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُرْوَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَسَحَ عَلَى ظُهُورِ الْخُفَّيْنِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( أبو الحصين )","","Al-Mu'jam al-Kabir 882","","المغيرة بن شعبة عن عروة بن المغيرة بن شعبة عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","أبو الزناد عن عروة بن المغيرة عن المغيرة"
"19062","883  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ، (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُرْوَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  ،  أَنَّ  عُمَرَ  رَضِيَ اللهُ عَنْهُ         [20/379]      اسْتَشَارَهُمْ فِي  إِمْلَاصِ  الْمَرْأَةِ -  يَعْنِي  السِّقْطَ  - قَالَ  الْمُغِيرَةُ بْنُ شُعْبَةَ  : فَقُلْتُ لَهُ :  قَضَى فِيهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِغُرَّةٍ  فَقَالَ  عُمَرُ  : فَإِنْ كُنْتَ صَادِقًا ائْتِ بِمَنْ يَعْلَمُ ذَلِكَ ، فَجِئْتُ مُحَمَّدَ بْنَ مَسْلَمَةَ فَجَاءَ فَقَالَ : "" قَضَى فِيهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِغُرَّةٍ  .","","Al-Mu'jam al-Kabir 883","","محمد بن مسلمة بن سلمة الخزرجي عن عروة بن الزبير عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","أبو الزناد عن عروة بن المغيرة عن المغيرة"
"19063","عُمَرُ بْنُ بَيَانٍ التَّغْلِبِيُّ  ، عَنْ  عُرْوَةَ بْنِ الْمُغِيرَةِ  884  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو غَسَّانَ النَّهْدِيُّ ،  ثَنَا  طُعْمَةُ بْنُ عَمْرٍو ،  عَنْ  عُمَرَ بْنِ بَيَانٍ التَّغْلِبِيِّ ،  عَنْ  عُرْوَةَ بْنِ الْمُغِيرَةِ بْنِ شُعْبَةَ ،  عَنِ  الْمُغِيرَةِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ بَاعَ الْخَمْرَ  فَلْيُشَقِّصِ  الْخَنَازِيرَ  .","","Al-Mu'jam al-Kabir 884","","المغيرة بن شعبة عن عروة بن المغيرة بن شعبة عن عمر بن بيان التغلبي عن طعمة بن عمرو الجعفري عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمر بن بيان التغلبي عن عروة بن المغيرة"
"19064","حَمْزَةُ بْنُ الْمُغِيرَةِ  ، عَنْ أَبِيهِ  885  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  حُمَيْدٍ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ ،  عَنْ  حَمْزَةَ بْنِ الْمُغِيرَةِ ،  عَنْ  أَبِيهِ  ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَمْسَحُ عَلَى الْعِمَامَةِ  وَالْمُوقَيْنِ  .","","Al-Mu'jam al-Kabir 885","","المغيرة بن شعبة عن حمزة بن المغيرة بن شعبة عن بكر بن عبد الله المزني عن حميد الطويل عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","حمزة بن المغيرة عن أبيه"
"19065","886  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبِي  ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  مُسَدَّدٌ ، قَالَا :  ثَنَا  يَحْيَى         [20/380]      بْنُ سَعِيدٍ ،  عَنِ  التَّيْمِيِّ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ ،  عَنِ  الْحَسَنِ ،  عَنِ  ابْنِ الْمُغِيرَةِ بْنِ شُعْبَةَ ،  عَنْ  أَبِيهِ  ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ وَمَسَحَ عَلَى نَاصِيَتِهِ  .","","Al-Mu'jam al-Kabir 886","","المغيرة بن شعبة عن حمزة بن المغيرة بن شعبة عن الحسن البصري عن بكر بن عبد الله المزني عن سليمان بن طرخان عن يحيى القطان عن مسدد بن مسرهد عن أبو مسلم الكجي عن الطبراني","حمزة بن المغيرة عن أبيه"
"19066","887  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  عَنِ  التَّيْمِيِّ ،  عَنْ  بَكْرٍ ،  عَنِ  ابْنِ الْمُغِيرَةِ بْنِ شُعْبَةَ ،  عَنْ  أَبِيهِ  ، "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مَسَحَ عَلَى الْخُفَّيْنِ ، وَمَسَحَ مُقَدَّمَ رَأْسِهِ  ، وَوَضَعَ يَدَيْهِ عَلَى الْعِمَامَةِ ، وَمَسَحَ عَلَى الْعِمَامَةِ  وَلَمْ يَذْكُرِ  الْحَسَنَ  .","","Al-Mu'jam al-Kabir 887","","المغيرة بن شعبة عن حمزة بن المغيرة بن شعبة عن بكر بن عبد الله المزني عن سليمان بن طرخان عن يزيد بن هارون عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","حمزة بن المغيرة عن أبيه"
"19067","888  -  حَدَّثَنَا  مُحَمَّدُ بْنُ هِشَامٍ الْمُسْتَمْلِي ،  ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  مُعْتَمِرٌ ،  عَنْ  أَبِيهِ  ،  عَنْ  بَكْرٍ ،  عَنِ  ابْنِ الْمُغِيرَةِ ،  عَنْ  أَبِيهِ  ، مِثْلَهُ ،  وَلَمْ يَذْكُرِ  الْحَسَنَ  .","","Al-Mu'jam al-Kabir 888","","المغيرة بن شعبة عن حمزة بن المغيرة بن شعبة عن بكر بن عبد الله المزني عن سليمان بن طرخان عن معتمر بن سليمان عن علي ابن المديني عن ابن أبى الدميك محمد بن هشام بن علي عن الطبراني","حمزة بن المغيرة عن أبيه"
"19068","889  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ مُحَمَّدِ بْنِ سَعْدٍ ،  حَدَّثَنِي  حَمْزَةُ بْنُ الْمُغِيرَةِ بْنِ شُعْبَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  كُنْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ فَقَالَ :  تَخَلَّفْ يَا  مُغِيرَةُ  ، وَامْضُوا أَيُّهَا النَّاسُ  ، قَالَ : ثُمَّ ذَهَبَ فَقَضَى حَاجَتَهُ وَأَتَيْتُهُ  بِإِدَاوَةٍ  مِنْ مَاءٍ ، فَلَمَّا فَرَغَ سَكَبْتُ عَلَيْهِ مِنْهَا فَغَسَلَ وَجْهَهُ ، ثُمَّ ذَهَبَ يُخْرِجُ يَدَيْهِ مِنْ جُبَّةٍ عَلَيْهِ رُومِيَّةٍ ، فَضَاقَ كُمَّا الْجُبَّةِ ، فَأَخْرَجَ يَدَيْهِ مِنْ تَحْتِ الْجُبَّةِ فَغَسَلَهُمَا ، ثُمَّ مَسَحَ عَلَى خُفَّيْهِ ، ثُمَّ صَلَّى  .","","Al-Mu'jam al-Kabir 889","","المغيرة بن شعبة عن حمزة بن المغيرة بن شعبة عن إسماعيل بن محمد بن سعد عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","حمزة بن المغيرة عن أبيه"
"19069","عَقَّارُ بْنُ الْمُغِيرَةِ  ، عَنْ أَبِيهِ  890  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ، (  ح  )         [20/381]      وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَقَّارِ بْنِ الْمُغِيرَةِ بْنِ شُعْبَةَ ،  عَنْ  أَبِيهِ  رِوَايَةً  ، قَالَ :  لَمْ يَتَوَكَّلْ مَنِ  اسْتَرْقَى  أَوِ اكْتَوَى  .","","Al-Mu'jam al-Kabir 890","","المغيرة بن شعبة عن عقار بن المغيرة بن شعبة عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","عقار بن المغيرة عن أبيه"
"19070","891  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ، (  ح  )  وَحَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ بَرَّةَ الصَّنْعَانِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  الثَّوْرِيُّ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَقَّارِ بْنِ الْمُغِيرَةِ بْنِ شُعْبَةَ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَمْ يَتَوَكَّلْ مَنِ اكْتَوَى أَوِ  اسْتَرْقَى  .","","Al-Mu'jam al-Kabir 891","","المغيرة بن شعبة عن عقار بن المغيرة بن شعبة عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","عقار بن المغيرة عن أبيه"
"19071","892  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  غُنْدَرٌ ،  عَنْ  شُعْبَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  حَسَّانَ بْنِ أَبِي وَحَرَةَ ،  حَدَّثَنَا  عَقَّارُ بْنُ الْمُغِيرَةِ بْنِ شُعْبَةَ ،  عَنْ  أَبِيهِ الْمُغِيرَةِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَمْ يَتَوَكَّلْ مَنِ  اسْتَرْقَى  أَوِ اكْتَوَى  .","","Al-Mu'jam al-Kabir 892","","المغيرة بن شعبة عن عقار بن المغيرة بن شعبة عن حسان بن أبي وجزة القرشي عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عقار بن المغيرة عن أبيه"
"19072","893  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  ثَنَا  أَبُو أَحْمَدَ الزُّبَيْرِيُّ ،  ثَنَا  قَيْسٌ ،  عَنْ  خَالِدِ بْنِ زَيْدِ بْنِ حَارِثَةَ ،  عَنْ  عَقَّارِ بْنِ الْمُغِيرَةِ بْنِ شُعْبَةَ ،  عَنْ  أَبِيهِ  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَضَى فِي الْجَنِينِ  غُرَّةٌ  ؛ عَبْدٌ أَوْ أَمَةٌ  .","","Al-Mu'jam al-Kabir 893","","المغيرة بن شعبة عن عقار بن المغيرة بن شعبة عن خالد بن زيد الأنصاري عن قيس بن سليم العنبري عن محمد بن عبد الله بن الزبير عن إبراهيم بن سعيد الجوهري عن الحسين بن إسحاق التستري عن الطبراني","عقار بن المغيرة عن أبيه"
"19073","الْمُغِيرَةُ ابْنُ بِنْتِ الْمُغِيرَةِ  ، عَنِ  الْمُغِيرَةِ  894  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مَسْلَمَةُ بْنُ نَوْفَلٍ ،  عَنِ  الْمُغِيرَةِ ابْنِ بِنْتِ الْمُغِيرَةِ قَالَ :  مَرَّ الْمُغِيرَةُ بْنُ شُعْبَةَ  بِالْحِيرَةِ  ، فَإِذَا         [20/382]      قَوْمٌ قَدْ نَصَبُوا ثَعْلَبًا يَرْمُونَهَ غَرَضًا ، فَوَقَفَ عَلَيْهِمْ فَقَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنِ  الْمُثْلَةِ  .","","Al-Mu'jam al-Kabir 894","","المغيرة بن شعبة عن مغيرة بن صفية سبط المغيرة بن شعبة عن مسلمة ، ويقال مسلم بن نوفل بن المغيرة بن شعبة عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","المغيرة ابن بنت المغيرة عن المغيرة"
"19074","الْأَسْوَدُ بْنُ أَبِي عَاصِمٍ الثَّقَفِيُّ  ، عَنِ  الْمُغِيرَةِ  895  -  حَدَّثَنَا  أَبُو غَسَّانَ أَحْمَدُ بْنُ سَهْلِ بْنِ الْوَلِيدِ الْأَهْوَازِيُّ ،  ثَنَا  الْجَرَّاحُ بْنُ مَخْلَدٍ ،  ثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  ثَنَا  نَوْفَلُ بْنُ عُمَارَةَ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ الْأَسْوَدِ بْنِ أَبِي عَاصِمٍ الثَّقَفِيُّ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ حُنَيْنٍ  وَقَفَ عَلَى  رَجُلٍ مِنْ ثَقِيفَ  مَقْتُولٍ فَقَالَ :  أَبْعَدَكَ اللهُ ، فَإِنَّكَ كُنْتَ تَبْغَضُ  قُرَيْشًا  .","","Al-Mu'jam al-Kabir 895","","المغيرة بن شعبة عن أبيه عن عبد الله بن الأسود بن أبي عاصم الثقفي عن نوفل بن عمارة بن الوليد عن يعقوب بن محمد بن عيسى عن الجراح بن مخلد عن أحمد بن سهل بن الوليد الأهوازي عن الطبراني","الأسود بن أبي عاصم الثقفي عن المغيرة"
"19075","وَرَّادٌ مَوْلَى الْمُغِيرَةِ  ، عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  الشَّعْبِيُّ  ، عَنْ  وَرَّادٍ مَوْلَى الْمُغِيرَةِ  ، عَنِ  الْمُغِيرَةِ  896  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  الْعَبَّاسُ بْنُ طَالِبٍ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مُغِيرَةَ ،  عَنْ  شِبَاكٍ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  عَنْ  وَرَّادٍ ، مَوْلَى الْمُغِيرَةِ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا انْصَرَفَ مِنْ صَلَاتِهِ قَالَ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ ، وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ         [20/383]      شَيْءٍ قَدِيرٌ ،  اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .","","Al-Mu'jam al-Kabir 896","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن الشعبي عن شباك الضبي عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن العباس بن طالب البصري عن يوسف بن يزيد القراطيسي عن الطبراني","الشعبي عن وراد مولى المغيرة عن المغيرة"
"19076","897  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ ، وَعُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ، قَالَا :  ثَنَا  الْحَسَنُ بْنُ عَلِيِّ بْنِ رَاشِدٍ الْوَاسِطِيُّ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  مُغِيرَةَ ، وَزَكَرِيَّا ، وَإِسْمَاعِيلَ ، وَمُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  وَرَّادٍ ، قَالَ :  كَتَبَ  مُعَاوِيَةُ بْنُ أَبِي سُفْيَانَ  إِلَى الْمُغِيرَةِ بْنِ شُعْبَةَ : أَنِ اكْتُبْ إِلَيَّ بِشَيْءٍ سَمِعْتَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  فَكَتَبَ إِلَيْهِ  الْمُغِيرَةُ  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقُولُ عِنْدَ انْصِرَافِهِ مِنَ الصَّلَاةِ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ،  اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ ،  وَكَانَ يَنْهَى عَنْ  قِيلَ  وَقَالَ ، وَكَثْرَةِ  السُّؤَالِ  ، وَإِضَاعَةِ الْمَالِ ، وَعَنْ مَنْعٍ وَهَاتِ ،  وَعُقُوقِ  الْأُمَّهَاتِ ،  وَوَأْدِ  الْبَنَاتِ  .","","Al-Mu'jam al-Kabir 897","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن الشعبي عن مجالد بن سعيد عن هشيم بن بشير عن الحسن بن علي بن راشد الواسطي عن عثمان بن عمر الضبي عن الطبراني","الشعبي عن وراد مولى المغيرة عن المغيرة"
"19077","898  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  عَبْدُ اللهِ بْنُ أَبِي يَعْقُوبَ الْكَرْمَانِيُّ ،  ثَنَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  دَاوُدَ ، وَمُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  وَرَّادٍ كَاتِبِ الْمُغِيرَةِ ،  عَنِ  الْمُغِيرَةِ قَالَ :  كَتَبَ إِلَيْهِ  مُعَاوِيَةُ :  أَنِ اكْتُبْ إِلَيَّ بِشَيْءٍ سَمِعْتَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عِنْدَ انْصِرَافِهِ مِنَ الصَّلَاةِ ، فَقَالَ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ ، وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ،  اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .","","Al-Mu'jam al-Kabir 898","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن الشعبي عن مجالد بن سعيد عن هشيم بن بشير عن يحيى بن أبي بكير عن عبد الله بن يعقوب الكرماني عن عبد الله بن أحمد الجواليقي عن الطبراني","الشعبي عن وراد مولى المغيرة عن المغيرة"
"19078","899  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْحُسَيْنِ الْمِصِّيصِيُّ ،  ثَنَا  الْحَسَنُ بْنُ مُوسَى الْأَشْيَبُ ، (  ح  )         [20/384]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مَنْصُورٍ الطُّوسِيُّ ،  ثَنَا  الْحَسَنُ بْنُ مُوسَى الْأَشْيَبُ ،  ثَنَا  شَيْبَانُ ،  عَنْ  عَاصِمِ بْنِ أَبِي النَّجُودِ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  وَرَّادٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا انْصَرَفَ مِنَ الصَّلَاةِ قَالَ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ ، وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ،  اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .","","Al-Mu'jam al-Kabir 899","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن الشعبي عن عاصم بن بهدلة عن شيبان بن عبد الرحمن المؤدب عن الحسن بن موسى الأشيب عن محمد بن منصور الطوسي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","الشعبي عن وراد مولى المغيرة عن المغيرة"
"19079","900  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ، (  ح  )  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  أَنَا  خَالِدٌ الْحَذَّاءُ ،  حَدَّثَنِي  ابْنُ الْأَشْوَعِ ،  عَنِ  الشَّعْبِيِّ ،  حَدَّثَنِي  كَاتِبُ الْمُغِيرَةِ بْنِ شُعْبَةَ قَالَ :  كَتَبَ  مُعَاوِيَةُ  إِلَى الْمُغِيرَةِ : أَنِ اكْتُبْ إِلَيَّ بِشَيْءٍ سَمِعْتَهُ مِنَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فَكَتَبَ إِلَيْهِ  : إِنِّي سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ اللهَ كَرِهَ لَكُمْ ثَلَاثًا :  قِيلَ  وَقَالَ  ، وَكَثْرَةَ  السُّؤَالِ  ، وَإِضَاعَةَ الْمَالِ  .","","Al-Mu'jam al-Kabir 900","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن الشعبي عن سعيد بن عمرو بن أشوع الهمداني عن خالد الحذاء عن إسماعيل ابن علية عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","الشعبي عن وراد مولى المغيرة عن المغيرة"
"19080","901  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عِمْرَانَ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  وَرَّادٍ ، مَوْلَى الْمُغِيرَةِ ،  عَنِ  الْمُغِيرَةِ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ عَزَّ وَجَلَّ حَرَّمَ عَلَيْكُمْ  عُقُوقَ  الْأُمَّهَاتِ ،         [20/385]      وَوَأْدَ  الْبَنَاتِ  ،  وَمَنْعٍ  وَهَاتِ ، وَكَرِهَ لَكُمْ  قِيلَ  وَقَالَ ، وَكَثْرَةَ  السُّؤَالِ  ، وَإِضَاعَةَ الْمَالِ  .","","Al-Mu'jam al-Kabir 901","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن الشعبي عن منصور بن المعتمر عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","الشعبي عن وراد مولى المغيرة عن المغيرة"
"19081","902  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْحَسَنِ الْمِصِّيصِيُّ ،  ثَنَا  الْحَسَنُ بْنُ مُوسَى الْأَشْيَبُ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مَنْصُورٍ الطُّوسِيُّ ،  ثَنَا  الْحَسَنُ بْنُ مُوسَى الْأَشْيَبُ ،  ثَنَا  شَيْبَانُ ،  عَنْ  عَاصِمِ بْنِ أَبِي النَّجُودِ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  وَرَّادٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ تَعَالَى كَرِهَ  قِيلَ  وَقَالَ ، وَكَثْرَةَ  السُّؤَالِ  ، وَإِضَاعَةَ الْمَالِ ، وَنَهَى عَنْ  وَأْدِ  الْبَنَاتِ ،  وَعُقُوقِ  الْأُمَّهَاتِ ،  وَمَنْعٍ  وَهَاتِ  .","","Al-Mu'jam al-Kabir 902","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن الشعبي عن عاصم بن بهدلة عن شيبان بن عبد الرحمن المؤدب عن الحسن بن موسى الأشيب عن محمد بن منصور الطوسي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","الشعبي عن وراد مولى المغيرة عن المغيرة"
"19082","903  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ ،  ثَنَا  آدَمُ بْنُ أَبِي إِيَاسٍ ،  ثَنَا  شَيْبَانُ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ الْأَصْبَهَانِيُّ ،  ثَنَا  أَبُو مَسْعُودٍ أَحْمَدُ بْنُ الْفُرَاتِ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  شَيْبَانُ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  وَرَّادٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ كَرِهَ لَكُمْ ثَلَاثًا :  قِيلَ  وَقَالَ ، وَكَثْرَةَ  السُّؤَالِ  ، وَإِضَاعَةَ الْمَالِ ، وَحَرَّمَ  عُقُوقَ  الْأُمَّهَاتِ ،  وَوَأْدَ  الْبَنَاتِ ،  وَمَنْعٍ  وَهَاتِ  .","","Al-Mu'jam al-Kabir 903","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن الشعبي عن منصور بن المعتمر عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن أحمد بن الفرات الضبي عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","الشعبي عن وراد مولى المغيرة عن المغيرة"
"19083","904  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  مُجَالِدٍ ،  عَنْ  عَامِرٍ ،  عَنْ  وَرَّادٍ ،  عَنِ  الْمُغِيرَةِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 904","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن الشعبي عن مجالد بن سعيد عن عبد الله بن نمير عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","الشعبي عن وراد مولى المغيرة عن المغيرة"
"19084","905  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  مُوسَى بْنُ سُفْيَانَ         [20/386]      الْجُنْدَيْسَابُورِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْجَهْمِ ،  ثَنَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  وَرَّادٍ ،  عَنِ  الْمُغِيرَةِ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ عَلَى نَفَرٍ مِنَ  الْأَنْصَارِ  يَرْمُونَ حَمَامَةً ، فَقَالَ :  لَا تَتَّخِذُوا الرُّوحَ غَرَضًا  .","","Al-Mu'jam al-Kabir 905","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن الشعبي عن منصور بن المعتمر عن عمرو بن أبي قيس عن عبد الله بن الجهم الرازي عن موسى بن سفيان الجند يسابوري عن أحمد بن يحيى بن زهير التستري عن الطبراني","الشعبي عن وراد مولى المغيرة عن المغيرة"
"19085","الْمُسَيِّبُ بْنُ رَافِعٍ  ، عَنْ  وَرَّادٍ  906  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  أَبِي  ،  ثَنَا  شُعْبَةُ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  وَرَّادٍ ،  عَنِ  الْمُغِيرَةِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا انْصَرَفَ مِنَ الصَّلَاةِ قَالَ : "" لَا إِلَهَ إِلَّا اللهُ  ...  . فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 906","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن المسيب بن رافع الكاهلي عن منصور بن المعتمر عن شعبة بن الحجاج عن المثنى بن معاذ بن معاذ العنبري عن معاذ بن المثنى العنبري عن الطبراني","المسيب بن رافع عن وراد"
"19086","907  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  أَبِي ،  ثَنَا  أَبِي  ،  ثَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ،  عَنِ  الْقَاسِمِ بْنِ مُخَيْمِرَةَ ،  عَنْ  وَرَّادٍ كَاتِبِ الْمُغِيرَةِ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، نَحْوَ حَدِيثِ  مَنْصُورٍ  .","","Al-Mu'jam al-Kabir 907","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن القاسم بن مخيمرة عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن المثنى بن معاذ بن معاذ العنبري عن معاذ بن المثنى العنبري عن الطبراني","المسيب بن رافع عن وراد"
"19087","عَبْدُ الْمَلِكِ بْنُ عُمَيْرٍ  ، عَنْ  وَرَّادٍ  908  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  أَخْبَرَنِي  وَرَّادٌ ، كَاتِبُ الْمُغِيرَةِ ، قَالَ :  كَتَبَ  الْمُغِيرَةُ إِلَى  مُعَاوِيَةَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقُولُ دُبُرَ الصَّلَاةِ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ ، وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ  .","","Al-Mu'jam al-Kabir 908","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن عبد الملك بن عمير القبطي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الملك بن عمير عن وراد"
"19088","909  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  وَرَّادٍ ، كَاتِبِ الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  كَتَبَ  مُعَاوِيَةُ بْنُ أَبِي سُفْيَانَ  إِلَى الْمُغِيرَةِ : أَنِ اكْتُبْ إِلَيَّ بِشَيْءٍ مِنْ حَدِيثِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فَكَتَبَ إِلَيْهِ  : إِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ         [20/387]      وَسَلَّمَ  يَتَعَوَّذُ مِنْ ثَلَاثٍ : مِنْ  عُقُوقِ  الْأُمَّهَاتِ ، وَمِنْ  وَأْدِ  الْبَنَاتِ ، وَمِنْ مَنْعٍ وَهَاتِ  ، وَسَمِعْتُهُ  نَهَى عَنْ ثَلَاثٍ : عَنْ  قِيلَ  وَقَالَ ، وَإِضَاعَةِ الْمَالِ  ، وَكَثْرَةِ  السُّؤَالِ  "" ، وَسَمِعْتُهُ يَقُولُ : "" اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .","","Al-Mu'jam al-Kabir 909","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن عبد الملك بن عمير القبطي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عبد الملك بن عمير عن وراد"
"19089","910  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  شَرِيكٌ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  وَرَّادٍ ، مَوْلَى الْمُغِيرَةِ بْنِ شُعْبَةَ ،  عَنِ  الْمُغِيرَةِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَ حَدِيثِ  مَعْمَرٍ  .","","Al-Mu'jam al-Kabir 910","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن عبد الملك بن عمير القبطي عن شريك بن عبد الله النخعي عن يزيد بن هارون عن إدريس بن جعفر العطار عن الطبراني","عبد الملك بن عمير عن وراد"
"19090","911  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  وَرَّادٍ ،  عَنِ  الْمُغِيرَةِ ،  أَنَّهُ كَتَبَ إِلَى  مُعَاوِيَةَ  : أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا سَلَّمَ قَالَ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ ، وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ  ، اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .","","Al-Mu'jam al-Kabir 911","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن عبد الملك بن عمير القبطي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن أحمد بن عمرو بن حفص القريعي عن الطبراني","عبد الملك بن عمير عن وراد"
"19091","912  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  وَرَّادٍ ، قَالَ :  كَتَبَ  الْمُغِيرَةُ إِلَى  مُعَاوِيَةَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقُولُ دُبُرَ الصَّلَاةِ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ،  اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .","","Al-Mu'jam al-Kabir 912","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن عبد الملك بن عمير القبطي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","عبد الملك بن عمير عن وراد"
"19092","913  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ الْجُذُوعِيُّ الْقَاضِي ،  ثَنَا  أَبُو كَامِلٍ الْجَحْدَرِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  وَرَّادٍ ، كَاتِبِ الْمُغِيرَةِ  أَنَّ  مُعَاوِيَةَ  ، كَتَبَ إِلَى الْمُغِيرَةِ : أَنِ اكْتُبْ إِلَيَّ بِشَيْءٍ سَمِعْتَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فَكَتَبَ إِلَيْهِ  : "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى         [20/388]      عَنْ  قِيلَ  وَقَالَ ، وَكَثْرَةِ  السُّؤَالِ  ، وَإِضَاعَةِ الْمَالِ  ، وَعَنْ  عُقُوقِ  الْأُمَّهَاتِ ،  وَوَأْدِ  الْبَنَاتِ ،  وَمَنْعٍ  وَهَاتِ  .","","Al-Mu'jam al-Kabir 913","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن عبد الملك بن عمير القبطي عن الوضاح بن عبد الله اليشكري عن فضيل بن حسين الجحدري عن الجذوعى محمد بن محمد بن إسماعيل عن الطبراني","عبد الملك بن عمير عن وراد"
"19093","914  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ، وَأَبُو خَلِيفَةَ ، قَالَا :  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ، وَعِنْدَهُ ابْنُ أَبِي لُبَابَةَ ،  سَمِعَا  وَرَّادًا ، كَاتِبَ الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  كَتَبَ  مُعَاوِيَةُ  إِلَى الْمُغِيرَةِ : اكْتُبْ إِلَيَّ بِشَيْءٍ سَمِعْتَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ فِي دُبُرِ الصَّلَاةِ ،  قَالَ  : كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ فِي دُبُرِ صَلَاتِهِ :  لَا إِلَهَ إِلَّا اللهُ ، وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ ، وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ،  اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .","","Al-Mu'jam al-Kabir 914","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن عبدة بن أبي لبابة عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","عبد الملك بن عمير عن وراد"
"19094","915  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ سَعْدِ بْنِ يَحْيَى الرَّقِّيُّ ،  ثَنَا  أَبُو فَرْوَةَ يَزِيدُ بْنُ سِنَانٍ الرَّهَاوِيُّ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  وَرَّادٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ فِي دُبُرِ الصَّلَاةِ ، فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 915","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن عبد الملك بن عمير القبطي عن زيد بن أبي أنيسة الجزري عن يزيد بن سنان الرهاوي عن محمد بن يزيد بن سنان بن يزيد الرهاوي عن يزيد بن محمد ابن يزيد الرهاوي عن عبد الله بن سعد بن يحيى الكريزي عن الطبراني","عبد الملك بن عمير عن وراد"
"19095","916  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  أَسْبَاطُ بْنُ مُحَمَّدٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  وَرَّادٍ ،  عَنِ  الْمُغِيرَةِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 916","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن عبد الملك بن عمير القبطي عن أسباط بن محمد بن ميسرة القرشي عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","عبد الملك بن عمير عن وراد"
"19096","917  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  الْحَكَمُ بْنُ هِشَامٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  وَرَّادٍ ،  عَنِ  الْمُغِيرَةِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 917","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن عبد الملك بن عمير القبطي عن الحكم بن هشام العقيلي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","عبد الملك بن عمير عن وراد"
"19097","918  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْخَلَّالُ الْمَكِّيُّ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  وَرَّادٍ ،  عَنِ  الْمُغِيرَةِ بْنِ         [20/389]      شُعْبَةَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَقُولُ دُبُرَ الصَّلَاةِ إِذَا سَلَّمَ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ،  اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .","","Al-Mu'jam al-Kabir 918","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن عبد الملك بن عمير القبطي عن سفيان الثوري عن وكيع بن الجراح عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","عبد الملك بن عمير عن وراد"
"19098","919  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ حُمَيْدٍ الرَّازِيُّ ،  ثَنَا  الْحَكَمُ بْنُ بَشِيرٍ ،  ثَنَا  عَمْرُو بْنُ قَيْسٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  وَرَّادٍ قَالَ :  كَتَبَ  مُعَاوِيَةُ  إِلَى الْمُغِيرَةِ : أَنِ اكْتُبْ إِلَيَّ بِشَيْءٍ سَمِعْتَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فَكَتَبَ إِلَيْهِ  بِخَطِّي  : أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقُولُ حِينَ يَنْصَرِفُ مِنَ الصَّلَاةِ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ،  اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  "" . وَكَتَبَ إِلَيْهِ فِي الْكِتَابِ : أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ تَعَالَى كَرِهَ لَكُمْ ثَلَاثًا :  وَأْدَ  الْبَنَاتِ ،  وَعُقُوقَ  الْأُمَّهَاتِ ،  وَمَنْعٍ  وَهَاتِ  ،  وَكَانَ يَنْهَى عَنْ  قِيلَ  وَقَالَ ، وَكَثْرَةِ  السُّؤَالِ  ، وَإِضَاعَةِ الْمَالِ  .","","Al-Mu'jam al-Kabir 919","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن عبد الملك بن عمير القبطي عن عمرو بن قيس الملائي عن الحكم بن  أبى إسماعيل النهدي عن محمد بن حميد الرازي عن الحسين بن إسحاق التستري عن الطبراني","عبد الملك بن عمير عن وراد"
"19099","920  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  يَحْيَى بْنُ حَسَّانَ الْكُوفِيُّ ،  ثَنَا  مَالِكُ بْنُ سُعَيْرِ بْنِ الْخِمْسِ  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ، وَالْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  وَرَّادٍ ،  عَنِ  الْمُغِيرَةِ ، نَحْوَهُ .  في طبعة مكتبة ابن تيمية : (مالك بن سعيد بن الحسن) والمثبت من النسخة الخطية ، والله أعلم .","","Al-Mu'jam al-Kabir 920","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن المسيب بن رافع الكاهلي عن الأعمش عن مالك بن سعير التميمي عن يحيى بن حسان بن سهيل الحرشي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عبد الملك بن عمير عن وراد"
"19100","921  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ، (  ح  )         [20/390]      وَحَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْخُزَاعِيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالُوا :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  وَرَّادٍ كَاتِبِ الْمُغِيرَةِ بْنِ شُعْبَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ قَالَ :  قَالَ  سَعْدُ بْنُ عُبَادَةَ  : لَوْ رَأَيْتُ رَجُلًا مَعَ امْرَأَتِي لَضَرَبْتُهُ بِالسَّيْفِ ، فَبَلَغَ ذَلِكَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  أَتَعْجَبُونَ مِنْ غَيْرَةِ  سَعْدٍ  ؟ فَوَاللهِ لَأَنَا أَغْيَرُ مِنْ  سَعْدٍ  ، وَاللهُ أَغْيَرُ مِنِّي  ، وَمِنْ أَجْلِ ذَلِكَ حَرَّمَ الْفَوَاحِشَ مَا ظَهَرَ وَمَا بَطَنَ مِنْهَا ، وَلَا  شَخْصَ  أَحَبُّ إِلَيْهِ الْعُذْرُ مِنَ اللهِ عَزَّ وَجَلَّ ، مِنْ أَجْلِ ذَلِكَ بَعَثَ رُسُلَهُ مُبَشِّرِينَ وَمُنْذِرِينَ ، وَلَا  شَخْصَ  أَحَبُّ إِلَيْهِ الْمِدْحَةُ مِنَ اللهِ عَزَّ وَجَلَّ ، وَمِنْ ذَلِكَ وَعَدَ الْجَنَّةَ  .  وَاللَّفْظُ لِحَدِيثِ  أَبِي الْوَلِيدِ  .","","Al-Mu'jam al-Kabir 921","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن عبد الملك بن عمير القبطي عن الوضاح بن عبد الله اليشكري عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","عبد الملك بن عمير عن وراد"
"19101","922  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  حُسَيْنُ بْنُ عَلِيٍّ ،  عَنْ  زَائِدَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  وَرَّادٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ قَالَ :  بَلَغَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّ  سَعْدَ بْنَ عُبَادَةَ  يَقُولُ : لَوْ وَجَدْتُ مَعَهَا رَجُلًا لَضَرَبْتُهُ بِالسَّيْفِ غَيْرَ  مُصْفِحٍ ،  فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَتَعْجَبُونَ مِنْ غَيْرَةِ  سَعْدٍ  ؟ فَوَاللهِ  ... "" فَذَكَرَ نَحْوَ الْحَدِيثِ .","","Al-Mu'jam al-Kabir 922","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن عبد الملك بن عمير القبطي عن زائدة بن قدامة عن الحسين بن علي الجعفي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبد الملك بن عمير عن وراد"
"19102","923  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ ، وَعَبْدَانُ بْنُ أَحْمَدَ قَالَا :  ثَنَا  هِشَامُ بْنُ عَمَّارٍ قَالَا :  ثَنَا  الْحَكَمُ بْنُ هِشَامٍ الثَّقَفِيُّ ،  حَدَّثَنِي  عَبْدُ الْمَلِكِ بْنُ عُمَيْرٍ ،  عَنْ  وَرَّادٍ ، مَوْلَى الْمُغِيرَةِ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ قَالَ :  سِرْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ         [20/391]      وَسَلَّمَ ، فَضَرَبَ بِيَدِهِ عَلَى عُنُقِ رَاحِلَتِي ، ثُمَّ قَالَ :  مَعَكَ مَاءٌ ؟ "" . قُلْتُ : نَعَمْ ، هَذِهِ  سَطِيحَةٌ  مِنْ مَاءٍ مَعِي  ، قَالَ : "" فَذَرْهَا "" ، ثُمَّ نَزَلَ فَقَضَى الْحَاجَةَ ثُمَّ أَتَانِي فَقَالَ : "" أَتُرِيدُ الْحَاجَةَ ؟ "" قُلْتُ : لَا ، قَالَ : "" فَغَسَلَ يَدَيْهِ ثَلَاثًا ، وَمَضْمَضَ ثَلَاثًا ، وَاسْتَنْشَقَ ثَلَاثًا ، ثُمَّ غَسَلَ وَجْهَهُ ثَلَاثًا ، ثُمَّ أَرَادَ أَنْ يُخْرِجَ ذِرَاعَيْهِ ، وَكَانَتْ عَلَيْهِ جُبَّةٌ مِنْ صُوفٍ ضَيِّقَةٌ ، لَمْ يَقْدِرْ أَنْ يُخْرِجَ ذِرَاعَيْهِ مِنْهَا ، فَأَخْرَجَ يَدَيْهِ مِنْ تَحْتِ الْجُبَّةِ ، ثُمَّ غَسَلَ ذِرَاعَيْهِ ثَلَاثًا ثَلَاثًا ، ثُمَّ مَسَحَ بِرَأْسِهِ وَمَسَحَ عَلَى الْخُفَّيْنِ ، ثُمَّ سِرْنَا فَلَحِقْنَا  الْقَوْمَ  يُصَلِّي بِهِمْ  عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  ، فَأَرَدْتُ أَنْ أُوذِنَهُ لِمَكَانِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَمَنَعَنِي ، فَصَلَّيْنَا مَعَهُ رَكْعَةً ، ثُمَّ قَضَيْنَا الثَّانِيَةَ  .  وَاللَّفْظُ لِحَدِيثِ  هِشَامِ بْنِ عَمَّارٍ  .","","Al-Mu'jam al-Kabir 923","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن عبد الملك بن عمير القبطي عن الحكم بن هشام العقيلي عن هشام بن عمار عن عبد الله بن أحمد الجواليقي عن الطبراني","عبد الملك بن عمير عن وراد"
"19103","عَبْدَةُ بْنُ أَبِي لُبَابَةَ  ، عَنْ  وَرَّادٍ مَوْلَى الْمُغِيرَةِ  ، عَنِ  الْمُغِيرَةِ  924  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  عَبْدَةُ بْنُ أَبِي لُبَابَةَ ، أَنَّ وَرَّادًا ، مَوْلَى الْمُغِيرَةِ بْنِ شُعْبَةَ  أَخْبَرَهُ  ،  أَنَّ  الْمُغِيرَةَ بْنَ شُعْبَةَ كَتَبَ إِلَى  مُعَاوِيَةَ  - كَتَبَ ذَلِكَ الْكِتَابَ لَهُ  وَرَّادٌ  - : إِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ حِينَ يُسَلِّمُ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ،  اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .","","Al-Mu'jam al-Kabir 924","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن عبدة بن أبي لبابة عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عبدة بن أبي لبابة عن وراد مولى المغيرة عن المغيرة"
"19104","الْمُسَيِّبُ بْنُ رَافِعٍ  ، عَنْ  وَرَّادٍ  925  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ قَالَا :  ثَنَا  مُسَدَّدٌ قَالُوا :  ثَنَا  أَبُو         [20/392]      مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  مَوْلَى الْمُغِيرَةِ بْنِ شُعْبَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،  كَتَبَ إِلَى  مُعَاوِيَةَ  : كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا سَلَّمَ مِنَ الصَّلَاةِ يَقُولُ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ  ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .","","Al-Mu'jam al-Kabir 925","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن المسيب بن رافع الكاهلي عن الأعمش عن أبو معاوية الضرير عن مسدد بن مسرهد عن أبو مسلم الكجي عن الطبراني","المسيب بن رافع عن وراد"
"19105","926  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ ،  ثَنَا  آدَمُ بْنُ أَبِي إِيَاسٍ ،  ثَنَا  شَيْبَانُ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  وَرَّادٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَقُولُ فِي دُبُرِ الصَّلَاةِ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ  وَهُوَ حَيٌّ لَا يَمُوتُ ، بِيَدِهِ الْخَيْرُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .","","Al-Mu'jam al-Kabir 926","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن المسيب بن رافع الكاهلي عن منصور بن المعتمر عن شيبان بن عبد الرحمن المؤدب عن آدم بن أبي إياس عن أبو زرعة الدمشقي عن الطبراني","المسيب بن رافع عن وراد"
"19106","927  -  حَدَّثَنَا  أَبُو زَيْدٍ أَحْمَدُ بْنُ وَهْبٍ الْوَاسِطِيُّ ،  ثَنَا  أَحْمَدُ بْنُ سِنَانٍ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  ثَنَا  أَبُو الْأَشْهَبِ جَعْفَرُ بْنُ الْحَارِثِ النَّخَعِيُّ ،  عَنْ  مَنْصُورِ بْنِ الْمُعْتَمِرِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  وَرَّادٍ قَالَ :  كَتَبَ  الْمُغِيرَةُ بْنُ شُعْبَةَ إِلَى  مُعَاوِيَةَ  : أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقُولُ إِذَا قَضَى الصَّلَاةَ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ  ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .","","Al-Mu'jam al-Kabir 927","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن المسيب بن رافع الكاهلي عن منصور بن المعتمر عن جعفر بن الحارث الواسطي عن يزيد بن هارون عن أحمد بن سنان القطان عن أحمد بن وهب الواسطي عن الطبراني","المسيب بن رافع عن وراد"
"19107","928  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْحَسَنِ الْعَطَّارُ الْبَصْرِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  ثَنَا  أَبِي  ،  ثَنَا  شُعْبَةُ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الْمُسَيِّبِ ،  عَنْ  وَرَّادٍ ،  عَنِ  الْمُغِيرَةِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 928","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن المسيب بن رافع الكاهلي عن منصور بن المعتمر عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن سليمان بن الحسن العطار عن الطبراني","المسيب بن رافع عن وراد"
"19108","[20/393]      سُلَيْمُ بْنُ عَبْدِ الرَّحْمَنِ  ، عَنْ  وَرَّادٍ  929  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ،  ثَنَا  مَحْمُودُ بْنُ خَالِدٍ الدِّمَشْقِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  عِيسَى بْنُ الْمُسَيِّبِ ،  عَنْ  سَلْمِ بْنِ عَبْدِ الرَّحْمَنِ النَّخَعِيِّ ،  عَنْ  وَرَّادٍ ، كَاتِبِ الْمُغِيرَةِ بْنِ شُعْبَةَ  أَنَّ  مُعَاوِيَةَ  ، كَتَبَ إِلَى الْمُغِيرَةِ يَسْأَلُهُ عَنْ آخِرِ مَا كَانَ يَتَكَلَّمُ بِهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فَكَتَبَ إِلَيْهِ  أَنَّهُ كَانَ يَقُولُ إِذَا سَلَّمَ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ  وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  "" بَعْدَ أَنْ يُسَلِّمَ عَنْ يَمِينِهِ وَعَنْ شِمَالِهِ ، وَكَانَ يُسَلِّمُ عَنْ يَمِينِهِ حَتَّى يُرَى بَيَاضُ خَدِّهِ الْأَيْمَنِ ، وَعَنْ يَسَارِهِ حَتَّى يُرَى بَيَاضُ خَدِّهِ الْأَيْسَرِ  .","","Al-Mu'jam al-Kabir 929","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن سلم بن عبد الرحمن النخعي عن عيسى بن المسيب البجلي عن خالد بن يزيد الأزرق عن محمود بن خالد بن أبي خالد السلمي عن الحسن بن علي بن شبيب المعمري عن الطبراني","سليم بن عبد الرحمن عن وراد"
"19109","عَطَاءُ بْنُ السَّائِبِ  ، عَنْ  وَرَّادٍ  930  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ الْوَشَّاءُ الْأَصْبَهَانِيُّ ،  ثَنَا  طَالُوتُ بْنُ عَبَّادٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  وَرَّادٍ ، مَوْلَى الْمُغِيرَةِ بْنِ شُعْبَةَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِيَّاكُمْ وَقِيلَ وَقَالَ ،  وَمَنَعَ  وَهَاتِ  ،  وَعُقُوقَ  الْأُمَّهَاتِ ،  وَوَأْدَ  الْبَنَاتِ ، وَإِضَاعَةَ الْمَالِ  .","","Al-Mu'jam al-Kabir 930","","وراد الثقفي كاتب المغيرة بن شعبة عن عطاء بن السائب عن حماد بن سلمة عن طالوت بن عباد الجحدري عن محمد بن إبراهيم بن سعيد الوشاء عن الطبراني","عطاء بن السائب عن وراد"
"19110","عَبْدَةُ بْنُ أَبِي لُبَابَةَ  ، عَنْ  وَرَّادٍ  931  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَمْزَةَ الدِّمَشْقِيُّ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ  ،  حَدَّثَنِي  النُّعْمَانُ بْنُ الْمُنْذِرِ ،  أَنَّ  عَبْدَةَ بْنَ أَبِي لُبَابَةَ ،         [20/394]      حَدَّثَنِي  وَرَّادٌ ، مَوْلَى الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  أَمَرَنِي  الْمُغِيرَةُ أَنْ أَكْتُبَ ، إِلَى  مُعَاوِيَةَ  : أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقُولُ فِي دُبُرِ كُلِّ صَلَاةٍ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ ، وَلَهُ الْحَمْدُ  ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .","","Al-Mu'jam al-Kabir 931","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن عبدة بن أبي لبابة عن النعمان بن المنذر الغساني عن يحيى بن حمزة بن البتلهي عن محمد بن يحيى بن حمزة الحضرمي عن أحمد بن محمد بن يحيى البتلهي عن الطبراني","عبدة بن أبي لبابة عن وراد"
"19111","مَكْحُولٌ الشَّامِيُّ  ، عَنْ  وَرَّادٍ  932  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَمْزَةَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ  ،  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي مَرْيَمَ ، أَنَّ مَكْحُولًا  حَدَّثَهُمْ  ،  عَنْ  مَوْلَى الْمُغِيرَةِ بْنِ شُعْبَةَ - حَسِبْتُ أَنَّهُ سَمَّاهُ وَرَّادًا  -  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، بِهَذَا الْحَدِيثِ .","","Al-Mu'jam al-Kabir 932","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن مكحول بن أبي مسلم عن يزيد بن أبي مريم الدمشقي عن يحيى بن حمزة بن البتلهي عن محمد بن يحيى بن حمزة الحضرمي عن أحمد بن محمد بن يحيى البتلهي عن الطبراني","مكحول الشامي عن وراد"
"19112","933  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  أَبُو عَوْنٍ الزِّيَادِيُّ ،  ثَنَا  مُبَشِّرُ بْنُ مُكَسِّرٍ ،  عَنِ  ابْنِ عَجْلَانَ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَرَّادٍ ، مَوْلَى الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّ  مُعَاوِيَةَ  كَتَبَ إِلَى الْمُغِيرَةِ يَسْأَلُهُ مَا كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ إِذَا انْصَرَفَ مِنَ الصَّلَاةِ ؟  فَكَتَبَ إِلَيْهِ  الْمُغِيرَةُ  أَنَّهُ كَانَ يَقُولُ إِذَا سَلَّمَ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ  ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .","","Al-Mu'jam al-Kabir 933","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن مكحول بن أبي مسلم عن محمد بن عجلان عن مبشر بن مكسر القيسي عن محمد بن عون الزيادي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","مكحول الشامي عن وراد"
"19113","أَبُو سَعِيدٍ  ، عَنْ  وَرَّادٍ  934  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ قَالَا :  ثَنَا  مُسَدَّدٌ ،  ثَنَا  بِشْرُ بْنُ الْفَضْلِ  ،  ثَنَا  ابْنُ عَوْنٍ ،  عَنْ  أَبِي سَعِيدٍ قَالَ :  أَنْبَأَنِي  وَرَّادٌ ،         [20/395]      كَاتِبُ الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّ  مُعَاوِيَةَ  ، كَتَبَ إِلَى الْمُغِيرَةِ بْنِ شُعْبَةَ : أَنِ اكْتُبْ إِلَيَّ بِشَيْءٍ سَمِعْتَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فَكَتَبَ إِلَيْهِ  : كَانَ إِذَا صَلَّى فَفَرَغَ قَالَ :  لَا إِلَهَ إِلَّا اللهُ ، وَحْدَهُ لَا شَرِيكَ لَهُ - قَالَ  ابْنُ عَوْنٍ  :  فَأَظُنُّهُ قَالَ : - لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ  ، اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( بشر بن المفضل) كما في السنن الكبرى للنسائي (10965).","","Al-Mu'jam al-Kabir 934","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن أبو سعيد عن عبد الله بن عون بن أرطبان عن بشر بن المفضل عن مسدد بن مسرهد عن أبو مسلم الكجي عن الطبراني","أبو سعيد عن وراد"
"19114","935  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنِ  الْجُرَيْرِيِّ ، وَابْنِ عَوْنٍ ،  عَنِ  الْوَرَّادِ ،  عَنِ  الْمُغِيرَةِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ ،  وَلَمْ يَذْكُرْ  أَبَا سَعِيدٍ  .","","Al-Mu'jam al-Kabir 935","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن عبد الله بن عون بن أرطبان عن حماد بن سلمة عن هدبة بن خالد عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو سعيد عن وراد"
"19115","عَبْدُ رَبِّهِ  ، عَنْ  وَرَّادٍ  936  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدٌ ،  عَنْ  سَعِيدٍ الْجُرَيْرِيِّ ،  عَنْ  عَبْدِ رَبِّهِ ،  عَنْ  كَاتِبِ الْمُغِيرَةِ ،  أَنَّ  الْمُغِيرَةَ ، كَتَبَ إِلَى  مُعَاوِيَةَ  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقُولُ فِي دُبُرِ صَلَاتِهِ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ  ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .","","Al-Mu'jam al-Kabir 936","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن أبو سعيد عن سعيد بن إياس الجريري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","عبد ربه عن وراد"
"19116","رَجَاءُ بْنُ حَيْوَةَ  ، عَنْ  وَرَّادٍ  937  -  حَدَّثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  رَجَاءِ بْنِ حَيْوَةَ ،  عَنْ  كَاتِبِ الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ  كَتَبَ إِلَى الْمُغِيرَةِ يَسْأَلُهُ :         [20/396]      هَلْ سَمِعْتَ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ شَيْئًا يَقُولُ : دُبُرَ الصَّلَاةِ ؟  فَقَالَ  الْمُغِيرَةُ بْنُ شُعْبَةَ  : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : دُبُرَ الصَّلَاةِ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ . اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ  ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .","","Al-Mu'jam al-Kabir 937","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن رجاء بن حيوة عن محمد بن عجلان عن سليمان بن بلال القرشي عن إسماعيل بن أبي أويس عن علي بن محمد بن عبد الله الصنعاني عن الطبراني","رجاء بن حيوة عن وراد"
"19117","938  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْمُعَافَى بْنِ سُلَيْمَانَ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  الْقَاسِمُ بْنُ مَعْنٍ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  رَجَاءِ بْنِ حَيْوَةَ ،  عَنْ  كَاتِبِ الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  كَتَبَ  مُعَاوِيَةُ  إِلَى الْمُغِيرَةِ بْنِ شُعْبَةَ : هَلْ كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ شَيْئًا بَعْدَ الصَّلَاةِ ؟  قَالَ  : كَانَ يَقُولُ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ  وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .","","Al-Mu'jam al-Kabir 938","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن رجاء بن حيوة عن محمد بن عجلان عن القاسم بن معن عن المعافى بن سليمان الرسعني عن سليمان بن المعافى الرسعني عن الطبراني","رجاء بن حيوة عن وراد"
"19118","939  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْهَيْثَمُ بْنُ خَارِجَةَ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  ثَوْرِ بْنِ يَزِيدَ ،  عَنْ  رَجَاءِ بْنِ حَيْوَةَ ،  عَنْ  كَاتِبِ الْمُغِيرَةِ ،  عَنِ  الْمُغِيرَةِ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" مَسَحَ عَلَى أَعْلَى الْخُفِّ وَأَسْفَلِهِ  .","","Al-Mu'jam al-Kabir 939","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن رجاء بن حيوة عن ثور بن يزيد الكلاعي عن الوليد بن مسلم القرشي عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","رجاء بن حيوة عن وراد"
"19119","رِوَايَةُ  الْكُوفِيِّينَ  ، عَنِ  الْمُغِيرَةِ  أَبُو عَوْنٍ مُحَمَّدُ بْنُ عُبَيْدِ اللهِ الثَّقَفِيُّ  ، عَنْ  وَرَّادٍ  940  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  وَثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ قَالَا :  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِسْمَاعِيلَ ،  عَنِ  الشَّيْبَانِيِّ ،         [20/397]      عَنْ  مُحَمَّدِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  وَرَّادٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ قَالَ :  أُتِيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِامْرَأَةٍ  ضَرَبَتْ ضَرَّتَهَا بِعَمُودٍ فَقَتَلَتْهَا ، وَقَتَلَتْ مَا فِي بَطْنِهَا ، فَجَعَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَقْلَهَا عَلَى عَصَبَةِ الْمَرْأَةِ ، وَفِي الْجَنِينِ  غُرَّةٌ  ؛ عَبْدٌ أَوْ أَمَةٌ ، فَقَامَ  رَجُلٌ  مِنَ  الْقَوْمِ  فَقَالَ : يَا رَسُولَ اللهِ ، كَيْفَ نَدِي مَنْ لَا أَكَلَ وَلَا شَرِبَ وَلَا صَاحَ وَلَا  اسْتَهَلَّ  ؟ فَقَالَ :  إِنَّ هَذَا لَيَقُولُ بِقَوْلِ  كَاهِنٍ  ، فِيهِ  غُرَّةٌ  ؛ عَبْدٌ أَوْ أَمَةٌ  .","","Al-Mu'jam al-Kabir 940","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن محمد بن عبيد الله بن سعيد الثقفي عن سليمان بن فيروز الشيباني عن عبد الله بن إسماعيل بن أبي خالد الكوفي عن أبو كريب محمد بن العلاء عن علي بن سعيد بن بشير عليك عن الطبراني","أبو عون محمد بن عبيد الله الثقفي عن وراد"
"19120","941  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  ثَنَا  خَالِدٌ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنْ  مُحَمَّدِ بْنِ عُبَيْدِ اللهِ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .  وَلَمْ يَذْكُرْ  وَرَّادًا  .","","Al-Mu'jam al-Kabir 941","","المغيرة بن شعبة عن محمد بن عبيد الله بن سعيد الثقفي عن سليمان بن فيروز الشيباني عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","أبو عون محمد بن عبيد الله الثقفي عن وراد"
"19121","942  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَعْلَى بْنُ عُبَيْدٍ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ جَعْفَرٍ الْقَتَّاتُ الْكُوفِيُّ ،  ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ، (  ح  )  وَحَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ كُلُّهُمْ ،  عَنْ  مُحَمَّدِ بْنِ سُوقَةَ ،  عَنْ  أَبِي عَوْنٍ مُحَمَّدِ بْنِ عُبَيْدِ اللهِ الثَّقَفِيِّ ،  عَنْ  وَرَّادٍ ، مَوْلَى الْمُغِيرَةِ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَرَّمَ ثَلَاثًا :  عُقُوقَ  الْأُمَّهَاتِ ،  وَوَأْدَ  الْبَنَاتِ ،  وَمَنْعٍ  وَهَاتِ ، وَنَهَى عَنْ  قِيلَ  وَقَالَ : وَكَثْرَةِ  السُّؤَالِ  ، وَإِضَاعَةِ الْمَالِ  .","","Al-Mu'jam al-Kabir 942","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن محمد بن عبيد الله بن سعيد الثقفي عن محمد بن سوقة الغنوي عن مروان بن معاوية الفزاري عن إبراهيم بن سعيد الجوهري عن الساجي عن الطبراني","أبو عون محمد بن عبيد الله الثقفي عن وراد"
"19122","943  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ الْأَصْبَهَانِيُّ ،  ثَنَا  الْحُسَيْنُ بْنُ عِيسَى بْنِ مَيْسَرَةَ الرَّازِيُّ ،  ثَنَا  الْفُرَاتُ بْنُ خَالِدٍ ،  ثَنَا  مَالِكُ بْنُ مِغْوَلٍ ، قَالَ :  سَمِعْتُ  أَبَا عَوْنٍ مُحَمَّدَ بْنَ عُبَيْدِ اللهِ الثَّقَفِيَّ  يُحَدِّثُ ، عَنْ  وَرَّادٍ ، مَوْلَى الْمُغِيرَةِ بْنِ شُعْبَةَ ،         [20/398]      أَنَّ  مُعَاوِيَةَ  كَتَبَ إِلَيْهِ يَسْأَلُهُ عَمَّا سَمِعَ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فَكَتَبَ إِلَيْهِ  ،  قَالَ  : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ اللهَ عَزَّ وَجَلَّ كَرِهَ لَكُمْ ثَلَاثًا :  عُقُوقَ  الْأُمَّهَاتِ  ،  وَوَأْدَ  الْبَنَاتِ ،  وَمَنْعٍ  وَهَاتِ ، وَقِيلَ وَقَالَ ، وَكَثْرَةَ  السُّؤَالِ  ، وَإِضَاعَةَ الْمَالِ  .","","Al-Mu'jam al-Kabir 943","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن محمد بن عبيد الله بن سعيد الثقفي عن مالك بن مغول الصهيبي عن فرات بن خالد الرازي عن الحسين بن عيسى الحارثي عن محمد بن شعيب التاجر عن الطبراني","أبو عون محمد بن عبيد الله الثقفي عن وراد"
"19123","مَسْرُوقُ بْنُ الْأَجْدَعِ  ، عَنِ  الْمُغِيرَةِ  944  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مَسْرُوقٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  كُنْتُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ فَقَالَ :  يَا  مُغِيرَةُ  ، خُذِ  الْإِدَاوَةَ  "" ، فَأَخَذْتُهَا ثُمَّ خَرَجْتُ مَعَهُ  ، فَانْطَلَقَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى تَوَارَى عَنِّي فَقَضَى حَاجَتَهُ ، ثُمَّ جَاءَ وَعَلَيْهِ جُبَّةٌ شَامِيَّةٌ ضَيِّقَةُ الْكُمَّيْنِ ، فَذَهَبَ لِيُخْرِجَ يَدَهُ مِنْ كُمِّهَا ، فَضَاقَتْ وَأَخْرَجَ يَدَهُ مِنْ أَسْفَلِهَا ، فَصَبَبْتُ عَلَيْهِ ، فَتَوَضَّأَ وُضُوءَهُ لِلصَّلَاةِ وَمَسَحَ عَلَى خُفَّيْهِ ، ثُمَّ صَلَّى  .","","Al-Mu'jam al-Kabir 944","","المغيرة بن شعبة عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن أبو معاوية الضرير عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","مسروق بن الأجدع عن المغيرة"
"19124","945  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّهُ  وَضَّأَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" فَتَوَضَّأَ فَمَسَحَ عَلَى خُفَّيْهِ  وَعَلَى  الْخِمَارِ  .","","Al-Mu'jam al-Kabir 945","","المغيرة بن شعبة عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن حماد بن أسامة القرشي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","مسروق بن الأجدع عن المغيرة"
"19125","946  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ زِيَادٍ الْأُبُلِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ جَهْضَمٍ ،  ثَنَا  يَزِيدُ بْنُ عَطَاءٍ ،  عَنْ  حُرَيْثٍ ،         [20/399]      عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَتَبَرَّزَ فَتَبِعْتُهُ مَعِي  إِدَاوَةٌ  مِنْ مَاءٍ  ، فَلَمَّا فَرَغَ أَخَذْتُ أَصُبُّ عَلَيْهِ فَغَسَلَ وَجْهَهُ وَعَلَيْهِ جُبَّةٌ  رُومِيَّةٌ - أَوْ شَامِيَّةٌ  - فَضَاقَ كُمُّهَا فَأَخْرَجَ يَدَهُ مِنْ أَسْفَلِهَا ، فَغَسَلَ ذِرَاعَيْهِ وَمَسَحَ عَلَى الْعِمَامَةِ وَالْخُفَّيْنِ  .","","Al-Mu'jam al-Kabir 946","","المغيرة بن شعبة عن مسروق بن الأجدع عن الشعبي عن حريث بن أبي مطر الفزاري عن يزيد بن عطاء بن يزيد اليشكري عن محمد بن جهضم اليمامي عن إسماعيل بن زياد الأبلي عن محمد بن العباس ابن الأخرم عن الطبراني","مسروق بن الأجدع عن المغيرة"
"19126","قَيْسُ بْنُ أَبِي حَازِمٍ  ، عَنِ  الْمُغِيرَةِ  الْمُغِيرَةُ بْنُ شِبْلٍ  ، عَنْ  قَيْسٍ  947  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  جَابِرٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شِبْلٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا  سَهَا  الْإِمَامُ فَاسْتَتَمَّ قَائِمًا فَعَلَيْهِ سَجْدَتَا السَّهْوِ  ، وَإِذَا لَمْ يَسْتَتِمَّ قَائِمًا فَلَا سَهْوَ عَلَيْهِ  .","","Al-Mu'jam al-Kabir 947","","المغيرة بن شعبة عن قيس بن أبي حازم عن المغيرة بن شبل الأحمسي عن جابر الجعفي عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","المغيرة بن شبل عن قيس"
"19127","بَيَانُ بْنُ بِشْرٍ  ، عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ  948  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  جُمْهُورُ بْنُ مَنْصُورٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ مُجَالِدٍ ،  عَنْ  بَيَانٍ ،  عَنْ  قَيْسٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  مَا سُئِلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الدَّجَّالِ  أَكْثَرَ مِمَّا سَأَلْتُهُ ، فَقَالَ : "" مَا تَصْنَعُ ؟ لَيْسَ بِضَارِّكَ "" ، قُلْتُ : أَلَا أَقْتُلُ  ابْنَ صَيَّادٍ  ؟ قَالَ : "" مَا تَصْنَعُ بِقَتْلِهِ ؟  إِنْ كَانَ هُوَ  الدَّجَّالُ  فَلَنْ تَخْلُصَ إِلَى قَتْلِهِ  ، وَإِنْ لَمْ يَكُنِ  الدَّجَّالَ  فَمَا تَصْنَعُ بِهِ . ؟","","Al-Mu'jam al-Kabir 948","","المغيرة بن شعبة عن قيس بن أبي حازم عن بيان بن بشر الأحمسي عن إسماعيل بن مجالد بن سعيد الهمداني عن جمهور بن منصور عن محمد بن عبد الله مطين الحضرمي عن الطبراني","بيان بن بشر عن قيس بن أبي حازم"
"19128","[20/400]      949  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  إِسْحَاقُ الْأَزْرَقُ ،  عَنْ  شَرِيكٍ ،  عَنْ  بَيَانٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  كُنَّا نُصَلِّي مَعَ نَبِيِّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَاةَ الظُّهْرِ بِالْهَاجِرَةِ ، فَقَالَ لَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَبْرِدُوا  بِالصَّلَاةِ ، فَإِنَّ شِدَّةَ الْحَرِّ مِنْ  فَيْحِ  جَهَنَّمَ  .","","Al-Mu'jam al-Kabir 949","","المغيرة بن شعبة عن قيس بن أبي حازم عن بيان بن بشر الأحمسي عن شريك بن عبد الله النخعي عن إسحاق بن يوسف الأزرق عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","بيان بن بشر عن قيس بن أبي حازم"
"19129","إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ  ، عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ  950  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  مَا سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الدَّجَّالِ  أَحَدٌ أَكْثَرَ مِمَّا سَأَلْتُهُ ، فَقَالَ نَبِيُّ اللهِ :  مَا سُؤَالُكَ عَنْهُ ؟ إِنَّهُ لَا يَضُرُّكَ  .","","Al-Mu'jam al-Kabir 950","","المغيرة بن شعبة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يزيد بن هارون عن إدريس بن جعفر العطار عن الطبراني","إسماعيل بن أبي خالد عن قيس بن أبي حازم"
"19130","951  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ قَالَ :  مَا سَأَلَ أَحَدٌ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَكْثَرَ مِمَّا سَأَلْتُهُ أَنَا عَنْهُ -  يَعْنِي  الدَّجَّالَ  - فَقَالَ : "" إِنَّهُ لَا يَضُرُّكَ "" ، قُلْتُ : إِنَّهُمْ يَقُولُونَ : إِنَّ مَعَهُ نَهَرًا وَكَذَا ، قَالَ :  هُوَ أَهْوَنُ عَلَى اللهِ مِنْ ذَلِكَ  .","","Al-Mu'jam al-Kabir 951","","المغيرة بن شعبة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","إسماعيل بن أبي خالد عن قيس بن أبي حازم"
"19131","952  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  شِهَابُ بْنُ عَبَّادٍ الْعَبْدِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ حُمَيْدٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،         [20/401]      عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ قَالَ :  مَا سَأَلَ أَحَدٌ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الدَّجَّالِ  أَكْثَرَ مِمَّا سَأَلْتُهُ  ،  فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 952","","المغيرة بن شعبة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن إبراهيم بن حميد الرؤاسي عن شهاب بن عباد الرواس عن محمد بن أحمد بن النضر النضري عن الطبراني","إسماعيل بن أبي خالد عن قيس بن أبي حازم"
"19132","953  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ قَالَ :  مَا سَأَلَ أَحَدٌ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الدَّجَّالِ  أَكْثَرَ مِمَّا سَأَلْتُهُ أَنَا ، فَقَالَ : "" مَا سُؤَالُكَ عَنْهُ ؟ إِنَّكَ لَا تُدْرِكُهُ ،  أَمَا إِنَّهُ لَا يَخْرُجُ حَتَّى لَا يُقْسَمَ مِيرَاثٌ ، وَلَا يَفْزَعَ لِغَنِيمَةٍ  .","","Al-Mu'jam al-Kabir 953","","المغيرة بن شعبة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن أحمد بن عمرو بن حفص القريعي عن الطبراني","إسماعيل بن أبي خالد عن قيس بن أبي حازم"
"19133","954  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى ،  ثَنَا  إِسْمَاعِيلُ ،  حَدَّثَنِي  قَيْسٌ ،  حَدَّثَنِي  الْمُغِيرَةُ ، قَالَ :  مَا سُئِلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الدَّجَّالِ  أَكْثَرَ مِمَّا سَأَلْتُهُ ، وَإِنَّهُ قَالَ لِي : "" مَا يَضُرُّكَ مِنْهُ ؟ "" قُلْتُ : إِنَّهُمْ يَقُولُونَ مَعَهُ جَبَلُ خُبْزٍ ، وَنَهَرُ مَاءٍ ، قَالَ :  هُوَ أَهْوَنُ عَلَى اللهِ مِنْ ذَلِكَ  .","","Al-Mu'jam al-Kabir 954","","المغيرة بن شعبة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","إسماعيل بن أبي خالد عن قيس بن أبي حازم"
"19134","955  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ قَالَ : قُلْتُ :  يَا رَسُولَ اللهِ ، بَلَغَنِي أَنَّ مَعَ  الدَّجَّالِ  أَنْهَارَ الْمَاءِ ، وَجِبَالَ الْخُبْزِ ، قَالَ :  هُوَ أَهْوَنُ عَلَى اللهِ مِنْ ذَلِكَ  ، فَكُنْتُ مِنْ أَكْثَرِ النَّاسِ سُؤَالًا عَنْهُ فَقَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَيْسَ بِالَّذِي يَضُرُّكَ  .","","Al-Mu'jam al-Kabir 955","","المغيرة بن شعبة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","إسماعيل بن أبي خالد عن قيس بن أبي حازم"
"19135","956  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ، كِلَاهُمَا ،         [20/402]      عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  مَا سُئِلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الدَّجَّالِ  أَكْثَرَ مِمَّا سَأَلْتُهُ ، فَقَالَ : "" يَا بُنَيَّ ، وَمَا سَيُصِيبُكَ مِنْهُ ؟ "" قُلْتُ : إِنَّ النَّاسَ يَقُولُونَ : إِنَّ مَعَهُ الطَّعَامَ وَالشَّرَابَ ، فَقَالَ :  هُوَ أَهْوَنُ عَلَى اللهِ مِنْ ذَلِكَ  .","","Al-Mu'jam al-Kabir 956","","المغيرة بن شعبة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن عبدة بن سليمان الكلابي عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","إسماعيل بن أبي خالد عن قيس بن أبي حازم"
"19136","957  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ،  عَنِ  الْمُغِيرَةِ ، قَالَ :  مَا سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَحَدٌ عَنِ  الدَّجَّالِ  أَكْثَرَ مِمَّا سَأَلْتُهُ ، فَقَالَ : "" وَمَا تَسْأَلُنِي عَنْهُ ؟ "" قَالَ : قُلْتُ : إِنَّ النَّاسَ يَقُولُونَ : إِنَّ مَعَهُ جَنَّةً وَنَارًا ، وَالطَّعَامَ وَالشَّرَابَ ، فَقَالَ :  هُوَ أَهْوَنُ عَلَى اللهِ مِنْ ذَلِكَ  .","","Al-Mu'jam al-Kabir 957","","المغيرة بن شعبة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","إسماعيل بن أبي خالد عن قيس بن أبي حازم"
"19137","958  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ الْأَنْمَاطِيُّ ،  ثَنَا  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنِ  الْمُغِيرَةِ ، قَالَ :  مَا سَأَلَ أَحَدٌ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الدَّجَّالِ  أَكْثَرَ مِمَّا سَأَلْتُهُ ، فَقَالَ : "" مَا  يُنْصِبُكَ  مِنْهُ تَسْأَلُ عَنْهُ ؟ إِنَّهُ لَا يَضُرُّكَ "" ، فَقُلْتُ : إِنَّهُمْ يَزْعُمُونَ أَنَّ مَعَهُ الْأَنْهَارَ وَالطَّعَامَ ، فَقَالَ :  هُوَ أَهْوَنُ عَلَى اللهِ مِنْ ذَلِكَ  .","","Al-Mu'jam al-Kabir 958","","المغيرة بن شعبة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن مروان بن معاوية الفزاري عن يحيى بن معين عن محمد بن الحسين الأنماطي عن الطبراني","إسماعيل بن أبي خالد عن قيس بن أبي حازم"
"19138","959  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى ،  ثَنَا  إِسْمَاعِيلُ ،  ثَنَا  قَيْسٌ قَالَ :  سَمِعْتُ  الْمُغِيرَةَ بْنَ شُعْبَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَنْ يَزَالَ نَاسٌ مِنْ أُمَّتِي ظَاهِرِينَ عَلَى النَّاسِ  ، حَتَّى يَأْتِيَهُمُ اللهُ وَهُمْ ظَاهِرُونَ  .","","Al-Mu'jam al-Kabir 959","","المغيرة بن شعبة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","إسماعيل بن أبي خالد عن قيس بن أبي حازم"
"19139","960  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )         [20/403]      وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  وَكِيعٌ ، وَأَبُو أُسَامَةَ ، وَعَلِيُّ بْنُ مُسْهِرٍ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  يَعْلَى بْنُ عُبَيْدٍ ، كُلُّهُمْ  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَزَالُ مِنْ أُمَّتِي قَوْمٌ ظَاهِرِينَ حَتَّى يَأْتِيَهُمْ أَمْرُ اللهِ  وَهُمْ ظَاهِرُونَ  .","","Al-Mu'jam al-Kabir 960","","المغيرة بن شعبة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","إسماعيل بن أبي خالد عن قيس بن أبي حازم"
"19140","961  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  الْحِمَّانِيُّ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَزَالُ  طَائِفَةٌ  مِنْ أُمَّتِي عَلَى الْحَقِّ ظَاهِرِينَ  حَتَّى تَقُومَ السَّاعَةُ  .","","Al-Mu'jam al-Kabir 961","","المغيرة بن شعبة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن هشيم بن بشير عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","إسماعيل بن أبي خالد عن قيس بن أبي حازم"
"19141","962  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ الْأَنْمَاطِيُّ ،  ثَنَا  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَزَالُ نَاسٌ مِنْ أُمَّتِي ظَاهِرِينَ حَتَّى يَأْتِيَهُمْ أَمْرُ اللهِ  وَهُمْ ظَاهِرُونَ  .","","Al-Mu'jam al-Kabir 962","","المغيرة بن شعبة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن مروان بن معاوية الفزاري عن يحيى بن معين عن محمد بن الحسين الأنماطي عن الطبراني","إسماعيل بن أبي خالد عن قيس بن أبي حازم"
"19142","963  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ  ، أَخْبَرَنِي  الْمُغِيرَةُ بْنُ شُعْبَةَ قَالَ :  كُنْتُ عِنْدَ أَبِي بَكْرٍ الصِّدِّيقِ رَضِيَ اللهُ عَنْهُ ، فَعَرَضَ عَلَيَّ فَرَسٌ ، فَقَالَ رَجُلٌ : احْمِلْنِي عَلَى هَذَا ، فَقَالَ : لَأَنْ أَحْمِلَ غُلَامًا قَدْ رَكِبَ الْخَيْلَ عَلَى عُزْلَتِهِ أَحَبُّ إِلَيَّ مِنْ أَنْ أَحْمِلَكَ عَلَيْهِ ، فَغَضِبَ الرَّجُلُ فَقَالَ : أَنَا وَاللهِ خَيْرٌ مِنْكَ وَمِنْ أَبِيكَ فَارِسًا ، فَغَضِبَتُ حِينَ قَالَ ذَلِكَ لِخَلِيفَةِ رَسُولِ اللهِ         [20/404]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقُمْتُ إِلَيْهِ فَأَخَذْتُ بِرَأْسِهِ وَسَحَبْتُهُ عَلَى أَنْفِهِ ، فَكَأَنَّمَا كَانَ أَنْفُهُ  عَزْلَاءَ  مَزَادَةٍ ، فَأَرَادَ  الْأَنْصَارُ  أَنْ يَسْتَقِيدُوا مِنِّي ، فَبَلَغَ ذَلِكَ  أَبَا بَكْرٍ  فَقَالَ :  بَلَغَنِي أَنَّ نَاسًا يَزْعُمُونَ أَنِّي مُقِيدُهُمْ مِنَ  الْمُغِيرَةِ بْنِ شُعْبَةَ  ، وَلَأَنْ أُخْرِجَهُمْ مِنْ دِيَارِهِمْ أَقْرَبُ مِنْ أَنْ أُقِيدَهُمْ مِنْ  وَزَعَةِ  اللهِ الَّذِينَ يَزَعُونَ عِبَادَهُ  ""  .","","Al-Mu'jam al-Kabir 963","","أبو  بكر الصديق عن المغيرة بن شعبة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن حماد بن أسامة القرشي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","إسماعيل بن أبي خالد عن قيس بن أبي حازم"
"19143","964  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ  ،  عَنِ  الْمُغِيرَةِ ، أَنَّهُ كَانَ عَلَى رَأْسِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالسَّيْفِ وَهُوَ مُتَلَثِّمٌ ، فَجَعَلَ  عُرْوَةُ  يُنَاوِلُ لِحْيَةَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَتَكَلَّمُ ، فَقَالَ لَهُ  الْمُغِيرَةُ  : لَتَكُفَّنَّ يَدَكَ أَوْ لَا تَرْجِعُ إِلَيْكَ -  وَالْمُغِيرَةُ  مُتَقَلِّدٌ سَيْفًا - فَقَالَ  عُرْوَةُ  : يَا رَسُولَ اللهِ ، مَنْ هَذَا ؟ فَقَالَ :  هَذَا ابْنُ أَخِيكَ  الْمُغِيرَةُ  ، فَقَالَ : يَا  غُدَرُ  ، مَا غَسَلْتُ رَأْسِي مِنْ غَدْرَتِكَ  .","","Al-Mu'jam al-Kabir 964","","المغيرة بن شعبة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","إسماعيل بن أبي خالد عن قيس بن أبي حازم"
"19144","965  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ ، وَعَبْدَانُ بْنُ أَحْمَدَ قَالَا :  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  سَعِيدُ بْنُ يَحْيَى ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تُحَرِّمُ الْعَنَقَةُ  ، قُلْنَا : وَمَا الْعَنَقَةُ ؟ قَالَ : "" الْمَرْأَةُ تَلِدُ فَتَحْصُرُ اللَّبَنَ فِي ثَدْيِهَا ، فَتُرْضِعُ جَارَتَهَا الْمَرَّةَ وَالْمَرَّتَيْنِ  .","","Al-Mu'jam al-Kabir 965","","المغيرة بن شعبة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن سعيد بن يحيى سعدان عن هشام بن عمار عن عبد الله بن أحمد الجواليقي عن الطبراني","إسماعيل بن أبي خالد عن قيس بن أبي حازم"
"19145","[20/405]      أَبُو وَائِلٍ شَقِيقُ بْنُ سَلَمَةَ  ، عَنِ  الْمُغِيرَةِ  966  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  عَنْ  عَاصِمِ ابْنِ بَهْدَلَةَ ، وَحَمَّادِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  أَبِي وَائِلٍ ،  عَنِ  الْمُغِيرَةِ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَتَى  سُبَاطَةَ  بَنِي فُلَانٍ  فَفَحَّجَ  رِجْلَيْهِ فَبَالَ قَائِمًا  .","","Al-Mu'jam al-Kabir 966","","المغيرة بن شعبة عن شقيق بن سلمة عن حماد بن أبي سليمان عن أبو بكر ابن أبي شيبة عن سعيد بن سليمان سعدويه عن محمد بن الفضل بن جابر السقطى عن الطبراني","أبو وائل شقيق بن سلمة عن المغيرة"
"19146","967  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ الْخَشَّابُ الرَّقِّيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ ، (  ح  )  وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  عَلِيُّ بْنُ مَعْبَدٍ قَالَا :  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  عَاصِمِ بْنِ أَبِي النَّجُودِ ،  عَنْ  شَقِيقِ بْنِ سَلَمَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  قَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  سُبَاطَةِ  قَوْمٍ ، فَجِئْتُهُ بِمَاءٍ فَتَوَضَّأَ  وَعَلَيْهِ جُبَّةٌ رُومِيَّةٌ صَغِيرَةُ الْيَدَيْنِ ، فَأَخْرَجَ يَدَهُ مِنْ تَحْتِ تِلْكَ الْجُبَّةِ ، فَغَسَلَ وَجْهَهُ ، وَمَسَحَ بِرَأْسِهِ وَمَسَحَ عَلَى خُفَّيْهِ ، ثُمَّ قَامَ فَصَلَّى  .","","Al-Mu'jam al-Kabir 967","","المغيرة بن شعبة عن شقيق بن سلمة عن عاصم بن بهدلة عن زيد بن أبي أنيسة الجزري عن عبيد الله بن عمرو بن أبي الوليد عن علي بن معبد العبدي عن يوسف بن يزيد القراطيسي عن الطبراني","أبو وائل شقيق بن سلمة عن المغيرة"
"19147","968  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلُّويَهِ الْقَطَّانُ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عِيسَى الْعَطَّارُ ،  ثَنَا  خَلَفُ بْنُ خَلِيفَةَ ،  عَنْ  أَبِي جَنَابٍ ،  عَنْ  عَاصِمِ بْنِ أَبِي النَّجُودِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَالَ فِي         [20/406]      سُبَاطَةِ  بَنِي فُلَانٍ فَقَالَ :  يَا  مُغِيرَةُ  ، مَعَكَ مَاءٌ ؟  قَالَ : نَعَمْ  إِدَاوَةٌ  مِنْ مَاءٍ ، وَعَلَيْهِ جُبَّةٌ شَامِيَّةٌ ضَيِّقَةُ الْكُمَّيْنِ ، فَتَوَضَّأَ وَمَسَحَ عَلَى قَدَمَيْهِ وَعَلَيْهِ خُفَّانِ  .","","Al-Mu'jam al-Kabir 968","","المغيرة بن شعبة عن شقيق بن سلمة عن عاصم بن بهدلة عن يحيى بن أبي حية عن خلف بن خليفة الأشجعي عن إسماعيل بن عيسى البغدادي عن ابن علويه الحسن بن علي القطان عن الطبراني","أبو وائل شقيق بن سلمة عن المغيرة"
"19148","969  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  أَبُو دَاوُدَ ،  عَنْ  شُعْبَةَ ،  أَنَا  عَاصِمُ ابْنُ بَهْدَلَةَ قَالَ :  سَمِعْتُ  أَبَا وَائِلٍ  يُحَدِّثُ ، عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَتَى  سُبَاطَةَ  قَوْمٍ فَبَالَ قَائِمًا  .","","Al-Mu'jam al-Kabir 969","","المغيرة بن شعبة عن شقيق بن سلمة عن عاصم بن بهدلة عن شعبة بن الحجاج عن أبو داود الطيالسي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو وائل شقيق بن سلمة عن المغيرة"
"19149","970  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ حَمَّادِ بْنِ نُمَيْرٍ ،  ثَنَا  حُصَيْنُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي وَائِلٍ قَالَ :  شَهِدْتُ  الْقَادِسِيَّةَ  فَانْطَلَقَ الْمُغِيرَةُ بْنُ شُعْبَةَ ، فَلَمَّا دَنَا مِنْ سَرِيرِ  رُسْتُمَ  وَثَبَ ، فَجَلَسَ مَعَهُ عَلَى سَرِيرِهِ  فَنَخَرُوا  ، فَقَالَ لَهُمُ  الْمُغِيرَةُ بْنُ شُعْبَةَ  : مَا الَّذِي تَفْزَعُونَ مِنْ هَذَا ؟ أَنَا الْآنَ أَقُومُ فَأَرْجِعُ إِلَى مَا كُنْتُ عَلَيْهِ ، وَيَرْجِعُ صَاحِبُكُمْ إِلَى مَا كَانَ عَلَيْهِ ، قَالُوا : أَخْبِرْنَا مَا جَاءَ بِكُمْ ؟  قَالَ  الْمُغِيرَةُ  :  كُنَّا ضُلَّالًا فَبَعَثَ اللهُ فِينَا نَبِيًّا وَهَدَانَا إِلَى دِينِهِ  وَرَزَقَنَا فِيمَا رَزَقَنَا حَبَّةً تَكُونُ فِي بِلَادِكُمْ هَذِهِ ، فَلَمَّا أَكَلْنَا مِنْهَا وَأَطْعَمْنَا أَهْلَنَا قَالُوا : لَا صَبْرَ لَنَا حَتَّى تُنْزِلُونَا هَذِهِ الْبِلَادَ ، قَالُوا : إِذًا نَقْتُلُكُمْ ، قَالَ : إِنْ قَتَلْتُمُونَا دَخَلْنَا الْجَنَّةَ ، وَإِنْ قَتَلْنَاكُمْ دَخَلْتُمُ النَّارَ  "" .","","Al-Mu'jam al-Kabir 970","","المغيرة بن شعبة عن شقيق بن سلمة عن حصين بن عبد الرحمن السلمي عن عبد الله بن حماد بن نمير عن الحسن بن علي بن شبيب المعمري عن الطبراني","أبو وائل شقيق بن سلمة عن المغيرة"
"19150","الْأَسْوَدُ بْنُ هِلَالٍ  ، عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  971  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  ابْنُ بَشَّارٍ ،         [20/407]      ثَنَا  عَمْرُو بْنُ عَوْنٍ ، قَالَا :  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ ،  عَنِ  الْأَسْوَدِ بْنِ هِلَالٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ قَالَ :  بَيْنَمَا أَنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَاتَ لَيْلَةٍ ،  إِذْ نَزَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَضَى حَاجَتَهُ ، ثُمَّ جَاءَ فَصَبَبْتُ عَلَيْهِ الْمَاءَ مِنْ دَوَاةٍ كَانَتْ مَعِي  ، فَتَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ "" .","","Al-Mu'jam al-Kabir 971","","المغيرة بن شعبة عن الأسود بن هلال المحاربي عن أشعث بن أبي الشعثاء عن سلام بن سليم الحنفي عن عمرو بن عون الواسطي عن محمد بن بشار بندار عن عبد الله بن محمد بن سعيد المصري عن الطبراني","الأسود بن هلال عن المغيرة بن شعبة"
"19151","سَالِمُ بْنُ أَبِي الْجَعْدِ  ،  وَأَبُو سُفْيَانَ طَلْحَةُ بْنُ نَافِعٍ  ، عَنِ  الْمُغِيرَةِ  972  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  شُجَاعُ بْنُ مَخْلَدٍ ، (  ح  )  وَحَدَّثَنَا  سَعِيدُ بْنُ سَيَّارٍ الْوَاسِطِيُّ ،  ثَنَا  عَمْرُو بْنُ عَوْنٍ ، قَالُوا :  ثَنَا  هُشَيْمٌ ،  أَنَا  حُصَيْنٌ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ، وَأَبِي سُفْيَانَ ، أَنَّهُمَا  سَمِعَا  الْمُغِيرَةَ بْنَ شُعْبَةَ يُحَدِّثُ ، قَالَ :  كُنْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَتَبَرَّزَ لِحَاجَتِهِ  فَلَمَّا فَرَغَ أَتَيْتُهُ  بِإِدَاوَةٍ  فِيهَا مَاءٌ ، فَصَبَبْتُ عَلَيْهِ فَتَوَضَّأَ ، وَكَانَتْ عَلَيْهِ جُبَّةٌ ضَيِّقَةُ الْكُمَّيْنِ ، فَأَخْرَجَ يَدَهُ مِنْ تَحْتِ الْجُبَّةِ فَغَسَلَ ذِرَاعَيْهِ وَمَسَحَ عَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 972","","المغيرة بن شعبة عن طلحة بن نافع العراقي عن حصين بن عبد الرحمن السلمي عن هشيم بن بشير عن عمرو بن عون الواسطي عن سعيد بن سيار الواسطي عن الطبراني","سالم بن أبي الجعد وأبو سفيان طلحة بن نافع عن المغيرة"
"19152","973  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ بْنِ مُكْرَمٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْحَسَنِ بْنِ شَقِيقٍ ، قَالَ :  سَمِعْتُ  أَبِي  ،  ثَنَا  أَبُو حَمْزَةَ ،  عَنْ  جَابِرٍ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا قَالَ : ""  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ "" قَالَ :  اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ  ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  "" .","","Al-Mu'jam al-Kabir 973","","المغيرة بن شعبة عن طلحة بن نافع العراقي عن جابر الجعفي عن محمد بن ميمون أبو حمزة السكري عن علي بن الحسن بن شقيق عن محمد بن علي بن الحسن بن شقيق المطوعي عن محمد بن الحسين بن مكرم البارع عن الطبراني","سالم بن أبي الجعد وأبو سفيان طلحة بن نافع عن المغيرة"
"19153","عَلِيُّ بْنُ رَبِيعَةَ الْوَالِبِيُّ  ، عَنِ  الْمُغِيرَةِ  974  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مُحَمَّدُ بْنُ         [20/408]      قَيْسٍ الْأَسَدِيُّ ،  عَنْ  عَلِيِّ بْنِ رَبِيعَةَ ، قَالَ :  أَوَّلُ مَنْ نِيحَ عَلَيْهِ  بِالْكُوفَةِ  قَرَظَةُ بْنُ كَعْبٍ الْأَنْصَارِيُّ  ، فَزَعَمَ  أَنَّ  الْمُغِيرَةَ قَامَ فَحَمِدَ اللهَ ، وَأَثْنَى عَلَيْهِ ثُمَّ قَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا ،  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  ، وَسَمِعْتُهُ يَقُولُ :  مَنْ نِيحَ عَلَيْهِ ، فَإِنَّهُ  يُعَذَّبُ  مَا نِيحَ عَلَيْهِ  .","","Al-Mu'jam al-Kabir 974","","المغيرة بن شعبة عن علي بن ربيعة بن نضلة الوالبي عن محمد بن قيس الوالبي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","علي بن ربيعة الوالبي عن المغيرة"
"19154","975  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سَعِيدُ بْنُ عُبَيْدٍ الطَّائِيُّ ،  عَنْ  عَلِيِّ بْنِ رَبِيعَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ الْكَذِبَ عَلَيَّ لَيْسَ كَالْكَذِبِ عَلَى أَحَدٍ  .","","Al-Mu'jam al-Kabir 975","","المغيرة بن شعبة عن علي بن ربيعة بن نضلة الوالبي عن سعيد بن عبيد الطائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","علي بن ربيعة الوالبي عن المغيرة"
"19155","وَسَمِعْتُ  رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 19155","","المغيرة بن شعبة عن علي بن ربيعة بن نضلة الوالبي عن سعيد بن عبيد الطائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","علي بن ربيعة الوالبي عن المغيرة"
"19156","وَقَالَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا نِيحَ عَلَى الْمَيِّتِ عُذِّبَ بِالْمَنَاحَةِ عَلَيْهِ  .","","Al-Mu'jam al-Kabir 19156","","المغيرة بن شعبة عن علي بن ربيعة بن نضلة الوالبي عن سعيد بن عبيد الطائي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","علي بن ربيعة الوالبي عن المغيرة"
"19157","976  -  حَدَّثَنَا  عَمْرُو بْنُ حَفْصٍ السَّدُوسِيُّ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  أَبُو بَكْرٍ النَّهْشَلِيُّ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ ،  عَنْ  عَلِيِّ بْنِ رَبِيعَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، أَنَّهُ  كَانَ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ فَتَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 976","","المغيرة بن شعبة عن علي بن ربيعة بن نضلة الوالبي عن عبد العزيز بن رفيع الطائفي عن أبو بكر النهشلي عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","علي بن ربيعة الوالبي عن المغيرة"
"19158","977  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ، (  ح  )  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  جَرِيرٌ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ ،  عَنْ  عَلِيِّ بْنِ رَبِيعَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 977","","المغيرة بن شعبة عن علي بن ربيعة بن نضلة الوالبي عن عبد العزيز بن رفيع الطائفي عن جرير بن عبد الحميد عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","علي بن ربيعة الوالبي عن المغيرة"
"19159","[20/409]      عُبَيْدُ بْنُ نُضَيْلَةَ الْخُزَاعِيُّ  ، عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  978  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عُبَيْدِ بْنِ نُضَيْلَةَ الْخُزَاعِيِّ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ قَالَ :  ضَرَبَتْ  ضَرَّةٌ  ضَرَّتَهَا بِعَمُودِ  فُسْطَاطٍ  فَقَتَلَتْهَا ، فَقُضِي بِدِيَتِهَا عَلَى عَصَبَةِ الْقَاتِلَةِ ، وَبِمَا فِي بَطْنِهَا غُرَّةً ، فَقَالَ  الْأَعْرَابِيُّ  : أَتُغَرِّمُنِي مَنْ لَا طَعِمَ وَلَا شَرِبَ ، وَلَا صَاحَ فَاسْتَهَلَّ ، فَمِثْلُ ذَلِكَ  يُطَلُّ  ؟ فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَسَجْعٌ كَسَجْعِ الْأَعْرَابِ  ؟ "" زَادَ  أَبُو حُذَيْفَةَ  فِي حَدِيثِهِ : وَقُضِي فِيمَا فِي بَطْنِهَا بِغُرَّةٍ  .","","Al-Mu'jam al-Kabir 978","","المغيرة بن شعبة عن عبيد بن نضلة الخزاعي عن إبراهيم النخعي عن منصور بن المعتمر عن سفيان الثوري عن موسى بن مسعود النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبيد بن نضيلة الخزاعي عن المغيرة بن شعبة"
"19160","979  -  حَدَّثَنَا  دَرَانُ بْنُ سُفْيَانَ الْقَطَّانُ الْبَصْرِيُّ ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عُبَيْدِ بْنِ نُضَيْلَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  كَانَ عِنْدَ  رَجُلٍ مِنْ هُذَيْلٍ  امْرَأَتَانِ ، فَرَمَتْ إِحْدَاهُمَا  الْأُخْرَى  بِفِهْرٍ  أَوْ بِعَمُودِ  فُسْطَاطٍ  فَأَسْقَطَتْ  ، فَرُفِعَ ذَلِكَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَضَى فِيهِ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِغُرَّةٍ ، فَقَالَ أَوْلِيَاؤُهَا : كَيْفَ نَدِي مَنْ لَا صَاحَ وَلَا  اسْتَهَلَّ  ، وَلَا شَرِبَ وَلَا أَكَلَ ، فَمِثْلُ ذَلِكَ  يُطَلُّ  ؟ فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَسَجْعٌ كَسَجْعِ الْأَعْرَابِ  ؟ "" وَقَضَى بِعَقْلِهِ عَلَى أَوْلِيَاءِ الْمَرْأَةِ  .","","Al-Mu'jam al-Kabir 979","","المغيرة بن شعبة عن عبيد بن نضلة الخزاعي عن إبراهيم النخعي عن منصور بن المعتمر عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن محمد بن معاذ بن سفيان العنزي عن الطبراني","عبيد بن نضيلة الخزاعي عن المغيرة بن شعبة"
"19161","980  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا         [20/410]      غُنْدَرٌ ،  عَنْ  شُعْبَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عُبَيْدِ بْنِ نُضَيْلَةَ ،  عَنِ  الْمُغِيرَةِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 980","","المغيرة بن شعبة عن عبيد بن نضلة الخزاعي عن إبراهيم النخعي عن منصور بن المعتمر عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبيد بن نضيلة الخزاعي عن المغيرة بن شعبة"
"19162","981  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  يَحْيَى بْنُ يَعْلَى أَبُو الْمُحَيَّاةِ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عُبَيْدِ بْنِ نُضَيْلَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 981","","المغيرة بن شعبة عن عبيد بن نضلة الخزاعي عن إبراهيم النخعي عن منصور بن المعتمر عن يحيى بن يعلى بن حرملة التيمي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","عبيد بن نضيلة الخزاعي عن المغيرة بن شعبة"
"19163","982  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عُبَيْدِ بْنِ نُضَيْلَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 982","","المغيرة بن شعبة عن عبيد بن نضلة الخزاعي عن إبراهيم النخعي عن منصور بن المعتمر عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","عبيد بن نضيلة الخزاعي عن المغيرة بن شعبة"
"19164","983  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  عِيسَى بْنُ أَبِي حَرْبٍ الصَّفَّارُ ،  ثَنَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عُبَيْدِ بْنِ نُضَيْلَةَ ،  عَنِ  الْمُغِيرَةِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 983","","المغيرة بن شعبة عن عبيد بن نضلة الخزاعي عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن شعبة بن الحجاج عن يحيى بن أبي بكير عن عيسى بن موسى بن أبي حرب الصفار عن الساجي عن الطبراني","عبيد بن نضيلة الخزاعي عن المغيرة بن شعبة"
"19165","بِشْرُ بْنُ قُحَيْفٍ  ، عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  984  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَمْرُو بْنُ حَمَّادِ بْنِ طَلْحَةَ الْقَنَّادُ ،  ثَنَا  أَسْبَاطُ بْنُ نَصْرٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  بِشْرِ بْنِ قُحَيْفٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  بَيْنَمَا أَنَا أَسِيرُ ذَاتَ لَيْلَةٍ إِذْ أَنَا بِنَعِيرِ ، رَاكِبٍ مِنَ الرَّكْبِ ، قَالَ  الْمُغِيرَةُ بْنُ شُعْبَةَ  : قُلْتُ : مَنْ أَنْتَ ؟ قَالَ : "" أَنَا رَسُولُ اللهِ "" ، فَحَبَسْتُ حَتَّى لَحِقَنِي ، فَسَايَرْتُهُ ثُمَّ نَزَلَ فَتَبَرَّزَ ، قَالَ :  عِنْدَكَ مَاءٌ ؟ "" قُلْتُ : أَيَضُرُّكَ ؟ قَالَ : "" فَأَتَيْتُهُ بِمَاءٍ فَتَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ  ، فَمَا افْتَرَقْنَا حَتَّى صَلَّيْنَا صَلَاةَ الْفَجْرِ  .         [20/411]","","Al-Mu'jam al-Kabir 984","","المغيرة بن شعبة عن بشر بن قحيف العامري عن سماك بن حرب البكري عن أسباط بن نصر الهمداني عن عمرو بن حماد القناد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","بشر بن قحيف عن المغيرة بن شعبة"
"19166","985  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ، (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  أَبُو الْأَحْوَصِ ،  ثَنَا  سِمَاكُ بْنُ حَرْبٍ ،  عَنْ  بِشْرِ بْنِ قُحَيْفٍ قَالَ :  كُنَّا فِي بَيْتِ الْمُغِيرَةِ بْنِ شُعْبَةَ ، فَذَكَرُوا الطُّهُورَ ، فَقَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَضَى حَاجَتَهُ ، ثُمَّ تَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 985","","المغيرة بن شعبة عن بشر بن قحيف العامري عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","بشر بن قحيف عن المغيرة بن شعبة"
"19167","عَلْقَمَةُ بْنُ وَائِلٍ الْحَضْرَمِيُّ  ، عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  986  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  (  ح  ) ،  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  ابْنُ الْأَصْبَهَانِيِّ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقَزَّازُ الْبَصْرِيُّ ،  ثَنَا  عِمْرَانُ بْنُ مَيْسَرَةَ الْأَوْدِيُّ ، (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالُوا :  ثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  أَبِيهِ  ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ قَالَ :  بَعَثَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  نَجْرَانَ  فَقَالُوا لِي فِيمَا قَالُوا : كَانَتْ فِيمَا تَقْرَءُونَ :         {      يَا أُخْتَ هَارُونَ         }      قَدْ كَانَ بَيْنَ  مُوسَى  وَبَيْنَ  عِيسَى  مَا قَدْ عَلِمْتُمْ ؟ قَالَ : فَأَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَخْبَرْتُهُ فَقَالَ :  أَفَلَا أَخْبَرْتَهُمْ أَنَّهُمْ كَانُوا يُسَمَّوْنَ بِأَسْمَائِهِمْ وَبِالصَّالِحِينَ الَّذِينَ كَانُوا قَبْلَهُمْ  .","","Al-Mu'jam al-Kabir 986","","المغيرة بن شعبة عن علقمة بن وائل بن حجر الحضرمي عن سماك بن حرب البكري عن إدريس بن يزيد الزعافري عن عبد الله بن إدريس الأودي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","علقمة بن وائل الحضرمي عن المغيرة بن شعبة"
"19168","عَامِرٌ الشَّعْبِيُّ  ، عَنِ  الْمُغِيرَةِ  987  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ         [20/412]      الثَّوْرِيِّ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  أَنَّهُ قَامَ فِي الرَّكْعَتَيْنِ الْأُولَيَيْنِ فَسَبَّحُوا بِهِ فَلَمْ يَجْلِسْ ، فَلَمَّا قَضَى صَلَاتَهُ سَجَدَ سَجْدَتَيْنِ بَعْدَ التَّسْلِيمِ ، ثُمَّ قَالَ : هَكَذَا فَعَلَ رَسُولُ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 987","","المغيرة بن شعبة عن الشعبي عن محمد بن عبد الرحمن بن أبي ليلى عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عامر الشعبي عن المغيرة"
"19169","988  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  مُحَمَّدُ بْنُ عِمْرَانَ بْنِ أَبِي لَيْلَى ،  حَدَّثَنِي  أَبِي ،  عَنِ  ابْنِ أَبِي لَيْلَى  ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَشَهَّدَ ، لَمَّا رَفَعَ رَأْسَهُ مِنْ سَجْدَتَيِ السَّهْوِ  .","","Al-Mu'jam al-Kabir 988","","المغيرة بن شعبة عن الشعبي عن محمد بن عبد الرحمن بن أبي ليلى عن عمران بن محمد ابن أبي ليلى عن محمد بن عمران بن محمد بن عبد الرحمن بن أبي ليلى عن بشر بن موسى بن صالح الأسدي عن الطبراني","عامر الشعبي عن المغيرة"
"19170","989  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  الْحُمَيْدِيُّ ، (  ح  )  وَحَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ قَالَا :  ثَنَا  سُفْيَانُ ،  عَنْ  مُطَرِّفِ بْنِ طَرِيفٍ ، وَعَبْدِ الْمَلِكِ بْنِ سَعِيدِ بْنِ أَبْجَرَ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ -  رَفَعَهُ  ابْنُ أَبْجَرَ  وَلَمْ  يَرْفَعْهُ  مُطَرِّفٌ  - قَالَ :  قَالَ  مُوسَى  عَلَيْهِ السَّلَامُ : يَا رَبِّ أَخْبِرْنِي عَنْ أَدْنَى أَهْلِ الْجَنَّةِ مَنْزِلَةً  ، قَالَ : نَعَمْ هُوَ رَجُلٌ يَجِيءُ بَعْدَمَا نَزَلَ النَّاسُ مَنَازِلَهُمْ وَأَخَذُوا  أَخَذَاتِهِمْ  ، فَيُقَالُ لَهُ : ادْخُلِ الْجَنَّةَ ، فَيَقُولُ : يَا رَبِّ ، وَكَيْفَ أَدْخُلُهَا وَقَدْ نَزَلَ النَّاسُ مَنَازِلَهُمْ ، وَأَخَذُوا  أَخَذَاتِهِمْ  ؟ فَقَالَ : أَمَا تَرْضَى أَنْ يَكُونَ لَكَ مِثْلُ مَا كَانَ لِمَلِكٍ مِنَ الْمُلُوكِ فِي الدُّنْيَا ؟ فَيَقُولُ : رَضِيتُ رَبِّي ، فَيَقُولُ : إِنَّ لَكَ مِثْلَهُ وَمِثْلَهُ وَمِثْلَهُ -  وَعَقَدَ  سُفْيَانُ  أَصَابِعَهُ الْخَمْسَ  - فَيَقُولُ : رَضِيتُ ، فَيَقُولُ : إِنَّ لَكَ هَذَا وَمَا اشْتَهَتْ نَفْسُكَ وَلَذَّتْ عَيْنُكَ ، فَيَقُولُ : رَضِيتُ رَبِّي ، قَالَ  مُوسَى  : يَا رَبِّ ، فَأَخْبِرْنِي عَنْ أَعْلَى أَهْلِ الْجَنَّةِ مَنْزِلَةً ، قَالَ : نِعْمَ أُولَئِكَ أَرَدْتَ وَسَأُخْبِرُكَ عَنْهُمْ ، غَرَسْتُ كَرَامَتَهُمْ بِيَدِي ، وَخَتَمْتُ عَلَيْهَا ، فَلَمْ تَرَ عَيْنٌ ، وَلَمْ تَسْمَعْ أُذُنٌ ، وَلَا يَخْطُرُ         [20/413]      عَلَى قَلْبِ بَشَرٍ "" وَمِصْدَاقُ ذَلِكَ فِي كِتَابِ اللهِ :         {      فَلا تَعْلَمُ نَفْسٌ مَا أُخْفِيَ لَهُمْ مِنْ قُرَّةِ أَعْيُنٍ جَزَاءً بِمَا كَانُوا يَعْمَلُونَ         }      .","","Al-Mu'jam al-Kabir 989","","المغيرة بن شعبة عن الشعبي عن عبد الملك بن سعيد بن حيان عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","عامر الشعبي عن المغيرة"
"19171","990  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  حُصَيْنٍ ،  عَنِ  الشَّعْبِيِّ ، قَالَ :  سَمِعْتُ  الْمُغِيرَةَ ، وَهُوَ يَخْطُبُ عَلَى الْمِنْبَرِ وَهُوَ يَقُولُ :  خَرَجْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي غَزْوَةٍ ، "" فَانْطَلَقَ لِحَاجَةٍ  ، فَاتَّبَعْتُهُ  بِإِدَاوَةٍ  ، فَأَخْرَجَ يَدَيْهِ مِنْ جُبَّةٍ عَلَيْهِ ضَيِّقَةُ الْكُمَّيْنِ ، فَأَخْرَجَهُمَا مِنْ تَحْتِهَا فَغَسَلَ وَجْهَهُ وَيَدَيْهِ ، وَمَسَحَ بِرَأْسِهِ وَمَسَحَ عَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 990","","المغيرة بن شعبة عن الشعبي عن حصين بن عبد الرحمن السلمي عن محمد بن فضيل بن غزوان عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","عامر الشعبي عن المغيرة"
"19172","991  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ، (  ح  )  وَحَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَامِرِ بْنِ زُرَارَةَ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ، قَالُوا ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنِ  الْحَسَنِ بْنِ عَبَّاسٍ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنْ  عَامِرٍ ،  قَالَ  :  قِيلَ لِلْمُغِيرَةِ بْنِ شُعْبَةَ :  مِنْ أَيْنَ كَانَ لِلنَّبِيِّ خُفَّانِ ؟ قَالَ : "" أَهْدَاهُمَا لَهُ  دِحْيَةُ الْكَلْبِيُّ  .","","Al-Mu'jam al-Kabir 991","","المغيرة بن شعبة عن الشعبي عن سليمان بن فيروز الشيباني عن الحسن بن عياش الأسدي عن يحيى بن زكريا بن أبي زائدة عن سهل بن عثمان العسكري عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","عامر الشعبي عن المغيرة"
"19173","992  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  وَثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ قَالَا ،  ثَنَا  أَبُو سَعِيدٍ الْأَشَجُّ ،  ثَنَا  أَبُو أُسَامَةَ ،  ثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْحَاقَ الشَّيْبَانِيُّ ،  عَنْ  أَبِيهِ  ، قَالَ : لَمَّا  حَدَّثَ  الشَّعْبِيُّ ، بِحَدِيثِ الْمُغِيرَةِ بْنِ شُعْبَةَ أَنَّهُ  رَأَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ  قُلْتُ :         [20/414]      يَا  أَبَا عَمْرٍو  ، وَمِنْ أَيْنَ كَانَ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خُفَّانِ ؟ قَالَ : أَهْدَاهُمَا لَهُ  دِحْيَةُ الْكَلْبِيُّ  .","","Al-Mu'jam al-Kabir 992","","المغيرة بن شعبة عن الشعبي عن سليمان بن فيروز الشيباني عن إسحاق بن سليمان بن أبي سليمان الشيباني عن حماد بن أسامة القرشي عن عبد الله بن سعيد الأشج عن الحسين بن إسحاق التستري عن الطبراني","عامر الشعبي عن المغيرة"
"19174","993  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَمْرُونُ بْنُ عَوْنٍ ،  ثَنَا  هُشَيْمٌ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو أُسَامَةَ ، وَمُحَاضِرُ بْنُ الْمُوَرِّعِ ، كُلُّهُمْ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مُغِيرَةَ بْنِ شُعْبَةَ ، قَالَ :  كُنْتُ فِيمَنْ حَفَرَ قَبْرَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : "" فَلَحَدْنَا لَهُ  لَحْدًا  ، فَلَمَّا أُدْخِلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْقَبْرَ طَرَحْتُ الْفَأْسَ ، ثُمَّ قُلْتُ : الْفَأْسَ الْفَأْسَ ، فَنَزَلْتُ فَوَضَعْتُ يَدِي عَلَى اللَّحْدِ "" وَكَانَ يَقُولُ الْمُغِيرَةُ : ""  أَنَا أَقْرَبُ النَّاسِ عَهْدًا بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 993","","المغيرة بن شعبة عن الشعبي عن مجالد بن سعيد عن محاضر بن المورع الهمداني عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","عامر الشعبي عن المغيرة"
"19175","994  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ مُسَاوِرٍ الْجَوْهَرِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  قَالَ  :  قَالَ رَجُلٌ عِنْدَ الْمُغِيرَةِ بْنِ شُعْبَةَ :  صَلَّى اللهُ عَلَى  مُحَمَّدٍ  خَاتَمِ الْأَنْبِيَاءِ لَا نَبِيَّ بَعْدَهُ  ، فَقَالَ  الْمُغِيرَةُ  : "" حَسْبُكَ أَنْ تَقُولَ : خَاتَمِ الْأَنْبِيَاءِ ، فَإِنَّا كُنَّا نُحَدَّثُ أَنَّ  عِيسَى ابْنَ مَرْيَمَ  خَارِجٌ ، فَإِنْ كَانَ خَارِجًا فَقَدْ كَانَ قَبْلَهُ وَبَعْدَهُ  "" .","","Al-Mu'jam al-Kabir 994","","المغيرة بن شعبة عن الشعبي عن مجالد بن سعيد عن حماد بن أسامة القرشي عن سعيد بن سليمان سعدويه عن أحمد بن القاسم بن مساور الجوهري عن الطبراني","عامر الشعبي عن المغيرة"
"19176","هُزَيْلُ بْنُ شُرَحْبِيلَ  ، عَنِ  الْمُغِيرَةِ  995  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  أَبُو عَاصِمٍ ،  عَنْ  سُفْيَانَ ،  عَنْ  أَبِي قَيْسٍ ،  عَنْ  هُزَيْلِ بْنِ شُرَحْبِيلَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّ النَّبِيَّ صَلَّى         [20/415]      اللهُ عَلَيْهِ وَسَلَّمَ مَسَحَ عَلَى الْخُفَّيْنِ  .","","Al-Mu'jam al-Kabir 995","","المغيرة بن شعبة عن هزيل بن شرحبيل الأودي عن عبد الرحمن بن ثروان الأودي عن سفيان الثوري عن أبو عاصم النبيل عن أبو مسلم الكجي عن الطبراني","هزيل بن شرحبيل عن المغيرة"
"19177","996  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ الْحِمَّانِيُّ ،  حَدَّثَنِي  أَبِي  ، وَعَبْدُ اللهِ بْنُ الْمُبَارَكِ ، وَوَكِيعٌ ، وَزَيْدُ بْنُ الْحُبَابِ ،  عَنْ  سُفْيَانَ ،  عَنْ  أَبِي قَيْسٍ ،  عَنْ  هُزَيْلِ بْنِ شُرَحْبِيلَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَالَ فَتَوَضَّأَ  وَمَسَحَ عَلَى جَوْرَبَيْهِ وَنَعْلَيْهِ  .","","Al-Mu'jam al-Kabir 996","","المغيرة بن شعبة عن هزيل بن شرحبيل الأودي عن عبد الرحمن بن ثروان الأودي عن سفيان الثوري عن زيد بن الحباب العكلي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","هزيل بن شرحبيل عن المغيرة"
"19178","سَعْدُ بْنُ عُبَيْدَةَ  ، عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  997  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  سُلَيْمَانُ بْنُ كَثِيرٍ ،  عَنْ  حُصَيْنٍ ،  عَنْ  سَعْدِ بْنِ عُبَيْدَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي بَعْضِ مَغَازِيهِ فَنَزَلَ لِحَاجَتِهِ فَأَتَيْتُهُ بِوَضُوءٍ  ، وَعَلَيْهِ جُبَّةٌ ضَيِّقَةٌ ، فَأَخْرَجَ يَدَهُ مِنْ تَحْتِهَا فَصَبَبْتُ عَلَيْهِ فَتَوَضَّأَ وَمَسَحَ خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 997","","المغيرة بن شعبة عن سعد بن عبيدة السلمي عن حصين بن عبد الرحمن السلمي عن سليمان بن كثير الأصيد عن محمد بن كثير العبدي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سعد بن عبيدة عن المغيرة بن شعبة"
"19179","ثَابِتُ بْنُ عُبَيْدٍ  ، عَنِ  الْمُغِيرَةِ  998  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  مُحَمَّدُ بْنُ الْحَسَنِ الْمُزَنِيُّ ،  ثَنَا  أَبُو سَعْدٍ الْبَقَّالُ ،  عَنْ  ثَابِتِ بْنِ عُبَيْدٍ ،  قَالَ  :  صَلَّيْتُ خَلْفَ الْمُغِيرَةِ بْنِ شُعْبَةَ فَلَمْ يَجْلِسْ فِي الثَّانِيَةِ ، فَسَبَّحَ بِهِ  الْقَوْمُ  فَمَضَى         [20/416]      فِي صَلَاتِهِ ، فَلَمَّا قَضَى صَلَاتَهُ سَجَدَ سَجْدَتَيْنِ ثُمَّ سَلَّمَ ثُمَّ الْتَفَتَ إِلَى  الْقَوْمِ  فَقَالَ :  لَوْ سَبَّحْتُمْ قَبْلَ أَنْ أَسْتَوِيَ قَائِمًا جَلَسْتُ ، وَلَكِنْ هَكَذَا صَلَّى بِنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 998","","المغيرة بن شعبة عن ثابت بن عبيد الأنصاري عن سعيد بن المرزبان عن محمد بن الحسن المزني عن وهب بن بقية الواسطي عن بحشل عن الطبراني","ثابت بن عبيد عن المغيرة"
"19180","عُبَيْدُ اللهِ الثَّقَفِيُّ  ، عَنِ  الْمُغِيرَةِ  999  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  يُونُسُ بْنُ الْحَارِثِ الطَّائِفِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ اللهِ أَبُو عَوْنٍ الثَّقَفِيُّ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَسْتَحِبُّ أَنْ يُصَلِّيَ عَلَى فَرْوَةٍ مَدْبُوغَةٍ  أَوْ حَصِيرٍ  .","","Al-Mu'jam al-Kabir 999","","المغيرة بن شعبة عن عبيد الله بن سعيد الثقفي عن محمد بن عبيد الله بن سعيد الثقفي عن يونس بن الحارث الطائفي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبيد الله الثقفي عن المغيرة"
"19181","عَبْدُ الرَّحْمَنِ بْنُ أَبِي نُعْمٍ أَبُو الْحَكَمِ الْبَجَلِيُّ  ، عَنِ  الْمُغِيرَةِ  1000  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  بُكَيْرُ بْنُ عَامِرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي نُعْمٍ ، زَعَمَ  أَنَّ الْمُغِيرَةَ بْنَ شُعْبَةَ ،  حَدَّثَهُ  أَنَّهُ مَشَى مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَتَى بَعْضَ تِلْكَ الْأَوْدِيَةِ فَدَخَلَهَا فَقَضَى حَاجَتَهُ ثُمَّ خَرَجَ فَتَوَضَّأَ وَخَلَعَ الْخُفَّيْنِ ، فَلَمَّا لَبِسَ وَجَدَ بَعْدَ ذَلِكَ رِيحًا ، فَعَادَ فَتَوَضَّأَ وَمَسَحَ عَلَى الْخُفَّيْنِ ، فَقُلْتُ : أَنَسِيتَ يَا نَبِيَّ اللهِ ؟ قَالَ :  لَا بَلْ أَنْتَ نَسِيتَ ، بِهَذَا أَمَرَنِي رَبِّي عَزَّ وَجَلَّ  .","","Al-Mu'jam al-Kabir 1000","","المغيرة بن شعبة عن عبد الرحمن بن أبي نعم البجلي عن بكير بن عامر البجلي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الرحمن بن أبي نعم أبو الحكم البجلي عن المغيرة"
"19182","1001  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  الْحَسَنُ بْنُ صَالِحٍ ،  عَنْ  بُكَيْرِ بْنِ عَامِرٍ الْبَجَلِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي نُعْمٍ ،         [20/417]      عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  تَوَضَّأَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَمَسَحَ عَلَى خُفَّيْهِ  فَقُلْتُ : يَا رَسُولَ اللهِ ، أَنَسِيتَ ؟ قَالَ : "" بَلْ أَنْتَ نَسِيتَ ، بِهَذَا أَمَرَنِي رَبِّي  .","","Al-Mu'jam al-Kabir 1001","","المغيرة بن شعبة عن عبد الرحمن بن أبي نعم البجلي عن بكير بن عامر البجلي عن الحسن بن صالح بن صالح بن حي عن أحمد بن عبد الله اليربوعي عن محمد بن أحمد بن النضر النضري عن الطبراني","عبد الرحمن بن أبي نعم أبو الحكم البجلي عن المغيرة"
"19183","1002  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  مِنْدَلُ بْنُ عَلِيٍّ ، وَأَبِي  ،  عَنْ  بُكَيْرِ بْنِ عَامِرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي نُعْمٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ ،  فَقُلْتُ : يَا رَسُولَ اللهِ أَنَسِيتَ ؟ فَقَالَ : "" بَلْ أَنْتَ نَسِيتَ ، بِهَذَا أَمَرَنِي رَبِّي "" .","","Al-Mu'jam al-Kabir 1002","","المغيرة بن شعبة عن عبد الرحمن بن أبي نعم البجلي عن بكير بن عامر البجلي عن عبد الحميد بن عبد الرحمن بشمين عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","عبد الرحمن بن أبي نعم أبو الحكم البجلي عن المغيرة"
"19184","أَبُو بُرْدَةَ بْنُ أَبِي مُوسَى  ، عَنِ  الْمُغِيرَةِ  1003  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ الْبَصْرِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، وَأَبُو الْوَلِيدِ الطَّيَالِسِيُّ قَالَا ،  ثَنَا  أَبُو هِلَالٍ ،  عَنْ  حُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  أَبِي بُرْدَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  أَكَلْتُ يَوْمًا ثُمَّ أَتَيْتُ الْمَسْجِدَ وَالنَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي ، فَلَمَّا قَضَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَاتَهُ قَالَ :  مَنْ أَكَلَ مِنْ هَذِهِ الشَّجَرَةِ شَيْئًا فَلَا يَقْرَبَنَّ مَسْجِدَنَا  . قُلْتُ : يَا رَسُولَ اللهِ ، نَاوِلْنِي يَدَكَ ، فَأَدْخَلْتُهَا صَدْرِي فَرَآهُ مَعْصُوبًا فَقَالَ : "" إِلَّا مِنْ عُذْرٍ "" .","","Al-Mu'jam al-Kabir 1003","","المغيرة بن شعبة عن أبو بردة بن أبي موسى الأشعري عن حميد بن هلال العدوي عن محمد بن سليم الراسبي عن أبو الوليد الطيالسي عن محمد بن محمد بن حيان التمار عن الطبراني","أبو بردة بن أبي موسى عن المغيرة"
"19185","1004  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ بْنِ حِسَابٍ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ، وَعَمْرِو بْنِ صَالِحٍ وَحُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  أَبِي بُرْدَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَجَدَ رِيحَ ثُومٍ فَقَالَ : "" فَمَنْ هَذَا ؟ "" قَالَ :  الْمُغِيرَةُ بْنُ شُعْبَةَ  ،  أَعْزِمُ  عَلَيْكَ أَوْ أَقْسَمْتُ عَلَيْكَ  يَا رَسُولَ اللهِ ، لَمَا أَدْخَلْتَ يَدَكَ ، فَإِذَا عَلَى صَدْرِهِ  حِزَامٌ  ، قَالَ :  أَرَى لَكَ عُذْرًا  .         [20/418]","","Al-Mu'jam al-Kabir 1004","","أبو بردة بن أبي موسى الأشعري عن حميد بن هلال العدوي عن حماد بن زيد عن محمد بن عبيد بن حساب الغبري عن محمد بن علي بن زيد الصائغ عن الطبراني","أبو بردة بن أبي موسى عن المغيرة"
"19186","1005  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ النَّسَوِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ مَهْدِيٍّ الْمِصِّيصِيُّ ،  ثَنَا  عُمَرُ بْنُ رُدَيْحٍ ،  عَنْ  عَطَاءِ بْنِ أَبِي مَيْمُونَةَ ،  عَنْ  أَبِي بُرْدَةَ ،  عَنِ  الْمُغِيرَةِ ، قَالَ :  آخِرُ غَزَاةٍ غَزَوْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَنَا أَنْ نَمْسَحَ عَلَى خِفَافِنَا  : "" لِلْمُسَافِرِ ثَلَاثَةُ أَيَّامٍ وَلَيَالِيهِنَّ ، وَلِلْمُقِيمِ يَوْمٌ وَلَيْلَةٌ مَا لَمْ يَخْلَعْ "" .","","Al-Mu'jam al-Kabir 1005","","المغيرة بن شعبة عن أبو بردة بن أبي موسى الأشعري عن عطاء بن أبي ميمونة البصرى عن عمر بن رديح البصري عن إبراهيم بن مهدي المصيصي عن الحسن بن علي بن الوليد الفسوي عن الطبراني","أبو بردة بن أبي موسى عن المغيرة"
"19187","عَبْدُ اللهِ بْنُ بُرَيْدَةَ الْأَسْلَمِيُّ  ، عَنِ  الْمُغِيرَةِ  1006  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، وَعَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَا ،  ثَنَا  الْحُسَيْنُ بْنُ حُرَيْثٍ الْمَرْوَزِيُّ ، قَالَا ،  ثَنَا  الْفَضْلُ بْنُ مُوسَى ،  عَنْ  عَبْدِ الْمُؤْمِنِ ،  عَنْ  خَالِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ  وَصَلَّى وَأَقَامَنِي عَنْ يَمِينِهِ  .","","Al-Mu'jam al-Kabir 1006","","المغيرة بن شعبة عن عبد الله بن بريدة عن خالد بن عبيد العتكي عن عبد المؤمن بن خالد المروزي عن الفضل بن موسى السيناني عن الحسين بن حريث الخزاعي عن عبد الله بن أحمد بن حنبل عن الطبراني","عبد الله بن بريدة الأسلمي عن المغيرة"
"19188","قَبِيصَةُ بْنُ بُرْمَةَ الْأَسَدِيُّ  ، عَنِ  الْمُغِيرَةِ  1007  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلَطِيُّ ،  ثَنَا  أَبُو نُعَيْمٍ ، (  ح  )  وَحَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  الْحِمَّانِيُّ ، قَالُوا ،  ثَنَا  عُبَيْدُ اللهِ بْنُ إِيَادٍ ،  عَنْ  قَبِيصَةَ بْنِ بُرْمَةَ الْأَسَدِيِّ ،  عَنِ  الْمُغِيرَةِ ، قَالَ :  خَرَجْتُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي بَعْضِ مَا كَانَ يُسَافِرُ  ، فَسِرْنَا حَتَّى إِذَا كَانَ فِي وَقْتِ السَّحَرِ انْطَلَقَ فِي حَرْفٍ ، فَتَوَارَى عَنِّي ثُمَّ جَاءَ فَدَعَا بِطَهُورٍ وَعَلَيْهِ جُبَّةٌ شَامِيَّةٌ ضَيِّقَةُ الْكُمَّيْنِ ، فَأَخْرَجَ يَدَهُ مِنْ أَسْفَلِ الْجُبَّةِ وَغَسَلَ وَجْهَهُ وَيَدَيْهِ وَمَسَحَ عَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 1007","","المغيرة بن شعبة عن قبيصة بن برمة الأسدي عن عبيد الله بن إياد بن لقيط السدوسي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","قبيصة بن برمة الأسدي عن المغيرة"
"19189","[20/419]      سُوَيْدُ بْنُ سَرْحَانَ  ، عَنِ  الْمُغِيرَةِ  1008  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلَطِيُّ ،  ثَنَا  أَبُو نُعَيْمٍ ، (  ح  )  وَحَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَلِيٍّ الْأَبَّارُ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، قَالُوا ،  ثَنَا  عُبَيْدُ اللهِ بْنُ إِيَادِ بْنِ لَقِيطٍ ،  عَنْ  سُوَيْدِ بْنِ سَرْحَانَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَكَلَ طَعَامًا فَأُقِيمَتِ الصَّلَاةُ فَقَامَ وَقَدْ كَانَ تَوَضَّأَ قَبْلَ ذَلِكَ ، فَأَتَيْتُهُ بِمَاءٍ يَتَوَضَّأُ فَانْتَهَرَنِي ، فَسَاءَنِي ذَلِكَ وَاللهِ فَشَكَوْتُ إِلَى  عُمَرَ  فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّ  الْمُغِيرَةَ بْنَ شُعْبَةَ  قَدْ شَقَّ عَلَيْهِ انْتِهَارُكَ إِيَّاهُ وَخَشِيَ أَنْ يَكُونَ فِي نَفْسِكَ عَلَيْهِ شَيْءٌ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ فِي نَفْسِي عَلَيْهِ شَيْءٌ إِلَّا خَيْرٌ ، وَلَكِنَّهُ أَتَانِي بِمَاءٍ لِأَتَوَضَّأَ  ، وَإِنَّمَا أَكَلْتُ طَعَامًا ، وَلَوْ فَعَلْتُ فَعَلَ النَّاسُ بَعْدِي "" .","","Al-Mu'jam al-Kabir 1008","","المغيرة بن شعبة عن سويد بن سرحان عن عبيد الله بن إياد بن لقيط السدوسي عن أبو الوليد الطيالسي عن أحمد بن علي بن مسلم النخشبي عن الطبراني","سويد بن سرحان عن المغيرة"
"19190","زِيَادُ بْنُ عِلَاقَةَ  ، عَنِ  الْمُغِيرَةِ  1009  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ ، قَالَ :  سَمِعْتُ  زِيَادَ بْنَ عِلَاقَةَ ، يَقُولُ :  سَمِعْتُ  الْمُغِيرَةَ بْنَ شُعْبَةَ ، يَقُولُ :  إِنْ كَانَ -  يَعْنِي النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - يُصَلِّي حَتَّى تَرِمَ  قَدَمُهُ أَوْ سَاقَاهُ  ، فَيُقَالُ لَهُ ، فَيَقُولُ :  أَفَلَا أَكُونُ عَبْدًا شَكُورًا  ؟  .","","Al-Mu'jam al-Kabir 1009","","المغيرة بن شعبة عن زياد بن علاقة الثعلبي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","زياد بن علاقة عن المغيرة"
"19191","1010  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،         [20/420]      عَنِ  ابْنِ عُيَيْنَةَ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي حَتَّى تَنْفَطِرَ قَدَمَاهُ فَقِيلَ لَهُ : أَلَيْسَ قَدْ غَفَرَ اللهُ لَكَ مَا تَقَدَّمَ مِنْ ذَنْبِكَ وَمَا تَأَخَّرَ ؟ قَالَ :  أَفَلَا أَكُونُ عَبْدًا شَكُورًا  ؟ "" .","","Al-Mu'jam al-Kabir 1010","","المغيرة بن شعبة عن زياد بن علاقة الثعلبي عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","زياد بن علاقة عن المغيرة"
"19192","1011  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنِ  الْمُغِيرَةِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُصَلِّي حَتَّى تَرِمَ قَدَمَاهُ ، فَقِيلَ لَهُ فِي ذَلِكَ : أَتَفْعَلُ وَقَدْ غَفَرَ اللهُ لَكَ مَا تَقَدَّمَ مِنْ ذَنْبِكَ وَمَا تَأَخَّرَ ؟ قَالَ :  أَفَلَا أَكُونُ عَبْدًا شَكُورًا  ؟ "" .","","Al-Mu'jam al-Kabir 1011","","المغيرة بن شعبة عن زياد بن علاقة الثعلبي عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","زياد بن علاقة عن المغيرة"
"19193","1012  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ الرَّقِّيُّ ، وَمُحَمَّدُ بْنُ الْحَسَنِ بْنِ كَيْسَانَ الْمِصِّيصِيُّ قَالَا ،  ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  جُعِلَتْ قُرَّةُ عَيْنِي فِي الصَّلَاةِ  .","","Al-Mu'jam al-Kabir 1012","","المغيرة بن شعبة عن زياد بن علاقة الثعلبي عن سفيان الثوري عن موسى بن مسعود النهدي عن محمد بن الحسن بن كيسان المصيصي عن الطبراني","زياد بن علاقة عن المغيرة"
"19194","1013  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا  تَسُبُّوا  الْأَمْوَاتَ فَتُؤْذُوا الْأَحْيَاءَ  .","","Al-Mu'jam al-Kabir 1013","","المغيرة بن شعبة عن زياد بن علاقة الثعلبي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","زياد بن علاقة عن المغيرة"
"19195","1014  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عُمَرَ ، (  ح  )  وَحَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، قَالَا ،  ثَنَا  زَائِدَةُ ،         [20/421]      ثَنَا  زِيَادُ بْنُ عِلَاقَةَ ، قَالَ :  سَمِعْتُ  الْمُغِيرَةَ بْنَ شُعْبَةَ ، يَقُولُ :  انْكَسَفَتِ الشَّمْسُ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الشَّمْسَ وَالْقَمَرَ آيَتَانِ مِنْ آيَاتِ اللهِ  ، لَا  يَنْكَسِفَانِ  لِمَوْتِ أَحَدٍ وَلَا لِحَيَاتِهِ ، فَإِذَا رَأَيْتُمُوهُمَا فَادْعُوا اللهَ وَصَلُّوا حَتَّى تَنْكَشِفَ  .","","Al-Mu'jam al-Kabir 1014","","المغيرة بن شعبة عن زياد بن علاقة الثعلبي عن زائدة بن قدامة عن أبو الوليد الطيالسي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","زياد بن علاقة عن المغيرة"
"19196","1015  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَخْبَرَنِي  إِسْرَائِيلُ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  انْكَسَفَتِ الشَّمْسُ يَوْمَ مَاتَ  إِبْرَاهِيمُ ابْنُ رَسُولِ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الشَّمْسَ وَالْقَمَرَ آيَتَانِ مِنْ آيَاتِ اللهِ لَا  تَنْكَسِفَانِ  لِمَوْتِ أَحَدٍ وَلَا لِحَيَاتِهِ  ، فَإِذَا رَأَيْتُمُوهُمَا فَعَلَيْكُمْ بِالدُّعَاءِ حَتَّى تَنْكَشِفَ  .","","Al-Mu'jam al-Kabir 1015","","المغيرة بن شعبة عن زياد بن علاقة الثعلبي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن عثمان بن حفص الضبي عن الطبراني","زياد بن علاقة عن المغيرة"
"19197","1016  -  حَدَّثَنَا  مَحْمُودُ بْنُ عَلِيٍّ الْبَزَّازُ الْأَصْبَهَانِيُّ ،  ثَنَا  يُونُسُ بْنُ حَبِيبٍ ،  ثَنَا  أَبُو دَاوُدَ ،  ثَنَا  أَبُو عَوَانَةَ ، وَقَيْسٌ ، وَشَيْبَانُ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، قَالَ :  لَمَّا مَاتَ  إِبْرَاهِيمُ ابْنُ النَّبِيِّ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ انْكَسَفَتِ الشَّمْسُ ، فَقَالَ النَّاسُ : انْكَسَفَتْ لِمَوْتِ  إِبْرَاهِيمَ  ، فَخَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  يَا أَيُّهَا النَّاسُ ، إِنَّ الشَّمْسَ وَالْقَمَرَ لَا  يَنْكَسِفَانِ  لِمَوْتِ أَحَدٍ وَلَا لِحَيَاتِهِ  ، وَلَكِنَّهُمَا آيَتَانِ مِنْ آيَاتِ اللهِ ، فَإِذَا كَانَ ذَلِكَ فَصَلُّوا حَتَّى تَنْكَشِفَ  .","","Al-Mu'jam al-Kabir 1016","","المغيرة بن شعبة عن زياد بن علاقة الثعلبي عن شيبان بن عبد الرحمن المؤدب عن أبو داود الطيالسي عن يونس بن حبيب الماصر عن محمود بن علي بن مالك الشيباني عن الطبراني","زياد بن علاقة عن المغيرة"
"19198","1017  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  هَارُونُ بْنُ زَيْدِ بْنِ أَبِي الزَّرْقَاءِ ،  ثَنَا  أَبُو أَحْمَدَ الْكُوفِيُّ  ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،         [20/422]      قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ أَحَدٍ إِلَّا جُعِلَ مَعَهُ قَرِينٌ مِنَ الْجِنِّ  ، قَالُوا : وَلَا أَنْتَ يَا رَسُولَ اللهِ ؟ قَالَ : "" وَلَا أَنَا ، إِلَّا أَنَّ اللهَ أَعَانَنِي عَلَيْهِ  فَأَسْلَمَ  ، فَلَا يَأْمُرُنِي إِلَّا بِخَيْرٍ  .  في طبعة مكتبة ابن تيمية : (أبو أحمد [حماد] الكوفي) ووضع المحقق : حماد بين معقوفين إشارة إلى زيادته ولكنه لم ينبه عليه وهو يشير به إلى أن الصواب : (أبو حماد) وهو كذلك ، وينظر مصادر الترجمة والله أعلم .","","Al-Mu'jam al-Kabir 1017","","المغيرة بن شعبة عن زياد بن علاقة الثعلبي عن المفضل بن صدقة الحنفي عن هارون بن زيد بن أبي الزرقاء عن عبد الله بن أحمد الجواليقي عن الطبراني","زياد بن علاقة عن المغيرة"
"19199","1018  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ،  ثَنَا  يَحْيَى بْنُ طَلْحَةَ الْيَرْبُوعِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 1018","","المغيرة بن شعبة عن زياد بن علاقة الثعلبي عن شريك بن عبد الله النخعي عن يحيى بن طلحة بن أبي كثير اليربوعي عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","زياد بن علاقة عن المغيرة"
"19200","1019  -  حَدَّثَنَا  مَحْمُودُ بْنُ عَلِيٍّ الْبَزَّارُ ،  ثَنَا  يُونُسُ بْنُ حَبِيبٍ ،  ثَنَا  أَبُو دَاوُدَ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ، قَالَ :  صَلَّى الْمُغِيرَةُ بْنُ شُعْبَةَ فَقَامَ فِي الرَّكْعَتَيْنِ الْأُولَيَيْنِ ، فَسَبَّحُوا بِهِ فَمَضَى فِي صَلَاتِهِ ، فَلَمَّا فَرَغَ سَجَدَ سَجْدَتَيْنِ ،  وَقَالَ : هَكَذَا فَعَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 1019","","المغيرة بن شعبة عن زياد بن علاقة الثعلبي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن أبو داود الطيالسي عن يونس بن حبيب الماصر عن محمود بن علي بن مالك الشيباني عن الطبراني","زياد بن علاقة عن المغيرة"
