hadiths[392]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"7811","«يا آل محمد! من حج منكم فليهل بعمرة في حجته»","صحيح","Sahih al-Jami al-Saghir 7811","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7812","«يا أبا بكر! إن لكل قوم عيدا وهذا عيدنا»","صحيح","Sahih al-Jami al-Saghir 7812","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7813","«يا أبا بكر! قل: اللهم فاطر السموات والأرض عالم الغيب والشهادة لا إله إلا أنت رب كل شيء ومليكه أعوذ بك من شر نفسي ومن شر الشيطان وشركه وأن أقترف على نفسي سوءا أو أجره إلى مسلم»","صحيح","Sahih al-Jami al-Saghir 7813","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7814","«يا أبا بكر! ما ظنك باثنين الله ثالثهما»","صحيح","Sahih al-Jami al-Saghir 7814","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7815","«يا أبا ثعلبة: كل ما ردت عليك قوسك وكلبك المعلم ويدك ذكي وغير ذكي»","صحيح","Sahih al-Jami al-Saghir 7815","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7816","يا أبا ذر! أترى أن كثرة المال هوالغنى؟ إنما الغنى غنى القلب والفقر فقر القلب من كان الغنى في قلبه فلا يضره ما لقي من الدنيا ومن كان الفقر في قلبه فلا يغنيه ما أكثر له في الدنيا وإنما يضر نفسه شحها","صحيح","Sahih al-Jami al-Saghir 7816","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7817","«يا أبا ذر! إذا صمت من الشهر ثلاثة أيام فصم ثلاث عشرة وأربع عشرة وخمس عشرة»","صحيح","Sahih al-Jami al-Saghir 7817","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7818","«يا أبا ذر! إذا طبخت فأكثر المرق وتعاهد جيرانك»","صحيح","Sahih al-Jami al-Saghir 7818","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7819","«يا أبا ذر! أرأيت إن أصاب الناس جوع شديد لا تستطيع أن تقوم من فراشك إلى مسجدك كيف تصنع؟ تعفف ; يا أبا ذر؟ أرأيت إن أصاب الناس موت شديد يكون البيت فيه بالعبد - يعني القبر - كيف تصنع؟ اصبر ; يا أبا ذر: أرأيت إن قتل الناس بعضهم بعضا حتى تغرق حجارة الزيت من الدماء كيف تصنع؟ اقعد في بيتك وأغلق عليك بابك قال: فإن لم أترك؟ قال: فأت من كنت معه فكن فيهم قال: فآخذ سلاحي؟ قال: إذن تشاركهم فيما هم فيه ولكن إن خشيت أن يردعك شعاع السيف فألق من طرف ردائك على وجهك كي يبوء بإثمه وإثمك ويكون من أصحاب النار»","صحيح","Sahih al-Jami al-Saghir 7819","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7820","«يا أبا ذر! ألا أدلك على كنز من كنوز الجنة؟: لا حول ولا قوة إلا بالله»","صحيح","Sahih al-Jami al-Saghir 7820","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7821","«يا أبا ذر! ألا أعلمك كلمات تقولهن تلحق من سبقك ولا يدركك إلا من أخذ بعملك؟ تكبر دبر كل صلاة ثلاثا وثلاثين وتسبح ثلاثا وثلاثين وتحمد ثلاثا وثلاثين وتختم بلا إله إلا الله وحده لا شريك له له الملك وله الحمد وهو على كل شيء قدير من قال ذلك غفرت له ذنوبه ولو كانت مثل زبد البحر»","صحيح","Sahih al-Jami al-Saghir 7821","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7822","«يا أبا ذر! إنك امرؤ فيك جاهلية إنهم إخوانكم فضلكم الله عليهم فمن لم يلائمكم فبيعوه ولا تعذبوا خلق الله»","صحيح","Sahih al-Jami al-Saghir 7822","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7823","«يا أبا ذر! إنك ضعيف وإنها أمانة وإنها يوم القيامة خزي وندامة إلا من أخذها بحقها وأدى الذي عليه فيها»","صحيح","Sahih al-Jami al-Saghir 7823","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7824","«يا أبا ذر! إنه سيكون بعدي أمراء يميتون الصلاة فصل الصلاة لوقتها فإن صليت لوقتها كانت لك نافلة وإلا كنت قد أحرزت صلاتك»","صحيح","Sahih al-Jami al-Saghir 7824","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7825","«يا أبا ذر إني أراك ضعيفا وإني أحب لك ما أحب لنفسي لا تتأمرن على اثنين ولا تولين مال يتيم»","صحيح","Sahih al-Jami al-Saghir 7825","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7826","«يا أبا ذر! ما أحب أن لي أحدا ذهبا أمسى ثالثة وعندي منه دينار إلا دينارا أرصده لدين إلا أن أقول به في عباد الله هكذا وهكذا وهكذا يا أبا ذر! الأكثرون هم الأقلون إلا من قال هكذا وهكذا»","صحيح","Sahih al-Jami al-Saghir 7826","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7827","«يا أبا ذر! ما أحب أن لي مثل أحد ذهبا أنفقه كله إلا ثلاثة دنانير»","صحيح","Sahih al-Jami al-Saghir 7827","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7828","«يا أبا ذر! هل تدري أين تذهب الشمس إذا غابت؟ فإنها تذهب حتى تأتي العرش فتسجد بين يدي ربها فتستأذن في الرجوع فيأذن لها وكأنها قد قيل لها: ارجعى من حيث جئت فتطلع من مغربها فذلك مستقرها»","صحيح","Sahih al-Jami al-Saghir 7828","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7829","«يا أبا سعيد! من رضي بالله ربا وبالإسلام دينا وبمحمد نبيا وجبت له الجنة وأخرى يرفع بها العبد مائة درجة في الجنة ما بين كل درجتين كما بين السماء والأرض الجهاد في سبيل الله الجهاد في سبيل الله»","صحيح","Sahih al-Jami al-Saghir 7829","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7830","«يا أبا عمير! ما فعل النغير؟»","صحيح","Sahih al-Jami al-Saghir 7830","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7831","«يا أبا موسى! لقد أوتيت مزمارا من مزامير آل داود»","صحيح","Sahih al-Jami al-Saghir 7831","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7832","«يا أبا هريرة! جف القلم بما أنت لاق فاختص على ذلك أو ذر»","صحيح","Sahih al-Jami al-Saghir 7832","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7833","«يا أبا هريرة! كن ورعا تكن من أعبد الناس وارض بما قسم الله لك تكن من أغنى الناس وأحب للمسلمين والمؤمنين ما تحب لنفسك وأهل بيتك واكره لهم ما تكره لنفسك وأهل بيتك تكن مؤمنا وجأور من جأورت بإحسان تكن مسلما وإياك وكثرة الضحك فإن كثرة الضحك فساد القلب»","حسن","Sahih al-Jami al-Saghir 7833","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7834","«يا ابن آدم! إنك أن تبذل الفضل خير لك وأن تمسكه شر لك ولا تلام على كفاف وابدأ بمن تعول واليد العليا خير من اليد السفلى»","صحيح","Sahih al-Jami al-Saghir 7834","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7835","«يا ابن الأكوع! ملكت فاسجح»","صحيح","Sahih al-Jami al-Saghir 7835","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7836","«يا ابن الخصاصية! ما أصبحت تنقم على الله؟ أصبحت تماشي رسول الله»","صحيح","Sahih al-Jami al-Saghir 7836","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7837","«يا ابن الخطاب! اذهب فناد في الناس: إنه لا يدخل الجنة إلا المؤمنون»","صحيح","Sahih al-Jami al-Saghir 7837","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7838","يا ابن حوالة! إذا رأيت الخلافة قد نزلت الأرض المقدسة فقد دنت الزلازل والبلابل والأمور العظام والساعة يومئذ أقرب من الناس من يدي هذه من رأسك","صحيح","Sahih al-Jami al-Saghir 7838","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7839","«يا ابن عابس» [! ألا أخبرك بأفضل ما تعوذ به المتعوذون؟: {قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ} و {قُلْ أَعُوذُ بِرَبِّ النَّاسِ} هاتين السورتين]","صحيح","Sahih al-Jami al-Saghir 7839","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7840","«يا ابن عوف! اركب فرسك ثم ناد: إن الجنة لا تحل إلا لمؤمن»","صحيح","Sahih al-Jami al-Saghir 7840","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7841","«يا أبي: إن ربي تبارك وتعالى أرسل إلي أن اقرأ القرآن على حرف فرددت إليه: أن هون على أمتي فأرسل إلي الثانية أن اقرأه على حرفين فرددت إليه أن هون على أمتي فأرسل إلي الثالثة: أن اقرأه على سبعة أحرف ولك بكل ردة رددتها مسألة تسألنيها فقلت: اللهم اغفر لأمتي اللهم اغفر لأمتي وأخرت الثالثة ليوم يرغب إلي فيه الخلق كلهم حتى إبراهيم»","صحيح","Sahih al-Jami al-Saghir 7841","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7842","«يا أبي: إنه أنزل القرآن على سبعة أحرف كلهم شاف كاف»","صحيح","Sahih al-Jami al-Saghir 7842","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7843","يا أبي: إني أقرئت القرآن فقيل لي: على حرف أو حرفين؟ فقال الملك الذي معي: قل على حرفين قلت: على حرفين فقيل لي: على حرفين أو ثلاثة؟ فقال الملك الذي معي قل: على ثلاثة قلت: على ثلاثة حتى بلغ سبعة أحرف ثم قال: ليس منها إلا شاف كاف إن قلت: سميعا عليما وإن قلت: عزيزا حكيما ما لم تختم آية عذاب برحمة أو آية رحمة بعذاب","صحيح","Sahih al-Jami al-Saghir 7843","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7844","«يا إخواني! لمثل هذا اليوم فأعدوا»","حسن","Sahih al-Jami al-Saghir 7844","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7845","«يا أسامة! أتشفع في حد من حدود الله؟!»","صحيح","Sahih al-Jami al-Saghir 7845","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7846","«يا أسامة! كيف تصنع بلا إله إلا الله إذا جاءت يوم القيامة؟!»","صحيح","Sahih al-Jami al-Saghir 7846","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7847","«يا أسماء! إن المرأة إذا بلغت المحيض لم يصلح أن يرى منها شيء إلا هذا وهذا» - وأشار إلى وجهه وكفيه -","حسن","Sahih al-Jami al-Saghir 7847","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7848","«يا أشج! إن فيك لخصلتين يحبهما الله: الحلم والتؤدة»","صحيح","Sahih al-Jami al-Saghir 7848","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7849","«يا أعرابي! إن الله غضب على سبطين من بني إسرائيل فمسخهم دواب يدبون في الأرض فلا أدري لعل هذا منها يعني الضب فلست آكلها ولا أنهى عنها»","صحيح","Sahih al-Jami al-Saghir 7849","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7850","«"" *» ... خير الرفقاء اربعة ... وخير السرايا أربعمائة وخير الجيوش أربعة آلاف ولن يغلب إثنا عشر ألفًا من قلة","صحيح","Sahih al-Jami al-Saghir 7850","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7851","«يا أم العلاء! أبشري فإن مرض المسلم يذهب الله به خطاياه كما تذهب النار خبث الذهب والفضة»","صحيح","Sahih al-Jami al-Saghir 7851","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7852","«يا أم حارثة! إنها جنات في جنة وإن ابنك أصاب الفردوس الأعلى والفردوس ربوة الجنة وأوسطها وأفضلها»","صحيح","Sahih al-Jami al-Saghir 7852","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7853","«يا أم حارثة! إنها ليست بجنة واحدة ولكنها جنان كثيرة وإن حارثة لفي الفردوس الأعلى»","صحيح","Sahih al-Jami al-Saghir 7853","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7854","«يا أم سلمة! إنه ليس آدمي إلا وقلبه بين إصبعين من أصابع الله فمن شاء أقام ومن شاء أزاغ»","صحيح","Sahih al-Jami al-Saghir 7854","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7855","«يا أم سلمة! لا تؤذيني في عائشة فإنه والله ما نزل علي الوحي وأنا في لحاف امرأة منكن غيرها»","صحيح","Sahih al-Jami al-Saghir 7855","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7856","«يا أم سليم! أما تعلمين أني اشترطت على ربي فقلت: إنما أنا بشر أرضى كما يرضى البشر وأغضب كما يغضب البشر فأيما أحد دعوت عليه من أمتي بدعوة ليس لها بأهل أن تجعلها له طهورا وزكاة وقربة تقربه بها منك يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 7856","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7857","يا أم فلان! اجلسي في أي نواحي السكك شئت، أجلس إليك","صحيح","Sahih al-Jami al-Saghir 7857","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7858","«يا أنجشة! رويدك سوقك بالقوارير»","صحيح","Sahih al-Jami al-Saghir 7858","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7859","«يا أنس! إن الناس يمصرون أمصارا وإن مصرا منها يقال لها البصرة [أ] والبصيرة فإن مررت بها أو دخلتها فإياك وسباخها وكلاءها وسوقها وباب أمرائها وعليك بضواحيها فإنه يكون بها خسف وقذف ورجف وقوم يبيتون يصبحون قردة وخنازير»","صحيح","Sahih al-Jami al-Saghir 7859","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7860","«يا أهل القرآن! أوتروا فإن الله يحب الوتر»","صحيح","Sahih al-Jami al-Saghir 7860","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7861","«يا أيها الناس! اتقوا الله وإن أمر عليكم عبد حبشي مجدع فاسمعوا له وأطيعوا ما أقام لكم كتاب الله»","صحيح","Sahih al-Jami al-Saghir 7861","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7862","« {يَا أَيُّهَا النَّاسُ اتَّقُوا رَبَّكُمُ الَّذِي خَلَقَكُمْ مِنْ نَفْسٍ وَاحِدَةٍ وَخَلَقَ مِنْهَا زَوْجَهَا وَبَثَّ مِنْهُمَا رِجَالاً كَثِيراً وَنِسَاءً وَاتَّقُوا اللَّهَ الَّذِي تَسَاءَلُونَ بِهِ وَالْأَرْحَامَ إِنَّ اللَّهَ كَانَ عَلَيْكُمْ رَقِيباً} . {يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَلْتَنْظُرْ نَفْسٌ مَا قَدَّمَتْ لِغَدٍ وَاتَّقُوا اللَّهَ إِنَّ اللَّهَ خَبِيرٌ بِمَا تَعْمَلُونَ} تصدق رجل من ديناره من درهمه من ثوبه من صاع بره من صاع تمره ولو بشق تمرة»","صحيح","Sahih al-Jami al-Saghir 7862","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7863","«يا أيها الناس! اذكروا الله اذكروا الله جاءت الراجفة تتبعها الرادفة جاءت الراجفة تتبعها الرادفة جاء الموت بما فيه»","حسن","Sahih al-Jami al-Saghir 7863","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7864","«يا أيها الناس! اربعوا على أنفسكم فإنكم لا تدعون أصم ولا غائبا إنكم تدعون سميعا قريبا وهو معكم»","صحيح","Sahih al-Jami al-Saghir 7864","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7865","«يا أيها الناس! أفشوا السلام وأطعموا الطعام وصلوا الأرحام وصلوا بالليل والناس نيام تدخلوا الجنة بسلام»","صحيح","Sahih al-Jami al-Saghir 7865","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7866","«يا أيها الناس! إن الشمس والقمر آيتان من آيات الله وإنهما لا ينكسفان لموت أحد ولا لحياته فإذا رأيتم شيئا من ذلك فصلوا حتى تنجلي إنه ليس من شيء توعدونه إلا وقد رأيته في صلاتي هذه ولقد جيء بالنار حين رأيتموني تأخرت مخافة أن يصيبني من لفحها حتى قلت: يا رب وأنا فيهم؟ ; ورأيت فيها صاحب المحجن يجر قصبه في النار كان يسرق الحاج بمحجنه فإن فطن به قال: إنما تعلق بمحجني! وإن غفل عنه ذهب به حتى رأيت فيها صاحبة الهرة التي ربطتها فلم تطعمها ولم تتركها تأكل من خشاش الأرض حتى ماتت جوعا ; وجيء بالجنة فذلك حين رأيتموني تقدمت حتى قمت في مقامي فمددت يدي وأنا أريد أن أتنأول من ثمرها شيئا لتنظروا إليه ثم بدا لي أن لا أفعل»","صحيح","Sahih al-Jami al-Saghir 7866","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7867","«يا أيها الناس! إن الله قد أذهب عنكم عبية الجاهلية وتعاظمها بآبائها فالناس رجلان: رجل بر تقي كريم على الله وفاجر شقي هين على الله والناس بنوآدم وخلق الله آدم من تراب»","حسن","Sahih al-Jami al-Saghir 7867","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7868","«يا أيها الناس! إن منكم منفرين فمن أم الناس فليتجوز فإن خلفه الضعيف والكبير وذا الحاجة»","صحيح","Sahih al-Jami al-Saghir 7868","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7869","«يا أيها الناس! إن هذا من غنائمكم أدوا الخيط والمخيط فما هو فوق فإن الغلول عار على أهله يوم القيامة وشنار ونار»","صحيح","Sahih al-Jami al-Saghir 7869","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7870","«يا أيها الناس! إنكم تحشرون إلى الله حفاة عراة غرلا {كَمَا بَدَأْنَا أَوَّلَ خَلْقٍ نُعِيدُهُ} ألا وإن أول الخلائق يكسا يوم القيامة إبراهيم ألا وإنه يجاء برجال من أمتي فيؤخذ بهم ذات الشمال فأقول يا رب أصحابي! فيقال: إنك لا تدري ما أحدثوا بعدك فأقول كما قال العبد الصالح: {وَكُنْتُ عَلَيْهِمْ شَهِيداً مَا دُمْتُ فِيهِمْ فَلَمَّا تَوَفَّيْتَنِي كُنْتَ أَنْتَ الرَّقِيبَ عَلَيْهِمْ} فيقال: إن هؤلاء لم يزالوا مرتدين على أعقابهم منذ فارقتهم»","صحيح","Sahih al-Jami al-Saghir 7870","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7871","«يا أيها الناس! إنكم لن تطيقوا كل ما أمرتكم به ولكن سددوا وقاربوا وأبشروا»","حسن","Sahih al-Jami al-Saghir 7871","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7872","«يا أيها الناس! إنه لا يحل لي مما أفاء الله عليكم قدر هذه إلا الخمس والخمس مردود عليكم»","صحيح","Sahih al-Jami al-Saghir 7872","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7873","«يا أيها الناس! إنه ليس لي من هذا الفيء شيء ولا هذا - وأشار إلى وبرة من سنام بعير - إلا الخمس والخمس مردود عليكم فأدوا الخياط والمخيط»","صحيح","Sahih al-Jami al-Saghir 7873","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7874","«يا أيها الناس إنها كانت أبينت لي ليلة القدر وإني خرجت لأخبركم بها فجاء رجلان يحتقان ومعهما الشيطان فنسيتها فالتمسوها في العشر الأواخر من رمضان التمسوها في التاسعة والسابعة والخامسة»","صحيح","Sahih al-Jami al-Saghir 7874","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7875","يا أيها الناس! إنها لم تكن فتنة على وجه الأرض منذ ذرأ الله ذرية آدم أعظم من فتنة الدجال وإن الله عز وجل لم يبعث نبيا إلا حذر أمته الدجال وأنا آخر الأنبياء وأنتم آخر الأمم وهو خارج فيكم لا محالة فإن يخرج وأنا بين أظهركم فأنا حجيج لكل مسلم وإن يخرج من بعدي فكل حجيج نفسه والله خليفتي على كل مسلم وإنه يخرج من خلة بين الشام والعراق فيعيث يمينا وشمالا يا عباد الله! أيها الناس! فاثبتوا فإني سأصفه لكم صفة لم يصفها إياه قبلي نبي، ... يقول: أنا ربكم ولا ترون ربكم حتى تموتوا وإنه أعور وإن ربكم ليس بأعور وإنه مكتوب بين عينيه: كافر يقرؤه كل مؤمن كاتب أو غير كاتب. وإن من فتنته أن معه جنة ونارا فناره جنة وجنته نار فمن ابتلي بناره فليستغث بالله وليقرأ فواتح الكهف ... وإن من فتنته أن يقول للأعرابي: أرأيت إن بعثت لك أباك وأمك أتشهد أني ربك؟ فيقول: نعم فيتمثل له شيطانان في صورة أبيه وأمه فيقولان: يا بني اتبعه فإنه ربك وإن من فتنته أن يسلط على نفس واحدة فيقتلها ينشرها بالمنشار حتى تلقى شقين ثم يقول: انظروا إلى عبدي هذا فإني أبعثه ثم يزعم أن له ربا غيري فيبعثه الله ويقول له الخبيث: من ربك؟ فيقول: ربي الله وأنت عدوالله أنت الدجال والله ما كنت قط أشد بصيرة بك مني اليوم. وإن من فتنته أن يأمر السماء أن تمطر فتمطر ويأمر الأرض أن تنبت فتنبت. وإن من فتنته أن يمر بالحي فيكذبونه فلا يبقى لهم سائمة إلا هلكت ; وإن من فتنته أن يمر بالحي فيصدقونه فيأمر السماء أن تمطر فتمطر ويأمر الأرض أن تنبت فتنبت حتى تروح مواشيهم من يومهم ذلك أسمن ما كانت وأعظمه وأمده خواصر وأدره ضروعا. وإنه لا يبقى شيء من الأرض إلا وطئه وظهر عليه إلا مكة والمدينة لا يأتيهما من نقب من أنقابهما إلا لقيته الملائكة بالسيوف صلتة حتى ينزل عند الضريب الأحمر عند منقطع السبخة فترجف المدينة بأهلها ثلاث رجفات فلا يبقى فيها منافق ولا منافقة إلا خرج إليه فتنفي الخبيث منها كما ينفي الكير خبث الحديد ويدعى ذلك اليوم يوم الخلاص قيل: فأين العرب يومئذ؟ قال: هم يومئذ قليل، ... وإمامهم رجل صالح فبينما إمامهم قد تقدم يصلي بهم الصبح إذ نزل عليهم عيسى ابن مريم الصبح فرجع ذلك الإمام ينكص يمشي القهقرى ليتقدم عيسى فيضع عيسى يده بين كتفيه ثم يقول له: تقدم فصل فإنها لك أقيمت فيصل بهم إمامهم فإذا انصرف قال عيسى: افتحوا الباب، فيفتحون ووراءه الدجال معه سبعون ألف يهودي كلهم ذو سيف محلى وساج فإذا نظر إليه الدجال ذاب كما يذوب الملح في الماء ; وينطلق هاربا، ... فيدركه عند باب لد الشرقي فيقتله فيهزم الله اليهود فلا يبقى شيء مما خلق الله عز وجل يتواقى به يهودي إلا أنطق الله ذلك الشيء لا حجر ولا شجر ولا حائط ولا دابة إلا الغرقدة فإنها من شجرهم لا تنطق إلا قال: يا عبد الله المسلم هذا يهودي فتعال اقتله. فيكون عيسى بن مريم في أمتي حكما عدلا وإماما مقسطا يدق الصليب ويذبح الخنزير ويضع الجزية ويترك الصدقة فلا يسعى على شاة ولا بعير وترفع الشحناء والتباغض وتنزع حمة كل ذات حمة حتى يدخل الوليد يده في في الحية فلا تضره وتضر الوليدة الأسد فلا يضرها ويكون الذئب في الغنم كأنه كلبها وتملأ الأرض من السلم كما يملأ الإناء من الماء وتكون الكلمة واحدة فلا يعبد إلا الله وتضع الحرب أوزارها وتسلب قريش ملكها وتكون الأرض كفاثور الفضة تنبت نباتها بعهد آدم حتى يجتمع النفر على القطف من العنب فيشبعهم يجتمع النفر على الرمانة فتشبعهم ويكون الثور بكذا وكذا من المال ويكون الفرس بالدريهمات، ... وإن قبل خروج الدجال ثلاث سنوات شداد يصيب الناس فيها جوع شديد يأمر الله السماء السنة الأولى أن تحبس ثلث مطرها ويأمر الأرض أن تحبس ثلث نباتها ثم يأمر السماء في السنة الثانية فتحبس ثلثي مطرها ويأمر الأرض فتحبس ثلثي نباتها ثم يأمر السماء في السنة الثالثة فتحبس مطرها كله فلا تقطر قطرة ويأمر الأرض فتحبس نباتها كله فلا تنبت خضراء فلا يبقى ذات ظلف إلا هلكت إلا ما شاء الله، قيل: فما يعيش الناس في ذلك الزمان؟ قال: التهليل والتكبير والتحميد ويجزئ ذلك عليهم مجزأة الطعام","صحيح","Sahih al-Jami al-Saghir 7875","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7876","«يا أيها الناس! إني إمامكم فلا تسبقوني بالركوع ولا بالسجود ولا بالقيام ولا بالقعود ولا بالانصراف فإني أراكم من أمامي ومن خلفي وايم الذي نفسي بيده لورأيتم ما رأيت لضحكتم قليلا ولبكيتم كثيرا»","صحيح","Sahih al-Jami al-Saghir 7876","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7877","«يا أيها الناس! إني تركت فيكم ما إن أخذتم به لن تضلوا: كتاب الله وعترتي: أهل بيتي»","صحيح","Sahih al-Jami al-Saghir 7877","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7878","«يا أيها الناس! إني قد كنت أذنت لكم في الاستمتاع من النساء وإن الله قد حرم ذلك إلى يوم القيامة فمن كان عنده منهن شيء فليخل سبيله ولا تأخذوا مما آتيتموهن شيئا»","صحيح","Sahih al-Jami al-Saghir 7878","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7879","«يا أيها الناس! أيما أحد من المؤمنين أصيب بمصيبة فليتعز بمصيبته بي عن المصيبة التي تصيبه بغيري فإن أحدا من أمتي لن يصاب بمصيبة بعدي أشد عليه من مصيبتي»","صحيح","Sahih al-Jami al-Saghir 7879","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7880","يا أيها الناس! أي يوم أحرم؟ أي يوم أحرم؟ أي يوم أحرم؟ قالوا: يوم الحج الأكبر قال: فإن دماءكم وأموالكم وأعراضكم عليكم حرام كحرمة يومكم هذا في بلدكم هذا في شهركم هذا ألا لا يجني جان إلا على نفسه ألا ولا يجني والد على ولده ولا ولد على والده ; ألا إن الشيطان قد أيس أن يعبد في بلدكم هذا أبدا ولكن ستكون له طاعة في بعض ما تحتقرون من أعمالكم فيرضى بها ألا إن المسلم أخو المسلم فليس يحل لمسلم من أخيه شيء إلا ما أحل من نفسه ألا وإن كل ربا في الجاهلية موضوع لكم رءوس أموالكم لا تظلمون ولا تظلمون غير ربا العباس بن عبد المطلب فإنه موضوع كله وإن كل دم كان في الجاهلية موضوع وأول دم أضع من دم الجاهلية دم الحارث بن عبد المطلب ألا واستوصوا بالنساء خيرا فإنما هن عوان عندكم ليس تملكون منهن شيئا غير ذلك إلا أن يأتين بفاحشة مبينة فإن فعلن فاهجروهن في المضاجع واضربوهن ضربا غير مبرح فإن أطعنكم فلا تبغوا عليهن سبيلا ألا وإن لكم على نسائكم حقا ولنسائكم عليكم حقا فأما حقكم على نسائكم فلا يوطئن فرشكم من تكرهون ولا يأذن في بيوتكم لمن تكرهون ألا وإن حقهن عليكم أن تحسنوا إليهن في كسوتهن وطعامهن","حسن","Sahih al-Jami al-Saghir 7880","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7881","«يا أيها الناس! توبوا إلى ربكم فوالله إني لأتوب إلى الله عز وجل في اليوم مائة مرة»","صحيح","Sahih al-Jami al-Saghir 7881","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7882","«يا أيها الناس! خذوا عني مناسككم فإني لا أدري لعلي لا أحج بعد عامي هذا»","صحيح","Sahih al-Jami al-Saghir 7882","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7883","«يا أيها الناس! ردوا على ردائي فوالله لوأن لي بعدد شجر تهامة نعما لقسمته عليكم ثم لا تلقوني بخيلا ولا جبانا ولا كذوبا ; يا أيها الناس! ليس لي من هذا الفيء شيء ولا هذه الوبرة إلا الخمس والخمس مردود فيكم فأدوا الخياط والمخيط فإن الغلول يكون على أهله عارا ونارا وشنارا يوم القيامة»","حسن","Sahih al-Jami al-Saghir 7883","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7884","«يا أيها الناس! عليكم بالسكينة فإن البر ليس بإيجاف الخيل والإبل»","صحيح","Sahih al-Jami al-Saghir 7884","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7885","«يا أيها الناس! عليكم بالسكينة والوقار فإن البر ليس في إيضاع الإبل»","صحيح","Sahih al-Jami al-Saghir 7885","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7886","«يا أيها الناس! عليكم بالقصد عليكم بالقصد عليكم بالقصد فإن الله تعالى لن يمل حتى تملوا»","حسن","Sahih al-Jami al-Saghir 7886","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7887","«يا أيها الناس! عليكم من الأعمال ما تطيقون فإن الله لا يمل حتى تملوا وإن أحب الأعمال إلى الله ما دووم عليه وإن قل»","صحيح","Sahih al-Jami al-Saghir 7887","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7888","«يا أيها الناس! ما لكم حين نابكم شيء في الصلاة أخذتم في التصفيق؟ إنما التصفيق للنساء من نابه شيء في صلاته فليقل: سبحان الله فإنه لا يسمعه أحد حين يقول: سبحان الله إلا التفت»","صحيح","Sahih al-Jami al-Saghir 7888","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7889","يا أيها الناس! هل تدرون لم جمعتكم؟ إني والله ما جمعتكم لرغبة ولا لرهبة ولكن جمعتكم لأن تميما الداري كان رجلا نصرانيا فجاء فبايع وأسلم وحدثني حديثا وافق الذي كنت أحدثكم عن المسيح الدجال ; حدثني أنه ركب في سفينة بحرية مع ثلاثين رجلا من لخم وجذام فلعب بهم الموج شهرا في البحر ثم ارفئوا إلى جزيرة في البحر حين غروب الشمس فجلسوا في أقرب السفينة فدخلوا الجزيرة فلقيهم دابة أهلب كثير الشعر لا يدرون ما قبله من دبره من كثرة الشعر فقالوا: ويلك ما أنت؟ قالت: أنا الجساسة قالوا: وما الجساسة؟ قالت: أيها القوم انطلقوا إلى هذا الرجل في الدير فإنه إلى خبركم بالأشواق قال: لما سمت لنا رجلا فرقنا منها أن تكون شيطانة فانطلقنا سراعا حتى دخلنا باب الدير فإذا فيه أعظم إنسان رأيناه قط خلقا وأشده وثاقا مجموعة يداه إلى عنقه ما بين ركبتيه إلى كعبيه بالحديد قلنا: ويلك ما أنت؟ قال: قد قدرتم على خبري فأخبروني ما أنتم؟ قالوا: نحن أناس من العرب ركبنا في سفينة بحرية فصادفنا البحر حين اغتلم فلعب بنا الموج شهرا ثم أرفأنا إلى جزيرتك هذه فجلسنا في أقربها فدخلنا الجزيرة فلقيتنا دابة أهلب كثير الشعر ما يدري ما قبله من دبره من كثرة الشعر فقلنا ويلك ما أنت؟ قالت: أنا الجساسة قلنا وما الجساسة؟ قالت اعمدوا إلى هذا الرجل في الدير فإنه إلى خبركم بالأشواق فأقبلنا إليك سراعا وفرقنا منها ولم نأمن أن تكون شيطانة قال: أخبروني عن نخل بيسان قلنا: عن أي شأنها تستخبر؟ قال: أسألكم عن نخلها هل يثمر؟ قلنا له: نعم قال: أما إنها يوشك أن لا تثمر قال: أخبروني عن بحيرة طبرية؟ قلنا: عن أي شأنها تستخبر؟ قال: هل فيها ماء؟ قلنا: هي كثيرة الماء قال: إن ماءها يوشك أن يذهب قال: أخبروني عن عين ذعر قلنا: عن أي شأنها تستخبر؟ قال هل في العين ماء؟ وهل يزرع أهلها بماء العين؟ قلنا له: نعم هي كثيرة الماء وأهلها يزرعون من مائها قال: أخبروني عن نبي الأميين ما فعل؟ قالوا: قد خرج من مكة ونزل يثرب قال: أقاتله العرب؟ قلنا: نعم قال: كيف صنع بهم فأخبرناه أنه قد ظهر على من يليه من العرب وأطاعوه قال: قد كان ذلك! قلنا: نعم قال أما إن ذلك خير لهم أن يطيعوه وإني أخبركم عني أنا المسيح وإني أوشك أن يؤذن لي بالخروج فأخرج فأسير في الأرض فلا أدع قرية إلا هبطتها في أربعين ليلة غير مكة وطيبة هما محرمتان على كلتاهما كلما أردت أن أدخل واحدة منهما استقبلني ملك بيده السيف صلتا يصدني عنها وإن على كل نقب منها ملائكة يحرسونها ألا أخبركم؟ هذه طيبة هذه طيبة هذه طيبة ألا كنت حدثتكم ذلك؟ فإنه أعجبني حديث تميم أنه وافق الذي كنت أحدثكم عنه وعن المدينة ومكة ألا إنه في بحر الشام أو في بحر اليمن لا بل من قبل المشرق ما هومن قبل المشرق ما هومن قبل المشرق ما هو","صحيح","Sahih al-Jami al-Saghir 7889","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7890","«يا أيها الناس! لا يقتل بعضكم بعضا ولا يصب بعضكم بعضا وإذا رميتم الجمرة فارموا بمثل حصى الخذف»","حسن","Sahih al-Jami al-Saghir 7890","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7891","«* ... لا تقوموا حتى تروني»","صحيح","Sahih al-Jami al-Saghir 7891","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7892","«يا بلال! أقم الصلاة أرحنا بها»","صحيح","Sahih al-Jami al-Saghir 7892","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7893","«يا بلال! قم فأذن: لا يدخل الجنة إلا مؤمن وإن الله ليؤيد هذا الدين بالرجل الفاجر»","صحيح","Sahih al-Jami al-Saghir 7893","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7894","يا بلال! بم سبقتني إلى الجنة؟ ما دخلت الجنة قط إلا سمعت خشخشتك أمامي إني دخلت البارحة الجنة فسمعت خشخشتك أمامي فأتيت على قصر مربع مشرف من ذهب فقلت: لمن هذا القصر؟ قالوا: لرجل من قريش فقلت: أنا قرشي لمن هذا القصر؟ قالوا لرجل من أمة محمد فقلت: أنا محمد لمن هذا القصر؟ قالوا: لعمر بن الخطاب","صحيح","Sahih al-Jami al-Saghir 7894","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7895","«يا بنت أبي أمية! سألت عن الركعتين بعد العصر وإنه أتاني ناس من عبد القيس فشغلوني عن الركعتين اللتين بعد الظهر فهما هاتان»","صحيح","Sahih al-Jami al-Saghir 7895","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7896","«يا بني بياضة! أنكحوا أبا هند وانكحوا إليه»","حسن","Sahih al-Jami al-Saghir 7896","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7897","«يا بني سلمة! ألا تحتسبون آثاركم إلى المسجد؟»","صحيح","Sahih al-Jami al-Saghir 7897","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7898","«يا بني سلمة! دياركم تكتب آثاركم»","صحيح","Sahih al-Jami al-Saghir 7898","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7899","«يا بني عبد المطلب! سقايتكم ولولا أن يغلبكم عليها الناس لنزعت»","صحيح","Sahih al-Jami al-Saghir 7899","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7900","«يا بني عبد مناف! لا تمنعوا أحدا طاف بهذا البيت وصلى أية ساعة شاء من ليل أو نهار»","صحيح","Sahih al-Jami al-Saghir 7900","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7901","يا بني عبد مناف يا بني عبد مناف! إني نذير إنما مثلي ومثلكم كمثل رجل رأى العدوفانطلق يريد أهله فخشي أن يسبقوه إلى أهله فجعل يهتف: يا صباحاه يا صباحاه! أتيتم أتيتم","صحيح","Sahih al-Jami al-Saghir 7901","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7902","«يا بني فهر! يا بني عدي! يا بني عبد مناف! يا بني عبد المطلب! أرأيتكم لوأخبرتكم أن خيلا بالوادي تريد أن تغير عليكم أكنتم مصدقي؟ قالوا: ما جربنا عليك إلا صدقا قال: فإني نذير لكم بين يدي عذاب شديد»","صحيح","Sahih al-Jami al-Saghir 7902","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7903","«يا بني كعب بن لؤي! أنقذوا أنفسكم من النار يا بني مرة بن كعب! أنقذوا أنفسكم من النار يا بني عبد شمس! أنقذوا أنفسكم من النار يا بني عبد مناف! أنقذوا أنفسكم من النار يا بني عبد المطلب! أنقذوا أنفسكم من النار يا فاطمة! أنقذي نفسك من النار فإني لا أملك لكم من الله شيئا غير أن لكم رحما سأبلها ببلالها»","صحيح","Sahih al-Jami al-Saghir 7903","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7904","«يا جابر! إذا كان واسعا فخالف بين طرفيه وإذا كان ضيقا فاشدده على حقويك»","صحيح","Sahih al-Jami al-Saghir 7904","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7905","«يا جابر! ألا أبشرك بما لقي الله به أباك! ما كلم الله أحدا قط إلا من وراء حجاب وكلم أباك كفاحا فقال: يا عبدي تمن علي أعطك قال: يا رب تحييني فأقتل فيك ثانية فقال الرب تبارك وتعالى: إنه سبق مني أنهم إليها لا يرجعون قال: يا رب فأبلغ من ورائي»","صحيح","Sahih al-Jami al-Saghir 7905","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7906","«يا جرهد! غط فخذك فإن الفخذ عورة»","صحيح","Sahih al-Jami al-Saghir 7906","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7907","«يا حازم! أكثر من قول لا حول ولا قوة إلا بالله فإنها كنز من كنوز الجنة»","صحيح","Sahih al-Jami al-Saghir 7907","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7908","«يا حسان! أجب عن رسول الله اللهم أيده بروح القدس»","صحيح","Sahih al-Jami al-Saghir 7908","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7909","«يا ذا الأذنين!»","صحيح","Sahih al-Jami al-Saghir 7909","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7910","«يا رويفع! لعل الحياة ستطول بك بعدي فأخبر الناس أنه من عقد لحيته أو تقلد وترا أو استنجى برجيع دابة أو عظم فإن محمدا منه بريء»","صحيح","Sahih al-Jami al-Saghir 7910","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7911","«يا سعد! ارم فداك أبي وأمي»","صحيح","Sahih al-Jami al-Saghir 7911","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7912","«يا سعد! إني لأعطي الرجل وغيره أحب إلى منه خشية أن يكبه الله في النار على وجهه»","صحيح","Sahih al-Jami al-Saghir 7912","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7913","«يا صاحب السبتيتين! ويحك! ألق سبتيتيك»","صحيح","Sahih al-Jami al-Saghir 7913","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7914","«يا صفية بنت عبد المطلب! يا فاطمة بنت محمد! يا بني عبد المطلب! إني لا أملك لكم من الله شيئا سلوني من مالي ما شئتم»","صحيح","Sahih al-Jami al-Saghir 7914","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7915","«يا عائش! هذا جبريل يقرئك السلام»","صحيح","Sahih al-Jami al-Saghir 7915","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7916","«يا عائشة! استعيذي بالله من شر هذا فإن هذا هوالغاسق إذا وقب» - يعني القمر - ... [حم ت ك] عن عائشة","صحيح","Sahih al-Jami al-Saghir 7916","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7917","«يا عائشة! أشعرت أن الله أفتاني فيما استفتيته فيه؟ جاءني رجلان فقعد أحدهما عند رأسي والآخر عند رجلي فقال الذي عند رأسي للذي عند رجلي: ما وجع الرجل؟ قال: مطبوب قال: من طبه؟ قال: لبيد بن الأعصم قال: في أي شيء؟ قال: في مشط ومشاطة وجف طلعتي ذكر قال: فأين هو؟ قال في بئر ذروان يا عائشة! والله لكأن ماءها نقاعة الحناء ولكأن نخلها رءوس الشياطين»","صحيح","Sahih al-Jami al-Saghir 7917","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7918","«يا عائشة أما كان معكم لهو؟ فإن الأنصار يعجبهم اللهو»","صحيح","Sahih al-Jami al-Saghir 7918","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7919","«يا عائشة! إن الله خلق للجنة أهلا خلقهم لها وهم في أصلاب آبائهم وخلق للنار أهلا خلقهم لها وهم في أصلاب آبائهم»","صحيح","Sahih al-Jami al-Saghir 7919","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7920","«يا عائشة! إن الله رفيق يحب الرفق في الأمر كله»","صحيح","Sahih al-Jami al-Saghir 7920","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7921","يا عائشة! إن الله رفيق يحب الرفق ويعطي على الرفق ما لا يعطي على العنف وما لا يعطي على ما سواه","صحيح","Sahih al-Jami al-Saghir 7921","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7922","«يا عائشة! إن الله لا يحب الفاحش المتفحش»","صحيح","Sahih al-Jami al-Saghir 7922","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7923","«يا عائشة إن شرار الناس الذين يكرمون اتقاء شرهم»","صحيح","Sahih al-Jami al-Saghir 7923","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7924","«يا عائشة إن عيني تنامان ولا ينام قلبي»","صحيح","Sahih al-Jami al-Saghir 7924","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7925","«يا عائشة! إن من شر الناس من تركه الناس اتقاء فحشه»","صحيح","Sahih al-Jami al-Saghir 7925","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7926","«يا عائشة! حولي هذا فإني كلما دخلت فرأيته ذكرت الدنيا»","صحيح","Sahih al-Jami al-Saghir 7926","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7927","«يا عائشة! عليك بتقوى الله والرفق فإن الرفق لم يكن في شيء قط إلا زانه ولا نزع من شيء قط إلا شانه»","صحيح","Sahih al-Jami al-Saghir 7927","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7928","«يا عائشة! لولا أن قومك حديثوعهد بجاهلية لأمرت بالبيت فهدم فأدخلت فيه ما أخرج منه وألزقته بالأرض وجعلت له بابين: باب شرقيا وباب غربيا فبلغت به أساس إبراهيم»","صحيح","Sahih al-Jami al-Saghir 7928","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7929","يا عائشة! ما أزال أجد ألم الطعام الذي أكلت بخيبر فهذا أوان وجدت انقطاع أبهري من ذلك السم","صحيح","Sahih al-Jami al-Saghir 7929","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7930","«يا عائشة! ما يؤمنني أن يكون فيه عذاب؟ قد عذب قوم بالريح وقد رأى قوم العذاب فقالوا: » هذا عارض ممطرنا","صحيح","Sahih al-Jami al-Saghir 7930","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7931","«يا عائشة! متى عهدتني فحاشا؟ إن شر الناس عند الله منزلة يوم القيامة من تركه الناس اتقاء شره»","صحيح","Sahih al-Jami al-Saghir 7931","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7932","«يا عائشة! لا تحصي فيحصي الله عليك»","صحيح","Sahih al-Jami al-Saghir 7932","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7933","«يا عائشة! لا تكوني فاحشة»","صحيح","Sahih al-Jami al-Saghir 7933","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7934","«يا عباد الله تدأووا فإن الله لم يضع داء إلا وضع له دواء غير داء واحد: الهرم»","صحيح","Sahih al-Jami al-Saghir 7934","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7935","«يا عباد الله! وضع الله الحرج إلا من اقترض عرض امرئ مسلم ظلما فذلك الذي حرج وهلك»","صحيح","Sahih al-Jami al-Saghir 7935","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7936","«يا عباس! ألا تعجب من حب مغيث بريرة ومن بغض بريرة مغيثا؟»","صحيح","Sahih al-Jami al-Saghir 7936","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7937","«يا عباس! يا عماه! ألا أعطيك؟ ألا أمنحك ألا أحبوك؟ ألا أفعل بك عشر خصال إذا أنت فعلت ذلك غفر الله ذنبك أوله وآخره قديمه وحديثه خطأه وعمده صغيره وكبيره سره وعلانيته؟ عشر خصال: أن تصلي أربع ركعات تقرأ في كل ركعة فاتحة الكتاب وسورة فإذا فرغت من القراءة في أول ركعة وأنت قائم قلت: سبحان الله والحمد لله ولا إله إلا الله والله أكبر خمس عشرة مرة ثم تركع فتقولها وأنت راكع عشرا ثم ترفع رأسك من الركوع فتقولها عشرا ثم تهوي ساجدا فتقولها وأنت ساجد عشرا ثم ترفع رأسك من السجود فتقولها عشرا ثم تسجد فتقولها عشرا ثم ترفع رأسك فتقولها عشرا فذلك خمس وسبعون في كل ركعة تفعل ذلك في أربع ركعات فلوكانت ذنوبك مثل زبد البحر أو رمل عالج غفرها الله لك إن استطعت أن تصليها في كل يوم مرة فافعل فإن لم تفعل ففي كل جمعة مرة فإن لم تفعل ففي كل شهر مرة فإن لم تفعل ففي كل سنة مرة فإن لم تفعل ففي عمرك مرة»","صحيح","Sahih al-Jami al-Saghir 7937","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7938","«يا عباس! يا عم رسول الله! سل الله العافية في الدنيا والآخرة»","صحيح","Sahih al-Jami al-Saghir 7938","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7939","«يا عبد الرحمن! اذهب بأختك فأعمرها من التنعيم»","صحيح","Sahih al-Jami al-Saghir 7939","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7940","«يا عبد الرحمن! أردف أختك عائشة فأعمرها من التنعيم فإذا هبطت بها من الأكمة فمرها فلتحرم فإنها عمرة متقبلة»","صحيح","Sahih al-Jami al-Saghir 7940","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7941","«يا عبد الرحمن بن سمرة! لا تسأل الإمارة فإنك إن أوتيتها عن مسألة وكلت إليها وإن أوتيتها عن غير مسألة أعنت عليها وإذا حلفت على يمين فرأيت غيرها خيرا منها فكفر عن يمينك وائت الذي هو خير»","صحيح","Sahih al-Jami al-Saghir 7941","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7942","«يا عبد الله! ألم أخبر أنك تصوم النهار وتقوم الليل؟ فلا تفعل فإنك إذا فعلت ذلك هجمت عينك وتفهت نفسك فصم وأفطر وقم ونم فإن لجسدك عليك حقا وإن لعينيك عليك حقا وإن لزوجك عليك حقا وإن بحسبك أن تصوم من كل شهر ثلاثة أيام فإن لك بكل حسنة عشر أمثالها فإذن ذلك صيام الدهر كله ; قال: إني أجد قوة قال: فصم صيام نبي الله داود ولا تزد عليه نصف الدهر»","صحيح","Sahih al-Jami al-Saghir 7942","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7943","«يا عبد الله إن يدخلك الله الجنة كان لك هذا وما اشتهت نفسك ولذت عينك»","صحيح","Sahih al-Jami al-Saghir 7943","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7944","«يا عبد الله بن قيس! ألا أدلك على كلمة هي كنز من كنوز الجنة؟: لا حول ولا قوة إلا بالله»","صحيح","Sahih al-Jami al-Saghir 7944","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7945","«يا عبد الله! لا تكن مثل فلان كان يقوم من الليل فترك قيام الليل»","صحيح","Sahih al-Jami al-Saghir 7945","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7946","يا عثمان! أرغبت عن سنتي؟! فإني أنام وأصلي وأصوم وأفطر وأنكح النساء فاتق الله يا عثمان! فإن لأهلك عليك حقا، وإن لضيفك عليك حقا وإن لنفسك عليك حقا فصم وأفطر وصل ونم","صحيح","Sahih al-Jami al-Saghir 7946","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7947","«يا عثمان! إن الله مقمصك قميصا فإن أرادك المنافقون على خلعه فلا تخلعه حتى تلقاني»","صحيح","Sahih al-Jami al-Saghir 7947","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7948","«يا عقبة؟ ألا أعلمك خير سورتين قرئتا؟ {قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ} و {قُلْ أَعُوذُ بِرَبِّ النَّاسِ} يا عقبة! اقرأ بهما كلما نمت وقمت ما سأل سائل ولا استعاذ مستعيذ بمثلهما»","حسن","Sahih al-Jami al-Saghir 7948","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7949","«يا عقبة بن عامر! تعوذ بهما فما تعوذ متعوذ بمثلهما»","صحيح","Sahih al-Jami al-Saghir 7949","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7950","«يا عقبة! {قُلْ هُوَ اللَّهُ أَحَدٌ} و {قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ} و {قُلْ أَعُوذُ بِرَبِّ النَّاسِ} ما تعوذ بمثلهن أحد»","صحيح","Sahih al-Jami al-Saghir 7950","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7951","«يا علي! أما ترضى أن تكون مني بمنزلة هارون من موسى؟ إلا أنه ليس بعدي نبي»","صحيح","Sahih al-Jami al-Saghir 7951","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7952","«يا علي! سل الله الهدى والسداد واذكر بالهدى هدايتك الطريق وبالسداد تسديدك السهم»","صحيح","Sahih al-Jami al-Saghir 7952","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7953","«يا علي! لا تتبع النظرة النظرة فإن لك الأولى وليست لك الآخرة»","حسن","Sahih al-Jami al-Saghir 7953","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7954","«يا علي! لا تقع إقعاء الكلب»","حسن","Sahih al-Jami al-Saghir 7954","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7955","«يا عم! ألا أصلك؟ ألا أحبوك؟ ألا أنفعك؟ تصلي يا عم! أربع ركعات تقرأ في كل ركعة بفاتحة الكتاب وسورة فإذا انقضت القراءة فقل: الله أكبر والحمد لله وسبحان الله ولا إله إلا الله خمس عشرة مرة قبل أن تركع ثم اركع فقلها عشرا قبل أن ترفع رأسك ثم ارفع رأسك فقلها عشرا قبل أن تسجد ثم اسجد فقلها عشرا قبل أن ترفع رأسك ثم ارفع رأسك فقلها عشرا ثم اسجد فقلها عشرا ثم ارفع فقلها عشرا قبل أن تقوم فتلك خمس وسبعون في كل ركعة وهي ثلاث مائة في أربع ركعات فلو كانت ذنوبك مثل زبد البحر أو رمل عالج غفرها الله لك إن لم تستطع أن تصليها في كل يوم فصلها في كل جمعة فإن لم تستطع فصلها في كل شهر فإن لم تستطع فصلها في كل سنة»","صحيح","Sahih al-Jami al-Saghir 7955","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7956","«يا عوف! احفظ خلالا ستا بين يدي الساعة إحداهن موتي ثم فتح بيت المقدس ثم داء يظهر فيكم يستشهد الله به ذراريكم وأنفسكم ويزكي به أموالكم ثم تكون الأموال فيكم حتى يعطى الرجل مائة دينار فيظل ساخطا وفتنة تكون بينكم لا يبقى بيت مسلم إلا دخلته ثم يكون بينكم وبين بني الأصفر هدنة فيغدرون فيسيرون إليكم في ثمانين غاية تحت كل غاية اثني عشر ألفا»","صحيح","Sahih al-Jami al-Saghir 7956","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7957","يا غلام! إني أعلمك كلمات احفظ الله يحفظك احفظ الله تجده تجاهك إذا سألت فاسأل الله وإذا استعنت فاستعن بالله واعلم أن الأمة لو اجتمعت على أن ينفعوك بشيء لم ينفعوك إلا بشيء قد كتبه الله لك ولو اجتمعوا على أن يضروك بشيء لم يضروك بشيء إلا قد كتبه الله عليك جفت الأقلام ورفعت الصحف","صحيح","Sahih al-Jami al-Saghir 7957","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7958","«يا غلام! سم الله وكل بيمينك وكل مما يليك»","صحيح","Sahih al-Jami al-Saghir 7958","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7959","«يا غلام! هذا أبوك وهذه أمك فخذ بيد أيهما شئت»","صحيح","Sahih al-Jami al-Saghir 7959","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7960","«يا فاطمة! احلقي رأسه وتصدقي بزنة شعره فضة»","صحيح","Sahih al-Jami al-Saghir 7960","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7961","«يا فاطمة! ألا ترضين أن تكوني سيدة نساء المؤمنين»","صحيح","Sahih al-Jami al-Saghir 7961","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7962","«يا فاطمة! أيسرك أن يقول الناس فاطمة بنت محمد في يدها سلسلة من نار» ؟! [حم ن ك] عن ثوبان","صحيح","Sahih al-Jami al-Saghir 7962","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7963","«يا فلان! أيما كان أحب إليك أن تمتع به عمرك؟ أو لا تأتي غدا إلى باب من أبواب الجنة إلا وجدته قد سبقك إليه يفتحه لك» ؟","صحيح","Sahih al-Jami al-Saghir 7963","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7964","«يا فلان! أفلا تحسن صلاتك! ألا ينظر المصلي إذا صلى كيف يصلي؟ فإنما يصلي لنفسه إني والله لأبصر من ورائي كما أبصر من بين يدي»","صحيح","Sahih al-Jami al-Saghir 7964","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7965","«يا قبيصة! إن المسألة لا تحل إلا لأحد ثلاثة: رجل تحمل حمالة فتحل له المسألة حتى يصيبها ثم يمسك ورجل أصابته جائحة اجتاحت ماله فحلت له المسألة حتى يصيب قواما من عيش ورجل أصابته فاقة حتى يقول ثلاثة من ذوي الحجا من قومه: لقد أصاب فلانا فاقة فحلت له المسألة حتى يصيب قواما من عيش ثم يمسك فما سواهن من المسألة فسحت يأكلها صاحبها سحتا»","صحيح","Sahih al-Jami al-Saghir 7965","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7966","«يا معاذ! أفتان أنت؟ فلولا صليت بـ {سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى} ، {وَالشَّمْسِ وَضُحَاهَا} ، {وَاللَّيْلِ إِذَا يَغْشَى} فإنه يصلي وراءك الكبير والضعيف وذوالحاجة»","صحيح","Sahih al-Jami al-Saghir 7966","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7967","«يا معاذ بن جبل! ما من أحد يشهد أن لا إله إلا الله وأني رسول الله صدقا من قلبه إلا حرمه الله على النار قال: يا رسول الله! أفلا أخبر الناس فيستبشروا قال: إذا يتكلوا»","صحيح","Sahih al-Jami al-Saghir 7967","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7968","«يا معاذ بن جبل! هل تدري ما حق الله على عباده وما حق العباد على الله؟ فإن حق الله على العباد أن يعبدوه ولا يشركوا به شيئا وحق العباد على الله أن لا يعذب من لا يشرك به شيئا»","صحيح","Sahih al-Jami al-Saghir 7968","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7969","«يا معاذ! والله إني لأحبك أوصيك يا معاذ لا تدعن في دبر كل صلاة أن تقول: اللهم أعني على ذكرك وشكرك وحسن عبادتك»","صحيح","Sahih al-Jami al-Saghir 7969","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7970","«يا معشر الأنصار! ألم أجدكم ضلالا فهداكم الله بي وكنتم متفرقين فألفكم الله بي وكنتم عالة فأغناكم الله بي؟ أما ترضون أن يذهب الناس بالشاة والبعير وتذهبون بالنبي إلى رحالكم؟ لولا الهجرة لكنت امرءا من الأنصار ولو سلك الناس واديا وشعبا لسلكت وادي الأنصار وشعبها الأنصار شعار والناس دثار إنكم ستلقون بعدي أثرة فاصبروا حتى تلقوني على الحوض»","صحيح","Sahih al-Jami al-Saghir 7970","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7971","«يا معشر الأنصار! أمسكوا عليكم أموالكم لا تعمروها فإنه من أعمر شيئا حياته فهو له حياته وموته»","صحيح","Sahih al-Jami al-Saghir 7971","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7972","«يا معشر الأنصار! ما حديث أتاني عنكم؟ ألا ترضون أن يذهب الناس بالأموال وتذهبون برسول الله حتى تدخلوه في بيوتكم؟ لوأخذت الناس شعبا وأخذت الأنصار شعبا أخذت شعب الأنصار»","صحيح","Sahih al-Jami al-Saghir 7972","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7973","«يا معشر التجار! إن الشيطان والإثم يحضران البيع فشوبوا بيعكم بالصدقة»","صحيح","Sahih al-Jami al-Saghir 7973","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7974","«يا معشر التجار! إن هذا البيع يحضره اللغووالحلف فشوبوه بالصدقة»","صحيح","Sahih al-Jami al-Saghir 7974","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7975","«يا معشر الشباب! من استطاع منكم الباءة فليتزوج فإنه أغض للبصر وأحصن للفرج ومن لم يستطع فعليه بالصوم فإنه له وجاء»","صحيح","Sahih al-Jami al-Saghir 7975","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7976","«يا معشر الفقراء! ألا أبشركم؟ إن فقراء المؤمنين يدخلون الجنة قبل أغنيائهم بنصف يوم: خمسمائة عام»","صحيح","Sahih al-Jami al-Saghir 7976","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7977","«يا معشر المسلمين! لا صلاة لمن لا يقيم صلبه في الركوع والسجود»","صحيح","Sahih al-Jami al-Saghir 7977","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7978","«يا معشر المهاجرين! خصال خمس إذا ابتليتم بهن وأعوذ بالله أن تدركوهن: لم تظهر الفاحشة في قوم قط حتى يعلنوا بها إلا فشا فيهم الطاعون والأوجاع التي لم تكن مضت في أسلافهم الذين مضوا ولم ينقصوا المكيال والميزان إلا أخذوا بالسنين وشدة المؤنة وجور السلطان عليهم ولم يمنعوا زكاة أموالهم إلا منعوا القطر من السماء ولولا البهائم لم يمطروا ولم ينقضوا عهد الله وعهد رسوله إلا سلط الله عليهم عدوهم من غيرهم فأخذوا بعض ما كان في أيديهم وما لم تحكم أئمتهم بكتاب الله عز وجل ويتحروا فيما أنزل الله إلا جعل الله بأسهم بينهم»","صحيح","Sahih al-Jami al-Saghir 7978","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7979","«يا معشر المهاجرين والأنصار! إن من إخوانكم قوما ليس لهم مال ولا عشيرة فليضم أحدكم إليه الرجلين أو الثلاثة»","صحيح","Sahih al-Jami al-Saghir 7979","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7980","يا معشر النساء! تصدقن وأكثرن الاستغفار فإني رأيتكن أكثر أهل النار إنكن تكثرن اللعن وتكفرن العشير ما رأيت من ناقصات عقل ودين أغلب لذي لب منكن أما نقصان العقل: فشهادة امرأتين تعدل شهادة رجل فهذا نقصان العقل وتمكث الليالي ما تصلي وتفطر في رمضان فهذا نقصان الدين","صحيح","Sahih al-Jami al-Saghir 7980","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7981","«يا معشر النساء! تصدقن ولو من حليكن فإنكن أكثر أهل جهنم يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 7981","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7982","«يا معشر قريش! اشتروا أنفسكم من الله لا أغني عنكم من الله شيئا يا بني عبد مناف! اشتروا أنفسكم من الله لا أغني عنكم من الله شيئا يا عباس بن عبد المطلب! لا أغني عنك من الله شيئا يا صفية عمة رسول الله! لا أغني عنك من الله شيئا يا فاطمة بنت محمد! سليني من مالي ما شئت لا أغني عنك من الله شيئا»","صحيح","Sahih al-Jami al-Saghir 7982","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7983","«يا معشر قريش! أنقذوا أنفسكم من النار فإني لا أملك لكم من الله ضرا ولا نفعا يا معشر بني عبد مناف! أنقذوا أنفسكم من النار فإني لا أملك لكم من الله ضرا أو نفعا يا معشر بني عبد المطلب! أنقذوا أنفسكم من النار فإني لا أملك لكم ضرا ولا نفعا يا فاطمة بنت محمد! أنقذي نفسك من النار فإني لا أملك لك ضرا ولا نفعا إن لك رحما وسأبلها ببلالها»","صحيح","Sahih al-Jami al-Saghir 7983","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7984","يا معشر من آمن بلسانه ولم يدخل الإيمان قلبه، لا تغتابوا المسلمين ولا تتبعوا عوراتهم فإنه من تتبع عورة أخيه المسلم تتبع الله عورته ومن تتبع الله عورته يفضحه ولو في جوف بيته","صحيح","Sahih al-Jami al-Saghir 7984","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7985","«يا معشر من أسلم بلسانه ولم يدخل الإيمان في قلبه! لا تؤذوا المسلمين ولا تعيروهم ولا تتبعوا عوراتهم فإنه من تتبع عورة أخيه المسلم يتتبع الله عورته ومن تتبع الله عورته يفضحه ولو في جوف رحله»","صحيح","Sahih al-Jami al-Saghir 7985","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7986","«يا معشر يهود! أسلموا تسلموا اعلموا أن الأرض لله ورسوله وإني أريد أن أجليكم من هذه الأرض فمن وجد منكم بماله شيئا فليبعه وإلا فاعلموا أن الأرض لله ورسوله»","صحيح","Sahih al-Jami al-Saghir 7986","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7987","«يا مقلب القلوب ثبت قلبي على دينك»","صحيح","Sahih al-Jami al-Saghir 7987","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7988","«يا مقلب القلوب ثبت قلوبنا على دينك»","صحيح","Sahih al-Jami al-Saghir 7988","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7989","«يا نساء المسلمات! لا تحقرن جارة لجارتها ولو فرسن شاة»","صحيح","Sahih al-Jami al-Saghir 7989","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7990","«يا هذال! لو سترته بثوبك كان خيرا لك»","صحيح","Sahih al-Jami al-Saghir 7990","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7991","«يأتي الدجال المدينة فيجد الملائكة يحرسونها فلا يدخلها الدجال ولا الطاعون إن شاء الله تعالى»","صحيح","Sahih al-Jami al-Saghir 7991","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7992","«يأتي الدجال وهو محرم عليه أن يدخل نقاب المدينة فينزل بعض السباخ التي بالمدينة فيخرج إليه يومئذ رجل هو خير الناس أو من خير الناس فيقول له: أشهد أنك الدجال الذي حدثنا رسول الله صلى الله عليه وسلم حديثه فيقول الدجال: أرأيتم إن قتلت هذا ثم أحييته؟ هل تشكون في الأمر؟ فيقولون: لا فيقتله ثم يحييه فيقول حين يحييه: والله ما كنت قط أشد بصيرة مني اليوم فيريد الدجال أن يقتله فلا يسلط عليه»","صحيح","Sahih al-Jami al-Saghir 7992","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7993","«يأتي الشيطان أحدكم فيقول: من خلق كذا من خلق كذا؟ حتى يقول: من خلق ربك؟ فإذا بلغه فليستعذ بالله ولينته»","صحيح","Sahih al-Jami al-Saghir 7993","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7994","«يأتي القرآن وأهله الذين كانوا يعملون به في الدنيا تقدمه سورة البقرة وآل عمران يأتيان كأنهما غيابتان وبينهما شرق أو كأنهما غمامتان سوداوان أو كأنهما ظلتان من طير صواف يجادلان عن صاحبهما»","صحيح","Sahih al-Jami al-Saghir 7994","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7995","«يأتي المسيح من قبل المشرق وهمته المدينة حتى ينزل دبر أحد ثم تصرف الملائكة وجهه قبل الشام وهنالك يهلك»","صحيح","Sahih al-Jami al-Saghir 7995","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7996","«يؤتى بالرجل يوم القيامة من أهل الجنة فيقول له: يا ابن آدم! كيف وجدت منزلك؟ فيقول: أي رب! خير منزل فيقول: سل وتمن فيقول: يا رب ما اسأل ولا أتمنى إلا أن تردني إلى الدنيا فأقتل في سبيلك عشر مرار لما يرى من فضل الشهادة ويؤتى بالرجل من أهل النار فيقول له: يا ابن آدم! كيف وجدت منزلك؟ فيقول: أي رب! شر منزل فيقول له: أتفتدي منه بطلاع الأرض ذهبا؟ فيقول: أي رب! نعم فيقول: كذبت قد سألتك أقل من ذلك وأيسر فلم تفعل فيرد إلى النار»","صحيح","Sahih al-Jami al-Saghir 7996","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7997","«يؤتى بالعبد يوم القيامة فيقال له: ألم أجعل لك سمعا وبصرا ومالا وولدا وسخرت لك الأنعام والحرث وتركتك ترأس وتربع فكنت تظن أنك ملاقي يومك هذا؟ فيقول: لا فيقول له: اليوم أنساك كما نسيتني»","صحيح","Sahih al-Jami al-Saghir 7997","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7998","«يؤتى بالموت كأنه كبش أملح حتى يوقف على السور بين الجنة والنار فيقال: يا أهل الجنة! فيشرئبون ويقال: يا أهل النار! فيشرئبون فيقال: هل تعرفون هذا؟ فيقولون: نعم هذا الموت فيضجع ويذبح فلولا أن الله قضى لأهل الجنة الحياة والبقاء لماتوا فرحا ولولا أن الله قضى لأهل النار الحياة فيها لماتوا ترحا»","حسن","Sahih al-Jami al-Saghir 7998","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"7999","يؤتى بالموت يوم القيامة فيوقف على الصراط فيقال: يا أهل الجنة! فيطلعون خائفين وجلين أن يخرجوا من مكانهم الذي هم فيه ثم يقال: يا أهل النار! فيطلعون مستبشرين فرحين أن يخرجوا من مكانهم الذي هم فيه فيقال: هل تعرفون هذا؟ فيقولون: نعم هذا الموت، فيؤمر به فيذبح على الصراط ثم يقال للفريقين كلاهما: خلود فيما تجدون لا موت فيها أبدا","صحيح","Sahih al-Jami al-Saghir 7999","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8000","«يؤتى بأنعم أهل الدنيا من أهل النار يوم القيامة فيصبغ في جهنم صبغة ثم يقال له: يا ابن آدم هل رأيت خيرا قط؟ هل مر بك نعيم قط؟ فيقول: لا والله يا رب ويؤتى بأشد الناس بؤسا في الدنيا من أهل الجنة فيصبغ في الجنة صبغة فيقال له: يا ابن آدم! هل رأيت بؤسا قط؟ هل مر بك شدة قط؟ فيقول: لا والله يا رب! ما مر بى بؤس قط ولا رأيت شدة قط»","صحيح","Sahih al-Jami al-Saghir 8000","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8001","«يؤتى بجهنم يومئذ لها سبعون ألف زمام مع كل زمام سبعون ألف ملك يجرونها»","صحيح","Sahih al-Jami al-Saghir 8001","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8002","«يأتي على الناس زمان الصابر فيهم على دينه كالقابض على الجمر»","صحيح","Sahih al-Jami al-Saghir 8002","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8003","«يأتي على الناس زمان ما يبالي الرجل من أين أصاب المال؟ من حلال أو حرام»","صحيح","Sahih al-Jami al-Saghir 8003","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8004","يأتي على الناس زمان يدعوالرجل ابن عمه وقريبه: هلم إلى الرخاء هلم إلى الرخاء والمدينة خير لهم لو كانوا يعلمون والذي نفسي بيده لا يخرج منهم أحد رغبة عنها إلا أخلف الله فيها من هوخير منه ألا إن المدينة كالكير يخرج الخبث لا تقوم الساعة حتى تنفي المدينة شرارها كما ينفي الكير خبث الحديد","صحيح","Sahih al-Jami al-Saghir 8004","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8005","«يأتي على الناس زمان يغزوفئام من الناس فيقال: فيكم من صاحب الرسول؟ فيقولون: نعم فيفتح لهم ثم يأتي على الناس زمان فيغزوا فئام من الناس فيقال لهم: هل فيكم من صاحب أصحاب الرسول؟ فيقولون: نعم فيفتح لهم ثم يأتي على الناس زمان فيغزوفئام من الناس فيقال لهم: هل فيكم من صاحب من صاحب أصحاب الرسول؟ فيقولون: نعم فيفتح لهم»","صحيح","Sahih al-Jami al-Saghir 8005","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8006","«يأتي في آخر الزمان قوم حدثاء الأسنان سفهاء الأحلام يقولون من خير قول البرية يمرقون من الإسلام كما يمرق السهم من الرمية لا يجأوز إيمانهم حناجرهم فاقتلوهم فإن في قتلهم أجرا لمن قتلهم يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 8006","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8007","يؤجر الرجل في نفقته كلها إلا في التراب","صحيح","Sahih al-Jami al-Saghir 8007","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8008","«يؤدي المكاتب بحصته ما أدى دية حر وما بقي دية عبد»","صحيح","Sahih al-Jami al-Saghir 8008","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8009","«يأخذ الجبار سمواته وأرضه بيده ثم يقول أنا الجبار أنا الملك أين الجبارون؟ أين المتكبرون؟»","صحيح","Sahih al-Jami al-Saghir 8009","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8010","«يأكل أهل الجنة فيها ويشربون ولا يمخطون ولا يتغوطون ولا يبولون إنما طعامهم جشاء ورشح كرشح المسك يلهمون التسبيح والحمد كما يلهمون النفس»","صحيح","Sahih al-Jami al-Saghir 8010","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8011","«يؤم القوم أقرؤهم لكتاب الله فإن كانوا في القراءة سواء فأعلمهم بالسنة فإن كانوا في السنة سواء فأقدمهم هجرة فإن كانوا في الهجرة سواء فأقدمهم سنا ولا يؤمن الرجل في أهله ولا في سلطانه ولا يقعد في بيته على تكرمته إلا بإذنه»","صحيح","Sahih al-Jami al-Saghir 8011","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8012","«يؤم القوم أقرؤهم للقرآن»","صحيح","Sahih al-Jami al-Saghir 8012","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8013","«يبصر أحدكم القذى في عين أخيه وينسى الجذع في عينه»","صحيح","Sahih al-Jami al-Saghir 8013","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8014","«يبعث الناس على نياتهم»","صحيح","Sahih al-Jami al-Saghir 8014","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8015","«يبعث كل عبد على ما مات عليه»","صحيح","Sahih al-Jami al-Saghir 8015","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8016","«يتبع الدجال من يهود أصبهان سبعون ألف عليهم الطيالسة»","صحيح","Sahih al-Jami al-Saghir 8016","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8017","«يتبع الميت ثلاثة: أهله وعمله وماله فيرجع اثنان ويبقى واحد يرجع أهله وماله ويبقى عمله»","صحيح","Sahih al-Jami al-Saghir 8017","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8018","«يتجلى لنا ربنا ضاحكا يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 8018","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8019","«يتعاقبون فيكم ملائكة بالليل وملائكة بالنهار ويجتمعون في صلاة الفجر وصلاة العصر ثم يعرج الذين باتوا فيكم فيسألهم وهو أعلم بهم: كيف تركتم عبادي؟ فيقولون: تركناهم وهم يصلون وأتيناهم وهم يصلون»","صحيح","Sahih al-Jami al-Saghir 8019","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8020","«يتقارب الزمان ويقبض العلم ويلقى الشح وتظهر الفتن ويكثر الهرج قيل: وما الهرج؟ قال: القتل»","صحيح","Sahih al-Jami al-Saghir 8020","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8021","«يتنزل ربنا تبارك وتعالى كل ليلة إلى السماء الدنيا حين يبقى ثلث الليل الآخر فيقول: من يدعوني فأستجيب له؟ من يسألني فأعطيه؟ من يستغفرني فأغفر له؟»","صحيح","Sahih al-Jami al-Saghir 8021","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8022","«يجاء بالرجل يوم القيامة فيلقى في النار فتندلق أقتابه فيدور بها في النار كما يدور الحمار برحاه فيطيف به أهل النار فيقولون: يا فلان! ما أصابك؟ ألم تكن تأمرنا بالمعروف وتنهانا عن المنكر؟ فيقول: بلى قد كنت آمركم بالمعروف ولا آتيه وأنهاكم عن المنكر وآتيه»","صحيح","Sahih al-Jami al-Saghir 8022","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8023","يجزي عن الجماعة إذا مروا أن يسلم أحدهم، ويجزي عن الجلوس أن يرد أحدهم","صحيح","Sahih al-Jami al-Saghir 8023","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8024","«يجزئ من الوضوء مد ومن الغسل صاع»","صحيح","Sahih al-Jami al-Saghir 8024","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8025","يجمع الله الناس يوم القيامة في صعيد واحد ثم يطلع عليهم رب العالمين فيقول: ألا يتبع كل إنسان ما كان يعبد؟ فيمثل لصاحب الصليب صليبه ولصاحب التصأوير تصأويره ولصاحب النار ناره فيتبعون ما كانوا يعبدون ويبقى المسلمون فيطلع عليهم رب العالمين فيقول: ألا تتبعون الناس؟ فيقولون: نعوذ بالله منك نعوذ بالله منك الله ربنا وهذا مكاننا حتى نرى ربنا وهو يأمرهم ويثبتهم قالوا: وهل نراه يا رسول الله؟ قال: وهل تضارون في رؤية القمر ليلة البدر؟ قالوا: لا قال: فإنكم لا تضارون في رؤيته تلك الساعة ثم يتوارى ثم يطلع فيعرفهم نفسه ثم يقول: أنا ربكم فاتبعوني فيقوم المسلمون ويوضع الصراط فيمر عليه مثل جياد الخيل والركاب وقولهم عليه: سلم سلم ويبقى أهل النار فيطرح فيها منهم فوج ثم يقال: هل امتلأت؟ فتقول: هل من مزيد؟ ثم يطرح فيها فوج فيقال: هل امتلأت؟ فتقول: هل من مزيد؟ حتى إذا أوعبوا فيها وضع الرحمن قدمه فيها وأزوى بعضها إلى بعض ثم قال: قط؟ قالت: قط قط فإذا أدخل الله أهل الجنة الجنة وأهل النار النار أتي بالموت ملببا فيوقف على السور الذي بين أهل الجنة وأهل النار ثم يقال: يا أهل الجنة! فيطلعون خائفين ثم يقال: يا أهل النار! فيطلعون مستبشرين يرجون الشفاعة فيقال لأهل الجنة وأهل النار: هل تعرفون هذا؟ فيقول هؤلاء وهؤلاء: قد عرفناه هو الموت الذي وكل بنا فيضجع فيذبح ذبحا على السور ثم يقال: يا أهل الجنة! خلود لا موت ويا أهل النار! خلود لا موت","صحيح","Sahih al-Jami al-Saghir 8025","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8026","يجمع المؤمنون يوم القيامة فيهتمون لذلك فيقولون: لو استشفعنا على ربنا فأراحنا من مكاننا هذا فيأتون آدم فيقولون: يا آدم! أنت أبو البشر خلقك الله بيده وأسجد لك ملائكته وعلمك أسماء كل شيء فاشفع لنا عند ربك حتى يريحنا من مكاننا هذا فيقول لهم آدم: لست هناكم ويذكر ذنبه الذي أصابه فيستحي ربه عز وجل من ذلك ويقول: ولكن ائتوا نوحا فإنه أول رسول بعثه الله إلى أهل الأرض فيأتون نوحا فيقول: لست هناكم ويذكر لهم خطيئة سؤاله ربه ما ليس له به علم فيستحي ربه من ذلك ولكن ائتوا إبراهيم خليل الرحمن فيأتونه فيقول: لست هناكم ولكن ائتوا موسى عبدا كلمه الله وأعطاه التوراة فيأتون موسى فيقول: لست هناكم ويذكر لهم النفس التي قتل بغير نفس فيستحي ربه من ذلك ولكن ائتوا عيسى عبد الله ورسوله وكلمته وروحه فيأتون عيسى فيقول لهم: لست هناكم ولكن ائتوا محمدا عبدا غفر الله له ما تقدم من ذنبه وما تأخر فأقوم فأمشي بين سماطين من المؤمنين حتى استأذن على ربي فيؤذن لي فإذا رأيت ربي وقعت ساجدا لربي تبارك وتعالى فيدعني ما شاء أن يدعني ثم يقول: ارفع محمد قل يسمع وسل تعطه واشفع تشفع فأرفع رأسي فأحمده بتحميد يعلمنيه ثم أشفع فيحد لي حدا فأدخلهم الجنة ثم أعود إليه الثانية فإذا رأيت ربي وقعت ساجدا لربي تبارك وتعالى فيدعني ما شاء الله أن يدعني ثم يقول: ارفع محمد! قل يسمع وسل تعطه واشفع تشفع فأرفع رأسي فأحمده بتحميد يعلمنيه ثم أشفع فيحد لي حدا فأدخلهم الجنة ثم أعود الثالثة فإذا رأيت ربي تبارك وتعالى وقعت ساجدا لربي فيدعني ما شاء أن يدعني ثم يقول: ارفع محمد! قل يسمع وسل تعطه واشفع تشفع فإذا رفعت رأسي فأحمده بتحميد يعلمنيه ثم أشفع فيحد لي حدا فأدخلهم الجنة ثم أعود الرابعة فأقول: يا رب! ما بقي إلا من حبسه القرآن فيخرج من النار من قال: لا إله إلا الله وكان في قلبه من الخير ما يزن شعيرة ثم يخرج من النار من قال: لا إله إلا الله وكان في قلبه من الخير ما يزن برة ثم يخرج من النار من قال: لا إله إلا الله وكان في قلبه من الخير ما يزن ذرة","صحيح","Sahih al-Jami al-Saghir 8026","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8027","«يجمع الله الناس يوم القيامة فيقوم المؤمنون حين تزلف لهم الجنة فيأتون آدم فيقولون: يا أبانا! استفتح لنا الجنة فيقول: وهل أخرجكم من الجنة إلا خطيئة أبيكم آدم لست بصاحب ذلك اذهبوا إلى ابني إبراهيم خليل الله فيقول إبراهيم: لست بصاحب ذلك إنما كنت خليلا من وراء وراء اعمدوا إلى موسى الذي كلمه الله تكليما فيأتون موسى فيقول: لست بصاحب ذلك اذهبوا إلى عيسى كلمة الله وروحه فيقول عيسى لست بصاحب ذلك اذهبوا إلى محمد فيأتون محمدا فيقوم فيؤذن له وترسل الأمانة والرحم فتقومان جنبتي الصراط يمينا وشمالا فيمر أولكم كالبرق ثم كمر الريح ثم كمر الطير وشد الرجال تجري بهم أعمالهم ونبيكم قائم على الصراط يقول: يا رب سلم سلم حتى تعجز أعمال العباد وحتى يجيء الرجل فلا يستطيع السير إلا زحفا وفي حافتي الصراط كلاليب معلقة مأمورة تأخذ من أمرت بأخذه فمخدوش ناج ومكدوس في النار»","صحيح","Sahih al-Jami al-Saghir 8027","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8028","يجيء الدجال فيطأ الأرض إلا مكة والمدينة فيأتي المدينة فيجد بكل نقب من أنقابها صفوفا من الملائكة فيأتي سبخة الجرف فيضرب رواقه فترجف المدينة ثلاث رجفات فيخرج إليه كل منافق ومنافقة","صحيح","Sahih al-Jami al-Saghir 8028","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8029","«يجيء الرجل آخذا بيد الرجل فيقول: يا رب! هذا قتلني فيقول الله له: لم قتلته؟ فيقول: قتلته لتكون العزة لك فيقول: فإنها لي ويجيء الرجل آخذا بيد الرجل فيقول: أي رب! إن هذا قتلني فيقول الله: لم قتلته؟ فيقول: لتكون العزة لفلان! فيقول: إنها ليست لفلان فيبوء بإثمه»","صحيح","Sahih al-Jami al-Saghir 8029","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8030","«يجيء القرآن يوم القيامة فيقول: يا رب حله فيلبس تاج الكرامة ثم يقول: يا رب زده فيلبس حلة الكرامة ثم يقول: يا رب ارض عنه فيرضى عنه فيقول: اقرأ وارق ويزاد بكل آية حسنة»","حسن","Sahih al-Jami al-Saghir 8030","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8031","«يجيء المقتول بالقاتل يوم القيامة ناصيته ورأسه بيده وأوداجه تشخب دما فيقول: يا رب! سل هذا فيم قتلني؟ حتى يدنيه من العرش»","صحيح","Sahih al-Jami al-Saghir 8031","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8032","«يجيء المقتول يوم القيامة متعلقا بقاتله فيقول الله: فيم قتلت هذا؟ فيقول: في ملك فلان»","صحيح","Sahih al-Jami al-Saghir 8032","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8033","يجيء النبي يوم القيامة ومعه الرجل والنبي ومعه الرجلان والنبي ومعه الثلاثة وأكثر من ذلك فيقال له: هل بلغت قومك؟ فيقول: نعم فيدعى قومه فيقال لهم: هل بلغكم هذا؟ فيقولون: لا فيقال له: من يشهد لك؟ فيقول: محمد وأمته فيدعى محمد وأمته فيقال لهم: هل بلغ هذا قومه فيقولون: نعم فيقال: وما علمكم بذلك؟ فيقولون: جاءنا نبينا فأخبرنا أن الرسل قد بلغوا فصدقناه فذلك قوله: {وَكَذَلِكَ جَعَلْنَاكُمْ أُمَّةً وَسَطاً لِتَكُونُوا شُهَدَاءَ عَلَى النَّاسِ وَيَكُونَ الرَّسُولُ عَلَيْكُمْ شَهِيداً}","صحيح","Sahih al-Jami al-Saghir 8033","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8034","«يجيء نوح وأمته فيقول الله: هل بلغت؟ فيقول: نعم أي رب! فيقول لأمته: هل بلغكم؟ فيقولون: لا ما جاء لنا من نبي فيقول لنوح من يشهد لك؟ فيقول: محمد وأمته وهو قوله تعالى: {وَكَذَلِكَ جَعَلْنَاكُمْ أُمَّةً وَسَطاً لِتَكُونُوا شُهَدَاءَ عَلَى النَّاسِ} والوسط: العدل فيدعون فيشهدون له بالبلاغ ثم أشهد عليكم»","صحيح","Sahih al-Jami al-Saghir 8034","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8035","«يجيء يوم القيامة ناس من المسلمين بذنوب أمثال الجبال يغفرها الله لهم ويضعها على اليهود»","صحيح","Sahih al-Jami al-Saghir 8035","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8036","«يجير على أمتي أدناهم»","صحيح","Sahih al-Jami al-Saghir 8036","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8037","«يحب الله العامل إذا عمل أن يحسن»","حسن","Sahih al-Jami al-Saghir 8037","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8038","«يحرم من الرضاعة ما يحرم من النسب»","صحيح","Sahih al-Jami al-Saghir 8038","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8039","يحسب ما خانوك وعصوك وكذبوك وعقابك إياهم فإن كان عقابك إياهم بقدر ذنوبهم كان كفافا لا لك ولا عليك وإن كان عقابك إياهم دون ذنوبهم كان فضلا لك وإن كان عقابك إياهم فوق ذنوبهم اقتص لهم منك الفضل أما تقرأ كتاب الله: {وَنَضَعُ الْمَوَازِينَ الْقِسْطَ لِيَوْمِ الْقِيَامَةِ} الآية؟","صحيح","Sahih al-Jami al-Saghir 8039","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8040","«يحشر المتكبرون يوم القيامة أمثال الذر في صور الرجال يغشاهم الذل من كل مكان يساقون إلى سجن في جهنم يسمى بولس تعلوهم نار الأنيار يسقون من عصارة أهل النار طينة الخبال»","حسن","Sahih al-Jami al-Saghir 8040","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8041","«يحشر الناس على ثلاث طرائق: راغبين راهبين واثنان على بعير وثلاثة على بعير وأربعة على بعير وعشرة على بعير ويحشر بقيتهم النار لتقيل معهم حيث قالوا وتبيت معهم حيث باتوا وتصبح معهم حيث أصبحوا وتمسي معهم حيث أمسوا»","صحيح","Sahih al-Jami al-Saghir 8041","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8042","«يحشر الناس على نياتهم»","صحيح","Sahih al-Jami al-Saghir 8042","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8043","«يحشر الناس يوم القيامة حفاة عراة غرلا الأمر أشد من أن ينظر بعضهم إلى بعض»","صحيح","Sahih al-Jami al-Saghir 8043","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8044","«يحشر الناس يوم القيامة على أرض بيضاء عفراء كقرصة النقي ليس فيها معلم لأحد»","صحيح","Sahih al-Jami al-Saghir 8044","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8045","يحضر الجمعة ثلاثة نفر رجل حضرها يلغو، وهو حظه منها ورجل حضرها يدعو فهو رجل دعا الله عز وجل إن شاء أعطاه وإن شاء منعه ورجل حضرها بإنصات وسكون ولم يتخط رقبة مسلم ولم يؤذ أحدا فهو كفارة إلى الجمعة التي تليها وزيادة ثلاثة أيام وذلك بأن الله يقول: {مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ عَشْرُ أَمْثَالِهَا}","حسن","Sahih al-Jami al-Saghir 8045","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8046","«يختصم الشهداء والمتوفون على فرشهم إلى ربنا في الذين يتوفون من الطاعون فيقول الشهداء إخواننا قتلوا كما قتلنا ويقول المتوفون على فرشهم: إخواننا ماتوا على فرشهم كما متنا فيقضي الله بينهم فيقول ربنا: انظروا إلى جراحهم فإن أشبهت جراحهم جراح المقتولين فإنهم منهم ومعهم فينظرون إلى جراح المطعونين فإذا جراحهم قد أشبهت جراح الشهداء فيلحقون بهم»","حسن","Sahih al-Jami al-Saghir 8046","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8047","يخرج الدجال في أمتي فيمكث أربعين فيبعث الله تعالى عيسى ابن مريم كأنه عروة ابن مسعود الثقفي فيطلبه فيهلكه ثم يمكث الناس سبع سنين ليس بين اثنين عدأوة ثم يرسل الله ريحا باردة من قبل الشام فلا يبقى على وجه الأرض أحد في قلبه مثقال ذرة من إيمان إلا قبضته حتى لوأن أحدكم دخل في كبد جبل لدخلت عليه حتى تقبضه فيبقى شرار الناس في خفة الطير وأحلام السباع لا يعرفون معروفا ولا ينكرون منكرا فيتمثل لهم الشيطان فيقول: ألا تستجيبون؟ فيقولون: بم تأمرنا؟ فيأمرهم بعبادة الأوثان فيعبدونها وهم في ذلك دار رزقهم حسن عيشهم ثم ينفخ في الصور فلا يسمعه أحد إلا أصغى ليتا ورفع ليتا وأول من يسمعه رجل يلوط حوض إبله فيصعق ويصعق الناس ثم يرسل الله مطرا كأنه الطل فينبت منه أجساد الناس ثم ينفخ فيه أخرى فإذا هم قيام ينظرون ثم؟ يقال: يا أيها الناس! هلم إلى ربكم {وَقِفُوهُمْ إِنَّهُمْ مَسْؤُولُونَ} ثم يقال: أخرجوا بعث النار فيقال: من كم؟ فيقال: من كل ألف تسعمائة وتسعة وتسعون فذلك يوم يجعل الولدان شيبا وذلك يوم يكشف عن ساق","صحيح","Sahih al-Jami al-Saghir 8047","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8048","«يخرج الدجال فيتوجه قبله رجل من المؤمنين فيلقاه المسالح مسالح الدجال فيقولون له: أين تعمد؟ فيقول: أعمد إلى هذا الذي خرج فيقولون له: أوما تؤمن بربنا؟ فيقول: ما بربنا خفاء فيقولون: اقتلوه فيقول بعضهم لبعض: أليس قد نهاكم ربكم أن تقتلوا أحد دونه؟ فينطلقون به إلى الدجال فإذا رآه المؤمن قال: يا أيها الناس هذا الدجال الذي ذكر رسول الله صلى الله عليه وسلم فيأمر الدجال به فيشبح فيقول: خذوه وشجوه فيوسع بطنه وظهره ضربا فيقول: أما تؤمن بي؟ فيقول: أنت المسيح الكذاب فيؤمر به فينشر بالمنشار من مفرقه حتى يفرق بين رجليه ثم يمشي الدجال بين القطعتين ثم يقول له: قم فيستوى قائما ثم يقول له: أتؤمن بي؟ فيقول: ما ازددت فيك إلا بصيرة ثم يقول: يا أيها الناس إنه لا يفعل بعدي بأحد من الناس فيأخذه الدجال فيذبحه فيجعل ما بين رقبته إلى ترقوته نحاسا فلا يستطيع إليه سبيلا فيأخذ بيديه ورجليه فيقذف به فيحسب الناس أنما قذفه في النار وإنما ألقي في الجنة هذا أعظم الناس شهادة عند رب العالمين»","صحيح","Sahih al-Jami al-Saghir 8048","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8049","«يخرج الدجال ومعه نهر ونار فمن دخل نهره وجب وزره وحط أجره ومن دخل ناره وجب أجره وحط وزره ثم إنما هي قيام الساعة»","صحيح","Sahih al-Jami al-Saghir 8049","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8050","«يخرج الله قوما من النار فيدخلهم الجنة»","صحيح","Sahih al-Jami al-Saghir 8050","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8051","«يخرج عنق من النار يوم القيامة له عينان يبصران وأذنان يسمعان ولسان ينطق يقول: إني وكلت بثلاثة: بكل جبار عنيد وبكل من دعا مع الله إلها آخر وبالمصورين»","صحيح","Sahih al-Jami al-Saghir 8051","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8052","«يخرج في آخر الزمان قوم أحداث الأسنان سفهاء الأحلام يقرءون القرآن بألسنتهم لا يجأوز تراقيهم يقولون من قول خير البرية يمرقون من الدين كما يمرق السهم من الرمية فمن لقيهم فليقتلهم فإن في قتلهم أجرا عظيما عند الله لمن قتلهم»","صحيح","Sahih al-Jami al-Saghir 8052","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8053","«يخرج فيكم قوم تحقرون صلاتكم مع صلاتهم وصيامكم مع صيامهم وعملكم مع عملهم يقرءون القرآن لا يجأوز حناجرهم يمرقون من الدين كما يمرق السهم من الرمية ينظر الرامي في النصل فلا يرى شيئا وينظر في القدح فلا يرى شيئا وينظر في الريش فلا يرى شيئا ويتمارى في الفوق هل علق به من الدم شيء»","صحيح","Sahih al-Jami al-Saghir 8053","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8054","«يخرج قوم في آخر الزمان يقرءون القرآن لا يجأوز تراقيهم سيماهم التحليق إذا لقيتموهم فاقتلوهم»","صحيح","Sahih al-Jami al-Saghir 8054","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8055","يخرج قوم من النار بشفاعة محمد صلى الله عليه وسلم فيدخلون الجنة ويسمون الجهنميين","صحيح","Sahih al-Jami al-Saghir 8055","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8056","«يخرج قوم من أمتي يقرءون القرآن ليس قراءتكم إلى قراءتهم بشيء ولا صلاتكم إلى صلاتهم بشيء ولا صيامكم إلى صيامهم بشيء يقرءون القرآن يحسبون أنه لهم وهو عليهم لا تجأوز صلاتهم تراقيهم يمرقون من الإسلام كما يمرق السهم من الرمية لويعلم الجيش الذين يصيبونهم ما قضى لهم على لسان نبيهم لاتكلوا عن العمل وآية ذلك أن فيهم رجلا له عضد ليس فيه ذراع على رأس عضده مثل حلمة الثدي عليه شعرات بيض»","صحيح","Sahih al-Jami al-Saghir 8056","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8057","«يخرج من المشرق أقوام محلقة رءوسهم يقرءون القرآن بألسنتهم لا يعدو تراقيهم يمرقون من الدين كما يمرق السهم من الرمية»","صحيح","Sahih al-Jami al-Saghir 8057","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8058","«يخرج من النار أربعة فيعرضون على الله فيلتفت إليه أحدهم فيقول: أي رب! إذا أخرجتني منها لا تعدني فيها فينجيه الله منها»","صحيح","Sahih al-Jami al-Saghir 8058","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8059","«يخرج من النار قوم بالشفاعة كأنهم الثعارير»","صحيح","Sahih al-Jami al-Saghir 8059","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8060","«يخرج من النار قوم بعد ما احترقوا فيدخلون الجنة فيسميهم أهل الجنة الجهنميين»","صحيح","Sahih al-Jami al-Saghir 8060","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8061","«يخرج من النار من قال: لا إله إلا الله وكان في قلبه من الخير ما يزن شعيرة ثم يخرج من النار من قال لا إله إلا الله وكان في قلبه من الخير ما يزن برة ثم يخرج من النار من قال لا إله إلا الله وكان في قلبه من الخير ما يزن ذرة»","صحيح","Sahih al-Jami al-Saghir 8061","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8062","«يخرج من النار من كان في قلبه مثقال ذرة من الإيمان»","صحيح","Sahih al-Jami al-Saghir 8062","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8063","«يخرج ناس من قبل المشرق يقرءون القرآن لا يجأوز تراقيهم يمرقون من الدين كما يمرق السهم من الرمية ثم لا يعودون فيه حتى يعود السهم إلى فوقه سيماهم التحليق»","صحيح","Sahih al-Jami al-Saghir 8063","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8064","«يخرب الكعبة ذو السويقتين من الحبشة»","صحيح","Sahih al-Jami al-Saghir 8064","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8065","«يد الله على الجماعة»","صحيح","Sahih al-Jami al-Saghir 8065","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8066","«يد الله ملأى لا يغيضها نفقة سحاء الليل والنهار أرأيتم ما أنفق منذ خلق السموات والأرض؟ فإنه لم يغض ما في يده وكان عرشه على الماء وبيده الميزان يخفض ويرفع»","صحيح","Sahih al-Jami al-Saghir 8066","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8067","«يد المعطي العليا وابدأ بمن تعول أمك وأباك وأختك وأخاك ثم أدناك أدناك إنها لا تجني نفس على أخرى»","صحيح","Sahih al-Jami al-Saghir 8067","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8068","«يدخل الجنة أقوام أفئدتهم مثل أفئدة الطير»","صحيح","Sahih al-Jami al-Saghir 8068","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8069","«يدخل الجنة بشفاعة رجل من أمتي أكثر من بنى تميم»","صحيح","Sahih al-Jami al-Saghir 8069","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8070","«يدخل الجنة من أمتي زمرة وهم سبعون ألفا تضيء وجوههم إضاءة القمر ليلة البدر»","صحيح","Sahih al-Jami al-Saghir 8070","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8071","«يدخل الجنة من أمتي سبعون ألفا بغير حساب هم الذين لا يسترقون ولا يتطيرون ولا يكتوون وعلى ربهم يتوكلون»","صحيح","Sahih al-Jami al-Saghir 8071","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8072","«يدخل أهل الجنة الجنة جردا مردا كأنهم مكحلون أبناء ثلاث وثلاثين»","صحيح","Sahih al-Jami al-Saghir 8072","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8073","يدخل أهل الجنة الجنة وأهل النار النار ثم يقول الله عز وجل: أخرجوا من كان في قلبه مثقال حبة من خردل من إيمان فيخرجون منها قد اسودوا فيلقون في نهر الحياة فينبتون كما تنبت الحبة في جانب السيل ألم تر أنها تخرج صفراء ملتوية","صحيح","Sahih al-Jami al-Saghir 8073","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8074","«يدخل الله أهل الجنة الجنة وأهل النار النار ثم يقوم مؤذن بينهم فيقول: يا أهل الجنة! لا موت ويا أهل النار! لا موت كل خالد فيما هو فيه»","صحيح","Sahih al-Jami al-Saghir 8074","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8075","«يدخل الملك على النطفة بعد ما تستقر في الرحم بأربعين ليلة فيقول: يا رب! ماذا؟ أشقى أم سعيد؟ أذكر أم أنثى؟ فيقول الله فيكتبان ويكتب عمله وأثره ومصيبته ورزقه وأجله ثم تطوى الصحيفة فلا يزاد على ما فيها ولا ينقص»","صحيح","Sahih al-Jami al-Saghir 8075","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8076","«يدخل فقراء المسلمين الجنة قبل أغنيائهم بنصف يوم وهو خمسمائة عام»","صحيح","Sahih al-Jami al-Saghir 8076","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8077","«يدرس الإسلام كما يدرس وشي الثوب حتى لا يدري ما صيام؟ ولا صلاة ولا نسك ولا صدقة ويسرى على كتاب الله في ليلة فلا يبقى في الأرض منه آية وتبقى طوائف من الناس الشيخ الكبير والعجوز يقولون: أدركنا آباءنا على هذه الكلمة يقولون: لا إله إلا الله فنحن نقولها»","صحيح","Sahih al-Jami al-Saghir 8077","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8078","«يذهب الصالحون الأول فالأول ويبقى حفالة كحفالة الشعير أو التمر لا يباليهم الله تعالى بالة»","صحيح","Sahih al-Jami al-Saghir 8078","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8079","يرحم الله أم إسماعيل لو تركت زمزم أو قال لو لم تغرف من الماء لكانت عينا معينا","صحيح","Sahih al-Jami al-Saghir 8079","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8080","«يرحم الله أم إسماعيل لولا أنها عجلت لكانت زمزم عينا معينا»","صحيح","Sahih al-Jami al-Saghir 8080","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8081","«يرد الناس النار ثم يصدرون عنها بأعمالهم فأولهم كلمح البصر ثم كمر الريح ثم كحضر الفرس ثم كالراكب في رحله ثم كشد الرجل ثم كمشيه»","صحيح","Sahih al-Jami al-Saghir 8081","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8082","«يرد علي يوم القيامة رهط من أصحابي فيجلون عن الحوض فأقول: أي رب! أصحابي فيقول: إنك لا علم لك بما أحدثوا بعدك إنهم ارتدوا بعدك على أدبارهم القهقرى»","صحيح","Sahih al-Jami al-Saghir 8082","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8083","«يرسل البكاء على أهل النار فيبكون حتى تنقطع الدموع ثم يبكون الدم حتى يصير في وجوههم كهيئة الأخدود لو أرسلت فيه السفن لجرت»","حسن","Sahih al-Jami al-Saghir 8083","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8084","«يسألوني عن الساعة وإنما علمها عند الله وأقسم بالله ما على الأرض من نفس منفوسة اليوم يأتي عليها مائة سنة»","صحيح","Sahih al-Jami al-Saghir 8084","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8085","«يستجاب لأحدكم ما لم يعجل يقول: قد دعوت فلم يستجب لي»","صحيح","Sahih al-Jami al-Saghir 8085","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8086","«يسروا ولا تعسروا وبشروا ولا تنفروا»","صحيح","Sahih al-Jami al-Saghir 8086","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8087","«يسروا ولا تعسروا وبشروا ولا تنفروا وتطاوعا ولا تختلفا»","صحيح","Sahih al-Jami al-Saghir 8087","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8088","«يسلم الراكب على الماشي والماشي على القائم والقليل على الكثير»","صحيح","Sahih al-Jami al-Saghir 8088","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8089","«يسلم الراكب على الماشي والماشي على القاعد والقليل على الكثير»","صحيح","Sahih al-Jami al-Saghir 8089","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8090","«يسلم الصغير على الكبير والمار على القاعد والقليل على الكثير»","صحيح","Sahih al-Jami al-Saghir 8090","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8091","«يشرب ناس من أمتي الخمر باسم يسمونها إياه»","صحيح","Sahih al-Jami al-Saghir 8091","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8092","«يشرب ناس من أمتي الخمر يسمونها بغير اسمها»","صحيح","Sahih al-Jami al-Saghir 8092","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8093","«يشفع الشهيد في سبعين من أهل بيته»","صحيح","Sahih al-Jami al-Saghir 8093","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8094","«يشمت العاطس ثلاثا فما زاد فهو مزكوم»","صحيح","Sahih al-Jami al-Saghir 8094","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8095","«يصاح برجل من أمتي يوم القيامة على رءوس الخلائق فينشر له تسعة وتسعون سجلا كل سجل مد البصر ثم يقول الله تبارك وتعالى: هل تنكر من هذا شيئا؟ فيقول: لا يا رب فيقول: أظلمك كتبتي الحافظون؟ فيقول: لا يا رب ثم يقول: ألك عذر ألك حسنة؟ فيهاب الرجل فيقول: لا فيقول: بلى إن لك عندنا حسنة وإنه لا ظلم عليك اليوم فتخرج له بطاقة فيها: أشهد أن لا إله إلا الله وأن محمدا عبده ورسوله فيقول: يا رب ما هذه البطاقة مع هذه السجلات؟ فيقول: إنك لا تظلم فتوضع السجلات في كفة والبطاقة في كفة فطاشت السجلات وثقلت البطاقة»","صحيح","Sahih al-Jami al-Saghir 8095","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8096","«يصبح على كل سلامى من ابن آدم صدقة تسليمه على من لقي صدقة وأمره بالمعروف صدقة ونهيه عن المنكر صدقة وإماطة الأذى عن الطريق صدقة وبضعه أهله صدقة ويجزي من ذلك كله ركعتان من الضحى قالوا: يا رسول الله أحدنا يقضي شهوته وتكون له صدقة؟ قال: أرأيت لووضعها في غير حلها ألم يكن يأثم»","صحيح","Sahih al-Jami al-Saghir 8096","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8097","«يصبح على كل سلامى من أحدكم صدقة فكل تسبيحة صدقة وكل تحميدة صدقة وكل تهليلة صدقة وكل تكبيرة صدقة وأمر بالمعروف صدقة ونهي عن المنكر صدقة ويجزي من ذلك ركعتان تركعهما من الضحى»","صحيح","Sahih al-Jami al-Saghir 8097","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8098","«يصبح على كل سلامى من أحدكم في كل يوم صدقة فله بكل صلاة صدقة وصيام صدقة وحج صدقة وتسبيح صدقة وتكبير صدقة وتحميد صدقة ويجزي أحدكم من ذلك ركعتا الضحى»","صحيح","Sahih al-Jami al-Saghir 8098","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8099","«يصلون لكم فإن أصابوا فلكم وإن أخطئوا فلكم وعليهم»","صحيح","Sahih al-Jami al-Saghir 8099","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8100","«يضحك الله إلى رجلين يقتل أحدهما الآخر يدخلان الجنة يقاتل هذا في سبيل الله فيقتل ثم يتوب الله على القاتل فيسلم فيقاتل في سبيل الله فيستشهد»","صحيح","Sahih al-Jami al-Saghir 8100","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8101","«يطوي الله السموات يوم القيامة ثم يأخذهن بيده اليمنى ثم يقول: أنا الملك أين الجبارون؟ أين المتكبرون؟ ثم يطوي الأرضين ثم يأخذهن بشماله ثم يقول: أنا الملك أين الجبارون؟ أين المتكبرون؟»","صحيح","Sahih al-Jami al-Saghir 8101","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8102","يعجب ربك من راعي غنم في رأس شظية بجبل يؤذن للصلاة ويصلي فيقول الله عز وجل: انظروا إلى عبدي هذا يؤذن ويقيم الصلاة يخاف مني قد غفرت لعبدي وأدخلته الجنة","صحيح","Sahih al-Jami al-Saghir 8102","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8103","«يعذب ناس من أهل التوحيد فيطرحون في النار حتى يكونوا فيها حمما ثم تدركهم الرحمة فيخرجون ويطرحون على أبواب الجنة فيرش عليهم أهل الجنة الماء فينبتون كما ينبت الغثاء في حمالة السيل ثم يدخلون الجنة»","صحيح","Sahih al-Jami al-Saghir 8103","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8104","«يعرق الناس يوم القيامة حتى يذهب عرقهم في الأرض سبعين ذراعا يلجمهم حتى يبلغ آذانهم»","صحيح","Sahih al-Jami al-Saghir 8104","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8105","«يعض أحدكم أخاه كما يعض الفحل؟! لا دية له»","صحيح","Sahih al-Jami al-Saghir 8105","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8106","«يعطى المؤمن في الجنة قوة مائة في النساء»","صحيح","Sahih al-Jami al-Saghir 8106","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8107","«يعقد الشيطان على قافية رأس أحدكم إذا هونام ثلاث عقد يضرب مكان كل عقدة: عليك ليل طويل فارقد فإن استيقظ فذكر الله انحلت عقدة فإن توضأ انحلت عقدة فإن صلى انحلت عقده كلها فأصبح نشيطا طيب النفس وإلا أصبح خبيث النفس كسلان»","صحيح","Sahih al-Jami al-Saghir 8107","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8108","«يعق عن الغلام ولا يمس رأسه بدم»","صحيح","Sahih al-Jami al-Saghir 8108","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8109","«يعمد أحدكم إلى جمرة من نار فيجعلها في يده»","صحيح","Sahih al-Jami al-Saghir 8109","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8110","«يعمد أحدكم فيبرك في صلاته كما يبرك الجمل؟!»","صحيح","Sahih al-Jami al-Saghir 8110","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8111","«يعمد أحدكم فيجلد امرأته جلد العبد ولعله يضاجعها في آخر يومه»","صحيح","Sahih al-Jami al-Saghir 8111","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8112","«يعمد الشيطان إلى أحدكم فيتهول له ثم يغدو يخبر الناس؟!»","صحيح","Sahih al-Jami al-Saghir 8112","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8113","«يعوذ عائذ بالبيت فيبعث إليه بعث فإذا كانوا ببيداء من الأرض خسف بهم قيل: يا رسول الله! فكيف بمن كان كارها؟ قال: يخسف به معهم ولكنه يبعث يوم القيامة على نيته»","صحيح","Sahih al-Jami al-Saghir 8113","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8114","«يغزوجيش الكعبة فإذا كانوا ببيداء من الأرض خسف بأولهم وآخرهم ثم يبعثون على نياتهم»","صحيح","Sahih al-Jami al-Saghir 8114","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8115","«يغزوهذا البيت جيش فيخسف بهم بالبيداء»","صحيح","Sahih al-Jami al-Saghir 8115","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8116","«يغسل الإناء إذا ولغ فيه الكلب سبع مرات أخراهن أو أولاهن بالتراب وإذا ولغت فيه الهرة غسل مرة»","صحيح","Sahih al-Jami al-Saghir 8116","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8117","«يغسل من بول الجارية ويرش من بول الغلام»","صحيح","Sahih al-Jami al-Saghir 8117","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8118","«يغضب علي أن لا أجد ما أعطيه! من سأل منكم وله أوقية أو عدلها فقد سأل إلحافا»","صحيح","Sahih al-Jami al-Saghir 8118","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8119","«يغفر للشهيد كل ذنب إلا الدين»","صحيح","Sahih al-Jami al-Saghir 8119","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8120","«يقال لأهل الجنة: يا أهل الجنة! خلود لا موت ولأهل النار: يا أهل النار! خلود لا موت»","صحيح","Sahih al-Jami al-Saghir 8120","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8121","«يقال لصاحب القرآن إذا دخل الجنة: اقرأ واصعد فيقرأ ويصعد لكل آية درجة حتى يقرأ آخر شيء معه»","صحيح","Sahih al-Jami al-Saghir 8121","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8122","«يقال لصاحب القرآن: اقرأ وارق ورتل كما كنت ترتل في دار الدنيا فإن منزلتك عند آخر آية كنت تقرؤها»","صحيح","Sahih al-Jami al-Saghir 8122","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8123","«يقال للرجل من أهل النار يوم القيامة: أرأيت لو كان لك ما على الأرض من شيء أكنت مفتديا به؟ فيقول: نعم؟ فيقول الله: كذبت قد أردت منك أهون من ذلك قد أخذت عليك في ظهر آدم أن لا تشرك بي شيئا فأبيت إلا أن تشرك»","صحيح","Sahih al-Jami al-Saghir 8123","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8124","«يقبض العلم ويظهر الجهل والفتن ويكثر الهرج»","صحيح","Sahih al-Jami al-Saghir 8124","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8125","«يقبض الله الأرض يوم القيامة ويطوي السموات بيمينه ثم يقول: أنا الملك أين ملوك الأرض؟»","صحيح","Sahih al-Jami al-Saghir 8125","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8126","«يقتل ابن مريم الدجال بباب لد»","صحيح","Sahih al-Jami al-Saghir 8126","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8127","«يقتل المحرم ... الكلب العقور والفأرة والعقرب والحدأة والغراب»","صحيح","Sahih al-Jami al-Saghir 8127","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8128","«يقطع الصلاة الحمار والمرأة والكلب»","صحيح","Sahih al-Jami al-Saghir 8128","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8129","«يقطع الصلاة المرأة الحائض والكلب الأسود»","صحيح","Sahih al-Jami al-Saghir 8129","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8130","«يقطع الصلاة المرأة والحمار والكلب ويقي من ذلك مثل مؤخرة الرحل»","صحيح","Sahih al-Jami al-Saghir 8130","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8131","«يقطع صلاة الرجل إذا لم يكن بين يديه كمؤخرة الرحل المرأة والحمار والكلب الأسود؛ الكلب الأسود شيطان»","صحيح","Sahih al-Jami al-Saghir 8131","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8132","«يقول ابن آدم: مالي مالي وهل لك يا ابن آدم من مالك إلا ما أكلت فأفنيت أو لبست فأبليت أو تصدقت فأمضيت؟»","صحيح","Sahih al-Jami al-Saghir 8132","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8133","«يقول العبد: مالي مالي وإن له من ماله ثلاثا: ما أكل فأفنى أو لبس فأبلى أو أعطى فأقنى وما سوى ذلك فهو ذاهب وتاركه للناس»","صحيح","Sahih al-Jami al-Saghir 8133","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8134","«يقول العبد يوم القيامة: يا رب ألم تجرني من الظلم؟ فيقول: بلى فيقول: إني لا أجيز على نفسي إلا شاهدا مني فيقول {كَفَى بِنَفْسِكَ الْيَوْمَ عَلَيْكَ حَسِيباً} وبالكرام الكاتبين شهودا فيختم على فيه ويقال لأركانه: انطقي فتنطق بأعماله ثم يخلى بينه وبين الكلام فيقول: بعدا لكن وسحقا فعنكن كنت أناضل»","صحيح","Sahih al-Jami al-Saghir 8134","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8135","«يقول الله تعالى: المجاهد في سبيلي هوعلي ضامن إن قبضته أورثته الجنة وإن رجعته رجعته بأجر أو غنيمة»","صحيح","Sahih al-Jami al-Saghir 8135","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8136","يقول الله تعالى: أنا عند ظن عبدي بي وأنا معه إذا دعاني","صحيح","Sahih al-Jami al-Saghir 8136","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8137","«يقول الله تعالى: أنا عند ظن عبدي بي وأنا معه إذا ذكرني فإن ذكرني في نفسه ذكرته في نفسي وإن ذكرني في ملأ ذكرته في ملأ خير منهم وإن تقرب إلي بشبر تقربت إليه ذراعا وإن تقرب إلي ذراعا تقربت إليه باعا وإن أتاني يمشي أتيته هرولة»","صحيح","Sahih al-Jami al-Saghir 8137","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8138","«يقول الله تعالى: أنا عند ظن عبدي بي وأنا معه حين يذكرني والله لله أفرح بتوبة عبده من أحدكم يجد ضالته بالفلاة ومن تقرب إلي شبرا تقربت إليه ذراعا ومن تقرب إلي ذراعا تقربت إليه باعا وإن أقبل إلي يمشي أقبلت إليه أهرول»","صحيح","Sahih al-Jami al-Saghir 8138","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8139","«يقول الله تعالى: ما لعبدي المؤمن عندي جزاء إذا قبضت صفيه من أهل الدنيا ثم احتسبه إلا الجنة»","صحيح","Sahih al-Jami al-Saghir 8139","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8140","«يقول الله تعالى: من أذهبت حبيبتيه فصبر واحتسب لم أرض له ثوابا دون الجنة»","صحيح","Sahih al-Jami al-Saghir 8140","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8141","«يقول الله تعالى: من عمل حسنة فله عشر أمثالها وأزيد ومن عمل سيئة فجزاؤها مثلها أو أغفر ومن عمل قراب الأرض خطيئة ثم لقيني لا يشرك بي شيئا جعلت له مثلها مغفرة ومن اقترب إلي شبرا اقتربت إليه ذراعا ومن اقترب إلي ذراعا اقتربت إليه باعا ومن أتاني يمشي أتيته هرولة»","صحيح","Sahih al-Jami al-Saghir 8141","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8142","«يقول الله تعالى: يا آدم! فيقول: لبيك وسعديك والخير في يديك فيقول: أخرج بعث النار قال: وما بعث النار؟ قال من كل ألف تسعمائة وتسعة وتسعين فعندها يشيب الصغير {وَتَضَعُ كُلُّ ذَاتِ حَمْلٍ حَمْلَهَا وَتَرَى النَّاسَ سُكَارَى وَمَا هُمْ بِسُكَارَى وَلَكِنَّ عَذَابَ اللَّهِ شَدِيدٌ} قالوا: يا رسول الله! وأينا ذلك الواحد؟ قال: أبشروا فإن منكم رجلا ومن يأجوج ومأجوج ألف والذي نفسي بيده أرجوأن تكونوا ربع أهل الجنة أرجوأن تكونوا ثلث أهل الجنة أرجوأن تكونوا نصف أهل الجنة ما أنتم في الناس إلا كالشعرة السوداء في جلد ثور أبيض أو كشعرة بيضاء في جلد ثور أسود أو كالرقمة في ذراع الحمار»","صحيح","Sahih al-Jami al-Saghir 8142","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8143","«يقول الله تعالى: يا ابن آدم! إذا أخذت كريمتيك فصبرت واحتسبت عند الصدمة الأولى لم أرض لك ثوابا دون الجنة»","صحيح","Sahih al-Jami al-Saghir 8143","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8144","«يقول الله تعالى: يا ابن آدم! أنى تعجزني وقد خلقتك من مثل هذا؟ حتى إذا سويتك وعدلتك مشيت بين بردين وللأرض منك وئيد فجمعت ومنعت حتى إذا بلغت التراقي قلت: أتصدق وأنى أوان الصدقة؟!»","صحيح","Sahih al-Jami al-Saghir 8144","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8145","«يقولون: الكرم وإنما الكرم: قلب المؤمن»","صحيح","Sahih al-Jami al-Saghir 8145","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8146","«يقوم أحدهم في رشحه إلى أنصاف أذنيه»","صحيح","Sahih al-Jami al-Saghir 8146","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8147","«يقي أحدكم وجهه حر جهنم ولو بتمرة ولو بشق تمرة فإن أحدكم لاقي الله وقائل له ما أقول لأحدكم: ألم أجعل لك سمعا وبصرا؟ فيقول: بلى فيقول: ألم أجعل لك مالا وولدا؟ فيقول: بلى فيقول: أين ما قدمت لنفسك؟ فينظر قدامه وبعده وعن يمينه وعن شماله ثم لا يجد شيئا يقي به وجهه حر جهنم ليق أحدكم وجهه النار ولو بشق تمرة فإن لم يجد فبكلمة طيبة فإني لا أخاف عليكم الفاقة فإن الله ناصركم ومعطيكم حتى تسير الظعينة فيما بين يثرب والحيرة وأكثر ما يخاف على مطيتها السرق»","حسن","Sahih al-Jami al-Saghir 8147","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8148","«يكون عليكم أمراء من بعدي يؤخرون الصلاة فهي لكم وهي عليهم فصلوا معهم ما صلوا بكم القبلة»","صحيح","Sahih al-Jami al-Saghir 8148","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8149","«يكون في آخر الزمان الخسف والقذف والمسخ»","صحيح","Sahih al-Jami al-Saghir 8149","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8150","«يكون في آخر الزمان خليفة يقسم المال ولا يعده»","صحيح","Sahih al-Jami al-Saghir 8150","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8151","«يكون في آخر الزمان دجالون كذابون يأتونكم من الأحاديث بما لم تسمعوا أنتم ولا آباؤكم فإياكم وإياهم لا يضلونكم ولا يفتنونكم»","صحيح","Sahih al-Jami al-Saghir 8151","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8152","« [*» ... ألا فما قطع من حي فهو ميت]","صحيح","Sahih al-Jami al-Saghir 8152","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8153","«يكون في آخر الزمان قوم يخضبون بالسواد كحواصل الحمام لا يريحون رائحة الجنة»","صحيح","Sahih al-Jami al-Saghir 8153","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8154","«يكون في آخر أمتي خليفة يحثى المال حثيا ولا يعده عدا»","صحيح","Sahih al-Jami al-Saghir 8154","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8155","«يكون في أمتي خسف ومسخ وقذف»","صحيح","Sahih al-Jami al-Saghir 8155","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8156","«يكون في آخر هذه الأمة خسف ومسخ وقذف قيل: يا رسول الله! أنهلك وفينا الصالحون؟ قال: نعم إذا ظهر الخبث»","صحيح","Sahih al-Jami al-Saghir 8156","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8157","«يكون من بعدي اثنا عشر أميرا كلهم من قريش»","صحيح","Sahih al-Jami al-Saghir 8157","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8158","«يلقى إبراهيم أباه آزر يوم القيامة وعلى وجه آزر قترة وغبرة فيقول له إبراهيم: ألم أقل لك لا تعصني؟ فيقول أبوه: فاليوم لا أعصيك فيقول إبراهيم: يا رب! إنك وعدتني أن لا تخزيني يوم يبعثون وأي خزي أخزى من أبي الأبعد؟ فيقول الله: إني حرمت الجنة على الكافرين فيقال: يا إبراهيم! انظر ما بين رجليك! فينظر فإذا هو بذيخ ملتطخ فيؤخذ بقوائمه فيلقى في النار»","صحيح","Sahih al-Jami al-Saghir 8158","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8159","«يلقى عيسى حجته في قوله: {وَإِذْ قَالَ اللَّهُ يَا عِيسَى ابْنَ مَرْيَمَ أَأَنْتَ قُلْتَ لِلنَّاسِ اتَّخِذُونِي وَأُمِّيَ إِلَهَيْنِ مِنْ دُونِ اللَّهِ} فلقاه الله: {سُبْحَانَكَ مَا يَكُونُ لِي أَنْ أَقُولَ مَا لَيْسَ لِي بِحَقٍّ} الآية كلها»","صحيح","Sahih al-Jami al-Saghir 8159","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8160","«يلي رجل من أهل بيتي يواطئ اسمه اسمي لو لم يبق من الدنيا إلا يوم لطول الله ذلك اليوم حتى يلي»","حسن","Sahih al-Jami al-Saghir 8160","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8161","«يمكث المهاجر بمكة بعد قضاء نسكه ثلاثا»","صحيح","Sahih al-Jami al-Saghir 8161","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8162","«يمن الخيل في شقرها»","صحيح","Sahih al-Jami al-Saghir 8162","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8163","«يمينك على ما يصدقك عليه صاحبك»","صحيح","Sahih al-Jami al-Saghir 8163","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8164","«ينادي مناد: إن لكم أن تصحوا فلا تسقموا أبدا وإن لكم أن تحيوا فلا تموتوا أبدا وإن لكم أن تشبوا فلا تهرموا أبدا وإن لكم أن تنعموا فلا تبأسوا أبدا»","صحيح","Sahih al-Jami al-Saghir 8164","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8165","«ينزل الله تعالى إلى السماء الدنيا كل ليلة حين يمضي ثلث الليل الأول فيقول: أنا الملك أنا الملك من ذا الذي يدعوني فأستجيب له؟ من ذا الذي يسألني فأعطيه؟ من ذا الذي يستغفرني فأغفر له؟ فلا يزال كذلك حتى يضيء الفجر»","صحيح","Sahih al-Jami al-Saghir 8165","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8166","«ينزل الله تعالى في السماء الدنيا لثلث الليل الآخر فيقول: من يدعوني فأستجيب له أو يسألني فأعطيه ثم يبسط يديه يقول: من يقرض غير عديم ولا ظلوم»","صحيح","Sahih al-Jami al-Saghir 8166","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8167","«ينزل الله في كل ليلة إلى سماء الدنيا فيقول: هل من سائل فأعطيه؟ هل من مستغفر فأغفر له؟ هل من تائب فأتوب عليه؟ حتى يطلع الفجر»","صحيح","Sahih al-Jami al-Saghir 8167","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8168","«ينزل ربنا تبارك وتعالى كل ليلة إلى السماء الدنيا حين يبقى ثلث الليل الآخر فيقول: من يدعوني فأستجيب له؟ من يسألني فأعطيه؟ من يستغفرني فأغفر له»","صحيح","Sahih al-Jami al-Saghir 8168","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8169","«ينزل عيسى ابن مريم عند المنارة البيضاء شرقي دمشق»","صحيح","Sahih al-Jami al-Saghir 8169","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8170","«ينزل ناس من أمتي بغائط يسمونه البصرة عند نهر يقال له: دجلة يكون عليه جسر يكثر أهلها وتكون من أمصار المسلمين فإذا كان في آخر الزمان جاء بنوقنطوراء قوم عراض الوجوه صغار الأعين حتى ينزلوا على شط النهر فيتفرق أهلها ثلاث فرق فرقة يأخذون أذناب البقر والبرية وهلكوا وفرقة يأخذون لأنفسهم وكفروا وفرقة يجعلون ذراريهم خلف ظهورهم ويقاتلونهم وهم الشهداء»","حسن","Sahih al-Jami al-Saghir 8170","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8171","ينشونشو يقرءون القرآن لا يجأوز تراقيهم كلما خرج قرن قطع كلما خرج قرن قطع حتى يخرج في أعراضهم الدجال","حسن","Sahih al-Jami al-Saghir 8171","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8172","«ينضح بول الغلام ويغسل بول الجارية»","حسن","Sahih al-Jami al-Saghir 8172","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8173","«*» - [يهرم ابن آدم ويبقى معه اثنتان: الحرص والأمل]","صحيح","Sahih al-Jami al-Saghir 8173","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8174","«يهرم ابن آدم ويشب فيه اثنتان: الحرص على المال والحرص على العمر»","صحيح","Sahih al-Jami al-Saghir 8174","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8175","«يهلك الناس هذا الحي من قريش قالوا: فما تأمرنا؟ قال: لو أن الناس اعتزلوهم»","صحيح","Sahih al-Jami al-Saghir 8175","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8176","«يهل أهل المدينة من ذي الحليفة ويهل أهل الشام من الجحفة ويهل أهل نجد من قرن ويهل أهل اليمن من يلملم»","صحيح","Sahih al-Jami al-Saghir 8176","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8177","«يود أهل العافية يوم القيامة حين يعطى أهل البلاء الثواب لوأن جلودهم كانت قرضت في الدنيا بالمقاريض»","حسن","Sahih al-Jami al-Saghir 8177","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8178","«يوشك أحدكم أن يصلي الفجر أربعا»","صحيح","Sahih al-Jami al-Saghir 8178","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8179","يوشك الفرات أن يحسر عن جبل من ذهب، فإذا سمع به الناس ساروا إليه فيقول من عنده: والله لئن تركنا الناس يأخذون منه ليذهبن به كله فيقتتلون عليه حتى يقتل من كل مائة تسعة وتسعون","صحيح","Sahih al-Jami al-Saghir 8179","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8180","«يوشك الفرات أن يحسر عن كنز من ذهب فمن حضره فلا يأخذ منه شيئا»","صحيح","Sahih al-Jami al-Saghir 8180","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8181","«يوشك المسلمون أن يحاصروا إلى المدينة حتى يكون أبعد مسالحهم سلاح»","صحيح","Sahih al-Jami al-Saghir 8181","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8182","«يوشك الناس يتساءلون حتى يقول قائلهم: هذا الله خلق الخلق فمن خلق الله؟ فإذا قالوا ذلك فقولوا: {اللَّهُ أَحَدٌ. اللَّهُ الصَّمَدُ. لَمْ يَلِدْ وَلَمْ يُولَدْ. وَلَمْ يَكُنْ لَهُ كُفُواً أَحَدٌ} ثم ليتفل عن يساره ثلاثا وليستعذ من الشيطان»","حسن","Sahih al-Jami al-Saghir 8182","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8183","«يوشك أن تداعى عليكم الأمم من كل أفق كما تداعى الأكلة إلى قصعتها قيل: يا رسول الله! فمن قلة يومئذ؟ قال: لا ولكنكم غثاء كغثاء السيل يجعل الوهن في قلوبكم وينزع الرعب من قلوب عدوكم لحبكم الدنيا وكراهيتكم الموت»","صحيح","Sahih al-Jami al-Saghir 8183","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8184","«يوشك إن طالت بك مدة أن ترى قوما في أيديهم مثل أذناب البقر يغدون في غضب الله ويروحون في سخط الله»","صحيح","Sahih al-Jami al-Saghir 8184","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8185","يوشك أن يأتي زمان يغربل فيه الناس غربلة، وتبقى حثالة من الناس قد مرجت عهودهم وأماناتهم واختلفوا فكانوا هكذا - وشبك بين أصابعه - قالوا: كيف بنا يا رسول الله؟ قال: تأخذون ما تعرفون وتدعون ما تنكرون وتقبلون على أمر خاصتكم وتذرون أمر عامتكم","صحيح","Sahih al-Jami al-Saghir 8185","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8186","«يوشك أن يقعد الرجل متكئا على أريكته يحدث بحديث من حديثي فيقول: بيننا وبينكم كتاب الله فما وجدنا فيه من حلال استحللناه وما وجدنا فيه من حرام حرمناه ألا وإن ما حرم رسول الله مثل ما حرم الله»","صحيح","Sahih al-Jami al-Saghir 8186","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8187","«يوشك أن يكون خير مال المسلم غنما يتبع بها شعف الجبال ومواقع القطر يفر بدينه من الفتن»","صحيح","Sahih al-Jami al-Saghir 8187","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8188","«يوشك يا معاذ إن طالت بك حياة أن ترى ما هاهنا قد ملئ جنانا»","صحيح","Sahih al-Jami al-Saghir 8188","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8189","«يوضع الصراط بين ظهراني جهنم عليه حسك كحسك السعدان ثم يستجيز الناس فناج مسلم ومخدوش به ثم ناج ومحتبس به ومنكوس فيها»","صحيح","Sahih al-Jami al-Saghir 8189","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8190","«يوم الجمعة ثنتا عشرة ساعة منها ساعة لا يوجد عبد مسلم يسأل الله فيها شيئا إلا آتاه الله إياه فالتمسوها آخر ساعة بعد العصر»","صحيح","Sahih al-Jami al-Saghir 8190","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8191","«يوم الحج الأكبر يوم النحر»","صحيح","Sahih al-Jami al-Saghir 8191","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8192","«يوم الفطر ويوم النحر وأيام التشريق عيدنا أهل الإسلام وهي أيام أكل وشرب»","صحيح","Sahih al-Jami al-Saghir 8192","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8193","«يوم القيامة على المؤمنين كقدر ما بين الظهر والعصر»","صحيح","Sahih al-Jami al-Saghir 8193","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8194","«اليتيمة تستأمر في نفسها فإن صمتت فهو إذنها وإن أبت فلا جواز عليها»","حسن","Sahih al-Jami al-Saghir 8194","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8195","«اليد العليا خير من اليد السفلى وابدأ بمن تعول»","صحيح","Sahih al-Jami al-Saghir 8195","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8196","«اليد العليا خير من اليد السفلى وابدأ بمن تعول وخير الصدقة ما كان عن ظهر غنى ومن يستغن يغنه الله ومن يستعفف يعفه الله»","صحيح","Sahih al-Jami al-Saghir 8196","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8197","«اليد العليا خير من اليد السفلى واليد العليا هي: المنفقة واليد السفلى هي: السائلة»","صحيح","Sahih al-Jami al-Saghir 8197","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8198","«اليمين على ما يصدقك به صاحبك»","صحيح","Sahih al-Jami al-Saghir 8198","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8199","«اليمين على نية المستحلف»","صحيح","Sahih al-Jami al-Saghir 8199","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8200","اليوم الموعود يوم القيامة والشاهد يوم الجمعة والمشهود يوم عرفة ويوم الجمعة ذخره الله لنا وصلاة الوسطى صلاة العصر","حسن","Sahih al-Jami al-Saghir 8200","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8201","«اليوم الموعود يوم القيامة واليوم المشهود يوم عرفة والشاهد يوم الجمعة وما طلعت الشمس ولا غربت على يوم أفضل منه فيه ساعة لا يوافقها عبد مسلم يدعو الله بخير إلا استجاب الله له ولا يستعيذ من شر إلا أعاذه الله منه»","حسن","Sahih al-Jami al-Saghir 8201","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
"8202","«اليهود مغضوب عليهم والنصارى ضلال»","صحيح","Sahih al-Jami al-Saghir 8202","","","الأحاديث المبدوءة بحرف الياء Hadith Beginning with the Letter Ya (ي)"
