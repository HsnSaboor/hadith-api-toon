hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"11023","(۱۱۰۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شَقِیقٍ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إبْرَاہِیمَ ، قَالَ یُبْدَأُ بَعْدَ الْوُضُوئِ بِغَسْلِ الرَّأْسِ۔","","Musannaf Ibn Abi Shaybah 11023","","","كتاب الجنائز"
"11024","(۱۱۰۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إبْرَاہِیمَ ، قَالَ یُوَضَّأ الْمَیِّتَ وُضُوئَہُ لِلصَّلاَۃِ ثُمَّ یُغْسَلُ بِمَائٍ ، ثُمَّ یُغْسَلُ بِسِدْرٍ وَمَائٍ ، ثُمَّ یُغْسَلُ بِمَائٍ۔","","Musannaf Ibn Abi Shaybah 11024","","","كتاب الجنائز"
"11025","(۱۱۰۲۵) حَدَّثَنَا عَبْدُ الصَّمَدِ ، عَنْ ہَمَّامٍ ، عَنْ شَیْخٍ مِنْ أَہْلِ الْکُوفَۃِ یُقَالُ لَہُ زِیَادٌ ، عَنْ إبْرَاہِیمَ ، عَنِ ابْنِ مَسْعُودٍ، قَالَ : یُوضَعُ الْکَافُورُ عَلَی مَوَاضِعِ سُجُودِ الْمَیِّتِ۔","","Musannaf Ibn Abi Shaybah 11025","","","كتاب الجنائز"
"11026","(۱۱۰۲۶) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَد ، قَالَ : قُلْتُ لِعَائِشَۃَ یُغْسَلُ رَأْسُ الْمَیِّتِ بِخَطْمِیٍّ ؟ فَقَالَتْ لاَ تُعَنُّوا مَیِّتَکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 11026","","","كتاب الجنائز"
"11027","(۱۱۰۲۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إِنْ لَمْ یَکُنْ سِدْرٌ فَلاَ یَضُرُّک۔","No Data Available","Musannaf Ibn Abi Shaybah 11027","","","كتاب الجنائز"
"11028","(۱۱۰۲۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنْ ہِشَامٍ، عَنْ مُحَمَّدٍ، قَالَ: لاَ یُغَسِّلُونَہُ بِخَطْمِیٍّ وَہُمْ یَقْدِرُونَ عَلَی السِّدْرِ۔","","Musannaf Ibn Abi Shaybah 11028","","","كتاب الجنائز"
"11029","(۱۱۰۲۹) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ قَالَ فِی الْمَیِّتِ أُغَسِّلُہُ بِسِدْرٍ ، فَإِنْ لَمْ یُوجَدْ سِدْرٌ فَخَطْمِیٌّ ، فَإِنْ لَمْ یَکُنْ خِطْمِیٌّ فَبِأُشْنَانٍ۔","","Musannaf Ibn Abi Shaybah 11029","","","كتاب الجنائز"
"11030","(۱۱۰۳۰) حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، عَنْ مَعْمَرٍ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : إذَا طَالَ ضَنَی الْمَیِّتِ غُسِّلَ بِأُشْنَانٍ۔","","Musannaf Ibn Abi Shaybah 11030","","","كتاب الجنائز"
"11031","(۱۱۰۳۱) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ، عَنْ زُہَیْرٍ، عَنْ أَبِی إِسْحَاقَ، عَنِ الضَّحَّاکِ، قَالَ: لاَ تُغَسِّلُونِی بِالسِّدْرِ۔","","Musannaf Ibn Abi Shaybah 11031","","","كتاب الجنائز"
"11032","(۱۱۰۳۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ شَرِیکٍ، عَنْ سَالِمٍ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ، قَالَ: إذَا لَمْ یَکُنْ سِدْرٌ فَخَطْمِیٌّ۔","No Data Available","Musannaf Ibn Abi Shaybah 11032","","","كتاب الجنائز"
"11033","(۱۱۰۳۳) حَدَّثَنَا عِیسَی بْنُ یُونُسَ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ، قَالَ: ذَکَرُوا عِنْدَہُ غُسْلَ الْمَیِّتِ فَقَالُوا: کَاغْتِسَالِ الرَّجُلِ مِنَ الْجَنَابَۃِ۔","","Musannaf Ibn Abi Shaybah 11033","","","كتاب الجنائز"
"11034","(۱۱۰۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْمُعْتَمِرِ ، عَنْ قَتَادَۃَ ، قَالَ یُجْزِئُ الْمَیِّتَ فِی الْغُسْلِ مَا یُجْزِئُ الْجُنُبَ۔","","Musannaf Ibn Abi Shaybah 11034","","","كتاب الجنائز"
"11035","(۱۱۰۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ، قَالَ قَدِمْت الْمَدِینَۃَ فَسَأَلْت عَنْ غُسْلِ الْمَیِّتِ ، فَقَالَ : بَعْضُہُمَ اصْنَعْ بِمَیِّتِکَ کَمَا تَصْنَعُ بِعَرُوسِکَ غَیْرَ أَنْ لاَ تَخْلُقَہُ۔","","Musannaf Ibn Abi Shaybah 11035","","","كتاب الجنائز"
"11036","(۱۱۰۳۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَقُولُ فِی الْمَیِّتِ إذَا خَرَجَ مِنْہُ الشَّیئُ بَعْدَ غُسْلِہِ، قَالَ یُغْسَلُ مَا خَرَجَ مِنْہُ ، قَالَ وَکَانَ ابْنُ سِیرِینَ یَقُولُ یُعَادُ عَلَیْہِ الْغُسْلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 11036","","","كتاب الجنائز"
"11037","(۱۱۰۳۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنِ ابْنِ سِیرِینَ ، قَالَ یُغَسَّلُ مَرَّتَیْنِ۔","","Musannaf Ibn Abi Shaybah 11037","","","كتاب الجنائز"
"11038","(۱۱۰۳۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ بَعْضِ الْکُوَفِیینَ ، عَنِ الشَّعْبِیِّ مِثْلَ قَوْلِ الْحَسَنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11038","","","كتاب الجنائز"
"11039","(۱۱۰۳۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : قُلْتُ لِحَمَّادٍ الْمَیِّتُ إذَا خَرَجَ مِنْہُ الشَّیئُ بَعْدَ مَا یُفْرَغُ مِنْہُ ، قَالَ یُغْسَلُ ذَلِکَ الْمَکَانُ۔","","Musannaf Ibn Abi Shaybah 11039","","","كتاب الجنائز"
"11040","(۱۱۰۴۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إن خَرَجَ مِنْہُ شَیْئٌ أُجْرِیَ عَلَیْہِ الْمَائُ ، وَلَمْ یُعَدْ وُضُوؤُہُ۔","","Musannaf Ibn Abi Shaybah 11040","","","كتاب الجنائز"
"11041","(۱۱۰۴۱) حَدَّثَنَا یَزِیدُ ، عَنِ التَّیْمِیِّ ، عَنْ یُونُسَ فِی الْمَیِّتِ یَخْرُجُ مِنْہُ الشَّیئُ بَعْدَ الْغُسْلِ ، قَالَ : یُعَادُ عَلَیْہِ الْغُسْلُ مَرَّتَیْنِ، فَإِنْ خَرَجَ مِنْہُ شَیْئٌ أُعِیدَ عَلَیْہِ الْغُسْلُ مَرَّتَیْنِ إلَی سَبْعِ مَرَّاتٍ إِلاَّ أَنْ یَخَافُوا أَنْ یَسْتَرْخِیَ فَیَفْسُدَ عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 11041","","","كتاب الجنائز"
"11042","(۱۱۰۴۲) حَدَّثَنَا عَبْدُالسَّلاَمِ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ ، قَالَ: یُعْصَرُ بَطْنُ الْمَیِّتِ عَصْرًا رَفِیقًا فِی الأُولَی وَالثَّانِیَۃِ۔","","Musannaf Ibn Abi Shaybah 11042","","","كتاب الجنائز"
"11043","(۱۱۰۴۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ ہِشَامٍ، عَنِ ابْنِ سِیرِینَ، قَالَ یُعْصَرُ بَطْنُ الْمَیِّتِ فِی أَوَّلِ غَسْلَۃٍ عَصْرَۃً خَفِیفَۃً۔","","Musannaf Ibn Abi Shaybah 11043","","","كتاب الجنائز"
"11044","(۱۱۰۴۴) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ یُعْصَرُ بَطْنُہُ عَصْرًا رَفِیقًا۔","","Musannaf Ibn Abi Shaybah 11044","","","كتاب الجنائز"
"11045","(۱۱۰۴۵) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَد ، عَنْ مُجَاہِدٍ ، قَالَ : حَضَرَنَا وَنَحْنُ نُغَسِّلُ مَیِّتًا ، فَقَال: انْفُضُوہُ نَفْضًا ، وَلاَ تَعْصِرُوہُ فَإِنَّکُمْ لاَ تَدْرُونَ مَا یَخْرُجُ فِی الْعَصْرِ۔","","Musannaf Ibn Abi Shaybah 11045","","","كتاب الجنائز"
"11046","(۱۱۰۴۶) حَدَّثَنَا ابْنُ مُبَارَکٍ وَعَبْدُ الأَعْلَی، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، قَالَ: الْتَمَسَ عَلِیٌّ مِنَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَا یُلْتَمَسُ مِنَ الْمَیِّتِ فَلَمْ یَجِدْہُ، فَقَالَ: بِأَبِی طِبْت حَیًّا وَطِبْت مَیِّتًا۔(ابوداؤد ۴۱۵)","","Musannaf Ibn Abi Shaybah 11046","","","كتاب الجنائز"
"11047","(۱۱۰۴۷) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الضَّحَّاکِ ، قَالَ : لاَ تَعْصِرُوا بَطْنِی۔","No Data Available","Musannaf Ibn Abi Shaybah 11047","","","كتاب الجنائز"
"11048","(۱۱۰۴۸) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ انْفُضِ الْمَیِّتَ ، وَلاَ تَکُبَّہُ۔","","Musannaf Ibn Abi Shaybah 11048","","","كتاب الجنائز"
"11049","(۱۱۰۴۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : أَوْصَی عَبْدُ الرَّحْمَنِ بْنُ أَبِی بَکْرٍ إذَا أَنَا مِتُّ فَانْفُضْنِی نَفْضَۃً ، أَوْ نَفْضَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 11049","","","كتاب الجنائز"
"11050","(۱۱۰۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ خَالِدٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : لاَ تُحَرِّکْ رَأْسَ الْمَیِّتِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11050","","","كتاب الجنائز"
"11051","(۱۱۰۵۱) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الضَّحَّاکِ ، قَالَ : لاَ تُقْعِدُونِی۔","","Musannaf Ibn Abi Shaybah 11051","","","كتاب الجنائز"
"11052","(۱۱۰۵۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنْ شَقِیقٍ، عَنْ یَزِیدَ، عَنْ عَبْدِاللہِ بْنِ الْحَارِثِ، أَنَّہُ کَانَ یُغَسِّلُ الْمَوْتَی بِالْحَمِیمِ۔","Da'if","Musannaf Ibn Abi Shaybah 11052","","","كتاب الجنائز"
"11053","(۱۱۰۵۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ یُغْلَی لِلْمَیِّتِ الْمَائُ۔","No Data Available","Musannaf Ibn Abi Shaybah 11053","","","كتاب الجنائز"
"11054","(۱۱۰۵۴) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یُؤْخَذَ مِنْ عَانَۃٍ ، أَوْ ظُفْرٍ بَعْدَ الْمَوْتِ وَکَانَ یَقُولُ یَنْبَغِی لأَہْلِ الْمَرِیضِ أَنْ یَفْعَلُوا ذَلِکَ فِی ثِقَلِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11054","","","كتاب الجنائز"
"11055","(۱۱۰۵۵) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنِ الْحَسَنِ ، قَالَ تُقَلَّمُ أَظْفَارُ الْمَیِّتِ ، قَالَ شُعْبَۃُ: فَذَکَرْت ذَلِکَ لِحَمَّادٍ فَأَنْکَرَہُ ، وَقَالَ : أَرَأَیْت إِنْ کَانَ أَقْلَفَ أَیُخْتَنُ ؟۔","No Data Available","Musannaf Ibn Abi Shaybah 11055","","","كتاب الجنائز"
"11056","(۱۱۰۵۶) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ، عَنْ خَالِدٍ الْحَذَّائِ، عَنْ أَبِی قِلاَبَۃَ، أَنَّ سَعْدًا غَسَّلَ مَیِّتًا فَدَعَا بِمُوسَی فَحَلَقَہُ۔","","Musannaf Ibn Abi Shaybah 11056","","","كتاب الجنائز"
"11057","(۱۱۰۵۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، أَنَّہُ کَانَ یُعْجِبُہُ إذَا ثَقُلَ الْمَرِیضُ أَنْ یُؤْخَذَ مِنْ شَارِبِہِ وَأَظْفَارِہِ وَعَانَتِہِ ، فَإِنْ ہَلَکَ لَمْ یُؤْخَذْ مِنْہُ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 11057","","","كتاب الجنائز"
"11058","(۱۱۰۵۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ، أَنَّہُ کَانَ إذَا رَأَی مِنَ الْمَیِّتِ شَیْئًا فَاحِشًا مِنْ شَعْرٍ وَظُفْرٍ أَخَذَہُ وَقَلَّمَہُ۔","","Musannaf Ibn Abi Shaybah 11058","","","كتاب الجنائز"
"11059","(۱۱۰۵۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عُقْبَۃَ بْنِ أَبِی الصَّہْبَائِ ، قَالَ : حدَّثَنَا أَبُو الْعَالِیَۃِ الْقَیْسِیُّ ، أَنَّ أَبَا الْمَلِیحِ الْہُذَلِیَّ أَوْصَاہُمْ ، فَقَالَ : إذَا مَاتَ أَنْ یَأْخُذُوا مِنْ شَعْرِہِ وَأَظْفَارِہِ۔","","Musannaf Ibn Abi Shaybah 11059","","","كتاب الجنائز"
"11060","(۱۱۰۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، أَنَّ سَعْدًا غَسَّلَ مَیِّتًا فَدَعَا بِالْمُوسَی فَحَلَقَہُ۔","","Musannaf Ibn Abi Shaybah 11060","","","كتاب الجنائز"
"11061","(۱۱۰۶۱) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ وَوَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یَزِیدَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی فِی الْمَیِّتِ یَسْقُطُ مِنْ شَعْرِہِ وَمن أَظْفَارِہِ ، قَالَ یُجْعَلُ مَعَہُ۔","","Musannaf Ibn Abi Shaybah 11061","","","كتاب الجنائز"
"11062","(۱۱۰۶۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ وَبَنَاتِ سِیرِینَ ، قَالوا یُدْفَنُ مَعَ الْمَیِّتِ مَا یَسْقُطُ مِنْ شَعْرٍ ، أَوْ غَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 11062","","","كتاب الجنائز"
"11063","(۱۱۰۶۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ عُثْمَانَ بْنِ غِیَاثٍ ، قَالَ : سَمِعْتُ الْحَسَنَ یَقُولُ یُقَلَّمُ أَظْفَارُ الْمَیِّتِ وَشَارِبُہُ إذَا طَالَ ، قَالَ : قُلْتُ لِلْحَسَنِ یُوضَعُ مَعَہُ ، قَالَ نَعَمْ۔","","Musannaf Ibn Abi Shaybah 11063","","","كتاب الجنائز"
"11064","(۱۱۰۶۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ کَانَ یُحِبُّ أَنْ یُجْعَلَ مَعَہُ۔","","Musannaf Ibn Abi Shaybah 11064","","","كتاب الجنائز"
"11065","(۱۱۰۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، أَنَّ قَیْسَ بْنَ سَعْدٍ مَرَّ عَلَی رَجُلٍ قَدْ بَانَتْ إصْبَعُہُ مِنْہُ فَقُبِرَتْ مَعَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 11065","","","كتاب الجنائز"
"11066","(۱۱۰۶۶) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ الْحَذَّائِ ، عَنْ حَفْصَۃَ ، أَنَّہَا قَالَتْ سَرِّحْ شَعْرَ الْمَیِّتِ ، فَإِنَّہُ یُجْعَلُ مَعَہُ۔","","Musannaf Ibn Abi Shaybah 11066","","","كتاب الجنائز"
"11067","(۱۱۰۶۷) حَدَّثَنَا عَبْدُالسَّلاَمِ بْنُ حَرْبٍ، عَنْ حَجَّاجٍ، عَنْ عَطَائٍ، قَالَ: لاَ بَأْسَ أَنْ یُغَسِّلَ الْمَیِّتَ الْحَائِضُ وَالْجُنُبُ۔","","Musannaf Ibn Abi Shaybah 11067","","","كتاب الجنائز"
"11068","(۱۱۰۶۸) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ أَنَّہُمَا کَانَا یَکْرَہَانِ أَنْ یُغَسِّلَ الْجُنُبُ والْحَائِضُ الْمَیِّتَ۔","","Musannaf Ibn Abi Shaybah 11068","","","كتاب الجنائز"
"11069","(۱۱۰۶۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ أَرْسَلَتْ أُمِّی إلَی عَلْقَمَۃَ تَسْأَلُہُ ، عَنِ الْحَائِضِ تُغَسِّلُ الْمَیِّتَ فَلَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 11069","","","كتاب الجنائز"
"11070","(۱۱۰۷۰) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا مَاتَتِ الْمَرْأَۃُ فِی الرِّجَالِ لَیْسَ مَعَہُمُ امْرَأَۃٌ صُبَّ عَلَیْہَا الْمَائُ من فَوْقِ الثِّیَابِ صَبًّا۔","","Musannaf Ibn Abi Shaybah 11070","","","كتاب الجنائز"
"11071","(۱۱۰۷۱) حَدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ نَافِعٍ ، قَالَ : قُلْتُ لِصَفِیَّۃَ بِنْتِ أَبِی عُبَیْدٍ الْمَرْأَۃُ تَمُوتُ مَعَ الرِّجَالِ وَلَیْسَ مَعَہُمُ امْرَأَۃٌ قَالَتْ : یَدْفِنُونَہَا فِی ثِیَابِہَا۔","","Musannaf Ibn Abi Shaybah 11071","","","كتاب الجنائز"
"11072","(۱۱۰۷۲) أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ؛ فِی الْمَرْأَۃِ تَمُوتُ مَعَ الرِّجَالِ ، قَالَ : تُیَمَّمُ ، ثُمَّ تُدْفَنُ فِی ثِیَابِہَا ، وَالرَّجُلُ مِثْلُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 11072","","","كتاب الجنائز"
"11073","(۱۱۰۷۳) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَحْوَصِ ، عَنْ رَاشِدِ بْنِ سَعْدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، أَنَّہُ قَالَ : إذَا مَاتَتِ الْمَرْأَۃُ مَعَ الرِّجَالِ لَیْسَ مَعَہُمُ امْرَأَۃٌ ، قَالَ : یُیَمِّمُونَہَا بِالصَّعِیدِ ، وَلاَ یُغَسِّلُونَہَا ، وَإِذَا مَاتَ الرَّجُلُ مَعَ النِّسَائِ فَکَذَلِکَ۔","","Musannaf Ibn Abi Shaybah 11073","","","كتاب الجنائز"
"11074","(۱۱۰۷۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، قَالَ تُیَمَّمُ بِالصَّعِیدِ وَالرَّجُلُ کَذَلِکَ۔","","Musannaf Ibn Abi Shaybah 11074","","","كتاب الجنائز"
"11075","(۱۱۰۷۵) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُبَیْدِ اللہِ ، عَنْ مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَائٍ ، عَنْ أَبِی سَلَمَۃَ ؛ فِی الرَّجُلِ یَمُوتُ مَعَ النِّسَائِ ، قَالَ : تُغَسِّلُہُ امْرَأَتُہُ ، فَإِنْ لَمْ تَکُنَ امْرَأَتُہُ فَلْیُیَمِّمْ بِالصَّعِیدِ ، وَالْمَرْأَۃُ تَمُوتُ مَعَ الرِّجَالِ لَیْسَتْ مَعَہُمُ امْرَأَۃٌ ، قَالَ : یُغَسِّلُہَا زَوْجُہَا ، فَإِنْ لَمْ یَکُنْ فَنِسَائٌ مِنْ نِسَائِ أَہْلِ الْکِتَابِ یَصُبُّونَ لَہُنَّ فَیُغَسِّلْنَہَا۔","","Musannaf Ibn Abi Shaybah 11075","","","كتاب الجنائز"
"11076","(۱۱۰۷۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ؛ فِی الْمَرْأَۃِ تَمُوتُ مَعَ الرِّجَالِ ، قَالَ یَصُبُّونَ عَلَیْہَا الْمَائَ صَبًّا ، ثُمَّ یَدْفِنُونَہَا ، وَفِی الرَّجُلِ یَمُوتُ مَعَ النِّسَائِ یَصْبُبْنَ عَلَیْہِ الْمَائَ ، ثُمَّ یَدْفِنَّہُ۔","","Musannaf Ibn Abi Shaybah 11076","","","كتاب الجنائز"
"11077","(۱۱۰۷۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سَعِیدٍ ، عَنْ مَطَرٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ فِی الْمَرْأَۃِ تَمُوتُ مَعَ الرِّجَالِ ، قَالَ تُرْمَسُ فِی الْمَائِ۔","Hasan","Musannaf Ibn Abi Shaybah 11077","","","كتاب الجنائز"
"11078","(۱۱۰۷۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، أَنَّ أَبَا بَکْرٍ أَوْصَی أَسْمَائَ ابنۃ عُمَیْسٍ أَنْ تُغَسِّلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 11078","","","كتاب الجنائز"
"11079","(۱۱۰۷۹) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، أَنَّ أَبَا بَکْرٍ الصِّدِّیقَ حِینَ حَضَرَتْہُ الْوَفَاۃُ أَوْصَی أَسْمَائَ بِنْتَ عُمَیْسٍ أَنْ تُغَسِّلَہُ وَکَانَتْ صَائِمَۃً فَعَزَمَ عَلَیْہَا لَتُفْطِرَنَّ۔","","Musannaf Ibn Abi Shaybah 11079","","","كتاب الجنائز"
"11080","(۱۱۰۸۰) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ صَالِحٍ الدَّہَّانِ ، أَوْ حَیَّانَ الأَعْرَجِ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، أَنَّہُ أَوْصَی أَنْ تُغَسِّلَہُ امْرَأَتُہُ۔","","Musannaf Ibn Abi Shaybah 11080","","","كتاب الجنائز"
"11081","(۱۱۰۸۱) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ بِشْرِ بْنِ عَبْدِ اللہِ بْنِ یَسَارٍ ، قَالَ : سَمِعْتُ سُلَیْمَانَ بْنَ مُوسَی یَقُولُ تُغَسِّلُہُ۔","","Musannaf Ibn Abi Shaybah 11081","","","كتاب الجنائز"
"11082","(۱۱۰۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، وَعَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، قَالاَ : یُغَسِّلُ کُلُّ وَاحِدٍ مِنْہُمَا صَاحِبَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 11082","","","كتاب الجنائز"
"11083","(۱۱۰۸۳) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُبَیْدِ اللہِ ، عَنْ مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَائٍ ، عَنْ أَبِی سَلَمَۃَ ؛ فِی الرَّجُلِ یَمُوتُ مَعَ النِّسَائِ ، قَالَ : تُغَسِّلُہُ امْرَأَتُہُ۔","","Musannaf Ibn Abi Shaybah 11083","","","كتاب الجنائز"
"11084","(۱۱۰۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَطَائٍ ، قَالَ : تُغَسِّلُ الْمَرْأَۃُ زَوْجَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 11084","","","كتاب الجنائز"
"11085","(۱۱۰۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إبْرَاہِیمَ ، أَنَّ أَبَا مُوسَی غَسَّلَتْہُ امْرَأَتُہُ۔","","Musannaf Ibn Abi Shaybah 11085","","","كتاب الجنائز"
"11086","(۱۱۰۸۶) حَدَّثَنَا مُعَمَّرُ بْنُ سُلَیْمَانَ الرَّقِّیُّ ، عَنْ حَجَّاجٍ ، عَنْ دَاوُدَ بْنِ حُصَیْنٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: الرَّجُلُ أَحَقُّ بِغُسْلِ امْرَأَتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 11086","","","كتاب الجنائز"
"11087","(۱۱۰۸۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، أَنَّہُ کَانَ لاَ یَرَی بِذَلِکَ بَأْسًا أَنْ یُغَسِّلَ الرَّجُلُ امْرَأَتَہُ۔","","Musannaf Ibn Abi Shaybah 11087","","","كتاب الجنائز"
"11088","(۱۱۰۸۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، قَالَ : قَالَ عَبْدُ الرَّحْمَنِ بْنُ الأَسْوَد أَبَتْ أُمُّ امْرَأَتِی أو أُخْتُہَا أَنْ تُغَسِّلہَا فَوَلِیت غَسْلَہَا بِنَفْسِی۔","","Musannaf Ibn Abi Shaybah 11088","","","كتاب الجنائز"
"11089","(۱۱۰۸۹) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، وَعَنْ سُفْیَانَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ قَالاَ : یُغَسِّلُ کُلُّ وَاحِدٍ مِنْہُمَا صَاحِبَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 11089","","","كتاب الجنائز"
"11090","(۱۱۰۹۰) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُبَیْدِ اللہِ ، عَنْ مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَائٍ ، عَنْ أَبِی سَلَمَۃَ فِی الْمَرْأَۃِ تَمُوتُ مَعَ الرِّجَالِ لَیْسَتْ مَعَہُمُ امْرَأَۃٌ ، قَالَ یُغَسِّلُہَا زَوْجُہَا۔","","Musannaf Ibn Abi Shaybah 11090","","","كتاب الجنائز"
"11091","(۱۱۰۹۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا مَاتَت المَرأۃ انْقَطَعَ عِصْمَۃ مَا بَینہَا وَبَین زَوجہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 11091","","","كتاب الجنائز"
"11092","(۱۱۰۹۲) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ، عَنْ سُفْیَانَ، عَنْ أَشْعَثَ، عَنِ الشَّعْبِیِّ، قَالَ: لاَ یُغَسِّلُ الرَّجُلُ امْرَأَتَہُ وَہُوَ رَأْیُ سُفْیَانَ۔","","Musannaf Ibn Abi Shaybah 11092","","","كتاب الجنائز"
"11093","(۱۱۰۹۳) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ بِشْرِ بْنِ عَبْدِ اللہِ بْنِ یَسَارٍ ، قَالَ : ، قَالَ : سَمِعْتُ سُلَیْمَانَ بْنَ مُوسَی یَقُولُ یُغَسِّلُ الرَّجُلُ امْرَأَتَہُ۔","","Musannaf Ibn Abi Shaybah 11093","","","كتاب الجنائز"
"11094","(۱۱۰۹۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ یَزِیدَ بْنِ أَبِی سُلَیْمَانَ ، عَنْ مَسْرُوقٍ ، قَالَ مَاتَتِ امْرَأَۃٌ لِعُمَرَ ، فَقَالَ : أَنَا کُنْت أَوْلَی بِہَا إذَا کَانَتْ حَیَّۃً فَأَمَّا الآنَ فَأَنْتُمْ أَوْلَی بِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 11094","","","كتاب الجنائز"
"11095","(۱۱۰۹۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عنْ عَوْفٍ ، قَالَ : کُنْتُ فِی مَجْلِسٍ فِیہِ قَسَامَۃُ بْنُ زُہَیْرٍ وَأَشْیَاخٌ قَدْ أَدْرَکُوا عُمَرَ بْنَ الْخَطَّابَِ ، فَقَالَ رَجُلٌ کَانَتْ تَحْتِی امْرَأَۃٌ مِنْ بَنِی عَامِرِ بْنِ صَعْصَعَۃَ وَکَانَ یُثْنِی عَلَیْہَا خَیْرًا ، فَلَمَّا کَانَ زَمَنُ طَاعُونِ الْجَارِفِ طُعِنَتْ ، فَلَمَّا ثَقُلَتْ قَالَتْ إنِّی امْرَأَۃٌ غَرِیبَۃٌ فَلاَ یَلِینِی غَیْرُک فَمَاتَتْ فَغَسَّلْتہَا ، وَوَلِیتہَا ، قَالَ عَوْفٌ فَمَا رَأَیْت أَحَدًا مِنْ أُولَئِکَ الأَشْیَاخِ عَتَبَ ، وَلاَ عَابَ ذَلِکَ عَلَیہ۔","","Musannaf Ibn Abi Shaybah 11095","","","كتاب الجنائز"
"11096","(۱۱۰۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی ہَاشِمٍ ، أَنَّ أَبَا قِلاَبَۃَ غَسَّلَ ابْنَتَہُ۔","","Musannaf Ibn Abi Shaybah 11096","","","كتاب الجنائز"
"11097","(۱۱۰۹۷) حَدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی الْحَسَنِ الْوَاسِطِیِّ ، قَالَ غَسَّلَ أَبُو قِلاَبَۃَ ابْنَتَہُ فَقُلْت لَہُ مَا یُدْرِیک ، فَقَالَ : کُنَّا فِی دَارِہِ فَخَرَجَ عَلَیْنَا فَأَخْبَرَنَا أَنَّہُ فَعَلَ ذَلِکَ ، قَالَ وَکَانَتْ جَارِیَۃً شَابَّۃً۔","","Musannaf Ibn Abi Shaybah 11097","","","كتاب الجنائز"
"11098","(۱۱۰۹۸) حَدَّثَنَا ہُشَیم ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ تُغَسِّلَ الْمَرْأَۃُ الْغُلاَمَ إذَا کَانَ فَطِیمًا وَفَوْقَہُ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 11098","","","كتاب الجنائز"
"11099","(۱۱۰۹۹) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ سُئِلَ مُحَمَّدٌ ، عَنِ الْمَرْأَۃِ تُغَسِّلُ الصَّبِیَّ ، فقَالَ : لاَ أَعْلَمُ بِہِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 11099","","","كتاب الجنائز"
"11100","(۱۱۱۰۰) حَدَّثَنَا حَفْصٌ، عَنْ لَیْثٍ، عَنْ عَطَائٍ، قَالَ: یُکَفَّن الصَّبِیُّ الَّذِی قَدْ سَعَی أَنْ یُجْعَلَ فِی خِرْقَۃٍ تُغَسِّلُہُ النِّسَائُ۔","","Musannaf Ibn Abi Shaybah 11100","","","كتاب الجنائز"
"11101","(۱۱۱۰۱) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ أَیُّوبَ ، قَالَ حَدَّثَتْنِی حَفْصَۃُ بِنْتُ سِیرِینَ ، أَنَّ أُمَّ عَطِیَّۃَ قَالَتْ مَشَطْتُہَا ثَلاَثَۃَ قُرُونٍ تَعْنِی ابْنَۃَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 11101","","","كتاب الجنائز"
"11102","(۱۱۱۰۲) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ یَقُولُ إِذَا غُسِلَتِ الْمَرْأَۃ ذُوِّبَ شَعْرُہَا ثَلاَثَ ذَوَائِبَ ، ثُمَّ جُعِلَ خَلْفَہَا۔","","Musannaf Ibn Abi Shaybah 11102","","","كتاب الجنائز"
"11103","(۱۱۱۰۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الْمُثَنَّی بن بِلاَلٍ الْعَبْدِیِّ ، قَالَ : حدَّثَنَا أَشْیَاخُنَا الَّذِینَ کَانُوا شَہِدُوا زَیْدَ بْنَ صُوحَانَ حِینَ أُصِیبَ یَوْمَ الْجَمَلِ ، قَالَ شُدُّوا عَلَیَّ ثِیَابِی ، وَلاَ تَغْسِلُوا عَنِّی دَمًا وَلا ترابًا فَإِنِّی رَجُلٌ مُخَاصِمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 11103","","","كتاب الجنائز"
"11104","(۱۱۱۰۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ إذَا سُئِلَ عَنْ غُسْلِ الشَّہِیدِ حَدَّثَ بِحَدِیثِ حُجْرِ بْنِ عَدِیٍّ ، قَالَ : قَالَ حُجْرُ بْنُ عَدِیٍّ لِمَنْ حَضَرَہُ مِنْ أَہْلِ بَیْتِہِ لاَ تُغَسِّلُوا عَنِّی دَمًا ، وَلاَ تُطْلِقُوا عَنِّی حَدِیدًا وَادْفِنُونِی فِی ثِیَابِی فَإِنِّی أَلْتَقِی أَنَا وَمُعَاوِیَۃُ عَلَی الْجَادَّۃِ غَدًا۔","Sahih","Musannaf Ibn Abi Shaybah 11104","","","كتاب الجنائز"
"11105","(۱۱۱۰۵) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، أَنَّ رَجُلاً مِنْ أَصْحَابِ عَبْدِ اللہِ قَتَلَہُ الْعَدُوُّ فدَفَنَّاہُ فِی ثِیَابِہِ۔","","Musannaf Ibn Abi Shaybah 11105","","","كتاب الجنائز"
"11106","(۱۱۱۰۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : قَالَ سَعد بْنُ عُبَیدٍ الْقَارِی یَوْمَ الْقَادِسِیَّۃِ إنَّا لاَقُوا الْعَدُوَّ غَدًا إِنْ شَائَ اللَّہُ وَإِنَّا مُسْتَشْہَدُونَ فَلاَ تُغَسِّلُوا عَنَّا دَمًا ، وَلاَ نکفن إِلاَّ فِی ثَوْبٍ کَانَ عَلَیْنَا۔","","Musannaf Ibn Abi Shaybah 11106","","","كتاب الجنائز"
"11107","(۱۱۱۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُخَوَّلِ بْنِ رَاشِدٍ النَّہْدِیِّ ، عَنِ الْعَیْزَارِ بْنِ حُرَیْثٍ الْعَبْدِیِّ ، قَالَ : قَالَ زَیْدُ بْنُ صُوحَانَ یَوْمَ الْجَمَلِ ارْمُسُونِی فِی الأَرْضِ رَمْسًا ، وَلاَ تَغْسِلُوا عَنِّی دَمًا ، وَلاَ تَنْزِعُوا عَنِّی ثَوْبًا إِلاَّ الْخُفَّیْنِ فَإِنِّی مُحَاجٌّ أُحَاجُّ۔","Sahih","Musannaf Ibn Abi Shaybah 11107","","","كتاب الجنائز"
"11108","(۱۱۱۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ وَسُفْیَانُ ، عَنْ مُصْعَبِ بْنِ الْمُثَنَّی ، قَالَ سُفْیَانُ ، عَنْ رَجُلٍ ، عَنْ زَیْدِ بْنِ صُوحَانَ ، وَقَالَ مِسْعَرٌ ، عَنْ مُصْعَبِ بْنِ الْمُثَنَّی ، عَنْ زَیْدِ بْنِ صُوحَانَ أَنَّہُ قَالَ یَوْمَ الْجَمَلِ ادْفِنُونَا وَمَا أَصَابَ الثَّرَی مِنْ دِمَائِنَا۔","Da'if","Musannaf Ibn Abi Shaybah 11108","","","كتاب الجنائز"
"11109","(۱۱۱۰۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ أَنَّہُمَا قَالاَ : الشَّہِیدُ یُغَسَّلُ مَا مَاتَ مَیِّتٌ إِلاَّ أَجْنَبَ۔","","Musannaf Ibn Abi Shaybah 11109","","","كتاب الجنائز"
"11110","(۱۱۱۱۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، عَنْ عَامِرٍ ، أَنَّ حَنْظَلَۃَ بْنَ الرَّاہِبِ طَہَّرَتْہُ الْمَلاَئِکَۃُ۔","","Musannaf Ibn Abi Shaybah 11110","","","كتاب الجنائز"
"11111","(۱۱۱۱۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ یَحْیَی بْنِ عَابِسٍ ، عَنْ عَمَّارٍ ، قَالَ : ادْفِنُونِی فِی ثِیَابِی فَإِنِّی مُخَاصِمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 11111","","","كتاب الجنائز"
"11112","(۱۱۱۱۲) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : سَمِعْتُ یَحْیَی بْنَ عَابِسٍ یُحَدِّثُ عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ، عَنْ عَمَّارٍ مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 11112","","","كتاب الجنائز"
"11113","(۱۱۱۱۳) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا رفع الْقَتِیلُ دُفِنَ فِی ثِیَابِہِ وَإِنْ رُفِعَ وَبِہِ رَمَقٌ صُنِعَ بِہِ مَا یُصْنَعُ بِغَیْرِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11113","","","كتاب الجنائز"
"11114","(۱۱۱۱۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، عَنْ عَامِرٍ فِی رَجُلٍ قَتَلَہُ اللُّصُوصُ ، قَالَ یُدْفَنُ فِی ثِیَابِہِ ، وَلاَ یُغَسَّلُ۔","","Musannaf Ibn Abi Shaybah 11114","","","كتاب الجنائز"
"11115","(۱۱۱۱۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، حَدَّثَنَا ثَابِتُ بْنُ عُمَارَۃَ ، قَالَ : سَمِعْتُ غُنَیْمَ بْنَ قَیْسٍ یَقُولُ : یقال الشَّہِیدُ یُدْفَنُ فِی ثِیَابِہِ ، وَلاَ یُغَسَّلُ۔","","Musannaf Ibn Abi Shaybah 11115","","","كتاب الجنائز"
"11116","(۱۱۱۱۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الْقَتِیلِ إذَا کَانَ عَلَیْہِ مُہْلٌ غُسِّلَ۔","No Data Available","Musannaf Ibn Abi Shaybah 11116","","","كتاب الجنائز"
"11117","(۱۱۱۱۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا مَاتَ فِی الْمَعْرَکَۃِ دُفِنَ وَنُزِعَ مَا کَانَ عَلَیْہِ مِنْ خُفٍّ ، أَوْ نَعْلٍ ، وَإِذَا رُفِعَ وَبِہِ رَمَقٌ ، ثُمَّ مَاتَ صُنِعَ بِہِ مَا یُصْنَعُ بِالْمَیِّتِ۔","Hasan","Musannaf Ibn Abi Shaybah 11117","","","كتاب الجنائز"
"11118","(۱۱۱۱۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ بِحَمْزَۃَ حِینَ اسْتُشْہِدَ فَغُسِّلَ۔ (حاکم ۱۹۵)","Hasan","Musannaf Ibn Abi Shaybah 11118","","","كتاب الجنائز"
"11119","(۱۱۱۱۹) حَدَّثَنَا شَبَابَۃُ ، قَالَ : أَخْبَرَنَا لَیْثُ بْنُ سَعْدٍ ، عَنِ ابْنِ شِہَابٍ ، عَنْ عَبْدِ الرَّحْمَانِ بْنِ کَعْبِ بْنِ مَالِکٍ ، أَنَّ جَابِرَ بْنَ عَبْدِ اللہِ أَخْبَرَہُ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمْ یُصَلِّ عَلَی قَتْلَی أُحُدٍ ، وَلَمْ یُغَسَّلُوا۔ (بخاری ۱۳۴۳۔ ابوداؤد ۳۱۳۰)","Sahih","Musannaf Ibn Abi Shaybah 11119","","","كتاب الجنائز"
"11120","(۱۱۱۲۰) حَدَّثَنَا عَبْدُاللہِ بْنُ نُمَیْرٍ، قَالَ: حدَّثَنَا عُبَیْدُاللہِ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، قَالَ کُفِّنَ عُمَرُ وَحُنِّطَ وَغُسِّلَ۔","Sahih","Musannaf Ibn Abi Shaybah 11120","","","كتاب الجنائز"
"11121","(۱۱۱۲۱) حَدَّثَنَا شَرِیکٌ، عَنِ ابْنِ أَبِی لَیْلَی، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ بِنَحْوِہِ، إِلاَّ أَنَّہُ قَالَ: کَانَ مِنْ أَفْضَلِ الشُّہَدَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 11121","","","كتاب الجنائز"
"11122","(۱۱۱۲۲) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنِ ابْنِ أَبِی عَرُوبَۃَ، عَنْ أَبِی مَعْشَرٍ، عَنْ إبْرَاہِیمَ، قَالَ: إذَا قُتِلَ فِی الْمَعْرَکَۃِ دُفِنَ فِی ثِیَابِہِ ، وَلَمْ یُغَسَّلْ۔","No Data Available","Musannaf Ibn Abi Shaybah 11122","","","كتاب الجنائز"
"11123","(۱۱۱۲۳) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ سُفْیَانَ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ لَمَّا رَجَمَ عَلِیٌّ شُرَاحَۃَ جَائَتْ ہَمْدَانُ إلَی عَلِیٍّ فَقَالُوا : کَیْفَ یُصْنَعُ بِہَا ، فَقَالَ : اصْنَعُوا بِہَا کَمَا تَصْنَعُونَ بِنِسَائِکُمْ إذَا مُتْنَ فِی بُیُوتِہِنَّ۔","Sahih","Musannaf Ibn Abi Shaybah 11123","","","كتاب الجنائز"
"11124","(۱۱۱۲۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ لَمَّا رُجِمَ مَاعِزٌ قَالُوا : یَا رَسُولَ اللہِ مَا نصْنَعُ بِہِ ، قَالَ : اصْنَعُوا بِہِ مَا تَصْنَعُونَ بِمَوْتَاکُمْ مِنَ الْغُسْلِ وَالْکَفَنِ وَالْحَنُوطِ وَالصَّلاَۃِ عَلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 11124","","","كتاب الجنائز"
"11125","(۱۱۱۲۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنْ حَجَّاجٍ، عَنْ عَطَائٍ، قَالَ یُغَسَّلُ الْغَرِیقُ وَیُکَفَّنُ وَیُحَنَّطُ وَیُصْنَعُ بِہِ مَا یُصْنَعُ بِغَیْرِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11125","","","كتاب الجنائز"
"11126","(۱۱۱۲۶) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا مَاتَ الْجُنُبُ وَالْحَائِضُ یُصْنَعُ بِہِمَا مَا یُصْنَعُ بِغَیْرِہِمَا۔","","Musannaf Ibn Abi Shaybah 11126","","","كتاب الجنائز"
"11127","(۱۱۱۲۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا مَاتَ الْجُنُبُ ، قَالَ یُغَسَّلُ غُسْلاً لِجَنَابَتِہِ وَیُغَسَّلُ غُسْلَ الْمَیِّتِ ، وَکَذَلِکَ قَوْلُہُ فِی الْحَائِضِ إذَا طَہُرَتْ ، ثُمَّ مَاتَتْ قَبْلَ أَنْ تَغْتَسِل۔","","Musannaf Ibn Abi Shaybah 11127","","","كتاب الجنائز"
"11128","(۱۱۱۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الْحَکِیمِ بْنِ جَابِرٍ ، قَالَ لَمَّا مَاتَ ابْنُ قَیْسٍ ، قَالَ الْحَسَنُ بْنُ عَلِیٍّ إذَا غَسَّلْتُمُوہُ فَلاَ تُہَیِّجُوہُ حَتَّی تُؤْذِنُونِی فَجَائَ فَوَضَّأَہُ بِالْحَنُوطِ وُضُوء ًا۔","Sahih","Musannaf Ibn Abi Shaybah 11128","","","كتاب الجنائز"
"11129","(۱۱۱۲۹) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، قَالَ : سَمِعْتُ سَالِمًا وَعُبَیْدَ اللہِ بْنَ عَبْدِ اللہِ إذَا ذُکِرَ لَہُمَا طِیبُ الْمَیِّتِ قَالاَ : اجْعَلُوہُ بَیْنَہُ وَبَیْنَ ثِیَابِہِ۔","","Musannaf Ibn Abi Shaybah 11129","","","كتاب الجنائز"
"11130","(۱۱۱۳۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ، عَنِ الْحَسَنِ بْنِ عُبَیْدِاللہِ، عَنْ إبْرَاہِیمَ، قَالَ تُجَمَّرُ ثِیَابُہُ وَحَنُوطُہُ عَلَی مَسَاجِدِہِ۔","","Musannaf Ibn Abi Shaybah 11130","","","كتاب الجنائز"
"11131","(۱۱۱۳۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ فِی حَنُوطِ الْمَیِّتِ ، قَالَ یُبْدَأُ بِمَسَاجِدِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11131","","","كتاب الجنائز"
"11132","(۱۱۱۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ: إذَا فُرِغَ مِنْ غُسْلِہِ تُتْبَعُ مَسَاجِدُہُ بِالطِّیبِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11132","","","كتاب الجنائز"
"11133","(۱۱۱۳۳) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوُرَّاثِ ، عَنْ ہَمَّامٍ ، عَنْ شَیْخٍ مِنْ أَہْلِ الْکُوفَۃِ یُقَالُ لَہُ زِیَادٌ ، عَنْ إبْرَاہِیمَ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : یُوضَعُ الْکَافُورُ عَلَی مَوْضِعِ سُجُودِ الْمَیِّتِ۔","","Musannaf Ibn Abi Shaybah 11133","","","كتاب الجنائز"
"11134","(۱۱۱۳۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، قَالَ : کَانَ أَیُّوبُ بَعْدَ مَا یَفْرُغُ مِنْ غُسْلِ الْمَیِّتِ یُطَبِّقُ وَجْہَہُ بِقُطْنَۃٍ وَکَانَ مُحَمَّدٌ لاَ یَفْعَلُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 11134","","","كتاب الجنائز"
"11135","(۱۱۱۳۵) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَرَی أَنَّ الْمُشَاقَۃَ تُجْزِئُ إذَا لَمْ یَکُنْ قُطْنٌ لِلْمَیِّتِ۔","","Musannaf Ibn Abi Shaybah 11135","","","كتاب الجنائز"
"11136","(۱۱۱۳۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ أَحْشُو الْکُرْسُفَ ؟ قَالَ نَعَمْ قُلْتُ لأَنْ لاَ یَتَفَجَّرَ مِنْہُ شَیْئٌ ، قَالَ نَعَمْ۔","","Musannaf Ibn Abi Shaybah 11136","","","كتاب الجنائز"
"11137","(۱۱۱۳۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ یُحْشَی مِنَ الْمَیِّتِ لِمَا یَخَافُونَ أَنْ یَخْرُجَ مِنْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 11137","","","كتاب الجنائز"
"11138","(۱۱۱۳۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ ہمام ، عَنْ مَطَرٍ ، عَنِ الْحَسَنِ ، قَالَ : یُحْشَی دُبُرُہُ وَمَسَامِعُہُ وَأَنْفُہُ۔","","Musannaf Ibn Abi Shaybah 11138","","","كتاب الجنائز"
"11139","(۱۱۱۳۹) حَدَّثَنَا أَبُو دَاوُدَ ، عَنِ الرَّبِیعِ ، قَالَ : سَمِعْتُ ابْنَ سِیرِینَ یَقُولُ یُحْشَی دُبُرُ الْمَیِّتِ وَفَاہُ وَمَنْخِرَاہُ قُطْنًا ، وَقَالَ مُحَمَّدٌ مَا عَالَجْت دُبُرَہُ فَعَالِجْہُ بِیَسَارٍک۔","","Musannaf Ibn Abi Shaybah 11139","","","كتاب الجنائز"
"11140","(۱۱۱۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَّانَ بْنِ إِبْرَاہِیمَ ، عَن أُمَیَّۃَ الأَزْدِیِّ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : إذَا حُشِیَ عَلَی الْمَیِّتِ سُدَّ مُرَاقُہُ وَمَسَامِعُہُ بِالْمُشَاقِّ۔","","Musannaf Ibn Abi Shaybah 11140","","","كتاب الجنائز"
"11141","(۱۱۱۴۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، أَنَّہُ جُعِلَ فِی حَنُوطِہِ صَرَّۃٌ مِنْ مِسْکٍ ، أَوْ مِسْکٌ فِیہِ شَعْرٌ مِنْ شَعْرِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 11141","","","كتاب الجنائز"
"11142","(۱۱۱۴۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : سُئِلَ ابْنُ عُمَرَ عَنِ الْمِسْکِ یُجْعَلُ فِی الْحَنُوطِ ، قَالَ : أَوَلَیْسَ مِنْ أَطْیَبِ طِیبِکُمْ۔","","Musannaf Ibn Abi Shaybah 11142","","","كتاب الجنائز"
"11143","(۱۱۱۴۳) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، قَالَ: سُأِلَ ابْن عُمَرُ أَیَقْرَبُ الْمَیِّتَ الْمِسْکُ ، قَالَ أَوَلَیْسَ مِنْ أَطْیَبِ طِیبِکُمْ۔","","Musannaf Ibn Abi Shaybah 11143","","","كتاب الجنائز"
"11144","(۱۱۱۴۴) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنِ الْمُثَنَّی بْنِ سَعِیدٍ ، عَنْ قَتَادَۃَ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ عَنِ الْمِسْکِ فِی حَنُوطِ الْمَیِّتِ ، قَالَ : لاَ بَأْسَ بِہِ وَسُئِلَ عَنْ ذَلِکَ جَابِرُ بْنُ زَیْدٍ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 11144","","","كتاب الجنائز"
"11145","(۱۱۱۴۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، أَنَّہُ سُئِلَ أَیُطَیَّبُ الْمَیِّتُ بِالْمِسْکِ ، قَالَ نَعَمْ أَوَلَیْسَ یَجْعَلُونَ فِی الَّذِی یُجَمِّرُونَ بِہِ الْمِسْکَ۔","","Musannaf Ibn Abi Shaybah 11145","","","كتاب الجنائز"
"11146","(۱۱۱۴۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ ہَارُونَ بْنِ سَعْدٍ ، أَنَّ عَلِیًّا أَوْصَی أَنْ یُجْعَلَ فِی حَنُوطِہِ مِسْکٌ ، وَقَالَ ہُوَ فَضْلُ حَنُوطِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 11146","","","كتاب الجنائز"
"11147","(۱۱۱۴۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ وَمُحَمَّدُ بْنُ سُوقَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ لَمَّا غَزَا سَلْمَانُ بَلَنْجَرَ ، أَصَابَ فِی قِسْمَتِہِ صُرَّۃٌ مِنْ مِسْکٍ ، فَلَمَّا رَجَعَ اسْتَوْدَعَہَا امْرَأَتَہُ ، فَلَمَّا مَرِضَ مَرَضَہُ الَّذِی مَاتَ فِیہِ ، قَالَ لاِمْرَأَتِہِ وَہُوَ یَمُوتُ : أَرِینِی الصُّرَّۃَ الَّتِی اسْتَوْدَعْتُکِ ، فَأَتَتْہُ بِہَا ، فَقَالَ : ائْتِنِی بِإِنَائٍ نَظِیفٍ فَجَائَتْ بِہِ ، فَقَالَ : أَدِیفِیہِ ، ثُمَّ انْضَحِی بِہِ حَوْلِی ، فَإِنَّہُ یَحْضُرُنِی خَلْقٌ مِنْ خَلْقِ اللہِ ، لاَ یَأْکُلُونَ الطَّعَامَ ، وَیَجِدُونَ الرِّیحَ ، وَقَالَ : اخْرُجِی عَنِّی ، وَتَعَاہَدِینِی ، قَالَتْ : فَخَرَجْتُ ، ثُمَّ رَجَعْتُ وَقَدْ قَضَی۔","","Musannaf Ibn Abi Shaybah 11147","","","كتاب الجنائز"
"11148","(۱۱۱۴۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ حَنَّطَ مَیِّتًا بِمِسْکٍ۔","Sahih","Musannaf Ibn Abi Shaybah 11148","","","كتاب الجنائز"
"11149","(۱۱۱۴۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ فُضَیْلٍ ، عَنِ ابْنِ مغفل ، قَالَ : قَالَ عُمَرُ لاَ تُحَنِّطُونِی بِمِسْکٍ۔","","Musannaf Ibn Abi Shaybah 11149","","","كتاب الجنائز"
"11150","(۱۱۱۵۰) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرَ بْنِ مُحَمَّدٍ ، عَنْ سُفْیَانَ بْنِ عَاصِمٍ ، قَالَ : شَہِدْت عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ، قَالَ لأَمَۃٍ لَہُ إنِّی أَرَاک تلین حِنَاطِی فَلاَ تَجْعَلِینَ فِیہِ مِسْکًا۔","","Musannaf Ibn Abi Shaybah 11150","","","كتاب الجنائز"
"11151","(۱۱۱۵۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، أَنَّہُ قَالَ : لاَ بَأْسَ بِالَعَنَبَرِ فِی الْحَنُوطِ ، وَقَالَ : إنَّمَا ہُوَ صَمْغَۃٌ وَکَرِہَ الْمِسْکَ لِلْحَیِّ وَالْمَیِّتِ ، وَقَالَ ہُوَ مَیْتَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 11151","","","كتاب الجنائز"
"11152","(۱۱۱۵۲) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، أَنَّہُ کَرِہَ الْمِسْکَ لِلْمَیِّتِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11152","","","كتاب الجنائز"
"11153","(۱۱۱۵۳) حَدَّثَنَا سَہلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَکْرَہُ الْمِسْکَ لِلْحَیِّ وَالْمَیِّتِ وَیَقُولُ کَانَ الْمُسْلِمُونَ یَکْرَہُونَہُ وَیَقُولُونَ ہُوَ مَیْتَۃٌ۔","","Musannaf Ibn Abi Shaybah 11153","","","كتاب الجنائز"
"11154","(۱۱۱۵۴) حَدَّثَنَا یَحْیَی بْنُ الْیَمَانِ ووَکِیعٌ ، عَنِ ابْنِ أَبِی روََّاد ، عَنِ الضَّحَّاکِ ، أَنَّہُ کَرِہَ الْمِسْکَ فِی الْحَنُوطِ۔","","Musannaf Ibn Abi Shaybah 11154","","","كتاب الجنائز"
"11155","(۱۱۱۵۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کُفِّنَ فِی ثَلاَثَۃِ أَثْوَابٍ یَمَانِیَّۃٍ لَیْسَ فِیہَا قَمِیصٌ ، وَلاَ عِمَامَۃٌ فَقُلْنَا لِعَائِشَۃَ إنَّہُمْ یَزْعُمُونَ ، أَنَّہُ کَانَ کُفِّنَ فِی بُرْدٍ حِبَرَۃٍ ، فَقَالَتْ قَدْ جَاؤُوا بِبُرْدٍ حِبَرَۃٍ ، وَلَمْ یُکَفِّنُوہُ فِیہِ۔ (ابوداؤد ۳۱۴۴۔ بخاری۱۲۷۳)","Sahih","Musannaf Ibn Abi Shaybah 11155","","","كتاب الجنائز"
"11156","(۱۱۱۵۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ یَزِیدَ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کُفِّنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی ثَلاَثَۃِ أَثْوَابٍ فِی قَمِیصِہِ الَّذِی مَاتَ فِیہِ ، وَحُلۃٍ نَجْرَانِیَّۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 11156","","","كتاب الجنائز"
"11157","(۱۱۱۵۷) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ مَرَرْت عَلَی مَجْلِسٍ مِنْ مَجَالِسِ بَنِی عَبْدِ الْمُطَّلِبِ فَسَأَلْتُہُمْ فِی کَمْ کُفِّنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالُوا : فِی ثَلاَثَۃٍ أَثْوَابٍ ، لَیْسَ فِیہَا قَمِیصٌ ، وَلاَ قَبَائٌ ، وَلاَ عِمَامَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 11157","","","كتاب الجنائز"
"11158","(۱۱۱۵۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ کُفِّنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی ثَوْبَیْنِ صُحَارِیَّیْنِ وَبُرْدٍ حِبَرَۃٍ ، قَالَ : وَأَوْصَانِی أَبِی بِذَلِکَ۔","","Musannaf Ibn Abi Shaybah 11158","","","كتاب الجنائز"
"11159","(۱۱۱۵۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، قَالَ کُفِّنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی حُلَّۃٍ حَمْرَائَ وَثَوْبٍ مُمَشَّقٍ۔","","Musannaf Ibn Abi Shaybah 11159","","","كتاب الجنائز"
"11160","(۱۱۱۶۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ قَالَتْ لَمَّا حُضِرَ أَبُو بَکْرٍ ، قَالَ فِی کَمْ کُفِّنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قُلْتُ فِی ثَلاَثَۃِ أَثْوَابٍ سَحُولِیَّۃٍ ؟ قَالَ فَنَظَرَ إلَی ثَوْبٍ خَلِقٍ عَلَیْہِ ، فَقَالَ : اغْسِلُوا ہَذَا وَزِیدُوا عَلَیْہِ ثَوْبَیْنِ آخَرَیْنِ فَقُلْت بَلْ نَشْتَرِی لَکَ ثِیَابًا جُدُدًا ، فقَالَ : الْحَیُّ أَحَقُّ بِالْجَدِیدِ مِنَ الْمَیِّتِ إنَّمَا ہِیَ لِلْمُہْلَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 11160","","","كتاب الجنائز"
"11161","(۱۱۱۶۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ عَائِشَۃَ قَالَتْ : قَالَ أَبُو بَکْرٍ فِی کَمْ کَفَّنْتُمْ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقُلْت فِی ثَلاَثَۃِ أَثْوَابٍ ، قَالَ فَاغْسِلُوا ثَوْبَیَّ ہَذَیْنِ وَاشْتَرُوا لِی ثَوْبًا مِنَ السُّوقِ قَالَتْ إنَّا مُوسِرُونَ ، قَالَ : یَا بُنَیَّۃُ الْحَیُّ أَحَقُّ بِالْجَدِیدِ مِنَ الْمَیِّتِ إنَّمَا ہُوَ لِلْمُہْلَۃِ وَالصَّدِیدِ۔","Sahih","Musannaf Ibn Abi Shaybah 11161","","","كتاب الجنائز"
"11162","(۱۱۱۶۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، قَالَ کُفِّنَ أَبُو بَکْرٍ فِی ثَوْبَیْنِ سَحُولِیَّیْنِ وَرِدَائٍ لَہُ مُمَصَّر أَمَرَ بِہِ أَنْ یُغْسَلَ۔","","Musannaf Ibn Abi Shaybah 11162","","","كتاب الجنائز"
"11163","(۱۱۱۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ عُمَرَ کُفِّنَ فِی ثَلاَثَۃِ أَثْوَابٍ۔","Sahih","Musannaf Ibn Abi Shaybah 11163","","","كتاب الجنائز"
"11164","(۱۱۱۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ ثَوْرٍ ، عَنْ رَاشِدِ بْنِ سَعْدٍ ، قَالَ : قَالَ عُمَرُ یُکَفَّنُ الرَّجُلُ فِی ثَلاَثَۃِ أَثْوَابٍ لاَ تَعْتَدُوا إنَّ اللَّہَ لاَ یُحِبُّ الْمُعْتَدِینَ۔","","Musannaf Ibn Abi Shaybah 11164","","","كتاب الجنائز"
"11165","(۱۱۱۶۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ الْجَعْدِیِّ ، عَنْ إِبْرَاہِیمَ بن نَافِعٍ ، قَالَ : قَالَ أَبُو ہُرَیْرَۃَ کَفِّنُونِی فِی ثَلاَثَۃِ أَثْوَابٍ لُفُّونِی فِیہَا لَفًّا۔","","Musannaf Ibn Abi Shaybah 11165","","","كتاب الجنائز"
"11166","(۱۱۱۶۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرٍو بن ہرم ، عَنْ إبْرَاہِیمَ ، قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ ، عَنِ الْمَیِّتِ کَمْ یَکْفِیہ مِنَ الْکَفَنِ ، قَالَ : کَانَ ابْنُ عَبَّاسٍ یَقُولُ ثَوْبٌ ، أَوْ ثَلاَثَۃُ أَثْوَابٍ ، أَوْ خَمْسَۃُ أَثْوَابٍ۔","Sahih","Musannaf Ibn Abi Shaybah 11166","","","كتاب الجنائز"
"11167","(۱۱۱۶۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْوَلِیدِ بْنِ جُمَیْعٍ ، عَنْ أَبِی الطُّفَیْلِ ، عَنْ حُذَیْفَۃَ ، قَالَ کَفِّنُونِی فِی ثَوْبَیَّ ہَذَیْنِ فِی ثَوْبَین کَانَا عَلَیْہِ خَلَقَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 11167","","","كتاب الجنائز"
"11168","(۱۱۱۶۸) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنِ الزُّہْرِیِّ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍوَ قَالَ یُکَفَّنُ الْمَیِّتُ فِی ثَلاَثَۃِ أَثْوَابٍ قَمِیصٍ وَإِزَارٍ وَلِفَافَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 11168","","","كتاب الجنائز"
"11169","(۱۱۱۶۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ؛ أَنَّ وَاقِدَ بْنَ عَبْدِ اللہِ تُوُفِّیَ فَکَفَّنَہُ ابْنُ عُمَرَ فِی خَمْسَۃِ أَثْوَابٍ قَمِیصًا وَإِزَارًا وَثَلاَثَۃَ لَفَائِفَ وَعِمَامَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 11169","","","كتاب الجنائز"
"11170","(۱۱۱۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ کُفِّنَ حَمْزَۃُ فِی ثَوْبٍ۔","","Musannaf Ibn Abi Shaybah 11170","","","كتاب الجنائز"
"11171","(۱۱۱۷۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ جَابِرٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَفَّنَ حَمْزَۃَ فِی ثَوْبٍ ذَلِکَ الثَّوْبُ نَمِرَۃٌ۔ (ترمذی ۹۹۷۔ احمد ۳/۳۲۹)","Da'if","Musannaf Ibn Abi Shaybah 11171","","","كتاب الجنائز"
"11172","(۱۱۱۷۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، أَنَّ صَفِیَّۃَ ذَہَبَتْ یَوْمَ أُحُدٍ بِثَوْبَیْنِ تُرِیدُ أَنْ تُکُفِّنَ فِیہِمَا حَمْزَۃُ بْنُ عَبْدِ الْمُطَّلِبِ ، قَالَ وَأَحَدُ الثَّوْبَیْنِ أَوْسَعُ مِنَ الآخَرِ ، قَالَ فَوَجَدَتْ إلَی جَنْبِہِ رَجُلاً مِنَ الأَنْصَارِ فَأَقْرَعَتْ بَیْنَہُمَا فَکَفَّنَتِ الْفَارِعَ أَوْسَعَ الثَّوْبَیْنِ وَالآخَرَ فِی الثَّوْبِ الْبَاقِی۔","","Musannaf Ibn Abi Shaybah 11172","","","كتاب الجنائز"
"11173","(۱۱۱۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عِمْرَانَ ، عَنْ سُوَیْد ، أَنَّ أَبَا بَکْرٍ کُفِّنَ فِی ثَوْبَیْنِ۔","","Musannaf Ibn Abi Shaybah 11173","","","كتاب الجنائز"
"11174","(۱۱۱۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عِمْرَانَ ، عَنْ سُوَیْد ، قَالَ الرَّجُلُ وَالْمَرْأَۃُ یُکَفَّنَانِ فِی ثَوْبَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 11174","","","كتاب الجنائز"
"11175","(۱۱۱۷۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیْرِیِّ ، عَنْ غُنَیْمِ بْنِ قَیْسٍ ، قَالَ : کُنَّا نُکَفِّنُ فِی الثَّوْبَیْنِ وَالثَّلاَثَۃِ وَالأَرْبَعَۃِ۔","","Musannaf Ibn Abi Shaybah 11175","","","كتاب الجنائز"
"11176","(۱۱۱۷۶) حَدَّثَنَا ابْنُ حُبَاب ، قَالَ : حدَّثَنِی مُحَمَّدُ بْنُ صَالِحٍ ، قَالَ : حَدَّثَنِی یَزِیدُ بْنُ زَیْدٍ مَوْلَی أبی أُسَیْدَ ، عَنْ أَبِی أُسَیْدَ ، قَالَ إِنَّا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی قَبْرِ حَمْزَۃَ فَمُدَّتِ النَّمِرَۃُ عَلَی رَأْسِہِ فَانْکَشَفَتْ رِجْلاَہُ فَمُدَّتْ عَلَی رِجْلَیْہِ فَانْکَشَفَ رَأْسُہُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ضَعُوہَا عَلَی رَأْسِہِ وَاجْعَلُوا عَلَی رِجْلَیْہِ مِنْ شَجَرِ الْحَرْمَلِ۔ (بخاری ۳۲۲۴۔ ابن سعد ۱۵)","Da'if","Musannaf Ibn Abi Shaybah 11176","","","كتاب الجنائز"
"11177","(۱۱۱۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَّانَ بْنِ إِبْرَاہِیمَ ، عَن أُمَیَّۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : لاَ یُعَمَّمُ الْمَیِّتُ۔","No Data Available","Musannaf Ibn Abi Shaybah 11177","","","كتاب الجنائز"
"11178","(۱۱۱۷۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، عَنْ خَبَّابِ بْنِ الأَرَتِّ ، قَالَ ہَاجَرْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَبِیلِ اللہِ نَبْتَغِی وَجْہَ اللہِ تَعَالَی ، فَوَجَبَ أَجْرُنَا عَلَی اللہِ فَمِنَّا مَنْ مَضَی لَمْ یَأْکُلْ مِنْ أَجْرِہِ شَیْئًا مِنْہُمْ مُصْعَبُ بْنُ عُمَیْرٍ قُتِلَ یَوْمَ أُحُدٍ فَلَمْ نَجِدْ لَہُ شَیْئًا یُکَفَّنُ فِیہِ إِلاَّ نَمِرَۃً ، فَکُنَّا إذَا وَضَعْنَاہَا عَلَی رَأْسِہِ خَرَجَتْ رِجْلاَہُ ، فَإِذَا وَضَعْنَاہَا عَلَی رِجْلَیْہِ خَرَجَ رَأْسُہُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ضَعُوہَا مِمَّا یَلِی رَأْسَہُ وَاجْعَلُوا عَلَی رِجْلَیْہِ مِنَ الإِذْخِر وَمِنَّا مَنْ أَیْنَعَتْ لَہُ ثَمَرَۃٌ فَہُوَ یَہْدُبُہَا۔ n(بخاری ۱۲۷۶۔ ابوداؤد ۲۸۶۸)","Sahih","Musannaf Ibn Abi Shaybah 11178","","","كتاب الجنائز"
"11179","(۱۱۱۷۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ ، عَنْ أَبِیہِ ، أَنَّہُ أَوْصَی أَنْ یُکَفَّنَ فِی ثَلاَثَۃِ أَثْوَابٍ یُدْرَجُ فِیہَا إدْرَاجًا۔","","Musannaf Ibn Abi Shaybah 11179","","","كتاب الجنائز"
"11180","(۱۱۱۸۰) حَدَّثَنَا أَبُوالأَحْوَصِِ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، قَالَ یُکَفَّنُ الرَّجُلُ فِی ثَلاَثَۃِ أَثْوَابٍ الْقَمِیصِ وَالإِزَارِ وَاللِّفَافَۃِ۔","","Musannaf Ibn Abi Shaybah 11180","","","كتاب الجنائز"
"11181","(۱۱۱۸۱) حَدَّثَنَا یَحْیَی بْنُ الْیَمَانِ ، عَنْ سُفْیَانَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ یُعَمَّمُ الْمَیِّتُ۔","No Data Available","Musannaf Ibn Abi Shaybah 11181","","","كتاب الجنائز"
"11182","(۱۱۱۸۲) حَدَّثَنَا عُبید اللہِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَد ، عَنْ عَطَائٍ ، قَالَ یُکَفَّنُ الْمَیِّتُ فِی ثَوْبَیْنِ۔","","Musannaf Ibn Abi Shaybah 11182","","","كتاب الجنائز"
"11183","(۱۱۱۸۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ کَانَ یُحِبُّ أَنْ یُکَفَّنَ الْمَیِّتُ فِی قَمِیصٍ لَہُ إِزَارٌ وَکُمَّان مِثْلَ الْحَیِّ۔","","Musannaf Ibn Abi Shaybah 11183","","","كتاب الجنائز"
"11184","(۱۱۱۸۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عَلِیِّ بْنِ حُسَیْنٍ ، قَالَ کُفِّنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی ثَلاَثَۃِ أَثْوَابٍ أَحَدُہَا بُرْدٌ حِبَرَۃٌ۔ (ابن سعد ۲۸۴)","","Musannaf Ibn Abi Shaybah 11184","","","كتاب الجنائز"
"11185","(۱۱۱۸۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبی سَلَمَۃ ، عَنْ عَائِشَۃَ ؛ أَنَّ رَسُول اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سُجِّیَ فِی بُرْدٍ حِبَرَۃٍ ، فَصُدَّق ذَلِکَ عِنْدَہ قَول علیِّ بن حسین۔ (بخاری ۵۸۱۴۔ مسلم ۴۸)","Sahih","Musannaf Ibn Abi Shaybah 11185","","","كتاب الجنائز"
"11186","(۱۱۱۸۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ کُفِّنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی ثَلاَثَۃِ أَثْوَابٍ أَحَدُہَا بُرْدٌ۔","","Musannaf Ibn Abi Shaybah 11186","","","كتاب الجنائز"
"11187","(۱۱۱۸۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ إنَّ غَیْرَ وَاحِدٍ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کُفِّنَ فِی ثَوْبٍ وَاحِدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 11187","","","كتاب الجنائز"
"11188","(۱۱۱۸۸) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، أَنَّ حَمْزَۃَ بْنَ عَبْدِ الْمُطَّلِبِ کُفِّنَ فِی ثَوْبٍ وَاحِدٍ۔","","Musannaf Ibn Abi Shaybah 11188","","","كتاب الجنائز"
"11189","(۱۱۱۸۹) حَدَّثَنَا عَبْدَۃُ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ التَّیْمِیِّ ، عَنْ عَائِشَۃَ ، أَنَّ أَبَا بَکْرٍ ، قَالَ : إذَا مِتُّ فَاغْسِلِی مُلاَء تی ہَاتَیْنِ وَکَفِّنِینِی فِیہِمَا فَإِنَّ الْحَیَّ أَحْوَجُ إلَی الْجَدِیدِ مِنَ الْمَیِّتِ۔","Sahih","Musannaf Ibn Abi Shaybah 11189","","","كتاب الجنائز"
"11190","(۱۱۱۹۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَمْرَۃَ ، عَنْ عَائِشَۃَ قَالَتْ لاَ یُکَفَّنُ الْمَیِّتُ فِی أَقَلَّ مِنْ ثَلاَثَۃِ أَثْوَابٍ لِمَنْ قَدَرَ۔","","Musannaf Ibn Abi Shaybah 11190","","","كتاب الجنائز"
"11191","(۱۱۱۹۱) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی الْعَالِیَۃِ ، أَنَّ حَمْزَۃَ کُفِّنَ فِی ثَوْبٍ۔","","Musannaf Ibn Abi Shaybah 11191","","","كتاب الجنائز"
"11192","(۱۱۱۹۲) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنْ لَیْثٍ ، عَنْ خَیْثَمَۃَ ، عَنْ سُوَیْد ، قَالَ : لاَ تُکَفِّنُونِی إِلاَّ فِی ثَوْبَیْنِ۔","","Musannaf Ibn Abi Shaybah 11192","","","كتاب الجنائز"
"11193","(۱۱۱۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إیَاسِ بْنِ دَغْفَلٍ ، عَنْ عَبْدِ اللہِ بْنِ قَیْسِ بْن عُبَادٍ ، عَنْ أَبِیہِ ، أَنَّہُ أَوْصَی کَفِّنُونِی فِی بُرْدَیْ عَصْبٍ وَجَلِّلُوا سَرِیرِی کِسَائِی الأَبْیَضَ الَّذِی کُنْت أُصَلِّی فِیہِ۔","","Musannaf Ibn Abi Shaybah 11193","","","كتاب الجنائز"
"11194","(۱۱۱۹۴) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ، أَنَّ عُثْمَانَ بْنَ أَبِی الْعَاصِ کُفِّنَ فِی خَمْسَۃِ أَثْوَابٍ۔","Hasan","Musannaf Ibn Abi Shaybah 11194","","","كتاب الجنائز"
"11195","(۱۱۱۹۵) حَدَّثَنَا سُوَیْد بْنُ عَمْرٍو قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، عَنْ عَلِیٍّ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کُفِّنَ فِی سَبْعَۃِ أَثْوَابٍ۔ (احمد ۱/۱۰۲)","Da'if","Musannaf Ibn Abi Shaybah 11195","","","كتاب الجنائز"
"11196","(۱۱۱۹۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ مُحَمَّدٍ ، أَنَّہُ کَانَ یَقُولُ تُکَفَّنُ الْمَرْأَۃُ الَّتِی قد حَاضَتْ فِی خَمْسَۃِ أَثْوَابٍ ، أَوْ ثَلاَثَۃٍ۔","","Musannaf Ibn Abi Shaybah 11196","","","كتاب الجنائز"
"11197","(۱۱۱۹۷) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ تُکَفَّنُ الْمَرْأَۃُ فِی خَمْسَۃِ أَثْوَابٍ فِی دِرْعٍ وَخِمَارٍ وَلِفَافَۃٍ وَمِنْطَقٍ وَخِرْقَۃٍ تَکُونُ عَلَی بَطَنِہَا۔","","Musannaf Ibn Abi Shaybah 11197","","","كتاب الجنائز"
"11198","(۱۱۱۹۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ تُکَفَّنُ الْمَرْأَۃُ فِی خَمْسَۃِ أَثْوَابٍ دِرْعٍ وَخِمَارٍ وَحِقْوٍ وَلِفَافَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 11198","","","كتاب الجنائز"
"11199","(۱۱۱۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ ثَوْرٍ ، عَنْ رَاشِدِ بْنِ سَعْدٍ ، عَنْ عُمَرَ ، قَالَ تُکَفَّنُ الْمَرْأَۃُ فِی خَمْسَۃِ أَثْوَابٍ۔","","Musannaf Ibn Abi Shaybah 11199","","","كتاب الجنائز"
"11200","(۱۱۲۰۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : تُکَفَّنُ الْمَرْأَۃُ فِی خَمْسَۃِ أَثْوَابٍ فِی الْمِنْطَقِ ، وَفِی الدِّرْعِ ، وَفِی الْخِمَارِ ، وَفِی اللِّفَافَۃِ وَالْخِرْقَۃِ الَّتِی تُشَدُّ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 11200","","","كتاب الجنائز"
"11201","(۱۱۲۰۱) حَدَّثَنَا عَبْدُ الرَّحِمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ تُکَفَّنُ الْمَرْأَۃُ فِی خَمْسَۃِ أَثْوَابٍ فِی الدِّرْعِ وَالْخِمَارِ وَالرِّدَائِ وَالإِزَارِ وَالْخِرْقَۃِ۔","","Musannaf Ibn Abi Shaybah 11201","","","كتاب الجنائز"
"11202","(۱۱۲۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عِمْرَانَ ، عَنْ سُوَیْد ، قَالَ الْمَرْأَۃُ وَالرَّجُلُ یُکَفَّنَانِ فِی ثَوْبَیْنِ۔","","Musannaf Ibn Abi Shaybah 11202","","","كتاب الجنائز"
"11203","(۱۱۲۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ تُکَفَّنُ الْمَرْأَۃُ فِی دِرْعٍ وَخِمَارٍ وَلِفَافَۃٍ وَإِزَارٍ وَخِرْقَۃٍ۔","","Musannaf Ibn Abi Shaybah 11203","","","كتاب الجنائز"
"11204","(۱۱۲۰۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ أَشْعَثَ، عَنِ ابْنِ سِیرِینَ، قَالَ تُوضَعُ الْخِرْقَۃُ عَلَی بَطْنِہَا وَتُعَصِّبُ بِہَا فَخِذَیْہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 11204","","","كتاب الجنائز"
"11205","(۱۱۲۰۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ فِی الْخِرْقَۃِ الْخَامِسَۃِ تَلُفُّ بِہَا الْفَخِذَیْنِ تَحْتَ الدِّرْعِ۔","","Musannaf Ibn Abi Shaybah 11205","","","كتاب الجنائز"
"11206","(۱۱۲۰۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ وَخِرْقَۃٌ تَکُونُ عَلَی بَطْنِہَا۔","","Musannaf Ibn Abi Shaybah 11206","","","كتاب الجنائز"
"11207","(۱۱۲۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ تُشَدُّ الْخِرْقَۃُ فَوْقَ الثِّیَابِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11207","","","كتاب الجنائز"
"11208","(۱۱۲۰۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ یُکَفَّنُ الصَّبِیُّ فِی خِرْقَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 11208","","","كتاب الجنائز"
"11209","(۱۱۲۰۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ یُکَفَّنُ الْفَطِیمُ وَالرَّضِیعُ فِی الْخِرْقَۃِ ، فَإِنْ کَانَ فَوْقَ ذَلِکَ کُفِّنَ فِی قَمِیصٍ وَخِرْقَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 11209","","","كتاب الجنائز"
"11210","(۱۱۲۱۰) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ فِی السِّقْطِ ، قَالَ إِنْ شَائَ کَفَّنَہُ فِی ثَلاَثَۃِ أَثْوَابٍ۔","","Musannaf Ibn Abi Shaybah 11210","","","كتاب الجنائز"
"11211","(۱۱۲۱۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، قَالَ یُکَفَّنُ فِیمَا تَیَسَّرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 11211","","","كتاب الجنائز"
"11212","(۱۱۲۱۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ یُکَفَّنُ الصَّبِیُّ فِی خِرْقَۃٍ ، وَإِنْ کَانَ قَدْ سَعَی۔","","Musannaf Ibn Abi Shaybah 11212","","","كتاب الجنائز"
"11213","(۱۱۲۱۳) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنِ الْحَسَنِ بْنِ عَمْرٍو، عَنْ فُضَیْلٍ، عَنْ إبْرَاہِیمَ، قَالَ یُکَفَّنُ السِّقْطُ فِی خِرْقَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 11213","","","كتاب الجنائز"
"11214","(۱۱۲۱۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، قَالَ یُکَفَّنُ الصَّبِیُّ فِی ثَوْبٍ۔","","Musannaf Ibn Abi Shaybah 11214","","","كتاب الجنائز"
"11215","(۱۱۲۱۵) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ یُکَفَّنُ الصَّبِیُّ فِی خِمَارٍ یُجْعَلُ مِنْہُ قَمِیصٌ وَلِفَافَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 11215","","","كتاب الجنائز"
"11216","(۱۱۲۱۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ عُثْمَانَ ، قَالَ : سَأَلْتُ الْحَسَنَ عَنِ الْجَارِیَۃِ إذَا مَاتَتْ ہَلْ تُخَمَّرُ وَلَمْ تَحِضْ ؟ قَالَ : لاَ وَلَکِنْ تُکَفَّنُ فِی ثَلاَثَۃِ أَثْوَابٍ۔","","Musannaf Ibn Abi Shaybah 11216","","","كتاب الجنائز"
"11217","(۱۱۲۱۷) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، قَالَ مَاتَتِ ابْنَۃٌ لأَنَسِ بْنِ سِیرِینَ قَدْ أَعْصَرَتْ فَأَمَرَہُمَ ابْنُ سِیرِینَ أَنْ یُکَفِّنُوہَا فِی خُمُرٍ وَلِفَافَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 11217","","","كتاب الجنائز"
"11218","(۱۱۲۱۸) حَدَّثَنَا عُبَیْدُاللہِ بْنُ مُوسَی، قَالَ: أَخْبَرَنَا إسْرَائِیلُ، عَنْ عَبْدِ اللہِ بْنِ الْمُخْتَارِ، عَنِ الْحَسَنِ ؛ فِی الْجَارِیَۃِ الَّتِی لَمْ تَبْلُغْ ، قَالَ تُکَفَّنُ فِی ثَوْبٍ وَاحِدٍ۔","","Musannaf Ibn Abi Shaybah 11218","","","كتاب الجنائز"
"11219","(۱۱۲۱۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، قَالَ : سَأَلْتُ أَمُّ عَبْدِ الْحُمَیْدِ ابْنَۃَ سِیرِینَ ہَلْ رَأَیْت حَفْصَۃَ إذَا غُسَّلَتْ کَیْفَ تُصْنَعُ بِخِمَارِ الْمَرْأَۃِ قَالَتْ نَعَمْ کَانَتْ تُخَمَّرُہَا کَمَا تُخَمَّرُ الْحَیَّۃُ ، ثُمَّ تُفْضَلُ مِنَ الْخِمَارِ قدْرٰ ذِرَاعٍ فَتَفْرِشُہُ فِی مُؤَخِّرِہَا ، ثُمَّ تَعْطِفُ تِلْکَ الْفَضْلَۃَ فَتُغَطِّی بِہَا وَجْہَہَا۔","","Musannaf Ibn Abi Shaybah 11219","","","كتاب الجنائز"
"11220","(۱۱۲۲۰) حَدَّثَنَا عَفَّانُ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، قَالَ : کَانَ الْحَسَنُ یَقُولُ فِی الْمَیِّتِ تُوضَعُ الْعِمَامَۃُ وَسَطَ رَأْسِہِ ، ثُمَّ یُخَالَفُ بَیْنَ طَرَفَیْہَا ہَکَذَا عَلَی جَسَدِہِ ، قَالَ : وَقَالَ ابْنُ سِیرِینَ : یُعَمَّمُ کَمَا یُعَمَّمُ الْحَیُّ۔","","Musannaf Ibn Abi Shaybah 11220","","","كتاب الجنائز"
"11221","(۱۱۲۲۱) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ، عَنْ إبْرَاہِیمَ، قَالَ تُجَمَّرُ ثِیَابُہُ قَبْلَ أَنْ یُلْبِسہَا إیَّاہُ۔","","Musannaf Ibn Abi Shaybah 11221","","","كتاب الجنائز"
"11222","(۱۱۲۲۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : تُجَمَّرُ ثِیَابُ الْمَیِّتِ عَلَی مِشْجَبٍ ، أَوْ قَصَْبَاتٍ، قَالَ وَکَانَ مُحَمَّدٌ یَرَی ذَلِکَ إِنْ فَعَلُوا فَہُوَ حَسَنٌ وَأَحَبُّ إلَیَّ أَنْ تُجَمَّرُ وَہِیَ عَلَیْہِ بَعْدَ مَا یَلْبَسُ فَہُوَ أَبْقَی لِرِیحِہَا۔","","Musannaf Ibn Abi Shaybah 11222","","","كتاب الجنائز"
"11223","(۱۱۲۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ حَفْصٍ ، قَالَ : لاَ تُجَمَّرُ مِنَ الْمَیِّتِ إِلاَّ ثِیَابُہُ۔","","Musannaf Ibn Abi Shaybah 11223","","","كتاب الجنائز"
"11224","(۱۱۲۲۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ ، عَنْ فَاطِمَۃَ ، عَنْ أَسْمَائَ ، أَنَّہَا قَالَتْ عِنْدَ مَوْتِہَا إذَا أَنَا مِتُّ فَاغْسِلُونِی وَکَفِّنُونِی وَأَجْمِرُوا ثِیَابِی۔","Sahih","Musannaf Ibn Abi Shaybah 11224","","","كتاب الجنائز"
"11225","(۱۱۲۲۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ تُجَمَّرُ ثِیَابُہُ ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 11225","","","كتاب الجنائز"
"11226","(۱۱۲۲۶) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ ، قَالَ تُجَمَّرُ ثِیَابُہُ وِتْرًا۔","","Musannaf Ibn Abi Shaybah 11226","","","كتاب الجنائز"
"11227","(۱۱۲۲۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ أَنَّہُمَا کَانَا یُجَمِّرَانِ ثِیَابَ الْمَیِّتِ وِتْرًا۔","","Musannaf Ibn Abi Shaybah 11227","","","كتاب الجنائز"
"11228","(۱۱۲۲۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَعَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ تُجَمَّرُ ثِیَابُ الْمَیِّتِ وِتْرًا ، إِلاَّ أَنَّ ابْنَ مُسْہِرٍ ، قَالَ : مَا شِئْت۔","","Musannaf Ibn Abi Shaybah 11228","","","كتاب الجنائز"
"11229","(۱۱۲۲۹) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : یُجَمَّرُ الْمَیِّتُ وِتْرًا۔","Sahih","Musannaf Ibn Abi Shaybah 11229","","","كتاب الجنائز"
"11230","(۱۱۲۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ أَصْحَابُ عَبْدِ اللہِ یَقُولُونَ غَسْلُہُ وِتْرًا وتُجْمِیْرُ ثِیَابِہٖ۔","","Musannaf Ibn Abi Shaybah 11230","","","كتاب الجنائز"
"11231","(۱۱۲۳۱) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ أَبِی حُرَّۃَ ، عَنِ الْحَسَنِ ، قَالَ تَجْمِیرُ الْمَیِّت وِتْرٌ۔","","Musannaf Ibn Abi Shaybah 11231","","","كتاب الجنائز"
"11232","(۱۱۲۳۲) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا قُطْبَۃُ بْنُ عَبْدِ الْعَزِیزِ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا أَجْمَرْتُمَ الْمَیِّتَ فَأَجْمِرُوہُ ثَلاَثًا۔(احمد ۳۳۱۔ ابویعلی ۲۳۰۰)","Hasan","Musannaf Ibn Abi Shaybah 11232","","","كتاب الجنائز"
"11233","(۱۱۲۳۳) حَدَّثَنَا سَہْل بْنُ یُوسُفَ ، عَنِ ابْنِ عَوْنٍ ، أَنَّ مُحَمَّدًا کَانَ یُعْجِبُہُ الْکَفَنُ الصَّفِیقُ۔","","Musannaf Ibn Abi Shaybah 11233","","","كتاب الجنائز"
"11234","(۱۱۲۳۴) حَدَّثَنَا أَبُو حَیَّانَ ، عَنْ جَعْفَرٍ ، عَنْ مَیْمُونٍ ، قَالَ : کَانُوا یَسْتَحِبُّونَ أَنْ تُکَفَّنَ الْمَرْأَۃُ فِی غِلاَظِ الثِّیَابِ۔","","Musannaf Ibn Abi Shaybah 11234","","","كتاب الجنائز"
"11235","(۱۱۲۳۵) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ ، أَنَّہُ کَانَ یُعْجِبُہُمَا أَنْ یَکُونَ الْکَفَنُ کَتَّانًا۔","","Musannaf Ibn Abi Shaybah 11235","","","كتاب الجنائز"
"11236","(۱۱۲۳۶) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ سَمُرَۃََ بْنِ جُنْدُبٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَیْکُمْ بِالثِّیَابِ الْبَیَاضِ فَلْیَلْبَسْہَا أَحْیَاؤُکُمْ وَکَفِّنُوا فِیہَا مَوْتَاکُمْ۔ (نسائی ۹۶۴۳۔ عبدالرزاق ۶۲۹۸)","","Musannaf Ibn Abi Shaybah 11236","","","كتاب الجنائز"
"11237","(۱۱۲۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ مَیْمُونِ بْنِ أَبِی شَبِیبٍ ، عَنْ سَمُرَۃََ بْنِ جُنْدُبٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْبَسُوا الثِّیَابَ الْبِیضَ وَکَفِّنُوا فِیہَا مَوْتَاکُمْ۔n(ترمذی ۲۸۱۰۔ حاکم ۳۵۴)","","Musannaf Ibn Abi Shaybah 11237","","","كتاب الجنائز"
"11238","(۱۱۲۳۸) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ خُثَیْمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خَیْرُ ثِیَابِکُمَ الْبَیَاضُ۔ (ابوداؤد ۳۸۷۴۔ احمد ۱/۲۴۷)","Hasan","Musannaf Ibn Abi Shaybah 11238","","","كتاب الجنائز"
"11239","(۱۱۲۳۹) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ أَشْعَثَ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ أَنَّہُمَا قَالاَ : لاَ بَأْسَ أَنْ یُکَفَّنَ الرَّجُلُ فِی الثَّوْبِ الْہَرَوِیِّ۔","","Musannaf Ibn Abi Shaybah 11239","","","كتاب الجنائز"
"11240","(۱۱۲۴۰) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الْوَلِیدِ بْنِ عَمْرٍو ، عَنْ أَبِی الْحُوَیْرِثِ ، أَنَّ امْرَأَۃً عَرُوسًا دَخَلَتْ عَلَی زَوْجِہَا وَعَلَیْہَا ثِیَابٌ مُعَصْفَرَۃٌ فَمَاتَتْ حِینَ أُدْخِلَتْ عَلَیْہِ فَسُئِلَتْ عَائِشَۃُ ، فَقَالَتِ ادْفِنُوہَا فِی ثِیَابِہَا الَّتِی کَانَتْ عَلَیْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 11240","","","كتاب الجنائز"
"11241","(۱۱۲۴۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ یَرْفَعُہُ ، قَالَ : إذَا مَاتَ أَحَدُکُمْ فَلْیُحْسَنْ کَفَنُہُ ، قَالَ : فَإِنْ لَمْ یَجِدْ فَلْیُکَفِّنْہُ فِی بُرْدَیْ حِبَرَۃٍ۔ (مسلم ۴۹۔ احمد ۳/۳۲۹)","","Musannaf Ibn Abi Shaybah 11241","","","كتاب الجنائز"
"11242","(۱۱۲۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ خُثَیْمِ بْنِ عَمْرٍو ، أَنَّ عَبْدَ اللہِ بْنَ مَسْعُودٍ أَوْصَی أَنْ یُکَفَّنَ فِی حُلَّۃٍ ثَمَنُہَا ثمن مِائتَی دِرْہَمٍ۔","Da'if","Musannaf Ibn Abi Shaybah 11242","","","كتاب الجنائز"
"11243","(۱۱۲۴۳) حَدَّثَنَا بِشْرُ بْنُ مُفَضَّلٍ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ یُحِبُّ حُسْنَ الْکَفَنِ وَیُقَالُ إنَّہُمْ یَتَزَاوَرُونَ فِی أَکْفَانِہِمْ۔","","Musannaf Ibn Abi Shaybah 11243","","","كتاب الجنائز"
"11244","(۱۱۲۴۴) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : أَخْبَرَنَا مُعَاوِیَۃُ بْنُ صَالِحٍ ، قَالَ : حَدَّثَنَا سَعِیدُ بْنُ ہَانِئٍ ، عَنْ عُمَیْرِ بْنِ الأَسْوَد السَّکُونِیِّ ، أَنَّ مُعَاذَ بْنَ جَبَلٍ أَوْصَی بامْرَأَتِہِ وَخَرَجَ فَمَاتَتْ وَکَفَّنَّاہَا فِی ثِیَابٍ لَہَا خُلْقَانٍ فَقَدِمَ وقد رَفَعْنَا أَیْدِیَنَا عَنْ قَبْرِہَا سَاعَتَئذ ، فَقَالَ : فِیمَا کَفَّنْتُمُوہَا قُلْنَا فِی ثِیَابِہَا الْخُلْقَانِ فَنَبَشَہَا وَکَفَّنَہَا فِی ثِیَابٍ جُدُدٍ ، وَقَالَ أَحْسِنُوا أَکْفَانَ مَوْتَاکُمْ ، فَإِنَّہُمْ یُحْشَرُونَ فِیہَا۔","Hasan","Musannaf Ibn Abi Shaybah 11244","","","كتاب الجنائز"
"11245","(۱۱۲۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ بَشِیرٍ ، عَنْ أَبِی یَعْلَی ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، قَالَ لَیْسَ لِلْمَیِّتِ مِنَ الْکَفَنِ شَیْئٌ إنَّمَا ہُوَ تَکْرِمَۃُ الْحَیِّ۔","","Musannaf Ibn Abi Shaybah 11245","","","كتاب الجنائز"
"11246","(۱۱۲۴۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تُنَجِّسُوا مَوْتَاکُمْ فَإِنَّ الْمُؤْمِنَ لَیْسَ بِنَجِسٍ حَیًّا ، وَلاَ مَیِّتًا۔","Sahih","Musannaf Ibn Abi Shaybah 11246","","","كتاب الجنائز"
"11247","(۱۱۲۴۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : قُلْتُ لاِبْنِ عُمَرَ أَغْتَسِلُ مِنْ غُسْلِ الْمَیِّتِ ، قَالَ : لاَ۔","Da'if","Musannaf Ibn Abi Shaybah 11247","","","كتاب الجنائز"
"11248","(۱۱۲۴۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تُنَجِّسُوا مَیِّتُکُمْ یَعْنِی لَیْسَ عَلَیْہِ غُسْلٌ۔","Sahih","Musannaf Ibn Abi Shaybah 11248","","","كتاب الجنائز"
"11249","(۱۱۲۴۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ سُلَیْمَانَ بْنِ الرَّبِیعِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ غَسَّلَتْ أُمِّی مَیِّتَۃً ، فَقَالَتْ لِی سل ہَلْ عَلَیَّ غُسْلٌ فَأَتَیْت ابْنَ عُمَرَ فَسَأَلْتُہُ ، فَقَالَ : أَنَجِسًا غَسَّلَتْ ؟ ثُمَّ أَتَیْتُ ابْنَ عَبَّاسٍ فَسَأَلْتُہُ ، فَقَالَ مِثْلَ ذَلِکَ أَنَجِسًا غَسَّلَتْ؟۔","","Musannaf Ibn Abi Shaybah 11249","","","كتاب الجنائز"
"11250","(۱۱۲۵۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : سُئِلَ عَبْدُ اللہِ عَنِ الْغُسْلِ مِنْ غُسْلِ الْمَیِّتِ ، فَقَالَ: إِنْ کَانَ صَاحِبُکُمْ نَجِسًا فَاغْتَسِلُوا مِنْہُ۔","","Musannaf Ibn Abi Shaybah 11250","","","كتاب الجنائز"
"11251","(۱۱۲۵۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنِ الْجَعْدِ ، عَنْ عَائِشَۃَ بِنْتِ سَعْدٍ قَالَتْ أُوذِنَ سَعْدٌ بِجِنَازَۃِ سَعِیدِ بْنِ زَیْدٍ ، وَہُوَ بِالْبَقِیعِ فَجَائَ فَغَسَّلَہُ وَکَفَّنَہُ وَحَنَّطَہُ ، ثُمَّ أَتَی دَارَہٗ فَصَلَّی عَلَیْہِ ، ثُمَّ دَعَا بِمَائٍ فَاغْتَسَلَ ، ثُمَّ قَالَ : إنِّی لَمْ أَغْتَسِلْ مِنْ غُسْلِہِ وَلَوْ کَانَ نَجِسًا مَا غَسَّلْتُہُ وَلَکِنِّی اغْتَسَلْت مِنَ الْحَرِّ۔","Sahih","Musannaf Ibn Abi Shaybah 11251","","","كتاب الجنائز"
"11252","(۱۱۲۵۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، وَابْنِ عُمَرَ قَالاَ : لَیْسَ عَلَی غَاسِلِ الْمَیِّتِ غُسْلٌ۔","","Musannaf Ibn Abi Shaybah 11252","","","كتاب الجنائز"
"11253","(۱۱۲۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ یَزِیدَ الرِّشْکِ ، عَنْ مُعَاذَۃَ ، عَنْ عَائِشَۃَ ، أَنَّہَا سُئِلَتْ عَلَی الَّذِی یُغَسِّلُ الْمُتَوَِفِّینَ غُسْلٌ ؟ قَالَتْ : لاَ۔","Sahih","Musannaf Ibn Abi Shaybah 11253","","","كتاب الجنائز"
"11254","(۱۱۲۵۴) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ حَبِیبِ بْنِ الشَّہِیدِ ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ ، قَالَ : حدَّثَنِی عَلْقَمَۃُ بْنُ عَبْدِ اللہِ الْمُزَنِیّ ، قَالَ : غَسَّلَ أَبَاک أَرْبَعَۃٌ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَمَا زَادُوا عَلَی أَنْ کَفُّوا أَکْمَامَہُمْ وَأَدْخَلُوا قُمُصَہُمْ فِی حُجَزِہِمْ ، فَلَمَّا فَرَغُوا مِنْ غُسْلِہِ تَوَضَّؤُوا وُضُوئَہُمْ لِلصَّلاَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 11254","","","كتاب الجنائز"
"11255","(۱۱۲۵۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَوْفٍ ، قَالَ : حدَّثَنِی خُزَاعِیُّ بْنُ زِیَادٍ ، عَنْ عَبْدِ اللہِ بْنِ مُغَفَّلٍ ، قَالَ أَوْصَی عَبْدُ اللہِ بْنُ مُغَفَّلٍ أَنْ لاَ یَحْضُرَہُ ابْنُ زِیَادٍ وَأَنْ یَلِیَنِی أَصْحَابِی فَأَرْسَلُوا إلَی عَائِذِ بْنِ عَمْرٍو ، وَأَبِی بَرْزَۃَ وَأُنَاسٍ مِنْ أَصْحَابِہِ فَمَا زَادُوا عَلَی أَنْ کَفُّوا أَکِمَّتَہُم وَجَعَلُوا مَا فَضَلَ منْ قُمُصِہِمْ فِی حُجَزِہِمْ ، فَلَمَّا فَرَغُوا لَمْ یَزِیدُوا عَلَی الْوُضُوئِ۔","Da'if","Musannaf Ibn Abi Shaybah 11255","","","كتاب الجنائز"
"11256","(۱۱۲۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، أَنَّ ابْنَ عُمَرَ کَفَّنَ مَیِّتًا وَحَنَّطَہُ ، وَلَمْ یَمَسَّ مَائً۔","Sahih","Musannaf Ibn Abi Shaybah 11256","","","كتاب الجنائز"
"11257","(۱۱۲۵۷) حَدَّثَنَا وَکِیعٌ، عَنِ ابْنِ عَوْنٍ ، عَنْ إبْرَاہِیمَ، قَالَ: کَانُوا یَقُولُونَ إِنْ کَانَ صَاحِبُکُمْ نَجِسًا فَاغْتَسَلُوا مِنْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 11257","","","كتاب الجنائز"
"11258","(۱۱۲۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ إِنْ کَانَ صَاحِبُکُمْ نَجِسًا فَاغْتَسَلُوا مِنْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 11258","","","كتاب الجنائز"
"11259","(۱۱۲۵۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِیِّ ، عَنْ زَکَرِیَّا ، عَنْ مُصْعَبِ بْنِ شَیْبَۃَ ، عَنْ طَلْقِ بْنِ حَبِیبٍ ، عَنْ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، أَنَّ عَائِشَۃَ حَدَّثَتْہُ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : یُغْتَسَلُ مِنْ غُسْلِ الْمَیِّتِ۔","Hasan","Musannaf Ibn Abi Shaybah 11259","","","كتاب الجنائز"
"11260","(۱۱۲۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ عَبْدِ الْعَزِیزِ ، عَنْ مَکْحُولٍ ، قَالَ : سَأَلَ رَجُلٌ حُذَیْفَۃَ کَیْفَ أَصْنَعُ ، قَالَ اغْسِلْہُ کَیْتَ وَکَیْتَ فَإِذَا فَرَغْت فَاغْتَسِلْ۔","","Musannaf Ibn Abi Shaybah 11260","","","كتاب الجنائز"
"11261","(۱۱۲۶۱) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ جَابِرٍ، عَنْ عَامِرٍ، عَنِ الْحَارِثِ، عَنْ عَلِیٍّ، قَالَ مَنْ غَسَّلَ مَیِّتًا فَلْیَغْتَسِلْ۔","Da'if","Musannaf Ibn Abi Shaybah 11261","","","كتاب الجنائز"
"11262","(۱۱۲۶۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ مِنَ السُّنَّۃِ ، مَنْ غَسَّلَ مَیِّتًا اغْتَسَلَ۔","","Musannaf Ibn Abi Shaybah 11262","","","كتاب الجنائز"
"11263","(۱۱۲۶۳) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، أَنَّ رَجُلَیْنِ مِنْ أَصْحَابِ عَلِیٍّ وَأَصْحَابِ عَبْدِ اللہِ غَسَّلاَ مَیِّتًا فَاغْتَسَلَ الَّذِی مِنْ أَصْحَابِ عَلِیٍّ وَتَوَضَّأَ الَّذِی مِنْ أَصْحَابِ عَبْدِ اللہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11263","","","كتاب الجنائز"
"11264","(۱۱۲۶۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّہُ کَانَ یَقُولُ مَنْ غَسَّلَ مَیِّتًا فَلْیَغْتَسِلْ وَمَنْ حَمَلَہُ فَلْیَتَوَضَّأْ۔","Hasan","Musannaf Ibn Abi Shaybah 11264","","","كتاب الجنائز"
"11265","(۱۱۲۶۵) حَدَّثَنَا شَبَابَۃُ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ صَالِحٍ مَوْلَی التَّوْأَمَۃِ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ قَالَ : مَنْ غَسَّلَ مَیِّتًا فَلْیَغْتَسِلْ وَمَنْ حَمَلَہُ فَلْیَتَوَضَّأْ۔ (احمد ۴۳۳۔ بیہقی ۳۰۳)","","Musannaf Ibn Abi Shaybah 11265","","","كتاب الجنائز"
"11266","(۱۱۲۶۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، أَنَّہُ کَانَ إذَا غَسَّلَ مَیِّتًا اغْتَسَلَ۔","No Data Available","Musannaf Ibn Abi Shaybah 11266","","","كتاب الجنائز"
"11267","(۱۱۲۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ نَاجِیَۃَ بْنِ کَعْبٍ ، عَنْ عَلِیٍّ ، قَالَ لَمَّا مَاتَ أَبُو طَالِبٍ أَتَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقُلْت یَا رَسُولَ اللہِ إنَّ عَمَّک الشَّیْخَ الضَّالَّ قَدْ مَاتَ ، قَالَ : فَقَالَ : انْطَلِقْ فَوَارِہِ ، ثُمَّ لاَ تُحْدِثَنَّ شَیْئًا حَتَّی تَأْتِیَنِی ، قَالَ فَوَارَیْتُہُ ، ثُمَّ أَتَیْتُہُ فَأَمَرَنِی فَاغْتَسَلْت ، ثُمَّ دَعَا لِی بِدَعَوَاتٍ مَا یَسُرُّنِی ، أَنَّ لِی بِہِنَّ مَا عَلَی الأَرْضِ مِنْ شَیْئٍ۔ (ابوداؤد ۳۲۰۶۔ احمد ۱/۱۰۳)","Hasan","Musannaf Ibn Abi Shaybah 11267","","","كتاب الجنائز"
"11268","(۱۱۲۶۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُعَاذِ بْنِ جَبَلٍ ، قَالَ مَنْ غَسَّلَ مَیِّتًا فَأَدَّی فِیہِ الأَمَانَۃَ خَرَجَ مِنْ ذُنُوبِہِ کَیَوْمِ وَلَدَتْہُ أُمُّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 11268","","","كتاب الجنائز"
"11269","(۱۱۲۶۹) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ ہِشَامٍ ، عَنْ فَاطِمَۃَ ، عَنْ أَسْمَائَ ، أَنَّہَا أَوْصَتْ أَنْ لاَ یَجْعَلُوا عَلَی کَفَنِی حِنَاطًا۔","Sahih","Musannaf Ibn Abi Shaybah 11269","","","كتاب الجنائز"
"11270","(۱۱۲۷۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَرِہَ الْحَنُوطَ عَلَی النَّعْشِ۔","Da'if","Musannaf Ibn Abi Shaybah 11270","","","كتاب الجنائز"
"11271","(۱۱۲۷۱) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : رَأَیْتُ عَلَی جِنَازَۃِ الْحَارِثِ ذَرِیرَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 11271","","","كتاب الجنائز"
"11272","(۱۱۲۷۲) حَدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ بْنِ یَحْیَی ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، أَنَّہُ کَرِہَ الذَّرِیرَۃَ عَلَی النَّعْشِ۔","","Musannaf Ibn Abi Shaybah 11272","","","كتاب الجنائز"
"11273","(۱۱۲۷۳) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ، عَنِ رَبِیعٍ، عَنِ الْحَسَنِ، وَابْنِ سِیرِینَ أَنَّہُمَا کَرِہَا أَنْ یُجْعَلَ الْحَنُوطُ عَلَی النَّعْشِ۔","","Musannaf Ibn Abi Shaybah 11273","","","كتاب الجنائز"
"11274","(۱۱۲۷۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ صَاحِبٍ لَہُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 11274","","","كتاب الجنائز"
"11275","(۱۱۲۷۵) حَدَّثَنَا یَحْیَی بْنُ سُلَیْمٍ الطَّائِفِیُّ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، أَنَّہُ کَانَ یَکْرَہُ الذَّرِیرَۃَ الَّتِی تُجْعَلُ فَوْقَ النَّعْشِ وَیَقُولُ نَفْخٌ فِی الْحَیَاۃِ وَنَفْخٌ فِی الْمَمَاتِ!۔","","Musannaf Ibn Abi Shaybah 11275","","","كتاب الجنائز"
"11276","(۱۱۲۷۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، أَنَّ أَسْمَائَ بِنْتَ عُمَیْسٍ أَوَّلُ مَنْ أَحْدَثَ النَّعْشَ۔","Sahih","Musannaf Ibn Abi Shaybah 11276","","","كتاب الجنائز"
"11277","(۱۱۲۷۷) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ قَیْسِ بْنِ مُسلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، أَنَّ أُمَّ أَیْمَنَ أَمَرَتْ بِالنَّعْشِ لِلنِّسَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 11277","","","كتاب الجنائز"
"11278","(۱۱۲۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، قَالَ مَرُّوا عَلَی أَبِی مِجْلَزٍ بِنَعْشٍ کَبِیرٍ ، فَقَالَ : رَفَعَتِ الْیَہُودُ وَالنَّصَارَی فَخَالِفُوہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 11278","","","كتاب الجنائز"
"11279","(۱۱۲۷۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا إذَا کَانَتْ جِنَازَۃُ امْرَأَۃٍ أَکْفَوْا السّ??رِیرَ فَجَافُوا عَنْہَا بِقَوَائِمِہِ ، وَإِذَا کَانَ رَجُلٌ وُضِعَ عَلَی بَطْنِ السَّرِیرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11279","","","كتاب الجنائز"
"11280","(۱۱۲۸۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ أَنَّہُمَا کَرِہَا أَنْ یُجَمَّرَ سَرِیرُ الْمَیِّتِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11280","","","كتاب الجنائز"
"11281","(۱۱۲۸۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ فُضَیْلٍ ، عَنِ ابْنِ مُفَضَّلٍ ، قَالَ : قَالَ عُمَرُ لاَ تَتْبَعُنِّی بِمِجْمَرٍ۔","","Musannaf Ibn Abi Shaybah 11281","","","كتاب الجنائز"
"11282","(۱۱۲۸۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ الْجَعْدِ ، عَنْ إبْرَاہِیمَ بْنِ نَافِعٍ ، قَالَ : قَالَ أَبُو ہُرَیْرَۃَ لاَ تَتْبَعُونِی بِنَارٍ۔","","Musannaf Ibn Abi Shaybah 11282","","","كتاب الجنائز"
"11283","(۱۱۲۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ إسْمَاعِیلَ بْنِ مُجَمِّعٍ ، عَنْ عَمَّتِہِ أُمِّ النُّعْمَانِ بنت مُجَمِّعٍ ، عَنِ ابْنَۃِ أَبِی سَعِیدٍ ، أَنَّ أَبَا سَعِیدٍ ، قَالَ : لاَ تَتْبَعُونِی بِنَارٍ ، وَلاَ تَجْعَلُوا عَلَی سَرِیرِی قَطِیفَۃَ نَصْرَانِیٍّ۔","Da'if","Musannaf Ibn Abi Shaybah 11283","","","كتاب الجنائز"
"11284","(۱۱۲۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَارُونَ بن أبی إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ، عَنْ عَائِشَۃَ ، أَنَّہَا أَوْصَتْ أَنْ لاَ تَتْبَعُونِی بِمِجْمَرٍ ، وَلاَ تَجْعَلُوا عَلَیَّ قَطِیفَۃً حَمْرَائَ۔","","Musannaf Ibn Abi Shaybah 11284","","","كتاب الجنائز"
"11285","(۱۱۲۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الأَشْہَبِ ، عَنْ بَکْرٍ ، عَنْ عَبْدِ اللہِ بْنِ مُغَفَّلٍ أَنَّہُ أَوْصَی أَنْ لاَ تَتْبَعُونِی بِصَوْتٍ ، وَلاَ بنَارٍ وَلاَ تَرْمُونِی بِالْحِجَارَۃِ یَعْنِی الْمَدَرَ الَّذِی یَکُونُ عَلَی شَفِیرِ الْقَبْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 11285","","","كتاب الجنائز"
"11286","(۱۱۲۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّہُ رَأَی مِجْمَرًا فِی جِنَازَۃٍ فَکَسَرَہ ، وَقَالَ سَمِعْت ابْنَ عَبَّاسٍ یَقُولُ لاَ تُشَبَہُوا بِأَہْلِ الْکِتَابِ۔","Da'if","Musannaf Ibn Abi Shaybah 11286","","","كتاب الجنائز"
"11287","(۱۱۲۸۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ أَنَّہُمَا کَرِہَا أَنْ تُتْبَعَ الْجنَازَۃُ بِمِجْمَرٍ۔","","Musannaf Ibn Abi Shaybah 11287","","","كتاب الجنائز"
"11288","(۱۱۲۸۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا أَخْرَجْتہُ فَلاَ تَتْبَعہُ نَارًا۔","No Data Available","Musannaf Ibn Abi Shaybah 11288","","","كتاب الجنائز"
"11289","(۱۱۲۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنٍ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ أَنْ یَتْبَعَہُ مُجْمِرٌ۔","","Musannaf Ibn Abi Shaybah 11289","","","كتاب الجنائز"
"11290","(۱۱۲۹۰) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ عَوْنٍ ، قَالَ غَدَوْنَا عَلَی إبْرَاہِیمَ النَّخَعِیِّ فَأَخْبَرُونَا ، أَنَّہُ مَاتَ وَدُفِنَ مِنَ اللَّیْلَ ، قَالَ فَأَخْبَرَنَا عَبْدُ الرَّحْمَنِ بْنُ الأَسْوَد ، أَنَّہُ أَوْصَی أَنْ لاَ تَتْبَعُوا جِنَازَتَہُ بِنَارٍ ، وَلاَ تَجْعَلُوا عَلَیْہِ مِنَ اللَّبِنِ الْعَرْزَمِیِّ الَّذِی یُصْنَعُ مِنَ الْکُنَاسَاتِ۔","","Musannaf Ibn Abi Shaybah 11290","","","كتاب الجنائز"
"11291","(۱۱۲۹۱) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، قَالَ أَتَیْنَا إلَی مَنْزِلِ إبْرَاہِیمَ بَعْدَ مَوْتِہِ فَقُلْنَا بِأَیِّ شَیْئٍ أَوْصَی ؟ قَالُوا : أَوْصَی أَنْ لاَ یُتْبَعَ بِنَارٍ وَأَلْحِدُوا لِی لَحْدًا ، وَلاَ تَجْعَلُوا فِی قَبْرِی لَبِنًا عَرْزَمِیًّا۔","No Data Available","Musannaf Ibn Abi Shaybah 11291","","","كتاب الجنائز"
"11292","(۱۱۲۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شَیْبَانَ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ رَجُلٍ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تُتْبَعُ الْجِنَازَۃُ بِصَوْتٍ ، وَلاَ بِنَارٍ ، وَلاَ یُمْشَی أَمَامَہَا۔ (ابوداؤد ۳۱۶۳۔ احمد ۲/۵۲۸)","Da'if","Musannaf Ibn Abi Shaybah 11292","","","كتاب الجنائز"
"11293","(۱۱۲۹۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ إسْمَاعِیلَ ، عَنْ حَنَشِ بْنِ الْمُعْتَمِرِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی جِنَازَۃ فَرَأَی امْرَأَۃً مَعَہَا مِجْمَرٌ ، فَقَالَ : اطْرُدُوہَا ، فَمَا زَالَ قَائِمًا حَتَّی قَالُوا : یَا رَسُولَ اللہِ قَدْ تَوَارَتْ فِی آجَامِ الْمَدِینَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 11293","","","كتاب الجنائز"
"11294","(۱۱۲۹۴) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، عَنْ أَبِی بِشْرٍ ، عَنْ یُوسُفَ بْنِ مَاہَکَ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ فِی جِنَازَۃٍ وَاضِعًا السَّرِیرَ عَلَی کَاہِلِہٖ بَیْنَ الْعَمُودَیْنِ۔","","Musannaf Ibn Abi Shaybah 11294","","","كتاب الجنائز"
"11295","(۱۱۲۹۵) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، قَالَ : رَأَیْتُ سَالِمَ بْنَ عَبْدِ اللہِ بَیْنَ عَمُودَیْ سَرِیرِ أُمِّہِ حَتَّی خَرَجَ بِہَا مِنَ الدَّارِ وَحَمْزَۃُ ، وَعُبَیْدُ اللہِ أَحَدُہُمَا أَخَذَ بِعِضَادَاۃ السَّرِیرِ الْیُمْنَی وَالآخَرُ بِالْیُسْرَی۔","","Musannaf Ibn Abi Shaybah 11295","","","كتاب الجنائز"
"11296","(۱۱۲۹۶) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ مَعْرُوفٍ مَوْلًی لِقُرَیْشٍ ، قَالَ : رَأَیْتُ الْمُطَّلِبَ بْنَ عَبْدِ اللہِ بْنِ حَنْطَبٍ بَیْنَ عَمُودَیْ سَرِیرِ ابْنِہِ الْحَارِثِ۔","","Musannaf Ibn Abi Shaybah 11296","","","كتاب الجنائز"
"11297","(۱۱۲۹۷) حَدَّثَنَا وَکِیعٌ وَغُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِیہِ ، قَالَ : رَأَیْتُ سَعْدًا عِنْدَ قَائِمَۃِ سَرِیرِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ یَقُولُ : وَاجَبَلاَہ۔","Sahih","Musannaf Ibn Abi Shaybah 11297","","","كتاب الجنائز"
"11298","(۱۱۲۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنِ أبی إِسْحَاقَ ، قَالَ : رَأَیْتُ أَبَا جُحَیْفَۃَ فِی جِنَازَۃِ أَبِی مَیْسَرَۃَ آخِذًا بِقَائِمَۃِ السَّرِیرِ ، وَجَعَلَ یَقُولُ غَفَرَ اللَّہُ لَکَ یَا أَبَا مَیْسَرَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 11298","","","كتاب الجنائز"
"11299","(۱۱۲۹۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یَکْرَہُ أَنْ یَکُونَ بَیْنَ قَائِمَۃِ السَّرِیرِ رَجُلاً یَحْمِلُہُ۔","","Musannaf Ibn Abi Shaybah 11299","","","كتاب الجنائز"
"11300","(۱۱۳۰۰) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ فُرَاتِ بْنِ سَلْمَانَ ، قَالَ أُخْرِجَتْ جِنَازَۃٌ مِنْ دَارِ بَنِی ذِی الْخِمَارِ ، قَالَ : وَشَابٌّ مِنْہُمْ قد وَضَعَ السَّرِیرَ عَلَی کَاہِلِہِ فَأَخَذَ مَیْمُونٌ بِیَدِہِ فَأَخْرَجَہُ۔","","Musannaf Ibn Abi Shaybah 11300","","","كتاب الجنائز"
"11301","(۱۱۳۰۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ إسْمَاعِیلَ ، قَالَ : رَأَیْتُ أَبَا جُحَیْفَۃَ فِی جِنَازَۃِ أَبِی مَیْسَرَۃَ وَالسَّرِیرُ عَلَی عَاتِقِہِ وَہُوَ یَقُولُ : اللَّہُمَّ اغْفِرْ لأَبِی مَیْسَرَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 11301","","","كتاب الجنائز"
"11302","(۱۱۳۰۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ، أَنَّہُ کَرِہَ أَنْ یَقُومَ فِی مُقَدَّمِ السَّرِیرِ ، أَوْ مُؤَخَّرِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11302","","","كتاب الجنائز"
"11303","(۱۱۳۰۳) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یَکْرَہُ أَنْ یَتْبَعَ الرَّجُلُ الْجِنَازَۃَ یَقُولُ اسْتَغْفِرُوا لَہُ غَفَرَ اللَّہُ لَکُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 11303","","","كتاب الجنائز"
"11304","(۱۱۳۰۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ بُکَیْرِ بْنِ عَتِیقٍ ، قَالَ : کُنْتُ فِی جِنَازَۃٍ فِیہَا سَعِیدُ بْنُ جُبَیْرٍ ، فَقَالَ رَجُلٌ : اسْتَغْفِرُوا لَہُ غَفَرَ اللَّہُ لَکُمْ ، قَالَ سَعِیدُ بْنُ جُبَیْرٍ لاَ غَفَرَ اللَّہُ لَک۔","","Musannaf Ibn Abi Shaybah 11304","","","كتاب الجنائز"
"11305","(۱۱۳۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْعَلاَئِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : کُنْتُ مَعَہُ فِی جِنَازَۃٍ فَسَمِعَ رَجُلاً یَقُولُ اسْتَغْفِرُوا لَہُ غَفَرَ اللَّہُ لَکُمْ فَنَہَاہُ۔","","Musannaf Ibn Abi Shaybah 11305","","","كتاب الجنائز"
"11306","(۱۱۳۰۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، أَنَّہُ کَرِہَ أَنْ یَقُولَ اسْتَغْفِرُوا لَہُ غَفَرَ اللَّہُ لَکُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 11306","","","كتاب الجنائز"
"11307","(۱۱۳۰۷) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ أَوَّلُ مَا سَمِعْت فِی جِنَازَۃِ اسْتَغْفِرُوا لَہُ فِی جِنَازَۃٍ سَعْدِ بْنِ أَوْسٍ۔","","Musannaf Ibn Abi Shaybah 11307","","","كتاب الجنائز"
"11308","(۱۱۳۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ أَنْ یَقُولَہُ۔","","Musannaf Ibn Abi Shaybah 11308","","","كتاب الجنائز"
"11309","(۱۱۳۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، عَنِ الْحَسَنِ ، أَنَّہُ کَرِہَ أَنْ یَقُولَ اسْتَغْفِرُوا غَفَرَ اللَّہُ لَکُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 11309","","","كتاب الجنائز"
"11310","(۱۱۳۱۰) حَدَّثَنَا أَبُو مُطِیعٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، أَنَّہُ کَانَ فِی جِنَازَۃٍ فَسَمِعَ رَجُلاً یَقُولُہ ، فَقَالَ سَعِیدُ بْنُ الْمُسَیَّبِ : مَا یَقُولُ زاجزکُمْ ہَذَا ؟!۔","","Musannaf Ibn Abi Shaybah 11310","","","كتاب الجنائز"
"11311","(۱۱۳۱۱) حَدَّثَنَا قَبِیصَۃُ ، عَنْ سُفْیَانَ ، عَنِ الرَّبِیعِ بْنِ أَبِی رَاشِد ، أَنَّ سَعِیدَ بْنَ جُبَیْرٍ سَمِعَ رَجُلاً یَقُولُ فِی جِنَازَۃٍ : اسْتَغْفِرُوا لَہُ غَفَرَ اللَّہُ لَکُمْ ، فَغَضِبَ۔","","Musannaf Ibn Abi Shaybah 11311","","","كتاب الجنائز"
"11312","(۱۱۳۱۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : کُنَّا فِی جِنَازَۃٍ فَرَفَعَ نَاسٌ مِنَ الْقُصَّاصِ أَصْوَاتَہُمْ ، فَقَالَ أَبُو قِلاَبَۃَ کَانُوا یُعَظِّمُونَ الْمَیِّتَ بِالسَّکِینَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11312","","","كتاب الجنائز"
"11313","(۱۱۳۱۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ ہَمَّامٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ قَیْسِ بْنِ عُبَادٍ ، قَالَ : کَانَ أَصْحَابُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْتَحِبُّونَ خَفْضَ الصَوْتٍ عِنْدَ ثَلاَثٍ ، عِنْدَ الْقِتَالِ ، وَعِنْدَ الْقُرْآنِ، وَعِنْدَ الْجَنَائِزِ۔","Sahih","Musannaf Ibn Abi Shaybah 11313","","","كتاب الجنائز"
"11314","(۱۱۳۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ قَیْسِ بْنِ عُبَادٍ ، قَالَ : کَانَ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَذَکَرَ نَحْوَہُ۔ (ابوداؤد ۲۶۴۹۔ حاکم ۱۱۶)","Sahih","Musannaf Ibn Abi Shaybah 11314","","","كتاب الجنائز"
"11315","(۱۱۳۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا کَانَ فِی جِنَازَۃٍ أَکْثَرَ السُّکُوتَ وَحَدَّثَ نَفْسَہُ۔ (عبدالرزاق ۶۲۸۲)","","Musannaf Ibn Abi Shaybah 11315","","","كتاب الجنائز"
"11316","(۱۱۳۱۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنِ الْحَسَنِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَکْرَہُ الصَّوْتَ عِنْدَ ثَلاَثٍ عِنْدَ الْجِنَازَۃِ ، وَإِذَا الْتَقَی الزَّحْفَانِ ، وَعِنْدَ قِرَائَۃِ الْقُرْآنِ۔n(ابوداؤد ۲۶۴۹۔ حاکم ۱۱۶)","Da'if","Musannaf Ibn Abi Shaybah 11316","","","كتاب الجنائز"
"11317","(۱۱۳۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حَبِیبِ بْنِ سُلَیْمٍ ، عَنْ بِلاَلِ بْنِ یَحْیَی ، عَنْ حُذَیْفَۃَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ النَّعْیِ۔ (احمد ۵/۴۰۶۔ ترمذی ۹۸۶)","","Musannaf Ibn Abi Shaybah 11317","","","كتاب الجنائز"
"11318","(۱۱۳۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : النَّعْیُ مِنْ أَمْرِ الْجَاہِلِیَّۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 11318","","","كتاب الجنائز"
"11319","(۱۱۳۱۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ أَبِی حَیَّانَ ، عَنْ أَبِیہِ ، قَالَ : أَوْصَی الرَّبِیعُ بْنُ خُثَیْمٍ أَنْ لاَ تُشْعِرُوا بِی أَحَدًا ، وَسُلُّونِی إلَی رَبِّی سَلاًّ۔","","Musannaf Ibn Abi Shaybah 11319","","","كتاب الجنائز"
"11320","(۱۱۳۲۰) عَنْ عَبْدَۃَ بْنِ سُلَیْمَانَ ، عَنِ الزِّبْرِقَانِ ، قَالَ : سَمِعْتُ أَبَا وَائِلٍ عِنْدَ مَوْتِہٖ یَقُولُ : إذَا أَنَا مِتّ فَلاَ تُؤْذِنُوا بِی أَحَدًا۔","","Musannaf Ibn Abi Shaybah 11320","","","كتاب الجنائز"
"11321","(۱۱۳۲۱) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : أَوْصَی أَبُو مَیْسَرَۃَ أَخَاہُ أَنْ لاَ تُؤْذِنَ لِی أَحَدًا ، قَالَ أَبُو إِسْحَاقَ وَبِذَلِکَ أَوْصَی عَلْقَمَۃُ الأَسْوَدَ۔","","Musannaf Ibn Abi Shaybah 11321","","","كتاب الجنائز"
"11322","(۱۱۳۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ قَیسٍ ، عَنْ عَلِیِّ بْنِ مُدْرِکٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، أَنَّہُ أَوْصَی أَنْ لاَ تُؤْذِنُوا بی أَحَدًا ، فَإِنِّی أَخَافُ أَنْ یَکُونَ النَّعْیُ مِنْ أَمْرِ الْجَاہِلِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 11322","","","كتاب الجنائز"
"11323","(۱۱۳۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أُمَیٍّ ، عَنْ أَبِی الْہَیْثَمِ ، قَالَ : قَالَ إبْرَاہِیمُ إذَا کُنْتُمْ أَرْبَعَۃً فَلاَ تُؤْذِنُوا أَحَدًا۔","","Musannaf Ibn Abi Shaybah 11323","","","كتاب الجنائز"
"11324","(۱۱۳۲۴) حَدَّثَنَا أَبُو نُعَیْمٍ الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إسْرَائِیلَ ، عَنْ ثُوَیْرٍ ، عَنْ أَبِی جَعْفَرَ ، أَنَّ عَلِیَّ بْنَ حُسَیْنٍ أَوْصَی أَنْ لاَ تُعْلِمُوا بِی أَحَدًا۔","","Musannaf Ibn Abi Shaybah 11324","","","كتاب الجنائز"
"11325","(۱۱۳۲۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمِ بْنِ مُحَمَّدٍ عن أبیہ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ إذَا مَاتَ لَہُ مَیِّتٌ تحَیَّنَ غَفَلَۃَ النَّاسِ۔","Sahih","Musannaf Ibn Abi Shaybah 11325","","","كتاب الجنائز"
"11326","(۱۱۳۲۶) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنْ لَیْثٍ ، عَنْ خَیْثَمَۃَ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : إذَا أَنَا مِتّ فَلاَ تُؤْذِنُوا بِی أَحَدًا۔","No Data Available","Musannaf Ibn Abi Shaybah 11326","","","كتاب الجنائز"
"11327","(۱۱۳۲۷) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ أَبِی التَّیَّاحِ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ الشِّخِّیرِ ، عَنْ مُطَرِّفٍ أَخِیہِ ، أَنَّہُ قَالَ : لاَ تُؤْذِنُوا لِجِنَازَتِی أَحَدًا۔","","Musannaf Ibn Abi Shaybah 11327","","","كتاب الجنائز"
"11328","(۱۱۳۲۸) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ أَبِیہِ ، قَالَ : لاَ تُؤْذِنُوا بِجِنَازَتِی أَہْلَ مَسْجِدِی۔","","Musannaf Ibn Abi Shaybah 11328","","","كتاب الجنائز"
"11329","(۱۱۳۲۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عُثْمَانَ بْنُ حَکِیمٍ ، عَنْ خَارِجَۃَ بْنِ زَیْدٍ ، عَنْ عَمِّہِ یَزِیدَ بْنِ ثَابِتٍ ، وَکَانَ أَکْبَرَ مِنْ زَیْدٍ ، قَالَ : خَرَجْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَلَمَّا وَرَدْنَا الْبَقِیعَ إذَا ہُوَ بِقَبْرٍ جَدِیدٍ ، فَسَأَلَ عَنْہُ فَقَالُوا : فُلاَنَۃُ فَعَرَفَہَا ، قَالَ : فَقَالَ : أَفَلاَ آذَنْتُمُونِی بِہَا ؟ قَالُوا : کُنْت قَائِلاً فَکَرِہْنَا أَنْ نُؤْذِنَک ، فَقَالَ : لاَ تَفْعَلُوا ، لاَ أَعْرِفَنَّ مَا مَاتَ مِنْکُمْ مَیِّتٌ بَیْنَ أَظْہُرِکُمْ إِلاَّ آذَنْتُمُونِی بِہِ فَإِنَّ صَلاَتِی عَلَیْہِ لَہُ رَحْمَۃٌ۔n(بخاری ۴۲۔ احمد ۴/۳۸۸)","","Musannaf Ibn Abi Shaybah 11329","","","كتاب الجنائز"
"11330","(۱۱۳۳۰) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُؤْذِنَ الرَّجُلُ حَمِیمَہُ وَصَدِیقَہُ بِالْجِنَازَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11330","","","كتاب الجنائز"
"11331","(۱۱۳۳۱) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عُرْوَۃَ ، أَنَّ أَبَا ہُرَیْرَۃَ کَانَ یُؤْذِنُ بِالْجِنَازَۃِ فَیَمُرُّ بِالْمَسْجِدِ فَیَقُولُ عَبْدُ اللہِ دُعِیَ فَأَجَابَ ، أَوْ أَمَۃُ اللہِ دُعِیَتْ فَأَجَابَتْ ، فَلاَ یَقُومُ مَعَہَا إِلاَّ الْقَلِیلُ مِنْہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 11331","","","كتاب الجنائز"
"11332","(۱۱۳۳۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَبِی حَیَّانَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ عَمْرُو بْنُ مَیْمُونٍ صِدِّیقًا لِلرَّبِیعِ بْنِ خُثَیْمٍ ، فَلَمَّا ثَقُلَ ، قَالَ عَمْرٌو لأُمِّ وَلَدِ الرَّبِیعِ بْنِ خُثَیْمٍ أَعْلِمِینِی إذَا مَاتَ ، فَقَالَتْ : إِنَّہُ قَالَ : إذَا أَنَا مِتُّ فَلاَ تُشْعِرِی بِی أَحَدًا ، وَسُلُّونِی إلَی رَبِّی سَلاً ، قَالَ فَبَاتَ عَمْرٌو عَلَی دَکَاکِینِ بَنِی ثَوْرٍ حَتَّی أَصْبَحَ فَشَہِدَہُ۔","","Musannaf Ibn Abi Shaybah 11332","","","كتاب الجنائز"
"11333","(۱۱۳۳۳) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُؤْذِنَ بِالْمَیِّتِ صَدِیقَہُ ، وَقَالَ : إنَّمَا کَانُوا یَکْرَہُونَ نَعْیًا کَنَعْیِ الْجَاہِلِیَّۃِ ، أَنْعِی فُلاَنًا۔","No Data Available","Musannaf Ibn Abi Shaybah 11333","","","كتاب الجنائز"
"11334","(۱۱۳۳۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ النُّعْمَانِ ، قَالَ : کَانَ عَلِیٌّ إذَا دُعِیَ إلَی جِنَازَۃٍ ، قَالَ : إنَّا لَقَائِمُونَ وَمَا یُصَلِّی عَلَی الْمَرْئِ إِلاَّ عَمَلُہُ۔","","Musannaf Ibn Abi Shaybah 11334","","","كتاب الجنائز"
"11335","(۱۱۳۳۵) حَدَّثَنَا سَعِیدُ بْنُ یَحْیَی الْحِمْیَرِیُّ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی أُمَامَۃَ بْنِ سَہْلٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَعُودُ فُقَرَائَ أَہْلِ الْمَدِینَۃِ وَیَشْہَدُ جَنَائِزَہُمْ إذَا مَاتُوا ، قَالَ : فَتُوُفِّـیَتِ امْرَأَۃٌ مِنْ أَہْلِ الْعَوَالِی ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا حَضَرَتْ فَآذِنُونِی بِہَا ، قَالَ فَأَتَوْہُ لِیُؤْذِنُوہُ فَوَجَدُوہُ نَائِمًا وَقَدْ ذَہَبَ مِنَ اللَّیْلِ فَکَرِہُوا أَنْ یُوقِظُوہُ وَتَخَوَّفُوا عَلَیْہِ ظُلْمَۃَ اللَّیْلِ وَہَوَامَّ الأَرْضِ ، فَلَمَّا أَصْبَحَ سَأَلَ عَنْہَا فَقَالُوا : یَا رَسُولَ اللہِ أَتَیْنَاک لِنُؤْذِنَک بِہَا فَوَجَدْنَاک نَائِمًا فَکَرِہْنَا أَنْ نُوقِظَک وَتَخَوَّفْنَا عَلَیْک ظُلْمَۃَ اللَّیْلِ وَہَوَامَّ الأَرْضِ ، قَالَ : فَدَفَنَّاہَا ، قَالَ : فَمَشَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی قَبْرِہَا فَصَلَّی عَلَیْہَا وَکَبَّرَ أَرْبَعًا۔ (حاکم ۴۶۶)","Da'if","Musannaf Ibn Abi Shaybah 11335","","","كتاب الجنائز"
"11336","(۱۱۳۳۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَبَا بَکْرٍ وَعُمَرَ یَمْشُونَ أَمَامَ الْجِنَازَۃِ۔ (ابوداؤد ۳۱۷۱۔ ترمذی ۱۰۰۷)","Sahih","Musannaf Ibn Abi Shaybah 11336","","","كتاب الجنائز"
"11337","(۱۱۳۳۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ حُصَیْنٍ ، عَنْ سَالِمٍ ، قَالَ : رَأَیْتُ ابن عُمَرَ یَمْشِی أَمَامَ الْجِنَازَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 11337","","","كتاب الجنائز"
"11338","(۱۱۳۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنْ أَبِی حَازِم ، قَالَ : رَأَیْتُ أَبَا ہُرَیْرَۃَ وَالْحَسَنَ بْنَ عَلِیٍّ یَمْشِیَانِ أَمَامَ الْجِنَازَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 11338","","","كتاب الجنائز"
"11339","(۱۱۳۳۹) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ صَالِحٍ مَوْلَی التَّوْأَمَۃِ ، قَالَ : رَأَیْتُ أَبَا ہُرَیْرَۃَ وَأَبَا قَتَادَۃَ ، وَابْنَ عُمَرَ وَأَبَا أُسَیْدَ یَمْشُونَ أَمَامَ الْجِنَازَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 11339","","","كتاب الجنائز"
"11340","(۱۱۳۴۰) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیْدِ ، عَنْ سُہَیْلِ بْنِ أَبِی صَالِحٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ أَصْحَابُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَمْشُونَ أَمَامَ الْجِنَازَۃِ حَتَّی إذَا تَبَاعَدُوا عَنْہَا قَامُوا یَنْتَظِرُونَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 11340","","","كتاب الجنائز"
"11341","(۱۱۳۴۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : رَأَیْتُ عَلْقَمَۃَ وَالأَسود یَمْشِیَانِ أَمَامَ الْجِنَازَۃِ۔","","Musannaf Ibn Abi Shaybah 11341","","","كتاب الجنائز"
"11342","(۱۱۳۴۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : رَأَیْتُ سَالِمًا وَالْقَاسِمَ یَمْشِیَانِ أَمَامَ الْجِنَازَۃِ۔","","Musannaf Ibn Abi Shaybah 11342","","","كتاب الجنائز"
"11343","(۱۱۳۴۳) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ مُحَمَّدًا عَنِ الْمَشْیِ أَمَامَ الْجِنَازَۃِ ، فَقَالَ : لاَ أَعْلَمُ بِہِ بَأْسًا ، قَالَ : وَکَانَ الْقَاسِمُ وَسَالِمٌ یَفْعَلاَنِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11343","","","كتاب الجنائز"
"11344","(۱۱۳۴۴) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ فِی الْجِنَازَۃِ أَنْتُمْ مُشَیِّعُونَ لَہَا تَمْشُونَ أَمَامَہَا وَخَلْفَہَا، وَعَنْ یَمِینِہَا وَعَنْ شِمَالِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 11344","","","كتاب الجنائز"
"11345","(۱۱۳۴۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا أَبُو مَالِکٍ ، عَنْ أَبِی حَازِمٍ ، قَالَ مَشَیْتُ مَعَ الْحَسَنِ بْنِ عَلِیٍّ ، وَأَبِی ہُرَیْرَۃَ ، وَابْنِ الزُّبَیْرِ أَمَامَ الْجِنَازَۃِ۔ (بیہقی ۲۷)","Sahih","Musannaf Ibn Abi Shaybah 11345","","","كتاب الجنائز"
"11346","(۱۱۳۴۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَوْفٍ ، عَنْ أَبِی الْمِنْہَالِ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : خَلْفَہَا قَرِیبٌ وَأَمَامَہَا قَرِیبٌ ، وَعَنْ یَسَارِہَا قَرِیبٌ ، وَعَنْ یَمِینِہَا قَرِیبٌ۔","","Musannaf Ibn Abi Shaybah 11346","","","كتاب الجنائز"
"11347","(۱۱۳۴۷) حَدَّثَنَا أَبُوخَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ وَعُبَیْدَ بْنَ عُمَیْرٍ یَمْشِیَانِ أَمَامَ الْجِنَازَۃِ۔","","Musannaf Ibn Abi Shaybah 11347","","","كتاب الجنائز"
"11348","(۱۱۳۴۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ مُحَمَّدِ بْنِ عُبَیْدِ اللہِ ، عَنِ الْعَقَّارِ بْنِ الْمُغِیرَۃِ ، قَالَ : کُنْتُ أَمْشِی خَلْفَ الْجِنَازَۃِ ، فَجَائَ أَبُو ہُرَیْرَۃَ فَوَضَعَ فَقَارِی بَیْنَ إصْبَعَیْہِ ، ثُمَّ دَفَعَنِی حَتَّی تَقَدَّمْت أَمَامَ الْجِنَازَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 11348","","","كتاب الجنائز"
"11349","(۱۱۳۴۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ وَعَبد الرَّحمَّان بن مَہْدِی ، عَنْ سُفْیانَ ، عَنْ عِمْرانَ بْنِ مُسْلِمٍ ، عَنْ سُوَیْدِ بْنِ غَفْلَۃٍ قَالَ : اَلْمَلَائِکَۃُ یَمْشُوْنَ خَلْفَ الْجِنَازَۃِ۔ (عبدالرزاق ۶۲۶۶)","","Musannaf Ibn Abi Shaybah 11349","","","كتاب الجنائز"
"11350","(۱۱۳۵۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ ثَوْرٍ ، عَنْ عَامِرِ بْنِ جشیب وَغَیْرِہِ مِنْ أَہْلِ الشَّامِ قَالُوا : قَالَ أَبُو الدَّرْدَائِ : إن مِنْ تَمَامِ أَجْرِ الْجِنَازَۃِ أَنْ یُشَیِّعَہَا مِنْ أَہْلِہَا وَالْمَشْیُ خَلْفَہَا۔","","Musannaf Ibn Abi Shaybah 11350","","","كتاب الجنائز"
"11351","(۱۱۳۵۱) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، قَالَ : قَالَ ابْنُ مَعْمَرٍ فِی جِنَازَۃِ أَبِی مَیْسَرَۃَ : امْشُوا خَلْفَ جِنَازَۃِ أَبِی مَیْسَرَۃَ ، فَإِنَّہُ کَانَ مشَّائً خَلْفَ الْجَنَائِزِ۔","","Musannaf Ibn Abi Shaybah 11351","","","كتاب الجنائز"
"11352","(۱۱۳۵۲) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ أَبَا قِلاَبَۃَ غَیْرَ مَرَّۃٍ یَجْعَلُ الْجَنَائِزَ عَنْ یَمِینِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11352","","","كتاب الجنائز"
"11353","(۱۱۳۵۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنِ ابْنِ أَبْزَی ، قَالَ : کُنْتُ فِی جِنَازَۃٍ ، وَأَبُو بَکْرٍ ، وَعُمَرُ أَمَامَہَا وَعَلِیٌّ یَمْشِی خَلْفَہَا ، قَالَ فَجِئْت إلَی عَلِیٍّ فَقُلْت لَہُ الْمَشْیُ خَلْفَہَا أَفْضَلُ ، أَوِ الْمَشْیُ أَمَامَہَا ، فَإِنِّی أَرَاک تَمْشِی خَلْفَہَا ، وَہَذَانِ یَمْشِیَانِ أَمَامَہَا ، قَالَ : فَقَالَ لِی : لَقَدْ عَلِمَا أَنَّ الْمَشْیَ خَلْفَہَا أَفْضَلُ مِنْ أَمَامِہَا ، مِثْلَ صَلاَۃِ الْجَمَاعَۃِ عَلَی الْفَذِّ ، وَلَکِنَّہُمَا یَسِیرَانِ مُیَسِّرَانِ یُحِبَّانِ أَنْ یُیَسِّرَا عَلَی النَّاسِ۔ (احمد ۱/۹۷۔ طحاوی ۴۸۳)","Da'if","Musannaf Ibn Abi Shaybah 11353","","","كتاب الجنائز"
"11354","(۱۱۳۵۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَحْیَی الْجَابِرِ ، عَنْ أَبِی مَاجِدٍ ، قَالَ : سَأَلْتُ ابْنَ مَسْعُودٍ ، عَنِ السَّیْرِ بِالْجِنَازَۃِ، قَالَ : السَّیْرُ مَا دُونَ الْخَبَبِ ، الْجِنَازَۃُ مَتْبُوعَۃٌ ، وَلاَ تَتْبَعُ ، لَیْسَ مَعَہَا مَنْ یَقْدُمُہَا۔ (مسندہ ۳۵۶)","Da'if","Musannaf Ibn Abi Shaybah 11354","","","كتاب الجنائز"
"11355","(۱۱۳۵۵) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ ثَوْرٍ ، عَنْ مُرَیْحِ بْنِ مَسْرُوقٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لِکُلِّ أُمَّۃٍ قُرْبَانٌ ، وإِنَّ َقُرْبَانُ ہَذِہِ الأُمَّۃِ مَوْتَاہَا ، فَاجْعَلُوا مَوْتَاکُمْ بَیْنَ أَیْدِیکُمْ۔","","Musannaf Ibn Abi Shaybah 11355","","","كتاب الجنائز"
"11356","(۱۱۳۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ثَوْرٍ ، عَنْ أَبِی النُّعْمَانِ ، قَالَ : سَمِعْتُ أَبَا أُمَامَۃَ یَقُولُ : لأَنْ لاَ أَخْرُجْ مَعَہَا أَحَبُّ إلَیَّ مِنْ أَنْ أَمْشِیَ أَمَامَہَا۔","","Musannaf Ibn Abi Shaybah 11356","","","كتاب الجنائز"
"11357","(۱۱۳۵۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی السَّلِیلِ ، عَنْ عَبْدِ اللہِ بْنِ رَبَاحٍ ، قَالَ : لِلْمَاشِی فِی الْجِنَازَۃِ قِیرَاطَانِ وَلِلرَّاکِبِ قِیرَاطٌ۔","","Musannaf Ibn Abi Shaybah 11357","","","كتاب الجنائز"
"11358","(۱۱۳۵۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَبَّاسٍ الْہَمْدَانِیِّ ، عَنِ ابْنِ معقل ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ عَلَی بَغْلٍ رَاکِبًا أَمَامَ الْجِنَازَۃِ۔","","Musannaf Ibn Abi Shaybah 11358","","","كتاب الجنائز"
"11359","(۱۱۳۵۹) حَدَّثَنَا وَکِیعٌ ، عَنِ عُیَیْنَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ أَبَا بَکْرَۃَ فِی جِنَازَۃِ عَبْدِ الرَّحْمَنِ بْنِ سَمُرَۃَ عَلَی بَغْلَۃٍ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 11359","","","كتاب الجنائز"
"11360","(۱۱۳۶۰) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، عَنْ سِمَاکٍ ، عَنْ جَابِرٍ ، قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی جِنَازَۃِ ابْنِ الدِّحْدَاحِ وَہُوَ رَاکِبٌ عَلَی فَرَسٍ وَہُوَ یَتَوَقَّصُ بِہِ وَنَحْنُ حَوْلَہُ۔n(مسلم ۶۶۴۔ ابوداؤد ۳۱۷۰)","Hasan","Musannaf Ibn Abi Shaybah 11360","","","كتاب الجنائز"
"11361","(۱۱۳۶۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ جُبَارٍ الطَّائِیِّ ، قَالَ : رَأَیْتُ ابْنَ عَبَّاسٍ فِی جِنَازَۃٍ أُم مصعب علی أتان لہ قمراء ۔","Da'if","Musannaf Ibn Abi Shaybah 11361","","","كتاب الجنائز"
"11362","(۱۱۳۶۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ عَنْ أَبِی إِسْحَاقَ ، عَنْ جُبَارٍ الطَّائِیِّ ، قَالَ : رَأَیْتُ ابْنَ عَبَّاسٍ فِی جِنَازَۃٍ ، فَذَکَرَ نَحْوَہ۔","Da'if","Musannaf Ibn Abi Shaybah 11362","","","كتاب الجنائز"
"11363","(۱۱۳۶۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، وَأَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، قَالَ : رَأَیْتُ شُرَیْحًا عَلَی بَغْلَۃٍ یَسِیرُ أَمَامَ الْجِنَازَۃِ ، وقَالَ أَبُو مُعَاوِیَۃَ : عَلَی بَغْلَۃٍ بَیْضَائَ ، یَسِیرُ خَلْفَ الْجِنَازَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11363","","","كتاب الجنائز"
"11364","(۱۱۳۶۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ نُعَیْمٍ ، قَالَ : رَأَیْتُ أَبَا وَائِلٍ فِی جِنَازَۃِ خَیْثَمَۃَ رَاکِبًا عَلَی حِمَارٍ یَقُولُ وَاحَزْنََاہ ، أَوْ کَلِمَۃً نَحْوَہَا۔","","Musannaf Ibn Abi Shaybah 11364","","","كتاب الجنائز"
"11365","(۱۱۳۶۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ خَالِدِ بْنِ دِینَارٍ ، قَالَ : قَالَ : رَأَیْتُ عَطَائً یَسِیرُ أَمَامَ الْجِنَازَۃِ رَاکِبًا۔","No Data Available","Musannaf Ibn Abi Shaybah 11365","","","كتاب الجنائز"
"11366","(۱۱۳۶۶) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، قَالَ : رَأَیْتُ الْحَسَنَ أَمَامَ الْجِنَازَۃِ رَاکِبًا۔","No Data Available","Musannaf Ibn Abi Shaybah 11366","","","كتاب الجنائز"
"11367","(۱۱۳۶۷) حَدَّثَنَا وَکِیعٌ، عَنْ مَالِکِ بْنِ مِغْوَلٍ، عَنْ أَبِی إِسْحَاقَ، قَالَ: رَأَیْتُ شُرَیْحًا رَاکِبًا فِی جِنَازَۃِ أَبِی مَیْسَرَۃَ۔","","Musannaf Ibn Abi Shaybah 11367","","","كتاب الجنائز"
"11368","(۱۱۳۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِید بن عُبَیْدِ اللہِ الثَّقَفِی ، عَنْ زِیَادِ بْنِ جُبَیْرِ بْنِ حَیَّۃَ الثَّقَفِیِّ ، عَنْ أَبِیہِ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الرَّاکِبُ خَلْفَ الْجِنَازَۃِ ، وَالْمَاشِی حَیْثُ شَائَ مِنْہَا وَالطِّفْلُ یُصَلَّی عَلَیْہِ۔ (احمد ۴/۲۴۸۔ ابوداؤد ۳۱۷۲)","","Musannaf Ibn Abi Shaybah 11368","","","كتاب الجنائز"
"11369","(۱۱۳۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی ہَمَّامٍ السَّکُونِیِّ وَہُوَ الْوَلِیدُ بْنُ قَیْسٍ ، عَنْ أَبِی ہبیرۃ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أُتِیَ بِدَابَّۃٍ وَہُوَ فِی جِنَازَۃٍ فَلَمْ یَرْکَبْ ، فَلَمَّا انْصَرَفَ رَکِبَ۔ (ابوداؤد ۳۱۶۹۔ حاکم ۳۵۵)","","Musannaf Ibn Abi Shaybah 11369","","","كتاب الجنائز"
"11370","(۱۱۳۷۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : قُلْتُ لِعَلْقَمَۃَ أَیُکْرَہُ الْمَشْیُ خَلْفَ الْجِنَازَۃِ ؟ قَالَ : لاَ إنَّمَا یُکْرَہُ السَّیْرُ أَمَامَہَا۔","","Musannaf Ibn Abi Shaybah 11370","","","كتاب الجنائز"
"11371","(۱۱۳۷۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ أَبِی رَوَّادٍ ، قَالَ : حدَّثَنَا أَبُو سَعْدٍ ، عَنْ زَیْدِ بْنِ أَرَقْمَ ، قَالَ : لَوْ یَعْلَمُ رِجَالٌ یَرْکَبُونَ فِی الْجِنَازَۃِ مَا لِرِجَالٍ یَمْشُونَ مَا رَکِبُوا۔","Hasan","Musannaf Ibn Abi Shaybah 11371","","","كتاب الجنائز"
"11372","(۱۱۳۷۲) حَدَّثَنَا وَکِیعٌ ، عَنْ ثَوْرٍ ، عَنْ رَاشِدِ بْنِ سَعْدٍ ، عَنْ ثَوْبَانَ ، أَنَّہُ رَأَی رَجُلاً رَاکِبًا فِی جِنَازَۃٍ فَأَخَذَ بِلِجَامِ دَابَّتِہِ فَجَعَلَ یَکْبَحُہَا ، وَقَالَ : تَرْکَبُ وَعِبَادُ اللہِ یَمْشُونَ۔","Sahih","Musannaf Ibn Abi Shaybah 11372","","","كتاب الجنائز"
"11373","(۱۱۳۷۳) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَسِیرَ الرَّاکِبُ أَمَامَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 11373","","","كتاب الجنائز"
"11374","(۱۱۳۷۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الرَّاکِبُ فِی الْجِنَازَۃِ کَالْجَالِسِ فِی بَیْتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 11374","","","كتاب الجنائز"
"11375","(۱۱۳۷۵) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ الْحَسَنُ ، وَابْنُ سِیرِینَ لاَ یَسِیرَانِ أَمَامَ الْجِنَازَۃِ۔","","Musannaf Ibn Abi Shaybah 11375","","","كتاب الجنائز"
"11376","(۱۱۳۷۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الرَّاکِبُ فِی الْجِنَازَۃِ کَالْجَالِسِ فِی بَیْتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 11376","","","كتاب الجنائز"
"11377","(۱۱۳۷۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ لَیث ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِی مُوسَی قَالَ : مُرَّ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِجِنَازَۃٍ وَہِیَ تُمْحَضُ کَمَا یُمَخَضُ الزَّقَّ ، فَقَالَ : عَلَیْکُمْ بِالْقَصْدِ فِی جَنَائِزِکُمْ۔n(احمد ۴/۴۰۶۔ ابن ماجہ ۱۴۷۹)","Da'if","Musannaf Ibn Abi Shaybah 11377","","","كتاب الجنائز"
"11378","(۱۱۳۷۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أَسْرِعُوا بِالْجِنَازَۃِ ، فَإِنْ تَکُ صَالِحَۃً فَخَیْرٌ تُقَدِّمُونَہَا إلَیْہِ وَإِنْ تَکُ غَیْرَ ذَلِکَ فَشَرٌّ تَضَعُونَہُ عَنْ رِقَابِکُمْ۔ (بخاری ۱۳۱۵۔ مسلم ۶۵۱)","Sahih","Musannaf Ibn Abi Shaybah 11378","","","كتاب الجنائز"
"11379","(۱۱۳۷۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عُیَیْنَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنْ أَبِی بَکْرَۃَ ، قَالَ : لَقَدْ رَأَیْتُ وَأَنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَکَادُ أَنْ یَرْمُلَ بِالْجِنَازَۃِ رَمَلاً۔ (ابوداؤد ۳۱۷۵۔ احمد ۵/۳۷)","Sahih","Musannaf Ibn Abi Shaybah 11379","","","كتاب الجنائز"
"11380","(۱۱۳۸۰) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَنِ الْحَسَنِ ، قَالَ : أَوْصَی عِمْرَانُ بْنُ حصَیْنٍ ، قَالَ: إذَا أَنَا مِتّ فَأَسْرِعُوا ، وَلاَ تُہَوِّدُوا کَمَا یُہَوِّدُ الْیَہُودُ وَالنَّصَارَی۔","Sahih","Musannaf Ibn Abi Shaybah 11380","","","كتاب الجنائز"
"11381","(۱۱۳۸۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، قَالَ : حدَّثَنِی یَحْیَی بْنُ أَبِی رَاشِدٍ النَّصْرِیُّ ، قَالَ : قَالَ عُمَرُ حِینَ حَضَرَتْہُ الْوَفَاۃُ لاِبْنِہِ إذَا خَرَجْتُمْ فَأَسْرِعُوا بِی الْمَشْیَ۔ (ابن سعد ۳۵۸)","","Musannaf Ibn Abi Shaybah 11381","","","كتاب الجنائز"
"11382","(۱۱۳۸۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ الْجَعْدِ ، عَنْ إبْرَاہِیمَ بْنِ نَافِعٍ ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: أَسْرِعُوا بِی إلَی رَبِّی۔","No Data Available","Musannaf Ibn Abi Shaybah 11382","","","كتاب الجنائز"
"11383","(۱۱۳۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ زَیدٍ العَمِّی ، عَنْ أَبِی الصِّدِّیقِ النَّاجِی ، قَالَ : إِنْ کَانَ الرَّجُلُ لَیَنْقَطِعُ شِسْعُہُ فِی الْجِنَازَۃِ فَمَا یُدْرِکُہَا ، أَوْ مَا یَکَادُ أَنْ یُدْرِکَہَا۔","","Musannaf Ibn Abi Shaybah 11383","","","كتاب الجنائز"
"11384","(۱۱۳۸۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ، عَنْ إبْرَاہِیمَ، عن علقمۃ قَالَ: إذَا أَنَا مِتُّ فَأَسْرِعُوا بِی الْمَشْیَ۔","","Musannaf Ibn Abi Shaybah 11384","","","كتاب الجنائز"
"11385","(۱۱۳۸۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ الزِّبْرِقَانِ ، قَالَ : سَمِعْتُ أَبَا وَائِلٍ یَقُولُ عِنْدَ مَوْتِہِ إذَا أَنَا مِتّ فَأَسْرِعُوا بِی الْمَشْیَ۔","","Musannaf Ibn Abi Shaybah 11385","","","كتاب الجنائز"
"11386","(۱۱۳۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ، عَنْ ثُوَیْرٍ، عَنْ أَبِی جَعْفَرٍ، أَنَّ عَلِیَّ بْنَ حُسَیْنٍ أَوْصَی أَسْرِعُوا بِی الْمَشْیَ۔","","Musannaf Ibn Abi Shaybah 11386","","","كتاب الجنائز"
"11387","(۱۱۳۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَارَۃَ بْنِ زَاذَانَ ، عَنْ مَکْحُولٍ الأَزْدِی ، قَالَ : سَمِعَ ابن عمر رَجُلاً یَقُول : ارفُقُوا بِہَا - رَحِمَکُم اللہ - فقَال : ہَوَّدوا، لَتُسْرِعُنَّ بہا ، أَو لأَرجِعَنَّ۔","","Musannaf Ibn Abi Shaybah 11387","","","كتاب الجنائز"
"11388","(۱۱۳۸۸) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ: کَانَ یُقَالُ انْبَسِطُوا بِجَنَائِزِکُمْ ، وَلاَ تَدِبُّوا بِہَا دَبَّ الْیَہُودِ۔","","Musannaf Ibn Abi Shaybah 11388","","","كتاب الجنائز"
"11389","(۱۱۳۸۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ أَنَّہُمَا کَانَا یُعْجِبُہُمَا أَنْ یُسْرَعَ بِالْجِنَازَۃِ۔","","Musannaf Ibn Abi Shaybah 11389","","","كتاب الجنائز"
"11390","(۱۱۳۹۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنِ أبی المُعْتَمِر ، قَالَ : کُنَّا فِی جِنَازَۃٍ ، فَکَانَ الْحَسَنُ إذَا رَأَی مِنْہُمْ إبْطَائً ، قَالَ : امْضُوا لاَ تَحْبِسُُوا مَیَّتَکُمْ۔","","Musannaf Ibn Abi Shaybah 11390","","","كتاب الجنائز"
"11391","(۱۱۳۹۱) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ عَبْدِ اللہِ بْنِ الْمُخْتَارِ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، قَالَ حَدَّثَنَا أَبُو کَرْبٍ ، أَوْ أَبُو حَرْبٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرو ، أَنَّہُ أَخْبَرَہُ ، أَنَّ أَبَاہُ أَوْصَاہُ ، قَالَ : إذَا أَنْتَ حَمَلْتنِی عَلَی السَّرِیرِ فَامْشِ بِی مَشْیًا بَیْنَ الْمَشْیَیْنِ ، وَکُنْ خَلْفَ الْجِنَازَۃِ فَإِنَّ مُقَدَّمَہَا لِلْمَلاَئِکَۃِ ، وَخَلْفَہَا لِبَنِی آدَمَ۔","Sahih","Musannaf Ibn Abi Shaybah 11391","","","كتاب الجنائز"
"11392","(۱۱۳۹۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَمَّادِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : لاَ تَدِبُّوا بِالْجِنَازَۃِ دَبِیبَ النَّصَارَی۔","","Musannaf Ibn Abi Shaybah 11392","","","كتاب الجنائز"
"11393","(۱۱۳۹۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یَعْلَی ، عَنْ عَطَائٍ ، عَنْ عَلِیٍّ الأَزْدِیِّ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ فِی جِنَازَۃٍ فَحَمَلُوا بِجَوَانِبِ السَّرِیرِ الأَرْبَعِ فَبَدَأَ بِالْمَیَامِنِ ، ثُمَّ تَنَحَّی عَنْہَا ، فَکَانَ مِنْہَا بِمُزْجِرِ کَلْبٍ۔","","Musannaf Ibn Abi Shaybah 11393","","","كتاب الجنائز"
"11394","(۱۱۳۹۴) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ تُبَالِی بِأَیِّ جَوَانِبِ السَّرِیرِ بَدَأْت۔","","Musannaf Ibn Abi Shaybah 11394","","","كتاب الجنائز"
"11395","(۱۱۳۹۵) حَدَّثَنَا حُمَیْدٌ ، عَنْ مِنْدَلٍ ، عَنْ جَعْفَرِ بْنِ أَبِی الْمُغِیرَۃِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إنِ اسْتَطَعْت فَابْدَأْ بِالْقَائِمَۃِ الَّتِی تَلِی یَدَہ الْیُمْنَی ، ثُمَّ طِفْ بِالسَّرِیرِ ، وَإلاَ فَکُنْ مِنْہُ قَرِیبًا۔","Da'if","Musannaf Ibn Abi Shaybah 11395","","","كتاب الجنائز"
"11396","(۱۱۳۹۶) حَدَّثَنَا مَالِکُ بْنُ إسْمَاعِیلَ ، عَنْ أَبِی عَوَانَۃَ ، عَنْ جَعْفَرِ بْنِ إیَاسٍ ، قَالَ : رَأَیْتُ الْحَسَنَ تَبِعَ جِنَازَۃً فَحَمَلَ فَوَضَعَ السَّرِیرَ عَلَی شِقِّہِ الأَیْسَرِ فَحُوِّلَ فَحَمَلَ مُقَدَّمَ السَّرِیرِ عَلَی شِقِّہِ الأَیْمَنِ ، ثُمَّ تَأَخَرَ فَوَضَعَ مُؤَخَّرَ السَّرِیرِ عَلَی شِقِّہِ الأَیْمَنِ ، ثُمَّ تَحَوَّلَ فَوَضَعَ مُؤَخَّرَ السَّرِیرِ عَلَی شِقِّہِ الأَیْسَرِ ، ثُمَّ خَلَّی عَنْہَا۔","","Musannaf Ibn Abi Shaybah 11396","","","كتاب الجنائز"
"11397","(۱۱۳۹۷) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنْ عُبَیْدِ بْنِ نِسْطَاسٍ ، قَالَ : کُنَّا مَعَ أَبِی عُبَیْدَۃَ بْنِ عَبْدِ اللہِ فِی جِنَازَۃٍ ، فَقَالَ : قَالَ عَبْدُ اللہِ : إذَا کَانَ أَحَدُکُمْ فِی جِنَازَۃٍ فَلْیَحْمِلْ بِجَوَانِبِ السَّرِیرِ کُلِّہِ ، فَإِنَّہُ مِنَ السُّنَّۃِ ، ثم لِیَتَطَوَّعَ ، أَو لِیَدَعَ۔","","Musannaf Ibn Abi Shaybah 11397","","","كتاب الجنائز"
"11398","(۱۱۳۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ، عَنْ أَبِی الْمُہَزِّمِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : مَنْ حَمَلَ الْجِنَازَۃَ ثَلاَثًا فَقَدْ قَضَی مَا عَلَیْہِ مِنْ حَقِّہَا۔","Da'if","Musannaf Ibn Abi Shaybah 11398","","","كتاب الجنائز"
"11399","(۱۱۳۹۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ ثَوْرٍ ، عَنْ عَامِرِ بْنِ جَشِیبٍ وَغَیْرِہِ مِنْ أَہْلِ الشَّامِ قَالُوا : قَالَ أَبُو الدَّرْدَائِ: مِنْ تَمَامِ أَجْرِ الْجِنَازَۃِ أَنْ یُشَیِّعَہَا مِنْ أَہْلِہَا وَأَنْ یَحْمِلَ بِأَرْکَانِہَا الأَرْبَعِ وَأَنْ یَحْثُوَ فِی الْقَبْرِ۔","","Musannaf Ibn Abi Shaybah 11399","","","كتاب الجنائز"
"11400","(۱۱۴۰۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ زُبَیْدٍ ، عَنْ مَسْرُوقٍ ، قَالَ : خَرَجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَعَ جِنَازَۃٍ وَمَعَہَا امْرَأَۃٌ فَلَمْ یَبْرَحْ حَتَّی تَوَارَتْ بِالْبُیُوتِ۔","","Musannaf Ibn Abi Shaybah 11400","","","كتاب الجنائز"
"11401","(۱۱۴۰۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ عَنْ فُضَیْلٍ ، عَنِ ابْنِ مُغَفَّلٍ ، قَالَ : قَالَ عُمَرُ : لاَ تَتْبَعْنِی امْرَأَۃٌ۔","","Musannaf Ibn Abi Shaybah 11401","","","كتاب الجنائز"
"11402","(۱۱۴۰۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا إذَا أَخْرَجُوا الْجِنَازَۃَ أَغْلَقُوا الْبَابَ عَلَی النِّسَائِ۔","","Musannaf Ibn Abi Shaybah 11402","","","كتاب الجنائز"
"11403","(۱۱۴۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مُثَنَّی بْنِ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، قَالَ : کَانَ مَسْرُوقٌ لاَ یُصَلِّی عَلَی جِنَازَۃٍ مَعَہَا امْرَأَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 11403","","","كتاب الجنائز"
"11404","(۱۱۴۰۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنْ مُوسَی بْنِ عَبْدِ اللہِ بْنِ یَزِیدٍ ، قَالَ : کَانَ أَبِی إذَا کَانَتْ دَارٌ فِیہَا جِنَازَۃٌ أَمَرَ بِالْبَابِ فَفُتِحَ فَدَخَلَ الْعُوَّادُ فَإِذَا خُرِجَ بِالْجِنَازَۃِ أَمَرَ بِبَابِ الدَّارِ فَأُغْلِقَ ، فَلاَ تَتْبَعُہَا امْرَأَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 11404","","","كتاب الجنائز"
"11405","(۱۱۴۰۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : نُہِینَا أَنْ نَتْبَعَ جِنَازَۃً مَعَہَا رَانَّۃ۔n(ابن ماجہ ۱۵۸۳۔ طبرانی ۱۲)","Da'if","Musannaf Ibn Abi Shaybah 11405","","","كتاب الجنائز"
"11406","(۱۱۴۰۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ ، قَالَ : کَانَا یَکْرَہَانِ أَنْ تَتْبَعَ النِّسَائُ الْجَنَائِزَ۔","","Musannaf Ibn Abi Shaybah 11406","","","كتاب الجنائز"
"11407","(۱۱۴۰۷) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا الْحَسَنُ بْنُ صَالِحٍ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَنْ سُوَیْد، قَالَ : لاَ یَنْبَغِی لِلْمَرْأَۃِ أَنْ تَخْرُجَ مِنْ بَابِ الدَّارِ مَعَ الْجِنَازَۃِ۔","","Musannaf Ibn Abi Shaybah 11407","","","كتاب الجنائز"
"11408","(۱۱۴۰۸) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنَا مُعَاوِیَۃُ بْنُ صَالِحٍ ، قَالَ : حَدَّثَنَا عَمْرُو بْنُ قَیْسٍ ، قَالَ : کُنَّا فِی جِنَازَۃٍ وَفِیہَا أَبُو أُمَامَۃَ فَرَأَی نِسْوَۃً فِی الْجِنَازَۃِ فَطَرَدہُنَّ۔","Sahih","Musannaf Ibn Abi Shaybah 11408","","","كتاب الجنائز"
"11409","(۱۱۴۰۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ ، عَنْ مَسْرُوقٍ ، قَالَ : رَأَیْتُہ یَحْثِی التُّرَابَ فِی وُجُوہِ النِّسَائِ فِی الْجِنَازَۃِ وَیَقُولُ لَہُنَّ : ارْجِعْنَ ، فَإِنْ رَجَعْنَ مَضَی مَعَ الْجِنَازَۃِ ، وَإِلاَّ رَجَعَ وَتَرَکَہَا۔","","Musannaf Ibn Abi Shaybah 11409","","","كتاب الجنائز"
"11410","(۱۱۴۱۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ حَفْصَۃَ ، عَنْ أُمِّ عَطِیَّۃَ ، قَالَ : نُہِینَا عَنِ اتِّبَاعِ الْجَنَائِزِ ، وَلَمْ یُعْزَمْ عَلَیْنَا۔ (مسلم ۶۴۶۔ ابوداؤد ۳۱۵۹)","Sahih","Musannaf Ibn Abi Shaybah 11410","","","كتاب الجنائز"
"11411","(۱۱۴۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ وَہْبِ بْنِ کَیْسَانَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو بْنِ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ فِی جِنَازَۃٍ فَرَأَی عُمَرُ امْرَأَۃً فَصَاحَ بِہَا ، فَقَالَ لَہُ : رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : دَعْہَا یَا عُمَرُ فَإِنَّ الْعَیْنَ دَامِعَۃٌ وَالنَّفْسَ مُصَابَۃٌ وَالْعَہْدَ قَرِیبٌ۔ (احمد ۲/۴۴۴۔ حاکم ۳۸۱)","Da'if","Musannaf Ibn Abi Shaybah 11411","","","كتاب الجنائز"
"11412","(۱۱۴۱۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ جُبَارِ الطَّائِیِّ ، قَالَ : شَہِدْت جِنَازَۃَ أُمِّ مُصْعَبِ بْنِ الزُّبَیْرِ وَفِیہَا ابْنُ عَبَّاسٍ عَلَی أَتَانٍ لَہُ قمراء یقاد وَعَبْدَ اللہِ بْنَ عُمَرَ ، وَابْنُ عَمْرٍو ، قَالَ : فَسَمِعُوا أَصْوَاتَ صَوَائِحَ ، قَالَ : قُلْتُ یَا ابْنَ عَبَّاسٍ یُصْنَعُ ہَذَا وَأَنْتَ ہَاہُنَا ؟ قَالَ : دَعْنَا مِنْک یَا جُبَارِ ، فَإِنَّ اللَّہَ أَضْحَکَ وَأَبْکَی۔","Da'if","Musannaf Ibn Abi Shaybah 11412","","","كتاب الجنائز"
"11413","(۱۱۴۱۳) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ خَالِدِ بْنِ دِینَارٍ ، عَنِ الْحَسَنِ ، قَالَ : خَرَجَ فِی جِنَازَۃٍ فَجَعَلُوا یَصِیحُونَ عَلَیْہَا فَرَجَعَ ثَابِتٌ ، فَقَالَ لَہُ : الْحَسَنُ تَدَعُ حَقًّا لِبَاطِلٍ ، قَالَ : فَمَضَی۔","","Musannaf Ibn Abi Shaybah 11413","","","كتاب الجنائز"
"11414","(۱۱۴۱۴) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، قَالَ : رَأَیْتُ سَالِمًا وَالْقَاسِمَ یَمْشِیَانِ أَمَامَ الْجِنَازَۃِ وَالنِّسَائَ خَلْفَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 11414","","","كتاب الجنائز"
"11415","(۱۱۴۱۵) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ مَحَارِبِ بْنِ دِثَارٍ ، قَالَ : أَوْصَتْ أمُّ سَلَمَۃَ أَنْ یُصَلِّیَ عَلَیْہَا سَعِیدُ بْنُ زَیْدٍ۔","Da'if","Musannaf Ibn Abi Shaybah 11415","","","كتاب الجنائز"
"11416","(۱۱۴۱۶) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : أَوْصَی یُونُسُ بْنُ جُبَیْرٍ أَنْ یُصَلِّیَ عَلَیْہِ أَنَسُ بْنُ مَالِکٍ۔","Sahih","Musannaf Ibn Abi Shaybah 11416","","","كتاب الجنائز"
"11417","(۱۱۴۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی حَصِین : أَنَّ عَبِیدَۃََ أَوْصَی أَنْ یُصَلِّیَ عَلَیْہِ الأَسوَدَ۔","","Musannaf Ibn Abi Shaybah 11417","","","كتاب الجنائز"
"11418","(۱۱۴۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، أَنَّ أَبَا مَیْسَرَۃَ أَوْصَی أَنْ یُصَلِّیَ عَلَیْہِ قَاضِی الْمُسْلِمِینَ شُرَیْحٌ۔","","Musannaf Ibn Abi Shaybah 11418","","","كتاب الجنائز"
"11419","(۱۱۴۱۹) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، قَالَ : حدَّثَنَا أَبُو إِسْحَاقَ ، قَالَ : أَوْصَی الْحَارِثُ أَنْ یُصَلِّیَ عَلَیْہِ عَبْدُ اللہِ بْنُ یَزِیدَ۔","Sahih","Musannaf Ibn Abi Shaybah 11419","","","كتاب الجنائز"
"11420","(۱۱۴۲۰) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : مَا عَلِمْت أَنَّ أَحَدًا أَحَقُّ بِالصَّلاَۃِ عَلَی أَحَدٍ إِلاَّ أَنْ یُوصِیَ الْمَیِّتُ ، فَإِنْ لَمْ یُوصِ الْمَیِّتُ صَلَّی عَلَیْہِ أَفْضَلُ أَہْلِ بَیْتِہِ۔","","Musannaf Ibn Abi Shaybah 11420","","","كتاب الجنائز"
"11421","(۱۱۴۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ مُحَارِبٍ ، أَنَّ أُمَّ سَلَمَۃَ أَوْصَتْ أَنْ یُصَلِّیَ عَلَیْہَا سِوَی الإِمَامِ۔","","Musannaf Ibn Abi Shaybah 11421","","","كتاب الجنائز"
"11422","(۱۱۴۲۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عبد العزیز بن عُبَیْدِ اللہِ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ، قَالَ : الإِمَامُ أَحَقُّ مَنْ صَلَّی عَلَی الجِنَازَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 11422","","","كتاب الجنائز"
"11423","(۱۱۴۲۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، قَالَ : ذَہَبْت مَعَ إبْرَاہِیمَ إلَی جِنَازَۃٍ ہُوَ وَلِیُّہَا ، فَأَرْسَلَ إلَی إمَامِ الْحَیِّ فَصَلَّی عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 11423","","","كتاب الجنائز"
"11424","(۱۱۴۲۴) حَدَّثَنَا حَفْصٌ ، عَنْ عَمِّہِ غَنَّامِ بْنِ طَلْقٍ ، قَالَ : شَہِدَ أَبُو بُرْدَۃَ مَوْلاَۃً لَہُ فَأَمَرَ إمَامَ الْحَیِّ فَتَقَدَّمَ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 11424","","","كتاب الجنائز"
"11425","(۱۱۴۲۵) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ مُحَمَّدِ بْنِ السَّائِبِ ، قَالَ : تُوُفِّیَتِ ابْنَۃُ إبْرَاہِیمَ التَّیْمِیِّ فَشَہَّدَ إبْرَاہِیمُ النَّخْعِِی جَنَازَتہا ، فَأمَرَ إبْرَاہِیمُ النَّخْعِِی إمَامَ التَّیْمِ أَنْ یُصَلِّیَ عَلَیْہَا ، وَقَالَ : ہُوَ السُّنَّۃُ۔","","Musannaf Ibn Abi Shaybah 11425","","","كتاب الجنائز"
"11426","(۱۱۴۲۶) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مُسْلِمٍ ، قَالَ : رَأَیْتُ عَبْدَ الرَّحْمَن بْنَ أَبِی لَیْلَی قَدَّمَ عَبْدَ اللہِ بْنَ حَکِیمٍ عَلَی أُمِّہِ وَکَانَ إمَامَ الْحَیِّ۔","No Data Available","Musannaf Ibn Abi Shaybah 11426","","","كتاب الجنائز"
"11427","(۱۱۴۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : الإِمَامُ أَحَقُّ۔","","Musannaf Ibn Abi Shaybah 11427","","","كتاب الجنائز"
"11428","(۱۱۴۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ جَرِیرٍ ، قَالَ : یَتَقَدَّمُ الإِمَامُ۔","Da'if","Musannaf Ibn Abi Shaybah 11428","","","كتاب الجنائز"
"11429","(۱۱۴۲۹) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَد ، أَنَّہُ کَانَ یُقَدَّمُ عَلَی الْجَنَائِزِ لِسُنَّۃٍ۔","","Musannaf Ibn Abi Shaybah 11429","","","كتاب الجنائز"
"11430","(۱۱۴۳۰) حَدَّثَنَا حُسَین بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کُنْتُ أُقَدِّمُ الأَسْوَد عَلَی الْجَنَائِزِ، قَالَ إبْرَاہِیمُ : وَکَانَ إمَامَہُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 11430","","","كتاب الجنائز"
"11431","(۱۱۴۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو قَالَ : مَاتَ ابْنٌ لأَبِی مَعْشَرٍ فَلَمْ یَحْضُرَ الإِمَامُ ، فَقَالَ : لِیَتقَدَّمْ مَنْ کَانَ یُصَلِّی بَعْدَ الإِمَامِ۔","","Musannaf Ibn Abi Shaybah 11431","","","كتاب الجنائز"
"11432","(۱۱۴۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ سَالِمٍ وَالْقَاسِمِ وَطَاوُسٍ ، وَمُجَاہِدٍ ، وَعَطَائٍ أَنَّہُمْ کَانُوا یُقَدِّمُونَ الإِمَامَ عَلَی الْجِنَازَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11432","","","كتاب الجنائز"
"11433","(۱۱۴۳۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَمِّہِ ، قَالَ شَہِدَت طَلْحَۃَ وَزُبَیْدًا وَقَدْ مَاتَتِ امْرَأَۃٌ ذَاتُ قَرَابَۃٍ لَہُمْ فَقَدَّمُوا إمَامَ الْحَیِّ۔","","Musannaf Ibn Abi Shaybah 11433","","","كتاب الجنائز"
"11434","(۱۱۴۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یُقَدِّمُونَ الأَئِمَّۃَ عَلَی جَنَائِزِہِمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 11434","","","كتاب الجنائز"
"11435","(۱۱۴۳۵) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، قَالَ یُقَدِّمُ الْوَلِیُّ عَلَی الْجِنَازَۃِ مَنْ أَحَبَّ۔","","Musannaf Ibn Abi Shaybah 11435","","","كتاب الجنائز"
"11436","(۱۱۴۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَد وَعَلْقَمَۃَ قَالاَ : یَتَقَدَّمُ الإِمَامُ۔","","Musannaf Ibn Abi Shaybah 11436","","","كتاب الجنائز"
"11437","(۱۱۴۳۷) حَدَّثَنَا شَرِیکٌ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، أَنَّ عَلْقَمَۃَ کَانَ یُصَلِّی عَلَی جَنَائِزِ الْحَیِّ وَلَیْسَ بِإِمَامٍ۔","","Musannaf Ibn Abi Shaybah 11437","","","كتاب الجنائز"
"11438","(۱۱۴۳۸) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ أُنَیْسٍ بْنِ أَبِی یَحْیَی ، عَنْ أَبِیہِ ، أَنَّ جِنَازَۃً وُضِعَتْ فَقَامَ ابْنُ عُمَرَ قَائِمًا، فَقَالَ : أَیْنَ وَلِیُّ ہَذِہِ الْجِنَازَۃِ لِیُصَلِّیَ عَلَیْہَا قَبْلَ أَنْ یَطْلُعَ قَرْنُ الشَّمْسِ؟۔","Hasan","Musannaf Ibn Abi Shaybah 11438","","","كتاب الجنائز"
"11439","(۱۱۴۳۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَنْبَسَۃَ الْوَزَّانِ قَالَ : حدَّثَنَا أَبُو لُبَابَۃَ ، قَالَ صَلَّیْت مَعَ أَبِی ہُرَیْرَۃَ عَلَی جِنَازَۃٍ وَالشَّمْسُ عَلَی أَطْرَافِ الْجُدُرِ۔","Sahih","Musannaf Ibn Abi Shaybah 11439","","","كتاب الجنائز"
"11440","(۱۱۴۴۰) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی حَصِینٍ ، أَنَّ عَبِیْدَۃَ أَوْصَی أَنْ یُصَلِّیَ عَلَیْہِ الأَسْوَد ، قَالَ : فَجَاؤُوا بِہِ قَبْلَ أَنْ تَغْرُبَ الشَّمْسُ ، قَالَ فَصَلَّی عَلَیْہِ قَبْلَ غُرُوبِ الشَّمْسِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11440","","","كتاب الجنائز"
"11441","(۱۱۴۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ مَیْمُونٍ ، قَالَ : کَانَ ابْنُ عُمَرَ یَکْرَہُ الصَّلاَۃَ عَلَی الْجِنَازَۃِ إذَا طَفَلَتِ الشَّمْسُ وَحِینَ تَغِیبُ۔","Sahih","Musannaf Ibn Abi Shaybah 11441","","","كتاب الجنائز"
"11442","(۱۱۴۴۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرٍوَ قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ ہَلْ تُدْفَنُ الْجِنَازَۃُ عِنْدَ طُلُوعِ الشَّمْسِ أَوَ عِنْدَ غُرُوبِہَا ، أَوْ غُرُوبِ بَعْضِہَا ، قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 11442","","","كتاب الجنائز"
"11443","(۱۱۴۴۳) حَدَّثَنَا مَعَنْ، عَنِ ابْنِ أَبِی ذِئْبٍ، عَنِ الزُّہْرِیِّ، قَالَ: تُکْرَہُ الصَّلاَۃُ عَلَی الْجِنَازَۃِ بَعْدَ الْعَصْرِ وَبَعْدَ الْفَجْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11443","","","كتاب الجنائز"
"11444","(۱۱۴۴۴) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یُحِبُّ أَنْ یُصَلِّیَ عَلَی الْجِنَازَۃِ ، ثُمَّ یُصَلِّیَ الْعَصْرَ وَکَانَ یَکْرَہُ أَنْ یُصَلِّیَ عَلَی الْجِنَازَۃِ بَعْدَ الْعَصْرِ۔","","Musannaf Ibn Abi Shaybah 11444","","","كتاب الجنائز"
"11445","(۱۱۴۴۵) حدَّثَنَا غُنْدَرٌ ، عَنْ عُثْمَانَ بْنِ غِیَاثٍ ، قَالَ : سَأَلتُ الْحَسَنَ عَنِ الصَّلاۃِ عَلَی الْجِنَازَۃِ بَعْدَ الْعَصْرِ ، فَقَالَ: نَعَمْ إذَا کَانَتْ نَقِیَّۃً بَیْضَائَ فَإِذَا أَزِفَتْ لِلإِیَابِ فَلاَ تُصَلِّ عَلَیْہَا حَتَّی تَغْرُبَ الشَّمْسُ۔","","Musannaf Ibn Abi Shaybah 11445","","","كتاب الجنائز"
"11446","(۱۱۴۴۶) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی بَکْرٍ یَعْنِی ابْنَ حَفْصٍ ، قَالَ : کَانَ عَبْدُ اللہِ بْنُ عُمَرَ إذَا کَانَتِ الْجِنَازَۃُ صَلَّی الْعَصْرَ ، ثُمَّ قَالَ : عَجِّلُوا بِہَا قَبْلَ أَنْ تَطْفُلَ الشَّمْسُ۔","Sahih","Musannaf Ibn Abi Shaybah 11446","","","كتاب الجنائز"
"11447","(۱۱۴۴۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنِ الْوَلِیدِ بْنِ أَبِی مَالِکٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، وعَنْ أَشْعَثَ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ قَالُوا : إذَا حَضَرَتِ الْجِنَازَۃُ وَالصَّلاَۃُ الْمَکْتُوبَۃُ یُبْدَأُ بِصَلاَۃِ الْمَکْتُوبَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11447","","","كتاب الجنائز"
"11448","(۱۱۴۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عُثْمَان بْنِ أَبِی ہِنْدٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، أَنَّہُ حَضَرَ جِنَازَۃً وَحَضَرَتِ الصَّلاَۃُ فَبَدَأَ بِالْمَکْتُوبَۃِ۔","","Musannaf Ibn Abi Shaybah 11448","","","كتاب الجنائز"
"11449","(۱۱۴۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ یُبْدَأُ بِالْمَکْتُوبَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11449","","","كتاب الجنائز"
"11450","(۱۱۴۵۰) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ مَاتَ ابْنٌ لِی ، قَالَ : فَقَالَ : لِی ابْنُ سِیرِینَ إنِ اسْتَطَعْت أَنْ تُخْرِجَہُ فِی وَقْتٍ یُصَلَّی عَلَیْہِ ، ثُمَّ تُصَلَّی الْعَصْرُ۔","","Musannaf Ibn Abi Shaybah 11450","","","كتاب الجنائز"
"11451","(۱۱۴۵۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ ، عَنِ الْجَنَائزِ یُصَلَّی عَلَیْہَا قَبْلَ صَلاَۃِ المَغْرِب ، أَوْ بَعْدَہَا ؟ قَالَ یُصَلَّی عَلَی الْجَنَازۃِ قَبْلَ ثُمَّ تُصَلَّی الْمَغْرِبُ۔","","Musannaf Ibn Abi Shaybah 11451","","","كتاب الجنائز"
"11452","(۱۱۴۵۲) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ التَّیْمِیِّ ، عَنْ بَکْرٍ ، قَالَ : إذَا حَمَلْتَ الْجِنَازَۃَ فَسَبِّحْ مَا دُمْت تَحْمِلُہَا۔","","Musannaf Ibn Abi Shaybah 11452","","","كتاب الجنائز"
"11453","(۱۱۴۵۳) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ ، قَالَ : إذَا حَمَلَ ، قَالَ بِسْمِ اللہِ وَیُسَبِّحُ مَا حَمَلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 11453","","","كتاب الجنائز"
"11454","(۱۱۴۵۴) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَبِی خَلْدَۃَ ، قَالَ : رَأَیْتُ الْحَسَنَ یُصَلِّی عَلَی جِنَازَۃِ أَبِی رَجَائٍ الْعُطَارِدِیِّ عَلَی حِمَارٍ۔","","Musannaf Ibn Abi Shaybah 11454","","","كتاب الجنائز"
"11455","(۱۱۴۵۵) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ تُصَلِّیَ الْمَرْأَۃُ عَلَی جِنَازَۃٍ وَہِیَ وَاقِفَۃٌ عَلَی حِمَارِہَا۔","","Musannaf Ibn Abi Shaybah 11455","","","كتاب الجنائز"
"11456","(۱۱۴۵۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ ، عَنْ مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ مِنَّا مَنْ لَطَمَ الْخُدُودَ وَشَقَّ الْجُیُوبَ وَدَعَا بِدُعَائِ أَہْلِ الْجَاہِلِیَّۃِ۔ (بخاری ۱۲۹۴۔ مسلم ۱۶۵)","Sahih","Musannaf Ibn Abi Shaybah 11456","","","كتاب الجنائز"
"11457","(۱۱۴۵۷) حَدَّثَنَا وَکِیعٌ ، وَعَبْدُ الرَّحْمَن بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ زُبَیْدٍ ، عَنْ إِبْرَاہِیمَ ، عَن مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لَیْسَ مِنَّا مَنْ ضَرَبَ الْخُدُودَ وَشَقَّ الْجُیُوبَ وَدَعَا بِدَعْوَی أَہْلِ الْجَاہِلِیَّۃِ۔ (بخاری ۱۲۹۷۔ ترمذی ۹۹۹)","Sahih","Musannaf Ibn Abi Shaybah 11457","","","كتاب الجنائز"
"11458","(۱۱۴۵۸) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ عِیَاضٍ الأَشْعَرِیِّ ، قَالَ لَمَّا أُغْمِیَ عَلَی أَبِی مُوسَی صَاحَتِ امْرَأَتُہُ ، فَلَمَّا أَفَاقَ ، قَالَ : أمَا عَلِمْتِ مَا قُلْتُ لَکَ ؟ قَالَت : فَلَمَّا مَاتَ لَمْ تَصِحْ عَلَیْہِ ، فَقُلْنَا : مَا قَالَ لَکَ ؟ قَالَتْ : قَالَ : لَیْسَ مِنَّا مَنْ خَرَقَ ، أَوْ حَلَقَ ، أَوْ سَلَقَ۔ (مسلم ۱۰۰۔ ابوداؤد ۳۱۲۲)","Sahih","Musannaf Ibn Abi Shaybah 11458","","","كتاب الجنائز"
"11459","(۱۱۴۵۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن سَہْمِ بْنِ مِنْجَابٍ ، عَنِ الْقَرْثَعِ ، قَالَ : لَمَّا ثَقُلَ أَبُو مُوسَی صَاحَتْ عَلَیْہِ امْرَأَتُہُ ، فَقَالَ : لَہَا أَمَا عَلِمْتِ مَا قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَتْ : بَلَی ، ثُمَّ سَکَتَتْ ، فَقِیلَ لَہَا بَعْدُ أَیُّ شَیْئٍ قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَقَالَتْ : إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَعَنَ مَنْ حَلَقَ وَخَرَقَ وَسَلَقَ۔ (احمد ۴/۴۰۵۔ نسائی ۱۹۹۴)","Hasan","Musannaf Ibn Abi Shaybah 11459","","","كتاب الجنائز"
"11460","(۱۱۴۶۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، قَالَ لَمَّا مَاتَ خَالِدُ بْنُ الْوَلِیدِ اجْتَمَعَن نِسْوَۃُ بَنِی الْمُغِیرَۃِ یَبْکِینَ عَلَیْہِ فَقِیلَ لِعُمَرَ أَرْسِلْ إلَیْہِنَّ فَانْہَہُنَّ لاَ یَبْلُغُک عَنْہُنَّ شَیْئٌ تَکْرَہُہُ ، قَالَ : فَقَالَ عُمَرُ : وَمَا عَلَیْہِنَّ أَنْ یُہْرِقْنَ مِنْ دُمُوعِہِنَّ عَلَی أَبِی سُلَیْمَانَ مَا لَمْ یَکُنْ نَقْعٌ ، أَوْ لَقْلَقَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 11460","","","كتاب الجنائز"
"11461","(۱۱۴۶۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : حدَّثَنَا الْقَاسِمُ وَمَکْحُولٌ ، عَنْ أَبِی أُمَامَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَعَنَ الْخَامِشَۃَ وَجْہَہَا وَالشَّاقَّۃَ جَیْبَہَا۔ (ابن ماجہ ۱۵۸۵۔ دارمی ۲۴۷۶)","Da'if","Musannaf Ibn Abi Shaybah 11461","","","كتاب الجنائز"
"11462","(۱۱۴۶۲) حَدَّثَنَا وَکِیعٌ ، وَعَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : نَہَیْتُ عَنْ صَوْتٍ عِنْدَ مُصِیبَۃٍ ، خَمْشِ وُجُوہٍ وَشَقِّ جُیُوبٍ وَرَنَّۃِ شَیْطَانٍ۔ (بیہقی ۶۹)","Da'if","Musannaf Ibn Abi Shaybah 11462","","","كتاب الجنائز"
"11463","(۱۱۴۶۳) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا ہُرَیْمٌ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ مِنَّا مَنْ حَلَقَ وَلاَ سَلَقَ وََلاَ خَرَقَ۔","Da'if","Musannaf Ibn Abi Shaybah 11463","","","كتاب الجنائز"
"11464","(۱۱۴۶۴) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ سُفْیَانَ ، عَنْ ہِلاَلِ بْنِ خَبَّابٍ ، عَنْ أَبِی الْبَخْتَرِیِّ ، قَالَ : الطَّعَامُ عَلَی الْمَیِّتِ مِنْ أَمْرِ الْجَاہِلِیَّۃِ وَالنَّوْحُ مِنْ أَمْرِ الْجَاہِلِیَّۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11464","","","كتاب الجنائز"
"11465","(۱۱۴۶۵) حَدَّثَنَا فُضَالَۃُ بْنُ حُصَیْنٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : ثَلاَثٌ مِنْ أَمْرِ الْجَاہِلِیَّۃِ بَیْتُوتَۃُ الْمَرْأَۃِ عِنْدَ أَہْلِ الْمُصِیبَۃِ لَیْسَتْ مِنْہُمْ وَالنِّیَاحَۃُ وَنَحْرُ الْجَزُورِ عِنْدَ الْمُصِیبَۃِ۔","","Musannaf Ibn Abi Shaybah 11465","","","كتاب الجنائز"
"11466","(۱۱۴۶۶) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ ثَابِتٍ ، عَنْ قَیْسٍ ، قَالَ : أَدْرَکْت عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَمْنَعُ أَہْلَ الْمَیِّتِ الْجَمَاعَاتِ یَقُولُ یَُرْزَؤونِ وَیَغْرمُونَ۔","","Musannaf Ibn Abi Shaybah 11466","","","كتاب الجنائز"
"11467","(۱۱۴۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ، عَنْ طَلْحَۃَ، قَالَ: قَدِمَ جَرِیرٌ عَلَی عُمَرَ، فَقَالَ: ہَلْ یُنَاحُ قِبَلَکُمْ عَلَی الْمَیِّتِ؟ قَالَ: لاَ قَالَ فَہَلْ تَجْتَمِعُ النِّسَائُ عِنْدَکُمْ عَلَی الْمَیِّتِ وَیُطْعَمُ الطَّعَامُ، قَالَ نَعَمْ، فَقَالَ: تِلْکَ النِّیَاحَۃُ۔","","Musannaf Ibn Abi Shaybah 11467","","","كتاب الجنائز"
"11468","(۱۱۴۶۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : کَانَ رَجُلٌ یَمْشِی خَلْفَ الْجِنَازَۃِ وَیَقْرَأُ سُورَۃَ الْوَاقِعَۃِ فَسُئِلَ إبْرَاہِیمُ عَنْ ذَلِکَ فَکَرِہَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 11468","","","كتاب الجنائز"
"11469","(۱۱۴۶۹) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : رَأَیْتُ الْحَسَنَ وَمُحَمَّدًا فِی جِنَازَۃٍ فَلَمْ یَحْمِلاَ حَتَّی رَجَعَا۔","","Musannaf Ibn Abi Shaybah 11469","","","كتاب الجنائز"
"11470","(۱۱۴۷۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا الْبَرَائُ بْنُ یَزِیدَ ، قَالَ : رَأَیْتُ الشَّعْبِیَّ فِی جِنَازَۃٍ فَرَأَیْتُہُ یَمْشِی خَلْفَہَا ، وَلاَ یَحْمِلُہَا ، وَلَمْ یَمَسَّ عُودَہَا حَتَّی وُضِعَتْ عَلَی شَفِیرِ الْقَبْرِ ، ثُمَّ تَنَحَّی فَجَلَسَ وَکَانَ شَیْخًا۔","","Musannaf Ibn Abi Shaybah 11470","","","كتاب الجنائز"
"11471","(۱۱۴۷۱) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنَا مُعَاوِیَۃُ بْنُ صَالِحٍ ، قَالَ : حَدَّثَنِی حَبِیبُ بْنُ عُبَیْدٍ الْکَلاَعِیُّ ، عَنْ جُبَیْرِ بْنِ نُفَیْرٍ الْحَضْرَمِیِّ ، عَنْ عَوْفِ بْنِ مَالِکٍ الأَشْجَعِیِّ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ عَلَی الْمَیِّتِ : اللَّہُمَّ اغْفِرْ لَہُ وَارْحَمْہُ وَعَافِہِ وَاعْفُ عَنْہُ وَأَکْرِمْ نُزُلَہُ وَأَوْسِعْ مَدْخَلَہُ وَاغْسِلْہُ بِالْمَائِ وَالثَّلْجِ وَالْبَرَدِ وَنَقِّہِ مِنَ الْخَطَایَا کَمَا یُنَقَّی الثَّوْبُ الأَبْیَضُ مِنَ الدَّنَسِ اللَّہُمَّ أَبْدِلْہُ دَارًا خَیْرًا مِنْ دَارِہِ وَزَوْجًا خَیْرًا مِنْ زَوْجِہِ ، وَأَہْلاً خَیْرًا مِنْ أَہْلِہِ وَأَدْخِلْہُ الْجَنَّۃَ وَنَجِّہِ مِنَ النَّارِ ، أَوَ قَالَ : وَقِہ عَذَابَ الْقَبْرِ حَتَّی تَمَنَّیْت أَنْ أَکُونَ ہُوَ۔n اللَّہُمَّ اغْفِرْ لَہُ وَارْحَمْہُ وَعَافِہِ وَاعْفُ عَنْہُ وَأَکْرِمْ نُزُلَہُ وَأَوْسِعْ مَدْخَلَہُ وَاغْسِلْہُ بِالْمَائِ وَالثَّلْجِ وَالْبَرَدِ وَنَقِّہِ مِنَ الْخَطَایَا کَمَا یُنَقَّی الثَّوْبُ الأَبْیَضُ مِنَ الدَّنَسِ اللَّہُمَّ أَبْدِلْہُ دَارًا خَیْرًا مِنْ دَارِہِ وَزَوْجًا خَیْرًا مِنْ زَوْجِہِ، وَأَہْلاً خَیْرًا مِنْ أَہْلِہِ وَأَدْخِلْہُ الْجَنَّۃَ وَنَجِّہِ مِنَ النَّارِ۔ وَقِہ عَذَابَ النَّارِ۔ (مسلم ۶۶۲۔ احمد ۶/۲۳)","Sahih","Musannaf Ibn Abi Shaybah 11471","","","كتاب الجنائز"
"11472","(۱۱۴۷۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ أخبَرََنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أبی إبْرَاہِیمَ الأَنْصَارِیِّ ، عَنْ أَبِیہِ ، أَنَّہُ سَمِعَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ فِی الصَّلاَۃِ عَلَی الْمَیِّتِ : اللَّہُمَّ اغْفِرْ لِحَیِّنَا وَمَیِّتِنَا وَشَاہِدِنَا وَغَائِبِنَا وَذَکَرِنَا وَأُنْثَانَا وَصَغِیرِنَا وَکَبِیرِنَا۔ (ترمذی ۱۰۲۴۔ نسائی ۲۱۱۳)","Da'if","Musannaf Ibn Abi Shaybah 11472","","","كتاب الجنائز"
"11473","(۱۱۴۷۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ شُعْبَۃَ ، عَنِ الْجُلاَسِ ، عَنْ عُثْمَانَ بْنِ شَمَّاسٍ ، قَالَ : کُنَّا عِنْدَ أَبِی ہُرَیْرَۃَ فَمَرَّ بِہِ مَرْوَانُ ، فَقَالَ لہ بَعْضَ حَدِیثک عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ مَضَی ، ثُمَّ رَجَعَ فَقُلْنَا الآنَ یَقَعُ بِہِ ، فَقَالَ : کَیْفَ سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی عَلَی الْجِنَازَۃِ ، قَالَ : سَمِعْتُہ یَقُولُ : أَنْتَ ہَدَیْتہَا لِلإِسْلاَمِ وَأَنْتَ قَبَضْت رُوحَہَا تَعْلَمُ سِرَّہَا وَعَلاَنِیَتَہَا ، جِئْنَاک شُفَعَائَ ، فَاغْفِرْ لَہَا۔n(ابوداؤد ۳۱۹۲۔ احمد ۲/۳۶۳)","Da'if","Musannaf Ibn Abi Shaybah 11473","","","كتاب الجنائز"
"11474","(۱۱۴۷۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ رَجُلٍ مِنْ أَہْلِ مَکَّۃَ ، عَنْ أَبِی سَلَمَۃَ ، وَعَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ فِی الصَّلاَۃِ عَلَی الْجِنَازَۃِ : اللَّہُمَّ اغْفِرْ لِحَیِّنَا وَمَیِّتِنَا وَذَکَرِنَا وَأُنْثَانَا وَشَاہِدِنَا وَغَائِبِنَا وَصَغِیرِنَا وَکَبِیرِنَا اللَّہُمَّ مَنْ أَحْیَیْتہ مِنَّا فَأَحْیِہِ عَلَی الإِسْلاَمِ وَمَنْ تَوَفَّیْتہُ مِنَّا فَتَوَفَّہُ عَلَی الإِیمَانِ۔ (ابن ماجہ ۳۵۸)","Da'if","Musannaf Ibn Abi Shaybah 11474","","","كتاب الجنائز"
"11475","(۱۱۴۷۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ أَبِی مَالِکٍ ، قَالَ : کَانَ أَبُو بَکْرٍ إذَا صَلَّی عَلَی الْمَیِّتِ ، قَالَ: اللَّہُمَّ عَبْدُک أَسْلَمَہُ الأَہْلُ والمال وَالْعَشِیرَۃُ وَالذَّنْبُ عَظِیمُ وَأَنْتَ الْغَفُورُ الرَّحِیمُ۔","","Musannaf Ibn Abi Shaybah 11475","","","كتاب الجنائز"
"11476","(۱۱۴۷۶) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَنْ طَارِقٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، قَالَ: کَانَ عُمَرُ یَقُولُ فِی الصَّلاَۃِ عَلَیْہِ إِنْ کَانَ مَسَائً ، فَقَالَ : اللَّہُمَّ أَمْسَی عَبْدُک ، وَإِنْ کَانَ صَبَاحًا ، قَالَ اللَّہُمَّ أَصْبَحَ عَبْدُک قَدْ تَخَلَّی مِنَ الدُّنْیَا وَتَرَکَہَا لأَہْلِہَا وَاسْتَغْنَیت ، عَنْہ وَافْتَقَرَ إلَیْک ، کَانَ یَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ أَنْتَ ، وَأَنَّ مُحَمَّدًا عَبْدُک وَرَسُولُک ، فَاغْفِرْ لَہُ ذَنْبَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 11476","","","كتاب الجنائز"
"11477","(۱۱۴۷۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، قَالَ : کَانَ عَلِیٌّ یَقُولُ فِی الصَّلاَۃِ عَلَی الْمَیِّتِ اللَّہُمَّ اغْفِرْ لأَحْیَائِنَا وَأَمْوَاتِنَا وَأَلِّفْ بَیْنَ قُلُوبِنَا وَأَصْلِحْ ذَاتَ بَیْنِنَا وَاجْعَلْ قُلُوبَنَا عَلَی قُلُوبِ خِیَارِنَا اللَّہُمَّ اغْفِرْ لَہُ اللَّہُمَّ ارْحَمْہُ اللَّہُمَّ ارْجِعْہُ إلَی خَیْرٍ مِمَّا کَانَ فِیہِ اللَّہُمَّ عَفْوَک۔","","Musannaf Ibn Abi Shaybah 11477","","","كتاب الجنائز"
"11478","(۱۱۴۷۸) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، قَالَ : کُنْتُ فِی جِنَازَۃِ غُنَیْمٍ فَحَدَّثَنِی رَجُلٌ مِنْہُمْ أَنَّہُ ، قَالَ : سَمِعْتُ أَبَا مُوسَی صَلَّی عَلَی مَیِّتٍ فَکَبَّرَ ، وَقَالَ اللَّہُمَّ اغْفِرْ لَہُ کَمَا اسْتَغْفَرَک وَأَعْطِہِ مَا سَأَلَک وَزِدْہُ مِنْ فَضْلِک۔","Da'if","Musannaf Ibn Abi Shaybah 11478","","","كتاب الجنائز"
"11479","(۱۱۴۷۹) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ بْنُ سَلاَمٍ الصَّلاَۃُ عَلَی الْجِنَازَۃِ أَنْ یَقُولَ اللَّہُمَّ اغْفِرْ لِحَیِّنَا وَمَیِّتِنَا وَصَغِیرِنَا وَکَبِیرِنَا وَذَکَرِنَا وَأُنْثَانَا وَشَاہِدِنَا وَغَائِبِنَا اللَّہُمَّ مَنْ تَوَفَّیْتہُ مِنْہُمْ فَتَوَفَّہُ عَلَی الإِیمَانِ وَمَنْ أَبْقَیْتہ مِنْہُمْ فَأَبْقِہِ عَلَی الإِسْلاَمِ۔","Hasan","Musannaf Ibn Abi Shaybah 11479","","","كتاب الجنائز"
"11480","(۱۱۴۸۰) حَدَّثَنَا عَفَّانُ بْنُ مُسْلِمٍ ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، قَالَ : حَدَّثَنَا خَالِدٌ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنِ ابْنِ عَمْرِو بْنِ غَیْلاَنَ ، عَنْ أَبِی الدَّرْدَائِ ، أَنَّہُ کَانَ یَقُولُ عَلَی الْمَیِّتِ ، اللَّہُمَّ اغْفِرْ لأَحْیَائِنَا وَأَمْوَاتِنَا الْمُسْلِمِینَ اللَّہُمَّ اغْفِرْ لِلْمُسْلِمِینَ وَالْمُسْلِمَاتِ وَالْمُؤْمِنِینَ وَالْمُؤْمِنَاتِ وَأَصْلِحْ ذَاتَ بَیْنِہِمْ وَأَلِّفْ بَیْنَ قُلُوبِہِمْ وَاجْعَلْ قُلُوبَہُمْ عَلَی قُلُوبِ خِیَارِہِمَ ، اللَّہُمَّ اغْفِرْ لِفُلاَنِ بْنِ فُلاَنٍ ذَنْبَہُ ، وَأَلْحِقْہُ بِنَبِیِّہِ مُحَمَد صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، اللَّہُمَّ ارْفَعْ دَرَجَتَہُ فِی الْمُہْتَدِینَ ، وَاخْلُفْہُ فِی عَقِبِہِ فِی الْغَابِرِینَ ، وَاجْعَلْ کِتَابَہُ فِی عِلِّیِّینَ ، وَاغْفِرْ لَنَا وَلَہُ رَبَّ الْعَالَمِینَ ، اللَّہُمَّ لاَ تَحْرِمْنَا أَجْرَہُ ، وَلاَ تُضِلَّنَا بَعْدَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 11480","","","كتاب الجنائز"
"11481","(۱۱۴۸۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ زَیْدٍ الْعَمِّیِّ ، عَنْ أَبِی الصِّدِّیقِ النَّاجِی ، قَالَ : سَأَلْتُ أَبَا سَعِیدٍ عَنِ الصَّلاَۃِ عَلَی الْجِنَازَۃِ ، فقَالَ : کُنَّا نَقُولُ اللَّہُمَّ أَنْتَ رَبُّنَا وَرَبُّہُ خَلَقْتہ وَرَزَقْتہ وَأَحْیَیْتہ وَکَفَیْتہ ، فَاغْفِرْ لَنَا وَلَہُ ، وَلاَ تَحْرِمْنَا أَجْرَہُ ، وَلاَ تُضِلَّنَا بَعْدَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 11481","","","كتاب الجنائز"
"11482","(۱۱۴۸۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ فِی الْجِنَازَۃِ إذَا صَلَّی عَلَیْہَا اللَّہُمَّ بَارِکْ فِیہِ وَصَلِّ عَلَیْہِ وَاغْفِرْ لَہُ وَأَوْرِدْہُ حَوْضَ رَسُولِکَ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ فِی قِیَامٍ کَثِیرٍ وَکَلاَمٍ کَثِیرٍ لَمْ أَفْہَمْ مِنْہُ غَیْرَ ہَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 11482","","","كتاب الجنائز"
"11483","(۱۱۴۸۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یُونُسَ ، قَالَ : سَأَلْتُ مُجَاہِدًا عَنِ الصَّلاَۃِ عَلَی الْمَیِّتِ ، فَقَالَ مُجَاہِدٌ : إنَّا نَحْنُ فَنَقُولُ اللَّہُمَّ أَنْتَ خَلَقْتہ وَأَنْتَ ہَدَیْتہ لِلإِسْلاَمِ وَأَنْتَ قَبَضْت رُوحَہُ وَأَنْتَ أَعْلَمُ بِسَرِیرَتِہِ وَعَلاَنِیَتِہِ جِئْنَا نَشْفَعُ لَہُ ، فَاغْفِرْ لَہُ۔","","Musannaf Ibn Abi Shaybah 11483","","","كتاب الجنائز"
"11484","(۱۱۴۸۴) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ حَرِیزٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی عَوْفٍ ، عَنِ ابْنِ لُحَیٍّ الْہَوْزَنِیِّ ، أَنَّہُ شَہِدَ جِنَازَۃَ شُرَحْبِیلَ بْنِ السِّمْطِ فَقَدَّمَ عَلَیْہَا حَبِیبَ بْنَ مَسْلَمَۃَ الفَہْرِی فَأَقْبَلَ عَلَیْنَا کَالْمُشْرِفِ عَلَیْنَا مِنْ طُولِہِ ، فَقَالَ: اجْتَہِدُوا لأَخِیکُمْ فِی الدُّعَائِ ، وَلْیَکُنْ فِیمَا تَدْعُونَ لَہُ ؛ اللَّہُمَّ اغْفِرْ لِہَذِہِ النَّفْسِ الْحَنِیفِیَّۃِ الْمُسْلِمَۃِ، وَاجْعَلْہَا مِنَ الَّذِینَ تَابُوا وَاتَّبَعُوا سَبِیلَکَ، وَقِہَا عَذَابَ الْجَحِیمِ، وَاسْتَنْصِرُوا اللَّہَ عَلَی عَدُوِّکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 11484","","","كتاب الجنائز"
"11485","(۱۱۴۸۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : مَا بَاحَ لَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَلاَ أَبُو بَکْرٍ ، وَلاَ عُمَرُ فِی الصَّلاَۃِ عَلَی الْمَیِّتِ بِشَیْء ۔ (ابن ماجہ ۱۵۰۱۔ احمد ۳/۳۵۷)","","Musannaf Ibn Abi Shaybah 11485","","","كتاب الجنائز"
"11486","(۱۱۴۸۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَنْ ثَلاَثِینَ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُمْ لَمْ یَقُومُوا عَلَی شَیْئٍ فِی أَمْرِ الصَّلاَۃِ عَلَی الْجِنَازَۃِ۔","","Musannaf Ibn Abi Shaybah 11486","","","كتاب الجنائز"
"11487","(۱۱۴۸۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ ، قَالَ: لَیْسَ فِی الصَّلاَۃِ عَلَی الْمَیِّتِ دُعَائٌ مُوَقَّتٌ، فَادْعُ بِمَا شِئْت۔","No Data Available","Musannaf Ibn Abi Shaybah 11487","","","كتاب الجنائز"
"11488","(۱۱۴۸۸) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ وَالشَّعْبِیِّ ، قَالاَ : لَیْسَ عَلَی الْمَیِّتِ دُعَائٌ مُوَقَّتٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 11488","","","كتاب الجنائز"
"11489","(۱۱۴۸۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، قَالَ : سَأَلْتُ مُحَمَّدًا عَنِ الصَّلاَۃِ عَلَی الْمَیِّتِ ، فَقَالَ : مَا نَعْلَمُ لَہُ شَیْئًا مُوَقَّتًا ادْعُ بِأَحْسَنَ مَا تَعْلَمُ۔","Hasan","Musannaf Ibn Abi Shaybah 11489","","","كتاب الجنائز"
"11490","(۱۱۴۹۰) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ إِسْحَاقَ بْنِ سُوَیْد ، عَنِ بَکْرِ بْنِ عَبْدِ اللہِ ، قَالَ : لَیْسَ فِی الصَّلاَۃِ عَلَی الْمَیِّتِ شَیْئٌ مُوَقَّتٌ۔","","Musannaf Ibn Abi Shaybah 11490","","","كتاب الجنائز"
"11491","(۱۱۴۹۱) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ مُوسَی الْجُہَنِیِّ ، قَالَ : سَأَلْتُ الْحَکَمَ وَالشَّعْبِیَّ وَعَطَائً وَمُجَاہِدًا أَفِی الصَّلاَۃِ عَلَی الْمَیِّتِ شَیْئٌ مُوَقَّتٌ ؟ فَقَالُوا : لاَ إنَّمَا أَنْتَ شَفِیعٌ فَاشْفَعْ بِأَحْسَنَ مَا تَعْلَمُ۔","","Musannaf Ibn Abi Shaybah 11491","","","كتاب الجنائز"
"11492","(۱۱۴۹۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یَقُولُ فِی الصَّلاَۃِ عَلَی الْمَیِّتِ لَیْسَ فِیہِ شَیْئٌ مُوَقَّتٌ۔","","Musannaf Ibn Abi Shaybah 11492","","","كتاب الجنائز"
"11493","(۱۱۴۹۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ فِی التَّکْبِیرَۃِ الأُولَی ، یُبْدَأُ بِحَمْدِ اللہِ وَالثَّنَائِ عَلَیْہِ ، وَالثَّانِیَۃُ صَلاَۃٌ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَالثَّالِثَۃُ دُعَائٌ لِلْمَیِّتِ ، وَالرَّابِعَۃُ لِلتَّسْلِیمِ۔","","Musannaf Ibn Abi Shaybah 11493","","","كتاب الجنائز"
"11494","(۱۱۴۹۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، أَنَّہُ کَانَ إذَا صَلَّی عَلَی مَیِّتٍ یَبْدَأُ بِحَمْدِ اللہِ وَیُصَلِّی عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ یَقُولُ : اللَّہُمَّ اغْفِرْ لأَحْیَائِنَا وَأَمْوَاتِنَا ، وَأَلِّفْ بَیْنَ قُلُوبِنَا ، وَأَصْلِحْ ذَاتَ بَیْنِنَا ، وَاجْعَلْ قُلُوبَنَا عَلَی قُلُوبِ خِیَارِنَا۔","","Musannaf Ibn Abi Shaybah 11494","","","كتاب الجنائز"
"11495","(۱۱۴۹۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدٍ بن أبی سعید الْمَقْبُرِیِّ ، أَنَّ رَجُلاً سَأَلَ أَبَا ہُرَیْرَۃَ فَقَالَ : کَیْفَ تُصَلِّی عَلَی الْجِنَازَۃِ ؟ فَقَالَ أَبُو ہُرَیْرَۃَ أَنَا لَعَمْرُ اللہِ أُخْبِرُک أُکَبِّرُ ، ثُمَّ أُصَلِّی عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ أَقُولُ: اللَّہُمَّ عَبْدُک ، أَوْ أَمَتُک ، کَانَ یَعْبُدُک لاَ یُشْرِکُ بِکَ شَیْئًا ، وَأَنْتَ أَعْلَمُ بِہِ، إِنْ کَانَ مُحْسِنًا فَزِدْ فِی إحْسَانِہِ ، وَإِنْ کَانَ مُخْطِئًا فَتَجَاوَزْ عَنْہُ ، اللَّہُمَّ لاَ تَفْتِنَّا بَعْدَہُ ، وَلاَ تَحْرِمْنَا أَجْرَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 11495","","","كتاب الجنائز"
"11496","(۱۱۴۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی ہَاشِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَمِعْتُہ یَقُولُ : فِی الأُولَی ثَنَائٌ عَلَی اللہِ تَعَالَی، وَفِی الثَّانِیَۃِ صَلاَۃٌ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، وَفِی الثَّالِثَۃِ دُعَائٌ لِلْمَیِّتِ، وَفِی الرَّابِعَۃِ تَسْلِیمٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 11496","","","كتاب الجنائز"
"11497","(۱۱۴۹۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : سَمِعْتُ أَبَا أُمَامَۃَ یُحَدِّثُ سَعِیدَ بْنَ الْمُسَیَّبِ ، قَالَ : مِنَ السُّنَّۃِ فِی الصَّلاَۃِ عَلَی الْجِنَازَۃِ أَنْ تَقْرَأَ بِفَاتِحَۃِ الْکِتَابِ ، ثُمَّ تُصَلِّیَ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ یُخْلِصَ الدُّعَائَ لِلْمَیِّتِ حَتَّی یَفْرُغَ ، وَلاَ تَقْرَأَ إِلاَّ مَرَّۃً وَاحِدَۃً ، ثُمَّ تُسَلِّمَ فِی نَفْسِکِ۔n(عبدالرزاق ۶۴۲۸۔ ابن الجارود ۵۴۰)","","Musannaf Ibn Abi Shaybah 11497","","","كتاب الجنائز"
"11498","(۱۱۴۹۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ یَرْفَعُ یَدَیْہِ فِی کُلِّ تَکْبِیرَۃٍ عَلَی الْجِنَازَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 11498","","","كتاب الجنائز"
"11499","(۱۱۴۹۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ غَیْلاَنَ بْنِ أَنَسٍ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَانَ یَرْفَعُ یَدَیْہِ فِی کُلِّ تَکْبِیرَۃٍ من تکبیر الْجِنَازَۃِ۔","","Musannaf Ibn Abi Shaybah 11499","","","كتاب الجنائز"
"11500","(۱۱۵۰۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یَرْفَعُ یَدَیْہِ فِی کُلِّ تَکْبِیرَۃٍ وَمَنْ خَلْفَہُ یَرْفَعُونَ أَیْدِیَہُمْ۔","","Musannaf Ibn Abi Shaybah 11500","","","كتاب الجنائز"
"11501","(۱۱۵۰۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ دَاوُدَ بْنِ قَیْسٍ ، عَنْ مُوسَی بْنِ نُعَیْمٍ مَوْلَی زَیْدِ بْنِ ثَابِتٍ ، قَالَ : مِنَ السُّنَّۃِ أَنْ تَرْفَعَ یَدَیْک فِی کُلِّ تَکْبِیرَۃٍ مِنَ الْجِنَازَۃِ۔","","Musannaf Ibn Abi Shaybah 11501","","","كتاب الجنائز"
"11502","(۱۱۵۰۲) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، قَالَ : رَأَیْتُ سَالِمًا کَبَّرَ عَلَی جِنَازَۃٍ أَرْبَعًا ، یَرْفَعُ یَدَیْہِ عِنْدَ کُلِّ تَکْبِیرَۃٍ۔","","Musannaf Ibn Abi Shaybah 11502","","","كتاب الجنائز"
"11503","(۱۱۵۰۳) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَنْ عُِمَرِ بْنِ أَبِی زَائِدَۃَ ، قَالَ : صَلَّیْتُ خَلْفَ قَیْسِ بْنِ أَبِی حَازِمٍ عَلَی جِنَازَۃٍ فَکَبَّرَ أَرْبَعًا ، یَرْفَعُ یَدَیْہِ فِی کُلِّ تَکْبِیرَۃٍ۔","","Musannaf Ibn Abi Shaybah 11503","","","كتاب الجنائز"
"11504","(۱۱۵۰۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ اللہِ بْنِ جُمَیْعٍ الزُّہْرِیِّ ، قَالَ : رَأَیْتُ إبْرَاہِیمَ إذَا صَلَّی عَلَی الْجِنَازَۃِ رَفَعَ یَدَیْہِ فَکَبَّرَ ، ثُمَّ لاَ یَرْفَعُ یَدَیْہِ فِیمَا بَقِیَ وَکَانَ یُکَبِّرُ أَرْبَعًا۔","","Musannaf Ibn Abi Shaybah 11504","","","كتاب الجنائز"
"11505","(۱۱۵۰۵) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ، أَنَّہُ کَانَ یَرْفَعُ یَدَیْہِ فِی أَوَّلِ تَکْبِیرَۃٍ عَلَی الْجِنَازَۃِ۔","","Musannaf Ibn Abi Shaybah 11505","","","كتاب الجنائز"
"11506","(۱۱۵۰۶) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ یَحْیَی، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، أَنَّہُ کَانَ یَرْفَعُ یَدَیْہِ مَعَ کُلِّ تَکْبِیرَۃٍ عَلَی الْجِنَازَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 11506","","","كتاب الجنائز"
"11507","(۱۱۵۰۷) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یَرْفَعُ یَدَیْہِ فِی الصَّلاَۃِ ، وَإِذَا رَکَعَ ، وَإِذَا رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ ، وَکَانَ یَفْعَلُ ذَلِکَ مَعَ کُلِّ تَکْبِیرَۃٍ عَلَی الْجِنَازَۃِ۔","","Musannaf Ibn Abi Shaybah 11507","","","كتاب الجنائز"
"11508","(۱۱۵۰۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ زِیَادٍ ، عَنْ نفَاعَۃَ بْنِ مُسْلِمٍ ، قَالَ: کَانَ سُوَیْد یُکَبِّرُ عَلَی جَنَائِزِنَا، فَکَانَ یَرْفَعُ یَدَیْہِ فِی أَوَّلِ تَکْبِیرَۃٍ۔","","Musannaf Ibn Abi Shaybah 11508","","","كتاب الجنائز"
"11509","(۱۱۵۰۹) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : صَلَّیْت خَلْفَ قَیْسِ بْنِ أَبِی حَازِمٍ عَلَی جِنَازَۃٍ ، فَکَانَ یُتَابِعُ بَیْنَ تَکْبِیرِہِ۔","","Musannaf Ibn Abi Shaybah 11509","","","كتاب الجنائز"
"11510","(۱۱۵۱۰) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِی أُمَامَۃَ بْنِ سَہْلِ بْنِ حُنَیْفٍ، عَنْ عُبَیْدِ بْنِ السَّبَّاقِ، أَنَّہُ حَدَّثَہُ، أَنَّہُ رَأَی سَہْلَ بْنَ حُنَیْفٍ صَلَّی عَلَی مَیِّتٍ فَقَرَأَ فِی أَوَّلِ تَکْبِیرَۃٍ بِأُمِّ الْقُرْآنِ، ثُمَّ تَابَعَ بَیْنَ تَکْبِیرِہِ یَدْعُو بَیْنَ ذَلِکَ حَتَّی إذَا بَقِیَتْ تَکْبِیرَۃٌ تَشَہَّدَ تَشَہُّد الصَّلاَۃِ، ثُمَّ کَبَّرَ وَانْصَرَفَ۔","","Musannaf Ibn Abi Shaybah 11510","","","كتاب الجنائز"
"11511","(۱۱۵۱۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عُمَرَ بْنِ عَامِرٍ ، عَنْ أَبِی رَجَائٍ ، عَنْ أَبِی العُرْیَان الْحَذَّائِ ، قَالَ : صَلَّیْت خَلْفَ الْحَسَنِ بْنِ عَلِیٍّ عَلَی جِنَازَۃٍ ، فَلَمَّا فَرَغَ أَخَذْت بِیَدِہِ فَقُلْت کَیْفَ صَنَعْت ؟ قَالَ : قرَأْتُ عَلَیْہَا بِفَاتِحَۃِ الْکِتَابِ۔","Da'if","Musannaf Ibn Abi Shaybah 11511","","","كتاب الجنائز"
"11512","(۱۱۵۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ رَجُلٍ مِنْ ہَمْدَانَ ، أَنَّ عَبْدَ اللہِ بْنَ مَسْعُودٍ قرَأَ عَلَیْہَا بِفَاتِحَۃِ الْکِتَابِ۔","Da'if","Musannaf Ibn Abi Shaybah 11512","","","كتاب الجنائز"
"11513","(۱۱۵۱۳) حَدَّثَنَا أَزْہَرُ السَّمَّانِ، عَنِ ابْنِ عَوْنٍ قَالَ: کَانَ الْحَسَنُ یَقْرَأُ بِفَاتِحَۃِ الْکِتَابِ فِی کُلِّ تَکْبِیرَۃٍ عَلَی الْجِنَازَۃِ۔","","Musannaf Ibn Abi Shaybah 11513","","","كتاب الجنائز"
"11514","(۱۱۵۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سَلَمَۃَ ، عَنِ الضَّحَّاکِ ، قَالَ : اقْرَأْ فِی التَّکْبِیرَتَیْنِ الأُولَیَیْنِ بِفَاتِحَۃِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 11514","","","كتاب الجنائز"
"11515","(۱۱۵۱۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، أَنَّہُ کَانَ یَقْرَأُ فِی التَّکْبِیرَتَیْنِ الأُولَیَیْنِ فِی الصَّلاَۃِ عَلَی الْمَیِّتِ بِفَاتِحَۃِ الْکِتَابِ ، وَإِنْ أَمْہَلُوہُ أَنْ یَدْعُوَ فِیہَا دَعَا۔","","Musannaf Ibn Abi Shaybah 11515","","","كتاب الجنائز"
"11516","(۱۱۵۱۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : سَمِعْتُ أَبَا أُمَامَۃَ یُحَدِّثُ سَعِیدَ بْنَ الْمُسَیَّبِ ، قَالَ : مِنَ السُّنَّۃِ فِی الصَّلاَۃِ عَلَی الْجِنَازَۃِ أَنْ تَقْرَأَ بِفَاتِحَۃِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 11516","","","كتاب الجنائز"
"11517","(۱۱۵۱۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِی أُمَامَۃَ بْنِ سَہْلِ بْنِ حُنَیْفٍ ، عَنْ عُبَیْدِ بْنِ السَّبَّاقِ ، أَنَّہُ حَدَّثَہُ ، أَنَّہُ رَأَی سَہْلَ بْنَ حُنَیْفٍ صَلَّی عَلَی مَیِّتٍ فَقَرَأَ فِی أَوَّلِ تَکْبِیرَۃٍ بِأُمِّ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 11517","","","كتاب الجنائز"
"11518","(۱۱۵۱۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ سَعِیدٍ ، أَنَّ ابْنَ عَبَّاسٍ قَرَأَ عَلَی جِنَازَۃٍ وَجَہَرَ ، وَقَالَ : إنَّمَا فَعَلْتُہُ لِتَعْلَمُوا أَنَّ فِیہَا قِرَائَۃً۔","Hasan","Musannaf Ibn Abi Shaybah 11518","","","كتاب الجنائز"
"11519","(۱۱۵۱۹) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی مَعبَد ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ یُسْمع النَّاسَ بِالْحَمْدِ وَیُکَبِّرُ عَلَی الْجِنَازَۃِ ثَلاَثًا۔","Sahih","Musannaf Ibn Abi Shaybah 11519","","","كتاب الجنائز"
"11520","(۱۱۵۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زَیْدِ بْنِ طَلْحَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ قَرَأَ عَلَیْہَا بِفَاتِحَۃِ الْکِتَابِ۔","Sahih","Musannaf Ibn Abi Shaybah 11520","","","كتاب الجنائز"
"11521","(۱۱۵۲۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ شَرِیکٍ ، عَنْ أَبِی ہَاشِمٍ الْوَاسِطِیِّ ، عَنْ فُضَالَۃَ مَوْلَی عمر ان الَّذِی صَلَّی عَلَی أَبِی بَکْرٍ ، أَوْ عُمَرَ قَرَأَ عَلَیْہِ بِفَاتِحَۃِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 11521","","","كتاب الجنائز"
"11522","(۱۱۵۲۲) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ کَانَ لاَ یَقْرَأُ فِی الصَّلاَۃِ عَلَی الْمَیِّتِ۔","Sahih","Musannaf Ibn Abi Shaybah 11522","","","كتاب الجنائز"
"11523","(۱۱۵۲۳) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، أَنَّہُ کَانَ لاَ یَقْرَأُ فِی الصَّلاَۃِ عَلَی الْمَیِّتِ۔","","Musannaf Ibn Abi Shaybah 11523","","","كتاب الجنائز"
"11524","(۱۱۵۲۴) حَدَّثَنَا عَبْدُ الأَعْلَی وَغُنْدَرٌ ، عَنْ عَوْفٍ ، عَنْ أَبِی الْمِنْہَالِ ، قَالَ : سَأَلْتُ أَبَا الْعَالِیَۃِ عَنِ الْقِرَائَۃِ فِی الصَّلاَۃِ عَلَی الْجِنَازَۃِ بِفَاتِحَۃِ الْکِتَابِ ، فَقَالَ : مَا کُنْت أَحْسَبُ أَنَّ فَاتِحَۃَ الْکِتَابِ تُقْرَأُ إِلاَّ فِی صَلاَۃٍ فِیہَا رُکُوعٌ وَسُجُودٌ۔","","Musannaf Ibn Abi Shaybah 11524","","","كتاب الجنائز"
"11525","(۱۱۵۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُلَیٍّ ، عَنْ أَبِیہِ ، قَالَ : قُلْتُ لِفَضَالَۃَ بْنِ عُبَیْد ہَلْ یُقْرَأُ عَلَی الْمَیِّتِ شَیْئٌ ؟ قَالَ : لاَ۔","Sahih","Musannaf Ibn Abi Shaybah 11525","","","كتاب الجنائز"
"11526","(۱۱۵۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ سَعِیدِ بْنِ أَبِی بُرْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ لَہُ رَجُلٌ أَقْرَأُ عَلَی الْجِنَازَۃِ بِفَاتِحَۃِ الْکِتَابِ ؟ قَالَ : لاَ تَقْرَأْ۔","","Musannaf Ibn Abi Shaybah 11526","","","كتاب الجنائز"
"11527","(۱۱۵۲۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، قَالَ : سَأَلْتُ عَطَائً عَنِ الْقِرَائَۃِ عَلَی الْجِنَازَۃِ ، فَقَالَ : مَا سَمِعْنَا بِہَذَا إِلاََ حَدِیثًا۔","","Musannaf Ibn Abi Shaybah 11527","","","كتاب الجنائز"
"11528","(۱۱۵۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ إیَاسٍ ، عَنْ إبْرَاہِیمَ ، وَعَنْ أَبِی الْحَصِینِ ، عَنِ الشَّعْبِیِّ قَالاَ : لَیْسَ فِی الْجِنَازَۃِ قِرَائَۃٌ۔","","Musannaf Ibn Abi Shaybah 11528","","","كتاب الجنائز"
"11529","(۱۱۵۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، وَعَطَائٍ أَنَّہُمَا کَانَا یُنْکِرَانِ الْقِرَائَۃَ عَلَی الْجِنَازَۃِ۔","","Musannaf Ibn Abi Shaybah 11529","","","كتاب الجنائز"
"11530","(۱۱۵۳۰) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ إِسْحَاقَ بْنِ سُوَیْد ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ ؟ قَالَ : لاَ أَعْلَمُ فِیہَا قِرَائَۃً۔","","Musannaf Ibn Abi Shaybah 11530","","","كتاب الجنائز"
"11531","(۱۱۵۳۱) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ مَعْقِلٍ ، قَالَ : سَأَلْتُ مَیْمُونًا عَلَی الْجِنَازَۃِ قِرَائَۃٌ ، أَوْ صَلاَۃٌ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : مَا عَلِمْت۔","","Musannaf Ibn Abi Shaybah 11531","","","كتاب الجنائز"
"11532","(۱۱۵۳۲) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ بْنِ أَبِی سَارَۃَ ، قَالَ : سَأَلْتُ سَالِمًا فَقُلْت : الْقِرَائَۃُ عَلَی الْجِنَازَۃِ ؟ فَقَالَ : لاَ قِرَائَۃَ عَلَی الْجِنَازَۃِ۔","","Musannaf Ibn Abi Shaybah 11532","","","كتاب الجنائز"
"11533","(۱۱۵۳۳) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی مَعْبَدٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ یُسمع النَّاسَ بِالْحَمْدِ وَیُکَبِّرُ عَلَی الْجِنَازَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 11533","","","كتاب الجنائز"
"11534","(۱۱۵۳۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عُثْمَانَ بْنِ حَکِیمٍ ، قَالَ : حدَّثَنَا خَارِجَۃُ بْنُ زَیْدٍ ، عَنْ عَمِّہِ یَزِیدَ بْنِ ثَابِتٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی عَلَی قَبْرِ امْرَأَۃٍ فَکَبَّرَ أَرْبَعًا۔","","Musannaf Ibn Abi Shaybah 11534","","","كتاب الجنائز"
"11535","(۱۱۵۳۵) حَدَّثَنَا سَعِیدُ بْنُ یَحْیَی ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی أُمَامَۃَ بْنِ سَہْلٍ ، عَنْ أَبِیہِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی عَلَی قَبْرِ امْرَأَۃٍ فَکَبَّرَ أَرْبَعًا۔","Da'if","Musannaf Ibn Abi Shaybah 11535","","","كتاب الجنائز"
"11536","(۱۱۵۳۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سَلِیمِ بْنِ حَیَّانَ ، عَنْ سَعِیدِ بْنِ مِینَائَ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی عَلَی أَصْحَمَۃَ النَّجَّاشِی فَکَبَّرَ عَلَیْہِ أَرْبَعًا۔ (بخاری ۳۸۷۹۔ مسلم ۶۴)","Sahih","Musannaf Ibn Abi Shaybah 11536","","","كتاب الجنائز"
"11537","(۱۱۵۳۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَرَجَ إلَی الْبَقِیعِ فَصَلَّی عَلَی النَّجَاشِیِّ فَکَبَّرَ عَلَیْہِ أَرْبَعًا۔","","Musannaf Ibn Abi Shaybah 11537","","","كتاب الجنائز"
"11538","(۱۱۵۳۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّ النَّجَاشِیَّ قَدْ مَاتَ ، فَخَرَجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَصْحَابہ إلَی الْبَقِیعِ ، فَصَفَفْنَا خَلْفَہُ ، وَتَقَدَّمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَکَبَّرَ أَرْبَعَ تَکْبِیرَاتٍ۔n(بخاری ۱۳۳۳۔ مسلم ۶۲)","Sahih","Musannaf Ibn Abi Shaybah 11538","","","كتاب الجنائز"
"11539","(۱۱۵۳۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ووَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، قَالَ : مَاتَتْ زَیْنَبُ بِنْتُ جَحْشٍ فَکَبَّرَ عَلَیْہَا عُمَرُ أَرْبَعًا ، ثُمَّ سَأَلَ أَزْوَاجَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَنْ یُدْخِلُہَا قَبْرَہَا فَقُلْنَ مَنْ کَانَ یَدْخُلُ عَلَیْہَا فِی حَیَاتِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 11539","","","كتاب الجنائز"
"11540","(۱۱۵۴۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ سَلْعٍ ، عَنْ عَبْدِ خَیْرٍ ، قَالَ : قُبِضَ عَلِیٌّ وَہُوَ یُکَبِّرُ أَرْبَعًا۔","Sahih","Musannaf Ibn Abi Shaybah 11540","","","كتاب الجنائز"
"11541","(۱۱۵۴۱) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عُمَیْرِ بْنِ سَعِیدٍ ، قَالَ : صَلَّیْت خَلْفَ عَلِیٍّ عَلَی یَزِیدَ بْنِ الْمُکَفِّفِ فَکَبَّرَ عَلَیْہِ أَرْبَعًا۔","","Musannaf Ibn Abi Shaybah 11541","","","كتاب الجنائز"
"11542","(۱۱۵۴۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ عُمَیْرٍ ، عَنْ عَلِیٍّ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 11542","","","كتاب الجنائز"
"11543","(۱۱۵۴۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : سُئِلَ عَبْدُ اللہِ ، عَنِ التَّکْبِیرِ عَلَی الْجَنَائِزِ ، فَقَالَ: کُلُّ ذَلِکَ قَدْ صُنِعَ وَرَأَیْت النَّاسَ قَدْ أَجْمَعُوا عَلَی أَرْبَعٍ۔","","Musannaf Ibn Abi Shaybah 11543","","","كتاب الجنائز"
"11544","(۱۱۵۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ وَسُفْیَانَ وَشُعْبَۃُ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ ، عَنْ أَبِی عَطِیَّۃَ ، قَالَ : قَالَ عَبْدُ اللہِ التَّکْبِیرُ عَلَی الْجَنَائِزِ أَرْبَعُ تَکْبِیرَاتٍ بِتَکْبِیرِ الْخُرُوجِ۔","Sahih","Musannaf Ibn Abi Shaybah 11544","","","كتاب الجنائز"
"11545","(۱۱۵۴۵) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ ، عَنْ مُہَاجِر أَبِی الْحَسَنَ ، قَالَ: صَلَّیْت خَلْفَ الْبَرَائِ عَلَی جِنَازَۃٍ فَکَبَّرَ أَرْبَعًا۔","Sahih","Musannaf Ibn Abi Shaybah 11545","","","كتاب الجنائز"
"11546","(۱۱۵۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُلَیٍّ ، عَنْ أَبِیہِ ، عَنْ عُقْبَۃَ بْنِ عَامِرٍ ، قَالَ سَأَلَہُ رَجُلٌ عَنِ التَّکْبِیرِ عَلَی الْجِنَازَۃِ ، فَقَالَ : أَرْبَعًا فَقُلْت اللَّیْلُ وَالنَّہَارُ سَوَائٌ ، قَالَ : فَقَالَ : اللَّیْلُ وَالنَّہَارُ سَوَائٌ۔","Sahih","Musannaf Ibn Abi Shaybah 11546","","","كتاب الجنائز"
"11547","(۱۱۵۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زَیْدِ بْنِ طَلْحَۃَ ، قَالَ : شَہِدْت ابْنَ عَبَّاسٍ کَبَّرَ عَلَی جِنَازَۃٍ أَرْبَعًا۔","Sahih","Musannaf Ibn Abi Shaybah 11547","","","كتاب الجنائز"
"11548","(۱۱۵۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ ثَابِتِ بْنِ عُبَیْدٍ ، أَنَّ زَیْدَ بْنَ ثَابِتٍ کَبَّرَ أَرْبَعًا وَأَنَّ أَبَا ہُرَیْرَۃَ کَبَّرَ أَرْبَعًا۔","","Musannaf Ibn Abi Shaybah 11548","","","كتاب الجنائز"
"11549","(۱۱۵۴۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَبِی الْعَنْبَسِ ، عَنْ أَبِیہِ ، قَالَ : صَلَّیْت خَلْفَ أَبِی ہُرَیْرَۃَ عَلَی جِنَازَۃٍ فَکَبَّرَ عَلَیْہَا أَرْبَعًا۔","Da'if","Musannaf Ibn Abi Shaybah 11549","","","كتاب الجنائز"
"11550","(۱۱۵۵۰) حَدَّثَنَا حَفْصُ ، عَنْ عَطِیَّۃَ بْنِ الْحَارِثِ أَبِی رَوْقٍ ، عَنْ مَوْلًی لِلْحَسَنِ بْنِ عَلِیٍّ ، أَنَّ الْحَسَنَ بْنَ علِیٍّ صَلَّی عَلَی عَلِیٍّ فَکَبَّرَ عَلَیْہِ أَرْبَعًا۔","Da'if","Musannaf Ibn Abi Shaybah 11550","","","كتاب الجنائز"
"11551","(۱۱۵۵۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ، عَنْ حَجَّاجٍ، عَنْ نَافِعٍ، أَنَّ ابْنَ عُمَرَ کَانَ لاَ یَزِیدُ عَلَی أَرْبَعِ تَکْبِیرَاتٍ عَلَی الْمَیِّتِ۔","","Musannaf Ibn Abi Shaybah 11551","","","كتاب الجنائز"
"11552","(۱۱۵۵۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ عُثْمَانَ بْنِ عَبْدِ اللہِ بْنِ مَوْہَبٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 11552","","","كتاب الجنائز"
"11553","(۱۱۵۵۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ عَبْدِ اللہِ بْنِ مَعْقِلٍ ، قَالَ : کَبَّرَ عَلِیٌّ فِی سُلْطَانِہِ أَرْبَعًا أَرْبَعًا ہَاہُنَا إِلاَّ عَلَی سَہْلِ بْنِ حُنَیْفٍ، فَإِنَّہُ کَبَّرَ عَلَیْہِ سِتًّا، ثُمَّ الْتَفَتَ إلَیْہِمْ، فَقَالَ: إِنَّہُ بَدْرِیٌّ۔","Da'if","Musannaf Ibn Abi Shaybah 11553","","","كتاب الجنائز"
"11554","(۱۱۵۵۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : کُنَّا نُکَبِّرُ عَلَی الْمَیِّتِ خَمْسًا وَسِتًّا ، ثُمَّ اجْتَمَعْنَا عَلَی أَرْبَعِ تَکْبِیرَاتٍ۔","","Musannaf Ibn Abi Shaybah 11554","","","كتاب الجنائز"
"11555","(۱۱۵۵۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَوْنٍ ، أَنَّ مُحَمَّدًا کَبَّرَ أَرْبَعًا۔","","Musannaf Ibn Abi Shaybah 11555","","","كتاب الجنائز"
"11556","(۱۱۵۵۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عِمْرَانَ بْنِ أَبِی عَطَائٍ ، قَالَ : شَہِدْت وَفَاۃَ ابْنِ عَبَّاسٍ فَوَلاَہُ ابْنُ الْحَنَفِیَّۃِ فَکَبَّرَ عَلَیْہِ أَرْبَعًا۔","","Musannaf Ibn Abi Shaybah 11556","","","كتاب الجنائز"
"11557","(۱۱۵۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، أَنَّہُ کَانَ یُکَبِّرُ عَلَی الْجِنَازَۃِ أَرْبَعًا۔","","Musannaf Ibn Abi Shaybah 11557","","","كتاب الجنائز"
"11558","(۱۱۵۵۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الْہَجَرِیِّ ، قَالَ : صَلَّیْت مَعَ عَبْدِ اللہِ بْنِ أَبِی أَوْفَی عَلَی جِنَازَۃٍ فَکَبَّرَ عَلَیْہَا أَرْبَعًا ، ثُمَّ قَامَ ہُنَیْہَۃً حَتَّی ظَنَنْت أَنَّہُ یُکَبِّرُ خَمْسًا ، ثُمَّ سَلَّمَ ، فَقَالَ : أَکُنْتُمْ تُرَوْنَ أَنِّی أُکَبِّرُ خَمْسًا إنَّمَا قُمْت کَمَا رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَامَ۔ (احمد ۴/۳۵۶۔ عبدالرزاق۶۴۰۴)","Da'if","Musannaf Ibn Abi Shaybah 11558","","","كتاب الجنائز"
"11559","(۱۱۵۵۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ اللہِ بْنِ جُمَیْعٍ ، قَالَ : رَأَیْتُ إبْرَاہِیمَ صَلَّی عَلَی جِنَازَۃٍ فَکَبَّرَ أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 11559","","","كتاب الجنائز"
"11560","(۱۱۵۶۰) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَنْ عُمَرِ بْنِ أَبِی زَائِدَۃَ ، قَالَ : صَلَّیْت خَلْفَ قَیْسِ بْنِ أَبِی حَازِمٍ عَلَی جِنَازَۃٍ فَکَبَّرَ أَرْبَعًا۔","","Musannaf Ibn Abi Shaybah 11560","","","كتاب الجنائز"
"11561","(۱۱۵۶۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ : قَالَ عُمَرُ کُلٌّ قَدْ فَعَلَ فَقَالُوا : فتعالوا نَجْتَمِعُ عَلَی أَمْرٍ یَأْخُذُ بِہِ مَنْ بَعْدَنَا فَکَبَّرُوا عَلَی الْجِنَازَۃِ أَرْبَعًا۔","","Musannaf Ibn Abi Shaybah 11561","","","كتاب الجنائز"
"11562","(۱۱۵۶۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَمْرِو بْنِ مُہَاجِر ، قَالَ : صَلیتُ خَلفَ وَاثِلَۃَ فَکَبَّرَ أَرْبَعًا۔","Hasan","Musannaf Ibn Abi Shaybah 11562","","","كتاب الجنائز"
"11563","(۱۱۵۶۳) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنْ أَبِی الْخَصِیبِ ، أَنَّ سُوَیْدًا صَلَّی عَلَی جِنَازَۃٍ فَکَبَّرَ أَرْبَعًا۔","Hasan","Musannaf Ibn Abi Shaybah 11563","","","كتاب الجنائز"
"11564","(۱۱۵۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَامِرِ بْنِ شَقِیقٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : جَمَعَ عُمَرُ النَّاسَ فَاسْتَشَارَہُمْ فِی التَّکْبِیرِ عَلَی الْجِنَازَۃِ ، فَقَالَ بَعْضُہُمْ کَبَّرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَمْسًا ، وَقَالَ بَعْضُہُمْ کَبَّرَ سَبْعًا ، وَقَالَ بَعْضُہُمْ کَبَّرَ أَرْبَعًا ، قَالَ فَجَمَعَہُمْ عَلَی أَرْبَعِ تَکْبِیرَاتٍ کَأَطْوَلِ الصَّلاَۃِ۔ (عبدالرزاق ۶۳۹۵)","Hasan","Musannaf Ibn Abi Shaybah 11564","","","كتاب الجنائز"
"11565","(۱۱۵۶۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، قَالَ : قَالَ إبْرَاہِیمُ اخْتَلَفَ أصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی التَّکْبِیرِ عَلَی الْجِنَازَۃِ ، ثُمَّ اتَّفَقُوا بَعْدُ عَلَی أَرْبَعِ تَکْبِیرَاتٍ۔","","Musannaf Ibn Abi Shaybah 11565","","","كتاب الجنائز"
"11566","(۱۱۵۶۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، عَنْ زَیْدِ بْنِ أَرَقْمَ ، أَنَّہُ صَلَّی عَلَی مَیِّتٍ فَکَبَّرَ عَلَیْہِ خَمْسًا۔","Sahih","Musannaf Ibn Abi Shaybah 11566","","","كتاب الجنائز"
"11567","(۱۱۵۶۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : کَانَ زَیْدٌ یُکَبِّرُ عَلَی جَنَائِزِنَا أَرْبَعًا وَأَنَّہُ کَبَّرَ عَلَی جِنَازَۃٍ خَمْسًا فَسَأَلْتُہُ ، فَقَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُکَبِّرُہَا۔ (مسلم ۷۲۔ ابوداؤد ۳۱۸۹)","","Musannaf Ibn Abi Shaybah 11567","","","كتاب الجنائز"
"11568","(۱۱۵۶۸) حَدَّثَنَا وَکِیعٌ وَالْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ شُعْبَۃَ ، عَنِ الْمِنْہَالِ ، عَنْ زِرٍّ ، أَنَّ ابْنَ مَسْعُودٍ کَبَّرَ عَلَی رَجُلٍ مِنْ بلعدان خَمْسًا۔","Sahih","Musannaf Ibn Abi Shaybah 11568","","","كتاب الجنائز"
"11569","(۱۱۵۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلْقَمَۃَ بْنِ قَیْسٍ ، أَنَّہُ قَدِمَ مِنَ الشَّامِ ، فَقَالَ : لِعَبْدِ اللہِ إنِّی رَأَیْت مُعَاذَ بْنَ جَبَلٍ وَأَصْحَابَہُ بِالشَّامِ یُکَبِّرُونَ عَلَی الْجَنَائِزِ خَمْسًا فَوَقّتَوا لَنَا وَقْتًَا نُتَابِعُکُمْ عَلَیْہِ ، قَالَ: فَأَطْرَقَ عَبْدُ اللہِ سَاعَۃً ، ثُمَّ قَالَ : کَبِّرُوا مَا کَبَّرَ إمَامُکُمْ لاَ وَقْتَ ، وَلاَ عَدَدَ۔","Sahih","Musannaf Ibn Abi Shaybah 11569","","","كتاب الجنائز"
"11570","(۱۱۵۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرِ بْنِ زِیَادٍ ، عَنْ یَحْیَی بْنِ الْحَارِثِ التَّیْمِیِّ عَنْ مَوْلًی لِحُذَیْفَۃَ ، عَنْ حُذَیْفَۃَ ، أَنَّہُ کَبَّرَ عَلَی جِنَازَۃٍ خَمْسًا زَادَ فِیہِ غَیْرُ وَکِیعٍ ، ثُمَّ قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَعَلَہُ۔n(احمد ۵/۴۰۶۔ دارقطنی ۹)","Da'if","Musannaf Ibn Abi Shaybah 11570","","","كتاب الجنائز"
"11571","(۱۱۵۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ کَاتِبٍ لِعَلِیٍّ ، أَنَّ عَلِیًّا کَبَّرَ عَلَی جِنَازَۃٍ خَمْسًا۔","Da'if","Musannaf Ibn Abi Shaybah 11571","","","كتاب الجنائز"
"11572","(۱۱۵۷۲) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ أَیُّوبَ بْنِ النُّعْمَانِ، قَالَ: صَلَّیْت خَلْفَ زَیْدِ بْنِ أَرَقْمَ عَلَی جِنَازَۃٍ فَکَبَّرَ عَلَیْہَا خَمْسًا۔","Da'if","Musannaf Ibn Abi Shaybah 11572","","","كتاب الجنائز"
"11573","(۱۱۵۷۳) حَدَّثَنَا حَفْصٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ سَلْعٍ ، عَنْ عَبْدِ خَیْرٍ ، قَالَ : کَانَ عَلِیٌّ یُکَبِّرُ عَلَی أَہْلِ بَدْرٍ سِتًّا ، وَعَلَی أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَمْسًا وَعَلَی سَائِرِ النَّاسِ أَرْبَعًا۔","Sahih","Musannaf Ibn Abi Shaybah 11573","","","كتاب الجنائز"
"11574","(۱۱۵۷۴) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی مَعْبَدٍ ، قَالَ : کَانَ ابْنُ عَبَّاسٍ یَجْمَعُ النَّاسَ بِالْحَمْدِ وَیُکَبِّرُ عَلَی الْجِنَازَۃِ ثَلاَثًا۔","Sahih","Musannaf Ibn Abi Shaybah 11574","","","كتاب الجنائز"
"11575","(۱۱۵۷۵) حَدَّثَنَا مُعَاذٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، قَالَ : صَلَّیْت مَعَ أَنَسِ بْنِ مَالِکٍ عَلَی جِنَازَۃٍ فَکَبَّرَ عَلَیْہَا ثَلاَثًا لَمْ یَزِدْ عَلَیْہَا ، ثُمَّ انْصَرَفَ۔","Sahih","Musannaf Ibn Abi Shaybah 11575","","","كتاب الجنائز"
"11576","(۱۱۵۷۶) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنِ الْقَاسِمِ ، قَالَ : أَخْبَرَنِی أَبِی ، أَنَّہُ صَلَّی عَلَی جِنَازَۃٍ ، فَقَالَ لَہُ جَابِرُ بْنُ زَیْدٍ تَقَدَّمْ ، فَکَبِّرْ عَلَیْہَا ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 11576","","","كتاب الجنائز"
"11577","(۱۱۵۷۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی حَمْزَۃَ فَکَبَّرَ عَلَیْہِ تِسْعًا ، ثُمَّ جِیئَ بِالأُخْرَی فَکَبَّرَ عَلَیْہَا سَبْعًا ، ثُمَّ جِیئَ بِالأُخْرَی فَکَبَّرَ عَلَیْہَا خَمْسًا حَتَّی فَرَغَ عَنْہُنَّ غَیْرَ أَنَّہُنَّ وِتْرٌ۔ (بیہقی ۱۳۔ ابن سعد ۱۶)","Da'if","Musannaf Ibn Abi Shaybah 11577","","","كتاب الجنائز"
"11578","(۱۱۵۷۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ووَکِیعٌ قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ مُوسَی بْنِ عَبْدِ اللہِ بْنِ یَزِیدَ ، قَالَ : صَلَّی عَلِیٌّ عَلَی أَبِی قَتَادَۃَ فَکَبَّرَ عَلَیْہِ سَبْعًا۔","","Musannaf Ibn Abi Shaybah 11578","","","كتاب الجنائز"
"11579","(۱۱۵۷۹) حدثت عن جَرِیر ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یُزَادُ عَلَی سَبْعِ تَکْبِیرَاتٍ ، وَلاَ تُنْقَصُ مِنْ أَرْبَعٍ۔","","Musannaf Ibn Abi Shaybah 11579","","","كتاب الجنائز"
"11580","(۱۱۵۸۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ أَبِی مَالِکٍ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی حَمْزَۃَ فَجَعَلُوا یَرْفَعُونَ وَحَمْزَۃُ بَیْنَ أَیْدِیہِمْ حَتَّی فَرَغَ مِنَ الصَّلاَۃِ عَلَیْہِمْ۔ (ابن سعد ۱۶۔ ابوداؤد ۴۳۵)","","Musannaf Ibn Abi Shaybah 11580","","","كتاب الجنائز"
"11581","(۱۱۵۸۱) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ أَبِی مَالِکٍ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی حَمْزَۃَ ، فَکَانَ یُجَائُ بِتِسْعَۃٍ فَیُوضَعُونَ مَعَہُ ، فَیُصَلِّی عَلَیْہِمْ ، ثُمَّ یُرْفَعُونَ وَیُتْرَکُ ، وَیُجَائُ بِتِسْعَۃٍ آخَرِینَ ، فَلَمْ یَزَلْ کَذَلِکَ حَتَّی صَلَّی عَلَیْہِمْ جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 11581","","","كتاب الجنائز"
"11582","(۱۱۵۸۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: أَخْبَرَنَا حُصَیْنٌ ، عَنِ الشَّعْبِیِّ؛ أَنَّ عَلِیًّا صَلَّی عَلَی سَہْلِ بْنِ حُنَیْفٍ فَکَبَّرَ عَلَیْہِ سِتًّا۔","Sahih","Musannaf Ibn Abi Shaybah 11582","","","كتاب الجنائز"
"11583","(۱۱۵۸۳) حَدَّثَنَا معتمرُ بْنُ سُلَیْمَانَ ، عَنْ إِسْحَاقَ بْنِ سُوَیْد ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ ، قَالَ : لاَ یُنْقَصُ مِنْ ثَلاَثِ تَکْبِیرَاتٍ ، وَلاَ یُزَادُ عَلَی سَبْعٍ۔","Sahih","Musannaf Ibn Abi Shaybah 11583","","","كتاب الجنائز"
"11584","(۱۱۵۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ ابْنِ الأَصْبَہَانِیِّ ، عَنْ عَبْدِ اللہِ بْنِ مُغَفَّلٍ ، عَنْ عَلِیٍّ ، أَنَّہُ کَبَّرَ عَلَی سَہْلِ بْنِ حُنَیْفٍ سِتًّا۔ (بخاری ۴۰۰۴)","Sahih","Musannaf Ibn Abi Shaybah 11584","","","كتاب الجنائز"
"11585","(۱۱۵۸۵) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا إسْمَاعِیلُ، عَنِ الشَّعْبِیِّ، عَنِ ابْنِ مُغَفَّلٍ، أَنَّ عَلِیًّا کَبَّرَ عَلَی سَہْلِ بْنِ حُنَیْفٍ سِتًّا۔","Sahih","Musannaf Ibn Abi Shaybah 11585","","","كتاب الجنائز"
"11586","(۱۱۵۸۶) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ الْمَوْصِلِیُّ ، عَنْ مُغِیرَۃَ بْنِ زِیَادٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا خِفْتَ أَنْ تَفُوتَکَ الْجِنَازَۃُ وَأَنْتَ عَلَی غَیْرِ وُضُوئٍ فَتَیَمَّمْ وَصَلِّ۔","Hasan","Musannaf Ibn Abi Shaybah 11586","","","كتاب الجنائز"
"11587","(۱۱۵۸۷) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ أَبِی الزَّعْرَائِ ، عَنْ عِکْرِمَۃَ ، قَالَ : إذَا فَجَأَتْک الْجِنَازَۃُ وَأَنْتَ عَلَی غَیْرِ وُضُوئٍ فَتَیَمَّمْ وَصَلِّ عَلَیْہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 11587","","","كتاب الجنائز"
"11588","(۱۱۵۸۸) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا فَجَأَتْک الْجِنَازَۃُ وَلَسْت عَلَی وُضُوئٍ ، فَإِنْ کَانَ عِنْدَکَ مَائٌ فَتَوَضَّأْ وَصَلِّ وَإِنْ لَمْ یَکُنْ عِنْدَکَ مَائٌ فَتَیَمَّمْ وَصَلِّ۔","","Musannaf Ibn Abi Shaybah 11588","","","كتاب الجنائز"
"11589","(۱۱۵۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ وَمَنْصُورٌ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَتَیَمَّمُ إذَا خَشِیَ الْفَوْتَ۔","","Musannaf Ibn Abi Shaybah 11589","","","كتاب الجنائز"
"11590","(۱۱۵۹۰) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ، عَنْ عَبْدِ الْمَلِکِ، عَنْ عَطَائٍ، قَالَ: إذَا خِفْت أَنْ تَفُوتَکَ الْجِنَازَۃُ فَتَیَمَّمْ وَصَلِّ۔","","Musannaf Ibn Abi Shaybah 11590","","","كتاب الجنائز"
"11591","(۱۱۵۹۱) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ وحَمَّاد ، عَنْ إبْرَاہِیمَ قَالَ : إذَا خَافَ أَنْ تَفُوتَہ الصَّلاَۃُ عَلَی الْجِنَازَۃِ تَیَمَّمْ۔","","Musannaf Ibn Abi Shaybah 11591","","","كتاب الجنائز"
"11592","(۱۱۵۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : یَتَیَمَّمُ إذَا خَشِیَ الْفَوْتَ۔","","Musannaf Ibn Abi Shaybah 11592","","","كتاب الجنائز"
"11593","(۱۱۵۹۳) حَدَّثَنَا یَحْیَی بْنُ عَبْدِ الْمَلِکِ بْنِ أَبِی غَنِیَّۃَ عن أبیہ ، عَنِ الْحَکَمِ ، قَالَ : إذَا خِفْتَ أَنْ تَفُوتَکَ الصَّلاَۃُ وَأَنْتَ عَلَی غَیْرِ وُضُوئٍ فَتَیَمَّمْ۔","","Musannaf Ibn Abi Shaybah 11593","","","كتاب الجنائز"
"11594","(۱۱۵۹۴) حَدَّثَنَا أَبُو دَاوُدَ، عَنْ شَیْبَانَ، عَنْ جَابِرٍ، عن سَالِمٍ، قَالَ: یَتَیَمَّمُ، وَقَالَ الْقَاسِمُ: لاَ یُصَلِّی عَلَیْہَا حَتَّی یَتَوَضَّأَ۔","","Musannaf Ibn Abi Shaybah 11594","","","كتاب الجنائز"
"11595","(۱۱۵۹۵) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یَتَیَمَّمُ ، وَلاَ یُصَلِّی إِلاَّ عَلَی طُہْرٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 11595","","","كتاب الجنائز"
"11596","(۱۱۵۹۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَحْضُرُ الْجِنَازَۃَ فَیَخَافُ أَنْ تَفُوتَہُ الصَّلاَۃُ عَلَیْہَا ، قَالَ : لاَ یَتَیَمَّمُ۔","","Musannaf Ibn Abi Shaybah 11596","","","كتاب الجنائز"
"11597","(۱۱۵۹۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : یَتَیَمَّمُ وَیُصَلِّی عَلَیْہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 11597","","","كتاب الجنائز"
"11598","(۱۱۵۹۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، قَالَ: أَخْبَرَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ؛ فِی الرَّجُلِ یَحْضُرُ الْجِنَازَۃَ وَہُوَ عَلَی غَیْرِ وُضُوئٍ ، قَالَ : یُصَلِّی عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 11598","","","كتاب الجنائز"
"11599","(۱۱۵۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسمَاعِیل وَمُطِیعٌ ، عَنِ الشَّعْبِیِّ ، قَالَ : یُصَلِّی عَلَیْہَا زَادَ فِیہِ مُطِیعٌ لَیْسَ فِیہِ رُکُوعٌ ، وَلاَ سُجُودٌ۔","","Musannaf Ibn Abi Shaybah 11599","","","كتاب الجنائز"
"11600","(۱۱۶۰۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ لَمْ یَکُنْ یَقْضِی مَا فَاتَہُ مِنَ التَّکْبِیرِ عَلَی الْجِنَازَۃِ۔","","Musannaf Ibn Abi Shaybah 11600","","","كتاب الجنائز"
"11601","(۱۱۶۰۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا فَاتَتْک تَکْبِیرَۃٌ ، أَوْ تَکْبِیرَتَانِ عَلَی الْجِنَازَۃِ فَبَادِرْ فَکَبِّرْ مَا فَاتَکَ قَبْلَ أَنْ تُرْفَعَ۔","","Musannaf Ibn Abi Shaybah 11601","","","كتاب الجنائز"
"11602","(۱۱۶۰۲) حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ قَارِظِ بْنِ شَیْبَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ یَبْنِی عَلَی مَا فَاتَہُ مِنَ التَّکْبِیرِ عَلَی الْجِنَازَۃِ۔","","Musannaf Ibn Abi Shaybah 11602","","","كتاب الجنائز"
"11603","(۱۱۶۰۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، قَالَ : یُکَبِّرُ مَا أَدْرَکَ وَیَقْضِی مَا سَبَقَہُ ، وَقَالَ الْحَسَنُ : یُکَبِّرُ مَا أَدْرَکَ ، وَلاَ یَقْضِی مَا سَبَقَہُ۔","","Musannaf Ibn Abi Shaybah 11603","","","كتاب الجنائز"
"11604","(۱۱۶۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، وَعَطَائٍ قَالاَ : لاَ تَقْضِی مَا فَاتَکَ مِنَ التَّکْبِیرِ عَلَی الْجِنَازَۃِ۔","","Musannaf Ibn Abi Shaybah 11604","","","كتاب الجنائز"
"11605","(۱۱۶۰۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، قَالَ : یَقْضِی۔","","Musannaf Ibn Abi Shaybah 11605","","","كتاب الجنائز"
"11606","(۱۱۶۰۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، قَالَ : یُکَبِّرُ مَا أَدْرَکَ ، وَلاَ یَقْضِی مَا فَاتَہُ۔","","Musannaf Ibn Abi Shaybah 11606","","","كتاب الجنائز"
"11607","(۱۱۶۰۷) حَدَّثَنَا أَبُو أَحْمَدَ مُحَمَّدُ بْنُ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، عَنْ مُبَارَکٍ ، عَنْ یَعْقُوبَ ، عَنْ مَطَرٍ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : یَقْضِی مَا فَاتَہُ مِنَ التَّکْبِیرِ عَلَی الْجِنَازَۃِ۔","","Musannaf Ibn Abi Shaybah 11607","","","كتاب الجنائز"
"11608","(۱۱۶۰۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ ، أَنَّہُ کَانَ یَقُولُ : إذَا انْتَہَی الرَّجُلُ إلَی الْجِنَازَۃِ وَقَدْ سُبِقَ بِبَعْضِ التَّکْبِیرِ لَمْ یُکَبِّرْ حَتَّی یُکَبِّرَ الإِمَامُ۔","No Data Available","Musannaf Ibn Abi Shaybah 11608","","","كتاب الجنائز"
"11609","(۱۱۶۰۹) حَدَّثَنَا مُعَاذٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ؛ فِی الرَّجُلِ یَنْتَہِی إلَی الْجِنَازَۃِ وَہُمْ یُصَلُّونَ عَلَیْہَا، قَالَ: یَدْخُلُ مَعَہُمْ بِتَکْبِیرَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 11609","","","كتاب الجنائز"
"11610","(۱۱۶۱۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ لاَ یَجْہَرُ بِالتَّسْلِیمِ عَلَی الْجِنَازَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11610","","","كتاب الجنائز"
"11611","(۱۱۶۱۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ إذَا صَلَّی عَلَی الْجِنَازَۃِ رَفَعَ یَدَیْہِ فَکَبَّرَ ، فَإِذَا فَرَغَ سَلَّمَ عَلَی یَمِینِہِ وَاحِدَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 11611","","","كتاب الجنائز"
"11612","(۱۱۶۱۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ عُمَیْرِ بْنِ سَعید ، قَالَ : صَلَّی عَلِیٌّ عَلَی یَزِیدَ بْنِ الْمُکَفِّفِ فَکَبَّرَ عَلَیْہِ أَرْبَعًا ، وَسَلَّمَ تَسْلِیمَۃً خَفِیَّۃً عَنْ یَمِینِہِ۔","","Musannaf Ibn Abi Shaybah 11612","","","كتاب الجنائز"
"11613","(۱۱۶۱۳) حَدَّثَنَا وَکِیعٌ وَالْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ یُسَلِّمُ عَلَی الْجِنَازَۃِ تَسْلِیمَۃً۔","Hasan","Musannaf Ibn Abi Shaybah 11613","","","كتاب الجنائز"
"11614","(۱۱۶۱۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، قَالَ : صَلَّیْت خَلْفَہُ عَلَی جِنَازَۃٍ ، فَسَلَّمَ عَنْ یَمِینِہِ حِینَ فَرَغَ السَّلاَمُ عَلَیْکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 11614","","","كتاب الجنائز"
"11615","(۱۱۶۱۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یُسَلِّمُ عَلَی الْجِنَازَۃِ تَسْلِیمَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 11615","","","كتاب الجنائز"
"11616","(۱۱۶۱۶) حَدَّثَنَا جَرِیرٌ، عَنِ الشَّیْبَانِیِّ، عَنْ عَبْدِالْمَلِکِ بْنِ إیَاسٍ، عَنْ إبْرَاہِیمَ، قَالَ: تَسْلیم السَّہو وَالْجِنَازَۃِ وَاحِد۔","","Musannaf Ibn Abi Shaybah 11616","","","كتاب الجنائز"
"11617","(۱۱۶۱۷) حَدَّثَنَا حَفْصُ، عَنِ الشَّیْبَانِیِّ، عَنْ عَبْدِالْمَلِکِ بْنِ إیَاسٍ، عَنْ إبْرَاہِیمَ، قَالَ: سَلِّم عَلَی الْجِنَازَۃِ تَسْلِیمَۃً۔","","Musannaf Ibn Abi Shaybah 11617","","","كتاب الجنائز"
"11618","(۱۱۶۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَمَّام عَنْ ہِلاَلِ بن مَزیدٍ ، قَالَ : صَلَّیْت خَلْفَ جَابِرِ بْنِ زَیْدٍ فَسَلَّمَ تَسْلِیمَۃً أَوَّلُہَا عَنْ یَمِینِہِ ، وَآخِرُہَا عَنْ یسارہ۔","","Musannaf Ibn Abi Shaybah 11618","","","كتاب الجنائز"
"11619","(۱۱۶۱۹) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، قَالَ : صَلَّی ابْنُ سِیرِینَ فَسَلَّمَ تَسْلِیمَۃً فَأَسْمَعَ عَلَی الْجِنَازَۃِ۔","","Musannaf Ibn Abi Shaybah 11619","","","كتاب الجنائز"
"11620","(۱۱۶۲۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَبِی الْعَنْبَسِ ، عَنْ أَبِیہِ ، أَنَّہُ قَالَ : صَلَّیْت خَلْفَ أَبِی ہُرَیْرَۃَ عَلَی جِنَازَۃٍ فَکَبَّرَ عَلَیْہَا أَرْبَعًا ، وَسَلَّمَ عَنْ یَمِینِہِ تَسْلِیمَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 11620","","","كتاب الجنائز"
"11621","(۱۱۶۲۱) حَدَّثَنَا وَکِیعٌ وَالْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورِ بْنِ حَیَّانَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّہُ کَانَ یُسَلِّمُ عَلَی الْجِنَازَۃِ تَسْلِیمَۃً۔","","Musannaf Ibn Abi Shaybah 11621","","","كتاب الجنائز"
"11622","(۱۱۶۲۲) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : یُسَلِّمُ تَسْلِیمَۃً تِلْقَائَ وَجْہِہِ ، وَیَرُدُّ مَنْ خَلْفَ الإِمَامِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11622","","","كتاب الجنائز"
"11623","(۱۱۶۲۳) حَدَّثَنَا عَبْدُاللہِ بْنُ نُمَیْرٍ، عَنْ حُرَیْثٍ، قَالَ: رَأَیْتُ عَامِرًا صَلَّی عَلَی جِنَازَۃٍ فَسَلَّمَ عَنْ یَمِینِہِ، وَعَنْ شِمَالِہِ۔","","Musannaf Ibn Abi Shaybah 11623","","","كتاب الجنائز"
"11624","(۱۱۶۲۴) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ قُطْبَۃَ ، عَنِ الأَعْمَشِ ، عَنْ یَحْیَی ، أَنَّہُ کَانَ إذَا صَلَّی عَلَی جِنَازَۃٍ سَلَّمَ تَسْلِیمَۃً وَاحِدَۃً۔","","Musannaf Ibn Abi Shaybah 11624","","","كتاب الجنائز"
"11625","(۱۱۶۲۵) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَمْرِو بْنِ مُہَاجِرٍ ، قَالَ : صَلَّیْت مَعَ وَاثِلَۃَ عَلَی سِتِّینَ جِنَازَۃً مِنَ الطَّاعُونِ ، رِجَالٍ وَنِسَائٍ ، فَکَبَّرَ أَرْبَعَ تَکْبِیرَاتٍ ، وَسَلَّمَ تَسْلِیمَۃً۔","Hasan","Musannaf Ibn Abi Shaybah 11625","","","كتاب الجنائز"
"11626","(۱۱۶۲۶) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنِی عَبْدُ اللہِ بْنُ الْعَلاَئِ ، قَالَ : صَلَّیْت خَلْفَ مَکْحُولٍ عَلَی جِنَازَۃٍ فَسَلَّمَ تَسْلِیمَۃً عَنْ یَمِینِہِ۔","","Musannaf Ibn Abi Shaybah 11626","","","كتاب الجنائز"
"11627","(۱۱۶۲۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَاصِمٍ ، قَالَ : سَأَلْتُ غُنَیْمًا قُلْتُ : أُسَلِّمُ فِی الصَّلاَۃِ عَلَی الْجِنَازَۃِ ؟ قَالَ : نَعَمْ أَلَسْت فِی الصَّلاَۃِ ؟۔","","Musannaf Ibn Abi Shaybah 11627","","","كتاب الجنائز"
"11628","(۱۱۶۲۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنِ الْحَسَنِ ، عَنْ أَبِی الْہَیْثَمِ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یُسَلِّم ُعَلَی الْجِنَازَۃِ عَنْ یَمِینِہِ ، وَعَنْ یسارہ۔","No Data Available","Musannaf Ibn Abi Shaybah 11628","","","كتاب الجنائز"
"11629","(۱۱۶۲۹) حدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : : کَانَ الْمِسْوَرُ بْنُ مَخْرَمَۃَ إذَا شَہِدَ جِنَازَۃً لَمْ یَجْلِسْ حَتَّی تُوضَعَ۔","Sahih","Musannaf Ibn Abi Shaybah 11629","","","كتاب الجنائز"
"11630","(۱۱۶۳۰) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ أَبِی الْعَنْبَسِ، عَنْ أَبِیہِ، عَنْ أَبِی ہُرَیْرَۃَ، أَنَّہُ لَمْ یَکُنْ یَقْعُدُ حَتَّی یُوضَعَ السَّرِیرُ۔","Da'if","Musannaf Ibn Abi Shaybah 11630","","","كتاب الجنائز"
"11631","(۱۱۶۳۱) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ وَکَثِیرُ بْنُ ہِشَامٍ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی سَعِیدٍ رَفَعَہُ ، قَالَ : إذَا کُنْتُمْ فِی جِنَازَۃٍ فَلاَ تَجْلِسُوا حَتَّی یُوضَعَ السَّرِیرُ۔n(ابوداؤد ۳۱۶۵۔ احمد ۳۸)","Sahih","Musannaf Ibn Abi Shaybah 11631","","","كتاب الجنائز"
"11632","(۱۱۶۳۲) حدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، وَأَبِی ہُبَیْرَۃَ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ إذَا صَحِبَ جِنَازَۃً لَمْ یَجْلِسْ حَتَّی تُوضَعَ۔","Da'if","Musannaf Ibn Abi Shaybah 11632","","","كتاب الجنائز"
"11633","(۱۱۶۳۳) حدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا وُضِعَ السَّرِیرُ فَاجْلِسْ۔","No Data Available","Musannaf Ibn Abi Shaybah 11633","","","كتاب الجنائز"
"11634","(۱۱۶۳۴) حدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ بْنِ یَحْیَی ، قَالَ : رَأَیْتُ عُرْوَۃَ بْنَ الزُّبَیْرِ فِی جِنَازَۃٍ فَاتَّکَأَ عَلَی حَائِطٍ ، فَجَعَلَ یَقُولُ : وُضِعَتِ الْجِنَازَۃُ ؟ فَلَمْ یَجْلِسْ حَتَّی وُضِعَتْ۔","","Musannaf Ibn Abi Shaybah 11634","","","كتاب الجنائز"
"11635","(۱۱۶۳۵) حدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ زُہَیْرٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ وَالشَّعْبِیِّ قَالاَ : کَانُوا یَکْرَہُونَ أَنْ یَجْلِسُوا حَتَّی تُوضَعَ الْجِنَازَۃُ عَنْ مَنَاکِبِ الرِّجَالِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11635","","","كتاب الجنائز"
"11636","(۱۱۶۳۶) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، عَنْ أَبِی حَازِمٍ ، قَالَ : مَشَیْت مَعَ الْحَسَنِ بْنِ عَلِیٍّ ، وَأَبِی ہُرَیْرَۃَ ، وَابْنِ الزُّبَیْرِ ، فَلَمَّا انْتَہَوْا إلَی الْقَبْرِ قَامُوا یَتَحَدَّثُونَ حَتَّی وُضِعَتِ الْجِنَازَۃُ ، فَلَمَّا وُضِعَتْ جَلَسُوا۔","Sahih","Musannaf Ibn Abi Shaybah 11636","","","كتاب الجنائز"
"11637","(۱۱۶۳۷) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، أَنَّہُ کَانَ لاَ یَجْلِسُ حَتَّی تُوضَعَ ، قَالَ : وَکَانَ الْحَسَنُ لاَ یَرَی بِہِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 11637","","","كتاب الجنائز"
"11638","(۱۱۶۳۸) حدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ وَاقِدِ بْنِ عَمْرِو بْنِ سَعْدِ بْنِ مُعَاذٍ ، قَالَ : کُنْتُ فِی جِنَازَۃٍ فَلَمْ أَجْلِسْ حَتَّی وُضِعَتْ إلی الأَرْضِ ، ثُمَّ أَتَیْتُ نَافِعَ بْنَ جُبَیْرٍ فَجَلَسْت إلَیْہِ ، فَقَالَ : مَا لِی لَمْ أَرَک جَلَسْت حَتَّی وُضِعَتِ الْجِنَازَۃُ فَقُلْت ذَاکَ لِحَدِیثٍ بَلَغَنِی عَنْ أَبِی سَعِیدٍ ، فَقَالَ نَافِعٌ : حَدَّثَنِی مَسْعُودُ بْنُ الْحَکَمِ ، أَنَّ عَلِیًّا حَدَّثَہُ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَامَ ، ثُمَّ قَعَدَ۔ (مسلم ۸۳۔ ابوداؤد ۳۱۶۷)","Sahih","Musannaf Ibn Abi Shaybah 11638","","","كتاب الجنائز"
"11639","(۱۱۶۳۹) حدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ أُنَیْسِ بْنِ أَبِی یَحْیَی ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ وَرَجُلاً آخَرَ یَجْلِسَانِ قَبْلَ أَنْ تُوضَعَ الْجِنَازَۃُ۔","Hasan","Musannaf Ibn Abi Shaybah 11639","","","كتاب الجنائز"
"11640","(۱۱۶۴۰) حدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، أَنَّ الْقَاسِمَ وَسَالِمًا کَانَا یَمْشِیَانِ أَمَامَ الْجِنَازَۃِ وَیَجْلِسَانِ۔","","Musannaf Ibn Abi Shaybah 11640","","","كتاب الجنائز"
"11641","(۱۱۶۴۱) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سَعِیدٍ ، أَنَّہُ رَأَی الْحَسَنَ جَلَسَ قَبْلَ أَنْ تُوضَعَ الْجِنَازَۃُ عَلَی الْقَبْرِ۔","","Musannaf Ibn Abi Shaybah 11641","","","كتاب الجنائز"
"11642","(۱۱۶۴۲) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ وَعَامِرٍ قَالاَ : لاَ بَأْسَ أَنْ یُجْلَسَ قَبْلَ أَنْ تُوضَعَ الْجِنَازَۃُ فِی الْقَبْرِ۔","","Musannaf Ibn Abi Shaybah 11642","","","كتاب الجنائز"
"11643","(۱۱۶۴۳) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنِ الْمِنْہَالِ ، عَنْ زَاذَانَ ، عَنِ الْبَرَائِ ، قَالَ : خَرَجْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی جِنَازَۃِ رَجُلٍ مِنَ الأَنْصَارِ فَانْتَہَیْنَا إلَی الْقَبْرِ وَلَمَّا یُلْحَدْ ، قَالَ : فَجَلَسَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَجَلَسْنَا حَوْلَہُ کَأَنَّمَا عَلَی رُؤُوسِنَا الطَّیْرُ۔ (ابوداؤ د۳۲۰۴۔ ابن خزیمۃ ۱۲)","Sahih","Musannaf Ibn Abi Shaybah 11643","","","كتاب الجنائز"
"11644","(۱۱۶۴۴) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنِ الْجُرَیْرِیِّ، عَنْ مُوَرِّقٍ الْعِجْلِیّ ، قَالَ: مَا أَنْتَ بِعَادِلٍ بَیْنَ أَمْرَیْنِ إِلاَّ وَجَدْت أَمْثَلَہُمَا عِنْدَ اللہِ أَیْسَرَہُمَا ، فَأَجْلِسُ فِی قِیَامِ الْجِنَازَۃِ۔","","Musannaf Ibn Abi Shaybah 11644","","","كتاب الجنائز"
"11645","(۱۱۶۴۵) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ سَعِیدٍ الْمَقْبُرِیِّ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ أَبَا ہُرَیْرَۃَ وَمَرْوَانَ یَمْشِیَانِ أَمَامَ الْجِنَازَۃِ ، ثُمَّ جَلَسَا فَجَائَ أَبُو سَعِیدٍ الْخُدْرِیُّ ، فقَالَ : قُمْ أَیُّہَا الأَمِیرُ فَقَدْ عَلِمَ ہَذَا ، یَعْنِی أَبَا ہُرَیْرَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا اتَّبَعَ الْجِنَازَۃَ لَمْ یَجْلِسْ حَتَّی تُوضَعَ۔n(بخاری ۱۳۱۰۔ مسلم ۶۶۰)","Sahih","Musannaf Ibn Abi Shaybah 11645","","","كتاب الجنائز"
"11646","(۱۱۶۴۶) حدَّثَنَا ابْنُ الْمُبَارَکِ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : کَانَ الْمِسْوَرُ بْنُ مَخْرَمَۃَ لاَ یَرْجِعُ حَتَّی یُؤْذَنَ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 11646","","","كتاب الجنائز"
"11647","(۱۱۶۴۷) حدَّثَنَا أَبُو مُعَاوِیَۃَ وَوَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، قَالَ : إذَا صَلَّیْتُمْ عَلَی الْجِنَازَۃِ فَقَدْ قَضَیْتُمْ مَا عَلَیْکُمْ ، فَخَلُّوا بَیْنَہَا وَبَیْنَ أَہْلِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 11647","","","كتاب الجنائز"
"11648","(۱۱۶۴۸) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنِ الْحَسَنِ بْنِ صَالِحٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ أبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : امْشِ مَعَ الْجِنَازَۃِ مَا شِئْت ، ثُمَّ ارْجِعْ إذَا بَدَا لَک۔","Da'if","Musannaf Ibn Abi Shaybah 11648","","","كتاب الجنائز"
"11649","(۱۱۶۴۹) حدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، أَنَّہُ کَانَ لاَ یَرَی لَہُمْ إذْنًا وَیَقُولُ : مَا سُلْطَانُہُمْ عَلَیْنَا۔","No Data Available","Musannaf Ibn Abi Shaybah 11649","","","كتاب الجنائز"
"11650","(۱۱۶۵۰) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مُوسَی بْنِ نَافِعٍ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ صَلَّی عَلَی جِنَازَۃٍ ، ثُمَّ رَجَعَ۔","","Musannaf Ibn Abi Shaybah 11650","","","كتاب الجنائز"
"11651","(۱۱۶۵۱) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ رَجُلٌ لِنَافِعٍ أَکَانَ ابْنُ عُمَرَ یَرْجِعُ مِنَ الْجِنَازَۃِ قَبْلَ أَنْ یُؤْذَنَ لَہُ بَعْدَ فَرَاغِہِمْ ، قَالَ : مَا کَانَ یَرْجِعُ حَتَّی یُؤْذَنَ لَہُ۔","","Musannaf Ibn Abi Shaybah 11651","","","كتاب الجنائز"
"11652","(۱۱۶۵۲) حدَّثَنَا شَرِیکٌ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : أَمِیرَانِ وَلَیْسَا بِأَمِیرِینَ صَاحِبُ الْجِنَازَۃِ إذَا صَلَّیْت عَلَیْہَا لَمْ تَرْجِعْ إِلاَّ بِإِذْنِہِ وَالْمَرْأَۃُ الْحَاجَّۃُ عَلَی رُفْقَتِہَا إذَا حَاضَتْ۔","No Data Available","Musannaf Ibn Abi Shaybah 11652","","","كتاب الجنائز"
"11653","(۱۱۶۵۳) حدَّثَنَا وَکِیعٌ ، عَنْ أَبِی جَنَابٍ ، عَنْ طَلْحَۃَ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ، قَالَ : أَمِیرَانِ وَلَیْسَا بِأَمِیرِینَ صَاحِبُ الْجِنَازَۃِ وَالْحَائِضُ فِی الرُّفْقَۃِ۔","","Musannaf Ibn Abi Shaybah 11653","","","كتاب الجنائز"
"11654","(۱۱۶۵۴) حدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ طَلْحَۃَ ، عَنْ عُمَرَ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 11654","","","كتاب الجنائز"
"11655","(۱۱۶۵۵) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سَعِیدٍ بْنِ مَسْرُوقٍ ، عَنْ طَلْحَۃَ الْیَامِیِّ ، قَالَ : کَانَ یُقَالُ أَمِیرَانِ وَلَیْسَا بِآمِرَیْنِ الْجِنَازَۃُ عَلَی مَنْ یَتْبَعُہَا وَالْمَرْأَۃُ الْحَاجَّۃُ عَلَی رُفْقَتِہَا إذَا حَاضَتْ۔","","Musannaf Ibn Abi Shaybah 11655","","","كتاب الجنائز"
"11656","(۱۱۶۵۶) حدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ دَاوُدَ بْنِ أَبِی القصاف ، قَالَ : کُنْتُ مَعَ أَبِی قِلاَبَۃَ فِی جِنَازَۃٍ ، فَلَمَّا صَلَّی انْصَرَفَ ، قَالَ : فَقُلْت لَہُ قَبْلَ أَنْ یُؤْذَنَ لَکَ ، قَالَ : فَقَالَ : أَہُمْ أُمَرَائُ عَلَیْنَا۔","","Musannaf Ibn Abi Shaybah 11656","","","كتاب الجنائز"
"11657","(۱۱۶۵۷) حدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ أَبِی عَقِیلٍ ، قَالَ : قُلْتُ لَہُ عَلَی مَنْ تَبِعَ الْجِنَازَۃَ إذْنٌ ؟ قَالَ : لاَ وَلَکِنْ یَحْتَشِمُ الرَّجُلُ أَنْ یَرْجِعَ حَتَّی یُؤْذَنَ لَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 11657","","","كتاب الجنائز"
"11658","(۱۱۶۵۸) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ ثَوْرٍ ، عَنْ مَحْفُوظِ بْنِ عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: أَمِیرَانِ وَلَیْسَا بِآمِرَیْنِ : الْمَرْأَۃُ تَکُونُ مَعَ الرُّفْقَۃِ فَتَحُجُّ ، أَوْ تَعْتَمِرُ فَیُصِیبُہَا أَذًی مِنَ الْحَیْضِ ؟ قَالَ : لاَ تَنْفِرُوا حَتَّی تَطْہُرَ وَتَأْذَنَ لَہُمْ وَالرَّجُلُ یَخْرُجُ مَعَ الْجِنَازَۃِ لاَ یَرْجِعُ حَتَّی یُؤْذَنَ لَہُ ، أَوْ یَدْفِنُوہَا ، أَوْ یُوَارُوہَا۔","","Musannaf Ibn Abi Shaybah 11658","","","كتاب الجنائز"
"11659","(۱۱۶۵۹) حدَّثَنَا مَرْحُومُ بْنُ عَبْدِ الْعَزِیزِ ، عَنْ حَبِیبِ بْنِ أَبِی مُحَمَّدٍ ، قَالَ : کُنْتُ مَعَ الْحَسَنِ فِی جِنَازَۃٍ ، فَلَمَّا أُذِنَ لَہُمْ قُلْتُ لِلْحَسَنِ قَدْ أُذِنَ لَہُمْ ، قَالَ : وَہَلْ عَلَیْنَا إذْنٌ۔","","Musannaf Ibn Abi Shaybah 11659","","","كتاب الجنائز"
"11660","(۱۱۶۶۰) حدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : یَتْبَعُ الْجِنَازَۃَ مَا بَدَا لَہُ وَیَرْجِعُ إذَا بَدَا لَہُ۔","","Musannaf Ibn Abi Shaybah 11660","","","كتاب الجنائز"
"11661","(۱۱۶۶۱) حدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 11661","","","كتاب الجنائز"
"11662","(۱۱۶۶۲) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ طَلْحَۃَ ، عَنْ أَبِی حَازِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أَمِیرَانِ وَلَیْسَا بِآمِرَیْنِ الرَّجُلُ یُصَلِّی عَلَی الْجِنَازَۃِ لَیْسَ لَہُ أَنْ یَرْجِعَ إِلاَّ بِإِذْنِ أَہْلِہَا ، وَالْمَرْأَۃُ تَکُونُ مَعَ الْقَوْمِ فَتَحِیضُ قَبْلَ أَنْ تَطُوفَ بِالْبَیْتِ یَوْمَ النَّحْرِ لَیْسَ لَہُمْ أَنْ یَنْفِرُوا إِلاَّ بِإِذْنِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 11662","","","كتاب الجنائز"
"11663","(۱۱۶۶۳) حدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ حُسَیْنٍ الْمُکْتِبِ ، عَنْ عَبْدِ اللہِ بْنِ بُرَیْدَۃَ ، عَنْ سَمُرَۃََ بْنِ جُنْدُبٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی عَلَی امْرَأَۃٍ فَقَامَ وَسَطَہَا۔ (بخاری ۱۳۳۲۔ ابوداؤد ۳۱۸۸)","Sahih","Musannaf Ibn Abi Shaybah 11663","","","كتاب الجنائز"
"11664","(۱۱۶۶۴) حدَّثَنَا وَکِیعٌ ، عَنْ ہَمَّامٍ ، عَنْ غالب أو أَبِی غَالِبٍ ، عَنْ أَنَسٍ ، أَنَّہُ أُتِیَ بِجِنَازَۃِ رَجُلٍ فَقَامَ عِنْدَ رَأْسِ السَّرِیرِ وَجِیئَ بِجِنَازَۃِ امْرَأَۃٍ فَقَامَ أَسْفَلَ مِنْ ذَلِکَ عِنْدَ السَّرِیرِ ، فَقَالَ : الْعَلاَئُ بْنُ زِیَادٍ ہَکَذَا رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَصْنَعُ ، قَالَ : نَعَمْ ، ثُمَّ أَقْبَلَ عَلَیْنَا ، فَقَالَ : احْفَظُوہُ۔(ترمذی ۱۰۳۴۔ احمد ۳/۱۱۸)","Sahih","Musannaf Ibn Abi Shaybah 11664","","","كتاب الجنائز"
"11665","(۱۱۶۶۵) حدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ یَزِیدَ بْنِ أَبِی مَنْصُورٍ ، قَالَ : قُلْتُ لأَبِی رَافِعٍ أَیْنَ أَقُومُ مِنَ الْجِنَازَۃِ قَالَ : فَخَلَعَ نَعْلَہُ ، ثُمَّ قَالَ : ہَاہُنَا ، یَعْنِی وَسَطَہَا۔","Hasan","Musannaf Ibn Abi Shaybah 11665","","","كتاب الجنائز"
"11666","(۱۱۶۶۶) حدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، قَالَ : صَلَّیْت خَلْفَ الْحَسَنِ مَا لاَ أُحْصِی عَلَی الْجَنَائِزِ لِلرِّجَالِ وَالنِّسَائِ ، فَمَا رَأَیْتُہُ یُبَالِی أَیْنَ قَامَ مِنْہَا۔","","Musannaf Ibn Abi Shaybah 11666","","","كتاب الجنائز"
"11667","(۱۱۶۶۷) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ، عَنِ الشَّیْبَانِیِّ، عَنِ الشَّعْبِیِّ، قَالَ: یَقُومُ الَّذِی یُصَلِّی عَلَی الْجِنَازَۃِ عِنْدَ صَدْرِہَا۔","","Musannaf Ibn Abi Shaybah 11667","","","كتاب الجنائز"
"11668","(۱۱۶۶۸) حدَّثَنَا عَبْدُ الأَعْلَی، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، قَالَ: یُقَامُ مِنَ الْمَرْأَۃِ حِیَالَ ثَدْیَیْہَا وَمِنَ الرَّجُلِ فَوْقَ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 11668","","","كتاب الجنائز"
"11669","(۱۱۶۶۹) حدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : الْمَرْأَۃُ عِنْدَ فَخِذَیْہَا وَالرَّجُلُ عِنْدَ صَدْرِہِ فِی الْقِیَامِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11669","","","كتاب الجنائز"
"11670","(۱۱۶۷۰) حدَّثَنَا حَفْصٌ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ أَبِی حُصَیْنِ ، قَالَ : کَانَ عَبْدُ اللہِ إذَا صَلَّی عَلَی الْجِنَازَۃِ قَامَ وَسَطَہَا وَیَرْتَفِعُ عَنْ صَدْرِ الْمَرْأَۃِ شَیْئًا۔","Sahih","Musannaf Ibn Abi Shaybah 11670","","","كتاب الجنائز"
"11671","(۱۱۶۷۱) حدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا صَلَّی الرَّجُلُ عَلَی الْجِنَازَۃِ قَامَ عِنْدَ الصَّدْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11671","","","كتاب الجنائز"
"11672","(۱۱۶۷۲) حدَّثَنَا شَرِیکٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَقُومُ الَّذِی یُصَلِّی عَلَی الْجِنَازَۃِ عِنْدَ صَدْرِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 11672","","","كتاب الجنائز"
"11673","(۱۱۶۷۳) حدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ حُصَیْنٍ عَمَّنْ سَمِعَ سَعِیدَ بْنَ جُبَیْرٍ ، قَالَ : إذَا کَانَ جِنَازَۃُ رَجُلٍ وَامْرَأَۃٍ جِیئَ بِالْمَرْأَۃِ فَوَضَعَ رَأْسَہَا عِنْدَ کَتِفَیِ الرَّجُلِ ، ثُمَّ یَقُومُ الإِمَامُ عِنْدَ رَأْسِ الْمَرْأَۃِ ، وَوَسَطِ الرَّجُلِ۔","","Musannaf Ibn Abi Shaybah 11673","","","كتاب الجنائز"
"11674","(۱۱۶۷۴) حدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَمْرِو بْنِ مُہَاجِرٍ ، قَالَ : صَلَّیْت مَعَ وَاثِلَۃَ بْنِ الأَسْقَعِ عَلَی سِتِّینَ جِنَازَۃً مِنَ الطَّاعُونِ رِجَالٍ وَنِسَائٍ فَجَعَلَہُمْ صَفَّیْنِ صَفَّ النِّسَائِ بَیْنَ أَیْدِی الرِّجَالِ ، رَأْسَ سَرِیرِ الْمَرْأَۃِ عِنْدَ رِجْلَیْ صَاحِبَتِہَا ، وَرَأْسَ الرَّجُلِ عِنْدَ رِجْلَیْ سَرِیرِ صَاحِبِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 11674","","","كتاب الجنائز"
"11675","(۱۱۶۷۵) حدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ مَنْصُورٍ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، قَالَ : قَدِمَ سَعِیدُ بْنُ جُبَیْرٍ عَلَی أَہْلِ مَکَّۃَ وَہُمْ یُسَوُّونَ بَیْنَ الرَّجُلِ وَالْمَرْأَۃِ إذَا صَلَّوْا عَلَیْہِمَا فِی رُؤُوسِہِمَا وَأَرْجُلِہِمَا ، فَأَرَادَہُمْ عَلَی أَنْ یَجْعَلُوا رَأْسَ الْمَرْأَۃِ عِنْدَ وَسَطِ الرَّجُلِ۔","","Musannaf Ibn Abi Shaybah 11675","","","كتاب الجنائز"
"11676","(۱۱۶۷۶) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی الْجَنَائِزِ رِجَالٌ وَنِسَائٌ تُسَوُّونَ رُؤُوسَہُمْ وَیَکُونُ صَفَّانِ بَیْنَ الإِمَامِ وَالْقِبْلَۃِ۔","","Musannaf Ibn Abi Shaybah 11676","","","كتاب الجنائز"
"11677","(۱۱۶۷۷) حدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ وَزَکَرِیَّا ، عَنِ الشَّعْبِیِّ کَمَا قَالَ إبْرَاہِیمُ۔","No Data Available","Musannaf Ibn Abi Shaybah 11677","","","كتاب الجنائز"
"11678","(۱۱۶۷۸) حدَّثَنَا ہُشَیْمٌ ، عَنْ دَاوُدَ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ الْمُسَیَّبِ یَقُولُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 11678","","","كتاب الجنائز"
"11679","(۱۱۶۷۹) حدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، عَنْ وَاثِلَۃَ بْنِ الأَسْقَعِ ، قَالَ : کَانَ یَجْعَلُ رُؤُوسَ الرِّجَالِ إلَی رُکَبِ النِّسَائِ۔","","Musannaf Ibn Abi Shaybah 11679","","","كتاب الجنائز"
"11680","(۱۱۶۸۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الْمِقْدَامِ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : یُفَضَّلُ الرَّجُلُ بِالرَّأْسِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11680","","","كتاب الجنائز"
"11681","(۱۱۶۸۱) حدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَنْ یُونُسَ ، عَنْ ہِلاَلٍ الْمَازِنِیِّ ، قَالَ : رَأَیْتُ أَبَا ہُرَیْرَۃَ یُصَلِّی عَلَی جِنَازَۃِ رِجَالٍ وَنِسَائٍ تِسْعٍ ، أَوْ سَبْعٍ فَقَدَّمَ النِّسَائِ مِمَّا یَلِی الْقِبْلَۃَ ، وَجَعَلَ الرِّجَالَ یَلُونَ الإِمَامَ۔","Da'if","Musannaf Ibn Abi Shaybah 11681","","","كتاب الجنائز"
"11682","(۱۱۶۸۲) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ إذَا صَلَّی عَلَی جِنَازَۃِ رِجَالٍ وَنِسَائٍ جَعَلَ الرِّجَالَ مِمَّا یَلِیہِ وَالنِّسَائَ خَلْفَ ذَلِکَ مِمَّا یَلِی الْقِبْلَۃَ۔","","Musannaf Ibn Abi Shaybah 11682","","","كتاب الجنائز"
"11683","(۱۱۶۸۳) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ عُثْمَانَ بْنِ عَبْدِ اللہِ بْنِ مَوْہَبٍ ، أَنَّ زَیْدَ بْنَ ثَابِتٍ وَأَبَا ہُرَیْرَۃَ کَانَا یَفْعَلاَنِ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 11683","","","كتاب الجنائز"
"11684","(۱۱۶۸۴) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی جَنَائِزِ رِجَالٍ وَنِسَائٍ ، قَالَ : تَکُونُ النِّسَائُ أَمَامَ الرِّجَالِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11684","","","كتاب الجنائز"
"11685","(۱۱۶۸۵) حدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ وَزَکَرِیَّا ، عَنِ الشَّعْبِیِّ کَمَا قَالَ إبْرَاہِیمُ۔","No Data Available","Musannaf Ibn Abi Shaybah 11685","","","كتاب الجنائز"
"11686","(۱۱۶۸۶) حدَّثَنَا ہُشَیْمٌ ، عَنْ دَاوُدَ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ الْمُسَیَّبِ یَقُول ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 11686","","","كتاب الجنائز"
"11687","(۱۱۶۸۷) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : کَانَ الْحَارِثُ إذَا صَلَّی عَلَی جَنَائِزِ رِجَالٍ وَنِسَائٍ جَعَلَ الرِّجَالَ یَلُونَہُ وَیُقَدِّمُ النِّسَائَ۔","","Musannaf Ibn Abi Shaybah 11687","","","كتاب الجنائز"
"11688","(۱۱۶۸۸) حدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ یُونُسَ ، عَنْ عَمَّارٍ مَوْلَی بَنِی ہَاشِمٍ ، قَالَ : شَہِدْتُ أُمَّ کُلْثُومٍ وَزَیْدَ بْنَ عُمَرَ مَاتَا فِی سَاعَۃٍ وَاحِدَۃٍ ، فَأَخْرَجُوہُمَا فَصَلَّی عَلَیْہِمَا سَعِیدُ بْنُ الْعَاصِ ، فَجَعَلَ زَیْدًا مِمَّا یَلِیہِ ، وَجَعَلَ أُمَّ کُلْثُومٍ بَیْنَ یَدَیْ زَیْدٍ ، وَفِی النَّاسِ یَوْمَئِذٍ نَاسٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَالْحَسَنُ وَالْحُسَیْنُ فِی الْجِنَازَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 11688","","","كتاب الجنائز"
"11689","(۱۱۶۸۹) حدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عن الحارث ، عَنْ عَلِیٍّ ، قَالَ : إذَا اجْتَمَعَتْ جَنَائِزُ رِجَالٍ وَنِسَائٍ ، جُعِلَ الرِّجَالُ مِمَّا یَلِی الإِمَامَ ، وَالنِّسَائُ مِمَّا یَلِی الْقِبْلَۃَ ، الْحُرُّ وَالْعَبْدُ یُجْعَلُ الْحُرُّ مِمَّا یَلِی الإِمَامَ ، وَالْعَبْدُ مِمَّا یَلِی الْقِبْلَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 11689","","","كتاب الجنائز"
"11690","(۱۱۶۹۰) حدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنْ عَبْدِ رَبِّہِ بْنِ أَبِی رَاشِدٍ ، قَالَ : کَانَ النَّاسُ فِی طَاعُونِ الْجَارِفِ یُصَلُّونَ عَلَی جَنَائِزِ الرِّجَالِ وَالنِّسَائِ مُتَفَرِّقِینَ ، قَالَ : فَجَائَ جَابِرُ بْنُ زَیْدٍ فِیمَا یَحْسَبُ عَبْدُ رَبِّہِ ، فَجَعَلَ النِّسَائَ أَمَامَ الرِّجَالِ ، فَصَلَّی عَلَیْہِمْ جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 11690","","","كتاب الجنائز"
"11691","(۱۱۶۹۱) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، أَنَّہُ کَانَ إذَا صَلَّی عَلَی جَنَائِزِ الرِّجَالِ وَالنِّسَائِ جَعَلَ الرِّجَالَ مِمَّا یَلِی ، الإِمَامَ وَالنِّسَائَ وَرَائَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 11691","","","كتاب الجنائز"
"11692","(۱۱۶۹۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، وَشُعْبَۃُ عَنْ أَبِی حَصِینٍ ، عَنْ مُوسَی بْنِ طَلْحَۃَ ، عَنْ عُثْمَانَ ، أَنَّہُ صَلَّی عَلَی رَجُلٍ وَامْرَأَۃٍ فَجَعَلَ الرَّجُلَ مِمَّا یَلِیہِ۔","Sahih","Musannaf Ibn Abi Shaybah 11692","","","كتاب الجنائز"
"11693","(۱۱۶۹۳) حدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ، عَنِ ابْنِ جُرَیْجٍ، عَنْ سُلَیْمَانَ بْنِ مُوسَی، عَنْ وَاثِلَۃَ، قَالَ: وَقَعَ الطَّاعُونُ بِالشَّامِ فَمَاتَ فِیہِ بَشَرٌ کَثِیرٌ، فَکَانَ یُصَلِّی عَلَی الرِّجَالِ وَالنِّسَائِ جَمِیعًا یَجْعَلُ الرِّجَالَ مِمَّا یَلِیہِ وَالنِّسَائَ مِمَّا یَلِی الْقِبْلَۃَ۔","","Musannaf Ibn Abi Shaybah 11693","","","كتاب الجنائز"
"11694","(۱۱۶۹۴) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا اجتَمَعَ جَنَائِزُ رِجَالِ وَنِسَاء جُعِلَ الرِّجَالَ مِمَّا یَلِی الإِمَامَ ، وَالنِّسَائَ أَمَامَ ذَلِکَ مِمَّا یَلِی الْقِبْلَۃَ۔","","Musannaf Ibn Abi Shaybah 11694","","","كتاب الجنائز"
"11695","(۱۱۶۹۵) حَدَّثَنَا ابْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : صَلَّی عَبْدُ اللہِ بْنُ عُمَرَ عَلَی أُمِّ کُلْثُومٍ بِنْتِ عَلِیٍّ وَابْنِہَا زَیْدٍ ، قَالَ : فَجَعَلَ الْغُلاَمَ مِمَّا یَلِیہِ وَالْمَرْأَۃَ مِمَّا یَلِی الْقِبْلَۃَ۔","","Musannaf Ibn Abi Shaybah 11695","","","كتاب الجنائز"
"11696","(۱۱۶۹۶) حدَّثَنَا عَبْدُاللہِ بْنُ رَجَائٍ، عَنْ عُبَیْدِاللہِ بْنِ عُمَرَ، عَنْ سَالِمٍ وَالْقَاسِمِ قَالاَ: النِّسَائُ مِمَّا یَلِی الإِمَامَ وَالرِّجَالُ مِمَّا یَلِی الْقِبْلَۃَ۔","","Musannaf Ibn Abi Shaybah 11696","","","كتاب الجنائز"
"11697","(۱۱۶۹۷) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : الرِّجَالُ بَیْنَ یَدَیِ النِّسَائِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11697","","","كتاب الجنائز"
"11698","(۱۱۶۹۸) حدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ، قَالَ : کَانَ مَسْلَمَۃُ بْنُ مُخَلَّدٍ بِمِصْرٍ ، قَالَ : فَجَاؤونَا بِرِجَالٍ وَنِسَائٍ فَجَعَلُوا لاَ یَدْرُونَ کَیْفَ یَصْنَعُونَ ، فَقَالَ مَسْلَمَۃُ : سُنَّتُکُمْ فِی الْمَوْتِ سُنَّتُکُمْ فِی الْحَیَاۃِ ، قَالَ : فَجُعِلَ النِّسَائُ مِمَّا یَلِی الإِمَامَ وَالرِّجَالُ أَمَامَ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 11698","","","كتاب الجنائز"
"11699","(۱۱۶۹۹) حدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ عَطَائِ بْنِ السَّائِبِ، عَنِ ابْنِ معقل، أَنَّہُ صَلَّی عَلَی الرِّجَالِ عَلَی حِدَۃٍ وَعَلَی الْمَرْأَۃِ عَلَی حِدَۃٍ ، ثُمَّ أَقْبَلَ عَلَی الْقَوْمِ ، فَقَالَ : ہَذَا الَّذِی لاَ شَکَّ فِیہِ۔","","Musannaf Ibn Abi Shaybah 11699","","","كتاب الجنائز"
"11700","(۱۱۷۰۰) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ قَالَ فِی جَنَائِزِ الرِّجَالِ وَالنِّسَائِ ، قَالَ : نُبِّئْت أَنَّ أَبَا الأَسْوَد لَمَّا اخْتَلَفُوا عَلَیْہِ صَلَّی عَلَی ہَؤُلاَئِ ضَرْبَۃً ، وَعَلَی ہَؤُلاَئِ ضَرْبَۃً۔","","Musannaf Ibn Abi Shaybah 11700","","","كتاب الجنائز"
"11701","(۱۱۷۰۱) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : صَلَّی الشَّعْبِیُّ عَلَی جِنَازَۃِ صَبِیٍّ وَرَجُلٍ ، قَالَ : فَجَعَلَ الرَّجُلَ مِمَّا یَلِیہِ ، وَالصَّبِیَّ أَمَامَ الرَّجُلِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11701","","","كتاب الجنائز"
"11702","(۱۱۷۰۲) حدَّثَنَا غُنْدَرٌ ، عَنْ عُثْمَانَ بْنِ غِیَاثٍ ، قَالَ : سَمِعْتُ الْحَسَنَ یَقُولُ فِی الْقَوْمِ یَصُفُّونَ علی الْجِنَازَۃِ فَیَجِیئُ الرَّجُلُ یَنْتَظِرُونَہُ ، قَالَ : لاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 11702","","","كتاب الجنائز"
"11703","(۱۱۷۰۳) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الْمَسْعُودِیِّ ، قَالَ : أُرَاہُ ، عَنِ الْقَاسِمِ ، أَنَّ عُمَرَ انْتَظَرَ ابْنَ أُمِّ عَبْدٍ بِالصَّلاَۃِ عَلَی عُتْبَۃَ بْنِ مَسْعُودٍ۔","","Musannaf Ibn Abi Shaybah 11703","","","كتاب الجنائز"
"11704","(۱۱۷۰۴) حدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ عُبَیْدِ اللہِ ، عَنْ زِیَادِ بْنِ جُبَیْرٍ ، عَنْ أَبِیہِ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الطِّفْلُ یُصَلَّی عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 11704","","","كتاب الجنائز"
"11705","(۱۱۷۰۵) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ صَلَّی عَلَی السِّقْطِ ، قَالَ نَافِعٌ : لاَ أَدْرِی أَحَیًّا خَرَجَ أَمْ مَیِّتًا۔","Sahih","Musannaf Ibn Abi Shaybah 11705","","","كتاب الجنائز"
"11706","(۱۱۷۰۶) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی بَکْرٍ ، قَالَ : إِنَّ أَحَقَّ مَنْ صَلَّیْنَا عَلَیْہِ أَطْفَالُنَا۔","","Musannaf Ibn Abi Shaybah 11706","","","كتاب الجنائز"
"11707","(۱۱۷۰۷) حدَّثَنَا عَبْدَۃ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : إذَا تَمَّ خَلْقُہُ وَنُفِخَ فِیہِ الرُّوحُ صُلِّیَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 11707","","","كتاب الجنائز"
"11708","(۱۱۷۰۸) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّہُ کَانَ یَقُومُ عَلَی المَنْفُوسِ مِنْ وَلَدِہِ الَّذِی لَمْ یَعْمَلْ خَطِیئَۃً فَیَقُولُ : اللَّہُمَّ أَجِرْہُ مِنْ عَذَابِ الْقَبْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 11708","","","كتاب الجنائز"
"11709","(۱۱۷۰۹) حدَّثَنَا عَبدُ الوَہَّاب الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ؛ فِی السِّقْطِ إنِ اسْتَوَی خَلْقُہُ سُمِّیَ وَصُلِّیَ عَلَیْہِ کَمَا یُصَلَّی عَلَی الْکَبِیرِ۔","","Musannaf Ibn Abi Shaybah 11709","","","كتاب الجنائز"
"11710","(۱۱۷۱۰) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنْ زِیَادِ بْنِ جُبَیْرٍ ، عَنْ أَبِیہِ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، قَالَ: السِّقْطُ یُصَلَّی عَلَیْہِ ، یُدْعَی لأَبَوَیْہِ بِالْمَغْفِرَۃِ وَالرَّحْمَۃِ ، قَالَ یُونُسُ : وَأَہْلُ زِیَادٍ یَرْفَعُونَہُ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَنَا لاَ أَحْفَظُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 11710","","","كتاب الجنائز"
"11711","(۱۱۷۱۱) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : مَا نَدَعُ أَحَدًا مِنْ أَوْلاَدِنَا إِلاَّ صَلَّیْنَا عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 11711","","","كتاب الجنائز"
"11712","(۱۱۷۱۲) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : یُصَلَّی عَلَی الصَّغِیرِ کَمَا یُصَلَّی عَلَی الْکَبِیرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11712","","","كتاب الجنائز"
"11713","(۱۱۷۱۳) حدَّثَنَا معاذ بْنُ یَزِیدَ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ مَنْصُورٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : صَلِّ عَلَی السِّقْطِ وَسَمِّیہِ، فَإِنَّہُ وُلِدَ عَلَی الْفِطْرَۃِ۔","","Musannaf Ibn Abi Shaybah 11713","","","كتاب الجنائز"
"11714","(۱۱۷۱۴) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ : سَأَلْتُ ابْنَ أَبِی لَیْلَی ، فقَالَ : أدْرَکْت بَقَایَا الأَنْصَارِ یُصَلُّونَ عَلَی الصَّبِیِّ مِنْ صِبْیَانِہِمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 11714","","","كتاب الجنائز"
"11715","(۱۱۷۱۵) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی السِّقْطِ إذَا وَقَعَ مَیِّتًا ، قَالَ : إذَا نُفِخَ فِیہِ الرُّوحُ صُلِّیَ عَلَیْہِ وَذَلِکَ لأَرْبَعَۃِ أَشْہُرٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 11715","","","كتاب الجنائز"
"11716","(۱۱۷۱۶) حدَّثَنَا أَحْمَدُ بْنُ إِسْحَاقَ ، قَالَ : حدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِیَادٍ ، قَالَ : حدَّثَنَا عَاصِمُ الأَحْوَلُ ، عَنْ خَالِدٍ الأَحْدَبِ ، قَالَ: سُئِلَ ابْنُ عُمَرَ عَنِ الصَّلاَۃِ عَلَی الأَطْفَالِ، فقَالَ: لأَنْ أُصَلِّیَ عَلَی مَنْ لاَ ذَنْبَ لَہُ أَحَبُّ إلَیَّ۔","","Musannaf Ibn Abi Shaybah 11716","","","كتاب الجنائز"
"11717","(۱۱۷۱۷) حدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ؟ قَالَ : لاَ یُصَلَّی عَلَیْہِ حَتَّی یَسْتَہِلَّ۔","","Musannaf Ibn Abi Shaybah 11717","","","كتاب الجنائز"
"11718","(۱۱۷۱۸) حدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ إبْرَاہِیمَ ؟ قَالَ : لاَ یُصَلَّی عَلَیْہِ حَتَّی یَسْتَہِلَّ۔","","Musannaf Ibn Abi Shaybah 11718","","","كتاب الجنائز"
"11719","(۱۱۷۱۹) حدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنْ عَمْرِو بْنِ مُرَّۃَ، قَالَ: سَمِعْتُ سَعِیدَ بْنَ جُبَیْرٍ یَقُولُ: لاَ یُصَلَّی عَلَی الصَّبِیِّ۔","","Musannaf Ibn Abi Shaybah 11719","","","كتاب الجنائز"
"11720","(۱۱۷۲۰) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : حدَّثَنَا جُلاَسٌ الشَّامِیِّ ، قَالَ : سَمِعْتُ عُثْمَانَ بْنَ جِحَّاشٍ ، قَالَ : سَمِعْتُ سَمُرَۃَ بْنَ جُنْدُبٍ وَمَاتَ ابْنٌ لَہُ صَغِیرًا ، فَقَالَ : اذْہَبُوا بِہِ فَادْفِنُوہُ ، وَلاَ یُصَلَّی عَلَیْہِ ، فَإِنَّہُ لَیْسَ عَلَیْہِ إِثْمٌ وَادْعُوا اللَّہَ لِوَالِدَیْہِ أَنْ یَجْعَلَہُ لَہُمَا فَرَطًا وَأَجْرًا ، نَحْوَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 11720","","","كتاب الجنائز"
"11721","(۱۱۷۲۱) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ فِی الْمَوْلُودِ لاَ یُصَلَّی عَلَیْہِ ، وَلاَ یُوَرَّثُ حَتَّی یَسْتَہِلَّ۔","","Musannaf Ibn Abi Shaybah 11721","","","كتاب الجنائز"
"11722","(۱۱۷۲۲) حدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن شُعْبَۃَ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، أَنَّہُ سَأَلَہُمَا عَنِ السِّقْطِ یَقَعُ مَیِّتًا أَیُصَلَّی عَلَیْہِ قَالاَ : لاَ۔","","Musannaf Ibn Abi Shaybah 11722","","","كتاب الجنائز"
"11723","(۱۱۷۲۳) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِیہِ ، قَالَ : لاَ یُصَلَّی عَلَی السِّقْطِ ، وَلاَ یُوَرَّثُ۔","","Musannaf Ibn Abi Shaybah 11723","","","كتاب الجنائز"
"11724","(۱۱۷۲۴) حدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : إذَا اسْتَہَلَّ صُلِّیَ عَلَیْہِ وَوُرِّثَ فَإِذَا لَمْ یَسْتَہِلَّ لَمْ یُصَلَّ عَلَیْہِ ، وَلَمْ یُوَرَّثْ۔","Da'if","Musannaf Ibn Abi Shaybah 11724","","","كتاب الجنائز"
"11725","(۱۱۷۲۵) حدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا اسْتَہَلَّ الصَّبِیُّ صُلِّیَ عَلَیْہِ وَوُرِّثَ ، وَإِذَا لَمْ یَسْتَہِلَّ لَمْ یُصَلَّ عَلَیْہِ ، وَلَمْ یُوَرَّثْ۔","","Musannaf Ibn Abi Shaybah 11725","","","كتاب الجنائز"
"11726","(۱۱۷۲۶) حدَّثَنَا معاذ بْنُ یَزِیدَ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ، عَنْ مَنْصُورٍ، عَنِ الْحَسَنِ، قَالَ: لاَ یُصَلَّی عَلَیْہِ، یَعْنِی السِّقْطَ۔","","Musannaf Ibn Abi Shaybah 11726","","","كتاب الجنائز"
"11727","(۱۱۷۲۷) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ مَکْحُولٍ ، قَالَ : کَانَ الزُّبَیْرُ لاَ یُصَلِّی عَلَی وَلَدِہِ إذَا مَاتَ صَغِیرًا۔","","Musannaf Ibn Abi Shaybah 11727","","","كتاب الجنائز"
"11728","(۱۱۷۲۸) حدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ سُلَیْمَانَ بْنِ بِلاَلٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ فِی الْمَوْلُودِ ، قَالَ : لاَ یُوَرَّثُ حَتَّی یَسْتَہِلَّ۔","No Data Available","Musannaf Ibn Abi Shaybah 11728","","","كتاب الجنائز"
"11729","(۱۱۷۲۹) حدَّثَنَا مَالِکُ بْنُ إسْمَاعِیلَ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : کُنَّا ، وَمَا نُصَلِّی عَلَی الْمَوْلُودِ۔","","Musannaf Ibn Abi Shaybah 11729","","","كتاب الجنائز"
"11730","(۱۱۷۳۰) حدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ عِمْرَانَ ، عَنْ سُوَیْد ، قَالَ : کُنَّا ، وَمَا نُصَلِّی عَلَی الْمَوْلُودِ۔","","Musannaf Ibn Abi Shaybah 11730","","","كتاب الجنائز"
"11731","(۱۱۷۳۱) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُصَلَّی عَلَی وَلَدِ الزِّنَی إذَا صَلَّی۔","","Musannaf Ibn Abi Shaybah 11731","","","كتاب الجنائز"
"11732","(۱۱۷۳۲) حدَّثَنَا وَکِیعٌ ، عَنْ فُضَیْلِ بْنِ غَزْوَانَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ لاَ یُصَلِّی عَلَی وَلَدِ الزِّنَی صَغِیرًا ، وَلاَ کَبِیرًا۔","Sahih","Musannaf Ibn Abi Shaybah 11732","","","كتاب الجنائز"
"11733","(۱۱۷۳۳) حدَّثَنَا حَفْص ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَرَی وَلَدَ الزِّنَی عَلَی فِرَاشِہِ فِی بَیْتِہِ یَمُوتُ وَتَمُوتُ أُمُّہُ وَیُصَلِّی عَلَیْہِمَا۔","Sahih","Musannaf Ibn Abi Shaybah 11733","","","كتاب الجنائز"
"11734","(۱۱۷۳۴) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ صَلَّی عَلَی جِنَازَۃٍ فَلَہُ قِیرَاطٌ ، وَمَنِ انْتَظَرَ حَتَّی یُفْرَغَ مِنْہَا فَلَہُ قِیرَاطَانِ ، قَالُوا : وَمَا الْقِیرَاطَانِ ؟ قَالَ : مِثْلُ الْجَبَلَیْنِ الْعَظِیمَیْنِ۔ (بخاری ۱۳۲۵۔ مسلم ۶۵۲)","Sahih","Musannaf Ibn Abi Shaybah 11734","","","كتاب الجنائز"
"11735","(۱۱۷۳۵) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ عَدِیٍّ ، عَنْ زِرِّ بْنِ حُبَیْشٍ ، عَنْ أُبَیِّ بْنِ کَعْبٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ صَلَّی عَلَی جِنَازَۃٍ فَلَہُ قِیرَاطٌ وَمَنْ تَبِعَہَا حَتَّی تُدْفَنَ فَلَہُ قِیرَاطَانِ ، الْقِیرَاطُ مِثْلُ أُحُدٍ۔ (احمد ۵/۱۳۱۔ ابن ماجہ ۱۵۱)","","Musannaf Ibn Abi Shaybah 11735","","","كتاب الجنائز"
"11736","(۱۱۷۳۶) حدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنْ یَعْلَی بْنِ عَطَائٍ، قَالَ: سَمِعْتُ الْوَلِیدَ بْنَ عَبْدِالرَّحْمَنِ یُحَدِّثُ عَنْ أَبِی ہُرَیْرَۃَ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ: مَنْ صَلَّی عَلَی جِنَازَۃٍ فَلَہُ قِیرَاطٌ، فَإِنْ شَہِدَ دَفْنَہَا کَانَ لَہُ قِیرَاطَانِ الْقِیرَاطُ مِثْلُ جَبَلِ أُحُدٍ ، قَالَ ابْنُ عُمَرَ : انْظُرْ مَا تَقُولُ ، قَالَ : فَبَعَثُوا إلَی عَائِشَۃَ ، فَقَالَتْ صَدَقَ۔ (احمد ۳)","Sahih","Musannaf Ibn Abi Shaybah 11736","","","كتاب الجنائز"
"11737","(۱۱۷۳۷) حدَّثَنَا أَبُو خَالِدٍ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنْ مَعْدَانَ بْنِ أبِی طَلْحَۃَ الْیَعْمُرِیِّ، عَنْ ثَوْبَانَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ تَبِعَ جِنَازَۃً فَلَہُ قِیرَاطٌ وَمَنْ تَبِعَہَا حَتَّی تُدْفَنَ فَلَہُ قِیرَاطَانِ قَالُوا : وَمِثْلُ أَیْشٍ الْقِیرَاطُ یَا رَسُولَ اللہِ ، قَالَ : أَصْغَرُہُمَا مِثْلُ أُحُدٍ۔n(مسلم ۵۷۔ ابن ماجہ ۱۵۴۰)","Hasan","Musannaf Ibn Abi Shaybah 11737","","","كتاب الجنائز"
"11738","(۱۱۷۳۸) حدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ سَالِمٍ الْبَرَّادِ ، عَنِ ابْنِ عُمَرَ ، وَعَنْ ہِشَامٍ ، عَنْ سَعِیدٍ الْمَقْبُرِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، وَعَنْ أَبِیہِ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَبْدِ اللہِ قَالُوا : مَنْ صَلَّی عَلَی جِنَازَۃٍ فَلَہُ قِیرَاطٌ وَمَنْ شَہِدَہَا حَتَّی یُقْضَی قَضَاؤُہَا فَلَہُ قِیرَاطَانِ ، الْقِیرَاطُ مِثْلُ أُحُدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 11738","","","كتاب الجنائز"
"11739","(۱۱۷۳۹) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ جُبَیْرِ بْنِ أَبِی صَالِحٍ ، أَنَّہُ سَمِعَ أَبَا ہُرَیْرَۃَ یَقُولُ مَنْ صَلَّی عَلَی جِنَازَۃٍ فَلَہُ قِیرَاطٌ ، وَمَنْ شَہِدَہَا حَتَّی یُفْرَغَ مِنْہَا فَلَہُ قِیرَاطَانِ ، الْقِیرَاطُ مِثْلُ أُحُدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 11739","","","كتاب الجنائز"
"11740","(۱۱۷۴۰) حدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ سُلَیْمَانَ بْنِ بِلاَلٍ ، قَالَ : حدَّثَنِی عَمْرُو بْنُ یَحْیَی الْمَازِنِیُّ ، عَنْ مُحَمَّدِ بْنِ یُوسُفَ بْنِ عَبْدِ اللہِ بْنِ سَلاَمٍ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَتَی الْجِنَازَۃَ عِنْدَ أَہْلِہَا فَمَشَی مَعَہَا حَتَّی یُصَلِّی عَلَیْہَا فَلَہُ قِیرَاطٌ وَمَنْ شَہِدَہَا حَتَّی تُدْفَنَ فَلَہُ قِیرَاطَانِ ، الْقِیرَاطُ مِثْلُ أُحُدٍ۔ (احمد ۲۷)","Da'if","Musannaf Ibn Abi Shaybah 11740","","","كتاب الجنائز"
"11741","(۱۱۷۴۱) حدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِیُّ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ سَالِمٍ الْبَرَّادِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ صَلَّی عَلَی جِنَازَۃٍ فَلَہُ قِیرَاطٌ۔ (احمد ۲/۱۶)","Sahih","Musannaf Ibn Abi Shaybah 11741","","","كتاب الجنائز"
"11742","(۱۱۷۴۲) حدَّثَنَا الْعَلاَئُ بْنُ عُصَیْمٍ ، قَالَ : حدَّثَنَا عَبْثَرٌ أَبُو زُبَیْدٍ ، عَنْ بُرْدِ بْنِ أَبِی زِیَادٍ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، قَالَ : سَمِعْتُ الْبَرَائَ بْنَ عَازِبٍ یَقُولُ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ صَلَّی عَلَی جِنَازَۃٍ فَلَہُ قِیرَاطٌ وَمَنْ تَبِعَہَا حَتَّی تُدْفَنَ فَلَہُ قِیرَاطَانِ۔ (نسائی ۲۰۶۷)","Sahih","Musannaf Ibn Abi Shaybah 11742","","","كتاب الجنائز"
"11743","(۱۱۷۴۳) حدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ یَمُوتُ أَحَدٌ مِنَ الْمُسْلِمِینَ فَتُصَلِّی عَلَیْہِ أُمَّۃٌ مِنَ الْمُسْلِمِینَ لَمْ یَبْلُغُوا أَنْ یَکُونُوا مِئَۃ فَیَشْفَعُوا لَہُ إِلاَّ شُفِّعُوا فِیہِ۔ (مسلم ۵۸۔ احمد ۳/۲۶۶)","Sahih","Musannaf Ibn Abi Shaybah 11743","","","كتاب الجنائز"
"11744","(۱۱۷۴۴) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ أَبِی بَکَّارٍ ، قَالَ : صَلَّیْت مَعَ أَبِی الْمَلِیحِ عَلَی جِنَازَۃٍ ، فَقَالَ : سَوُّوا صُفُوفَکُمْ وَلْتَحْسُنْ شَفَاعَتُکُمْ وَلَوْ خُیِّرْت رَجُلاً لاَخْتَرْتُہُ ، حدَّثَنَی عَبْدُ اللہِ بْنُ بن السلیل ، عَنْ بَعْضِ أَزْوَاجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، مَیْمُونَۃ ، وَکان أَخاہَا مِن الرّضَاعَۃ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَا مِنْ رَجُلٍ مُسْلِمٍ یُصَلِّی عَلَیْہِ أُمَّۃٌ إِلاَّ شُفِّعُوا فِیہِ۔n قَالَ أَبُو الْمَلِیحِ : وَالأُمَّۃُ مَا بَیْنَ الأَرْبَعِینَ إلَی الْمِئَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 11744","","","كتاب الجنائز"
"11745","(۱۱۷۴۵) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ مَرْثَدِ بْنِ عَبْدِ اللہِ الْیَزَنِیِّ ، عَنْ مَالِکِ بْنِ ہُبَیْرَۃَ الشَّامِیِّ وَکَانَتْ لَہُ صُحْبَۃٌ ، قَالَ : کَانَ إذَا أُتِی بِجِنَازَۃٍ ، فَتَقَالَّ مَنْ مَعَہَا ، جَزَّأَہُمْ صُفُوفًا ثَلاَثَۃً ، ثُمَّ صَلَّی عَلَیْہَا ، وَقَالَ : إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَا صَفَّتْ صُفُوفٌ ثَلاَثَۃٌ مِنَ الْمُسْلِمِینَ عَلَی مَیِّتٍ إِلاَّ أَوْجَبَ۔ (ترمذی ۱۰۲۸۔ ابوداؤد ۳۱۵۸)","","Musannaf Ibn Abi Shaybah 11745","","","كتاب الجنائز"
"11746","(۱۱۷۴۶) حدَّثَنَا إسْمَاعِیلُ بْنُ إِسْحَاقَ ، قَالَ : حدَّثَنَا بُکَیْر بْنُ أَبِی السُّمَیْطِ ، قَالَ : حدَّثَنَا قَتَادَۃُ ، عَنْ سَعِیدِ بْنِ أَبِی الْحَسَنِ ، عَنْ عَسْعَسِ بْنِ سَلاَمَۃَ ، قَالَ : مَنْ شَفَعَ لَہُ أَرْبَعُونَ قُبِلَتْ شَفَاعَتُہُمْ وَمَنْ شَہِدَ لَہُ عَشَرَۃٌ قُبِلَتْ شَہَادَتُہُمْ۔","","Musannaf Ibn Abi Shaybah 11746","","","كتاب الجنائز"
"11747","(۱۱۷۴۷) حدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ شَیْبَانَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : مَنْ صَلَّی عَلَیْہِ مِئَۃ مِنَ الْمُسْلِمِینَ غُفِرَ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 11747","","","كتاب الجنائز"
"11748","(۱۱۷۴۸) حدَّثَنَا شَرِیکٌ ، عَنْ عُثْمَانَ أَبِی الْیَقْظَانِ ، عَنْ زَاذَانَ ، عَنْ جَرِیرٍ رَفَعَہُ ، قَالَ : اللَّحْدُ لَنَا وَالشَّقُّ لِغَیْرِنَا۔ (ابن ماجہ ۱۵۵۵۔ طبرانی ۲۳۲۴)","Da'if","Musannaf Ibn Abi Shaybah 11748","","","كتاب الجنائز"
"11749","(۱۱۷۴۹) حدَّثَنَا حَفْصٌ ، عَنْ أَبِیہِ ، قَالَ : لُحِدَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 11749","","","كتاب الجنائز"
"11750","(۱۱۷۵۰) حدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ نَافِعٍ ، قَالَ : لُحِدَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَبْرُہُ ، وَلأَبِی بَکْرٍ وَعُمَرَ ، ثُمَّ تَفَاخَرْتُمْ۔ (ابن سعد ۲۹۶)","","Musannaf Ibn Abi Shaybah 11750","","","كتاب الجنائز"
"11751","(۱۱۷۵۱) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : دُفِنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی لَحْدٍ۔","","Musannaf Ibn Abi Shaybah 11751","","","كتاب الجنائز"
"11752","(۱۱۷۵۲) حدَّثَنَا جَرِیرٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ فُقَہَائِ أَہْلِ الْمَدِینَۃِ ، قَالَ : کَانَ بِالْمَدِینَۃِ رَجُلاَنِ یَحْفُرَانِ الْقُبُورَ ، قَالَ : فَکَانَ أَحَدُہُمَا یَشُقُّ وَالآخَرُ یَلْحَدُ ، فَلَمَّا تُوُفِّیَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالُوا: أَیُّہُمَا طَلَعَ فَمُرُوہُ فَلْیَعْمَلْ بِعَمَلِہِ الَّذِی کَانَ یَعْمَلُ فَطَلَعَ الَّذِی کَانَ یَلْحَدُ فَأَمَرُوہُ فَلَحَدَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (ابن سعد ۲۹۵)","","Musannaf Ibn Abi Shaybah 11752","","","كتاب الجنائز"
"11753","(۱۱۷۵۳) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، قَالَ : اجْتَمَعَ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ مَاتَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَکَانَ الرَّجُلُ یَلْحَدُ وَالآخَرُ یَشُقُّ فَقَالُوا : اللَّہُمَّ خِرْہ لَنَا فَطَلَعَ الَّذِی کَانَ یَلْحَدُ فَلَحَدَ لَہُ۔ (ابن ماجہ ۱۶۲۸۔ احمد ۸)","","Musannaf Ibn Abi Shaybah 11753","","","كتاب الجنائز"
"11754","(۱۱۷۵۴) حدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ وَسَالِمٍ وَالْقَاسِمِ قَالُوا : کَانَ قَبْرُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبِی بَکْرٍ وَعُمَرَ جُِثًا قِبْلَۃً نُصِبَ لَہُمُ اللَّبِنَ نَصْبًا وَلُحِدَ لَہُمْ لَحْدًا۔ (ابن سعد ۲۹۸)","","Musannaf Ibn Abi Shaybah 11754","","","كتاب الجنائز"
"11755","(۱۱۷۵۵) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لُحِدَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَلأَبِی بَکْرٍ وَعُمَرَ۔","","Musannaf Ibn Abi Shaybah 11755","","","كتاب الجنائز"
"11756","(۱۱۷۵۶) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لُحِدَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَحْدٌ۔","","Musannaf Ibn Abi Shaybah 11756","","","كتاب الجنائز"
"11757","(۱۱۷۵۷) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یَکْرَہُ الشَّقَّ فِی الْقَبْرِ وَیَقُولُ یُصْنَعُ فِیہِ لَحْدٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 11757","","","كتاب الجنائز"
"11758","(۱۱۷۵۸) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ ، أَنَّ النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَحَدُوا لَہُ۔","","Musannaf Ibn Abi Shaybah 11758","","","كتاب الجنائز"
"11759","(۱۱۷۵۹) حدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، وَعَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَوْصَی أَنْ یُلْحَدَ لَہُ۔ (احمد ۳/۲۴۔ ابن سعد ۲)","Da'if","Musannaf Ibn Abi Shaybah 11759","","","كتاب الجنائز"
"11760","(۱۱۷۶۰) حدَّثَنَا أَبُو أُسَامَۃَ، عَنْ المُجَالِدِ، عَنْ عَامِرٍ، قَالَ: قَالَ الْمُغِیرَۃُ بْنُ شُعْبَۃَ لَحَدْنَا لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 11760","","","كتاب الجنائز"
"11761","(۱۱۷۶۱) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنِ الْمِنْہَالِ ، عَنْ زَاذَانَ ، عَنِ الْبَرَائِ ، قَالَ : کُنَّا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی جِنَازَۃٍ فَانْتَہَیْنَا إلَی القَبْرِ وَلَمَّا یُلْحَدْ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 11761","","","كتاب الجنائز"
"11762","(۱۱۷۶۲) حدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ أُسَامَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَنَسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : انْظُرُوا أَیُّہُمْ أَکْثَرُ جَمْعًا لِلْقُرْآنِ فَقَدِّمُوہُ فِی اللَّحْدِ۔ (ترمذی ۱۰۱۶۔ ابوداؤد ۳۱۲۹)","Hasan","Musannaf Ibn Abi Shaybah 11762","","","كتاب الجنائز"
"11763","(۱۱۷۶۳) حدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ، قَالَ: حدَّثَنَا عَبْدُالرَّحْمَنِ بْنُ عَبْدِالْعَزِیزِ، عَنِ الزُّہْرِیِّ، عَنْ عَبْدِالرَّحْمَنِ بْنِ کَعْبِ بْنِ مَالِکٍ، عَنْ أَبِیہِ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَجْمَعُ بَیْنَ الرَّجُلَیْنِ وَالثَّلاَثَۃِ فِی اللَّحْدِ۔ (بیہقی ۱۱)","Shadh","Musannaf Ibn Abi Shaybah 11763","","","كتاب الجنائز"
"11764","(۱۱۷۶۴) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : غَسَّلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلِیٌّ وَالْفَضْلُ وَأُسَامَۃُ وَأَدْخَلُوہُ قَبْرَہُ ، وَجَعَلَ عَلِیٌّ یَقُولُ : بِأَبِی أَنْتَ وَأُمِّی طِبْت حَیًّا وَمَیِّتًا۔n قاَلَ : وَحدَّثَنَا ابْنُ أَبِی مَرْحَبٍ ، أَنَّ عَبْدَ الرَّحْمَن بْنَ عَوْفٍ دَخَلَ مَعَہُمُ الْقَبْرَ ، قَالَ : وَقَالَ الشَّعْبِیُّ : مَنْ یَلِی الْمَیِّتَ إِلاَّ أَہْلُہُ ؟۔ (ابوداؤد ۳۲۰۱۔ ابن سعد ۲۷۷)","","Musannaf Ibn Abi Shaybah 11764","","","كتاب الجنائز"
"11765","(۱۱۷۶۵) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ ، أَنَّ الَّذِی وَلِیَ دَفْنَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَإِجْنَانَہُ أَرْبَعَۃُ نَفَرٍ دُونَ النَّاسِ ، عَلِیٌّ ، وَالْعَبَّاسُ ، وَالْفَضْلُ ، وَصَالِحٌ مَوْلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (حاکم ۳۶۲)","","Musannaf Ibn Abi Shaybah 11765","","","كتاب الجنائز"
"11766","(۱۱۷۶۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : أَدْخِلَ الْقَبْرَ کَمْ شِئْت۔","No Data Available","Musannaf Ibn Abi Shaybah 11766","","","كتاب الجنائز"
"11767","(۱۱۷۶۷) حدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یَضُرُّک شَفْعٌ ، أَوْ وِتْرٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 11767","","","كتاب الجنائز"
"11768","(۱۱۷۶۸) حدَّثَنَا وَکِیعٌ ، عَنْ إسرائیل ، عن جابر ، عن عامر ، قَالَ : لاَ یضرک شفعٌ أو وتر۔","","Musannaf Ibn Abi Shaybah 11768","","","كتاب الجنائز"
"11769","(۱۱۷۶۹) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، عَنِ الْحَسَنِ، قَالَ: لاَ بَأْسَ أَنْ یَدْخُلَ الْقَبْرَ شَفْعٌ، أَوْ وَتْرٌ۔","","Musannaf Ibn Abi Shaybah 11769","","","كتاب الجنائز"
"11770","(۱۱۷۷۰) حدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنْ حَفْصَۃَ قَالَتْ أَوْصَتْ عَائِشَۃُ ، فَقَالَتْ : إذَا سَوَّی عَلَیَّ ذَکْوَانُ قَبْرِی فَہُوَ حُرٌّ أَرَادَتْ أَنْ یَدْخُلَ قَبْرَہَا وکان ذَکْوَانُ قَدْ دَخَلَ قَبْرَہَا وَہُوَ مَمْلُوکٌ۔","","Musannaf Ibn Abi Shaybah 11770","","","كتاب الجنائز"
"11771","(۱۱۷۷۱) حدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ، عَنْ أَبِیہِ، قَالَ یَلِی سِفْلَۃَ الْمَرْأَۃِ فِی الْقَبْرِ أَقْرَبُہُمْ إلَیْہَا۔","","Musannaf Ibn Abi Shaybah 11771","","","كتاب الجنائز"
"11772","(۱۱۷۷۲) حدَّثَنَا حَفْصٌ ، وَوَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، قَالَ : مَاتَتْ زَیْنَبُ بِنْتُ جَحْشٍ فَکَبَّرَ عَلَیْہَا عُمَرُ أَرْبَعًا ، ثُمَّ سَأَلَ أَزْوَاجَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ یُدْخِلُہَا فِی قَبْرِہَا ؟ فَقُلْنَ : مَنْ کَانَ یَدْخُلُ عَلَیْہَا فِی حَیَاتِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 11772","","","كتاب الجنائز"
"11773","(۱۱۷۷۳) حدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : أَخْبَرَنَا أَشْعَثُ ، عَنِ الْحَسَنِ ، قَالَ یَدْخُلُ الرَّجُلُ قَبْرَ امْرَأَتِہِ وَیَلِی سَفَلَتَہَا۔","","Musannaf Ibn Abi Shaybah 11773","","","كتاب الجنائز"
"11774","(۱۱۷۷۴) حدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ أَبِیہِ ، عَنْ أَشْیَاخٍ من الأَنْصَارِ قَالُوا : أُتِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ أُحُدٍ بِعَبْدِ اللہِ بْنِ عَمْرِو بْنِ حَرَامٍ وَعَمْرِو بْنِ الْجَمُوحِ قتیلین ، فَقَالَ : ادْفِنُوہُمَا فِی قَبْرٍ وَاحِدٍ ، فَإِنَّہُمَا کَانَا مُتَصَافِیَیْنِ فِی الدُّنْیَا۔","","Musannaf Ibn Abi Shaybah 11774","","","كتاب الجنائز"
"11775","(۱۱۷۷۵) حدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ لَیْثِ بْنِ سَعْدٍ ، عَنِ ابْنِ شِہَابٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ کَعْبِ بْنِ مَالِکٍ ، أَنَّ جَابِرَ بْنَ عَبْدِ اللہِ أَخْبَرَہُ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَجْمَعُ بَیْنَ الرَّجُلَیْنِ مِنْ قَتْلَی أُحُدٍ فِی قَبْرٍ وَاحِدٍ وَیَقُولُ : أَیُّہُمَا أَکْثَرُ أَخْذًا لِلْقُرْآنِ ؟ فَإِذَا أُشِیرَ بِہِ إلَی أَحَدِہِمَا قَدَّمَہُ ، یَعْنِی فِی اللَّحْدِ۔n(بخاری ۱۳۴۳۔ ابوداؤد ۳۱۳۰)","Sahih","Musannaf Ibn Abi Shaybah 11775","","","كتاب الجنائز"
"11776","(۱۱۷۷۶) حدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَکْرَہُ أَنْ یُدْفَنَ اثْنَانِ فِی قَبْرٍ وَاحِدٍ۔","","Musannaf Ibn Abi Shaybah 11776","","","كتاب الجنائز"
"11777","(۱۱۷۷۷) حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ أُسَامَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَنَسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : انْظُرُوا أَیُّہُمْ أَکْثَرُ جَمْعًا لِلْقُرْآنِ فَقَدِّمُوہُ فِی اللَّحْدِ۔","Hasan","Musannaf Ibn Abi Shaybah 11777","","","كتاب الجنائز"
"11778","(۱۱۷۷۸) حدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْعَزِیزِ ، عَنِ الزُّہْرِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ کَعْبِ بْنِ مَالِکٍ ، عَنْ أَبِیہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَجْمَعُ بَیْنَ الرَّجُلَیْنِ وَالثَّلاَثَۃِ فِی اللَّحْدِ۔","Shadh","Musannaf Ibn Abi Shaybah 11778","","","كتاب الجنائز"
"11779","(۱۱۷۷۹) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنِ الْجُرَیْرِیِّ، عَنْ أَبِی الْعَلاَئِ، أَنَّ أَبَا مُوسَی أَوْصَی حَفَرَۃَ قَبْرِہِ أَنْ یُعَمِّقُوا لَہُ قَبْرَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 11779","","","كتاب الجنائز"
"11780","(۱۱۷۸۰) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی سِنَانٍ ، عَنِ الضَّحَّاکِ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّ أَبَا مُوسَی أَوْصَی أَنْ یُعَمَّقَ قَبْرُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 11780","","","كتاب الجنائز"
"11781","(۱۱۷۸۱) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ أَنَّہُمَا کَانَا یَسْتَحِبَّانِ أَنْ یُعَمَّقَ الْقَبْرُ۔","","Musannaf Ibn Abi Shaybah 11781","","","كتاب الجنائز"
"11782","(۱۱۷۸۲) حدَّثَنَا ہُشَیْمٌ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ أَنَّہُمَا کَانَا یَقُولاَنِ یُعَمَّقُ الْقَبْرُ۔","","Musannaf Ibn Abi Shaybah 11782","","","كتاب الجنائز"
"11783","(۱۱۷۸۳) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ قَالَ : یُحْفَرُ الْقَبْرُ إلَی السُّرَّۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 11783","","","كتاب الجنائز"
"11784","(۱۱۷۸۴) حدَّثَنَا أَبُو أُسَامَۃَ، عَنْ مُحَمَّدِ بْنِ سُلَیْمٍ، عَنِ الْحَسَنِ، قَالَ: أَوْصَی عُمَرُ أَنْ یُجْعَلَ عُمْقُ قَبْرِہِ قَامَۃً وَبَسطَۃً۔","Hasan","Musannaf Ibn Abi Shaybah 11784","","","كتاب الجنائز"
"11785","(۱۱۷۸۵) حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : شَہِدْت جِنَازَۃَ الْحَارِثِ فَمَدُّوا عَلَی قَبْرِہِ ثَوْبًا فَکَشَفَہُ عَبْدُ اللہِ بْنُ یَزِیدَ ، قَالَ : إنَّمَا ہُوَ رَجُلٌ۔","Sahih","Musannaf Ibn Abi Shaybah 11785","","","كتاب الجنائز"
"11786","(۱۱۷۸۶) حدَّثَنَا وَکِیعٌ، عَنْ حَسَنِ بْنِ صَالِحٍ، عَنْ یَحْیَی بْنِ قَیْسٍ، أَنَّ شُرَیْحًا أَوْصَی أَنْ لاَ یَمُدُّوا عَلَی قَبْرِہِ ثَوْبًا۔","","Musannaf Ibn Abi Shaybah 11786","","","كتاب الجنائز"
"11787","(۱۱۷۸۷) حدَّثَنَا حَفْصٌ، عَنْ عَاصِمٍ ، قَالَ شَہِدْت جِنَازَۃَ رَجُلٍ فِیہَا الْحَسَنُ، وَابْنُ سِیرِینَ فَمُدَّ عَلَی قَبْرِہِ ثَوْبٌ، فَقَالَ : الْحَسَنُ اکْشِفُوہُ فَإِنَّمَا ہُوَ رَجُلٌ ، وَلَمْ یَرَ ابْنُ سِیرِینَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 11787","","","كتاب الجنائز"
"11788","(۱۱۷۸۸) حدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دَخَلَ قَبْرَ سَعد فَمَدَّ عَلَیْہِ ثَوْبًا۔ (عبدالرزاق ۶۴۷۷)","Da'if","Musannaf Ibn Abi Shaybah 11788","","","كتاب الجنائز"
"11789","(۱۱۷۸۹) حدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ أَبِیہِ أَنَّہُ سَمِعَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَدْخَلَ نُعَیْمَ بْنَ مَسْعُودٍ الأَشْجَعِیَّ الْقَبْرَ وَنَزَعَ الأَخِلَّۃَ بِفِیہِ ، یَعْنِی الْعُقَدَ۔ (ابن سعد ۲۷۹)","","Musannaf Ibn Abi Shaybah 11789","","","كتاب الجنائز"
"11790","(۱۱۷۹۰) حدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ رَجُلٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : شَہِدْتُ الْعَلاَئَ بْنَ الْحَضْرَمِیِّ فَدَفَنَّاہُ فَنَسِینَا أَنْ نَحِلَّ الْعُقَدَ حَتَّی أَدْخَلْنَاہُ قَبْرَہُ ، قَالَ فَرَفَعْنَا عَنْہُ اللَّبِنَ فَلَمْ نَرَ فِی الْقَبْرِ شَیْئًا۔","Da'if","Musannaf Ibn Abi Shaybah 11790","","","كتاب الجنائز"
"11791","(۱۱۷۹۱) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أُدْخِلَ الْمَیِّتُ الْقَبْرَ حُلَّتْ عَنْہُ الْعُقَدُ کُلُّہَا۔","","Musannaf Ibn Abi Shaybah 11791","","","كتاب الجنائز"
"11792","(۱۱۷۹۲) حدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : تُحَلُّ عَنِ الْمَیِّتِ الْعُقَدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 11792","","","كتاب الجنائز"
"11793","(۱۱۷۹۳) حدَّثَنَا ہُشَیْمٌ ، عَنْ جُوَیْبِرٍ ، قَالَ : أَوْصَانِی الضَّحَّاکُ بِہِ۔","","Musannaf Ibn Abi Shaybah 11793","","","كتاب الجنائز"
"11794","(۱۱۷۹۴) حدَّثَنَا ہُشَیْمٌ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ قَالاَ : تُحَلُّ عَنِ الْمَیِّتِ الْعُقَدُ۔","","Musannaf Ibn Abi Shaybah 11794","","","كتاب الجنائز"
"11795","(۱۱۷۹۵) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ جُوَیْبِرٍ، عَنِ الضَّحَّاکِ، أَنَّہُ أَوْصَی أَنْ تُحَلَّ عَنْہُ الْعُقَدُ وَیُبْرَزَ وَجْہُہُ مِنَ الْکَفَنِ۔","","Musannaf Ibn Abi Shaybah 11795","","","كتاب الجنائز"
"11796","(۱۱۷۹۶) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ أَنَّہُمَا کَانَا یَکْرَہَانِ أَنْ یُشَقَّ کَفَنُ الْمَیِّتِ إذَا أُدْخِلَ الْقَبْرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 11796","","","كتاب الجنائز"
"11797","(۱۱۷۹۷) حدَّثَنَا وَکِیعٌ، عَنْ إیَاسِ بْنِ دَغْفَلٍ، عَنْ عَبْدِاللہِ بْنِ قَیْسِ بْنِ عُبَادٍ، عَنْ أَبِیہِ، أَنَّہُ أَوْصَی إذَا وَضَعْتُمُونِی فِی حُفْرَتِی فَجوبُوا مَا یَلِی جَسَدِی مِنَ الْکَفَنِ حَتَّی تُفْضُوا بِی إلَی الأَرْضِ۔","","Musannaf Ibn Abi Shaybah 11797","","","كتاب الجنائز"
"11798","(۱۱۷۹۸) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ خَالِدٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کُنْتُ مَعَ أَنَسٍ فِی جِنَازَۃٍ فَأَمَرَ بِالْمَیِّتِ فَأُدْخِلَ مِنْ قِبَلِ رِجْلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 11798","","","كتاب الجنائز"
"11799","(۱۱۷۹۹) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ أَدْخَلَ مَیِّتًا مِنْ قِبَلِ رِجْلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 11799","","","كتاب الجنائز"
"11800","(۱۱۸۰۰) حدَّثَنَا أَبُو بَکْرٍ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : شَہِدْنَا جِنَازَۃَ ابْنِ مَعْقِلٍ ، فَقَالَ رَجُلٌ : إنَّ صَاحِبَکُمْ قَدْ أَوْصَی أَنْ یُسَلَّ۔","","Musannaf Ibn Abi Shaybah 11800","","","كتاب الجنائز"
"11801","(۱۱۸۰۱) حدَّثَنَا ابْنُ عَیَّاشٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَسلُّونَ۔","No Data Available","Musannaf Ibn Abi Shaybah 11801","","","كتاب الجنائز"
"11802","(۱۱۸۰۲) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَنْصُورِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : قُلْتُ لِلشَّعْبِیِّ رَجُلٌ دَفَنَ مَیِّتًا فَسَلَّہُ مِنْ قِبَلِ رِجْلی الْقَبْرِ ، قَالَ : ہَذَا وَاللَّہِ السُّنَّۃُ۔","","Musannaf Ibn Abi Shaybah 11802","","","كتاب الجنائز"
"11803","(۱۱۸۰۳) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ وَوَکِیعٌ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ، أَنَّ قَیْسًا أَوْصَی عِنْدَ مَوْتِہِ أَنْ یُسَلَّ سَلاًّ۔","","Musannaf Ibn Abi Shaybah 11803","","","كتاب الجنائز"
"11804","(۱۱۸۰۴) حدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَمْرِو بْنِ مُہَاجِرٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، أَنَّہُ لَمَّا تُوُفِّیَ ابْنُہُ أَمَرَ بِہِ فَأُدْخِلَ مِنْ قِبَلِ رِجْلَیْہِ۔","","Musannaf Ibn Abi Shaybah 11804","","","كتاب الجنائز"
"11805","(۱۱۸۰۵) حدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ  شَہِدْت عَبْدَ اللہِ بْنَ یَزِیدَ أَدْخَلَ الْحَارِثَ مِنْ قِبَلِ رِجْلَیْہِ ، وَقَالَ : ہَکَذَا السُّنَّۃُ۔ (ابوداؤد ۳۲۰۳۔ بیہقی ۵۴)""","Sahih","Musannaf Ibn Abi Shaybah 11805","","","كتاب الجنائز"
"11806","(۱۱۸۰۶) حدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ، قَالَ شَہِدْت الشَّعْبِیَّ أَدْخَلَ مَیِّتًا مِنْ قِبَلِ رِجْلَیْہِ۔","","Musannaf Ibn Abi Shaybah 11806","","","كتاب الجنائز"
"11807","(۱۱۸۰۷) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَحَدَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأُخِذَ مِنْ قِبَلِ الْقِبْلَۃِ وَرَفَعَ قَبْرُہُ حَتَّی یُعْرَفَ۔ (عبدالرزاق ۴۶۷۱)","","Musannaf Ibn Abi Shaybah 11807","","","كتاب الجنائز"
"11808","(۱۱۸۰۸) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، قَالَ : حُدِّثَتْ عَنْ عُمَیْرِ بْنِ سَعِیدٍ ، أَنَّ عَلِیًّا أَدْخَلَ مَیِّتًا مِنْ قِبَلِ الْقِبْلَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 11808","","","كتاب الجنائز"
"11809","(۱۱۸۰۹) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنِ الْحَسَنِ ، عَنْ مُجَاہِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : یُؤْخَذُ مِنْ قِبَلِ الْقِبْلَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 11809","","","كتاب الجنائز"
"11810","(۱۱۸۱۰) حدَّثَنَا ہُشَیْمٌ ، عَنْ عِمْرَانَ بْنِ أَبِی عَطَائٍ مَوْلَی بَنِی أَسَدٍ ، قَالَ : شَہِدْت وَفَاۃَ ابْنِ عَبَّاسٍ فَوَلِیَہُ ابْنُ الْحَنَفِیَّۃِ ، قَالَ : فَکَبَّرَ عَلَیْہِ أَرْبَعًا وَأَدْخَلَہُ مِنْ قِبَلِ الْقِبْلَۃِ۔","","Musannaf Ibn Abi Shaybah 11810","","","كتاب الجنائز"
"11811","(۱۱۸۱۱) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عُمَیْرِ بْنِ سَعِیدٍ ، أَنَّ عَلِیًّا کَبَّرَ عَلَی یَزِیدَ بْنِ الْمُکَفَّفِ أَرْبَعًا وَأَدْخَلَہُ مِنْ قِبَلِ الْقِبْلَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 11811","","","كتاب الجنائز"
"11812","(۱۱۸۱۲) حدَّثَنَا ابْنُ یَمَانٍ ، عَنِ الْمِنْہَالِ بْنِ خَلِیفَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَخَذَہُ مِنْ قِبَلِ الْقِبْلَۃِ ، وَکُبِّرَ عَلَیْہِ أَرْبَعًا یعنی المیت۔ (ترمذی ۱۰۵۷)","Da'if","Musannaf Ibn Abi Shaybah 11812","","","كتاب الجنائز"
"11813","(۱۱۸۱۳) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ أَدْخَلَ مَیِّتًا مِنْ قِبَلِ الْقِبْلَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11813","","","كتاب الجنائز"
"11814","(۱۱۸۱۴) حدَّثَنَا وَکِیعٌ ، عَنِ سُفْیان ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ بِمِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 11814","","","كتاب الجنائز"
"11815","(۱۱۸۱۵) حدَّثَنَا وَکِیعٌ ، عَنْ ہَمَّامٍ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی الصِّدِّیقِ النَّاجِی ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا وَضَعْتُمْ مَوْتَاکُمْ فِی قُبُورِہِمْ فَقُولُوا : بِسْمِ اللہِ وَعَلَی سُنَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (ابوداؤد ۳۲۰۵۔ احمد ۲/۲۷)","Sahih","Musannaf Ibn Abi Shaybah 11815","","","كتاب الجنائز"
"11816","(۱۱۸۱۶) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی الصِّدِّیقِ النَّاجِی ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 11816","","","كتاب الجنائز"
"11817","(۱۱۸۱۷) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا وَضَعَ الْمَیِّتَ فِی الْقَبْرِ ، قَالَ : بِسْمِ اللہِ وَبِاللہِ وَعَلَی سُنَّۃِ رَسُولِ اللہِ۔n(ترمذی ۱۰۴۶۔ ابن ماجہ ۱۵۵۰)","","Musannaf Ibn Abi Shaybah 11817","","","كتاب الجنائز"
"11818","(۱۱۸۱۸) حدَّثَنَا شَرِیکٌ وَأَبُو الأَحْوَصِ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی مُدْرِکٍ الأَشْجَعِیِّ ، عَنْ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ إذَا أَدْخَلَ الْمَیِّتَ فی قَبْرِہِ ، وَقَالَ أَبُو الأَحْوَصِِ إذَا سَوَّی عَلَیْہِ اللَّہُمَّ أَسْلِمْہُ إلَیْک الْمَالَ وَالأَہْلَ وَالْعَشِیرَۃَ وَالذَّنْبَ الْعَظِیمَ فَاغْفِرْ لَہُ۔","","Musannaf Ibn Abi Shaybah 11818","","","كتاب الجنائز"
"11819","(۱۱۸۱۹) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ خَیْثَمَۃَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ إذَا وَضَعُوا الْمَیِّتَ فِی الْقَبْرِ أَنْ یَقُولُوا : بِسْمِ اللہِ وَفِی سَبِیلِ اللہِ وَعَلَی مِلَّۃِ رَسُولِ اللہِ ، اللَّہُمَّ أَجِرْہُ مِنْ عَذَابِ الْقَبْرِ ، وَعَذَابِ النَّارِ ، وَمِنْ شَرِّ الشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 11819","","","كتاب الجنائز"
"11820","(۱۱۸۲۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، أَنَّہُ کَانَ یَقُولُ : بِسْمِ اللہِ وَفِی سَبِیلِ اللہِ ، اللَّہُمَّ افْسحْ لَہُ فِی قَبْرِہِ ، وَنَوِّرْ لَہُ فِیہِ ، وَأَلْحِقْہُ بِنَبِیَّہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَنْتَ عَنْہُ رَاضٍ غَیْرُ غَضْبَانَ۔","","Musannaf Ibn Abi Shaybah 11820","","","كتاب الجنائز"
"11821","(۱۱۸۲۱) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، عَنْ حُصَیْنٍ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : إذَا وَضَعْتَ الْمَیِّتَ فِی الْقَبْرِ فَقُلْ : بِسْمِ اللہِ ، وَإِلَی اللہِ ، وَعَلَی سُنَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 11821","","","كتاب الجنائز"
"11822","(۱۱۸۲۲) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا وَضَعْت الْمَیِّتَ فِی الْقَبْرِ فَقُلْ : بِسْمِ اللہِ ، وَعَلَی مِلَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 11822","","","كتاب الجنائز"
"11823","(۱۱۸۲۳) حدَّثَنَا وَکِیعٌ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، أَنَّہُ دَفَنَ ابْنًا لَہُ ، فَقَالَ : اللہم جَافِ الأَرْضَ عَنْ جَنْبَیْہِ ، وَافْتَحْ أَبْوَابَ الْسَمَائِ لِرُوحِہِ ، وَأَبْدِلْہُ بِدَارِہِ دَارًا خَیْرًا مِنْ دَارِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 11823","","","كتاب الجنائز"
"11824","(۱۱۸۲۴) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِیہِ ، قَالَ : إذَا وُضِعَ الْمَیِّتُ فِی الْقَبْرِ فَلاَ تَقُلْ بِسْمِ اللہِ ، وَلَکِنْ قُلْ فِی سَبِیلِ اللہِ وَعَلَی سُنَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَعَلَی مِلَّۃِ إبْرَاہِیمَ حَنِیفًا مُسْلِمًا وَمَا کَانَ مِنَ الْمُشْرِکِینَ ، اللَّہُمَّ ثَبِّتْہُ بِالْقَوْلِ الثَّابِتِ فِی الآخِرَۃِ اللَّہُمَّ اجْعَلْہُ فِی خَیْرٍ مِمَّا کَانَ فِیہِ ، اللَّہُمَّ لاَ تَحْرِمْنَا أَجْرَہُ ، وَلاَ تَفْتِنَّا بَعْدَہُ ، قَالَ : وَنَزَلَتْ ہَذِہِ الآیَۃُ فِی صَاحِبِ الْقَبْرِ : {یُثَبِّتُ اللَّہُ الَّذِینَ آمَنُوا بِالْقَوْلِ الثَّابِتِ فِی الْحَیَاۃِ الدُّنْیَا وَفِی الآخِرَۃِ}۔","","Musannaf Ibn Abi Shaybah 11824","","","كتاب الجنائز"
"11825","(۱۱۸۲۵) حدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قُلْتُ لِمُحَمَّدٍ إذَا وَضَعْتُ الْمَیِّتَ فِی اللَّحْدِ مَا أَقُولُ ؟ قَالَ : لاَ شَیْئَ۔","No Data Available","Musannaf Ibn Abi Shaybah 11825","","","كتاب الجنائز"
"11826","(۱۱۸۲۶) حدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، قَالَ : کَانَ عَلِیٌّ یَقُولُ عِنْدَ الْمَنَامِ إذَا نَامَ بِسْمِ اللہِ وَفی سَبِیلِ اللہِ ، وَعَلَی مِلَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَیَقُولُہُ إذَا أُدْخِلَ الرَّجُلَ الْقَبْرَ۔","Hasan","Musannaf Ibn Abi Shaybah 11826","","","كتاب الجنائز"
"11827","(۱۱۸۲۷) حدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ ، قَالَ : کَانَ أَنَسُ بْنُ مَالِکٍ إذَا سُوِّیَ عَلَی الْمَیِّتِ قَبْرَہُ قَامَ عَلَیْہِ ، فَقَالَ : اللَّہُمَّ عَبْدُک رُدَّ إلَیْک فَارْأَفْ بِہِ وَارْحَمْہُ ، اللَّہُمَّ جَافِ الأَرْضَ عَنْ جَنْبَہِ ، وَافْتَحْ أَبْوَابَ السَّمَائِ لِرُوحِہِ ، وَتَقَبَّلْہُ مِنْک بِقَبُولٍ حَسَنٍ ، اللَّہُمَّ إِنْ کَانَ مُحْسِنًا فَضَاعِفْ لَہُ فِی إحْسَانِہِ ، أَوَ قَالَ: فَزِدْ فِی إحْسَانِہِ ، وَإِنْ کَانَ مُسِیئًا فَتَجَاوَزْ عَنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 11827","","","كتاب الجنائز"
"11828","(۱۱۸۲۸) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ عُمَیْرِ بْنِ سَعِیدٍ ، أَنَّ عَلِیًّا کَبَّرَ عَلَی یَزِیدَ أَرْبَعًا ، قَالَ : اللَّہُمَّ عَبْدُک وَابْنُ عَبْدِکَ نَزَلَ بِکَ الْیَوْمَ ، وَأَنْتَ خَیْرُ مَنْزُولٍ بِہِ ، اللَّہُمَّ وَسِّعْ لَہُ مُدْخَلَہُ ، وَاغْفِرْ لَہُ ذَنْبَہُ ، فَإِنَّا لاَ نَعْلَمُ إِلاَّ خَیْرًا وَأَنْتَ أَعْلَمُ بِہِ۔","","Musannaf Ibn Abi Shaybah 11828","","","كتاب الجنائز"
"11829","(۱۱۸۲۹) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ لَمَّا فَرَغَ مِنْ قَبْرِ عَبْدِ اللہِ بْنِ السَّائِبِ قَامَ ابْنُ عَبَّاسِ عَلَی الْقَبْرِ فَوَقَفَ عَلَیْہِ ، ثُمَّ دَعَا ، ثُمَّ انْصَرَفَ۔","","Musannaf Ibn Abi Shaybah 11829","","","كتاب الجنائز"
"11830","(۱۱۸۳۰) حدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنِ الأَسْوَد بْنِ شَیْبَانَ ، عَنْ خَالِدِ بْنِ سُمَیْرٍ ، قَالَ : کُنْتُ مَعَ الأَحْنَفِ فِی جِنَازَۃٍ فَجَلَسَ الأَحْنَفُ وَجَلَسْت مَعَہُ ، فَلَمَّا فُرِغَ مِنْ دَفْنِہَا وَہُوَ ضِرَارُ بْنُ الْقَعْقَاعِ التَّمِیمِیُّ رَأَیْت الأَحْنَفَ انْتَہَی إلَی قَبْرِہِ فَقَامَ عَلَیْہِ فَبَدَأَ بِالثَّنَائِ قَبْلَ الدُّعَائِ ، فَقَالَ : کُنْت وَاللَّہِ مَا عَلِمْتُ کَذَا ، کُنْت وَاللَّہِ مَا عَلِمْتُ کَذَا ، ثُمَّ دَعَا لَہُ۔","","Musannaf Ibn Abi Shaybah 11830","","","كتاب الجنائز"
"11831","(۱۱۸۳۱) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عُمَیْرِ بْنِ سَعِیدٍ ، قَالَ صَلَّیْت مَعَ عَلِیٍّ عَلَی یَزِیدَ بْنَ الْمُکَفَّفِ فَکَبَّرَ عَلَیْہِ أَرْبَعًا ، ثُمَّ مَشَی حَتَّی أَتَاہُ ، فَقَالَ : اللَّہُمَّ عَبْدُک ، وَابْنُ عَبْدِکَ نَزَلَ بِکَ الْیَوْمَ فَاغْفِرْ لَہُ ذَنْبَہُ ، وَوَسِّعْ عَلَیْہِ مُدْخَلَہُ فَإِنَّا لاَ نَعْلَمُ إِلاَّ خَیْرًا وَأَنْتَ أَعْلَمُ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 11831","","","كتاب الجنائز"
"11832","(۱۱۸۳۲) حدَّثَنَا ابْنُ عُلَیَّۃَ ، قَالَ : رَأَیْتُ أَیُّوبَ یقوم عَلَی الْقَبْرِ فَیَدْعُو لِلْمَیِّتِ ، قَالَ : وَرُبَّمَا رَأَیْتُہُ یَدْعُو لَہُ وَہُوَ فِی الْقَبْرِ قَبْلَ أَنْ یَخْرُجَ۔","","Musannaf Ibn Abi Shaybah 11832","","","كتاب الجنائز"
"11833","(۱۱۸۳۳) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حُجَّاجٍ ، عَنْ عُمَیْرِ بْنِ سَعِیدٍ ، أَنَّ عَلِیًّا حَثَی فِی قَبْرِ ابْنِ الْمُکَفَّفِ۔","","Musannaf Ibn Abi Shaybah 11833","","","كتاب الجنائز"
"11834","(۱۱۸۳۴) حدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ عُمَیْرِ بْنِ سَعِیدٍ ، أَنَّ عَلِیًّا حَثَی فِی قَبْرِ ابْنِ الْمُکَفَّفِ۔","Sahih","Musannaf Ibn Abi Shaybah 11834","","","كتاب الجنائز"
"11835","(۱۱۸۳۵) حدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ یَعْقُوبَ بن زَیْدٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حُثِیَ فِی قَبْرِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 11835","","","كتاب الجنائز"
"11836","(۱۱۸۳۶) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ ثَوْرٍ ، قَالَ : حدَّثَنَا عَامِر بْنُ جَشِیبٍ وَغَیْرُہُ مِنْ أَہْلِ الشَّامِ ، عنْ أَبِی الدَّرْدَائِ ، قَالَ : مِنْ تَمَامِ أَجْرِ الْجِنَازَۃِ أَنْ یَحْثُوَ فِی الْقَبْرِ۔","","Musannaf Ibn Abi Shaybah 11836","","","كتاب الجنائز"
"11837","(۱۱۸۳۷) حدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ یَعْقُوبَ الأَحْلاَفِی، قَالَ: أَخْبَرَنِی مَنْ رَأَی زَیْدَ بْنَ أَرْقَمَ حَثَا فِی قَبْرٍ ثَلاَثًا۔","Da'if","Musannaf Ibn Abi Shaybah 11837","","","كتاب الجنائز"
"11838","(۱۱۸۳۸) حدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَن عَمِّہ : أَنَّ عَلِیًا حثی فِی قَبْر۔","","Musannaf Ibn Abi Shaybah 11838","","","كتاب الجنائز"
"11839","(۱۱۸۳۹) حدَّثَنَا دَاوُد عن مبارک ، عَنِ الْحَسَنِ ، قَالَ : إِنْ شِئْتَ فَاحْثُ فِی الْقَبْرِ وَإِنْ شِئْتَ فَلاَ تَحْثُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 11839","","","كتاب الجنائز"
"11840","(۱۱۸۴۰) حدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، أَنَّہُ رَأَی سَالِمَ بْنَ عَبْدِ اللہِ عَلَی شَفِیرِ قَبْرٍ ، ثُمَّ انْصَرَفَ، وَلَمْ یَحْثُ فِیہِ شَیْئًا مِنْ تُرَابٍ۔","","Musannaf Ibn Abi Shaybah 11840","","","كتاب الجنائز"
"11841","(۱۱۸۴۱) حدَّثَنَا الفَضْل بْنُ دُکَیْنٍ ، عَنِ الْحَکَمِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِی نُعْمٍ ، قَالَ : حدَّثَنِی رَجُلٌ مِنْ جُہَیْنَۃَ ، قَالَ : کُنْتُ مَعَ أَبِی ہُرَیْرَۃَ فِی جِنَازَۃٍ فَحَثَی فِی قَبْرِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 11841","","","كتاب الجنائز"
"11842","أَخْبَرَنَا أَبُو مُحَمَّدٍ عَبْدُ اللہِ بْنُ یُونُسَ ، قَالَ : حدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ بَقِیُّ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا أَبُو بَکْرٍ عَبْدُ اللہِ بْنُ مُحَمَّدِ بْنِ أَبِی شَیْبَۃَ ، قَالَ :n(۱۱۸۴۲) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ مَعْمَرٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، أَنَّہُ أَمَرَ أَنْ یُحْثَی عَلَیْہِ التُّرَابُ حَثْیًا۔","","Musannaf Ibn Abi Shaybah 11842","","","كتاب الجنائز"
"11843","(۱۱۸۴۳) حدَّثَنَا عَثَّامُ بْنُ عَلِیٍّ ، عَنْ عَاصِمِ بْنِ بَہْدَلَۃَ ، قَالَ شَہِدْت عُمَرَ بْنَ عَبْدِ الْعَزِیزِ حِینَ دُفِنَ سُنُّ عَلَیْہِ التُّرَابُ سَنًّا۔","","Musannaf Ibn Abi Shaybah 11843","","","كتاب الجنائز"
"11844","(۱۱۸۴۴) حدَّثَنَا عُبَیْد اللہِ بْنِ مُوسَی ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ عَبْدِ اللہِ بْنِ الْمُخْتَارِ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، قَالَ : حَدَّثَنِی أَبُو کَرْبٍ ، أَوْ أَبُو حَرْبٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، أَنَّہُ حَدَّثَہُ ، أَنَّ أَبَاہُ أَوْصَاہُ ، قَالَ : إذَا أَنْتَ وَضَعْتنِی فِی الْقَبْرِ فَسُنَّ علی التُّرَابَ سَنًّا۔","Sahih","Musannaf Ibn Abi Shaybah 11844","","","كتاب الجنائز"
"11845","(۱۱۸۴۵) حدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عُثْمَانَ بْنِ الْحَارِثِ ، عَنِ الشَّعْبِیِّ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جُعِلَ عَلَی لَحْدِہِ طُنُّ قَصَبٍ۔","","Musannaf Ibn Abi Shaybah 11845","","","كتاب الجنائز"
"11846","(۱۱۸۴۶) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَمْرِو بْنِ شُرَحْبِیلَ ، أَنَّہُ قَالَ : اطْرَحُوا عَلَیَّ أَطْنَانًا مِنْ قَصَبٍ ، فَإِنِّی رَأَیْت الْمُہَاجِرِینَ یَسْتَحِبُّونَہُ عَلَی مَا سِوَاہُ۔","","Musannaf Ibn Abi Shaybah 11846","","","كتاب الجنائز"
"11847","(۱۱۸۴۷) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یُجْعَلَ فِی اللَّحْدِ إِلاَّ لَبِنٌ نَظِیفٌ ، قَالَ : وَکَانَ یَکْرَہُ الآجُرَّ ، وَقَالَ : إِنْ لَمْ یَجِدُوا لَبِنًا فَقَصَبٌ۔","","Musannaf Ibn Abi Shaybah 11847","","","كتاب الجنائز"
"11848","(۱۱۸۴۸) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی مَیْسَرَۃَ ، أَنَّہُ أَوْصَی ، قَالَ : اجْعَلُوا عَلَی قَبْرِی طُنًّا مِنْ قَصَبٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 11848","","","كتاب الجنائز"
"11849","(۱۱۸۴۹) حدَّثَنَا قُرَّۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالسَّاجِ وَالْقَصَبِ وَکَرِہَ الآجُرَّ ، یَعْنِی فِی الْقَبْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11849","","","كتاب الجنائز"
"11850","(۱۱۸۵۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ عِیسَی ، عَنِ الزُّہْرِیِّ ، عَنْ عَلِیِّ بْنِ حُسَیْنٍ ، قَالَ نُصِبَ اللَّبِنُ عَلَی قَبْرِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَصَبًا۔ (ابن سعد ۲۹۷)","","Musannaf Ibn Abi Shaybah 11850","","","كتاب الجنائز"
"11851","(۱۱۸۵۱) حدَّثَنَا مُعْتَم??رُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ قَالاَ : إِنْ شِئْتَ بَنَیْت الْقَبْرَ بِنَائً ، وَإِنْ شِئْتَ نَصَبْت اللَّبِنَ نَصْبًا۔","No Data Available","Musannaf Ibn Abi Shaybah 11851","","","كتاب الجنائز"
"11852","(۱۱۸۵۲) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عَلِیِّ بْنِ حُسَیْنٍ أَنَّ قَبْرَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَصَبُوا عَلَیہ اللَّبِنَ نَصْبًا۔","","Musannaf Ibn Abi Shaybah 11852","","","كتاب الجنائز"
"11853","(۱۱۸۵۳) حدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ وَسَالِمٍ وَالْقَاسِمِ قَالُوا : کَانَ قَبْرُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، وَأَبِی بَکْرٍ وَعُمَرَ جُثًا قِبْلَۃً ، نُصِبَ لَہُمُ اللَّبِنُ نَصْبًا۔","Da'if","Musannaf Ibn Abi Shaybah 11853","","","كتاب الجنائز"
"11854","(۱۱۸۵۴) حدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ وَسَالِمٍ وَالْقَاسِمِ قَالُوا : کَانَ قَبْرُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبِی بَکْرٍ وَعُمَرَ جُثًا قِبْلَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 11854","","","كتاب الجنائز"
"11855","(۱۱۸۵۵) حدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : رَأَیْتُ قُبُورَ شُہَدَائِ جُثًا قَدْ نبتت عَلَیْہَا النَّصِی۔","","Musannaf Ibn Abi Shaybah 11855","","","كتاب الجنائز"
"11856","(۱۱۸۵۶) حدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ سُفْیَانَ التَّمَّارِ ، قَالَ : دَخَلَتُ الْبَیْتَ الَّذِی فِیہِ قَبْرُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَرَأَیْت قَبْرَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَقَبْرَ أَبِی بَکْرٍ وَعُمَرَ مُسَنَّمَۃً۔ (بخاری۱۳۹۰)","","Musannaf Ibn Abi Shaybah 11856","","","كتاب الجنائز"
"11857","(۱۱۸۵۷) حدَّثَنَا الأَشْجَعِیُّ ، عَنْ سُفْیَانَ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی نَعَامَۃَ ، قَالَ شَہِدْت مَعَ مُوسَی بْنِ طَلْحَۃَ جِنَازَۃً ، فَقَالَ : جَمہرُوہ ، جَمہرُوہ ، یَعْنِی سَنِّمُوہُ۔","","Musannaf Ibn Abi Shaybah 11857","","","كتاب الجنائز"
"11858","(۱۱۸۵۸) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : رَأَیْتُ قُبُورَ شُہَدَائِ أُحُدٍ جُثًا مُسَنَّمَۃً۔","","Musannaf Ibn Abi Shaybah 11858","","","كتاب الجنائز"
"11859","(۱۱۸۵۹) حدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ خَالِدٍ بْنِ أَبِی عُثْمَانَ ، عَنْ رَجُلٍ ، قَالَ : رَأَیْتُ قَبْرَ ابْنِ عُمَرَ بَعْدَ مَا دُفِنَ بِأَیَّامٍ مُسَنَّمًا۔","Da'if","Musannaf Ibn Abi Shaybah 11859","","","كتاب الجنائز"
"11860","(۱۱۸۶۰) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ مُحَمَّدٍ ، أَنَّہُ کَرِہَ أَنْ یُعَلَّمَ الْقَبْرُ۔","","Musannaf Ibn Abi Shaybah 11860","","","كتاب الجنائز"
"11861","(۱۱۸۶۱) حدَّثَنَا أَبُو دَاوُدَ، عَنْ سَلِیمِ بْنِ حَیَّانَ، عَنْ حَمَّادٍ، عَنْ إبْرَاہِیمَ، قَالَ: کَانُوا یَکْرَہُونَ أَنْ یُعْلِمَ الرَّجُلُ قَبْرَہُ۔","","Musannaf Ibn Abi Shaybah 11861","","","كتاب الجنائز"
"11862","(۱۱۸۶۲) حدَّثَنَا أَبُو بَکْرٍ الْحَنَفِیُّ ، عَنْ کَثِیرِ بْنِ زَیْدٍ ، عَنِ الْمُطَّلِبِ بْنِ عَبْدِ اللہِ بْنِ حَنْطَبٍ ، قَالَ : لَمَّا مَاتَ عُثْمَانَ بْنُ مَظْعُونٍ دَفَنَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْبَقِیعِ ، وَقَالَ لِرَجُلٍ اذْہَبْ إلَی تِلْکَ الصَّخْرَۃِ فَآتِنِی بِہَا حَتَّی أَضَعَہَا عِنْدَ قَبْرِہِ حَتَّی أُعَرِّفَہُ بِہَا۔ (ابوداؤد ۳۱۹۸)","","Musannaf Ibn Abi Shaybah 11862","","","كتاب الجنائز"
"11863","(۱۱۸۶۳) حدَّثَنَا أَبُو بَکْرٍ الْحَنَفِیُّ ، عَنْ أَفلَح ، عَنِ الْقَاسِمِ ، أَنَّہُ أَوْصَی ، قَالَ : یَا بُنَیَّ لاَ تَکْتُبْ عَلَی قَبْرِی ، وَلاَ تُشَرِّفَنَّہُ إِلاَّ قَدْرَ مَا یَرُدُّ عَنِّی الْمَائَ۔","","Musannaf Ibn Abi Shaybah 11863","","","كتاب الجنائز"
"11864","(۱۱۸۶۴) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُبْنَی عَلَیْہِ ، وَقَالَ سُلَیْمَانُ بْنُ مُوسَی ، عَنْ جَابِرٍ وَأَنْ یُکْتَبَ عَلَیْہِ۔ (ابوداؤد ۳۲۱۷۔ ترمذی ۱۰۵۲)","Sahih","Musannaf Ibn Abi Shaybah 11864","","","كتاب الجنائز"
"11865","(۱۱۸۶۵) حدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ مُبَارَکٍ ، عَنِ الْحَسَنِ ، أَنَّہُ کَرِہَ أَنْ یُجْعَلَ اللَّوْحُ عَلَی الْقَبْرِ۔","","Musannaf Ibn Abi Shaybah 11865","","","كتاب الجنائز"
"11866","(۱۱۸۶۶) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَجْعَلَ عَلَی الْقَبْرِ مَسْجِدًا۔","","Musannaf Ibn Abi Shaybah 11866","","","كتاب الجنائز"
"11867","(۱۱۸۶۷) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ لُحِدَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَرُفِعَ قَبْرُہُ حَتَّی یُعْرَفَ۔","","Musannaf Ibn Abi Shaybah 11867","","","كتاب الجنائز"
"11868","(۱۱۸۶۸) حدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ، قَالَ: رَأَیْتُ قَبْرَ عُثْمَانَ بْنِ مَظْعُونٍ مُرْتَفِعًا۔","","Musannaf Ibn Abi Shaybah 11868","","","كتاب الجنائز"
"11869","(۱۱۸۶۹) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا إبْرَاہِیمُ بْنُ عَطَائٍ بْنُ أَبِی مَیْمُونَۃَ ، عَنْ أَبِیہِ ، أَنَّ عِمْرَانَ بْنَ حُصَیْنٍ أَوْصَی أَنْ یَجْعَلُوا قَبْرَہُ مُرَبَّعًا ، وَأَنْ یَرْفَعُوہُ أَرْبَعَ أَصَابِعَ ، أَوْ نَحْوَ ذَلِکَ۔","Hasan","Musannaf Ibn Abi Shaybah 11869","","","كتاب الجنائز"
"11870","(۱۱۸۷۰) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الْمَقْبُرِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ مِہْرَانَ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّہُ أَوْصَی أَنْ لاَ یَضْرِبُوا عَلَی قَبْرِہِ فُسْطَاطًا۔","Hasan","Musannaf Ibn Abi Shaybah 11870","","","كتاب الجنائز"
"11871","(۱۱۸۷۱) حدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ إسْمَاعِیلَ بْنِ مُجَمِّعٍ ، عَنْ عَمَّتِہِ أُمِّ النُّعْمَانِ ، عَنْ بِنْتِ أَبِی سَعِیدٍ الْخُدْرِیِّ ، أَنَّ أَبَا سَعِیدٍ ، قَالَ : لاَ تَضْرِبُوا عَلَی قَبْرِی فُسْطَاطًا۔","Da'if","Musannaf Ibn Abi Shaybah 11871","","","كتاب الجنائز"
"11872","(۱۱۸۷۲) حدَّثَنَا ہُشَیْمٌ ، عَنْ عِمْرَانَ بْنِ أَبِی عَطَائٍ ، قَالَ : شَہِدْت وَفَاۃَ ابْنِ عَبَّاسٍ فَوَلِیَہُ ابْنُ الْحَنَفِیَّۃِ فَبَنَی عَلَیْہِ بِنَائً ثَلاَثَۃَ أَیَّامٍ۔","","Musannaf Ibn Abi Shaybah 11872","","","كتاب الجنائز"
"11873","(۱۱۸۷۳) حدَّثَنَا وَکِیعٌ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، أَنَّ عُمَرَ ضَرَبَ عَلَی قَبْرِ زَیْنَبَ فُسْطَاطًا۔","Da'if","Musannaf Ibn Abi Shaybah 11873","","","كتاب الجنائز"
"11874","(۱۱۸۷۴) حدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ ثَعْلَبَۃَ ، قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ کَعْبٍ یَقُولُ : ہَذِہِ الْفَسَاطِیطُ الَّتِی عَلَی الْقُبُورِ مُحْدَثَۃٌ۔","","Musannaf Ibn Abi Shaybah 11874","","","كتاب الجنائز"
"11875","(۱۱۸۷۵) حدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنِ الْحَسَنِ ، قَالَ : جُعِلَ فِی لَحْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَطِیفَۃٌ حَمْرَائُ کَانَ أَصَابَہَا یَوْمَ خَیبَرَ ، قَالَ : فَجَعَلُوہَا لأَنَّ الْمَدِینَۃَ أَرْضٌ سَبْخَۃٌ۔","","Musannaf Ibn Abi Shaybah 11875","","","كتاب الجنائز"
"11876","(۱۱۸۷۶) حدَّثَنَا غُنْدَرُ وَوَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی جَمْرَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ وُضِعَ فِی قَبْرِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَطِیفَۃٌ حَمْرَائُ۔ (مسلم ۹۱۔ احمد ۱/۳۵۵)","Sahih","Musannaf Ibn Abi Shaybah 11876","","","كتاب الجنائز"
"11877","(۱۱۸۷۷) حدَّثَنَا حَفْصُ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ لُحِدَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَلْقَی شُقْرَانُ فِی قَبْرِہِ قَطِیفَۃً کَانَ یَرْکَبُ بہا فِی حَیَاتِہِ۔ (ترمذی ۱۰۴۷۔ عبدالرزاق ۶۳۸۷)","","Musannaf Ibn Abi Shaybah 11877","","","كتاب الجنائز"
"11878","(۱۱۸۷۸) حدَّثَنَا وَکِیعٌ ، عَنْ قَیْسِ بْنِ سُلَیِمٍ ، عَنْ عُمَیْرِ بْنِ سَعِیدٍ ، أَنَّ عَلِیًّا قَامَ عَلَی قَبْرٍ حَتَّی دُفِنَ ، وَقَالَ : لِیَکُنْ لأَحَدِکُمْ قِیَامٌ عَلَی قَبْرِہِ حَتَّی یُدْفَنَ۔","Sahih","Musannaf Ibn Abi Shaybah 11878","","","كتاب الجنائز"
"11879","(۱۱۸۷۹) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی قَیْسٍ ، قَالَ : شَہِدْت عَلْقَمَۃَ قَامَ علَی مَیِّتٍ حَتَّی دُفِنَ۔","","Musannaf Ibn Abi Shaybah 11879","","","كتاب الجنائز"
"11880","(۱۱۸۸۰) حدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ ثُمَامَۃَ ، قَالَ خَرَجْنَا مَعَ فَضَالَۃَ بْنِ عُبَیْدٍ إلَی أَرْضِ الرُّومِ ، قَالَ : وَکَانَ عَامِلاً لِمُعَاوِیَۃَ عَلَی الدَّرْبِ ، فَأُصِیبَ ابْنُ عَمٍّ لَنَا یُقَالُ لَہُ نَافِعٌ ، فَصَلَّی عَلَیْہِ فَضَالَۃُ وَقَامَ عَلَی حَفْرَتِہِ حَتَّی وَارَاہُ۔","Hasan","Musannaf Ibn Abi Shaybah 11880","","","كتاب الجنائز"
"11881","(۱۱۸۸۱) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرِ ، قَالَ : کَانَ عَبْدُ اللہِ بْنُ الزُّبَیْرِ إذَا مَاتَ لہ المیت لَمْ یَزَلْ قَائِمًا حَتَّی یَدْفِنَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 11881","","","كتاب الجنائز"
"11882","(۱۱۸۸۲) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : وَاللَّہِ إنَّ قِیَامَہُمْ عَلَی الْقَبْرِ لَبِدْعَۃٌ حَتَّی تُوضَعَ فِی قَبْرِہَا إذَا صُلِّیَ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 11882","","","كتاب الجنائز"
"11883","(۱۱۸۸۳) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ عَنِ الْقِیَامِ لِلْجِنَازَۃِ حَتَّی تُوضَعَ فِی اللَّحْدِ، فَقَالَ: مَا رَأَیْت أَحَدًا یَصْنَعُ ذَلِکَ إِلاَّ أَبَا مَرْحُومٍ ذَاکَ الشَّامِیِّ ، وَکَانُوا یَہْزَؤُونَ بِہِ۔","","Musannaf Ibn Abi Shaybah 11883","","","كتاب الجنائز"
"11884","(۱۱۸۸۴) حدَّثَنَا الْفَضْلُ بْنَ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ الْقِیَامَ عِنْدَ الْقَبْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11884","","","كتاب الجنائز"
"11885","(۱۱۸۸۵) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : ذُکِرَ لِلشَّعْبِیِّ الْقِیَامُ لِلْجِنَازَۃِ حَتَّی تُوضَعَ فَکَأَنَّہُ لَمْ یَعْرِفْ ذَلِکَ ، قَالَ : فَذَکَرْت ذَلِکَ لِمُجَاہِدٍ ، قَالَ : إنَّمَا ذَلِکَ إذَا صُلِّیَ عَلَیْہَا لاَ یَجْلِسُ حَتَّی تُوضَعَ۔","","Musannaf Ibn Abi Shaybah 11885","","","كتاب الجنائز"
"11886","(۱۱۸۸۶) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُجَصَّصَ الْقَبْرُ وَأَنْ یُقْعَدَ عَلَیْہِ وَأَنْ یُبْنَی عَلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 11886","","","كتاب الجنائز"
"11887","(۱۱۸۸۷) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ ثَابِتِ بْنِ زَیْدٍ ، قَالَ : حَدَّثَتْنِی حَمَادَۃُ ، عَنْ أُنَیْسَۃَ بِنْتِ زَیْدِ بْنِ أَرْقَمَ ، قَالَتْ : مَاتَ ابْنٌ لِزَیْدٍ یُقَالُ لَہُ سُوَیْد ، فَاشْتَرَی غُلاَمٌ لَہُ ، أَوْ جَارِیَۃٌ جِصًّا وَآجُرًّا ، فَقَالَ لَہُ زَیْدٌ : مَا تُرِیدُ إلَی ہَذَا ، قَالَ : أَرَدْت أَنْ أَبْنِیَ قَبْرَہُ وَأُجَصِّصَہُ ، قَالَ : حَقِرْت ونَقِرْت لاَ تُقَرِّبْہُ شَیْئًا مَسَّتْہُ النَّارُ۔","Da'if","Musannaf Ibn Abi Shaybah 11887","","","كتاب الجنائز"
"11888","(۱۱۸۸۸) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ عیسی بنِ أَبِی عَزَّۃَ ، قَالَ : سَمِعْتُہ ینہَی عَنْ تَجْصِیصِ الْقَبْرِ ، قَالَ : لاَ تُجَصِّصُوہُ۔","","Musannaf Ibn Abi Shaybah 11888","","","كتاب الجنائز"
"11889","(۱۱۸۸۹) حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّد ، عَنْ لَیْثٍ ، عَنْ خَیْثَمَۃَ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : إذَا أَنَا مِتُّ فَلاَ تُؤْذِنُوا بِی أَحَدًا ، وَلاَ تُقَرِّبُونِی جِصًّا ، وَلاَ آجُرًّا ، وَلاَ عُودًا ، وَلاَ تَصْحَبُنِی امْرَأَۃٌ۔","","Musannaf Ibn Abi Shaybah 11889","","","كتاب الجنائز"
"11890","(۱۱۸۹۰) حدَّثَنَا ہُشَیْمٌ ، أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَکْرَہُ الآجُرَّ۔","No Data Available","Musannaf Ibn Abi Shaybah 11890","","","كتاب الجنائز"
"11891","(۱۱۸۹۱) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ الآجُرَّ فِی قُبُورِہِمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 11891","","","كتاب الجنائز"
"11892","(۱۱۸۹۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ اللَّبِنَ وَیَکْرَہُونَ الآجُرَّ وَیَسْتَحِبُّونَ الْقَصَبَ وَیَکْرَہُونَ الْخَشَبَ۔","No Data Available","Musannaf Ibn Abi Shaybah 11892","","","كتاب الجنائز"
"11893","(۱۱۸۹۳) حدَّثَنَا أَبُو بَکْرٍ ، عَنْ أَبِی حَصِینٍ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : کُنْتُ أَمْشِی مَعَ عَبْدِ اللہِ فِی الْجَبَّانَۃِ ، فَقَالَ : لأَنْ أَطَأَ عَلَی جَمْرَۃٍ حَتَّی تُطْفَأَ أَحَبُّ إلَیَّ مِنْ أَنْ أَطَأَ عَلَی قَبْرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 11893","","","كتاب الجنائز"
"11894","(۱۱۸۹۴) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عُیَیْنَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنْ أَبِی بَکْرَۃَ ، قَالَ : لأَنْ أَطَأَ عَلَی جَمْرَۃٍ حَتَّی تُطْفَأَ أَحَبُّ إلَیَّ مِنْ أَنْ أَطَأَ عَلَی قَبْرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 11894","","","كتاب الجنائز"
"11895","(۱۱۸۹۵) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَالِمِ أَبِی عَبْدِ اللہِ الْبَرَّادُ ، قَالَ : سَمِعْتُ ابْنَ مَسْعُودٍ یَقُولُ لأَنْ أَطَأَ عَلَی جَمْرَۃٍ أَحَبُّ إلَیَّ مِنْ أَنْ أَطَأَ عَلَی قَبْر رَجُلٍ مُسْلِمٍ۔","Da'if","Musannaf Ibn Abi Shaybah 11895","","","كتاب الجنائز"
"11896","(۱۱۸۹۶) حدَّثَنَا شَبَابَۃُ ، عَنْ لَیْثِ بْنِ سَعْدٍ ، عَنْ یَزِیدَ ، أَنَّ أَبَا الْخَیْرِ أَخْبَرَہُ ، أَنَّ عُقْبَۃَ بْنَ عَامِرٍ ، قَالَ : لأَنْ أَطَأَ عَلَی جَمْرَۃٍ ، أَوْ عَلَی حَدِّ سَیْفٍ حَتَّی تُخْتَطَفَ رِجْلَیَّ أَحَبُّ إلَیَّ مِنْ أَنْ أَمْشِیَ عَلَی قَبْرِ رَجُلٍ مُسْلِمٍ وَمَا أُبَالِی أَفِی الْقُبُورِ قَضَیْت حَاجَتِی أَمْ فِی السُّوقِ بَیْنَ ظَہْرَانِیہِ وَالنَّاسُ یَنْظُرُونَ۔","Sahih","Musannaf Ibn Abi Shaybah 11896","","","كتاب الجنائز"
"11897","(۱۱۸۹۷) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ أَنَّہُمَا کَانَ یَکْرَہَانِ الْقُعُودَ عَلَیْہَا وَالْمَشْیَ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 11897","","","كتاب الجنائز"
"11898","(۱۱۸۹۸) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی الْعَلاَئِ بْنِ الشِّخِّیرِ ، قَالَ : فُلاَن ، تَمْشُونَ عَلَی قُبُورِکُمْ ؟ قُلْتُ : نَعَمْ ، قَالَ : کَیْفَ تُمْطَرُونَ۔","","Musannaf Ibn Abi Shaybah 11898","","","كتاب الجنائز"
"11899","(۱۱۸۹۹) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی یَحْیَی ، عَنْ أَبِیہِ ، قَالَ : کُنْتُ أَتْبَعُ أَبَا ہُرَیْرَۃَ فِی الْجَنَائِزِ ، فَکَانَ یَتقَصَّی الْقُبُورَ ، قَالَ : لأَنْ یَجْلِسَ أَحَدُکُمْ عَلَی جَمْرَۃٍ فَتُحْرِقَ ثِیَابَہُ ، ثُمَّ قَمِیصَہُ ، ثُمَّ إزَارَہُ حَتَّی تَخْلُصَ إلَی جِلْدِہِ أَحَبُّ إلَیَّ مِنْ أَنْ یَجْلِسَ عَلَی قَبْرٍ۔ (مسلم ۹۶۔ ابوداؤد ۳۲۲۰)","Hasan","Musannaf Ibn Abi Shaybah 11899","","","كتاب الجنائز"
"11900","(۱۱۹۰۰) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، أَنَّہُ کَانَ یَکْرَہُ الْقُعُودَ عَلَی الْقُبُورِ أَوْ یُمْشی عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 11900","","","كتاب الجنائز"
"11901","(۱۱۹۰۱) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُقْعَدَ عَلَیْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 11901","","","كتاب الجنائز"
"11902","(۱۱۹۰۲) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ فُضَیْلٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ یُحْدَثُ وَسَطَ مَقْبَرَۃٍ ، وَلاَ یَبُولُ فِیہَا۔","","Musannaf Ibn Abi Shaybah 11902","","","كتاب الجنائز"
"11903","(۱۱۹۰۳) حدَّثَنَا شَبَابَۃُ ، عَنْ لَیْثِ بْنِ سَعْدٍ ، عَنْ یَزِیدَ ، أَنَّ أَبَا الْخَیْرِ أَخْبَرَہُ ، أَنَّ عُقْبَۃَ بْنَ عَامِرٍ ، قَالَ : مَا أُبَالِی فِی الْقُبُورِ قَضَیْت حَاجَتِی ، أَوْ فِی السُّوقِ وَالنَّاسُ یَنْظُرُونَ۔","Sahih","Musannaf Ibn Abi Shaybah 11903","","","كتاب الجنائز"
"11904","(۱۱۹۰۴) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ زَاذَانَ ، قَالَ : کَانَ عَلِیٌّ إذَا دَخَلَ الْمَقَابِرَ ، قَالَ : السَّلاَمُ عَلَی مَنْ فِی ہَذِہِ الدِّیَارِ مِنَ الْمُؤْمِنِینَ وَالْمُسْلِمِینَ أَنْتُمْ لَنَا فَرَطٌ وَنَحْنُ لَکُمْ تَبَعٌ ، وَإِنَّا بِکُمْ لَلاَحِقُونَ ، فَإِنَّا لِلَّہِ وَإِنَّا إلَیْہِ رَاجِعُونَ۔","","Musannaf Ibn Abi Shaybah 11904","","","كتاب الجنائز"
"11905","(۱۱۹۰۵) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَجْلَحِ ، عَنْ عَبْدِ اللہِ بْنِ شَرِیکٍ ، عَنْ جُنْدُبٍ الأَزْدِیِّ ، قَالَ خَرَجْنَا مَعَ سَلْمَانَ إلَی الحیرۃ حَتَّی إذَا انْتَہَیْنَا إلَی الْقُبُورِ الْتَفَتَ عَنْ یَمِینِہِ ، فَقَالَ : السَّلاَمُ عَلَیْکُمْ یَا أَہْلَ الدِّیَارِ مِنَ الْمُؤْمِنِینَ وَالْمُؤْمِنَاتِ ، أَنْتُمْ لَنَا فَرَطٌ وَنَحْنُ لَکُمْ تَبَعٌ ، وَإِنَّا عَلَی آثَارِکُمْ وَارِدُونَ۔","Hasan","Musannaf Ibn Abi Shaybah 11905","","","كتاب الجنائز"
"11906","(۱۱۹۰۶) حدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ خَیْثَمَۃَ وَالْمُسَیَّبِ ، وَعَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ أَنَّہُمْ کَانُوا یُسَلِّمُونَ عَلَی الْقُبُورِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11906","","","كتاب الجنائز"
"11907","(۱۱۹۰۷) حدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : لاَ أَعْلَمُ بَأْسًا أَنْ یَأْتِیَ الرَّجُلُ الْقَبْرَ فَیُسَلِّمُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 11907","","","كتاب الجنائز"
"11908","(۱۱۹۰۸) حدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ زُہَیْرٍ ، عَنْ مُوسَی بْنِ عُقْبَۃَ ، أَنَّہُ رَأَی سَالِمَ بْنِ عَبْدِ اللہِ لاَ یَمُرُّ بِلَیْلٍ ، وَلاَ نَہَارٍ بِقَبْرٍ إِلاَّ سَلَّمَ عَلَیْہِ وَنَحْنُ مُسَافِرُونَ مَعَہُ یَقُولُ السَّلاَمُ عَلَیْکُمْ فَقُلْت لَہُ فِی ذَلِکَ فَأَخْبَرَنِیہِ ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ یَصْنَعُ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 11908","","","كتاب الجنائز"
"11909","(۱۱۹۰۹) حدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، حدَّثَنَا سُفْیَانُ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنْ سُلَیْمَانَ بْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُعَلِّمُہُمْ إذَا خَرَجُوا إلَی الْمَقَابِرِ ، فَکَانَ قَائِلُہُمْ یَقُولُ : السَّلاَمُ عَلَیْکُمْ یَا أَہْلَ الدِّیَارِ مِنَ الْمُؤْمِنِینَ وَالْمُسْلِمِینَ ، وَإِنَّا إِنْ شَائَ اللَّہُ بِکُمْ لَلاَحِقُونَ ، أَنْتُمْ لَنَا فَرَطٌ ، وَنَحْنُ لَکُمْ تَبَعٌ ، وَنَسْأَلُ اللَّہَ لَنَا وَلَکُمُ الْعَافِیَۃَ۔ (ابوداؤد ۳۲۳۰۔ احمد ۳۵۳)","Sahih","Musannaf Ibn Abi Shaybah 11909","","","كتاب الجنائز"
"11910","(۱۱۹۱۰) حدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ قُرَّۃَ ، عَنْ عَامِرِ بْنِ سَعْدٍ ، عَنْ أبِیہِ ، أَنَّہُ کَانَ یَرْجِعُ مِنْ ضَیْعَتِہِ فَیَمُرُّ بِقُبُورِ الشُّہَدَائِ فَیَقُولُ : السَّلاَمُ عَلَیْکُمْ وَإِنَّا بِکُمْ لَلاَحِقُونَ ، ثُمَّ یَقُولُ لأَصْحَابِہِ : أَلاَ تُسَلِّمُونَ عَلَی الشُّہَدَائِ فَیَرُدُّونَ عَلَیْکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 11910","","","كتاب الجنائز"
"11911","(۱۱۹۱۱) حدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ الْحَسَنِ الْجَارِی ، عَنْ عَبْدِ اللہِ بْنِ سَعْدٍ الْجَارِی ، قَالَ : قَالَ لِی أَبُو ہُرَیْرَۃَ یَا عَبْدَ اللہِ إذَا مَرَرْت بِالْقُبُورِ قَدْ کُنْت تَعْرِفُہُمْ فَقُلْ : السَّلاَمُ عَلَیْکُمْ أَصْحَابَ الْقُبُورِ ، وَإِذَا مَرَرْت بِالْقُبُورِ لاَ تَعْرِفُہُمْ فَقُلْ : السَّلاَمُ عَلَی الْمُسْلِمِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 11911","","","كتاب الجنائز"
"11912","(۱۱۹۱۲) حدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ حدَّثَنَا الْحَکَمُ بْنُ فَصِیل ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ عُبَیْدِ بْنِ جُبَیْرٍ ، عَنْ أَبِی مُوَیْہِبَۃَ مَوْلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أُمِرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یَخْرُجَ إلَی الْبَقِیعِ فَیُصَلِّیَ عَلَیْہِمْ ، أَوْ یُسَلِّمَ عَلَیْہِمْ۔ (احمد ۳/۴۸۹۔ دارمی ۷۸)","Hasan","Musannaf Ibn Abi Shaybah 11912","","","كتاب الجنائز"
"11913","(۱۱۹۱۳) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، أَنَّہُ سُئِلَ عَنِ التَّسْلِیمِ عَلَی الْقُبُورِ ، فَقَالَ : مَا کَانَ مِنْ صَنِیعِہِمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 11913","","","كتاب الجنائز"
"11914","(۱۱۹۱۴) حدَّثَنَا خَالِدُ بْنُ الْحَارِثِ ، قَالَ : سُئِلَ ہِشَامُ أَکَانَ عُرْوَۃُ یَأْتِی قَبْرَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَیُسَلِّمُ عَلَیْہِ ؟ قَالَ : لاَ۔","No Data Available","Musannaf Ibn Abi Shaybah 11914","","","كتاب الجنائز"
"11915","(۱۱۹۱۵) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ إذَا أَرَادَ أَنْ یَخْرُجَ دَخَلَ الْمَسْجِدَ فَصَلَّی ، ثُمَّ أَتَی قَبْرَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : السَّلاَمُ عَلَیْکَ یَا رَسُولَ اللہِ السَّلاَمُ عَلَیْکَ یَا أَبَا بَکْرٍ السَّلاَمُ عَلَیْک یَا أَبَتَاہُ ، ثُمَّ یکون وَجْہَہُ وَکَانَ إذَا قَدِمَ مِنْ سَفَرٍ أَتَی المسجد فَفَعَلَ ذَلِکَ قَبْلَ أَنْ یَدْخُلَ مَنْزِلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 11915","","","كتاب الجنائز"
"11916","(۱۱۹۱۶) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ ثُمَامَۃَ بْنِ شُفَیٍّ ، قَالَ : خَرَجْنَا غُزَاۃً فِی زَمَانِ مُعَاوِیَۃَ إلَی ہَذَا الدَّرْبِ وَعَلَیْنَا فَضَالَۃُ بْنُ عُبَیْدٍ ، قَالَ فَتُوُفِّیَ ابْنُ عَمٍّ لِی یُقَالُ لَہُ نَافِعٌ فَقَامَ مَعَنَا فَضَالَۃُ عَلَی حُفْرَتِہِ ، فَلَمَّا دَفَنَّاہُ ، قَالَ : خَفِّفُوا عَنْ حُفْرَتِہِ فَإِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَأْمُرُ بِتَسْوِیَۃِ الْقُبُورِ۔n(احمد ۶/۱۸۔ بیہقی ۴۱۱)","Hasan","Musannaf Ibn Abi Shaybah 11916","","","كتاب الجنائز"
"11917","(۱۱۹۱۷) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، أَخْبَرَنَا سُلَیْمَانُ بْنُ کَثِیرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عَبْدِ اللہِ بْنِ شُرَحْبِیلَ ، أَنَّ عُثْمَانَ خَرَجَ فَأَمَرَ بِتَسْوِیَۃِ الْقُبُورِ فَسُوِّیَتْ إِلاَّ قَبْرَ أُمِّ عَمْرٍو ، ابْنَۃ عُثْمَانَ ، فَقَالَ : مَا ہَذَا الْقَبْرُ فَقَالُوا : قَبْرُ أُمِّ عَمْرٍو فَأَمَرَ بِہِ فَسُوِّیَ۔","Da'if","Musannaf Ibn Abi Shaybah 11917","","","كتاب الجنائز"
"11918","(۱۱۹۱۸) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ، عَنْ أَشْعَثَ، عَنِ ابْنِ أَشْوَعَ، عَنْ حَنَشٍ الْکِنَانِیِّ، قَالَ: دَخَلَ عَلَی عَلِیٍّ صَاحِبَ شُرَطِہِ ، فَقَالَ : انْطَلِقْ فَلاَ تَدَعْ زُخْرُفًا إِلاَّ أَلْقَیْتَہُ ، وَلاَ قَبْرًا إِلاَّ سَوَّیْتَہُ ، ثُمَّ دَعَاہُ ، فَقَالَ : ہَلْ تَدْرِی إلَی أَیْنَ بَعَثْتُک بَعَثْتُک إلَی مَا بَعَثَنِی عَلَیْہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (ابوداؤد ۳۲۱۰۔ احمد ۱/۱۴۵)","Da'if","Musannaf Ibn Abi Shaybah 11918","","","كتاب الجنائز"
"11919","(۱۱۹۱۹) حدَّثَنَا شَرِیکٌ ، عَنْ أَبِی فَزَارَۃَ ، عَنْ مَوْلًی لاِبْنِ عَبَّاسٍ ، قَالَ : قَالَ لِی ابْنُ عَبَّاسٍ إذَا رَأَیْت الْقَوْمَ قَدْ دَفَنُوا مَیِّتًا فَأَحْدَثُوا فِی قَبْرِہِ مَا لَیْسَ فِی قُبُورِ الْمُسْلِمِینَ فَسَوِّہِ بِقُبُورِ الْمُسْلِمِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 11919","","","كتاب الجنائز"
"11920","(۱۱۹۲۰) حدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : تَسْوِیَۃُ الْقُبُورِ مِنَ السُّنَّۃِ۔","","Musannaf Ibn Abi Shaybah 11920","","","كتاب الجنائز"
"11921","(۱۱۹۲۱) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 11921","","","كتاب الجنائز"
"11922","(۱۱۹۲۲) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَنْصُورِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : قَالَ رَجُلٌ لِلشَّعْبِیِّ رَجُلٌ دَفَنَ مَیِّتًا فَسُوِّیَ قَبْرُہُ بِالأَرْضِ ، فَقَالَ : أَتَیْتُ عَلَی قُبُورِ شُہَدَائِ أُحُدٍ فَإِذَا ہِیَ مُشَخَّصَۃٌ مِنَ الأَرْضِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11922","","","كتاب الجنائز"
"11923","(۱۱۹۲۳) حدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سُئِلَ مُحَمَّدُ بْنُ سِیرِینَ ہَلْ تُطَیَّنُ الْقُبُورُ ؟ فَقَالَ : لاَ أَعْلَمُ بِہِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 11923","","","كتاب الجنائز"
"11924","(۱۱۹۲۴) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَکْرَہُ تَطْیِینَ الْقُبُورِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11924","","","كتاب الجنائز"
"11925","(۱۱۹۲۵) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 11925","","","كتاب الجنائز"
"11926","(۱۱۹۲۶) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَبِی سِنَانٍ ، عَنْ مُحَارِبِ بْنِ دِثَارٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کُنْت نَہَیْتُکُمْ عَنْ زِیَارَۃِ الْقُبُورِ فَزُورُوہَا۔ (ابوداؤد ۳۲۲۷)","Sahih","Musannaf Ibn Abi Shaybah 11926","","","كتاب الجنائز"
"11927","(۱۱۹۲۷) حدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ الْحَارِثِ ، عَنْ عَمْرِو بْنِ عَامِرٍ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ زِیَارَۃِ الْقُبُورِ ، ثُمَّ قَالَ : زُورُوہَا ، وَلاَ تَقُولُوا ہُجْرًا۔n(احمد ۳/۲۵۰۔ حاکم ۳۷۶)","Da'if","Musannaf Ibn Abi Shaybah 11927","","","كتاب الجنائز"
"11928","(۱۱۹۲۸) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ رَبِیعَۃَ بْنِ النَّابغَۃِ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ زِیَارَۃِ الْقُبُورِ ، ثُمَّ قَالَ : إنِّی کُنْت نَہَیْتُکُمْ عَنْ زِیَارَۃِ الْقُبُورِ فَزُورُوہَا تُذَکِّرْکُمُ الآخِرَۃَ۔ (احمد ۱/۱۴۵۔ ابویعلی ۲۷۸)","Da'if","Musannaf Ibn Abi Shaybah 11928","","","كتاب الجنائز"
"11929","(۱۱۹۲۹) حدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ کَیْسَانَ ، عَنْ أَبِی حَازِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : زَارَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَبْرَ أُمِّہِ فَبَکَی ، وَأَبْکَی مَنْ کَانَ حَوْلَہُ ، فَقَالَ : اسْتَأْذَنْت رَبِّی فِی أَنْ أَسْتَغْفِرَ لَہَا فَلَمْ یَأْذَنْ لِی وَاسْتَأْذَنْتُہُ فِی أَنْ أَزُورَ قَبْرَہَا فَأَذِنَ لِی فَزُورُوا الْقُبُورَ فَإِنَّہَا تُذَکِّرُکُمُ الْمَوْتَ۔n(مسلم ۱۰۸۔ احمد ۲/۴۴۱)","Hasan","Musannaf Ibn Abi Shaybah 11929","","","كتاب الجنائز"
"11930","(۱۱۹۳۰) حدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ سُفْیَانَ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنْ سُلَیْمَانَ بْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : لَمَّا فَتَحَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَکَّۃَ أَتَی جِزْم قَبْرٍ فَجَلَسَ إلَیْہِ فَجَعَلَ کَہَیْئَۃِ الْمُخَاطِبِ ، وَجَلَسَ النَّاسُ حَوْلَہُ فَقَامَ وَہُوَ یَبْکِی فَتَلَقَّاہُ عُمَرُ وَکَانَ مِنْ أَجْرَأِ النَّاسِ عَلَیْہِ ، فَقَالَ : بِأَبِی أَنْتَ وَأُمِّی یَا رَسُولَ اللہِ مَا الَّذِی أَبْکَاک ، قَالَ : ہَذَا قَبْرُ أُمِّی سَأَلْت رَبِّی الزِّیَارَۃَ فَأَذِنَ لِی وَسَأَلْتُہُ الاِسْتِغْفَارَ فَلَمْ یَأْذَنْ لِی فَذَکَرْتہَا فَرَقَّتْ نَفْسِی فَبَکَیْت ، قَالَ فَلَمْ یُرَ وَمَا کَانَ أَکْثَرَ بَاکِیًا مِنْہُ یَوْمَئِذٍ۔ (احمد ۳۵۵۔ ابن حبان ۵۳۹۰)","Sahih","Musannaf Ibn Abi Shaybah 11930","","","كتاب الجنائز"
"11931","(۱۱۹۳۱) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، حدَّثَنَا فَرْقَدٌ السَّبَخِیُّ ، حدَّثَنَا جَابِرُ بْنُ یزید ، حدَّثَنَا مَسْرُوقٌ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنِّی نَہَیْتُکُمْ عَنْ زِیَارَۃِ الْقُبُورِ ، وَإِنَّہُ قَدْ أُذِنَ لِمُحَمَّدٍ فِی زِیَارَۃِ قَبْرِ أُمِّہِ ، فَزُورُوہَا تُذَکِّرْکُمُ۔ (دارقطنی ۶۹۔ عبدالرزاق ۶۷۱۴)","Da'if","Musannaf Ibn Abi Shaybah 11931","","","كتاب الجنائز"
"11932","(۱۱۹۳۲) حدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنْ نَافِعٍ ، قَالَ تُوُفِّیَ عَاصِمُ بْنُ عُمَرَ ، وَابْنُ عُمَرَ غَائِبٌ ، فَلَمَّا قَدِمَ ، قَالَ دُلُّونِی عَلَی قَبْرِہِ فَوَقَفَ عَلَیْہِ سَاعَۃً یَدْعُو۔","Hasan","Musannaf Ibn Abi Shaybah 11932","","","كتاب الجنائز"
"11933","(۱۱۹۳۳) حدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی مُلَیْکَۃَ ، قَالَ تُوُفِّیَ عَبْدُ الرَّحْمَنِ بْنِ أَبِی بَکْرٍ بِالْحُبْشِیِّ ، قَالَ ابْنُ جُرَیْجٍ الْحُبْشِیُّ اثْنَیْ عَشَرَ مِیلاً مِنْ مَکَّۃَ فَدُفِنَ بِمَکَّۃَ ، فَلَمَّا قَدِمَتْ عَائِشَۃُ أَتَتْ قَبْرَہُ ، فَقَالَتْ :nوَکُنَّا کَنَدْمَانَیْ جَذِیمَۃَ حِقْبَۃً مِنَ الدَّہْرِ حَتَّی قِیلَ لَنْ یَتَصَدَّعَاnفَلَمَّا تَفَرَّقْنَا کَأَنِّی وَمَالِکًا لِطُولِ اجْتِمَاعٍ لَمْ نَبِتْ لَیْلَۃً مَعًاn ثُمَّ قَالَتْ : أَمَّا وَاللَّہِ لَوْ حَضَرْتُک لَدَفَنْتُک حَیْثُ مِتَّ وَلَوْ شَہِدْتُک مَا زُرْتُک۔","","Musannaf Ibn Abi Shaybah 11933","","","كتاب الجنائز"
"11934","(۱۱۹۳۴) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ إذَا قَدِمَ وَقَدْ مَاتَ بَعْضُ وَلَدِہِ ، فَقَالَ : دُلُّونِی عَلَی قَبْرِہِ فَیَدُلُّونَہُ عَلَیْہِ فَیَنْطَلِقُ فَیَقُومُ عَلَیْہِ وَیَدْعُو لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 11934","","","كتاب الجنائز"
"11935","(۱۱۹۳۵) حدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَنْ أَبِی فَرْوَۃَ الْہَمْدَانِیِّ ، عَنِ الْمُغِیرَۃِ بْنِ سُبَیْعٍ ، عَنِ ابن بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : جَالَسْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْمَجْلِسِ فَرَأَیْتُہُ حَزِینًا ، فَقَالَ لَہُ رَجُلٌ مِنَ الْقَوْمِ : مَا لَکَ یَا رَسُولَ اللہِ کَأَنَّک حَزِینٌ ؟ قَالَ : ذَکَرْتُ أُمِّی ، ثُمَّ قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کُنْت نَہَیْتُکُمْ عَنْ لُحُومِ الأَضَاحِیِّ أَنْ تَأْکُلُوہَا إِلاَّ ثَلاَثَۃَ أَیَّامٍ فَکُلُوا وَأَطْعِمُوا وَادَّخِرُوا مَا بَدَا لَکُمْ ، وَنَہَیْتُکُمْ عَنْ زِیَارَۃِ الْقُبُورِ فَمَنْ أَرَاْدَ أَنْ یَزُورَ قَبْرَ أُمِّہِ فَلْیَزُرْہُ ، وَکُنْت نَہَیْتُکُمْ عَنِ الدُّبَّائِ وَالْحَنْتَمِ وَالْمُزَفَّتِ وَالنَّقِیرِ ، فَاجْتَنِبُوا کُلَّ مُسْکِرٍ ، وَانْبِذُوا فِیمَا بَدَا لَکُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 11935","","","كتاب الجنائز"
"11936","(۱۱۹۳۶) حدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ شُعْبَۃَ ، عَنْ مُحَمَّدِ بْنِ جُحَادَۃَ ، قَالَ : سَمِعْتُ أَبَا صَالِحٍ یُحَدِّثُ بَعْدَ مَا کَبِرَ عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَعَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ زَائِرَاتِ الْقُبُورِ وَالْمُتَّخِذَاتِ عَلَیْہَا الْمَسَاجِدَ وَالسُّرُجَ۔","Da'if","Musannaf Ibn Abi Shaybah 11936","","","كتاب الجنائز"
"11937","(۱۱۹۳۷) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، أَنَّ أُمَّ سَلَمَۃَ ذَکَرَتْ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَنِیسَۃً رَأَتْہَا فِی أَرْضِ الْحَبَشَۃِ یُقَالُ لَہَا مَارِیَۃَ ، فَذَکَرَتْ لَہُ مَا رَأَتْ فِیہَا مِنَ الصُّوَرِ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أُولَئِکَ قَوْمٌ إذَا مَاتَ فِیہِمَ الْعَبْدُ الصَّالِحُ ، أَوِ الرَّجُلُ الصَّالِحُ ، بَنَوْا عَلَی قَبْرِہِ مَسْجِدًا، وَصَوَّرُوا فِیہِ تِلْکَ الصُّوَرَ، فَأُولَئِکَ شِرَارُ الْخَلْقِ عِنْدَ اللہِ عَزَّ وَجَلَّ۔ (بخاری ۴۳۴۔ مسلم ۳۷۵)","Sahih","Musannaf Ibn Abi Shaybah 11937","","","كتاب الجنائز"
"11938","(۱۱۹۳۸) حدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَنْ شَقِیقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إنَّ مِنْ شِرَارِ النَّاسِ مَنْ تُدْرِکُہُمُ السَّاعَۃُ وَہُمْ أَحْیَائٌ وَمَنْ یَتَّخِذُ الْقُبُورَ مَسَاجِدَ۔ (ابن خزیمۃ ۷۸۹۔ احمد ۱/۴۰۵)","Da'if","Musannaf Ibn Abi Shaybah 11938","","","كتاب الجنائز"
"11939","(۱۱۹۳۹) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عِمْرَانَ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ کَرِہَ أَنْ یُزَارَ الْقَبْرُ وَیُصَلَّی عِنْدَہُ۔","","Musannaf Ibn Abi Shaybah 11939","","","كتاب الجنائز"
"11940","(۱۱۹۴۰) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ، عَنِ ابْنِ عَجْلاَنَ، عَنْ سُہَیْلٍ، عَنْ حَسَنِ بْنِ حَسَنٍ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لاَ تَتَّخِذُوا قَبْرِی عِیدًا، وَلاَ بُیُوتَکُمْ قُبُورًا وَصَلُّوا عَلَیَّ حَیْثُمَا کُنْتُمْ فَإِنَّ صَلاَتَکُمْ تَبْلُغُنِی۔","Hasan","Musannaf Ibn Abi Shaybah 11940","","","كتاب الجنائز"
"11941","(۱۱۹۴۱) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اللَّہُمَّ لاَ تَجْعَلْ قَبْرِی وَثَنًا یُصَلَّی لَہُ اشْتَدَّ غَضَبُ اللہِ عَلَی قَوْمٍ اتَّخَذُوا قُبُورَ أَنْبِیَائِہِمْ مَسَاجِدَ۔","","Musannaf Ibn Abi Shaybah 11941","","","كتاب الجنائز"
"11942","(۱۱۹۴۲) حدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عَائِشَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لَعَنَ اللَّہُ أَقْوَامًا اتَّخَذُوا قُبُورَ أَنْبِیَائِہِمْ مَسَاجِدَ۔","Sahih","Musannaf Ibn Abi Shaybah 11942","","","كتاب الجنائز"
"11943","(۱۱۹۴۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ أَبِی سِنَانٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، قَالَ : قَالَ عُمَرُ : لأَنَّا لاَ نَجِدُ أَضَلَّ مِنْ زَائِرِ الْقَبْرِ۔","","Musannaf Ibn Abi Shaybah 11943","","","كتاب الجنائز"
"11944","(۱۱۹۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ زِیَارَۃَ الْقُبُورِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11944","","","كتاب الجنائز"
"11945","(۱۱۹۴۵) حدَّثَنَا قَبِیصَۃُ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ بَہْمَانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَسَّانَ بْنِ ثَابِتٍ ، عَنْ أَبِیہِ ، قَالَ : لَعَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ زَائِرَاتِ الْقُبُورِ۔ (احمد ۴۴۲)","Da'if","Musannaf Ibn Abi Shaybah 11945","","","كتاب الجنائز"
"11946","(۱۱۹۴۶) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، حدَّثَنَا سُفْیَانُ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَوْلا أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ زِیَارَۃِ الْقُبُورِ لَزُرْت قَبْرَ ابْنَتِی۔","Da'if","Musannaf Ibn Abi Shaybah 11946","","","كتاب الجنائز"
"11947","(۱۱۹۴۷) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی یُونُسَ الْبَاہِلِیِّ ، قَالَ : سَمِعْتُ شَیْخًا بِمَکَّۃَ کَانَ أَصْلُہُ رُومِیًّا یُحَدِّثُ عَنْ أَبِی ذَرٍّ ، قَالَ : کَانَ رَجُلٌ یَطُوفُ بِالْبَیْتِ یَقُولُ أَوْہُ أَوْہُ ، قَالَ أَبُو ذَرٍّ : خَرَجْت ذَاتَ لَیْلَۃٍ فَإِذَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْمَقَابِرِ یَدْفِنُ ذَلِکَ الرَّجُلِ وَمَعَہُ مِصْبَاحٌ۔ (ابوداؤد ۳۱۵۶)","Da'if","Musannaf Ibn Abi Shaybah 11947","","","كتاب الجنائز"
"11948","(۱۱۹۴۸) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ حَسَنِ بْنِ مُحَمَّدٍ ، أَنَّ فَاطِمَۃَ دُفِنَتْ لَیْلاً۔","Hasan","Musannaf Ibn Abi Shaybah 11948","","","كتاب الجنائز"
"11949","(۱۱۹۴۹) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، أَنَّ عَلِیًّا دَفَنَ فَاطِمَۃَ لَیْلاً۔","","Musannaf Ibn Abi Shaybah 11949","","","كتاب الجنائز"
"11950","(۱۱۹۵۰) حدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُلَیٍّ ، عَنْ أَبِیہِ ، قَالَ : کُنْتُ عِنْدَ عُقْبَۃَ بْنِ عَامِرٍ فَسُئِلَ عَنِ التَّکْبِیرِ عَلَی الْمَیِّتِ ، فَقَالَ : أَرْبَعٌ قُلْتُ اللَّیْلُ وَالنَّہَارُ سَوَائٌ ، قَالَ : اللَّیْلُ وَالنَّہَارُ سَوَائٌ ، قُلْتُ : یُدْفَنُ الْمَیِّتُ بِاللَّیْلِ ، قَالَ : قُبِرَ أَبُو بَکْرٍ بِاللَّیْلِ۔","Sahih","Musannaf Ibn Abi Shaybah 11950","","","كتاب الجنائز"
"11951","(۱۱۹۵۱) حدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ الْوَلِیدِ بْنِ أَبِی ہِشَامٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، دُفِنَ أَبُو بَکْرٍ بِاللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 11951","","","كتاب الجنائز"
"11952","(۱۱۹۵۲) حدَّثَنَا غُنْدَرٌ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، أَنَّ ابْنَ مَسْعُودٍ دُفِنَ لَیْلاً ، قَالَ: وَکَانَ قَتَادَۃُ یَکْرَہُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 11952","","","كتاب الجنائز"
"11953","(۱۱۹۵۳) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ إسْمَاعِیلَ بْنِ مُحَمَّدٍ ، عَنِ ابْنِ السَّبَّاقِ ، أَنَّ عُمَرَ دَفَنَ أَبَا بَکْرٍ لَیْلاً ، ثُمَّ دَخَلَ الْمَسْجِدَ فَأَوْتَرَ بِثَلاَثٍ۔","","Musannaf Ibn Abi Shaybah 11953","","","كتاب الجنائز"
"11954","(۱۱۹۵۴) حدَّثَنَا ابْنُ أَبِی عَدِیٍّ، عَنْ دَاوُدَ، عَنِ الشَّعْبِیِّ، عَنْ شُرَیْحٍ، أَنَّہُ کَانَ یَدْفِنُ بَعْضَ وَلَدِہِ لَیْلاً کَرَاہِیَۃَ الزِّحَامِ۔","","Musannaf Ibn Abi Shaybah 11954","","","كتاب الجنائز"
"11955","(۱۱۹۵۵) حدَّثَنَا خَالِدٌ الزَّیَّاتُ ، عَنْ زُرْعَۃَ بْنِ عَمْرٍو ، مَوْلًی لآلِ حُبَابٍ ، عَنْ أَبِیہِ ، عَنْ عَمْرٍو قَالَ : دَفَنَّا عُثْمَانَ بْنَ عَفَّانَ بَعْدَ الْعِشَائِ الآخِرَۃِ بِالْبَقِیعِ ، قَالَ وَکُنْت رَابِعَ أَرْبَعَۃٍ فِیمَنْ حَمَلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 11955","","","كتاب الجنائز"
"11956","(۱۱۹۵۶) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ قَالَتْ : مَاتَ أَبُو بَکْرٍ لَیْلَۃَ الثُّلاَثَائِ ، وَدُفِنَ لَیْلَۃَ ثُلاَثَائَ۔","Hasan","Musannaf Ibn Abi Shaybah 11956","","","كتاب الجنائز"
"11957","(۱۱۹۵۷) حدَّثَنَا غُنْدَرٌ ، وَأَبُو دَاوُد ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالدَّفْنِ بِاللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 11957","","","كتاب الجنائز"
"11958","(۱۱۹۵۸) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنِ الأَسْوَد بْنِ شَیْبَانَ ، عَنْ خَالِدِ بْنِ سُمَیْرٍ السَّدُوسِیِّ ، قَالَ : سَأَلْتُ أَنَسًا عَنِ الصَّلاَۃِ عَلَی الْمَیِّتِ بِاللَّیْلِ ، فَقَالَ : مَا الصَّلاَۃُ عَلَی الْمَیِّتِ بِاللَّیْلِ إِلاَّ کَالصَّلاَۃِ عَلَی الْمَیِّتِ بِالنَّہَارِ۔","Sahih","Musannaf Ibn Abi Shaybah 11958","","","كتاب الجنائز"
"11959","(۱۱۹۵۹) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ دُفِنَ إبْرَاہِیمُ لَیْلاً وَنَحْنُ خَائِفُونَ۔","","Musannaf Ibn Abi Shaybah 11959","","","كتاب الجنائز"
"11960","(۱۱۹۶۰) حدَّثَنَا أَبُو دَاوُدَ ، عَنْ أَبِی حَرَّۃَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَدْفِنَ لَیْلاً۔","","Musannaf Ibn Abi Shaybah 11960","","","كتاب الجنائز"
"11961","(۱۱۹۶۱) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ فَاطِمَۃَ بِنْتِ مُحَمَّدٍ ، عَنْ عَمْرَۃَ ، عَنْ عَائِشَۃَ قَالَتْ : مَا عَلِمْنَا بِدَفْنِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی سَمِعْنَا صَوْتَ الْمَسَاحِی مِنْ آخِرِ اللَّیْلِ لَیْلَۃَ الأَرْبِعَائِ ، قَالَ مُحَمَّدٌ وَالْمَسَاحِی المَرور۔ (احمد ۶۲۔ ابن راھویہ ۹۹۳)","Da'if","Musannaf Ibn Abi Shaybah 11961","","","كتاب الجنائز"
"11962","(۱۱۹۶۲) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : قَالَ عَلِیٌّ : لَمَّا مَاتَ أَبُو طَالِبٍ أَتَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقُلْت یَا رَسُولَ اللہِ إنَّ عَمَّک الضَّالَّ قَدْ مَاتَ ، فَقَالَ لِی : اذْہَبْ فَوَارِہِ ، وَلاَ تُحْدِثَنَّ شَیْئًا حَتَّی تَأْتِیَنِی ، قَالَ فَانْطَلَقْتُ فَوَارَیْتُہُ ، ثُمَّ رَجَعْت إلَیْہِ وَعَلَیَّ أَثَرُ التُّرَابِ وَالْغُبَارِ فَدَعَا لِی بِدَعَوَاتٍ مَا یَسُرُّنِی ، أَنَّ لِی بِہَا مَا عَلَی الأَرْضِ مِنْ شَیْئٍ۔","","Musannaf Ibn Abi Shaybah 11962","","","كتاب الجنائز"
"11963","(۱۱۹۶۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ نَاجِیَۃَ ، عَنْ عَلِیٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوِہِ ، وَقَالَ فَأَمَرَنِی بِالْغَسْلِ۔","Hasan","Musannaf Ibn Abi Shaybah 11963","","","كتاب الجنائز"
"11964","(۱۱۹۶۴) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : مَاتَتْ أُمُّ الْحَارِثِ بْنِ أَبِی رَبِیعَۃَ وَہِیَ نَصْرَانِیَّۃٌ ، فَشَہِدَہَا أَصْحَابُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Hasan","Musannaf Ibn Abi Shaybah 11964","","","كتاب الجنائز"
"11965","(۱۱۹۶۵) حدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : مَاتَتْ أُمُّ الْحَارِثِ وَکَانَتْ نَصْرَانِیَّۃً ، فَشَہِدَہَا أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 11965","","","كتاب الجنائز"
"11966","(۱۱۹۶۶) حدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ مُحَمَّدِ بْنِ أَبِی إسْمَاعِیلَ ، عَنْ عَامِرِ بْنِ شَقِیقٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ مَاتَتْ أُمِّی وَہِیَ نَصْرَانِیَّۃٌ فَأَتَیْت عُمَرَ فَذَکَرْت ذَلِکَ لَہُ ، فَقَالَ : ارْکَبْ دَابَّۃً وَسِرْ أَمَامَہَا۔","Hasan","Musannaf Ibn Abi Shaybah 11966","","","كتاب الجنائز"
"11967","(۱۱۹۶۷) حدَّثَنَا جَرِیرٌ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : مَاتَتْ أُمُّ رَجُلٍ مِنْ ثَقِیفٍ وَہِیَ نَصْرَانِیَّۃٌ فَسَألَ ابْنَ معقل ، فَقَالَ : إنِّی أُحِبُّ أَنْ أَحْضُرَہَا ، وَلاَ أَتْبَعُہَا ، قَالَ ارْکَبْ دَابَّۃً وَسِرْ أَمَامَہَا غَلْوَۃً فَإِنَّک إذَا سِرْتَ أَمَامَہَا فَلَسْتَ مَعَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 11967","","","كتاب الجنائز"
"11968","(۱۱۹۶۸) حدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ عَبْدِ اللہِ بْنِ شَرِیکٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ ، سُئِلَ عَنِ الرَّجُلِ الْمُسْلِمِ یَتْبَعُ أُمَّہُ النَّصْرَانِیَّۃَ تَمُوتُ ، قَالَ: یَتْبَعُہَا وَیَمْشِی أَمَامَہَا۔","Hasan","Musannaf Ibn Abi Shaybah 11968","","","كتاب الجنائز"
"11969","(۱۱۹۶۹) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ ضِرَارِ بْنِ مُرَّۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ مَاتَ رَجُلٌ نَصْرَانِیٌّ وَلَہُ ابْنٌ مُسْلِمٍ فَلَمْ یَتْبَعُہُ ، فَقَالَ : ابْنُ عَبَّاسٍ کَانَ یَنْبَغِی لَہُ أَنْ یَتْبَعَہُ وَیَدْفِنَہُ وَیَسْتَغْفِرَ لَہُ فِی حَیَاتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 11969","","","كتاب الجنائز"
"11970","(۱۱۹۷۰) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الأَجْلَحِ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَمَّا مَاتَ أَبُو طَالِبٍ جَائَ عَلِیٌّ إلی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنَّ عَمَّک الشَّیْخَ الْکَافِرَ قَدْ مَاتَ فَمَا تَرَی فِیہِ ، قَالَ : أَرَی أَنْ تَغْسِلَہُ وَتُجِنَّہُ وَأَمَرَہُ بِالْغُسْلِ۔","","Musannaf Ibn Abi Shaybah 11970","","","كتاب الجنائز"
"11971","(۱۱۹۷۱) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ ضِرَارِ بْنِ مُرَّۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : مَاتَ رَجُلٌ نَصْرَانِیٌّ فَوَکَّلَہُ ابْنُہُ إلی أَہْلِ دِینِہِ ، فَذُکِرَ ذَلِکَ لاِبْنِ عَبَّاسٍ ، فَقَالَ : مَا کَانَ عَلَیْہِ لَوْ مَشَی مَعَہُ وَأَجَنَّہ وَاسْتَغْفَرَ لَہُ مَا کَانَ حَیًّا ، ثُمَّ تَلاَ : {وَمَا کَانَ اسْتِغْفَارُ إبْرَاہِیمَ لأَبِیہِ} الآیَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 11971","","","كتاب الجنائز"
"11972","(۱۱۹۷۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ وَاصِلٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا مَاتَ الرَّجُلُ فِی الْبَحْرِ جُعِلَ فِی زِبِّیلٍ، ثُمَّ قُذِفَ بِہِ۔","","Musannaf Ibn Abi Shaybah 11972","","","كتاب الجنائز"
"11973","(۱۱۹۷۳) حدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ؛ فِی الَّذِی یَمُوتُ فِی الْبَحْرِ ، قَالَ یُغَسَّلُ وَیُکَفَّنُ وَیُحَنَّطُ وَیُصَلَّی عَلَیْہِ ، ثُمَّ یُرْبَطُ فِی رِجْلَیْہِ شَیْئٌ ، ثُمَّ یُرْمَی بِہِ فِی الْبَحْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11973","","","كتاب الجنائز"
"11974","(۱۱۹۷۴) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ یَحْیَی بْنِ أَبِی إِسْحَاقَ ، قَالَ : خَرَجْت مَعَ سَالِمِ بْنِ عَبْدِ اللہِ فِی جِنَازَۃٍ فَأَخَذَ غَیْرَ طَرِیقِہَا فَعَارَضَہَا ، فَلَمَّا انْتَہَی إلَی الْقَبْرِ جَلَسَ قَبْلَ أَنْ تُوضَعَ۔","","Musannaf Ibn Abi Shaybah 11974","","","كتاب الجنائز"
"11975","(۱۱۹۷۵) حدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ جَابِرٍ، عَنِ الشَّعْبِیِّ، قَالَ: کَانَ شُرَیْحٌ وَزَیْدُ بْنُ أَرْقَمَ یَأْخُذَانِ غَیْرَ طَرِیقِ الْجِنَازَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 11975","","","كتاب الجنائز"
"11976","(۱۱۹۷۶) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ ہِشَامٍ ، قَالَ أَوْصَی عروۃ أَنْ لاَ یُقْبَرَ فِی الْبَقِیعِ ، وَقَالَ إِنْ کَانَ مُؤْمِنًا فَمَا أُحِبُّ أَنْ أُضَیِّقَ عَلَیْہِ ، وَإِنْ کَانَ فَاجِرًا فَمَا أُحِبُّ أضامَّہ فِیہِ۔","","Musannaf Ibn Abi Shaybah 11976","","","كتاب الجنائز"
"11977","(۱۱۹۷۷) حدَّثَنَا مَالِکُ بْنُ إسْمَاعِیلَ حدَّثَنَا شَرِیکٌ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی عُبَیْدَۃَ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ ، قَالَ : ادْفِنُونِی فِی قَبْرِ عُثْمَانَ بْنِ مَظْعُونٍ۔","","Musannaf Ibn Abi Shaybah 11977","","","كتاب الجنائز"
"11978","(۱۱۹۷۸) حدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ سُفْیَانَ ، عَنْ رَجُلٍ ، أَنَّ خَیْثَمَۃَ أَوْصَی أَنْ یُدْفَنَ فِی مَقْبَرَۃِ فُقَرَائِ قَوْمہ۔","","Musannaf Ibn Abi Shaybah 11978","","","كتاب الجنائز"
"11979","(۱۱۹۷۹) حدَّثَنَا أَبُو أُسَامَۃَ حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ قَیْسٍ ، قَالَ قَالَتْ عَائِشَۃُ لَمَّا حَضَرَتْہَا الْوَفَاۃُ ادْفِنُونِی مَعَ أَزْوَاجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَإِنِّی کُنْت أُحْدِثتُ بَعْدَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 11979","","","كتاب الجنائز"
"11980","(۱۱۹۸۰) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، أَنَّ عُمَرَ ، قَالَ لِعَبْدِ اللہِ بْنِ عُمَرَ اذْہَبْ إلَی عَائِشَۃَ فَسَلِّمْ وَقُلْ یَسْتَأْذِنُ عُمَرُ بْنُ الْخَطَّابِ أَنْ یُدْفَنَ مَعَ صَاحِبَیْہِ فَأَتَاہَا عَبْدُ اللہِ فَوَجَدَہَا قَاعِدَۃً تَبْکِی فَسَلَّمَ ، ثُمَّ قَالَ : یَسْتَأْذِنُ عُمَرُ بْنُ الْخَطَّابِ أَنْ یُدْفَنَ مَعَ صَاحِبَیْہِ ، فَقَالَتْ قَدْ کُنْت وَاللَّہِ أُرِیدُہُ لِنَفْسِی ، وَلاَوثِرَنَّہُ الْیَوْمَ عَلَی نَفْسِی۔","","Musannaf Ibn Abi Shaybah 11980","","","كتاب الجنائز"
"11981","(۱۱۹۸۱) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : سَأَلْتُہُ عَنِ الْمَرْأَۃِ تَمُوتُ فِی نِفَاسِہَا مِنَ الْفُجُورِ أَیُصَلَّی عَلَیْہَا ، فَقَالَ : صَلِّ عَلَی مَنْ قَالَ لاَ إلَہَ إِلاَّ اللَّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 11981","","","كتاب الجنائز"
"11982","(۱۱۹۸۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَمْرِو بْنِ یَحْیَی ، عَنِ أبی النُّعْمَانِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی عَلَی وَلَدِ الزِّنَائِ وَعَلَی أَمَۃٍ مَاتَتْ فِی نِفَاسِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 11982","","","كتاب الجنائز"
"11983","(۱۱۹۸۳) حدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ أَبِی غَالِبٍ ، قَالَ : قُلْتُ لأَبِی أُمَامَۃَ الرَّجُلُ یَشْرَبُ الْخَمْرَ فَیَمُوتُ أَیُصَلَّی عَلَیْہِ ، قَالَ نَعَمْ لَعَلَّہُ اضْطَجَعَ عَلَی فِرَاشِہِ مَرَّۃً ، فَقَالَ : لاَ إلَہَ إِلاَّ اللَّہُ فَغُفِرَ لَہُ بِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 11983","","","كتاب الجنائز"
"11984","(۱۱۹۸۴) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ یُصَلَّی عَلَی الَّذِی قَتَلَ نَفْسَہُ وَعَلَی النُّفَسَائِ مِنَ الزِّنَا وَعَلَی الَّذِی یَمُوتُ عریقًا مِنَ الْخَمْرِ۔","","Musannaf Ibn Abi Shaybah 11984","","","كتاب الجنائز"
"11985","(۱۱۹۸۵) حدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ الزِّبْرِقَانِ السَّرَّاجِ ، قَالَ : صَلَّی أَبُو وَائِلٍ عَلَی امْرَأَۃٍ مَاتَتْ فَقُلْت لَہُ : إِنَّہَا تُرَہَّقُ ، فَقَالَ : أی بُنَیَّ صَلِّ عَلَی مَنْ صَلَّی إلَی الْقِبْلَۃِ۔","","Musannaf Ibn Abi Shaybah 11985","","","كتاب الجنائز"
"11986","(۱۱۹۸۶) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَد ، عَنْ عَطَائٍ ، قَالَ : صَلِّ عَلَی مَنْ صَلَّی إلَی قبلتک۔","","Musannaf Ibn Abi Shaybah 11986","","","كتاب الجنائز"
"11987","(۱۱۹۸۷) حدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : مَا أَعْلَمُ ، أَنَّ أَحَدًا مِنْ أَہْلِ الْعِلْمِ ، وَلاَ التَّابِعِینَ ترَکَ الصَّلاَۃَ عَلَی أَحَدٍ مِنْ أَہْلِ الْقِبْلَۃِ تَأَثُمًا۔","","Musannaf Ibn Abi Shaybah 11987","","","كتاب الجنائز"
"11988","(۱۱۹۸۸) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَاصِمٍ ، قَالَ : قُلْتُ لِلْحَسَنِ إنَّ لِی جَارًا مِنَ الْخَوَارِجِ مَاتَ أَأَشْہَدُ جِنَازَتَہُ ؟ قَالَ أَخَرَجَ عَلَی الْمُسْلِمِینَ ؟ قَالَ : قُلْتُ لاَ قَالَ فَاشْہَدْ جِنَازَتَہُ فَإِنَّ الْعَمَلَ أَمْلَکُ بِہِ مِنَ الرَّأْیِ۔","","Musannaf Ibn Abi Shaybah 11988","","","كتاب الجنائز"
"11989","(۱۱۹۸۹) حدَّثَنَا شَرِیکٌ ، عَنْ سِمَاکٍ ، عَنْ جَابِرِ بْنِ سُمْرَۃَ ، أَنَّ رَجُلاً مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَصَابَتْہُ جِرَاحَۃٌ فَآلَمَتْہُ بِہِ فَدَبَّ إلَی قرْنٍ لَہُ فِی سَیْفِہِ فَأَخَذَ مِشْقَصًا فَقَتَلَ بِہِ نَفْسَہُ فَلَمْ یُصَلِّ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَیْہِ ، وَذَکَرَ شَرِیکٌ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : إنَّمَا أَدَعُ الصَّلاَۃَ عَلَیْہِ أَدَبًا لَہُ۔n(مسلم ۱۰۷۔ ابوداؤد ۳۱۷۷)","Hasan","Musannaf Ibn Abi Shaybah 11989","","","كتاب الجنائز"
"11990","(۱۱۹۹۰) حدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ عِمْرَانَ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ النَّخَعِیّ عَنْ إنْسَانٍ قَتَلَ نَفْسَہُ أَیُصَلَّی عَلَیْہِ ؟ قَالَ : نَعَمْ ، إنَّمَا الصَّلاَۃُ سُنَّـۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 11990","","","كتاب الجنائز"
"11991","(۱۱۹۹۱) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ أصحَابِہ ، عَنْ إبْرَاہِیمَ فِی السَّبِیِّ یُسْبَی مِنْ أَرْضِ الْعَدُو ، وَقَالَ : إذَا أَقَرَّ بِالتَّوْحِیدِ وَبِالشَّہَادَتَیْنِ صُلِّیَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 11991","","","كتاب الجنائز"
"11992","(۱۱۹۹۲) حدَّثَنَا جَرِیرٌ ، عَنِ الْعَلاَئِ ، عَنْ خَیْثَمَۃَ ، قَالَ : إذْ صَلَّی مَرَّۃً صُلِّیَ عَلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 11992","","","كتاب الجنائز"
"11993","(۱۱۹۹۳) حدَّثَنَا جَرِیرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا قَالَ : لاَ إلَہَ إِلاَّ اللَّہُ صُلِّیَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 11993","","","كتاب الجنائز"
"11994","(۱۱۹۹۴) حدَّثَنَا شَرِیکٌ، عَنْ عَبْدِاللہِ بْنِ عِیسَی، عَنْ عَبْدِاللہِ بْنِ جبْر، عَنْ أَنَسِ بْنِ مَالِکٍ، قَالَ: کَانَ شَابٌّ یَہُودِیٌّ یَخْدُمُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَمَرِضَ فَأَتَاہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَعُودُہُ ، فَقَالَ : أَتَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَأَنِّی رَسُولُ اللہِ ، قَالَ : فَجَعَلَ یَنْظُرُ إلَی أَبِیہِ ، فَقَالَ : قُلْ کَمَا یَقُولُ لَکَ مُحَمَّدٌ ، فَقَالَ : ثُمَّ مَاتَ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَلُّوا عَلَی صَاحِبِکُمْ۔(حاکم ۳۶۳۔ بخاری ۵۶۵۲۔ احمد ۳/۲۶۰)","Hasan","Musannaf Ibn Abi Shaybah 11994","","","كتاب الجنائز"
"11995","(۱۱۹۹۵) حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سَہْلٍ السَّرَّاجِ ، قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ سِیرِینَ سُئِلَ عَنْ قَوْمٍ أَقْبَلُوا بِسَبْیٍ فَکَانُوا إِذَا أَمَرُوہُمْ أَنْ یُصَلُّوا صَلُّوا ، وَإِذَا لَمْ یَأْمُرُوہُمْ لَمْ یُصَلُّوا فَمَاتَ رَجُلٌ مِنْہُمْ ، فَقَالَ : تَبَیَّنَ لَکُمْ أَنَّہُ مِنْ أَصْحَابِ الْجَحِیمِ فَقَالُوا : لاَ مَا تَبَیَّنَ لَنَا ، قَالَ : اغْسِلُوہُ وَکَفِّنُوہُ وَحَنِّطُوہُ وَصَلُّوا عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 11995","","","كتاب الجنائز"
"11996","(۱۱۹۹۶) حدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ مُحَمَّدِ بْنِ زِیَادٍ ، عَنْ أَبِی عَبْدِ اللہِ الشقْرِیِّ ، قَالَ : قَالَ رَجُلٌ عِنْدَ الشَّعْبِیِّ إنِّی أَجْلِبُ الرَّقِیقَ فَیَمُوتُ بَعْضُہُمْ أَفَأُصَلِّی عَلَیْہِ ، فَقَالَ : إِنْ صَلَّی فَصَلِّ عَلَیْہِ ، وَإِنْ لَمْ یُصَلِّ فَلاَ تُصَلِّ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 11996","","","كتاب الجنائز"
"11997","(۱۱۹۹۷) حدَّثَنَا حَمَّادُ بْنُ أبی خَالِدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إذَا تَشَہَّدَ الْکَافِرُ وَہُوَ فِی السَّوقِ صُلِّیَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 11997","","","كتاب الجنائز"
"11998","(۱۱۹۹۸) حدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَصْبَہَانِی ، قَالَ : أَتَانِی أَبُو صَالِحٍ یُعَزِّینِی ، عَنِ ابْنٍ لِی ، فَأَخَذَ یُحَدِّثُ عَنْ أَبِی سَعِیدٍ ، وَأَبِی ہُرَیْرَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قُلْنَ لَہُ النِّسَائُ اجْعَلْ لَنَا یَوْمًا کَمَا جَعَلْتہ لِلرِّجَالِ ، قَالَ : فَجَائَ إلَی النِّسَائِ فَوَعَظَہُنَّ وَعَلَّمَہُنَّ وَأَمَرَہُنَّ ، وَقَالَ لَہُنَّ : مَا مِنِ امْرَأَۃٍ تَدْفِنُ ثَلاَثَۃَ فَرَطٍ إِلاَّ کَانُوا لَہَا حِجَابًا مِنَ النَّارِ ، قَالَ : فَقَالَتِ امْرَأَۃٌ : یَا رَسُول اللہ قَدَّمْتُ اثْنَیْنِ قَالَ : ثَلاَثَۃً ، ثم قَالَ : وَاثْنَیْنِ وَاثْنَیْنِ ، قَالَ أَبُو ہُرَیْرَۃَ : مَنْ لَمْ یَبْلُغِ الْحِنْثَ۔ (بخاری ۱۰۲۔ مسلم ۱۵۳)","Hasan","Musannaf Ibn Abi Shaybah 11998","","","كتاب الجنائز"
"11999","(۱۱۹۹۹) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ یَرْفَعُہُ ، قَالَ : مَنْ قدَّمَ ثَلاَثَۃً مِنْ وَلَدِہِ لَنْ یَلِجَ النَّارَ إِلاَّ تَحِلَّۃَ الْقَسَمِ۔ (بخاری ۱۲۵۱۔ مسلم ۲۰۲۸)","Sahih","Musannaf Ibn Abi Shaybah 11999","","","كتاب الجنائز"
"12000","(۱۲۰۰۰) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ طَلْقِ بْنِ مُعَاوِیَۃَ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أَتَتِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ امْرَأَۃٌ بِصَبِیٍّ ، فَقَالَتْ : یَا رَسُولَ اللہِ ، ادْعُ اللَّہَ لَہُ فَلَقَدْ دَفَنْتُ ثَلاَثَۃً ، قَالَ : دَفَنْتِ ثَلاَثَۃً ؟ قَالَتْ : نَعَمْ ، قَالَ : لَقَدِ احْتَظَرْت بِحِظَارٍ شَدِیدٍ مِنَ النَّارِ۔ (بخاری ۱۴۷۔ مسلم ۱۵۶)","Sahih","Musannaf Ibn Abi Shaybah 12000","","","كتاب الجنائز"
"12001","(۱۲۰۰۱) حدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، حدَّثَنَا عَبْدُ اللہِ بْنُ قَیْسٍ ، قَالَ : کُنْتُ عِنْدَ أَبِی بُرْدَۃَ ذَاتَ لَیْلَۃٍ فَدَخَلَ عَلَیْنَا الْحَارِثُ بْنُ أُقَیْشٍ فَحدَّثَنَا الْحَارِثُ لَیْلَتئذٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: مَا مِنَ مُسْلِمَیْنِ یَمُوتُ لَہُمَا أَرْبَعَۃُ أَفْرَاطٍ إِلاَّ أَدْخَلَہُمَا اللَّہُ الْجَنَّۃَ ، قَالُوا: یَا رَسُولَ اللہِ وَثَلاَثَۃٌ، قَالَ : وَثَلاَثَۃٌ قَالُوا : یَا رَسُولَ اللہِ وَاثْنَانِ ، قَالَ : وَاثْنَانِ۔ (ابن ماجہ ۴۳۲۳۔ احمد ۴/۲۱۲)","Da'if","Musannaf Ibn Abi Shaybah 12001","","","كتاب الجنائز"
"12002","(۱۲۰۰۲) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ قَیْسٍ ، عَنْ أَبِی رَمْلَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ مُسْلِمٍ ، عَنْ مُعَاذِ بْنِ جَبَلٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، أَنَّہُ قَالَ: أَوْجَبَ ذُو الثَّلاَثَۃِ قَالُوا: وَذُو الاِثْنَیْنِ یَا رَسُولَ اللہِ ، قَالَ: وَذُو الاِثْنَیْنِ۔ (ابن ماجہ ۱۶۰۹۔ احمد ۵/۲۳۷)","Da'if","Musannaf Ibn Abi Shaybah 12002","","","كتاب الجنائز"
"12003","(۱۲۰۰۳) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، حدَّثَنَا الْقَاسِمُ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَا مِنْ مُؤْمِنَیْنِ یَمُوتُ لَہُمَا ثَلاَثَۃٌ مِنَ الأَوْلاَدِ لَمْ یَبْلُغُوا الْحِنْثَ إِلاَّ أَدْخَلَہُمَا اللَّہُ الْجَنَّۃَ بِفَضْلِ رَحْمَتِہِ إیَّاہُمْ۔ (احمد ۴/۳۸۶)","Da'if","Musannaf Ibn Abi Shaybah 12003","","","كتاب الجنائز"
"12004","(۱۲۰۰۴) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، حدَّثَنَا عُثْمَانَ بْنُ حَکِیمٍ ، عَنْ عَمْرِو الأَنْصَارِیِّ ، عَنْ أُمِّ سُلَیْمٍ ابنۃ مِلْحَانَ وَہِیَ أُمُّ أَنَسٍ ، أَنَّہَا سَمِعْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُول : مَا مِنْ مُسْلِمَیْنِ یَمُوتُ لَہُمَا ثَلاَثَۃٌ مِنْ أَوْلاَدٍ لَمْ یَبْلُغُوا الْحِنْثَ إِلاَّ أَدْخَلَہُمَا اللَّہُ الْجَنَّۃَ بِفَضْلِ رَحْمَتِہِ۔ (احمد ۶/۳۷۶۔ طبرانی ۳۰۶)","Da'if","Musannaf Ibn Abi Shaybah 12004","","","كتاب الجنائز"
"12005","(۱۲۰۰۵) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ مُوسَی الْجُہَنِیِّ ، عَنْ مُجَاہِدٍ ، عَنْ عَائِشَۃَ قَالَتْ : مَنْ قَدَّمَ ثَلاَثَۃً مِنْ وَلَدِہِ صَابِرًا مُحْتَسِبًا حَجَبُوہُ بِإِذْنِ اللہِ مِنَ النَّارِ۔","Sahih","Musannaf Ibn Abi Shaybah 12005","","","كتاب الجنائز"
"12006","(۱۲۰۰۶) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، أَخْبَرَنَا ہِشَامُ بْنُ حَسَّانَ ، عَنِ الْحَسَنِ ، قَالَ : حدَّثَنِی صَعْصَعَۃُ بْنُ مُعَاوِیَۃَ ، قَالَ : لَقِیت أَبَا ذَرٍّ فَقُلْت : حَدِّثْنِی حَدِیثًا سَمِعْتَہُ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَا مِنْ مُسْلِمَیْنِ یَمُوتُ لَہُمَا ثَلاَثَۃٌ مِنْ أَوْلاَدِہِمَا لَمْ یَبْلُغُوا حِنْثًا إِلاَّ أَدْخَلَہُمَا اللَّہُ الْجَنَّۃَ بِفَضْلِ رَحْمَتِہِ۔ (نسائی ۲۰۰۲۔ احمد ۵/۱۵۱)","Sahih","Musannaf Ibn Abi Shaybah 12006","","","كتاب الجنائز"
"12007","(۱۲۰۰۷) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، أَخْبَرَنَا الْعَوَّامُ بْنُ حَوْشَبٍ ، قَالَ : حدَّثَنِی أَبُو مُحَمَّدٍ مَوْلَی عُمَرُ بْنُ الْخَطَّابِ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَیُّمَا مُسْلِمَیْنِ مَضَی لَہُمَا مِنْ أَوْلاَدِہِمَا ثَلاَثَۃٌ لَمْ یَبْلُغُوا حِنْثًا إِلاَّ أَدْخَلَہُمَا اللَّہُ الْجَنَّۃَ ، فَقَالَ أَبُو ذَرٍّ مَضَی لِی اثْنَانِ یَا رَسُولَ اللہِ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : وَاثْنَانِ ، فَقَالَ أَبُو الْمُنْذِرِ سَیِّدُ الْقُرَّائِ مَضَی لِی وَاحِدٌ یَا رَسُولَ اللہِ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ووَاحِدٌ وَذَلِکَ فِی الصَّدْمَۃِ الأُولَی۔(ترمذی ۱۰۶۱۔ احمد ۱/۴۲۹)","Da'if","Musannaf Ibn Abi Shaybah 12007","","","كتاب الجنائز"
"12008","(۱۲۰۰۸) حدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، عَنْ أَبِیہِ : أَنَّ رَجُلاً کَانَ یَأْتِی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَمَعَہُ ابْنٌ لَہُ ، فَقَالَ لَہُ : رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَتُحِبُّہُ ؟ قَالَ : أَحَبَّک اللَّہُ کَمَا أحِبُّہُ ، قَالَ فَفَقَدَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : مَا فَعَلَ ابْنُک ، فَقَالَ : أَشَعَرْتَ أَنَّہُ تُوُفِّیَ ، فَقَالَ لَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَمَا یَسُرُّک ، أَنَّہُ لاَ تَأْتِی بَابًا مِنْ أَبْوَابِ الْجَنَّۃِ تَسْتَفْتِحُہُ إِلاَّ جَائَ یَسْعَی حَتَّی یََفْتحَہُ لَکَ ، فَقَالَ : یَا رَسُولَ اللہِ أَلَہُ خَاصَّۃً أَمْ لِلنَّاسِ عَامَّۃً ؟ قَالَ : لَکُمْ عَامَّۃً۔ (نسائی ۱۹۹۷۔ احمد ۳/۴۳۶)","Sahih","Musannaf Ibn Abi Shaybah 12008","","","كتاب الجنائز"
"12009","(۱۲۰۰۹) حدَّثَنَا مُصْعَبُ بْنُ الْمِقْدَامِ ، حدَّثَنَا مِنْدَلٌ ، حدَّثَنَا الْحَسَنُ بْنُ الْحَکَمِ ، عَنْ أَسْمَائَ بِنْتِ عَابِسٍ ، عَنْ أَبِیہَا ، عَنْ عَلِیٍّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ السِّقْطَ لَیُرَاغِمُ رَبَّہُ إن أدْخِلَ أَبَوَاہُ النَّارَ حَتَّی یُقَالَ أَیُّہَا السِّقْطُ الْمُرَاغِمُ رَبَّہُ اربفَعْ فَإِنِّی أَدْخَلْت أَبَوَیْک الْجَنَّۃَ ، قَالَ : فَیَجُرُّہُمَا بِسَرَرِہِ ، حَتَّی یُدْخِلَہُمَا الْجَنَّۃَ۔ (ابن ماجہ ۱۶۰۸۔ بزار ۸۱۵)","Da'if","Musannaf Ibn Abi Shaybah 12009","","","كتاب الجنائز"
"12010","(۱۲۰۱۰) حدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، حَدَّثَنا یَزِیدُ بْنُ عَبْدِ الْمَلِکِ النَّوْفَلِیُّ ، عَنْ یَزِیدَ بْنِ رُومَانَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَسِقْط أُقَدِّمُہُ بَیْنَ یَدَیَّ أَحَبُّ إلَیَّ مِنْ فَارِسٍ أَخْلُفُہُ خَلْفِی۔ (ابن ماجہ ۱۶۰۷)","Da'if","Musannaf Ibn Abi Shaybah 12010","","","كتاب الجنائز"
"12011","(۱۲۰۱۱) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامِ بْنِ حَسَّانَ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، قَالَ : حَدَّثَتْنِی امْرَأَۃٌ کَانَتْ تَأْتِینَا یُقَالُ لَہَا مَاوِیَۃٌ ، أَنَّہَا دَخَلَتْ عَلَی عُبَیْدِ اللہِ بْنِ مَعْمَرٍ ، وَعِنْدَہُ رَجُلٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَحَدَّثَ ذَلِکَ الرَّجُلُ عُبَیْدَ اللہِ بْنَ مَعْمَرٍ : عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّ امْرَأَۃً أَتَتْہُ بِصَبِیٍّ لَہَا ، فَقَالَتْ : یَا رَسُولَ اللہِ ادْعُ أَنْ یُبْقِیَہُ فَقَدْ مَضَی لِی ثَلاَثَۃٌ ، فَقَالَ : لَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَمُنْذُ أَسْلَمْتِ قَالَتْ نَعَمْ ، قَالَ : جُنَّۃٌ حَصِینَۃٌ مِنَ النَّارِ ، إِلاَّ أَنَّہُ قَالَ لَہَا : أَمُنْذُ أَسْلَمْت ثَلاَثَۃٌ جُنَّۃٌ حَصِینَۃٌ مِنَ النَّارِ قَالَتْ : فَقَالَ لی عُبَیْدُ اللہِ : یَا مَاوِِیَۃُ تَعَالَی فَاسْمَعِی ہَذَا الْحَدِیثَ ، قَالَتْ : فسَمِعْتُہُ ، ثُمَّ خَرَجَتْ مِنْ عِنْدِ عُبَیْدِ اللہِ فَأَتَتْنَا ، وَحَدَّثَتْنَا بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 12011","","","كتاب الجنائز"
"12012","(۱۲۰۱۲) حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا دُفِنَ الرَّجُلُ وَالْمَرْأَۃُ فِی قَبْرٍ قُدِّمَ الرَّجُلُ أمام الْمَرْأَۃِ۔","","Musannaf Ibn Abi Shaybah 12012","","","كتاب الجنائز"
"12013","(۱۲۰۱۳) حدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ ؛ فِی الرَّجُلِ وَالْمَرْأَۃِ یُدْفَنَانِ فِی الْقَبْرِ قَالاَ : یُقَدَّمُ الرَّجُلُ أَمَامَ الْمَرْأَۃِ فِی الْقَبْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 12013","","","كتاب الجنائز"
"12014","(۱۲۰۱۴) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ أَشْعَثَ ، عَنْ أَبِی إِسْحَاقَ ، أَنَّ عَلِیًّا کَانَ إذَا صَلَّی عَلَی جَنَائِزِ رِجَالٍ وَنِسَائٍ جَعَلَ الرِّجَالَ مِمَّا یَلُونَہُ وَالنِّسَائَ مِمَّا یَلِی الْقِبْلَۃَ ، وَإِذَا دَفَنَہُمْ قَدَّمَ الرَّجُلَ وَأَخَّرَ النِّسَائَ۔","Da'if","Musannaf Ibn Abi Shaybah 12014","","","كتاب الجنائز"
"12015","(۱۲۰۱۵) حدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ؛ فِی الرَّجُلِ وَالْمَرْأَۃِ یُدْفَنَانِ فِی قَبْرٍ وَاحِدٍ ، قَالَ : یُقَدَّمُ الرَّجُلُ أَمَامَہَا۔","","Musannaf Ibn Abi Shaybah 12015","","","كتاب الجنائز"
"12016","(۱۲۰۱۶) حدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَیُّوبَ ، عَنْ قَتَادَۃَ ، قَالَ : إذَا دُفِنَ الرَّجُلُ وَالْمَرْأَۃُ فِی قَبْرٍ وَاحِدٍ جُعِلَ الرَّجُلُ قُدَّامَ الْمَرْأَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 12016","","","كتاب الجنائز"
"12017","(۱۲۰۱۷) حدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، عَنْ وَاثِلَۃَ بْنِ الأَسْقَعِ ؛ فِی امْرَأَۃٍ نَصْرَانِیَّۃٍ فِی بَطْنِہَا وَلَدٌ مِنْ مُسْلِمٍ ، قَالَ : تُدْفَنُ فِی مَقْبَرَۃٍ لَیْسَت مَقْبَرَۃَ الْیَہُودِ وَالنَّصَارَی۔","","Musannaf Ibn Abi Shaybah 12017","","","كتاب الجنائز"
"12018","(۱۲۰۱۸) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو قَالَ مَاتَتِ امْرَأَۃٌ بِالشَّامِ وَفِی بَطْنِہَا وَلَدٌ مِنْ مُسْلِمٍ وَہِیَ نَصْرَانِیَّۃٌ فَأَمَرَ عُمَرُ أَنْ تُدْفَنَ مَعَ الْمُسْلِمِینَ مِنْ أَجْلِ وَلَد??ہَا۔","","Musannaf Ibn Abi Shaybah 12018","","","كتاب الجنائز"
"12019","(۱۲۰۱۹) حدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ حَنْظَلَۃَ ، عَنِ الْقَاسِمِ ، قَالَ : الْحَائِضُ لاَ تُصَلِّی عَلَی الْجِنَازَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 12019","","","كتاب الجنائز"
"12020","(۱۲۰۲۰) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ مُحِلٍّ ، عَنِ الشَّعْبِیِّ ، قَالَ : سُئِلَ عَنِ الْحَائِضِ تُصَلِّی عَلَی الْجِنَازَۃِ ، قَالَ : لاَ وَلاَ الطَّاہِرَ۔","","Musannaf Ibn Abi Shaybah 12020","","","كتاب الجنائز"
"12021","(۱۲۰۲۱) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ اللہِ بْنِ حَبِیب بنِ أَبِی ثَابِتٍ ، قَالَ : سَأَلْتُ عَطَائً تُصَلِّی الْحَائِضُ عَلَی الْجِنَازَۃِ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 12021","","","كتاب الجنائز"
"12022","(۱۲۰۲۲) حدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ ثَوْرٍ عَمَّنْ حَدَّثَہُ ، أَنَّ أَبَا عُبَیْدَۃَ صَلَّی عَلَی رُؤُوسٍ بِالشَّامِ۔","Da'if","Musannaf Ibn Abi Shaybah 12022","","","كتاب الجنائز"
"12023","(۱۲۰۲۳) حدَّثَنَا عِیسَی ، عَنْ ثَوْرٍ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، عَنْ أَبِی عُبَیْدَۃَ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 12023","","","كتاب الجنائز"
"12024","(۱۲۰۲۴) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ رَجُلٍ ، أَنَّ أَبَا أَیُّوبَ صَلَّی عَلَی رِجْلٍ۔","Da'if","Musannaf Ibn Abi Shaybah 12024","","","كتاب الجنائز"
