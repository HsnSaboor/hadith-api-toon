hadiths[122]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"2899","«تابعوا بين الحج والعمرة فإن متابعة بينهما تنفي الفقر والذنوب كما ينفي الكير خبث الحديد»","صحيح","Sahih al-Jami al-Saghir 2899","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2900","«تابعوا بين الحج والعمرة فإنهما ينفيان الذنوب كما ينفي الكير خبث الحديد»","صحيح","Sahih al-Jami al-Saghir 2900","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2901","«تابعوا بين الحج وعمرة فإنهما ينفيان الفقر والذنوب كما ينفي الكير خبث الحديد والذهب والفضة وليس للحجة المبرورة ثواب إلا الجنة»","صحيح","Sahih al-Jami al-Saghir 2901","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2902","«تأتي الإبل على ربها على خير ما كانت إذا هي لم يعط فيها حقها تطؤه بأخفافها وتأتي الغنم على ربها على خير ما كانت إذا لم يعط فيها حقها تطؤه بأظلافها وتنطحه بقرونها ومن حقها أن تحلب على الماء ألا لا يأتين أحدكم يوم القيامة ببعير يحمله على رقبته له رغاء فيقول: يا محمد! فأقول: لا أملك لك شيئا قد بلغت ألا لا يأتين أحدكم يوم القيامة بشاة يحملها على رقبته لها يعار فيقول: يا محمد! فأقول: لا أملك لك شيئا قد بلغت ويكون كنز أحدكم يوم القيامة شجاعا أقرع يفر منه صاحبه ويطلبه: أنا كنزك فلا يزال حتى يلقمه إصبعه»","صحيح","Sahih al-Jami al-Saghir 2902","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2903","«تأخذ إحداكن ماءها وسدرها فتطهر فتحسن الطهور ثم تصب على رأسها فتدلكه دلكا شديدا حتى يبلغ شئون رأسها ثم تصب عليها الماء ثم تأخذ فرصة ممسكة فتطهر بها»","صحيح","Sahih al-Jami al-Saghir 2903","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2904","«تؤخذ صدقات المسلمين على مياههم»","صحيح","Sahih al-Jami al-Saghir 2904","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2905","«تأكل النار ابن آدم إلا أثر السجود حرم الله عز وجل على النار أن تأكل أثر السجود»","صحيح","Sahih al-Jami al-Saghir 2905","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2906","«تبايعوا الذهب بالفضة كيف شئتم والفضة بالذهب كيف شئتم»","صحيح","Sahih al-Jami al-Saghir 2906","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2907","«تبا للذهب والفضة»","حسن","Sahih al-Jami al-Saghir 2907","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2908","«تبسمك في وجه أخيك لك صدقة وأمرك بالمعررف ونهيك عن المنكر صدقة وإرشادك الرجل في أرض الضلال لك صدقة وإماطتك الحجر والشوك والعظم عن الطريق لك صدقة وإفراغك من دلوك في دلو أخيك لك صدقة»","صحيح","Sahih al-Jami al-Saghir 2908","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2909","«تبعث الملائكة يوم الجمعة إلى أبواب المسجد يكتبون الأول فالأول فإذا صعد الإمام على المنبر طويت الصحف»","صحيح","Sahih al-Jami al-Saghir 2909","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2910","«تبعث النخامة في القبلة يوم القيامة وهي في وجه صاحبها»","صحيح","Sahih al-Jami al-Saghir 2910","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2911","«تبلغ الحلية من المؤمن حيث يبلغ الوضوء»","صحيح","Sahih al-Jami al-Saghir 2911","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2912","«تبلغ المساكن إهاب»","صحيح","Sahih al-Jami al-Saghir 2912","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2913","«تتركون المدينة على خير ما كانت لا يغشاها إلا العوافي وآخر من يحشر راعيان من مزينة يريدان المدينة ينعقان بغنمهما فيجدانها وحوشا حتى إذا بلغا ثنية الوداع خرا على وجوههما»","صحيح","Sahih al-Jami al-Saghir 2913","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2914","«تجافوا عن عقوبة ذوي المروءة»","صحيح","Sahih al-Jami al-Saghir 2914","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2915","«تجب الجمعة على كل مسلم إلا امرأة أو صبيا أو مملوكا»","صحيح","Sahih al-Jami al-Saghir 2915","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2916","""تجدون الناس معادن فخيارهم في الجاهلية خيارهم في الإسلام إذا فقهوا وتجدون خير الناس في هذا الشأن أشدهم له كراهية قبل أن يقع فيه وتجدون شر الناس يوم القيامة عند الله ذا الوجهين:","صحيح","Sahih al-Jami al-Saghir 2916","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2917","«تجوزوا في الصلاة فإن خلفكم الضعيف والكبير وذا الحاجة»","صحيح","Sahih al-Jami al-Saghir 2917","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2918","«تجيء ريح بين يدي الساعة! فيقبض فيها روح كل مؤمن»","صحيح","Sahih al-Jami al-Saghir 2918","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2919","«تحاجت النار والجنة فقالت النار: أوثرت بالمتكبرين والمتجبرين وقالت الجنة: فما لي لا يدخلني إلا ضعفاء الناس وسقطهم وعجزهم؟ فقال الله عز وجل للجنة: إنما أنت رحمتي أرحم بك من أشاء من عبادي وقال للنار: إنما أنت عذابي أعذب بك من أشاء من عبادي ولكل واحدة منكما ملؤها فأما النار فلا تمتلئ حتى يضع الله قدمه عليها فتقول: قط قط فهنالك تمتلئ وينزوي بعضها إلى بعض فلا يظلم الله من خلقه أحدا وأما الجنة فإن الله ينشئ لها خلقا»","صحيح","Sahih al-Jami al-Saghir 2919","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2920","«تحروا ليلة القدر فمن كان متحريها فليتحرها في ليلة سبع وعشرين»","صحيح","Sahih al-Jami al-Saghir 2920","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2921","«تحروا ليلة القدر في السبع الأواخر»","صحيح","Sahih al-Jami al-Saghir 2921","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2922","«تحروا ليلة القدر في الوتر من العشر الأواخر من رمضان»","صحيح","Sahih al-Jami al-Saghir 2922","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2923","«تحروا ليلة القدر ليلة ثلاث وعشرين»","صحيح","Sahih al-Jami al-Saghir 2923","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2924","«تحشرون حفاة عراة غرلا»","صحيح","Sahih al-Jami al-Saghir 2924","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2925","«تحول إلى الظل.. ... »","صحيح","Sahih al-Jami al-Saghir 2925","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2926","«تحولوا عن مكانكم الذي أصابتكم فيه الغفلة»","صحيح","Sahih al-Jami al-Saghir 2926","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2927","«تخرج الدابة فتسم الناس على خراطيمهم ثم يعمرون فيكم حتى يشتري الرجل الدابة فيقال: ممن اشتريت؟ فيقول: من الرجل المخطم»","صحيح","Sahih al-Jami al-Saghir 2927","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2928","«تخيروا لنطفكم فانكحوا الأكفاء وانكحوا إليهم»","صحيح","Sahih al-Jami al-Saghir 2928","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2929","«تداووا بألبان البقر فإني أرجو أن يجعل الله فيها شفاء فإنها تأكل من كل الشجر»","حسن","Sahih al-Jami al-Saghir 2929","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2930","«تداووا عباد الله فإن الله تعالى لم يضع داء إلا وضع له دواء غير داء واحد: الهرم»","صحيح","Sahih al-Jami al-Saghir 2930","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2931","«تدمع العين ويحزن القلب ولا نقول إلا ما يرضي الرب والله إنا بفراقك يا إبراهيم لمحزونون»","صحيح","Sahih al-Jami al-Saghir 2931","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2932","«تدمع العين ويحزن القلب ولا نقول ما يسخط الرب ولولا أنه وعد صادق وموعود جامع وأن الآخر منا يتبع الأول لوجدنا عليك يا إبراهيم وجدا أشد مما وجدنا وإنا بك يا إبراهيم لمحزونون»","حسن","Sahih al-Jami al-Saghir 2932","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2933","«تدنوا الشمس يوم القيامة من الخلق حتى تكون منهم كمقدار ميل فيكون الناس على قدر أعمالهم في العرق فمنهم من يكون إلى كعبيه ومنهم من يكون إلى ركبتيه ومنهم من يكون إلى حقويه ومنهم من يلجمه العرق إلجاما»","صحيح","Sahih al-Jami al-Saghir 2933","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2934","«تدور رحى الإسلام لخمس وثلاثين أوست وثلاثين أوسبع وثلاثين فإن يهلكوا فسبيل من هلك وإن يقم لهم دينهم يقم لهم سبعين عاما بما مضى»","صحيح","Sahih al-Jami al-Saghir 2934","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2935","«تذهبون الخير فالخير حتى لا يبقى منكم إلا مثل هذه»","حسن","Sahih al-Jami al-Saghir 2935","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2936","«ترد علي أمتي الحوض وأنا أذود الناس عنه كما يذود الرجل إبل الرجل عن إبله قالوا: يا نبي الله تعرفنا؟ قال: نعم لكم سيما ليست لأحد غيركم تردون علي غرا محجلين من آثار الوضوء وليصدن عني طائفة منكم فلا يصلون فأقول: يا رب هؤلاء من أصحابي! فيجيبني ملك فيقول: وهل تدري ما أحدثوا بعدك»","صحيح","Sahih al-Jami al-Saghir 2936","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2937","«تركت فيكم شيئين لن تضلوا بعدهما: كتاب الله وسنتي ولن يتفرقا حتى يردا علي الحوض»","صحيح","Sahih al-Jami al-Saghir 2937","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2938","«تزوج ولو بخاتم من حديد»","صحيح","Sahih al-Jami al-Saghir 2938","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2939","«تزوجوا الأبكار فإنهن أعذب أفواها وأنتق أرحاما وأرضى باليسير»","حسن","Sahih al-Jami al-Saghir 2939","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2940","«تزوجوا الودود الولود فإني مكاثر بكم»","صحيح","Sahih al-Jami al-Saghir 2940","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2941","«تزوجوا فإني مكاثر بكم الأمم ولا تكونوا كرهبانية النصارى»","صحيح","Sahih al-Jami al-Saghir 2941","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2942","«تستأمر اليتيمة في نفسها فإن سكتت فهو إذنها وإن أبت فلا جواز عليها»","صحيح","Sahih al-Jami al-Saghir 2942","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2943","«تسحروا فإن في السحور بركة»","صحيح","Sahih al-Jami al-Saghir 2943","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2944","«تسحروا ولو بالماء»","صحيح","Sahih al-Jami al-Saghir 2944","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2945","«تسحروا ولو بجرعة من ماء»","صحيح","Sahih al-Jami al-Saghir 2945","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2946","«تسليم الرجل بإصبع واحدة يشير بها فعل اليهود»","حسن","Sahih al-Jami al-Saghir 2946","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2947","«تسمعون ويسمع منكم ويسمع ممن يسمع منكم»","صحيح","Sahih al-Jami al-Saghir 2947","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2948","«تسموا باسمي ولا تكنوا بكنيتي»","صحيح","Sahih al-Jami al-Saghir 2948","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2949","«تسموا باسمي ولا تكنوا بكنيتي فإنما أنا أبو القاسم أقسم بينكم»","صحيح","Sahih al-Jami al-Saghir 2949","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2950","""تصدقوا فسيأتي عليكم زمان يمشي الرجل بصدقته فيقول الذي يأتيه بها: لو جئت بها بالأمس لقبلتها فأما الآن فلا حاجة لي فيها فلا يجد من يقبلها""","صحيح","Sahih al-Jami al-Saghir 2950","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2951","«تصدقوا ولو بتمرة فإنها تسد من الجائع وتطفئ الخطيئة كما يطفئ الماء النار»","صحيح","Sahih al-Jami al-Saghir 2951","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2952","«تصدقي ولا توعي فيوعى عليك»","صحيح","Sahih al-Jami al-Saghir 2952","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2953","«تطوع الرجل في بيته يزيد على تطوعه عند الناس كفضل صلاة الرجل في جماعة على صلاته وحده»","صحيح","Sahih al-Jami al-Saghir 2953","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2954","«تعافوا الحدود فيما بينكم فما بلغني من حد فقد وجب»","حسن","Sahih al-Jami al-Saghir 2954","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2955","«تعالوا بايعوني على أن لا تشركوا بالله شيئا ولا تسرقوا ولا تزنوا ولا تقتلوا أولادكم ولا تأتوا ببهتان تفترونه بين أيديكم وأرجلكم ولا تعصوني في معروف فمن وفى منكم فأجره على الله ومن أصاب من ذلك شيئا فعوقب به في الدنيا فهو له كفارة ومن أصاب من ذلك شيئا فستره الله فأمره إلى الله إن شاء عاقبه وأن شاء عفا عنه»","صحيح","Sahih al-Jami al-Saghir 2955","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2956","«تعاهدوا القرآن فوالذي نفسي بيده لهو أشد تفصيا من قلوب الرجال من الإبل من عقلها»","صحيح","Sahih al-Jami al-Saghir 2956","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2957","«تعجلوا إلى الحج فإن أحدكم لا يدري ما يعرض له»","صحيح","Sahih al-Jami al-Saghir 2957","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2958","«تعرض أعمال الناس في كل جمعة مرتين: يوم الاثنين ويوم الخميس فيغفر لكل عبد مؤمن إلا عبدا بينه وبين أخيه شحناء فيقال اتركوا هذين حتى يفيئا»","صحيح","Sahih al-Jami al-Saghir 2958","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2959","«تعرض الأعمال يوم الاثنين والخميس فأحب أن يعرض عملي وأنا صائم»","صحيح","Sahih al-Jami al-Saghir 2959","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2960","«تعرض الفتن على القلوب عرض الحصير عودا عودا فأي قلب أشربها نكتت فيه نكتة سوداء وأي قلب أنكرها نكتت فيه نكتة بيضاء حتى يصير القلب أبيض مثل الصفا لا تضره فتنة ما دامت السموات والأرض والآخر أسود مربدا كالكوز مجخيا لا يعرف معروفا ولا ينكر منكرا إلا ما أشرب من هواه»","صحيح","Sahih al-Jami al-Saghir 2960","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2961","«تعرف إلى الله في الرخاء يعرفك في الشدة»","صحيح","Sahih al-Jami al-Saghir 2961","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2962","""تعس عبد الدينار وعبد الدرهم وعبد الخميصة إن أعطي رضي وإن لم يعط سخط تعس وانتكس وإذا شيك فلا انتقش طوبى لعبد آخذ بعنان فرسه في سبيل الله أشعث رأسه مغبرة قدماه إن كان في الحراسة كان في الحراسة وإن كان في الساقة كان في الساقة إن استأذن لم يؤذن له وإن شفع لم يشفع""","صحيح","Sahih al-Jami al-Saghir 2962","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2963","«تعلموا أنه لن يرى أحد منكم ربه حتى يموت»","صحيح","Sahih al-Jami al-Saghir 2963","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2964","«تعلموا كتاب الله وتعاهدوه وتغنوا به فوالذي نفسي بيده لهو أشد تفلتا من المخاض في العقل»","صحيح","Sahih al-Jami al-Saghir 2964","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2965","«تعلموا من أنسابكم ما تصلون به أرحامكم فإن صلة الرحم محبة في الأهل مثراة في المال منسأة في الأثر»","صحيح","Sahih al-Jami al-Saghir 2965","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2966","«تعلموا من قريش ولا تعلموها وقدموا قريشا ولا تؤخروها فإن للقرشي قوة الرجلين من غير قريش»","صحيح","Sahih al-Jami al-Saghir 2966","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2967","«تعوذوا بالله من جار السوء في دار المقام فإن الجار البادي يتحول عنك»","صحيح","Sahih al-Jami al-Saghir 2967","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2968","«تعوذوا بالله من جهد البلاء ودرك الشقاء وسوء القضاء وشماتة الأعداء»","صحيح","Sahih al-Jami al-Saghir 2968","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2969","«تغزون جزيرة العرب فيفتحها الله ثم فارس فيفتحها الله ثم تغزون الروم فيفتحها الله ثم تغزون الدجال فيفتحها الله»","صحيح","Sahih al-Jami al-Saghir 2969","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2970","«تفتح أبواب الجنة يوم الاثنين ويوم الخميس فيغفر فيها لكل عبد لا يشرك بالله شيئا إلا رجلا كانت بينه وبين أخيه شحناء فيقال: انظروا هذين حتى يصطلحا»","صحيح","Sahih al-Jami al-Saghir 2970","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2971","«تفتح أبواب السماء نصف الليل فينادي مناد: هل من داع فيستجاب له؟ هل من سائل فيعطى؟ هل من مكروب فيفرج عنه؟ فلا يبقى مسلم يدعو بدعوة إلا استجاب الله تعالى له إلا زانية تسعى بفرجها أو عشارا»","صحيح","Sahih al-Jami al-Saghir 2971","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2972","«تفتح اليمن فيأتي قوم يبسون فيتحملون بأهليهم ومن أطاعهم والمدينة خير لهم لو كانوا يعلمون وتفتح الشأم فيأتي قوم يبسون فيتحملون بأهليهم ومن أطاعهم والمدينة خير لهم لو كانوا يعلمون وتفتح العراق فيأتي قوم يبسون فيتحملون بأهليهم ومن أطاعهم والمدينة خير لهم لو كانوا يعلمون»","صحيح","Sahih al-Jami al-Saghir 2972","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2973","""تفتح يأجوج ومأجوج فيخرجون على الناس كما قال الله عز وجل: {مِنْ كُلِّ حَدَبٍ يَنْسِلُونَ} فيغشون الناس وينحاز المسلمون عنهم إلى مدائنهم وحصونهم ويضمون إليهم مواشيهم ويشربون مياه الأرض حتى إن بعضهم ليمر بالنهر فيشربون ما فيه حتى يتركوه يبسا حتى إن من يمر من بعدهم ليمر بذلك النهر فيقول: قد كان هاهنا ماء مرة حتى إذا لم يبق من الناس أحد إلا أحد في حصن أو مدينة قال قائلهم: هؤلاء أهل الأرض قد فرغنا منهم بقي أهل السماء! ثم يهز أحدهم حربته ثم يرمي بها إلى السماء فترجع إليه مختضبة دما للبلاء والفتنة فبينما هم على ذلك إذ بعث الله عز وجل دودا في أعناقهم كنغف الجراد الذي يخرج في أعناقه فيصبحون موتى لا يسمع لهم حس فيقول المسلمون: ألا رجل يشري لنا نفسه فينظر ما فعل هذا العدو؟ فيتجرد رجل منهم محتسبا نفسه قد أوطنها على أنه مقتول فينزل فيجدهم موتى بعضهم على بعض فينادي: يا معشر المسلمين ألا أبشروا إن الله عز وجل قد كفاكم عدوكم فيخرجون من مدائنهم وحصونهم ويسرحون مواشيهم فما يكون لهم مرعى إلا لحومهم فتشكر عنه كأحسن ما شكرت عن شيء من النبات أصابته قط ""","حسن","Sahih al-Jami al-Saghir 2973","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2974","«تفضل صلاة الجمع صلاة أحدكم وحده بخمس وعشرين جزءا وتجتمع ملائكة الليل وملائكة النهار في صلاة الفجر»","صحيح","Sahih al-Jami al-Saghir 2974","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2975","«تفكروا في آلاء الله ولا تفكروا في الله»","حسن","Sahih al-Jami al-Saghir 2975","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2976","«تفكروا في خلق الله ولا تفكروا في الله»","حسن","Sahih al-Jami al-Saghir 2976","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2977",""" تقاتلون اليهود فتسلطون عليهم حتى يختبئ أحدهم وراء الحجر فيقول الحجر: يا عبد الله هذا يهودي ورائي فاقتله ""","صحيح","Sahih al-Jami al-Saghir 2977","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2978","«تقبلوا لي بست أتقبل لكم بالجنة إذا حدث أحدكم فلا يكذب وإذا وعد فلا يخلف وإذا ائتمن فلا يخن غضوا أبصاركم وكفوا أيديكم واحفظوا فروجكم»","صحيح","Sahih al-Jami al-Saghir 2978","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2979","«تقتل عمارا الفئة الباغية»","صحيح","Sahih al-Jami al-Saghir 2979","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2980","«تقدموا فأتموا بي وليأتم بكم من بعدكم ولا يزال قوم يتأخرون حتى يؤخرهم الله»","صحيح","Sahih al-Jami al-Saghir 2980","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2981","«تقطع اليد في ثمن المجن»","صحيح","Sahih al-Jami al-Saghir 2981","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2982","«تقطع يد السارق في ربع دينار فصاعدا»","صحيح","Sahih al-Jami al-Saghir 2982","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2983","«تقعد الملائكة على أبواب المساجد يوم الجمعة فيكتبون الأول والثاني والثالث حتى إذا خرج الإمام رفعت الصحف»","حسن","Sahih al-Jami al-Saghir 2983","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2984","«تقوم الساعة والروم أكثر الناس»","صحيح","Sahih al-Jami al-Saghir 2984","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2985",""" تكفل الله لمن جاهد في سبيله لا يخرجه من بيته إلا الجهاد في سبيله وتصديق كلماته بأن يدخله الجنة أو يرجعه إلى مسكنه الذي خرج منه مع ما نال من أجر أو غنيمة""","صحيح","Sahih al-Jami al-Saghir 2985","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2986","«تكفير كل لحاء ركعتان»","حسن","Sahih al-Jami al-Saghir 2986","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2987","«تكون إبل للشياطين وبيوت للشياطين»","صحيح","Sahih al-Jami al-Saghir 2987","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2988","«تكون الأرض يوم القيامة خبزة واحدة يتكفؤها الجبار بيده كما يتكفأ أحدكم خبزته في السفر نزلا لأهل الجنة»","صحيح","Sahih al-Jami al-Saghir 2988","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2989","«تكون النسم طيرا تعلق بالشجر حتى إذا كان يوم القيامة دخلت كل نفس في جسدها»","صحيح","Sahih al-Jami al-Saghir 2989","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2990","«تكون أمراء يقولون ولا يرد عليهم يتهافتون في النار يتبع بعضهم بعضا»","صحيح","Sahih al-Jami al-Saghir 2990","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2991","«تكون بينكم وبين بني الأصفر هدنة فيغدرون بكم فيسيرون إليكم في ثمانين غاية تحت كل غاية منهم اثنا عشر ألفا»","صحيح","Sahih al-Jami al-Saghir 2991","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2992","«تكون بين يدي الساعة أيام يرفع فيها العلم وينزل فيها الجهل ويكثر فيها الهرج والهرج: القتل»","صحيح","Sahih al-Jami al-Saghir 2992","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2993","«تكون بين يدي الساعة فتن كقطع الليل المظلم يصبح الرجل فيها مؤمنا ويمسي كافرا ويمسي مؤمنا ويصبح كافرا يبيع أقوام دينهم بعرض من الدنيا»","صحيح","Sahih al-Jami al-Saghir 2993","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2994","«تكون دعاة على أبواب جهنم من أجابهم إليها قذفوه فيها هم قوم من جلدتنا يتكلمون بألسنتنا فالزم جماعة المسلمين وإمامهم فإن لم تكن جماعة ولا إمام فاعتزل تلك الفرق كلها ولو أن تعض بأصل شجرة حتى يدركك الموت وأنت كذلك»","صحيح","Sahih al-Jami al-Saghir 2994","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2995","«تكون هدنة على دخن قلوب لا تعود على ما كانت عليه ثم تكون دعاة الضلالة فإن رأيت يومئذ خليفة الله في الأرض فالزمه وإن نهك جسمك وأخذ مالك وإن لم تره فاضرب في الأرض ولو أن تموت وأنت عاض على جذل شجرة»","حسن","Sahih al-Jami al-Saghir 2995","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2996","«تلقى الأرض أفلاذ كبدها أمثال الأسطوان من الذهب والفضة فيجيء القاتل فيقول: في هذا قتلت ويجيء القاطع فيقول: في هذا قطعت رحمي ويجيء السارق فيقول: في هذا قطعت يدي ثم يدعونه فلا يأخذون منه شيئا»","صحيح","Sahih al-Jami al-Saghir 2996","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2997","«تمرق مارقة عند فرقة بين المسلمين فيقتلها أولى الطائفتين بالحق»","صحيح","Sahih al-Jami al-Saghir 2997","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2998","«تمسحوا بالأرض فإنها بكم برة»","صحيح","Sahih al-Jami al-Saghir 2998","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"2999","«تمضمضوا واستنشقوا والأذنان من الرأس»","صحيح","Sahih al-Jami al-Saghir 2999","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"3000","«تنام عيناي ولا ينام قلبي»","صحيح","Sahih al-Jami al-Saghir 3000","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"3001","«تنزل المعونة من السماء على قدر المؤنة وينزل الصبر على قدر المصيبة»","صحيح","Sahih al-Jami al-Saghir 3001","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"3002","«تنزهوا من البول فإن عامة عذاب القبر منه»","صحيح","Sahih al-Jami al-Saghir 3002","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"3003","«تنكح المرأة لأربع: لمالها ولحسبها ولجمالها ولدينها فاظفر بذات الدين تربت يداك»","صحيح","Sahih al-Jami al-Saghir 3003","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"3004","«تهادوا تحابوا»","حسن","Sahih al-Jami al-Saghir 3004","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"3005","«توبوا إلى الله تعالى فإني أتوب إليه كل يوم مائة مرة»","صحيح","Sahih al-Jami al-Saghir 3005","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"3006","«توضئوا من لحوم الإبل ولا تتوضئوا من لحوم الغنم وصلوا في مرابض الغنم ولا تصلوا في مبارك الإبل»","صحيح","Sahih al-Jami al-Saghir 3006","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"3007","«توضئوا مما مست النار»","صحيح","Sahih al-Jami al-Saghir 3007","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"3008","«التائب من الذنب كمن لا ذنب له»","حسن","Sahih al-Jami al-Saghir 3008","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"3009","«التؤدة في كل شيء خير إلا في عمل الآخرة»","صحيح","Sahih al-Jami al-Saghir 3009","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"3010","«التؤدة والاقتصاد والسمت الحسن جزء من أربعة وعشرين جزءا من النبوة»","صحيح","Sahih al-Jami al-Saghir 3010","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"3011","«التأني من الله والعجلة من الشيطان»","حسن","Sahih al-Jami al-Saghir 3011","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"3012","«التثاؤب في الصلاة من الشيطان فإذا تثاءب أحدكم فليكظم ما استطاع»","صحيح","Sahih al-Jami al-Saghir 3012","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"3013","«التثاؤب من الشيطان فإذا تثاءب أحدكم فليرده ما استطاع فإن أحدكم إذا قال: ها ضحك منه الشيطان»","صحيح","Sahih al-Jami al-Saghir 3013","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"3014","""التحدث بنعمة الله شكر وتركها كفر ومن لا يشكر القليل لا يشكر الكثير ومن لا يشكر الناس لا يشكر الله والجماعة بركة والفرقة عذاب""","حسن","Sahih al-Jami al-Saghir 3014","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"3015","«التسبيح للرجال والتصفيق للنساء»","صحيح","Sahih al-Jami al-Saghir 3015","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"3016","«التفل في المسجد خطيئة وكفارته أن يواريه»","صحيح","Sahih al-Jami al-Saghir 3016","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"3017","«التكبير في الفطر سبع في الأولى وخمس في الآخرة والقراءة بعدهما كلتيهما»","حسن","Sahih al-Jami al-Saghir 3017","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"3018","«التلبينة مجمة لفؤاد المريض تذهب ببعض الحزن»","حسن","Sahih al-Jami al-Saghir 3018","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"3019","«التمر بالتمر والحنطة بالحنطة والشعير بالشعير والملح بالملح مثلا بمثل يدا بيد فمن زاد واستزاد فقد أربى إلا ما اختلفت ألوانه»","صحيح","Sahih al-Jami al-Saghir 3019","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
"3020","«التيمم ضربة للوجه وضربة للكفين»","صحيح","Sahih al-Jami al-Saghir 3020","","","الأحاديث المبدوءة بحرف التاء Hadith Beginning with the Letter Ta (ت)"
