hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"4009","(۴۰۰۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، قَالَ: أَخْبَرَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنِ الزُّہْرِیِّ ، قَالَ : کَانَ أَشْیَاخُنَا لاَ یُمَایلُونَ ، یَعْنِی إذَا رَفَعَ أَحَدُہُمْ رَأْسَہُ مِنَ السَّجْدَۃِ الثَّانِیَۃِ فِی الرَّکْعَۃِ الأُولَی وَالثَّالِثَۃِ یَنْہَضُ کَمَا ہُوَ ، وَلَمْ یَجْلِسْ۔","","Musannaf Ibn Abi Shaybah 4009","","","كتاب الصلوات"
"4010","(۴۰۱۰) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یُسْرِعُ فِی الْقِیَامِ فِی الرَّکْعَۃِ الأُولَی مِنْ آخِرِ سَجْدَۃٍ۔","","Musannaf Ibn Abi Shaybah 4010","","","كتاب الصلوات"
"4011","(۴۰۱۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنِ النُّعْمَانِ بْنِ أَبِی عَیَّاشٍ ، قَالَ : أَدْرَکْت غَیْرَ وَاحِدٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَکَانَ إذَا رَفَعَ رَأْسَہُ مِنَ السَّجْدَۃِ فِی أَوَّلِ رَکْعَۃٍ وَالثَّالِثَۃِ ، قَامَ کَمَا ہُوَ وَلَمْ یَجْلِسْ۔","Hasan","Musannaf Ibn Abi Shaybah 4011","","","كتاب الصلوات"
"4012","(۴۰۱۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ خَالِدٍ ، قَالَ : رَأَیْتُ أَبَا قِلاَبَۃَ وَالْحَسَنَ یَعْتَمِدَانِ عَلَی أَیْدِیہِمَا فِی الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 4012","","","كتاب الصلوات"
"4013","(۴۰۱۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَعْتَمِدَ الرَّجُلُ عَلَی یَدَیْہِ إذَا نَہَضَ فِی الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 4013","","","كتاب الصلوات"
"4014","(۴۰۱۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 4014","","","كتاب الصلوات"
"4015","(۴۰۱۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُحَمَّدِ بْنِ جُحَادَۃَ ، عَنِ الْحَارِثِ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَکْرَہُ ذَلِکَ ، إِلاَّ أَنْ یَکُونَ شَیْخًا کَبِیرًا ، أَوْ مَرِیضًا۔","","Musannaf Ibn Abi Shaybah 4015","","","كتاب الصلوات"
"4016","(۴۰۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، قَالَ : أَخْبَرَنِی مَنْ رَأَی الأَسْوَدَ وَشُرَیْحًا وَمَسْرُوقًا یَعْتَمِدُونَ عَلَی أَیْدِیہِمْ إذَا نَہَضُوا۔","","Musannaf Ibn Abi Shaybah 4016","","","كتاب الصلوات"
"4017","(۴۰۱۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ إسْمَاعِیلَ ، قَالَ : رَأَیْتُ قَیْسًا یَعْتَمِدُ عَلَی یَدَیْہِ إذَا نَہَضَ۔","","Musannaf Ibn Abi Shaybah 4017","","","كتاب الصلوات"
"4018","(۴۰۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنِ الأَزْرَقِ بْنِ قَیْسٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ یَنْہَضُ فِی الصَّلاَۃِ وَیَعْتَمِدُ عَلَی یَدَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4018","","","كتاب الصلوات"
"4019","(۴۰۱۹) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَعْتَمِدُ عَلَی یَدَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 4019","","","كتاب الصلوات"
"4020","(۴۰۲۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنْ زِیَادِ بْنِ زَیْدٍ السُّوَائِیِّ ، عَنْ أَبِی جُحَیْفَۃَ ، عَنْ عَلِیٍّ ، قَالَ : إنَّ مِنَ السُّنَّۃِ فِی الصَّلاَۃِ الْمَکْتُوبَۃِ إذَا نَہَضَ الرَّجُلُ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ أَنْ لاَ یَعْتَمِدَ بِیَدَیْہِ عَلَی الأَرْضِ ، إِلاَّ أَنْ یَکُونَ شَیْخًا کَبِیرًا لاَ یَسْتَطِیعُ۔ (بیہقی ۱۳۶)","Da'if","Musannaf Ibn Abi Shaybah 4020","","","كتاب الصلوات"
"4021","(۴۰۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مَہْدِیِّ بْنِ مَیْمُونٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَرِہَ أَنْ یَعْتَمِدَ ، وَکَانَ الْحَسَنُ یَعْتَمِدُ۔","","Musannaf Ibn Abi Shaybah 4021","","","كتاب الصلوات"
"4022","(۴۰۲۲) حَدَّثَنَا أَبُو دَاوُدَ ، عَنِ الْہُذَیْلِ بْنِ بِلاَلٍ ، قَالَ : رَأَیْتُ عَطَائً یَعْتَمِدُ إذَا نَہَضَ۔","","Musannaf Ibn Abi Shaybah 4022","","","كتاب الصلوات"
"4023","(۴۰۲۳) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : کَانَ مَالِکُ بْنُ الْحُوَیْرِثِ یَأْتِینَا فَیَقُولُ : أَلاَّ أُحَدِّثُکُمْ عَنْ صَلاَۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَیُصَلِّی فِی غَیْرِ وَقْتِ صَلاَۃٍ ، فَإِذَا رَفَعَ رَأْسَہُ مِنَ السَّجْدَۃِ الثَّانِیَۃِ فِی أَوَّلِ رَکْعَۃٍ اسْتَوَی قَاعِدًا ، ثُمَّ قَامَ وَاعْتَمَدَ۔ (بخاری ۸۲۳۔ ابوداؤد ۸۴۰)","Sahih","Musannaf Ibn Abi Shaybah 4023","","","كتاب الصلوات"
"4024","(۴۰۲۴) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ سُئِلَ عَنْ رَجُلٍ لَمْ یَقْرَأْ بِفَاتِحَۃِ الْکِتَابِ ؟ قَالَ : إِنْ کَانَ قَرَأَ غَیْرَہَا أَجْزَأَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 4024","","","كتاب الصلوات"
"4025","(۴۰۲۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ حَمَّادٍ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ عَنِ الرَّجُلِ یَنْسَی فَاتِحَۃَ الْکِتَابِ ، فَیَقْرَأُ سُورَۃً ، أَوْ یَقْرَأُ فَاتِحَۃَ الْکِتَابِ ، وَلاَ یَقْرَأُ مَعَہَا شَیْئًا ؟ قَالَ : یُجْزئہ۔","","Musannaf Ibn Abi Shaybah 4025","","","كتاب الصلوات"
"4026","(۴۰۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، وَالْحَکَمِ ؛ فِی رَجُلٍ نَسِیَ فَاتِحَۃَ الْکِتَابِ ، قَالَ الشَّعْبِیُّ : یَسْجُدُ سَجْدَتَیِ السَّہْوِ ، وَقَالَ الْحَکَمُ : یَقْرَؤُہَا إذَا ذُکر۔","","Musannaf Ibn Abi Shaybah 4026","","","كتاب الصلوات"
"4027","(۴۰۲۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ قَرَأَ ، {قُلْ ہُوَ اللَّہُ أَحَدٌ} ، وَنَسِیَ فَاتِحَۃَ الْکِتَابِ ، قَالَ : تُجْزئہ۔","","Musannaf Ibn Abi Shaybah 4027","","","كتاب الصلوات"
"4028","(۴۰۲۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِی سَلَمَۃَ ، قَالَ : صَلَّی عُمَرُ الْمَغْرِبَ فَلَمْ یَقْرَأْ ، فَلَمَّا انْصَرَفَ ، قَالَ لَہُ النَّاسُ : إنَّک لَمْ تَقْرَأْ ، قَالَ : فَکَیْفَ کَانَ الرُّکُوعُ وَالسُّجُودُ تَامٌّ ہُوَ ؟ قَالُوا : نَعَمْ ، فَقَالَ : لاَ بَأْسَ ، إنِّی حَدَّثْت نَفْسِی بِعِیرٍ جَہَّزْتہَا بِأَقْتَابِہَا وَحَقَائِبِہَا۔","","Musannaf Ibn Abi Shaybah 4028","","","كتاب الصلوات"
"4029","(۴۰۲۹) حَدَّثَنَا ابْنُ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، قَالَ : إذَا صَلَّی الرَّجُلُ فَنَسِیَ أَنْ یَقْرَأَ حَتَّی فَرَغَ مِنْ صَلاَتِہِ ، قَالَ : تُجْزئہ مَا کُلُّ النَّاسِ تَقْرَأُ۔","","Musannaf Ibn Abi Shaybah 4029","","","كتاب الصلوات"
"4030","(۴۰۳۰) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ (ح) وَعَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ؛ فِی رَجُلٍ نَسِیَ الْقِرَائَۃَ فِی الظُّہْرِ وَالْعَصْرِ حَتَّی فَرَغَ مِنْ صَلاَتِہِ ، قَالاَ : أَجْزَأَتْ عَنْہُ إذَا أَتَمَّ الرُّکُوعَ وَالسُّجُودَ۔","","Musannaf Ibn Abi Shaybah 4030","","","كتاب الصلوات"
"4031","(۴۰۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، قَالَ : جَائَ رَجُلٌ إلَی عَلِیٍّ ، فَقَالَ : إنِّی صَلَّیْت وَنَسِیت أَنْ أَقْرَأَ ؟ فَقَالَ لَہُ : أَتْمَمْتَ الرُّکُوعَ وَالسُّجُودَ ؟ قَالَ : نَعَمْ ، قَالَ : یُجْزِئُکَ۔","Da'if","Musannaf Ibn Abi Shaybah 4031","","","كتاب الصلوات"
"4032","(۴۰۳۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا نَسِیَ الْقِرَائَۃَ ، فَإِنَّہُ لاَ یَعْتَدُّ بِتِلْکَ الرَّکْعَۃِ۔","","Musannaf Ibn Abi Shaybah 4032","","","كتاب الصلوات"
"4033","(۴۰۳۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لاَ صَلاَۃَ إِلاَّ بِقِرَائَۃٍ۔","","Musannaf Ibn Abi Shaybah 4033","","","كتاب الصلوات"
"4034","(۴۰۳۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن ہَمَّامٍ ، قَالَ : صَلَّی عُمَرُ الْمَغْرِبَ فَلَمْ یَقْرَأْ فِیہَا ، فَلَمَّا انْصَرَفَ ، قَالُوا لَہُ : یَا أَمِیرَ الْمُؤْمِنِینَ ، إنَّک لَمْ تَقْرَأْ ، فَقَالَ : إنِّی حَدَّثْت نَفْسِی وَأَنَا فِی الصَّلاَۃِ بِعِیرٍ وَجَّہْتہَا مِنَ الْمَدِینَۃِ ، فَلَمْ أَزَلْ أُجَہِّزُہَا حَتَّی دَخَلَتِ الشَّامَ ، قَالَ : ثُمَّ أَعَادَ الصَّلاَۃَ وَالْقِرَائَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 4034","","","كتاب الصلوات"
"4035","(۴۰۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ، قَالَ : کَانَ إذَا کَبَّرَ سَکَتَ سَاعَۃً لاَ یَقْرَأُ ، فَکَبَّرَ ، فَرَکَعَ قَبْلَ أَنْ یَقْرَأَ ، فَرَفَعَ رَأْسَہُ فَقَرَأَ ، وَأَوْمَأَ أَنْ لاَّ تَرْکَعُوا ، وَافْتَتَحَ الْقِرَائَۃَ بِـ (الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ)۔","","Musannaf Ibn Abi Shaybah 4035","","","كتاب الصلوات"
"4036","(۴۰۳۶) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا رَکَعْتَ فَرَفَعْتَ رَأْسَک ، فَاقْرَأْ إِنْ شِئْتَ بَعْدَ مَا تَرْفَعُ رَأْسَک ، ثُمَّ ارْکَعْ ، وَإنْ شِئْت فَاسْجُدْ کَمَا أَنْتَ۔","","Musannaf Ibn Abi Shaybah 4036","","","كتاب الصلوات"
"4037","(۴۰۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ دَاوُدَ بْنِ قَیْسٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، قَالَ : کَانَ الْمَسْجِدُ یُرَشُّ وَیُقَمُّ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبِی بَکْرٍ۔ (بخاری ۴۵۸۔ ابوداؤد ۳۱۹۵)","","Musannaf Ibn Abi Shaybah 4037","","","كتاب الصلوات"
"4038","(۴۰۳۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا کَثِیرُ بْنُ زَیْدٍ ، عَنِ الْمُطَّلِبِ بْنِ عَبْدِ اللہِ بْنِ حَنْطَبٍ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَتَی مَسْجِدَ قُبَائَ عَلَی فَرَسٍ لَہُ فَصَلَّی فِیہِ ، ثُمَّ قَالَ : یَا یَرْفَأُ ، ائتنی بِجَرِیدَۃٍ ، قَالَ : فَأَتَاہُ بِجَرِیدَۃٍ ، فَاحْتَجَزَ عُمَرُ بِثَوْبِہِ ، ثُمَّ کَنَسَہُ۔","","Musannaf Ibn Abi Shaybah 4038","","","كتاب الصلوات"
"4039","(۴۰۳۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو عَاصِمٍ الثَّقَفِیُّ ، قَالَ : کُنْتُ مَعَ الشَّعْبِیِّ فِی الْمَسْجِدِ ، فَجَعَلَ یَتَطَأْطَأُ ، فَقُلْتُ : مَا تَصْنَعُ یَا أَبَا عَمْرٍو ؟ قَالَ : أَلْتَقِطُ الْقَصَبَۃَ وَالْخَشَاشَۃَ وَالشَّیْئَ مِنَ الْمَسْجِدِ ، قَالَ : وَکَانَ أَبُو عَاصِمٍ مَکْفُوفًا۔","","Musannaf Ibn Abi Shaybah 4039","","","كتاب الصلوات"
"4040","(۴۰۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ ، قَالَ : رَأَیْتُ سَالِمًا کَنَسَ مَکَانًا ، ثُمَّ صَلَّی فِیہِ۔","","Musannaf Ibn Abi Shaybah 4040","","","كتاب الصلوات"
"4041","(۴۰۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ یَعْقُوبَ بْنِ زَیْدٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَتْبَعُ غُبَارَ الْمَسْجِدِ بِجَرِیدَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 4041","","","كتاب الصلوات"
"4042","(۴۰۴۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی عَلَی خُمْرَۃٍ۔ (ترمذی ۳۳۱۔ احمد ۱/۳۵۸)","","Musannaf Ibn Abi Shaybah 4042","","","كتاب الصلوات"
"4043","(۴۰۴۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، وَعَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، قَالَ : أَخْبَرَتْنِی مَیْمُونَۃُ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی عَلَی الْخُمْرَۃِ۔ (بخاری ۳۳۳۔ ابوداؤد ۶۵۶)","Sahih","Musannaf Ibn Abi Shaybah 4043","","","كتاب الصلوات"
"4044","(۴۰۴۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ أَبِی سَعِیدٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی عَلَی حَصِیرٍ۔ (مسلم ۲۷۱۔ احمد ۳/۱۰)","Hasan","Musannaf Ibn Abi Shaybah 4044","","","كتاب الصلوات"
"4045","(۴۰۴۵) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، عَنْ أُمِّ سُلَیْمٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی فِی بَیْتِہَا عَلَی الْخُمْرَۃِ۔ (نسائی ۸۱۶۔ احمد ۶/۳۷۷)","","Musannaf Ibn Abi Shaybah 4045","","","كتاب الصلوات"
"4046","(۴۰۴۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أُمِّ کُلْثُومٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی عَلَی الْخُمْرَۃِ۔ (احمد ۶/۳۰۲۔ ابو یعلی ۶۸۸۴)","","Musannaf Ibn Abi Shaybah 4046","","","كتاب الصلوات"
"4047","(۴۰۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنِ الأَزْرَقِ بْنِ قَیْسٍ ، عَنْ ذَکْوَانَ ، عَنْ عَائِشَۃَ ؛أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی عَلَی الْخُمْرَۃِ۔ (احمد ۶/۲۰۹۔ طیالسی ۱۵۴۴)","Sahih","Musannaf Ibn Abi Shaybah 4047","","","كتاب الصلوات"
"4048","(۴۰۴۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ الْمُنْذِرِ بْنِ الْجَارُودِ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : صَنَعَ بَعْضُ عُمُومَتِی لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ طَعَامًا ، فَقَالَ : إنِّی أُحِبُّ أَنْ تَأْکُلَ فِی بَیْتِی وَتُصَلِّیَ فِیہِ ، قَالَ : فَأَتَاہُ وَفِی الْبَیْتِ فَحْلٌ مِنْ تِلْکَ الْفُحُولِ ، فَأَمَرَ بِجَانِبٍ مِنْہُ فَکُنِسَ وَرُشَّ ، فَصَلَّی وَصَلَّیْنَا مَعَہُ۔ (احمد ۳/۱۱۲۔ ابو یعلی ۴۲۲۷)","Sahih","Musannaf Ibn Abi Shaybah 4048","","","كتاب الصلوات"
"4049","(۴۰۴۹) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ کَانَ یُصَلِّی عَلَی الْخُمْرَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 4049","","","كتاب الصلوات"
"4050","(۴۰۵۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُمَرُ بْنُ ذَرٍّ ، عَنْ یَزِیدَ الْفَقِیرِ ، قَالَ : رَأَیْتُ جَابِرَ بْنَ عَبْدِ اللہِ یُصَلِّی عَلَی حَصِیرٍ مِنْ بَرْدِیٍّ۔","Sahih","Musannaf Ibn Abi Shaybah 4050","","","كتاب الصلوات"
"4051","(۴۰۵۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْعُمَرِیُّ ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللہِ بْنِ أَبِی طَلْحَۃَ ، عَنْ أَنَسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی عَلَی حَصِیرٍ۔ (بخاری ۳۸۰۔ ابوداؤد ۶۱۲)","Da'if","Musannaf Ibn Abi Shaybah 4051","","","كتاب الصلوات"
"4052","(۴۰۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ الْغَازِ ، عَنْ مَکْحُولٍ ، قَالَ : رَأَیْتُہُ یُصَلِّی عَلَی الْحَصِیرِ ، وَیَسْجُدُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 4052","","","كتاب الصلوات"
"4053","(۴۰۵۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ صَفْوَانَ ، عَنْ عَطَائِ بْنِ أَبِی مَرْوَانَ ، عَنْ أَبِیہِ ، عَنْ أَبِی ذَرٍّ ؛ أَنَّہُ کَانَ یُصَلِّی عَلَی الْخُمْرَۃِ۔","","Musannaf Ibn Abi Shaybah 4053","","","كتاب الصلوات"
"4054","(۴۰۵۴) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ ثَابِتِ بْنِ عُبَیْدِ اللہِ ، قَالَ : رَأَیْتُ زَیْدَ بْنَ ثَابِتٍ یُصَلِّی عَلَی حَصِیرٍ یَسْجُدُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 4054","","","كتاب الصلوات"
"4055","(۴۰۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، قَالَ : أَخْبَرَنِی مَنْ رَأَی زَیْدَ بْنَ ثَابِتٍ یُصَلِّی عَلَی حَصِیرٍ۔","Majhul","Musannaf Ibn Abi Shaybah 4055","","","كتاب الصلوات"
"4056","(۴۰۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ تَوْبَۃَ الْعَنْبَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُصَلِّی عَلَی حَصِیرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 4056","","","كتاب الصلوات"
"4057","(۴۰۵۷) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : الصَّلاَۃُ عَلَی الْخُمْرَۃِ سُنَّۃٌ۔","","Musannaf Ibn Abi Shaybah 4057","","","كتاب الصلوات"
"4058","(۴۰۵۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِد ، عَنْ عَامِرٍ ، قَالَ : صَلَّیْت مَعَ ابْنِ عَبَّاسٍ فِی بَیْتِہِ عَلَی مِسْحٍ یَسْجُدُ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 4058","","","كتاب الصلوات"
"4059","(۴۰۵۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عِیسَی بْنِ سِنَانٍ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یُصَلِّی عَلَی مِسْحٍ۔","","Musannaf Ibn Abi Shaybah 4059","","","كتاب الصلوات"
"4060","(۴۰۶۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُجَالِد ، عَنْ عَامِرٍ ، عَنْ جَابِرٍ ؛ أَنَّہُ صَلَّی عَلَی مِسْحٍ۔","Da'if","Musannaf Ibn Abi Shaybah 4060","","","كتاب الصلوات"
"4061","(۴۰۶۱) حَدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنْ أَبِیہِ ، عَنْ رَجُلٍ مِنْ بَکْرِ بْنِ وَائِلٍ ، قَالَ : رَأَیْتُ عَلِیًّا یُصَلِّی عَلَی مُصَلًّی مِنْ مُسُوحٍ ، یَرْکَعُ عَلَیْہِ وَیَسْجُدُ۔","Majhul","Musannaf Ibn Abi Shaybah 4061","","","كتاب الصلوات"
"4062","(۴۰۶۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَحْوَصِ بْنِ حَکِیمٍ ، عَنْ أَبِی الزَّاہِرِیَّۃِ ، عَنْ جُبَیْرِ بْنِ نُفَیْرٍ ؛ أَنَّ أَبَا الدَّرْدَائِ کَانَ یُصَلِّی عَلَی مِسْحٍ یَسْجُدُ عَلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4062","","","كتاب الصلوات"
"4063","(۴۰۶۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ وَأَصْحَابِہِ ؛ أَنَّہُمْ کَانُوا یَکْرَہُونَ أَنْ یُصَلُّوا عَلَی الطَّنَافِسِ وَالْفِرَائِ وَالْمُسُوحِ۔","","Musannaf Ibn Abi Shaybah 4063","","","كتاب الصلوات"
"4064","(۴۰۶۴) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ صَالِحِ بْنِ حَیَّانَ ، عَنْ شَقِیقِ بْنِ سَلَمَۃَ ، قَالَ : صَلَّیْت مَعَ ابْنِ مَسْعُودٍ عَلَی مِسْحٍ ، فَکَانَ یَسْجُدُ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 4064","","","كتاب الصلوات"
"4065","(۴۰۶۵) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی التَّیَّاحِ الضُّبَعِیِّ ، قَالَ : سَمِعْتُ أَنَسَ بْنَ مَالِکٍ ، یَقُولُ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُخَالِطُنَا ، فَیَقُولُ لإِخٍ لِی : یَا أَبَا عُمَیْرٍ ، مَا فَعَلَ النُّغَیْرُ ، قَالَ : وَنَضَحَ بِسَاطًا لَنَا فَصَلَّی عَلَیْہِ۔ (بخاری ۶۱۲۹۔ مسلم ۱۶۹۲)","Sahih","Musannaf Ibn Abi Shaybah 4065","","","كتاب الصلوات"
"4066","(۴۰۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ زَمْعَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، وَسَلَمَۃَ بْنِ وَہْرَام ، قَالَ أَحَدُہُمَا : عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی عَلَی بِسَاطٍ۔ (احمد ۲۳۲۔ حاکم ۲۵۹)","Da'if","Musannaf Ibn Abi Shaybah 4066","","","كتاب الصلوات"
"4067","(۴۰۶۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، وَعِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عُثْمَانَ بْنِ أَبِی سَوْدَۃَ ، عَنْ خُلَیْدٍ ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ : مَا أُبَالِی لَوْ صَلَّیْت عَلَی سِتِّ طَنَافِسَ بَعْضُہَا فَوْقَ بَعْضٍ۔","Sahih","Musannaf Ibn Abi Shaybah 4067","","","كتاب الصلوات"
"4068","(۴۰۶۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الأَعْمَش ، عَنْ سَعِیدِ بْنِ جُبَرٍن ، قَالَ : صَلَّی بِنَا ابْنُ عَبَّاسٍ عَلَی طُنْفُسَۃٍ قَدْ طَبَقَتِ الْبَیْتَ صَلاَۃَ الْمَغْرِبِ۔","Sahih","Musannaf Ibn Abi Shaybah 4068","","","كتاب الصلوات"
"4069","(۴۰۶۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، قَالَ : شَہِدْت مُحِلاًّ یَقُولُ لإِبْرَاہِیمَ : إنِّی رَأَیْت أَبَا وَائِلٍ یُصَلِّی عَلَی طُنْفُسَۃٍ ، فَقَالَ إبْرَاہِیمُ : کَانَ أَبُو وَائِلٍ خَیْرًا مِنِّی۔","","Musannaf Ibn Abi Shaybah 4069","","","كتاب الصلوات"
"4070","(۴۰۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ تَوْبَۃَ الْعَنْبَرِیِّ ، عَنْ عِکْرِمَۃَ بْنِ خَالِدٍ الْمَخْزُومِیِّ ، عَنْ عَبْدِ اللہِ بْنِ عَمَّارٍ، قَالَ : رَأَیْتُ عُمَرَ یُصَلِّی عَلَی عَبْقَرِیٍّ۔","Majhul","Musannaf Ibn Abi Shaybah 4070","","","كتاب الصلوات"
"4071","(۴۰۷۱) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، قَالَ : رَأَیْتُ عَطَائً یُصَلِّی عَلَی بِسَاطٍ أَبْیَضَ فِی الْمَسْجِدِ الْحَرَامِ ، وَلَیْسَ بَیْنَہُ وَبَیْنَ الطَّوَافِ أَحَدٌ۔","","Musannaf Ibn Abi Shaybah 4071","","","كتاب الصلوات"
"4072","(۴۰۷۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِالصَّلاَۃِ عَلَی الطُّنْفُسَۃِ۔","","Musannaf Ibn Abi Shaybah 4072","","","كتاب الصلوات"
"4073","(۴۰۷۳) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنِ الرَّبِیعِ بْنِ الْمُنْذِرِ ، عَنْ عَبْدِ الْمَلِکِ بْنِ سَعِیدٍ ، قَالَ : رَأَیْتُ أَبِی سَعِیدَ بْنَ جُبَیْرٍ یُصَلِّی عَلَی بِسَاطٍ یَسْجُدُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 4073","","","كتاب الصلوات"
"4074","(۴۰۷۴) حَدَّثَنَا بِشْرُ بْنُ مُفَضَّلٍ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ إذَا صَلَّی عَلَی شَیْئٍ سَجَد عَلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4074","","","كتاب الصلوات"
"4075","(۴۰۷۵) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، عَنْ شُعْبَۃَ ، عَنْ تَوْبَۃَ الْعَنْبَرِیِّ ، قَالَ : سَمِعْتُ بَکْرَ بْنَ عَبْدِ اللہِ الْمُزَنِیّ یَقُولُ : إنَّ قَیْسَ بْنَ عُبَادٍ الْقَیْسِیَّ صَلَّی عَلَی لِبْدِ دَابَّتِہِ۔","","Musannaf Ibn Abi Shaybah 4075","","","كتاب الصلوات"
"4076","(۴۰۷۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، قَالَ ، رَأَیْت مُرَّۃً الْہَمْدَانِیَّ یُصَلِّی عَلَی لِبْدٍ۔","","Musannaf Ibn Abi Shaybah 4076","","","كتاب الصلوات"
"4077","(۴۰۷۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یُصَلِّی عَلَی طُنْفُسَۃٍ قَدَمَاہُ وَرُکْبَتَاہُ عَلَیْہَا ، وَیَدَاہُ وَوَجْہُہُ عَلَی الأَرْضِ ، أَوْ عَلَی بُورِیٍّ۔","","Musannaf Ibn Abi Shaybah 4077","","","كتاب الصلوات"
"4078","(۴۰۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، قَالَ : أَخْبَرَنَا مَنْ رَأَی إبْرَاہِیمَ وَالْحَسَنَ یُصَلِّیَانِ عَلَی بِسَاطٍ فِیہِ تَصَاوِیرُ۔","","Musannaf Ibn Abi Shaybah 4078","","","كتاب الصلوات"
"4079","(۴۰۷۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : الصَّلاَۃُ عَلَی الطُّنْفُسَۃِ مُحْدَثٌ۔","","Musannaf Ibn Abi Shaybah 4079","","","كتاب الصلوات"
"4080","(۴۰۸۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : الصَّلاَۃُ عَلَی الطُّنْفُسَۃِ مُحْدَثٌ۔","","Musannaf Ibn Abi Shaybah 4080","","","كتاب الصلوات"
"4081","(۴۰۸۱) حَدَّثَنَا زِیَادُ بْنُ الرَّبِیعِ ، عَنْ صَالِحٍ الدَّہَان ؛ أَنَّ جَابِرَ بْنَ زَیْدٍ کَانَ یَکْرَہُ الصَّلاَۃَ عَلَی کُلِّ شَیْئٍ مِنَ الْحَیَوَانِ ، وَیَسْتَحِبُّ الصَّلاَۃَ عَلَی کُلِّ شَیْئٍ مِنْ نَبَاتِ الأَرْضِ۔","","Musannaf Ibn Abi Shaybah 4081","","","كتاب الصلوات"
"4082","(۴۰۸۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : کَانَ عَبْدُ اللہِ لاَ یُصَلِّی ، وَلاَ یَسْجُدُ إِلاَّ عَلَی الأَرْضِ۔","","Musannaf Ibn Abi Shaybah 4082","","","كتاب الصلوات"
"4083","(۴۰۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مَعْقِلِ بْنِ عُبَیْدِ اللہِ ، عَنْ عَبْدِ الْکَرِیمِ الْجَزَرِیِّ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ بَأْسَ بِالصَّلاَۃِ عَلَی الأَرْضِ وَعَلَی مَا أَنْبَتَتْ۔","","Musannaf Ibn Abi Shaybah 4083","","","كتاب الصلوات"
"4084","(۴۰۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ وَحُصَیْنٍ ، قَالَ سُفْیَانُ : أَوْ أَحَدُہُمَا ، عَنْ أَبِی حَازِمٍ الأَشْجَعِیِّ، عَنْ مَوْلاَتِہِ عَزَّۃَ ، قَالَتْ : سَمِعْت أَبَا بَکْرٍ یَنْہَی عَنِ الصَّلاَۃِ عَلَی الْبَرَادِعِ۔","Majhul","Musannaf Ibn Abi Shaybah 4084","","","كتاب الصلوات"
"4085","(۴۰۸۵) حَدَّثَنَا حَاتِمٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یُسْجَدَ عَلَی شَیْئٍ دُونَ الأَرْضِ۔","","Musannaf Ibn Abi Shaybah 4085","","","كتاب الصلوات"
"4086","(۴۰۸۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ جَابِرٍ ، قَالَ : خَرَجَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَاتَ لَیْلَۃٍ وَأَصْحَابُہُ یَنْتَظِرُونَہُ لِصَلاَۃِ الْعِشَائِ الآخِرَۃِ ، فَقَالَ : نَامَ النَّاسُ وَرَقَدُوا ، وَأَنْتُمْ تَنْتَظِرُونَ الصَّلاَۃَ ، أَمَا إنَّکُمْ فِی صَلاَۃٍ مَا انْتَظَرْتُمُوہَا ، وَلَوْلاَ ضَعْفُ الضَّعِیفِ وَکِبَرُ الْکَبِیرِ ، لَأَخَّرْتُ ہَذِہِ الصَّلاَۃَ إلَی شَطْرِ اللَّیْلِ۔ (ابو یعلی ۱۹۳۵۔ ابن حبان ۱۵۲۹)","Sahih","Musannaf Ibn Abi Shaybah 4086","","","كتاب الصلوات"
"4087","(۴۰۸۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : مَنْ دَخَلَ الْمَسْجِدَ وَہُوَ عَلَی طُہُورٍ ، لَمْ یَزَلْ عَاکِفًا فِیہِ مَا دَامَ فِیہِ حَتَّی یَخْرُجَ مِنْہُ ، أَوْ یُحْدِثَ۔","","Musannaf Ibn Abi Shaybah 4087","","","كتاب الصلوات"
"4088","(۴۰۸۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ ، إذَا صَلَّی الرَّجُلُ ثُمَّ جَلَسَ فِی مُصَلاَّہُ فَہُوَ فِی صَلاَۃٍ ، وَالْمَلاَئِکَۃُ تُصَلِّی عَلَیْہِ مَا لَمْ یُحْدِثْ فِیہِ ، وَإِذَا جَلَسَ فِی الْمَسْجِدِ فَہُوَ فِی صَلاَۃٍ مَا لَمْ یُحْدِثْ، وَمَا لَمْ یُؤْذِ فِیہِ۔","","Musannaf Ibn Abi Shaybah 4088","","","كتاب الصلوات"
"4089","(۴۰۸۹) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنِ الْحَکَمِ بْنِ أَبَانَ ، عَنْ عِکْرِمَۃَ ، قَالَ : مَا مِنْ رَجُلٍ صَلَّی صَلاَۃً وَیَنْتَظِرُ أُخْرَی ، إِلاَّ قَالَتِ الْمَلاَئِکَۃُ : عَبْدُک فُلاَنٌ اللَّہُمَّ ارْحَمْہُ حَتَّی یُصَلِّیَہَا۔","","Musannaf Ibn Abi Shaybah 4089","","","كتاب الصلوات"
"4090","(۴۰۹۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ زَائِدَۃَ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : إذَا کَانَ الرَّجُلُ جَالِسًا فِی الْمَسْجِدِ یَنْتَظِرُ الصَّلاَۃَ ، فَہُوَ مُعْتَکِفٌ۔","","Musannaf Ibn Abi Shaybah 4090","","","كتاب الصلوات"
"4091","(۴۰۹۱) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ عَیَّاشٍ الْحَضْرَمِیِّ ، قَالَ : أَخْبَرَنَا یَحْیَی بْنُ مَیْمُونٍ قَاضِی مِصْرَ ، قَالَ : حَدَّثَنِی سَہْلُ بْنُ سَعْدٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنِ انْتَظَرَ الصَّلاَۃَ ، فَہُوَ فِی صَلاَۃٍ مَا لَمْ یُحْدِثْ۔ (احمد ۵/۳۳۱۔ ابو یعلی ۷۵۴۶)","Hasan","Musannaf Ibn Abi Shaybah 4091","","","كتاب الصلوات"
"4092","(۴۰۹۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : جَہَّزَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَیْشًا حَتَّی انْتَصَفَ اللَّیْلُ ، أَوْ بَلَغَ ذَلِکَ ، ثُمَّ خَرَجَ إلَیْنَا ، فَقَالَ : صَلَّی النَّاسُ وَرَقَدُوا وَأَنْتُمْ تَنْتَظِرُونَ الصَّلاَۃَ ، أَمَا إنَّکُمْ لَمْ تَزَالُوا فِی صَلاَۃٍ مَا انْتَظَرْتُمُوہَا۔ (احمد ۳/۳۶۷۔ ابو یعلی ۱۹۳۶)","Hasan","Musannaf Ibn Abi Shaybah 4092","","","كتاب الصلوات"
"4093","(۴۰۹۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا دَخَلَ أَحَدُکُمُ الْمَسْجِدَ کَانَ فِی صَلاَۃٍ مَا کَانَتِ الصَّلاَۃُ تَحْبِسُہُ ، وَالْمَلاَئِکَۃُ یُصَلُّونَ عَلَی أَحَدِکُمْ مَا دَامَ فِی مَجْلِسِہِ الَّذِی صَلَّی فِیہِ ، یَقُولُونَ : اللَّہُمَّ اغْفِرْ لَہُ ، اللَّہُمَّ ارْحَمْہُ ، اللَّہُمَّ تُبْ عَلَیْہِ ، مَا لَمْ یُؤْذِ فِیہِ ، مَا لَمْ یُحْدِثْ فِیہِ۔ (بخاری ۴۷۷۔ ابوداؤد ۵۶۰)","Sahih","Musannaf Ibn Abi Shaybah 4093","","","كتاب الصلوات"
"4094","(۴۰۹۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : حدَّثَنَا رَجُلٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إذَا صَلَّی أَحَدُکُمْ فَقَضَی صَلاَتَہُ ، ثُمَّ قَعَدَ فِی مُصَلاَّہُ یَذْکُرُ اللَّہَ فَہُوَ فِی صَلاَۃٍ ، وَإِنَّ الْمَلاَئِکَۃَ یُصَلُّونَ عَلَیْہِ ، یَقُولُونَ : اللَّہُمَّ ارْحَمْہُ وَاغْفِرْ لَہُ ، وَإِنْ ہُوَ دَخَلَ مُصَلاَّہُ یَنْتَظِرُ کَانَ مِثْلَ ذَلِکَ۔ (ابن سعد ۱۷۴)","Da'if","Musannaf Ibn Abi Shaybah 4094","","","كتاب الصلوات"
"4095","(۴۰۹۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : احْتَبَسَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ أَصْحَابِہِ فِی صَلاَۃِ الْعِشَائِ ، حَتَّی بَقِیَ ثُلُثُ اللَّیْلِ ، فَأَتَاہُمْ وَبَعْضُہُمْ قَائِمٌ ، وَبَعْضُہُمْ قَاعِدٌ ، وَبَعْضُہُمْ مُضْطَجِعٌ ، فَقَالَ : مَا زِلْتُمْ فِی صَلاَۃٍ مُنْذُ انْتَظَرْتُمُوہَا ، قَائِمُکُمْ وَقَاعِدُکُمْ وَمُضْطَجِعُکُمْ۔","","Musannaf Ibn Abi Shaybah 4095","","","كتاب الصلوات"
"4096","(۴۰۹۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : لاَ یَزَالُ أَحَدُکُمْ فِی صَلاَۃٍ مَا دَامَتِ الصَّلاَۃُ تَحْبِسُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4096","","","كتاب الصلوات"
"4097","(۴۰۹۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حُمَیْدٌ ، عَنْ أَنَسٍ ، قَالَ : أَخَّرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَاتَ لَیْلَۃٍ الصَّلاَۃَ إلَی شَطْرِ اللَّیْلِ ، فَجَعَلَ النَّاسُ یُصَلُّونَ وَیَنْکَفِئُونَ ، فَخَرَجَ وَقَدْ بَقِیَتْ عِصَابَۃٌ فَصَلَّی بِہِمْ ، فَلَمَّا سَلَّمَ أَقْبَلَ عَلَیْہِم بِوَجْہِہِ ، فَقَالَ : إنَّ النَّاسَ قَدْ صَلَّوْا وَرَقَدُوا ، وَإِنَّکُمْ لَمْ تَزَالُوا فِی صَلاَۃٍ مُنْذُ انْتَظَرْتُمُ الصَّلاَۃَ ، قَالَ : فَکَأَنِّی أَنْظُرُ إلَی وَبِیصِ خَاتَمِہِ فِی یَدِہِ۔ (بخاری ۸۴۷۔ مسلم ۲۲۲)","Sahih","Musannaf Ibn Abi Shaybah 4097","","","كتاب الصلوات"
"4098","(۴۰۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ صَدَقَۃَ بْنِ یَسَارٍ ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : کَانُوا یُشَبِّہُونَ صَلاَۃَ الْہَجِیرِ بِصَلاَۃٍ فِی جَوْفِ اللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 4098","","","كتاب الصلوات"
"4099","(۴۰۹۹) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ، عَنْ أَنَسٍ ، قَالَ : صَلُّوا صَلاَۃَ الْہَجِیرِ ، فَإِنَّا کُنَّا نَسْتَحِبّہَا۔","Sahih","Musannaf Ibn Abi Shaybah 4099","","","كتاب الصلوات"
"4100","(۴۱۰۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ، قَالَ : صَلُّوا صَلاَۃَ الأَصَالِ حِینَ یَفِیئَ الْفَیئُ عِنْدَ النِّدَائِ بِالظُّہْرِ ، مَنْ صَلاَّہَا فَکَأَنَّمَا تَہَجَّدَ بِاللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 4100","","","كتاب الصلوات"
"4101","(۴۱۰۱) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنْ ہَارُونَ بْنِ عَنْتَرَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِہِم ، قَالَ : أَصَبْت أَنَا وَعَلْقَمَۃُ صَحِیفَۃً ، فَانْطَلَقْنَا بِہَا إلَی عَبْدِ اللہِ ، فَجَلَسْنَا بِالْبَابِ وَقَدْ زَالَتِ الشَّمْسُ ، أَوْ کَادَتْ تَزُولُ ، فَاسْتَیْقَظَ وَأَرْسَلَ الْجَارِیَۃَ ، فَقَالَ : اُنْظُرِی مَنْ بِالْبَابِ ، فَرَجَعَتْ إلَیْہِ ، فَقَالَتْ : عَلْقَمَۃُ وَالأَسْوَدُ ، فَقَالاَ : ائْذَنِی لَہُمَا ، فَدَخَلْنَا ، فَقَالَ : کَأَنَّکُمَا قَدْ أَطَلْتُمَا الْجُلُوسَ بِالْبَابِ ؟ قَالاَ : أَجَلْ ، قَالَ : فَمَا مَنَعَکُمَا أَنْ تَسْتَأْذِنَا ؟ قَالاَ: خَشِینَا أَنْ تَکُونَ نَائِمًا ، قَالَ : مَا کُنْت أُحِبُّ أَنْ تَظُنُّوا بِی ہَذَا ، إنَّ ہَذِہِ سَاعَۃٌ کُنَّا نُشَبِّہُہَا بِصَلاَۃِ اللَّیْلِ۔","Sahih","Musannaf Ibn Abi Shaybah 4101","","","كتاب الصلوات"
"4102","(۴۱۰۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : صَلاَۃُ الأَوَّابِینَ بَعْدَ زَوَالِ الشَّمْسِ۔","","Musannaf Ibn Abi Shaybah 4102","","","كتاب الصلوات"
"4103","(۴۱۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ یُونُسَ بْنِ الْحَارِثِ ، عَنْ أَبِی عَوْنٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی عَلَی فَرْوَۃٍ مَدْبُوغَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 4103","","","كتاب الصلوات"
"4104","(۴۱۰۴) حَدَّثَنَا حَفْصٌ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ؛ أَنَّہُ کَانَ یَدْبُغُ جِلْدَ أُضْحِیَّتِہِ ، فَیَتَّخِذَہُ مُصَلًّی یُصَلِّی عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 4104","","","كتاب الصلوات"
"4105","(۴۱۰۵) حَدَّثَنَا حَفْصٌ ، عَنْ ہِشَامِ بْنِ یَزِیدَ ، عَنْ إسْمَاعِیلَ بْنِ رَجَائٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ؛ أَنَّہُ کَانَ یَدْبُغُ جِلْدَ أُضْحِیَّتِہِ ، فَیَتَّخِذُہُ مُصَلًّی یُصَلِّی عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 4105","","","كتاب الصلوات"
"4106","(۴۱۰۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ وَأَصْحَابِہِ ؛ أَنَّہُمَا کَانُوا یَکْرَہُونَ أَنْ یُصَلُّوا عَلَی الْفِرَائِ۔","","Musannaf Ibn Abi Shaybah 4106","","","كتاب الصلوات"
"4107","(۴۱۰۷) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِلاَلِ بْنِ خَبَّابٍ ، قَالَ : دَخَلْتُ عَلَی عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ بِالْمَدَائِنِ وَہُوَ یُصَلِّی فِی بَیْتِہِ عَلَی جِلْدِ فَرْوِ ضَأْنٍ ، الصُّوفُ ظَاہِرٌ یَلِی قَدَمَیْہِ۔","","Musannaf Ibn Abi Shaybah 4107","","","كتاب الصلوات"
"4108","(۴۱۰۸) حَدَّثَنَا شَرِیکٌ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، قَالَ : کَانَ سُوَیْد بْنُ غَفَلَۃَ یُکَبِّرُ إذَا قَالَ الْمُؤَذِّنُ قَدْ قَامَتِ الصَّلاَۃُ۔","","Musannaf Ibn Abi Shaybah 4108","","","كتاب الصلوات"
"4109","(۴۱۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ قَیْسٍ ؛ أَنَّہُ کَانَ یُکَبِّرُ إذَا قَالَ الْمُؤَذِّنُ قَدْ قَامَتِ الصَّلاَۃُ ، یَعْنِی فِی الأُولَی۔","","Musannaf Ibn Abi Shaybah 4109","","","كتاب الصلوات"
"4110","(۴۱۱۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إِنْ کُنْت لأَسْمَعُ الْمُؤَذِّنَ یُصَوِّتُ بَعْدَ مَا یُکَبِّرُ إبْرَاہِیمُ لِلصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 4110","","","كتاب الصلوات"
"4111","(۴۱۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إِنْ شَائَ کَبَّرَ إذَا قَالَ قَدْ قَامَتِ الصَّلاَۃُ ، وَإِنْ شَائَ انْتَظَرَ حَتَّی یَفْرُغَ۔","","Musannaf Ibn Abi Shaybah 4111","","","كتاب الصلوات"
"4112","(۴۱۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحِلٍّ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُکَبِّرُ إذَا قَالَ الْمُؤَذِّنُ قَدْ قَامَتِ الصَّلاَۃُ فِی الثَّانِیَۃِ۔","","Musannaf Ibn Abi Shaybah 4112","","","كتاب الصلوات"
"4113","(۴۱۱۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ، کَرِہَ أَنْ یَقُومَ الإِمَامُ حَتَّی یَقُولَ الْمُؤَذِّنُ قَدْ قَامَتِ الصَّلاَۃُ، وَکَرِہَ أَنْ یُکَبِّرَ حَتَّی یَفْرُغَ الْمُؤَذِّنُ مِنْ إقَامَتِہِ۔","","Musannaf Ibn Abi Shaybah 4113","","","كتاب الصلوات"
"4114","(۴۱۱۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ إذَا قَالَ الْمُؤَذِّنُ حَیَّ عَلَی الصَّلاَۃِ قامَ ، فَإذَا قَالَ قَدْ قَامَتِ الصَّلاَۃُ کَبَّرَ۔","","Musannaf Ibn Abi Shaybah 4114","","","كتاب الصلوات"
"4115","(۴۱۱۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ یَحْیَی بْنِ وَثَّابٍ ، قَالَ : کَانَ یَسْکُتُ حَتَّی یَفْرُغَ الْمُؤَذِّنُ ، ثُمَّ یُکَبِّرَ ۔ وَکَانَ إبْرَاہِیمُ یَقُولُ إذَا قَامَتِ الصَّلاَۃُ کَبَّرَ۔","","Musannaf Ibn Abi Shaybah 4115","","","كتاب الصلوات"
"4116","(۴۱۱۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ مَعْمَرٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی قَتَادَۃَ ، عَنْ أَبِیہِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إذَا أُقِیمَتِ الصَّلاَۃُ فَلاَ تَقُومُوا حَتَّی تَرَوْنِی۔ (بخاری ۶۳۷۔ مسلم ۱۵۶)","Sahih","Musannaf Ibn Abi Shaybah 4116","","","كتاب الصلوات"
"4117","(۴۱۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ فِطْرٍ ، عَنْ زَائِدَۃَ بْنِ نَشِیطٍ ، عَنْ أَبِی خَالِدٍ الْوَالِبِیِّ ، قَالَ : خَرَجَ عَلِیٌّ وَقَدْ أُقِیمَتِ الصَّلاَۃُ وَہُمْ قِیَامٌ یَنْتَظِرُونَہُ ، فَقَالَ : مَا لِی أَرَاکُمْ سَامِدِینَ ؟۔","Hasan","Musannaf Ibn Abi Shaybah 4117","","","كتاب الصلوات"
"4118","(۴۱۱۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَقُومَ الرَّجُلُ إذَا قَالَ الْمُؤَذِّنُ قَدْ قَامَتِ الصَّلاَۃُ ، وَلَیْسَ عِنْدَہُمُ الإِمَامُ ، وَکَانُوا یَکْرَہُونَ أَنْ یَنْتَظِرُوا الإِمَامَ قِیَامًا، وَکَانَ یُقَالُ: ہُوَ السَّمُودُ۔","","Musannaf Ibn Abi Shaybah 4118","","","كتاب الصلوات"
"4119","(۴۱۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : الْقَوْمُ یَنْتَظِرُونَ الإِمَامَ قِیَامًا ، أَوْ قُعُودًا ؟ قَالَ : لاَ ، بَلْ قُعُودًا۔","","Musannaf Ibn Abi Shaybah 4119","","","كتاب الصلوات"
"4120","(۴۱۲۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الْقَوْمِ یَنْتَظِرُونَ الإِمَامَ قِیَامًا ، قَالَ : ذَلِکَ السَّمُودُ۔","","Musannaf Ibn Abi Shaybah 4120","","","كتاب الصلوات"
"4121","(۴۱۲۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ أَبِی عُبَیْدٍ ، قَالَ : سَمِعْتُہُ یَقُولُ : سَمِعْت عُمَرَ بْنَ عَبْدِ الْعَزِیزِ بِخَنَاصِرَۃَ یَقُولُ حِینَ یَقُولُ الْمُؤَذِّنُ قَدْ قَامَتِ الصَّلاَۃُ : قُومُوا ، قَدْ قَامَتِ الصَّلاَۃُ۔","","Musannaf Ibn Abi Shaybah 4121","","","كتاب الصلوات"
"4122","(۴۱۲۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَرِہَ أَنْ یَقُومَ الإِمَامُ حَتَّی یَقُولَ الْمُؤَذِّنُ قَدْ قَامَتِ الصَّلاَۃُ۔","","Musannaf Ibn Abi Shaybah 4122","","","كتاب الصلوات"
"4123","(۴۱۲۳) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، قَالَ : رَأَی عُبَیْدُ اللہِ بْنُ أَبِی یَزِیدَ حُسَیْنَ بْنَ عَلِیٍّ فِی حَوْضِ زَمْزَمَ ، وَقَدْ أُقِیمَتِ الصَّلاَۃُ ، فَشَجر بَیْنَ الإِمَامِ وَبَعْضِ النَّاسِ شَیْئٌ ، وَنَادَی الْمُنَادِی : قَدْ قَامَتِ الصَّلاَۃُ ، فَجَعَلُوا یَقُولُونَ لَہُ : اجْلِسْ ، فَیَقُولُ : قَدْ قَامَتِ الصَّلاَۃُ ۔","","Musannaf Ibn Abi Shaybah 4123","","","كتاب الصلوات"
"4124","(۴۱۲۴) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ جَابِرِ بْنِ یَزِیدَ بْنِ مُرَّۃَ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : إذَا دَخَلَ الرَّجُلُ وَالْمُؤَذِّنُ یُقِیمُ الصَّلاَۃَ ، قَالَ : لِیَقُمْ کَمَا ہُوَ إِنْ شَائَ ، فَإِنَّ ذَلِکَ یُرْفِقُ بِالرَّجُلِ الْکَبِیرِ ، وَقَالَ عَامِرٌ: لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 4124","","","كتاب الصلوات"
"4125","(۴۱۲۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : بَلَغَنِی أَنَّ إبْرَاہِیمَ انْتَہَی إلَی الْمَسْجِدِ وَقَدْ أَخَذَ الْمُؤَذِّنُ فِی الإِقَامَۃِ ، فَوَضَعَ رِجْلَہُ بَیْنَ الظُّلَّۃِ وَالصَّحْنِ حَتَّی فَرَغَ مِنَ الإِقَامَۃِ۔","","Musannaf Ibn Abi Shaybah 4125","","","كتاب الصلوات"
"4126","(۴۱۲۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، قَالَ : قَالَ سُوَیْد : لَوِ اسْتَطَعْتُ لَکُنْت أُؤَذِّنُ لَہُمْ وَأَؤُمُّہُمْ ، قَالَ : فَذَکَرْت ذَلِکَ لِمُصْعَبِ بْنِ سَعْدٍ ، فَقَالَ : أَمَا إنَّ ذَلِکَ لَیْسَ مِنَ السُّنَّۃِ أَنْ یَکُونَ مُؤَذِّنًا وَإِمَامًا۔","","Musannaf Ibn Abi Shaybah 4126","","","كتاب الصلوات"
"4127","(۴۱۲۷) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی رَوَّادٍ ، عَنْ أَصْبَغَ ، قَالَ : کَانَ ابْنُ عُمَرَ یُؤَذِّنُ لَنَا وَیَؤُمُّنَا فِی السَّفَرِ۔","Sahih","Musannaf Ibn Abi Shaybah 4127","","","كتاب الصلوات"
"4128","(۴۱۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ ضِرَارِ بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی الْہُذَیْلِ الْعَنَزِیِّ ، قَالَ : قَالَ عُمَرُ: لَوْلاَ أَنْ یَکُونَ سُنَّۃً لأَذَّنْتُ۔","Sahih","Musannaf Ibn Abi Shaybah 4128","","","كتاب الصلوات"
"4129","(۴۱۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، قَالَ : قیلَ لِلأَسْوَدِ بْنِ ہِلاَلٍ : تَقَدَّمْ ، فَقَالَ : أَرَاضُونَ أَنْتُمْ ؟","","Musannaf Ibn Abi Shaybah 4129","","","كتاب الصلوات"
"4130","(۴۱۳۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُوسَی بْنُ قَیْسٍ الْحَضْرَمِیُّ ، عَنِ الْعَیْزَارِ بْنِ جَرْوَلٍ ؛ أَنَّ قَوْمًا شَکَوْا إمَامًا لَہُمْ إلَی عَلِیٍّ ، فَقَالَ لَہُ عَلِیٌّ : إنَّک لَخَرُوطٌ ، تَؤُمُّ قَوْمًا وَہُمْ کَارِہُونَ۔","Hasan","Musannaf Ibn Abi Shaybah 4130","","","كتاب الصلوات"
"4131","(۴۱۳۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو عُبَیْدَۃَ النَّاجِی ، عَنِ الْحَسَنِ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ أَمَّ قَوْمًا وَہُمْ لَہُ کَارِہُونَ ، لَمْ تَجُزْ صَلاَتُہُ تَرْقُوَتَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 4131","","","كتاب الصلوات"
"4132","(۴۱۳۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنِ الْمِنْہَالِ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، قَالَ : ثَلاَثَۃٌ لاَ تُجَاوِزُ صَلاَۃُ أَحَدِہِمْ رَأْسَہُ ؛ إمَامُ قَوْمٍ وَہُمْ لَہُ کَارِہُونَ ، وَامْرَأَۃٌ تَعْصِی زَوْجَہَا ، وَعَبْدٌ أَبَقَ مِنْ سَیِّدِہِ۔","","Musannaf Ibn Abi Shaybah 4132","","","كتاب الصلوات"
"4133","(۴۱۳۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ زِیَادِ بْنِ أَبِی الْجَعْدِ ، عَنْ عَمْرِو بْنِ الْحَارِثِ بْنِ الْمُصْطَلِقِ، قَالَ: کَانَ یُقَالُ: أَشَدُّ النَّاسِ عَذَابًا؛ امْرَأَۃٌ تَعْصِی زَوْجَہَا، وَإِمَامُ قَوْمٍ وَہُمْ لَہُ کَارِہُونَ۔(ترمذی ۳۵۹)","Majhul","Musannaf Ibn Abi Shaybah 4133","","","كتاب الصلوات"
"4134","(۴۱۳۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ہِشَامُ بْنُ حَسَّانَ ، قَالَ : حَدَّثَنَا الْحَسَنُ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : ثَلاَثَۃٌ لاَ تُقْبَلُ لَہُمْ صَلاَۃٌ ؛ رَجُلٌ أَمَّ قَوْمًا وَہُمْ لَہُ کَارِہُونَ ، وَالْعَبْدُ إذَا أَبَقَ حَتَّی یَرْجِعَ إلَی مَوْلاَہُ ، وَامْرَأَۃٌ إذَا بَاتَتْ مُہَاجِرَۃً لِزَوْجِہَا ، عَاصِیَۃً لَہُ۔ (ابن ماجہ ۹۷۱)","","Musannaf Ibn Abi Shaybah 4134","","","كتاب الصلوات"
"4135","(۴۱۳۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، قَالَ : سَمِعْتُ الْقَاسِمَ بْنَ مُخَیْمِرَۃَ یَذْکُرُ ؛ أَنَّ سَلْمَانَ قَدَّمَہُ قَوْمٌ یُصَلِّی بِہِمْ ، فَأَبَی حَتَّی دَفَعُوہُ ، فَلَمَّا صَلَّی بِہِمْ قَالَ : کُلّکُمْ رَاضٍ ؟ قَالُوا : نَعَمْ ، قَالَ : الْحَمْدُ لِلَّہِ ، إنِّی سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : ثَلاَثَۃٌ لاَ تُقْبَلُ صَلاَتُہُمُ ؛ الْمَرْأَۃُ تَخْرُجُ مِنْ بَیْتِہَا بِیْرِ ، إذْنِہِ ، وَالْعَبْدُ الآبِقُ ، وَالرَّجُلُ یَؤُمُّ الْقَوْمَ وَہُمْ لَہُ کَارِہُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 4135","","","كتاب الصلوات"
"4136","(۴۱۳۶) حَدَّثَنَا عَلِیُّ بْنُ حَسَنِ بْنِ شَقِیقٍ ، عَنْ حُسَیْنِ بْنِ وَاقِدٍ ، عَنْ أَبِی غَالِبٍ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ثَلاَثَۃٌ لاَ تُجَاوِزُ صَلاَتُہُمْ رُؤُوسَہُمْ حَتَّی یَرْجِعُوا ؛ الْعَبْدُ الآبِقُ ، وَامْرَأَۃٌ بَاتَتْ وَزَوْجُہَا عَلَیْہَا سَاخِطٌ ، وَإِمَامُ قَوْمٍ وَہُمْ لَہُ کَارِہُونَ۔ (ترمذی ۳۶۰۔ طبرانی ۸۰۹۸)","Da'if","Musannaf Ibn Abi Shaybah 4136","","","كتاب الصلوات"
"4137","(۴۱۳۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی ظَبْیَانَ ، عَنْ حُذَیْفَۃَ ، قَالَ : خَرَجَ فِی سَفَرٍ فَتَقَدَّمَ فَأَمَّہُمْ ، ثُمَّ قَالَ : لَتَلْتَمِسُنَّ إمَامًا غَیْرِی ، أَوْ لَتُصَلُّنَّ وُحْدَانًا۔","","Musannaf Ibn Abi Shaybah 4137","","","كتاب الصلوات"
"4138","(۴۱۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَشْیَاخِ مُحَارِبٍ ، قَالَ : قَالَ حُذَیْفَۃُ : لَتَبْتَغُنَّ إمَامًا غَیْرِی ، أَوْ لَتُصَلُّنَّ وُحْدَانًا۔","Majhul","Musannaf Ibn Abi Shaybah 4138","","","كتاب الصلوات"
"4139","(۴۱۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ابْتَدِرُوا الأَذَانَ ، وَلاَ تَبْتَدِرُوا الإِمَامَۃَ۔","","Musannaf Ibn Abi Shaybah 4139","","","كتاب الصلوات"
"4140","(۴۱۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ عُقْبَۃَ أبِی کِبْرَانَ ، أَنَّہُ قَالَ : کُنَّا مَعَ الضَّحَّاکِ فَقَالَ : إِنْ کَانَ مِنْکُمْ مَنْ یَتَقَدَّمُ فَلْیُؤَذِّنْ وَلْیُصَلِّ ، قَالَ : فَأَبَوْا ، فَصَلَّیْنَا وُحْدَانًا۔","","Musannaf Ibn Abi Shaybah 4140","","","كتاب الصلوات"
"4141","(۴۱۴۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَاصِمٍ ، قَالَ : أَمَّ أَبُو عُبَیْدَۃَ قَوْمًا مَرَّۃً ، فَلَمَّا انْصَرَفَ قَالَ : مَا زَالَ عَلَیَّ الشَّیْطَانُ آنِفًا حَتَّی رَأَیْت أَنَّ الْفَضْلَ لِی عَلَی مَنْ خَلْفِی ، لاَ أَؤُمّ أَبَدًا۔","","Musannaf Ibn Abi Shaybah 4141","","","كتاب الصلوات"
"4142","(۴۱۴۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ حُذَیْفَۃُ یَتَخَلَّفُ عَنِ الإِمَامَۃِ ، قَالَ : فَأُقِیمَتِ الصَّلاَۃُ ذَاتَ یَوْمٍ ، قَالَ : فَتَخَلَّفَ عَبْدُ اللہِ ، قَالَ : فَتَقَدَّمَ حُذَیْفَۃُ ، فَلَمَّا قَضَی صَلاَتَہُ ، قَالَ لَہُم : لَتَبْتَغُنَّ، أَوْ کَلِمَۃً غَیْرَہَا ، إمَامًا غَیْرِی ، أَوْ لَتُصَلُّنَّ فُرَادَی ۔ قَالَ : فَقَالَ مُجَاہِدٌ : قَالَ أَبُو مَعْمَرٍ ، عَنْ حُذَیْفَۃَ أَنَّہُ قَالَ : أَوْ لَتُصَلُّنَّ وُحْدَانًا ، قَالَ : فَقَالَ إبْرَاہِیمُ : أَوْ قَالَ : لَتُصَلُّنَّ وُحْدَانًا۔","Sahih","Musannaf Ibn Abi Shaybah 4142","","","كتاب الصلوات"
"4143","(۴۱۴۳) حَدَّثَنَا ہُشَیْمٌ، قَالَ: أَخْبَرَنَا الْعَوَّامُ، قَالَ: حَدَّثَنَا عَبْدُاللہِ بْنُ أَبِی الْہُذَیْلِ، قَالَ: کَانَ شَیْخٌ مِنْ تِلْکَ الشُّیُوخِ یَؤُمُّ قَوْمَہُ ثُمَّ تَرَکَ ذَلِکَ ، قَالَ : فَلَقِیَہُ بَعْضُ إِخْوَانِہِ ، فَقَالَ لَہُ : لِمَ تَرَکْت إمَامَۃَ قَوْمِکَ ؟ قَالَ : کَرِہْتُ أَنْ یَمُرَّ الْمَارُّ فَیَرَانِی أُصَلِّی فَیَقُولُ : مَا قَدَّمَ ہَؤُلاَء ہَذَا الرَّجُلَ إِلاَّ وَہُوَ خَیْرُہُمْ ، وَاللَّہِ لاَ أَؤُمُّہُمْ أَبَدًا۔","","Musannaf Ibn Abi Shaybah 4143","","","كتاب الصلوات"
"4144","(۴۱۴۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، قَالَ : کُنْتُ مَعَ ابْنِ سِیرِینَ فِی جِنَازَۃٍ ، فَلَمَّا انْصَرَفْنَا حضَرَتِ الصَّلاَۃُ ، قَالَ : فَلَمَّا أُقِیمَتْ قِیلَ لابْنِ سِیرِینَ : تَقَدَّمْ ، قَالَ : فَقَالَ : لِیَتَقَدَّمْ بَعْضُکُمْ ، وَلاَ یَتَقَدَّمْ إِلاَّ مَنْ قَرَأَ الْقُرْآنَ ، قَالَ ، ثُمَّ قَالَ لِی : تَقَدَّمْ ، فَتَقَدَّمْتُ فَصَلَّیْتُ بِہِمْ ، فَلَمَّا فَرَغْت قُلْتُ فِی نَفْسِی : مَاذَا صَنَعْت ؟ شَیْئًا کَرِہَہُ ابْنُ سِیرِینَ لِنَفْسِہِ تَقَدَّمْت عَلَیْہِ ، فَقُلْتُ لَہُ : یَرْحَمُکَ اللَّہُ ، أَمَرْتَنِی بِشَیْئٍ کَرِہْتَہُ لِنَفْسِکَ ؟ فَقَالَ : إنِّی کَرِہْتُ أَنْ یَمُرَّ الْمَارُّ فَیَقُولَ : ہَذَا ابْنُ سِیرِینَ یَؤُمّ النَّاسَ۔","","Musannaf Ibn Abi Shaybah 4144","","","كتاب الصلوات"
"4145","(۴۱۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : أَخْبَرَنَا عِکْرِمَۃُ بْنُ عَمَّارٍ الْیَمَامِیُّ ، عَنْ ضَمْضَمِ بْنِ جَوْسٍ الْہِفَّانِیِّ ، عَنْ عَبْدِ اللہِ بْنِ حَنْظَلَۃَ بْنِ الرَّاہِبِ ، قَالَ : صَلَّی بِنَا عُمَرُ بْنُ الْخَطَّابِ فَنَسِیَ أَنْ یَقْرَأَ فِی الرَّکْعَۃِ الأُولَی ، فَلَمَّا قَامَ فِی الرَّکْعَۃِ الثَّانِیَۃِ قَرَأَ بِفَاتِحَۃِ الْکِتَابِ مَرَّتَیْنِ وَسُورَتَیْنِ ، فَلَمَّا قَضَی الصَّلاَۃَ سَجَدَ سَجْدَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 4145","","","كتاب الصلوات"
"4146","(۴۱۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ؛ أَنَّہُ نَسِیَ أَنْ یَقْرَأَ فِی الأُولَیَیْنِ ، فَقَرَأَ فِی الأُخْرَیَیْنِ۔","","Musannaf Ibn Abi Shaybah 4146","","","كتاب الصلوات"
"4147","(۴۱۴۷) حَدَّثَنَا أَسْبَاطٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا نَسِیَ أَنْ یَقْرَأَ فِی الأُولَیَیْنِ ، قَرَأَ فِی الأُخْرَیَیْنِ۔","","Musannaf Ibn Abi Shaybah 4147","","","كتاب الصلوات"
"4148","(۴۱۴۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، وَالْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کُنْتُ أَقُومُ خَلْفَ الأَسْوَدِ حَتَّی یَنْزِلَ الْمُؤَذِّنُ۔","","Musannaf Ibn Abi Shaybah 4148","","","كتاب الصلوات"
"4149","(۴۱۴۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَقُومُ خَلْفَ الإِمَامِ مَا بَیْنَہُ وَبَیْنَ الرَّکْعَۃِ ، فَإِنْ جَائَ أَحَدٌ ، وَإِلاَّ قَامَ عَنْ یَمِینِہِ۔","","Musannaf Ibn Abi Shaybah 4149","","","كتاب الصلوات"
"4150","(۴۱۵۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَقَدْ رَأَیْتُنِی أَقُومُ خَلْفَ عَلْقَمَۃَ حَتَّی یَدْخُلَ دَاخِلٌ ، أَوْ یَنْزِلَ مُؤَذِّنٌ۔","","Musannaf Ibn Abi Shaybah 4150","","","كتاب الصلوات"
"4151","(۴۱۵۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ قَیْسِ بْنِ عَبَایَۃَ ، قَالَ : حدَّثَنِی ابْنُ عَبْدِ اللہِ بْنِ مُغَفَّلٍ ، عَنْ أَبِیہِ ، قَالَ ، وَلَمْ أَرَ رَجُلاً مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ أَشَدَّ عَلَیْہِ حَدَثٌ فِی الإِسْلاَمِ مِنْہُ ، قَالَ : سَمِعَنِی أَبِی وَأَنَا أَقْرَأُ : {بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیم} قَالَ : یَا بُنَیَّ ، إیَّاکَ وَالْحَدَثَ ، فَإِنِّی قَدْ صَلَّیْت خَلْفَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبِی بَکْرٍ ، وَعُمَرَ ، وَعُثْمَانَ فَلَمْ أَسْمَعْ أَحَدًا مِنْہُمْ یَقُولُ ذَلِکَ ، إذَا قَرَأْت فَقُلِ : {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔ (ترمذی ۲۴۴۔ احمد ۵۵)","Hasan","Musannaf Ibn Abi Shaybah 4151","","","كتاب الصلوات"
"4152","(۴۱۵۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُمَیْدٌ ، عَنْ أَنَسٍ ، أَنَّ أَبَا بَکْرٍ ، وَعُمَرَ ، وَعُثْمَانَ کَانُوا یَسْتَفْتِحُونَ الْقِرَائَۃَ بِـ {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ} ۔ قَالَ حُمَیْدٌ : وَأَحْسَبُہُ ذَکَرَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (عبدالرزاق ۲۵۹۲۔ ابو یعلی ۳۵۰۹)","Sahih","Musannaf Ibn Abi Shaybah 4152","","","كتاب الصلوات"
"4153","(۴۱۵۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، قَالَ : حَدَّثَنَا قَتَادَۃُ ، عَنْ أَنَسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَبَا بَکْرٍ ، وَعُمَرَ ، وَعُثْمَانَ کَانُوا یَسْتَفْتِحُونَ الْقِرَائَۃَ بِـ {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔ (بخاری ۷۴۳۔ مسلم ۲۹۹)","Sahih","Musannaf Ibn Abi Shaybah 4153","","","كتاب الصلوات"
"4154","(۴۱۵۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حُسَیْنٌ الْمُعَلِّمُ ، عَنْ بُدَیْلٍ ، عَنْ أَبِی الْجَوْزَائِ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَفْتَتِحُ الصَّلاَۃَ بِالتَّکْبِیرِ ، وَالْقِرَائَۃِ بِـ {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔","Sahih","Musannaf Ibn Abi Shaybah 4154","","","كتاب الصلوات"
"4155","(۴۱۵۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ یَفْتَتِحُ الْقِرَائَۃَ بِـ {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔","Da'if","Musannaf Ibn Abi Shaybah 4155","","","كتاب الصلوات"
"4156","(۴۱۵۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ؛ أَنَّہُ کَانَ یَسْتَفْتِحُ الْقِرَائَۃَ بِـ {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔","Hasan","Musannaf Ibn Abi Shaybah 4156","","","كتاب الصلوات"
"4157","(۴۱۵۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ یُخْفِی {بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیم}۔","","Musannaf Ibn Abi Shaybah 4157","","","كتاب الصلوات"
"4158","(۴۱۵۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَفْتَتِحُ الْقِرَائَۃَ بِـ {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔","","Musannaf Ibn Abi Shaybah 4158","","","كتاب الصلوات"
"4159","(۴۱۵۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، وَمُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُخْفِی الإِمَامُ بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیم وَالاسْتِعَاذَۃَ ، وَآمِینَ ، وَرَبَّنَا لَکَ الْحَمْدُ۔","","Musannaf Ibn Abi Shaybah 4159","","","كتاب الصلوات"
"4160","(۴۱۶۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ سَعِیدِ بْنِ الْمَرْزُبَانِ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ یُخْفِی {بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیم} وَالاسْتِعَاذَۃَ ، وَرَبَّنَا لَکَ الْحَمْدُ۔","Da'if","Musannaf Ibn Abi Shaybah 4160","","","كتاب الصلوات"
"4161","(۴۱۶۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : جَہْرُ الإِمَامِ بـ {بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیم} بِدْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 4161","","","كتاب الصلوات"
"4162","(۴۱۶۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، وَابْنِ الزُّبَیْرِ ؛ أَنَّہُمَا کَانَا لاَ یَجْہَرَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 4162","","","كتاب الصلوات"
"4163","(۴۱۶۳) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ؛ أَنْ أَبَا بَکْرٍ کَانَ یَفْتَتِحُ الْقِرَائَۃَ بِـ {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔","","Musannaf Ibn Abi Shaybah 4163","","","كتاب الصلوات"
"4164","(۴۱۶۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَاصِمٍ ، قَالَ ، سَمِعْت أَبَا وَائِلٍ یَسْتَفْتِحُ الْقِرَائَۃَ بِـ {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔","","Musannaf Ibn Abi Shaybah 4164","","","كتاب الصلوات"
"4165","(۴۱۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا وَأَبَا إِسْحَاقَ عَنِ الْجَہْرِ ؟ قالوا : اقْرَأْ : (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیم) فِی نَفْسِک۔","","Musannaf Ibn Abi Shaybah 4165","","","كتاب الصلوات"
"4166","(۴۱۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی بَشِیرٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الْجَہْرُ بـ (بسم اللہِ الرَّحْمَنِ الرَّحِیمِ) قِرَائَۃُ الأَعْرَابِ۔","Sahih","Musannaf Ibn Abi Shaybah 4166","","","كتاب الصلوات"
"4167","(۴۱۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، قَالَ : صَلَّیْت خَلْفَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبِی بَکْرٍ ، وَعُمَرَ ، وَعُثْمَانَ فَلَمْ یَجْہَرُوا بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔ (بخاری ۷۴۳۔ مسلم ۲۹۹)","Sahih","Musannaf Ibn Abi Shaybah 4167","","","كتاب الصلوات"
"4168","(۴۱۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبَا بَکْرٍ ، وَعُمَرَ ، وَعُثْمَانَ کَانُوا یَسْتَفْتِحُونَ الصَّلاَۃَ بِـ {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔","Sahih","Musannaf Ibn Abi Shaybah 4168","","","كتاب الصلوات"
"4169","(۴۱۶۹) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ ، عَنْ ثُوَیْرٍ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا کَانَ لاَ یَجْہَرُ بِـ (بسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","Da'if","Musannaf Ibn Abi Shaybah 4169","","","كتاب الصلوات"
"4170","(۴۱۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : لاَ یُجْہَرُ بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","","Musannaf Ibn Abi Shaybah 4170","","","كتاب الصلوات"
"4171","(۴۱۷۱) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ الرَّازِیّ ، عَنْ أَبِی سِنَانٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : صَلَّیْت خَلْفَ عُمَرَ سَبْعِینَ صَلاَۃً ، فَلَمْ یَجْہَرْ فِیہَا بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","Hasan","Musannaf Ibn Abi Shaybah 4171","","","كتاب الصلوات"
"4172","(۴۱۷۲) حَدَّثَنَا شَاذَانُ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی وَائِلٍ ؛ أَنَّ عَلِیًّا وَعَمَّارًا کَانَا لاَ یَجْہَرَانِ بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","Hasan","Musannaf Ibn Abi Shaybah 4172","","","كتاب الصلوات"
"4173","(۴۱۷۳) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، قَالَ : أَخْبَرَنَا مَالِکُ بْنُ زِیَادٍ ، قَالَ : صَلَّی بِنَا عُمَرُ بْنُ عَبْدِ الْعَزِیزِ فَافْتَتَحَ الصَّلاَۃَ بِـ {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔","","Musannaf Ibn Abi Shaybah 4173","","","كتاب الصلوات"
"4174","(۴۱۷۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو مَعْشَرٍ ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّہُ کَانَ یَجْہَرُ بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","Da'if","Musannaf Ibn Abi Shaybah 4174","","","كتاب الصلوات"
"4175","(۴۱۷۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ وِقَائٍ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ جُبَیْرٍ یَجْہَرُ بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","","Musannaf Ibn Abi Shaybah 4175","","","كتاب الصلوات"
"4176","(۴۱۷۶) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوس ، وَمُجَاہِدٍ ؛ أَنَّہُمْ کَانُوا یَجْہَرُونَ بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","","Musannaf Ibn Abi Shaybah 4176","","","كتاب الصلوات"
"4177","(۴۱۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الأَزْرَقِ بْنِ قَیْسٍ ، قَالَ : سَمِعْتُ ابْنَ الزُّبَیْرِ قَرَأَ : (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ) ، ثُمَّ قَرَأَ : (الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ) ثُمَّ قَرَأَ : (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","Sahih","Musannaf Ibn Abi Shaybah 4177","","","كتاب الصلوات"
"4178","(۴۱۷۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ إذَا افْتَتَحَ ألصَّلاَۃَ قَرَأَ : (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ) فَإِذَا فَرَغَ مِنَ الْحَمْدِ قَرَأَ : (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","Sahih","Musannaf Ibn Abi Shaybah 4178","","","كتاب الصلوات"
"4179","(۴۱۷۹) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، وَمُعَاذُ بْنُ مُعَاذٍ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ؛ أَنَّ ابْنَ الزُّبَیْرِ کَانَ یَجْہَرُ بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ) وَیَقُولُ : مَا یَمْنَعُہُمْ مِنْہَا إِلاَّ الْکِبْرُ۔","Sahih","Musannaf Ibn Abi Shaybah 4179","","","كتاب الصلوات"
"4180","(۴۱۸۰) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، عَنْ أَبِیہِ ، عَنْ سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ أَبِیہِ ؛ أَنَّ عُمَرَ جَہَرَ بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","Hasan","Musannaf Ibn Abi Shaybah 4180","","","كتاب الصلوات"
"4181","(۴۱۸۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَقُولُ : إذَا قَرَأَ الرَّجُلُ فِی صَلاَتِہِ مَرَّۃً وَاحِدَۃً (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ) أَجْزَأَہُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 4181","","","كتاب الصلوات"
"4182","(۴۱۸۲) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ قَالَ : إذَا تَعَوَّذَ مَرَّۃً ، وَقَرَأَ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ) أَجْزَأَہُ لِبَقِیَّۃِ صَلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 4182","","","كتاب الصلوات"
"4183","(۴۱۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ یَقْرَأُ : (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ) فِی کُلِّ رَکْعَۃٍ۔","","Musannaf Ibn Abi Shaybah 4183","","","كتاب الصلوات"
"4184","(۴۱۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا ، وَأَبَا إِسْحَاقَ فَقَالُوا : اقْرَأْ فِی کُلِّ رَکْعَۃٍ بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ) ۔","","Musannaf Ibn Abi Shaybah 4184","","","كتاب الصلوات"
"4185","(۴۱۸۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، وَأَبِی إِسْحَاقَ؛ فِی الرَّجُلِ یَقْرَأُ فِی الرَّکْعَۃِ بِالسُّورَتَیْنِ، کُلَّمَا قَرَأَ سُورَۃً اسْتَفْتَحَ بِـ (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","","Musannaf Ibn Abi Shaybah 4185","","","كتاب الصلوات"
"4186","(۴۱۸۶) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ طَلْحَۃَ ؛ أَنَّہُ کَانَ یَقْرَأُ فِی الْمُصْحَفِ ، فَکَانَ کُلَّمَا خَتَمَ سُورَۃً قَرَأَ : (بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ)۔","","Musannaf Ibn Abi Shaybah 4186","","","كتاب الصلوات"
"4187","(۴۱۸۷) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ کَثِیرِ بْنِ شِنْظِیرٍ ، عَنْ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : إذَا انْتَہَی الرَّجُلُ إلَی الْقَوْمِ وَہُمْ قُعُودٌ فِی آخِرِ الصَّلاَۃِ ، فَقَدْ دَخَلَ فِی التَّضْعِیفِ ، وَإِذَا انْتَہَی إلَیْہِمْ وَقَدْ سَلَّمَ الإِمَامُ ، وَلَمْ یَتَفَرَّقُوا ، فَقَدْ دَخَلَ فِی التَّضْعِیفِ۔nوَقَالَ عَطَائٌ : کَانَ یُقَالُ : إذَا خَرَجَ مِنْ بَہِتِگ وَہُوَ یَنْوِیہِمْ فَأَدْرَکَہُمْ ، أَوْ لَمْ یُدْرِکْہُمْ ، فَقَدْ دَخَلَ فِی التَّضْعِیفِ۔","Sahih","Musannaf Ibn Abi Shaybah 4187","","","كتاب الصلوات"
"4188","(۴۱۸۸) حَدَّثَنَا شَرِیکٌ ، عَنْ عَامِرِ بْنِ شَقِیقٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ أَدْرَکَ التَّشَہُّدَ ، فَقَدْ أَدْرَکَ الصَّلاَۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 4188","","","كتاب الصلوات"
"4189","(۴۱۸۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِی سَلَمَۃَ ، قَالَ : مَنْ خَرَجَ مِنْ بَیْتِہِ قَبْلَ أَنْ یُسَلِّمَ الإِمَامُ ، فَقَدْ أَدْرَکَ۔","","Musannaf Ibn Abi Shaybah 4189","","","كتاب الصلوات"
"4190","(۴۱۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنِ ابْنِ صُہَیْبٍ ، قَالَ : کَانَ زَرٌّ ، وَأَبُو وَائِلٍ إذَا رَأَوْنَا فِی الصَّفِّ ، وَنَحْنُ صِبْیَانٌ أَخْرَجُونَا۔","","Musannaf Ibn Abi Shaybah 4190","","","كتاب الصلوات"
"4191","(۴۱۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِیہِ ، عَنْ ہِلاَلٍ ، عَنْ عَبْدِ اللہ بْنِ عُکَیْمٍ ؛ أَنَّہُ کَانَ إذَا رَأَی صَبِیًّا فِی الصَّفِّ أَخْرَجَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4191","","","كتاب الصلوات"
"4192","(۴۱۹۲) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ أَبَانَ الْعَطَّارِ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ کَانَ إذَا رَأَی غُلاَمًا فِی الصَّفِّ أَخْرَجَہُ۔","","Musannaf Ibn Abi Shaybah 4192","","","كتاب الصلوات"
"4193","(۴۱۹۳) حَدَّثَنَا شَرِیکُ بْنُ عَبْدِ اللہِ ، عَنْ یَحْیَی بْنِ ہَانِیئٍ الْمُرَادِیِّ ، عَنْ رَجُلٍ مِنْ قَوْمِہِ ؛ أَنَّ حُذَیْفَۃَ کَانَ یُفَرِّقُ بَیْنَ الصِّبْیَانِ فِی الصَّفِّ ، أَوَ قَالَ : فِی الصَّلاَۃِ۔","Majhul","Musannaf Ibn Abi Shaybah 4193","","","كتاب الصلوات"
"4194","(۴۱۹۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، أَوْ ہِلاَلٍ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : قَالَ عَلِیٌّ : الْمُؤَذِّنُ أَمْلَکُ بِالأَذَانِ ، وَالإِمَامُ أَمْلَکُ بِالإِقَامَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 4194","","","كتاب الصلوات"
"4195","(۴۱۹۵) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنِ الْحَسَنِ بْنِ عُبَیْدِاللہِ، قَالَ: کَانُوا یَنْتَظِرُونَ الأَسْوَدَ، وَکَانَ إمَامَہُمْ۔","","Musannaf Ibn Abi Shaybah 4195","","","كتاب الصلوات"
"4196","(۴۱۹۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : کَانُوا یَنْتَظِرُونَ الإِمَامَ حَتَّی یَنْزِلَ الْمُؤَذِّنُ۔","","Musannaf Ibn Abi Shaybah 4196","","","كتاب الصلوات"
"4197","(۴۱۹۷) حَدَّثَنَا وَکِیعٌ ، قَالَ :حَدَّثَنَا مِسْعَرٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ مَعْقِلِ بْنِ أَبِی بَکْرٍ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ انْتُظِرَ بَعْدَ مَا أُقِیمَتِ الصَّلاَۃُ۔","Majhul","Musannaf Ibn Abi Shaybah 4197","","","كتاب الصلوات"
"4198","(۴۱۹۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ، عَنْ أَنَسٍ ، قَالَ : أُقِیمَتِ الصَّلاَۃُ وَرَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَجِیٌّ لِرَجُلٍ فِی جَانِبِ الْمَسْجِدِ ، فَمَا قَامَ إلَی الصَّلاَۃِ حَتَّی نَامَ الْقَوْمُ۔ (بخاری ۶۴۲۔ مسلم ۲۸۴)","Sahih","Musannaf Ibn Abi Shaybah 4198","","","كتاب الصلوات"
"4199","(۴۱۹۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : إِنْ کَانَ عُمَرُ لَیُقَاوِمُ الرَّجُلَ بَعْدَ مَا تُقَامُ الصَّلاَۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 4199","","","كتاب الصلوات"
"4200","(۴۲۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : أُقِیمَتِ الصَّلاَۃُ وَصُفَّتِ الصُّفُوفُ فَانْدَرَأَ رَجُلٌ لِعُمَرَ فَکَلَّمَہُ ، فَأَطَالاَ الْقِیَامَ حَتَّی أَلْقَیَا إلَی الأَرْضِ وَالْقَوْمُ صُفُوفٌ۔","","Musannaf Ibn Abi Shaybah 4200","","","كتاب الصلوات"
"4201","(۴۲۰۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، وَابْنِ سِیرِینَ ؛ أَنَّہُمَا کَانَا إذَا قَرَآ السَّجْدَۃَ سَلَّمَا۔","","Musannaf Ibn Abi Shaybah 4201","","","كتاب الصلوات"
"4202","(۴۲۰۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ؛ أَنَّہُ کَانَ یُسَلِّمُ یَقُولُ : السَّلاَمُ عَلَیْکُمْ، إذَا قَرَأَ السَّجْدَۃَ۔","","Musannaf Ibn Abi Shaybah 4202","","","كتاب الصلوات"
"4203","(۴۲۰۳) حَدَّثَنَا وَکِیعٌ، عَنْ شُعْبَۃَ، عَنِ الْحَکَمِ، قَالَ: رَأَیْتُ أَبَا الأَحْوَص وَقَرَأَ السَّجْدَۃَ فَسَلَّمَ عَنْ یَمِینِہِ تَسْلِیمَۃً۔","","Musannaf Ibn Abi Shaybah 4203","","","كتاب الصلوات"
"4204","(۴۲۰۴) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ إبْرَاہِیمُ ، وَأَبُو صَالِحٍ ، وَیَحْیَی بْنُ وَثَّابٍ لاَ یُسَلِّمُونَ فِی السَّجْدَۃِ۔","","Musannaf Ibn Abi Shaybah 4204","","","كتاب الصلوات"
"4205","(۴۲۰۵) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ إذَا قَرَأَ السَّجْدَۃَ لَمْ یُسَلِّمْ فِیہَا۔","","Musannaf Ibn Abi Shaybah 4205","","","كتاب الصلوات"
"4206","(۴۲۰۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، قَالَ : کَانَ الْحَسَنُ یَقْرَأُ بِنَا سُجُودَ الْقُرْآنِ وَلاَ یُسَلِّمُ۔","","Musannaf Ibn Abi Shaybah 4206","","","كتاب الصلوات"
"4207","(۴۲۰۷) حَدَّثَنَا عَبَّادٌ ، عَنْ وِقَائِ بْنِ إیَاسٍ الأَسَدِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ یَقْرَأُ السَّجْدَۃَ ، فَیَرْفَعُ رَأْسَہُ ، وَلاَ یُسَلِّمُ۔","","Musannaf Ibn Abi Shaybah 4207","","","كتاب الصلوات"
"4208","(۴۲۰۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ (ح) وَأَبُو الأَشْہَبِ ، عَنِ الْحَسَنِ ، أَنَّہُمَا قَالاَ : إذَا قَرَأَ الرَّجُلُ السَّجْدَۃَ ، فَلْیُکَبِّرْ إذَا رَفَعَ رَأْسَہُ ، وَإِذَا سَجَدَ۔","","Musannaf Ibn Abi Shaybah 4208","","","كتاب الصلوات"
"4209","(۴۲۰۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، وَابْنِ سِیرِینَ ، أَنَّہُمَا قَالاَ : إذَا قَرَأَ الرَّجُلُ السَّجْدَۃَ فِی غَیْرِ صَلاَۃٍ قَالَ : اللَّہُ أَکْبَرُ۔","","Musannaf Ibn Abi Shaybah 4209","","","كتاب الصلوات"
"4210","(۴۲۱۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، قَالَ : کَانَ أَبِی إذَا قَرَأَ السَّجْدَۃَ ، قَالَ : اللَّہُ أَکْبَرُ ، ثُمَّ سَجَدَ۔","","Musannaf Ibn Abi Shaybah 4210","","","كتاب الصلوات"
"4211","(۴۲۱۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ؛ أَنَّہُ کَانَ یَقْرَأُ السَّجْدَۃَ وَہُوَ یَمْشِی ، فَیُکَبِّرُ وَیُومِیئُ حَیْثُ کَانَ وَجْہُہُ ، وَیُکَبِّرُ إذَا رَفَعَ۔","","Musannaf Ibn Abi Shaybah 4211","","","كتاب الصلوات"
"4212","(۴۲۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : إذَا قَرَأْتَ السَّجْدَۃَ فَکَبِّرْ۔","","Musannaf Ibn Abi Shaybah 4212","","","كتاب الصلوات"
"4213","(۴۲۱۳) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ، عَنْ عَطَائِ بْنِ السَّائِبِ، عَنْ أَبِی عَبْدِالرَّحْمَنِ السُّلَمِیِّ، قَالَ: کُنَّا نَقْرَأُ عَلَی أَبِی عَبْدِ الرَّحْمَنِ وَنَحْنُ نَمْشِی ، فَإِذَا مَرَّ بِالسَّجْدَۃِ کَبَّرَ وَأَوْمَأَ وَسَلَّمَ ، وَزَعَمَ أَنَّ ابْنَ مَسْعُودٍ کَانَ یَصْنَعُ ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 4213","","","كتاب الصلوات"
"4214","(۴۲۱۴) حَدَّثَنَا شَرِیکٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ؛ أَنَّ أَصْحَابَ عَبْدِ اللہِ کَانُوا یَقْرَؤُونَ السَّجْدَۃَ وَہُمْ یَمْشُونَ ، فَیُومِئُونَ إیمَائً۔","","Musannaf Ibn Abi Shaybah 4214","","","كتاب الصلوات"
"4215","(۴۲۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ ؛ أَنَّہُ کَانَ یَقْرَؤُہَا وَہُوَ یَمْشِی ، فَیُومِیئُ إِیمَائً۔","","Musannaf Ibn Abi Shaybah 4215","","","كتاب الصلوات"
"4216","(۴۲۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ؛ أَنَّہُ کَانَ یُومِیئُ۔","","Musannaf Ibn Abi Shaybah 4216","","","كتاب الصلوات"
"4217","(۴۲۱۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ أَشْعَثَ ، قَالَ : سَأَلْتُ کُرْدُوسًا عَنِ السَّجْدَۃِ یَقْرَؤُہَا الرَّجُلُ وَہُوَ یَمْشِی؟ قَالَ : یُومِیئُ۔","","Musannaf Ibn Abi Shaybah 4217","","","كتاب الصلوات"
"4218","(۴۲۱۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ زِیَادٍ ، قَالَ : حدَّثَنِی عُمَارَۃُ بْنُ الْقَعْقَاعِ ، عَنْ أَبِی زُرْعَۃَ بْنِ عَمْرِو بْنِ جَرِیرٍ ؛ أَنَّہُ ذَکَرَ الإِیمَائَ ، وَذَکَرْتُ لَہُ : أَنَّ إبْرَاہِیمَ قَرَأَہَا فِی مَسِیرٍ لَہُ فَأَوْمَأَ۔","","Musannaf Ibn Abi Shaybah 4218","","","كتاب الصلوات"
"4219","(۴۲۱۹) حَدَّثَنَا عَبْدَۃُ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : کُنْتُ أَعْرِضُ عَلَی أُبَیٍّ وَیَعْرِضُ عَلَیَّ فِی الطَّرِیقِ ، فَیَمُرُّ بِالسَّجْدَۃِ فَیَسْجُدُ ، فَقُلْتُ لَہُ : أَتَسْجُدُ فِی الطَّرِیقِ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 4219","","","كتاب الصلوات"
"4220","(۴۲۲۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَبِی جَعْفَرٍ الرَّازِیّ ، عَنِ الرَّبِیعِ بْنِ أَنَسٍ ، قَالَ : قُلْتُ لأَبِی الْعَالِیَۃِ : إنِّی آخُذ فِی سِکَّۃٍ ضَیِّقَۃٍ ، فَأَسْمَعُ الْقَارِیئَ یَقْرَأُ السَّجْدَۃَ ، فَأَسْجُدُ عَلَی الطَّرِیقِ ؟ قَالَ : نَعَمْ ، اُسْجُدْ عَلَی الطَّرِیقِ۔","Sahih","Musannaf Ibn Abi Shaybah 4220","","","كتاب الصلوات"
"4221","(۴۲۲۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّ ابْنَ مَسْعُودٍ کَانَ یَقْرَأُ وَہُوَ یَمْشِی ، فتَأْتِی السَّجْدَۃَ فَیَتَنَحَّی فَیَسْجُدُ۔","","Musannaf Ibn Abi Shaybah 4221","","","كتاب الصلوات"
"4222","(۴۲۲۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، قَالَ : إذَا قَرَأْتَ السَّجْدَۃَ وَأَنْتَ تَمْشِی ، فَضَعْ جَبْہَتَکَ عَیَح أَوَّلِ حَائِطٍ تَلْقَی۔","","Musannaf Ibn Abi Shaybah 4222","","","كتاب الصلوات"
"4223","(۴۲۲۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ (ح) وَأَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَقْرَأُ السَّجْدَۃَ ، ثُمَّ یُعِیدُ قِرَائَتَہَا ، قَالاَ : تُجْزِئُہُ السَّجْدَۃُ الأُولَی۔","","Musannaf Ibn Abi Shaybah 4223","","","كتاب الصلوات"
"4224","(۴۲۲۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا قَرَأْتَ السَّجْدَۃَ أَجْزَأَک أَنْ تَسْجُدَ بِہَا مَرَّۃً۔","","Musannaf Ibn Abi Shaybah 4224","","","كتاب الصلوات"
"4225","(۴۲۲۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ؛ أَنَّہُ کَانَ یَقْرَأُ السَّجْدَۃَ فَیَسْجُدُ ، ثُمَّ یُعِیدُہَا فِی مَجْلِسِہِ ذَلِکَ مِرَارًا ، لاَ یَسْجُدُ۔","","Musannaf Ibn Abi Shaybah 4225","","","كتاب الصلوات"
"4226","(۴۲۲۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا خَالِدٌ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : کَانُوا یَکْرَہُونَ اخْتِصَارَ السُّجُودِ۔","","Musannaf Ibn Abi Shaybah 4226","","","كتاب الصلوات"
"4227","(۴۲۲۷) حَدَّثَنَا ہُشَیْمٌ ، وَعَلِیُّ بْنُ مُسْہِرٍ ، وَابْنُ فُضَیْلٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانُوا یَکْرَہُونَ اخْتِصَارَ السُّجُودِ ، وَکَانُوا یَکْرَہُونَ إذَا أَتَوْا عَلَی السَّجْدَۃِ أَنْ یُجَاوِزُوہَا حَتَّی یَسْجُدُوا۔","","Musannaf Ibn Abi Shaybah 4227","","","كتاب الصلوات"
"4228","(۴۲۲۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : ثَلاَثٌ مِمَّا أَحْدَثَ النَّاسُ : اخْتِصَارُ السُّجُودِ ، وَرَفْعُ الأَیْدِی فِی الدُّعَائِ ، قَالَ ہُشَیْمٌ : وَنَسِیتُ الثَّالِثَۃَ۔","","Musannaf Ibn Abi Shaybah 4228","","","كتاب الصلوات"
"4229","(۴۲۲۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ قُرَیْرٍ ، قَالَ : سَأَلْتُ ابْنَ سِیرِینَ عَنِ اخْتِصَارِ السُّجُودِ ؟ فَکَرِہَہُ وَعَبَسَ وَجْہُہُ ، وَقَالَ : لاَ أَدْرِی مَا ہَذَا۔","","Musannaf Ibn Abi Shaybah 4229","","","كتاب الصلوات"
"4230","(۴۲۳۰) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : ہُوَ مِمَّا أَحْدَثَ النَّاسُ۔","","Musannaf Ibn Abi Shaybah 4230","","","كتاب الصلوات"
"4231","(۴۲۳۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ تُخْتَصَرَ السَّجْدَۃُ۔","","Musannaf Ibn Abi Shaybah 4231","","","كتاب الصلوات"
"4232","(۴۲۳۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یُکْرَہُ أَنْ یُخْتَصَرَ سُجُودُ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 4232","","","كتاب الصلوات"
"4233","(۴۲۳۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ، عَنِ أَبِی الْمُعْتَمِرِ، عَنْ قَتَادَۃَ، عَنْ شَہْرِ بْنِ حَوْشَبٍ، قَالَ: ہُوَ مِمَّا أَحْدَثَ النَّاسُ۔","","Musannaf Ibn Abi Shaybah 4233","","","كتاب الصلوات"
"4234","(۴۲۳۴) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ مِسْعَرٍ ، عَنْ وَبَرَۃَ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ ، وَأَنَا مُقْبِلٌ مِنَ الْمَدِینَۃِ عَنِ الرَّجُلِ یَقْرَأُ السَّجْدَۃَ وَہُوَ عَلَی الدَّابَّۃِ ؟ قَالَ : یُومِیئُ۔","Sahih","Musannaf Ibn Abi Shaybah 4234","","","كتاب الصلوات"
"4235","(۴۲۳۵) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَقْرَأُ السَّجْدَۃَ وَہُوَ عَلَی دَابَّۃٍ ، قَالَ : یُومِیئُ بِرَأْسِہِ إیمَائً حَیْثُ کَانَ وَجْہُہُ۔","","Musannaf Ibn Abi Shaybah 4235","","","كتاب الصلوات"
"4236","(۴۲۳۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : کُنْتُ أَسِیرُ مَعَ أَبِی عُبَیْدَۃَ بَیْنَ الْکُوفَۃِ وَالْحِیرَۃِ ، فَقَرَأَ السَّجْدَۃَ ، فَذَہَبْت أَنْزِلُ لأَسْجُدَ ، فَقَالَ : یُجْزِیک أَنْ تُومِیئَ بِرَأْسِکَ ، قَالَ : وَأَوْمَأَ بِرَأْسِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4236","","","كتاب الصلوات"
"4237","(۴۲۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ ثُوَیْرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَانَ یَقْرَأُ السَّجْدَۃَ وَہُوَ عَلَی رَاحِلَتِہِ فَیُومِیئُ۔","Da'if","Musannaf Ibn Abi Shaybah 4237","","","كتاب الصلوات"
"4238","(۴۲۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ سَعِیدِ بْنِ زَیْدٍ ، قَالَ : کَانَ یَقْرَأُ السَّجْدَۃَ عَلَی رَاحِلَتِہِ فَیُومِیئُ۔","","Musannaf Ibn Abi Shaybah 4238","","","كتاب الصلوات"
"4239","(۴۲۳۹) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ ثُوَیْرٍ، قَالَ: رَأَیْتُ ابْنَ الزُّبَیْرِ یَقْرَأُ السَّجْدَۃَ وَہُوَ عَلَی رَاحِلَتِہِ، فَیُومِیئُ۔","Da'if","Musannaf Ibn Abi Shaybah 4239","","","كتاب الصلوات"
"4240","(۴۲۴۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَقْرَأُ السَّجْدَۃَ وَہُوَ عَلَی دَابَّتِہِ ، قَالَ: یُومِیئُ۔","","Musannaf Ibn Abi Shaybah 4240","","","كتاب الصلوات"
"4241","(۴۲۴۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ شِبَاکٍ ، عَنْ إِبْرَاہِیمَ ؛ قَالَ : إِذَا قَرَأَ السَّجْدَۃَ وَہُوَ عَلَی دَابَّتِہِ أَوْمَأَ بِرَأْسِہِ إِیمَائً۔","","Musannaf Ibn Abi Shaybah 4241","","","كتاب الصلوات"
"4242","(۴۲۴۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حَدَّثَنَا مِسْعَرٌ ، قَالَ : حدَّثَنَا حَمَّادٌ ؛ أَنَّ إبْرَاہِیمَ سَأَلَ عَلْقَمَۃَ : أَیَنْزِلُ عَنْ دَابَّتِہِ لِلسَّجْدَۃِ ؟ فَأَمَرَہُ أَنْ لاَ یَنْزِلَ۔","","Musannaf Ibn Abi Shaybah 4242","","","كتاب الصلوات"
"4243","(۴۲۴۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إنَّمَا السَّجْدَۃُ عَلَی مَنْ جَلَسَ لَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 4243","","","كتاب الصلوات"
"4244","(۴۲۴۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا خَالِدٌ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : قَالَ عُمَرُ : إنَّمَا السَّجْدَۃُ فِی الْمَسْجِدِ ، وَعِنْدَ الذِّکْرِ۔","","Musannaf Ibn Abi Shaybah 4244","","","كتاب الصلوات"
"4245","(۴۲۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعَوَّامِ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إنَّمَا السَّجْدَۃُ عَلَی مَنْ جَلَسَ لَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 4245","","","كتاب الصلوات"
"4246","(۴۲۴۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ، قَالَ : إنَّمَا السُّجُودُ عَلَی مَنْ جَلَسَ لَہُ ، وَأَنْصَتَ۔","","Musannaf Ibn Abi Shaybah 4246","","","كتاب الصلوات"
"4247","(۴۲۴۷) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عُثْمَانَ ، قَالَ : إنَّمَا السَّجْدَۃُ عَلَی مَنْ جَلَسَ لَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 4247","","","كتاب الصلوات"
"4248","(۴۲۴۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ قَاصًّا کَانَ یَجْلِسُ قَرِیبًا مِنْ مَجْلِسِہِ ، فَیَقْرَأُ السَّجْدَۃَ ، فَلاَ یَسْجُدُ سَعِیدٌ وَقَدْ سَمِعَہَا ، قَالَ : فَقِیلَ لَہُ : فَمَا یَمْنَعُک مِنَ السُّجُودِ ؟ قَالَ : لَیْسَ إلَیْہِ جَلَسْتُ۔","","Musannaf Ibn Abi Shaybah 4248","","","كتاب الصلوات"
"4249","(۴۲۴۹) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، وَنَافِعٍ ، وَسَعِید بْنِ جُبَیْرٍ ، قَالُوا : مَنْ سَمِعَ السَّجْدَۃَ ، فَعَلَیْہِ أَنْ یَسْجُدَ۔","","Musannaf Ibn Abi Shaybah 4249","","","كتاب الصلوات"
"4250","(۴۲۵۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : دَخَلَ سَلْمَانُ الْفَارِسِیُّ الْمَسْجِدَ وَفِیہِ قَوْمٌ یَقْرَؤُونَ ، فَقَرَؤُوا السَّجْدَۃَ فَسَجَدُوا ، فَقَالَ لَہُ صَاحِبُہُ : یَا أَبَا عَبْدِ اللہِ ، لَوْلاَ أَتَیْنَا ہَؤُلاَئِ الْقَوْمَ ، فَقَالَ : مَا لِہَذَا غَدَوْنَا۔","Da'if","Musannaf Ibn Abi Shaybah 4250","","","كتاب الصلوات"
"4251","(۴۲۵۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ مُطَرِّفٍ ، قَالَ : سَأَلْتُہُ عَنِ الرَّجُلِ یَتَمَارَی فِی السَّجْدَۃِ ، أَسَمِعَہَا أَمْ لَمْ یَسْمَعْہَا ؟ قَالَ : وَسَمِعَہَا ، فَمَاذَا ؟ ثُمَّ قَالَ مُطَرِّفٌ : سَأَلْتُ عِمْرَانَ بْنَ حُصَیْنٍ عَنْ الرَّجُلِ لاَ یَدْرِی أَسَمِعَ السَّجْدَۃَ ، أَمْ لاَ ؟ قَالَ : وَسَمِعَہَا ، فَمَاذَا ؟۔","Sahih","Musannaf Ibn Abi Shaybah 4251","","","كتاب الصلوات"
"4252","(۴۲۵۲) حَدَّثَنَا وَکِیعٌ ، وَمُحَمَّدُ بْنُ بِشْرٍ ، عَنْ مِسْعَرٍ ، عَنْ عَطِیَّۃَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إنَّمَا السَّجْدَۃُ عَلَی مَنْ سَمِعَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 4252","","","كتاب الصلوات"
"4253","(۴۲۵۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ الْمُبَارَکِ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، وَالْحَسَنِ ، قَالاَ : قَالَ عُمَرُ : لَیْسَ فِی الْمُفَصَّلِ سُجُودٌ۔","Hasan","Musannaf Ibn Abi Shaybah 4253","","","كتاب الصلوات"
"4254","(۴۲۵۴) حَدَّثَنَا ہُشَیْمٌ، أَخْبَرَنَا خَالِدٌ، عَنِ أَبِی الْعُرْیَان الْمُجَاشِعِیِّ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: لَیْسَ فِی الْمُفَصَّلِ سُجُود۔","Sahih","Musannaf Ibn Abi Shaybah 4254","","","كتاب الصلوات"
"4255","(۴۲۵۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنِ الْحَسَنِ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ یَقُولُ : لَیْسَ فِی الْمُفَصَّلِ سُجُود۔","Sahih","Musannaf Ibn Abi Shaybah 4255","","","كتاب الصلوات"
"4256","(۴۲۵۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لَیْسَ فِی الْمُفَصَّلِ سُجُود۔","","Musannaf Ibn Abi Shaybah 4256","","","كتاب الصلوات"
"4257","(۴۲۵۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا خَالِدٌ ، عَنِ الْحَسَنِ ، کَانَ یَقُولُ : لَیْسَ فِی الْعَرَبِیِّ سُجُودٌ ، یَعْنِی الْمُفَصَّلَ۔","","Musannaf Ibn Abi Shaybah 4257","","","كتاب الصلوات"
"4258","(۴۲۵۸) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ، وَعِکْرِمَۃَ ، وَالْحَسَنِ ، قَالُوا : لَیْسَ فِی الْمُفَصَّلِ سُجُودٌ۔","","Musannaf Ibn Abi Shaybah 4258","","","كتاب الصلوات"
"4259","(۴۲۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَیْمَنِ بْنِ نَابِلٍ ، قَالَ : سَمِعْتُ طَاوُوسًا یَقُولُ : لَیْسَ فِی الْمُفَصَّلِ سُجُودُ۔","","Musannaf Ibn Abi Shaybah 4259","","","كتاب الصلوات"
"4260","(۴۲۶۰) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ قُسَیْطٍ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، قَالَ : قرَأْتُ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ النَّجْمَ ، فَلَمْ یَسْجُدْ۔ (بخاری ۱۰۷۳۔ ابوداؤد ۱۳۹۹)","Sahih","Musannaf Ibn Abi Shaybah 4260","","","كتاب الصلوات"
"4261","(۴۲۶۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ دَاوُدَ بْنِ قَیْسٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن عَطَائِ بْنِ یَسَارٍ ، قَالَ : سَأَلْتُ أُبَیَّ بْنَ کَعْبٍ : فِی الْمُفَصَّلِ سُجُودٌ ؟ قَالَ : لاَ۔","Sahih","Musannaf Ibn Abi Shaybah 4261","","","كتاب الصلوات"
"4262","(۴۲۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لَیْسَ فِی الْمُفَصَّلِ سُجُودٌ۔","","Musannaf Ibn Abi Shaybah 4262","","","كتاب الصلوات"
"4263","(۴۲۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ دَاوُدَ بْنِ قَیْسٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن عَطَائِ بْنِ یَسَارٍ ، عَنْ أُبَیِّ بْنِ کَعْبٍ ، قَالَ : لَیْسَ فِی الْمُفَصَّلِ سُجُودٌ۔","Sahih","Musannaf Ibn Abi Shaybah 4263","","","كتاب الصلوات"
"4264","(۴۲۶۴) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ بْنِ مُوسَی ، عَنْ عَطَائِ بْنِ مِینَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : سَجَدْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی {إذَا السَّمَائُ انْشَقَّتْ} ، وَ {اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ}۔ (مسلم ۱۰۸۔ احمد ۲/۴۶۱)","Sahih","Musannaf Ibn Abi Shaybah 4264","","","كتاب الصلوات"
"4265","(۴۲۶۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ أَبِی بَکْرِ بْنِ عَمْرِو بْنِ حَزْمٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَجَدَ فِی : {إذَا السَّمَائُ انْشَقَّتْ} ۔(ابن ماجہ ۱۰۵۹۔ احمد ۲/۲۴۷)","Sahih","Musannaf Ibn Abi Shaybah 4265","","","كتاب الصلوات"
"4266","(۴۲۶۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَلِیُّ بْنُ زَیْدِ بْنِ جُدْعَانَ ، عَنْ أَبِی رَافِعٍ ، قَالَ : صَلَّیْتُ خَلْفَ أَبِی ہُرَیْرَۃَ بِالْمَدِینَۃِ الْعِشَائَ الآخِرَۃَ ، قَالَ : فَقَرَأَ فِیہَا {إذَا السَّمَائُ انْشَقَّتْ} فَسَجَدَ فِیہَا ، فَقُلْتُ لَہُ : تَسْجُدُ فِیہَا ؟ فَقَالَ: رَأَیْت خَلِیلِی أَبَا الْقَاسِمِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَجَدَ فِیہَا ، فَلاَ أَدَعُ ذَلِکَ۔ (طحاوی ۳۵۷)","Da'if","Musannaf Ibn Abi Shaybah 4266","","","كتاب الصلوات"
"4267","(۴۲۶۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ ، عَنْ عَبْدِ اللہِ ، قَالَ : سَجَدَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی النَّجْمِ ، فَمَا بَقِیَ أَحَدٌ إِلاَّ سَجَدَ مَعَہُ ، إِلاَّ شَیْخًا أَخَذَ کَفًّا مِنْ تُرَابٍ ، فَرَفَعَہُ إلَی جَبْہَتِہِ ، قَالَ : فَلَقَدْ رَأَیْتُہُ قُتِلَ کَافِرًا۔ (بخاری ۳۹۷۲۔ ابوداؤد ۱۴۰۱)","Sahih","Musannaf Ibn Abi Shaybah 4267","","","كتاب الصلوات"
"4268","(۴۲۶۸) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ عَلِیِّ بْنِ سُوَیْد بْنِ مَنْجُوفٍ ، قَالَ : حَدَّثَنَا أَبُو رَافِعٍ الصَّائِغُ ، قَالَ : صَلَّی بِنَا عُمَرُ صَلاَۃَ الْعِشَائِ الآخِرَۃِ ، فَقَرَأَ فِی إحْدَی الرَّکْعَتَیْنِ الأُولَیَیْنِ: {إذَا السَّمَائُ انْشَقَّتْ} فَسَجَدَ ، وَسَجَدْنَا مَعَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4268","","","كتاب الصلوات"
"4269","(۴۲۶۹) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : رَأَیْتُ عُمَرَ ، وَعَبْدَ اللہِ یَسْجُدَانِ فِی {إذَا السَّمَائُ انْشَقَّتْ} ، أَوْ أَحَدَہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 4269","","","كتاب الصلوات"
"4270","(۴۲۷۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْمَسْعُودِیِّ ، عَنِ ابْنِ الأَصْبَہَانِیِّ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ، عَنِ ابْنِ مَسْعُودٍ؛ أَنَّہُ کَانَ یَسْجُدُ فِی {إذَا السَّمَائُ انْشَقَّتْ}۔","Da'if","Musannaf Ibn Abi Shaybah 4270","","","كتاب الصلوات"
"4271","(۴۲۷۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ دَاوُدَ ، عَنْ أَبِی الْعَالِیَۃِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَجَدَ فِی النَّجْمِ ، وَالْمُسْلِمُونَ۔","","Musannaf Ibn Abi Shaybah 4271","","","كتاب الصلوات"
"4272","(۴۲۷۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ بْنِ مَسْعُودٍ ؛ أَنَّہُ کَانَ یَسْجُدُ فِی الأَعْرَافِ ، وَبَنِی إسْرَائِیلَ ، وَالنَّجْمِ وَ : {اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ}۔","","Musannaf Ibn Abi Shaybah 4272","","","كتاب الصلوات"
"4273","(۴۲۷۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ سَجَدَ فِی النَّجْمِ وَ{اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ}۔","","Musannaf Ibn Abi Shaybah 4273","","","كتاب الصلوات"
"4274","(۴۲۷۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ شُعْبَۃَ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، قَالَ : عَزَائِمُ السُّجُودِ ؛ (الم تَنْزِیلُ) وَ(حم تَنْزِیلُ) وَ(النَّجْمُ) وَ{اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ}۔","","Musannaf Ibn Abi Shaybah 4274","","","كتاب الصلوات"
"4275","(۴۲۷۵) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَأَ (وَالنَّجْمِ) فَسَجَدَ فِیہَا الْمُسْلِمُونَ ، وَالْمُشْرِکُونَ ، وَالْجِنُّ ، وَالإِنْسُ۔","","Musannaf Ibn Abi Shaybah 4275","","","كتاب الصلوات"
"4276","(۴۲۷۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَاصِمٍ ، عَنْ قَسَامَۃَ بْنِ زُہَیْرٍ ، قَالَ : کَانَ یَسْجُدُ فِی النَّجْمِ ، وَ {إذَا السَّمَائُ انْشَقَّتْ}۔","","Musannaf Ibn Abi Shaybah 4276","","","كتاب الصلوات"
"4277","(۴۲۷۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، عَنْ سُلَیْمَانَ بْنِ حَبِیبٍ ، قَالَ : سَجَدْت مَعَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ فِی {إذَا السَّمَائُ انْشَقَّتْ}۔","","Musannaf Ibn Abi Shaybah 4277","","","كتاب الصلوات"
"4278","(۴۲۷۸) حَدَّثَنَا حَفْصٌ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ : رَأَیْتُ إبْرَاہِیمَ یَسْجُدُ فِی {إذَا السَّمَائُ انْشَقَّتْ}۔","","Musannaf Ibn Abi Shaybah 4278","","","كتاب الصلوات"
"4279","(۴۲۷۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ یَسْجُدُ فِی النَّجْمِ ، وَفِی {اقْرَأْ بِاسْمِ رَبِّک} إِلاَّ أَنْ یَقْرَأَ بِہِمَا فِی صَلاَۃٍ مَکْتُوبَۃٍ ، فَإِنَّہُ کَانَ لاَ یَسْجُدُ بِہِمَا وَیَرْکَعُ۔","Sahih","Musannaf Ibn Abi Shaybah 4279","","","كتاب الصلوات"
"4280","(۴۲۸۰) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قَرَأَ مُحَمَّدٌ : {إذَا السَّمَائُ انْشَقَّتْ} وَأَنَا جَالِسٌ فَسَجَدَ فِیہَا۔","","Musannaf Ibn Abi Shaybah 4280","","","كتاب الصلوات"
"4281","(۴۲۸۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، قَالَ : قَرَأَ عَمَّارٌ عَلَی الْمِنْبَرِ : {إذَا السَّمَائُ انْشَقَّتْ} ، ثُمَّ نَزَلَ إلَی الْقَرَارِ ، فَسَجَدَ بِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 4281","","","كتاب الصلوات"
"4282","(۴۲۸۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، عَنْ مَسْرُوقِ بْنِ الأَجْدَعِ ؛ أَنَّ عُثْمَانَ قَرَأَ فِی الْعِشَائِ بِالنَّجْمِ ، فَسَجَدَ۔","Da'if","Musannaf Ibn Abi Shaybah 4282","","","كتاب الصلوات"
"4283","(۴۲۸۳) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِی سَلَمَۃَ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: سَجَدَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالْمُسْلِمُونَ فِی (النَّجْمِ) إِلاَّ رَجُلَیْنِ مِنْ قُرَیْشٍ أَرَادَا بِذَلِکَ الشُّہْرَۃَ۔ (احمد ۲/۳۰۴)","Hasan","Musannaf Ibn Abi Shaybah 4283","","","كتاب الصلوات"
"4284","(۴۲۸۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : رَأَیْتُ عَبْدَ اللہِ یَسْجُدُ فِی {إذَا السَّمَائُ انْشَقَّتْ}۔","Sahih","Musannaf Ibn Abi Shaybah 4284","","","كتاب الصلوات"
"4285","(۴۲۸۵) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، سَمِعَ ابْنَ عَبَّاسٍ یَقُولُ : فِی (ص) سَجْدَۃٌ ، وَتَلاَ: (أُولَئِکَ الَّذِینَ ہَدَی اللَّہُ فَبِہُدَاہُمُ اقْتَدِہِ)۔","Sahih","Musannaf Ibn Abi Shaybah 4285","","","كتاب الصلوات"
"4286","(۴۲۸۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَبْدَۃَ ، وَصَدَقَۃَ ، سَمِعَا ابْنَ عُمَرَ یَقُولُ : فِی (ص) سَجْدَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 4286","","","كتاب الصلوات"
"4287","(۴۲۸۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : کُنْتُ لاَ أَسْجُدُ فِی (ص) حَتَّی حَدَّثَنِی السَّائِبُ أَنَّ عُثْمَانَ سَجَدَ فِیہَا۔","Sahih","Musannaf Ibn Abi Shaybah 4287","","","كتاب الصلوات"
"4288","(۴۲۸۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّ عُمَرَ کَانَ یسْجُدُ فِی (ص)۔","","Musannaf Ibn Abi Shaybah 4288","","","كتاب الصلوات"
"4289","(۴۲۸۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، وَالْعَوَّامُ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یَسْجُدُ فِی (ص) وَتَلاَ ہَذِہِ الآیَۃَ : {أُولَئِکَ الَّذِینَ ہَدَی اللَّہُ فَبِہُدَاہُمُ اقْتَدِہِ}۔ (بخاری ۳۴۲۲۔ ابوداؤد ۱۴۰۴)","Sahih","Musannaf Ibn Abi Shaybah 4289","","","كتاب الصلوات"
"4290","(۴۲۹۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْجُدُ فِی (ص)۔","Da'if","Musannaf Ibn Abi Shaybah 4290","","","كتاب الصلوات"
"4291","(۴۲۹۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الْعَوَّامُ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَأَ سُورَۃَ (ص) وَہُوَ عَلَی الْمِنْبَرِ ، فَلَمَّا أَتَی عَلَی السَّجْدَۃِ قَرَأَہَا ، ثُمَّ نَزَلَ فَسَجَدَ۔","","Musannaf Ibn Abi Shaybah 4291","","","كتاب الصلوات"
"4292","(۴۲۹۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، قَالَ : ہِیَ مُوجَبَۃٌ، سَجْدَۃُ (ص)۔","Sahih","Musannaf Ibn Abi Shaybah 4292","","","كتاب الصلوات"
"4293","(۴۲۹۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ، قَالَ : ذُکِرت عِنْدَ ابْنِ عَبَّاسٍ ، فَقَالَ : {أُولَئِکَ الَّذِینَ ہَدَی اللَّہُ فَبِہُدَاہُمُ اقْتَدِہِ}۔","Sahih","Musannaf Ibn Abi Shaybah 4293","","","كتاب الصلوات"
"4294","(۴۲۹۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : کَانَ طَاوُوس یَسْجُدُ فِی (ص)۔","","Musannaf Ibn Abi Shaybah 4294","","","كتاب الصلوات"
"4295","(۴۲۹۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، قَالَ : شَہِدْتُ الْحَسَنَ وَقَرَأَ السَّجْدَۃَ الَّتِی فِی (ص) فَسَجَدَ۔","","Musannaf Ibn Abi Shaybah 4295","","","كتاب الصلوات"
"4296","(۴۲۹۶) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ؛ أَنَّہُ کَانَ یَسْجُدُ فِی (ص)۔","","Musannaf Ibn Abi Shaybah 4296","","","كتاب الصلوات"
"4297","(۴۲۹۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ بْنِ عَمْرو ، عَنْ زَائِدَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : کَانَ أَبُو عَبْدِ الرَّحْمَنِ یَسْجُدُ فِی (ص)۔","","Musannaf Ibn Abi Shaybah 4297","","","كتاب الصلوات"
"4298","(۴۲۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ مُصْعَبِ بْنِ شَیْبَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : رَأَیْتُ الضَّحَّاکَ بْنَ قَیْسٍ یَسْجُدُ فِی (ص) ، قَالَ : فَذَکَرْتُہُ لابْنِ عَبَّاسٍ ، فَقَالَ : إِنَّہُ رَأَی عُمَرَ بْنَ الْخَطَّابِ یَسْجُدُ فِیہَا۔","Hasan","Musannaf Ibn Abi Shaybah 4298","","","كتاب الصلوات"
"4299","(۴۲۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ قَالَ : فِیہَا سَجْدَۃٌ ، ثُمَّ قَرَأَ : {أُولَئِکَ الَّذِینَ ہَدَی اللَّہُ فَبِہُدَاہُمُ اقْتَدِہِ}۔","Sahih","Musannaf Ibn Abi Shaybah 4299","","","كتاب الصلوات"
"4300","(۴۳۰۰) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ لاَ یَسْجُدُ فِی (ص) وَیَقُولُ : تَوْبَۃُ نَبِیٍّ۔","Da'if","Musannaf Ibn Abi Shaybah 4300","","","كتاب الصلوات"
"4301","(۴۳۰۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ، قَالَ : ذُکِرَتْ (ص) عِنْدَ عَبْدِ اللہِ ، فَقَالَ: تَوْبَۃُ نَبِیٍّ۔","Sahih","Musannaf Ibn Abi Shaybah 4301","","","كتاب الصلوات"
"4302","(۴۳۰۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ (ح) وَأَخْبَرَنَا دَاوُد ، عَنِ الشَّعْبِیِّ ، قَالاَ : کَانَ عَبْدُ اللہِ لاَ یَسْجُدُ فِی (ص) وَیَقُولُ : تَوْبَۃُ نَبِیٍّ۔","","Musannaf Ibn Abi Shaybah 4302","","","كتاب الصلوات"
"4303","(۴۳۰۳) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی مَعَنْ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : کَانَ بَعْضُ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْجُدُ فِی (ص) ، وَبَعْضُہُمْ لاَ یَسْجُدُ ، فَأَیَّ ذَلِکَ شِئْتَ فَافْعَلْ۔","Majhul","Musannaf Ibn Abi Shaybah 4303","","","كتاب الصلوات"
"4304","(۴۳۰۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدِ ، عَنْ ثَابِتِ بْنِ قَیْسٍ ، قَالَ : کَانَ أَبُو الْمَلِیحِ لاَ یَسْجُدُ فِی (ص)۔","","Musannaf Ibn Abi Shaybah 4304","","","كتاب الصلوات"
"4305","(۴۳۰۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : سَمِعْتُہُ یُحَدِّثُ عَنِ الضَّحَّاکِ بْنِ قَیْسٍ ؛ أَنَّہُ خَطَبَ فَقَرَأَ : (ص) فَسَجَدَ فِیہَا ، وَعَلْقَمَۃُ وَأَصْحَابُ عَبْدِ اللہِ وَرَائَہُ ، فَلَمْ یَسْجُدُوا۔","","Musannaf Ibn Abi Shaybah 4305","","","كتاب الصلوات"
"4306","(۴۳۰۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ؛ أَنَّ أَصْحَابَ عَبْدِ اللہِ کَانُوا لاَ یَسْجُدُونَ فِی (ص)۔","","Musannaf Ibn Abi Shaybah 4306","","","كتاب الصلوات"
"4307","(۴۳۰۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یَسْجُدُ فِی آخِرِ الآَیَتَیْنِ مِنْ (حم) السَّجْدَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 4307","","","كتاب الصلوات"
"4308","(۴۳۰۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ أَبِی وَائِلٍ ؛ أَنَّہُ کَانَ یَسْجُدُ فِی الآخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 4308","","","كتاب الصلوات"
"4309","(۴۳۰۹) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ یَسْجُدُ فِی الآخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 4309","","","كتاب الصلوات"
"4310","(۴۳۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ طَلْحَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَسْجُدُ فِی الآخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 4310","","","كتاب الصلوات"
"4311","(۴۳۱۱) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، قَالَ : کَانَ ابْنُ عَبَّاسٍ یَسْجُدُ بِالآخِرَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 4311","","","كتاب الصلوات"
"4312","(۴۳۱۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنِ الْحَکَمِ ، عَنْ رَجُلٍ مِنْ بَنِی سُلَیْمٍ ؛ أَنَّہُ سَمِعَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْجُدُ فِی (حم) بِالآَیَۃِ الأُولَی۔","Da'if","Musannaf Ibn Abi Shaybah 4312","","","كتاب الصلوات"
"4313","(۴۳۱۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَسْجُدُ بِالأُولَی۔","","Musannaf Ibn Abi Shaybah 4313","","","كتاب الصلوات"
"4314","(۴۳۱۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ أَبِی الضُّحَی، عَنْ مَسْرُوقٍ، قَالَ: کَانَ أَصْحَابُ عَبْدِاللہِ یَسْجُدُونَ بِالأُولَی۔","","Musannaf Ibn Abi Shaybah 4314","","","كتاب الصلوات"
"4315","(۴۳۱۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ؛ أَنَّہُ کَانَ یَسْجُدُ بِالآَیَۃِ الأُولَی مِنْ (حم)۔","","Musannaf Ibn Abi Shaybah 4315","","","كتاب الصلوات"
"4316","(۴۳۱۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، قَالَ : أَدْرَکْتُ إبْرَاہِیمَ ، وَأَبَا صَالِحٍ ، وَطَلْحَۃَ ، وَیَحْیَی ، وَزُبَیْدًا الْیَامِیَّ ؛ یَسْجُدُونَ بِالآَیَۃِ الأُولَی مِنْ (حم) السَّجْدَۃِ۔","","Musannaf Ibn Abi Shaybah 4316","","","كتاب الصلوات"
"4317","(۴۳۱۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ؛ أَنَّہُمَا کَانَا یَسْجُدَانِ بِالآَیَۃِ الأُولَی مِنْ (حم) السَّجْدَۃِ۔","","Musannaf Ibn Abi Shaybah 4317","","","كتاب الصلوات"
"4318","(۴۳۱۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنِ ابْنِ سِیرِینَ ، عَنِ ابْنِ عُمَرَ ، عَنْ عُمَرَ ؛ أَنَّہُ سَجَدَ فِی الْحَجِّ سَجْدَتَیْنِ ، ثُمَّ قَالَ : إنَّ ہَذِہِ السُّورَۃَ فُضِّلَتْ عَلَی سَائِرِ السُّوَرِ بِسَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4318","","","كتاب الصلوات"
"4319","(۴۳۱۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعد بْنِ إِبْرَاہِیمَ ، عَن ثَعْلَبَۃَ بْنِ عَبْدِ اللہِ بْنِ الأَصْعَرِ ؛ أَنَّہُ صَلَّی مَعَ عُمَرَ بْنِ الْخَطَّابِ ، فَقَرَأَ بِالْحَجِّ فَسَجَدَ فِیہَا سَجْدَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 4319","","","كتاب الصلوات"
"4320","(۴۳۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ یَزِیدَ بْنِ خُمَیْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ جُبَیْرِ بْنِ نُفَیْرٍ ، عَنْ أَبِیہِ ؛ أَنَّ أَبَا الدَّرْدَائِ سَجَدَ فِی الْحَجِّ سَجْدَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 4320","","","كتاب الصلوات"
"4321","(۴۳۲۱) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنْ أَبِی الْعَالِیَۃِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : فِی سُورَۃِ الْحَجِّ سَجْدَتَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 4321","","","كتاب الصلوات"
"4322","(۴۳۲۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرنَا أَبُو عَبْدِ اللہِ الْجُعْفِیُّ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ السُّلَمِیِّ ، عَنْ عَلِیٍّ ؛ أَنَّہُ سَجَدَ فِی الْحَجِّ سَجْدَتَیْنِ۔","Majhul","Musannaf Ibn Abi Shaybah 4322","","","كتاب الصلوات"
"4323","(۴۳۲۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ؛ أَنَّہُ کَانَ یَسْجُدُ فِی الْحَجِّ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4323","","","كتاب الصلوات"
"4324","(۴۳۲۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی رَوَّادٍ ، عَنْ رَجُلٍ مِنْ أَہْلِ الطَّائِفِ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ؛ أَنَّہُ سَجَدَ فِی الْحَجِّ سَجْدَتَیْنِ۔","Majhul","Musannaf Ibn Abi Shaybah 4324","","","كتاب الصلوات"
"4325","(۴۳۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ خَالِدِ بْنِ دِینَارٍ ، قَالَ : سَمِعْتُ أَبَا الْعَالِیَۃِ یَقُولُ : فِی الْحَجِّ سَجْدَتَانِ مُبَارَکَتَانِ طَیِّبَتَانِ۔","","Musannaf Ibn Abi Shaybah 4325","","","كتاب الصلوات"
"4326","(۴۳۲۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : أَدْرَکْتُ النَّاسَ مُنْذُ سَبْعِینَ سَنَۃً یَسْجُدُونَ فِی الْحَجِّ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4326","","","كتاب الصلوات"
"4327","(۴۳۲۷) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، وَأَبِی عَبْدِ الرَّحْمَنِ ؛ أَنَّہُمَا کَانَا یَسْجُدَانِ فِی الْحَجِّ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4327","","","كتاب الصلوات"
"4328","(۴۳۲۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ خَالِدٍ ، عَنْ أَبِی الْعُرْیَانِ الْمُجَاشِعِیِّ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: فِی الْحَجِّ سَجْدَۃٌ وَاحِدَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 4328","","","كتاب الصلوات"
"4329","(۴۳۲۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّہُ کَانَ یَقُولُ : فِی الْحَجِّ سَجْدَۃٌ وَاحِدَۃٌ۔","","Musannaf Ibn Abi Shaybah 4329","","","كتاب الصلوات"
"4330","(۴۳۳۰) حَدَّثَنَا ہُشَیْمٌ قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ ، قَالَ : فِی الْحَجِّ سَجْدَۃٌ وَاحِدَۃٌ۔","","Musannaf Ibn Abi Shaybah 4330","","","كتاب الصلوات"
"4331","(۴۳۳۱) حَدَّثَنَا ہُشَیْ[corrupt]ٌ ، عَنِ الْعَوَّامِ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ فِی السَّجْدَۃِ : ہِیَ السَّجْدَۃُ الأُولَی مِنْ سُورَۃِ الْحَجِّ۔","","Musannaf Ibn Abi Shaybah 4331","","","كتاب الصلوات"
"4332","(۴۳۳۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ ، قَالاَ : فِی الْحَجِّ سَجْدَۃٌ وَاحِدَۃٌ ، الأُولَی مِنْہُمَا۔n (۴۳۳۲) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ؛ أَنَّہُ قَالَ: لَیْسَ فِی الْحَجِّ إِلاَّ سَجْدَۃٌ وَاحِدَۃٌ، وَہِیَ الأُولَی۔","","Musannaf Ibn Abi Shaybah 4332","","","كتاب الصلوات"
"4333","(۴۳۳۳) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی مَعَنْ ، قَالَ : قُلْتُ لِجَابِرِ بْنِ زَیْد : رَجُلٌ سَجَدَ فِی الْحَجِّ سَجْدَتَیْنِ ؟ قَالَ : لاَ یَسْجُدُ إِلاَّ وَاحِدَۃً۔","","Musannaf Ibn Abi Shaybah 4333","","","كتاب الصلوات"
"4334","(۴۳۳۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، وَحَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ؛ فِی الرَّجُلِ یَسْمَعُ السَّجْدَۃَ وَہُوَ فِی الصَّلاَۃ ، قَالَ : لاَ یَسْجُدُ۔","","Musannaf Ibn Abi Shaybah 4334","","","كتاب الصلوات"
"4335","(۴۳۳۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یَسْجُدُ۔","","Musannaf Ibn Abi Shaybah 4335","","","كتاب الصلوات"
"4336","(۴۳۳۶) حَدَّثَنَا قَاسِمُ بْنُ مَالِکٍ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ؛ فِی الرَّجُلِ یَسْمَعُ السَّجْدَۃَ وَہُوَ یُصَلِّی ، قَالَ : لاَ یَسْجُدُ۔","","Musannaf Ibn Abi Shaybah 4336","","","كتاب الصلوات"
"4337","(۴۳۳۷) حَدَّثَنَا ابْنُ مُبَارَکِ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : لاَ تُدْخِلْ فِی صَلاَتِکَ صَلاَۃَ غَیْرِک۔","","Musannaf Ibn Abi Shaybah 4337","","","كتاب الصلوات"
"4338","(۴۳۳۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ خَالِدٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : یَسْجُدُ إذَا انْصَرَفَ۔","","Musannaf Ibn Abi Shaybah 4338","","","كتاب الصلوات"
"4339","(۴۳۳۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ عَنْ رَجُلٍ قَائِمٍ یُصَلِّی ، وَرَجُلٌ یُصَلِّی قَرِیبًا مِنْہُ ، فَقَرَأَ السَجْدَۃً ، أَیَسْجُدُ إذَا سَمِعَہَا ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 4339","","","كتاب الصلوات"
"4340","(۴۳۴۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَقُولُ : إذَا سَمِعَ الرَّجُلُ السَّجْدَۃَ وَہُوَ یُصَلِّی فَلْیَسْجُدْ۔","","Musannaf Ibn Abi Shaybah 4340","","","كتاب الصلوات"
"4341","(۴۳۴۱) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَلْحَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَسْجُدُ۔","","Musannaf Ibn Abi Shaybah 4341","","","كتاب الصلوات"
"4342","(۴۳۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : کَانَ أَصْحَابُ عَبْدِ اللہِ إذَا سَمِعُوا السَّجْدَۃَ سَجَدُوا ، فِی صَلاَۃٍ کَانُوا ، أَوْ غَیْرِہَا۔","","Musannaf Ibn Abi Shaybah 4342","","","كتاب الصلوات"
"4343","(۴۳۴۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ حَمَّادًا عَنِ الرَّجُلِ یُصَلِّی فَسَمِعَ السَّجْدَۃَ ؟ قَالَ : یَسْجُدُ ، وَقَالَ الْحَکَمُ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 4343","","","كتاب الصلوات"
"4344","(۴۳۴۴) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا سَمِعَ الرَّجُلُ السَّجْدَۃَ وَہُوَ یُصَلِّی ، فَلْیَخِرَّ سَاجِدًا۔","","Musannaf Ibn Abi Shaybah 4344","","","كتاب الصلوات"
"4345","(۴۳۴۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَقُولُ فِی الْجُنُبِ إذَا سَمِعَ السَّجْدَۃَ : یَغْتَسِلُ ثُمَّ یَقْرَؤُہَا فَیَسْجُدُ بِہَا ، وَإِنْ کَانَ لاَ یُحْسِنُہَا قَرَأَ غَیْرَہَا ، ثُمَّ سَجَدَ۔","Hasan","Musannaf Ibn Abi Shaybah 4345","","","كتاب الصلوات"
"4346","(۴۳۴۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ حَمَّادٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ، أَنَّہُمَا قَالاَ : إذَا سَمِعَ الْجُنُبُ السَّجْدَۃَ اغْتَسَلَ ، ثُمَّ سَجَدَ۔","","Musannaf Ibn Abi Shaybah 4346","","","كتاب الصلوات"
"4347","(۴۳۴۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَقُولُ فِی الْحَائِضِ تَسْمَعُ السَّجْدَۃَ ، قَالَ : لاَ تَسْجُدُ ، ہِیَ تَدَعُ مَا ہُوَ أَعْظَمُ مِنَ السَّجْدَۃِ ، الصَّلاَۃ الْمَکْتُوبَۃَ۔","","Musannaf Ibn Abi Shaybah 4347","","","كتاب الصلوات"
"4348","(۴۳۴۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ حَمَّادٍ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ ، وَإِبْرَاہِیمَ عَنِ الْحَائِضِ تَسْمَعُ السَّجْدَۃَ ؟ فَقَالاَ : لَیْسَ عَلَیْہَا سُجُودٌ ، الصَّلاَۃ أَکْبَرُ مِنْ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 4348","","","كتاب الصلوات"
"4349","(۴۳۴۹) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ لَہُ : أَرَأَیْتَ إِنْ مَرَّتْ حَائِضٌ بِقَوْمٍ یَقْرَؤُونَ الْمُصْحَفَ فَسَجَدُوا ، تَسْجُد مَعَہُمْ ؟ قَالَ : لاَ ، قَدْ مُنِعَتْ خَیْرًا مِنْ ذَلِکَ ،الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4349","","","كتاب الصلوات"
"4350","(۴۳۵۰) حَدَّثَنَا حَفْصٌ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ أَبِی الضُّحَی (ح) وَعَنْ إبْرَاہِیمَ ، قَالاَ : إذَا سَمِعَتِ الْحَائِضُ السَّجْدَۃَ فَلاَ تَسْجُدُ ، ہِیَ تَدَعُ أَوْجَبَ مِنْ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 4350","","","كتاب الصلوات"
"4351","(۴۳۵۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ؛ فِی الْجُنُبِ وَالْحَائِضِ یَسْمَعَانِ السَّجْدَۃَ، فَقَال: لاَ یَسْجُدَانِ۔","","Musannaf Ibn Abi Shaybah 4351","","","كتاب الصلوات"
"4352","(۴۳۵۲) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ أَبَانَ الْعَطَّارِ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عُثْمَانَ ، قَالَ : تُومِیئُ بِرَأْسِہَا إیمَائً۔","","Musannaf Ibn Abi Shaybah 4352","","","كتاب الصلوات"
"4353","(۴۳۵۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ، قَالَ: حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ، قَالَ : تُومِیئُ بِرَأْسِہَا وَتَقُولُ: اللَّہُمَّ لَکَ سَجَدْت۔","","Musannaf Ibn Abi Shaybah 4353","","","كتاب الصلوات"
"4354","(۴۳۵۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا زَکَرِیَّا بْنُ أَبِی زَائِدَۃَ ، قَالَ : أَخْبَرَنَا أَبُو الْحَسَنِ ، عَنْ رَجُلٍ ، زَعَمَ أَنَّہُ کَنَفْسِہِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : کَانَ عَبْدُ اللہِ بْنُ عُمَرَ یَنْزِلُ عَنْ رَاحِلَتِہِ فَیُہْرِیقُ الْمَائَ ، ثُمَّ یَرْکَبُ فَیَقْرَأُ السَّجْدَۃَ فَیَسْجُدُ ، وَمَا تَوَضَّأَ۔","Majhul","Musannaf Ibn Abi Shaybah 4354","","","كتاب الصلوات"
"4355","(۴۳۵۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو بِشْرٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَسْمَعُ السَّجْدَۃَ وَہُوَ عَلَی غَیْرِ وُضُوئٍ، فَلاَ سُجُودَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 4355","","","كتاب الصلوات"
"4356","(۴۳۵۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا سَمِعَہُ وَہُوَ غَیْرُ طَاہِرٍ فَلْیَتَوَضَّأْ ، ثُمَّ لِیَقْرَأْہَا فَیَسْجُدْ ، فَإِنْ کَانَ لاَ یُحْسِنُہَا قَرَأَ غَیْرَہَا ، ثُمَّ سَجَدَ۔","","Musannaf Ibn Abi Shaybah 4356","","","كتاب الصلوات"
"4357","(۴۳۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، قَالَ : فِی الرَّجُلِ یَقْرَأُ السَّجْدَۃَ وَہُوَ عَلَی غَیْرِ وُضُوئٍ ، قَالَ : یَسْجُدُ حَیْثُ کَانَ وَجْہُہُ۔","","Musannaf Ibn Abi Shaybah 4357","","","كتاب الصلوات"
"4358","(۴۳۵۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَسْمَعُ السَّجْدَۃَ وَلَیْسَ عَلَی وُضُوئٍ ، قَالَ : إِنْ کَانَ عِنْدَہُ مَائٌ تَوَضَّأَ وَسَجَدَ ، وَإِنْ لَمْ یَکُنْ عِنْدَہُ مَائٌ تَیَمَّمَ وَسَجَدَ۔","","Musannaf Ibn Abi Shaybah 4358","","","كتاب الصلوات"
"4359","(۴۳۵۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ مُحَمَّدِ بْنِ کُرَیْبٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی الرَّجُلِ یَقْرَأُ السَّجْدَۃَ وَہُوَ عَلَی غَیْرِ الْقِبْلَۃِ أَیَسْجُدُ ؟ قَالَ : نَعَمْ ، لاَ بَأْسَ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 4359","","","كتاب الصلوات"
"4360","(۴۳۶۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الأَعْمَشِ ، عَنْ عَطَائٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : کَانَ یَقْرَأُ السَّجْدَۃَ وَہُوَ عَلَی غَیْرِ الْقِبْلَۃِ وَہُوَ یَمْشِی ، فَیُومِیئُ بِرَأْسِہِ ، ثُمَّ یُسَلِّمُ۔","","Musannaf Ibn Abi Shaybah 4360","","","كتاب الصلوات"
"4361","(۴۳۶۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، قَالَ : سَمِعْتُ الْحَسَنَ وَقَرَأَ السَّجْدَۃَ الَّتِی فِی (ص) فَسَجَدَ عَلَی حَرْفِ أُسْطُوَانَۃٍ ، ثُمَّ قَالَ لِلْقَوْمِ : تَوَجَّہُوا۔","","Musannaf Ibn Abi Shaybah 4361","","","كتاب الصلوات"
"4362","(۴۳۶۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ؛ أَنَّہُ کَانَ یَقْرَأُ بِہَا وَہُوَ جَالِسٌ ، فَیَسْتَقْبِلُ الْقِبْلَۃَ وَیَسْجُدُ۔","","Musannaf Ibn Abi Shaybah 4362","","","كتاب الصلوات"
"4363","(۴۳۶۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا دَاوُد ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ کَانَ یَقُولُ : إذَا قَرَأَ الرَّجُلُ السَّجْدَۃَ بَعْدَ الْعَصْرِ وَبَعْدَ الْفَجْرِ ، فَلْیَسْجُدْ۔","","Musannaf Ibn Abi Shaybah 4363","","","كتاب الصلوات"
"4364","(۴۳۶۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ (ح) وَمُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، أَنَّہُمَا قَالاَ : اقْرَأْ وَاسْجُدْ مَا کُنْتَ فِی وَقْتٍ بَعْدَ الْعَصْرِ ، وَبَعْدَ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 4364","","","كتاب الصلوات"
"4365","(۴۳۶۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ عَنِ الرَّجُلِ یَقْرَأُ السَّجْدَۃَ بَعْدَ الْعَصْرِ ؟ فَقَالَ الْحَکَمُ : قَدِمَ عَلَیْنَا رَجَائُ بْنُ حَیْوَۃَ زَمَانَ بَشْرِ بْنِ مَرْوَانَ ، وَکَانَ قَاصَّ الْعَامَّۃِ ، فَکَانَ یَقْرَأُ السَّجْدَۃَ بَعْدَ الْعَصْرِ فَیَسْجُدُ، قَالَ شُعْبَۃُ : وَسَأَلْت حَمَّادًا ، فَقَالَ : إذَا کَانَ فِی وَقْتِ صَلاَۃٍ فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 4365","","","كتاب الصلوات"
"4366","(۴۳۶۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ جَابِرٍ ، عَنْ سَالِمٍ ، وَالْقَاسِمِ ، وَعَطَائٍ ، وَعَامِرٍ ؛ فِی الرَّجُلِ یَقْرَأُ السَّجْدَۃَ بَعْدَ الْعَصْرِ ، وَقَبْلَ أَنْ تَطْلُعَ الشَّمْسُ فَیَسْجُدُ ؟ قَالُوا : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 4366","","","كتاب الصلوات"
"4367","(۴۳۶۷) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : إذَا قَرَأْتَ الْقُرْآنَ فَأَتَیْت عَلَی السَّجْدَۃِ بَعْدَ الْعَصْرِ وَبَعْدَ الْغَدَاۃِ فَاسْجُدْ۔","","Musannaf Ibn Abi Shaybah 4367","","","كتاب الصلوات"
"4368","(۴۳۶۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : إنَّمَا یَمْنَعُہُمْ مِنْ ذَلِکَ الْکَسَلُ۔","","Musannaf Ibn Abi Shaybah 4368","","","كتاب الصلوات"
"4369","(۴۳۶۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ عُبَیْدِ اللہِ بْنِ مِقْسَمٍ ؛ أَنَّ قَاصًّا کَانَ یَقْرَأُ السَّجْدَۃَ بَعْدَ الْفَجْرِ فَیَسْجُدُ ، فَنَہَاہُ ابْنُ عُمَرَ فَأَبَی أَنْ یَنْتَہِیَ ، فَحَصَبَہُ ، وَقَالَ : إنَّہُمْ لاَ یَعْقِلُونَ۔","Hasan","Musannaf Ibn Abi Shaybah 4369","","","كتاب الصلوات"
"4370","(۴۳۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ ثَابِتِ بْنِ عُمَارَۃَ ، عَنْ أَبِی تَمِیمَۃَ الْہُجَیْمِیِّ ، قَالَ : کُنْتُ أَقْرَأُ السَّجْدَۃَ بَعْدَ الْفَجْرِ فَأَسْجُدُ ، فَأَرْسَلَ إلَیَّ ابْنُ عُمَرَ فَنَہَانِی۔","Hasan","Musannaf Ibn Abi Shaybah 4370","","","كتاب الصلوات"
"4371","(۴۳۷۱) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ سَعِیدُ بْنُ أَبِی الْحَسَنِ یَقْرَأُ بَعْدَ الْغَدَاۃِ ، فَیَمُرُّ بِالسَّجْدَۃِ فَیُجَاوِزُہَا ، فَإِذَا حَلَّتِ الصَّلاَۃ قَرَأَہَا وَسَجَدَ۔","","Musannaf Ibn Abi Shaybah 4371","","","كتاب الصلوات"
"4372","(۴۳۷۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مُبَارَکٍ ، قَالَ : رَأَیْتُ الْحَسَنَ قَرَأَ سَجْدَۃً بَعْدَ الْعَصْرِ ، فَلَمَّا غَابَتِ الشَّمْسُ قَرَأَہَا ، ثُمَّ سَجَدَ۔","","Musannaf Ibn Abi Shaybah 4372","","","كتاب الصلوات"
"4373","(۴۳۷۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا ثَابِتٌ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی عُتْبَۃَ ؛ أَنَّ أَبَا أَیُّوبَ کَانَ یُحَدِّثُ ، فَإِذَا بَزَغَتِ الشَّمْسُ قَرَأَ السَّجْدَۃَ فَسَجَدَ۔","Sahih","Musannaf Ibn Abi Shaybah 4373","","","كتاب الصلوات"
"4374","(۴۳۷۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سَلِیمِ بْنِ حَیَّانَ ، عَنْ أَبِی غَالِبٍ ؛ أَنَّ أَبَا أُمَامَۃَ کَانَ یَکْرَہُ الصَّلاَۃ بَعْدَ الْعَصْرِ حَتَّی تَغْرُبَ الشَّمْسُ ، وَبَعْدَ الْفَجْرِ حَتَّی تَطْلُعَ الشَّمْسُ ، وَکَانَ أَہْلُ الشَّامِ یَقْرَؤُونَ السَّجْدَۃَ بَعْدَ الْعَصْرِ ، فَکَانَ أَبُو أُمَامَۃَ إذَا رَأَی أَنَّہُمْ یَقْرَؤُونَ سُورَۃً فِیہَا سَجْدَۃٌ بَعْدَ الْعَصْرِ ، لَمْ یَجْلِسْ مَعَہُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 4374","","","كتاب الصلوات"
"4375","(۴۳۷۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ مُحَمَّدِ بْنِ سُوقَۃَ ، عَنِ نَافِع ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ سَمِعَ قَاصًّا یَقْرَأُ السَّجْدَۃَ قَبْلَ أَنْ تَحِلَّ الصَّلاَۃ ، فَسَجَدَ الْقَاصُّ وَمَنْ مَعَہُ ، فَأَخَذَ ابْنُ عُمَرَ بِیَدَیَّ ، فَلَمَّا أَضْحَی ، قَالَ لِی : یَا نَافِعُ ، اُسْجُدْ بِنَا السَّجْدَۃَ الَّتِی سَجَدَہَا الْقَوْمُ فِی غَیْرِ حِینِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 4375","","","كتاب الصلوات"
"4376","(۴۳۷۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ؛ أَنَّہُ کَانَ یَسْجُدُ اثْنَتَیْ عَشْرَۃَ سَجْدَۃً فِی الْقُرْآنِ ، الَّتِی یَسْجُدُونَ فِیہَا ، لَمْ یَذْکُرْ فِیہَا : {إذَا السَّمَائُ انْشَقَّتْ}۔","","Musannaf Ibn Abi Shaybah 4376","","","كتاب الصلوات"
"4377","(۴۳۷۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، قَالَ : عَدَّ عَلَیَّ مَسْرُوقٌ ثِنْتَیْ عَشْرَۃَ سَجْدَۃً فِی الْقُرْآنِ ، لَمْ یَذْکُرِ الَّتِی فِی {إذَا السَّمَائُ انْشَقَّتْ}۔","","Musannaf Ibn Abi Shaybah 4377","","","كتاب الصلوات"
"4378","(۴۳۷۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا خَالِدٌ ، عَنْ أَبِی الْعُرْیَانِ الْمُجَاشِعِیِّ ، عَنِ ابْنِ عَبَّاسٍ ، وَذَکَرُوا سُجُودَ الْقُرْآنِ ، فَقَالَ : الأَعْرَافُ ، وَالرَّعْدُ ، وَالنَّحْلُ ، وَبَنِی إسْرَائِیلَ ، وَمَرْیَمُ ، وَالْحَجُّ سَجْدَۃٌ وَاحِدَۃٌ ، وَالنَّمْلُ، وَالْفُرْقَانُ ، وَ(الم تَنْزِیلُ) ، وَ(حم تَنْزِیل) ، وَ(ص) ، وَقَالَ : وَلَیْسَ فِی الْمُفَصَّلِ سُجُودٌ۔","Sahih","Musannaf Ibn Abi Shaybah 4378","","","كتاب الصلوات"
"4379","(۴۳۷۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ بْنِ مَسْعُودٍ ؛ أَنَّہُ کَانَ یَسْجُدُ فِی الأَعْرَافِ ، وَبَنِی إسْرَائِیلَ ، وَالنَّجْمِ ، وَ{اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ} ، وَ{إذَا السَّمَائُ انْشَقَّتْ}۔","","Musannaf Ibn Abi Shaybah 4379","","","كتاب الصلوات"
"4380","(۴۳۸۰) حَدَّثَنَا ہُشَیْمٌ ، أَخْبَرَنَا أَبُو بِشْرٍ ، عَنْ یُوسُفَ الْمَکِّیِّ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ؛ أَنَّہُ قَالَ : عَزَائِمُ السُّجُودِ : (ألم تَنْزِیلُ) ، وَ(حٰمٓ تَنْزِیلُ) ، وَالأَعْرَافُ ، وَبَنِی إسْرَائِیلَ۔","","Musannaf Ibn Abi Shaybah 4380","","","كتاب الصلوات"
"4381","(۴۳۸۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ یُوسُفَ بْنِ مِہْرَانَ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ عَلِیٍّ ، قَالَ : عَزَائِمُ سُجُود الْقُرْآن : (ألم تَنْزِیلُ) السَّجْدَۃَ ، وَ(حم تَنْزِیلُ)السَّجْدَۃَ ، وَالنَّجْمُ ، وَ(اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ)۔","Da'if","Musannaf Ibn Abi Shaybah 4381","","","كتاب الصلوات"
"4382","(۴۳۸۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، یَعْنِی ابْنَ إیَاسٍ ، عَنْ جَعْفَرٍ ؛ أَنَّ سَعِیدَ بْنَ جُبَیْرٍ ، قَالَ : عَزَائِمُ السُّجُودِ : (الم تَنْزِیلُ) ، وَالنَّجْمُ ، وَ{اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ}۔","","Musannaf Ibn Abi Shaybah 4382","","","كتاب الصلوات"
"4383","(۴۳۸۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حَدَّثَنَا ثَابِتُ بْنُ عُمَارَۃَ ، عَنْ أَبِی تَمِیمَۃَ الْہُجَیْمِیِّ ؛ أَنَّ أَشْیَاخًا مِنْ بَنِی الہُجَیْمِ بَعَثُوا رَاکِبًا لَہُمْ إلَی الْمَدِینَۃِ وَإِلَی مَکَّۃَ ، لِیَسْأَلَ لَہُمْ عَنْ سُجُودِ الْقُرْآنِ ، فَرَجَعَ إلَیْہِمْ فَأَخْبَرَہُمْ أَنَّہُمْ أَجْمَعُوا عَلَی عَشْرِ سَجَدَاتٍ۔","","Musannaf Ibn Abi Shaybah 4383","","","كتاب الصلوات"
"4384","(۴۳۸۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : دَخَلْتُ الْمَسْجِدَ فَإِذَا أَنَا بِشَیْخَیْنِ یَقْرَأُ أَحَدُہُمَا عَلَی صَاحِبِہِ الْقُرْآنَ ، فَجَلَسْتُ إلَیْہِمَا ، فَإِذَا أَحَدُہُمَا قَیْسُ بْنُ السَّکَنِ الأَسَدِیُّ ، وَإِذَا الآَخَرُ یَقْرَأُ سُورَۃَ مَرْیَمَ ، فَلَمَّا بَلَغَ السَّجْدَۃَ قَالَ لَہُ قَیْسُ بْنُ سَکَنٍ : دَعْہَا ، فَإِنَّا نَکْرَہُ أَنْ یَرَانَا أَہْلُ الْمَسْجِدِ ، فَتَرَکَہَا وَقَرَأَ مَا بَعْدَہَا ، قَالَ قَیْسٌ : وَاللَّہِ مَا صَرَفَنَا عَنْہَا إِلاَّ شَیْطَانٌ ، اقْرَأْہَا ، فَقَرَأَہَا فَسَجَدنَا۔","","Musannaf Ibn Abi Shaybah 4384","","","كتاب الصلوات"
"4385","(۴۳۸۵) حَدَّثَنَا ہُشَیْمٌ ، وَعَلِیُّ بْنُ مُسْہِرٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانُوا یَکْرَہُونَ إذَا أَتَوْا عَلَی السَّجْدَۃِ أَنْ یُجَاوِزُوہَا حَتَّی یَسْجُدُوا۔","","Musannaf Ibn Abi Shaybah 4385","","","كتاب الصلوات"
"4386","(۴۳۸۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ إسْمَاعِیلَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَمُرُّ بِالسَّجْدَۃِ فِی الصَّلاَۃ ، فَقَالَ : لاَ یَنْبَغِی لَہُ أَنْ یَمَرَّ بِہَا فَیَتْرُکَہَا۔","","Musannaf Ibn Abi Shaybah 4386","","","كتاب الصلوات"
"4387","(۴۳۸۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ إسْمَاعِیلَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ یَنْبَغِی لَہُ إذَا مَرَّ بِہَا أَنْ یَتْرُکَہَا ، وَلَکِنْ یَسْجُدُ بِہَا ، وَإِنْ شَائَ رَکَعَ بِہَا۔","","Musannaf Ibn Abi Shaybah 4387","","","كتاب الصلوات"
"4388","(۴۳۸۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، قَالَ : حَدَّثَنَا بَکْرُ بْنُ عَبْدِ اللہِ الْمُزَنِیّ ، عَنْ صَفْوَانَ بْنِ مُحْرِزٍ ، قَالَ: بَیْنَا الأَشْعَرِیُّ یَخْطُبُ یَوْمَ الْجُمُعَۃِ إذْ قَرَأَ السَّجْدَۃَ الآخِرَۃَ مِنْ سُورَۃِ الْحَجِّ ، قَالَ : فَنَزَلَ عَنِ الْمِنْبَرِ ، فَسَجَدَ ثُمَّ عَادَ إلَی مَجْلِسِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4388","","","كتاب الصلوات"
"4389","(۴۳۸۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الْعَوَّامُ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَأَ سَجْدَۃَ سُورَۃِ (ص) عَلَی الْمِنْبَرِ ، فَلَمَّا أَتَی عَلَی السَّجْدَۃِ قَرَأَہَا ، ثُمَّ نَزَلَ فَسَجَدَ۔","","Musannaf Ibn Abi Shaybah 4389","","","كتاب الصلوات"
"4390","(۴۳۹۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو إِسْحَاقَ الْکُوفِی ، عَنِ الشَّعْبِیِّ ، عَنِ النُّعْمَانِ بْنِ بَشِیرٍ ؛ أَنَّہُ قَرَأَ سَجْدَۃَ (ص) وَہُوَ عَلَی الْمِنْبَرِ ، فَنَزَلَ فَسَجَدَ ، ثُمَّ عَادَ إلَی مَجْلِسِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 4390","","","كتاب الصلوات"
"4391","(۴۳۹۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، قَالَ : قَرَأَ عَمَّارٌ عَلَی الْمِنْبَرِ : (إذَا السَّمَائُ أنْشَقَّتْ) ، ثُمَّ نَزَلَ إلَی الْقَرَارِ ، فَسَجَدَ بِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 4391","","","كتاب الصلوات"
"4392","(۴۳۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ عُمَرَ قَرَأَہَا وَہُوَ عَلَی الْمِنْبَرِ ، ثُمَّ نَزَلَ فَسَجَدَ۔","Sahih","Musannaf Ibn Abi Shaybah 4392","","","كتاب الصلوات"
"4393","(۴۳۹۳) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ شُرَیْحٍ ، قَالَ : حدَّثَنِی وَاہِبٌ الْمَعَافِرِیُّ ، عَنْ أَوْسِ بْنِ بِشْرٍ، قَالَ : رَأَیْتُ عُقْبَۃَ بْنَ عَامِرٍ قَرَأَ عَلَی الْمِنْبَرِ السَّجْدَۃَ ، فَنَزَلَ فَسَجَدَ۔","Majhul","Musannaf Ibn Abi Shaybah 4393","","","كتاب الصلوات"
"4394","(۴۳۹۴) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ؛ فِی الْمَرْأَۃِ تَقْرَأُ السَّجْدَۃَ وَمَعَہَا رِجَالٌ ، أَوْ رَجُلٌ ، قَالَ : یَسْجُدُونَ قَبْلَہَا ، وَلاَ یَأْتَمُّونَ بِہَا۔","","Musannaf Ibn Abi Shaybah 4394","","","كتاب الصلوات"
"4395","(۴۳۹۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ عَنِ الْمَرْأَۃِ تَقْرَأُ السَّجْدَۃَ ؟ فَقَالَ : ہِیَ إمَامُک۔","","Musannaf Ibn Abi Shaybah 4395","","","كتاب الصلوات"
"4396","(۴۳۹۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ؛ أَنَّ غُلاَمًا قَرَأَ عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ السَّجْدَۃَ ، فَانْتَظَرَ الْغُلاَمُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یَسْجُدَ ، فَلَمَّا لَمْ یَسْجُدْ ، قَالَ : یَا رَسُولَ اللہِ ، أَلَیْسَ فِی ہَذِہِ السُّورَۃِ سَجْدَۃٌ ؟ قَالَ : بَلَی ، وَلَکِنَّک کُنْت إمَامَنَا فِیہَا ، فَلَوْ سَجَدْتَ لَسَجَدْنَا۔ (بیہقی ۳۲۴)","","Musannaf Ibn Abi Shaybah 4396","","","كتاب الصلوات"
"4397","(۴۳۹۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ سُلَیْمٍ أَبِی إِسْحَاقَ ، عَنْ سُلَیْمِ بْنِ حَنْظَلَۃَ ، قَالَ : قرَأْتُ عَلَی عَبْدِ اللہِ بْنِ مَسْعُودٍ سُورَۃَ بَنِی إسْرَائِیلَ ، فَلَمَّا بَلَغْتُ السَّجْدَۃَ ، قَالَ عَبْدُ اللہِ : اقْرَأْہَا ، فَإِنَّک إمَامُنَا فِیہَا۔","Hasan","Musannaf Ibn Abi Shaybah 4397","","","كتاب الصلوات"
"4398","(۴۳۹۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ؛ أَنَّ عَلْقَمَۃَ ، وَالأَسْوَدَ ، وَمَسْرُوقًا ، وَعَمْرَو بْنَ شُرَحبیلَ ؛ کَانُوا یَقُولُونَ : إذَا کَانَتِ السَّجْدَۃُ آخِرَ السُّورَۃِ ، أَجْزَأک أَنْ تَرْکَعَ بِہَا۔","","Musannaf Ibn Abi Shaybah 4398","","","كتاب الصلوات"
"4399","(۴۳۹۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا کَانَ فِی آخِرِ السُّورَۃِ سَجْدَۃٌ ، أَجْزَأک أَنْ تَرْکَعَ بِہَا۔","","Musannaf Ibn Abi Shaybah 4399","","","كتاب الصلوات"
"4400","(۴۴۰۰) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَقْرَأُ فِی الْعِشَائِ الآخِرَۃِ : (تَنْزِیلَ) السَّجْدَۃَ فَیَرْکَعُ بِالسَّجْدَۃِ۔","","Musannaf Ibn Abi Shaybah 4400","","","كتاب الصلوات"
"4401","(۴۴۰۱) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ عَبْدِالْمَلِکِ بْنِ أَبِی سُلَیْمَانَ، قَالَ: سَمِعْتُ الشَّعْبِیَّ، وَسُئِلَ عَنِ الرَّجُلِ یَقْرَأُ بِالسَّجْدَۃِ فَتَکُونُ فِی آخِرِ السُّورَۃِ ؟ فَقَالَ : إِنْ ہُوَ سَجَدَ بِہَا قَامَ فَقَرَأَ بَعْدَہَا ، وَإِنْ شَائَ أَنْ یَرْکَعَ بِہَا رَکَعَ بِہَا۔","","Musannaf Ibn Abi Shaybah 4401","","","كتاب الصلوات"
"4402","(۴۴۰۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، قَالَ : حَدَّثَنِی عُتْبَۃُ بْنُ قَیْسٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَانَ یَقْرَأُ السَّجْدَۃَ فِی بَنِی إسْرَائِیلَ ، وَمَا بَعْدَہَا ، ثُمَّ یَرْکَعُ۔","","Musannaf Ibn Abi Shaybah 4402","","","كتاب الصلوات"
"4403","(۴۴۰۳) حَدَّثَنَا عُبَیْدُاللہِ ، قَالَ: أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، عَنِ الرَّبِیعِ بْنِ خُثَیْمٍ، قَالَ : إذَا کَانَتِ السَّجْدَۃُ آخِرَ السُّورَۃِ ، فَإِنْ شِئْتَ فَارْکَعْ ، وَإِنْ شِئْتَ فَاسْجُدْ ، فَإِنَّ الرَّکْعَۃَ مَعَ السَّجْدَۃِ۔","","Musannaf Ibn Abi Shaybah 4403","","","كتاب الصلوات"
"4404","(۴۴۰۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَوَکِیعٌ ، قَالاَ : حَدَّثَنَا سُفْیَانُ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : سَأَلْنَا عَبْدَ اللہِ عَنِ السُّورَۃِ تَکُونُ فِی آخِرِہَا سَجْدَۃٌ ، أَیَرْکَعُ ، أَوْ یَسْجُدُ ؟ قَالَ : إذَا لَمْ یَکُنْ بَیْنَکَ وَبَیْنَ السَّجْدَۃِ إِلاَّ الرُّکُوعُ فَہُوَ قَرِیبٌ۔","Sahih","Musannaf Ibn Abi Shaybah 4404","","","كتاب الصلوات"
"4405","(۴۴۰۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا خَالِدٌ ، عَنْ أَبِی الْعَالِیَۃِ ، عَنْ عَائِشَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ فِی سُجُودِ الْقُرْآنِ : سَجَدَ وَجْہِی لِلَّذِی خَلَقَہُ وَصَوَّرَہُ ، وَشَقَّ سَمْعَہُ وَبَصَرَہُ ، بِحَوْلِہِ وَقُوَّتِہِ۔ (ترمذی ۵۸۰۔ احمد ۳۰)","","Musannaf Ibn Abi Shaybah 4405","","","كتاب الصلوات"
"4406","(۴۴۰۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ زِیَادِ بْنِ الْحُصَیْنِ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَقُولُ فِی سُجُودِہِ : اللَّہُمَّ لَکَ سَجَدَ سَوَادِی ، وَبِکَ آمَنَ فُؤَادِی ، اللَّہُمَّ اُرْزُقْنِی عِلْمًا یَنْفَعُنِی ، وَعَمَلاً یَرْفَعُنِی۔","Sahih","Musannaf Ibn Abi Shaybah 4406","","","كتاب الصلوات"
"4407","(۴۴۰۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ رَجُلٍ ، عَنْ أَبِی الْعَالِیَۃِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ فِی سُجُودِ الْقُرْآنِ بِاللَّیْلِ فِی السَّجْدَۃِ مِرَارًا : سَجَدَ وَجْہِی لِمَنْ خَلَقَہُ ، وَشَقَّ سَمْعَہُ وَبَصَرَہُ ، بِحَوْلِہِ وَقُوَّتِہِ۔ (ابوداؤد ۱۴۰۹۔ احمد ۲۱۷)","Majhul","Musannaf Ibn Abi Shaybah 4407","","","كتاب الصلوات"
"4408","(۴۴۰۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ؛ أَنَّہُ کَانَ یَقُولُ إذَا قَرَأَ السَّجْدَۃَ {سُبْحَانَ رَبِّنَا إِنْ کَانَ وَعْدُ رَبِّنَا لَمَفْعُولاً} ، سُبْحَانَ اللہِ وَبِحَمْدِہِ ، سُبْحَانَ اللہِ وَبِحَمْدِہِ ، ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 4408","","","كتاب الصلوات"
"4409","(۴۴۰۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : دَخَلْتُ الْمَسْجِدَ فَإِذَا أَنَا بِشَیْخَیْنِ یَقْرَأُ أَحَدُہُمَا عَلَی صَاحِبِہِ الْقُرْآنَ ، فَجَلَسْتُ إلَیْہِمَا فَإِذَا أَحَدُہُمَا قَیْسُ بْنُ سَکَنِ الأَسَدِیُّ ، وَالأَخَرُ یَقْرَأُ عَلَیْہِ سُورَۃَ مَرْیَمَ ، فَلَمَّا بَلَغَ السَّجْدَۃَ ، قَالَ لَہُ قَیْسٌ : دَعْہَا ، فَإِنَّا نَکْرَہُ أَنْ یَرَانَا أَہْلُ الْمَسْجِدِ ، فَتَرَکَہَا وَقَرَأَ مَا بَعْدَہَا ، ثُمَّ قَالَ قیْسٌ : وَاللَّہِ مَا صَرَفَنَا عَنْہَا إِلاَّ الشَّیْطَانُ ، اقْرَأْہَا ، فَقَرَأَہَا فَسَجَدْنَا ، فَلَمَّا رَفَعْنَا رُؤُوسَنَا ، قَالَ لَہُ قَیْسٌ : تَدْرِی مَا کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ إذَا سَجَدَ ؟ قَالَ : نَعَمْ ، کَانَ یَقُولُ : سَجَدَ وَجْہِی لِمَنْ خَلَقَہُ ، وَشَقَّ سَمْعَہُ وَبَصَرَہُ ، قَالَ : صَدَقْت ، وَبَلَغَنِی أَنَّ دَاوُد عَلَیْہِ السَّلاَمُ کَانَ یَقُولُ : سَجَدَ وَجْہِی مُتَعَفِّرًا فِی التُّرَابِ لِخَالِقِی وَحُقَّ لَہُ ، ثُمَّ قَالَ : سُبْحَانَ اللہِ ! مَا أَشْبَہَ کَلاَمَ الأَنْبِیَائِ بَعْضَہُم بِبَعض۔","Da'if","Musannaf Ibn Abi Shaybah 4409","","","كتاب الصلوات"
"4410","(۴۴۱۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَرَأَ عَبْدُ اللہِ السَّجْدَۃَ فَسَجَدَ ، قَالَ إبْرَاہِیمُ: فَحَدَّثَنِی مَنْ سَمِعَہُ یَقُولُ فِی سُجُودِہِ : لَبَّیْکَ وَسَعْدَیْکَ ، وَالْخَیْرُ فِی یَدَیْک۔","Majhul","Musannaf Ibn Abi Shaybah 4410","","","كتاب الصلوات"
"4411","(۴۴۱۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ؛ أَنَّ إبْرَاہِیمَ لَبَّی وَہُوَ سَاجِدٌ۔","","Musannaf Ibn Abi Shaybah 4411","","","كتاب الصلوات"
"4412","(۴۴۱۲) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : قَرَأْتُ سَجْدَۃً فَسَجَدْت بِہَا ، فَأَضَفْتُ إلَیْہَا سَجْدَۃً أُخْرَی نَاسِیًا ؟ قَالَ : اُسْجُدْ سَجْدَتَیِ السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 4412","","","كتاب الصلوات"
"4413","(۴۴۱۳) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ قَرَأَ السَّجْدَۃَ وَہُوَ فِی صَلاَۃٍ مَکْتُوبَۃٍ ، فَسَجَدَ سَجْدَتَیْنِ ، قَالَ : یَسْجُدُ سَجْدَتَیْنِ إذَا فَرَغَ۔","","Musannaf Ibn Abi Shaybah 4413","","","كتاب الصلوات"
"4414","(۴۴۱۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی زِیَادٍ ، قَالَ : قُلْتُ لِسَعِیدِ بْنِ جُبَیْرٍ : قَرَأْتُ السَّجْدَۃَ وَأَنَا سَاجِدٌ ، أَسْجُدُ ؟ قَالَ : لاَ ، وَلِمَ تَقْرَأُ وَأَنْتَ سَاجِدٌ ؟۔","","Musannaf Ibn Abi Shaybah 4414","","","كتاب الصلوات"
"4415","(۴۴۱۵) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ حَاتِمِ بْنِ أَبِی صَغِیرَۃَ ، قَالَ : قُلْتُ لِعَبْدِ اللہِ بْنِ أَبِی مُلَیْکَۃَ : قَرَأْتُ السَّجْدَۃَ وَأَنَا أَطُوفُ بِالْبَیْتِ فَکَیْفَ تَرَی ؟ قَالَ : آمُرُک أَنْ تَسْجُدَ ، قُلْتُ : إذَا تَرَکَنِی النَّاسُ وَہُمْ یَطُوفُونَ، فَیَقُولُونَ : مَجْنُونٌ ، أَفَأَسْتَطِیعُ أَنْ أَسْجُدَ وَہُمْ یَطُوفُونَ ؟ فَقَالَ : وَاللَّہِ لَئِنْ قُلْتَ ذَلِکَ لَقَدْ قَرَأَ ابْنُ الزُّبَیْرِ السَّجْدَۃَ فَلَمْ یَسْجُدْ ، فَقَامَ الْحَارِثُ بْنُ أَبِی رَبِیعَۃَ فَقَرَأَ السَّجْدَۃَ ثُمَّ جَائَ فَجَلَسَ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ، مَا مَنَعَک أَنْ تَسْجُدَ قُبَیْلُ حَیْثُ قَرَأْتَ السَّجْدَۃَ ؟ فَقَالَ : لأَیِّ شَیْئٍ أَسْجُدُ ؟ إنِّی لَوْ کُنْت فِی صَلاَۃٍ سَجَدْت ، فَأَمَّا إذَا لَمْ أَکُنْ فِی صَلاَۃٍ فَإِنِّی لاَ أَسْجُدُ ، قَالَ : وَسَأَلْتُ عَطَائً عَنْ ذَلِکَ ؟ فَقَالَ : اسْتَقْبِلِ الْبَیْتَ وَأَوْمِیئْ بِرَأْسِک۔","","Musannaf Ibn Abi Shaybah 4415","","","كتاب الصلوات"
"4416","(۴۴۱۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ فِی الرَّجُلِ یَقْرَأُ السَّجْدَۃَ وَہُوَ یَطُوفُ بِالْبَیْتِ ، قَالَ : یُومِیئُ ، أَوْ قَالَ : یَسْجُدُ۔","","Musannaf Ibn Abi Shaybah 4416","","","كتاب الصلوات"
"4417","(۴۴۱۷) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : قَرَأَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی صَلاَۃٍ مَکْتُوبَۃٍ سَجْدَۃً ، ثُمَّ سَجَدَ۔","Da'if","Musannaf Ibn Abi Shaybah 4417","","","كتاب الصلوات"
"4418","(۴۴۱۸) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، قَالَ : بَلَغَنِی عَنْ أَبِی مِجْلَزٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَأَ فِی صَلاَۃِ الظُّہْرِ سَجْدَۃ فَسَجَدَ ، فَرَأَوْا أَنَّہُ قَرَأَ : (ألم تَنْزِیلُ) السَّجْدَۃَ۔","Majhul","Musannaf Ibn Abi Shaybah 4418","","","كتاب الصلوات"
"4419","(۴۴۱۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا التَّیْمِیُّ ، عَنْ أَبِی مِجْلَزٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ بِمِثْلِہِ ، قَالَ : وَلَمْ یَسْمَعْہُ التَّیْمِیُّ مِنْ أَبِی مِجْلَزٍ۔","","Musannaf Ibn Abi Shaybah 4419","","","كتاب الصلوات"
"4420","(۴۴۲۰) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ إیَاسِ بْنِ دَغْفَلٍ ، عَنْ أَبِی حَکِیمَۃَ ؛ أَنَّ ابْنَ عُمَرَ صَلَّی بِأَصْحَابِہِ الظُّہْرَ، فَسَجَدَ فِیہَا۔","Sahih","Musannaf Ibn Abi Shaybah 4420","","","كتاب الصلوات"
"4421","(۴۴۲۱) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ، قَالَ : أَخْبَرَنِی مَنْ رَأَی ابْنَ الزُّبَیْرِ فِی حَائِطٍ مِنْ حِیطَانِ مَکَّۃَ ، قَالَ : فَصَلَّی الْعَصْرَ ، أَوِ الظُّہْرَ ، قَالَ : فَسَجَدَ ، فَقَالَ لَہُ رَجُلٌ : إنَّک صَلَّیْت خَمْسَ رَکَعَاتٍ ، فَقَالَ : إنِّی قَرَأْتُ سُورَۃً فِیہَا سَجْدَۃٌ۔","Majhul","Musannaf Ibn Abi Shaybah 4421","","","كتاب الصلوات"
"4422","(۴۴۲۲) حَدَّثَنَا وَکِیعٌ ، وَالْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ ؛ أَنَّ ابْنَ مَسْعُودٍ قَرَأَ فِی الظُّہْرِ: (ألم تَنْزِیلُ) السَّجْدَۃَ ، وَفِی الأُخْرَی بِسُورَۃٍ مِنَ الْمَثَانِی۔","","Musannaf Ibn Abi Shaybah 4422","","","كتاب الصلوات"
"4423","(۴۴۲۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ: لاَ تَقْرَأُ السَّجْدَۃَ فِی شَیْئٍ مِنَ الْمَکْتُوبَۃِ إِلاَّ فِی صَلاَۃِ الْفَجْرِ ، وَکَانَ إبْرَاہِیمُ یَسْتَحِبُّ یَوْمَ الْجُمُعَۃِ أَنْ یَقْرَأَ بِسُورَۃٍ فِیہَا سَجْدَۃٌ۔","","Musannaf Ibn Abi Shaybah 4423","","","كتاب الصلوات"
"4424","(۴۴۲۴) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عِمْرَانَ بن حُدیر ، عَنْ أَبِی مِجْلَزٍ ؛ أَنَّہُ کَانَ لاَ یَسْجُدُ فِی صَلاَۃٍ مَکْتُوبَۃٍ ، وَیَقُولُ : أَکْرَہُ أَنْ أَزِیدَ فِی صَلاَۃٍ مَکْتُوبَۃٍ۔","","Musannaf Ibn Abi Shaybah 4424","","","كتاب الصلوات"
"4425","(۴۴۲۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ ، قَالَ : جَائَ رَجُلٌ إلَی عُمَرَ ، فَقَالَ: إنَّ فُلاَنًا صَلَّی بِنَا الْفَجْرَ فَقَرَأَ بِسُورَۃٍ سَجَدَ فِیہَا ، فَقَالَ لَہُ عُمَرُ : أَوَقَدْ فَعَلَ ؟ قَالَ : نَعَمْ ، فَصَلَّی عُمَرُ مِنَ الْغَدِ ، فَقَرَأَ بِالنَّحْلِ وَبَنِی إسْرَائِیلَ ، فَسَجَدَ فِیہِمَا جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 4425","","","كتاب الصلوات"
"4426","(۴۴۲۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَلِیِّ بْنِ زَیْدِ بْنِ جُدْعَانَ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، عَنْ مَسْرُوقِ بْنِ الأَجْدَعِ ، قَالَ : صَلَّیْتُ مَعَ عُثْمَانَ الْعِشَائَ الآخِرَۃَ ، فَقَرَأَ بِالنَّجْمِ فَسَجَدَ فِیہَا ، ثُمَّ قَامَ فَقَرَأَ : وَالتِّینِ وَالزَّیْتُونِ۔","Da'if","Musannaf Ibn Abi Shaybah 4426","","","كتاب الصلوات"
"4427","(۴۴۲۷) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : حدَّثَنَا عَلِیُّ بْنُ سُوَیْد بْنِ مَنْجُوفٍ ، قَالَ : حدَّثَنَا أَبُو رَافِعٍ ، قَالَ : صَلَّی بِنَا عُمَرُ الْعِشَائَ الآخِرَۃَ ، فَقَرَأَ فِی إحْدَی الرَّکْعَتَیْنِ : {إذَا السَّمَائُ انْشَقَّتْ} فَسَجَدَ ، وَسَجَدْنَا مَعَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4427","","","كتاب الصلوات"
"4428","(۴۴۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی خَلْدَۃَ ، قَالَ : قُلْتُ لأَبِی الْعَالِیَۃِ : صَلَّیْتُ فِی مَسْجِدِ بَنِی فُلاَنٍ ، فَقَرَأَ إمَامُہُمُ السَّجْدَۃَ فَلَمْ یَسْجُدْ ، قَالَ : أَفَلاَ سَجَدْتَ ؟۔","","Musannaf Ibn Abi Shaybah 4428","","","كتاب الصلوات"
"4429","(۴۴۲۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ؛ أَنَّہُ سَمِعَ عَبْدَ الرَّحْمَن الأَعْرَجَ یَقُولُ : کَانَ أَبُو ہُرَیْرَۃَ یَسْجُدُ فِی {إذَا السَّمَائُ انْشَقَّتْ} فَإِذَا قُرِئَتْ وَکَانَ خَلْفَ الإِمَام فَلَمْ یَسْجُدِ الإِمَامُ ، قَالَ : فَیُومِیئُ بِرَأْسِہِ أَبُو ہُرَیْرَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 4429","","","كتاب الصلوات"
"4430","(۴۴۳۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ أَبِی عَمْرٍو مَوْلَی الْمُطَّلِبِ ؛ أَنَّہُ حَدَّثَہُمْ ، قَالَ : إنِّی لَقَاعِدٌ مَعَ ابْنِ عُمَرَ یَوْمَ الْجُمُعَۃِ إلَی حُجْرَۃِ عَائِشَۃَ ، وَطَارِقٌ یَخْطُبُ النَّاسَ عَلَی الْمِنْبَرِ ، فَقَرَأَ (النَّجْمَ) ، فَلَمَّا فَرَغَ وَقَعَ ابْنُ عُمَرَ سَاجِدًا ، وَسَجَدْنَا مَعَہُ ، وَمَا یَتَحَرَّک الأَخَرُ۔","Majhul","Musannaf Ibn Abi Shaybah 4430","","","كتاب الصلوات"
"4431","(۴۴۳۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ نَسِیَ سَجْدَۃً مِنْ أول صَلاَتِہِ فَلَمْ یَذْکُرْہَا حَتَّی کَانَ فِی آخِرِ رَکْعَۃٍ مِنْ صَلاَتِہِ ، قَالَ : یَسْجُدُ فِیہَا ثَلاَثَ سَجَدَاتٍ ، فَإِنْ لَمْ یَذْکُرْہَا حَتَّی یَقْضِیَ صَلاَتَہُ غَیْرَ أَنَّہُ لَمْ یُسَلِّمْ بَعْدُ ، قَالَ : یَسْجُدُ سَجْدَۃً وَاحِدَۃً مَا لَمْ یَتَکَلَّمْ ، فَإِنْ تَکَلَّمَ اسْتَأْنَفَ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4431","","","كتاب الصلوات"
"4432","(۴۴۳۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا نَسِیَ الرَّجُلُ سَجْدَۃً مِنَ الصَّلاَۃ ، فَلْیَسْجُدْہَا مَتَی مَا ذَکَرَہَا فِی صَلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 4432","","","كتاب الصلوات"
"4433","(۴۴۳۳) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ فِی الرَّجُلِ یَشُکُّ فِی سَجْدَۃٍ وَہُوَ جَالِسٌ لاَ یَدْرِی سَجَدَہَا أَمْ لاَ ، قَالَ مُجَاہِدٌ : إِنْ شِئْتَ فَاسْجُدْہَا ، فَإِذَا قَضَیْتَ صَلاَتَکَ ، فَاسْجُدْ سَجْدَتَیْنِ وَأَنْتَ جَالِسٌ ، وَإِنْ شِئْتَ فَلاَ تَسْجُدْہَا ، وَاسْجُدْ سَجْدَتَیْنِ وَأَنْتَ جَالِسٌ فِی آخِرِ صَلاَتِک۔","","Musannaf Ibn Abi Shaybah 4433","","","كتاب الصلوات"
"4434","(۴۴۳۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا سَمِعَ السَّجْدَۃَ وَہُوَ رَاکِعٌ ، أَوْ سَاجِدٌ ، أَجْزَأَہُ رُکُوعُہُ وَسُجُودُہُ مِنَ السُّجُودِ بِہَا۔","","Musannaf Ibn Abi Shaybah 4434","","","كتاب الصلوات"
"4435","(۴۴۳۵) حَدَّثَنَا جَرِیرٌ، عَنْ مَنْصُورٍ، عَنْ إِبْرَاہِیمَ، عَن عَلْقَمَۃَ، عَنْ عَبْدِاللہِ، قَالَ: صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلاَۃً فَزَادَ ، أَوْ نَقَصَ ، فَلَمَّا سَلَّمَ وَأَقْبَلَ عَلَی الْقَوْمِ بِوَجْہِہِ ، قَالُوا: یَا رَسُولَ اللہِ ، حَدَثَ فِی الصَّلاَۃ شَیْئٌ؟ قَالَ : وَمَا ذَاکَ ؟ قَالُوا : صَلَّیْتَ کَذَا وَکَذَا ، فَثَنَی رِجْلَہُ فَسَجَدَ سَجْدَتَیْنِ ، ثُمَّ سَلَّمَ وَأَقْبَلَ عَلَی الْقَوْمِ بِوَجْہِہِ ، فَقَالَ : إِنَّہُ لَوْ حَدَثَ فِی الصَّلاَۃ شَیْئٌ أَنْبَأْتُکُمْ بِہِ ، وَلَکِنِّی بَشَرٌ أَنْسَی کَمَا تَنْسَوْنَ ، فَإِذَا نَسِیتُ فَذَکِّرُونِی ، فَإِذَا سَہَا أَحَدُکُمْ فِی صَلاَتِہ فَلْیَتَحَرَّ الصَّوَابَ فَلْیُتِمَّ عَلَیْہِ ، فَإِذَا سَلَّمَ سَجَدَ سَجْدَتَیْنِ۔ (بخاری ۴۰۱۔ ابوداؤد ۱۰۱۲)","Sahih","Musannaf Ibn Abi Shaybah 4435","","","كتاب الصلوات"
"4436","(۴۴۳۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن عَطَائِ بْنِ یَسَارٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا شَکَّ أَحَدُکُمْ فِی صَلاَتِہِ فَلْیُلْغ الشَّکَّ ، وَیَبْنِ عَلَی الْیَقِینِ ، فَإِذَا اسْتَیْقَنَ التَّمَامَ رَکَعَ رَکْعَۃً وَسَجَدَ سَجْدَتَیْنِ ، فَإِنْ کَانَتْ صَلاَتُہُ تَامَّۃً ، کَانَتِ الرَّکْعَۃُ وَالسَّجْدَتَانِ نَافِلَۃً ، وَإِنْ کَانَتْ نَاقِصَۃً کَانَتِ الرَّکْعَۃُ تَمَامَ صَلاَتِہِ ، وَالسَّجْدَتَانِ یُرْغِمَانِ الشَّیْطَانَ۔ (ابوداؤد ۱۰۱۶۔ احمد ۳/۸۴)","Hasan","Musannaf Ibn Abi Shaybah 4436","","","كتاب الصلوات"
"4437","(۴۴۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ ، قَالَ : صَلَّیْتُ مَعَ عُمَرَ أَرْبَعًا قَبْلَ الظُّہْرِ فِی بَیْتِہِ ، وَقَالَ : إذَا أَوْہَمْتَ فَکُنْ فِی زِیَادَۃٍ ، وَلاَ تَکُنْ فِی نُقْصَانٍ۔","Sahih","Musannaf Ibn Abi Shaybah 4437","","","كتاب الصلوات"
"4438","(۴۴۳۸) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ ، قَالَ : قَالَ عَلِیٌّ : إذَا شَکَّ فِی الزِّیَادَۃِ وَالنُّقْصَانِ فَلْیُصَلِّ رَکْعَۃً ، فَإِنَّ اللَّہَ لاَ یُعَذِّبُ عَیََ زِیَادَۃٍ فِی صَلاَۃ ، فَإِنْ کَانَتْ تَمَامًا کَانَتْ لَہُ ، وَإِنْ کَانَتْ زِیَادَۃً کَانَتْ لَہُ۔","","Musannaf Ibn Abi Shaybah 4438","","","كتاب الصلوات"
"4439","(۴۴۳۹) حَدَّثَنَا أَبُو الأَحْوَصِ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ: إذَا شَکَکْتَ فَلَمْ تَدْرِ، أَتْمَمْتَ، أَوْ لَمْ تُتِمَّ ، فَأَتْمِمْ مَا شَکَکْتَ ، فَإِنَّ اللَّہَ لاَ یُعَذِّبُ عَلَی الزِّیَادَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 4439","","","كتاب الصلوات"
"4440","(۴۴۴۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ خُصَیْفٍ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : إذَا شَکَّ أَحَدُکُمْ فِی صَلاَتِہِ ، فَلْیَتَحَرَّ أَکْثَرَ ظَنِّہِ ، فَلْیَبْنِ عَلَیْہِ ، فَإِنْ کَانَ أَکْثَرُ ظَنِّہِ أَنَّہُ صَلَّی ثَلاَثًا ، فَلْیَرْکَعْ رَکْعَۃً ، وَیَسْجُدْ سَجْدَتَیْنِ ، وَإِنْ کَانَ ظَنُّہُ أَرْبَعًا فَلْیَسْجُدْ سَجْدَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 4440","","","كتاب الصلوات"
"4441","(۴۴۴۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الْحَجَّاجِ ، عَنِ الْحَکَمِ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : یَتَحَرَّی وَیَسْجُدُ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4441","","","كتاب الصلوات"
"4442","(۴۴۴۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ أَیُّوبَ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ کَانَ یَقُولُ: یَتَوَخَّی الَّذِی یُرَی أَنَّہُ نَقَصَ فَیُتِمَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4442","","","كتاب الصلوات"
"4443","(۴۴۴۳) حَدَّثَنَا عَبْدَۃُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَالِمٍ ، قَالَ : إذَا شَکَّ فَلَمْ یَدْرِ أَثَلاَثًا صَلَّی أَمْ أَرْبَعًا ، فَلْیَرْمِ بِالشَّکِّ وَیَسْجُدْ سَجْدَتَیْنِ ، فَذَکَرْتُ ذَلِکَ لِلْقَاسِمِ ، فَقَالَ : وَأَنَا کَذَاکَ أَقُولُ ، وَأَنَا کَذَاکَ أَقُولُ۔","","Musannaf Ibn Abi Shaybah 4443","","","كتاب الصلوات"
"4444","(۴۴۴۴) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنِی مَالِکُ بْنُ أَنَسٍ ، عَنْ عَفِیفِ بْنِ عَمْرٍو السَّہْمِیِّ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، قَالَ : سَأَلْتُ عَبْدَ اللہِ بْنَ عَمْرِو بْنِ الْعَاصِ ، وَکَعْبًا عَنِ الَّذِی یَشُکُّ فِی صَلاَتِہِ ، صَلَّی ثَلاَثًا ، أَوْ أَرْبَعًا ؟ فَکِلاَہُمَا قَالَ : لِیَقُمْ فَلْیُصَلِّ رَکْعَۃً ، ثُمَّ یَسْجُدْ سَجْدَتَیْنِ ، إذَا صَلَّی وَہُوَ جَالِسٌ۔","Sahih","Musannaf Ibn Abi Shaybah 4444","","","كتاب الصلوات"
"4445","(۴۴۴۵) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَتَحَرَّی وَیَسْجُدُ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4445","","","كتاب الصلوات"
"4446","(۴۴۴۶) حَدَّثَنَا حَفْصٌ، عَنْ یَحْیَی، عَنْ سَالِمٍ، قَالَ: یَبْنِی عَلَی مَا یَسْتَیْقِنُ، قِیلَ لَہُ: وَیَسْجُدُ سَجْدَتَیْنِ؟ قَالَ: نَعَمْ۔","","Musannaf Ibn Abi Shaybah 4446","","","كتاب الصلوات"
"4447","(۴۴۴۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مَکْحُولٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ : إذَا شَکَّ أَحَدُکُمْ فِی صَلاَتِہِ فَلَمْ یَدْرِ زَادَ ، أَوْ نَقَصَ ، فَإِنْ کَانَ شَکَّ فِی الْوَاحِدَۃِ وَالثِّنْتَیْنِ ، فَلْیَجْعَلْہَا وَاحِدَۃً حَتَّی یَکُونَ الْوَہْمُ فِی الزِّیَادَۃِ ، ثُمَّ یَسْجُدْ سَجْدَتَیْنِ وَہُوَ جَالِسٌ قَبْلَ أَنْ یُسَلِّمَ ، ثُمَّ یُسَلِّمُ ۔ قَالَ مُحَمَّدٌ: قَالَ لِی حُسَیْنُ بْنُ عَبْدِ اللہِ : ہَلْ أَسْنَدَ لَکَ مَکْحُولٌ الْحَدِیثَ ؟ قَالَ مُحَمَّدٌ : ما سَأَلْتُہُ عَنْ ذَلِکَ ، قَالَ : فَإِنَّہُ ذَکَرَہُ عَنْ کُرَیْبٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ عُمَرَ ، وَابْنَ عَبَّاسٍ تَدَارَآ فِیہِ ، فَجَائَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ ، فَقَالَ : أنَا سَمِعْتُ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ہَذَا الْحَدِیثَ۔(ترمذی ۳۹۸۔ احمد ۱/۱۹۰)","Hasan","Musannaf Ibn Abi Shaybah 4447","","","كتاب الصلوات"
"4448","(۴۴۴۸) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ فُرَاتٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَأَبِی عُبَیْدَۃَ ؛ أَنَّہُمَا کَانَا إذَا وَہِمَا فِی صَلاَتِہِمَا ، فَلَمْ یَدْرِیَا ثَلاَثًا صَلَّیَا ، أَمْ أَرْبَعًا ، سَجَدَا سَجْدَتَیْنِ قَبْلَ أَنْ یُسَلِّمَا۔","","Musannaf Ibn Abi Shaybah 4448","","","كتاب الصلوات"
"4449","(۴۴۴۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الْمُہَلَّبِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ، قَالَ : صَلَّی بِنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْعَصْرَ ، فَسَلَّمَ مِنْ ثَلاَثِ رَکَعَاتٍ ، ثُمَّ دَخَلَ ، فَقَامَ إلَیْہِ رَجُلٌ ، یُقَالُ لَہُ : الْخِرْبَاقُ ، فَقَالَ : یَا رَسُولَ اللہِ ، فَذَکَرَ لَہُ الَّذِی صَنَعَ ، فَخَرَجَ مُغْضَبًا یَجُرُّ رِدَائَہُ حَتَّی انْتَہَی إلَی النَّاسِ ، فَقَالَ : صَدَقَ ہَذَا ؟ فَقَالُوا : نَعَمْ ، فَصَلَّی تِلْکَ الرَّکْعَۃَ ، ثُمَّ سَلَّمَ ، ثُمَّ سَجَدَ سَجْدَتَیْنِ ، ثُمَّ سَلَّمَ۔ (مسلم ۱۰۱۔ ابوداؤد ۱۰۱۰)","Sahih","Musannaf Ibn Abi Shaybah 4449","","","كتاب الصلوات"
"4450","(۴۴۵۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، وَالْحَسَنِ ، قَالاَ : یَنْتَہِی إلَی آخِرِ وَہْمِہِ ، ثُمَّ یَسْجُدُ سَجْدَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 4450","","","كتاب الصلوات"
"4451","(۴۴۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَارِبِ بْنِ دِثَارٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : أَحْصِ مَا اسْتَطَعْتَ ، وَلاَ تُعِدْ۔","Sahih","Musannaf Ibn Abi Shaybah 4451","","","كتاب الصلوات"
"4452","(۴۴۵۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ؛ أَنَّ أَنَسَ بْنَ مَالِکٍ قَعَدَ فِی الرَّکْعَۃِ الثَّالِثَۃِ ، فَسَبَّحُوا بِہِ ، فَقَامَ فَأَتَمَّہُنَّ أَرْبَعًا ، فَلَمَّا سَلَّمَ سَجَدَ سَجْدَتَیْنِ ، ثُمَّ أَقْبَلَ عَلَی الْقَوْمِ بِوَجْہِہِ ، فَقَالَ : إذَا وَہَمْتُمْ فَاصْنَعُوا ہَکَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 4452","","","كتاب الصلوات"
"4453","(۴۴۵۳) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا لَمْ یَدْرِ أَزَادَ ، أَمْ نَقَصَ ، فَلْیَسْجُدْ سَجْدَتَیْنِ وَہُوَ جَالِسٌ۔","Hasan","Musannaf Ibn Abi Shaybah 4453","","","كتاب الصلوات"
"4454","(۴۴۵۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : أَمَّا أَنَا فَإِذَا لَمْ أَدْرِ کَمْ صَلَّیْتُ فَإِنِّی أُعِیدُ۔","Sahih","Musannaf Ibn Abi Shaybah 4454","","","كتاب الصلوات"
"4455","(۴۴۵۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عُمَرَ ؛ فِی الَّذِی لاَ یَدْرِی ثَلاَثًا صَلَّی ، أَوْ أَرْبَعًا ، قَالَ : یُعِیدُ حَتَّی یَحْفَظَ۔","Sahih","Musannaf Ibn Abi Shaybah 4455","","","كتاب الصلوات"
"4456","(۴۴۵۶) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ (ح) وَعَنْ أَیُّوبَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالاَ : إذَا صَلَّی فَانْصَرَفَ فَلَمْ یَدْرِ کَمْ صَلَّی شَفْعًا ، أَوْ وِتْرًا ، فَلْیُعِدْ۔","","Musannaf Ibn Abi Shaybah 4456","","","كتاب الصلوات"
"4457","(۴۴۵۷) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ (ح) وَعَنْ أَیُّوبَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ بِنَحْوِہِ۔","","Musannaf Ibn Abi Shaybah 4457","","","كتاب الصلوات"
"4458","(۴۴۵۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنِ الشَّکِّ فِی الصَّلاَۃ ؟ فَقَالَ : أَمَّا أَنَا فَإِذَا کَانَ فِی الْمَکْتُوبَۃِ فَإِنِّی أُعِیدُ۔","","Musannaf Ibn Abi Shaybah 4458","","","كتاب الصلوات"
"4459","(۴۴۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ رَمَیْتُ الْجِمَار فَلَمْ أَدْرِ بِکَمْ رَمَیْتُ ، فَسَأَلْتُ ابْنَ عُمَرَ فَلَمْ یُجِبْنِی ، فَمَرَّ ابْنُ الْحَنَفِیَّۃِ فَسَأَلْتُہُ ، فَقَالَ : یُعِیدُ یَا أَبَا عَبْدِ اللہِ ، لَیْسَ شَئٌَٔ أَعْظَمَ عِنْدَنَا مِنَ الصَّلاَۃ ، فَإِذَا نَسِیَ أَحَدُنَا أَعَادَ ، قَالَ : فَذَکَرْت لابْنِ عُمَرَ قَوْلَہُ ، فَقَالَ : إنَّہُمْ أَہْلُ بَیْتٍ مُفْہِمُونَ۔","Sahih","Musannaf Ibn Abi Shaybah 4459","","","كتاب الصلوات"
"4460","(۴۴۶۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَوَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : یُعِیدُ ، فَذَکَرْتُہُ لأَبِی ألضُّحَی ، فَقَالَ : کَانَ شُرَیْحٌ یَقُولُ : یُعِیدُ۔","","Musannaf Ibn Abi Shaybah 4460","","","كتاب الصلوات"
"4461","(۴۴۶۱) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : إذَا صَلَّیْتَ فَلَمْ تَدْرِ کَمْ صَلَّیْتَ فَأَعِدْہَا مَرَّۃً ، فَإِنِ التبستْ عَلَیْک مَرَّۃً أُخْرَی ، فَلاَ تُعِدْہَا۔","","Musannaf Ibn Abi Shaybah 4461","","","كتاب الصلوات"
"4462","(۴۴۶۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَوَکِیعٍ ، عَنْ مَالِکٍ ، عَنْ عَطَائٍ ، قَالَ : یُعِیدُ۔","","Musannaf Ibn Abi Shaybah 4462","","","كتاب الصلوات"
"4463","(۴۴۶۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : یُعِیدُ مَرَّۃً۔","","Musannaf Ibn Abi Shaybah 4463","","","كتاب الصلوات"
"4464","(۴۴۶۴) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ فُرَاتٍ ، عَنْ عَبْدِ الْکَرِیمِ ، وَسَعِیدِ بْنِ جُبَیْرٍ ، وَمَیْمُونٍ ؛ أَنَّہُمْ کَانُوا إذَا وَہَمُوا فِی الصَّلاَۃ أَعَادُوا۔","","Musannaf Ibn Abi Shaybah 4464","","","كتاب الصلوات"
"4465","(۴۴۶۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، وَسَعِیدِ بْنِ جُبَیْرٍ ، قَالاَ : فِی التَّطَوُّعِ سَہْوٌ۔","","Musannaf Ibn Abi Shaybah 4465","","","كتاب الصلوات"
"4466","(۴۴۶۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَرَی الْوَہْمَ فِی التَّطَوُّعِ۔","Hasan","Musannaf Ibn Abi Shaybah 4466","","","كتاب الصلوات"
"4467","(۴۴۶۷) حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِی ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ أَبِی أَیُّوبَ ، قَالَ : حَدَّثَنِی أَبُو عَقِیلٍ ؛ أَنَّہُ سَمِعَ سَعِیدَ بْنَ الْمُسَیَّبِ یَقُولُ : سَجْدَتَا السَّہْوِ فِی النَّوَافِلِ ، کَسَجْدَتَیِ السَّہْوِ فِی الْمَکْتُوبَۃِ۔","","Musannaf Ibn Abi Shaybah 4467","","","كتاب الصلوات"
"4468","(۴۴۶۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ مُحَمَّدًا عَنْ شَیْئٍ مِنَ الْوَہْمِ فِی التَّطَوُّعِ ؟ فَقَالَ : لاَ أَدْرِی أَیْنَ مَوْضِعُہُ ، فَقُلْتُ : أَسْجُدُ بَعْدَہُ سَجْدَتَیْنِ ؟ قَالَ : أَتُشَبِّہُہَا بِالْمَکْتُوبَۃِ ؟ أَمَّا أَنَا فَلَوْ کُنْتُ لَمْ أَفْعَلْ۔","","Musannaf Ibn Abi Shaybah 4468","","","كتاب الصلوات"
"4469","(۴۴۶۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ؛ أَنَّہُ کَانَ لاَ یَرَی الْوَہْمَ فِی التَّطَوُّعِ۔","","Musannaf Ibn Abi Shaybah 4469","","","كتاب الصلوات"
"4470","(۴۴۷۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ زِیَادِ بْنِ سَعْدٍ ، عَنْ ضَمْرَۃَ بْنِ سَعِیدٍ ، عَنْ أَنَسٍ ؛ أَنَّہُ سَجَدَ سَجْدَتَیِ السَّہْوِ بَعْدَ السَّلاَمِ۔","Sahih","Musannaf Ibn Abi Shaybah 4470","","","كتاب الصلوات"
"4471","(۴۴۷۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ زِیَادِ بْنِ سَعْدٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی سَلَمَۃَ ؛ أَنَّہُ سَجَدَہُمَا بَعْدَ التَّسْلِیمِ۔","","Musannaf Ibn Abi Shaybah 4471","","","كتاب الصلوات"
"4472","(۴۴۷۲) حَدَّثَنَا یَحْیَی بْنُ سُلَیْمٍ الطَّائِفِیُّ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا قَالَ : سَجْدَتَا السَّہْوِ بَعْدَ السَّلاَمِ وَقَبْلَ الْکَلاَمِ۔","","Musannaf Ibn Abi Shaybah 4472","","","كتاب الصلوات"
"4473","(۴۴۷۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَجَدَہُمَا بَعْدَ مَا سَلَّمَ وَتَکَلَّمَ۔ (بخاری ۱۲۲۹۔ مسلم ۹۷)","Hasan","Musannaf Ibn Abi Shaybah 4473","","","كتاب الصلوات"
"4474","(۴۴۷۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الْمُہَلَّبِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَہَا فَصَلَّی رَکْعَۃً ، ثُمَّ سَلَّمَ ، ثُمَّ سَجَدَ سَجْدَتَیْنِ ، ثُمَّ سَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 4474","","","كتاب الصلوات"
"4475","(۴۴۷۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ؛ أَنَّ عَبْدَ اللہِ سَجَدَ سَجْدَتَیِ السَّہْوِ بَعْدَ السَّلاَمِ ، وَذُکِرَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَعَلَہُ۔ (بخاری۴۰۱۔ ترمذی ۳۹۲)","Sahih","Musannaf Ibn Abi Shaybah 4475","","","كتاب الصلوات"
"4476","(۴۴۷۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ سَعْدًا ، وَعَمَّارًا سَجَدَاہُمَا بَعْدَ التَّسْلِیمِ۔","Da'if","Musannaf Ibn Abi Shaybah 4476","","","كتاب الصلوات"
"4477","(۴۴۷۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ إبْرَاہِیمَ بْنِ الْحَارِثِ ؛ أَنَّ أَبَا ہُرَیْرَۃَ ، وَالسَّائِبَ الْقَارِیَّ کَانَا یَقُولاَنِ : السَّجْدَتَانِ قَبْلَ الْکَلاَمِ وَبَعْدَ التَّسْلِیمِ۔","","Musannaf Ibn Abi Shaybah 4477","","","كتاب الصلوات"
"4478","(۴۴۷۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، وَأَنَسٍ ؛ أَنَّہُمَا سَجَدَا سَجْدَتَیِ السَّہْوِ بَعْدَ السَّلاَمِ ، ثُمَّ قَامَا وَلَمْ یُسَلِّمَا۔","Sahih","Musannaf Ibn Abi Shaybah 4478","","","كتاب الصلوات"
"4479","(۴۴۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ؛ أَنَّہُ سَہَا فَسَلَّمَ ، ثُمَّ سَجَدَ سَجْدَتَیْنِ ، ثُمَّ سَلَّمَ۔","","Musannaf Ibn Abi Shaybah 4479","","","كتاب الصلوات"
"4480","(۴۴۸۰) حَدَّثَنَا عُمَرُ بْنُ ہَارُونَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُمَرَ ، عَنْ أَبِیہِ ؛ أَنَّہُ سَہَا فِی الصَّلاَۃ بِالشَّامِ ، فَسَجَدَ سَجْدَتَیْنِ بَعْدَ التَّسْلِیمِ۔","","Musannaf Ibn Abi Shaybah 4480","","","كتاب الصلوات"
"4481","(۴۴۸۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عُقْبَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ سَجَدَہُمَا بَعْدَ مَا سَلَّمَ۔","","Musannaf Ibn Abi Shaybah 4481","","","كتاب الصلوات"
"4482","(۴۴۸۲) حدَّثَنَا سُفْیَانُ ، عَنِ الزُّہْرِیِّ ، عَنِ الأَعْرَجِ ، عَنِ ابْنِ بُحَیْنَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی صَلاَۃً نَظُنُّ أَنَّہَا الْعَصْرُ ، فَلَمَّا کَانَ فِی الثَّالِثَۃِ قَامَ قَبْلَ أَنْ یَجْلِسَ ، فَلَمَّا کَانَ قَبْلَ أَنْ یُسَلِّمَ سَجَدَ سَجْدَتَیْنِ۔ (بخاری ۸۲۹۔ ابوداؤد ۱۰۲۷)","Sahih","Musannaf Ibn Abi Shaybah 4482","","","كتاب الصلوات"
"4483","(۴۴۸۳) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، وَالزُّہْرِیِّ ، قَالاَ : سَجْدَتَانِ قَبْلَ أَنْ یُسَلِّمَ۔","","Musannaf Ibn Abi Shaybah 4483","","","كتاب الصلوات"
"4484","(۴۴۸۴) حَدَّثَنَا أَبُو الأَحْوَصِ ، وَحَفْصٌ ، عَنْ عَاصِمٍ ، عَنْ أَبِی قِلاَبَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَلَّمَ فِی سَجْدَتَیِ السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 4484","","","كتاب الصلوات"
"4485","(۴۴۸۵) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ سَلَّمَ فِیہِمَا۔","Da'if","Musannaf Ibn Abi Shaybah 4485","","","كتاب الصلوات"
"4486","(۴۴۸۶) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حُصَیْنٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ، قَالَ : فِیہِمَا تَسْلِیمٌ۔","","Musannaf Ibn Abi Shaybah 4486","","","كتاب الصلوات"
"4487","(۴۴۸۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ سَعْدٍ ، وَعَمَّارٍ ؛ أَنَّہُمَا صَلَّیَا ثَلاَثًا ، ثُمَّ سَلَّمَا ، فَقِیلَ لَہُمَا : فَقَضَیَا الَّتِی بَقِیَتْ عَلَیْہِمَا ، ثُمَّ کَبَّرَا ، ثُمَّ سَجَدَا ، ثُمَّ سَلَّمَا تَسْلِیمَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 4487","","","كتاب الصلوات"
"4488","(۴۴۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنِ ابْنِ أَبِی لَیْلَی ؛ أَنَّہُ سَجَدَہُمَا ثُمَّ سَلَّمَ۔","","Musannaf Ibn Abi Shaybah 4488","","","كتاب الصلوات"
"4489","(۴۴۸۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ سَلَّمَ فِیہِمَا۔","","Musannaf Ibn Abi Shaybah 4489","","","كتاب الصلوات"
"4490","(۴۴۹۰) حَدَّثَنَا جَرِیرٌ، عَنِ الشَّیْبَانِیِّ، عَنْ عَبْدِالْمَلِکِ بْنِ إیَاسٍ، عَنْ إبْرَاہِیمَ، قَالَ: تَسْلِیمُ السَّہْوِ وَالْجِنَازَۃِ وَاحِدٌ۔","","Musannaf Ibn Abi Shaybah 4490","","","كتاب الصلوات"
"4491","(۴۴۹۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی سَجْدَتَیِ السَّہْوِ فِیہِمَا سَلاَمٌ۔","","Musannaf Ibn Abi Shaybah 4491","","","كتاب الصلوات"
"4492","(۴۴۹۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ خُصَیْفٍ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : یَتَشَہَّدُ فِیہِمَا۔","Da'if","Musannaf Ibn Abi Shaybah 4492","","","كتاب الصلوات"
"4493","(۴۴۹۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حُصَیْنٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ، قَالَ : فِیہِمَا تَشَہُّدٌ۔","","Musannaf Ibn Abi Shaybah 4493","","","كتاب الصلوات"
"4494","(۴۴۹۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ سَجَدَ سَجْدَتَیِ السَّہْوِ فَتَشَہَّدَ فِیہِمَا ثُمَّ سَلَّمَ۔","","Musannaf Ibn Abi Shaybah 4494","","","كتاب الصلوات"
"4495","(۴۴۹۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَلَمَۃَ ، عَنْ عَلْقَمَۃَ ، قَالَ : سُئِلَ مُحَمَّدُ بْنُ سِیرِینَ عَنْ سَجْدَتَیِ الْوَہْمِ ، فِیہِمَا تَشَہُّدٌ ؟ قَالَ : أَحَبُّ إلَیَّ أَنْ یَتَشَہَّدَ فِیہِمَا۔","","Musannaf Ibn Abi Shaybah 4495","","","كتاب الصلوات"
"4496","(۴۴۹۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : أَخْبَرَنَا ابْنُ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لَیْسَ فِی سَجْدَتَیِ السَّہْوِ تَشَہُّدٌ ، وَلاَ تَسْلِیمٌ۔","","Musannaf Ibn Abi Shaybah 4496","","","كتاب الصلوات"
"4497","(۴۴۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لَیْسَ فِیہِمَا تَشَہُّدٌ ، وَلاَ تَسْلِیمٌ۔","","Musannaf Ibn Abi Shaybah 4497","","","كتاب الصلوات"
"4498","(۴۴۹۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، وَأَنَسٍ ؛ أَنَّہُمَا سَجَدَاہُمَا ، ثُمَّ قَامَا وَلَمْ یُسَلِّمَا۔","Sahih","Musannaf Ibn Abi Shaybah 4498","","","كتاب الصلوات"
"4499","(۴۴۹۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَتَشَہَّدُ الإِمَام فِی سَجْدَتَیِ السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 4499","","","كتاب الصلوات"
"4500","(۴۵۰۰) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ؛ أَنَّہُمَا قَالاَ : یَتَشَہَّدُ فِی السَّہْوِ ، ثُمَّ یُسَلِّمُ۔","","Musannaf Ibn Abi Shaybah 4500","","","كتاب الصلوات"
"4501","(۴۵۰۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : سَجَدَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَجْدَتَیِ السَّہْوِ بَعْد َمَا سَلَّمَ وَکَبَّرَ ، فَسَجَدَ وَکَبَّرَ وَہُوَ جَالِسٌ ، ثُمَّ رَفَعَ وَکَبَّرَ ، ثُمَّ سَجَدَ وَکَبَّرَ ، ثُمَّ رَفَعَ وَکَبَّرَ۔","Hasan","Musannaf Ibn Abi Shaybah 4501","","","كتاب الصلوات"
"4502","(۴۵۰۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ سَعْدٍ ، وَعَمَّارٍ ؛ أَنَّہُمَا صَلَّیَا ثَلاَثًا ، فَقِیلَ لَہُمَا : فَقَضَیَا الَّتِی بَقِیَتْ عَلَیْہِمَا ثُمَّ سَلَّمَا ، ثُمَّ کَبَّرَا ، ثُمَّ سَجَدَا ، ثُمَّ کَبَّرَا، ثُمَّ رَفَعَا، ثُمَّ کَبَّرَا وَسَجَدَا، ثُمَّ کَبَّرَا وَرَفَعَا۔","Da'if","Musannaf Ibn Abi Shaybah 4502","","","كتاب الصلوات"
"4503","(۴۵۰۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عُقْبَۃَ بن أبی العَیزار ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ سَجَدَہُمَا بِتَکْبِیرَۃٍ۔","","Musannaf Ibn Abi Shaybah 4503","","","كتاب الصلوات"
"4504","(۴۵۰۴) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَیْسَ فِی سَجْدَتَیِ السَّہْوِ سَہْوٌ۔","","Musannaf Ibn Abi Shaybah 4504","","","كتاب الصلوات"
"4505","(۴۵۰۵) حَدَّثَنَا عُقْبَۃُ بْنُ خَالِدٍ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، قَالاَ : لَیْسَ فِی سَجْدَتَیِ السَّہْوِ سَہْوٌ۔","","Musannaf Ibn Abi Shaybah 4505","","","كتاب الصلوات"
"4506","(۴۵۰۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ مُغِیرَۃَ ، وَابْنَ أَبِی لَیْلَی ، والبَتّیَّ ، عَنْ رَجُلٍ سَہَا فِی سَجْدَتَیِ السَّہْوِ ؟ فَقَالوا : لَیْسَ عَلَیْہِ سَہْوٌ۔","","Musannaf Ibn Abi Shaybah 4506","","","كتاب الصلوات"
"4507","(۴۵۰۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لَیْسَ فِی سَجْدَتَیِ السَّہْوِ سَہْوٌ۔","","Musannaf Ibn Abi Shaybah 4507","","","كتاب الصلوات"
"4508","(۴۵۰۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَجَدَ سَجْدَتَیِ السَّہْوِ بَعْدَ الْکَلاَمِ۔ (مسلم ۴۰۲۔ ترمذی ۳۹۳)","Sahih","Musannaf Ibn Abi Shaybah 4508","","","كتاب الصلوات"
"4509","(۴۵۰۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ؛ فِی رَجُلٍ نَسِیَ سَجْدَتَیِ السَّہْوِ حَتَّی یَخْرُجَ مِنَ الْمَسْجِدِ ؟ قَالَ : لاَ یُعِیدُ ، وَقَالَ ابْنُ شُبْرُمَۃَ : یُعِیدُ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4509","","","كتاب الصلوات"
"4510","(۴۵۱۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ؛ أَنَّہُ لَقِیَ ذَلِکَ فَأَعَادَ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4510","","","كتاب الصلوات"
"4511","(۴۵۱۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ وَضَّاحٍ ، قَالَ : سَأَلْتُ قَتَادَۃَ ، فَقَالَ : یُعِیدُ سَجْدَتَیِ السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 4511","","","كتاب الصلوات"
"4512","(۴۵۱۲) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ، قَالاَ : إذَا صَرَفَ وَجْہَہُ عَنِ الْقِبْلَۃِ لَمْ یَبْنِ ، وَلَمْ یَسْجُدْ سَجْدَتَیِ السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 4512","","","كتاب الصلوات"
"4513","(۴۵۱۳) حَدَّثَنَا شَرِیکٌ ، عَنْ سَلَمَۃَ بْنِ نُبَیْطٍ ، قَالَ : قُلْتُ لِلضَّحَّاکِ : إنِّی سَہَوْتُ ، وَلَمْ أَسْجُدْ ؟ قَالَ : ہَاہُنَا فَاسْجُدْ۔","","Musannaf Ibn Abi Shaybah 4513","","","كتاب الصلوات"
"4514","(۴۵۱۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ: ہُمَا عَلَیْہِ حَتَّی یَخْرُجَ، أَوْ یَتَکَلَّمَ۔","","Musannaf Ibn Abi Shaybah 4514","","","كتاب الصلوات"
"4515","(۴۵۱۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ إبْرَاہِیمَ ، وَعَلِیِّ بْنِ مُدْرِکٍ ، قَالاَ : صَلَّی بِنَا عَلْقَمَۃُ فَصَلَّی بِنَا خَمْسًا ، فَلَمَّا سَلَّمَ ، قَالُوا لَہُ : صَلَّیْتَ خَمْسًا ، فَالْتَفَتَ إلَی رَجُلٍ مِنَ الْقَوْمِ ، فَقَالَ : کَذلکَ یَا أَعْوَرُ ؟ فَقَالَ : نَعَمْ ، فَسَجَدَ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4515","","","كتاب الصلوات"
"4516","(۴۵۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ شُعْبَۃَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، قَالاَ : فِی کُلِّ سَہْوٍ سَجْدَتَانِ۔","","Musannaf Ibn Abi Shaybah 4516","","","كتاب الصلوات"
"4517","(۴۵۱۷) حَدَّثَنَا الْمُعَلَّی بْنُ مَنْصُورٍ ، قَالَ: أَخْبَرَنَا الْہَیْثُمُ بْنُ حُمَیْدٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُبَیْدٍ ، عَنْ زُہَیْرٍ الْحِمْصِیِّ، عَنْ ثَوْبَانَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لِکُلِّ سَہْوٍ سَجْدَتَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 4517","","","كتاب الصلوات"
"4518","(۴۵۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی فَرْوَۃَ ، قَالَ : صَلَّی بِنَا عَبْدُ الرَّحْمَنِ بْنُ أَبِی لَیْلَی ، فَلَمَّا جَلَسَ تَحَرَّکَ لِلْقِیَامِ ، سَجَدَ سَجْدَتَیِ السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 4518","","","كتاب الصلوات"
"4519","(۴۵۱۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : أَمَّنَا أَنَسٌ فِی سَفَرٍ ، فَصَلَّی بِنَا الْعَصْرَ رَکْعَتَیْنِ ، فَلَمَّا جَلَسَ فِی الثَّانِیَۃ نَسِیَ أَنْ یُسَلِّمَ ، فَذَہَبَ لِیَقُومَ فَسَبَّحْنَا بِہِ ، فَلَمَّا جَلَسَ سَلَّمَ وَسَجَدَ سَجْدَتَیِ السَّہْوِ۔","Sahih","Musannaf Ibn Abi Shaybah 4519","","","كتاب الصلوات"
"4520","(۴۵۲۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ؛ أَنَّ أَنَسًا قَعَدَ فِی الرَّکْعَۃِ الثَّالِثَۃِ فَسَبَّحُوا ، فَقَامَ فَأَتَمَّہَا أَرْبَعًا ، فَلَمَّا سَلَّمَ سَجَدَ سَجْدَتَیْنِ ، ثُمَّ أَقْبَلَ عَلَی الْقَوْمِ ، فَقَالَ : إِذَا وَہِمْتُمْ فَاصْنَعُوا ہَکَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 4520","","","كتاب الصلوات"
"4521","(۴۵۲۱) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، وَعَطَائٍ ، قَالاَ : إنَّمَا السَّہْوُ فِی الزِّیَادَۃِ وَالنُّقْصَانِ۔","","Musannaf Ibn Abi Shaybah 4521","","","كتاب الصلوات"
"4522","(۴۵۲۲) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ یَزِیدَ الدَّالانِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، وَعَلْقَمَۃَ ؛ أَنَّہُمَا کَانَا یَرْفَعَانِ رُؤُوسَہُمَا مِنَ السُّجُودِ حَتَّی تَرْتَفِعَ أَلْیَتَاہُمَا ، فَیَجْلِسَانِ وَلاَ یَسْجُدَانِ سَجْدَتَیِ السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 4522","","","كتاب الصلوات"
"4523","(۴۵۲۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : صَلَّی فَنَہَضَ فِی الرَّکْعَتَیْنِ فَلَمْ یَسْتَتمِمْ قَائِمًا ، فَسَبَّحَ بِہِ الْقَوْمُ ، فَجَلَسَ فَلَمْ یَسْجُدْ لِذَلِکَ سَجْدَتَیِ السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 4523","","","كتاب الصلوات"
"4524","(۴۵۲۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ؛ فِی الَّذِی یَقُومُ فِی الرَّکْعَتَیْنِ ، قَالَ : إِنْ ذَکَرَ وَہُوَ مُتَحَادِبٌ جَلَسَ۔","","Musannaf Ibn Abi Shaybah 4524","","","كتاب الصلوات"
"4525","(۴۵۲۵) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ؛ فِی الرَّجُلِ یَسْہُو فِی الصَّلاَۃ ، إنِ اسْتَوَی قَائِمًا فَعَلَیْہِ السَّجْدَتَانِ ، وَإِنْ ذَکَرَ قَبْلَ أَنْ یَعْتَدِلَ قَائِمًا فَلاَ سَہْوَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 4525","","","كتاب الصلوات"
"4526","(۴۵۲۶) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، قَالَ : صَلَّیْتُ خَلْفَ الْمُغِیرَۃِ بْنِ شُعْبَۃَ فَقَامَ فِی الثَّانِیَۃِ ، فَسَبَّحَ النَّاسُ بِہِ فَلَمْ یَجْلِسْ ، فَلَمَّا سَلَّمَ وَانْفَتَلَ سَجَدَ سَجْدَتَنِیْ وَہُوَ جَالِسٌ ، ثُمَّ قَالَ : ہَکَذَا رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَنَعَ۔ (ابوداؤد ۱۰۲۹۔ احمد ۴/۲۵۳)","Da'if","Musannaf Ibn Abi Shaybah 4526","","","كتاب الصلوات"
"4527","(۴۵۲۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ بَیَانٍ ، عَنْ قَیْسٍ ، قَالَ : صَلَّی سَعْدُ بْنُ مَالِکٍ بِأَصْحَابِہِ ، فَقَامَ فِی الرَّکْعَۃِ الثانیۃ فَسَبَّحَ بِہِ الْقَوْمُ ، فَلَمْ یَجْلِسْ وَسَبَّحَ ہُوَ وَأَشَارَ إلَیْہِمْ ، أَنْ قُومُوا فَصَلَّی وَسَجَدَ سَجْدَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 4527","","","كتاب الصلوات"
"4528","(۴۵۲۸) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، وَعَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ الرَّحْمَنِ الأَعْرَجِ ؛ أَنَّ ابْنَ بُحَیْنَۃَ أَخْبَرَہُ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَامَ فِی اثْنَتَیْنِ مِنَ الظُّہْرِ ، نَسِیَ الْجُلُوسَ ، حَتَّی إذَا فَرَغَ مِنْ صَلاَتِہِ إِلاَّ أَنْ یُسَلِّمَ ، سَجَدَ سَجْدَتَیِ السَّہْوِ وَسَلَّمَ۔ (ابن ماجہ ۱۲۰۷)","Sahih","Musannaf Ibn Abi Shaybah 4528","","","كتاب الصلوات"
"4529","(۴۵۲۹) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ الزُّبَیْرِ ؛ أَنَّہُ قَامَ فِی رَکْعَتَیْنِ فَسَبَّحَ الْقَوْمُ ، حَتَّی إذَا عَرَفَ أَنَّہُ قَدْ وَہَمَ فَمَضَی فِی صَلاَتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4529","","","كتاب الصلوات"
"4530","(۴۵۳۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ النُّعْمَانَ بْنَ بَشِیرٍ صَلَّی فَنَہَضَ فِی الرَّکْعَتَیْنِ فَسَبَّحُوا بِہِ فَمَضَی ، فَلَمَّا فَرَغَ سَجَدَ سَجْدَتَیِ السَّہْوِ وَہُوَ جَالِسٌ۔","Hasan","Musannaf Ibn Abi Shaybah 4530","","","كتاب الصلوات"
"4531","(۴۵۳۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قُلْتُ لِلشَّعْبِیِّ : صَلَّیْتُ رَکْعَتَیْنِ ، فَلَمَّا أَرَدْتُ أَنْ أَجْلِسَ قُمْتُ ، قَالَ : لَوْ کُنْتُ أَنَا لَمَضَیْتُ۔","","Musannaf Ibn Abi Shaybah 4531","","","كتاب الصلوات"
"4532","(۴۵۳۲) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنْ یَزِیدَ ؛ أَنَّ عَبْدَ الرَّحْمَن بْنَ شِمَاسَۃَ حَدَّثَہُ ، أَنَّ عُقْبَۃَ بْنَ عَامِرٍ قَامَ فِی صَلاَۃٍ وَعَلَیْہِ جُلُوسٌ ، فَقَالَ النَّاسُ : سُبْحَانَ اللہِ ، فَعَرَفَ الَّذِی یُرِیدُونَ ، فَلَمَّا أَنْ صَلَّی سَجَدَ سَجْدَتَیْنِ وَہُوَ جَالِسٌ ، فَقَالَ : إنِّی قَدْ سَمِعْتُ قَوْلَکُمْ ، وَہَذِہِ سُنَّۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 4532","","","كتاب الصلوات"
"4533","(۴۵۳۳) حَدَّثَنَا یَحْیَی بْنُ عَبْدِ الْمَلِکِ بْنِ أَبِی غَنِیَّۃَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یُصَلِّی رَکْعَتَیْنِ مِنَ الْمَکْتُوبَۃِ ، ثُمَّ یَقُومُ ، قَالَ : إنِ استتم قَائِمًا مَضَی فِی صَلاَتِہِ ، فَإِذَا ہُوَ أَکْمَلَ صَلاَتَہُ سَجَدَ سَجْدَتَیْنِ وَہُوَ جَالِسٌ بَعْدَ مَا یُسَلِّمُ۔","","Musannaf Ibn Abi Shaybah 4533","","","كتاب الصلوات"
"4534","(۴۵۳۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ صَلَّی رَکْعَتَیْنِ مِنَ الْمَکْتُوبَۃِ وَنَسِیَ أَنْ یَتَشَہَّدَ حَتَّی نَہَضَ ، قَالَ : إذَا اسْتَوَی قَائِمًا مَضَی فِی صَلاَتِہِ ، وَسَجَدَ سَجْدَتَیِ السَّہْو۔","","Musannaf Ibn Abi Shaybah 4534","","","كتاب الصلوات"
"4535","(۴۵۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ ثَابِتِ بْنِ عُبَیْدٍ ، قَالَ : صَلَّیْت خَلْفَ الْمُغِیرَۃِ بْنِ شُعْبَۃَ، فَقَامَ فِی الرَّکْعَتَیْنِ فَلَمْ یَجْلِسْ ، فَلَمَّا فَرَغَ سَجَدَ سَجْدَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 4535","","","كتاب الصلوات"
"4536","(۴۵۳۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، قَالَ : صَلَّی بِنَا عِمْرَانُ بْنُ حُصَیْنٍ فِی الْمَسْجِدِ فَنَہَضَ فِی رَکْعَتَیْنِ ، أَوْ قَعَدَ فِی ثَلاَثٍ ، وَأَکْثَرُ ظَنِّ ہِشَامٍ أَنَّہُ قَعَدَ فِی الرَّکْعَتَیْنِ ، فَلَمَّا أَتَمَّ الصَّلاَۃ سَجَدَ سَجْدَتَیِ السَّہْوِ۔","Sahih","Musannaf Ibn Abi Shaybah 4536","","","كتاب الصلوات"
"4537","(۴۵۳۷) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : صَلَّی الضَّحَّاکُ بْنُ قَیْسٍ بِالنَّاسِ الظُّہْرَ ، فَلَمْ یَجْلِسْ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ ، فَلَمَّا سَلَّمَ سَجَدَ سَجْدَتَیْنِ وَہُوَ جَالِسٌ۔","Sahih","Musannaf Ibn Abi Shaybah 4537","","","كتاب الصلوات"
"4538","(۴۵۳۸) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ عَطَائٍ ، قَالَ : صَلَّی ابْنُ الزُّبَیْرِ فَسَلَّمَ فِی رَکْعَتَیْنِ ، ثُمَّ قَامَ إلَی الْحَجَرِ فَاسْتَلَمَہُ ، فَسَبَّحَ بِہِ الْقَوْمُ ، فَرَجَعَ فَأَتَمَّ وَسَجَدَ سَجْدَتَیْنِ ، قَالَ : فَذَکَرْتُ ذَلِکَ لابْنِ عَبَّاسٍ ، فَقَالَ : لِلَّہِ أَبُوہُ ، مَا أَمَاطَ عَنْ سُنَّۃِ نَبِیِّہِ۔ (احمد ۱/۳۵۱۔ ابو یعلی ۲۵۹۷)","Da'if","Musannaf Ibn Abi Shaybah 4538","","","كتاب الصلوات"
"4539","(۴۵۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ خُصَیْفٍ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ سَلَّمَ فِی رَکْعَتَیْنِ ، فَقَامَ فَأَتَمَّ وَسَجَدَ سَجْدَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 4539","","","كتاب الصلوات"
"4540","(۴۵۴۰) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی رَجُلٍ سَہَا فِی صَلاَتِہِ فَسَلَّمَ فِی رَکْعَتَیْنِ ؟ قَالَ : ثُمَّ ذَکَرَ ، قَالَ : یَمْضِی فِی صَلاَتِہِ ، وَیَسْجُدُ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4540","","","كتاب الصلوات"
"4541","(۴۵۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنِ ابْنِ الأَصْبَہَانِیِّ ، قَالَ : صَلَّی بِنَا ابْنُ أَبِی لَیْلَی فَسَلَّمَ فِی الرَّکْعَتَیْنِ فَسَبَّحْنَا بِہِ ، فَقَامَ فَأَتَمَّ الصَّلاَۃ ، فَلَمَّا فَرَغَ سَجَدَ سَجْدَتَیْنِ ، قَالَ : فَذَکَرْتُ ذَلِکَ لِعِکْرِمَۃَ ، فَقَالَ : أَحْسَنَ۔","","Musannaf Ibn Abi Shaybah 4541","","","كتاب الصلوات"
"4542","(۴۵۴۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ، قَالَ : إذَا سَلَّمَ فِی الرَّکْعَتَیْنِ أَتَمَّ وَسَجَدَ سَجْدَتَیِ السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 4542","","","كتاب الصلوات"
"4543","(۴۵۴۳) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ؛ أَنَّ سُوَیْد بْنَ قَیْسٍ أَخْبَرَہُ، عَنْ مُعَاوِیَۃَ بْنِ حُدِیجٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی یَوْمًا فَسَلَّمَ وَانْصَرَفَ وَقَدْ بَقِیَ عَلَیْہِ مِنَ الصَّلاَۃ رَکْعَۃٌ ، فَأَدْرَکَہُ رَجُلٌ ، فَقَالَ : نَسِیتَ مِنَ الصَّلاَۃ رَکْعَۃً ، فَرَجَعَ فَدَخَلَ الْمَسْجِدَ وَأَمَرَ بِلاَلاً فَأَقَامَ الصَّلاَۃ فَصَلَّی بِالنَّاسِ رَکْعَۃً ، فَأَخْبَرْتُ بِذَلِکَ النَّاسَ فَقَالُوا : أَتَعْرِفُ الرَّجُلَ ؟ فَقُلْتُ : لاَ ، إِلاَّ أَنْ أَرَاہُ ، فَمَرَّ بِی ، فَقُلْتُ : ہُوَ ہَذَا ، فَقَالُوا : ہَذَا طَلْحَۃُ بْنُ عُبَیْدِ اللہِ۔ (ابوداؤد ۱۰۱۵۔ احمد ۴۰۱)","Sahih","Musannaf Ibn Abi Shaybah 4543","","","كتاب الصلوات"
"4544","(۴۵۴۴) حَدَّثَنَا شَبَابَۃُ ، عَنْ لَیْثٍ ، عَنْ یَزِیدَ ، عَنْ عِمْرَانَ بْن أَبِی أَنَسٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی یَوْمًا فَسَلَّمَ فِی رَکْعَتَیْنِ ، ثُمَّ انْصَرَفَ فَأَدْرَکَہُ ذُو الشِّمَالَیْنِ ، فَقَالَ : یَا رَسُولَ اللہِ ، أَنَقَصَتِ الصَّلاَۃُ أَمْ نَسِیتَ ؟ قَالَ : لَمْ تَنْقُصِ الصَّلاَۃ ، وَلَمْ أَنْسَ ، فَقَالَ : بَلَی ، وَالَّذِی بَعَثَک بِالْحَقِّ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَصَدَقَ ذُو الْیَدَیْنِ ؟ قَالُوا : نَعَمْ یَا رَسُولَ اللہِ ، فَصَلَّی بِالنَّاسِ رَکْعَتَیْنِ۔ (بخاری ۷۲۵۔ ابوداؤد ۱۰۰۱)","Sahih","Musannaf Ibn Abi Shaybah 4544","","","كتاب الصلوات"
"4545","(۴۵۴۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی الظُّہْرَ رَکْعَتَیْنِ ، ثُمَّ سَلَّمَ ، فَقِیلَ لَہُ : أَنَقَصَ مِنَ الصَّلاَۃ ؟ فَصَلَّی رَکْعَتَیْنِ أُخْرَاوَیْنِ وَسَلَّمَ، ثُمَّ سَجَدَ سَجْدَتَیْنِ۔ (بخاری ۱۲۲۷۔ ابوداؤد ۱۰۰۶)","Sahih","Musannaf Ibn Abi Shaybah 4545","","","كتاب الصلوات"
"4546","(۴۵۴۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : صَلَّی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالنَّاسِ ثَلاَثَ رَکَعَاتٍ ، ثُمَّ انْصَرَفَ ، فَقَالَ لَہُ بَعْضُ الْقَوْمِ : حَدَثَ فِی الصَّلاَۃ شَیْئٌ ؟ قَالَ : وَمَا ذَاکَ ؟ قَالُوا : لَمْ تُصَلِّ إِلاَّ ثَلاَثَ رَکَعَاتٍ ، فَقَالَ : أَکَذَلِکَ یَا ذَا الْیَدَیْنِ ؟ وَکَانَ یُسَمَّی ذا الشِّمَالَیْنِ ، قَالَ : نَعَمْ ، قَالَ : فَصَلَّی رَکْعَۃً وَسَجَدَ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4546","","","كتاب الصلوات"
"4547","(۴۵۴۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنِ أبی الْمُہَلَّبِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْعَصْرَ فَسَلَّمَ فِی ثَلاَثِ رَکَعَاتٍ ، ثُمَّ دَخَلَ فَقَامَ إلَیْہِ رَجُلٌ، یُقَالُ لَہُ: الْخِرْبَاقُ، فَقَالَ : یَا رَسُولَ اللہِ ، فَذَکَّرَ لَہ الَّذِی صَنَعَ ، فَخَرَجَ مُغْضَبًا یَجُرُّ رِدَائَہُ حَتَّی انْتَہَی إلَی النَّاسِ ، فَقَالَ : صَدَقَ ہَذَا ؟ قَالُوا : نَعَمْ ، قَالَ : فَصَلَّی تِلْکَ الرَّکْعَۃَ ثُمَّ سَلَّمَ ، وَسَجَدَ سَجْدَتَیْنِ ، ثُمَّ سَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 4547","","","كتاب الصلوات"
"4548","(۴۵۴۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی بِالنَّاسِ رَکْعَتَیْنِ فَسَہَا فَسَلَّمَ ، فَقَالَ لَہُ رَجُلٌ ، یُقَالُ لَہُ ذُو الْیَدَیْنِ ، فَذَکَرَ مِثْلَ حَدِیثِ ابْنِ عَوْنٍ ، وَہِشَامٍ ، وَحَدِیثُہُمَا أَنَّہُ قَالَ : نَقَصَتِ الصَّلاَۃُ ؟ فَقَالَ : لاَ ، فَصَلَّی رَکْعَتَیْنِ أُخْرَاوَیْنِ ، ثُمَّ سَلَّمَ ، ثُمَّ سَجَدَ سَجْدَتَیْنِ ، ثُمَّ سَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 4548","","","كتاب الصلوات"
"4549","(۴۵۴۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ؛ أَنَّ الزُّبَیْرَ بْنَ الْعَوَّامِ صَلَّی فَتَکَلَّمَ، فَبَنَی عَلَی صَلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 4549","","","كتاب الصلوات"
"4550","(۴۵۵۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنِ ، عَنْ مُحَمَّدِ بْنِ یُوسُفَ ، عَنْ أَبِیہِ ، قَالَ : فَاتَ ابْنَ الزُّبَیْرِ بَعْضُ الصَّلاَۃ ، فَقَالَ لِی بِیَدِہِ : کَمْ فَاتَنِی ؟ قَالَ : قُلْتُ : لاَ أَدْرِی مَا تَقُولُ ؟ قَالَ : کَمْ صَلَّیْتُم ؟ قُلْتُ : کَذَا وَکَذَا ، قَالَ : فَصَلَّی وَسَجَدَ سَجْدَتَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 4550","","","كتاب الصلوات"
"4551","(۴۵۵۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ مَکْحُولٍ ؛ أَنَّ أَبَا الدَّرْدَائِ صَلَّی بِہِمْ فِی سَقِیفَۃٍ بِالشَّامِ وَہُمْ خَارِجُونَ ، قَالَ : فَمُطِرُوا مَطَرًا بَلَغَ مِنْہُمْ ، فَلَمَّا صَلَّی أَوَ سَلَّمَ ، قَالَ : أَمَا کَانَ فِی الْقَوْمِ فَقِیہٌ یَقُولُ : یَا ہَذَا ، خَفِّفْ ، فَإِنَّا قَدْ مُطِرْنَا۔","","Musannaf Ibn Abi Shaybah 4551","","","كتاب الصلوات"
"4552","(۴۵۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ ابْنِ الأَصْبَہَانِیِّ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی الْعَصْرَ رَکْعَتَیْنِ ، ثُمَّ سَلَّمَ وَدَخَلَ ، فَدَخَلَ عَلَیْہِ رَجُلٌ مِنْ أَصْحَابِہِ ، یُقَالُ لَہُ : ذُو الشِّمَالَیْنِ ، فَقَالَ : یَا رَسُولَ اللہِ ، قَصُرَتِ الصَّلاَۃ ؟ قَالَ : مَاذَا ؟ قَالَ : صَلَّیْتَ رَکْعَتَیْنِ ، فَخَرَجَ ، فَقَالَ : مَا یَقُولُ ذُو الْیَدَیْنِ ؟ فَقَالُوا : یَا رَسُولَ اللہِ ، نَعَمْ ، فَصَلَّی بِہِمْ رَکْعَتَیْنِ وَسَجَدَ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4552","","","كتاب الصلوات"
"4553","(۴۵۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا : أَحْدَثْت فَصَلِّ رَکْعَتَیْنِ وَإِنْ تَکَلَّمْت۔","","Musannaf Ibn Abi Shaybah 4553","","","كتاب الصلوات"
"4554","(۴۵۵۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن عُرْوَۃَ بْنِ الزُّبَیْرِ ؛ أَنَّہُ صَلَّی مَرَّۃً الْمَغْرِبَ رَکْعَتَیْنِ، ثُمَّ سَلَّمَ فَکَلَّمَ قَائِدَہُ ، فَقَالَ لَہُ قائِدُہُ : إنَّمَا صَلَّیْتَ رَکْعَتَیْنِ ، فَصَلَّی رَکْعَۃً ، ثُمَّ سَلَّمَ وَسَجَدَ سَجْدَتَیْنِ ، ثُمَّ قَالَ: إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَعَلَ مِثْلَ ہَذَا۔","","Musannaf Ibn Abi Shaybah 4554","","","كتاب الصلوات"
"4555","(۴۵۵۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ، قَالَ: أَوْہَمَ إمَامٌ مِنْ أَئِمَّۃِ الْمَسْجِدِ الْجَامِعِ ، فَلَمْ یَسْجُدْ سَجْدَتَیِ السَّہْوِ، فَسَجَدَ بَعْضُ الْقَوْمِ ، وَلَمْ یَسْجُدْ بَعْضُہُمْ ، فَذُکِرَ ذَلِکَ لِلْحَسَنِ ، فَلَمْ یَرَ عَلَیْہِمْ سُجُودًا ، وَذُکِرَ ذَلِکَ لابْنِ سِیرِینَ ، فَاخْتَارَ صَنِیعَ الَّذِینَ سَجَدُوا۔","Hasan","Musannaf Ibn Abi Shaybah 4555","","","كتاب الصلوات"
"4556","(۴۵۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ (ح) وَعَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالاَ : إذَا لَمْ یَسْجُدِ الإمَام ، فَلَیْسَ عَلَیْہِمْ سَہْوٌ۔","","Musannaf Ibn Abi Shaybah 4556","","","كتاب الصلوات"
"4557","(۴۵۵۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ وُہَیب بْنِ عَجْلاَنَ ، قَالَ : رَأَیْتُ الْقَاسِمَ ، وَسَالِمًا صَلَّیَا خَلْفَ إِمَام فَسَہَا فَلَمْ یَسْجُدْ ، فَلَمْ یَسْجُدَا۔","","Musannaf Ibn Abi Shaybah 4557","","","كتاب الصلوات"
"4558","(۴۵۵۸) حَدَّثَنَا عَبْدُالصَّمَدِ بْنُ عَبْدِالْوَارِثِ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، قَالَ : قَالَ حَمَّادٌ: إذَا أَوْہَمَ الإِمَام فَلَمْ یَسْجُدْ، فَلاَ یَسْجُدُوا۔","","Musannaf Ibn Abi Shaybah 4558","","","كتاب الصلوات"
"4559","(۴۵۵۹) حَدَّثَنَا مُصْعَبُ بْنُ الْمِقْدَامِ ، قَالَ : حدَّثَنِی مِسْعَرٌ ، قَالَ : سَأَلْتُ عَنْہُ الْحَکَمَ ، وَحَمَّادًا ، فَقَالَ الْحَکَمُ : یَسْجُدُونَ ، وَقَالَ حَمَّادٌ : لَیْسَ عَلَیْہِمْ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 4559","","","كتاب الصلوات"
"4560","(۴۵۶۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَدْخُلُ مَعَ الإِمَامِ فَیَسْہُو ، قَالَ : تُجْزِئہ صَلاَۃُ الإِمَام ، وَلَیْسَ عَلَیْہِ سَہْوٌ۔","","Musannaf Ibn Abi Shaybah 4560","","","كتاب الصلوات"
"4561","(۴۵۶۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عُبَیْدٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَیْسَ عَلَی مَنْ خَلْفَ الإِمَام سَہْوٌ۔","","Musannaf Ibn Abi Shaybah 4561","","","كتاب الصلوات"
"4562","(۴۵۶۲) حَدَّثَنَا خَالِدُ بْنُ حَیَّانَ ، عَنْ بَکَّارٍ ، عَنْ مَکْحُولٍ ، قَالَ : لَیْسَ عَلَی مَنْ خَلْفَ الإِمَام سَہْوٌ۔","","Musannaf Ibn Abi Shaybah 4562","","","كتاب الصلوات"
"4563","(۴۵۶۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ سَجَدَ سَجْدَتَیِ السَّہْوِ ، وَلاَ نَعْلَمُہُ نَقَصَ ، فَنَقُولُ : إنَّک لَمْ تَنْقُصْ شَیْئًا ؟ فَیَقُولُ : إنِّی حَدَّثْتُ نَفْسِی بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 4563","","","كتاب الصلوات"
"4564","(۴۵۶۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا نُعَیْمُ بْنُ حَکِیمٍ ، عَنْ أَبِی مَرْیَمَ الثَّقَفِیِّ ، قَالَ : صَلَّی بِنَا الْحَسَنُ بْنُ عَلِیٍّ الْمَغْرِبَ ، فَلَمَّا قَضَی الصَّلاَۃ سَجَدَ سَجْدَتَیْنِ ، وَلَمْ نَرَہُ سَہَا ، فَلَمَّا سَلَّمَ قُلْنَا لَہُ ، قَالَ : إنِّی سَہَوْت۔","Majhul","Musannaf Ibn Abi Shaybah 4564","","","كتاب الصلوات"
"4565","(۴۵۶۵) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنْ أَبِیہِ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : سَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الالْتِفَاتِ فِی الصَّلاَۃ ؟ فَقَالَ : اخْتِلاَسَۃٌ یَخْتَلِسُہَا الشَّیْطَانُ مِنْ صَلاَۃِ الْعَبْدِ۔ (بخاری ۷۵۱۔ ابوداؤد ۹۰۷)","Sahih","Musannaf Ibn Abi Shaybah 4565","","","كتاب الصلوات"
"4566","(۴۵۶۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : کَانَ أَبُو بَکْرٍ لاَ یَلْتَفِت إذَا صَلَّی۔","Hasan","Musannaf Ibn Abi Shaybah 4566","","","كتاب الصلوات"
"4567","(۴۵۶۷) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ یَزِیدَ بْنِ عَبْدِ الرَّحْمَنِ الدَّالانِیِّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ زَیْدِ بْنِ وَہْبٍ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ رَأَی رَجُلاً صَلَّی رَکْعَتَیْنِ بَعْدَ غُرُوبِ الشَّمْسِ وَقَبْلَ الصَّلاَۃ ، فَجَعَلَ یَلْتَفِتُ فَضَرَبَہُ بِالدِّرَّۃِ حِینَ قَضَی الصَّلاَۃ ، وَقَالَ : لاَ تَلْتَفِتْ ، ولم یَعِب الرَّکْعَتَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 4567","","","كتاب الصلوات"
"4568","(۴۵۶۸) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : إنَّ اللَّہَ لاَ یَزَالُ مُقْبِلاً عَلَی الْعَبْدِ مَا دَامَ فِی صَلاَتِہِ ، مَا لَمْ یُحْدِثْ ، أَوْ یَلْتَفِتْ۔","","Musannaf Ibn Abi Shaybah 4568","","","كتاب الصلوات"
"4569","(۴۵۶۹) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ مَنْصُورِ بن حَیَّانَ ، قَالَ : حدَّثَنِی جَعْفَرُ بْنُ کَثِیرِ بْنِ الْمُطَّلِبِ السَّہْمِیِّ ، قَالَ : قَالَ أَبُو الدَّرْدَائِ : أَیُّہَا النَّاسُ ، إیَّاکُمْ وَالالْتِفَاتَ فِی الصَّلاَۃ ، فَإِنَّہُ لاَ صَلاَۃَ لِلْمُلْتَفِتِ ، وَإِنْ غُلِبْتُمْ عَلَی تَطَوُّعٍ فَلاَ تُغْلَبُوا عَلَی الْمَکْتُوبَۃِ۔","Majhul","Musannaf Ibn Abi Shaybah 4569","","","كتاب الصلوات"
"4570","(۴۵۷۰) حَدَّثَنَا حَفْصٌ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَکْرَہُ الالْتِفَاتَ فِی الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 4570","","","كتاب الصلوات"
"4571","(۴۵۷۱) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنْ أَبِی عَطِیَّۃَ ، قَالَ : قالَتْ عَائِشَۃُ : الالْتِفَاتُ فِی الصَّلاَۃ خِلْسَۃٌ یَخْتَلِسُہَا الشَّیْطَانُ۔","","Musannaf Ibn Abi Shaybah 4571","","","كتاب الصلوات"
"4572","(۴۵۷۲) حَدَّثَنَا غُنْدَرٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یَقُولُ : إذَا صَلَّیْتَ فَإِنَّ رَبَّک أَمَامَک وَأَنْتَ مُنَاجِیہِ فَلاَ تَلْتَفِتْ ، قَالَ عَطَائٌ : وَبَلَغَنِی أَنَّ الرَّبَّ یَقُولُ : یَا ابْنَ آدَمَ ، إلَی مَنْ تَلْتَفِت ؟ أَنَا خَیْرٌ لَکَ مِمَّنْ تَلْتَفِتُ إلَیْہِ۔","","Musannaf Ibn Abi Shaybah 4572","","","كتاب الصلوات"
"4573","(۴۵۷۳) حَدَّثَنَا جَرِیرٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ مُجَاہِدٍ ، قَالَ : مَا یُؤْمَنُ ہَذَا الَّذِی یَلْتَفِتُ فِی الصَّلاَۃ أَنْ یُقَلِّبَ اللَّہُ وَجْہَہُ ؟ اللَّہُ مُقْبِلٌ عَلَیْہِ وَہُوَ مُلْتَفِتٌ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 4573","","","كتاب الصلوات"
"4574","(۴۵۷۴) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ اللہِ بْنِ مُنْقِذ ، قَالَ : إذَا قَامَ الرَّجُلُ إلَی الصَّلاَۃ أَقْبَلَ اللَّہُ عَلَیْہِ بِوَجْہِہِ ، فَإِذَا الْتَفَتَ أَعْرَضَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 4574","","","كتاب الصلوات"
"4575","(۴۵۷۵) حَدَّثَنَا جَرِیرٌ ، عَنْ ثَابِتٍ ، عَنْ لَیْثٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : ہُوَ یَنْقُصُ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4575","","","كتاب الصلوات"
"4576","(۴۵۷۶) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، قَالَ : رَأَیْتُ سَالِمًا ، وَالْقَاسِمَ لاَ یَلْتَفِتَانِ فِی صَلاَتِہِمَا۔","","Musannaf Ibn Abi Shaybah 4576","","","كتاب الصلوات"
"4577","(۴۵۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی لَبِیدٍ ، عَنْ مُحَمَّدِ بْنِ إبْرَاہِیمَ التَّیْمِیِّ ، عَنْ عَبْدِ اللہِ بْنِ ضَمْرَۃَ ، عَنْ کَعْبٍ ، قَالَ : إذَا قَامَ الرَّجُلُ فِی الصَّلاَۃ أَقْبَلَ اللَّہُ عَلَیْہِ بِوَجْہِہِ مَا لَمْ یَلْتَفِتْ۔","","Musannaf Ibn Abi Shaybah 4577","","","كتاب الصلوات"
"4578","(۴۵۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو عُبَیْدَۃَ النَّاجِی ، عَنِ الْحَسَنِ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّہُ قَالَ فِی مَرَضِہِ : أَقْعِدُونِی ، فَإِنَّ عِنْدِی وَدِیعَۃً أَوْدَعَنِیہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ یَلْتَفِتْ أَحَدُکُمْ فِی صَلاَتِہِ ، فَإِنْ کَانَ لاَ بُدَّ فَاعِلاً فَفِی غَیْرِ مَا افْتَرَضَ اللَّہُ عَلَیْہِ۔ (ترمذی ۵۸۹)","Da'if","Musannaf Ibn Abi Shaybah 4578","","","كتاب الصلوات"
"4579","(۴۵۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا خَطَّابٌ الْعُصْفُرِیُّ ، عَنِ الْحَکَمِ ، قَالَ : إنَّ مِنْ تَمَامِ الصَّلاَۃ أَنْ لاَ تعْرِفَ مَنْ عَنْ یَمِینِکَ ، وَلاَ مَنْ عَنْ شِمَالِک۔","","Musannaf Ibn Abi Shaybah 4579","","","كتاب الصلوات"
"4580","(۴۵۸۰) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا ہُرَیْمٌ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ أَبِی الأَسْوَدِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ : {وَالَّذِینَ ہُمْ عَلَی صَلاَتِہِمْ دَائِمُونَ} قَالَ : الَّذِی لاَ یَلْتَفِتُ فِی صَلاَتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4580","","","كتاب الصلوات"
"4581","(۴۵۸۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، قَالَ : مَا رَأَیْت أَبَا وَائِلٍ مُلْتَفِتًا فِی صَلاَتِہِ قَطُّ۔","","Musannaf Ibn Abi Shaybah 4581","","","كتاب الصلوات"
"4582","(۴۵۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ ، عَنْ رَجُلٍ مِنْ أَصْحَابِ عِکْرِمَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَلْحَظُ فِی الصَّلاَۃ مِنْ غَیْرِ أَنْ یُثْنِیَ عُنُقَہُ۔ (ابوداؤد ۲۵۔ احمد ۱/۲۷۵)","Majhul","Musannaf Ibn Abi Shaybah 4582","","","كتاب الصلوات"
"4583","(۴۵۸۳) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ التَّیْمِیِّ ، عَنْ عِکْرِمَۃَ ؛ أَنَّہُ کَانَ یَفْعَلُہُ۔","","Musannaf Ibn Abi Shaybah 4583","","","كتاب الصلوات"
"4584","(۴۵۸۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : بَعْضُ أَصْحَابِنَا أَخْبَرَنِی عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَلْحَظُ فِی الصَّلاَۃ ، وَلاَ یَلْتَفِتُ۔","Majhul","Musannaf Ibn Abi Shaybah 4584","","","كتاب الصلوات"
"4585","(۴۵۸۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یَقُولُ : إذَا دَخَلَ عَلَی الإِمَام السَّہْوُ فَلَمْ یَدْرِ مَا ہُوَ، فَلْیُلَمِّحْ إلَی مَنْ خَلْفَہُ۔","","Musannaf Ibn Abi Shaybah 4585","","","كتاب الصلوات"
"4586","(۴۵۸۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا خَالِدٌ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، قَالَ : رَأَیْتُ أَنَسَ بْنَ مَالِکٍ یَتَشَرَّفُ إلَی الشَّیْئِ یَنْظُرُ إلَیْہِ فِی الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 4586","","","كتاب الصلوات"
"4587","(۴۵۸۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حُمَیْدٍ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، قَالَ : قِیلَ لابْنِ عُمَرَ : إِنََّ ابْنَ الزُّبَیْرِ إذَا قَامَ إلَی الصَّلاَۃ لَمْ یَلْتَفِتْ ، وَلَمْ یَتَحَرَّکْ ، قَالَ : لَکِنَّا نَلْتَفِتُ وَنَتَحَرَّکُ۔","Hasan","Musannaf Ibn Abi Shaybah 4587","","","كتاب الصلوات"
"4588","(۴۵۸۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ، قَالَ: إذَا سَہَا الإِمَام فَلَمْ یَدْرِ کَمْ صَلَّی نَظَرَ مَا یَصْنَعُ مَنْ خَلْفَہُ۔","","Musannaf Ibn Abi Shaybah 4588","","","كتاب الصلوات"
"4589","(۴۵۸۹) حَدَّثَنَا وَکِیعٌ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ اللہِ بْنِ جُمَیْعٍ ، قَالَ : رَأَیْتُ إبْرَاہِیمَ یَلْحَظُ یَمِینًا وَشِمَالاً۔","","Musannaf Ibn Abi Shaybah 4589","","","كتاب الصلوات"
"4590","(۴۵۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ فِطْرٍ ، قَالَ : رَأَیْتُ ابْنَ مُغَفَّلٍ ، یَفْعَلُہُ۔","","Musannaf Ibn Abi Shaybah 4590","","","كتاب الصلوات"
"4591","(۴۵۹۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَسْہُو مِرَارًا فِی صَلاَتِہِ ، قَالَ : تُجْزِئُہ سَجْدَتَانِ لِجَمِیعِ سَہْوِہِ۔","","Musannaf Ibn Abi Shaybah 4591","","","كتاب الصلوات"
"4592","(۴۵۹۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا انْتَہَی إلَی الإِمَام وَقَدْ سَہَا قَبْلَ ذَلِکَ ، فَلْیَسْجُدْ مَعَ الإِمَامِ ، ثُمَّ لِیَقْضِ مَا سَبَقَ بِہِ۔","","Musannaf Ibn Abi Shaybah 4592","","","كتاب الصلوات"
"4593","(۴۵۹۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ؛ کَمَا قَالَ إبْرَاہِیمُ۔","","Musannaf Ibn Abi Shaybah 4593","","","كتاب الصلوات"
"4594","(۴۵۹۴) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا سُبِقَ بِبَعْضِ الصَّلاَۃ وَقَدْ سَہَا الإِمَام ، قَالَ: یَسْجُدُ مَعَ الإِمَامِ ، ثُمَّ یَقُومُ فَیَقْضِی۔","","Musannaf Ibn Abi Shaybah 4594","","","كتاب الصلوات"
"4595","(۴۵۹۵) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ؛ مِثْلُہُ۔","","Musannaf Ibn Abi Shaybah 4595","","","كتاب الصلوات"
"4596","(۴۵۹۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، وَالْحَسَنِ ، قَالَ ابْنُ سِیرِینَ : یَقْضِی ، ثُمَّ یَسْجُدُ ، وَقَالَ الْحَسَنُ : یَسْجُدُ مَعَ الإِمَامِ ، ثُمَّ یَقُومُ فَیَقْضِی۔","","Musannaf Ibn Abi Shaybah 4596","","","كتاب الصلوات"
"4597","(۴۵۹۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، [corrupt]َالَ : یَسْجُدُ مَعَ الإِمَامِ ، فَإِذَا انْصَرَفَ قَامَ فَقَضَی مَا سَبَقَہُ بِہِ۔","","Musannaf Ibn Abi Shaybah 4597","","","كتاب الصلوات"
"4598","(۴۵۹۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ أَبِی سَعِیدٍ ، وَابْنِ عُمَرَ ، وَابْنِ الزُّبَیْرِ ؛ فِی الرَّجُلِ یَدْخُلُ مَعَ الإِمَامِ وَقَدْ فَاتَہُ بَعْضُ الصَّلاَۃ ، قَالُوا : یَصْنَعُ کَمَا یَصْنَعُ الإِمَام ، فَإِذَا قَضَی الإِمَام صَلاَتَہُ قَامَ فَقَضَی، وَسَجَدَ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4598","","","كتاب الصلوات"
"4599","(۴۵۹۹) حَدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنْ زَکَرِیَّا بْنِ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : إذَا فَاتَکَ التَّشَہُّدُ فِی الرَّکْعَتَیْنِ ، فَلاَ تَجْلِسْ فِی رَکْعَتِکَ تَشَہَّدُ ، اقْتَدِ بِالإِمَام۔","","Musannaf Ibn Abi Shaybah 4599","","","كتاب الصلوات"
"4600","(۴۶۰۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ فِی الرَّجُلِ یَدْخُلُ فِی الصَّلاَۃ وَقَدْ سُبِقَ بِرَکْعَۃٍ ، فَإِنَّہُ یَصْنَعُ کَمَا یَصْنَعُ الإِمَام ، فَإِذَا سَلَّمَ قَامَ وَقَضَی۔","","Musannaf Ibn Abi Shaybah 4600","","","كتاب الصلوات"
"4601","(۴۶۰۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عُقْبَۃَ بْنِ أَبِی الْعَیْزَارِ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ عَنِ الرَّجُلِ یَدْخُلُ مَعَ الإِمَامِ وَقَدْ سَبَقَہُ الإِمَام بِرَکْعَۃٍ وَقَدْ سَہَا الإِمَام ، فَکَیْفَ یَصْنَعُ ؟ قَالَ : إذَا دَخَلْتَ مَعَ الإِمَامِ فَاصْنَعْ کَمَا یَصْنَعُ۔","","Musannaf Ibn Abi Shaybah 4601","","","كتاب الصلوات"
"4602","(۴۶۰۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ أَبِی جَابِرٍ الْبَیَاضِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی بِالنَّاسِ وَہُوَ جُنُبٌ ، فَأَعَادَ وَأَعَادُوا۔ (بیہقی ۴۰۰)","","Musannaf Ibn Abi Shaybah 4602","","","كتاب الصلوات"
"4603","(۴۶۰۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ صَلَّی بِہِمُ الْغَدَاۃَ ، ثُمَّ ذَکَرَ أَنَّہُ صَلَّی بِغَیْرِ وُضُوئٍ فَأَعَادَ ، وَلَمْ یُعِیدُوا۔","Sahih","Musannaf Ibn Abi Shaybah 4603","","","كتاب الصلوات"
"4604","(۴۶۰۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ؛ أَنَّ عُمَرَ صَلَّی بِالنَّاسِ وَہُوَ جُنُبٌ فَأَعَادَ ، وَأَمَرَہُمْ أَنْ لاَ یُعِیدُوا۔","","Musannaf Ibn Abi Shaybah 4604","","","كتاب الصلوات"
"4605","(۴۶۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ یَزِیدَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ عَلِیٍّ ، قَالَ : یُعِیدُ وَیُعِیدُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 4605","","","كتاب الصلوات"
"4606","(۴۶۰۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ أَمَّ قَوْمًا فِی شَہْرِ رَمَضَانَ وَہُوَ عَلَی غَیْرِ وُضُوئٍ ، فَصَلَّی بِہِمْ صَلاَۃَ الْعِشَائِ ، وَصَلاَۃَ رَمَضَانَ وَالْوِتْرَ ؟ فَقَالَ : یُعِیدُ ، وَلاَ یُعِیدُ مَنْ خَلْفَہُ۔","","Musannaf Ibn Abi Shaybah 4606","","","كتاب الصلوات"
"4607","(۴۶۰۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : سَأَلْتُہُ ، فَقَالَ : أَعِدِ الصَّلاَۃ وَأَخْبِرْ أَصْحَابَک أَنَّک صَلَّیْتَ بِہِمْ وَأَنْتَ غَیْرُ طَاہِرٍ۔","Hasan","Musannaf Ibn Abi Shaybah 4607","","","كتاب الصلوات"
"4608","(۴۶۰۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُعِیدُ ، وَلاَ یُعِیدُ مَنْ خَلْفَہُ۔","","Musannaf Ibn Abi Shaybah 4608","","","كتاب الصلوات"
"4609","(۴۶۰۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذا صَلَّی الْجُنُبُ بِالْقَوْمِ فَأَتَمَّ بِہِمُ الصَّلاَۃ ، آمُرُہ أَنْ یَغْتَسِلَ وَیُعِیدَ ، وَلَمْ آمُرْہُمْ أَنْ یُعِیدُوا۔","Da'if","Musannaf Ibn Abi Shaybah 4609","","","كتاب الصلوات"
"4610","(۴۶۱۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ؛ أَنَّہُ قَالَ فِی الرَّجُلِ یُصَلِّی بِالْقَوْمِ وَہُوَ جُنُبٌ ، قَالَ : أَحَبُّ إلَیَّ أَنْ یُعِیدُوا۔","","Musannaf Ibn Abi Shaybah 4610","","","كتاب الصلوات"
"4611","(۴۶۱۱) حَدَّثَنَا قَبِیصَۃُ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الشَّیْبَانِیِّ ، عَنْ بُکَیْرِ بْنِ الأَخْنَسِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : إذَا صَلَّی بِہِمْ وَہُوَ عَلَی غَیْرِ وُضُوئٍ أَعَادَ ، وَلَمْ یُعِیدُوا ، قَالَ سُفْیَانُ : وَأَحَبُّ إلَیَّ أَنْ یُعِیدَ وَیُعِیدُوا۔","","Musannaf Ibn Abi Shaybah 4611","","","كتاب الصلوات"
"4612","(۴۶۱۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ خُصَیْفٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ ابْنُ عُمَرَ إذَا دَخَلَ بَیْتًا ، فَرَأَی فِی قِبْلَۃِ الْمَسْجِدِ مُصْحَفًا ، أَوْ شِبْہَہُ أَخَذَہُ فَرَمَی بِہِ ، وَإِنْ کَانَ عَنْ یَمِینِہِ ، أَوْ شِمَالِہِ تَرَکَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 4612","","","كتاب الصلوات"
"4613","(۴۶۱۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یُصَلِّیَ الرَّجُلُ وَفِی قِبْلَۃِ الْمَسْجِدِ مُصْحَفٌ ، أَوْ غَیْرُہُ۔","","Musannaf Ibn Abi Shaybah 4613","","","كتاب الصلوات"
"4614","(۴۶۱۴) حَدَّثَنَا حَرَمِیّ بن عُمَارَۃَ بْنِ أَبِی حَفْصَۃَ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنِ الرَّجُلِ یَکُونُ بَیْنَہُ وَبَیْنَ الْقِبْلَۃِ الْمُصْحَفُ ؟ فَکَرِہَاہ۔","","Musannaf Ibn Abi Shaybah 4614","","","كتاب الصلوات"
"4615","(۴۶۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَکُونَ بَیْنَہُمْ وَبَیْنَ الْقِبْلَۃِ شَیْئٌ حَتَّی الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 4615","","","كتاب الصلوات"
"4616","(۴۶۱۶) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ خُصَیْفٍ ، عَنْ مِقْسَمٍ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : لاَ تُصَلِّ فِی بَیْتٍ فِیہِ تَمَاثِیلُ۔","Da'if","Musannaf Ibn Abi Shaybah 4616","","","كتاب الصلوات"
"4617","(۴۶۱۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عَطَائٍ الْخُرَاسَانِیِّ ، قَالَ : لَمَّا بُنِیَ الْمَسْجِدُ فِی عَہْدِ عُثْمَانَ جَعَلُوا فِی سَقْفِہِ أُتْرُجَّۃ ، فَکَانَ الدَّاخِلُ إذَا دَخَلَ یَسْمُو بَصَرُہُ إلَیْہَا ، فَبَلَغَ ذَلِکَ عُثْمَانَ فَأَمَرَ بِہَا فَنُزِعَتْ۔","","Musannaf Ibn Abi Shaybah 4617","","","كتاب الصلوات"
"4618","(۴۶۱۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مَنْصُورِ بْنِ صَفِیَّۃَ ، عَنْ خَالَۃِ مُسَافِعٍ ، عَنْ أُخْتِہِ صَفِیَّۃَ أُمِّ مَنْصُورٍ ، قَالَتْ : أَخْبَرَتْنِی امْرَأَۃٌ مِنْ أَہْلِ الدَّارِ مِنْ بَنِی سُلَیْمٍ ، قَالَتْ : قُلْتُ لِعُثْمَانَ بْنِ طَلْحَۃَ : لِمَ دَعَاک رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ خَرَجَ مِنَ الْبَیْتِ ؟ قَالَ : قَالَ : إنِّی رَأَیْتُ قَرْنَیِ الْکَبْشِ فَنَسِیتُ أَنْ آمُرَک أَنْ تُخَمِّرَہُمَا ، وَإِنَّہُ لاَ یَنْبَغِی أَنْ یَکُونَ فِی الْبَیْتِ شَیْئٌ یَشْغَلُ الْمُصَلِّیَ۔ (ابوداؤد ۲۰۲۳۔ عبدالرزاق ۹۰۸۳)","Majhul","Musannaf Ibn Abi Shaybah 4618","","","كتاب الصلوات"
"4619","(۴۶۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عِیسَی بْنِ حُمَیْدٍ ، قَالَ : سَأَلَ عُقْبَۃُ الْحَسَنَ ، قَالَ : إنَّ فِی مَسْجِدِنَا سَاجَۃً فِیہَا تَصَاوِیرُ ، قَالَ : اِنْخَرُوہَا۔","","Musannaf Ibn Abi Shaybah 4619","","","كتاب الصلوات"
"4620","(۴۶۲۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ خَالِدٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : حَدَّثَتْنِی لُبَابَۃُ ، عَنْ أُمِّہَا ، وَکَانَتْ تَخْدِمُ عُثْمَانَ بْنَ عَفَّانَ ؛ أَنَّ عُثْمَانَ بْنَ عَفَّانَ کَانَ یُصَلِّی إلَی تَابُوتٍ فِیہِ تَمَاثِیلُ ، فَأَمَرَ بِہِ فَحُکَّ۔","Majhul","Musannaf Ibn Abi Shaybah 4620","","","كتاب الصلوات"
"4621","(۴۶۲۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَبْدُ الْمَلِکِ بْنُ أَبِی سُلَیْمَانَ ، عَنْ عَطَائٍ ؛ أَنَّہُ سُئِلَ عَنِ الْمَسْجِدِ یُکْتَبُ فِی قِبْلَتِہِ مِنَ الْقُرْآنِ ؟ فَلَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 4621","","","كتاب الصلوات"
"4622","(۴۶۲۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 4622","","","كتاب الصلوات"
"4623","(۴۶۲۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُحَمَّدِ بْنِ الزُّبَیْرِ الْحَنْظَلِیِّ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ رَأَی ابْنًا لَہُ کَتَبَ فِی الْحَائِطِ ، بِسْمِ اللہِ ، فَضَرَبَہُ۔","","Musannaf Ibn Abi Shaybah 4623","","","كتاب الصلوات"
"4624","(۴۶۲۴) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سَعِیدُ بْنُ زِیَادٍ ، عَنْ زِیَادِ بْنِ صُبَیْحِ الْحَنَفِیِّ ، قَالَ : صَلَّیْت إلَی جَنْبِ ابْنِ عُمَرَ فَوَضَعْتُ یَدِی عَلَی خَاصِرَتِی ، فَلَمَّا صَلَّی ، قَالَ : ہَذَا الصُّلْبُ فِی الصَّلاَۃ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْہَی عَنْہُ۔ (ابوداؤد ۸۹۹۔ احمد ۲/۳۰)","Hasan","Musannaf Ibn Abi Shaybah 4624","","","كتاب الصلوات"
"4625","(۴۶۲۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَرِہَتْ أَنْ یَضَعَ یَدَہُ عَلَی خَاصِرَتِہِ فِی الصَّلاَۃ ، وَقَالَتْ : تَفْعَلُہُ الْیَہُودُ۔","Sahih","Musannaf Ibn Abi Shaybah 4625","","","كتاب الصلوات"
"4626","(۴۶۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ثَوْرٌ الشَّامِیُّ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا رَأَتْ رَجُلاً وَاضِعًا یَدَہُ عَلَی خَاصِرَتِہِ ، فَقَالَتْ : ہَکَذَا أَہْلُ النَّارِ فِی النَّارِ۔","Sahih","Musannaf Ibn Abi Shaybah 4626","","","كتاب الصلوات"
"4627","(۴۶۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ صَالِحٍ مَوْلَی التَّوْأَمَۃِ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَرِہَہُ فِی الصَّلاَۃ ، وَقَالَ : إنَّ الشَّیْطَانَ یَحْضُرُ ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 4627","","","كتاب الصلوات"
"4628","(۴۶۲۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَرِہَ أَنْ یَضَعَ الرَّجُلُ یَدَہُ عَلَی خَاصِرَتِہِ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4628","","","كتاب الصلوات"
"4629","(۴۶۲۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ إِسْحَاقَ بْنِ عُوَیْمِرٍ ، عَنْ مُجَاہِدٍ ، قَالَ : وَضْعُ الْیَدَیْنِ عَلَی الْحَقْوِ اسْتِرَاحَۃُ أَہْلِ النَّارِ۔","","Musannaf Ibn Abi Shaybah 4629","","","كتاب الصلوات"
"4630","(۴۶۳۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِمْرَانُ بْنُ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ؛ أَنَّہُ رَأَی رَجُلاً وَاضِعًا یَدَہُ عَلَی خَاصِرَتِہِ فِی الصَّلاَۃ ، فَضَرَبَ یَدَہُ۔","","Musannaf Ibn Abi Shaybah 4630","","","كتاب الصلوات"
"4631","(۴۶۳۱) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ؛ أَنَّہُ إنَّمَا کُرِہَ التَّخَصُّرُ فِی الصَّلاَۃ ، أَنَّ إبْلِیسَ أُہْبِطَ مُتَخَصِّرًا۔","","Musannaf Ibn Abi Shaybah 4631","","","كتاب الصلوات"
"4632","(۴۶۳۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : نُہِیَ عَنِ الاخْتِصَارِ فِی الصَّلاَۃ ، قَالَ مُحَمَّدٌ : وَہُوَ أَنْ یَضَعَ یَدَہ عَلَی خَاصِرَتِہِ وَہُوَ یُصَلِّی۔ (بخاری ۱۲۲۰۔ ابوداؤد ۹۴۴)","Sahih","Musannaf Ibn Abi Shaybah 4632","","","كتاب الصلوات"
"4633","(۴۶۳۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُریرِیِّ ، عَنْ حَیَّانَ بْنِ عُمَیْرٍ ، قَالَ : إِنی کُنْتُ مَعَ قَسِ بْنِ عُبَادٍ ، فَرَأَی رَجُلاً یُصَلِّی مُتَخَصِّرًا ، فَقَالَ : اذْہَبْ إلَی ذَلکَ فَقُلْ لَہُ : یَضَعُ یَدَہ مِنْ مَکَانِ یَدِ الراجز۔","","Musannaf Ibn Abi Shaybah 4633","","","كتاب الصلوات"
"4634","(۴۶۳۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَرِہَتِ الاخْتِصَارَ فِی الصَّلاَۃِ ، وَقَالَتْ : لاَ تَشَبَّہُوا بِالْیَہُودِ۔","Sahih","Musannaf Ibn Abi Shaybah 4634","","","كتاب الصلوات"
"4635","(۴۶۳۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ نَہَی أَنْ یُصَلِّیَ الرَّجُلُ مُتَخَصِّرًا۔","Hasan","Musannaf Ibn Abi Shaybah 4635","","","كتاب الصلوات"
"4636","(۴۶۳۶) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی سَلَمَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أُمِّ سَلَمَۃَ أُمِّ الْمُؤْمِنِینَ ، قَالَتْ : وَالَّذِی ذَہَبَ بِنَفْسِہِ ، مَا مَاتَ حَتَّی کَانَ أَکْثَرُ صَلاَتِہِ وَہُوَ جَالِسٌ۔ (احمد ۳۲۲۔ طبرانی ۵۱۶)","","Musannaf Ibn Abi Shaybah 4636","","","كتاب الصلوات"
"4637","(۴۶۳۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ کَہْمَسٍ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ ، قَالَ : سَأَلْتُ عَائِشَۃَ ، أَکَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی قَاعِدًا ؟ قَالَتْ : بَعْدَ مَا حَطَّمَتْہُ السِّنُّ۔ (مسلم ۵۰۶۔ ابوداؤد ۹۵۳)","Sahih","Musannaf Ibn Abi Shaybah 4637","","","كتاب الصلوات"
"4638","(۴۶۳۸) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنِ سِمَاکِ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : مَا مَاتَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی صَلَّی قَاعِدًا۔ (مسلم ۱۱۹۔ بیہقی ۴۹۰)","Hasan","Musannaf Ibn Abi Shaybah 4638","","","كتاب الصلوات"
"4639","(۴۶۳۹) حَدَّثَنَا عَبْدَۃُ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، قَالَ : مَا رَأَیْت ابْنَ عُمَرَ یُصَلِّی جَالِسًا إِلاَّ مِنْ مَرَضٍ۔","Sahih","Musannaf Ibn Abi Shaybah 4639","","","كتاب الصلوات"
"4640","(۴۶۴۰) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ مُبَارَکٍ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمِ بْنِ یَسَارٍ ، عَنْ أَبِیہِ ، قَالَ : إنِّی لأَکْرَہُ أَنْ یَرَانِی اللَّہُ أُصَلِّی لَہُ قَاعِدًا مِنْ غَیْر مَرَضٍ۔","","Musannaf Ibn Abi Shaybah 4640","","","كتاب الصلوات"
"4641","(۴۶۴۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَمْرِو بْنِ مَیْمُونِ بْنِ مِہْرَانَ ، عَنْ أَبِیہِ ؛ أَنَّہُ سُئِلَ ، مَا حَدُّ الْمَرِیضِ أَنْ یُصَلِّیَ جَالِسًا ؟ فَقَالَ : حَدُّہُ لَوْ کَانَتْ دُنْیَا تُعْرَضُ لَہُ لَمْ یَقُمْ إلَیْہَا۔","","Musannaf Ibn Abi Shaybah 4641","","","كتاب الصلوات"
"4642","(۴۶۴۲) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، قَالَ : رَأَیْتُ أَنَسَ بْنَ مَالِکٍ یُصَلِّی فِی الْمَقْصُورَۃِ الْمَکْتُوبَۃَ مَعَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، ثُمَّ یَخرج عَلَیْنَا مِنْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 4642","","","كتاب الصلوات"
"4643","(۴۶۴۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ؛ أَنَّ الْحَسَنَ کَانَ یُصَلِّی فِی الْمَقْصُورَۃِ۔","","Musannaf Ibn Abi Shaybah 4643","","","كتاب الصلوات"
"4644","(۴۶۴۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ جَعْفَرٍ، قَالَ: کَانَ عَلِیُّ بْنُ حُسَیْنٍ، وأبی والْقَاسِمُ یُصَلُّونَ فِی الْمَقْصُورَۃِ۔","","Musannaf Ibn Abi Shaybah 4644","","","كتاب الصلوات"
"4645","(۴۶۴۵) حَدَّثَنَا عُمَرُ بْنُ ہَارُونَ ، عَنْ عُبَیْدِ اللہِ بْنِ یَزِیدَ ، قَالَ : رَأَیْتُ السَّائِبَ بْنَ یَزِیدَ یُصَلِّی الْمَکْتُوبَۃَ فِی الْمَقْصُورَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 4645","","","كتاب الصلوات"
"4646","(۴۶۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ قَیْسِ بْنِ عَبْدِ اللہِ ، وَکَانَ ثِقَۃً ، قَالَ : رَأَیْتُ الْحَسَنَ یُصَلِّی فِی الْمَقْصُورَۃِ۔","","Musannaf Ibn Abi Shaybah 4646","","","كتاب الصلوات"
"4647","(۴۶۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سَلَمَۃَ بْنِ وَرْدَانَ ، قَالَ : رَأَیْتُ أَنَسًا صَلَّی عِنْدَ الْحَجَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 4647","","","كتاب الصلوات"
"4648","(۴۶۴۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ عَامِرِ بْنِ ذُؤَیْبٍ ، قَالَ : سَأَلْتُ ابْنُ عُمَرَ عَنِ الصَّلاَۃ مِنْ وَرَائِ الْحَجَرِ ؟ فَقَالَ : إنَّہُمْ یَخَافُونَ أَنْ یَقْتُلُوہُمْ۔","Majhul","Musannaf Ibn Abi Shaybah 4648","","","كتاب الصلوات"
"4649","(۴۶۴۹) حَدَّثَنَا حَفْصٌ ، عَنْ عُبَیْدِ اللہِ ، قَالَ : رَأَیْتُ سَالِمًا ، وَالْقَاسِمَ ، وَنَافِعًا یُصَلُّونَ فِی الْمَقْصُورَۃِ۔","","Musannaf Ibn Abi Shaybah 4649","","","كتاب الصلوات"
"4650","(۴۶۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنِ الأَزْرَقِ بْنِ قَیْسٍ ، عَنِ الأَحْنَفِ بْنِ قَیْسٍ ؛ أَنَّہُ کَرِہَ الصَّلاَۃ فِی الْمَقْصُورَۃِ۔","","Musannaf Ibn Abi Shaybah 4650","","","كتاب الصلوات"
"4651","(۴۶۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ عِیسَی الْخَیَّاطِ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَیْسَ الْمَقْصُورَۃُ مِنَ الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 4651","","","كتاب الصلوات"
"4652","(۴۶۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ جَبَلَۃَ بْنِ عَطِیَّۃَ ، عَنِ ابْنِ مُحَیْرِیزٍ ؛ أَنَّہُ کَرِہَ الصَّلاَۃ فِیہَا۔","","Musannaf Ibn Abi Shaybah 4652","","","كتاب الصلوات"
"4653","(۴۶۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عِیسَی ، عَنْ نَافِعٍ ؛ أَنَّ ابْنَ عُمَرَ کَانَ إذَا حَضَرَتْہُ الصَّلاَۃ وَہُوَ فِی الْمَقْصُورَۃِ خَرَجَ إلَی الْمَسْجِدِ۔","Da'if","Musannaf Ibn Abi Shaybah 4653","","","كتاب الصلوات"
"4654","(۴۶۵۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ أَبِی حَیَّانَ الأَشْجَعِیِّ ،وَکَانَ مِنْ أَصْحَابِ عَبْدِ اللہِ ، قَالَ : قَالَ عبد اللہ : لاَ تُبَادِرُوا أَئِمَّتَکُمْ بِالرُّکُوعِ ، وَلاَ بِالسُّجُودِ ، وَإِذَا رَفَعَ أَحَدُکُمْ رَأْسَہُ وَالإِمَام سَاجِدٌ فَلْیَسْجُدْ ، ثُمَّ لْیَمْکُثْ قَدْرَ مَا سَبَقَ بِہِ الإِمَام۔","Majhul","Musannaf Ibn Abi Shaybah 4654","","","كتاب الصلوات"
"4655","(۴۶۵۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ ہِلاَلٍ ، عَنْ أَبِی حَیَّانَ ، قَالَ : قَالَ عبد اللہ : فَذَکَرَ نَحْوَہُ۔","Majhul","Musannaf Ibn Abi Shaybah 4655","","","كتاب الصلوات"
"4656","(۴۶۵۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَعْقُوبَ بْنِ عَبْدِ اللہِ بن الأَشَجِّ ، عَنْ بُسر بْنِ سَعِیدٍ ، عَنِ الْحَارِثِ بْنِ الْمَخْلَدِ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عُمَرُ : مَنْ رَفَعَ رَأْسَہُ قَبْلَ الإِمَام فَلْیُعِدْ ، وَلْیَمْکُثْ حَتَّی یَرَی أَنَّہُ أَدْرَکَ مَا فَاتَہُ۔","Majhul","Musannaf Ibn Abi Shaybah 4656","","","كتاب الصلوات"
"4657","(۴۶۵۷) حَدَّثَنَا مُحَمَّدُ بْنُ ہَارُونَ الْبَصْرِیُّ ، عَنْ سُلَیْمَانَ بْنِ کِنْدِیرٍ ، قَالَ : صَلَّیْت إلَی جَنْبِ ابْنِ عُمَرَ فَرَفَعْت رَأْسِی قَبْلَ الإِمَام ، فَأَخَذَہُ فَأَعَادَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 4657","","","كتاب الصلوات"
"4658","(۴۶۵۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ : إذَا رَفَعَ رَأْسَہُ قَبْلَ الإِمَام وَالإِمَامُ سَاجِدٌ فَلْیَعُدْ ، فَلْیَسْجُدْ۔","","Musannaf Ibn Abi Shaybah 4658","","","كتاب الصلوات"
"4659","(۴۶۵۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَقُولُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 4659","","","كتاب الصلوات"
"4660","(۴۶۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : یَعُودُ فَیَسْجُدُ۔","","Musannaf Ibn Abi Shaybah 4660","","","كتاب الصلوات"
"4661","(۴۶۶۱) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا رَفَعْتَ رَأْسَک قَبْلَ الإِمَام فَعُدْ إلَی أَنْ تَرَی ، أَنَّ الإِمَام قَدْ رَفَعَ قَبْلَک۔","","Musannaf Ibn Abi Shaybah 4661","","","كتاب الصلوات"
"4662","(۴۶۶۲) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مُخَارِقٍ ، قَالَ : مَرَرْتُ بِأَبِی ذَرٍّ بِالرَّبَذَۃِ وَأَنَا حَاجٌّ ، فَدَخَلْت عَلَیْہِ مَنْزِلَہُ ، فَرَأَیْتُہُ یُصَلِّی یُخَفِّفُ الْقِیَامَ قَدْرَ مَا یَقْرَأُ (إنَّا أَعْطَیْنَاک الْکَوْثَرَ) ، وَ(إذَا جَائَ نَصْرُ اللہِ) وَیُکْثِرُ الرُّکُوعَ وَالسُّجُودَ ، فَلَمَّا قَضَی صَلاَتَہُ ، قُلْتُ : یَا أَبَا ذَرٍّ ، رَأَیْتُک تُخَفِّف الْقِیَامَ وَتُکْثِرُ الرُّکُوعَ وَالسُّجُودَ ؟ فَقَالَ : إنِّی سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَا مِنْ عَبْدٍ یَسْجُدُ لِلَّہِ سَجْدَۃً ، أَوْ یَرْکَعُ لَہُ رَکْعَۃً ، إِلاَّ حَطَّ اللَّہُ بِہَا عَنہ خَطِیئََۃ ، وَرَفَعَ لَہُ بِہَا دَرَجَۃ۔ (احمد ۵/۱۴۷۔ بزار ۳۹۰۳)","Majhul","Musannaf Ibn Abi Shaybah 4662","","","كتاب الصلوات"
"4663","(۴۶۶۳) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : ذَکَرُوا سُجُودَ الْقُرْآنِ عِنْدَ عَائِشَۃَ ، فَقَالَتْ : ہُوَ فَرِیضَۃٌ أَدَّیْتَہَا ، أَوْ تَطَوُّعٌ تَطَوَّعْتَہُ ، مَا مِنْ مُسْلِمٍ یَسْجُدُ سَجْدَۃً إِلاَّ رَفَعَ اللَّہُ لَہ بِہَا دَرَجَۃً ، وَحَطَّ عَنْہُ خَطِیئَۃ۔","","Musannaf Ibn Abi Shaybah 4663","","","كتاب الصلوات"
"4664","(۴۶۶۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ دَاوُدَ ، عَنْ أَبِی عُثْمَانَ ، عَنْ مُطَرِّفِ بْنِ عَبْدِ اللہِ بْنِ الشِّخِّیرِ ، قَالَ : أتَیْتُ الشَّامَ فَإِذَا أَنَا بِرَجُلٍ یُصَلِّی ، یَرْکَعُ وَیَسْجُدُ وَلاَ یَفْصِلُ ، فَقُلْتُ : لَوْ قَعَدْتُ حَتَّی أَرْشُدَ ہَذَا الشَّیْخَ ، قَالَ: فَجَلَسْتُ ، فَلَمَّا قَضَی الصَّلاَۃ قُلْتُ لَہُ : یَا عَبْدَ اللہِ ، أَعَلَی شَفْعٍ انْصَرَفْتَ أَمْ عَلَی وِتْرٍ ؟ قَالَ : قَدْ کُفِیتُ ذَلِکَ ، قُلْتُ : وَمَنْ یَکْفِیک ؟ قَالَ : الْکِرَامُ الْکَاتِبُونَ مَا سَجَدْتُ سَجْدَۃً إِلاَّ رَفَعَنِی اللَّہُ بِہَا دَرَجَۃً ، وَحَطَّ عَنِّی بِہَا خَطِیئَۃً ، قُلْتُ : مَنْ أَنْتَ یَا عَبْدَ اللہِ ؟ قَالَ : أَبُو ذَرٍّ ، قُلْتُ : ثَکِلْت مُطْرِفًا أُمُّہُ یُعْلِمُ أَبَا ذَرٍّ السُّنَّۃَ ، فَلَمَّا أَتَیْتُ مَنْزِلَ کَعْبٍ قِیلَ لِی : قَدْ سَأَلَ عَنْک ، فَلَمَّا لَقِیتُہُ ذَکَرْتُ لَہُ أَمْرَ أَبِی ذَرٍّ ، وَمَا قَالَ لِی ، قَالَ : فَقَالَ لِی مِثْلَ قَوْلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4664","","","كتاب الصلوات"
"4665","(۴۶۶۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، قَالَ : قِیلَ لِثَوْبَانَ : حَدِّثْنَا عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَکْذِبُونَ عَلَیَّ سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَا مِنْ مُسْلِمٍ یَسْجُدُ لِلَّہِ سَجْدَۃً إِلاَّ رَفَعَہُ اللَّہُ بِہَا دَرَجَۃً ، أَوْ حَطَّ عَنْہُ بِہَا خَطِیئَۃً۔ (مسلم ۲۲۵۔ ترمذی ۳۸۹)","","Musannaf Ibn Abi Shaybah 4665","","","كتاب الصلوات"
"4666","(۴۶۶۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ حُسَیْنٍ الْمُعَلِّمِ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ؛ أَنَّہُ سَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الصَّلاَۃ قَاعِدًا ؟ فَقَالَ : صَلِّ قَائِمًا ، فَإِنَّہُ أَفْضَلُ ، ثُمَّ قَالَ : صَلاَۃُ الْقَاعِدِ عَلَی النِّصْفِ مِنْ صَلاَۃِ الْقَائِمِ ، وَصَلاَۃُ النَّائِمِ عَلَی النِّصْفِ مِنْ صَلاَۃِ الْقَاعِدِ۔ (بخاری ۱۱۱۷۔ ابوداؤد ۹۴۸)","Sahih","Musannaf Ibn Abi Shaybah 4666","","","كتاب الصلوات"
"4667","(۴۶۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ شَیْخٍ یُکَنَّی أَبَا مُوسَی ، عَنْ عَبْدِ اللہِ بْنِ عَمْرو ، قَالَ : أُرَاہُ عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : صَلاَۃُ الْقَاعِدِ عَلَی النِّصْفِ مِنْ صَلاَۃِ الْقَائِمِ۔ (ابن ماجہ ۱۲۲۹۔ احمد ۲/۱۹۲)","Majhul","Musannaf Ibn Abi Shaybah 4667","","","كتاب الصلوات"
"4668","(۴۶۶۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنِ الزُّہْرِیِّ ، عَنِ ابْنِ عَمْرو ، قَالَ : قَدِمْنَا الْمَدِینَۃَ فَأَصَابَنَا وَبَائٌ حَتَّی سَبَّحْنَا قُعُودًا ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَلاَۃُ الْقَاعِدِ عَلَی النِّصْفِ مِنْ صَلاَۃِ الْقَائِمِ۔","","Musannaf Ibn Abi Shaybah 4668","","","كتاب الصلوات"
"4669","(۴۶۶۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرو ، قَالَ : صَلاَۃُ الْقَاعِدِ عَلَی النِّصْفِ مِنْ صَلاَۃِ الْقَائِمِ۔","Sahih","Musannaf Ibn Abi Shaybah 4669","","","كتاب الصلوات"
"4670","(۴۶۷۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ زُہَیْرٍ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّ السَّائِبَ سَأَلَ عَائِشَۃَ عَنْ صَلاَۃِ الْقَاعِدِ ؟ فَقَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَلاَۃُ الْقَاعِدِ عَلَی النِّصْفِ مِنْ صَلاَۃِ الْقَائِمِ۔ (نسائی ۴۹۴۱۔ احمد ۶/۲۲۷)","","Musannaf Ibn Abi Shaybah 4670","","","كتاب الصلوات"
"4671","(۴۶۷۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : صَلاَۃُ الْقَاعِدِ غَیْرُ مُتَرَبِّعٍ عَلَی النِّصْفِ مِنْ صَلاَۃِ الْقَائِمِ۔","","Musannaf Ibn Abi Shaybah 4671","","","كتاب الصلوات"
"4672","(۴۶۷۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الْعَوَّامُ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ الْکَاہِلِیِّ ، قَالَ : صَلاَۃُ الْقَاعِدِ عَلَی النِّصْفِ مِنْ صَلاَۃِ الْقَائِمِ إِلاَّ مِنْ عُذْرٍ۔","","Musannaf Ibn Abi Shaybah 4672","","","كتاب الصلوات"
"4673","(۴۶۷۳) حَدَّثَنَا مُعَلَّی بْنُ مَنْصُورٍ ، وَخَالِدُ بْنُ مَخْلَدٍ ، عَنْ عَبْدِ اللہِ بْنِ جَعْفَرٍ ، عَنْ إسْمَاعِیلَ بْنِ مُحَمَّدِ بْنِ سَعْدٍ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَلاَۃُ الْقَاعِدِ عَلَی مِثْلِ نِصْفِ صَلاَۃِ الْقَائِمِ۔(نسائی ۱۳۶۴۔ احمد ۳/۲۱۴)","Sahih","Musannaf Ibn Abi Shaybah 4673","","","كتاب الصلوات"
"4674","(۴۶۷۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَوْفٌ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُصَلِّیَ الرَّجُلُ وَہُوَ مُحْتَبٍ، وَابْنُ سِیرِینَ کَانَ یَکْرَہُہُ۔","","Musannaf Ibn Abi Shaybah 4674","","","كتاب الصلوات"
"4675","(۴۶۷۵) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یُصَلِّی مُحْتَبِیًا۔","","Musannaf Ibn Abi Shaybah 4675","","","كتاب الصلوات"
"4676","(۴۶۷۶) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ؛ أَنَّ أَبَاہُ کَانَ یُصَلَّی مُحْتَبِیًا۔","","Musannaf Ibn Abi Shaybah 4676","","","كتاب الصلوات"
"4677","(۴۶۷۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ دَاوُد ، عَنْ طَلْحَۃَ بْنِ یَحْیَی ، قَالَ : رَأَیْتُ أَبَا بَکْرِ بْنَ عَبْدِ الرَّحْمَنِ یُصَلِّی مُحْتَبِیًا۔","","Musannaf Ibn Abi Shaybah 4677","","","كتاب الصلوات"
"4678","(۴۶۷۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ دَاوُد ، عَنْ طَلْحَۃَ بْنَ یَحْیَی ، قَالَ : رَأَیْتُ عِیسَی بْنَ طَلْحَۃَ یُصَلِّی مُحْتَبِیًا۔","","Musannaf Ibn Abi Shaybah 4678","","","كتاب الصلوات"
"4679","(۴۶۷۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ؛ أَنَّہُ رَأَی عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یُصَلِّی مُحْتَبِیًا خَلْفَ الْمَقَامِ تَطَوُّعًا۔","","Musannaf Ibn Abi Shaybah 4679","","","كتاب الصلوات"
"4680","(۴۶۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ یُصَلِّی مُحْتَبِیًا ، فَإِذَا أَرَادَ أَنْ یَرْکَعَ حَلَّ حَبْوَتَہُ ، ثُمَّ قَامَ فَرَکَعَ۔","","Musannaf Ibn Abi Shaybah 4680","","","كتاب الصلوات"
"4681","(۴۶۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّہُ کَانَ یُصَلِّی مُحْتَبِیًا۔","","Musannaf Ibn Abi Shaybah 4681","","","كتاب الصلوات"
"4682","(۴۶۸۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ إسْمَاعِیلَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، قَالَ : رَأَیْتُ عُبَیْدَ بْنَ عُمَیْرٍ یُصَلِّی مُحْتَبِیًا۔","","Musannaf Ibn Abi Shaybah 4682","","","كتاب الصلوات"
"4683","(۴۶۸۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ بْنِ صُبَیْحٍ ، قَالَ : رَأَیْتُ عَطَائً یُصَلِّی مُحْتَبِیًا ، یَعْنِی التَّطَوُّعَ۔","","Musannaf Ibn Abi Shaybah 4683","","","كتاب الصلوات"
"4684","(۴۶۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَازِمٍ ، عَنْ سَہْلِ بْنِ سَعْدٍ السَّاعِدِیِّ ، قَالَ : لَقَدْ رَأَیْت الرِّجَالَ عَاقِدِی أُزُرَہُمْ فِی أَعْنَاقِہِمْ ، مِثْلَ الصِّبْیَانِ ، مِنْ ضِیقِ الأُزُرِ ، خَلْفَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ قائِلٌ : یَا مَعْشَرَ النِّسَائِ ، لاَ تَرْفَعَنْ رُؤُوسَکُنَّ حَتَّی یَرْفَعَ الرِّجَالُ۔ (بخاری ۳۶۲۔ ابوداؤد ۶۳۰)","Sahih","Musannaf Ibn Abi Shaybah 4684","","","كتاب الصلوات"
"4685","(۴۶۸۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ جَابِرٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : یَا مَعْشَرَ النِّسَائِ ، إذَا سَجَدَ الرِّجَالُ فَاغْضُضْنَ أَبْصَارَکُنَّ ، لاَ تَرَیْنَ عَوْرَاتِ الرِّجَالِ مِنْ ضِیقِ الأُزُرِ۔ (احمد ۳۸۷)","Da'if","Musannaf Ibn Abi Shaybah 4685","","","كتاب الصلوات"
"4686","(۴۶۸۶) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ : حدَّثَنَا زُہَیْرُ بْنُ مُحَمَّدٍ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی سَعِیدٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : یَا مَعْشَرَ النِّسَائِ ، إذَا سَجَدَ الرِّجَالُ فَاغْضُضْنَ أبْصَارَکُنَّ ، لاَ تَرَیْنَ عَوْرَاتِ الرِّجَالِ مِنْ ضِیقِ الأُزُرِ۔ (احمد ۳/۳۔ بیہقی ۱۶)","Da'if","Musannaf Ibn Abi Shaybah 4686","","","كتاب الصلوات"
"4687","(۴۶۸۷) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ مَنْصُورِ بْنِ حَیَّانَ ، قَالَ : أَخْبَرَنِی سُلَیْمَانُ بْنُ بشر الْخُزَاعِیُّ ، عَنْ خَالِہِ مَالِکِ بْنِ عَبْدِ اللہِ ، قَالَ : غَزَوْت مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَلَمْ أُصَلِّ خَلْفَ إمَامٍ کَانَ أَخَفَّ صَلاَۃً فِی الْمَکْتُوبَۃِ مِنْہُ۔ (احمد ۵/۲۲۵۔ طبرانی ۶۵۲)","Majhul","Musannaf Ibn Abi Shaybah 4687","","","كتاب الصلوات"
"4688","(۴۶۸۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ، عَنْ أَنَسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُوجِزُ الصَّلاَۃَ وَیُکْمِلُہَا۔ (بخاری ۷۰۶۔ مسلم ۳۴۲)","Sahih","Musannaf Ibn Abi Shaybah 4688","","","كتاب الصلوات"
"4689","(۴۶۸۹) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ سِمَاکٍ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : کَانَتْ صَلاَۃُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَصْدًا ، وَخُطْبَتُہُ قَصْدًا۔ (مسلم ۴۱۔ احمد ۵/۹۱)","Hasan","Musannaf Ibn Abi Shaybah 4689","","","كتاب الصلوات"
"4690","(۴۶۹۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَجَوَّزُوا الصَّلاَۃ ، فَإِنَّ فِیہِمُ الضَّعِیفَ وَالْکَبِیرَ وَذَا الْحَاجَۃِ۔ (بخاری ۷۰۳۔ ابوداؤد ۷۹۱)","Sahih","Musannaf Ibn Abi Shaybah 4690","","","كتاب الصلوات"
"4691","(۴۶۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عن قَیْسٍ ، عَنْ أَبِی مَسْعُودٍ ، قَالَ : جَائَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، إنِّی لأَتَأَخَّرُ عَنْ صَلاَۃِ الْغَدَاۃِ مِمَّا یُطِیلُ فُلاَنٌ فِیہَا ، قَالَ : فَقَامَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَمَا رَأَیْتُہُ فِی مَوْعِظَۃٍ أَشَدَّ مِنْہُ غَضَبًا یَوْمَئِذٍ ، فَقَالَ : أَیُّہَا النَّاسُ ، إنَّ فِیکُمْ مُنَفِّرِینَ ، فَأَیُّکُمْ صَلَّی بِالنَّاسِ فَلْیُجَوِّزْ ، فَإِنَّ فِیہِمُ الضَّعِیفَ وَالْکَبِیرَ وَذَا الْحَاجَۃِ۔ (بخاری ۹۰۔ ابن ماجہ ۹۸۴)","Sahih","Musannaf Ibn Abi Shaybah 4691","","","كتاب الصلوات"
"4692","(۴۶۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَارِبٍ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ؛ أَنَّ مُعَاذًا صَلَّی بِأَصْحَابِہِ فَقَرَأَ بِالْبَقَرَۃِ، فَقَالَ لَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَفَتَّانًا ؟ أَفَتَّانًا ؟ (بخاری ۷۰۵۔ احمد ۳/۲۹۹)","Sahih","Musannaf Ibn Abi Shaybah 4692","","","كتاب الصلوات"
"4693","(۴۶۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عَمْرِو بْنِ عُثْمَانَ بْنِ مَوہَبٍ ، عَنْ مُوسَی بْنِ طَلْحَۃَ ، عَنْ عُثْمَانَ بْنِ أَبِی الْعَاصِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لَہُ : أُمَّ قَوْمَک ، وَمَنْ أَمَّ قَوْمًا فَلْیُخَفِّفْ ، فَإِنَّ فِیہِمُ الضَّعِیفَ وَالْکَبِیرَ وَذَا الْحَاجَۃِ ، فَإِذَا صَلَّیْتَ لِنَفْسِکَ فَصَلِّ کَیْفَ شِئْت۔ (مسلم ۱۸۶۔ احمد ۴/۲۱۸)","Sahih","Musannaf Ibn Abi Shaybah 4693","","","كتاب الصلوات"
"4694","(۴۶۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَخَفَّ النَّاسِ صَلاَۃً فِی تَمَامٍ۔ (بخاری ۷۱۰۔ مسلم ۳۴۲)","Sahih","Musannaf Ibn Abi Shaybah 4694","","","كتاب الصلوات"
"4695","(۴۶۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ عَبَّاسٍ الْجُشَمِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ مِنَ الأَئِمَّۃِ طَرَّادِینَ۔ (دارقطنی ۸۵)","","Musannaf Ibn Abi Shaybah 4695","","","كتاب الصلوات"
"4696","(۴۶۹۶) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ بْنِ خُثیم ، عَنْ نَافِعِ بْنِ سَرْجِسَ ، أَبِی سَعِیدٍ ؛ أَنَّہُ سَمِعَ أَبَا وَاقِدٍ اللَّیْثِیَّ صَاحِبَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَذَکَرْتُ الصَّلاَۃ عِنْدَہُ ، فَقَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَخَفَّ النَّاسِ عَلَی النَّاسِ ، وَأَدْوَمَہُ عَلَی نَفْسِہِ۔ (ابویعلی ۱۴۴۴۔ طبرانی ۳۳۱۴)","Hasan","Musannaf Ibn Abi Shaybah 4696","","","كتاب الصلوات"
"4697","(۴۶۹۷) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ یَحْیَی بْنِ الْوَلِیدِ بْنِ الْمُسَیَّرِ الطَّائِیِّ ، قَالَ : أَخْبَرَنِی مُحِلٌّ الطَّائِیُّ ، عَنْ عَدِیِّ بْنِ حَاتِمٍ ، قَالَ : إنَّ مَنْ أَمَّنَا فَلْیُتِمَّ الرُّکُوعَ وَالسُّجُودَ ، فَإِنَّ فِینَا الضَّعِیفَ ،وَالْکَبِیرَ ، وَالْمَرِیضَ ، وَالْعَابِرَ سَبِیلٍ ، وَذَا الْحَاجَۃِ ، ہَکَذَا کُنَّا نُصَلِّی مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (طبرانی ۲۲۲)","Sahih","Musannaf Ibn Abi Shaybah 4697","","","كتاب الصلوات"
"4698","(۴۶۹۸) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ ثَابِتٍ ، قَالَ : صَلَّیْت مَعَ أَنَسٍ الْعَتَمَۃَ فَتَجَوَّزَ مَا شَائَ اللَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4698","","","كتاب الصلوات"
"4699","(۴۶۹۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ مُوسَی الْحَنَفِیِّ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، أَنَّہُ حَدَّثَ ، قَالَ : کَانَ أَبِی إذَا صَلَّی فِی الْمَسْجِدِ خَفَّفَ الرُّکُوعَ وَالسُّجُودَ وَجَوَّزَ ، وَإِذَا صَلَّی فِی بَیْتِہِ أَطَالَ الرُّکُوعَ وَالسُّجُودَ وَالصَّلاَۃ ، فَقُلْتُ لَہُ ، فَقَالَ : إِنَّا أَئِمَّۃٌ یُقْتَدَی بِنَا۔","Sahih","Musannaf Ibn Abi Shaybah 4699","","","كتاب الصلوات"
"4700","(۴۷۰۰) حَدَّثَنَا عَبْدَۃُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ أَبِی رَجَائٍ ، قَالَ : رَأَیْتُ الزُّبَیْرَ بْنَ الْعَوَّامِ صَلَّی صَلاَۃً خَفِیفَۃً ، فَقُلْتُ : أَنْتُمْ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَخَفُّ النَّاسِ صَلاَۃً ، قَالَ : إِنَا نُبَادِرُ ہَذَا الْوَسْوَاسَ۔","Sahih","Musannaf Ibn Abi Shaybah 4700","","","كتاب الصلوات"
"4701","(۴۷۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ قَیْسٍ ، عَنْ نُسَیر ، عَنْ خُلَیْد الثَّوْرِیِّ ، عَنْ عَمَّارٍ ، قَالَ : احْذِفُوا ہَذِہِ الصَّلاَۃ قَبْلَ وَسْوَسَۃِ الشَّیْطَانِ۔ (عبدالرزاق ۳۷۲۸)","Majhul","Musannaf Ibn Abi Shaybah 4701","","","كتاب الصلوات"
"4702","(۴۷۰۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، عَنْ حُذَیْفَۃَ ؛ أَنَّہُ عَلَّمَ رَجُلاً ، فَقَالَ : إنَّ الرَّجُلَ لَیُخَفِّفُ الصَّلاَۃ ، وَیُتِمُّ الرُّکُوعَ وَالسُّجُودَ۔","Sahih","Musannaf Ibn Abi Shaybah 4702","","","كتاب الصلوات"
"4703","(۴۷۰۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ یُصَلِّی خَلْفَ أَبِی ہُرَیْرَۃَ ، قَالَ : وَکَانَتْ صَلاَتُہُ نَحْوًا مِنْ صَلاَۃِ قَیْسٍ یُتِمُّ الرُّکُوعَ وَالسُّجُودَ وَیُجَوِّزُ ، قَالَ : فَقِیلَ لأَبِی ہُرَیْرَۃَ : ہَکَذَا کَانَتْ صَلاَۃُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : نَعَمْ ، وَأَجْوَزُ۔ (ابویعلی ۶۴۲۲۔ حمیدی ۹۸۷)","Majhul","Musannaf Ibn Abi Shaybah 4703","","","كتاب الصلوات"
"4704","(۴۷۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنَ أَبِی خَالِدٍ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ أَبَا ہُرَیْرَۃَ صَلَّی صَلاَۃً تَجَوَّزَ فِیہَا ، فَقُلْتُ لَہُ : ہَکَذَا کَانَتْ صَلاَۃُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : نَعَمْ ، وَأَجْوَزُ۔","Majhul","Musannaf Ibn Abi Shaybah 4704","","","كتاب الصلوات"
"4705","(۴۷۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : لَمَّا طُعِنَ عُمَرُ وَمَاجَ النَّاسُ، تَقَدَّمَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ فَقَرَأَ بِأَقْصَرَ سُورَتَیْنِ فِی الْقُرْآنِ : {إنَّا أَعْطَیْنَاک الْکَوْثَرَ} وَ {إذَا جَائَ نَصْرُ اللہِ وَالْفَتْحُ}۔","Sahih","Musannaf Ibn Abi Shaybah 4705","","","كتاب الصلوات"
"4706","(۴۷۰۶) حَدَّثَنَا عَبْدَۃُ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ؛ کَانَ یُخَفِّفُ الصَّلاَۃ ، وَیُتِمُّ الرُّکُوعَ وَالسُّجُودَ۔","","Musannaf Ibn Abi Shaybah 4706","","","كتاب الصلوات"
"4707","(۴۷۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : کَانُوا یُتِمُّونَ وَیُوجِزُونَ ، وَیُبَادِرُونَ الْوَسْوَسَۃَ۔","","Musannaf Ibn Abi Shaybah 4707","","","كتاب الصلوات"
"4708","(۴۷۰۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ أَخَفِّ النَّاسِ صَلاَۃً وَأَوْجَزَ۔","Sahih","Musannaf Ibn Abi Shaybah 4708","","","كتاب الصلوات"
"4709","(۴۷۰۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مِسْعَرٍ ، عَنْ مُہَاجِرٍ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : مَا رَأَیْت الصَّلاَۃ فِی مَوْضِعٍ أَخَفَّ مِنْہَا فِیمَا بَیْنَ ہَذَیْنِ الْحَائِطَیْنِ ، یَعْنِی مَسْجِدَ الْکُوفَۃِ الأَعْظَمَ۔","","Musannaf Ibn Abi Shaybah 4709","","","كتاب الصلوات"
"4710","(۴۷۱۰) حَدَّثَنَا وَکِیعٌ ، وَابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ النُّعْمَانِ بْنِ قَیْسٍ ، قَالَ : کُنَّ النِّسَائُ إذَا مَرَرْنَ عَلَی عبیدَۃَ وَہُوَ یُصَلِّی ، قُلْنَ : خَفِّفُوا ، فَإِنَّہَا صَلاَۃُ عبیدَۃَ ، یَعْنِی مِنْ خِفَّتِہَا۔","","Musannaf Ibn Abi Shaybah 4710","","","كتاب الصلوات"
"4711","(۴۷۱۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُمَیْدٌ ، عَنْ أَنَسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنِّی لأَکُونُ فِی الصَّلاَۃ فَأَسْمَعُ صَوْتَ الصَّبِیِّ یَبْکِی ، فَأَتَجَوَّزُ فِی صَلاَتِی مَخَافَۃَ أَنْ أَشُقَّ عَلَی أُمِّہِ۔ (ترمذی ۳۷۶۔ احمد ۲۵۷)","Sahih","Musannaf Ibn Abi Shaybah 4711","","","كتاب الصلوات"
"4712","(۴۷۱۲) حَدَّثَنَا عَلِیُّ بْنُ إِسْحَاقَ ، عَنِ ابْنِ المُبَارَکِ ، عَنِ الأَوْزَاعِیِّ ، قَالَ : حدَّثَنَا یَحْیَی بْنُ أَبِی کَثِیرٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی قَتَادَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: إنِّی لأَکُونُ فِی الصَّلاَۃ فَأُرِیدُ أَنْ أُطَوِّلَ فِیہَا، فَأَسْمَعُ بُکَائَ الصَّبِیِّ فَأَتَجَوَّزُ فِی الصَّلاَۃ ، کَرَاہِیَۃَ أَنْ أَشُقَّ عَلَی أُمِّہِ۔ (بخاری ۷۰۷۔ ابوداؤد ۷۸۵۔ احمد ۳۰۵)","Sahih","Musannaf Ibn Abi Shaybah 4712","","","كتاب الصلوات"
"4713","(۴۷۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الْحُوَیْرِثِ الزُّرَقِیِّ ، عَنْ عَلِیِّ بْنِ حسین ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إنِّی لأَسْمَعُ بُکَائَ الصَّبِیِّ خَلْفِی فَأُخَفِّفُ ، شَفَقَۃَ أَنْ أَفْتِنَ أُمَّہُ۔ (عبدالرزاق ۳۷۲۳)","Da'if","Musannaf Ibn Abi Shaybah 4713","","","كتاب الصلوات"
"4714","(۴۷۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی السَّوْدَائِ النَّہْدِیِّ ، عَنِ ابْنِ سَابِطٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَأَ فِی الرَّکْعَۃِ الأُولَی بِسُورَۃٍ نَحْوًا مِنْ سِتِّینَ آیَۃً ، فَسَمِعَ بُکَائَ صَبِیٍّ ، قَالَ : فَقَرَأَ فِی الثَّانِیَۃِ بِثَلاَثِ آیَاتٍ۔ (ابوداؤد ۳۹۔ عبدالرزاق ۳۷۲۴)","","Musannaf Ibn Abi Shaybah 4714","","","كتاب الصلوات"
"4715","(۴۷۱۵) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی ہَارُونَ ، عَنْ أَبِی سَعِیدٍ ، فِیمَا نَعْلَمُ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أَنِّی لأَکُونُ فِی الصَّلاَۃ ، فَأَسْمَعُ بُکَائَ الصَّبِیِّ ، فَأُخَفِّفُ مَخَافَۃَ أَنْ أَشُقَّ عَلَی أُمِّہِ ، أَوَ قَالَ : أَنْ تُفْتَنَ أُمُّہُ۔ (عبدالرزاق ۳۷۲۱)","Da'if","Musannaf Ibn Abi Shaybah 4715","","","كتاب الصلوات"
"4716","(۴۷۱۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَن[corrupt] سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی الرَّجُلِ یُدْرِکُ مَعَ الإِمَامِ وِتْرًا مِنْ صَلاَتِہِ ، قَالَ : یُصَلِّی مَا أَدْرَکَ ، وَلاَ یَسْجُدُ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4716","","","كتاب الصلوات"
"4717","(۴۷۱۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، قَالَ : سُئِلَ یُونُسُ عَنِ الرَّجُلِ یُدْرِکُ مِنْ صَلاَۃِ الْقَوْمِ رَکْعَۃً ، أَوْ تَفُوتُہُ رَکْعَۃٌ ؟ قَالَ : کَانَ الْحَسَنُ وَمُحَمَّدُ لاَ یَرَیَانِ عَلَیْہِ سُجُودًا۔","","Musannaf Ibn Abi Shaybah 4717","","","كتاب الصلوات"
"4718","(۴۷۱۸) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، عَنْ رَجُلٍ ، عَنْ عَطَائٍ ؛ أَنَّ ابْنَ عَبَّاسٍ ، وَابْنَ الزُّبَیْرِ وَأَبَا سَعِیدٍ ، وَابْنَ عُمَرَ ؛ کَانُوا إذَا فَاتَہُمْ وِتْرٌ مِنْ صَلاَۃِ الإِمَام ، سَجَدُوا سَجْدَتَیْنِ۔","Majhul","Musannaf Ibn Abi Shaybah 4718","","","كتاب الصلوات"
"4719","(۴۷۱۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ أَبِی سَعِیدٍ ، وَابْنِ عُمَرَ ، وَابْنِ الزُّبَیْرِ ؛ قَالُوا : إذَا فَاتَہُ بَعْضُ الصَّلاَۃ قَامَ فَقَضَی ، وَسَجَدَ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4719","","","كتاب الصلوات"
"4720","(۴۷۲۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : إذَا أَدْرَکَ الرَّجُلُ سَجْدَۃً مِنْ صَلاَۃِ الإِمَام سجَدَ إلَیْہَا أُخْرَی ، ثُمَّ سَجَدَ سَجْدَتَیْنِ بَعْدَ مَا یَفْرُغُ مِنْ صَلاَتِہِ ، وَإِذَا أَدْرَکَ سَجْدَتَیْنِ ، سَجَدَ بَعْدَ مَا یَفْرُغُ مِنْ صَلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 4720","","","كتاب الصلوات"
"4721","(۴۷۲۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنَ عُمَرَ ؛ مِثْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4721","","","كتاب الصلوات"
"4722","(۴۷۲۲) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوس ، وَمُجَاہِدٍ ؛ قَالُوا : إذَا فَاتَکَ وِتْرٌ مِنْ صَلاَۃِ الإِمَام ، فَاقْضِ مَا فَاتَکَ ، وَاسْجُدْ سَجْدَتَیْنِ وَأَنْتَ جَالِسٌ۔","","Musannaf Ibn Abi Shaybah 4722","","","كتاب الصلوات"
"4723","(۴۷۲۳) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَسْجُدُ مَعَہُمْ ، وَلاَ یَسْجُدُ إلَیْہَا أُخْرَی۔","","Musannaf Ibn Abi Shaybah 4723","","","كتاب الصلوات"
"4724","(۴۷۲۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ؛ أَنَّہُ فَاتَتْہُ رَکْعَۃٌ فَقَامَ فَتَطَوَّعَ ، ثُمَّ ذَکَرَ فَصَلَّی الرَّکْعَۃَ الَّتِی فَاتَتْہُ ، وَسَجَدَ سَجْدَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 4724","","","كتاب الصلوات"
"4725","(۴۷۲۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : یَقْطَعُ وَیُصَلِّی الرَّکْعَۃَ ، قَالَ : وَأَظُنُّہُ ، قَالَ : وَیَسْجُدُ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4725","","","كتاب الصلوات"
"4726","(۴۷۲۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ فِی رَجُلٍ فَاتَتْہُ مَعَ الإِمَامِ رَکْعَۃٌ ، فَلَمَّا سَلَّمَ الإِمَام ظَنَّ أَنَّہُ قَدْ أَدْرَکَ مَعَہُ أَوَّلَ الصَّلاَۃ فَقَامَ یَتَطَوَّعُ ، فَقَالَ الْحَسَنُ : إذَا أَدَخَلَ تَطَوُّعًا فِی فَرِیضَۃٍ فَسَدَتْ عَلَیْہِ صَلاَتُہُ۔","","Musannaf Ibn Abi Shaybah 4726","","","كتاب الصلوات"
"4727","(۴۷۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَرِہَ الصَّلاَۃ فِی الطَّاقِ۔","Da'if","Musannaf Ibn Abi Shaybah 4727","","","كتاب الصلوات"
"4728","(۴۷۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ قَیْسٍ ، قَالَ : رَأَیْتُ إبْرَاہِیمَ یَتَنَکَّبُ الطَّاقَ۔","","Musannaf Ibn Abi Shaybah 4728","","","كتاب الصلوات"
"4729","(۴۷۲۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ یَزِیدَ بْنِ أَبِی زِیاد ، عَنْ عُبَیْدِ بْنِ أَبِی الْجَعْدِ ، عَنْ کَعْبٍ ؛ أَنَّہُ کَرِہَ المذبح فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 4729","","","كتاب الصلوات"
"4730","(۴۷۳۰) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ سَعِیدِ بْنِ أَبْجَرَ، عَنْ نُعَیْمِ بْنِ أَبِی ہِنْدٍ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، قَالَ : لاَ تَتَّخِذُوا المذابح فِی الْمَسَاجِدِ۔","","Musannaf Ibn Abi Shaybah 4730","","","كتاب الصلوات"
"4731","(۴۷۳۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَکْرَہُ الصَّلاَۃ فِی الطَّاقِ۔","","Musannaf Ibn Abi Shaybah 4731","","","كتاب الصلوات"
"4732","(۴۷۳۲) حَدَّثَنَا ہُشَیْمٌ قَالَ : أَخْبَرَنَا یَحْیَی بْنُ بَدْرٍ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَکْرَہُ الصَّلاَۃَ فِی الطَّاقِ۔","","Musannaf Ibn Abi Shaybah 4732","","","كتاب الصلوات"
"4733","(۴۷۳۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عُبیدَۃُ ، عَنْ عُبید بْنِ أَبِی الْجَعْدِ ، قَالَ : کَانَ أَصْحَابُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُونَ : إِنْ مِنْ أَشْرَاطِ السَّاعَۃِ أَنْ تُتَّخَذَ المذابح فِی الْمَسَاجِدِ ، یَعْنِی الطَّاقَاتِ۔","","Musannaf Ibn Abi Shaybah 4733","","","كتاب الصلوات"
"4734","(۴۷۳۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : أَخْبَرَنَا أَبُو إسْرَائِیلَ ، عَنْ مُوسَی الْجُہَنِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَزَالُ ہَذِہِ الأُمَّۃُ ، أَوَ قَالَ : أُمَّتِی بِخَیْرٍ مَا لَمْ یَتَّخِذُوا فِی مَسَاجِدِہِمْ مَذَابِحَ کَمَذَابِحِ النَّصَارَی۔","","Musannaf Ibn Abi Shaybah 4734","","","كتاب الصلوات"
"4735","(۴۷۳۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ مُطَرِّفٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ : اتَّقُوا ہَذِہِ الْمَحَارِیبَ ، وَکَانَ إبْرَاہِیمُ لاَ یَقُومُ فِیہَا۔","","Musannaf Ibn Abi Shaybah 4735","","","كتاب الصلوات"
"4736","(۴۷۳۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ قَیْسٍ ، عَنْ أَبِی ذَرٍّ ، قَالَ : إِنَّ مِنْ أَشْرَاطِ السَّاعَۃِ أَنْ تُتَّخَذَ الْمَذَابِحُ فِی الْمَسَاجِدِ۔","Da'if","Musannaf Ibn Abi Shaybah 4736","","","كتاب الصلوات"
"4737","(۴۷۳۷) حَدَّثَنَا عَبْدُ الْحَمِیدِ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، قَالَ : رَأَیْتُ أَبَا خَالِدٍ الْوَالِبِیَّ لاَ یَقُومُ فِی الطَّاقِ ، وَیَقُومُ قِبَلَ الطَّاقِ۔","","Musannaf Ibn Abi Shaybah 4737","","","كتاب الصلوات"
"4738","(۴۷۳۸) حَدَّثَنَا حُمَیْدٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، قَالَ : رَأَیْتُُ مَسْجِدَ أَبِی ذَرٍّ فَلَمْ أَرَ فِیہِ طَاقًا۔","","Musannaf Ibn Abi Shaybah 4738","","","كتاب الصلوات"
"4739","(۴۷۳۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ، قَالَ : کَانَ یُصَلِّی بِنَا فِی الطَّاقِ۔","","Musannaf Ibn Abi Shaybah 4739","","","كتاب الصلوات"
"4740","(۴۷۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُوسَی بْنُ نَافِعٍ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ یُصَلِّی فِی الطَّاقِ۔","","Musannaf Ibn Abi Shaybah 4740","","","كتاب الصلوات"
"4741","(۴۷۴۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا نِفَاعَۃُ بْنُ مُسْلِمٍ ، قَالَ : رَأَیْتُ سُوَیْد بْنَ غَفَلَۃَ یُصَلِّی فِی الطَّاقِ۔","","Musannaf Ibn Abi Shaybah 4741","","","كتاب الصلوات"
"4742","(۴۷۴۲) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا ہُرَیْمٌ ، عَنْ أُمِّ عَمْرٍو الْمُرَادِیَّۃِ ، قَالَتْ : رَأَیْت الْبَرَائَ بْنَ عَازِبٍ یُصَلِّی فِی الطَّاقِ۔","Majhul","Musannaf Ibn Abi Shaybah 4742","","","كتاب الصلوات"
"4743","(۴۷۴۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ وِقَائَ بْنِ إیَاسٍ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ یُصَلِّی فِی الطَّاقِ۔","","Musannaf Ibn Abi Shaybah 4743","","","كتاب الصلوات"
"4744","(۴۷۴۴) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ قطن ، قَالَ : رَأَیْتُ أَبَا رَجَائٍ یُصَلِّی فِی الْمِحْرَابِ۔","","Musannaf Ibn Abi Shaybah 4744","","","كتاب الصلوات"
"4745","(۴۷۴۵) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا کُنْتَ فِی الصَّلاَۃ ، فَلاَ تَمْسَحْ جَبْہَتَکَ ، وَلاَ تَنْفُخْ ، وَلاَ تُحَرِّکِ الْحَصْبَائَ۔","Da'if","Musannaf Ibn Abi Shaybah 4745","","","كتاب الصلوات"
"4746","(۴۷۴۶) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ حُصَیْنٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : ہُوَ مِنَ الْجَفَائِ۔","","Musannaf Ibn Abi Shaybah 4746","","","كتاب الصلوات"
"4747","(۴۷۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ کَہْمَسِ بْنِ الْحَسَنِ ، عَنِ ابْنِ بُرَیْدَۃَ ، قَالَ : کَانَ یُقَالُ، أَرْبَعٌ مِنَ الْجَفَائِ : أَنْ یَمْسَحَ جَبْہَتَہ قَبْلَ أَنْ یَنْصَرِفَ ، أَوْ یَبُولَ قَائِمًا ، أَوْ یَسْمَعَ الْمُنَادِیَ ، ثُمَّ لاَ یُجِیبَہُ ، أَوْ یَنْفُخَ فِی سُجُودِہ۔","","Musannaf Ibn Abi Shaybah 4747","","","كتاب الصلوات"
"4748","(۴۷۴۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَمْسَحَ الرَّجُلُ جَبْہَتَہُ فِی الصَّلاَۃ ، وَیَقُولُ : ہُوَ مِنَ الْجَفَائِ۔","","Musannaf Ibn Abi Shaybah 4748","","","كتاب الصلوات"
"4749","(۴۷۴۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَمْسَحَ جَبْہَتَہُ قَبْلَ أَنْ یَنْصَرِفَ۔","","Musannaf Ibn Abi Shaybah 4749","","","كتاب الصلوات"
"4750","(۴۷۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ حُرَیْثٍ ، عَنِ الشَّعْبِیِّ ؛ فِی الرَّجُلِ یَمْسَحُ جَبْہَتَہُ قَبْلَ أَنْ یَنْصَرِفَ ، قَالَ : ہُوَ جَفَاء ، وَقَالَ الْحَکَمُ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 4750","","","كتاب الصلوات"
"4751","(۴۷۵۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَاصِمِ بْنِ أَبِی النَّجُودِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، قَالَ : قَالَ عَبْدُ اللہِ : أَرْبَعٌ مِنَ الْجَفَائِ : أَنْ یُصَلِّیَ الرَّجُلُ إلَی غَیْرِ سُتْرَۃٍ ، وَأَنْ یَمْسَحَ جَبْہَتَہُ قَبْلَ أَنْ یَنْصَرِفَ ، أَوْ یَبُولَ قَائِمًا ، أَوْ یَسْمَعَ الْمُنَادِیَ ، ثُمَّ لاَ یُجِیبَہُ۔","","Musannaf Ibn Abi Shaybah 4751","","","كتاب الصلوات"
"4752","(۴۷۵۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ بَأْسَ بِہِ ، یَعْنِی یَمْسَح جَبْہَتَہُ قَبْلَ أَنْ یَنْصَرِفَ۔","","Musannaf Ibn Abi Shaybah 4752","","","كتاب الصلوات"
"4753","(۴۷۵۳) حَدَّثَنَا یَزِیدُ بْنُ أَبِی الْخنْدِقِ ، عَنْ مَالِکِ بْنِ دِینَارٍ ، قَالَ : سَأَلْتُ سَالِمًا عَنِ الرَّجُلِ یَمْسَحُ جَبْہَتَہُ ؟ فَلَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 4753","","","كتاب الصلوات"
"4754","(۴۷۵۴) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 4754","","","كتاب الصلوات"
"4755","(۴۷۵۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 4755","","","كتاب الصلوات"
"4756","(۴۷۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : رَأَیْتُہ قَالَ بِثَوْبِہِ ہَکَذَا ، فَمَسَحَ بِہِ جَبْہَتَہُ ، وَأَمَرَّ وَکِیعٌ یَدَہُ عَلَی جَبْہَتِہِ۔","","Musannaf Ibn Abi Shaybah 4756","","","كتاب الصلوات"
"4757","(۴۷۵۷) حَدَّثَنَا بِشْرُ بْنُ الْمُفَضَّلِ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَنِ ابْنِ سِیرِینَ ؛ بِنَحْوِ حَدِیثِ وَکِیعٍ ، أَوْ مِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 4757","","","كتاب الصلوات"
"4758","(۴۷۵۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ (ح) وَمُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَنَامُ خَلْفَ الإِمَامِ حَتَّی یَرْکَعَ الإِمَامُ وَیَسْجُدَ ، ثُمَّ یَنْتَبِہَ النَّائِمُ ، قَالاَ : یَتْبَعُ الإِمَامَ فَیصلی مَا سَبَقَہُ بِہِ۔","","Musannaf Ibn Abi Shaybah 4758","","","كتاب الصلوات"
"4759","(۴۷۵۹) حَدَّثَنَا شَرِیکٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَنْسَی الصَّلَوَاتِ ، قَالَ : یَبْدَأُ بِالأُولَی فَالأُولَی۔","","Musannaf Ibn Abi Shaybah 4759","","","كتاب الصلوات"
"4760","(۴۷۶۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا نَسِیَ الصَّلَوَاتِ فَلْیَبْدَأْ بِالأَولِ فَالأَولِ ، فَإِنْ خَافَ الْفَوْتَ یَبْدَأُ بِالَّتِی یَخَافُ فَوْتَہَا۔","","Musannaf Ibn Abi Shaybah 4760","","","كتاب الصلوات"
"4761","(۴۷۶۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی رَاشِدٍ ، قَالَ : نِمْتُ عَنِ الظُّہْرِ ، وَالْعَصْرِ ، وَالْمَغْرِبِ ، وَالْعِشَائِ ، فَأَتَیْتُ عُبَیْدَ بْنَ عُمَیْرٍ فَذَکَرْتُ ذَلِکَ لَہُ ، فَقَالَ : ابْدَأْ بِالظُّہْرِ وَالْعَصْرِ ، وَالْمَغْرِبِ وَالْعِشَائِ۔","","Musannaf Ibn Abi Shaybah 4761","","","كتاب الصلوات"
"4762","(۴۷۶۲) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ مَعْمَرٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی رَجُلٍ نَسِیَ صَلاَۃً فَذَکَرَہَا عِنْدَ غُرُوبِ الشَّمْسِ ، وَلَمْ یَکُنْ صَلَّی تِلْکَ الصَّلاَۃ ، قَالَ : إِنْ خَشِیَ أَنْ یُصَلِّیَ ہَذِہِ الَّتِی کَانَ نَسِیَ فَیَذْہَبَ وَقْتُ تِلْکَ ، فَلْیَبْدَأْ بِالَّتِی یَخَافُ فَوْتَہَا۔","","Musannaf Ibn Abi Shaybah 4762","","","كتاب الصلوات"
"4763","(۴۷۶۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یَقْضِی الأَولَ فَالأَولَ۔","","Musannaf Ibn Abi Shaybah 4763","","","كتاب الصلوات"
"4764","(۴۷۶۴) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ حَمَّادِ بْنِ فَرْوَۃَ ، قَالَ : أَہْرَقْتُ الْمَائُ فَنَسِیتُ أَنْ أَتَوَضَّأَ ، فَصَلَّیْتُ الظُّہْرَ وَالْعَصْرَ وَالْمَغْرِبَ ، فَذَکَرْت أَنِّی صَلَّیْتہَا عَلَی غَیْرِ طُہْرٍ ، فَلَمَّا أَصْبَحْتُ سَأَلْتُ عَطَائً وَمُجَاہِدًا ، قَالَ جَعْفَرُ : وَأَحْسِبُہُ ، قَالَ : وَسَعِیدَ بْنَ جُبَیْرٍ ، فَکُلُّہُمْ قَال لَہُ : تَوَضَّأْ وَأَعِدْ صَلاَتَکَ الآنَ، تَبْدَأُ بِالأَولِ فَالأَولِ۔","","Musannaf Ibn Abi Shaybah 4764","","","كتاب الصلوات"
"4765","(۴۷۶۵) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ مَوْلًی لأَبِی بَکْرَۃَ ، قَالَ : دَخَلَ أَبُو بَکْرَۃَ بُسْتَانًا ، فَطَافَ فِیہِ وَنَظَرَ إلَیْہِ وَنَسِیَ صَلاَۃَ الْعَصْرِ حَتَّی مَالَتِ الشَّمْسُ ، فَلَمَّا ذَکَرَہَا تَوَضَّأَ وَجَلَسَ ، فَلَمَّا وَجَبَتْ قَامَ فَصَلَّی الْعَصْرَ ، ثُمَّ صَلَّی الْمَغْرِبَ۔","Majhul","Musannaf Ibn Abi Shaybah 4765","","","كتاب الصلوات"
"4766","(۴۷۶۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنْ وَاصِلٍ مَوْلَی أَبِی عُیَیْنَۃَ ، عَنْ رَجُلٍ یُقَالُ لَہُ : سَعْدٌ ، قَالَ : صَلَّیْت فِی رَمَضَانَ مَعَ النَّاسِ ، ثُمَّ أَتَیْتُ بَیْتًا لأَہْلِی فَدَخَلْت فِیہِ فَنِمْت لَیْلَتِی وَیَوْمِی وَلَیْلَتِی حَتَّی الْغَدِ ، فَأَتَیْت ابْنَ عُمَرَ فَأَخْبَرْتُہُ ؟ قَالَ : فَصَنَعْتَ مَاذَا ؟ قَالَ : صَلَّیْت الظُّہْرَ ، قَالَ : أَحْسَنْت ، قَالَ : ثم مَاذَا ؟ قَالَ : صَلَّیْتُ الْعَصْرَ ، قَالَ : أَحْسَنْت ، قَالَ ، ثُمَّ مَاذَا ؟ قَالَ : صَلَّیْت الْمَغْرِبَ ، قَالَ أَحْسَنْت قَالَ : ثُمَّ مَاذَا ؟ قَالَ : صَلَّیْت الْعِشَائَ ، قَالَ : أَحْسَنْت ، قَالَ ، ثُمَّ مَاذَا ؟ قَالَ : أَوْتَرْت ، قَالَ : مَا کُنْت تَصْنَعُ بِالْوِتْرِ ؟ قَالَ : ثُمَّ مَاذَا ؟ قَالَ : صَلَّیْت الصُّبْحَ ، قَالَ : أَحْسَنْت۔","Majhul","Musannaf Ibn Abi Shaybah 4766","","","كتاب الصلوات"
"4767","(۴۷۶۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، وَمَنْصُورٌ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَقُولُ : مَنْ نَامَ عَنْ صَلاَۃِ الْعِشَائِ فَاسْتَیْقَظَ عِنْدَ طُلُوعِ الشَّمْسِ ، قَالَ : یُصَلِّی الْفَجْرَ ، ثُمَّ یُصَلِّی الْعِشَائَ۔","","Musannaf Ibn Abi Shaybah 4767","","","كتاب الصلوات"
"4768","(۴۷۶۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَقُولُ : یَبْدَأُ بِالْعِشَائِ الَّتِی نَامَ عَنْہَا۔","","Musannaf Ibn Abi Shaybah 4768","","","كتاب الصلوات"
"4769","(۴۷۶۹) حَدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَنْسَی الْعَتَمَۃَ ، أَوْ یَرْقُدُ عَنْہَا حَتَّی یَکُونَ الصُّبْحُ ، فَقِیلَ لَہُ : فَإِنْ بَدَأَ بِالْعَتَمَۃِ فَاتَتْہُ الصُّبْحُ ؟ قَالَ : فَلْیَبْدَأْ بِالْعَتَمَۃِ وَإِنْ فَاتَتْہُ الصُّبْحُ۔","","Musannaf Ibn Abi Shaybah 4769","","","كتاب الصلوات"
"4770","(۴۷۷۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ ، قَالَ : حدَّثَنَا قَتَادَۃُ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ نَسِیَ صَلاَۃً ، أَوْ نَامَ عَنْہَا فَکَفَّارَتُہُ أَنْ یُصَلِّیَہَا إذَا ذَکَرَہَا۔ (بخاری ۵۹۷۔ مسلم ۳۱۴)","Hasan","Musannaf Ibn Abi Shaybah 4770","","","كتاب الصلوات"
"4771","(۴۷۷۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ جَامِعِ بْنِ شَدَّادٍ ، قَالَ : سَمِعْتُ عَبْدَ الرَّحْمَن بْنَ أَبِی عَلْقَمَۃَ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ مَسْعُودٍ ، قَالَ : أَقْبَلْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنَ الْحُدَیْبِیَۃِ ، فَذَکَرُوا أَنَّہُمْ نَزَلُوا دَہَاسًا مِنَ الأَرْضِ ، یَعْنِی بِالدَّہَاسِ : الرَّمْلَ ، قَالَ : فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ یَکْلَؤُنَا ؟ فَقَالَ بِلاَلٌ : أَنَا ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذًا نَنَامُ ، قَالَ : فَنَامُوا حَتَّی طَلَعَتْ عَلَیْہِمُ الشَّمْسُ ، قَالَ : فَاسْتَیْقَظَ نَاسٌ فِیہِمْ فُلاَنٌ وَفُلاَنٌ وَفِیہِمْ عُمَرُ ، فَقُلْنَا : اہْضِبُوا ، یَعْنِی تَکَلَّمُوا ، قَالَ : فَاسْتَیْقَظَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : افْعَلُوا کَمَا کُنْتُمْ تَفْعَلُونَ ، قَالَ : فَفَعَلْنَا ، قَالَ : کَذَلِکَ لِمَنْ نَامَ ، أَوْ نَسِیَ۔ (ابوداؤد ۴۴۸۔ احمد ۱/۳۸۶)","Hasan","Musannaf Ibn Abi Shaybah 4771","","","كتاب الصلوات"
"4772","(۴۷۷۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أبی إسْمَاعِیلَ ، عَنْ أَبِی حَازِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : عَرَّسْنَا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَاتَ لَیْلَۃٍ ، فَلَمْ نَسْتَیْقِظْ حَتَّی آذَتْنَا الشَّمْسُ ، فَقَالَ لَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لِیَأْخُذْ کُلُّ رَجُلٍ مِنْکُمْ بِرَأْسِ رَاحِلَتِہِ ، ثُمَّ لْیَتَنَحَّ عَنْ ہَذَا الْمَنْزِلِ ، ثُمَّ دَعَا بِمَائٍ فَتَوَضَّأَ فَسَجَدَ سَجْدَتَیْنِ ، ثُمَّ أُقِیمَتِ الصَّلاَۃ فَصَلَّی۔ (مسلم ۳۱۰۔ احمد ۲/۴۲۹)","Sahih","Musannaf Ibn Abi Shaybah 4772","","","كتاب الصلوات"
"4773","(۴۷۷۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ عَبْدِ الْجَبَّارِ بن عَبَّاسٍ ، عَنْ عَوْنِ بْنِ أَبِی جُحَیْفَۃَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرِہِ الَّذِی نَامُوا فِیہِ حَتَّی طَلَعَتِ الشَّمْسُ ، ثُمَّ قَالَ : إنَّکُمْ کُنْتُمْ أَمْوَاتًا فَرَدَّ اللَّہُ إلَیْکُمْ أَرْوَاحَکُمْ ، فَمَنْ نَامَ عَنْ صَلاَۃٍ ، أَوْ نَسِیَ صَلاَۃً فَلْیُصَلِّہَا إذَا ذَکَرَہَا ، وَإِذَا اسْتَیْقَظَ۔ (ابو یعلی ۸۹۵۔ طبرانی ۲۶۸)","Hasan","Musannaf Ibn Abi Shaybah 4773","","","كتاب الصلوات"
"4774","(۴۷۷۴) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا نَامَ الرَّجُلُ عَنْ صَلاَۃٍ ، أَوْ نَسِیَ فَلْیُصَلِّ إذَا اسْتَیْقَظَ ، أَوْ ذَکَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 4774","","","كتاب الصلوات"
"4775","(۴۷۷۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّ عِمْرَانَ بْنَ حُصَیْنٍ وَسَمُرَۃَ بْنَ جُنْدُبٍ اخْتَلَفَا فِی الَّذِی یَنْسَی صَلاَتَہُ ، فَقَالَ عِمْرَانُ : یُصَلِّیہَا إذَا ذَکَرہَا ، وَقَالَ سَمُرَۃُ : یُصَلِّیہَا إذَا ذَکَرَ وَفِی وَقْتِہَا مِنَ الْغَدِ۔","Sahih","Musannaf Ibn Abi Shaybah 4775","","","كتاب الصلوات"
"4776","(۴۷۷۶) حَدَّثَنَا وَکِیعٌ، عَنْ عَلِیِّ بْنِ صَالِحٍ، عَنْ سِمَاکٍ، عَنْ سَبْرَۃَ بْنِ نَخَفٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: یُصَلِّی إذَا ذَکَرَ۔","Majhul","Musannaf Ibn Abi Shaybah 4776","","","كتاب الصلوات"
"4777","(۴۷۷۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی بَکْرِ بْنِ أَبِی مُوسَی ، عَنْ سَعْدٍ ، قَالَ : قَالَ: یُصَلِّیہَا إذَا ذَکَرَہَا ، وَیُصَلِّی مِثْلَہَا مِنَ الْغَدِ۔","Da'if","Musannaf Ibn Abi Shaybah 4777","","","كتاب الصلوات"
"4778","(۴۷۷۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَنْ نَامَ عَنْ صَلاَۃٍ ، أَوْ نَسِیَہَا ، قَالَ : یُصَلِّی مَتَی ذَکَرَہَا عِنْدَ طُلُوعِ الشَّمْسِ ، أَوَعِنْدَ غُرُوبِہَا ، ثُمَّ قَرَأَ : (أَقِمِ الصَّلاَۃ لِذِکْرِی) قَالَ : إذَا ذَکَرْتَہَا فَصَلِّہَا فِی أَیِّ سَاعَۃٍ کُنْتَ۔","","Musannaf Ibn Abi Shaybah 4778","","","كتاب الصلوات"
"4779","(۴۷۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی حُمَیْدٍ ) ، عَنْ أَبِی مَلِیحٍ ، عَنْ أَبِی ذَرٍّ ، وَعَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ؛ فِی الصَّلاَۃ تُنْسَی ؟ قَالاَ : یُصَلِّیہَا إذَا ذَکَرَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 4779","","","كتاب الصلوات"
"4780","(۴۷۸۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مُوسَی بْنِ قَیْسٍ ، عَنْ زَکَرِیَّا بْنِ جَرَادٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : مَا کَانَ لَکَ أَحَدٌ یُہبَّکَ ؟ صَلِّہَا لِذِّکْرِی۔","","Musannaf Ibn Abi Shaybah 4780","","","كتاب الصلوات"
"4781","(۴۷۸۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، وَإِبْرَاہِیمَ ، قَالاَ : {أَقِمِ الصَّلاَۃ لِذِکْرِی} أَیْ : صَلِّہَا إذَا ذَکَرْتَہَا وَقَدْ نَسِیتَہَا۔","","Musannaf Ibn Abi Shaybah 4781","","","كتاب الصلوات"
"4782","(۴۷۸۲) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ صَخْرِ بْنِ جُوَیْرِیَۃَ ، قَالَ : سَأَلْتُ نَافِعًا عَنْ رَجُلٍ نَسِیَ صَلاَۃَ الْعَصْرِ حَتَّی اصْفَارَّت الشَّمْسُ ؟ قَالَ : یُصَلِّیہَا لَیْسَتْ کَشَیْئٍ مِنَ الصَّلَوَاتِ۔","","Musannaf Ibn Abi Shaybah 4782","","","كتاب الصلوات"
"4783","(۴۷۸۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، قَالَ : یُصَلِّیہَا إذَا ذَکَرَہَا۔","","Musannaf Ibn Abi Shaybah 4783","","","كتاب الصلوات"
"4784","(۴۷۸۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَنَامُ عَنْ صَلاَۃِ الْعِشَائِ حَتَّی تَبْزُغَ الشَّمْسُ ، قَالَ : یُصَلِّی۔","","Musannaf Ibn Abi Shaybah 4784","","","كتاب الصلوات"
"4785","(۴۷۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَامَ عَنْ صَلاَۃِ الْفَجْرِ حَتَّی طَلَعَتِ الشَّمْسُ ، فَقَالَ لأَصْحَابِہِ : تَزَحْزَحُوا عَنِ الْمَکَانِ الَّذِی أَصَابَتْکُمْ فِیہِ الْغَفْلَۃُ ، فَصَلَّی ثُمَّ قَالَ : {أَقِمِ الصَّلاَۃ لِذِکْرِی}۔","","Musannaf Ibn Abi Shaybah 4785","","","كتاب الصلوات"
"4786","(۴۷۸۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، عَنْ بَعْضِ بَنِی أَبِی بَکْرَۃَ ؛ أَنَّ أَبَا بَکْرَۃَ نَامَ فِی دَالِیَۃٍ لَہُمْ وَظَنَنَّا أَنَّہُ قَدْ صَلَّی الْعَصْرَ ، فَاسْتَیْقَظَ عِنْدَ غُرُوبِ الشَّمْسِ ، قَالَ : فَانْتَظَرَ حَتَّی غَابَتِ الشَّمْسُ ، ثُمَّ صَلَّی۔","Majhul","Musannaf Ibn Abi Shaybah 4786","","","كتاب الصلوات"
"4787","(۴۷۸۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ سَعْدِ بن إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ الْمَلِکِ بْنِ کَعْبٍ ، عَنْ أَبِیہِ ، قَالَ : نِمْتُ عَنِ الْفَجْرِ حَتَّی طَلَعَ قَرْنُ الشَّمْسِ ، وَنَحْنُ خَارِفُونَ فِی مَالٍ لَنَا ، فَمِلْتُ إلَی شَرْبَۃٍ مِنَ النَّخْلِ أَتَوَضَّأُ ، قَالَ : فَبَصُرَ بِی أَبِی فَقَالَ : مَا شَأْنُک ؟ قُلْتُ : أُصَلِّی قَدْ تَوَضَّأْت ، فَدَعَانِی فَأَجْلَسَنِی إلَی جَنْبِہِ ، فَلَمَّا أَنْ تَعَلَّتِ الشَّمْسُ وَابْیَضَّتْ وَأَتَیْتُ الْمَسْجِدَ ، ضَرَبَنِی قَبْلَ أَنْ أَقُومَ إلَی الصَّلاَۃ ، وَقَالَ : تَنْسَی ؟ صَلِّ الأَنَ۔","Majhul","Musannaf Ibn Abi Shaybah 4787","","","كتاب الصلوات"
"4788","(۴۷۸۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ؛ فِی الرَّجُلِ إذَا نَسِیَ أَنْ یُصَلِّیَ صَلاَۃً حَتَّی تَصْفَرَّ الشَّمْسُ ، قَالَ: یُصَلِّیہَا إذَا غَابَتِ الشَّمْسُ ، وَقَالَ قَتَادَۃُ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 4788","","","كتاب الصلوات"
"4789","(۴۷۸۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ : حَدَّثَنَا عَبْدُ اللہِ بْنُ أَبِی قَتَادَۃَ ، عَنْ أَبِیہِ أَبِی قَتَادَۃَ ، قَالَ : سِرْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ ذَاتَ لَیْلَۃٍ ، قَالَ : قُلْنَا : یَا رَسُولَ اللہِ ، لَوْ عَرَّسْت بِنَا ، فَقَالَ : إنِّی أَخَافُ أَنْ تَنَامُوا عَنِ الصَّلاَۃ ، فَمَنْ یُوقِظُنَا لِلصَّلاَۃِ ؟ قَالَ : فَقَالَ بِلاَلٌ : أَنَا ، یَا رَسُولَ اللہِ ، قَالَ : فَعَرَّسَ بِالْقَوْمِ وَاضْطَجَعُوا ، وَاسْتَنَدَ بِلاَلٌ إلَی رَاحِلَتِہِ فَغَلَبَتْہُ عَیْنَاہُ ، وَاسْتَیْقَظَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَقَدْ طَلَعَ حَاجِبُ الشَّمْسِ ، فَقَالَ : یَا بِلاَلُ ، أَیْنَ مَا قُلْتَ لَنَا ؟ فَقَالَ : یَا رَسُولَ اللہِ ، وَالَّذِی بَعَثَک بِالْحَقِّ مَا أُلْقِیَتْ عَلَیَّ نَوْمَۃٌ مِثْلہَا ، قَالَ : فَقَالَ : إنَّ اللَّہَ قَبَضَ أَرْوَاحَکُمْ حِینَ شَائَ ، وَرَدَّہَا عَلَیْکُمْ حِینَ شَائَ ، قَالَ : ثُمَّ أَمَرَہُمْ فَانْتَشَرُوا لِحَاجَتِہِمْ ، وَتَوَضَّؤُوا وَارْتَفَعَتِ الشَّمْسُ ، فَصَلَّی بِہِمُ الْفَجْرَ۔ (بخاری ۵۹۵۔ ابوداؤد ۴۴۱)","Sahih","Musannaf Ibn Abi Shaybah 4789","","","كتاب الصلوات"
"4790","(۴۷۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ الْمُبَارَکِ ، عَنْ یَحْیَی ، عَنْ أَبِی سَلَمَۃَ ، عَنْ جَابِرٍ ، قَالَ : جَائَ عُمَرُ یَوْمَ الْخَنْدَقِ فَجَعَلَ یَسُبُّ کُفَّارَ قُرَیْشٍ وَیَقُولُ : یَا رَسُولَ اللہِ ، مَا صَلَّیْتُ الْعَصْرَ حَتَّی کَادَتِ الشَّمْسُ أَنْ تَغِیبَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : وَأَنَا وَاللَّہِ مَا صَلَّیْتُ بَعْدُ ، فَنَزَلَ فَتَوَضَّأَ ثُمَّ صَلَّی الْعَصْرَ بَعْدَ مَا غَرَبَتِ الشَّمْسُ ، ثُمَّ صَلَّی الْمَغْرِبَ بَعْدَ مَا صَلَّی الْعَصْرَ۔ (بخاری ۹۴۵۔ مسلم ۴۳۸)","Hasan","Musannaf Ibn Abi Shaybah 4790","","","كتاب الصلوات"
"4791","(۴۷۹۱) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عَوْفٍ ، عَنْ أَبِی رَجَائٍ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ، قَالَ : کُنَّا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ ، وَإِنَّا سَرَیْنَا اللَّیْلَۃَ حَتَّی إذَا کَانَ آخِرُ اللَّیْلِ وَقَعْنَا تِلْکَ الْوَقْعَۃَ ، وَلاَ وَقْعَۃَ عِنْدَ الْمُسَافِرِ أَحْلَی مِنْہَا ، فَمَا أَیْقَظَنَا إِلاَّ حَرُّ الشَّمْسِ ، فَجَعَلَ عُمَرُ یُکَبِّرُ ، فَلَمَّا اسْتَیْقَظَ شَکَا النَّاسُ إلَیْہِ مَا أَصَابَہُمْ ، فَقَالَ : لاَ ضَیْرَ ، قَالَ : فَارْتَحَلُوا فَسَارُوا غَیْرَ بَعِیدٍ ، ثُمَّ نَزَلَ فَنُودِیَ بِالصَّلاَۃ ، فَصَلَّی بِالنَّاسِ۔ (بخاری ۳۴۴۔ مسلم ۴۷۶)","Sahih","Musannaf Ibn Abi Shaybah 4791","","","كتاب الصلوات"
"4792","(۴۷۹۲) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ (ح) وَعَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالاَ: إذَا کُنْتَ فِی صَلاَۃِ الْعَصْرِ، فَذَکَرْت أَنَّک لَمْ تُصَلِّ الظُّہْرَ ، فَانْصَرِفْ فَصَلِّ الظُّہْرَ ، ثُمَّ صَلِّ الْعَصْرَ۔","","Musannaf Ibn Abi Shaybah 4792","","","كتاب الصلوات"
"4793","(۴۷۹۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ فِی رَجُلٍ نَسِیَ الظُّہْرَ ، ثُمَّ ذَکَرَہَا وَہُوَ فِی الْعَصْرِ ، قَالَ : یَنْصَرِفُ فَیُصَلِّی الظُّہْرَ ، ثُمَّ یُصَلِّی الْعَصْرَ۔","","Musannaf Ibn Abi Shaybah 4793","","","كتاب الصلوات"
"4794","(۴۷۹۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ فِی حَدِیثِہِ : وَإِنْ ذَکَرَہَا بَعْدَ مَا صَلَّی الْعَصْرَ فَقَدْ مَضَتْ ، وَیُصَلِّی الظُّہْرَ۔","","Musannaf Ibn Abi Shaybah 4794","","","كتاب الصلوات"
"4795","(۴۷۹۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إِنْ ذَکَرَ وَہُوَ فِی الصَّلاَۃ ، انْصَرَفَ فَصَلَّی الظُّہْرَ، ثُمَّ صَلَّی الْعَصْرَ۔","","Musannaf Ibn Abi Shaybah 4795","","","كتاب الصلوات"
"4796","(۴۷۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنْ رَجُلٍ ذَکَرَ صَلاَۃً وَہُوَ فِی صَلاَۃٍ ؟ قَالاَ : إِنْ ذَکَرَہَا قَبْلَ أَنْ یَتَشَہَّدَ ، أَوْ یَجْلِسَ مِقْدَارَ التَّشَہُّدِ تَرَکَ ہَذِہِ وَعَادَ إلَی تِلْکَ ، وَإِنْ ذَکَرَہَا بَعْدَ ذَلِکَ اعْتَدَّ بِہَذِہِ ، وَعَادَ إلَی تِلْکَ۔","","Musannaf Ibn Abi Shaybah 4796","","","كتاب الصلوات"
"4797","(۴۷۹۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنِ الْحَسَنِ ، قَالَ : یُصَلِّی الْعَصْرَ ، فَإِذَا فَرَغَ صَلَّی الظُّہْرَ۔","","Musannaf Ibn Abi Shaybah 4797","","","كتاب الصلوات"
"4798","(۴۷۹۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : إذَا ذَکَرَ وَہُوَ فِی الْعَصْرِ أَنَّہُ لَمْ یُصَلِّ الظُّہْرَ ، فَإِنَّہُ یُصَلِّی الْعَصْرَ ، ثُمَّ یُصَلِّی الظُّہْرَ بَعْدُ۔","","Musannaf Ibn Abi Shaybah 4798","","","كتاب الصلوات"
"4799","(۴۷۹۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَقُولُ : إذَا ذَکَرْتَ وَأَنْتَ تُصَلِّی الْعَصْرَ أَنَّک لَمْ تُصَلِّ الظُّہْرَ ، مَضَیْت فِیہَا ، ثُمَّ صَلَّیْت الظُّہْرَ ، فَإِذَا صَلَّیْتَ الْعَصْرَ وَذَکَرْت أَنَّک لَمْ تُصَلِّ الظُّہْرَ فَصَلَّیْت أَجْزَأَتْک۔","Sahih","Musannaf Ibn Abi Shaybah 4799","","","كتاب الصلوات"
"4800","(۴۸۰۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ بْنِ عَبْدِ الْمَلِکِ ، عَنِ الْحَسَنِ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 4800","","","كتاب الصلوات"
"4801","(۴۸۰۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی رَجُلٍ صَلَّی بِقَوْمٍ الظُّہْرَ وَہِیَ لَہُ الْعَصْرُ ، قَالَ : تَمَّتْ صَلاَتُہُ ، وَیُعِیدُ مَنْ خَلْفَہُ۔","","Musannaf Ibn Abi Shaybah 4801","","","كتاب الصلوات"
"4802","(۴۸۰۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : لاَ تُجْزِئُ صَلاَۃٌ وَاحِدَۃٌ عَنْ قَوْمَیْنِ شَتَّی۔","","Musannaf Ibn Abi Shaybah 4802","","","كتاب الصلوات"
"4803","(۴۸۰۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ، قَالَ : انْتَہَیْت إلَی الْمَسْجِدِ الْجَامِعِ وَأَنَا أَرَی أَنَّہُمْ لَمْ یُصَلُّوا الظُّہْرَ ، فَقُمْتُ أَتَطَوَّعُ حَتَّی أُقِیمَتِ الصَّلاَۃ ، فَلَمَّا صَلَّوْا إذَا ہِیَ الْعَصْرُ ، فَقُمْت فَصَلَّیْت بِہِمُ الظُّہْرَ ، ثُمَّ صَلَّیْت الْعَصْرَ ، ثُمَّ أَتَیْتُ الْحَسَنَ ، فَذَکَرْت ذَلِکَ لَہُ فَأَمَرَنِی بِمِثْلِ الَّذِی صَنَعْت۔","","Musannaf Ibn Abi Shaybah 4803","","","كتاب الصلوات"
"4804","(۴۸۰۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، عَنْ کَثِیرِ بْنِ أَفْلَحَ ، قَالَ : انْتَہَیْنَا إلَی الْمَسْجِدِ وَلَمْ أُصَلِّ الْمَغْرِبَ ، فَأُقِیمَتِ الصَّلاَۃ فَصَلَّیْت مَعَہُمْ وَأَنَا أَرَی أَنَّہَا الْمَغْرِبُ ، فَإِذَا ہِیَ الْعِشَائُ ، فَقُمْت فَصَلَّیْت الْمَغْرِبَ ، ثُمَّ صَلَّیْت الْعِشَائَ ، ثُمَّ سَأَلْتُ ، فَأَمَرُونِی بِالَّذِی صَنَعْت۔","","Musannaf Ibn Abi Shaybah 4804","","","كتاب الصلوات"
"4805","(۴۸۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنِ الزُّہْرِیِّ ؛ فِی رَجُلٍ دَخَلَ مَعَ قَوْمٍ فِی الظُّہْرِ ، وَہِیَ لَہُمُ الْعَصْرُ ؟ قَالَ : یَبْدَأُ بِالَّذِی بَدَأَ اللَّہُ بِہِ یُصَلِّی الظُّہْرَ ، ثُمَّ یُصَلِّی الْعَصْرَ۔","","Musannaf Ibn Abi Shaybah 4805","","","كتاب الصلوات"
"4806","(۴۸۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، قَالَ : بَلَغَنِی عَنْ طَاوُوسٍ ، وَعَطَائٍ ، أَنَّہُمَا قَالاَ : یُجْزِئُہُ۔","","Musannaf Ibn Abi Shaybah 4806","","","كتاب الصلوات"
"4807","(۴۸۰۷) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، قَالَ : سَأَلْتُ أَبَا جَعْفَرٍ وَسَالِمًا ، وَالْقَاسِمَ ، وَعَطَائً عَنْ رَجُلٍ دَخَلَ مَعَ قَوْمٍ فِی الْعَصْرِ وَہُوَ یَرَی أَنَّہَا الظُّہْرُ ؟ قَالُوا : یَنْصَرِفُ فَیُصَلِّی الظُّہْرَ، ویُجْزِئُ عَنْہُ الْعَصْرُ ، قَالَ : وَسَأَلْت عَامِرًا ، وَمُسْلِمَ بْنَ صُبَیْحٍ ، فَقَالاَ : یَنْصَرِفُ فَیُصَلِّی الظُّہْرَ ، ثُمَّ یُصَلِّی الْعَصْرَ ، فَإِنَّ اللَّہَ قَدْ کَتَبَہَا عِنْدَہُ قَبْلَ الْعَصْرِ ، فَلاَ تَکُونُ لَہُ الظُّہْرُ ۔ وَقَالَ جَابِرٌ : عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 4807","","","كتاب الصلوات"
"4808","(۴۸۰۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ ، قَالاَ : فِی رَجُلٍ دَخَلَ مَعَ قَوْمٍ فِی صَلاَۃِ الْعَصْرِ، وَہُوَ یَحْسَبُہُمْ فِی صَلاَۃِ الظُّہْرِ، فَإِذَا ہُمْ فِی الْعَصْرِ، قَالَ: یَسْتَقْبِلُ الصَّلاَتَیْنِ جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 4808","","","كتاب الصلوات"
"4809","(۴۸۰۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ فِی الْمُسَافِر إذَا نَسِیَ صَلاَۃً فَذَکَرَہَا فِی الْحَضَرِ: صَلَّی صَلاَۃَ السَّفَرِ، وَإِذَا نَسِیَ صَلاَۃً فِی الْحَضَرِ فَذَکَرَہَا فِی السَّفَرِ، فَلْیُصَلِّ صَلاَۃَ الْحَضَرِ۔","","Musannaf Ibn Abi Shaybah 4809","","","كتاب الصلوات"
"4810","(۴۸۱۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، وَعُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ ؛ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 4810","","","كتاب الصلوات"
"4811","(۴۸۱۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ أبی الْفَضْلِ ، عَنِ الْحَسَنِ ، قَالَ : إذَا نَسِیَ صَلاَۃً فِی الْحَضَرِ ، فَذَکَرَہَا فِی السَّفَرِ صَلَّی صَلاَۃَ الْحَضَرِ، وَإِذَا نَسِیَ صَلاَۃً فِی السَّفَرِ فَذَکَرَہَا فِی الْحَضَرِ، صَلَّی صَلاَۃَ السَّفَرِ۔","","Musannaf Ibn Abi Shaybah 4811","","","كتاب الصلوات"
"4812","(۴۸۱۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَمِعْتُ سُفْیَانَ یَقُولُ : یُصَلِّی الصَّلاَۃ الَّتِی نَسِیَہَا۔","","Musannaf Ibn Abi Shaybah 4812","","","كتاب الصلوات"
"4813","(۴۸۱۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الْخَالِقِ ، عَنْ حَمَّادٍ ، قَالَ : إذَا نَسِیَ صَلاَۃً فِی الْحَضَرِ فَذَکَرَہَا فِی السَّفَرِ صَلَّی أَرْبَعًا ، وَإِذَا نَسِیَ صَلاَۃً فِی السَّفَرِ فَذَکَرَہَا فِی الْحَضَرِ ، صَلَّی صَلاَۃَ سَفَرٍ۔","","Musannaf Ibn Abi Shaybah 4813","","","كتاب الصلوات"
"4814","(۴۸۱۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو الزُّبَیْرِ ، عَنْ نَافِعِ بْنِ جُبَیْرٍ ، عَنْ أَبِی عُبَیْدَۃَ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ ؛ أَنَّ الْمُشْرِکِینَ شَغَلُوا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ الْخَنْدَقِ عَنْ أَرْبَعِ صَلَوَاتٍ ، حَتَّی ذَہَبَ مِنَ اللَّیْلِ مَا شَائَ اللَّہُ ، قَالَ : فَأَمَرَ بِلاَلاً فَأَذَّنَ وَأَقَامَ ، فَصَلَّی الظُّہْرَ ، ثُمَّ أَقَامَ فَصَلَّی الْعَصْرَ ، ثُمَّ أَقَامَ فَصَلَّی الْمَغْرِبَ ، ثُمَّ أَقَامَ فَصَلَّی الْعِشَائَ۔ (ترمذی ۱۷۹۔ احمد ۱/۳۷۵)","","Musannaf Ibn Abi Shaybah 4814","","","كتاب الصلوات"
"4815","(۴۸۱۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ابْنُ أَبِی ذِئْبٍ ، عَنِ الْمَقْبُرِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی سَعِیدٍ الْخُدْرِیِّ ، عَنْ أَبِیہِ ، قَالَ : حُبِسْنَا یَوْمَ الْخَنْدَقِ عَنِ الظُّہْرِ وَالْعَصْرِ وَالْمَغْرِبِ وَالْعِشَائِ ، حَتَّی کُفِینَا ذَلِکَ ، وَذَلِکَ قولہ تعالی : {وَکَفَی اللَّہُ الْمُؤْمِنِینَ الْقِتَالَ وَکَانَ اللَّہُ قَوِیًّا عَزِیزًا} فَقَامَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَمَرَ بِلاَلاً ، فَأَقَامَ الصَّلاَۃ ، ثُمَّ صَلَّی الظُّہْرَ کَمَا کَانَ یُصَلِّیہَا قَبْلَ ذَلِکَ ، ثُمَّ أَقَامَ الْعَصْرَ ، فَصَلَّی الْعَصْرَ کَمَا کَانَ یُصَلِّیہَا قَبْلَ ذَلِکَ ، ثُمَّ أَقَامَ الْمَغْرِبَ ، فَصَلَّی الْمَغْرِبَ کَمَا کَانَ یُصَلِّیہَا قَبْلَ ذَلِکَ ، ثُمَّ أَقَامَ الْعِشَائَ فَصَلاَّہَا کَمَا کَانَ یُصَلِّیہَا قَبْلَ ذَلِکَ ، قَبْلَ أَنْ یَنْزِلَ : {فَإِنْ خِفْتُمْ فَرِجَالاً أَوْ رُکْبَانًا}۔ (احمد ۳/۶۸۔ دارمی ۱۵۲۴)","Sahih","Musannaf Ibn Abi Shaybah 4815","","","كتاب الصلوات"
"4816","(۴۸۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عن سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : قَالَ عُمَرُ : مَنْ فَاتَہُ شَیْئٌ مِنْ قِرَائَتِہِ بِاللَّیْلِ ، فَصَلَّی مَا بَیْنَہُ وَبَیْنَ الظُّہْرِ ، فَکَأَنَّمَا صَلَّی بِاللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 4816","","","كتاب الصلوات"
"4817","(۴۸۱۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عَبْدَۃَ ، عَنْ أَبِی بَکْرِ بْنِ عَمْرِو بْنِ حَزْمٍ ؛ أَنَّ رَجُلاً اسْتَأْذَنَ عَلَی عُمَرَ بِالْہَاجِرَۃِ ، فَحَجَبَہُ طَوِیلاً ، ثُمَّ أَذِنَ لَہُ ، فَقَالَ : إنِّی کُنْتُ نِمْتُ عَنْ حِزْبِیْ ، فَکُنْت أَقْضِیہِ۔","","Musannaf Ibn Abi Shaybah 4817","","","كتاب الصلوات"
"4818","(۴۸۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عُثْمَانَ الثَّقَفِیِّ ، عَنْ أَبِی عُبَیْدِ اللہِ مَوْلَی ابْنِ عَبَّاسٍ ، قَالَ : قَالَ عَلِیٌّ : مَنْ فَاتَہُ شَیْئٌ مِنْ حِزْبِہِ ، فَصَلاَّہُ ارْتِفَاعَ النَّہَارِ ، فَکَأَنَّمَا صَلاَّہُ بِاللَّیْلِ۔","Majhul","Musannaf Ibn Abi Shaybah 4818","","","كتاب الصلوات"
"4819","(۴۸۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، قَالَ : کُنَّا نَأْتِی عَائِشَۃَ قَبْلَ صَلاَۃِ الْفَجْرِ فَأَتَیْنَاہَا ذَاتَ یَوْمٍ فَإِذَا ہِیَ تُصَلِّی ، فَقَالَتْ : نِمْت عَنْ حِزْبِی فِی ہَذِہِ اللَّیْلَۃِ فَلَمْ أَکُنْ لأَدَعَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4819","","","كتاب الصلوات"
"4820","(۴۸۲۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : مَنْ فَاتَہُ جُزْؤُہُ مِنَ اللَّیْلِ فَقَضَاہُ قَبْلَ أَنْ تَزُولَ الشَّمْسُ ، فَقَدْ أَدْرَکَ۔","","Musannaf Ibn Abi Shaybah 4820","","","كتاب الصلوات"
"4821","(۴۸۲۱) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ (ح) وَعَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالاَ : ہُوَ کَلاَمٌ ، یَعْنِی الْفَتْحَ عَلَی الإِمَام۔","Da'if","Musannaf Ibn Abi Shaybah 4821","","","كتاب الصلوات"
"4822","(۴۸۲۲) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کان یَکْرَہُ أَنْ یَفْتَحَ عَلَی الإِمَام۔","","Musannaf Ibn Abi Shaybah 4822","","","كتاب الصلوات"
"4823","(۴۸۲۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَیْمُونِ أَبِی حَمْزَۃَ ، عَنْ إبْرَاہِیمَ ، عَنِ ابْنِ مَسْعُودٍ ؛ فِی تَلْقِینِ الإِمَام : إنَّمَا ہُوَ کَلاَمٌ یُلْقِیہِ إلَیْہِ ، قَالَ : وَقَالَ إبْرَاہِیمُ : مَا أُبَالِی لَقَّنتُۃٌ ، أَوْ قُلْتُ : یَا کَبِیرۃ۔","","Musannaf Ibn Abi Shaybah 4823","","","كتاب الصلوات"
"4824","(۴۸۲۴) حَدَّثَنَا حَفْصٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ سَلَمِ بْنِ عَطِیَّۃَ ؛ أَنَّ رَجُلاً فَتَحَ عَلَی إمَامِ شُرَیْحٍ وَہُوَ فِی الصَّلاَۃ، فَلَمَّا انْصَرَفَ ، قَالَ لَہُ : اقْضِ صَلاَتَک۔","","Musannaf Ibn Abi Shaybah 4824","","","كتاب الصلوات"
"4825","(۴۸۲۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حُرَیْثٍ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ؛ أَنَّہُ کَرِہَ أَنْ یُلَقَّنَ الْقَارِیئُ۔","","Musannaf Ibn Abi Shaybah 4825","","","كتاب الصلوات"
"4826","(۴۸۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : مَنْ فَتَحَ عَلَی الإِمَام فَقَدْ تَکَلَّمَ۔","","Musannaf Ibn Abi Shaybah 4826","","","كتاب الصلوات"
"4827","(۴۸۲۷) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَرِہَ الْفَتْحَ عَلَی الإِمَام۔","Da'if","Musannaf Ibn Abi Shaybah 4827","","","كتاب الصلوات"
"4828","(۴۸۲۸) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبِیْدَۃَ بْنِ رَبِیعَۃَ ، قَالَ : أَتَیْتُ الْمَقَامَ فَإِذَا رَجُلٌ حَسَنُ الثِّیَابِ طَیِّبُ الرِّیحِ یُصَلِّی فَقَرَأَ ، وَرَجُلٌ إلَی جَنْبِہِ یَفْتَحُ عَلَیْہِ ، فَقُلْتُ : مَنْ ہَذَا ؟ قَالُوا: عُثْمَانَ۔","Majhul","Musannaf Ibn Abi Shaybah 4828","","","كتاب الصلوات"
"4829","(۴۸۲۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ عَلِیٍّ، قَالَ: إذَا اسْتَطْعَمَک الإِمَام فَأَطْعِمْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 4829","","","كتاب الصلوات"
"4830","(۴۸۳۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : کَانَ مَرْوَانُ یُلَقِّنُ فِی الصَّلاَۃ وَأَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْمَدِینَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 4830","","","كتاب الصلوات"
"4831","(۴۸۳۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ، أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا بِتَلْقِینِ الإِمَام۔","","Musannaf Ibn Abi Shaybah 4831","","","كتاب الصلوات"
"4832","(۴۸۳۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عن ہشام ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ، قَالاَ : لُـقِّنَ [corrupt]لإِمَام۔","","Musannaf Ibn Abi Shaybah 4832","","","كتاب الصلوات"
"4833","(۴۸۳۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّ ابْنَ مُغَفَّلٍ أَمَرَ رَجُلاً یُلَقِّنُہُ إذَا تَعَایَی۔","","Musannaf Ibn Abi Shaybah 4833","","","كتاب الصلوات"
"4834","(۴۸۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُسَاوِرٍ ، قَالَ : حدَّثَنِی ہِلاَلُ بْنُ أَبِی حُمَیْدٍ ، قَالَ : کُنْتُ أَفْتَحُ عَلَی عَبْدِ اللہِ بْنِ عُکَیْمٍ إذَا تَعَایَی فِی الصَّلاَۃ ، فَقَالَ لِی یَوْمًا : أَمَا صَلَّیْتَ مَعَنَا ؟ قَالَ : فَقُلْتُ : لاَ ،قَالَ : قَدِ اسْتَنکَرْتُ ذَلِکَ ، تَرَدَّدْت الْبَارِحَۃَ فَلَمْ أَجِدْ أَحَدًا یَفْتَحُ عَلَیَّ ؟۔","","Musannaf Ibn Abi Shaybah 4834","","","كتاب الصلوات"
"4835","(۴۸۳۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِتَلْقِینِ الإِمَام۔","","Musannaf Ibn Abi Shaybah 4835","","","كتاب الصلوات"
"4836","(۴۸۳۶) حَدَّثَنَا معن بْنُ عِیسَی ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ یَزِیدَ بْنَ رُومَانَ ، قَالَ : کُنْتُ أُصَلِّی إلَی جَنْبِ نَافِعِ بْنِ جُبَیْرِ بْنِ مُطْعِمٍ ، فَیَغْمِزُنِی فَأَفْتَحُ عَلَیْہِ وَہُوَ یُصَلِّی۔","","Musannaf Ibn Abi Shaybah 4836","","","كتاب الصلوات"
"4837","(۴۸۳۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنْ نَافِعٍ ، قَالَ : صَلَّی بِنَا ابْنُ عُمَرَ ، قَالَ : فَتَرَدَّدَ ، قَالَ : فَفَتَحْتُ عَلَیْہِ فَأَخَذَ عَنِّی۔","Da'if","Musannaf Ibn Abi Shaybah 4837","","","كتاب الصلوات"
"4838","(۴۸۳۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَاصِمٍ ، عن أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : کُنَّا نُسَلِّمُ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یُصَلِّی فَیَرُدُّ عَلَیْنَا ، قَبْلَ أَنْ نَأْتِیَ أَرْضَ الْحَبَشَۃِ ، فَلَمَّا قَدِمْنَا مِنْ أَرْضِ الْحَبَشَۃِ سَلَّمْتُ عَلَیْہِ فَلَمْ یَرُدَّ عَلَیَّ ، فَأَخَذَنِی مَا قَرُبَ ، وَمَا بَعُدَ ، فَلَمَّا قَضَی صَلاَتَہُ ، قَالَ : إنَّ اللَّہَ یُحْدِثُ مِنْ أَمْرِہِ مَا شَائَ ، وَقَدْ أَحْدَثَ أَنْ لاَ تَکَلَّمُوا فِی الصَّلاَۃ۔ (ابوداؤد ۹۲۱۔ احمد ۱/۳۷۷)","Hasan","Musannaf Ibn Abi Shaybah 4838","","","كتاب الصلوات"
"4839","(۴۸۳۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ أبی الزُّبَیْرِ ، عن جابر ، قَالَ : بَعَثَنِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی حَاجَۃٍ ، فَجِئْت وَہُوَ یُصَلِّی ، فَسَلَّمْت عَلَیْہِ ، فَلاَ یَرُدُّ عَلَیَّ السَّلاَمَ ۔(ابوداؤد ۹۲۳۔ احمد ۳/۳۷۹)","Sahih","Musannaf Ibn Abi Shaybah 4839","","","كتاب الصلوات"
"4840","(۴۸۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : السَّلاَمُ عَلَی الْمُصَلِّی عَجْز۔","","Musannaf Ibn Abi Shaybah 4840","","","كتاب الصلوات"
"4841","(۴۸۴۱) حَدَّثَنَا حَفْصٌ ، وَوَکِیعٌ ، عَنْ زَکَرِیَّا ، قَالَ : قُلْتُ لِلشَّعْبِیِّ : أَدْخُلُ عَلَی قَوْمٍ وَہُمْ یُصَلُّونَ فُرَادَی ، أَأُسَلِّمُ عَلَیْہِمْ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 4841","","","كتاب الصلوات"
"4842","(۴۸۴۲) حَدَّثَنَا جَرِیرٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَرُدُّ عَلَیْہِ فِی نَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 4842","","","كتاب الصلوات"
"4843","(۴۸۴۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ رَجُلٍ مِنْ بَنِی عَامِرٍ ، قَالَ : قُمْتُ إلَی جَنْبِ أَبِی ذَرٍّ وَہُوَ یُصَلِّی ، فَسَلَّمْت عَلَیْہِ ، فَمَا رَدَّ عَلَیَّ۔","Majhul","Musannaf Ibn Abi Shaybah 4843","","","كتاب الصلوات"
"4844","(۴۸۴۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ یَعْقُوبَ بن عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَنْ بُسر بْنِ سَعِیدٍ ، قَالَ : سَلَّمَ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلٌ وَہُوَ یُصَلِّی ، فَأَشَارَ إلَیْہِ بِیَدِہِ ، کَأَنَّہُ یَنْہَاہُ۔","","Musannaf Ibn Abi Shaybah 4844","","","كتاب الصلوات"
"4845","(۴۸۴۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : کُنَّا نُسَلِّمُ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ فِی الصَّلاَۃ قَبْلَ أَنْ نَخْرُجَ إلَی النَّجَاشِیِّ فَیَرُدُّ عَلَیْنَا ، فَلَمَّا رَجَعْنَا مِنْ عِنْدِ النَّجَاشِیِّ سَلَّمْت عَلَیْہِ فَلَمْ یَرُدَّ ، وَقَالَ : إنَّ فِی الصَّلاَۃ شُغْلاً۔ (بخاری ۱۱۹۹۔ ابوداؤد ۹۲۰)","Sahih","Musannaf Ibn Abi Shaybah 4845","","","كتاب الصلوات"
"4846","(۴۸۴۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : سَأَلْتُ صُہَیْبًا ، کَیْفَ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَصْنَعُ حَیْثُ کَانَ یُسَلَّمُ عَلَیْہِ ؟ قَالَ : کَانَ یُشِیرُ بِیَدِہِ۔ (ابوداؤد ۹۲۲۔ ترمذی ۳۶۷)","Sahih","Musannaf Ibn Abi Shaybah 4846","","","كتاب الصلوات"
"4847","(۴۸۴۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ ، قَالَ : سَلَّمْتُ عَلَی ابْنِ عَبَّاسٍ وَہُوَ یُصَلِّی فِی وَجْہِ الْکَعْبَۃِ ، فَأَخَذَ بِیَدِی۔","Sahih","Musannaf Ibn Abi Shaybah 4847","","","كتاب الصلوات"
"4848","(۴۸۴۸) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : سَلَّمْتُ عَلَی ابْنِ عَبَّاسٍ وَہُوَ فِی الصَّلاَۃ ،فَلَمْ یَرُدَّ عَلَیَّ ، وَبَسَطَ یَدَہُ إلَیَّ وَصَافَحَنِی۔","Da'if","Musannaf Ibn Abi Shaybah 4848","","","كتاب الصلوات"
"4849","(۴۸۴۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عَبْدِ رَبِّہِ ، عَنْ أَبِی عِیَاضٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : إذَا سُلِّمَ عَلَیْک وَأَنْتَ فِی الصَّلاَۃ ، فَرُدَّ۔","Majhul","Musannaf Ibn Abi Shaybah 4849","","","كتاب الصلوات"
"4850","(۴۸۵۰) حَدَّثَنَا حَفْصٌ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : مَا کُنْتُ لِأُسَلِّمُ عَلَی رَجُلٍ وَہُوَ یُصَلِّی ، زَادَ أَبُو مُعَاوِیَۃَ : وَلَوْ سَلَّمَ عَلَیَّ لَرَدَدْت عَلَیْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 4850","","","كتاب الصلوات"
"4851","(۴۸۵۱) حَدَّثَنَا عَبْدَۃُ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إذَا سُلِّمَ علی أَحَدِکُمْ وَہُوَ فِی الصَّلاَۃ فَلْیُشِرْ بِیَدِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4851","","","كتاب الصلوات"
"4852","(۴۸۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ؛ سُئِلَ عَنِ الرَّجُلِ یُسَلَّمُ عَلَیْہِ فِی الصَّلاَۃ ؟ قَالَ : یَرُدُّ بِشِقِّ رَأْسِہِ الأَیْمَنِ۔","","Musannaf Ibn Abi Shaybah 4852","","","كتاب الصلوات"
"4853","(۴۸۵۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یُسَلَّمُ عَلَیْہِ فِی الصَّلاَۃ ، قَالَ : یَرُدُّ عَلَیْہِ السَّلاَمَ إذَا انْصَرَفَ ، فَإِذَا ذَہَبَ اتَّبَعَہُ بِالسَّلاَمِ۔","","Musannaf Ibn Abi Shaybah 4853","","","كتاب الصلوات"
"4854","(۴۸۵۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : لَمَّا قَدِمَ عَبْدُ اللہِ مِنَ الْحَبَشَۃِ أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یُصَلِّی ، فَسَلَّمَ عَلَیْہِ فَأَوْمَأَ ، وَأَشَارَ بِرَأْسِہِ۔","","Musannaf Ibn Abi Shaybah 4854","","","كتاب الصلوات"
"4855","(۴۸۵۵) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ عَطَائِ بْنِ أَبِی رَبَاحٍ ؛ أَنَّ رَجُلاً سَلَّمَ عَلَی ابْنِ عَبَّاسٍ وَہُوَ فِی الصَّلاَۃ ، فَأَخَذَ بِیَدِہِ فَصَافَحَہُ ، وَغَمَزَ یَدَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4855","","","كتاب الصلوات"
"4856","(۴۸۵۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَمِعْتُ سُفْیَانَ یَقُولُ : لاَ یَرُدُّ السَّلاَمَ حَتَّی یُصَلِّیَ ، فَإِنْ کَانَ قَرِیبًا رَدَّ عَلَیْہِ ، وَإِنْ کَانَ بَعِیدًا تبِعَہُ بِالسَّلاَمِ۔","","Musannaf Ibn Abi Shaybah 4856","","","كتاب الصلوات"
"4857","(۴۸۵۷) حَدَّثَنَا یُونُسُ ، عَنْ مُحَمَّدٍ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ زِیَادٍ ، قَالَ : حدَّثَنَا عَاصِمٌ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : سُئِلَ عَنِ الرَّجُلِ یُسَلَّمُ عَلَیْہِ وَہُوَ فِی الصَّلاَۃ ؟ قَالَ : إذَا قَضَی الصَّلاَۃ أَتْبَعَہُ بِالسَّلاَمِ۔","","Musannaf Ibn Abi Shaybah 4857","","","كتاب الصلوات"
"4858","(۴۸۵۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، عَنْ عَمَّارٍ ، قَالَ : أَتَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یُصَلِّی فَسَلَّمْت عَلَیْہِ ، قَالَ : فَرَدَّ عَلَیَّ السَّلاَمَ۔ (احمد ۴/۲۶۳۔ ابو یعلی ۱۶۳۴)","Sahih","Musannaf Ibn Abi Shaybah 4858","","","كتاب الصلوات"
"4859","(۴۸۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ مَوْہَبٍ ، عَنْ عَمِّہِ ، عَنْ مَوْلًی لأَبِی سَعِیدٍ الْخُدْرِیِّ ؛ أَنَّہُ کَانَ مَعَ أَبِی سَعِیدٍ الْخُدْرِیِّ وَہُوَ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَالِسٌ ، قَالَ : فَدَخَلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمَسْجِدَ فَرَأَی رَجُلاً جَالِسًا وَسَطَ الْمَسْجِدِ مُشَبِّکًا أَصَابِعَہُ یُحَدِّثُ نَفْسَہُ ، قَالَ : فَأَوْمَأَ إلَیْہِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَلَمْ یَفْطِنْ ، فَالْتَفَتَ إلَی أَبِی سَعِیدٍ الْخُدْرِیِّ ، فَقَالَ : إذَا صَلَّی أَحَدُکُمْ فَلاَ یُشَبِّکَنَّ بَیْنَ أَصَابِعِہِ ، فَإِنَّ التَّشْبِیکَ مِنَ الشَّیْطَانِ ، وَإِنَّ أَحَدَکُمْ لاَ یَزَالُ فِی صَلاَۃٍ مَا دَامَ فِی الْمَسْجِدِ حَتَّی یَخْرُجَ مِنْہُ۔ (احمد ۳/۵۴)","Majhul","Musannaf Ibn Abi Shaybah 4859","","","كتاب الصلوات"
"4860","(۴۸۶۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ یَزِیدَ بْنِ خُصَیْفَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا کَانَ أَحَدُکُمْ فِی الْمَسْجِدِ ، فَلاَ یُشَبِّکَنَّ أَصَابِعَہُ۔","","Musannaf Ibn Abi Shaybah 4860","","","كتاب الصلوات"
"4861","(۴۸۶۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ سَعْدِ بْنِ إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ أَبِی سعید ، عن أبی ثُمَامَۃَ الْقَمَّاحِ ، قَالَ: لَقِیت کَعْبًا وَأَنَا بِالْبَلاَطِ قَدْ أَدْخَلْت بَعْضَ أَصَابِعِی فِی بَعْضٍ ، فَضَرَبَ یَدِی ضَرْبًا شَدِیدًا ، وَقَالَ : نُہِینَا أَنْ نُشَبِّکَ بَیْنَ أَصَابِعِنا فِی الصَّلاَۃ ، قَالَ : قُلْتُ لَہُ : یَرْحَمُک اللَّہُ تَرَانِی فِی صَلاَۃٍ ؟ فَقَالَ : مَنْ تَوَضَّأَ فَعَمَدَ إلَی الْمَسْجِدِ ، فَہُوَ فِی صَلاَۃٍ۔ (ابوداؤد ۵۶۳۔ احمد ۴/۲۴۱)","Majhul","Musannaf Ibn Abi Shaybah 4861","","","كتاب الصلوات"
"4862","(۴۸۶۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ عَجْلاَنَ ، عَنِ النُّعْمَانِ بْنُ أَبِی عَیَّاشٍ ، قَالَ : کَانُوا یَنْہَوْنَ عَنْ تَشْبِیکِ الأَصَابِعِ ، یَعْنِی فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4862","","","كتاب الصلوات"
"4863","(۴۸۶۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مُحِلٍّ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَرِہَ أَنْ یُشَبِّکَ أَصَابِعَہُ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4863","","","كتاب الصلوات"
"4864","(۴۸۶۴) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ خَلِیفَۃَ بْنِ غَالِبٍ ، عَنْ نَافِعٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ یُشَبِّکُ بَیْنَ أَصَابِعِہِ فِی الصَّلاَۃ۔","Hasan","Musannaf Ibn Abi Shaybah 4864","","","كتاب الصلوات"
"4865","(۴۸۶۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَصْحَابُنَا ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یُشَبِّکُ بَیْنَ أَصَابِعِہِ فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 4865","","","كتاب الصلوات"
"4866","(۴۸۶۶) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا وُہَیْبٌ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، قَالَ : رَأَیْتُ سَالِمَ بْنَ عَبْدِ اللہِ یُشَبِّکُ بَیْنَ أَصَابِعِہِ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4866","","","كتاب الصلوات"
"4867","(۴۸۶۷) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا أَرَادَ أَنْ یَقُولَ سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، فَقَالَ : اللَّہُ أَکْبَرُ ، قَالَ : یَسْتَغْفِرُ اللَّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 4867","","","كتاب الصلوات"
"4868","(۴۸۶۸) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَرَادَ أَنْ یَقُولَ سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، فَقَالَ : اللَّہُ أَکْبَرُ ، فَلاَ سَہْوَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 4868","","","كتاب الصلوات"
"4869","(۴۸۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، وَغَیْرِہِ ؛ فِی رَجُلٍ أَرَادَ أَنْ یَقُولَ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، فَقَالَ : اللَّہُ أَکْبَرُ ، قَالُوا : لَیْسَ عَلَیْہِ سَہْوٌ۔","","Musannaf Ibn Abi Shaybah 4869","","","كتاب الصلوات"
"4870","(۴۸۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ مُحَمَّدِ بْنِ عَلِیٍّ ، وَعَامِرٍ ، وَعَطَائٍ ، قَالُوا : فِی رَجُلٍ أَرَادَ أَنْ یَقُولَ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، فَقَالَ : اللَّہُ أَکْبَرُ ، قَالُوا : لَیْسَ عَلَیْہِ سَہْوٌ۔","","Musannaf Ibn Abi Shaybah 4870","","","كتاب الصلوات"
"4871","(۴۸۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ عْن رَجُلٍ نَسِیَ تَکْبِیرَۃً ؟ قَالَ : یَسْجُدُ سَجْدَتَیِ السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 4871","","","كتاب الصلوات"
"4872","(۴۸۷۲) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ صَلَّی الْمَغْرِبَ أَرْبَعًا ، قَالَ : یَسْجُدُ سَجْدَتَیِ السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 4872","","","كتاب الصلوات"
"4873","(۴۸۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : یُعِیدُ۔","","Musannaf Ibn Abi Shaybah 4873","","","كتاب الصلوات"
"4874","(۴۸۷۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، قَالَ : إذَا لَمْ یَجْلِسْ فِی الثَّالِثَۃِ أَعَادَ۔","","Musannaf Ibn Abi Shaybah 4874","","","كتاب الصلوات"
"4875","(۴۸۷۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائِ بْنِ یَسَارٍ ، سَمِعَ أَبَا ہُرَیْرَۃَ یَقُولُ : إذَا أُقِیمَتِ الصَّلاَۃ فَلاَ صَلاَۃَ إِلاَّ الْمَکْتُوبَۃُ۔ (مسلم ۴۹۳۔ ابوداؤد ۱۲۶۰)","Sahih","Musannaf Ibn Abi Shaybah 4875","","","كتاب الصلوات"
"4876","(۴۸۷۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عَمْرٍو ، عَنْ عَطَائِ بْنِ یَسَارٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : إذَا أُقِیمَتِ الصَّلاَۃ فَلاَ صَلاَۃَ إِلاَّ الْمَکْتُوبَۃُ۔ (مسلم ۴۹۳۔ ابوداؤد ۱۲۶۰)","Sahih","Musannaf Ibn Abi Shaybah 4876","","","كتاب الصلوات"
"4877","(۴۸۷۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنْ فُضَیْلٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ رَأَی رَجُلاً یُصَلِّی عِنْدَ إقَامَۃِ الْعَصْرِ ، قَالَ : یَسُرُّک أَنْ یُقَالَ : صَلَّی ابْنُ فُلاَنَۃَ سِتًّا ، قَالَ : فَذَکَرْت ذَلِکَ لإِبْرَاہِیمَ ، فَقَالَ : کَانَتْ تُکْرَہُ الصَّلاَۃ مَعَ الإِقَامَۃِ۔","","Musannaf Ibn Abi Shaybah 4877","","","كتاب الصلوات"
"4878","(۴۸۷۸) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مَنْصُورٍ ، عَنْ فُضَیْلِ بْنِ عَمْرٍو ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ الصَّلاَۃ إذَا أَخَذَ الْمُؤَذِّنُ فِی الإِقَامَۃِ۔","","Musannaf Ibn Abi Shaybah 4878","","","كتاب الصلوات"
"4879","(۴۸۷۹) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ مَیْمُونٍ ، قَالَ : إذَا کَبَّرَ الْمُؤَذِّنُ بِالإِقَامَۃِ فَلاَ تُصَلِّیَنَّ شَیْئًا حَتَّی تُصَلِّیَ الْمَکْتُوبَۃَ۔","","Musannaf Ibn Abi Shaybah 4879","","","كتاب الصلوات"
"4880","(۴۸۸۰) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنِ ابْنِ أَبِی فَرْوَۃَ ، عَنْ أَبِی بَکْرِ بْنِ الْمُنْکَدِرِ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ عُمَرَ رَأَی رَجُلاً یُصَلِّی رَکْعَتَیْنِ وَالْمُؤَذِّنُ یُقِیمُ فَانْتَہَرَہُ ، وَقَالَ : لاَ صَلاَۃَ وَالْمُؤَذِّنُ یُقِیمُ إِلاَّ الصَّلاَۃ الَّتِی تُقَامُ لَہَا الصَّلاَۃ۔","Da'if","Musannaf Ibn Abi Shaybah 4880","","","كتاب الصلوات"
"4881","(۴۸۸۱) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ عَطَائٍ ، قَالَ : إذَا کُنْتَ فِی الْمَسْجِدِ فَأُقِیمَتِ الصَّلاَۃ فَلاَ تَرْکَعْ۔","","Musannaf Ibn Abi Shaybah 4881","","","كتاب الصلوات"
"4882","(۴۸۸۲) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، أَنَّہُ قَالَ فِی الرَّجُلِ یُصَلِّی فِی الْمَسْجِدِ رَکْعَتَیْنِ مِنَ الْفَرِیضَۃِ وَحْدَہُ ، ثُمَّ تُقَامُ الصَّلاَۃ ، قَالَ : یُصَلِّی مَعَہُمْ وَلاَ یَعْتَدُّ بِہَا۔","","Musannaf Ibn Abi Shaybah 4882","","","كتاب الصلوات"
"4883","(۴۸۸۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا سَیَّارٌ ، وَالْمُغِیرَۃُ ، عَنِ الشَّعْبِیِّ (ح) وَأَخْبَرَنَا یُونُسُ ، وَمَنْصُورٌ ، عَنِ الْحَسَنِ (ح) وَحَجَّاجٌ ، عَنْ عَطَائٍ (ح) وَشُعْبَۃُ ، عَنِ الْحَکَمِ ، قَالُوا : یُسَلِّمُ ثُمَّ یَدْخُلُ مَعَ الإِمَامِ فِی صَلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 4883","","","كتاب الصلوات"
"4884","(۴۸۸۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مِسْعَرٍ ، قَالَ : أَظُنُّہُ ، عَنْ عُتْبَۃَ بْنِ قَیْسٍ ، عَنْ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، قَالَ : یَقْطَعُہا ثُمَّ یَدْخُلُ مَعَہُمْ۔","","Musannaf Ibn Abi Shaybah 4884","","","كتاب الصلوات"
"4885","(۴۸۸۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مِسْعَرٍ ، قَالَ : سَمِعْتُ حَمَّادًا یَقُولُ : أَحَبُّ إلَیَّ أَنْ یَتَکَلَّمَ وَیَدْخُلَ مَعَہُمْ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4885","","","كتاب الصلوات"
"4886","(۴۸۸۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یَقُولُ : إذَا دَخَلَ الرَّجُلُ فِی الْفَرِیضَۃِ ، ثُمَّ فَجِئَتْہُ الإِقَامَۃُ قَطَعَہَا ، وَکَانَتْ لَہُ نَافِلَۃً وَدَخَلَ فِی الْفَرِیضَۃِ۔","","Musannaf Ibn Abi Shaybah 4886","","","كتاب الصلوات"
"4887","(۴۸۸۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَأْتِی الْمَسْجِدَ فَیری أَنَّہُمْ صَلَّوْا ، فَافْتَرَضَ الصَّلاَۃ فَصَلَّی رَکْعَتَیْنِ مِنَ الْمَکْتُوبَۃِ فَأُقِیمَتِ الصَّلاَۃ ، قَالَ : یَدْخُلُ مَعَ الإِمَامِ فِی صَلاَتِہِ ، فَإِذَا صَلَّی مَعَ الإِمَامِ رَکْعَتَیْنِ ، ثُمَّ یُسَلِّم ، ثُمَّ یَجْعَلُ الرَّکْعَتَیْنِ الأُخْرَیَیْنِ مَعَ الإِمَامِ تَطَوُّعًا۔","","Musannaf Ibn Abi Shaybah 4887","","","كتاب الصلوات"
"4888","(۴۸۸۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، أَنَّہُ قَالَ : کَمَا قَالَ إبْرَاہِیمُ۔","","Musannaf Ibn Abi Shaybah 4888","","","كتاب الصلوات"
"4889","(۴۸۸۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا کَانَ الرَّجُلُ قَائِمًا یُصَلِّی فَسَمِع الإِقَامَۃَ فَلْیَقْطَعْ ۔ وَقَالَ إبْرَاہِیمُ : یُضِیفُ إلَیْہَا أُخْرَی وَلاَ یَقْطَعُ۔","","Musannaf Ibn Abi Shaybah 4889","","","كتاب الصلوات"
"4890","(۴۸۹۰) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مَنْصُورٍ ، عَنْ فُضَیْلِ بْنِ عَمْرٍو ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یَقُولُ : إِنْ بَقِیَ عَلَیْک مِنْ صَلاَتِکَ شَیْئٌ فَأَتْمِمْہُ ۔ وَکَانَ سَعِیدُ بْنُ جُبَیْرٍ یَقُولُ : اقْطَعْہَا۔","","Musannaf Ibn Abi Shaybah 4890","","","كتاب الصلوات"
"4891","(۴۸۹۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا افْتَتَحْت الصَّلاَۃ تَطَوُّعًا وَأُقِیمَتِ الصَّلاَۃ فَأَتِمَّ۔","","Musannaf Ibn Abi Shaybah 4891","","","كتاب الصلوات"
"4892","(۴۸۹۲) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، قَالَ : حَدَّثَنَا أَبُو إِسْحَاقَ ، قَالَ : کُنْتُ إلَی جَنْبِ عَبْدِ اللہِ بْنِ معقل ، وَہُوَ یُصَلِّی وَیَقْرَأُ فِی سُورَۃِ النُّورِ ، فَأَقَامَ الْمُؤَذِّنُ فَرَکَعَ وَسَجَدَ ، وَجَلَسَ فَتَشَہَّدَ ، ثُمَّ قَامَ مَعَ الإِمَامِ فَأَخَذَ مِنْ حَیْثُ انْتَہَی۔","","Musannaf Ibn Abi Shaybah 4892","","","كتاب الصلوات"
"4893","(۴۸۹۳) حَدَّثَنَا ابْنُ آدَمَ ، عَنْ إسْرَائِیلَ ، عَنْ بَیَانَ ، قَالَ : کَانَ قَیْسُ بْنُ أَبِی حَازِمٍ یَؤُمَّنَا ، فَأَقَامَ الْمُؤَذِّنُ الصَّلاَۃ وَقَدْ صَلَّی رَکْعَۃً ، قَالَ : فَتَرَکَہَا ، ثُمَّ تَقَدَّمَ فَصَلَّی بِنَا۔","","Musannaf Ibn Abi Shaybah 4893","","","كتاب الصلوات"
"4894","(۴۸۹۴) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرٍ ، عَنْ مَیْمُونٍ ، قَالَ : إِنْ کَبَّرْت بِالصَّلاَۃ تَطَوُّعًا قَبْلَ أَنْ یُکَبِّرَ بِالإِقَامَۃِ، فَصَلِّ رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4894","","","كتاب الصلوات"
"4895","(۴۸۹۵) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ عَطَائٍ ، قَالَ : إذَا کُنْتَ فِی الْمَسْجِدِ فَأُقِیمَتِ الصَّلاَۃ فَلاَ تَرْکَعْ ، إِلاَّ أَنْ تَکُونَ عَلَی وِتْرٍ فَتَشْفَع۔","","Musannaf Ibn Abi Shaybah 4895","","","كتاب الصلوات"
"4896","(۴۸۹۶) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ، قَالَ : کَتَبْت إلَی عُمَرَ مِنْ نَجْرَانَ : لَمْ یَجِدُوا مَکَانًا أَنْظَفَ ، وَلاَ أَجْوَدَ مِنْ بَیْعَۃٍ ؟ فَکَتَبَ : انْضَحُوہَا بِمَائٍ وَسِدْرٍ وَصَلُّوا فِیہَا۔","","Musannaf Ibn Abi Shaybah 4896","","","كتاب الصلوات"
"4897","(۴۸۹۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ یُونُسَ ، عَنِ الْحَسَنِ (ح) وَعَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، أَنَّہُمْ قَالُوا : لاَ بَأْسَ بِالصَّلاَۃ فِی الْبِیَعِ۔","","Musannaf Ibn Abi Shaybah 4897","","","كتاب الصلوات"
"4898","(۴۸۹۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، قَالَ : سَأَلْتُ عَطَائً عَنِ الصَّلاَۃ فِی الْکَنَائِسِ وَالْبِیَعِ ؟ فَلَمْ یَرَ بِہَا بَأْسًا۔","","Musannaf Ibn Abi Shaybah 4898","","","كتاب الصلوات"
"4899","(۴۸۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ (ح) وَعَن جَابِرٍ ، عَنِ الشَّعْبِیِّ ، قَالاَ : لاَ بَأْسَ بِالصَّلاَۃ فِی الْکَنِیسَۃِ وَالْبِیعَۃِ۔","","Musannaf Ibn Abi Shaybah 4899","","","كتاب الصلوات"
"4900","(۴۹۰۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، قَالَ : لاَ بَأْسَ بِالصَّلاَۃ فِی الْکَنِیسَۃِ۔","","Musannaf Ibn Abi Shaybah 4900","","","كتاب الصلوات"
"4901","(۴۹۰۱) حَدَّثَنَا مُحَمَّدُ بْنِ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَرِہَہُ ، وَأَنَّ مُحَمَّدًا لَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 4901","","","كتاب الصلوات"
"4902","(۴۹۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ خُصَیْفٍ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَرِہَ الصَّلاَۃ فِی الْکَنِیسَۃِ إذَا کَانَ فِیہَا تَصَاوِیرُ۔","Da'if","Musannaf Ibn Abi Shaybah 4902","","","كتاب الصلوات"
"4903","(۴۹۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عُثْمَانَ بْنِ أَبِی ہِنْدٍ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَؤُمُّ النَّاسَ فَوْقَ کَنِیسَۃٍ ، وَالنَّاسُ أَسْفَلُ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 4903","","","كتاب الصلوات"
"4904","(۴۹۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ رَافِعٍ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَؤُمُّ النَّاسَ فِی کَنِیسَۃٍ بِالشَّامِ۔","","Musannaf Ibn Abi Shaybah 4904","","","كتاب الصلوات"
"4905","(۴۹۰۵) حَدَّثَنَا مُلاَزِمُ بْنُ عَمْرٍو ، عَنْ عَبْدِ اللہِ بْنِ بَدْرٍ ، عَنْ قَیْسِ بْنِ طَلْقٍ ، عَنْ أَبِیہِ طَلْقِ بْنِ عَلِیٍّ ، قَالَ : خَرَجْنَا وَفْدًا إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَخْبَرْنَاہُ أَنَّ بِأَرْضِنَا بِیَعَۃً لَنَا ، فَاسْتَوْہَبْنَاہُ فَضْلَ طَہُورِہِ ، فَدَعَا بِمَائٍ فَتَوَضَّأَ ثُمَّ تَمَضْمَضَ ، ثُمَّ جَعَلَہُ لَنَا فِی إدَاوَۃٍ ، فَقَالَ : اخْرُجُوا بِہِ مَعَکُمْ ، فَإِذَا قَدِمْتُمْ بَلَدَکُمْ فَاکْسِرُوا بِیَعَتَکُمْ ، وَانْضَحُوا مَکَانَہَا بِالْمَائِ ، وَاتَّخِذُوہَا مَسْجِدًا۔ (احمد ۴/۲۳۔ ابن حبان ۱۶۰۲)","Hasan","Musannaf Ibn Abi Shaybah 4905","","","كتاب الصلوات"
"4906","(۴۹۰۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو فَضَالَۃَ ، قَالَ : حَدَّثَنَا أَزْہَرُ الحَرَازی ؛ أَنَّ أَبَا مُوسَی صَلَّی فِی کَنِیسَۃٍ بِدِمَشْقَ ، یُقَالُ لَہَا : کَنِیسَۃُ یُحَنَّا۔","Da'if","Musannaf Ibn Abi Shaybah 4906","","","كتاب الصلوات"
"4907","(۴۹۰۷) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَعْتَمِدَ الرَّجُلُ عَلَی الْحَائِطِ فِی صَلاَۃ الْمَکْتُوبَۃِ ، إِلاَّ مِنْ عِلَّۃٍ ، وَلَمْ یَرَ بِہِ فِی التَّطَوُّعِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 4907","","","كتاب الصلوات"
"4908","(۴۹۰۸) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَتَسَانَدَ الرَّجُلُ عَلَی الْحَائِطِ فِی الصَّلاَۃ ، وَکَانَ یَکْرَہُ رَفْعَ رِجْلَیْہِ إِلاَّ مِنْ عِلَّۃٍ۔","","Musannaf Ibn Abi Shaybah 4908","","","كتاب الصلوات"
"4909","(۴۹۰۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یَکْرَہُ أَنْ یَرْفَعَ إحْدَی رِجْلَیْہِ عَلَی الأُخْرَی فِی الصَّلاَۃ ، وَیُسند إلَی جِدَارٍ إِلاَّ مِنْ عِلَّۃٍ۔","","Musannaf Ibn Abi Shaybah 4909","","","كتاب الصلوات"
"4910","(۴۹۱۰) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ حَمَّادٍ ، عَنْ مُجَاہِدٍ ، قَالَ : یَنْقُصُ مِنْ أَجْرِہِ بِقَدْرِ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 4910","","","كتاب الصلوات"
"4911","(۴۹۱۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ حَمَّادٍ ، عَنْ مُجَاہِدٍ ؛ فِی الرَّجُلِ یُصَلِّی فَیَتَوَکَّأُ عَلَی الْحَائِطِ ، قَالَ : یَنْقُصُ مِنْ صَلاَتِہِ بِقَدْرِ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 4911","","","كتاب الصلوات"
"4912","(۴۹۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ بَأْسَ أَنْ یَعْتَمِدَ عَلَی الْحَائِطِ۔","","Musannaf Ibn Abi Shaybah 4912","","","كتاب الصلوات"
"4913","(۴۹۱۳) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَرِہَ أَنْ یَعْتَمِدَ الرَّجُلُ عَلَی شَیْئٍ فِی الْفَرِیضَۃِ إِلاَّ مِنْ عِلَّۃٍ ، وَکَانَ لاَ یَرَی بِہِ بَأْسًا فِی التَّطَوُّعِ ۔ وَکَانَ ابْنُ سِیرِینَ یَکْرَہُ فِی الْفَرِیضَۃِ وَالتَّطَوُّعِ۔","","Musannaf Ibn Abi Shaybah 4913","","","كتاب الصلوات"
"4914","(۴۹۱۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الْمُطْعِمِ بْنِ الْمِقْدَامِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا خَلَفَ عَبْدٌ عَلَی أَہْلِہِ أَفْضَلَ مِنْ رَکْعَتَیْنِ یَرْکَعُہُمَا عِنْدَہُمْ حِینَ یُرِیدُ سَفَرًا۔","Hasan","Musannaf Ibn Abi Shaybah 4914","","","كتاب الصلوات"
"4915","(۴۹۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا خَرَجْت فَصَلِّ رَکْعَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 4915","","","كتاب الصلوات"
"4916","(۴۹۱۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ إذَا أَرَادَ أَنْ یَخْرُجَ دَخَلَ الْمَسْجِدَ فَصَلَّی۔","Sahih","Musannaf Ibn Abi Shaybah 4916","","","كتاب الصلوات"
"4917","(۴۹۱۷) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : رَأَیْتُ الْحَارِثَ بْنَ أَبِی رَبِیعَۃَ صَلَّی حِینَ أَرَادَ أَنْ یَخْرُجَ إلَی بَاجُمَیْرا فِی الْحُجْرَۃِ ضُحًی رَکْعَتَیْنِ ، وَصَلَّی مَعَہُ نَفَرٌ مِنْہُمَ الأَسْوَدُ بْنُ یَزِیدَ۔","","Musannaf Ibn Abi Shaybah 4917","","","كتاب الصلوات"
"4918","(۴۹۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنْ مُعَاذِ بْنِ عَبْدِ اللہِ بْنِ خبیب ، عَنْ جَابِرٍ ، قَالَ : لَمَّا قَدِمْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لِی : یَا جَابِرُ ، ہَلْ صَلَّیْت ؟ قُلْتُ : لاَ ، قَالَ : فَصَلِّ رَکْعَتَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 4918","","","كتاب الصلوات"
"4919","(۴۹۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ کَامِلٍ أَبِی الْعَلاَئِ ، عَنْ أَبِی صَالِحٍ ؛ أَنَّ عُثْمَانَ کَانَ إذَا قَدِمَ مِنْ سَفَرٍ صَلَّی رَکْعَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 4919","","","كتاب الصلوات"
"4920","(۴۹۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا قَدِمْت فَصَلِّ رَکْعَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 4920","","","كتاب الصلوات"
"4921","(۴۹۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ مُقَاتِلِ بْنِ بَشِیرٍ الْعِجْلِیّ ، عَنْ رَجُلٍ یُقَالُ لَہُ : مُوسَی ؛ أَنَّ ابْنَ عَبَّاسٍ قَدِمَ مِنْ سَفَرٍ ، فَصَلَّی فِی بَیْتِہِ رَکْعَتَیْنِ عَلَی طِنْفِسَۃٍ۔","Majhul","Musannaf Ibn Abi Shaybah 4921","","","كتاب الصلوات"
"4922","(۴۹۲۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ کَعْبِ بْنِ مَالِکٍ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ لاَ یَقْدَمُ مِنْ سَفَرٍ إِلاَّ نَہَارًا فِی الضُّحَی ، فَإِذَا قَدِمَ بَدَأَ بِالْمَسْجِدِ فَصَلَّی رَکْعَتَیْنِ۔ (بخاری ۳۰۸۸۔ مسلم ۴۹۶)","Sahih","Musannaf Ibn Abi Shaybah 4922","","","كتاب الصلوات"
"4923","(۴۹۲۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ تَمِیمِ بْنِ سَلَمَۃَ ، عَنْ مَسْرُوقٍ ، قَالَ : کَانَ النَّبِیُّ علیہ الصَّلاَۃ والسلام فِی سَفَرٍ ، فَعَرَّسَ بِأَصْحَابِہِ ، فَلَمْ یُوقِظْہُمْ مَعَ تَعْرِیسِہِمْ إِلاَّ الشَّمْسُ ، فَقَامَ فَأَمَرَ الْمُؤَذِّنَ ، فأذن وَأَقَامَ ، ثُمَّ صَلَّی ، فَقَالَ مَسْرُوقٌ : مَا أُحِبُّ أَنَّ لَنَا الدُّنْیَا ، وَمَا فِیہَا بِصَلاَۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعْدَ طُلُوعِ الشَّمْسِ۔","Da'if","Musannaf Ibn Abi Shaybah 4923","","","كتاب الصلوات"
"4924","(۴۹۲۴) حَدَّثَنَا عَبیدۃ بْنُ حُمَیْدٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ تَمِیمِ بْنِ سَلَمَۃَ ، عَنْ مَسْرُوقٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ مِثْلَہُ۔ (احمد ۱/۲۵۹۔ ابو یعلی ۲۳۷۵)","Da'if","Musannaf Ibn Abi Shaybah 4924","","","كتاب الصلوات"
"4925","(۴۹۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن عَطَائِ بْنِ یَسَارٍ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَکْعَتَیِ الْفَجْرِ بَعْدَ مَا جَازَ الْوَادِیَ ، ثُمَّ أَمَرَ بِلاَلاً فَأَذَّنَ وَأَقَامَ ، ثُمَّ صَلَّی الْفَرِیضَۃَ۔","","Musannaf Ibn Abi Shaybah 4925","","","كتاب الصلوات"
"4926","(۴۹۲۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنِ الْحَسَنِ ، قَالَ : یُجْزِئُ الرَّجُلَ أَنْ یَقْضِیَ الصَّلواتِ بِإِقَامَۃٍ وَاحِدَۃٍ۔","","Musannaf Ibn Abi Shaybah 4926","","","كتاب الصلوات"
"4927","(۴۹۲۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ سِمَاکٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ ، قَالَ : سَرَیْنَا ذَاتَ لَیْلَۃٍ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَقُلْنَا : یَا رَسُولَ اللہِ ، لَوْ أمسستنا الأَرْضَ فَنِمْنَا وَرَعَتْ رِکَابُنَا ؟ قَالَ : فَمَنْ یَحْرُسُنَا ؟ قَالَ : قُلْتُ : أَنَا ، قَالَ : فَغَلَبَتْنِی عَیْنِی ، فَلَمْ یُوقِظْنَا إِلاَّ وَقْتَ طَلَعَتِ الشَّمْسُ ، وَلَمْ یَسْتَیْقِظْ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلاَّ بِکَلاَمِنَا ، قَالَ : فَأَمَرَ بِلاَلاً فَأَذَّنَ وَأَقَامَ ، فَصَلَّی بِنَا۔ (احمد ۱/۴۵۰۔ طبرانی ۱۰۳۴۹)","","Musannaf Ibn Abi Shaybah 4927","","","كتاب الصلوات"
"4928","(۴۹۲۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ لَمْ یَکُنْ یَرَی بِعَدَدِ الآیِ فِی الصَّلاَۃ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 4928","","","كتاب الصلوات"
"4929","(۴۹۲۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 4929","","","كتاب الصلوات"
"4930","(۴۹۳۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ یُسیر بْنِ عَمْرٍو ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِعَدَدِ الآیِ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4930","","","كتاب الصلوات"
"4931","(۴۹۳۱) حَدَّثَنَا عَبْدَۃُ ، وَوَکِیعٌ ، عَنْ ہِشَامٍ ؛ أَنَّ أَبَاہُ کَانَ یَعُدُّ الآیَ فِی الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 4931","","","كتاب الصلوات"
"4932","(۴۹۳۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ یَحْیَی بْنُ وَثَّابٍ یَعُدُّ الآیَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4932","","","كتاب الصلوات"
"4933","(۴۹۳۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : رَأَیْتُ طَاوُوسًا وَنَافِعًا یَعُدَّانِ الآیَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4933","","","كتاب الصلوات"
"4934","(۴۹۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ خَالِدٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ یَعُدُّ الآیَ بِشِمَالِہِ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4934","","","كتاب الصلوات"
"4935","(۴۹۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِعَدِّ الآیِ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4935","","","كتاب الصلوات"
"4936","(۴۹۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ یَحْیَی بْنِ عَتِیقٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ یَعُدُّ الآیَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4936","","","كتاب الصلوات"
"4937","(۴۹۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : رَأَیْتُ أَبَا عَبْدِ الرَّحْمَنِ یَعُدُّ الآیَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4937","","","كتاب الصلوات"
"4938","(۴۹۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، قَالَ : رَأَیْتُ ابْنَ أَبِی مُلَیْکَۃَ یَعُدُّ الآیَ فِی الصَّلاَۃ ، فَقُلْتُ لَہُ ؟ فَقَالَ : إِنَّہُ أَحْفَظُ۔","","Musannaf Ibn Abi Shaybah 4938","","","كتاب الصلوات"
"4939","(۴۹۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ یَحْیَی بْنِ عَتِیقٍ ، قَالَ : رَأَیْتُ طَاوُوسًا وَالْمُغِیرَۃَ بْنَ حَکِیمٍ الصَّنْعَانِیَّ یَعُدَّانِ الآیَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4939","","","كتاب الصلوات"
"4940","(۴۹۴۰) حَدَّثَنَا أَبُو أَیُّوبَ الْقُریعِیُّ ، قَالَ : رَأَیْتُ عِمْرَانَ بْنَ حُدَیْرٍ یَعُدُّ الآیَ فِی الصَّلاَۃ ، وَذَکَرَ أَنَّ أَبَا مِجْلَزٍ کَانَ لاَ یَرَی بِذَلِکَ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 4940","","","كتاب الصلوات"
"4941","(۴۹۴۱) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ أَنْ یَعُدَّ الآیِ فِی الصَّلاَۃ إذَا خَافَ النِّسْیَانَ۔","","Musannaf Ibn Abi Shaybah 4941","","","كتاب الصلوات"
"4942","(۴۹۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، قَالَ : رَأَیْتُ ابْنَ سِیرِینَ یَعُدُّ الآیَ فِی الْعَصْرِ۔","","Musannaf Ibn Abi Shaybah 4942","","","كتاب الصلوات"
"4943","(۴۹۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ حُرَیْثٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ بَأْسَ بِعَدِّ الآیِ فِی الْفَرِیضَۃِ۔","","Musannaf Ibn Abi Shaybah 4943","","","كتاب الصلوات"
"4944","(۴۹۴۴) حَدَّثَنَا یَحْیَی بْنُ بَشِیرٍ الْجَزَرِیُّ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِعَدِّ الآیِ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4944","","","كتاب الصلوات"
"4945","(۴۹۴۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ نَافِعِ بْنِ عُمَرَ ، قَالَ : رَأَیْتُ ابْنَ أَبِی مُلَیْکَۃَ یَعُدُّ الآیَ فِی الصَّلاَۃ ، قَالَ : وَقَالَ یَحْیَی بْنُ عَبْدِ اللہِ بْنِ صَیْفِیٍّ : ہُوَ رَأْسُ الْعِبَادَۃِ۔","","Musannaf Ibn Abi Shaybah 4945","","","كتاب الصلوات"
"4946","(۴۹۴۶) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ الْمَوْصِلِیُّ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ حَبِیبِ بْنِ أَبِی مَرْزُوقٍ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : سَأَلَہُ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ ، تَعُدُّ الآیَ فِی الصَّلاَۃ ؟ فَقَالَ : مَا أَفْعَلُ ، قَالَ : وَأَنَا أَیْضًا مَا أَفْعَلُ۔","","Musannaf Ibn Abi Shaybah 4946","","","كتاب الصلوات"
"4947","(۴۹۴۷) حَدَّثَنَا صَفْوَانُ بْنُ عِیسَی ، عَنِ الْحَارِثِ بن عَبْدِ الرَّحْمَنِ ، قَالَ : سَأَلْتُ سُلَیْمَانَ بْنَ یَسَارٍ عَنِ النَّوْمِ فِی الْمَسْجِدِ ؟ فَقَالَ : کَیْفَ تَسْأَلُونَ عَنْ ہَذَا ، وَقَدْ کَانَ أَہْلُ الصِّفَۃِ یَنَامُونَ فِیہِ وَیُصَلُّونَ فِیہِ۔","Hasan","Musannaf Ibn Abi Shaybah 4947","","","كتاب الصلوات"
"4948","(۴۹۴۸) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ یُونُسَ ، قَالَ : رَأَیْتُ ابْنَ سِیرِینَ یَنَامُ فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 4948","","","كتاب الصلوات"
"4949","(۴۹۴۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ لَہُ مَسْجِدٌ یُصَلِّی فِیہِ ، وَیَنَامُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 4949","","","كتاب الصلوات"
"4950","(۴۹۵۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کُنَّا وَنَحْنُ شَبَابٌ نَبِیتُ فِی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْمَسْجِدِ وَنَقِیلُ۔ (ترمذی ۳۲۱۔ احمد ۲/۱۲)","Sahih","Musannaf Ibn Abi Shaybah 4950","","","كتاب الصلوات"
"4951","(۴۹۵۱) حَدَّثَنَا جَرِیرٌ ، عَنْ یَزِیدَ ، عَنْ عَطَائٍ ، قَالَ : قَالَ رَجُلٌ لْاِبْنِ عَبَّاسٍ : إنِّی نِمْتُ فِی الْمَسْجِدِ الْحَرَامِ فَاحْتَلَمْت ، فَقَالَ : أَمَّا أَنْ تَتَّخِذَہُ مَبِیتًا ، أَوْ مَقِیلاً فَلاَ ، وَأَمَّا أَنْ تَنَامَ تَسْتَرِیحَ ، أَوْ تَنْتَظِرَ حَاجَۃً فَلاَ بَأْسَ۔","Da'if","Musannaf Ibn Abi Shaybah 4951","","","كتاب الصلوات"
"4952","(۴۹۵۲) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ، عَنْ لَیْثٍ، عَنْ عَطَائٍ، وَطَاوُوس، وَمُجَاہِدٍ؛ أَنَّہُمْ کَرِہُوا النَّوْمَ فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 4952","","","كتاب الصلوات"
"4953","(۴۹۵۳) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : أَتَکْرَہُ النَّوْمَ فِی الْمَسْجِدِ؟ قَالَ: بَلْ أُحِبُّہُ۔","","Musannaf Ibn Abi Shaybah 4953","","","كتاب الصلوات"
"4954","(۴۹۵۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی الْہَیْثُمِ ، قَالَ : نَہَانِی مُجَاہِدٌ عَنِ النَّوْمِ فِی الْمَسَاجِدِ۔","","Musannaf Ibn Abi Shaybah 4954","","","كتاب الصلوات"
"4955","(۴۹۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أَیْمَنِ بْنِ نَابِلٍ ، قَالَ : رَآنِی سَعِیدُ بْنُ جُبَیْرٍ وَأَنَا نَائِمٌ فِی الْحِجْرِ فَأَیْقَظَنِی ، وَقَالَ : مِثْلُک یَنَامُ ہَاہُنَا ؟۔","","Musannaf Ibn Abi Shaybah 4955","","","كتاب الصلوات"
"4956","(۴۹۵۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، قَالَ : رَأَیْتُ ابْنَ مَسْعُودٍ یَعُسُّ فِی الْمَسْجِدِ لَیْلاً ، فَلاَ یَدَعُ سَوَادًا إِلاَّ أَخْرَجَہُ ، إِلاَّ رَجُلاً یُصَلِّی۔","Sahih","Musannaf Ibn Abi Shaybah 4956","","","كتاب الصلوات"
"4957","(۴۹۵۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُغِیرَۃُ بْنُ زِیَادٍ ، قَالَ : کُنْتُ أَنام فِی الْمَسْجِدِ الْحَرَامِ ، فَأَحْتَلِمُ فِی اللَّیْلَۃ مِرَارًا ، فَسَأَلْت عَطَائً ؟ فَقَالَ : نَمْ وَإِنِ احْتَلَمْتَ عَشْرَ مَرَّاتٍ۔","","Musannaf Ibn Abi Shaybah 4957","","","كتاب الصلوات"
"4958","(۴۹۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ إسْمَاعِیلَ بْنِ أمیۃ ، عَنِ الْمُغِیرَۃِ بْنِ حَکِیمٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّہُ سُئِلَ عَنِ النَّوْمِ فِی الْمَسْجِدِ ؟ فَقَالَ : أَیْنَ کَانَ أَہْلُ الصُّفَّۃِ ؟ یَعْنِی یَنَامُونَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 4958","","","كتاب الصلوات"
"4959","(۴۹۵۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، قَالَ نِمْتُ فِی الْمَسْجِدِ الْحَرَامِ فَاحْتَلَمْتُ فِیہِ، فَسَأَلْت سَعِیدَ بْنَ جُبَیْرٍ ؟ فَقَالَ : اذْہَبْ وَاغْتَسِلْ ، یَعْنِی ، وَلَمْ یَنْہَہُ۔","","Musannaf Ibn Abi Shaybah 4959","","","كتاب الصلوات"
"4960","(۴۹۶۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ بِتُّ ذَاتَ لَیْلَۃٍ عِنْدَ مَیْمُونَۃَ بِنْتِ الْحَارِثِ ، فَقَامَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی مِنَ اللَّیْلِ ، فَقُمْتُ عَنْ یَسَارِہِ فَأَخَذَ بِذُؤَابَۃٍ کَانَتْ لِی ، أَوْ بِرَأْسِی فَأَقَامَنِی عَنْ یَمِینِہِ۔ (بخاری ۱۱۷۔ احمد ۱/۲۱۵)","Sahih","Musannaf Ibn Abi Shaybah 4960","","","كتاب الصلوات"
"4961","(۴۹۶۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْمُخْتَارِ ، عَنْ مُوسَی بْنِ أَنَسٍ ، عَنْ أَنَسٍ ، قَالَ : أَتَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یُصَلِّی فَأَقَامَنِی عَنْ یَمِینِہِ۔ (مسلم ۲۶۹۔ احمد ۳/۱۹۴)","Sahih","Musannaf Ibn Abi Shaybah 4961","","","كتاب الصلوات"
"4962","(۴۹۶۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ شُرَحْبِیلَ ، عَنْ جَابِرٍ ، قَالَ : صَلَّیْت مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَقَامَنِی عَنْ یَمِینِہِ۔ (ابن ماجہ ۹۷۳۔ احمد ۳/۳۲۶)","Hasan","Musannaf Ibn Abi Shaybah 4962","","","كتاب الصلوات"
"4963","(۴۹۶۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ ، عَنْ أَبِیہِ ، قَالَ : أَتَیْتُ عُمَرَ وَہُوَ یُصَلِّی ، فَقُمْتُ عَنْ شِمَالِہِ ، فَجَعَلَنِی عَنْ یَمِینِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4963","","","كتاب الصلوات"
"4964","(۴۹۶۴) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ حُمَیْدٍ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ ، قَالَ : صَلَّیْتُ مَعَہُ فَأَقَامَنِی عَنْ یَمِینِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4964","","","كتاب الصلوات"
"4965","(۴۹۶۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَر ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ قَامَ رَجُلٌ یُصَلِّی عَنْ یَسَارِہِ ، فَحَوَّلَہُ عن یَمِینِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4965","","","كتاب الصلوات"
"4966","(۴۹۶۶) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ ابْنُ عَبَّاسٍ إذَا صَلَّی مَعَہُ رَجُلٌ ، أَقَامَہُ عَنْ یَمِینِہِ۔","","Musannaf Ibn Abi Shaybah 4966","","","كتاب الصلوات"
"4967","(۴۹۶۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ ، دَخَلْتُ مَعَ مَکْحُولٍ مَسْجِدَ دِمَشْقَ وَقَدْ صَلَّی أَہْلُہُ ، فَأَقَامَنِی عَنْ یَمِینِہِ فَصَلَّیْتُ بِصَلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 4967","","","كتاب الصلوات"
"4968","(۴۹۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُقِیمُہُ عَنْ یَمِینِہِ۔","","Musannaf Ibn Abi Shaybah 4968","","","كتاب الصلوات"
"4969","(۴۹۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ کَانَ إذَا قَامَ مَعَہُ رَجُلٌ ، أَقَامَہُ عَنْ یَمِینِہِ۔","","Musannaf Ibn Abi Shaybah 4969","","","كتاب الصلوات"
"4970","(۴۹۷۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، قَالَ : جِئْتُ إلی عُرْوَۃَ وَہُوَ یُصَلِّی ، فَأَقَامَنِی عَنْ یَمِینِہِ۔","","Musannaf Ibn Abi Shaybah 4970","","","كتاب الصلوات"
"4971","(۴۹۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، قَالَ : سَأَلْتُ عَنْہُ سَعِیدَ بْنَ الْمُسَیَّبِ ، فَقَالَ : یُقِیمُہُ عَنْ یَسَارِہِ۔","","Musannaf Ibn Abi Shaybah 4971","","","كتاب الصلوات"
"4972","(۴۹۷۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ ہَارُونَ بْنِ عَنْتَرَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ : اسْتَأْذَنَ عَلْقَمَۃُ وَالأَسْوَدُ عَلَی عَبْدِ اللہِ فَأَذِنَ لَہُمَا ، وَقَالَ : إِنَّہُ سَیَکُونُ أُمَرَائُ یَشْغَلُونَ عَنْ وَقْتِ الصَّلاَۃ ، فَصَلُّوہَا لِوَقْتِہَا ، ثُمَّ قَامَ فصلی بَیْنِی وَبَیْنَہُ ، وَقَالَ : ہَکَذَا رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَعَلَ۔","","Musannaf Ibn Abi Shaybah 4972","","","كتاب الصلوات"
"4973","(۴۹۷۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہَارُونَ بْنِ عَنْتَرَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ عَلْقَمَۃَ ، وَالأَسْوَدِ ، عَنْ عَبْدِ اللہِ ؛ رَفَعَہُ ، مِثْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4973","","","كتاب الصلوات"
"4974","(۴۹۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ قَالَ : إذَا کَانُوا ثَلاَثَۃً تَقَدَّمَہُمْ أَحَدُہُمْ وَتَأَخَّرَ اثْنَانِ۔","","Musannaf Ibn Abi Shaybah 4974","","","كتاب الصلوات"
"4975","(۴۹۷۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ إذَا صَلَّی ثَالِثُ ثَلاَثَۃٍ جَعَلَ اثْنَیْنِ خَلْفَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 4975","","","كتاب الصلوات"
"4976","(۴۹۷۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ إذَا صَلَّی مَعَہُ الرَّجُلاَنِ خَلَفَہُمَا خَلْفَہُ۔","","Musannaf Ibn Abi Shaybah 4976","","","كتاب الصلوات"
"4977","(۴۹۷۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا کَانُوا ثَلاَثَۃً تَقَدَّمَہُمْ أَحَدُہُمْ۔","","Musannaf Ibn Abi Shaybah 4977","","","كتاب الصلوات"
"4978","(۴۹۷۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ زَکَرِیَّا ، عَنْ عَامِرٍ ، قَالَ : إذَا کَانَ الْقَوْمُ ثَلاَثَۃً سِوَی الإِمَام ، تَقَدَّمَہُمْ أَحَدُہُمْ۔","","Musannaf Ibn Abi Shaybah 4978","","","كتاب الصلوات"
"4979","(۴۹۷۹) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، قَالَ : صَلَّیْتُ أَنَا وَرَجُلٌ مَعَ مُجَاہِدٍ ، فَأَقَامَ أَحَدَنَا عَنْ یَمِینِہِ ، وَالآَخَر عَنْ یَسَارِہِ ، وَقَالَ : ہَکَذَا یَصْنَعُ الثَّلاَثَۃُ۔","","Musannaf Ibn Abi Shaybah 4979","","","كتاب الصلوات"
"4980","(۴۹۸۰) حَدَّثَنَا ابن عُیَیْنَۃُ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ ، عَنْ أَبِیہِ ، قَالَ : أَتَیْتُ عُمَرَ وَہُوَ یُصَلِّی بِالْہَاجِرَۃِ ، فَقُمْت عَنْ شِمَالِہِ فَجَعَلَنِی عَنْ یَمِینِہِ ، فَجَائَ یَرْفَأ فَتَأَخَّرْنَا فصرنا اثْنَیْنِ خَلْفَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4980","","","كتاب الصلوات"
"4981","(۴۹۸۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ (ح) وَعَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ ، قَالُوا : إذَا کَانُوا ثَلاَثَۃً تَقَدَّمَہُمْ أَحَدُہُمْ وَصَلَّی اثْنَانِ خَلْفَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4981","","","كتاب الصلوات"
"4982","(۴۹۸۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ ، قَالَ : جِئْت إلَی عُمَرَ وَہُوَ یُصَلِّی فَجَعَلَنِی عَنْ یَمِینِہِ ، فَجَائَ یَرْفَأُ فَجَعَلَنَا خَلْفَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 4982","","","كتاب الصلوات"
"4983","(۴۹۸۳) حَدَّثَنَا أَبُو نُعَیْمٍ ، قَالَ: حدَّثَنَا نُصَیْرُ بْنُ أَبِی الأَشْعَثِ ، عَنْ حَمَّادِ بْنِ خُوَارٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ، عَنِ النَّزَّالِ بْنِ سَبْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : إذَا کَانُوا ثَلاَثَۃً تَقَدَّمَہم أَحَدُہُمْ۔","Majhul","Musannaf Ibn Abi Shaybah 4983","","","كتاب الصلوات"
"4984","(۴۹۸۴) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْمُخْتَارِ ، عَنْ مُوسَی بْنِ أَنَسٍ ، عَنْ أَنَسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی بِہِمْ وَامْرَأَۃٍ مِنْ أَہْلِہِ ، فَجَعَلَ أَنَسًا عَنْ یَمِینِہِ وَالْمَرْأَۃَ خَلْفَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4984","","","كتاب الصلوات"
"4985","(۴۹۸۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُمَیْدٍ، عَنْ ثَابِتٍ، قَالَ: صَلَّیْتُ مَعَ أَنَسٍ فَقُمْتُ عَنْ یَمِینِہِ ، وَقَامَتْ أُمُّ وَلَدِہِ خَلْفَنَا۔","Sahih","Musannaf Ibn Abi Shaybah 4985","","","كتاب الصلوات"
"4986","(۴۹۸۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، قَالَ : جِئْت إلَی عُرْوَۃَ وَہُوَ یُصَلِّی وَخَلْفَہُ امْرَأَۃٌ ، فَأَقَامَنِی عَنْ یَمِینِہِ وَالْمَرْأَۃَ خَلْفَہُ۔","","Musannaf Ibn Abi Shaybah 4986","","","كتاب الصلوات"
"4987","(۴۹۸۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ، قَالَ : إذَا کَانَ الإِمَام مَعَہُ رَجُلٌ وَاحِدٌ وَامْرَأَۃٌ ، فَلْیَقُومُوا مُتَوَاتِرَیْنِ۔","","Musannaf Ibn Abi Shaybah 4987","","","كتاب الصلوات"
"4988","(۴۹۸۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمَّارٍ الدُّہْنِیِّ ، عَنِ امْرَأَۃٍ مِنْ قَوْمِہِ اسْمُہَا حُجَیْرَۃُ ، قَالَتْ أَمَّتْنَا أُمُّ سَلَمَۃَ قَائِمَۃً وَسَطَ النِّسَائِ۔","Majhul","Musannaf Ibn Abi Shaybah 4988","","","كتاب الصلوات"
"4989","(۴۹۸۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أُمِّ الْحَسَنِ ؛ أَنَّہَا رَأَتْ أُمَّ سَلَمَۃَ زَوْجَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَؤُمُّ النِّسَائَ ، تَقُومُ مَعَہُنَّ فِی صَفِّہِنَّ۔","Hasan","Musannaf Ibn Abi Shaybah 4989","","","كتاب الصلوات"
"4990","(۴۹۹۰) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَانَتْ تَؤُمُّ النِّسَائَ فِی الْفَرِیضَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 4990","","","كتاب الصلوات"
"4991","(۴۹۹۱) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَانَتْ تَؤُمُّ النِّسَائَ ، تقوم مَعَہُنَّ فِی الصَّفِّ۔","Da'if","Musannaf Ibn Abi Shaybah 4991","","","كتاب الصلوات"
"4992","(۴۹۹۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ (ح) وَمُغِیرَۃُ ، عَنْ إبْرَاہِیمَ (ح) وَحُصَیْنٌ ، عَنِ الشَّعْبِیِّ ، قَالَ : تَؤُمُّ الْمَرْأَۃُ النِّسَائَ فِی صَلاَۃِ رَمَضَانَ ، تَقُومُ مَعَہُنَّ فِی صَفِّہِنَّ۔","","Musannaf Ibn Abi Shaybah 4992","","","كتاب الصلوات"
"4993","(۴۹۹۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حُرَیْثٍ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّہُ قَالَ : لاَ بَأْسَ أَنْ تَؤُمَّ الْمَرْأَۃُ النِّسَائَ ، تَقُومُ مَعَہُنَّ فِی الصَّفِّ۔","","Musannaf Ibn Abi Shaybah 4993","","","كتاب الصلوات"
"4994","(۴۹۹۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ مَوْلًی لِبَنِی ہَاشِمٍ ، عَنْ عَلِیٍّ ، قَالَ : لاَ تَؤُمُّ الْمَرْأَۃُ۔","Majhul","Musannaf Ibn Abi Shaybah 4994","","","كتاب الصلوات"
"4995","(۴۹۹۵) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَتَبْتُ إلَی نَافِعٍ أَسْأَلُہُ ، أَتَؤُمُّ الْمَرْأَۃُ النِّسَائَ ؟ فَقَالَ: لاَ أَعْلَمُ الْمَرْأَۃَ تَؤُمُّ النِّسَائَ۔","","Musannaf Ibn Abi Shaybah 4995","","","كتاب الصلوات"
"4996","(۴۹۹۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عمرو ، قَالَ : أَخْبَرَنِی مَنْ رَأَی جَابِرَ بْنَ زَیْدٍ یُومِیئُ فِی مَایئٍ وَطِینٍ۔","","Musannaf Ibn Abi Shaybah 4996","","","كتاب الصلوات"
"4997","(۴۹۹۷) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : إذَا کَانَ فِی مَائٍ وَطِینٍ أَوْمَأَ إیمَائً۔","","Musannaf Ibn Abi Shaybah 4997","","","كتاب الصلوات"
"4998","(۴۹۹۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ عَامِرٍ ، قَالَ : الَّذِی فِی الْمَائِ وَالطِّینِ یُومِئُ إیمَائً۔","","Musannaf Ibn Abi Shaybah 4998","","","كتاب الصلوات"
"4999","(۴۹۹۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ، قَالَ: إذَا کُنْتَ فِی مَائٍ ، أَوْ سَبْخَۃٍ ، فَأَوْمِیئْ إیمَائً۔","","Musannaf Ibn Abi Shaybah 4999","","","كتاب الصلوات"
"5000","(۵۰۰۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ؛ فِی الرَّجُلِ تُدْرِکُہُ الصَّلاَۃ فِی الْمَائِ وَالطِّینِ ، قَالَ : یُومِیئُ إیمَائً ، وَیَجْعَلُ السُّجُودَ أَخْفَضَ مِنَ الرُّکُوعِ۔","","Musannaf Ibn Abi Shaybah 5000","","","كتاب الصلوات"
"5001","(۵۰۰۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ، قَالَ: رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْجُدُ فِی الْمَائِ وَالطِّینِ۔ (بخاری ۶۶۹۔ مسلم ۸۲۶)","Sahih","Musannaf Ibn Abi Shaybah 5001","","","كتاب الصلوات"
"5002","(۵۰۰۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، قَالَ : أَقْبَلْت مَعَ أَنَسِ بْنِ مَالِکٍ مِنَ الْکُوفَۃِ ، حَتَّی إذَا کُنَّا بِأَطَطٍ وَقَدْ أَخَذَتْنَا السَّمَائُ قَبْلَ ذَلِکَ ، وَالأَرْضُ ضَحْضَاحٌ ، فَصَلَّی أَنَسٌ وَہُوَ عَلَی حِمَارٍ مُسْتَقْبِلَ الْقِبْلَۃِ ، وَأَوْمَأَ إیمَائً ، وَجَعَلَ السُّجُودَ أَخْفَضَ مِنَ الرُّکُوعِ۔","Sahih","Musannaf Ibn Abi Shaybah 5002","","","كتاب الصلوات"
"5003","(۵۰۰۳) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُبَیْدِ اللہِ ، عَنْ سَالِمٍ ، وَعَامِرٍ ، قَالاَ : إذَا کُنْتَ فِی مَائٍ وَطِینٍ لاَ تَجِدُ مَکَانًا تَسْجُدُ عَلَیْہِ ، فَأَوْمِیئْ بِرَأْسِکَ إیمَائً۔","","Musannaf Ibn Abi Shaybah 5003","","","كتاب الصلوات"
"5004","(۵۰۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ غَالِبِ بْنِ سُلَیْمَانَ ، عَنْ رَجُلٍ مِنْ حُدَّان ، عَنْ جَابِرِ بْنِ زَیْدٍ ؛ أَنَّہُ وَقَعَ فِی مَائٍ وَطِینٍ فَجَعَلَ یَرْکَعُ ، فَإِذَا أَرَادَ أَنْ یَسْجُدَ أَوْمَأَ ، فَقُلْتُ لَہُ ؟ فَقَالَ : یَا أَحْمَقُ ، أَتُرِیدُ أَنْ أُفْسِدَ ثِیَابِی؟","","Musannaf Ibn Abi Shaybah 5004","","","كتاب الصلوات"
"5005","(۵۰۰۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مَعْمَرٍ ، عَنْ یَحْیَی ، عَنْ ضَمْضَمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ بِقَتْلِ الأَسْوَدَیْنِ فِی الصَّلاَۃ ، الْحَیَّۃِ وَالْعَقْرَبِ۔ (ابن ماجہ ۱۲۴۵۔ احمد ۲/۲۴۸)","Sahih","Musannaf Ibn Abi Shaybah 5005","","","كتاب الصلوات"
"5006","(۵۰۰۶) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ بُرْدٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، قَالَ : رَأَی نَبِیُّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلاً یُصَلِّی جَالِسًا ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لِمَ تُصَلِّی جَالِسًا ؟ فَقَالَ : إنَّ عَقْرَبًا لَسَعَتْنِی ، قَالَ : فَإِذَا رَأَی أَحَدُکُمْ عَقْرَبًا ، وَإِنْ کَانَ فِی الصَّلاَۃ ، فَلْیَأْخُذْ نَعْلَہُ الْیُسْرَی ، فَلْیَقْتُلْہَا بِہَا۔","","Musannaf Ibn Abi Shaybah 5006","","","كتاب الصلوات"
"5007","(۵۰۰۷) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنِ ابْنِ أَبِی لَیْلَی ؛ أَنَّ عَلِیًّا قَتَلَہَا وَہُوَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 5007","","","كتاب الصلوات"
"5008","(۵۰۰۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ؛ رَأَی ابْنُ عُمَرَ رِیشَۃً وَہُوَ یُصَلِّی ، فَحَسِبَ أَنَّہَا عَقْرَبٌ ، فَضَرَبَہَا بِنَعْلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 5008","","","كتاب الصلوات"
"5009","(۵۰۰۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ شعبۃ ، عَنْ أَبِی الْعَالِیَۃِ ؛ أَنَّہُ قَتَلَہَا وَہُوَ یُصَلِّی۔","","Musannaf Ibn Abi Shaybah 5009","","","كتاب الصلوات"
"5010","(۵۰۱۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِقَتْلِہَا وَہُوَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 5010","","","كتاب الصلوات"
