hadiths[48]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"2961","(حديث موقوف) أَخْبَرَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا وُهَيْبٌ، حَدَّثَنَا يُونُسُ، عَنْ الْحَسَنِ: أَنَّ زَيْدًا كَانَ يُشَرِّكُ الْجَدَّ مَعَ الْإِخْوَةِ إِلَى الثُّلُثِ"".""","Hasan","Sunan al-Darimi 2961","","","16. دادا کے بارے میں سیدنا زید بن ثابت رضی اللہ عنہ کی رائے کا بیان"
"2962","(حديث موقوف) حَدَّثَنَا عُمَرُ بْنُ حَفْصِ بْنِ غِيَاثٍ، حَدَّثَنَا أَبِي، حَدَّثَنَا الْأَعْمَشُ، عَنْ إِبْرَاهِيمَ، عَنْ زَيْدِ بْنِ ثَابِتٍ: أَنَّهُ كَانَ يُقَاسِمُ بِالْجَدِّ مَعَ الْإِخْوَةِ إِلَى الثُّلُثِ، ثُمَّ لَا يُنْقِصُهُ"".""","Sahih","Sunan al-Darimi 2962","","","16. دادا کے بارے میں سیدنا زید بن ثابت رضی اللہ عنہ کی رائے کا بیان"
"2963","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا سَعِيدُ بْنُ الْمُغِيرَةِ، عَنْ عِيسَى بْنِ يُونُسَ، عَنْ إِسْمَاعِيل، قَالَ: قَالَ عَامِرٌ: خُذْ مِنْ أَمْرِ الْجَدِّ مَا اجْتَمَعَ النَّاسُ عَلَيْهِ، قَالَ أَبُو مُحَمَّدٍ: يَعْنِي قَوْلَ زَيْدٍ.""","Sahih","Sunan al-Darimi 2963","","","16. دادا کے بارے میں سیدنا زید بن ثابت رضی اللہ عنہ کی رائے کا بیان"
"2964","(حديث موقوف) أَخْبَرَنَا سَعِيدُ بْنُ عَامِرٍ، عَنْ هَمَّامٍ، عَنْ قَتَادَةَ: أَنَّ زَيْدَ بْنَ ثَابِتٍ قَالَ فِي أُخْتٍ، وَأُمٍّ، ٍّوَزَوْجٍ، وَجَدٍّ، قَالَ: جَعَلَهَا مِنْ سَبْعٍ وَعِشْرِينَ: لِلْأُمِّ سِتَّةٌ، وَلِلزَّوْجِ تِسْعَةٌ، وَلِلْجَدِّ ثَمَانِيَةٌ، وَلِلْأُخْتِ أَرْبَعَةٌ.""","Sahih","Sunan al-Darimi 2964","","","17. اکدریہ: شوہر، حقیقی بہن، دادا اور ماں کا بیان"
"2965","(حديث مرفوع) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، حَدَّثَنَا الْأَشْعَثُ، عَنْ ابْنِ سِيرِينَ، عَنْ ابْنِ مَسْعُودٍ، قَالَ: إِنَّ أَوَّلَ جَدَّةٍ أُطْعِمَتْ فِي الْإِسْلَامِ سَهْمًا أَمُّ أَبٍ، وَابْنُهَا حَيٌّ.""","Da'if","Sunan al-Darimi 2965","","","18. دادیوں کا بیان"
"2966","(حديث مرفوع) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا شَرِيكٌ، عَنْ لَيْثٍ، عَنْ طَاوُسٍ، عَنْ ابْنِ عَبَّاسٍ:أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَطْعَمَ جَدَّةً سُدُسًا"".""","Da'if","Sunan al-Darimi 2966","","","18. دادیوں کا بیان"
"2967","(حديث موقوف) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا سُفْيَانُ، عَنْ ابْنِ جُرَيْجٍ، عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ: أَنَّ عُمَرَ وَرَّثَ جَدَّةً مَعَ ابْنِهَا"".""","Da'if","Sunan al-Darimi 2967","","","18. دادیوں کا بیان"
"2968","(حديث مرفوع) حَدَّثَنَا حَجَّاجُ بْنُ مِنْهَالٍ، حَدَّثَنَا شُعْبَةُ، أَخْبَرَنِي مَنْصُورُ بْنُ الْمُعْتَمِرِ، قَالَ: سَمِعْتُ إِبْرَاهِيمَ، قَالَ: أَطْعَمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ثَلَاثَ جَدَّاتٍ سُدُسًا. قَالَ: قُلْتُ لِإِبْرَاهِيمَ: مَنْ هُنَّهْ؟ قَالَ: جَدَّتَاكَ مِنْ قِبَلِ أَبِيكَ، وَجَدَّتُكَ مِنْ قِبَلِ أُمِّكَ"".""","","Sunan al-Darimi 2968","","","18. دادیوں کا بیان"
"2969","(حديث موقوف) حَدَّثَنَا حَجَّاجُ بْنُ مِنْهَالٍ، حَدَّثَنَا يَزِيدُ بْنُ إِبْرَاهِيمَ، قَالَ: أَنْبَأَنِي الْحَسَنُ، قَالَ: تَرِثُ الْجِدَّةُ وَابْنُهَا حَيٌّ"".""","Hasan","Sunan al-Darimi 2969","","","18. دادیوں کا بیان"
"2970","(حديث مقطوع) حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، عَنْ دَاوُدَ، عَنِ الشَّعْبِيِّ، قَالَ: لَا تَرِثُ أُمُّ أَبِ الْأُمِّ، ابْنُهَا الَّذِي تُدْلِي بِهِ لَا يَرِثُ، فَكَيْفَ تَرِثُ هِيَ؟"".""","Sahih","Sunan al-Darimi 2970","","","18. دادیوں کا بیان"
"2971","(حديث موقوف) أَخْبَرَنَا أَبُو مَعْمَرٍ، عَنْ إِسْمَاعِيل بْنِ عُلَيَّةَ، عَنْ سَلَمَةَ بْنِ عَلْقَمَةَ، عَنْ حُمَيْدِ بْنِ هِلَالٍ، عَنْ أَبِي الدَّهْمَاءِ، عَنْ عِمْرَانَ بْنِ حُصَيْنٍ، قَالَ: تَرِثُ الْجِدَّةُ وَابْنُهَا حَيٌّ"".""","Sahih","Sunan al-Darimi 2971","","","18. دادیوں کا بیان"
"2972","(حديث مرفوع) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، أَنْبَأَنَا الْأَشْعَثُ، عَنْ الزُّهْرِيِّ، قَالَ: جَاءَتْ إِلَى أَبِي بَكْرٍ جَدَّةٌ أُمُّ أَبٍ، أَوْ أُمُّ أُمٍّ، فَقَالَتْ: إِنَّ ابْنَ ابْنِي أَوْ ابْنَ ابْنَتِي تُوُفِّيَ، وَبَلَغَنِي أَنَّ لِي نَصِيبًا، فَمَا لِي؟ فَقَالَ أَبُو بَكْرٍ: مَا سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ فِيهَا شَيْئًا، وَسَأَسْأَلُ النَّاسَ، فَلَمَّا صَلَّى الظُّهْر، قَالَ: أَيُّكُمْ سَمِعَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ فِي الْجَدَّةِ شَيْئًا؟ فَقَالَ الْمُغِيرَةُ بْنُ شُعْبَةَ: أَنَا، قَالَ: مَاذَا؟ قَالَ: أَعْطَاهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سُدُسًا، قَالَ: أَيَعْلَمُ ذَاكَ أَحَدٌ غَيْرُكَ؟ فَقَالَ مُحَمَّدُ بْنُ مَسْلَمَةَ: صَدَقَ، فَأَعْطَاهَا أَبُو بَكْرٍ السُّدُسَ، فَجَاءَتْ إِلَى عُمَرَ مِثْلُهَا، فَقَال: مَا أَدْرِي، مَا سَمِعْتُ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيهَا شَيْئًا، وَسَأَسْأَلُ النَّاسَ، فَحَدَّثُوهُ بِحَدِيثِ الْمُغِيرَةِ بْنِ شُعْبَةَ، وَمُحَمَّدِ بْنِ مَسْلَمَةَ، فَقَالَ عُمَرُ: أَيُّكُمَا خَلَتْ بِهِ فَلَهَا السُّدُسُ، فَإِنْ اجْتَمَعْتُمَا، فَهُوَ بَيْنَكُمَا.","Da'if","Sunan al-Darimi 2972","","","19. جدات کے بارے میں سیدنا ابوبکر رضی اللہ عنہ کی رائے کا بیان"
"2973","(حديث موقوف) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، حَدَّثَنَا الْأَشْعَثُ، عَنْ الشَّعْبِيِّ، عَنْ عَلِيٍّ، وَزَيْدٍ قَالَا: إِذَا كَانَتْ الْجَدَّاتُ سَوَاءً، وَرِثَ ثَلَاثُ جَدَّاتٍ جَدَّتَا أَبِيهِ أُمُّ أُمِّهِ، وَأُمُّ أَبِيهِ، وَجَدَّةُ أُمِّهِ، فَإِنْ كَانَتْ إِحَدَاهُنَّ أَقْرَب، فَالسَّهْمُ لِذَوِي الْقُرْبَى.""","Da'if","Sunan al-Darimi 2973","","","20. سیدنا علی و سیدنا زید رضی اللہ عنہما کا قول جدات کے بارے میں"
"2974","(حديث موقوف) أَخْبَرَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا حَسَنٌ، عَنْ أَشْعَثَ، عَنْ الشَّعْبِيِّ، عَنْ عَلِيٍّ، وَزَيْدٍ:أَنَّهُمَا كَانَا لا يُوَرِّثَانِ الْجِدَّةَ أُمَّ الأَبِ مَعَ الأَبِ"". [إسناده ضعيف لضعف أشعث بن سوار] n حَدَّثَنَا سَعِيدُ بْنُ الْمُغِيرَةِ، عَنْ ابْنِ الْمُبَارَكِ، عَنْ مَعْمَرٍ، عَنْ الزُّهْرِيِّ، أَنَّ عُثْمَانَ «كَانَ لَا يُوَرِّثُ الْجَدَّةَ وَابْنُهَا حَيٌّ» [إسناده صحيح إلى الزهري]""","Da'if","Sunan al-Darimi 2974","","","20. سیدنا علی و سیدنا زید رضی اللہ عنہما کا قول جدات کے بارے میں"
"2975","(حديث موقوف) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، أَنْبَأَنَا الْأَشْعَثُ، عَنْ ابْنِ سِيرِينَ، عَنْ ابْنِ مَسْعُودٍ، قَالَ: إِنَّ الْجَدَّاتِ لَيْسَ لَهُنَّ مِيرَاثٌ، إِنَّمَا هِيَ طُعْمَةٌ أُطْعِمْنَهَا، وَالْجَدَّاتُ أَقْرَبُهُنَّ وَأَبْعَدُهُنَّ سَوَاءٌ"".""","","Sunan al-Darimi 2975","","","21. سیدنا ابن مسعود رضی اللہ عنہ کا قول جدات کے بارے میں"
"2976","(حديث موقوف) أَخْبَرَنَا حَجَّاجُ بْنُ مِنْهَالٍ، أَنْبَأَنَا أَبُو عَوَانَةَ، عَنْ الْمُغِيرَةِ، عَنْ إِبْرَاهِيمَ، قَالَ: قَالَ عَبْدُ اللَّهِ: تَرِثُ الْجَدَّةُ وَابْنُهَا حَيٌّ"".""","Da'if","Sunan al-Darimi 2976","","","21. سیدنا ابن مسعود رضی اللہ عنہ کا قول جدات کے بارے میں"
"2977","(حديث موقوف) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، أَنْبَأَنَا الْأَشْعَثُ، عَنْ الشَّعْبِيِّ، قَالَ:جِئْنَ أَرْبَعُ جَدَّاتٍ يَتَسَاوَقْنَ إِلَى مَسْرُوقٍ، فَأَلْغَى أَمَّ أَبِ الْأَبِ، وَوَرَّثَ ثَلَاثًا: جَدَّتَيْ أَبِيهِ: أُمَّ أُمِّهِ، وَأُمَّ أَبِيهِ، وَجَدَّةَ أُمِّهِ"".""","Da'if","Sunan al-Darimi 2977","","","22. جدات کے بارے میں مسروق رحمہ اللہ کی رائے"
"2978","(حديث موقوف) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، أَنْبَأَنَا شَرِيكٌ، عَنْ الْأَعْمَشِ، عَنْ إِبْرَاهِيمَ، عَنْ عَبْدِ اللَّهِ فِي ابْنَةٍ، وَابْنَةِ ابْنٍ، قَالَ: النِّصْفُ وَالسُّدُسُ، وَمَا بَقِيَ، فَرَدٌّ عَلَى الْبِنْتِ"".""","Da'if","Sunan al-Darimi 2978","","","23. سیدنا علی و سیدنا عبداللہ و سیدنا زید رضی اللہ عنہم کی باقی بچے ترکے میں رائے کا بیان"
"2979","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا جَرِيرٌ، عَنْ مَنْصُورٍ، عَنْ إِبْرَاهِيمَ، عَنْ عَلْقَمَةَ، عَنْ عَبْدِ اللَّه:أَنَّهُ أُتِيَ فِي إِخْوَةٍ لِأُمٍّ، وَأُمٍّ، فَأَعْطَى الْإِخْوَةَ مِنَ الْأُمِّ الثُّلُثَ، وَالْأُمَّ سَائِرَ الْمَالِ، وَقَالَ: الْأُمُّ عَصَبَةُ مَنْ لَا عَصَبَةَ لَهُ"".""","Sahih","Sunan al-Darimi 2979","","","23. سیدنا علی و سیدنا عبداللہ و سیدنا زید رضی اللہ عنہم کی باقی بچے ترکے میں رائے کا بیان"
"2980","(حديث مقطوع) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا حَسَنٌ، عَنْ أَبِيهِ، قَالَ: سَأَلْتُ الشَّعْبِيَّ عَنْ رَجُلٍ مَاتَ وَتَرَكَ ابْنَتَهُ، لَا يُعْلَمُ لَهُ وَارِثٌ غَيْرُهَا، قَالَ: لَهَا الْمَالُ كُلُّهُ"".""","Sahih","Sunan al-Darimi 2980","","","23. سیدنا علی و سیدنا عبداللہ و سیدنا زید رضی اللہ عنہم کی باقی بچے ترکے میں رائے کا بیان"
"2981","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا سُفْيَانُ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ، عَنْ الشَّعْبِيِّ، أَنَّ ابْنَ مَسْعُودٍ كَانَ لَا يَرُدُّ عَلَى أَخٍ لِأُمٍّ مَعَ أُمٍّ، وَلا عَلَى جَدَّةٍ، إِذَا كَانَ مَعَهَا غَيْرُهَا مَنْ لَهُ فَرِيضَةٌ، وَلَا عَلَى ابْنَةِ ابْنٍ، مَعَ ابْنَةِ الصُّلْبِ، وَلَا عَلَى امْرَأَةٍ وَزَوْج. وَكَانَ عَلِيٌّ يَرُدُّ عَلَى كُلِّ ذِي سَهْمٍ، إِلَّا الْمَرْأَةَ وَالزَّوْجَ""..""","Da'if","Sunan al-Darimi 2981","","","23. سیدنا علی و سیدنا عبداللہ و سیدنا زید رضی اللہ عنہم کی باقی بچے ترکے میں رائے کا بیان"
"2982","(حديث موقوف) أَخْبَرَنَا مُحَمَّدٌ، حَدَّثَنَا سُفْيَانُ، قَالَ: أَخْبَرَنِي مُحَمَّدُ بْنُ سَالِمٍ، عَنْ خَارِجَةَ بْنِ زَيْدٍ، عَنْ زَيْدِ بْنِ ثَابِت:أَنَّهُ أُتِيَ فِي ابْنَةٍ، أَوْ أُخْت، فَأَعْطَاهَا النِّصْفَ، وَجَعَلَ مَا بَقِيَ فِي بَيْتِ الْمَالِ وقَالَ يَزِيدُ بْنُ هَارُونَ: عَنْ مُحَمَّدِ بْنِ سَالِمٍ، عَنْ الشَّعْبِيِّ، عَنْ خَارِجَةَ.""","Da'if","Sunan al-Darimi 2982","","","23. سیدنا علی و سیدنا عبداللہ و سیدنا زید رضی اللہ عنہم کی باقی بچے ترکے میں رائے کا بیان"
"2983","(حديث موقوف) أَخْبَرَنَا مُحَمَّدُ بْنُ عُيَيْنَةَ، عَنْ عَلِيِّ بْنِ مُسْهِرٍ، عَنْ سَعِيدٍ، عَنْ أَبِي مَعْشَرٍ، عَنْ إِبْرَاهِيمَ، عَنْ عَبْدِ اللَّهِ، قَالَ فِي ابْنِ الْمُلَاعَنَةِ، قَالَ: مِيرَاثُهُ لِأُمِّهِ"".""","","Sunan al-Darimi 2983","","","24. لعان کرنے والے میاں بیوی کے بیٹے کی وراثت کا بیان"
"2984","(حديث موقوف) أَخْبَرَنَا مُعَاذُ بْنُ هَانِئٍ، حَدَّثَنَا إِبْرَاهِيمُ بْنُ طَهْمَانَ، قَالَ: سَمِعْتُ رَجُلًا سَأَلَ عَطَاءَ بْنَ أَبِي رَبَاحٍ عَنْ وَلَدِ الْمُتَلَاعِنَيْنِ لِمَنْ مِيرَاثُهُ؟ قَالَ: لِأُمِّهِ وَأَهْلِهَا.""","Sahih","Sunan al-Darimi 2984","","","24. لعان کرنے والے میاں بیوی کے بیٹے کی وراثت کا بیان"
"2985","(حديث موقوف) أَخْبَرَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا حَسَنٌ، عَنْ أَبِي سَهْلٍ، عَنْ الشَّعْبِيِّ قَالَ: قَالَ عَلِيٌّ فِي ابْنِ الْمُلَاعَنَةِ: تَرَكَ أَخَاهُ لِأُمِّهِ، وَأُمَّهُ لِأَخِيهِ السُّدُسُ، وَلِأُمِّهِ الثُّلُثُ، ثُمَّ يُرَدُّ عَلَيْهِمْ، فَيَصِيرُ لِلْأَخِ الثُّلُثُ، وَلِلْأُمِّ الثُّلُثَانِ"". وَقَالَ ابْنُ مَسْعُودٍ: لِأَخِيهِ السُّدُسُ، وَمَا بَقِيَ فَلِلْأُمِّ.""","Da'if","Sunan al-Darimi 2985","","","24. لعان کرنے والے میاں بیوی کے بیٹے کی وراثت کا بیان"
"2986","(حديث مقطوع) أَخْبَرَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا حَسَنٌ، عَنْ أَبِي سَهْلٍ، عَنْ الشَّعْبِيِّ فِي ابْنِ الْمُلَاعَنَةِ: تَرَكَ ابْنَ أَخٍ وَجَدًّا، قَالَ: الْمَالُ لِابْنِ الْأَخِ"".""","Da'if","Sunan al-Darimi 2986","","","24. لعان کرنے والے میاں بیوی کے بیٹے کی وراثت کا بیان"
"2987","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا سَالِمُ بْنُ نُوحٍ، عَنْ عُمَرَ بْنِ عَامِرٍ، عَنْ قَتَادَةَ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ، عَنْ زَيْدِ بْنِ ثَابِتٍ فِي مِيرَاثِ ابْنِ الْمُلَاعَنَة: لِأُمِّهِ الثُّلُثُ، وَالثُّلُثَانِ لِبَيْتِ الْمَالِ"".""","Hasan","Sunan al-Darimi 2987","","","24. لعان کرنے والے میاں بیوی کے بیٹے کی وراثت کا بیان"
"2988","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا سَالِمُ بْنُ نُوحٍ، عَنْ عُمَرَ بْنِ عَامِرٍ، عَنْ حَمَّادٍ، عَنْ إِبْرَاهِيمَ، عَنْ عَبْدِ اللَّهِ، قَالَ: مِيرَاثُهُ لِأُمِّهِ تَعْقِلُ عَنْهُ عَصَبَةُ أُمِّهِ""، وَقَالَ قَتَادَةُ، عَنْ الْحَسَنِ: لِأُمِّهِ الثُّلُثُ، وَبَقِيَّةُ الْمَالِ لِعَصَبَةِ أُمِّهِ.""","","Sunan al-Darimi 2988","","","24. لعان کرنے والے میاں بیوی کے بیٹے کی وراثت کا بیان"
"2989","(حديث موقوف) أَخْبَرَنَا حَجَّاجُ بْنُ مِنْهَالٍ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، أَخْبَرَنَا قَتَادَةُ: أَنَّ عَلِيًّا، وَابْنَ مَسْعُودٍ قَالَا فِي وَلَدِ المُلَاعَنَةٍ تَرْكُ جَدَّتِهِ وَإِخْوَتِهِ لأُمِّهِ، قَالَ: لِلْجَدَّةِ الثُّلُثُ، وَلِلْإِخْوَةِ الثُّلُثَانِ""، وَقَالَ زَيْدُ بْنُ ثَابِتٍ: لِلْجَدَّةِ السُّدُسُ، وَلِلْإِخْوَةِ لِلْأُمِّ الثُّلُثُ، وَمَا بَقِيَ فَلِبَيْتِ الْمَالِ.""","","Sunan al-Darimi 2989","","","24. لعان کرنے والے میاں بیوی کے بیٹے کی وراثت کا بیان"
"2990","(حديث موقوف) حَدَّثَنَا حَجَّاجٌ، حَدَّثَنَا حَمَّادٌ، أَنْبَأَنَا يُونُسُ، وَحُمَيدٌ، عَنْ الْحَسَنِ، قَالَ: تَرِثُهُ أُمُّهُ يَعْنِي: ابْنَ الْمُلَاعَنَةِ"".""","Hasan","Sunan al-Darimi 2990","","","24. لعان کرنے والے میاں بیوی کے بیٹے کی وراثت کا بیان"
"2991","(حديث مقطوع) أَخْبَرَنَا حَجَّاجٌ، حَدَّثَنَا حَمَّادٌ، حَدَّثَنَا حَجَّاجٌ: أَنَّ النَّخَعِيَّ، وَالشَّعْبِيّ، قَالَا: تَرِثُهُ أُمُّهُ"".""","Da'if","Sunan al-Darimi 2991","","","24. لعان کرنے والے میاں بیوی کے بیٹے کی وراثت کا بیان"
"2992","(حديث مرفوع) أَخْبَرَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا سُفْيَانُ، عَنْ دَاوُدَ بْنِ أَبِي هِنْدٍ، عَنْ عَبْدِ اللَّهِ بْنِ عُبَيْدِ بْنِ عُمَيْرٍ، قَالَ: كَتَبْتُ إِلَى أَخٍ لِي مِنْ بَنِي زُرَيْقٍ أَسْأَلُهُ: لِمَنْ قَضَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي ابْنِ الْمُلَاعَنَةِ؟ فَكَتَبَ إِلَيَّ:أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّم: قَضَى بِهِ لِأُمِّهِ هِيَ بِمَنْزِلَةِ أُمِّهِ وَأَبِيهِ. وقَالَ سُفْيَانُ: الْمَالُ كُلُّهُ لِلْأُمِّ هِيَ بِمَنْزِلَةِ أَبِيهِ وَأُمِّهِ.""","Sahih","Sunan al-Darimi 2992","","","24. لعان کرنے والے میاں بیوی کے بیٹے کی وراثت کا بیان"
"2993","(حديث موقوف) أَخْبَرَنَا مُحَمَّدٌ، حَدَّثَنَا سُفْيَانُ، عَنْ هِشَامٍ، عَنْ الْحَسَنِ فِي ابْنِ الْمُلَاعَنَةِ تَرَكَ أُمَّهُ وَعَصَبَةَ أُمِّهِ، قَالَ: الثُّلُثُ لِأُمِّهِ، وَمَا بَقِيَ فَلِعَصَبَةِ أُمِّهِ"".""","Hasan","Sunan al-Darimi 2993","","","24. لعان کرنے والے میاں بیوی کے بیٹے کی وراثت کا بیان"
"2994","(حديث موقوف) أَخْبَرَنَا عُبَيْدُ اللَّهِ بْنُ مُوسَى، عَنْ ابْنِ أَبِي لَيْلَى، عَنْ عَامِرٍ، عَنْ عَلِيٍّ، وَعَبْدِ اللَّهِ فِي ابْنِ الْمُلاعَنَةِ، قَالا: عَصَبَتُهُ عَصَبَةُ أُمِّهِ"".""","Da'if","Sunan al-Darimi 2994","","","24. لعان کرنے والے میاں بیوی کے بیٹے کی وراثت کا بیان"
"2995","(حديث مقطوع) حَدَّثَنَا أَبُو الْوَلِيدِ الْحَلَبِيُّ مُوسَى بْنُ خَالِدٍ، حَدَّثَنَا المُعْتَمِر، عَنْ يُونُسَ، عَنِ الْحَسَنِ، أَنَّهُ كَانَ يَقُول: مِيرَاثُ وَلَدِ الْمُلَاعَنَةِ لِأُمِّه، قُلْتُ: فَإِنْ كَانَ لَهُ أَخٌ مِنْ أُمِّه؟ قَالَ: لَهُ السُّدُسُ"".""","Sahih","Sunan al-Darimi 2995","","","24. لعان کرنے والے میاں بیوی کے بیٹے کی وراثت کا بیان"
"2996","(حديث مقطوع) حَدَّثَنَا أَبُو الْمُغِيرَةِ، حَدَّثَنَا الْأَوْزَاعِيُّ، حَدَّثَنَا الزُّهْرِيُّ، قَالَ: وَلَدُ الْمُلَاعَنَةِ لِأُمِّه، تَرِثُ فَرِيضَتَهَا مِنْهُ، وَسَائِرُ ذَلِكَ فِي بَيْتِ الْمَالِ"".""","Sahih","Sunan al-Darimi 2996","","","24. لعان کرنے والے میاں بیوی کے بیٹے کی وراثت کا بیان"
"2997","(حديث موقوف) أَخْبَرَنَا عُبَيْدُ اللَّهِ بْنُ مُوسَى، عَنْ مُوسَى بْنِ عُبَيْدَةَ، عَنْ نَافِعٍ، عَنْ ابْنِ عُمَرَ، قَالَ: إِذَا تَلَاعَنَا، فُرِّقَ بَيْنَهُمَا وَلَمْ يَجْتَمِعَا، وَدُعِيَ الْوَلَدُ لِأُمِّهِ، يُقَالُ: ابْنُ فُلَانَةَ، هِيَ عَصَبَتُهُ يَرِثُهَا وَتَرِثُهُ، وَمَنْ دَعَاهُ لِزِنْيَةٍ، جُلِدَ"".""","Da'if","Sunan al-Darimi 2997","","","24. لعان کرنے والے میاں بیوی کے بیٹے کی وراثت کا بیان"
"2998","(حديث مقطوع) حَدَّثَنَا مُعَاذُ بْنُ هَانِئٍ، حَدَّثَنَا إِبْرَاهِيمُ بْنُ طَهْمَانَ، حَدَّثَنَا الشَّيْبَانِيُّ، عَنْ الشَّعْبِيِّ فِي وَلَدِ الْمُتَلَاعِنَيْنِ:أَنَّهُ تَرِثُهُ عَصَبَةُ أُمِّهِ، وَهُمْ يَعْقِلُونَ عَنْهُ"".""","Sahih","Sunan al-Darimi 2998","","","24. لعان کرنے والے میاں بیوی کے بیٹے کی وراثت کا بیان"
"2999","(حديث موقوف) حَدَّثَنَا سَهْلُ بْنُ حَمَّادٍ، أَنْبَأَنَا هَمَّامٌ، عَنْ قَتَادَةَ، عَنْ عَزْرَةَ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ، عَنْ ابْنِ عَبَّاسٍ فِي وَلَدِ الْمُلَاعَنَةِ هُوَ الَّذِي لَا أَبَ لَهُ تَرِثُهُ أُمُّهُ وَإِخْوَتُهُ مِنْ أُمِّهِ، ِوَعَصَبَةُُ أُمِّهِ، فَإِنْ قَذَفَهُ قَاذِف، جُلِدَ قَاذِفُهُ"".""","Sahih","Sunan al-Darimi 2999","","","24. لعان کرنے والے میاں بیوی کے بیٹے کی وراثت کا بیان"
"3000","(حديث مرفوع) أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُبَارَكِ، حَدَّثَنَا يَحْيَى بْنُ حَمْزَةَ، عَنْ النُّعْمَانِ، عَنْ مَكْحُولٍ: أَنَّهُ سُئِلَ عَنْ مِيرَاثِ وَلَدِ الْمُلَاعَنَةِ لِمَنْ هُوَ؟ قَالَ: جَعَلَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: لِأُمِّهِ فِي سَبَبِهِ لِمَا لَقِيَتْ مِنْ الْبَلَاءِ، وَلِإِخْوَتِهِ مِنْ أُمِّهِ، وقَالَ مَكْحُول: فَإِنْ مَاتَتْ الْأُمُّ، وَتَرَكَتْ ابْنَهَا، ثُمَّ تُوُفِّيَ ابْنُهَا الَّذِي جُعِلَ لَهَا، كَانَ مِيرَاثُهُ لِإِخْوَتِهِ مِنْ أُمِّهِ كُلُّهُ، لِأَنَّهُ كَانَ لِأُمِّهِمْ وَجَدِّهِمْ، وَكَانَ لِأَبِيهَا السُّدُسُ مِنْ ابْنِ ابْنَتِهِ، وَلَيْسَ يَرِثُ الْجَدُّ إِلَّا فِي هَذِهِ الْمَنْزِلَةِ، لِأَنَّهُ إِنَّمَا هُوَ أَبُ الْأُمِّ، وَإِنَّمَا وَرِثَ الْإِخْوَةُ مِنْ الْأُمِّ أُمَّهُمْ، وَوَرِثَ الْجَدُّ ابْنَتَهُ لِأَنَّهُ جُعِلَ لَهَا، فَالْمَالُ الَّذِي لِلْوَلَدِ لِوَرَثَةِ الْأُمِّ وَهُوَ بِحَوْزَةِ الْجَدُّ وَحْدَهُ إِذَا لَمْ يَكُنْ غَيْرُهُ"".""","Sahih","Sunan al-Darimi 3000","","","24. لعان کرنے والے میاں بیوی کے بیٹے کی وراثت کا بیان"
"3001","(حديث موقوف) أَخْبَرَنَا مُحَمَّدُ بْنُ الْعَلَاءِ، حَدَّثَنَا يَحْيَى بْنُ أَبِي بُكَيْرٍ، حَدَّثَنَا إِبْرَاهِيمُ بْنُ طَهْمَانَ، عَنْ سِمَاكِ بْنِ حَرْبٍ، عَنْ عِكْرِمَةَ، عَنْ ابْنِ عَبَّاسٍ: أَنَّ قَوْمًا اخْتَصَمُوا إِلَى عَلِيٍّ رَضِيَ اللَّهُ تَعَالَى عَنْه فِي وَلَدِ الْمُتَلَاعِنَيْنِ، فَجَاءَ عَصَبَةُ أَبِيهِ يَطْلُبُونَ مِيرَاثَه، فَقَالَ: إِنَّ أَبَاهُ كَانَ تَبَرَّأَ مِنْهُ، فَلَيْسَ لَكُمْ مِنْ مِيرَاثِهِ شَيْءٌ، فَقَضَى بِمِيرَاثِهِ لِأُمِّهِ، وَجَعَلَهَا عَصَبَتَهُ"".""","Da'if","Sunan al-Darimi 3001","","","24. لعان کرنے والے میاں بیوی کے بیٹے کی وراثت کا بیان"
"3002","(حديث موقوف) أَخْبَرَنَا عُبَيْدُ اللَّهِ بْنُ مُوسَى، عَنْ إِسْرَائِيلَ، عَنْ عَبْدِ الْأَعْلَى: أَنَّهُ سَمِعَ مُحَمَّدَ بْنَ عَلِيٍّ يُحَدِّثُ، عَنْ عَلِيٍّ: فِي الرَّجُلِ يَكُونُ لَهُ مَا لِلرَّجُلِ وَمَا لِلْمَرْأَةِ مِنْ أَيِّهِمَا يُوَرَّثُ، فَقَالَ: مِنْ أَيِّهِمَا بَالَ"".""","","Sunan al-Darimi 3002","","","25. خنثی (ہیجڑے) کی میراث کا بیان"
"3003","(حديث موقوف) حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ، حَدَّثَنَا هُشَيْمٌ، عَنْ مُغِيرَةَ، عَنْ شِبَاكٍ، عَنْ الشَّعْبِيِّ، عَنْ عَلِيٍّ فِي الْخُنْثَى، قَالَ: يُوَرَّثُ مِنْ قِبَلِ مَبَالِهِ"".""","","Sunan al-Darimi 3003","","","25. خنثی (ہیجڑے) کی میراث کا بیان"
"3004","(حديث موقوف) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا أَبُو هَانِئٍ، قَالَ: سُئِلَ عَامِرٌ عَنْ مَوْلُودٍ وُلِدَ، وَلَيْسَ بِذَكَرٍ، وَلَا أُنْثَى، لَيْسَ لَهُ مَا لِلذَّكَرِ، وَلَيْسَ لَهُ مَا لِلْأُنْثَى، يُخْرِجُ مِنْ سُرَّتِهِ كَهَيْئَةِ الْبَوْلِ وَالْغَائِطِ، سُئِلَ عَنْ مِيرَاثِهِ، فَقَالَ: نِصْفُ حَظِّ الذَّكَرِ، وَنِصْفُ حَظِّ الْأُنْثَى"".""","Da'if","Sunan al-Darimi 3004","","","25. خنثی (ہیجڑے) کی میراث کا بیان"
"3005","(حديث موقوف) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، حَدَّثَنَا عَاصِمٌ، عَنْ الشَّعْبِيِّ، قَالَ: سُئِلَ أَبُو بَكْرٍ عَنْ الْكَلَالَةِ، فَقَالَ:إِنِّي سَأَقُولُ فِيهَا بِرَأْيِي، فَإِنْ كَانَ صَوَابًا فَمِنْ اللَّهِ، وَإِنْ كَانَ خَطَأً فَمِنِّي، وَمِنَ الشَّيْطَانِ: أُرَاهُ مَا خَلَا الْوَالِدَ وَالْوَلَدِ""، َفَلَمَّا اسْتُخْلِفَ عُمَرُ، قَالَ: إِنِّي لَأَسْتَحْيِي اللَّهَ أَنْ أَرُدَّ شَيْئًا قَالَهُ أَبُو بَكْرٍ.""","","Sunan al-Darimi 3005","","","26. کلالہ کا بیان"
"3006","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يَزِيدَ، حَدَّثَنَا سَعِيدٌ هُوَ ابْنُ أَبِي أَيُّوبَ، قَالَ: حَدَّثَنِي يَزِيدُ بْنُ أَبِي حَبِيبٍ، عَنْ مَرْثَدِ بْنِ عَبْدِ اللَّهِ الْيَزَنِيِّ، عَنْ عُقْبَةَ بْنِ عَامِرٍ الْجُهَنِيِّ، أَنَّهُ قَالَ: مَا أَعْضَلَ بِأَصْحَابِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ شَيْءٌ مَا أَعْضَلَتْ بِهِمْ الْكَلَالَةُ"".""","Sahih","Sunan al-Darimi 3006","","","26. کلالہ کا بیان"
"3007","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا سُفْيَانُ، عَنْ عَمْرِو بْنِ دِينَارٍ، عَنْ الْحَسَنِ بْنِ مُحَمَّدٍ، عَنْ ابْنِ عَبَّاسٍ، قَالَ: الْكَلَالَةُ مَا خَلَا الْوَالِدَ وَالْوَلَدَ"".""","Hasan","Sunan al-Darimi 3007","","","26. کلالہ کا بیان"
"3008","(حديث موقوف) أَخْبَرَنَا مُحَمَّدٌ، حَدَّثَنَا سُفْيَانُ، عَنْ يَعْلَى بْنِ عَطَاءٍ، عَنْ الْقَاسِمِ بْنِ عَبْدِ اللَّهِ، عَنْ سَعْدٍ:أَنَّهُ كَانَ يَقْرَأُ هَذِهِ الْآيَةَ: وَإِنْ كَانَ رَجُلٌ يُورَثُ كَلالَةً أَو امْرَأَةٌ وَلَهُ أَخٌ أَوْ أُخْتٌ سورة النساء آية 12 لِأُمٍّ"".""","Sahih","Sunan al-Darimi 3008","","","26. کلالہ کا بیان"
