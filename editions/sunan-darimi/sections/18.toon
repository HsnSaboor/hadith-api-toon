hadiths[97]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3100","(حديث موقوف) حَدَّثَنَا يُونُسُ بْنُ مُحَمَّدٍ، حَدَّثَنَا أَبُو عَوَانَةَ، عَنْ مُغِيرَةَ، عَنْ حَمَّادٍ:فِي الرَّجُلِ يَكُونُ لَهُ ثَلَاثَةُ بَنِينَ، فَقَالَ: ثُلُثِي لِأَصْغَرِ بَنِيَّ، فَقَالَ الْأَوْسَطُ: أَنَا أُجِيزُ، وَقَالَ الْأَكْبَرُ: أَنَا لَا أُجِيزُ، قَالَ: هِيَ مِنْ تِسْعَةٍ يُخْرِجُ ثَلاثَةً فَلَهُ سَهْمُهُ، وَسَهْمُ الَّذِي أَجَاز"". وَقَالَ حَمَّادٌ: يَرُدُّ السَّهْمَ عَلَيْهِمْ جَمِيعًا، وَقَالَ عَامِرٌ: الَّذِي رَدَّ إِنَّمَا رَدَّ عَلَى نَفْسِهِ.""","Sahih","Sunan al-Darimi 3100","","","39. کسی چیز کے انکار کا دعویٰ کرنے کا بیان"
"3101","(حديث مقطوع) حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ، حَدَّثَنَا يَحْيَى بْنُ آدَمَ، عَنْ شَرِيكٍ، عَنْ خَالِدٍ، عَنْ ابْنِ سِيرِينَ، عَنْ شُرَيْحٍ: فِي رَجُلٍ أَقَرَّ بِأَخٍ، قَالَ: بَيِّنَتُهُ أَنَّهُ أَخُوهُ"".""","Hasan","Sunan al-Darimi 3101","","","39. کسی چیز کے انکار کا دعویٰ کرنے کا بیان"
"3102","(حديث موقوف) أَخْبَرَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا أَبُو عَوَانَةَ، عَنْ مُغِيرَةَ، عَنْ الْحَارِثِ الْعُكْلِيِّ: فِي رَجُلٍ أَقَرَّ عِنْدَ مَوْتِهِ بِأَلْفِ دِرْهَمٍ مُضَارَبَةً، وَأَلْفٍ دَيْنًا، وَلَمْ يَدَعْ إِلَّا أَلْفَ دِرْهَمٍ، قَالَ: يُبْدَأُ بِالدَّيْنِ، فَإِنْ فَضَلَ فَضْلٌ كَانَ لِصَاحِبِ الْمُضَارَبَةِ"".""","Sahih","Sunan al-Darimi 3102","","","39. کسی چیز کے انکار کا دعویٰ کرنے کا بیان"
"3103","(حديث مقطوع) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا حَسَنٌ، عَنْ مُطَرِّفٍ، عَنْ الشَّعْبِيِّ:فِي رَجُلٍ مَاتَ وَتَرَكَ ثَلَاثَ مِئَةِ دِرْهَمٍ، وَثَلَاثَةَ بَنِينَ، فَجَاءَ رَجُلٌ يَدَّعِي مِائَةَ دِرْهَمٍ عَلَى الْمَيِّتِ، فَأَقَرَّ لَهُ أَحَدُهُمْ، قَالَ: يَدْخُلُ عَلَيْهِ بِالْحِصَّةِ""، ثُمَّ قَالَ الشَّعْبِيُّ: مَا أُرَى أَنْ يَكُونَ مِيرَاثًا، حَتَّى يُقْضَى الدَّيْنُ.""","Sahih","Sunan al-Darimi 3103","","","39. کسی چیز کے انکار کا دعویٰ کرنے کا بیان"
"3104","(حديث موقوف) حَدَّثَنَا أَبُو خَيْثَمَةَ مُصْعَبُ بْنُ سَعِيدٍ الْحَرَّانِيُّ، حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ، عَنْ الْأَشْعَثِ، عَنْ الْحَسَنِ: فِي رَجُلٍ هَلَكَ وَتَرَكَ ابْنَيْنِ، وَتَرَكَ أَلْفَيْ دِرْهَمٍ، فَاقْتَسَمَا الْأَلْفَيْ دِرْهَمٍ، وَغَابَ أَحَدُ الِابْنَيْنِ، فَجَاءَ رَجُلٌ، فَاسْتَحَقَّ عَلَى الْمَيِّتِ أَلْفَ دِرْهَمٍ، قَالَ: يَأْخُذُ جَمِيعَ مَا فِي يَدِ هَذَا الشَّاهِدِ، وَيُقَالُ لَهُ: اتَّبِعْ أَخَاكَ الْغَائِبَ، وَخُذْ نِصْفَ مَا فِي يَدِهِ"".""","Hasan","Sunan al-Darimi 3104","","","39. کسی چیز کے انکار کا دعویٰ کرنے کا بیان"
"3105","(حديث موقوف) حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، عَنْ حَمَّادِ بْنِ سَلَمَةَ، عَنْ زِيَادٍ الْأَعْلَمِ، عَنْ الْحَسَنِ، قَالَ: إِذَا أَقَرَّ بَعْضُ الْوَرَثَةِ بِدَيْنٍ، فَهُوَ عَلَيْهِ بِحِصَّتِهِ"".""","Hasan","Sunan al-Darimi 3105","","","39. کسی چیز کے انکار کا دعویٰ کرنے کا بیان"
"3106","(حديث مقطوع) حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، عَنْ حَمَّادِ بْنِ سَلَمَةَ، عَنْ أَبِي هَاشِمٍ، عَنْ إِبْرَاهِيمَ، قَالَ: إِذَا شَهِدَ اثْنَانِ مِنْ الْوَرَثَةِ بِدَيْنٍ، فَهُوَ مِنْ جَمِيعِ الْمَالِ إِذَا كَانُوا عُدُولًا""، وَقَالَ الشَّعْبِيُّ: عَلَيْهِمَا فِي بَاب فِي مِيرَاثِ الْمُرْتَدِّ.""","Sahih","Sunan al-Darimi 3106","","","39. کسی چیز کے انکار کا دعویٰ کرنے کا بیان"
"3107","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا ثَابِتُ بْنُ الْوَلِيدِ بْنِ جُمَيْعٍ، قَالَ: أَخْبَرَنِي أَبِي، عَنْ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ، قَالَ: كَانَ ابْنُ مَسْعُودٍ يُوَرِّثُ أَهْلَ الْمُرْتَدِّ إِذَا قُتِلَ"".""","Da'if","Sunan al-Darimi 3107","","","40. مرتد ہو جانے والے کی میراث کا بیان"
"3108","(حديث موقوف) حَدَّثَنَا الْحَجَّاجُ بْنُ مِنْهَالٍ، حَدَّثَنَا أَبُو عَوَانَةَ، عَنْ الْأَعْمَشِ، عَنْ أَبِي عَمْرٍو الشَّيْبَانِيِّ: أَنَّ عَلِيَّ بْنَ أَبِي طَالِبٍ جَعَلَ مِيرَاثَ الْمُرْتَدِّ لِوَرَثَتِهِ مِنَ الْمُسْلِمِينَ"".""","Sahih","Sunan al-Darimi 3108","","","40. مرتد ہو جانے والے کی میراث کا بیان"
"3109","(حديث موقوف) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، حَدَّثَنَا الْحَجَّاجُ، عَنِ الْحَكَمِ: أَنَّ عَلِيًّا قَضَى فِي مِيرَاثِ الْمُرْتَدِّ لِأَهْلِهِ مِنْ الْمُسْلِمِينَ"".""","Da'if","Sunan al-Darimi 3109","","","40. مرتد ہو جانے والے کی میراث کا بیان"
"3110","(حديث موقوف) حَدَّثَنَا زَكَرِيَّا بْنُ عَدِيٍّ، حَدَّثَنَا عُبَيْدُ اللَّهِ هُوَ ابْنُ عَمْرٍو، عَنْ عَبْدِ الْكَرِيمِ، عَنْ الْحَكَمِ، قَالَ: إِذَا قَتَلَ الرَّجُلُ أَخَاهُ عَمْدًا، لَمْ يُوَرَّثْ مِنْ مِيرَاثِهِ، وَلَا مِنْ دِيَتِهِ، فَإِذَا قَتَلَهُ خَطَأً، وُرِّثَ مِنْ مِيرَاثِهِ، وَلَمْ يُوَرَّثْ مِنْ دِيَتِهِ. قَالَ: وَكَانَ عَطَاءٌ يَقُولُ ذَلِكَ.""","","Sunan al-Darimi 3110","","","41. قاتل کی میراث کا بیان"
"3111","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ عُيَيْنَةَ، عَنْ عَلِيِّ بْنِ مُسْهِرٍ، عَنْ سَعِيدٍ، عَنْ قَتَادَةَ، عَنْ خِلَاسٍ، عَنْ عَلِيٍّ، قَالَ: رَمَى رَجُلٌ أُمَّهُ بِحَجَرٍ فَقَتَلَهَا، فَطَلَبَ مِيرَاثَهُ مِنْ إِخْوَتِهِ، فَقَالَ لَهُ إِخْوَتُهُ: لَا مِيرَاثَ لَكَ، فَارْتَفَعُوا إِلَى عَلِيٍّ، فَجَعَلَ عَلَيْهِ الدِّيَةَ، وَأَخْرَجَهُ مِنْ الْمِيرَاثِ"".""","","Sunan al-Darimi 3111","","","41. قاتل کی میراث کا بیان"
"3112","(حديث موقوف) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا زُهَيْرٌ، عَنْ الْحَسَنِ بْنِ الْحُرِّ، عَنْ الْحَكَمِ: أَنَّ الرَّجُلَ إِذَا قَتَلَ امْرَأَتَهُ خَطَأً،أَنَّهُ يُمْنَعُ مِيرَاثَهُ مِنْ الْعَقْلِ وَغَيْرِهِ"".""","Sahih","Sunan al-Darimi 3112","","","41. قاتل کی میراث کا بیان"
"3113","(حديث موقوف) أَخْبَرَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا سُفْيَانُ، عَنْ لَيْثٍ، عَنْ مُجَاهِدٍ، عَنْ ابْنِ عَبَّاسٍ، قَالَ: لَا يَرِثُ الْقَاتِلُ مِنْ الْمَقْتُولِ شَيْئًا"".""","Da'if","Sunan al-Darimi 3113","","","41. قاتل کی میراث کا بیان"
"3114","(حديث مقطوع) حَدَّثَنَا سَعِيدُ بْنُ الْمُغِيرَةِ، عَنْ ابْنِ الْمُبَارَكِ، عَنْ مَعْمَرٍ، عَنْ قَتَادَةَ:فِي رَجُلٍ قَذَفَ امْرَأَتَهُ، وَجَاءَ بِشُهُودٍ فَرُجِمَتْ؟ قَالَ: يَرِثُهَا"".""","Sahih","Sunan al-Darimi 3114","","","41. قاتل کی میراث کا بیان"
"3115","(حديث موقوف) حَدَّثَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا أَبُو عَوَانَةَ، عَنْ حَمَّادٍ:فِي رَجُلٍ جُلِدَ الْحَدَّ أَرَاهُ مَاتَ، شَكَّ أَبُو النُّعْمَانِ؟ قَالَ: يَتَوَارَثَانِ"".""","Sahih","Sunan al-Darimi 3115","","","41. قاتل کی میراث کا بیان"
"3116","(حديث موقوف) حَدَّثَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا أَبُو عَوَانَةَ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ، عَنْ عَامِرٍ، عَنْ عَلِيٍّ، قَالَ: الْقَاتِلُ لَا يَرِثُ، وَلَا يَحْجُبُ"".""","Da'if","Sunan al-Darimi 3116","","","41. قاتل کی میراث کا بیان"
"3117","(حديث موقوف) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا حَسَنٌ، عَنْ لَيْثٍ، عَنْ أَبِي عَمْرٍو الْعَبْدِيِّ، عَنْ عَلِيٍّ، قَالَ: لَا يُوَرَّثُ الْقَاتِلُ"".""","Da'if","Sunan al-Darimi 3117","","","41. قاتل کی میراث کا بیان"
"3118","(حديث موقوف) حَدَّثَنَا زَكَرِيَّا بْنُ عَدِيٍّ، حَدَّثَنَا أَبُو بَكْرٍ، عَنْ مُطَرِّفٍ، عَنْ الشَّعْبِيِّ، قَالَ: قَالَ عُمَرُ: لَا يَرِثُ قَاتِلٌ خَطَأً، وَلَا عَمْدًا"".""","","Sunan al-Darimi 3118","","","41. قاتل کی میراث کا بیان"
"3119","(حديث موقوف) أَخْبَرَنَا مُحَمَّدُ بْنُ يُوسُفَ، عَنْ سُفْيَانَ، عَنْ لَيْثٍ، عَنْ طَاوُسٍ، عَنْ ابْنِ عَبَّاسٍ، قَالَ: لَا يَرِثُ الْقَاتِلُ"".""","Da'if","Sunan al-Darimi 3119","","","41. قاتل کی میراث کا بیان"
"3120","(حديث مقطوع) أَخْبَرَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا عَبْدُ الْأَعْلَى، عَنْ مَعْمَرٍ، عَنْ الزُّهْرِيِّ، قَالَ: إِذَا اجْتَمَعَ نَسَبَانِ، وُرِّثَ بِأَكْبَرِهِمَا، يَعْنِي الْمَجُوسَ"".""","Sahih","Sunan al-Darimi 3120","","","42. مجوس کے لئے میراث کے مسائل کا بیان"
"3121","(حديث موقوف) حَدَّثَنَا حَجَّاجُ بْنُ مِنْهَالٍ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، عَنْ حَمَّادِ بْنِ أَبِي سُلَيْمَانَ، قَالَ: يَرِثُ مِنْ الْجَانِبِ الَّذِي يَصْلُحُ، وَلَا يَرِثُ مِنْ الْجَانِبِ الَّذِي لَا يَصْلُحُ"".""","Sahih","Sunan al-Darimi 3121","","","42. مجوس کے لئے میراث کے مسائل کا بیان"
"3122","(حديث موقوف) حَدَّثَنَا حَجَّاجٌ، حَدَّثَنَا حَمَّادٌ، عَنْ سُفْيَانَ الثَّوْرِيِّ، عَنْ رَجُلٍ، عَنْ الشَّعْبِيِّ: أَنَّ عَلِيًّا، وَابْنَ مَسْعُودٍ، قَالَا فِي الْمَجُوسِ: إِذَا أَسْلَمُوا، يَرِثُونَ مِنْ الْقَرَابَتَيْنِ جَمِيعًا"".""","Da'if","Sunan al-Darimi 3122","","","42. مجوس کے لئے میراث کے مسائل کا بیان"
"3123","(حديث مقطوع) أَخْبَرَنَا يَحْيَى بْنُ حَسَّانَ، حَدَّثَنَا ابْنُ أَبِي الزِّنَادِ، عَنْ أَبِيهِ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ فِي امْرَأَةِ الْأَسِيرِ:أَنَّهَا تَرِثُهُ وَيَرِثُهَا"".""","Hasan","Sunan al-Darimi 3123","","","43. قیدی کی میراث کا بیان"
"3124","(حديث مقطوع) حَدَّثَنَا مُحَمَّدُ بْنُ الْفَضْلِ، حَدَّثَنَا عَبْدُ اللَّهِ بْنُ الْمُبَارَكِ، حَدَّثَنِي مَعْمَرٌ، عَنْ إِسْحَاق بْنِ رَاشِدٍ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ فِي الْأَسِيرِ يُوصِي، قَالَ: أُجيزُ لَهُ وَصِيَّتَهُ مَا دَامَ عَلَى دِينِهِ لَمْ يَتَغَيَّرْ عَنْ دِينِهِ"".""","Sahih","Sunan al-Darimi 3124","","","43. قیدی کی میراث کا بیان"
"3125","(حديث مقطوع) أَخْبَرَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا سُفْيَانُ، عَنْ دَاوُدَ، عَنْ الشَّعْبِيِّ، عَنْ شُرَيْحٍ، قَالَ: يُوَرَّثُ الْأَسِيرُ إِذَا كَانَ فِي أَيْدِي الْعَدُوِّ"".""","Sahih","Sunan al-Darimi 3125","","","43. قیدی کی میراث کا بیان"
"3126","(حديث مقطوع) حَدَّثَنَا مُحَمَّدٌ، قَالَ: حَدَّثَنَا سُفْيَانُ، حَدَّثَنِي مَنْ سَمِعَ إِبْرَاهِيمَ، يَقُولُ: يُوَرَّثُ الْأَسِيرُ"".""","Da'if","Sunan al-Darimi 3126","","","43. قیدی کی میراث کا بیان"
"3127","(حديث مقطوع) حَدَّثَنَا الْمُعَلَّى بْنُ أَسَدٍ، حَدَّثَنَا وُهَيْبٌ، عَنْ دَاوُدَ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ: أَنَّهُ كَانَ لَا يُوَرِّثُ الْأَسِيرَ"".""","Sahih","Sunan al-Darimi 3127","","","43. قیدی کی میراث کا بیان"
"3128","(حديث موقوف) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، حَدَّثَنَا الْأَشْعَثُ، عَنْ الشَّعْبِيِّ، قَالَ: كَتَبَ عُمَرُ بْنُ الْخَطَّابِ إِلَى شُرَيْحٍ: أَنْ لَا يُوَرِّثَ الْحَمِيلَ إِلَّا بِبَيِّنَةٍ، وَإِنْ جَاءَتْ بِهِ فِي خِرَقِهَا"".""","Da'if","Sunan al-Darimi 3128","","","44. حمیل کو میراث دینے کا بیان"
"3129","(حديث مقطوع) أَخْبَرَنَا عُبَيْدُ اللَّهِ، عَنْ إِسْرَائِيلَ، عَنْ مَنْصُورٍ، عَنْ إِبْرَاهِيمَ، قَالَ: وَرِّثْ الْحَمِيلَ"".""","Sahih","Sunan al-Darimi 3129","","","44. حمیل کو میراث دینے کا بیان"
"3130","(حديث مقطوع) حَدَّثَنَا أَبُو سَعِيدٍ مِنْ بَنِي أُمَيَّةَ، عَنْ أَبِي بَكْرِ بْنِ عَبْدِ اللَّهِ بْنِ أَبِي مَرْيَمَ، عَنْ ضَمْرَةَ، وَالْفُضَيْلِ بْنِ فَضَالَةَ، وَابْنِ أَبِي عَوْفٍ، وراشد، وعطية، قَالُوا: لَا يُوَرَّثُ الْحُمَلَاءُ"".""","Da'if","Sunan al-Darimi 3130","","","44. حمیل کو میراث دینے کا بیان"
"3131","(حديث مقطوع) حَدَّثَنَا سَعِيدُ بْنُ الْمُغِيرَةِ، قَالَ: قَالَ ابْنُ الْمُبَارَكِ: حَدَّثَنَا ابْنُ عَوْنٍ، عَنْ مُحَمَّدٍ، قَالَ: ذُكِرَ عِنْدَهُ قَوْلُ مَنْ يَقُولُ فِي الْحَمِيلِ، فَأَنْكَرَ ذَلِكَ، وَقَالَ: قَدْ تَوَارَثَ الْمُهَاجِرُونَ، وَالْأَنْصَارُ بِنَسَبِهِمْ الَّذِي كَانَ فِي الْجَاهِلِيَّةِ"".""","Sahih","Sunan al-Darimi 3131","","","44. حمیل کو میراث دینے کا بیان"
"3132","(حديث مقطوع) حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ، عَنْ ابْنِ إِدْرِيسَ، عَنْ هِشَامٍ، عَنْ الْحَسَنِ، وَابْنِ سِيرِينَ، قَالَا: لَا يُوَرَّثُ الْحَمِيلُ إِلَّا بِبَيِّنَةٍ"".""","Sahih","Sunan al-Darimi 3132","","","44. حمیل کو میراث دینے کا بیان"
"3133","(حديث مقطوع) حَدَّثَنَا أَبُو بَكْرٍ، حَدَّثَنَا جَرِيرٌ، عَنْ لَيْثٍ، عَنْ حَمَّادٍ، عَنْ إِبْرَاهِيمَ، قَالَ: لَمْ يَكُنْ أَبُو بَكْرٍ، وَعُمَرُ، وَعُثْمَانُ يُوَرِّثُونَ الْحَمِيلَ"".""","Da'if","Sunan al-Darimi 3133","","","44. حمیل کو میراث دینے کا بیان"
"3134","(حديث مقطوع) حَدَّثَنَا أَبُو بَكْرٍ، حَدَّثَنَا عَبْدُ الرَّحِيمِ الْمُحَارِبِيُّ، عَنْ زَائِدَةَ، عَنْ أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ، قَالَ: أَقَرَّتْ امْرَأَةٌ مِنْ مُحَارِبٍ جَلِيبَةٌ بِنَسَبٍ لَهَا جَلِيبٍ، فَوَرَّثَهُ عَبْدُ اللَّهِ بْنُ عُتْبَةَ مِنْ أُخْتِهِ"".""","Sahih","Sunan al-Darimi 3134","","","44. حمیل کو میراث دینے کا بیان"
"3135","(حديث مقطوع) حَدَّثَنَا عَبْدُ اللَّهِ بْنُ صَالِحٍ، حَدَّثَنِي اللَّيْثُ، حَدَّثَنِي يُونُسُ، عَنْ ابْنِ شِهَابٍ، عَنْ رَجُلٍ قَالَ عِنْدَ فِرَاقِ الدُّنْيَا: أَنَا مَوْلَى فُلَانٍ، قَالَ: يُرَدُّ مِيرَاثَهُ لِمَنْ سَمَّى أَنَّهُ مَوْلَاهُ عِنْدَ فِرَاقِ الدُّنْيَا، إِلَّا أَنْ يَأْتُوا عَلَيْهِ بِبَيِّنَةٍ بِغَيْرِ ذَلِكَ يَرُدُّونَ بِهِ قَوْلَهُ، فَيُرَدُّ مِيرَاثُهُ إِلَى مَا قَامَتْ بِهِ الْبَيِّنَةُ"".""","Da'if","Sunan al-Darimi 3135","","","44. حمیل کو میراث دینے کا بیان"
"3136","(حديث موقوف) أَخْبَرَنَا أَخْبَرَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا شَرِيكٌ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ، عَنْ الشَّعْبِيِّ، عَنْ عَلِيٍّ، وَعَبْدِ اللَّهِ، قَالَا: وَلَدُ الزِّنَا بِمَنْزِلَةِ ابْنِ الْمُلَاعَنَةِ"".""","Da'if","Sunan al-Darimi 3136","","","45. ولد الزنا کے میراث پانے کا بیان"
"3137","(حديث مقطوع) أَخْبَرَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا زُهَيْرٌ، عَنْ الْحَسَنِ بْنِ الْحُرِّ، حَدَّثَنِي الْحَكَمُ: أَنَّ وَلَدَ الزِّنَا لَا يَرِثُهُ الَّذِي يَدَّعِيهِ، وَلَا يَرِثُهُ الْمَوْلُودُ"".""","Sahih","Sunan al-Darimi 3137","","","45. ولد الزنا کے میراث پانے کا بیان"
"3138","(حديث مقطوع) حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ، حَدَّثَنَا رَوْحٌ، عَنْ مُحَمَّدِ بْنِ أَبِي حَفْصَةَ، عَنْ الزُّهْرِيِّ، عَنْ عَلِيِّ بْنِ حُسَيْنٍ أَنَّهُ كَانَ لَا يُوَرِّثُ وَلَدَ الزِّنَا، وَإِنْ ادَّعَاهُ الرَّجُلُ"".""","Sahih","Sunan al-Darimi 3138","","","45. ولد الزنا کے میراث پانے کا بیان"
"3139","(حديث مرفوع) حَدَّثَنَا عَبْدُ اللَّهِ بْنُ صَالِحٍ، حَدَّثَنِي بَكْرُ بْنُ مُضَرَ، عَنْ عَمْرٍو يَعْنِي ابْنَ الْحَارِثِ، عَنْ بُكَيْرٍ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ، قَالَ:أَيُّمَا رَجُلٍ أَتَى إِلَى غُلَامٍ يَزْعُمُ أَنَّهُ ابْنٌ لَهُ، وَأَنَّهُ زَنَى بِأُمِّهِ، وَلَمْ يَدَّعِ ذَلِكَ الْغُلَامَ أَحَدٌ، فَهُوَ يَرِثُهُ"". قَالَ بُكَيْرٌ: وَسَأَلْتُ عُرْوَةَ عَنْ ذَلِكَ، فَقَالَ مِثْلَ قَوْلِ سُلَيْمَانَ بْنِ يَسَارٍ وَقَالَ عُرْوَةُ: بَلَغَنَا أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: ""الْوَلَدُ لِلْفِرَاشِ، وَلِلْعَاهِرِ الْحَجَرُ"".""","Da'if","Sunan al-Darimi 3139","","","45. ولد الزنا کے میراث پانے کا بیان"
"3140","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا إِبْرَاهِيمُ بْنُ مُوسَى، عَنْ حَفْصِ بْنِ غِيَاثٍ، عَنْ عَمْرٍو، عَنْ الْحَسَنِ، قَالَ: ابْنُ الْمُلَاعَنَةِ مِثْلُ وَلَدِ الزِّنَا، تَرِثُهُ أُمُّهُ، وَوَرَثَتُهُ، وَرَثَةُ أُمِّهِ"".""","Da'if","Sunan al-Darimi 3140","","","45. ولد الزنا کے میراث پانے کا بیان"
"3141","(حديث مقطوع) حَدَّثَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا أَبُو عَوَانَةَ، عَنْ مُغِيرَةَ، عَنْ إِبْرَاهِيمَ، قَالَ: لَا يُوَرَّثُ وَلَدُ الزِّنَا"".""","Sahih","Sunan al-Darimi 3141","","","45. ولد الزنا کے میراث پانے کا بیان"
"3142","(حديث مقطوع) حَدَّثَنَا سَعِيدُ بْنُ الْمُغِيرَةِ، عَنْ ابْنِ الْمُبَارَكِ، عَنْ مَعْمَرٍ، أَوْ يُونُسَ، عَنْ الزُّهْرِيِّ: فِي أَوْلَادِ الزِّنَا، قَالَ: يَتَوَارَثُونَ مِنْ قِبَلِ الْأُمَّهَاتِ، وَإِنْ وَلَدَتْ تَوْءَمًا فَمَاتَ، وَرِثَ السُّدُسَ"".""","Sahih","Sunan al-Darimi 3142","","","45. ولد الزنا کے میراث پانے کا بیان"
"3143","(حديث مقطوع) حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ، قَالَ: حَدَّثَنَا هُشَيْمٌ، عَنْ مُغِيرَةَ، عَنْ شِبَاكٍ، عَنْ إِبْرَاهِيمَ، قَالَ: لَا يَرِثُ وَلَدُ الزِّنَا، إنما يرث من لم يقم على أبيه الحد، أو تملك أمه بنكاح 3، أو شراء"".""","Da'if","Sunan al-Darimi 3143","","","45. ولد الزنا کے میراث پانے کا بیان"
"3144","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا إِسْمَاعِيل بْنُ أَبَانَ، عَنْ مُوسَى بْنِ مُحَمَّدٍ الْأَنْصَارِيِّ، عَنْ إِسْمَاعِيل، عَنْ الْحَسَنِ فِي الرَّجُلِ يَفْجُرُ بِالْمَرْأَةِ، ثُمَّ يَتَزَوَّجُهَا، قَالَ: لَا بَأْسَ، إِلَّا أَنْ تَكُونَ حُبْلَى، فَإِنَّ الْوَلَدَ لَا يَلْحَقُهُ"".""","Da'if","Sunan al-Darimi 3144","","","45. ولد الزنا کے میراث پانے کا بیان"
"3145","(حديث مرفوع) حَدَّثَنَا زَيْدُ بْنُ يَحْيَى، عَنْ مُحَمَّدِ بْنِ رَاشِدٍ، عَنْ سُلَيْمَانَ بْنِ مُوسَى، عَنْ عَمْرِو بْنِ شُعَيْبٍ، عَنْ أَبِيهِ، عَنْ جَدِّهِ: أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: قَضَى أَنَّ كُلَّ مُسْتَلْحَقٍ اسْتُلْحِقَ بَعْدَ أَبِيهِ الَّذِي ادَّعَاهُ وَرَثَتُهُ بَعْدَهُ، فَقَضَى إِنْ كَانَ مِنْ أَمَةٍ يَمْلِكُهَا يَوْمَ يَطَؤُهَا، فَقَدْ لَحِقَ بِمَنْ اسْتَلْحَقَهُ، وَلَيْسَ لَهُ فِيمَا قُسِمَ قَبْلَهُ مِنْ الْمِيرَاثِ شَيْءٌ، وَمَا أَدْرَكَ مِنْ مِيرَاثٍ لَمْ يُقْسَمْ، فَلَهُ نَصِيبُهُ، وَلَا يَلْحَقُ إِذَا كَانَ الَّذِي يُدْعَى لَهُ أَنْكَرَهُ، وَإِنْ كَانَ مِنْ أَمَةٍ لَا يَمْلِكُهَا، أَوْ حُرَّةٍ عَاهَرَهَا، فَإِنَّهُ لَا يَلْحَقُ وَلَا يَرِثُ، وَإِنْ كَانَ الَّذِي يُدْعَى لَهُ هُوَ ادَّعَاهُ، فَهُوَ وَلَدُ زِنَا لِأَهْلِ أُمِّهِ مَنْ كَانُوا: حُرَّةً، أَوْ أَمَةً"".""","Hasan","Sunan al-Darimi 3145","","","45. ولد الزنا کے میراث پانے کا بیان"
"3146","(حديث مقطوع) حَدَّثَنَا أَبُو نُعَيْمٍ، عَنْ الْحَسَنِ، عَنْ عُمَيْرِ بْنِ يَزِيدَ، قَالَ: سَأَلْتُ الشَّعْبِيَّ عَنْ مَمْلُوكٍ لِي وَلَدُ زِنًا، قَالَ: لَا تَبِعْهُ، وَلَا تَأْكُلْ ثَمَنَهُ، وَاسْتَخْدِمْهُ"".""","Sahih","Sunan al-Darimi 3146","","","45. ولد الزنا کے میراث پانے کا بیان"
"3147","(حديث مقطوع) حَدَّثَنَا مَرْوَانُ بْنُ مُحَمَّدٍ، عَنْ سَعِيدٍ، عَنْ الزُّهْرِيِّ: سُئِلَ عَنْ وَلَدِ زِنَا يَمُوتُ، قَالَ: إِنْ كَانَ ابْنَ عَرَبِيَّةٍ، وَرِثَتْ أُمُّهُ الثُّلُثَ، وَجُعِلَ بَقِيَّةُ مَالِهِ فِي بَيْتِ الْمَالِ، وَإِنْ كَانَ ابْنَ مَوْلَاةٍ، وَرِثَتْ أُمُّهُ الثُّلُثَ، وَوَرِثَ مَوَالِيهَا الَّذِينَ أَعْتَقُوهَا مَا بَقِيَ. قَالَ مَرْوَانُ: سَمِعْتُ مَالِكًا يَقُولُ ذَلِكَ.""","Sahih","Sunan al-Darimi 3147","","","45. ولد الزنا کے میراث پانے کا بیان"
"3148","(حديث مرفوع) حَدَّثَنَا مَرْوَانُ بْنُ مُحَمَّدٍ، حَدَّثَنَا الْهَيْثَمُ بْنُ حُمَيْدٍ، عَنْ الْعَلَاءِ بْنِ الْحَارِثِ، حَدَّثَنِي عَمْرُو بْنُ شُعَيْبٍ: أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: قَضَى بِمِيرَاثِ ابْنِ الْمُلَاعَنَةِ لِأُمِّهِ كُلِّهِ، لِمَا لَقِيَتْ فِيهِ مِنْ الْعَنَاءِ"".""","Sahih","Sunan al-Darimi 3148","","","45. ولد الزنا کے میراث پانے کا بیان"
"3149","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا إِسْمَاعِيل بْنُ أَبَانَ، عَنْ مُوسَى بْنِ مُحَمَّدٍ الْأَنْصَارِيِّ، قَالَ: حَدَّثَنِي الْحَارِثُ بْنُ حَصِيرَةَ، عَنْ زَيْدِ بْنِ وَهْبٍ، عَنْ عَلِيٍّ: أَنَّهُ قَالَ فِي وَلَدِ الزِّنَا لِأَوْلِيَاءِ أُمِّهِ: خُذُوا ابْنَكُمْ تَرِثُونَهُ وَتَعْقِلُونَهُ، وَلَا يَرِثُكُمْ"".""","Sahih","Sunan al-Darimi 3149","","","45. ولد الزنا کے میراث پانے کا بیان"
"3150","(حديث موقوف) أَخْبَرَنَا أَبُو نُعَيْمٍ، وَعَبْدُ اللَّهِ بْنُ يَزِيدَ، قَالَا: حَدَّثَنَا شُعْبَةُ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ، عَنْ أَبِي عَمْرٍو الشَّيْبَانِيِّ، قَالَ: َقَالَ عَبْدُ اللَّهِ: السَّائِبَةُ يَضَعُ مَالَهُ حَيْثُ شَاءَ"". قَالَ عَبْدُ اللَّهِ بْنُ يَزِيدَ: قَالَ شُعْبَةُ: لَمْ يَسْمَعْ هَذَا مِنْ سَلَمَةَ أَحَدٌ غَيْرِي.""","Sahih","Sunan al-Darimi 3150","","","46. آزاد کردہ غلام کی میراث کا بیان"
"3151","(حديث موقوف) أَخْبَرَنَا أَخْبَرَنَا الْحَكَمُ بْنُ الْمُبَارَكِ، حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ، عَنْ يُونُسَ، عَنْ الْحَسَنِ: سُئِلَ عَنْ مِيرَاثِ السَّائِبَةِ، فَقَالَ: كُلُّ عَتِيقٍ سَائِبَةٌ"".""","Sahih","Sunan al-Darimi 3151","","","46. آزاد کردہ غلام کی میراث کا بیان"
"3152","(حديث موقوف) أَخْبَرَنَا أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، أَنْبَأَنَا سُلَيْمَانُ، عَنْ أَبِي عُثْمَانَ، قَالَ: قَالَ عُمَرُ: الصَّدَقَةُ وَالسَّائِبَةُ لِيَوْمِهِمَا، أَوْ لِوَقْتِهِمَا"".""","Sahih","Sunan al-Darimi 3152","","","46. آزاد کردہ غلام کی میراث کا بیان"
"3153","(حديث مقطوع) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا زَكَرِيَّا، قَالَ: سُئِلَ عَامِرٍ عَنْ الْمَمْلُوكِ يُعْتَقُ سَائِبَةً لِمَنْ وَلَاؤُهُ؟ قَالَ: لِلَّذِي أَعْتَقَهُ"".""","Sahih","Sunan al-Darimi 3153","","","46. آزاد کردہ غلام کی میراث کا بیان"
"3154","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا أَبُو حَاتِمٍ الْبَصْرِيُّ هُوَ رَوْحُ بْنُ أَسْلَمَ، حَدَّثَنَا بِشْرُ بْنُ الْمُفَضَّلِ، حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ إِسْحَاق، عَنْ أَبِيهِ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَمْرٍو، قَالَ:مَاتَ مَوْلًى عَلَى عَهْدِ عُثْمَانَ وَلَيْسَ لَهُ وَالٍ، فَأَمَرَ بِمَالِهِ، فَأُدْخِلَ بَيْتَ الْمَالِ"".""","Da'if","Sunan al-Darimi 3154","","","46. آزاد کردہ غلام کی میراث کا بیان"
"3155","(حديث مقطوع) حَدَّثَنَا يَعْلَى، حَدَّثَنَا إِسْمَاعِيل، عَنْ عَامِرٍ، عَنْ مَسْرُوقٍ: فِي رَجُلٍ مَاتَ وَلَمْ يَكُنْ لَهُ مَوْلَى عَتَاقَةٍ، قَالَ: مَالُهُ حَيْثُ أَوْصَى بِهِ، فَإِنْ لَمْ يَكُنْ أَوْصَى، فَهُوَ فِي بَيْتِ الْمَالِ"".""","Sahih","Sunan al-Darimi 3155","","","46. آزاد کردہ غلام کی میراث کا بیان"
"3156","(حديث مقطوع) حَدَّثَنَا أَبُو سَعِيدِ بْنُ عَمْرٍو، عَنْ أَبِي بَكْرِ بْنِ أَبِي مَرْيَمَ، عَنْ ضَمْرَةَ، وَرَاشِدِ بْنِ سَعْدٍ، وَغَيْرِهِمَا، قَالُوا فِيمَنْ أُعْتِقَ سَائِبَةً: إِنَّ وَلَاءَهُ لِمَنْ أَعْتَقَهُ، إِنَّمَا سَيَّبَهُ مِنْ الرِّقِّ، وَلَمْ يُسَيِّبْهُ مِنْ الْوَلَاءِ"".""","Da'if","Sunan al-Darimi 3156","","","46. آزاد کردہ غلام کی میراث کا بیان"
"3157","(حديث مقطوع) حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ، حَدَّثَنَا أَبُو دَاوُدَ، عَنْ شُعْبَةَ، قَالَ: أَخْبَرَنِي مَنْصُورٌ، عَنْ إِبْرَاهِيمَ، وَالشَّعْبِيِّ، قَالَا: لَا بَأْسَ بِبَيْعِ وَلَاءِ السَّائِبَةِ وَهِبَتِهِ"".""","Sahih","Sunan al-Darimi 3157","","","46. آزاد کردہ غلام کی میراث کا بیان"
"3158","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا الْمَسْعُودِيُّ، عَنْ الْقَاسِمِ، قَالَ:أَعْتَقَ رَجُلٌ غُلَامًا سَائِبَةً، فَأَتَى عَبْدَ اللَّهِ، وَقَالَ: إِنِّي أَعْتَقْتُ غُلَامًا لِي سَائِبَةً، وَهَذِهِ تَرِكَتُهُ، قَالَ: هِيَ لَكَ، قَالَ: لَا حَاجَةَ لِي فِيهَا، قَالَ: فَضَعْهَا، فَإِنَّ هَهُنَا وَارِثًا كَثِيرًا"".""","Da'if","Sunan al-Darimi 3158","","","46. آزاد کردہ غلام کی میراث کا بیان"
"3159","(حديث موقوف) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، أَنْبَأَنَا الْأَشْعَثُ، عَنْ أَبِي الزُّبَيْرِ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ، قَالَ: إِذَا اسْتَهَلَّ الصَّبِيُّ، وُرِّثَ وَصُلِّيَ عَلَيْهِ"".""","Da'if","Sunan al-Darimi 3159","","","47. نومولود بچے کی وراثت کا بیان"
"3160","(حديث موقوف) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا شَرِيكٌ، عَنْ أَبِي إِسْحَاق، عَنْ عَطَاءٍ، عَنْ ابْنِ عَبَّاسٍ، قَالَ: إِذَا اسْتَهَلَّ الصَّبِيُّ، وَرِثَ وَوُرِثَ وَصُلِّيَ عَلَيْهِ"".""","Da'if","Sunan al-Darimi 3160","","","47. نومولود بچے کی وراثت کا بیان"
"3161","(حديث موقوف) حَدَّثَنَا مَالِكُ بْنُ إِسْمَاعِيل، حَدَّثَنَا إِسْرَائِيلُ، عَنْ سِمَاكٍ، عَنْ عِكْرِمَةَ، عَنْ ابْنِ عَبَّاسٍ، قَالَ: لَيْسَ مِنْ مَوْلُودٍ إِلَّا يَسْتَهِلُّ، وَاسْتِهْلَالُهُ بِعَصْرِ الشَّيْطَانُ بَطْنَهُ، فَيَصِيحُ، إِلَّا عِيسَى ابْنَ مَرْيَمَ"".""","Da'if","Sunan al-Darimi 3161","","","47. نومولود بچے کی وراثت کا بیان"
"3162","(حديث مرفوع) حَدَّثَنَا يَحْيَى بْنُ حَسَّانَ، حَدَّثَنَا يَحْيَى هُوَ ابْنُ حَمْزَةَ، عَنْ زَيْدِ بْنِ وَاقِدٍ، عَنْ مَكْحُولٍ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: لَا يَرِثُ الْمَوْلُودُ حَتَّى يَسْتَهِلَّ صَارِخًا، وَإِنْ وَقَعَ حَيًّا"".""","Sahih","Sunan al-Darimi 3162","","","47. نومولود بچے کی وراثت کا بیان"
"3163","(حديث موقوف) حَدَّثَنَا يَعْلَى، حَدَّثَنَا مُحَمَّدُ بْنُ إِسْحَاق، عَنْ عَطَاءٍ، عَنْ جَابِرٍ، قَالَ: إِذَا اسْتَهَلَّ الْمَوْلُودُ، صُلِّيَ عَلَيْهِ وَوُرِثَ"".""","Da'if","Sunan al-Darimi 3163","","","47. نومولود بچے کی وراثت کا بیان"
"3164","(حديث مقطوع) حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مُحَمَّدٍ، حَدَّثَنَا مَعْنٌ، عَنْ ابْنِ أَبِي ذِئْبٍ، عَنْ الزُّهْرِيِّ، قَالَ: أَرَى الْعُطَاسَ اسْتِهْلَالًا"".""","Sahih","Sunan al-Darimi 3164","","","47. نومولود بچے کی وراثت کا بیان"
"3165","(حديث مقطوع) حَدَّثَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا أَبُو عَوَانَةَ، عَنْ مُغِيرَةَ، عَنْ إِبْرَاهِيمَ، قَالَ: لَا يُوَرَّثُ الْمَوْلُودُ حَتَّى يَسْتَهِلَّ، وَلَا يُصَلَّى عَلَيْهِ حَتَّى يَسْتَهِلَّ، فَإِذَا اسْتَهَلَّ، صُلِّيَ عَلَيْهِ وَوُرِّثَ، وَكُمِّلَتْ الدِّيَةُ"".""","Sahih","Sunan al-Darimi 3165","","","47. نومولود بچے کی وراثت کا بیان"
"3166","(حديث مقطوع) حَدَّثَنَا عَبْدُ اللَّهِ بْنُ صَالِحٍ، حَدَّثَنِي اللَّيْثُ، حَدَّثَنِي يُونُسُ، عَنْ ابْنِ شِهَابٍ: وَسَأَلْنَاهُ عَنْ السِّقْطِ، فَقَالَ: لَا يُصَلَّى عَلَيْهِ، وَلَا يُصَلَّى عَلَى مَوْلُودٍ حَتَّى يَسْتَهِلَّ صَارِخًا"".""","Da'if","Sunan al-Darimi 3166","","","47. نومولود بچے کی وراثت کا بیان"
"3167","(حديث مقطوع) حَدَّثَنَا هَارُونُ بْنُ مُعَاوِيَةَ، عَنْ أَبِي سُفْيَانَ، عَنْ مَعْمَرٍ، عَنْ قَتَادَةَ، قَالَ: إِذَا ابْتَاعَ الْمُكَاتَبَانِ أَحَدُهُمَا الْآخَرَ: هَذَا هَذَا مِنْ سَيِّدِهِ، وَهَذَا هَذَا مِنْ سَيِّدِهِ، فَالْبَيْعُ لِلْأَوَّلِ. وَيَقُولُ أَهْلُ الْمَدِينَةِ: الْوَلَاءُ لِسَيِّدِ الْبَائِعِ، وَيَقُولُونَ: إِنَّمَا ابْتَاعَ هَذَا مَا عَلَى الْمُكَاتَبِ، فَالْوَلَاءُ لِلسَّيِّدِ.""","Sahih","Sunan al-Darimi 3167","","","48. مکاتب کے حق میراث کا بیان"
"3168","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا يَزِيدُ بْنُ هَارُونَ، حَدَّثَنَا يَحْيَى، عَنْ سَعِيدٍ، أَنَّ عُمَرَ، قَالَ: أَيُّمَا حُرٍّ تَزَوَّجَ أَمَةً، فَقَدْ أَرَقَّ نِصْفَهُ، وَأَيُّمَا عَبْدٍ تَزَوَّجَ حُرَّةً، فَقَدْ أَعْتَقَ نِصْفَهُ، قَالَ أَبُو مُحَمَّد: يَعْنِي الْوَلَدَ.""","","Sunan al-Darimi 3168","","","49. آزاد آدمی لونڈی سے نکاح کر لے تو . . ."
"3169","(حديث مقطوع) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللَّهِ، حَدَّثَنَا أَبُو شِهَابٍ، عَنْ الشَّيْبَانِيِّ، عَنْ الشَّعْبِيِّ: فِي الْعَبْدِ يَتَزَوَّجُ الْمَرْأَةَ، ثُمَّ يُطَلِّقُهَا وَلَهُ مِنْهَا وَلَدٌ؟ قَالَ: إِنْ كَانَتْ حُرَّةً، فَالنَّفَقَةُ عَلَى أُمِّهِ، وَإِنْ كَانَ عَبْدًا، يَعْنِي: الصَّبِيَّ، فَعَلَى مُوَالِيهِ"".""","Sahih","Sunan al-Darimi 3169","","","50. ولاء کی میراث کا بیان"
"3170","(حديث مقطوع) حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا هُشَيْمٌ، حَدَّثَنَا زَكَرِيَّا، عَنْ عَامِرٍ. ح وحَدَّثَنَا جَرِيرٌ، عَنْ مُغِيرَةَ، عَنْ إِبْرَاهِيمَ: أَنَّهُمَا قَالَا: وَلَاؤُهُ لِمَنْ بَدَأَ بِالْعِتْقِ أَوَّلَ مَرَّةٍ"".""","Sahih","Sunan al-Darimi 3170","","","50. ولاء کی میراث کا بیان"
"3171","(حديث مقطوع) حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا هُشَيْمٌ، أنبأنا يُونُسُ، عَنْ الْحَسَنِ. ح وحَدَّثَنَا جَرِيرٌ، عَنْ أَبَانَ بْنِ تَغْلِبَ، عَنْ الْحَكَمِ، عَنْ إِبْرَاهِيمَ، أَنَّهُمَا قَالَا: إِنْ ضَمِنَ، كَانَ الْوَلَاءُ لَهُ، وَإِنْ اسْتَسْعَى الْعَبْدُ، كَانَ الْوَلَاءُ بَيْنَهُمْ"".""","Hasan","Sunan al-Darimi 3171","","","51. غلام دو مالکان کا ہو اور ایک اپنا حصہ آزاد کر دے"
"3172","(حديث مقطوع) حَدَّثَنَا يَعْلَى، وَأَبُو نُعَيْمٍ، قَالَا: حَدَّثَنَا زَكَرِيَّا، عَنْ عَامِرٍ: فِي عَبْدٍ بَيْنَ رَجُلَيْنِ أَعْتَقَ أَحَدُهُمَا نَصِيبَهُ، فَقَالَ: يُتَمَّمُ عِتْقُهُ، فَإِنْ لَمْ يَكُنْ لَهُ مَالٌ، اسْتُسْعِيَ الْعَبْدُ فِي النِّصْفِ بِقِيمَةِ عَدْلٍ، وَالْوَلَاءُ لِمَنْ أَعْتَقَ"".""","Sahih","Sunan al-Darimi 3172","","","51. غلام دو مالکان کا ہو اور ایک اپنا حصہ آزاد کر دے"
"3173","(حديث مقطوع) حَدَّثَنَا هَارُونُ بْنُ مُعَاوِيَةَ، عَنْ أَبِي سُفْيَانَ الْمَعْمَرِيِّ، عَنْ مَعْمَرٍ، عَنْ ابْنِ طَاوُسٍ، عَنْ أَبِيهِ: فِي عَبْدٍ بَيْنَ رَجُلَيْنِ، أَعْتَقَ أَحَدَهُمَا نَصِيبَهُ وَأَمْسَكَهُ الْآخَرُ، قَالَ: مِيرَاثُهُ بَيْنَهُمَا"".""","Sahih","Sunan al-Darimi 3173","","","51. غلام دو مالکان کا ہو اور ایک اپنا حصہ آزاد کر دے"
"3174","(حديث مقطوع) حَدَّثَنَا هَارُونُ، عَنْ أَبِي سُفْيَانَ، عَنْ مَعْمَرٍ، عَنْ الزُّهْرِيِّ، قَالَ: مِيرَاثُهُ لِلَّذِي أَمْسَكَهُ. وقال قَتَادَةُ: هُوَ لِلْمُعْتِقِ كُلُّهُ، وَثَمَنُهُ عَلَيْهِ، وَيَقُولُهُ أَهْلُ الْكُوفَةِ.""","Sahih","Sunan al-Darimi 3174","","","51. غلام دو مالکان کا ہو اور ایک اپنا حصہ آزاد کر دے"
"3175","(حديث مقطوع) حَدَّثَنَا يَعْلَى بْنُ عُبَيْدٍ، حَدَّثَنَا عَبْدُ الْمَلِكِ، عَنْ عَطَاءٍ: فِي الرَّجُلِ يَمُوتُ وَيَتْرُكُ مُكَاتَبًا، وَلَهُ بَنُونَ وَبَنَاتٌ، أَيَكُونُ لِلنِّسَاءِ مِنْ الْوَلَاءِ شَيْءٌ؟ قَالَ: تَرِثُ النِّسَاءُ مِمَّا عَلَى ظَهْرِهِ مِنْ مُكَاتَبَتِهِ، وَيَكُونُ الْوَلَاءُ لِلرِّجَالِ دُونَ النِّسَاءِ، إِلَّا مَا كَاتَبْنَ، أَوْ أَعْتَقْنَ"".""","Sahih","Sunan al-Darimi 3175","","","52. کیا ولاء میں عورتوں کا بھی حق ہے؟"
"3176","(حديث مقطوع) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا شَرِيكٌ، عَنْ لَيْثٍ، عَنْ طَاوُسٍ، قَالَ: لَا تَرِثُ النِّسَاءُ مِنْ الْوَلَاءِ إِلَّا مَا أَعْتَقْنَ، أَوْ أَعْتَقَ مَنْ أَعْتَقْنَ"".""","Da'if","Sunan al-Darimi 3176","","","52. کیا ولاء میں عورتوں کا بھی حق ہے؟"
"3177","(حديث مقطوع) حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا أَبُو سُفْيَانَ، عَنْ مَعْمَرٍ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ، قَالَ: تُوُفِّيَ رَجُلٌ وَتَرَكَ مُكَاتَبًا، ثُمَّ مَاتَ الْمُكَاتَبُ وَتَرَكَ مَالًا، فَجَعَلَ ابْنُ الْمُسَيَّبِ، وَأَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ مَا بَقِيَ مِنْ مُكَاتَبَتِهِ بَيْنَ بَنِي مَوْلَاهُ الرِّجَالُ وَالنِّسَاءُ عَلَى مِيرَاثِهِمْ، وَمَا فَضَلَ مِنْ الْمَالِ بَعْدَ كِتَابَتِهِ، فَلِلرِّجَالِ مِنْهُمْ مِنْ بَنِي مَوْلَاهُ، دُونَ النِّسَاءِ"".""","Sahih","Sunan al-Darimi 3177","","","52. کیا ولاء میں عورتوں کا بھی حق ہے؟"
"3178","(حديث موقوف) أَخْبَرَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا عَبْدُ السَّلَامِ بْنُ حَرْبٍ، عَنْ الْأَعْمَشِ، عَنْ إِبْرَاهِيمَ، عَنْ عُمَرَ، وَعَلِيٍّ، وَزَيْدٍ، أَنَّهُمْ قَالُوا: الْوَلَاءُ لِلْكُبْرِ، وَلَا يَرِثُونَ النِّسَاءَ مِنْ الْوَلَاءِ إِلَّا مَا أَعْتَقْنَ، أَوْ كَاتَبْنَ"".""","","Sunan al-Darimi 3178","","","52. کیا ولاء میں عورتوں کا بھی حق ہے؟"
"3179","(حديث مقطوع) حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا إِسْمَاعِيل بْنُ إِبْرَاهِيمَ، عَنْ خَالِدٍ، عَنْ أَبِي قِلَابَةَ. ح وحَدَّثَنَا ابْنُ وَهْبٍ، عَنْ يُونُسَ، عَنْ الزُّهْرِيِّ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ. ح وحَدَّثَنَا ابْنُ أَبِي الزِّنَادِ، عَنْ أَبِيهِ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ: أَنَّهُمْ قَالُوا: لَا يَرِثُ النِّسَاءُ مِنْ الْوَلَاءِ إِلَّا مَا أَعْتَقْنَ، أَوْ كَاتَبْنَ"".""","Hasan","Sunan al-Darimi 3179","","","52. کیا ولاء میں عورتوں کا بھی حق ہے؟"
"3180","(حديث مقطوع) حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، عن مُعَاذٌ، عَنْ أَشْعَثَ، عَنْ الْحَسَنِ، قَالَ: لَا تَرِثُ النِّسَاءُ مِنْ الْوَلَاءِ إِلَّا مَا أَعْتَقْنَ، أَوْ أَعْتَقَ مَنْ أَعْتَقْنَ، إِلَّا الْمُلَاعَنَةُ، فَإِنَّهَا تَرِثُ مَنْ أَعْتَقَ ابْنُهَا، وَالَّذِي انْتَفَى مِنْهُ أَبُوهُ"".""","Sahih","Sunan al-Darimi 3180","","","52. کیا ولاء میں عورتوں کا بھی حق ہے؟"
"3181","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا ابْنُ وَهْبٍ، عَنْ يُونُسَ، عَنْ الزُّهْرِيِّ، عَنْ سَالِمٍ، عَنْ أَبِيهِ: أَنَّهُ كَانَ يَرِثُ مَوَالِيَ عُمَرَ دُونَ بَنَاتِ عُمَرَ"".""","Sahih","Sunan al-Darimi 3181","","","52. کیا ولاء میں عورتوں کا بھی حق ہے؟"
"3182","(حديث مقطوع) أَخْبَرَنَا عَمْرُو بْنُ عَوْنٍ، عَنْ خَالِدِ بْنِ عَبْدِ اللَّهِ، عَنْ خَالِدٍ الْحَذَّاءِ، عَنْ أَبِي قِلَابَةَ فِي امْرَأَةٍ مَاتَتْ، وَتَرَكَتْ بَنِيهَا، فَوَرِثُوهَا مَالًا وَمَوَالِيَ، قَالَ: يَرْجِعُ الْوَلَاءُ إِلَى عَصَبَةِ الْمَرْأَةِ"".""","Sahih","Sunan al-Darimi 3182","","","52. کیا ولاء میں عورتوں کا بھی حق ہے؟"
"3183","(حديث مقطوع) حَدَّثَنَا عُبَيْدُ اللَّهِ، عَنْ إِسْرَائِيلَ، عَنْ مَنْصُورٍ، قَالَ: سَأَلْتُ إِبْرَاهِيمَ عَنْ رَجُلٍ كَاتَبَ عَبْدًا لَهُ، ثُمَّ مَاتَ وَتَرَكَ وَلَدًا رِجَالًا وَنِسَاءً، قَالَ: لِلذُّكُورِ دُونَ الْإِنَاثِ"".""","Sahih","Sunan al-Darimi 3183","","","52. کیا ولاء میں عورتوں کا بھی حق ہے؟"
"3184","(حديث مقطوع) حَدَّثَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا وُهَيْبٌ، حَدَّثَنَا يُونُسُ، عَنْ الْحَسَنِ، أَنَّهُ كَانَ يَقُولُ فِي امْرَأَةٍ مَاتَتْ وَتَرَكَتْ مَوْلًى، قَالَ: الْوَلَاءُ لِبَنِيهَا، فَإِذَا مَاتُوا، رَجَعَ إِلَى عَصَبَتِهَا"".""","Sahih","Sunan al-Darimi 3184","","","52. کیا ولاء میں عورتوں کا بھی حق ہے؟"
"3185","(حديث مقطوع) حَدَّثَنَا سَعِيدُ بْنُ عَامِرٍ، أَخْبَرَنَا شُعْبَةُ، عَنْ مُغِيرَةَ، عَنْ إِبْرَاهِيمَ قَالَ: لَيْسَ لِلنِّسَاءِ مِنْ الْوَلَاءِ شَيْءٌ، إِلَّا مَا أَعْتَقَتْ هِيَ فيَ نَفْسِهَا"".""","Sahih","Sunan al-Darimi 3185","","","52. کیا ولاء میں عورتوں کا بھی حق ہے؟"
"3186","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا سَعِيدُ بْنُ عَامِرٍ، عَنْ ابْنِ عَوْنٍ، عَنْ مُحَمَّدٍ، قَالَ: مَاتَ مَوْلًى لِعُمَرَ، فَسَأَلَ ابْنُ عُمَرَ زَيْدَ بْنَ ثَابِتٍ، فَقَالَ: هَلْ لِبَنَاتِ عُمَرَ مِنْ مِيرَاثِهِ شَيْءٌ؟ قَالَ: مَا أَرَى لَهُنَّ شَيْئًا، وَإِنْ شِئْتَ أَنْ تُعْطِيَهُنَّ، أَعْطَيْتَهُنَّ"".""","Sahih","Sunan al-Darimi 3186","","","52. کیا ولاء میں عورتوں کا بھی حق ہے؟"
"3187","(حديث مقطوع) حَدَّثَنَا عَبْدُ اللَّهِ بْنُ سَعِيدٍ، حَدَّثَنَا أَبُو أُسَامَةَ، عَنْ هِشَامٍ، عَنْ أَبِيهِ، قَالَ: يُحْرِزُ الْوَلَاءَ مَنْ يُحْرِزُ الْمِيرَاثَ"".""","Sahih","Sunan al-Darimi 3187","","","52. کیا ولاء میں عورتوں کا بھی حق ہے؟"
"3188","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا عَبْدُ اللَّهِ بْنُ سَعِيدٍ، حَدَّثَنَا أَبُو خَالِدٍ، حَدَّثَنَا يَحْيَى، عَنْ أَبِي بَكْرِ بْنِ عَمْرِو بْنِ حَزْمٍ: أَنَّ امْرَأَةً مِنْ مُحَارِبٍ وَهَبَتْ وَلَاءَ عَبْدِهَا لِنَفْسِهِ، فَأَعْتَقَتْهُ، فَوَهَبَ وَلاءَ نَفْسِهِ لِعَبْدِ الرَّحْمَنِ بْنِ عَمْرِو بْنِ حَزْمٍ، وَمَاتَتْ، فَخَاصَمَتِ الْمَوَالِيَ إِلَى عُثْمَانَ، فَدَعَا عُثْمَانُ الْبَيِّنَةَ عَلَى مَا قَالَ، قَالَ: فَأَتَى الْبَيِّنَةُ، فَقَالَ لَهُ عُثْمَانُ: اذْهَبْ، فَوَالِ مَنْ شِئْتَ"". قَالَ أَبُو بَكْرٍ: فَوَالَى عَبْدَ الرَّحْمَنِ بْنَ عَمْرِو بْنِ حَزْمٍ.""","Sahih","Sunan al-Darimi 3188","","","52. کیا ولاء میں عورتوں کا بھی حق ہے؟"
"3189","(حديث مرفوع) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا سُفْيَانُ، عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ، عَنْ ابْنِ عُمَرَ، قَالَ:نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ الْوَلَاءِ، وَعَنْ هِبَتِهِ"".""","Sahih","Sunan al-Darimi 3189","","","53. ولاء کو بیچنے کا بیان"
"3190","(حديث مرفوع) حَدَّثَنَا مُسْلِمٌ، حَدَّثَنَا شُعْبَةُ، حَدَّثَنَا عَبْدُ اللَّهِ بْنُ دِينَارٍ، عَنْ ابْنِ عُمَرَ:أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْ بَيْعِ الْوَلَاءِ، وَعَنْ هِبَتِهِ"".""","Sahih","Sunan al-Darimi 3190","","","53. ولاء کو بیچنے کا بیان"
"3191","(حديث موقوف) حَدَّثَنَا يَعْلَى، حَدَّثَنَا عَبْدُ الْمَلِكِ، عَنْ عَطَاءٍ، قَالَ: سَمِعْتُ ابْنَ عَبَّاسٍ، يَقُولُ: لَا يُبَاعُ الْوَلَاءُ وَلَا يُوهَبُ، وَالْوَلَاءُ لِمَنْ أَعْتَقَ"".""","Sahih","Sunan al-Darimi 3191","","","53. ولاء کو بیچنے کا بیان"
"3192","(حديث موقوف) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ، عَنْ سَعِيدٍ، عَنْ أَبِي مَعْشَرٍ، عَنْ إِبْرَاهِيمَ، قَالَ: قَالَ عَبْدُ اللَّهِ: الْوَلَاءُ لُحْمَةٌ كَلُحْمَةِ النَّسَبِ، لَا يُبَاعُ وَلَا يُوهَبُ"".""","Sahih","Sunan al-Darimi 3192","","","53. ولاء کو بیچنے کا بیان"
"3193","(حديث مقطوع) حَدَّثَنَا مُسْلِم، حَدَّثَنَا هَمَّامٌ، حَدَّثَنَا قَتَادَةُ، عَنْ الْحَسَنِ، وَسَعِيدِ بْنِ الْمُسَيِّبِ:أنهما كرها بيع الولاء"".""","Sahih","Sunan al-Darimi 3193","","","53. ولاء کو بیچنے کا بیان"
"3194","(حديث موقوف) حَدَّثَنَا عَبْدُ اللَّهِ بْنُ سَعِيدٍ، حَدَّثَنَا ابْنُ إِدْرِيسَ، عَنْ ابْنِ جُرَيْجٍ، عَنْ عَطَاءٍ، قَالَ: قَالَ ابْنُ عَبَّاسٍ: لَا يُبَاعُ الْوَلَاءُ، أَيُؤْكَلُ بِرَقَبَةِ رَجُلٍ مَرَّتَيْنِ؟"".""","Sahih","Sunan al-Darimi 3194","","","53. ولاء کو بیچنے کا بیان"
"3195","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا سُفْيَانُ، عَنْ ابْنِ جُرَيْجٍ، عَنْ عَطَاءٍ، عَنْ ابْنِ عَبَّاسٍ، قَالَ: الْفَرَائِضُ مِنْ سِتَّةٍ، لَا نُعِيلُهَا"".""","Da'if","Sunan al-Darimi 3195","","","54. فرائض میں عول کا بیان"
"3196","(حديث مقطوع) حَدَّثَنَا مُحَمَّدُ بْنُ عِمْرَانَ، عَنْ مُعَاوِيَةَ بْنِ مَيْسَرَةَ بْنِ شُرَيْحٍ، عَنْ شريح بْنِ الْحَارِثِ، قَالَ:اخْتُصِمَ إِلَى شُرَيْحٍ فِي بِنْتَيْنِ، وَأَبَوَيْنِ، وَزَوْجٍ، فَقَضَى فِيهَا، فَأَقْبَلَ الزَّوْجُ يَشْكُوهُ فِي الْمَسْجِدِ، فَأَرْسَلَ إِلَيْهِ عَبْدَ اللَّهِ بْنَ رَبَاحٍ فَأَخَذَهُ، وَبَعَثَ إِلَى شُرَيْحٍ، فَقَالَ: مَا يَقُولُ هَذَا؟ قَالَ: هَذَا يَخَالُنِي امْرَأً جَائِرًا، وَأَنَا إِخَالُهُ امْرَأً فَاجِرًا، يُظْهِرُ الشَّكْوَى وَيَكْتُمُ قَضَاءً سَائِرًا، فَقَالَ لَهُ الرَّجُلُ: مَا تَقُولُ فِي بِنْتَيْنِ، وَأَبَوَيْنِ، وَزَوْجٍ؟ فَقَالَ: لِلزَّوْجِ الرُّبُعُ مِنْ جَمِيعِ الْمَالِ، وَلِلْأَبَوَيْنِ السُّدُسَانِ، وَمَا بَقِيَ فَلِلِابْنَتَيْنِ، قَالَ: فَلِأَيِّ شَيْءٍ نَقَصْتَنِي؟ قَالَ: لَيْسَ أَنَا نَقَصْتُكَ، اللَّهُ نَقَصَكَ، لِلِابْنَتَيْنِ الثُّلُثَانِ، وَلِلْأَبَوَيْنِ السُّدُسَانِ، وَلِلزَّوْجِ الرُّبُعُ، فَهِيَ مِنْ سَبْعَةٍ وَنِصْفٍ فَرِيضَةً، فَرِيضَتُكَ عَائِلَةٌ"".""","Da'if","Sunan al-Darimi 3196","","","54. فرائض میں عول کا بیان"
