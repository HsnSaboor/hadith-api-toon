hadiths[40]{hadithnumber,text}:
"1","[AI-translation] Haber, görmek gibi değildir."
"2","[AI-translation] Harp hiledir."
"3","[AI-translation] Müslüman müslümanın aynasıdır."
"4","[AI-translation] Kendisine danışılan emindir."
"5","[AI-translation] Hayra delalet eden, onu işleyen gibidir."
"6","[AI-translation] İhtiyaçlarınızı gizlemekle yardım isteyin."
"7","[AI-translation] Ateşten korunun, yarım hurma ile de olsa."
"8","[AI-translation] Dünya mü'minin hapishanesi, kâfirin cennetidir."
"9","[AI-translation] Hayâ, tamamıyla hayırdır."
"10","[AI-translation] Mü'minin vaadi, el tutmak gibidir."
"11","[AI-translation] Bir müminin kardeşini üç günden fazla terk etmesi helal değildir."
"12","[AI-translation] Bizi aldatan bizden değildir."
"13","[AI-translation] Az ve kâfi olan, çok ve oyalayandan hayırlıdır."
"14","[AI-translation] Hediyesini geri alan, kusmuğuna geri dönen gibidir."
"15","[AI-translation] Belâ, söze bağlıdır."
"16","[AI-translation] İnsanlar, tarağın dişleri gibidir."
"17","[AI-translation] Zenginlik, gönül zenginliğidir."
"18","[AI-translation] Saadete eren, başkası üzerinden öğütlenendir."
"19","[AI-translation] Şüphesiz ki şiirde hikmet vardır ve şüphesiz ki beyanda sihir vardır."
"20","[AI-translation] Meliklerin affı, mülkü baki kılmaktır."
"21","[AI-translation] Kişi, sevdiğiyle beraberdir."
"22","[AI-translation] Kadrini bilen kişi helak olmaz."
"23","[AI-translation] Çocuk yatağa aittir, zina edene de taş vardır."
"24","[AI-translation] Veren el, alan elden hayırlıdır."
"25","[AI-translation] İnsanlara şükretmeyen, Allah'a da şükretmemiş olur."
"26","[AI-translation] Bir şeyi sevmen seni kör ve sağır eder."
"27","[AI-translation] Kalpler, kendilerine iyilik edeni sevmeye ve kendilerine kötülük edene buğzetmeye yaratılmıştır."
"28","[AI-translation] Günahından tövbe eden, günahı olmayan kimse gibidir."
"29","[AI-translation] Şâhid, gâibin göremediğini görür."
"30","[AI-translation] Bir kavmin kerem sahibi size gelirse ona ikram edin."
"31","[AI-translation] Fâcir yemin yurtları boş bırakır."
"32","[AI-translation] Malı uğrunda öldürülen şehîddir."
"33","[AI-translation] Ameller niyetlere göredir."
"34","[AI-translation] Kavmin efendisi onlara hizmet edendir."
"35","[AI-translation] İşlerin en hayırlısı orta olanıdır."
"36","[AI-translation] Allah'ım! Ümmetime Perşembe günü sabahında bereket ver."
"37","[AI-translation] Fakirlik neredeyse küfür olacaktır."
"38","[AI-translation] Yolculuk azabın bir parçasıdır."
"39","[AI-translation] Azıkların en hayırlısı takvadır."
"40","[AI-translation] Meclisler emanet üzeredir."
