hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"7015","(۷۰۱۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ لاَ یَقْنُتُ السَّنَۃَ کُلَّہَا فِی الْفَجْرِ ، وَیَقْنُتُ فِی الْوِتْرِ کُلَّ لَیْلَۃٍ قَبْلَ الرُّکُوعِ ۔ قَالَ أَبُو بَکْرٍ : ہَذَا الْقَوْلُ عِنْدَنَا۔","","Musannaf Ibn Abi Shaybah 7015","","","كتاب الجمعة"
"7016","(۷۰۱۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ ، عَنْ عَلِیٍّ ، قَالَ : إِنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ فِی آخِرِ وِتْرِہِ : اللَّہُمَّ إِنِّی أَعُوذُ بِرِضَاکَ مِنْ سَخَطِکَ، وَأَعُوذُ بِمُعَافَاتِکَ مِنْ عُقُوبَتِکَ ، وَأَعُوذُ بِکَ مِنْکَ ، لاَ أُحْصِی ثَنَائً عَلَیْکَ ، أَنْتَ کَمَا أَثْنَیْتَ عَلَی نَفْسِکَ۔ (ترمذی ۳۵۶۶۔ ابوداؤد ۱۴۲۲)","Sahih","Musannaf Ibn Abi Shaybah 7016","","","كتاب الجمعة"
"7017","(۷۰۱۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنْ رَجُلٍ ، عَنْ أَبِی الْمُہَزِّمِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : نَزَلْتُ عَلَیْہِ عَشْرَ سِنِینَ ، فَمَا رَأَیْتُہُ قَنَتَ فِی وِتْرِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 7017","","","كتاب الجمعة"
"7018","(۷۰۱۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ لاَ یَقْنُتُ فِی الْفَجْرِ، وَلاَ فِی الْوِتْرِ ، وَکَانَ إِذَا سُئِلَ عَنِ الْقُنُوتِ ، قَالَ : مَا نَعْلَمُ الْقُنُوتَ إِلاَّ طُولَ الْقِیَامِ ، وَقِرَائَۃَ الْقُرْآنِ۔","Sahih","Musannaf Ibn Abi Shaybah 7018","","","كتاب الجمعة"
"7019","(۷۰۱۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّمَا الْوِتْرُ عَلَی أَہْلِ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 7019","","","كتاب الجمعة"
"7020","(۷۰۲۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مِسْعَرٍ ، عَنْ حَمَّادٍ ، قَالَ : إِذَا سَہَا قَبْلَ أَنْ یَقْنُتَ ، فَلْیَسْجُدْ سَجْدَتَیِ السَّہْوِ ۔ یَعْنِی فِی الْوِتْرِ۔","","Musannaf Ibn Abi Shaybah 7020","","","كتاب الجمعة"
"7021","(۷۰۲۱) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ؛ أَنَّ عَبْدَ اللہِ بْنَ مَسْعُودٍ کَانَ إِذَا فَرَغَ مِنَ الْقِرَائَۃِ کَبَّرَ ثُمَّ قَنَتَ ، فَإِذَا فَرَغَ مِنَ الْقُنُوتِ کَبَّرَ ثُمَّ رَکَعَ۔","Da'if","Musannaf Ibn Abi Shaybah 7021","","","كتاب الجمعة"
"7022","(۷۰۲۲) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا أَرَدْتَ أَنْ تَقْنُتَ ، فَکَبِّرْ لِلْقُنُوتِ ، وَکَبِّرْ إِذَا أَرَدْتَ أَنْ تَرْکَعَ۔","","Musannaf Ibn Abi Shaybah 7022","","","كتاب الجمعة"
"7023","(۷۰۲۳) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَانَ یُکَبِّرُ إِذَا قَنَتَ ، وَیُکَبِّرُ إِذَا فَرَغَ۔","","Musannaf Ibn Abi Shaybah 7023","","","كتاب الجمعة"
"7024","(۷۰۲۴) حَدَّثَنَا ہُشَیْمٌ، عَنْ مُغِیرَۃَ، عَنْ إِبْرَاہِیمَ، قَالَ: إِذَا فَرَغْتَ مِنَ الْقِرَائَۃِ فَکَبِّرْ، ثُمَّ إِذَا فَرَغْتَ فَکَبِّرْ وَارْکَعْ۔","","Musannaf Ibn Abi Shaybah 7024","","","كتاب الجمعة"
"7025","(۷۰۲۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَمِعْتُ الْحَکَمَ ، وَحَمَّادًا ، وَأَبَا إِسْحَاقَ ، یَقُولُونَ فِی قُنُوتِ الْوِتْرِ : إِذَا فَرَغَ کَبَّرَ ، ثُمَّ قَنَتَ۔","","Musannaf Ibn Abi Shaybah 7025","","","كتاب الجمعة"
"7026","(۷۰۲۶) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : ارْفَعْ یَدَیْک لِلْقُنُوتِ۔","","Musannaf Ibn Abi Shaybah 7026","","","كتاب الجمعة"
"7027","(۷۰۲۷) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ یَرْفَعُ یَدَیْہِ فِی قُنُوتِ الْوِتْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 7027","","","كتاب الجمعة"
"7028","(۷۰۲۸) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَنْ لَیْثٍ ، عَنِ ابْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ یَرْفَعُ یَدَیْہِ إِذَا قَنَتَ فِی الْوِتْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 7028","","","كتاب الجمعة"
"7029","(۷۰۲۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : دَخَلْتُ عَلَی الأَسْوَدِ ذَاتَ لَیْلَۃٍ وَہُوَ مَرِیضٌ ، فَصَلَّی الْوِتْرَ وَرَجُلٌ مُسْنِدٌ إِلَیْہِ ۔ قَالَ : فَقَنَتَ فَأَطَالَ الْقُنُوتَ ، حَتَّی ظَنَنْتُ أَنَّہُ قَدْ زَادَ عَلَی مَا کَانَ یَصْنَعُ۔","","Musannaf Ibn Abi Shaybah 7029","","","كتاب الجمعة"
"7030","(۷۰۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ یَقُومُ بِنَا فِی الْوِتْرِ قَدْرَ مَا یَقْرَأُ مِئَۃَ آیَۃٍ۔","","Musannaf Ibn Abi Shaybah 7030","","","كتاب الجمعة"
"7031","(۷۰۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یُقَامُ فِی قُنُوتِ الْوِتْرِ قَدْرَ : {إِذَا السَّمَائُ انْشَقَّتْ}۔","","Musannaf Ibn Abi Shaybah 7031","","","كتاب الجمعة"
"7032","(۷۰۳۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ؛ أَنَّہُ سُئِلَ عَنْ قُنُوتِ عُمَرَ فِی الْفَجْرِ ؟ فَقَالَ : کَانَ یَقْنُتُ بِقَدْرِ مَا یَقْرَأُ الرَّجُلُ مِئَۃَ آیَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 7032","","","كتاب الجمعة"
"7033","(۷۰۳۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ وِتْرَ إِلاَّ بِقُنُوتٍ۔","","Musannaf Ibn Abi Shaybah 7033","","","كتاب الجمعة"
"7034","(۷۰۳۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، قَالَ : قُلْتُ لأَبِی : یَا أَبَتِ ، صَلَّیْتَ خَلْفَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَخَلْفَ أَبِی بَکْرٍ ، وَعُمَرَ ، وَعُثْمَانَ ، فَہَلْ رَأَیْتَ أَحَدًا مِنْہُمْ یَقْنُتُ ؟ فَقَالَ : یَا بُنَیَّ ، ہِیَ مُحْدَثَۃٌ۔ (ترمذی ۴۰۳۔ احمد ۳/۴۷۲)","Sahih","Musannaf Ibn Abi Shaybah 7034","","","كتاب الجمعة"
"7035","(۷۰۳۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ یَحْیَی بْنِ غَسَّانَ الْمُرَادِیِّ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ لَمْ یَقْنُتْ فِی الْفَجْرِ۔","Hasan","Musannaf Ibn Abi Shaybah 7035","","","كتاب الجمعة"
"7036","(۷۰۳۶) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ أَبِی مَالِکٍ ، عَنْ أَبِیہِ ، قَالَ : قُلْتُ لَہُ : صَلَّیْت خَلْفَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبِی بَکْرٍ ، وَعُمَرَ ، وَعُثْمَانَ ، أَفَکَانُوا یَقْنُتُونَ ؟ فَقَالَ : لاَ یَا بُنَیَّ ، ہِیَ مُحْدَثَۃٌ۔(ابن ماجہ ۱۲۴۱۔ طبرانی ۸۱۷۹)","Sahih","Musannaf Ibn Abi Shaybah 7036","","","كتاب الجمعة"
"7037","(۷۰۳۷) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّ الأَسْوَدَ ، وَعَمْرَو بْنَ مَیْمُونٍ صَلَّیَا خَلْفَ عُمَرَ الْفَجْرَ فَلَمْ یَقْنُتْ۔","","Musannaf Ibn Abi Shaybah 7037","","","كتاب الجمعة"
"7038","(۷۰۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ بْنِ یَزِیدَ ، وَعَمْرِو بْنِ مَیْمُونٍ ؛ أَنَّہُمَا صَلَّیَا خَلْفَ عُمَرَ الْفَجْرَ فَلَمْ یَقْنُتْ۔","Sahih","Musannaf Ibn Abi Shaybah 7038","","","كتاب الجمعة"
"7039","(۷۰۳۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ عُثْمَانَ الثَّقَفِیِّ ، عَنْ عَرْفَجَۃَ ؛ أَنَّ ابْنَ مَسْعُودٍ کَانَ لاَ یَقْنُتُ فِی الْفَجْرِ۔","Hasan","Musannaf Ibn Abi Shaybah 7039","","","كتاب الجمعة"
"7040","(۷۰۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَلْقَمَۃَ بْنِ قَیْسٍ ، أَنَّ ابْنَ مَسْعُودٍ لَمْ یَکُنْ یَقْنُتُ فِی الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 7040","","","كتاب الجمعة"
"7041","(۷۰۴۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ لاَ یَقْنُتُ فِی صَلاَۃِ الصُّبْحِ۔","","Musannaf Ibn Abi Shaybah 7041","","","كتاب الجمعة"
"7042","(۷۰۴۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إِبْرَاہِیمَ ، عَن سُلَیْمٍ أَبِی الشَّعْثَائِ الْمُحَارِبِیِّ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنِ الْقُنُوتِ فِی الْفَجْرِ ، فَقَالَ : فَأَیُّ شَیْئٍ الْقُنُوتُ قُلْتُ یَقُومُ الرَّجُلُ سَاعَۃً بَعْدَ الْقِرَائَۃِ ، فَقَالَ ابْنُ عُمَرَ : مَا شَعَرْت۔","Sahih","Musannaf Ibn Abi Shaybah 7042","","","كتاب الجمعة"
"7043","(۷۰۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ وَاقِدٍ مَوْلَی زَیْدِ بْنِ خُلَیْدَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ، عَنِ ابْنِ عَبَّاسٍ، وَابْنِ عُمَرَ أَنَّہُمَا کَانَا لاَ یَقْنُتَانِ فِی الْفَجْرِ۔","Hasan","Musannaf Ibn Abi Shaybah 7043","","","كتاب الجمعة"
"7044","(۷۰۴۴) حَدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنْ زَکَرِیَّا بْنِ إِسْحَاقَ ، قَالَ : حدَّثَنِی عَمْرُو بْنُ دِینَارٍ ، أَنَّ ابْنَ الزُّبَیْرِ صَلَّی بِہِمُ الصُّبْحَ فَلَمْ یَقْنُتْ۔","Sahih","Musannaf Ibn Abi Shaybah 7044","","","كتاب الجمعة"
"7045","(۷۰۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی خَالِدٍ ، عَنْ أَبِی الضُّحَی ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّ عُمَرَ کَانَ لاَ یَقْنُتُ فِی الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 7045","","","كتاب الجمعة"
"7046","(۷۰۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، أَنَّ عُمَر بْنَ الْخَطَّابِ کَانَ لاَ یَقْنُت فِی الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 7046","","","كتاب الجمعة"
"7047","(۷۰۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَنْ طَلْحَۃَ ، أَنَّ أَبَا بَکْرٍ لَمْ یَقْنُتْ فِی الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 7047","","","كتاب الجمعة"
"7048","(۷۰۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ یَزِیدَ الْفَقِیرِ ، قَالَ صَلَّیْت خَلْفَ ابْنِ عُمَرَ الْفَجْرَ فَلَمْ یَقْنُتْ۔","Sahih","Musannaf Ibn Abi Shaybah 7048","","","كتاب الجمعة"
"7049","(۷۰۴۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ عِمْرَانَ بْنِ الْحَارِثِ ، قَالَ صَلَّیْت مَعَ ابْنِ عَبَّاسٍ فِی دَارِہِ صَلاَۃَ الصُّبْحِ فَلَمْ یَقْنُتْ قَبْلَ الرُّکُوعِ ، وَلاَ بَعْدَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 7049","","","كتاب الجمعة"
"7050","(۷۰۵۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ بْنِ یَزِیدَ ، قَالَ : قَالَ ابْنُ عُمَرَ فِی قُنُوتِ الصُّبْحِ مَا شَہِدْت ، وَلاَ عَلِمْت۔","Sahih","Musannaf Ibn Abi Shaybah 7050","","","كتاب الجمعة"
"7051","(۷۰۵۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ بْنِ یَزِیدَ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ لَمْ یَعْرِفِ الْقُنُوتَ فِی الْفَجْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 7051","","","كتاب الجمعة"
"7052","(۷۰۵۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، قَالَ : إنَّمَا قَنَتَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ شَہْرًا بَعْدَ الرُّکُوعِ۔ (بخاری ۴۰۸۹۔ مسلم ۳۰۴)","Sahih","Musannaf Ibn Abi Shaybah 7052","","","كتاب الجمعة"
"7053","(۷۰۵۳) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، عَنْ أَنَسٍ ، قَالَ : إنَّمَا قَنَتَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی صَلاَۃِ الصُّبْحِ شَہْرًا بَعْدَ الرُّکُوعِ یَدْعُو عَلَی رِعْلٍ وَذَکْوَانَ۔ (بخاری ۴۰۹۴۔ احمد ۳/۱۱۶)","Sahih","Musannaf Ibn Abi Shaybah 7053","","","كتاب الجمعة"
"7054","(۷۰۵۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَنَسٍ ، قَالَ : إنَّمَا قَنَتَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ شَہْرًا یَدْعُو عَلَی أُنَاسٍ قَتَلُوا أُنَاسًا مِنْ أَصْحَابِہِ ، یُقَالُ لَہُمُ الْقُرَّائُ۔ (بخاری ۱۰۰۲۔ مسلم ۴۶۹)","Sahih","Musannaf Ibn Abi Shaybah 7054","","","كتاب الجمعة"
"7055","(۷۰۵۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عُرْوَۃُ الْہَمْدَانِیُّ ، قَالَ : حَدَّثَنَا الشَّعْبِیُّ ، قَالَ لَمَّا قَنَتَ عَلِیٌّ فِی صَلاَۃِ الصُّبْحِ أَنْکَرَ النَّاسُ ذَلِکَ ، قَالَ : فَقَالَ : إنَّمَا اسْتَنْصَرْنَا عَلَی عَدُوِّنَا۔","Sahih","Musannaf Ibn Abi Shaybah 7055","","","كتاب الجمعة"
"7056","(۷۰۵۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ قَیْسٍ ، عَنْ عَامِرٍ الْجُہَنِیِّ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ کَانَ لاَ یَقْنُتُ فِی الْفَجْرِ ، وَقَالَ عَامِرٌ مَا کَانَ الْقُنُوتُ حَتَّی جَائَ أَہْلُ الشَّامِ۔","","Musannaf Ibn Abi Shaybah 7056","","","كتاب الجمعة"
"7057","(۷۰۵۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ قَیْسٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ عَبْدُ اللہِ لَوْ أَنَّ النَّاسَ سَلَکُوا وَادِیًا وَشِعْبًا وَسَلَکَ عُمَرُ وَادِیًا وَشِعْبًا سَلَکْت وَادِیَ عُمَرَ وَشِعْبَہُ وَلَوْ قَنَتَ عُمَرُ قَنَتَ عَبْدُ اللہِ۔","","Musannaf Ibn Abi Shaybah 7057","","","كتاب الجمعة"
"7058","(۷۰۵۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّہُ کَانَ لاَ یَقْنُتُ فِی صَلاَۃِ الصُّبْحِ۔","","Musannaf Ibn Abi Shaybah 7058","","","كتاب الجمعة"
"7059","(۷۰۵۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الْحَسَنِ بْنِ عَمْرو ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إنَّمَا قَنَتَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَیَّامًا۔ (طحاوی ۲۴۴)","","Musannaf Ibn Abi Shaybah 7059","","","كتاب الجمعة"
"7060","(۷۰۶۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ بْنُ مَسْعُودٍ : قَدْ عَلِمُوا ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إنَّمَا قَنَتَ شَہْرًا۔ (طحاوی ۲۴۳۔ طبرانی ۴۸۳)","Da'if","Musannaf Ibn Abi Shaybah 7060","","","كتاب الجمعة"
"7061","(۷۰۶۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ صَلَّیْت خَلْفَ سَعِیدِ بْنِ جُبَیْرٍ فَلَمْ یَقْنُتْ۔","","Musannaf Ibn Abi Shaybah 7061","","","كتاب الجمعة"
"7062","(۷۰۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ نَافِعٍ ، قَالَ صَلَّیْت خَلْفَ سَعِیدِ بْنِ جُبَیْرٍ الْفَجْرَ فَلَمْ یَقْنُتْ۔","Da'if","Musannaf Ibn Abi Shaybah 7062","","","كتاب الجمعة"
"7063","(۷۰۶۳) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنْ شَیْخٍ ، أَنَّہُ صَلَّی خَلْفَ عُثْمَانَ فَلَمْ یَقْنُتْ۔","Sahih","Musannaf Ibn Abi Shaybah 7063","","","كتاب الجمعة"
"7064","(۷۰۶۴) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ صَلَّیْت خَلْفَ ابْنِ عُمَرَ فَلَمْ یَقْنُتْ قَبْلَ الرُّکُوعِ ، وَلاَ بَعْدَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 7064","","","كتاب الجمعة"
"7065","(۷۰۶۵) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ مُحَمَّدِ بْنِ أَبِی إسْمَاعِیلَ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ ، عَنِ الْقُنُوتِ ، فَقَالَ : إذَا قَرَأْت فَارْکَعْ۔","","Musannaf Ibn Abi Shaybah 7065","","","كتاب الجمعة"
"7066","(۷۰۶۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ ذَاکَرْت أَبَا جَعْفَرٍ الْقُنُوتَ ، فَقَالَ : خَرَجَ عَلِیٌّ مِنْ عِنْدِنَا ، وَمَا یَقْنُتْ وَإِنَّمَا قَنَتَ بَعْدَ مَا أَتَاکُمْ۔","","Musannaf Ibn Abi Shaybah 7066","","","كتاب الجمعة"
"7067","(۷۰۶۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ وَسُلَیْمَانَ ، قَالاَ : کَانَ إبْرَاہِیمُ لاَ یَقْنُتُ فِی صَلاَۃِ الْفَجْرِ وَہُوَ إمَامٌ۔","","Musannaf Ibn Abi Shaybah 7067","","","كتاب الجمعة"
"7068","(۷۰۶۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، قَالَ : حدَّثَنِی مُجَاہِدٌ وَسَعِیدُ بْنُ جُبَیْرٍ ، أَنَّ ابْنَ عَبَّاسٍ کَانَ لاَ یَقْنُتُ فِی صَلاَۃِ الْفَجْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 7068","","","كتاب الجمعة"
"7069","(۷۰۶۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّہُ کَانَ لاَ یَقْنُتُ فِی صَلاَۃِ الصُّبْحِ۔","","Musannaf Ibn Abi Shaybah 7069","","","كتاب الجمعة"
"7070","(۷۰۷۰) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ، عَنْ عَامِرٍ، قَالَ لَمْ یَقْنُتْ أَبُو بَکْرٍ، وَلاَ عُمَرُ فِی الْفَجْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 7070","","","كتاب الجمعة"
"7071","(۷۰۷۱) حَدَّثَنَا وَکِیعٌ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن أَبِی الشَّعْثَائِ ، عَنِ ابْنِ عُمَرَ ، عَن عُمَرَ أَنَّہُ کَانَ لاَ یَفْعَلُہُ، یَعْنِی الْقُنُوتَ فِی الْفَجْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 7071","","","كتاب الجمعة"
"7072","(۷۰۷۲) حَدَّثَنَ[corrupt] وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ وَشُعْبَۃُ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْبَرَائِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَنَتَ فِی الْفَجْرِ وَالْمَغْرِبِ۔ (مسلم ۳۰۶۔ احمد ۴/۲۹۹)","Sahih","Musannaf Ibn Abi Shaybah 7072","","","كتاب الجمعة"
"7073","(۷۰۷۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا فِطَرٌ ، عَنْ عَطَائٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَنَتَ فِی الْفَجْرِ۔ (احمد ۳/۱۶۲۔ بیہقی ۲۰۱)","","Musannaf Ibn Abi Shaybah 7073","","","كتاب الجمعة"
"7074","(۷۰۷۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ شَیْخٍ لَمْ یُسَمِّہِ ، أَنَّ أَبَا بَکْرٍ قَنَتَ فِی الْفَجْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 7074","","","كتاب الجمعة"
"7075","(۷۰۷۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی حَصِینٍ ، عَنْ عَبْدِ الرحمنِ بْنِ مَعْقِلٍ ، قَالَ قَنَتَ فِی الْفَجْرِ رَجُلاَنِ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلِیٌّ ، وَأَبُو مُوسَی۔","Sahih","Musannaf Ibn Abi Shaybah 7075","","","كتاب الجمعة"
"7076","(۷۰۷۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو جَعْفَرٍ الرَّازِیّ ، عَنِ الرَّبِیعِ بْنِ أَنَسٍ ، عَنْ أَنَسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَنَتَ فِی الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 7076","","","كتاب الجمعة"
"7077","(۷۰۷۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَوْفٍ ، عَنْ أَبِی رَجَائٍ ، قَالَ : رَأَیْتُ ابْنَ عَبَّاسٍ یَمُدُّ بِضَبْعَیْہِ فِی قُنُوتِ صَلاَۃِ الْغَدَاۃِ إذْ کَانَ بِالْبَصْرَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 7077","","","كتاب الجمعة"
"7078","(۷۰۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو الأَشْہَبِ جَعْفَرُ بْنُ حَیَّانَ وَقُرَّۃُ بْنُ خَالِدٍ سَمِعَاہُ مِنْ أَبِی رَجَائٍ الْعُطَارِدِیِّ، قَالَ : صَلَّی ابْنُ عَبَّاسٍ الْفَجْرَ بِالْبَصْرَۃِ فَقَنَتَ۔","Sahih","Musannaf Ibn Abi Shaybah 7078","","","كتاب الجمعة"
"7079","(۷۰۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ الزَّرّاد ، عَنْ زَیْدِ بْنِ وَہْبٍ ، قَالَ : رُبَّمَا قَنَتَ عُمَرُ فِی صَلاَۃِ الْفَجْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 7079","","","كتاب الجمعة"
"7080","(۷۰۸۰) حَدَّثَنَا شَرِیکٌ ، عَنْ زُبَیْدٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ الْقُنُوتُ سُنَّۃٌ مَاضِیَۃٌ۔","","Musannaf Ibn Abi Shaybah 7080","","","كتاب الجمعة"
"7081","(۷۰۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زُبَیْدِ بْنِ الْحَارِثِ الیامی ، قَالَ : سَأَلْتُ ابْنَ أَبِی لَیْلَی ، عَنِ الْقُنُوتِ فِی الْفَجْرِ ، فَقَالَ : سُنَّۃٌ مَاضِیَۃٌ۔","","Musannaf Ibn Abi Shaybah 7081","","","كتاب الجمعة"
"7082","(۷۰۸۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ إِبرَاہِیم ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ قَالَ : الْقُنُوتُ فِی الْفَجْرِ ہُنَیْہَۃٌ ، أَوْ سَاعَۃٌ ، أَوْ کَلِمَۃٌ تُشْبِہُہَا۔","","Musannaf Ibn Abi Shaybah 7082","","","كتاب الجمعة"
"7083","(۷۰۸۳) حَدَّثَنَا ابْن مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مُحَارِبٍ عَنْ عُبَیْدِ بْنِ الْبَرَائِ، عَنِ الْبَرَائِ، أَنَّہُ کَانَ یَقْنُتُ فِی الْفَجْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 7083","","","كتاب الجمعة"
"7084","(۷۰۸۴) سَمِعْت وَکِیعًا یَقُولُ سَمِعْت سُفْیَانَ یَقُولُ مَنْ قَنَتَ فَحَسَنٌ وَمَنْ لَمْ یَقْنُتْ فَحَسَنٌ وَمَنْ قَنَتَ فَإِنَّمَا الْقُنُوتُ عَلَی الإِمَام وَلَیْسَ عَلَی مَنْ وَرَائَہُ قُنُوتٌ۔","","Musannaf Ibn Abi Shaybah 7084","","","كتاب الجمعة"
"7085","(۷۰۸۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ الْعَوَّامِ بْنِ حَمْزَۃَ ، قَالَ : سَأَلْتُ أَبَا عُثْمَانَ ، عَنِ الْقُنُوتِ ، فَقَالَ : بَعْدَ الرُّکُوعِ ، فَقُلْت : عَمَّنْ ؟ فَقَالَ : عَنْ أَبِی بَکْرٍ وَعُمر وَعُثْمَانَ۔","Hasan","Musannaf Ibn Abi Shaybah 7085","","","كتاب الجمعة"
"7086","(۷۰۸۶) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عَوْفٍ ، عَنْ أَبِی رَجَائٍ ، قَالَ صَلَّیْت مَعَ ابْنِ عَبَّاسٍ فِی مَسْجِدِ الْبَصْرَۃِ صَلاَۃَ الْغَدَاۃِ فَقَنَتَ بِنَا قَبْلَ الرُّکُوعِ۔","Sahih","Musannaf Ibn Abi Shaybah 7086","","","كتاب الجمعة"
"7087","(۷۰۸۷) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عَوْفٍ ، قَالَ ذَکَرْت ذَلِکَ لأَبِی الْمِنْہَالِ فَحَدَّثَنِی ، عَنْ أَبِی الْعَالِیَۃِ ، عَنِ ابْنِ عَبَّاسٍ بِمِثْلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 7087","","","كتاب الجمعة"
"7088","(۷۰۸۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ، قَالَ قَنَتَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَرْبَعِینَ صَبَاحًا فِی صَلاَۃِ الصُّبْحِ بَعْدَ الرُّکُوعِ۔","","Musannaf Ibn Abi Shaybah 7088","","","كتاب الجمعة"
"7089","(۷۰۸۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حَجَّاجٍ ، عَنْ عَیَّاشٍ الْعَامِرِیِّ ، عَنِ ابْنِ معقلٍ ، أَنَّ عُمَرَ وَعَلِیًّا وَأَبَا مُوسَی قَنَتُوا فِی الْفَجْرِ قَبْلَ الرُّکُوعِ۔","","Musannaf Ibn Abi Shaybah 7089","","","كتاب الجمعة"
"7090","(۷۰۹۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُطَرِّفٍ ، عَنْ أَبِی الْجَہْمِ ، عَنِ الْبَرَائِ ، أَنَّہُ کَانَ یَقْنُتُ قَبْلَ الرَّکْعَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 7090","","","كتاب الجمعة"
"7091","(۷۰۹۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یَزِیدُ بْنُ أَبِی زِیَادٍ ، قَالَ : حَدَّثَنَا زَیْدُ بْنُ وَہْبٍ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ قَنَتَ فِی صَلاَۃِ الصُّبْحِ قَبْلَ الرُّکُوعِ۔","Da'if","Musannaf Ibn Abi Shaybah 7091","","","كتاب الجمعة"
"7092","(۷۰۹۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَلِیُّ بْنُ زَیْدٍ ، قَالَ : أَخْبَرَنَا أَبُو عُثْمَانَ النَّہْدِیُّ ، قَالَ صَلَّیْت خَلْفَ عُمَرَ بْنِ الْخَطَّابِ صَلاَۃَ الصُّبْحِ فَقَنَتَ قَبْلَ الرُّکُوعِ۔","Da'if","Musannaf Ibn Abi Shaybah 7092","","","كتاب الجمعة"
"7093","(۷۰۹۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : حَدَّثَنَا عَطَائُ بْنُ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ السُّلَمِیِّ ، أَنَّ عَلِیًّا کَانَ یَقْنُتُ فِی صَلاَۃِ الصُّبْحِ قَبْلَ الرُّکُوعِ۔","Da'if","Musannaf Ibn Abi Shaybah 7093","","","كتاب الجمعة"
"7094","(۷۰۹۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ابْنُ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ صَلَّیْت خَلْفَ عُمَرَ الْغَدَاۃَ ، قَالَ فَقَنَتَ فِیہَا قَبْلَ الرُّکُوعِ۔","Da'if","Musannaf Ibn Abi Shaybah 7094","","","كتاب الجمعة"
"7095","(۷۰۹۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، عَنْ عُمَرَ بِمِثْلِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 7095","","","كتاب الجمعة"
"7096","(۷۰۹۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ نُسَیْرِ بْنِ ذُعْلُوقٍ ، قَالَ صَلَّیْت خَلْفَ رَبِیعِ بْنِ خُثَیم فَقَنَتَ قَبْلَ الرَّکْعَۃِ۔","","Musannaf Ibn Abi Shaybah 7096","","","كتاب الجمعة"
"7097","(۷۰۹۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ النُّعْمَانِ بْنِ قَیْسٍ ، قَالَ صَلَّیْت خَلْفَ عَبِیدَۃَ الْفَجْرَ فَقَنَتَ قَبْلَ الرَّکْعَۃِ۔","","Musannaf Ibn Abi Shaybah 7097","","","كتاب الجمعة"
"7098","(۷۰۹۸) حدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ، عَنْ زَائِدَۃَ، عَنْ أَبِی فَرْوَۃَ، قَالَ: کان ابْنُ أَبِی لَیْلَی یَقْنُتُ فِی الْفَجْرِ قَبْلَ الرَّکْعَۃِ۔","","Musannaf Ibn Abi Shaybah 7098","","","كتاب الجمعة"
"7099","(۷۰۹۹) حَدَّثَنَا أَحْمَدُ بْنُ إِسْحَاقَ ، عَنْ وَہْبٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : کَانَ یَدْعُو بِدُعَائٍ کَثِیرٍ فِی صَلاَۃِ الصُّبْحِ قَبْلَ الرُّکُوعِ۔","","Musannaf Ibn Abi Shaybah 7099","","","كتاب الجمعة"
"7100","(۷۱۰۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ابْنُ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ صَلَّیْت خَلْفَ عُمَرَ بْنِ الْخَطَّابِ الْغَدَاۃَ ، فَقَالَ : فِی قُنُوتِہِ : اللَّہُمَّ إنَّا نَسْتَعِینُک وَنَسْتَغْفِرُک وَنُثْنِی عَلَیْک الْخَیْرَ ، وَلاَ نَکْفُرُک وَنَخْلَعُ وَنَتْرُکُ مَنْ یَفْجُرُکَ اللَّہُمَّ إیَّاکَ نَعْبُدُ وَلَک نُصَلِّی وَنَسْجُدُ وَإِلَیْک نَسْعَی وَنَحْفِدُ، نَرْجُو رَحْمَتَکَ وَنَخْشَی عَذَابَک إنَّ عَذَابَک بِالْکُفَّارِ مُلْحِقٌ۔","Da'if","Musannaf Ibn Abi Shaybah 7100","","","كتاب الجمعة"
"7101","(۷۱۰۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ زِرٍّ ، عَنْ سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ أَبِیہِ ، أَنَّہُ صَلَّی خَلْفَ عُمَرَ فَصَنَعَ مِثْلَ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 7101","","","كتاب الجمعة"
"7102","(۷۱۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : أَخْبَرَنَا سُفْیَانُ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ سُوَیْد الْکَاہِلِیِّ ، أَنَّ عَلِیًّا قَنَتَ فِی الْفَجْرِ بِہَاتَیْنِ السُّورَتَیْنِ : اللَّہُمَّ إنَّا نَسْتَعِینُک وَنَسْتَغْفِرُک وَنُثْنِی عَلَیْک وَلاَ نَکْفُرُک ، وَنَخْلَعُ وَنَتْرُکُ مَنْ یَفْجُرُکَ ، اللَّہُمَّ إیَّاکَ نَعْبُدُ وَلَک نُصَلِّی وَنَسْجُدُ ، وَإِلَیْک نَسْعَی وَنَحْفِدُ ، نَرْجُو رَحْمَتَکَ ، وَنَخْشَی عَذَابَک ، إنَّ عَذَابَک بِالْکُفَّارِ مُلْحِقٌ۔ (بیہقی ۲۰۴۔ ابن سعد ۲۴۱)","Da'if","Musannaf Ibn Abi Shaybah 7102","","","كتاب الجمعة"
"7103","(۷۱۰۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : أَخْبَرَنَا جَعْفَرُ بْنُ بُرْقَانَ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ فِی قِرَائَۃِ أُبَیِّ بْنِ کَعْبٍ : اللَّہُمَّ إنَّا نَسْتَعِینُک وَنَسْتَغْفِرُک وَنُثْنِی عَلَیْک ، وَلاَ نَکْفُرُک وَنَخْلَعُ وَنَتْرُکُ مَنْ یَفْجُرُکَ اللَّہُمَّ إیَّاکَ نَعْبُدُ وَلَک نُصَلِّی وَنَسْجُدُ وَإِلَیْک نَسْعَی وَنَحْفِدُ ، نَرْجُو رَحْمَتَکَ وَنَخْشَی عَذَابَک إنَّ عَذَابَک بِالْکُفَّارِ مُلْحِقٌ۔","","Musannaf Ibn Abi Shaybah 7103","","","كتاب الجمعة"
"7104","(۷۱۰۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : سَمِعْتُ عُمَرَ یَقْنُتُ فِی الْفَجْرِ یَقُولُ : بِسْمِ اللہِ الرَّحْمَن الرَّحِیمِn اللَّہُمَّ إنَّا نَسْتَعِینُک وَنُؤْمِنُ بِکَ وَنَتَوَکَّلُ عَلَیْک وَنُثْنِی عَلَیْک الْخَیْرَ ، وَلاَ نَکْفُرُک۔n ثُمَّ قَرَأَ بِسْمِ اللہِ الرَّحْمَن الرَّحِیمِ اللَّہُمَّ إیَّاکَ نَعْبُدُ وَلَک نُصَلِّی وَنَسْجُدُ وَإِلَیْک نَسْعَی وَنَحْفِدُ نَرْجُو رَحْمَتَکَ وَنَخْشَی عَذَابَک إنَّ عَذَابَک الْجِدَّ بِالْکَافِرینَ مُلْحِقٌ اللَّہُمَّ عَذِّبْ کَفَرَۃَ أَہْلِ الْکِتَابِ الَّذِینَ یَصُدُّونَ عَنْ سَبِیلِک۔","","Musannaf Ibn Abi Shaybah 7104","","","كتاب الجمعة"
"7105","(۷۱۰۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، قَالَ : صَلَّیْت الْغَدَاۃَ ذَاتَ یَوْمٍ وَصَلَّی خَلْفِی عُثْمَانُ بْنُ زِیَادٍ ، قَالَ: فَقَنَتُّ فِی صَلاَۃِ الصُّبْحِ ، قَالَ : فَلَمَّا قَضَیْتُ صَلاَتِی ، قَالَ لِی مَا قُلْتَ فِی قُنُوتِکَ ، قَالَ : فَقُلْتُ ذَکَرْتُ ہَؤُلاَئِ الْکَلِمَاتِ اللَّہُمَّ إنَّا نَسْتَعِینُک وَنَسْتَغْفِرُک وَنُثْنِی عَلَیْک الْخَیْرَ ، وَلاَ نَکْفُرُک وَنَخْلَعُ وَنَتْرُکُ مَنْ یَفْجُرُکَ اللَّہُمَّ إیَّاکَ نَعْبُدُ وَلَک نُصَلِّی وَنَسْجُدُ وَإِلَیْک نَسْعَی وَنَحْفِدُ نَرْجُو رَحْمَتَکَ وَنَخْشَی عَذَابَک الْجِدَّ إنَّ عَذَابَک بِالْکُفَّارِ مُلْحِقٌ۔ فَقَالَ عُثْمَانُ کَذَا کَانَ یَصْنَعُ عُمَرُ بْنُ الْخَطَّابِ وَعُثْمَانُ بْنُ عَفَّانَ۔","Da'if","Musannaf Ibn Abi Shaybah 7105","","","كتاب الجمعة"
"7106","(۷۱۰۶) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُخَارِقٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، أَنَّہُ صَلَّی خَلْفَ عُمَرَ بْنِ الْخَطَّابِ الْفَجْرَ ، فَلَمَّا فَرَغَ مِنَ الْقِرَائَۃِ کَبَّرَ ، ثُمَّ قَنَتَ ، ثُمَّ کَبَّرَ ، ثُمَّ رَکَعَ۔","Sahih","Musannaf Ibn Abi Shaybah 7106","","","كتاب الجمعة"
"7107","(۷۱۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ أَبِی عَبْدِالرَّحْمَنِ السُّلَمِیِّ، أَنَّ عَلِیًّا کَبَّرَ حِینَ قَنَتَ فِی الْفَجْرِ وَکَبَّرَ حِینَ رَکَعَ۔","Da'if","Musannaf Ibn Abi Shaybah 7107","","","كتاب الجمعة"
"7108","(۷۱۰۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُطَرِّفٍ ، عَنْ أَبِی الْجَہْمِ ، قَالَ : کَانَ الْبَرَائُ یُکَبِّرُ قَبْلَ أَنْ یَقْنُتَ۔","Sahih","Musannaf Ibn Abi Shaybah 7108","","","كتاب الجمعة"
"7109","(۷۱۰۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُطَرِّفٍ ، عَنْ أَبِی الْجَہْمِ ، عَنِ الْبَرَائِ ، أَنَّہُ قَنَتَ فِی الْفَجْرِ فَکَبَّرَ حِینَ فَرَغَ مِنَ الْقِرَائَۃِ وَکَبَّرَ حِینَ رَکَعَ۔","Sahih","Musannaf Ibn Abi Shaybah 7109","","","كتاب الجمعة"
"7110","(۷۱۱۰) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ أَبِی سِنَانٍ ، عَنْ مَاہَانَ ، قَالَ : کَانَ یُکَبِّرُ قَبْلَ أَنْ یَقْنُتَ فِی صَلاَۃِ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 7110","","","كتاب الجمعة"
"7111","(۷۱۱۱) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، أَنَّہُ کَانَ یُکَبِّرُ قَبْلَ أَنْ یَقْنُتَ فِی صَلاَۃِ الْفَجْرِ وَحِینَ یُرِیدُ أَنْ یَرْکَعَ۔","","Musannaf Ibn Abi Shaybah 7111","","","كتاب الجمعة"
"7112","(۷۱۱۲) حَدَّثَنَا حُمَیْدٌ عَنْ زُہَیْرٍ ، قَالَ قُلْتُ لأَبِی إِسْحَاقَ تُکَبِّرُ أَنْتَ قَبْلَ أَنْ تَقْنُتَ فِی صَلاَۃِ الْفَجْرِ ، قَالَ نَعَمْ۔","","Musannaf Ibn Abi Shaybah 7112","","","كتاب الجمعة"
"7113","(۷۱۱۳) حَدَّثَنَا نَصْرُ بْنُ إسْمَاعِیلَ، عَنِ ابْنِ أَبِی لَیْلَی، عَنْ أَبِی إِسْحَاقَ، عَنِ الْحَارِثِ، عَنْ عَلِیٍّ، أَنَّہُ کَانَ یَفْتَتِحُ الْقُنُوتَ بِالتَّکْبِیرِ۔","Da'if","Musannaf Ibn Abi Shaybah 7113","","","كتاب الجمعة"
"7114","(۷۱۱۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ جَعْفَرِ بْنِ مَیْمُونٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : کَانَ عُمَرُ یَقْنُتُ بِنَا بَعْدَ الرُّکُوعِ وَیَرْفَعُ یَدَیْہِ حَتَّی یَبْدُوَ ضَبْعَاہُ وَیُسْمَعَ صَوْتُہُ مِنْ وَرَائِ الْمَسْجِدِ۔","Sahih","Musannaf Ibn Abi Shaybah 7114","","","كتاب الجمعة"
"7115","(۷۱۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَعْفَرٍ صَاحِبِ الأَنْمَاطِ ، عَنْ أَبِی عُثْمَانَ ، أَنَّ عُمَرَ رَفَعَ یَدَیْہِ فِی قُنُوتِ الْفَجْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 7115","","","كتاب الجمعة"
"7116","(۷۱۱۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَوْفٍ ، عَنْ خَلاَّسِ بْنِ عَمْرٍو الْہَجَرِیِّ ، عَنِ ابْنِ عَبَّاسٍ ، أنَّہُ صَلَّی فَقَنَتَ بِہِمْ فِی الْفَجْرِ بِالْبَصْرَۃِ فَرَفَعَ یَدَیْہِ حَتَّی مَدَّ ضَبْعَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 7116","","","كتاب الجمعة"
"7117","(۷۱۱۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَوْفٍ ، عَنْ أَبِی رَجَائٍ ، قَالَ : رَأَیْتُ ابْنَ عَبَّاسٍ یَمُدُّ بِضَبْعَیْہِ فِی قُنُوتِ صَلاَۃِ الْغَدَاۃِ۔","","Musannaf Ibn Abi Shaybah 7117","","","كتاب الجمعة"
"7118","(۷۱۱۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ أَبِی فَرْوَۃَ ، قَالَ : کَانَ ابْنُ أَبِی لَیْلَی یَدْعُو بِإِصْبَعٍ وَاحِدَۃٍ یَقُولُ فِی قُنُوتِ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 7118","","","كتاب الجمعة"
"7119","(۷۱۱۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : لَمَّا رَفَعَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأْسَہُ مِنْ صَلاَۃِ الصُّبْحِ ، قَالَ اللَّہُمَّ أَنْجِ الْوَلِیدَ بْنَ الْوَلِیدِ وَسَلَمَۃَ بْنَ ہِشَامٍ وَعَیَّاشَ بْنَ أَبِی رَبِیعَۃَ وَالْمُسْتَضْعَفِینَ بِمَکَّۃَ اللَّہُمَّ اشْدُدْ وَطْأَتَکَ عَلَی مُضَرَ وَاجْعَلْہَا عَلَیْہِمْ سِنِینَ کَسِنِی یُوسُفَ۔ (بخاری ۶۲۰۰۔ مسلم ۲۹۴)","Sahih","Musannaf Ibn Abi Shaybah 7119","","","كتاب الجمعة"
"7120","(۷۱۲۰) حَدَّثَنَا یَعْقُوبُ بْنُ إِبْرَاہِیمَ، عَن یَزِیدَ بْنِ أَبِی زِیَادٍ، عَنِ ابْنِ یُحَنَّسَ، عَنْ سَعِیدِ بْنِ زَیْدٍ، قَالَ: قَنَتَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : اللَّہُمَّ الْعَنْ رِعْلاً وَذَکْوَانَ وَعَضَلاً ، وَعُصَیَّۃَ عَصَتِ اللَّہَ وَرَسُولَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 7120","","","كتاب الجمعة"
"7121","(۷۱۲۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الأَعْلَی ، أَنَّ أَبَا عَبْدِ الرَّحْمَنِ السُّلَمِیَّ قَنَتَ فِی الْفَجْرِ یَدْعُو عَلَی قُطَرِی۔","","Musannaf Ibn Abi Shaybah 7121","","","كتاب الجمعة"
"7122","(۷۱۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَمْرِو بْنِ قَیْسٍ عَمَّنْ سَمِعَ إبْرَاہِیمَ یَقُولُ لاَ یُسَمَّی الرِّجَالُ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7122","","","كتاب الجمعة"
"7123","(۷۱۲۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَعْقِلٍ ، قَالَ : صَلَّیْت مَعَ عَلِیٍّ صَلاَۃَ الْغَدَاۃِ ، قَالَ : فَقَنَتَ ، فَقَالَ فِی قُنُوتِہِ : اللَّہُمَّ عَلَیْک بِمُعَاوِیَۃَ وَأَشْیَاعِہِ وَعَمْرِو بْنِ الْعَاصِ وَأَشْیَاعِہِ ، وَأَبِی الأعور السُّلَمِیِّ ، وَعَبْدِ اللہِ بْنِ قَیْسٍ وَأَشْیَاعِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 7123","","","كتاب الجمعة"
"7124","(۷۱۲۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ یَحْیَی بْنِ حَبَّانَ ، قَالَ مَکَثَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَرْبَعِینَ صَبَاحًا یَقْنُتُ فِی صَلاَۃِ الصُّبْحِ بَعْدَ الرُّکُوعِ وَکَانَ یَقُولُ فِی قُنُوتِہِ : اللَّہُمَّ أَنْجِ الْوَلِیدَ بْنَ الْوَلِیدِ وَعَیَّاشَ بْنَ أَبِی رَبِیعَۃَ وَالْعَاصَ بْنَ ہِشَامٍ وَالْمُسْتَضْعَفِینَ مِنَ الْمُؤْمِنِینَ بِمَکَّۃَ الَّذِینَ لاَ یَسْتَطِیعُونَ حِیلَۃً ، وَلاَ یَہْتَدُونَ سَبِیلاً۔","","Musannaf Ibn Abi Shaybah 7124","","","كتاب الجمعة"
"7125","(۷۱۲۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ عِمْرَانَ بْنِ أَبِی أَنَسٍ ، عَنْ حَنْظَلَۃَ بْنِ عَلِیٍّ الأَسْلَمِیِّ ، عَنْ خُفَافِ بْنِ إیمَائِ بْنِ رَحَضَۃَ الْغِفَارِیِّ ، قَالَ : صَلَّی بِنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْفَجْرَ ، فَلَمَّا رَفَعَ رَأْسَہُ مِنَ الرَّکْعَۃِ الآخِرَۃِ ، قَالَ : لَعَنَ اللَّہُ لِحْیَانًا وَرِعْلاً وَذَکْوانًا وَعُصَیَّۃَ عَصَتِ اللَّہَ وَرَسُولَہُ أَسْلَمُ سَالَمَہَا اللَّہُ ، غِفَارٌ غَفَرَ اللَّہُ لَہَا ، ثُمَّ خَرَّ سَاجِدًا ، فَلَمَّا قَضَی الصَّلاَۃ أَقْبَلَ عَلَی النَّاسِ بِوَجْہِہِ ، فَقَالَ : أَیُّہَا النَّاسُ إنِّی أَنَا لَسْتُ قُلْتُ ہَذَا وَلَکِنَّ اللَّہَ ، قَالَہُ۔ (مسلم ۳۰۷۔ احمد ۵۷)","","Musannaf Ibn Abi Shaybah 7125","","","كتاب الجمعة"
"7126","(۷۱۲۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا نَسِیَ الْقُنُوتَ فِی الْفَجْرِ فَعَلَیْہِ سَجْدَتَا السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 7126","","","كتاب الجمعة"
"7127","(۷۱۲۷) حَدَّثَنَا شَرِیکٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : سُئِلَ عَنْ رَجُلٍ سَہَا فَقَنَتَ ، فَقَالَ : ہَذَا سَہَا فَأَصَابَ۔","","Musannaf Ibn Abi Shaybah 7127","","","كتاب الجمعة"
"7128","(۷۱۲۸) حَدَّثَنَا الْوَلِیدُ بْنُ عُقْبَۃَ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ مَنْ رَأَی الْقُنُوتَ فَلَمْ یَقْنُتْ فَعَلَیْہِ سَجْدَتَا السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 7128","","","كتاب الجمعة"
"7129","(۷۱۲۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ووَکِیعٌ وَغُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَنَتَ فِی الصُّبْحِ وَالْمَغْرِبِ۔ قَالَ : فَقَالَ : إبْرَاہِیمُ أَہُوَ کَأَصْحَابِ عَبْدِ اللہِ إنَّمَا ہُوَ کَانَ صَاحِبَ أُمَرَائَ ، وَلَمْ یَذْکُرْ وَکِیعٌ قَوْلَ إبْرَاہِیمَ۔ (ترمذی ۴۰۱۔ ابوداؤد ۱۴۳۶)","Sahih","Musannaf Ibn Abi Shaybah 7129","","","كتاب الجمعة"
"7130","(۷۱۳۰) حَدَّثَنَا شَرِیکٌ ، عَنْ حُصَیْنٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ مَعقِلٍ ، قَالَ صَلَّیْت خَلْفَ عَلِیٍّ الْمَغْرِبَ ، فَقَنَتَ۔","Hasan","Musannaf Ibn Abi Shaybah 7130","","","كتاب الجمعة"
"7131","(۷۱۳۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ خَالِدٍ، عَنْ أَبِی قِلاَبَۃَ، عَنْ أَنَسٍ، قَالَ صَلاَتَانِ کَانَ یُقْنَتُ فِیہِمَا الْمَغْرِبُ وَالْفَجْرُ۔","Sahih","Musannaf Ibn Abi Shaybah 7131","","","كتاب الجمعة"
"7132","(۷۱۳۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللہِ بْنِ خَالِدٍ ، عَنِ ابْنِ مَعقِلٍ ، قَالَ قَنَتَ عَلِیٌّ فِی الْمَغْرِبِ۔","Sahih","Musannaf Ibn Abi Shaybah 7132","","","كتاب الجمعة"
"7133","(۷۱۳۳) حَدَّثَنَا شَرِیکٌ ، عَنْ ثَابِتٍ الثُّمَالِیِّ ، قَالَ : سَأَلْتُ أَبَا جَعْفَرٍ ، عَنِ الْقُنُوتِ ، فَقَالَ : کُلُّ صَلاَۃٍ یُجْہَرُ فِیہَا فَفِیہَا الْقُنُوتُ۔","","Musannaf Ibn Abi Shaybah 7133","","","كتاب الجمعة"
"7134","(۷۱۳۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنِ الْمِنْہَالِ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ رَأَی عَبْدُ اللہِ رَجُلاً یُصَلِّی صَافًّا بَیْنَ قَدَمَیْہِ ، فَقَالَ : لَوْ رَاوَحَ ہَذَا بَیْنَ قَدَمَیْہِ کَانَ أَفْضَلَ۔","","Musannaf Ibn Abi Shaybah 7134","","","كتاب الجمعة"
"7135","(۷۱۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَیْسَرَۃَ النَّہْدِیِّ ، عَنِ الْمِنْہَالِ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : خَرَجَ عَبْدُ اللہِ مِنْ دَارِہِ إلَی الْمَسْجِدِ ، فَإِذَا رَجُلٌ یُصَلِّی صَافًّا بَیْنَ قَدَمَیْہِ ، فَقَالَ عَبْدُ اللہِ أَمَّا ہَذَا فَقَدْ أَخْطَأَ السُّنَّۃَ وَلَوْ رَاوَحَ بَیْنَ قَدَمَیْہِ کَانَ أَحَبَّ إلَیَّ۔ (نسائی ۹۶۷)","","Musannaf Ibn Abi Shaybah 7135","","","كتاب الجمعة"
"7136","(۷۱۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عُیَیْنَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : کُنْتُ مَعَ أَبِی فِی الْمَسْجِدِ فَرَأَی رَجُلاً صَافًّا بَیْنَ قَدَمَیْہِ ، فَقَالَ : أَلْزِقْ إحْدَاہُمَا بِالأُخْرَی لَقَدْ رَأَیْت فِی ہَذَا الْمَسْجِدِ ، ثَمَانیَۃَ عَشَرَ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَا رَأَیْت أَحَدًا مِنْہُمْ فَعَلَ ہَذَا قَطُّ۔","Sahih","Musannaf Ibn Abi Shaybah 7136","","","كتاب الجمعة"
"7137","(۷۱۳۷) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : رَأَیْتُ عَمْرَو بْنَ مَیْمُونٍ یُرَاوِحُ بَیْنَ قَدَمَیْہِ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7137","","","كتاب الجمعة"
"7138","(۷۱۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بن أَبِی خَالِدٍ ، قَالَ : رَأَیْتُ عَمْرَو بْنَ مَیْمُونٍ یُرَاوِحُ بَیْنَ قَدَمَیْہِ یَضَعُ ہَذِہِ عَلَی ہَذِہِ وَہَذِہِ عَلَی ہَذِہِ۔","","Musannaf Ibn Abi Shaybah 7138","","","كتاب الجمعة"
"7139","(۷۱۳۹) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ یُوسُفَ بْنِ عَبْدَۃَ ، قَالَ : رَأَیْتُ ابْنَ سِیرِینَ یُصَلِّی وَہُوَ ہَکَذَا ، یَعْنِی یُقَدِّمُ رِجْلاً وَیُؤَخِّرُ أُخْرَی۔","","Musannaf Ibn Abi Shaybah 7139","","","كتاب الجمعة"
"7140","(۷۱۴۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، قَالَ : کَانَ ابْنُ سِیرِینَ یُرَاوِحُ بَیْنَ قَدَمَیْہِ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7140","","","كتاب الجمعة"
"7141","(۷۱۴۱) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ عَبْدِ اللہِ بْنِ رَاشِدٍ ، قَالَ : رَأَیْتُ مَکْحُولاً یَتَّکیئُ عَلَی قَدَمَیْہِ عَلَی ہَذِہِ مَرَّۃً وَعَلَی ہَذِہِ مَرَّۃً فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7141","","","كتاب الجمعة"
"7142","(۷۱۴۲) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، قَالَ : رَأَیْتُ سَالِمًا لاَ یَصُفُّ قَدَمَیْہِ فِی الصَّلاَۃ وَیُحَرِّکُہَا وَہُوَ یُصَلِّی۔","","Musannaf Ibn Abi Shaybah 7142","","","كتاب الجمعة"
"7143","(۷۱۴۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ رَجُلٍ ، أَنَّ ابْنَ الزُّبَیْرِ کَانَ یَصُفُّ بَیْنَ قَدَمَیْہِ فِی الصَّلاَۃ۔","Da'if","Musannaf Ibn Abi Shaybah 7143","","","كتاب الجمعة"
"7144","(۷۱۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : أَخْبَرَنِی مَنْ رَأَی ابْنَ الزُّبَیْرِ یُصَلِّی قَدْ صَفَّ بَیْنَ قَدَمَیْہِ وَأَلْزَقَ إحْدَاہُمَا بِالأُخْرَی۔","Da'if","Musannaf Ibn Abi Shaybah 7144","","","كتاب الجمعة"
"7145","(۷۱۴۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، قَالَ : رَأَیْتُ ابْنَ مَعقِلٍ یُصَلِّی صَافًّا بَیْنَ قَدَمَیْہِ۔","","Musannaf Ibn Abi Shaybah 7145","","","كتاب الجمعة"
"7146","(۷۱۴۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : رَأَیْتُ مُسْلِمَ بْنَ یَسَارٍ یُصَلِّی کَأَنَّہُ وِدٌّ لاَ یَتَرَوَّحُ عَلَی رِجْلٍ مَرَّۃً وَعَلَی رِجْلٍ مَرَّۃً۔","","Musannaf Ibn Abi Shaybah 7146","","","كتاب الجمعة"
"7147","(۷۱۴۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ یُصَلِّی صَافًّا بَیْنَ قَدَمَیْہِ فِیمَا نَعْلَمُ۔","Sahih","Musannaf Ibn Abi Shaybah 7147","","","كتاب الجمعة"
"7148","(۷۱۴۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ إسْمَاعِیلَ بْنِ مُسْلِمٍ ، عَنْ مَالِکِ بْنِ دِینَارٍ ، قَالَ : رَأَیْتُ عِکْرِمَۃَ یُصَلِّی صَافًّا بَیْنَ قَدَمَیْہِ۔","","Musannaf Ibn Abi Shaybah 7148","","","كتاب الجمعة"
"7149","(۷۱۴۹) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ قُرَیْشِ بْنِ حَیَّانَ ، قَالَ : رَأَیْتُ الْحَسَنَ یُصَلِّی صَافًّا بَیْنَ قَدَمَیْہِ۔","","Musannaf Ibn Abi Shaybah 7149","","","كتاب الجمعة"
"7150","(۷۱۵۰) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ مُخْتَارِ بْنِ سَعْدٍ ، قَالَ : رَأَیْتُ الْقَاسِمَ بْنَ مُحَمَّدٍ یَصُفُّ رِجْلَیْہِ فِی الصَّلاَۃ ، وَلاَ یُرَاوِحُ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 7150","","","كتاب الجمعة"
"7151","(۷۱۵۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : مَنْ دَخَلَ الْمَسْجِدَ وَقَدْ سُبِقَ بِالصَّلاَۃ ، قَالَ یَبْدَأُ بِالْمَکْتُوبَۃِ۔","","Musannaf Ibn Abi Shaybah 7151","","","كتاب الجمعة"
"7152","(۷۱۵۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃ۔ وَحَفص ، عن الأَعمَش ، عَن إِبْرَاہِیم قَالَ : یَبْدَأُ بِالْمَکْتُوبَۃِ۔","","Musannaf Ibn Abi Shaybah 7152","","","كتاب الجمعة"
"7153","(۷۱۵۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ یَبْدَأُ بِالْمَکْتُوبَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 7153","","","كتاب الجمعة"
"7154","(۷۱۵۴) حَدَّثَنَا ہُشَیْمٌ ووَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الشَّعْبِیِّ ، قَالَ ابْدَأْ بِالَّذِی جِئْت لَہُ۔","","Musannaf Ibn Abi Shaybah 7154","","","كتاب الجمعة"
"7155","(۷۱۵۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : ابْدَأْ بِالْمَکْتُوبَۃِ۔","","Musannaf Ibn Abi Shaybah 7155","","","كتاب الجمعة"
"7156","(۷۱۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إبْرَاہِیمَ ، قَالَ ابْدَأْ بِالْمَکْتُوبَۃِ۔","","Musannaf Ibn Abi Shaybah 7156","","","كتاب الجمعة"
"7157","(۷۱۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، قَالَ جِئْت أَنَا وَالْقَاسِمُ الْمَسْجِدَ وَقَدْ صَلَّوْا فَصَلَّی لِنَفْسِہِ ، یَعْنِی بَدَأَ بِالْمَکْتُوبَۃِ۔","","Musannaf Ibn Abi Shaybah 7157","","","كتاب الجمعة"
"7158","(۷۱۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : کَانُوا یَبْدَؤُونَ بِالْمَکْتُوبَۃِ۔","","Musannaf Ibn Abi Shaybah 7158","","","كتاب الجمعة"
"7159","(۷۱۵۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : قَالَ الْحَکَمُ : کَانُوا یَبْدَؤُونَ بِالْفَرِیضَۃِ۔ وَقَالَ أبو إِسْحَاقَ : کَانُوا یَبْدَؤُونَ بِالْفَرِیضَۃِ۔","","Musannaf Ibn Abi Shaybah 7159","","","كتاب الجمعة"
"7160","(۷۱۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنِ الْعَبَّاسِ بْنِ ذَرِیحٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَثَلُ الَّذِی یَدْخُلُ الْمَسْجِدَ وَقَدْ صُلِّی فِیہِ فَیَتَطَوَّعُ مَثَلُ الَّذِی یَعْتَمِرُ قَبْلَ أَنْ یَحُجَّ۔","","Musannaf Ibn Abi Shaybah 7160","","","كتاب الجمعة"
"7161","(۷۱۶۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ ابْدَأْ بِالَّذِی جِئْت لَہُ۔","","Musannaf Ibn Abi Shaybah 7161","","","كتاب الجمعة"
"7162","(۷۱۶۲) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مِسْعَرٍ ، عَنِ الْعَبَّاسِ بْنِ ذَرِیحٍ ، عَنِ ابْنِ عَبَّاسٍ فِی رَجُلٍ دَخَلَ مَسْجِدًا وَقَدْ صَلَّی أَہْلُہُ أَیَتَطَوَّعُ ، قَالَ ہُوَ کَرَجُلٍ یَتَطَوَّعُ قَبْلَ أَنْ یَحُجَّ۔","","Musannaf Ibn Abi Shaybah 7162","","","كتاب الجمعة"
"7163","(۷۱۶۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، وَیُونُس ، عَنِ الْحَسَنِ أَنَّہ کَانَ لاَ یَرَی بَأْسًا أَنْ یَتَطَوَّعَ۔","","Musannaf Ibn Abi Shaybah 7163","","","كتاب الجمعة"
"7164","(۷۱۶۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، عَنْ زِرٍّ ، قَالَ یَتَطَوَّعُ إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 7164","","","كتاب الجمعة"
"7165","(۷۱۶۵) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الْعَوَّامِ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی الْہُذَیْلِ ، أَنَّہُ کَانَ یَتَطَوَّعُ إذَا سُبِقَ بِالْمَکْتُوبَۃِ۔","","Musannaf Ibn Abi Shaybah 7165","","","كتاب الجمعة"
"7166","(۷۱۶۶) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سُئِلَ الْحَسَنُ ، عَنِ الرَّجُلِ یَدْخُلُ الْمَسْجِدَ وَقَدْ صَلَّی أَہْلُہُ ، قَالَ: فَقَالَ : أَمَّا أَنَا فَکُنْت أُصَلِّی کَمَا کُنْت أُصَلِّی قَبْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 7166","","","كتاب الجمعة"
"7167","(۷۱۶۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، قَالَ : لاَ بَأْسَ بِہِ إذَا کَانَ فِی وَقْتِ صَلاَۃٍ۔","","Musannaf Ibn Abi Shaybah 7167","","","كتاب الجمعة"
"7168","(۷۱۶۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، قَالَ : قَالَ حَمَّادٌ : یَتَطَوَّعُ إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 7168","","","كتاب الجمعة"
"7169","(۷۱۶۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ بْنُ عُبَیْدٍ ، قَالَ : حَدَّثَنِی أَبُو عُثْمَانَ الْیَشْکُرِیُّ ، قَالَ : مَرَّ بِنَا أَنَسُ بْنُ مَالِکٍ وَقَدْ صَلَّیْنَا صَلاَۃَ الْغَدَاۃِ وَمَعَہُ رَہْطٌ فَأَمَرَ رَجُلاً مِنْہُمْ فَأَذَّنَ ، ثُمَّ صَلَّوْا رَکْعَتَیْنِ قَبْلَ الْفَجْرِ۔ قَالَ ، ثُمَّ أَمَرَہُ فَأَقَامَ ، ثُمَّ تَقَدَّمَ فَصَلَّی بِہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 7169","","","كتاب الجمعة"
"7170","(۷۱۷۰) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ الْجَعْدِ أَبِی عُثْمَانَ ، عَنْ أَنَسٍ بِمِثْلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 7170","","","كتاب الجمعة"
"7171","(۷۱۷۱) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ، عَنْ أَبِی حُرَّۃَ ، قَالَ دَخَلْت أَنَا، وَعَبْدُ اللہِ بْنُ حُمَیْدٍ مَسْجِدًا وَقَدْ صُلِّیَ فِیہِ ، فقَالَ : أَلاَ تَجِیئُ حَتَّی نُصَلِّیَ فِی جَمَاعَۃٍ قُلْتُ : إنَّ بَعْضَہُمْ قَدْ کَرِہَ ذَلِکَ ، قَالَ : کَانَ أَبِی لاَ یَرَی بِذَلِکَ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 7171","","","كتاب الجمعة"
"7172","(۷۱۷۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ سُلَیْمَانَ النَّاجِی ، عَنْ أَبِی الْمُتَوَکِّلِ، عَنْ أَبِی سَعِیدٍ، قَالَ : جَائَ رَجُلٌ وَقَدْ صَلَّی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : أَیُّکُمْ یَتَّجِرُ عَلَی ہَذَا ، قَالَ فَقَامَ رَجُلٌ مِنَ الْقَوْمِ فَصَلَّی مَعَہُ۔ (ترمذی ۲۲۰۔ احمد ۳/۶۴)","Sahih","Musannaf Ibn Abi Shaybah 7172","","","كتاب الجمعة"
"7173","(۷۱۷۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ أَخْبَرَنَا سُلَیْمَانُ التَّیْمِیُّ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : دَخَلَ رَجُلٌ الْمَسْجِدَ وَقَدْ صَلَّی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : أَلا رَجُلٌ یَتَصَدَّقُ عَلَی ہَذَا فَیَقُومُ فَیُصَلِّی مَعَہُ۔","","Musannaf Ibn Abi Shaybah 7173","","","كتاب الجمعة"
"7174","(۷۱۷۴) حَدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، قَالَ دَخَلْت مَعَ إبْرَاہِیمَ مَسْجِدَ مُحَارِبٍ وَقَدْ صَلَّوْا فَأَمَّنِی۔","","Musannaf Ibn Abi Shaybah 7174","","","كتاب الجمعة"
"7175","(۷۱۷۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ زِیَادٍ مَوْلَی قُرَیْشٍ ، قَالَ دَخَلْت مَعَ الْحَسَنِ مَسْجِدَ الْبَصْرَۃِ فَوَجَدْنَاہُمْ قَدْ صَلَّوْا فَصَلَّی بِی۔","","Musannaf Ibn Abi Shaybah 7175","","","كتاب الجمعة"
"7176","(۷۱۷۶) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ تُصَلَّی الْجَمَاعَۃُ بَعْدَ الْجَمَاعَۃِ فِی مَسْجِدِ الْکلاّئِ بِالْبَصْرَۃِ۔","","Musannaf Ibn Abi Shaybah 7176","","","كتاب الجمعة"
"7177","(۷۱۷۷) حَدَّثَنَا ہُشَیْمٌ، قَالَ: أَخْبَرَنَا مَنْصُورٌ، عَنِ الْحَسَنِ، قَالَ: إنَّمَا کَانُوا یکْرَہُونَ أَنْ یَجْمَعُوا مَخَافَۃَ السُّلْطَانِ۔","","Musannaf Ibn Abi Shaybah 7177","","","كتاب الجمعة"
"7178","(۷۱۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مُسَافِرٍ الْجَصَّاصِ ، عَنْ فُضَیْلِ بْنِ عَمْرٍو ، أَنَّ عَدِیَّ بْنَ ثَابِتٍ وَأَصْحَابًا لَہُ رَجَعُوا مِنْ جِنَازَۃٍ فَدَخَلُوا مَسْجِدًا قَدْ صُلِّیَ فِیہِ فَجَمَعُوا فَکَرِہَ ذَلِکَ إبْرَاہِیمُ۔","","Musannaf Ibn Abi Shaybah 7178","","","كتاب الجمعة"
"7179","(۷۱۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ رَبِّہِ بْنِ أَبِی رَاشِدٍ ، قَالَ : حدَّثَنَا الحیُّ ، قَالَ جَائَنَا أَنَسُ بْنُ مَالِکٍ وَقَدْ صَلَّیْنَا الْغَدَاۃَ فَأَقَامَ الصَّلاَۃ ، ثُمَّ صَلَّی بِہِم فَقَامَ وَسَطَہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 7179","","","كتاب الجمعة"
"7180","(۷۱۸۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَمْرِو بْنِ مُحَمَّدٍ ، عَنْ عَطَائٍ ، أَنَّہُ صَلَّی ہُوَ وَسَلْم بْنُ عَطِیَّۃَ فِی الْمَسْجِدِ الْحَرَامِ فِی جَمَاعَۃٍ بَعْدَ مَا صَلَّی أَہْلُہُ۔","","Musannaf Ibn Abi Shaybah 7180","","","كتاب الجمعة"
"7181","(۷۱۸۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، أَنَّہُ قَالَ : یُصَلُّونَ جَمِیعًا فِی صَفٍّ وَاحِدٍ إمَامُہُمْ وَسَطُہُمْ۔","","Musannaf Ibn Abi Shaybah 7181","","","كتاب الجمعة"
"7182","(۷۱۸۲) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، أَنَّ ابْنَ مَسْعُودٍ دَخَلَ الْمَسْجِدَ وَقَدْ صَلَّوْا فَجَمَّعَ بِعَلْقَمَۃَ وَمَسْرُوقٍ وَالأَسْوَدِ۔","","Musannaf Ibn Abi Shaybah 7182","","","كتاب الجمعة"
"7183","(۷۱۸۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَقُولُ : یُصَلُّونَ فُرَادَی۔","","Musannaf Ibn Abi Shaybah 7183","","","كتاب الجمعة"
"7184","(۷۱۸۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخبَرَنا خَالِد ، عَنْ أَبِی قِلاَبَۃَ أَنَّہُ کَانَ یَقُولُ : یُصَلُّونَ فُرَادَی۔","","Musannaf Ibn Abi Shaybah 7184","","","كتاب الجمعة"
"7185","(۷۱۸۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : یُصَلُّونَ فُرَادَی۔","","Musannaf Ibn Abi Shaybah 7185","","","كتاب الجمعة"
"7186","(۷۱۸۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : یُصَلُّونَ شَتَّی۔","","Musannaf Ibn Abi Shaybah 7186","","","كتاب الجمعة"
"7187","(۷۱۸۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشام الدَّستوائی ، عَن حَمَّاد ، عَن إِبْرَاہِیم قَالَ : یُصَلُّونَ فُرَادَی۔","","Musannaf Ibn Abi Shaybah 7187","","","كتاب الجمعة"
"7188","(۷۱۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ کَثِیرٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ أَصْحَابُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا دَخَلُوا الْمَسْجِدَ وَقَدْ صُلِّیَ فِیہِ صَلَّوْا فُرَادَی۔","Hasan","Musannaf Ibn Abi Shaybah 7188","","","كتاب الجمعة"
"7189","(۷۱۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، قَالَ : دَخَلْنَا مَعَ الْقَاسِمِ الْمَسْجِدَ وَقَدْ صُلِّیَ فِیہِ ، قَالَ : فَصَلَّی الْقَاسِمُ وَحْدَہُ۔","","Musannaf Ibn Abi Shaybah 7189","","","كتاب الجمعة"
"7190","(۷۱۹۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنِ الْحَسَنِ ، عَنْ عَلِیٍّ ، أَنَّہُ کَانَ یَقُولُ : مَنْ أَدْرَکَ مَعَ الإِمَامِ رَکْعَتَیْنِ ، قَالَ : یَقْرَأُ فِیمَا أَدْرَکَ۔","Sahih","Musannaf Ibn Abi Shaybah 7190","","","كتاب الجمعة"
"7191","(۷۱۹۱) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ رَبِیعۃَ بْنِ أَبِی عَبْدِ الرَّحْمَنِ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ وَأَبَا الدَّرْدَائِ کَانَا یَقُولاَنِ : مَا أَدْرَکْت مِنْ صَلاَۃِ الإِمَام فَاجْعَلْہُ أَوَّلَ صَلاَتِک۔","","Musannaf Ibn Abi Shaybah 7191","","","كتاب الجمعة"
"7192","(۷۱۹۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَمْرِو بْنِ مُہَاجِرٍ ، قَالَ : سَمِعْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَقُولُ : اجْعَلْہُ أَوَّلَ صَلاَتِک۔","","Musannaf Ibn Abi Shaybah 7192","","","كتاب الجمعة"
"7193","(۷۱۹۳) حَدَّثَنَا عَبْدَۃُ، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، عَنْ سَعِیدٍ، وَالْحَسَنِ، قَالاَ: مَا أَدْرَکْت مَعَ الإِمَامِ فَہُوَ أَوَّلُ صَلاَتِک۔","Hasan","Musannaf Ibn Abi Shaybah 7193","","","كتاب الجمعة"
"7194","(۷۱۹۴) حَدَّثَنَا عَبْدَۃُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عَلِیٍّ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 7194","","","كتاب الجمعة"
"7195","(۷۱۹۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ سَعِیدُ بْنُ جُبَیْرٍ یَقُولُ : یَقْرَأُ فِیمَا أَدْرَکَ لأَنَّہُ کَانَ یُسِرُّ الْقِرَائَۃَ خَلْفَ الإِمَام۔","","Musannaf Ibn Abi Shaybah 7195","","","كتاب الجمعة"
"7196","(۷۱۹۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ أَشْعَثَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ؛ فِی الرَّجُلِ تَفُوتُہُ مَعَ الإِمَامِ الرَّکْعَۃُ ، أَوِ الرَّکْعَتَانِ ، قَالَ : یَقْرَأُ فِی سَکْتَۃِ الإِمَام۔ وَقَالَ الْحَسَنُ مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 7196","","","كتاب الجمعة"
"7197","(۷۱۹۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ، قَالَ : مَا أَدْرَکْت مَعَ الإِمَامِ فَہُوَ آخِرُ صَلاَتِک۔","","Musannaf Ibn Abi Shaybah 7197","","","كتاب الجمعة"
"7198","(۷۱۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ سِیرِینَ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : اجْعَلْ آخِرَ صَلاَتِکَ أَوَّلُ صَلاَتک۔","","Musannaf Ibn Abi Shaybah 7198","","","كتاب الجمعة"
"7199","(۷۱۹۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَجْعَلُ مَا أَدْرَکَ مَعَ الإِمَامِ آخِرَ صَلاَتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 7199","","","كتاب الجمعة"
"7200","(۷۲۰۰) حَدَّثَنَا حَفْصٌ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ إذَا أَدْرَکَ مَعَ الإِمَامِ لَمْ یَقْرَأْ فَإِذَا قَامَ یَقْضِی قَرَأَ۔","Sahih","Musannaf Ibn Abi Shaybah 7200","","","كتاب الجمعة"
"7201","(۷۲۰۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ قَالَ : اقْرَأْ فِیمَا تَقْضِی۔","Sahih","Musannaf Ibn Abi Shaybah 7201","","","كتاب الجمعة"
"7202","(۷۲۰۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ وَمُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَقْرَأُ فِیمَا یَقْضِی۔","","Musannaf Ibn Abi Shaybah 7202","","","كتاب الجمعة"
"7203","(۷۲۰۳) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ مُجَاہِدًا ، عَنْ رَجُلٍ فَاتَتْہُ رَکْعَتَانِ مَعَ الإِمَامِ فَقَرَأَ فِیہِمَا قَالَ : اجْعَلْ آخِرَ صَلاَتِکَ أَوَّلَ صَلاَتِک۔","","Musannaf Ibn Abi Shaybah 7203","","","كتاب الجمعة"
"7204","(۷۲۰۴) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ فِی رَجُلٍ تَفُوتُہُ بَعْضُ الصَّلاَۃ فَیَقُومُ یَقْضِی ، قَالَ : یَجْعَلُ مَا بَقِیَ أَوَّلَ صَلاَتِہِ وَإِنْ عَلِمْت مَا الَّذِی قَرَأَہُ الإِمَام فَاقْرَأْہُ۔","","Musannaf Ibn Abi Shaybah 7204","","","كتاب الجمعة"
"7205","(۷۲۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ نَافِعِ بْنِ عُمَرَ ، قَالَ : سَمِعْتُ عَمْرَو بْنَ دِینَارٍ یَقُولُ : اقْضِ مَا فَاتَکَ کَمَا فَاتَک۔","","Musannaf Ibn Abi Shaybah 7205","","","كتاب الجمعة"
"7206","(۷۲۰۶) حَدَّثَنَا یَعْقُوبُ بْنُ إِبْرَاہِیمَ ، عَن أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، وَابْنِ سِیرِینَ ، أَنَّہُمَا قَالاَ : فِیمَنْ سَبَقَہُ الإِمَام إذَا قَضَیْت بَعْدَہُ فَاقْضِ قِرَائَتَک۔","","Musannaf Ibn Abi Shaybah 7206","","","كتاب الجمعة"
"7207","(۷۲۰۷) حَدَّثَنَا ابْنُ عُیینََۃَ، عَنْ عَمْرٍو قَالَ: فَاتَتْ عُبَیْدَ بْنَ عُمَیْرٍ رَکْعَۃٌ مِنَ الْمَغْرِبِ فَسَمِعْتُہُ یَقْرَأُ وَاللَّیْلِ إذَا یَغْشَی۔","","Musannaf Ibn Abi Shaybah 7207","","","كتاب الجمعة"
"7208","(۷۲۰۸) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ إبْرَاہِیمُ النَّخْعِی یَقْرَأُ فِیمَا یَقْضِی۔","","Musannaf Ibn Abi Shaybah 7208","","","كتاب الجمعة"
"7209","(۷۲۰۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُکْرَہُ أَنْ یَرْفَعَ إحْدَی رِجْلَیْہِ عَلَی الأُخْرَی فِی الصَّلاَۃ ، أَوْ یَسْتَنِدُ إلَی جِدَارٍ إِلاَّ مِنْ عِلَّۃٍ۔","","Musannaf Ibn Abi Shaybah 7209","","","كتاب الجمعة"
"7210","(۷۲۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یَحْیَی بْنِ ہَانِیئٍ ، قَالَ : رَأَیْتُ عَمْرَو بْنَ مَیْمُونٍ قَائِمًا یُصَلِّی وَاضِعًا إحْدَی رِجْلَیْہِ عَلَی الأُخْرَی۔","","Musannaf Ibn Abi Shaybah 7210","","","كتاب الجمعة"
"7211","(۷۲۱۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، قَالَ : سَمِعْتُ أَنَسًا ، قَالَ : سَقَطَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ فَرَسٍ فَجُحِشَ شِقُّہُ الأَیْمَنُ فَدَخَلْنَا عَلَیْہِ نَعُودُہُ فَحَضَرَتِ الصَّلاَۃ فَصَلَّی بِنَا قَاعِدًا فَصَلَّیْنَا وَرَائَہُ قُعُودًا، فَلَمَّا قَضَی الصَّلاَۃ ، قَالَ : إنَّمَا جُعِلَ الإِمَام لِیُؤْتَمَّ بِہِ فَإِذَا کَبَّرَ فَکَبِّرُوا ، وَإِذَا رَکَعَ فَارْکَعُوا ، وَإذَا قَالَ سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ فَقُولُوا رَبَّنَا وَلَک الْحَمْدُ ، وَإِذَا صَلَّی قَاعِدًا فَصَلُّوا قُعُودًا أَجْمَعُونَ۔ (بخاری ۱۱۱۴۔ مسلم ۷۷)","Sahih","Musannaf Ibn Abi Shaybah 7211","","","كتاب الجمعة"
"7212","(۷۲۱۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتِ : اشْتَکَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَدَخَلَ نَاسٌ مِنْ أَصْحَابِہِ یَعُودُونَہُ فَصَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَالِسًا فَصَلَّوا بِصَلاَتِہِ قِیَامًا فَأَشَارَ إلَیْہِمْ أَنِ اجْلِسُوا فَجَلَسُوا ، فَلَمَّا انْصَرَفَ ، قَالَ : إنَّمَا جُعِلَ الإِمَام لِیُؤْتَمَّ بِہِ فَإِذَا رَکَعَ فَارْکَعُوا ، وَإِذَا رَفَعَ فَارْفَعُوا ، وَإِذَا صَلَّی جَالِسًا فَصَلُّوا جُلُوسًا۔ (بخاری ۶۸۸۔ ابوداؤد ۶۰۵)","Sahih","Musannaf Ibn Abi Shaybah 7212","","","كتاب الجمعة"
"7213","(۷۲۱۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : صُرِعَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ فَرَسٍ لَہُ فَوَقَعَ عَلَی جِذْعِ نَخْلَۃٍ فَانْفَکَّتْ قَدَمُہُ فَدَخَلْنَا عَلَیْہِ نَعُودُہُ وَہُوَ یُصَلِّی فِی مَشْرُبَۃٍ لِعَائِشَۃَ جَالِسًا فَصَلَّیْنَا بِصَلاَتِہِ وَنَحْنُ قِیَامٌ ، ثُمَّ دَخَلْنَا عَلَیْہِ مَرَّۃً أُخْرَی وَہُوَ یُصَلِّی جَالِسًا فَصَلَّیْنَا بِصَلاَتِہِ وَنَحْنُ قِیَامٌ فَأَوْمَأَ إلَیْنَا أَنِ اجْلِسُوا ، فَلَمَّا صَلَّی ، قَالَ : إنَّمَا جُعِلَ الإِمَام لِیُؤْتَمَّ بِہِ فَإِذَا صَلَّی قَائِمًا فَصَلُّوا قِیَامًا ، وَإِذَا صَلَّی جَالِسًا فَصَلُّوا جُلُوسًا ، وَلاَ تَقُومُوا وَہُوَ جَالِسٌ کَمَا تَفْعَلُ أَہْلُ فَارِسٍ بِعُظَمَائِہِمْ۔ (ابوداؤد ۶۰۲۔ احمد ۳/۳۳۴)","Hasan","Musannaf Ibn Abi Shaybah 7213","","","كتاب الجمعة"
"7214","(۷۲۱۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّمَا جُعِلَ الإِمَام لِیُؤْتَمَّ بِہِ فَإِذَا کَبَّرَ فَکَبِّرُوا ، وَإِذَا قَرَأَ فَأَنْصِتُوا، وَإذَا قَالَ غَیْرِ الْمَغْضُوبِ عَلَیْہِمْ ، وَلاَ الضَّالِّینَ فَقُولُوا آمِین ، وَإِذَا رَکَعَ فَارْکَعُوا ، وَإذَا قَالَ سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ فَقُولُوا اللَّہُمَّ رَبَّنَا لَکَ الْحَمْدُ ، وَإِذَا سَجَدَ فَاسْجُدُوا ، وَإِذَا صَلَّی جَالِسًا فَصَلُّوا جُلُوسًا۔","Hasan","Musannaf Ibn Abi Shaybah 7214","","","كتاب الجمعة"
"7215","(۷۲۱۵) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : أَخْبَرَنِی أَبُو الزُّبَیْرِ ، أَنَّ جَابِرًا اشْتَکَی عِنْدَہُمْ بِمَکَّۃَ ، فَلَمَّا أَنْ تَمَاثَلَ خَرَجَ وَإِنَّہُمْ خَرَجُوا مَعَہُ یَتْبَعُونَہُ حَتَّی إذَا بَلَغُوا بَعْضَ الطَّرِیقِ حَضَرَتْ صَلاَۃٌ مِنَ الصَّلَوَاتِ فَصَلَّی بِہِمْ جَالِسًا وَصَلَّوْا مَعَہُ جُلُوسًا۔","Sahih","Musannaf Ibn Abi Shaybah 7215","","","كتاب الجمعة"
"7216","(۷۲۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : الإِمَام أَمِیرٌ ، فَإِنْ صَلَّی قَائِمًا فَصَلُّوا قِیَامًا وَإِنْ صَلَّی قَاعِدًا فَصَلُّوا قُعُودًا۔","Sahih","Musannaf Ibn Abi Shaybah 7216","","","كتاب الجمعة"
"7217","(۷۲۱۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسِ بْنِ قَہْدٍ ، قَالَ اشْتَکَی إمَامُنَا فَصَلَّی قَاعِدًا أَیَّامًا فَصَلَّیْنَا بِصَلاَتِہِ ، فَقَالَ : أَبُو ہُرَیْرَۃَ الإِمَام أَمِیْرٌ، فَإِنْ صَلَّی قَائِمًا فَصَلُّوا قِیَامًا وَإِنْ صَلَّی قَاعِدًا فَصَلُّوا قُعُودًا۔","Sahih","Musannaf Ibn Abi Shaybah 7217","","","كتاب الجمعة"
"7218","(۷۲۱۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ ہُبَیْرَۃَ ، أَنَّ أُسَیْدَ بْنَ حُضَیْرٍ کَانَ یَؤُمُّ قَومَہُ بَنِی عَبْدِ الأَشْہَلِ وَأَنَّہُ اشْتَکَی فَخَرَجَ إلَیْہِمْ بَعْدَ شَکْوَاہُ ، فَقَالُوا لَہُ تَقَدَّمْ ، قَالَ : لاَ أَسْتَطِیعُ أَنْ أُصَلِّیَ، قَالُوا : لاَ یَؤُمُّنَا أَحَدٌ غَیْرُک مَا دُمْت ، فَقَالَ : اجْلِسُوا فَصَلَّی بِہِمْ جُلُوسًا۔","","Musannaf Ibn Abi Shaybah 7218","","","كتاب الجمعة"
"7219","(۷۲۱۹) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ سُلَیْمَانَ بْنِ بِلاَلٍ ، عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ ، قَالَ : سَمِعْتُ الْقَاسِمَ بْنَ مُحَمَّدٍ یَقُولُ ، قَالَ مُعَاوِیَۃُ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا صَلَّی الإِمَام جَالِسًا فَصَلُّوا جُلُوسًا ، قَالَ فَعَجِبَ النَّاسُ مِنْ صِدْقِ مُعَاوِیَۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 7219","","","كتاب الجمعة"
"7220","(۷۲۲۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ، عَنْ قَیْسِ بْنِ قَہْدٍ ، قَالَ : کَانَ لَنَا إمَامٌ فَمَرِضَ فَصَلَّیْنَا بِصَلاَتِہِ قُعُودًا۔","Sahih","Musannaf Ibn Abi Shaybah 7220","","","كتاب الجمعة"
"7221","(۷۲۲۱) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَص ، قَالَ : قَالَ عَبْدُ اللہِ إنَّمَا جُعِلَ الإِمَام لِیُؤْتَمَّ بِہِ فَإِذَا کَبَّرَ فَکَبِّرُوا ، وَإِذَا رَکَعَ فَارْکَعُوا ، وَإِذَا سَجَدَ فَاسْجُدُوا ، فَإِنَّہُ أَوَّلُ مَنْ یَرْفَعُ وَأَوَّلُ مَنْ یَضَعُ۔","Sahih","Musannaf Ibn Abi Shaybah 7221","","","كتاب الجمعة"
"7222","(۷۲۲۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ طَلْحَۃَ ، قَالَ : قَالَ سَلْمَانُ : مَنْ رَفَعَ رَأْسَہُ قَبْلَ الإِمَام وَوَضَعَ رَأْسَہُ قَبْلَ الإِمَام فَنَاصِیَتُہُ بِیَدِ الشَّیْطَانِ یَرْفَعُہَا وَیَضَعُہَا۔","Da'if","Musannaf Ibn Abi Shaybah 7222","","","كتاب الجمعة"
"7223","(۷۲۲۳) حَدَّثَنَا عَبْدَۃُ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ مَلِیحِ بْنِ عَبْدِ اللہِ السَّعْدِیِّ ، قَالَ : قَالَ أَبُو ہُرَیْرَۃَ : إنَّ الَّذِی یَخْفِضُ وَیَرْفَعُ رَأْسَہُ قَبْلَ الإِمَام فَإِنَّمَا نَاصِیَتُہُ بِیَدِ شَیْطَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 7223","","","كتاب الجمعة"
"7224","(۷۲۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ مُحَمَّدِ بْنِ زِیَادٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَمَا یَخَافُ الَّذِی یَرْفَعُ رَأْسَہُ قَبْلَ الإِمَام أَنْ یُحَوِّلَ اللَّہُ رَأْسَہُ رَأْسَ حِمَارٍ۔ (بخاری ۶۹۱۔ ابوداؤد ۶۲۳)","Sahih","Musannaf Ibn Abi Shaybah 7224","","","كتاب الجمعة"
"7225","(۷۲۲۵) حَدَّثَنَا وَک[corrupt]یعٌ ، عَنْ سُفْیَانَ ، عَنْ زِیَادِ بْنِ فَیَّاضٍ ، عَنْ تَمِیمِ بْنِ سَلَمَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : أَمَا یَخَافُ الَّذِی یَرْفَعُ رَأْسَہُ قَبْلَ الإِمَام أَنْ یُحَوِّلَ اللَّہُ رَأْسَہُ رَأْسَ کَلْبٍ۔","","Musannaf Ibn Abi Shaybah 7225","","","كتاب الجمعة"
"7226","(۷۲۲۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الْعَوَّامُ ، عَنْ عَزْرَۃَ بْنِ الْحَارِثِ ، أَنَّہُ حَدَّثَہُ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، قَالَ : کُنَّا إذَا صَلَّیْنَا خَلْفَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَرَفَعْنَا رُؤُوسَنَا مِنَ الرُّکُوعِ قُمْنَا صُفُوفًا حَتَّی یَسْجُدَ فَإِذَا سَجَدَ تَبِعْنَاہُ۔ (احمد ۴/۲۹۲۔ ابو یعلی ۱۶۷۳)","Da'if","Musannaf Ibn Abi Shaybah 7226","","","كتاب الجمعة"
"7227","(۷۲۲۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنِّی قَدْ بَدَنْتُ فَلاَ تُبَادِرُونِی بِالرُّکُوعِ ، وَلاَ بِالسُّجُودِ فَإِنِّی مَہْمَا أَسْبِقُکُمْ بِہِ إذَا رَکَعْت فَإِنَّکُمْ تُدْرِکُونِی بِہِ إذَا رَفَعْت وَمَہْمَا أَسْبِقُکُمْ بِہِ إذَا سَجَدْت فَإِنَّکُمْ تُدْرِکُونِی بِہِ إذَا وَضَعْت۔","","Musannaf Ibn Abi Shaybah 7227","","","كتاب الجمعة"
"7228","(۷۲۲۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ، عَنِ ابْنِ مُحَیْرِیزٍ ، عَنْ مُعَاوِیَۃَ ، رَفَعَہ مِثْلَہُ۔ (ابوداؤد ۶۱۹۔ احمد ۹۸)","Hasan","Musannaf Ibn Abi Shaybah 7228","","","كتاب الجمعة"
"7229","(۷۲۲۹) حَدَّثَنَا ہُشَیْمٌ ، وَابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ أَبِی حَیَّانَ ، قَالَ : قَالَ عَبْدُ اللہِ : لاَ تُبَادِرُوا أَئِمَّتَکُمْ بِالرُّکُوعِ ، وَلاَ بِالسُّجُودِ۔","Da'if","Musannaf Ibn Abi Shaybah 7229","","","كتاب الجمعة"
"7230","(۷۲۳۰) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : مَنْ کَانَ مَعَ الإِمَامِ فَرَکَعَ قَبْلَ رُکُوعِہِ وَسَجَدَ قَبْلَ سُجُودِہِ فَلَیْسَ مَعَہُ۔","","Musannaf Ibn Abi Shaybah 7230","","","كتاب الجمعة"
"7231","(۷۲۳۱) حَدَّثَنَا مُعْتَمِرٌ، عَنْ کَہْمَسٍ، قَالَ: صَلَّیْت إلَی جَنْبِ أَبِی قِلاَبَۃَ، فَکَانَ لاَ یَصْنَعُ شَیْئًا حَتَّی یَصْنَعَہُ الإِمَام۔","","Musannaf Ibn Abi Shaybah 7231","","","كتاب الجمعة"
"7232","(۷۲۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ لَمْ یَحْنِ أَحَدٌ مِنَّا ظَہْرَہُ حَتَّی یَسْجُدَ فَإِذَا سَجَدَ تَبِعْنَاہُ۔ (بخاری ۷۴۷۔ ابوداؤد ۶۲۰)","Sahih","Musannaf Ibn Abi Shaybah 7232","","","كتاب الجمعة"
"7233","(۷۲۳۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الْمُخْتَارِ بْنِ فُلْفُلٍ ، عَنْ أَنَسٍ ، قَالَ : صَلَّی بِنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَاتَ یَوْمٍ ، فَلَمَّا قَضَی الصَّلاَۃ أَقْبَلَ عَلَیْنَا بِوَجْہِہِ ، فَقَالَ : أَیُّہَا النَّاسُ إنِّی إمَامُکُمْ فَلاَ تَسْبِقُونِی بِالرُّکُوعِ، وَلاَ بِالسُّجُودِ ، وَلاَ بِالْقِیَامِ ، وَلاَ بِالإِنْصِرَافِ فَإِنِّی أَرَاکُمْ أَمَامِی وَمِنْ خَلْفِی۔ (مسلم ۱۱۲۔ ابوداؤد ۶۲۴)","Sahih","Musannaf Ibn Abi Shaybah 7233","","","كتاب الجمعة"
"7234","(۷۲۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدُ یَکْرَہُ أَنْ یُسْبَقَ الإِمَام بِشَیْئٍ مِنَ التَّکْبِیرِ۔","","Musannaf Ibn Abi Shaybah 7234","","","كتاب الجمعة"
"7235","(۷۲۳۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا ابْنُ أَبِی عَرُوبَۃَ ، قَالَ : حَدَّثَنَا قَتَادَۃُ ، عَنْ یُونُسَ بْنِ جُبَیْرٍ ، عَنْ حِطَّانَ بْنِ عَبْدِ اللہِ ، قَالَ : صَلَّی بِنَا أَبُو مُوسَی ، فَلَمَّا انْفَتَلَ ، قَالَ : إنَّ نَبِیَّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَطَبَنَا فَبَیَّنَ لَنَا سُنَّتَنَا وَعَلَّمَنَا صَلاَتَنَا ، فَقَالَ : إذَا کَبَّرَ الإِمَام فَکَبِّرُوا ، وَإِذَا رَکَعَ فَارْکَعُوا فَإِنَّ الإِمَام یَرْکَعُ قَبْلَکُمْ وَیَرْفَعُ قَبْلَکُمْ۔ (مسلم ۳۰۳۔ ابوداؤد ۹۶۵)","Sahih","Musannaf Ibn Abi Shaybah 7235","","","كتاب الجمعة"
"7236","(۷۲۳۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ قَیْسٍ ، عَنْ عَلِیِّ بْنِ مُدْرِکٍ ، أَنَّ مُعَاذًا لَمَّا قَدِمَ الْیَمَنَ کَانَ یُعْلَمُ النَّخْعَ ، فَقَالَ لَہُم : إذَا رَأَیْتُمُونِی صَنَعْت شَیْئًا فِی الصَّلاَۃ فَاصْنَعُوا مِثْلَہُ ، فَلَمَّا سَجَدَ أَضَرَّ بِعَیْنَیْہِ غُصْنُ شَجَرَۃٍ فَکَسَرَہُ فِی الصَّلاَۃ فَعَمَدَ کُلُّ رَجُلٍ مِنْہُمْ إلَی غُصْنٍ فِی الصَّلاَۃ فَکَسَرَہُ ، فَلَمَّا صَلَّی ، قَالَ إنِّی إنَّمَا کَسَرْتُہُ لأَنَّہُ أَضَرَّ بِعَیْنَیْ حِینَ سَجَدْت وَقَدْ أَحْسَنْتُمْ فِیمَا أَطَعْتُمْ۔","","Musannaf Ibn Abi Shaybah 7236","","","كتاب الجمعة"
"7237","(۷۲۳۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن نَافِعِ بْنِ جُبَیْرِ بْنِ مُطْعِمٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنِّی امْرُؤٌ قَدْ بَدَنْتُ فَلاَ تُبَادِرُونِی بِالْقِیَامِ ، وَلاَ بِالسُّجُودِ۔ (ابن سعد ۴۲۰۔ طبرانی ۱۵۷۹)","","Musannaf Ibn Abi Shaybah 7237","","","كتاب الجمعة"
"7238","(۷۲۳۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ ، قَالَتْ لَمَّا مَرِضَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَضَہُ الَّذِی مَاتَ فِیہِ جَائَ بِلاَلٌ یُؤْذِنُہُ بِالصَّلاَۃ ، فَقَالَ : مُرُوا أَبَا بَکْرٍ فَلْیُصَلِّ بِالنَّاسِ قُلْنَا یَا رَسُولَ اللہِ إنَّ أَبَا بَکْرٍ رَجُلٌ رَقِیقٌ أَسِیفٌ وَمَتَی یَقُومُ مَقَامَک یَبْکِی فَلاَ یَسْتَطِیعُ فَلَوْ أَمَرْت عُمَرَ ، فَقَالَ : مُرُوا أَبَا بَکْرٍ فَلْیُصَلِّ بِالنَّاسِ فَإِنَّکُنَّ صَوَاحِبَاتُ یُوسُفَ فَأُرْسَلَ إلَی أَبِی بَکْرٍ فَصَلَّی بِالنَّاسِ فَوَجَدَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ نَفْسِہِ خِفَّۃً فَخَرَجَ إلَی الصَّلاَۃ یُہَادَی بَیْنَ رَجُلَیْنِ وَرِجْلاَہُ تَخُطَّانِ فِی الأَرْضِ ، فَلَمَّا أَحَسَّ بِہِ أَبُو بَکْرٍ ذَہَبَ یَتَأَخَّرُ فَأَوْمَأَ إلَیْہِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ مَکَانَک ، قَالَتْ : فَجَائَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَجَلَسَ إلَی جَنْبِ أَبِی بَکْرٍ ، فَکَانَ أَبُو بَکْرٍ یَأْتَمُّ بِالنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالنَّاسُ یَأْتَمُّونَ بِأَبِی بَکْرٍ۔ (مسلم ۹۵۔ ابن ماجہ ۱۲۳۲)","Sahih","Musannaf Ibn Abi Shaybah 7238","","","كتاب الجمعة"
"7239","(۷۲۳۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا سُفْیَانُ بْنُ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَنَسٍ ، قَالَ : لَمَّا مَرِضَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی مَرَضِہِ الَّذِی مَاتَ فِیہِ أَتَاہُ بِلاَلٌ فَأَذَّنَہُ بِالصَّلاَۃ ، فَقَالَ : یَا بِلاَلُ قَدْ بَلَّغْت فَمَنْ شَائَ فَلْیُصَلِّ وَمَنْ شَائَ فَلْیَدَعْ ، فَقَالَ : یَا رَسُولَ اللہِ فَمَنْ یُصَلِّی بِالنَّاسِ؟ قَالَ : مُرُوا أَبَا بَکْرٍ فَلْیُصَلِّ بِالنَّاسِ ، فَلَمَّا تَقَدَّمَ أَبُو بَکْرٍ رُفِعَتِ السُّتُورُ ، عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَنَظَرْنَا إلَیْہِ کَأَنَّہُ وَرَقَۃٌ بَیْضَائُ عَلَیْہِ خَمِیصَۃٌ فَظَنَّ أَبُو بَکْرٍ ، أَنَّہُ یُرِیدُ الْخُرُوجَ فَتَأَخَّرَ وَأَشَارَ إلَیْہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ صَلِّ مَکَانَک فَصَلَّی أَبُو بَکْرٍ وَمَا رَأَیْنَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی مَاتَ مِنْ یَوْمِہِ۔ (بخاری ۶۸۰۔ مسلم ۹۸)","Da'if","Musannaf Ibn Abi Shaybah 7239","","","كتاب الجمعة"
"7240","(۷۲۴۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِی مُوسَی ، قَالَ : مَرِضَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَاشْتَدَّ مَرَضُہُ ، فَقَالَ : مُرُوا أَبَا بَکْرٍ فَلْیُصَلِّ بِالنَّاسِ ، فَقَالَتْ عَائِشَۃُ یَا رَسُولَ اللہِ إنَّ أَبَا بَکْرٍ رَجُلٌ رَقِیقٌ مَتَی یَقُمُ مَقَامَک فَلاَ یَسْتَطِیعُ أَنْ یُصَلِّیَ بِالنَّاسِ ، فَقَالَ : مُرِی أَبَا بَکْرٍ فَلْیُصَلِّ بِالنَّاسِ فَإِنَّکُنَّ صَوَاحِبُ یُوسُفَ ، قَالَ : فَصَلَّی بِہِمْ أَبُو بَکْرٍ حَیَاۃَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (بخاری ۶۷۸۔ مسلم ۱۰۱)","Sahih","Musannaf Ibn Abi Shaybah 7240","","","كتاب الجمعة"
"7241","(۷۲۴۱) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنْ أَبِی الزُبَیْرٍ ، عَنْ جَابِرٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَّہُمْ وَکَانَ أَبُو بَکْرٍ خَلْفَہُ فَیُکَبِّرُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَیُکَبِّرُ أَبُو بَکْرٍ یُسْمِعُ النَّاسَ۔ (مسلم ۸۵۔ ابوداؤد ۶۰۶)","Sahih","Musannaf Ibn Abi Shaybah 7241","","","كتاب الجمعة"
"7242","(۷۲۴۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَبْدِ اللہِ ، قَالَ : لَمَّا قُبِضَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَتِ الأَنْصَارُ مِنَّا أَمِیرٌ وَمِنْکُمْ أَمِیرٌ فَأَتَاہُمْ عُمَرُ ، فَقَالَ : یَا مَعْشَرَ الأَنْصَارِ أَلَسْتُمْ تَعْلَمُونَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَّرَ أَبَا بَکْرٍ یُصَلِّی بِالنَّاسِ ، قَالُوا : بَلَی ، قَالَ : فَأَیُّکُمْ تَطِیبُ نَفْسُہُ أَنْ یَتَقَدَّمَ أَبَا بَکْرٍ۔ (نسائی ۸۵۲۔ احمد ۱/۳۹۶)","Da'if","Musannaf Ibn Abi Shaybah 7242","","","كتاب الجمعة"
"7243","(۷۲۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، قَالَ : سَمِعْتُ أَبَا سَلَمَۃَ بْنَ عَبْدِ الرَّحْمَنِ یُحَدِّثُ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اشْتَکَی ، فَقَالَ : مُرُوا أَبَا بَکْرٍ فَلْیُصَلِّ بِالنَّاسِ فَوَجَدَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ نَفْسِہِ خِفَّۃً فَخَرَجَ ، فَلَمَّا رَآہُ أَبُو بَکْرٍ ذَہَبَ لِیَتَأَخَّرَ فَأَوْمَأَ إلَیْہِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَکَانَک فَجَائَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی جَلَسَ إلَی جَنْبِ أَبِی بَکْرٍ ، فَکَانَ أَبُو بَکْرٍ یَأْتَمُّ بِالنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالنَّاسُ یَأْتَمُّونَ بِأَبِی بَکْرٍ۔","","Musannaf Ibn Abi Shaybah 7243","","","كتاب الجمعة"
"7244","(۷۲۴۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَاصِمِ بْنِ أَبِی النَّجُودِ ، عَنْ شَقِیقٍ ، عَنْ مَسْرُوقٍ، عَنْ عائِشَۃَ، قَالَتْ : أُغْمِیَ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَلَمَّا أَفَاقَ ، قَالَ : أَصَلَّی النَّاسُ ؟ قَالَتْ : فَقُلْنَا : لاَ ، قَالَ : مُرُوا أَبَا بَکْرٍ فَلْیُصَلِّ بِالنَّاسِ ، قَالَتْ : فَقُلْنَا : یَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْک وَسَلَّمَ إنَّ أَبَا بَکْرٍ رَجُلٌ أَسِیفٌ ، قَالَ : عَاصِمٌ الأَسِیفُ الرَّقِیقُ الرَّحِیمُ ، وَإِنَّہُ مَتَی یَقُمُ مَقَامَک لاَ یَسْتَطِیعُ أَنْ یُصَلِّیَ بِالنَّاسِ ، قَالَتْ : ثُمَّ أُغْمِیَ عَلَیْہِ ، ثُمَّ أَفَاقَ ، فَقَالَ : مِثْلَ ذَلِکَ ، فَرَدَّت عَلَیْہِ ثَلاَثَ مَرَّاتٍ ، فَقَالَ : إنَّکُنَّ صَوَاحِبُ یُوسُفَ مُرُوا أَبَا بَکْرٍ فَلْیُصَلِّ بِالنَّاسِ ، فَقَالَتْ : فَوَجَدَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ نَفْسِہِ خِفَّۃً فَخَرَجَ بَیْنَ بَرِیرَۃَ وَنَوْبَۃَ ، تَخُطُّ نَعْلاَہُ إنِّی لأَرَی بَیَاضَ بُطُون قَدَمَیْہِ ، وَأَبُو بَکْرٍ یَؤُمُّ النَّاسَ ، فَلَمَّا رَآہُ أَبُو بَکْرٍ ذَہَبَ یَتَأَخَّرُ فَأَوْمَأَ إلَیْہِ أَنْ لاَ یَتَأَخَّرَ ، قَالَتْ : فَقَامَ أَبُو بَکْرٍ بِجَنْبِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، والنَّبیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَاعِدٌ ، یُصَلِّی أَبُو بَکْرٍ بِصَلاَۃِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالنَّاسُ یُصَلُّونَ بِصَلاَۃِ أَبِی بَکْرٍ۔(ابن حبان ۲۱۱۸)","Da'if","Musannaf Ibn Abi Shaybah 7244","","","كتاب الجمعة"
"7245","(۷۲۴۵) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ نُعَیْمِ بْنِ أَبِی ہِنْدٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی مَرَضِہِ الَّذِی مَاتَ فِیہِ خَلْفَ أَبِی بَکْرٍ قَاعِدًا۔ (ترمذی ۳۶۲۔ احمد ۶/۱۵۹)","","Musannaf Ibn Abi Shaybah 7245","","","كتاب الجمعة"
"7246","(۷۲۴۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مُوسَی بْنِ أَبِی عَائِشَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، قَالَ : دَخَلْت عَلَی عَائِشَۃَ فَقُلْت : إِلاَّ تُحَدِّثِینِی ، عَنْ مَرَضِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَتْ : بَلَی۔ ثَقُلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : أَصَلَّی النَّاسُ ؟ فَقُلْت لاَ ہُمْ یَنْتَظِرُونَک یَا رَسُولَ اللہِ، فَقَالَ : ضَعُوا لِی مَائً فِی الْمِخْضَبِ ، قَالَتْ فَفَعَلْنَا فَاغْتَسَلَ ، ثُمَّ ذَہَبَ لِیَنُوئَ فَأُغْمِیَ عَلَیْہِ ، ثُمَّ أَفَاقَ ، فَقَالَ : أَصَلَّی النَّاسُ ؟ فَقُلْنَا لاَ ہُمْ یَنْتَظِرُونَک ، فَقَالَ : ضَعُوا لِی مَائً فِی الْمِخْضَبِ ، قَالَتْ : فَفَعَلْنَا فَاغْتَسَلَ ، ثُمَّ ذَہَبَ لِیَنُوئَ فَأُغْمِیَ عَلَیْہِ ، ثُمَّ أَفَاقَ ، فَقَالَ : أَصَلَّی النَّاسُ ؟ فَقُلْنَا ہُمْ یَنْتَظِرُونَک یَا رَسُولَ اللہِ وَالنَّاسُ عُکُوفٌ فِی الْمَسْجِدِ یَنْتَظِرُونَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِصَلاَۃِ الْعِشَائِ الآخِرَۃِ۔ n قَالَتْ : فَأَرْسَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی أَبِی بَکْرٍ أَنْ صَلِّ بِالنَّاسِ فَأَتَاہُ الرَّسُولُ ، فَقَالَ : إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَأْمُرُک أَنْ تُصَلِّیَ بِالنَّاسِ ، فَقَالَ : أَبُو بَکْرٍ ، وَکَانَ رَجُلاً رَقِیقًا ، یَا عُمَرُ صَلِّ بِالنَّاسِ ، فَقَالَ لَہُ : عُمَرُ أَنْتَ أَحَقُّ بِذَلِکَ فَصَلَّی بِہِمْ أَبُو بَکْرٍ تِلْکَ الأَیَّامَ۔n قَالَتْ ، ثُمَّ إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَجَدَ فِی نَفْسِہِ خِفَّۃً فَخَرَجَ بَیْنَ رَجُلَیْنِ لِصَلاَۃِ الظُّہْرِ ، وَأَبُو بَکْرٍ یُصَلِّی بِالنَّاسِ ، قَالَتْ ، فَلَمَّا رَآہُ أَبُو بَکْرٍ ذَہَبَ لِیَتَأَخَّرَ فَأَوْمَأَ إلَیْہِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ لاَ یَتَأَخَّرَ ، وَقَالَ لَہُمَا : اجْلِسَانِی إلَی جَنْبِہِ فَأَجْلَسَاہُ إلَی جَنْبِ أَبِی بَکْرٍ فَجَعَلَ أَبُو بَکْرٍ یُصَلِّی وَہُوَ قَائِمٌ بِصَلاَۃِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالنَّاسُ یُصَلُّونَ بِصَلاَۃِ أَبِی بَکْرٍ وَالنَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَاعِدٌ۔n قَالَ عُبَیْدُ اللہِ : فَدَخَلْت عَلَی عَبْدِ اللہِ بْنِ عَبَّاسٍ ، فَقُلْت : أَلاَ أَعْرِضُ عَلَیْک مَا حَدَّثَتْنِی بِہِ عَائِشَۃُ عَنْ مَرَضِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : ہَاتِ فَعَرَضْت عَلَیْہِ حَدِیثَہَا فَمَا أَنْکَرَ مِنْہُ شَیْئًا۔ (بخاری ۶۶۵۔ مسلم ۳۱۱)","Sahih","Musannaf Ibn Abi Shaybah 7246","","","كتاب الجمعة"
"7247","(۷۲۴۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَمْرِو بْنِ وَہْبٍ ، عَنِ الْمُغِیرَۃِ بنِ شُعْبَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی خَلْفَ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ۔ (مسلم ۸۱۔ احمد۲۴۸)","Sahih","Musannaf Ibn Abi Shaybah 7247","","","كتاب الجمعة"
"7248","(۷۲۴۸) حَدَّثَنَا جَرِیرٌ ، عَنْ أَبِی حَازِمٍ ، عَنْ سَہْلِ بْنِ سَعْدٍ ، قَالَ : کَانَ کَوْنٌ فِی الأَنْصَارِ فَأَتَاہُمُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِیُصْلِحَ بَیْنَہُمْ ، قَالَ : فَجَائَ وَأَبُو بَکْرٍ یُصَلِّی بِالنَّاسِ ، قَالَ : فَصَلَّی خَلْفَ أَبِی بَکْرٍ۔ (بخاری ۱۲۰۱۔ ابوداؤد ۹۳۸)","Sahih","Musannaf Ibn Abi Shaybah 7248","","","كتاب الجمعة"
"7249","(۷۲۴۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ لاَ یَرَی بَأْسًا أَنْ یَضَعَ الرَّجُلُ رِدَائَہُ عَنْ مَنْکِبَیْہِ وَہُوَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7249","","","كتاب الجمعة"
"7250","(۷۲۵۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 7250","","","كتاب الجمعة"
"7251","(۷۲۵۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ إذَا جَلَسَ الرَّجُلُ فِی الصَّلاَۃ أَنْ یَضَعَ رِدَائَہُ عَنْ عَاتِقِہِ۔","","Musannaf Ibn Abi Shaybah 7251","","","كتاب الجمعة"
"7252","(۷۲۵۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ رَجُلٍ ، عَنْ أَنَسٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ النَّوْمِ قَبْلَہَا ، یَعْنِی الْعِشَائَ۔","Da'if","Musannaf Ibn Abi Shaybah 7252","","","كتاب الجمعة"
"7253","(۷۲۵۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَوْفٍ ، عَنْ سَیَّارِ بْنِ سَلاَمَۃَ ، عَنْ أَبِی بَرْزَۃَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْہَی عَنِ النَّوْمِ قَبْلَ الْعِشَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 7253","","","كتاب الجمعة"
"7254","(۷۲۵۴) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، وَمُجَاہِدٍ، قَالَ: کَانَ ابْنُ عُمَرَ یَکَادُ أَنْ یَسُبَّ الَّذِی یَنَامُ، عَنِ الْعِشَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 7254","","","كتاب الجمعة"
"7255","(۷۲۵۵) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیمَانَ، عَنْ أَبِیہِ، قَالَ: بَلَغَنِی عَنْ أَنَسٍ، قَالَ: کُنَّا نَجْتَنِبُ الْفُرُشَ قَبْلَ صَلاَۃِ الْعِشَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 7255","","","كتاب الجمعة"
"7256","(۷۲۵۶) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنْ أَسْلَمَ ، قَالَ : کَتَبَ عُمَرُوَلاَ یَنَامَ قَبْلَ أَنْ یُصَلِّیَہَا فَمَنْ نَامَ فَلاَ نَامَتْ عَیْنُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 7256","","","كتاب الجمعة"
"7257","(۷۲۵۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیدِ اللہِ ، عَنْ نَافِعٍ ، عَنْ صَفِیَّۃَ ، عَنْ عُمَرَ بِنَحْوٍ مِنْ حَدِیثِ الثَّقَفِیِّ۔","Sahih","Musannaf Ibn Abi Shaybah 7257","","","كتاب الجمعة"
"7258","(۷۲۵۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ سَعِیدِ بْنِ یسَََار ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : جَائَہ رَجُلٌ ، فَقَالَ: إنَّ مِنَّا الْمُحَارِجَ وَالْمُضَارِبَ فَہَلْ عَلَیْنَا حَرَجٌ أَنْ نَنَامَ قَبْلَ صَلاَۃِ الْعِشَائِ ؟ قَالَ : نَعَمْ وَحَرَجٌ وَحَرَجَانِ وَثَلاَثَۃُ أَحْراجَ۔","Da'if","Musannaf Ibn Abi Shaybah 7258","","","كتاب الجمعة"
"7259","(۷۲۵۹) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ الْہَیْثُمِ الْمُرَادِیِّ ، عَنِ ابْنِ عُمَرَ ، أَنَّ رَجُلاً سَأَلَہُ ، عَنْ ذَلِکَ ، فَقَالَ : صَلِّ ، ثُمَّ نَمْ ، قَالَ ثُمَّ قَالَ لَہُ ذَلِکَ ثَلاَثًا ، فَقَالَ فِی الثَّالِثَۃِ : صَلِّ ثُمَّ نَمْ فَلاَ نَامَتْ عَیْنُک۔","","Musannaf Ibn Abi Shaybah 7259","","","كتاب الجمعة"
"7260","(۷۲۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُجَاہِدٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ نَامَ عَنْہَا فَلاَ نَامَتْ عَیْنُہُ ، یَعْنِی الْعِشَائَ۔","Da'if","Musannaf Ibn Abi Shaybah 7260","","","كتاب الجمعة"
"7261","(۷۲۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ بَہْرَامَ عْن شَہْرِ بْنِ حَوْشَبٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَا أُحِبُّ النَّوْمَ قَبْلَہَا ، وَلاَ الْحَدِیثَ بَعْدَہَا۔","","Musannaf Ibn Abi Shaybah 7261","","","كتاب الجمعة"
"7262","(۷۲۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوس ، وَمُجَاہِدٍ أَنَّہُمْ کَانُوا یَکْرَہُونَ النَّوْمَ قَبْلَہَا وَالْحَدِیثَ بَعْدَہَا۔","","Musannaf Ibn Abi Shaybah 7262","","","كتاب الجمعة"
"7263","(۷۲۶۳) حَدَّثَنَا وَکِیعٌ ، وَابْنُ فُضَیْلٍ ، عَنْ مِسْعَرٍ ، قَالَ : سَأَلْتُ یَزِیدَ الْفَقِیرَ أَسَمِعْت ابْنَ عُمَرَ یَکْرَہُ النَّوْمَ قَبْلَہَا، قَالَ نَعَمْ۔","Sahih","Musannaf Ibn Abi Shaybah 7263","","","كتاب الجمعة"
"7264","(۷۲۶۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ النَّوْمَ قَبْلَہَا وَالْحَدِیثَ بَعْدَہَا۔","","Musannaf Ibn Abi Shaybah 7264","","","كتاب الجمعة"
"7265","(۷۲۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ ، عَنْ عَطَائٍ فِی قولہ تعالی: (تَتَجَافَی جُنُوبُہُمْ عَنِ الْمَضَاجِعِ) قَالَ: عَنِ الْعَتَمَۃِ۔","","Musannaf Ibn Abi Shaybah 7265","","","كتاب الجمعة"
"7266","(۷۲۶۶) حَدَّثَنَا شُعْبَۃُ ، عَنْ سَہْلٍ الْقُرَشِیِّ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ الْمُسَیَّبِ یَقُولُ : لأَنْ أُصَلِّیَ الْعِشَائَ فِی ہَذِہِ السَّاعَۃِ وَذَلِکَ بَعْدَ الْمَغْرِبِ أَحَبُّ إلَیَّ مِنْ أَنْ أَنَامَ عْنہَا ، ثُمَّ أَقُومَ فَأُصَلِّیَہَا۔","","Musannaf Ibn Abi Shaybah 7266","","","كتاب الجمعة"
"7267","(۷۲۶۷) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا إسْمَاعِیلُ بْنُ عَبْدِ الْمَلِکِ ، عَنْ عَبْدِ الْکَرِیمِ أَبِی أُمَیَّۃَ ، عَنْ مُجَاہِدٍ، قَالَ: لأَنْ أُصَلِّیَ الْعِشَائَ قَبْلَ أَنْ یَغِیبَ الشَّفَقُ أَحَبُّ إلَیَّ مِنْ أَنْ أَنَامَ عْنہَا، ثُمَّ أُصَلِّیَہَا بَعْدَ مَا یَغِیبُ الشَّفَقُ فِی جَمَاعَۃٍ۔","","Musannaf Ibn Abi Shaybah 7267","","","كتاب الجمعة"
"7268","(۷۲۶۸) حَدَّثَنَا حَفْصٌ ، وَابْنُ فُضَیْلٍ ووَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَبْدِ اللہِ بن عَبْدِ اللہِ الرَّازِیّ ، عَنْ جَدَّتِہِ وَکَانَتْ سُرِّیَّۃً لِعَلِیٍّ ، أَنَّ عَلِیًّا رُبَّمَا غَفَا قَبْلَ الْعِشَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 7268","","","كتاب الجمعة"
"7269","(۷۲۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی حَصِینٍ ، أَنَّ خَبَّابًا نَامَ ، عَنِ الْعِشَائِ۔","","Musannaf Ibn Abi Shaybah 7269","","","كتاب الجمعة"
"7270","(۷۲۷۰) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ أَبِی حَصِینٍ، أَنَّ أَبَا وَائِلٍ وَأَصْحَابَ عَبْدِاللہِ کَانُوا یَنَامُونَ قَبْلَ الْعِشَائِ۔","","Musannaf Ibn Abi Shaybah 7270","","","كتاب الجمعة"
"7271","(۷۲۷۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ الأَسْوَدُ لاَ یُفْطِرُ فِی رَمَضَانَ حَتَّی یُصَلِّیَ ، فَکَانَ یَنَامُ مَا بَیْنَ الْمَغْرِبِ وَالْعِشَائِ۔","","Musannaf Ibn Abi Shaybah 7271","","","كتاب الجمعة"
"7272","(۷۲۷۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، قَالَ : قُلْتُ لَہُ : أَکَانَ ابْنُ عُمَرَ یَنَامُ عَنْہَا ، یَعْنِی الْعِشَائَ ، قَالَ : قَدْ کَانَ یَنَامُ وَیُوَکِّلُ مَنْ یُوقِظُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 7272","","","كتاب الجمعة"
"7273","(۷۲۷۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ یَنَامُ قَبْلَہَا۔","","Musannaf Ibn Abi Shaybah 7273","","","كتاب الجمعة"
"7274","(۷۲۷۴) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنْ عَلِیٍّ الأَزْدِیِّ ، قَالَ : کَانَ یَخْتِمُ الْقُرْآنَ فِی رَمَضَانَ کُلَّ لَیْلَۃٍ وَکَانَ یَنَامُ مَا بَیْنَ الْمَغْرِبِ وَالْعِشَائِ۔","","Musannaf Ibn Abi Shaybah 7274","","","كتاب الجمعة"
"7275","(۷۲۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : کَانُوا یَنَامُونَ نَوْمَۃً قَبْلَ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7275","","","كتاب الجمعة"
"7276","(۷۲۷۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ وَقَائٍ ، أَنَّ سَعِیدَ بْنَ جُبَیْرٍ کَانَ یَنَامُ قَبْلَ أَنْ یُصَلِّیَ الْعِشَائَ ، ثُمَّ یَقُومُ فِی رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 7276","","","كتاب الجمعة"
"7277","(۷۲۷۷) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، أَنَّہُ کَانَ یَنَامُ قَبْلَ الْعِشَائِ۔","","Musannaf Ibn Abi Shaybah 7277","","","كتاب الجمعة"
"7278","(۷۲۷۸) حَدَّثَنَا إسْمَاعِیلُ بْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : نُبِّئْتُ أَنَّ أَبَا مُوسَی الأَشْعَرِیَّ أَعَادَ صَلاَۃَ الصُّبْحِ فِی یَوْمٍ ثَلاَثَ مَرَّاتٍ صَلَّی ، ثُمَّ قَعَدَ ، حَتَّی تَبَیَّنَ لَہُ ، أَنَّہُ صَلَّی بِلَیْلٍ ، ثُمَّ أَعَادَہَا ، ثُمَّ صَلَّی وَقَعَدَ حَتَّی تَبَیَّنَ ، أَنَّہُ صَلَّی بِلَیْلٍ ، ثُمَّ أَعَادَہَا الثَّالِثَۃَ۔","","Musannaf Ibn Abi Shaybah 7278","","","كتاب الجمعة"
"7279","(۷۲۷۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، أنَّ ابْنَ عُمَرَ أَعَادَ صَلاَۃَ الصُّبْحِ یجمع فِی یَوْمٍ ثَلاَثَ مَرَّاتٍ صَلَّی فَإِذَا ہُوَ قَدْ صَلَّی بِلَیْلٍ ، ثُمَّ أَعَادَہَا فَإِذَا ہُوَ قَدْ صَلَّی بِلَیْلٍ ، ثُمَّ أَعَادَہَا الثَّالِثَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 7279","","","كتاب الجمعة"
"7280","(۷۲۸۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنِ الْحَسَنِ ، قَالَ : شَکُّوا فِی طُلُوعِ الْفَجْرِ فِی عَہْدِ ابْنِ عَبَّاسٍ ، قَالَ : فَأَمَرَ مُؤَذِّنَہُ فَأَقَامَ الصَّلاَۃ ، ثُمَّ تَقَدَّمَ فَصَلَّی بِہِمْ وَاسْتَفْتَحَ الْبَقَرَۃَ حَتَّی خَتَمَہَا ، ثُمَّ رَکَعَ ، ثُمَّ سَجَدَ ، ثُمَّ قَامَ فَاسْتَفْتَحَ آلَ عِمْرَانَ حَتَّی خَتَمَہَا ، ثُمَّ رَکَعَ وَسَجَدَ ، قَالَ وَأَضَائَ لَہُمُ الصُّبْحُ۔","Sahih","Musannaf Ibn Abi Shaybah 7280","","","كتاب الجمعة"
"7281","(۷۲۸۱) حَدَّثَنَا ہُشَیْمٌ، قَالَ: حدَّثَنَا حُصَیْنٌ، عَنْ إبْرَاہِیمَ، قَالَ: کَانَتْ بِی سَعْلَۃٌ فَخَ[corrupt]َجْت لِصَلاَۃِ الصُّبْحِ فَسَمِعَ الْمُؤَذِّنُ سَعْلَتِی فَظَنَّ أَنْ قَدْ أَصْبَحْنَا فَأَقَامَ الصَّلاَۃ فَصَلَّیْنَا ، ثُمَّ نَظَرْنَا فَإِذَا الْفَجْرُ لَمْ یَطْلُعْ فَأَعَدْنَا الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7281","","","كتاب الجمعة"
"7282","(۷۲۸۲) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ مُحَمَّدِ بْنِ عُثْمَانَ الْمَخْزُومِیِّ ، قَالَ : أَخْبَرَتْنِی جَدَّتِی ، عَنْ مَوْلًی لِعَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ قَالَ : سَمِعْتُہُ یَقُولُ : إذَا طَہُرَتِ الْحَائِضُ قَبْلَ غُرُوبِ الشَّمْسِ صَلَّتِ الظُّہْرَ وَالْعَصْرَ ، وَإِذَا طَہُرَتْ قَبْلَ الْفَجْرِ صَلَّتِ الْمَغْرِبَ وَالْعِشَائَ۔","Da'if","Musannaf Ibn Abi Shaybah 7282","","","كتاب الجمعة"
"7283","(۷۲۸۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ وَعُبَیْدَۃَ أَخْبَرَاہُ ، عَنْ إبْرَاہِیمَ ، وَعَنْ حَجَّاجٍ ، عَنْ عَطَائٍ وَالشَّعْبِیِّ ، وَعَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ فِی الْحَائِضِ إذَا طَہُرَتْ قَبْلَ غُرُوبِ الشَّمْسِ صَلَّتِ الظُّہْرَ وَالْعَصْرَ ، وَإِذَا طَہُرَتْ قَبْلَ الْفَجْرِ صَلَّتِ الْمَغْرِبَ وَالْعِشَائَ۔","","Musannaf Ibn Abi Shaybah 7283","","","كتاب الجمعة"
"7284","(۷۲۸۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یَزِیدَ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 7284","","","كتاب الجمعة"
"7285","(۷۲۸۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ عَطَائٍ ، وَطَاوُوس ، وَمُجَاہِدٍ ، قَالُوا : إذَا طَہُرَتْ قَبْلَ غُرُوبِ الشَّمْسِ صَلَّتِ الظُّہْرَ وَالْعَصْرَ ، وَإِذَا طَہُرَتْ قَبْلَ طُلُوعِ الْفَجْرِ صَلَّتِ الْمَغْرِبَ وَالْعِشَائَ۔","","Musannaf Ibn Abi Shaybah 7285","","","كتاب الجمعة"
"7286","(۷۲۸۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوس ، أَنَّہُمَا قَالاَ : إذَا طَہُرَتِ الْحَائِضُ قَبْلَ غُرُوبِ الشَّمْسِ اغْتَسَلَتْ وَصَلَّتِ الظُّہْرَ وَالْعَصْرَ ، وَإِذَا طَہُرَتْ قَبْلَ الْفَجْرِ اغْتَسَلَتْ وَصَلَّتِ الْمَغْرِبَ وَالْعِشَائَ۔","","Musannaf Ibn Abi Shaybah 7286","","","كتاب الجمعة"
"7287","(۷۲۸۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا طَہُرَتِ الْحَائِضُ مِنْ آخِرِ النَّہَارِ صَلَّتِ الظُّہْرَ وَالْعَصْرَ ، وَإِذَا طَہُرَتْ مِنْ آخِرِ اللَّیْلِ صَلَّتِ الْمَغْرِبَ وَالْعِشَائَ۔","","Musannaf Ibn Abi Shaybah 7287","","","كتاب الجمعة"
"7288","(۷۲۸۸) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ عَطَائٍ ، قَالَ : إذَا طَہُرَتْ مِنْ آخِرِ اللَّیْلِ فَلْتُصَلِّ صَلاَۃَ لَیْلَتِہَا ، وَإِذَا طَہُرَتْ مِنْ آخِرِ النَّہَارِ فَلْتُصَلِّ صَلاَۃَ یَوْمِہَا۔","","Musannaf Ibn Abi Shaybah 7288","","","كتاب الجمعة"
"7289","(۷۲۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ ، قَالَ : إذَا رَأَتِ الطُّہورَ قَبْلَ الْمَغْرِبِ صَلَّتِ الظُّہْرَ وَالْعَصْرَ ، وَإِذَا رَأَتْہُ قَبْلَ الْفَجْرِ صَلَّتِ الْمَغْرِبَ وَالْعِشَائَ۔","","Musannaf Ibn Abi Shaybah 7289","","","كتاب الجمعة"
"7290","(۷۲۹۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : تُصَلِّی الصَّلاَۃ الَّتِی طَہُرَتْ فِی وَقْتِہَا۔","","Musannaf Ibn Abi Shaybah 7290","","","كتاب الجمعة"
"7291","(۷۲۹۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إن رَأَتِ الطُّہْرَ فِی وَقْتِ الظُّہْرِ فَلَمْ تَغْتَسِلْ حَتَّی یَدْخُلَ وَقْتُ الْعَصْرِ صَلَّتِ الظُّہْرَ وَالْعَصْرَ۔","","Musannaf Ibn Abi Shaybah 7291","","","كتاب الجمعة"
"7292","(۷۲۹۲) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، قَالَ : کَانَ مُحَمَّدٌ لاَ یَرَی بَأْسًا أَنْ یَؤُمَّ الرَّجُلُ الْقَوْمَ یَقْرَأُ فِی الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 7292","","","كتاب الجمعة"
"7293","(۷۲۹۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : سَمِعْتُ الْقَاسِمَ یَقُولُ کَانَ یَؤُمُّ عَائِشَۃَ عَبْدٌ یَقْرَأُ فِی الْمُصْحَفِ۔","Sahih","Musannaf Ibn Abi Shaybah 7293","","","كتاب الجمعة"
"7294","(۷۲۹۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِی بَکْرِ بْنِ أَبِی مُلَیْکَۃَ ، أَنَّ عَائِشَۃَ أَعْتَقَتْ غُلاَمًا لَہَا عَنْ دُبُرٍ ، فَکَانَ یَؤُمُّہَا فِی رَمَضَانَ فِی الْمُصْحَفِ۔","Hasan","Musannaf Ibn Abi Shaybah 7294","","","كتاب الجمعة"
"7295","(۷۲۹۵) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْن عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَائِشَۃَ ابْنَۃِ طَلْحَۃَ ، أَنَّہَا کَانَتْ تَأْمُرُ غُلاَمًا ، أَوْ إنْسَانًا یَقْرَأُ فِی الْمُصْحَفِ یَؤُمُّہَا فِی رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 7295","","","كتاب الجمعة"
"7296","(۷۲۹۶) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ؛ فِی الرَّجُلِ یَؤُمُّ فِی رَمَضَانَ یَقْرَأُ فِی الْمُصْحَفِ رَخَّصَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 7296","","","كتاب الجمعة"
"7297","(۷۲۹۷) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ ، قَالاَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 7297","","","كتاب الجمعة"
"7298","(۷۲۹۸) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ رَبَاحِ بْنِ أَبِی مَعْرُوفٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 7298","","","كتاب الجمعة"
"7299","(۷۲۹۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الرَّبِیعُ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ أَنْ یَؤُمَّ فِی الْمُصْحَفِ إذَا لَمْ یَجِدْ ، یَعْنِی مَنْ یَقْرَأُ ظَاہِرًا۔","","Musannaf Ibn Abi Shaybah 7299","","","كتاب الجمعة"
"7300","(۷۳۰۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا عِیسَی بْنُ طَہْمَانَ ، قَالَ : حَدَّثَنِی ثَابِتٌ الْبُنَانِیُّ ، قَالَ : کَانَ أَنَسٌ یُصَلِّی وَغُلاَمُہُ یُمْسِکُ الْمُصْحَفَ خَلْفَہُ فَإِذَا تَعَایَا فِی آیَۃٍ فَتَحَ عَلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 7300","","","كتاب الجمعة"
"7301","(۷۳۰۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ عَیَّاشِ الْعَامِرِیِّ ، عَنْ سُلَیْمَانَ بْنِ حَنْظَلَۃَ الْبَکْرِیِّ ، أَنَّہُ مَرَّ عَلَی رَجُلٍ یَؤُمُّ قَوْمًا فِی الْمُصْحَفِ فَضَرَبَہُ بِرِجْلِہِ۔","","Musannaf Ibn Abi Shaybah 7301","","","كتاب البيوع والأقضية"
"7302","(۷۳۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَطَائٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَانِ ، أَنَّہُ کَرِہَ أَنْ یَؤُمَّ فِی الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 7302","","","كتاب البيوع والأقضية"
"7303","(۷۳۰۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ أَنْ یَؤُمَّ الرَّجُلُ فِی الْمُصْحَفِ کَرَاہَۃَ أَنْ یَتَشَبَّہُوا بِأَہْلِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 7303","","","كتاب البيوع والأقضية"
"7304","(۷۳۰۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَؤُمَّ الرَّجُلُ وَہُوَ یَقْرَأُ فِی الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 7304","","","كتاب البيوع والأقضية"
"7305","(۷۳۰۵) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَؤُمَّ الرَّجُلُ فِی الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 7305","","","كتاب البيوع والأقضية"
"7306","(۷۳۰۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : إذَا کَانَ مَعَہُ مَنْ یَقْرَأُ رَدَّدُوہُ ، وَلَمْ یَؤُمَّ فِی الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 7306","","","كتاب البيوع والأقضية"
"7307","(۷۳۰۷) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیُّ، عَنْ قَتَادَۃَ، عَنِ الْحَسَنِ، أَنَّہُ کَرِہَہُ، وَقَالَ: ہَکَذَا تَفْعَلُ النَّصَارَی۔","","Musannaf Ibn Abi Shaybah 7307","","","كتاب البيوع والأقضية"
"7308","(۷۳۰۸) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ وَقَتَادَۃَ فِی رَجُلٍ یَؤُمُّ الْقَوْمَ فِی رَمَضَانَ فِی الْمُصْحَفِ فَکَرِہَاہُ۔","","Musannaf Ibn Abi Shaybah 7308","","","كتاب البيوع والأقضية"
"7309","(۷۳۰۹) حَدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ یَؤُمُّ فِی الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 7309","","","كتاب البيوع والأقضية"
"7310","(۷۳۱۰) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ مُغِیرَۃَ ، عَنِ الشَّعْبِی[corrupt]ِ ، قَالَ : إذَا دَخَلَ وَقْتُ صَلاَۃٍ عَلَی الْمَرْأَۃِ فَلَمْ تُصَلِّ حَتَّی حَاضَتْ وَہِیَ فِی وَقْتِ صَلاَۃٍ قَضَتْہَا إذَا طَہُرَتْ۔","","Musannaf Ibn Abi Shaybah 7310","","","كتاب الجمعة"
"7311","(۷۳۱۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ شُبْرُمَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا دَخَلَ وَقْتُ الصَّلاَۃ فَحَاضَتِ الْمَرْأَۃُ قَبْلَ أَنْ تُصَلِّیَ فَلْتُصَلِّہَا حِین تَطْہُرَ۔","","Musannaf Ibn Abi Shaybah 7311","","","كتاب الجمعة"
"7312","(۷۳۱۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ إیَاسٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : سَأَلْتُہُ ، عَنِ امْرَأَۃٍ دَخَلَتْ فِی وَقْتِ صَلاَۃٍ فَأَخَّرَتْہَا حَتَّی حَاضَتْ ، قَالَ : تَبْدَأُ بِہَا إذَا طَہُرَتْ۔","","Musannaf Ibn Abi Shaybah 7312","","","كتاب الجمعة"
"7313","(۷۳۱۳) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ ، قَالاَ : إذَا حَاضَتْ فِی وَقْتِ صَلاَۃٍ فَلَیْسَ عَلَیْہَا قَضَائُ تِلْکَ الصَّلاَۃ إِلاَّ أَنْ یَکُونَ الْوَقْتُ قَدْ ذَہَبَ۔","","Musannaf Ibn Abi Shaybah 7313","","","كتاب الجمعة"
"7314","(۷۳۱۴) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، قَالَ لَیْسَ عَلَیْہَا قَضَاؤُہَا لأَنَّہَا فِی وَقْتٍ۔","","Musannaf Ibn Abi Shaybah 7314","","","كتاب الجمعة"
"7315","(۷۳۱۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ مُعَاذَۃَ الْعَدَوِیَّۃِ ، عَنْ عَائِشَۃَ ، أَنَّ الْمَرْأَۃَ سَأَلَتْہَا تَقْضِی الْحَائِضُ الصَّلاَۃ ، فَقَالَتْ لَہَا عَائِشَۃُ : أَحَرُورِیَّۃٌ أَنْتِ قَدْ کُنَّا نَحِیضُ عَلَی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ نَطْہُرُ فَلاَ یَأْمُرُنَا بِقَضَائِ الصَّلاَۃ۔ (بخاری ۳۲۱۔ ابوداؤد ۲۶۶)","Sahih","Musannaf Ibn Abi Shaybah 7315","","","كتاب الجمعة"
"7316","(۷۳۱۶) حَدَّثَنَا وَکِیعٌ، عَنْ شُعْبَۃَ، عَنْ یَزِیدَ الرِّشْکِ، عَنْ مُعَاذَۃَ الْعَدَوِیَّۃِ، قَالَتْ: سُئلَتْ عَائِشَۃَ أَتَجْزِی الْحَائِضَ الصَّلاَۃ ، قَالَتْ : قَدْ کُنَّ نِسَائُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَحِضْنَ أَفَکُنَّ یَجْزِینَ ، تَعْنِی لاَ یَقْضِینَ۔ (مسلم ۲۶۵۔ احمد ۶/۱۸۵)","Sahih","Musannaf Ibn Abi Shaybah 7316","","","كتاب الجمعة"
"7317","(۷۳۱۷) حَدَّثَنَا حُمَیْدُ بنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کُنَّا بَنَاتُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَزْوَاجُہُ یَحِضْنَ فَیَأْمُرُہُنَّ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِقَضَائِ الصِّیَامِ ، وَلاَ یَأْمُرُہُنَّ بِقَضَائِ الصَّلاَۃ۔ (عبدالرزاق ۱۲۷۹)","","Musannaf Ibn Abi Shaybah 7317","","","كتاب الجمعة"
"7318","(۷۳۱۸) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ وَالشَّعْبِیِّ ، قَالاَ : لاَ تَقْضِی الْحَائِضُ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7318","","","كتاب الجمعة"
"7319","(۷۳۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ تَقْضِی الْحَائِضُ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7319","","","كتاب الجمعة"
"7320","(۷۳۲۰) حَدَّثَنَا وَکِیعٌ قَالَ : حَدَّثَنَا شَرِیکٌ ، عَنْ کَثِیرٍ النَّوَّائِ ، قَالَ : سَأَلْتُ فَاطِمَۃَ بِنْتَ عَلِیٍّ أَتَقْضِینَ الصَّلاَۃ فِی أَیَّامِ حَیْضَتِکَ ، قَالَتْ لاَ۔","","Musannaf Ibn Abi Shaybah 7320","","","كتاب الجمعة"
"7321","(۷۳۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ فِی الْحَائِضِ تَسْمَعُ السَّجْدَۃَ ، قَالَ : لاَ تَقْضِی لأَنَّہَا لاَ تَقْضِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7321","","","كتاب الجمعة"
"7322","(۷۳۲۲) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ ابْنُ الزُّبَیْرِ إذَا قَامَ فِی الصَّلاَۃ کَأَنَّہُ عُودٌ مِنَ الْخُشُوعِ ، قَالَ مُجَاہِدٌ : وَحُدِّثْت ، أَنَّ أَبَا بَکْرٍ کَانَ کَذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 7322","","","كتاب الجمعة"
"7323","(۷۳۲۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ، قَالَ : قَالَ عَبْدُ اللہِ : قَارُّوا الصَّلاَۃ ، یَعْنِی اُسْکُنُوا فِیہَا۔","Sahih","Musannaf Ibn Abi Shaybah 7323","","","كتاب الجمعة"
"7324","(۷۳۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ رَجُلٍ قَدْ سَمَّاہُ حَسَنٌ ، أَوْ سُفْیَانُ ، عَنْ زُبَیْدٍ، قَالَ: رَأَیْتُ زَاذَانَ یُصَلِّی کَأَنَّہُ خَشَبَۃٌ۔","","Musannaf Ibn Abi Shaybah 7324","","","كتاب الجمعة"
"7325","(۷۳۲۵) حَدَّثَنَا مُعَاذٌ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : رَأَیْتُ مُسْلِمَ بْنَ یَسَارٍ یُصَلِّی کَأَنَّہُ وَدٌّ۔","","Musannaf Ibn Abi Shaybah 7325","","","كتاب الجمعة"
"7326","(۷۳۲۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ عَبْدُ اللہِ إذَا قَامَ إلَی الصَّلاَۃ کَأَنَّہُ ثَوْبٌ مُلْقًی۔","","Musannaf Ibn Abi Shaybah 7326","","","كتاب الجمعة"
"7327","(۷۳۲۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، قَالَ : قَالَ عَبْدُ اللہِ : قَارُّوا الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 7327","","","كتاب الجمعة"
"7328","(۷۳۲۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، قَالَ : قَالَ عَبْدُ اللہِ: قَارُّوا الصَّلاَۃ۔ قَالَ زَائِدَۃُ : فَقُلْت لِمَنْصُورٍ : مَا یَعْنِی بِذَلِکَ ؟ قَالَ : فَقَالَ : التَّمَکُّنَ فِیہَا۔","Sahih","Musannaf Ibn Abi Shaybah 7328","","","كتاب الجمعة"
"7329","(۷۳۲۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ أَنْ یَقُولَ الرَّجُلُ لَمْ أُصَلِّ وَیَقُولُ نُصَلِّی۔","","Musannaf Ibn Abi Shaybah 7329","","","كتاب الجمعة"
"7330","(۷۳۳۰) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : التَّسْبِیحُ لِلرِّجَالِ وَالتَّصْفِیقُ لِلنِّسَائِ۔ (بخاری ۱۲۰۳۔ ابوداؤد ۹۳۶)","Sahih","Musannaf Ibn Abi Shaybah 7330","","","كتاب الجمعة"
"7331","(۷۳۳۱) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : صَلَّی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالنَّاسِ ذَاتَ یَوْمٍ ، فَلَمَّا قَامَ لِیُکَبِّرَ ، قَالَ : إِنْ أَنْسَانِی الشَّیْطَانُ شَیْئًا مِنْ صَلاَتِی فَالتَّسْبِیحُ لِلرِّجَالِ وَالتَّصْفِیقُ لِلنِّسَائِ۔ (ترمذی ۲۷۸۷۔ نسائی ۹۴۰۹)","","Musannaf Ibn Abi Shaybah 7331","","","كتاب الجمعة"
"7332","(۷۳۳۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَبْدِ الْحَمِیدِ الْمَدَنِیِّ ، عَنْ أَبِی حَازِمٍ ، عَنْ سَہْلِ بْنِ سَعْدٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : التَّسْبِیحُ لِلرِّجَالِ وَالتَّصْفِیقُ لِلنِّسَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 7332","","","كتاب الجمعة"
"7333","(۷۳۳۳) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنْ أَبِی الزُّبَیْرِ، عَنْ جَابِرٍ، قَالَ: التَّسْبِیحُ فِی الصَّلاَۃ لِلرِّجَالِ وَالتَّصْفِیقُ لِلنِّسَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 7333","","","كتاب الجمعة"
"7334","(۷۳۳۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، قَالَ : اسْتَأْذَنْت عَلَی ابْنِ أَبِی لَیْلَی وَہُوَ یُصَلِّی فَسَبَّحَ بِالْغُلاَمِ فَفَتَحَ لِی۔","","Musannaf Ibn Abi Shaybah 7334","","","كتاب الجمعة"
"7335","(۷۳۳۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : اسْتَأْذَنَ رَجُلٌ عَلَی جَابِرِ بْنِ عَبْدِ اللہِ فَسَبَّحَ فَدَخَلَ فَجَلَسَ حَتَّی انْصَرَفَ۔","Hasan","Musannaf Ibn Abi Shaybah 7335","","","كتاب الجمعة"
"7336","(۷۳۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ نَافِعِ بْنِ عُمَرَ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یُصَلِّی فِی الْمَسْجِدِ فَمَرَّ بِہِ إنْسَانٌ ف[corrupt]سَبَّحَ بِہِ۔","","Musannaf Ibn Abi Shaybah 7336","","","كتاب الجمعة"
"7337","(۷۳۳۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذْنُ الرَّجُلِ إذَا کَانَ یُصَلِّی فِی بَیْتِہِ التَّسْبِیحُ وَإِذْنُ الْمَرْأَۃِ التَّصْفِیقُ۔","","Musannaf Ibn Abi Shaybah 7337","","","كتاب الجمعة"
"7338","(۷۳۳۸) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ رُبَّمَا کَانَ الإِنْسَاْن یَجِیئُ وَہُوَ فِی الصَّلاَۃ فَیَرَی ظِلَّہُ فَیُشِیرُ مُحَمَّدٌ بِیَدِہِ سُبْحَانَ اللہِ۔","","Musannaf Ibn Abi Shaybah 7338","","","كتاب الجمعة"
"7339","(۷۳۳۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ یَزِیدَ بْنِ زِیَادٍ ، قَالَ : دَخَلْت عَلَی سَالِمِ بْنِ أَبِی الْجَعْدِ وَہُوَ یُصَلِّی ، فَقَالَ: سُبْحَانَ اللہِ ، فَلَمَّا انْصَرَفَ ، قَالَ : إنَّ التَّسْبِیحَ لِلرِّجَالِ وَالتَّصْفِیقَ لِلنِّسَائِ۔","","Musannaf Ibn Abi Shaybah 7339","","","كتاب الجمعة"
"7340","(۷۳۴۰) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : التَّسْبِیحُ لِلرِّجَالِ وَالتَّصْفِیقُ لِلنِّسَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 7340","","","كتاب الجمعة"
"7341","(۷۳۴۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ الْعُکْلِیِّ ، عَنْ عَبْدِ اللہِ بْنِ نُجیٍّ ، عَنْ عَلِیٍّ ، قَالَ : کُنْتُ إذَا دَخَلْت عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یُصَلِّی تَنَحْنَحُ لِی۔ (ابن ماجہ ۳۷۰۸۔ احمد ۱/۸۵)","Hasan","Musannaf Ibn Abi Shaybah 7341","","","كتاب الجمعة"
"7342","(۷۳۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، قَالَ : مَرَرْت بِابْنِ عُمَرَ وَہُوَ یُصَلِّی فَانْتَہَرَنِی بِتَسْبِیحِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 7342","","","كتاب الجمعة"
"7343","(۷۳۴۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، أَنَّہُ کَانَ یَقُولُ : فِی الْحَائِضِ تُنَظِّفُ وَتَتَّخِذُ مَکَانًا فِی مَوَاقِیتِ الصَّلاَۃ تَذْکُرُ اللَّہَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 7343","","","كتاب الجمعة"
"7344","(۷۳۴۴) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، قَالَ : قِیلَ لأَبِی قِلاَبَۃَ : الْحَائِضُ تَسْمَعُ الأَذَانَ فَتَوَضَّأُ وَتُکَبِّرُ وَتُسَبِّحُ ، قَالَ : قَدْ سَأَلْنَا ، عَنْ ذَلِکَ فَمَا وَجَدْنَا لَہُ أَصْلاً۔","","Musannaf Ibn Abi Shaybah 7344","","","كتاب الجمعة"
"7345","(۷۳۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سفیان ، عَنْ سلیمان التیمی ، عن أبی قلابۃ ، قَالَ : لم نجد لہ أصلاً۔","","Musannaf Ibn Abi Shaybah 7345","","","كتاب الجمعة"
"7346","(۷۳۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ بِدْعَۃ۔","","Musannaf Ibn Abi Shaybah 7346","","","كتاب الجمعة"
"7347","(۷۳۴۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنْہُ فَکَرِہَاہُ۔","","Musannaf Ibn Abi Shaybah 7347","","","كتاب الجمعة"
"7348","(۷۳۴۸) حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِیٔ ، عَنْ سَعِیدِ بْنِ أَبِی أَیُّوبَ ، قَالَ : حدَّثَنِی خَالِدُ بْنُ یَزِیدَ الصَّدَفِیُّ ، عَنْ أَبِیہِ ، عَنْ عُقْبَۃَ بْنِ عَامِرٍ ، أَنَّہُ کَانَ یَأْمُرُ الْمَرْأَۃَ الْحَائِضَ فِی وَقْتِ الصَّلاَۃ أَنْ تَوَضَّأَ وَتَجْلِسَ بِفِنَائِ الْمَسْجِدِ وَتَذْکُرَ اللَّہَ وَتُہَلِّلَ وَتُسَبِّحَ۔","Da'if","Musannaf Ibn Abi Shaybah 7348","","","كتاب الجمعة"
"7349","(۷۳۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : إِنَّا لَنَأْمُرُ نِسَائَنَا فِی الْحَیْضِ أَنْ یَتَوَضَّأْنَ فِی وَقْتِ کُلِّ صَلاَۃٍ ، ثُمَّ یَجْلِسْنَ وَیُسَبِّحْنَ وَیَذْکُرْنَ اللَّہَ۔","","Musannaf Ibn Abi Shaybah 7349","","","كتاب الجمعة"
"7350","(۷۳۵۰) حَدَّثَنَا یَزیْدُ بْنُ ہَارُونَ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ الْحَسَنِ ، قَالَ : سَمِعْتُہُ یَقُولُ فِی الْحَائِضِ تَوَضَّأُ عِنْدَ کُلِّ صَلاَۃٍ وَتَذْکُرُ اللَّہَ۔","","Musannaf Ibn Abi Shaybah 7350","","","كتاب الجمعة"
"7351","(۷۳۵۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : مَنْ صَلَّی أَرْبَعًا بَعْدَ الْعِشَائِ کُنَّ کَقَدْرِہِنَّ مِنْ لَیْلَۃِ الْقَدْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 7351","","","كتاب الجمعة"
"7352","(۷۳۵۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ، قَالَتْ: أَرْبَعَۃٌ بَعْدَ الْعِشَائِ یُعْدَلْنَ بِمِثْلِہِنَّ مِنْ لَیْلَۃِ الْقَدْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 7352","","","كتاب الجمعة"
"7353","(۷۳۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْجَبَّارِ بْنِ عَبَّاسٍ ، عَنْ قَیْسِ بْنِ وَہْبٍ ، عَنْ مُرَّۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : مَنْ صَلَّی أَرْبَعًا بَعْدَ الْعِشَائِ لاَ یَفْصِلُ بَیْنَہُنَّ بِتَسْلِیمٍ عُدِلْنَ بِمِثْلِہِنَّ مِنْ لَیْلَۃِ الْقَدْرِ۔","Hasan","Musannaf Ibn Abi Shaybah 7353","","","كتاب الجمعة"
"7354","(۷۳۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ أَیْمَنَ ، عَنْ أَبِیہِ ، عَنْ تُبَیْعٍ ، عَنْ کَعْبِ بْنِ مَاتِعٍ ، قَالَ : مَنْ صَلَّی أَرْبَعًا بَعْدَ الْعِشَائِ یُحْسِنُ فِیہِنَّ الرُّکُوعَ وَالسُّجُودَ عُدِلْنَ بمِثْلَہِنَّ مِنْ لَیْلَۃِ الْقَدْرِ۔","","Musannaf Ibn Abi Shaybah 7354","","","كتاب الجمعة"
"7355","(۷۳۵۵) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ أَیْمَنَ ، عَنْ تُبَیع ، عَنْ کَعْبٍ نَحْوَہُ۔","","Musannaf Ibn Abi Shaybah 7355","","","كتاب الجمعة"
"7356","(۷۳۵۶) حَدَّثَنَا یَعْلَی ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، قَالَ : أَرْبَعُ رَکَعَاتٍ بَعْدَ الْعِشَائِ الآخِرَۃِ یَکُنَّ بِمَنْزِلَتِہِنَّ مِنْ لَیْلَۃِ الْقَدْرِ۔","","Musannaf Ibn Abi Shaybah 7356","","","كتاب الجمعة"
"7357","(۷۳۵۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ بُکَیْرِ بْنِ عَامِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ : مَنْ صَلَّی أَرْبَعَ رَکَعَاتٍ بَعْدَ الْعِشَائِ الآخِرَۃِ عُدِلْنَ بِمِثْلِہِنَّ مِنْ لَیْلَۃِ الْقَدْرِ۔","","Musannaf Ibn Abi Shaybah 7357","","","كتاب الجمعة"
"7358","(۷۳۵۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ شُعْبَۃَ مَوْلَی ابْنِ عَبَّاسٍ ، قَالَ : صَلَّیْت إلَی جَنْبِ ابْنِ عَبَّاسٍ فَفَقَعْت أَصَابِعِی ، فَلَمَّا قَضَیْت الصَّلاَۃ ، قَالَ : لاَ أُمَّ لَکَ أَتَفْقَع أَصَابِعَک وَأَنْتَ فِی الصَّلاَۃ۔","Da'if","Musannaf Ibn Abi Shaybah 7358","","","كتاب الجمعة"
"7359","(۷۳۵۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یَکْرَہُ أَنْ یُنْقِضَ الرَّجُلُ أَصَابِعَہُ ، یَعْنِی وَہُوَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7359","","","كتاب الجمعة"
"7360","(۷۳۶۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، أَنَّہُ کَرِہَ أَنْ یُنْقِضَ أَصَابِعَہُ وَہُوَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7360","","","كتاب الجمعة"
"7361","(۷۳۶۱) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : خَمْسٌ تُنْقِصُ الصَّلاَۃ : التَّمَطِّی وَالأَلْتِفَاتُ وَتَقْلِیبُ الْحَصَی وَالْوَسْوَسَۃُ وَتَفْقِیعُ الأَصَابِعِ۔","","Musannaf Ibn Abi Shaybah 7361","","","كتاب الجمعة"
"7362","(۷۳۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، وَعَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ أَنَّہُمَا کَرِہَا أَنْ یُفَرْقِعَ الرَّجُلُ أَصَابِعَہُ وَہُوَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7362","","","كتاب الجمعة"
"7363","(۷۳۶۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ ، عَنِ الرَّجُلِ یَرَی فِی ثَوْبِہِ دَمًا وَہُوَ فِی الصَّلاَۃ ، قَالَ : إِنْ کَانَ کَثِیرًا فَلْیُلْقِ الثَّوْبَ عَنْہُ ، وَإِنْ کَانَ قَلِیلاً فَلْیَمْضِ فِی صَلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 7363","","","كتاب الجمعة"
"7364","(۷۳۶۴) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ بُرْدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ إذَا کَانَ فِی الصَّلاَۃ فَرَأَی فِی ثَوْبِہِ دَمًا فَاسْتَطَاعَ أَنْ یَضَعَہُ وَضَعَہُ وَإِنْ لَمْ یَسْتَطِعْ أَنْ یَضَعَہُ خَرَجَ فَغَسَلَہُ ، ثُمَّ جَائَ فَبَنَی عَلَی مَا کَانَ صَلَّی۔","Sahih","Musannaf Ibn Abi Shaybah 7364","","","كتاب الجمعة"
"7365","(۷۳۶۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَنْصَرِفُ مِنَ الدَّمِ قَلِیلِہِ وَکَثِیرِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 7365","","","كتاب الجمعة"
"7366","(۷۳۶۶) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا رَأَیْتُہُ وَقَدْ صَلَّیْت بَعْضَ صَلاَتِکَ فَضَعِ الثَّوْبَ عَنْک وَامْضِ فِی صَلاَتِک۔","","Musannaf Ibn Abi Shaybah 7366","","","كتاب الجمعة"
"7367","(۷۳۶۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ حَمَّادًا ، عَنِ الرَّجُلِ یُصَلِّی فَیَرَی فِی ثَوْبِہِ الدَّمَ ، قَالَ : یُلْقِی الثَّوْبَ عَنْہُ قُلْتُ ، فَإِنْ لَمْ یَکُنْ إِلاَّ ثَوْبَیْنِ ، قَالَ : یُلْقِی أَحَدَہُمَا وَیَتَوَشَّحُ بِالأَخَرِ۔ وَسَأَلَتُ الْحَکَمَ ، فَقَالَ مِثْلُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 7367","","","كتاب الجمعة"
"7368","(۷۳۶۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، أَنَّہُ کَانَ یُصَلِّی فَرَأَی فِی ثَوْبِہِ دَمًا فَوَضَعَہُ۔","","Musannaf Ibn Abi Shaybah 7368","","","كتاب الجمعة"
"7369","(۷۳۶۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عِمْرَانَ ، عَنْ أَبِی مِجْلَزٍ فِی الدَّمِ یَکُونُ فِی الثَّوْبِ ، قَالَ : إذَا کَبَّرْت وَدَخَلْت فِی الصَّلاَۃ ، وَلَمْ تَرَ شَیْئًا ، ثُمَّ رَأَیْتُہُ بَعْدُ فَأَتِمَّ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7369","","","كتاب الجمعة"
"7370","(۷۳۷۰) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ جَابِرٍ، عَنْ أَبِی جَعْفَرٍ، قَالَ: إذَا رَأَیْت فِی ثَوْبِکَ دَمًا فَامْضِ فِی صَلاَتِک۔","","Musannaf Ibn Abi Shaybah 7370","","","كتاب الجمعة"
"7371","(۷۳۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَبِی الْبَخْتَرِیِّ ، عَنِ الْہُجَیْمِ ، قَالَ : قُلْتُ لِعَبْدِ اللہِ بْنِ رَبَاحٍ : أَرَی الدَّمَ فِی ثَوْبِی وَأَنَا فِی الصَّلاَۃ ، قَالَ : امْضِ فِی صَلاَتِکَ فَإِذَا انْصَرَفْت فَاغْسِلْہُ۔","","Musannaf Ibn Abi Shaybah 7371","","","كتاب الجمعة"
"7372","(۷۳۷۲) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ خُصَیْفٍ الْجَزَرِیِّ ، عَنْ مُجَاہِدٍ ، قَالَ: رُخِّصَ لِلشَّیْخِ إذَا أَرَادَ الْقِیَامَ لِلصَّلاَۃِ أَنْ یُقَدِّمَ رِجْلَہُ۔","","Musannaf Ibn Abi Shaybah 7372","","","كتاب الجمعة"
"7373","(۷۳۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ عَلِیٍّ السُّلَمِیِّ ، عَنْ إبْرَاہِیمَ بْنِ مَعْبَدٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی الرَّجُلِ یَنْہَضُ فِی الصَّلاَۃ فَیُقَدِّمُ إحْدَی رِجْلَیْہِ فَکَرِہَہُ ، وَقَالَ : ہَذِہِ خُطْوَۃٌ مَلْعُونَۃٌ۔ (ابوداؤد ۶۴۳۔ ابن خزیمۃ ۷۷۲)","Da'if","Musannaf Ibn Abi Shaybah 7373","","","كتاب الجمعة"
"7374","(۷۳۷۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی أَبُو بَکْرٍ عَمَّنْ أَخْبَرَہُ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی أَنْ یُخَمَّرَ الْفَمُ فِی الصَّلاَۃ۔","Da'if","Musannaf Ibn Abi Shaybah 7374","","","كتاب الجمعة"
"7375","(۷۳۷۵) حَدَّثَنِی الثَّقَفِیُّ ، عَنْ أَیُّوب ، عَنْ مُحَمَّدٍ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یُغَطِّیَ الرَّجُلُ فَاہُ وَہُوَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7375","","","كتاب الجمعة"
"7376","(۷۳۷۶) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ أَنْ یُغَطِّیَ فَمَہ وَہُوَ فِی صَلاَۃٍ۔","","Musannaf Ibn Abi Shaybah 7376","","","كتاب الجمعة"
"7377","(۷۳۷۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ جَعْدَۃَ بْنِ ہُبَیْرَۃَ ، أَنَّہُ رَأَی رَجُلاً یُصَلِّی وَعَلَیْہِ مِغْفَرٌ وَعِمَامَۃٌ قَدْ غَطَّی بِہِمَا وَجْہَہُ فَأَخَذَ بِمِغْفَرِہِ وَعِمَامَتِہِ فَأَلْقَاہُمَا مِنْ خَلْفِہِ۔","","Musannaf Ibn Abi Shaybah 7377","","","كتاب الجمعة"
"7378","(۷۳۷۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : سَأَلْتُہُ ، عَنْ تَغْطِیَۃِ الْفَمِ فِی الصَّلاَۃ وَالطَّوَافِ فَکَرِہَہُ فِی الصَّلاَۃ وَرَخَّصَ فِیہِ فِی الطَّوَافِ۔","","Musannaf Ibn Abi Shaybah 7378","","","كتاب الجمعة"
"7379","(۷۳۷۹) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْمُجَبِّرِ ، أَنَّ سَالِمَ بْنَ عَبْدِ اللہِ کَانَ إذَا رَأَی الرَّجُلَ یُغَطِّی فَاہُ وَہُوَ فِی الصَّلاَۃ جَبَذَ الثَّوْبَ جَبْذًا شَدِیدًا حَتَّی یَنْزِعَہُ عَنْ فِیہِ۔","","Musannaf Ibn Abi Shaybah 7379","","","كتاب الجمعة"
"7380","(۷۳۸۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، أَنَّہُ کَرِہَ أَنْ یُغَطِّیَ الرَّجُلُ فَمَہ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7380","","","كتاب الجمعة"
"7381","(۷۳۸۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ عَمَّنْ سَمِعَ ابْنَ أَبِی لَیْلَی یَقُولُ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 7381","","","كتاب الجمعة"
"7382","(۷۳۸۲) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُسْلِمِ بْنِ بُدَیْلٍ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یُصَلِّیَ ہَکَذَا وَوَضَعَ أَزْہَرُ ثَوْبَہُ عَلَی شَفَتِہِ۔","","Musannaf Ibn Abi Shaybah 7382","","","كتاب الجمعة"
"7383","(۷۳۸۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا بُکَیْر بْن عَامِرٍ ، عَنْ إبْرَاہِیمَ وَالشَّعْبِیِّ أَنَّہُمَا کَرِہَا أَنْ یُغَطِّیَ الرَّجُلُ فَاہُ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7383","","","كتاب الجمعة"
"7384","(۷۳۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْعُمَرِیُّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَرِہَ أَنْ یَتَلَثَّمَ الرَّجُلُ فِی الصَّلاَۃ۔","Da'if","Musannaf Ibn Abi Shaybah 7384","","","كتاب الجمعة"
"7385","(۷۳۸۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَعِکْرِمَۃَ أنَّہُمَا کَرِہَا أَنْ یَتَلَثَّمَ الرَّجُلُ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7385","","","كتاب الجمعة"
"7386","(۷۳۸۶) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، أَنَّہُ کَرِہَ أَنْ یُصَلِّیَ الرَّجُلُ مُتَلَثِّمًا۔","","Musannaf Ibn Abi Shaybah 7386","","","كتاب الجمعة"
"7387","(۷۳۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ أَنْ یَتَلَثَّمَ الرَّجُلُ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7387","","","كتاب الجمعة"
"7388","(۷۳۸۸) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَرِہَ لِلرَّجُلِ أَنْ یُصَلِّیَ مُتَلَثِّمًا۔","","Musannaf Ibn Abi Shaybah 7388","","","كتاب الجمعة"
"7389","(۷۳۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : کَانَ یُکْرَہُ التَّلَثُّمَ فِی ثَلاَثٍ فِی الْقِتَالِ ، وَفِی الْجَنَائِزِ ، وَفِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7389","","","كتاب الجمعة"
"7390","(۷۳۹۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ خَالِدٍ ، عَنْ رَجُلٍ ، عَنْ عَلِیٍّ ، أَنَّہُ کَرِہَ الاِلْتِثَامَ فِی الصَّلاَۃ عَلَی الأَنْفِ وَالْفَمِ۔","Da'if","Musannaf Ibn Abi Shaybah 7390","","","كتاب الجمعة"
"7391","(۷۳۹۱) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ ہَمَّام ، عَنْ قَتَادَۃَ ؛ فِی الرَّجُلِ یُغَطِّی أَنْفَہُ فِی الصَّلاَۃ ، فَقَالَ : حدَّثَنِی عِکْرِمَۃُ ، أَنَّ ابْنَ عَبَّاسٍ کَرِہَ الأَنْفَ۔n قَالَ قَتَادَۃُ : وَکَانَ سَعِیدُ بْنُ الْمُسَیَّبِ وَالنَّخَعِیُّ وَعَطَائٌ یَکْرَہُونَہُ وَکَانَ الْحَسَنُ لاَ یَرَی بِہِ بَأْسًا۔n قَالَ قَتَادَۃُ : فَأَمَّا الْفَمُ فَلاَ أَرَی بِہِ بَأْسًا۔","Sahih","Musannaf Ibn Abi Shaybah 7391","","","كتاب الجمعة"
"7392","(۷۳۹۲) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ أَبِی خَلْدَۃَ ، عَنْ أَبِی الْعَالِیَۃِ ، أَنَّہُ کَرِہَ أَنْ یُغَطِّیَ أَنْفَہُ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7392","","","كتاب الجمعة"
"7393","(۷۳۹۳) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ حَمَّادًا فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 7393","","","كتاب الجمعة"
"7394","(۷۳۹۴) حَدَّثَنَا حَفْصٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَکْرَہُ أَنْ یُغَطِّیَ أَنْفَہُ وَفَمَہ جَمِیعًا ، وَلاَ یَرَی بَأْسًا أَنْ یُغَطِّیَ فَمَہ دُونَ أَنْفِہِ۔","","Musannaf Ibn Abi Shaybah 7394","","","كتاب الجمعة"
"7395","(۷۳۹۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ أَبِی رَافِعٍ ، عَنْ سَعِیدِ بْنِ کَعْبٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، أَنَّہُ کَرِہَ أَنْ تُصَلِّیَ الْمَرْأَۃُ وَہِیَ مُتَنَقِّبۃٌ ، أَوْ تَطُوفَ وَہِیَ مُتَنَقِّبۃٌ۔","","Musannaf Ibn Abi Shaybah 7395","","","كتاب الجمعة"
"7396","(۷۳۹۶) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، أَنَّہُ کَرِہَ أَنْ تُصَلِّیَ الْمَرْأَۃُ مُتَنَقِّبۃً۔","","Musannaf Ibn Abi Shaybah 7396","","","كتاب الجمعة"
"7397","(۷۳۹۷) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَکْرَہُ أَنْ تُصَلِّیَ الْمَرْأَۃُ مُتَنَقِّبۃً۔","","Musannaf Ibn Abi Shaybah 7397","","","كتاب الجمعة"
"7398","(۷۳۹۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ ضَمْرَۃَ بْنِ سَعِیدٍ ، سَمِعَ أَبَا سَعِیدٍ یَقُولُ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ صَلاَۃٍ بَعْدَ الْعَصْرِ حَتَّی الْغُرُوبِ وَبَعْدَ الْفَجْرِ حَتَّی الطُّلُوعِ۔ (بخاری ۱۱۹۷۔ مسلم ۵۶۷)","Sahih","Musannaf Ibn Abi Shaybah 7398","","","كتاب الجمعة"
"7399","(۷۳۹۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن نَصْرِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ جَدِّہِ مُعَاذٍ الْقُرَشِیِّ ، أَنَّہُ طَافَ بِالْبَیْتِ مَعَ مُعَاذِ بْنِ عَفْرَائَ بَعْدَ الْعَصْرِ ، وَبَعْدَ الصُّبْحِ فَلَمْ یُصَلِّ فَسَأَلْتُہُ ، فَقَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ صَلاَۃَ بَعْدَ صَلاَتَیْنِ بَعْدَ الْغَدَاۃِ حَتَّی تَطْلُعَ الشَّمْسُ ، وَبَعْدَ الْعَصْرِ حَتَّی تَغْرُبَ الشَّمْسُ۔ (طبرانی ۳۷۸۔ احمد ۴/۲۱۹)","Da'if","Musannaf Ibn Abi Shaybah 7399","","","كتاب الجمعة"
"7400","(۷۴۰۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، وَابْنُ نُمَیْرٍ ، عَنْ عُبَیدِ اللہِ بْنِ عُمَرَ ، عَنْ خُبَیب بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ حَفْصِ بْنِ عَاصِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ صَلاَتَیْنِ ، عَنِ الصَّلاَۃ بَعْدِ طُلُوعِ الْفَجْرِ حَتَّی تَطْلُعَ الشَّمْسُ وَبَعْدَ الْعَصْرِ حَتَّی تَغْرُبَ الشَّمْسُ۔ (بخاری ۵۸۴۔ احمد ۲/۴۹۶)","Sahih","Musannaf Ibn Abi Shaybah 7400","","","كتاب الجمعة"
"7401","(۷۴۰۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، وَابْنُ نُمَیْرٍ ، عَنْ سَعدِ بْنِ سَعِیدٍ ، قَالَ أَخْبَرَتْنِی عَمْرَۃُ ، عَنْ عَائِشَۃَ ، قَالَتْ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ صَلاَتَیْنِ ، عَنْ صَلاَۃٍ بَعْدَ طُلُوعِ الْفَجْرِ حَتَّی تَطْلُعَ الشَّمْسُ وَتَرْتَفِعَ فَإِنَّہَا تَطْلُعُ بَیْنَ قَرْنَیِ الشَّیْطَانِ وتَغِیبُ بَیْنَ قَرْنَیِ الشَّیْطَانِ ، وَعَنْ صَلاَۃٍ بَعْدَ الْعَصْرِ حَتَّی تَغِیبَ الشَّمْسُ۔ (طحاوی ۳۰۳)","Hasan","Musannaf Ibn Abi Shaybah 7401","","","كتاب الجمعة"
"7402","(۷۴۰۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ وَہْبِ بْنِ الأَجْدَعِ ، عَنْ عَلِیٍّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ صَلاَۃَ بَعْدَ الْعَصْرِ إِلاَّ أَنْ تَکُونَ الشَّمْسُ بَیْضَائَ نَقِیَّۃً۔(ابوداؤد ۱۲۶۸۔ احمد ۱/۸۱)","Sahih","Musannaf Ibn Abi Shaybah 7402","","","كتاب الجمعة"
"7403","(۷۴۰۳) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، عَنْ سِمَاکٍ ، قَالَ : سَمِعْتُ الْمُہَلَّبَ بْنَ أَبِی صُفْرَۃَ یُحَدِّثُ ، عَنْ سَمُرَۃََ بْنِ جُنْدُبٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : لاَ تُصَلُّوا ، أَوَ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُصَلِّیَ بَعْدَ صَلاَۃِ الصُّبْحِ حَتَّی تَطْلُعَ الشَّمْسُ فَإِنَّہَا تَطْلُعُ عَلَی قَرْنٍ ، أَوْ بَیْنَ قَرْنَیْ شَیْطَانٍ۔ (طحاوی ۱۵۲۔ احمد ۵/۱۵)","Hasan","Musannaf Ibn Abi Shaybah 7403","","","كتاب الجمعة"
"7404","(۷۴۰۴) حَدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی التَّیَّاحِ ، قَالَ : سَمِعْتُ حُمْرَانَ بْنَ أَبَانَ یُحَدِّثُ ، عَنْ مُعَاوِیَۃَ ، أَنَّہُ نَظَرَ إلَی أُنَاسٍ یُصَلُّونَ بَعْدَ الْعَصْرِ ، فَقَالَ : إنَّکُمْ تُصَلُّونَ صَلاَۃً قَدْ صَحِبْنَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَمَا رَأَیْنَاہُ یُصَلِّیہَا وَقَدْ نَہَی عَنْہَا۔ (احمد ۴/۹۹)","Sahih","Musannaf Ibn Abi Shaybah 7404","","","كتاب الجمعة"
"7405","(۷۴۰۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حُسَیْنٍ الْمُعَلِّمِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ صَلاَۃٍ بَعْدَ الْعَصْرِ حَتَّی تَغْرُبَ الشَّمْسُ ، وَعَنْ صَلاَۃٍ بَعْدَ الصُّبْحِ حَتَّی تَطْلُعَ الشَّمْسُ۔","Hasan","Musannaf Ibn Abi Shaybah 7405","","","كتاب الجمعة"
"7406","(۷۴۰۶) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ صَلاَتَیْنِ ، عَنْ صَلاَۃٍ بَعْدَ الصُّبْحِ حَتَّی تَطْلُعَ الشَّمْسُ ، وَعَنْ صَلاَۃٍ بَعْدَ الْعَصْرِ حَتَّی تَغْرُبَ الشَّمْسُ۔ (بخاری ۵۸۵۔ مسلم ۲۸۹)","Da'if","Musannaf Ibn Abi Shaybah 7406","","","كتاب الجمعة"
"7407","(۷۴۰۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا ہَمَّامٌ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی الْعَالِیَۃِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : حَدَّثَنی رِجَالٌ مَرْضِیُّونَ فِیہِمْ عُمَرُ وَأَرْضَاہُمْ ، عِنْدِی عُمَرُ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ صَلاَۃَ بَعْدَ الصُّبْحِ حَتَّی تَطْلُعَ الشَّمْسُ ، وَلاَ صَلاَۃَ بَعْدَ الْعَصْرِ حَتَّی تَغْرُبَ الشَّمْسُ۔ (بخاری ۵۸۱۔ ابوداؤد ۱۲۷۰)","Sahih","Musannaf Ibn Abi Shaybah 7407","","","كتاب الجمعة"
"7408","(۷۴۰۸) حَدَّثَنَا الثَّقَفِیُّ ، عَنِ الْمُہَاجِرِ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : لاَ تَصلُح الصَّلاَۃ بَعْدَ الْعَصْرِ حَتَّی تَغِیبَ الشَّمْسُ وَبَعْدَ الصُّبْحِ حَتَّی تَطْلُعَ الشَّمْسُ ، قَالَ وَکَانَ عُمَرَ یَضْرِبُ عَلَی ذَلِکَ۔","Hasan","Musannaf Ibn Abi Shaybah 7408","","","كتاب الجمعة"
"7409","(۷۴۰۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ مُحَمَّدِ بْنِ شَدَّادٍ ، عَنْ عبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنِ الأَشْتَرِ ، قَالَ : کَانَ خَالِدُ بْنُ الْوَلِیدِ یَضْرِبُ النَّاسَ عَلَی الصَّلاَۃ بَعْدَ الْعَصْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 7409","","","كتاب الجمعة"
"7410","(۷۴۱۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ووَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، عَنْ عَبْدِ اللہِ ، أَنَّ عُمَرَ کَرِہَ الصَّلاَۃ بَعْدَ الْعَصْرِ وَإِنِّی أَکْرَہُ مَا کَرِہَ عُمَرُ۔","Sahih","Musannaf Ibn Abi Shaybah 7410","","","كتاب الجمعة"
"7411","(۷۴۱۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ ، قَالَ : رَأَیْتُ عُمَرَ أَبْصَرَ رَجُلاً یُصَلِّی بَعْدَ الْعَصْرِ فَضَرَبَہُ حَتَّی سَقَطَ رِدَاؤُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 7411","","","كتاب الجمعة"
"7412","(۷۴۱۲) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ بْنِ أَبِی سَارَۃَ ، قَالَ : سَأَلْتُ سَالِمًا ، عَنِ الصَّلاَۃ بَعْدَ الْعَصْرِ ، فَقَالَ : مَا أُحِبُّ أَنْ أَبْتَدِئُ بِصَلاَۃٍ حَتَّی تَغْرُبَ الشَّمْسُ۔","","Musannaf Ibn Abi Shaybah 7412","","","كتاب الجمعة"
"7413","(۷۴۱۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ یَکْرَہُ الصَّلاَۃ بَعْدَ الْعَصْرِ حَتَّی تَغْرُبَ الشَّمْسُ۔","","Musannaf Ibn Abi Shaybah 7413","","","كتاب الجمعة"
"7414","(۷۴۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی جَمْرَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : رَأَیْتُ عُمَرَ یَضْرِبُ عَلَی الرَّکْعَتَیْنِ بَعْدَ الْعَصْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 7414","","","كتاب الجمعة"
"7415","(۷۴۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ، قَالَ : سَمِعْتُ عُبَیْدَ اللہِ بْنَ رَافِعِ بْنِ خَدِیجٍ یُحَدِّثُ ، عَنْ أَبِیہِ ، قَالَ : رَآنِی عُمَرُ بْنُ الْخَطَّابِ یَوْمًا وَأَنَا أُصَلِّی بَعْدَ الْعَصْرِ فَانْتَظَرَنِی حَتَّی صَلَّیْت ، فَقَالَ : مَا ہَذِہِ الصَّلاَۃ؟ فَقُلْت: سَبَقْتنِی بِشَیْئٍ مِنَ الصَّلاَۃ، فَقَالَ عُمَرُ: لَوْ عَلِمْت أَنَّک تُصَلِّی بَعْدَ الْعَصْرِ لَفَعَلْت وَفَعَلْت۔","Hasan","Musannaf Ibn Abi Shaybah 7415","","","كتاب الجمعة"
"7416","(۷۴۱۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ثَابِتُ بن عُمَارَۃَ ، عَنْ أَبِی تَمِیمَۃَ الْہُجَیْمِیِّ ، عَنِ ابْنِ عُمَرَ ، قَالَ : صَلَّیْت مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَمَعَ أَبِی بَکْرٍ وَعُمَرَ وَعُثْمَانَ فَلاَ صَلاَۃَ بَعْدَ الْغَدَاۃِ حَتَّی تَطْلُعَ الشَّمْسُ۔ (ابوداؤد ۱۴۱۰۔ احمد ۲/۱۰۶)","Hasan","Musannaf Ibn Abi Shaybah 7416","","","كتاب الجمعة"
"7417","(۷۴۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی عَلَی إِثْرِ کُلِّ صَلاَۃٍ مَکْتُوبَۃٍ رَکْعَتَیْنِ إِلاَّ الْفَجْرَ وَالْعَصْرَ۔ (ابوداؤد ۱۲۶۹۔ احمد ۱/۱۲۴)","Hasan","Musannaf Ibn Abi Shaybah 7417","","","كتاب الجمعة"
"7418","(۷۴۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنِ السَّائِبِ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ الْخَطَّابِ یَضْرِبُ الْمُنْکَدِرَ عَلَی السَّجْدَتَیْنِ بَعْدَ الْعَصْرِ ، یَعْنِی الرَّکْعَتَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 7418","","","كتاب الجمعة"
"7419","(۷۴۱۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عِمْرَانَ ، عَنْ سُوَیْد ، وَعَنْ أَبِی حُصَیْنٍ ، عَنْ قَبِیصَۃَ بْنِ جَابِرٍ ، قَالاَ : کَانَ عُمَرُ یَضْرِبُ عَلَی الرَّکْعَتَیْنِ بَعْدَ الْعَصْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 7419","","","كتاب الجمعة"
"7420","(۷۴۲۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْمُخْتَارِ ، قَالَ : سَأَلْتُ أَنَسَ بْنَ مَالِکٍ ، عَنِ الصَّلاَۃ بَعْدَ الْعَصْرِ ، فَقَالَ : کَانَ عُمَرُ یَضْرِبُ الأَیْدِی عَلَی الصَّلاَۃ بَعْدَ الْعَصْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 7420","","","كتاب الجمعة"
"7421","(۷۴۲۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو ہِلاَلٍ ، عَنِ ابن بُرَیْدَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ تَمْرَتَانِ بِزُبْدٍ أَحَبُّ إلَیَّ مِنْ صَلاَۃٍ بَعْدَ الْعَصْرِ۔","Hasan","Musannaf Ibn Abi Shaybah 7421","","","كتاب الجمعة"
"7422","(۷۴۲۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ یَزِیدَ بْنِ طَلْقٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْبَیْلَمَانِیِّ ، عَنْ عَمْرِو بْنِ عَبَسَۃَ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ہَلْ مِنْ سَاعَۃٍ أَقْرَبُ إلَی اللہِ مِنْ سَاعَۃٍ ، فَقَالَ : نَعَمْ جَوْفُ اللَّیْلِ فَصَلِّ مَا بَدَا لَکَ حَتَّی تُصَلِّیَ الصُّبْحَ ، ثُمَّ أَنْہِہْ حَتَّی تَطْلُعَ الشَّمْسُ وَمَا دَامَتْ : کأَنَّہَا حجفَۃٌ حَتَّی تَنْتَشِرَ ، ثُمَّ صَلِّ مَا بَدَا لَکَ حَتَّی یَقُومَ الْعَمُودُ عَلَی ظِلِّہِ ، ثُمَّ أَنْہِہْ حَتَّی تَزُولَ الشَّمْسُ فَإِنَّ جَہَنَّمَ تُسجَرُ نِصْفَ النَّہَارِ ، ثُمَّ صَلِّ مَا بَدَا لَکَ حَتَّی تُصَلِّیَ الْعَصْرَ ، ثُمَّ أَنْہِہْ حَتَّی تَغْرُبَ الشَّمْسُ فَإِنَّہَا تَطْلُعُ بَیْنَ قَرْنَیْ شَیْطَانٍ وَتَغْرُبُ بَیْنَ قَرْنَیْ شَیْطَانٍ۔ (نسائی ۱۵۶۰۔ احمد ۴/۱۱۳)","Da'if","Musannaf Ibn Abi Shaybah 7422","","","كتاب الجمعة"
"7423","(۷۴۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : مَا تَرَکَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَکْعَتَیْنِ بَعْدَ الْعَصْرِ فِی بَیْتِی قَطُّ۔ (بخاری ۵۹۱۔ مسلم ۲۹۹)","Sahih","Musannaf Ibn Abi Shaybah 7423","","","كتاب الجمعة"
"7424","(۷۴۲۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ یَزِیدَ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، قَالَ : دَخَلْت مَعَ ابْنِ عَبَّاسٍ عَلَی مُعَاوِیَۃَ فَأَجْلَسَہُ مُعَاوِیَۃُ عَلَی السَّرِیرِ ، ثُمَّ قَالَ لَہُ : مَا رَکْعَتَانِ یُصَلِّیہِمَا النَّاسُ بَعْدَ الْعَصْرِ لَمْ نَرَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلاَّہُمَا وَلاَ أَمَرَ بِہِمَا قَالَ : ذَلِکَ مَا یُفْتِی بِہِ النَّاسَ ابْنُ الزُّبَیْرِ ، فَأَرْسَلَ إلَی ابْنِ الزُّبَیْرِ فَسَأَلَہُ ، فَقَالَ: أَخْبَرَتْنِی ذَلِکَ عَائِشَۃُ ، فَأَرْسَلَ إلَی عَائِشَۃَ ، فَقَالَتْ : أَخْبَرَتْنِی ذَلِکَ أُمُّ سَلَمَۃَ ، فَأَرْسَلَ إلَی أُمِّ سَلَمَۃَ فَانْطَلَقَتْ مَعَ الرَّسُولِ فَسَأَلَ أُمَّ سَلَمَۃَ ، فَقَالَتْ یَرْحَمُہَا اللَّہُ مَا أَرَادَتْ إلَی ہَذَا فَقَدْ أَخْبَرْتہُا ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْہُمَا۔n إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیْنَمَا ہُوَ فِی بَیْتِی یَتَوَضَّأُ للظُّہْر وَکَانَ قَدْ بَعَثَ سَاعِیًا وَکَثُرَ عِنْدَہُ الْمُہَاجِرُونَ وَکَانَ قَدْ أَہَمَّہُ شَأْنُہُمْ إذْ ضَرَبَ الْبَابَ فَخَرَجَ إلَیْہِ فَصَلَّی الظُّہْرَ ، ثُمَّ جَلَسَ یُقسِمُ مَا جَائَ بِہِ فَلَمْ یَزَلْ کَذَلِکَ حَتَّی صَلَّی الْعَصْرَ ، فَلَمَّا فَرَغَ رَآہ بِلاَلٌ فَأَقَامَ الصَّلاَۃ فَصَلَّی الْعَصْرَ ثُمَّ دَخَلَ مَنْزِلِی فَصَلَّی رَکْعَتَیْنِ ، فَلَمَّا فَرَغَ قُلْتُ : مَا رَکْعَتَانِ رَأَیْتُک تُصَلِّیہِمَا بَعْدَ الْعَصْرِ لَمْ أَرَک تُصَلِّیہِمَا ، فَقَالَ : شَغَلَنِی أَمْرُ السَّاعِی لَمْ أَکُنْ صَلَّیْتُہُمَا بَعْدَ الظُّہْرِ فَصَلَّیْتہمَا۔n فَقَالَ ابْنُ الزُّبَیْرِ : قَدْ صَلاَّہُمَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَنَا أُصَلِّیہِمَا۔(ابوداؤد ۲۱۶۷۔ احمد ۶/۳۱۱)","Da'if","Musannaf Ibn Abi Shaybah 7424","","","كتاب الجمعة"
"7425","(۷۴۲۵) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : رَأَیْتُ أَبَا بُرْدَۃَ بْنَ أَبِی مُوسَی یُصَلِّی بَعْدَ الْعَصْرِ رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 7425","","","كتاب الجمعة"
"7426","(۷۴۲۶) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، قَالَ خَرَجْت مَعَ أَبِی وَعَمْرِو بْنِ مَیْمُونٍ وَالأَسْوَدِ بْنِ یَزِیدَ ، وَأَبِی وَائِلٍ فَکَانُوا یُصَلُّونَ بَعْدَ الْعَصْرِ رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 7426","","","كتاب الجمعة"
"7427","(۷۴۲۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، قَالَ : حَدَّثَنَا إبْرَاہِیمُ بْنُ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ یُصَلِّی بَعْدَ الْعَصْرِ رَکْعَتَیْنِ فَقِیلَ لَہُ ، فَقَالَ : لَوْ لَمْ أُصَلِّہِمَا إِلاَّ أَنِّی رَأَیْت مَسْرُوقًا یُصَلِّیہِمَا لَکَانَ ثِقَۃً وَلَکِنِّی سَأَلْت عَائِشَۃَ ، فَقَالَتْ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ یَدَعُ رَکْعَتَیْنِ قَبْلَ الْفَجْرِ وَرَکْعَتَیْنِ بَعْدَ الْعَصْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 7427","","","كتاب الجمعة"
"7428","(۷۴۲۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، قَالَ : حَدَّثَنَا إبْرَاہِیمُ بْنُ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، عَنْ أَبِی طَلْحَۃَ مولی شُرَیْحٍ ، قَالَ : کَانَ شُرَیْحٌ یُصَلِّی رَکْعَتَیْنِ بَعْدَ الْعَصْرِ أَخَذَہُمَا عَنْ مَسْرُوقٍ۔","","Musannaf Ibn Abi Shaybah 7428","","","كتاب الجمعة"
"7429","(۷۴۲۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، أَنَّ الزُّبَیْرَ ، وَعَبْدَ اللہِ بْنَ الزُّبَیْرِ کَانَا یُصَلِّیَانِ بَعْدَ الْعَصْرِ رَکْعَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 7429","","","كتاب الجمعة"
"7430","(۷۴۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، أَنَّہُ صَلَّی بِفُسْطَاطِہِ بِصِفِّینَ رَکْعَتَیْنِ بَعْدَ الْعَصْرِ۔","Hasan","Musannaf Ibn Abi Shaybah 7430","","","كتاب الجمعة"
"7431","(۷۴۳۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا طَلْحَۃُ بْنُ یَحْیَی ، قَالَ : سَمِعْتُ عُبَیْدَ اللہِ بْنَ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، عَنْ أُمِّ سَلَمَۃَ ، قَالَتْ : شُغِلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ الرَّکْعَتَیْنِ بَعْدَ الظُّہْرِ فَصَلاَّہُمَا بَعْدَ الْعَصْرِ۔ (احمد ۶/۳۰۶۔ طبرانی ۵۸۳)","Hasan","Musannaf Ibn Abi Shaybah 7431","","","كتاب الجمعة"
"7432","(۷۴۳۲) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنْ مِسْعَرٍ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، قَالَ : حَدَّثَتْنِی الصِّدِّیقَۃُ بِنْتُ الصِّدِّیقِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَا دَخَلَ عَلَیْہَا بَعْدَ الْعَصْرِ إِلاَّ صَلَّی رَکْعَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 7432","","","كتاب الجمعة"
"7433","(۷۴۳۳) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : سَأَلْتُ أَبَا جُحَیْفَۃَ عَنْہُمَا فَقَالَ : إِنْ لَمْ تَنْفَعَاک لَمْ تَضُرَّاک۔","Hasan","Musannaf Ibn Abi Shaybah 7433","","","كتاب الجمعة"
"7434","(۷۴۳۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، وَأَبُو أُسَامَۃَ ، قَالاَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ تَتَحَیَّنَنَّ عِنْدَ طُلُوعِ الشَّمْسِ ، وَلاَ غُرُوبِہَا بِالصَّلاَۃ فَإِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَنْہَی عَنْ ذَلِکَ۔ (نسائی ۱۵۴۶)","Sahih","Musannaf Ibn Abi Shaybah 7434","","","كتاب الجمعة"
"7435","(۷۴۳۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُوسَی بْنُ عُلَیٍّ ، عَنْ أَبِیہِ ، عَنْ عُقْبَۃَ بْنِ عَامِرٍ ، قَالَ : سَمِعْتُہ یَقُولُ ثَلاَثُ سَاعَاتٍ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْہَانَا أَنْ نُصَلِّیَ فِیہَا أَوْ أَنْ نَقْبُرَ فِیہِنَّ مَوْتَانَا حِینَ تَطْلُعُ الشَّمْسُ بَازِغَۃً حَتَّی تَرْتَفِعَ وَحِینَ تَضَیَّفُ لِلْغُرُوبِ حَتَّی تَغِیبَ وَحِینَ یَقُومُ قَائِمُ الظَّہِیرَۃِ حَتَّی تَمِیلَ۔ (ترمذی ۱۰۳۰۔ ابوداؤد ۳۱۸۵)","Sahih","Musannaf Ibn Abi Shaybah 7435","","","كتاب الجمعة"
"7436","(۷۴۳۶) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَبْدِ اللہِ ، قَالَ : إنَّ الشَّمْسَ تَطْلُعُ حِینَ تَطْلُعُ بَیْنَ قَرْنَیْ شَیْطَانٍ ، قَالَ : فَکُنَّا نُنْہَی ، عَنِ الصَّلاَۃ عِنْدَ طُلُوعِ الشَّمْسِ ، وَعِنْدَ غُرُوبِہَا۔ (ابو یعلی ۴۹۷۷۔ بزار ۱۸۲۳)","Da'if","Musannaf Ibn Abi Shaybah 7436","","","كتاب الجمعة"
"7437","(۷۴۳۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، عَنْ بِلاَلٍ ، قَالَ : لَمْ یُنْہَ عَنِ الصَّلاَۃ إِلاَّ عِنْدَ غُرُوبِ الشَّمْسِ لأنَّہَا تَغْرُبُ فِی قَرْنِ الشَّیْطَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 7437","","","كتاب الجمعة"
"7438","(۷۴۳۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ حَبِیبٍ ، عَنْ عَطَائٍ ، قَالَ : حدَّثَنِی عُرْوَۃُ بْنُ الزُّبَیْرِ ، أَنَّ أُنَاسًا طَافُوا بِالْبَیْتِ بَعْدَ الْفَجْرِ، ثُمَّ قَعَدُوا عِنْدَ الْمَذْکَرِ حَتَّی إذَا کَانَ عِنْدَ طُلُوعِ الشَّمْسِ قَامُوا یُصَلُّونَ ، قَالَتْ عَائِشَۃُ: قَعَدُوا حَتَّی إذَا کَانَتِ السَّاعَۃُ الَّتِی یُکْرَہُ فِیہِ الصَّلاَۃ قَامُوا یُصَلُّونَ۔","Hasan","Musannaf Ibn Abi Shaybah 7438","","","كتاب الجمعة"
"7439","(۷۴۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ بِسْطَامِ بْنِ مُسْلِمٍ ، عَنْ أَبِی رَجَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ یُصَلَّ عِنْدَ طُلُوعِ الشَّمْسِ ، وَلاَ حِینَ تَغْرُبُ فَإِنَّہَا تَطْلُعُ وَتَغْرُبُ فِی قَرْنَیْ شَیْطَانٍ وَلَکِنْ إذَا صَفَتْ وَعَلَتْ۔","Sahih","Musannaf Ibn Abi Shaybah 7439","","","كتاب الجمعة"
"7440","(۷۴۴۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مِسْعَرٍ ، عَنْ عُبَیْدِ بن الْحَسَنِ ، عَنِ ابْنِ مَعقِل ، قَالَ : رَأَی أَبُو مَسْعُودٍ رَجُلاً یُصَلِّی عِنْدَ طُلُوعِ الشَّمْسِ ، أَوْ فِی السَّاعَۃِ الَّتِی تُکْرَہُ فِیہَا الصَّلاَۃ فَأَمَرَ رَجُلاً فَنَہَاہُ۔","Sahih","Musannaf Ibn Abi Shaybah 7440","","","كتاب الجمعة"
"7441","(۷۴۴۱) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، أَنَّ شُرَیْحًا رَأَی رَجُلاً یُصَلِّی حِینَ اصْفَارَّتِ الشَّمْسُ ، فَقَالَ : انْہَوْا ہَذَا أَنْ یُصَلِّیَ فَإِنَّ ہَذِہِ سَاعَۃٌ لاَ تَحِلُّ فِیہَا الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7441","","","كتاب الجمعة"
"7442","(۷۴۴۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَحَرَّوْا بِصَلاَتِکُمْ طُلُوعَ الشَّمْسِ ، وَلاَ غُرُوبَہَا فَإِنَّہَا تَطْلُعُ بِقَرْنِ الشَّیْطَانِ۔ (بخاری ۵۸۲۔ نسائی ۱۵۵۱)","Sahih","Musannaf Ibn Abi Shaybah 7442","","","كتاب الجمعة"
"7443","(۷۴۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا بَدَا حَاجِبُ الشَّمْسِ فَأَخِّرُوا الصَّلاَۃ حَتَّی تَبْرُزَ ، وَإِذَا غَابَ حَاجِبُ الشَّمْسِ فَأَخِّرُوا الصَّلاَۃ حَتَّی تَغِیبَ۔ (بخاری ۳۲۷۲)","Sahih","Musannaf Ibn Abi Shaybah 7443","","","كتاب الجمعة"
"7444","(۷۴۴۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِیسَی بْنُ حُمَیْدٍ الرَّاسِبِیُّ ، قَالَ : سَمِعْتُ الْحَسَنَ یَقُولُ : کَانُوا یَکْرَہُونَ الصَّلاَۃ عِنْدَ طُلُوعِ الشَّمْسِ حَتَّی تَرْتَفِعَ ، وَعِنْدَ غُرُوبِہَا حَتَّی تَغِیبَ۔","","Musannaf Ibn Abi Shaybah 7444","","","كتاب الجمعة"
"7445","(۷۴۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ ابْنُ مَسْعُودٍ : مَا أُحِبُّ أَنَّ لِی بِصَلاَۃِ الرَّجُلِ حِینَ تَصْفَارُّ الشَّمْسُ فَلْسَیْنِ۔","","Musannaf Ibn Abi Shaybah 7445","","","كتاب الجمعة"
"7446","(۷۴۴۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَفْرِیقِیِّ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ صَلاَۃَ بَعْدَ طُلُوعِ الْفَجْرِ إِلاَّ رَکْعَتَیْنِ قَبْلَ صَلاَۃِ الْفَجْرِ۔ (دارقطنی ۲۔ عبدالرزاق ۴۷۵۷)","Da'if","Musannaf Ibn Abi Shaybah 7446","","","كتاب الجمعة"
"7447","(۷۴۴۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی مُحَمَّدٍ الْیَمَامیِّ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عُمَرَ ، وَابْنِ عَبَّاسٍ ، قَالاَ : لاَ صَلاَۃَ بَعْدَ طُلُوعِ الْفَجْرِ إِلاَّ رَکْعَتَیِ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 7447","","","كتاب الجمعة"
"7448","(۷۴۴۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حَجَّاجٌ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ قَالَ : لاَ صَلاَۃَ بَعْدَ رَکْعَتَیِ الْفَجْرِ حَتَّی تُصَلِّیَ الْفَجْرَ۔","","Musannaf Ibn Abi Shaybah 7448","","","كتاب الجمعة"
"7449","(۷۴۴۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ : رَآنِی سَعِیدُ بْنُ الْمُسَیَّبِ وَأَنَا أُصَلِّی بَعْضَ مَا فَاتَنِی مِنْ صَلاَۃِ اللَّیْلِ بَعْدَ مَا طَلَعَ الْفَجْرُ ، فَقَالَ : أَمَا عَلِمْت أَنَّ الصَّلاَۃ تُکْرَہُ ہَذِہِ السَّاعَۃَ إِلاَّ رَکْعَتَیْنِ قَبْلَ صَلاَۃِ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 7449","","","كتاب الجمعة"
"7450","(۷۴۵۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ إذَا طَلَعَ الْفَجْرُ أَنْ یُصَلُّوا إِلاَّ رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 7450","","","كتاب الجمعة"
"7451","(۷۴۵۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ الصَّلاَۃ بَعْدَ رَکْعَتَیِ الْفَجْرِ حَتَّی یُصَلُّوا الْمَکْتُوبَۃَ۔","","Musannaf Ibn Abi Shaybah 7451","","","كتاب الجمعة"
"7452","(۷۴۵۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : مَنْ شَائَ أَنْ یُصَلِّیَ بَعْدَ طُلُوعِ الْفَجْرِ فَلْیَفْعَلْ۔","","Musannaf Ibn Abi Shaybah 7452","","","كتاب الجمعة"
"7453","(۷۴۵۳) حَدَّثَنَا حَفْصٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : إنَّ بَعْدَ طُلُوعِ الْفَجْرِ لَجُزْئًا حَسَنًا ، وَکَانَ یَقْرَأُ بَعْدَ الْفَجْرِ بِالْبَقَرَۃِ۔","","Musannaf Ibn Abi Shaybah 7453","","","كتاب الجمعة"
"7454","(۷۴۵۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورِ بْنِ الأَشَلِّ الْغُدَانِیِّ ، قَالَ : سَأَلَ أَبُو حَصِینٍ الشَّعْبِیَّ وَأَنَا أَسْمَعُ ، عَنْ رَجُلٍ بَقِیَ عَلَیْہِ مِنْ وِرْدِہِ شَیْئٌ وَہُوَ یُصَلِّی وَقَدْ طَلَعَ الْفَجْرُ ، فَقَالَ : یَقْرَأُ بَقِیَّۃَ وِرْدِہِ۔","","Musannaf Ibn Abi Shaybah 7454","","","كتاب الجمعة"
"7455","(۷۴۵۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : رَأَیْتُ أَبَا إِسْحَاقَ وَالْحَکَمَ یُصَلِّیَانِ بَعْدَ طُلُوعِ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 7455","","","كتاب الجمعة"
"7456","(۷۴۵۶) حَدَّثَنَا شَرِیکٌ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، قَالَ : رَأَیْتُ عَبْدَ الرَّحْمَن بْنَ عَوْفٍ وَأُبَیَّ بْنَ کَعْبٍ إذَا أَذَّنَ الْمُؤَذِّنُ لِلْمَغْرِبِ قَامَا فصَلَّیَا رَکْعَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 7456","","","كتاب الجمعة"
"7457","(۷۴۵۷) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : سُئِلَ عَنِ الرَّکْعَتَیْنِ قَبْلَ الْمَغْرِبِ ، فَقَالَ : رَأَیْتُہُمْ إذَا أَذَّنَ الْمُؤَذِّنُ ابْتَدَرُوا السَّوَارِیَ فَصَلَّوْا۔","Sahih","Musannaf Ibn Abi Shaybah 7457","","","كتاب الجمعة"
"7458","(۷۴۵۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ أَبِی فَزَارَۃَ ، قَالَ : سَأَلْتُ أَنَسًا ، عَنِ الرَّکْعَتَیْنِ قَبْلَ الْمَغْرِبِ ، فَقَالَ : کُنَّا نَبْتَدِرُہُمَا عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (بخاری ۶۲۵۔ ابوداؤد ۱۲۷۶)","Sahih","Musannaf Ibn Abi Shaybah 7458","","","كتاب الجمعة"
"7459","(۷۴۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : رَأَیْتُ ابْنَ أَبِی لَیْلَی صَلَّی رَکْعَتَیْنِ قَبْلَ الْمَغْرِبِ۔","","Musannaf Ibn Abi Shaybah 7459","","","كتاب الجمعة"
"7460","(۷۴۶۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : أَدْرَکْت أَصْحَابَ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلُّونَ عِنْدَ کُلِّ تَأْذِینٍ۔","Sahih","Musannaf Ibn Abi Shaybah 7460","","","كتاب الجمعة"
"7461","(۷۴۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ کَہَمْسٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْمُغَفَّلِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : بَیْنَ کُلِّ اَذَانَیْنِ صَلاَۃٌ بَیْنَ کُلِّ اَذَانَیْنِ صَلاَۃٌ بَیْنَ کُلِّ اَذَانَیْنِ صَلاَۃٌ لِمَنْ شَائَ۔ (بخاری ۶۲۷۔ مسلم ۳۰۴)","Sahih","Musannaf Ibn Abi Shaybah 7461","","","كتاب الجمعة"
"7462","(۷۴۶۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیْرِیِّ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْمُغَفَّلِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ۔ (بخاری ۶۲۴۔ ابوداؤد ۱۲۷۷)","Sahih","Musannaf Ibn Abi Shaybah 7462","","","كتاب الجمعة"
"7463","(۷۴۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، قَالَ : قَالَ تَمِیمُ بْنُ سَلاَّمٍ ، أَوْ سَلاَّمُ بْنُ تَمِیمٍ لِلْحَسَنِ : مَا تَقُولُ فِی الرَّکْعَتَیْنِ قَبْلَ الْمَغْرِبِ ، فَقَالَ : حَسَنَتَانِ جَمِیلَتَانِ لِمَنْ أَرَادَ اللَّہُ بِہِمَا۔","Hasan","Musannaf Ibn Abi Shaybah 7463","","","كتاب الجمعة"
"7464","(۷۴۶۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : مَا رَأَیْت فَقِیہًا یُصَلِّی قَبْلَ الْمَغْرِبِ إِلاَّ سَعْدَ بْنَ أَبِی وَقَّاصٍ۔","Da'if","Musannaf Ibn Abi Shaybah 7464","","","كتاب الجمعة"
"7465","(۷۴۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَمِعْتُ شَیْخًا بِوَاسِطٍ یَقُولُ : سَمِعْت طَاوُوسًا یقول : سَأَلْت ابْنَ عُمَرَ، عَنِ الرَّکْعَتَیْنِ قَبْلَ الْمَغْرِبِ فَلَمْ یَنْہَ عَنْہُمَا۔","Da'if","Musannaf Ibn Abi Shaybah 7465","","","كتاب الجمعة"
"7466","(۷۴۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ خَارِجَۃَ بْنِ مُصْعَبٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن عَطَائِ بْنِ یَسَارٍ ، قَالَ : قَالَ رَسُولُ اللہِ: لاَ تَسْتَقْبِلُ الصُّورَۃُ الصُّورَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 7466","","","كتاب الجمعة"
"7467","(۷۴۶۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ إبْرَاہِیمُ جَالِسًا مُوَلِّیًا ظَہْرَہُ إلَی الْقِبْلَۃِ وَإِنْسَانٌ قَائِمٌ یُصَلِّی مُسْتَقْبِلَہُ فَأَخَذَ إبْرَاہِیمُ یَتَّقِیہِ بِیَدِہِ مِنْ ہَذَا الْجَانِبِ وَمِنْ ہَذَا الْجَانِبِ۔","","Musannaf Ibn Abi Shaybah 7467","","","كتاب الجمعة"
"7468","(۷۴۶۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَنْظَلَۃُ الْجُمَحِیُّ ، عَنْ طَاوُوسٍ ، أَنَّ رَجُلاً نَذَرَ أَنْ یَسْجُدَ عَلَی جَبْہَۃِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَتَاہُ فَجَلَسَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُسْتَقْبِلَ الْقِبْلَۃِ ، ثُمَّ أَقَامَ الرَّجُلَ خَلْفَہُ ، وَقَالَ ہَکَذَا بِجَبْہَتِہِ فَسَجَدَ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 7468","","","كتاب الجمعة"
"7469","(۷۴۶۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ مَعْدَانَ أَبُو مَعْدَانَ ، قَالَ : سَمِعْتُ طَاوُوسًا یُحَدِّثُ بِہَذَا الْحَدِیثِ وَزَادَ فِیہِ ، فَقَالَ لَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : قَدْ وَفَیْتَ بِنَذْرِکَ۔ (نسائی ۷۶۳۰۔ احمد ۲۱۴)","","Musannaf Ibn Abi Shaybah 7469","","","كتاب الجمعة"
"7470","(۷۴۷۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، أَنَّہُ کَانَ یُہَرْوِلُ إلَی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7470","","","كتاب الجمعة"
"7471","(۷۴۷۱) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ ، قَالَ : رَأَیْتُ عَبْدَ الرَّحْمَن بْنَ یَزِیدَ مُسَارِعًا إلَی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7471","","","كتاب الجمعة"
"7472","(۷۴۷۲) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا ابْنُ جُرَیْجٍ، عَنْ رَجُلٍ مِنْ أَہْلِ الْمَدِینَۃِ، عَنِ ابْنِ عُمَرَ، أَنَّہُ کَانَ یُہَرْوِلُ إلَی الصَّلاَۃ۔","Da'if","Musannaf Ibn Abi Shaybah 7472","","","كتاب الجمعة"
"7473","(۷۴۷۳) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا مَالِکُ بْنُ أَنَسٍ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، أَنَّہُ سَمِعَ الإِقَامَۃَ بِالْبَقِیعِ فَأَسْرَعَ الْمَشْیَ۔","Sahih","Musannaf Ibn Abi Shaybah 7473","","","كتاب الجمعة"
"7474","(۷۴۷۴) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا شَرِیکٌ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ، قَالَ: رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ یُہَرْوِلُ إلَی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7474","","","كتاب الجمعة"
"7475","(۷۴۷۵) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ یُہَرْوِلُ إلَی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7475","","","كتاب الجمعة"
"7476","(۷۴۷۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَمْرِو بْنِ قَیْسٍ الْمُلاَئِیِّ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ عُمَارَۃَ بْنِ عُمَیْرٍ ، قَالَ : قَالَ عَبْدُ اللہِ : أَحَقُّ مَا سَعَیْنَا إلَیْہِ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7476","","","كتاب الجمعة"
"7477","(۷۴۷۷) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ عَاصِمِ بْنِ عُبَیْدِاللہِ، قَالَ: رَأَیْتُ ابْنَ عُمَرَ یُہَرْوِلُ إلَی الْمَسْجِدِ فِی کُسُوفٍ وَمَعَہُ نَعْلاَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 7477","","","كتاب الجمعة"
"7478","(۷۴۷۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ رِوَایَۃً ، قَالَ : إذَا أَتَیْتُمُ الصَّلاَۃ فَلاَ تَأْتُوہَا وَأَنْتُمْ تَسْعَوْنَ وَأْتُوہَا وَعَلَیْکُمُ السَّکِینَۃُ فَمَا أَدْرَکْتُمْ فَصَلُّوا وَمَا فَاتَکُمْ فَاقْضُوا۔ (بخاری ۶۳۶۔ ابوداؤد ۵۷۳)","Sahih","Musannaf Ibn Abi Shaybah 7478","","","كتاب الجمعة"
"7479","(۷۴۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن عُمَرَ بْنِ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا أَتَیْتُمُ الصَّلاَۃ فَأْتُوہَا بِالْوَقَارِ وَالسَّکِینَۃِ فَمَا أَدْرَکْتُمْ فَصَلُّوا وَمَا فَاتَکُمْ فَأَتِمُّوا۔ (بخاری ۶۳۶۔ ترمذی ۳۲۷)","Da'if","Musannaf Ibn Abi Shaybah 7479","","","كتاب الجمعة"
"7480","(۷۴۸۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عَمْرٍو ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی ذَرٍّ ، قَالَ : إذَا أُقِیمَتِ الصَّلاَۃ فَامْشِ إلَیْہَا کَمَا کُنْت تَمْشِی فَصَلِّ مَا أَدْرَکْت وَاقْضِ مَا سَبَقَک۔","Sahih","Musannaf Ibn Abi Shaybah 7480","","","كتاب الجمعة"
"7481","(۷۴۸۱) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : إذَا ثُوِّبَ بِالصَّلاَۃ فَامْشُوا وَعَلَیْکُمُ السَّکِینَۃَ وَالْوَقَارَ فَصَلُّوا مَا أَدْرَکْتُمْ وَاقْضُوا مَا سَبَقَکُمْ۔ (مسلم ۱۵۴)","Sahih","Musannaf Ibn Abi Shaybah 7481","","","كتاب الجمعة"
"7482","(۷۴۸۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : امْشُوا إلَی الصَّلاَۃ وَقَارِبُوا بَیْنَ الْخُطَا وَاذْکُرُوا اللَّہَ۔","","Musannaf Ibn Abi Shaybah 7482","","","كتاب الجمعة"
"7483","(۷۴۸۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ ، عَنْ أَبِی الأَحْوَص ، قَالَ : قَالَ عَبْدُ اللہِ: لَقَدْ رَأَیْتُنَا وَإِنَّا لَنُقَارِبُ بَیْنَ الْخُطَا إلَی الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 7483","","","كتاب الجمعة"
"7484","(۷۴۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ حَیَّانَ أَبُو الأَشْہَبِ ، عَنْ ثَابِتٍ الْبُنَانِیِّ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : خَرَجْت مَعَ زَیْدِ بْنِ ثَابِتٍ إلَی الْمَسْجِدِ فَأَسْرَعْتُ الْمَشْیَ فَحَبَسَنِی۔","Sahih","Musannaf Ibn Abi Shaybah 7484","","","كتاب الجمعة"
"7485","(۷۴۸۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ دَاوُدَ بْنِ فَرَاہِیجَ ، قَالَ : حدَّثَنِی مَوْلاَیَ سُفْیَانُ بْنُ زِیَادٍ ، أَنَّہُ کَانَ یَنْطَلِقُ إلَی الْمَسْجِدِ وَہُوَ یَسْتَعْجِلُ ، قَالَ : فَلَحِقَنِی الزُّبَیْرُ بْنُ الْعَوَّامِ ، فَقَالَ : اقْصِدْ فِی مَشْیِکَ فَإِنَّک فِی صَلاَۃٍ لَنْ تَخْطُوَ خُطْوَۃً إِلاَّ رَفَعَ اللَّہُ لَکَ بِہَا دَرَجَۃً ، وَحَطَّ عَنْکَ بِہَا خَطِیئَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 7485","","","كتاب الجمعة"
"7486","(۷۴۸۶) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، عَنْ بُہَیَّۃَ حَاضِنَۃِ بَنِی عَبْدِ اللہِ ، قَالَتْ : سَمِعْتُ الإِقَامَۃَ فَأَسْرَعْت فَمَرَرْتُ بِعَلِیِّ بْنِ حُسَیْنٍ وَأَنَا مُسْرِعَۃٌ فَجَذَبَ ثَوْبِی ، وَقَالَ : امْشی عَلَی رِسْلِک۔","Da'if","Musannaf Ibn Abi Shaybah 7486","","","كتاب الجمعة"
"7487","(۷۴۸۷) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، قَالَ : عُدْنَا مُجَاہِدًا أَنَا وَصَاحِبٌ لِی فَحَضَرَتِ الصَّلاَۃ، فَقَالَ : انْطَلِقُوا فَصَلُّوا وَامْشُوا عَلَی ہَیْنَتِکُمْ فَمَا أَدْرَکْتُمْ مَعَ الإِمَامِ فَصَلُّوا وَمَا فَاتَکُمْ فَأَتِمُّوا۔","","Musannaf Ibn Abi Shaybah 7487","","","كتاب الجمعة"
"7488","(۷۴۸۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی سِنَانٍ ، عَنْ مُحَمَّدِ بْنِ زَیْدِ بْنِ خُلَیْدَۃَ ، قَالَ : کُنْتُ أَمْشِی مَعَ ابْنِ عُمَرَ إلَی الصَّلاَۃ فَلَوْ مَشَتْ مَعَہُ نَمْلَۃٌ لَرَأَیْتُ أَنْ لاَ یَسْبِقَہَا۔","Hasan","Musannaf Ibn Abi Shaybah 7488","","","كتاب الجمعة"
"7489","(۷۴۸۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حُمَیْدٌ الطَّوِیلُ ، عَنْ ثَابِتٍ ، قَالَ : أَخَذَ بِیَدِی أَنَسٌ فَجَعَلَ یَمْشِی رُوَیْدًا إلَی الصَّلاَۃ ، ثُمَّ الْتَفَتَ إلَیَّ ، فَقَالَ : ہَکَذَا کَانَ یَصْنَعُ زَیْدُ بْنُ ثَابِتٍ لِتَکْثُرَ خُطَاہُ۔","Sahih","Musannaf Ibn Abi Shaybah 7489","","","كتاب الجمعة"
"7490","(۷۴۹۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ ثَابِتِ بْنِ عُبَیْدٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: نَاوِلِینِی الْخُمْرَۃَ مِنَ الْمَسْجِدِ فَقُلْتُ: إنِّی حَائِضٌ، فَقَالَ إنَّ حَیْضَتَکِ لَیْسَتْ فِی یَدِک۔ (مسلم ۲۴۴۔ ترمذی ۱۳۴)","Sahih","Musannaf Ibn Abi Shaybah 7490","","","كتاب الجمعة"
"7491","(۷۴۹۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : سُئِلَ ابْنُ عُمَرَ ، عَنِ الْحَائِضِ تُنَاوِلُ الرَّجُل الطَّہُورَ، أَوِ الشَّیْئَ مِنَ الْمَسْجِدِ ، فَقَالَ : إنَّ حَیْضَتَہَا لَیْسَتْ فِی یَدِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 7491","","","كتاب الجمعة"
"7492","(۷۴۹۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ تَضَعَ الْحَائِضُ فِی الْمَسْجِدِ الشَّیْئَ وَتَأْخُذَہُ مِنْہُ ، وَلاَ تَدْخُلُہُ۔","","Musannaf Ibn Abi Shaybah 7492","","","كتاب الجمعة"
"7493","(۷۴۹۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ تَضَعَ الْحَائِضُ فِی الْمَسْجِدِ مَا شَائَتْ وَتَأْخُذَہُ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 7493","","","كتاب الجمعة"
"7494","(۷۴۹۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، قَالَ : الْحَائِضُ تَأْخُذُ مِنَ الْمَسْجِدِ ، وَلاَ تَضَعُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 7494","","","كتاب الجمعة"
"7495","(۷۴۹۵) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ عُثْمَانَ بْنِ حَکِیمٍ ، عَنْ جَدَّتِہِ الرَّبَابِ ، أَنَّ عُثْمَانَ بْنَ حُنَیْفٍ ، قَالَ : یَا جَارِیَۃُ نَاوِلِینِی الْخُمْرَۃَ ، قَالَتْ : لَسْتُ أُصَلِّی ، قَالَ : إنَّ حَیْضَتَکِ لَیْسَتْ فِی یَدِکِ۔","Da'if","Musannaf Ibn Abi Shaybah 7495","","","كتاب الجمعة"
"7496","(۷۴۹۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ لِجَارِیَتِہِ : نَاوِلِینِی الْخُمْرَۃَ مِنَ الْمَسْجِدِ ، فَتَقُولُ : إنِّی حَائِضٌ ، فَیَقُولُ : إنَّ حَیْضَتَکِ لَیْسَتْ بِیَدِکِ۔","Sahih","Musannaf Ibn Abi Shaybah 7496","","","كتاب الجمعة"
"7497","(۷۴۹۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : تَأْخُذُ الْحَائِضُ مِنَ الْمَسْجِدِ وَتَضَعُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 7497","","","كتاب الجمعة"
"7498","(۷۴۹۸) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ : فِی الْحَائِضِ تُنَاوِلُ مِنَ الْمَسْجِدِ الشَّیْئَ ، قَالَ : نَعَمْ إِلاَّ الْمُصْحَفَ۔","","Musannaf Ibn Abi Shaybah 7498","","","كتاب الجمعة"
"7499","(۷۴۹۹) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ تَأْخُذَ الْحَائِضُ الشَّیْئَ مِنَ الْمَسْجِدِ وَتَضَعَہُ فِیہِ۔","Hasan","Musannaf Ibn Abi Shaybah 7499","","","كتاب الجمعة"
"7500","(۷۵۰۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : کَانَ أَبُو وَائِلٍ یُرْسِلُ خَادِمہُ وَہِیَ حَائِضٌ إلَی أَبِی رَزِینٍ فَتَأْتِیہِ بِالْمُصْحَفِ مِنْ عِنْدِہِ فَتُمْسِکُ بِعِلاَقَتِہِ۔","","Musannaf Ibn Abi Shaybah 7500","","","كتاب الجمعة"
"7501","(۷۵۰۱) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ، قَالَ: لاَ بَأْسَ أَنْ یَتَنَاوَلَ الرَّجُلُ الْمُصْحَفَ إذَا کَانَ فِی وِعَائِہِ، أَوْ بِعِلاَقَتِہِ۔","","Musannaf Ibn Abi Shaybah 7501","","","كتاب الجمعة"
"7502","(۷۵۰۲) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ أَبِی خَالِدٍ الدَّالانِیِّ ، عَنِ الْقَاسِمِ ، یَعْنِی الأَعْرَجَ ، قَالَ : رَأَیْتُُ سَعِیدَ بْنَ جُبَیْرٍ قَرَأَ فِی الْمُصْحَفِ ، ثُمَّ نَاوَلَ غُلاَمًا لَہُ مَجُوسِیًّا بِعِلاَقَتِہِ۔","","Musannaf Ibn Abi Shaybah 7502","","","كتاب الجمعة"
"7503","(۷۵۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أَیْمَنَ بْنِ نَابِلٍ ، قَالَ : سَمِعْتُ عَطَائً یَقُولُ : لاَ بَأْسَ أَنْ تَأْخُذَ الْحَائِضُ بِعِلاَقَۃِ الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 7503","","","كتاب الجمعة"
"7504","(۷۵۰۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، أَنَّہُ لَمْ یَکُنْ یَرَی بَأْسًا أَنْ یُحَوِّل الرَّجُلُ الْمُصْحَفَ وَہُوَ غَیْرُ طَاہِرٍ۔","","Musannaf Ibn Abi Shaybah 7504","","","كتاب الجمعة"
"7505","(۷۵۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ غَالِبٍ أَبِی الْہُذَیْلِ ، قَالَ : أَمَرَنِی أَبُو رَزِینٍ أَنْ أَفْتَحَ الْمُصْحَفَ عَلَی غَیْرِ وُضُوئٍ فَسَأَلْت إبْرَاہِیمَ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 7505","","","كتاب الجمعة"
"7506","(۷۵۰۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ لاَ یَمَسُّ الْمُصْحَفَ إِلاَّ وَہُوَ طَاہِرٌ۔","Sahih","Musannaf Ibn Abi Shaybah 7506","","","كتاب الجمعة"
"7507","(۷۵۰۷) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 7507","","","كتاب الجمعة"
"7508","(۷۵۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، قَالَ : سَأَلْتُ عَامِرًا عَنْ مَسِّ الْمُصْحَفِ عَلَی غَیْرِ وُضُوئٍ ، فَقَالَ : لاَ بَأْسَ بِہِ۔n وَکَرِہَہُ مُحَمَّدُ بْنُ عَلِیٍّ ، وَعَبْدُ الرَّحْمَن بْنُ الأَسْوَدِ وَالْقَاسِمُ وَسَالِمٌ وَطَاوُوس۔","","Musannaf Ibn Abi Shaybah 7508","","","كتاب الجمعة"
"7509","(۷۵۰۹) أَخْبَرَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ عُمَرُ: مَا بَیْنَ الْمَشْرِقِ وَالْمَغْرِبِ قِبْلَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 7509","","","كتاب الجمعة"
"7510","(۷۵۱۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، قَالَ : قَالَ عُمَرُ : مَا بَیْنَ الْمَشْرِقِ وَالْمَغْرِبِ قِبْلَۃٌ مَا اسْتُقْبِلَتِ الْقِبْلَۃُ۔","","Musannaf Ibn Abi Shaybah 7510","","","كتاب الجمعة"
"7511","(۷۵۱۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، عَنْ عَبْدِ اللہِ بْنِ بُرَیْدَۃَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَا بَیْنَ الْمَشْرِقِ وَالْمَغْرِبِ قِبْلَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 7511","","","كتاب الجمعة"
"7512","(۷۵۱۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إذَا جَعَلْت الْمَغْرِبَ عَنْ یَمِینِکَ وَالْمَشْرِقَ عَنْ یَسَارِکَ فَمَا بَیْنَہُمَا قِبْلَۃٌ لأَہْلِ الشَّمَالِ۔","","Musannaf Ibn Abi Shaybah 7512","","","كتاب الجمعة"
"7513","(۷۵۱۳) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا إسْرَائِیلُ ، عَنْ عَبْدِ الأَعْلَی بن عَامِرٍ الثَّعْلَبِی ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ السُّلَمِیِّ، عَنْ عَلِیٍّ ، قَالَ : مَا بَیْنَ الْمَشْرِقِ وَالْمَغْرِبِ قِبْلَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 7513","","","كتاب الجمعة"
"7514","(۷۵۱۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَا بَیْنَ الْمَشْرِقِ وَالْمَغْرِبِ قِبْلَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 7514","","","كتاب الجمعة"
"7515","(۷۵۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیانُ ، عَنْ حَکِیمِ بْنِ جُبَیْرٍ ، عَنْ إِبْرَاہِیم۔ وسُفْیان ، عَنْ عَبْدِ الأَعْلَی ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالا : مَا بَیْنَ الْمَشْرِقِ وَالْمَغْرِبِ قِبْلَۃٌ۔","","Musannaf Ibn Abi Shaybah 7515","","","كتاب الجمعة"
"7516","(۷۵۱۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیان ، عَنْ خَالِدٍ الْحَذَّائِ ، عَنْ رَجُلٍ قَدْ سَمَّاہُ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : مَا بَیْنَ الْمَشْرِقِ وَالْمَغْرِبِ قِبْلَۃٌ۔","","Musannaf Ibn Abi Shaybah 7516","","","كتاب الجمعة"
"7517","(۷۵۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْعُمَرِیُّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنْ عُمَرَ ، قَالَ : مَا بَیْنَ الْمَشْرِقِ وَالْمَغْرِبِ قِبْلَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 7517","","","كتاب الجمعة"
"7518","(۷۵۱۸) حَدَّثَنَا الْمُعَلَّی بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا عَبْدُ اللہ بْنُ جَعْفَرٍ ، عَنْ عُثْمَانَ بْنِ مُحَمَّدٍ الأَخْنَسِیِّ ، عَنِ الْمَقْبُرِیِّ، عَنْ أَبِی ہُرَیْرَۃَ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ: مَا بَیْنَ الْمَشْرِقِ وَالْمَغْرِبِ قِبْلَۃٌ۔ (حاکم ۲۰۵)","","Musannaf Ibn Abi Shaybah 7518","","","كتاب الجمعة"
"7519","(۷۵۱۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنِ الْعَبَّاسِ بنْ عَبْدِ الرَّحْمَنِ الْہَاشِمِیِّ ، قَالَ: أَوَّلُ مَا خُلِّقَتِ الْمَسَاجِدُ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی فِی الْمَسْجِدِ نُخَامَۃً فَحَکَّہَا ، ثُمَّ أَمَرَ بِخَلُوقٍ فَلُطِخَ مَکَانَہَا۔ قَالَ: فَخَلَّقَ النَّاسُ الْمَسَاجِدَ۔ (ابوداؤد ۴۸۲)","","Musannaf Ibn Abi Shaybah 7519","","","كتاب الجمعة"
"7520","(۷۵۲۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْمُجَالِدِ ، عَنِ الشَّعْبِیِّ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی فِی قِبْلَۃِ الْمَسْجِدِ نُخَامَۃً فَقَامَ إلَیْہَا فَحَکَّہَا بِیَدِہِ ، ثُمَّ دَعَا بِخَلُوقٍ ، فَقَالَ : عَامِرٌ ہُوَ سُنَّۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 7520","","","كتاب الجمعة"
"7521","(۷۵۲۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، أَنَّ ابْنَ زُبَیْرٍ لَمَّا بَنَی الْکَعْبَۃَ طَلَی حِیطَانہَا بِالْمِسْکِ۔","","Musannaf Ibn Abi Shaybah 7521","","","كتاب الجمعة"
"7522","(۷۵۲۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ أَمَرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِبِنَائِ الْمَسَاجِدِ فِی الدُّورِ وَأَمَرَ أَنْ تُطَہَّرَ وَتُطَیَّبَ ، یَعْنِی الْقَبَائِلَ۔ (ابوداؤد ۴۵۶۔ ابن ماجہ ۷۵۹)","","Musannaf Ibn Abi Shaybah 7522","","","كتاب الجمعة"
"7523","(۷۵۲۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْعُمَرِیُّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ کَانَ یُجَمِّرُ الْمَسْجِدَ فِی کُلِّ جُمُعَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 7523","","","كتاب الجمعة"
"7524","(۷۵۲۴) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ سُلَیْمَانَ ، قَالَ : رَأَیْتُ إبْرَاہِیمَ یَرَی الْمَسْجِدَ یُخَلَّقُ فَلاَ یَعِیبُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 7524","","","كتاب الجمعة"
"7525","(۷۵۲۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَکَّ بُزَاقًا فِی قِبْلَۃِ الْمَسْجِدِ۔ (بخاری ۴۰۷۔ مسلم ۵۴۹)","Sahih","Musannaf Ibn Abi Shaybah 7525","","","كتاب الجمعة"
"7526","(۷۵۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَلِیُّ بْنُ المُبَارَکِ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، قَالَ نُبِّئْتُ ، أَنَّ أَبَا الدَّرْدَائِ رَأَی بُزَاقًا فِی عَرْضِ جِدَارِ الْمَسْجِدِ فَحَکَّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 7526","","","كتاب الجمعة"
"7527","(۷۵۲۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ عِیَاضِ بْنِ عَبْدِ اللہِ بْنِ سَعْدِ بْنِ أَبِی سَرْحٍ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : دَخَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمَسْجِدَ وَبِیَدِہِ عُرْجُونٌ وَکَانَ یُحِبُّ الْعَرَاجِینَ فَرَأَی نُخَامَۃً فِی الْقِبْلَۃِ فَحَکَّہَا ، ثُمَّ أَقْبَلَ عَلَی النَّاسِ ، فَقَالَ : أَیُّہَا النَّاسُ إنَّ أَحَدَکُمْ إذَا قَامَ یُصَلِّی اسْتَقْبَلَہُ اللَّہُ ، وَعَنْ یَمِینِہِ مَلَکٌ أَفَیُحِبُّ أَحَدُکُمْ أَنْ یَسْتَقْبِلَہُ الرَّجُلُ فَیَبْزُقَ فِی وَجْہِہِ فَلاَ یَبْزُقْ أَحَدُکُمْ فِی الْقِبْلَۃِ ، وَلاَ عَنْ یَمِینِہِ وَلْیَبْزُقْ تَحْتَ رِجْلِہِ الْیُسْرَی ، أَوْ عَنْ یَسَارِہِ ، فَإِنْ عَجِلَتْ بِہِ بَادِرَۃٌ فَلیَقُل ہَکَذَا ، یَعْنِی فِی ثَوْبِہِ۔ (ابوداؤد ۴۸۱۔ احمد ۳/۲۴)","Hasan","Musannaf Ibn Abi Shaybah 7527","","","كتاب الجمعة"
"7528","(۷۵۲۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْقَاسِمِ بْنِ مِہْرَانَ ، عَنْ أَبِی رَافِعٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی نُخَامَۃً فِی قِبْلَۃِ الْمَسْجِدِ فَأَقْبَلَ عَلَی النَّاسِ بِوَجْہِہِ ، فَقَالَ : مَا بَالُ أَحَدِکُمْ یَقُومُ مُسْتَقْبِلَہ رَبُّہُ فَیَتَنَخَّعُ أَمَامَہُ أَیحب أَحَدُکُم أَن یُستقبل فَیُتَنَخَّعَ فِی وَجْہِہِ ؟ إذَا انتَخَعَ أَحَدُکُمْ فَلْیَتَنَخَّعْ ، عَنْ یَسَارِہِ ، أَوْ تَحْتَ قَدَمہِ ، فَإِنْ لَمْ یَجِدْ فَلْیَقُلْ ہَکَذَا فِی ثَوْبِہِ ، ثُمَّ أَرَانَا إسْمَاعِیلُ أَنَّہُ یَبْزُقُ فِی ثَوْبِہِ ، ثُمَّ یَدْلُکُہُ۔ (مسلم ۳۸۹۔ نسائی ۲۹۸)","Sahih","Musannaf Ibn Abi Shaybah 7528","","","كتاب الجمعة"
"7529","(۷۵۲۹) حَدَّثَنَا حَفْصٌ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَبْصَرَ نُخَامَۃً فِی الْمَسْجِدِ فَمَسَحَہَا ، ثُمَّ قَالَ : إذَا بَزَقَ أَحَدُکُمْ فَلاَ یَبْزُقْ فِی الْقِبْلَۃِ ، وَلاَ عَنْ یَمِینِہِ وَلَکِنْ لِیَبْزُقْ ، عَنْ یَسَارِہِ ، أَوْ تَحْتَ قَدَمِہِ، أَوْ لِیَصْنَعْ، أَوْ لِیَقُلْ ہَکَذَا، ثُمَّ بَزَقَ فِی طَرَفِ ثَوْبِہِ ، ثُمَّ رَدَّہُ عَلَیْہِ۔ (بخاری ۴۱۷۔ دارمی ۱۳۹۶)","Sahih","Musannaf Ibn Abi Shaybah 7529","","","كتاب الجمعة"
"7530","(۷۵۳۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِی سَعِیدٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی نُخَامَۃً فِی قِبْلَۃِ الْمَسْجِدِ فَحَکَّہَا بِحَصَاہُ ، وَقَالَ : إذَا بَزَقَ أَحَدُکُمْ فَلاَ یَبْزُقْ بَیْنَ یَدَیْہِ ، وَلاَ عَنْ یَمِینِہِ وَلْیَبْزُقْ ، عَنْ یَسَارِہِ۔ (بخاری ۴۱۴۔ مسلم ۵۲)","Sahih","Musannaf Ibn Abi Shaybah 7530","","","كتاب الجمعة"
"7531","(۷۵۳۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ رِبْعِیٍّ ، عَنْ طَارِقِ بْنِ عَبْدِ اللہِ الْمُحَارِبِیِّ ، قَالَ : قَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا صَلَّیْتَ فَلاَ تَبْزُقْ بَیْنَ یَدَیْکَ ، وَلاَ عَنْ یَمِینِکَ وَلَکِنَ اُبْزُقْ ، عَنْ یَسَارِکَ ، أَوْ تَحْتَ قَدَمِکَ۔ (ترمذی ۵۷۱۔ ابوداؤد ۴۷۹)","Sahih","Musannaf Ibn Abi Shaybah 7531","","","كتاب الجمعة"
"7532","(۷۵۳۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی وَائِلٍ ، عَنْ حُذَیْفَۃَ ، قَالَ : إنَّ الْعَبْدَ الْمُسْلِمَ إذَا تَوَضَّأَ فَأَحْسَنَ الْوُضُوئَ ، ثُمَّ قَامَ یُصَلِّی أَقْبَلَ اللَّہُ عَلَیْہِ بِوَجْہِہِ حَتَّی یَکُونَ ہُوَ الَّذِی یَنْصَرِفُ ، أَوْ یُحْدِث حَدَثَ سوْئٍ فَلاَ یَبْزُقْ بَیْنَ یَدَیْہِ ، وَلاَ عَنْ یَمِینِہِ فَإِنَّ عَنْ یَمِینِہِ کَاتِبَ الْحَسَنَاتِ وَلَکِنْ یَبْزُقُ ، عَنْ شِمَالہِ ، أَوْ خَلْفَ ظَہْرِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 7532","","","كتاب الجمعة"
"7533","(۷۵۳۳) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ حُذَیْفَۃَ رَفَعَہُ بِنَحْوِہِ۔ (ابن ماجہ ۱۰۲۳)","","Musannaf Ibn Abi Shaybah 7533","","","كتاب الجمعة"
"7534","(۷۵۳۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنْ زِرٍّ ، عَنْ حُذَیْفَۃَ ، قَالَ : مَنْ صَلَّی فَبَزَقَ تُجَاہَ الْقِبْلَۃِ جَائَتْ بَزْقَتُہُ یَوْمَ الْقِیَامَۃِ فِی وَجْہِہِ۔ (بزار ۴۱۱)","Sahih","Musannaf Ibn Abi Shaybah 7534","","","كتاب الجمعة"
"7535","(۷۵۳۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ سُوقَۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إذَا بَزَقَ فِی الْقِبْلَۃِ جَائَتْ أَحْمَی مَا تَکُونُ یَوْمَ الْقِیَامَۃِ حَتَّی تَقَعَ بَیْنَ عَیْنَیْہِ۔ (طبرانی ۷۹۶۰)","Hasan","Musannaf Ibn Abi Shaybah 7535","","","كتاب الجمعة"
"7536","(۷۵۳۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُکْرَہُ أَنْ یَبْزُقَ الرَّجُلُ بَیْنَ یَدَیْہِ فِی الصَّلاَۃ ، أَوْ عَنْ یَمِینِہِ ، وَقَالَ : اُبْزُقْ ، عَنْ شِمَالِکَ ، أَوْ تَحْتَ قَدَمِکَ۔","","Musannaf Ibn Abi Shaybah 7536","","","كتاب الجمعة"
"7537","(۷۵۳۷) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یَکْرَہُ أَنْ یَبْزُقَ الرَّجُلُ تُجَاہَ الْقِبْلَۃِ ، وَعَنْ یَمِینِہِ۔","","Musannaf Ibn Abi Shaybah 7537","","","كتاب الجمعة"
"7538","(۷۵۳۸) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَرِہَ أَنْ یَبْزُقَ تُجَاہَ الْقِبْلَۃِ ، قَالَ : وَکَانَ ابْنُ سِیرِینَ یَکْرَہُ الْقِبْلَتَیْنِ جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 7538","","","كتاب الجمعة"
"7539","(۷۵۳۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا عُبَید اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ رَأَی نُخَامَۃً فِی قِبْلَۃِ الْمَسْجِدِ فَحَتَّہَا ، ثُمَّ قَالَ : إذَا قَامَ أَحَدُکُمْ فِی صَلاَۃٍ فَلاَ یَتَنَخَّمْ قِبَلَ وَجْہِہِ فَإِنَّ اللَّہَ قِبَلَ وَجْہِ أَحَدِکُمْ إذَا کَانَ فِی الصَّلاَۃ۔ (بخاری ۴۰۶۔ مسلم ۵۰)","Sahih","Musannaf Ibn Abi Shaybah 7539","","","كتاب الجمعة"
"7540","(۷۵۴۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوٍمِنْہُ۔ (بخاری ۱۲۱۳۔ مسلم ۳۸۸)","Sahih","Musannaf Ibn Abi Shaybah 7540","","","كتاب الجمعة"
"7541","(۷۵۴۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : التَفْلُ فِی الْمَسْجِدِ خَطِیئَۃٌ وَکَفَّارَتُہُ أَنْ تُوَارِیَہُ۔ (بخاری ۱۲۱۴۔ مسلم ۵۵)","Sahih","Musannaf Ibn Abi Shaybah 7541","","","كتاب الجمعة"
"7542","(۷۵۴۲) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ حُسَیْنِ بْنِ وَاقِدٍ ، عَنْ أَبِی غَالِبٍ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْبُزَاقُ فِی الْمَسْجِدِ خَطِیئَۃٌ وَدَفْنُہُ حَسَنَۃٌ۔ (احمد ۵/۲۶۰۔ طبرانی ۸۰۹۱)","Hasan","Musannaf Ibn Abi Shaybah 7542","","","كتاب الجمعة"
"7543","(۷۵۴۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ عُبَیْدِ اللہِ ، أَنَّ أَبَا عُبَیْدَۃَ أَتَی مَنْزِلَہُ وَقَدْ بَزَقَ فِی الْمَسْجِدِ وَسَہَا أَنْ یَدْفِنَہَا حَتَّی أَتَی مَنْزِلَہُ فَذَکَر فَجَائَ بِمِصْبَاحٍ حَتَّی وَارَاہَا۔","","Musannaf Ibn Abi Shaybah 7543","","","كتاب الجمعة"
"7544","(۷۵۴۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ مَکْحُولٍ ، أَنَّ ابْنَ عُمَرَ تَنَخَّعَ ، أَوْ بَسَقَ فِی الْمَسْجِدِ فَنَسِیَ أَنْ یُوَارِیَہَا حَتَّی أَتَی مَنْزِلَہُ فَذَکَرَ بَعْدَ انْصِرَافِہِ فَرَجَعَ بِسِرَاجٍ فَالْتَمَسَہَا فِی الْمَسْجِدِ حَتَّی وَارَاہَا ، ثُمَّ قَالَ : مَنْ بَزَقَ فِی الْمَسْجِدِ فَہِیَ خَطِیئَۃٌ وَتَوْبَتُہُ أَنْ یُوَارِیَہَا۔","","Musannaf Ibn Abi Shaybah 7544","","","كتاب الجمعة"
"7545","(۷۵۴۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، وَعَبْدَۃُ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ أَبِی الأَزْہَرِ ، عَنْ مُجَاہِدٍ ، قَالَ : الْبُزَاقُ فِی الْمَسْجِدِ خَطِیئَۃٌ وَکَفَّارَتُہُ أَنْ یُوَارِیَہُ۔","","Musannaf Ibn Abi Shaybah 7545","","","كتاب الجمعة"
"7546","(۷۵۴۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : الْبُزَاقُ فِی الْمَسْجِدِ خَطِیئَۃٌ ، قَالَ : فَذَکَرْتُ ذَلِکَ لِلنَّخَعِیِّ ، فَقَالَ : کَانَ یُقَالُ ، کَفَّارَتُہُ دَفْنُہُ۔","","Musannaf Ibn Abi Shaybah 7546","","","كتاب الجمعة"
"7547","(۷۵۴۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنِ الْعَوَّامِ، عَنِ ابْنِ أَبِی الْہُذَیْلِ، قَالَ: الْبُزَاقُ فِی الْمَسْجِدِ خَطِیئَۃٌ وَکَفَّارَتہا دَفْنُہَا۔","","Musannaf Ibn Abi Shaybah 7547","","","كتاب الجمعة"
"7548","(۷۵۴۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سَیْفُ بْنُ سُلَیْمَانَ الْمَکِّیُّ ، قَالَ : سَمِعْتُ مُجَاہِدًا یَقُولُ بَزَقَ أَبُو عُبَیْدَۃَ بْنُ الْجَرَّاحِ فِی الْمَسْجِدِ لَیْلاً فَلَمْ یَدْرِ أَیْنَ مَوْضِعُہُ فَخَرَجَ فَجَائَ بِالْمِصْبَاحِ فَطَلَبَہُ حَتَّی وَارَاہُ۔","","Musannaf Ibn Abi Shaybah 7548","","","كتاب الجمعة"
"7549","(۷۵۴۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ یَزِیدَ بْنِ مِلْقط ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : إنَّ الْمَسْجِدَ لَیَنْزَوِی مِنَ الْمُخَاطِ ، أَوِ النُّخَامَۃِ کَمَا تَنْزَوِی الْجِلْدَۃُ فِی النَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 7549","","","كتاب الجمعة"
"7550","(۷۵۵۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی الْوَسْمِیِّ ، عَنْ رَجُلٍ ، یُقَالَ لَہُ زِیَادٌ رَجُلٌ مِنْ بَنِی فَزَارَۃَ ، أَنَّہُ سَمِعَ أَبَا ہُرَیْرَۃَ یَقُولُ : إنَّ الْمَسْجِدَ لَیَنْزَوِی مِنَ النُّخَامَۃِ کَمَا تَنْزَوِی الْبَضْعۃُ ، أَوِ الْجِلْدَۃُ مِنَ النَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 7550","","","كتاب الجمعة"
"7551","(۷۵۵۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبِی ، عَنْ لَیْثٍ ، قَالَ : مَا رَأَیْت طَاوُوسًا بَزَقَ فِی الْمَسْجِدِ قَطُّ ، وَلاَ مَسَّ الْحَصَی ، وَلاَ اتَّکَأَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 7551","","","كتاب الجمعة"
"7552","(۷۵۵۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنِ الرُّکَیْنِ ، عَنْ أَبِیہِ ، عَنْ أَسْمَائَ بْنِ الْحَکَمِ ، قَالَ : سَأَلْتُ عَنْ کُلِّ شَیْئٍ حَتَّی النَّفْثۃِ فِی الْمَسْجِدِ فَقِیلَ کَفَّارَتُہَا دَفْنُہَا۔","","Musannaf Ibn Abi Shaybah 7552","","","كتاب الجمعة"
"7553","(۷۵۵۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدٍ ، عَنْ عَامِرِ بْنِ سَعْدِ بْنِ أَبِی وَقَّاصٍ ، عَنْ أَبِیہِ سَعْدٍ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إذَا تَنَخَّمَ أَحَدُکُمْ فِی الْمَسْجِدِ فَلْیُغَیِّبْہَا ، ولاَ تُصِبْ جِلْدَ مُؤْمِنٍ ، أَوْ ثَوْبَہُ فَتُؤْذِیَہُ۔ (احمد ۱/۱۷۹۔ ابن خزیمۃ ۱۳۱۱)","Hasan","Musannaf Ibn Abi Shaybah 7553","","","كتاب الجمعة"
"7554","(۷۵۵۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو مَوْدُودٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی حَدْرَدٍ الأَسْلَمِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا بَزَقَ أَحَدُکُمْ فِی مَسْجِدِی ، أَوَ قَالَ فِی الْمَسْجِدِ فَلْیَحْفِرْ فَلْیُمْعِنْ ، أَوْ لِیَبْزُقْ فِی ثَوْبٍ حَتَّی یَخْرُجَہُ۔ (ابوداؤد ۴۷۸۔ احمد ۲/۳۲۴)","Hasan","Musannaf Ibn Abi Shaybah 7554","","","كتاب الجمعة"
"7555","(۷۵۵۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ الأَوْزَاعِیِّ ، عَنْ حَسَّانَ بْنِ عَطِیَّۃَ ، قَالَ : کَانَ مُعَاذُ بْنُ جَبَلٍ یَأْخُذُ الْبُرْغُوثَ فِی الصَّلاَۃ فَیَفْرُکُہُ بِیَدِہِ حَتَّی یَقْتُلَہُ ، ثُمَّ یَبْزُقُ عَلَیْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 7555","","","كتاب الجمعة"
"7556","(۷۵۵۶) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ أَبِی بَکْرِ بْنِ أَبِی مَرْیَمَ ، عْن عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ : کَانَ عُمَرُ بْنُ الْخَطَّابِ یَقْتُلُ الْقَمْلَۃَ فِی الصَّلاَۃ حَتَّی یَظْہَرَ دَمُہَا عَلَی یَدِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 7556","","","كتاب الجمعة"
"7557","(۷۵۵۷) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَبْدِ الرَّحْمَانِ بْنِ زِیَادِ بْنِ أَنْعُمٍ ، عْن مُسْلِمِ بْنِ یَسَارٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی الرَّجُلِ یَأْخُذُ الْقَمْلَۃَ فِی صَلاَتِہِ ، قَالَ : یَحْدُرُہَا وَیَطْرَحُہَا۔","","Musannaf Ibn Abi Shaybah 7557","","","كتاب الجمعة"
"7558","(۷۵۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَجِدُ الْقَمْلَۃَ فِی الصَّلاَۃ ، قَالَ : یَدْفِنُہَا۔","","Musannaf Ibn Abi Shaybah 7558","","","كتاب الجمعة"
"7559","(۷۵۵۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إِنْ قَتَلَہَا فِی الصَّلاَۃ فَلاَ شَیْئَ۔","","Musannaf Ibn Abi Shaybah 7559","","","كتاب الجمعة"
"7560","(۷۵۶۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ثَوْرٌ الشَّامِیُّ ، عَنْ رَاشِدِ بْنِ سَعْدٍ ، عَنْ مَالِکِ بْنِ یُخَامِرَ ، قَالَ ثَوْرٌ مَرَّۃً رَاشِدُ بْنُ سَعْدٍ ، أَوْ غَیْرُہُ ، قَالَ : رَأَیْتُ مُعَاذَ بْنَ جَبَلٍ یَقْتُلُ الْقَمْلَ وَالْبَرَاغِیثَ فِی الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 7560","","","كتاب الجمعة"
"7561","(۷۵۶۱) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی حَمْزَۃَ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : آخُذُ الْقَمْلَۃَ وَأَنَا فِی الصَّلاَۃ ؟ قَالَ : ادْفِنْہَا فِی الْحَصَی إنَّمَا جُعِلَتِ الأَرْضُ کِفَاتًا أَحْیَائً وَأَمْوَاتًا۔","","Musannaf Ibn Abi Shaybah 7561","","","كتاب الجمعة"
"7562","(۷۵۶۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ جُوَیْبِرٍ، عَنِ الضَّحَّاکِ؛ فِی الرَّجُلِ یَقْتُلُ الْقَمْلَۃَ فِی الصَّلاَۃ، قَالَ: لاَ بَأْسَ بہ۔","","Musannaf Ibn Abi Shaybah 7562","","","كتاب الجمعة"
"7563","(۷۵۶۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ ثُوَیر، عَنْ مُجَاہِدٍ ؛ فِی الرَّجُلِ یَجِدُ الْقَمْلَۃَ فِی الصَّلاَۃ ، قَالَ: لاَ بَأْسَ أَنْ یُحَوِّلَہَا۔","","Musannaf Ibn Abi Shaybah 7563","","","كتاب الجمعة"
"7564","(۷۵۶۴) حَدَّثَنَا وَکِیعٌ قَالَ: حَدَّثَنَا إسْرَائِیلُ، عَنْ جَابِرٍ، عَنْ عَامِرٍ؛ فِی الرَّجُلِ یَجِدُ الْقَمْلَۃَ فِی الصَّلاَۃ، قَالَ: یَدَعُہَا۔","","Musannaf Ibn Abi Shaybah 7564","","","كتاب الجمعة"
"7565","(۷۵۶۵) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، عَنْ صَدَقَۃَ أَبِی تَوْبَۃَ ، عَنْ أَنَسٍ ، أَنَّہُ کَانَ یَقْتُلُ الْقَمْلَ فِی الصَّلاَۃ۔","Da'if","Musannaf Ibn Abi Shaybah 7565","","","كتاب الجمعة"
"7566","(۷۵۶۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَلِیُّ بْنُ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنِ الْحَضْرَمِیِّ بْنِ لاَحِقٍ ، عَنْ رَجُلٍ مِنَ الأَنْصَارِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا وَجَدَ أَحَدُکُمُ الْقَمْلَۃَ فِی الْمَسْجِدِ فَلْیَصُرَّہَا فِی ثَوْبِہِ حَتَّی یُخْرِجَہَا۔ (احمد ۴۱۰۔ بیہقی ۲۹۴)","Da'if","Musannaf Ibn Abi Shaybah 7566","","","كتاب الجمعة"
"7567","(۷۵۶۷) حَدَّثَنَا جَرِیرٌ ، عَنْ قَابُوسَ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی الرَّجُلِ یَجِدُ الْقَمْلَۃَ وہو فِی الْمَسْجِدِ ، قَالَ: یَدْفِنُہَا فِی الْحَصْبَائِ ، قَالَ وَرَأَیْت أَبَا ظَبْیَانَ یَفْعَلُ ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 7567","","","كتاب الجمعة"
"7568","(۷۵۶۸) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ مُسْلِمٍ الْمُلاَئِیِّ ، عَنْ زَاذَانَ ، عَنِ الرَّبِیعِ بْنِ خُثَیم ، أَنَّ عَبْدَ اللہِ دَفَنَ قَمْلَۃً فِی الْمَسْجِدِ ، ثُمَّ قَرَأَ : {أَلَمْ نَجْعَل الأَرْضَ کِفَاتًا}۔","Da'if","Musannaf Ibn Abi Shaybah 7568","","","كتاب الجمعة"
"7569","(۷۵۶۹) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ رَجُلٍ ، قَالَ : رَأَیْتُ أَبَا أُمَامَۃَ یَتَفَلَّی فِی الْمَسْجِدِ ویدفنہ فیہ۔","Da'if","Musannaf Ibn Abi Shaybah 7569","","","كتاب الجمعة"
"7570","(۷۵۷۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أبان بن عبد اللہ البجلی عن أبی مسلم الثعلبی قَالَ : رَأَیْتُ أَبَا أُمَامَۃَ یَتَفَلَّی فِی مَسْجِدِہِ وَہُوَ یَدْفِنُ الْقَمْلَ فِی الْحَصَی۔","Da'if","Musannaf Ibn Abi Shaybah 7570","","","كتاب الجمعة"
"7571","(۷۵۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو خَلْدَۃَ ، قَالَ : رَأَیْتُ أَبَا الْعَالِیَۃِ یَدْفِنُ الْقَمْلَ فِی الْمَسْجِدِ وَقَرَأَ : {أَلَمْ نَجْعَلِ الأَرْضَ کِفَاتًا}۔","","Musannaf Ibn Abi Shaybah 7571","","","كتاب الجمعة"
"7572","(۷۵۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ، قَالَ ادْفِنْہَا فِی الْمَسْجِدِ قَدْ یُدْفَنُ مَا ہُوَ شَرٌّ مِنْہَا : النُّخَامَۃُ۔","","Musannaf Ibn Abi Shaybah 7572","","","كتاب الجمعة"
"7573","(۷۵۷۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنِ الْحَسَنِ بْنِ عَلِیٍّ ، قَالَ : رَأَیْتُُ ابْنَ مَعْقِل یَتَفَلَّی فِی الْمَسْجِدِ وَکَانَتْ جَدَّتِی أُمَّ وَلَدٍ لِلْحَسَنِ بْنِ عَلِیٍّ ، فَکَانَ یَعْزِلُ عَنْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 7573","","","كتاب الجمعة"
"7574","(۷۵۷۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ لَیْثٍ ، عَنِ الْحَسَنِ بْنِ مُسْلِمٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : أَخَذْتُ عَنِ ابْنِ عُمَرَ دَابَّۃً وَہُوَ یُصَلِّی فِی الْمَسْجِدِ فَأَلْقَیْتُہَا فِی نَاحِیَۃِ الْمَسْجِدِ فَلَمْ یَعِبْ ذَلِکَ عَلَیَّ۔","Da'if","Musannaf Ibn Abi Shaybah 7574","","","كتاب الجمعة"
"7575","(۷۵۷۵) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَخَذْت الْقَمْلَۃَ وَأَنْتَ فِی الْمَسْجِدِ فَادْفِنْہَا فِی الْحَصْبَائِ۔","","Musannaf Ibn Abi Shaybah 7575","","","كتاب الجمعة"
"7576","(۷۵۷۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ یُوسُفَ بْنِ مَاہَکَ ، قَالَ : رَأَیْتُ ابْنَ عُمَیْرٍ أَخَذَ مِنْ ثَوْبِ ابْنِ عُمَرَ قَمْلَۃً فَدَفَنَہَا فِی الْمَسْجِدِ۔","Sahih","Musannaf Ibn Abi Shaybah 7576","","","كتاب الجمعة"
"7577","(۷۵۷۷) حَدَّثَنَا قَطَنُ بْنُ عَبْدِ اللہِ ، عَنْ أَبِی غَالِبٍ ، قَالَ : رَأَیْتُُ أَبَا أُمَامَۃَ یَأْخُذُ الْقَمْلَ وَیُلْقِیہِ فِی الْمَسْجِدِ فَقُلْت یَا أَبَا أُمَامَۃَ تَأْخُذُ الْقَمْلَ وَتُلْقِیہِ فِی الْمَسْجِدِ ، قَالَ : {أَلَمْ نَجْعَلِ الأَرْضَ کِفَاتًا * أَحْیائً وَأمْواتًا}۔","Hasan","Musannaf Ibn Abi Shaybah 7577","","","كتاب الجمعة"
"7578","(۷۵۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ یَحْیَی بْنِ ہَانِئِ بْنِ عُرْوَۃَ الْمُرَادِیِّ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ مَحْمُودٍ ، قَالَ: صَلَّیْنَا خَلْفَ أَمِیرٍ مِنَ الأُمَرَائِ فَاضْطَرَّنَا النَّاسُ حَتَّی صَلَّیْنَا بَیْنَ السَّارِیَتَیْنِ، فَلَمَّا صَلَّیْنَا، قَالَ أَنَسُ بْنُ مَالِکٍ: کُنَّا نَتَّقِی ہَذَا عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (ابوداؤد ۶۷۳۔ احمد ۳/۱۳۱)","Sahih","Musannaf Ibn Abi Shaybah 7578","","","كتاب الجمعة"
"7579","(۷۵۷۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا خَالِدٌ عَمَّنْ حَدَّثَہُ ، عَنْ أَنَسٍ ، قَالَ نُہِینَا أَنْ نُصَلِّیَ بَیْنَ الأَسَاطِینِ۔","Da'if","Musannaf Ibn Abi Shaybah 7579","","","كتاب الجمعة"
"7580","(۷۵۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مَعْدِی کَرِبَ ، عَنِ ابْنِ مَسْعُود ، قَالَ : لاَ تَصُفُّوا بَیْنَ الأَسَاطِینِ ، وَلاَ تَأْتَمُّوا بِقَوْمٍ یَمْتَرُونَ وَیَلْغُونَ۔ (عبدالرزاق ۲۴۸۷۔ طبرانی ۹۲۹۵)","Da'if","Musannaf Ibn Abi Shaybah 7580","","","كتاب الجمعة"
"7581","(۷۵۸۱) حَدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ ، عَنْ حُصَیْنِ بْنِ ہِلاَلٍ ، عَنْ حُذَیْفَۃَ ، أَنَّہُ کَرِہَ الصَّلاَۃ بَیْنَ الأَسَاطِینِ۔","","Musannaf Ibn Abi Shaybah 7581","","","كتاب الجمعة"
"7582","(۷۵۸۲) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، عَنْ أَبِیہِ ، قَالَ : رَآنِی عُمَرُ وَأَنَا أُصَلِّی بَیْنَ أُسْطُوَانَتَیْنِ فَأَخَذَ بِقَفَای فَأَدْنَانِی إلَی سُتْرَۃٍ ، فَقَالَ : صَلِّ إلَیْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 7582","","","كتاب الجمعة"
"7583","(۷۵۸۳) حَدَّثَنَا شَرِیکٌ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ، عَنْ إبْرَاہِیمَ، أَنَّہُ کَرِہَ الصَّلاَۃ بَیْنَ الأَسَاطِینِ، وَقَالَ: أَتِمُّوا الصُّفُوفَ۔","","Musannaf Ibn Abi Shaybah 7583","","","كتاب الجمعة"
"7584","(۷۵۸۴) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا حَسَنُ بْنُ صَالِحٍ، عَنْ إبْرَاہِیمَ بن مہاجر، عَنْ إبْرَاہِیمَ قَالَ: لاَ تُصَلُّوا بَیْنَ الأَسَاطِینِ۔","","Musannaf Ibn Abi Shaybah 7584","","","كتاب الجمعة"
"7585","(۷۵۸۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا فی الصَّفِّ بَیْنَ السَّوَارِی۔","","Musannaf Ibn Abi Shaybah 7585","","","كتاب الجمعة"
"7586","(۷۵۸۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : لاَ أَعْلَمُ بِالصَّلاَۃ بَیْنَ السَّوَارِی بَأْسًا۔","","Musannaf Ibn Abi Shaybah 7586","","","كتاب الجمعة"
"7587","(۷۵۸۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ وِقَائٍ ، قَالَ : کَانَ سَعِیدُ بْنُ جُبَیْرٍ یَؤُمُّنَا بَیْنَ سَارِیَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 7587","","","كتاب الجمعة"
"7588","(۷۵۸۸) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، قَالَ: رَأَیْتُ إبْرَاہِیمَ التَّیْمِیَّ یَؤُمُّ قَوْمَہُ بَیْنَ أُسْطُوَانَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 7588","","","كتاب الجمعة"
"7589","(۷۵۸۹) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا مُوسَی بْنُ نَافِعٍ ، قَالَ : رَأَیْتُ سعید بن جبیر یَؤُمُّنَا بَیْنَ السَارِیَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 7589","","","كتاب الجمعة"
"7590","(۷۵۹۰) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنْ بِشْرِ بْنِ طُعْمَۃَ الثَّوْرِیِّ ، قَالَ : رَأَیْتُ الرَّبِیعَ بْنَ خُثَیم صَلَّی فِی مَرَضِہِ بَیْنَ سَارِیَتَیْنِ یَعْتَمِدُ عَلَی إحْدَاہُمَا۔","","Musannaf Ibn Abi Shaybah 7590","","","كتاب الجمعة"
"7591","(۷۵۹۱) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ وَإِسْرَائِیلُ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، قَالَ : کَانَ سُوَیْد بْنُ غَفَلَۃَ یَؤُمُّنَا بَیْنَ أُسْطُوَانَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 7591","","","كتاب الجمعة"
"7592","(۷۵۹۲) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ یَحْیَی بْنُ وَثَّابٍ یَؤُمُّنَا بَیْنَ أُسْطُوَانَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 7592","","","كتاب الجمعة"
"7593","(۷۵۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعَۃَ بْنِ عُثْمَانَ التَّیْمِیِّ ، قَالَ : حدَّثَنَا إدْرِیسُ الصَّنْعَانِیُّ ، عَنْ رَجُلٍ ، یُقَالُ لَہُ ہَمْدَانُ وَکَانَ بَرِیدَ أَہْلِ الْیَمَنِ إلَی عُمَرَ ، قَالَ : قَالَ عُمَرُ : الْمُصَلُّونَ أَحَقُّ بِالسَّوَارِی مِنَ الْمُتَحَدِّثِینَ إلَیْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 7593","","","كتاب الجمعة"
"7594","(۷۵۹۴) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیر ، قَالَ : أَخْبَرَنَا حُصَینٌ ، عَنْ مُحَمَّدِ بْنِ طَلْحَۃَ بْنِ رُکَانَۃَ الْمُطَّلِبِیِّ ، عَنْ جُبَیْرِ بْنِ مُطْعِمٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ صَلاَۃً فِی مَسْجِدِی ہَذَا خَیْرٌ مِنْ أَلْفِ صَلاَۃٍ فِیمَا سِوَاہُ إِلاَّ الْمَسْجِدَ الْحَرَامَ۔ (طیالسی ۹۵۰۔ احمد ۴/۸۰)","","Musannaf Ibn Abi Shaybah 7594","","","كتاب الجمعة"
"7595","(۷۵۹۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَلاَۃٌ فِی مَسْجِدِی ہَذَا أَفْضَلُ مِنْ أَلْفِ صَلاَۃٍ فِی غَیْرِہِ إِلاَّ الْمَسْجِدَ الْحَرَامَ۔ (مسلم ۱۰۱۳۔ احمد ۶/۵۳)","Sahih","Musannaf Ibn Abi Shaybah 7595","","","كتاب الجمعة"
"7596","(۷۵۹۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ، أَنَّہُ سَمِعَ أَبَا سَلَمَۃَ یُحَدِّثُ الأَغَرَّ ، أَنَّہُ سَمِعَ أَبَا ہُرَیْرَۃَ یُحَدِّثُ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : صَلاَۃٌ فِی مَسْجِدِی ہَذَا أَفْضَلُ مِنْ أَلْفِ صَلاَۃٍ فِیمَا سِوَاہُ مِنَ الْمَسَاجِدِ إِلاَّ الْکَعْبَۃَ۔ (بخاری ۱۱۹۰۔ ترمذی ۳۲۵)","Sahih","Musannaf Ibn Abi Shaybah 7596","","","كتاب الجمعة"
"7597","(۷۵۹۷) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی أَخْبَرَنَا مُوسَی بْنُ عُبَیْدَۃَ ، عَنْ دَاوُدَ بْنِ مُدْرِکٍ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ، قالَتْ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَلاَۃٌ فِی مَسْجِدِی أَفْضَلُ مِنْ أَلْفِ صَلاَۃٍ فِیمَا سِوَاہُ مِنَ الْمَسَاجِدِ إِلاَّ الْمَسْجِدَ الْحَرَامَ۔ (بزار ۱۱۹۳)","Da'if","Musannaf Ibn Abi Shaybah 7597","","","كتاب الجمعة"
"7598","(۷۵۹۸) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ حُمَیْدِ بْنِ صَخْرٍ ، عَنِ الْمَقْبُرِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ جَائَ مَسْجِدِی ہَذَا لَمْ یَأْتِہِ إِلاَّ لِخَیْرٍ یُعَلِّمُہُ ، أَوْ یَتَعَلَّمُہُ فَہُوَ بِمَنْزِلَۃِ الْمُجَاہِدِ فِی سَبِیلِ اللہِ وَمَنْ جَائَہُ لِغَیْرِ ذَلِکَ فَہُوَ بِمَنْزِلَۃِ الرَّجُلِ یَنْظُرُ إلَی مَتَاعِ غَیْرِہِ۔ (احمد ۲/۴۱۸۔ ابن حبان ۸۷)","","Musannaf Ibn Abi Shaybah 7598","","","كتاب الجمعة"
"7599","(۷۵۹۹) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ لَیْثِ بْنِ سَعْدٍ ، عَنْ نَافِع ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ اللہِ بْنِ مَعْبَدٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ مَیْمُونَۃَ قَالَت : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : صَلاَۃٌ فِیہِ ، یَعْنِی مَسْجِدَ الْمَدِینَۃِ، أَفْضَلُ مِنْ أَلْفِ صَلاَۃٍ فِیمَا سِوَاہُ إِلاَّ مَسْجِدَ مَکَّۃَ۔ (مسلم ۵۱۰)","Sahih","Musannaf Ibn Abi Shaybah 7599","","","كتاب الجمعة"
"7600","(۷۶۰۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ زِیَادِ بْنِ سَعْدٍ ، عَنْ سُلَیْمَانَ بْنِ عُثْمَانَ سَمِعَ ابن الزُّبَیْرَ یَقُولُ : سَمِعْتُ عُمَرَ یَقُولُ : صَلاَۃٌ فِی ہَذَا الْمَسْجِدِ أَفْضَلُ مِنْ مِئَۃ صَلاَۃٍ فِیمَا سِوَاہُ۔","Sahih","Musannaf Ibn Abi Shaybah 7600","","","كتاب الجمعة"
"7601","(۷۶۰۱) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ أُنیَسِ بْنِ أَبِی یَحْیَی ، عَنْ أَبِیہِ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : امْتَرَی رَجُلٌ مِنْ بَنِی خُدْرَۃَ وَرَجُلٌ مِنْ بَنِی عَمْرِو بْنِ عَوْفٍ فِی الْمَسْجِدِ الَّذِی أُسِّسَ عَلَی التَّقْوَی ، فَقَالَ الْخُدْرِیِّ : ہُوَ مَسْجِدُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَقَالَ الْعَوْفِی : ہُوَ مَسْجِدُ قُبَائٍ فَأَتَیَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی ذَلِکَ ، فَقَالَ : ہُوَ ہَذَا ہُوَ ہَذَا ، یَعْنِی مَسْجِدَہُ وَفِی ذَلِکَ خَیْرٌ کَثِیرٌ۔ (ترمذی ۳۲۳۔ احمد ۳/۲۳)","Sahih","Musannaf Ibn Abi Shaybah 7601","","","كتاب الجمعة"
"7602","(۷۶۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی سَعِیدٍ الْخُدْرِیِّ ، عَنْ أَبِیہِ ، قَالَ : الْمَسْجِدُ الَّذِی أُسِّسَ عَلَی التَّقْوَی ہُوَ مَسْجِدُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Hasan","Musannaf Ibn Abi Shaybah 7602","","","كتاب الجمعة"
"7603","(۷۶۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعَۃَ بْنِ عُثْمَانَ ، قَالَ : حدَّثَنِی عِمْرَانُ بْنُ أَبِی أَنَسٍ ، عَنْ سَہْلِ بْنِ سَعْدٍ ، قَالَ : اخْتَلَفَ رَجُلاَنِ فِی الْمَسْجِدِ الَّذِی أُسِّسَ عَلَی التَّقْوَی ، فَقَالَ : أَحَدُہُمَا ہُوَ مَسْجِدُ الْمَدِینَۃِ ، وَقَالَ الأَخَرُ ہُوَ مَسْجِدُ قُبَائٍ فَأَتَیَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : ہُوَ مَسْجِدِی ہَذَا۔ (احمد ۵/۳۳۱۔ ابن حبان ۱۶۰۵)","Hasan","Musannaf Ibn Abi Shaybah 7603","","","كتاب الجمعة"
"7604","(۷۶۰۴) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا رَبِیعَۃُ بْنُ عُثْمَانَ ، عَنْ عُثْمَانَ بْنِ عَبْدِ اللہِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : الْمَسْجِدُ الَّذِی أُسِّسَ عَلَی التَّقْوَی ہُوَ مَسْجِدُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Hasan","Musannaf Ibn Abi Shaybah 7604","","","كتاب الجمعة"
"7605","(۷۶۰۵) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ أَبِی الزِّنَادِ ، عَنْ خَارِجَۃَ بْنِ زَیْدٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْمَسْجِدُ الَّذِی أُسِّسَ عَلَی التَّقْوَی مِنْ أَوَّلِ یَوْمٍ مَسْجِدُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (طبرانی ۴۸۵۴)","","Musannaf Ibn Abi Shaybah 7605","","","كتاب الجمعة"
"7606","(۷۶۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : مَسْجِدُ الْمَدِینَۃِ الأَعْظَمُ۔","","Musannaf Ibn Abi Shaybah 7606","","","كتاب الجمعة"
"7607","(۷۶۰۷) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ حُمَیْدِ بْنِ صَخْرٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : دَخَلْت عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَأَلْتُہُ ، عَنِ الْمَسْجِدِ الَّذِی أُسِّسَ عَلَی التَّقْوَی فَقَبَضَ قَبْضَۃً مِنَ الْحَصَی ، ثُمَّ ضَرَبَ بِہَا الأَرْضَ ، فَقَالَ : ہَذَا ہُوَ ، یَعْنِی مَسْجِدَ الْمَدِینَۃِ۔ (مسلم ۱۰۱۵۔ احمد ۳/۲۴)","Sahih","Musannaf Ibn Abi Shaybah 7607","","","كتاب الجمعة"
"7608","(۷۶۰۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنِ ابن حَرْمَلَۃَ، عَنِ ابْنِ الْمُسَیَّبِ، قَالَ: ہُوَ مَسْجِدُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 7608","","","كتاب الجمعة"
"7609","(۷۶۰۹) حَدَّثَنَا الْفَضْلُ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرٍ ، عَنْ عِمْرَانَ بْنِ أَبِی أَنَسٍ ، عَنْ سَہْلِ بْنِ سَعْدٍ ، عَنْ أُبَیِّ بْنِ کَعْبٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْمَسْجِدُ الَّذِی أُسِّسَ عَلَی التَّقْوَی ہُوَ مَسْجِدِی۔ (احمد ۵/۱۱۶۔ حاکم ۳۳۴)","Da'if","Musannaf Ibn Abi Shaybah 7609","","","كتاب الجمعة"
"7610","(۷۶۱۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، قَالَ : حدَّثَنَا أَبُو الأَبْرَدِ مَوْلَی بَنِی خَطْمَۃَ ، أَنَّہُ سَمِعَ أُسَیْدَ بْنَ ظُہَیْرٍ الأَنْصَارِیَّ وَکَانَ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُحَدِّثُ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : صَلاَۃٌ فِی مَسْجِدِ قُبَائٍ کَعُمْرَۃٍ۔ (بخاری ۱۶۴۱۔ ابن ماجہ ۱۴۱۱)","Da'if","Musannaf Ibn Abi Shaybah 7610","","","كتاب الجمعة"
"7611","(۷۶۱۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، قَالَ : أَخْبَرَنِی یُوسُفُ بْنُ طَہْمَانَ ، عَنْ أَبِی أُمَامَۃَ بْنِ سَہْلٍ ، عَنْ أَبِیہِ سَہْلِ بْنِ حُنَیْفٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ تَوَضَّأَ فَأَحْسَنَ وُضُوئَہُ ، ثُمَّ جَائَ مَسْجِدَ قُبَائٍ فَرَکَعَ فِیہِ أَرْبَعَ رَکَعَاتٍ کَانَ ذَلِکَ عَدْلَ عُمْرَۃٍ۔ (بخاری ۳۳۸۹۔ احمد ۳/۴۸۷)","Da'if","Musannaf Ibn Abi Shaybah 7611","","","كتاب الجمعة"
"7612","(۷۶۱۲) حَدَّثَنَا أَبُو أُسَامَۃَ حَدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَأْتِی مَسْجِدَ قُبَائٍ مَاشِیًا وَرَاکِبًا۔ (بخاری ۱۱۹۴۔ ابوداؤد ۲۰۳۳)","Sahih","Musannaf Ibn Abi Shaybah 7612","","","كتاب الجمعة"
"7613","(۷۶۱۳) حَدَّثَنَا أَبُو خَالِدٍ سُلَیْمَانُ بْنُ حَیَّانَ ، عَنْ سَعْدِ بْنِ إِسْحَاقَ ، عَنْ سَلِیطِ بْنِ سَعْدٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ مَنْ خَرَجَ یُرِیدُ قُبَائً لاَ یُرِیدُ غَیْرَہُ فَصَلَّی فِیہِ کَانَتْ کَعُمْرَۃٍ۔","Hasan","Musannaf Ibn Abi Shaybah 7613","","","كتاب الجمعة"
"7614","(۷۶۱۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ ہَاشِمِ بْنِ ہَاشِمٍ ، عَنْ عَائِشَۃَ بِنْتِ سَعْدٍ ، قَالَتْ سَمِعْتُ أَبِی یَقُولُ لأَنْ أُصَلِّیَ فِی مَسْجِدِ قُبَائٍ أَحَبُّ إلَیَّ مِنْ أَنْ أُصَلِّیَ فِی بَیْتِ الْمَقْدِسِ۔","Hasan","Musannaf Ibn Abi Shaybah 7614","","","كتاب الجمعة"
"7615","(۷۶۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ، عَنْ أَبِی صَالِحٍ الْحَنَفِیِّ ، عَنْ أَخِیہِ طَلِیقِ بْنِ قَیْسٍ، قَالَ : قَالَ أَبُو ذَرٍّ : لأَنْ أُصَلِّیَ عَلَی رَمْلَۃٍ حَمْرَائَ أَحَبُّ إلَیَّ مِنْ أَنْ أُصَلِّیَ فِی بَیْتِ الْمَقْدِسِ۔","Sahih","Musannaf Ibn Abi Shaybah 7615","","","كتاب الجمعة"
"7616","(۷۶۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ وَاصِلٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ حُذَیْفَۃَ ، قَالَ : لَوْ سِرْتُ حَتَّی لاَ یَکُونَ بَیْنِی وَبَیْنَ بَیْتِ الْمَقْدِسِ إِلاَّ فَرْسَخٌ ، أَوْ فَرْسَخَانِ مَا أَتَیْتُہُ ، أَوْ مَا أَحْبَبْتُ أَنْ آتِیَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 7616","","","كتاب الجمعة"
"7617","(۷۶۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الْمِقْدَامِ ، عَنْ حَبَّۃَ ، قَالَ : جَائَ رَجُلٌ إلَی عَلِیٍّ ، فَقَالَ : إنِّی اشْتَرَیْتُ بَعِیرًا وَتَجَہَّزْتُ وأُرِیدُ بَیْتَ الْمَقْدِسِ ، فَقَالَ : بِعْ بَعِیرَک وَصَلِّ فِی ہَذَا الْمَسْجِدِ ، یَعْنِی مَسْجِدَ الْکُوفَۃِ فَمَا مِنْ مَسْجِدٍ بَعْدَ مَسْجِدِ الْحَرَامِ وَمَسْجِدِ الْمَدِینَۃِ أَحَبُّ إلَیَّ مِنْہُ وَلَقَدْ نَقَصَ مِمَّا أُسِّسَ خَمْسَمِئَۃِ ذِرَاعٍ، یَعْنِی مَسْجِدَ الْکُوفَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 7617","","","كتاب الجمعة"
"7618","(۷۶۱۸) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ حَدَّثَنَا إسْرَائِیلُ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : لَقِیَنِی کَعْبٌ بِبَیْتِ الْمَقْدِسِ ، فَقَالَ : مِنْ أَیْنَ ؟ فَقُلْتُ : مِنْ مَسْجِدِ الْکُوفَۃِ ، فَقَالَ : لأَنْ أَکُونَ جِئْتُ مِنْ حَیْثُ جِئْتَ أَحَبُّ إلَیَّ مِنْ أَنْ أَتَصَدَّقَ بِأَلْفِ دِینَارٍ أَضَعُ کُلَّ دِینَارٍ مِنْہَا فِی یَدِ مِسْکِینٍ ، ثُمَّ حَلَفَ أَنَّہُ أَوْسَطُ الأَرْضِ کَقَعْرِ الطَّسْتِ۔","","Musannaf Ibn Abi Shaybah 7618","","","كتاب الجمعة"
"7619","(۷۶۱۹) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ قَزَعَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تُشَدُّ الرِّحَالُ إِلاَّ إلَی ثَلاَثَۃِ مَسَاجِدَ : مسجد الحرام ، ومسجد المدینۃ ، ومسجد بَیْتِ الْمَقْدِسِ۔ (بخاری ۱۱۹۷۔ مسلم ۴۱۶)","Sahih","Musannaf Ibn Abi Shaybah 7619","","","كتاب الجمعة"
"7620","(۷۶۲۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : لاَ تُشَدُّ الرِّحَالُ إِلاَّ إلَی ثَلاَثَۃِ مَسَاجِدَ : الْمَسْجِدِ الْحَرَامِ وَمَسْجِدِی ہَذَا وَالْمَسْجِدِ الأَقْصَی۔ (بخاری ۱۱۸۹۔ احمد ۲/۲۳۴)","Sahih","Musannaf Ibn Abi Shaybah 7620","","","كتاب الجمعة"
"7621","(۷۶۲۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ طَلْقٍ ، عَنْ قَزَعَۃَ ، قَالَ : سَأَلْتُ ابن عُمَرَ آتِی الطُّورَ ، قَالَ : دَعِ الطُّورَ وَلاَ تَأْتِہَا ، وَقَالَ : لاَ تُشَدُّ الرِّحَالُ إِلاَّ إلَی ثَلاَثَۃِ مَسَاجِدَ۔","Sahih","Musannaf Ibn Abi Shaybah 7621","","","كتاب الجمعة"
"7622","(۷۶۲۲) حَدَّثَنَا یَحْیَی بْنُ الْیَمَانَ ، عَنْ سُفْیَانَ ، عَنْ أَبِی سِنَانٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی الْہُذَیْلِ ، قَالَ : لاَ تُشَدُّ الرِّحَالُ إِلاَّ إلَی الْبَیْتِ الْعَتِیقِ۔","","Musannaf Ibn Abi Shaybah 7622","","","كتاب الجمعة"
"7623","(۷۶۲۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِاللہِ، عَنْ إبْرَاہِیمَ، قَالَ: لاَ تُشَدُّ الرِّحَالُ إِلاَّ إلَی ثَلاَثَۃِ مَسَاجِدَ۔","","Musannaf Ibn Abi Shaybah 7623","","","كتاب الجمعة"
"7624","(۷۶۲۴) حَدَّثَنَا زَیْدُ بْنُ حَبَّابٍ ، حَدَّثَنَا جَعْفَرُ بْنُ إبْرَاہِیمَ مِنْ وَلَدِ ذِی الْجَنَاحَیْنِ ، قَالَ : حدَّثَنِی عَلِیُّ بْنُ عُمَرَ ، عَنْ أَبِیہِ ، عَنْ عَلِیِّ بْنِ الْحُسَیْنِ ، أَنَّہُ رَأَی رَجُلاً یَجِیئُ إلَی فُرْجَۃٍ کَانَتْ عِنْدَ قَبْرِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَیَدْخُلُ فِیہَا فَیَدْعُو فَدَعَاہُ ، فَقَالَ : أَلاَ أُحَدِّثُکَ بِحَدِیثٍ سَمِعْتُہُ مِنْ أَبِی ، عَنْ جَدِّی ، عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ تَتَّخِذُوا قَبْرِی عِیدًا ، وَلاَ بُیُوتَکُمْ قُبُورًا وَصَلُّوا عَلَیَّ فَإِنَّ صَلاَتَکُمْ وَتَسْلِیمَکُم یَبْلُغُنِی حَیْثُ مَا کُنْتُمْ۔(بخاری ۱۸۶۔ ابو یعلی ۶۷۲۸)","Da'if","Musannaf Ibn Abi Shaybah 7624","","","كتاب الجمعة"
"7625","(۷۶۲۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ سُہَیْلِ ، عَنْ حَسَنِ بْنِ حَسَنٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَتَّخِذُوا قَبْرِی عِیدًا ، وَلاَ بُیُوتَکُمْ قُبُورًا وَصَلُّوا عَلَیَّ حَیْثُ مَّا کُنْتُمْ فَإِنَّ صَلاَتَکُمْ تَبْلُغُنِی۔ (عبدالرزاق ۶۷۲۶)","","Musannaf Ibn Abi Shaybah 7625","","","كتاب الجمعة"
"7626","(۷۶۲۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اللَّہُمَّ لاَ تَجْعَلْ قَبْرِی وَثَنًا یُصَلَّی لَہُ ، اشْتَدَّ غَضَبُ اللہِ عَلَی قَوْمٍ اتَّخَذُوا قُبُورَ أَنْبِیَائِہِمْ مَسَاجِدَ۔ (امام مالک ۸۵)","","Musannaf Ibn Abi Shaybah 7626","","","كتاب الجمعة"
"7627","(۷۶۲۷) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنْ نَافِعٍ ، قَالَ بَلَغَ عُمَرَ بْنَ الْخَطَّابِ ، أَنَّ نَاسًا یَأْتُونَ الشَّجَرَۃَ الَّتِی بُویِعَ تَحْتَہَا ، قَالَ فَأَمَرَ بِہَا فَقُطِعَتْ۔","Sahih","Musannaf Ibn Abi Shaybah 7627","","","كتاب الجمعة"
"7628","(۷۶۲۸) حَدَّثَنَا زَکَرِیَّا بْنُ عَدِیٍّ ، عَنْ عُبَیْدِ اللہِ بْنِ عَمرو ، عَنْ زَیْدِ بْنِ أَبِی أُنَیْسَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ النَّجْرَانِیِّ ، قَالَ : حدَّثَنِی جُنْدَب ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَبْلَ أَنْ یَمُوتَ بِخَمْسٍ وَہُوَ یَقُولُ : أَلا وَإِنَّ مَنْ کَانَ قَبْلَکُمْ کَانُوا یَتَّخِذُونَ قُبُورَ أَنْبِیَائِہِمْ وَصَالِحِیہِمْ مَسَاجِدَ أَلا فَلاَ تَتَّخِذُوا الْقُبُورَ مَسَاجِدَ إنِّی ، أَنْہَاکُمْ ، عَنْ ذَلِکَ۔ (مسلم ۲۳۔ طبرانی ۱۶۸۶)","Sahih","Musannaf Ibn Abi Shaybah 7628","","","كتاب الجمعة"
"7629","(۷۶۲۹) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، حَدَّثَنَا شَیْبَانُ ، عَنْ ہِلاَلِ بْنِ أَبِی حُمَیْدٍ الأَنْصَارِیِّ ، عَنْ عُرْوَۃَ بْنِ الزُّبَیْرِ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی مَرَضِہِ الَّذِی لَمْ یَقُمْ مِنْہُ : لَعَنَ اللَّہُ الْیَہُودَ وَالنَّصَارَی اتَّخَذُوا قُبُورَ أَنْبِیَائِہِمْ مَسَاجِدَ۔n وَلَوْلاَ ذَلِکَ لأُبْرِزَ قَبْرُہُ ، إِلاَّ إِنَّہُ خُشِیَ أَنْ یُتَّخَذَ مَسْجِدًا۔ (بخاری ۱۳۹۰۔ مسلم ۱۹)","Sahih","Musannaf Ibn Abi Shaybah 7629","","","كتاب الجمعة"
"7630","(۷۶۳۰) حَدَّثَنَا وَکِیعٌ حَدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ أَنَّہُمْ تَذَاکَرُوا عِنْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی مَرَضِہِ فَذَکَرَتْ أُمُّ سَلَمَۃَ ، أَوْ أُمُّ حَبِیبَۃَ کَنِیسَۃً رَأَتْہَا فِی أَرْضِ الْحَبَشَۃِ فِیہَا تَصَاوِیرُ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أُولَئِکَ کَانُوا إذَا کَانَ فِیہِمُ الرَّجُلُ الصَّالِحُ فَمَاتَ بَنَوْا عَلَی قَبْرِہِ مَسْجِدًا وَصَوَّرُوہُ أُولَئِکَ شِرَارُ الْخَلْقِ۔ (بخاری ۴۳۴۔ مسلم ۱۶)","Sahih","Musannaf Ibn Abi Shaybah 7630","","","كتاب الجمعة"
"7631","(۷۶۳۱) حَدَّثَنَا وَکِیعٌ حَدَّثَنَا شُعْبَۃُ ، عَنْ مُحَمَّدِ بْنِ جُحَادَۃَ الأَوْدِیِّ ، قَالَ : سَمِعْتُ أَبَا صَالِحٍ بَعْدَ مَا کَبِرَ یُحَدِّثُ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَعَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ زَائِرَاتِ الْقُبُورِ وَالْمُتَّخِذَاتِ عَلَیْہَا الْمَسَاجِدَ وَالسُّرُجَ۔ (ترمذی ۳۲۰۔ ابوداؤد ۳۲۲۸)","Da'if","Musannaf Ibn Abi Shaybah 7631","","","كتاب الجمعة"
"7632","(۷۶۳۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنِ الْمَعْرُورِ بْنِ سُوَیْد ، قَالَ : خَرَجْنَا مَعَ عُمَرَ فِی حَجَّۃٍ حَجَّہَا فَقَرَأَ بِنَا فِی الْفَجْرِ : (أَلَمْ تَرَ کَیْفَ فَعَلَ رَبُّکَ بِأَصْحَابِ الْفِیلِ) ، وَ(لإِیلاَفِ قُرَیْشٍ) فَلَمَّا قَضَی حَجَّہُ وَرَجَعَ وَالنَّاسُ یَبْتَدِرُونَ ، فَقَالَ : مَا ہَذَا ؟ فَقَالُوا : مَسْجِدٌ صَلَّی فِیہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : ہَکَذَا ہَلَکَ أَہْلُ الْکِتَابِ اتَّخَذُوا آثَارَ أَنْبِیَائِہِمْ بِیَعًا مَنْ عَرَضَتْ لَہُ مِنْکُمْ فِیہِ الصَّلاَۃ فَلْیُصَلِّ وَمَنْ لَمْ تَعْرِضْ لَہُ مِنْکُمْ فِیہِ الصَّلاَۃ فَلاَ یُصَلِّ۔","Sahih","Musannaf Ibn Abi Shaybah 7632","","","كتاب الجمعة"
"7633","(۷۶۳۳) حَدَّثَنَا مُعَاذٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یُغَیِّرُوا آثَارَ الأَنْبِیَائِ۔","","Musannaf Ibn Abi Shaybah 7633","","","كتاب الجمعة"
"7634","(۷۶۳۴) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عَائِشَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لَعَنَ اللَّہُ أَقْوَامًا اتَّخَذُوا قُبُورَ أَنْبِیَائِہِمْ مَسَاجِدَ۔ (بخاری ۴۳۷۔ مسلم ۲۰ )","Sahih","Musannaf Ibn Abi Shaybah 7634","","","كتاب الجمعة"
"7635","(۷۶۳۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ أَنْ یُبْنَی عَلَی الْقَبْرِ مَسْجِدٌ۔","","Musannaf Ibn Abi Shaybah 7635","","","كتاب الجمعة"
"7636","(۷۶۳۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ قُدَامَۃَ ، عَنْ جَسْرَۃَ بِنْتِ دِجَاجَۃَ ، قَالَتْ : صَلَّیْتُ خَلْفَ أَبِی ذَرٍّ وَحْدِی مَا مَعِی امْرَأَۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 7636","","","كتاب الجمعة"
"7637","(۷۶۳۷) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : الْمَرْأَۃُ صَفٌّ۔","","Musannaf Ibn Abi Shaybah 7637","","","كتاب الجمعة"
"7638","(۷۶۳۸) حَدَّثَنَا وَکِیعٌ حَدَّثَنَا الْمُغِیرَۃُ بْنُ أَبِی الْحُرِّ الْکِنْدِیِّ ، عَنْ حُجْرِ بْنِ ، عَنْبَسٍ الْحَضْرَمِیِّ ، قَالَ : خَرَجْنَا مَعَ عَلِیٍّ إلَی النَّہْرَوَانِ حَتَّی إذَا کُنَّا بِبَابِلَ حَضَرَتْ صَلاَۃُ الْعَصْرِ قُلْنَا : الصَّلاَۃ فَسَکَتَ ، ثُمَّ قُلْنَا الصَّلاَۃ فَسَکَتَ ، فَلَمَّا خَرَجَ مِنْہَا صَلَّی ، ثُمَّ قَالَ : مَا کُنْتُ أُصَلِّی بِأَرْضٍ خُسِفَ بِہَا ثَلاَثَ مَرَّاتٍ۔","Hasan","Musannaf Ibn Abi Shaybah 7638","","","كتاب الجمعة"
"7639","(۷۶۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ شَرِیکٍ الْعَامِرِیِّ ، عَنْ عَبْدِ اللہِ أَبِی الْمُحِلِّ ، عَنْ عَلِیٍّ ، أَنَّہُ کَرِہَ الصَّلاَۃ فِی الْخُسُوفِ۔","Da'if","Musannaf Ibn Abi Shaybah 7639","","","كتاب الجمعة"
"7640","(۷۶۴۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ عَبْدِاللہِ بْنِ شَرِیکٍ، عَنِ ابْنِ أَبِی الْمُحِلِّ، أَنَّ عَلِیًّا مَرَّ بِجَانِبٍ مِنْ بَابِلَ فَلَمْ یُصَلِّ بِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 7640","","","كتاب الجمعة"
"7641","(۷۶۴۱) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عُمَیْرِ بْنِ ہَانِیئٍ ، قَالَ : شَہِدْتُ ابْنَ عُمَرَ وَالْحَجَّاجُ مُحَاصِرٌ ابْنَ الزُّبَیْرِ ، فَکَانَ مَنْزِلُ ابْنِ عُمَرَ بَیْنَہُمَا ، فَکَانَ رُبَّمَا حَضَرَ الصَّلاَۃ مَعَ ہَؤُلاَئِ وَرُبَّمَا حَضَرَ الصَّلاَۃ مَعَ ہَؤُلاَئِ۔","Sahih","Musannaf Ibn Abi Shaybah 7641","","","كتاب الجمعة"
"7642","(۷۶۴۲) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ الْحَسَنُ وَالْحُسَیْنُ یُصَلِّیَانِ خَلْفَ مَرْوَانَ، قَالَ : فَقِیلَ لَہُ : أَمَا کَانَ أَبُوک یُصَلِّی إذَا رَجَعَ إلَی الْبَیْتِ ، قَالَ : فَیَقُولُ لاَ وَاللَّہِ مَا کَانُوا یَزِیدُونَ عَلَی صَلاَۃِ الأَئِمَّۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 7642","","","كتاب الجمعة"
"7643","(۷۶۴۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یُصَلُّونَ خَلْفَ الأُمَرَائِ مَا کَانُوا۔","","Musannaf Ibn Abi Shaybah 7643","","","كتاب الجمعة"
"7644","(۷۶۴۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی حُرَّۃَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یَضُرُّ الْمُؤْمِنَ صَلاَتُہُ خَلْفَ الْمُنَافِقِ ، وَلاَ یَنْفَعُ الْمُنَافِقَ صَلاَۃُ الْمُؤْمِنِ خَلْفَہُ۔","","Musannaf Ibn Abi Shaybah 7644","","","كتاب الجمعة"
"7645","(۷۶۴۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ حَبِیبِ بْنِ جُرَیّ ، قَالَ : سَأَلْتُ أَبَا جَعْفَرٍ ، عَنِ الصَّلاَۃ خَلْفَ الأُمَرَائِ ، فَقَالَ : صَلِّ مَعَہُمْ۔","","Musannaf Ibn Abi Shaybah 7645","","","كتاب الجمعة"
"7646","(۷۶۴۶) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : سَأَلْتُ مَیْمُونًا عَنِ الصَّلاَۃ خَلْفَ الأُمَرَائِ ، فَقَالَ : صَلِّ مَعَہُمْ۔","","Musannaf Ibn Abi Shaybah 7646","","","كتاب الجمعة"
"7647","(۷۶۴۷) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : سَأَلْتُ مَیْمُونًا ، عَنْ رَجُلٍ فَذَکَرَ ، أَنَّہُ مِنَ الْخَوَارِجِ، فَقَالَ : أَنْتَ لاَ تُصَلِّی لَہُ إنَّمَا تُصَلِّی لِلَّہِ قَدْ کُنَّا نُصَلِّی خَلْفَ الْحَجَّاجِ وَکَانَ حَرُورِیًّا أَزْرَقِیًّا۔","","Musannaf Ibn Abi Shaybah 7647","","","كتاب الجمعة"
"7648","(۷۶۴۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ یُصَلِّی مَعَہُمْ إذَا أَخَّرُوا عَنِ الْوَقْتِ قَلِیلاً وَیَرَی أَنَّ مَأْثَمَ ذَلِکَ عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 7648","","","كتاب الجمعة"
"7649","(۷۶۴۹) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانَ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ رَجُلٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّہُ کَانَ یُصَلِّی مَعَ الْحَجَّاجِ عِنْدَ أَبْوَابِ کِنْدَۃَ وَخَرَجَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 7649","","","كتاب الجمعة"
"7650","(۷۶۵۰) حَدَّثَنَا وَکِیعٌ حَدَّثَنَا بِسَّام ، قَالَ : سَأَلْتُ أَبَا جَعْفَرٍ ، عَنِ الصَّلاَۃ مَعَ الأُمَرَائِ ، فَقَالَ : صَلِّ مَعَہُمْ فَإِنَّا نُصَلِّی مَعَہُمْ قَدْ کَانَ الْحَسَنُ وَالْحُسَیْنُ یَبْتَدِرَانِ الصَّلاَۃ خَلْفَ مَرْوَانَ ، قَالَ : قُلْتُ : إنَّ النَّاس یَزْعُمُونَ أَنَّ ذَلِکَ تَقِیَّۃٌ ، قَالَ : وَکَیْفَ إِنْ کَانَ الْحَسَنُ بْنُ عَلِیٍّ لیَسُبُّ مَرْوَانَ فِی وَجْہِہِ وَہُوَ عَلَی الْمِنْبَرِ حَتَّی یُوَلّی۔","Hasan","Musannaf Ibn Abi Shaybah 7650","","","كتاب الجمعة"
"7651","(۷۶۵۱) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنْ إبْرَاہِیمَ بْنِ أَبِی حَفْصَۃَ ، قَالَ : قُلْتُ لِعَلِیِّ بْنِ حُسَیْنٍ : إنَّ أَبَا حَمْزَۃَ الثُّمَالیَّ ، وَکَانَ فِیہِ غُلُوٌّ ، یَقُولُ : لاَ نُصَلِّی خَلْفَ الأَئِمَّۃِ ، وَلاَ نُنَاکِحُ إِلاَّ مَنْ یَرَی مِثْلَ رَأْینَا ، فَقَالَ عَلِیُّ بْنُ الحُسَیْنِ : بَلْ نُصَلِّی خَلْفَہُمْ وَنُنَاکِحُہُمْ بِالسُّنَّۃِ۔","","Musannaf Ibn Abi Shaybah 7651","","","كتاب الجمعة"
"7652","(۷۶۵۲) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، قَالَ : کَانُوا یُصَلُّونَ خَلْفَ الأُمَرَائِ وَیَحْتَسِبُونَ بِہَا۔","","Musannaf Ibn Abi Shaybah 7652","","","كتاب الجمعة"
"7653","(۷۶۵۳) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنْ عُقْبَۃَ الأَسَدِیِّ ، عَنْ یَزِیْدَ بْنِ أَبِی سُلَیْمَانَ ، أَنَّ أَبَا وَائِلٍ کَانَ یُجَمّعُ مَعَ الْمُخْتَارِ۔","","Musannaf Ibn Abi Shaybah 7653","","","كتاب الجمعة"
"7654","(۷۶۵۴) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنْ مُسْلِمٍ أَبِی فَرْوَۃَ ، قَالَ : رَأَیْتُ عَبْدَ الرَّحْمَن بْنَ أَبِی لَیْلَی وَأَشَارَ إلَی مُحَمَّدِ بْنِ سَعْدٍ وَالْحَجَّاجُ یَخْطُبُ أَنِ اسْکُتْ۔","","Musannaf Ibn Abi Shaybah 7654","","","كتاب الجمعة"
"7655","(۷۶۵۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنِ الأَعْمَشِ ، عَنِ الْقَاسِمِ بْنِ مُخَیْمِرَۃَ ، أَنَّہُ کَانَ یُصَلِّی خَلْفَ الْحَجَّاجِ۔","","Musannaf Ibn Abi Shaybah 7655","","","كتاب الجمعة"
"7656","(۷۶۵۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ عَمْرِو بْنِ یَحْیَی بْنِ عُمَارَۃَ الْمَازِنِیِّ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الأَرْضُ کُلُّہَا مَسْجِدٌ إِلاَّ الْمَقْبَرَۃَ وَالْحَمَّامَ۔ (ترمذی ۳۱۷۔ ابوداؤد ۹۶)","","Musannaf Ibn Abi Shaybah 7656","","","كتاب الجمعة"
"7657","(۷۶۵۷) حَدَّثَنَا حَفْصٌ ، عَنْ حُمَیْدٌ ، عَنْ أَنَسٍ ، قَالَ : رَآنِی عُمَرُ وَأَنَا أُصَلِّی إلَی قَبْرٍ فَجَعَلَ یَقُولُ یَا أَنَسُ الْقَبْرَ ، فَجَعَلْتُ أَرْفَعُ رَأْسِی أَنْظُرُ إلَی الْقَمَرِ ، فَقَالُوا : إنَّمَا ہُوَ یَقُولُ الْقَبْرَ۔","Sahih","Musannaf Ibn Abi Shaybah 7657","","","كتاب الجمعة"
"7658","(۷۶۵۸) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ حَدَّثَنَا حُمَیْدٌ ، عَنْ أَنَسٍ ، قَالَ : رَآنِی عُمَرُ وَأَنَا أُصَلِّی ، فَقَالَ : الْقَبْرُ أَمَامَک فَنَہَانِی۔","Sahih","Musannaf Ibn Abi Shaybah 7658","","","كتاب الجمعة"
"7659","(۷۶۵۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی ظَبْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : لاَ تُصَلِّ إلَی الْحُشِّ ، وَلاَ إلَی حَمَّام ، وَلاَ إلَی مَقْبَرَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 7659","","","كتاب الجمعة"
"7660","(۷۶۶۰) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنِ الْحَسَنِ الْعُرَنِیِّ ، قَالَ : الأَرْضُ کُلُّہَا مَسَاجِدُ إِلاَّ الْحُشَّ وَالْحَمَّامَ وَالْمَقْبَرَۃَ۔","","Musannaf Ibn Abi Shaybah 7660","","","كتاب الجمعة"
"7661","(۷۶۶۱) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِیہِ وَخَیْثَمَۃَ ، قَالاَ : لاَ یُصَلَّیَ إلَی حَائِطِ حَمَّامٍ ، وَلاَ وَسَطَ مَقْبَرَۃٍ۔","","Musannaf Ibn Abi Shaybah 7661","","","كتاب الجمعة"
"7662","(۷۶۶۲) حَدَّثَنَا وَکِیعٌ حَدَّثَنَا ہَمَّامٌ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، قَالَ : کَانَ یَکْرَہُ أَنْ یُبْنَی مَسْجِدٌ بَیْنَ الْقُبُورِ۔","Sahih","Musannaf Ibn Abi Shaybah 7662","","","كتاب الجمعة"
"7663","(۷۶۶۳) حَدَّثَنَا وَکِیعٌ ، أَخْبَرَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا إذَا خَرَجُوا مَعَ جِنَازَۃٍ فَحَضَرَتِ الصَّلاَۃ تَنَحَّوْا ، عَنِ الْقُبُورِ۔","","Musannaf Ibn Abi Shaybah 7663","","","كتاب الجمعة"
"7664","(۷۶۶۴) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ ثَلاَثَ أَبْیَاتٍ لِلْقِبْلَۃِ : الْحُشَّ وَالْمَقْبَرَۃَ وَالْحَمَّامَ۔","","Musannaf Ibn Abi Shaybah 7664","","","كتاب الجمعة"
"7665","(۷۶۶۵) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنْ بَکْرِ بْنِ قَیْسٍ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ کَرِہَ الصَّلاَۃ إلَی التَّنور ، وَقَالَ : بَیْتُ نَارٍ۔","","Musannaf Ibn Abi Shaybah 7665","","","كتاب الجمعة"
"7666","(۷۶۶۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَرِہَ الصَّلاَۃ بَیْنَ الْقُبُورِ۔","Hasan","Musannaf Ibn Abi Shaybah 7666","","","كتاب الجمعة"
"7667","(۷۶۶۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ تُدْرِکُہُ الصَّلاَۃ فِی الْمَقَابِرِ ، قَالَ : یُصَلِّی ، وَقَالَ ابْنُ سِیرِینَ : یَرْجِع۔","","Musannaf Ibn Abi Shaybah 7667","","","كتاب الجمعة"
"7668","(۷۶۶۸) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، أَنَّہُ کَانَ یَکْرَہُ الصَّلاَۃ فِی الْمَقَابِرِ۔","","Musannaf Ibn Abi Shaybah 7668","","","كتاب الجمعة"
"7669","(۷۶۶۹) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَنَسٍ ، أَنَّہُ کَرِہَ أَنْ یُصَلَّی عَلَی الْجِنَازَۃِ فِی الْمَقْبَرَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 7669","","","كتاب الجمعة"
"7670","(۷۶۷۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنِ الأَسْوَدِ بْنِ شَیْبَانَ ، قَالَ : رَأَیْتُُ مُوسَی بْنَ أَنَسٍ یُصَلِّی الْعَصْرَ فِی قَبْرِ أَخِیہِ النَّضِرِ بْنِ أَنَسٍ وَقَدْ ضُرِحَ لَہُ وَسَطَ الْقَبْرِ۔","","Musannaf Ibn Abi Shaybah 7670","","","كتاب الجمعة"
"7671","(۷۶۷۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ لَیْثٍ ، عَنِ الْحَکَمِ ، قَالَ : قَالَ عَلِیٌّ : لاَ تُصَلِّ تُجَاہَ حُشٍّ ، وَلاَ حَمَّامٍ ، وَلاَ مَقْبَرَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 7671","","","كتاب الجمعة"
"7672","(۷۶۷۲) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنِ أبی الْمُثَنَّی الْحِمْصِیِّ ، عَنِ أَبِی أُبَی ابن امرَأَۃ عُبَادَۃَ بْنِ الصَّامِتِ ،عَنْ عُبَادَۃَ بْنِ الصَّامِتِ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَنَّہَا سَتَکُونُ عَلَیْکُمْ أُمَرَائُ فَتَشْغَلُہُمْ أَشْیَائٌ عَنِ الصَّلاَۃ حَتَّی یُؤَخِّرُوہَا عَنْ وَقْتِہَا فَصَلُّوہَا لِوَقْتِہَا ، فَقَالَ رَجُلٌ : یَا رَسُولَ اللہِ إِنْ أَدْرَکْتُہَا مَعَہُمْ أُصَلِّی مَعَہُمْ ؟ قَالَ : نَعَمْ إِنْ شِئْتَ۔ (ابوداؤد ۴۳۴۔ احمد ۵/۳۱۵)","","Musannaf Ibn Abi Shaybah 7672","","","كتاب الجمعة"
"7673","(۷۶۷۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ وَعَلْقَمَۃَ ، قَالاَ : قَالَ عَبْدُ اللہِ : إِنَّہُ سَیَکُونُ عَلَیْکُمْ أُمَرَائُ یُؤَخِّرُونَ الصَّلاَۃ عَنْ وَقْتِہَا وَیَخْنُقُونَہَا إلَی شَرَقِ الْمَوْتَی فَإِذَا رَأَیْتُمُوہُمْ قَدْ فَعَلُوا ذَلِکَ فَصَلُّوا فِی بُیُوتِکُمْ ، ثُمَّ اجْعَلُوا صَلاَتَکُمْ سُبْحَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 7673","","","كتاب الجمعة"
"7674","(۷۶۷۴) حَدَّثَنَا وَکِیعٌ حَدَّثَنَا شُعْبَۃُ ، عَنْ أَبِی عِمْرَانَ الْجَوْنِیِّ ، عَنْ عَبْدِ اللہِ بْنِ الصَّامِتِ ، عَنْ أَبِی ذَرٍّ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَلُّوا الصَّلاَۃ لِوَقْتِہَا۔ (احمد ۵/۱۵۷۔ طیالسی ۴۴۹)","Sahih","Musannaf Ibn Abi Shaybah 7674","","","كتاب الجمعة"
"7675","(۷۶۷۵) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، قَالَ : رَأَیْتُ إبْرَاہِیمَ وَخَیْثَمَۃَ یُصَلِّیَانِ الظُّہْرَ وَالْعَصْرَ فِی بُیُوتِہِمَا ثُمَّ یَأْتِیَانِ الْحَجَّاجَ فَیُصَلِّیَانِ مَعَہُ۔","","Musannaf Ibn Abi Shaybah 7675","","","كتاب الجمعة"
"7676","(۷۶۷۶) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ قَالَ : کُنْتُ أَجْلِسُ مَعَ مَسْرُوقٍ ، وَأَبِی عُبَیْدَۃَ فِی الْمَسْجِدِ فِی زَمَنِ زِیَادٍ فَإِذَا دَخَلَ وَقْتُ الظُّہْرِ قَامَا فَصَلَّیَا ، ثُمَّ یَجْلِسَانِ حَتَّی إذَا أَذَّنَ الْمُؤَذِّنُ وَخَرَجَ الإِمَام قَامَا فَصَلَّیَا وَیَفْعَلاَنِہِ فِی الْعَصْرِ۔","","Musannaf Ibn Abi Shaybah 7676","","","كتاب الجمعة"
"7677","(۷۶۷۷) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنْ أَبِی ہَاشِمٍ ، أَنَّ الْحَجَّاجَ أَخَّرَ الصَّلاَۃ فَأَوْمَأَ أَبُو وَائِلٍ وَہُوَ جَالِسٌ۔","","Musannaf Ibn Abi Shaybah 7677","","","كتاب الجمعة"
"7678","(۷۶۷۸) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ ، عَنْ عَلِیٍّ الأَزْدِیِّ ، قَالَ : أَخَّرَ الْحَجَّاجُ الصَّلاَۃ بِعَرَفَۃَ فَصَلَّی ابْنُ عُمَرَ فِی رَحْلِہِ وَثَمَّ نَاسٌ وُقُفٌ ، قَالَ : فَأَمَرَ بِہِ الْحَجَّاجَ فَنُخِسَ بِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 7678","","","كتاب الجمعة"
"7679","(۷۶۷۹) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا الْمَسْعُودِیُّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ : کَانَ أَبُو عُبَیْدَۃَ یَنْتَظِرُ الْمَغْرِبَ فَإِذَا أَبْطؤوا بِہَا حَلَّ حَبْوَتَہُ وَخَرَجَ۔","","Musannaf Ibn Abi Shaybah 7679","","","كتاب الجمعة"
"7680","(۷۶۸۰) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا إسْرَائِیلُ ، عَنْ عَامِرِ بْنِ شَقِیقٍ ، قَالَ : کَانَ الْحَجَّاجُ یُؤَخِّرُ الصَّلاَۃ یَوْمَ الْجُمُعَۃِ ، فَکَانَ أَبُو وَائِلٍ یَأْمُرُنَا أَنْ نُصَلِّیَ فِی بُیُوتِنَا ، ثُمَّ نَأْتِیَ الْمَسْجِدَ۔","","Musannaf Ibn Abi Shaybah 7680","","","كتاب الجمعة"
"7681","(۷۶۸۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی عِمْرَانَ الْجَوْنِیِّ ، عَنْ عَبْدِ اللہِ بْنِ الصَّامِتِ ، عَنْ أَبِی ذَرٍّ ، قَالَ: إنَّ خَلِیلِی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَوْصَانِی أَنْ أُصَلِّیَ الصَّلاَۃ لِوَقْتِہَا ، فَإِنْ أَدْرَکْتَ الْقَوْمَ قَدْ صَلَّوْا کُنْتَ قَدْ أَحْرَزْتَ صَلاَتَکَ وَالأَ کَانَتْ نَافِلَۃً۔ (مسلم ۴۴۸)","Sahih","Musannaf Ibn Abi Shaybah 7681","","","كتاب الجمعة"
"7682","(۷۶۸۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ مُحَمَّدِ بْنِ أَبِی إسْمَاعِیلَ ، قَالَ : رَأَیْتُ عَطَائً وَسَعِیدَ بْنَ جُبَیْرٍ وَأَخَّرَ الْوَلِیدُ الصَّلاَۃ فَأَوْمَآ فِی وَقْتِ الصَّلاَۃ ، ثُمَّ قَعَدَا حَتَّی صَلَّیَا مَعَہُ تِلْکَ الصَّلاَۃ رَأَیْتُہُمَا فَعَلاَ ذَلِکَ مِرَارًا۔","","Musannaf Ibn Abi Shaybah 7682","","","كتاب الجمعة"
"7683","(۷۶۸۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عَائِشَۃَ ، أَنَّ نَبِیَّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَکْرَہُ الصَّلاَۃ فِی مَشَاعِرِہِنَّ۔ (ابوداؤد ۳۷۱۔ ترمذی ۶۰۰)","Da'if","Musannaf Ibn Abi Shaybah 7683","","","كتاب الجمعة"
"7684","(۷۶۸۴) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ عَمْرِو بْنِ سَعِیدٍ ، عَنْ مُحَمَّدٍ ، قَالَ : لاَ تُصَلُّوا فِی شُعُرِ النِّسَائِ۔nقَالَ أَبُو بَکْر : یَعْنِی ثِیَابَہُنَّ۔","","Musannaf Ibn Abi Shaybah 7684","","","كتاب الجمعة"
"7685","(۷۶۸۵) حَدَّثَنَا غُنْدَرٌ ، عَنِ الأَشْعَثِ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ أَنْ یُصَلِّیَ الرَّجُلُ فِی مَلاَحِفِ النِّسَائِ۔","","Musannaf Ibn Abi Shaybah 7685","","","كتاب الجمعة"
"7686","(۷۶۸۶) حَدَّثَنَا یَحْیَی بْنُ یَمَانَ ، عَنْ حَنْظَلَۃَ ، عَنْ طَاوُوسٍ ، قَالَ : لاَ بَأْسَ أَنْ یُصَلِّیَ الرَّجُلُ فِی ثَوْبِ الْمَرْأَۃِ۔","","Musannaf Ibn Abi Shaybah 7686","","","كتاب الجمعة"
"7687","(۷۶۸۷) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عُمَیْرِ بْنِ یَرِیمَ أَبِی ہِلاَلٍ ، قَالَ: سَمِعْتُ ابْنَ العَبَّاسٍ یَقُولُ: لاَ یَقُولُ انْصَرَفْنَا مِنَ الصَّلاَۃ فَإِنَّ قَوْمًا انْصَرَفُوا فَصَرَفَ اللَّہُ قُلُوبَہُمْ وَلَکِنْ قُولُوا : قَدْ قُضِیَتِ الصَّلاَۃ۔","Da'if","Musannaf Ibn Abi Shaybah 7687","","","كتاب الجمعة"
"7688","(۷۶۸۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ لاَ یَرَی بِذَلِکَ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 7688","","","كتاب الجمعة"
"7689","(۷۶۸۹) حَدَّثَنَا عَفَّانُ ، حَدَّثَنَا سَعِیدُ بْنُ زَیْدٍ ، قَالَ : حدَّثَنَا الزُّبَیْرُ بْنُ الْخِرِّیتِ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عُمَرَ قَالَ: لاَ یُقَالُ : انْصَرَفْنَا مِنَ الصَّلاَۃ وَلَکِنْ قَدْ قُضِیَتِ الصَّلاَۃ۔","Hasan","Musannaf Ibn Abi Shaybah 7689","","","كتاب الجمعة"
"7690","(۷۶۹۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَتِ امْرَأَۃٌ لِعُمَرَ تَشْہَدُ صَلاَۃَ الصُّبْحِ وَالْعِشَائِ فِی جَمَاعَۃٍ فِی الْمَسْجِدِ فَقِیلَ لَہَا : لِمَ تَخْرُجِینَ وَقَدْ تَعْلَمِینَ أَنَّ عُمَرَ یَکْرَہُ ذَلِکَ وَیَغَارُ ؟ قَالَتْ : فَمَا یَمْنَعُہُ أَنْ یَنْہَانِی ، قَالُوا : یَمْنَعُہُ قَوْلُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَمْنَعُوا إمَائَ اللہِ مَسَاجِدَ اللہِ۔ (بخاری ۹۰۰۔ احمد ۲/۷)","Sahih","Musannaf Ibn Abi Shaybah 7690","","","كتاب الجمعة"
"7691","(۷۶۹۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَمْنَعُوا إمَائَ اللہِ مَسَاجِدَ اللہِ وَلْیَخْرُجْنَ إذَا خَرَجْنَ تَفِلاَتٍ۔ (ابوداؤد ۵۶۶۔ احمد ۴۳۸)","Hasan","Musannaf Ibn Abi Shaybah 7691","","","كتاب الجمعة"
"7692","(۷۶۹۲) حَدَّثَنَا أَبُو خَالِدٍ وعَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَمْرَۃَ ، عَنْ عَائِشَۃَ قَالَتْ : لَوْ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَدْرَکَ مَا أَحْدَثْنَ النِّسَائُ الیَوْم لَمَنَعَہُنَّ الْمَسَاجِدَ کَمَا مُنِعْنَہُ نِسَائُ بَنِی إسْرَائِیلَ ، قَالَتْ : قُلْتُ : وَمُنِعْنَہُ ؟ قَالَتْ : نَعَمْ۔ (مسلم ۱۴۴۔ مؤطا ۱۵)","Sahih","Musannaf Ibn Abi Shaybah 7692","","","كتاب الجمعة"
"7693","(۷۶۹۳) حَدَّثَنَا عَبْدَۃُ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَمْنَعُوا إمَائَ اللہِ مَسَاجِدَ اللہِ۔ (بخاری ۹۰۰۔ ابوداؤد ۵۶۷)","Sahih","Musannaf Ibn Abi Shaybah 7693","","","كتاب الجمعة"
"7694","(۷۶۹۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ شبَاکٍ ، عَنْ إبْرَاہِیمَ قَالَ : کَانَتِ امْرَأَۃُ أَبِی مَسْعُودٍ تُصَلِّی الْعِشَائَ الآخِرَۃَ فِی مَسْجِدِ الْجَمَاعَۃِ۔","","Musannaf Ibn Abi Shaybah 7694","","","كتاب الجمعة"
"7695","(۷۶۹۵) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا حَنْظَلَۃُ الْجُمَحِیُّ ، عَنْ سَالِمٍ بنِ عَبْدِ اللہِ ، عَنِ ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا اسْتَأْذَنَکُمْ نِسَاؤُکُمْ إلَی الْمَسَاجِدِ فَأْذَنُوا لَہُنَّ۔ (بخاری ۸۶۵۔ مسلم ۱۳۷)","Sahih","Musannaf Ibn Abi Shaybah 7695","","","كتاب الجمعة"
"7696","(۷۶۹۶) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا مِسْعَرٌ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، قَالَ : قَالَ عَبْدُ اللہِ : مَا صَلَّتِ امْرَأَۃٌ صَلاَۃً قَطُّ أَفْضَلَ مِنْ صَلاَۃٍ تُصَلِّیہَا فِی بَیْتِہَا إِلاَّ أَنْ تُصَلِّیَ عِنْدَ الْمَسْجِدِ الْحَرَامِ ، إِلاَّ عَجُوزٌ فِی مَنْقَلَیْہَا ، یَعْنِی خُفَّیْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 7696","","","كتاب الجمعة"
"7697","(۷۶۹۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا إسْرَائِیلُ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنْ عَبْدِ اللہِ بْنِ عَبَّاسٍ ، أَنَّ امْرَأَۃً سَأَلَتْہُ عَنِ الصَّلاَۃ فِی الْمَسْجِدِ یَوْمَ الْجُمُعَۃِ ؟ فَقَالَ : صَلاَتُکِ فِی مَخْدَعِکِ أَفْضَلُ مِنْ صَلاَتِکِ فِی بَیْتِکِ ، وَصَلاَتُکِ فِی بَیْتِکِ أفْضَلُ مِنْ صَلاَتِکِ فِی حُجْرَتِکِ ، وَصَلاَتُکِ فِی حُجْرَتِکِ أَفْضَلُ مِنْ صَلاَتِکَ فِی مَسْجِدِ قَوْمِک۔","Da'if","Musannaf Ibn Abi Shaybah 7697","","","كتاب الجمعة"
"7698","(۷۶۹۸) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، عَنْ أَبِی الأَحْوَص ، قَالَ : قَالَ عَبْدُ اللہِ : الْمَرْأَۃُ عَوْرَۃٌ وَأَقْرَبُ مَا تَکُونُ مِنْ رَبِّہَا إذَا کَانَتْ فِی قَعْرِ بَیْتِہَا فَإِذَا خَرَجَتِ اسْتَشْرَفَہَا الشَّیْطَانُ۔","Sahih","Musannaf Ibn Abi Shaybah 7698","","","كتاب الجمعة"
"7699","(۷۶۹۹) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنْ أَبِی فَرْوَۃَ الْہَمْدَانِیِّ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، قَالَ : رَأَیْتُ ابْنَ مَسْعُودٍ یَحْصِبُ النِّسَائَ یُخْرِجُہُنَّ مِنَ الْمَسْجِدِ یَوْمَ الْجُمُعَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 7699","","","كتاب الجمعة"
"7700","(۷۷۰۰) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا إیَاسُ بْنُ دَغْفَلٍ ، قَالَ : سُئِلَ الْحَسَنُ عَنِ امْرَأَۃٍ جَعَلَتْ عَلَیْہَا إِنْ أُخْرِجَ زَوْجُہَا مِنَ السِّجْنِ أَنْ تُصَلِّیَ فِی کُلِّ مَسْجِدٍ تُجَمَّعُ فِیہِ الصَّلاَۃ بِالْبَصْرَۃِ رَکْعَتَیْنِ ، فَقَالَ الْحَسَنُ : تُصَلِّی فِی مَسْجِدِ قَوْمِہَا فَإِنَّہَا لاَ تُطِیقُ ذَلِکَ لَوْ أَدْرَکَہَا عُمَرُ بْنُ الْخَطَّابِ لأَوْجَعَ رَأْسَہَا۔","","Musannaf Ibn Abi Shaybah 7700","","","كتاب الجمعة"
"7701","(۷۷۰۱) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ سَعِیدِ بْنِ مَسْرُوقٍ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، قَالَ : سَمِعْتُ رَبَّ ہَذِہِ الدَّارِ، یَعْنِی ابْنَ مَسْعُودٍ حَلَفَ فَبَالَغَ فِی الْیَمِینِ مَا صَلَّتِ امْرَأَۃٌ صَلاَۃً أَحَبَّ إلَی اللہِ مِنْ صَلاَۃٍ فِی بَیْتِہَا إِلاَّ فِی حَجٍّ أَوْ عُمْرَۃٍ ، إِلاَّ امْرَأَۃٌ قَدْ أَیِسَتْ مِنَ الْبُعُولَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 7701","","","كتاب الجمعة"
"7702","(۷۷۰۲) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، حَدَّثَنَا ابْنُ لَہِیعَۃَ ، حَدَّثَنِی عَبْدُ الْحَمِیدِ بْنُ الْمُنْذِرِ السَّاعِی ، عَنْ أَبِیہِ ، عَنْ جَدَّتِہِ أُمِّ حُمَیْدٍ ، قَالَتْ : قُلْتُ : یَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَمْنَعُنَا أَزْوَاجُنَا أَنْ نُصَلِّیَ مَعَک وَنُحِبُّ الصَّلاَۃ مَعَک ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَلاَتُکُنَّ فِی بُیُوتِکُنَّ أَفْضَلُ مِنْ صَلاَتِکُنَّ فِی حُجَرِکُنَّ ، وَصَلاَتُکُنَّ فِی حُجَرِکُنَّ أَفْضَلُ مِنْ صَلاَتِکُنَّ فِی الْجَمَاعَۃِ۔ (طبرانی ۳۵۶۔ احمد ۶/۳۷۱)","Da'if","Musannaf Ibn Abi Shaybah 7702","","","كتاب الجمعة"
"7703","(۷۷۰۳) حَدَّثَنَا حَفْصٌ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ: کَانَ لإِبْرَاہِیمَ ثَلاَثُ نِسْوَۃٍ فَلَمْ یَکُنْ یَدَعُہُنَّ یَخْرُجْنَ إلَی جُمُعَۃٍ ، وَلاَ جَمَاعَۃٍ۔","","Musannaf Ibn Abi Shaybah 7703","","","كتاب الجمعة"
"7704","(۷۷۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خَیْرُ صُفُوفِ النِّسَائِ آخِرُہَا وَشَرُّہَا مُقَدَّمُہَا۔","Da'if","Musannaf Ibn Abi Shaybah 7704","","","كتاب الجمعة"
"7705","(۷۷۰۵) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ یَقُولُ : خَیْرُ صُفُوفِ النِّسَائِ الْمُؤَخَّرُ۔","","Musannaf Ibn Abi Shaybah 7705","","","كتاب الجمعة"
"7706","(۷۷۰۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ یَحْیَی بْنِ أَیُّوبَ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : خَیْرُ صُفُوفِ النِّسَائِ آخِرُہَا وَشَرُّہَا أَوَّلُہَا۔","Hasan","Musannaf Ibn Abi Shaybah 7706","","","كتاب الجمعة"
"7707","(۷۷۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ یُقَالُ : خَیْرُ صُفُوفِ النِّسَائِ مُؤَخَّرُہَا وَشَرُّہَا مُقَدَّمُہَا۔","","Musannaf Ibn Abi Shaybah 7707","","","كتاب الجمعة"
"7708","(۷۷۰۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ بِمِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 7708","","","كتاب الجمعة"
"7709","(۷۷۰۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، قَالَ : حُدِّثْتُ أَنَّ ابْنَ مَسْعُودٍ کَانَ یُقَدِّمُ الْعَجَائِزَ فِی الصَّفِّ الأَوَّلِ مِنْ صُفُوفِ النِّسَائِ ، وَیُؤَخِّرُ الشَّوَابَّ إلَی الصَّفِّ الْمُؤَخَّرِ۔","Da'if","Musannaf Ibn Abi Shaybah 7709","","","كتاب الجمعة"
"7710","(۷۷۱۰) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، حَدَّثَنَا زُہَیْرُ بْنُ مُحَمَّدٍ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، أَنَّہُ سَمِعَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : خَیْرُ صُفُوفِ النِّسَائِ الْمُؤَخَّرُ وَشَرُّہَا الْمُقَدَّمُ۔","Da'if","Musannaf Ibn Abi Shaybah 7710","","","كتاب الجمعة"
"7711","(۷۷۱۱) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ سُہَیْلٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خَیْرُ صُفُوفِ الرِّجَالِ مُقَدَّمُہَا وَشَرُّہَا مُؤَخَّرُہَا وَخَیْرُ صُفُوفِ النِّسَائِ آخِرُہَا وَشَرُّہَا مُقَدَّمُہَا۔ (ترمذی ۲۲۴۔ ابوداؤد ۶۷۸)","Sahih","Musannaf Ibn Abi Shaybah 7711","","","كتاب الجمعة"
"7712","(۷۷۱۲) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، حَدَّثَنَا سُفْیَانُ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنِ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خَیْرُ صُفُوفِ الرِّجَالِ أَوَّلُہَا ، وَشَرُّ صُفُوفِ الرِّجَالِ آخِرُہَا ، وَخَیْرُ صُفُوفِ النِّسَائِ آخِرُہَا ، وَشَرُّ صُفُوفِ النِّسَائِ أَوَّلُہَا۔ (حمیدی ۱۰۰۱۔ احمد ۲/۳۴۰)","Hasan","Musannaf Ibn Abi Shaybah 7712","","","كتاب الجمعة"
"7713","(۷۷۱۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا ثَابِتُ بْنُ أَسْلَمَ ، قَالَ : حَدَّثَنَا صِلَۃ بْنُ أَشْیَمَ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : مَنْ صَلَّی رَکْعَتَیْنِ لَمْ یُحَدِّثْ نَفْسَہُ فِیہِمَا بِشَیْئٍ مِنَ الدُّنْیَا لَمْ یَسْأَلِ اللَّہَ شَیْئًا إِلاَّ أَعْطَاہُ إیَّاہُ۔","","Musannaf Ibn Abi Shaybah 7713","","","كتاب الجمعة"
"7714","(۷۷۱۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، حَدَّثَنَا لَیْثٌ ، عَنْ عِیسَی ، عَنْ زَیْدِ بْنِ أَرْطَاۃَ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا أُوتِیَ عَبْدٌ فِی ہَذِہِ الدُّنْیَا خَیْرٌ لَہُ مِنْ أَنْ یُؤْذَنَ لَہُ فِی رَکْعَتَیْنِ فَیُصَلِّیَہُمَا۔ (ترمذی ۲۹۱۱۔ احمد ۵/۲۶۸)","Da'if","Musannaf Ibn Abi Shaybah 7714","","","كتاب الجمعة"
"7715","(۷۷۱۵) حَدَّثَنَا حَفْصٌ ، عَنْ أَبِی مَالِکٍ ، عَنْ أَبِی حَازِمٍ ، قَالَ : مَرَرْت مَعَ أَبِی ہُرَیْرَۃَ عَلَی قَبْرٍ دُفِنَ حَدِیثًا ، فَقَالَ: لَرَکْعَتَانِ خَفِیفَتَانِ مِمَّا تَحْتَقِرُونَ زَادَہُمَا ہَذا : أَحَبُّ إلَیْہِ مِنْ بَقِیَّۃِ دُنْیَاکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 7715","","","كتاب الجمعة"
"7716","(۷۷۱۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : اشْتَرَی رَجُلٌ حَائِطًا مِنَ الْمَدِینَۃِ فَرَبِحَ فِیہِ مِئَۃ نَخْلَۃٍ کَامِلَۃٍ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِلاَّ أُخْبِرُکُمْ بِأَفْضَلَ مِنْ ہَذَا ؟ رَجُلٌ تَوَضَّأَ فَأَحْسَنَ الْوُضُوئَ ، ثُمَّ صَلَّی رَکْعَتَیْنِ فِی غَارٍ ، أَوْ سَفْحِ جَبَلٍ أَفْضَلُ رِبْحًا مِنْ ہَذَا۔","","Musannaf Ibn Abi Shaybah 7716","","","كتاب الجمعة"
"7717","(۷۷۱۷) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا بَعْضُ أَصْحَابِنَا ، عَنِ الْجُرَیرِیِّ ، عَنْ أَبِی الْوَرْدِ ، عَنْ کَعْبٍ : إنَّ فِی ہَذَا لَبَلاَغًا لِقَوْمٍ عَابِدِینَ ، قَالَ : الصَّلَوَاتُ الْخَمْسُ۔","","Musannaf Ibn Abi Shaybah 7717","","","كتاب الجمعة"
"7718","(۷۷۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا ابْنُ أَبِی خَالِدٍ وَمِسْعَرٌ وَالْبَخْتَرِیُّ بْنُ الْمُخْتَارِ ، سَمِعُوہُ مِنْ أَبِی بَکْرِ بْنِ عُمَارَۃَ بْنِ رُوَیْبَۃَ الثَّقَفِیِّ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : لَنْ یَلِجَ النَّارَ مَنْ صَلَّی قَبْلَ طُلُوعِ ألشَّمْسِ وَقَبْلَ غُرُوبِہَا ، فَقَالَ لَہُ رَجُلٌ مِنْ أَہْلِ الْبَصْرَۃِ : أَنْتَ سَمِعْتَہُ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : نَعَمْ أَشْہَدُ أَنِّی سَمِعْتُہُ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَمِعَتْہُ أُذُنَایَ وَوَعَاہُ قَلْبِی۔ (مسلم ۲۱۳۔ احمد ۴/۲۶۱)","Sahih","Musannaf Ibn Abi Shaybah 7718","","","كتاب الجمعة"
"7719","(۷۷۱۹) حَدَّثَنَا شَرِیکٌ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، قَالَ : کُنَّا نَعْرِضُ الْمَصَاحِفَ عَلَی عَبْدِ اللہِ ، فَسَأَلَہُ رَجُلٌ مِنْ ثَقِیفٍ ، فَقَالَ : یَا أَبَا عَبْدِ الرَّحْمَنِ أَیُّ الأَعْمَالِ أَفْضَلُ ؟ قَالَ : الصَّلاَۃ ، وَمَنْ لَمْ یُصَلِّ فَلاَ دِینَ لَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 7719","","","كتاب الجمعة"
"7720","(۷۷۲۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، عَنْ شَقِیقٍ ، عَنْ مَسْرُوقٍ ، قَالَ : مَا مِنْ حَالٍ أَحْرَی أَنْ یُسْتَجَابَ لِلْعَبْدِ فِیہِ إِلاَّ أَنْ یَکُونَ فِی سَبِیلِ اللہِ مِنْ أَنْ یَکُونَ عَافِرًا وَجْہَہُ سَاجِدًا۔","","Musannaf Ibn Abi Shaybah 7720","","","كتاب الجمعة"
"7721","(۷۷۲۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، عَنْ مَالِکِ بْنِ الْحَارِثِ ، قَالَ حُدِّثْتُ أَنَّ مَسْرُوقًا کَانَ یَقُولُ : مَنْ حَافَظَ عَلَی ہَؤُلاَئِ الصَّلَوَاتِ لَمْ یُکْتَبْ مِنَ الْغَافِلِینَ فَإِنَّ فِی إفْرَاطِہِنَّ الْہَلَکَۃَ۔","","Musannaf Ibn Abi Shaybah 7721","","","كتاب الجمعة"
"7722","(۷۷۲۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی إسْمَاعِیلَ ، عَنْ مَعْقِلٍ الْخَثْعَمِیِّ ، عَنْ عَلِیٍّ قَالَ : مَنْ لَمْ یُصَلِّ فَقَدْ کَفَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 7722","","","كتاب الجمعة"
"7723","(۷۷۲۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عِمْرَانَ بْنِ سُلَیْمَانَ ، عَنْ عَلِیِّ بْنِ ثَابِتٍ ، قَالَ : قرْبَانُ الْمُتَّقِینَ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7723","","","كتاب الجمعة"
"7724","(۷۷۲۴) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا مِسْعَرٌ وَسُفْیَان ، عَنْ عُثْمَانَ بْنِ الْمُغِیرَۃِ الثَّقَفِیِّ ، عَنْ عَلِیِّ بْنِ رَبِیعَۃَ الْوَالِبِیِّ ، عَنْ أَسْمَائَ بْنِ الْحَکَمِ الْفَزَارِیِّ ، عَنْ عَلِیٍّ قَالَ : کُنْتُُ إذَا سَمِعْتُ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَدِیثًا نَفَعَنِی اللَّہُ بِمَا شَائَ مِنْہُ فَإِذَا حَدَّثَنِی عَنْہُ غَیْرِی اسْتَحْلَفْتُہُ فَإِذَا حَلَفَ لِی صَدَّقْتُہُ ، وَإِنَّ أَبَا بَکْرٍ حَدَّثَنِی وَصَدَقَ أَبُو بَکْرٍ ، أَنَّہُ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : مَا مِنْ رَجُلٍ یُذْنِبُ ذَنْبًا فَیَتَوَضَّأُ فَیُحْسِنُ الْوُضُوئَ ، قَالَ سُفْیَانُ : ثُمَّ یُصَلِّی رَکْعَتَیْنِ ، قَالَ مِسْعَرٌ : ثُمَّ یُصَلِّی فَیَسْتَغْفِرُ اللَّہَ إِلاَّ غَفَرَ لَہُ۔ (ترمذی ۳۰۰۶۔ ابوداؤد ۱۵۱۶)","Hasan","Musannaf Ibn Abi Shaybah 7724","","","كتاب الجمعة"
"7725","(۷۷۲۵) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا الأَعْمَش ، عَنْ سُلَیْمَانَ بْنِ مَیْسَرَۃَ وَالْمُغِیرَۃِ بْنِ شِبْلٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، عَنْ سَلْمَانَ ، قَالَ : الصَّلَوَاتُ الْخَمْسُ کَفَّارَاتٌ لِمَا بَیْنَہُنَّ مَا اجْتُنِبَتِ المَقْتل۔","Sahih","Musannaf Ibn Abi Shaybah 7725","","","كتاب الجمعة"
"7726","(۷۷۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ووَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی وَائِلٍ قَالَ : قَالَ عَبْدُ اللہِ : الصَّلَوَاتُ الْحَقَائِقُ کَفَّارَاتٌ لِمَا بَیْنَہُنَّ مَا اجْتُنِبَتِ الْکَبَائِرُ۔ (طبرانی ۸۷۴۰)","Sahih","Musannaf Ibn Abi Shaybah 7726","","","كتاب الجمعة"
"7727","(۷۷۲۷) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ حُمْرَانَ بْنِ أَبَانَ ، عَنْ عُثْمَانَ بْنِ عَفَّانَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا مِنْ رَجُلٍ یَتَوَضَّأُ فَیُحْسِنُ الْوُضُوئَ ، ثُمَّ یُصَلِّی إِلاَّ غُفِرَ لَہُ مَا بَیْنَہُ وَبَیْنَ الصَّلاَۃ الأُخْرَی۔ (مسلم ۲۰۶)","Sahih","Musannaf Ibn Abi Shaybah 7727","","","كتاب الجمعة"
"7728","(۷۷۲۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، أَخْبَرَنَا عَوْفٌ وَالْجُرَیرِیُّ ، عَنْ قَسَامَۃَ بْنِ زُہَیْرٍ ، عَنْ أَبِی مُوسَی ، قَالَ : مَثَلُ الصَّلَوَاتِ الْخَمْسِ مَثَلُ نَہْرٍ جَارٍ عَلَی بَابِ أَحَدِکُمْ یَغْتَسِلُ مِنْہُ کُلَّ یَوْمٍ خَمْسَ مَرَّاتٍ ، فَمَاذَا یُبْقِینَ بَعْدُ عَلَیْہِ مِنْ دَرَنِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 7728","","","كتاب الجمعة"
"7729","(۷۷۲۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، قَالَ : سَمِعْتُ إبْرَاہِیمَ بْنَ یُحَنَّسَ ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ : مَثَلُ الصَّلَوَاتِ الْخَمْسِ مَثَلُ رَجُلٍ عَلَی بَابِہِ نَہْرٌ یَغْتَسِلُ مِنْہُ کُلَّ یَوْمٍ خَمْسَ مَرَّاتٍ فَمَاذَا یُبْقِی ذَلِکَ مِنْ دَرَنِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 7729","","","كتاب الجمعة"
"7730","(۷۷۳۰) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا مِسْعَرٌ ، عَنْ أَبِی صَخْرَۃَ جَامِعِ بْنِ شَدَّادٍ ، قَالَ : سَمِعْتُ حُمْرَانَ بْنَ أَبَانَ مَوْلَی عُثْمَانَ یَقُولُ : کُنْتُ أَضَعُ لِعُثْمَانَ طَہُورَہُ فَمَا أَتَی عَلَیْہِ یَوْمٌ إِلاَّ وَہُوَ یُفِیضُ مِنْہُ عَلَیْہِ نُطْفَۃً مِنْ مَائٍ ، فَقَالَ عُثْمَانُ : حدَّثَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عِنْدَ انْصِرَافِنَا مِنْ صَلاَتِنَا ہَذِہِ ، فَقَالَ مِسْعَرٌ : أُرَاہُ قَالَ : الْعَصْرَ ، فَقَالَ : مَا أَدْرِی أُحَدِّثُکُمْ ، أَوْ أَسْکُتُ ، قَالَ : قُلْنَا یَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِنْ کَانَ خَیْرًا فَحَدِّثْنَا ، وَإِنْ کَانَ غَیْرَ ذَلِکَ فَاللَّہُ وَرَسُولُہُ أَعْلَمُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا مِنْ رَجُلٍ یَتَوَضَّأُ فَیُحْسِنُ الْوُضُوئَ ، ثُمَّ یُصَلِّی إِلاَّ غُفِرَ لَہُ مَا بَیْنَہُ وَبَیْنَ الصَّلاَۃ الأُخْرَی۔","Sahih","Musannaf Ibn Abi Shaybah 7730","","","كتاب الجمعة"
"7731","(۷۷۳۱) حَدَّثَنَا وَکِیعٌ، حَدَّثَنَا الأَوْزَاعِیُّ، عَنْ عَبْدِالْوَاحِدِ بْنِ قَیْسٍ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ: تَکْفِیرُ کُلَّ لِحَائٍ رَکْعَتَانِ۔","","Musannaf Ibn Abi Shaybah 7731","","","كتاب الجمعة"
"7732","(۷۷۳۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَثَلُ الصَّلَوَاتِ الْخَمْسِ کَمَثَلِ نَہْرٍ جَارٍ غَمْرٍ عَلَی بَابِ أَحَدِکُمْ یَغْتَسِلُ مِنْہُ کُلَّ یَوْمٍ خَمْسَ مَرَّاتٍ، قَالَ : فَقَالَ الْحَسَنُ : فَمَا یُبْقِی ذَلِکَ مِنَ الدَّرَنِ ؟۔ (مسلم ۲۸۴۔ بیہقی ۶۳)","Hasan","Musannaf Ibn Abi Shaybah 7732","","","كتاب الجمعة"
"7733","(۷۷۳۳) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّمَا مَثَلُ الصَّلَوَاتِ الْخَمْسِ کَمَثَلِ نَہْرٍ جَارٍ عَلَی بَابِ أَحَدِکُمْ یَغْتَسِلُ مِنْہُ کُلَّ یَوْمٍ خَمْسَ مَرَّاتٍ ، فَمَا یُبْقِی مِنْ دَرَنِہِ؟۔ (احمد ۲/۴۴۱)","Sahih","Musannaf Ibn Abi Shaybah 7733","","","كتاب الجمعة"
"7734","(۷۷۳۴) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا مِسْعَرٌ ، وَشُعْبَۃُ ، عَنْ سَعِیدِ بْنِ أَبِی بُرْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ: مَا صَلَّیْتُ صَلاَۃً إِلاَّ وَأَنَا أَرْجُو أَنْ تَکُونَ کَفَّارَۃً لِمَا أَمَامَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 7734","","","كتاب الجمعة"
"7735","(۷۷۳۵) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا مِسْعَرٌ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : قَالَ عَبْدُ اللہِ : یَحْتَرِقُونَ فَإِذَا صَلَّوُا الظُّہْرَ غَسَلَتْ ، ثُمَّ یَحْتَرِقُونَ فَإِذَا صَلَّوُا الْعَصْرَ غَسَلَتْ ، ثُمَّ یَحْتَرِقُونَ فَإِذَا صَلَّوُا الْمَغْرِبَ غَسَلَتْ حَتَّی ذَکَرَ الصَّلَوَاتِ کُلَّہُنَّ۔","","Musannaf Ibn Abi Shaybah 7735","","","كتاب الجمعة"
"7736","(۷۷۳۶) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا الْمَسْعُودِیُّ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ لَقِیطِ بْنِ قَبِیصَۃَ الْجَعْفَرِیِّ رَجُلٍ مِنْ أَصْحَابِ عَبْدِ اللہِ قَالَ : کَانَ عَبْدُ اللہِ فَذَکَرَ مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 7736","","","كتاب الجمعة"
"7737","(۷۷۳۷) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا الأَعْمَش ، عَنْ أَبِی سُفْیَانَ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَثَلُ الصَّلَوَاتِ الْخَمْسِ کَمَثَلِ نَہْرٍ جَارٍ عَلَی بَابِ أَحَدِکُمْ یَغْتَسِلُ مِنْہُ کُلَّ یَوْمٍ خَمْسَ مَرَّاتٍ، فَمَاذَا یُبْقِینَ مِنَ الدَّرَنِ؟۔","","Musannaf Ibn Abi Shaybah 7737","","","كتاب الجمعة"
"7738","(۷۷۳۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ، حَدَّثَنَا ہَانِیئُ بْنُ عُثْمَانَ یُحَدِّثُ عَنْ أُمِّہِ حُمَیْضَۃَ ابْنَۃِ یَاسِرٍ، عَنْ جَدَّتِہَا یُسَیرَۃَ، وَکَانَتْ إحْدَی الْمُہَاجِرَاتِ ، قَالَتْ : قَالَ لَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عَلَیْکُنَّ بَِالتَّہْلِیلِ والتَّسْبِیحِ وَالتَّکْبِیرِ وَاعْقِدْنَ بِالأَنَامِلِ ، فَإِنَّہُنَّ یَأْتِینَ یَوْمَ الْقِیَامَۃِ مَسْئُولاَتٍ مُسْتَنْطَقَاتٍ ، وَلاَ تَغْفُلْنَ فَتَنْسَیْنَ الرَّحْمَۃَ۔ (ترمذی ۳۵۸۳۔ احمد ۶/۳۷۰)","Da'if","Musannaf Ibn Abi Shaybah 7738","","","كتاب الجمعة"
"7739","(۷۷۳۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی تَمِیمَۃَ ، عَنِ امْرَأَۃٍ مِنْ بَنِی کُلَیْبٍ ، قَالَتْ : رَأَتْنِی عَائِشَۃُ أُسَبِّحُ بِتَسَابِیحَ مَعِی ، فَقَالَتْ : أَیْنَ الشَّوَاہِدُ ؟ تَعْنِی الأَصَابِعَ۔","Da'if","Musannaf Ibn Abi Shaybah 7739","","","كتاب الجمعة"
"7740","(۷۷۴۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ حَکِیمِ بْنِ الدَّیْلَمِ ، عَنْ مَوْلاَۃٍ لِسَعْدٍ : أَنَّ سَعْدًا کَانَ یُسَبِّحُ بِالْحَصَی وَالنَّوَی۔","Da'if","Musannaf Ibn Abi Shaybah 7740","","","كتاب الجمعة"
"7741","(۷۷۴۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ حَکِیمِ بْنِ الدَّیْلَمِ ، عَنْ مَوْلاَۃٍ لِسَعْدٍ : أَنَّ سَعْدًا کَانَ یُسَبِّحُ بِالْحَصَی وَالنَّوَی۔","Da'if","Musannaf Ibn Abi Shaybah 7741","","","كتاب الجمعة"
"7742","(۷۷۴۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ بْنِ الأَخْنَسِ ، قَالَ : حدَّثَنِی مَوْلًی لأَبِی سَعِیدٍ ، عَنْ أَبِی سَعِیدٍ : أَنَّہُ کَانَ یَأْخُذُ ثَلاَثَ حَصَیَاتٍ فَیَضَعُہُنَّ عَلَی فَخِذِہِ فَیُسَبِّحُ وَیَضَعُ وَاحِدَۃً ، ثُمَّ یُسَبِّحُ وَیَضَعُ أُخْرَی ، ثُمَّ یُسَبِّحُ وَیَضَعُ أُخْرَی ، ثُمَّ یُرْفَعَنْ وَیَصنَعُ مِثْلَ ذَلِکَ ، وَقَالَ : لاَ تُسَبِّحُوا بِالتَّسْبِیحِ صَفِیرًا۔","Da'if","Musannaf Ibn Abi Shaybah 7742","","","كتاب الجمعة"
"7743","(۷۷۴۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیرِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ رَجُلٍ مِنَ الطَّفَاوَۃ ، قَالَ : نَزَلْتُ عَلَی أَبِی ہُرَیْرَۃَ وَمَعَہُ کِیسٌ فِیہِ حَصًی ، أَوْ نَوًی فَیَقُولُ سُبْحَانَ اللہِ سُبْحَانَ اللہِ حَتَّی إذَا نَفِدَ مَا فِی الْکِیسِ أَلْقَاہُ إلَی جَارِیَۃٍ سَوْدَائَ فَجَمَعَتْہُ ، ثُمَّ دَفَعَتْہُ إلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 7743","","","كتاب الجمعة"
"7744","(۷۷۴۴) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِالرَّحْمَنِ، عَنْ حَسَنِ عن مُوسَی الْقَارِیِٔ، عَنْ طَلْحَۃَ بْنِ عَبْدِ اللہِ، عَنْ زَاذَانَ، قَالَ: أَخَذْتُ مِنْ أُمِّ یَعْفُورَ تَسَابِیحَ لَہَا ، فَلَمَّا أَتَیْتُ عَلِیًّا عَلَّمَنِی، قَالَ: یَا أَبَا عُمَرَ اُرْدُدْ عَلَی أُمِّ یَعْفُورَ تَسَابِیحَہا۔","Da'if","Musannaf Ibn Abi Shaybah 7744","","","كتاب الجمعة"
"7745","(۷۷۴۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : رَأَیْتُُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَعْقِدُہُ بِیَدِہِ ، یَعْنِی التَّسْبِیحَ۔ (ترمذی ۳۴۱۱۔ ابوداؤد ۱۴۲۷)","Da'if","Musannaf Ibn Abi Shaybah 7745","","","كتاب الجمعة"
"7746","(۷۷۴۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُسَبِّحَ الرَّجُلُ وَیَعْقِدَ تَسْبِیحَہُ۔","","Musannaf Ibn Abi Shaybah 7746","","","كتاب الجمعة"
"7747","(۷۷۴۷) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ مُخْتَارِ بْنِ سَعْدٍ ، قَالَ: رَأَیْتُُ مُحَمَّدَ بْنَ عَلِیٍّ یُسَبِّحُ فِی النَّافِلَۃِ وَیَعْقِدُ بِیَدِہِ۔","","Musannaf Ibn Abi Shaybah 7747","","","كتاب الجمعة"
"7748","(۷۷۴۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ مُؤَذِّنِ بَنِی حَنِیفَۃَ ، قَالَ : رَأَیْتُ مَاہَانَ الْحَنَفِیَّ وَأَمَرَ بِہِ الْحَجَّاجُ أَنْ یُصْلَبَ عَلَی بَابِہِ فَنَظَرْتُ إلَیْہِ وَإِنَّہُ عَلَی الْخَشَبَۃِ وَإِنَّہُ یُسَبِّحُ وَیُکَبِّرُ وَیُہَلِّلُ وَیَحْمَدُ اللَّہَ حَتَّی بَلَغَ تسْعَۃً وَعِشْرِینَ یَعْقِدُ بِیَدِہِ ، فَطُعِنَ وَہُوَ عَلَی تِلْکَ الْحَالِ ، فَلَقَدْ رَأَیْتُہُ بَعْدَ شَہْرٍ مَعْقُودًا تِسْعًا وَعِشْرِینَ بِیَدِہِ وَکَانَ یُرَی عِنْدَہُ ضَوْئٌ بِاللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 7748","","","كتاب الجمعة"
"7749","(۷۷۴۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ یَکْرَہُ الْعَدَدَ وَیَقُولُ : أَیُمَنُّ عَلَی اللہِ حَسَنَاتِہِ؟۔","","Musannaf Ibn Abi Shaybah 7749","","","كتاب الجمعة"
"7750","(۷۷۵۰) حَدَّثَنَا أَزْہَرُ السَّمَّانُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ عُقْبَۃَ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنِ الرَّجُلِ یَذْکُرُ اللَّہَ وَیَعْقِدُ ؟ فَقَالَ : یُحَاسِبُونَ اللَّہَ؟۔","Sahih","Musannaf Ibn Abi Shaybah 7750","","","كتاب الجمعة"
"7751","(۷۷۵۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ وِقَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : رَأَی عُمَرُ بْنُ الْخَطَّابِ رَجُلاً یُسَبِّحُ بِتَسَابِیحَ مَعَہُ ، فَقَالَ عُمَرُ : إنَّمَا یُجْزِئہ مِنْ ذَلِکَ أَنْ یَقُولَ : سُبْحَانَ اللہِ مِلْئَ السَّمَاوَاتِ وَالأَرْضِ وَمِلْئَ مَا شَائَ مِنْ شَیْئٍ بَعْدُ ، وَیَقُولَ : الْحَمْدُ لِلَّہِ مِلْئَ السَّمَاوَاتِ وَالأَرْضِ وَمِلْئَ مَا شَائَ مِنْ شَیْئٍ بَعْدُ ، وَیَقُولَ : اللَّہُ أَکْبَرُ مِلْئَ السَّمَاوَاتِ وَالأَرْضِ وَمِلْئَ مَا شَائَ مِنْ شَیْئٍ بَعْدُ۔","","Musannaf Ibn Abi Shaybah 7751","","","كتاب الجمعة"
"7752","(۷۷۵۲) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَانَ یَنْہَی ابْنَتَہُ أَنْ تُعِینَ النِّسَائَ عَلَی فَتْلِ خُیُوطِ التَّسْبِیحِ الَّتِی یُسَبَّحُ بِہَا۔","","Musannaf Ibn Abi Shaybah 7752","","","كتاب الجمعة"
"7753","حَدَّثَنَا أَبُو مُحَمَّدٍ عَبْدُ اللہِ بْنُ یُونُسَ ، قَالَ : حدَّثَنَا بَقِیُّ بْنُ مَخْلَدٍ رحمہ اللہ قَالَ : حَدَّثَنَا أَبُو بَکْرٍ قَالَ :n(۷۷۵۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ مُحَمَّدِ بْنِ یُوسُفَ ، أَنَّ السَّائِبَ أَخْبَرَہُ : أَنَّ عُمَرَ جَمَعَ النَّاسَ عَلَی أُبَیٍّ وَتَمِیمٍ فَکَانَا یُصَلِّیَانِ إحْدَی عَشْرَۃَ رَکْعَۃً ، یَقْرَآنِ بِالْمِئِینَ ، یَعْنِی فِی رَمَضَانَ۔","Sahih","Musannaf Ibn Abi Shaybah 7753","","","كتاب الجمعة"
"7754","(۷۷۵۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : دَعَا عُمَرُ الْقُرَّائَ فِی رَمَضَانَ فَأَمَرَ أَسْرَعَہُمْ قِرَائَۃً أَنْ یَقْرَأَ ثَلاَثِینَ آیَۃً وَالْوَسَطَ خَمْسۃ وَعِشْرِینَ آیَۃً وَالْبَطِیئَ عِشْرِینَ آیَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 7754","","","كتاب الجمعة"
"7755","(۷۷۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ : أَنَّ مَسْرُوقًا قَرَأَ فِی رَکْعَۃٍ مِنَ الْقِیَامِ بِالْعَنْکَبُوتِ۔","","Musannaf Ibn Abi Shaybah 7755","","","كتاب الجمعة"
"7756","(۷۷۵۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ نَافِعِ بْنِ عُمَرَ ، قَالَ : سَمِعْتُ ابْنَ أَبِی مُلَیْکَۃَ یَقُولُ : کُنْتُ أَقُومُ بِالنَّاسِ فِی شَہْرِ رَمَضَانَ فَأَقْرَأُ فِی الرَّکْعَۃِ : {الْحَمْدُ لِلَّہِ فَاطِرِ} وَنَحْوَہَا وَمَا یَبْلُغُنِی ، أَنَّ أَحَدًا یَسْتَقِلُّ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 7756","","","كتاب الجمعة"
"7757","(۷۷۵۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ، عَنْ وِقَائٍ، قَالَ: کَانَ سَعِیدُ بْنُ جُبَیْرٍ یَقْرَأُ فِی کُلِّ رَکْعَۃٍ بِخَمْسۃ وَعِشْرِینَ آیَۃً۔","","Musannaf Ibn Abi Shaybah 7757","","","كتاب الجمعة"
"7758","(۷۷۵۸) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ الْعُمَرِیِّ ، عَنْ أَبِیہِ ، قَالَ : کَانَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ یَأْمُرُ الَّذِینَ یَقْرَؤُونَ فِی رَمَضَانَ ، یَقْرَؤُونَ فِی کُلِّ رَکْعَۃٍ بِعَشْرِ آیَاتٍ عَشْرِ آیَاتٍ۔","","Musannaf Ibn Abi Shaybah 7758","","","كتاب الجمعة"
"7759","(۷۷۵۹) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ قَالَ : کَانَ أَبُو مِجْلَزٍ یَقُومُ بِالْحَیِّ فِی رَمَضَانَ یَخْتِمُ فِی کُلِّ سَبْعٍ۔","","Musannaf Ibn Abi Shaybah 7759","","","كتاب الجمعة"
"7760","(۷۷۶۰) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عِرَاکِ بْنِ مَالِکٍ ، عَنْ أَبِیہِ ، قَالَ أَدْرَکْت النَّاسَ فِی شَہْرِ رَمَضَانَ تُرْبَط لَہُمُ الْحِبَالَ یَسْتَمْسِکُونَ بِہَا مِنْ طُولِ الْقِیَامِ۔","","Musannaf Ibn Abi Shaybah 7760","","","كتاب الجمعة"
"7761","(۷۷۶۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالَ : مَنْ أَمَّ النَّاسَ فِی رَمَضَانَ فَلْیَأْخُذْ بِہِمُ الْیُسْرَ ، فَإِنْ کَانَ بَطِیئَ الْقِرَائَۃِ فَلْیَخْتِمِ الْقُرْآنَ خَتْمَۃً ، وَإِنْ کَانَ قِرَائَۃً بَیْنَ ذَلِکَ فَخَتْمَۃ وَنِصْف ، فَإِنْ کَانَ سَرِیعَ الْقِرَائَۃِ فَمَرَّتَیْنِ۔","","Musannaf Ibn Abi Shaybah 7761","","","كتاب الجمعة"
"7762","(۷۷۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ قَیْسٍ ، عَنْ شُتَیْرِ بْنِ شَکَلٍ : أَنَّہُ کَانَ یُصَلِّی فِی رَمَضَانَ عِشْرِینَ رَکْعَۃً وَالْوِتْرَ۔","","Musannaf Ibn Abi Shaybah 7762","","","كتاب الجمعة"
"7763","(۷۷۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ عَمْرِو بْنِ قَیْسٍ ، عَنِ أَبِی الْحَسْنَائِ : أَنَّ عَلِیًّا أَمَرَ رَجُلاً یُصَلِّی بِہِمْ فِی رَمَضَانَ عِشْرِینَ رَکْعَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 7763","","","كتاب الجمعة"
"7764","(۷۷۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَمَرَ رَجُلاً یُصَلِّی بِہِمْ عِشْرِینَ رَکْعَۃً۔","","Musannaf Ibn Abi Shaybah 7764","","","كتاب الجمعة"
"7765","(۷۷۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ نَافِعِ بْنِ عُمَرَ ، قَالَ : کَانَ ابْنُ أَبِی مُلَیْکَۃَ یُصَلِّی بِنَا فِی رَمَضَانَ عِشْرِینَ رَکْعَۃً وَیَقْرَأُ بِحَمْدِ الْمَلاَئِکَۃِ فِی رَکْعَۃٍ۔","","Musannaf Ibn Abi Shaybah 7765","","","كتاب الجمعة"
"7766","(۷۷۶۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، قَالَ : کَانَ أُبَیّ بْنُ کَعْبٍ یُصَلِّی بِالنَّاسِ فِی رَمَضَانَ بِالْمَدِینَۃِ عِشْرِینَ رَکْعَۃً وَیُوتِرُ بِثَلاَثٍ۔","","Musannaf Ibn Abi Shaybah 7766","","","كتاب الجمعة"
"7767","(۷۷۶۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ : أَنَّہُ کَانَ یَؤُمُّ النَّاسَ فِی رَمَضَانَ بِاللَّیْلِ بِعِشْرِینَ رَکْعَۃً وَیُوتِرُ بِثَلاَثٍ وَیَقْنُتُ قَبْلَ الرُّکُوعِ۔","","Musannaf Ibn Abi Shaybah 7767","","","كتاب الجمعة"
"7768","(۷۷۶۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ خَلَفٍ ، عَنْ رَبِیعٍ وَأَثْنَی عَلَیْہِ خَیْرًا ، عَنْ أَبِی الْبَخْتَرِیِّ : أَنَّہُ کَانَ یُصَلِّی خَمْسَ تَرْوِیحَاتٍ فِی رَمَضَانَ وَیُوتِرُ بِثَلاَثٍ۔","","Musannaf Ibn Abi Shaybah 7768","","","كتاب الجمعة"
"7769","(۷۷۶۹) حَدَّثَنَا حَفْصٌ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ : کَانَ عَبْدُ الرَّحْمَنِ بْنُ الأَسْوَدِ یُصَلِّی بِنَا فِی رَمَضَانَ أَرْبَعِینَ رَکْعَۃً وَیُوتِرُ بِسَبْعٍ۔","","Musannaf Ibn Abi Shaybah 7769","","","كتاب الجمعة"
"7770","(۷۷۷۰) حَدَّثَنَا ابْنُ نُمَیْرٍ، عَنْ عَبْدِالْمَلِکِ، عَنْ عَطَائٍ، قَالَ: أَدْرَکْت النَّاسَ وَہُمْ یُصَلُّونَ ثَلاَثًا وَعِشْرِینَ رَکْعَۃً بِالْوِتْرِ۔","","Musannaf Ibn Abi Shaybah 7770","","","كتاب الجمعة"
"7771","(۷۷۷۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ دَاوُدَ بْنِ قَیْسٍ ، قَالَ : أَدْرَکْتُ النَّاسَ بِالْمَدِینَۃِ فِی زَمَنِ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ وَأَبَانَ بْنِ عُثْمَانَ یُصَلُّونَ سِتَّۃ وَثَلاَثِینَ رَکْعَۃً وَیُوتِرُونَ بِثَلاَثٍ۔","","Musannaf Ibn Abi Shaybah 7771","","","كتاب الجمعة"
"7772","(۷۷۷۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سَعِیدِ بْنِ عُبَیْدٍ : أَنَّ عَلِیَّ بْنَ رَبِیعَۃَ کَانَ یُصَلِّی بِہِمْ فِی رَمَضَانَ خَمْسَ تَرْوِیحَاتٍ وَیُوتِرُ بِثَلاَثٍ۔","","Musannaf Ibn Abi Shaybah 7772","","","كتاب الجمعة"
"7773","(۷۷۷۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ وِقَائٍ ، قَالَ : کَانَ سَعِیدُ بْنُ جُبَیْرٍ یَؤُمُّنَا فِی رَمَضَانَ فَیُصَلِّی بِنَا عِشْرِینَ لَیْلَۃً سِتَّ تَرْوِیحَاتٍ ، فَإِذَا کَانَ الْعَشْرُ الأَخَرُ اعْتَکَفَ فِی الْمَسْجِدِ وَصَلَّی بِنَا سَبْعَ تَرْوِیحَاتٍ۔","","Musannaf Ibn Abi Shaybah 7773","","","كتاب الجمعة"
"7774","(۷۷۷۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا إبْرَاہِیمُ بْنُ عُثْمَانَ ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی فِی رَمَضَانَ عِشْرِینَ رَکْعَۃً وَالْوِتْرَ۔ (عبد بن حمید ۶۵۳)","Da'if","Musannaf Ibn Abi Shaybah 7774","","","كتاب الجمعة"
"7775","(۷۷۷۵) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ الأَعْمَشِ ، عَنْ زَیْدِ بْنِ وَہْبٍ قَالَ : کَانَ عَبْدُ اللہِ یَؤُمُّنَا فِی رَمَضَانَ۔","Sahih","Musannaf Ibn Abi Shaybah 7775","","","كتاب الجمعة"
"7776","(۷۷۷۶) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ قَالَ : سَأَلْتُ عَطَائً ہَلْ کَانَ عَلِیٌّ یُصَلِّی بِہِمْ فِی رَمَضَانَ ؟ قَالَ : کَانَ خِیَارُ أَصْحَابِ عَلِیٍّ زَاذَانُ ، وَأَبُو الْبَخْتَرِیِّ وَغَیْرُہُمْ یَدْعُونَ أَہْلِیہِمْ وَیَؤُمُّونَ فِی الْمَسْجِدِ فِی رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 7776","","","كتاب الجمعة"
"7777","(۷۷۷۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ الرَّحْمَنِ الْجُرَشِیِّ ، عَنْ جُبَیْرِ بْنِ نُفَیْرٍ الْحَضْرَمِیِّ ، عَنْ أَبِی ذَرٍّ ، قَالَ : صُمْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَمَضَانَ فَلَمْ یُصَلِّ بِنَا حَتَّی بَقِیَ سَبْعٌ مِنَ الشَّہْرِ ، فَقَامَ بِنَا حَتَّی ذَہَبَ ثُلُثُ اللَّیْلِ ، ثُمَّ لَمْ یَقُمْ بِنَا فِی السَّادِسَۃِ ، ثُمَّ قَامَ بِنَا فِی الخَامِسَۃِ حَتَّی ذَہَبَ شَطْرُ اللَّیْلِ ، فَقُلْنَا : یَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَوْ قُمْتَ بِنَا بَقِیَّۃَ لَیْلَتِنَا ہَذِہِ ، فَقَالَ : إنَّہُ مَنْ قَامَ مَعَ الإِمَامِ حَتَّی یَنْصَرِفَ کُتِبَ لَہُ قِیَامُ لَیْلَۃٍ۔ قَالَ : ثُمَّ صَلَّی بِنَا حَتَّی بَقِیَ ثَلاَثٌ مِنَ الشَّہْرِ ، ثُمَّ صَلَّی بِنَا وَجَمَعَ أَہْلَہُ وَنِسَائَہُ ، قَالَ : فَقَامَ حَتَّی تَخَوَّفْنَا أَنْ یَفُوتَنَا الْفَلاَحُ ، قَالَ : قُلْتُ : وَمَا الْفَلاَحُ ؟ قَالَ : السَّحُورُ۔ (ابوداؤد ۱۷۳۰۔ احمد ۵/۱۶۳)","Sahih","Musannaf Ibn Abi Shaybah 7777","","","كتاب الجمعة"
"7778","(۷۷۷۸) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، قَالَ : حدَّثَنِی نُعَیْمُ بْنُ زِیَادٍ أَبُو طَلْحَۃَ الأَنْمَارِیُّ ، قَالَ : سَمِعْتُ النُّعْمَانَ بْنَ بَشِیرٍ عَلَی مِنْبَرِ حِمْصَ یَقُولُ : قُمْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَیْلَۃَ ثَلاَثٍ وَعِشْرِینَ إلَی ثُلُثِ اللَّیْلِ الأَوَّلِ ، وَقُمْنَا مَعَہُ لَیْلَۃَ خَمْسٍ وَعِشْرِینَ إلَی نِصْفِ اللَّیْلِ ، وَقُمْنَا مَعَہُ لَیْلَۃَ سَابِعَۃٍ وَعِشْرِینَ حَتَّی ظَنَنَّا أَنَّہُ یَفُوتُنَا الْفَلاَحُ وَکُنَّا نَعُدُّہُ السَّحُورَ۔ (احمد ۴/۲۷۲۔ ابن خزیمۃ ۲۲۰۴)","Sahih","Musannaf Ibn Abi Shaybah 7778","","","كتاب الجمعة"
"7779","(۷۷۷۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ طَلْحَۃَ بْنِ یَزِیدَ ، عَنْ حُذَیْفَۃَ ، قَالَ : قَامَ بِنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَاتَ لَیْلَۃٍ مِنْ رَمَضَانَ فِی حُجْرَۃٍ مِنْ جَرِیدِ النَّخْلِ ، ثُمَّ صَبَّ عَلَیْہِ دَلْوًا مِنْ مَائٍ ، ثُمَّ قَالَ : اللَّہُ أَکْبَرُ ذُو الْمَلَکُوتِ وَالْجَبَرُوتِ وَالْکِبْرِیَائِ وَالْعَظَمَۃِ۔","","Musannaf Ibn Abi Shaybah 7779","","","كتاب الجمعة"
"7780","(۷۷۸۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُرَغِّبُ فِی قِیَامِ رَمَضَانَ مِنْ غَیْرِ عَزِیمَۃٍ۔ (ترمذی ۸۰۸۔ ابوداؤد ۱۳۶۶)","Sahih","Musannaf Ibn Abi Shaybah 7780","","","كتاب الجمعة"
"7781","(۷۷۸۱) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَامَ فِی رَمَضَانَ فِی بَعْضِ حُجَرِہِ یُصَلِّی فَائْتَمُّوا بِصَوْتِہِ ، فَلَمَّا عَلِمَ بِہِمْ خَفَضَ صَوْتَہُ۔","","Musannaf Ibn Abi Shaybah 7781","","","كتاب الجمعة"
"7782","(۷۷۸۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، قَالَ : کَانَ عَبْدُ اللہِ یَؤُمُّنَا فِی رَمَضَانَ وَیَنْصَرِفُ وَعَلَیْہِ لَیْلٌ۔","Sahih","Musannaf Ibn Abi Shaybah 7782","","","كتاب الجمعة"
"7783","(۷۷۸۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ عَلِیٍّ : أَنَّہُ قَامَ بِہِمْ فِی رَمَضَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 7783","","","كتاب الجمعة"
"7784","(۷۷۸۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنِ الْوَلِیدِ بْنِ عَلِیٍّ ، عَنْ أَبِیہِ ، قَالَ : کَانَ سُوَیْد بْنُ غَفَلَۃَ یَؤُمُّنَا فَیَقُومُ بِنَا فِی شَہْرِ رَمَضَانَ وَہُوَ ابْنُ عِشْرِینَ وَمِئَۃِ سَنَۃٍ۔","","Musannaf Ibn Abi Shaybah 7784","","","كتاب الجمعة"
"7785","(۷۷۸۵) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنِ ابْنِ شِہَابٍ ، عَنْ عُرْوَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدٍ الْقَارِیِٔ ، قَالَ : خَرَجَ عُمَرُ بْنُ الْخَطَّابِ فِی شَہْرِ رَمَضَانَ وَالنَّاسُ یُصَلُّونَ قِطَعًا ، فَقَالَ : لَوْ جَمَعْنَا ہَؤُلاَئِ عَلَی قَارِیٍٔ وَاحِدٍ لَکَانَ خَیْرًا فَجَمَعَہُمْ عَلَی أُبَیِّ بْنِ کَعْبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 7785","","","كتاب الجمعة"
"7786","(۷۷۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی سَلَمَۃَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُرَغِّبُ فِی قِیَامِ رَمَضَانَ مِنْ غَیْرِ أَنْ یَأْمُرَ فِیہِ بِعَزِیمَۃٍ۔","","Musannaf Ibn Abi Shaybah 7786","","","كتاب الجمعة"
"7787","(۷۷۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ نَصْرِ بْنِ عَلِیٍّ ، عَنْ نَضْرِ بْنِ شَیْبَانَ قَالَ : سَأَلْتُ أَبَا سَلَمَۃَ بْنَ عَبْدِ الرَّحْمَنِ ، فَذَکَر عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ اللَّہَ افْتَرَضَ عَلَیْکُمْ صِیَامَہُ وَسَنَنْتُ لَکُمْ قِیَامَہُ فَمَنْ صَامَہُ إیمَانًا وَاحْتِسَابًا غُفِرَ لَہُ مَا تَقَدَّمَ مِنْ ذَنْبِہِ۔ (احمد ۱/۱۹۴۔ طیالسی ۲۲۴)","Da'if","Musannaf Ibn Abi Shaybah 7787","","","كتاب الجمعة"
"7788","(۷۷۸۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ : أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَمَرَ أُبَیًّا أَنْ یُصَلِّیَ بِالنَّاسِ فِی شَہْرِ رَمَضَانَ۔","Sahih","Musannaf Ibn Abi Shaybah 7788","","","كتاب الجمعة"
"7789","(۷۷۸۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ طَاوُوسٍ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ یَقُولُ : دَعَانِی عُمَرُ لأَتَغَدَّی عِنْدَہُ ، قَالَ أَبُو بَکْرٍ : یَعْنِی السَّحُورَ فِی رَمَضَانَ فَسَمِعَ ہَیْعَۃَ النَّاسِ حِینَ خَرَجُوا مِنَ الْمَسْجِدِ ، قَالَ : مَا ہِیَ ؟ قَالَ : ہَیْعَۃُ النَّاسِ حَیْثُ خَرَجُوا مِنَ الْمَسْجِدِ ، قَالَ : مَا بَقِیَ مِنَ اللَّیْلِ خَیْرٌ مِمَّا ذَہَبَ مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 7789","","","كتاب الجمعة"
"7790","(۷۷۹۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ الْقَارِیّ قَالَ : قَالَ عُمَرُ : فِی السَّاعَۃِ الَّتِی یَنَامُونَ فِیہَا أَعْجَبُ إلَیَّ مِنَ السَّاعَۃِ الَّتِی یَقُومُونَ فِیہَا۔","Sahih","Musannaf Ibn Abi Shaybah 7790","","","كتاب الجمعة"
"7791","(۷۷۹۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی یَزِیدَ الْمَدِینِیِّ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ فِی قِیَامِ رَمَضَانَ : مَا یَتْرُکُونَ مِنْہُ أَفْضَلُ مِمَّا یَقُومُونَ فِیہِ۔","Sahih","Musannaf Ibn Abi Shaybah 7791","","","كتاب الجمعة"
"7792","(۷۷۹۲) حَدَّثَنَا وَکِیعٌ، عَنْ أَبِی الْمُعْتَمِرِ، قَالَ: سَأَلْتُ الْحَسَنَ أَیَّ سَاعَۃٍ أَقُومُ بِہِمْ؟ قَالَ: اُنْظُرْ أَرْفَقَ ذَلِکَ بِالْقَوْمِ۔","","Musannaf Ibn Abi Shaybah 7792","","","كتاب الجمعة"
"7793","(۷۷۹۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الْحَکَمِ قَالَ : کَانُوا یَنَامُونَ نَوْمَۃً قَبْلَ الْقِیَامِ فِی شَہْرِ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 7793","","","كتاب الجمعة"
"7794","(۷۷۹۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أُسَامَۃُ بْنُ زَیْدٍ ، عَنْ مُحَمَّدِ بْنِ یُوسُفَ الأَعْرَجِ ، عَنِ السَّائِبِ قَالَ : قَالَ عُمَرُ: إنَّکُمْ تَدَعُونَ أَفْضَلَ اللَّیْلِ آخِرَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 7794","","","كتاب الجمعة"
"7795","(۷۷۹۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ حَبِیبٍ قَالَ : قَالَ رَجُلٌ : ذَہَبَ اللَّیْلُ ، فَقَالَ : عُمَرُ مَا بَقِیَ مِنَ اللَّیْلِ خَیْرٌ مِمَّا ذَہَبَ۔","","Musannaf Ibn Abi Shaybah 7795","","","كتاب الجمعة"
"7796","(۷۷۹۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ لاَ یَقُومُ مَعَ النَّاسِ فِی شَہْرِ رَمَضَانَ ، قَالَ : وَکَانَ سَالِمٌ وَالْقَاسِمُ لاَ یَقُومَانَ مَعَ النَّاسِ۔","Sahih","Musannaf Ibn Abi Shaybah 7796","","","كتاب الجمعة"
"7797","(۷۷۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : سَأَلَ رَجُلٌ ابْنَ عُمَرَ أَقُومُ خَلْفَ الإِمَام فِی شَہْرِ رَمَضَانَ ، فَقَالَ : تُنْصِتُ کَأَنَّک حِمَارٌ۔","Sahih","Musannaf Ibn Abi Shaybah 7797","","","كتاب الجمعة"
"7798","(۷۷۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَوْ لَمْ یَکُنْ مَعِی إِلاَّ سُورَۃٌ أَوْ سُورَتَانِ لأَنْ أُرَدِّدَہُمَا أَحَبُّ إلَیَّ مِنْ أَنْ أَقُومَ خَلْفَ الإِمَام فِی شَہْرِ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 7798","","","كتاب الجمعة"
"7799","(۷۷۹۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ إبْرَاہِیمُ یَؤُمُّہُمْ فِی الْمَکْتُوبَۃِ ، وَلاَ یَؤُمُّہُمْ فِی صَلاَۃِ رَمَضَانَ وَعَلْقَمَۃُ وَالأَسْوَدُ۔","","Musannaf Ibn Abi Shaybah 7799","","","كتاب الجمعة"
"7800","(۷۸۰۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ إبْرَاہِیمُ وَعَلْقَمَۃُ لاَ یَقُومُانَ مَعَ النَّاسِ فِی رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 7800","","","كتاب الجمعة"
"7801","(۷۸۰۱) حَدَّثَنَا قَطَنُ بْنُ عَبْدِ اللہِ أَبُو مُرَیٍّ ، عَنْ نَصْرٍ الْمُعَلِّمِ ، قَالَ : حدَّثَنِی عُمَرُ بْنُ عُثْمَانَ ، قَالَ : سَأَلْتُ الْحَسَنَ فَقُلْت : یَا أَبَا سَعِیدٍ یَجِیئُ رَمَضَانُ ، أَوْ یَحْضُرُ رَمَضَانُ ، فَیَقُومُ النَّاسُ فِی الْمَسَاجِدِ ، فَمَا تَرَی أَقُومُ مَعَ النَّاسِ أَوْ أُصَلِّی أَنَا لِنَفْسِی ؟ قَالَ : تَکُونُ أَنْتَ تَفُوہُ الْقُرْآنَ أَحَبُّ إلَیَّ مِنْ أَنْ یُفَاہَ عَلَیْک بِہِ۔","","Musannaf Ibn Abi Shaybah 7801","","","كتاب الجمعة"
"7802","(۷۸۰۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ مُحَمَّدِ بْنِ عَبَّادٍ ، عَنْ عَبْدِ اللہِ بْنِ السَّائِبِ ، قَالَ : کُنْتُ أُصَلِّی بِالنَّاسِ فِی رَمَضَانَ فَبَیْنَا أَنَا أُصَلِّی إذْ سَمِعْت تَکْبِیرَ عُمَرَ عَلَی بَابِ الْمَسْجِدِ قَدِمَ مُعْتَمِرًا فَدَخَلَ فَصَلَّی خَلْفِی۔","","Musannaf Ibn Abi Shaybah 7802","","","كتاب الجمعة"
"7803","(۷۸۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ : أَنَّہُ کَانَ یُصَلِّی مَعَہُمْ فِی شَہْرِ رَمَضَانَ یُصَلِّی لِنَفْسِہِ وَیَرْکَعُ وَیَسْجُدُ مَعَہُمْ۔","","Musannaf Ibn Abi Shaybah 7803","","","كتاب الجمعة"
"7804","(۷۸۰۴) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ، عَنِ ابْنِ عَوْنٍ، عَنْ مُحَمَّدٍ: أَنَّہُ کَانَ یَخْتَارُ الْقِیَامَ مَعَ النَّاسِ فِی شَہْرِ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 7804","","","كتاب الجمعة"
"7805","(۷۸۰۵) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ الْمُتَہَجِّدُونَ یُصَلُّونَ فِی جَانِبِ الْمَسْجِدِ وَالإِمَام یُصَلِّی بِالنَّاسِ فِی شَہْرِ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 7805","","","كتاب الجمعة"
"7806","(۷۸۰۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : رَأَیْتُُ عَبْدَ اللہِ بْنَ أَبِی مُلَیْکَۃَ یُصَلِّی بِالنَّاسِ فِی رَمَضَانَ خَلْفَ الْمَقَامِ بِمَنْ صَلَّی خَلْفَہُ وَالنَّاسُ بَعْدُ فِی سَائِرِ الْمَسْجِدِ مِنْ بَیْنِ طَائِفٍ بِالْبَیْتِ وَمُصَلٍّ۔","","Musannaf Ibn Abi Shaybah 7806","","","كتاب الجمعة"
"7807","(۷۸۰۷) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، قَالَ: شَہِدْتُ مَکَّۃَ فِی زَمَانِ ابْنِ الزُّبَیْرِ فِی رَمَضَانَ وَالإِمَام یُصَلِّی بِقَومٍ عَلَی حِدَۃٍ ، وَالنَّاسُ یُصَلُّونَ فِی نَوَاحِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 7807","","","كتاب الجمعة"
"7808","(۷۸۰۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ : رَأَیْتُُ شَبَثَ بْنَ رِبْعِیٍّ وَنَاسٌ مَعَہُ یُصَلُّونَ وُحْدَانًا فِی رَمَضَانَ وَالنَّاسُ فِی الصَّلاَۃ ، وَرَأَیْت شَبَثًا یُصَلِّی فِی سُتْرَۃٍ وَحْدَہُ۔","","Musannaf Ibn Abi Shaybah 7808","","","كتاب الجمعة"
"7809","(۷۸۰۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ الإِمَام یُصَلِّی بِالنَّاسِ فِی الْمَسْجِدِ وَالْمُتَہَجِّدُونَ یُصَلُّونَ فِی نَوَاحِی الْمَسْجِدِ لأَنْفُسِہِمْ۔","","Musannaf Ibn Abi Shaybah 7809","","","كتاب الجمعة"
"7810","(۷۸۱۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ ابنِ جُبَیْر وَالْحَسَنِ ؛ فِی الرَّجُلِ یَقُومُ بَیْنَ التَّرْوِیحَتَیْنِ یَقْرَأُ حَتَّی یَنْہَضَ الإِمَام فَیَدْخُلُ مَعَہُ ، قَالَ شُعْبَۃُ : کَرِہَہُ أَحَدُہُمَا وَلَمْ یَکْرَہْہُ الأَخَرُ۔n وَقَالَ ہِشَامٌ : ہُوَ یُونُسُ بْنُ جُبَیْرٍ۔","","Musannaf Ibn Abi Shaybah 7810","","","كتاب الجمعة"
"7811","(۷۸۱۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہَارُونَ بْنِ أَبِی مَرْیَمَ ، عَنِ ابْنِ الأَسْوَدِ : أَنَّہُ کَانَ یُصَلِّی بِہِمْ أَرْبَعِینَ رَکْعَۃً وَیُوتِرُ بِہِمْ وَیُصَلِّی بَیْنَ التَّرْوِیحَتَیْنِ اثْنَتَیْ عَشْرَۃَ رَکْعَۃً ، وَیَقُولُ بَیْنَ التَّرْوِیحَتَیْنِ : الصلاۃ۔","","Musannaf Ibn Abi Shaybah 7811","","","كتاب الجمعة"
"7812","(۷۸۱۲) حَدَّثَنَا عَفَّانُ، قَالَ: حدَّثَنَا ہَمَّامٌ، قَالَ: حَدَّثَنَا یَحْیَی بْنُ أَبِی کَثِیرٍ، أَنَّ رَجُلاً مِنْ أَہْلِ الشَّامِ حَدَّثَہُ یُقَالُ لَہُ أَبُو سُفْیَانَ، أَنَّ بَحِیرَ بْنَ رَیْسَانَ حَدَّثَہُ، أَنَّہُ کَانَ عِنْدَ عُبَادَۃَ بْنِ الصَّامِتِ شَہِدَ ذَلِکَ، زَجَرَہُمْ أَنْ یُصَلُّوا إذَا تَرَوَّحَ الإِمَام فِی رَمَضَانَ فَجَعَلَ یَزْجُرُہُمْ وَہُمْ لاَ یُبَالُونَ ، وَلاَ یَنْتَہُونَ فَضَرَبَہُمْ فَرَأَیْتُہُ یَضْرِبُہُمْ عَلَی ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 7812","","","كتاب الجمعة"
"7813","(۷۸۱۳) حَدَّثَنَا یَحْیَی بْنُ وَاضِحٍ أَبُو تُمَیْلَۃَ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ حَبِیبِ بن أَبِی عَمْرَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَقُولَ بَیْنَ التَّرْوِیحَتَیْنِ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7813","","","كتاب الجمعة"
"7814","(۷۸۱۴) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ والحسن : أَنَّہُمَا کَانَا یَکْرَہَانِ التَّعْقِیبَ فِی رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 7814","","","كتاب الجمعة"
"7815","(۷۸۱۵) حَدَّثَنَا عَبَّادٌ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ قَالَ : لاَ بَأْسَ بِہِ إنَّمَا یَرْجِعُونَ إلَی خَیْرٍ یَرْجُونَہُ وَیَبْرَؤُونَ مِنْ شَرٍّ یَخَافُونَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 7815","","","كتاب الجمعة"
"7816","(۷۸۱۶) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا الرَّبِیعُ ، عَنِ الْحَسَنِ ، أَنَّہُ [corrupt]َرِہَ التَّعْقِیبَ فِی شَہْرِ رَمَضَانَ ، وَقَالَ الْحَسَنُ لاَ تُمِلُّوا النَّاسَ۔","","Musannaf Ibn Abi Shaybah 7816","","","كتاب الجمعة"
"7817","(۷۸۱۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ أَبِی عَمْرٍو ، أَنَّہُ صَلَّی خَلْفَ أَبِی ہُرَیْرَۃَ فِی رَمَضَانَ ، وَکَانَ یُصَلِّی رَکْعَتَیْنِ ثُمَّ یُسَلِّمُ ، ثُمَّ یَقُومُ فَیُوتِرُ بِرَکْعَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 7817","","","كتاب الجمعة"
"7818","(۷۸۱۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ یَحْیَی بْنِ وَثَّابٍ ، أَنَّہُ کَانَ یَؤُمُّہُمْ فِی شَہْرِ رَمَضَانَ فِی الْقِیَامِ وَکَانَ لاَ یُسَلِّمُ إِلاَّ فِی أَرْبَعِ رَکَعَاتٍ۔","","Musannaf Ibn Abi Shaybah 7818","","","كتاب الجمعة"
"7819","(۷۸۱۹) حَدَّثَنَا حَفْصٌ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ : کَانَ عَبْدُ الرَّحْمَنِ بْنُ الأَسْوَدِ یَقُومُ بِنَا لَیْلَۃَ الْفِطْرِ۔","","Musannaf Ibn Abi Shaybah 7819","","","كتاب الجمعة"
"7820","(۷۸۲۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ الْوَلِیدِ ، قَالَ : أَخْبَرَنِی عُمَرُ بْنُ أَیُّوبَ ، قَالَ : أَخْبَرَنِی أَبُو إیَاسٍ مُعَاوِیَۃُ بْنُ قُرَّۃَ ، قَالَ : کُنْتُ نَازِلاً عَلَی عَمْرِو بْنِ النُّعْمَانِ بْنِ مُقَرِّنٍ ، فَلَمَّا حَضَرَ رَمَضَانُ جَائَہُ رَجُلٌ بِأَلْفَیْ دِرْہَمٍ مِنْ قِبَلِ مُصْعَبِ بْنِ الزُّبَیْرِ ، فَقَالَ : إنَّ الأَمِیرَ یُقْرِئُکَ السَّلاَمَ وَیَقُولُ : إنَّا لَمْ نَدَعْ قَارِئًا شَرِیفًا إِلاَّ قَدْ وَصَلَ إلَیْہِ مِنَّا مَعْرُوفٌ فَاسْتَعِنْ بِہَذَیْنِ عَلَی نَفَقَۃِ شَہْرِکَ ہَذَا ، فَقَالَ عَمْرٌو : اقْرَأْ عَلَی الأَمِیرِ السَّلاَمَ وَقُلْ وَاللَّہِ مَا قَرَأْنَا الْقُرْآنَ نُرِیدُ بِہِ الدُّنْیَا وَرَدَّہُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 7820","","","كتاب الجمعة"
"7821","(۷۸۲۱) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنِی أَبِی ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ مَعْقِلٍ : أَنَّہُ صَلَّی بِالنَّاسِ فِی شَہْرِ رَمَضَانَ ، فَلَمَّا کَانَ یَوْمُ الْفِطْرِ بَعَثَ إلَیْہِ عُبَیدُ اللہِ بْنُ زِیَادٍ بِحُلَّۃٍ وَبِخَمْسِمِئَۃِ دِرْہَمٍ فَرَدَّہَا وَقَالَ : إِّنَا لاَ نَأْخُذُ عَلَی الْقُرْآنِ أَجْرًا۔","","Musannaf Ibn Abi Shaybah 7821","","","كتاب الجمعة"
"7822","(۷۸۲۲) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الْمَسْعُودِیُّ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ، قَالَ: لاَ یُؤْخَذُ عَلَی الْقُرْآنِ أَجْرٌ۔","","Musannaf Ibn Abi Shaybah 7822","","","كتاب الجمعة"
"7823","(۷۸۲۳) حَدَّثَنَا جَرِیرٌ ، عَنْ رَجُلٍ : أَنَّ سَعِیدَ بْنَ جُبَیْرٍ قَامَ بِالنَّاسِ فِی رَمَضَانَ فَأَرْسَلَ إلَیْہِ الْحَجَّاجُ بِبُرْنُسٍ فَقَبِلَہُ۔","","Musannaf Ibn Abi Shaybah 7823","","","كتاب الجمعة"
"7824","(۷۸۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ وَاقِدٍ ، عَنْ زَاذَانَ ، قَالَ سَمِعْتُہُ یَقُولُ : مَنْ قَرَأَ الْقُرْآنَ یَأْکُلُ بِہِ جَائَ یَوْمَ الْقِیَامَۃِ وَوَجْہُہُ عَظْمٌ لَیْسَ عَلَیْہِ لَحْمٌ۔","","Musannaf Ibn Abi Shaybah 7824","","","كتاب الجمعة"
"7825","(۷۸۲۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی رَاشِدٍ ، عَنْ عَبْدِ اللہِ بْنِ شِبْلٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اقرَؤُوا الْقُرْآنَ ، وَلاَ تَأْکُلُوا بِہِ ، وَلاَ تَسْتَکْثِرُوا بِہِ ، وَلاَ تَجْفُوا عَنْہُ ، وَلاَ تَغْلُوا فِیہِ۔ (احمد ۳/۴۴۴۔ ابویعلی ۱۵۱۵)","Sahih","Musannaf Ibn Abi Shaybah 7825","","","كتاب الجمعة"
"7826","(۷۸۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ الْحَطِیم ، عَنِ الْحَسَنِ ، قَالَ عُمَرُ : اقْرَؤُوا الْقُرْآنَ وَسَلُوا اللَّہَ بِہِ قَبْلَ أَنْ یَقْرَأَہُ قَوْمٌ یَسْأَلُونَ النَّاسَ بِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 7826","","","كتاب الجمعة"
"7827","(۷۸۲۷) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ حَسَنٍ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَنْ سُوَیْد بْنِ غَفَلَۃَ : أَنَّہُ کَانَ یَنْہَی عَنِ الصَّلاَۃ عَلَی الطَّرِیقِ۔","","Musannaf Ibn Abi Shaybah 7827","","","كتاب الجمعة"
"7828","(۷۸۲۸) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ سِمَاکٍ ، عَنْ سَیَّارِ بْنِ مَعْرُورٍ قَالَ : رَأَی عُمَرُ قَوْمًا یُصَلُّونَ عَلَی الطَّرِیقِ ، فَقَالَ : صَلُّوا فِی الْمَسْجِدِ۔","Da'if","Musannaf Ibn Abi Shaybah 7828","","","كتاب الجمعة"
"7829","(۷۸۲۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنِ الْحَسَنِ ، عَنْ جَابِرٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تُصَلُّوا عَلَی جَوَادِ الطَّرِیقِ ، وَلاَ تَنْزِلُوا عَلَیْہَا فَإِنَّہَا مَأْوَی الْحَیَّاتِ وَالسِّبَاعِ۔ (احمد ۳/۳۸۲۔ عبدالرزاق ۹۲۴۷)","Hasan","Musannaf Ibn Abi Shaybah 7829","","","كتاب الجمعة"
"7830","(۷۸۳۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ الْبُنَانِیِّ ، عَنْ أَنَسِ بْنِ مَالِکٍ، قَالَ: کَانَ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلُّونَ فِی سِکَکِ الأَہْوَازِ ، وَکَانَ أَنَسُ بْنُ مَالِکٍ یُصَلِّی فِی مَمَرِّ خَدَمِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 7830","","","كتاب الجمعة"
"7831","(۷۸۳۱) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، عَنْ رِبْعِیِّ بْنِ حِرَاشٍ ، عَنْ حُذَیْفَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : جُعِلَتْ لَنَا الأَرْضُ کُلُّہَا مَسْجِدًا۔","Sahih","Musannaf Ibn Abi Shaybah 7831","","","كتاب الجمعة"
"7832","(۷۸۳۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا سَیَّارٌ ، قَالَ : حَدَّثَنَا یَزِیدُ الْفَقِیرُ ، قَالَ : أَخْبَرَنَا جَابِرُ بْنُ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : جُعِلَتْ لِی الأَرْضُ طَہُورًا وَمَسْجِدًا فَأَیُّمَا رَجُلٍ مِنْ أُمَّتِی أَدْرَکَتْہُ الصَّلاَۃ فَلْیُصَلِّ حَیْثُ أَدْرَکَتْہُ۔ (بخاری ۳۳۵۔ مسلم ۲)","Sahih","Musannaf Ibn Abi Shaybah 7832","","","كتاب الجمعة"
"7833","(۷۸۳۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ مُجَاہِدٍ وَمِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : جُعِلَتْ لِی الأَرْضُ طَہُورًا وَمَسْجِدًا۔ (بخاری ۲۱۵۲۔ احمد ۱/۳۰۱)","Da'if","Musannaf Ibn Abi Shaybah 7833","","","كتاب الجمعة"
"7834","(۷۸۳۴) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : جُعِلَتْ لِی الأَرْضُ طَہُورًا وَمَسْجِدًا۔ (احمد ۴/۴۱۶)","Sahih","Musannaf Ibn Abi Shaybah 7834","","","كتاب الجمعة"
"7835","(۷۸۳۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنْ أَبِیہِ ، عَنْ أَبِی ذَرٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أَیْنَمَا أَدْرَکَتْکَ الصَّلاَۃ فَصَلِّ فَہُوَ مَسْجِدٌ۔ (بخاری ۳۳۶۶۔ مسلم ۳۷۰۔ احمد ۵/۱۶۰)","Sahih","Musannaf Ibn Abi Shaybah 7835","","","كتاب الجمعة"
"7836","(۷۸۳۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُمَر بْن ذَرٍّ ، عَنْ مُجَاہِدٍ ، عَنْ أَبِی ذَرٍّ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : جُعِلَتْ لِی الأَرْضُ مَسْجِدًا وَطَہُورًا۔ (طیالسی ۴۷۲۔ احمد ۵/۱۶۱)","","Musannaf Ibn Abi Shaybah 7836","","","كتاب الجمعة"
"7837","(۷۸۳۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ مَالِکِ بْنِ الْحَارِثِ ، عَنْ أَبِیہِ قَالَ : کُنَّا مَعَ أَبِی مُوسَی فِی دَارِ الْبَرِیدِ فَحَضَرَتِ الصَّلاَۃ فَصَلَّی بِنَا عَلَی رَوْثٍ وَتِبْنٍ ، فَقُلْنَا تُصَلِّی بِنَا ہُنَا وَالْبَرِّیَّۃُ إلَی جَنْبِکَ ؟ فَقَالَ : الْبَرِّیَّۃُ وَہَا ہُنَا سَوَائٌ۔","Da'if","Musannaf Ibn Abi Shaybah 7837","","","كتاب الجمعة"
"7838","(۷۸۳۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِکْرِمَۃُ بْنُ عَمَّارٍ ، قَالَ : رَأَیْتُُ سَالِمًا کَنَسَ مَکَانًا ، ثُمَّ صَلَّی فِیہِ۔","","Musannaf Ibn Abi Shaybah 7838","","","كتاب الجمعة"
"7839","(۷۸۳۹) حَدَّثَنَا مَالِکُ بْنُ إسْمَاعِیلَ ، قَالَ : حدَّثَنَا مِنْدَلٌ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، عَنْ أَبِی ذَرٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : جُعِلَتْ لِی الأَرْضُ طَہُورًا وَمَسْجِدًا۔ (ابوداؤد ۴۹۰)","Da'if","Musannaf Ibn Abi Shaybah 7839","","","كتاب الجمعة"
"7840","(۷۸۴۰) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، قَالَ : کَانَ النَّاسُ یَقْرَؤُونَ مُتَوَاتِرِینَ فِی رَمَضَانَ کُلُّ قَارِیٍٔ فِی أَثَرِ صَاحِبِہِ حَتَّی وَلِیَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ فَقَالَ : لِیَقْرَأْ کُلُّ قَارِیٍٔ مِنْ حَیْثُ أَحَبَّ۔","","Musannaf Ibn Abi Shaybah 7840","","","كتاب الجمعة"
"7841","(۷۸۴۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَبْدُ الْمَلِکِ بْنُ عُمَیْرٍ ، قَالَ : حَدَّثَنَا جَابِرُ بْنُ سَمُرَۃَ : أَنَّ أُنَاسًا شَکَوْا سَعْدًا إلَی عُمَرَ بْنِ الْخَطَّابِ ، قَالَ وَشَکَوْہُ فِی الصَّلاَۃ ، قَالَ : فَکَتَبَ إلَیْہِ عُمَرُ فَقَدِمَ عَلَیْہِ ، قَالَ : فَذَکَرَ الَّذِی شَکَوْہُ فِیہِ وَذَکَرَ أَنَّہُمْ شَکَوْہُ فِی الصَّلاَۃ ، فَقَالَ سَعْدٌ : إنِّی لأُصَلِّی بِہِمْ صَلاَۃَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، إنِّی لأَرْکُدُ بِہِمْ فِی الأُولَیَیْنِ وَأَحْذِفُ بِہِم فِی الأُخْرَیَیْنِ ، قَالَ : ذَلِکَ الظَّنُّ بِکَ یَا أَبَا إِسْحَاقَ۔ (بخاری ۷۷۰۔ مسلم ۱۵۹)","Sahih","Musannaf Ibn Abi Shaybah 7841","","","كتاب الجمعة"
"7842","(۷۸۴۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی بِشْرٍ الْہُجَیْمِیِّ ، عَنْ أَبِی الصِّدِّیقِ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : کُنَّا نَحْزِرُ قِیَامَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الظُّہْرِ وَالْعَصْرِ ، فَحَزَرْنَا قِیَامَہ فِی الظُّہْرِ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ قَدْرَ ثَلاَثِینَ آیَۃً ، وَحَزَرْنَا قِیَامَہُ فِی الرَّکْعَتَیْنِ الأُخْرَیَیْنِ عَلَی النِّصْفِ مِنْ ذَلِکَ ، وَحَزَرْنَا قِیَامَہُ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ مِنَ الْعَصْرِ عَلَی قَدْرِ الأُخْرَیَیْنِ مِنَ الظُّہْرِ ، وَحَزَرْنَا قِیَامَہُ فِی الرَّکْعَتَیْنِ الأُخْرَیَیْنِ مِنَ الْعَصْرِ عَلَی النِّصْفِ مِنْ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 7842","","","كتاب الجمعة"
"7843","(۷۸۴۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی قَتَادَۃَ ، عَنْ أَبِیہِ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْرَأُ بِنَا فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ مِنَ الظُّہْرِ وَیُسْمِعُنَا الآیَۃَ أَحْیَانًا وَیُطِیلُ الأُولَی ، وَیَقْصِرُ فِی الثَّانِیَۃِ ، وَکَانَ یَفْعَلُ ذَلِکَ فِی صَلاَۃِ الصُّبْحِ یُطِیلُ فِی الأُولَی وَیَقْصِرُ فِی الثَّانِیَۃِ ، وَکَانَ یَقْرَأُ بِنَا فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ مِنَ الْعَصْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 7843","","","كتاب الجمعة"
"7844","(۷۸۴۴) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ : أَنَّ عُمَرَ کَانَ یُصَلِّی الظُّہْرَ عِنْدَ زَوَالِ الشَّمْسِ وَیُطِیلُ أَوَّلَ رَکْعَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 7844","","","كتاب الجمعة"
"7845","(۷۸۴۵) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ، قَالَ: صَلَّیْتُ خَلْفَ الْقَاسِمِ، فَکَانَ یُطِیلُ الأُولَیَیْنِ أَطْوَلَ مِنَ الأُخْرَیَیْنِ الأُولَیَیْنِ مِنَ الظُّہْرِ وَالأُولَیَیْنِ مِنَ الْعَصْرِ وَالأُولَیَیْنِ مِنَ الْمَغْرِبِ وَالأُولَیَیْنِ مِنَ الْعِشَائِ۔","","Musannaf Ibn Abi Shaybah 7845","","","كتاب الجمعة"
"7846","(۷۸۴۶) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، قَالَ : صَلَّیْتُ خَلْفَ سَالِمٍ ، فَکَانَ یَفْعَلُ مِثْلَ ذَلِکَ وَکَانَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ یَفْعَلُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 7846","","","كتاب الجمعة"
"7847","(۷۸۴۷) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنِ الضَّحَّاکِ بْنِ عُثْمَانَ ، قَالَ : رَأَیْتُُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یُصَلِّی بِنَا الظُّہْرَ فَیُطِیلُ فِی الأُولَیَیْنِ وَیُخَفِّفُ الأُخْرَیَیْنِ وَیُحَفِّفُ فِی الْعَصْرِ۔","","Musannaf Ibn Abi Shaybah 7847","","","كتاب الجمعة"
"7848","(۷۸۴۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یزَیْدِ بْنِ جَابِرٍ ، عَنْ مَکْحُولٍ : أَنَّہُ کَانَ یُطَوِّلُ فِی أَوَّلِ رَکْعَۃٍ۔","","Musannaf Ibn Abi Shaybah 7848","","","كتاب الجمعة"
"7849","(۷۸۴۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، عَنْ عُمَرَ بْنِ أَبِی سَلَمَۃ ، عَنْ أَبِیہِ ، قَالَ : کَانَ عُثْمَانُ بْنُ عَفَّانَ یُطِیلُ الرَّکْعَتَیْنِ الأُولَیَیْنِ مِنَ الظُّہْرِ یَقْرَأُ فِیہِمَا بِسُورَۃِ الْبَقَرَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 7849","","","كتاب الجمعة"
"7850","(۷۸۵۰) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ سِمَاکٍ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا صَلَّی الْفَجْرَ قَعَدَ فِی مَجْلِسِہِ حَتَّی تَطْلُعَ الشَّمْسُ۔ (مسلم ۴۶۴۔ ابوداؤد ۱۲۸۸)","Hasan","Musannaf Ibn Abi Shaybah 7850","","","كتاب الجمعة"
"7851","(۷۸۵۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُوسَی بْنِ عَبْدِ اللہِ بْنِ إِسْحَاقَ بْنِ طَلْحَۃَ ، عَنْ مُوسَی بْنِ طَلْحَۃَ ، قَالَ : کَانَ طَلْحَۃُ یَثْبُتُ فِی مُصَلاَّہُ حَیْثُ صَلَّی فَلاَ یَبْرَحُ حَتَّی تَحْضُرَ السُّبْحَۃُ فَیُسَبِّحُ۔","Da'if","Musannaf Ibn Abi Shaybah 7851","","","كتاب الجمعة"
"7852","(۷۸۵۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : بَلَغَنِی عَنْ رَجُلٍ مِنْ بَنِی تَمِیمٍ ، أَنَّہُ دَخَلَ عَلَی الْحَسَنِ بْنِ عَلِیٍّ وَہُوَ قَاعِدٌ فِی مُصَلاَّہُ ، وَقَالَ : مَا مِنْ مُسْلِمٍ یُصَلِّی الصُّبْحَ ، ثُمَّ یَقْعُدُ فِی مُصَلاَّہُ إِلاَّ کَانَ لَہُ حِجَابًا مِنَ النَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 7852","","","كتاب الجمعة"
"7853","(۷۸۵۳) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ أَبِی سِنَانٍ ، عَنِ الْعَلاَئِ بْنِ بَدْرٍ ، عَنْ أَبِی الشَّعْثَائِ الْمُحَارِبِیِّ ، عَنْ سَلْمَانَ ، قَالَ : إذَا صَلَّیْتُمُ الْغَدَاۃَ فَاذْکُرُوا اللَّہَ حَتَّی تَطْلُعَ الشَّمْسُ ، فَإِنْ لَمْ تَفْعَلُوا فَنَامُوا فَإِنَّ النَّائِمَ سَالِمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 7853","","","كتاب الجمعة"
"7854","(۷۸۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الأَشْہَبِ ، عَنِ الْحَسَنِ : أَنَّ أَبَا ہُرَیْرَۃَ لَقِیَ رَجُلاً ، فَقَالَ : کَأَنَّک لَسْتَ مِنْ أَہْلِ الْبَلَدِ ؟ قَالَ : أَجَلْ ، قَالَ : أَلاَ أُحَدِّثُکَ حَدِیثًا سَمِعْتُہُ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَعَلَّک أَنْ تنْتَفِعَ بِہِ؟ سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : أَوَّلُ مَا یُحَاسَبُ بِہِ الْعَبْدُ الصَّلاَۃ ، فَإِنْ کَانَ أَتَمَّہَا وَإلاَّ قِیلَ لِلْمَلاَئِکَۃِ أَکْمِلُوا صَلاَتَہُ مِنْ تَطَوُّعِہِ ، قَالَ الْحَسَنُ : وَسَائِرُ الأَعْمَالِ عَلَی ذَلِکَ۔ (بخاری ۱۵۹۳۔ ابویعلی ۶۱۹۷)","Hasan","Musannaf Ibn Abi Shaybah 7854","","","كتاب الجمعة"
"7855","(۷۸۵۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، عَنْ تَمِیمٍ الدَّارِیِّ ، قَالَ : إنَّ أَوَّلَ مَا یُحَاسَبُ بِہِ الْعَبْدُ الصَّلاَۃ ، فَإِنْ أَتَمَّہَا وَالأَ قِیلَ : اُنْظُرُوا لَہُ تَطَوُّعٌ ، فَإِنْ کَانَ لَہُ تَطَوُّعٌ فَأَکْمِلُوا الْمَکْتُوبَۃَ مِنَ التَّطَوُّعِ۔ (احمد ۱۰۳۔ دارمی ۱۳۵۵)","Sahih","Musannaf Ibn Abi Shaybah 7855","","","كتاب الجمعة"
"7856","(۷۸۵۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ تَمِیمِ بْنِ سَلَمَۃَ ، قَالَ : أَوَّلُ مَایُسْأَلُ عَنْہُ الْعَبْدُ یُسْئلُ عَنْ صَلاَتِہِ ، فَإِنْ تُقُبِّلَتْ مِنْہُ تُقُبِّلَ مِنْہُ سَائِرُ عَمَلِہِ وَإِنْ رُدَّتْ عَلَیْہِ رُدَّ عَلَیْہِ سَائِرُ عَمَلِہِ۔","","Musannaf Ibn Abi Shaybah 7856","","","كتاب الجمعة"
"7857","(۷۸۵۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ تَوْبَۃَ الْعَنْبَرِیِّ ، عَنْ مُوَرِّقٍ الْعِجْلِیّ ، قَالَ : قُلْتُ لِاِبْنِ عُمَرَ : أَتُصَلِّی الضُّحَی ؟ قَالَ : لاَ ، قُلْتُ : صَلاَّہَا عُمَرُ ؟ قَالَ : لاَ ، قُلْتُ : صَلاَّہَا أَبُو بَکْرٍ ؟ قَالَ : لاَ ، قُلْتُ صَلاَّہَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : لاَ أَخَالُُ۔ (بخاری ۱۱۷۵۔ احمد ۲/۲۳)","Sahih","Musannaf Ibn Abi Shaybah 7857","","","كتاب الجمعة"
"7858","(۷۸۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ عُمَرَ قَالَ : مَا صَلَّیْتُ الضُّحَی مُذْ أَسْلَمْتُ إِلاَّ أَنْ أَطُوفَ بِالْبَیْتِ۔","Sahih","Musannaf Ibn Abi Shaybah 7858","","","كتاب الجمعة"
"7859","(۷۸۵۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیرِیِّ ، عَنِ الْحَکَمِ بْنِ الأَعْرَجِ قَالَ : سَأَلْتُ ابْن عُمَرَ ، عَنْ صَلاَۃِ الضُّحَی وَہُوَ مُسْتَنِدٌ ظَہْرَہُ إلَی حُجْرَۃِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : بِدْعَۃٌ وَنِعْمَتِ الْبِدْعَۃُ۔ (بخاری ۱۷۷۵۔ مسلم ۲۲۰)","Sahih","Musannaf Ibn Abi Shaybah 7859","","","كتاب الجمعة"
"7860","(۷۸۶۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : لَمْ یُخْبِرْنِی أَحَدٌ مِنَ النَّاسِ أَنَّہُ رَأَی ابْنَ مَسْعُودٍ یُصَلِّی الضُّحَی۔","","Musannaf Ibn Abi Shaybah 7860","","","كتاب الجمعة"
"7861","(۷۸۶۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، قَالَ : کُنَّا نَقْرَأُ فِی الْمَسْجِدِ فَیَثْبُتُ النَّاسُ فِی الْقِرَائَۃِ بَعْدَ قِیَامِ ابْنِ مَسْعُودٍ ، ثُمَّ نَقُومُ فَنُصَلِّی الضُّحَی ، فَبَلَغَ ذَلِکَ ابْنَ مَسْعُودٍ ، فَقَالَ : عِبَادَ اللہِ لِمَ تُحَمِّلُوا عِبَادَ اللہِ مَا لَمْ یُحَمِّلْہُمُ اللَّہُ إِنْ کُنْتُمْ لاَ بُدَّ فَاعِلِینَ فَفِی بُیُوتِکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 7861","","","كتاب الجمعة"
"7862","(۷۸۶۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنِی أَبِی وَإِسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ التَّمِیمِیِّ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنْ صَلاَۃِ الضُّحَی فَقَالَ : وَلِلضُّحَی صَلاَۃ؟۔","Da'if","Musannaf Ibn Abi Shaybah 7862","","","كتاب الجمعة"
"7863","(۷۸۶۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ قَالَتْ : لَمْ یَکُنِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُسَبِّحُ سُبْحَۃَ الضُّحَی ، قَالَتْ : وَکَانَ یَتْرُکُ أَشْیَائَ کَرَاہَۃَ أَنْ یُسْتَنَّ بِہِ فِیہَا۔ (احمد ۱۷۰)","Sahih","Musannaf Ibn Abi Shaybah 7863","","","كتاب الجمعة"
"7864","(۷۸۶۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ یُصَلِّی سُبْحَۃَ الضُّحَی وَإِنِّی لأُسَبِّحُہَا۔ (بخاری ۱۱۷۷۔ ابوداؤد ۱۲۸۷)","Sahih","Musannaf Ibn Abi Shaybah 7864","","","كتاب الجمعة"
"7865","(۷۸۶۵) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ مَنْصُورٍ، عَنْ إِبْرَاہِیمَ، عَن عَلْقَمَۃَ، قَالَ: کَانَ لاَ یُصَلِّی الضُّحَی۔","","Musannaf Ibn Abi Shaybah 7865","","","كتاب الجمعة"
"7866","(۷۸۶۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَاجِبُ بْنُ عُمَرَ ، عَنِ الْحَکَمِ بْنِ الأَعْرَجِ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنْ صَلاَۃِ الضُّحَی ؟ فَقَالَ : بِدْعَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 7866","","","كتاب الجمعة"
"7867","(۷۸۶۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ عَباس ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : إنِّی لأَدَعُ صَلاَۃَ الضُّحَی وَإِنِّی أَشْتَہِیہَا۔","","Musannaf Ibn Abi Shaybah 7867","","","كتاب الجمعة"
"7868","(۷۸۶۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا النَّہَّاسُ بْنُ قَہْمٍ أَبُو الْخَطَّابِ ، عَنْ شَدَّادٍ أَبِی عَمَّارٍ الشَّامِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ حَافَظَ عَلَی شُفْعَۃِ الضُّحَی غُفِرَتْ لَہُ ذُنُوبُہُ وَإِنْ کَانَتْ مِثْلَ زَبَدِ الْبَحْرِ۔ (احمد ۴۹۷)","Da'if","Musannaf Ibn Abi Shaybah 7868","","","كتاب الجمعة"
"7869","(۷۸۶۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنِ الْقَاسِمِ بْنِ عَوْفٍ الشَّیْبَانِیِّ ، عَنْ زَیْدِ بْنِ أَرَقْمَ ، قَالَ: خَرَجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی أَہْلِ قُبَائٍ وَہُمْ یُصَلُّونَ صَلاَۃَ الضُّحَی ، فَقَالَ : صَلاَۃُ الأَوَّابِینَ إذَا رَمِضَتِ الْفِصَالُ مِنَ الضُّحَی۔ (مسلم ۱۴۴۔ احمد ۴/۳۶۷)","Sahih","Musannaf Ibn Abi Shaybah 7869","","","كتاب الجمعة"
"7870","(۷۸۷۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا کَہْمَسُ بْنُ الْحَسَنِ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ الْعُقَیْلِیِّ ، قَالَ : قُلْتُ لِعَائِشَۃَ : أَکَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی الضُّحَی ؟ قَالَتْ : لاَ ، إِلاَّ أَنْ یَجِیئَ مِنْ مَغِیبِہِ۔ (مسلم ۷۶۔ احمد ۶/۱۷۱)","Sahih","Musannaf Ibn Abi Shaybah 7870","","","كتاب الجمعة"
"7871","(۷۸۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : مَا رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی الضُّحَی إِلاَّ مَرَّۃً۔ (احمد ۲/۴۴۶۔ نسائی ۴۷۷)","Hasan","Musannaf Ibn Abi Shaybah 7871","","","كتاب الجمعة"
"7872","(۷۸۷۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ سَعدِ بْنِ إبْرَاہِیمَ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ : أَنَّ عَائِشَۃَ کَانَتْ تُصَلِّی الضُّحَی صَلاَۃً طَوِیلَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 7872","","","كتاب الجمعة"
"7873","(۷۸۷۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو الْمِنْہَالِ الطَّائِیُّ نَصْرُ بْنُ أَوْسٍ ، عَنْ عَبْدِ اللہِ بْنِ زَیْدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ لِی : عَلَیْک بِسَجْدَتَیِ الضُّحَی ہُمَا خَیْرٌ لَکَ مِنْ نَاقَتَیْنِ دَہْمَاوَیْنِ مِنْ نَتَاجِ بَنِی بُحتُر۔","Da'if","Musannaf Ibn Abi Shaybah 7873","","","كتاب الجمعة"
"7874","(۷۸۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ أُسَامَۃ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِی الرَّبَابِ : أَنَّ أَبَا ذَرٍّ صَلَّی الضُّحَی فَأَطَالَ۔","Da'if","Musannaf Ibn Abi Shaybah 7874","","","كتاب الجمعة"
"7875","(۷۸۷۵) حَدَّثَنَا إسْمَاعِیلُ ، عَنْ حَبِیبِ بْنِ الشَّہِیدِ ، قَالَ : سُئِلَ عِکْرِمَۃُ ، عَنْ صَلاَۃِ ابْنِ عَبَّاسٍ الضُّحَی ؟ قَالَ : کَانَ یُصَلِّیہَا الْیَوْمَ وَیَدَعُہَا الْعَشْرَ۔","Sahih","Musannaf Ibn Abi Shaybah 7875","","","كتاب الجمعة"
"7876","(۷۸۷۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، قَالَ : کَانَ سَعِیدُ بْنُ الْمُسَیَّبِ یُصَلِّی الضُّحَی۔","","Musannaf Ibn Abi Shaybah 7876","","","كتاب الجمعة"
"7877","(۷۸۷۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یُصَلُّونَ الضُّحَی وَیَدَعُونَ۔","","Musannaf Ibn Abi Shaybah 7877","","","كتاب الجمعة"
"7878","(۷۸۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ أوَغَیْرِہِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یُدِیمُوا صَلاَۃَ الضُّحَی مِثْلَ الْمَکْتُوبَۃِ۔","","Musannaf Ibn Abi Shaybah 7878","","","كتاب الجمعة"
"7879","(۷۸۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، عَنْ عَائِشَۃَ ، أَنَّہَا کَانَتْ تُغْلِقُ عَلَیْہَا بَابَہَا ، ثُمَّ تُصَلِّی الضُّحَی۔","Sahih","Musannaf Ibn Abi Shaybah 7879","","","كتاب الجمعة"
"7880","(۷۸۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ شَرِیکٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ سُئِلَ عَنْ صَلاَۃِ الضُّحَی ، فَقَالَ : إِنَّہَا لَفِی کِتَابِ اللہِ ، وَلاَ یَغُوصُ عَلیہَا إلا غَوَّاصٌ ، ثُمَّ قَرَأَ : (فِی بُیُوتٍ أَذِنَ اللَّہُ أَنْ تُرْفَعَ وَیُذْکَرَ فِیہَا اسْمُہُ یُسَبِّحُ لَہُ فِیہَا بِالْغُدُوِّ وَالأَصَالِ) ۔","Sahih","Musannaf Ibn Abi Shaybah 7880","","","كتاب الجمعة"
"7881","(۷۸۸۱) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا شَرِیکٌ، عَنْ سَالِمٍ الأَفْطَسِ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ: أَنَّہُ صَلَّی الضُّحَی فِی الْکَعْبَۃِ۔","","Musannaf Ibn Abi Shaybah 7881","","","كتاب الجمعة"
"7882","(۷۸۸۲) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ مُطَہَّرِ بْنِ جُوَیْرِیَۃَ ، قَالَ : رَأَیْتُُ الضَّحَّاکَ یُصَلِّی الضُّحَی ، وَرَأَیْتُ أَبَا مِجْلَزٍ یُصَلِّی فِی مَنْزِلِہِ الضُّحَی۔","","Musannaf Ibn Abi Shaybah 7882","","","كتاب الجمعة"
"7883","(۷۸۸۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یَحْیَی بْنُ مُسْلِمٍ الْہَمْدَانِیُّ ، عَنْ سَعِیدِ بْنِ عَمْرٍو الْقُرَشِیِّ ، قَالَ : أَتْبَعَنِی أبی عَبْدَ اللہِ بْنَ عُمَرَ لأَتَعَلَّمَ مِنْہُ فَمَا رَأَیْتُہُ یُصَلِّی السُّبْحَۃَ ، وَکَانَ إذَا رَآہُمْ یُصَلُّونَہَا قَالَ : مِنْ أَحْسَنِ مَا أَحْدَثُوا سُبْحَتُہُمْ ہَذِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 7883","","","كتاب الجمعة"
"7884","(۷۸۸۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ الْعَوَّامِ ، عَنْ سُلَیْمَانَ بْنِ أَبِی سُلَیْمَانَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أَوْصَانِی خَلِیلِی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ أُصَلِّیَ الضُّحَی فَإِنَّہَا صَلاَۃُ الأَوَّابِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 7884","","","كتاب الجمعة"
"7885","(۷۸۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سِمَاکٍ ، عَنْ عَمِّہِ سَلَمَۃَ بْنِ سِمَاکٍ ، قَالَ : سَمِعْتُ عُمَرَ بْنَ الْخَطَّابِ یَقُولُ : أَضْحُوا عِبَادَ اللہِ بِصَلاَۃِ الضُّحَی۔","Da'if","Musannaf Ibn Abi Shaybah 7885","","","كتاب الجمعة"
"7886","(۷۸۸۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یُوسُفُ بْنُ صُہَیْبٍ ، عَنْ حَبِیبِ بْنِ یَسَارٍ ، عَنْ أَبِی رَمْلَۃَ الأَزْدِیِّ ، عَنْ عَلِیٍّ: أَنَّہُ رَآہُمْ یُصَلُّونَ الضُّحَی عِنْدَ طُلُوعِ الشَّمْسِ ، فَقَالَ : ہَلاَّ تَرَکُوہَا حَتَّی إذَا کَانَتِ الشَّمْسُ قِیدْ رُمْحٍ أَوْ رُمْحَیْنِ ، صَلَّوْہَا فَذَلکَ صَلاَۃُ الأَوَّابِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 7886","","","كتاب الجمعة"
"7887","(۷۸۸۷) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی زَیْدٍ ، عَنْ شُعْبَۃَ مَوْلَی ابْنِ عَبَّاسٍ ، قَالَ : کَانَ ابْنُ عَبَّاسٍ یَقُولُ لِی : سَقَطَ الْفَیْئُ ؟ فَإِذَا قُلْتُ نَعَمْ قَامَ فَسَبَّحَ۔","Da'if","Musannaf Ibn Abi Shaybah 7887","","","كتاب الجمعة"
"7888","(۷۸۸۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، قَالَ : کَانَ أَبُو سَلَمَۃَ لاَ یُصَلِّی الضُّحَی حَتَّی تَمِیلَ الشَّمْسُ ، قَالَ : وَکَانَ عُرْوَۃُ یَجِیئُ فَیُصَلِّی ، ثُمَّ یَجْلِسُ۔","","Musannaf Ibn Abi Shaybah 7888","","","كتاب الجمعة"
"7889","(۷۸۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ دِثَارٍ الْقَطَّانِ ، عَنِ النُّعْمَانِ بْنِ نَافِذٍ : أَنَّ عَلِیًّا خَرَجَ فَرَأَی قوْمًا یُصَلُّونَ الضُّحَی عِنْدَ طُلُوعِ الشَّمْسِ ، فَقَالَ : مَا لَہُمْ نَحَرُوہَا نَحَرَہُمُ اللَّہُ فَہَلاَّ تَرَکُوہَا حَتَّی إذَا کَانَتْ بِالْجَبِینِ صَلَّوْا فَتِلْکَ صَلاَۃُ الأَوَّابِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 7889","","","كتاب الجمعة"
"7890","(۷۸۹۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی خَالِدٍ ، عَنْ أَبِی صَالِحٍ مَوْلَی أُمِّ ہَانِیئٍ ، عَنْ أُمِّ ہَانِیئٍ ، قَالَتْ : دَخَلَ عَلَیَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیْتِی یَوْمَ فَتْحِ مَکَّۃَ فَوَضَعْتُ لَہُ مَائً فَاغْتَسَلَ ، ثُمَّ صَلَّی ثَمَانَ رَکَعَاتٍ صَلاَۃَ الضُّحَی لَمْ یُصَلِّہِنَّ قَبْلَ یَوْمِہِ ، وَلاَ بَعْدَہُ۔ (طبرانی ۱۰۰۳۔ احمد ۶/۳۴۲)","Da'if","Musannaf Ibn Abi Shaybah 7890","","","كتاب الجمعة"
"7891","(۷۸۹۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : لَمْ یُخْبِرْنَا أَحَدٌ مِنَ النَّاسِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی الضُّحَی إِلاَّ أُمَّ ہَانِیئٍ فَإِنَّہَا قَالَتْ : دَخَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیْتِی یَوْمَ فَتْحِ مَکَّۃَ فَاغْتَسَلَ ، ثُمَّ صَلَّی ثَمَانِ رَکَعَاتٍ یُخَفِّفُ فِیہِنَّ الرُّکُوعَ وَالسُّجُودَ ، لَمْ أَرَہُ صَلاَّہُنَّ قَبْلَ یَوْمَئِذٍ وَلاَ بَعْدَہُ۔ (بخاری ۱۱۰۳۔ ابوداؤد ۱۲۸۵)","Sahih","Musannaf Ibn Abi Shaybah 7891","","","كتاب الجمعة"
"7892","(۷۸۹۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ یَزِیدَ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : أَدْرَکْتُ النَّاسَ وَہُمْ مُتَوَافِرُونَ ، أَوْ مُتَوَافُونَ فَلَمْ یُخْبِرْنِی أَحَدٌ أَنَّہُ صَلَّی الضُّحَی إِلاَّ أُمُّ ہَانِیئٍ ، فَإِنَّہَا أَخْبَرَتْنِی أَنَّہُ صَلاَّہَا ثَمَانَ رَکَعَاتٍ۔","Da'if","Musannaf Ibn Abi Shaybah 7892","","","كتاب الجمعة"
"7893","(۷۸۹۳) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَنْ أَبِی مُرَّۃَ مَوْلَی أُمِّ ہَانِیئٍ ابْنَۃِ أَبِی طَالِبٍ ، عَنْ أُمِّ ہَانِیئٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی الضُّحَی ثَمَانَ رَکَعَاتٍ۔ (ترمذی ۱۵۷۹۔ احمد ۶/۳۴۳)","","Musannaf Ibn Abi Shaybah 7893","","","كتاب الجمعة"
"7894","(۷۸۹۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ الْمُنْکَدِرِ ، عَنِ ابن رُمَیْثَۃَ ، عَنْ جَدَّتِہِ ، قَالَتْ : دَخَلْتُ عَلَی عَائِشَۃَ وَہِیَ تُصَلِّی مِنَ الضُّحَی فَصَلَّتْ ثَمَانِ رَکَعَاتٍ۔","Da'if","Musannaf Ibn Abi Shaybah 7894","","","كتاب الجمعة"
"7895","(۷۸۹۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ ابْنِ إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَنْ سَعِیدِ بْنِ مَرْجَانَۃَ ، قَالَ : جَلَسْتُ وَرَائَ سَعْدِ بْنِ مَالِکٍ وَہُوَ یُسَبِّحُ الضُّحَی فَرَکَعَ ثَمَانَ رَکَعَاتٍ أَعُدُّہُنَّ لاَ یَقْعُدُ فِیہِنَّ حَتَّی قَعَدَ فِی آخِرِہِنَّ ، فَتَشَہَّدَ ثُمَّ سَلَّمَ وَانْطَلَقَ۔","","Musannaf Ibn Abi Shaybah 7895","","","كتاب الجمعة"
"7896","(۷۸۹۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ، عَنْ تَمِیمَۃَ ابنَۃ دُہَیْمٍ: أَنَّہَا رَأَتْ عَائِشَۃَ صَلَّتْ مِنَ الضُّحَی سِتَّ رَکَعَاتٍ۔","Da'if","Musannaf Ibn Abi Shaybah 7896","","","كتاب الجمعة"
"7897","(۷۸۹۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ عَجْلاَنَ ، عَنِ الْقَعْقَاعِ بْنِ حَکِیمٍ ، عَنْ جَدَّتِہِ رُمَیْثَۃَ ، قَالَتْ : دَخَلْتُ عَلی عَائِشَۃَ بَیْتًا کَانَتْ تَخْلُو فِیہِ ، فَرَأَیْتُہَا صَلَّتْ مِنَ الضُّحَی ثَمَانَ رَکَعَاتٍ۔","Hasan","Musannaf Ibn Abi Shaybah 7897","","","كتاب الجمعة"
"7898","(۷۸۹۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ رَجُلٍ ، عَنْ أُمِّ سَلَمَۃَ : أَنَّہَا کَانَتْ تُصَلِّی الضُّحَی ، ثَمَانَ رَکَعَاتٍ وَہِیَ قَاعِدَۃٌ ، فَقِیلَ لَہَا : إنَّ عَائِشَۃَ تُصَلِّی أَرْبَعًا ، فَقَالَتْ : إنَّ عَائِشَۃَ امْرَأَۃٌ شَابَّۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 7898","","","كتاب الجمعة"
"7899","(۷۸۹۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ : أَنَّہُ کَانَ إذَا حَضَرَ الْمِصْرَ صَلَّی الضُّحَی أَرْبَعًا۔","","Musannaf Ibn Abi Shaybah 7899","","","كتاب الجمعة"
"7900","(۷۹۰۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ حَکِیمِ بْنِ حَکِیمٍ ، عَنْ عَلِیِّ بْنِ عَبْدِ الرَّحْمَنِ ، عنْ حُذَیْفَۃَ ، قَالَ : خَرَجْتُ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی حَرَّۃِ بَنِی مُعَاوِیَۃَ فَصَلَّی الضُّحَی ثَمَانَ رَکَعَاتٍ طَوَّلَ فِیہِنَّ۔","Da'if","Musannaf Ibn Abi Shaybah 7900","","","كتاب الجمعة"
"7901","(۷۹۰۱) حَدَّثَنَا ابْنُ مُسْہِرٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أَوْصَانِی خَلِیلِی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِرَکْعَتَیِ الضُّحَی۔","Da'if","Musannaf Ibn Abi Shaybah 7901","","","كتاب الجمعة"
"7902","(۷۹۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ مَوْہَبٍ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ الْقُرَظِیِّ ، قَالَ : مَنْ قَرَأَ فِی سُبْحَۃِ الضُّحَی بِـ {قُلْ ہُوَ اللَّہُ أَحَدٌ} عَشْرَ مَرَّاتٍ بُنِیَ لَہُ بَیْتٌ فِی الْجَنَّۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 7902","","","كتاب الجمعة"
"7903","(۷۹۰۳) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی الأَحْوَص ، عَنْ أَبِی ذَرٍّ ، قِیلَ لِسُفْیَانَ : عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : نَعَمْ ، قَالَ : إذَا قَامَ أَحَدُکُمْ إلَی الصَّلاَۃ فَلاَ یَمْسَحِ الْحَصَی۔ (ابوداؤد ۹۴۲۔ احمد ۵/۱۵۰)","Hasan","Musannaf Ibn Abi Shaybah 7903","","","كتاب الجمعة"
"7904","(۷۹۰۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ : أَنَّہُ کَانَ یَکْرَہُ مَسْحَ الْحَصَی۔","Da'if","Musannaf Ibn Abi Shaybah 7904","","","كتاب الجمعة"
"7905","(۷۹۰۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُثْمَانَ بْنِ الحَکَمِ ، عَنْ شُرَحْبِیلَ أَبِی سَعدٍ ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ : مَا أُحِبُّ أَنَّ لِی حُمْرَ النَّعَمِ وَأَنِّی مَسَحْتُ مَکَانَ جَبِینِی مِنَ الْحَصَی ، إِلاَّ أَنْ یَغْلِبَنِی فَأَمْسَحَ مَسْحَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 7905","","","كتاب الجمعة"
"7906","(۷۹۰۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ زُہَیْرٍ ، عَنْ جَابِرٍ ، عَنْ سَالِمِ بْنِ عَبْدِ اللہِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ زَیْدِ بْنِ الْخَطَّابِ : أَنَّہُ صَلَّی إلَی جَنْبِ عُمَرَ فَمَسَحَ الْحَصَی فَأمْسَکَ بِیَدِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 7906","","","كتاب الجمعة"
"7907","(۷۹۰۷) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی عَطِیَّۃَ ، عَنْ أَبِی صَالِحٍ ، قَالَ : إذَا سَجَدْتَ فَلاَ تَمْسَحِ الْحَصَی فَإِنَّ کُلَّ حَصَاۃٍ تُحِبُّ أَنْ یُسْجَدَ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 7907","","","كتاب الجمعة"
"7908","(۷۹۰۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عِیسَی بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ أَبِیہِ ، عَنْ أَبِی ذَرٍّ قَالَ : سَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ أَشْیَائَ حَتَّی سَأَلْتُہُ عَنْ مَسْحِ الْحَصَی فَقَالَ : مَرَّۃً وَاحِدَۃً وَالأَ فَدَعْ۔ (عبدالرزاق ۲۴۰۶۔ طیالسی ۴۷۰)","Da'if","Musannaf Ibn Abi Shaybah 7908","","","كتاب الجمعة"
"7909","(۷۹۰۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنْ شَیْخٍ یُقَالُ لَہُ ہِلاَلٌ ، عَنْ حُذَیْفَۃَ ، قَالَ : سَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ کُلِّ شَیْئٍ حَتَّی عَن مَسْحِ الْحَصَی فَقَالَ : وَاحِدَۃً ، أَوْ دَعْ۔ (احمد ۳۸۵)","Da'if","Musannaf Ibn Abi Shaybah 7909","","","كتاب الجمعة"
"7910","(۷۹۱۰) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃَ بْنِ عَبْدِ الرَّحْمَنِ، عَنْ مُعَیْقِیبٍ ، قَالَ : ذُکِرَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَسْحُ الْحَصَی فَقَالَ : إِنْ کُنْتَ لاَ بُدَّ فَاعِلاً فَوَاحِدَۃً۔ (بخاری ۱۲۰۷۔ ابوداؤد ۹۴۳)","Sahih","Musannaf Ibn Abi Shaybah 7910","","","كتاب الجمعة"
"7911","(۷۹۱۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ شُرَحْبِیلَ أَبِی سَعدٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : سَأَلْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ مَسْحِ الْحَصَی فِی الصَّلاَۃ فَقَالَ : وَاحِدَۃٌ وَلأَنْ تُمْسِکَ عَنْہَا خَیْرٌ لَکَ مِنْ مِئَۃ نَاقَۃٍ کُلُّہَا سُودُ الْحَدَقَۃِ۔ (احمد ۳/۳۰۰۔ احمد ۳۲۸)","Da'if","Musannaf Ibn Abi Shaybah 7911","","","كتاب الجمعة"
"7912","(۷۹۱۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ مُحَمَّدِ بْنِ طَلْحَۃَ بْنِ رُکَانَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عَیَّاشِ بْنِ أَبِی رَبِیعَۃَ ، قَالَ : مَرَّ بِی أَبُو ذَرٍّ وَأَنَا أُصَلِّی قَالَ : إنَّ الأَرْضَ لاَ تُمْسَحُ إِلاَّ وَاحِدَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 7912","","","كتاب الجمعة"
"7913","(۷۹۱۳) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ : کَانَ عَبْدُ اللہِ یُرَخِّصُ فِی مَسْحَۃٍ وَاحِدَۃٍ لِلْحَصَی۔","","Musannaf Ibn Abi Shaybah 7913","","","كتاب الجمعة"
"7914","(۷۹۱۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ عَمِّہِ ، قَالَ : رَأَیْتُُ ابْنَ مَسْعُودٍ یُسَوِّی الْحَصَی بِیَدِہِ وَہُوَ یُصَلِّی خَبَطَہُ بِیَدِہِ ، ثُمَّ سَجَدَ۔","Sahih","Musannaf Ibn Abi Shaybah 7914","","","كتاب الجمعة"
"7915","(۷۹۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ عَبْدَ اللہِ بْنَ مَسْعُودٍ خبَطَ الْحَصَی بِیَدِہِ ، ثُمَّ سَجَدَ۔","Sahih","Musannaf Ibn Abi Shaybah 7915","","","كتاب الجمعة"
"7916","(۷۹۱۶) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنْ أَبِی ہُرَیْرَۃَ : أَنَّہُ کَانَ یُرَخِّصُ أن تُسَوَّی الْحَصَی فِی الصَّلاَۃ مَرَّۃً وَاحِدَۃً ، قَالَ : وَإِنْ لَمْ یَفْعَلْ فَہُوَ أَحَبُّ إلَیَّ۔","Da'if","Musannaf Ibn Abi Shaybah 7916","","","كتاب الجمعة"
"7917","(۷۹۱۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ مِمَّا یُسَوِّی الْحَصَی بِرِجْلِہِ وَہُوَ قَائِمٌ فِی الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 7917","","","كتاب الجمعة"
"7918","(۷۹۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مَالِکُ بْنُ أَنَسٍ ، عَنْ أَبِی جَعْفَرٍ الْقَارِیِٔ مَوْلَی ابْنِ عَیَّاشٍ ، قَالَ : رَأَیْتُُ ابْنَ عُمَرَ یَمْسَحُ الْحَصَی مَسْحًا خَفِیفًا فِی الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 7918","","","كتاب الجمعة"
"7919","(۷۹۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : رَأَیْتُُ ابْنَ عُمَرَ یُسَوِّی الْحَصَی بِرِجْلِہِ فِی الصَّلاَۃ۔","Da'if","Musannaf Ibn Abi Shaybah 7919","","","كتاب الجمعة"
"7920","(۷۹۲۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : قَالَ حُذَیْفَۃُ : ہَکَذَا وَاحِدَۃً ، أَوْ دَعْ ، وَمَسَحَ بِیَدِہِ الأَرْضَ۔ قَالَ أَبُو أُسَامَۃَ : یَعْنِی تَسْوِیَۃَ الْحَصَی ، أَوْ شَیْئٌ فِی مَوْضِعِ سُجُودِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 7920","","","كتاب الجمعة"
"7921","(۷۹۲۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، قَالَ : کَانَ یُرَخَّصُ فِی مَسْحَۃٍ وَاحِدَۃٍ لِلْحَصَی۔","","Musannaf Ibn Abi Shaybah 7921","","","كتاب الجمعة"
"7922","(۷۹۲۲) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، عَنْ إبْرَاہِیمَ : أَنَّہُ لَمْ یَرَ بَأْسًا بِتَسْوِیَۃِ الْحَصَی مَرَّۃً وَاحِدَۃً۔","","Musannaf Ibn Abi Shaybah 7922","","","كتاب الجمعة"
"7923","(۷۹۲۳) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنِ الأَغَرِّ بْنِ یَحْیَی ، قَالَ : رَأَیْتُ الْحَسَنَ یُوضَعُ الْحَصَی مَوْضِعَ سُجُودِہِ وَہُوَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7923","","","كتاب الجمعة"
"7924","(۷۹۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِمْرَانُ بْنُ زَائِدَۃَ بْنِ نَشِیطٍ ، عَنْ نُفَیْعٍ أَبِی دَاوُد ، قَالَ : خَرَجْتُ مَعَ ابْنِ عَبَّاسٍ مِنَ الْمَسْجِدِ فَخَلَعْتُ خُفَّیَّ فَسَمِعَ وَقْعَ حَصَاۃٍ ، فَقَالَ ابْنُ عَبَّاسٍ : رُدَّہَا وَإِلاَّ خَاصَمَتْک یَوْمَ الْقِیَامَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 7924","","","كتاب الجمعة"
"7925","(۷۹۲۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ أَبِی حَصِینٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَوْ عَنْ کَعْبٍ، قَالَ : إنَّ الْحَصَاۃَ إذَا أُخْرِجَتْ مِنَ الْمَسْجِدِ تُنَاشِدُ صَاحِبَہَا۔ (ابوداؤد ۴۶۰)","Sahih","Musannaf Ibn Abi Shaybah 7925","","","كتاب الجمعة"
"7926","(۷۹۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، عَنْ زُبَیْدِ بْنِ الْحَارِثِ ، عَنْ مُجَاہِدٍ ، قَالَ : حَدِیث لَیْسَ بِمُحْدَثٍ : إذَا أُخْرِجَت الْحَصَی مِنَ الْمَسْجِدِ صَاحَتْ ، أَوْ سَبَّحَتْ۔","","Musannaf Ibn Abi Shaybah 7926","","","كتاب الجمعة"
"7927","(۷۹۲۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ حَمَّادًا عَنِ الْحَصَی یُخْرَجُ بِہِنَّ مِنَ الْمَسْجِدِ ؟ قَالَ : انْبِذْ بِہِنَّ۔ وَسَأَلْت الْحَکَمَ ، فَقَالَ : صُرَّہُنَّ حَتَّی تَرُدَّہُنَّ ، فَإِنِّی بَلَغَنِی أَنَّ لَہُنَّ صِیَاحًا۔","","Musannaf Ibn Abi Shaybah 7927","","","كتاب الجمعة"
"7928","(۷۹۲۸) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ دَاوُدَ أَبِی الْہَیْثُمِ ، قَالَ : سَأَلْتُ ابْنَ سِیرِینَ عَنِ الرَجُلِ یَقُولُ لِغُلاَمٍ لَہُ ، أَوْ لِخَادِمِہِ : إِنْ وَجَدْت فِی خُفَّیَّ حَصَاۃً فَرُدَّہَا إلَی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 7928","","","كتاب الجمعة"
"7929","(۷۹۲۹) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ لَیْثٍ ، عَنْ حَبِیبٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : الْحَصَاۃُ تَسُبُّ وَتَلْعَنَ مَنْ یُخْرِجُہَا مِنَ الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 7929","","","كتاب الجمعة"
"7930","(۷۹۳۰) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ مُثَنَّی بْنِ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، قَالَ : الْحَصَاۃُ إذَا أُخْرِجَتْ مِنَ الْمَسْجِدِ تَصِیحُ حَتَّی تُرَدَّ إلَی مَوْضِعِہَا۔","","Musannaf Ibn Abi Shaybah 7930","","","كتاب الجمعة"
"7931","(۷۹۳۱) حَدَّثَنَا أَسْبَاطٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : الْحَصَاۃُ تَصِیحُ إذَا أُخْرِجَتْ مِنَ الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 7931","","","كتاب الجمعة"
"7932","(۷۹۳۲) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا کُنْتَ فِی صَلاَۃٍ فَلاَ تُحَرِّکِ الْحَصَی۔","Da'if","Musannaf Ibn Abi Shaybah 7932","","","كتاب الجمعة"
"7933","(۷۹۳۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْوَلِیدِ بْنِ أَبِی ہَاشِمٍ ، عَنْ مُسْلِمِ بْنِ أَبِی مَرْیَمَ ، قَالَ : رَأَی ابْنُ عُمَرَ رَجُلاً یُقَلِّبُ الْحَصَی فِی الصَّلاَۃ ، فَقَالَ : لاَ تُقَلِّبِ الْحَصَاۃَ فِی الصَّلاَۃ ، فَإِنَّہُ مِنَ الشَّیْطَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 7933","","","كتاب الجمعة"
"7934","(۷۹۳۴) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ طَلْحَۃَ ، قَالَ تَقْلِیبُ الْحَصَی أَذَی للْمَلَکِ۔","","Musannaf Ibn Abi Shaybah 7934","","","كتاب الجمعة"
"7935","(۷۹۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ ، قَالَ : صَلَّیْتُ إلَی جَنْبِ مَسْرُوقٍ فَمَسِسْتُ الْحَصَی فَضَرَبَ بِیَدَیَّ۔","","Musannaf Ibn Abi Shaybah 7935","","","كتاب الجمعة"
"7936","(۷۹۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ زِیَادِ بْنِ فَیَّاضٍ ، قَالَ : صَلَّیْتُ إلَی جَنْبِ أَبِی عِیَاضٍ فَمَسِسْت الْحَصَی فَضَرَبَ یَدی ، فَلَمَّا قَضَی صَلاَتَہُ قَالَ : إِنَّہُ یُقَالُ فِی ہَذَا قَوْلًا شَدِیدًا۔","","Musannaf Ibn Abi Shaybah 7936","","","كتاب الجمعة"
"7937","(۷۹۳۷) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ أَبِی إِسْحَاقَ، عَنِ الْحَارِثِ، عَنْ عَلِیٍّ قَالَ: إذَا صَلَّیْتَ فَلاَ تَعْبَثْ بِالْحَصَی۔","Da'if","Musannaf Ibn Abi Shaybah 7937","","","كتاب الجمعة"
"7938","(۷۹۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنَ حُدَیْرٍ ، عَنْ دینَارمَوْلَی عَطِیَّۃَ ، قَالَ : صَلَّیْتُ إلَی جَنْبِ قَیْسِ بْنِ عُبَادٍ فَأَخَذْت عُودًا فَرَفَعْتُہُ إلَی فَمی فَضَرَبَ ذَقَنِی ، فَلَمَّا صَلَّی قُلْتُ لَہُ مَا حَمَلَک ؟ وَقَدْ أَعْجَبَنِی ، فَقَالَ : کَانَ یُقَالُ: مَنْ عَبِثَ بِشَیْئٍ فِی صَلاَتِہِ کَانَ حَظَّہُ مِنْ صَلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 7938","","","كتاب الجمعة"
"7939","(۷۹۳۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ یَکْرَہُ أَنْ یَعْبَثَ الرَّجُلُ بِشَیْئٍ فِی صَلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 7939","","","كتاب الجمعة"
"7940","(۷۹۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَعْمَرٍ عَنْ عَبْدِ الرَّحْمَنِ قَالَ : صَلَّیْتُ إلَی جَنْبِ رَجُلٍ مِنْ أَصْحَابِ عَبْدِ اللہِ ، فَمَسِسْت الْحَصَی ، فَلَمَّا صَلَّی قَالَ : قَالَ عَبْدُ اللہِ : لاَ یَسْأَلَنَّ أَحَدُکُمْ رَبَّہُ شَیْئًا مِنَ الْخَیْرِ وَفِی یَدِہِ الْحَجَرُ۔","Da'if","Musannaf Ibn Abi Shaybah 7940","","","كتاب الجمعة"
"7941","(۷۹۴۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبِی ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَرِہَ الْعَبَثَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7941","","","كتاب الجمعة"
"7942","(۷۹۴۲) حَدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ زِیَادٍ الْحَارِثِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : رَأَیْتُُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی وَہُمَا عَلَیْہِ وَخَرَجَ وَہُمَا عَلَیْہِ ، یَعْنِی نَعْلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 7942","","","كتاب الجمعة"
"7943","(۷۹۴۳) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ حُسَیْنِ الْمُکْتِبِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی حَافِیًا وَمُنْتَعِلاً۔ (ابوداؤد ۶۵۳۔ احمد ۲/۱۷۴)","Hasan","Musannaf Ibn Abi Shaybah 7943","","","كتاب الجمعة"
"7944","(۷۹۴۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ النُّعْمَانِ بْنِ سَالِمٍ ، عَنِ ابْنِ أَبی أَوْسٍ ، عَنْ جَدِّہِ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی فِی نَعْلَیْہِ۔ (طیالسی ۱۱۱۱۔ احمد ۴/۸)","Da'if","Musannaf Ibn Abi Shaybah 7944","","","كتاب الجمعة"
"7945","(۷۹۴۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ النُّعْمَانِ بْنِ سَالِمٍ ، عَنِ ابْنِ أَبی أَوْسٍ ، عَنْ جَدِّہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ۔ (ابن ماجہ ۱۰۳۷)","Da'if","Musannaf Ibn Abi Shaybah 7945","","","كتاب الجمعة"
"7946","(۷۹۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ السُّدِیِّ عَمَّنْ سَمِعَ عَمْرَو بْنَ حُرَیْثٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی فِی نَعْلَیْہِ۔ (نسائی ۹۸۰۵۔ احمد ۴/۳۰۷)","Da'if","Musannaf Ibn Abi Shaybah 7946","","","كتاب الجمعة"
"7947","(۷۹۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُلَیْمَانَ بْنِ الْمُغِیرَۃِ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ الْعَدَوِیِّ ، عَمَّنْ سَمِعَ الأَعْرَابِیَّ یَقُولُ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی فِی نَعْلَیْنِ مِنْ بَقَرٍ۔ (احمد ۶)","Da'if","Musannaf Ibn Abi Shaybah 7947","","","كتاب الجمعة"
"7948","(۷۹۴۸) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سَأَلْتُ عَطَائً أَیُصَلِّی الرَّجُلُ فِی نَعْلَیْہِ ؟ فَقَالَ : نَعَمْ ، قَدْ صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی نَعْلَیْہِ۔","","Musannaf Ibn Abi Shaybah 7948","","","كتاب الجمعة"
"7949","(۷۹۴۹) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی فِی نَعْلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 7949","","","كتاب الجمعة"
"7950","(۷۹۵۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی نَعْلَیْہِ فَصَلَّی النَّاسُ فِی نِعَالِہِمْ ، فَخَلَعَ فَخَلَعُوا ، فَلَمَّا صَلَّی قَالَ : مَنْ شَائَ أَنْ یُصَلِّیَ فِی نَعْلَیْہِ فَلْیُصَلِّ وَمَنْ شَائَ أَنْ یَخْلَعَ فَلْیَخْلَعْ۔","","Musannaf Ibn Abi Shaybah 7950","","","كتاب الجمعة"
"7951","(۷۹۵۱) حَدَّثَنَا عُبَیْدُ بن سَعِیدٍ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی مَسلَمَۃَ ، قَالَ : سَأَلْتُ أَنَسًا أَیُصَلِّی الرَّجُلُ فِی نَعْلَیْہِ ؟ فَقَالَ: قَدْ صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی نَعْلَیْہِ۔ (بخاری ۳۸۶۔ مسلم ۶۰)","Sahih","Musannaf Ibn Abi Shaybah 7951","","","كتاب الجمعة"
"7952","(۷۹۵۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : خَلَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَعْلَیْہِ وَہُوَ فِی الصَّلاَۃ ، فَخَلَعَ النَّاسُ نِعَالَہُمْ ، ثُمَّ لَبِسَہُمَا فَلَمْ یُرَ نَازِعَہُمَا بَعْدُ۔","","Musannaf Ibn Abi Shaybah 7952","","","كتاب الجمعة"
"7953","(۷۹۵۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الْعُمَیْسِ ، عَنِ الْقَاسِمِ ، قَالَ : کَانَ عَبْدُ اللہِ یُصَلِّی فِی نَعْلَیْہِ۔","","Musannaf Ibn Abi Shaybah 7953","","","كتاب الجمعة"
"7954","(۷۹۵۴) حَدَّثَنَا عَبْدَۃُ ، وَأَبُو خَالِدٍ ، عَنْ عُثْمَانَ بْنِ حَکِیمٍ ، قَالَ : رَأَیْتُُ أَبَا جَعْفَرٍ وَعَلِیَّ بْنَ حُسَیْنٍ یُصَلِّیَانِ فِی نِعَالِہِمَا۔","","Musannaf Ibn Abi Shaybah 7954","","","كتاب الجمعة"
"7955","(۷۹۵۵) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، قَالَ : قُلْتُ لِشُرَیْحٍ أُصَلِّی فِی نَعْلِی ؟ فَلَمْ یَکْرَہْہُ۔","","Musannaf Ibn Abi Shaybah 7955","","","كتاب الجمعة"
"7956","(۷۹۵۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی خَالِدٍ ، قَالَ : رَأَیْتُُ الأَسْوَدَ یُصَلِّی فِی نَعْلَیْہِ ، وَرَأَیْتُ أَبَا عَمْرٍو الشَّیْبَانِیَّ یَضْرِبُ النَّاسَ إذَا خَلَعُوا نِعَالَہُمْ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 7956","","","كتاب الجمعة"
"7957","(۷۹۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زِیَادِ بْنِ فَیَّاضٍ ، عَنْ شَیْخٍ لَہُمْ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی فِی نَعْلٍ مَخْصُوفَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 7957","","","كتاب الجمعة"
"7958","(۷۹۵۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، قَالَ : رَأَیْتُ إبْرَاہِیمَ التَّیْمِیَّ یَؤُمُّ قَوْمَہُ عَلَیْہِ نَعْلاَہُ۔","","Musannaf Ibn Abi Shaybah 7958","","","كتاب الجمعة"
"7959","(۷۹۵۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ : أَنَّہُ کَانَ یُصَلِّی فِی نَعْلَیْہِ۔","","Musannaf Ibn Abi Shaybah 7959","","","كتاب الجمعة"
"7960","(۷۹۶۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ، قَالَ: کَانَ عُمَرُ یَشتَد عَلَی النَّاسِ فِی خَلْعِ نِعَالِہِمْ فِی الصَّلاَۃ۔","Da'if","Musannaf Ibn Abi Shaybah 7960","","","كتاب الجمعة"
"7961","(۷۹۶۱) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ یَزِیدَ مَوْلَی سَلَمَۃَ ، قَالَ : رَأَیْتُ سَلَمَۃَ یُصَلِّی فِی نَعْلَیْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 7961","","","كتاب الجمعة"
"7962","(۷۹۶۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یُصَلِّی فِی نَعْلَیْہِ۔","","Musannaf Ibn Abi Shaybah 7962","","","كتاب الجمعة"
"7963","(۷۹۶۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی حَمْزَۃَ ، قَالَ : رَأَیْتُ ابْنَ عَبَّاسٍ یُصَلِّی فِی نَعْلَیْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 7963","","","كتاب الجمعة"
"7964","(۷۹۶۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیدِ اللہِ ، قَالَ : کَانَ إبْرَاہِیمُ یَکْرَہُ خَلْعَ النِّعَالِ فِی الصَّلاَۃ وَیَقُولُ: وَدِدْت أَنَّ إنْسَانًا مُحْتَاجًا أَتی الْمَسْجِدِ فَأَخَذَ نِعَالَہُمْ۔","","Musannaf Ibn Abi Shaybah 7964","","","كتاب الجمعة"
"7965","(۷۹۶۵) حَدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ : أَنَّہُ کَانَ یُصَلِّی فِی نَعْلَیْہِ۔","","Musannaf Ibn Abi Shaybah 7965","","","كتاب الجمعة"
"7966","(۷۹۶۶) حَدَّثَنَا عَفَانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَبْدِ اللہِ بْنِ إیَاسٍ الْحَنَفِیِّ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ عُثْمَانَ یُصَلِّی فِی نَعْلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 7966","","","كتاب الجمعة"
"7967","(۷۹۶۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، قَالَ : رَأَیْتُُ الْقَاسِمَ وَسَالِمًا یُصَلِّیَانِ فِی نِعَالِہِمَا۔","","Musannaf Ibn Abi Shaybah 7967","","","كتاب الجمعة"
"7968","(۷۹۶۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی الْمِقْدَامِ ، قَالَ : رَأَیْتُُ سَعِیدَ بْنَ الْمُسَیَّبِ وَعَطَائَ بْنَ یَسَارٍ وَسَالِمًا وَالْقَاسِمَ یُصَلُّونَ فِی نِعَالِہِمْ۔","","Musannaf Ibn Abi Shaybah 7968","","","كتاب الجمعة"
"7969","(۷۹۶۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ خُضَیْرٍ ، قَالَ : رَأَیْتُُ مُجَاہِدًا وَعَطَائً وَطَاوُوسا یُصَلُّونَ فِی نِعَالِہِمْ۔","","Musannaf Ibn Abi Shaybah 7969","","","كتاب الجمعة"
"7970","(۷۹۷۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُقْبَۃُ بْنُ أَبِی صَالِحٍ ، قَالَ : کُنْتُ عِنْدَ إبْرَاہِیمَ وَہُوَ خَالِعٌ نَعْلَیْہِ ، فَلَمَّا أَقَامَ الْمُؤَذِّنُ لَبِسَہُمَا۔","","Musannaf Ibn Abi Shaybah 7970","","","كتاب الجمعة"
"7971","(۷۹۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إبْرَاہِیمُ بْنُ إسْمَاعِیلَ بْنِ مُجَمِّعِ بْنِ جَارِیَۃَ ، عَنْ یَعْقُوبَ بْنِ مُجَمِّعٍ ، قَالَ : أَوَّلُ مَنْ صَلَّی فِی نَعْلَیْہِ عُوَیْمُ بْنُ سَاعِدَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 7971","","","كتاب الجمعة"
"7972","(۷۹۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِمْرَانُ بْنُ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، أَنَّہُ کَانَ یُصَلِّی فِی نَعْلَیْہِ۔","","Musannaf Ibn Abi Shaybah 7972","","","كتاب الجمعة"
"7973","(۷۹۷۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ : أَنَّہُ کَانَ یَخْلَعُ نَعْلَیْہِ ، فَلَمَّا قَامَ إلَی الصَّلاَۃ لَبِسَہُمَا۔","","Musannaf Ibn Abi Shaybah 7973","","","كتاب الجمعة"
"7974","(۷۹۷۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَبِی نَعَامَۃَ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ: أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی فَخَلَعَ نَعْلَیْہِ فَخَلَعَ النَّاسُ نِعَالَہُمْ ، فَلَمَّا انْصَرَفَ قَالَ : لِمَ خَلَعْتُمْ نِعَالَکُمْ ؟ قَالُوا : یَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَیْنَاک خَلَعْتَ فَخَلَعْنَا ، فَقَالَ : إنَّ جِبْرِِیلَ أَتَانِی فَأَخْبَرَنِی أَنَّ فِیہِمَا خَبَثًا فَإِذَا جَائَ أَحَدُکُمْ إلَی الْمَسْجِدِ فَلْیَقْلِبْ نَعْلَیْہِ وَلْیَنْظُرْ فِیہِمَا فَإنْ رَأی فِیہِمَا خَبَثًا فَلْیَمْسَحْہُ بِالأَرْضِ وَلْیُصَلِّ فِیہِمَا۔ (احمد ۳/۲۰۔ دارمی ۱۳۷۸)","Sahih","Musannaf Ibn Abi Shaybah 7974","","","كتاب الجمعة"
"7975","(۷۹۷۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ إبْرَاہِیمَ التُّسْتَرِیُّ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَعَاہَدُوا نِعَالَکُمْ فَإِنْ رَأَی أَحَدُکُمْ فِیہِمَا أَذًی فَلْیُمِطْہُ وَإلا فَلْیُصَلِّ فِیہِمَا۔","","Musannaf Ibn Abi Shaybah 7975","","","كتاب الجمعة"
"7976","(۷۹۷۶) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَلْقَمَۃَ قَالَ ، وَلَمْ یَسْمَعْہُ مِنْہُ ، عَنْ عَبْدِ اللہِ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی فِی نَعْلَیْہِ۔ (طیالسی ۳۹۵۔ احمد ۱/۴۶۱)","Da'if","Musannaf Ibn Abi Shaybah 7976","","","كتاب الجمعة"
"7977","(۷۹۷۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ غَیْلاَنَ بْنِ عَبْدِ اللہِ مَوْلَی بَنِی مَخْزُومٍ قَالَ : رَأَیْتُُ ابْنَ عُمَرَ یَنْتَعِلُ ہَذِہِ السِّبْتِیَّۃَ فَإِذَا صَلَّی خَلَعَہُمَا۔","","Musannaf Ibn Abi Shaybah 7977","","","كتاب الجمعة"
"7978","(۷۹۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَص ، أَنَّ ابْنَ مَسْعُودٍ أَتَی أَبَا مُوسَی فِی دَارِہِ فَحَضَرَتِ الصَّلاَۃ ، فَقَالَ أَبُو مُوسَی لِعَبْدِ اللہِ : تَقَدَّمْ ، فَقَالَ عَبْدُ اللہِ : أَنْتَ أَحَقُّ ، فَتَقَدَّمَ أَبُو مُوسَی فَخَلَعَ نَعْلَیْہِ ، فَقَالَ لَہُ : عَبْدُ اللہِ أَبِالْوَادِی الْمُقَدَّسِ أَنْتَ؟۔ (عبدالرزاق ۱۵۰۷)","","Musannaf Ibn Abi Shaybah 7978","","","كتاب الجمعة"
"7979","(۷۹۷۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ مُحَمَّدِ بْنِ عَبَّادٍ ، عَنْ عَبْدِ اللہِ بْنِ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ السَّائِبِ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی یَوْمَ فَتْحِ مَکَّۃَ فَجَعَلَ نَعْلَیْہِ عَنْ یَسَارِہِ۔ (ابوداؤد ۶۴۸۔ احمد ۳/۴۱۱)","Sahih","Musannaf Ibn Abi Shaybah 7979","","","كتاب الجمعة"
"7980","(۷۹۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : أَخْبَرَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ سَعِیدٍ الْمَقْبُرِیِّ ، عَنْ أَبِیہِ ، قَالَ : قُلْتُ لأَبِی ہُرَیْرَۃَ : کَیْفُ أَصْنَعُ بِنَعْلِی إذَا صَلَّیْت ؟ قَالَ : اجْعَلْہُمَا بَیْنَ رِجْلَیْک ، وَلاَ تُؤْذِ بِہِمَا مُسْلِمًا۔","Sahih","Musannaf Ibn Abi Shaybah 7980","","","كتاب الجمعة"
"7981","(۷۹۸۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُوسَی بْنُ عُبَیْدَۃَ ، قَالَ : سَمِعْتُ نَافِعَ بْنَ جُبَیْرٍ یَقُولُ : وَضْعُ الرَّجُلِ نَعْلَہُ مِنْ قدمہِ فِی الصَّلاَۃ بِدْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 7981","","","كتاب الجمعة"
"7982","(۷۹۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ حَکِیمٍ الْحَضْرَمِیِّ ، قَالَ : رَأَیْتُُ ابْنَ عُمَرَ خَلَعَ نَعْلَیْہِ فَجَعَلَہُمَا خَلْفَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 7982","","","كتاب الجمعة"
"7983","(۷۹۸۳) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنِ الْمَقْبُرِیِّ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا صَلَّی أَحَدُکُمْ فَلْیَجْعَلْ نَعْلَیْہِ بَیْنَ رِجْلَیْہِ۔ (ابوداؤد ۱۶۵۵۔ ابن حبان ۲۱۸۲)","Sahih","Musannaf Ibn Abi Shaybah 7983","","","كتاب الجمعة"
"7984","(۷۹۸۴) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ قَالَ : أَخْبَرَنَا أَبُو نَعَامَۃَ السَّعْدِیُّ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : بَیْنَمَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی فَخَلَعَ نَعْلَیْہِ فَوَضَعَہُمَا عَنْ یَسَارِہِ۔ (ابوداؤد ۶۵۰۔ احمد ۳/۹۲)","Sahih","Musannaf Ibn Abi Shaybah 7984","","","كتاب الجمعة"
"7985","(۷۹۸۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنْ سُلَیْمَانَ بْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : صَلَّی بِنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ رَجُلٌ : مَنْ دَعَا إلَی الْجَمَلِ الأَحْمَر ؟ فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ وَجَدْتَ إنَّمَا بُنِیَتِ الْمَسَاجِدُ لِمَا بُنِیَتْ لَہُ۔ (مسلم ۸۱۔ احمد ۵/۳۶۱)","Sahih","Musannaf Ibn Abi Shaybah 7985","","","كتاب الجمعة"
"7986","(۷۹۸۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِیہِ ، قَالَ : سَمِعَ عُمَرُ بْنُ الْخَطَّابِ رَجُلاً رَافِعًا صَوْتَہُ فِی الْمَسْجِدِ ، فَقَالَ : أَتَدْرِی أَیْنَ أَنْتَ۔","Sahih","Musannaf Ibn Abi Shaybah 7986","","","كتاب الجمعة"
"7987","(۷۹۸۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْعُمَرِیُّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : أَنَّ عُمَرَ نَہَی عَنِ اللَّغَطِ فِی الْمَسْجِدِ ، وَقَالَ : إنَّ مَسْجِدَنَا ہَذَا لاَ تُرْفَعُ فِیہِ الأَصْوَاتُ۔","Da'if","Musannaf Ibn Abi Shaybah 7987","","","كتاب الجمعة"
"7988","(۷۹۸۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَمِعَ رَجُلاً یَنْشُدُ ضَالَّۃً فِی الْمَسْجِدِ ، فَقَالَ : لاَ وَجَدْتَ۔","","Musannaf Ibn Abi Shaybah 7988","","","كتاب الجمعة"
"7989","(۷۹۸۹) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ عَوْنٍ ، أَوْ عَاصِمٍ قَالَ : وَلاَ أَعْلَمُہُ إِلاَّ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : سَمِعَ ابْنُ مَسْعُودٍ رَجُلاً یَنْشُدُ ضَالَّۃً فِی الْمَسْجِدِ ، فَقَامَ إلَیْہِ فَنَالَ مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 7989","","","كتاب الجمعة"
"7990","(۷۹۹۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْبَیْعِ وَالشِّرَائِ فِی الْمَسْجِدِ ، وَعَنْ إنْشَادِ الضَّوَالِّ۔ (ترمذی ۳۲۲۔ احمد ۲/۱۷۹)","Hasan","Musannaf Ibn Abi Shaybah 7990","","","كتاب الجمعة"
"7991","(۷۹۹۱) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ عَمْرِو بْنِ أَبِی عَمْرٍو ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ: دَخَلَ رَجُلٌ یَنْشُدُ ضَالَّۃً فِی الْمَسْجِدِ ، فَسَمِعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَوْتَہُ ، فَقَالَ : لاَ وَجَدْتَ۔","Da'if","Musannaf Ibn Abi Shaybah 7991","","","كتاب الجمعة"
"7992","(۷۹۹۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، أَنَّ عَبْدَ اللہِ أَخْبَرَہُ : أَنَّ عُمَرَ کَانَ إذَا خَرَجَ إلَی الصَّلاَۃ نَادَی فِی الْمَسْجِدِ ، قَالَ : إیَّاکُمْ وَاللَّغَطَ۔","Sahih","Musannaf Ibn Abi Shaybah 7992","","","كتاب الجمعة"
"7993","(۷۹۹۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنِ ابْنِ الْمُنْکَدِرِ، سَمِعَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلاً یَنْشُدُ ضَالَّۃً فِی الْمَسْجِدِ، فَقَالَ : أَیُّہَا النَّاشِدُ غَیْرُکَ الْوَاجِدُ۔","","Musannaf Ibn Abi Shaybah 7993","","","كتاب الجمعة"
"7994","(۷۹۹۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قولُوا لاَ وَجَدْتَ۔","Hasan","Musannaf Ibn Abi Shaybah 7994","","","كتاب الجمعة"
"7995","(۷۹۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا حَضَرَتِ الصَّلاَۃ وَوُضِعَ الْعَشَائُ فَابْدَؤُوا بِالْعَشَائِ۔ (بخاری ۶۷۱۔ مسلم ۶۵)","Sahih","Musannaf Ibn Abi Shaybah 7995","","","كتاب الجمعة"
"7996","(۷۹۹۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَنَسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إذَا حَضَرَ الْعَشَائُ وَأُقِیمَتِ الصَّلاَۃ فَابْدَؤُوا بِالْعَشَائِ۔ (بخاری ۶۷۲۔ ترمذی ۳۵۳)","Sahih","Musannaf Ibn Abi Shaybah 7996","","","كتاب الجمعة"
"7997","(۷۹۹۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ رَافِعٍ ، عَنْ أُمِّ سَلَمَۃَ ، قَالَت : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا حَضَرَ الْعَشَائُ وَحَضَرَتِ الصَّلاَۃُ فَابْدَؤُوا بِالْعَشَائِ۔ (احمد ۶/۲۹۱۔ ابویعلی ۶۹۵۷)","Hasan","Musannaf Ibn Abi Shaybah 7997","","","كتاب الجمعة"
"7998","(۷۹۹۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا وُضِعَ عَشَائُ أَحَدِکُمْ وَأُقِیمَتِ الصَّلاَۃ فَابْدَؤُوا بِالْعَشَائِ وَلاَ یَعْجَلَنَّ حَتَّی یَفْرُغَ مِنْہُ۔n قَالَ نَافِعٌ : وَکَانَ ابْنُ عُمَرَ یُوضَعُ لَہُ الطَّعَامُ فَتُقَامُ الصَّلاَۃ فَلاَ یَأْتِیہَا حَتَّی یَفْرُغَ وَإِنَّہُ لیَسْمَعُ قِرَائَۃَ الإِمَام۔ (بخاری ۶۷۳۔ ابوداؤد ۳۷۵۱)","Sahih","Musannaf Ibn Abi Shaybah 7998","","","كتاب الجمعة"
"7999","(۷۹۹۹) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، عَنْ أَیُّوبَ بْنِ عُتْبَۃَ ، عَنْ إیَاسِ بْنِ سَلَمَۃَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إذَا حَضَرَتِ الصَّلاَۃ وَالْعَشَائُ فَابْدَؤُوا بِالْعَشَائِ۔ (احمد ۴/۴۹۔ طبرانی۶۲۵۰)","Da'if","Musannaf Ibn Abi Shaybah 7999","","","كتاب الجمعة"
"8000","(۸۰۰۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا حَضَرَتِ الْعَشَائُ وَالصَّلاَۃ فَابْدَؤُوا بِالْعَشَائِ۔ (احمد ۳/۲۳۸)","Da'if","Musannaf Ibn Abi Shaybah 8000","","","كتاب الجمعة"
"8001","(۸۰۰۱) حَدَّثَنَا ہُشَیْمٌ قَالَ: أَخْبَرَنَا حُمَیْدٌ، عَنْ أَنَسِ بْنِ مَالِکٍ مِثْلَ ذَلِکَ، وَلَمْ یَذْکُرِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 8001","","","كتاب الجمعة"
"8002","(۸۰۰۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا حَضَرَ الْعَشَائُ وَأُقِیمَتِ الصَّلاَۃ فَابْدَؤُوا بِالْعَشَائِ۔","","Musannaf Ibn Abi Shaybah 8002","","","كتاب الجمعة"
"8003","(۸۰۰۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : کُنَّا عَلَی طَعَامٍ لَنَا وَحَضَرَتِ الصَّلاَۃُ فَحَبَسَنِی أَبُو طَلْحَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 8003","","","كتاب الجمعة"
"8004","(۸۰۰۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنِ ابْنٍ لأَبِی الْمَلِیحِ ، عَنْ أَبِیہِ ، قَالَ : کُنَّا مَعَ أَبِی بَکْرٍ وَقَدْ خَرَجَ لِصَلاَۃِ الْمَغْرِبِ وَأَذَّنَ الْمُؤَذِّنُ فَتُلُقِّیَ بِقَصْعَۃٍ فِیہَا ثَرِیدٌ وَلَحْمٌ ، فَقَالَ : اجْلِسُوا فَکُلُوا فَإِنَّمَا صُنِعَ الطَّعَامُ لِیُؤْکَلَ ، فَأَکَلَ ، ثُمَّ دَعَا بِمَائٍ فَغَسَلَ أَطْرَافَ أَصَابِعِہِ وَمَضْمَضَ وَصَلَّی۔","Da'if","Musannaf Ibn Abi Shaybah 8004","","","كتاب الجمعة"
"8005","(۸۰۰۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِی عَاصِمٍ ، عَنْ عَلِیِّ بْنِ عُبَیْدِ اللہِ ، قَالَ : دَعَانَا یَسَارُ بْنُ نُمَیْرٍ إلَی طَعَامٍ عِنْدَ الْمَغْرِبِ ، فَقَالَ : إنَّ عُمَرَ بْنَ الْخَطَّابِ کَانَ یَقُولُ : ابْدَؤُوا بِطَعَامِکُمْ ، ثُمَّ افْرُغُوا لِصَلاَتِکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 8005","","","كتاب الجمعة"
"8006","(۸۰۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی عَاصِمٍ ، عَنْ یَسَارِ بْنِ نُمَیْرٍ ، قَالَ : قَالَ عُمَرُ : إذَا وُضِعَ الْعَشَائُ وَأُقِیمَتِ الصَّلاَۃ فَابْدَؤُوا بِالْعَشَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 8006","","","كتاب الجمعة"
"8007","(۸۰۰۷) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ قَنَانِ بْنِ عَبْدِ اللہِ النَّہْمِیِّ ، عَنْ أَشْیَاخٍ لَہُمْ ، قَالُوا : کُنَّا عِنْدَ عَلِیٍّ وَحَضَرَ الْفِطْرُ فِی رَمَضَانَ ، فَقَالَ لَنَا عَلِیٌّ : أَفْطِرُوا ، فَإِنَّہُ أَحْسَنُ لِصَلاَتِکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 8007","","","كتاب الجمعة"
"8008","(۸۰۰۸) حَدَّثَنَا شَرِیکٌ، عَنْ أَبِی إِسْحَاقَ: أَنَّ الْحَسَنَ بْنَ عَلِیٍّ کَانَ یَقُولُ الْعَشَائُ قَبْلَ الصَّلاَۃ یُذْہِبُ النَّفْسَ اللَّوَّامَۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 8008","","","كتاب الجمعة"
"8009","(۸۰۰۹) حَدَّثَنَ[corrupt] وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ عُثْمَانَ الثَّقَفِیِّ ، عَنْ رَجُلٍ یُقَالُ لَہُ زِیَادٌ ، قَالَ : کُنَّا عِنْدَ ابْنِ عَبَّاسٍ وَشِوَائٌ لَہُ فِی التَّنُّورِ وَحَضَرَتِ الصَّلاَۃُ فَقُلْنَا لَہُ ، فَقَالَ : لاَ حَتَّی نَأْکُلَ لاَ یَعْرِضُ لَنَا فِی صَلاَتِنَا۔","Hasan","Musannaf Ibn Abi Shaybah 8009","","","كتاب الجمعة"
"8010","(۸۰۱۰) حَدَّثَنَا جَرِیرٌ ، عَنْ یزِیْدٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، قَالَ : إذَا جِیئَ بِعَشَائِکَ وَنُودِیَ بِالصَّلاَۃ فَابْدَأْ بِالْعَشَائِ ، ثُمَّ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 8010","","","كتاب الجمعة"
"8011","(۸۰۱۱) حَدَّثَنَا شَبَابَۃُ ، عَنْ سُلَیْمَانَ بْنِ الْمُغِیرَۃِ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ ، قَالَ : قَدِمْتُ مِنَ الْعِرَاقِ فَقُرِّبَ عَشَائُ أَبِی طَلْحَۃَ وَمَعَہُ مَنْ شَائَ اللَّہُ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ لِی : ہَلُمَّ فَکُلْ فَقُلْت : حَتَّی أُصَلِّیَ ، فَقَالَ : قَدْ أَخَذْتَ بِأَخْلاَقِ أَہْلِ الْعِرَاقِ ہَلُمَّ فَکُلْ۔","Sahih","Musannaf Ibn Abi Shaybah 8011","","","كتاب الجمعة"
"8012","(۸۰۱۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیرِیِّ ، عَنْ عَبْدِ اللہِ بْنِ بُرَیْدَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ بْنُ عَمْرٍو : مَا أُبَالِی کَانَا مَصْرُورَیْنِ فِی نَاحِیَۃِ ثَوْبِی ، أَوْ نَازَعَانِی فِی صَلاَتِی۔","Sahih","Musannaf Ibn Abi Shaybah 8012","","","كتاب الجمعة"
"8013","(۸۰۱۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ لَیْثٍ، عَنْ مُجَاہِدٍ، قَالَ: قَالَ عُمَرُ: لاَ تُعَالِجُوا الأَخْبَثَیْنِ فِی الصَّلاَۃ الْغَائِطَ وَالْبَوْلَ۔","Da'if","Musannaf Ibn Abi Shaybah 8013","","","كتاب الجمعة"
"8014","(۸۰۱۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی حُرَّۃَ ، عَنِ الْحَسَنِ ، عَنْ عُمَرَ ، بِنَحْوِ ذَلِکَ۔","Hasan","Musannaf Ibn Abi Shaybah 8014","","","كتاب الجمعة"
"8015","(۸۰۱۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ یُصَلِّیَنَّ أَحَدُکُمْ وَہُوَ یُدَافِعُ الطَّوْفَ الْغَائِطَ وَالْبَوْلَ۔","","Musannaf Ibn Abi Shaybah 8015","","","كتاب الجمعة"
"8016","(۸۰۱۶) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ کَثِیرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : مَا أُبَالِی دَافَعْتُہُ ، أَوْ صَلَّیْتُ وَہُوَ فِی جَانِبِ ثَوْبِی۔","","Musannaf Ibn Abi Shaybah 8016","","","كتاب الجمعة"
