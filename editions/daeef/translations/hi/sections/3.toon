hadiths[300]{hadithnumber,text}:
"309","[AI-translation] ((इस्लाम पाक है, तो पाक रहो, और बेशक सिर्फ़ पाक शख़्स जन्नत में दाख़िल होगा))।"
"310","[AI-translation] ((अल्लाह के नज़दीक मोमिन की इज़्ज़त उसके कपड़ों की सफ़ाई में है))।"
"311","[AI-translation] ((इस्लाम सफ़ाई पर क़ायम है))।"
"312","[AI-translation] ((गधों और जिन जानवरों का गोश्त खाना हलाल है उनके पेशाब में कोई हर्ज नहीं))।"
"313","[AI-translation] ((ज़मीन की पाकी उसका सूख जाना है))।"
"314","[AI-translation] ((दो क़िस्म का पानी जनाबत के बाद ग़ुस्ल के लिए काफ़ी नहीं: समन्दर का पानी और हम्माम का पानी))।"
"315","[AI-translation] ((जब पानी चालीस मटकों तक पहुँचे तो वह नापाक नहीं होता))।"
"316","[AI-translation] ((ज़मीन पेशाब से सिर्फ़ चालीस दिन बाद नापाक होती है))।"
"317","[AI-translation] ((इस [पेशाब] की जगह खोद डालो और उस पर पानी बहाओ))।"
"318","[AI-translation] ((तहबन्द [इज़ार] के बग़ैर हम्माम में दाख़िल होना हराम क़रार दिया गया है))।"
"319","[AI-translation] ((अगर बिल्ली बर्तन में मुँह डाले तो उसे सात बार धोना चाहिए))।"
"320","[AI-translation] ((खड़े होकर पेशाब न करो))।"
"321","[AI-translation] ((जब तुममें से कोई पानी न पाए लेकिन नबीज़ पाए तो उससे वुज़ू करे))।"
"322","[AI-translation] ((उस पाख़ाने में वुज़ू न करो जिसमें पेशाब करते हो, क्योंकि मोमिन के वुज़ू का पानी उसकी दूसरी नेकियों के साथ तौला जाएगा))।"
"323","[AI-translation] ((जो यहूदी या ईसाई से मुसाफ़हा करे वह वुज़ू करे और अपना हाथ धोए))।"
"324","[AI-translation] ((वुज़ू पर वुज़ू नूर पर नूर है))।"
"325","[AI-translation] ((जो पाक होने के बावजूद वुज़ू करे, अल्लाह तआला उसके लिए दस नेकियाँ लिखता है))।"
"326","[AI-translation] ((जिसने अपने भाई को वुज़ू के लिए बर्तन पेश किया, गोया उसने उसे घोड़ा पेश किया))।"
"327","[AI-translation] ((वुज़ू नमाज़ की कुंजी है))।"
"328","[AI-translation] ((मिसवाक आदमी की फ़साहत बढ़ाती है))।"
"329","[AI-translation] ((मिसवाक के साथ नमाज़ बग़ैर मिसवाक नमाज़ से सत्तर गुना अफ़ज़ल है))।"
"330","[AI-translation] ((जो वुज़ू के दौरान बिस्मिल्लाह पढ़े, दो फ़रिश्ते उसके वुज़ू टूटने तक लगातार उसके लिए नेकियाँ लिखते रहते हैं))।"
"331","[AI-translation] ((वुज़ू के दौरान उँगलियों का ख़िलाल [अन्तराल साफ़] करो; [ऐसा करने से] क़ियामत के दिन आग उनका ख़िलाल न करेगी))।"
"332","[AI-translation] ((जब नबी-ए-मुहम्मद (सल्लल्लाहु अलैहि वसल्लम) वुज़ू करते तो अपनी अँगूठी हिलाते))।"
"333","[AI-translation] ((कुल्ली करना और नाक में पानी डालना सुन्नत है))।"
"334","[AI-translation] ((अगर कोई सिर का मसह भूल जाए और नमाज़ के दौरान याद आए, अगर दाढ़ी में तरी पाए तो उसी से मसह करे; यह उसके लिए काफ़ी होगा। लेकिन अगर तरी न पाए तो नमाज़ और वुज़ू दोहराए))।"
"335","[AI-translation] (([एक तवील हदीस में है कि] नबी (सल्लल्लाहु अलैहि वसल्लम) वुज़ू के दौरान गर्दन का मसह करते))।"
"336","[AI-translation] ((गर्दन का मसह क़ियामत के दिन [अज़ाब के] तौक़ से हिफ़ाज़त का ज़रिया है))।"
"337","[AI-translation] ((जब नबी (सल्लल्लाहु अलैहि वसल्लम) हाथ धोते तो यह दुआ «بسم الله والحمد لله . . . » पढ़ते और जब चेहरा धोते तो यह दुआ «اللهم بيض وجهي . . . » पढ़ते))।"
"338","[AI-translation] ((पेशाब की वजह से वुज़ू के आज़ा एक-एक बार धोने चाहिए; पाख़ाने की वजह से दो-दो बार; और बड़ी नापाकी [जनाबत] की वजह से तीन-तीन बार))।"
"339","[AI-translation] ((मैं चमड़े के मोज़ों पर मसह [मोज़ों पर मसह] करने के बजाय अपने पैर काटना पसन्द करूँगा))।"
"340","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) मोज़ों के ऊपरी हिस्से पर उँगलियों से लकीरें खींचकर मसह करते))।"
"341","[AI-translation] (([इब्ने अबी अमारा (रज़ियल्लाहु अन्हु) ने पूछा: ऐ अल्लाह के रसूल!] क्या मैं मोज़ों पर मसह करूँ? नबी (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: हाँ। उन्होंने कहा: एक या दो दिन, यहाँ तक कि सात दिन ज़िक्र किए; तो नबी ने फ़रमाया: जब तक तुझे मुनासिब लगे))।"
"342","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) [ज़ख़्मों की] पट्टियों पर मसह करते))।"
"343","[AI-translation] ((जब वुज़ू करो तो अपने कपड़े के नीचे [पानी] छिड़को))।"
"344","[AI-translation] ((उन्होंने अच्छा वुज़ू किया फिर आसमान की तरफ़ निगाह उठाई))।"
"345","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) के पास एक कपड़ा था जिससे वह वुज़ू के बाद अपने आज़ा पोंछते))।"
"346","[AI-translation] ((अगर कोई [नमाज़ के दौरान] क़ै करे, या नकसीर फूटे, या पेट के अन्दर से कोई चीज़ मुँह तक आए, या मज़ी [पेशाब से पहले का पानी] ख़ारिज हो, तो वह [नमाज़] छोड़ दे और वुज़ू करे))।"
"347","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ने क़ै की और वुज़ू न किया))।"
"348","[AI-translation] ((जो बुत को छुए वह वुज़ू करे))।"
"349","[AI-translation] (([एक तवील रिवायत में है कि] नबी (सल्लल्लाहु अलैहि वसल्लम) ने हुक्म दिया कि जो [नमाज़ के दौरान] हँसे वे अपना वुज़ू और नमाज़ दोहराएँ))।"
"350","[AI-translation] ((जब कोई क़हक़हा लगाए तो वह अपना वुज़ू और नमाज़ दोहराए))।"
"351","[AI-translation] ((एक आदमी टख़नों से नीचे लटकते कपड़े में नमाज़ पढ़ रहा था, तो रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने उससे कहा: जा और वुज़ू कर))।"
"352","[AI-translation] ((वुज़ू उससे वाजिब होता है जो जिस्म से निकले, उससे नहीं जो जिस्म में दाख़िल हो))।"
"353","[AI-translation] ((हर बहते ख़ून से वुज़ू ज़रूरी है))।"
"354","[AI-translation] ((वुज़ू का एक शैतान है जिसे वलहान कहा जाता है, तो पानी के बारे में वसवसों से बचो))।"
"355","[AI-translation] ((तयम्मुम यह है कि हाथ ज़मीन पर दो बार मारे जाएँ: एक बार चेहरे के लिए और एक बार दोनों हाथों के लिए कोहनियों तक))।"
"356","[AI-translation] ((सुन्नत यह है कि आदमी एक तयम्मुम से सिर्फ़ एक नमाज़ पढ़े, फिर दूसरी नमाज़ के लिए फिर तयम्मुम करे))।"
"357","[AI-translation] ((जो तयम्मुम करे वह वुज़ू वालों की इमामत न करे))।"
"358","[AI-translation] ((जो हलाल तरीक़े से हासिल जनाबत की वजह से ग़ुस्ल [नहाए] करे, अल्लाह तआला उसे सफ़ेद मोतियों के सौ महल देगा))।"
"359","[AI-translation] ((धूप से गर्म पानी से न नहाओ क्योंकि वह बरस [सफ़ेद दाग़] पैदा करता है))।"
"360","[AI-translation] ((जो मुर्दे को नहलाए, उसके ऐब छुपाए और अमानत अदा करे, अल्लाह तआला उसके चालीस कबीरा गुनाह बख़्श देगा))।"
"361","[AI-translation] ((जो नापाकी की वजह से ग़ुस्ल करते हुए बाल बराबर जगह भी बिन धोए छोड़े, तो उस हिस्से के साथ जहन्नम की आग में ऐसा-ऐसा सलूक़ किया जाएगा))।"
"362","[AI-translation] ((हर बाल के नीचे नापाकी है, तो बाल धोओ और खाल साफ़ करो))।"
"363","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) जुमुआ, ईद-उल-फ़ित्र के दिन, ईद-उल-अज़हा के दिन और अरफ़ा के दिन ग़ुस्ल [नहाते] करते))।"
"364","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) चार वजहों से ग़ुस्ल करते: जुमुआ [जुमुआ की नमाज़] के लिए, जिमाई नापाकी [जनाबत] के बाद, पछना [हिजामा] के बाद, और मुर्दा नहलाने के बाद))।"
"365","[AI-translation] ((हर जुमुआ नहाओ चाहे पूरे दिन के खाने के बदले पानी ख़रीदना पड़े))।"
"366","[AI-translation] ((जो नहाने के बाद वुज़ू करे वह हममें से नहीं))।"
"367","[AI-translation] ((हाइज़ा औरत और बड़ी नापाकी वाला क़ुरआन-ए-करीम में से कुछ न पढ़े))।"
"368","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) को क़ुरआन पढ़ने से सिर्फ़ बड़ी नापाकी [जनाबत] रोकती थी))।"
"369","[AI-translation] ((हैज़ की कम से कम मुद्दत तीन दिन और ज़्यादा से ज़्यादा दस दिन है))।"
"370","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने निफ़ास वाली औरतों के लिए चालीस दिन मुक़र्रर किए, जब तक वे इससे पहले पाक न हो जाएँ))।"
"371","[AI-translation] ((जब मुअज़्ज़िन अज़ान शुरू करता है तो रब अपना हाथ उसके सिर पर रखता है और मुअज़्ज़िन के अज़ान पूरी करने तक रखता है))।"
"372","[AI-translation] ((सिर्फ़ वुज़ू वाला अज़ान [नमाज़ का एलान] कहे))।"
"373","[AI-translation] ((कोई बच्चा बालिग़ होने से पहले अज़ान न कहे))।"
"374","[AI-translation] ((सिर्फ़ फ़सीह शख़्स तुम्हारे लिए अज़ान [नमाज़ का एलान] कहे))।"
"375","[AI-translation] ((जो मुअज़्ज़िन के «اشهد ان محمدا رسول الله» कहते वक़्त दोनों शहादत की उँगलियों के अन्दरूनी हिस्से चूमे और आँखों पर फेरे, उसके लिए रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) की शफ़ाअत वाजिब हो जाएगी))।"
"376","[AI-translation] ((जिस शहर में अज़ान [नमाज़ का एलान] कसरत से हो वहाँ सर्दी कम होती है))।"
"377","[AI-translation] ((आसमान वालों का मुअज़्ज़िन जिब्रील (अलैहिस्सलाम) है, और इमाम मीकाईल (अलैहिस्सलाम) है))।"
"378","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) के अलफ़ाज़ अज़ान और इक़ामत में दोहराए जाते))।"
"379","[AI-translation] ((जो अज़ान कहे वही इक़ामत कहे))।"
"380","[AI-translation] ((मुअज़्ज़िन को अज़ान पर ज़्यादा इख़्तियार है, जबकि इमाम को इक़ामत पर ज़्यादा इख़्तियार है))।"
"381","[AI-translation] ((जो सिर्फ़ इक़ामत कहे वह हममें से नहीं))।"
"382","[AI-translation] ((जब बिलाल (रज़ियल्लाहु अन्हु) ने इक़ामत कहना शुरू किया, जब «قد قامت الصلاة» पर पहुँचे तो नबी (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: «اقامها الله وادامها»))।"
"383","[AI-translation] ((हर दो एलानों [यानी अज़ान और इक़ामत] के दरमियान [नफ़्ल] नमाज़ है, सिवाय मग़रिब के))।"
"384","[AI-translation] ((अपनी अज़ान और इक़ामत के दरमियान इतना वक़फ़ा रखो कि खाने-पीने वाला अपना खाना-पीना पूरा कर ले))।"
"385","[AI-translation] ((अगर किसी के यहाँ बच्चा पैदा हो और वह उसके दाएँ कान में अज़ान कहे और बाएँ कान में इक़ामत कहे तो उम्मुस्सिब्यान की बीमारी उसे नुक़सान न पहुँचाएगी))।"
"386","[AI-translation] ((जो नमाज़ न पढ़े इस्लाम में उसका कोई हिस्सा नहीं))।"
"387","[AI-translation] ((अल्लाह तआला ने सबसे पहले लोगों पर उनके दीन के बारे में नमाज़ फ़र्ज़ की))।"
"388","[AI-translation] ((जो नमाज़, रोज़े और बड़ी नापाकी से पाकी की हिफ़ाज़त करे वह हक़ीक़ी दोस्त [वली] है, जबकि जो उन्हें ज़ाया करे वह हक़ीक़ी दुश्मन है))।"
"389","[AI-translation] ((मुझे नमाज़ पढ़ने वालों को क़त्ल करने से रोका गया है))।"
"390","[AI-translation] ((जिसने इशा की नमाज़ जमाअत से पढ़ी उसने लैलत-उल-क़द्र में अपना हिस्सा पा लिया))।"
"391","[AI-translation] ((न नमाज़ खाने के लिए मुअख़्खर की जाए, न किसी और काम के लिए))।"
"392","[AI-translation] ((नमाज़ का सबसे अव्वल वक़्त अल्लाह की रज़ा है, जबकि आख़िरी वक़्त अल्लाह की बख़्शिश और माफ़ी का सबब है))।"
"393","[AI-translation] ((जो फ़ज्र को रोशन करे [जल्दी पढ़े], अल्लाह तआला उसका दिल और क़ब्र रोशन करेगा, और उसकी नमाज़ भी क़ुबूल होगी))।"
"394","[AI-translation] ((फ़ज्र को रोशन करो और बख़्श दिए जाओगे))।"
"395","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) फ़ज्र की नमाज़ पढ़ते जब रोशनी आसमान में फैल चुकी होती))।"
"396","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) अस्र की नमाज़ मुअख़्खर करते यहाँ तक कि सूरज सफ़ेद और साफ़ रहता))।"
"397","[AI-translation] ((जो मस्जिद में दुनियावी बातें करे, अल्लाह तआला उसके आमाल बर्बाद कर देगा))।"
"398","[AI-translation] ((हर रात एक पुकारने वाला एलान करता है: ऐ क़ब्रों वालो! तुम किस पर रश्क करते हो? वे जवाब देते हैं: मस्जिद से जुड़े लोगों [यानी मस्जिदों से ताल्लुक़ रखने वालों] पर))।"
"399","[AI-translation] ((अपनी मस्जिदों को अपने बच्चों से महफ़ूज़ रखो))।"
"400","[AI-translation] ((मस्जिदों में ठहरना मेरी उम्मत की रहबानियत है))।"
"401","[AI-translation] ((जो मस्जिद में चराग़ जलाए, आम फ़रिश्ते और अर्श उठाने वाले फ़रिश्ते उसके लिए मग़फ़िरत माँगते रहते हैं जब तक उस चराग़ की रोशनी मस्जिद में रहे))।"
"402","[AI-translation] ((इन मस्जिदों की देखभाल करो उन्हें सफ़ेदी करके, उनमें चराग़ रखकर, फ़ानूस जलाकर और पाक ख़ुशबू लगाकर))।"
"403","[AI-translation] ((क़ियामत के दिन मस्जिदों के सिवा सारी ज़मीनें हलाक होंगी; वे एक-दूसरे से मिल जाएँगी))।"
"404","[AI-translation] ((जो अल्लाह के किसी घर [यानी मस्जिद] की सफ़ाई करे, गोया उसने चार सौ हज किए))।"
"405","[AI-translation] ((मस्जिदों की सफ़ाई जन्नत की हूरों का महर है))।"
"406","[AI-translation] ((मेरी उम्मत के सवाब मेरे सामने पेश किए गए, यहाँ तक कि [वह तिनका भी] जो कोई मस्जिद से हटाए))।"
"407","[AI-translation] ((अगर तुममें से कोई मस्जिद में जूँ पाए तो उसे दफ़न करे))।"
"408","[AI-translation] ((अगर नमाज़ी के पास लाठी [या सुतरे जैसी कोई चीज़] न हो तो वह लकीर खींचे))।"
"409","[AI-translation] ((कोई चीज़ नमाज़ नहीं तोड़ती, [इसलिए अपने सामने गुज़रने वाले को] जहाँ तक हो सके रोको))।"
"410","[AI-translation] ((जो जानबूझकर नमाज़ी के सामने गुज़रे वह क़ियामत के दिन तमन्ना करेगा कि वह सूखा दरख़्त होता))।"
"411","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ने एक आदमी को देखा जो दूसरे आदमी को सुतरा बनाकर नमाज़ पढ़ रहा था, तो उसे नमाज़ दोहराने का हुक्म दिया))।"
"412","[AI-translation] ((ख़बरदार! कोई किसी दूसरे शख़्स या क़ब्र को सुतरा बनाकर नमाज़ न पढ़े))।"
"413","[AI-translation] हज़रत अबू बक्र (रज़ियल्लाहु अन्हु) ने कहा कि आख़िरी नमाज़ जो रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने मेरे पीछे पढ़ी, वह उन्होंने एक कपड़े में पढ़ी।"
"414","[AI-translation] ((एक कपड़े में नमाज़ पढ़ना सुन्नत है))।"
"415","[AI-translation] ([अबू अब्दुर्रहमान कहते हैं:] मैंने नबी (सल्लल्लाहु अलैहि वसल्लम) और आइशा (रज़ियल्लाहु अन्हा) को एक कपड़े में नमाज़ पढ़ते देखा; आधा कपड़ा नबी (सल्लल्लाहु अलैहि वसल्लम) पर था और आधा आइशा (रज़ियल्लाहु अन्हा) पर था।"
"416","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ने पायजामे में नमाज़ पढ़ने से मना किया))।"
"417","[AI-translation] ((जब नमाज़ पढ़ो तो अपने कपड़े टख़नों से ऊपर उठाओ। तुम्हारे कपड़ों का जो हिस्सा ज़मीन को छुए वह आग में है))।"
"418","[AI-translation] ((जब नमाज़ के लिए खड़े हो तो जूते पहनो))।"
"419","[AI-translation] ((नमाज़ के कमाल में से यह भी है कि जूते पहनकर नमाज़ पढ़ी जाए))।"
"420","[AI-translation] ((जिब्रील (अलैहिस्सलाम) मेरे पास आए, और उन्होंने नमाज़ के शुरू में 'बिस्मिल्लाह-इर-रहमान-इर-रहीम' बुलन्द आवाज़ से पढ़ी))।"
"421","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) नमाज़ के शुरू में हाथ उठाते, फिर दोबारा न करते))।"
"422","[AI-translation] ((जब भी रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) रुकूअ में जाते और रुकूअ से उठते तो हाथ उठाते। फिर वह सिर्फ़ नमाज़ के शुरू में हाथ उठाते और किसी और वक़्त नहीं))।"
"423","[AI-translation] ((जिसने नमाज़ में हाथ उठाए उसकी नमाज़ दुरुस्त नहीं))।"
"424","[AI-translation] ((नमाज़ के दौरान नाफ़ के नीचे एक हाथ दूसरे पर रखना सुन्नत है))।"
"425","[AI-translation] ((इमाम की क़िरअत उसके लिए क़िरअत है जिसके सामने इमाम हो))।"
"426","[AI-translation] ((इमाम की क़िरअत तुम्हारे लिए काफ़ी है, चाहे वह आहिस्ता पढ़े या बुलन्द आवाज़ से))।"
"427","[AI-translation] ((इमाम के पीछे कोई क़िरअत नहीं))।"
