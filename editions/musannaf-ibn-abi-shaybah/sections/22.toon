hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"21043","(۲۱۰۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ وَاصِلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ الْقَاذِفِ ، وَتَوْبَتُہُ فِیمَا بَیْنَہُ وَبَیْنَ اللہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21043","","","كتاب البيوع والأقضية"
"21044","(۲۱۰۴۴) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : تَوْبَتُہُ أَنْ یُکَذِّبَ نَفْسَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21044","","","كتاب البيوع والأقضية"
"21045","(۲۱۰۴۵) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ مُجَالِدٍ ، عَنْ عَامِرٍ ، قَالَ : تَوْبَتُہُ أَنْ یَقُومَ مِثْلَ مَقَامِہِ فَیُکَذِّبَ نَفْسَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21045","","","كتاب البيوع والأقضية"
"21046","(۲۱۰۴۶) حَدَّثَنَا حَفْصٌ ، وَأَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَسَنِ بْنِ الْحَکَمِ ، عَنْ زَیْدِ بْنِ ثَابِتٍ وَحَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ شُرَیْحٍ ، قَالاَ : الْمُدَبَّرُ لاَ یُبَاعُ۔","Da'if","Musannaf Ibn Abi Shaybah 21046","","","كتاب البيوع والأقضية"
"21047","(۲۱۰۴۷) حَدَّثَنَا أَبُو خَالِدٍ ، وَأَبُو مُعَاوِیَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : الْمُدَبَّرَۃُ لاَ یَبِیعُہَا سَیِّدُہَا ، وَلاَ یُزَوِّجُہَا ، وَلاَ یَہَبُہَا وَوَلَدُہَا بِمَنْزِلَتِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 21047","","","كتاب البيوع والأقضية"
"21048","(۲۱۰۴۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عُثْمَانَ بْنِ حَکِیمٍ ، قَالَ : سَأَلْتُ سَالِمًا : أَیَحِلُّ لِی أَنْ أَبِیعَہَا ؟ قَالَ : لاَ ، قُلْتُ : أُمْہِرُہَا ؟ قَالَ : لاَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21048","","","كتاب البيوع والأقضية"
"21049","(۲۱۰۴۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : الْمُعْتَقُ عَنْ دُبُرٍ بِمَنْزِلَۃِ الْمَمْلُوکِ إلاَّ أَنَّہُ لاَ یُبَاعُ ، وَلاَ یُوہَبُ ، فَإِذا مَاتَ مَوْلاَہُ عَتَقَ۔","","Musannaf Ibn Abi Shaybah 21049","","","كتاب البيوع والأقضية"
"21050","(۲۱۰۵۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ یُونُسَ، عَنِ الْحَسَنِ، أَنَّہُ کَرِہَ بَیْعَ الْمُعْتَقِ عَنْ دُبُرٍ إلاَّ أَنْ یُصِیبَ صَاحِبَہُ فَقْرٌ شَدِیدٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 21050","","","كتاب البيوع والأقضية"
"21051","(۲۱۰۵۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أیوب ، عن محمد ؛ أنہ کرہ بیع المعتق عن دبر إلا من نفسہ۔","","Musannaf Ibn Abi Shaybah 21051","","","كتاب البيوع والأقضية"
"21052","(۲۱۰۵۲) حَدَّثَنَا عبد السلام بن حرب ، عن أیوب ، وہشام عن محمد ، قَالَ : لاَ یباع المدبر إلا من نفسہ۔","","Musannaf Ibn Abi Shaybah 21052","","","كتاب البيوع والأقضية"
"21053","(۲۱۰۵۳) حَدَّثَنَا یَعْلَی ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : لاَ یَبِیعُہَا إلاَّ أَنْ یَحْتَاجَ إلَی ثَمَنِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 21053","","","كتاب البيوع والأقضية"
"21054","(۲۱۰۵۴) حَدَّثَنَا شریک ، عن سلمۃ بن کہیل ، عن عطاء ، وأبو الزبیر عن جابر ؛ أن النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ باع مدبرًا۔ (بخاری ۲۱۴۱۔ نسائی ۶۲۵۰)","Hasan","Musannaf Ibn Abi Shaybah 21054","","","كتاب البيوع والأقضية"
"21055","(۲۱۰۵۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ جَابِرٍ ، أَنَّ رَجُلاً دَبَّرَ غُلاَمًا فَبَاعَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنِ ابْنِ النَّحَّامِ ، غُلاَمًا قِبْطِیًّا مَاتَ عَامَ أَوَّلَ فِی إمَارَۃِ ابْنِ الزُّبَیْرِ۔ (بخاری ۲۲۳۱۔ مسلم ۱۲۸۹)","Sahih","Musannaf Ibn Abi Shaybah 21055","","","كتاب البيوع والأقضية"
"21056","(۲۱۰۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ کَرِہَ بَیْعَ الْمُدَبَّرِ۔","Sahih","Musannaf Ibn Abi Shaybah 21056","","","كتاب البيوع والأقضية"
"21057","(۲۱۰۵۷) حَدَّثَنَا إسْمَاعِیلُ بْنُ إبْرَاہِیمَ وَہُوَ ابْنُ عُلَیَّۃَ ، عَنْ یَحْیَی بْنِ یَزِیدَ الْہُنَائِیِّ ، قَالَ : سَأَلْتُ أَنَسَ بْنَ مَالِکٍ عَنِ الرَّجُلِ یُہْدِی لَہُ غَرِیمُہُ فَقَالَ : إِنْ کَانَ یُہْدِی لَہُ قَبْلَ ذَلِکَ فَلاَ بَأْسَ ، وَإِنْ لَمْ یَکُنْ یُہْدِی لَہُ قَبْلَ ذَلِکَ فَلاَ یَصْلُحُ۔","Hasan","Musannaf Ibn Abi Shaybah 21057","","","كتاب البيوع والأقضية"
"21058","(۲۱۰۵۸) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : إذَا أُقْرِضْتَ قَرْضًا فَلاَ تُہْدِیَنَّ ہَدِیَّۃً کُرَاعًا ، وَلاَ رُکُوبَ دَابَّۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 21058","","","كتاب البيوع والأقضية"
"21059","(۲۱۰۵۹) حَدَّثَنَا أَبُو الأَحْوَص ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ ، عَنْ کُلْثُومِ بْنِ الأَقْمَرِ ، عَنْ زِرِّ بْنِ حُبَیْشٍ ، قَالَ : قَالَ أُبَیٌّ: إذْ أَقْرَضْت قَرْضًا ، فَجَائَ صَاحِبُ الْقَرْضِ یَحْمِلُہُ وَمَعَہُ ہَدِیَّۃٌ ، فَخُذْ مِنْہُ قَرْضَہُ ، وَرُدَّ عَلَیْہِ ہَدِیَّتَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 21059","","","كتاب البيوع والأقضية"
"21060","(۲۱۰۶۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : إذَا کَانَ لِلرَّجُلِ عَلَی الرَّجُلِ الدَّیْنُ فَأَہْدَی إلَیْہِ لِیُؤَخِّرَ عَنْہُ فَلْیَحْسِبْہُ مِنْ دَیْنِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21060","","","كتاب البيوع والأقضية"
"21061","(۲۱۰۶۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، وَمُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا کَانَ ذَلِکَ قَدْ جَرَی بَیْنَہُمَا قَبْلَ الدَّیْنِ یَدْعُوہُ ویَدْعُوہُ الآخَرُ وَیُکَافِیہ فَلاَ بَأْسَ بِذَلِکَ ، وَلاَ یَحْسِبُہُ مِنْ دَیْنِہِ۔","","Musannaf Ibn Abi Shaybah 21061","","","كتاب البيوع والأقضية"
"21062","(۲۱۰۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا کَانَا یَتَہَادَیَانِ قَبْلَ ذَلِکَ فَلاَ بَأْسَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21062","","","كتاب البيوع والأقضية"
"21063","(۲۱۰۶۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، أَنَّ أُبَیًّا کَانَ لَہُ عَلَی عُمَرَ دَیْنٌ فَأَہْدَی إلَیْہِ ہَدِیَّۃً فَرَدَّہَا ، فَقَالَ عُمَرُ : إنَّمَا الرِّبَا عَلَی مَنْ أَرَادَ أَنْ یُرْبِیَ ، وَیُنْسِیئَ۔","","Musannaf Ibn Abi Shaybah 21063","","","كتاب البيوع والأقضية"
"21064","(۲۱۰۶۴) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ زَیْدِ بْنِ أَبِی أُنَیْسَۃَ ، أَنَّ عَلِیًّا سُئِلَ عَنِ الرَّجُلِ یَقْرِضُ الرَّجُلَ الْقَرْضَ وَیُہْدِی إلَیْہِ ، قَالَ : ذَلِکَ الرِّبَا الْعَجْلاَنُ","","Musannaf Ibn Abi Shaybah 21064","","","كتاب البيوع والأقضية"
"21065","(۲۱۰۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ ابن عُمَرَ ، قَالَ : یُقَاصُّہُ۔","","Musannaf Ibn Abi Shaybah 21065","","","كتاب البيوع والأقضية"
"21066","(۲۱۰۶۶) حَدَّثَنَا یَحْیَی بْنُ عَبْدِ الْمَلِکِ بْنِ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، قَالَ : کَانَ یَکْرَہُ أَنْ یَأْکُلَ الرَّجُلُ مِنْ بَیْتِ الرَّجُلِ وَلَہُ عَلَیْہِ دَیْنٌ إلاَّ أَنْ یَحْسِبَہُ مِنْ دَیْنِہِ۔","","Musannaf Ibn Abi Shaybah 21066","","","كتاب البيوع والأقضية"
"21067","(۲۱۰۶۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ وَحَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ صَالِحِ بْن حَیٍّ ، عَنْ عَامِرٍ ، قَالَ : إِنْ کَانَ لَکَ عَلَی الرَّجُلِ الدَّیْنُ فَلاَ تُضَیِّفْہُ۔","","Musannaf Ibn Abi Shaybah 21067","","","كتاب البيوع والأقضية"
"21068","(۲۱۰۶۸) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : ذُکِرَ لابْنِ مَسْعُودٍ أن رَجُلاً أَقْرَضَ رَجُلاً دراہم وَاشْتَرَطَ ظَہْرَ فَرَسِہِ ، قَالَ : مَا أَصَابَ مِنْ ظَہْرِ فَرَسِہِ ، فَہُوَ رِبًا۔","","Musannaf Ibn Abi Shaybah 21068","","","كتاب البيوع والأقضية"
"21069","(۲۱۰۶۹) حَدَّثَنَا شِہَابُ بْنُ مُحَمَّدٍ الْعَامِرِیُّ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : قُلْتُ لَہُ : إذَا کَانَ لِی عَلَی رَجُلٍ دراہم أَسْتَعِیرُ مِنْہُ دَابَّۃً ، أَوْ أَطْلُبُ مِنْہُ مَعْرُوفًا ، قَالَ : لاَ بَأْس۔","No Data Available","Musannaf Ibn Abi Shaybah 21069","","","كتاب البيوع والأقضية"
"21070","(۲۱۰۷۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانُوا یَقُولُونَ : قَضَاء وَحَمْد۔","","Musannaf Ibn Abi Shaybah 21070","","","كتاب البيوع والأقضية"
"21071","(۲۱۰۷۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ تَبتَع مِنْ مُضْطَرٍّ شیئًا۔","Da'if","Musannaf Ibn Abi Shaybah 21071","","","كتاب البيوع والأقضية"
"21072","(۲۱۰۷۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، قَالَ : کَانَ شُرَیْحٌ لاَ یُجِیزُ بَیْعَ الضُّغْطَۃِ۔","","Musannaf Ibn Abi Shaybah 21072","","","كتاب البيوع والأقضية"
"21073","(۲۱۰۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ أَبِی معقل ، قَالَ : بَیْعُ الْمُضْطَرِّ رِبًا۔","","Musannaf Ibn Abi Shaybah 21073","","","كتاب البيوع والأقضية"
"21074","(۲۱۰۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ وَعَلِیِّ بْنِ صَالِحٍ ، عَنْ أَبِی الْہَیْثَمِ قَالَ : قُلْتُ لإِبْرَاہِیمَ : الرَّجُلُ یَعَذَّبُ ، أَشْتَرِی مِنْہُ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 21074","","","كتاب البيوع والأقضية"
"21075","(۲۱۰۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ تشْتَرِ مِنْ مُضْطَرٍّ شَیْئًا۔","No Data Available","Musannaf Ibn Abi Shaybah 21075","","","كتاب البيوع والأقضية"
"21076","(۲۱۰۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عُبَیْدِ اللہِ بْنِ الْوَلِیدِ ، عَنْ سَالِمٍ ، قَالَ : نُہِیَ عَنْ بَیْعِ الْمُضْطَرِّ۔","No Data Available","Musannaf Ibn Abi Shaybah 21076","","","كتاب البيوع والأقضية"
"21077","(۲۱۰۷۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : کَانُوا یَکْرَہُونَ کُلَّ قَرْضٍ جَرَّ مَنْفَعَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 21077","","","كتاب البيوع والأقضية"
"21078","(۲۱۰۷۸) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کُلُّ قَرْضٍ جَرَّ مَنْفَعَۃً ، فَہُوَ رِبًا۔","No Data Available","Musannaf Ibn Abi Shaybah 21078","","","كتاب البيوع والأقضية"
"21079","(۲۱۰۷۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ أَنَّہُمَا کَانَا یَکْرَہَانِ کُلَّ قَرْضٍ جَرَّ مَنْفَعَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 21079","","","كتاب البيوع والأقضية"
"21080","(۲۱۰۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : أَقْرَضَ رَجُلٌ رَجُلاً خَمْسَمِئَۃِ دِرْہَمٍ وَاشْتَرَطَ عَلَیْہِ ظَہْرَ فَرَسِہِ فَقَالَ ابْنُ مَسْعُودٍ : مَا أَصَابَ مِنْ ظَہْرِ فَرَسِہِ ، فَہُوَ رِبًا۔","","Musannaf Ibn Abi Shaybah 21080","","","كتاب البيوع والأقضية"
"21081","(۲۱۰۸۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ کُلَّ قَرْضٍ جَرَّ مَنْفَعَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 21081","","","كتاب البيوع والأقضية"
"21082","(۲۱۰۸۲) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ طَارِقٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، أَنَّہُ کَرِہَ الرُّطَبَ بِالتَّمْرِ مِثْلاً بِمِثْلٍ ، وَقَالَ : الرُّطَبُ مُنْتَفِخٌ ، وَالتَّمْرُ یَابِسٌ۔","","Musannaf Ibn Abi Shaybah 21082","","","كتاب البيوع والأقضية"
"21083","(۲۱۰۸۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کان یکرہ أن یُشْتَرَی الرطب بالتمر الیابس۔","No Data Available","Musannaf Ibn Abi Shaybah 21083","","","كتاب البيوع والأقضية"
"21084","(۲۱۰۸۴) حَدَّثَنَا ابن فضیل ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یُشْتَرَی الرُّطَبَ بِالْیَابِسِ۔","","Musannaf Ibn Abi Shaybah 21084","","","كتاب البيوع والأقضية"
"21085","(۲۱۰۸۵) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ بَیْعِ الثَّمرِ بِالتَّمْرِ کَیْلاً ، وَعَنْ بَیْعِ الْعِنَبِ بِالزَّبِیبِ کَیْلاً ، وَعَنْ بَیْعِ الزَّرْعِ بِالْحِنْطَۃِ کَیْلاً۔n(مسلم ۱۱۷۱۔ ابوداؤد ۳۳۵۴)","Sahih","Musannaf Ibn Abi Shaybah 21085","","","كتاب البيوع والأقضية"
"21086","(۲۱۰۸۶) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ زَائِدَۃَ بْنِ قُدَامَۃَ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَرِہَ الرُّطَبَ بِالتَّمْرِ ، وَقَالَ : ہُوَ أَقَلُّہُمَا فِی الْمِکْیَالِ ، أَوْ فِی الْقَفِیزِ۔","","Musannaf Ibn Abi Shaybah 21086","","","كتاب البيوع والأقضية"
"21087","(۲۱۰۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، عَنْ زَیْدٍ أَبِی عَیَّاشٍ ، قَالَ : سَأَلْتُ سَعْدًا عَنِ السُّلْتِ بِالذُّرَۃِ فَکَرِہَہُ ، وقَالَ : سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ الرُّطَبِ بِالتَّمْرِ فَقَالَ : أَیَنْقُصُ إذَا جَفَّ ؟ فَقَالُوا : نَعَمْ ، فَکَرِہَہُ۔ (ترمذی ۱۲۲۵۔ ابن ماجہ ۲۲۶۴)","Sahih","Musannaf Ibn Abi Shaybah 21087","","","كتاب البيوع والأقضية"
"21088","(۲۱۰۸۸) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، أَنَّہُ کَرِہَ التَّمْرَ الرُّطَب بالْیَابِسِ مِثْلاً بِمِثْلٍ۔","","Musannaf Ibn Abi Shaybah 21088","","","كتاب البيوع والأقضية"
"21089","(۲۱۰۸۹) حَدَّثَنَا جَرِیرٌ ، عَنْ أَبَانَ بْنِ تَغْلِبَ ، عَنِ الْحَارِثِ عن إبْرَاہِیمَ وَغَیْرِہِ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَنْ أَعْتَقَ شِقْصًا لَہُ فِی مَمْلُوکٍ لَہُ ، وَکَانَ لَہُ کُلُّہُ ، أَوْ بَعْضُہُ ، فَہُوَ عَتِیقٌ کُلُّہُ۔","","Musannaf Ibn Abi Shaybah 21089","","","كتاب البيوع والأقضية"
"21090","(۲۱۰۹۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ عَبَّاسٍ فِی رَجُلٍ ، قَالَ لِجَارِیَتِہِ : فَرْجُکِ حُرٌّ ، قَالَ : ہِیَ حُرَّۃٌ ، وَإِذَا عَتَقَ مِنْہَا شَیْئٌ فَہِیَ حُرَّۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 21090","","","كتاب البيوع والأقضية"
"21091","(۲۱۰۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ خَالِدِ بْنِ سَلَمَۃَ ، قَالَ : جَائَ رَجُلٌ إلَی عُمَرَ وَہُوَ بِعَرَفَۃَ فَقَالَ : إنِّی أَعْتَقْتُ ثُلُثَ عَبْدِی ، فَقَالَ عُمَرُ : ہُوَ حُرٌّ کُلُّہُ ، لَیْسَ للہِ شَرِیکٌ۔","","Musannaf Ibn Abi Shaybah 21091","","","كتاب البيوع والأقضية"
"21092","(۲۱۰۹۲) حَدَّثَنَا وکیع ، عن سفیان ، عن جابر ، عن عامر ، قَالَ : إذا أعتق بعضہ ، فہو حر کلہ۔","","Musannaf Ibn Abi Shaybah 21092","","","كتاب البيوع والأقضية"
"21093","(۲۱۰۹۳) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ فِی رَجُلٍ أَعْتَقَ ثُلُثَ عَبْدِہِ ، قَالَ : یَسْعَی لَہُ فِی الثُّلُثَیْنِ ، وَلاَ یَضْمَنُ لِبَقِیَّتِہِ۔","","Musannaf Ibn Abi Shaybah 21093","","","كتاب البيوع والأقضية"
"21094","(۲۱۰۹۴) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی الْمَلِیحِ ، أَنَّ رَجُلاً أَعْتَقَ ثُلُثَ غُلاَمٍ لَہُ ، فَرُفِعَ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : ہُوَ حُرٌّ ، لَیْسَ للہ شَرِیکٌ۔ (ابوداؤد ۳۹۲۹۔ احمد ۵/۷۵)","","Musannaf Ibn Abi Shaybah 21094","","","كتاب البيوع والأقضية"
"21095","(۲۱۰۹۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، عَنْ رَجُلٍ ، قَالَ لِغُلاَمِہِ : نِصْفُکَ حُرٌّ ، قَالَ : إِنْ کَانَ کَمَا یَقُولُونَ : الضَّمَانُ حَقٌّ ، فَہُوَ عَتِیقٌ ، وَکَانَ مِنْ رَأْیِ الْحَکَمِ أَنْ یُعْتِقَہُ ، قَالَ : وَسَأَلْتُ حَمَّادًا فَقَالَ : یَعْتِقُ نِصْفَہُ وَیَسْعَی فِی النِّصْفِ الْبَاقِی","","Musannaf Ibn Abi Shaybah 21095","","","كتاب البيوع والأقضية"
"21096","(۲۱۰۹۶) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ عَلِیٌّ : یُعْتِقُ الرَّجُلُ مَا شَائَ مِنْ غُلاَمِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 21096","","","كتاب البيوع والأقضية"
"21097","(۲۱۰۹۷) حَدَّثَنَا عبدۃ بْنُ سُلَیْمَانَ ، عَنْ إسْمَاعِیلَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا أَعْتَقَ من عَبْدِہِ قَلِیلاً ، أَوْ کَثِیرًا ، فَہُوَ عَتِیقٌ ، وَإِذَا طَلَّقَ مِنِ امْرَأَتِہِ إصْبَعًا ، أَوْ أَکْثَرَ مِنْ ذَلِکَ فَہِیَ طَالِقٌ۔","","Musannaf Ibn Abi Shaybah 21097","","","كتاب البيوع والأقضية"
"21098","(۲۱۰۹۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِی ، عَنِ الزُّہْرِیِّ ، قَالَ : مَضَتِ السُّنَّۃُ أَنْ تَجُوزَ شَہَادَۃُ النِّسَائِ فِیمَا لاَ یَطَّلِعُ عَلَیْہِ غَیْرُہُنَّ مِنْ وِلاَدَاتِ النِّسَائِ وَعُیُوبِہِنَّ ، وَتَجُوزُ شَہَادَۃُ الْقَابِلَۃِ وَحْدَہَا فِی الإِسْتِہْلاَلِ ، وَامْرَأَتَانِ فِیمَا سِوَی ذَلِکَ۔ (عبدالرزاق ۱۵۴۲۷)","Da'if","Musannaf Ibn Abi Shaybah 21098","","","كتاب البيوع والأقضية"
"21099","(۲۱۰۹۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ فِیمَا لاَ تَجُوزُ فِیہِ شَہَادَاتُ الرِّجَالِ : أَرْبَع نسوۃ ، وَقَالَ الْحَکَمُ : امْرَأَتَانِ تُجْزیَانِ۔","","Musannaf Ibn Abi Shaybah 21099","","","كتاب البيوع والأقضية"
"21100","(۲۱۱۰۰) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : تَجُوزُ شَہَادَۃُ النِّسَائِ عَلَی الاسْتِہْلاَلِ۔","","Musannaf Ibn Abi Shaybah 21100","","","كتاب البيوع والأقضية"
"21101","(۲۱۱۰۱) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ إسْمَاعِیلَ ، عَنْ عَامِرٍ ، قَالَ : مِنَ الشَّہَادَاتِ شَہَادَات لاَ یَجُوزُ فِیہَا إلاَّ شَہَادَاتُ النِّسَائِ۔","","Musannaf Ibn Abi Shaybah 21101","","","كتاب البيوع والأقضية"
"21102","(۲۱۱۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، وَعَنْ یُونُسَ ، عَنِ الْحَسَنِ ، وَعَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ قَالُوا : تَجُوزُ شَہَادَۃُ امْرَأَۃٍ وَاحِدَۃٍ فِیمَا لاَ یَطَّلِعُ عَلَیْہِ الرِّجَالُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21102","","","كتاب البيوع والأقضية"
"21103","(۲۱۱۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ تَجُوزُ أَقَلُّ مِنْ شَہَادَۃِ أَرْبَعِ نِسْوَۃٍ فِیمَا لاَ تَجُوزُ فِیہِ شَہَادَۃُ الرِّجَالِ۔","","Musannaf Ibn Abi Shaybah 21103","","","كتاب البيوع والأقضية"
"21104","(۲۱۱۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ شُرَیْحٍ ، أَنَّہُ أَجَازَ شَہَادَۃَ قَابِلَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 21104","","","كتاب البيوع والأقضية"
"21105","(۲۱۱۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ اللہِ بْنِ نُجَیٍّ ، عَنْ عَلِیٍّ ، أَنَّہُ أَجَازَ شَہَادَۃَ قَابِلَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 21105","","","كتاب البيوع والأقضية"
"21106","(۲۱۱۰۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الشَّیْبَانِیِّ ، وَأَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ ، قَالَ : تَجُوزُ شَہَادَۃُ قَابِلَۃٍ وَاحِدَۃٍ ، وَقَالَ أَحَدُہُمَا : وَإِنْ کَانَتْ یَہُودِیَّۃً۔","","Musannaf Ibn Abi Shaybah 21106","","","كتاب البيوع والأقضية"
"21107","(۲۱۱۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : مِنَ الشَّہَادَۃِ شَہَادَۃٌ لاَ تَجُوزُ فِیہَا إلاَّ شَہَادَۃُ امْرَأَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 21107","","","كتاب البيوع والأقضية"
"21108","(۲۱۱۰۸) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ رَجُلٍ ، عَنْ شُرَیْحٍ فِی الشّاہِدینِ یَخْتَلِفَانِ فَشَہِدَ أَحَدُہُمَا عَلَی عِشْرِینَ وَالآخَرُ عَلَی عَشْرَۃٍ ، قَالَ : یُؤْخَذُ بِالْعَشَرَۃِ۔","","Musannaf Ibn Abi Shaybah 21108","","","كتاب البيوع والأقضية"
"21109","(۲۱۱۰۹) حَدَّثَنَا شریک ، عن جابر ، عن عامر ، وعن مغیرۃ ، عَنْ إبْرَاہِیمَ : مثلہ۔","No Data Available","Musannaf Ibn Abi Shaybah 21109","","","كتاب البيوع والأقضية"
"21110","(۲۱۱۱۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَمَّادٍ ، عَنْ مِسْعَرٍ ، عَنْ عُمَرَ بْنِ عَبْدِ اللہِ بْنِ وَاثِلَۃَ ، قَالَ : شَہِدَ شَاہِدَانِ عِنْدَ شُرَیْحٍ أَحَدُہُمَا بِأَکْثَرَ وَالآخَرُ بِأَقَلَّ ، فَأَجَازَ شَہَادَتَہُمَا عَلَی الأَقَلِّ۔","","Musannaf Ibn Abi Shaybah 21110","","","كتاب البيوع والأقضية"
"21111","(۲۱۱۱۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الْمُخْتَارِ بْنِ عَبْدِ اللہِ بْنِ مَلِیحٍ الثَّقَفِیِّ ، عَنْ عُمَرَ بْنِ عَبْدِ اللہِ بْنِ وَاثِلَۃَ ، قَالَ : شَہِدَ عِنْدَ شُرَیْحٍ شَاہِدَانِ أَحَدُہُمَا عَلَی أَلْفٍ وَالآخَرُ عَلَی خَمْسِ مِئَۃٍ ، فَأَجَازَ شُرَیْحٌ شَہَادَتَہُمَا عَلَی الخَمْسِ مِئَۃٍ۔","","Musannaf Ibn Abi Shaybah 21111","","","كتاب البيوع والأقضية"
"21112","(۲۱۱۱۲) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : لَہُ أَوْکَسُہُمَا۔","No Data Available","Musannaf Ibn Abi Shaybah 21112","","","كتاب البيوع والأقضية"
"21113","(۲۱۱۱۳) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کُلُّ حَوَالَۃٍ تَرْجِعُ إلاَّ أَنْ یَقُولَ الرَّجُلُ لِلرَّجُلِ : أَبِیعُکَ مَا عَلَی فُلاَنٍ وفلان بِکَذَا وَکَذَا ، فَإِذَا بَاعَہُ فَلاَ یَرْجِعُ۔","","Musannaf Ibn Abi Shaybah 21113","","","كتاب البيوع والأقضية"
"21114","(۲۱۱۱۴) حَدَّثَنَا یَحْیَی بْنُ أَبِی زَائِدَۃَ ، عَنْ ابن أَبِی غَنِیَّۃَ ، عَنِ الْحَکَمِ بْنِ عُتَیْبَۃَ ، قَالَ : لاَ یَرْجِعُ فِی الْحَوَالَۃِ إلَی صَاحِبِہِ حَتَّی یُفْلِسَ ، أَوْ یَمُوتَ ، وَلاَ یَدَعُ وفاء ، فَإِنَّ الرَّجُلَ یُوسِرُ مَرَّۃً وَیُعْسِرُ مَرَّۃً۔","","Musannaf Ibn Abi Shaybah 21114","","","كتاب البيوع والأقضية"
"21115","(۲۱۱۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ خُلَیْدِ بْنِ جَعْفَرٍ ، عَنْ أَبِی إیَاسٍ ، عَنْ عُثْمَانَ فِی الْحَوَالَۃِ : یَرْجِعُ ، لَیْسَ عَلَی مال مُسْلِمٍ تَوًی۔","","Musannaf Ibn Abi Shaybah 21115","","","كتاب البيوع والأقضية"
"21116","(۲۱۱۱۶) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا احْتَالَ عَلَی مَلِیئٍ ، ثُمَّ أَفْلَسَ بَعْدُ ، فَہُوَ جَائِزٌ عَلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21116","","","كتاب البيوع والأقضية"
"21117","(۲۱۱۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ خَطَّابٍ الْعُصْفُرِیِّ ، قَالَ : أَحَالَنِی رَجُلٌ عَلَی یَہُودِیٍّ فَلَوَّانِی ، فَسَأَلْتُ الشَّعْبِیَّ فَقَالَ: ارْجِعْ إلَی الأَوَّلِ۔","","Musannaf Ibn Abi Shaybah 21117","","","كتاب البيوع والأقضية"
"21118","(۲۱۱۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ شُرَیْحٍ ؛ فِی الرَّجُلِ یُحِیلُ الرَّجُلَ فَیَتْوَی ، قَالَ : یَرْجِعُ عَلَی الأَوَّلِ۔","","Musannaf Ibn Abi Shaybah 21118","","","كتاب البيوع والأقضية"
"21119","(۲۱۱۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ بِنَحْوِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21119","","","كتاب البيوع والأقضية"
"21120","(۲۱۱۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی السَّفَرِ ، عَنِ الشَّعْبِیِّ ، أَنَّہُ کَرِہَ أَنْ یَقُولَ : أَشْتَرِی مِنْک مَا عَلَی فُلاَنٍ ، وَقَالَ : ہُوَ غَرَرٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 21120","","","كتاب البيوع والأقضية"
"21121","(۲۱۱۲۱) حَدَّثَنَا مُعَاذُ بن معاذ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی الْحَوَالَۃَ بَرَاء ۃً إلاَّ أَنْ یُبْرِئَہُ ، فَإِذَا أَبْرَأَہُ ، فَقَدْ بَرِئَ۔","","Musannaf Ibn Abi Shaybah 21121","","","كتاب البيوع والأقضية"
"21122","(۲۱۱۲۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ، عَنِ الشَّیْبَانِیِّ، عَنْ مُحَمَّدِ بْنِ عُبَیْدِاللہِ الثَّقَفِیِّ، قَالَ: کَتَبَ عُمَرُ بْنُ الْخَطَّابِ، إِنَّ النِّسَائَ یُعْطِینَ أَزْوَاجَہُنَّ رَغْبَۃً وَرَہْبَۃً ، فَأَیُّمَا امْرَأَۃٍ أَعْطَتْ زَوْجَہَا شَیْئًا فَأَرَادَتْ أَنْ تَعْتَصِرَہُ فَہِیَ أَحَقُّ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 21122","","","كتاب البيوع والأقضية"
"21123","(۲۱۱۲۳) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ عَامِرٍ ، قَالَ : لاَ تَرْجِعُ الْمَرْأَۃُ فِی ہِبَتِہَا ، وَلاَ یَرْجِعُ الرَّجُلُ فِی ہِبَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21123","","","كتاب البيوع والأقضية"
"21124","(۲۱۱۲۴) حَدَّثَنَا وکیع، عن سفیان ، عن منصور ، عَنْ إبْرَاہِیمَ ، فی الرجل والمرأۃ لیس لواحد منہما أن یرجع فیما وہب لصاحبہ۔","","Musannaf Ibn Abi Shaybah 21124","","","كتاب البيوع والأقضية"
"21125","(۲۱۱۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ الْجَزَرِیِّ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ فِی الزَّوْجِ وَالْمَرْأَۃِ لَیْسَ لِوَاحِدٍ مِنْہُمَا أَنْ یَرْجِعَ فِیمَا وَہَبَ لِصَاحِبِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21125","","","كتاب البيوع والأقضية"
"21126","(۲۱۱۲۶) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : جَائَتِ امْرَأَۃٌ تُخَاصِمُ زَوْجَہَا إلَی شُرَیْحٍ فِی شَیْئٍ أَعْطَتْہُ إیَّاہُ فَقَالَ الرَّجُلُ : أَلَیْسَ قَدْ قَالَ اللَّہُ تَعَالَی : (فَإِنْ طِبْنَ لَکُمْ عَنْ شَیْئٍ مِنْہُ نَفْسًا فَکُلُوہُ ہَنِیئًا مَرِیئًا) فَقَالَ شُرَیْحٌ : لَوْ طَابَتْ بِہِ نَفْسُہَا لَمْ تُخَاصِمْک۔","","Musannaf Ibn Abi Shaybah 21126","","","كتاب البيوع والأقضية"
"21127","(۲۱۱۲۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ : شَاہِدَانِ ذَوَا عَدْلٍ أَنَّہَا تَرَکَتْہُ مِنْ غَیْرِ کُرْہٍ ، وَلاَ ہَوَانٍ۔","","Musannaf Ibn Abi Shaybah 21127","","","كتاب البيوع والأقضية"
"21128","(۲۱۱۲۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ طَاوُوس ، قَالَ : إذَا وَہَبَتِ الْمَرْأَۃُ لِزَوْجِہَا ، ثُمَّ رَجَعَتْ فِیہِ یُرَدُّ إلَیْہَا۔","","Musannaf Ibn Abi Shaybah 21128","","","كتاب البيوع والأقضية"
"21129","(۲۱۱۲۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ، قَالَ: إذا أَعْطَتِ الْمَرْأَۃُ زَوْجَہَا وَہِیَ طَیِّبَۃُ النَّفْسِ، فَہُوَ جَائِزٌ ، وَقَالَ مَنْصُورٌ : لاَ یُعْجِبُنِی۔","","Musannaf Ibn Abi Shaybah 21129","","","كتاب البيوع والأقضية"
"21130","(۲۱۱۳۰) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ وَوَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ عَامِرٍ ، قَالَ : یَجُوزُ لَہَا مَا أَعْطَاہَا زَوْجُہَا ، وَلاَ یَجُوزُ لَہُ مَا أَعْطَتْہُ۔","","Musannaf Ibn Abi Shaybah 21130","","","كتاب البيوع والأقضية"
"21131","(۲۱۱۳۱) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا ارْتَہَنَ الرَّجُلُ الأَرْضَ فَلَیْسَ لَہُ أَنْ یَعْمَلَ فِیہَا شَیْئًا ، فَإِنْ عَمِلَ فیہا شیئا حُسِبَ لِصَاحِبِ الأَرْضِ مِنْ رَہْنِہِ مثلُ أَجْرَ مِثْلِہَا۔","","Musannaf Ibn Abi Shaybah 21131","","","كتاب البيوع والأقضية"
"21132","(۲۱۱۳۲) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ فِی رَجُلٍ رَہَنَ امْرَأَتَہُ أَرْضًا بِصَدَاقِہَا فَأَکَلَتْ مِنَ الْغَلَّۃِ ، قَالَ : لاَ تُحْسَبُ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 21132","","","كتاب البيوع والأقضية"
"21133","(۲۱۱۳۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ زَکَرِیَّا ، عَنْ عَامِرٍ ؛ فِی رَجُلٍ ارْتَہَنَ مَمْلُوکَۃً لَہَا ابْنٌ فأَرْضَعَتْ لَہُ ، قَالَ : یُحْسَبُ لَہُ أَجْرُ مِثْلِہَا بِمَا أَرْضَعَتْ۔","","Musannaf Ibn Abi Shaybah 21133","","","كتاب البيوع والأقضية"
"21134","(۲۱۱۳۴) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا انْتَفَعَ مِنَ الرَّہْنِ بِشَیْئٍ قَاصَّہُ بِقَدْرِ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 21134","","","كتاب البيوع والأقضية"
"21135","(۲۱۱۳۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حَسَنٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی رَجُلٍ ارْتَہَنَ دَارًا ، أَوْ غُلاَمًا فَاسْتَغَلَّہُ ، قَالَ : الْغَلَّۃُ مِنَ الرَّہْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21135","","","كتاب البيوع والأقضية"
"21136","(۲۱۱۳۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : إذَا أَقَرَّ لِوَارِثٍ بِدَیْنٍ جَازَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21136","","","كتاب البيوع والأقضية"
"21137","(۲۱۱۳۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَامِرٍ الأَحْوَلِ ، قَالَ : سُئِلَ الْحَسَنُ عَنْہُ فَقَالَ : أُحَمِّلُہَا إیَّاہُ ، وَلاَ أَتَحَمَّلُہَا عَنْہُ۔","","Musannaf Ibn Abi Shaybah 21137","","","كتاب البيوع والأقضية"
"21138","(۲۱۱۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، وَعَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، وَعَنْ سُفْیَانَ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، وَعَنْ سُفْیَانَ عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالوا : إذَا أَقَرَّ فِی مَرَضٍ لِوَارِثٍ بِدَیْنٍ لَمْ یَجُزْ إلاَّ بِبَیِّنَۃٍ ، وَإِذَا أَقَرَّ لِغَیْرِ وَارِثٍ جَازَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21138","","","كتاب البيوع والأقضية"
"21139","(۲۱۱۳۹) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ أُذَیْنَۃَ ؛ فِی الرَّجُلِ یُقِرُّ لِوَارِثٍ بِدَیْنٍ ، قَالَ : لاَ یَجُوزُ۔","","Musannaf Ibn Abi Shaybah 21139","","","كتاب البيوع والأقضية"
"21140","(۲۱۱۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ یَجُوزُ إقْرَارُ الْمَرِیضِ۔","","Musannaf Ibn Abi Shaybah 21140","","","كتاب البيوع والأقضية"
"21141","(۲۱۱۴۱) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ عَطَائٍ ؛ فِی رَجُلٍ أَقَرَّ لِوَارِثٍ بِدَیْنٍ ، قَالَ : جَائِزٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 21141","","","كتاب البيوع والأقضية"
"21142","(۲۱۱۴۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُبَیْدِ اللہِ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، أَنَّہُ کَانَ یُجِیزُ اعْتِرَافَ الرَّجُلِ عِنْدَ مَوْتِہِ بِالدَّیْنِ لِغَیْرِ وَارِثٍ ، وَلاَ یُجِیزُہُ لِوَارِثٍ إلاَّ بِبَیِّنَۃٍ۔","","Musannaf Ibn Abi Shaybah 21142","","","كتاب البيوع والأقضية"
"21143","(۲۱۱۴۳) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ الْمَوْصِلِیُّ ، عَنْ جَعْفَرٍ ، عَنْ مَیْمُونٍ ، قَالَ : إذَا أَقَرَّ الرَّجُلُ بِدَیْنٍ فِی مَرَضِہِ فَأَرَی أَنْ یَجُوزَ عَلَیْہِ لأَِنَّہُ لَوْ أَقَرَّ بِہِ وَہُوَ صَحِیحٌ جَازَ وَأَصْدَقُ مَا یَکُونُ عِنْدَ مَوْتِہِ۔","","Musannaf Ibn Abi Shaybah 21143","","","كتاب البيوع والأقضية"
"21144","(۲۱۱۴۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ طَاوُوسٍ ، قَالَ : إذَا بِعْتَ طَعَامًا إلَی أَجَلٍ فَحَلَّ الأَجَلُ فَلاَ تَأْخُذْ طَعَامًا ، قَالَ : وَقَالَ جَابِرُ بْنُ زَیْدٍ أَبُو الشَّعْثَائِ : إذَا حَلَّ دِیْنَارکَ فَخُذْ بِہِ مَا شِئْتَ۔","","Musannaf Ibn Abi Shaybah 21144","","","كتاب البيوع والأقضية"
"21145","(۲۱۱۴۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ بْنِ أَبِی مَرْیَمَ ، قَالَ : قُلْتُ لِسَعِیدِ بْنِ الْمُسَیَّبِ: بِعْتُ مِنْ رَجُلٍ تَمْرًا آخُذُ مِنْ ثَمَنِ تَمْرِی تَمْرًا ؟ قَالَ : لاَ تَأْخُذَنَّ طَعَامًا مَا یُکَالُ وَیُوزَنُ۔","","Musannaf Ibn Abi Shaybah 21145","","","كتاب البيوع والأقضية"
"21146","(۲۱۱۴۶) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَشْعَثَ ، عَنْ عَامِرٍ ، قَالَ : إذَا بِعْت طَعَامًا إلَی أَجَلٍ فَحَلَّ مَالُکَ فَخُذْ بِہِ مِنَ الْعُرُوضِ مَا شِئْتَ ، لاَ تَأْخُذْ طَعَامًا إلا طعامک بِعَیْنِہِ۔","","Musannaf Ibn Abi Shaybah 21146","","","كتاب البيوع والأقضية"
"21147","(۲۱۱۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃَ فِی رَجُلٍ بَاعَ مِنْ رَجُلٍ غَنَمًا إلَی أَجَلٍ ، فَلَمَّا حَلَّ الأَجَلُ أَرَادَ أَنْ یَأْخُذَ غَنَمًا وَیُقَاصَّہُ فَکَرِہَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21147","","","كتاب البيوع والأقضية"
"21148","(۲۱۱۴۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ وَحَمَّادٍ أَنَّہُمَا کَانَا یَکْرَہَانِ أَنْ یَبِیعَ الرَّجُلُ طَعَامًا الْکُرُّ بِأَرْبَعِینَ نَسأً ، ثُمَّ یَشْتَرِیَ مِنْہُ طَعَامًا ، مِثْلَہُ بِدُونِ الأَرْبَعِینَ۔","","Musannaf Ibn Abi Shaybah 21148","","","كتاب البيوع والأقضية"
"21149","(۲۱۱۴۹) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ طَاوُوسٍ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : إذَا بِعْتَ بَیْعًا مِمَّا یُکَالُ وَیُوزَنُ إلَی أَجَلٍ فَحَلَّ أَجَلُکَ فَلاَ تَأْخُذْہما وُخذْ مَا خَالَفَاہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 21149","","","كتاب البيوع والأقضية"
"21150","(۲۱۱۵۰) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ أَبِی الزِّنَادِ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ وَسُلَیْمَانَ بْنِ یَسَارٍ، قَالاَ : مَنْ بَاعَ طَعَامًا بِذَہَبٍ إلَی أَجَلٍ فَحَلَّ الأَجَلُ ، فَلاَ یَأْخُذْ بِہِ تَمْرًا۔","","Musannaf Ibn Abi Shaybah 21150","","","كتاب البيوع والأقضية"
"21151","(۲۱۱۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ تَأْخُذْ کَیْلاً۔","No Data Available","Musannaf Ibn Abi Shaybah 21151","","","كتاب البيوع والأقضية"
"21152","(۲۱۱۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ نَافِعٍ ، قَالَ : سَأَلْتُ طَاوُوسًا ، عَنْ رَجُلٍ بَاعَ رَجُلاً بُرًّا إلَی أَجَلٍ ، فَلَمَّا حَلَّ الأَجَلُ أَیَأْخُذُ بُرًّا مَکَانَ دَرَاہِمِہِ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 21152","","","كتاب البيوع والأقضية"
"21153","(۲۱۱۵۳) حَدَّثَنَا وَکِیعٌ ، عن سفیان عن جابر عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ أَنْ یَأْخُذَ بُرًّا مَکَانَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 21153","","","كتاب البيوع والأقضية"
"21154","(۲۱۱۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ؛ فِی الرَّجُلِ یَبِیعُ الطَّعَامَ إلَی أَجَلٍ فَیَحِلُّ فَلاَ یَجِدُ عِنْدَہُ دَرَاہِمَ ، قَالَ : خُذْ مَا شِئْتَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21154","","","كتاب البيوع والأقضية"
"21155","(۲۱۱۵۵) حَدَّثَنَا وکیع ، عن سفیان ، عن حماد ، قَالَ : خذ ما شئت۔","","Musannaf Ibn Abi Shaybah 21155","","","كتاب البيوع والأقضية"
"21156","(۲۱۱۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : ذَلِکَ طَعَامٌ بِطَعَامٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 21156","","","كتاب البيوع والأقضية"
"21157","(۲۱۱۵۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : سُئِلَ مُحَمَّدٌ عَنِ الرَّجُلِ یَبِیعُ الْمَتَاعَ إلَی أَجَلٍ فَیَحِلُّ الأَجَلُ ، أَیَأْخُذُ مَتَاعًا ؟ فَقَالَ : قَدْ کَانَ الرَّجُلُ یَأْتِی غَرِیمَہُ فَیَأْخُذُ مِنْہُ ، فَقِیلَ لَہُ : أَیَبِیعُ طَعَامًا وَیَأْخُذُ طَعَامًا ؟ قَالَ : فَإِنِّی لاَ أَقُولُ فِیہِ شَیْئًا۔","No Data Available","Musannaf Ibn Abi Shaybah 21157","","","كتاب البيوع والأقضية"
"21158","(۲۱۱۵۸) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، عَنِ الأَوْزَاعِی ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، قَالَ : قضَی عُمَرُ بْنُ عَبْدِ الْعَزِیزِ فِی دَیْنِ الْمُتَوَفَّی مِنْ طَعَامٍ ، قَالَ : لاَ یَأْخُذُ الطَّعَامَ۔","","Musannaf Ibn Abi Shaybah 21158","","","كتاب البيوع والأقضية"
"21159","(۲۱۱۵۹) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ؛ فِی الرَّجُلِ یَشْتَرِی الدَّارَ فَیَبْنِیہَا ، ثُمَّ یَجِیئُ الشَّفِیعُ ، قَالَ: یَأْخُذُہا بِبُنْیَانِہَا ، أَوْ بقیمتہا ، وَقَالَ حَمَّادٌ : یَقْلَعُ بِنَائَہَا وَیَأْخُذُہَا۔","","Musannaf Ibn Abi Shaybah 21159","","","كتاب البيوع والأقضية"
"21160","(۲۱۱۶۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ الْحَذَّائِ ، أَنَّ رَجُلاً اشْتَرَی دَارًا فَبَنَاہَا ، ثُمَّ جَائَ رَجُلٌ فَاسْتَحَقَّہَا ، فَکَتَبَ أَنْ تُقَوَّمَ الْعَرْصَۃُ وَیُقَوَّمَ الْبِنَائُ ، فَإِنْ شَائَ أَخَذَ الْبِنَائَ بِقِیمَتِہِ ، وَإِنْ أَبَی سَلَّمَ الْعَرْصَۃَ بِقِیمَتِہَا۔","","Musannaf Ibn Abi Shaybah 21160","","","كتاب البيوع والأقضية"
"21161","(۲۱۱۶۱) قَالَ وَکِیعٌ : قَالَ سُفْیَانُ : یَقْلَعُ بِنَائَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21161","","","كتاب البيوع والأقضية"
"21162","(۲۱۱۶۲) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، عَنِ ابن عِکْرِمَۃَ ، عَنِ الْحَارِثِ الْعُکْلِیِّ فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً عَلَی دَارٍ ، فَطَلَبَ شَفِیعُ الدَّارِ الدَّارَ ، قَالَ : یَأْخُذُہَا بِصَدَاقِ مِثْلِ الْمَرْأَۃِ ، قَالَ : وَقَالَ ابْنُ شُبْرُمَۃَ : لَسْتُ أَرَی ذَلِکَ وَلَکِنْ یَأْخُذُہَا الشَّفِیعُ بِالْقِیمَۃِ۔","","Musannaf Ibn Abi Shaybah 21162","","","كتاب البيوع والأقضية"
"21163","(۲۱۱۶۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ یَعْقُوبَ بْنِ عَبْدِ اللہِ ، عَنِ الْحَسَنِ ، قَالَ : لَیْسَ فِی صَدَاقٍ شُفْعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 21163","","","كتاب البيوع والأقضية"
"21164","(۲۱۱۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، قَالَ : حدِّثْتُ عَنِ الشَّعْبِیِّ ، قَالَ : لَیْسَ فِی صَدَاقٍ شُفْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 21164","","","كتاب البيوع والأقضية"
"21165","(۲۱۱۶۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَنِ ابْنِ أَبِی لَیْلَی ؛ فِی الرَّجُلِ یَتَزَوَّجُ عَلَی الدَّارِ ، قَالَ : یَأْخُذُہَا الشَّفِیعُ بِقِیمَۃِ الدَّارِ۔","","Musannaf Ibn Abi Shaybah 21165","","","كتاب البيوع والأقضية"
"21166","(۲۱۱۶۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذا کَانَ عَلَیْکَ دَیْنٌ لِرَجُلٍ فَلَمْ تَدْرِ أَیْنَ ہُوَ وَأَیْنَ وَارِثُہُ ؟ فَتَصَدَّقْ بِہِ عَنْہُ ، فَإِنْ جَائَ فَخَیِّرْہُ۔","","Musannaf Ibn Abi Shaybah 21166","","","كتاب البيوع والأقضية"
"21167","(۲۱۱۶۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ اللہِ بْنِ حَنَشٍ ، عَنِ ابْنِ عُمَرَ فِی رَجُلٍ ہَلَکَ وَعَلَیْہِ دَیْنٌ لاَ یَعْرِفُ صَاحِبَ الدَّیْنِ ، فَأَمَرَ أَنْ یُتَصَدَّقَ عَنْہُ بِذَلِکَ الدَّیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 21167","","","كتاب البيوع والأقضية"
"21168","(۲۱۱۶۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا مَاتَ الرَّجُلُ وَعَلَیْہِ دَیْنٌ ، فَلَمْ یَدْرِ أین وَارِثُہُ فَلْیَجْعَلْہُ فِی سَبِیلِ اللہِ ، وَإِنْ کَانَ مُسْلِمًا فَلَمْ یَدْرِ أین وَارِثُہُ فَلْیَتَصَدَّقْ بِہِ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 21168","","","كتاب البيوع والأقضية"
"21169","(۲۱۱۶۹) حَدَّثَنَا شَرِیکٌ ، عَنْ عَامِرٍ بن شَقِیقٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : اشْتَرَی عَبْدُ اللہِ جَارِیَۃً بِسَبْعِ مِئَۃِ دِرْہَمٍ فَغَابَ صَاحِبُہَا فَعَرَّفَہَا سَنَۃً ، أَوْ قَالَ : حَوْلاً ، ثُمَّ خَرَجَ إلَی الْمَسْجِدِ ، وَجَعَلَ یَتَصَدَّقُ وَیَقُولُ : اللَّہُمَّ فَلَہُ ، فَإِنْ أتی فَإلیّ وَعَلَیِّ ، ثُمَّ قَالَ : ہَکَذَا فَاصْنَعُوا بِاللُّقَطَۃِ ، أَوْ بِالضَّالَّۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 21169","","","كتاب البيوع والأقضية"
"21170","(۲۱۱۷۰) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ زَیْدٍ ، قَالَ : اشْتَرَیْت جَارِیَۃً مِنْ خُمُسٍ قُسِمَ ، فَوَجَدْتُ مَعَہَا خَمْسَۃَ عَشَرَ دِینَارًا ، فَأَتَیْتُ بِہَا عَبْدَ الرَّحْمَن بْنِ خَالِدِ بْنِ الْوَلِیدِ فَقَالَ : ہِیَ لَکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21170","","","كتاب البيوع والأقضية"
"21171","(۲۱۱۷۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ فِی رَجُلٍ اشْتَرَی سَبِیَّۃً مِنَ الْمَغْنَمِ فَوَجَدَ مَعَہَا فِضَّۃً ، قَالَ : یَرُدُّہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 21171","","","كتاب البيوع والأقضية"
"21172","(۲۱۱۷۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، أَنَّ رَجُلاً اشْتَرَی أَمَۃً یَوْمَ الْقَادِسِیَّۃِ مِنَ الْفَیْئِ ، فَأَتَتْہُ بِحَلْیٍ کَانَ مَعَہَا ، فَأَتَی سَعْدَ بْنَ أَبِی وَقَّاصٍ فَأَخْبَرَہُ فَقَالَ : اجْعَلْہُ فِی غَنَائِمِ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 21172","","","كتاب البيوع والأقضية"
"21173","(۲۱۱۷۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیرِیِّ ، عَنْ أَبِی عَبْدِ اللہِ الْجَسْرِیِّ جَسْرِ عَنَزَۃَ ، قَالَ : قُلْتُ لِمَعْقِلِ بْنِ یَسَارٍ: الرَّجُلُ مِنَّا یُرِیدُ أَنْ یُعْتِقَ الْمُعْتَقَ ، قَالَ : إذَا اشْتَرَیْت مُعْتَقًا تُرِیدُ أَنْ تُعْتِقَہُ فَلاَ تَشْتَرِطْ لأَِہْلِہِ الْعِتْقَ ، فَإِنَّہَا عُقْدَۃٌ مِنَ الرِّقِّ ، وَلَکِنِ اشْتَرِہِ سَاکِتًا ، فإنْ شِئْتَ أَمْسَکْتَ ، وَإِنْ شِئْتَ أَعْتَقْتَ۔","Sahih","Musannaf Ibn Abi Shaybah 21173","","","كتاب البيوع والأقضية"
"21174","(۲۱۱۷۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، قَالَ : حدَّثْتُ بِہَذَا الْحَدِیثِ أَیُّوبَ فَقَالَ : إِنَّہَا لَیْسَتْ بِتَامَّۃٍ۔","","Musannaf Ibn Abi Shaybah 21174","","","كتاب البيوع والأقضية"
"21175","(۲۱۱۷۵) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، أَنَّہُ کَانَ یَقُولُ فِی رَجُلٍ کَانَتْ عَلَیْہِ رَقَبَۃٌ فَاشْتَرَاہَا وَاشْتُرِطَ عَلَیْہِ أَنْ یُعْتِقَہَا ، قَالَ : فَکَرِہَ ذَلِکَ ، وَقَالَ : لَیْسَتْ بِتَامَّۃٍ۔","","Musannaf Ibn Abi Shaybah 21175","","","كتاب البيوع والأقضية"
"21176","(۲۱۱۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، وَعَنِ ابْن أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالاَ : إذَا اشْتَرَاہَا وَاشْتَرَطَ عِتْقَہَا : کَانَا لاَ یَرَیَانِہَا سَلِیمَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 21176","","","كتاب البيوع والأقضية"
"21177","(۲۱۱۷۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ تَکُونُ عَلَیْہِ الرَّقَبَۃُ الْوَاجِبَۃُ فَیَشْتَرِیہَا : فَلاَ یَشْتَرِطُ أَنَّہُ یَشْتَرِیہَا لِلْعِتْقِ۔","","Musannaf Ibn Abi Shaybah 21177","","","كتاب البيوع والأقضية"
"21178","(۲۱۱۷۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہَارُونَ بْنِ مُوسَی ، قَالَ : أَخْبَرَنِی عَلِیُّ بْنُ زَائِدَۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ سُئِلَ عَنِ الرَّجُلِ یَشْتَرِی الْجَارِیَۃَ فَیَشْتَرِطُ مَوْلاَہَا عِتْقَہَا ، قَالَ : الأَجْرُ لِمَوْلاَہَا الَّذِی اشْتَرَطَ۔","Da'if","Musannaf Ibn Abi Shaybah 21178","","","كتاب البيوع والأقضية"
"21179","(۲۱۱۷۹) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی الْقَوْمِ یَشْتَرِکُونَ فِی الْعِدْلِ ، قَالَ : لاَ بَأْسَ أَنْ یَبِیعَ بَعْضُہُمْ مِنْ بَعْضٍ قَبْلَ أَنْ یَقْتَسِمُوا۔","","Musannaf Ibn Abi Shaybah 21179","","","كتاب البيوع والأقضية"
"21180","(۲۱۱۸۰) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : سَأَلْتُُہُ عَنْ مَتَاعٍ بَیْنَ رَجُلَیْنِ یَبِیعُ أَحَدُہُمَا نَصِیبَہُ مِنْ قَبْلِ أَنْ یُقَاسِمَہُ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 21180","","","كتاب البيوع والأقضية"
"21181","(۲۱۱۸۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یَتَخَارَجُ الشَّرِیکَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 21181","","","كتاب البيوع والأقضية"
"21182","(۲۱۱۸۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَبِیعَ الرَّجُلُ الْمَتَاعَ قَبْلَ أَنْ یَقْسِمَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21182","","","كتاب البيوع والأقضية"
"21183","(۲۱۱۸۳) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَکْرَہُ بَیْع مَا یَقْدِرُ عَلَی قِسْمَتِہِ حَتَّی یَقْسِمَ ، فَإِذَا کَانَ شَیْئٌ لاَ یَقْدِرُ عَلَی قِسْمَتِہِ فَلاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 21183","","","كتاب البيوع والأقضية"
"21184","(۲۱۱۸۴) حَدَّثَنَا عَبْدُ الْوَہَّابِ الْخَفَّافُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَبِیعَ الشَّرِیکُ مِنْ شَرِیکِہِ مَا لَمْ یُقَاسِمْہُ خَلاَ الْکَیْلِ وَالْوَزْنِ۔","","Musannaf Ibn Abi Shaybah 21184","","","كتاب البيوع والأقضية"
"21185","(۲۱۱۸۵) حَدَّثَنَا حَفْصٌ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، أَنَّ ابْنَ مَسْعُودٍ اشْتَرَی أَرْضَ خَرَاجٍ۔","Da'if","Musannaf Ibn Abi Shaybah 21185","","","كتاب البيوع والأقضية"
"21186","(۲۱۱۸۶) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الْقَاسِمِ ، عَنِ ابْنِ مَسْعُودٍ بِمِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 21186","","","كتاب البيوع والأقضية"
"21187","(۲۱۱۸۷) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنِ ابْنِ مَعْقِلٍ ، قَالَ : لاَ تَشْتَرِ مِنْ أَرْضِ السَّوَادِ شَیْئًا إلاَّ مِنْ أَہْلِ بَانِقْیَاء وَأَہْلِ الْحِیرَۃِ وَأَہْلِ أُلَّیْسٍ۔","","Musannaf Ibn Abi Shaybah 21187","","","كتاب البيوع والأقضية"
"21188","(۲۱۱۸۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ أَنَّہُمَا کَرِہَا أَنْ یُشْتَرَی مِنَ السُّلْطَانِ مِنْ أَرْضِ الْجِزْیَۃِ۔","","Musannaf Ibn Abi Shaybah 21188","","","كتاب البيوع والأقضية"
"21189","(۲۱۱۸۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَال : کَتَبَ عُمَرُ : لَیْسَ لَکُمْ أَنْ تَشْتَرُوا مِنْ عَقَارِ أَہْلِ الذِّمَّۃِ ، وَلاَ مِنْ بِلاَدِہِمْ شَیْئًا۔","Hasan","Musannaf Ibn Abi Shaybah 21189","","","كتاب البيوع والأقضية"
"21190","(۲۱۱۹۰) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ رَجَائِ بْنِ أَبِی سَلَمَۃَ ، قَالَ : أَخْبَرَنِی نُعَیْمُ بْنُ سَلاَمَۃَ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ دَفَعَ إلَی رَجُلٍ أَرْضًا یُؤَدِّی عَنْہَا الْجِزْیَۃَ۔","","Musannaf Ibn Abi Shaybah 21190","","","كتاب البيوع والأقضية"
"21191","(۲۱۱۹۱) حَدَّثَنَا زَیْدُ بْنُ حباب ، قَالَ : أَخْبَرَنِی رَجَاء ، قَالَ : حَدَّثَنَا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَتْ لَہُمْ أَرْضٌ یُؤَدُّونَ عَنْہَا الْخَرَاجَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21191","","","كتاب البيوع والأقضية"
"21192","(۲۱۱۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبَانَ بْنِ صَمْعَۃَ ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ الْمُزَنِیّ ، قَالَ : سَأَلْتُ ، عَنْ شِرَائِ أَرْضِ الْخَرَاجِ بِمَائِہَا ، فَقَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تَجْعَلُوا فِی أَعْنَاقِکُمْ صَغَارًا بَعْدَ إذ أَنْقَذَکُمَ اللَّہُ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 21192","","","كتاب البيوع والأقضية"
"21193","(۲۱۱۹۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ رَجُلاً سَأَلَہ عَنْ شِرَائِ أَرْضِ الْخَرَاجِ ، أَوْ شَیْئٍ ہَذَا مَعْنَاہُ ، فَقَالَ : تُخْرِجُ الصَّغَارَ مِنْ عُنُقِہِ فَتَجْعَلُہُ فِی عُنُقِکَ۔","Hasan","Musannaf Ibn Abi Shaybah 21193","","","كتاب البيوع والأقضية"
"21194","(۲۱۱۹۴) حَدَّثَنَا وَکِیعٌ، عَنْ سَلاَّمِ بْنِ مِسْکِینٍ، قَالَ: حدَّثَنِی شَیْخٌ أَنَّہُ سَمِعَ ابْنَ الزُّبَیْرِ یَکْرَہُ شِرَائَ أَرْضِ الْجِزْیَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 21194","","","كتاب البيوع والأقضية"
"21195","(۲۱۱۹۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ وَمُحَمَّدُ بْنُ بِشْرٍ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، قَالَ مُحَمَّدُ بْنُ بِشْرٍ : عَنْ أَبِی عِیَاضٍ ، عَنْ سُفْیَانَ الْعُقَیْلِیِّ ، أَنَّ عُمَرَ ، قَالَ : لاَ تَشْتَرُوا مِنْ رَقِیقِ أَہْلِ الذِّمَّۃِ شَیْئًا فَإِنَّہُمْ أَہْلُ خَرَاجٍ ، یَبِیعُ بَعْضُہُمْ بَعْضًا ، وَلاَ مِنْ أَرْضِہِمْ۔ (عبدالرزاق ۱۹۲۹۰)","Da'if","Musannaf Ibn Abi Shaybah 21195","","","كتاب البيوع والأقضية"
"21196","(۲۱۱۹۶) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عَلِیٍّ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یُشْتَرَی مِنْ أَرْض الخراج شَیْء وَیَقُولُ : عَلَیْہَا خَرَاجُ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 21196","","","كتاب البيوع والأقضية"
"21197","(۲۱۱۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَرِہَ شِرَائَ أَرْضِ السَّوَادِ۔","Hasan","Musannaf Ibn Abi Shaybah 21197","","","كتاب البيوع والأقضية"
"21198","(۲۱۱۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ فُضَیْلِ بْنِ غَزْوَانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَازِمٍ ، عَنْ مُجَاہِدٍ ، قَالَ : سَأَلْتُُہُ عَنْ شِرَائِ أَرْضِ الْخَرَاجِ فَقَالَ : لاَ تَبِعْہَا ، وَلاَ تَشْتَرِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 21198","","","كتاب البيوع والأقضية"
"21199","(۲۱۱۹۹) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، أَنَّہُ کَانَ یَکْرَہُ شِرَائَ أَرْضِ الْجِزْیَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21199","","","كتاب البيوع والأقضية"
"21200","(۲۱۲۰۰) حَدَّثَنَا أبو بکر بْنُ عَیَّاشٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ شُرَیْحٌ یَسْتَحْلِفُ عَلَی الدَّائِ الَّذِی لاَ یُرَی عَلَی عِلْمِہِ ، وَعَلَی الظَّاہِرِ البتۃ۔","","Musannaf Ibn Abi Shaybah 21200","","","كتاب البيوع والأقضية"
"21201","(۲۱۲۰۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَالِمٍ ، أَنَّ ابْنَ عُمَرَ بَاعَ غُلاَمًا بِثَمَانِ مِئَۃِ دِرْہَمٍ ، فَوَجَدَ بِہِ الْمُشْتَرِی عَیْبًا ، فَخَاصَمَہُ إلَی عُثْمَانَ ، قَالَ : فَسَأَلَہُ عُثْمَانُ فَقَالَ : بِعْتُہُ بِالْبَرَائَۃِ ، فَقَالَ : أَتَحْلِفُ لَہُ: لَقَدْ بِعْتُہُ وَمَا بِہِ عَیْبٌ تَعْلَمُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 21201","","","كتاب البيوع والأقضية"
"21202","(۲۱۲۰۲) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَشْتَرِی الْمَتَاعَ ، أَوِ السِّلْعَۃَ فَیَجِدُ بِہِ الْعَیْبُ ، قَالَ : یَلْتَمِسُ الْمُبْتَاعُ الْبَیِّنَۃَ ، أَنَّہُ کَانَ عِنْدَ الْبَائِعِ ، فَإِنْ وَجَدَ وَإِلاَّ اسْتُحْلِفَ الْبَائِعُ عَلَی عِلْمِہِ ، وَقَالَ عَمْرُو بْنُ دِینَارٍ : یَحْلِفُ عَلَی عِلْمِہِ۔","","Musannaf Ibn Abi Shaybah 21202","","","كتاب البيوع والأقضية"
"21203","(۲۱۲۰۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، عَنْ عَامِرٍ فِی رَجُلٍ اشْتَرَی جَارِیَۃً وَبِہَا بَرَصٌ وَلَیْسَ لَہ شُہُودٌ ، قَالَ: یَحْلِفُ الْبَائِعُ بِاللَّہِ : مَا بَاعَہَا وَبِہَا بَرَصٌ۔","","Musannaf Ibn Abi Shaybah 21203","","","كتاب البيوع والأقضية"
"21204","(۲۱۲۰۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُمَرُ بْنُ ذَرٍّ ، قَالَ : کَانَ الْقَاسِمُ بْنُ عَبْدِ الرَّحْمَنِ یَسْتَحْلِفُ الرَّجُلَ مَا یَدْفَعُہُ عَنْ حَقٍّ یَعْلَمُہُ لَہُ ، وَقَالَ الشَّعْبِیُّ فِی الْیَمِینِ الْمُرْسَلَۃِ : إنَّمَا إِثْمُہُ وَبِرُّہُ عَلَی مَا تَعَمَّدَ۔","","Musannaf Ibn Abi Shaybah 21204","","","كتاب البيوع والأقضية"
"21205","(۲۱۲۰۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنِ الْحَسَنِ بْنِ عطَائٍ الْمَدِینِیِّ ، عَنْ أَبِیہِ ، أَنَّ رَجُلاً بَاعَ رَجُلاً سِلْعَۃً ، فَادَّعَی الْمُشْتَرِی عَیْبًا ، فَخَاصَمَہُ إلَی عُثْمَانَ بْنِ عَفَّانَ ، فَقَالَ الْمُشْتَرِی : احْلِفْ بِاللَّہِ : مَا بِعْتنِی عیبًا، فَقَالَ: الْبَائِعُ: أَحْلِفُ بِاللَّہِ: لَقَدْ بِعْتُکَ وَمَا أَعْلَمُ بِہَا عَیْبًا ، قَالَ : فَقَالَ : عُثْمَانُ : أَنْصَفَک الرَّجُلُ۔","Da'if","Musannaf Ibn Abi Shaybah 21205","","","كتاب البيوع والأقضية"
"21206","(۲۱۲۰۶) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : أَخْبَرَنِی الزُّبَیْرُ بْنُ جُنَادَۃَ ، قَالَ : سَأَلْتُ سَالِمًا عَنْ أَرْضٍ بَیْضَائَ اشْتَرَیْتُہَا مِمَّنْ یَمْلِکُ رَقَبَتِہَا لأَبْنِیَ فِیہَا ، قَالَ : لاَ بَأْسَ ، قَالَ : فَقُلْت : یُؤَدَّی عَنْہَا الْخَرَاجَ ، قَالَ : لاَ بَأْسَ ، قُلْتُ : أُقِرُّ بِالصَّغَارِ ، قَالَ : إنَّمَا ذَلِکَ فِی رُؤُوسِ الرِّجَالِ۔","","Musannaf Ibn Abi Shaybah 21206","","","كتاب البيوع والأقضية"
"21207","(۲۱۲۰۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَش ، عَنْ خَیْثَمَۃَ ، عَنِ الأَسْوَدِ ، قَالَ : قَالَ لِی عَبْدُ اللہِ : إیَّاکُمْ وَبَیْعَ الْمُحَفَّلاَتِ فَإِنَّہَا خِلاَبَۃٌ ، وَلاَ تَحِلُّ الْخِلاَبَۃُ لِمُسْلِمٍ۔","Sahih","Musannaf Ibn Abi Shaybah 21207","","","كتاب البيوع والأقضية"
"21208","(۲۱۲۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ، قَالَ : کَانَ یُقَالُ : التَّصْرِیَۃُ خِلاَبَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 21208","","","كتاب البيوع والأقضية"
"21209","(۲۱۲۰۹) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ سِمَاکِ بْنِ حَرْبٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَسْتَقْبِلُوا ، وَلاَ تُحَفِّلُوا۔ (ترمذی ۱۲۶۸۔ احمد ۱/۲۵۶)","","Musannaf Ibn Abi Shaybah 21209","","","كتاب البيوع والأقضية"
"21210","(۲۱۲۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی کَثِیرٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا بَاعَ أَحَدُکُمُ اللِّقْحَۃَ ، أَوِ الشَّاۃَ فَلاَ یُحَفِّلْہَا۔n(احمد ۲/۴۸۱۔ ابن ماجہ ۲۲۴۱)","Sahih","Musannaf Ibn Abi Shaybah 21210","","","كتاب البيوع والأقضية"
"21211","(۲۱۲۱۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنْ جَابِرٍ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : حدَّثَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ الصَّادِقُ الْمَصْدُوقُ ، قَالَ : بَیْعُ الْمُحَفَّلاَتِ خِلاَبَۃٌ ، وَلاَ تَحِلُّ الْخِلاَبَۃُ لِمُسْلِمٍ۔","Da'if","Musannaf Ibn Abi Shaybah 21211","","","كتاب البيوع والأقضية"
"21212","(۲۱۲۱۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ یَجُوزُ عِتْقُ الصَّبِیِّ ، وَلاَ بَیْعُہُ ، وَلاَ شِرَاؤُہُ۔","","Musannaf Ibn Abi Shaybah 21212","","","كتاب البيوع والأقضية"
"21213","(۲۱۲۱۳) حَدَّثَنَا ابْنُ الْمُبَارَکِ ، عَنْ یُونُسَ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ یَجُوزُ شِرَاء الْغُلاَمِ ، وَلاَ بَیْعُہُ إلاَّ بِإِذْنِ وَلِیِّہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21213","","","كتاب البيوع والأقضية"
"21214","(۲۱۲۱۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُطَرِّفٍ ، قَالَ : قُلْتُ لِلشَّعْبِیِّ : یَجُوزُ بَیْعُہُ وَشِرَاؤُہُ ؟ قَالَ : إذَا جَازَ بَیْعُہُ وَشِرَاؤُہُ جَازَتْ عَتَاقَتُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21214","","","كتاب البيوع والأقضية"
"21215","(۲۱۲۱۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یَجُوزُ بَیْعُ الصَّبِیِّ ، وَلاَ شِرَاؤُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21215","","","كتاب البيوع والأقضية"
"21216","(۲۱۲۱۶) حَدَّثَنَا حَفْصٌ، عَنْ مُحَمَّدِ بْنِ زَیْدٍ، عَنْ طَلْحَۃَ بْنِ عَبْدِاللہِ بْنِ عَوْفٍ، قَالَ: أَمَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُنَادِیًا فَنَادَی حَتَّی بَلَغَ الثَّنِیَّۃَ : لاَ تَجُوزُ شَہَادَۃُ خَصْمٍ ، وَلاَ ظَنِینٍ ، وَإِنَّ الْیَمِینَ عَلَی الْمُدَّعَی عَلَیْہِ۔ (ابوداؤد ۳۹۶۔ عبدالرزاق ۱۵۳۶۵)","","Musannaf Ibn Abi Shaybah 21216","","","كتاب البيوع والأقضية"
"21217","(۲۱۲۱۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ مَعْمَرٍ الْبَصْرِیِّ ، عَنْ أَبِی الْعَوَّامِ ، قَالَ : کَتَبَ عُمَرُ إلَی أَبِی مُوسَی ، أَنَّ الْیَمِینَ عَلَی مَنْ أَنْکَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 21217","","","كتاب البيوع والأقضية"
"21218","(۲۱۲۱۸) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ زَمْعَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : مَضَتِ السُّنَّۃُ ، أَنَّ الْیَمِینَ عَلَی الْمُدَّعَی عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 21218","","","كتاب البيوع والأقضية"
"21219","(۲۱۲۱۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَش ، عَنْ حَسَّانَ أَبِی الأَشْرَسِ ، عَنْ شُرَیْحٍ أَنَّہُ أَتَاہُ رَجُلٌ فَقَالَ : إنَّ ہَذَا بَاعَنِی جَارِیَۃً مُلْتَوِیَۃَ الْعُنُقِ ، فَقَالَ شُرَیْحٌ : بَیِّنَتُکَ أَنَّہُ بَاعَکَ دائً ، وَإِلاَّ فَیَمِینُہُ بِاللَّہِ : مَا بَاعَکَ دائً۔","","Musannaf Ibn Abi Shaybah 21219","","","كتاب البيوع والأقضية"
"21220","(۲۱۲۲۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، وابن شُبْرُمَۃَ ، عَنِ الشَّعْبِیِّ ، أَنَّہُ قَالَ لِرَجُلٍ : احْلِفْ أَنَّک لَمْ تَبِعْہُ دائً۔","","Musannaf Ibn Abi Shaybah 21220","","","كتاب البيوع والأقضية"
"21221","(۲۱۲۲۱) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ نَافِعِ بْنِ عُمَرَ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی بِالْیَمِینِ عَلَی الْمُدَّعَی عَلَیْہِ۔ (بخاری ۲۵۱۴۔ مسلم ۱۳۳۶)","Sahih","Musannaf Ibn Abi Shaybah 21221","","","كتاب البيوع والأقضية"
"21222","(۲۱۲۲۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ حَجَّاجِ بْنِ أَبِی عُثْمَانَ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُ قَضَی بِالْیَمِینِ عَلَی الْمَطْلُوبِ۔ (بیہقی ۱۰۔ دارقطنی ۲۱۹)","Sahih","Musannaf Ibn Abi Shaybah 21222","","","كتاب البيوع والأقضية"
"21223","(۲۱۲۲۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَش ، عَنْ شَقِیقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : مَنْ حَلَفَ عَلَی یَمِینٍ وَہُوَ فِیہَا فَاجِرٌ لِیَقْطَعَ بِہَا مَالَ رَجُلٍ مُسْلِمٍ ، لَقِیَ اللَّہَ وَہُوَ عَلَیْہِ غَضْبَانُ ، قَالَ الأَشْعَثُ : فِیَّ وَاللَّہِ نَزَلَتْ : کَانَ بَیْنِی وَبَیْنَ رَجُلٍ مِنَ الْیَہُودِ أَرْضٌ فَجَحَدَنِی ، فَقَدَّمْتُہُ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَلَکَ بَیِّنَۃٌ ؟ فَقُلْتُ : لاَ ، فَقَالَ لِلْیَہُودِیِّ : احْلِفْ ، فَقُلْتُ : إذًا یَحْلِفُ فَیَذْہَبُ بِمَالِی ، فَأَنْزَلَ اللَّہُ : {إنَّ الَّذِینَ یَشْتَرُونَ بِعَہْدِ اللہِ وَأَیْمَانِہِمْ ثَمَنًا قَلِیلاً}۔ (بخاری ۲۴۱۶۔ مسلم ۲۲۱)","Sahih","Musannaf Ibn Abi Shaybah 21223","","","كتاب البيوع والأقضية"
"21224","(۲۱۲۲۴) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ الْحَذَّائِ ، قَالَ : سَأَلْتُ أَبَا قِلاَبَۃَ عَنِ الْمُعَلِّمِ یُعَلِّمُ وَیَأْخُذُ أَجْرًا ، فَلَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 21224","","","كتاب البيوع والأقضية"
"21225","(۲۱۲۲۵) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُعَلِّمَ الْمُعَلِّمُ ، وَلاَ یُشَارِطَ ، فَإِنْ أُعْطِیَ شَیْئًا أَخَذَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21225","","","كتاب البيوع والأقضية"
"21226","(۲۱۲۲۶) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ الفَزَارِیُّ ، عَنْ عُثْمَانَ بْنِ الْحَارِثِ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ یَشْتَرِطُ الْمُعَلِّمُ ، وَإِنْ أُعْطِیَ شَیْئًا فَلْیَقْبَلْہُ۔","","Musannaf Ibn Abi Shaybah 21226","","","كتاب البيوع والأقضية"
"21227","(۲۱۲۲۷) حَدَّثَنَا أَبُو سَعْدٍ مُحَمَّدُ بْنُ مُیَسَّرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَأْخُذَ الْمُعَلِّمُ مَا أُعْطِیَ مِنْ غَیْرِ شَرْطِہِ۔","","Musannaf Ibn Abi Shaybah 21227","","","كتاب البيوع والأقضية"
"21228","(۲۱۲۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ صَدَقَۃَ الدِّمَشْقِیِّ ، عَنِ الْوَضِینِ بْنِ عَطَائٍ ، قَالَ : کَانَ بِالْمَدِینَۃِ ثَلاَثَۃُ مُعَلِّمِینَ یُعَلِّمُونَ الصِّبْیَانَ ، فَکَانَ عُمَرُ بْنُ الْخَطَّابِ یَرْزُقُ کُلَّ وَاحِدٍ مِنْہُمْ خَمْسَۃَ عَشَرَ کُلَّ شَہْرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 21228","","","كتاب البيوع والأقضية"
"21229","(۲۱۲۲۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یَکْرَہُ أَنْ یُشَارِطَ الْمُعَلِّمُ عَلَی تَعْلِیمِ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 21229","","","كتاب البيوع والأقضية"
"21230","(۲۱۲۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مَعْمَرِ بْنِ مُوسَی ، عَنْ أَبِی جَعْفَرٍ ، أَنَّہُ کَرِہَ للْمُعَلِّمِ أَنْ یُشَارِطَ۔","","Musannaf Ibn Abi Shaybah 21230","","","كتاب البيوع والأقضية"
"21231","(۲۱۲۳۱) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ أَنْ یَأْخُذَ عَلَی الْکِتَابَۃِ أَجْرًا ، وَکَرِہَ الشَّرْطَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21231","","","كتاب البيوع والأقضية"
"21232","(۲۱۲۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ نَافِعٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ : أَنَّہُ کَرِہَ أَنْ یُعَلِّمَ بِشَرْطٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 21232","","","كتاب البيوع والأقضية"
"21233","(۲۱۲۳۳) حَدَّثَنَا یزید بن ہارون، قَالَ: أَخْبَرَنَا شعبۃ، عن الحکم، قَالَ: ماعلمت أن أحدا کرہہ۔ یعنی: أجر المعلم۔","","Musannaf Ibn Abi Shaybah 21233","","","كتاب البيوع والأقضية"
"21234","(۲۱۲۳۴) حَدَّثَنَا یَزِیدُ، قَالَ: أَخْبَرَنَا شُعْبَۃُ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ، قَالَ: إنِّی لاَرْجُو أَنْ یَأْجُرہُ اللَّہُ، یُؤَدِّبُہُمْ وَیُعَلِّمُہُمْ۔","","Musannaf Ibn Abi Shaybah 21234","","","كتاب البيوع والأقضية"
"21235","(۲۱۲۳۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَیُّوبَ ، عَنْ عَائِذٍ الطَّائِیِّ ، عَنْ عَامِرٍ ، قَالَ : الْمُعَلِّمُ لاَ یُشَارِطُ ، فَإِنْ أُہْدِیَ لَہُ شَیْئًا فَلْیَقْبَلْہُ۔","","Musannaf Ibn Abi Shaybah 21235","","","كتاب البيوع والأقضية"
"21236","(۲۱۲۳۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مَہْدِیُّ بْنُ مَیْمُونٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ بِالْمَدِینَۃِ مُعَلِّمٌ عِنْدَہُ مِنْ أَبْنَائِ أُولئک الضخَامِ ، قَالَ : فَکَانُوا یَعْرِفُونَ حَقَّہُ فِی النَّیْرُوزِ وَالْمِہْرَجَانِ۔","","Musannaf Ibn Abi Shaybah 21236","","","كتاب البيوع والأقضية"
"21237","(۲۱۲۳۷) حَدَّثَنَا وَکِیعٌ وَحُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ مُغِیرَۃَ بْنِ زِیَادٍ ، عَنْ عُبَادَۃَ بْنِ نُسَیٍّ ، عَنِ الأَسْوَدِ بْنِ ثَعْلَبَۃَ، عَنْ عُبَادَۃَ بْنِ الصَّامِتِ ، قَالَ : عَلَّمْتُ نَاسًا مِنْ أَہْلِ الصُّفَّۃِ الْکِتَابَۃَ وَالْقُرْآنَ ، فَأَہْدَی إلَیَّ رَجُلٌ مِنْہُمْ قَوْسًا فَقُلْتُ : لَیْسَت بِمَالٍ ، وَأَرْمِی عَنْہَا فِی سَبِیلِ اللہِ ، لآتِیَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَلأَسْأَلَنَّہُ، فَأَتَیْتُہُ فَقُلْتُ : یَا رَسُولَ اللہِ ، رَجُلٌ أَہْدَی إلیَّ قَوْسًا مِمَّنْ کُنْتُ أُعَلِّمُہُ الْکِتَابَۃَ وَالْقُرْآنَ ، وَلَیْسَتْ بِمَالٍ ، وَأَرْمِی عَنْہَا فِی سَبِیلِ اللہِ ، فَقَالَ : إِنْ کُنْتَ تُحِبُّ أَنْ تُطَوَّقَ بِہَا طَوْقًا مِنْ نَارٍ فَاقْبَلْہَا۔n(ابوداؤد ۳۴۰۹۔ احمد ۵/۳۱۵)","Da'if","Musannaf Ibn Abi Shaybah 21237","","","كتاب البيوع والأقضية"
"21238","(۲۱۲۳۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیرِیِّ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ ، قَالَ : یُکْرَہُ أَرْشُ الْمُعَلِّمِ ، فَإِنَّ أَصْحَابَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانُوا یَکْرَہُونَہُ وَیَرَوْنَہُ شَدِیدًا","Sahih","Musannaf Ibn Abi Shaybah 21238","","","كتاب البيوع والأقضية"
"21239","(۲۱۲۳۹) حَدَّثَنَا مُحَمَّدُ بْنُ مُیَسَّرٍ أَبُو سَعْدٍ ، عَنْ مُوسَی بْنِ عُلَیٍّ ، عَنْ أَبِیہِ : أَنَّ أُبَیَّ بْنَ کَعْبٍ کَانَ یُعَلِّمُ رَجُلاً مَکْفُوفًا ، فَکَانَ إذَا أَتَاہُ غَدَّاہُ ، قَالَ : فَوَجَدْتُ فِی نَفْسِی مِنْ ذَلِکَ فَسَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : إِنْ شَیْئاً یُتْحِفُکَ بِہِ فَلاَ خَیْرَ فِیہِ ، وَإِنْ کَانَ مِنْ طَعَامِہِ وَطَعَامِ أَہْلِہِ فَلاَ بَأْسَ بِہِ۔n(ابن ماجہ ۲۱۵۸۔ بیہقی ۱۲۶)","Da'if","Musannaf Ibn Abi Shaybah 21239","","","كتاب البيوع والأقضية"
"21240","(۲۱۲۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَأْخُذُوا عَلَی الْغِلْمَانِ فِی الْکُتَّابِ أَجْرًا۔","No Data Available","Musannaf Ibn Abi Shaybah 21240","","","كتاب البيوع والأقضية"
"21241","(۲۱۲۴۱) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا أَسْلَمْت فِی طَعَامٍ فَلاَ تَأْخُذَنَّ مَکَانَہُ طَعَامًا غَیْرَہُ ، وَإِنْ أردْتَ أَنْ تَأْخُذَ مَکَانَہُ عَلَفًا فَخُذْ إِنْ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 21241","","","كتاب البيوع والأقضية"
"21242","(۲۱۲۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ طَاوُوسٍ ، أَنَّ رَجُلاً أَسْلَمَ فِی شَیْئٍ فَلَمْ یَجِدْہُ فَسَأَلَ ابْنَ عَبَّاسٍ فَقَالَ : خُذْ عَرَضًا ، خُذْ غَنَمًا۔","Sahih","Musannaf Ibn Abi Shaybah 21242","","","كتاب البيوع والأقضية"
"21243","(۲۱۲۴۳) حَدَّثَنَا جَرِیرٌ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ، قَالَ: إذَا أَسْلَمْتَ سَلَمًا فَلاَ بَأْسَ أَنْ تَأْخُذَ بِرَأْسِ مَالِکَ عَرَضًا۔","","Musannaf Ibn Abi Shaybah 21243","","","كتاب البيوع والأقضية"
"21244","(۲۱۲۴۴) حدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عُمَرُ : إذَا أَسْلَمْتَ فِی شَیْئٍ فَلاَ تَبِعْہُ حَتَّی تَقْبِضَہُ ، وَلاَ تَصْرِفْہُ فِی غَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 21244","","","كتاب البيوع والأقضية"
"21245","(۲۱۲۴۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطِیَّۃَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ بَأْسَ بِالسَّلَمِ ، وَلاَ تَصْرِفْہُ إلَی غَیْرِہِ، وَلاَ تَبِعْہُ حَتَّی تَقْبِضَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 21245","","","كتاب البيوع والأقضية"
"21246","(۲۱۲۴۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا أَسْلَمْت فِی شَیْئٍ فَلاَ تَأْخُذْ إلاَّ مَا أَسْلَمْتَ فِیہِ ، وَلاَ تُسْلِمَنَّ فِی شَیْئٍ ، ثُمَّ تُحَوِّلَہُ إلَی شَیْئٍ آخَرَ۔","","Musannaf Ibn Abi Shaybah 21246","","","كتاب البيوع والأقضية"
"21247","(۲۱۲۴۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ أَبِی عَوَانَۃَ ، عَنْ دَاوُدَ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی الْمُخَارِقِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أَسْلَمَ الْمُسْلِمُونَ ، فَمِنْ أَسْلَمَ فِی حِنْطَۃٍ فَلاَ یَأْخُذْ شَعِیرًا ، وَمَنْ أَسْلَمَ فِی شَعِیرٍ فَلاَ یَأْخُذْ حِنْطَۃٍ کَیْلٌ مَعْلُومٌ إلَی أَجَلٍ مَعْلُومٍ۔","Da'if","Musannaf Ibn Abi Shaybah 21247","","","كتاب البيوع والأقضية"
"21248","(۲۱۲۴۸) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ یُونُسَ، عَنِ الْحَسَنِ، قَالَ: لاَ تَصْرِفْ سَلَمَک فِی شَیْئٍ حَتَّی تَقْبِضَہُ۔","","Musannaf Ibn Abi Shaybah 21248","","","كتاب البيوع والأقضية"
"21249","(۲۱۲۴۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، وَیَحْیَی بْنُ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ ، عَنِ ابْنِ مَسْعُودٍ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا اخْتَلَفَ الْبَیِّعَانِ فَالْقَوْلُ مَا قَالَ الْبَائِعُ ، وَالْمُبْتَاعُ بِالْخِیَارِ۔n(ترمذی ۳۳۷۰۔ ابوداؤد ۳۵۰۵)","","Musannaf Ibn Abi Shaybah 21249","","","كتاب البيوع والأقضية"
"21250","(۲۱۲۵۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا اخْتَلَفَ الْبَیِّعَانِ وَلَیْسَ بَیْنَہُمَا بَیِّنَۃٌ ، وَالْمَبِیع قَائِمٌ بِعَیْنِہِ فَالْقَوْلُ قَوْلُ الْبَائِعِ ، أَوْ یَتَرَادَّانِ الْبَیْعَ ، وَإِنْ کَانَ الْمَبِیع قَدِ اسْتُہْلِکَ فَالْقَوْلُ قَوْلُ الْمُشْتَرِی ، وَالْبَیِّنَۃُ عَلَی الْبَائِعِ۔","","Musannaf Ibn Abi Shaybah 21250","","","كتاب البيوع والأقضية"
"21251","(۲۱۲۵۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ، أَنَّہُ کَانَ یَقُولُ فِی الْبَیِّعَیْنِ إذَا اخْتَلَفَا وَالْمَبِیع قَائِمٌ بِعَیْنِہِ یَسْأَلَہُمَا الْبَیِّنَۃَ ، فَإِنْ أَقَامَ أَحَدُہُمَا الْبَیِّنَۃَ أُعْطِیَ بِبَیِّنَتِہِ ، وَإِنْ لَمْ یَکُنْ لَہُمَا بَیِّنَۃٌ اسْتَحْلَفَہُمَا ، فَإِنْ جَائَا بِہَا جَمِیعًا رَدَّ الْبَیْعَ ، وَإِنْ لَمْ یَحْلِفَا رَدَّ الْبَیْعَ ، وَإِنْ حَلَفَ أَحَدُہُمَا وَنَکَلَ الآخَرُ أَعْطَی الَّذِی حَلَفَ ۔ وَإِنْ لَمْ یَکُنِ الْبَیْعُ قَائِمًا بِعَیْنِہِ ، أَوْ قَالَ : قدِ اسْتُہْلِکَ یُکَلَّفُ الْبَائِعُ الْبَیِّنَۃَ ، وَالْیَمِینُ عَلَی الْمُشْتَرِی۔","","Musannaf Ibn Abi Shaybah 21251","","","كتاب البيوع والأقضية"
"21252","(۲۱۲۵۲) حَدَّثَنَا عُمَرُ بْنُ ہَارُونَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ لَہُ : رَجُلاَنِ یَخْتَلِفَانِ فِی بَیْعٍ لَیْسَ بَیْنَہُمَا بَیِّنَۃٌ ، قَالَ : یُرَدُّ الْبَیْعُ إذَا لَمْ یَسْتَقِیمَا وإنْ لَمْ تَکُنْ لَہُمَا بَیِّنَۃٌ۔","","Musannaf Ibn Abi Shaybah 21252","","","كتاب البيوع والأقضية"
"21253","(۲۱۲۵۳) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ، عَنْ یُونُسَ، عَنِ الْحَسَنِ، أَنَّہُ سُئِلَ عَنِ النُّحْلِ عِنْدَ الْجَلْوَۃِ، فَقَالَ: لَیْسَ بِشَیْئٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 21253","","","كتاب البيوع والأقضية"
"21254","(۲۱۲۵۴) حَدَّثَنَا أَزْہَرُ السَمَّان ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یَکْرَہُ أَنْ یُنْحَلَ الشَّیْئَ الْمَرْأَۃَ لاَ یَفِی بِہِ۔","","Musannaf Ibn Abi Shaybah 21254","","","كتاب البيوع والأقضية"
"21255","(۲۱۲۵۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، أَنَّ أَبَا الْخَلِیلِ أَوْصَی أَنْ یُدْفَعَ إلَی امْرَأَتِہِ نُحْل کَانَ نَحَلَہَا إیَّاہُ تَحَرُّجًا مِنْہُ۔","","Musannaf Ibn Abi Shaybah 21255","","","كتاب البيوع والأقضية"
"21256","(۲۱۲۵۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَیُّمَا رَجُلٍ تَزَوَّجَ امْرَأَۃً عَلَی صَدَاقٍ ، أَوْ عِدَۃٍ ، فَہُوَ لَہَا إذَا کَانَ قَبْلَ عُقْدَۃِ النِّکَاحِ ، فَإِنْ حَبَا أَہْلَہَا حِبَائً بَعْدَ عُقْدَۃِ النِّکَاحِ ، فَہُوَ لَہُمْ ، وَأَحَقُّ مَا أُکْرِمَ بِہِ الرَّجُلُ ابْنَتُہُ وَأُخْتُہُ۔ (ابوداؤد ۲۱۳۔ احمد ۱۲۲)","","Musannaf Ibn Abi Shaybah 21256","","","كتاب البيوع والأقضية"
"21257","(۲۱۲۵۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ، عَنْ عُبَیْدِ اللہِ بْنِ مَعْمَرٍ ، أَنَّہُ کَانَ یَقْضِی بِہَا ، وَأَنَّ إیَاسًا کَانَ یَقْضِی بِہَا۔","","Musannaf Ibn Abi Shaybah 21257","","","كتاب البيوع والأقضية"
"21258","(۲۱۲۵۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ، عَنْ قَتَادَۃَ، أَنَّ شُرَیْحًا، وَابْنَ أُذَیْنَۃَ کَانَا لاَ یُجِیزَانِ الْجَلْوَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21258","","","كتاب البيوع والأقضية"
"21259","(۲۱۲۵۹) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، عَنِ الأَوْزَاعِی ، قَالَ : سَأَلْتُ قَتَادَۃَ ، عَنْ عَطِیَّۃِ الْجَلْوَۃِ ، قَالَ : تِلْکَ سُمْعَۃٌ ، لاَ تَجُوزُ۔","","Musannaf Ibn Abi Shaybah 21259","","","كتاب البيوع والأقضية"
"21260","(۲۱۲۶۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ تُجلی عَلَیہ امْرَأَتِہِ فَیَقُولُونَ : لاَ نُریک حَتَّی تَنْحَلَہَا شَیْئًا ، قَالَ : ہِیَ وَاجِبَۃٌ عَلَیْہِ ، یُؤْخَذُ بِہَا۔","","Musannaf Ibn Abi Shaybah 21260","","","كتاب البيوع والأقضية"
"21261","(۲۱۲۶۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ، عَنِ ابْنِ عَوْنٍ، عَنِ ابْنِ سِیرِینَ، قَالَ: جَائَ عُقْبَۃُ بْنُ عَمْرٍو أَبُو مَسْعُودٍ إلَی أَہْلِہِ فَإِذَا ہَدِیَّۃٌ ، فَقَالَ : مَا ہَذَا ؟ فَقَالُوا : الَّذِی شَفَعْتَ لَہُ ، فَقَالَ : أَخْرِجُوہَا ، أَتَعَجَّلُ أَجْرَ شَفَاعَتِی فِی الدُّنْیَا؟۔","Hasan","Musannaf Ibn Abi Shaybah 21261","","","كتاب البيوع والأقضية"
"21262","(۲۱۲۶۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمَّارٍ ، عَنْ سَالِمٍ ، عَنْ مَسْرُوقٍ ، قَالَ : سَأَلْتُ عَبْدَ اللہِ ، عَنِ السُّحْتِ فَقَالَ : الرَّجُلُ یَطْلُبُ الْحَاجَۃَ فَتقضی لہ فَیُہْدَی إلَیْہِ فَیَقْبَلُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 21262","","","كتاب البيوع والأقضية"
"21263","(۲۱۲۶۳) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ کُلَیْبِ بْنِ وَائِلٍ ، قَالَ : قُلْتُ لاِبْنِ عُمَرَ : أَتَانِی دِہْقَانٌ عَظِیمُ الْخَرَاجِ فَقَالَ : تقبَّلنی مِنَ الْعَامِلِ لاَ أَتَقَبَّلُہُ لِاُعْطٰی عَنْہُ شَیْئًا إلاَّ لِیُؤْمِنَہُ عَامِلُہُ وَیَضْطَرِبَ فِی حَوَائِجِہِ ، فَلَمْ أَلْبَثْ إلاَّ قَلِیلاً حَتَّی أَتَانِی بِصَحِیفَتِی ، فَقُال : جَزَاکَ اللَّہُ خَیْرًا ، وَحَمَلَنِی عَلَی دَابَّۃٍ وَأعطانی دَرَاہم ، وَکَسَانِی ، فَقَالَ : أَرَأَیْتَ إن لَوْ لَمْ تَتَقَبَّلْہُ کَانَ یُعْطِیکَ ؟ قُلْتُ : لاَ قَالَ : لاَ یَصلح لَکَ۔","Hasan","Musannaf Ibn Abi Shaybah 21263","","","كتاب البيوع والأقضية"
"21264","(۲۱۲۶۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، قَالَ: أَتَی دِہْقَانٌ مِنْ دَہَاقِینِ سَوَادِ الْکُوفَۃِ عَبْدَ اللہِ بْنَ جَعْفَرٍ یَسْتَعِینُ بِہِ فِی شَیْئٍ عَلَی عَلِیٍّ، قَالَ: فَکَلَّمَ لَہُ عَلِیًّا، فَقَضَی لَہُ حَاجَتَہُ، قَالَ: فَبَعَثَ إلَیْہِ الدِّہْقَانُ بِأَرْبَعِینَ أَلْفًا وَبِشَیْئٍ مَعَہَا لاَ أَدْرِی مَا ہُوَ ؟ فَلَمَّا وُضِعَتْ بَیْنَ یَدَیْ عَبْدِ اللہِ بْنِ جَعْفَرٍ ، قَالَ : مَا ہَذَا ؟ قِیلَ لَہُ : بَعَثَ بِہَا الدِّہْقَانُ الَّذِی کَلَّمْتَ لَہُ فِی حَاجَتِہِ أَمِیرَ الْمُؤْمِنِینَ ، قَالَ : رُدُّوہَا عَلَیْہِ ، فَإِنَّا أَہْلَ بَیْتٍ لاَ نَبِیعُ الْمَعْرُوفَ۔","Hasan","Musannaf Ibn Abi Shaybah 21264","","","كتاب البيوع والأقضية"
"21265","(۲۱۲۶۵) حَدَّثَنَا یَحْیَی بْنُ أَبِی زَائِدَۃَ ، عَنْ إسْرَائِیلَ ، عَنْ طَارِقِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ شُرَیْحٍ ، قَالَ : شَہِدْتُہُ وَجَائَہُ رَجُلٌ فَقَالَ : إنِّی اکْتَتَبْتُ عَلَی ہَذَا وَعَلَی رَجُلَیْنِ مَعَہُ : أَیُّہُمْ شِئْتُ أَخَذْتُ بِحَقِّی ، فَقَالَ الرَّجُلُ : إنَّ صَاحِبَیَّ فِی السُّوقِ ، قَالَ : خُذْ أَیَّہُمْ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 21265","","","كتاب البيوع والأقضية"
"21266","(۲۱۲۶۶) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : أکْتَتَبْت عَلَی رَجُلَیْنِ فِی بَیْعٍ ، أَنَّ حَیَّکُمَا عَلَی مَیِّتِکُمَا وَمَلِیِّکُمَا عَلَی مُعْدِمِکُمَا قَالَ : یَجُوزُ ، وَقَالَہُ عَمْرُو بْنُ دِینَارٍ وَسُلَیْمَانُ بْنُ مُوسَی۔","","Musannaf Ibn Abi Shaybah 21266","","","كتاب البيوع والأقضية"
"21267","(۲۱۲۶۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ سُئِلَ عَنِ النَّفَرِ یُکْتَبُ عَلَیْہِمُ الصَّکُّ : أَیُّہُمْ شَائَ أَخَذَ بِجَمِیعِ حَقِّہِ ؟ قَالَ : ہُوَ عَلَی شَرْطِہِ ، أَیُّہُمْ شَائَ أَخَذَ بِجَمِیعِ حَقِّہِ ، وَکَانَ إبْرَاہِیمُ یَسْتَحِبُّ أَنْ یَأْخُذَ مِنْ کُلِّ إنْسَانٍ مِنْہُمْ بِحِصَّتِہِ وَہُوَ أَعْدَلُ۔","","Musannaf Ibn Abi Shaybah 21267","","","كتاب البيوع والأقضية"
"21268","(۲۱۲۶۸) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ جَابِرٍ ، عَنِ الْحَکَمِ ؛ فِی الرَّجُلِ یَکُونُ لَہُ الْحَقُّ عَلَی الْقَوْمِ ، یَقُولُ : أَیَّہُمْ شِئْتُ أَخَذْتُ بِجَمِیعِ حَقِّی ، قَالَ : ہَذَا بِمَنْزِلَۃِ الْکَفِیلِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21268","","","كتاب البيوع والأقضية"
"21269","(۲۱۲۶۹) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الْجَہْمِ ، قَالَ : کَتَبْتُ ذِکْرَ حَقٍّ عَلَی عِدَّۃٍ : أَیَّہُمْ شِئْتُ أَخَذْتُ بِحَقِّی ، فَقَدَّمْتُہُمْ إلَی شُرَیْحٍ فَقَالَ : خُذْ أَیَّہُمْ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 21269","","","كتاب البيوع والأقضية"
"21270","(۲۱۲۷۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَقُولُ فِی الْعَبْدِ الْمَأْذُونِ لَہُ فِی التِّجَارَۃِ : إذَا کَانَ عَلَیْہِ دَیْنٌ فَأَعْتَقَہُ مَوْلاَہُ ، قَالَ : یَسْعَی لَہُمُ الْعَبْدُ فِی دَیْنِہِمْ ، لَمْ یَزِدْہُ الْعِتْقُ إلاَّ صَلاَحًا۔","","Musannaf Ibn Abi Shaybah 21270","","","كتاب البيوع والأقضية"
"21271","(۲۱۲۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ؛ فِی الرَّجُلِ یَأْذَنُ لِعَبْدِہِ فَیَدَّانُ ، ثُمَّ یُعْتِقُہُ مَوْلاَہُ ، قَالَ : یَضْمَنُ مَوْلاَہُ الْقِیمَۃَ ، وقَالَ سُفْیَانُ : یَتْبَعُ غُرَمَائَہُ بِمَا بَقِیَ مِنَ الدَّیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21271","","","كتاب البيوع والأقضية"
"21272","(۲۱۲۷۲) حَدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ فِی الرَّجُلِ یُفْلِسُ فَیُعْتِقُہُ سَیِّدُہُ ، أَنَّ عِتْقَہُ جَائِزٌ ، وَیَضْمَنُ السَّیِّدُ ثَمَنَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21272","","","كتاب البيوع والأقضية"
"21273","(۲۱۲۷۳) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ حَمَّادٍ ، قَالَ : إِنْ أَعْتَقَہُ سَیِّدُہُ فَالدَّیْنُ عَلَی سَیِّدِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21273","","","كتاب البيوع والأقضية"
"21274","(۲۱۲۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، وَمُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَسْعَی لِلْغُرَمَائِ ، لَمْ یَزِدْہُ الْعِتْقُ إلاَّ صَلاَحًا۔","","Musannaf Ibn Abi Shaybah 21274","","","كتاب البيوع والأقضية"
"21275","(۲۱۲۷۵) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا ادَّانَ الْعَبْدُ بِغَیْرِ إذْنِ مَوَالِیہِ ، ثُمَّ أُعْتِقَ فَإِنَّہُ یُبَاعُ بِذَلِکَ الدَّیْنِ۔","","Musannaf Ibn Abi Shaybah 21275","","","كتاب البيوع والأقضية"
"21276","(۲۱۲۷۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ : فِی الْعَبْدِ یَبِیعُ وَیَشْتَرِی بِغَیْرِ إذْنِ سَیِّدِہِ ، قَالَ : لَیْسَ عَلَی سَیِّدِہِ شَیْئٌ ، ہُوَ فِی ذِمَّۃِ الْعَبْدِ إذَا أُعْتِقَ فَعَلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21276","","","كتاب البيوع والأقضية"
"21277","(۲۱۲۷۷) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، قَالَ : سُئِلَ حَمَّادٌ ، عَنْ عَبْدٍ اشْتَرَی بِغَیْرِ إذْنِ سَیِّدِہِ فَأَعْتَقَہُ فَلَیْسَ عَلَیْہِ شَیْئٌ ، وَأَمْوَالُہُمْ فِی رَقَبَۃِ الْعَبْدِ إذَا أُعْتِقَ۔","","Musannaf Ibn Abi Shaybah 21277","","","كتاب البيوع والأقضية"
"21278","(۲۱۲۷۸) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ عُمَرَ قَالَ : إِنْ کَانَتْ ثَیِّبًا رَدَّ نِصْفَ الْعُشْرِ ، وَإِنْ کَانَتْ بِکْرًا رَدَّ الْعُشْرَ۔","Da'if","Musannaf Ibn Abi Shaybah 21278","","","كتاب البيوع والأقضية"
"21279","(۲۱۲۷۹) حَدَّثَنَا شریک ، عن الأعمش ، عَنْ إبْرَاہِیمَ ، عن شریح : بمثلہ۔","","Musannaf Ibn Abi Shaybah 21279","","","كتاب البيوع والأقضية"
"21280","(۲۱۲۸۰) حَدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیِّ بْنِ الْحُسَیْنِ ، عَنْ عَلِیٍّ ، قَالَ : لاَ یَرُدُّہَا ، وَلَکِنَّہا تُکْسرُ فَتَرُدُّ عَلَیْہِ قِیمَۃَ الْعَیْبِ۔","","Musannaf Ibn Abi Shaybah 21280","","","كتاب البيوع والأقضية"
"21281","(۲۱۲۸۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا اشْتَرَی الرَّجُلُ الْجَارِیَۃَ ، ثُمَّ ظَہَرَ بِہَا دَائٌ کَانَ عِنْدَ الْبَائِعِ ، قَالَ : کَانَ یُوجِبُہَا عَلَیْہِ ، وَلاَ یَرُدُّ عَلَیْہِ الْبَائِعُ شَیْئًا۔","No Data Available","Musannaf Ibn Abi Shaybah 21281","","","كتاب البيوع والأقضية"
"21282","(۲۱۲۸۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ أَنَّہُ أَمْضَاہَا عَلَیْہِ وَلَمْ یَرُدَّ عَلَیْہِ شَیْئًا۔","No Data Available","Musannaf Ibn Abi Shaybah 21282","","","كتاب البيوع والأقضية"
"21283","(۲۱۲۸۳) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ؛ فِی الرَّجُلِ یَشْتَرِی الْجَارِیَۃَ وَبِہَا دَائٌ ، فَیَقَعُ عَلَیْہَا قَبْلَ أَنْ یَطَّلِعَ عَلَی ذَلِکَ ، قَالَ : أَحَبُّ إلَیَّ أَنْ یُوضَعَ عَنْہُ بِقَدْرِ ذَلِکَ ، وَیُجَوَّزَ عَلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21283","","","كتاب البيوع والأقضية"
"21284","(۲۱۲۸۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، قَالَ : مَا کَانَ یُوَقِّتُ فِیہَا شَیْئًا یَقْضِی عَلَی نَحْوِ مَا یَرَی مِنْ ہَیْئتہا۔","","Musannaf Ibn Abi Shaybah 21284","","","كتاب البيوع والأقضية"
"21285","(۲۱۲۸۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إِنْ کَانَتْ بِکْرًا رَدَّ الْعُشْرَ ، وَإِنْ کَانَتْ ثَیِّبًا رَدَّ نِصْفَ الْعُشْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21285","","","كتاب البيوع والأقضية"
"21286","(۲۱۲۸۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : یَرُدُّ مَعَہَا عَشْرَۃَ دَنَانِیرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21286","","","كتاب البيوع والأقضية"
"21287","(۲۱۲۸۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، یَبْلُغُ بِہِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ یَبِعْ حَاضِرٌ لِبَادٍ۔ (بخاری ۲۱۴۰۔ مسلم ۱۸)","Sahih","Musannaf Ibn Abi Shaybah 21287","","","كتاب البيوع والأقضية"
"21288","(۲۱۲۸۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی الزُّبَیْرِ ، سَمِعَ جَابِرًا یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَبِعْ حَاضِرٌ لِبَادٍ ، دَعُوا النَّاسَ یَرْزُقُ اللَّہُ بَعْضَہُمْ مِنْ بَعْضٍ۔ (مسلم ۱۱۵۸۔ ترمذی ۱۲۲۳)","Sahih","Musannaf Ibn Abi Shaybah 21288","","","كتاب البيوع والأقضية"
"21289","(۲۱۲۸۹) حَدَّثَنَا شَبَابَۃُ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، قَالَ : حَدَّثَنِی مُسْلِمٌ الْخَیَّاطُ ، عَنِ ابْنِ عُمَرَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ بَیْعِ حَاضِرٍ لِبَادٍ۔ (بخاری ۲۱۵۹۔ احمد ۲/۴۲)","Sahih","Musannaf Ibn Abi Shaybah 21289","","","كتاب البيوع والأقضية"
"21290","(۲۱۲۹۰) حَدَّثَنَا أَبُو دَاوُدَ، عَنْ أَبِی حُرَّۃَ، عَنِ الْحَسَنِ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَشْتَرِیَ مِنَ الأَعْرَابِیِّ لِلأَعْرَابِیِّ، قَالَ : فَقِیلَ لَہُ : فَیَشْتَرِی مِنْہُ لِلْمُہَاجِرِ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 21290","","","كتاب البيوع والأقضية"
"21291","(۲۱۲۹۱) حَدَّثَنَا ابْن عُیَیْنَۃَ ، عَنْ مُسْلِمٍ الْخَیَّاطِ ، سَمِعَ أَبَا ہُرَیْرَۃَ یَقُولُ : نُہِیَ أَنْ یَبِیعَ حَاضِرٌ لِبَادٍ ، وَسُمِعَ ابن عُمَرُ یَقُولُ : لاَ یَبِعْ حَاضِرٌ لِبَادٍ۔","Sahih","Musannaf Ibn Abi Shaybah 21291","","","كتاب البيوع والأقضية"
"21292","(۲۱۲۹۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ یَبِعْ حَاضِرٌ لِبَادٍ۔ (احمد ۴۲۰)","","Musannaf Ibn Abi Shaybah 21292","","","كتاب البيوع والأقضية"
"21293","(۲۱۲۹۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لَیْسَ بِہِ بَأْسٌ الْیَوْمَ ، إنَّمَا أَرَادَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُصِیبَ النَّاسُ غِرَّۃَ أَہْلِ الْبَادِیَۃِ لَمَّا قَدِمَ الْمَدِینَۃَ ، قَالَ عَطَائٌ : لاَ یَصْلُحُ الْیَوْمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21293","","","كتاب البيوع والأقضية"
"21294","(۲۱۲۹۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَنَسٍ ، قَالَ : لاَ یَبِعْ حَاضِرٌ لِبَادٍ۔","Sahih","Musannaf Ibn Abi Shaybah 21294","","","كتاب البيوع والأقضية"
"21295","(۲۱۲۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی مُوسَی ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ الْمُہَاجِرُونَ یَکْرَہُونَ بَیْعَ حَاضِرٍ لِبَادٍ ، وقَالَ الشَّعْبِیُّ : وَإِنِّی لاَفْعَلُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 21295","","","كتاب البيوع والأقضية"
"21296","(۲۱۲۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عُمَرُ : دُلُّوہُمْ عَلَی الطَّرِیقِ وَأَخْبِرُوہُمْ بِالسِّعْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 21296","","","كتاب البيوع والأقضية"
"21297","(۲۱۲۹۷) حَدَّثَنَا أَبُو دَاوُدَ، عَنْ إیَاسِ بْنِ دَغْفَلٍ، قَالَ: قرِیئَ عَلَیْنَا کِتَابُ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ: لاَ یَبِعْ حَاضِرٌ لِبَادٍ۔","","Musannaf Ibn Abi Shaybah 21297","","","كتاب البيوع والأقضية"
"21298","(۲۱۲۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ خُثَیْمٍ ، قَالَ : قُلْتُ لِعَطَائٍ : قَوْمٌ مِنَ الأَعْرَابِ یَقْدَمُونَ عَلَیْنَا فَأَشْتَرِی لَہُمْ ؟ قَالَ : لاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 21298","","","كتاب البيوع والأقضية"
"21299","(۲۱۲۹۹) حَدَّثَنَا وَکِیعٌ، عَنْ ??ُفْیَانَ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: کَانَ یُعْجِبُہُمْ أَنْ یُصِیبُوا مِنَ الأَعْرَابِ رُخْصَۃً","No Data Available","Musannaf Ibn Abi Shaybah 21299","","","كتاب البيوع والأقضية"
"21300","(۲۱۳۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یُونُسَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَنْسِ بْنِ مَالِکٍ ، قَالَ : نُہِینَا أَنْ یَبِیعَ حَاضِرٌ لِبَادٍ ، وَإِنْ کَانَ أَخَاہُ لأَِبِیہِ وَأُمِّہِ۔ (بخاری ۲۱۶۱۔ مسلم ۲۱)","Sahih","Musannaf Ibn Abi Shaybah 21300","","","كتاب البيوع والأقضية"
"21301","(۲۱۳۰۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ ، عَنْ سَعَیْدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : سَمِعْتُہُ یَقُولُ : ثَمَنُ الْکَلْبِ سُحْتٌ۔","Sahih","Musannaf Ibn Abi Shaybah 21301","","","كتاب البيوع والأقضية"
"21302","(۲۱۳۰۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی بَکْرٍ ، عَنْ أَبِی مَسْعُودٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ مَہْرِ الْبَغِیِّ ، وَثَمَنِ الْکَلْبِ۔","Sahih","Musannaf Ibn Abi Shaybah 21302","","","كتاب البيوع والأقضية"
"21303","(۲۱۳۰۳) حَدَّثَنَا وَکِیعٌ ، عَنِ ابنِ أَبِِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ مَہْرِ الْبَغِیِّ وَعَسْبِ الْفَحْلِ وَکَسْبِ الْحَجَّامِ ، وَثَمَنِ الْکَلْبِ۔ (احمد ۲/۵۰۰۔ دارقطنی ۷۲)","Da'if","Musannaf Ibn Abi Shaybah 21303","","","كتاب البيوع والأقضية"
"21304","(۲۱۳۰۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، قَالَ : أُری أبَا سُفْیَانَ ، ذَکَرَہُ عَنْ جَابِرٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ ثَمَنِ الْکَلْبِ۔ (ترمذی ۱۲۷۹۔ ابوداؤد ۳۷۷۳)","","Musannaf Ibn Abi Shaybah 21304","","","كتاب البيوع والأقضية"
"21305","(۲۱۳۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، وَعَنْ أَبِی الْمُہَزِّمِ ، عَنْ أَبِی ہُرَیْرَۃَ : أَنَّہُمَا کَرِہَا ثَمَنَ الْکَلْبِ إلاَّ کَلْبَ صَیْدٍ۔ (ترمذی ۱۲۸۱۔ نسائی ۶۲۶۴)","Sahih","Musannaf Ibn Abi Shaybah 21305","","","كتاب البيوع والأقضية"
"21306","(۲۱۳۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ زِیَادِ بْنِ أَبِی الْجَعْدِ ، عَنِ عَوْنِ بْنِ أَبِی جُحَیْفَۃَ ، عَنْ أَبِیہِ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ مَہْرِ الْبَغِیِّ ، وَکَسْبِ الْحَجَّامِ ، وَثَمَنِ الْکَلْبِ۔n(بخاری ۲۰۸۶۔ ابوداؤد ۳۴۷۷)","Sahih","Musannaf Ibn Abi Shaybah 21306","","","كتاب البيوع والأقضية"
"21307","(۲۱۳۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ قَیْسِ بْنِ حَبْتَرٍ ، عَنِ ابْنِ عَبَّاسٍ ، رَفَعَہُ ، قَالَ : ثَمَنُ الْکَلْبِ ، وَمَہْرُ الْبَغِیِّ ، وَثَمَنُ الْخَمْرِ حَرَامٌ۔ (ابوداؤد ۳۴۷۶۔ احمد ۱/۲۳۵)","Sahih","Musannaf Ibn Abi Shaybah 21307","","","كتاب البيوع والأقضية"
"21308","(۲۱۳۰۸) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ أَشْعَثَ، عَنِ ابْنِ سِیرِینَ، قَالَ: أَخْبَثُ الْکَسْبِ کَسْبُ الزَّمَّارَۃِ ، وَثَمَنُ الْکَلْبِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21308","","","كتاب البيوع والأقضية"
"21309","(۲۱۳۰۹) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ أَبِی فَرْوَۃَ ، قَالَ : سَمِعْتُ عَبْدَ الرَّحْمَن بْنِ أَبِی لَیْلَی یَقُولُ : مَا أُبَالِی ثَمَنَ کَلْبٍ أَکَلْتُ ، أَوْ ثَمَنَ خِنْزِیرٍ۔","","Musannaf Ibn Abi Shaybah 21309","","","كتاب البيوع والأقضية"
"21310","(۲۱۳۱۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، قَالَ : سَمِعْتُ الْحَکَمَ وَحَمَّادًا یَکْرَہَانِ ثَمَنَ الْکَلْبِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21310","","","كتاب البيوع والأقضية"
"21311","(۲۱۳۱۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حَدَّثَنَا أَبَانُ الْعَطَّارُ ، عَنْ یَحْیی بْنِ أَبِی کَثِیرٍ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ اللہِ بنِ قَارظ ، عَنِ السَّائِبِ بْنِ یَزِیدَ ، عَنْ رَافِعِ بْنِ خَدِیجٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : کَسْبُ الْحَجَّامِ خَبِیثٌ ، وَمَہْرُ الْبَغِیِّ خَبِیثٌ ، وَثَمَنُ الْکَلْبِ خَبِیثٌ۔","Sahih","Musannaf Ibn Abi Shaybah 21311","","","كتاب البيوع والأقضية"
"21312","(۲۱۳۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرۃ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِثَمَنِ کَلْبِ الصَّیْدِ۔","","Musannaf Ibn Abi Shaybah 21312","","","كتاب البيوع والأقضية"
"21313","(۲۱۳۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِثَمَنِ کَلْبِ السَّلُوقِیِّ۔","","Musannaf Ibn Abi Shaybah 21313","","","كتاب البيوع والأقضية"
"21314","(۲۱۳۱۴) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إِنْ قَتَلْتَ کَلْبًا لَیْسَ بِعَقُورٍ فَاغْرَمْ لأَِہْلِہِ ثَمَنَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21314","","","كتاب البيوع والأقضية"
"21315","(۲۱۳۱۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ، قَالَ : کَانَ النَّاسُ یَقْضُونَ فی الْکَلْبِ بِأَرْبَعِینَ دِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 21315","","","كتاب البيوع والأقضية"
"21316","(۲۱۳۱۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ إسْمَاعِیلَ بْنِ جُسْتاس ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : فِی کَلْبِ الصَّیْدِ أَرْبَعُونَ دِرْہَمًا ، وَفِی کَلْبِ الْمَاشِیَۃِ شَاۃٌ مِنَ الْغَنَمِ ، وَفِی کَلْبِ الْحَرْث فَرَقٌ مِنْ طَعَامٍ ، وَفِی کَلْبِ الدَّارِ فَرَقٌ مِنْ تُرَابٍ ، حَقٌّ عَلَی الَّذِی أَصَابَہُ أَنْ یُعْطِیَہُ ، وَحَقٌّ عَلَی صَاحِبِ الْکَلْبِ أَنْ یَقْبَلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 21316","","","كتاب البيوع والأقضية"
"21317","(۲۱۳۱۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِثَمَنِ کَلْبِ الصَّیْدِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21317","","","كتاب البيوع والأقضية"
"21318","(۲۱۳۱۸) حَدَّثَنَا جَرِیرٌ ، عَنْ طَلْقِ بْنِ مُعَاوِیَۃَ ، قَالَ : کَانَ لِی عَلَی رَجُلٍ ثَلاَثُ مِئَۃِ دِرْہَمٍ فَخَاصَمْتُہُ إلَی شُرَیْحٍ ، فَقَالَ الرَّجُلُ : إنَّہُمْ وَعَدُونِی أَنْ یُحْسِنُوا إلَیَّ ، فَقَالَ شُرَیْحٌ : إنَّ اللَّہَ یَأْمُرُکُمْ أَنْ تُؤَدُّوا الأَمَانَاتِ إلَی أَہْلِہَا ، قَالَ : وَأَمَرَ بِحَبْسِہِ ، وَمَا طَلَبْتُ إلَیْہِ أَنْ یَحْبِسَہُ حَتَّی صَالَحَنِی عَلَی مِئَۃ وَخَمْسِینَ دِرْہَمًا۔","No Data Available","Musannaf Ibn Abi Shaybah 21318","","","كتاب البيوع والأقضية"
"21319","(۲۱۳۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہِلاَلٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ، أَنَّہُ کَانَ یَحْبِسُ فِی الدَّیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21319","","","كتاب البيوع والأقضية"
"21320","(۲۱۳۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ سُرِّیَّۃِ الشَّعْبِیِّ یُقَالُ لَہَا أُمُّ جَعْفَرٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا أَنَا لَمْ أَحْبِسْ فِی الدَّیْنِ فَأَنَا أَتْوَیْتُ حَقَّہُ۔","","Musannaf Ibn Abi Shaybah 21320","","","كتاب البيوع والأقضية"
"21321","(۲۱۳۲۱) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ وَعُبَیْدُ اللہِ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ غَالِبٍ الْقَطَّانِ ، عَنْ أَبِی الْمُہَزِّمِ : أَنَّ رَجُلاً أَتَی أَبَا ہُرَیْرَۃَ فِی غَرِیمٍ لَہُ فَقَالَ : احْبِسْہُ ، قَالَ : قَالَ أَبُو ہُرَیْرَۃَ : ہَلْ تَعْلَمُ لَہُ عَیْن مالٍ فَآخُذَہُ بِہِ ؟ قَالَ : لاَ ، قَالَ : فَہَلْ تَعْلَمُ لَہُ عَقَارًا کَثیِرَۃً ؟ قَالَ : لاَ ، قَالَ : فَمَا تُرِیدُ ؟ قَالَ : احْبِسْہُ ، قَالَ : لاَ ، وَلَکِنِّی أَدعُہُ یَطْلُبُ لَکَ وَلِنَفْسِہِ وَلِعِیَالِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 21321","","","كتاب البيوع والأقضية"
"21322","(۲۱۳۲۲) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی وَزَیْدُ بْنُ الْحُبَابِ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ غَالِبٍ ، عَنِ الْحَسَنِ قَضَی بِمِثْلِ قَوْلِ أَبِی ہُرَیْرَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21322","","","كتاب البيوع والأقضية"
"21323","(۲۱۳۲۳) حَدَّثَنَا وکیع ، قَالَ : حَدَّثَنَا حسن بن عَلِیِّ ، عن جابر : أن علیًا حبس فی الدَّین۔","Da'if","Musannaf Ibn Abi Shaybah 21323","","","كتاب البيوع والأقضية"
"21324","(۲۱۳۲۴) حَدَّثَنَا وَکِیعٌ، عَنْ عَلِیِّ بْنِ صَالِحٍ، عَنْ عَبْدِالأَعْلَی، قَالَ: شَہِدْتُ شُرَیْحًا حَبَسَ رُسْتُمَ الشَّدِید فِی دَیْنٍ۔n قَالَ وَکِیعٌ : مَا أَدْرَکْنَا أَحَدًا مِنْ قُضَاتِنَا ابْنَ أَبِی لَیْلَی وَغَیْرَہُ إلاَّ وَہُوَ یَحْبِسُ فِی الدَّیْنِ۔","","Musannaf Ibn Abi Shaybah 21324","","","كتاب البيوع والأقضية"
"21325","(۲۱۳۲۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ عَلِیٌّ : لاَ حُبُس عَنْ فَرَائِضِ اللہِ إلاَّ مَا کَانَ مِنْ سِلاَحٍ أَوْ کُرَاعٍ۔ (بیہقی ۱۶۳)","","Musannaf Ibn Abi Shaybah 21325","","","كتاب البيوع والأقضية"
"21326","(۲۱۳۲۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُطَرِّفٍ ، عَنْ رَجُلٍ ، عَنِ الْقَاسِمِ ، قَالَ : قَالَ عَبْدُ اللہِ : لاَ حبسَ إلاَّ فِی کُرَاعٍ ، أَوْ سِلاَحٍ۔","Da'if","Musannaf Ibn Abi Shaybah 21326","","","كتاب البيوع والأقضية"
"21327","(۲۱۳۲۷) حَدَّثَنَا وَکِیعٌ ، وَابْنُ أَبِی زَائِدَۃَ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی عَوْنٍ ، عَنْ شُرَیْحٍ ، قَالَ : جَائَ مُحَمَّدٌ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِبَیْعِ الْحُبُسِ۔","","Musannaf Ibn Abi Shaybah 21327","","","كتاب البيوع والأقضية"
"21328","(۲۱۳۲۸) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَحْبِسُونَ الْفَرَسَ وَالسِّلاَحَ فِی سَبِیلِ اللہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21328","","","كتاب البيوع والأقضية"
"21329","(۲۱۳۲۹) حَدَّثَنَا حَفْصٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ : أَنَّ الزُّبَیْرَ وَقَفَ دَارًا لَہُ عَلَی الْمَرْدُودَۃِ مِنْ بَنَاتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 21329","","","كتاب البيوع والأقضية"
"21330","(۲۱۳۳۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الْقَاسِمِ بْنِ الفَضْلِ ، عَنْ أَبِی جَعْفَرٍ : أَنَّ عَلِیًّا وَعُمَرَ أوْقَفَا أَرْضًا لَہُمَا بَتًّا بَتْلاً۔","","Musannaf Ibn Abi Shaybah 21330","","","كتاب البيوع والأقضية"
"21331","(۲۱۳۳۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَوَّارٍ ، عَنِ الْوَلِیدِ بْنِ أَبِی ہِشَامٍ ، قَالَ : قَالَ عُثْمَانُ : رِبَاعِی الَّتِی بِمَکَّۃَ یَسْکُنُہَا بَنِیَّ وَیُسْکِنُونَہَا مَنْ أَحَبُّوا۔","","Musannaf Ibn Abi Shaybah 21331","","","كتاب البيوع والأقضية"
"21332","(۲۱۳۳۲) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ جَابِرٍ، عَنْ عَامِرٍ، قَالَ: الْحبسُ بِمَنْزِلَۃِ الْعِتْقِ، ہُوَ لِلَّہِ فِی الدَّارِ وَالْعَقَارِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21332","","","كتاب البيوع والأقضية"
"21333","(۲۱۳۳۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنِ ابْنِ عَوْنٍ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، قَالَ: أَصَابَ عُمَرُ أَرْضًا بِخَیْبَرَ، فَأَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : أَصَبْت أَرْضًا بِخَیْبَرَ لَمْ أُصِبْ مَالاً قَطُّ أَنْفَسَ مِنْہُ عِنْدِی ، فَمَا تَأْمُرُنِی ؟ قَالَ : إِنْ شِئْتَ حَبَسْت أَصْلَہَا وَتَصَدَّقْتَ بِہَا ، قَالَ : فَتَصَدَّقَ بِہَا عُمَرُ أَنَّہُ لاَ یُبَاعُ أَصْلُہَا ، وَلاَ یُوہَبُ ، وَلاَ یُورَّثُ۔n(بخاری ۲۷۳۷۔ مسلم ۱۲۵۵)","Sahih","Musannaf Ibn Abi Shaybah 21333","","","كتاب البيوع والأقضية"
"21334","(۲۱۳۳۴) حَدَّثَنَا أَبُو خَالِدٍ وَحَفْصٌ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، أَنَّ أَبَا طَلْحَۃَ أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : إنِّی جَعَلْت حَائِطِی لِلَّہِ ، وَلَوِ اسْتَطَعْت أَنْ أُخْفِیَہُ مَا أَظْہَرتہ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اجْعَلْہُ فِی فُقَرَائِ أَہْلِک۔ (بخاری ۱۴۶۱۔ ابوداؤد ۱۶۸۶)","Sahih","Musannaf Ibn Abi Shaybah 21334","","","كتاب البيوع والأقضية"
"21335","(۲۱۳۳۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : أَلَمْ تَرَ أَنَّ حُجْرًا الْمَدَری أَخْبَرَنِی ، أَنَّ فِی صَدَقَۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَأْکُلُ مِنْہا أَہْلُہا بِالْمَعْرُوفِ غَیْرِ الْمُنْکَرِ۔","","Musannaf Ibn Abi Shaybah 21335","","","كتاب البيوع والأقضية"
"21336","(۲۱۳۳۶) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ سَلْمِ بْنِ أَبِی الذَّیَّالِ ، قَالَ : سأَلْتُ الْحَسَنَ عَنِ الرَّجُلِ تَکُونُ لَہُ الأَرْضُ وَلاَ یَکُونُ لَہُ مَائٌ یَشْتَرِی ماء لأَرْضِہِ ؟ فَقَالَ : نَعَمْ ، لاَ بَأْسَ بِذَلِکَ۔","","Musannaf Ibn Abi Shaybah 21336","","","كتاب البيوع والأقضية"
"21337","(۲۱۳۳۷) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ فِیمَا قُرِیء عَلَیْہِ عَنْ عَطَائٍ ، قَالَ : قُلْتُ لَہُ : بَیْعُ الْمَائِ فِی الْقِرَبِ ؟ قَالَ : لاَ بَأْسَ بِہِ ، ہُوَ یَسْتَقِیہِ ہُوَ یَحْمِلُہُ ، لَیْسَ کَفَضْلِ الْمَائِ الَّذِی یَذْہَبُ فِی الأَرْضِ۔","","Musannaf Ibn Abi Shaybah 21337","","","كتاب البيوع والأقضية"
"21338","(۲۱۳۳۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ بَیْعِ فَضْلِ الْمَائِ۔ (ابن ماجہ ۲۴۷۷۔ ابن حبان ۴۹۵۳)","Sahih","Musannaf Ibn Abi Shaybah 21338","","","كتاب البيوع والأقضية"
"21339","(۲۱۳۳۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ مَنَعَ فَضْلَ مَائٍ لِیَمْنَعَ بِہِ فَضْلَ الْکَلاَء مَنَعَہُ اللَّہُ فَضْلَہُ یَوْمَ الْقِیَامَۃِ۔ (عبدالرزاق ۱۴۴۹۲)","","Musannaf Ibn Abi Shaybah 21339","","","كتاب البيوع والأقضية"
"21340","(۲۱۳۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنْ عِمْرَانَ بْنِ عُمَیْرٍ ، قَالَ : مَنَعَنِی جَارٌ لی فَضْلَ مَائٍ ، فَسَأَلْت عُبَیْدَ اللہِ بْنَ عَبْدِ اللہِ بْنِ عُتْبَۃَ ؟ فَقَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یَقُولُ : لاَ یَحِلُّ بَیْعُ فَضْلِ الْمَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 21340","","","كتاب البيوع والأقضية"
"21341","(۲۱۳۴۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ إبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، قَالَ : کَانَ مَسْرُوقٌ یُعْجِبُہُ ثَمَنُ الْمَائِ۔ قَالَ وَکِیعٌ : یَعْنِی السِّقَایَۃَ عَلی الْجَمَلِ وَالظَّہْرِ یَبِیعہ۔","","Musannaf Ibn Abi Shaybah 21341","","","كتاب البيوع والأقضية"
"21342","(۲۱۳۴۲) حَدَّثَنَا یَحْیَی بن زَکَرِیَّا بْن أَبِی زَائِدَۃَ ، عَنْ زَکَرِیَّا ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، قَالَ : یُکْرَہُ بَیْعُ فَضْلِ الْمَائِ۔","","Musannaf Ibn Abi Shaybah 21342","","","كتاب البيوع والأقضية"
"21343","(۲۱۳۴۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ: حدَّثَنَا زُہَیْرٌ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ: أَنَّ غُلاَمًا لَہُمْ بَاعَ فَضْلَ مَائٍ لَہُمْ مِنْ عَیْنٍ لَہُمْ بِعِشْرِینَ أَلْفًا ، فَقَالَ لَہُ عَبْدُ اللہِ بْنُ عَمْرٍو: لاَ تَبِیعُوہُ فَإِنَّہُ لاَ یَحِلُّ بَیْعُہُ۔","","Musannaf Ibn Abi Shaybah 21343","","","كتاب البيوع والأقضية"
"21344","(۲۱۳۴۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی الْمِنْہَالِ ، قَالَ : سَمِعْتُ إیَاسَ بْنَ عَبْدٍ الْمُزَنِیَّ ، وَرَأَی أُنَاسًا یَبِیعُونَ الْمَائَ فَقَالَ : لاَ تَبِیعُوا الْمَائَ فَإِنِّی سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْہَی أَنْ تُبَاعَ۔n(ابوداؤد ۳۴۷۲۔ ترمذی ۱۲۷۱)","Sahih","Musannaf Ibn Abi Shaybah 21344","","","كتاب البيوع والأقضية"
"21345","(۲۱۳۴۵) حَدَّثَنَا وکیع ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ أَبِی الزِّنَادِ ، عَنِ الأَعْرَجِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ مَنْعِ فَضْلِ الْمَائِ لِیُمْنَعَ بِہِ الْکَلأ۔ (بخاری ۲۳۵۳۔ مسلم ۳۶)","Sahih","Musannaf Ibn Abi Shaybah 21345","","","كتاب البيوع والأقضية"
"21346","(۲۱۳۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ثَلاَثَۃٌ لاَ یُکَلِّمُہُمُ اللَّہُ یَوْمَ الْقِیَامَۃِ : رَجُلٌ مَنَعَ ابْنَ السَّبِیلِ فَضْلَ مَائٍ عِنْدَہُ ، وَرَجُلٌ حَلَفَ عَلَی سِلْعَۃ بَعْدَ الْعَصْرِ ( یَعْنِی : کَاذِبًا ) وَرَجُلٌ بَایَعَ إمَامًا ، فَإِنْ أَعْطَاہُ وَفَی ، وَإِنْ لَمْ یُعْطِہِ مِنْہَا لَمْ یَفِ۔n(مسلم ۱۷۲۔ ابوداؤد ۳۴۶۸)","Sahih","Musannaf Ibn Abi Shaybah 21346","","","كتاب البيوع والأقضية"
"21347","(۲۱۳۴۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ابْنُ إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أُمِّہِ عَمْرَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُمْنَعَ نَقْعُ الْبِئْرِ یَعْنِی : فَضْلَ الْمَائِ۔n(احمد ۶/۱۳۹۔ حاکم ۶۱)","","Musannaf Ibn Abi Shaybah 21347","","","كتاب البيوع والأقضية"
"21348","(۲۱۳۴۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَقُولُ : لاَ تَجُوزُ شَہَادَۃُ الأَعْمَی إلاَّ أَنْ یَکُونَ شَیْئاً قَدْ رَآہُ قَبْلَ أَنْ یَذْہَبَ بَصَرُہُ۔","","Musannaf Ibn Abi Shaybah 21348","","","كتاب البيوع والأقضية"
"21349","(۲۱۳۴۹) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ: أَنَّ أَبَا بَصِیرٍ شَہِدَ عِنْدَ عَلِیٍّ وَہُوَ أَعْمَی فَرَدَّ شَہَادَتَہُ۔","","Musannaf Ibn Abi Shaybah 21349","","","كتاب البيوع والأقضية"
"21350","(۲۱۳۵۰) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ، قَالاَ : شَہَادَۃُ الأَعْمَی جَائِزَۃٌ۔","","Musannaf Ibn Abi Shaybah 21350","","","كتاب البيوع والأقضية"
"21351","(۲۱۳۵۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ زِیَادٍ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ شُرَیْحٌ یُجِیزُ شَہَادَۃَ الأَعْمَی مَعَ الرَّجُلِ الْعَدْلِ إذَا عَرَفَ الصَّوْتَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21351","","","كتاب البيوع والأقضية"
"21352","(۲۱۳۵۲) حَدَّثَنَا ابن مہدی ، عن شعبۃ ، قَالَ : سألت الحکم عن شہادۃ الأعمی ؟ فقال : رب شیء تجوز فیہ۔","","Musannaf Ibn Abi Shaybah 21352","","","كتاب البيوع والأقضية"
"21353","(۲۱۳۵۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، أَنَّہُ کَانَ یُجِیزُ شَہَادَۃَ الأَعْمَی۔","No Data Available","Musannaf Ibn Abi Shaybah 21353","","","كتاب البيوع والأقضية"
"21354","(۲۱۳۵۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الْحَسَنِ بْنِ صَالِحٍ وَإِسْرَائِیلَ ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، عَنِ الشَّعْبِیِّ ، أَنَّہُ أَجَازَ شَہَادَۃَ الأَعْمَی۔","","Musannaf Ibn Abi Shaybah 21354","","","كتاب البيوع والأقضية"
"21355","(۲۱۳۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عن عامر ، قَالَ : تجوز شَہَادَۃُ الأَعْمَی إذَا کَانَ عَدْلاً۔","","Musannaf Ibn Abi Shaybah 21355","","","كتاب البيوع والأقضية"
"21356","(۲۱۳۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، أَنَّ قَتَادَۃَ شَہِدَ عِنْدَ إیَاسِ بْنِ مُعَاوِیَۃَ وَہُوَ أَعْمَی فَرَدَّ شَہَادَتَہُ۔","","Musannaf Ibn Abi Shaybah 21356","","","كتاب البيوع والأقضية"
"21357","(۲۱۳۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ مُغِیرَۃَ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ عَن شَہَادَۃِ الأَعْمَی فَحَدَّثَ بِحَدِیثٍ ظَنَنَّا أَنَّہُ کَرِہَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21357","","","كتاب البيوع والأقضية"
"21358","(۲۱۳۵۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : سَأَلَ الْحَکَمَ بْنَ عُتَیْبَۃَ الْقَاسِمَ بْنَ مُحَمَّدٍ عَنِ الأَعْمَی تَجُوزُ شَہَادَتُہُ وَیَؤُمُّ الْقَوْمَ ؟ قَالَ : وَمَا یَمْنَعُہُ أَنْ یَؤُمَّ الْقَوْمَ وَیَشْہَدَ ؟۔","","Musannaf Ibn Abi Shaybah 21358","","","كتاب البيوع والأقضية"
"21359","(۲۱۳۵۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، عنْ شُرَیْحٍ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَشْتَرِی الْمِئَۃَ فِی الْعَطَائِ بِالْعَرَضِ ، قَالَ : وَقَالَ الشَّعْبِیُّ : لاَ یُشْتَرَی بِعَرَضٍ ، وَلاَ بِغَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 21359","","","كتاب البيوع والأقضية"
"21360","(۲۱۳۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَرِہَ بَیْعَ الْمِئَۃِ فِی الْعَطَائِ إلاَّ بِعَرَضٍ۔","Sahih","Musannaf Ibn Abi Shaybah 21360","","","كتاب البيوع والأقضية"
"21361","(۲۱۳۶۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ صَالِحِ بْنِ مُسْلِمٍ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ ، عَنْ شِرَاء الزِّیَادَۃِ فِی الْعَطَائِ ، قَالَ : لاَ آمُرُ بِہَا ، وَلاَ أَنْہَی عَنْہَا ، وَأَنْہَی عَنْہَا نَفْسِی وَوَلَدِی ، وَقَدْ فَعَلَ ذَلِکَ مَنْ ہُوَ خَیْرٌ مِنِّی ، قُلْتُ : مَنْ؟ قَالَ : أُمَرَائُ الْمُؤْمِنِینَ۔","","Musannaf Ibn Abi Shaybah 21361","","","كتاب البيوع والأقضية"
"21362","(۲۱۳۶۲) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ بَکْرِ بْنِ عُثْمَانَ ، قَالَ : کُنْتُ أَشْتَرِی الزِّیَادَۃَ فِی الْعَطَائِ بِخُرَاسَانَ بِالْحَرِیرِ وَالدَّرَاہِم ، فَحَجَجْت فَسَأَلْت سَالِمًا فَقَالَ : أَکْرَہُہُ بِالدَّرَاہِم ، وَلَیْسَ بِہِ بَأْسٌ بِالْعُرُوضِ ، وَسَأَلْت مُحَمَّدَ بْنَ کَعْبٍ الْقُرَظِیَّ فَقَالَ مِثْلَہُ ، وَسَأَلْت عَطَائً فَقَالَ مِثْلَہُ ، وَسَأَلْت الْحَسَنَ ، وَابْنَ سِیرِینَ فَقَالاَ : نَکْرَہُہَا بِالدَّرَاہِم ، وَلاَ نَرَی بِہَا بَأْسًا بِالْعُرُوضِ۔","","Musannaf Ibn Abi Shaybah 21362","","","كتاب البيوع والأقضية"
"21363","(۲۱۳۶۳) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ إبْرَاہِیمَ بْنِ دَاوُد ، قَالَ : سَأَلْتُ الْحَسَنَ وَمُحَمَّدًا ، عَنْ بَیْعِ الْعَطَائِ فَقَالاَ : بِعْہُ بِعَرَضٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 21363","","","كتاب البيوع والأقضية"
"21364","(۲۱۳۶۴) حَدَّثَنَا حَفْصٌ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ۔ وَعَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالاَ : فِی الْمُضَارِبِ یُخَالِفُ ، قَالاَ : یَتَنَزَّہَانِ عَنِ الرِّبْحِ یَتَصَدَّقَانِ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21364","","","كتاب البيوع والأقضية"
"21365","(۲۱۳۶۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، قَالَ : یَتَصَدَّقَانِ بِالرِّبْحِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21365","","","كتاب البيوع والأقضية"
"21366","(۲۱۳۶۶) حَدَّثَنَا إسْمَاعِیلُ بْنُ عُلَیَّۃَ، عَنْ أَیُّوبَ، عَنْ أَبِی قِلاَبَۃَ، قَالَ: إذَا خَالَفَ فَہُوَ ضَامِنٌ، وَالرِّبْحُ لِصَاحِبِ الْمَالِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21366","","","كتاب البيوع والأقضية"
"21367","(۲۱۳۶۷) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : الرِّبْحُ عَلَی مَا اشْتَرَطَا عَلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21367","","","كتاب البيوع والأقضية"
"21368","(۲۱۳۶۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ إِیاسِ بنِ مُعَاویۃ ، قَالَ : ہُوَ ضَامِنٌ ، وَالرِّبْحُ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 21368","","","كتاب البيوع والأقضية"
"21369","(۲۱۳۶۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ فُضَیْلِ بْنِ عَمْرٍو ، عَنْ شُرَیْحٍ ، قَالَ : مَنْ ضَمِنَ مَالاً ، فَلہُ رِبْحُہُ۔","","Musannaf Ibn Abi Shaybah 21369","","","كتاب البيوع والأقضية"
"21370","(۲۱۳۷۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنْ دَاوُدَ، عَنِ الشَّعْبِیِّ، عَنْ شُرَیْحٍ، مِثْلَہُ، قَالَ: وَقَالَ الشَّعْبِیُّ: یَتَصَدَّقَانِ بِالْفَضْلِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21370","","","كتاب البيوع والأقضية"
"21371","(۲۱۳۷۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ ریَاحِ بْنِ عَبِیْدَۃَ ، أَنَّ رَجُلاً بَعَثَ مَعَہُ بِبِضَاعَۃٍ ، فَلَمَّا کَانَ بِبَعْضِ الطَّرِیقِ رَأَی شَیْئًا یُبَاعُ ، فَأَشْہَدَ أَنَّہُ ضَامِنٌ لِلْبِضَاعَۃِ ، ثُمَّ اشْتَرَی بِہَا ذَلِکَ الشَّیْئَ ، فَلَمَّا قَدِمَ الْمَدِینَۃَ بَاعَ الَّذِی اشْتَرَی فَرَبِحَ ، فَسَأَلَ ابْنَ عُمَرَ عَنْ ذَلِکَ فَقَالَ : الرِّبْحُ لِصَاحِبِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 21371","","","كتاب البيوع والأقضية"
"21372","(۲۱۳۷۲) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، قَالَ : قُلْتُ لِعِکْرِمَۃَ : لِمَ کُرِہَ کَسْبُ الْحَجَّامِ ، قَالَ : لاَ یُکْرَہُ۔","","Musannaf Ibn Abi Shaybah 21372","","","كتاب البيوع والأقضية"
"21373","(۲۱۳۷۳) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، عَنْ رَجُلٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : لَوْلا أَنَّ الْحَجَّامَ یَمَصُّ الدَّمَ لَمْ أَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 21373","","","كتاب البيوع والأقضية"
"21374","(۲۱۳۷۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ زَیْدٍ أَبِی أُسَامَۃَ ، قَالَ : سَأَلْتُ سَالِمًا وَالْقَاسِمَ عْن کَسْبِ الْحَجَّامِ فَلَمْ یَرَیَا بِہِ بَأْسًا ، وَتَلَوَا : {قُلْ لاَ أَجِدُ ??ِیمَا أُوحِیَ إلَیَّ مُحَرَّمًا عَلَی طَاعِمٍ یَطْعَمُہُ} الآیَۃَ۔","","Musannaf Ibn Abi Shaybah 21374","","","كتاب البيوع والأقضية"
"21375","(۲۱۳۷۵) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ الْوَلِیدِ بْنِ عِیسَی ، عَنْ أَبِیہِ ، أَنَّ عُثْمَانَ بْنَ عَفَّانَ قَالَ : مَا تُعْجِبُنِی غَلَّۃُ الْحَجَّامِ وَالْحَمَّامِ۔","Da'if","Musannaf Ibn Abi Shaybah 21375","","","كتاب البيوع والأقضية"
"21376","(۲۱۳۷۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، قَالَ : کَانَ لِلْحَارِثِ غُلاَمٌ حَجَّامٌ۔","","Musannaf Ibn Abi Shaybah 21376","","","كتاب البيوع والأقضية"
"21377","(۲۱۳۷۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، أَنَّہُ سُئِلَ عَنْ کَسْبِ الْحَجَّامِ فَلَمْ یَرَ بِہِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 21377","","","كتاب البيوع والأقضية"
"21378","(۲۱۳۷۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ حَرَامِ بْنِ سَعْدِ بْنِ مُحَیِّصَۃَ ، أَنَّ أَبَاہُ سَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ کَسْبِ الْحَجَّامِ ، فَنَہَاہُ عَنْہُ فَلَمْ یَزَلْ یُکَلِّمُہُ حَتَّی قَالَ : اعْلِفْہُ نَاضِحَک ، أَوْ أَطْعِمْہُ رَقِیقَک۔n(ابوداؤد ۳۴۱۵۔ احمد ۵/۴۳۶)","","Musannaf Ibn Abi Shaybah 21378","","","كتاب البيوع والأقضية"
"21379","(۲۱۳۷۹) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : احْتَجَمَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَجَمَہُ أَبُو طَیْبَۃَ ، فَأَعْطَاہُ صَاعَیْنِ مِنْ طَعَامٍ وَکَلَّمَ أَہْلَہُ ، فَخَفَّفُوا عَنْہُ مِنْ غَلَّتِہِ۔ (بخاری ۶۵۹۶۔ مسلم ۶۲)","Sahih","Musannaf Ibn Abi Shaybah 21379","","","كتاب البيوع والأقضية"
"21380","(۲۱۳۸۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ أَبَا طَیْبَۃَ حَجَمَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَأَلَہُ : کَمْ خَرَاجُک ؟ قَالَ : ثَلاَثَۃُ آصُعٍ ، قَالَ : فَوَضَعَ عَنْہُ مِنْ خَرَاجِہِ صَاعًا وَأَعْطَاہُ أَجْرًا۔n(احمد ۳/۳۵۳۔ ابویعلی ۱۷۷۱)","Da'if","Musannaf Ibn Abi Shaybah 21380","","","كتاب البيوع والأقضية"
"21381","(۲۱۳۸۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عَطَائٍ ، قَالَ : کَانَ لاَ یَرَی بِکَسْبِ الْحَجَّامِ بالجَلَمین بَأْسًا۔","","Musannaf Ibn Abi Shaybah 21381","","","كتاب البيوع والأقضية"
"21382","(۲۱۳۸۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : احْتَجَمَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَآجَرَ الْحَجَّامَ ، وَلَوْ کَانَ حَرَامًا لَمْ یُعْطِہِ۔ (بخاری ۲۱۰۳۔ ابوداؤد ۳۴۱۶)","Da'if","Musannaf Ibn Abi Shaybah 21382","","","كتاب البيوع والأقضية"
"21383","(۲۱۳۸۳) حَدَّثَنَا مُحَمَّدُ بْنُ مُیَسَّرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : دَخَلْتُ عَلَی ابْنِ عَبَّاسٍ وَغُلاَمٌ لَہُ یَحْجُمُہُ قَالَ : فَقُلتُ : یَا أبَا عَبَّاسٍ ! مَا تَصْنَعُ بِخَرَاجِ ہَذَا ؟ قَالَ : آکُلُہُ وَأُوکِلُہُ ، وَأَشَارَ بِیَدِہِ إلَی فِیہِ۔","Da'if","Musannaf Ibn Abi Shaybah 21383","","","كتاب البيوع والأقضية"
"21384","(۲۱۳۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو جَنَابٍ ، عَنْ أَبِی جَمِیلَۃَ الطُّہَوِیِّ ، قَالَ : سَمِعْتُ عَلِیًّا یَقُولُ : احْتَجَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ثُمَّ قَالَ لِلْحَجَّامِ حِینَ فَرَغَ : کَمْ خَرَاجُک ؟ قَالَ : صَاعَانِ ، قَالَ : فَوَضَعَ عَنْہُ صَاعًا ، فَأَمَرَنِی فَأَعْطَیْتہ صَاعًا۔ (ابن ماجہ ۲۱۶۳۔ احمد ۱/۹۰)","Da'if","Musannaf Ibn Abi Shaybah 21384","","","كتاب البيوع والأقضية"
"21385","(۲۱۳۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ ابْنِ سِیرِینَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : احْتَجَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَآجَرَہُ ، وَلَوْ کَانَ بِہِ بَأْسٌ لَمْ یُعْطِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 21385","","","كتاب البيوع والأقضية"
"21386","(۲۱۳۸۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُوسَی بْنُ عُلَیِّ بْنِ رَبَاحٍ ، عَنْ أَبِیہِ ، قَالَ : کُنْتُ عِنْدَ ابْنِ عَبَّاسٍ فَأَتَتْہُ امْرَأَۃ، فَقَالَتْ : إنِّی امْرَأَۃٌ مِنْ أَہْلِ الْعِرَاقِ وَلِی غُلاَمٌ حَجَّامٌ ، وَیَزْعُمُ أَہْلُ الْعِرَاقِ أَنِّی آکُلُ ثَمَنَ الدَّمِ ، فَقَالَ : إنَّہُمْ لاَ یَزْعُمُونَ شَیْئًا ، إنَّمَا تَأْکُلِینَ خَرَاجَ غُلاَمِکَ ، وَلَسْت تَأْکُلِینَ ثَمَنَ الدَّمِ۔q","Sahih","Musannaf Ibn Abi Shaybah 21386","","","كتاب البيوع والأقضية"
"21387","(۲۱۳۸۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُمَرُ بْنُ فَرُّوخَ ، عَنْ حَبِیبِ بْنِ الزُّبَیْرِ ، عَنْ عِکْرِمَۃَ : احْتَجَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَعْطَی الْحَجَّامَ عُمَالَتَہُ دِینَارًا۔ (طبرانی ۷۸۳۰)","","Musannaf Ibn Abi Shaybah 21387","","","كتاب البيوع والأقضية"
"21388","(۲۱۳۸۸) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا معمر ابْنُ سام، عَنْ أَبِی جَعْفَرٍ، قَالَ: لاَ بَأْسَ أَنْ یَحْتَجِمَ الرَّجُلُ، وَلاَ یُشَارِطُ۔","","Musannaf Ibn Abi Shaybah 21388","","","كتاب البيوع والأقضية"
"21389","(۲۱۳۸۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ ، عَنْ سَعِیدٍ ، قَالَ ، سَمِعْت أَبَا ہُرَیْرَۃَ یَقُولُ : ہُوَ سُحْتٌ۔","Sahih","Musannaf Ibn Abi Shaybah 21389","","","كتاب البيوع والأقضية"
"21390","(۲۱۳۹۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ سُفْیَان ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ کَسْبَ الْحَجَّامِ۔","","Musannaf Ibn Abi Shaybah 21390","","","كتاب البيوع والأقضية"
"21391","(۲۱۳۹۱) حَدَّثَنَا وکیع قَالَ : حدثنا ابْنُ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ کَسْبِ الْحَجَّامِ۔","Da'if","Musannaf Ibn Abi Shaybah 21391","","","كتاب البيوع والأقضية"
"21392","(۲۱۳۹۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ عَبْدِ الْجَبَّارِ بْنِ عَبَّاسٍ ، عَنْ عَوْنِ بْنِ أَبِی جُحَیْفَۃَ : أَنَّ أَبَاہُ اشْتَرَی غُلاَمًا لَہُ حَجَّامًا فَکَسَرَ مَحَاجِمَہُ ، وَقَالَ : نَہَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ ثَمَنِ الدَّمِ۔","Hasan","Musannaf Ibn Abi Shaybah 21392","","","كتاب البيوع والأقضية"
"21393","(۲۱۳۹۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا ہِشَامُ بنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، أَنَّ غِلْمَۃً مِنَ الأَنْصَارِ کَانَ لَہُمْ غُلاَمٌ حَجَّامٌ ، فَأَمَرَہُمُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یَجْعَلُوا کَسْبَہُ فِی عَلْفِ النَّاضِحِ۔","","Musannaf Ibn Abi Shaybah 21393","","","كتاب البيوع والأقضية"
"21394","(۲۱۳۹۴) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا أَبَانُ الْعَطَّارُ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ اللہِ بْنِ قَارِظٍ ، عَنِ السَّائِبِ بْنِ یَزِیدَ ، عَنْ رَافِعِ بْنِ خَدِیجٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : کَسْبُ الْحَجَّامِ خَبِیثٌ، وَمَہْرُ الْبَغِیِّ خَبِیثٌ ، وَثَمَنُ الْکَلْبِ خَبِیثٌ۔","Sahih","Musannaf Ibn Abi Shaybah 21394","","","كتاب البيوع والأقضية"
"21395","(۲۱۳۹۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ وَأَبِی ہَاشِمٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ کَسْبَ الْحَجَّامِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21395","","","كتاب البيوع والأقضية"
"21396","(۲۱۳۹۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ اللہِ بْنِ عَطَائٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : جَائَتِ امْرَأَۃٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : إنِّی تَصَدَّقْت عَلَی أُمِّی بِجَارِیَۃٍ فَمَاتَتْ أُمِّی وَبَقِیَتِ الْجَارِیَۃُ فَقَالَ لَہَا: وَجَبَ أَجْرُک ، وَرَجَعَتْ إلَیْک فِی الْمِیرَاثِ۔ (مسلم ۸۰۵۔ ابوداؤد ۱۶۵۳)","Sahih","Musannaf Ibn Abi Shaybah 21396","","","كتاب البيوع والأقضية"
"21397","(۲۱۳۹۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، أَنَّ رَجُلاً مِنْہُمْ تَصَدَّقَ عَلَی أُمِّہِ بِأَمَۃٍ فَکَاتَبَتْہَا ، ثُمَّ تُوُفِّیَتْ أُمُّہُ ، فَسَأَلَ عِمْرَانَ بْنَ حُصَیْنٍ فَقَالَ : أَنْتَ تَرِثُ أُمَّک ، وَإِنْ شِئْتَ وَجَّہْتہَا فِی الْوَجْہِ الَّذِی کُنْتَ وَجَّہَتْہَا فِیہِ ، قَالَ حُمَیْدٌ : فَلَقَدْ رَأَیْتہَا یُقَالُ لَہَا لَبِیبَۃ۔","","Musannaf Ibn Abi Shaybah 21397","","","كتاب البيوع والأقضية"
"21398","(۲۱۳۹۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ، عَنْ عُمَرَ بْنِ عَامِرٍ، عَنْ قَتَادَۃَ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ؛ فِی الرَّجُلِ یَتَصَدَّقُ بِالصَّدَقَۃِ، ثُمَّ یَرِثُہَا ، قَالَ : إذَا رَدَّہَا إلَیْہِ کِتَابُ اللہِ فَلاَ بَأْسَ بِہَا ، قَالَ : وَقَالَ قَتَادَۃُ : کَانَ ابْنُ مَسْعُودٍ یَقُولُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 21398","","","كتاب البيوع والأقضية"
"21399","(۲۱۳۹۹) حَدَّثَنَا ہُشَیْمُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَقُولُ فِی الصَّدَقَۃِ إذَا وَرِثَہَا : قَالَ : یَجْعَلُہَا فِی مِثْلِ الْوَجْہِ الَّذِی کَانَتْ فِیہِ۔","","Musannaf Ibn Abi Shaybah 21399","","","كتاب البيوع والأقضية"
"21400","(۲۱۴۰۰) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الْعَوَّامِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ مِثْلَ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21400","","","كتاب البيوع والأقضية"
"21401","(۲۱۴۰۱) حَدَّثَنَا ہِشَامٌ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَأْکُلَہَا۔","","Musannaf Ibn Abi Shaybah 21401","","","كتاب البيوع والأقضية"
"21402","(۲۱۴۰۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَأْکُلَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 21402","","","كتاب البيوع والأقضية"
"21403","(۲۱۴۰۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ سَیَّارٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : کُلْ فَإِنَّ اللَّہَ لَمْ یَکُنْ لِیُطْعِمَک حَرَامًا۔","No Data Available","Musannaf Ibn Abi Shaybah 21403","","","كتاب البيوع والأقضية"
"21404","(۲۱۴۰۴) حَدَّثَنَا ہُشَیْمٌ، عَنْ دَاوُدَ، عَنْ عَامِرٍ، عَنْ مَسْرُوقٍ، قَالَ: مَا رَدَّ عَلَیْک سِہَامُ الْفَرَائِضِ ، فَہُوَ لَکَ حَلاَلٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 21404","","","كتاب البيوع والأقضية"
"21405","(۲۱۴۰۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْعَوَّامِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، أَنَّ عُمَرَ کَانَ إذَا کَانَتْ صَدَقَۃٌ فَرَدَّہَا عَلَیْہِ حَقٌّ یَرَی أَنْ یُوَجِّہَہَا فِی مِثْلِ مَا کَانَتْ فِیہِ۔","","Musannaf Ibn Abi Shaybah 21405","","","كتاب البيوع والأقضية"
"21406","(۲۱۴۰۶) حَدَّثَنَا یَزِیدُ ، عَنِ الْعَوَّامِ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا رَدَّہَا إلَیْہِ حَقٌّ فَلاَ بَأْسَ۔","Sahih","Musannaf Ibn Abi Shaybah 21406","","","كتاب البيوع والأقضية"
"21407","(۲۱۴۰۷) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ؛ فِی الرَّجُلِ یَتَصَدَّقُ بِالصَّدَقَۃِ ، ثُمَّ یَرِثُہَا ، قَالَ : إنَّ السِّہَامَ لَمْ تَزِدْہَا إلاَّ حَلاَلاً۔","","Musannaf Ibn Abi Shaybah 21407","","","كتاب البيوع والأقضية"
"21408","(۲۱۴۰۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَتَصَدَّقُ بِالصَّدَقَۃِ ، ثُمَّ تَرْجِعُ إلَیْہِ فِی الْمِیرَاثِ ، قَالَ : یَجْعَلُہَا مِنْ حِصَّۃِ غَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 21408","","","كتاب البيوع والأقضية"
"21409","(۲۱۴۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مُزَرِّعٍ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ عَنْہَا فَقَالَ : إِنْ أَخَذَہَا فَلاَ بَأْسَ ، وَإِنْ أَمْضَاہَا أَفْضَلُ۔","","Musannaf Ibn Abi Shaybah 21409","","","كتاب البيوع والأقضية"
"21410","(۲۱۴۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَجْعَلُہَا فِی مِثْلِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 21410","","","كتاب البيوع والأقضية"
"21411","(۲۱۴۱۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، قَالَ ، قَالَ عُمَرُ : السَّائِبَۃُ وَالصَّدَقَۃُ لِیَوْمِہِمَا۔n(عبدالرزاق ۱۶۲۲۹)","Sahih","Musannaf Ibn Abi Shaybah 21411","","","كتاب البيوع والأقضية"
"21412","أخْبَرَنَا عَبْدُ اللہِ بْنُ یُونُسَ ، قَالَ : حدَّثَنَا أبوعَبْدِ الرَّحْمَنِ بَقِیُّ بْنُ مَخْلَدٍ ، قَالَ : حَدَّثَنَا أَبُو بَکْرٍ عَبْدُ اللہِ بْنُ مُحَمَّدِ بْنِ أَبِی شَیْبَۃَ ، قَالَ :n (۲۱۴۱۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ مُحَمَّدِ بْنِ زَیْدٍ ، عَنِ ابْنِ عُمَرَ ؛ فِی الرَّجُلِ یُقْرِضُ الرَّجُلَ الدَّرَاہِم ثُمَّ یَأْخُذْ بِقِیمَتِہَا طَعَامًا : أَنَّہُ کَرِہَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 21412","","","كتاب البيوع والأقضية"
"21413","(۲۱۴۱۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ وَحَمَّادٍ وعِکْرِمَۃَ ، قَالوا : کَانُوا لاَ یَرَوْنَ بِذَلِکَ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 21413","","","كتاب البيوع والأقضية"
"21414","(۲۱۴۱۴) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : إذَا کَانَ أَصْلُ الْحَقِّ دَیْنًا فَلاَ تَأْخُذْ مِنْہُ إلاَّ مَا بِعْتہ بِہِ ، فَإِذَا کَانَ قَرْضًا فَلاَ یَضُرُّک أَنْ تَأْخُذَ غَیْرَ مَا أَقْرَضْتَہُ۔","","Musannaf Ibn Abi Shaybah 21414","","","كتاب البيوع والأقضية"
"21415","(۲۱۴۱۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ إذَا کَانَ لِلرَّجُلِ عَلَی الرَّجُلِ الدَّرَاہِمَ فَأَتَاہُ فَتَقَاضَاہُ فَقَالَ : خُذْ بِحَقِّکَ شَعِیرًا ، أَوْ حِنْطَۃً ، أَوْ تَمْرًا ، أَوْ شَیْئًا غَیْرَ الذَّہَبِ ، قَالَ : إذَا کَانَتْ دَرَاہِمُہُ قَرْضًا فَإِنَّہُ یَأْخُذُ بِہَا مَا شَائَ۔","","Musannaf Ibn Abi Shaybah 21415","","","كتاب البيوع والأقضية"
"21416","(۲۱۴۱۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدِ الْقَطَّانُ ، عَنِ ابْنِ حَرْمَلَۃَ ، قَالَ : بِعْت جُزُورًا بِدَرَاہِمَ إلَی الْحَصَادِ ، فَلَمَّا حَلَّ قَضَوْنِی الْحِنْطَۃَ وَالشَّعِیرَ وَالسُّلْتَ فَسَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ فَقَالَ : لاَ یَصْلُحُ ، لاَ تَأْخُذْ إلاَّ دَرَاہِمَ۔","","Musannaf Ibn Abi Shaybah 21416","","","كتاب البيوع والأقضية"
"21417","(۲۱۴۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ مُیَسَّر ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : إذَا کَانَ لِلرَّجُلِ عَلَی الرَّجُلِ الدَّیْنُ فَلاَ بَأْسَ أَنْ یَشْتَرِیَ مِنْہُ عَبْدًا رَخِیصًا۔","Da'if","Musannaf Ibn Abi Shaybah 21417","","","كتاب البيوع والأقضية"
"21418","(۲۱۴۱۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ مَوْہَبٍ، عَنْ حَفْص أَبِی الْمُعْتَمِرِ، عَنْ أَبِیہِ، أَنَّ عَلِیًّا ، قَالَ : لاَ بَأْسَ أَنْ یُعْطِیَ الْمَالَ بِالْمَدِینَۃِ وَیَأْخُذَ بِإِفْرِیقِیَّۃَ","Da'if","Musannaf Ibn Abi Shaybah 21418","","","كتاب البيوع والأقضية"
"21419","(۲۱۴۱۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِالرَّحْمَنِ بْنِ مَوْہَبٍ، عَنْ حَفْص أبی الْمُعْتَمِرِ، عَنْ أَبِیہِ، عَنْ عَلِیٍّ بِنَحْوِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 21419","","","كتاب البيوع والأقضية"
"21420","(۲۱۴۲۰) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، وَابْنِ الزُّبَیْرِ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا أَنْ یُؤْخَذَ الْمَالُ بِأَرْضِ الْحِجَازِ وَیُعْطَی بِأَرْضِ الْعِرَاقِ ، وَیُؤْخَذَ بِأَرْضِ الْعِرَاقِ وَیُعْطَی بِأَرْضِ الْحِجَازِ۔","","Musannaf Ibn Abi Shaybah 21420","","","كتاب البيوع والأقضية"
"21421","(۲۱۴۲۱) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، أَنَّہُ لَمْ یَرَی بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 21421","","","كتاب البيوع والأقضية"
"21422","(۲۱۴۲۲) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی مِسْکِینٍ وَخَارِجَۃَ ، عَمَّنْ حَدَّثَہُ ، عَنِ الْحَسَنِ بْنِ عَلِیٍّ ، أَنَّہُ کَانَ یَأْخُذُ الْمَالَ بِالْحِجَازِ وَیُعْطِیہِ بِالْعِرَاقِ ، أَوْ بِالْعِرَاقِ وَیُعْطِیہِ بِالْحِجَازِ۔","Da'if","Musannaf Ibn Abi Shaybah 21422","","","كتاب البيوع والأقضية"
"21423","(۲۱۴۲۳) حَدَّثَنَا حَفْصٌ، عَنْ حَجَّاجٍ، قَالَ: کَانَ عَبْدُ الرَّحْمَنِ بْنُ الأَسْوَدِ یَأْخُذُ الدَّرَاہِمَ بِالْحِجَازِ وَیُعْطِیہِ بِالْعِرَاقِ۔","","Musannaf Ibn Abi Shaybah 21423","","","كتاب البيوع والأقضية"
"21424","(۲۱۴۲۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَدْفَعَ الدَّرَاہِمَ بِالْبَصْرَۃِ وَیَأْخُذَہَا بِالْکُوفَۃِ۔","","Musannaf Ibn Abi Shaybah 21424","","","كتاب البيوع والأقضية"
"21425","(۲۱۴۲۵) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : لاَ بَأْسَ بِالسَّفْتَجَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21425","","","كتاب البيوع والأقضية"
"21426","(۲۱۴۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی العُمَیْسِ ، عَنْ یَزِیدَ بْنِ جُعْدُبَۃَ ، عَنْ عُبَیْدِ بْنِ السَّبَّاقِ ، عَنْ زَیْنَبَ الثَّقَفِیَّۃِ امْرَأَۃِ عَبْدِ اللہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَعْطَاہَا جُذَاذَ خَمْسِینَ وَسْقًا تَمْرًا وَعِشْرِینَ وَسْقًا شَعِیرًا ، فَقَالَ لَہَا عَاصِمُ بْنُ عَدِیٍّ : إِنْ شِئْتَ وَفَّیْتُکِیہَا ہُنَا بِالْمَدِینَۃِ وَتُوفِینہَا بِخَیْبَرَ ، فَقَالَتْ : حَتَّی أَسْأَلَ أَمِیرَ الْمُؤْمِنِینَ عُمَرَ ، فَسَأَلَتْہُ فَقَالَ : وَکَیْفَ بِالضَّمَانِ ؟۔ (عبدالرزاق ۱۴۶۴۳)","Da'if","Musannaf Ibn Abi Shaybah 21426","","","كتاب البيوع والأقضية"
"21427","(۲۱۴۲۷) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، أَنَّ ابْنَ الزُّبَیْرِ کَانَ یُعْطِی التُّجَّارَ الْمَالَ ہَاہُنَا وَیَأْخُذُ مِنْہُمْ بِأَرْضٍ أُخْرَی ، فَذُکِرَ ، أَوْ ذَکَرْتُ ذَلِکَ لابْنِ عَبَّاسٍ فَقَالَ : لاَ بَأْسَ مَا لَمْ یَشْتَرِطْ۔","","Musannaf Ibn Abi Shaybah 21427","","","كتاب البيوع والأقضية"
"21428","(۲۱۴۲۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِالسَّفْتَجَۃِ ، وَکَانَ مَیْمُونُ بْنُ أَبِی شَبِیبٍ یَکْرَہُہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 21428","","","كتاب البيوع والأقضية"
"21429","(۲۱۴۲۹) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ الرُّؤَاسِیُّ ، عَنْ دِینَارٍ ، قَالَ : سَأَلْتُ الْحَسَنَ : أُعْطِی الصَّرَّافَ الدِّرْہَمَ بِالْبَصْرَۃِ وَآخُذُ السَّفْتَجَۃَ ، آخُذُ مِثْلَ دَرَاہِمِی بِالْکُوفَۃِ ، فَقَالَ : أنَّمَا یُفْعَلُ ذَلِکَ مِنْ أَجْلِ اللُّصُوصِ ، لاَ خَیْرَ فِی قَرْضٍ جَرَّ مَنْفَعَۃً۔","","Musannaf Ibn Abi Shaybah 21429","","","كتاب البيوع والأقضية"
"21430","(۲۱۴۳۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَقُولُ : تجوز شَہَادَۃُ الصِّبْیَانِ بَعْضِہمْ عَلَی بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 21430","","","كتاب البيوع والأقضية"
"21431","(۲۱۴۳۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عن الشیبانی ، عن الشعبی ، عن شریح : أنہ کان یجیز شہادۃ الصبیان ، بعضہم علی بیع بعض۔","","Musannaf Ibn Abi Shaybah 21431","","","كتاب البيوع والأقضية"
"21432","(۲۱۴۳۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ یَقُولُ : تَجُوزُ شَہَادَۃُ الصِّبْیَانِ وَیُؤْخَذُ بِأَوَّلِ قَوْلِہِمْ۔","","Musannaf Ibn Abi Shaybah 21432","","","كتاب البيوع والأقضية"
"21433","(۲۱۴۳۳) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنِ ابْنِ عَبَّاسٍ فِی شَہَادَۃِ الصِّبْیَانِ: قَالَ اللَّہُ تَعَالَی: {مِمَّنْ تَرْضَوْنَ مِنَ الشُّہَدَائِ} وَلَیْسُوا مِمَّنْ یُرْضَی ، قَالَ ابْنُ الزُّبَیْرِ : ہُمْ أَحْرَی إذَا سُئِلُوا عَمَّا رَأَوْا أَنْ یَشْہَدُوا ، وقَالَ ابْنُ أَبِی مُلَیْکَۃَ : فَمَا رَأَیْت الْقُضَاۃَ أَخَذَتْ إلاَّ بِقَوْلِ ابْنِ الزُّبَیْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 21433","","","كتاب البيوع والأقضية"
"21434","(۲۱۴۳۴) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ الصِّبْیَانِ عَلَی الْکِبَارِ ، وَتَجُوزُ شَہَادَۃُ الصِّبْیَانِ بَعْضِہِمْ عَلَی بَعْضٍ إذَا فُرِّقَ بَیْنَہُمْ۔","","Musannaf Ibn Abi Shaybah 21434","","","كتاب البيوع والأقضية"
"21435","(۲۱۴۳۵) حَدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ شُرَیْحٍ ، أَنَّہُ کَانَ یُجِیزُ شَہَادَۃَ الصِّبْیَانِ فی السِّنِّ وَالْمُوضِحَۃِ ، وَیَأباہُمْ فِیمَا سِوَی ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 21435","","","كتاب البيوع والأقضية"
"21436","(۲۱۴۳۶) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ أَبِی بَکْرِ بْنِ مَرْیَمَ ، قَالَ : سَمِعْتُ مَکْحُولاً یَقُولُ : إذَا بَلَغَ الْغُلاَمُ خَمْسَۃَ عَشَرَ جَازَتْ شَہَادَتُہُ۔","","Musannaf Ibn Abi Shaybah 21436","","","كتاب البيوع والأقضية"
"21437","(۲۱۴۳۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ دَاوُدَ بْنِ الْحُصَیْنِ ، قَالَ : شہد غُلاَم عِنْدَ قَاضٍ مِنْ قُضَاۃِ أَہْلِ الْمَدِینَۃِ یُقَالُ لَہُ سَلَمَۃُ بْنُ عَبْدِ الرَّحْمَنِ الْمَخْزُومِیُّ ، فَأَرْسَلَ إلَی سَالِم وَالْقَاسِمِ فَسَأَلَہُمَا عَنْ شَہَادَتِہِ ، قَالاَ : إِنْ کَانَ أَنْبَتَ فَأَجِزْ شَہَادَتَہُ۔","","Musannaf Ibn Abi Shaybah 21437","","","كتاب البيوع والأقضية"
"21438","(۲۱۴۳۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنِ ابْنِ عَوْنٍ، عَنِ ابْنِ سِیرِینَ، أَنَّہُ قَالَ فِی شَہَادَۃِ الصِّبْیَانِ: تُکْتَبُ شَہَادَتُہُمْ وَیُسْتَثْبَتُونَ۔","","Musannaf Ibn Abi Shaybah 21438","","","كتاب البيوع والأقضية"
"21439","(۲۱۴۳۹) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : یسْتَثْبَتُونَ۔","","Musannaf Ibn Abi Shaybah 21439","","","كتاب البيوع والأقضية"
"21440","(۲۱۴۴۰) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ الصَّبِیِّ۔","","Musannaf Ibn Abi Shaybah 21440","","","كتاب البيوع والأقضية"
"21441","(۲۱۴۴۱) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ الصِّغَارِ حَتَّی یَکْبُرُوا۔","","Musannaf Ibn Abi Shaybah 21441","","","كتاب البيوع والأقضية"
"21442","(۲۱۴۴۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَبِی سَہْلٍ ، عَنْ عَامِرٍ ، قَالَ : کَانَ لاَ یُجِیزُ شَہَادَۃَ الصَّبی۔","","Musannaf Ibn Abi Shaybah 21442","","","كتاب البيوع والأقضية"
"21443","(۲۱۴۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ سُلَیْمَانَ الْہَمْدَانِیِّ ، قَالَ : شَہِدْت عِنْدَ شُرَیْحٍ وَأَنَا غُلاَمٌ فَقَالَ : بِإِصْبَعِہِ فِی بَعْضِ جَسَدِی : حَتَّی تَبْلُغَ۔","","Musannaf Ibn Abi Shaybah 21443","","","كتاب البيوع والأقضية"
"21444","(۲۱۴۴۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : شَہِدَ عِنْدَ ابْنِ أَبِی لَیْلَی صِبْیَانٌ مِنَ الْحَیِّ لَمْ یَبْلُغُوا ، فَقَالَ : اکْتُبْ : شَہِدَ فُلاَنٌ وَفُلاَنٌ وَہُمْ صِغَارٌ لَمْ یَبْلُغُوا ، فَإِذَا بَلَغُوا فَإِنْ ثَبَتُوا عَلَی شَہَادَتِہِم جَازَتْ ، وَإِنْ رَجَعُوا فَلَیْسَ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 21444","","","كتاب البيوع والأقضية"
"21445","(۲۱۴۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، عَنِ الشَّعْبِیِّ ، أَنَّہُ کَانَ یُجِیزُ شَہَادَۃَ الصِّبْیَانِ وَیُرْسِلُ إلَیْہِمْ فَیَسْأَلُہُمْ عَنْہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 21445","","","كتاب البيوع والأقضية"
"21446","(۲۱۴۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ شُرَیْحٍ ، أَنَّہُ أَجَازَ شَہَادَۃَ غِلْمَانَ فِی آمَّۃٍ ، وَقَضَی فِیہَا بِأَرْبَعَۃِ آلاَفٍ۔","","Musannaf Ibn Abi Shaybah 21446","","","كتاب البيوع والأقضية"
"21447","(۲۱۴۴۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدِ الْقَطَّانُ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، عَنْ عَلِیٍّ ، أَنَّہُ کَانَ یُجِیزُ شَہَادَۃَ الصِّبْیَانِ بَعْضِہِمْ عَلَی بَعْضٍ۔","Hasan","Musannaf Ibn Abi Shaybah 21447","","","كتاب البيوع والأقضية"
"21448","(۲۱۴۴۸) حَدَّثَنَا شَرِیکٌ ، عَنْ سِمَاکٍ ، عَنِ ابن عَبیدِ بْنِ الأَبْرَصِ ، أَنَّ عَلِیًّا ضَمَّنَ نَجَّارًا۔","Da'if","Musannaf Ibn Abi Shaybah 21448","","","كتاب البيوع والأقضية"
"21449","(۲۱۴۴۹) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ طَلْحَۃَ بْنِ أَبِی سَعِیدٍ ، قَالَ : سَمِعْتُ بُکَیْر بْنَ عَبْدِ اللہِ بْنِ الأَشَجِّ یُحَدِّثُ ، أَنَّ عُمَرَ بْنِ الْخَطَّابِ ضَمَّنَ الصُّنَّاعَ الَّذِینَ انْتَصَبُوا لِلنَّاسِ فِی أَعْمَالِہِمْ مَا أَہْلَکُوا فِی أَیْدِیہِمْ۔","","Musannaf Ibn Abi Shaybah 21449","","","كتاب البيوع والأقضية"
"21450","(۲۱۴۵۰) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، أَنَّہُ کَانَ یُضَمِّنُ الْقَصَّارَ وَالصَّوَّاغَ ، وَقَالَ : لاَ یُصْلِحُ النَّاسَ إلاَّ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 21450","","","كتاب البيوع والأقضية"
"21451","(۲۱۴۵۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ ، عَنْ شُرَیْحٍ ، أَنَّہُ کَانَ یُضَمِّنُ الْقَصَّارَ ، وَقَالَ : أَعْطِہِ ثَوْبَہُ ، أَوْ شَرْواہُ۔","","Musannaf Ibn Abi Shaybah 21451","","","كتاب البيوع والأقضية"
"21452","(۲۱۴۵۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ وَشُرَیْحٍ ، قَالَ : کَانَا یُضَمِّنَانِ الْقَصَّارَ شرواہ یَوْمَ أَخْذِہِ۔","","Musannaf Ibn Abi Shaybah 21452","","","كتاب البيوع والأقضية"
"21453","(۲۱۴۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ مَسْرُوقٍ وَشُرَیْحٍ ، أَنَّہُمَا قَالاَ فِی قَصَّارٍ خَرَقَ ثَوْبًا : یضْمَّنُ قِیمَتَہُ وَیَأْخُذُ ثَوْبَہُ إلَیْہِ۔","","Musannaf Ibn Abi Shaybah 21453","","","كتاب البيوع والأقضية"
"21454","(۲۱۴۵۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ قَالَ فِی الْقَصَّارِ إذَا أَفْسَدَ ، قَالَ : ہُوَ ضَامِنٌ ، قَالَ : وَکَانَ لاَ یُضَمِّنُہُ غَرَقًا ، وَلاَ حَرْقًا ، وَلاَ عَدُوًّا مُکَابِرًا۔","","Musannaf Ibn Abi Shaybah 21454","","","كتاب البيوع والأقضية"
"21455","(۲۱۴۵۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ الأَعْمَش ، قَالَ : أَمَرَنِی جَارٍ لِی قَصَّارٌ یُقَالُ لَہُ ثَابِتٌ : أسْأل لہ إِبْرَاہِیمَ : عَن رَجُلٍ أَعْطَی غُلاَمًا لَہُ ثَوْبًا فَضَاعَ فَسَأَلْتُہُ فَقَالَ : أَلَیْسَ یَعْلَمُ أَنَّہُ غُلاَمہ ؟ قُلْتُ : نَعَمْ ، قَالَ : ہُوَ ضَامِنٌ۔","","Musannaf Ibn Abi Shaybah 21455","","","كتاب البيوع والأقضية"
"21456","(۲۱۴۵۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ ، عَن حَائِکٍ مَشَی فِی غَزْلٍ بِشُعْلَۃٍ مِنْ نَارٍ ، فَوَقَعَتْ شَرَارَۃٌ فَأَحْرَقَتِ الْغَزْلَ ، قَالَ : یضمَّنُ۔","","Musannaf Ibn Abi Shaybah 21456","","","كتاب البيوع والأقضية"
"21457","(۲۱۴۵۷) حَدَّثَنَا یَحْیَی بْنُ عَبْدِالْمَلِکِ بْنِ أَبِی غَنِیَّۃَ، عَنِ الْحَکَمِ، قَالَ: یضمَّنُ الصَّبَّاغُ وَالْقَصَّارُ وَکُلُّ أَجِیرٍ مُشْتَرَکٍ۔","","Musannaf Ibn Abi Shaybah 21457","","","كتاب البيوع والأقضية"
"21458","(۲۱۴۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ وَمُطَرِّفٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ یُضَمَّنُ الْقَصَّارُ إلاَّ مَا جَنَتْ یَدُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21458","","","كتاب البيوع والأقضية"
"21459","(۲۱۴۵۹) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ بْنِ مُوسَی ، عَنِ ابْنِ قُسَیْطٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، أَنَّ أَمَۃً أَتَتْ قَوْمًا فَغَرَّتْہُمْ وَزَعَمَتْ أَنَّہَا حُرَّۃٌ ، فَتَزَوَّجَہَا رَجُلٌ فَوَلَدَتْ مِنْہُ أَوْلاَدًا فَوَجَدُوہَا أَمَۃً ، فَقَضَی عُمَرُ بِقِیمَۃِ أَوْلاَدِہَا فِی کُلِّ مَغْرُورٍ غُرَّۃً۔","","Musannaf Ibn Abi Shaybah 21459","","","كتاب البيوع والأقضية"
"21460","(۲۱۴۶۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ، أَنَّ أَمَۃً أَتَتْ طَیّئاً فَزَعَمَتْ أَنَّہَا حُرَّۃٌ فَتَزَوَّجَہَا رَجُلٌ ، ثُمَّ إنَّ سَیِّدَہَا ظَہَرَ عَلَیْہَا فَقَضَی عُثْمَانُ أَنَّہَا وَأَوْلاَدَہَا لِسَیِّدِہَا ، وَجَعَلَ لِزَوْجِہَا مَا أَدْرَکَ مِنْ مَتَاعِہ، وَجَعَلَ فِیہِمَ السُّنَّۃَ ، أَوِ الْمِلَّۃَ : فِی کُلِّ رَأْسٍ رَأْسَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 21460","","","كتاب البيوع والأقضية"
"21461","(۲۱۴۶۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَأَلْتُہ ، عَنْ جَارِیَۃٍ أَبِقَتْ مِنْ أَرْضٍ إلَی أَرْضٍ أُخْرَی ، فَأَتَتْ قَوْمًا فَزَعَمَتْ أَنَّہَا حُرَّۃٌ ، فَرَغِبَ فِیہَا رَجُلٌ فَتَزَوَّجَہَا فَوَلَدَتْ أَوْلاَدًا ، ثُمَّ عَلِمُوا أَنَّہَا أَمَۃٌ ، فَجَائَ مَوْلاَہَا فَأَخَذَہَا ، قَالَ : یَأْخُذُ الْمَوْلَی أَمَتَہُ ، وَیَفْدِی الأَبُ أَوْلاَدَہُ بغُرَّۃٍ غرَّۃٍ۔","","Musannaf Ibn Abi Shaybah 21461","","","كتاب البيوع والأقضية"
"21462","(۲۱۴۶۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ ہِشَامِ بْنِ سَعْدٍ ، عَنْ شَیْبَۃَ بْنِ نِصَاحٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : فِی وَلَدِ کُلِّ مَغْرُورٍ غُرَّۃٌ۔","","Musannaf Ibn Abi Shaybah 21462","","","كتاب البيوع والأقضية"
"21463","(۲۱۴۶۳) حَدَّثَنَا مُحَمَّدُ أَبِی عَدِیٍّ ، عَنْ صَالِحِ بْنِ أَبِی الأَخْضَرِ ، عَنْ عَبَّادِ بْنِ سَعِیدٍ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ، قَالَ : مَنْ بَاعَ عَبْدًا ، أَوْ رَجُلاً مَحْجُورًا عَلَیْہِ فَمَالُہُ أَتْوَی۔","","Musannaf Ibn Abi Shaybah 21463","","","كتاب البيوع والأقضية"
"21464","(۲۱۴۶۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَتَی أَہْلَ سُوقِہِ فَأَعْلَمَہُمْ أَنَّہُ حَجَرَ عَلَیْہِ فَلَیْسَ لأَِحَدٍ أَنْ یُخَالِطَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21464","","","كتاب البيوع والأقضية"
"21465","(۲۱۴۶۵) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، قَالَ: إذَا حَجَرَ الرَّجُلُ عَلَی عَبْدِہِ فِی أَہْلِ سُوقِہِ لَمْ یَجُزْ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 21465","","","كتاب البيوع والأقضية"
"21466","(۲۱۴۶۶) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ کَانَ لاَ یَرَی فِی الْحَجْرِ شَیْئًا۔","No Data Available","Musannaf Ibn Abi Shaybah 21466","","","كتاب البيوع والأقضية"
"21467","(۲۱۴۶۷) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ بَکَّارٍ الْعَنَزیِّ ، أَنَّ رَجُلاً حَجَرَ عَلَی غُلاَمٍ لَہُ فَرُفِعَ إلَی عَلِیٍّ فَقَالَ : کُنْت تُرْسِلُہُ بِدِرْہَمٍ یَشْتَرِی بِہِ لَحْمًا ؟ قَالَ : نَعَمْ ، قَالَ : فَجَعَلَہُ مَأْذُونًا لَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 21467","","","كتاب البيوع والأقضية"
"21468","(۲۱۴۶۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یُحْجَرُ عَلَی حُرٍّ۔","No Data Available","Musannaf Ibn Abi Shaybah 21468","","","كتاب البيوع والأقضية"
"21469","(۲۱۴۶۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، قَالَ : شَہِدْت شُرَیْحًا وَأَتَاہُ رَجُلٌ ، مَعَہُ ابْنُ أَخِیہِ قَدَ اسْتَعْدَی عَلَیْہِ ، فَقَالَ الرَّجُلُ : إنَّ ابْنَ أَخِی یُکْثِرُ أَکْلَ السَّکَرَ ، یُعرِّضُ بِالشَّرَابِ ، قَالَ شُرَیْحٌ : أَمْسِکْ عَلَیْہِ مَالَہُ ، وَأَنْفِقْ عَلَیْہِ بِالْمَعْرُوفِ ، قَالَ : وَکَانَ ابْنُ أَخِیہِ قَدْ خَرَجَتْ لِحْیَتُہُ۔","","Musannaf Ibn Abi Shaybah 21469","","","كتاب البيوع والأقضية"
"21470","(۲۱۴۷۰) حَدَّثَنَا حَفْصٌ، عَنْ حَجَّاجٍ، عَنْ عَبْدِالْمَلِکِ بْنِ الْمُغِیرَۃِ، قَالَ: کَتَبَ نَجْدَۃُ إلَی ابْنِ عَبَّاسٍ یَسْأَلُہُ عَنِ الشَّیْخِ الْکَبِیرِ الَّذِی قَدْ ذَہَبَ عَقْلُہُ ، أَوْ أَنْکَرَ عَقْلُہُ ، فَکَتَبَ إلَیْہِ : إذَا ذَہَبَ عَقْلُہُ ، أَوْ أَنْکَرَ عَقْلُہُ حُجِرَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 21470","","","كتاب البيوع والأقضية"
"21471","(۲۱۴۷۱) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ نَحْوًا مِنْہُ۔","","Musannaf Ibn Abi Shaybah 21471","","","كتاب البيوع والأقضية"
"21472","(۲۱۴۷۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَلِیِّ بْنِ عَبْدِ الأَعْلَی ، عَنْ أَبِیہِ ، عَنْ شُرَیْحٍ ، أَنَّہُ کَانَ یَرُدُّ مِنَ الْحُمْقِ الْبَات۔","","Musannaf Ibn Abi Shaybah 21472","","","كتاب البيوع والأقضية"
"21473","(۲۱۴۷۳) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ زَیْدٍ أَبِی الْمُعَلَّی ، مَوْلًی لِبَنِی تَمِیمٍ ، قَالَ : شَہِدْت إیَاسَ بْنَ مُعَاوِیَۃَ واخْتُصِمَ إلَیْہِ فِی جَارِیَۃٍ ، فَقَالَ الرَّجُلُ : إنِّی اشْتَرَیْت مِنْ ہَذَا جَارِیَۃً فَوَجَدْتُہَا حَمْقَائَ ! قَالَ : مَا أَعْلَمُہُ یُرَدُّ مِنَ الْحُمْقِ ، فَقَالَ : إِنَّہُ حُمْقٌ کَالْجُنُونِ ، قَالَ : فَقَالَ لَہَا بِالْفَارِسِیَّۃِ : تَذْکُرِینَ لَیْلَۃَ وُلِدْتِ ؟ قَالَتْ : نَعَمْ ، قَالَ : فَقَالَ لَہَا : أَیَّ رِجْلَیْکِ أَطْوَلَ ؟ قَالَ : فَقَالَتْ بِإحدَی رِجْلَیْہَا : ہَذہ ، قَالَ : فَرَدَّہَا۔","","Musannaf Ibn Abi Shaybah 21473","","","كتاب البيوع والأقضية"
"21474","(۲۱۴۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ فِی الْہَوَجِ ، قَالَ : لاَ یُرَدُّ مِنْہُ إلاَّ أَنْ یَکُونَ شَیْئًا مَعْرُوفًا۔ یَعْنِی : حُمْقًا مَعْرُوفًا۔","","Musannaf Ibn Abi Shaybah 21474","","","كتاب البيوع والأقضية"
"21475","(۲۱۴۷۵) حَدَّثَنَا شَرِیکٌ ، عَنْ شَیْخٍ مِنَ الزَّعَافِرِ ، عَنْ مَسْرُوقٍ ، أَنَّہُ کَانَ یَرُدُّ مِنَ الصَّلَعِ۔","","Musannaf Ibn Abi Shaybah 21475","","","كتاب البيوع والأقضية"
"21476","(۲۱۴۷۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَمِعْتُہُ یُحَدِّثُ ، أَنَّ رَجُلاً اشْتَرَی مِنْ رَجُلٍ غُلاَمًا ، فَلَمَّا انْصَرَفَ بِہِ إذَا بِہِ قَرَعٌ ، فَخَاصَمَ صَاحِبَہُ إلَی شُرَیْحٍ ، قَالَ : فَقَالَ : إنِّی اشْتَرَیْت مِنْ ہَذَا ہَذَا الْغُلاَمَ وَبِہِ قَرَعٌ ، فَانْظُرْ إلَی قَرَعِہِ فَإِنَّ الْقَرَعَ لاَ یَحْدُثُ ، قَالَ : فَقَالَ شُرَیْحٌ : لاَ أَجْمَعُ أَنْ أَکُونَ قَاضِیًا وَشَاہِدًا ، أَرِہِ غَیْرِی ، ثُمَّ ائْتِنِی بِہِمْ فَلْیَشْہَدُوا لَکَ ، وَإِلاَّ فَیَمِینُہُ بِاللَّہِ : مَا بَاعَکَہُ وَبِہِ ہَذَا الْقَرَعُ۔","","Musannaf Ibn Abi Shaybah 21476","","","كتاب البيوع والأقضية"
"21477","(۲۱۴۷۷) حَدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، أَنَّ ابْنَ عُمَرَ وَزَیْدَ بْنَ ثَابِتٍ کَانَا لاَ یَرَیَانِ بَأْسًا بِشِرَاء الرَّزْقِ إذَا خَرَجَت الْقُطُوطُ ، وَہِیَ : الصِّکَاکُ ، وَیَقُولُونَ : لاَ تَبِعْہُ حَتَّی تَقْبِضَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 21477","","","كتاب البيوع والأقضية"
"21478","(۲۱۴۷۸) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن أَیُّوبَ ، عَنْ نَافِعٍ ، قَالَ : نُبِّئْت ، أَنَّ حَکِیمَ بْنَ حِزَامٍ کَانَ یَشْتَرِی صِکاک الرَّزْقِ ، فَنَہَی عُمَرُ أَنْ یَبِیعَ حَتَّی یَقْبِضَ۔","Da'if","Musannaf Ibn Abi Shaybah 21478","","","كتاب البيوع والأقضية"
"21479","(۲۱۴۷۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنْ عُمَرَ بِنَحْوِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 21479","","","كتاب البيوع والأقضية"
"21480","(۲۱۴۸۰) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : سُئِلَ عَامِرٌ عَنْ بَیْعِ الرّزْقِ فَقَالَ : لاَ بَأْسَ بِہِ، وَلَکِنْ لاَ یَبِیعَہُ حَتَّی یَقْبِضَہُ۔","","Musannaf Ibn Abi Shaybah 21480","","","كتاب البيوع والأقضية"
"21481","(۲۱۴۸۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ : أَنَّہُ کَانَ یَکْرَہُ بَیْعَ الرزقِ إِذَا خَرَجَتِ الصِّکَاکِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21481","","","كتاب البيوع والأقضية"
"21482","(۲۱۴۸۲) حَدَّثَنَا عبد الأعلی ، عن ہشام ، عن الحسن : أنہ کان یکرہہ ویقول : إنہ لاَ یجیء سواء ، ویقول: إنہم یکیلون بالجریب ، ویقول : اشتر کیلا مسمی إلی أجل مسمی۔","No Data Available","Musannaf Ibn Abi Shaybah 21482","","","كتاب البيوع والأقضية"
"21483","(۲۱۴۸۳) حَدَّثَنَا وکیع ، عن سفیان ، عن سلم بن عبد الرحمن ، عن الحارث ، عَنْ إبْرَاہِیمَ : أنہ کرہ بیع الرزق حتی یقبض الصک۔","No Data Available","Musannaf Ibn Abi Shaybah 21483","","","كتاب البيوع والأقضية"
"21484","(۲۱۴۸۴) حَدَّثَنَا وکیع ، عن سفیان ، عن معمر ، عن الزہری ، أنہ کرہ بیع الرزق حتی یقبضہ۔","","Musannaf Ibn Abi Shaybah 21484","","","كتاب البيوع والأقضية"
"21485","(۲۱۴۸۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ یَعْقُوبَ بْنِ الْقَعْقَاعِ ، عَنْ مَطَرٍ ، عَنِ الْحَسَنِ ؛ فِی عَبْدٍ بَیْنَ ثَلاَثَۃٍ کَاتَبَہُ أَحَدُہُمْ ، قَالَ : یُؤْخَذُ مِنْہُ مَا أَخَذَ مِنْہُ فَیُقْسَمُ بَیْنَ شُرَکَائِہِ ، وَالْعَبْدُ بَیْنَہُمْ ، لاَ تَجُوزُ کِتَابَتُہُ۔ قال: وکان عطاء یقول : علیہ نفاذ عتقہ کما یکون علی الذی أعتق۔","","Musannaf Ibn Abi Shaybah 21485","","","كتاب البيوع والأقضية"
"21486","(۲۱۴۸۶) حَدَّثَنَا صَفْوَانُ بْنُ عِیسَی ، عَنْ أُنَیْسِ بْنِ أَبِی یَحْیَی ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ عَنْ مُکَاتَبٍ کَانَ بَیْنَ ثَلاَثَۃٍ قَاطَعَہُ بَعْضُہُمْ وَتَمَسَّکَ بَعْضُہُمْ بِکِتَابَتِہِ فَلَمْ یُقَاطِعْہُ ، وَمَاتَ الْمُکَاتَبُ وَتَرَکَ مَالاً کَثِیرًا ، لِمَنْ ترکتُہ ؟ قَالَ : فَقَالَ : سَعِید بْنَ الْمُسَیَّبِ : یستوفی الَّذِینَ تَمَسَّکُوا بَقِیَّۃَ کِتَابَتِہِمْ ، ثُمَّ یَکُونُ مَا بَقِیَ بَیْنَہُمْ۔","","Musannaf Ibn Abi Shaybah 21486","","","كتاب البيوع والأقضية"
"21487","(۲۱۴۸۷) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنْ عَبْدٍ کَانَ بَیْنَ رَجُلَیْنِ فَکَاتَبَ أَحَدُہُمَا نَصِیبَہُ ، فَکَرِہَہُ حَمَّادٌ ، وَلَمْ یَرَ بِہِ الْحَکَمُ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 21487","","","كتاب البيوع والأقضية"
"21488","(۲۱۴۸۸) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ : فِی رَجُلٍ کَاتَبَ حِصَّتَہُ مِنْ عَبْدٍ ، قَالَ : إِنْ عَلِمَ أَصْحَابُہُ قَبْلَ أَنْ یُؤَدِّیَ رَدُّوہُ ، وَإِنْ أَدَّی لَمْ یُرَدَّ۔","","Musannaf Ibn Abi Shaybah 21488","","","كتاب البيوع والأقضية"
"21489","(۲۱۴۸۹) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَبِیہِ ، عَنْ عَامِرٍ فِی عَبْدٍ بَیْنَ ثَلاَثَۃٍ فَأَعْتَقَہُ رَجُلاَنِ مِنْہُمْ ، ثُمَّ تُوُفِّیَ الْعَبْدُ وَلَہُ مَالٌ، قَالَ: یَغْرم اللَّذَانِ أَعْتَقَا لِلَّذِی لَمْ یُعْتِقْ ثُلُثَ ثَمَنِہِ، ثُمَّ یَقْسِمُ مِیرَاثَہُ عَلَی ثَلاَثَۃِ أَسْہُمٍ، لِکُلِّ رَجُلٍ سَہْمٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 21489","","","كتاب البيوع والأقضية"
"21490","(۲۱۴۹۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی عَبْدٍ بَیْنَ رَجُلَیْنِ ، قَالَ : کَانَ یُکْرَہُ أَنْ یُکَاتِبَہُ أَحَدُہُمَا إلاَّ بِإِذْنِ شَرِیکِہِ ، فَإِنْ فَعَلَ قَاسَمَہُ الَّذِی لَمْ یُکَاتِبْ عَلَی کُلِ شَیْئٍ أَخَذَ مِنْہُ ، فَإِذَا اسْتَکْمَلَ الَّذِی کَاتَبَہُ مَا کَاتَبَہُ عَلَیْہِ عَتَقَ وَسَعَی فِی نِصْفِ قِیمَتِہِ الَّذِی لَمْ یُکَاتِبْہُ وَالْوَلاَئُ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 21490","","","كتاب البيوع والأقضية"
"21491","(۲۱۴۹۱) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ اللَّیْثِ ، عن الشَّعْبِیِّ وَإِبْرَاہِیمَ قَالا : إذَا مَاتَ الرَّجُلُ وَعَلَیْہِ دَیْنٌ إلَی أَجَلٍ ، فَقَدْ حَلَّ دَیْنُہُ۔","","Musannaf Ibn Abi Shaybah 21491","","","كتاب البيوع والأقضية"
"21492","(۲۱۴۹۲) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، وَابْنِ سِیرِینَ؛ فِی الرَّجُلِ یَمُوتُ وَعَلَیْہِ دَیْنٌ إلَی أَجَلٍ، قَالَ ابْنُ سِیرِینَ: إذَا أَوْثَقَ الْوَرَثَۃُ لِصَاحِبِ الْحَقِّ فَلَہُمْ أَجَلُ صَاحِبِہِمْ ، وَقَالَ الْحَسَنُ : إذَا مَاتَ ، فَقَدْ حَلَّ دَیْنُہُ۔","","Musannaf Ibn Abi Shaybah 21492","","","كتاب البيوع والأقضية"
"21493","(۲۱۴۹۳) حَدَّثَنَا حَفْصٌ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ، وَابْنِ سِیرِینَ، قَالا: إذَا مَاتَ الرَّجُلُ أوْ أَفْلَسَ فَقَدْ حَلَّ مَا عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 21493","","","كتاب البيوع والأقضية"
"21494","(۲۱۴۹۴) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا مَاتَ الرَّجُلُ أوْ أَفْلَسَ ، فَقَدْ حَلَّ مَا عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 21494","","","كتاب البيوع والأقضية"
"21495","(۲۱۴۹۵) حَدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ أَبَانَ بْنِ عَبْدِ الْعَزِیزِ ، وَابْنِ شِہَابٍ ، وَأَبِی بَکْرِ بْنِ مُحَمَّدٍ وَسَعْدِ بْنِ إبْرَاہِیمَ کَانُوا یَقْضُونَ فِی دَیْنِہِ إلَی أَجَلٍ۔","","Musannaf Ibn Abi Shaybah 21495","","","كتاب البيوع والأقضية"
"21496","(۲۱۴۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، عَنْ رَجُل ، عَنْ شُرَیْحٍ ، قَالَ : إذَا أَوْثَقَ لہ الْوَرَثَۃ فَہُوَ إلی أَجَلہُ۔","","Musannaf Ibn Abi Shaybah 21496","","","كتاب البيوع والأقضية"
"21497","(۲۱۴۹۷) حَدَّثَنَا ابن إدریس ، عن مطرف ، عن الشعبی ، قَالَ : لیس لمیت شرط۔","","Musannaf Ibn Abi Shaybah 21497","","","كتاب البيوع والأقضية"
"21498","(۲۱۴۹۸) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، أَنَّہُ کَانَ یَکْرَہُ بَیْعَ السَّمْنِ وَبَیْعَ الزَّیْتِ ، وَیَرْفَعُ لِلظُّرُوفِ کَذَا وَکَذَا ، وَیَقُولُ : لاَ إلاَّ صَبًّا ، أَوْ وَزْنًا۔","No Data Available","Musannaf Ibn Abi Shaybah 21498","","","كتاب البيوع والأقضية"
"21499","(۲۱۴۹۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، أَنَّہُ کَانَ یَکْرَہُ الْقَطَرَ ، قَالَ ابْنُ عَوْنٍ : الْقَطَرُ الرَّجُلُ یَبِیعُ الرَّجُلَ فَیُلْقِی لِلظُّرُوفِ شَیْئًا مِنَ الْوَزْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21499","","","كتاب البيوع والأقضية"
"21500","(۲۱۵۰۰) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ سَلَمِ بْنِ أَبِی الذَّیَّالِ ، قَالَ : سَأَلْتُ ابْنَ سِیرِینَ ، عَنِ الَّذِی یَبِیعُ الْمَتَاعَ فِی البوَاسِن وَقَدْ جَعَلُوا بَیْنَہُمْ وَزْنَ الظُّرُوفِ شَیْئًا مَعْلُومًا ، قَالَ : یَبِیعُہُ وَزْنًا کُلَّہُ وَالظُّرُوفُ مَعَہُ۔","","Musannaf Ibn Abi Shaybah 21500","","","كتاب البيوع والأقضية"
"21501","(۲۱۵۰۱) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ ، وَأَبِی ہَاشِمٍ ، قَالا ؛ فِی الرَّجُلِ یَشْتَرِی السَّمْنَ أوالْعَسَلَ عَلَی أَنْ یَدْفَعَ مِنَ الظُّرُوفِ کَذَا وَکَذَا ، فَزَعَمُوا أَنَّہُ مَکْرُوہٌ۔","","Musannaf Ibn Abi Shaybah 21501","","","كتاب البيوع والأقضية"
"21502","(۲۱۵۰۲) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ عِمْرَانَ ، عَنْ حَمَّادٍ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ ، عَنِ الأَعْرَابِیِّ یَجِیئُ بِالنِّحْیِ مِنَ السَّمْنِ وَیَبِیعُہُ وَیُلْقِی لِلنِّحْیِ أَمْنَانًا ، فَقَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 21502","","","كتاب البيوع والأقضية"
"21503","(۲۱۵۰۳) حَدَّثَنَا شَرِیکٌ ، عَنْ عَاصِمِ بْنِ عُبَیْدِ اللہِ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرِ بْنِ رَبِیعَۃَ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، أَنَّہُ کَانَ یَرَی الْبَرَائَۃَ مِنْ کُلِّ عَیْبٍ جَائِزًا۔","Da'if","Musannaf Ibn Abi Shaybah 21503","","","كتاب البيوع والأقضية"
"21504","(۲۱۵۰۴) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَالِمٍ ، أَنَّ ابْنَ عُمَرَ بَاعَ غُلاَمًا لَہُ بِثَمَانِ مِئَۃٍ دِرْہم ، قَالَ : فَوَجَدَ بِہِ الْمُشْتَرِی عَیْبًا فَخَاصَمَہُ إلَی عُثْمَانَ ، فَسَأَلَہُ عُثْمَانُ فَقَالَ : بِعْتُہُ بِالْبَرَائَۃِ ، فَقَالَ : تَحْلِفُ بِاللَّہِ : لَقَدْ بِعْتَہُ وَمَا بِہِ مِنْ عَیْبٍ تَعْلَمُہُ ؟ فَقَالَ : بِعْتُہُ بِالْبَرَائَۃِ ، فَقَالَ : تَحْلِفُ بِاللَّہِ : لَقَدْ بِعْتَہُ وَمَا بِہِ مِنْ عَیْبٍ تَعْلَمُہُ ؟ وَأَبَی أَنْ یَحْلِفَ ، فَرَدَّہُ عُثْمَانُ عَلَیْہِ فَبَاعَہُ بَعْدَ ذَلِکَ بِأَلْفٍ وَخَمْسِ مِئَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 21504","","","كتاب البيوع والأقضية"
"21505","(۲۱۵۰۵) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَا سَمَّی مِنْ عَیْبٍ بَرِئَ مِنْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21505","","","كتاب البيوع والأقضية"
"21506","(۲۱۵۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ شُرَیْحٍ ، قَالَ : إذَا ہُوَ سَمَّی بَرِئَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21506","","","كتاب البيوع والأقضية"
"21507","(۲۱۵۰۷) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ؛ فِی الرَّجُلِ یَبِیعُ الدَّابَّۃَ وَیَقُولُ : أَبْرَأُ مِنْ کَذَا ، أَبْرَأُ مِنْ کَذَا ، أَبْرَأُ مِنَ الْجَرْدِ ، قَالَ : لاَ ، وقَالَ : لاَ یَبْرَأُ إلاَّ مِنْ شَیْئٍ یُسَمِّیہِ وَیُریہ۔","","Musannaf Ibn Abi Shaybah 21507","","","كتاب البيوع والأقضية"
"21508","(۲۱۵۰۸) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ، عَنْ دِینَارٍ، قَالَ: قُلْتُ لِلْحَسَنِ: أَبِیعُ السِّلْعَۃَ وَأَتَبرأ مِنَ الْقُرُوحِ وَالْجُرُوحِ والنفائغ وَالْبَاطِنِ وَالظَّاہِرِ ، فَقَالَ : لاَ تُبْرَأُ حَتَّی تَقُولَ : فِی ہَذہ الْعَیْنِ کَذَا ، وَہَذَا کَذَا ، وَإِلاَّ رُدَّ عَلَیْک۔","","Musannaf Ibn Abi Shaybah 21508","","","كتاب البيوع والأقضية"
"21509","(۲۱۵۰۹) حَدَّثَنَا غُنْدَرٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ یَبْرَأُ مِنَ الْعَیْبِ حَتَّی یُسَمِّیَہُ وَیَضَعَ یَدَہ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 21509","","","كتاب البيوع والأقضية"
"21510","(۲۱۵۱۰) حَدَّثَنَا وَکِیعٌ، عَنْ إسْمَاعِیلَ الأَزْرَقِ، عَنِ الشَّعْبِیِّ، قَالَ: إذَا سمَّی بَرِئَ، وَإِنْ لَمْ یَضَعْ یَدَہُ عَلَی الْعَیْبِ۔","","Musannaf Ibn Abi Shaybah 21510","","","كتاب البيوع والأقضية"
"21511","(۲۱۵۱۱) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ مَنْصُورٍ، عَنْ رَجُلٍ، عَنْ شُرَیْحٍ، قَالَ: لاَ یَبْرَأُ حَتَّی یَضَعَ یَدَہ عَلَیہِ۔","","Musannaf Ibn Abi Shaybah 21511","","","كتاب البيوع والأقضية"
"21512","(۲۱۵۱۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا قَالَ : أَبِیعُک لَحْمًا عَلَی بَارِیۃِ أَبِیعُک مَا أَقَلَّتِ الأَرْضُ ، قَالَ : إذَا سَمَّی بَرِئَ۔","","Musannaf Ibn Abi Shaybah 21512","","","كتاب البيوع والأقضية"
"21513","(۲۱۵۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَن أَبِی ہُرَیْرَۃَ ، وَأَبِی سَعِیدٍ ، قَالاَ : مَنِ اسْتَأْجَرَ أَجِیرًا فَلْیُعْلِمْہُ أَجْرَہُ۔ (عبدالرزاق ۱۵۰۲۳)","","Musannaf Ibn Abi Shaybah 21513","","","كتاب البيوع والأقضية"
"21514","(۲۱۵۱۴) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سَہْلٍ السَّرَّاجِ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ عُثْمَانُ : مَنِ اسْتَأْجَرَ أَجِیرًا فَلْیُبَیِّنْ لَہُ أَجْرَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 21514","","","كتاب البيوع والأقضية"
"21515","(۲۱۵۱۵) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمَ وَحَمَّادٍ ، عَنْ إبْرَاہِیمَ ، وَابْنِ سِیرِینَ أَنَّہُمَا کَرِہَا أَنْ یُسْتَعْمِلَ الأَجِیرَ حَتَّی یُبَیَّنَ لَہُ أَجْرَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21515","","","كتاب البيوع والأقضية"
"21516","(۲۱۵۱۶) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، أَنَّہُ کَرِہَ أَنْ یُسْتَعْمِلَ الأَجِیرَ مَا لاَ یَدْرِی مَا ہُوَ ، إلاَّ أَنْ یَکُونَ شَیْئًا مَعْلُومًا۔","","Musannaf Ibn Abi Shaybah 21516","","","كتاب البيوع والأقضية"
"21517","(۲۱۵۱۷) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : لاَ یُسْتَأْجَرُ الأَجِیرُ إلاَّ بِأَفْرَاقٍ مَعْلُومَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 21517","","","كتاب البيوع والأقضية"
"21518","(۲۱۵۱۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ؛ فِی الرَّجُلِ یَشْتَرِی الْجَارِیَۃَ فَیَقُولُ الْبَائِعُ : لاَ أَدْفَعُہَا إلَیْک حَتَّی تَحِیضَ ، فَوُضِعَتْ عَلَی یَدَیْ عَدْلٍ فَمَاتَتْ ، فَقَالَ : ہِیَ مِنْ مَالُ الْبَائِعِ۔","","Musannaf Ibn Abi Shaybah 21518","","","كتاب البيوع والأقضية"
"21519","(۲۱۵۱۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ زَکَرِیَّا ، عَنْ عَامِرٍ ، أَنَّہُ سُئِلَ عَنْ رَجُلٍ اشْتَرَی جَارِیَۃً فَزَعَمَ أَنَّہَا حُبْلَی ، فَأَنْکَرَ الَّذِی بَاعَہَا فَوَضَعُوا الْجَارِیَۃَ عَلَی یَدَیْ عَدْلٍ حَتَّی یَتَبَیَّنَ حَمْلُہَا فَمَاتَتْ ، فَقَالَ : إِنْ کَانَ تَبَیَّنْ حَمْلُہَا فَہِیَ مِنْ مَالِ الْبَائِعِ ، وإنْ لَمْ یَکُنْ تَبَیَّنْ حَمْلُہَا فَہِیَ مِنْ مَالِ الْمُشْتَرِی۔","","Musannaf Ibn Abi Shaybah 21519","","","كتاب البيوع والأقضية"
"21520","(۲۱۵۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ، عَنْ عَامِرٍ وَالْحَکَمِ فِی رَجُلٍ بَاعَ من رجل جَارِیَۃً فَظَفِرَ بِعَیْبٍ، فَوَضَعَاہَا عَلَی یَدَیْ عَدْلٍ فَمَاتَتْ ، قَالاَ : ہِیَ مِنْ مَالِ الْبَائِعِ۔","","Musannaf Ibn Abi Shaybah 21520","","","كتاب البيوع والأقضية"
"21521","(۲۱۵۲۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، قَالَ : شَہِدْت مِلاَکَ عَبَّاسِ بْنِ تَمَّامِ بْنِ عَبَّاسٍ بْنِ عَبْدِ الْمُطَّلِبِ وَمَعَنَا عِکْرِمَۃُ ، فَجَاؤُوا بِاللَّوْزِ وَالسُّکّرِ لِیَنْثُرُوہُ فَقَالَ : عِکْرِمَۃُ : ائْتُونَا بِہِ عَلَی الأَطْبَاقِ ، فَلْنَأْخُذْ مِنْہُ حَاجَتَنَا۔","","Musannaf Ibn Abi Shaybah 21521","","","كتاب البيوع والأقضية"
"21522","(۲۱۵۲۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالنَّہاب فِی الْعُرُسَاتِ وَالْوَلاَئِمِ۔","","Musannaf Ibn Abi Shaybah 21522","","","كتاب البيوع والأقضية"
"21523","(۲۱۵۲۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ کَانَ یُحِبُّ أَنْ یُؤْتَی بِہِ عَلَی الأَطْبَاقِ فَیَنَالُونَ مِنْہُ حَاجَتَہُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 21523","","","كتاب البيوع والأقضية"
"21524","(۲۱۵۲۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، أَنَّہُ کَانَ لاَ یَرَی بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 21524","","","كتاب البيوع والأقضية"
"21525","(۲۱۵۲۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنِ إبراہیم ، أنہ قَالَ : یأخذہ الصبیان۔","","Musannaf Ibn Abi Shaybah 21525","","","كتاب البيوع والأقضية"
"21526","(۲۱۵۲۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَش ، عَنْ مُوسَی بْنِ عَبْدِ اللہِ بْنِ یَزِیدَ ، قَالَ : دُعی عَبْدُ الرَّحْمَنِ بْنُ أَبِی لَیْلَی إلَی عُرْسٍ ، فَجَاؤُوا بِسُکّرٍ لِیَنْثُرُوہُ فَقَالَ : أَقْسِمُوہُ بَیْنَہُمْ۔","","Musannaf Ibn Abi Shaybah 21526","","","كتاب البيوع والأقضية"
"21527","(۲۱۵۲۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ الأَعْمَش ، عَنْ مُوسَی بْنِ عَبْدِ اللہِ بْنِ یَزِیدَ الأَنْصَارِیِّ ، قَالَ : شَہِدْت إملاَکًا فَجیئَ بِسُکّرٍ لِیَنْثُرُوہُ فَقَالَ عَبْدُ الرَّحْمَنِ بْنُ أَبِی لَیْلَی : دَعُوہُ فَاقْسِمُوہُ۔","","Musannaf Ibn Abi Shaybah 21527","","","كتاب البيوع والأقضية"
"21528","(۲۱۵۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِیہِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ الْخَطْمِیِّ فِی نَثْرِ الْجَوْزِ ، قَالَ : إِنْ وَضَعْتُمُوہُ أَصَبْنَا مِنْہُ ، وَإِنْ نَثَرْتُمُوہُ لَمْ نُصِبْ مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 21528","","","كتاب البيوع والأقضية"
"21529","(۲۱۵۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : أَدْرَکْت رِجَالاً صَالِحِینَ یَکْرَہُونَ أَکْلَ مَا نُثِرَ۔","","Musannaf Ibn Abi Shaybah 21529","","","كتاب البيوع والأقضية"
"21530","(۲۱۵۳۰) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ انْتِہَابَ الْجَوْزِ وَالسُّکّرِ۔ قَالَ : وَقَالَ عَامِرٌ : لاَ بَأْسَ ، إنَّمَا کُرِہَ مَا لَمْ تَطِبْ بِہِ نَفْسُ صَاحِبِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21530","","","كتاب البيوع والأقضية"
"21531","(۲۱۵۳۱) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا إسْرَائِیلُ، عَنْ أَبِی حَصِینٍ ، عن خالد بن سعد ، عَنْ أَبِی مَسْعُودٍ الأَنْصَارِیِّ، أَنَّہُ کَانَ إذَا نُثِرَ عَلَی الصِّبْیَانِ مَنَعَ صِبْیَانَہُ فَاشْتَرَی لَہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 21531","","","كتاب البيوع والأقضية"
"21532","(۲۱۵۳۲) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ ، عَنْ خَالِدِ بْنِ سَعْدٍ ، أَنَّ أَبَا مَسْعُودٍ کَرِہَ نَہَّابَ السُّکّرِ عَلَی الصِّبْیَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 21532","","","كتاب البيوع والأقضية"
"21533","(۲۱۵۳۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الْحَکَمِ ، قَالَ : کُنْتُ بَیْنَ إبْرَاہِیمَ وَالشَّعْبِیِّ فَسُئِلاَ عَنْ نَہَّابِ السُّکّرِ فِی الْعُرْسِ ، فَکَرِہَہُ إبْرَاہِیمُ ، وَلَمْ یَرَ الشَّعْبِیُّ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 21533","","","كتاب البيوع والأقضية"
"21534","(۲۱۵۳۴) حَدَّثَنَا شریک ، عن عنبسۃ ، عن الشعبی : أنہ لَمْ یَرَ بِہِ بَأْسًا ، وکرہہ إبراہیم۔","No Data Available","Musannaf Ibn Abi Shaybah 21534","","","كتاب البيوع والأقضية"
"21535","(۲۱۵۳۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ عِکْرِمَۃَ ، أَنَّہُ کَرِہَ نَثْرَ السُّکّرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21535","","","كتاب البيوع والأقضية"
"21536","(۲۱۵۳۶) حَدَّثَنَا عیسی بن یونس ، عن الأوزاعی ، عن عطاء : أَنَّہُ کَرِہَ نَثْرَ السُّکّرِ۔","","Musannaf Ibn Abi Shaybah 21536","","","كتاب البيوع والأقضية"
"21537","(۲۱۵۳۷) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ حُمَیْدِ بْنِ صَخْرٍ ، عَنْ عَمَّارٍ الدُّہْنِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنْ أَبِی الصَّہْبَائِ ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ : أَنَّہُ سُئِلَ عَنْہَا؟ فَقَالَ : الْغِنَائُ ، وَالَّذِی لاَ إلَہَ إلاَّ ہُوَ۔","Hasan","Musannaf Ibn Abi Shaybah 21537","","","كتاب البيوع والأقضية"
"21538","(۲۱۵۳۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی، عَنِ الْحَکَمِ، عَنْ مِقْسَمٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: الْغِنَائُ وَشِرَاء الْمُغَنِّیَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 21538","","","كتاب البيوع والأقضية"
"21539","(۲۱۵۳۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : ہُوَ الْغِنَائُ ، وَالْغِنَائُ مِنْہُ ، وَالإِسْتِمَاعُ إلَیْہِ۔","","Musannaf Ibn Abi Shaybah 21539","","","كتاب البيوع والأقضية"
"21540","(۲۱۵۴۰) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ شُعَیْبٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : ہُوَ الْغِنَائُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21540","","","كتاب البيوع والأقضية"
"21541","(۲۱۵۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، قَالَ : سَمِعْتُ عِکْرِمَۃَ یَقُولُ : ہُوَ الْغِنَائُ۔","","Musannaf Ibn Abi Shaybah 21541","","","كتاب البيوع والأقضية"
"21542","(۲۱۵۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ ، قَالَ : ہُوَ الْغِنَائُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21542","","","كتاب البيوع والأقضية"
"21543","(۲۱۵۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبٍ ، قَالَ : ہُوَ الْغِنَائُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21543","","","كتاب البيوع والأقضية"
"21544","(۲۱۵۴۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : ہُوَ الْغِنَائُ وَنَحْوُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 21544","","","كتاب البيوع والأقضية"
"21545","(۲۱۵۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ مُجَاہِدٍ وَإِبْرَاہِیمَ ، قَالَ إبْرَاہِیمُ : الْغِنَائُ یُنْبِتُ النِّفَاقَ فِی الْقَلْبِ ، قَالَ : وَقَالَ مُجَاہِدٌ : {وَمِنَ النَّاسِ مَنْ یَشْتَرِی لَہْوَ الْحَدِیثِ} ہو الْغِنَائُ۔","","Musannaf Ibn Abi Shaybah 21545","","","كتاب البيوع والأقضية"
"21546","(۲۱۵۴۶) حَدَّثَنَا إسْمَاعِیلُ بْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : حدَّثَنَا الْمِسْوَرُ بْنُ زَیدَ ، أَنَّ امْرَأَۃً الْتَقَطَتْ صَبِیًّا فَأَنْفَقَتْ عَلَیْہِ حَتَّی شَبَّ ، ثُمَّ طَلَبَتْ نَفَقَتَہَا ، فَکُتِبَ فِی ذَلِکَ إلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ فَکَتَبَ : أَنْ تُسْتَحْلَفَ أَنَّہَا لَمْ تُنْفِقْ عَلَیْہِ احْتِسَابًا ، فَإِنْ حَلَفَتْ ، اسْتُسعی۔","","Musannaf Ibn Abi Shaybah 21546","","","كتاب البيوع والأقضية"
"21547","(۲۱۵۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ فِی الرَّجُلِ یُنْفِقُ عَلَی اللَّقِیطِ ، قَالَ : لاَ شَیْئَ لَہُ۔","","Musannaf Ibn Abi Shaybah 21547","","","كتاب البيوع والأقضية"
"21548","(۲۱۵۴۸) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، قَالَ : الْمَنْبُوذُ حُرٌّ ، وَإِنْ طَلَبَ الَّذِی رَبَّاہُ نَفَقَتَہُ وَکَانَ مُوسِرًا رَدَّ عَلَیْہِ ، وَإِنْ لَمْ یَکُنْ مُوسِرًا کَانَ مَا أَنْفَقَ عَلَیْہِ صَدَقَۃً۔","","Musannaf Ibn Abi Shaybah 21548","","","كتاب البيوع والأقضية"
"21549","(۲۱۵۴۹) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، قَالَ ، أَخْبَرَنِی خَالِدُ بْنُ أَبِی الصَّلْتِ ، قَالَ : قَالَ لِی عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : إنَّ عُمَرَ بْنَ الْخَطَّابِ قَضَی فِی وَلَدِ الزِّنَا أَنَّہُ یُقَاصُّ صَاحِبُہُ بِمَا خَدَمَہُ ، وَمَا بَقِیَ اسْتَسعی فِیہِ ، وَقَضَیْت أَنَا : یُقَاصُّہُ بِمَا خَدَمَہُ ، وَمَا بَقِیَ أَدَّیْتہ عَنْہُ مِنْ بَیْتِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 21549","","","كتاب البيوع والأقضية"
"21550","(۲۱۵۵۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَضَلَّ رَجُلٌ بَعِیرًا فَوَجَدَہُ عِنْدَ رَجُلٍ قَدْ أَنْفَقَ عَلَیْہِ ، أَعْلَفَہُ وَأَسْمَنَہُ ، فَاخْتَصَمَا إلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ وَہُوَ یَوْمَئِذٍ أَمِیرٌ عَلَی الْمَدِینَۃِ ، فَقَضَی لِصَاحِبِ الْبَعِیرِ بِبَعِیرِہِ ، وَقَضَی عَلَیْہِ بِالنَّفَقَۃِ۔ قَالَ الشَّعْبِیُّ : فَلَمْ یُعْجِبْنِی ذَلِکَ ، فَقَالَ : یَأْخُذُ الرَّجُلُ بَعِیرَہُ ، وَلاَ نَفَقَۃَ عَلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21550","","","كتاب البيوع والأقضية"
"21551","(۲۱۵۵۱) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ النُّعْمَانَ بْنَ مُرَّۃَ یُحَدِّثُ سَعِید بْن الْمُسَیَّبِ ، قَالَ : رَأَیْتُ عَلِیًّا بَنَی لِلضَّوَالِّ مِرْبَدًا ، فَکَانَ یَعْلِفُہَا عَلَفًا لاَ یُسَمِّنُہَا ، وَلاَ یُہْزِلُہَا ، مِنْ بَیْتِ الْمَالِ ، فَکَانَتْ تُشْرِفُ بِأَعْنَاقِہَا ، فَمَنْ أَقَامَ بَیِّنَۃً عَلَی شَیْئٍ أَخَذَہُ وَإِلاَّ أَقَرَّہَا عَلَی حَالِہَا لاَ یَبِیعُہَا ، فَقَالَ : سَعِیدُ بْنُ الْمُسَیَّبِ : لَوْ وُلِّیت أَمْرَ الْمُسْلِمِینَ صَنَعْت ہَکَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 21551","","","كتاب البيوع والأقضية"
"21552","(۲۱۵۵۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : مِنْ أَحَبِّ بُیُوعِہِمْ إلَیَّ بَیْعُ الرَّقْمِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21552","","","كتاب البيوع والأقضية"
"21553","(۲۱۵۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ وَاصِلٍ ، عَنْ طَاوُوسٍ ، أَنَّہُ کَرِہَ بَیْعَ الرَّقْمِ ، وَقَالَ : إنِّی أَکْرَہُ أَنْ أُزَیِّنَ سِلْعَتِی بِالْکَذِبِ۔","","Musannaf Ibn Abi Shaybah 21553","","","كتاب البيوع والأقضية"
"21554","(۲۱۵۵۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ کَانَ یَقُولُ : یَرْقُمُ الرَّجُلُ مَتَاعَہُ مَا شَائَ ، ثُمَّ یَقُولُ: إنَّمَا رَقَّمْتہ لأُِسَاوِمَکُمْ بِہِ ، ثُمَّ یَبِیعُہُ مُنَاقَصَۃً : الْعَشَرَۃُ بِتِسْعَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 21554","","","كتاب البيوع والأقضية"
"21555","(۲۱۵۵۵) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : حدَّثَنَا عَبْدُ الْمَلِکِ بْنُ أَبِی الْقَاسِمِ ، قَالَ : سَأَلْتُ نَافِعًا وَرَبِیعَۃَ ، فَقُلْتُ : نَشْتَرِی الْبَزَّ ، ثُمَّ نَزِیدُ عَلَیْہِ فَوْقَ ثَمَنِہِ ، ثُمَّ نَرْقُمُہُ عَلَیْہِ ، ثُمَّ نَبِیعُہُ مُرَابَحَۃً ، وَلاَ نُبَیِّنُ الزِّیَادَۃَ ، فَقَالَ : لاَ ، ہَذِہِ الْمُخَالَبَۃُ وَالْمُکَاذَبَۃُ۔","","Musannaf Ibn Abi Shaybah 21555","","","كتاب البيوع والأقضية"
"21556","(۲۱۵۵۶) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ إسْرَائِیلَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَرْشُمَ الثِّیَابَ ، ثُمَّ یَقُولَ أَبِیعُکُمْ عَلَی رَشْمِی ہَذَا مُرَابَحَۃً۔","","Musannaf Ibn Abi Shaybah 21556","","","كتاب البيوع والأقضية"
"21557","(۲۱۵۵۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ ابنِ أَبِی غَنیَّۃ ، عَنِ الْحَکَمِ ، أَنَّہُ قَالَ ذَلِکَ ، وَقَالَ : إنَّمَا ہُوَ شِبْہُ الْمُسَاوَمَۃِ۔","","Musannaf Ibn Abi Shaybah 21557","","","كتاب البيوع والأقضية"
"21558","(۲۱۵۵۸) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الشَّعْبِیِّ ، قَالَ : ادَّعَی رَجُلٌ بَغْلاً فِی یَدِ رَجُلٍ ، وَأَقَامَ الْبَیِّنَۃَ أَنَّہُ لَہُ ، وَأَقَامَ الَّذِی ہُوَ فِی یَدِہِ الْبَیِّنَۃَ أَنَّہُ أَنْتَجَہُ ، فَقَضَی بِہِ شُرَیْحٌ لِلَّذِی ہُوَ فِی یَدِہِ۔","","Musannaf Ibn Abi Shaybah 21558","","","كتاب البيوع والأقضية"
"21559","(۲۱۵۵۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی حَصِینٍ ، قَالَ : اُخْتُصِمَ إلَی عَبْدِ اللہِ بْنِ عُتْبَۃَ فِی لَوَالِی وَأَنَا عِنْدَہُ ، فَأَقَامَ کُلُّ وَاحِدٍ مِنْہُمَا الْبَیِّنَۃَ أَنَّہَا لَہُ ، قَالَ : فَرَأَیْتُ عَبْدَ اللہِ بْنَ عُتْبَۃَ یُحَرِّکُہُنَّ بِیَدِہِ وَیَقُولُ : ہِیَ لِلْمُتْلد ، ہی للَّذِی فِی یَدِہِ۔","","Musannaf Ibn Abi Shaybah 21559","","","كتاب البيوع والأقضية"
"21560","(۲۱۵۶۰) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، قَالَ : وُجِدَ بَغْلٌ فِی النَّہْرَیْنِ ، فَأَقَامَ کُلُّ فِرْقَۃٍ الْبَیِّنَۃَ أَنَّہُ لَہُمْ ، فَقَضَی بِہِ عَبْدُ اللہِ بْنُ عُتْبَۃَ : لِلَّذِی ہُوَفِی أَیْدِیہِمْ۔","","Musannaf Ibn Abi Shaybah 21560","","","كتاب البيوع والأقضية"
"21561","(۲۱۵۶۱) حَدَّثَنَا یَحْیَی بْنُ أَبِی زَائِدَۃَ ، عَنْ حَجَّاجٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا اسْتَوَتِ الْبَیِّنَتَانِ ، فَہُوَ لِلَّذِی فِی أَیْدِیہِمْ۔","","Musannaf Ibn Abi Shaybah 21561","","","كتاب البيوع والأقضية"
"21562","(۲۱۵۶۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا شَہِدَ شَاہِدَانِ ، أَنَّ ہَذِہِ الدَّابَّۃَ لِفُلاَنٍ وَنُتِجَ عِنْدَہُ ، وَشَہِدَ شَاہِدَانِ أَنَّہَا لِفُلاَنٍ وَنُتِجَ عِنْدَہُ ، فَہُو لِلَّذِی فِی یَدِہِ۔","","Musannaf Ibn Abi Shaybah 21562","","","كتاب البيوع والأقضية"
"21563","(۲۱۵۶۳) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ؛ فِی الرَّجُلِ یَکُونُ فِی یَدِہِ الثَّوْبُ فَیُقِیمُ الرَّجُلُ الْبَیِّنَۃَ أَنَّہُ ثَوْبُہُ ، وَیُقِیمُ الَّذِی ہو فِی یَدِہِ الْبَیِّنَۃَ أَنَّہُ ثَوْبُہُ ، فَقَالَ : ہُوَ لِلَّذِی ہُوَ فِی یَدِہِ ، وَقَالَ فِی الدَّابَّۃِ : یُقِیمُ ہَذَا الْبَیِّنَۃَ أنہا دابتہ ، وَیُقِیمُ الَّذِی ہی فِی یَدِہِ الْبَیِّنَۃَ أَنَّہَا دَابَّتُہُ ، قَالَ : ہِیَ لِلَّذِی ہِیَ فِی یَدِہِ۔","","Musannaf Ibn Abi Shaybah 21563","","","كتاب البيوع والأقضية"
"21564","(۲۱۵۶۴) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ سِمَاکٍ ، عَنْ تَمِیمِ بْنِ طَرَفَۃَ ، أَنَّ رَجُلَیْنِ ادَّعَیَا بَعِیرًا ، فَأَقَامَ کُلُّ وَاحِدٍ مِنْہُمَا الْبَیِّنَۃَ أَنَّہُ لَہُ ، فَقَضَی بِہِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُ بَیْنَہُمَا۔ (ابوداؤد ۳۳۹۔ عبدالرزاق ۱۵۲۰۲)","","Musannaf Ibn Abi Shaybah 21564","","","كتاب البيوع والأقضية"
"21565","(۲۱۵۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ أَبِی الدَّرْدَائِ ، أَنَّ رَجُلَیْنِ اخْتَصَمَا إلَیْہِ فِی دَابَّۃٍ ، فَأَقَامَ کُلُّ وَاحِدٍ مِنْہُمَا الْبَیِّنَۃَ أَنَّہَا لَہُ ، فَقَضَی بِہِ بَیْنَہُمَا وَقَالَ : مَا کَانَ أَحْوَجَکُمَا إلَی مِثْلِ سِلْسِلَۃِ بَنِی إسْرَائِیلَ۔ (عبدالرزاق ۱۵۲۰۴)","Sahih","Musannaf Ibn Abi Shaybah 21565","","","كتاب البيوع والأقضية"
"21566","(۲۱۵۶۶) حَدَّثَنَا عبدۃ ، عن سعید ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ أَبِی بُرْدَۃَ ، عَنْ أَبِی مُوسَی ، أن رجلین اختصما فی دابۃ ، فأقام کل واحد منہما البینۃ أنہا لہ ، فقضی النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بہا بینہما۔n(ابوداؤد ۳۶۰۸۔ حاکم ۹۴)","","Musannaf Ibn Abi Shaybah 21566","","","كتاب البيوع والأقضية"
"21567","(۲۱۵۶۷) حَدَّثَنَا عفان ، قَالَ : حَدَّثَنَا ہمام ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ أَبِی بُرْدَۃَ ، عَنْ أَبِیہِ ، عَنْ أَبِی مُوسَی ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِ حَدِیثِ عَبْدَۃَ ، عَنْ سَعِیدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 21567","","","كتاب البيوع والأقضية"
"21568","(۲۱۵۶۸) حَدَّثَنَا خَالِدُ بْنُ الْحَارِثِ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ، عَنْ أَبِی رَافِعٍ ، عَنْ أَبِی ہُرَیْرَۃَ، أَنَّ رَجُلَیْنِ اخْتَصَمَا إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی دَابَّۃٍ وَلَیْسَ لہُمَا بَیِّنَۃٌ ، فَأَمَرَہُمَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یَسْتَہِمَا عَلَی الْیَمِینِ۔ (ابوداؤد ۳۶۶۱۔ احمد ۴۸۹)","Sahih","Musannaf Ibn Abi Shaybah 21568","","","كتاب البيوع والأقضية"
"21569","(۲۱۵۶۹) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ فِی رَجُلٍ کَانَتْ لَہُ عَلَی رَجُلٍ دَرَاہِمُ ، فَلَمَّا حَلَّتْ ، قَالَ : أَمْسِکْہَا مُضَارَبَۃً ، قَالَ : لاَ یصْلُحُ حَتَّی یَقْبِضَہَا مِنْہُ ، ثُمَّ یَدْفَعَہَا إلَیْہِ إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 21569","","","كتاب البيوع والأقضية"
"21570","(۲۱۵۷۰) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، قَالَ: الْوَدِیعَۃُ مِثْلُ الْقَرْضِ، لاَ تُدْفَعُ مُضَارَبَۃً حَتَّی تُقْبَضَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21570","","","كتاب البيوع والأقضية"
"21571","(۲۱۵۷۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ فِی رَجُلٍ کَانَ لَہُ عَلَی رَجُلٍ دَرَاہِمُ فَقَالَ لَہُ : اشْتَرِ لِی بِہَا شَیْئًا فَقَالَ : لاَ بَأْسَ ، وَإِنْ ہَلَکَ الَّذِی اشْتَرَی لَہُ فَبَیِّنَتُہُ أَنَّہُ لہُ اشْتَرَاہُ ، وَإِلاَّ لَمْ یُصَدَّقْ أَنَّہُ اشْتَرَاہُ لَہُ ، وَإِنْ کَانَتْ مُضَارَبَۃً فَلاَ یَشْتَرِی لَہُ بِہَا شَیْئًا حَتَّی یَقْبِضَہَا ، أَوْ یُعْطِیَہَا وَلِیًّا لَہُ۔","","Musannaf Ibn Abi Shaybah 21571","","","كتاب البيوع والأقضية"
"21572","(۲۱۵۷۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُکْرَہُ إذَا کَانَ لَہُ عَلَی الرَّجُلِ دَیْنٌ أَنْ یُسْلِمَہُ إلَیْہِ فِی شَیْئٍ حَتَّی یَقْبِضَہُ۔","","Musannaf Ibn Abi Shaybah 21572","","","كتاب البيوع والأقضية"
"21573","(۲۱۵۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنِ الشَّعْبِیِّ : فِی رَجُلٍ کَانَ لَہُ عَلَی رَجُلٍ دَیْنٌ فَأَسْلَمَہُ إلَیْہِ ، قَالَ : لاَ حَتَّی یَقْبِضَہُ۔","","Musannaf Ibn Abi Shaybah 21573","","","كتاب البيوع والأقضية"
"21574","(۲۱۵۷۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ أَبِی شِہَابٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنِ الْحَکَمِ ، قَالَ : تُصْرَفُ الْمُضَارَبَۃُ فِی الدَّیْنِ ، وَلاَ یُصْرَفُ الدَّیْنُ فِی الْمُضَارَبَۃِ۔","","Musannaf Ibn Abi Shaybah 21574","","","كتاب البيوع والأقضية"
"21575","(۲۱۵۷۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانَ ، عَنْ کلیب بنِ وَائِلٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ وسُئِلَ عَنْ رَجُلٍ کَانَ لَہُ عَلَی رَجُلٍ دَیْنٌ ، فَأَرَادَ أَنْ یُسْلِمَہ إلَیْہِ فِی طَعَامٍ فَکَرِہَہُ ، وَقَالَ : لاَ حَتَّی یَقْبِضَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 21575","","","كتاب البيوع والأقضية"
"21576","(۲۱۵۷۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیِّ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عُثْمَانَ أَنَّہُ قَضَی فِی الثَّوْبِ یَشْتَرِیہِ الرَّجُلُ وَبِہِ عَوَارٌ أَنَّہُ یَرُدُّہُ إذَا کَانَ قَدْ لَبِسَہُ۔","","Musannaf Ibn Abi Shaybah 21576","","","كتاب البيوع والأقضية"
"21577","(۲۱۵۷۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ اشْتَری ثَوْبًا ثُمَّ رَأَی فِیہِ عَوَارًا ، قَالَ : یُحَطُّ عَنْہُ مِنْ ثَمَنِہِ مَا یَضَعُ ذَلِکَ الْعَوَارَ۔","","Musannaf Ibn Abi Shaybah 21577","","","كتاب البيوع والأقضية"
"21578","(۲۱۵۷۸) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ یَقُولُ ؛ فِی الرَّجُلِ یَشْتَرِی الثَّوْبَ فَیَرَی فِیہِ الْعَوَارَ ، قَالَ : کَانَ یَقُولُ : إذَا تَغَیَّرَ عَنْ حَالِہِ أَحَبُّ إلَیَّ أَنْ یُجَوِّزَہُ وَیَحُطَّ عَنْہُ قَدْرَ الْعَوَارِ۔","","Musannaf Ibn Abi Shaybah 21578","","","كتاب البيوع والأقضية"
"21579","(۲۱۵۷۹) حَدَّثَنَا حَفْصٌ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إِبْرَاہِیمَ ، عَن شُرَیْحٍ : أَنَّہُ اخْتَصَمَ إلَیْہِ رَجُلاَنِ اشْتَرَی أَحَدُہُمَا مِنَ الآخَرِ رَاوِیَّۃً ، فَقَطَعَہَا ، ثُمَّ وَجَدَ بِہَا عَیْبًا فَقَالَ : الَّذِی أَحْدَثْت فِیہَا أَشَدُّ مِنَ الَّذِی کَانَ بِہَا۔","","Musannaf Ibn Abi Shaybah 21579","","","كتاب البيوع والأقضية"
"21580","(۲۱۵۸۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، عْن رَجُلٍ اشْتَرَی ثَوْبًا فَقَطَّعَہُ فَوَجَدَ بِہِ عَوَارًا ، قَالَ : یَرُدُّہُ۔ وَسَأَلْت حَمَّادًا فَقَالَ : یَرُدُّہُ ، وَیَرُدُّ أَرْشَ التَّقْطِیعِ۔ قَالَ شُعْبَۃُ : وَأَخْبَرَنِی الْہَیْثَمُ ، عَنْ حَمَّادٍ ، أَنَّہُ قَالَ: یُوضَعُ عَنْہُ أَرْشُ الْعَوَارِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21580","","","كتاب البيوع والأقضية"
"21581","(۲۱۵۸۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ جَبَلَۃَ بْنِ سُحَیْمٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ اشْتَرَی قَمِیصًا فَلَبِسَہُ ، فَأَصَابَتْہُ صُفْرَۃٌ مِنْ لِحْیَتِہِ ، فَأَرَادَ أَنْ یَرُدَّہُ فَلَمْ یَرُدَّہُ مِنْ أَجْلِ الصُّفْرَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 21581","","","كتاب البيوع والأقضية"
"21582","(۲۱۵۸۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عُثْمَانَ ، قَالَ : مَنِ اشْتَرَی ثَوْبًا فَوَجَدَ بِہِ عَیْبًا ، فَہُوَ بِالْخِیَارِ۔","","Musannaf Ibn Abi Shaybah 21582","","","كتاب البيوع والأقضية"
"21583","(۲۱۵۸۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ الْمُبَارَکِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ شِہَابٍ ، قَالَ : قَالَ أَبُو بَکْرٍ بْنُ عَبْدِ الرَّحْمَنِ : النَّمَائُ مَعَ الضَّمَانِ ، یَعْنِی الرِّبْحَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21583","","","كتاب البيوع والأقضية"
"21584","(۲۱۵۸۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ؛ فِی الرَّجُلِ یَرُدُّ الْعَبْدَ بِالدَّائِ ، قَالَ : یَرُدُّہُ وَلَہُ الْغَلَّۃُ۔","","Musannaf Ibn Abi Shaybah 21584","","","كتاب البيوع والأقضية"
"21585","(۲۱۵۸۵) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، أَنَّ رَجُلاً اشْتَرَی عَبْدًا فَاسْتَغَلَّہُ ، ثُمَّ جَائَ رَجُلٌ فَادَّعَاہُ فَخَاصَمَہُ إلَی إیَاسِ بْنِ مُعَاوِیَۃَ فَاسْتَحَقَّہُ ، فَقَضَی لَہُ بِالْعَبْدِ وَبِغَلَّتِہِ ، وَقَضَی لِلرَّجُلِ عَلَی صَاحِبِہِ الَّذِی اشْتَرَاہُ مِنْہُ بِمِثْلِ الْعَبْدِ وَبِمِثْلِ غَلَّتِہِ۔ قَالَ : فَذَکَرْت ذَلِکَ لِمُحَمَّدِ بْنِ سِیرِینَ قَالَ : ہُوَ فَہِمٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 21585","","","كتاب البيوع والأقضية"
"21586","(۲۱۵۸۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ اشْتَرَی عَبْدًا فَاطَّلَعَ عَلَی عَیْبٍ وَقَدِ اسْتَغَلَّہُ، قَالَ : الْغَلَّۃُ لِلْمُشْتَرِی۔","","Musannaf Ibn Abi Shaybah 21586","","","كتاب البيوع والأقضية"
"21587","(۲۱۵۸۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، قَالَ : الْغَلَّۃُ لَہُ بِالضَّمَانِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21587","","","كتاب البيوع والأقضية"
"21588","(۲۱۵۸۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ الْعُکْلِیِّ : فِی رَجُلٍ اشْتَرَی د??ارًا فَاسْتَغَلَّہَا ، ثُمَّ جَائَ رَجُلٌ فَاسْتَحَقَّہَا ، قَالَ : لاَ أجْعَلُ لَہُ مِنَ الْغَلَّۃِ شَیْئاً ، یَعْنِی الْمُسْتَحِقَّ۔n وَفِی أشباہ ہَذَا فِیمَنَ اسْتَنقذَ مَنْ فِی یَدَیْہِ۔","","Musannaf Ibn Abi Shaybah 21588","","","كتاب البيوع والأقضية"
"21589","(۲۱۵۸۹) حَدَّثَنَا وَکِیعٌ ، وَابْنُ إدْرِیسَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ مَخْلَدِ بْنِ خُفَافٍ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ قَالَتْ: قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّ الْخَرَاجَ بِالضَّمَانِ۔ (ابوداؤد ۳۵۰۲۔ ترمذی ۱۲۸۵)","Hasan","Musannaf Ibn Abi Shaybah 21589","","","كتاب البيوع والأقضية"
"21590","(۲۱۵۹۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ لَہُ : الْغَلَّۃُ بِالضَّمَانِ۔","","Musannaf Ibn Abi Shaybah 21590","","","كتاب البيوع والأقضية"
"21591","(۲۱۵۹۱) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنِ ابْنِ لَہِیعَۃَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ : فِی رَجُلٍ بَاعَ دَارًا لابنہ ، وَکَانَ الأَبُ یَرْہَق ، فَجَائَ الابْنُ إلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، فَأَبْطَلَ بَیْعَہُ ، وَقَضَی لَہُ بِالدَّارِ ، فَقَالَ : غَلَّتُہَا ؟ فَقَالَ : غَلَّتُہَا بِضَمَانِہَا۔","","Musannaf Ibn Abi Shaybah 21591","","","كتاب البيوع والأقضية"
"21592","(۲۱۵۹۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَنْ مُطَرِّفٍ ، عَنْ رَجُلٍ یُقَالُ لَہُ حَجَّاجٌ ، عَنْ شُرَیْحٍ : فِی رَجُلٍ غَصَبَ عَبْدًا فَاسْتَغَلَّہُ ، قَالَ : یَرُدُّ الْغَلَّۃَ۔","","Musannaf Ibn Abi Shaybah 21592","","","كتاب البيوع والأقضية"
"21593","(۲۱۵۹۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، أَنَّ زَیْدَ بْنَ ثَابِتٍ وَالزُّبَیْرَ بْنَ الْعَوَّامِ لَمْ یَرَیَا بَأْسًا أَنْ یَشْتَرِیَ الرَّجُلُ مَا فِی رُؤُوسِ النَّخْلِ إذَا أَدْرَکَ ، ثُمَّ یَبِیعُہُ فِی رُؤُوسِ النَّخْلِ قَبْلَ أَنْ یَصْرِمَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 21593","","","كتاب البيوع والأقضية"
"21594","(۲۱۵۹۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ أَنَّہُ کَرِہَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 21594","","","كتاب البيوع والأقضية"
"21595","(۲۱۵۹۵) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ مُحَمَّدٍ ، أَنَّہُ قَالَ : إذَا اشْتَرَی الرَّجُلُ التَّمْرَ عَلَی رُؤُوسِ النَّخْلِ ، فَلاَ یَبِیعُہَا حَتَّی یَقْبِضہا۔","","Musannaf Ibn Abi Shaybah 21595","","","كتاب البيوع والأقضية"
"21596","(۲۱۵۹۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ عکرمۃ ، أنہ کان یکرہ إذا اشتری الثمرۃ علی رؤوس النخل أن یبیعہا حتی یصرمہا۔","","Musannaf Ibn Abi Shaybah 21596","","","كتاب البيوع والأقضية"
"21597","(۲۱۵۹۷) حَدَّثَنَا یزید بن ہارون ، عن ہشام ، عن الحسن : فی الرَّجُلُ یشتری التَّمْرَ عَلَی رُؤُوسِ النَّخْلِ ، قَالَ : لاَ بَأْسَ أَنْ یَبِیعَہُ قَبْلَ أَنْ یَصْرِمَہُ۔ قَالَ: وَکَانَ مُحَمَّدٌ لاَ یَرَی بِہِ زَمَانًا بَأْسًا ، فَلَمَّا أَکْثَرُوا عَلَیْہِ فِیہِ ، قَالَ : دَعُوا مَا یَرِیبُکُمْ إلَی مَا لاَ یَرِیبُکُمْ۔","","Musannaf Ibn Abi Shaybah 21597","","","كتاب البيوع والأقضية"
"21598","(۲۱۵۹۸) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ ثَعْلَبَۃَ بْنِ الْفُرَاتِ الأَنْصَارِیِّ ، قَالَ : بِعْت قَوْمًا ثَوْبًا وَارْتَہَنْت مِنْہُمْ رَہْنًا إلَی أَجَلٍ ، فَلَمَّا حَلَّ الأَجَلُ اشْتَرَیْت مِنْہُمْ نَخْلاً بِمَا لِی عَلَیْہِمْ ، فَقَبَضْتہ وَیَبَّسْتہ فِی رُؤُوسِ النَّخْلِ ، فَوَقَعَ مِنْہُ عِذْقٌ ، فَأَخَذْتہ ، ثُمَّ جَائَوونِی الَّذِینَ بَاعُونِیہِ ، فَرَغِبُوا إلَیَّ فِی الثَّمَرِ فَبِعْتہ مِنْہُمْ إلَی أَجَلٍ ، فَأَکْثَرَ النَّاسُ فِی ذَلِکَ ، فَسَأَلْت سَالِمًا وَقَصَصْت عَلَیْہِ الْقِصَّۃَ ، فَقَالَ : کَانَ فِی نَفْسِکَ أَنْ تَبِیعَہُ مِنْہُمْ ؟ قُلْتُ : لاَ وَاللَّہِ ، وَلاَ خَطَرَ عَلَی قَلْبِی ، فَقَالَ : لاَ بَأْسَ۔ قَالَ : وَسَأَلْت الْقَاسِمَ فَقَالَ : کَانَ فِی نَفْسِکَ أَنْ تَبِیعَہُ مِنْہُمْ ؟ قُلْتُ : لاَ وَاللَّہِ ، وَلاَ خَطَرَ عَلَی قَلْبِی ، قَالَ : لاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 21598","","","كتاب البيوع والأقضية"
"21599","(۲۱۵۹۹) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ ہَارُونَ بْنِ مُوسَی النَّحْوِیِّ ، قَالَ : أَخْبَرَنِی الزُّبَیْرُ بْنُ خِرِّیتٍ ، عَنْ عِکْرِمَۃَ ؛ فِی الرَّجُلِ یَشْتَرِی ثَمَرَۃ النَّخْلِ ، قَالَ : لاَ یَبِعْہُ حَتَّی یَصْرِمَہُ۔","","Musannaf Ibn Abi Shaybah 21599","","","كتاب البيوع والأقضية"
"21600","(۲۱۶۰۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ أَیُّوبَ، عَنْ أَبِی الزُّبَیْرِ، عَنْ جَابِرٍ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ الثُّنْیَا۔n(مسلم ۱۱۷۵۔ احمد ۳۱۳)","Sahih","Musannaf Ibn Abi Shaybah 21600","","","كتاب البيوع والأقضية"
"21601","(۲۱۶۰۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، قَالَ : قُلْتُ لِسَعِیدِ بْنِ الْمُسَیَّبِ : أَبِیعُ تَمْرَ أَرْضِی وَأَسْتَثْنِی ؟ قَالَ : لاَ تَسْتَثْنِی إلاَّ شَجَرًا مَعْلُومًا ، وَلاَ تَبْرَأْنَّ مِنَ الصَّدَقَۃِ۔ قَالَ : فَذَکَرْتہ لِمُحَمَّدِ بْنِ سِیرِینَ فَکَأَنَّہُ أَعْجَبَہُ۔","","Musannaf Ibn Abi Shaybah 21601","","","كتاب البيوع والأقضية"
"21602","(۲۱۶۰۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عُلَیَّۃَ ، وَابْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الْقَاسِمِ ، قَالَ : لَوْلا أَنَّ ابْنَ عُمَرَ کَرِہَ الثُّنْیَا وَکَانَ عِنْدَنَا مَرَضِیًّا مَا رَأَیْنَا بِذَلِکَ بَأْسًا۔ زَادَ ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ : فَتَحَدَّثَنَا أَنَّ ابْنَ عُمَرَ کَانَ یَقُولُ : لاَ أَبِیعُ ہَذِہِ النَّخْلَۃَ ، وَلاَ أَبِیعُ ہَذِہِ النَّخْلَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 21602","","","كتاب البيوع والأقضية"
"21603","(۲۱۶۰۳) حَدَّثَنَا عَبَّادٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، أَنَّہُ کَرِہَ أَنْ یَشْتَرِی شَیْئًا ِمَن النَّخْل بِکَیْلٍ۔","","Musannaf Ibn Abi Shaybah 21603","","","كتاب البيوع والأقضية"
"21604","(۲۱۶۰۴) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ أَبِی حَمْزَۃَ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : أَبیعُ الرَّجُلُ الشَّاۃَ وَیَسْتَثْنِی بَعْضَہَا ، قَالَ: لاَ ، وَلَکِنْ قُلْ : أَبِیعُک نِصْفَہَا۔","","Musannaf Ibn Abi Shaybah 21604","","","كتاب البيوع والأقضية"
"21605","(۲۱۶۰۵) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ أَبِی الْجَارُودِ ، قَالَ : سَأَلْتُ جَابِرَ بْنَ زَیْدٍ عَنِ الرَّجُلِ یَبِیعُ الْبَیْعَ وَیَسْتَثْنِی بَعْضَہُ، قَالَ : لاَ یَصْلُحُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 21605","","","كتاب البيوع والأقضية"
"21606","(۲۱۶۰۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَبِیعُ ، تَمْرَ أَرْضِہِ وَیَسْتَثْنِی الْکُرَّ ، قَالَ : کَانَ یُعْجِبُہُ أَنْ یُعْلِمَ نَخْلاً۔","No Data Available","Musannaf Ibn Abi Shaybah 21606","","","كتاب البيوع والأقضية"
"21607","(۲۱۶۰۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَجَّاجٍ ، قَالَ : سَأَلْتُ أَبَا بَکْرِ بْنَ أَبِی مُوسَی عَنْ رَجُلٍ بَاعَ مِنْ رَجُلٍ سِلْعَۃً ، وَقَالَ : أَنَا شَرِیکٌ فِیہَا ، قَالَ : فَکَرِہَ ہَذَا الْبَیْعَ۔","","Musannaf Ibn Abi Shaybah 21607","","","كتاب البيوع والأقضية"
"21608","(۲۱۶۰۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عَمْرِو بْنِ عَامِرٍ ، عَنْ قَتَادَۃَ ، عَنْ سَالِمٍ ، أَنَّہُ کَرِہَ أَنْ یَسْتَثْنِیَ کَیْلاً ، أَوْ سِلاَلاً ، أَوْ کِرَارًا۔","","Musannaf Ibn Abi Shaybah 21608","","","كتاب البيوع والأقضية"
"21609","(۲۱۶۰۹) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ : أَنَّہُ بَاعَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعِیرًا وَاشْتَرَطَ ظَہْرَہُ إلَی الْمَدِینَۃِ۔ (بخاری ۴۴۳۔ ابوداؤد ۳۴۹۹)","Sahih","Musannaf Ibn Abi Shaybah 21609","","","كتاب البيوع والأقضية"
"21610","(۲۱۶۱۰) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ أَبِی بَکْرِ بْنِ عَمْرِو بْنِ حَزْمٍ ، عَنْ أَبِیہِ أَنَّہُ بَاعَ ، ثَمَرَۃً لَہُ بِأَرْبَعَۃِ آلاَفٍ وَاسْتَثْنَی مِنْہَا ثَمَانَمِئَۃٍ درہم۔","","Musannaf Ibn Abi Shaybah 21610","","","كتاب البيوع والأقضية"
"21611","(۲۱۶۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ إسْمَاعِیلَ بْنِ مُجَمِّعٍ ، عَنْ سَالِمٍ : أنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَبِیعَ ، ثَمَرَتَہُ وَیَسْتَثْنِیَ مِنْہَا مَکِیلَۃً مَعْلُومَۃً۔","","Musannaf Ibn Abi Shaybah 21611","","","كتاب البيوع والأقضية"
"21612","(۲۱۶۱۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ بَشِیرٍ ، عَنْ أَبِی حَازِمٍ ، قَالَ : اشْتَرَیْنَا مِنَ ابْنِ عُمَرَ ثَنْیًا وَاسْتَثْنَی بَعْضَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 21612","","","كتاب البيوع والأقضية"
"21613","(۲۱۶۱۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ یَزِیدَ ، عَنِ ابْنِ سِیرِینَ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَبِیعَ الرَّجُلُ ، ثمَرَتَہُ وَیَسْتَثْنِیَ ثُلُثَہَ ، رُبُعَہ ، َنِصْفَہَ۔","","Musannaf Ibn Abi Shaybah 21613","","","كتاب البيوع والأقضية"
"21614","(۲۱۶۱۴) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ أبی الرجال ، عن أمہ عمرۃ : أنہا کانت تبیع ثمرۃ أرضہا ، وتستثنی منہا۔","No Data Available","Musannaf Ibn Abi Shaybah 21614","","","كتاب البيوع والأقضية"
"21615","(۲۱۶۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرِ بْنِ عَمْرِو بْنِ حَزْمٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ : أَنَّہُ بَاعَ ، ثمرۃً بِأَرْبَعَۃِ آلاَفٍ درہمٍ ، أَوْ بِثَلاَثَۃِ ، وَاسْتَثْنَی مِنْہَا سَبْعَمِئَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 21615","","","كتاب البيوع والأقضية"
"21616","(۲۱۶۱۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ وَالأَعْمَش ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَبِیعَ السِّلْعَۃَ وَیَسْتَثْنِیَ نِصْفَہَا۔","","Musannaf Ibn Abi Shaybah 21616","","","كتاب البيوع والأقضية"
"21617","(۲۱۶۱۷) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ رَبِیعَۃَ الرَّأْیِ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ : أَنَّہُ بَاعَ ثَمرَتَہُ ، وَاسْتَثْنَی مِنْہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 21617","","","كتاب البيوع والأقضية"
"21618","(۲۱۶۱۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ ، قَالَ : کَانَ لاِمْرَأَۃِ إبْرَاہِیمَ عَلَی إبْرَاہِیمَ شَیْئٌ ، فَأَمَرَنِی أَنْ أُعْطِیَہَا بِقِیمَۃِ الدَّرَاہِمِ دَنَانِیرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21618","","","كتاب البيوع والأقضية"
"21619","(۲۱۶۱۹) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ یَکُونُ عَلَیْہِ الْوَرِقُ ، فَیُعْطِی قِیمَتَہا دَنَانِیرَ ، إذَا قَامَتْ عَلَی سِعْرٍ ، وَیَکُونُ عَلَیْہِ الدَّنَانِیرُ ، فَیُعْطِی الْوَرِقَ بِقِیمَتِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 21619","","","كتاب البيوع والأقضية"
"21620","(۲۱۶۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ السُّدِّیِّ ، عَنِ الْبَہِیِّ ، عَنْ یَسَارِ بْنِ نُمَیْرٍ ، عَنْ عُمَرَ : أَنَّہُ لَمْ یَرَ بَأْسًا بِاقْتِضَائِ الذَّہَبِ مِنَ الْوَرِقِ ، وَالْوَرِقِ مِنَ الذَّہَبِ۔","Hasan","Musannaf Ibn Abi Shaybah 21620","","","كتاب البيوع والأقضية"
"21621","(۲۱۶۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ نَافِعٍ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ ، عَنْ رَجُلٍ اقْتَضَی ذَہَبًا مِنْ وَرِقٍ ، أَوْ وَرِقًا مِنْ ذَہَبٍ فِی الْقَرْضِ ، قَالَ : لاَ بَأْسَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21621","","","كتاب البيوع والأقضية"
"21622","(۲۱۶۲۲) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ : أَنَّہُ لَمْ یَرَ بِہِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 21622","","","كتاب البيوع والأقضية"
"21623","(۲۱۶۲۳) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ وَقَتَادَۃَ ، أَنَّہُمَا قَالاَ : لاَ بَأْسَ بِذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21623","","","كتاب البيوع والأقضية"
"21624","(۲۱۶۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ یونس ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِاقْتِضَائِ الذَّہَبِ مِنَ الْوَرِقِ وَالْوَرِقِ مِنَ الذَّہَبِ بِقِیمَۃِ السُّوقِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21624","","","كتاب البيوع والأقضية"
"21625","(۲۱۶۲۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21625","","","كتاب البيوع والأقضية"
"21626","(۲۱۶۲۶) حَدَّثَنَا أَبُو بَکْرٍ الحنَفیُّ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 21626","","","كتاب البيوع والأقضية"
"21627","(۲۱۶۲۷) حَدَّثَنَا ابْنُ أَبِی غَنیَّۃ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَکُونَ لِلرَّجُلِ عَلَی الرَّجُلِ دَنَانِیرُ فَیَأْخُذُ منْہُ الدَّرَاہِمَ یَصْرِفُہَا، وَلاَ یَرَی بَأْسًا أَنْ یَزِیدَہُ عَلَی السِّعْرِ، أَوْ یَنْتقصَ مِنْہُ إذَا کَانَ عَنْ تَرَاضٍ مِنْہُمَا۔","","Musannaf Ibn Abi Shaybah 21627","","","كتاب البيوع والأقضية"
"21628","(۲۱۶۲۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : کَانَ یَکْرَہُ اقْتِضَائَ الذَّہَبِ مِنَ الْوَرِقِ ، وَالْوَرِقِ مِنَ الذَّہَبِ۔","Sahih","Musannaf Ibn Abi Shaybah 21628","","","كتاب البيوع والأقضية"
"21629","(۲۱۶۲۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَرِہَ أَنْ یُعْطی الذَّہَبَ مِنَ الْوَرِقِ ، وَالْوَرِقَ مِنَ الذَّہَبِ۔","Sahih","Musannaf Ibn Abi Shaybah 21629","","","كتاب البيوع والأقضية"
"21630","(۲۱۶۳۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : قَالَ لِی أَبُو عُبَیْدَۃَ بْنُ عَبْدِ اللہِ بْنِ مَسْعُودٍ : لاَ تَأْخُذَ الذَّہَبَ مِنَ الْوَرِقِ یَکُونُ لَکَ عَلَی الرَّجُلِ ، وَلاَ تَأْخُذَنَّ الْوَرِقَ مِنَ الذَّہَبِ۔","","Musannaf Ibn Abi Shaybah 21630","","","كتاب البيوع والأقضية"
"21631","(۲۱۶۳۱) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ مُبَارَکٍ ، عَنْ یَحْیَی ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : سَأَلْتُہ عَنِ الرَّجُلِ یُقْرِضُ الرَّجُلَ الدَّرَاہِمَ فَیَأْخُذُ مِنْہُ الدَّنَانِیرَ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 21631","","","كتاب البيوع والأقضية"
"21632","(۲۱۶۳۲) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ مَعْمَرٍ ، عَنْ یَحْیَی ، عَنْ أَبِی سَلَمَۃَ : أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 21632","","","كتاب البيوع والأقضية"
"21633","(۲۱۶۳۳) حَدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ : فِی رَجُلٍ کَانَتْ لَہُ عَلَی رَجُلٍ دَرَاہِمُ فَأَخَذَ مِنْہَا ، ثُمَّ أَرَادَ أَنْ یَأْخُذَ بِقِیمَتِہَا دَنَانِیرَ فَکَرِہَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21633","","","كتاب البيوع والأقضية"
"21634","(۲۱۶۳۴) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، قَالَ : أَخْبَرَنِی عَطَائٌ مَوْلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ: ابْتَعْت مِنْ بُرْدٍ مَوْلَی سَعِیدِ بْنِ الْمُسَیَّبِ نَاقَۃً بِأَرْبَعَۃِ دَنَانِیرَ، فَجَائَ یَلْتَمِسُ حَقَّہُ مِنِّی، فَقُلْتُ: عِنْدِی دَرَاہِمُ، لَیْسَ عِنْدِی دَنَانِیرُ فَقَالَ : حَتَّی أَسْتَأْمِرَ سَعِیدَ بْنَ الْمُسَیَّبِ ، فَاسْتَأْمَرَہُ فَقَالَ : خُذْ مِنْہُ دَنَانِیرَ عَیْنًا ، فَإِنْ أَبَی فَدَعْہُ ، مَوْعِدُہُ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 21634","","","كتاب البيوع والأقضية"
"21635","(۲۱۶۳۵) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : بَلَغَنِی أَنَّ ابْنَ مَسْعُودٍ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 21635","","","كتاب البيوع والأقضية"
"21636","(۲۱۶۳۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبْدِ اللہِ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 21636","","","كتاب البيوع والأقضية"
"21637","(۲۱۶۳۷) حَدَّثَنَا شَرِیکٌ بنِ عَبْدِ اللہِ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، قَالَ : سَأَلْتُ مُوسَی بْنَ طَلْحَۃَ فَحَدَّثَنِی ، أَنَّ عُثْمَانَ أَقْطَعَ خَبَّابًا أَرْضًا ، وَعَبْدَ اللہِ أَرْضًا ، وَسَعْدًا أَرْضًا ، وَصُہَیْبًا أَرْضًا ، فَکُلاَّ جَارِیَّ قَدْ رَأَیْتہ یُعْطِی أَرْضَہُ بِالثُّلُثِ وَالرُّبُعِ : عَبْدَ اللہِ وَسَعْدًا۔","Hasan","Musannaf Ibn Abi Shaybah 21637","","","كتاب البيوع والأقضية"
"21638","(۲۱۶۳۸) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : لَقَدْ أَعْطَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَرْضَہُ بِخَیْبَرَ یَعْنِی بِنِصْفٍ۔","Da'if","Musannaf Ibn Abi Shaybah 21638","","","كتاب البيوع والأقضية"
"21639","(۲۱۶۳۹) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ مُوسَی بْنِ طَلْحَۃَ ، قَالَ : کَانَ سَعْدُ ، وَابْنُ مَسْعُودٍ یُزَارِعَانِ بِالثُّلُثِ وَالرُّبُعِ","Hasan","Musannaf Ibn Abi Shaybah 21639","","","كتاب البيوع والأقضية"
"21640","(۲۱۶۴۰) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : جَائَنَا مُعَاذٌ وَنَحْنُ نُعْطِی أَرْضَنَا بِالثُّلُثِ وَالرُّبُعِ فَلَمْ یَعِبْ ذَلِکَ عَلَیْنَا۔","Da'if","Musannaf Ibn Abi Shaybah 21640","","","كتاب البيوع والأقضية"
"21641","(۲۱۶۴۱) حَدَّثَنَا ابْنُ فُضَیْلٍ بنِ عِیَاضٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنْ مُعَاذٍ بِنَحْوِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 21641","","","كتاب البيوع والأقضية"
"21642","(۲۱۶۴۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : عَامَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَہْلَ خَیْبَرَ عَلَی الشَّطْرِ ، ثُمَّ أَبُو بَکْرٍ وَعُمَر وَعُثْمَانُ وَعَلِیٌّ ، ثُمَّ أَہْلُوہُمْ إلَی الْیَوْمِ یُعْطُونَ الثُّلُثَ وَالرُّبُعَ۔","","Musannaf Ibn Abi Shaybah 21642","","","كتاب البيوع والأقضية"
"21643","(۲۱۶۴۳) حَدَّثَنَا أَبُو أُسَامَۃَ وَوَکِیعٌ ، عَنْ عَمْرِو بْنِ عُثْمَانَ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : سَأَلْتُہ ، عَنِ الْمُزَارَعَۃِ بِالثُّلُثِ وَالرُّبُعِ ، فَقَالَ : إِنْ نَظَرْتَ فِی آلِ أَبِی بَکْرٍ وَآلِ عُمَرَ وَآلِ عَلِیٍّ وَجَدْتہمْ یَفْعَلُونَ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21643","","","كتاب البيوع والأقضية"
"21644","(۲۱۶۴۴) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، وَأَبُو الأَحْوَص ، عَنْ کُلَیْبِ بْنِ وَائِلٍ ، قَالَ : قُلْتُ لاِبْنِ عُمَرَ : رَجُلٌ لَہُ أَرْضٌ وَمَائٌ، لَیْسَ لَہُ بَذْرٌ ، وَلاَ بَقَرٌ ، فَأَعْطَانِی أَرْضَہُ بِالنِّصْفِ فَزَرَعْتہَا بِبَذْرِی وَبَقَرِی ، ثُمَّ قَاسَمْتہ عَلَی النِّصْفِ، قَالَ: حَسَنٌ۔","Hasan","Musannaf Ibn Abi Shaybah 21644","","","كتاب البيوع والأقضية"
"21645","(۲۱۶۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْحَارِثِ بنِ حَصِیرَۃَ ، عَنْ صَخْرِ بْنِ الْوَلِیدِ ، عَنْ عَمْرٍو بْنِ صُلَیعٍ ، عَنْ عَلِیٍّ : أَنَّہُ لَمْ یَرَ بَأْسًا بِالْمُزَارَعَۃِ عَلَی النِّصْفِ۔","Da'if","Musannaf Ibn Abi Shaybah 21645","","","كتاب البيوع والأقضية"
"21646","(۲۱۶۴۶) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ، عَنْ رَجُلٍ، عَنْ أَنَسٍ، قَالَ: أَرْضِی وَبَعیرِی سَوَائٌ۔","Da'if","Musannaf Ibn Abi Shaybah 21646","","","كتاب البيوع والأقضية"
"21647","(۲۱۶۴۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو سَمِعَ سَالِمًا یَقُولُ : أَکْثَرَ رَافِعُ بْنُ خَدِیجٍ عَلَی نَفْسِہِ ، وَاللَّہِ لَنکْرِیَنَّہَا کِرَائَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 21647","","","كتاب البيوع والأقضية"
"21648","(۲۱۶۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ الْقَنَّادِ ، قَالَ : سَمِعْتُ طَاوُوسًا یَقُولُ : لاَ بَأْسَ بِالْمُزَارَعَۃِ بِالنِّصْفِ وَالثُّلُثِ وَالرُّبُعِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21648","","","كتاب البيوع والأقضية"
"21649","(۲۱۶۴۹) حَدَّثَنَا ابْنُ مُسْہِرٍ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ، عَنِ ابْنِ الأَسْوَدِ: أَنَّہُ کَانَ یُزَارِعُ أَہْلَ السَّوَادِ حَیَاۃَ أَبِیہِ۔","","Musannaf Ibn Abi Shaybah 21649","","","كتاب البيوع والأقضية"
"21650","(۲۱۶۵۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنِ ابْنِ عَامِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ : کُنْتُ أُزَارِعُ بِالثُّلُثِ وَالرُّبُعِ وَأَحْمِلُہُ إلَی عَلْقَمَۃَ وَالأَسْوَدِ فَلَوْ رَأَوا بِہِ بَأْسًا لَنَہُونِی عَنْہُ۔","","Musannaf Ibn Abi Shaybah 21650","","","كتاب البيوع والأقضية"
"21651","(۲۱۶۵۱) حَدَّثَنَا حَفْصٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ : أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَانَ یَأْمُرُ بِإِعْطَائِ الأَرْضِ بِالثُّلُثِ وَالرُّبُعِ۔","","Musannaf Ibn Abi Shaybah 21651","","","كتاب البيوع والأقضية"
"21652","(۲۱۶۵۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدِ الْحَذَّائِ : أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ إلَی عَدِیٍّ أَنْ یُزَارِعَ بِالثُّلُثِ وَالرُّبُعِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21652","","","كتاب البيوع والأقضية"
"21653","(۲۱۶۵۳) حَدَّثَنَا فُضَیْلٌ ، عَنْ ہِشَامٍ ، عَنِ الْقَاسِمِ ، وَابْنِ سِیرِینَ : أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا أَنْ یُعْطِیَ الرَّجُلُ أَرْضَہُ آخَرَ عَلَی أَنْ یُعْطِیَہُ الثُّلُثَ ، أَوِ الرُّبُعَ ، أَوِ الْعُشْرَ ، وَلاَ یَکُونُ عَلَیْہِ مِنَ النَّفَقَۃِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 21653","","","كتاب البيوع والأقضية"
"21654","(۲۱۶۵۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : کَانَ أَبِی لاَ یَرَی بِکَرَائِ الأَرْضِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 21654","","","كتاب البيوع والأقضية"
"21655","(۲۱۶۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ عُبَیْدٍ ، قَالَ : سَأَلْتُ سَالِمًا عَنْہُ فَقَالَ : لاَ بَأْسَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21655","","","كتاب البيوع والأقضية"
"21656","(۲۱۶۵۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنْ أَبِی عُبَیْدَۃَ بْنِ مُحَمَّدِ بْنِ عَمَّارِ بْنِ یَاسِرٍ ، عَنِ الْوَلِیدِ بْنِ أَبِی الْوَلِیدِ ، عَنْ عُرْوَۃَ بْنِ الزُّبَیْرِ ، قَالَ ، قَالَ زَیْدُ بْنُ ثَابِتٍ : یَغْفِرُ اللَّہُ لِرَافِعِ بْنِ خَدِیجٍ ، أَنَا وَاللَّہِ أَعْلَمُ بِالْحَدِیثِ مِنْہُ ، إنَّمَا أَتَاہُ رَجُلاَنِ قَدَ اقْتَتَلاَ فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنْ کَانَ ہَذَا شَأْنُکُمْ فَلاَ تُکْرُوا الْمَزَارِعَ ، فَسَمِعَ رَافِعٌ قَوْلَہُ : لاَ تُکْرُوا الْمَزَارِعَ۔ (ابوداؤد ۳۳۸۳۔ احمد ۱۸۲)","Hasan","Musannaf Ibn Abi Shaybah 21656","","","كتاب البيوع والأقضية"
"21657","(۲۱۶۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : مَا بِالْمَدِینَۃِ أَہْلُ بَیْتِ ہِجْرَۃٍ إلاَّ وَہُمْ یُعْطُونَ أَرْضَہُمْ بِالثُّلُثِ وَالرُّبُعِ۔","Sahih","Musannaf Ibn Abi Shaybah 21657","","","كتاب البيوع والأقضية"
"21658","(۲۱۶۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ : أَنَّہُ کَانَ یَدْفَعُ أَرْضَہُ بِالثُّلُثِ۔","Sahih","Musannaf Ibn Abi Shaybah 21658","","","كتاب البيوع والأقضية"
"21659","(۲۱۶۵۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ بْنِ عِیسَی ، عَنْ مُوسَی بْنِ عَبْدِ اللہِ بْنِ یَزِیدَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : أَرْضِی وَبَعِیرِی سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 21659","","","كتاب البيوع والأقضية"
"21660","(۲۱۶۶۰) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : أنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَامَلَ أَہْلَ خَیْبَرَ عَلَی الشَّطْرِ۔ (مسلم ۱۱۸۶۔ ابوداؤد ۲۹۹۹)","Sahih","Musannaf Ibn Abi Shaybah 21660","","","كتاب البيوع والأقضية"
"21661","(۲۱۶۶۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیان ، حدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ اللہِ بْنِ عِیسَی ، قَالَ : کَانَ لِعَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی أَرْضٌ بِالْفَوَّارَۃِ ، فَکَانَ یَدْفَعُہَا بِالثُّلُثِ وَالرُّبُعِ ، فَیُرْسِلُنِی أُقَاسِمُہُمْ۔","","Musannaf Ibn Abi Shaybah 21661","","","كتاب البيوع والأقضية"
"21662","(۲۱۶۶۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی حَصِینٍ ، عَنْ مُجَاہِدٍ ، عَنْ رَافِعِ بْنِ خَدِیجٍ ، قَالَ : نَہَانَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ أَمْرٍ کَانَ لَنَا نَافِعًا ، نَہَانَا إذَا کَانَت لأَِحَدِنَا أَرْضٌ أَنْ یُعْطِیَہَا بِبَعْضِ خَرَاجِہَا بِثُلُثٍ ، أَوْ نِصْفٍ ، قَالَ : وَمَنْ کَانَتْ لَہُ أَرْضٌ فَلْیَزْرَعْہَا ، أَوْ لِیَمْنَحْہَا أَخَاہُ۔ (ترمذی ۱۳۸۴)","","Musannaf Ibn Abi Shaybah 21662","","","كتاب البيوع والأقضية"
"21663","(۲۱۶۶۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ، عَنِ الشَّیْبَانِیِّ، عَنْ عَبْدِ اللہِ بْنِ السَّائِبِ، قَالَ: سَأَلْتُ ابْنَ مَعْقِلٍ عَنِ الْمُزَارَعَۃِ؟ فَقَالَ : أَخْبَرَنِی ثَابِتُ بْنُ الضَّحَّاکِ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْہَا۔(مسلم ۱۱۸۔ احمد ۳۳)","Sahih","Musannaf Ibn Abi Shaybah 21663","","","كتاب البيوع والأقضية"
"21664","(۲۱۶۶۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، سَمِعَ عَمْرًا یُحَدِّثُ ، عَنْ جَابِرٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ الْمُخَابَرَۃِ۔n(مسلم ۱۱۷۷۔ نسائی ۴۶۵۱)","Sahih","Musannaf Ibn Abi Shaybah 21664","","","كتاب البيوع والأقضية"
"21665","(۲۱۶۶۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، قَالَ : سَمِعَ عَمْرٌو عَبْدَ اللہِ بْنَ عُمَرَ یَقُولُ : کُنَّا نُخَابِرُ ، وَلاَ نَرَی بِذَلِکَ بَأْسًا حَتَّی زَعَمَ رَافِعُ بْنُ خَدِیجٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْہَا فَتَرَکْنَاہُ مِنْ أَجْلِہِ۔n(مسلم ۱۱۷۹۔ ابوداؤد ۳۳۸۲)","Sahih","Musannaf Ibn Abi Shaybah 21665","","","كتاب البيوع والأقضية"
"21666","(۲۱۶۶۶) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ ثَابِتِ بْنِ الْحَجَّاجِ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْمُخَابَرَۃِ ، قُلْتُ : وَمَا الْمُخَابَرَۃُ ؟ قَالَ : أَنْ تَأْخُذَ الأَرْضَ بِنِصْفٍ ، أَوْ ثُلُثٍ ، أَوْ رُبُعٍ۔ (احمد ۱۸۷۔ عبد بن حمید ۲۵۳)c","Sahih","Musannaf Ibn Abi Shaybah 21666","","","كتاب البيوع والأقضية"
"21667","(۲۱۶۶۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، قَالَ : کُنْتُ جَالِسًا مَعَ ابْنِ عَبَّاسٍ فِی الْمَسْجِدِ الْحَرَامِ إذْ أَتَاہُ رَجُلٌ فَقَالَ : إنَّا نَأْخُذُ الأَرْضَ مِنَ الدَّہَاقِینِ ، فَأَعْتَمِلُہَا بِبَذْرِی وَبَقَرِی ، فَآخُذُ حَقِّی وَأُعْطِیہِ حَقَّہُ ، فَقَالَ لَہُ : خُذْ رَأْسَ مَالِکَ ، وَلاَ تَزدْ عَلَیْہِ شَیْئاً فَأَعَادَہَا عَلَیْہِ ثَلاَثَ مَرَّاتٍ ، کُلُّ ذَلِکَ یَقُولُ لَہُ ہَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 21667","","","كتاب البيوع والأقضية"
"21668","(۲۱۶۶۸) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ الْحَذَّائِ ، عَنْ عِکْرِمَۃَ : أَنَّہُ کَرِہَ الْمُزَارَعَۃَ بِالثُّلُثِ وَالرُّبُعِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21668","","","كتاب البيوع والأقضية"
"21669","(۲۱۶۶۹) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَش ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَرِہَ المُزَارَعَۃ بِالثُّلُثِ وَالرُّبُعِ۔","","Musannaf Ibn Abi Shaybah 21669","","","كتاب البيوع والأقضية"
"21670","(۲۱۶۷۰) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَش ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَرِہَ أَنْ یُعْطِیَ ألأَرْضَ بِالثُّلُثِ وَالرُّبُعِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21670","","","كتاب البيوع والأقضية"
"21671","(۲۱۶۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، أَنَّہُ کَرِہَ کِرَاء ألأَرْضَ۔","Sahih","Musannaf Ibn Abi Shaybah 21671","","","كتاب البيوع والأقضية"
"21672","(۲۱۶۷۲) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، عَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ ، عَنْ طَاوُوسٍ ، قَالَ : لاَ تُکْری الأَرْضَ ، وَلاَ بذَرۃ ، أَوْ قَالَ : مَدَرۃ۔","","Musannaf Ibn Abi Shaybah 21672","","","كتاب البيوع والأقضية"
"21673","(۲۱۶۷۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُمَرُ بْنُ ذَرٍّ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ رَافِعِ بْنِ خَدِیجٍ ، عَنْ أَبِیہِ ، قَالَ : جَائَنَا أَبُو رَافِعٍ مِنْ عِنْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : نَہَانَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ أَمْرٍ کَانَ یَرْفُقُ بِنَا ، وَطَاعَۃُ اللہِ وَطَاعَۃُ رَسُولِہِ أَرْفَقُ بِنَا ، نَہَانَا أَنْ یَزْرَعَ أَحَدُنَا الأَرْضَ إلاَّ أَرْضًا یَمْلِکُ رَقَبَتَہَا ، أَوْ مَنِیحَۃً یَمْنَحُہَا رَجُلٌ۔ (احمد ۴۶۵۔ ابوداؤد ۳۳۹۰)","","Musannaf Ibn Abi Shaybah 21673","","","كتاب البيوع والأقضية"
"21674","(۲۱۶۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ نُصَیْرِ بْنِ أَدْہَمَ ، قَالَ : سَمِعْتُ الضَّحَّاکَ بْنَ مُزَاحِمٍ یَقُولُ : لاَ یَصْلُحُ مِنَ الأَرْضِ إلاَّ خَصْلَتَانِ : أَرْضٌ مَنَحَکہَا رَجُلٌ یَمْلِکُ رَقَبَتَہَا ، أَوْ أَرْضٌ اسْتَأْجَرْتہَا بِأَجْرٍ مَعْلُومٍ إلَی أَجَلٍ مَعْلُومٍ۔","","Musannaf Ibn Abi Shaybah 21674","","","كتاب البيوع والأقضية"
"21675","(۲۱۶۷۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إنَّ أَمْثَلَ أَبْوَابِ الزَّرْعِ أَنْ یَسْتَأْجِرَ الأَرْضَ الْبَیْضَائَ بِأَجْرٍ مَعْلُومٍ۔","","Musannaf Ibn Abi Shaybah 21675","","","كتاب البيوع والأقضية"
"21676","(۲۱۶۷۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ یَصْلُحُ مِنَ الزَّرْعِ إلاَّ أَرْضٌ تَمْلِکُ رَقَبَتَہَا ، أَوْ أَرْضٌ یَمْنَحُکہَا رَجُلٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 21676","","","كتاب البيوع والأقضية"
"21677","(۲۱۶۷۷) حَدَّثَنَا جَرِیرٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ رِفَاعَۃَ بْنِ رَافِعِ بْنِ خَدِیجٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْمُزَارَعَۃِ وَالإِجَارَۃِ : إلا أن یَشْتَرِیَ الرَّجُلُ أَرْضًا ، أَوْ یُعَارَ ، ثُمَّ قَالَ : أَعَارَ أبِی أَرْضًا مِنْ رَجُلٍ فَزَرَعَہَا وَبَنَی فِیہَا بُنْیَانًا ، فَخَرَجَ إلَیْہَا فَرَأَی الْبُنْیَانَ فَقَالَ : مَنْ بَنَی ہَذَا ؟ فَقَالُوا : فُلاَنُ الَّذِی أَعَرْتہ ، فَقَالَ : أَعِوَضٌ مِمَّا أَعْطَیْتہ ؟ قَالُوا : نَعَمْ ، قَالَ : لاَ أَبْرَحُ حَتَّی تَہْدِمُوہُ۔","","Musannaf Ibn Abi Shaybah 21677","","","كتاب البيوع والأقضية"
"21678","(۲۱۶۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی مَکِینٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : لاَ بَأْسَ بِکرَائِ الأَرْضِ بِالطَّعَامِ۔","","Musannaf Ibn Abi Shaybah 21678","","","كتاب البيوع والأقضية"
"21679","(۲۱۶۷۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَسْتَأْجِرَ الرَّجُلُ الأَرْضَ الْبَیْضَائَ بِالْحِنْطَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21679","","","كتاب البيوع والأقضية"
"21680","(۲۱۶۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ زِیَادِ بْنِ أَبِی مُسْلِمٍ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنْ کِرَئِ الأَرْضِ بِالدَّرَاہِمِ وَالطَّعَامِ ، فَلَمْ یَرَ بِہِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 21680","","","كتاب البيوع والأقضية"
"21681","(۲۱۶۸۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ، عَنْ سَعِیدِ، عَنْ أَبِی مَعْشَرٍ، عَنْ إبْرَاہِیمَ، قَالَ: لاَ بَأْسَ أَنْ نَأْخُذَ بِطَعَامٍ مُسَمًّی۔","","Musannaf Ibn Abi Shaybah 21681","","","كتاب البيوع والأقضية"
"21682","(۲۱۶۸۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ یَعْلَی ??ْنِ حَکِیمٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنْ رَافِعِ بْنِ خَدِیجٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَانَتْ لَہُ أَرْضٌ فَلْیَزْرَعْہَا ، أَوْ لِیُزْرِعْہَا أَخَاہُ ، وَلاَ یُکْرِہَا بِثُلُثٍ ، وَلاَ رُبعٍ ، وَلاَ بِطَعَامٍ مُسَمًّی۔ (مسلم ۱۱۳۔ نسائی ۴۶۲۳)","Sahih","Musannaf Ibn Abi Shaybah 21682","","","كتاب البيوع والأقضية"
"21683","(۲۱۶۸۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَتْ دَابَّۃٌ فِی أَیْدِی النَّاسِ مِنَ الأَزْدِ ، فَادَّعَاہَا قَوْمٌ ، فَأَقَامُوا الْبَیِّنَۃَ أَنَّہَا دَابَّتُہُمْ أَضَلُّوہَا فِی زَمَانِ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، فَأَقَامَ الَّذِینَ ہِیَ فِی أَیْدِیہِمَ الْبَیِّنَۃَ أَنَّہُمْ نَتَجُوہَا ، فَرُفِعَ ذَلِکَ إلَی قَاضِیہِمْ عَبْدِ الرَّحْمَنِ بْنِ أُذَیْنَۃَ فَجَعَلَ ہَؤُلاَئِ یَغْدُونَ بِبَیِّنَۃٍ وَیَرُوحُ الآخَرُونَ بِأَکْثَرَ مِنْہُمْ ، فَکَتَبَ فی ذَلِکَ إلَی شُرَیْحٍ فَکَتَبَ إلَیْہِ : لَسْت مِنَ التَّہَاتُرِ وَالتَّکَاثُرِ فِی شَیْئٍ ، وَالَّذِینَ أَقَامُوا الْبَیِّنَۃَ أَنَّہُمْ نَتَجُوہَا وَہِیَ فِی أَیْدِیہِمْ أَحَقُّ ، وَأُولَئِکَ أَوْلَی بِالشُّبْہَۃِ۔","","Musannaf Ibn Abi Shaybah 21683","","","كتاب البيوع والأقضية"
"21684","(۲۱۶۸۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ فِی الرَّجُلَیْنِ یَدَّعِیَانِ الدَّابَّۃَ لَیْسَتْ فِی یَدِ وَاحِدٍ مِنْہُمَا ، فَیُقِیمُ أَحَدُہُمَا شَاہِدَیْنِ ، وَالآخَرُ أَرْبَعَۃً ، فَقَالَ : ہِیَ بَیْنَہُمَا نِصْفَیْنِ ، لأَنَّ الإِثْنَیْنِ یُوجِبَانِ الْحَقَّ۔","No Data Available","Musannaf Ibn Abi Shaybah 21684","","","كتاب البيوع والأقضية"
"21685","(۲۱۶۸۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : ہِیَ بَیْنَہُمْ عَلَی حِصَصِ الشُّہُودِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21685","","","كتاب البيوع والأقضية"
"21686","(۲۱۶۸۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَوْفٍ : أَنَّ ہِشَامَ بْنَ ہُبَیْرَۃَ کَانَ یَقْضِی لأَِکْثَرِ الْفَرِیقَیْنِ شُہُودًا۔","","Musannaf Ibn Abi Shaybah 21686","","","كتاب البيوع والأقضية"
"21687","(۲۱۶۸۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ ، قَالَ : بِعْت بَغْلَۃً مِنْ رَجُلٍ ، فَلَبِثَ مَا شَائَ اللَّہُ ، فَأَتَانِی وَقَدْ عَرَفْت الْبَغْلَۃَ عِنْدَہُ ، فَأَتَیْنَا شُرَیْحًا وَانْطَلَقْت بالدَّابَّۃِ ، فَأَقَامَ سَبْعَۃً مِنَ الشُّہُودِ أَنَّہَا دَابَّتُہُ لَمْ تُبَعْ وَلَمْ تُہَبْ ، وَجَائَ الآخَرُ بِسِتَّۃٍ مِنَ الشُّہُودِ أَنَّہَا دَابَّتُہُ لَمْ تُبَعْ وَلَمْ تُہَبْ ، فَقَالَ شُرَیْحٌ : أَشْہَدُ بِأَنَّ أَحَدَ الْفَرِیقَیْنِ کَاذِبٌ ، فَقَسَمَہَا بَیْنَہُمْ عَلَی ثَلاَثَۃَ عَشَرَ سَہْمًا أَعْطَی کُلَّ وَاحِدٍ مِنْہُمَا بِحِصَّۃِ شُہُودِہِ۔","","Musannaf Ibn Abi Shaybah 21687","","","كتاب البيوع والأقضية"
"21688","(۲۱۶۸۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ سِمَاکٍ ، عَنْ حَنَشِ بْنِ الْمُعْتَمِرِ ، عَنْ عَلِیٍّ ، قَالَ : اخْتَصَمَ إلَیْہِ رَجُلاَنِ فِی بَغْلَۃٍ فَأَقَامَ ہَذَا خَمْسَۃَ شُہَدَائَ بِأَنَّہَا نُتِجَتْ عِنْدَہُ ، وَأَقَامَ ہَذَا شَاہِدَیْنِ بِأَنَّہَا نُتِجَتْ عِنْدَہُ ، فَجَعَلَہَا عَلِیٌّ بَیْنَہُمْ أَسْبَاع۔","Da'if","Musannaf Ibn Abi Shaybah 21688","","","كتاب البيوع والأقضية"
"21689","(۲۱۶۸۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَفْلَسَ الْعَبْدُ الْمَأْذُونُ لَہُ فِی التِّجَارَۃِ فَدَیْنُہُ فِی رَقَبَتِہِ، فَإِنْ شَائَ مَوْلاَہُ أَنْ یَبِیعَہُ بَاعَہُ ، وَیَقْسِمَ ثَمَنَہُ بَیْنَ الْغُرَمَائِ ، وَلَیْسَ عَلَیْہِ أَکْثَرُ مِنْ ثَمَنِہِ۔","","Musannaf Ibn Abi Shaybah 21689","","","كتاب البيوع والأقضية"
"21690","(۲۱۶۹۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إِنْ شَاؤُوا أَنْ یَبِیعُوہُ بَاعُوہُ ، وَإِنْ شَاؤُوا اسْتَسْعَوْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21690","","","كتاب البيوع والأقضية"
"21691","(۲۱۶۹۱) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، أَنَّہُ کَانَ یَقُولُ : إِنْ شَاؤُوا بَاعُوہُ ، وَإِنْ شَاؤُوا اسْتَسْعَوْہُ ، قَالَ : فَکَانَ شُرَیْحٌ یَقُولُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 21691","","","كتاب البيوع والأقضية"
"21692","(۲۱۶۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَکَمِ ، قَالَ : لاَ یُبَاعُ حَتَّی یُحِیطَ الدَّیْنُ بِرَقَبَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21692","","","كتاب البيوع والأقضية"
"21693","(۲۱۶۹۳) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ : أَنَّ عَبْدَ الرَّحْمَن بْنَ أُذَیْنَۃَ أُوتِیَ عَبْدًا رَکِبَہُ دَیْنٌ فَقَالَ : مَالُہُ بِدَیْنِہِ ، مَالُہُ بِدَیْنِہِ۔","","Musannaf Ibn Abi Shaybah 21693","","","كتاب البيوع والأقضية"
"21694","(۲۱۶۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : دَیْنُہُ فِی ثَمَنِہِ۔","","Musannaf Ibn Abi Shaybah 21694","","","كتاب البيوع والأقضية"
"21695","(۲۱۶۹۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْحَسَنُ بْنُ صَالِحٍ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یُبَاعُ الْعَبْدُ فِی الدَّیْنِ ، وَإِنْ کَانَ عَلَیْہِ مِئَۃ أَلْفٍ۔","","Musannaf Ibn Abi Shaybah 21695","","","كتاب البيوع والأقضية"
"21696","(۲۱۶۹۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانَ قَالَ : حَدَّثَنَا حَسَنِ بْنِ عَمْرٍو ، عَنْ رجل ، عَنْ إبْرَاہِیمَ ، قَالَ : یسعی العبد فی الدین ولا یباع۔","","Musannaf Ibn Abi Shaybah 21696","","","كتاب البيوع والأقضية"
"21697","(۲۱۶۹۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ؛ فِی الرَّجُلِ یَأْذَنُ لِعَبْدِہِ أَنْ یَسْتَدِینَ ، قَالَ : کَانَ یُرَی أَنْ یُبَاعَ لِلْغُرَمَائِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21697","","","كتاب البيوع والأقضية"
"21698","(۲۱۶۹۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ سَالِمٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ : أَنَّہُ کَانَ یَقُولُ فِی الرَّجُلِ یَشْتَرِی الْمَتَاعَ فَیَجِدُ بِبَعْضِہِ عَیْبًا ، قَالَ : یَأْخُذُہُ کُلَّہُ ، أَوْ یَرُدُّہُ کُلَّہُ۔","","Musannaf Ibn Abi Shaybah 21698","","","كتاب البيوع والأقضية"
"21699","(۲۱۶۹۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَامِرٍ : فِی الرَّجُلِ یَشْتَرِی الْمَتَاعَ فَیَجِدُ بِبَعْضِہِ عَیْبًا ، قَالَ : یَأْخُذُہُ کُلَّہُ ، أَوْ یَرُدُّہُ کُلَّہُ۔","","Musannaf Ibn Abi Shaybah 21699","","","كتاب البيوع والأقضية"
"21700","(۲۱۷۰۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ الْعُکْلِیِّ ، قَالَ : إذَا اشْتَرَی الرَّجُلُ الْغُلاَمَیْنِ أَوِ السِّلْعَتَیْنِ فَوَجَدَ بِأَحَدَیْہِمَا عَیْبًا فَأَرَادَ رَدَّہَا : رَدَّہَا بِقِیمَتِہَا ، وَجَازَتْ عَلَیْہِ الَّتِی لَیْسَ بِہَا عَیْبٌ۔","","Musannaf Ibn Abi Shaybah 21700","","","كتاب البيوع والأقضية"
"21701","(۲۱۷۰۱) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ : فِی الرَّجُلِ یَشْتَرِی الْعَبِیدَ فَیَجِدُ بِبَعْضِہِمْ عَیْبًا ، فَقَالَ : یُرَدُّ بِقِیمَتِہِ ، وَفِی الْمَتَاعِ مِثْلُہُ ، وَقَالَہُ مُحَمَّدٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 21701","","","كتاب البيوع والأقضية"
"21702","(۲۱۷۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ شُرَیْحٍ : فِی الرَّجُلِ یَشْتَرِی الْمَتَاعَ صَفْقَۃً فَیَجِدُ بِبَعْضِہِ عَیْبًا ، قَالَ : یَأْخُذُہُ جَمِیعًا ، أَوْ یَرُدُّہُ جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 21702","","","كتاب البيوع والأقضية"
"21703","(۲۱۷۰۳) حَدَّثَنَا عَبَّادٌ ، عَنْ أَشْعَثَ ، عَنْ عَامِرٍ ، وَابْنِ سِیرِینَ ، قَالاَ : إذَا ابْتَاعَ الرَّجُلُ بَیْعَ حُکْرَۃٍ فَرَأَی فِیہِ عَیْبًا ، قَالاَ : یَرُدُّہُ کُلَّہُ۔","","Musannaf Ibn Abi Shaybah 21703","","","كتاب البيوع والأقضية"
"21704","(۲۱۷۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ رَجُلٍ ، عَنْ عَطَائٍ : فِی رَجُلٍ اشْتَرَی مَتَاعًا فَوَجَدَ بِبَعْضِہِ عَیْبًا ، قَالَ : یَرُدُّہُ وَیَلْزَمہ مَا بَقِیَ بِالْقِیمَۃِ۔","","Musannaf Ibn Abi Shaybah 21704","","","كتاب البيوع والأقضية"
"21705","(۲۱۷۰۵) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ لَیْثٍ ، عَنْ حَجَّاجِ بْنِ یَسَارٍ : أَنَّ رَجُلاً اشْتَرَی مِنْ رَجُلٍ أزْقَاقًا مِنْ سَمْنٍ وَنَقَدَ صَاحِبَہُ، فَنَقَصَتِ الزِّقَاقُ فَأَرَادَ أَنْ یُقَاصَّہُ بِبَعْضِ الدَّرَاہِمِ، فَقَالَ ابْنُ عُمَرَ: خُذْ بَیْعَک جَمِیعًا، أَوْ رُدَّہُ جَمِیعًا۔","Da'if","Musannaf Ibn Abi Shaybah 21705","","","كتاب البيوع والأقضية"
"21706","(۲۱۷۰۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : نَفَقَۃُ الْمُضَارِبِ مِنْ جَمِیعِ الْمَالِ ، وَقَالَ ابْنُ سِیرِینَ : لَیْسَ کَذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21706","","","كتاب البيوع والأقضية"
"21707","(۲۱۷۰۷) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : الْمُضَارِبُ یُنْفِقُ وَیَکْتَسِی بِالْمَعْرُوفِ ، فَإِنْ رَبِحَ کَانَ مِنْ رِبْحِہِ ، وَإِنْ وَضَعَ کَانَ مِنْ رَأْسِ الْمَالِ۔ قَالَ : وَسَأَلْت ابْنَ سِیرِینَ ، قَالَ : مَا أُحِبُّ أَنْ یُنْفِقَ حَتَّی یَسْتَأْذِنَ رَبَّ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 21707","","","كتاب البيوع والأقضية"
"21708","(۲۱۷۰۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، قَالَ : إِنْ شَائَ الْمُضَارِبُ اسْتَأْجَرَ الأَجِیرَ وَأَطْعَمَ الرَّقِیقَ إذَا کَانَ مِنَ الْمُضَارَبَۃِ ، وَلاَ یَأْکُلُ مَعَہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 21708","","","كتاب البيوع والأقضية"
"21709","(۲۱۷۰۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، قَالَ : لاَ یَشْتَرِطُ الْمُضَارِبُ طَعَامًا ، وَلاَ شَیْئًا یَنْتَفِعُ بِہِ إلاَّ أَنْ یَکُونَ فِیہِ مَنْفَعَۃٌ لِلْمُضَارَبَۃِ ، فَإِنْ لَمْ تَکُنْ فِیہِ مَنْفَعَۃٌ لِلْمُضَارَبَۃِ کَانَ ذَلِکَ فِی مَالِ نَفْسِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21709","","","كتاب البيوع والأقضية"
"21710","(۲۱۷۱۰) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنِ ابْنِ لَہِیعَۃَ ، عَنْ خَالِدِ بْنِ أَبِی عِمْرَانَ ، عَنِ الْقَاسِمِ وَسَالِمٍ : أَنَّہُ سَأَلَہُمَا عَنِ الْمُقَارِضِ یَأْکُلُ وَیَشْرَبُ وَیَکْتَسِی وَیَرْکَبُ بِالْمَعْرُوفِ ، قَالَ : إذَا کَانَ فِی سَبَبِ الْمُضَارَبَۃِ فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 21710","","","كتاب البيوع والأقضية"
"21711","(۲۱۷۱۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الشَّفِیعُ أَحَقُّ بِشُفْعَۃِ جَارِہِ ، یَنْتَظِرُ بِہَا ، وَإِنْ کَانَ غَائِبًا إذَا کَانَتْ طَرِیقُہُمَا وَاحِدَۃً۔n(ابوداؤد ۳۵۱۲۔ ترمذی ۱۳۶۹)","Sahih","Musannaf Ibn Abi Shaybah 21711","","","كتاب البيوع والأقضية"
"21712","(۲۱۷۱۲) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ : أَنَّہُ قَضَی بِالشُّفْعَۃِ لِلشَّرِیکِ بَعْدَ عَشْرِ سِنِینَ وَکَانَ غَائِبًا صَاحِبُہَا۔","","Musannaf Ibn Abi Shaybah 21712","","","كتاب البيوع والأقضية"
"21713","(۲۱۷۱۳) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَرَی الشُّفْعَۃَ لِلصَّغِیرِ وَالْغَائِبِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21713","","","كتاب البيوع والأقضية"
"21714","(۲۱۷۱۴) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ مُطَرِّفٍ ، عَنْ شُرَیْحٍ : فِی الدَّارِ تُبْتَاعُ وَبِہَا شَفِیعٌ غَائِبٌ ، أَوْ صَغِیرٌ ، قَالَ : الْغَائِبُ أَحَقُّ بِالشُّفْعَۃِ حَتَّی یَرْجِعَ ، وَالصَّغِیرُ حَتَّی یَکْبُرَ۔","","Musannaf Ibn Abi Shaybah 21714","","","كتاب البيوع والأقضية"
"21715","(۲۱۷۱۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَیْسَ لِغَائِبٍ شُفْعَۃٌ۔ وَکَانَ الْحَارِثُ یَرَی ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 21715","","","كتاب البيوع والأقضية"
"21716","(۲۱۷۱۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ وَالحَکَم ، قَالاَ : لِلْغَائِبِ شُفْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 21716","","","كتاب البيوع والأقضية"
"21717","(۲۱۷۱۷) حَدَّثَنَا حُمَیْدُ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لِلْغَائِبِ شُفْعَۃٌ تُکْتَبُ إلَیْہِ، فَإِنْ أَخَذَ وَبَعَثَ بِالثَّمَنِ وَإِلاَّ فَلاَ شُفْعَۃَ لَہُ۔","","Musannaf Ibn Abi Shaybah 21717","","","كتاب البيوع والأقضية"
"21718","(۲۱۷۱۸) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، عَنِ الْحَسَنِ وَابْنِ سِیرِینَ ، قَالَ : صَارَ قَوْلُہُمَا إلَی أَنَّ التَّوْلِیَۃَ بَیْعٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 21718","","","كتاب البيوع والأقضية"
"21719","(۲۱۷۱۹) حَدَّثَنَا شَرِیک ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : التَّوْلِیَۃُ بَیْعٌ۔","","Musannaf Ibn Abi Shaybah 21719","","","كتاب البيوع والأقضية"
"21720","(۲۱۷۲۰) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : التَّوْلِیَۃُ بَیْعٌ ، وَلاَ تُوَلَّی حَتَّی تُقْبَضَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21720","","","كتاب البيوع والأقضية"
"21721","(۲۱۷۲۱) حَدَّثَنَا حَفْصٌ وأبو أسامۃ ، عَنْ فطر ، عن الحکم ، قَالَ : التولیۃ بیع۔","","Musannaf Ibn Abi Shaybah 21721","","","كتاب البيوع والأقضية"
"21722","(۲۱۷۲۲) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ لاَ یَرَی بِالتَّوْلِیَۃِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 21722","","","كتاب البيوع والأقضية"
"21723","(۲۱۷۲۳) حَدَّثَنَا حَفْصٌ ، عَنْ أَبِی قَیْسٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : التَّوْلِیَۃُ بَیْعٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 21723","","","كتاب البيوع والأقضية"
"21724","(۲۱۷۲۴) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : التَّوْلِیَۃُ بَیْعٌ۔","","Musannaf Ibn Abi Shaybah 21724","","","كتاب البيوع والأقضية"
"21725","(۲۱۷۲۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، قَالَ : التَّوْلِیَۃُ بَیْعٌ۔","","Musannaf Ibn Abi Shaybah 21725","","","كتاب البيوع والأقضية"
"21726","(۲۱۷۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانَ ، عَنْ حَزْنِ بْنِ بِشْرٍ ، عَنْ رَجَائِ بْنِ الْحَارِثِ : أَنَّ رَجُلاً اجْتَعَلَ فِی عَبْدٍ آبِقٍ ، فَأَخَذَہُ لِیَرُدَّہُ ، فَأَبِقَ مِنْہُ ، فَخَاصَمَہُ إلَی شُرَیْحٍ فَضَمَّنَہُ ، فَبَلَغَ ذَلِکَ عَلِیًّا فَقَالَ : أَسَائَ الْقَضَائَ ، یَحْلِفُ بِاللَّہِ : لاَبِقَ مِنْہُ ، وَلاَ ضَمَانَ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 21726","","","كتاب البيوع والأقضية"
"21727","(۲۱۷۲۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، وَعَبْدَۃُ وَوَکِیعٌ ، عَنِ ابْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ : فِی رَجُلٍ أَخَذَ عَبْدًا آبِقًا لِیَرُدَّہُ ، فَذَہَبَ مِنْہُ ، قَالَ : لَیْسَ عَلَیْہِ شَیْئٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 21727","","","كتاب البيوع والأقضية"
"21728","(۲۱۷۲۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدِ الْقَطَّانُ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لَیْسَ عَلَیْہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 21728","","","كتاب البيوع والأقضية"
"21729","(۲۱۷۲۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، أَنَّ رَجُلاً أَخَذَ عَبْدًا آبِقًا فَأَبَقَ مِنْہُ ، قَالَ : فَجَائَ مَوْلَی الْعَبْدِ فَقَدَّمَہُ إلَی شُرَیْحٍ ، فَقَالَ شُرَیْحٌ : قَدْ أَبِقَ مِنْک قَبْلَہُ ، فَلَیْسَ عَلَیْہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 21729","","","كتاب البيوع والأقضية"
"21730","(۲۱۷۳۰) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ، عَنِ ابْنِ جُرَیْجٍ، قَالَ: قَالَ لِی ابْنُ أَبِی مُلَیْکَۃَ: إِنْ ذَہَبَ مِنْہُ فَلَیْسَ عَلَیْہِ شَیْئٌ","","Musannaf Ibn Abi Shaybah 21730","","","كتاب البيوع والأقضية"
"21731","(۲۱۷۳۱) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ وَأَبِی ہَاشِمٍ وَمَنْصُورٍ قَالُوا : إِنْ فَرَّ مِنَ الَّذِی أَخَذَہُ فَلَیْسَ عَلَیْہِ ضَمَانٌ۔","","Musannaf Ibn Abi Shaybah 21731","","","كتاب البيوع والأقضية"
"21732","(۲۱۷۳۲) حَدَّثَنَا یَحْیَی بْنُ أَبِی زَائِدَۃَ وَابْنُ أَبِی غَنِیَّۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی غَنِیَّۃَ ، عَنِ الْحَکَمِ ، قَالَ : قدِّمَ لِعُثْمَانَ طَعَامٌ عَلَی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : اذْہَبُوا بِنَا إلَی عُثْمَانَ نُعِینُہُ عَلَی بَیْعِ طَعَامِہِ ، فَقَامَ إلَی جَنْبِہِ وَعُثْمَانُ یَقُولُ : فِی ہَذِہِ الْغِرَارَۃِ کَذَا وَکَذَا ، وَأَبِیعُہَا بِکَذَا وَکَذَا ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إ??َا سَمَّیْتَ فَکِلْ۔ (عبد بن حمید ۵۲۔ احمد ۷۵)","","Musannaf Ibn Abi Shaybah 21732","","","كتاب البيوع والأقضية"
"21733","(۲۱۷۳۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ، عَنِ التَّیْمِیِّ، عَنِ ابْنِ سِیرِینَ، قَالَ: إذَا سُمِّی الْکَیْلَ وَالْوَزْنَ فَلاَ تَبِعْہُ حَتَّی تَکِیلَہُ۔","","Musannaf Ibn Abi Shaybah 21733","","","كتاب البيوع والأقضية"
"21734","(۲۱۷۳۴) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ ، وَالْحَسَنِ ، أَنَّہُمَا قَالاَ : إذَا سَمَّی الْکَیْلَ وَالْوَزْنَ فَلْیَکِلْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21734","","","كتاب البيوع والأقضية"
"21735","(۲۱۷۳۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَسْلَمْتَ سَلَمًا ، وَسَمَّیْتَ کَیْلاً ، فَلاَ تَأْخُذْ جُزَافًا۔","","Musannaf Ibn Abi Shaybah 21735","","","كتاب البيوع والأقضية"
"21736","(۲۱۷۳۶) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا ابْتَعْت طَعَامًا فِی أَوْسَاقِہِ فَکتلْہُ ، یَعْنِی إذَا ابْتَعْتہ کَیْلاً۔","","Musannaf Ibn Abi Shaybah 21736","","","كتاب البيوع والأقضية"
"21737","(۲۱۷۳۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ التَّیْمِیِّ ، عَنِ الْحَسَنِ : أَنَّہُ کَرِہَ أَنْ یُوَلِّیَ مِنَ الطَّعَامِ شَیْئًا حَتَّی یَقْبِضَہُ۔","","Musannaf Ibn Abi Shaybah 21737","","","كتاب البيوع والأقضية"
"21738","(۲۱۷۳۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِتَوْلِیَۃِ الطَّعَامِ قَبْلَ أَنْ یَقْبِضَ ، وَیَقُولُ : ہُوَ مَعْرُوفٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 21738","","","كتاب البيوع والأقضية"
"21739","(۲۱۷۳۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عن ابن عون ، عن محمد : أنہ کرہہ۔","","Musannaf Ibn Abi Shaybah 21739","","","كتاب البيوع والأقضية"
"21740","(۲۱۷۴۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ سَعِیدٍ، عَنْ وَہْبٍ الْعَمِّیِّ، عَنْ عَطَائٍ: أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُوَلِّیَہُ قَبْلَ أَنْ یَقْبِضَہُ۔","","Musannaf Ibn Abi Shaybah 21740","","","كتاب البيوع والأقضية"
"21741","(۲۱۷۴۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدٍ ، قَالَ : مَنِ اشْتَرَی شَیْئًا بِکَیْلٍ ، أَوْ وَزْنٍ فَلاَ یَبِعْہُ حَتَّی یَقْبِضَہُ ، وَکَانَ لاَ یَرَی بَأْسًا أَنْ یُوَلِّیَہُ أَوْ یُشْرِکَ فِیہِ بِغَیْرِ کَیْلٍ ، وَلاَ وَزْنٍ۔","","Musannaf Ibn Abi Shaybah 21741","","","كتاب البيوع والأقضية"
"21742","(۲۱۷۴۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ سُلَیْمَانَ بْنِ بِلاَلٍ ، عَنْ رَبِیعَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، رَفَعَہُ ، قَالَ : لاَ بَأْسَ بِالتَّوْلِیَۃِ وَالشِّرْکَ قَبْلَ أَنْ یُسْتَوْفَی۔ (عبدالرزاق ۱۴۲۵۷۔ ابوداؤد ۱۹۸)","","Musannaf Ibn Abi Shaybah 21742","","","كتاب البيوع والأقضية"
"21743","(۲۱۷۴۳) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ عَطَائٍ ، عَنْ حِزَامِ بْنِ حَکِیمٍ ، قَالَ : قَالَ لِی حَکِیمٌ: ابْتَعْت طَعَامًا مِنْ طَعَامِ الصَّدَقَۃِ فَرَبِحْت فِیہِ قَبْلَ أَنْ أَقْبِضَہُ ، فَأَتَیْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَألتہ؟ فَقَالَ : لاَ تَبِعْہُ حَتَّی تَقْبِضَہُ۔ (نسائی ۶۱۹۵۔ طیالسی ۱۳۱۸)","Hasan","Musannaf Ibn Abi Shaybah 21743","","","كتاب البيوع والأقضية"
"21744","(۲۱۷۴۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ وَابْنُ أَبِی زَائِدَۃَ ، کِلاَہُمَا عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا ابْتَاعَ أَحَدُکُمْ طَعَامًا فَلاَ یَبِعْہُ حَتَّی یَکِیلَہُ ، قَالَ ابْنُ أَبِی زَائِدَۃَ : وَیُقْبِضَہُ۔ (مسلم ۱۱۶۱۔ بخاری ۲۱۲۴)","Sahih","Musannaf Ibn Abi Shaybah 21744","","","كتاب البيوع والأقضية"
"21745","(۲۱۷۴۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ عَطِیَّۃَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : سَأَلْتُہ عَنِ الْسَّلفِ فِی الزَِّیتِ وَالسَّمْن وَالْحِنْطَۃِ وَالشَّعِیرِ ؟ فَقَالَ : لاَ بَأْسَ بِہِ ، وَلَکِنْ لاَ تَبِعْہُ حَتَّی تَقْبِضَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 21745","","","كتاب البيوع والأقضية"
"21746","(۲۱۷۴۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، قَالَ : نُبِّئْت أَنَّ حَکِیمَ بْنَ حِزَامٍ کَانَ یَشْتَرِی صِکَاکَ الرَّزْقِ فَنَہَاہُ ابن عُمَرُ أَنْ یَبِیعَ حَتَّی یَقْبِضَ۔","Da'if","Musannaf Ibn Abi Shaybah 21746","","","كتاب البيوع والأقضية"
"21747","(۲۱۷۴۷) حدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنْ عُمَرَ بِنَحْوٍ مِنْ حَدِیثِ أَیُّوبَ۔","Sahih","Musannaf Ibn Abi Shaybah 21747","","","كتاب البيوع والأقضية"
"21748","(۲۱۷۴۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا ابْتَعْت بَیْعًا أَبَدًا فَلاَ تَبِعْہُ حَتَّی تَقْبِضَہُ۔","","Musannaf Ibn Abi Shaybah 21748","","","كتاب البيوع والأقضية"
"21749","(۲۱۷۴۹) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : إذَا اشْتَرَیْت طَعَامًا فَلاَ تَبِعْہُ حَتَّی تَقْبِضَہُ ، وَلاَ یَرَی بِالشِّرکَ بَأْسًا ، أَوْ تُعْطِیَہُ الثَّمَنَ۔","","Musannaf Ibn Abi Shaybah 21749","","","كتاب البيوع والأقضية"
"21750","(۲۱۷۵۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ : فِی الرَّجُلِ یَشْتَرِی الْبَیْعَ ، ثُمَّ یَبِیعُہُ قَبْلَ أَنْ یَقْبِضَہُ ، قَالَ : لاَ ، حتَّی یَقْبِضْہُ۔","","Musannaf Ibn Abi Shaybah 21750","","","كتاب البيوع والأقضية"
"21751","(۲۱۷۵۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ إبْرَاہِیمَ سُئِلَ عَنِ الرَّجُلِ یَبِیعُ الْبَیْعَ قَبْلَ أَنْ یَقْبِضَہُ ؟ قَالَ : إنَّمَا کَانَ ذَلِکَ فِی الْکَیْلِ وَالْوَزْنِ۔","","Musannaf Ibn Abi Shaybah 21751","","","كتاب البيوع والأقضية"
"21752","(۲۱۷۵۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الطَّعَامُ الَّذِی نُہِیَ عَنْہُ لاَ یُبَاعُ حَتَّی یُقْبَضَ ، وَأَحْسِبُ کُلَّ شَیْئٍ مِثْلَ الطَّعَامِ۔","Sahih","Musannaf Ibn Abi Shaybah 21752","","","كتاب البيوع والأقضية"
"21753","(۲۱۷۵۳) حَدَّثَنَا مُحَمَّدُ بْنُ مُیَسَّرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ الشَّعْبِیِّ ، عَنْ خَارِجَۃَ بْنِ زَیْدٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ : أَنَّہُ کَانَ یَنْہَی الَّذِینَ یَبْتَاعُونَ صُحُفَ الْجَارِ حَتَّی یَسْتَوْفُوہَا۔","Da'if","Musannaf Ibn Abi Shaybah 21753","","","كتاب البيوع والأقضية"
"21754","(۲۱۷۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنِ ابْتَاعَ طَعَامًا فَلاَ یَبِعْہُ حَتَّی یَکْتَالَہُ قُلْتُ لاِبْنِ عَبَّاسٍ : لِمَ ؟ فَقَالَ : أَلاَ تَرَی أَنَّہُمْ یَبْتَاعُونَ الذَّہَبَ وَالطَّعَامَ مُرْجَأ۔ (بخاری ۲۱۳۲۔ مسلم ۲۹)","Sahih","Musannaf Ibn Abi Shaybah 21754","","","كتاب البيوع والأقضية"
"21755","(۲۱۷۵۵) حَدَّثَنَا زَیْدُ بْنُ حبابٍ ، قَالَ : حدَّثَنَا الضَّحَّاکُ بْنُ عُثْمَانَ ، قَالَ : أَخْبَرَنِی بُکَیْر بْنُ عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنِ ابْتَاعَ طَعَامًا فَلاَ یَبِعْہُ حَتَّی یَکْتَالَہُ۔ (مسلم ۱۱۶۲۔ احمد ۳۳۷)","Hasan","Musannaf Ibn Abi Shaybah 21755","","","كتاب البيوع والأقضية"
"21756","(۲۱۷۵۶) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ عَلِیٍّ { وَآتُوہُمْ مِنْ مَالِ اللہِ الَّذِی آتَاکُمْ } قَالَ : الرُّبُعَ مِنْ أَوَّلِ نُجُومِہِ۔ (ابن جریر ۱۲۹)","Da'if","Musannaf Ibn Abi Shaybah 21756","","","كتاب البيوع والأقضية"
"21757","(۲۱۷۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عُمَرَ : أَنَّہُ کَرِہَ أَنْ یَضَعَ الرَّجُلُ عَنْ مُکَاتَبِہِ حَتَّی یَکُونَ فِی آخِرِ نَجْمٍ مَخَافَۃَ أَنْ یَعْجَزَ۔","Sahih","Musannaf Ibn Abi Shaybah 21757","","","كتاب البيوع والأقضية"
"21758","(۲۱۷۵۸) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ ابْنُ سِیرِینَ یُحِبُّ إذَا کَانَ الْمُکَاتَبُ أَنْ یَکْتُبَ فِی الْکِتَابِ وَأَحطُّک مِنْ آخِرِ نَجْمٍ مِنْ نُجُومِک۔","","Musannaf Ibn Abi Shaybah 21758","","","كتاب البيوع والأقضية"
"21759","(۲۱۷۵۹) حَدَّثَنَا مُعْتَمِرٌ، عَنْ لَیْثٍ، عَنْ مُجَاہِدٍ، قَالَ: الْمُکَاتَبُ تُعْطِیہِ الرُّبُعَ مِنْ جَمِیعِ مُکَاتَبَتِہِ تُعَجِّلُہَا مِنْ مَالِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21759","","","كتاب البيوع والأقضية"
"21760","(۲۱۷۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی شَبِیبٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّ عُمَرَ کَاتَبَ عَبْدًا لَہُ یُکَنَّی أَبَا أُمَیَّۃَ ، فَجَائَہُ بِنَجْمِہِ حِینَ جَائَ فَقَالَ : یَا أَبَا أُمَیَّۃَ ، اسْتَعِنْ بِہِ فِی مُکَاتَبَتِکَ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، لَوْ تَرَکْتہ حَتَّی یَکُونَ فِی آخِرِ نَجْمٍ، قَالَ: إنِّی أَخَافُ أَنْ لاَ أُدْرِکَ ذَاکَ، ثُمَّ قَرَأَ: {وَآتُوہُمْ مِنْ مَالِ اللہِ الَّذِی آتَاکُمْ}۔n قَالَ عِکْرِمَۃُ : ہُوَ أَوَّلَ نَجْمٍ أُدِّیَ فِی الإِسْلاَمِ۔ (بیہقی ۳۲۹)","Da'if","Musannaf Ibn Abi Shaybah 21760","","","كتاب البيوع والأقضية"
"21761","(۲۱۷۶۱) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ الْحَکَمِ بْنِ عَطِیَّۃَ ، عَنْ مُحَمَّدِ بْنِ سیرِینَ ، قَالَ : کَانَ یُعْجِبُہُمْ أَنْ یَدَعَ لِمُکَاتَبِہِ طَائِفَۃً مِنْ مُکَاتَبَتِہِ۔","","Musannaf Ibn Abi Shaybah 21761","","","كتاب البيوع والأقضية"
"21762","(۲۱۷۶۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ : فِی قولہ تعالی : {وَآتُوہُمْ مِنْ مَالِ اللہِ الَّذِی آتَاکُمْ} قَالَ : مِمَّا أَخْرَجَ اللَّہُ لَکَ مِنْ مُکَاتَبَتِہِ۔","","Musannaf Ibn Abi Shaybah 21762","","","كتاب البيوع والأقضية"
"21763","(۲۱۷۶۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ، عَنْ حَجَّاجٍ، عَنْ عَطَائٍ، قَالَ: تُعْطِیہِ مَا طَابَتْ بِہِ نَفْسُک وَلَیْسَ فِیہِ شَیْئٌ مُؤقَّتٌ۔","","Musannaf Ibn Abi Shaybah 21763","","","كتاب البيوع والأقضية"
"21764","(۲۱۷۶۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ۔ وَعَنِ الْقَاسِمِ ، عَنْ مُجَاہِدٍ ، قَالاَ : یُوضَعُ عَنْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21764","","","كتاب البيوع والأقضية"
"21765","(۲۱۷۶۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ : {وَآتُوہُمْ مِنْ مَالِ اللہِ الَّذِی آتَاکُمْ} قَالَ : مِمَّا فِی یَدَیْک۔","No Data Available","Musannaf Ibn Abi Shaybah 21765","","","كتاب البيوع والأقضية"
"21766","(۲۱۷۶۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ : أَنَّہُ کَاتَبَ غُلاَمًا فَأَعْطَاہُ الرُّبُعَ ، وَقَالَ : ہَذَا قَوْلُ عَلِیٍّ : {وَآتُوہُمْ مِنْ مَالِ اللہِ الَّذِی آتَاکُمْ}۔","No Data Available","Musannaf Ibn Abi Shaybah 21766","","","كتاب البيوع والأقضية"
"21767","(۲۱۷۶۷) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ عَدِیِّ بْنِ الْفُضَیْلِ ، قَالَ : أَتَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ فَاسْتَحْفَرْتُہُ بِئْرًا ، قَالَ : اُکْتُبْ حَرِیمُہَا خَمْسِینَ ذِرَاعًا وَلَیْسَ لَہُ حَقُّ مُسْلِمٍ ، وَلاَ یَضُرُّہُ ، وَابْنُ السَّبِیلِ أَوْلَی مَنْ یَشْرَبُ۔","","Musannaf Ibn Abi Shaybah 21767","","","كتاب البيوع والأقضية"
"21768","(۲۱۷۶۸) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ : سَأَلْتُ أَبَا بَکْرٍ بْنَ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ، عَنِ الأَعْطَانِ ؟ فَقَالَ : أَمَّا أَہْلُ الْجَاہِلِیَّۃِ فَکَانَتْ خَمْسِینَ ذِرَاعًا لِنَاحِیَتِہَا یَکُونُ بَیْنَ الْبِئْرَیْنِ مِئَۃ ، فَلَمَّا کَانَ الإِسْلاَمُ رَأَوْا ، أَنَّ دُونَ ذَلِکَ مُجْزِئٌ ، فَجُعِلَ لِکُلِّ بِئْرٍ خَمْسٌ وَعِشْرُونَ ذِرَاعًا لِنَاحِیَتیہَا خَمْسُونَ ذِرَاعًا۔","","Musannaf Ibn Abi Shaybah 21768","","","كتاب البيوع والأقضية"
"21769","(۲۱۷۶۹) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَشْعَثَ ، عَنْ عَامِرٍ ، قَالَ : حرِیمُ الْبِئْرِ أَرْبَعُونَ ذِرَاعًا کُلُّہَا ، لَیْسَ لأَِحَدٍ أَنْ یَدْخُلَ عَلَیْہِ فِی عَطَنِہِ ، وَلاَ مَائِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21769","","","كتاب البيوع والأقضية"
"21770","(۲۱۷۷۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃ ، قَالَ : حرِیمُ الْبَدِیء خَمْسَۃٌ وَعِشْرُونَ ذِرَاعًا ، وَحَرِیمُ الْعَادِیَّۃِ خَمْسُونَ ذِرَاعًا ، وحرِیمُ الزَّرع۔n قَالَ الزُّہْرِیُّ : وَبَلَغَنِی ، أَنَّ حَرِیمَ الْعَیْنِ ستمِئَۃِ ذِرَاعٍ۔","","Musannaf Ibn Abi Shaybah 21770","","","كتاب البيوع والأقضية"
"21771","(۲۱۷۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ۔ وَعَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : حَرِیمُ الْبِئْرِ أَرْبَعُونَ ذِرَاعًا۔","","Musannaf Ibn Abi Shaybah 21771","","","كتاب البيوع والأقضية"
"21772","(۲۱۷۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : حَرِیمُ بِئْرِ الْبَدِیء خَمْس وَعِشْرُونَ ذِرَاعًا ، وَحَرِیمُ الْبِئْرِ الْعَادِیَّۃِ خَمْسُونَ ذِرَاعًا ، قَالَ سَعِیدٌ ، وَحَرِیمُ بِئْرِ الذَّہَبِ ثَلاَثُ مِئَۃِ ذِرَاعٍ۔ (ابوداؤد ۴۰۲۔ حاکم ۹۷)","","Musannaf Ibn Abi Shaybah 21772","","","كتاب البيوع والأقضية"
"21773","(۲۱۷۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعدِ بْنِ أَوْسٍ الْعَبْسِیِّ ، عَنْ بِلاَلِ بْنِ یَحْیَی الْعَبْسِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ حِمَی إلاَّ فِی ثَلاَث : ثَلَّۃُ الْقَلِیبِ۔ یَعْنِی حَرِیمَ الْبِئْرِ وَحَلْقَۃَ الْقَوْمِ۔ (بیہقی ۱۵۱)","","Musannaf Ibn Abi Shaybah 21773","","","كتاب البيوع والأقضية"
"21774","کوئی شخص اپنے مدبر غلام کو مکاتب بنا لے پھر وہ فوت ہو جائے جبکہ مکاتب پر بدل کتابت میں سے کچھ ابھی باقی ہو، تو کیا حکم ہے؟","Sahih","Musannaf Ibn Abi Shaybah 21774","","","كتاب البيوع والأقضية"
"21775","(۲۱۷۷۵) حَدَّثَنَا عَبَّادُ ، عَنْ حَجَّاجٍ ، عَنْ مُحَمَّدِ بْنِ قَیْسِ بْنِ الأَحْنَفِ ، عَنْ أَبِیہِ ، عَنِ ابْنِ مَسْعُودٍ : فِی الرَّجُلِ یَبِیعُ مُدَبَّرہ خِدْمَتُہُ ، قَالَ : مَا أَخَذَ سَیِّدُہُ فَہُوَ لَہُ ، وَمَا بَقِیَ فَلاَ شَیْئَ لہ۔","Da'if","Musannaf Ibn Abi Shaybah 21775","","","كتاب البيوع والأقضية"
"21776","(۲۱۷۷۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، عَنْ مُحَمَّدِ بْنِ قَیْسِ بْنِ الأَحْنَفِ ، عَنْ أَبِیہِ ، عَنِ ابْنِ مَسْعُودٍ بِمِثْلِ حَدِیثِ عَبَّادٍ ، إلأَ أَنَّہُ قَالَ : لاَ شَیْئَ لَکُمْ إذَا مَاتَ صَاحِبُکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 21776","","","كتاب البيوع والأقضية"
"21777","(۲۱۷۷۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، قَالَ : أَخْبَرَنِی دَاوُد بْنُ حُرَیْثٍ ، قَالَ : شَہِدْت شُرَیْحًا قَضَی بِذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21777","","","كتاب البيوع والأقضية"
"21778","(۲۱۷۷۸) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ أَبِی عَوَانَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : یُؤْخَذُ منْہُ مَا بَقِیَ۔","","Musannaf Ibn Abi Shaybah 21778","","","كتاب البيوع والأقضية"
"21779","(۲۱۷۷۹) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ أَیُّوبَ وَہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : لاَ یُبَاعُ الْمُدَبَّرُ إلاَّ مِنْ نَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 21779","","","كتاب البيوع والأقضية"
"21780","(۲۱۷۸۰) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ یَکْرَہُ بَیْعَہُ ، وَلاَ یَرَی بَأْسًا أَنْ یُکَاتِبَہُ۔","","Musannaf Ibn Abi Shaybah 21780","","","كتاب البيوع والأقضية"
"21781","(۲۱۷۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ تُبَاعُ خِدْمَۃُ الْمُدَبَّرِ إلاَّ مِنْ نَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 21781","","","كتاب البيوع والأقضية"
"21782","(۲۱۷۸۲) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ ابْنِ عَوْنٍ ، عن نافع : أَنَّ ابْنَ عُمَرَ کَانَ فِی حَجْرِہِ یَتِیمَۃٌ ، فَزَوَّجَہَا ، وَدَفَعَ مَالَہَا إلَی زَوْجِہَا مُضَارَبَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 21782","","","كتاب البيوع والأقضية"
"21783","(۲۱۷۸۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ وَوَکِیعٌ ، عَنْ عَبْدِ اللہِ بْنِ حُمَیْدٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ دُفِعَ إلَیْہِ مَالُ یَتِیمٍ مُضَارَبَۃً فَطَلَبَ فِیہِ فَأَصَابَ فَقَاسَمَہُ الْفَضْلُ ، ثُمَّ تَفَرَّقَا۔","Da'if","Musannaf Ibn Abi Shaybah 21783","","","كتاب البيوع والأقضية"
"21784","(۲۱۷۸۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ کَانَ عِنْدَہُ مَالُ یَتِیمٍ فَأَعْطَاہُ مُضَارَبَۃً فِی الْبَحْرِ۔","","Musannaf Ibn Abi Shaybah 21784","","","كتاب البيوع والأقضية"
"21785","(۲۱۷۸۵) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ دَاوُدَ، عَنِ الشَّعْبِیِّ، عَنِ الْحَسَنِ بْنِ عَلِیٍّ: أَنَّہُ وَلِیَ مَالَ یَتِیمٍ فَدَفَعَہُ إلَی مَوْلَی لَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 21785","","","كتاب البيوع والأقضية"
"21786","(۲۱۷۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَعْمَلَ الْوَصِیُّ بِمَالِ الْیَتِیمِ ، قُلْتُ لإِبْرَاہِیمَ : إِنْ تَوِیَ یَضْمَنُ ؟ قَالَ : لاَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21786","","","كتاب البيوع والأقضية"
"21787","(۲۱۷۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَعْمَلَ الْوَصِیُّ بِمَالِ الْیَتِیمِ لَہُ أَوْ بِہِ۔","","Musannaf Ibn Abi Shaybah 21787","","","كتاب البيوع والأقضية"
"21788","(۲۱۷۸۸) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ الْحَسَنِ : أَنَّہُ کَرِہَ أَنْ یُدْفَعَ مَالُ الْیَتِیمِ مُضَارَبَۃً ، وَیَقُولُ : اِضْمَنْہُ ، وَلاَ تُعَرِّضْہُ لِبَرٍّ ، وَلاَ بَحْرٍ۔","","Musannaf Ibn Abi Shaybah 21788","","","كتاب البيوع والأقضية"
"21789","(۲۱۷۸۹) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ فِی مَالِ الْیَتِیمِ : إنِ اتَّجَرْتَ فِیہِ فَرَبِحْتَ فَلَہُ ، وَإِنْ ضَاعَ ضَمِنْت ، وَإِنْ وَضَعْتہ فَہَلَکَ فَلَیْسَ عَلَیْک۔","","Musannaf Ibn Abi Shaybah 21789","","","كتاب البيوع والأقضية"
"21790","(۲۱۷۹۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، قَالَ : کُنَّا أَیْتَامًا فِی حِجْرِ عَائِشَۃَ فَکَانَتْ تُزْکِی أَمْوَالَنَا وَتُبْضِعُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 21790","","","كتاب البيوع والأقضية"
"21791","(۲۱۷۹۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا فُضَیْلُ بْنُ مَرْزُوقٍ ، عَنِ الضَّحَّاکِ {وَلاَ تَقْرَبُوا مَالَ الْیَتِیمِ إلاَّ بِاَلَّتِی ہِیَ أَحْسَنُ} قَالَ : یُبْتَغَی لِلْیَتِیمِ فِی مَالِہِ۔","","Musannaf Ibn Abi Shaybah 21791","","","كتاب البيوع والأقضية"
"21792","(۲۱۷۹۲) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنِ الْحَسَنِ الْعُرَنِیِّ رَجُلٍ مِنْ أَہْلِ الْکُوفَۃِ : أَنَّ رَجُلاً قَالَ : یَا رَسُولَ اللہِ ، أَضْرِبُ یَتِیمِی ؟ قَالَ : اضْرِبْہُ مِمَّا کُنْت ضَارِبًا مِنْہُ وَلَدَک ، قَالَ : فَمَا آکُلُ مِنْ مَالِہِ ؟ قَالَ : بِالْمَعْرُوفِ غَیْرَ مُتَأَثِّلٍ مِنْ مَالِہِ ، وَلاَ وَاقِیًا مَالَک بِمَالِہِ۔ (بیہقی ۲۸۵۔ طبری ۲۶۰)","","Musannaf Ibn Abi Shaybah 21792","","","كتاب البيوع والأقضية"
"21793","(۲۱۷۹۳) حَدَّثَنَا ابْنُ الْمُبَارَکِ ، عَنِ الرَّبِیعِ بْنِ أَنَسٍ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : مَا أَکَلْت مِنْ مَالِ الْیَتِیمِ فَہُوَ دَیْنٌ عَلَیْک ، أَلاَ تَرَی إلَی قَوْلِہِ تَعَالَی : {فَإِذَا دَفَعْتُمْ إلَیْہِمْ أَمْوَالَہُمْ فَأَشْہِدُوا عَلَیْہِمْ}۔","","Musannaf Ibn Abi Shaybah 21793","","","كتاب البيوع والأقضية"
"21794","(۲۱۷۹۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : سَأَلْتُ عَبِیدَۃَ عَنْ قَوْلِہِ : {وَمَنْ کَانَ غَنِیًّا فَلْیَسْتَعْفِفْ وَمَنْ کَانَ فَقِیرًا فَلْیَأْکُلْ بِالْمَعْرُوفِ} قَالَ : إنَّمَا ہُوَ قَرْضٌ ، أَلاَ تَرَی إلَی قَوْلِہِ : {فَإِذَا دَفَعْتُمْ إلَیْہِمْ أَمْوَالَہُمْ فَأَشْہِدُوا عَلَیْہِمْ}۔","","Musannaf Ibn Abi Shaybah 21794","","","كتاب البيوع والأقضية"
"21795","(۲۱۷۹۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ : فِی قَوْلِہِ : {وَمَنْ کَانَ غَنِیًّا فَلْیَسْتَعْفِفْ وَمَنْ کَانَ فَقِیرًا فَلْیَأْکُلْ بِالْمَعْرُوفِ} یَسْتَسْلِفُ مِنْہُ : وَیَتَّجِرُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 21795","","","كتاب البيوع والأقضية"
"21796","(۲۱۷۹۶) حَدَّثَنَا جَرِیرٌ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الْوَصِیُّ إنِ احْتَاجَ وَضَعَ یَدَہُ مَعَ أَیْدِیہِمْ ، وَلاَ یَلْبس عِمَامَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 21796","","","كتاب البيوع والأقضية"
"21797","(۲۱۷۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی العُمَیْس ، عَنْ عَبْدَۃَ بْنِ أَبِی لبابۃ ، عَنْ أَبِی یَحْیَی ، عَنِ ابْنِ عَبَّاسٍ : فِی قولہ تعالی : {وَمَنْ کَانَ فَقِیرًا فَلْیَأْکُلْ بِالْمَعْرُوفِ} قَالَ : مِنْ مَالِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 21797","","","كتاب البيوع والأقضية"
"21798","(۲۱۷۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی جَعْفَرٍ الرَّازِیّ ، عَنِ الرَّبِیعِ ، عَنْ أَبِی الْعَالِیَۃِ ۔ وَسُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ۔ وَعَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی وَائِلٍ قَالُوا : بِالْقَرْضِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21798","","","كتاب البيوع والأقضية"
"21799","(۲۱۷۹۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حُصَیْنٍ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ ، قَالَ : أَتَتْہُ امْرَأَۃٌ فَسَأَلَتْہُ ، فَقَالَتْ : إنَّ بَنِیَّ وَإِخْوَۃً لَہُمْ مِنْ أَبِیہِمْ وَہُمْ أَیْتَامٌ فِی حَجْرِی ، وَکَانَ لِی مَالٌ فَکُنْت أُنْفِقُہُ عَلَیْہِمْ حَتَّی ذَہَبَ ، وَلَہُمْ مَالٌ فَمَا تَرَی ؟ قَالَ : ضَعِی یَدَک مَعَ أَیْدِیہِمْ وَکُلِی بِالْمَعْرُوفِ۔","","Musannaf Ibn Abi Shaybah 21799","","","كتاب البيوع والأقضية"
"21800","(۲۱۸۰۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ ، وَعِکْرِمَۃَ {وَمَنْ کَانَ فَقِیرًا فَلْیَأْکُلْ بِالْمَعْرُوفِ} ، قَالَ : یَضَعُ یَدَہُ۔","","Musannaf Ibn Abi Shaybah 21800","","","كتاب البيوع والأقضية"
"21801","(۲۱۸۰۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ فِی قَوْلِہِ : {وَمَنْ کَانَ غَنِیًّا فَلْیَسْتَعْفِفْ وَمَنْ کَانَ فَقِیرًا فَلْیَأْکُلْ بِالْمَعْرُوفِ} قَالَتْ : أُنْزِلَ ذَلِکَ فِی وَالِی مَالِ الیتیم یَقُومُ عَلَیْہِ وَیُصْلِحُہُ إذَا کَانَ مُحْتَاجًا أَنْ یَأْکُلَ مِنْہُ۔ (بخاری ۴۵۷۵۔ مسلم ۲۳۱۵)","Sahih","Musannaf Ibn Abi Shaybah 21801","","","كتاب البيوع والأقضية"
"21802","(۲۱۸۰۲) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ الْحَسَنِ بْنِ یَزِیدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَرْسَلَتْنِی امْرَأَۃٌ إلَیْہِ أَسْأَلُہُ عَنْ یَتَامَی فِی حِجْرِہَا قَامَتْ عَلَیْہِمْ ہَلْ تَأْکُلُ مِنْ أَمْوَالِہِمْ شَیْئًا ؟ قَالَ : نَعَمْ ، بِالْمَعْرُوفِ۔","","Musannaf Ibn Abi Shaybah 21802","","","كتاب البيوع والأقضية"
"21803","(۲۱۸۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أُمِّ سَلَمَۃَ العتکیۃ ، عَنْ عَائِشَۃَ ، قَالَتْ : کُلِی مِنْ مَالِ الْیَتِیمِ وَاعْلَمِی مَا تَأْکُلِینَ۔","Hasan","Musannaf Ibn Abi Shaybah 21803","","","كتاب البيوع والأقضية"
"21804","(۲۱۸۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ ہَمَّام ، عَنْ إبْرَاہِیمَ ، قَالَ : قالَتْ عَائِشَۃُ : إنِّی لاَکْرَہُ أَنْ یَکُونَ مَالُ الْیَتِیمِ عِنْدِی عُرَّۃً حَتَّی أَخْلِطَ طَعَامَہُ بِطَعَامِی وَشَرَابَہُ بِشَرَابِی۔","","Musannaf Ibn Abi Shaybah 21804","","","كتاب البيوع والأقضية"
"21805","(۲۱۸۰۵) حَدَّثَنَا ابْن إدریس ، عَنْ ہِشَامٍ بن عروۃ ، عن أبیہ أَنَّہ رخص لوالی الیتیم أن یأکل مکان قیامہ بالمعروف۔","","Musannaf Ibn Abi Shaybah 21805","","","كتاب البيوع والأقضية"
"21806","(۲۱۸۰۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ الأَزْرَقُ ، عَنِ الشَّعْبِیِّ : فِی وَالِی مَالِ الْیَتِیمِ : یَأْکُلُ مِنَ الرِّسْلِ وَالتمرۃ بحِسَابِ الأجیر۔","","Musannaf Ibn Abi Shaybah 21806","","","كتاب البيوع والأقضية"
"21807","(۲۱۸۰۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ آجَرَ غُلاَمَہُ سَنَۃً ، ثُمَّ أَرَادَ أَنْ یَبِیعَہُ ، قَالَ : یَبِیعُہُ إِنْ شَائَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21807","","","كتاب البيوع والأقضية"
"21808","(۲۱۸۰۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ إیَاسِ بْنِ مُعَاوِیَۃَ فِی الْغُلاَمِ یَدْفَعُہُ الرَّجُلُ إلَی الرَّجُلِ یُعَلِّمُہُ ، ثُمَّ یُخْرِجُہُ قَبْلَ أَنْ یَنْقَضِیَ شَرْطُہُ ، قَالَ : یُرَدُّ عَلَی مُعَلِّمِہِ مَا أَنْفَقَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 21808","","","كتاب البيوع والأقضية"
"21809","(۲۱۸۰۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : سَأَلْتُہ عَنْ رَجُلٍ آجَرَ غُلاَمَہُ سَنَۃً فَأَرَادَ أَنْ یُخْرِجَہُ ؟ قَالَ : لَہُ أَنْ یَأْخُذَہُ۔n قَالَ : وَسَأَلْت حَمَّادًا ، فَقَالَ : لاَ یَأْخُذُہُ إلاَّ مِنْ مَضَرَّۃٍ۔","","Musannaf Ibn Abi Shaybah 21809","","","كتاب البيوع والأقضية"
"21810","(۲۱۸۱۰) حَدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ : سَمِعْتُ أَبَا الضُّحَی یَذْکُرُ : أَنَّ شُرَیْحًا وَمَسْرُوقًا کَانَا یَقُولاَنِ فِی الرَّجُلِ إذَا آجَرَ الْعَبْدَ سَنَۃً أَوْ شَہْرًا أَوْ نَحْوَ ذَلِکَ ، ثُمَّ بَدَا لَہُ أَنْ یَأْخُذَ مِنْہُ : فَذَلِکَ لَہُ۔","","Musannaf Ibn Abi Shaybah 21810","","","كتاب البيوع والأقضية"
"21811","(۲۱۸۱۱) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، قَالَ : سَأَلَہُ رَجُلٌ وَأَنَا أَسْمَعُ عَنْ رَجُلٍ اسْتَوْدَعَ مَالاً فَتَجَرَ فِیہِ ؟ فَقَالَ : کَانَ عَطَائُ یَقُولُ : مَا کَانَ فِیہِ مِنْ نَمَائٍ فَہُوَ لِرَبِّ الْمَالِ ، وَقَالَ مُجَاہِدٌ : لَیْسَ لِرَبِّ الْمَالِ وَلاَ المُسْتَودَعِ ، وَہُوَ لِلْمَسَاکِینِ۔","","Musannaf Ibn Abi Shaybah 21811","","","كتاب البيوع والأقضية"
"21812","(۲۱۸۱۲) حَدَّثَنَا أبو بَکر ، قَالَ : حَدَّثَنَا ہِشَامٌ ، عَنِ الْحَسَنِ ، قَالَ : لاَ تُحَرَّکُ الْوَدِیعَۃُ إلاَّ بِإِذْنِ رَبِّہَا ، فَإِنْ فَعَلَ ، فَہُوَ ضَامِنٌ ، وَلَہُ الرِّبْحُ۔","","Musannaf Ibn Abi Shaybah 21812","","","كتاب البيوع والأقضية"
"21813","(۲۱۸۱۳) حَدَّثَنَا عَبْدَۃُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ فِی الْوَدِیعَۃِ : لاَ ضَمَانَ عَلَیْہِ إلاَّ أَنْ یُحَوِّلَہَا عَنْ مَوْضِعِہَا ، أَوْ یُغَیِّرَہَا عَنْ حَالِہَا ، فَإِنْ ہُوَ غَیَّرَہَا عَنْ مَوْضِعِہَا ، فَکَانَ فِیہِ رِبْحٌ فَإِنَّہُ یَتَصَدَّقُ بِہِ ، وَلَیْسَ لِوَاحِدٍ مِنْہُمَا۔","","Musannaf Ibn Abi Shaybah 21813","","","كتاب البيوع والأقضية"
"21814","(۲۱۸۱۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : سُئِلَ ابْنُ عُمَرَ ، عَنْ مَالِ الْیَتِیمِ ؟ فَقَالَ : ہُوَ مَضْمُونٌ حَتَّی یَدْفَعَہُ إلَیْہِ ، قَالَ : إِنَّہُ قَدْ کَانَ فِیہِ فَضْلٌ ، قَالَ : اصْنَعْ بِفَضْلِہِ مَا شِئْت ، ہُوَ مَضْمُونٌ حَتَّی تَدْفَعَہُ إلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 21814","","","كتاب البيوع والأقضية"
"21815","(۲۱۸۱۵) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إبْرَاہِیمَ : فِی الرَّجُلِ یَکُونُ عِنْدَہُ المَالُ لأَیْتَامِ فَیَعْمَلُ بِہِ ، قَالَ : ہُوَ ضَامِنٌ إذَا عَمِلَ بِغَیْرِ إذْنِہِمْ فَالرِّبْحُ یَتَصَدَّقُ بِہِ۔","","Musannaf Ibn Abi Shaybah 21815","","","كتاب البيوع والأقضية"
"21816","(۲۱۸۱۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ مُحَمَّدِ بْنِ زَیْدٍ ، قَالَ : قُلْتُ لاِبْنِ عُمَرَ : رُبَّمَا أَسْلَمَ الرَّجُلُ إلَی الرَّجُلِ أَلْف درہم وَنَحْوَہَا فَیَقُولُ : إِنْ أَعْطَیْتنِی بُرًّا فَبِکَذَا ، وَإِنْ أَعْطَیْتنِی شَعِیرًا فَبِکَذَا ، قَالَ : سَمِّ فِی کُلِّ نَوْعٍ مِنْہَا وَرِقاً مُسَمَّاۃً ، فَإِنْ أَعْطَاک الَّذِی فِیہِ وَإِلاَّ فَخُذْ رَأْسَ مَالِکِ۔","Hasan","Musannaf Ibn Abi Shaybah 21816","","","كتاب البيوع والأقضية"
"21817","(۲۱۸۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ أَسْلَمَ الْمِنْقَرِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ : فِی الرَّجُلِ یُسْلِمُ فَیَقُولُ : مَا کَانَ عِنْدَکَ مَنْ حِنْطَۃٍ فَبِکَذَا ، وَمَا کَانَ عِنْدَکَ مِنْ حُبُوبٍ فَبِکَذَا : أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 21817","","","كتاب البيوع والأقضية"
"21818","(۲۱۸۱۸) حَدَّثَنَا یَحْیَی ابْن أَبِی زَائِدَۃَ ، عَنْ أَبِیہِ ، قَالَ : سُئِلَ عَامِرٌ عَنِ السَّلَمِ فِی الْحِنْطَۃِ وَالشَّعِیرِ أَیُّہُمَا اسْتَیْسَرَ عَلَیْہِ أَعْطَاہُ ؟ قَالَ : لاَ یَصْلُحُ۔","","Musannaf Ibn Abi Shaybah 21818","","","كتاب البيوع والأقضية"
"21819","(۲۱۸۱۹) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ : فِی رَجُلٍ أَسْلَمَ فِی شَیْئٍ مَعْلُومٍ إلَی أَجَلٍ مَعْلُومٍ ، فَإِنْ لَمْ یَدْفَعْہُ فَکَذَا وَکَذَا لِشَیْئٍ آخَرَ مَعْلُومٍ ، قَالَ : لاَ یَصْلُحُ۔","","Musannaf Ibn Abi Shaybah 21819","","","كتاب البيوع والأقضية"
"21820","(۲۱۸۲۰) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ : فِی الرَّجُلِ یُسْلِفُ فَیَقُولُ : إِنْ کَانَ بُرًّا فَبِکَذَا ، وَإِنْ کَانَ شَعِیرًا فَبِکَذَا : أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 21820","","","كتاب البيوع والأقضية"
"21821","(۲۱۸۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَسْلَمَ ، عْن عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنْ رَزِینِ بْنِ سُلَیْمَانَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : لاَ بَأْسَ بالسَّلَمِ فِی الثِّیَابِ ، ذَرْعٌ مَعْلُومٌ إلَی أَجَلٍ مَعْلُومٍ۔","","Musannaf Ibn Abi Shaybah 21821","","","كتاب البيوع والأقضية"
"21822","(۲۱۸۲۲) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ إبْرَاہِیمَ بْنِ نَشِیطٍ ، قَالَ : سَأَلَتْ بُکَیْر بْنَ عَبْدِ اللہِ بْنِ الأَشَجِّ عَنِ السَّلَمِ فِی الثِّیَابِ ؟ فَقَالَ : لاَ یَصْلح إلاَّ مَعْلُومَ الرُّقْعَۃِ مَعْلُومَ کَذَا۔","","Musannaf Ibn Abi Shaybah 21822","","","كتاب البيوع والأقضية"
"21823","(۲۱۸۲۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ وَوَکِیعٌ ، عَنْ زَکَرِیَّا ، قَالَ : سُئِلَ عَامِرٌ عَنِ السَّلَمِ فِی الْکَرَابِیسِ ؟ فَقَالَ : قَدْ کُنْت أَفْعَلُہُ۔","","Musannaf Ibn Abi Shaybah 21823","","","كتاب البيوع والأقضية"
"21824","(۲۱۸۲۴) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ سَالِمٍ ، عَنْ عَامِرٍ ، قَالَ : إذَا أَسْلَمَ فِی ثَوْبٍ یَعْرِفُ ذَرْعُہُ وَرُقعتہ فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 21824","","","كتاب البيوع والأقضية"
"21825","(۲۱۸۲۵) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ وَعَطَائٍ ، قَالاَ : لاَ بَأْسَ فِی السَّلَمِ فِی الصُّوفِ وَالأَکْسِیَۃِ۔","","Musannaf Ibn Abi Shaybah 21825","","","كتاب البيوع والأقضية"
"21826","(۲۱۸۲۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، أَنَّہُ سُئِلَ عَنِ السَّلَمِ فِی الْکَرَابِیسِ ؟ فَقَالَ : لاَ بَأْسَ بِہِ إذَا کَانَ فِی ذَرْعٍ مَعْلُومٍ إلَی أَجَلٍ مَعْلُومٍ۔","","Musannaf Ibn Abi Shaybah 21826","","","كتاب البيوع والأقضية"
"21827","(۲۱۸۲۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ ابْنُ مَسْعُودٍ لاَ یَرَی بِالسَّلَمِ فِی کُلِّ شَیْئٍ بَأْسًا إلَی أَجَلٍ مَعْلُومٍ مَا خَلاَ الْحَیَوَانَ۔","","Musannaf Ibn Abi Shaybah 21827","","","كتاب البيوع والأقضية"
"21828","(۲۱۸۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ حَنْظَلَۃَ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، قَالَ : سُئِلَ ابْنُ عَبَّاسٍ ، عَنْ رَجُلٍ أَسْلَمَ فِی سَبَائِبَ ، أَیُبَعْنَ قَبْلَ أَنْ یُسْتَوْفَیْنَ ، قَالَ : لاَ۔","Sahih","Musannaf Ibn Abi Shaybah 21828","","","كتاب البيوع والأقضية"
"21829","(۲۱۸۲۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ حُصَیْن الْحَارِثِیُّ ، عَنْ عَلِیٍّ ، قَالَ : إذَا تَتَابَعَ عَلَی الْمُکَاتَبِ نَجْمَانِ فَدَخَلَ فِی السَّنَۃِ فَلَمْ یُؤَدِّ نُجُومَہُ ، رُدَّ فِی الرِّقِّ۔","","Musannaf Ibn Abi Shaybah 21829","","","كتاب البيوع والأقضية"
"21830","(۲۱۸۳۰) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ: إذَا ، قَالَ الْمُکَاتَبُ : قَدْ عَجَزْت ، رُدَّ رَقِیقًا۔","","Musannaf Ibn Abi Shaybah 21830","","","كتاب البيوع والأقضية"
"21831","(۲۱۸۳۱) حَدَّثَنَا وَکِیعٌ ، وَابْنُ أَبِی زَائِدَۃَ ، عَنْ أَبَانَ بْنِ عَبْدِ اللہِ الْبَجَلِیِّ ، عَنْ عَطَائٍ : أَنَّ ابْنَ عُمَرَ کَاتَبَ غُلاَمًا لَہُ عَلَی أَلْفِ دِینَارٍ ، فَأَدَّاہَا إلاَّ مِئَۃ ، فَرَدَّہُ فِی الرِّقِّ۔","Sahih","Musannaf Ibn Abi Shaybah 21831","","","كتاب البيوع والأقضية"
"21832","(۲۱۸۳۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ الْعُکْلِیِّ ، قَالَ : إذَا دَخَلَ نَجْمٌ فِی نَجْمٍ فَقَدِ اسْتَبَانَ عَجْزُہُ۔","","Musannaf Ibn Abi Shaybah 21832","","","كتاب البيوع والأقضية"
"21833","(۲۱۸۳۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، عَن شُرَیْحٍ : أَنَّہُ کَانَ یَرُدُّ الْمُکَاتَبَ إذَا عَجَزَ، وَلاَ یَسْتَأْنِی بِہِ۔","","Musannaf Ibn Abi Shaybah 21833","","","كتاب البيوع والأقضية"
"21834","(۲۱۸۳۴) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إذَا کَاتَبَ غُلاَمَہُ عَلَی مِئَۃ أُوقِیَّۃٍ فَأَدَّاہَا إِلاَّ عَشْرَ أَوَاقٍ ، ثُمَّ عَجَزَ رُدَّ فِی الرِّقِّ۔n(ابوداؤد ۳۹۲۲۔ احمد ۲۰۶)","","Musannaf Ibn Abi Shaybah 21834","","","كتاب البيوع والأقضية"
"21835","(۲۱۸۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِید ، عَنْ أَبِی الْعَلاَئِ ، عَنِ الْحَکَمِ ، قَالَ : لاَ یُرَدُّ حَتَّی یَعْجِزَ عَنْ سِنِینَ۔","","Musannaf Ibn Abi Shaybah 21835","","","كتاب البيوع والأقضية"
"21836","(۲۱۸۳۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ طَاوُوسٍ ، قَالَ : إذَا عَلِمْت مَکِیلَۃَ شَیْئٍ فَلاَ تَبِعْہُ جُزَافًا۔","","Musannaf Ibn Abi Shaybah 21836","","","كتاب البيوع والأقضية"
"21837","(۲۱۸۳۷) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، قَالَ : قُلْتُ لأَِبِی : الرَّجُلُ یَقُولُ : قَدْ کِلْت فِی ہَذِہِ الخابیۃ کَذَا وَکَذَا مَنًا ، وَلاَ أَدْرِی لَعَلَّہُ نقصُ ، أَوْ سُرق ، أَوْ تشْتبِہُ الْخَابِیَۃ ، أَوْ کَانَ فِیہِ غَلَطٌ ، لاَ أَبِیعُک کَیْلاً ، إنَّمَا أَبِیعُک جُزَافًا، قَالَ : کَانَ ابْنُ سِیرِینَ یَکْرَہُہُ ، وَکَانَ الْحَسَنُ لاَ یَرَی بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 21837","","","كتاب البيوع والأقضية"
"21838","(۲۱۸۳۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ عَن رَجُلٍ کَالَ جُزَافًا ؟ فَقَالَ لَہُ : مَا کَانَ فِی بَیْتِکَ مِنْ حِنْطَۃٍ فَبِکَذَا ، وَمَا کَانَ مِنْ شَعِیرٍ فَبِکَذَا وَکَذَا ، قَالَ : فَکَرِہَہُ إبْرَاہِیمُ۔","","Musannaf Ibn Abi Shaybah 21838","","","كتاب البيوع والأقضية"
"21839","(۲۱۸۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ فِطْرٍ : أَنَّہُ سَأَلَ الشَّعْبِیَّ عَنْ قَوْمٍ مِنَ الأَعْرَابِ یَقْدَمُونَ عَلَیْنَا بِالطَّعَامِ فَنَشْتَرِی مِنْہُمْ کَیْلاً ، ثُمَّ نَقُولُ : بِیعُونَا جُزَافًا ، قَالَ : لاَ ، حَتَّی تَتَارَکُوا الْبَیْعِ۔","","Musannaf Ibn Abi Shaybah 21839","","","كتاب البيوع والأقضية"
"21840","(۲۱۸۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ : أَنَّہُ لَمْ یَکُنْ یَرَی بَأْسًا أَنْ یَبِیعَہُ جُزَافًا إذَا أَعْلَمَہُ أَنَّہُ یَعْلَمُ کَیْلَہُ۔","","Musannaf Ibn Abi Shaybah 21840","","","كتاب البيوع والأقضية"
"21841","(۲۱۸۴۱) حَدَّثَنَا رَوَّادُ بْنُ جَرَّاحٍ أَبُو عِصَامٍ الْعَسْقَلاَنِیُّ ، عَنِ الأَوْزَاعِی ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، قَالَ : سَأَلْتُ الْحَسَنَ وَمُجَاہِدًا وَعِکْرِمَۃَ وعَطَاء ، عَنْ رَجُلٍ یَأْتِی الرَّجُلَ فَیبْتَاعَ مِنْ بَیْتِہِ طَعَامًا فِیہِ مُجَازَفَۃً ، وَرَبُّ الطَّعَامِ قَدْ عَلِمَ کَیْلَہُ ؟ فَکَرِہَہُ کُلُّہُمْ۔","","Musannaf Ibn Abi Shaybah 21841","","","كتاب البيوع والأقضية"
"21842","(۲۱۸۴۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عن نَافِعٍ ، قَالَ : لَقَدْ رَأَیْتنَا وَفِینَا أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُجَائُ بِالأَوْسَاقِ فَتُلْقَی فی الْمُصَلَّی فَیَقُولُ الرَّجُلُ : کِلْت کَذَا وَکَذَا ، وَلاَ أَبِیعُہُ مُکَایَلَۃً ، إنَّمَا أَبِیعُہُ مُجَازَفَۃً ، فَلَمْ یَرَوْا بِہِ بَأْسًا۔","Da'if","Musannaf Ibn Abi Shaybah 21842","","","كتاب البيوع والأقضية"
"21843","(۲۱۸۴۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کُنَّا نَتَلََقَی الرُّکْبَانِ ، فَنَشْتَرِی مِنْہُمَ الطَّعَامَ مُجَازَفَۃً ، فَنَہَانا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ نَبِیعَہُ حَتَّی نُحَوِّلَہُ مِنْ مَکَانِہِ ، أَوْ نَنْقُلَہُ۔n(بخاری ۲۱۶۶۔ مسلم ۱۱۶۱)","Sahih","Musannaf Ibn Abi Shaybah 21843","","","كتاب البيوع والأقضية"
"21844","(۲۱۸۴۴) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ وَأَشْعَثَ وَإِسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ : فِی مُکَاتَبٍ مَاتَ ، وَعَلَیْہِ دَیْنٌ وَبَقِیَّۃٌ مِنْ مُکَاتَبَتِہِ ، قَالَ : یَضْرِبُ مَوَالِیہِ بِمَا حَلَّ مِنْ نُجُومِہِ۔nوَقَالَ حَمَّادٌ : یَضْرِبُونَ بِمَا حَلَّ مَا لَمْ یَحِلَّ۔","","Musannaf Ibn Abi Shaybah 21844","","","كتاب البيوع والأقضية"
"21845","(۲۱۸۴۵) حَدَّثَنَا حَفْصٌ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : أَخْطَأَ شُرَیْحٌ ، وَإِنْ کَانَ قَاضِیًا ، کَانَ زَیْدُ بْنُ ثَابِتٍ یَقُولُ : یُبْدَأُ بِالدَّیْنِ قَبْلَ الْمُکَاتَبَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 21845","","","كتاب البيوع والأقضية"
"21846","(۲۱۸۴۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا مَاتَ الْمُکَاتَبُ وَعَلَیْہِ دَیْنٌ یَضْرِبُ مَوَالِیہِ بِمَا حَلَّ مِنْ نُجُومِہِ مَعَ الْغُرَمَائِ ، وَإِنْ لَمْ یَکُنْ لَہُ نَجْمٌ حَالٌّ بُدِئَ بِالْغُرَمَائِ فَأَخَذُوا دَیْنَہُمْ ، فَإِنْ فَضَلَ شَیْئٌ کَانَ لِمَوَالِیہِ حَتَّی تَتِمَّ مُکَاتَبَتُہُ ، فَإِنْ فَضَلَ شَیْئٌ بَعْدَ مُکَاتَبَتِہِ کَانَ لِوَرَثَتِہِ۔","","Musannaf Ibn Abi Shaybah 21846","","","كتاب البيوع والأقضية"
"21847","(۲۱۸۴۷) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ، قَالَ: یَضْرِبُ مَوْلاَہُ مَعَ الْغُرَمَائِ بِمَا حَلَّ مِنْ نُجُومِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21847","","","كتاب البيوع والأقضية"
"21848","(۲۱۸۴۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عن ہشام ، عن الحسن ، قَالَ : یُبْدَأُ بِالدَّیْنِ۔","","Musannaf Ibn Abi Shaybah 21848","","","كتاب البيوع والأقضية"
"21849","(۲۱۸۴۹) حَدَّثَنَا غُنْدَرُ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ شُرَیْحٍ ، قَالَ : یُبْدَأُ بِالدَّیْنِ۔ (بیہقی ۳۳۳)","","Musannaf Ibn Abi Shaybah 21849","","","كتاب البيوع والأقضية"
"21850","(۲۱۸۵۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ وَالْحَکَمِ ، أَنَّہُمَا قَالاَ : إذَا کَانَ عَلَی الرَّجُلِ الدَّیْنُ وَبَقِیَّۃٌ مِنْ مُکَاتَبَتِہِ ، قَالَ : یُنْظَرُ إلَی مَا حَلَّ عَلَیْہِ مِنْ نُجُومِہِ ، وَمَا کَانَ لِغُرَمَائِہِ فَیُقَسَّمُ ذَلِکَ بِالْحِصَصِ۔","","Musannaf Ibn Abi Shaybah 21850","","","كتاب البيوع والأقضية"
"21851","(۲۱۸۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ وَسُفْیَانَ وَابْنِ أَبِی لَیْلَی ، کَانُوا یَقُولُونَ : إذَا مَاتَ وَعَلَیْہِ دَیْنٌ : حَلَّ مَا عَلَیْہِ ، فَیَضْرِبُ الْمَوْلَی مَعَ الْغُرَمَائِ بِجَمِیعِ الْمُکَاتَبَۃِ۔","","Musannaf Ibn Abi Shaybah 21851","","","كتاب البيوع والأقضية"
"21852","(۲۱۸۵۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : أَخْطَأَ شُرَیْحٌ ، وَإِنْ کَانَ قَاضِیًا ، قَالَ زَیْدُ بْنُ ثَابِتٍ : یَبْدَأُ بِالدَّیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 21852","","","كتاب البيوع والأقضية"
"21853","(۲۱۸۵۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : أَخْبَرَنِی أَبِی : أَنَّ نَاسًا مِنْ فَہْمٍ خَاصَمُوا نَاسًا مِنْ بَنِی سُلَیْمٍ فِی مَعْدِنٍ لَہُمْ إلَی مَرْوَانَ ، فَأَمَرَ مَرْوَانُ ابْنَ الزُّبَیْرِ أَنْ یَقْضِیَ بَیْنَہُمْ ، فَاسْتَوَتِ الشُّہُودُ فَأَقْرَعَ بَیْنَہُمْ عَبْدُ اللہِ ، فَجَعَلَہُ لِمَنْ أَصَابَتْہُ الْقُرْعَۃُ مِنْ أَجْلِ أَنَّ الشُّہُودَ اسْتَوَتْ۔","Sahih","Musannaf Ibn Abi Shaybah 21853","","","كتاب البيوع والأقضية"
"21854","(۲۱۸۵۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، وَابْنُ أَبِی زَائِدَۃَ ، عَنْ حَجَّاجٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا اسْتَوَتِ الْبَیِّنَتَانِ فَہِیَ لِلَّذِی فِی أَیْدِیہِمْ۔","","Musannaf Ibn Abi Shaybah 21854","","","كتاب البيوع والأقضية"
"21855","(۲۱۸۵۵) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، أَنَّہُ قَالَ فِی الْقَوْمِ إذَا اخْتَلَفَتْ شَہَادَتُہُمْ وَاسْتَوَوْا فِی التَّعْدِیلِ وَالْعَدَدِ : فَالْیَمِینُ عَلَی مَنِ ادُّعَیَ عَلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21855","","","كتاب البيوع والأقضية"
"21856","(۲۱۸۵۶) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَسْتَقْبِلُوا ، وَلاَ تُحَفِّلُوا ، وَلاَ یُنفِّقُ بَعْضُکُمْ لِبَعْضٍ۔","","Musannaf Ibn Abi Shaybah 21856","","","كتاب البيوع والأقضية"
"21857","(۲۱۸۵۷) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ أَبِی جَعْفَرٍ الرَّازِیّ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ تَلَقُّوا الْبُیُوعَ بِأَفْوَاہِ السِّکَکِ۔","Da'if","Musannaf Ibn Abi Shaybah 21857","","","كتاب البيوع والأقضية"
"21858","(۲۱۸۵۸) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ إیَاسِ بْنِ دَغْفَلٍ ، قَالَ : قرِئَ عَلَیْنَا کِتَابُ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ : لاَ تَلَقُّوا الرُّکْبَانَ۔","","Musannaf Ibn Abi Shaybah 21858","","","كتاب البيوع والأقضية"
"21859","(۲۱۸۵۹) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : نُہِیَ عَنْ تَلَقِّی الْجَلَبَ ، فَإِنْ تَلَقَّی رَجُلٌ فَاشْتَرَی فَصَاحِبُہُ بِالْخِیَارِ إذَا قَدِمَ الْمِصْرَ۔","","Musannaf Ibn Abi Shaybah 21859","","","كتاب البيوع والأقضية"
"21860","(۲۱۸۶۰) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ النَّہْدِیِّ ، عَنِ ابْنِ مَسْعُودٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُ نَہَی عَنْ تَلَقِّی الْبُیُوعِ۔ (بخاری ۲۱۴۹۔ مسلم ۱۱۵۶)","Sahih","Musannaf Ibn Abi Shaybah 21860","","","كتاب البيوع والأقضية"
"21861","(۲۱۸۶۱) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَلَقُّوا الرُّکْبَانَ لِلْبَیْعِ۔ (بخاری ۲۱۵۰۔ مسلم ۱۱۵۵)","Hasan","Musannaf Ibn Abi Shaybah 21861","","","كتاب البيوع والأقضية"
"21862","(۲۱۸۶۲) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنِ الرَّبِیعِ بْنِ حَبِیبٍ ، عَنْ نَوْفَلِ بْنِ عَبْدِ الْمَلِکِ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُ نَہَی عَنِ التَّلَقِّی۔ (ابن ماجہ ۲۲۰۶۔ ابویعلی ۵۳۷)","Munkar","Musannaf Ibn Abi Shaybah 21862","","","كتاب البيوع والأقضية"
"21863","(۲۱۸۶۳) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، وَأَبِی ہُرَیْرَۃَ ، قَالاَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تُلَقَّی الْبُیُوعُ مِنْ أَفْوَاہِ الطُّرُقِ۔ (طبرانی۱۲۔ دارقطنی ۲۸۱)","Da'if","Musannaf Ibn Abi Shaybah 21863","","","كتاب البيوع والأقضية"
"21864","(۲۱۸۶۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَیْسَ عَلَی الْمُسْتَکْرِی وَالْمُسْتَعِیرِ وَالْمُسْتَوْدَعِ ضَمَانٌ إلاَّ أَنْ یُخَالِفَ۔","","Musannaf Ibn Abi Shaybah 21864","","","كتاب البيوع والأقضية"
"21865","(۲۱۸۶۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ سَالِمٍ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یَقُولُ : إذَا خَالَفَ الْمُسْتَوْدَعُ وَالْمُسْتَعِیرُ وَالْمُسْتَبْضَعُ ، فَہُوَ ضَامِنٌ۔","","Musannaf Ibn Abi Shaybah 21865","","","كتاب البيوع والأقضية"
"21866","(۲۱۸۶۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا نَہَیْت مُضَارِبَک أَنْ یَشْتَرِیَ مِنْ مَتَاعِ کَذَا وَکَذَا فَاشْتَرَی ضَمِنَ ، وَقَالَ حَمَّادٌ : یَتَصَدَّقَانِ بِالرِّبْحِ۔","","Musannaf Ibn Abi Shaybah 21866","","","كتاب البيوع والأقضية"
"21867","(۲۱۸۶۷) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : الْمُضَارِبُ مُؤْتَمَنٌ ، وَإِنْ خَالَفَ أَمْرَک۔","","Musannaf Ibn Abi Shaybah 21867","","","كتاب البيوع والأقضية"
"21868","(۲۱۸۶۸) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ : أَنَّ عُمَرَ ضَمَّنَ أَنَسًا أَرْبَعَۃَ آلاَفٍ کَانَتْ مَعَہُ مُضَارَبَۃً۔","","Musannaf Ibn Abi Shaybah 21868","","","كتاب البيوع والأقضية"
"21869","(۲۱۸۶۹) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ حسین ، عَنِ الْحَسَنِ ، قَالَ : الْمُضَارِبُ مُؤْتَمَنٌ ، وَإِنْ خَالَفَ۔","","Musannaf Ibn Abi Shaybah 21869","","","كتاب البيوع والأقضية"
"21870","(۲۱۸۷۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، عَنْ أَنَسِ بنِ مَالِکَ ، قَالَ : اُسْتُوْدِعْتُ سِتَّۃَ آلاَفٍ فَذَہَبَتْ ، فَقَالَ : لِی عُمَرُ : ذَہَبَ لَکَ مَعَہَا شَیْئٌ ؟ قُلْتُ : لاَ قَالَ : فَضَمَّنَنِی۔","","Musannaf Ibn Abi Shaybah 21870","","","كتاب البيوع والأقضية"
"21871","(۲۱۸۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَبِی الْمُہَزِّمِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : إذَا شَرَطَ رَبُّ الْمَالِ عَلَی الْمُضَارِبِ : لاَ یَنْزِلُ بَطْنَ وَادٍ ، فَنَزَلَ ، فَہُوَ ضَامِنٌ۔","Da'if","Musannaf Ibn Abi Shaybah 21871","","","كتاب البيوع والأقضية"
"21872","(۲۱۸۷۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : مَنْ قَاسَمَ الرِّبْحَ فَلاَ ضَمَانَ عَلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 21872","","","كتاب البيوع والأقضية"
"21873","(۲۱۸۷۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنِ الْحَسَنِ ؛ فِی مُضَارِبٍ دَفَعَ الْمَالَ إلَی غَیْرِہِ ، قَالَ : لاَ ضَمَانَ عَلَیْہِ ، ہُوَ أَمِینٌ۔","","Musannaf Ibn Abi Shaybah 21873","","","كتاب البيوع والأقضية"
"21874","(۲۱۸۷۴) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ عُثْمَانَ ابْنِ أَخِی شُرَیْحٍ ، عَنْ شُرَیْحٍ ، أَنَّہُ قَالَ : إذَا خَالَفَ فِی الْوَدِیعَۃِ وَالْکراء ، فَہُوَ ضَامِنٌ۔","","Musannaf Ibn Abi Shaybah 21874","","","كتاب البيوع والأقضية"
"21875","(۲۱۸۷۵) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ : فِی مُضَارِبٍ قَالَ لَہُ صَاحِبُ الْمَالِ : لاَ تُجَاوِزْ مَکَانَ کَذَا وَکَذَا ، قَالَ : ہُوَ ضَامِنَ إِنْ جَاوَزَہُ۔","","Musannaf Ibn Abi Shaybah 21875","","","كتاب البيوع والأقضية"
"21876","(۲۱۸۷۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ بِنَحْوِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21876","","","كتاب البيوع والأقضية"
"21877","(۲۱۸۷۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : لاَ تَشْتَرِطْ عَلَی الْمُضَارِبِ شَیْئًا فَإِنِّی أَخَافُ أَنْ یُخَالِفَ ، فَیفْسِدَ عَلَیْک ، وَعَلَی نَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 21877","","","كتاب البيوع والأقضية"
"21878","(۲۱۸۷۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ : أَنَّہُ سُئِلَ عَنْ رَجُلٍ دُفِعَ إلَیْہِ مَالَ مُضَارَبَۃً ، وَقَالَ : لاَ تَخْرُجْ مِنَ الْمِصْرِ ، فَخَرَجَ ، قَالَ : لاَ ضَمَانَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 21878","","","كتاب البيوع والأقضية"
"21879","(۲۱۸۷۹) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ : فِی الْمُضَارِبِ إذَا اشْتَرَطُوا عَلَیْہِ : أنْ لاَ یُجَاوِزَ، فَجَاوَزَ ، فَہُوَ ضَامِنٌ۔","","Musannaf Ibn Abi Shaybah 21879","","","كتاب البيوع والأقضية"
"21880","(۲۱۸۸۰) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ أَیُّوبَ ، عَنْ إیَاسِ بْنِ مُعَاوِیَۃَ ، قَالَ : ہُوَ ضَامِنٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 21880","","","كتاب البيوع والأقضية"
"21881","(۲۱۸۸۱) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ عَطَائٍ ، قَالَ : إِنْ نَہَاہُ أَنْ یَخْرُجَ فَخَرَجَ ، فَہُوَ ضَامِنٌ۔","","Musannaf Ibn Abi Shaybah 21881","","","كتاب البيوع والأقضية"
"21882","(۲۱۸۸۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، وَمُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا خَالَفَ الْمُسْتَوْدِعَ وَالْمُسْتَعِیرَ وَالْمُسْتَبْضِعَ ، فَہُوَ ضَامِنٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 21882","","","كتاب البيوع والأقضية"
"21883","(۲۱۸۸۳) حَدَّثَنَا حَفْصٌ ، عَنْ حُجَّاجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، أَنَّ أَبَا بَکْرٍ کَانَ لاَ یُضَمِّنُ الْوَدِیعَۃَ۔","","Musannaf Ibn Abi Shaybah 21883","","","كتاب البيوع والأقضية"
"21884","(۲۱۸۸۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ ہِلاَلِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَبْدِ اللہِ بْنِ عُکَیْمٍ : أَنَّ رَجُلاً اسْتَوْدَعَ رَجُلاً وَدِیعَۃً فَہَلَکَتْ فَلَمْ یُضَمِّنُہُ عُمَرُ۔","","Musannaf Ibn Abi Shaybah 21884","","","كتاب البيوع والأقضية"
"21885","(۲۱۸۸۵) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ، قَالَ: لَیْسَ عَلَی الْمُسْتَوْدَعِ وَالْمُسْتَعِیرِ ضَمَانٌ إلاَّ أَنْ یُتَّہَمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21885","","","كتاب البيوع والأقضية"
"21886","(۲۱۸۸۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ ۔ وَعَنْ أَشْعَثَ ، عَنِ الْحَکَمِ : أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا بِالرَّہْنِ إذَا کَانَ عَلَی یَدَیْ عَدْلٍ مَقْبُوضًا۔","","Musannaf Ibn Abi Shaybah 21886","","","كتاب البيوع والأقضية"
"21887","(۲۱۸۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ وَأَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : ہُوَ رَہْنٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 21887","","","كتاب البيوع والأقضية"
"21888","(۲۱۸۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، قَالَ : لاَ یَکُونُ رَہْنًا حَتَّی یَقْبِضَہُ صَاحِبُہُ۔","","Musannaf Ibn Abi Shaybah 21888","","","كتاب البيوع والأقضية"
"21889","(۲۱۸۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ سَالِمٍ ، عَنْ سَعِیدٍ : أَنَّہُ قَرَأَہَا (فَرِہَانٌ مَقْبُوضَۃٌ) ، قَالَ : لاَ یَکُونُ الرَّہْنُ إلاَّ مَقْبُوضًا۔","No Data Available","Musannaf Ibn Abi Shaybah 21889","","","كتاب البيوع والأقضية"
"21890","(۲۱۸۹۰) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ أَنْ یُعْطَی الرَّجُلُ مَالاً مُضَارَبَۃً عَلَی أَنْ یُعْطِیَہُ بِضَاعَۃً۔","","Musannaf Ibn Abi Shaybah 21890","","","كتاب البيوع والأقضية"
"21891","(۲۱۸۹۱) حَدَّثَنَا ابْنُ أَبِی رَوَّادَ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 21891","","","كتاب البيوع والأقضية"
"21892","(۲۱۸۹۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ : أَنَّہُ سُئِلَ عَنْ رَجُلٍ دَفَعَ إلَی رَجُلٍ مَالاً مُضَارَبَۃً ، وَاشْتَرَطَ عَلَیْہِ بِضَاعَۃً ؟ أَنَّہُ کَرِہَہُ۔n وَکَانَ ابْنُ سِیرِینَ لاَ یَرَی بِہِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 21892","","","كتاب البيوع والأقضية"
"21893","(۲۱۸۹۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَدْفَعَ الرَّجُلُ إلَی الرَّجُلِ مَالاً مُضَارَبَۃً عَلَی أَنْ یجعل لَہُ بِضَاعَۃً ، أَوْ یَعْمَلَ لَہُ عَمَلاً۔","","Musannaf Ibn Abi Shaybah 21893","","","كتاب البيوع والأقضية"
"21894","(۲۱۸۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِیہِ ، عَنْ عِکْرِمَۃَ ، قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ فِی أُمِّ الْوَلَدِ : أَعْتَقَہَا وَلَدُہَا ، وَإِنْ کَانَ سِقْطًا۔","","Musannaf Ibn Abi Shaybah 21894","","","كتاب البيوع والأقضية"
"21895","(۲۱۸۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ بْنِ قَارِبٍ الثَّقَفِیِّ ، عَنْ أَبِیہِ : أَنَّہُ اشْتَرَی مِنْ رَجُلٍ جَارِیَۃً بِأَرْبَعَۃِ آلاَفٍ قَدْ کَانَتْ أَسْقَطَتْ مِنْ مَوْلاَہَا سِقْطًا ، فَبَلَغَ ذَلِکَ عُمَرَ فَأَتَاہُ فَعَلاَہُ بِالدِّرَّۃِ ضَرْبًا ، وَقَالَ : بَعْدَ مَا اخْتَلَطَتْ لُحُومُکُمْ بِلُحُومِہِنَّ وَدِمَاؤُکُمْ بِدِمَائِہِنَّ بِعْتُمُوہُنَّ ، لَعَنَ اللَّہُ الْیَہُودَ ، حُرِّمَتْ عَلَیْہِمَ الشُّحُومَ فَبَاعُوہَا وَأَکَلُوا أَثمانہَا۔","Hasan","Musannaf Ibn Abi Shaybah 21895","","","كتاب البيوع والأقضية"
"21896","(۲۱۸۹۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا حَمَلَتِ الأَمَۃُ مِنْ سَیِّدِہَا ، ثُمَّ أَسْقَطَتْ ، قَالَ : إِنْ کَانَ اسْتَبَانَ خَلْقَہُ فَہِیَ أُمُّ وَلَدٍ ، لاَ سَبِیلَ إلَی بَیْعِہَا۔","","Musannaf Ibn Abi Shaybah 21896","","","كتاب البيوع والأقضية"
"21897","(۲۱۸۹۷) حَدَّثَنَا ہُشَیْمٌ، عَنْ دَاوُدَ، عَنِ الشَّعْبِیِّ، قَالَ: إذَا تَلبَّس فِی الْخَلْقِ الرَّابِعِ، فَکَانَ مُخَلَّقًا أُعْتِقَتْ بِہِ الأَمَۃُ۔","","Musannaf Ibn Abi Shaybah 21897","","","كتاب البيوع والأقضية"
"21898","(۲۱۸۹۸) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ وَمُحَمَّدٍ، أَنَّہُمَا قَالاَ: إذَا أَسْقَطَتِ الأَمَۃُ مِنْ سَیِّدِہَا فَہِیَ حُرَّۃٌ۔","","Musannaf Ibn Abi Shaybah 21898","","","كتاب البيوع والأقضية"
"21899","(۲۱۸۹۹) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : تَعْتقُ أُمُّ الْوَلَدِ إذَا أَسْقَطَتْ إذَا عُلِمَ أَنَّہُ کَانَ سَقْطًا۔","","Musannaf Ibn Abi Shaybah 21899","","","كتاب البيوع والأقضية"
"21900","(۲۱۹۰۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ : فِی أُمِّ الْوَلَدِ إذَا وَضَعَتْہُ وَہُوَ مُضْغَۃٌ ، فَقَدْ عَتَقَتْ بِہِ۔","","Musannaf Ibn Abi Shaybah 21900","","","كتاب البيوع والأقضية"
"21901","(۲۱۹۰۱) حَدَّثَنَا جَرِیرٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ عَطَائٍ ، قَالَ : سَأَلْتُہ قُلْتُ : إنَّا نَحْمِلُ ہَذِہِ الْبَضَائِعَ لِلنَّاسِ فَنَحْتَاجُ إلَیْہَا فِی الطَّرِیقِ ، قَالَ : إذَا قَدِمْتَ اشْتَرَیْتَ لأَِصْحَابِہَا حَاجَتَہَا ، وَلَمْ تَحْبِسْہَا ؟ قُلْتُ : بَلَی ، قَالَ : لاَ بَأْسَ ، ہُوَ خَیْرٌ لِصَاحِبِ الْبِضَاعَۃِ۔","","Musannaf Ibn Abi Shaybah 21901","","","كتاب البيوع والأقضية"
"21902","(۲۱۹۰۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ : فِی رَجُلٍ دُفِعَتْ إلَیْہِ دَرَاہِمُ یَشْتَرِی بِہَا شَیْئًا فَصَرَفَہَا فِی حَاجَتِہِ ، ثُمَّ رَدَّہَا ، فَاشْتَرَی بِہَا الَّذِی أُمِرَ بِہِ ، قَالَ : ہُوَ ضَامِنٌ حَتَّی یُسَلِّمَہَا إلَی رَبِّہَا۔","","Musannaf Ibn Abi Shaybah 21902","","","كتاب البيوع والأقضية"
"21903","(۲۱۹۰۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ إسْمَاعِیلَ بن سمیع ، عَنْ مَاہَانَ ، قَالَ : مَرَّ ابْنُ مَسْعُودٍ عَلَی رَجُلٍ یَزِنُ ذریرۃ قَال : أُرْجِحُ ، فَقَالَ : أَقِمْ لِسَانَ الْمِیزَانِ ، فَإِذَا اسْتَقَامَ فَزِدْہُ مِنْ مَالِکٍ مَا شِئْت۔","Hasan","Musannaf Ibn Abi Shaybah 21903","","","كتاب البيوع والأقضية"
"21904","(۲۱۹۰۴) حَدَّثَنَا أَبُو الأَحْوَص، عَنْ أَبِی سِنَانٍ، عَنِ ابْنِ الْہُذَیْلِ، کَذَا قَالَ أَبُو الأَحْوَص، قَالَ: رَأَیْتُ عَمَّارَ بْنَ یَاسِرٍ اشْتَرَی قَبائً ، فَاسْتَزَادَہُ حَبْلاً ، فَأَبَی أَنْ یَزِیدَہُ ، فَرَأَیْتُ عَمَّارًا یُنَازِعُہُ إیَّاہُ ، فَلاَ أَدْرِی أَیُّہُمَا غَلَبَ عَلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 21904","","","كتاب البيوع والأقضية"
"21905","(۲۱۹۰۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَبِی سِنَانٍ ، عَنِ ابْنِ أَبِی الْہُذَیْلِ ، عَنْ عَمَّارٍ ، مِثْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 21905","","","كتاب البيوع والأقضية"
"21906","(۲۱۹۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ یُونُسَ ، عَنْ بَہْدَلِ أَبِی الْوَضَّاحِ الشَّیْبَانِیِّ ، عَنْ رَجُلٍ ، عَنْ عَلِیٍّ : أَنَّہُ مَرَّ عَلَی عَائِشَۃَ وَقَدِ اشْتَرَتْ لَحْمًا وَہِیَ تَقُولُ لَہُ : زِدْنِی ، فَقَالَ لَہُ : زِدْہَا ، ہُوَ أَعْظَمُ لِبَرَکَۃِ الْبَیْعِ۔","Da'if","Musannaf Ibn Abi Shaybah 21906","","","كتاب البيوع والأقضية"
"21907","(۲۱۹۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَسْتَزِیدَ عَلَی الْبَیْعِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21907","","","كتاب البيوع والأقضية"
"21908","(۲۱۹۰۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی حَصِینٍ ، عَنْ رَجُلٍ مِنَ النَّخَعِ ، قَالَ : رَأَیْتُ عَمَّارًا اشْتَرَی قَبَائً مِنْ رَجُلٍ فَنَازَعَہُ حَبْلاً ، وَعَمَّارٌ یَقُولُ : زِدْنِی ، وَالآخَرُ یَقُولُ : لاَ۔","Da'if","Musannaf Ibn Abi Shaybah 21908","","","كتاب البيوع والأقضية"
"21909","(۲۱۹۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَمَّنْ سَمِعَ ابْنَ عُمَرَ یَقُولُ لَہُ : إذَا اشْتَرَیْت لَحْمًا فَلاَ تَزْدَادنَّ۔","Da'if","Musannaf Ibn Abi Shaybah 21909","","","كتاب البيوع والأقضية"
"21910","(۲۱۹۱۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، قَالَ : قَالَ أَبُو الشَّعْثَائِ : لاَ تَجُوزُ لاِمْرَأَۃٍ عَطِیَّۃً حَتَّی تَلِدَ شَرْوَاہَا۔","","Musannaf Ibn Abi Shaybah 21910","","","كتاب البيوع والأقضية"
"21911","(۲۱۹۱۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : لاَ یَجُوزُ لاِمْرَأَۃٍ عَطِیَّۃٌ إلاَّ بِإِذْنِ زَوْجِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 21911","","","كتاب البيوع والأقضية"
"21912","(۲۱۹۱۲) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا حَالَتْ فِی بَیْتِہَا حَوْلاً جَازَ لَہَا مَا صَنَعَتْ۔","","Musannaf Ibn Abi Shaybah 21912","","","كتاب البيوع والأقضية"
"21913","(۲۱۹۱۳) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا وَلَدَتِ الْجَارِیَۃُ ، أَوْ وَلَدَ مِثْلہَا جَازَ لَہَا ہِبَتُہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 21913","","","كتاب البيوع والأقضية"
"21914","(۲۱۹۱۴) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَبِیہِ ، عَنْ عَامِرٍ ، عَنْ شُرَیْحٍ ، قَالَ : عَہِدَ إلَیَّ عُمَرُ أَنْ لاَ أُجِیزَ ہِبَۃً مُمْلِکَۃٍ حَتَّی تَحُولَ فِی بَیْتِہَا حَوْلاً ، أَوْ تَلِدَ بَطْنًا۔","Sahih","Musannaf Ibn Abi Shaybah 21914","","","كتاب البيوع والأقضية"
"21915","(۲۱۹۱۵) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ إسماعیل ، عن الشعبی ، عن شریح : بمثلہ۔","","Musannaf Ibn Abi Shaybah 21915","","","كتاب البيوع والأقضية"
"21916","(۲۱۹۱۶) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ مُجَالِدٍ ، عَنْ عَامِرٍ ، قَالَ : قرَأْت کِتَابَ عُمَرَ إلَی شُرَیْحٍ بِذَلِکَ ، وَذَلِکَ أَنَّ جَارِیَۃً مِنْ قُرَیْشٍ قَالَ لَہَا أَخُوہَا وَہِیَ مُمْلِکَۃٌ : تَصَدَّقِی عَلَیَّ بِمِیرَاثِکَ مِنْ أَبِیک قَبْلَ أَنْ تَذْہَبِی إلَی زَوْجِکَ، فَفَعَلَتْ ، ثُمَّ طَلَبَتْ مِیرَاثَہَا فَرَدَّہُ عَلَیْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 21916","","","كتاب البيوع والأقضية"
"21917","(۲۱۹۱۷) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ ، قَالَ مُحَمَّدٌ : لاَ تَجُوزُ لاِمْرَأَۃٍ عَطِیَّۃٌ حَتَّی تَحُولَ حَوْلاً ، أَوْ تَلِدَ وَلَدًا ، وَقَالَ الْحَسَنُ : حَتَّی تَلِدَ وَلَدًا ، أَوْ تَبْلُغ إنَی ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 21917","","","كتاب البيوع والأقضية"
"21918","(۲۱۹۱۸) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : قُلْتُ لَہُ : أَرَأَیْت إِنْ عَنَسَتْ ، قَالَ : لاَ یَجُوزُ۔","","Musannaf Ibn Abi Shaybah 21918","","","كتاب البيوع والأقضية"
"21919","(۲۱۹۱۹) حَدَّثَنَا عُبَیْدُ اللہِ عن عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ عَطَائٍ وَمُجَاہِدٍ ، قَالاَ : لِلْیَتِیمَۃِ خِنَاقَانِ لاَ یَجُوزُ لَہَا شَیْئٌ فِی مَالِہَا حَتَّی تَلِدَ وَلَدًا ، أَوْ تَمْضِی عَلَیْہَا سَنَۃٌ فِی بَیْتِ زَوْجِہَا۔","","Musannaf Ibn Abi Shaybah 21919","","","كتاب البيوع والأقضية"
"21920","(۲۱۹۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ وَزَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ : قَالَ لی عُمَرُ : إِنی لاَ أُجِیزَ عَطیَّۃ جَارِیَۃٍ حَتَّی تَحُولَ فِی بَیْتِہَا حَوْلاً ، أَوْ تَلِدَ وَلَدًا۔ قَالَ إسْمَاعِیلُ : قُلْتُ لِلشَّعْبِیِّ : أَرَأَیْت إِنْ عَنَسَتْ یَجُوزُ ؟ قَالَ : نَعَمْ۔","Sahih","Musannaf Ibn Abi Shaybah 21920","","","كتاب البيوع والأقضية"
"21921","(۲۱۹۲۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ لاَ یَرَی بَأْسًا بِثَمَنِ الْہِرِّ۔","No Data Available","Musannaf Ibn Abi Shaybah 21921","","","كتاب البيوع والأقضية"
"21922","(۲۱۹۲۲) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ وَطَاوُسٍ : أَنَّہُمَا کَرِہَا ثَمَنَ السِّنَّوْرِ وَبَیْعَہُ وَأَکْلَ لَحْمِہِ وَأَنْ یُنْتَفَعَ بِجِلْدِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21922","","","كتاب البيوع والأقضية"
"21923","(۲۱۹۲۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنْ ثَمَنِ السِّنَّوْرِ ؟ فَقَالاَ : لاَ بَأْسَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21923","","","كتاب البيوع والأقضية"
"21924","(۲۱۹۲۴) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ أَبِی حُرَّۃَ ، عَنِ الْحَسَنِ : فِی رَجُلٍ اشْتَرَی ہِرًّا فَقَالَ : لاَ بَأْسَ بِشِرَائِہِ ، وکَرِہَ ثَمَنُہُ لِلْبَائِعِ۔","","Musannaf Ibn Abi Shaybah 21924","","","كتاب البيوع والأقضية"
"21925","(۲۱۹۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی حَنِیفَۃَ ، قَالَ : سَأَلْتُ عَطَائً عَنْہُ ؟ فَقَالَ : لاَ بَأْسَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21925","","","كتاب البيوع والأقضية"
"21926","(۲۱۹۲۶) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَش ، قَالَ : أَرَی أباَ سُفْیَانَ ذَکَرَہُ ، عَنْ جَابِرٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ ثَمَنِ الْہِرِّ۔","","Musannaf Ibn Abi Shaybah 21926","","","كتاب البيوع والأقضية"
"21927","(۲۱۹۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَبِی الْمُہَزِّمِ ، عَنْ أَبِی ہُرَیْرَۃَ ۔ وَعَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ : أَنَّہُمَا کَرِہَا ثَمَنَ الْہِرِّ۔","Da'if","Musannaf Ibn Abi Shaybah 21927","","","كتاب البيوع والأقضية"
"21928","(۲۱۹۲۸) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ سِمَاکٍ ، عَنْ قَابُوسَ بْنِ الْمُخَارِقِ ، عَنْ أَبِیہِ ، قَالَ : بَعَثَ عَلِیٌّ مُحَمَّدَ بْنَ أَبِی بَکْرٍ عَلَی مِصْرَ ، فَکَتَبَ إلَیْہِ یَسْأَلُہُ ، عَنْ مُکَاتَبٍ مَاتَ وَتَرَکَ مَالاً وَوَلَدًا ، فَکَتَبَ یَأْمُرُ فِی المکاتب : إِنْ کَانَ تَرَکَ وَفَائً لِمُکَاتَبَتِہِ یُدْعَی مَوَالِیہِ فَیَسْتَوْفُونَ ، وَمَا بَقِیَ کَانَ مِیرَاثًا لِوَلَدِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 21928","","","كتاب البيوع والأقضية"
"21929","(۲۱۹۲۹) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : قُلْتُ لَہُ : إنَّ شُرَیْحًا کَانَ یَقْضِی فِی الْمُکَاتَبِ یَمُوتُ وَیَتْرُکُ مَالاً وَوَلَدًا ، یُؤَدَّی عَنْہُ لِمَوَالِیہِ مَا بَقِیَ مِنْ مُکَاتَبَتِہِ ، وَمَا بَقِیَ رَدَّہُ عَلَی وَلَدِہِ ؟ فَقَالَ : إنَّ شُرَیْحًا کَانَ یَقْضِی فِیہَا بِقَضَائِ عَبْدِ اللہِ۔","","Musannaf Ibn Abi Shaybah 21929","","","كتاب البيوع والأقضية"
"21930","(۲۱۹۳۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إِنْ فَضَلَ شَیْئٌ کَانَ لِمَوَالِیہِ حَتَّی تَتِمَّ مُکَاتَبَتُہُ ، وَإِنْ فَضَلَ شَیْئٌ بَعْدَ مُکَاتَبَتِہِ کَانَ لِوَرَثَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21930","","","كتاب البيوع والأقضية"
"21931","(۲۱۹۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21931","","","كتاب البيوع والأقضية"
"21932","(۲۱۹۳۲) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ وَزَیْدَ بْنَ ثَابِتٍ ، قَالاَ : إذَا مَاتَ الْمُکَاتَبُ وَلَہُ مَالٌ ، فَہُوَ لِمَوَالِیہِ وَلَیْسَ لِوَلَدِہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 21932","","","كتاب البيوع والأقضية"
"21933","(۲۱۹۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ عَبْدِ اللہِ : فِی مُکَاتَبٍ مَاتَ وَتَرَکَ مَالاً وَوَلَدًا أَحْرَارًا ، قَالَ : یُؤَدَّی مَا بَقِیَ مِنْ مُکَاتَبَتِہِ ، وَمَا بَقِیَ فَلِوَلَدِہِ۔","","Musannaf Ibn Abi Shaybah 21933","","","كتاب البيوع والأقضية"
"21934","(۲۱۹۳۴) حَدَّثَنَا شَرِیکٌ، عَنْ مُیَسَّر، عَنْ أَبِیہِ ، عَنْ جَدِّہِ : أَنَّ عَبْدَ اللہِ أَعْتَقَہُ فَقَالَ : أَمَا إنَّ مَالَکَ لِی ، وَلَکِنَّہُ لَک۔ (عبدالرزاق ۱۵۶۵۵)","Da'if","Musannaf Ibn Abi Shaybah 21934","","","كتاب البيوع والأقضية"
"21935","(۲۱۹۳۵) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ : أَنَّ أَنَسًا سَأَلَ غُلاَمًا لَہُ عَنْ مَالِہِ ؟ فَأَخْبَرَہُ ، فَقَالَ : أَنْتَ وَمَالُک لَکَ۔","Sahih","Musannaf Ibn Abi Shaybah 21935","","","كتاب البيوع والأقضية"
"21936","(۲۱۹۳۶) حَدَّثَنَا غُنْدَرُ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی مُلَیْکَۃَ : أَنَّ امْرَأَۃً مِنْ قَوْمِ عَائِشَۃَ أَعْتَقَتْ مَمْلُوکًا فَسَأَلْت عَائِشَۃَ ، فَقَالَتْ : إذَا أَعْتَقْتِیہِ وَلَمْ تَشْتَرِطِی مَالَہُ ، فَمَالُہُ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 21936","","","كتاب البيوع والأقضية"
"21937","(۲۱۹۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی العُمَیس ، عَنْ عِمْرَانَ بْنِ عُمَیْرٍ ، عَنْ أَبِیہِ : أنَّ عَبْدِ اللہِ أَعْتَقَ غُلاَمًا لَہُ فَقَالَ : أَمَا إنَّ الْمَالَ مَالِی ، وَلَکِنَّہُ لَک۔","Da'if","Musannaf Ibn Abi Shaybah 21937","","","كتاب البيوع والأقضية"
"21938","(۲۱۹۳۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ : أَنَّ أَبَا أَیُّوبَ دَعَا غُلاَمًا لَہُ فَسَأَلَہُ عَنْ مَالِہِ ؟ فَأَخْبَرَہُ فَقَالَ : أَنْتَ وَمَالُک لک۔","Sahih","Musannaf Ibn Abi Shaybah 21938","","","كتاب البيوع والأقضية"
"21939","(۲۱۹۳۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا أُعْتِقَ الْعَبْدُ تَبِعَہُ مَالُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21939","","","كتاب البيوع والأقضية"
"21940","(۲۱۹۴۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : الْمَالُ لِلْعَبْدِ إلاَّ أَنْ یَسْتَثْنِیَہُ السَّیِّدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21940","","","كتاب البيوع والأقضية"
"21941","(۲۱۹۴۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَش ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَعْتَقَ الرَّجُلُ غُلاَمَہُ تَبِعَہُ مَالُہُ۔","","Musannaf Ibn Abi Shaybah 21941","","","كتاب البيوع والأقضية"
"21942","(۲۱۹۴۲) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا أَعْتَقَ الرَّجُلُ الْعَبْدَ وَلَہُ مَالٌ فَمَالُ الْعَبْدِ لِلْعَبْدِ۔","","Musannaf Ibn Abi Shaybah 21942","","","كتاب البيوع والأقضية"
"21943","(۲۱۹۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : إذَا أُعْتِقَ الْعَبْدُ تَبِعَہُ مَالُہُ۔","","Musannaf Ibn Abi Shaybah 21943","","","كتاب البيوع والأقضية"
"21944","(۲۱۹۴۴) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ : فِی الَّذِی یَعْتِقُ الْعَبْدَ وَلَہُ مَالٌ ، قَالَ : أُحِبُّ أَنْ یُبَیِّنَ لَہُ ، إِنْ أَرَادَ أَنْ یُمْسِکَہُ أمْسَکَہُ ، وَإِنْ أَرَادَ أَنْ یَجْعَلَہُ مَعَہُ جَعَلَہُ۔","","Musannaf Ibn Abi Shaybah 21944","","","كتاب البيوع والأقضية"
"21945","(۲۱۹۴۵) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إذَا أَعْتَقَ الرَّجُلُ مَمْلُوکُہُ وَلَہُ مَالٌ فَمَالُہُ لِمَمْلُوکُہُ۔","","Musannaf Ibn Abi Shaybah 21945","","","كتاب البيوع والأقضية"
"21946","(۲۱۹۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : إذَا أَعْتَقَہُ فَالْمَالُ لِلسَّیِّدِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21946","","","كتاب البيوع والأقضية"
"21947","(۲۱۹۴۷) حَدَّثَنَا حَفْصٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ مُحَمَّدِ بْنِ عُبَیْدِ اللہِ أَبِی عَوْنٍ الثَّقَفِیِّ ، عَنْ عُمَرَ وَعَلِیٍّ ، قَالاَ : إذَا أَسْلَمَ وَلَہُ أَرْضٌ وَضَعْنَا عَنْہُ الْجِزْیَۃَ وَأَخَذْنَا مِنْہُ خَرَاجَہَا۔","","Musannaf Ibn Abi Shaybah 21947","","","كتاب البيوع والأقضية"
"21948","(۲۱۹۴۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ سَیَّارٍ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ : أَنَّ دِہْقَانًا أَسْلَمَ عَلَی عَہْدِ عَلِیٍّ فَقَالَ لَہُ : عَلِیٌّ : إِنْ أَقَمْت فِی أَرْضِکَ رَفَعْنَا الْجِزْیَۃَ عَنْ رَأْسِکَ وَأَخَذْنَاہَا مِنْ أَرْضِکَ ، وَإِنْ تَحَوَّلَتْ عَنْہَا فَنَحْنُ أَحَقُّ بِہَا۔","","Musannaf Ibn Abi Shaybah 21948","","","كتاب البيوع والأقضية"
"21949","(۲۱۹۴۹) حَدَّثَنَا ہُشَیْمٌ، عَنْ حُصَیْنٍ: أَنَّ رَجُلَیْنِ مِنْ أَہْلِ أُلیَّسَ أَسْلَمَا فِی عَہْدِ عُمَرَ، فَأَتَیَا عُمَرُ فَأَخْبَرَاہُ بِإِسْلاَمِہِمَا، فَکَتَبَ لَہُمَا إلَی عُثْمَانَ بْنِ حُنَیْفٍ أَنْ یَرْفَعَ الْجِزْیَۃَ ، عَنْ رُؤُوسِہِمَا ، وَأَنْ یَأْخُذَ الطِّسْقَ مِنْ أَرْضِیہِمَا۔","","Musannaf Ibn Abi Shaybah 21949","","","كتاب البيوع والأقضية"
"21950","(۲۱۹۵۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ : أَنَّ دِہْقَانَۃً مِنْ أَہْلِ نَہْرِ الْمَلِکِ أَسْلَمَتْ ، فَقَالَ : عُمَرُ : ادْفَعُوا إلَیْہَا أَرْضَہَا تُؤَدِّی عَنْہَا الْخَرَاجَ۔","Sahih","Musannaf Ibn Abi Shaybah 21950","","","كتاب البيوع والأقضية"
"21951","(۲۱۹۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ : أَنَّ دِہْقَانَۃً أَسْلَمَتْ مِنْ نَہْرِ الْمَلِکِ ، فَکَتَبَ عُمَرُ أَنْ خَیِّرُوہَا۔","Sahih","Musannaf Ibn Abi Shaybah 21951","","","كتاب البيوع والأقضية"
"21952","(۲۱۹۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ : أَنَّ الرُّفَیلَ دِہْقَانَ النَّہْرَیْنِ أَسْلَمَ ، فَفَرَضَ لَہُ عُمَرُ فِی أَلْفَیْنِ ، وَرَفَعَ عَنْ رَأْسِہِ الْجِزْیَۃَ ، وَدَفَعَ إلَیْہِ أَرْضَہُ یُؤَدِّی عَنْہَا الْخَرَاجَ۔","Da'if","Musannaf Ibn Abi Shaybah 21952","","","كتاب البيوع والأقضية"
"21953","(۲۱۹۵۳) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، قَالَ : سَأَلْتُ عُبَیْدَ اللہِ بْنَ عُمَرَ عَمَّنْ أَسْلَمَ مِنْ أَہْلِ السَّوَادِ فَقَالَ : مَنْ أَسْلَمَ مِنْ أَہْلِ السَّوَادِ مِمَّنْ لَہُ ذِمَّۃٌ ، فَلَہُ أَرْضُہُ وَمَالُہُ ، وَمَنْ أَسْلَمَ مِمَّنْ لاَ ذِمَّۃَ لَہُ ، وَإِنَّمَا أَخَذَہُ عَنْوَۃً فَأَرْضُہُ لِلْمُسْلِمِینَnقَالَ عُبَیْدُ اللہِ : قَرَأْت ہَذَا فِی کِتَابِ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ۔","","Musannaf Ibn Abi Shaybah 21953","","","كتاب البيوع والأقضية"
"21954","(۲۱۹۵۴) حَدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنٍ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَسْلَمَ الرَّجُلُ مِنْ أَہْلِ السَّوَادِ ، ثُمَّ أَقَامَ فِی أَرْضِہِ أُخِذَ مِنْہُ الْخَرَاجَ ، فَإِنْ خَرَجَ مِنْہَا لَمْ یُؤْخَذْ مِنْہُ الْخَرَاجُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21954","","","كتاب البيوع والأقضية"
"21955","(۲۱۹۵۵) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ مُکَاتَبًا لَہُ عَجَزَ فَرَدَّہُ مَمْلُوکًا وَأَمْسَکَ مَا أَخَذَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 21955","","","كتاب البيوع والأقضية"
"21956","(۲۱۹۵۶) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : لَہُم مَا أَخَذُوا مِنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 21956","","","كتاب البيوع والأقضية"
"21957","(۲۱۹۵۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ وَوَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، قَالَ : یَجْعَلُہُ فِی مِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 21957","","","كتاب البيوع والأقضية"
"21958","(۲۱۹۵۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُنْظَرُ مَا کَانَ أَعَانَہُ النَّاسُ فِی مُکَاتَبَتِہِ فَیَجْعَلُہُ فِی الرِّقَابِ ، وَمَا کَانَ مِنْ کَسْبِہِ وَمَالِہِ ، فَہُوَ لِمَوْلاَہُ۔","","Musannaf Ibn Abi Shaybah 21958","","","كتاب البيوع والأقضية"
"21959","(۲۱۹۵۹) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، عَن شُرَیْحٍ ، قَالَ : یَجْعَلُہُ فِی مِثْلِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21959","","","كتاب البيوع والأقضية"
"21960","(۲۱۹۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، قَالَ : ہُوَ لِمَوْلاَہُnوَقَالَ سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : یَجْعَلُہُ فِی الرِّقَابِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21960","","","كتاب البيوع والأقضية"
"21961","(۲۱۹۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی جَعْفَرٍ الفراء ، عَنْ جَعْفَرِ بْنِ أَبِی ثَرْوَانَ : أَنَّ عَلِیًّا حَثَّ النَّاسَ عَلَی ابْنِ النَّبَّاحِ ، فَجَمَعُوا لَہُ أَکْثَرَ مِنْ مُکَاتَبَتِہِ ، فَفَضَلَتْ فَضْلَۃٌ ، فَجَعَلَہَا عَلیَّ فِی الْمُکَاتِبِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 21961","","","كتاب البيوع والأقضية"
"21962","(۲۱۹۶۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : مُکَاتَبٌ سَأَلَ فِی رَقَبَۃٍ أَوْ رَقَبَتَیْنِ ، فَأُعْطِیَ عَطَائً ، فَلَمَّا کَثُرَ فِی عَیْنِ أَبِی مُوسَی مَا أُعْطِیَ ، أَمَرَ بِہِ وَبِمَا أُعْطِیَ فَأُدْخِلَ ، ثُمَّ نَظَرَ الَّذِی سَأَلَ فِیہِ فَأَعْطَاہُ إیَّاہُ وَأَخَذ الْفَضْلُ فَجَعَلَہُ فِی رَقَبَتِہِ ، أَوْ رِقَابٍ۔","","Musannaf Ibn Abi Shaybah 21962","","","كتاب البيوع والأقضية"
"21963","(۲۱۹۶۳) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا الرَّبِیعُ بْنُ صَبِیحٍ، عَنْ یَزِیدَ بْنِ أَبَانَ، عَنْ صُبَیْحِ بْنِ عَبْدِ اللہِ: أَنَّ عَبْدَ اللہِ بْنَ عَبَّاسٍ حَثَّ النَّاسَ عَلَی مُکَاتَبِہِ ، فَجَمَعُوا لَہُ فَأَدَّی مُکَاتَبَتَہُ ، وَبَقِیَتْ فَضْلَۃٌ فَجَعَلَہَا عَبْدُ اللہِ فِی الْمُکَاتِبِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 21963","","","كتاب البيوع والأقضية"
"21964","(۲۱۹۶۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : أَنَّہُ کَانَ لاَ یَری بَأْسَاً بِأَنَّ یُعَالِجَ الرَّجُلُ النَّخْلَ وَیَقُومُ عَلَیْہِ بِالثُّلُثِ وَالرُّبُعِ مَا لَمْ یُنْفِقْ ہُوَ مِنْہُ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 21964","","","كتاب البيوع والأقضية"
"21965","(۲۱۹۶۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ یَکْرَہُ ذَلِکَ إلاَّ بِأَجْرٍ مَعْلُومٍ۔","","Musannaf Ibn Abi Shaybah 21965","","","كتاب البيوع والأقضية"
"21966","(۲۱۹۶۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ الْفُضَیْلِ ، عَنْ سَالِمٍ ، قَالَ : فی ألنَّخْلُ أَنْ یُعْطَی مَنْ عَمِلَ فِیہِ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 21966","","","كتاب البيوع والأقضية"
"21967","(۲۱۹۶۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یَکْرَہُ کُلُّ شَیْئٍ یُعْمَلُ بِالثُّلُثِ وَالرُّبُعِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21967","","","كتاب البيوع والأقضية"
"21968","(۲۱۹۶۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُسْتَأْجَرَ الأَجِیرُ یَعْمَلُ فِی الأَرْضِ بِالثُّلُثِ وَالرُّبُعِ۔","","Musannaf Ibn Abi Shaybah 21968","","","كتاب البيوع والأقضية"
"21969","(۲۱۹۶۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، قَالَ : کَانَ یَکْرَہُ أَنْ یُسْتَأْجَرَ الأَجِیرُ فَیَقُولُ : لَکَ ثُلُثٌ أَوْ رُبُعٌ مِمَّا یُخْرِجُ أَرْضِی ہَذِہِ۔","","Musannaf Ibn Abi Shaybah 21969","","","كتاب البيوع والأقضية"
"21970","(۲۱۹۷۰) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ مُحَمَّدًا عَنِ الرَّجُلِ یَدْفَعُ إلَی النَّسَّاجِ الثَّوْبَ بِالثُّلُثِ وَدِرْہَمٍ ، أَوْ بِالرُّبُعِ ، أَوْ بِمَا تَرَاضَیَا عَلَیْہِ ؟ فَقَالَ : لاَ أَعْلَمُ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 21970","","","كتاب البيوع والأقضية"
"21971","(۲۱۹۷۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنِ الشَّعْبِیِّ وَالْحَکَمِ ، عَنْ إبْرَاہِیمَ : أَنَّہُم کَرِہوا أَنْ یَدْفَعَ الرَّجُلُ الثَّوْبَ إلَی النَّسَّاجِ بِالثُّلُثِ ، قَالَ : وَکَانَ عَطَائُ لاَ یَرَی بِذَلِکَ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 21971","","","كتاب البيوع والأقضية"
"21972","(۲۱۹۷۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ بَأْسَ أَنْ یَدْفَعَہُ إلَیْہِ بِالثُّلُثِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21972","","","كتاب البيوع والأقضية"
"21973","(۲۱۹۷۳) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ قَتَادَۃَ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَدْفَعَ الثَّوْبَ إلَی النَّسَّاجِ بِالثُّلُثِ وَالرُّبُعِ۔","","Musannaf Ibn Abi Shaybah 21973","","","كتاب البيوع والأقضية"
"21974","(۲۱۹۷۴) حَدَّثَنَا زَیْدُ بْنُ حُبَابِ ، عَنْ مَرْوَانَ بْنِ مُعَاوِیَۃَ ، قَالَ : سَأَلْتُ شَہْرَ بْنِ حَوْشَبٍ عَنِ الثَّوْبِ یَدْفَعُہُ بِالثُّلُثِ وَالرُّبُعِ إلَی الْحَائِکِ ؟ قَالَ : شَرْطٌ بِغَیْرٍ رأس۔","","Musannaf Ibn Abi Shaybah 21974","","","كتاب البيوع والأقضية"
"21975","(۲۱۹۷۵) حَدَّثَنَا زَیْدُ بْنُ حُبَابِ ، عَنْ مُبَارَکٍ ، عَنِ الْحَسَنِ : أَنَّہُ کَرِہَ أَنْ یُدْفَعَ الثَّوْبُ إلَی الْحَائِکِ بِالثُّلُثِ وَالرُّبُعِ۔","","Musannaf Ibn Abi Shaybah 21975","","","كتاب البيوع والأقضية"
"21976","(۲۱۹۷۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، قَالَ : سَأَلْتُ أَیُّوبَ وَیَعْلَی بْنَ حَکِیمٍ عَنِ الرَّجُلِ یَدْفَعُ الثَّوْبَ إلَی النَّسَّاجِ بِالثُّلُثِ وَالرُّبُعِ ؟ فَلَمْ یَرَیَا بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 21976","","","كتاب البيوع والأقضية"
"21977","(۲۱۹۷۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ زَیْدِ بْنِ أَسْلَمَ ، عْن أَبِیہِ ، قَالَ : ذَکَرُوا الرَّجُلَ یُضْطَرُّ إلَی الْمَیْتَۃِ ، وَإِلَی مَالِ الرَّجُلِ الْمُسْلِمِ ، فَقُلْتُ : یَأْکُلُ الْمَیْتَۃَ ، وَقَالَ عَبْدُ اللہِ بْنُ دِینَارٍ : یَأْکُلُ مَالَ الرَّجُلِ الْمُسْلِمِ ، فَقَالَ : سَعِیدُ بْنُ الْمُسَیَّبِ : أَصَبْت ، إنَّ الْمَیْتَۃَ تَحِلُّ لَہُ إذَا اُضْطُرَّ ، وَلاَ یَحِلُّ لَہُ مَالُ الْمُسْلِمِ۔","","Musannaf Ibn Abi Shaybah 21977","","","كتاب البيوع والأقضية"
"21978","(۲۱۹۷۸) حَدَّثَنَا شَرِیکٌ، عَنْ جَابِرٍ، عَنْ أَبِی جَعْفَرٍ، قَالَ: إذَا اُضْطُرَّ إلَی مَا حَرُمَ عَلَیْہِ، فَمَا حُرِّمَ عَلَیْہِ فَہُوَ لَہُ حَلاَلٌ۔","","Musannaf Ibn Abi Shaybah 21978","","","كتاب البيوع والأقضية"
"21979","(۲۱۹۷۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَنْ بَاعَ حُبْلَی أَوْ أَعْتَقَہَا وَاسْتَثْنَی مَا فِی بَطْنِہَا ، قَالَ لَہُ: ثُنْیَاہُ فِیمَا قَدَ اسْتَبَانَ خَلْقَہُ ، وَإِنْ لَمْ یَسْتَبِنْ خَلْقُہُ فَلاَ ثُنْیَا لَہُ۔","","Musannaf Ibn Abi Shaybah 21979","","","كتاب البيوع والأقضية"
"21980","(۲۱۹۸۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ یُجِیزُ ثُنْیَاہُ فِی الْبَیْعِ ، وَلاَ یُجِیزُہَا فِی الْعِتْقِ۔","","Musannaf Ibn Abi Shaybah 21980","","","كتاب البيوع والأقضية"
"21981","(۲۱۹۸۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنْ ہِشَامٍ، عَنْ مُحَمَّدٍ: فِی الرَّجُلِ یَعْتِقُ الأَمَۃَ وَیَسْتَثْنِی مَا فِی بَطْنِہَا، قَالَ لَہُ: ثُنْیَاہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21981","","","كتاب البيوع والأقضية"
"21982","(۲۱۹۸۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : ہُمَا حُرَّانِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21982","","","كتاب البيوع والأقضية"
"21983","(۲۱۹۸۳) حَدَّثَنَا یَحْیَی بْنُ یَمَانَ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ۔ وَعَنْ سُفْیَانَ ، عَنِ جَابِرٍ ، عَنِ الشَّعْبِیِّ ۔ وَعَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالُوا : لَہُ ثُنْیَاہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21983","","","كتاب البيوع والأقضية"
"21984","(۲۱۹۸۴) حَدَّثَنَا حَرَمِیُّ بْنُ عُمَارَۃَ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنِ الرَّجُلِ یَعْتِقُ الأَمَۃَ وَیَسْتَثْنِی مَا فِی بَطْنِہَا ، قَالاَ : لَہُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 21984","","","كتاب البيوع والأقضية"
"21985","(۲۱۹۸۵) حَدَّثَنَا قُرَّۃُ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ فَضَائٍ ، عَنْ أَبِیہِ ، عَنْ ابنِ عُمَرَ ، قَالَ : سَأَلْتُہ عَنِ الرَّجُلِ یَعْتِقُ الأَمَۃَ وَیَسْتَثْنِی مَا فِی بَطْنِہَا ، قَالَ لَہُ : ثُنْیَاہُ۔","Da'if","Musannaf Ibn Abi Shaybah 21985","","","كتاب البيوع والأقضية"
"21986","(۲۱۹۸۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ فِی رَجُلٍ اشْتَرَی عَبْدًا فَأَعْتَقَہُ ، ثُمَّ وَجَدَ بِہِ جُنُونًا ، قَالَ : إِنْ کَانَ الدَّائُ قَبْلَ الصَّفْقَۃِ رَدَّ الْبَائِعُ عَلَی الْمُشْتَرِی فَضْلَ مَا بَیْنَ الصِّحَّۃِ وَالدَّائِ ، وَیَجْعَلُ مَا أُخِذَ فِی مِثْلِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21986","","","كتاب البيوع والأقضية"
"21987","(۲۱۹۸۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : فِی رَجُلٍ اشْتَرَی عَبْدًا فَأَعْتَقَہُ ، ثُمَّ ظَہَرَ بِہِ دَائٌ کَانَ عِنْدَ الْبَائِعِ ، قَالَ : کَانَ یُوجِبُہُ عَلَیْہِ ، وَلاَ یَرُدُّ الْبَائِعُ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 21987","","","كتاب البيوع والأقضية"
"21988","(۲۱۹۸۸) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : کَانَ یَرَی أَنْ یُحَطَّ عَنْہُ بِقَدْرِ الْعَیْبِ إذَا وُجِدَ بِہَا دَائٌ بَعْدَ الْمَوْتِ۔","","Musannaf Ibn Abi Shaybah 21988","","","كتاب البيوع والأقضية"
"21989","(۲۱۹۸۹) حَدَّثَنَا عَبْدُ اللہِ بْنِ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ عُہْدَۃَ بَعْدَ الْمَوْتِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21989","","","كتاب البيوع والأقضية"
"21990","(۲۱۹۹۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ الْعُکْلِیِّ وَأَصْحَابِہِ ۔ وَعَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ ، قَالُوا : الْقَرْضُ حَالٌّ ، وَإِنْ کَانَ إلَی أَجَلٍ ، وَبِہِ یَأْخُذُ أَبُو بَکْرٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 21990","","","كتاب البيوع والأقضية"
"21991","(۲۱۹۹۱) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ وَعَامِرٍ : فِی الرَّجُلِ یَتَزَوَّجُ الأَمَۃَ فَتَلِدُ مِنْہُ ، ثُمَّ یَشْتَرِیہَا ، قَالاَ : یَبِیعُہَا مَا لَمْ تَلِدْ فِی مِلْکِہِ۔","","Musannaf Ibn Abi Shaybah 21991","","","كتاب البيوع والأقضية"
"21992","(۲۱۹۹۲) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : یَبِیعُہَا۔","","Musannaf Ibn Abi Shaybah 21992","","","كتاب البيوع والأقضية"
"21993","(۲۱۹۹۳) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : ہِیَ أُمُّ وَلَدٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 21993","","","كتاب البيوع والأقضية"
"21994","(۲۱۹۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، قَالَ : لاَ یَبِیعُہَا ، ہِیَ بِمَنْزِلَۃِ أُمِّ الوَلَدٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 21994","","","كتاب البيوع والأقضية"
"21995","(۲۱۹۹۵) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ مَعْمَرٍ ، عَنْ حَمَّادٍ : فِی رَجُلٍ دَفَعَ إلَی رَجُلٍ مَتَاعًا مُضَارَبَۃً ، فَقُوِّمَ الْمَتَاعُ أَلْفَ دِرْہَمٍ ، ثُمَّ بَاعَہُ بِتِسْعِمِئَۃٍ ، قَالَ : رَأْسُ الْمَالِ تِسْعُمِئَۃٍ۔","","Musannaf Ibn Abi Shaybah 21995","","","كتاب البيوع والأقضية"
"21996","(۲۱۹۹۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ قَالَ فِی رَجُلٍ دَفَعَ إلَی رَجُلٍ مَتَاعًا مُضَارَبَۃً وَقَوَّمَاہُ بَیْنَہُمَا قَالَ : رَأْسُ الْمَالِ مَا قُوِّمَ بِہِ الْمَتَاعُ : وَلَیْسَ قِیمَتُہَا بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 21996","","","كتاب البيوع والأقضية"
"21997","(۲۱۹۹۷) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ کَثِیرِ بْنِ نَبَاتَۃَ ، عَنِ الْحَکَمِ بْنِ أَبَانَ ، عَنْ طَاوُوسٍ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُقَوِّمَ الرَّجُلُ عَلَی الرَّجُلِ الْمَتَاعَ فَیَدْفَعُہُ إلَیْہِ مُضَارَبَۃً بِتِلْکَ الْقِیمَۃِ۔","","Musannaf Ibn Abi Shaybah 21997","","","كتاب البيوع والأقضية"
"21998","(۲۱۹۹۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّہُ کَرِہَ بَیْعَ دہ دوازدہ ، وَقَالَ : بَیْعُ الأَعَاجِمِ۔","Sahih","Musannaf Ibn Abi Shaybah 21998","","","كتاب البيوع والأقضية"
"21999","(۲۱۹۹۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ بُکَیْرِ بْنِ عَتِیقٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ : أَنَّہُ کَانَ یَکْرَہُ بَیْعَ دہ دیَازدہ ودہ دوازدہ ، قُلْتُ لَہُ : فَکَیْفَ أَصْنَعُ ؟ قَالَ : قُلْ : أَخَذَتْہُ بِکَذَا ، وَأَبِیعُکَہُ بِکَذَا وَکَذَا۔","","Musannaf Ibn Abi Shaybah 21999","","","كتاب البيوع والأقضية"
"22000","(۲۲۰۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عن عمار الدہنی ، عن ابن أبی نعم ، عن ابن عمر ، قَالَ : ہو رباً۔","Sahih","Musannaf Ibn Abi Shaybah 22000","","","كتاب البيوع والأقضية"
"22001","(۲۲۰۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ ہلال بن میمون ، قَالَ : سمعت سعید بن المسیب سئل عن بیع دہ دوازدہ ؟ قَالَ : لاَ بأس بہ۔","","Musannaf Ibn Abi Shaybah 22001","","","كتاب البيوع والأقضية"
"22002","(۲۲۰۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْقَعْقَاعِ بْنِ یَزِیدَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کُنَّا نَکْرَہُہُ ، ثُمَّ لَمْ نَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 22002","","","كتاب البيوع والأقضية"
"22003","(۲۲۰۰۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، عَنْ إبْرَاہِیمَ وَابْنِ سِیرِینَ ، أَنَّہُمَا قَالاَ : لاَ بَأْسَ بِبَیْعِ دہ دوازدہ۔","No Data Available","Musannaf Ibn Abi Shaybah 22003","","","كتاب البيوع والأقضية"
"22004","(۲۲۰۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عبد الأعلی ، عن سعید بن جبیر ، عن ابن عباس ، ق??الَ : ہو ربا۔","Sahih","Musannaf Ibn Abi Shaybah 22004","","","كتاب البيوع والأقضية"
"22005","(۲۲۰۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْجَعْدِ بْنِ ذَکْوَانَ ، قَالَ : شَہِدْت شُرَیْحًا أَجَازَ بَیْعَ دہ دوازدہ۔","","Musannaf Ibn Abi Shaybah 22005","","","كتاب البيوع والأقضية"
"22006","(۲۲۰۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الْقَاسِمِ ، عَنْ مَسْرُوقٍ : أَنَّہُ کَرِہَ بَیْعَ دہ دوازدہ ، قَالَ : یَقُولُ : اشْتَرَیْتہ بِکَذَا وَکَذَا ، وَأَبِیعہُ بِکَذَا وَکَذَا۔","","Musannaf Ibn Abi Shaybah 22006","","","كتاب البيوع والأقضية"
"22007","(۲۲۰۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَکْرَہُہُ ، وَقَالَ عِکْرِمَۃُ : ہُوَ حَرَامٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 22007","","","كتاب البيوع والأقضية"
"22008","(۲۲۰۰۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الْوَلِیدِ بْنِ جُمَیْعٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : ہُوَ رِبًا۔","Hasan","Musannaf Ibn Abi Shaybah 22008","","","كتاب البيوع والأقضية"
"22009","(۲۲۰۰۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا شَرِیکٌ ، عَنْ حُسَیْنِ بْنِ عَبْدِ اللہِ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَیُّمَا رَجُلٍ وَلَدَتْ مِنْہُ أَمَتُہُ فَہِیَ مُعْتَقَۃٌ عَنْ دُبُرٍ مِنْہُ۔n(ابن ماجہ ۲۵۱۵۔ دارمی ۲۵۷۴)","Da'if","Musannaf Ibn Abi Shaybah 22009","","","كتاب البيوع والأقضية"
"22010","(۲۲۰۱۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبِیدَۃَ ، عَنْ عَلِیٍّ ، قَالَ : اسْتَشَارَنِی عُمَرُ فِی بَیْعِ أُمَّہَاتِ الأَوْلاَدِ فَرَأَیْتُ أَنَا وَہُوَ إذَا وَلَدَتْ أُعْتِقَتْ فَقَضَی بِہِ عُمَرُ حَیَاتَہُ وَعُثْمَانُ مِنْ بَعْدِہِ ، فَلَمَّا وَلِیتُ الأَمْرَ مِنْ بَعْدِہِمَا رَأَیْت أَنْ أُرِقَّہَا۔ قَالَ الشَّعْبِیُّ : فَحَدَّثَنِی ابْنُ سِیرِینَ ، قَالَ : قُلْتُ لِعَبِیدَۃَ : مَا تَرَی ؟ قَالَ : رَأْیُ عُمَرَ وَعَلِیٍّ فِی الْجَمَاعَۃِ أَحَبُّ إلَیَّ مِنْ قَوْلِ عَلِیٍّ حِینَ أَدْرَکَ فی الاخْتِلاَفَ۔","Hasan","Musannaf Ibn Abi Shaybah 22010","","","كتاب البيوع والأقضية"
"22011","(۲۲۰۱۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : أَخْبَرَنَا نَافِعٌ : أَنَّ رَجُلَیْنِ مِنْ أَہْلِ الْعِرَاقِ سَأَلاَ ابْنَ عُمَرَ بِالأَبْوَائِ ، قَالاَ: تَرَکْنَا ابْنَ الزُّبَیْرِ یَبِیعُ أُمَّہَاتِ الأَوْلاَدِ بِمَکَّۃَ ، فَقَالَ عَبْدُ اللہِ: أَبُو حَفْصٍ عُمَرُ أَتَعْرِفَانِہِ؟ قَالَ : أَیُّمَا رَجُلٍ وَلَدَتْ مِنْہُ جَارِیَۃٌ فَہِیَ لَہُ مُتْعَۃٌ حَیَاتَہُ ، وَہِیَ حُرَّۃٌ مِنْ بَعْدِ مَوْتِہِ ، وَأَیُّمَا رَجُلٍ وَطِئَ جَارِیَۃً ، ثُمَّ أَضَاعَہَا فَالْوَلَدُ لَہُ وَالضَّیْعَۃُ عَلَیْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 22011","","","كتاب البيوع والأقضية"
"22012","(۲۲۰۱۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، قَالَ : مَاتَ رَجُلٌ مِنَ الْحَیِّ وَتَرَکَ أُمَّ وَلَدٍ فَقَالَ الْوَلِیدُ بْنُ عُقْبَۃَ یَبِیعُہَا ، فَأَتَیْنَا عَبْدَ اللہِ بْنَ مَسْعُودٍ فَسَأَلْنَاہُ فَقَالَ : إِنْ کُنْتُمْ لاَ بُدَّ فَاعِلِینَ فَاجْعَلُوہَا مِنْ نَصِیبِ ابْنِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 22012","","","كتاب البيوع والأقضية"
"22013","(۲۲۰۱۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سَلَمَۃَ بْنَ کُہَیْلٍ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، قَالَ : بَاعَ عُمَرُ بْنُ الْخَطَّابِ أُمَّہَاتِ الأَوْلاَدِ فِینَا ، ثُمَّ رَدَّہُنَّ فِینَا ، حَتَّی رَدَّہُنَّ حَبَالَی مِنْ تُسْتَرَ۔","Sahih","Musannaf Ibn Abi Shaybah 22013","","","كتاب البيوع والأقضية"
"22014","(۲۲۰۱۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَش ، عَنْ إبْرَاہِیمَ ، قَالَ : أَتَتْ عَلِیًّا أُمُّ وَلَدٍ فَقَالَ : إنَّ عُمَرَ قَدْ أَعْتَقَکُنَّ۔","","Musannaf Ibn Abi Shaybah 22014","","","كتاب البيوع والأقضية"
"22015","(۲۲۰۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، قَالَ : فَشَا فِی عَسْکَرِ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ أَنَّہُ یَرَی بَیْعَ أُمَّہَاتِ الأَوْلاَدِ ، فَدَخَلَ عَلَیْہِ رَجُلٌ فَذَاکَرَہُ فِی ذَلِکَ ، فَإِذَا عُمَرُ أَشَدُّ فِی عِتْقِہِنَّ مِنَ الرَّجُلِ الَّذِی ذَاکَرَہُ ذَلِکَ ، وَإِذَا عُمَرُ یَرَی أَنَّ ذَلِکَ رَأْیُ عُمَرَ بْنِ الْخَطَّابِ۔","","Musannaf Ibn Abi Shaybah 22015","","","كتاب البيوع والأقضية"
"22016","(۲۲۰۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، قَالَ : قیلَ لاِبْنِ عُمَرَ : إنَّ ابْنَ الزُّبَیْرَ یَبِیعُ أُمَّہَاتِ الأَوْلاَدِ ، فَقَالَ : ابْنُ عُمَرَ : لَکِنَّ عُمَرَ قَضَی أَنْ لاَ تُبَاعَ وَلاَ تُوہَبَ وَلاَ تُورَثَ ، یَسْتَمْتِعُ مِنْہَا صَاحِبُہَا حَیَاتَہُ، فَإِذَا مَاتَ فَہِیَ حُرَّۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 22016","","","كتاب البيوع والأقضية"
"22017","(۲۲۰۱۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَمْرِو بْنِ قَیْسٍ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، عَنْ عَبْدِ اللہِ : أَنَّہُ ذُکِرَ لَہُ بَیْعَ أُمَّہَاتِ الأَوْلاَدِ ، فَقَالَ : لَکِنَّ عُمَرَ الْقَوِیَّ الأَمِینَ أَعْتَقَہُنَّ۔","Sahih","Musannaf Ibn Abi Shaybah 22017","","","كتاب البيوع والأقضية"
"22018","(۲۲۰۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ عَامِرٍ ، قَالَ : قَضَی عُثْمَانُ فِی أُمِّ الْوَلَدِ أَنَّہَا حُرَّۃٌ إذَا وَلَدَتْ مِنْ سَیِّدِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 22018","","","كتاب البيوع والأقضية"
"22019","(۲۲۰۱۹) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ أَشْعَثَ، عَنْ سَالِمٍ، عَنْ عُرْوَۃَ، عَنِ ابْنِ عَبَّاسٍ: أَنَّہُ جَعَلَ أُمَّ الْوَلَدِ مِنْ نَصِیبِ وَلَدِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 22019","","","كتاب البيوع والأقضية"
"22020","(۲۲۰۲۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَتَتْ أُمُّ وَلَدٍ بِفَاحِشَۃٍ لاَ یُرِقُّہَا ذَلِکَ ، فَہِیَ عَلَی حَالِہَا ، إذَا مَاتَ سَیِّدُہَا عَتَقَتْ۔","","Musannaf Ibn Abi Shaybah 22020","","","كتاب البيوع والأقضية"
"22021","(۲۲۰۲۱) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ، قَالَ: کَانَ الْحَسَنُ وَإِبْرَاہِیمُ لاَ یَرَیَانِ أَنْ تُبَاعَ أُمُّ الْوَلَدِ ، وَإِنْ بَغَتْ، وَکَانَ ابْنُ سِیرِینَ یَرَی أَنْ تُبَاعَ۔","No Data Available","Musannaf Ibn Abi Shaybah 22021","","","كتاب البيوع والأقضية"
"22022","(۲۲۰۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبَانَ بْنِ صَمْعَۃَ ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ الْمُزَنِیِّ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ فِی أُمِّ الوَلَدِ : ہِیَ حُرَّۃٌ ، وَإِنْ بَغَتْ۔","No Data Available","Musannaf Ibn Abi Shaybah 22022","","","كتاب البيوع والأقضية"
"22023","(۲۲۰۲۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی حَصِینٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : أُمُّ الوَلَدٍ لاَ یُرِقُّہَا الْحَدَثُ۔","","Musannaf Ibn Abi Shaybah 22023","","","كتاب البيوع والأقضية"
"22024","(۲۲۰۲۴) حَدَّثَنَا وَکِیعٌ، عَنْ أَبِی ہِلاَلٍ، عَنْ قَتَادَۃَ، عَنْ عُمَرَ بْنِ عَبْدِالْعَزِیزِ ، قَالَ: لاَ تُبَاعُ أُمُّ الْوَلَدِ ، وَإِنْ فَجَرَتْ۔","No Data Available","Musannaf Ibn Abi Shaybah 22024","","","كتاب البيوع والأقضية"
"22025","(۲۲۰۲۵) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا جَرِیرُ بنُ حَازِمٍ ، قَالَ : سَأَلْتُ سَالِمَ بْنَ عَبْدِ اللہِ أَوْ سَأَلَہُ رَجُلٌ ، قَالَ: أُمُّ الْوَلَدِ إِذَا فَجَرَتْ أَبِیعُہَا ؟ قَالَ : لاَ ، فُجُورُہَا عَلَی نَفْسِہَا ، وَہِیَ امْرَأَۃٌ حُرَّۃٌ۔","","Musannaf Ibn Abi Shaybah 22025","","","كتاب البيوع والأقضية"
"22026","(۲۲۰۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ إبْرَاہِیمَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ مَالِکٍ بْن عَامِرٍ الْہَمْدَانِیِّ ، قَالَ : قَالَ عُمَرُ فِی أُمِّ الْوَلَدِ : إِنْ ہِیَ أَحْصَنَتْ وَأَسْلَمَتْ وعفت عَتَقَتْ ، وَإِنْ ہِیَ فَجَرَتْ وَکَفَرَتْ وَزَنَتْ رُقَّتْ۔","","Musannaf Ibn Abi Shaybah 22026","","","كتاب البيوع والأقضية"
"22027","(۲۲۰۲۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ دَسَّ إلَی رَجُلٍ دَرَاہِمَ لِیَشْتَرِیَہُ وَیُعْتِقَہُ ؟ قَالَ : إِنْ ظَہَرَ مَوْلاَہُ عَلَیْہِ قَبْلَ أَنْ یُعْتِقَہُ فَلَہُ مَا أُخِذَ مِنْ ثَمَنِہِ ، وَیَأْخُذُ عَبْدَہُ ، وَإِنْ ظَہَرَ عَلَیْہِ بَعْدَ مَا أَعْتَقَہُ الَّذِی أَخَذَہُ، أَخَذَ مِنَ الَّذِی اشْتَرَاہُ سِوَی مَا قَدْ أَخَذَ فَأُعْتِقَ۔","","Musannaf Ibn Abi Shaybah 22027","","","كتاب البيوع والأقضية"
"22028","(۲۲۰۲۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَأْخُذُ ثَمَنہُ مَرَّۃً أُخْرَی ، وَیَصِیرُ وَلاَؤُہُ لِلَّذِی أَعْتَقَہُ۔","","Musannaf Ibn Abi Shaybah 22028","","","كتاب البيوع والأقضية"
"22029","(۲۲۰۲۹) حَدَّثَنَا جَرِیرٌ ، عَنْ أَشْعَث ، عَنِ الْحَسَنِ ، قَالَ : لاَ شِراء لَہُ ، وَلاَ عِتْقَ لَہُ ، وَمَنْ فَعَلَ ذَلِکَ فَہُوَ فَاسِقٌ۔","","Musannaf Ibn Abi Shaybah 22029","","","كتاب البيوع والأقضية"
"22030","(۲۲۰۳۰) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : سُئِلَ عَنْ رَجُلٍ دَسَّ إلَی رَجُلٍ مَالاً فَاشْتَرَاہُ فَأَعْتَقَہُ ، قَالَ الشَّعْبِیُّ : لَوْ أَخَذْتہ لَعَاقَبْتہ عُقُوبَۃً شَدِیدَۃً۔","","Musannaf Ibn Abi Shaybah 22030","","","كتاب البيوع والأقضية"
"22031","(۲۲۰۳۱) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَکَمِ : فِی عَبْدٍ أَتَی رَجُلاً فَأَعْطَاہُ مَالاً ، وَقَالَ : اشْتَرنِی ، فَاشْتَرَاہُ فَأَعْتَقَہُ ، ثُمَّ اطُّلِعَ عَلَی ذَلِکَ ، قَالَ : الْبَیْعُ جَائِزٌ ، وَیُؤْخَذُ الثَّمَنُ الَّذِی اشْتُری بِہِ الْعَبْدَ۔","","Musannaf Ibn Abi Shaybah 22031","","","كتاب البيوع والأقضية"
"22032","(۲۲۰۳۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ وَسَالِمٍ وَالْقَاسِمِ وَعَطَائٍ : فِی عَبْدٍ أَعْطَی رَجُلاً مَالاً فَاشْتَرَاہُ فَأَعْتَقَہُ ، قَالُوا : لاَ یَجُوزُ۔","","Musannaf Ibn Abi Shaybah 22032","","","كتاب البيوع والأقضية"
"22033","(۲۲۰۳۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِی بَکْرٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ یَجُوزُ ، وَیُعَاقَبُ مَنْ فَعَلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 22033","","","كتاب البيوع والأقضية"
"22034","(۲۲۰۳۴) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ وَابْنِ سِیرِینَ، قَالاَ: لاَ یَجُوزُ ، وَمَنْ فَعَلَ ذَلِکَ ، فَہُوَ فَاسِقٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 22034","","","كتاب البيوع والأقضية"
"22035","(۲۲۰۳۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : بَلَغَ عُمَرَ بْنُ الْخَطَّابِ ، أَنَّ فُلاَنًا یَبِیعُ الْخَمْرَ فَقَالَ : مَا لَہُ قَاتَلَہُ اللَّہُ ، أَلَمْ یَعْلَمْ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لَعَنَ اللَّہُ الْیَہُودَ ، حُرِّمَتْ عَلَیْہِمُ الشُّحُومُ فَجَمَلُوہَا ، فَبَاعُوہَا ، وَأَکَلُوا أَثْمَانَہَا۔ (بخاری ۲۲۲۳۔ مسلم ۱۲۰۷)","Sahih","Musannaf Ibn Abi Shaybah 22035","","","كتاب البيوع والأقضية"
"22036","(۲۲۰۳۶) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ مُجَالِدٍ ، عَنْ أَبِی الْوَدَّاکِ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : کَانَ عِنْدَنَا خَمْرٌ لِیَتِیمٍ لَنَا ، فَلَمَّا نَزَلَتِ الآیَۃُ الَّتِی فِی الْمَائِدَۃِ سَأَلْنَا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : أَہْرِیقُوہُ۔","Da'if","Musannaf Ibn Abi Shaybah 22036","","","كتاب البيوع والأقضية"
"22037","(۲۲۰۳۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، قَالَتْ: لَمَّا نَزَلَتْ آیَۃُ الرِّبَا، قَامَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی الْمِنْبَرِ فَتَلاَہُنَّ عَلَی النَّاسِ، ثُمَّ حَرَّمَ التِّجَارَۃَ فِی الْخَمْرِ۔ (بخاری ۲۰۸۴۔ مسلم ۶۹)","Sahih","Musannaf Ibn Abi Shaybah 22037","","","كتاب البيوع والأقضية"
"22038","(۲۲۰۳۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَش ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، بِنَحْوِہِ۔ (مسلم ۱۲۰۶۔ احمد ۶/۴۶)","Sahih","Musannaf Ibn Abi Shaybah 22038","","","كتاب البيوع والأقضية"
"22039","(۲۲۰۳۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، وَوَکِیعٌ ، عَنْ طُعْمَۃَ بْنِ عَمْرٍو ، عَنْ عُمَرَ بْنِ بَیَانٍ التَّغْلِبِیِّ ، عَنْ عُرْوَۃَ بْنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، عَنْ أَبِیہِ ، قَالَ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ بَاعَ الْخَمْرَ فَلْیُشَقِّصِ الْخَنَازِیرَ۔n(احمد ۴/۲۵۳۔ دارمی ۲۱۰۲)","Da'if","Musannaf Ibn Abi Shaybah 22039","","","كتاب البيوع والأقضية"
"22040","(۲۲۰۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مُطِیعِ بْنِ عَبْدِ اللہِ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یُحَدِّثُ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ عُمَرُ : لَعَنَ اللَّہُ فُلاَنًا فَإِنَّہُ أَوَّلُ مَنْ أَذِنَ فِی بَیْعِ الْخَمْرِ ، وَإِنَّ التِّجَارَۃَ لاَ تَصْلُحُ فِیمَا لاَ یَحِلُّ أَکْلُہُ وَشُرْبُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 22040","","","كتاب البيوع والأقضية"
"22041","(۲۲۰۴۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، قَالَ : أَخْبَرَنَا أَبُو حَیَّانَ ، عَنْ أَبِی الْفُرَاتِ ، عَنْ أَبِی دَاوُدَ ، قَالَ : کُنْتُ تَحْتَ مِنْبَرِ حُذَیْفَۃَ وَہُوَ بِالْمَدَائِنِ ، فَحَمِدَ اللَّہَ وَأَثْنَی عَلَیْہِ ، ثُمَّ قَالَ : أَمَّا بَعْدُ ، أَلاَ إنَّ بَائِعَ الْخَمْرِ وَشَارِبَہَا فِی الإِثْمِ سَوَائٌ ، أَلاَ وَمُقْتَنِی الْخَنَازِیرِ وَآکِلُہَا فِی الإثْمِ سَوَائٌ۔","Da'if","Musannaf Ibn Abi Shaybah 22041","","","كتاب البيوع والأقضية"
"22042","(۲۲۰۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الْحَارِثِ بْنِ شبیلٍ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، قَالَ : بَلَغَ عُمَرَ بْنَ الْخَطَّابِ أَنَّ رَجُلاً أَثْرَی مِنْ بَیْعِ الْخَمْرِ ، فَقَالَ : اکْسِرُوا کُلَّ آنِیَۃٍ لَہُ ، وَسَیِّرُوا کُلَّ مَاشِیَۃٍ لَہُ۔","","Musannaf Ibn Abi Shaybah 22042","","","كتاب البيوع والأقضية"
"22043","(۲۲۰۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا مِسْعَرٌ ، عَنْ وَبَرَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : سَمِعْتُ ابْنُ عُمَرَ یَقُولُ : لاَ یَصْلُحُ بَیْعُ الْخَمْرِ ، وَلاَ شُرْبُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 22043","","","كتاب البيوع والأقضية"
"22044","(۲۲۰۴۴) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حُصَیْنٍ ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ ، قَالَ : لَمَّا حُرِّمَتِ الْخَمْرُ أَتَوْا إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالُوا : یَا رَسُولَ اللہِ ، أَنَبِیعُہَا فَنَنْتَفِعُ بِأَثْمَانِہَا ، قَالَ : أَہْرِیقُوہَا۔","","Musannaf Ibn Abi Shaybah 22044","","","كتاب البيوع والأقضية"
