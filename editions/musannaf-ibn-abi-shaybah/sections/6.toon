"5620","(۵۶۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : لاَ بَأْسَ بِالشُّرْبِ وَالإِمَامُ یَخْطُبُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5620","","","كتاب الجمعة"
"5621","(۵۶۲۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ عَوْنٍ ، عَنْ أَسْمَائَ ، قَالَتْ : مَنْ قَرَأَ : {قُلْ ہُوَ اللَّہُ أَحَدٌ} وَالْمُعَوِّذَتَیْنِ یَوْمَ الْجُمُعَۃِ سَبْعَ مَرَّاتٍ فِی مَجْلِسِہِ ، حُفِظَ إِلَی مِثْلِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5621","","","كتاب الجمعة"
"5622","(۵۶۲۲) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا عَبْدُ الْوَاحِدِ ، قَالَ : حَدَّثَنَا یُونُسُ ، قَالَ : کَانَ الْحَسَنُ یُحَصِّبُ الْمَسَاکِینَ یَوْمَ الْجُمُعَۃِ وَالإِمَامُ یَخْطُبُ ، یَقُولُ لَہُمْ : اُقْعُدُوا ۔ قَالَ : وَکَانَ عِکْرِمَۃُ لاَ یَرَی لَہُمْ جُمُعَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 5622","","","كتاب الجمعة"
"5623","(۵۶۲۳) حَدَّثَنَا جَرِیرٌ ، عَنْ سنان بْنِ حَبِیبٍ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : فَاتَتْنِی الْجُمُعَۃُ ؟ قَالَ : أَکْثِرْ مِنَ السُّجُودِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5623","","","كتاب الجمعة"
"5624","(۵۶۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ رَجُلٍ ، عَنِ ابْنِ سِیرِینَ ؛ فِی أَہْلِ السُّجُونِ ، قَالَ: تَجَمَّعُوا لِلصَّلاَۃِ یَوْمَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5624","","","كتاب الجمعة"
"5625","(۵۶۲۵) حَدَّثَنَا شَیْخٌ لَنَا ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لَیْسَ عَلَی أَہْلِ السُّجُونِ جُمُعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5625","","","كتاب الجمعة"
"5626","(۵۶۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ إِبْرَاہِیمَ ؛ سُئِلَ الْحَسَنُ عَنْ رَجُلٍ أَحْدَثَ یَوْمَ الْجُمُعَۃِ ، فَذَہَبَ لِیَتَوَضَّأَ ، فَجَائَ وَقَدْ صَلَّی الإِمَام ؟ قَالَ : یُصَلِّی أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5626","","","كتاب الجمعة"
"5627","(۵۶۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَأَلْتُ سُفْیَانَ عَنْ رَجُلٍ افْتَتَحَ مَعَ الإِمَامِ الصَّلاَۃَ یَوْمَ الْجُمُعَۃِ ، فَذَہَبَ لِیَتَوَضَّأَ ، فَجَائَ وَقَدْ صَلَّی الإِمَامُ ؟ قَالَ : یُصَلِّی رَکْعَتَیْنِ مَا لَمْ یَتَکَلَّمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 5627","","","كتاب الجمعة"
"5628","(۵۶۲۸) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ حَفْصِ بْنِ عُبَیْدِ اللہِ بْنِ أَنَسٍ ، عَنْ أَنَسٍ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُفْطِرُ یَوْمَ الْفِطْرِ عَلَی تَمَرَاتٍ ، ثُمَّ یَغْدُو۔ (ترمذی ۵۴۳۔ ابن ماجہ ۱۷۵۴)","No Data Available","Musannaf Ibn Abi Shaybah 5628","","","كتاب الجمعة"
"5629","(۵۶۲۹) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنِ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : اِطْعَمْ یَوْمَ الْفِطْرِ قَبْلَ أَنْ تَخْرُجَ إِلَی الْمُصَلَّی۔","Da'if","Musannaf Ibn Abi Shaybah 5629","","","كتاب الجمعة"
"5630","(۵۶۳۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إِنَّ مِنَ السُّنَّۃِ أَنْ تُخْرِجَ صَدَقَۃَ الْفِطْرِ قَبْلَ الصَّلاَۃ ، وَلاَ تَخْرُجُ حَتَّی تَطْعَمَ۔ (طبرانی ۱۱۲۹۶۔ بزار ۶۵۱)","No Data Available","Musannaf Ibn Abi Shaybah 5630","","","كتاب الجمعة"
"5631","(۵۶۳۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، قَالَ : غَدَوْتُ مَعَ مُعَاوِیَۃَ بْنِ سُوَیْد بْنِ مُقَرِّنٍ یَوْمَ فِطْرٍ ، فَقُلْت لَہُ : یَا أَبَا سُوَیْد ، ہَلْ طَعِمْتَ شَیْئًا قَبْلَ أَنْ تَغْدُوَ ؟ قَالَ : لَعِقْتُ لَعْقَۃً مِنْ عَسَلٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5631","","","كتاب الجمعة"
"5632","(۵۶۳۲) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ ابْنِ مَعْقِلٍ ؛ أَنَّہُ لَعِقَ لَعْقَۃً مِنْ عَسَلٍ ، ثُمَّ خَرَجَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5632","","","كتاب الجمعة"
"5633","(۵۶۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : اِطْعَمْ یَوْمَ الْفِطْرِ قَبْلَ أَنْ تَخْرُجَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5633","","","كتاب الجمعة"
"5634","(۵۶۳۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یَحْیَی بْنِ أَبِی إِسْحَاقَ ، قَالَ : أَتَیْتُ صَفْوَانَ بْنَ مُحْرِزٍ یَوْمَ فِطْرٍ ، فَقَعَدْت بِبَابِہِ حَتَّی خَرَجَ عَلَیَّ ، فَقَالَ لِی کَالْمُعْتَذِرِ : إِنَّہُ کَانَ یُؤْمَرُ فِی ہَذَا الْیَوْمِ أَنْ یُصِیبَ الرَّجُلُ مِنْ غِذَائِہِ قَبْلَ أَنْ یَغْدُوَ ، وَإِنِّی أَصَبْتُ شَیْئًا ، فَذَاکَ الَّذِی حَبَسَنِی ، وَأَمَّا الأَخَرُ فَإِنَّہُ یُؤَخِّرُ غِذَائَہُ حَتَّی یَرْجِعَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5634","","","كتاب الجمعة"
"5635","(۵۶۳۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ ابْنُ سِیرِینَ یُؤْتَی فِی الْعِیدَیْنِ بِفَالُوذَجٍ ، فَکَانَ یَأْکُلُ مِنْہُ قَبْلَ أَنْ یَغْدُوَ ۔ وَقَالَ : ابْنُ عَوْنٍ أَنَّہُ یُمْسِکُ الْبَوْلَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5635","","","كتاب الجمعة"
"5636","(۵۶۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ؛ أَنَّہُ مَرَّ عَلَی بَقَّالٍ یَوْمَ عِیدٍ ، فَأَخَذَ مِنْہُ قَسْبَۃً فَأَکَلَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5636","","","كتاب الجمعة"
"5637","(۵۶۳۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : حَدَّثَنَا الْمُغِیرَۃُ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِنَّ مِنَ السُّنَّۃِ أَنْ تَطْعَمَ یَوْمَ الْفِطْرِ قَبْلَ أَنْ تَغْدُوَ، وَتُؤَخِّرَ الطَّعَامَ یَوْمَ النَّحْرِ حَتَّی تَرْجِعَ۔","","Musannaf Ibn Abi Shaybah 5637","","","كتاب الجمعة"
"5638","(۵۶۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ إِبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : کَانَ الأَسْوَدُ یَأْمُرنَا أَنْ نَطْعَمَ قَبْلَ أَنْ نَغْدُوَ یَوْمَ الْفِطْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5638","","","كتاب الجمعة"
"5639","(۵۶۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مَسَرَّۃَ بْنِ مَعْبَدٍ ، عَنْ إِبْرَاہِیمَ بْنِ أَبِی عَبْلَۃَ ، عَنْ أُمِّ الدَّرْدَائِ ، قَالَتْ : کُلْ قَبْلَ أَنْ تَغْدُوَ یَوْمَ الْفِطْرِ ، وَلَوْ تَمْرَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 5639","","","كتاب الجمعة"
"5640","(۵۶۴۰) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ یُوسُفَ ، عَنِ السَّائِبِ بْنِ یَزِیدَ ، قَالَ : مَضَتِ السُّنَّۃُ أَنْ تَأْکُلَ قَبْلَ أَنْ تَغْدُوَ یَوْمَ الْفِطْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 5640","","","كتاب الجمعة"
"5641","(۵۶۴۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنِ الْمِنْہَالِ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إِذَا خَرَجْتَ یَوْمَ الْعِیدِ ، یَعْنِی الْفِطْرَ ، فَکُلْ وَلَوْ تَمْرَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 5641","","","كتاب الجمعة"
"5642","(۵۶۴۲) حَدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ ، عَنِ الزُّبَیْرِ بْنِ عَبْدِ اللہِ بْنِ رُہَیْمَۃَ ، قَالَ : سَمِعْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَوْمَ الْفِطْرِ یَخْطُبُ ، فَقَالَ : إِنَّ ہَذَا یَوْمٌ قَدْ کَانَ یُبْتَغَی فِیہِ بَعْضُ الطَّعَامِ وَبَعْضُ الشَّرَابِ ، فَبَعْضُ الطَّعَامِ وَبَعْضُ الشَّرَابِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5642","","","كتاب الجمعة"
"5643","(۵۶۴۳) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، أَنَّہُ قَالَ : اِطْعَمْ یَوْمَ الْفِطْرِ قَبْلَ أَنْ تَخْرُجَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5643","","","كتاب الجمعة"
"5644","(۵۶۴۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : بَلَغَہُ أَنْ تَمِیمَ بْنَ سَلَمَۃَ خَرَجَ یَوْمَ الْفِطْرِ وَمَعَہُ صَاحِبٌ لَہُ ، فَقَالَ لِصَاحِبِہِ : ہَلْ طَعِمْتَ شَیْئًا ؟ قَالَ : لاَ ، فَمَشَی تَمِیمٌ إِلَی بَقَّالٍ فَسَأَلَہُ تَمْرَۃً أَنْ یُعْطِیَہُ ، أَوْ غَیْرَ ذَلِکَ فَفَعَلَ ، فَأَعْطَاہُ صَاحِبَہُ فَأَکَلَہُ ۔ فَقَالَ إِبْرَاہِیمُ : مَمْشَاہُ إِلَی رَجُلٍ یَسْأَلُہُ ، أَشَدُّ عَلَیْہِ مِنْ تَرْکِہِ الطَّعَامَ لَوْ تَرَکَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5644","","","كتاب الجمعة"
"5645","(۵۶۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : أَصَبْتَ شَیْئًا قَبْلَ أَنْ تَغْدُوَ ؟۔","No Data Available","Musannaf Ibn Abi Shaybah 5645","","","كتاب الجمعة"
"5646","(۵۶۴۶) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ ابْنِ إِسْحَاقَ ، عَنْ رَجُلٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ کَانَ یَأْمُرُ بِالأَکْلِ یَوْمَ الْفِطْرِ قَبْلَ أَنْ یَأْتِیَ الْمُصَلَّی۔","Sahih","Musannaf Ibn Abi Shaybah 5646","","","كتاب الجمعة"
"5647","(۵۶۴۷) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : أَخْبَرَنِی مَالِکٌ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : کَانُوا یُؤْمَرُونَ أَنْ یَأْکُلُوا قَبْلَ أَنْ یَغْدُوا یَوْمَ الْفِطْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5647","","","كتاب الجمعة"
"5648","(۵۶۴۸) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ الْمَلِکِ بْنِ وَاقِدٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عَمْرٍو ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّ??َ یَأْکُلُ یَوْمَ الْفِطْرِ قَبْلَ أَنْ یَخْرُجَ إِلَی الْمُصَلَّی۔ (احمد ۳/۲۸۔ عبدالرزاق ۵۷۳۵)","Da'if","Musannaf Ibn Abi Shaybah 5648","","","كتاب الجمعة"
"5649","(۵۶۴۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَخْرُجُ یَوْمَ الْعِیدِ إِلَی الْمُصَلَّی ، وَلاَ یَطْعَمُ شَیْئًا۔","Sahih","Musannaf Ibn Abi Shaybah 5649","","","كتاب الجمعة"
"5650","(۵۶۵۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِنْ طَعِمَ فَحَسَنٌ ، وَإِنْ لَمْ یَطْعَمْ فَلاَ بَأْسَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5650","","","كتاب الجمعة"
"5651","(۵۶۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : کَتَبَ إِلَیْنَا عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : مَنِ اسْتَطَاعَ مِنْکُمْ أَنْ یَأْتِیَ الْعِیدَ مَاشِیًا فَلْیَفْعَلْ۔","No Data Available","Musannaf Ibn Abi Shaybah 5651","","","كتاب الجمعة"
"5652","(۵۶۵۲) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : مِنَ السُّنَّۃِ أَنْ تَأْتِیَ الْعِیدَ مَاشِیًا۔ (ترمذی ۵۳۰۔ ابن ماجہ ۱۲۹۶)","Da'if","Musannaf Ibn Abi Shaybah 5652","","","كتاب الجمعة"
"5653","(۵۶۵۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ مِسْعَرٍ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، قَالَ : خَرَجَ عُمَرُ بْنُ الْخَطَّابِ فِی یَوْمِ فِطْرٍ ، أَوْ فِی یَوْمِ أَضْحَی ، خَرَجَ فِی ثَوْبِ قُطْنٍ مُتَلَبِّبًا بِہِ ، یَمْشِی۔","Hasan","Musannaf Ibn Abi Shaybah 5653","","","كتاب الجمعة"
"5654","(۵۶۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ الْمُہَاجِرِ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَرِہَ الرُّکُوبَ إِلَی الْعِیدَیْنِ وَالْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5654","","","كتاب الجمعة"
"5655","(۵۶۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ أَبِی حَفْصَۃَ ، قَالَ : رَأَیْتُ الْحَسَنَ یَأْتِی الْعِیدَ رَاکِبًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5655","","","كتاب الجمعة"
"5656","(۵۶۵۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ یُصَلِّی الصُّبْحَ فِی مَسْجِدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ یَغْدُو کَمَا ہُوَ إِلَی الْمُصَلَّی۔","Sahih","Musannaf Ibn Abi Shaybah 5656","","","كتاب الجمعة"
"5657","(۵۶۵۷) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ؛ أَنَّہُ کَانَ یَنْصَرِفُ مَعَ سَعِیدِ بْنِ الْمُسَیَّبِ مِنَ الصُّبْحِ حِینَ یُسَلِّمُ الإِمَامُ فِی یَوْمِ عِیدٍ ، حَتَّی یَأْتِیَ الْمُصَلَّی عِنْدَ دَارِ کَثِیرِ بْنِ الصَّلْتِ ، فَیَجْلِسُ عِنْدَ الْمِصْرَاعَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5657","","","كتاب الجمعة"
"5658","(۵۶۵۸) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : صَلَّیْتُ الْفَجْرَ فِی ہَذَا الْمَسْجِدِ فِی یَوْمِ فِطْرٍ ، فَإِذَا أَبُو عَبْدِ الرَّحْمَنِ ، وَعَبْدُ اللہِ بْنُ مَعْقِلٍ ، فَلَمَّا قَضَیَا الصَّلاَۃَ خَرَجَا ، وَخَرَجْتُ مَعَہُمَا إِلَی الْجَبَّانَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5658","","","كتاب الجمعة"
"5659","(۵۶۵۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ عُبَیْدٍ الْمُکَتَّبِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یُصَلُّونَ الْفَجْرَ وَعَلَیْہِمْ ثِیَابُہُمْ ، یَعْنِی یَوْمَ الْعِیدِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5659","","","كتاب الجمعة"
"5660","(۵۶۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : لِیَکُنْ غَدْوُک یَوْمَ الْفِطْرِ مِنْ مَسْجِدِکَ إِلَی مُصَلاَّک۔","No Data Available","Musannaf Ibn Abi Shaybah 5660","","","كتاب الجمعة"
"5661","(۵۶۶۱) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : کَانَ عُرْوَۃُ لاَ یَأْتِی الْعِیدَ حَتَّی تَسْتَقِلَّ الشَّمْسُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5661","","","كتاب الجمعة"
"5662","(۵۶۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ مُحَمَّدِ بْنِ عَلِیٍّ ، وَعَامِرٍ ، وَعَطَائٍ ، قَالُوا : لاَ تَخْرُجُ یَوْمَ الْعِیدِ حَتَّی تَطْلُعَ الشَّمْسُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5662","","","كتاب الجمعة"
"5663","(۵۶۶۳) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ عِیسَی بْنِ سَہْلِ بْنِ رَافِعِ بْنِ خَدِیجٍ ؛ أَنَّہُ رَأَی جَدَّہُ رَافِعَ بْنَ خَدِیجٍ وَبَنِیہِ یَجْلِسُونَ فِی الْمَسْجِدِ ، حَتَّی إِذَا طَلَعَتِ الشَّمْسُ صَلَّوْا رَکْعَتَیْنِ ، ثُمَّ یَذْہَبُونَ إِلَی الْمُصَلَّی ، وَذَلِکَ فِی الْفِطْرِ وَالأَضْحَی۔","Hasan","Musannaf Ibn Abi Shaybah 5663","","","كتاب الجمعة"
"5664","(۵۶۶۴) حَدَّثَنَا شَرِیکٌ ، عَنْ مَنْصُورٍ ، قَالَ : غَدَوْت إِلَی إِبْرَاہِیمَ یَوْمَ عِیدٍ ، فَوَجَدْتُہُ قَدْ صَلَّی وَعَلَیْہِ ثِیَابُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5664","","","كتاب الجمعة"
"5665","(۵۶۶۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَغْدُو یَوْمَ الْعِیدِ، وَیُکَبِّرُ ، وَیَرْفَعُ صَوْتَہُ حَتَّی یَبْلُغَ الإِمَامُ۔","Hasan","Musannaf Ibn Abi Shaybah 5665","","","كتاب الجمعة"
"5666","(۵۶۶۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ یَحْیَی بْنِ عَبْدِ اللہِ بْنِ أَبِی قَتَادَۃَ ، قَالَ : أُرَاہُ عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ؛ أَنَّ أَبَا قَتَادَۃَ کَانَ یُکَبِّرُ یَوْمَ الْعِیدِ وَیَذْکُرُ اللَّہَ۔","Da'if","Musannaf Ibn Abi Shaybah 5666","","","كتاب الجمعة"
"5667","(۵۶۶۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَخْرُجُ یَوْمَ الْفِطْرِ فَیُکَبِّرُ حَتَّی یَأْتِیَ الْمُصَلَّی ، وَحَتَّی یَقْضِیَ الصَّلاَۃَ ، فَإِذَا قَضَی الصَّلاَۃَ قَطَعَ التَّکْبِیرَ۔ (دارقطنی ۶۔ بیہقی ۲۷۹)","","Musannaf Ibn Abi Shaybah 5667","","","كتاب الجمعة"
"5668","(۵۶۶۸) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : خَرَجْتُ مَعَ أَبِی عَبْدِ الرَّحْمَنِ ، وَابْنِ مَعْقِلٍ ، فَکَانَ أَبُو عَبْدِ الرَّحْمَنِ یُکَبِّرُ ، یَرْفَعُ صَوْتَہُ بِالتَّکْبِیرِ ، وَکَانَ ابْنُ مَعْقِلٍ یَقُولُ : لاَ إِلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ ، وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5668","","","كتاب الجمعة"
"5669","(۵۶۶۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، قَالَ : خَرَجْتُ مَعَ سَعِیدِ بْنِ جُبَیْرٍ ، وَعَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی فَلَمْ یَزَالاَ یُکَبِّرَانِ ، وَیَأْمُرَانِ مَنْ مَرَّا بِہِ بِالتَّکْبِیرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5669","","","كتاب الجمعة"
"5670","(۵۶۷۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، قَالَ : کُنْتُ أَخْرُجُ مَعَ أَصْحَابِنَا ؛ إِبْرَاہِیمَ وَخَیْثَمَۃَ ، وَأَبِی صَالِحٍ یَوْمَ الْعِیدِ فَلاَ یُکَبِّرُونَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5670","","","كتاب الجمعة"
"5671","(۵۶۷۱) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَنْ حَجَّاجٍ ، قَالَ : حدَّثَنِی رَجُلٌ مِنَ الْمُسْلِمِینَ ، عَنْ حَنَشٍ أَبِی الْمُعْتَمِرِ ؛ أَنَّ عَلِیًّا یَوْمَ أَضْحَی کَبَّرَ حَتَّی انْتَہَی إِلَی الْعِیدِ۔","Da'if","Musannaf Ibn Abi Shaybah 5671","","","كتاب الجمعة"
"5672","(۵۶۷۲) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : إِنَّ مِنَ السُّنَّۃِ أَنْ یُکَبِّرَ یَوْمَ الْعِیدِ۔","","Musannaf Ibn Abi Shaybah 5672","","","كتاب الجمعة"
"5673","(۵۶۷۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ شُعْبَۃَ ، قَالَ : قُلْتُ لِلْحَکَمِ ، وَحَمَّادٍ : أُکَبِّرُ إِذَا خَرَجْتُ إِلَی الْعِیدِ ؟ قَالاَ : نَعَمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 5673","","","كتاب الجمعة"
"5674","(۵۶۷۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، وَأَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ؛ أَنَّ أَبَاہُ کَانَ یُکَبِّرُ یَوْمَ الْعِیدِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5674","","","كتاب الجمعة"
"5675","(۵۶۷۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : کَانَ النَّاسُ یُکَبِّرُونَ فِی الْعِیدِ ، حِینَ یَخْرُجُونَ مِنْ مَنَازِلِہِمْ حَتَّی یَأْتُوا الْمُصَلَّی ، وَحَتَّی یَخْرُجَ الإِمَامُ ، فَإِذَا خَرَجَ الإِمَامُ سَکَتُوا ، فَإِذَا کَبَّرَ کَبَّرُوا۔","No Data Available","Musannaf Ibn Abi Shaybah 5675","","","كتاب الجمعة"
"5676","(۵۶۷۶) حَدَّثَنَا یَزِیدُ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ شُعْبَۃَ ، قَالَ : کُنْتُ أَقُودُ ابْنَ عَبَّاسٍ یَوْمَ الْعِیدِ ، فَسَمِعَ النَّاسَ یُکَبِّرُونَ ، فَقَالَ : مَا شَأْنُ النَّاسِ ؟ قُلْتُ : یُکَبِّرُونَ ، قَالَ : یُکَبِّرُونَ ؟ قَالَ : یُکَبِّرُ الإِمَامُ ؟ قُلْتُ : لاَ ، قَالَ : أَمَجَانِینُ النَّاسُ ؟۔","Da'if","Musannaf Ibn Abi Shaybah 5676","","","كتاب الجمعة"
"5677","(۵۶۷۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَنْ شَقِیقٍ ، عَنْ عَلِیٍّ (ح) وَعَنْ عَبْدِ الأَعْلَی ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَانَ یُکَبِّرُ بَعْدَ صَلاَۃِ الْفَجْرِ یَوْمَ عَرَفَۃَ إِلَی صَلاَۃِ الْعَصْرِ مِنْ آخِرِ أَیَّامِ التَّشْرِیقِ، وَیُکَبِّرُ بَعْدَ الْعَصْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 5677","","","كتاب الجمعة"
"5678","(۵۶۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی جُنَابٍ ، عَنْ عُمَیْرِ بْنِ سَعِیدٍ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَانَ یُکَبِّرُ مِنْ صَلاَۃِ الْفَجْرِ یَوْمَ عَرَفَۃَ إِلَی صَلاَۃِ الْعَصْرِ مِنْ آخِرِ أَیَّامِ التَّشْرِیقِ۔","Da'if","Musannaf Ibn Abi Shaybah 5678","","","كتاب الجمعة"
"5679","(۵۶۷۹) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ ، قَالَ : کَانَ عَبْدُ اللہِ یُکَبِّرُ مِنْ صَلاَۃِ الْفَجْرِ یَوْمَ عَرَفَۃَ إِلَی صَلاَۃِ الْعَصْرِ مِنْ یوم النَّحْرِ ، یَقُولُ : اللَّہُ أَکْبَرُ اللَّہُ أَکْبَرُ اللَّہُ أَکْبَرُ لاَ إلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ اللَّہُ أَکْبَرُ وَلِلَّہِ الْحَمْدُ۔","Sahih","Musannaf Ibn Abi Shaybah 5679","","","كتاب الجمعة"
"5680","(۵۶۸۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ غَیْلاَنَ بْنِ جَامِعٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ یُکَبِّرُ مِنْ صَلاَۃِ الْفَجْرِ یَوْمَ عَرَفَۃَ إِلَی صَلاَۃِ الْعَصْرِ مِنْ یَوْمِ النَّحْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5680","","","كتاب الجمعة"
"5681","(۵۶۸۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی عَوَانَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، عَنْ عُمَرَ ؛ أَنَّہُ کَانَ یُکَبِّرُ مِنْ صَلاَۃِ الْغَدَاۃِ یَوْمَ عَرَفَۃَ إِلَی صَلاَۃِ الظُّہْرِ مِنْ آخِرِ أَیَّامِ التَّشْرِیقِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5681","","","كتاب الجمعة"
"5682","(۵۶۸۲) حَدَّثَنَا زَیدُ بْنُ الْحُبَابِ ، قَالَ : أَخْبَرَنَا أَبُو عَوَانَۃَ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ أبی رِبَاحٍ الشَّامِیِّ ، عَنْ رَجُلٍ مِنْ أَہْلِ الشَّامِ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ؛ أَنَّہُ کَانَ یُکَبِّرُ مِنْ صَلاَۃِ الظُّہْرِ یَوْمَ النَّحْرِ إِلَی آخِرِ أَیَّامِ التَّشْرِیقِ ، یُکَبِّرُ فِی الْعَصْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 5682","","","كتاب الجمعة"
"5683","(۵۶۸۳) حَدَّثَنَا عَفَّانُ، قَالَ: حدَّثَنَا أَبُو عَوَانَۃَ، عَنْ عَبْدِ الْحَمِیدِ بْنِ أَبِی رِبَاحٍ، قَالَ: حَدَّثَنِی رَجُلٌ مِنْ أَہْلِ الشَّامِ، عَنْ زَیْدِ بْنِ ثَابِتٍ؛ أَنَّہُ کَانَ یُکَبِّرُ مِنْ صَلاَۃِ الظُّہْرِ مِنْ یَوْمِ النَّحْرِ إِلَی صَلاَۃِ الْعَصْرِ مِنْ آخِرِ أَیَّامِ التَّشْرِیقِ۔","Da'if","Musannaf Ibn Abi Shaybah 5683","","","كتاب الجمعة"
"5684","(۵۶۸۴) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، قَالَ : کَانَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ یُکَبِّرُ تَکْبِیرَ الْعِیدِ مِنْ صَلاَۃِ الظُّہْرِ یَوْمَ النَّحْرِ إِلَی آخِرِ أَیَّامِ التَّشْرِیقِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5684","","","كتاب الجمعة"
"5685","(۵۶۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ خُصَیْفٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یُکَبِّرُ مِنْ صَلاَۃِ الظُّہْرِ یَوْمَ النَّحْرِ إِلَی صَلاَۃِ الْعَصْرِ مِنْ آخِرِ أَیَّامِ التَّشْرِیقِ۔","Da'if","Musannaf Ibn Abi Shaybah 5685","","","كتاب الجمعة"
"5686","(۵۶۸۶) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُکَبِّرُ مِنْ صَلاَۃِ الظُّہْرِ یَوْمَ النَّحْرِ إِلَی صَلاَۃِ الْعَصْرِ مِنْ یَوْمِ النَّفْرِ ، یَعْنِی الأَوَّلَ۔","Da'if","Musannaf Ibn Abi Shaybah 5686","","","كتاب الجمعة"
"5687","(۵۶۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : یُکَبِّرُ مِنْ صَلاَۃِ الظُّہْرِ یَوْمَ النَّحْرِ إِلَی آخِرِ أَیَّامِ التَّشْرِیقِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5687","","","كتاب الجمعة"
"5688","(۵۶۸۸) حَدَّثَنَا مَالِکُ بْنُ إِسْمَاعِیلَ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، قَالَ : حَدَّثَنَا طَارِقٌ ؛ أَنَّہُ حَفِظَ مِنْ قَیْسِ بْنِ أَبِی حَازِمٍ تَکْبِیرَ أَیَّامِ التَّشْرِیقِ حَتَّی صَلَّی الْعَصْرَ ، یُکَبِّرُ بَعْدَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5688","","","كتاب الجمعة"
"5689","(۵۶۸۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ؛ أَنَّ أَبَا وَائِلٍ کَانَ یُکَبِّرُ مِنْ یَوْمِ عَرَفَۃَ مِنْ صَلاَۃِ الصُّبْحِ إِِلَی صَلاَۃِ الظُّہْرِ ، یَعْنِی مِنْ یَوْمِ النَّحْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5689","","","كتاب الجمعة"
"5690","(۵۶۹۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ أَنَّہُ کَانَ یُکَبِّرُ فی أَیَّامَ التَّشْرِیقِ ، فی صَلاَۃِ الظُّہْرِ یَوْمِ عَرَفَۃَ إِلَی صَلاَۃِ الفَجْر مِنْ آخِرِ أَیَّامِ التَّشْرِیقِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5690","","","كتاب الجمعة"
"5691","(۵۶۹۱) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنْ سَلَمَۃَ بْنِ نُبَیْطٍ ، عَنِ الضَّحَّاکِ ؛ أَنَّہُ کَانَ یُکَبِّرُ مِنْ صَلاَۃِ الْفَجْرِ یَوْمَ عَرَفَۃَ إِلَی صَلاَۃِ الْعَصْرِ مِنْ آخِرِ أَیَّامِ التَّشْرِیقِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5691","","","كتاب الجمعة"
"5692","(۵۶۹۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ أَبِی بَکَّارٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یُکَبِّرُ مِنْ صَلاَۃِ الْفَجْرِ یَوْمَ عَرَفَۃَ إِلَی آخِرِ أَیَّامِ التَّشْرِیقِ ، لاَ یُکَبِّرُ فِی الْمَغْرِبِ : اللَّہُ أَکْبَرُ کَبِیرًا اللَّہُ أَکْبَرُ کَبِیرًا ، اللَّہُ أَکْبَرُ وَأَجَلُّ ، اللَّہُ أَکْبَرُ وَلِلَّہِ الْحَمْدُ۔","Sahih","Musannaf Ibn Abi Shaybah 5692","","","كتاب الجمعة"
"5693","(۵۶۹۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ابْنُ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُکَبِّرُ مِنْ صَلاَۃِ الظُّہْرِ یَوْمَ عَرَفَۃَ إِلَی صَلاَۃِ الظُّہْرِ مِنْ آخِرِ أَیَّامِ التَّشْرِیقِ۔","","Musannaf Ibn Abi Shaybah 5693","","","كتاب الجمعة"
"5694","(۵۶۹۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حُمَیْدٍ ؛ أَنَّ الْحَسَنَ کَانَ یُکَبِّرُ مِنْ صَلاَۃِ الظُّہْرِ یَوْمَ النَّحْرِ إِلَی صَلاَۃِ الظُّہْرِ مِنَ النَّفْرِ الأَوَّلِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5694","","","كتاب الجمعة"
"5695","(۵۶۹۵) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ۔ وَقَالَ غَیْرُہُ : عَنْ یَزِیدَ بْنِ أَوْسٍ ، عَنْ عَلْقَمَۃَ ؛ أَنَّہُ کَانَ یُکَبِّرُ یَوْمَ عَرَفَۃَ صَلاَۃ الْفَجْرِ حَتَّی صَلاَۃِ الْعَصْرِ مِنْ یَوْمِ النَّحْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5695","","","كتاب الجمعة"
"5696","(۵۶۹۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یُکَبِّرُونَ یَوْمَ عَرَفَۃَ وَأَحَدُہُمْ مُسْتَقْبِلٌ الْقِبْلَۃَ فِی دُبُرِ الصَّلاَۃ : اللَّہُ أَکْبَرُ اللَّہُ أَکْبَرُ لاَ إِلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ اللَّہُ أَکْبَرُ وَلِلَّہِ الْحَمْدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5696","","","كتاب الجمعة"
"5697","(۵۶۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَص ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ یُکَبِّرُ أَیَّامَ التَّشْرِیقِ : اللَّہُ أَکْبَرُ اللَّہُ أَکْبَرُ لاَ إِلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ اللَّہُ أَکْبَرُ وَلِلَّہِ الْحَمْدُ۔","Sahih","Musannaf Ibn Abi Shaybah 5697","","","كتاب الجمعة"
"5698","(۵۶۹۸) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ یُکَبِّرُ مِنْ صَلاَۃِ الْفَجْرِ یَوْمَ عَرَفَۃَ إِلَی صَلاَۃِ الْعَصْرِ مِنْ یَوْمِ النَّحْرِ ، فَذَکَرَ مِثْلَ حَدِیثِ وَکِیعٍ۔","Sahih","Musannaf Ibn Abi Shaybah 5698","","","كتاب الجمعة"
"5699","(۵۶۹۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا شَرِیکٌ ، قَالَ : قُلْتُ لأَبِی إِسْحَاقَ : کَیْفَ کَانَ تَکْبِیرُ عَلِیٍّ ، وَعَبْدِ اللہِ ؟ فَقَالَ : کَانَا یَقُولاَنِ : اللَّہُ أَکْبَرُ اللَّہُ أَکْبَرُ لاَ إِلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ اللَّہُ أَکْبَرُ وَلِلَّہِ الْحَمْدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5699","","","كتاب الجمعة"
"5700","(۵۷۰۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حُمَیْدٌ ؛ أَنَّ الْحَسَنَ کَانَ یُکَبِّرُ : اللَّہُ أَکْبَرُ اللَّہُ أَکْبَرُ ، ثَلاَثَ مَرَّاتٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5700","","","كتاب الجمعة"
"5701","(۵۷۰۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَبِی بَکَّارٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ یَقُولُ : اللَّہُ أَکْبَرُ کَبِیرًا اللَّہُ ، أَکْبَرُ کَبِیرًا اللَّہُ ، أَکْبَرُ وَأَجَلُّ ، اللَّہُ أَکْبَرُ وَلِلَّہِ الْحَمْدُ۔","Sahih","Musannaf Ibn Abi Shaybah 5701","","","كتاب الجمعة"
"5702","(۵۷۰۲) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ سِمَاکٍ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : صَلَّیْتُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْعِیدَیْنِ غَیْرَ مَرَّۃٍ ، وَلاَ مَرَّتَیْنِ بِغَیْرِ أَذَانٍ ، وَلاَ إِقَامَۃٍ۔ (مسلم ۶۰۴۔ ابوداؤد ۱۱۴۱)","Hasan","Musannaf Ibn Abi Shaybah 5702","","","كتاب الجمعة"
"5703","(۵۷۰۳) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، قَالَ : شَہِدْتُ النَّبِیَّ صَلَّی اللَّہُ عَ??َیْہِ وَسَلَّمَ صَلَّی الْعِیدَیْنِ بِغَیْرِ أَذَانٍ ، وَلاَ إِقَامَۃٍ۔ (بخاری ۹۶۰۔ مسلم ۵)","Sahih","Musannaf Ibn Abi Shaybah 5703","","","كتاب الجمعة"
"5704","(۵۷۰۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی یَوْمَ الْعِیدِ بِغَیْرِ أَذَانٍ ، وَلاَ إِقَامَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 5704","","","كتاب الجمعة"
"5705","(۵۷۰۵) حَدَّثَنَا وَکِیعٌ ، عن سُفْیَانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَابِسٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی بِہِمْ یَوْمَ الْعِیدِ عِنْدَ دَارِ کَثِیرِ بْنِ الصَّلْتِ ، فَصَلَّی قَبْلَ الْخُطْبَۃِ ، وَلَمْ یَذْکُرْ أَذَانًا ، وَلاَ إِقَامَۃً۔ (بخاری ۸۶۳۔ احمد ۱/۳۶۸)","Sahih","Musannaf Ibn Abi Shaybah 5705","","","كتاب الجمعة"
"5706","(۵۷۰۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ سِمَاکٍ ، قَالَ : رَأَیْتُ الْمُغِیرَۃَ بْنَ شُعْبَۃَ ، وَالضَّحَّاکَ ، وَزِیَادًا یُصَلُّونَ یَوْمَ الْفِطْرِ وَالأَضْحَی بِلاَ أَذَانٍ ، وَلاَ إِقَامَۃٍ۔","Hasan","Musannaf Ibn Abi Shaybah 5706","","","كتاب الجمعة"
"5707","(۵۷۰۷) حَدَّثَنَا وَکِیعٌ، عَنْ إِسْرَائِیلَ، عَنْ سِمَاکٍ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ؛ أَنَّہُ صَلَّی یَوْمَ عِیدٍ بِغَیْرِ أَذَانٍ، وَلاَ إِقَامَۃٍ۔","Hasan","Musannaf Ibn Abi Shaybah 5707","","","كتاب الجمعة"
"5708","(۵۷۰۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ أَنَّہُ کَانَ یَقُولُ : لَیْسَ فِی الْعِیدَیْنِ أَذَانٌ ، وَلاَ إِقَامَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5708","","","كتاب الجمعة"
"5709","(۵۷۰۹) حَدَّثَنَا خَالِد بْنِ حَیَّانَ ، عَنْ جَعْفَر بْنِ بُرْقَان ، عَنْ عِکْرِمَۃَ ، قَال : لَیْسَ فِیہِ أَذَانٌ ، وَلاَ إِقَامَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5709","","","كتاب الجمعة"
"5710","(۵۷۱۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّ ابْنَ الزُّبَیْرِ سَأَلَ ابْنَ عَبَّاسٍ ؟ قَالَ : وَکَانَ الَّذِی بَیْنَہُمَا حَسَنٌ ، فَقَالَ : لاَ تُؤَذِّنْ ، وَلاَ تُقِمْ ، فَلَمَّا سَائَ الَّذِی بَیْنَہُمَا أَذَّنَ وَأَقَامَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5710","","","كتاب الجمعة"
"5711","(۵۷۱۱) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، قَالَ : الأَذَانُ فِی الْعِیدِ مُحْدَثٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5711","","","كتاب الجمعة"
"5712","(۵۷۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ، قَالَ : أَوَّلُ مَنْ أَحْدَثَ الأَذَانَ فِی الْعِیدِ مُعَاوِیَۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 5712","","","كتاب الجمعة"
"5713","(۵۷۱۳) حَدَّثَنَا سَلاَّمٌ أَبو الأَحْوَص ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ أَذَانَ ، وَلاَ إِقَامَۃَ فِی الْعِیدَیْنِ ، وَلاَ قِرَائَۃَ خَلْفَ الإِمَامِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5713","","","كتاب الجمعة"
"5714","(۵۷۱۴) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عِیسَی بْنِ الْمُغِیرَۃِ ، قَالَ : قُلْتُ لأَبِی وَائِلٍ : کَانُوا یُؤَذِّنُونَ فِی الأَضْحَی وَالْفِطْرِ ؟ قَالَ : لاَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5714","","","كتاب الجمعة"
"5715","(۵۷۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ، وَالْحَکَمِ، قَالاَ: الأَذَانُ یَوْمَ الأَضْحَی وَالْفِطْرِ بِدْعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5715","","","كتاب الجمعة"
"5716","(۵۷۱۶) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، قَالَ : أَوَّلُ مَنْ أَذَّنَ فِی الْعِیدِ زِیَادٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5716","","","كتاب الجمعة"
"5717","(۵۷۱۷) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا زَکَرِیَّا ، عَنْ رَجُلٍ ، عَنِ الشَّعْبِیِّ ، عَنِ الْبَرَائِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی یَوْمَ الْعِیدِ بِغَیْرِ أَذَانٍ ، وَلاَ إِقَامَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 5717","","","كتاب الجمعة"
"5718","(۵۷۱۸) حَدَّثَنَا مُعْتَمِرٌ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَمَّن حَدَّثَہُ ، عَنْ عَلِیٍّ ؛ أَنَّہُ صَلَّی یَوْمَ عِیدٍ بِغَیْرِ أَذَانٍ ، وَلاَ إِقَامَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 5718","","","كتاب الجمعة"
"5719","(۵۷۱۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، قَالَ : حدَّثَنَا أَیُّوبَ ، قَالَ : سَمِعْتُ عَطَائً ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ ، یَقُولُ : أَشْہَدُ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَصَلَّی قَبْلَ الْخُطْبَۃِ ، ثُمَّ خَطَبَ۔ (بخار ی۱۴۴۹۔ ابوداؤد ۱۱۳۷)","Sahih","Musannaf Ibn Abi Shaybah 5719","","","كتاب الجمعة"
"5720","(۵۷۲۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، قَالَ : شَہِدْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ عِیدٍ بَدَأَ بِالصَّلاَۃ قَبْلَ الْخُطْبَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 5720","","","كتاب الجمعة"
"5721","(۵۷۲۱) حَدَّثَنَا عَبْدَۃُ بْنَ سُلَیْمَانَ ، وَأَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبَا بَکْرٍ ، وَعُمَرَ کَانُوا یُصَلُّونَ الْعِیدَیْنِ قَبْلَ الْخُطْبَۃِ۔ (بخاری ۹۵۷۔ ترمذی ۵۳۱)","Sahih","Musannaf Ibn Abi Shaybah 5721","","","كتاب الجمعة"
"5722","(۵۷۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَابِسٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی بِہِمْ یَوْمَ عِیدٍ عِنْدَ دَارِ کَثِیرِ بْنِ الصَّلْتِ ، فَصَلَّی بِہِمْ قَبْلَ الْخُطْبَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 5722","","","كتاب الجمعة"
"5723","(۵۷۲۳) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مَنْصُورٍ ، عَنِ الشَّعْبِیِّ ، عَنِ الْبَرَائِ ، قَالَ : خَطَبَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ النَّحْرِ بَعْدَ الصَّلاَۃ۔ (بخاری ۹۵۵۔ ترمذی ۱۵۰۸)","Sahih","Musannaf Ibn Abi Shaybah 5723","","","كتاب الجمعة"
"5724","(۵۷۲۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا شُعْبَۃُ ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ ، قَالَ : سَمِعْتُ جُنْدُبَ بْنَ عَبْدِ اللہِ ، یَقُولُ : صَلَّیْتُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ النَّحْرِ ، ثُمَّ خَطَبَ۔ (بخاری ۹۸۵۔ مسلم ۱۵۵۲)","Sahih","Musannaf Ibn Abi Shaybah 5724","","","كتاب الجمعة"
"5725","(۵۷۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ الْحَسَنِ بْنِ مُسْلِمٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : شَہِدْتُ الْعِیدَ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَمَعَ أَبِی بَکْرٍ ، وَعُمَرَ فَبَدَؤُوا بِالصَّلاَۃ قَبْلَ الْخُطْبَۃِ ۔ (بخاری ۹۶۲۔ مسلم ۶۰۲)","Sahih","Musannaf Ibn Abi Shaybah 5725","","","كتاب الجمعة"
"5726","(۵۷۲۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی عُبَیْدٍ مَوْلَی ابْنِ أَزْہَرَ ، قَالَ : شَہِدْتُ الْعِیدَ مَعَ عُمَرَ بْنِ الْخَطَّابِ فَبَدَأَ بِالصَّلاَۃ قَبْلَ الْخُطْبَۃِ ، قَالَ : ثُمَّ شَہِدْتُ الْعِیدَ مَعَ عُثْمَانَ فَبَدَأَ بِالصَّلاَۃ قَبْلَ الْخُطْبَۃِ ، قَالَ : وَشَہِدْتُہُ مَعَ عَلِیٍّ فَبَدَأَ بِالصَّلاَۃ قَبْلَ الْخُطْبَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 5726","","","كتاب الجمعة"
"5727","(۵۷۲۷) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ مَیْسَرَۃَ أَبِی جَمِیلَۃَ ، قَالَ : شَہِدْتُ الْعِیدَ مَعَ عَلِیٍّ ، فَلَمَّا صَلَّی خَطَبَ ۔ قَالَ : وَکَانَ عُثْمَانُ یَفْعَلُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 5727","","","كتاب الجمعة"
"5728","(۵۷۲۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّ ابْنَ الزُّبَیْرِ سَأَلَ ابْنَ عَبَّاسٍ ، قَالَ : کَیْفَ أَصْنَعُ فِی ہَذَا الْیَوْمِ ، یَوْمِ عِیدٍ ؟ وَکَانَ الَّذِی بَیْنَہُمَا حَسَنٌ ، فَقَالَ : لاَ تُؤَذِّنْ ، وَلاَ تُقِمْ ، وَصَلِّ قَبْلَ الْخُطْبَۃِ ۔ فَلَمَّا سَائَ الَّذِی بَیْنَہُمَا ، أَذَّنَ وَأَقَامَ ، وَخَطَبَ قَبْلَ الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 5728","","","كتاب الجمعة"
"5729","(۵۷۲۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حُمَیْدِ ، عَنْ أَنَسٍ ، قَالَ : کَانَتِ الصَّلاَۃُ فِی الْعِیدَیْنِ قَبْلَ الْخُطْبَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 5729","","","كتاب الجمعة"
"5730","(۵۷۳۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ شِبَاکٍ ، ??َنْ إِبْرَاہِیمَ ، قَالَ : کَانَ الإِمَامُ یَوْمَ الْعِیدِ یَبْدَأُ فَیُصَلِّی ، ثُمَّ یَرْکَبُ بَعِیرَہُ فَیَخْطُبُ قَدْرَ مَا یَرْجِعُ النِّسَائُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5730","","","كتاب الجمعة"
"5731","(۵۷۳۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعَلاَئِ بْنِ عَبْدِ الْکَرِیمِ ، قَالَ : سَمِعْتُ أَبَا الْبَخْتَرِیِّ یَوْمَ عِیدٍ ، وَسَمِعَ رَجُلاً یَقُولُ : الصَّلاَۃُ قَبْلَ الْخُطْبَۃِ ، فَقَالَ : السُّنَّۃُ وَرَبِّ الْکَعْبَۃِ۔","","Musannaf Ibn Abi Shaybah 5731","","","كتاب الجمعة"
"5732","(۵۷۳۲) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ أَبِی حَمْزَۃَ مَوْلَی یَزِیدَ بْنِ الْمُہَلِّبِ ؛ أَنَّ مَطَرَ بْنَ نَاجِیَۃَ سَأَلَ سَعِیدَ بْنَ جُبَیْرٍ عَنِ الصَّلاَۃ یَوْمَ الأَضْحَی وَیَوْمَ الْفِطْرِ ؟ فَأَمَرَہُ أَنْ یُصَلِّیَ قَبْلَ الْخُطْبَۃِ ، فَاسْتَنْکَرَ النَّاسُ ذَلِکَ ، فَقَالَ سَعِیدٌ : ہِیَ وَاللَّہِ مَعْرُوفَۃٌ ، ہِیَ وَاللَّہِ مَعْرُوفَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5732","","","كتاب الجمعة"
"5733","(۵۷۳۳) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ، عَنْ یَزِیدَ عَنِ ابْنِ أَبِی لَیْلَی، قَالَ: صَلَّی بِنَا عَلِیٌّ الْعِیدَ، ثُمَّ خَطَبَ عَلَی رَاحِلَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 5733","","","كتاب الجمعة"
"5734","(۵۷۳۴) حَدَّثَنَا عَبْدَۃُ بْنَ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ یُوسُفَ بْنِ عَبْدِ اللہِ بْنِ سَلاَمٍ ، قَالَ : کَانَ النَّاسُ یَبْدَؤُونَ بِالصَّلاَۃ ، ثُمَّ یُثَنَّوْنَ بِالْخُطْبَۃِ ، حَتَّی إَِذَا کَانَ عُمَرُ وَکَثُرَ النَّاسُ فِی زَمَانِہِ ، فَکَانَ إِذَا ذَہَبَ لِیَخْطُبُ ذَہَبَ جُفَاۃُ النَّاسِ ، فَلَمَّا رَأَی ذَلِکَ عُمَرُ بَدَأَ بِالْخُطْبَۃِ حَتَّی خَتَمَ بِالصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 5734","","","كتاب الجمعة"
"5735","(۵۷۳۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ إِسْمَاعِیلَ بْنِ رَجَائٍ ، عَنْ أَبِیہِ ، قَالَ : أَخْرَجَ مَرْوَانُ الْمِنْبَرَ ، وَبَدَأَ بِالْخُطْبَۃِ قَبْلَ الصَّلاَۃ ، فَقَامَ إِلَیْہِ رَجُلٌ ، فَقَالَ : یَا مَرْوَانُ ، خَالَفْتَ السُّنَّۃَ ، أَخْرَجْتَ الْمِنْبَرَ وَلَمْ یَکُنْ یُخْرَجُ ، وَبَدَأْتَ بِالْخُطْبَۃِ قَبْلَ الصَّلاَۃِ ، فَقَالَ أَبُو سَعِیدٍ : مَنْ ہَذَا ؟ قَالُوا : فُلاَنٌ ، فَقَالَ : أَمَّا ہَذَا فَقَدْ قَضَی مَا عَلَیْہِ۔ (مسلم ۷۹۔ ابوداؤد ۱۱۳۳)","Sahih","Musannaf Ibn Abi Shaybah 5735","","","كتاب الجمعة"
"5736","(۵۷۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، قَالَ : أَوَّلُ مَنْ بَدَأَ بِالْخُطْبَۃِ یَوْمَ الْعِیدِ قَبْلَ الصَّلاَۃِ مَرْوَانُ ، فَقَامَ إِلَیْہِ رَجُلٌ ، فَقَالَ : الصَّلاَۃُ قَبْلَ الْخُطْبَۃِ ، فَقَالَ : تُرِکَ مَا ہُنَالِکَ ، فَقَالَ أَبُو سَعِیدٍ : أَمَّا ہَذَا فَقَدْ قَضَی مَا عَلَیْہِ۔ (مسلم ۷۸۔ ابوداؤد ۱۱۳۳)","Sahih","Musannaf Ibn Abi Shaybah 5736","","","كتاب الجمعة"
"5737","(۵۷۳۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَکْرَہُ الْکَلاَمَ وَالإِمَامُ یَخْطُبُ یَوْمَ الْعِیدَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5737","","","كتاب الجمعة"
"5738","(۵۷۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَرِہَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5738","","","كتاب الجمعة"
"5739","(۵۷۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی عَوَانَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَرِہَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5739","","","كتاب الجمعة"
"5740","(۵۷۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الْہَیْثُمِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : خَرَجْتُ مَعَہُ یَوْمَ عِیدٍ ، فَلَمَّا خَطَبَ الإِمَامُ سَکَتَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5740","","","كتاب الجمعة"
"5741","(۵۷۴۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ: قُلْتُ لَہُ: یُکْرَہُ الْکَلاَمُ فِی الْعِیدِ وَالإِمَامُ یَخْطُبُ؟ قَالَ : نَعَمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 5741","","","كتاب الجمعة"
"5742","(۵۷۴۲) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ شُعْبَۃَ ، قَالَ : کَلَّمَنِی الْحَکَمُ بْنُ عُتَیْبَۃَ فِی یَوْمِ عِیدٍ وَالإِمَام یَخْطُبُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5742","","","كتاب الجمعة"
"5743","(۵۷۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ یَعْلَی الطَّائِفِیُّ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ، عَنْ جَدِّہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَبَّرَ فِی عِیدٍ ثِنْتَیْ عَشْرَۃَ تَکْبِیرَۃً ، سَبْعًا فِی الأُولَی ، وَخَمْسًا فِی الآخِرَۃِ۔ (ابوداؤد ۱۱۴۴۔ احمد ۲/۱۸۰)","Hasan","Musannaf Ibn Abi Shaybah 5743","","","كتاب الجمعة"
"5744","(۵۷۴۴) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ ثَوْبَانَ ، عَنْ أَبِیہِ ، عَنْ مَکْحُولٍ ، قَالَ : حَدَّثَنِی أَبُو عَائِشَۃَ ، وَکَانَ جَلِیسًا لأَبِی ہُرَیْرَۃَ ، قَالَ : شَہِدْتُ سَعِیدَ بْنَ الْعَاصِ وَدَعَا أَبَا مُوسَی الأَشْعَرِیَّ وَحُذَیْفَۃَ ، فَسَأَلَہُمَا عَنِ التَّکْبِیرِ فِی الْعِیدَیْنِ ؟ فَقَالَ أَبُو مُوسَی : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُکَبِّرُ فِی الْعِیدَیْنِ أَرْبَعًا کَمَا یُکَبِّرُ عَلَی الْجِنَازَۃِ ، قَالَ : وَصَدَّقَہُ حُذَیْفَۃُ ، قَالَ : فَقَالَ أَبُو مُوسَی : وَکَذَلِکَ کُنْتُ أُصَلِّی بِأَہْلِ الْبَصْرَۃِ وَأَنَا عَلَیْہَا ، قَالَ أبُو عَائِشَۃَ : وَأَنَا حَاضِرٌ ذَلِکَ ، فَمَا نَسِیتُ قَوْلَہُ أَرْبَعًا کَالتَّکْبِیرِ عَلَی الْجِنَازَۃِ۔ (ابوداؤد ۱۱۴۶۔ بیہقی ۲۹۰)","Da'if","Musannaf Ibn Abi Shaybah 5744","","","كتاب الجمعة"
"5745","(۵۷۴۵) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مَکْحُولٍ ، قَالَ : أَخْبَرَنِی مَنْ شَہِدَ سَعِیدَ بْنَ الْعَاصِ أَرْسَلَ إِلَی أَرْبَعَۃِ نَفَرٍ مِنْ أَصْحَابِ الشَّجَرَۃِ فَسَأَلَہُمْ عَنِ التَّکْبِیرِ فِی الْعِیدِ ؟ فَقَالُوا : ثَمَانُ تَکْبِیرَاتٍ ، قَالَ : فَذَکَرْتُ ذَلِکَ لاِبْنِ سِیرِینَ ، فَقَالَ : صَدَقَ ، وَلَکِنَّہُ أَغْفَلَ تَکْبِیرَۃَ فَاتِحَۃِ الصَّلاَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 5745","","","كتاب الجمعة"
"5746","(۵۷۴۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُجَالِدٌ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، قَالَ : کَانَ عَبْدُ اللہِ یُعَلِّمُنَا التَّکْبِیرَ فِی الْعِیدَیْنِ تِسْعَ تَکْبِیرَاتٍ ؛ خَمْسٌ فِی الأُولَی ، وَأَرْبَعٌ فِی الآخِرَۃِ ، وَیُوَالِی بَیْنَ الْقِرَائَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 5746","","","كتاب الجمعة"
"5747","(۵۷۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحِلٍّ ، عَنْ إِبْرَاہِیمَ (ح) وَعَنْ إِسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ یُکَبِّرُ فِی الْفِطْرِ وَالأَضْحَی تِسْعًا تِسْعًا ؛ خَمْسًا فِی الأُولَی ، وَأَرْبَعًا فِی الآخِرَۃِ ، وَیُوَالِی بَیْنَ الْقِرَائَتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5747","","","كتاب الجمعة"
"5748","(۵۷۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی مُوسَی (ح) وَعَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّ أَمِیرًا مِنْ أُمَرَائِ الْکُوفَۃِ ، قَالَ سُفْیَانُ : أَحَدُہُمَا سَعِیدُ بْنُ الْعَاصِ ، وَقَالَ : الآخَرُ الْوَلِیدُ بْنُ عُقْبَۃَ ، بَعَثَ إِلَی عَبْدِ اللہِ بْنِ مَسْعُودٍ ، وَحُذَیْفَۃَ بْنِ الْیَمَانِ ، وَعَبْدِ اللہِ بْنِ قَیْسٍ ، فَقَالَ : إِنَّ ہَذَا الْعِیدَ قَدْ حَضَرَ ، فَمَا تَرَوْنَ ؟ فَأَسْنَدُوا أَمْرَہُمْ إِلَی عَبْدِ اللہِ ، فَقَالَ : تُکَبِّرُ تِسْعًا ؛ تَکْبِیرَۃً تَفْتَتِحُ بِہَا الصَّلاَۃَ ، ثُمَّ تُکَبِّرُ ثَلاَثًا ، ثُمَّ تَقْرَأُ سُورَۃً ، ثُمَّ تُکَبِّرُ ، ثُمَّ تَرْکَعُ ، ثُمَّ تَقُومُ فَتَقْرَأُ سُورَۃً ، ثُمَّ تُکَبِّرُ أَرْبَعًا ، تَرْکَعُ بِإِحْدَاہُنَّ۔","Da'if","Musannaf Ibn Abi Shaybah 5748","","","كتاب الجمعة"
"5749","(۵۷۴۹) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَانَ یُکَبِّرُ فِی الْفِطْرِ إِحْدَی عَشْرَۃَ ؛ سِتًّا فِی الأُولَی ، وَخَمْسًا فِی الآخِرَۃِ ، یَبْدَأُ بِالْقِرَائَۃِ فِی الرَّکْعَتَیْنِ ، وَخَمْسًا فِی الأَضْحَی؛ ثَلاَثًا فِی الأُولَی ، وَثِنْتَیْنِ فِی الآخِرَۃِ ، یَبْدَأُ بِالْقِرَائَۃِ فِی الرَّکْعَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 5749","","","كتاب الجمعة"
"5750","(۵۷۵۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، وَعَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یُکَبِّرُ ثَلاَثَ عَشْرَۃَ تَکْبِیرَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 5750","","","كتاب الجمعة"
"5751","(۵۷۵۱) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّ ابْنَ عَبَّاسٍ کَبَّرَ فِی عِیدٍ ثَلاَثَ عَشْرَۃَ ؛ سَبْعًا فِی الأُولَی ، وَسِتًّا فِی الآخِرَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 5751","","","كتاب الجمعة"
"5752","(۵۷۵۲) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : کَانَ یُکَبِّرُ فِی الأُولَی سَبْعَ تَکْبِیرَاتٍ ، وَفِی الثَّانِیَۃِ خَمْسًا ، کُلُّہُنَّ قَبْلَ الْقِرَائَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 5752","","","كتاب الجمعة"
"5753","(۵۷۵۳) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یُکَبِّرُ فِی الْعِیدِ ، فِی الأُولَی سَبْعَ تَکْبِیرَاتٍ بِتَکْبِیرَۃِ الافْتِتَاحِ ، وَفِی الآخِرَۃِ سِتًّا بِتَکْبِیرَۃِ الرَّکْعَۃِ ، کُلُّہُنَّ قَبْلَ الْقِرَائَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 5753","","","كتاب الجمعة"
"5754","(۵۷۵۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَشْعَثَ ، عَنْ کُرْدُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَمَّا کَانَ لَیْلَۃَ الْعِیدِ أَرْسَلَ الْوَلِیدُ بْنُ عُقْبَۃَ إِلَی ابْنِ مَسْعُودٍ ، وَأَبِی مَسْعُودٍ ، وَحُذَیْفَۃَ ، وَأَبِی مُوسَی الأَشْعَرِیِّ ، فَقَالَ لَہُم : إِنَّ الْعِیدَ غَدًا ، فَکَیْفَ التَّکْبِیرُ ؟ فَقَالَ عَبْدُ اللہِ : تَقُومُ فَتُکَبِّرُ أَرْبَعَ تَکْبِیرَاتٍ ، وَتَقْرَأُ بِفَاتِحَۃِ الْکِتَابِ وَسُورَۃٍ مِنَ الْمُفَصَّلِ لَیْسَ مِنْ طِوَالِہَا ، وَلاَ مِنْ قِصَارِہَا ، ثُمَّ تَرْکَعُ ، ثُمَّ تَقُومُ فَتَقْرَأُ ، فَإِذَا فَرَغْتَ مِنَ الْقِرَائَۃِ کَبَّرْتَ أَرْبَعَ تَکْبِیرَاتٍ ، ثُمَّ تَرْکَعُ بِالرَّابِعَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 5754","","","كتاب الجمعة"
"5755","(۵۷۵۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْمَسْعُودِیِّ ، عَنْ مَعْبَدِ بْنِ خَالِدٍ ، عَنْ کُرْدُوسٍ ، قَالَ : قدِمَ سَعِیدُ بْنُ الْعَاصِ فِی ذِی الْحِجَّۃِ ، فَأَرْسَلَ إِلَی عَبْدِ اللہِ ، وَحُذَیْفَۃَ ، وَأَبِی مَسْعُودٍ الأَنْصَارِیِّ ، وَأَبِی مُوسَی الأَشْعَرِیِّ فَسَأَلَہُمْ عَنِ التَّکْبِیرِ فِی الْعِیدِ ؟ فَأَسْنَدُوا أَمْرَہُمْ إِلَی عَبْدِ اللہِ ، فَقَالَ عَبْدُ اللہِ : یَقُومُ فَیُکَبِّرُ ، ثُمَّ یُکَبِّرُ ، ثُمَّ یُکَبِّرُ، ، ثُمَّ یُکَبِّرُ فَیَقْرَأُ ، ثُمَّ یُکَبِّرُ وَیَرْکَعُ ، وَیَقُومُ فَیَقْرَأُ ، ثُمَّ یُکَبِّرُ ، ثُمَّ یُکَبِّرُ ، ثُمَّ یُکَبِّرُ ، ثُمَّ یُکَبِّرُ الرَّابِعَۃَ ، ثُمَّ یَرْکَعُ۔","Da'if","Musannaf Ibn Abi Shaybah 5755","","","كتاب الجمعة"
"5756","(۵۷۵۶) حَدَّثَنَا أَبُو أُسَامَۃُ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، وَسَعِیدِ بْنِ الْمُسَیَّبِ ، قَالاَ : تِسْعُ تَکْبِیرَاتٍ ، وَیُوَالِی بَیْنَ الْقِرَائَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 5756","","","كتاب الجمعة"
"5757","(۵۷۵۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا خَالِدٌ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، قَالَ : صَلَّی بِنَا ابْنُ عَبَّاسٍ یَوْمَ عِیدٍ ، فَکَبَّرَ تِسْعَ تَکْبِیرَاتٍ ؛ خَمْسًا فِی الأُولَی ، وَأَرْبَعًا فِی الآخِرَۃِ ، وَوَالَی بَیْنَ الْقِرَائَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 5757","","","كتاب الجمعة"
"5758","(۵۷۵۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا دَاوُد ، عَنِ الشَّعْبِیِّ ، قَالَ : أَرْسَلَ زِیَادٌ إِلَی مَسْرُوقٍ : إِنَّا تَشْغَلُنَا أَشْغَالٌ ، فَکَیْفَ التَّکْبِیرُ فِی الْعِیدَیْنِ ؟ قَالَ : تِسْعُ تَکْبِیرَاتٍ ، قَالَ : خَمْسًا فِی الأُولَی ، وَأَرْبَعًا فِی الآخِرَۃِ ، وَوَالِ بَیْنَ الْقِرَائَتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5758","","","كتاب الجمعة"
"5759","(۵۷۵۹) حَدَّثَنَا غُنْدَرٌ ، وَابْنُ مَہْدِیٍّ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، وَمَسْرُوقٍ ؛ أَنَّہُمَا کَانَا یُکَبِّرَانِ فِی الْعِیدِ تِسْعَ تَکْبِیرَاتٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5759","","","كتاب الجمعة"
"5760","(۵۷۶۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، عَنْ أَنَسٍ ؛ أَنَّہُ کَانَ یُکَبِّرُ فِی الْعِیدِ تِسْعًا ۔ فَذَکَرَ مِثْلَ حَدِیثِ عَبْدِ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 5760","","","كتاب الجمعة"
"5761","(۵۷۶۱) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّ أَصْحَابَ عَبْدِ اللہِ کَانُوا یُکَبِّرُونَ فِی الْعِیدَیْنِ تِسْعَ تَکْبِیرَاتٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5761","","","كتاب الجمعة"
"5762","(۵۷۶۲) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : التَّکْبِیرُ فِی الْعِیدَیْنِ تِسْعٌ تِسْعٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5762","","","كتاب الجمعة"
"5763","(۵۷۶۳) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنِ أَبِی جَعْفَرٍ ؛ أَنَّہُ کَانَ یُفْتِی بِقَوْلِ عَبْدِ اللہِ فِی التَّکْبِیرِ فِی الْعِیدَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 5763","","","كتاب الجمعة"
"5764","(۵۷۶۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ أَنَّہُ قَالَ : التَّکْبِیرُ فِی الأَضْحَی وَالْفِطْرِ سَبْعٌ وَخَمْسٌ فِی الْعِیدَیْنِ ، کِلاَہُمَا قَبْلَ الْقِرَائَۃِ ، لاَ یُوَالِی بَیْنَ الْقِرَائَتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5764","","","كتاب الجمعة"
"5765","(۵۷۶۵) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ؛ أَنَّہُمَا کَانَا یُکَبِّرَانِ تِسْعَ تَکْبِیرَاتٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5765","","","كتاب الجمعة"
"5766","(۵۷۶۶) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ إِسْحَاقَ بْنِ سُوَیْد ، عَنْ یَحْیَی بْنِ یَعْمَُرَ ؛ فِی الْعِیدَیْنِ ، فِی إِحْدَاہُمَا تِسْعُ تَکْبِیرَاتٍ ، وَفِی الآخِرَۃِ إِحْدَی عَشْرَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5766","","","كتاب الجمعة"
"5767","(۵۷۶۷) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنِ الإِفْرِیقِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ رَافِعٍ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ کَانَ یُکَبِّرُ فِی الْعِیدَیْنِ ثِنْتَیْ عَشْرَۃَ ؛ سَبْعًا فِی الأُولَی ، وَخَمْسًا فِی الآخِرَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 5767","","","كتاب الجمعة"
"5768","(۵۷۶۸) حَدَّثَنَا عُمَرُ بْنُ ہَارُونَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُمَرَ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یُکَبِّرُ فِی الْعِیدِ سَبْعًا وَخَمْسًا ؛ سَبْعًا فِی الأُولَی ، وَخَمْسًا فِی الآخِرَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5768","","","كتاب الجمعة"
"5769","(۵۷۶۹) حَدَّثَنَا خَالِدُ بْنُ مَخْلَد ، قَالَ : حَدَّثَنَا إِبْرَاہِیمُ بْنُ إِسْمَاعِیلَ بْنِ أَبِی حَبِیبَۃَ ، قَالَ : أَخْبَرَنَا دَاودُ بْنُ الْحُصَیْنِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : التَّکْبِیرُ فِی الْعِیدَیْنِ سَبْعٌ وَخَمْسٌ ؛ سَبْعٌ فِی الأُولَی قَبْلَ الْقِرَائَۃِ ، وَخَمْسٌ فِی الآخِرَۃِ قَبْلَ الْقِرَائَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 5769","","","كتاب الجمعة"
"5770","(۵۷۷۰) حَدَّثَنَا خَالِدُ بْنُ مَخْلَد ، قَالَ : حدَّثَنَا نَافِعُ بْنُ أَبِی نُعَیْمٍ ، قَالَ : سَمِعْتُ نَافِعًا ، قَالَ : قَالَ عَبْدُ اللہِ بْنُ عُمَرَ: التَّکْبِیرُ فِی الْعِیدَیْنِ سَبْعٌ وَخَمْسٌ۔","Hasan","Musannaf Ibn Abi Shaybah 5770","","","كتاب الجمعة"
"5771","(۵۷۷۱) حَدَّثَنَا خَالِدُ بْنُ مَخْلَد ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ ہِلاَلٍ ، قَالَ : سَمِعْتُ سَالِمَ بْنَ عَبْدِ اللہِ ، وَعُبَیْدَ اللہِ بْنَ عَبْدِ اللہِ یَأْمُرَانِ عَبْدَ الرَّحْمَن بْنَ الضَّحَّاکِ یَوْمَ الْفِطْرِ ، وَکَانَ عَلَی الْمَدِینَۃِ : أَنْ یُکَبِّرَ فِی أَوَّلِ رَکْعَۃٍ سَبْعًا ، ثُمَّ یَقْرَأَ بِـ : {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} وَفِی الآخِرَۃِ خَمْسًا ، ثُمَّ یَقْرَأَ : {اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ}۔","No Data Available","Musannaf Ibn Abi Shaybah 5771","","","كتاب الجمعة"
"5772","(۵۷۷۲) حَدَّثَنَا خَالِدُ بْنُ مَخْلَد ، قَالَ : حدَّثَنَا ثَابِتُ بْنُ قَیْسٍ ، قَالَ : صَلَّیْتُ خَلْفَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ الْفِطْرَ ، فَکَبَّرَ فِی الأُولَی سَبْعًا قَبْلَ الْقِرَائَۃِ ، وَفِی الثَّانِیَۃِ خَمْسًا قَبْلَ الْقِرَائَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5772","","","كتاب الجمعة"
"5773","(۵۷۷۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حُمَیْدٌ ، عَنْ عَمَّارِ بْنِ أَبِی عَمَّارٍ ؛ أَنَّ ابْنَ عَبَّاسٍ کَبَّرَ فِی عِیدٍ ثِنْتَیْ عَشْرَۃَ تَکْبِیرَۃً ؛ سَبْعًا فِی الأُولَی ، وَخَمْسًا فِی الآخِرَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 5773","","","كتاب الجمعة"
"5774","(۵۷۷۴) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا أَبُو کُدَیْنَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، وَالْمُسَیَّبِ ، قَالاَ : الصَّلاَۃُ یَوْمَ الْعِیدَیْنِ تِسْعُ تَکْبِیرَاتٍ ؛ خَمْسٌ فِی الأُولَی ، وَأَرْبَعٌ فِی الآخِرَۃِ ، لَیْسَ بَیْنَ الْقِرَائَتَیْنِ تَکْبِیرَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5774","","","كتاب الجمعة"
"5775","(۵۷۷۵) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، قَالَ : حدَّثَنَا ضَمْرَۃُ بْنُ سَعِیدٍ ، قَالَ : سَمِعْتُ عُبَیْدَ اللہِ بْنَ عَبْدِ اللہِ بْنِ عَُتبۃَ ، یَقُولُ : خَرَجَ عُمَرُ یَوْمَ عِیدٍ ، فَسَأَلَ أَبا وَاقِدٍ اللَّیْثِیَّ : بِأَ??ِّ شَیْئٍ قَرَأَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی ہَذَا الْیَوْمِ ؟ قَالَ : بِـ : (ق) ، وَ(اقْتَرَبَت)۔ (ترمذی ۵۳۵۔ ابن ماجہ ۱۲۸۲)","Sahih","Musannaf Ibn Abi Shaybah 5775","","","كتاب الجمعة"
"5776","(۵۷۷۶) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ إِبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، عَنْ أَبِیہِ ، عَنْ حَبِیبِ بْنِ سَالِمْ ، عَنِ النُّعْمَانِ بْنِ بَشِیرٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقْرَأُ فِی الْعِیدَیْنِ وَالْجُمُعَۃِ : {ہَلْ أَتَاک حَدِیثُ الْغَاشِیَۃِ} ، وَ{سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} وَإِذَا اجْتَمَعَ الْعِیدَانِ فِی یَوْمٍ قَرَأَ بِہِمَا فِیہِمَا۔","Sahih","Musannaf Ibn Abi Shaybah 5776","","","كتاب الجمعة"
"5777","(۵۷۷۷) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ سُفْیَانَ ، عَنْ مَعْبَدِ بْنِ خَالِدٍ ، عَنْ زَیْدِ بْنِ عُقْبَۃَ ، عَنْ سَمُرَۃََ بْنِ جُنْدُبٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقْرَأُ فِی الْعِیدَیْنِ بِـ : {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} وَ{ہَلْ أَتَاک حَدِیثُ الْغَاشِیَۃِ}۔ (احمد ۵/۱۴۔ طبرانی ۶۷۷۳)","Sahih","Musannaf Ibn Abi Shaybah 5777","","","كتاب الجمعة"
"5778","(۵۷۷۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ مَعْبَد بْنِ خَالِدٍ ، عَنْ زَید بْنِ عُقْبَۃَ ، عَنْ سَمُرَۃََ بْنِ جُنْدُبٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقْرَأُ فِی الْعِیدَیْنِ ، فَذَکَرَ مِثْلَہُ۔ (طبرانی ۶۷۷۸)","Hasan","Musannaf Ibn Abi Shaybah 5778","","","كتاب الجمعة"
"5779","(۵۷۷۹) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابن طَاوُوسٍ ، عَنْ أَبِیہِ (ح) وَعَنْ إِبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ طَاوُوسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَأَ فِی الْعِیدِ ۔ قَالَ أَحَدُہُمَا : بِـ : (اقْتَرَبَتْ) ، وَقَالَ الآخَرُ : بِـ : (ق)۔","","Musannaf Ibn Abi Shaybah 5779","","","كتاب الجمعة"
"5780","(۵۷۸۰) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ؛ أَنَّ أَبَا بَکْرٍ قَرَأَ فِی یَوْمِ عِیدٍ بِالْبَقَرَۃِ ، حَتَّی رَأَیْتُ الشَّیْخَ یَمِیدُ مِنْ طُولِ الْقِیَامِ۔","Sahih","Musannaf Ibn Abi Shaybah 5780","","","كتاب الجمعة"
"5781","(۵۷۸۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ : حدِّثْتُ عَنْ عُمَرَ ؛ أَنَّہُ کَانَ یَقْرَأُ فِی الْعِیدِ بِـ : {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} ، وَ{ہَلْ أَتَاک حَدِیثُ الْغَاشِیَۃِ}۔","Da'if","Musannaf Ibn Abi Shaybah 5781","","","كتاب الجمعة"
"5782","(۵۷۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقْرَأُ فِی الْعِیدِ بِـ : {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} ، وَ{ہَلْ أَتَاک حَدِیثُ الْغَاشِیَۃِ}۔ (ابن ماجہ ۱۲۸۳۔ عبدالرزاق ۵۷۰۵)","Da'if","Musannaf Ibn Abi Shaybah 5782","","","كتاب الجمعة"
"5783","(۵۷۸۳) حَدَّثَنَا ہُشَیْمٌ ، وَابْنُ إِدْرِیسَ ، عَنْ أَشْعَثَ ، عَنْ کُرْدُوسٍ ، عَنْ عَبْدِ اللہِ ؛ أَنَّ الْوَلِیدَ بْنَ عُقْبَۃَ أَرْسَلَ إِلَیْہِ، فَقَالَ : تَقْرَأُ بِأُمِّ الْکِتَابِ ، وَسُورَۃٍ مِنَ الْمُفَصَّلِ۔ زَادَ فِیہِ ہُشَیْمٌ : لَیْسَ مِنْ قِصَارِہَا ، وَلاَ مِنْ طِوَالِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 5783","","","كتاب الجمعة"
"5784","(۵۷۸۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا عُمَارَۃُ الصَّیْدَلاَنِیُّ ، عَنْ مَوْلًی لأَنَسٍ قَدْ سَمَّاہُ ، قَالَ : انْتَہَیْتُ مَعَ أَنَسٍ یَوْمَ الْعِیدِ ، حَتَّی انْتَہَیْنَا إِلَی الزَّاوِیَۃِ ، فَإِذَا مَوْلًی لَہُ یَقْرَأُ فِی الْعِیدِ بِـ : {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} ، وَ{ہَلْ أَتَاک حَدِیثُ الْغَاشِیَۃِ} ، فَقَالَ أَنَسٌ : إِنَّہُمَا لَلسُّورَتَانِ اللَّتَانِ قَرَأَ بِہِمَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (ابوداؤد ۲۰۴۶)","Da'if","Musannaf Ibn Abi Shaybah 5784","","","كتاب الجمعة"
"5785","(۵۷۸۵) حَدَّثَنَا وَکِیعٌ ، وابْنُ إِدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : خَرَجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ عِیدٍ ، فَصَلَّی بِالنَّاسِ ، فَلَمْ یُصَلِّ قَبْلَہَا ، وَلاَ بَعْدَہَا۔ (بخاری ۹۸۹۔ ابوداؤد ۱۱۵۲)","Sahih","Musannaf Ibn Abi Shaybah 5785","","","كتاب الجمعة"
"5786","(۵۷۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبَانَ بْنِ عَبْدِ اللہِ الْبَجَلِیِّ ، عَنْ أَبِی بَکْرِ بْنِ حَفْصٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ خَرَجَ یَوْمَ عِیدٍ فَلَمْ یُصَلِّ قَبْلَہَا ، وَلاَ بَعْدَہَا ، وَذَکَرَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَعَلَہُ۔ (ترمذی ۵۳۸)","Hasan","Musannaf Ibn Abi Shaybah 5786","","","كتاب الجمعة"
"5787","(۵۷۸۷) حَدَّثَنَا ابْنُ إِدْرِیسَ ، وَابْنُ عَبَّادٍ ، عَنْ لَیْثٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : رَأَیْتُ ابْنَ أَبِی أَوْفَی ، وَابْنَ عُمَرَ ، وَجَابِرَ بْنَ عَبْدِ اللہِ ، وَشُرَیْحًا ، وَابْنَ مَعْقِلٍ ، لاَ یُصَلُّونَ قَبْلَ الْعِیدِ ، وَلاَ بَعْدَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 5787","","","كتاب الجمعة"
"5788","(۵۷۸۸) حَدَّثَنَا ہُشَیْمُ ، عَنُ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : کُنْتُ مَعَہُ جَالِسًا فِی الْمَسْجِدِ الْحَرَامِ یَوْمَ الْفِطْرِ ، فَقَامَ عَطَائٌ یُصَلِّی قَبْلَ خُرُوجِ الإِمَامِ ، فَأَرْسَلَ إِلَیْہِ سَعِیدٌ : أَنِ اجْلِسْ ، فَجَلَسَ عَطَائٌ ۔ قَالَ : فَقُلْتُ لِسَعِیدٍ : عَمَّنْ ہَذَا یَا أَبَا عَبْدِ اللہِ ؟ فَقَالَ : عَنْ حُذَیْفَۃَ وَأَصْحَابِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5788","","","كتاب الجمعة"
"5789","(۵۷۸۹) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ إِسْمَاعِیلَ بْنِ سُمَیْعٍ ، عَنْ عَلِیِّ بْنِ أَبِی کَثِیرٍ ؛ أَنَّ أَبَا مَسْعُودٍ ألأَنْصَارِیَّ کَانَ إِذَا کَانَ یَوْمَ أَضْحَی ، أَوْ یَوْمَ فِطْرٍ طَافَ فِی الصُّفُوفِ ، فَقَالَ : لاَ صَلاَۃَ إِلاَّ مَعَ الإِمَام۔","Sahih","Musannaf Ibn Abi Shaybah 5789","","","كتاب الجمعة"
"5790","(۵۷۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنِ الأَسْوَدِ بْنِ ہِلاَلٍ ، عَنْ ثَعْلَبَۃَ بْنِ زَہْدَمٍ الْحَنْظَلِیِّ؛ أَنَّ أَبَا مَسْعُودٍ الأَنْصَارِیَّ قَامَ فِی یَوْمِ عِیدٍ، فَقَالَ: إِنَّہُ لاَ صَلاَۃَ فِی ہَذَا الْیَوْمِ حَتَّی یَخْرُجَ الإِمَامُ۔","Sahih","Musannaf Ibn Abi Shaybah 5790","","","كتاب الجمعة"
"5791","(۵۷۹۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ لاَ یُصَلِّی قَبْلَ الْعِیدِ ، وَلاَ بَعْدَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 5791","","","كتاب الجمعة"
"5792","(۵۷۹۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : کُنْتُ بَیْنَ مَسْرُوقٍ وَشُرَیْحٍ فِی یَوْمِ عِیدٍ ، فَلَمْ یُصَلِّیَا قَبْلَہَا ، وَلاَ بَعْدَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5792","","","كتاب الجمعة"
"5793","(۵۷۹۳) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ لاَ یُصَلِّی قَبْلَ الْعِیدِ ، وَلاَ بَعْدَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5793","","","كتاب الجمعة"
"5794","(۵۷۹۴) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ إِسْمَاعِیلَ ، قَالَ : رَأَی الشَّعْبِیُّ إِنْسَانًا یُصَلِّی بَعْدَ مَا انْصَرَفَ الإِمَامُ ، فَجَبَذَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5794","","","كتاب الجمعة"
"5795","(۵۷۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سَلَمَۃَ ، عَنِ الضَّحَّاکِ ، قَالَ : لاَ صَلاَۃَ قَبْلَہَا ، وَلاَ بَعْدَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5795","","","كتاب الجمعة"
"5796","(۵۷۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ کَانَ لاَ یُصَلِّی قَبْلَہَا ، وَلاَ بَعْدَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5796","","","كتاب الجمعة"
"5797","(۵۷۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ ، عَنْ أَبِی عُمَر ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، قَالَ : لاَ صَلاۃَ قَبْلَہَا ، وَلاَ بَعْدَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5797","","","كتاب الجمعة"
"5798","(۵۷۹۸) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا إِسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ عَبْدِ اللہِ الأَصَمِّ ؛ أَنَّہُ خَرَجَ مَعَ مَسْرُوقٍ فِی یَوْمِ عِیدٍ ، فَقُمْتُ أُصَلِّی ، فَأَخَذَ بِثِیَابِی فَأَجْلَسَنِی ، ثُمَّ قَالَ : لاَ صَلاَۃَ حَتَّی یُصَلِّیَ الإِمَامُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5798","","","كتاب الجمعة"
"5799","(۵۷۹۹) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : کَانَ سَعِیدُ بْنُ جُبَیْرٍ ، وَإِبْرَاہِیمُ ، وَعَلْقَمَۃُ یُصَلُّونَ بَعْدَ الْعِیدِ أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5799","","","كتاب الجمعة"
"5800","(۵۸۰۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، قَالَ : رَأَیْتُ إِبْرَاہِیمَ ، وَسَعِیدَ بْنَ جُبَیْرٍ ، وَمُجَاہِدًا، وَعَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، یُصَلُّونَ بَعْدَہَا أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5800","","","كتاب الجمعة"
"5801","(۵۸۰۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ عَلْقَمَۃُ یَجِیئُ یَوْمَ الْعِیدِ ، فَیَجْلِسُ فِی الْمُصَلَّی ، وَلاَ یُصَلِّی حَتَّی یُصَلِّیَ الإِمَامُ ، فَإِذَا صَلَّی الإِمَامُ ، قَامَ فَصَلَّی أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5801","","","كتاب الجمعة"
"5802","(۵۸۰۲) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ صَالِحِ بْنِ حَیٍّ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَمِعْتُہُ یَقُولُ : کَانَ عَبْدُ اللہِ إِذَا رَجَعَ یَوْمَ الْعِیدِ ، صَلَّی فِی أَہْلِہِ أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5802","","","كتاب الجمعة"
"5803","(۵۸۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی صَخْرَۃَ ، عَنِ الأَسْوَدِ بْنِ ہِلاَلٍ ، قَالَ : خَرَجْتُ مَعَ عَلِیٍّ ، فَلَمَّا صَلَّی الإِمَامُ ، قَامَ فَصَلَّی بَعْدَہَا أَرْبَعًا۔","Sahih","Musannaf Ibn Abi Shaybah 5803","","","كتاب الجمعة"
"5804","(۵۸۰۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، وَأَصْحَابِ عَبْدِ اللہِ ؛ أَنَّہُمْ کَانُوا یُصَلُّونَ بَعْدَ الْعِیدِ أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5804","","","كتاب الجمعة"
"5805","(۵۸۰۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یُصَلُّونَ بَعْدَ الْعِیدِ أَرْبَعًا ، وَلاَ یُصَلُّونَ قَبْلَہَا شَیْئًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5805","","","كتاب الجمعة"
"5806","(۵۸۰۶) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَاصِمٍ ، قَالَ : رَأَیْتُ الْحَسَنَ ، وَابْنَ سِیرِینَ یُصَلِّیَانِ بَعْدَ الْعِیدِ ، وَیُطِیلاَنِ الْقِیَامَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5806","","","كتاب الجمعة"
"5807","(۵۸۰۷) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حدَّثَنَا الْمُغِیرَۃُ بْنُ مُسْلِمٍ ، عَنْ عَبْدِ اللہِ بْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یُصَلِّی یَوْمَ الْعِیدِ قَبْلَ الصَّلاَۃ أَرْبَعًا ، وَبَعْدَہَا أَرْبَعًا۔","Hasan","Musannaf Ibn Abi Shaybah 5807","","","كتاب الجمعة"
"5808","(۵۸۰۸) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ الأَسْوَدُ یُصَلِّی قَبْلَ الْعِیدَیْنِ ۔ قَالَ : وَکَانَ عَلْقَمَۃُ لاَ یُصَلِّی قَبْلَہَا ، وَیُصَلِّی بَعْدَہَا أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5808","","","كتاب الجمعة"
"5809","(۵۸۰۹) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَفَاک بِقَوْلِ عَبْدِ اللہِ ، یَعْنِی فِی الصَّلاَۃ بَعْدَ الْعِیدِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5809","","","كتاب الجمعة"
"5810","(۵۸۱۰) حَدَّثَنَا إِسْمَاعِیلُ ابْنُ عُلَیَّۃَ، عَنْ أَیُّوبَ، قَالَ: رَأَیْتُ أَنَسَ بْنَ مَالِکٍ وَالْحَسَنَ یُصَلِّیَانِ قَبْلَ خُرُوجِ الإِمَامِ۔ یَعْنِی یَوْمَ الْعِیدِ۔","Sahih","Musannaf Ibn Abi Shaybah 5810","","","كتاب الجمعة"
"5811","(۵۸۱۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ؛ أَنَّ أَبَا بَرْزَۃَ کَانَ یُصَلِّی فِی الْعِیدِ قَبْلَ الإِمَامِ۔","Sahih","Musannaf Ibn Abi Shaybah 5811","","","كتاب الجمعة"
"5812","(۵۸۱۲) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ التَّیْمِیِّ ؛ أَنَّہُ رَأَی أَنَسًا ، وَالْحَسَنَ ، وَسَعِیدَ بْنَ أَبِی الْحَسَنِ ، وَجَابِرَ بْنَ زَیْدٍ ، یُصَلُّونَ قَبْلَ الإمَامِ فِی الْعیِدیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 5812","","","كتاب الجمعة"
"5813","(۵۸۱۳) حَدَّثَنَا مُعَاذٌ ، عَنِ التَّیْمِیِّ ، عَنْ عَبْدِ اللہِ الدَّانَاجِ ، قَالَ : رَأَیْتُ أَبَا بَرْزَۃَ یَفْعَلُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 5813","","","كتاب الجمعة"
"5814","(۵۸۱۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ أَنَّہُ کَانَ یُصَلِّی یَوْمَ الْفِطْرِ وَالنَّحْرِ قَبْلَ خُرُوجِ الإِمَامِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5814","","","كتاب الجمعة"
"5815","(۵۸۱۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنِ الأَسْوَدِ ؛ أَنَّہُ کَانَ یُصَلِّی یَوْمَ الْعِیدِ قَبْلَ خُرُوجِ الإِمَامِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5815","","","كتاب الجمعة"
"5816","(۵۸۱۶) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ التَّیْمِیِّ ، عَنِ الأَزْرَقِ بْنِ قَیْسٍ ، عَنْ رَجُلٍ ، قَالَ : رَأَیْتُ رِجَالاً مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَاؤُوا یَوْمَ عِیدٍ ، فَصَلَّوْا قَبْلَ الإِمَامِ۔","Da'if","Musannaf Ibn Abi Shaybah 5816","","","كتاب الجمعة"
"5817","(۵۸۱۷) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنِ الْجُرَیرِیِّ، عَنْ خَالِدٍ الأَحْدَبِ، عَنْ عَمِّہِ صَفْوَانَ بْنَ مُحْرِزٍ، قَالَ: کَانَتْ صَلاَۃُ صَفْوَانَ یَوْمَ الْفِطْرِ وَالنَّحْرِ عَشْرَ رَکَعَاتٍ قَبْلَ خُرُوجِ الإِمَام ، وَرَکْعَتَیْنِ مَعَ الإِمَامِ ، وَرَکْعَتَیْنِ بَعْدَ الإِمَامِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5817","","","كتاب الجمعة"
"5818","(۵۸۱۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ التَّیْمِیِّ ، قَالَ : رَأَیْتُ أَنَسًا ، وَالْحَسَنَ ، وَسَعِیدَ بْنَ أَبِی الْحَسَنِ ، یُصَلُّونَ یَوْمَ الْعِیدِ قَبْلَ الإِمَامِ۔","Hasan","Musannaf Ibn Abi Shaybah 5818","","","كتاب الجمعة"
"5819","(۵۸۱۹) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ إِذَا قَرَأَ فِی الْعِیدَیْنِ أَسْمَعَ مَنْ یَلِیہِ ، وَلاَ یَجْہَرُ ذَلِکَ الْجَہْرَ۔","Da'if","Musannaf Ibn Abi Shaybah 5819","","","كتاب الجمعة"
"5820","(۵۸۲۰) حَدَّثَنَا عُمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یُرْفَعُ الصَّوْتُ بِالْقِرَائَۃِ فِی الْجُمُعَۃِ وَالْعِیدَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5820","","","كتاب الجمعة"
"5821","(۵۸۲۱) حَدَّثَنَا جَرِیرٌ ، وَابْنُ إِدْرِیسَ ، عَنْ یَزِیدَ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : الْغُسْلُ یَوْمَ الأَضْحَی وَیَوْمَ الْفِطْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5821","","","كتاب الجمعة"
"5822","(۵۸۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ زَاذَانَ ؛ أَنَّ رَجُلاً سَأَلَ عَلِیًّا عَنِ الْغُسْلِ ؟ فَقَالَ : الْغُسْلُ یَوْمَ الأَضْحَی وَیَوْمَ الْفِطْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 5822","","","كتاب الجمعة"
"5823","(۵۸۲۳) حَدَّثَنَا عَبْدُاللہِ بْنُ نُمَیْرٍ، قَالَ: حدَّثَنَا عُبَیْدُاللہِ بْنُ عُمَرَ، عَنْ نَافِعٍ، عَنِ ابْنَ عُمَرَ؛ أَنَّہُ کَانَ یَغْتَسِلُ لِلْعِیدَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 5823","","","كتاب الجمعة"
"5824","(۵۸۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ سِنَانٍ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : اغْتَسَلَ فِی الْعِیدَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 5824","","","كتاب الجمعة"
"5825","(۵۸۲۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَغْتَسِلُ فِی الْعِیدَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 5825","","","كتاب الجمعة"
