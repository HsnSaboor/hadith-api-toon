hadiths[13]{hadithnumber,text}:
"464","Abu'd-Darda' reported that the Prophet"
"465","'A'isha reported that the Prophet"
"466","Anas reported that the Prophet"
"467","Abu Sa'id al-Khudri said"
"468","Ibn 'Abbas reported that the Prophet"
"469","'A'isha"
"470","Sa'id al-Maqburi reported from his father that the Messenger of\nAllah"
"471","Kathir ibn 'Ubayd said"
"472","'Abdullah ibn Mughaffal reported that the Prophet"
"473","Anas ibn Malik reported that the Prophet"
"474","'Abdullah ibn 'Amr said"
"475","'A'isha said"
"476","Abu Nadra said"
