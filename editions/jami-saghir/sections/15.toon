hadiths[22]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3883","«ضالة المسلم حرق النار»","صحيح","Sahih al-Jami al-Saghir 3883","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
"3884","«ضحوا بالجذع من الضأن فإنه جائز»","صحيح","Sahih al-Jami al-Saghir 3884","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
"3885","«ضحك الله من رجلين قتل أحدهما صاحبه وكلاهما في الجنة»","صحيح","Sahih al-Jami al-Saghir 3885","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
"3886","«ضحكت من قوم يساقون إلى الجنة مقرنين في السلاسل»","صحيح","Sahih al-Jami al-Saghir 3886","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
"3887","""ضرب الله تعالى مثلا صراطا مستقيما وعلى جنبتي الصراط سوران فيهما أبواب مفتحة وعلى الأبواب ستور مرخاة وعلى باب الصراط داع يقول: يا أيها الناس! ادخلوا الصراط جميعا ولا تتعوجوا وداع يدعومن فوق الصراط فإذا أراد الإنسان أن يفتح شيئا من تلك الأبواب قال: ويحك لا تفتحه فإنك إن تفتحه تلجه فالصراط الإسلام والسوران حدود الله تعالى والأبواب المفتحة محارم الله تعالى وذلك الداعي على رأس الصراط كتاب الله والداعي من فوق واعظ الله في قلب كل مسلم""","صحيح","Sahih al-Jami al-Saghir 3887","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
"3888","«ضرس الكافر مثل أحد وغلظ جلده أربعون ذراعا بذراع الجبار»","صحيح","Sahih al-Jami al-Saghir 3888","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
"3889","«ضرس الكافر مثل أحد وغلظ جلده مسيرة ثلاث»","صحيح","Sahih al-Jami al-Saghir 3889","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
"3890","«ضرس الكافر يوم القيامة مثل أحد وعرض جلده سبعون ذراعا وعضده مثل البيضاء وفخذه مثل ورقان ومقعده في النار ما بيني وبين الربذة»","صحيح","Sahih al-Jami al-Saghir 3890","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
"3891","«ضرس الكافر يوم القيامة مثل أحد وفخذه مثل البيضاء ومقعده في النار مسيرة ثلاث مثل الربذة»","صحيح","Sahih al-Jami al-Saghir 3891","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
"3892","«ضع أنفك ليسجد معك»","صحيح","Sahih al-Jami al-Saghir 3892","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
"3893","«ضع يدك على الذي تألم من جسدك وقل: بسم الله ثلاثا وقل سبع مرات: أعوذ بالله وقدرته من شر ما أجد وأحاذر»","صحيح","Sahih al-Jami al-Saghir 3893","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
"3894","«ضع يمينك على المكان الذي تشتكي فامسح بها سبع مرات وقل: أعوذ بعزة الله وقدرته من شر ما أجد في كل مسحة»","صحيح","Sahih al-Jami al-Saghir 3894","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
"3895","«ضعي في يد المسكين ولو ظلفا محرقا»","صحيح","Sahih al-Jami al-Saghir 3895","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
"3896","«ضوال المسلم حرق النار»","صحيح","Sahih al-Jami al-Saghir 3896","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
"3897","«الضالة واللقطة تجدها فانشدها ولا تكتم ولا تغيب فإن وجدت ربها فأدها وإلا فإنما هو مال الله يؤتيه من يشاء»","صحيح","Sahih al-Jami al-Saghir 3897","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
"3898","«الضب لست آكله ولا أحرمه»","صحيح","Sahih al-Jami al-Saghir 3898","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
"3899","«الضبع صيد فكلها وفيها كبش مسن إذا أصابها المحرم»","صحيح","Sahih al-Jami al-Saghir 3899","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
"3900","«الضبع صيد وفيه كبش»","صحيح","Sahih al-Jami al-Saghir 3900","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
"3901","«الضيافة ثلاثة أيام فما زاد فهو صدقة»","صحيح","Sahih al-Jami al-Saghir 3901","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
"3902","«الضيافة ثلاثة أيام فما زاد فهو صدقة وكل معروف صدقة»","صحيح","Sahih al-Jami al-Saghir 3902","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
"3903","«الضيافة ثلاثة أيام فما كان فوق ذلك فهو معروف»","صحيح","Sahih al-Jami al-Saghir 3903","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
"3904","«الضيافة ثلاثة أيام فما كان وراء ذلك فهو صدقة»","صحيح","Sahih al-Jami al-Saghir 3904","","","الأحاديث المبدوءة بحرف الضاد Hadith Beginning with the Letter Dad (ض)"
