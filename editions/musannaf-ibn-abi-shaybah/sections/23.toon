hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"22045","(۲۲۰۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ عُمَرَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللہِ الْغَافِقِیِّ وَأَبِی طُعْمَۃَ مَوْلاَہُمْ ، سَمِعَا ابْنَ عُمَرَ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لُعِنَتِ الْخَمْرۃ عَلَی عَشَرَۃِ وُجُوہٍ : لُعِنَتِ الْخَمْرُ بِعَیْنِہَا ، وَعَاصِرِہَا ، وَمُعْتَصِرِہَا ، وَبَائِعِہَا ، وَمُبْتَاعِہَا ، وَحَامِلِہَا وَالْمَحْمُولَۃِ إلَیْہِ ، وَآکِلِ ثَمَنِہَا ، وَشَارِبِہَا ، وَسَاقِیہَا۔ (ابوداؤد ۳۶۶۶۔ احمد ۲۵)","Hasan","Musannaf Ibn Abi Shaybah 22045","","","كتاب البيوع والأقضية"
"22046","(۲۲۰۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ عِمْرَانَ بْنِ أَبِی الْجَعْدِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : سَمِعْتُہُ یَقُولُ : لاَ یَصْلُحُ بَیْعُ الْخَمْرِ ، وَلاَ شُرْبُہَا۔","Da'if","Musannaf Ibn Abi Shaybah 22046","","","كتاب البيوع والأقضية"
"22047","(۲۲۰۴۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، أَنَّ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی یَوْمَ الْفَتْحِ عَنْ بَیْعِ الْخَمْرِ وَالأَصْنَامِ۔","Sahih","Musannaf Ibn Abi Shaybah 22047","","","كتاب البيوع والأقضية"
"22048","(۲۲۰۴۸) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ جَہْمٍ ، قَالَ : سَأَلَ رَجُلٌ عَطَائً ، قَالَ : وَرِثْت غَرْسًا ، قَالَ : بِعْہُ عِنَبًا ، قَالَ: فَإِنْ لَمْ أَجِدْ أَحَدًا یَشْتَرِیہِ ؟ قَالَ : فَبِعْہُ عَصِیرًا ، قَالَ : فَإِنْ لَمْ أَجِدْ أَحَدًا یَشْتَرِیہِ ؟ قَالَ : فَلاَ تَبِعِ الْخَمْرَ فَإِنَّہُ لاَ یَحِلُّ بَیْعُ الْخَمْرِ۔","","Musannaf Ibn Abi Shaybah 22048","","","كتاب البيوع والأقضية"
"22049","(۲۲۰۴۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، قَالَ : حدَّثَنِی أَبِی ، قَالَ : وَجَدْت عَشْرَۃَ دَنَانِیرَ ، فَأَتَیْت ابْنَ عَبَّاسٍ فَسَأَلْتُہُ عَنْہَا ، فَقَالَ : عَرِّفْہَا عَلَی الْحَجَرِ سَنَۃً ، فَإِنْ لَمْ تُعْرَفْ فَتَصَدَّقْ بِہَا ، فَإِذَا جَائَ صَاحِبُہَا فَخَیِّرْہُ الأَجْرَ ، أَوِ الْغُرْمَ۔","Hasan","Musannaf Ibn Abi Shaybah 22049","","","كتاب البيوع والأقضية"
"22050","(۲۲۰۵۰) حَدَّثَنَا شَرِیکٌ ، عَنْ عَامِرِ بْنِ شَقِیقٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : اشْتَرَی عَبْدُ اللہِ جَارِیَۃً بِسَبْعِمِئَۃِ دِرْہَمٍ ، فَغَابَ صَاحِبُہَا ، فَأَنْشَدَہُ حَوْلاً ، أَوْ قَالَ : سَنَۃً ، ثُمَّ خَرَجَ إلَی الْمَسْجِدِ فَجَعَلَ یَتَصَدَّقُ وَیَقُولُ : اللَّہُمَّ فَلَہُ ، فَإِنْ أَبَی فَعَلَیَّ ، ثُمَّ قَالَ : ہَکَذَا افْعَلُوا بِاللُّقَطَۃِ ، أَوْ بِالضَّالَّۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 22050","","","كتاب البيوع والأقضية"
"22051","(۲۲۰۵۱) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : سَمِعْتُ رَجُلاً مِنْ مُزَیْنَۃَ یَسْأَلُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : مَا نَجِدُ فِی السَّبِیلِ الْعَامِرَۃِ مِنَ اللُّقَطَۃِ ؟ فَقَالَ : عَرِّفْہَا حَوْلاً ، فَإِنْ جَائَ صَاحِبُہَا وَإِلاَّ فَہِیَ لَک۔ (ابوداؤد ۱۷۰۷۔ احمد ۱۸۰)","","Musannaf Ibn Abi Shaybah 22051","","","كتاب البيوع والأقضية"
"22052","(۲۲۰۵۲) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ شُرَیْحٍ ، قَالَ : حدَّثَنِی أَبُو قَبِیلٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، أَنَّ رَجُلاً ، قَالَ : الْتَقَطْت دِینَارًا فَقَالَ : لاَ یُؤوِی الضَّالَّۃَ إلاَّ ضَالٌّ ، قَالَ : فَأَہْوَی بِہِ الرَّجُلُ لِیَرْمِیَ بِہِ فَقَالَ : لاَ تَفْعَلْ ، قَالَ : فَمَا أَصْنَعُ بِہِ ؟ قَالَ : تُعَرِّفُہُ فَإِنْ جَائَ صَاحِبُہُ فَرُدَّہُ إلَیْہِ وَإِلاَّ فَتَصَدَّقْ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 22052","","","كتاب البيوع والأقضية"
"22053","(۲۲۰۵۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ وَسُفْیَانُ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، قَالَ : سُئِلَ ابْنُ عُمَرَ ، عَنِ اللُّقَطَۃِ فَقَالَ : ادْفَعْہَا إلَی الأَمِیرِ۔","Sahih","Musannaf Ibn Abi Shaybah 22053","","","كتاب البيوع والأقضية"
"22054","(۲۲۰۵۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی السَّفَرِ ، عَنْ رَجُلٍ مِنْ بَنِی رُؤَاسٍ ، قَالَ: الْتَقَطْت ثَلاَثَ مِئَۃِ دِرْہَمٍ فَعَرَّفْتہَا تَعْرِیفًا ضَعِیفًا وَأَنَا یَوْمَئِذٍ مُحْتَاجٌ فَأَکَلْتہَا حِینَ لَمْ أَجِدْ أَحَدًا یَعْرِفُہَا ، ثُمَّ أَیْسَرْت فَسَأَلْت عَلِیًّا فَقَالَ : عَرِّفْہَا سَنَۃً ، فَإِنْ جَائَ صَاحِبُہَا فَادْفَعْہَا إلَیْہِ وَإِلاَّ فَتَصَدَّقْ بِہَا وَإِلاَّ فَخَیِّرْہُ بَیْنَ الأَجْرِ وَبَیْنَ أَنْ تَغْرَمَہَا لَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 22054","","","كتاب البيوع والأقضية"
"22055","(۲۲۰۵۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، قَالَ : سمِعْت ہَذَا الْحَدِیثَ مِنْ أَبِی السَّفَرِ ، عَنْ رَجُلٍ مِنْ بَنِی رُؤَاسٍ ، عَنْ عَلِیٍّ ، مِثْلَہُ إلأَأَنَّہُ لَمْ یَقُلْ : عَرِّفْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 22055","","","كتاب البيوع والأقضية"
"22056","(۲۲۰۵۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَنْ سُوَیْد ، قَالَ : کَانَ عُمَرُ بْنُ الْخَطَّابِ یَأْمُرُ أَنْ تُعَرَّفَ اللُّقَطَۃُ سَنَۃً ، فَإِنْ جَائَ صَاحِبُہَا وَإِلاَّ یتصدق بِہَا ، فَإِنْ جَائَ صَاحِبُہَا خُیِّرَ۔","Sahih","Musannaf Ibn Abi Shaybah 22056","","","كتاب البيوع والأقضية"
"22057","(۲۲۰۵۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَسْوَدُ بْنُ شَیْبَانَ ، عَنْ أَبِی نَوْفَلِ بْنِ أَبِی عَقْرَبٍ ، عَنْ أَبِیہِ ، قَالَ : الْتَقَطْت بَدْرۃً فَأَتَیْت بِہَا عُمَرَ بْنَ الْخَطَّابِ ، فَقُلْتُ : یَا أَمِیرَ الْمُؤْمِنِینَ : أَغْنِہَا عَنِّی ، فَقَالَ : وَافِ بِہَا الْمَوْسِمَ فَوَافَیْت بِہَا الْمَوْسِمَ فَقَالَ : عَرِّفْہَا حَوْلاً ، فَعَرَّفْتہَا ، فَلَمْ أَجِدْ أَحَدًا یَعْرِفُہَا فَأَتَیْتہ ، فَقُلْتُ فَأَغْنِہَا عَنِّی فَقَالَ: أَلاَ أُخْبِرُک بِخَیْرِ سَبِیلِہَا ؟ تَصَدَّقْ بِہَا ، فَإِنْ جَائَ صَاحِبُہَا فَاخْتَارَ الْمَالَ غَرِمْت لَہُ وَکَانَ الأَجْرُ لَکَ ، وَإِنِ اخْتَارَ الأَجْرَ کَانَ الأَجْرُ لَہُ وَلَک مَا نَوَیْت۔","Sahih","Musannaf Ibn Abi Shaybah 22057","","","كتاب البيوع والأقضية"
"22058","(۲۲۰۵۸) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، قَالَ : تُعَرَّفُ اللُّقَطَۃُ سَنَۃً ، فَإِنْ لَمْ تَجِدْ لَہَا طَالِبًا فَأَعْطِہَا أَہْلَ بَیْتٍ مِنَ الْمُسْلِمِینَ فُقَرَائَ ، وقُلْ لَہُمْ : ہَذِہِ قَرْضٌ مِنْ صَاحِبِہَا عَلَیْکُمْ ، فَإِنْ جَائَ فَہُوَ أَحَقُّ بِہَا، وَإِنْ لَمْ یَجِیئْ فَہِیَ صَدَقَۃ عَلَیْکُمْ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 22058","","","كتاب البيوع والأقضية"
"22059","(۲۲۰۵۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : خَرَجْت أَنَا وَزَیْدُ بْنُ صُوحَانَ وَسَلْمَانُ بْنُ رَبِیعَۃَ حَتَّی إذَا کُنَّا بِالْعُذَیْبِ الْتَقَطْت سَوْطًا ، فَقَالاَ : لِی : أَلْقِہِ ، فَأَبَیْت ، فَلَمَّا أَتَیْتُ الْمَدِینَۃَ أَتَیْتُ أُبَیَّ بْنَ کَعْبٍ فَسَأَلْتُہُ فَقَالَ : الْتَقَطْتُ مِئَۃ دِینَارٍ عَلَی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَذَکَرْت ذَلِکَ لَہُ فَقَالَ : عَرِّفْہَا سَنَۃً ، فَإِنْ جَائَ صَاحِبُہَا فَادْفَعْہَا إلَیْہِ وَإِلاَّ فَاعْرِفْ عَدَدَہَا وَوِعَائَہَا وَوِکَائَہَا، ثُمَّ تَکُونُ کَسَبِیلِ مَالِک۔ (بخاری ۲۴۲۶۔ مسلم ۱۰)","Sahih","Musannaf Ibn Abi Shaybah 22059","","","كتاب البيوع والأقضية"
"22060","(۲۲۰۶۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ ، عَنِ اللُّقَطَۃِ فَقَالَ : عَرِّفْہَا سَنَۃً وَأَنْشِدْ ذِکْرَہَا ، فَإِنْ جَائَ مَنْ یَعْرِفُہَا فَأَعْطِہَا إیَّاہُ ، وَإِلاَّ فَتَصَدَّقْ بِہَا ، فَإِنْ جَائَ فَخَیِّرْہُ بَیْنَ الأَجْرِ وَاللُّقَطَۃِ۔","","Musannaf Ibn Abi Shaybah 22060","","","كتاب البيوع والأقضية"
"22061","(۲۲۰۶۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ قَالَ فِی اللُّقَطَۃِ: عَرِّفْہَا، لاَ آمُرُک أَنْ تَأْکُلَہَا، لَوْ شِئْت لَمْ تَأْخُذْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 22061","","","كتاب البيوع والأقضية"
"22062","(۲۲۰۶۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ مُطَرِّفٍ ، عَنْ عِیَاضِ بْنِ حِمَارٍ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ وَجَدَ لُقَطَۃً فَلْیُشْہِدْ ذَا عَدْلٍ ، أَوْ ذَوِی عَدْلٍ ، ثُمَّ لاَ یُغَیِّرُ وَلاَ یَکْتُمُ ، فَإِنْ جَائَ رَبُّہَا فَہُوَ أَحَقُّ بِہَا ، وَإِلَّا فَہُوَ مَالُ اللہِ یُؤْتِیہِ مَنْ یَشَائُ۔ (ابوداؤد ۱۷۰۶۔ احمد ۴/۱۶۱)","Sahih","Musannaf Ibn Abi Shaybah 22062","","","كتاب البيوع والأقضية"
"22063","(۲۲۰۶۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ رَبِیعَۃَ بْنِ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ یَزِیدَ مَوْلَی الْمُنْبَعِثِ ، عَنْ زَیْدِ بْنِ خَالِدٍ الْجُہَنِیِّ ، قَالَ : سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ اللُّقَطَۃِ فَقَالَ : عَرِّفْہَا سَنَۃً ، فَإِنْ جَائَ صَاحِبُہَا وَإِلاَّ فَاسْتَنْفِقْہَا۔ (بخاری ۹۱۔ مسلم ۱۳۴۶)","Sahih","Musannaf Ibn Abi Shaybah 22063","","","كتاب البيوع والأقضية"
"22064","(۲۲۰۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ بْنِ یَحْیَی ، عَنْ عَبْدِ اللہِ بن فروخ مَوْلی أُم سَلَمَۃَ ، قَالَ : سَأَلَ رَجُلٌ أُمَّ سَلَمَۃَ زَوْجَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ لَہَا: الرَّجُلُ یَجِدُ سَوْطًا؟ فَقَالَتْ : لاَ بَأْسَ بِہِ ، یَصِلُ بِہِ الْمُسْلِمُ یَدَہُ، قَالَ : وَالْحِذَائَ ؟ قَالَتْ : وَالْحِذَائَ ؟ : قَالَ : وَالْوِعَائَ ، قَالَتْ : لاَ أُحِلُّ مَا حَرَّمَ اللَّہُ ، الْوِعَائُ یَکُونُ فِیہِ اللُّقَطَۃُ۔","Hasan","Musannaf Ibn Abi Shaybah 22064","","","كتاب البيوع والأقضية"
"22065","(۲۲۰۶۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ طَلْحَۃَ بْنِ مُصَرِّفٍ ، عَنْ أَنَسِ بْنِ مَالِکٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَجَدَ تَمْرَۃً ، فَقَالَ : لَوْلاَ أَنْ تَکُونِ مِنَ الصَّدَقَۃِ لأَکَلْتُکِ۔","Sahih","Musannaf Ibn Abi Shaybah 22065","","","كتاب البيوع والأقضية"
"22066","(۲۲۰۶۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ طَلْحَۃَ بْنِ مُصَرِّفٍ ، عَنِ ابْنِ عُمَرَ : أَنَّہُ وَجَدَ تَمْرَۃً فَأَکَلَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 22066","","","كتاب البيوع والأقضية"
"22067","(۲۲۰۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یُرَخِّصُونَ مِنَ اللُّقَطَۃِ فِی السَّیْرِ ، وَالْعَصَا ، وَالسَّوْطِ۔","","Musannaf Ibn Abi Shaybah 22067","","","كتاب البيوع والأقضية"
"22068","(۲۲۰۶۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا رَبِیعَۃُ بْنُ عُتْبَۃَ الْکِنَانِیُّ ، قَالَ : سَمِعْتُ عَطَائً ، قَالَ : لاَ بَأْسَ أَنْ یَلْتَقِطَ السَّیْرَ ، وَالْعِصِیَّ ، وَالسَّوْطَ۔q","","Musannaf Ibn Abi Shaybah 22068","","","كتاب البيوع والأقضية"
"22069","(۲۲۰۶۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی قَیْسٍ الأَوْدِیِّ ، عَنْ بَشِیرٍ : أَنَّہُ رَخَّصَ فِی اللُّقَطَۃِ نَحْوًا مِنْ خَمْسَۃِ دَرَاہِمَ۔","","Musannaf Ibn Abi Shaybah 22069","","","كتاب البيوع والأقضية"
"22070","(۲۲۰۷۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا کَانَ إلَیْہَا مُحْتَاجًا فَلْیَأْکُلْہَا۔","","Musannaf Ibn Abi Shaybah 22070","","","كتاب البيوع والأقضية"
"22071","(۲۲۰۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عن أبیہ ، عَنْ عَائِشَۃَ : أَنَّہَا رَخَّصَتْ فِی اللُّقَطَۃِ فِی دِرْہَمٍ۔","Da'if","Musannaf Ibn Abi Shaybah 22071","","","كتاب البيوع والأقضية"
"22072","(۲۲۰۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عُبَیْدِ الْمُکْتِبِ ، عَنْ أَبِی رَزِینٍ ، قَالَ : لَوْ وَجَدْتہَا وَأَنَا مُحْتَاجٌ إلَیْہَا لاَکَلْتہَا۔","","Musannaf Ibn Abi Shaybah 22072","","","كتاب البيوع والأقضية"
"22073","(۲۲۰۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُوسَی بْنِ أَبِی عَائِشَۃَ ، عَنْ رَجُلٍ ، عَنْ مَیْمُونَۃَ : أَنَّہَا وَجَدَتْ تَمْرَۃً فَأَکَلَتْہَا وَقَالَتْ : لاَ یُحِبُّ اللَّہُ الْفَسَادَ۔","Da'if","Musannaf Ibn Abi Shaybah 22073","","","كتاب البيوع والأقضية"
"22074","(۲۲۰۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ شَیْخٍ لَمْ یُسَمہ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ وَجَدَ تَمْرَۃً فَمَسَحَہَا ، ثُمَّ نَاوَلَہَا مِسْکِینًا۔","Da'if","Musannaf Ibn Abi Shaybah 22074","","","كتاب البيوع والأقضية"
"22075","(۲۲۰۷۵) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ عُقْبَۃَ بْنِ عَبْدِ اللہِ ، قَالَ : حدَّثَنِی مَیْسَرَۃُ بْنُ عَمِیرَۃَ : أَنَّہُ لَقِیَ أَبَا ہُرَیْرَۃَ فَقَالَ : مَا تَقُولُ فِی اللُّقَطَۃِ ؟ قَالَ : وما اللقطۃ؟ قَالَ : الْحَبْلُ وَالزِّمَامُ وَنَحْوُ ہَذَا ، قَالَ : تُعَرِّفُہُ ، فَإِنْ وَجَدْتَّ صَاحِبَہُ رَدَدْتہ عَلَیْہِ وَإِلاَّ اسْتَمْتَعْت بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 22075","","","كتاب البيوع والأقضية"
"22076","(۲۲۰۷۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ : إذَا کَانَ مُحْتَاجًا إلَیْہَا یَأْکُلُہَا۔","","Musannaf Ibn Abi Shaybah 22076","","","كتاب البيوع والأقضية"
"22077","(۲۲۰۷۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سَلَمَۃُ بْنُ وَرْدَانَ ، قَالَ : سَأَلْتُ سَالِمَ بْنَ عَبْدِ اللہِ عَنْ ضَالَّۃِ الإِبِلِ ؟ فَقَالَ : مَعَہَا سِقَاؤُہَا وَحِذَاؤُہَا ، دَعْہَا ، إلاَّ أَنْ تَعْرِفَ صَاحِبَہَا فَتَدْفَعُہَا إلَیْہِ ، قَالَ : وَسَأَلْتُہُ عَنْ ضَالَّۃِ الْغَنَمِ ؟ فَقَالَ : عَرِّفْہَا ، فَإِنْ جَائَ صَاحِبُہَا ، وَإِلاَّ فَہِیَ لَکَ ، أَوْ لأَِخِیک ، أَوْ لِلذِّئْبِ۔","","Musannaf Ibn Abi Shaybah 22077","","","كتاب البيوع والأقضية"
"22078","(۲۲۰۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ سَعْدٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ : أَنَّ رَجُلاً سَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ ضَالَّۃِ الْغَنَمِ فَقَالَ : لَکَ ، أَوْ لأَِخِیک ، أَوْ لِلذِّئْبِ ، وَسَأَلَہُ عَنْ ضَالَّۃِ الإِبِلِ فَقَالَ : مَا تُرِیدُ إلَیْہَا ؟ مَعَہَا سِقَاؤُہَا وَحِذَاؤُہَا ، تَأْکُلُ الْمَرْعَی وَتَرِدُ الْمَائَ۔","Hasan","Musannaf Ibn Abi Shaybah 22078","","","كتاب البيوع والأقضية"
"22079","(۲۲۰۷۹) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْعَالِیَۃِ قَالَتْ : کُنْت جَالِسَۃً عِنْدَ عَائِشَۃَ فَأَتَتْہَا امْرَأَۃٌ ، فَقَالَتْ: یَا أُمَّ الْمُؤْمِنِینَ، إنِّی وَجَدْت شَاۃً ضَالَّۃً، فَکَیْفَ تَأْمُرِینِی أَنْ أَصْنَعَ؟ فَقَالَتْ: عَرِّفِی وَاحْلِبِی وَاعْلِفِی، ثُمَّ عَادَتْ فَسَأَلَتْہَا ، فَقَالَتْ عَائِشَۃُ : تَسأْلِینِی أَنْ آمُرَک أَنْ تَذْبَحِیہَا ، أَوْ تَبِیعِیہَا ، فَلَیْسَ لَکِ ذَلِکِ۔","Hasan","Musannaf Ibn Abi Shaybah 22079","","","كتاب البيوع والأقضية"
"22080","(۲۲۰۸۰) حَدَّثَنَا شَرِیکٌ ، عَنْ زُہَیْرِ بْنِ أَبِی ثَابِتٍ ، عَنْ سَلْمَی ، وَلاَ أُرَاہَا إلاَّ ابْنَۃَ کَعْبٍ ، قَالَت : وَجَدْت خَاتَمًا فِی طَرِیقِ مَکَّۃَ فَسَأَلْت عَائِشَۃَ ؟ فَقَالَتْ : تَمَتَّعِی بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 22080","","","كتاب البيوع والأقضية"
"22081","(۲۲۰۸۱) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ زَیْدِ بْنِ جُبَیْرٍ ، قَالَ : کُنْتُ قَاعِدًا عِنْدَ عَبْدِ اللہ بْنَ عُمَرَ فَأَتَاہُ رَجُلٌ فَقَالَ : ضَالَّۃٌ وَجَدْتہَا ؟ فَقَالَ : أَصْلِحْ إلَیْہَا وَأَنْشِدْ ، قَالَ : فَہَلْ عَلَیَّ إِنْ شَرِبْت مِنْ لَبَنِہَا ؟ قَالَ ابْنُ عُمَرَ : مَا أَرَی عَلَیْک فِی ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 22081","","","كتاب البيوع والأقضية"
"22082","(۲۲۰۸۲) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ، عَنْ أَیُّوبَ، عَنْ عَطَائٍ، قَالَ: رُخِّصَ لِلْمُسَافِرِ أَنْ یَلْتَقِطَ السَّوْطَ وَالْعِصِیَّ وَالنَّعْلَیْنِ۔","","Musannaf Ibn Abi Shaybah 22082","","","كتاب البيوع والأقضية"
"22083","(۲۲۰۸۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یُحْیِی بْنِ سَعِیدٍ ، عَنْ مُعَاوِیَۃَ بْنِ عَبْدِ اللہِ بْنِ بَدْرٍ ، عَنْ أَبِیہِ ، قَالَ : وَجَدْت ثَمَانِینَ دِینَارًا فِی عَہْدِ عُمَرَ بْنِ الْخَطَّابِ ، فَأَتَیْت بِہَا عُمَرَ فَقَالَ : عَرِّفْہَا سَنَۃً ، قُلْتُ : فَإِنْ لَمْ تُعْرَفْ ؟ قَالَ : فَاسْتَمْتِعْ بِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 22083","","","كتاب البيوع والأقضية"
"22084","(۲۲۰۸۴) حَدَّثَنَا جَرِیرٌ، عَنْ قَابُوسَ، عَنْ أَبِیہِ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: لاَ تَرْفَعْہَا مِنَ الأَرْضِ، فَلَسْت مِنْہَا فِی شَیْئٍ۔","Da'if","Musannaf Ibn Abi Shaybah 22084","","","كتاب البيوع والأقضية"
"22085","(۲۲۰۸۵) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، أَنَّ مُجَاہِدًا وَابْنَ عُمَرَ کَانَا یَطُوفَانِ بِالْبَیْتِ فَوَجَدَا حُقَّۃً فِیہَا جَوْہَرٌ ، فَلَمْ یَعْرِضَا لَہَا۔","","Musannaf Ibn Abi Shaybah 22085","","","كتاب البيوع والأقضية"
"22086","(۲۲۰۸۶) حَدَّثَنَا عَبْدُالرَّحْمَنِ بْنُ مَہْدِیِّ، عَنْ سُفْیَانَ، عَنْ سُرِّیَّۃِ الرَّبِیعِ بْنِ خُثَیْمٍ، عَنِ الرَّبِیعِ: أَنَّہُ کَرِہَ أَخْذَ اللُّقَطَۃِ۔","","Musannaf Ibn Abi Shaybah 22086","","","كتاب البيوع والأقضية"
"22087","(۲۲۰۸۷) حَدَّثَنَا حَرَمِیُّ بْنُ عُمَارَۃ ، عَنْ أَبِی عُتْبَۃَ الدَّہَّانِ ، قَالَ : سَأَلْتُ جَابِرَ بْنَ زَیْدٍ عَنِ اللُّقَطَۃِ أَخَذَہَا مِنَ الطَّرِیقِ ، فَکَرِہَہَا۔","","Musannaf Ibn Abi Shaybah 22087","","","كتاب البيوع والأقضية"
"22088","(۲۲۰۸۸) حَدَّثَنَا وکیع قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، أَوْ تَمِیمِ بْنِ سَلَمَۃَ شَکَّ مَنْصُورٌ ، قَالَ : کَانَ شُرَیْحٌ یَمُرُّ بِالدِّینَارِ فَلاَ یَعرضُ لَہُ۔","","Musannaf Ibn Abi Shaybah 22088","","","كتاب البيوع والأقضية"
"22089","(۲۲۰۸۹) حَدَّثَنَا وکیع ، قَالَ : حَدَّثَنَا الضَّحَّاکُ بْنُ یَسَارٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ : أَنَّہُ رَأَی دِینَارًا مَطْرُوحًا فَدَاسَہُ بِرِجلِہِ حَتَّی أَتَی بِہِ قَرِیبًا مِنْ مَکَانِ الإِمَامِ فَتَرَکَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 22089","","","كتاب البيوع والأقضية"
"22090","(۲۲۰۹۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا وَاقِدُ بْنُ عَبْدِ اللہِ ، قَالَ : کُنْتُ عِنْدَ عَطَائِ بْنِ أَبِی رَبَاحٍ فَسَأَلَہُ رَجُلٌ : تَرْکُ اللُّقَطَۃِ خَیْرٌ ، أَوْ أَخْذُہَا ؟ قَالَ : لاَ ، بَلْ تَرْکُہَا۔","","Musannaf Ibn Abi Shaybah 22090","","","كتاب البيوع والأقضية"
"22091","(۲۲۰۹۱) حَدَّثَنَا وَکِیعٌ، عَنْ سُ[corrupt]ْیَانَ، عَنْ عَبْدِاللہِ بْنِ دِینَارٍ، قَالَ: قُلْتُ لابْنِ عُمَرَ: وَجَدْت لُقَطَۃً، قَالَ: وَلِمَ أَخَذْتہَا؟","Sahih","Musannaf Ibn Abi Shaybah 22091","","","كتاب البيوع والأقضية"
"22092","(۲۲۰۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ أَبِی الْفُرَاتِ الْمَکِّیِّ ، قَالَ : سَمِعْتُ طَاوُوسًا وَسَأَلَہُ رَجُلٌ فَقَالَ : وَجَدْت دِینَارًا فَأَخَذْتہ ، قَالَ : أأضَعُہُ مَکَانَہُ ، قَالَ : قَدْ ضمنتہ۔","","Musannaf Ibn Abi Shaybah 22092","","","كتاب البيوع والأقضية"
"22093","(۲۲۰۹۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَبِی حَیَّانَ ، عَنِ الضَّحَّاکِ ، عَنِ الْمُنْذِرِ بْنِ جَرِیرٍ ، عَنْ أَبِیہِ جَرِیرٍ ، قَالَ : الضَّالَّۃُ لاَ یَأْخُذُہَا ، أَوْ لاَ یُؤوِیہَا إلاَّ ضَالٌّ۔ (ابوداؤد ۱۷۱۷۔ احمد ۴/۳۶۲)","Da'if","Musannaf Ibn Abi Shaybah 22093","","","كتاب البيوع والأقضية"
"22094","(۲۲۰۹۴) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قَالَ عُمَرُ وَہُوَ مُسْنِدٌ ظَہْرَہُ إلَی الْکَعْبَۃِ : مَنْ أَخَذَ ضَالَّۃً ، فَہُوَ ضَالٌّ۔","Sahih","Musannaf Ibn Abi Shaybah 22094","","","كتاب البيوع والأقضية"
"22095","(۲۲۰۹۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہَمَّامُ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ ، قَالَ عُمَرُ : لاَ یَضُمُّ الضَّالَّۃَ إلاَّ ضَالّ۔n وَقَالَ عَلِیٌّ : لاَ یَأْکُلُ الضَّالَّۃَ إلاَّ ضَالٌّ۔","Sahih","Musannaf Ibn Abi Shaybah 22095","","","كتاب البيوع والأقضية"
"22096","(۲۲۰۹۶) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنْ ثَابِتِ بْنِ الضَّحَّاکِ ، قَالَ : وَجَدْت بَعِیرًا فَسَأَلْت عُمَرَ فَقَالَ : عَرِّفْہُ ، فَعَرَّفْتہ ، فَلَمْ أَجِدْ أَحَدًا یَعْرِفُہُ ، فَأَتَیْتہ فَقُلْتُ : قَدْ شَغَلَنِی ، قَالَ : فَأَرْسِلْہُ حَیْثُ وَجَدْتہ۔","Sahih","Musannaf Ibn Abi Shaybah 22096","","","كتاب البيوع والأقضية"
"22097","(۲۲۰۹۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ الْعُکْلِیِّ ، قَالَ : مَنْ أَخَذَ شَیْئًا یُرِیدُ الْحِسْبَۃَ فَلاَ ضَمَانَ عَلَیْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 22097","","","كتاب البيوع والأقضية"
"22098","(۲۲۰۹۸) حَدَّثَنَا عَبْدُالأَعْلَی بْنُ عَبْدِالأَعْلَی، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، قَالَ: إذَا ضَاعَتِ اللُّقَطَۃُ فَصَاحِبُہَا ضَامِنٌ۔","","Musannaf Ibn Abi Shaybah 22098","","","كتاب البيوع والأقضية"
"22099","(۲۲۰۹۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَجَّاجٍ ، عَنْ رَجُلٍ ، عَنْ عَلِیٍّ : فِی رَجُلٍ أَخَذَ ضَالَّۃً فَضَلَّتْ مِنْہُ ، قَالَ : ہُوَ أَمِینٌ۔","Da'if","Musannaf Ibn Abi Shaybah 22099","","","كتاب البيوع والأقضية"
"22100","(۲۲۱۰۰) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنِ الشَّیْبَانِیِّ، عَنِ الْقَاسِمِ، قَالَ: أَسْلَمَ عبْدُاللہِ فِی وُصَفَائِ أَحَدِہِمْ أَبُو زَائِدَۃَ مَوْلاَنَا۔","","Musannaf Ibn Abi Shaybah 22100","","","كتاب البيوع والأقضية"
"22101","(۲۲۱۰۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَامِرٍ : أنَّہُ کَانَ لاَ یَرَی بِذَلِکَ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 22101","","","كتاب البيوع والأقضية"
"22102","(۲۲۱۰۲) حَدَّثَنَا عَبْدُ السَّلاَمِ بنُ حَرْب ، عَنْ خُصَیْفٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : أَنَّہُ لَمْ یَرَ بِذَلِکَ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 22102","","","كتاب البيوع والأقضية"
"22103","(۲۲۱۰۳) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : لاَ بَأْسَ بِالسَّلَمِ فِی الْحَیَوَانِ عِنْدَ أَصْحَابِ الشَّائِ إذَا سُمِّیَتِ الآجَالُ وَالأَسْنَانُ۔","","Musannaf Ibn Abi Shaybah 22103","","","كتاب البيوع والأقضية"
"22104","(۲۲۱۰۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّہُ لَمْ یَرَ بَأْسًا أَنْ یُسْلِمَ فِی الْحَیَوَانِ أَسْنَانًا مُسَمَّاۃً إلَی أَجَلٍ مُسَمًّی۔","","Musannaf Ibn Abi Shaybah 22104","","","كتاب البيوع والأقضية"
"22105","(۲۲۱۰۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالسَّلَمِ فِی الْحَیَوَانِ ، وَأَنْ یَأْخُذَ الرَّجُلُ دُونَ شَرْطِہِ ، وَفَوْقَہُ مِنَ الأَسْنَانِ إذَا طَابَتْ بِذَلِکَ نَفْسُ الْمُعْطِی وَالآخِذِ۔","","Musannaf Ibn Abi Shaybah 22105","","","كتاب البيوع والأقضية"
"22106","(۲۲۱۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ الأَحْوَلِ ، عَنْ مُجَاہِدٍ ، قَالَ : سَمِعْتُہُ یَقُولُ : کُنَّا نُسْلِمُ فِی الْوُصَفَائِ کَذَا وَکَذَا شِبْرًا۔","","Musannaf Ibn Abi Shaybah 22106","","","كتاب البيوع والأقضية"
"22107","(۲۲۱۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مَعْمَرُ بْنُ سَامٍّ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : لاَ بَأْسَ بِالسَّلَمِ فِی الْحَیَوَانِ۔","","Musannaf Ibn Abi Shaybah 22107","","","كتاب البيوع والأقضية"
"22108","(۲۲۱۰۸) حَدَّثَنَا رَوَّادُ بْنُ جَرَّاحٍ ، عَنِ الأَوْزَاعِی ، عَنِ الزُّہْرِیِّ : أَنَّہُ لَمْ یَرَ بَأْسًا بِالسَّلَمِ فِی الْوُصَفَائِ إذَا کَانَ سِنٌّ مَعْلُومٌ۔","","Musannaf Ibn Abi Shaybah 22108","","","كتاب البيوع والأقضية"
"22109","(۲۲۱۰۹) حَدَّثَنَا مُحَمَّدُ بْنُ مُیَسَّرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ : أَنَّہُ لَمْ یَرَ بِذَلِکَ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 22109","","","كتاب البيوع والأقضية"
"22110","(۲۲۱۱۰) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ أَبِی نَضْرَۃَ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنِ السَّلَمِ فِی الْحَیَوَانِ فِی الْوُصَفَائِ فَقَالَ : لاَ بَأْسَ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 22110","","","كتاب البيوع والأقضية"
"22111","(۲۲۱۱۱) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَش ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ یَکْرَہُ السَّلَمَ فِی الْحَیَوَانِ۔","","Musannaf Ibn Abi Shaybah 22111","","","كتاب البيوع والأقضية"
"22112","(۲۲۱۱۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ سِیرِینَ : أَنَّ عُمَرَ وَحُذَیْفَۃَ وَابْنَ مَسْعُودٍ کَانُوا یَکْرَہُونَ السَّلَمَ فِی الْحَیَوَانِ۔","","Musannaf Ibn Abi Shaybah 22112","","","كتاب البيوع والأقضية"
"22113","(۲۲۱۱۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ : أَنَّ زَیْدَ بْنَ خُلَیْدَۃَ أَسْلَمَ إلَی عِتْریس بْنِ عُرْقُوبٍ فِی قَلاَئِصَ ، فَسَأَلَ ابْنَ مَسْعُودٍ ؟ فَکَرِہَ السَّلَمَ فِی الْحَیَوَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 22113","","","كتاب البيوع والأقضية"
"22114","(۲۲۱۱۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : قَالَ عُمَرُ : مِنَ الرِّبَا أَنْ یُسْلَمَ فِی سِنٍّ۔","","Musannaf Ibn Abi Shaybah 22114","","","كتاب البيوع والأقضية"
"22115","(۲۲۱۱۵) حَدَّثَنَا وکیع، قَالَ: حَدَّثَنَا حَسَنُ بْنُ صَالِحٍ، عَنْ عَبْدِالأَعْلَی، قَالَ: شَہِدْت شُرَیْحًا رَدَّ السَّلَمَ فِی الْحَیَوَانِ۔","","Musannaf Ibn Abi Shaybah 22115","","","كتاب البيوع والأقضية"
"22116","(۲۲۱۱۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، قَالَ : سَمِعْتُ سُوَیْد بْنَ غَفَلَۃَ یَکْرَہُ السَّلَمَ فِی الْحَیَوَانِ۔","","Musannaf Ibn Abi Shaybah 22116","","","كتاب البيوع والأقضية"
"22117","(۲۲۱۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا النَّضْرُ بْنُ أَبِی مَرْیَمَ أَبُو لِینَۃَ ، عَنِ الضَّحَّاکِ : أَنَّہُ رَخَّصَ فِی السَّلَمِ فِی الْحَیَوَانِ ، ثُمَّ رَجَعَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 22117","","","كتاب البيوع والأقضية"
"22118","(۲۲۱۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَتَبَ عُمَرُ إلَی عَبْدِ اللہِ : لاَ تُسْلِمْ فِی الْحَیَوَانِ۔","","Musannaf Ibn Abi Shaybah 22118","","","كتاب البيوع والأقضية"
"22119","(۲۲۱۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا شُعْبَۃُ ، عَنْ عَمَّارٍ صَاحِبِ السَّابِرِیِّ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ جُبَیْرٍ یُسْأَلُ عَنِ السَّلَمِ فِی الْحَیَوَانِ ؟ فَنَہَی عَنْہُ ، فَقَالَ : قَدْ کُنْت بِأَذْرَبِیجَانَ سِنِین أَوْ سَنَتَیْنِ تَرَاہُمْ یَفْعَلُونَہُ ، وَلاَ نَنْہَاہُمْ ؟ فَقَالَ سَعِیدٌ : أَنْشُرُ بَذِّی عِنْدَ مَنْ لاَ یُرِیدُہُ ، کَانَ حُذَیْفَۃُ بْنُ الْیَمَانِ یَنْہَی عَنْہُ۔","","Musannaf Ibn Abi Shaybah 22119","","","كتاب البيوع والأقضية"
"22120","(۲۲۱۲۰) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ أَبِی نَضْرَۃَ ، قَالَ : قُلْتُ لابْنِ عُمَرَ : إنَّ أُمَرَاؤُنَا تَنْہَانَا عَنْہُ ، یَعْنِی السَّلَمَ فِی الْحَیَوَانِ فِی الْوُصَفَائِ ، قَالَ : فَأَطِعْ أُمَرَائَک إِنْ کَانُوا یَنْہَوْنَ عَنْہُ ، وَأُمَرَاؤُہُمْ یَوْمَئِذٍ مِثْلُ الْحَکَمِ الْغِفَارِیِّ وَعَبْدِ الرَّحْمَنِ بْنِ سَمُرَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 22120","","","كتاب البيوع والأقضية"
"22121","(۲۲۱۲۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَش ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عُمَرَ ، قَالَ : مَنْ وَہَبَ ہِبَۃً لِذِی رَحِمٍ فَہِیَ جَائِزَۃٌ ، وَمَنْ وَہَبَ ہِبَۃً لِغَیْرِ ذِی رَحِمٍ ، فَہُوَ أَحَقُّ بِہَا مَا لَمْ یُثَبْ مِنْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 22121","","","كتاب البيوع والأقضية"
"22122","(۲۲۱۲۲) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، عَنْ رَبِیعَۃَ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرٍ ، قَالَ : کُنْتُ جَالِسًا عِنْدَ فَضَالَۃَ ، فَأَتَاہُ رَجُلاَنِ یَخْتَصِمَانِ فِی بَازٍ ، فَقَالَ أَحَدُہُمَا : وَہَبْت لَہُ بَازِیَ رَجَائَ أَنْ یُثِیبَنِی ، وَأَخَذَ بَازِیَ وَلَمْ یَثِبْنِی ، فَقَالَ لَہُ الآخَرُ : وَہَبَ لِی بَازِہ ، مَا سَأَلْتُہُ ، وَلاَ تَعَرَّضْت لَہُ ، فَقَالَ : رُدَّ عَلَیْہِ بَازِہ ، أَوْ أَثِبْہُ ، فَإِنَّمَا یَرْجِعُ فِی الْمَوَاہِبِ النِّسَائُ وَأشْرَارُ الأَقْوَامِ۔","Hasan","Musannaf Ibn Abi Shaybah 22122","","","كتاب البيوع والأقضية"
"22123","(۲۲۱۲۳) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنِ الأَفْرِیقِیِّ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : مَنْ وَہَبَ ہِبَۃً فَلَمْ یُثَبْ عَلَیْہَا وَأَرَادَ أَنْ یَرْجِعَ فِیہَا فَلْیَرْجِعْ عَلاَنِیَۃً غَیْرَ سِرٍّ۔","","Musannaf Ibn Abi Shaybah 22123","","","كتاب البيوع والأقضية"
"22124","(۲۲۱۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الْقَاسِمِ ، عَنِ ابْنِ أَبْزَی ، عنْ عَلِیٍّ ، قَالَ : الرَّجُلُ أَحَقُّ بِہِبَتِہِ مَا لَمْ یُثَبْ مِنْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 22124","","","كتاب البيوع والأقضية"
"22125","(۲۲۱۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ إسْمَاعِیلَ بْنِ مُجَمِّعٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الرَّجُلُ أَحَقُّ بِہِبَتِہِ مَا لَمْ یُثَبْ مِنْہَا۔ (ابن ماجہ ۲۳۸۷۔ دارقطنی ۱۸۰)","Da'if","Musannaf Ibn Abi Shaybah 22125","","","كتاب البيوع والأقضية"
"22126","(۲۲۱۲۶) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : ہُوَ أَحَقُّ بِہَا مَا لَمْ یَرْضَ مِنْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 22126","","","كتاب البيوع والأقضية"
"22127","(۲۲۱۲۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ، قَالَ : مَنْ أَعْطَی فِی صِلَۃٍ ، أَوْ قَرَابَۃٍ ، أَوْ مَعْرُوفٍ ، أَوْ حَقٍّ ، فَعَطِیَّتُہُ جَائِزَۃٌ ، وَالْجَانِبُ الْمُسْتَغْزر یُثَابُ مِنْ ہِبَتِہِ ، أَوْ تُرَدُّ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 22127","","","كتاب البيوع والأقضية"
"22128","(۲۲۱۲۸) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَن إبراہیم ، عن عمرو بْن دِینَارٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَنْ وَہَبَ ہِبَۃً لِوَجْہِ الثَّوَابِ فَلاَ بَأْسَ أَنْ یَرُدَّ۔","Da'if","Musannaf Ibn Abi Shaybah 22128","","","كتاب البيوع والأقضية"
"22129","(۲۲۱۲۹) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : مَنْ وَہَبَ ہِبَۃً لِغَیْرِ ذِی رَحِمٍ فَلَہُ أَنْ یَرْجِعَ مَا لَمْ یُثِبْہُ۔","","Musannaf Ibn Abi Shaybah 22129","","","كتاب البيوع والأقضية"
"22130","(۲۲۱۳۰) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَنْ مُطَرِّفٍ ، عَنْ عَامِرٍ ، قَالَ : إذَا وَہَبَ الرَّجُلُ الْہِبَۃَ ، فَہُوَ أَحَقُّ بِہَا مَا دَامَتْ فِی یَدِہِ ، فَإِذَا أَعْطَاہَا ، فَقَدْ جَازَتْ۔","","Musannaf Ibn Abi Shaybah 22130","","","كتاب البيوع والأقضية"
"22131","(۲۲۱۳۱) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ حُسَیْنٍ الْمُعَلِّمِ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عُمَرَ وَابْنِ عَبَّاسٍ، قَالاَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَحِلُّ لِرَجُلٍ أَنْ یُعْطِی عَطِیَّۃً ثُمَّ یَرْجِعُ فِیہَا ، فَمَثَلُہُ مَثَلُ الْکَلْبِ أَکَلَ حَتَّی إذَا شَبِعَ قَائَ ، ثُمَّ عَادَ فِی قَیْئِہِ۔ (ترمذی ۱۲۹۹۔ ابوداؤد ۳۵۳۳)","Sahih","Musannaf Ibn Abi Shaybah 22131","","","كتاب البيوع والأقضية"
"22132","(۲۲۱۳۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ لَنَا مَثَلُ السَّوْئِ ، الْعَائِدُ فِی ہِبَتِہِ کَالْکَلْبِ یَعُودُ فِی قَیْئِہِ۔ (بخاری ۲۶۲۲۔ ترمذی ۱۲۹۸)","Sahih","Musannaf Ibn Abi Shaybah 22132","","","كتاب البيوع والأقضية"
"22133","(۲۲۱۳۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَوْفٍ ، عَنْ خِلاَسٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَثَلُ الَّذِی یَعُودُ فِی عَطِیَّتِہِ مَثَلُ الْکَلْبِ أَکَلَ حَتَّی إذَا شَبِعَ قَائَ ، ثُمَّ عَادَ فِی قَیْئِہِ۔n(ابن ماجہ ۲۳۴۔ احمد ۲/۲۵۹)","","Musannaf Ibn Abi Shaybah 22133","","","كتاب البيوع والأقضية"
"22134","(۲۲۱۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ نَافِعٍ ، عَنِ الْحَسَنِ بْنِ مُسْلِمٍ ، عَنْ طَاوُوسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَحِلُّ لِرَجُلٍ أَنْ یَرْجِعَ فِی ہِبَتِہِ إلاَّ الْوَالِدَ۔ (بیہقی ۱۷۹۔ نسائی ۶۵۳۵)","","Musannaf Ibn Abi Shaybah 22134","","","كتاب البيوع والأقضية"
"22135","(۲۲۱۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ سَعْدٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَثَلُ الَّذِی یَعُودُ فِی صَدَقَتِہِ کَمِثْلِ الْکَلْبِ یَعُودُ فِی قَیْئِہِ۔ (بخاری ۲۶۲۳۔ احمد ۱/۵۴)","","Musannaf Ibn Abi Shaybah 22135","","","كتاب البيوع والأقضية"
"22136","(۲۲۱۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ حَنْظَلَۃَ ، عَنْ طَاوُوسٍ ، عَنْ بَعْضِ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَثَلُ الَّذِی یَعُودُ فِی ہِبَتِہِ ، کَالْکَلْبِ یَقِیئُ ثُمَّ یَعُودُ فِی قَیْئِہِ۔ (نسائی ۶۵۳۶)","Sahih","Musannaf Ibn Abi Shaybah 22136","","","كتاب البيوع والأقضية"
"22137","(۲۲۱۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْعَائِدُ فِی ہِبَتِہِ کَالْعَائِدِ فِی قَیْئِہِ۔ (بخاری ۲۶۲۱۔ مسلم ۱۲۴۱)","Sahih","Musannaf Ibn Abi Shaybah 22137","","","كتاب البيوع والأقضية"
"22138","(۲۲۱۳۸) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَا تَکَلَّمَ بِہِ السَّکْرَانُ مِنْ شَیْئٍ جَازَ عَلَیْہِ۔nحَدَّثَنَا أَبُو مُحَمَّدٍ عَبْدُ اللہِ بْنُ یُونُسَ ، قَالَ : حدَّثَنَا أَبُو عَبْدُ الرَّحْمَنِ بَقِیُّ بْنُ مَخْلَدٍ ، قَالَ : حَدَّثَنَا أَبُو بَکْر ، قَالَ:","","Musannaf Ibn Abi Shaybah 22138","","","كتاب البيوع والأقضية"
"22139","(۲۲۱۳۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِی ، عَنِ الزُّہْرِیِّ ، أَنَّہُ قَالَ فِی السَّکْرَانِ : أَمَّا بَیْعُہُ وَشِرَاؤُہُ فَلاَ یَجُوزُ ، ہُوَ بِمَنْزِلَۃِ السَّفِیہِ۔","","Musannaf Ibn Abi Shaybah 22139","","","كتاب البيوع والأقضية"
"22140","(۲۲۱۴۰) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عن عمرو ، عَنِ الْحَسَنِ ، قَالَ : کَانَ لاَ یُجِیزُ بَیْعَہُ ، وَلاَ شِرَائَہُ۔","","Musannaf Ibn Abi Shaybah 22140","","","كتاب البيوع والأقضية"
"22141","(۲۲۱۴۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ قَالَ فِی ثَوْبٍ بَیْنَ رَجُلَیْنِ نِصْفُہُ عَلَی أَحَدِہِمَا بِعِشْرِینَ ، وَنِصْفُہُ عَلَی الآخَرِ بِعَشْرَۃٍ ، قَالاَ : إِنْ بَاعَاہُ مُسَاوَمَۃً ، أَوْ مُرَابَحَۃً ، فَہُوَ نِصْفَانِ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 22141","","","كتاب البيوع والأقضية"
"22142","(۲۲۱۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ وَالْحَکَمِ : فِی رَجُلَیْنِ اشْتَرَیَا سِلْعَۃً اشْتَرَی أَحَدُہُمَا نِصْفَہَا بِعِشْرِینَ ، وَاشْتَرَی الآخَرُ نِصْفَہَا بِعَشْرَۃٍ ، فَقَالَ الشَّعْبِیُّ : إِنْ بَاعَاہَا مُرَابَحَۃً فَعَلَی رُؤُوسِ أَمْوَالِہِمَا ، وَإِنْ بَاعَاہَا مُسَاوَمَۃً فَالنِّصْفُ وَالنِّصْفُ ، وَقَالَ الْحَکَمُ : ہُوَ بَیْنَہُمَا نِصْفَانِ۔","","Musannaf Ibn Abi Shaybah 22142","","","كتاب البيوع والأقضية"
"22143","(۲۲۱۴۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ زِیَادِ الأَعْلَمِ ، عَنِ الْحَسَنِ ، قَالَ : إِنْ بَاعَاہَا مُرَابَحَۃً فَالرِّبْحُ عَلَی رَأْسِ الْمَالِ ، وَإِنْ بَاعَاہَا مُسَاوِمَۃً ، فَہُوَ بَیْنَہُمَا ، وَعَنْ قَتَادَۃَ مِثْلُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 22143","","","كتاب البيوع والأقضية"
"22144","(۲۲۱۴۴) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، قَالَ : سُئِلَ حماد عَنْ سِلْعَۃٍ بَیْنَ رَجُلَیْنِ تُقَوَّمُ عَلَی أَحَدِہِمَا بِأَکْثَرَ مِمَّا تُقَوَّمُ عَلَی الآخَرِ ، قَالَ : الرِّبْحُ عَلَی قَدْرِ رُؤُوسِ أَمْوَالِہِمَا۔","","Musannaf Ibn Abi Shaybah 22144","","","كتاب البيوع والأقضية"
"22145","(۲۲۱۴۵) حَدَّثَنَا حَفْصٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عنِ ابْنِ عُمَرَ : أَنَّہُ سُئِلَ عَنِ الرَّجُلِ یَرْہَنُ الرَّہْنَ فَیَقُولُ : إِنْ لَمْ أَجِئْک بِہِ إلَی کَذَا وَکَذَا ، فَہُوَ لَکَ ؟ قَالَ : لَیْسَ لَہُ ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 22145","","","كتاب البيوع والأقضية"
"22146","(۲۲۱۴۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : فِی الرَّجُلِ یَرْہَنُ عِنْدَہُ الرَّجُلُ الرَّہْنَ فَیَقُولُ : إِنْ لَمْ آتِکَ بِہِ إلَی کَذَا وَکَذَا ، فَہُوَ لَکَ ، قَالَ : الرَّہْنُ لاَ یَغْلقُ ، وَإِنْ قَالَ : إَنْ لَمْ آتِکَ بِہِ إلَی کَذَا وَکَذَا فَبِعْہُ وَاقْتَضِ الَّذِی لَکَ ، قَالَ : لاَ یَکُن أَمِینَ نَفْسِہِ ، وَلاَ یَبعْہ۔","","Musannaf Ibn Abi Shaybah 22146","","","كتاب البيوع والأقضية"
"22147","(۲۲۱۴۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ، عَنْ قَتَادَۃَ، عَنِ النَّضْرِ بْنِ أَنَسٍ، عَنْ بَشِیرِ بْنِ نَہِیکٍ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَعْتَقَ شِقْصًا لَہُ فِی مَمْلُوکٍ ، أَوْ نَصِیبًا ، فَعَلَیْہِ خَلاَصُہُ فی مَالِہِ إِنْ کَانَ لَہُ مَالٌ ، فَإِنْ لَمْ یَکُنْ لَہُ مَالٌ اُسْتُسْعِیَ الْعَبْدُ فِی قِیمَتِہِ غَیْرَ مَشْقُوقٍ عَلَیْہِ۔n(بخاری ۲۴۹۲۔ مسلم ۱۱۴۰)","Da'if","Musannaf Ibn Abi Shaybah 22147","","","كتاب البيوع والأقضية"
"22148","(۲۲۱۴۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، وَابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنْ کَانَ مُوسِرًا ضَمِنَ ، وَإِنْ کَانَ مُعْسِرًا أُعْتِقَ مِنْہُ مَا أَعْتَقَ۔ (مسلم ۱۱۳۹۔ ابوداؤد ۳۹۳۹)","Sahih","Musannaf Ibn Abi Shaybah 22148","","","كتاب البيوع والأقضية"
"22149","(۲۲۱۴۹) حَدَّثَنَا ابْنُ نُمَیْرٍ، عَنْ حَجَّاج، عن نافع، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَعْتَقَ شِقْصًا لَہُ فِی عَبْدٍ ، ضَمِنَ لأَِصْحَابِہِ فِی مَالِہِ إِنْ کَانَ لَہُ مَالٌ، وَقَالَ ابْنُ عُمَرَ: إِنْ لَمْ یَکُنْ لَہُ مَالٌ سَعَی الْعَبْدُ۔","","Musannaf Ibn Abi Shaybah 22149","","","كتاب البيوع والأقضية"
"22150","(۲۲۱۵۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَش ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : کَانَ بَیْنِی وَبَیْنَ الأَسْوَدِ وبین أُمِّنَا غُلاَمٌ قَدْ شَہِدَ الْقَادِسِیَّۃَ وَأَبْلَی فِیہَا فَأَرَادُوا عِتْقَہُ وَکُنْت صَغِیرًا ، فَذَکَرَ ذَلِکَ الأَسْوَدُ لِعُمَرَ فَقَالَ عُمَرُ : أَعْتَقُوا أَنْتُمْ ، وَیَکُونُ عَبْدُ الرَّحْمَنِ عَلَی نَصِیبِہِ حَتَّی یَرْغَبَ فِی مِثْلِ مَا رَغِبْتُمْ فِیہِ ، أَوْ یَأْخُذَ نَصِیبَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 22150","","","كتاب البيوع والأقضية"
"22151","(۲۲۱۵۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، قَالَ : کَانَ غُلاَمٌ بَیْنِی وَبَیْنَ إخْوَتِی فَأَرَدْت أَنْ أَعْتَقَہُ ، فَأَتَیْت ابْنَ مَسْعُودٍ فَذَکَرْت ذَلِکَ لَہُ فَقَالَ : لاَ تُفْسِدْ عَلَی شُرَکَائِکَ فَتَضْمَنَ ، وَلَکِنْ تَرَبَّصْ حَتَّی یَشِبُّوا۔","","Musannaf Ibn Abi Shaybah 22151","","","كتاب البيوع والأقضية"
"22152","(۲۲۱۵۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عُمَرَ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 22152","","","كتاب البيوع والأقضية"
"22153","(۲۲۱۵۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : کَانَ ثَلاَثُونَ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُضَمِّنُونَ الرَّجُلَ یَعْتِقُ الْعَبْدُ بَیْنَہُ وَبَیْنَ صَاحِبِہِ إِنْ کَانَ مُوسِرًا۔","","Musannaf Ibn Abi Shaybah 22153","","","كتاب البيوع والأقضية"
"22154","(۲۲۱۵۴) حَدَّثَنَا أَزْہَرُ السَّمَّانُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ : أَنَّ عَبْدًا کَانَ بَیْنَ رَجُلَیْنِ فَأَعْتَقَہُ أَحَدُہُمَا ، فَرَکِبَ شَرِیکُہُ إلَی عُمَرَ ، فَکَتَبَ أَنْ یُقَوِّمَ عَلَیْہ أَعلی الْقِیمَۃِ۔","","Musannaf Ibn Abi Shaybah 22154","","","كتاب البيوع والأقضية"
"22155","(۲۲۱۵۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِنْ کَانَ شُرَیْحٌ لَیَحْبِسَہُ بِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 22155","","","كتاب البيوع والأقضية"
"22156","(۲۲۱۵۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ : فِی الْعَبْدِ یَکُونُ بَیْنَ الرَّجُلَیْنِ فَیَعْتِقُ أَحَدُہُمَا نَصِیبَہُ ، قَالَ : یَضْمَنُ إِنْ کَانَ لَہُ مَالٌ ، فَإِنْ لَمْ یَکُنْ لَہُ مَالٌ اسْتُسْعِی الْعَبْدَ۔","","Musannaf Ibn Abi Shaybah 22156","","","كتاب البيوع والأقضية"
"22157","(۲۲۱۵۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، قَالَ : سَأَلْتُ عَنْہُ سُلَیْمَانَ بْنَ یَسَارٍ فَقَالَ : مِثْلَ ذَلِکَ ، فَقُلْتُ لَہُ : إِنَّہُ صَغِیرٌ ؟ فَقَالَ : السُّنَّۃُ۔","","Musannaf Ibn Abi Shaybah 22157","","","كتاب البيوع والأقضية"
"22158","(۲۲۱۵۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَقُولُ : إذَا أَعْتَقَ الرَّجُلُ نَصِیبًا مِنْ مَمْلُوکٍ لَہُ فِیہِ شِرْکٌ فَإِنَّہُ یَضْمَنُ مَا بَقِیَ مِنْہُ إِنْ کَانَ مُوسِرًا ، وَإِنْ کَانَ مُعْسِرًا اسْتُسْعِی الْعَبْدَ۔","","Musannaf Ibn Abi Shaybah 22158","","","كتاب البيوع والأقضية"
"22159","(۲۲۱۵۹) حَدَّثَنَا مُحَمَّدُ بْنُ مُیَسَّرٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ : فِی الْعَبْدِ یَکُونُ بَیْنَ اثْنَیْنِ فَیَعْتِقُ أَحَدُہُمَا نَصِیبَہُ ، فَقَالَ : ہُوَ ضَامِنٌ لِنَصِیبِ صَاحِبِہِ۔","","Musannaf Ibn Abi Shaybah 22159","","","كتاب البيوع والأقضية"
"22160","(۲۲۱۶۰) حَدَّثَنَا یحیی بْنُ أَبِی زَائِدَۃَ ، عَنْ زَکَرِیَّا ، عَنْ عَامِرٍ : فِی عَبْدٍ کَانَ بَیْنَ رَجُلَیْنِ فَأَعْتَقَ أَحَدُہُمَا نَصِیبَہُ ، قَالَ : یَتِمُّ عِتْقُہُ ، فَإِنْ لَمْ یَکُنْ لَہُ مَالٌ اسْتُسْعِی الْعَبْدَ فِی النِّصْفِ ، وَکَانَ الْوَلاَئُ لِلَّذِی أَعْتَقَ۔","","Musannaf Ibn Abi Shaybah 22160","","","كتاب البيوع والأقضية"
"22161","(۲۲۱۶۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ إسْمَاعِیلَ بْنِ رَجَائٍ ، عَنْ أَبِی مِجْلَزٍ : أَنَّ عَبْدًا کَانَ بَیْنَ رَجُلَیْنِ فَأَعْتَقَ أَحَدُہُمَا نَصِیبَہُ، قَالَ: فَحَبَسَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی بَاعَ فِیہِ غُنَیمَْۃً لَہُ۔ (مسند ۱۵۱۳)","Da'if","Musannaf Ibn Abi Shaybah 22161","","","كتاب البيوع والأقضية"
"22162","(۲۲۱۶۲) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ زُہَیْرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ وَالشَّعْبِیِّ : فِی الْعَبْدِ یَکُونُ بَیْنَ الرَّجُلَیْنِ فَیَعْتِقُ أَحَدُہُمَا نَصِیبَہُ ، قَالاَ : ہُوَ عَتِیقٌ مِنْ مَالِ الَّذِی أَعْتَقَہُ وَیَضْمَنُ لِصَاحِبِہِ بِقِیمَۃِ عَدْلٍ یَوْمَ أَعْتَقَہُ۔","","Musannaf Ibn Abi Shaybah 22162","","","كتاب البيوع والأقضية"
"22163","(۲۲۱۶۳) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: الْعَدْلُ فِی الْمُسْلِمِینَ مَنْ لَمْ یُطْعَنْ عَلَیْہِ فِی بَطْنٍ، وَلاَ فَرْجٍ۔","","Musannaf Ibn Abi Shaybah 22163","","","كتاب البيوع والأقضية"
"22164","(۲۲۱۶۴) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ صَالِحِ بْنِ حُیٍّ ، عَنْ عَامِرٍ ، قَالَ : تَجُوزُ شَہَادَۃُ الرَّجُلِ الْمُسْلِمِ مَا لَمْ یُصِبْ حَدًّا ، أَوْ یُعْلَمُ عَلَیْہِ خَرِبَۃٌ فِی دِینِہِ۔","","Musannaf Ibn Abi Shaybah 22164","","","كتاب البيوع والأقضية"
"22165","(۲۲۱۶۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عَوْفٍ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ یُجِیزُ شَہَادَۃَ مَنْ صَلَّی إلاَّ أَنْ یَأْتِیَ الْخَصْمُ بِمَا یَجْرَحُہُ بِہِ۔","","Musannaf Ibn Abi Shaybah 22165","","","كتاب البيوع والأقضية"
"22166","(۲۲۱۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ حَبِیبٍ ، قَالَ : سَأَلَ عُمَرُ رَجُلاً ، عنْ رَجُلٍ فَقَالَ : لاَ نَعْلَمُ إلاَّ خَیْرًا ، فَقَالَ : عُمَرُ : حَسْبُک۔","","Musannaf Ibn Abi Shaybah 22166","","","كتاب البيوع والأقضية"
"22167","(۲۲۱۶۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : قَالَ شُرَیْحٌ : ادَّعِ وَأَکْثِرْ وَأَطْنبْ وَأْتِ عَلَی ذَلِکَ بِشُہُودٍ عُدلٍ ، فَإِنَّا قَدْ أُمِرْنَا بِالْعُدلِ ، وَأَنْتَ فَسَلْ عَنْہُ ، فَإِنْ قَالُوا : اللَّہُ أَعْلَمُ ، فَاللَّہُ أَعْلَمُ ۔ یَفْرقُون أَنْ یَقُولُوا : ہُوَ مُرِیبٌ ، وَلاَ تَجُوزُ شَہَادَۃُ مُرِیبٍ ، فَإِنْ قَالُوا : ہُوَمَا عَلِمْنَاہُ عَدْلٌ مُسْلِمٌ ، فَہُوَ إِنْ شَائَ اللَّہُ کَذَلِکَ ، وَتَجُوزُ شَہَادَتُہُ۔","","Musannaf Ibn Abi Shaybah 22167","","","كتاب البيوع والأقضية"
"22168","(۲۲۱۶۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِی، قَالَ: ابْتَعْت جَارِیَۃً وَشَرَطَ عَلَیَّ أَہْلُہَا أَنْ لاَ أَبِیعَ ، وَلاَ أَہَبَ، وَلاَ أَمْہَرَ ، فَإِذَا مِتّ فَہِیَ حُرَّۃٌ ، فَسَأَلْت الْحَکَمَ بْنَ عُتَیْبَۃَ ؟ فَقَالَ : لاَ بَأْسَ بِہِ۔n وَسَأَلْت مَکحُولاً ؟ فقال : لاَ بأس بہ۔ فقلت : تخاف علی منہ؟ قَالَ : بلی ، أرجو لک فیہ أجرین۔n وسألت عَطَائً ، أَوْ سُئِلَ ؟ فَکَرِہَہُ۔n قَالَ الأَوْزَاعِی : فَحَدَّثَنِی یَحْیَی بْنُ أَبِی کَثِیرٍ ، عَنِ الْحَسَنِ ، قَالَ : الْبَیْعُ جَائِزٌ وَالشَّرْطُ بَاطِلٌ۔ وَسَأَلْت عَبْدَۃَ بْنَ أَبِی لُبَابَۃَ ؟ فَقَالَ : ہَذَا فَرْجُ سُوئٍ۔n وَسَأَلْت الزُّہْرِیَّ فَأَخْبَرَنِی : أَنَّ ابْنَ مَسْعُودٍ کَتَبَ إلَی عُمَرَ یَسْأَلُہُ عَنْ جَارِیَۃٍ ابْتَاعَہَا مِنِ امْرَأَتِہِ عَلَی أَنَّہُ إِنْ بَاعَہَا فَہِیَ أَحَقُّ بِہَا بِالثَّمَنِ ، فَقَالَ : عُمَرُ : لاَ تَطَأُ فَرْجًا فِیہِ شَیْئٌ لِغَیْرِک۔","","Musannaf Ibn Abi Shaybah 22168","","","كتاب البيوع والأقضية"
"22169","(۲۲۱۶۹) حَدَّثَنَا وَکِیعٌ ، وَابْنُ أَبِی زَائِدَۃَ ، عَنْ مِسْعَرٍ ، عَنِ الْقَاسِمِ ، قَالَ : قَالَ عُمَرُ : لَیْسَ مِنْ مَالِکِ مَا کَانَ فِیہِ مَثْنَویۃ لِغَیْرِک۔","","Musannaf Ibn Abi Shaybah 22169","","","كتاب البيوع والأقضية"
"22170","(۲۲۱۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمِ بْنِ عُبَیْدِ اللہِ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ : أَنَّہَا کَرِہَتْ أَنْ تُبَاعَ الْجَارِیَۃُ بِشَرْطِ أَنْ لاَ تُبَاعَ۔","Sahih","Musannaf Ibn Abi Shaybah 22170","","","كتاب البيوع والأقضية"
"22171","(۲۲۱۷۱) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ خُصَیْفٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ فِی الرَّجُلِ یَشْتَرِی الْجَارِیَۃَ عَلَی أَنْ لاَ یَبِیعَ ، وَلاَ یہَبُ ، قَالَ : لاَ یَقْرَبُہَا۔","","Musannaf Ibn Abi Shaybah 22171","","","كتاب البيوع والأقضية"
"22172","(۲۲۱۷۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ : أَنَّہُ کَرِہَہَا۔","","Musannaf Ibn Abi Shaybah 22172","","","كتاب البيوع والأقضية"
"22173","(۲۲۱۷۳) حَدَّثَنَا ابْنُ نُمَیْرٍ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ: أَنَّہُ کَانَ یَقُولُ: لاَ تَطَأُ فَرْجًا فِیہِ شَرْطٌ۔","Sahih","Musannaf Ibn Abi Shaybah 22173","","","كتاب البيوع والأقضية"
"22174","(۲۲۱۷۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ : فِی الرَّجُلِ یَشْتَرِی الْجَارِیَۃَ عَلَی أَنْ لاَ یَبِیعَ ، وَلاَ یَہَبَ ، قَالَ : لَیْسَ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 22174","","","كتاب البيوع والأقضية"
"22175","(۲۲۱۷۵) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ : فِی الرَّجُلِ یَشْتَرِی الْجَارِیَۃَ عَلَی أَنْ لاَ یَبِیعَ ، وَلاَ یَہَبَ ، وَلاَ یَمْہَر ، قَالَ : وَدِدْت أَنِّی وَجَدْتہَا فَاشْتَرَیْتہَا بِہَذَا الشَّرْطِ وَأَشْتَرِطُ لَہُمْ أَنَّہَا عَتِیقٌ إذَا مِتّ۔","","Musannaf Ibn Abi Shaybah 22175","","","كتاب البيوع والأقضية"
"22176","(۲۲۱۷۶) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ قَالَ : کُلُّ شَرْطٍ فِی بَیْعٍ یَہْدِمُہُ الْبَیْعُ إلاَّ الْعَتَاقَ ، وَکُلٌّ شَرْطٍ فِی نِکَاحٍ یَہْدِمُہُ النِّکَاحُ إلاَّ الطَّلاَقَ۔","","Musannaf Ibn Abi Shaybah 22176","","","كتاب البيوع والأقضية"
"22177","(۲۲۱۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَتَتِ امْرَأَۃٌ ، فَقَالَتْ : إنَّ ابْنَتِی اُشْتُرِیَتْ عَلَی أَنْ لاَ تُبَاعَ ، قَالَ : ابْنَتُک عَلَی شَرْطِہَا۔","","Musannaf Ibn Abi Shaybah 22177","","","كتاب البيوع والأقضية"
"22178","(۲۲۱۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ بُرْقَانَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ : أَنَّ ابْنَ مَسْعُودٍ اشْتَرَی مِنِ ابنتِہِ زَیْنَبَ جَارِیَۃً وَاشْتَرَطَتْ عَلَیْہِ : إِنْ بَاعَہَا فَہِیَ أَحَقُّ بِہَا بِالثَّمَنِ ، فَسَأَلَ ابْنُ مَسْعُودٍ عُمَرَ فَکَرِہَ أَنْ یَطَأَہَا۔","","Musannaf Ibn Abi Shaybah 22178","","","كتاب البيوع والأقضية"
"22179","(۲۲۱۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عِمْرَانَ بْنِ عُمَیْرٍ : أَنَّ عُمَرَ قَالَ لِعَبْدِ اللہِ : لاَ تَقْرَبْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 22179","","","كتاب البيوع والأقضية"
"22180","(۲۲۱۸۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنِ الْعَلاَئِ بْنِ بَدْرٍ ، عَنْ أَبِی یَحْیَی الأَعْرَجِ ، قَالَ : سُئِلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ عَبْدٍ أَعْتَقَہُ مَوْلاَہُ عِنْدَ مَوْتِہِ وَلَیْسَ لَہُ مَالٌ غَیْرُہُ وَعَلَیْہِ دَیْنٌ ، قَالَ : فَأَمَرَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یَسْعَی فِی الدَّیْنِ۔ (عبدالرزاق ۱۶۷۶۶)","","Musannaf Ibn Abi Shaybah 22180","","","كتاب البيوع والأقضية"
"22181","(۲۲۱۸۱) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : سُئِلَ عَلِیٌّ عَنْ رَجُلٍ أَعْتَقَ عَبْدًا لَہُ عِنْدَ مَوْتِہِ وَلَیْسَ لَہُ مَالٌ غَیْرُہُ ، وَعَلَیْہِ دَیْنٌ ، قَالَ : یُعْتَقُ وَیَسْعَی فِی الْقِیمَۃِ۔","","Musannaf Ibn Abi Shaybah 22181","","","كتاب البيوع والأقضية"
"22182","(۲۲۱۸۲) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الْقَاسِمِ ، قَالَ : أَعْتَقَتِ امْرَأَۃٌ جَارِیَۃً لہا ، لَیْسَ لَہَا مَالٌ غَیْرَہَا فَقَالَ عَبْدُ اللہِ : تَسْعَی فِی قِیمَتِہَا۔","","Musannaf Ibn Abi Shaybah 22182","","","كتاب البيوع والأقضية"
"22183","(۲۲۱۸۳) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ أَعْتَقَ عَبْدًا لَہُ فِی مَرَضِہِ، ثُمَّ مَاتَ وَعَلَیْہِ دَیْنٌ وَلَیْسَ لَہُ مَالٌ غَیْرَہُ ، قَالَ یَسْعَی فِی قِیمَتِہِ ، فَإِنْ کَانَتِ الْقِیمَۃُ أَکْثَرَ مِنَ الدَّیْنِ یَسْعَی لِلْغُرَمَائُ فِی دَیْنِہِمْ ، وَنُظِرَ مَا بَقِیَ مِنْ شَیْئٍ فَلِلْوَرَثَۃِ ثُلُثَاہُ وَلَہُ ثُلُثُہُ۔","","Musannaf Ibn Abi Shaybah 22183","","","كتاب البيوع والأقضية"
"22184","(۲۲۱۸۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ : فِی رَجُلٍ أَعْتَقَ عَبْدَہُ عِنْدَ مَوْتِہِ وَلَیْسَ لَہُ مَالٌ غَیْرُہُ ، قَالَ: یُقَوَّمُ قِیمَۃَ عَدْلٍ ، ثُمَّ یَسْعَی فِی قِیمَتِہِ۔","","Musannaf Ibn Abi Shaybah 22184","","","كتاب البيوع والأقضية"
"22185","(۲۲۱۸۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، أَنَّہُ سُئِلَ عَنْ رَجُلٍ أَعْتَقَ عَبْدًا لَہُ فِی مَرَضِہِ وَلَیْسَ لَہُ مَالٌ غَیْرُہُ ، قَالَ : أُجِیزُہُ بِرمَّتِہِ شَیْئٌ جَعَلَہُ لِلَّہِ لاَ أَرُدُّہُ۔n وَقَالَ شُرَیْحٌ : أُجِیزُ ثُلُثَہُ وَأَسْتَسْعِیَہُ فِی ثُلُثَیْہِ۔","","Musannaf Ibn Abi Shaybah 22185","","","كتاب البيوع والأقضية"
"22186","(۲۲۱۸۶) حَدَّثَنَا ابْنُ مُسْہِرٍ، عَنْ إسْمَاعِیلَ ، قَالَ: قُلْتُ لِلشَّعْبِیِّ : أَیُّ الْقَوْلَیْنِ أَعْجَبُ إلَیْک ؟ قَالَ : قَوْلُ مَسْرُوقٍ أَعْجَبُہُمَا إلَیَّ فِی الْفَتْوَی ، وَقَوْلُ شُرَیْحٍ أَحَبُّ إلَیَّ فِی الْقَضَائِ۔","","Musannaf Ibn Abi Shaybah 22186","","","كتاب البيوع والأقضية"
"22187","(۲۲۱۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : یَعْتِقُ ثُلُثُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 22187","","","كتاب البيوع والأقضية"
"22188","(۲۲۱۸۸) حَدَّثَنَا حُسَینُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، قَالَ : قَالَ إبْرَاہِیمُ فِی رَجُلٍ أَعْتَقَ غُلاَمًا لَہُ عِنْدَ مَوْتِہِ وَلَیْسَ لَہُ مَالٌ غَیْرُہُ ، فَقَالَ إبْرَاہِیمُ : یَعْتِقُ ثُلُثُہُ وَیَسْعَی فِی ثُلُثَیْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 22188","","","كتاب البيوع والأقضية"
"22189","(۲۲۱۸۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا أَوْصَی الرَّجُلُ بِعِتْقِ مَمْلُوکٍ لَہُ ، فَہُوَ مِنَ الثُّلُثِ ، فَإِنْ کَانَ أَکْثَرَ مِنَ الثُّلُثِ یَسْعَی فِیمَا زَادَ۔","","Musannaf Ibn Abi Shaybah 22189","","","كتاب البيوع والأقضية"
"22190","(۲۲۱۹۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، قَالَ : زَعَمُوا أَنَّ الْحَسَنَ کَانَ یَقُولُ فِی رَجُلٍ أَعْتَقَ بَعْضَ مَمْلُوکِہِ عِنْدَ مَوْتِہِ ، قَالَ : یَعْتِقُ مِنْہُ مَا عَتَقَ وَیُسْتَسْعَی فِیمَا بَقِیَ۔","","Musannaf Ibn Abi Shaybah 22190","","","كتاب البيوع والأقضية"
"22191","(۲۲۱۹۱) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ : فِی رَجُلٍ أَعْتَقَ ثُلُثَ عَبْدِہِ فِی مَرَضِہِ ، قَالَ : یُقَامُ فِی ثُلُثِہِ ، فَإِنْ کَانَ أَوْصَی بِوَصَایَا اسْتُسْعِی الْعَبْدَ۔","","Musannaf Ibn Abi Shaybah 22191","","","كتاب البيوع والأقضية"
"22192","(۲۲۱۹۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَعْتَقَ بَعْضَ عَبْدِہِ فِی مَرَضِہِ عَتَقَ کُلُّہُ ، فَإِنْ کَانَ أَکْثَرَ مِنَ الثُّلُثِ سَعَی فِیمَا بَقِیَ مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 22192","","","كتاب البيوع والأقضية"
"22193","(۲۲۱۹۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، قَالَ : سُئِلَ ہِشَامٌ عَنْ رَجُلٍ أَعْتَقَ شَقِیصًا مِنْ مَمْلُوکٍ لَہُ عِنْدَ مَوْتِہِ ، فَحَدَّثَنَا عَنْ حَفْصِ بْنِ سُلَیْمَانَ ، عَنِ الْحَسَنِ ، أَنَّہُ قَالَ : ہُوَ فِی ثُلُثِہِ ، لاَ یَعْدُو ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 22193","","","كتاب البيوع والأقضية"
"22194","(۲۲۱۹۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ۔ وَعَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ ، قَالا : شَہَادَۃُ السَّمْعِ جَائِزَۃٌ۔","","Musannaf Ibn Abi Shaybah 22194","","","كتاب البيوع والأقضية"
"22195","(۲۲۱۹۵) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : لَوْ أَنَّ رَجُلاً سَمِعَ مِنْ قَوْمٍ شَیْئًا فَإِنَّہُ یَأْتِی الْقَاضِی فَیَقُولُ : لَمْ یُشْہِدُونِی ، وَلَکِنِّی سَمِعْت کَذَا وَکَذَا۔","","Musannaf Ibn Abi Shaybah 22195","","","كتاب البيوع والأقضية"
"22196","(۲۲۱۹۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الْحَسَنِ بْنِ فُرَاتٍ ، عَنْ أَبِیہِ فُرَاتٍ ، قَالَ : کَانَ لِی عَلَی رَجُلٍ خَمْسُونَ دِرْہَمًا فَذَہَبْت أَتَقَاضَاہُ وَرَجُلٌ یَسْمَعُ ، فَقُمْت بِہِ إلَی شُرَیْحٍ فَجَحَدَنِی فَقَالَ شُرَیْحٌ : بَیِّنَتُک ، فَقُلْتُ : رَجُلٌ کَانَ یَسْمَعُ وَہُوَ مُقِرٌّ لِی ، فَقَالَ : اُدْعُ بِہِ ، فَدَعَوْت بِہِ فَشَہِدَ ، فَقَالَ : قُمْ فَأَعْطِہِ حَقَّہُ۔","","Musannaf Ibn Abi Shaybah 22196","","","كتاب البيوع والأقضية"
"22197","(۲۲۱۹۷) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ ، عَنْ کُلْثُومِ بْنِ الأَقْمَرِ ، قَالَ : کَانَ شُرَیْحٌ لاَ یُجِیزُ شَہَادَۃَ مُخْتَبِیئٍ۔","","Musannaf Ibn Abi Shaybah 22197","","","كتاب البيوع والأقضية"
"22198","(۲۲۱۹۸) حَدَّثَنَا عَبِیدَۃُ ، عَنْ بَیَانٍ أَبِی بِشْرٍ ، قَالَ : کَانَ الشَّعْبِیُّ لاَ یُجِیزُ شَہَادَۃَ مُخْتَبِیئٍ۔","","Musannaf Ibn Abi Shaybah 22198","","","كتاب البيوع والأقضية"
"22199","(۲۲۱۹۹) حَدَّثَنَا إسحاق بن منصور، عن إسرائیل، عن مغیرۃ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ تجوز شہادۃ المختبیئ۔","","Musannaf Ibn Abi Shaybah 22199","","","كتاب البيوع والأقضية"
"22200","(۲۲۲۰۰) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، أَنَّہُ کَانَ لاَ یُجِیزُ شَہَادَۃَ الْمُخْتَبِئِ ، قَالَ : قَالَ عَمْرُو بْنُ حُرَیْثٍ : کَذَا یُفْعَلُ بِالْخَائِنِ الظَّالِمِ ، أَوْ قَالَ الْفَاجِرِ۔","","Musannaf Ibn Abi Shaybah 22200","","","كتاب البيوع والأقضية"
"22201","(۲۲۲۰۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ وَالشَّعْبِیِّ ، قَالَ : إذَا أَتَاک الْمُشْرِکُونَ فَحَکَّمُوک فِیمَا بَیْنَہُمْ بِحُکْمِ الْمُسْلِمِینَ ، فَلاَ تَعْدُہُ إلَی غَیْرِہِ ، أَوْ أَعْرِضْ عَنْہُمْ ، وَخَلِّہِمْ وَأَہْلَ دِینِہِمْ۔","","Musannaf Ibn Abi Shaybah 22201","","","كتاب البيوع والأقضية"
"22202","(۲۲۲۰۲) حَدَّثَنَا مَعْنُ بْنُ عِیسَی، عَنِ ابْنِ أَبِی ذِئْبٍ، عَنِ الزُّہْرِیِّ، قَالَ: سَأَلْتُ عَنْ حُکُومَۃِ الْیَہُودِ وَالنَّصَارَی إذَا تَحَاکَمُوا إلَیْنَا ؟ فَقَالَ : اُحْکُمْ بَیْنَہُمْ بِحُکْمِکَ فِی الْمُسْلِمِینَ ، لاَ یَجُوزُ بَیْنَہُمْ إلاَّ مَا یَجُوزُ بَیْنَ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 22202","","","كتاب البيوع والأقضية"
"22203","(۲۲۲۰۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : خَلُّوا بَیْنَ أَہْلِ الْکِتَابِ وَبَیْنَ أَحْکَامِہِمْ ، فَإِذَا ارْتَفَعُوا إلَیْکُمْ فَأَقِیمُوا عَلَیْہِمْ مَا فِی کِتَابِکُمْ۔","","Musannaf Ibn Abi Shaybah 22203","","","كتاب البيوع والأقضية"
"22204","(۲۲۲۰۴) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ سِمَاکٍ ، عَنْ قَابُوسَ بْنِ مُخَارِقٍ ، عَنْ أَبِیہِ ، قَالَ : بَعَثَ علی مُحَمَّدَ بْنَ أَبِی بَکْرٍ أَمِیرًا عَلَی مِصْرَ ، فَکَتَبَ مُحَمَّدٌ إلَی عَلِیٍّ یَسْأَلُہُ ، عَنْ مُسْلِمٍ فَجَرَ بِنَصْرَانِیَّۃٍ ؟ فَکَتَبَ عَلِیٌّ : أَنْ أَقِمِ الْحَدَّ عَلَی الْمُسْلِمِ الَّذِی فَجَرَ بِالنَّصْرَانِیَّۃِ ، وَارْفَعِ النَّصْرَانِیَّۃَ إلَی النَّصَارَی یَقْضُونَ فِیہَا مَا شَاؤُوا۔","Hasan","Musannaf Ibn Abi Shaybah 22204","","","كتاب البيوع والأقضية"
"22205","(۲۲۲۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ السُّدِّیِّ ، عَنْ عِکْرِمَۃَ ، قَالَ : نُسِخَتْ ہَذِہِ الآیَۃُ {وَأَنِ احْکُمْ بَیْنَہُمْ بِمَا أَنْزَلَ اللَّہُ} {اُحْکُمْ بَیْنَہُمْ ، أَوْ أَعْرِضْ عَنْہُمْ}۔ (طبری ۲۴۵)","","Musannaf Ibn Abi Shaybah 22205","","","كتاب البيوع والأقضية"
"22206","(۲۲۲۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عِکْرِمَۃَ ، عَنْ عَطَائٍ ، قَالَ : إِنْ شَائَ حَکَمَ ، وَإِنْ شَائَ لَمْ یَحْکُمْ۔","","Musannaf Ibn Abi Shaybah 22206","","","كتاب البيوع والأقضية"
"22207","(۲۲۲۰۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : رَجَمَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَہُودِیًّا بَعَثَتْ بِہِ إِلَیْہِ یَہُودُ مَعَ یَہُودِیٍّ وَمُنَافِقٍ۔ (ابوداؤد ۴۴۴۹)","","Musannaf Ibn Abi Shaybah 22207","","","كتاب البيوع والأقضية"
"22208","(۲۲۲۰۸) حَدَّثَنَا شَرِیکٌ، عَنْ سِمَاکٍ، عَنْ جَابِرِ بْنِ سَمُرَۃَ: أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجَمَ یَہُودِیًّا وَیَہُودِیَّۃً۔n(ترمذی ۱۴۳۷۔ احمد ۵/۹۱)","Hasan","Musannaf Ibn Abi Shaybah 22208","","","كتاب البيوع والأقضية"
"22209","(۲۲۲۰۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ وَحَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَش ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ : عنِ الْبَرَائِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجَمَ یَہُودِیًّا۔ (مسلم ۱۳۲۷۔ ابوداؤد ۴۴۴۴)","Sahih","Musannaf Ibn Abi Shaybah 22209","","","كتاب البيوع والأقضية"
"22210","(۲۲۲۱۰) حَدَّثَنَا عبد الرحیم بن سلیمان ، عَنْ مجالد ، عن عامر ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجَمَ یَہُودِیًّا وَیَہُودِیَّۃً۔ (مسلم ۱۳۲۸۔ ابوداؤد ۴۴۴۸)","Da'if","Musannaf Ibn Abi Shaybah 22210","","","كتاب البيوع والأقضية"
"22211","(۲۲۲۱۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجَمَ یَہُودِیَّیْنِ أَنَا فِیمَنْ رَجَمَہُمَا۔ (مسلم ۱۳۲۶۔ ابوداؤد ۴۴۴۳)","Sahih","Musannaf Ibn Abi Shaybah 22211","","","كتاب البيوع والأقضية"
"22212","(۲۲۲۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ مُحَمَّدِ بْنِ کُرْدُوسٍ ، عَنْ أَبِیہِ : أَنَّ رَجُلاً حُدَّ فِی الْخَمْرِ، فَشَہِدَ عِنْدَ شُرَیْحٍ ، فَسَأَلَنِی عَنْہُ ؟ فَقُلْتُ : مِنْ خَیْرِ شَبَابِنَا ، فَأَجَازَ شَہَادَتَہُ۔","","Musannaf Ibn Abi Shaybah 22212","","","كتاب البيوع والأقضية"
"22213","(۲۲۲۱۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ سِمَاکِ بْنِ حَرْبٍ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، عَنِ ابْنِ عُمَرَ : أَنَّ عُمَرَ کَتَبَ إلَی أَبِی مُوسَی فِی رَجُلٍ شَرِبَ الْخَمْرَ : إِنْ تَابَ فَاقْبَلْ شَہَادَتَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 22213","","","كتاب البيوع والأقضية"
"22214","(۲۲۲۱۴) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ، عَنِ الشَّعْبِیِّ: أَنَّہُ أَجَازَ شَہَادَۃَ رَجُلٍ ضُرِبَ فِی الْخَمْرِ۔","","Musannaf Ibn Abi Shaybah 22214","","","كتاب البيوع والأقضية"
"22215","(۲۲۲۱۵) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ : أَنَّہُ أَجَازَ شَہَادَۃَ الأَخِ لأَخِیہِ۔","","Musannaf Ibn Abi Shaybah 22215","","","كتاب البيوع والأقضية"
"22216","(۲۲۲۱۶) حَدَّثَنَا ابْن فضیل ، عن عطاء بن أبی رباح ، قَالَ : کان بین رجلین من الحی خصومۃ ، فشہد لأحدہما أخوہ لأبیہ وأمہ عند شریح ، فقال الرجل : أنت أخوہ ، قَالَ : فہل لک من الذی تشہد علیہ شیء ؟ قَالَ : لاَ ، قَالَ لخصمہ : فبأی شیء أرد شہادتہ؟۔","","Musannaf Ibn Abi Shaybah 22216","","","كتاب البيوع والأقضية"
"22217","(۲۲۲۱۷) حَدَّثَنَا أبو معاویۃ ، عن عاصم ، عن الشعبی ، قَالَ : أدنی ما تجوز شہادتہ : شہادۃ الأخ لأخیہ۔","","Musannaf Ibn Abi Shaybah 22217","","","كتاب البيوع والأقضية"
"22218","(۲۲۲۱۸) حَدَّثَنَا ابن مہدی، عن حماد بن سلمۃ، عن أبی ہاشم، عَنْ إبْرَاہِیمَ ، قَالَ: تجوز شہادۃ الأخ لأخیہ۔","","Musannaf Ibn Abi Shaybah 22218","","","كتاب البيوع والأقضية"
"22219","(۲۲۲۱۹) حَدَّثَنَا ابن مہدی ، عن سفیان ، عن عثمان البتی ، عن الشعبی : بمثلہ۔","","Musannaf Ibn Abi Shaybah 22219","","","كتاب البيوع والأقضية"
"22220","(۲۲۲۲۰) حَدَّثَنَا روح بن عبادۃ ، عن ابن جریج ، عن مزاحم بن أبی مزاحم ، عن ابن أبی یزید ، عن ابن الزبیر: أنہ أجاز شہادۃ الأخ لأخیہ۔","","Musannaf Ibn Abi Shaybah 22220","","","كتاب البيوع والأقضية"
"22221","(۲۲۲۲۱) حَدَّثَنَا مُحَمَّدِ بْنِ عَبْدِ اللہِ الأَنْصَارِیِّ ، عَنْ إسْمَاعِیلَ ، عَنِ الْحَسَنِ ، قَالَ : تَجُوزُ شَہَادَۃُ الأَخِ لأَِخِیہِ۔","","Musannaf Ibn Abi Shaybah 22221","","","كتاب البيوع والأقضية"
"22222","(۲۲۲۲۲) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنِ الشَّعْبِیِّ، عَنْ شُرَیْحٍ، قَالَ: تَجُوزُ شَہَادَۃُ الأَخِ لأَخِیہِ إذَا کَانَ عَدْلاً۔","","Musannaf Ibn Abi Shaybah 22222","","","كتاب البيوع والأقضية"
"22223","(۲۲۲۲۳) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ حَرْبِ بْنِ عُبَیْدِ اللہِ ، عَنْ شُرَیْحٍ : أَنَّہُ أَجَازَ شَہَادَۃَ أَخٍ لأَخِیہِ۔","","Musannaf Ibn Abi Shaybah 22223","","","كتاب البيوع والأقضية"
"22224","(۲۲۲۲۴) حَدَّثَنَا شَرِیکٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ ، قَالَ : نَکَلَ رَجُلٌ عِنْدَ شُرَیْحٍ عَنِ الْیَمِینِ ، فَقَضَی شُرَیْحٌ ، فَقَالَ الرَّجُلُ : أَنَا أَحْلِفُ ، فَقَالَ شُرَیْحٌ : قَدْ مَضَی قَضَائِی۔","","Musannaf Ibn Abi Shaybah 22224","","","كتاب البيوع والأقضية"
"22225","(۲۲۲۲۵) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّہُ أَمَرَہُ أَنْ یَسْتَحْلِفَ امْرَأَۃً فَأَبَتْ أَنْ تَحْلِفَ فَأَلْزَمَہَا ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 22225","","","كتاب البيوع والأقضية"
"22226","(۲۲۲۲۶) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَالِمٍ : أَنَّ ابْنَ عُمَرَ بَاعَ غُلاَمًا لَہُ بِثَمَانِمِئَۃِ دِرْہَمٍ ، فَوَجَدَ بِہِ الْمُشْتَرِی عَیْبًا فَخَاصَمَہُ إلَی عُثْمَانَ ، فَقَالَ لَہُ : عُثْمَانُ : بِعْتہ بِالْبَرَائَۃِ ، فَأَبَی أَنْ یَحْلِفَ ، فَرَدَّہُ عُثْمَانُ عَلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 22226","","","كتاب البيوع والأقضية"
"22227","(۲۲۲۲۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، وَابْنِ شُبْرُمَۃَ ، قَالاَ : اشْتَرَی عَبْدُ اللہِ غُلاَمًا لاِمْرِئٍ ، فَلَمَّا ذَہَبَ بِہِ إلَی مَنْزِلِہِ حُمَّ الْغُلاَمُ ، فَجَاء لِیرُد الْغُلاَم ، فَخَاصَمَہُ إلَی الشَّعْبِیِّ فَقَالَ لِعَبْدِ اللہِ : بَیِّنَتُک أَنَّہُ دَلَّسَ لَکَ عَیْبًا ؟ فَقَالَ : لَیْسَ لِی بَیِّنَۃٌ ، فَقَالَ : لِلرَّجُلِ : احْلِفْ أَنَّک لَمْ تَبِعْہُ ذَا دَائٍ ، فَقَالَ الرَّجُلُ : إنِّی أَرُدُّ الْیَمِینَ عَلَی عَبْدِ اللہِ ، فَقَضَی الشَّعْبِیُّ بِالْیَمِینِ عَلَیْہِ ، فَقَالَ : إمَّا أَنْ تَحْلِفَ وَإِلاَّ جَازَ عَلَیْک الْغُلاَمُ۔","","Musannaf Ibn Abi Shaybah 22227","","","كتاب البيوع والأقضية"
"22228","(۲۲۲۲۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ نَافِعٍ ، قَالَ : کَانَ زَیْدُ بنُ ثَابت یَأْخُذُ عَلَی الْقَضَائِ أَجْرًا۔","","Musannaf Ibn Abi Shaybah 22228","","","كتاب البيوع والأقضية"
"22229","(۲۲۲۲۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنِ الأَعْمَش، عَنِ الْقَاسِمِ، عَنْ مَسْرُوقٍ: أَنَّہُ کَانَ لاَ یَأْخُذُ عَلَی الْقَضَائِ أَجْرًا۔n وَذَکَرَ عَنِ الْقَاسِمِ نَحْوَہُ ، أَوْ شَیء ہَذَا مَعْنَاہُ۔","","Musannaf Ibn Abi Shaybah 22229","","","كتاب البيوع والأقضية"
"22230","(۲۲۲۳۰) حَدَّثَنَا مُحَمَّدُ بْنُ مَرْوَانَ الْبَصْرِیُّ ، عَنْ یُونُسَ بْنِ أَبِی الْفُرَاتِ ، عَنِ الْحَسَنِ ، قَالَ : أَکْرَہُ أَنْ آخُذَ عَلَی الْقَضَائِ أَجْرًا۔","","Musannaf Ibn Abi Shaybah 22230","","","كتاب البيوع والأقضية"
"22231","(۲۲۲۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الْحُصَیْنِ ، عَنِ الْقَاسِمِ ، عَنْ عُمَرَ ، قَالَ : لاَ یَنْبَغِی لِقَاضِی الْمُسْلِمِینَ أَنْ یَأْخُذَ أَجْرًا ، وَلاَ صَاحِبِ مَغْنَمِہِمْ۔","","Musannaf Ibn Abi Shaybah 22231","","","كتاب البيوع والأقضية"
"22232","(۲۲۲۳۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَأْخُذَ الْقَاضِیَ رِزْقًا مِنْ بَیْتِ مَالِ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 22232","","","كتاب البيوع والأقضية"
"22233","(۲۲۲۳۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : بَلَغَنَا ، أَوْ قَالَ : بَلَغَنِی ، أَنَّ عَلِیًّا رَزَقَ شُرَیْحًا خَمْسَمِئَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 22233","","","كتاب البيوع والأقضية"
"22234","(۲۲۲۳۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ یُنْہَی عَنْ بَیْعِ الثَّمَرَۃِ حَتَّی تُطْعِمَ ، وَقَالَ ابْنُ عُمَرَ : حَتَّی یَبْدُو صَلاَحُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 22234","","","كتاب البيوع والأقضية"
"22235","(۲۲۲۳۵) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ وَکِیعٍ ، عَنْ مِسْعَرٍ ، عَنِ الْقَاسِمِ ، قَالَ : قَالَ عُمَرُ : مِنَ الرِّبَا أَنْ تُبَاعَ الثَّمَرَۃُ وَہِیَ مُغَضَّفَۃٌ لَم تَطِبْ۔","","Musannaf Ibn Abi Shaybah 22235","","","كتاب البيوع والأقضية"
"22236","(۲۲۲۳۶) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ ، قَالَ : لاَ تُسْلِم فِی نَخْلٍ حَتَّی یَصْفَرَّ ، أَوْ یَحْمَرَّ، وَلاَ فِی فِرَاخ زَرْعٍ وَہُوَ أَخْضَرُ حَتَّی یُسَنْبِلَ۔","","Musannaf Ibn Abi Shaybah 22236","","","كتاب البيوع والأقضية"
"22237","(۲۲۲۳۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ بَیْعِ الثَّمَرَۃِ حَتَّی یَبْدُوَ صَلاَحُہَا۔ (بخاری ۲۱۸۳۔ مسلم ۱۱۶۷)","Sahih","Musannaf Ibn Abi Shaybah 22237","","","كتاب البيوع والأقضية"
"22238","(۲۲۲۳۸) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ حَمَّادٍ، عَنْ إبْرَاہِیمَ، قَالَ: لاَ یُبَاعُ النَّخْلُ حَتَّی یَشْتَدَّ نَوَاہُ وَتُؤْمَنَ عَلَیْہِ الآفَۃُ۔","","Musannaf Ibn Abi Shaybah 22238","","","كتاب البيوع والأقضية"
"22239","(۲۲۲۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزِّنَادِ ، عَنْ خَارِجَۃَ بْنِ زید بن ثَابِتٍ : أَنَّہُ کَانَ یَبِیعُ ثَمَرَتَہُ إذَا طَلَعَتِ الثُّرَیَّا۔","Sahih","Musannaf Ibn Abi Shaybah 22239","","","كتاب البيوع والأقضية"
"22240","(۲۲۲۴۰) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ وَأَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : نَہَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ بَیْعِ الثِّمَارِ حَتَّی یَبْدُوَ صَلاَحُہَا۔ (مسلم ۸۶۔ احمد ۳/۳۸۱)","","Musannaf Ibn Abi Shaybah 22240","","","كتاب البيوع والأقضية"
"22241","(۲۲۲۴۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی کَثِیرٍ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ الْمُسَیَّبِ یَقُولُ: لاَ تُبَاعُ الثَّمَرَۃُ حَتَّی تَزْہُوَ وَتُؤْمَنَ عَلَیْہَا الآفَۃُ۔","","Musannaf Ibn Abi Shaybah 22241","","","كتاب البيوع والأقضية"
"22242","(۲۲۲۴۲) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : نَہَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ بَیْعِ الثَّمَرَۃِ حَتَّی یَبْدُوَ صَلاَحُہَا ، قِیلَ لأَنَسٍ : وَمَا بُدُوُّ صَلاَحِہَا ؟ قَالَ : تَحْمَرُّ ، أَوْ تَصْفَرُّ۔ (بخاری ۲۱۹۸۔ مسلم ۱۱۹۰)","Sahih","Musannaf Ibn Abi Shaybah 22242","","","كتاب البيوع والأقضية"
"22243","(۲۲۲۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ بُکَیْرِ بْنِ عَامِرٍ ، عن عامر ، قَالَ : لاَ یُبَاعُ النَّخْلُ حَتَّی یَحْمَرَّ ، أَوْ یَصْفَرَّ۔","","Musannaf Ibn Abi Shaybah 22243","","","كتاب البيوع والأقضية"
"22244","(۲۲۲۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا احْمَرَّ بَعْضُہُ فَلاَ بَأْسَ بِشِرَائِہِ۔","","Musannaf Ibn Abi Shaybah 22244","","","كتاب البيوع والأقضية"
"22245","(۲۲۲۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ أُمِّ ثَوْرٍ ، عَنْ زَوْجِہَا بِشْرٍ ، قَالَ : قُلْتُ لاِبْنِ عَبَّاسٍ : مَتَی یُبَاعُ النَّخْلُ ؟ قَالَ : إذَا احْمَرَّ ، أَوِ اصْفَرَّ۔","Da'if","Musannaf Ibn Abi Shaybah 22245","","","كتاب البيوع والأقضية"
"22246","(۲۲۲۴۶) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ، أَنَّ زَیْدَ بْنَ ثَابِتٍ قَالَ: لاَ تَبْتَاعُوا الثَّمَرَۃَ حَتَّی تَطْلُعَ الثُّرَیَّا۔n قَالَ الزُّہْرِیُّ : فَذَکَرْت ذَلِکَ لِسَالِمِ بْنِ عَبْدِ اللہِ فَقَالَ : إنَّ الْعَاہَۃَ تَکُونُ بَعْدَ طُلُوعِ الثُّرَیَّا۔n(عبدالرزاق ۱۴۳۱۶)","","Musannaf Ibn Abi Shaybah 22246","","","كتاب البيوع والأقضية"
"22247","(۲۲۲۴۷) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ زَیْدِ بْنِ جُبَیْرٍ ، قَالَ : سَأَلَ رَجُلٌ ابْنَ عُمَرَ ، عَنْ شِرَاء الثَّمَرَۃِ ؟ فَقَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تُبَاعَ الثَّمَرَۃُ حَتَّی یَبْدُوَ صَلاَحُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 22247","","","كتاب البيوع والأقضية"
"22248","(۲۲۲۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ مَسْرُوقٍ ، عَنْ عُمَرَ وَعَبْدِ اللہ ، أَنَّہُمَا قَالاَ : لاَ یُبَاعُ النَّخْلُ حَتَّی یَحْمَرَّ ، أَوْ یَصْفَرَّ۔","Da'if","Musannaf Ibn Abi Shaybah 22248","","","كتاب البيوع والأقضية"
"22249","(۲۲۲۴۹) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ أَنْ لاَ تُبَاعَ الثَّمَرَۃُ حَتَّی یَبْدُوَ صَلاَحُہَا۔","","Musannaf Ibn Abi Shaybah 22249","","","كتاب البيوع والأقضية"
"22250","(۲۲۲۵۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ یَزِیدَ بْنِ خُمَیْرٍ ، عَنْ مَوْلًی لِقُرَیْشٍ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یُحَدِّثُ مُعَاوِیَۃَ ، قَالَ : نَہَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ بَیْعِ الثِّمَارِ حَتَّی تُحْرَزَ مِنْ کُلِّ عَارِضٍ۔n(ابوداؤد ۳۳۶۲۔ احمد ۲/۳۸۷)","Da'if","Musannaf Ibn Abi Shaybah 22250","","","كتاب البيوع والأقضية"
"22251","(۲۲۲۵۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : حدَّثَنَا الْقَاسِمُ وَمَکْحُولٌ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : نَہَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ بَیْعِ الثَّمَرَۃِ حَتَّی یَبْدُوَ صَلاَحُہَا۔ (طبرانی ۷۵۹۲)","Da'if","Musannaf Ibn Abi Shaybah 22251","","","كتاب البيوع والأقضية"
"22252","(۲۲۲۵۲) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطِیَّۃَ ، عَنْ أَبِی سَعِیدٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ : لاَ تَبْتَاعُوا الثَّمَرَۃَ حَتَّی یَبْدُوَ صَلاَحُہَا ، قَالُوا : وَمَا بُدُوُّ صَلاَحِہَا ؟ قَالَ : حَتَّی تَذْہَبَ عَاہَتُہَا وَیَخْلُصَ طِیبُہَا۔","Da'if","Musannaf Ibn Abi Shaybah 22252","","","كتاب البيوع والأقضية"
"22253","(۲۲۲۵۳) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، قَالَ : حدَّثَنَا فُضَیْلُ بْنُ غَزْوَانَ ، عَنِ ابْنِ أَبِی نُعمٍ ، عَنْ أَبِی ہُرَیْرَۃَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ بَیْعِ الثَّمَرَۃِ حَتَّی یَبْدُوَ صَلاَحُہَا۔ (مسلم ۵۶۔ احمد ۲/۲۶۲)","Sahih","Musannaf Ibn Abi Shaybah 22253","","","كتاب البيوع والأقضية"
"22254","(۲۲۲۵۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنْ عُبَیْدِ اللہِ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ ، قَالَ : یَأْخُذُ السید مِنْ مَالِ مَمْلُوکِہِ مَا شَائَ۔","Sahih","Musannaf Ibn Abi Shaybah 22254","","","كتاب البيوع والأقضية"
"22255","(۲۲۲۵۵) حَدَّثَنَا أَزْہَرُ السَّمَّانُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سُئِلَ مُحَمَّدٌ عَنِ الرَّجُلِ یَأْخُذُ مِنْ مَالِ عَبْدِہِ ؟ فَقَالَ : لاَ أَعْلَمُ ذَلِکَ مِنَ الإِحْسَانِ۔","","Musannaf Ibn Abi Shaybah 22255","","","كتاب البيوع والأقضية"
"22256","(۲۲۲۵۶) حَدَّثَنَا شَبَابَۃُ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ قُسَیْط ، عَنْ رَافِعِ بْنِ خَدِیجٍ وَجَابِرِ بْنِ عَبْدِ اللہِ وَأَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالُوا : مَنْ کَانَ لَہُ عَبْدٌ مُخَارَجٌ وَأَمَۃٌ یَطُوفُ عَلَیْہَا فَلَیْسَ لَہُ أَنْ یَأْخُذَ مِمَّا أَعْطَاہُما شَیْئًا۔","Sahih","Musannaf Ibn Abi Shaybah 22256","","","كتاب البيوع والأقضية"
"22257","(۲۲۲۵۷) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حُصَیْنٍ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : أن لاَ یَقْعُدَنَّ قَاضٍ فِی الْمَسْجِدِ یَدْخُلُ عَلَیْہِ فِیہِ الْمُشْرِکُونَ فَإِنَّہُمْ نَجَسٌ ، قَالَ اللَّہُ تَعَالَی : {إنَّمَا الْمُشْرِکُونَ نَجَسٌ}۔","","Musannaf Ibn Abi Shaybah 22257","","","كتاب البيوع والأقضية"
"22258","(۲۲۲۵۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنِ الْمُثَنَّی بن سَعِیدٍ ، قَالَ : رَأَیْتُ الْحَسَنَ وَزُرَارَۃَ بْنَ أَوْفَی یَقْضِیَانِ فِی الرَّحْبَۃِ خَارِجًا مِنَ الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 22258","","","كتاب البيوع والأقضية"
"22259","(۲۲۲۵۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ قَیْسٍ ، قَالَ : رَأَیْتُ یَحْیَی بْنَ یَعْمُرَ یَقْضِی فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 22259","","","كتاب البيوع والأقضية"
"22260","(۲۲۲۶۰) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنِ الْجَعْدِ بْنِ ذَکْوَانَ، عَنْ شُرَیْحٍ: أَنَّہُ کَانَ إذَا کَانَ یَوْمُ مَطِیرٍ قَضَی فِی دَارِہِ۔","","Musannaf Ibn Abi Shaybah 22260","","","كتاب البيوع والأقضية"
"22261","(۲۲۲۶۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنِ ابْنِ أبی غنیۃ ، قَالَ : رَأَیْتُ الْحَسَنَ یَقْضِی فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 22261","","","كتاب البيوع والأقضية"
"22262","(۲۲۲۶۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ وَقَتَادَۃَ ، قَالاَ : أَہْلُ الْکِتَابِ ، وَالْعَبْدُ ، وَالصَّبِیُّ إذَا کَانَتْ عِنْدَہُمْ شَہَادَۃٌ ، فَأَسْلَمَ أَہْلُ الْکِتَابِ ، وَعَتَقَ الْعَبْدُ ، وَشَبَّ الصَّبِیُّ ، فَشَہَادَتُہُمْ جَائِزَۃٌ ، إلاَّ أَنْ تَکُونَ رُدَّتْ وَہُمْ کَذَلِکَ۔","","Musannaf Ibn Abi Shaybah 22262","","","كتاب البيوع والأقضية"
"22263","(۲۲۲۶۳) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِی ، عَنِ الزُّہْرِیِّ : فِی الْعَبْدِ یَشْہَدُ بِالشَّہَادَۃِ فَتُرَدُّ ، ثُمَّ یَعْتِقُ ، قَالَ : لاَ یَجُوزُ۔","","Musannaf Ibn Abi Shaybah 22263","","","كتاب البيوع والأقضية"
"22264","(۲۲۲۶۴) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ یَقُولُ فِی الْعَبْدِ وَالذِّمِّیِّ إذَا شَہِدَا فَرُدَّتْ شَہَادَتُہُمَا ، ثُمَّ عَتَقَ ہَذَا ، أَوْ أَسْلَمَ ہَذَا : إنَّہَا تَجُوزُ شَہَادَتُہُمَا۔","","Musannaf Ibn Abi Shaybah 22264","","","كتاب البيوع والأقضية"
"22265","(۲۲۲۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا شَہِدَ الْعَبْدُ فَرُدَّتْ شَہَادَتُہُ ، ثُمَّ أُعْتِقَ ، قَالَ : لاَ تَجُوزُ ، وَقَالَ الْحَکَمُ : تَجُوزُ۔","","Musannaf Ibn Abi Shaybah 22265","","","كتاب البيوع والأقضية"
"22266","(۲۲۲۶۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ أَبِی عَوَانَۃَ ، عَنْ عُمَرَ بْنِ أَبِی سَلَمَۃَ ، عَنْ أَبِیہِ ، قَالَ : إذَا شَہِدَ الْعَبْدُ فَرُدَّتْ شَہَادَتُہُ ، ثُمَّ أُعْتِقَ فَإِنَّہَا لاَ تَجُوزُ۔","","Musannaf Ibn Abi Shaybah 22266","","","كتاب البيوع والأقضية"
"22267","(۲۲۲۶۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنْ شُرَیْحٍ ، أَنَّہُ قَالَ : إذَا شَہِدَ الْعَبْدُ فَرُدَّتْ شَہَادَتُہُ ، ثُمَّ أُعْتِقَ ، قَالَ : فَإِنَّہَا لاَ تَجُوزُ۔","","Musannaf Ibn Abi Shaybah 22267","","","كتاب البيوع والأقضية"
"22268","(۲۲۲۶۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ وَعَطَائٍ : أَنَّ عُمَرَ بْنَ الْخَطَّابِ قَالَ فِی الْیَہُودِیِّ وَالنَّصْرَانِیِّ وَالْعَبْدِ : إذا شہدوا شہادۃ لم یقیموہا حتی یُعتَق ویسلم الیہودی والنصرانی ، فَشَہَادَتُہُمْ جَائِزَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 22268","","","كتاب البيوع والأقضية"
"22269","(۲۲۲۶۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِی ، قَالَ : حدَّثَنی ابْنُ سُرَاقَۃَ : أَنَّ أَبَا عُبَیْدَۃَ بْنَ الْجَرَّاحِ کَتَبَ لأَہْلِ دَیْرِ طَیَایَا : إنِّی أَمَّنْتُکُمْ عَلَی دِمَائِکُمْ وَأَمْوَالِکُمْ وَکَنَائِسِکُمْ أَنْ تُخَرَّبَ ، أَوْ تُکْسر مَا لَمْ تُحْدِثُوا ، أَوْ تُؤْوُوا مُحْدِثًا مَغِیلَۃً ، فَإِنْ أَنْتُمْ أَحْدَثْتُمْ ، أَوْ أَوَیْتُمْ مُحْدِثًا مَغِیلَۃً ، فَقَدْ بَرِئَتْ مِنْکُمُ الذِّمَّۃُ ، وَإِنَّ عَلَیْکُمْ إنْزَالَ الضَّیْفِ ثَلاَثَۃَ أَیَّامٍ ، وَإِنَّ ذِمَّتَنَا بَرِیئَۃٌ مِنْ مَعَرَّۃِ الْجَیْشِ ۔ شَہِدَ خَالِدُ بْنُ الْوَلِیدِ وَیَزِیدُ بْنُ أَبِی سُفْیَانَ وَشُرَحْبِیلُ بْنُ حَسَنَۃَ وَقُضَاعِی بْنُ عَامِرٍ وَکَتَبَ۔ (سعید بن منصور ۲۶۰۵)","Hasan","Musannaf Ibn Abi Shaybah 22269","","","كتاب البيوع والأقضية"
"22270","(۲۲۲۷۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، قَالَ : مَرَّ عُمَرُ بْنُ الْخَطَّابِ بِکَاتِبٍ یَکْتُبُ بَیْنَ النَّاسِ وَہُوَ یُشْہِدُ أَکْثَرَ مِنِ اثْنَیْنِ فَنَہَاہُ ، ثُمَّ مَرَّ بَعْدُ فَقَالَ : أَلَمْ أَنْہَکَ ؟ فَقَالَ الرَّجُلُ : أَطَعْت اللَّہَ وَعَصَیْتُک۔n وَکَانَ فِی صَدَقَۃِ عُمَرَ: شَہِدَ عَبْدُاللہِ بْنُ الأَرْقَمِ وَمُعَیْقِیبٌ۔ وَکَانَ فِی صَدَقَۃِ عَلِیٍّ شَہِدَ فُلاَنٌ وَفُلاَنٌ، وَکَتَبَ۔","","Musannaf Ibn Abi Shaybah 22270","","","كتاب البيوع والأقضية"
"22271","(۲۲۲۷۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ أَبِی الْجَرَّاحِ ، قَالَ: حدَّثَنِی مُوسَی بْنُ سَالِمٍ، قَالَ: لَمَّا أَجْلَی الْحَجَّاجُ أَہْلَ الأَرْضِ أَتَتْنِی امْرَأَۃٌ بِکِتَابٍ زَعَمَتْ أَنَّ الَّذِی أُعْتِقَ أَبُوہَا : ہَذَا مَا اشْتَرَی طَلْحَۃُ بْنُ عُبَیْدِ اللہِ مِنْ فُلاَنِ بن فلان ، اشْتَرَی مِنْہُ فَتَاہُ دِینَارًا أَوْ دِرْہَمًا بِخَمْسِمِئَۃِ دِرْہَمٍ بِالْجَیِّدِ وَالطَّیِّبِ وَالْحَسَنِ ، وَقَدْ دَفَعَ إلَیْہِ الثَّمَنَ وَأَعْتَقَہُ لِوَجْہِ اللہِ ، فَلَیْسَ لأَحَدٍ عَلَیْہِ سَبِیلٌ إلاَّ سَبِیلَ الْوَلاَئِ ، فَشَہِدَ الزُّبَیْرُ بْنُ الْعَوَّامِ وَعَبْدُ اللہِ بْنُ عَامِرٍ وَزِیَادٌ۔","Da'if","Musannaf Ibn Abi Shaybah 22271","","","كتاب البيوع والأقضية"
"22272","(۲۲۲۷۲) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا اشْتَرَی الرَّجُلُ الْجَارِیَۃَ عِنْدَہُ وَبِہَا عَیْبٌ وَحَدَثَ بِہَا عَیْبٌ آخَرُ ، قَالَ : أَبْطَلَ الآخَرُ الأَوَّلَ۔","","Musannaf Ibn Abi Shaybah 22272","","","كتاب البيوع والأقضية"
"22273","(۲۲۲۷۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، أَنَّہُ کَانَ یَقُولُ : إذَا حَدَثَ عِنْدَہُ دَائٌ غَیْرُ الَّذِی دُلِّسَ لَہُ فَإِنَّہُ یَمْضِی عِنْدَہُ وَیَضَعُ عَنْہُ مَا یَضَعُ ذَلِکَ الدَّائُ مِنْ ثَمَنِہِ۔","","Musannaf Ibn Abi Shaybah 22273","","","كتاب البيوع والأقضية"
"22274","(۲۲۲۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ : رُدَّ الدَّائُ بِدَائِہِ ، فَإِنْ حَدَثَ عَیْبٌ فَہُوَ مِنْ مَالِ الْمُشْتَرِی ، وَیَرُدُّ الْبَائِعُ قِیمَۃَ الْعَیبِ۔","","Musannaf Ibn Abi Shaybah 22274","","","كتاب البيوع والأقضية"
"22275","(۲۲۲۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : ہُوَ مِنْ مَالِ الْمُشْتَرِی ، وَیَرُدُّ الْبَائِعُ قِیمَۃَ الْعَیْبِ۔","","Musannaf Ibn Abi Shaybah 22275","","","كتاب البيوع والأقضية"
"22276","(۲۲۲۷۶) حَدَّثَنَا جَرِیرٌ ، عَنْ أَبِی سِنَانٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، قَالَ : مَرَّ رَجُلٌ بِقَوْمٍ فِیہِمْ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَمَعَہُ ثَوْبٌ ، أَرَاہُ قَالَ : بُرْد ، فَقَالَ لَہُ بَعْضُہُمْ : بِکَمِ ابْتَعْت ؟ أَرَاہُ قَالَ : ہُوَ بِزِیَادَۃٍ عَلَی ثَمَنِہِ ، ثُمَّ قَالَ : کَذَبْت ، وَفِیہِمْ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَرَجَعَ فَقَالَ : یَا رَسُولَ اللہِ ، ابْتَعْتہ بِکَذَا وَکَذَا بِدُونِ مَا کَانَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَصَدَّقْ بِالْفَضْلِ۔ (ابوداؤد ۱۶۴)","","Musannaf Ibn Abi Shaybah 22276","","","كتاب البيوع والأقضية"
"22277","(۲۲۲۷۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَرِہَ السَّلَمَ فِی اللَّحْمِ۔","","Musannaf Ibn Abi Shaybah 22277","","","كتاب البيوع والأقضية"
"22278","(۲۲۲۷۸) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِالسَّلَمِ فِی الرُّؤُوسِ إذَا أرَاہُ قَدْرًا مَعْلُومًا۔","","Musannaf Ibn Abi Shaybah 22278","","","كتاب البيوع والأقضية"
"22279","(۲۲۲۷۹) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ، عَنِ أبی عَمْرٍو، عَنْ قَیْسِ بْنِ سَعْدٍ، عَنْ طَاوُوسٍ: أَنَّہُ کَرِہَ اللَّحْمَ بِالْقَدِیدِ نَسِیئَۃً۔","","Musannaf Ibn Abi Shaybah 22279","","","كتاب البيوع والأقضية"
"22280","(۲۲۲۸۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالسَّلَمِ فِی اللَّحْمِ إذَا کَانَ لَہُ حَدٌّ یُعْلَمُ۔","","Musannaf Ibn Abi Shaybah 22280","","","كتاب البيوع والأقضية"
"22281","(۲۲۲۸۱) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ : أَنَّہُ کَرِہَ لُبْسَ الْحَرِیرِ وَالسَّابِرِیِّ الرَّقِیقِ وَالتِّجَارَۃَ فِیہِمَا۔","","Musannaf Ibn Abi Shaybah 22281","","","كتاب البيوع والأقضية"
"22282","(۲۲۲۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْن مِغْوَلٍ ، قَالَ : سَمِعْتُ أَزْہَرَ سَأَلَ عَطَائً عَنْ بَیْعِ الْخُمُرِ الرِّقَاقِ فَکَرِہَہَا۔","","Musannaf Ibn Abi Shaybah 22282","","","كتاب البيوع والأقضية"
"22283","(۲۲۲۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : قَالَ عَطَائٌ : الْحَرِیرُ أَحَبُّ إلَیَّ مِنَ السَّابِرِیِّ۔","","Musannaf Ibn Abi Shaybah 22283","","","كتاب البيوع والأقضية"
"22284","(۲۲۲۸۴) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ یَزِیدَ بْنِ عَبْدِ الرَّحْمَنِ الدَّالاَنِیِّ ، عَنْ إبْرَاہِیمَ الصَّائِغِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : فِی عَبْدٍ بَیْنَ اثْنَیْنِ فَأَعْتَقَ أَحَدُہُمَا نَصِیبَہُ ، قَالَ : عَلَیْہِ أَنْ یُعْتِقَ بَقِیَّتَہُ ، فَإِنْ لَمْ یَکُنْ عِنْدَہُ سَعَی الْعَبْدُ فِی رَقَبَتہ ، وَکَانُوا شُرَکَائَ فِی الْوَلاَئِ۔","Hasan","Musannaf Ibn Abi Shaybah 22284","","","كتاب البيوع والأقضية"
"22285","(۲۲۲۸۵) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إِنْ کَانَ مُوسِرًا ضَمِنَ ، وَکَانَ الْوَلاَئُ لَہُ ، وَإِنْ کَانَ مُعْسِرًا سَعَی الْعَبْدُ ، وَکَانَ الْوَلاَئُ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 22285","","","كتاب البيوع والأقضية"
"22286","(۲۲۲۸۶) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ زَکَرِیَّا ، عَنْ عَامِرٍ ، قَالَ : یَسْعَی الْعَبْدُ وَالْوَلاَئُ یَکُونُ لِلَّذِی أَعْتَقَ۔","","Musannaf Ibn Abi Shaybah 22286","","","كتاب البيوع والأقضية"
"22287","(۲۲۲۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ : فِی عَبْدٍ کَانَ بَیْنَ رَجُلَیْنِ فَأَعْتَقَہُ أَحَدُہُمَا قَالَ : الْوَلاَئُ بَیْنَہُمَا یَعْنِی إذَا اسْتُسْعِی الْعَبْدُ۔","","Musannaf Ibn Abi Shaybah 22287","","","كتاب البيوع والأقضية"
"22288","(۲۲۲۸۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : الْوَلاَئُ لِلَّذِی أَعْتَقَ سَعَی الْعَبْدُ ، أَوْ لَمْ یَسْعَ۔","","Musannaf Ibn Abi Shaybah 22288","","","كتاب البيوع والأقضية"
"22289","(۲۲۲۸۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : أَخْبَرَنِی حَبِیبٌ الَّذِی کَانَ یَقُومُ عَلَی رَأْسِ شُرَیْحٍ : أَنَّہُ حَبَسَ ابْنَہُ عَبْدَ اللہِ فِی کَفَالَۃٍ لِرَجُلٍ کَفَلَ لَہُ بِنَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 22289","","","كتاب البيوع والأقضية"
"22290","(۲۲۲۹۰) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ، عَنْ شُعْبَۃَ، عَنِ الْحَکَمِ، قَالَ: إذَا کَانَ الْغُلاَمُ فِی الضَّرِیبَۃِ فَاشْتَرَی بَیْعًا فَفِی رَقَبَتِہِ۔n وَقَالَ حماد : إذا أذن مولاہ فی البیع ؛ ففی رقبتہ۔","","Musannaf Ibn Abi Shaybah 22290","","","كتاب البيوع والأقضية"
"22291","(۲۲۲۹۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ وَحَمَّادٍ : إِنَّ الرَّجُلَ إذَا قَاطَعَ مَمْلُوکَہُ عَلَی الضَّرِیبَۃِ ، فَقَدْ أَذِنَ لَہُ۔","","Musannaf Ibn Abi Shaybah 22291","","","كتاب البيوع والأقضية"
"22292","(۲۲۲۹۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : الْمُدَبَّرُ مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 22292","","","كتاب البيوع والأقضية"
"22293","(۲۲۲۹۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ ، قَالاَ : الْمُدَبَّرُ مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 22293","","","كتاب البيوع والأقضية"
"22294","(۲۲۲۹۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ : أَنَّ عَلِیًّا کَانَ یَجْعَلُ الْمُدَبَّرَ مِنَ الثُّلُثِ ، وَأَنَّ عَامِرًا کَانَ یَجْعَلُہُ مِنَ الثُّلُثِ۔","Da'if","Musannaf Ibn Abi Shaybah 22294","","","كتاب البيوع والأقضية"
"22295","(۲۲۲۹۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ ابْنِ أَبْجَرَ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، قَالَ : ہُوَ مِنَ الثُّلُثِ ، وَقَالَ مَسْرُوقٌ : ہُوَ فَارِغٌ مِنْ جَمِیعِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 22295","","","كتاب البيوع والأقضية"
"22296","(۲۲۲۹۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ وَالأَعْمَش وَمُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : الْمُدَبَّرُ مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 22296","","","كتاب البيوع والأقضية"
"22297","(۲۲۲۹۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : الْمُدَبَّرُ مِنَ الثُّلُثِ۔ (عبدالرزاق ۱۶۶۵۷)","","Musannaf Ibn Abi Shaybah 22297","","","كتاب البيوع والأقضية"
"22298","(۲۲۲۹۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِی ، عَنِ الزُّہْرِیِّ ، قَالَ : الْمُدَبَّرُ مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 22298","","","كتاب البيوع والأقضية"
"22299","(۲۲۲۹۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَش ، عَنْ إِبْرَاہِیمَ ، عَن شُرَیْحٍ ، قَالَ : الْمُدَبَّرُ مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 22299","","","كتاب البيوع والأقضية"
"22300","(۲۲۳۰۰) حَدَّثَنَا وَکِیعٌ ، عَنِ أَبِی الرَّبِیعِ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : ہُوَ مِنْ جَمِیعِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 22300","","","كتاب البيوع والأقضية"
"22301","(۲۲۳۰۱) حَدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، قَالَ : الْمُدَبَّرُ مِنْ جَمِیعِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 22301","","","كتاب البيوع والأقضية"
"22302","(۲۲۳۰۲) حَدَّثَنَا شَاذَانُ، قَالَ: حدَّثَنَا یَحْیَی بْنُ حَمْزَۃَ، عَنِ الْعَلاَئِ وَالنُّعْمَانِ، عَنْ مَکْحُولٍ، قَالَ: الْمُدَبَّرُ مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 22302","","","كتاب البيوع والأقضية"
"22303","(۲۲۳۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنْ عَامِرٍ ، قَالَ : الْمُدَبَّرُ مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 22303","","","كتاب البيوع والأقضية"
"22304","(۲۲۳۰۴) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَمْرِو بْنِ مُہَاجِرٍ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : فِی الْکَفَنِ أَنَّہُ مِنْ رَأْسِ جُمْلَۃِ الْمَالِ ، لَیْسَ مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 22304","","","كتاب البيوع والأقضية"
"22305","(۲۲۳۰۵) حَدَّثَنَا حَفْصٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : الْکَفَنُ مِنْ جَمِیعِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 22305","","","كتاب البيوع والأقضية"
"22306","(۲۲۳۰۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : إِنْ کَانَ الْمَالُ کَثِیرًا فَمِنْ جَمِیعِ الْمَالِ ، وَإِنْ کَانَ قَلِیلاً فَمِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 22306","","","كتاب البيوع والأقضية"
"22307","(۲۲۳۰۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ ، قَالاَ : الْکَفَنُ مِنْ جَمِیعِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 22307","","","كتاب البيوع والأقضية"
"22308","(۲۲۳۰۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : الْکَفَنُ مِنْ جَمِیعِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 22308","","","كتاب البيوع والأقضية"
"22309","(۲۲۳۰۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ حَمَّادٍ ، قَالَ : الْکَفَنُ مِنْ رَأْسِ جُمْلَۃِ الْمَالِ ، لاَ مِنَ الثُّلُثِ ، وَلاَ مِنْ غَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 22309","","","كتاب البيوع والأقضية"
"22310","(۲۲۳۱۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ وَالحَسن ، قَالاَ : الکفن مِنْ جَمِیعِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 22310","","","كتاب البيوع والأقضية"
"22311","(۲۲۳۱۱) حدثنا وکیع ، عن سعید بن المسیب ، عن قتادۃ ، عن خِلاس ، قَالَ : الکفن من الثلث۔n وقال سعید بن المسیب : من جمیع المال۔","","Musannaf Ibn Abi Shaybah 22311","","","كتاب البيوع والأقضية"
"22312","(۲۲۳۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : الْکَفَنُ مِنْ جَمِیعِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 22312","","","كتاب البيوع والأقضية"
"22313","(۲۲۳۱۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ أَشْعَثَ ، عَنْ جَہْمٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : مِنْ جَمِیعِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 22313","","","كتاب البيوع والأقضية"
"22314","(۲۲۳۱۴) حَدَّثَنَا أَبُو خَالِدٍ ، عن عیسی ، عن الشعبی ، قَالَ : الکفن من جمیع المال۔","","Musannaf Ibn Abi Shaybah 22314","","","كتاب البيوع والأقضية"
"22315","(۲۲۳۱۵) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ خَالِد ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : الْکَفَنُ مِنْ جَمِیعِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 22315","","","كتاب البيوع والأقضية"
"22316","(۲۲۳۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ فِرَاسٍ ، عَنْ عَامِرٍ ، قَالَ : تُکَفَّنُ الْمَرْأَۃُ مِنْ نَصِیبِہَا۔","","Musannaf Ibn Abi Shaybah 22316","","","كتاب البيوع والأقضية"
"22317","(۲۲۳۱۷) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : الْکَفَنُ مِنْ جَمِیعِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 22317","","","كتاب البيوع والأقضية"
"22318","(۲۲۳۱۸) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ سَعِیدٍ ، عَنْ أبی معشر ، عَنْ إبْرَاہِیمَ ، قَالَ : الْکَفَنُ مِنْ جَمِیعِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 22318","","","كتاب البيوع والأقضية"
"22319","(۲۲۳۱۹) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ، قَالَ : تُکَفَّنُ مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 22319","","","كتاب البيوع والأقضية"
"22320","(۲۲۳۲۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ زُہَیْرٍ الْعَبَسِیِّ : أَنَّ رَجُلاً الْتَقَطَ لَقِیطًا فَأَتَی بِہِ عَلِیًّا فَأَعْتَقَہُ۔","","Musannaf Ibn Abi Shaybah 22320","","","كتاب البيوع والأقضية"
"22321","(۲۲۳۲۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ سَمِعَ سُنَیْنًا أَبَا جَمِیلَۃَ یَقُولُ : وَجَدْت مَنْبُوذًا فَذَکَرَہُ عَرِیفِیٌّ لَعُمَرَ ، فَأَتَیْتہ فَقَالَ : ہُوَ حُرٌّ ، وَوَلاَؤُہُ لَکَ وَرَضَاعُہُ عَلَیْنَا۔ (امام مالک ۱۹)","Sahih","Musannaf Ibn Abi Shaybah 22321","","","كتاب البيوع والأقضية"
"22322","(۲۲۳۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ : فِی اللَّقِیطِ ، قَالَ : نِیَّتُہُ إِنْ نَوَی أَنْ یَکُونَ حُرًّا ، فَہُوَ حُرٌّ ، وَإِنْ نَوَی أَنْ یَکُونَ عَبْدًا ، فَہُوَ عَبْدٌ۔","","Musannaf Ibn Abi Shaybah 22322","","","كتاب البيوع والأقضية"
"22323","(۲۲۳۲۳) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنِ الْحَسَنِ بْنِ عَمْرٍو، عَنْ فُضَیْلٍ، عَنْ إبْرَاہِیمَ ، قَالَ: اللَّقِیطُ حُرٌّ۔","","Musannaf Ibn Abi Shaybah 22323","","","كتاب البيوع والأقضية"
"22324","(۲۲۳۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی خَالِدٍ ، عَنْ عَامِرٍ ، قَالَ : اللَّقِیطُ حُرٌّ۔","","Musannaf Ibn Abi Shaybah 22324","","","كتاب البيوع والأقضية"
"22325","(۲۲۳۲۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، عَنْ عَامِرٍ ، قَالَ : اللَّقِیطُ لاَ یُسْتَرَقُّ۔","","Musannaf Ibn Abi Shaybah 22325","","","كتاب البيوع والأقضية"
"22326","(۲۲۳۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : اللَّقِیطُ حُرٌّ۔","","Musannaf Ibn Abi Shaybah 22326","","","كتاب البيوع والأقضية"
"22327","(۲۲۳۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنِ الزُّہْرِیِّ ، عَنْ رَجُلٍ مِنَ الأَنْصَارِ : أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَعْتَقَ لَقِیطًا۔","Da'if","Musannaf Ibn Abi Shaybah 22327","","","كتاب البيوع والأقضية"
"22328","(۲۲۳۲۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنِ اللَّقِیطِ ؟ فَقَالاَ : ہُوَ حُرٌّ۔n قَالَ شُعْبَۃُ : فَقُلْتُ لِلْحَکَمِ : عَمَّنْ ؟ قَالَ : عَنِ الْحَسَنِ الْبَصْرِیِّ ، عَنْ عَلِیٍّ۔","","Musannaf Ibn Abi Shaybah 22328","","","كتاب البيوع والأقضية"
"22329","(۲۲۳۲۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ زُہَیْرِ بْنِ أَبِی ثَابِتٍ ، عَنْ ذُہْلِ بْنِ أَوْسٍ ، عَنْ تَمِیمِ بْنِ مُسَیْحٍ ، قَالَ : خَرَجْت مِنَ الدَّارِ وَلَیْسَ لِی وَلَدٌ ، فَوَجَدْت لَقِیطًا فَأَتَیْت بِہِ عَلِیًّا فَأَلْحَقَہُ فِی مَائِہِ۔ (عبدالرزاق ۱۳۸۴۱)","Da'if","Musannaf Ibn Abi Shaybah 22329","","","كتاب البيوع والأقضية"
"22330","(۲۲۳۳۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سُلَیْمَانَ الشَّیْبَانِیِّ ، عَنْ حَوْطٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عُمَرُ : ہُمْ مَمْلُوکُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 22330","","","كتاب البيوع والأقضية"
"22331","(۲۲۳۳۱) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنْ مُوسَی الْجُہَنِیِّ ، قَالَ : رَأَیْتُ وَلَدَ زِنًا أَلْحَقَہُ عَلِیٌّ فِی مَائِہِ۔","","Musannaf Ibn Abi Shaybah 22331","","","كتاب البيوع والأقضية"
"22332","(۲۲۳۳۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ عَبْدِ اللہِ بْنِ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، قَالَ : جَائَ کِتَابُ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ إلَی أَہْلِ مَکَّۃَ ، أَنَّ اللَّقِیطَ حُرٌّ۔","","Musannaf Ibn Abi Shaybah 22332","","","كتاب البيوع والأقضية"
"22333","(۲۲۳۳۳) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : أَنَّہُ کَرِہَ أَنْ یُوَاصِفَ الرَّجُلُ بِالسِّلْعَۃِ لَیْسَ عِنْدَہُ۔","","Musannaf Ibn Abi Shaybah 22333","","","كتاب البيوع والأقضية"
"22334","(۲۲۳۳۴) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ یَکْرَہُ الْمُوَاصَفَۃَ۔","","Musannaf Ibn Abi Shaybah 22334","","","كتاب البيوع والأقضية"
"22335","(۲۲۳۳۵) حَدَّثَنَا أزہر ، عن ابن عون ، عن محمد : أنہ کرہہا۔","","Musannaf Ibn Abi Shaybah 22335","","","كتاب البيوع والأقضية"
"22336","(۲۲۳۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، قَالَ : قُلْتُ لابْنِ عُمَرَ : الرَّجُلُ یَقُولُ : اشْتَرِ ہَذَا الْبَیْعَ وَأَشْتَرِیہِ مِنْک فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 22336","","","كتاب البيوع والأقضية"
"22337","(۲۲۳۳۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الْحَکَمِ بنِ أَبِی الْفَضْلِ ، قَالَ : سَمِعْتُ الْحَسَنَ وَسَأَلَہُ عَنِ الرَّجُلِ یُسَاوِمُ الرَّجُلَ بِالْحُرِّیَّۃِ فَیَقُولُ : لَیْسَ عِنْدِی ، فَیَقُولُ : اشْتَرِہِ حَتَّی أَشْتَرِیَہُ مِنْک ؟ فَکَرِہَہُ ، وَقَالَ : ہَذِہِ الْمُوَاصَفَۃُ۔","","Musannaf Ibn Abi Shaybah 22337","","","كتاب البيوع والأقضية"
"22338","(۲۲۳۳۸) حَدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ : أَنَّہُ لَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 22338","","","كتاب البيوع والأقضية"
"22339","(۲۲۳۳۹) حَدَّثَنَا وکیع ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ مُسْلِمٍ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، قَالَ : قُلْتُ لِطَاوُوسٍ : الرَّجُلُ یُسَاوِمُنِی السِّلْعَۃَ وَلَیْسَتْ عِنْدِی فَیَقُولُ: اشْتَرِ وَأَشْتَرِی مِنْک، وَلَوْلاَ مَکَانَہُ مَا اشْتَرَیْتہَا؟ فَکَرِہَہُ طَاوُوس۔","","Musannaf Ibn Abi Shaybah 22339","","","كتاب البيوع والأقضية"
"22340","(۲۲۳۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ : فِی الرَّجُلِ یَقُولُ لِلرَّجُلِ : اشْتَرِی ہَذَا الْبَزَّ وَأَشْتَرِیہِ مِنْک فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 22340","","","كتاب البيوع والأقضية"
"22341","(۲۲۳۴۱) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تَبْتَاعُوا الصُّوفَ عَلَی ظُہُورِ الْغَنَمِ ، وَلاَ اللَّبَنَ فِی الضُّرُوعِ۔","Sahih","Musannaf Ibn Abi Shaybah 22341","","","كتاب البيوع والأقضية"
"22342","(۲۲۳۴۲) حَدَّثَنَا مُلاَزِمُ بْنُ عَمْرٍو ، عَنْ زُفَرَ بْنِ یَزِیدَ ، عَنْ أَبِیہِ ، قَالَ : سَأَلْتُ أَبَا ہُرَیْرَۃَ عَنْ شِرَاء اللَّبَنِ فِی الضُّرُوعِ ؟ فَنَہَانِی عَنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 22342","","","كتاب البيوع والأقضية"
"22343","(۲۲۳۴۳) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَہْضَمِ بْنِ عَبْدِ اللہِ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَن مُحَمَّدِ بْنِ زَیْدٍ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : نَہَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ شِرَاء مَا فِی بُطُونِ الأَنْعَامِ حَتَّی تَضَعَ ، وَعَمَّا فِی ضُرُوعِہَا إلاَّ بِکَیْلٍ۔","Da'if","Musannaf Ibn Abi Shaybah 22343","","","كتاب البيوع والأقضية"
"22344","(۲۲۳۴۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ : أَنَّہُ کَرِہَ بَیْعَ اللَّبَنِ فِی الضُّرُوعِ إلاَّ کَیْلاً۔","","Musannaf Ibn Abi Shaybah 22344","","","كتاب البيوع والأقضية"
"22345","(۲۲۳۴۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ : أَنَّہُ کَرِہَ بَیْعَ اللَّبَنِ فِی ضُرُوعِ الشَّائِ۔","","Musannaf Ibn Abi Shaybah 22345","","","كتاب البيوع والأقضية"
"22346","(۲۲۳۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ وَہْبِ بْنِ عُقْبَۃَ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ عَنْ قَوْمٍ کَانُوا یَبْتَاعُونَ أَلْبَانَ الْبَقَرِ أَیَّامًا مَعْلُومَۃً ، ثُمَّ یَبْتَاعُونَہَا ؟ فَقَالَ : لاَ تَصْلُحُ إلاَّ یَدًا بِیَدٍ۔","","Musannaf Ibn Abi Shaybah 22346","","","كتاب البيوع والأقضية"
"22347","(۲۲۳۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُمَرُ بْنُ فَرُّوخَ الْقَتَّابِ ، سَمِعَہُ مِنْ حبِیبِ بْنِ الزُّبَیْرِ ، عَنْ عِکْرِمَۃَ ، قَالَ : نَہَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُبَاعَ لَبَنٌ فِی ضَرْعٍ ، أو سمن فی لبن۔ (ابوداؤد ۱۸۳۔ دارقطنی ۴۵)","","Musannaf Ibn Abi Shaybah 22347","","","كتاب البيوع والأقضية"
"22348","(۲۲۳۴۸) حَدَّثَنَا ابن فضیل ، عن مغیرۃ ، عَنْ إبْرَاہِیمَ ، قَالَ : کان یکرہ أن یشتری اللبن فی ضرع الشَّاۃِ۔","","Musannaf Ibn Abi Shaybah 22348","","","كتاب البيوع والأقضية"
"22349","(۲۲۳۴۹) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ مُسْلِمٍ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ طَاوُوسٍ وَمُجَاہِدٍ : أَنَّہُمَا کَرِہَا بَیْعَ اللَّبَنِ فِی الضُّرُوعِ۔","","Musannaf Ibn Abi Shaybah 22349","","","كتاب البيوع والأقضية"
"22350","(۲۲۳۵۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بن سُلَیْمَانَ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، عَنِ ابْنِ سَابِطٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ: فِی الْجَنَّۃِ قَصْرٌ یُدْعَی عَدْنًا حَوْلَہُ الْبُرُوجُ وَالْمُرُوجُ لَہُ خَمْسَۃُ آلاَفِ بَابٍ، لاَ یَسْکُنُہُ، أَوْ لاَ یَدْخُلُہُ إلاَّ نَبِیٌّ، أَوْ صِدِّیقٌ ، أَوْ شَہِیدٌ ، أَوْ إمَامٌ عَادِلٌ۔","Da'if","Musannaf Ibn Abi Shaybah 22350","","","كتاب البيوع والأقضية"
"22351","(۲۲۳۵۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ عَمَّارٌ : ثَلاَثَۃٌ لاَ یَسْتَخِفُّ بِحَقِّہِنَّ إلاَّ مُنَافِقٌ بَیِّنٌ نفاقہ : إمَامٌ مُقْسِطٌ ، وَمُعَلِّمُ الْخَیْرِ ، وَذُو الشَّیْبَۃِ فِی الإِسْلاَمِ۔ (طبرانی ۷۸۱۹)","Da'if","Musannaf Ibn Abi Shaybah 22351","","","كتاب البيوع والأقضية"
"22352","(۲۲۳۵۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، عَنْ قَیْسِ بْنِ عُبَادٍ ، قَالَ : لَعَمَلُ إمَامٍ عَادِلٍ یَوْمًا خَیْرٌ مِنْ عَمَلِ أَحَدِکُمْ سِتِّینَ سَنَۃً۔","","Musannaf Ibn Abi Shaybah 22352","","","كتاب البيوع والأقضية"
"22353","(۲۲۳۵۳) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : حدَّثَنَا عَوْفٌ ، عَنْ زِیَادِ بْنِ مِخْرَاقٍ ، عَنْ أَبِی کِنَانَۃَ ، عَنْ أَبِی مُوسَی ، قَالَ: إنَّ مِنْ إجْلاَلِ اللہِ إکْرَامُ ذِی الشَّیْبَۃِ الْمُسْلِمِ ، وَحَامِلُ الْقُرْآنِ غَیْرُ الْغَالِی فِیہِ وَلاَ الْجَافِی عَنْہُ ، وَإِکْرَامُ ذِی السُّلْطَانِ الْمُقْسِطِ۔","Da'if","Musannaf Ibn Abi Shaybah 22353","","","كتاب البيوع والأقضية"
"22354","(۲۲۳۵۴) حَدَّثَنَا وَکِیع ، قَالَ : حَدَّثَنَا سَعْدَانُ الْجُہَنِیُّ ، عَنْ سَعْدٍ أَبِی مُجَاہِدٍ الطَّائِیِّ ، عَنْ أَبِی مُدِلَّۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الإِمَامُ الْعَادِلُ لاَ تُرَدُّ دَعْوَتُہُ۔n(ابن ماجہ ۱۷۵۲۔ احمد ۲/۳۰۴)","Hasan","Musannaf Ibn Abi Shaybah 22354","","","كتاب البيوع والأقضية"
"22355","(۲۲۳۵۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : فِی قَوْمٍ أَرَادُوا أَنْ یَحْفِرُوا فِی دَارِہِمْ حُشًّا أَوْ حَمَّامًا ، قَالَ : مِلْکُہُمْ یَصْنَعُونَ فِیہِ مَا شَاؤُوا۔","","Musannaf Ibn Abi Shaybah 22355","","","كتاب البيوع والأقضية"
"22356","(۲۲۳۵۶) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ، عَنْ أَبِیہِ، عَنِ ابْنِ أَشْوَعَ: أَنَّہُ سَدَّ بِئْرًا حَفَرَہَا جَارُہُ خَلْفَ حَائِطِہِ۔","","Musannaf Ibn Abi Shaybah 22356","","","كتاب البيوع والأقضية"
"22357","(۲۲۳۵۷) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ : فِی حَائِطٍ فِی دَارِ قَوْمٍ ، قَالَ : إِنْ شَائَ نَقَبَ فِیہِ بَابًا۔","","Musannaf Ibn Abi Shaybah 22357","","","كتاب البيوع والأقضية"
"22358","(۲۲۳۵۸) حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، عَنْ مَعْمَرٍ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَضَارُّوا فِی الْحَفْرِ۔ (ابوداؤد ۴۰۸۔ بیہقی ۱۵۶)","","Musannaf Ibn Abi Shaybah 22358","","","كتاب البيوع والأقضية"
"22359","(۲۲۳۵۹) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو : أَنَّ رَجُلاً قَالَ لِغُلاَمِہِ : الْزَمْ فُلاَنًا فَإِنْ فَارَقْتہ فَأَنْتَ حُرٌّ ، فَقَالَ : اشْہَدُوا أَنِّی قَدْ فَارَقْتہ ، فَرُفِعَ ذَلِکَ إلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ وَہُوَ أَمِیرُ مَکَّۃَ فَأَجَازَ عِتْقَہُ ، قَالَ : فَکَانَ الْحَسَنُ یَرَی ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 22359","","","كتاب البيوع والأقضية"
"22360","(۲۲۳۶۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : بَلَغَنِی أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ، قَالَ : لاَ یَعْتِق۔","","Musannaf Ibn Abi Shaybah 22360","","","كتاب البيوع والأقضية"
"22361","(۲۲۳۶۱) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ سُفْیَانَ ، عَنْ عَمْرِو بْنِ إبْرَاہِیمَ الأَنْصَارِیِّ ، عَنْ عَمِّہِ الضَّحَّاکِ ، قَالَ : اخْتَصَمَ رَجُلاَنِ إلَی عُمَرَ بْنِ الْخَطَّابِ ادَّعَیَا شَہَادَتَہُ ، فَقَالَ لَہُمَا عُمَرُ : إِنْ شِئْتُمَا شَہِدْت وَلَمْ أَقْضِ بَیْنَکُمَا ، وَإِنْ شِئْتُمَا قَضَیْت وَلَمْ أَشْہَدْ۔","Da'if","Musannaf Ibn Abi Shaybah 22361","","","كتاب البيوع والأقضية"
"22362","(۲۲۳۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ عَبْدِ الأَعْلَی ، قَالَ : جَائَتِ امْرَأَۃٌ إلَی شُرَیْحٍ فَأَتَتْہُ بِشَاہِدٍ ، قَالَ : ائْتِنِی بِشَاہِدٍ آخَرَ ، قَالَت : أَنْتَ شَاہِدِی ، فَاسْتَحْلَفَہَا وَقَضَی لَہَا۔","","Musannaf Ibn Abi Shaybah 22362","","","كتاب البيوع والأقضية"
"22363","(۲۲۳۶۳) حَدَّثَنَا ابن مہدی ، عن سفیان ، عن إسماعیل بن سالم ، عن الشعبی ، قَالَ : لاَ أجمع أن أکون قاضیًا وشاہدا۔","","Musannaf Ibn Abi Shaybah 22363","","","كتاب البيوع والأقضية"
"22364","(۲۲۳۶۴) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنِ ابْنِ شُبْرُمَۃَ، عَنِ الشَّعْبِیِّ، قَالَ: سَأَلْتُہ عَنْ رَجُلٍ کَانَ لَہُ عَلَی رَجُلٍ مَالٌ، فَأَشْہَدَ علیہ شَاہِدَیْنِ، فَاسْتَقْضیَ أَحَدَ الشَّاہِدَیْنِ؟ فَقَالَ الشَّعْبِیُّ: جَائَ رَجُلٌ إلَی شُرَیْحٍ یُخَاصِمُ وَأَنَا جَالِسٌ مَعَہُ، فَجَائَ الآخَرُ عَلَیْہِ بِشَاہِدٍ، ثُمَّ قَالَ لِشُرَیْحٍ: أَنْتَ تَشْہَدُ لِی، فَقَالَ شُرَیْحٌ: ائْتِ الأَمِیرَ حَتَّی أَشْہَدَ لَک۔ (بیہقی ۱۰)","","Musannaf Ibn Abi Shaybah 22364","","","كتاب البيوع والأقضية"
"22365","(۲۲۳۶۵) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ : أَنَّہُ کَانَ یَکْرَہُ تُرَابَ الصَّوَّاغِینَ ، یَعْنِی : شِرَائَ ہُ۔","","Musannaf Ibn Abi Shaybah 22365","","","كتاب البيوع والأقضية"
"22366","(۲۲۳۶۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ یَکْرَہُ شِرَاء تُرَابِ الصَّوَّاغِینَ إلاَّ أَنْ یَشْتَرِیَ تُرَابَ الذَّہَبِ بِالْفِضَّۃِ وَتُرَابَ الْفِضَّۃِ بِالذَّہَبِ۔","","Musannaf Ibn Abi Shaybah 22366","","","كتاب البيوع والأقضية"
"22367","(۲۲۳۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ أَبِی الْجَعْدِ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ عَنْ شِرَائِ تُرَابِ الصَّوَّاغِینَ ؟ فَکَرِہَہُ وَقَالَ : ہُوَ غَرَرٌ۔n قَالَ مُحَمَّدٌ : وَکَانَ أَبِی یَشْتَرِیہِ بِالْعُرُوضِ۔","","Musannaf Ibn Abi Shaybah 22367","","","كتاب البيوع والأقضية"
"22368","(۲۲۳۶۸) حَدَّثَنَا حَرَمِیُّ بْنُ عُمَارَۃَ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یُشْتَرَی تُرَابُ الذَّہَبِ بِالْفِضَّۃِ وَتُرَابُ الْفِضَّۃِ بِالذَّہَبِ۔","","Musannaf Ibn Abi Shaybah 22368","","","كتاب البيوع والأقضية"
"22369","(۲۲۳۶۹) حَدَّثَنَا صَفْوَانُ بْنُ عِیسَی ، عَنْ بَرْدَانَ بْنِ أَبِی النَّضْرِ ، قَالَ : کُنْتُ بِعْت مِنْ رَجُلٍ طَعَامًا ، فَأَعْطَی الرَّجُلُ أَجْرَ الْکَیَّالِ ، فَسَأَلْت الشَّعْبِیَّ عَنْ ذَلِکَ ؟ فَقَالَ : أَعْطِہِ أَنْتَ فَإِنَّمَا ہُوَ عَلَیْک۔","","Musannaf Ibn Abi Shaybah 22369","","","كتاب البيوع والأقضية"
"22370","(۲۲۳۷۰) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، أَوِ ابْنِ أَبِی مُلَیْکَۃَ وَعَمْرِو بْنِ دِینَارٍ ، قَالاَ : مَازِلْنَا نَسْمَعُ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی الْعَبْدِ الآبِقِ یُوجَدُ خَارِجًا مِنَ الْحَرَمِ دِینَارًا أَوْ عَشَرَۃَ دَرَاہِمَ۔","","Musannaf Ibn Abi Shaybah 22370","","","كتاب البيوع والأقضية"
"22371","(۲۲۳۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ رَبَاحٍ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ : أَنَّ رَجُلاً أَصَابَ عَبْدًا آبِقًا بِعَیْنِ التَّمْرِ ، فَجَائَ بِہِ ، فَجَعَلَ ابْنُ مَسْعُودٍ فِیہِ أَرْبَعِینَ دِرْہَمًا۔","Sahih","Musannaf Ibn Abi Shaybah 22371","","","كتاب البيوع والأقضية"
"22372","(۲۲۳۷۲) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شعیب ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : أَنَّ عُمَرَ جَعَلَ فِی جُعْلِ الآبِقِ دِینَارًا ، أَوِ اثْنَیْ عَشَرَ دِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 22372","","","كتاب البيوع والأقضية"
"22373","(۲۲۳۷۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 22373","","","كتاب البيوع والأقضية"
"22374","(۲۲۳۷۴) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی ابْنُ أَبِی مُلَیْکَۃَ : أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ قَضَی فِی جُعْلِ الآبِقِ إذَا أُخِذَ عَلَی مَسِیرَۃِ ثَلاَثٍ ثَلاَثَۃَ دَنَانِیرَ۔","","Musannaf Ibn Abi Shaybah 22374","","","كتاب البيوع والأقضية"
"22375","(۲۲۳۷۵) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ وَأَبِی ہَاشِمٍ : أَنَّ عُمَرَ قَضَی فِی جُعْلِ الآبِقِ أَرْبَعِینَ دِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 22375","","","كتاب البيوع والأقضية"
"22376","(۲۲۳۷۶) حَدَّثَنَا یَحْیَی بْنُ أَبِی زَائِدَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ جُرَیسٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِجُعْلِ الآبِقِ۔","","Musannaf Ibn Abi Shaybah 22376","","","كتاب البيوع والأقضية"
"22377","(۲۲۳۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ إبْرَاہِیمَ بْن مُہَاجِرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : الْمُسْلِمُ یَرُدُّ عَلَی الْمُسْلِمِ۔","","Musannaf Ibn Abi Shaybah 22377","","","كتاب البيوع والأقضية"
"22378","(۲۲۳۷۸) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ أَبِی إِسْحَاقَ، قَالَ: أَعْطَیْت الْجُعْلَ فِی زَمَنِ مُعَاوِیَۃَ أَرْبَعِینَ دِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 22378","","","كتاب البيوع والأقضية"
"22379","(۲۲۳۷۹) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ۔ وَعَنْ سُفْیَانَ ، عَنْ جَابِرٍ، عَنِ الْقَاسِمِ ، عَنْ شُرَیْحٍ ، أَنَّہُ کَانَ یَقُولُ : إذَا أُخِذَ فِی الْمِصْرِ فَعَشَرَۃُ دَرَاہِمَ ، وَإِذَا أُخِذَ خَارِجًا مِنَ الْمِصْرِ فَأَرْبَعُونَ دِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 22379","","","كتاب البيوع والأقضية"
"22380","(۲۲۳۸۰) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ جَابِرٍ، عَنِ الْحَکَمِ: أَنَّہُ قَالَ فِی الآبِقِ: یُؤخذُ، قَالَ: الْمُسْلِمُ یَرُدُّ عَلَی الْمُسْلِمِ۔","","Musannaf Ibn Abi Shaybah 22380","","","كتاب البيوع والأقضية"
"22381","(۲۲۳۸۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ وَعَمْرِو بْنِ دِینَارٍ ، قَالاَ : جَعَلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْعَبْدِ الآبِقِ إذَا جِیئَ بِہِ خَارِجًا من الْحَرَمِ دِینَارًا۔","","Musannaf Ibn Abi Shaybah 22381","","","كتاب البيوع والأقضية"
"22382","(۲۲۳۸۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ عَبْدِ الْکَرِیمِ ، قَالَ : قُلْتُ لِعَبْدِ اللہِ بْنِ عُتْبَۃَ : أَتجْتَعلُ فِی الآبِقِ؟ قَالَ : نَعَمْ ، قُلْتُ : الْحُرُّ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 22382","","","كتاب البيوع والأقضية"
"22383","(۲۲۳۸۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، قَالَ : إِنْ لَمْ یُعْطِہِ جُعْلاً فَلْیُرْسِلْہُ فِی الْمَکَانِ الَّذِی أَخَذَہُ۔","","Musannaf Ibn Abi Shaybah 22383","","","كتاب البيوع والأقضية"
"22384","(۲۲۳۸۴) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ ، عَنْ أَبِی وَائِلٍ ، عَنْ مَسْرُوقٍ ، قَالَ : الْقَاضِی إذَا أَخَذَ ہَدِیَّۃً ، فَقَدْ أَکَلَ السُّحْتَ ، وَإِذَا أَخَذَ الرِّشْوَۃَ بَلَغَتْ بِہِ الْکُفْرَ۔","","Musannaf Ibn Abi Shaybah 22384","","","كتاب البيوع والأقضية"
"22385","(۲۲۳۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مُعَاذِ بْنِ الْعَلاَئِ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : خَطَبَ عَلِیٌّ بِالْکُوفَۃِ وَبِیَدِہِ قَارُورَۃٌ فَقَالَ : مَا أَصَبْت بِہَا مُنْذُ دَخَلْتہَا إلاَّ ہَذہ ، أَہْدَاہَا إلَیَّ دِہْقَانٌ۔","Da'if","Musannaf Ibn Abi Shaybah 22385","","","كتاب البيوع والأقضية"
"22386","(۲۲۳۸۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ یُوسُفَ بْنِ الْمُہَاجِرِ ، قَالَ : أَہْدَی الأَصْبَہْبَذُ إلَی عَبْدِ الْحَمِیدِ أَرْبَعِینَ أَلْفًا ، أَوْ أَقَلَّ ، أَوْ أَکْثَرَ ، فَکَتَبَ إلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، فَکَتَبَ إلَیْہِ : إِنْ کَانَ یُہْدِی لَکَ وَأَنْتَ بِالْجَزِیرَۃِ فَاقْبَلْہَا مِنْہُ ، وَإِلاَّ فَاحْسِبْہَا لَہُ مِنْ خَرَاجِہِ۔","","Musannaf Ibn Abi Shaybah 22386","","","كتاب البيوع والأقضية"
"22387","(۲۲۳۸۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ : الرِّشْوَۃُ فِی الْحُکْمِ سُحْتٌ۔","","Musannaf Ibn Abi Shaybah 22387","","","كتاب البيوع والأقضية"
"22388","(۲۲۳۸۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَش ، عَنْ خَیْثَمَۃَ ، قَالَ : قَالَ عُمَرُ : بَابَانِ مِنَ السُّحْتِ یَأْکُلُہُمَا النَّاسُ : الرِّشَا ، وَمَہْرُ الزَّانِیَۃِ۔","","Musannaf Ibn Abi Shaybah 22388","","","كتاب البيوع والأقضية"
"22389","(۲۲۳۸۹) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرِو بْنِ مُرَّۃَ ، عن أبیہ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ ، عَنِ السُّحْتِ ؟ فَقَالَ : الرِّشَا۔","","Musannaf Ibn Abi Shaybah 22389","","","كتاب البيوع والأقضية"
"22390","(۲۲۳۹۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ شُعْبَۃَ، عَنْ أَبِی قَزَعَۃَ، عَنْ أَبِی نَضْرَۃَ، عَنْ أَبِی سَعِیدٍ، قَالَ: ہَدَایَا الأُمَرَائِ غُلُولٌ۔","Sahih","Musannaf Ibn Abi Shaybah 22390","","","كتاب البيوع والأقضية"
"22391","(۲۲۳۹۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ قَزَعَۃَ ، عَنْ أَبِی یَزِیدَ الْمَدِینِیِّ ، قَالَ: سُئِلَ جَابِرُ بْنُ عَبْدِ اللہِ عَنْ ہَدَایَا الأُمَرَائِ؟ فَقَالَ: ہِیَ فِی نَفْسِی غُلُولٌ۔","Sahih","Musannaf Ibn Abi Shaybah 22391","","","كتاب البيوع والأقضية"
"22392","(۲۲۳۹۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَبِی مُعَاذٍ ، عَنْ طَاوُوسٍ ، قَالَ : ہِیَ سُحْتٌ۔","","Musannaf Ibn Abi Shaybah 22392","","","كتاب البيوع والأقضية"
"22393","(۲۲۳۹۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَش ، عَنْ شَقِیقٍ ، قَالَ : قدِمَ مُعَاذٌ مِنَ الْیَمَنِ بِرَقِیقٍ فِی زَمَنِ أَبِی بَکْرٍ ، فَقَالَ لَہُ عُمَرُ : ادْفَعْہُمْ إلَی أَبِی بَکْرٍ ، قَالَ : وَلِمَ أَدْفَعُ إلَیْہِ رَقِیقِی ؟ قَالَ : فَانْصَرَفَ إلَی مَنْزِلِہِ وَلَمْ یَدْفَعْہُمْ ، فَبَاتَ لَیْلَتَہُ ثُمَّ أَصْبَحَ مِنَ الْغَدِ ، فَدَفَعَہُمْ إلَی أَبِی بَکْرٍ ، فَقَالَ لَہُ عُمَرُ : مَا بَدَا لَکَ ؟ قَالَ : رَأَیْتُنِی فِیمَا یَرَی النَّائِمُ کَأَنِّی إلَی نَارٍ أہْوی إلَیْہَا ، فَأَخَذْتَ بِحُجْزَتِی فَمَنَعْتنِی مِنْ دُخُولِہَا ، فَظَنَنْت أَنَّہُمْ ہَؤُلاَئِ الرَّقِیقُ ، فَقَالَ أَبُو بَکْرٍ : ہُمْ لَکَ ، فَلَمَّا انْصَرَفَ إِلَی مَنْزِلِہِ قَامَ یُصَلِّی فَرَآہُمْ یُصَلُّونَ خَلْفَہُ فَقَالَ : لِمَنْ تُصَلُّونَ ؟ فَقَالُوا : لِلَّہِ ، فَقَالَ : اذْہَبُوا أَنْتُمْ لِلَّہِ۔","Sahih","Musannaf Ibn Abi Shaybah 22393","","","كتاب البيوع والأقضية"
"22394","(۲۲۳۹۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ أَبِی حُمَیْدٍ السَّاعِدِیِّ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اسْتَعْمَلَ ابْنَ اللُّتْبِیَّۃِ عَلَی صَدَقَاتِ بَنِی سُلَیْمٍ ، فَلَمَّا جَائَ قَالَ : ہَذَا لَکُمْ وَہَذَا أُہْدِیَ لِی ، فَقَامَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَخَطَبَ النَّاسَ فَحَمِدَ اللَّہَ وَأَثْنَی عَلَیْہِ ، ثُمَّ قَالَ : مَا بَالُ رِجَالٍ نُوَلِّیہِمْ أُمُورًا مِمَّا وَلاَّنَاہا اللَّہُ ، فَیَجِیئُ أَحَدُکُمْ فَیَقُولُ : ہَذَا لَکُمْ ، وَہَذَا أُہْدِیَ إلَیَّ ، أَفَلاَ یَجْلِسُ فِی بَیْتِ أَبِیہِ ، أَوْ بَیْتِ أُمِّہِ حَتَّی تَأْتِیَہُ ہَدِیَّۃٌ إِنْ کَانَ صَادِقًا۔ (بخاری ۱۵۰۰۔ مسلم ۱۴۶۳)","Sahih","Musannaf Ibn Abi Shaybah 22394","","","كتاب البيوع والأقضية"
"22395","(۲۲۳۹۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ قَیْسٍ ، عَنْ عَدِیِّ بْنِ عَمِیرَۃَ الْکِنْدِیِّ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنِ اسْتَعْمَلْنَاہُ مِنْکُمْ عَلَی عَمَلٍ فَکَتَمَنَا مِخْیَطًا فَمَا فَوْقَہُ کَانَ غُلُولاً یَأْتِی بِہِ یَوْمَ الْقِیَامَۃِ ، فَقَامَ إلَیْہِ رَجُلٌ أسود مِنَ الأَنْصَارِ کَأَنِّی أَنْظُرُ إلَیْہِ فَقَالَ : یَا رَسُولَ اللہِ ، اقْبَلْ عَنِّی عَمَلَک، قَالَ: وَمَا ذَاکَ؟ قَالَ: سَمِعْتُک تقول کَذَا وَکَذَا، قَالَ: فَأَنَا أَقُولُہُ الآنَ: مَنِ اسْتَعْمَلْنَاہُ مِنْکُمْ عَلَی عَمَلٍ فَلْیَأْتِنَا بِقَلِیلِہِ وَکَثِیرِہِ، فَمَا أُوتِیَ مِنْہُ أَخَذَ، وَمَا نُہِیَ عَنْہُ انْتَہَی۔ (مسلم ۳۰۔ ابوداؤد ۳۵۷۶)","Sahih","Musannaf Ibn Abi Shaybah 22395","","","كتاب البيوع والأقضية"
"22396","(۲۲۳۹۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ عُبَیْدٍ الطَّائِیِّ ، عَنْ عَلِیِّ بْنِ رَبِیعَۃَ : أَنَّ عَلِیًّا اسْتَعْمَلَ رَجُلاً مِنْ بَنِی أَسَدٍ یُقَالُ لَہُ : ضُبَیْعَۃُ بْنُ زُہَیْرٍ ، أَوْ زُہَیْرُ بْنُ ضُبَیْعَۃَ ، فَلَمَّا جَائَ قَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، إنِّی أُہْدِیَ إلَیَّ فِی عَمَلِی أَشْیَائُ وَقَدْ أَتَیْتُک بِہَا ، فَإِنْ کَانَتْ حَلاَلاً أَکَلْتہَا ، وَإِلأَفَقَدْ أَتَیْتُک بِہَا ، فَقَبَضَہَا عَلِیٌّ وَقَالَ : لَوْ حَبَسْتہَا کَانَ غُلُولاً۔","Sahih","Musannaf Ibn Abi Shaybah 22396","","","كتاب البيوع والأقضية"
"22397","(۲۲۳۹۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ لَیْثٍ ، عَنْ أَبِی الْخَطَّابِ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ أَبِی إدْرِیسَ ، عَنْ ثَوْبَانَ ، قَالَ : لَعَنَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الرَّاشِیَ وَالْمُرْتَشِیَ وَالرَّائِشَ ، یَعْنِی الَّذِی یَمْشِی بَیْنَہُمَا۔n(احمد ۵/۲۷۹۔ بزار ۱۳۵۳)","Da'if","Musannaf Ibn Abi Shaybah 22397","","","كتاب البيوع والأقضية"
"22398","(۲۲۳۹۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ خَالِہِ الْحَارِثِ ، عَنْ أَبِی سَلَمَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : لَعَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الرَّاشِیَ وَالْمُرْتَشِیَ۔n(ترمذی ۱۳۳۷۔ ابوداؤد ۳۵۷۵)","Hasan","Musannaf Ibn Abi Shaybah 22398","","","كتاب البيوع والأقضية"
"22399","(۲۲۳۹۹) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنِ الْحَارِثِ بْنِ عُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : لَمَّا بَعَثَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ابْنَ رَوَاحَۃَ إلَی أَہْلِ خَیْبَرَ أَہْدَوْا لَہُ فَرَدَّہُ وَقَالَ : ہُوَ سُحْتٌ۔","","Musannaf Ibn Abi Shaybah 22399","","","كتاب البيوع والأقضية"
"22400","(۲۲۴۰۰) حَدَّثَنَا یَعْلَی ، عَنِ الْحَارِثِ بْنِ عُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : کَتَبَ عُمَرُ إلَی أَہْلِ الْعِرَاقِ : إنَّ لَنَا ہَدَایَا دَہَاقِینَنَا۔","","Musannaf Ibn Abi Shaybah 22400","","","كتاب البيوع والأقضية"
"22401","(۲۲۴۰۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی حَصِینٍ ، عَنْ شُرَیْحٍ ، قَالَ : لُعِنَ الرَّاشِیَ وَالْمُرْتَشِیَ۔","","Musannaf Ibn Abi Shaybah 22401","","","كتاب البيوع والأقضية"
"22402","(۲۲۴۰۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ یَحْیَی بْنِ ہَانِیئٍ ، قَالَ: أخْبَرَنِی أَبُو حُذَیْفَۃَ ، عَنْ عَبْدِالْمَلِکِ بْنِ مُحَمَّدٍ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَلْقَمَۃَ ، قَالَ : قَدِمَ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَفْدُ ثَقِیفٍ ، فَأَہْدَوْا إلَیْہِ ہَدِیَّۃً ، فَقَالَ: ہَدِیَّۃٌ أَمْ صَدَقَۃٌ؟ قَالُوا: ہَدِیَّۃٌ ، قَالَ: إنَّ الْہَدِیَّۃَ یُطْلَبُ بِہَا وَجْہُ الرَّسُولِ وَقَضَائُ الْحَاجَۃِ ، وَإِنَّ الصَّدَقَۃَ یُبْتَغَی بِہَا وَجْہُ اللہِ ، قَالُوا : لاَ ، بَلْ ہَدِیَّۃٌ ، فَقَبِلَہَا مِنْہُمْ ، وَشَغَلُوہُ عَنِ الظُّہْرِ حَتَّی صَلاَّہَا مَعَ الْعَصْرِ۔n(نسائی ۶۵۹۳۔ ابو عبید ۱۷۷۰)","Da'if","Musannaf Ibn Abi Shaybah 22402","","","كتاب البيوع والأقضية"
"22403","(۲۲۴۰۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْبَلُ الْہَدِیَّۃَ وَیُثِیبُ مَا ہُوَ خَیْرٌ مِنْہَا۔ (بخاری ۲۵۸۵۔ ابوداؤد ۳۵۳۰)","","Musannaf Ibn Abi Shaybah 22403","","","كتاب البيوع والأقضية"
"22404","(۲۲۴۰۴) حَدَّثَنَا وَکِیع ، قَالَ : حَدَّثَنَا ہِشَامٌ ، عَنْ أَیُّوبَ بْنِ مَیْسَرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: اہْدِ لِمَنْ لاَ یُہْدِی لَکَ ، وَعُدْ مَنْ لاَ یَعُودُک۔","","Musannaf Ibn Abi Shaybah 22404","","","كتاب البيوع والأقضية"
"22405","(۲۲۴۰۵) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حُسَیْنِ بْنِ وَاقِدٍ ، قَالَ : حدَّثَنِی عَبْدُ اللہِ بْنُ بُرَیْدَۃَ ، عَنْ أَبِیہِ : أَنَّ سَلْمَانَ لَمَّا أَتَی الْمَدِینَۃَ أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِہَدِیَّۃٍ عَلَی طَبَقٍ فَوَضَعَہَا بَیْنَ یَدَیْہِ فَقَالَ : مَا ہَذَا ؟ قَالَ : صَدَقَۃٌ عَلَیْک وَعَلَی أَصْحَابِکَ ، قَالَ: إنِّی لاَ آکُلُ الصَّدَقَۃَ ، فَرَفَعَہَا ، ثُمَّ أَتَاہُ مِنَ الْغَدِ بِمِثْلِہَا فَقَالَ: مَا ہَذَا؟ فَقَالَ : ہَدِیَّۃٌ لَکَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لأَصْحَابِہِ : کُلُوا۔ (ترمذی ۲۱۔ حاکم ۱۶)","Hasan","Musannaf Ibn Abi Shaybah 22405","","","كتاب البيوع والأقضية"
"22406","(۲۲۴۰۶) حَدَّثَنَا مَرْوَانُ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنِ السَّائِبِ بْنِ یَزِیدَ ، قَالَ : قَالَ عُمَرُ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُعْطِینِی الْعَطَاء ، فَأَقُولُ : یَا رَسُولَ اللہِ ، أَعْطِہِ مَنْ ہُوَ أَحْوَجُ إلَیْہِ مِنِّی ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خُذْہُ فَإِمَّا أَنْ تَمَوَّلَہُ ، وَإِمَّا أَنْ تَصَدَّقَ بِہِ ، وَمَا جَائَکَ مِنْ ہَذَا الْمَالِ وَأَنْتَ غَیْرُ سَائِلٍ وَلاَ مُشْرِفٍ فَخُذْہُ ، وَمَا لاَ ، فَلاَ تُتْبِعْہُ نَفْسَک۔ (بخاری ۱۴۷۳۔ مسلم ۷۲۳)","","Musannaf Ibn Abi Shaybah 22406","","","كتاب البيوع والأقضية"
"22407","(۲۲۴۰۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ سَعْدٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن أَبِیہِ ، قَالَ : سَمِعْتُ عُمَرَ بْنَ الْخَطَّابِ یَقُولُ : أَرْسَلَ إلَیَّ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بمال فَرَدَدْتہ ، فَلَمَّا جِئْتہ بِہِ ، قَالَ : مَا حَمَلَک علی أَنْ تَرُدَّ مَا أَرْسَلْت بِہِ إلَیْک ، قَالَ : قُلْتَ لی یَا رَسُولَ اللہِ : إنَّ خَیْرًا لَکَ أَلاَّ تَأْخُذَ مِنَ النَّاسِ ، قَالَ : إنَّمَا ذَاکَ أَنْ تَسْأَلَ النَّاسَ ، وَمَا جَائَ کَ مِنْ غَیْرِ مَسْأَلَۃٍ فَإِنَّمَا ہو رِزْقٌ رَزَقَکہُ اللَّہُ۔","Hasan","Musannaf Ibn Abi Shaybah 22407","","","كتاب البيوع والأقضية"
"22408","(۲۲۴۰۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ عُمَارَۃَ : أَنَّ الأَسْوَدَ أَہْدَی إلَی شُرَیْحٍ نَاقَۃً فَقَبِلَہَا۔","","Musannaf Ibn Abi Shaybah 22408","","","كتاب البيوع والأقضية"
"22409","(۲۲۴۰۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ : أَنَّ شُرَیْحًا أَہْدَی لِلأَسْوَدِ نَاقَۃً ، فَسَأَلَ عَلْقَمَۃَ فَقَالَ : مَا تَرَی ؟ قَالَ : أَخُوک أَکْرَمَک ، أَرَی أَنْ تَقْبَلَہَا ، فَقَبِلَہَا۔","","Musannaf Ibn Abi Shaybah 22409","","","كتاب البيوع والأقضية"
"22410","(۲۲۴۱۰) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا الأَعْمَشُ، قَالَ: رُبَّمَا أَہْدَی أبو الْہَیْثَمِ إلَی إبْرَاہِیمَ الْجملَۃَ مِنَ القَصَبِ فَیَقْبَلُہَا۔","","Musannaf Ibn Abi Shaybah 22410","","","كتاب البيوع والأقضية"
"22411","(۲۲۴۱۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا الأَعْمَش ، قَالَ : أُہْدِیَ إلَی إبْرَاہِیمَ طِلاَئٌ ، فَکَانَ حُلْوًا ، فَنَبَذَہُ۔","","Musannaf Ibn Abi Shaybah 22411","","","كتاب البيوع والأقضية"
"22412","(۲۲۴۱۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أُسَامَۃُ بْنُ زَیْدٍ ، عن عمر بْنِ عبد العزیز ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تہادوا تذہب السخیمۃ ، تصافحوا یذہب الغل۔","","Musannaf Ibn Abi Shaybah 22412","","","كتاب البيوع والأقضية"
"22413","(۲۲۴۱۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ قَیْسِ بْنِ یُسَیْرِ بْنِ عَمْرٍو ، عَنْ أَبِیہِ : أَنَّ أُوَیْسًا الْقَرَنِیَّ عَرِیَ فَکَسَاہُ أَبِی ، فَقَبِلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 22413","","","كتاب البيوع والأقضية"
"22414","(۲۲۴۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ مُہَزِّمٍ ، عَنْ مُحَمَّدِ بْنِ وَاسِعٍ الأَزْدِیِّ ، قَالَ : لاَ یَطِیبُ ہَذَا الْمَالُ إلاَّ مِنْ أَرْبَعِ خِلاَلٍ : سَہْمِ فَیئِ الْمُسْلِمِینَ ، أَوْ تِجَارَۃٍ مِنْ حَلاَلٍ ، أَوْ إعْطَاء مِنْ أَخٍ مُسْلِمٍ عَنْ ظَہْرِ یَدٍ ، أَوْ مِیرَاثٌ فِی کِتَابِ اللہِ۔","","Musannaf Ibn Abi Shaybah 22414","","","كتاب البيوع والأقضية"
"22415","(۲۲۴۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ : فِی رَجُلٍ عَرَضَ عَلَیْہِ رَجُلاَنِ مَالاً ، أَحَدُہُمَا أَخٌ مُسْلِمٌ ، وَالآخَرُ قَرَابَۃٌ مَعَ السُّلْطَانِ ، مِنْ أَیِّہِمَا یَقْبَلُ ؟ قَالَ : مِنَ الْقَرَابَۃِ۔","","Musannaf Ibn Abi Shaybah 22415","","","كتاب البيوع والأقضية"
"22416","(۲۲۴۱۶) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قَالَ أَبُو الدَّرْدَائِ : إذَا وَصَلَ أَحَدُکُمْ أَخَاہُ فَلْیَقْبَلْ صِلَتَہُ ، فَإِنْ کَانَ مُحْتَاجًا إلَیْہِ فَلْیُنْفِقْہُ ، وَإِنْ کَانَ مُسْتَغْنِیًا عَنْہُ فَلْیَضَعْہُ فِی أَہْلِ الْحَاجَۃِ۔","","Musannaf Ibn Abi Shaybah 22416","","","كتاب البيوع والأقضية"
"22417","(۲۲۴۱۷) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَش ، قَالَ : وَلَدَتِ امْرَأَۃٌ لِلْمُسَیِّبِ غُلاَمًا ، فَاشْتَرَی لَہُ خَیْثَمَۃُ ظِئْرًا ، فَأَرْسَلَ بِہَا إلَیْہِ۔","","Musannaf Ibn Abi Shaybah 22417","","","كتاب البيوع والأقضية"
"22418","(۲۲۴۱۸) حَدَّثَنَا عُمَرُ بْنُ عُبَیْدٍ الطَّنَافِسِیُّ ، عَنِ الأَعْمَش ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لاَ تَرُدُّوا الْہَدِیَّۃَ، وَأَجِیبُوا الدَّاعِیَ، وَلاَ تَضْرِبُوا الْمُسْلِمِینَ۔(بخاری ۲۵۶۸۔ احمد ۲/۴۷۹)","Sahih","Musannaf Ibn Abi Shaybah 22418","","","كتاب البيوع والأقضية"
"22419","(۲۲۴۱۹) حَدَّثَنَا أَبُومُعَاوِیَۃَ ، عَنِ الأَعْمَش ، عَنْ أَبِی حَازِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْ أُہْدِیَ إلَیَّ ذِرَاعٌ لَقَبِلْتہ ، وَلَوْ دُعِیت إلَی کُرَاعٍ لاَجَبْت۔","Sahih","Musannaf Ibn Abi Shaybah 22419","","","كتاب البيوع والأقضية"
"22420","(۲۲۴۲۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ سَأَلَ بِاللَّہِ فَأَعْطُوہُ ، وَمَنْ أَہْدَی إلَیْکُمْ کُرَاعًا فَاقْبَلُوہُ۔","Da'if","Musannaf Ibn Abi Shaybah 22420","","","كتاب البيوع والأقضية"
"22421","(۲۲۴۲۱) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی قُرَّۃَ الْکِنْدِیِّ ، عَنْ سَلْمَانَ ، قَالَ: أَتَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِہَدِیَّۃٍ عَلَی طَبَقٍ فَقَالَ : لأَِصْحَابِہِ : کُلُوا۔ (احمد ۵/۴۳۸۔ طبرانی ۶۱۵۵)","Hasan","Musannaf Ibn Abi Shaybah 22421","","","كتاب البيوع والأقضية"
"22422","(۲۲۴۲۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ شَیْخٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : نِعْمَ الشَّیْئُ الْہَدِیَّۃُ بَیْنَ یَدَیِ الْحَاجَۃِ۔ (طبرانی ۲۹۰۳)","Da'if","Musannaf Ibn Abi Shaybah 22422","","","كتاب البيوع والأقضية"
"22423","(۲۲۴۲۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، سَمِعَ جَابِرَ بْنَ زَیْدٍ یَقُولُ : لَمْ نَجِدْ فِی ذَلِکَ الزَّمَانِ لَنا شَیْئاً أَنْفَعَ لَنَا مِنَ الرِّشَا۔","","Musannaf Ibn Abi Shaybah 22423","","","كتاب البيوع والأقضية"
"22424","(۲۲۴۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو الْعُمَیْسِ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ : أَنَّ ابْنَ مَسْعُودٍ لَمَّا أَتَی أَرْضَ الْحَبَشَۃِ أُخِذَ فِی شَیْئٍ فَأَعْطَی دِینَارَیْنِ حَتَّی خُلِّی سَبِیلَہُ۔","","Musannaf Ibn Abi Shaybah 22424","","","كتاب البيوع والأقضية"
"22425","(۲۲۴۲۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : اجْعَلْ مَالَک جُنَّۃً دُونَ دِینِکَ ، وَلاَ تَجْعَلْ دِینَک جُنَّۃً دُونَ مَالِک۔","","Musannaf Ibn Abi Shaybah 22425","","","كتاب البيوع والأقضية"
"22426","(۲۲۴۲۶) حَدَّثَنَا ہِشَامٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ۔ وَعَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ وَالشَّعْبِیِّ ، أَنَّہُمْ قَالُوا: لاَ بَأْسَ أَنْ یُصَانِعَ الرَّجُلُ عَلَی نَفْسِہِ وَمَالِہِ إذَا خَافَ الظُّلْمَ۔","","Musannaf Ibn Abi Shaybah 22426","","","كتاب البيوع والأقضية"
"22427","(۲۲۴۲۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 22427","","","كتاب البيوع والأقضية"
"22428","(۲۲۴۲۸) حَدَّثَنَا ہُشَیْمٌ، عَنْ یُونُسَ، عَنِ الْحَسَنِ: أَنَّہُ کَانَ لاَ یَرَی بأسًا أَنْ یُعْطِیَ الرَّجُلُ مِنْ مَالِہِ مَا یَصُونُ بِہِ عِرْضَہُ۔","","Musannaf Ibn Abi Shaybah 22428","","","كتاب البيوع والأقضية"
"22429","(۲۲۴۲۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : آکِلُ الرِّبَا وَمُؤْکِلُہُ سَوَائٌ۔","Sahih","Musannaf Ibn Abi Shaybah 22429","","","كتاب البيوع والأقضية"
"22430","(۲۲۴۳۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی مُلَیْکَۃَ ، عَنْ عَبْدِ اللہِ بْنِ حَنْظَلَۃَ بْنِ الرَّاہِبِ ، عَنْ کَعْبِ الأَحْبَارِ ، قَالَ : لأَنْ أَزْنِیَ ثَلاَثًا وَثَلاَثِینَ زَنْیَۃً أَحَبُّ إلَیَّ مِنْ أَکْلِ دِرْہَمٍ رِبًا یَعْلَمُ اللَّہُ أَنِّی أَکَلْتہ حِینَ أَکَلْتہ وَہُوَ رِبًا۔ (احمد ۵/۲۲۵)","","Musannaf Ibn Abi Shaybah 22430","","","كتاب البيوع والأقضية"
"22431","(۲۲۴۳۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ ، عَنِ الْحَارِثِ بْنِ عَبْدِ اللہِ ، قَالَ : قَالَ عَبْدُ اللہِ : آکِلُ الرِّبَا وَمُؤْکِلُہُ سواء ، وَکَاتِبُہُ وَشَاہِدُہُ إذَا عَلِمُوا بِہِ ، وَالْوَاشِمَۃُ وَالْمُسْتَوْشِمَۃ لِلْحُسْنِ ، وَلاَوِی الصَّدَقَۃِ ، وَالْمُرْتَدُّ أَعْرَابِیًّا بَعْدَ ہِجْرَتِہِ مَلْعُونُونَ عَلَی لِسَانِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 22431","","","كتاب البيوع والأقضية"
"22432","(۲۲۴۳۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : غُلِّقَتْ عَلَیْکُمْ أَبْوَابُ الرِّبَا فَأَنْتُمْ تَلْتمسُونَ مَحَارِمَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 22432","","","كتاب البيوع والأقضية"
"22433","(۲۲۴۳۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ جَابِر بْنِ عَبْدِ اللہِ ، عَنْ عَلِیٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لُعِنَ آکِلُ الرِّبَا وَمُؤْکِلُہُ وَکَاتِبُہُ وَشَاہِدَاہُ۔","Da'if","Musannaf Ibn Abi Shaybah 22433","","","كتاب البيوع والأقضية"
"22434","(۲۲۴۳۴) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ مُرَّۃَ الْہَمْدَانِیِّ ، قَالَ : قَالَ عُمَرُ: ثَلاَثٌ لأَنْ یَکُونَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیَّنَہُنَّ لَنَا أَحَبُّ إلَیَّ مِنَ الدُّنْیَا وَمَا فِیہَا : الْخِلاَفَۃُ وَالْکَلاَلَۃُ وَالرِّبَا۔n(ابن ماجہ ۲۷۲۷۔ حاکم ۳۰۴)","","Musannaf Ibn Abi Shaybah 22434","","","كتاب البيوع والأقضية"
"22435","(۲۲۴۳۵) حَدَّثَنَا وَکِیع ، حَدَّثَنَا زَکَرِیَّا ، عَنْ عَامِرٍ ، قَالَ : سَمِعْتُ النُّعْمَانَ بْنَ بَشِیرٍ یَخْطُبُ وَأَہْوَی بِإِصْبَعَیْہِ إلَی أُذُنَیْہِ ، یَقُولُ : سَمِعْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : الْحَلاَلُ بَیِّنٌ وَالْحَرَامُ بَیِّنٌ ، وَبَیْنَہُمَا أُمُورٌ مُشْتَبِہَاتٌ ، فَمَنِ اتَّقَی الشُّبُہَاتِ اسْتَبْرَأَ لِدِینِہِ وَعِرْضِہِ ، وَمَنْ وَقَعَ فِی الشُّبُہَاتِ وَقَعَ فِی الْحَرَامِ ، کَالرَّاعِی یَرْعَی حَوْلَ الْحِمَی یُوشِکُ أَنْ یَرْتَعَ فِیہِ ، أَلاَ وَإنَّ لِکُلِّ مَلِکٍ حِمًی وَإِنَّ حِمَی اللہِ مَحَارِمُہُ ، أَلاَ وَإِنَّ فِی الْجَسَدِ مُضْغَۃً إذَا صَلَحَتْ صَلَحَ الْجَسَدُ کُلُّہُ ، وَإِذَا فَسَدَتْ فَسَدَ الْجَسَدُ کُلُّہُ ، أَلاَ وَہِیَ الْقَلْبُ۔n(بخاری ۵۲۔ مسلم ۱۲۲۰)","Sahih","Musannaf Ibn Abi Shaybah 22435","","","كتاب البيوع والأقضية"
"22436","(۲۲۴۳۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ، قَالَ : لَدِرْہَمُ رِبًا أَشَدُّ عِنْدَ اللہِ تَعَالَی مِنْ سِتٍّ وَثَلاَثِینَ زَنْیَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 22436","","","كتاب البيوع والأقضية"
"22437","(۲۲۴۳۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ الْمَقْبُرِیِّ ، عَنْ جَدِّہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الرِّبَا سَبْعُونَ حَوْبًا أَیْسَرُہَا نِکَاحُ الرَّجُلِ أُمَّہُ ، وَأَرْبَی الرِّبَا اسْتِطَالَۃُ الرَّجُلِ فِی عِرْضِ أَخِیہِ۔ (بخاری ۲۳۹)","Da'if","Musannaf Ibn Abi Shaybah 22437","","","كتاب البيوع والأقضية"
"22438","(۲۲۴۳۸) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَبِی ہَانِیئٍ ، عَنْ عَامِرٍ ، قَالَ : قرَأْت کِتَابَ أَہْلِ نَجْرَانَ فَوَجَدْت فِیہِ إِنْ أَکَلْتُمُ الرِّبَا فَلاَ صُلْحَ بَیْنَنَا وَبَیْنَکُمْ وَکَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ یُصَالِحُ مَنْ یَأْکُلُ الرِّبَا۔","Da'if","Musannaf Ibn Abi Shaybah 22438","","","كتاب البيوع والأقضية"
"22439","(۲۲۴۳۹) حَدَّثَنَا جَرِیرٌ ، عَنْ أَشْعَثَ ، عَنْ جَعْفَرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ {الَّذِینَ یَأْکُلُونَ الرِّبَا لاَ یَقُومُونَ إلاَّ کَمَا یَقُومُ الَّذِی یَتَخَبَّطُہُ الشَّیْطَانُ مِنَ الْمَسِّ} قَالَ : یُبْعَثُ یَوْمَ الْقِیَامَۃِ مَجْنُونًا یُخْنَقُ۔ (ابن جریر ۱۰۲)","","Musannaf Ibn Abi Shaybah 22439","","","كتاب البيوع والأقضية"
"22440","(۲۲۴۴۰) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ عَوْنِ بْنِ أَبِی جُحَیْفَۃَ ، عَنْ أَبِیہِ ، قَالَ : لَعَنَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ آکِلَ الرِّبَا وَمُؤْکِلَہُ۔ (بخاری ۲۰۸۶)","Sahih","Musannaf Ibn Abi Shaybah 22440","","","كتاب البيوع والأقضية"
"22441","(۲۲۴۴۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَشْعَثَ وَدَاوُد ، عَنِ الشَّعْبِیِّ ، قَالَ : خَطَبَ عُمَرُ فَحَمِدَ اللَّہَ وَأَثْنَی عَلَیْہِ ، ثُمَّ قَالَ : إنَّا نَأْمُرُکُمْ بِأَشْیَائَ لَعَلَّہَا لاَ تَصْلُحُ لَکُمْ ، وَنَنْہَاکُمْ عَنْ أَشْیَائَ لَعَلَّہَا تَصْلُحُ لَکُمْ ، وَإِنَّ آخِرَ مَا عَہِدَ إلَیْنَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ آیَاتُ الرِّبَا ، فَقُبِضَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَلَمْ یُبَیِّنْہُنَّ لَنَا ، إنَّمَا ہُوَ الرِّبَا وَالرِّیبَۃُ ، فَدَعُوا مَا یَرِیبُکُم إلی مَا لَا یَرِیبُکُم۔n فکان الشعبی إذا سُئلَ عَنِ الشَّیء قَالَ : إنَّمَا ہُوَ الرِّبَا وَالرِّیبَۃُ ، فَدَعُوا الرِّبَا وَالمُرِیبَاتِ۔ (احمد ۱/۳۶)","","Musannaf Ibn Abi Shaybah 22441","","","كتاب البيوع والأقضية"
"22442","(۲۲۴۴۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عِیسَی بْنِ الْمُغِیرَۃِ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ عُمَرُ : لَقَدْ خِفْت أَنْ نَکُونَ قَدْ زِدْنَا فِی الرِّبَا عَشَرَۃَ أَضْعَافِہِ مَخَافَتَہُ۔","","Musannaf Ibn Abi Shaybah 22442","","","كتاب البيوع والأقضية"
"22443","(۲۲۴۴۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : دَفَعَ عَبْدُ اللہِ بْنُ یَزِیدَ الأَنْصَارِیُّ إلَی غُلاَمٍ لَہُ أَرْبَعَۃَ آلاَفٍ ، فَلَحِقَ بِأَصْبَہَانَ فَتَجَرَ حَتَّی صَارَتْ عِشْرِینَ أَلْفًا ، ثُمَّ ہَلَکَ ، فَقِیلَ لَہُ : إنَّہُ کَانَ یُقَارِف الرِّبَا ، فَأَخَذَ أَرْبَعَۃَ آلاَفٍ وَتَرَک مَا سِوَی ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 22443","","","كتاب البيوع والأقضية"
"22444","(۲۲۴۴۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَش ، عَنْ عُمَارَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ الأَنْصَارِیُّ ، قَالَ : قَالَ عَبْدُ اللہِ : الرِّبَا بِضْعٌ وَسَبْعُونَ بَابًا ، وَالشِّرْکُ مِثْلُ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 22444","","","كتاب البيوع والأقضية"
"22445","(۲۲۴۴۵) حَدَّثَنَا یَحْیَی بْنُ أَبِی زَائِدَۃَ ، عَنْ أَبِی یَعْفُورَ ، عَنْ أَیْمَنَ ، قَالَ : سمِعْت یَعْلَی یَقُولُ : سَمِعْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ أَخَذَ أَرْضًا بِغَیْرِ حَقِّہَا کُلِّفَ أَنْ یَحْمِلَ تُرَابَہَا إلَی الْمَحْشَرِ۔n(احمد ۴/۱۷۲۔ ابن حبان ۵۱۶۴)","Hasan","Musannaf Ibn Abi Shaybah 22445","","","كتاب البيوع والأقضية"
"22446","(۲۲۴۴۶) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ ہِشَامٍ بنِ عُرْوَۃَ ، عَنْ أَبِیہ ، عَنْ سَعِیدِ بْنِ زَیْدٍ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ أَخَذَ شِبْرًا مِنَ الأَرْضِ ظُلْمًا فَإِنَّہُ یُطَوَّقُہُ مِنْ سَبْعِ أَرَضِینَ۔n(بخاری ۳۱۹۸۔ مسلم ۱۲۳۱)","Sahih","Musannaf Ibn Abi Shaybah 22446","","","كتاب البيوع والأقضية"
"22447","(۲۲۴۴۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، قَالَ : أُخْبِرْت أَنَّہُ مَا مِنْ أَحَدٍ یَسْرِقُ أَرْضًا یَکُونُ لَہُ تَوْبَۃٌ مَا وَجَدَ أَرْضًا یَحْفِرُہَا۔","","Musannaf Ibn Abi Shaybah 22447","","","كتاب البيوع والأقضية"
"22448","(۲۲۴۴۸) حَدَّثَنَا خَالِدُ ب[corrupt]نُ مَخْلَدٍ ، عَنْ سُلَیْمَانَ بْنِ بِلاَلٍ ، قَالَ : حدَّثَنِی مُحَمَّدُ بْنُ عِجْلاَنَ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَخَذَ شِبْرًا مِنَ الأَرْضِ طُوِّقَہ یَوْمَ الْقِیَامَۃِ مِنْ سَبْعِ أَرَضِینَ۔ (مسلم ۴۳۔ احمد ۲/۳۸۸)","Hasan","Musannaf Ibn Abi Shaybah 22448","","","كتاب البيوع والأقضية"
"22449","(۲۲۴۴۹) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ مَنْصُورِ بْنِ حَیَّانَ ، عَنْ أَبِی الطُّفَیْلِ ، قَالَ : کُنْتُ جَالِسًا عِنْدَ عَلِیٍّ فَأَتَاہُ رَجُلٌ فَقَالَ : ہَلْ کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُسِرُّ إلَیْک ؟ فَغَضِبَ ، فَقَالَ : مَا کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُسِرُّ إلَیَّ شَیْئًا یَکْتُمُہُ النَّاسَ غَیْرَ أَنَّہُ حَدَّثَنِی بِأَرْبَعِ کَلِمَاتٍ ، قَالَ : مَا ہُنَّ ؟ قَالَ : لَعَنَ اللَّہُ مَنْ لَعَنَ وَالِدَہُ ، وَلَعَنَ اللَّہُ مَنْ ذَبَحَ لِغَیْرِ اللہِ ، وَلَعَنَ اللَّہُ مَنْ آوَی مُحْدِثًا ، وَلَعَنَ اللَّہُ مَنْ غَیَّرَ مَنَارَ الأَرْضِ۔n(بخاری ۱۷۔ احمد ۱/۱۱۸)","Sahih","Musannaf Ibn Abi Shaybah 22449","","","كتاب البيوع والأقضية"
"22450","(۲۲۴۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ عَبْدِ اللہِ بْنِ محمد بْنِ عقیل ، عَنْ عَطَائِ بْنِ یَسَارٍ ، عَنْ أَبِی مَالِکٍ الأَشْعَرِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَعْظَمُ الْغُلُولِ عِنْدَ اللہِ یَوْمَ الْقِیَامَۃِ ذِرَاعُ أَرْضٍ یَسْرِقُہَا الرَّجُلُ مِنَ الرَّجُل ، وَالْجَارَانِ یَکُونُ بَیْنَہُمَا الأَرْضُ فَیَسْرِقُ أَحَدُہُمَا مِنْ صَاحِبِہِ فَیُطَوَّقُہُ مِنْ سَبْعِ أَرَضِینَ۔ (احمد ۳۴۱۔ طبرانی ۳۴۶۳)","Da'if","Musannaf Ibn Abi Shaybah 22450","","","كتاب البيوع والأقضية"
"22451","(۲۲۴۵۱) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ طَارِقٍ ، عَنِ ابْنِ سَابِطٍ ، قَالَ : لَعَنَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَرْبَعَۃً : مَنْ أَہَلَّ لِغَیْرِ اللہِ ، وَمَنْ آوَی مُحْدِثًا ، وَمَنْ عَقَّ وَالِدَیْہِ ، وَمَنْ سَرَقَ الْمَنَارَ ، قَالَ : قُلْتُ : وَمَا الْمَنَارُ ؟ قَالَ : الرَّجُلُ یَأْخُذُ مِنْ أَرْضِ صَاحِبِہِ فِی أَرْضِہِ۔","","Musannaf Ibn Abi Shaybah 22451","","","كتاب البيوع والأقضية"
"22452","(۲۲۴۵۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَش ، عَنْ عُمَارَۃَ بْنِ عُمَیْرٍ ، عَنْ مَسْرُوقٍ ، قَالَ : مَنْ ظَلَمَ شِبْرًا مِنَ الأَرْضِ فَطَوَّقَتْہُ ذَوَاتُ الأَرْضِ یَوْمَ الْقِیَامَۃِ لَمْ تَحْمِلْہُ۔","","Musannaf Ibn Abi Shaybah 22452","","","كتاب البيوع والأقضية"
"22453","(۲۲۴۵۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ کُرَیْبٍ ، عن کریب ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ ، یَقُولُ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْمَلْعُونُ مَنِ انْتَقَضَ شَیْئًا مِنْ تُخُومِ الأَرْضِ بِغَیْرِ حَقِّہِ۔n(احمد ۱/۲۱۷۔ ابن حبان ۴۴۱۷)","Da'if","Musannaf Ibn Abi Shaybah 22453","","","كتاب البيوع والأقضية"
"22454","(۲۲۴۵۴) حَدَّثَنَا یَحْیَی بْنُ أَبِی زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : بَلَغْنَا أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْمُؤمِنونَ عِنْدَ شُرُوطِہِمْ۔ (ترمذی ۱۳۵۲۔ ابوداؤد ۳۵۸۹)","","Musannaf Ibn Abi Shaybah 22454","","","كتاب البيوع والأقضية"
"22455","(۲۲۴۵۵) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ حَجَّاجٍ ، عَنْ خَالِدِ بْنِ مُحَمَّدٍ ، عَنْ شَیْخٍ مِنْ بَنِی کِنَانَۃَ ، قَالَ : سَمِعْتُ عُمَرَ یَقُولُ : الْمُسْلِمُ عِنْدَ شَرْطِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 22455","","","كتاب البيوع والأقضية"
"22456","(۲۲۴۵۶) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَشْعَثَ ، عَنْ عَامِرٍ ، عَنْ شُرَیْحٍ ، قَالَ : الْمُسْلِمُونَ عِنْدَ شُرُوطِہِمْ مَا لَمْ یُعْصَ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 22456","","","كتاب البيوع والأقضية"
"22457","(۲۲۴۵۷) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ شَبِیبِ بْنِ غَرْقَدَۃَ، قَالَ، سَمِعْت شُرَیْحًا یَقُولُ: لِکُلِّ مُسْلِمٍ شَرْطُہُ۔","","Musannaf Ibn Abi Shaybah 22457","","","كتاب البيوع والأقضية"
"22458","(۲۲۴۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، قَالَ : جَائَتِ امْرَأَۃٌ إلَی الشَّعْبِیِّ ، فَقَالَتْ : إنَّ ابْنَتِی بِیعَتْ عَلَی شَرْطِ أَنْ لاَ تُبَاعَ ، قَالَ : ابْنَتُک عَلَی شَرْطِہَا۔","","Musannaf Ibn Abi Shaybah 22458","","","كتاب البيوع والأقضية"
"22459","(۲۲۴۵۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ نُسَیْرِ بْنِ ذُعْلُوقٍ الثَّوْرِیِّ ، عَنْ عَمْرِو بْنِ رَاشِدٍ الأَشْجَعِیِّ : أَنَّ رَجُلاً اشْتَرَی مِنْ رَجُلٍ بَعِیرًا وَہُوَ مَرِیضٌ فَاسْتَثْنَی الْبَائِعُ جِلْدَہُ فَبَرِیئَ الْبَعِیرُ ، فَاخْتَصَمَا إلَی عُمَرَ فَأَرْسَلَہُمَا إلَی عَلِیٍّ فَقَالَ عَلِیٌّ : یُقَوَّمُ الْبَعِیرُ فِی السُّوقِ فَیَکُونُ لَہُ شَرْوَی جِلْدِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 22459","","","كتاب البيوع والأقضية"
"22460","(۲۲۴۶۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ ہشام ، عن ابن سیرین ، عن شریح ، قَالَ : لہ شرواہ۔","","Musannaf Ibn Abi Shaybah 22460","","","كتاب البيوع والأقضية"
"22461","(۲۲۴۶۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ زَیْدٍ : فِی رَجُلٍ بَاعَ مِنْ رَجُلٍ بَعِیرًا وَاشْتَرَطَ رَأْسَہُ فَقَالَ لَہُ : شَرْوَی الرَّأْسِ۔","Da'if","Musannaf Ibn Abi Shaybah 22461","","","كتاب البيوع والأقضية"
"22462","(۲۲۴۶۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، قَالَ : بَاعَ رَجُلٌ مِنْ رَجُلٍ بَعِیرًا مَرِیضًا وَاشْتَرَطَ رَأْسَہُ وَمسکہُ ، فَبَرِئَ الْبَعِیرُ فَلَمْ یَنْحَرْہُ فَقَالَ لَہُ شُرَیْحٌ : أَعْطِہِ شَرْوَاہُ ، فَذَکَرْتہ لِعَامِرٍ فَقَالَ : قَضَی عَلِیٌّ وَشُرَیْحٌ بِالشَّرْوَی۔","","Musannaf Ibn Abi Shaybah 22462","","","كتاب البيوع والأقضية"
"22463","(۲۲۴۶۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، قَالَ : الْمُسْلِمُونَ عِنْدَ شُرُوطِہِمْ۔","","Musannaf Ibn Abi Shaybah 22463","","","كتاب البيوع والأقضية"
"22464","(۲۲۴۶۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ یَزِیدَ بْنِ یَزِیدَ بْنِ جَابِرٍ ، عَنْ إسْمَاعِیلَ بْنِ عُبَیْدِ اللہِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ، قَالَ : قَالَ عُمَرُ : إنَّ مَقَاطِعَ الْحُقُوقِ عِنْدَ الشُّرُوطِ۔","Sahih","Musannaf Ibn Abi Shaybah 22464","","","كتاب البيوع والأقضية"
"22465","(۲۲۴۶۵) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عن أبی ہریرۃ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَنَاجَشُوا ، وَلاَ تَبَاغَضُوا ، وَلاَ تَحَاسَدُوا وَکُونُوا عِبَادَ اللہِ إخْوَانًا۔n(بخاری ۴۰۸۔ احمد ۲/۵۰۱)","Hasan","Musannaf Ibn Abi Shaybah 22465","","","كتاب البيوع والأقضية"
"22466","(۲۲۴۶۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْعَوَّامِ ، عَنْ إبْرَاہِیمَ السَّکْسَکِیِّ ، عَنِ ابْنِ أَبِی أَوْفَی ، قَالَ : سَمِعْتُہُ یَقُولُ: النَّاجِشُ آکِلُ الرِّبَا خَائِنٌ۔","Hasan","Musannaf Ibn Abi Shaybah 22466","","","كتاب البيوع والأقضية"
"22467","(۲۲۴۶۷) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ الْعَوَّامِ ، عَنْ إبْرَاہِیمَ السَّکْسَکِیِّ ، عَنِ ابْنِ أَبِی أَوْفَی ، مِثْلَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 22467","","","كتاب البيوع والأقضية"
"22468","(۲۲۴۶۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَنَاجَشُوا۔ (بخاری ۲۱۴۰۔ مسلم ۵۱)","Sahih","Musannaf Ibn Abi Shaybah 22468","","","كتاب البيوع والأقضية"
"22469","(۲۲۴۶۹) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَمْرِو بْنِ مُہَاجِرٍ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ، قَالَ : النَّجْشُ لاَ یَحِلُّ۔","","Musannaf Ibn Abi Shaybah 22469","","","كتاب البيوع والأقضية"
"22470","(۲۲۴۷۰) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : حدَّثَنَا حُسَیْنٌ الْمُعَلِّمُ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ مُجَاہِدٍ ، قَالَ : قُلْتُ لِعَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی: حَدّثْنی حَدِیثًا تَجْمَعُ لِی فِیہِ أَبْوَابَ الرِّبَا، قَالَ: لاَ تَأْکُلْ شَفَّ شَیْئٍ لَیْسَ عَلَیْہِ ضَمَانُہُ۔","","Musannaf Ibn Abi Shaybah 22470","","","كتاب البيوع والأقضية"
"22471","(۲۲۴۷۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : بَعَثَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَتَّابَ بْنَ أَسِیدٍ إلَی أَہْلِ مَکَّۃَ فَقَالَ : تَدْرِی إلَی أَیْنَ بَعَثْتُک ؟ بَعَثْتُک إلَی أَہْلِ اللہِ ، ثُمَّ قَالَ : انْہَہُمْ عَنْ أَرْبَعٍ: عَنْ بَیْعٍ وَسَلَفٍ، وَعَنْ شَرْطَیْنِ فِی بَیْعٍ، وَعَنْ رِبْحِ مَا لَمْ یُضْمَنْ ، وَعَنْ بَیْعِ مَا لَیْسَ عِنْدَکَ۔n(ابوداؤد ۳۴۹۸۔ نسائی ۶۲۲۷)","","Musannaf Ibn Abi Shaybah 22471","","","كتاب البيوع والأقضية"
"22472","(۲۲۴۷۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ، عَنْ عَمْرِو بْنِ شُعَیْبٍ: أَنَّ جَدَّہُ کَانَ إذَا بَعَثَ تِجَارَۃً نَہَاہُمْ، عَنْ سَلَفٍ وَبَیْعٍ ، وَعَنْ شَرْطَیْنِ فِی بَیْعٍ ، وَعَنْ رِبْحِ مَا لَمْ یَضْمَنُوا۔","","Musannaf Ibn Abi Shaybah 22472","","","كتاب البيوع والأقضية"
"22473","(۲۲۴۷۳) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ یَعْقُوبَ بْنِ الْقَعْقَاعِ ، عَنْ مَعْرُوفِ بْنِ سَعدٍ : أَنَّ جَابِرَ بْنَ زَیْدٍ اسْتسلَفَ حَرِیرًا فِی غُرْمٍ أَصَابَہُمْ۔","","Musannaf Ibn Abi Shaybah 22473","","","كتاب البيوع والأقضية"
"22474","(۲۲۴۷۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِالْعِینَۃِ إذَا کَانَتْ عَلَی وَجْہِ الصِّحَّۃِ۔","","Musannaf Ibn Abi Shaybah 22474","","","كتاب البيوع والأقضية"
"22475","(۲۲۴۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَش ، عَنْ إبْرَاہِیمَ ۔ وَعَنْ سُفْیَانَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ۔ وَسُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الْقَاسِمِ ، قَالُوا : لاَ بَأْسَ بِالْعِینَۃِ۔","","Musannaf Ibn Abi Shaybah 22475","","","كتاب البيوع والأقضية"
"22476","(۲۲۴۷۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ قُرَیر ، قَالَ : سُئِلَ ابْنُ سِیرِینَ عَنِ الْعِینَۃِ ؟ قَالَ : کَانَ الرَّجُلُ یُخْرِجُ متاعہ إلَی السُّوقِ ، فَیَبِیعُ بِالنَّقْدِ وَیَبِیعُ بِالنَّسِیئَۃِ۔","","Musannaf Ibn Abi Shaybah 22476","","","كتاب البيوع والأقضية"
"22477","(۲۲۴۷۷) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا أَبُو کَعْبٍ عَبْدُ رَبِّہِ بْنُ عُبَیْدٍ، قَالَ: سَأَلْتُ ابْنَ سِیرِینَ عَنْ بَیْعِ الْحَرِیرِ؟ فَقَالَ: کَانَ الرَّجُلُ یَشْتَرِی الْمَتَاعَ ، ثُمَّ یَضَعُہُ ، فَإِنْ وَجَدَ رِبْحًا بِالنَّقْدِ بَاعَہُ ، وَإِنْ وَجَدَ رِبْحًا بِالنَّسِیئَۃِ بَاعَہُ۔","","Musannaf Ibn Abi Shaybah 22477","","","كتاب البيوع والأقضية"
"22478","(۲۲۴۷۸) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ أَفْلَحَ ، قَالَ : قُلْتُ لِلْقَاسِمِ : الرَّجُلُ یَطْلُبُ مِنِّی الْحِنْطَۃَ وَالزَّیْتَ وَلَیْسَ عِنْدِی إلأَأَنَّہُ قَدْ عَرَفَ سِعْرَ ذَلک ، أوْ عَرَفْتہ فَاشْتَرَیْتہ ، ثُمَّ أَبِیعُہُ إیَّاہُ إلَی أَجَلٍ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 22478","","","كتاب البيوع والأقضية"
"22479","(۲۲۴۷۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : خُذْ رَہْنًا فِی الْعِینَۃِ۔","","Musannaf Ibn Abi Shaybah 22479","","","كتاب البيوع والأقضية"
"22480","(۲۲۴۸۰) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا بَدْرُ بْنُ حُوَیْزَۃَ، قَالَ: سَأَلْتُ الشَّعْبِیَّ عَنِ الرَّہْنِ فِی الْعِینَۃِ؟ فَقَالَ: لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 22480","","","كتاب البيوع والأقضية"
"22481","(۲۲۴۸۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَرْزُوقٍ التَّیْمِیِّ ، عَنْ إبْرَاہِیمَ ، قَالَ فِی الرَّہْنِ فِی الْعِینَۃِ : تُوُفِّیَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَدِرْعُہُ مَرْہُونَۃٌ۔","","Musannaf Ibn Abi Shaybah 22481","","","كتاب البيوع والأقضية"
"22482","(۲۲۴۸۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حُسَیْنِ بْنِ عُقَیْلٍ ، عَنِ الضَّحَّاکِ : أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 22482","","","كتاب البيوع والأقضية"
"22483","(۲۲۴۸۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ الْکَاہِلِیِّ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : لاَ تَشْتَرُوا السَّمَکَ فِی الْمَائِ فَإِنَّہُ غَرَرٌ۔","Da'if","Musannaf Ibn Abi Shaybah 22483","","","كتاب البيوع والأقضية"
"22484","(۲۲۴۸۴) حَدَّثَنَا أَبُو بَکْرٍ ، یَعْنِی ابْنَ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَرِہَ ضَرْبَۃَ التَّالَہ۔","","Musannaf Ibn Abi Shaybah 22484","","","كتاب البيوع والأقضية"
"22485","(۲۲۴۸۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَرِہَ ضَرْبَۃَ القانص۔","","Musannaf Ibn Abi Shaybah 22485","","","كتاب البيوع والأقضية"
"22486","(۲۲۴۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ وَعَطَائٍ : أَنَّہُمْ کَرِہُوا بَیْعَ الآجَامِ۔","","Musannaf Ibn Abi Shaybah 22486","","","كتاب البيوع والأقضية"
"22487","(۲۲۴۸۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ : أنہ کرہ بیع الآجام۔","","Musannaf Ibn Abi Shaybah 22487","","","كتاب البيوع والأقضية"
"22488","(۲۲۴۸۶) حدَّثَنَا سُفْیَانُ ، عَنْ حَمَّادٍ : أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ رَخَّصَ فِی بیع الآجَامِ۔","","Musannaf Ibn Abi Shaybah 22488","","","كتاب البيوع والأقضية"
"22489","(۲۲۴۸۹) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ، قَالَ: لاَ تُبَاعُ خِدْمَۃُ الْمُدَبَّرِ إلاَّ مِنْ نَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 22489","","","كتاب البيوع والأقضية"
"22490","(۲۲۴۹۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عنْ قَارِظِ بْنِ شَیْبَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : لاَ بَأْسَ بِخِدْمَۃِ الْمُدَبَّرِ ، وَکَانَ الزُّہْرِیُّ یَقُولُہُ۔","","Musannaf Ibn Abi Shaybah 22490","","","كتاب البيوع والأقضية"
"22491","(۲۲۴۹۱) حَدَّثَنَا وَکِیعٌ ، قَالَ حَمَّادُ بْنُ زَیْدٍ : عَن أیوب السختیانی ویحیی بْنِ عتیق ، عن ابن سِیرین ، قَالَ : لاَ بأس ببیع خدمۃ المدبر من نفسہ۔","","Musannaf Ibn Abi Shaybah 22491","","","كتاب البيوع والأقضية"
"22492","(۲۲۴۹۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ : أَنَّ رَجُلَیْنِ کَانَ بَیْنَہُمَا غُلاَمٌ فَأَعْتَقَاہُ عَلَی أَنْ یَخْدُمَہُمَا مَا عَاشَا ، فَاشْتَرَی أَحَدُہُمَا مِنَ الآخَرِ نَصِیبَ صَاحِبِہِ فَسُئِلَ عَنْ ذَلِکَ ابْنُ سِیرِینَ فَلَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 22492","","","كتاب البيوع والأقضية"
"22493","(۲۲۴۹۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : بَاعَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خِدْمَۃَ مُدَبَّرٍ۔ (بیہقی ۳۱۲)","","Musannaf Ibn Abi Shaybah 22493","","","كتاب البيوع والأقضية"
"22494","(۲۲۴۹۴) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا دَخَلْت سُوقَ الْمُسْلِمین فَاشْتَرِ مَا وَجَدْت مَا لَمْ تَعْلَمْ أَنَّہُ خِیَانَۃٌ ، أَوْ سَرِقَۃٌ۔","","Musannaf Ibn Abi Shaybah 22494","","","كتاب البيوع والأقضية"
"22495","(۲۲۴۹۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُصْعَبِ بْنِ مُحَمَّدٍ ، عَنْ رَجُلٍ مِنْ أَہْلِ الْمَدِینَۃِ ، قَالَ : [corrupt]َالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنِ اشْتَرَی سَرِقَۃً وَہُوَ یَعْلَمُ أَنَّہَا سَرِقَۃٌ ، فَقَدْ شَرَکَ فِی عَارِہَا وَإِثْمِہَا۔n(حاکم ۳۵۔ بیہقی ۳۳۵)","Da'if","Musannaf Ibn Abi Shaybah 22495","","","كتاب البيوع والأقضية"
"22496","(۲۲۴۹۶) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : قُلْتُ لِعَبِیدَۃَ : أَشْتَرِی السَّرِقَۃَ وَأَنَا أَعْلَمُ أَنَّہَا سَرِقَۃٌ ؟ قَالَ : لاَ ، قُلْتُ : فَأَشْتَرِی الْخِیَانَۃَ وَأَنَا أَعْلَمُ أَنَّہَا خِیَانَۃٌ ؟ قَالَ : لاَ ، قُلْتُ : فَأَشْتَرِی نَیْلَ الْعَمَلِ ؟ قَالَ : وَہَلْ تَسْتَطِیعُ تَرْکَہُ ؟۔n(۲۲۴۹۶)","","Musannaf Ibn Abi Shaybah 22496","","","كتاب البيوع والأقضية"
"22497","(۲۲۴۹۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبِیدَۃَ بِمِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 22497","","","كتاب البيوع والأقضية"
"22498","(۲۲۴۹۸) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ : أَنَّہُ کَانَ یَکْرَہُ أَجْرَ السِّمْسَارِ إلاَّ بِأَجْرٍ مَعْلُومٍ۔","","Musannaf Ibn Abi Shaybah 22498","","","كتاب البيوع والأقضية"
"22499","(۲۲۴۹۹) حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : قُلْتُ لابْنِ عَبَّاسٍ : مَا لاَ یَبِیعُ حَاضِرٌ لِبَادٍ ؟ قَالَ : لاَ یَکُونُ سِمْسَارًا۔","Sahih","Musannaf Ibn Abi Shaybah 22499","","","كتاب البيوع والأقضية"
"22500","(۲۲۵۰۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ وَحَمَّادٌ ، عَنْ إبْرَاہِیمَ وَابْنِ سِیرِینَ ، قَالُوا : لاَ بَأْسَ بِأَجْرِ السِّمْسَارِ إذَا اشْتَرَی یَدًا بِیَدٍ۔","","Musannaf Ibn Abi Shaybah 22500","","","كتاب البيوع والأقضية"
"22501","(۲۲۵۰۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا لَیْثٌ أَبُو عَبْدِ الْعَزِیزِ ، قَالَ : سَأَلْتُ عَطَائً عَنِ السَّمْسَرَۃِ ، فَقَالَ : لاَ بَأْسَ بِہَا۔","","Musannaf Ibn Abi Shaybah 22501","","","كتاب البيوع والأقضية"
"22502","(۲۲۵۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : کَانَ سُفْیَانُ یَکْرَہُ السَّمْسَرَۃَ۔","","Musannaf Ibn Abi Shaybah 22502","","","كتاب البيوع والأقضية"
"22503","(۲۲۵۰۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا : فِی الْعَبْدِ شُفْعَۃٌ ؟ قَالاَ : لاَ۔","","Musannaf Ibn Abi Shaybah 22503","","","كتاب البيوع والأقضية"
"22504","(۲۲۵۰۴) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : قضَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالشُّفْعَۃِ فِی کُلِّ شَیْئٍ۔ (ترمذی ۱۳۷۱)","","Musannaf Ibn Abi Shaybah 22504","","","كتاب البيوع والأقضية"
"22505","(۲۲۵۰۵) حَدَّثَنَا مُعَاذٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَقُولُ : لَیْسَ فِی الْحَیَوَانِ شُفْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 22505","","","كتاب البيوع والأقضية"
"22506","(۲۲۵۰۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عُمَارَۃَ ، عَنْ أَبِی بَکْر بْنِ عَمْرِو بْنِ حَزْمٍ ، عَنْ أَبَانَ بْنِ عُثْمَانَ ، قَالَ : قَالَ عُثْمَانُ : لاَ شُفْعَۃَ فِی بِئْرٍ ، وَلاَ فَحْلٍ وَالأُرَفُ تَقْطَعُ کُلَّ شُفْعَۃٍ۔ (مالک ۷۱۷۔ عبدالرزاق ۱۴۴۲۶)","Hasan","Musannaf Ibn Abi Shaybah 22506","","","كتاب البيوع والأقضية"
"22507","(۲۲۵۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا أَبَانُ بْنُ عَبْدِ اللہِ الْبَجَلِیُّ ، قَالَ: سَأَلْتُ عَطَائً: فِی الثَّوْبِ شُفْعَۃٌ ؟ قَالَ: نَعَمْ۔","","Musannaf Ibn Abi Shaybah 22507","","","كتاب البيوع والأقضية"
"22508","(۲۲۵۰۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنِ ابْنِ أَبِی لَیْلَی وَابْنِ شُبْرُمَۃَ وَرَبِیعَۃَ الرَّأْیِ ، قَالُوا فِی رَجُلَیْنِ یَکُونُ بَیْنَہُمَا الْکِیسُ ، فَیَقُولُ ہَذَا : لِی بَعْضُہ ، وَیَقُولُ ہَذَا : لِی کُلُّہُ۔n قَالَ ابْنُ شُبْرُمَۃُ : لِلَّذِی قَالَ : ہُوَ لِی کُلُّہُ ، نِصْفُہُ خَالِصًا ، وَیَکُونُ مَا بَقِیَ بَیْنَہُمَا۔n وَقَالَ ابْنُ أَبِی لَیْلَی : الثلث والثلثان۔n وَقَالَ ربیعۃ : ہو بینہما نصفان۔","","Musannaf Ibn Abi Shaybah 22508","","","كتاب البيوع والأقضية"
"22509","(۲۲۵۰۹) حَدَّثَنَا جریر ، عن مغیرۃ ، عن الحارث: فی رجلین بینہما مال ، فادعی الواحد نصفہ ، وادعی الآخر الثلثین۔ قَالَ: یعطی صاحب الثُّلُثَیْنِ نِصْفُ الْمَالِ ، لأَنَّ صَاحِبَ النِّصْفِ قَدْ بَرِیئَ مِنَ النِّصْفِ ، وَیُعْطی الَّذِی یَدَّعِی النِّصْفَ الثُّلُثَ ، لأَنَّ صَاحِبَ الثُّلُثَیْنِ قَدْ بَرِیئَ مِنَ الثُّلُثِ ، وَبَقِیَ سُدُسٌ فَکِلاَہُمَا یَدَّعِیہِ ، فَہُوَ بَیْنَہُمَا نِصْفَیْنِ۔","","Musannaf Ibn Abi Shaybah 22509","","","كتاب البيوع والأقضية"
"22510","(۲۲۵۱۰) حَدَّثَنَا عَبْدُاللہِ بْنُ مُبَارَکٍ، عَنْ مَعْمَرٍ، عَنْ أَیُّوبَ، عَنِ ابْنِ سِیرِینَ، قَالَ: لاَ یُبَاعُ الرَّہْنُ إلاَّ عِنْدَ سُلْطَانٍ۔","","Musannaf Ibn Abi Shaybah 22510","","","كتاب البيوع والأقضية"
"22511","(۲۲۵۱۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ خَالِدٍ ، قَالَ : بَعَثَنِی مُحَمَّدُ بْنُ سِیرِینَ إلَی إیَاسَ بْنِ مُعَاوِیَۃَ وَہُوَ عَلَی الْقَضَائِ ، فَقَالَ : قُلْ لَہُ : إنَّ عِنْدِی غَزْلاً رَہْناً قَدْ خَشِیت أَنْ یَفْسُدَ ، فَأَمَرَنِی أَنْ أَبِیعَہُ۔","","Musannaf Ibn Abi Shaybah 22511","","","كتاب البيوع والأقضية"
"22512","(۲۲۵۱۲) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : أَنَّہُ کَانَ یَحْتَکِرُ الزَّیْتَ۔","","Musannaf Ibn Abi Shaybah 22512","","","كتاب البيوع والأقضية"
"22513","(۲۲۵۱۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ مُسْلِمٍ الْخَبَّاطِ ، قَالَ : کُنْتُ أَبْتَاعُ لِسَعِیدِ بْنِ الْمُسَیَّبِ النَّوَی ، وَالْعَجَمَ ، وَالْخَبَطَ فَیَحْتَکِرُہُ۔","","Musannaf Ibn Abi Shaybah 22513","","","كتاب البيوع والأقضية"
"22514","(۲۲۵۱۴) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَش ، عَنْ شَقِیقٍ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا أَنْفَقَتِ الْمَرْأَۃُ مِنْ بَیْتِ زَوْجِہَا غیر مفسدۃ کَانَ لَہَا أَجْرُہَا ، وَلَہُ مِثْلُہُ بِمَا اکْتَسَبَ ، وَلَہَا بِمَا أَنْفَقَتْ ، وَلِلْخَازِنِ مِثْلُ ذَلِکَ۔nزَادَ أَبُو مُعَاوِیَۃَ : مِنْ غَیْرِ أَنْ یُنْتَقَصَ مِنْ أُجُورِہِمْ شَیْئًا۔ (بخاری ۱۴۲۵۔ مسلم ۷۱۰)","Sahih","Musannaf Ibn Abi Shaybah 22514","","","كتاب البيوع والأقضية"
"22515","(۲۲۵۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : سَأَلَتْہ امْرَأَۃٌ فَقَالَتْ : یَأْتِی الْمِسْکِینُ أَفَأَتَصَدَّقُ مِنْ مَالِ زَوْجِی بِغَیْرِ إذْنِہِ ؟ فَکَرِہَہُ ، وَقَالَ لَہَا : أَلَہُ أَنْ یَتَصَدَّقَ بِحُلِیِّکَ بِغَیْرِ إذْنِک۔","","Musannaf Ibn Abi Shaybah 22515","","","كتاب البيوع والأقضية"
"22516","(۲۲۵۱۶) حَدَّثَنَا یَحْیَی بْنُ أَبِی زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : لاَ تَصَّدَّقُ الْمَرْأَۃُ إلاَّ مِنْ قُوتِہَا ، فَأَمَّا مِنْ مَالِ زَوْجِہَا فَلاَ یَحِلُّ لَہَا إلاَّ بِإِذْنِہِ ، وَیَکُونُ الأَجْرُ بَیْنَہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 22516","","","كتاب البيوع والأقضية"
"22517","(۲۲۵۱۷) حَدَّثَنَا یَحْیَی بْنُ أَبِی زَائِدَۃَ ، عَنِ الصَّلْتِ بْنِ بَہْرَامَ ، عْن أُمِّ صَالِحٍ : أَنَّ امْرَأَۃً قَالَتْ لِعَائِشَۃَ : یَصْلُحُ لِلْمَرْأَۃِ أَنْ تَأْخُذَ مِنْ بَیْتِ زَوْجِہَا الشَّیْئَ بِغَیْرِ إذْنِہِ ؟ فَقَالَتْ : مَا عَلَیْہَا إِنْ فَعَلَتْ ذَلِکَ أَمْ نَقَبَتْ بَیْتَ جَارَتِہَا فَسَرَقَتْ۔","Da'if","Musannaf Ibn Abi Shaybah 22517","","","كتاب البيوع والأقضية"
"22518","(۲۲۵۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : جَائَتْ ہِنْدٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : یَا رَسُولَ اللہِ ، إنَّ أَبَا سُفْیَانَ رَجُلٌ شَحِیحٌ ، فَلاَ یُعْطِینِی مَا یَکْفِینِی وَوَلَدِی ، إلاَّ مَا أَخَذْت مِنْ مَالِہِ وَہُوَ لاَ یَعْلَمُ ، فَقَالَ : خُذِی مَا یَکْفِیک وَوَلَدَک بِالْمَعْرُوفِ۔ (بخاری ۲۲۱۱۔ احمد ۶/۳۹)","Sahih","Musannaf Ibn Abi Shaybah 22518","","","كتاب البيوع والأقضية"
"22519","(۲۲۵۱۹) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا إیَاسُ بْنُ دَغْفَلٍ، عَنِ الْحَسَنِ، قَالَ: جَائَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : یَا رَسُولَ اللہِ ، مَا أَمْرِی وَأَمْرُ صَاحِبَتِی ؟ قَالَ : وأَیُّ أَمْرِکُمَا ؟ قَالَ : تَصَّدَّقُ مِنْ بَیْتِی بِغَیْرِ إذْنِی ، قَالَ : الأَجْرُ بَیْنَکُمَا ، قَالَ : أَرَأَیْت إِنْ مَنَعْتہَا ؟ قَالَ لَہَ[corrupt] مَا اَحْتَسَبَتْ ، وَلَک مَا بَخِلْتَ بِہِ۔(عبدالرزاق ۱۶۶۱۶)","Hasan","Musannaf Ibn Abi Shaybah 22519","","","كتاب البيوع والأقضية"
"22520","(۲۲۵۲۰) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ یُونُسَ ، عَنْ زِیَادِ بْنِ جُبَیْرٍ ، عَنْ سَعْدٍ ، قَالَ : لَمَّا بَایَعَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ النِّسَائَ قَامَتْ إلَیْہِ امْرَأَۃٌ جَلِیلَۃٌ کَأَنَّہَا مِنْ نِسَائِ مُضَرَ ، فَقَالَتْ : یَا رَسُولَ اللہِ ، إنَّا کَلٌّ عَلَی آبَائِنَا وَأَزْوَاجِنَا وَأَبْنَائِنَا ، فَمَا یَحِلُّ لَنَا مِنْ أَمْوَالِہِمْ ؟ قَالَ : الرَّطْبُ تَأْکُلِینَہُ وَتُہْدِینَہُ۔ (ابوداؤد ۱۶۸۳۔ حاکم ۱۳۴)","Sahih","Musannaf Ibn Abi Shaybah 22520","","","كتاب البيوع والأقضية"
"22521","(۲۲۵۲۱) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ شُرَحْبِیلَ بْنِ مُسْلِمٍ ، قَالَ : سَمِعْتُ أَبَا أُمَامَۃَ الْبَاہِلِیَّ یَقُولُ : سَمِعْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ فِی حَجَّتِہِ عَامَ حَجَّۃِ الْوَدَاعِ : لاَ تُنْفِقُ أمْرَأَۃٌ شَیْئًا مِنْ بَیْتِ زَوْجِہَا إلاَّ بِإِذْنِہِ ، قِیلَ : یَا رَسُولَ اللہِ ، وَلاَ الطَّعَامُ ؟ قَالَ : ذَلِکَ أَفْضَلُ أَمْوَالِنَا۔","Hasan","Musannaf Ibn Abi Shaybah 22521","","","كتاب البيوع والأقضية"
"22522","(۲۲۵۲۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ وَمُحَمَّدٌ وَشُرَیْحٌ ، قَالَ : بَیْعُ الشَّرِیکِ جَائِزٌ مَا لَمْ یُنْہَ۔","","Musannaf Ibn Abi Shaybah 22522","","","كتاب البيوع والأقضية"
"22523","(۲۲۵۲۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ سَیَّارٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : کُلُّ شَرِیکٍ بَیْعُہُ فِی شِرْکَتِہِ جَائِزٌ إلاَّ شَرِکَۃً فِی مِیرَاثٍ۔","","Musannaf Ibn Abi Shaybah 22523","","","كتاب البيوع والأقضية"
"22524","(۲۲۵۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سِمَاکٍ ، عَنْ سُوَیْد بْنِ قَیْسٍ ، قَالَ : جَلَبْت أَنَا وَمَخْرَفَۃُ الْعَبْدِیُّ بَزًّا مِنْ ہَجَرَ ، فَجَائَنَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَسَاوَمَنَا سَرَاوِیلَ ، وَعِنْدَنَا وَزَّانٌ یَزِنُ بِالأَجْرِ ، فَقَالَ لَہُ النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَاوَزَّانُ زِنْ وَأَرْجِحْ۔ (ترمذی ۱۳۰۵۔ ابوداؤد ۳۳۲۹)","Hasan","Musannaf Ibn Abi Shaybah 22524","","","كتاب البيوع والأقضية"
"22525","(۲۲۵۲۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ مُحَارِبِ بْنِ دِثَارٍ ، عَنْ جَابِرٍ ، قَالَ : اشتری منی النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بعیرًا ، فوزن لی ثمنہ ، وأرجح لی۔ (بخاری ۳۰۸۹۔ احمد ۳/۳۰۲)","Sahih","Musannaf Ibn Abi Shaybah 22525","","","كتاب البيوع والأقضية"
"22526","(۲۲۵۲۶) حَدَّثَنَا وَکِیعٌ ، عن مسعر ، عَنْ مُحَارِبِ بْنِ دِثَارٍ ، عَنْ جَابِرٍ ، قَالَ : کان لی علی النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دین ، فقضانی وزادنی۔ (بخاری ۴۴۳۔ احمد ۳/۳۱۹)","Sahih","Musannaf Ibn Abi Shaybah 22526","","","كتاب البيوع والأقضية"
"22527","(۲۲۵۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسماعیل بن أبی خالد ، عن أبیہ ، قَالَ : کَانَ لِی عَلَی الْحَسَنِ بْنِ عَلِیٍّ دَیْنٌ، فَأَتَیْتہ أَتَقَاضَاہُ ، فَوَجَدْتہ قَدْ خَرَجَ مِنَ الْحَمَّامِ وَقَدْ أَثَّرَت الْحِنَّائُ بِأَظْفَارِہِ وَجَارِیۃٌ لہُ تَحُکُّ الْحِنَّائَ عَنْہُ بِقَارُورَۃٍ ، فَدَعَا بقَعْب فِیہِ دَرَاہِمُ فَقَالَ : خُذْ ہَذَا ، فَقُلْتُ : ہَذَا أَکْثَرُ مِنْ حَقِّی ، قَالَ : خُذْہُ ، فَأَخَذْتہ فَوَجَدْتہ یَزِیدُ عَلَی حَقِّی بِسِتِّینَ ، أَوْ سَبْعِینَ دِرْہَمًا۔","Da'if","Musannaf Ibn Abi Shaybah 22527","","","كتاب البيوع والأقضية"
"22528","(۲۲۵۲۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ فِی الرُّجْحَانِ فِی الْوَزْنِ۔","","Musannaf Ibn Abi Shaybah 22528","","","كتاب البيوع والأقضية"
"22529","(۲۲۵۲۹) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ لَیْثٍ ، عَنْ أَبِی الْخَطَّابِ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ أَبِی إدْرِیسَ ، عَنْ ثَوْبَانَ ، قَالَ : لَعَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الرَّاشِیَ ، وَالْمُرْتَشِیَ ، وَالرَّائِشَ ، یَعْنِی الَّذِی یَمْشِی بَیْنَہُمَا۔","Da'if","Musannaf Ibn Abi Shaybah 22529","","","كتاب البيوع والأقضية"
"22530","(۲۲۵۳۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ خَالِہِ الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : لَعَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الرَّاشِیَ وَالْمُرْتَشِیَ۔","Hasan","Musannaf Ibn Abi Shaybah 22530","","","كتاب البيوع والأقضية"
"22531","(۲۲۵۳۱) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ أَبِی حَصِینٍ، عَنْ شُرَیْحٍ، قَالَ: الرَّاشِی، وَالْمُرْتَشِی، وَالْمُفْتَری۔n قَالَ وَکِیعٌ : یَعْنِی الْمُفْتَری الَّذِی یَقُولُ : أَرْتَشَی الْقَاضِیَ۔","","Musannaf Ibn Abi Shaybah 22531","","","كتاب البيوع والأقضية"
"22532","(۲۲۵۳۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَاصِمِ بْنِ أَبِی النَّجُودِ ، عَنْ زِرِّ بْنِ حُبَیْشٍ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : السُّحْتُ الرِّشْوَۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 22532","","","كتاب البيوع والأقضية"
"22533","(۲۲۵۳۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ مُغِیرَۃَ ، عَنْ أبْرَاہِیمَ : فِی رَجُلٍ رَہَنَ عَبْدًا فَأَعْتَقَہُ ، قَالَ : عِتْقُ الْعَبْدِ جَائِزٌ وَیَتْبَعُ الْمُرْتَہِنُ الرَّاہِنَ۔","","Musannaf Ibn Abi Shaybah 22533","","","كتاب البيوع والأقضية"
"22534","(۲۲۵۳۴) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : سَأَلْتُ الْحَسَنَ بْنَ صَالِحٍ وَشَرِیکًا عَنِ الرَّجُلِ یَرْہَنُ عَبْدَہُ ، ثُمَّ یُعْتِقُہُ ؟ قَالاَ: عِتْقُہُ جَائِزٌ۔n وَقَالَ شَرِیکٌ : یَسْعَی الْعَبْدُ لِلْمُرْتَہِنِ۔n وَقَالَ الْحَسَنُ بْنُ صَالِحٍ : لَیْسَ عَلَیْہِ سِعَایَۃٌ۔","","Musannaf Ibn Abi Shaybah 22534","","","كتاب البيوع والأقضية"
"22535","(۲۲۵۳۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ : فِی رَجُلٍ اشْتَرَی مِنْ رَجُلٍ عَبْدًا فَلَمْ یَقْبِضْہُ حَتَّی أَعْتَقَہُ ، قَالَ : لاَ یَجُوزُ عِتْقُہُ حَتَّی یَقْبِضَہُ ، أَوْ یَنْقُدَہُ۔","","Musannaf Ibn Abi Shaybah 22535","","","كتاب البيوع والأقضية"
"22536","(۲۲۵۳۶) حَدَّثَنَا وَکِیعٌ ، قَالَ سَمِعْت سُفْیَانَ یَقُولُ : إذَا أَعْتَقَ الرَّجُلُ عَبْدَہُ خَرَجَ مِنَ الرَّہْنِ ، وَإِذَا دَبَّرَہُ خَرَجَ مِنَ الرَّہْنِ ، وَإِذَا کَانَتْ أَمَۃً فَوَطِئَہَا فَجَائَتْ بِوَلَدٍ خَرَجَتْ مِنَ الرَّہْنِ ، وَإِنْ کَانَ السَّیِّدُ مُوسِرًا أَتْبَعَ الْمُرْتَہِنُ السَّیِّدَ بِالرَّہْنِ ، وَإِنْ کَانَ مُعْسِرًا سَعَی ہَؤُلاَئِ فِی الأَقَلِّ مِنْ قِیمَتِہِمْ وَالرَّہْنِ۔n وَقَالَ سُفْیَانُ : یَرْجِعُ بِمَا سَعَی فِیہِ عَلَی الْمَوْلَی إذَا أَیْسَرَ ، وَأُمُّ الْوَلَدِ وَالْمُدَبَّرُ لاَ یَرْجِعَانِ عَلَی مَوْلاَہُمَا بِشَیْئٍ لأَنَّ خِدْمَتَہُمَا لِلْمَوْلَی۔","","Musannaf Ibn Abi Shaybah 22536","","","كتاب البيوع والأقضية"
"22537","(۲۲۵۳۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا ہشام ، عَنِ الْحَسَنِ : أَنَّہُ لَمْ یَکُنْ یَرَی بَأْسًا بِالرَّجُلَیْنِ یَشْتَرِکَانِ فَیَجِیئُ ہَذَا بِدَنَانِیرَ وَالآخَرُ بِدَرَاہِمَ ، وَقَالَ : الدَّنَانِیرُ عَیْنٌ کُلُّہُ ، فَإِذَا أَرَادَا أَنْ یَفْتَرِقَا أَخَذَ صَاحِبُ الدَّنَانِیرِ دَنَانِیرَ ، وَأَخَذَ صَاحِبُ الدَّرَاہِمِ دَرَاہِمَ ، ثُمَّ اقْتَسَمَا الرِّبْحَ۔n قَالَ ہِشَامٌ : وَکَانَ مُحَمَّدٌ یُحِبُّ أَنْ یَکُونَ دَرَاہِمَ وَدَرَاہِمَ ، وَدَنَانِیرَ وَدَنَانِیرَ۔","","Musannaf Ibn Abi Shaybah 22537","","","كتاب البيوع والأقضية"
"22538","(۲۲۵۳۸) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : رَأَیْتُ شُرَیْحًا یَقْضِی وَعِنْدَہُ أَبُو عَمْرٍو الشَّیْبَانِیِّ وَأَشْیَاخٌ نَحْوُہُ یُجَالِسُونَہُ عَلَی الْقَضَائِ۔","","Musannaf Ibn Abi Shaybah 22538","","","كتاب البيوع والأقضية"
"22539","(۲۲۵۳۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ مُحَارِبَ بْنَ دِثَارٍ وَحَمَّادًا وَالْحَکَمَ وَأَحَدُہُمَا عَنْ یَمِینِہِ وَالآخَرُ عَنْ یَسَارِہِ ، یَنْظُرُ إلَی ا[corrupt]ْحَکَمِ مَرَّۃً ، وَإِلَی حَمَّادٍ مَرَّۃً ، وَالْخُصُومُ بَیْنَ یَدَیْہِ۔","","Musannaf Ibn Abi Shaybah 22539","","","كتاب البيوع والأقضية"
"22540","(۲۲۵۴۰) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَش ، قَالَ : قَالَ لِی الْقَاسِمُ : اجْلِسْ إلَیَّ وَہُوَ یَقْضِی بَیْنَ النَّاسِ۔","","Musannaf Ibn Abi Shaybah 22540","","","كتاب البيوع والأقضية"
"22541","(۲۲۵۴۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اشْتَرَی مِنْ أَعْرَابِیٍّ جَزُورًا بِوَسْقٍ مِنْ تَمْرٍ ، فَأَرْسَلَ إلَی خَوْلَۃَ بِنْتِ حَکِیمٍ فَأَوْفَتْہُ ، وَقَالَ : خِیَارُکُمَ الْمُوفُونَ المطَیَبُونَ۔n(احمد ۶/۲۶۸)","","Musannaf Ibn Abi Shaybah 22541","","","كتاب البيوع والأقضية"
"22542","(۲۲۵۴۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَنْ مُجَاہِدٍ ، قَالَ : اشْتَرَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُہْرًا مِنْ أَعْرَابِیٍّ بِمِئَۃِ صَاعٍ مِنْ تَمْرٍ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِلرَّجُلِ : انْطَلِقْ فَقُلْ لَہُمْ : تَأْکُلُون حَتَّی تَشْبَعُوا ، وَتَکْتَالُون حَتَّی تَسْتَوْفُوا۔ یَعْنِی : الْکَیْلَ ، فَخَرَجَ الرَّجُلُ وَہُوَ یَحُکُ بِمِرْفَقَیْہِ۔ یَعْنِی : یَشْتَدُّ۔ (ابوداؤد ۱۶۹)","","Musannaf Ibn Abi Shaybah 22542","","","كتاب البيوع والأقضية"
"22543","(۲۲۵۴۳) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عُبَیْدَۃَ ، قَالَ : حدَّثَنی أَبِی ، عَنِ الأَعْمَش ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لاَ قُدِّسَتْ أُمَّۃٌ لاَ یُعْطَی الضَّعِیفُ فِیہَا حَقَّہُ غَیْرَ مُتَعْتِعٍ۔(ابویعلی ۱۰۹۱)","Sahih","Musannaf Ibn Abi Shaybah 22543","","","كتاب البيوع والأقضية"
"22544","(۲۲۵۴۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ سَالِمٍ ، قَالَ : شَہِدْت الْقَاسِمَ بْنَ عَبْدِ الرَّحْمَنِ وَخَاصَمَ إلَیْہِ رَجُلٌ عَامِلاً مِنْ عُمَّالِ الْحَجَّاجِ غَصَبَہُ طَعَامًا کَانَ لَہُ ، فَسَأَلَہُ الْقَاسِمُ الْبَیِّنَۃَ ، فَجَائَ بِبَیِّنَۃ فَشَہِدُوا أَنَّہُ أَخَذَ طَعَامًا لَہُ مِنْ بُیُوتِہِ ، فَقَالَ لَہُم الْقَاسِمُ : کَم الطعام الذی أخذہ ؟ قالوا : لاَ ندری ما کیلہ ، قَالَ : فإنی لاَ أقضی لہ بشیء حتی تُخْبِرُونِی بِکَیْلِ مَا أَخَذَ مِنَ الطَّعَامِ۔","","Musannaf Ibn Abi Shaybah 22544","","","كتاب البيوع والأقضية"
"22545","(۲۲۵۴۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ سَالِمٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : شَہِدْتہ وَاخْتَصَمَ إلَیْہِ رَجُلاَنِ اشْتَرَی أَحَدُہُمَا مِنَ الآخَرِ دَابَّۃً ، فَقَالَ لِلْقَاسِمِ : مُرْہُ فَلْیُعْطِنِی کَفِیلاً إن أَدْرَکَنِی فِی ہَذِہِ الدَّابَّۃِ دَرَکٌ ، فَقَالَ : ہَلْ کُنْت اشْتَرَطْت عَلَیْہِ ذَلِکَ عِنْدَ عُقْدَۃِ الْبَیْعِ ؟ قَالَ : لاَ قَالَ : لَیْسَ لَکَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 22545","","","كتاب البيوع والأقضية"
"22546","(۲۲۵۴۶) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ جمیل بْنِ بِشْرٍ ، قَالَ : رَأَیْتُ سَالِمَ بْنَ عَبْدِ اللہِ مَرَّ بِصَاحِبِ صِیرٍ ، یَعْنِی صَحْنَاۃً ، فَأَخَذَ مِنْہُ فَذَاقَہُ ، فَقَالَ : کَیْفَ تَبِیعُ ہَذَا ؟۔","","Musannaf Ibn Abi Shaybah 22546","","","كتاب البيوع والأقضية"
"22547","(۲۲۵۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ، قَالَ: لاَ بَأْسَ إذَا اشْتَرَی الرَّجُلُ الْفَاکِہَۃَ أَنْ یَأْکُلَ مِنْہَا یَعْنِی یَذُوقُہَا۔","","Musannaf Ibn Abi Shaybah 22547","","","كتاب البيوع والأقضية"
"22548","(۲۲۵۴۸) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ إذَا اشْتَرَی الشَّیْئَ أَنْ یَذُوقَہُ قَبْلَ أَنْ یَشْتَرِیَہُ۔","","Musannaf Ibn Abi Shaybah 22548","","","كتاب البيوع والأقضية"
"22549","(۲۲۵۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ۔ وَالشَّیْبَانِیُّ ، عَنِ الشَّعْبِیِّ۔ وَسُفْیَانُ ، عَنِ الأَعْمَش، عَنْ إبْرَاہِیمَ: فِی الرَّجُلِ یَبِیعُ السِّلْعَۃَ بِالنَّقْدِ ، ثُمَّ یَشْتَرِیہَا بِأَقَلَّ مِمَّا بَاعَہَا قَبْلَ أَنْ یَنْتَقِدَ فَکَرِہَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 22549","","","كتاب البيوع والأقضية"
"22550","(۲۲۵۵۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : لاَ بَأْسَ إذَا بَاعَہَا بِالنَّقْدِ أَنْ یَشْتَرِیَہَا بِدُونِ مَا بَاعَہَا إذَا قَاصَّہُ۔","","Musannaf Ibn Abi Shaybah 22550","","","كتاب البيوع والأقضية"
"22551","(۲۲۵۵۱) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ وَابْنُ سِیرِینَ ، قَالاَ : الْکَفَالَۃُ وَالْحَوَالَۃُ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 22551","","","كتاب البيوع والأقضية"
"22552","(۲۲۵۵۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالْقَوَارِیرِ الصِّحَاحِ بِالْوَازِنَۃِ الْمَکْسُورَۃِ ، إذَا کَانَتْ أَفْضَلَ مِنَ الصِّحَاحِ۔nوَکَانَ ابْنُ سِیرِینَ یَکْرَہُ ذَلِکَ إلاَّ وَزْنًا بِوَزْنٍ۔","","Musannaf Ibn Abi Shaybah 22552","","","كتاب البيوع والأقضية"
"22553","(۲۲۵۵۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یُشَابَنَّ لَبَنٌ لِبَیْعٍ۔ (عبدالرزاق ۷۲۷۰)","Hasan","Musannaf Ibn Abi Shaybah 22553","","","كتاب البيوع والأقضية"
"22554","(۲۲۵۵۴) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ وَحَمَّادٌ ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَرِہ أَنْ یُکْسَرَ الدِّرْہَمَ عِنْدَ الْبَقَّالِ فَیَأْخُذَ غَیْرَ الَّذِی کَسَرَہُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 22554","","","كتاب البيوع والأقضية"
"22555","(۲۲۵۵۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ : أَنَّہُ کَانَ یَکْرَہُ تَعْجِیلَ الدِّرْہَمِ لِلْبَقَّالِ ، وَسُئِلَ عَنْ ذَلِکَ الْحَسَنُ ؟ فَقَالَ : وَاللَّہِ مَا بَلَغَ مِنَّا ہَذَا۔","","Musannaf Ibn Abi Shaybah 22555","","","كتاب البيوع والأقضية"
"22556","(۲۲۵۵۶) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ : فِی الرَّجُلِ یُسْلِمُ إلَی الْبَقَّالِ الدِّرْہَمَ ، قَالَ : لاَ یَأْخُذُ إلاَّ الَّذِی أَسْلَمَ فِیہِ ، وَإِنْ وَضَعَہُ عِنْدَہُ فَلْیَأْخُذْ مَا شَائَ۔","","Musannaf Ibn Abi Shaybah 22556","","","كتاب البيوع والأقضية"
"22557","(۲۲۵۵۷) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ خَالِدٍ ، عَنْ مُحَمَّدٍ : أَنَّہُ کَرِہَ أَنْ یُعْطِیَ الْبَقَّالَ الدِّرْہَمَ فَیَأْخُذَ مِنْہُ الْبَیْعَ ، وَلَکِنْ یَأْخُذُ مِنْہُ ، فَإِذَا تَمَّ دِرْہَم أَعْطَاہُ۔","","Musannaf Ibn Abi Shaybah 22557","","","كتاب البيوع والأقضية"
"22558","(۲۲۵۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ مُحَمَّدِ بْنِ زِیَادٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنِ اشْتَرَی مُصَرَّاۃً ، فَہُوَ فِیہَا بِالْخِیَارِ ، إِنْ شَائَ رَدَّہَا وَرَدَّ مَعَہَا صَاعًا مِنْ تَمْرٍ۔n(بخاری ۲۱۴۸۔ ابوداؤد ۳۴۳۶)","Sahih","Musannaf Ibn Abi Shaybah 22558","","","كتاب البيوع والأقضية"
"22559","(۲۲۵۵۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ رَجُلٍ مِنْ أَصْحَابِ النَّبِیِّ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنِ اشْتَرَی مُصَرَّاۃً فَہُوَ فِیہَا بِأحَدِ النَّظَرَیْنِ ، إِنْ رَدَّہَا رَدَّ مَعَہَا صَاعًا مِنْ تَمْرٍ ، أَوْ صَاعًا مِنْ طَعَامٍ۔(احمد ۴/۳۱۴)","Sahih","Musannaf Ibn Abi Shaybah 22559","","","كتاب البيوع والأقضية"
"22560","(۲۲۵۶۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا التَّیْمِیُّ ، عَنْ أَبِی عُثْمَانَ النَّہْدِیِّ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنِ اشْتَرَی مُحَفَّلَۃً فَرَدَّہَا فَلْیَرُدَّ مَعَہَا صَاعًا۔","Sahih","Musannaf Ibn Abi Shaybah 22560","","","كتاب البيوع والأقضية"
"22561","(۲۲۵۶۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَأَلْتُہ عَنِ الْخُصِّ یَدَّعِیہِ أَہْلُ ہَذِہِ الدَّارِ وَأَہْلُ ہَذِہِ ، قَالَ : ہُوَ لِلَّذِی یَلِیہِمُ القُِمُْط ۔ وسألتہ عن الحائط اللَّبِن یدعیہ أہل ہذہ الدار ، وأہل ہذہ ، قَالَ: ہو للذی یَلِیہِمُ الأنْصَافُ۔","","Musannaf Ibn Abi Shaybah 22561","","","كتاب البيوع والأقضية"
"22562","(۲۲۵۶۲) حَدَّثَنَا حَفْصٌ ، عَنْ زَکَرِیَّا ، عَنْ حُمَیْدٍ ، قَالَ : تَقَدَّمْت مَعَ أَبِی إلَی شُرَیْحٍ فَسَمِعْتہ یَقْضِی بِالْخُصِّ إلَی مَنْ کَانَتَ إلیہ الْقِمْطُ۔","","Musannaf Ibn Abi Shaybah 22562","","","كتاب البيوع والأقضية"
"22563","(۲۲۵۶۳) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا مُوسَی بْنُ عُبَیْدَۃَ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ: أَنَّہُ کَرِہَ کَالِئًا بِکَالِئٍ یَعْنِی دَیْنًا بِدَیْنٍ۔","Da'if","Musannaf Ibn Abi Shaybah 22563","","","كتاب البيوع والأقضية"
"22564","(۲۲۵۶۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَاصِمٍ ، عَنِ الْحَکَمِ : أَنَّہُ کَرِہَ آجِلاً بِآجِلٍ یَعْنِی : دَیْنًا بِدَیْنٍ۔","","Musannaf Ibn Abi Shaybah 22564","","","كتاب البيوع والأقضية"
"22565","(۲۲۵۶۵) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ أَسْلَمَ الْمُنْقِرِیِّ، عَنْ عَطَائٍ: أَنَّہُ کَرِہَ آجِلاً بِآجِلٍ یَعْنِی: دَیْنًا بِدَیْنٍ۔","","Musannaf Ibn Abi Shaybah 22565","","","كتاب البيوع والأقضية"
"22566","(۲۲۵۶۶) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : نَہَی رَسُولُ اللہ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُبَاعَ کَالِیئٌ بِکَالِیئٍ ، یَعْنِی : دَیْنًا بِدَیْنٍ۔ (دارقطنی ۷۱۔ حاکم ۵۷)","Da'if","Musannaf Ibn Abi Shaybah 22566","","","كتاب البيوع والأقضية"
"22567","(۲۲۵۶۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو عَاصِمٍ الثَّقَفِیُّ ، عَنْ أَبِی بَکْرِ بْنِ أَبِی مُوسَی : أَنَّ أَبَاہُ کَانَ یَبِیعُ الْعَصِیرَ۔","Hasan","Musannaf Ibn Abi Shaybah 22567","","","كتاب البيوع والأقضية"
"22568","(۲۲۵۶۸) حَدَّثَنَا وَکِیعٌ ، قَالَ شُعْبَۃُ : عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ عِقَار بْنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، قَالَ : سُئِلَ ابْنُ عُمَرَ عَنْ بَیْعِ الْکَرْمِ ؟ فَقَالَ : زَبِّبُوہُ ، ثُمَّ بِیعُوہُ۔","Sahih","Musannaf Ibn Abi Shaybah 22568","","","كتاب البيوع والأقضية"
"22569","(۲۲۵۶۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ بْنِ دِینَارٍ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ : أَنَّ صَاحِبَ ضَیْعَۃِ سَعْدٍ أَتَاہُ فَقَالَ : إنَّ الأَعْنَابَ قَدْ کَثُرَتْ ، فَقَالَ : اتَّخِذْہُ زَبِیبًا ، بِعْہُ عِنَبًا ، فَقَالَ : إِنَّہُ أَکْثَرُ مِنْ ذَلِکَ ، قَالَ : فَخَرَجَ سَعْدٌ إلَی ضَیْعَتِہِ فَأَمَرَ بِہَا فَقُلِعَتْ ، وَقَالَ لِقَہْرَمَانِہِ : لاَ أَئْتَمِنُکَ عَلَی شَیْئٍ بَعْدَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 22569","","","كتاب البيوع والأقضية"
"22570","(۲۲۵۷۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ : أَنَّ أَبَا عَبِیْدَۃَ کَانَ لَہُ کَرْمٌ ، فَکَانَ یَقُولُ لِوُکَلاَئِہِ : بِیعُوہُ عِنَبًا ، فَإِنْ لَمْ یُشْتَرُ فَبِیعُوہُ عَصِیرًا حِینَ تَعْصِرُونَہُ۔","","Musannaf Ibn Abi Shaybah 22570","","","كتاب البيوع والأقضية"
"22571","(۲۲۵۷۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عُمَرَ بْنِ عَامِرٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ۔ وَعَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِبَیْعِ الْعَصِیرِ مَا لَمْ یَغْلِ۔","","Musannaf Ibn Abi Shaybah 22571","","","كتاب البيوع والأقضية"
"22572","(۲۲۵۷۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ : فِی الرَّجُلِ یَبِیعُ الْعَصِیرَ مِمَّنْ یَجْعَلُہُ خَمْرًا ، قَالَ : أَحَبُّ إلَیَّ أَنْ یَبِیعَہُ مِنْ غَیْرِ مَنْ یَجْعَلَہُ خَمْرًا ، وَإِنْ بَاعَہُ فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 22572","","","كتاب البيوع والأقضية"
"22573","(۲۲۵۷۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ : أَنَّہُ سُئِلَ عَنْ بَیْعِ الْعَصِیرِ فَقَالَ : بِعْہُ مَا کَانَ حُلْوًا۔","","Musannaf Ibn Abi Shaybah 22573","","","كتاب البيوع والأقضية"
"22574","(۲۲۵۷۴) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَکَمِ : فِی الرَّجُلِ یَکُونُ لَہُ الْکَرْمُ فَیَبِیعُہُ عَصِیرًا ، فَقَالَ : إِذَا بَاعَہُ عَصِیرًا أَوْ عِنَبًا فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 22574","","","كتاب البيوع والأقضية"
"22575","(۲۲۵۷۵) حَدَّثَنَا وَکِیعٌ، حَدَّثَنَا الْحَسَنُ بْنُ صَالِحٍ، عَنْ أَبِی طَوْق، عَنْ عَطَائٍ، قَالَ: لاَ تَبِعِ الْعِنَبَ مِمَّنْ یَجْعَلُہُ خَمْرًا۔","","Musannaf Ibn Abi Shaybah 22575","","","كتاب البيوع والأقضية"
"22576","(۲۲۵۷۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَأَلْتُ سُفْیَانَ عَنْ بَیْعِ الْعَصِیرِ ؟ فَقَالَ : بِعِ الْحَلاَلَ مِمَّنْ شِئْت۔","","Musannaf Ibn Abi Shaybah 22576","","","كتاب البيوع والأقضية"
"22577","(۲۲۵۷۷) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنِ ابْنِ جریج ، عَنْ عَطَائٍ ، قَالَ : لاَ تَبِعِ الْعَصِیرَ مِمَّنْ یَجْعَلُہُ خَمْرًا۔","","Musannaf Ibn Abi Shaybah 22577","","","كتاب البيوع والأقضية"
"22578","(۲۲۵۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ : أَنَّ عُمَرَ قَضَی فِی رَجُلٍ وَہَبَ لِرَجُلٍ بَہِیمَۃً فَوَلَدَتْ ، قَالَ : لَہُ أَنْ یَرْجِعَ فِی الْقِیمَۃِ یَوْمَ وَہَبَ۔","","Musannaf Ibn Abi Shaybah 22578","","","كتاب البيوع والأقضية"
"22579","(۲۲۵۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ زِیَادٍ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ أَنْ یَرْجِعَ فِی الْہِبَۃِ فِی الْقِیمَۃِ یَوْمَ وَہَبَ ، وَکَتَبَ ، إنَّ الزِّیَادَۃَ لِلْمَوْہُوبِ لَہُ۔","","Musannaf Ibn Abi Shaybah 22579","","","كتاب البيوع والأقضية"
"22580","(۲۲۵۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، عَنْ شَقِیقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ حَلَفَ عَلَی یَمِینِ صَبْرٍ لِیَقْتَطِعَ بِہَا مَالَ امْرِئٍ مُسْلِمٍ وَہُوَ فِیہَا فَاجِرٌ ، لَقِیَ اللَّہَ وَہُوَ عَلَیْہِ غَضْبَانُ ، قَالَ : فَدَخَلَ الأَشْعَثُ بْنُ قَیْسٍ فَقَالَ : مَا یُحَدِّثُکُمْ أَبُو عَبْدِ الرَّحْمَنِ ؟ قُلْنَا ، کَذَا وَکَذَا ، قَالَ : صَدَقَ ، فِی وَاللَّہِ نَزَلَتْ ، کَانَ بَیْنِی وَبَیْنَ رَجُلٍ مِنَ الْیَہُودِ خُصُومَۃٌ ، فَخَاصَمْتہ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : أَلِکَ بَیِّنَۃٌ ؟ قُلْتُ : لاَ ، قَالَ : فَلَکَ یَمِینُہُ ، فَقُلْتُ : إذًا یَحْلِفُ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ حَلَفَ عَلَی یَمِینِ صَبْرٍ فَذَکَرَ مِثْلَ قَوْلِ عَبْدِ اللہِ فَنَزَلَتْ ہَذِہِ الآیَۃُ : {إنَّ الَّذِینَ یَشْتَرُونَ بِعَہْدِ اللہِ وَأَیْمَانِہِمْ ثَمَنًا قَلِیلاً}۔ (بخاری ۲۳۵۶۔ مسلم ۲۲۰)","Sahih","Musannaf Ibn Abi Shaybah 22580","","","كتاب البيوع والأقضية"
"22581","(۲۲۵۸۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْوَلِیدِ بْنِ کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ کَعْبِ بْنِ مَالِکٍ : أَنَّہُ سَمِعَ أَخَاہُ عَبْدَ اللہِ بْنَ کَعْبٍ یُحَدِّثُ ، أَنَّ أَبَا أُمَامَۃَ الْحَارِثِیَّ حَدَّثَہُ أَنَّہُ سَمِعَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : لاَ یَقْتَطِعُ رَجُلٌ حَقَّ امْرِئٍ مُسْلِمٍ بِیَمِینِہِ إلاَّ حَرَّمَ اللَّہُ عَلَیْہِ الْجَنَّۃَ وَأَوْجَبَ لَہُ النَّارَ ، قَالَ : فَقَالَ رَجُلٌ مِنَ الْقَوْمِ : یَا رَسُولَ اللہِ ، وَإِنْ کَانَ شَیْئًا یَسِیرًا ، قَالَ : وَإِنْ کَانَ سِوَاکًا مِنْ أَرَاکٍ۔ (مسلم ۲۱۹۔ احمد ۵/۲۶۰)","Sahih","Musannaf Ibn Abi Shaybah 22581","","","كتاب البيوع والأقضية"
"22582","(۲۲۵۸۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا ہَاشِمُ بْنُ ہَاشِمٍ ، قَالَ : أَخْبَرَنِی عبْدُ اللہِ بْنُ نِسْطَاسٍ : أَنَّہُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللہِ یَقُولُ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَحْلِفُ أَحَدٌ عِنْدَ مِنْبَرِی ہَذَا عَلَی یَمِینٍ آثِمَۃٍ ، وَلَوْ عَلَی سِوَاکٍ أَخْضَرَ ، إلاَّ تَبَوَّأَ مَقْعَدَہُ مِنَ النَّارِ ، أَوْ أوْجِبَ لَہُ النَّارَ۔ (ابوداؤد ۳۲۴۱۔ ابن ماجہ ۲۳۲۵)","Sahih","Musannaf Ibn Abi Shaybah 22582","","","كتاب البيوع والأقضية"
"22583","(۲۲۵۸۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ جَامِعٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : مَنِ اقْتَطَعَ مَالَ مُسْلِمٍ بِیَمِینِہِ ظَالِمًا لَقِیَ اللَّہَ وَہُوَ عَلَیْہِ غَضْبَانُ۔ (بخاری ۷۴۴۵۔ مسلم ۱۲۳)","Sahih","Musannaf Ibn Abi Shaybah 22583","","","كتاب البيوع والأقضية"
"22584","(۲۲۵۸۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ ثَابِتِ بْنِ الْحَجَّاجِ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إنِ اقْتَطَعَہَا بِیَمِینِہِ کَانَ مِمَّنْ لاَ یُکَلِّمُہُمُ اللَّہُ ، وَلاَ یَنْظُرُ إلَیْہِمْ ، وَلاَ یُزَکِّیہِمْ وَلَہُمْ عَذَابٌ أَلِیمٌ۔ (احمد ۴/۳۹۴)","Sahih","Musannaf Ibn Abi Shaybah 22584","","","كتاب البيوع والأقضية"
"22585","(۲۲۵۸۵) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ سِمَاکٍ ، عَنْ عَلْقَمَۃَ بْنِ وَائِلٍ ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ قَالَ : إِنْ حَلَفَ عَلَی مَالِہِ لِیَأْکُلَہُ ظَالِمًا لَیلْقِیَنَّ اللَّہَ وَہُوَ عَنْہُ مُعْرِضٌ۔ (مسلم ۱۲۳۔ ابوداؤد ۳۲۳۹)","Hasan","Musannaf Ibn Abi Shaybah 22585","","","كتاب البيوع والأقضية"
"22586","(۲۲۵۸۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْحَارِثُ بْنُ سُلَیْمَانَ الْکِنْدِیُّ ، عَنْ کُرْدُوسٍ الثَّعْلَبِیِّ ، عَنْ أَشْعَثَ بْنِ قَیْسٍ، قَالَ : قَالَ النَّبِیُّ عَلَیْہ السَلام : مَنْ حَلَفَ عَلَی یَمِینِ صَبْرٍ لِیَقْتَطِعَ بِہَا مَالَ امْرِئٍ مُسْلِمٍ وَہُوَ فِیہَا فَاجِرٌ لَقِیَ اللَّہَ وَہُوَ أَجْذَمُ۔ (ابوداؤد ۳۲۳۸۔ احمد ۵/۲۱۲)","Da'if","Musannaf Ibn Abi Shaybah 22586","","","كتاب البيوع والأقضية"
"22587","(۲۲۵۸۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ثَوْرٌ ، عَنْ مَحْفُوظِ بْنِ عَلْقَمَۃَ ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ : مَنْ حَلَفَ عَلَی یَمِینِ غَیْبٍ أَصَابَ فِیہَا مَأْثَمًا صَدَقَ فِیہَا ، أَوْ فَجَرَ۔","","Musannaf Ibn Abi Shaybah 22587","","","كتاب البيوع والأقضية"
"22588","(۲۲۵۸۸) حَدَّثَنَا یُونُسُ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنْ ہِشَامِ بْنِ سَعْدٍ ، عَنْ مُحَمَّدِ بْنِ زَیْدِ بْنِ الْمُہَاجِرِ بْنِ قُنْفُذٍ ، عَنْ أَبِی أُمَامَۃَ الأَنْصَارِیِّ ، عَنْ عَبْدِ اللہِ بْنِ أُنَیْسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَا حَلَفَ حَالِفٌ بِاللَّہِ یَمِینَ صَبْرٍ فَأَدْخَلَ فِیہَا مِثْلَ جَنَاحِ بَعُوضَۃٍ إلاَّ کَانَتْ نُکْتَۃً فِی قَلْبِہِ إلَی یَوْمِ الْقِیَامَۃِ۔n(ترمذی ۳۰۲۰۔ احمد ۳/۴۹۵)","Da'if","Musannaf Ibn Abi Shaybah 22588","","","كتاب البيوع والأقضية"
"22589","(۲۲۵۸۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، قَالَ: حدَّثَنَا ہِشَامُ بْنُ حَسَّانَ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : مَنْ حَلَفَ عَلَی یَمِینٍ مَصْبُورَۃٍ کَاذِبًا مُتَعَمِّدًا فَلْیَتَبَوَّأْ بِوَجْہِہِ مَقْعَدَہُ مِنَ النَّارِ۔ (ابوداؤد ۳۲۴۰۔ احمد ۴/۴۳۶)","Sahih","Musannaf Ibn Abi Shaybah 22589","","","كتاب البيوع والأقضية"
"22590","(۲۲۵۹۰) حَدَّثَنَا شَبَابَۃُ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ سَعِیدِ بْنِ زَیْدٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : مَنْ حَلَفَ عَلَی یَمِینِ امْرِئٍ مُسْلِمٍ لِیَقْتَطِعَہُ لَمْ یُبَارَکْ لَہُ فِیہِ۔n(احمد ۱/۱۸۸۔ ابو یعلی ۹۵۱)","Sahih","Musannaf Ibn Abi Shaybah 22590","","","كتاب البيوع والأقضية"
"22591","(۲۲۵۹۱) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ عِمْرَانَ الْقَطَّانِ ، قَالَ : سَمِعْتُ الْحَسَنَ وَسُئِلَ عَنْ رَجُلٍ رَأَی جَارِیَۃً فِی السُّوقِ تُبَاعُ ، فَقَالَتْ : إنِّی مَسْرُوقَۃٌ ، فَقَالَ : تُشْتَرَی ، وَلاَ تُصَدَّقُ ، وَسَأَلْت قَتَادَۃَ فَکَرِہَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 22591","","","كتاب البيوع والأقضية"
"22592","(۲۲۵۹۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا کَاتَبَ عَبْدَہُ وَلَہُ عَبْدٌ أَوْ أَمَۃٌ ، فَہُوَ مِنْ مُکَاتَبَتِہِ ، وَإِنْ کَانَ لَہُ وَلَدٌ وکَتَمَہُمْ فَلَیْسَ لَہُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 22592","","","كتاب البيوع والأقضية"
"22593","(۲۲۵۹۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَش ، عَنْ إبْرَاہِیمَ ، بِنَحْوِہِ۔","","Musannaf Ibn Abi Shaybah 22593","","","كتاب البيوع والأقضية"
"22594","(۲۲۵۹۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْْر ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ لَہُ : رَجُلٌ کَاتَبَ عَبْدًا لَہُ أَوْ قَاطَعَہُ ، فَکَتَمَہُ مَالاً لَہُ : رَقِیقًا ، أَوْ عَیْنًا ، أَوْ مَالاً غَیْرَ ذَلِکَ ؟ قَالَ : ہُوَ لِلْعَبْدِ۔وَقَالَہُ عَمْرُو بْنُ دِینَارٍ وَسُلَیْمَانُ بْنُ مُوسَی۔","","Musannaf Ibn Abi Shaybah 22594","","","كتاب البيوع والأقضية"
"22595","(۲۲۵۹۵) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ، عَنْ یُونُسَ، عَنِ الْحَسَنِ، قَالَ: أُمُّ وَلَدِہِ وَوَلَدُہُ یَدْخُلُونَ جَمِیعًا فِی مُکَاتَبَتِہِ۔","","Musannaf Ibn Abi Shaybah 22595","","","كتاب البيوع والأقضية"
"22596","(۲۲۵۹۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ : أَنَّ رَجُلاً کَاتَبَ غُلاَمًا لَہُ وَاشْتَرَطَ وَلاَئَہُ وَمِیرَاثَہُ وَدَارَہُ ، فَلَمَّا أَدَّی مُکَاتَبَتَہُ عَتَقَ ، ثُمَّ مَاتَ ، فَخَاصَمَ أَوْلِیَاؤُہُ فِی مِیرَاثِہِ ، فَأَبْطَلَ شُرَیْحٌ ذَلِکَ ، فَقَالَ الْمَوْلَی: فَمَا یُغْنِی عَنِّی شَرْطِی مُنْذُ عِشْرِینَ سَنَۃً ؟ فَقَالَ شُرَیْحٌ : شَرْطُ اللہِ قَبْلَ شَرْطِکَ مُنْذُ خَمْسِینَ سَنَۃً۔","","Musannaf Ibn Abi Shaybah 22596","","","كتاب البيوع والأقضية"
"22597","(۲۲۵۹۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدِ : أنَّ عَدِیًا کَتَبَ إلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ فِی رَجُلٍ کَاتَبَ غُلاَمًا لَہُ وَشَرَطَ عَلَیْہِ سَہْمًا مِنْ مِیرَاثِہِ ، فَکَتَبَ إلیہ : إنَّہُ لَیْسَ لأَحَدٍ شَرْطٌ یَنْقصُ أَوْ یَنْتَقِصُ شَیْئًا مِنْ فَرَائِضِ اللہِ۔","","Musannaf Ibn Abi Shaybah 22597","","","كتاب البيوع والأقضية"
"22598","(۲۲۵۹۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سُئِلَ عَطَائٌ عَنْ رَجُلٍ کُوتِبَ ، وَاشْتَرَطَ عَلَیْہِ أَہْلُہُ أَنَّ لَنَا سَہْمًا مِنْ مِیرَاثِکَ ؟ قَالَ : لاَ ، شَرْطُ اللہِ قَبْلَ شَرْطِہِمْ۔","","Musannaf Ibn Abi Shaybah 22598","","","كتاب البيوع والأقضية"
"22599","(۲۲۵۹۹) حَدَّثَنَا سُوَیْد بْنُ عَمْرٍو ، عَنْ أَبِی عَوَانَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : بِنَحْوٍ مِنْ قَوْلِ عَطَائٍ۔","","Musannaf Ibn Abi Shaybah 22599","","","كتاب البيوع والأقضية"
"22600","(۲۲۶۰۰) حَدَّثَنَا عَبْدَۃُ وَوَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ : أَنَّہُ کَرِہَ أَجْرَ الْمُغَنِّیَۃِ ، زَادَ فِیہِ عَبْدَۃُ : وَقَالَ مَا أُحِبُّ أَنْ آکُلَہُ۔","","Musannaf Ibn Abi Shaybah 22600","","","كتاب البيوع والأقضية"
"22601","(۲۲۶۰۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ : أَنَّہُ کَرِہَ أَجْرَ النَّائِحَۃِ وَالْمُغَنِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 22601","","","كتاب البيوع والأقضية"
"22602","(۲۲۶۰۲) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ أَبِی ہَاشِمٍ، عَنْ إبْرَاہِیمَ: أَنَّہُ کَرِہَ أَجْرَ النَّائِحَۃِ وَالْمُغَنِّیَۃِ وَالْکَاہِنِ۔","","Musannaf Ibn Abi Shaybah 22602","","","كتاب البيوع والأقضية"
"22603","(۲۲۶۰۳) حدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ ہُبَیْرَۃَ (وَأَکْلِہِمُ السُّحْتَ) قَالَ : مَہْرُ الْبَغْیِ ، وَمَا کَانَ یَأْخُذُ الْکاہنُ عَلَی کِہَانَتِہِمْ۔","","Musannaf Ibn Abi Shaybah 22603","","","كتاب البيوع والأقضية"
"22604","(۲۲۶۰۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَشْتَرِیَ الصَّکَّ بِالْبَزِّ عَلَی الرَّجُلِ نَوَی أَوْ لَمْ یَنْوِ۔","","Musannaf Ibn Abi Shaybah 22604","","","كتاب البيوع والأقضية"
"22605","(۲۲۶۰۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، قَالَ : سَأَلْتُہ عَنْ رَجُلٍ اشْتَرَی مِنْ رَجُلٍ صَکًّا فِیہِ ثَلاَثَۃُ دَنَانِیرَ بِثَوْبٍ ، قَالَ : لاَ یَصْلُحُ۔","","Musannaf Ibn Abi Shaybah 22605","","","كتاب البيوع والأقضية"
"22606","(۲۲۶۰۶) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ عَبْدِاللہِ بْنِ أَبِی السَّفَرِ، عَنِ الشَّعْبِیِّ: أَنَّہُ کَرِہَہُ وَقَالَ : ہُوَ غَرَرٌ۔","","Musannaf Ibn Abi Shaybah 22606","","","كتاب البيوع والأقضية"
"22607","(۲۲۶۰۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا تَبَیَّنَ إفْلاَسُ الرَّجُلِ فَلاَ یَجُوزُ عَتَاقُہُ وَعَلَیْہِ دَیْنٌ ، وَإِنْ لَمْ یَتَبَیَّنْ إفْلاَسُہُ فَعَتَاقُہُ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 22607","","","كتاب البيوع والأقضية"
"22608","(۲۲۶۰۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ رِبْعِیٍّ ، قَالَ : حدَّثَنِی أَبُو الْیَسَرِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَنْظَرَ مُعْسِرًا أَوْ وَضَعَ لَہُ : أَظَلَّہُ اللَّہُ فِی ظِلِّ عَرْشِہِ۔n(مسلم ۷۴۔ حاکم ۲۸)","Sahih","Musannaf Ibn Abi Shaybah 22608","","","كتاب البيوع والأقضية"
"22609","(۲۲۶۰۹) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی الْیَسَرِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوِہِ۔ (طبرانی ۳۷۴)","Sahih","Musannaf Ibn Abi Shaybah 22609","","","كتاب البيوع والأقضية"
"22610","(۲۲۶۱۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، قَالَ : سَمِعْتُ عُبَیْدَ بْنَ عُمَیْرٍ ، قَالَ : کَانَ رَجُلٌ یُدَایِنُ النَّاسَ وَیُبَایِعُہُمْ ، وَکَانَ لَہُ کَاتِبٌ وَمُتْجَازی ، فَیَأْتِیہِ الْمُعْسِرُ وَالْمُسْتَنْظِرُ فَیَقُولُ : کِلْ وَأَنْظِرْ وَتَجَاوَزَ الْیَوْمَ ، یُتَجَاوَزَ عَنَّا ، قَالَ : فَلَقِیَ اللَّہَ وَلَمْ یَعْمَلْ خَیْرًا غَیْرَہُ فَغَفَرَ لَہُ۔","","Musannaf Ibn Abi Shaybah 22610","","","كتاب البيوع والأقضية"
"22611","(۲۲۶۱۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَش ، عَنْ شَقِیقٍ ، عَنْ أَبِی مَسْعُودٍ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: حُوسِبَ رَجُلٌ مِمَّنْ کَانَ قَبْلَکُمْ فَلَمْ یُوجَدْ لَہُ مِنَ الْخَیْرِ شَیْئٌ إلأَأَنَّہُ کَانَ رَجُلاً مُوسِرًا یُخَالِطُ النَّاسَ فَیَقُولُ لِغِلْمَانِہِ : تَجَاوَزُوا عَنِ الْمُعْسِرِ ، فَقَالَ : اللَّہُ لِمَلاَئِکَتِہِ : فَنَحْنُ أَحَقُّ بِذَلِکَ مِنْہُ ، فَتَجَاوَزُوا عَنْہُ۔n(مسلم ۳۰۔ ترمذی ۱۳۰۷)","Sahih","Musannaf Ibn Abi Shaybah 22611","","","كتاب البيوع والأقضية"
"22612","(۲۲۶۱۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مَنْصُورٍ ، عَنْ رِبْعِیٍّ ، عَنْ أَبِی مَسْعُودٍ بِنَحْوٍ مِنْہُ وَلَمْ یَرْفَعْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 22612","","","كتاب البيوع والأقضية"
"22613","(۲۲۶۱۳) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَبِی جَعْفَرٍ الْخَطْمِیِّ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ ، عَنْ أَبِی قَتَادَۃَ ، قَالَ : سَمِعْتُ النَّبِیَّ : صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ نَفَّسَ عَنْ غَرِیمہ أَوْ مَحَا عَنْہُ ، کَانَ فِی ظِلِّ الْعَرْشِ یَوْمَ الْقِیَامَۃِ۔ (احمد ۵/۳۰۰۔ عبد بن حمید ۱۹۵)","Sahih","Musannaf Ibn Abi Shaybah 22613","","","كتاب البيوع والأقضية"
"22614","(۲۲۶۱۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ رِبْعِیٍّ ، قَالَ : قَالَ عُقْبَۃُ بْنُ عَمْرٍو لِحُذَیْفَۃَ : حَدِّثْنِی بِشَیْئٍ سَمِعْتہ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : سَمِعْتُ رسول اللہ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : کَانَ رَجُلٌ فِیمَنْ کَانَ قَبْلَکُمْ أَتَاہُ الْمَلَکُ لِیَقْبِضَ رُوحَہُ فَقَالَ : ہَلْ عَمِلْت خَیْرًا ؟ قَالَ : مَا أَعْلَمُہُ ، قَالَ : اُنْظُرْ ، قَالَ : مَا أَعْلَمُہُ إلاَّ أَنِّی کُنْت رَجُلاً أُجَازِفُ النَّاسَ وَأُخَالِطُہُمْ ، فَکُنْت أُنْظِرُ الْمُعْسِرَ وَأَتَجَاوَزُ عَنِ الْمُوسِرِ ، فَأَدْخَلَہُ اللَّہُ الْجَنَّۃَ ، قَالَ عُقْبَۃُ : وَأَنَا سَمِعْتہ یَقُولُ ذَلِکَ۔ (مسلم ۱۱۹۵)","Sahih","Musannaf Ibn Abi Shaybah 22614","","","كتاب البيوع والأقضية"
"22615","(۲۲۶۱۵) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، عَنْ زُہَیْرِ بْنِ مُحَمَّدٍ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ عَبْدِ اللہِ بْنِ سَہْلِ بْنِ حُنَیْفٍ ، أَنَّ سَہْلاً حَدَّثَہُ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ أَعَانَ مُجَاہِدًا فِی سَبِیلِ اللہِ ، أَوْ غَارِمًا فِی عُسْرَتِہِ ، أَوْ مُکَاتَبًا فِی رَقَبَتِہِ أَظَلَّہُ اللَّہُ یَوْمَ لاَ ظِلَّ إلاَّ ظِلُّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 22615","","","كتاب البيوع والأقضية"
"22616","(۲۲۶۱۶) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ بِأَعْرَابِیٍّ یَبِیعُ شَیْئًا فَقَالَ : عَلَیْک بِأَوَّلِ السَّوْمَۃِ ، أَوْ بِأَوَّلِ السَّوْمِ فَإِنَّ الرِّبَاحَ مَعَ السَّمَاحِ۔ (ابوداؤد ۱۶۷)","","Musannaf Ibn Abi Shaybah 22616","","","كتاب البيوع والأقضية"
"22617","(۲۲۶۱۷) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرِو بْنِ عَلْقَمَۃَ ، عَنِ ابن أَبِی حُسَیْنٍ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : سَیِّدُ السِّلْعَۃِ أَحَقُّ بِالسَّوْمِ۔ (ابوداؤد ۱۶۶)","","Musannaf Ibn Abi Shaybah 22617","","","كتاب البيوع والأقضية"
"22618","(۲۲۶۱۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : أَرْثِم أنْفَہ بِالسَّوْمِ۔","Da'if","Musannaf Ibn Abi Shaybah 22618","","","كتاب البيوع والأقضية"
"22619","(۲۲۶۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ شَقِیقٍ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ أَبُو بَکْرٍ فِی مَرَضِہِ الَّذِی مَاتَ فِیہِ : اُنْظُرُوا مَا زَادَ فِی مَالِی مُنْذُ دَخَلْت فِی الْخِلاَفَۃِ فَابْعَثُوا بِہِ إلَی الْخَلِیفَۃِ مِنْ بَعْدِی ، فَإِنِّی قَدْ کُنْت أَسْتَحِلُّہُ ، وَقَدْ کُنْت أَصَبْت مِنَ الْوَدَکِ نَحْوًا مِمَّا کُنْت أَصَبْت مِنَ التِّجَارَۃِ ، قَالَتْ عَائِشَۃُ : فَلَمَّا مَاتَ نَظَرْنَا ، فَإِذَا عَبْدٌ نُوبِیٌّ یَحْمِلُ صِبْیَانَہُ وَنَاضِحٌ کَانَ یَسْقِی عَلَیْہِ ، قَالَتْ : فَبَعَثْنَا بِہِمَا إلَی عُمَرَ ، قَالَتْ : فَأَخْبَرَنِی جَدِّی ، أَنَّ عُمَرَ بَکَی وَقَالَ : رَحْمَۃُ اللہِ عَلَی أَبِی بَکْرٍ ، لَقَدْ أَتْعَبَ مَنْ بَعْدَہُ تَعَبًا شَدِیدًا۔","Sahih","Musannaf Ibn Abi Shaybah 22619","","","كتاب البيوع والأقضية"
"22620","(۲۲۶۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ جَامِعِ بْنِ أَبِی رَاشِدٍ ، قَالَ : قَالَ عُمَرُ : لَوْلاَ ہَذِہِ الْبُیُوعُ صِرْتُمْ عَالَۃً عَلَی النَّاسِ۔","","Musannaf Ibn Abi Shaybah 22620","","","كتاب البيوع والأقضية"
"22621","(۲۲۶۲۱) حَدَّثَنَا وکیع ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ شَرِیکٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : قالَتْ عَائِشَۃُ : کَانَ أَبُو بَکْرٍ أَتْجَرَ قُرَیْشٍ۔","Sahih","Musannaf Ibn Abi Shaybah 22621","","","كتاب البيوع والأقضية"
"22622","(۲۲۶۲۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ خَیْثَمَۃَ ، قَالَ : قَالَ أَبُو الدَّرْدَائِ : کُنْت تَاجِرًا قَبْلَ أَنْ یُبْعَثَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَلَمَّا بُعِثَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَرَدْت أَنْ أَجْمَعَ بَیْنَ التِّجَارَۃِ وَالْعِبَادَۃِ فَلَمْ یَسْتَقِمْ لِی ، فَتَرَکْت التِّجَارَۃَ وَأَقْبَلْت عَلَی الْعِبَادَۃِ۔","","Musannaf Ibn Abi Shaybah 22622","","","كتاب البيوع والأقضية"
"22623","(۲۲۶۲۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یَزِیدُ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : نُبِّئْتُ أَنَّ أَبَا بَکْرٍ کَانَ أَتْجَرَ قُرَیْشٍ۔","","Musannaf Ibn Abi Shaybah 22623","","","كتاب البيوع والأقضية"
"22624","(۲۲۶۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَمْرِو بْنِ قَیْسٍ ، عَنْ عَاصِمِ بْنِ أَبِی النَّجُودِ ، عَنْ أَبِی وَائِلٍ ، قَالَ : لَدِرْہَمٌ مِنْ تِجَارَۃٍ أَحَبُّ إلَیَّ مِنْ عَشَرَۃٍ مِنْ عَطَائِی۔","","Musannaf Ibn Abi Shaybah 22624","","","كتاب البيوع والأقضية"
"22625","(۲۲۶۲۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَجَّاجِ بْنِ فُرَافِصَۃَ ، عَنْ رَجُلٍ ، عَنْ مَکْحُولٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ طَلَبَ الدُّنْیَا حَلاَلاً اسْتِعْفَافًا عَنِ الْمَسْأَلَۃِ وَسَعْیًا عَلَی أَہْلِہِ وَتَعَطُّفًا عَلَی جَارِہِ لَقِیَ اللَّہَ وَوَجْہُہُ کَالْقَمَرِ لَیْلَۃَ الْبَدْرِ ، وَمَنْ طَلَبَ الدُّنْیَا حَلاَلاً مُکَاثِرًا مُرَائِیًا لَقِیَ اللَّہَ وَہُوَ عَلَیْہِ غَضْبَانُ۔ (عبد بن حمید ۱۴۳۳۔ بیہقی ۹۸۹۰)","Da'if","Musannaf Ibn Abi Shaybah 22625","","","كتاب البيوع والأقضية"
"22626","(۲۲۶۲۶) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا عَمْرُو بْنُ عِیسَی أَبُو نَعَامَۃَ سَمِعَہُ أوْ قَالَ : حَدَّثَنَا حریث بْنُ الرَّبِیعِ الْعَدَوِیُّ، قَالَ : سَمِعْتُ عُمَرَ بْنَ الْخَطَّابِ یَقُولُ : کُتِبَتْ عَلَیْکُمْ ثَلاَثَۃُ أَسْفَارٍ : الْحَجُّ وَالْعُمْرَۃُ وَالْجِہَادُ فِی سَبِیلِ اللہِ، وَالرَّجُلُ یَسْعَی بِمَالِہِ فِی وَجْہٍ مِنْ ہَذِہِ الْوُجُوہِ ، أَبْتَغِی بِمَالِی مِنْ فَضْلِ اللہِ أَحَبُّ إلَیَّ مِنْ أَنْ أَمُوتَ عَلَی فِرَاشِی ، وَلَوْ قُلْتُ : إنَّہَا شَہَادَۃٌ ، لَرَأَیْت أَنَّہَا شَہَادَۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 22626","","","كتاب البيوع والأقضية"
"22627","(۲۲۶۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُوسَی بْنُ عُلَیٍّ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ عَمْرَو بْنَ الْعَاصِ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَا عَمْرُو ، اُشْدُدْ عَلَیْک سِلاَحَک وَثِیَابَک وَائْتِنِی ، قَالَ : فَشَدَدْت عَلَیَّ سِلاَحِی وَثِیَابِی ، ثُمَّ أَتَیْتہ فَوَجَدْتہ یَتَوَضَّأُ ، فَصَعَّدَ فِیَّ الْبَصَرَ وَصَوَّبَہُ فَقَالَ : یَا عَمْرُو ، إنِّی أُرِیدُ أَنْ أَبْعَثَک وَجْہًا یُسَلِّمَک اللَّہُ وَیُغَنِّمُکَ ، وَأزْعَبْ لَکَ مِنَ الْمَالِ زَعْبَۃً صَالِحَۃً ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، إنِّی لَمْ أُسْلِمْ رَغْبَۃً فِی الْمَالِ ، إنَّمَا أَسْلَمْت رَغْبَۃً فِی الْجِہَادِ وَالْکَیْنُونَۃِ مَعَک ، قَالَ : یَا عَمْرُو ، نَعِمَّا بِالْمَالِ الصَّالِحِ لِلرَّجُلِ الصَّالِحِ۔ (بخاری ۲۹۹۔ احمد ۴/۲۰۲)","Sahih","Musannaf Ibn Abi Shaybah 22627","","","كتاب البيوع والأقضية"
"22628","(۲۲۶۲۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ مِہْزَمٍ ، عَنْ مُحَمَّدِ بْنِ وَاسِعٍ الأَزْدِیِّ ، قَالَ : لاَ یَطِیبُ ہَذَا الْمَالُ إلاَّ مِنْ أَرْبَعِ خِلاَلٍ : سَہْم فَیء الْمُسْلِمِینَ ، أَوْ تِجَارَۃٌ مِنْ حَلاَلٍ ، أَوْ عَطَائٌ مِنْ أَخٍ مُسْلِمٍ عَنْ ظَہْرِ یَدٍ ، أَوْ مِیرَاثٌ فِی کِتَابِ اللہِ۔","","Musannaf Ibn Abi Shaybah 22628","","","كتاب البيوع والأقضية"
"22629","(۲۲۶۲۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَدِمَتْ عِیرٌ إلَی الْمَدِینَۃِ ، فَاشْتَرَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْہَا فَرَبِحَ أَوَاقِیَ ، فَقَسَمَہَا فِی أَرَامِلِ بَنِی عَبْدِ الْمُطَّلِبِ ، وَقَالَ : لاَ أَشْتَرِی شَیْئًا لَیْسَ عِنْدِی ثَمَنُہُ۔ (ابوداؤد ۳۳۳۷۔ احمد ۱/۲۳۵)","","Musannaf Ibn Abi Shaybah 22629","","","كتاب البيوع والأقضية"
"22630","(۲۲۶۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ أَیُّوبَ ، قَالَ : کَانَ أَبُو قلاَبَۃَ یَحُثُّنِی عَلَی الاحْتِرافِ وَالطَّلَبِ ، وَقَالَ أَبُو قِلاَبَۃَ : الْغِنَی مِنَ الْعَافِیَۃِ۔","","Musannaf Ibn Abi Shaybah 22630","","","كتاب البيوع والأقضية"
"22631","(۲۲۶۳۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ : { أَنْفِقُوا مِنْ طَیِّبَاتِ مَا کَسَبْتُمْ} ، قَالَ : التِّجَارَۃُ۔","","Musannaf Ibn Abi Shaybah 22631","","","كتاب البيوع والأقضية"
"22632","(۲۲۶۳۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الْعَلاَئِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ رِوَایَۃً ، قَالَ : إنَّ الْیَمِینَ الْفَاجِرَۃَ مَنْفَقَۃٌ لِلسِّلْعَۃِ مَمْحَقَۃٌ لِلْکَسْبِ۔ (بخاری ۲۰۸۷۔ مسلم ۱۳۱)","Hasan","Musannaf Ibn Abi Shaybah 22632","","","كتاب البيوع والأقضية"
"22633","(۲۲۶۳۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ مَعْبَدِ بْنِ کَعْبِ بْنِ مَالِکٍ ، عَنْ أَبِی قَتَادَۃَ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إیَّاکُمْ وَکَثْرَۃَ الْحَلِفِ فَإِنَّہُ یُنْفِقُ ، ثُمَّ یَمْحَقُ۔n(احمد ۵/۲۹۷۔ ابن ماجہ ۲۲۰۹)","Hasan","Musannaf Ibn Abi Shaybah 22633","","","كتاب البيوع والأقضية"
"22634","(۲۲۶۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْوَلِیدِ بْنِ کَثِیرٍ ، عَنْ مَعْبَدِ بْنِ کَعْبِ بْنِ مَالِکٍ ، عَنْ أَبِی قَتَادَۃَ أَنَّہُ سَمِعَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إیَّاکُمْ وَکَثْرَۃَ الْحَلِفِ فِی الْبَیْعِ فَإِنَّہُ یُنْفِقُ ، ثُمَّ یَمْحَقُ۔","Sahih","Musannaf Ibn Abi Shaybah 22634","","","كتاب البيوع والأقضية"
"22635","(۲۲۶۳۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ طَلْحَۃَ ، عَنْ مُحَمَّدِ بْنِ جُحَادَۃَ ، عَنْ زَاذَانَ ، قَالَ : کَانَ عَلِیٌّ یَأْتِی السُّوقَ فَیُسَلِّمُ ، ثُمَّ یَقُولُ : یَا مَعْشَرَ التُّجَّارِ ، إیَّاکُمْ وَکَثْرَۃَ الْحَلِفِ فِی الْبَیْعِ فَإِنَّہُ یُنْفِقُ السِّلْعَۃَ وَیَمْحَقُ الْبَرَکَۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 22635","","","كتاب البيوع والأقضية"
"22636","(۲۲۶۳۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ سَلَمَۃَ بْنِ زِیَادِ بْنِ أخی سَالِم بْنِ أَبِی الْجَعْدِ ، عَنْ سَالِمٍ ، قَالَ : قَالَ ابْنُ مَسْعُودٍ : الأَیْمَانُ لِقَاح الْبُیُوعَ وَتَمْحَقُ الْکَسْبَ۔","","Musannaf Ibn Abi Shaybah 22636","","","كتاب البيوع والأقضية"
"22637","(۲۲۶۳۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ شَقِیقٍ ، عَنْ قَیْسِ بْنِ أَبِی غَرْزَۃَ ، قَالَ : کُنَّا نَبْتَاعُ الأوسَاق بِالْمَدِینَۃِ وَکُنَّا نُسَمِّی أَنْفُسَنَا السَّمَاسِرَۃَ ، فَأَتَیْنَا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَمَّانَا بِاسْمٍ ہُوَ أَحْسَنُ مِمَّا کُنَّا نُسَمِّی بِہِ أَنْفُسَنَا ، فَقَالَ : یَا مَعْشَرَ التُّجَّارِ ، إنَّ ہَذَا الْبَیْعَ یَحْضُرُہُ اللَّغْوُ وَالْحَلِفُ فَشُوبُوہُ بِالصَّدَقَۃِ۔n(ترمذی ۱۲۰۸۔ ابوداؤد ۳۳۱۹)","Sahih","Musannaf Ibn Abi Shaybah 22637","","","كتاب البيوع والأقضية"
"22638","(۲۲۶۳۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ بَکْرٍ السَّہْمِیُّ ، قَالَ : حدَّثَنَا حَاتِمُ بْنُ أَبِی صَغِیرَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوٍ مِنْ حَدِیثِ قَیْسِ بْنِ أَبِی غَرَزَۃَ۔ (بیہقی ۴۸۴۸)","Sahih","Musannaf Ibn Abi Shaybah 22638","","","كتاب البيوع والأقضية"
"22639","(۲۲۶۳۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ بَشَّارِ بْنِ کِدَامٍ السُّلَمِیِّ ، عَنْ مُحَمَّدِ بْنِ زَیْدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْحَلِفُ حِنْثٌ ، أَوْ نَدَمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 22639","","","كتاب البيوع والأقضية"
"22640","(۲۲۶۴۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَلِیِّ بْنِ مُدْرِکٍ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ خَرَشَۃَ بْنِ الْحُرِّ ، عَنْ أَبِی ذَرٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : ثَلاَثًا لاَ یُکَلِّمُہُمُ اللَّہُ یَوْمَ الْقِیَامَۃِ ، وَلاَ یُزَکِّیہِمْ وَلَہُمْ عَذَابٌ أَلِیمٌ : الْمَنَّانُ وَالْمُسْبِلُ ، وَالْمُنْفِقُ سِلْعَتَہُ بِالْحَلِفِ الْکَاذِبِ۔ (مسلم ۱۷۱۔ ابوداؤد ۴۰۸۴)","Sahih","Musannaf Ibn Abi Shaybah 22640","","","كتاب البيوع والأقضية"
"22641","(۲۲۶۴۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مُجَمِّعٍ الأَنْصَارِیِّ ، قَالَ : سَمِعْتُ خَالِدَ بْنَ سَعْدٍ مَوْلَی أَبِی مَسْعُودٍ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یَقُولُ : الْکَذِبُ مِلْحُ الْبَیْعِ : یُنْفِقُ السِّلْعَۃَ وَیَمْحَقُ الْکَسْبَ۔","Sahih","Musannaf Ibn Abi Shaybah 22641","","","كتاب البيوع والأقضية"
"22642","(۲۲۶۴۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ثَوْرٌ ، عَنْ یُونُسَ بْنِ سَیْفٍ ، عَنْ حِرَامِ بْنِ حَکِیمٍ ، قَالَ : کَتَبَ عُمَرُ بْنُ الْخَطَّابِ إلَی عُمَیْرِ بْنِ سَعْدٍ : أَمَّا بَعْدُ : فَانْہَ مَنْ قِبَلَک مِنَ الْمُسْلِمِینَ أَنْ یُکَاتِبُوا أَرِقَّائَہُمْ عَلَی مَسْأَلَۃِ النَّاسِ۔","","Musannaf Ibn Abi Shaybah 22642","","","كتاب البيوع والأقضية"
"22643","(۲۲۶۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : أَنَّہُ کَرِہَ أَنْ یُکَاتِبَ الرَّجُلُ عَبْدَہُ إذَا لَمْ یَکُنْ لَہُ حِرْفَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 22643","","","كتاب البيوع والأقضية"
"22644","(۲۲۶۴۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ بُرْقَانَ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، قَالَ : کَاتَبَ ابْنُ عُمَرَ غُلاَمًا لَہُ ، فَجَائَہ بِنَجْمِہِ حِینَ حَلَّ ، فَقَالَ : مِنْ أَیْنَ لَکَ ہَذَا ؟ قَالَ : کُنْتُ أَسْأَلُ وَأَعْمَلُ ، قَالَ : تُرِیدُ أَنْ تُطْعِمَنِی أَوْسَاخَ النَّاسِ ؟ أَنْتَ حُرٌّ وَلَک نَجْمُک ہَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 22644","","","كتاب البيوع والأقضية"
"22645","(۲۲۶۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی جَعْفَرٍ الْفَرَّائِ ، عَنْ أَبِی لَیْلَی الْکِنْدِیِّ ، أَنَّ سَلْمَانَ أَرَادَ أَنْ یُکَاتِبَ غُلاَمًا لَہُ فَقَالَ: مِنْ أَیْنَ؟ قَالَ: أَسْأَلُ النَّاسَ، قَالَ: تُرِیدُ أَنْ تُطْعِمَنِی أَوْسَاخَ النَّاسِ ؟ فَأَبَی أَنْ یُکَاتِبَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 22645","","","كتاب البيوع والأقضية"
"22646","(۲۲۶۴۶) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ جَابِرٍ، عَنْ عَامِرٍ، قَالَ: إِنْ شَائَ کَاتَبَ عَبْدَہُ، وَإِنْ شَائَ لَمْ یُکَاتِبْہُ۔","","Musannaf Ibn Abi Shaybah 22646","","","كتاب البيوع والأقضية"
"22647","(۲۲۶۴۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنِی حُمَیْدٌ ، عَمنْ حَدَّثہ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّہُ کَاتَبَ عَبْدًا لَہُ وَاشْتَرَطَ عَلَیْہِ أَلاَّ یَسْتَکِدَّ النَّاسَ۔","Da'if","Musannaf Ibn Abi Shaybah 22647","","","كتاب البيوع والأقضية"
"22648","(۲۲۶۴۸) حَدَّثَنَا شَرِیکٌ، عَنْ سِمَاکٍ، عَنِ الْحَسَنِ، قَالَ: إذَا فَرَضْت عَدَدًا فَخُذْ عَدَدًا، وَإِذَا فَرَضْت وَزْنًا فَخُذْ وَزْنًا۔","","Musannaf Ibn Abi Shaybah 22648","","","كتاب البيوع والأقضية"
"22649","(۲۲۶۴۹) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ : أَنَّہُ کَانَ یَکْرَہُ أَنْ یُسَلِّفَ عَدَدًا وَیَأْخُذَ وَزْنًا۔","","Musannaf Ibn Abi Shaybah 22649","","","كتاب البيوع والأقضية"
"22650","(۲۲۶۵۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ باذام ، قَالَ : رَأَیْتُ إیَاسَ بْنَ مُعَاوِیَۃَ وَلِی سَکْرَ بَثْق ، فَکَانَ یَسْتَقْرِضُ الْقَصَبَ وَزْنًا وَیَرُدُّہُ وَزْنًا۔ (بخاری ۱۹۸۹)","","Musannaf Ibn Abi Shaybah 22650","","","كتاب البيوع والأقضية"
"22651","(۲۲۶۵۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ ، أَنَّہُمَا قَالاَ فِی رَجُلٍ اقْتَرَضَ مِنْ رَجُلٍ دَرَاہِمَ عَدَدًا بِأَرْضٍ فَجَازَتْ بِوَزْنِہَا أَیَقْضِیہِ وَزْنًا فَکَرِہَا ذَلِکَ وَقَالا : لاَ یَقْضِیہِ إلاَّ مِثْلَ دَرَاہِمِہِ۔","","Musannaf Ibn Abi Shaybah 22651","","","كتاب البيوع والأقضية"
"22652","(۲۲۶۵۲) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ حُکَیمِ بْنِ رُزَیْقٍ ، عَنْ أَبِیہِ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : فِی رَجُلٍ کَانَ لَہُ عَلَی رَجُلٍ أَلْفُ لَبِنَۃٍ مِنْ لَبِنِ کِبَارٍ ، وَالْکِبَارُ تُبَاعُ مِئَتَیْنِ بِدِرْہم ، وَالصِّغَارُ خَمْسِینَ وَمِئَتَیْنِ ، قَالَ : نَقَصَہُ مِنْ حَقِّہِ ، فَہُوَ یُحَلِّلُہُ إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 22652","","","كتاب البيوع والأقضية"
"22653","(۲۲۶۵۳) حَدَّثَنَا رُوحُ بْنُ عُبَادَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : الْوَزْنُ بِالْوَزْنِ وَالْعَدَدُ بِالْعَدَدِ۔","","Musannaf Ibn Abi Shaybah 22653","","","كتاب البيوع والأقضية"
"22654","(۲۲۶۵۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ وَالْحَسَنِ : أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا بِقَضَائِ الدَّرَاہِمِ الْبِیضِ مِنَ الدَّرَاہِمِ السُّودِ مَا لَمْ یَکُنْ شَرْطًا۔","","Musannaf Ibn Abi Shaybah 22654","","","كتاب البيوع والأقضية"
"22655","(۲۲۶۵۵) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ أَبِی سَعِیدٍ ، عَنْ إبْرَاہِیمَ : أَنَّہُ لَمْ یَکُنْ یَرَی بِذَلِکَ بَأْسًا مَا لَمْ یَکُنْ شَرْطًا، أَوْ نِیَّۃً۔","","Musannaf Ibn Abi Shaybah 22655","","","كتاب البيوع والأقضية"
"22656","(۲۲۶۵۶) حَدَّثَنَا جَرِیرٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ : فِی الرَّجُلِ یَشْتَرِی الْجَارِیَۃَ فَتَأْبِقُ مِنْہُ ، فَإِنْ دَلَّسْت لَہُ أَوْ غَدَرْت رُدَّ عَلَیْہِ الثَّمَنَ وَاطْلُبْ جَارِیَتَکَ ، قَالَ : وَکَانَ شُرَیْحٌ یَقُولُ : رُدَّہَا بِذَاتِہَا۔","","Musannaf Ibn Abi Shaybah 22656","","","كتاب البيوع والأقضية"
"22657","(۲۲۶۵۷) حَدَّثَنَا مُعْتَمِر بن سُلَیْمَانَ ، عَنْ سَلَمِ بْنِ أَبِی الذَّیالِ ، قَالَ : سَأَلْتُ مُحَمَّدًا عَنْ رَجُلٍ بَاعَ سِلْعَۃً إلَی شَہْرَیْنِ شَرَطَ عَلَی الْمُشْتَرِی إِنْ بَاعَہَا قَبْلَ الشَّہْرَیْنِ أَنْ یَنْقُدَہُ ؟ قَالَ : لاَ أَعْلَمُ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 22657","","","كتاب البيوع والأقضية"
"22658","(۲۲۶۵۸) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ عَبْدِالْعَزِیزِ بْنِ رُفَیْعٍ، قَالَ: بِعْت مِنْ رَجُلٍ جَارِیَۃً وَشَرَطْت عَلَیْہِ: إِنْ تَبِعتْہَا نَفْسِی، قَالَ: فَتَبِعَتہَا نَفْسِی، فَخَاصَمْتہ إلَی شُرَیْحٍ فَقَالَ: قَدْ أَقْرَرْت بِالْبَیْعِ فَبَیِّنَتُک عَلَی الشَّرْطِ۔","","Musannaf Ibn Abi Shaybah 22658","","","كتاب البيوع والأقضية"
"22659","(۲۲۶۵۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِالْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ شریح : أَنَّہُ أَجَازَ الشَّرْطَ لِبِضْعَۃِ عَشَرَ یَوْمًا۔","","Musannaf Ibn Abi Shaybah 22659","","","كتاب البيوع والأقضية"
"22660","(۲۲۶۶۰) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ طَاوُوسٍ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَقُولَ الْمُکَاتَبُ لِمَوْلاَہُ : حطَّ عَنِّی وَأُعَجِّلُ لَک۔","","Musannaf Ibn Abi Shaybah 22660","","","كتاب البيوع والأقضية"
"22661","(۲۲۶۶۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ طَاوُوسٍ ، قَالَ : لاَ بَأْسَ أَنْ یَقُولَ لِمُکَاتَبِہِ : عَجِّلْ لِی وَأَضَعُ عَنْک۔","","Musannaf Ibn Abi Shaybah 22661","","","كتاب البيوع والأقضية"
"22662","(۲۲۶۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ : فِی رَجُلٍ قَالَ لِمُکَاتَبِہِ : أَضَعُ عَنْک وَعَجِّلْ لِی ، فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 22662","","","كتاب البيوع والأقضية"
"22663","(۲۲۶۶۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ : أَنَّہُ قَالَ فِی الرَّجُلِ کَانَ یُکَاتِبُ غُلاَمَہُ عَلَی دِرْہَمٍ إلَی أَجَلٍ مُسَمًّی ، فَیَقُولُ لَہُ قَبْلَ مَحِلِّ الأَجَلِ : عَجِّلْ لِی وَأَضَعُ عَنْک لَمْ یَرَ بَأْسًا ، قَالَ : وَلَمْ أَرَ أَحَدًا کَرِہَہُ إلاَّ ابْنُ عُمَرَ فَإِنَّہُ کَانَ یَکْرَہُ ذَلِکَ إلاَّ بِعَرْضٍ۔","","Musannaf Ibn Abi Shaybah 22663","","","كتاب البيوع والأقضية"
"22664","(۲۲۶۶۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ وَابْنِ سِیرِینَ : أنہمَا کَرِہَا فِی الْمُکَاتِبِ أَنْ یَقُولَ : عَجِّلْ لِی وَأَضَعُ عَنْک۔","","Musannaf Ibn Abi Shaybah 22664","","","كتاب البيوع والأقضية"
"22665","(۲۲۶۶۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ : فِی الرَّجُلِ یَقُولُ لِمُکَاتَبِہِ : عَجِّلْ لِی وَأَضَعُ عَنْک ، قَالَ : لاَ بَأْسَ بِہِ۔n قَالَ وَکِیعٌ : وَکَانَ سُفْیَانُ یَکْرَہُہُ فِی الْمُکَاتَبِ وَالدَّیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 22665","","","كتاب البيوع والأقضية"
"22666","(۲۲۶۶۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَاصِمِ بْنِ سُلَیْمَانَ ، عَنْ بَکْرٍ الْمُزَنِیِّ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ بَأْسَ أَنْ یَأْخُذَ الرَّجُلُ مِنْ مُکَاتَبِہِ عُرُوضًا۔","Sahih","Musannaf Ibn Abi Shaybah 22666","","","كتاب البيوع والأقضية"
"22667","(۲۲۶۶۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الرَّبِیعُ ، قَالَ : کَتَبَ إلَیْنَا عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : لِیَأْخُذَ الرَّجُلُ مِنْ مُکَاتَبِہِ عُرُوضًا۔","","Musannaf Ibn Abi Shaybah 22667","","","كتاب البيوع والأقضية"
"22668","(۲۲۶۶۸) حَدَّثَنَا حَفْصٌ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : أَنَّہُ کَانَ یَکْرَہُ أَنْ یُقَاطِعَ مُکَاتَبَہُ عَلَی ذَہَبٍ ، أَوْ فِضَّۃٍ ، وَقَالَ : لاَ إلاَّ بِعَرْضٍ۔","Sahih","Musannaf Ibn Abi Shaybah 22668","","","كتاب البيوع والأقضية"
"22669","(۲۲۶۶۹) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ التَّیْمِیِّ ، عَنِ الْحَسَنِ بْنِ مُسْلِمٍ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ إلَی أَہْلِ الْمَدِینَۃِ وَإِلَی أَہْلِ مَکَّۃَ ، أَوْ إحْدَاہُمَا یَنْہَاہُمْ عَنْ مُقَاطَعَۃِ الْمُکَاتَبِینَ ، قَالَ : وہَذَا لاَ نَرَی بِہِ بَأْسًا ، یعنی : طَاوُوسًا۔","","Musannaf Ibn Abi Shaybah 22669","","","كتاب البيوع والأقضية"
"22670","(۲۲۶۷۰) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَابِسٍ ، عَنْ سُلَیْمِ بْنِ أُذْنَانِ ، عَنْ عَلْقَمَۃَ سَمِعْتہُ یَقُولُ : لأنْ أُقْرِضَ رَجُلاً مَرَّتَیْنِ أَحَبُّ إلَیَّ مِنْ أَنْ أُعْطِیَہُ مَرَّۃً۔ (ابن ماجہ ۲۴۳۰)","","Musannaf Ibn Abi Shaybah 22670","","","كتاب البيوع والأقضية"
"22671","(۲۲۶۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ طَلْحَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْسَجَۃَ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ مَنَحَ مَنِیحَۃَ وَرِقٍ ، أَوْ مَنِیحَۃَ لَبَنٍ ، أَوْ ہَدَی زُقَاقًا کَانَ لَہُ کَعِتْقِ رَقَبَۃٍ۔ (ترمذی ۱۹۵۷۔ احمد ۴/۳۰۰)","Sahih","Musannaf Ibn Abi Shaybah 22671","","","كتاب البيوع والأقضية"
"22672","(۲۲۶۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا دَلْہَمُ بْنُ صَالِحٍ الْکِنْدِیُّ ، عَنْ حُمَیْدِ بْنِ عَبْدِ اللہِ الْکِنْدِیِّ ، عَنْ عَلْقَمَۃَ بْنِ قَیْسٍ ، قَالَ : قَالَ عَبْدُ اللہِ : لأَنْ أُقْرِضَ مَالاً مَرَّتَیْنِ أَحَبُّ إلَیَّ مِنْ أَنْ أَتَصَدَّقَ بِہِ مَرَّۃً۔","Da'if","Musannaf Ibn Abi Shaybah 22672","","","كتاب البيوع والأقضية"
"22673","(۲۲۶۷۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ قَبِیصَۃَ بْنِ حُصَیْنٍ ، أَوْ حُصَیْنِ بْنِ قَبِیصَۃَ ، عَنِ ابْنِ مَسْعُودٍ ، أَنَّہُ قَالَ : مَنْ مَنَحَ وَرِقًا ، أَوْ لَبَنًا ، أَو ہَدَی زُقَاقًا أَوْ طَرِیقًا فَعَدْلُ رَقَبَۃٍ۔","Hasan","Musannaf Ibn Abi Shaybah 22673","","","كتاب البيوع والأقضية"
"22674","(۲۲۶۷۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : قَرْضُ مَرَّتَیْنِ کَإِعْطَائِ مَرَّۃٍ۔","","Musannaf Ibn Abi Shaybah 22674","","","كتاب البيوع والأقضية"
"22675","(۲۲۶۷۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَنْظَلَۃُ ، عَنْ طَاوُوسٍ ، قَالَ : مَنْ مَنَحَ مَنِیحَۃَ لَبَنٍ کَانَ لَہُ بِکُلِّ حَلْبَۃٍ عَشْرُ حَسَنَاتٍ غَزَرَتْ ، أَوْ بَکَأَتْ۔","","Musannaf Ibn Abi Shaybah 22675","","","كتاب البيوع والأقضية"
"22676","(۲۲۶۷۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : مَنْ مَنَحَ لَبَنًا ، أَوْ أَرْضًا کَانَ لَہُ أَجْرٌ۔","","Musannaf Ibn Abi Shaybah 22676","","","كتاب البيوع والأقضية"
"22677","(۲۲۶۷۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ شَرِیکٍ ، قَالَ : حَدَّثَنَا عَطَائٌ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : نِعْمَ الإِبِلُ الثَّلاَثُونَ تَحْمِلُ عَلَی نَجِیبِہَا وَتَعِیرُ أَدَاتَہَا وَتَمْنَحُ غَزِیرَتَہَا وَتَحْلُبُہَا یَوْمَ وِرْدِہَا فِی أَعْطَانِہَا۔ (عبدالرزاق ۶۸۶۰۔ احمد ۲/۴۴۶)","Sahih","Musannaf Ibn Abi Shaybah 22677","","","كتاب البيوع والأقضية"
"22678","(۲۲۶۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِکْرِمَۃُ بْنُ عَمَّارٍ ، عَنْ عَلْقَمَۃَ بْنِ الزِّبْرِقَانِ ، قَالَ : قُلْتُ لأَبِی ہُرَیْرَۃَ : مَا حَقُّ الإِبِلِ ؟ قَالَ : أَنْ تُمْنَحَ الْغَزِیرَۃَ ، وَأَنْ تُعْطَی الْکَرِیمَۃَ ، ویُطْرِقَ الْفَحْلَ۔","Da'if","Musannaf Ibn Abi Shaybah 22678","","","كتاب البيوع والأقضية"
"22679","(۲۲۶۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ سِیَاہٍ ، عَنْ حَبِیبِ بْنِ أَبِی عَمْرَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لأَنْ أُقْرِضَ مِئَتی دِرْہَمٍ مَرَّتَیْنِ ، أَحَبُّ إلَیَّ مِنْ أَنْ أَتَصَدَّقَ بِہَا مَرَّۃً۔","Sahih","Musannaf Ibn Abi Shaybah 22679","","","كتاب البيوع والأقضية"
"22680","(۲۲۶۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ثَلاَثٌ سُنَّۃٌ عَلَیَّ أَجْرُہُنَّ ، یَعْنِی مِنْ عِظْمہ : الْمَنِیحَۃِ ، وَالأُضْحِیَّۃِ ، وَالرَّجُلُ یَحُجُّ عَنِ الرَّجُلِ لَمْ یَحُجَّ قَطُّ۔","","Musannaf Ibn Abi Shaybah 22680","","","كتاب البيوع والأقضية"
"22681","(۲۲۶۸۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ ، عَنْ شُرَیْحٍ ، قَالَ : مَا أَقْرَضَ رَجُلٌ رَجُلاً قَرْضًا مَنِیحَۃً ، وَلاَ مَالاً إلاَّ کَانَ الْمُقْرِضُ أَفْضَلَہُمَا ، وَإِنْ قَضَی فَأَحْسَنُ۔","","Musannaf Ibn Abi Shaybah 22681","","","كتاب البيوع والأقضية"
"22682","(۲۲۶۸۲) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ، عَنْ مَنْصُورٍ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ، قَالَ: قَالَ أَبُو الدَّرْدَائِ: لأَنْ أُقْرِضَ رَجُلاً دِینَارَیْنِ أَحَبُّ إلَیَّ مِنْ أَنْ أَتَصَدَّقَ بِہِمَا ، إنِّی إذَا أَقْرَضْتہمَا ورُدَّا عَلَیَّ فَأَتَصَدَّقُ بِہِمَا فَیَکُونُ لِی أَجْرَانِ۔","","Musannaf Ibn Abi Shaybah 22682","","","كتاب البيوع والأقضية"
"22683","(۲۲۶۸۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَامَ الْفَتْحِ یَقُولُ : إنَّ اللَّہَ وَرَسُولَہُ حَرَّمَ بَیْعَ الْخَمْرِ وَالْخَنَازِیرِ وَالأَصْنَامِ وَالْمَیْتَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 22683","","","كتاب البيوع والأقضية"
"22684","(۲۲۶۸۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ شَقِیقٍ ، عَنْ مَسْرُوقٍ ، قَالَ : مُرَّ عَلَیْہِ وَہُوَ بِالسِّلْسِلَۃِ بِتَمَاثِیلَ مِنْ صُفْرٍ تُبَاعُ ، فَقَالَ مَسْرُوقٌ : لَوْ أَعْلَمُ أَنَّہُ یَنْفُقُ لَضَرَبتہَا ، وَلَکِنِّی أَخَافُ أَنْ یُعَذِّبَنِی فیفتنی ، وَاللَّہِ مَا أَدْرِی أَیَّ الرَّجُلَیْنِ؟ رَجُلٌ قَدْ زُیِّنَ لَہُ سُوئُ عَمَلِہِ، أَوْ رَجُلٌ قَدْ أَیِسَ مِنْ آخِرَتِہِ فَہُو یَتَمَتَّعُ مِنَ الدُّنْیَا۔","","Musannaf Ibn Abi Shaybah 22684","","","كتاب البيوع والأقضية"
"22685","(۲۲۶۸۵) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُجَاہِدٍ : أَنَّ رَجُلاً وَرِثَ أَصْنَامًا مِنْ فِضَّۃٍ وَخَنَازِیرَ وَخَمْرًا ، فَسَأَلَ عنہا رَہْطًا مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَکُلُّہُمْ أَمَرَہُ أَنْ یَکْسِرَ الأَصْنَامَ فَیَجْعَلَہَا فِضَّۃً وَکُلُّہُمْ نَہَاہُ عَنِ الْخَمْرِ وَالْخَنَازِیرِ۔","Da'if","Musannaf Ibn Abi Shaybah 22685","","","كتاب البيوع والأقضية"
"22686","(۲۲۶۸۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بَلْجِ الْفَزَارِیِّ ، عَنْ عَبَایَۃَ بْنِ رِفَاعَۃَ بْنِ رَافِعٍ الأَنْصَارِیِّ : أَنَّ جَدَّہُ تُوُفِّیَ وَتَرَکَ أَمَۃً تُغِلُّ، فَذَکَرَ ذَلِکَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَکَرِہَ کَسْبَ الأَمَۃِ ، وَقَالَ: لَعَلَّہَا لاَ تَجِدُ فَتَبْغِی بِنَفْسِہَا۔n(ابوداؤد ۳۴۱۹۔ طبرانی ۴۴۰۸)","","Musannaf Ibn Abi Shaybah 22686","","","كتاب البيوع والأقضية"
"22687","(۲۲۶۸۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ مُحَمَّدِ بْنِ جُحَادَۃَ ، عَنْ أَبِی حَازِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : نَہَی النَّبِیّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ کَسْبِ الأَمَۃِ۔ (بخاری ۲۲۸۳۔ ابوداؤد ۳۴۱۸)","Sahih","Musannaf Ibn Abi Shaybah 22687","","","كتاب البيوع والأقضية"
"22688","(۲۲۶۸۸) حَدَّثَنَا وکیع ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ أَبِی النَّضْرِ ، عَنْ أَبِی أَنَسٍ ، قَالَ : سَمِعْتُ عُثْمَانَ یَقُولُ : لاَ تُکَلِّفُوا الصَّغِیرَ الْکَسْبَ فَیَسْرِقَ ، وَلاَ تُکَلِّفوا الْجَارِیَۃَ غَیْرَ ذَاتِ الصُّنْعِ فَتَکْسِبَ بِفَرْجِہَا وَأعِفُّوا إذْ أَعَفَّکُمُ اللَّہُ ، وَعَلَیْکُمْ مِنَ الْمَکَاسِبِ بمَا طَابَ لَکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 22688","","","كتاب البيوع والأقضية"
"22689","(۲۲۶۸۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَرَامِ بْنِ عُثْمَانَ ، عَنْ أَبِی عَتِیقٍ ، عَنْ جَابِرٍ ، قَالَ : نَہَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ خَرَاجِ الأَمَۃِ إلاَّ أَنْ تَکُونَ فِی عَمَلٍ وَاصِبٍ۔ (طبرانی ۸۰۴۸)","Da'if","Musannaf Ibn Abi Shaybah 22689","","","كتاب البيوع والأقضية"
"22690","(۲۲۶۹۰) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْوَاحِدِ ، عَنِ الْحَکَمِ : فِی الدِّینَارِ الشَّامِیِّ بِالدِّینَارِ الْکُوفِیِّ وَفَضْلِ الشَّامِیِّ فِضَّۃً ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 22690","","","كتاب البيوع والأقضية"
"22691","(۲۲۶۹۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 22691","","","كتاب البيوع والأقضية"
"22692","(۲۲۶۹۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ عَنِ الدِّینَارِ الشَّامِیِّ بِالدِّینَارِ الْکُوفِیِّ وَفَضْلُہُ فِضَّۃً ؟ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 22692","","","كتاب البيوع والأقضية"
"22693","(۲۲۶۹۳) حدَّثَنَا سُفْیَانُ ، عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ ابْنِ سِیرِینَ : أَنَّہُ سُئِلَ عَنْ مِئَۃ مِثْقَالٍ بِمِئَۃِ دِینَارٍ وَعَشَرَۃِ دَرَاہِمَ ؟ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 22693","","","كتاب البيوع والأقضية"
"22694","(۲۲۶۹۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُکْرَہُ دِینَارٌ شَامِیٌّ بِدِینَارٍ کُوفِیٍّ وَدِرْہَمٍ ، وَلاَ بَأْسَ إذَا کَانَ لَکَ عَلَی رَجُلٍ دِینَارٌ کُوفِیٌّ فَیُعْطِیْکَ دِینَارًا شَامِیًّا وَیَشْتَرِی الْفَضْلَ مِنْہُ بِشَیْئٍ ، وَلاَ یَفْتَرِقَا إلاَّ وَقَدْ تَصَرَّمَ مَا بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 22694","","","كتاب البيوع والأقضية"
"22695","(۲۲۶۹۵) حَدَّثَنَا یَزِیدُ ، عَنْ مُوسَی بْنِ مُسْلِمٍ ، قَالَ : سَأَلْتُ طَاوُوسًا قُلْتُ : دِینَارٌ ثَقِیلٌ بِدِینَارٍ أَخَفَّ مِنْہُ وَدِرْہَمٌ؟ قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 22695","","","كتاب البيوع والأقضية"
"22696","حَدَّثَنَا أَبُو مُحَمَّدٍ عَبْدُ اللہِ بْنُ یُونُسَ ، قَالَ : حدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ بَقِیُّ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا أبُو بَکْر ، قَالَ:n (۲۲۶۹۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ : فِی الرَّجُلِ یَصْرِفُ عِنْدَ الرَّجُلِ الدّنَانِیرَ فَیَفْضُلُ الْقِیرَاطُ ذَہَبٌ ، قَالَ : لاَ بَأْسَ أَنْ یَأْخُذَ بِہِ کَذَا کَذَا دِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 22696","","","كتاب البيوع والأقضية"
"22697","(۲۲۶۹۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ الْحَسَنِ : فِی الرَّجُلِ یَشْتَرِی من الرجل الذَّہَبَ بِالدَّرَاہِمِ ، فَیَزِنُ الدّنَانِیرَ فَیَزِیدُ ، فَیَأْخُذُ بِفَضْلِہَا فضۃ ، قَالَ : لاَ بَأْسَ بہ ، وَکَرِہَ ذَلِکَ ابْنُ سِیرِینَ وَقَالَ : خُذْ بِہِ أجْمعَ ذَہَبًا۔","","Musannaf Ibn Abi Shaybah 22697","","","كتاب البيوع والأقضية"
"22698","(۲۲۶۹۸) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ شعبۃ ، عن الحکم ، عَنْ إبْرَاہِیمَ : أنہ کرہ أن یأخذ بنصف الدنانیر ذہبًا ، وَبِنِصْفِہَا فِضَّۃً۔","","Musannaf Ibn Abi Shaybah 22698","","","كتاب البيوع والأقضية"
"22699","(۲۲۶۹۹) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ یَزِیدَ ، قَالَ : کَانَ ابْنُ سِیرِینَ یَکْرَہُ الْوَازِنَۃَ۔","","Musannaf Ibn Abi Shaybah 22699","","","كتاب البيوع والأقضية"
"22700","(۲۲۷۰۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَانَ یَکْرَہُ أَنْ یَبِیعَ الرَّجُلُ الدِّینَارَ فَیَأْخُذَ بَعْضَہُ ذَہَبًا وَبَعْضَہُ فِضَّۃً ، قَالَ : وَکَانَ الْحَکَمُ لاَ یَرَی بِذَلِکَ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 22700","","","كتاب البيوع والأقضية"
"22701","(۲۲۷۰۱) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ مُحَمَّدًا ، قُلْتُ : أَشْتَرِی الدَّنَانِیرَ الْیَسِیرَۃَ وَأَقُولُ ، أَنْتَ بَرِیئٌ مِنْ وَزْنِہَا ؟ قَالَ : لاَ أَعْلَمُ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 22701","","","كتاب البيوع والأقضية"
"22702","(۲۲۷۰۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ مُوسَی بْنِ طَرِیفٍ ، قَالَ : دَخَلَ عَلِیٌّ بَیْتَ الْمَالِ فَاضْرَطَ بِہِ ، وَقَالَ : واللہِ لاَ أُمْسِی وَفِیک دِرْہَمٌ ، فَدَعَا رَجُلاً مِنْ بَنِی أَسَدٍ فَقَالَ : اقْسِمْہُ ، فَقَسَّمَہُ حَتَّی أَمْسَی ، فَقَالَ النَّاسُ : لَوْ عَوَّضْتہ ، قَالَ : إِنْ شَائَ ، وَلَکِنَّہُ سُحْتٌ ، فَقَالَ : لاَ حَاجَۃَ لَنَا فِی سُحْتِکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 22702","","","كتاب البيوع والأقضية"
"22703","(۲۲۷۰۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : کُلُّ حِسَابٍ یَحْسِبُہُ فَیَأْخُذُ عَلَیْہِ أَجْرًا ، فَہُوَ غَیْرُ طَائِلٍ۔","","Musannaf Ibn Abi Shaybah 22703","","","كتاب البيوع والأقضية"
"22704","(۲۲۷۰۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہَمَّامُ بْنُ یَحْیَی ، عَنْ قَتَادَۃَ ، عَنْ یَزِیدَ الرِّشْکِ ، عَنِ الْقَاسِمِ ، قَالَ : قُلْتُ لِسَعِیدِ بْنِ الْمُسَیَّبِ : مَا تَرَی فِی کَسْبِ الْقَسَّامِ ؟ فَکَرِہَہُ ، قُلْتُ : إنِّی أَعْمَلُ فِیہِ حَتَّی یَعْرَقَ جَبِینِی ، فَلَمْ یُرَخِّصْ لِی فِیہِ۔n قَالَ قَتَادَۃُ : وَکَانَ الْحَسَنُ یَکْرَہُ کَسْبَہُ۔n قَالَ قَتَادَۃُ : وَقَالَ ابْنُ سِیرِینَ : إِنْ لَمْ یَکُنْ خَبِیثًا فَلا أَدْرِی مَا ہُوَ۔","","Musannaf Ibn Abi Shaybah 22704","","","كتاب البيوع والأقضية"
"22705","(۲۲۷۰۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ أَبِی الْحَسَنِ ، قَالَ : إنِّی لاَعْجَبُ مِنَ الَّذِی یَأْتَمِنہُ النَّاسُ حَتَّی یَقْضِیَ بَیْنَہُمْ ، ثُمَّ یَأْخُذَ عَلَی ذَلِکَ أَجْرًا۔","","Musannaf Ibn Abi Shaybah 22705","","","كتاب البيوع والأقضية"
"22706","(۲۲۷۰۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی الْحُصَیْنِ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ : أَنَّ عُمَرَ کَرِہَ لِقَاضِی الْمُسْلِمِینَ وَصَاحِبِ مَغَانِمِہِمْ أَنْ یَأْخُذَ أَجْرًا۔","","Musannaf Ibn Abi Shaybah 22706","","","كتاب البيوع والأقضية"
"22707","(۲۲۷۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنِ الْقَاسِمِ ، قَالَ : أَرْبَعٌ لاَ یُؤْخَذُ عَلَیْہِنَّ أَجْرٌ : قِرَائَۃُ الْقُرْآنِ ، وَالأَذَانُ ، وَالْقَضَائُ ، وَالْمُقَاسِمُ۔","","Musannaf Ibn Abi Shaybah 22707","","","كتاب البيوع والأقضية"
"22708","(۲۲۷۰۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، قَالَ : سُئِلَ الْحَسَنُ عَنْ کَسْبِ الْکُسَّاحِ ، فَقَالَ : مَا تُرِیدُونَ إلَیْہِمْ ؟ دَعُوہُمْ ، فَلَوْلاَہُمْ لَسِیلَ بِکُمْ۔","","Musannaf Ibn Abi Shaybah 22708","","","كتاب البيوع والأقضية"
"22709","(۲۲۷۰۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ : أَنَّہُمْ کَانُوا یَکْسَحُونَ لَہُمْ فَیُعْطُونَہُمْ أُجُورَہُمْ۔","","Musannaf Ibn Abi Shaybah 22709","","","كتاب البيوع والأقضية"
"22710","(۲۲۷۱۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَسَنٌ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ یَکْرَہُ أَجْرَ الْکُسَّاحِ۔","","Musannaf Ibn Abi Shaybah 22710","","","كتاب البيوع والأقضية"
"22711","(۲۲۷۱۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مَہْدِیُّ بْنُ مَیْمُونٍ ، عَنْ وَاصِلٍ مَوْلَی أَبِی عُیَیْنَۃَ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عُمَرَ : أَنَّ رَجُلاً سَأَلَہُ فَقَالَ : أَصَبْت مَالاً مِنْ کَنْسِ ہَذِہِ الْحُشُوشِ ؟ فَقَالَ فِیہِ قَوْلاً شَدِیدًا۔","Da'if","Musannaf Ibn Abi Shaybah 22711","","","كتاب البيوع والأقضية"
"22712","(۲۲۷۱۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ الأَزْرَقُ ، عَنِ الشَّعْبِیِّ : أَنَّہُ کَرِہَ أَنْ یُسْلِمَ الرَّجُلُ غُلاَمَہُ کَسَّاحًا۔","","Musannaf Ibn Abi Shaybah 22712","","","كتاب البيوع والأقضية"
"22713","(۲۲۷۱۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبَانَ بْنِ یَزِیدَ ، قَالَ : حدَّثَنَا أَبُو عَبْدِ اللہِ الشَّقَری : أَنَّ ابْنَ عُمَرَ سُئِلَ عَنْ کَسْبِ الْکَنَّاسِ ؟ فَقَالَ : خَبِیثٌ ، کَسْبٌ خَبِیثٌ ، أَکْلٌ خَبِیثٌ ، لُبْسٌ خَبِیثٌ۔","Hasan","Musannaf Ibn Abi Shaybah 22713","","","كتاب البيوع والأقضية"
"22714","(۲۲۷۱۴) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عَطَائِ بْنِ یَزِیدَ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ الْمُنَابَذَۃِ وَالْمُلاَمَسَۃِ۔ (بخاری ۲۱۴۴۔ مسلم ۳)","Sahih","Musannaf Ibn Abi Shaybah 22714","","","كتاب البيوع والأقضية"
"22715","(۲۲۷۱۵) حَدَّثَنَا أَبُو أُسَامَۃَ وَابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ خُبَیْبِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ حَفْصِ بْنِ عاصم ، عَنْ أَبِی ہُرَیْرَۃَ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ الْمُنَابَذَۃِ وَالْمُلاَمَسَۃِ۔n(مسلم ۱۱۵۲۔ ابن ماجہ ۲۱۶۹)","Sahih","Musannaf Ibn Abi Shaybah 22715","","","كتاب البيوع والأقضية"
"22716","(۲۲۷۱۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُوسَی بْنُ عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : نَہَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ بَیْعِ الْمُنَابَذَۃِ وَالْمُلاَمَسَۃِ۔ (نسائی ۲۱۰۷)","Da'if","Musannaf Ibn Abi Shaybah 22716","","","كتاب البيوع والأقضية"
"22717","(۲۲۷۱۷) حَدَّثَنَا سُفْیَانُ ، عَنْ أَبِی الزِّنَادِ ، عَنِ الأَعْرَجِ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، مِثْلَہُ۔n(مسلم ۱۱۵۱۔ ترمذی ۱۳۱۰)","Sahih","Musannaf Ibn Abi Shaybah 22717","","","كتاب البيوع والأقضية"
"22718","(۲۲۷۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : فِی الرَّجُلِ یُسْلِمُ إلَی الرَّجُلِ فِی الطَّعَامِ فَیَحِلُّ الأَجَلُ فَیَجِیئُ إلَیہِ فَیَقُولُ : ہَذَا طَعَامُک قَدْ کِلْتہ فَخُذْہُ ، قَالَ إبراہیم : لاَ یَأْخُذُہُ حَتَّی یُعِیدَ کَیْلَہُ۔","","Musannaf Ibn Abi Shaybah 22718","","","كتاب البيوع والأقضية"
"22719","(۲۲۷۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ضابیئُ بْنُ عَمْرٍو ، قَالَ : سَأَلْتُ سَالِمَ بْنَ عَبْدِ اللہِ عَنِ الرَّجُلِ یُسْلِمُ إلَی الرَّجُلِ فِی الطَّعَامِ فَیَجِیئُ إلَی الْمَدَاسۃ فَیَأْخُذُہُ وَیَقُولُ : اشْتَرِ مِنِّی ؟ قَالَ : مَنْ شَائَ خَادَعَ نَفْسَہُ ، یَقْبِضُہُ ثُمَّ یَبِیعُہُ إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 22719","","","كتاب البيوع والأقضية"
"22720","(۲۲۷۲۰) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ : أَنَّہُ سُئِلَ عَنْ جَرِیبِ أَرْضٍ بِجَرِیبَیْ أَرْضٍ وَذِرَاعِ أَرْضٍ بِذِرَاعَیْ أَرْضٍ ؟ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 22720","","","كتاب البيوع والأقضية"
"22721","(۲۲۷۲۱) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ عَنْ خَمْسَۃَ عَشَرَ جَرِیبًا أَرْضًا بِعِشْرِینَ جَرِیبًا أَرْضًا ؟ فَلَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 22721","","","كتاب البيوع والأقضية"
"22722","(۲۲۷۲۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ، عَنْ شُعْبَۃَ، قَالَ: سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنْ غَزْلِ کَتَّانٍ بِکَتَّانٍ وَزْنًا بِوَزْنٍ؟ فَکَرِہَاہُ۔","","Musannaf Ibn Abi Shaybah 22722","","","كتاب البيوع والأقضية"
"22723","(۲۲۷۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنْ غَزْلِ کَتَّانٍ بِکَتَّانٍ غَیْرِ مَغْزُولٍ وَزْنًا بِوَزْنٍ؟ فَکَرِہَاہُ۔","","Musannaf Ibn Abi Shaybah 22723","","","كتاب البيوع والأقضية"
"22724","(۲۲۷۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا شُعْبَۃُ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنْ رَجُلٍ مَرَّ بِرَقِیقٍ عَلَی عَاشِرٍ ، فَقَالَ: ہَؤُلاَئِ أَحْرَارٌ ؟ قَالَ الْحَکَمُ : لَیْسَ بِشَیْئٍ ، وَقَالَ حَمَّادٌ : إنِّی أَخَافُ أَنْ یَعْتِقُوا۔","","Musannaf Ibn Abi Shaybah 22724","","","كتاب البيوع والأقضية"
"22725","(۲۲۷۲۵) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ : فِی رَجُلٍ مَرَّ بِمَمْلُوکٍ عَلَی عَاشِرٍ فَقَالَ : ہُوَ حُرٌّ۔ قَالَ : کَانَ لاَ یَرَی أَنْ یَعْتِقَ بِہَذَا الْقَوْلِ ، وَلاَ یَرَی بَأْسًا أَنْ یَقُولَہُ۔","","Musannaf Ibn Abi Shaybah 22725","","","كتاب البيوع والأقضية"
"22726","(۲۲۷۲۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ : فِی الرَّجُلِ یَمُرُّ بِالرَّقِیقِ عَلَی الْعَاشِرِ فَیَقُولُ : ہُمْ أَحْرَارٌ - یَنْوِی مِنَ الْعَمَلِ - قَالَ : لاَ یَعْتِقُونَ۔","","Musannaf Ibn Abi Shaybah 22726","","","كتاب البيوع والأقضية"
"22727","(۲۲۷۲۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ : فِی رَجُلٍ دَفَعَ إلَی رَجُلٍ ثَلاَثَۃَ آلاَفِ دِرْہَمٍ مُضَارَبَۃً ، فَرَکِبَ الْبَحْرَ فَکُسِرَ بِہِ ، فَہَلَکَتْ أَلْفَانِ وَبَقِیَتْ أَلْفٌ ، فَتَجَرَ فِی تِلْکَ الأَلْفِ فَأَصَابَ مَالاً ، کَیْفَ یَقْتسِمَانِ ؟ قَالَ : لاَ یَقْتسِمَانِ حَتَّی تَکُونَ ثَلاَثَۃ آلاف ، ثُمَّ یَقْتسِمَانِ الرِّبْحَ بَعْدُ۔","","Musannaf Ibn Abi Shaybah 22727","","","كتاب البيوع والأقضية"
"22728","(۲۲۷۲۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : رأس مال المضارب ألف درہم ، ویقتسمان الربح کما اشترطا۔","","Musannaf Ibn Abi Shaybah 22728","","","كتاب البيوع والأقضية"
"22729","(۲۲۷۲۹) حَدَّثَنَا رَوَّادُ بْنُ جَرَّاحٍ ، عَنِ الأَوْزَاعِی ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ : أَنَّہُ قَالَ لِلْحَکَمِ بْنِ عُتَیْبَۃَ ؟ فَقَالَ : إِنْ کَانَ رَجَعَ إلَی صَاحِبِہِ فَأَعْلِمْہُ أَنَّہُ نَقَصَ مِنْ مَالِکَ ، فَقَالَ : اذْہَبْ فَاعْمَلْ بِمَا بَقِیَ : فَالرِّبْحُ عَلَی خَمْسَۃِ آلاَفٍ یَقْتَسِمَانِہِ ، فَإِنْ لَمْ یَکُنْ ، قَالَ لَہُ فَرَأْسُ مَالِ الرَّجُلِ عَشْرَۃُ آلاَفٍ ویَقْتسِمَانِ مَا زَادَ۔","","Musannaf Ibn Abi Shaybah 22729","","","كتاب البيوع والأقضية"
"22730","(۲۲۷۳۰) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِی ، عَنِ الأَعْمَش ، عَنْ إبْرَاہِیمَ : أَنَّہُ قَالَ فِی الْمُضَارِبِ : الرِّبْحُ عَلَی مَا اصْطَلَحُوا عَلَیْہِ وَالْوَضِیعَۃُ عَلَی الْمَالِ ، فَإِنِ اقْتَسَمُوا الرِّبْحَ کَانَتِ الْوَضِیعَۃُ عَلَی الْمَالِ ، وَإِنْ لَمْ یَقْتَسِمُوا رُدَّ الرِّبْحُ عَلَی رَأْسِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 22730","","","كتاب البيوع والأقضية"
"22731","(۲۲۷۳۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَوْفٍ ، عَنِ ابْنِ سِیرِینَ :فِی الْمُضَارِبِ إذَا رَبِحَ ، ثُمَّ وَضِعَ ، ثُمَّ رَبِحَ ، ثُمَّ وَضِعَ ، قَالَ : الْحِسَابُ عَلَی رَأْسِ الْمَالِ الأَوَّلِ إلاَّ أَنْ یَکُونَ قَبْلَ ذَلِکَ قَبْضًا لِلْمَالِ ، أَوْ حِسَابٌ بِالْقَبْضِ۔","","Musannaf Ibn Abi Shaybah 22731","","","كتاب البيوع والأقضية"
"22732","(۲۲۷۳۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : ہُمَا عَلَی أَصْلِ شَرِکَتِہِمَا حَتَّی یَحْتَسِبَا۔","","Musannaf Ibn Abi Shaybah 22732","","","كتاب البيوع والأقضية"
"22733","(۲۲۷۳۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ : مُضَارِبٌ دُفِعَ إلَیْہِ مَالٌ مُضَارَبَۃً عَلَی النِّصْفِ فَدَفَعَہُ إلَی غَیْرِہِ عَلَی النِّصْفِ ، قَالَ : لِلآخَرِ النِّصْفُ وَلِصَاحِبِ الْمَالِ النِّصْفُ۔n وَقَالَ أَبُو ہَاشِمٍ : لِلآخَرِ النِّصْفُ ، وَمَا بَقِیَ فَبَیْنَ صَاحِبِ الْمَالِ وَالْوَسَطِ۔","","Musannaf Ibn Abi Shaybah 22733","","","كتاب البيوع والأقضية"
"22734","(۲۲۷۳۴) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ۔ وَعَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ : فِی الشَّرِیکَیْنِ یَشْتَرِکَانِ ، قَالَ : لاَ یَحْتَسِبَانِ حَتَّی یَجْتَمِعَا۔","","Musannaf Ibn Abi Shaybah 22734","","","كتاب البيوع والأقضية"
"22735","(۲۲۷۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّہُ کَرِہَ بَیْعَ الْمُشَافَّۃِ یَعْنِی الْمُرَابَحَۃَ۔","","Musannaf Ibn Abi Shaybah 22735","","","كتاب البيوع والأقضية"
"22736","(۲۲۷۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی بَکْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ۔ وَعَنْ سُفْیَانَ ، عَنْ طَارق ، عَنِ الشَّعْبِیِّ، قَالاَ : إذَا اسْتُہْلِکَتِ الْہِبَۃُ فَلاَ رُجُوعَ فِیہَا۔","","Musannaf Ibn Abi Shaybah 22736","","","كتاب البيوع والأقضية"
"22737","(۲۲۷۳۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، عَن عُمَرَ ، قَالَ : ہُوَ أَحَقُّ بِہَا مَا لَمْ یُثِبْہ مِنْہَا ، أَوْ یَسْتَہْلِکُہَا ، أَوْ یَمُتْ أَحَدُہُمَا۔","","Musannaf Ibn Abi Shaybah 22737","","","كتاب البيوع والأقضية"
"22738","(۲۲۷۳۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ أَبِی جَرِیرٍ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : إذَا اسْتُہْلِکَتِ الْہِبَۃُ ، أَوْ أُثیبَ مِنْہَا ، أَوْ وُہِبَتْ لِذِی رَحِمٍ فَلَیْسَ لَہُ أَنْ یَرْجِعَ۔","","Musannaf Ibn Abi Shaybah 22738","","","كتاب البيوع والأقضية"
"22739","(۲۲۷۳۹) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ : فِی الرَّجُلِ یَدْفَعُ إلَی الْخَیَّاطِ الثَّوْبَ فَیَقُولُ : أَمَرْتُک بِقُرْطَق ، فَیَقُولُ الْخَیَّاطُ : أَمَرْتَنِی بِقَمِیصٍ ، قَالَ : ہُوَ قَوْلُ الْخَیَّاطِ۔","","Musannaf Ibn Abi Shaybah 22739","","","كتاب البيوع والأقضية"
"22740","(۲۲۷۴۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تُحْتَلَبَ الْمَوَاشِی إلاَّ بِإِذْنِ أَہْلِہَا ، وَقَالَ : أَیُحِبُّ أَحَدُکُمْ أَنْ تُؤْتَی مَشْرُبَتُہُ الَّتِی فِیہَا طَعَامُہُ فَیُکْسَرَ بَابُہَا فَیُنْتَثَلَ مَا فِیہَا ؟ فَإِنَّمَا مَا فِی ضُرُوعِ مَوَاشِیہِمْ مِثْلُ مَا فِی مَشَارِبِکُمْ ، أَلاَ فَلاَ یَحِلُّ مَا فِی ضُرُوعِہَا إلاَّ بِإِذْنِ أَہْلِہَا۔ (مسلم ۱۳۵۲۔ احمد ۲/۵۷)","Sahih","Musannaf Ibn Abi Shaybah 22740","","","كتاب البيوع والأقضية"
"22741","(۲۲۷۴۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَش ، عَنْ زَیْدِ بْنِ وَہْبٍ ، قَالَ : قَالَ عُمَرُ : إذَا مَرَرْتُمْ بِرَاعِی الإِبِلِ فَنَادُوا : یَا رَاعِی ثَلاَثًا ، فَإِنْ أَجَابَکُمْ فَاسْتَسْقُوہُ ، وَإِنْ لَمْ یُجِبْکُمْ فَاتُوہَا فَحُلُّوہَا وَاشْرَبُوا ، ثُمَّ صُرُّوہَا۔","Sahih","Musannaf Ibn Abi Shaybah 22741","","","كتاب البيوع والأقضية"
"22742","(۲۲۷۴۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ عَبْدِ اللہِ بْنِ عِصْمَۃَ ، قَالَ : سَمِعْتُ أَبَا سَعِیدٍ الْخُدْرِیَّ یَقُولُ: لاَ یَحِلُّ لِرَجُلٍ أَنْ یَحْلُبَ نَاقَۃَ رَجُلٍ مَصْرُورَۃً إلاَّ بِإِذْنِ صَاحِبِہَا ، أَلاَ إنَّ خَاتَمَہَا صِرَارُہَا ، فَإِنْ أَرْمَلَ الْقَوْمُ فَلیُنَادی الرَّاعِی ثَلاَثًا ، فَإِنْ أَجَابَ شَرِبُوا ، وَإِلاَّ فَلْیُمْسِکْہُ رَجُلاَنِ وَلْیَشْرَبُوا۔ (احمد ۳/۴۶۔ بیہقی ۳۶۰)","Hasan","Musannaf Ibn Abi Shaybah 22742","","","كتاب البيوع والأقضية"
"22743","(۲۲۷۴۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَاصِمِ ، عَنْ زِرِّ بْنِ حُبَیْشٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : کُنْتُ غُلاَمًا یَافِعًا أَرْعَی غَنَمًا لِعُقْبَۃَ بْنِ أَبِی مُعَیْطٍ ، فَجَائَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَبُو بَکْرٍ ، وَقَدْ فَرَّا مِنَ الْمُشْرِکِینَ ، فَقَالاَ : یَا غُلاَمُ ، ہَلْ عِنْدَکَ من لَبَنٍ تَسْقِینَا ، فَقُلْتُ : إنِّی مُؤْتَمَنٌ ، لَسْت سَاقِیَکُمَا ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ہَلْ عِنْدَکَ مِنْ جَذَعَۃٍ لَمْ یَنْزُ عَلَیْہَا الْفَحْلُ ؟ قُلْتُ : نَعَمْ ، قَتالَ : فَأَتَیْتُہُمَا بِہَا ، فَاعْتَقَلَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَمَسَحَ الضَّرْعَ وَدَعَا ، ثُمَّ أَتَاہُ أَبُو بَکْر بِصَخْرَۃٍ مُنْقَعِرَۃٍ ، فَاحْتَلَبَ فِیہَا فَشَرِبَ وَشَرِبَ أَبُو بَکْرٍ وَشَرِبْت ، ثُمَّ قَالَ لِلضَّرْعِ : اقْلِصْ ، فَقَلَصَ۔n(ابویعلی ۴۹۶۴۔ ابن حبان ۷۰۶۱)","Da'if","Musannaf Ibn Abi Shaybah 22743","","","كتاب البيوع والأقضية"
"22744","(۲۲۷۴۴) حَدَّثَنَا إسْمَاعِیلُ بْنُ إبْرَاہِیمَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ عَبْدِ اللہِ بْنِ کَثِیرٍ ، عَنْ أَبِی الْمِنْہَالِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قدِمَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمَدِینَۃَ وَالنَّاسُ یُسْلِمُونَ فِی التَّمْرِ الْعَامَ وَالْعَامَیْنِ وَالثَّلاَثَۃَ ، فَقَالَ: مَنْ سَلَّفَ فِی تَمْرٍ فَلْیُسْلِفْ فِی کَیْلٍ مَعْلُومٍ وَوَزْنٍ مَعْلُومٍ إلَی أَجَلٍ مَعْلُومٍ۔ (بخاری ۲۲۴۰۔ مسلم ۱۲۷)","Sahih","Musannaf Ibn Abi Shaybah 22744","","","كتاب البيوع والأقضية"
"22745","(۲۲۷۴۵) حَدَّثَنَا شَرِیکٌ، عَنْ عثمان، عَنْ سَالِمٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: إذَا سَمَّیْت فِی السَّلَمِ قَفِیزًا وأَجَلاً فَلاَ بَأْسَ۔","Hasan","Musannaf Ibn Abi Shaybah 22745","","","كتاب البيوع والأقضية"
"22746","(۲۲۷۴۶) حَدَّثَنَا شَرِیکٌ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ۔ وَأَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 22746","","","كتاب البيوع والأقضية"
"22747","(۲۲۷۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ أَبِی عُمَرَ الْبَہْرَانِیِّ یَحْیَی بْنِ عُبَیْدٍ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ یَقُولُ : لاَ بَأْسَ بِالسَّلَمِ فِی الطَّعَامِ کَیْلاً مَعْلُومًا إلَی أَجَلٍ مَعْلُومٍ۔","Sahih","Musannaf Ibn Abi Shaybah 22747","","","كتاب البيوع والأقضية"
"22748","(۲۲۷۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ ، قَالَ : سَأَلْتُہ عَنِ السَّلَمِ فِی الطَّعَامِ ؟ فَقَالَ : لاَ بَأْسَ بِہِ ، کَیْلٌ مَعْلُومٌ إلَی أَجَلٍ مَعْلُومٍ۔","","Musannaf Ibn Abi Shaybah 22748","","","كتاب البيوع والأقضية"
"22749","(۲۲۷۴۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنْ رَزِینِ بْنِ سُلَیْمَانَ الأَحْمَریِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : أَنَّہُ قَالَ فِی السَّلَمِ : لاَ تُؤَخِّرُ عَنْہُ لِتَزْدَادَ عَلَیْہِ ، وَلاَ یُعَجَّلُ لَکَ لِتَضَعَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 22749","","","كتاب البيوع والأقضية"
"22750","(۲۲۷۵۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُسْلِفَ الرَّجُلُ فِی الطَّعَامِ بِکَیْلٍ مَعْلُومٍ إلَی أَجَلٍ مَعْلُومٍ ، مَا لَمْ یَکُنْ فِی زَرْعٍ أَوْ تَمْرٍ قَبْلَ أَنْ یَبْدُوَ صَلاَحُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 22750","","","كتاب البيوع والأقضية"
"22751","(۲۲۷۵۱) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدِ بْنِ أَبِی الْمُجَالِدِ ، عَنِ ابْنِ أَبِی أَوْفَی ، قَالَ : کُنَّا نُسَالِفُ نَبَطَ أَہْلِ الشَّامِ فِی الْبُرِّ وَالزَّبِیبِ وَرَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِینَا۔","Da'if","Musannaf Ibn Abi Shaybah 22751","","","كتاب البيوع والأقضية"
"22752","(۲۲۷۵۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ : أَنَّہُ قَالَ فِی السَّلَمِ فِی السَّمْنِ ، قَالَ : سَمِّ کَیْلاً مَعْلُومًا وَأَجَلاً مَعْلُومًا۔","Da'if","Musannaf Ibn Abi Shaybah 22752","","","كتاب البيوع والأقضية"
"22753","(۲۲۷۵۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَبِیہِ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : کَانَ أَبُو مَیْسَرَۃَ یُسْلِمُ فِی الْحِنْطَۃِ۔","","Musannaf Ibn Abi Shaybah 22753","","","كتاب البيوع والأقضية"
"22754","(۲۲۷۵۴) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ کُلَیْبِ بْنِ وَائِلٍ ، قَالَ : قُلْتُ لابْنِ عُمَرَ : أَتَانِی رَجُلٌ یَسْتَسْلِفُنِی دَرَاہِم بِطَعَامٍ إلَی أَجَلٍ مُسَمًّی : کُلُّ جَرِیبِ حِنْطَۃٍ بِدِرْہَمٍ وَجَرِیبَیْ شَعِیرٍ بِدِرْہَمٍ ، قَالَ : حَسَنٌ۔","Hasan","Musannaf Ibn Abi Shaybah 22754","","","كتاب البيوع والأقضية"
"22755","(۲۲۷۵۵) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ حَجَّاجٍ ، عَنْ وَبَرَۃَ ، قَالَ : قَالَ ابْنُ عُمَرَ : لاَ بَأْسَ بِالسَّلَمِ إذَا کَانَ فِی کَیْلٍ مَعْلُومٍ إلَی أَجَلٍ مَعْلُومِ۔","","Musannaf Ibn Abi Shaybah 22755","","","كتاب البيوع والأقضية"
"22756","(۲۲۷۵۶) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ ابْنُ مَسْعُودٍ لاَ یَرَی بِالسَّلَمِ فِی کُلِّ شَیْئٍ بَأْسًا إلَی أَجَلٍ مَعْلُومٍ مَا خَلاَ الْحَیَوَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 22756","","","كتاب البيوع والأقضية"
"22757","(۲۲۷۵۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ مُحَمَّدِ بْنِ أَبِی الْمُجَالِدِ ، قَالَ : اخْتَلَفَ أَبُو بُرْدَۃَ وَعَبْدُ اللہِ بْنُ شَدَّادٍ فِی السَّلَمِ ، فَأَرْسَلُونِی إلَی ابْنِ أَبِی أَوْفَی فَسَأَلْتُہُ ؟ فَقَالَ : کُنَّا نُسْلِمُ فِی الْحِنْطَۃِ وَالشَّعِیرِ وَالزَّبِیبِ عَلَی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبِی بَکْرٍ ، وَلاَ نَدْرِی عِنْدَ أَصْحَابِہِ مِنْہُ شَیْئٌ أَمْ لاَ ؟n(بخاری ۲۲۴۳۔ ابوداؤد ۳۴۵۹)","Sahih","Musannaf Ibn Abi Shaybah 22757","","","كتاب البيوع والأقضية"
"22758","(۲۲۷۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی حَسَّانَ الأَعْرَجِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَشْہَدُ أَنَّ السَّلَفَ الْمَضْمُونَ إلَی أَجَلٍ مُسَمًّی ، إنَّ اللَّہَ أَحَلَّہُ وَأَذِنَ فِیہِ ، ثُمَّ قَرَأَ : {إذَا تَدَایَنْتُمْ بِدَیْنٍ إلَی أَجَلٍ مُسَمًّی فَاکْتُبُوہُ}۔","Sahih","Musannaf Ibn Abi Shaybah 22758","","","كتاب البيوع والأقضية"
"22759","(۲۲۷۵۹) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ سِمَاکٍ ، عَنْ ثَعْلَبَۃَ بْنِ الْحَکَمِ ، قَالَ : أَصَبْنَا غَنَمًا لِلْعَدُوِّ فَانْتَہَبْنَاہَا ، فَأَمَرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْقُدُورِ فَأُکْفِئَتْ وَقَالَ : لاَ تَحِلُّ النُّہْبَۃُ۔ (ابن حبان ۵۱۶۹۔ حاکم ۱۳۴)","Hasan","Musannaf Ibn Abi Shaybah 22759","","","كتاب البيوع والأقضية"
"22760","(۲۲۷۶۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ النُّہْبَۃِ وَالْمُثْلَۃِ۔ (بخاری ۵۵۱۶۔ احمد ۴/۳۰۷)","Sahih","Musannaf Ibn Abi Shaybah 22760","","","كتاب البيوع والأقضية"
"22761","(۲۲۷۶۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَبِی جَعْفَرٍ ، عَنِ الرَّبِیعِ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ النُّہْبَۃِ ، وَقَالَ : مَنِ انْتَہَبَ فَلَیْسَ مِنَّا۔ (احمد ۳/۱۴۰۔ طحاوی ۴۹)","Hasan","Musannaf Ibn Abi Shaybah 22761","","","كتاب البيوع والأقضية"
"22762","(۲۲۷۶۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، قَالَ : أَخْبَرَنِی رَجُلٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : کُنَّا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی غَزَاۃٍ فَأَصَابَتْنَا مَجَاعَۃٌ ، فَأَصَبْنَا غَنَمًا فَانْتَہَبْنَاہَا قَبْلَ أَنْ تُقْسَمَ ، فَأَتَانَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَمْشِی مُتَوَکِّئًا عَلَی قَوْسِہِ حَتَّی أَتَانا عَلَی قُدُورِنَا فَکَفَأَہَا بِقَوْسِہِ ، وَقَالَ : لَیْسَتِ النُّہْبَۃُ بِأَحَلَّ مِنَ الْمَیْتَۃِ۔ (ابوداؤد ۲۶۹۸۔ بیہقی ۶۱)","Hasan","Musannaf Ibn Abi Shaybah 22762","","","كتاب البيوع والأقضية"
"22763","(۲۲۷۶۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ مُدْرِکٍ ، عَنِ ابْنِ أَبِی أَوْفَی ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَنْتَہِبُ نُہْبَۃً ذَاتَ شَرَفٍ یَرْفَعُ الْمُسْلِمُونَ إلَیْہَا رُؤُوسَہُمْ وَہُوَ مُؤْمِنٌ۔n(طیالسی ۸۲۳۔ عبد بن حمید ۵۲۵)","Da'if","Musannaf Ibn Abi Shaybah 22763","","","كتاب البيوع والأقضية"
"22764","(۲۲۷۶۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو خَلَفٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : مَنِ انْتَہَبَ نُہْبَۃً ذَاتَ شَرَفٍ یَشْہَرُہُ بِہَا الْمُسْلِمُونَ فَلَیْسَ مِنَّا ، قِیلَ لأَبِی الزُّبَیْرِ : عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (ابوداؤد ۴۳۹۱۔ احمد ۳/۳۹۵)","Da'if","Musannaf Ibn Abi Shaybah 22764","","","كتاب البيوع والأقضية"
"22765","(۲۲۷۶۵) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنِی یَحْیَی بْنُ أَیُّوبَ الْمِصْرِیُّ ، قَالَ : أَخْبَرَنِی عَیَّاشُ بْنُ عَبَّاسٍ الْحِمْیَرِیُّ ، عَنْ أَبِی الْحُصَیْنِ الْحَجْرِیِّ الْہَیْثَمِ ، عَنْ عَامِرِ الْحَجْرِیِّ ، قَالَ : سَمِعْتُ أَبَا رَیْحَانَۃَ صَاحِبَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْہَی عَنِ النُّہْبَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 22765","","","كتاب البيوع والأقضية"
"22766","(۲۲۷۶۶) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنْ یَعْلَی بْنِ حَکِیمٍ ، عَنْ أَبِی لَبِیدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سمرۃ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ النُّہْبَۃِ۔ (احمد ۵/۶۲۔ ابوداؤد ۲۶۹۶)","Hasan","Musannaf Ibn Abi Shaybah 22766","","","كتاب البيوع والأقضية"
"22767","(۲۲۷۶۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ مَوْلًی لِجُہَیْنَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ زَیْدِ بْنِ خَالِدٍ الْجُہَنِیِّ ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَنَّہُ نَہَی عَنِ النُّہْبَۃِ وَالْمُثْلَۃِ۔n(احمد ۵/۱۹۳۔ طبرانی ۵۲۶۴)","Da'if","Musannaf Ibn Abi Shaybah 22767","","","كتاب البيوع والأقضية"
"22768","(۲۲۷۶۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : کَانَ سُفْیَانُ یَکْرَہُ الشَّرِکَۃَ وَالْمُضَارَبَۃَ بِالْعُرُوضِ ، وَکَانَ ابْنُ أَبِی لَیْلَی یَقُولُ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 22768","","","كتاب البيوع والأقضية"
"22769","(۲۲۷۶۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ : أَنَّہُ کَرِہَ الشَّرِکَۃَ بِالْعُرُوضِ۔","","Musannaf Ibn Abi Shaybah 22769","","","كتاب البيوع والأقضية"
"22770","(۲۲۷۷۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، قَالَ : لاَ تَکُونُ الشَّرِکَۃُ وَالْمُضَارَبَۃُ بِالدَّیْنِ والْوَدِیعَۃُ وَالْعُرُوضُ وَالْمَالُ الْغَائِبُ۔","","Musannaf Ibn Abi Shaybah 22770","","","كتاب البيوع والأقضية"
"22771","(۲۲۷۷۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ : أَنَّہُ کَانَ یَکْرَہُ الشَّرِکَۃَ بِالْعُرُوضِ۔","","Musannaf Ibn Abi Shaybah 22771","","","كتاب البيوع والأقضية"
"22772","(۲۲۷۷۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ دَاوُدَ ، عَنْ بَکْرٍ ، قَالَ : زَوَّجَ رَجُلٌ مِنْ أَہْلِ الْبَادِیَۃِ ابْنَتَہُ وَسَاقَ مَہْرَہَا ، ثُمَّ مَاتَ ، فَخَاصَمَتْ إخْوَتَہَا فِی مَہْرِہَا إلَی عُمَرَ بْنِ الْخَطَّابِ ، فَقَالَ عُمَرُ : أَمَّا مَا وَجَدْتِ مِنْ مَہْرِکَ قَائِمًا بِعَیْنِہِ ، فَہُوَ لَکَ ، وَمَا کَانَ أَبُوک اسْتَہْلَکَہُ فَلاَ شَیْئَ لَک۔","","Musannaf Ibn Abi Shaybah 22772","","","كتاب البيوع والأقضية"
"22773","(۲۲۷۷۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَمِّہِ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ : أَنَّہُ حَبَسَ رَجُلاً فِی خَادِمٍ بَاعَہا لاِبْنَتِہِ۔n قَالَ ابْنُ إدْرِیسَ : وَرَأَیْت ابْنَ أَبِی لَیْلَی حَبَسَ رَجُلاً فِی خَادِمٍ بَاعَہا لاِبْنَتِہِ۔","","Musannaf Ibn Abi Shaybah 22773","","","كتاب البيوع والأقضية"
"22774","(۲۲۷۷۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ شُرَیْحٍ وَأَبِی عَبْدِ اللہِ الْجَدَلِیِّ : أَنَّہُمَا حَبَسَا رَجُلاً فِی السِّجْنِ أَخَذَ من مَہْرِ ابْنَتِہِ۔","","Musannaf Ibn Abi Shaybah 22774","","","كتاب البيوع والأقضية"
"22775","(۲۲۷۷۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عُبَیْدِ أَبِی قُدَامَۃَ ، قَالَ : قَضَی عُمَرُ بْنُ الْخَطَّابِ فِی مُہُورِ النِّسَائِ : مَا کَانَ قَائِمًا بِعَیْنِہِ فَہِیَ أَحَقُّ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 22775","","","كتاب البيوع والأقضية"
"22776","(۲۲۷۷۶) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یَکُونُ لِلْوَلَدِ عَلَی وَالِدِہِ دَیْنٌ۔","","Musannaf Ibn Abi Shaybah 22776","","","كتاب البيوع والأقضية"
"22777","(۲۲۷۷۷) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا رُہِنَ الرَّجُلُ الْحُرُّ فَأَقَرَّ بِذَلِکَ کَانَ رَہْنًا حَتَّی یَفُکَّہُ الَّذِی رَہَنَہُ ، أَوْ یَفُکَّ نَفْسَہُ۔","","Musannaf Ibn Abi Shaybah 22777","","","كتاب البيوع والأقضية"
"22778","(۲۲۷۷۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ یَکْرَہُ شِرَاء قِمَارِ الصِّبْیَانِ مِنَ الصِّبْیَانِ ، وَکَانَ الْحَسَنُ یُرَخِّصُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 22778","","","كتاب البيوع والأقضية"
"22779","(۲۲۷۷۹) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کُلُّ شَیْئٍ فِیہِ قِمَارٌ فَہُوَ مِنَ الْمَیْسِرِ۔","","Musannaf Ibn Abi Shaybah 22779","","","كتاب البيوع والأقضية"
"22780","(۲۲۷۸۰) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنِ ابْنِ حَرْمَلَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : لاَ بَأْسَ بِالْبَیْضِ الَّذِی یَلْعَبُ بِہِ الصِّبْیَانُ یَعْنِی شِرَائَہُ۔","","Musannaf Ibn Abi Shaybah 22780","","","كتاب البيوع والأقضية"
"22781","(۲۲۷۸۱) حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 22781","","","كتاب البيوع والأقضية"
"22782","(۲۲۷۸۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : فِی مَمْلُوکٍ قَالَ لِمَوْلاَہُ : بِعْنِی مِنْ فُلاَنٍ بِکَذَا وَکَذَا وَلَک خَمْسُمِئَۃٍ درہم ، أو رجل جاء ، فضمن ، قَالَ : بع غلامک من فلان بکذا وکذا ولک خمسمئۃ ، قَالَ : یَبْطُلُ شَرْطُہُ۔","","Musannaf Ibn Abi Shaybah 22782","","","كتاب البيوع والأقضية"
"22783","(۲۲۷۸۳) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ یَجُوزُ ، أَوْ کَلِمَۃٌ نَحْوُہَا۔","","Musannaf Ibn Abi Shaybah 22783","","","كتاب البيوع والأقضية"
"22784","(۲۲۷۸۴) حدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَبِی یَعْقُوبَ الثَّقَفِیِّ ، عَنْ خَالِدِ بْنِ أَبِی مَالِکٍ ، قَالَ : بَایَعْتُ مُحَمَّدَ بْنَ سَعْدٍ سِلْعَۃً فَقَالَ : ہَاتِ یَدَک أُمَاسِحُک ، فَإِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : الْبَرَکَۃُ فِی الْمُمَاسَحَۃِ۔n(ابوداؤد ۱۶۸)","Da'if","Musannaf Ibn Abi Shaybah 22784","","","كتاب البيوع والأقضية"
"22785","(۲۲۷۸۵) حَدَّثَنَا یَزِیدُ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَرِہَ الْبَزَّ مُضَارَبَۃً۔","","Musannaf Ibn Abi Shaybah 22785","","","كتاب البيوع والأقضية"
"22786","(۲۲۷۸۶) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عن أشعث ، قَالَ : کَرِہَ ابنُ سِیِرین الْبَزَّ مُضَارَبَۃً۔","","Musannaf Ibn Abi Shaybah 22786","","","كتاب البيوع والأقضية"
"22787","(۲۲۷۸۷) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ : أَنَّہُ کَانَ یَکْرَہُ أَنْ یَدْفَعَ الرَّجُلُ إلَی الرَّجُلِ الْمَتَاعَ مُضَارَبَۃً وَیَحْبِسُہُ عَلَیْہِ دَرَاہِم۔","","Musannaf Ibn Abi Shaybah 22787","","","كتاب البيوع والأقضية"
"22788","(۲۲۷۸۸) حَدَّثَنَا خَالِدُ بْنُ عَبْدِالرَّحْمَنِ بْنِ بُکَیْرٍ، عَنِ ابْنِ سِیرِینَ، عَنْ شُرَیْحٍ، قَالَ: یُزَیِّنُ الرَّجُلُ سِلْعَتَہُ بِمَا شَائَ۔","","Musannaf Ibn Abi Shaybah 22788","","","كتاب البيوع والأقضية"
"22789","(۲۲۷۸۹) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : لاَ بَأْسَ بِالتَّزْیِینِ ، وَکَرِہَ الْغِشَّ۔","","Musannaf Ibn Abi Shaybah 22789","","","كتاب البيوع والأقضية"
"22790","(۲۲۷۹۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أُسَامَۃُ بْنُ زَیْدٍ ، عَنْ أَبِی حَازِمٍ ، عَنْ سَہْلِ بْنِ سَعْدٍ : أَنَّہُمْ مَرُّوا عَلَیْہِ بِجَارِیَۃٍ قَدْ زُیِّنَتْ ، فَدَعَا بِہَا وَنَظَرَ إلَیْہَا وَأَجْلَسَہَا فِی حَجْرِہِ ، وَمَسَحَ عَلَی رَأْسِہَا وَدَعَا لَہَا بِالْبَرَکَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 22790","","","كتاب البيوع والأقضية"
"22791","(۲۲۷۹۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أسامۃ بن زید ، عن بعض أشیاخہ ، قَالَ : قَالَ عمر : إذا أراد أحد منکم أن یحسِّن الجاریۃ فلیزیِّنْہا ، ولیطَّوَّف بہا ، یتعرَّض بہا رزق اللہ۔","Da'if","Musannaf Ibn Abi Shaybah 22791","","","كتاب البيوع والأقضية"
"22792","(۲۲۷۹۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْعَلاَئُ بْنُ عَبْدِ الْکَرِیمِ ، عَنْ عَمَّارِ بْنِ عِمْرَانَ رَجُلٍ مِنْ زَیْدِ اللہِ ، عَنِ امْرَأَۃٍ مِنْہُمْ ، عَنْ عَائِشَۃَ : أَنَّہَا شَوَّفَتْ جَارِیَۃً وَطَافَتْ بِہَا وَقَالَتْ : لَعَلَّنَا نَتَصَیَّد بِہَا بَعْضَ شَبَابِ قُرَیْشٍ۔","Da'if","Musannaf Ibn Abi Shaybah 22792","","","كتاب البيوع والأقضية"
"22793","(۲۲۷۹۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ وَابْنُ عَوْنٍ ، عَنْ مُحَمَّدٍ : أَنَّ رَجُلاً صَبَغَ ثَوْبًا لَہُ لَوْنَ الْہَرَوِیِّ ، فَجَائَ رَجُلٌ فَقَالَ : بِکَمْ تَبِیعُ الْہَرَوِیَّ ؟ فَسکَتَ ، ثُمَّ سَاوَمَہُ فَاشْتَرَاہُ مِنْہُ ، فَلَمَّا ذَہَبَ بِہِ إذَا ہُوَ لَیْسَ بِہَرَوِیٍّ ، فَخَاصَمَہُ إلَی شُرَیْحٍ فَقَالَ : لَوِ اسْتَطَاعَ أَنْ یُزَیِّنَ ثَوْبَہُ بِأَفْضَلَ مِنْ ذَلِکَ لَزَیَّنَہُ فَأَجَازَہُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 22793","","","كتاب البيوع والأقضية"
"22794","(۲۲۷۹۴) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ مُجَالِدٍ ، عَنِ ابْنِ أَبِی بُرْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : أَتَی عُمَرُ غُلاَمًا لَہُ یَبِیعُ الرُّطَبَ فَقَالَ : نَقِّشْہَا فَإِنَّہُ أَحْسَنُ ، وَأَتَاہُ غُلاَمٌ لَہُ وَہُوَ یَبِیعُ الْحُلَلَ فَقَالَ : إذَا کَانَ الثَّوْبُ ضَیِّقًا فَانْشُرْہُ وَأَنْتَ جَالِسٌ ، وَإِذَا کَانَ وَاسِعًا فَانْشُرْہُ وَأَنْتَ قَائِمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 22794","","","كتاب البيوع والأقضية"
"22795","(۲۲۷۹۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ شُرَیْحٍ : أَنَّہُ کَانَ یَرُدُّ مِنَ الْعَسَرِ۔","","Musannaf Ibn Abi Shaybah 22795","","","كتاب البيوع والأقضية"
"22796","(۲۲۷۹۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسرائیل ، عن جابر ، عن عامر ، أَنَّہُ کَانَ یَرُدُّ مِنَ الْعَسَرِ۔","","Musannaf Ibn Abi Shaybah 22796","","","كتاب البيوع والأقضية"
"22797","(۲۲۷۹۷) حَدَّثَنَا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ: أَنَّہُ کَانَ یَرُدُّ مِنَ الإِدِّفَانِ وَلاَ یَرُدُّ مِنَ الإِبَاقِ ، وَالإِدِّفَانُ: الَّذِی یَتَوَارَی فِی الْمِصْرِ ، وَالإِبَاقُ : الَّذِی یَلْحَقُ بِأَرْضِہِ۔","","Musannaf Ibn Abi Shaybah 22797","","","كتاب البيوع والأقضية"
"22798","(۲۲۷۹۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی حَصِینٍ ، عَنْ عَامِرٍ ، قَالَ : یُرَدُّ مِنْ عُوَارِ الظُّفْرِ ، وَیُرَدُّ مِنَ الشَّامَۃِ الشَّائِنَۃِ۔","","Musannaf Ibn Abi Shaybah 22798","","","كتاب البيوع والأقضية"
"22799","(۲۲۷۹۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنْ عُبَیْدِ اللہِ بْنِ جَہْضَمٍ الأَزْدِیِّ ، قَالَ : خَاصَمْت إلَی شُرَیْحٍ فِی بَغْلَۃٍ حِمَارَۃٍ فَرَدَّہَا۔","","Musannaf Ibn Abi Shaybah 22799","","","كتاب البيوع والأقضية"
"22800","(۲۲۸۰۰) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ أَشْعَثَ، عَنِ ابْنِ سِیرِینَ، عَنْ شُرَیْحٍ: أَنَّہُ کَانَ یَرُدُّ مِنْ کُلِّ عَیْبٍ۔","","Musannaf Ibn Abi Shaybah 22800","","","كتاب البيوع والأقضية"
"22801","(۲۲۸۰۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ شُرَیْحٍ : أَنَّہُ کَانَ لاَ یَرُدُّ مِنَ الْعِثَارِ ، وَیَقُولُ : کُلُّ الدَّوَابِّ تَعْثِرُn قَالَ وَکِیعٌ : قَالَ سُفْیَانُ : ہُوَ عَیْبٌ یُرَدُّ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 22801","","","كتاب البيوع والأقضية"
"22802","(۲۲۸۰۲) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ شُرَیْحٍ : أَنَّہُ کَانَ لاَ یَرُدُّ مِنَ الْعِثَارِ وَیَقُولُ : کُلُّ الدَّوَابِّ تَعْثِرُ۔","","Musannaf Ibn Abi Shaybah 22802","","","كتاب البيوع والأقضية"
"22803","(۲۲۸۰۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : اخْتُصِمَ إلَی شُرَیْحٍ فِی شَاۃٍ تَأْکُلُ الذُّبَّانَ ، قَالَ : لَبَنٌ طَیِّبٌ وَعَلَفٌ مَجَّانٌ ، فَأَجَازَہَا۔","","Musannaf Ibn Abi Shaybah 22803","","","كتاب البيوع والأقضية"
"22804","(۲۲۸۰۴) حَدَّثَنَا مُعَاذُ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنِ الرُّدَیْنِیِّ ، عَنْ یَحْیَی بْنِ یَعْمَُرَ ، عَنْ عُمَرَ : أَنَّہُ کَانَ یُکْرِی وَیَشْتَرِطَ أَنْ لاَ یُدَمَّنَ بِالْعُرَّۃِ۔","","Musannaf Ibn Abi Shaybah 22804","","","كتاب البيوع والأقضية"
"22805","(۲۲۸۰۵) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا فُضَیْلُ بْنُ غَزْوَانَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ إذَا أَکْرَی أَرْضَہُ اشْتَرَطَ عَلَی صَاحِبِہَا أَنْ لاَ یُعِرَّہَا۔","Sahih","Musannaf Ibn Abi Shaybah 22805","","","كتاب البيوع والأقضية"
"22806","(۲۲۸۰۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُوسَی بْنُ عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ : أَنَّ رَجُلاً کَانَ یَزْرَعُ أَرْضَہُ بِالْعَذِرَۃِ ، فَقَالَ لَہُ : عُمَرُ بْنُ الْخَطَّابِ : أَنْتَ الَّذِی تُطْعِمُ النَّاسَ مَا یَخْرُجُ مِنْہُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 22806","","","كتاب البيوع والأقضية"
"22807","(۲۲۸۰۷) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ زِیَادِ أبی الْحَسَنِ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّہُ کَرِہَ أَنْ تُدْمَلَ الأَرْضَ بِالْعَذِرَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 22807","","","كتاب البيوع والأقضية"
"22808","(۲۲۸۰۸) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ حَجَّاجِ بْنِ حَسَّانَ ، قَالَ : حدَّثَنِی صَخْرٌ ، عَنْ أَبِی جَعْفَرٍ : أَنَّہُ کَرِہَ أَنْ تُدْمَلَ الأَرْضَ بِالْعَذِرَۃِ۔","","Musannaf Ibn Abi Shaybah 22808","","","كتاب البيوع والأقضية"
"22809","(۲۲۸۰۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ محمد بْنِ عبد الرحمن ، عن بابی مَوْلَی أُمِّ سَلَمَۃَ، أَوْ عَائِشَۃَ ، قَالَ : رَأَیْتُ سَعْدًا یَحْمِلُ مِکْتَلاً مِنْ عَذِرَۃِ النَّاسِ إلَی أَرْضٍ لَہُ ، یُقَالُ لَہَا : زَغَابَۃُ ، فَقُلْتُ لَہُ، یَا أَبَا إِسْحَاقَ ، أَتَحْمِلُ ہَذَا ؟ قَالَ : إنَّ مِکْتَلَ عُرَّۃٍ مِکْتَلُ حَبٍّ۔","Da'if","Musannaf Ibn Abi Shaybah 22809","","","كتاب البيوع والأقضية"
"22810","(۲۲۸۱۰) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ : فِی قَوْلِہِ : {وَلاَ یَأْبَ الشُّہَدَائُ إذَا مَا دُعُوا} قَالَ : إذَا کَانَتْ عِنْدَکَ الشَّہَادَۃُ ، فَقَدْ دُعِیتَ۔","","Musannaf Ibn Abi Shaybah 22810","","","كتاب البيوع والأقضية"
"22811","(۲۲۸۱۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : إذَا ابْتَدَأَ لِیَشْہَدَ وَإِذَا دُعِیَ لِیُقِیمْہَا۔","","Musannaf Ibn Abi Shaybah 22811","","","كتاب البيوع والأقضية"
"22812","(۲۲۸۱۲) حَدَّثَنَا حُمَیْدٌ ، عَنِ الْحَسَنِ ، عَنْ سالم ، عن سَعِیدِ بْنِ جُبَیْرٍ : فِی قَوْلِہِ : {وَلاَ یَأْبَ الشُّہَدَائُ إذَا مَا دُعُوا} قَالَ : ہُوَ الرَّجُلُ یَشْہَدُ عَلَی الشَّہَادَۃِ ، ثُمَّ یُدْعَی لَہَا۔","Hasan","Musannaf Ibn Abi Shaybah 22812","","","كتاب البيوع والأقضية"
"22813","(۲۲۸۱۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِمْرَانُ بْنُ حُدَیْرٍ ، قَالَ : قُلْتُ لأَِبِی مِجْلَزٍ : إنِّی أُدْعَی إلَی الشَّہَادَۃِ وَأَنَا أَکْرَہُ ؟ قَالَ : دَعْ مَا تَکْرَہُ ، وَلَکِنْ إذَا شَہِدْت فَدُعِیتَ فَأَجِبْ۔","","Musannaf Ibn Abi Shaybah 22813","","","كتاب البيوع والأقضية"
"22814","(۲۲۸۱۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ إبْرَاہِیمَ ، عَنِ الْحَسَنِ ، قَالَ : مَنْ دُعِیَ إلَی شَہَادَۃٍ فَلْیُجِبْ ، وَلَکِنْ لاَ یَشْہَدْ إلاَّ عَلَی مَا یَعْلَمُ۔","","Musannaf Ibn Abi Shaybah 22814","","","كتاب البيوع والأقضية"
"22815","(۲۲۸۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ ثَابِتٍ ، قَالَ : سَمِعْتُ عَطَائً وَسُئِلَ : {وَلاَ یَأْبَ الشُّہَدَائُ إذَا مَا دُعُوا} قَبْلَ أَنْ شَہِدُوا أَوْ بَعْدَ ؟ قَالَ : لاَ ، بَلْ بَعْدَ مَا شَہِدُوا۔","","Musannaf Ibn Abi Shaybah 22815","","","كتاب البيوع والأقضية"
"22816","(۲۲۸۱۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی حَصِینٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : إذَا کَانُوا قَدْ شَہِدُوا۔","","Musannaf Ibn Abi Shaybah 22816","","","كتاب البيوع والأقضية"
"22817","(۲۲۸۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : الشَّاہِدُ بِالْخِیَارِ مَا لَمْ یَشْہَدْ۔","","Musannaf Ibn Abi Shaybah 22817","","","كتاب البيوع والأقضية"
"22818","(۲۲۸۱۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ شَرِیکٍ ، عَنْ سَالِمٍ ، عَنْ سَعِیدٍ ، قَالَ : الَّذِی عِنْدَہُ الشَّہَادَۃُ۔","","Musannaf Ibn Abi Shaybah 22818","","","كتاب البيوع والأقضية"
"22819","(۲۲۸۱۹) حَدَّثَنَا شَبَابَۃُ ، عَنْ وَرْقَائَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ : (وَلاَ یَأْبَ الشُّہَدَائُ إذَا مَا دُعُوا) قَالَ : إذَا کَانُوا قَدْ شَہِدُوا قَبْلَ ہَذَا۔","","Musannaf Ibn Abi Shaybah 22819","","","كتاب البيوع والأقضية"
"22820","(۲۲۸۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : (وَلاَ یَأْبَ الشُّہَدَائُ إذَا مَا دُعُوا) قَالَ : إذَا کَانُوا قَدْ شَہِدُوا۔","","Musannaf Ibn Abi Shaybah 22820","","","كتاب البيوع والأقضية"
"22821","(۲۲۸۲۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ النَّاسُ یَتَحَجَّرُونَ عَلَی عَہْدِ عُمَرَ فَقَالَ : مَنْ أَحْیَی أَرْضًا فَہِیَ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 22821","","","كتاب البيوع والأقضية"
"22822","(۲۲۸۲۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ مُحَمَّدِ بْنِ عُبَیْدِ اللہِ الثَّقَفِیِّ ، قَالَ : کَتَبَ عُمَرُ : أَنَّہُ مَنْ أَحْیَی أَرْضًا مَوَاتًا ، فَہُوَ أَحَقُّ بِہِ۔","","Musannaf Ibn Abi Shaybah 22822","","","كتاب البيوع والأقضية"
"22823","(۲۲۸۲۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنِ ابْنِ رَافِعٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَحْیَی أَرْضًا مَیْتَۃً فَلَہُ فِیہَا أَجْرٌ ، وَمَا أَکَلَتِ الْعَافِیَۃُ فَہِی لَہُ صَدَقَۃٌ۔n(احمد ۳/۳۱۳۔ ابن حبان ۵۲۰۳)","Sahih","Musannaf Ibn Abi Shaybah 22823","","","كتاب البيوع والأقضية"
"22824","(۲۲۸۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَحْیَی أَرْضًا مَیْتَۃً فَہِیَ لَہُ ، وَلَیْسَ لِعِرْقٍ ظَالِمٍ حَقٌّ۔ (ابوداؤد ۳۰۷۱۔ مالک ۲۶)","","Musannaf Ibn Abi Shaybah 22824","","","كتاب البيوع والأقضية"
"22825","(۲۲۸۲۵) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ أَبِی بَکْرِ بْنِ حَفْصٍ ، یَرْفَعُہُ ، قَالَ : مَنْ أَحْیَی أَرْضًا عَلَی دَعْوَۃٍ مِنَ الْمِصْرِ فَلَہُ رَقَبَتُہَا إلَی مَا یُصِیبُ فِیہَا مِنَ الأَجْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 22825","","","كتاب البيوع والأقضية"
"22826","(۲۲۸۲۶) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ، عَنْ لَیْثٍ، عَنْ طَاوُوسٍ، قَالَ: مَنْ أَحْیَی شَیْئًا مِنْ مَوْتَانِ الأَرْضِ فَلَہُ رَقَبَتُہَا۔","","Musannaf Ibn Abi Shaybah 22826","","","كتاب البيوع والأقضية"
"22827","(۲۲۸۲۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ : مِثْلَ حَدِیثِ مُعْتَمِرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 22827","","","كتاب البيوع والأقضية"
"22828","(۲۲۸۲۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَحْیَی أَرْضًا مَیْتَۃً فَلَہُ رَقَبَتُہَا۔","","Musannaf Ibn Abi Shaybah 22828","","","كتاب البيوع والأقضية"
"22829","(۲۲۸۲۹) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، قَالَ: مَنْ أَحْیَی أَرْضًا مَوَاتًا لَمْ تَکُنْ لأَحَدٍ قَبْلَہُ فَہِیَ لَہُ۔n قَالَ ہِشَامٌ : وَکَتَبَ بِذَلِکَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ۔","","Musannaf Ibn Abi Shaybah 22829","","","كتاب البيوع والأقضية"
"22830","(۲۲۸۳۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ حُمَیْدٍ الْحِمْیَرِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ تَرَکَ دَابَّۃً بِمَہْلَکَۃٍ فَہِیَ لِلَّذِی أَحْیَاہَا۔ (ابوداؤد ۳۵۱۹۔ دارقطنی ۶۸)","","Musannaf Ibn Abi Shaybah 22830","","","كتاب البيوع والأقضية"
"22831","(۲۲۸۳۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُثْمَانَ بْنِ غِیَاثٍ ، قَالَ : سُئِلَ الْحَسَنُ عَنِ الرَّجُلِ یَتْرُکُ دَابَّتَہُ بِالأَرْضِ الْقَفْرِ فَیَأْخُذُہَا رَجُلٌ فَیُصْلِحُہَا وَیَقُومُ عَلَیْہَا حَتَّی یُصْلِحَہَا ؟ قَالَ : ہِیَ لِمَنْ أَحْیَاہَا۔","","Musannaf Ibn Abi Shaybah 22831","","","كتاب البيوع والأقضية"
"22832","(۲۲۸۳۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ سَمُرَۃَََ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ أَحَاطَ حَائِطًا عَلَی أَرْضٍ فَہِیَ لَہُ۔ (ابوداؤد ۳۰۷۲۔ احمد ۵/۱۲)","Hasan","Musannaf Ibn Abi Shaybah 22832","","","كتاب البيوع والأقضية"
"22833","(۲۲۸۳۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ : فِی رَجُلٍ وَہَبَ لِرَجُلٍ لَہُ عَلَیْہِ دَیْنٌ ، قَالَ : لَیْسَ لَہُ أَنْ یَرْجِعَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 22833","","","كتاب البيوع والأقضية"
"22834","(۲۲۸۳۴) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ، عَنْ شُعْبَۃَ، قَالَ: قَالَ لِی الْحَکَمُ: أَتَانِی ابْنُ أَبِی لَیْلَی فَسَأَلَنِی عَنْ رَجُلٍ کَانَ لَہُ عَلَی رَجُلٍ دَیْنٌ فَوَہَبَہُ لَہُ ، أَلَہُ أَنْ یَرْجِعَ فِیہِ ؟ قُلْتُ : لاَ۔ وَسَأَلْت حَمَّادًا فَقَالَ : بَلَی ، لَہُ أَنْ یَرْجِعَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 22834","","","كتاب البيوع والأقضية"
"22835","(۲۲۸۳۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْکَرِیمِ الْجَزَرِیِّ ، قَالَ : مَاتَتِ امْرَأَۃٌ لِخَالٍ لِی وَکَانَ مُوسِرًا ، فَتَرَکَتْ خَادِمًا وَوَلَدًا صِغَارًا ، فَقَالَ سَعِیدُ بْنُ جُبَیْرٍ : لاَ بَأْسَ أَنْ یُقَوِّمَ الأَبُ أَنْصِبَائَ وَلَدِہِ مِنَ الْخَادِمِ وَیَطَأَہَا۔","","Musannaf Ibn Abi Shaybah 22835","","","كتاب البيوع والأقضية"
"22836","(۲۲۸۳۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو سُفْیَانَ بْنُ الْعَلاَئِ ، قَالَ : سَأَلْتُ الْحَسَنَ وَطَاوُوسًا عَنْ ذَلِکَ : فَقَالاَ : لاَ بَأْسَ أَنْ یَطَأَہَا۔","","Musannaf Ibn Abi Shaybah 22836","","","كتاب البيوع والأقضية"
"22837","(۲۲۸۳۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُوسَی بْنِ سَعِیدٍ : أَنَّ جَدَّتَہُ مَاتَتْ عِنْدَ أَبِی بُرْدَۃَ فَاقْتَوَی أَبُو بُرْدَۃَ بَعْضَ جَوَارِیہَا ، قُلْتُ : حدَّثَک ابْنُ عَوْنٍ ، عَنْ مُحَمَّدٍ قَالَ : إذَا أَرَادَ الرَّجُلُ أَنْ یَأْخُذَ جَارِیَۃَ وَلَدِہِ وَہُمْ صِغَارٌ قَوَّمَہَا عَلَیْہِ قِیمَۃً وَأَشْہَدَ لہم بِثَمَنِہَا ، قَالَ : نَعَمْ ، سَمِعْتہ۔","","Musannaf Ibn Abi Shaybah 22837","","","كتاب البيوع والأقضية"
"22838","(۲۲۸۳۸) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ : أَنَّ امْرَأَۃً مَاتَتْ وَتَرَکَتْ وَلَدًا صَغِیرًا وَجَارِیَۃً ، فَأَرَادَ الأَبُ أَنْ یَشْتَرِیَ الْجَارِیَۃَ فَقَالَ سَعِیدٌ : قَوِّمْہَا فِی السُّوقِ قِیمَۃً ، ثُمَّ أَشْہِدْ عَلَی نَفْسِکَ بِثَمَنِہَا ، ثُمَّ اصْنَعْ بِہَا مَا بَدَا لَک۔","","Musannaf Ibn Abi Shaybah 22838","","","كتاب البيوع والأقضية"
"22839","(۲۲۸۳۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَنْ أَبِیہِ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ أَلاَّ یُؤْخَذَ مِنْ أَہْلِ السُّوقِ أَجْرٌ۔","","Musannaf Ibn Abi Shaybah 22839","","","كتاب البيوع والأقضية"
"22840","(۲۲۸۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یَحْیَی بْن أبی الْہَیْثَمِ الْعَطَّارُ ، عَنِ الأَصْبَغِ بْنِ نُبَاتَۃَ ، قَالَ : کُنَّا فِی زَمَانِ عَلِیٍّ مَنْ سَبَقَ إلَی مَکَان فِی السُّوقِ کَانَ أَحَقَّ بِہِ إلَی اللَّیْلِ۔","Da'if","Musannaf Ibn Abi Shaybah 22840","","","كتاب البيوع والأقضية"
"22841","(۲۲۸۴۱) حَدَّثَنَا وکیع قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ تَمِیم الْرَسبی ، قَالَ : سَأَلْتُ الْحَسَنَ عَنْ دَکَاکِینِ السُّوقِ ؟ فَکَرِہَ بَیْعَہَا وَشِرَائَہَا وَإِجَارَتَہَا۔","","Musannaf Ibn Abi Shaybah 22841","","","كتاب البيوع والأقضية"
"22842","(۲۲۸۴۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ زِیَادِ بْنِ فَیَّاضٍ ، عَنْ رَجُلٍ مِنْ أَہْلِ الْمَدِینَۃِ ، قَالَ : دَخَلَ عُمَرُ بْنُ الْخَطَّابِ السُّوقَ وَہُوَ رَاکِبٌ ، فَرَأَی دُکَّانًا قَدْ أُحْدِثَ فِی السُّوقِ ، فَکَسَرَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 22842","","","كتاب البيوع والأقضية"
"22843","(۲۲۸۴۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنِ الْحَسَنِ ، عَنْ مُجَالِدِ بْنِ سَعِیدٍ ، قَالَ : أَوَّلُ مَنْ أَخَذَ مِنَ السُّوقِ أَجْرًا زِیَادٌ۔","","Musannaf Ibn Abi Shaybah 22843","","","كتاب البيوع والأقضية"
"22844","(۲۲۸۴۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا وَبْرُ بْنُ أَبِی دُلَیْلَۃَ الطَّائِفِیُّ ، عَنْ مُحَمَّدِ بْنِ مَیْمُونِ بْنِ مُسَیْکَۃَ ، قَالَ وَکِیعٌ : وَأَثْنَی عَلَیْہِ خَیْرًا ، عَنْ عَمْرِو بْنِ الشَّرِیدِ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیُّ الْوَاجِدِ یُحِلُّ دینہ وَعُقُوبَتَہُ۔ (ابوداؤد ۳۶۲۳۔ ابن حبان ۵۰۸۹)","Sahih","Musannaf Ibn Abi Shaybah 22844","","","كتاب البيوع والأقضية"
"22845","(۲۲۸۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ بْنِ ذَکْوَانَ أَبِی الزِّنَادِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ ہُرْمُزَ الأَعْرَجِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَطْلُ الْغَنِیِّ ظُلْمٌ ، وَمَنْ أُحِیلَ عَلَی مَلِیئٍ فَلْیَحْتَلْ۔ (بخاری ۲۲۸۷۔ ترمذی ۱۳۰۸)","Sahih","Musannaf Ibn Abi Shaybah 22845","","","كتاب البيوع والأقضية"
"22846","(۲۲۸۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الرَّبِیعُ بْنُ مُسْلِمٍ ، عَنْ مَرْوَان أَبِی عُثْمَانَ الْعِجْلِیّ ، قَالَ : قَالَ عَبْدُ اللہِ بْنُ مَسْعُودٍ : لَوْ کَانَ الْمَعْکُ رَجُلاً کَانَ رَجُلَ سُوئٍ وَالْمَعْکُ طَرَفٌ مِنَ الظُّلْمِ۔","Da'if","Musannaf Ibn Abi Shaybah 22846","","","كتاب البيوع والأقضية"
"22847","(۲۲۸۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ شُرَیْحٍ : الْمَعْکُ طَرَفٌ مِنَ الظُّلْمِ۔","","Musannaf Ibn Abi Shaybah 22847","","","كتاب البيوع والأقضية"
"22848","(۲۲۸۴۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : الْمَطْلُ ظُلْمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 22848","","","كتاب البيوع والأقضية"
"22849","(۲۲۸۴۹) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ أبی إِسْحَاقَ ، عَنْ شُرَیْحٍ ، قَالَ : الْمَعْکُ طَرَفٌ مِنَ الظُّلْمِ۔","","Musannaf Ibn Abi Shaybah 22849","","","كتاب البيوع والأقضية"
"22850","(۲۲۸۵۰) حَدَّثَنَا ہُشَیْمٌ، عَنْ إسْمَاعِیلَ بْنِ سَالِمٍ، عَنْ أَبِی إدْرِیسَ الأَوْدِیِّ: أَنَّ دَانیَال أَوَّلُ مَنْ فَرَّقَ بَیْنَ الشُّہُودِ۔","","Musannaf Ibn Abi Shaybah 22850","","","كتاب البيوع والأقضية"
"22851","(۲۲۸۵۱) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنْ أَبِیہِ ، عَنْ مُحْرِزِ بْنِ صَالِحٍ : أَنَّ عَلِیًّا فَرَّقَ بَیْنَ الشُّہُودِ۔","Da'if","Musannaf Ibn Abi Shaybah 22851","","","كتاب البيوع والأقضية"
"22852","(۲۲۸۵۲) حَدَّثَنَا عُمَرُ بْنُ عَلِیِّ بْنِ عَطَائِ بْنِ مُقَدَّمٍ ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ ، قَالَ : سَمِعْتُ الْحَکَم یَقُولُ : یُبْدَأُ بِالْکَفَنِ ، ثُمَّ الدَّیْنِ ، ثُمَّ الْوَصِیَّۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 22852","","","كتاب البيوع والأقضية"
"22853","(۲۲۸۵۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ بَعْضِ أَصْحَابِہِ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُبْدَأُ بِالْکَفَنِ ، ثُمَّ الدَّیْنِ ، ثُمَّ الْوَصِیَّۃِ ، ثُمَّ الْمِیرَاثِ۔","","Musannaf Ibn Abi Shaybah 22853","","","كتاب البيوع والأقضية"
"22854","(۲۲۸۵۴) حَدَّثَنَا شَرِیکٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُبْدَأُ بِالْکَفَنِ قَبْلَ الدَّیْنِ۔","","Musannaf Ibn Abi Shaybah 22854","","","كتاب البيوع والأقضية"
"22855","(۲۲۸۵۵) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ وَإِسْمَاعِیلَ ، عَنِ الْحَسَنِ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 22855","","","كتاب البيوع والأقضية"
"22856","(۲۲۸۵۶) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : یُبْدَأُ بِالْکَفَنِ قَبْلَ الدَّیْنِ۔","","Musannaf Ibn Abi Shaybah 22856","","","كتاب البيوع والأقضية"
"22857","(۲۲۸۵۷) حَدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنْ حَجَّاجٍ ، عَنْ عَبْدِ الْکَرِیم ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : یُبْدَأُ بِالْکَفَنِ ، ثُمَّ الدَّیْنِ ، ثُمَّ الْوَصِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 22857","","","كتاب البيوع والأقضية"
"22858","(۲۲۸۵۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ عُمَیْرِ بْنِ سَعِیدٍ ، قَالَ : کُنَّا نُعْطِی أَہْلَ الْغَنَمِ عَلَی أَنْ یُعْطُونَا کَذَا وَکَذَا مِنَ الْجُبْنِ ، وَکَذَا وَکَذَا مِنَ السَّمْنِ ، وَکَذَا وَکَذَا مِنَ الْمَصْلِ ، فَسَأَلْت عَلْقَمَۃَ وَمَسْرُوقًا وَعَبْدَ الرَّحْمَن بْنَ أَبِی لَیْلَی ؟ فَکُلُّہُمْ نَہَانِی عَنْہُ۔","","Musannaf Ibn Abi Shaybah 22858","","","كتاب البيوع والأقضية"
"22859","(۲۲۸۵۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عُمَیْرِ بْنِ سَعِیدٍ : أَنَّ رَجُلاً سَأَلَ عَبِیْدَۃَ ، وَغَیْرَ وَاحِدٍ مِنْ أَصْحَابِ عَبْدِ اللہِ عَنْہُ ؟ فَکَرِہُوہُ۔","","Musannaf Ibn Abi Shaybah 22859","","","كتاب البيوع والأقضية"
"22860","(۲۲۸۶۰) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَتَفَرَّقُ بَیِّعَانِ إلاَّ عَنْ تَرَاضٍ۔ (بیہقی ۲۷۱)","","Musannaf Ibn Abi Shaybah 22860","","","كتاب البيوع والأقضية"
"22861","(۲۲۸۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی غِیاث ، عَنْ أَبِی زُرْعَۃَ : أَنَّہُ بَاعَ فَرَسًا فَخَیَّرَ صَاحِبَہُ بَعْدَ الْبَیْعِ ، ثُمَّ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یَقُولُ : الْبَیْعُ عَنْ تَرَاضٍ۔ (ابوداؤد ۳۴۵۲۔ ترمذی ۱۲۴۸)","Hasan","Musannaf Ibn Abi Shaybah 22861","","","كتاب البيوع والأقضية"
"22862","(۲۲۸۶۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : مَا کَانَ التَّخْیِیرُ إلاَّ بَعْدَ الْبَیْعِ ، قَالَ : وَبَایَعَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلاً مِنَ الأَعْرَابِ فَخَیَّرَہُ بَعْدَ الْبَیْعِ۔ (ابن ماجہ ۲۱۸۴۔ بیہقی ۲۷۰)","","Musannaf Ibn Abi Shaybah 22862","","","كتاب البيوع والأقضية"
"22863","(۲۲۸۶۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ سُلَیْمانَ ، عَنْ طَاوُوسٍ : أَنَّہُ کَانَ یَحْلِفْ مَا التَّخْیِیرُ إلاَّ بَعْدَ الرِّضَا۔","","Musannaf Ibn Abi Shaybah 22863","","","كتاب البيوع والأقضية"
"22864","(۲۲۸۶۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا قَاسِمُ الْجُعْفِیُّ ، عَنْ أَبِیہِ ، أنَّ مَیْمُونَ بْنَ مِہْرَانَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْبَیْعُ عَنْ تَرَاضٍ ، وَالْخِیَارُ بَعْدَ الصَّفْقَۃِ ، وَلاَ یَحِلُّ لِمُسْلِمٍ أنْ یَغْبِنَ مُسْلِمًا۔n(عبدالرزاق ۱۴۲۶۴)","Da'if","Musannaf Ibn Abi Shaybah 22864","","","كتاب البيوع والأقضية"
"22865","(۲۲۸۶۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنِ ابْنِ عَوْنٍ، عَنْ مُحَمَّدٍ: أَنَّ الْحَسَنَ بْنَ عَلِیٍّ اشْتَرَی مِنِ امْرَأَتِہِ نَصِیبَہَا مِنْ مِیرَاثِہِ، ثُمَّ قَالَ : إذَا أَنَا مِتُّ فَخَیِّرُوہَا۔","Sahih","Musannaf Ibn Abi Shaybah 22865","","","كتاب البيوع والأقضية"
"22866","(۲۲۸۶۶) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ : فِی رَجُلٍ اسْتَأْجَرَ بَیْتًا أَشْہُرًا ، أوْ قَالَ إلَی أَجَلٍ ، فَسَکَنَہُ ، ثُمَّ أَرَادَ أَنْ یَخْرُجَ مِنْہُ ، فَقَالَ : إذَا أَتَی بِالْمَفَاتِیحِ فَقَدْ بَرِیئَ ، وَعَلَیْہِ أَجْرُ مَا سَکَنَ۔","","Musannaf Ibn Abi Shaybah 22866","","","كتاب البيوع والأقضية"
"22867","(۲۲۸۶۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، بِنَحْوٍ مِنْ حَدِیثِ عَبَّادٍ۔","","Musannaf Ibn Abi Shaybah 22867","","","كتاب البيوع والأقضية"
"22868","(۲۲۸۶۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، قَالَ : عَلَیْہِ أَجْرُ مَا سَکَنَ۔","","Musannaf Ibn Abi Shaybah 22868","","","كتاب البيوع والأقضية"
"22869","(۲۲۸۶۹) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ سَلْمٍ ، قَالَ : سَأَلْتُ مُحَمَّدَ بْنَ سِیرِینَ عَنْ رَجُلٍ بَاعَ سِلْعَۃً إلَی شَہْرَیْنِ وَشَرَطَ عَلَی الْمُشْتَرِی : إِنْ بَاعَہَا قَبْلَ الشَّہْرَیْنِ أَنْ یَنْقُدَہُ ؟ قَالَ : لاَ أَعْلَمُ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 22869","","","كتاب البيوع والأقضية"
"22870","(۲۲۸۷۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : فِی الرَّجُلِ یَشْتَرِی الدَّارَ فَیَقُولُ الْمُشْتَرِی لِلْبَائِعِ : مَتَی ما جِئْت بِثَمَنِہَا فَہِیَ رَدٌّ عَلَیْک ، قَالَ : یَبْطُلُ شَرْطُہُ وَیَجُوزُ عَلَیْہِ الْبَیْعُ۔","","Musannaf Ibn Abi Shaybah 22870","","","كتاب البيوع والأقضية"
"22871","(۲۲۸۷۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کُلُّ شَرْطٍ فِی بَیْعٍ فَالْبَیْعُ یَہْدِمُہُ۔","","Musannaf Ibn Abi Shaybah 22871","","","كتاب البيوع والأقضية"
"22872","(۲۲۸۷۲) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ طَارِقٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ رَافِعِ بْنِ خَدِیجٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّمَا یَزْرَعُ ثَلاَثَۃٌ : رَجُلٌ مُنِحَ أَرْضًا فَہُوَ یَزْرَعُ مَا مُنِحَ ، وَرَجُلٌ لہُ أَرْضٌ فَہُوَ یَزْرَعُہا ، وَرَجُلٌ اسْتَکْرَی أَرْضًا بِذَہَبٍ أَوْ فِضَّۃٍ۔ (ابوداؤد ۳۳۹۳۔ ابن ماجہ ۲۴۴۹)","","Musannaf Ibn Abi Shaybah 22872","","","كتاب البيوع والأقضية"
"22873","(۲۲۸۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ رَبِیعَۃَ بْنِ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ حَنْظَلَۃَ بْنِ قَیْسٍ ، قَالَ : سَأَلْتُ رَافِعَ بْنَ خَدِیجٍ عَنْ کِرَاء الأَرْضِ الْبَیْضَائِ بِالذَّہَبِ وَالْفِضَّۃِ ؟ فَقَالَ : حَلاَلٌ لاَ بَأْسَ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 22873","","","كتاب البيوع والأقضية"
"22874","(۲۲۸۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ اللہِ ، قَالَ : سَأَلْتُ سَعْدًا عَنْ کِرَاء الأَرْضِ بِالذَّہَبِ وَالْفِضَّۃِ ؟ فَقَالَ : لاَ بَأْسَ بِہِ ، ذَلِکَ قَرْضُ الأَرْضِ۔","Da'if","Musannaf Ibn Abi Shaybah 22874","","","كتاب البيوع والأقضية"
"22875","(۲۲۸۷۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : لاَ بَأْسَ بِکِرَاء الأَرْضِ بِالذَّہَبِ وَالْفِضَّۃِ۔","","Musannaf Ibn Abi Shaybah 22875","","","كتاب البيوع والأقضية"
"22876","(۲۲۸۷۶) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لاَ بَأْس بِکِرَائِ الأَرْضِ الْبَیْضَائِ بِالذَّہَبِ وَالْفِضَّۃِ۔","","Musannaf Ibn Abi Shaybah 22876","","","كتاب البيوع والأقضية"
"22877","(۲۲۸۷۷) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، قَالَ : کَانَ سَالِمٌ وَسَعِیدُ بْنُ الْمُسَیَّبِ وَعُرْوَۃُ وَالزُّہْرِیُّ لاَ یَرَوْنَ بِکِرَائِ الأَرْضِ الْبَیْضَائِ بِالذَّہَبِ وَالْفِضَّۃِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 22877","","","كتاب البيوع والأقضية"
"22878","(۲۲۸۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إنَّ أَمْثَلَ مَا أَنْتُمْ صَانِعُونَ أَنْ تَسْتَأْجِرُوا الأَرْضَ الْبَیْضَائَ بِالذَّہَبِ وَالْفِضَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 22878","","","كتاب البيوع والأقضية"
"22879","(۲۲۸۷۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی الْفَضْلِ ، عَنْ سَالِمٍ ، قَالَ : أَمَّا الأَرْضُ الْبَیْضَائُ فَإِنَّا نَکْرِیہَا بِالذَّہَبِ وَالْوَرِقِ۔","","Musannaf Ibn Abi Shaybah 22879","","","كتاب البيوع والأقضية"
"22880","(۲۲۸۸۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَسْتَأْجِرَ الرَّجُل الأَرْضُ الْبَیْضَائُ بِالذَّہَبِ وَالْوَرِقِ ، وَمَا أَرَادَ أنْ یسْتَأْجِرَہَا بِہِ۔","","Musannaf Ibn Abi Shaybah 22880","","","كتاب البيوع والأقضية"
"22881","(۲۲۸۸۱) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ حَجَّاجِ بْنِ دِینَارٍ ، قَالَ : سَأَلْتُ أَبَا جَعْفَرٍ عَنِ الأَرْضِ الْبَیْضَائِ لَیْسَ فِیہَا شَجَرٌ وَلاَ زَرْعٌ نَسْتَأْجِرُہَا بِالدَّرَاہِمِ وَالدَّنَانِیرِ ؟ قَالَ : ہُوَ حَسَنٌ ، کَذَلِکَ نَفْعَلُ بِالْمَدِینَۃِ۔","","Musannaf Ibn Abi Shaybah 22881","","","كتاب البيوع والأقضية"
"22882","(۲۲۸۸۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ إبْرَاہِیمَ بْنِ سَعْدٍ ، عَنْ مُحَمَّدِ بْنِ عِکْرِمَۃَ بْنِ الْحَارِثِ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَبِیبَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ سَعْدٍ ، قَالَ : کُنَّا نُکْرِی الأَرْضَ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمَا عَلَی السَّواقِیِّ مِنَ الزَّرْعِ ، وَمَا سَعِدَ بِالْمَائِ مِنْہَا ، فَنَہَانَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ ذَلِکَ ، وَأَمَرَنَا أَنْ نُکْرِیہا بِالذَّہَبِ وَالْوَرِقِ۔ (ابوداؤد ۳۳۸۴۔ احمد ۱/۱۷۸)","Da'if","Musannaf Ibn Abi Shaybah 22882","","","كتاب البيوع والأقضية"
"22883","(۲۲۸۸۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ عَنْ یَتِیمٍ لِی لَہُ أَرْضٌ ؟ فَقَالَ : إِنْ کُنْت مُکْرِیہَا فَاکْرِہَا بِذَہَبٍ وَ فِضَّۃٍ۔","","Musannaf Ibn Abi Shaybah 22883","","","كتاب البيوع والأقضية"
"22884","(۲۲۸۸۴) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ مُعَاوِیَۃَ بْنِ إِسْحَاقَ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنْ إجَارَۃِ الأَرْضِ ؟ فَقَالَ: لاَ بَأْسَ بِہَا۔","","Musannaf Ibn Abi Shaybah 22884","","","كتاب البيوع والأقضية"
"22885","(۲۲۸۸۵) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَطَائٍ ، عَنْ رَافِعِ بْنِ خَدِیجٍ ، رَفَعَہُ ، قَالَ : مَنْ زَرَعَ فِی أَرْضِ قَوْمٍ بِغَیْرِ إذْنِہِمْ فَلَیْسَ لَہُ مِنَ الزَّرْعِ شَیْئٌ ، وَتُرَدُّ عَلَیْہِ نَفَقَتُہُ۔ (ابوداؤد ۳۳۹۶۔ ترمذی ۱۳۶۶)","","Musannaf Ibn Abi Shaybah 22885","","","كتاب البيوع والأقضية"
"22886","(۲۲۸۸۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنِ الْحَسَنِ بْنِ مُحَمَّدٍ ، قَالَ : مَرَّ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی زَرْعٍ یَہْتَزُّ ، فَسَأَلَ عَنْہ ، فَقَالُوا : رَجُلٌ زَرَعَ أَرْضًا بِغَیْرِ أذْنِ صَاحِبِہَا ، فَأَمَرَہُ أَنْ یَرُدَّہَا وَیَأْخُذَ نَفَقَتَہُ۔ (ابوداؤد ۳۳۹۲۔ طبرانی ۴۲۶۷)","Hasan","Musannaf Ibn Abi Shaybah 22886","","","كتاب البيوع والأقضية"
"22887","(۲۲۸۸۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَبِی جَعْفَرٍ الْخَطْمِیِّ ، قَالَ : بَعَثَنِی عَمِّی وَغُلاَمًا لَہُ إلَی سَعِیدِ بْنِ الْمُسَیَّبِ فَقَالَ : مَا تَقُولُ فِی الْمُزَارَعَۃِ ؟ قَالَ : کَانَ ابْنُ عُمَرَ لاَ یَرَی بِہَا بَأْسًا حَتَّی حُدِّثَ عَنْ رَافِعِ بْنِ خَدِیجٍ فِیہَا حَدِیثًا ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَتَی عَلَی بَنِی حَارِثَۃَ فَرَأَی زَرْعًا فِی أَرْضِ ظُہَیْرٍ ، فَقَالَ : مَا أَحْسَنَ زَرْعُ ظُہَیْرٍ ، فَقَالُوا : إِنَّہُ لَیْسَ لِظُہَیْرٍ ، قَالَ : أَلَیْسَتِ الأَرْضُ أَرْضَ ظُہَیْرٍ ؟ قَالُوا : بَلَی وَلَکِنَّہُ زَارَعَ فُلاَنًا ، قَالَ : فَرُدُّوا عَلَیْہِ نَفَقَتَہُ وَخُذُوا زَرْعَکُمْ ، قَالَ رَافِعٌ : فَرَدَدْنَا عَلَیْہِ نَفَقَتَہُ وَأَخَذْنَا زَرْعَنَا ، قَالَ سَعِیدٌ : أَفْقِرْ أَخَاک ، أَوْ أَکْرِہْ بِوَرِقٍ۔","Sahih","Musannaf Ibn Abi Shaybah 22887","","","كتاب البيوع والأقضية"
"22888","(۲۲۸۸۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَش ، عَنْ إِبْرَاہِیمَ ، عَن شُرَیْحٍ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ الْیَہُودِیِّ وَالنَّصْرَانِیِّ إلاَّ فِی سَفَرٍ ، وَلاَ تَجُوزُ إلاَّ عَلَی وَصِیَّۃٍ۔","","Musannaf Ibn Abi Shaybah 22888","","","كتاب البيوع والأقضية"
"22889","(۲۲۸۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، عَنِ الشَّعْبِیِّ : أَنَّ رَجُلاً مِنْ خَثْعَمَ تُوُفِّیَ بِدَقُوقَا فَلَمْ یُشْہِدْ عَلَی وَصِیَّتِہِ إلاَّ نَصْرَانِیَّینِ ، فَأَحْلَفَہُمَا أَبُو مُوسَی بَعْدَ الْعَصْرِ بِاللَّہِ مَا خَانَا ، وَلاَ کَتَمَا ، وَلاَ بَدَّلاَ ، وَإِنَّہَا لَوَصِیَّتُہُ فَأَجَازَ شَہَادَتَہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 22889","","","كتاب البيوع والأقضية"
"22890","(۲۲۸۹۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبِیدَۃَ : {أَوْ آخَرَانِ مِنْ غَیْرِکُمْ} قَالَ : مِنْ أَہْلِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 22890","","","كتاب البيوع والأقضية"
"22891","(۲۲۸۹۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، {أَوْ آخَرَانِ مِنْ غَیْرِکُمْ} قَالَ : مِنْ غَیْرِ أَہْلِ دِینِکُمْ۔","","Musannaf Ibn Abi Shaybah 22891","","","كتاب البيوع والأقضية"
"22892","(۲۲۸۹۲) حَدَّثَنَا ہُشَیْمٌ ، عَنِ التَّیْمِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : أَنَّہُ قَالَ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 22892","","","كتاب البيوع والأقضية"
"22893","(۲۲۸۹۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا التَّیْمِیِّ ، عَنْ أبی مجلز : أَنَّہُ قَالَ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 22893","","","كتاب البيوع والأقضية"
"22894","(۲۲۸۹۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَمَّنْ سَمِعَ سَعِیدَ بْنَ جُبَیْرٍ یَقُولُ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 22894","","","كتاب البيوع والأقضية"
"22895","(۲۲۸۹۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : حَدَّثَنَا منصور وغیر واحد ، عن الحسن قَالَ : من غیر عشائرکم۔","","Musannaf Ibn Abi Shaybah 22895","","","كتاب البيوع والأقضية"
"22896","(۲۲۸۹۶) حَدَّثَنَا ہُشَیْمٌ، عَنْ ہِشَامٍ، عَنِ ابْنِ سِیرِینَ ، قَالَ: سَأَلْتُ عَبِیدَۃَ عَنْ ذَلِکَ؟ فَقَالَ: مِنْ غَیْرِ أَہْلِ دِینِکُمْ۔","","Musannaf Ibn Abi Shaybah 22896","","","كتاب البيوع والأقضية"
"22897","(۲۲۸۹۷) حَدَّثَنَا أَبُودَاوُدَ، عَنِ الْحَکَمِ بْنِ عَطِیَّۃَ، عَنِ ابْنِ سِیرِینَ {أَوْ آخَرَانِ مِنْ غَیْرِکُمْ} قَالَ: مِنْ سَائِرِ الْمِلَلِ۔","","Musannaf Ibn Abi Shaybah 22897","","","كتاب البيوع والأقضية"
"22898","(۲۲۸۹۸) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ عَبْدِ الرَّحْمَنِ الْجُمَحیُّ ، عَنِ الزُّہْرِیِّ : فِی قولہ تعالی: {أَوْ آخَرَانِ مِنْ غَیْرِکُمْ} قَالَ : ہُمْ مِنْ أَہْلِ الْمِیرَاثِ۔","","Musannaf Ibn Abi Shaybah 22898","","","كتاب البيوع والأقضية"
"22899","(۲۲۸۹۹) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : مَنِ اکْتَرَی عَلَی أَنَّہُ ضَامِنٌ فَلَیْسَ بِضَامِنٍ۔","","Musannaf Ibn Abi Shaybah 22899","","","كتاب البيوع والأقضية"
"22900","(۲۲۹۰۰) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ ، أَوْ قَالَ لَہُ إنْسَانٌ : یَسْتَکْرِی الرَّجُلُ بِضَمَان ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 22900","","","كتاب البيوع والأقضية"
"22901","(۲۲۹۰۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ : أَنَّہُ کَانَ لاَ یَرَی الْکِرَائَ وَالضَّمَانَ۔","","Musannaf Ibn Abi Shaybah 22901","","","كتاب البيوع والأقضية"
"22902","(۲۲۹۰۲) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، قَالَ : سَأَلْتُہ عَنِ الطِّینِ الَّذِی یُصْبَغُ بِہِ الثِّیَابُ اثْنَیْنِ بِوَاحِدٍ ؟ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 22902","","","كتاب البيوع والأقضية"
"22903","(۲۲۹۰۳) حَدَّثَنَا عَبْدُالسَّلاَمِ بْنُ حَرْبٍ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ: فِی رَجُلٍ أَسْلَمَ إلَی رَجُلٍ فِی طَعَامٍ حَدِیثٍ، فَلَمْ یَلْقَہُ حَتَّی صَارَ حَدِیثُ ذَلِکَ الْعَامِ عَتِیقًا ، قَالَ لَہُ : حدِیثُ سَنَتِہِ الَّتِی لَقِیَہُ فِیہَا ، وَکَانَ شُرَیْحٌ یَقُولُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 22903","","","كتاب البيوع والأقضية"
"22904","(۲۲۹۰۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، عَن شُرَیْحٍ ، قَالَ : یُعْطِیہِ حَدِیثَ سَنَتِہِ الَّتِی یَتَقَاضَاہُ فِیہَا۔","","Musannaf Ibn Abi Shaybah 22904","","","كتاب البيوع والأقضية"
"22905","(۲۲۹۰۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ جَابِرٍ ، عَنِ الْقَاسِمِ ، عَنْ شُرَیْحٍ وَعَبْدِ اللہِ : کَانَا یَقُولاَنِ فِی رَجُلٍ بَنَی فِی فِنَائِ قَوْمٍ بِغَیْرِ إذْنِہِمْ : أَنَّ لَہُ النَّقْضَ ، وَإِنْ بَنَی بِإِذْنِہِمْ فَلَہُ النَّفَقَۃُ۔","","Musannaf Ibn Abi Shaybah 22905","","","كتاب البيوع والأقضية"
"22906","(۲۲۹۰۶) حَدَّثَنَا حَفْصٌ ، أَوْ حُدِّثْتُ عَنْہُ ، عَنْ أَشْعَثَ ، عَنْ عَلِیِّ بْنِ عُبَیْدِ اللہِ الْغَطَفَانِیِّ ، عَنْ عَلِیٍّ بِنَحْوِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 22906","","","كتاب البيوع والأقضية"
"22907","(۲۲۹۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ شُرَیْحٍ ، قَالَ : مَنْ بَنَی فِی حَقِّ قَوْمٍ بِغَیْرِ إذْنِہِمْ فَلَہُ نَقْضُہُ ، وَمَنْ بَنَی فِی حَقِّ قَوْمٍ بِإِذْنِہِمْ فَلَہُ نَفَقَتُہُ۔","","Musannaf Ibn Abi Shaybah 22907","","","كتاب البيوع والأقضية"
"22908","(۲۲۹۰۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، قَالَ : سَأَلْتُ عَامِرًا عَنْ رَجُلٍ أَعَارَ جَارًا لَہُ حَائِطًا فَبَنَی عَلَیْہِ ، فَأَرَادَ أَنْ یَقْلَعَ بِنَائَہُ ، قَالَ : یَغْرَمُ لِصَاحِبِ الْحَائِطِ مَا أَنْفَقَ۔","","Musannaf Ibn Abi Shaybah 22908","","","كتاب البيوع والأقضية"
"22909","(۲۲۹۰۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ ہِشَامٍ أَبِی کُلَیْبٍ ، عَنْ أبْرَاہِیمَ : أَنَّ رَجُلاً أَعَارَ رَجُلاً حَائِطًا ، فَبَنَی عَلَیْہِ ، فَأَرَادَ أَنْ یَقْلَعَ بِنَائَہُ ، فَقَالَ شُرَیْحٌ لِصَاحِبِ الْحَائِطِ : ضَعْ رِجْلَک حَیْثُ شِئْت یَعْنِی یَقْلَعُ بِنَائَہُ۔","","Musannaf Ibn Abi Shaybah 22909","","","كتاب البيوع والأقضية"
"22910","(۲۲۹۱۰) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَیُّوبَ ، عَنْ قَتَادَۃَ وَأَبِی ہَاشِمٍ ، قَالاَ : مَنْ أَذِنَ لِرَجُلٍ فِی بِنَائٍ ثُمَّ أَرَادَ أَنْ یُخْرِجَہُ فَلَہُ قِیمَۃُ الْبِنَائِ۔","","Musannaf Ibn Abi Shaybah 22910","","","كتاب البيوع والأقضية"
"22911","(۲۲۹۱۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ : أَنَّ رَجُلاً أَعَارَ رَجُلاً حَائِطًا فَبَنَی عَلَیْہِ ، فَقَالَ شُرَیْحٌ لِصَاحِبِ الْحَائِطِ : اُرْدُدْ عَلَیْہِ نَفَقَتَہُ۔","","Musannaf Ibn Abi Shaybah 22911","","","كتاب البيوع والأقضية"
"22912","(۲۲۹۱۲) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ : أَنَّہُ کَانَ یَقُولُ : إذَا اخْتَلَفُوا فِی النَّقْدِ لَکَ الْجَیِّدُ وَالْحَسَنُ وَالطَّیِّبُ ، فَإِنْ ذَہَبَ الأَعْلَی فَاتْرُکِ الأَسْفَلَ۔","","Musannaf Ibn Abi Shaybah 22912","","","كتاب البيوع والأقضية"
"22913","(۲۲۹۱۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ أَبِی الْجَرَّاحِ ، قَالَ : حدَّثَنِی مُوسَی بْنُ سَالِمٍ ، قَالَ : لَمَّا أَجْلَی الْحَجَّاجُ أَہْلَ الأَرْضِ أَتَتْنِی امْرَأَۃٌ بِکِتَابٍ زَعَمَتْ أَنَّ الَّذِی أُعْتِقَ أَبُوہَا : ہَذَا مَا اشْتَرَی طَلْحَۃُ بْنُ عُبَیْدِ اللہِ مِنْ فُلاَنِ بْنِ فُلاَنٍ ، اشْتَرَی مِنْہُ فَتَاہُ دِینَارًا أَوْ دِرْہَمًا بِخَمْسِمِئَۃِ دِرْہَمٍ ، بِالْجَیِّدِ وَالطَّیِّبِ ، وَالْحَسَنِ۔","Hasan","Musannaf Ibn Abi Shaybah 22913","","","كتاب البيوع والأقضية"
"22914","(۲۲۹۱۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَابِسٍ ، عَنْ أَبِیہِ ، قَالَ: اشْتَرَی حُذَیْفَۃُ مِنْ رَجُلَیْنِ مِنَ النَّخَعِ نَاقَۃً ، وشرط لہما من النقد رضاہما ، فَجَائَ بِہِمَا فِی مَنْزِلِہِ فَأَخْرَجَ لَہُمَا کِیسًا فأفسلا عَلَیْہِ ، ثم أخرج لہما کیسًا فأفسلا علیہ ، فَقَالَ حُذَیْفَۃُ : إنِّی بِاللَّہِ مِنْکُمَا ، إنِّی سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ شَرَطَ عَلَی صَاحِبِہِ شَرْطًا لَمْ یَفِ لَہُ بِہِ ، کَانَ کَالْمُدْلِی بجارہ إلَی غَیْرِ منعۃ۔n(احمد ۵/۴۰۴)","","Musannaf Ibn Abi Shaybah 22914","","","كتاب البيوع والأقضية"
"22915","(۲۲۹۱۵) حَدَّثَنَا شَرِیکٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: إذَا دَفَعَ الرَّجُلُ إلَی الْمَلاَّحِ الطَّعَامَ، فَہُوَ ضَامِنٌ لِمَا نَقَصَ۔","","Musannaf Ibn Abi Shaybah 22915","","","كتاب البيوع والأقضية"
"22916","(۲۲۹۱۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہ ، عَنْ عَطَائٍ : فِی رَجُلٍ یُکَارِی الطَّعَامَ إلَی أَرْضٍ بِکَیْلٍ ، إِنْ زَادَ فَلَہُمْ ، وَإِنْ نَقَصَ فَعَلَیْہِمْ ، قَالَ : إذَا رَضِیَ بِذَلِکَ الأَکْرِیَائُ وَأَقَرُّوا بِہِ فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 22916","","","كتاب البيوع والأقضية"
"22917","(۲۲۹۱۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ : فِی الرَّجُلِ یَسْتَأْجِرُ الْمَلاَّحَ عَلَی أَنَّ عَلَیْہِ النُّقْصَانَ ، وَالزِّیَادَۃَ لَہُ ، قَالَ : الزِّیَادَۃُ لِصَاحِبِ الطَّعَامِ ، وَالنُّقْصَانُ عَلَی الْمَلاَّحِ۔","","Musannaf Ibn Abi Shaybah 22917","","","كتاب البيوع والأقضية"
"22918","(۲۲۹۱۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، قَالَ : سَمِعْتُ الْحَسَنَ وَسُئِلَ عَنِ الْمَلاَّحِ یَحْمِلُ الطَّعَامَ ؟ فَقَالَ : الزِّیَادَۃُ لَہُ وَعَلَیْہِ النُّقْصَانُ۔","","Musannaf Ibn Abi Shaybah 22918","","","كتاب البيوع والأقضية"
"22919","(۲۲۹۱۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عَبْدِ رَبِّہِ ، عَنْ أَبِی عِیَاضٍ ، عَنْ عُثْمَانَ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِبَیْعِ کُلِّ شَیْئٍ قَبْلَ أَنْ یَقْبِضَ مَا خَلاَ الْکَیْلَ وَالْوَزْنَ۔","Da'if","Musannaf Ibn Abi Shaybah 22919","","","كتاب البيوع والأقضية"
"22920","(۲۲۹۲۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 22920","","","كتاب البيوع والأقضية"
"22921","(۲۲۹۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 22921","","","كتاب البيوع والأقضية"
"22922","(۲۲۹۲۲) حَدَّثَنَا عَبْدُ الأعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، قَالَ : إذَا اشْتَرَی الرَّجُلُ الشَّیْئَ مِمَّا لاَ یُکَالُ وَلاَ یُوزَنُ، فَلاَ بَأْسَ أَنْ یَبِیعَہُ قَبْلَ أَنْ یَقْبِضَہُ۔","","Musannaf Ibn Abi Shaybah 22922","","","كتاب البيوع والأقضية"
"22923","(۲۲۹۲۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِیہِ ، عَنْ إبْرَاہِیمَ : فِی الرَّجُلِ یَبِیعُ الْبَیْعَ قَبْلَ أَنْ یَقْبِضَہُ ، قَالَ : إنَّمَا یَقُولُ ذَلِکَ فِی الْکَیْلِ وَالْوَزْنِ۔","","Musannaf Ibn Abi Shaybah 22923","","","كتاب البيوع والأقضية"
"22924","(۲۲۹۲۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرٍو ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إنَّمَا کَانَ النَّہْیُ فِیمَا یُکَالُ وَیُوزَنُ ، وَلاَ أَحْسِبُ مَا سِوَی ذَلِکَ إلأَمِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 22924","","","كتاب البيوع والأقضية"
"22925","(۲۲۹۲۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 22925","","","كتاب البيوع والأقضية"
"22926","(۲۲۹۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، قَالاَ : کُلُّ شَیْئٍ لاَ یُکَالُ وَلاَ یُوزَنُ فَلاَ بَأْسَ أَنْ یَبِیعَہُ قَبْلَ أَنْ یَقْبِضَہُ۔","","Musannaf Ibn Abi Shaybah 22926","","","كتاب البيوع والأقضية"
"22927","(۲۲۹۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، قَالَ : قُلْتُ لِلْقَاسِمِ بْنِ مُحَمَّدٍ : الرَّجُلُ یَشْتَرِی الْمَتَاعَ وَہُوَ غَائِبٌ ، أَیَبِیعُہُ قَبْلَ أَنْ یَقْدَمَ ؟ قَالَ الْقَاسِمُ : کُنَّا نَقُولُ : حَتَّی یَقْدَمَ۔","","Musannaf Ibn Abi Shaybah 22927","","","كتاب البيوع والأقضية"
"22928","(۲۲۹۲۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، سَمِعَ مَالِکَ بْنَ أَوْسِ بْنِ الْحَدَثَانِ یَقُولُ : سَمِعْت عُمَرَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الذَّہَبُ بِالْوَرِقِ رِبًا إلاَّ ہَائَ وَہَائَ ، وَالْفِضَّۃُ بِالْفِضَّۃِ رِبًا إلاَّ ہَائَ وَہَائَ ، وَالشَّعِیرُ بِالشَّعِیرِ رِبًا إلاَّ ہَائَ وَہَائَ ، وَالتَّمْرُ بِالتَّمْرِ رِبًا إلاَّ ہَائَ وَہَائَ۔ (بخاری ۲۱۳۴۔ مسلم ۱۲۱۰)","Sahih","Musannaf Ibn Abi Shaybah 22928","","","كتاب البيوع والأقضية"
"22929","(۲۲۹۲۹) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الأَشْعَث ، قَالَ : کُنَّا فِی غَزَاۃٍ وَعَلَیْنَا مُعَاوِیَۃُ ، فَأَصَبْنَا ذَہَبًا وَفِضَّۃً ، فَأَمَرَ مُعَاوِیَۃُ رَجُلاً یَبِیعُہَا النَّاسَ فِی أُعْطِیَّاتِہِمْ ، فَسَارَعَ النَّاسُ فِیہَا ، فَقَامَ عُبَادَۃُ فَنَہَاہُمْ فَرَدُّوہَا ، فَأَتَی الرَّجُلُ مُعَاوِیَۃَ فَشَکَا إلَیْہِ ، فَقَامَ مُعَاوِیَۃُ خَطِیبًا فَقَالَ : مَا بَالُ رِجَالٍ یُحَدِّثُونَ عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَحَادِیثَ یَکْذِبُونَ فِیہَا ، لَمْ نَسْمَعْہَا ؟ فَقَامَ عُبَادَۃُ ، فَقَالَ : وَاللَّہِ لَنُحَدِّثَنَّ عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَإِنْ کَرِہَ مُعَاوِیَۃُ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَبِیعُوا الذَّہَبَ بِالذَّہَبِ ، وَلاَ الْفِضَّۃَ بِالْفِضَّۃِ ، وَلاَ الشَّعِیرَ بِالشَّعِیرِ ، وَلاَ التَّمْرَ بِالتَّمْرِ ، وَلاَ الْمِلْحَ بِالْمِلْحِ إلاَّ مِثْلاً بِمِثْلٍ سَوَائً بِسَوَائٍ عَیْنًا بِعَیْنٍ۔ (مسلم ۱۲۱۰۔ ابوداؤد ۳۳۴۲)","Sahih","Musannaf Ibn Abi Shaybah 22929","","","كتاب البيوع والأقضية"
"22930","(۲۲۹۳۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ عبْدِ اللہِ بْنِ قُسَیْطٍ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : قَسَمَ فِینَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ طَعَامًا مِنَ التَّمْرِ مُخْتَلِفًا بَعْضُہُ أَفْضَلُ مِنْ بَعْضٍ ، فَذَہَبْنَا نَتَزَایَدُ فِیہِ بَیْنَنَا ، فَنَہَانَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلاَّ کَیْلاً بِکَیْلٍ۔n(بخاری ۲۰۸۰۔ مسلم ۱۲۱۶)","Hasan","Musannaf Ibn Abi Shaybah 22930","","","كتاب البيوع والأقضية"
"22931","(۲۲۹۳۱) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ نَافِعٍ ، عَنْ أَبِی سَعِیدٍ : أَنَّہُ سَمِعَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : الدِّینَارُ بِالدِّینَارِ وَالدِّرْہَمُ بِالدِّرْہَمِ لَیْسَ بَیْنَہا فَضْلٌ ، وَلاَ یُبَاعُ عَاجِلٌ بِآجِلٍ۔ (بخاری ۲۱۷۸)","Sahih","Musannaf Ibn Abi Shaybah 22931","","","كتاب البيوع والأقضية"
"22932","(۲۲۹۳۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ نَافِعٍ ، عَنْ أَبِی سَعِیدٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ۔ (نسائی ۶۱۶۳)","Sahih","Musannaf Ibn Abi Shaybah 22932","","","كتاب البيوع والأقضية"
"22933","(۲۲۹۳۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَصْلُحُ دِرْہَمٌ بِدِرْہَمَیْنِ ، وَلاَ صَاعٌ بِصَاعَیْنِ ، الدِّینَارُ بِالدِّینَارِ وَالدِّرْہَمُ بِالدِّرْہَمِ۔ (بخاری ۲۰۸۰۔ مسلم ۱۲۱۶)","Hasan","Musannaf Ibn Abi Shaybah 22933","","","كتاب البيوع والأقضية"
"22934","(۲۲۹۳۴) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ فُضَیْلِ بْنِ غَزْوَانَ ، عَنِ ابْنِ أَبِی نُعْمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْفِضَّۃُ بِالْفِضَّۃِ وَزْنٌ بِوَزْنٍ مِثْلٌ بِمِثْلٍ ، وَالذَّہَبُ بِالذَّہَبِ وَزْنٌ بِوَزْنٍ مِثْلٌ بِمِثْلٍ ، فَمَا زَادَ ، فَہُوَ رِبًا ، وَلاَ تُبَاعُ ثَمَرَۃٌ حَتَّی یَبْدُوَ صَلاَحُہَا۔ (احمد ۲/۲۶۲)","Sahih","Musannaf Ibn Abi Shaybah 22934","","","كتاب البيوع والأقضية"
"22935","(۲۲۹۳۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ فُضَیْلِ بْنِ غَزْوَانَ ، قَالَ : حدَّثَنِی أَبُو دِہْقَانَۃَ ، قَالَ : کُنْتُ جَالِسًا عِنْدَ عَبْدِ اللہِ بْنِ عُمَرَ فَقَالَ : أَتَی رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ضَیْفٌ فَقَالَ لِبِلاَلٍ : ائْتِنَا بِطَعَامٍ ، فَذَہَبَ بِلاَلٌ إلَی صَاعَیْنِ مِنْ تَمْرٍ فَاشْتَرَی بِہَا صَاعًا مِنْ تَمْرٍ جَیِّدٍ ، وَکَانَ تَمْرُہُمْ دُونًا ، فَأَعْجَبَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ التَّمْرُ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مِنْ أَیْنَ ہَذَا التَّمْرُ ؟ فَأَخْبَرَہُ أَنَّہُ بَدَّلَ صَاعَیْنِ بِصَاعٍ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : رُدَّ عَلَیْنَا تَمْرَنَا۔ (احمد ۲/۲۱۔ ابویعلی ۵۷۱۰)","Da'if","Musannaf Ibn Abi Shaybah 22935","","","كتاب البيوع والأقضية"
"22936","(۲۲۹۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ فُضَیْلٍ ، عَنْ أَبِی دِہْقَانَۃَ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِثْلہ۔","Da'if","Musannaf Ibn Abi Shaybah 22936","","","كتاب البيوع والأقضية"
"22937","(۲۲۹۳۷) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ خَالِدٍ، عَنْ أَبِی قِلاَبَۃَ، عَنْ أَبِی الأَشْعَث، عَنْ عُبَادَۃَ بْنِ الصَّامِتِ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الذَّہَبُ بِالذَّہَبِ ، وَالْفِضَّۃُ بِالْفِضَّۃِ وَالشَّعِیرُ بِالشَّعِیرِ ، وَالْمِلْحُ بِالْمِلْحِ ، مِثْلاً بِمِثْلٍ ، یَدًا بِیَدٍ ، فَإِذَا اخْتَلَفَتْ ہَذِہِ الأَصْنَافُ فَبِیعُوا کَیْفَ شِئْتُمْ إذَا کَانَ یَدًا بِیَدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 22937","","","كتاب البيوع والأقضية"
"22938","(۲۲۹۳۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ حَکِیمِ بْنِ جَابِرٍ ، عَنْ عُبَادَۃَ بْنِ الصَّامِتِ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : الذَّہَبُ بِالذَّہَبِ الْکِفَّۃُ بِالْکِفَّۃِ ، وَالْفِضَّۃُ بِالْفِضَّۃِ الْکِفَّۃُ بِالْکِفَّۃِ ، حَتَّی خَصَّ الْمِلْحَ ، فَقَالَ عُبَادَۃُ : إنِّی وَاللَّہِ مَا أُبَالِی أَنْ لاَ أَکُونَ بِأَرْضٍ بِہَا مُعَاوِیَۃُ۔n(نسائی ۶۱۵۹۔ احمد ۵/۳۱۹)","","Musannaf Ibn Abi Shaybah 22938","","","كتاب البيوع والأقضية"
"22939","(۲۲۹۳۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ مُسْلِمٍ الْعَبْدِیُّ ، قَالَ : حدَّثَنَا أَبُو الْمُتَوَکِّلِ النَّاجِی ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الذَّہَبُ بِالذَّہَبِ ، وَالْفِضَّۃُ بِالْفِضَّۃِ ، وَالْبُرُّ بِالْبُرِّ ، وَالشَّعِیرُ بِالشَّعِیرِ ، وَالتَّمْرُ بِالتَّمْرِ ، وَالْمِلْحُ بِالْمِلْحِ ، یَدًا بِیَدٍ ، مِثْلاً بِمِثْلٍ ، فَمَنْ زَادَ أَوِ اسْتَزَادَ فَقَدْ أَرْبَی ، الآخِذُ وَالْمُعْطِی فِیہِ سَوَائٌ۔ (مسلم ۱۲۱۱۔ احمد ۳/۴۹)","Sahih","Musannaf Ibn Abi Shaybah 22939","","","كتاب البيوع والأقضية"
"22940","(۲۲۹۴۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ جَبَلَۃَ بْنِ سُحَیْمٍ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، عن عمر ، قَالَ : أَیُّہَا النَّاسُ ، لاَ تَشْتَرُوا دِینَارًا بِدِینَارَیْنِ ، وَلاَ دِرْہَمًا بِدِرْہَمَیْنِ ، فَإِنِّی أَخَافُ عَلَیْکُمُ الرَّمَاء ، قِیلَ : وَمَا الرَّمَاء ؟ قَالَ : ہُوَ الَّذِی تَدْعُونَہُ الرِّبَا۔","Sahih","Musannaf Ibn Abi Shaybah 22940","","","كتاب البيوع والأقضية"
"22941","(۲۲۹۴۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبَّاسٍ الْعَامِرِیِّ ، عَنْ مُسْلِمِ بْنِ نُذَیرٍ السَّعْدِیِّ ، قَالَ : سُئِلَ عَلِیٌّ عَنِ الدِّرْہَمِ بِالدِّرْہَمَیْنِ ؟ فَقَالَ : الرِّبَا الْعَجْلاَنُ۔","Hasan","Musannaf Ibn Abi Shaybah 22941","","","كتاب البيوع والأقضية"
"22942","(۲۲۹۴۲) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ لَیْثٍ، عَنْ مُجَاہِدٍ ، عَنْ أَرْبَعَۃَ عَشَرَ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، أنہم قَالُوا : الذَّہَبُ بِالذَّہَبِ ، وَالْفِضَّۃُ بِالْفِضَّۃِ ، واتقوا الْفَضْلَ۔مِنْہُمْ أَبُو بَکْرٍ ، وَعُمَرُ وَعُثْمَانُ وَعَلِیٌّ وَسَعْدٌ وَطَلْحَۃُ وَالزُّبَیْرُ۔","Da'if","Musannaf Ibn Abi Shaybah 22942","","","كتاب البيوع والأقضية"
"22943","(۲۲۹۴۳) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ زَیْدِ بْنِ جُبَیْرٍ ، قَالَ : سَأَلَ رَجُلٌ ابْنَ عُمَرَ عَنِ الذَّہَبِ وَالْفِضَّۃِ فَقَالَ ابْنُ عُمَرَ : الذَّہَبُ بِالذَّہَبِ ، وَالْفِضَّۃُ بِالْفِضَّۃِ وَزْنٌ بِوَزْنٍ۔","Sahih","Musannaf Ibn Abi Shaybah 22943","","","كتاب البيوع والأقضية"
"22944","(۲۲۹۴۴) حَدَّثَنَا وکیع ، قَالَ : حَدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : قَالَ عُمَرُ : لاَ تَبِیعُوا الدِّرْہَمَ بِالدِّرْہَمَیْنِ فَإِنَّ ذَلِکَ ہُوَ الرِّبَا الْعَجْلاَنُ۔","Da'if","Musannaf Ibn Abi Shaybah 22944","","","كتاب البيوع والأقضية"
"22945","(۲۲۹۴۵) حَدَّثَنَا ابْنُ إِسْحَاقَ ، عَنْ وُہَیْبٍ ، عَنْ یَحْیَی بْنِ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرَۃَ ، عَنْ أَبِیہِ ، قَالَ : نَہَانَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ نَبِیعَ الذَّہَبَ بِالذَّہَبِ وَالْفِضَّۃَ بِالْفِضَّۃِ إلاَّ سَوَائً بِسَوَائٍ ، وَأَمَرَنَا أَنْ نَبِیعَ الذَّہَبَ بِالْفِضَّۃِ وَالْفِضَّۃَ بِالذَّہَبِ کَیْفَ شِئْنَا۔","Sahih","Musannaf Ibn Abi Shaybah 22945","","","كتاب البيوع والأقضية"
"22946","(۲۲۹۴۶) حَدَّثَنَا یَعْلَی ، عَنِ الْکَلْبِیِّ ، عَنْ سَلَمَۃَ بْنِ السائب ، عَنْ أَبِی رَافِعٍ ، عَنْ أَبِی بَکْرٍ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : الذَّہَبُ بِالذَّہَبِ وَزْنٌ بِوَزْنٍ ، وَالْفِضَّۃُ بِالْفِضَّۃِ وَزْنٌ بِوَزْنٍ ، الزَّائِدُ وَالْمُسْتَزِیدُ فِی النَّارِ۔ (بزار ۴۵)","Da'if","Musannaf Ibn Abi Shaybah 22946","","","كتاب البيوع والأقضية"
"22947","(۲۲۹۴۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، قَالَ : أَخْبَرَنَا حَبِیبُ بْنُ أَبِی ثَابِتٍ ، قَالَ : سَمِعْتُ أَبَا الْمِنْہَالِ ، قَالَ : سَأَلْتُ الْبَرَائَ بْنَ عَازِبٍ وَزَیْدَ بْنَ أَرْقَمَ عَنِ الصَّرْفِ ؟ فَکِلاَہُمَا یَقُولُ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ بَیْعِ الْوَرِقِ بِالذَّہَبِ دَیْنًا۔ (بخاری ۲۱۸۰۔ مسلم ۸۶)","Sahih","Musannaf Ibn Abi Shaybah 22947","","","كتاب البيوع والأقضية"
"22948","(۲۲۹۴۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا نَصْرُ بْنُ عَلِیٍّ الْجَہْضَمِیُّ ، عَنْ قَیْسِ بْنِ رَبَاحٍ الْحُدَّانِیِّ ، عَنْ مَلَکَۃَ ابْنَۃَ ہَانِیئٍ ، قَالَتْ : دَخَلْتُ عَلَیَّ عَائِشَۃَ وَعَلَیَّ سِوَارَانِ مِنْ فِضَّۃٍ ، فَقُلْتُ : یَا أُمَّ الْمُؤْمِنِینَ ، أَبِیعُہَا بِدَرَاہِمَ ؟ فَقَالَتْ : لاَ ، الْفِضَّۃُ بِالْفِضَّۃِ وَزْناً بِوَزْنٍ مِثْلاً بِمِثْلٍ۔","Da'if","Musannaf Ibn Abi Shaybah 22948","","","كتاب البيوع والأقضية"
"22949","(۲۲۹۴۹) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، قَالَ : سَمِعْتُ عَبْدَ الْعَزِیزِ بْنَ حَکِیمٍ یَقُولُ : شَہِدْت ابْنَ عُمَرَ وَأَتَاہُ رَجُلٌ مِنْ أَہْلِ الْبَصْرَۃِ فَقَالَ : إنِّی جِئْت مِنْ عِنْدِ قَوْمٍ یَصْرِفُونَ ألدَّرَاہِمَ الصِّغَارَ فَیَأْخُذُونَ بِہَا کِبَارًا ، قَالَ : أَیَزْدَادُونَ ؟ قَالَ : نَعَمْ ، قَالَ : لاَ إلاَّ وَزْنًا بِوَزْنٍ۔","Hasan","Musannaf Ibn Abi Shaybah 22949","","","كتاب البيوع والأقضية"
"22950","(۲۲۹۵۰) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ سِمَاکٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کُنْتُ أَبِیعُ الذَّہَبَ بِالْفِضَّۃِ ، وَالْفِضَّۃَ بِالذَّہَبِ ، فَأَتَیْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَأَلْتُہُ ؟ فَقَالَ : إذَا بَایَعْت صَاحِبَک فَلاَ تُفَارِقْہُ وَبَیْنَکَ وَبَیْنَہُ لُبْسٌ۔ (ترمذی ۱۲۴۲۔ ابوداؤد ۳۳۴۷)","Hasan","Musannaf Ibn Abi Shaybah 22950","","","كتاب البيوع والأقضية"
"22951","(۲۲۹۵۱) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ حَکِیمٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : إذَا صَرَفْت دِینَارًا فَلاَ تَقُمْ حَتَّی تَأْخُذَ ثَمَنَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 22951","","","كتاب البيوع والأقضية"
"22952","(۲۲۹۵۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، قَالَ : سَمِعَ عَمْرٌو ابْنَ عُمَرَ یَقُولُ : قَالَ عُمَرُ : اسْتَنْظَرَک حَلْبَ نَاقَۃٍ فَلاَ تُنْظِرْہُ یَعْنِی فِی الصَّرْفِ۔","Sahih","Musannaf Ibn Abi Shaybah 22952","","","كتاب البيوع والأقضية"
"22953","(۲۲۹۵۳) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ : أَنَّ طَلْحَۃَ اصْطَرَفَ دَنَانِیرَ بِوَرِقٍ فَنَہَاہُ عُمَرُ أَنْ یُفَارِقَہُ حَتَّی یَسْتَوْفِیَ۔","","Musannaf Ibn Abi Shaybah 22953","","","كتاب البيوع والأقضية"
"22954","(۲۲۹۵۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ أُسَامَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّمَا الرِّبَا فِی النَّسَائِ۔ (بخاری ۲۱۷۹۔ مسلم ۱۵۴)","Sahih","Musannaf Ibn Abi Shaybah 22954","","","كتاب البيوع والأقضية"
"22955","(۲۲۹۵۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَابْنِ سِیرِینَ ، قَالاَ : إذَا بِعْت ذَہَبًا بِفِضَّۃٍ فَلاَ تُفَارِقْہُ وَبَیْنَکَ وَبَیْنَہُ شَرْطٌ إلاَّ ہَائَ وَہَائَ۔","","Musannaf Ibn Abi Shaybah 22955","","","كتاب البيوع والأقضية"
"22956","(۲۲۹۵۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عُقْبَۃَ أَبِی الأَخْضَرِ ، قَالَ : سُئِلَ ابْنُ عُمَرَ عَنِ الذَّہَبِ یُبَاعُ بِنَسِیئَۃٍ، فَقَالَ : سَمِعْتُ عُمَرَ بْنَ الْخَطَّابِ عَلَی ہَذَا الْمِنْبَرِ وَسُئِلَ عَنْہُ فَقَالَ: کُلُّ سَاعَۃٍ اسْتَنْسَأَہُ ، فَہُوَ رِبًا۔","Da'if","Musannaf Ibn Abi Shaybah 22956","","","كتاب البيوع والأقضية"
"22957","(۲۲۹۵۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ یَفْتَرِقَا إلاَّ وَقَدْ تَصَرَّمَ مَا بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 22957","","","كتاب البيوع والأقضية"
"22958","(۲۲۹۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ شِبَاکٍ ، عَنْ إِبْرَاہِیمَ ، عَن شُرَیْحٍ ، قَالَ : أَحَبُّ إلَیَّ فِی الصَّرْفِ أَنْ یَتَصَادَرَا وَلَیْسَ بَیْنَہُمَا لُبْسٌ۔","","Musannaf Ibn Abi Shaybah 22958","","","كتاب البيوع والأقضية"
"22959","(۲۲۹۵۹) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن حَبِیبِ بْنِ شَہِیدٍ ، قَالَ : جَائَ بُدَیل الْعُقَیْلِیُّ إلَی ابْنِ سِیرِینَ وَمَعَہُ رَجُلٌ فَقَالَ : إنَّ ہَذَا یَسْأَلُک عَنِ الصَّرْفِ ، فَقَالَ : نَہَی عَنْہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبُو بَکْرٍ وَعُمَرُ وَعُثْمَانُ۔","","Musannaf Ibn Abi Shaybah 22959","","","كتاب البيوع والأقضية"
"22960","(۲۲۹۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : أَنَّ عَلِیًّا وَعُثْمَانَ نَہَیَا عَنِ الصَّرْفِ۔","Sahih","Musannaf Ibn Abi Shaybah 22960","","","كتاب البيوع والأقضية"
"22961","(۲۲۹۶۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سَلِیمِ بْنِ حَیَّانَ ، عَنْ أَبِی غَالِبٍ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : سَمِعْتُہُ یَقُولُ : الصَّرْفُ رِبًا۔","Hasan","Musannaf Ibn Abi Shaybah 22961","","","كتاب البيوع والأقضية"
"22962","(۲۲۹۶۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی یَعْقُوبَ ، عَنْ یَحْیَی الطَّوِیلِ ، قَالَ : سُئِلَ عَلِیٌّ ، عَنِ الصَّرْفِ ؟ فَقَالَ : ذَلِکَ الرِّبَا الْعَجْلاَنُ۔","Da'if","Musannaf Ibn Abi Shaybah 22962","","","كتاب البيوع والأقضية"
"22963","(۲۲۹۶۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو خَلْدَۃَ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : لَوْ مَرَرْت بِدَارِ صَیْرَفِیٍّ وَأَنَا عَطْشَانُ مَا أَسْتَسْقَیتُہ مَائً۔","","Musannaf Ibn Abi Shaybah 22963","","","كتاب البيوع والأقضية"
"22964","(۲۲۹۶۴) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ بَاعَ نَخْلاً بَعْدَ أَنْ تُؤَبَّرَ ، فَثَمَرَتُہُ لِلْبَائِعِ إلاَّ أَنْ یَشْتَرِطَہُ الْمُبْتَاعُ ، وَمَنْ بَاعَ عَبْدًا وَلَہُ مَالٌ ، فَمَالُہُ لِلْبَائِعِ إلاَّ أَنْ یَشْتَرِطَہُ الْمُبْتَاعُ۔ (مسلم ۸۰۔ ابوداؤد ۳۴۲۵)","Sahih","Musannaf Ibn Abi Shaybah 22964","","","كتاب البيوع والأقضية"
"22965","(۲۲۹۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عن سلمۃ بْنِ کہیل ، عَمَّنْ سَمِعَ جَابِرَ بْنَ عَبْدِ اللہِ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ بَاعَ عَبْدًا وَلَہُ مَالٌ فَمَالُہُ لِلْبَائِعِ إلاَّ أَنْ یَشْتَرِطَ الْمُبْتَاعُ۔n(ابوداؤد ۳۴۲۷۔ بیہقی ۳۲۶)","Da'if","Musannaf Ibn Abi Shaybah 22965","","","كتاب البيوع والأقضية"
"22966","(۲۲۹۶۶) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ عَطَائٍ وَابْنِ أَبِی مُلَیْکَۃَ ، قَالاَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ بَاعَ عَبْدًا وَلَہُ مَالٌ فَمَالُہُ لِلْبَائِعِ إلاَّ أَنْ یَشْتَرِطَ الْمُبْتَاعُ ، یَقُولُ : اشْتَرَیْتہ مِنْک وَمَالَہُ ، وَمَنْ بَاعَ نَخْلاً قَدْ أُبِّرَ فَثَمَرَتُہُ لِلْبَائِعِ إلاَّ أَنْ یَشْتَرِطَ الْمُبْتَاعُ۔ (نسائی ۴۹۸۴۔ عبدالرزاق ۱۴۶۲۴)","","Musannaf Ibn Abi Shaybah 22966","","","كتاب البيوع والأقضية"
"22967","(۲۲۹۶۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ۔ وَعَنْ أَشْعَثَ ، عَنْ نَافِعٍ ، عَنِ ابْنَ عُمَرَ ، قَالاَ : مَنْ بَاعَ نَخْلاً فَالثَّمَرَۃُ لِلْبَائِعِ إلاَّ أَنْ یَشْتَرِطَ الْمُشْتَرِی ، وَمَنْ بَاعَ عَبْدًا لَہُ مَالٌ فَالْمَالُ لِلْبَائِعِ إلاَّ أَنْ یَشْتَرِطَ الْمُبْتَاعُ۔ (نسائی ۴۹۸۳۔ ابن حبان ۴۹۲۴)","Da'if","Musannaf Ibn Abi Shaybah 22967","","","كتاب البيوع والأقضية"
"22968","(۲۲۹۶۸) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ ، قَالَ عَلِیٌّ : مَنْ بَاعَ عَبْدًا وَلَہُ مَالٌ فَالْمَالُ لِلْبَائِعِ إلا أن یشترط المبتاع ، وَمَنْ بَاعَ نَخْلاً قَدْ أُبِّرَتْ یَعْنِی : لُقِّحَتْ ، فَثَمَرَتُہُ لِلْبَائِعِ إلاَّ أَنْ یَشْتَرِطَ الْمُبْتَاعُ ، قَضَی بِہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (بیہقی ۳۲۶)","","Musannaf Ibn Abi Shaybah 22968","","","كتاب البيوع والأقضية"
"22969","(۲۲۹۶۹) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ عُمَرُ : مَنْ بَاعَ عَبْدًا وَلَہُ مَالٌ فَمَالُہُ لِسَیِّدِہِ إلاَّ أَنْ یَشْتَرِطَ الَّذِی اشْتَرَاہُ۔ (مسلم ۱۱۷۲۔ بیہقی ۲۹۸)","Sahih","Musannaf Ibn Abi Shaybah 22969","","","كتاب البيوع والأقضية"
"22970","(۲۲۹۷۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ بْنِ عُتْبَۃَ وَشُرَیْحٍ ، قَالاَ : إذَا بَاعَہُ وَلَہُ مَالٌ فَمَالُہُ لِلْمُشْتَرِی۔","","Musannaf Ibn Abi Shaybah 22970","","","كتاب البيوع والأقضية"
"22971","(۲۲۹۷۱) حَدَّثَنَا وکیع ، عن شعبۃ ، قَالَ : سألت الحکم عنہ؟ فقال : المال للمشتری۔","","Musannaf Ibn Abi Shaybah 22971","","","كتاب البيوع والأقضية"
"22972","(۲۲۹۷۲) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ حَنْظَلَۃَ ، عَنْ طَاوُوسٍ سُئِلَ عَنْ رَجُلٍ اشْتَرَی عَبْدًا وَشَرَطَ مَالَہُ ، قَالَ : مَالُہُ لَہُ ، وَإِنْ لَمْ یَشْتَرِطْ فَمَالُہُ لِسَیِّدِہِ۔","","Musannaf Ibn Abi Shaybah 22972","","","كتاب البيوع والأقضية"
"22973","(۲۲۹۷۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا بِیعَ وَلَہُ مَالٌ فَمَالُہُ لِلْمُشْتَرِی۔","","Musannaf Ibn Abi Shaybah 22973","","","كتاب البيوع والأقضية"
"22974","(۲۲۹۷۴) حَدَّثَنَا غندر ، عن أشعث ، عن الحسن ، قَالَ : إذا باعہ ، ولہ مال فمالہ للمشتری۔","","Musannaf Ibn Abi Shaybah 22974","","","كتاب البيوع والأقضية"
"22975","(۲۲۹۷۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا إذَا بَاعَ الرَّجُلُ غُلاَمَہُ وَلَہُ مَالٌ أَنْ یَقُولَ : أَبِیعُکَہ وَمَالَہُ۔","","Musannaf Ibn Abi Shaybah 22975","","","كتاب البيوع والأقضية"
"22976","(۲۲۹۷۶) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا دَابَّۃً بِدَابَّۃٍ وَدَرَاہِمَ ، الدَّابَّۃُ مُعَجَّلَۃٌ وَالدَّرَاہِمُ نَسِیئَۃٌ۔","","Musannaf Ibn Abi Shaybah 22976","","","كتاب البيوع والأقضية"
"22977","(۲۲۹۷۷) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ وَمُحَمَّدٍ: فِی بَقَرَۃٍ بِبَقَرَۃٍ بَیْنَہُمَا دَرَاہِم، الدَّرَاہِم نَسِیئَۃٌ۔n قَالَ مُحَمَّدٌ : لاَ بَأْسَ بِہِ ، وَکَرِہَہُ الْحَسَنُ۔","","Musannaf Ibn Abi Shaybah 22977","","","كتاب البيوع والأقضية"
"22978","(۲۲۹۷۸) حَدَّثَنَا بَعْضُ الْمَشِیْخَۃِ ، عَنْ قَیْسٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یُبَاعَ الْبَعِیرُ بِالْبَعِیرِ بَیْنَہُمَا عَشَرَۃُ دَرَاہِمُ ، إذَا کَانَ الْحَیَوَانُ مُعَجَّلاً وَالدَّرَاہِمُ مَؤَخَّرۃ ، وَکَرِہَہُ إذَا کَانَتِ الدَّرَاہِمُ مُعَجَّلَۃً وَالْحَیَوَانُ مُؤَخَّرًا۔","","Musannaf Ibn Abi Shaybah 22978","","","كتاب البيوع والأقضية"
"22979","(۲۲۹۷۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : سَمِعْتُہُ یَقُولُ : لاَ یُبَاعُ الَعِنَبُ حَتَّی یَسْوَدَّ۔","Sahih","Musannaf Ibn Abi Shaybah 22979","","","كتاب البيوع والأقضية"
"22980","(۲۲۹۸۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ بَیْعِ الَعِنَبِ حَتَّی یَسْوَدَّ۔ (ترمذی ۱۲۲۸۔ ابوداؤد ۳۳۶۴)","Sahih","Musannaf Ibn Abi Shaybah 22980","","","كتاب البيوع والأقضية"
"22981","(۲۲۹۸۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی شَیْبَۃَ ، عَنْ عِیسَی بْنِ الْحَارِثِ ، عَنْ شُرَیْحٍ : أَنَّہُ قَالَ فِی الشُّفْعَۃِ : عَلَی قَدْرِ الأَنْصِبَائِ۔","","Musannaf Ibn Abi Shaybah 22981","","","كتاب البيوع والأقضية"
"22982","(۲۲۹۸۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ۔ وَعَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالاَ : الشُّفْعَۃُ بِالْحِصَصِ۔","","Musannaf Ibn Abi Shaybah 22982","","","كتاب البيوع والأقضية"
"22983","(۲۲۹۸۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَشْعَثَ ، عَنْ عَامِرٍ ، قَالَ : الشُّفْعَۃُ عَلَی رُؤُوسِ الرِّجَالِ۔","","Musannaf Ibn Abi Shaybah 22983","","","كتاب البيوع والأقضية"
"22984","(۲۲۹۸۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : الشُّفْعَۃُ عَلَی رُؤُوسِ الرِّجَالِ۔n وَقَالَ الْحَسَنُ : ہِیَ عَلَی قَدْرِ الأَنْصِبَائِ۔","","Musannaf Ibn Abi Shaybah 22984","","","كتاب البيوع والأقضية"
"22985","(۲۲۹۸۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَمِعْتُ سُفْیَانَ یَقُولُ : الشُّفْعَۃُ ، وَالْقَسَامَۃُ ، وَالْعَقْلُ عَلَی رُؤُوسِ الرِّجَالِ۔","","Musannaf Ibn Abi Shaybah 22985","","","كتاب البيوع والأقضية"
"22986","(۲۲۹۸۶) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ أَبِی شَیْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : ہِیَ عَلَی رُؤُوسِ الرِّجَالِ۔","","Musannaf Ibn Abi Shaybah 22986","","","كتاب البيوع والأقضية"
"22987","(۲۲۹۸۷) حَدَّثَنَا مُعَاذٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : الشُّفْعَۃُ عَلَی قَدْرِ الأَنْصِبَائِ۔","","Musannaf Ibn Abi Shaybah 22987","","","كتاب البيوع والأقضية"
"22988","(۲۲۹۸۸) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنِ الشَّیْبَانِیِّ، عَنِ الشَّعْبِیِّ، قَالَ: الشُّفْعَۃُ بِالْحُدُودِ، وَلاَ شُفْعَۃَ بِالأَبْوَابِ۔","","Musannaf Ibn Abi Shaybah 22988","","","كتاب البيوع والأقضية"
"22989","(۲۲۹۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : الشُّفْعَۃُ بِالأَبْوَابِ۔n(عبدالرزاق ۱۴۴۰۰)","","Musannaf Ibn Abi Shaybah 22989","","","كتاب البيوع والأقضية"
"22990","(۲۲۹۹۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ شُرَیْحٍ ، قَالَ : الشُّفْعَۃُ لِلْحِیطَانِ۔","","Musannaf Ibn Abi Shaybah 22990","","","كتاب البيوع والأقضية"
"22991","(۲۲۹۹۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : الشُّفْعَۃُ بِالأَبْوَابِ لَیْسَ بِشَیْئٍ ، إنَّمَا الشُّفْعَۃُ بِالْحُدُودِ۔","","Musannaf Ibn Abi Shaybah 22991","","","كتاب البيوع والأقضية"
"22992","(۲۲۹۹۲) حَدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنِ الصُّفْرِ بِالْحَدِیدِ نَسِیئَۃً ، فَکَرِہَ ذَلِکَ حَمَّادٌ ، وَلَمْ یَرَ الْحَکَمُ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 22992","","","كتاب البيوع والأقضية"
"22993","(۲۲۹۹۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : أَرَادَ مُکَاتَبٌ أَنْ یُعْطِیَ مَوْلاَہُ الْمَالَ کُلَّہُ ، فَقَالَ : لاَ آخُذُہُ إلاَّ نُجُومًا ، فَکَتَبَ لَہُ عُثْمَانُ عِتْقَہُ ، وَأَخَذَ الْمَالَ وَقَالَ : أَنَا أُعْطِیکَہُ نُجُومًا ، فَلَمَّا رَأَی ذَلِکَ الرَّجُلَ أَخَذَ الْمَالَ۔","","Musannaf Ibn Abi Shaybah 22993","","","كتاب البيوع والأقضية"
"22994","(۲۲۹۹۴) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنْ أَبِی لَیْلَی ، عَنْ أَبِی ضَبَّۃَ ، قَالَ : رُفِعَ إلَی عُمَرَ مُکَاتَبٌ جَائَ بِالْمَالِ یَحْمِلہ ، فَقَالَ مَوْلاَہُ : لاَ أَقْبَلُہُ مِنْک ، إنَّمَا کَاتَبْتُک لاَخُذَہُ مِنْک نُجُومًا فِی السِّنِینَ لِنَفَقَتی ، وَلَعَلَّک مَعَ ذَلِکَ تَمُوتُ فَأَرِثُک ، فَأَمَرَ عُمَرُ بِالْمَالِ فَوَضَعَہُ فِی بَیْتِ الْمَالِ ، ثُمَّ أَجْرَاہُ عَلَیْہِ نُجُومًا وَأَمْضَی عِتْقَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 22994","","","كتاب البيوع والأقضية"
"22995","(۲۲۹۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ أَبِی بَکْرِ بْنِ عَمْرِو بْنِ حَزْمٍ : أَنَّ رَجُلاً کَاتَبَ غُلاَمًا لَہُ ، فَنَجَّمَہَا عَلَیْہِ نُجُومًا ، فَأَتَاہُ بِمُکَاتَبَتِہِ کُلِّہَا ، فَأَبَی أَنْ یَقْبَلَہَا الْمَوْلَی إلاَّ نُجُومًا ، فَأَتَی الْمُکَاتَبُ عُمَرَ فَأَرْسَلَ إلَی مَوْلاَہُ ، فَجَائَ فَعَرَضَ عَلَیْہِ الْمَالَ فَأَبَی أَنْ یَأْخُذَہُ فَقَالَ عُمَرُ : یَا یَرْفَأُ ادْفَعْہُ فِی بَیْتِ الْمَالِ ، وَقَالَ لِلْمَوْلَی : خُذْہَا نُجُومًا ، وَقَالَ لِلْمُکَاتَبِ : اذْہَبْ حَیْثُ شِئْت۔","","Musannaf Ibn Abi Shaybah 22995","","","كتاب البيوع والأقضية"
"22996","(۲۲۹۹۶) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ بَأْسَ بِالْفَلْسِ بِالْفَلْسَیْنِ یَدًا بِیَدٍ۔","","Musannaf Ibn Abi Shaybah 22996","","","كتاب البيوع والأقضية"
"22997","(۲۲۹۹۷) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 22997","","","كتاب البيوع والأقضية"
"22998","(۲۲۹۹۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ حَمَّادٍ ، قَالَ : لاَ بَأْسَ بِالْفَلْسِ بِالْفَلْسَیْنِ یَدًا بِیَدٍ۔","","Musannaf Ibn Abi Shaybah 22998","","","كتاب البيوع والأقضية"
"22999","(۲۲۹۹۹) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنِ الشَّیْبَانِیِّ، عن الشعبی، عن عبداللہ بْنِ عتبۃ وشریح: فی الرجل یبیع العبد وعلیہ دین ، قَالَ : دَیْنُہُ عَلَی مَوْلاَہُ ، لاَ یُجَاوِزُ ثَمَنَہُ ، وَإِذَا بَاعَہُ وَلَہُ مَالٌ فَمَالُہُ لِلَّذِی ابْتَاعَہُ یَعْنِی الْمُشْتَرِیَ۔","","Musannaf Ibn Abi Shaybah 22999","","","كتاب البيوع والأقضية"
"23000","(۲۳۰۰۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا بِیعَ الْعَبْدُ وَعَلَیْہِ دَیْنٌ وَلَہُ مَالٌ فَمَالُہُ لِلَّذِی ابْتَاعَہُ ، ودینہ علی الذی باعہ۔","","Musannaf Ibn Abi Shaybah 23000","","","كتاب البيوع والأقضية"
"23001","(۲۳۰۰۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ وَہِشَامٌ وَأَشْعَثُ ، عَنْ مُحَمَّدٍ ، عَنْ شُرَیْحٍ فِی الْعَبْدِ یباع وَعَلَیْہِ دَیْنٌ ، قَالَ : دَیْنُہُ عَلَی مَنْ بَاعَہُ وَأَکَلَ ثَمَنَہُ۔","","Musannaf Ibn Abi Shaybah 23001","","","كتاب البيوع والأقضية"
"23002","(۲۳۰۰۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ : أَنَّ عَبْدَ الرَّحْمَن بْنَ أُذَیْنَۃَ أُتِی فِی عَبْدٍ رَکِبَہُ دَیْنٌ ، فَقَالَ : مَالُہُ بِدَیْنِہِ۔","","Musannaf Ibn Abi Shaybah 23002","","","كتاب البيوع والأقضية"
"23003","(۲۳۰۰۳) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : اشْتَرَی رَجُلٌ مِنْ رَجُلٍ دَابَّۃً فَسَافَرَ عَلَیْہَا ، فَلَمَّا رَجَعَ وَجَدَ بِہَا عَیْبًا فَخَاصَمَہُ إلَی شُرَیْحٍ فَقَالَ : أَنْتَ أَذِنْت لَہُ فِی ظَہْرِہَا۔","","Musannaf Ibn Abi Shaybah 23003","","","كتاب البيوع والأقضية"
"23004","(۲۳۰۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ غَیْلاَنَ ، عَنِ الْحَکَمِ : فِی رَجُلٍ اشْتَرَی دَابَّۃً فَہَزَلَہَا ، ثُمَّ وَجَدَ بِہَا عَیْبًا، قَالَ : یَرُدُّہَا ، وَیَرُدُّ مَعَہَا مَا بَیْنَ الْہُزال إلَی السِّمَنِ۔","","Musannaf Ibn Abi Shaybah 23004","","","كتاب البيوع والأقضية"
"23005","(۲۳۰۰۵) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ : أنَّ رَجُلَیْنِ شَہِدَا عِنْدَ شُرَیْحٍ ، فَأَمْضَی الْحُکْمَ ، ثُمَّ رَجَعَ أَحَدُہُمَا فَلَمْ یَقْبَلْ شُرَیْحٌ رُجُوعَہُ۔","","Musannaf Ibn Abi Shaybah 23005","","","كتاب البيوع والأقضية"
"23006","(۲۳۰۰۶) حَدَّثَنَا وَکِیعٌ وَغُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، قَالَ : الْحُکْمُ لاَ تُرَدُّ ، وَقَالَ حَمَّادٌ : تُرَدُّ۔","","Musannaf Ibn Abi Shaybah 23006","","","كتاب البيوع والأقضية"
"23007","(۲۳۰۰۷) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ : فِی رَجُلَیْنِ شَہِدَا بِشَہَادَۃٍ ثُمَّ رَجَعَا جَمِیعًا ، فَحُکِمَ بِہَا ، قَالَ : یُرَدُّ الْحُکْمُ۔","","Musannaf Ibn Abi Shaybah 23007","","","كتاب البيوع والأقضية"
"23008","(۲۳۰۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ : أَنَّ رَجُلاً شَہِدَ عِنْدَ شُرَیْحٍ بِشَہَادَۃٍ ، فَجَائَ فَرَجَعَ ، فَقَالَ شُرَیْحٌ : قَدْ قَبِلْنَا شَہَادَتَک۔","","Musannaf Ibn Abi Shaybah 23008","","","كتاب البيوع والأقضية"
"23009","(۲۳۰۰۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ : إذَا مَضَی الْحُکْمُ جَازَتِ الشَّہَادَۃُ ، وَیُغَرَّمُ الشَّاہِدُ إذَا رَجَعَ۔","","Musannaf Ibn Abi Shaybah 23009","","","كتاب البيوع والأقضية"
"23010","(۲۳۰۱۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَوْزَاعِیِّ ، عَنْ وَاصِلِ بْنِ أَبِی جَمِیلٍ ، عَنْ مُجَاہِدٍ ، قَالَ : اشْتَرَکَ أَرْبَعَۃُ رَہْطٍ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی زَرْعٍ ، فَقَالَ أَحَدُہُمْ : قِبَلِی الأَرْضُ ، وَقَالَ الآخَرُ : قِبَلِی الْفَدَّانُ ، وَقَالَ الآخَرُ : قِبَلِی الْبَذْرُ ، وَقَالَ الآخَرُ : عَلَیَّ الْعَمَلُ ، فَلَمَّا اسْتُحْصِدَ الزَّرْعُ تَفَاتَوْا فِیہِ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَجَعَلَ الزَّرْعَ لِصَاحِبِ الْبَذْرِ ، وَأَلْغَی صَاحِبَ الأَرْضِ ، وَجَعَلَ لِصَاحِبِ الْفَدَّانِ شَیْئًا مَعْلُومًا ، وَجَعَلَ لِصَاحِبِ الْعَمَلِ دِرْہَمًا کُلَّ یَوْمٍ ، قَالَ وَاصِلٌ : فَحَدَّثْت بِہِ مَکْحُولاً ، فَقَالَ : لَہَذَا الْحَدِیثُ أَحَبُّ إلَیَّ مِنْ وَصِیْفٍ۔n قَالَ وَکِیعٌ : أَحَبُّ من الزَّرْعِ إلَیْنَا التِّجَارَۃُ بِالذَّہَبِ وَالْفِضَّۃِ وَالطَّعَامِ وَہُوَ قَوْلُ سُفْیَانَ۔n قَالَ وَکِیعٌ : وَنَرْجُو أَنْ یَکُونَ النِّصْفُ وَالثُّلُثُ وَالرُّبُعُ جَائِزًا ، لأَنَّ النَّاسَ یَعْمَلُونَ بِہِ۔","","Musannaf Ibn Abi Shaybah 23010","","","كتاب البيوع والأقضية"
"23011","(۲۳۰۱۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْبَیِّعَانِ بِالْخِیَارِ فِی بَیْعِہِمَا مَا لَمْ یَتَفَرَّقَا ، إلاَّ أَنْ یَکُونَ بَیْعُہُمَا عَنْ خِیَارٍ۔ (مسلم ۴۶۔ ابن حبان ۴۹۱۳)","Sahih","Musannaf Ibn Abi Shaybah 23011","","","كتاب البيوع والأقضية"
"23012","(۲۳۰۱۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ صَالِحٍ أَبِی الْخَلِیلِ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنْ حَکِیمِ بْنِ حِزَامٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْبَیِّعَانِ بِالْخِیَارِ مَا لَمْ یَتَفَرَّقَا۔n(احمد ۳/۴۰۲۔ ابن حبان ۴۹۰۴)","Sahih","Musannaf Ibn Abi Shaybah 23012","","","كتاب البيوع والأقضية"
"23013","(۲۳۰۱۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ جَمِیلِ بْنِ مُرَّۃَ ، عَنْ أَبِی الْوَضِیئِ ، عَنْ أَبِی بَرْزَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْبَیِّعَانِ بِالْخِیَارِ مَا لَمْ یَتَفَرَّقَا۔n(ابوداؤد ۳۴۵۱۔ ابن ماجہ ۲۱۸۲)","Sahih","Musannaf Ibn Abi Shaybah 23013","","","كتاب البيوع والأقضية"
"23014","(۲۳۰۱۴) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، قَالَ : حدَّثَنَا أیوب بْن عُتْبَۃَ ، قَالَ : حَدَّثَنَا أَبُو کَثِیرٍ السُّحَیْمِیُّ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْبَیِّعَانِ بِالْخِیَارِ مَا لَمْ یَفْتَرِقَا مِنْ بَیْعِہِمَا ، أَوْ یَکُونُ بَیْنَہُمَا خِیَارٌ۔ (ابن حزم ۱۴۱۷)","Da'if","Musannaf Ibn Abi Shaybah 23014","","","كتاب البيوع والأقضية"
"23015","(۲۳۰۱۵) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ وَعَطَائٍ ، قَالاَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْبَیِّعَانِ بِالْخِیَارِ حَتَّی یَتَفَرَّقَا عَنْ رِضًا۔","","Musannaf Ibn Abi Shaybah 23015","","","كتاب البيوع والأقضية"
"23016","(۲۳۰۱۶) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْبَیِّعَانِ بِالْخِیَارِ مَا لَمْ یَتَفَرَّقَا۔","","Musannaf Ibn Abi Shaybah 23016","","","كتاب البيوع والأقضية"
"23017","(۲۳۰۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ شُرَیْحٍ ، قَالَ : الْبَیِّعَانِ [corrupt]ِالْخِیَارِ مَا لَمْ یَتَفَرَّقَا۔","","Musannaf Ibn Abi Shaybah 23017","","","كتاب البيوع والأقضية"
"23018","(۲۳۰۱۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ : فِی رَجُلٍ اشْتَرَی مِنْ رَجُلٍ بِرْذَوْنًا ، فَأَرَادَ أَنْ یَرُدَّہُ قَبْلَ أَنْ یَتَفَرَّقَا ، فَقَضَی الشَّعْبِیُّ أَنَّہُ قَدْ وَجَبَ عَلَیْہِ ، فَشَہِدَ عِنْدَہُ أَبُو الضُّحَی ، أَنَّ شُرَیْحًا أُتِیَ فِی مِثْلِ ذَلِکَ فَرَدَّہُ عَلَی الْبَائِعِ ، فَرَجَعَ الشَّعْبِیُّ إلَی قَوْلِ شُرَیْحٍ۔","","Musannaf Ibn Abi Shaybah 23018","","","كتاب البيوع والأقضية"
"23019","(۲۳۰۱۹) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : الْبَیِّعَانِ بِالْخِیَارِ مَا لَمْ یَتَفَرَّقَا۔فَکَانَ ابْنُ عُمَرَ إذَا بَاعَ انْصَرَفَ لِیُوجِبَ الْبَیْعَ۔","","Musannaf Ibn Abi Shaybah 23019","","","كتاب البيوع والأقضية"
"23020","(۲۳۰۲۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی السَّفَرِ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، قَالَ : الْبَیِّعَانِ بِالْخِیَارِ مَا لَمْ یَتَفَرَّقَا۔","","Musannaf Ibn Abi Shaybah 23020","","","كتاب البيوع والأقضية"
"23021","(۲۳۰۲۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ زِیَادٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : الْبَیِّعَانِ بِالْخِیَارِ مَا لَمْ یَتَفَرَّقَا۔","","Musannaf Ibn Abi Shaybah 23021","","","كتاب البيوع والأقضية"
"23022","(۲۳۰۲۲) حَدَّثَنَا أبو الأحوص ، عن عبد العزیز بْنِ رفیع ، عن ابن أبی ملیکۃ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْبَیِّعَانِ بِالْخِیَارِ مَا لَمْ یَتَفَرَّقَا۔","","Musannaf Ibn Abi Shaybah 23022","","","كتاب البيوع والأقضية"
"23023","(۲۳۰۲۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ وَأَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الْحَجَّاجِ ، عَنِ الْحَکَمِ ، عَنْ شُرَیْحٍ ، قَالَ : إذَا تَکَلَّمَ بِالْبَیْعِ جَازَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 23023","","","كتاب البيوع والأقضية"
"23024","(۲۳۰۲۴) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ الْحَجَّاجِ ، عَنْ خَالِدِ بْنِ مُحَمَّدٍ ، عَنْ شَیْخٍ مِنْ بَنِی کِنَانَۃَ ، قَالَ : سَمِعْتُ عُمَرَ یَقُولُ : إنَّمَا الْبَیْعُ عَنْ صَفْقَۃٍ أَوْ خِیَارٍ۔","Da'if","Musannaf Ibn Abi Shaybah 23024","","","كتاب البيوع والأقضية"
"23025","(۲۳۰۲۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : الْبَیْعُ جَائِزٌ وَإِنْ لَمْ یَتَفَرَّقَا۔","","Musannaf Ibn Abi Shaybah 23025","","","كتاب البيوع والأقضية"
"23026","(۲۳۰۲۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ : فِی رَجُلٍ قَالَ لِرَجُلٍ : إِنْ بِعْتُک غُلاَمِی فَہُوَ حُرٌّ ، وَقَالَ الآخَرُ : إنِ اشْتَرَیْتہ فَہُوَ حُرٌّ ، قَالَ : یَعْتِقُ مِنْ مَالِ الْبَائِعِ لأَنَّہُ حَنِثَ قَبْلَہُ۔","","Musannaf Ibn Abi Shaybah 23026","","","كتاب البيوع والأقضية"
"23027","(۲۳۰۲۷) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، قَالَ : حدَّثَنَا حَمَّادٌ ، عَنْ إبْرَاہِیمَ ، قَالَ : ہُوَ حُرٌّ مِنْ مَالِ الْبَائِعِ لأَنَّہُ حَنِثَ أَوَّلَہُمَا۔","","Musannaf Ibn Abi Shaybah 23027","","","كتاب البيوع والأقضية"
"23028","(۲۳۰۲۸) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ طَارِقٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ رَافِعِ بْنِ خَدِیجٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْمُحَاقَلَۃِ وَالْمُزَابَنَۃِ۔ (ابوداؤد ۳۳۹۳۔ ابن ماجہ ۲۲۶۷)","Sahih","Musannaf Ibn Abi Shaybah 23028","","","كتاب البيوع والأقضية"
"23029","(۲۳۰۲۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْمُحَاقَلَۃِ وَالْمُزَابَنَۃِ۔ (مسلم ۸۲۔ ابوداؤد ۳۳۹۸)","Sahih","Musannaf Ibn Abi Shaybah 23029","","","كتاب البيوع والأقضية"
"23030","(۲۳۰۳۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ بُشَیْرِ بْنِ یَسَارٍ ، عَنْ سَہْلِ بْنِ أَبِی حَثْمَۃَ : أَنَّ رَسُولَ اللَّہ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ بَیْعِ الثَّمَرِ بِالتَّمْرِ ، وَرَخَّصَ فِی الْعَرِیَّۃِ أَنْ تُبَاعَ بِخَرْصِہَا یَأْکُلُہَا أَہْلُہَا رُطَبًا۔n(بخاری ۲۱۹۱۔ مسلم ۱۸۷۰)","Sahih","Musannaf Ibn Abi Shaybah 23030","","","كتاب البيوع والأقضية"
"23031","(۲۳۰۳۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ الْمُحَاقَلَۃِ وَالْمُزَابَنَۃِ۔ (بخاری ۲۱۸۷۔ احمد ۱/۲۲۴)","Sahih","Musannaf Ibn Abi Shaybah 23031","","","كتاب البيوع والأقضية"
"23032","(۲۳۰۳۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْوَلِیدِ بْنِ کَثِیرٍ ، قَالَ : حدَّثَنِی بُشَیْرُ بْنُ یَسَارٍ مَوْلَی بَنِی حَارِثَۃَ ، أَنَّ رَافِعَ بْنَ خَدِیجٍ وَسَہْلَ بْنَ أَبِی حَثْمَۃَ حَدَّثَاہُ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ الْمُزَابَنَۃِ الثَّمَرُ بِالتَّمْرِ إلاَّ أَصْحَابَ الْعَرَایَا فَإِنَّہُ قَدْ أَذِنَ لَہُمْ۔ (بخاری ۲۳۸۴۔ مسلم ۱۱۷۰)","Sahih","Musannaf Ibn Abi Shaybah 23032","","","كتاب البيوع والأقضية"
"23033","(۲۳۰۳۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْمُحَاقَلَۃِ وَالْمُزَابَنَۃِ ، فَالْمُحَاقَلَۃُ فِی الزَّرْعِ ، وَالْمُزَابَنَۃُ فِی النَّخْلِ۔n(بخاری۲۱۷۶۔ مسلم ۱۱۷۹)","Hasan","Musannaf Ibn Abi Shaybah 23033","","","كتاب البيوع والأقضية"
"23034","(۲۳۰۳۴) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ سُفْیَانَ ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ، عَنِ ابْنِ أَبِی سَلَمَۃَ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْمُحَاقَلَۃِ وَالْمُزَابَنَۃِ۔ (مسلم ۱۱۷۹۔ ترمذی ۱۲۲۴)","Hasan","Musannaf Ibn Abi Shaybah 23034","","","كتاب البيوع والأقضية"
"23035","(۲۳۰۳۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، قَالَ : نَہَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ بَیْعِ الثَّمَرِ بِالتَّمْرِ۔ (مسلم ۱۱۶۷۔ احمد ۲/۸)","Sahih","Musannaf Ibn Abi Shaybah 23035","","","كتاب البيوع والأقضية"
"23036","(۲۳۰۳۶) حَدَّثَنَا ابْنُ عُیَینۃ ، عَنْ عَمْرٍو ، عَنْ إسْمَاعِیلَ الشَّیْبَانِیِّ ، قَالَ : بِعْت مَا فِی رُؤُوسِ النَّخْلِ إِنْ زَادَ فَلَہُمْ وَإِنْ نَقَصَ فَعَلَیْہِمْ ، فَسَأَلْت ابْنَ عُمَرَ ؟ فَقَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ ذَلِکَ إلأَأَنَّہُ قَدْ رَخَّصَ فِی الْعَرَایَا۔ (احمد ۲/۱۱۔ حاکم ۳۶۵)","Sahih","Musannaf Ibn Abi Shaybah 23036","","","كتاب البيوع والأقضية"
"23037","(۲۳۰۳۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْمُحَاقَلَۃِ وَالْمُزَابَنَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 23037","","","كتاب البيوع والأقضية"
"23038","(۲۳۰۳۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، قَالَ ، الْمُحَاقَلَۃُ فِی الزَّرْعِ کَالْمُزَابَنَۃِ فِی النَّخْلِ۔","","Musannaf Ibn Abi Shaybah 23038","","","كتاب البيوع والأقضية"
"23039","(۲۳۰۳۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : حدَّثَنِی زَیْدُ بْنُ ثَابِتٍ : أَنَّ رَسُولَ اللہِ نَہَی عَنِ الْمُحَاقَلَۃِ وَالْمُزَابَنَۃِ۔ (ترمذی ۱۳۰۰۔ احمد ۵/۱۸۵)","","Musannaf Ibn Abi Shaybah 23039","","","كتاب البيوع والأقضية"
"23040","(۲۳۰۴۰) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ عُثْمَانَ بْنِ حَکِیمٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : التَّمْرُ بِالتَّمْرِ عَلَی رُؤُوسِ النَّخْلِ مُکَایَلَۃً ، قَالَ : إِنْ کَانَ بَیْنَہُمَا دِینَارٌ أَوْ عَشَرَۃُ دَرَاہِمَ فَلاَ بَأْسَ۔","Sahih","Musannaf Ibn Abi Shaybah 23040","","","كتاب البيوع والأقضية"
"23041","(۲۳۰۴۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا عُثْمَانُ بْنُ حَکِیمٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ بِبَیْعِ التَّمَرِ عَلَی رُؤُوسِ النَّخْلِ بِالتَّمْرِ مَکِیلَۃً إذَا کَانَ فِیہِ عَشَرَۃُ دَرَاہِمَ أَوْ دِینَارٍ۔","Sahih","Musannaf Ibn Abi Shaybah 23041","","","كتاب البيوع والأقضية"
"23042","(۲۳۰۴۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْمُزَابَنَۃِ۔ (مالک ۲۳)","Da'if","Musannaf Ibn Abi Shaybah 23042","","","كتاب البيوع والأقضية"
"23043","(۲۳۰۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَمِعْنَا تَفْسِیرَ الْمُزَابَنَۃِ اشْتِرَائُ مَا فِی رُؤُوسِ النَّخْلِ بِالتَّمْرِ ، وَالْمُحَاقَلَۃُ : اشْتِرَائُ مَا فِی السُّنْبُلِ بِالْحِنْطَۃِ وَالشَّعِیرِ ، وَالْعَرَایَا : الرَّجُلُ تَکُونُ لَہُ النَّخْلَۃُ یَرِثُہَا أَوْ یَشْتَرِیہَا فِی بُسْتَانِ الرَّجُلِ۔ق","","Musannaf Ibn Abi Shaybah 23043","","","كتاب البيوع والأقضية"
"23044","(۲۳۰۴۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إبْرَاہِیمُ بْنُ إسْمَاعِیلَ ، عَنْ مُجَمِّعٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّہُ قَالَ فِی الْبُرِّ بِالتَّمْرِ نَسِیئَۃً : رِبًا۔","Da'if","Musannaf Ibn Abi Shaybah 23044","","","كتاب البيوع والأقضية"
"23045","(۲۳۰۴۵) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا إبراہیم بن یزید، عَنْ أَبِی الزُّبَیْرِ، عَنْ جَابِرٍ: أَنَّہُ کَرِہَ مُدَّیْ ذُرَۃٍ بِمُدِّ حِنْطَۃٍ نَسِیئَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 23045","","","كتاب البيوع والأقضية"
"23046","(۲۳۰۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، عَنْ عَامِرٍ ، قَالَ : اشْتَرَی عُمَرُ مِنْ رَجُلٍ فَرَسًا ، وَاسْتَوْجَبَہُ عَلَی إِنْ رَضِیَہُ ، وَإِلاَّ فَلاَ بَیْعَ بَیْنَہُمَا ، فَحَمَلَ عَلَیْہِ عُمَرُ رَجُلاً مِنْ عِنْدِہِ ، فَعَطِبَ الْفَرَسُ ، فَجَعَلاَ بَیْنَہُمَا شُرَیْحًا ، فَقَالَ شُرَیْحٌ لِعُمَرَ : سَلِّمْ مَا ابْتَعْت ، أَوْ رُدَّ مَا أَخَذْت ، فَقَالَ لَہُ : قَضَیْت بِمُرِّ الْحَقِّ۔n قَالَ زَکَرِیَّا : قَالَ عَامِرٌ : وَبَعَثَہُ عَلَی قَضَائِ الْکُوفَۃِ ، وَبَعَثَ کَعْبَ بْنَ سُورٍ عَلَی قَضَائِ الْبَصْرَۃِ۔","","Musannaf Ibn Abi Shaybah 23046","","","كتاب البيوع والأقضية"
