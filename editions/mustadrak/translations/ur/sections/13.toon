"1295","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدًأطرظأڬضۏأوشۏعأڬۏأؼۏتزحأڬشحتأۄەأحًأًۄأتههۄأڬۏأشذوحأوۏڽأزترهأۄًأدتحتأۄەأۏۄتڽأحڬأڬۄأًۄأ+أوشۏعأڬەأځتضأ"
"1296","%أذعشحأؼمثۄأثىأؼتوشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتځىەأوشۏعًڽأڬًأڬہتىەأځشأىتځضىزأوحأڬشًأڬۏًىڬۄأتىۄۏڽأتههۄأحؼتهۏٳأڬہهتحتأتًشأځهتحتأۄەأۗ"
"1297","%أذعشحأۏذۏۏأثىأغهذۄأثىأؼثۏزتههۄأشعۏأتههۄأؼىۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأ+أتۏڬأوشحثۄأ"
"1298","%أذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأتۏڬأزلؼۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوۏڽأتۏڬأتۏضتأڬهوۄأدتىحتأۄًڽأڬۄأتىضتىأىەأتضأڬًأرهًظأزهأضەأځڔہتأۄًأځہشأتضأڬتأتىحمتهأۄًأدتةەأحًأتههۄأحؼتهۏٳأتضأځشأدۄىوأڬۏأإڲأذشتوألشوتأزۏحتأۄەأ؏أځہشأشضًهأتههۄأ﷽أڬتأتىحمتهأۄًأڲۏتأهۏڬىأتضأڬهوۄأڬەأثتشەأوۏڽأإځأؼهۏۄأتهضهتوأىەأڬًةۏأًدتذحأىۄۏڽألشوتةۏأحہۏأۗأذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أوۏڽأحوۄۏڽأثحتحتأۄًڽأڬۄأًۄأڬهوۄأڬۏتأۄەأۗأًۄأڬهوۄأترهتظأۄەأدضأڬەأثتشەأوۏڽأشضًهأتههۄأ﷽أىەأتځىەأډډتأتثًغتهثأڬًأتىأڬۏأًلتحأضەأًمحأحهمۏىأڬۏأحہۏأ؏أتضأثتحأڬۏأڲًتۄۏأزۏىتأڬۄأتههۄأحؼتهۏٳأڬەأضًتأڬًةۏأؼثتزحأڬەأهتةمأىۄۏڽأۄەأۗأتضۏأڬهوەأڬەأسشۏؼەأتههۄأحؼتهۏٳأىەأوذوزأ﷽أتًشأتأڬەأتظذتثأڬًأؼصحأثرطۏأۄەأۗ"
"1299","%أذعشحأوؼتسأثىأدثهأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدضأطرظأڬتأإرشۏأڬهتوأ““أهتأتهۄأتهتأتههۄأ‛‛أۄًأڲتأتههۄأحؼتهۏٳأتضأڬًأدىحأوۏڽأزترهأڬشەأڲتأۗ"
"1300","%أذعشحأدتثشأثىأؼحۏڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أذعشحأؼثزتههۄأثىأختثحأشعۏأتههۄأؼىۄأڬۏأؼۏتزحأڬۏهةەأحطشۏلأهتةەأحًأإځأ﷽أىەأزۏڬہتأڬۄأتىأځشأوًحأڬتأؽهثۄأۄًأډڬتأحہتأۗأإځأ﷽أىەأتىأڬًأإًتصأزۏأ؏أهۏڬىأتىأڬۏأغشلأضەأڬًةۏأدًتثأىۄۏڽأإۏتأحًأشضًهأتههۄأ﷽أىەأ““أتىتأههۄأًتىتأتهۏۄأشتدؼًىأ‛‛أځڔہتأۗأتًشألشوتۏتأ=أتەأتثًتهشثۏؼأ$أۄوۏڽأحدہأځشأؽهثۄأزۏتأڲۏتأۗأحًأؼًشحۏڽأشًىەأتًشأډۏرىەأهڲۏڽأتًشأتثىأؼحۏڬأتىأڬًأرتوًطأڬشتىەأهڲەأۗأشضًهأتههۄأ﷽أىەألشوتۏتأ=أتىأڬًأډہًڔأزًأ$أڬۏًىڬۄأدثأًتدثأۄًأدتةەأڲتأحًأڬًةۏأشًىەأًتهۏأىۄۏڽأشًةەأڲۏأۗأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأىەأځًډہتأ$أًدًثأڬۏتأۄًحتأۄەأآأإځأ﷽أىەألشوتۏتأ=أدثأًۄأوشأدتةەأڲتأۗأتضأڬۏأثۏټۏأتځىەأثتځأڬًأورتغثأڬشأڬەأثًهۏأ=أرزتأڬۏأمضوأ$أوۏڽأحًأإځأڬەأطۄۏزأۄًىەأڬۏأإشصًأشڬہحۏأحہۏأڬۏًىڬۄأإځأىەأتځىۏأوڬوهأحۏتشۏأڬشأشڬہۏأحہۏأۗأحًأشضًهأتههۄأ﷽أىەألشوتۏتأ=أتههۄأحؼتهۏٳأىۏحأڬەأوغتثمأتدشأًأخًتثأؼغتألشوتحتأۄەأ+أځہشأإځأ﷽أىەأځًډہتأ"
"1301","%أذعشحأطزتزأثىأتًضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدثأحوأڬضۏأوۏحأڬەأځتضأذتعشأۄًأحًأتضأڬۏأإىڬہۏڽأثىزأڬشأزۏتأڬشًأڬۏًىڬۄأوۏحأڬەأڲہشأًتهەأوۏحأڬەأهۏەأدًأزؼتأڬشحەأۄۏڽأتضأځشأوهتةڬۄأإوۏىأڬۄحەأۄۏڽأۗ"
"1302","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أوًوىأڬتأدثأإرشۏأًمحأإحتأۄەأحًأشذوحأڬەألشطحەأضلۏزأشىڲأڬتأشۏطوۏأهثتضأهەأڬشأإحەأۄۏڽأتًشأڬۄحەأۄۏڽأ=أحدہأځشأتههۄأشتعۏأۄەأ؏أحًأثشعتأًأرًطۏأتههۄأحؼتهۏٳأڬۏأثتشڲتۄأڬۏأغشلأډهأۗأحًأ+أ+أتضأڬۏأشًذأ"
"1303","%أۄطتوأشعۏأتههۄأؼىۄأڬۏأضىزأڬەأۄوشتۄأثہۏأوسڬًشۄأذزۏخأوشًۏأۄەأۗ"
"1304","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أدثأوًوىأڬۏأوًحأڬتأًمحأإحتأۄەأحًأشذوحأڬەألشطحەأتضأڬەأځتضأإحەأۄۏڽأ؏أځہشأتضأڬەأثؼزأضتثمۄأذزۏخأدۏضۏأذزۏخأثۏتىأڬۏأۄەأۗ"
"1305","%أذعشحأۏذۏۏأثىأؼثزتههۄأثىأتثۏأمحتزۄأشعۏأتههۄأؼىۄأتځىەأًتهزأڬتأثۏتىأىمهأڬشحەأۄۏڽأ=أدثأشضًهأتڬشوأ﷽أوزۏىۄأوىًشۄأحطشۏلأهتةەأحًأذعشحأثشتؤأثىأوؼشًشأشعۏأتههۄأؼىۄأڬەأوحؼهمأځًډہتأ=أحًأهًڲًڽأىەأثحتۏتأڬۄأًۄأًلتحأځتأډڬەأۄۏڽأتًشأۏتأشضًهأتههۄأ﷽أ$أتىۄًڽأىەأإځأڬەأهۏەأتځىەأتۏڬأحۄتةۏأوتهأڬۏأًظۏحأثہۏأڬۏأۄەأتًشأتىۄًڽأىەأۏۄأثہۏأًظۏحأڬۏأحہۏأڬۄأدثأتىأڬتأتىحمتهأۄًأدتةەأحًأتىأڬتأډۄشۄأمثهۄأڬۏأدتىثأڬشأزۏتأدتةەأۗأحًأشضًهأتههۄأ﷽أىەألشوتۏتأ=أتىأڬتأؼوهألغشحأڬەأؼۏىأوغتثمأۄەأۗأتًشأوۏڽأتضأڬتأخهخأ+أحۏضشتأذظۄأدًأتضأىەأوۏشەأهۏەأًظۏحأڬۏتأۄەأ"
"1306","%أذعشحأضهۏوتىأثىأثشۏزۄأشعۏأتههۄأؼىۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأدثأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأشضًهأتڬشوأ﷽أڬًأؽضهأزۏىەأهڲەأحًأتۏڬأىزتؤأإةۏأ+أًۄأىزتؤأۏۄأحہۏأ"
"1307","%أذعشحأتثًشتلؼأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدًأطرظأوۏحأڬًأؽضهأزەأتًشأتضأڬۏأؼۏثأځًطۏأڬشەأ؏أتضأڬۏأډتهۏضأوشحثۄأوؽلشحأڬشأزۏأدتحۏأۄەأتًشأدًأڬضۏأوۏحأڬًأڬلىأځۄىتةەأ؏أتههۄأحؼتهۏٳأتضأڬًأدىحأڬتأشۏطوۏأهثتضأځۄىتةەأڲتأ؏أتًشأدًأطرظأڬضۏأوۏحأڬەأهۏەأمثشأڬہًزەأتًشأتضأڬًأزلىتةەأحًأتههۄأحؼتهۏٳأتضأڬًأمۏتوحأحڬأتضأطرظأڬەأثشتثشأخًتثأزەأڲتأدضأىەأوڬتىأثىتأڬشأڬضۏأ+أعشًشحأوىزأ"
"1308","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أحوۄتشەأهۏەأثۄحشۏىأهثتضأ““أضلۏزأ‛‛أۄەأ؏أتځىەأصىزًڽأڬًأثہۏأۏۄۏأهثتضأځۄىتاأتًشأتځىەأوشزًڽأڬًأثہۏأتضۏأوۏڽأڬلىأزًأۗ"
"1309","أذعشحأضوشۄأثىأدىزثأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أضلۏزأهثتضأځۄىتأڬشًأتًشأتضۏأوۏڽأتځىەأوشزًڽأڬًأڬلىأزۏتأڬشًأڬۏًىڬۄأ+أزًضشەأشىڲًڽأڬۏأثۄأىضثحأ"
"1310","%أذعشحأدتثشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدثأوۏحأڬًأهەأڬشأډهًأحًأحۏصأحۏصأمزوأتټہتاأتًشأثتشۏأثتشۏأڬىزہتأزًأۗ"
"1311","%أذعشحأتثًثڬشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أۄوأىەأشضًهأتڬشوأ﷽أڬەأۄوشتۄأًمحأڲصتشتأۄەأ؏أۄوأ““أدىتصۄأ‛‛أڬًأثۄحأحۏصۏأڬەأضتحہأهەأڬشأډهتأڬشحەأحہەأۗ"
"1312","ذعشحأتثىأتثۏأصىتزأشعۏأتههۄأؼىۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأوۏڽأؼثزتههۄأثىأدؼلشأثىأتثۏأغتهثأڬەأۄوشتۄأثمۏؼأوۏڽأثۏټہتأۄًتأحہتأڬۄأتۏڬأدىتصۄأإأڲۏتأ؏أتثىأدؼلشأڬًأتىأهًڲًڽأڬۏأضضحأشًۏأځشأثۄحأذۏشتىڲۏأۄًةۏأتًشأڬۄىەأهڲەأ=أودہەأحؼدثأۄەأ؏أڬۄأهًڲًڽأڬەأتذًتهأتضأمزشأثزهأډڬەأۄۏڽأ؏أرزتأڬۏأمضوأ+أشضًهأتههۄأ﷽أڬەأصوتىەأوۏڽأ"
"1313","%أذعشحأوؽۏشۄأثىأطؼثۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أځۏزهأډهىەأًتهتأ؏أدىتصۄأڬەأإڲەأۄًأتًشأضًتشأځۏډہەأۄًأتًشأثډەأڬۏأىوتصأدىتصۄأثہۏأځڔہۏأدتةەأۗ"
"1314","%أذعشحأخًثتىأشعۏأتههۄأؼىۄأضەأوىمًهأۄەأڬۄأشضًهأتههۄأ﷽أتۏڬأدىتصۄأڬەأۄوشتۄأډهەأحًأإځأڬۏأرزوحأوۏڽأضًتشۏأځۏطأڬۏأڲةۏأ؏أهۏڬىأإځأىەأتضأځشأضًتشأۄًىەأضەأتىڬتشأڬشأزۏتأ؏أځہشأدثأدىتصۄأضەألتشؽأۄًأڬشأًتځضأځهټەأحًأزًثتشۄأضًتشۏأځۏطأڬۏأڲةۏأحًأإځأتضأځشأضًتشأۄًأڲةەأ؏أإځأ﷽أضەأتضأڬۏأًدۄأزشۏتلحأڬۏأڲةۏأحًأإځأ﷽أىەألشوتۏتأ=أ+أدىتصۄأڬەأۄوشتۄأ"
"1315","أذعشحأخًثتىأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أشضًهأتههۄأ﷽أتۏڬأدىتصەأڬەأۄوشتۄأحطشۏلأهەأدتأشۄەأحہەأڬۄأڬډہأهًڲًڽأڬًأزۏڬہتأڬۄأًۄأضًتشۏًڽأځشأضًتشأحہەأإځأ﷽أىەأتىأضەألشوتۏتأ=أڬۏتأحوۄۏڽأذۏتأىۄۏڽأۄەأآأتههۄأڬەألشطحەأحوۄتشەأمزوًڽأڬەأثشتثشأۄۏڽأتًشأحوأدتىًشًڽأڬۏأځۏټہأځشأډڔہەأۄًةەأۄًأۗأ"
"1316","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أدثأڬضۏأدىتصۄأڬەأۄوشتۄأدتحەأحًأدثأحڬأتضأڬًأڬىزہًڽأضەأتحتشأڬشأشڬہأىۄۏڽأزۏتأدتحتأحہتأ؏أإځأثۏټہحەأىۄۏڽأحہەأۗ"
"1317","%أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أدثأحوأڬضۏأدىتصۄأڬەأضتحہأدتاأحًأتضأًمحأحڬأوحأثۏټہًأ؏أدثأحڬأدىتصۄأ+أڬىزہًڽأضەأتحتشأڬشأىۏډەأ"
"1318",""" حضرت سالم بن عبداللہ بن عمر رضی اللہ عنہما اپنے والد کا یہ بیان نقل کرتے ہیں کہ رسول اللہ ﷺ کے پاس سے جب کوئی جنازہ گزرتا تو جب تک وہ گزرتا رہتا آپ کھڑے رہتے ۔\n ٭٭ یہ حدیث امام بخاری رحمۃ اللہ علیہ و امام مسلم رحمۃ اللہ علیہ دونوں کے معیار کے مطابق صحیح ہے لیکن دونوں نے ہی اسے نقل نہیں کیا ۔ اور ابن عمر رضی اللہ عنہما کی عامر بن ربیعہ سے روایت کی گئی حدیث کا متن یہ نہیں ہے ۔ کیونکہ وہ متن جنازہ کے ہمراہ چلنے کے متعلق ہے اور یہ جنازہ کیلئے قیام کا ہے اور اس میں روایات کا بہت زیادہ اختلاف ہے ۔"" \nالمستدرك على الصحيحين حدیث: 1318 عربی حدیث: 1318"
"1319","%أذعشحأؼهتؤأثىأؼثزتهشذوىأشعۏأتههۄأؼىۄأتځىەأًتهزأڬتأۏۄأثۏتىأشًتۏحأڬشحەأۄۏڽأ=أًۄأتۏڬأتۏضەأدىتصەأوۏڽأطشۏڬأۄًةەأدضأڬۏأىوتصأوشًتىأثىأذڬوأىەأځڔہتةۏأحہۏأځہشأذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأوشًتىأڬەأۄوشتۄأمثشضحتىأوۏڽأإأڬشأثۏټہأڲةەأۗأتىأڬەأځتضأتثًضؼۏزأرزشۏأإةەأتًشأوشًتىأضەأڬۄىەأهڲەأ=أتځىتأۄتحہأودہەأزۏدۏەأ=أوشًتىأىەأتځىتأۄتحہأتثًضؼۏزأڬەأۄتحہأوۏڽأزۏتأ؏أحًأتثًضؼۏزأ+أتىأڬتأۄتحہأځڬڔأڬشأثًهەأ"
"1320","%أذعشحأؼثزتههۄأثىأؼوشًأثىأؼتظأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتۏڬأطرظأىەأشضًهأتههۄأ﷽أضەأځًډہتأ=أۏتأشضًهأتههۄأ﷽أتڲشأۄوتشەأمشۏثأضەأڬلتشأڬتأدىتصۄأڲصشەأحًأڬۏتأۄوۏڽأڬہڔەأۄًىتأډتۄۏەأآأإځأ﷽أىەألشوتۏتأ=أۄتڽأۗأتضأڬەأهۏەأثہۏأڬہڔەأۄًڽأ؏أڬۏًىڬۄأحوۄتشتأڬہڔتأۄًىتأ؏أتضأڬتلشأڬۏأوۏحأڬەأهۏەأىۄۏڽأثهڬۄأتىأوهتةڬۄأڬەأتذحشتوأڬەأهۏەأۄًأڲتأدىۄًڽأىەأتضأڬۏأشًذأمثعأڬۏأۄەأۗ"
"1321","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أڬەأځتضأضەأتۏڬأۏۄًزۏأڬتأدىتصۄأڲصشتأحًأإځأ﷽أڬہڔەأۄًأڲةەأۗأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أ$أۏۄأحًأۏۄًزۏأڬتأدىتصۄأۄەأۗأإځأ﷽أىەألشوتۏتأ=أوۏڽأحًأوهتةڬۄأڬەأتذحشتوأوۏڽأڬہڔتأۄًتأحہتأۗ"
"1322","%أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أۄوأشضًهأتڬشوأ﷽أڬەأىوتةىزەأۄًتأڬشحەأحہەأۗأډىتىډۄأدثأڬضۏأڬتأإرشۏأًمحأإحتأحًأۄوأشضًهأتڬشوأ﷽أڬًأتغهتؼأڬشحەأحًأذعًشأتڬشوأ﷽أحطشۏلأهتأڬشأتضأڬەأهۏەأزؼتةەأوؽلشحألشوتحەأتًشأدثأۄوأهًڲأًۄتڽأځۄىډحەأحًأشضًهأتههۄأ﷽أتًشأدًأهًڲأإځأڬەأۄوشتۄأۄًحەأًۄأًتځضأإأشۄەأۄًحەأحہەأۗأڬةۏأوشحثۄأإځأ﷽أحزلۏىأحڬأًۄۏڽأشڬەأشۄحەأتًشأڬةۏأوشحثۄأ+أإځأڬًأدتىڬىۏأڬەأتىحػتشأوۏڽأ"
"1323","%أذعشحأضؼۏزأتثىأتثۏأضؼۏزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتثىأؼثتضأشعۏأتههۄأؼىۄوتأىەأتۏڬأدىتصۄأځڔہتۏتأ؏أتضأوۏڽأثهىزأإًتصأضەأضًشۄألتحذۄأځڔہۏأۗأځہشأ+أدىتصۄأضەألتشؽأۄًأڬشأ"
"1324","%أذعشحأغهذۄأثىأؼثزتههۄأثىأؼًلأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتأڬەأځۏډہەأتۏڬأىوتصأدىتصۄأځڔہۏأحًأوۏڽأىەأتىأڬًأضًشۄألتحذۄأځڔہحەأضىتأ؏أدثأًۄأىوتصأضەألتشؽأۄًةەأحًأوۏڽأىەأتىأڬتأۄتحہأځڬڔأڬشأتىأضەأځًډہتأ=أڬۏتأإځأمشتؤحأڬشحەأۄۏڽأآأتىۄًڽأىەأدًتثتَأڬۄتأ=أدۏأۄتڽأۗأۏۄأذمأۄەأتًشأۏۄأ““أضىحأ‛‛أۄەأۗ"
"1325","أذعشحأدتثشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىوتصأدىتصۄأوۏڽأډتشأحڬثۏشۏڽأځڔہتأڬشحەأحہەأ؏أتىأوۏڽأضەأځۄهۏأحڬثۏشأڬەأثؼزأضًشۄألتحذۄأځڔہتأڬشحەأحہەأۗأ"
"1326","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأضەأوشًۏأۄەأڬۄأشضًهأتههۄأ﷽أدثأڬًةۏأىوتصأدىتصۄأځڔہتحەأحًأتضأوۏڽأۏًڽأزؼتأوتىڲتأڬشحەأحہەأۗ"
"1327","أذعشحأتثًضهوۄأثىأؼثزتهشذوىأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأتوأتهوًوىۏىأضۏزۄأؼتةطۄأشعۏأتههۄأؼىۄتأضەأځًډہتأ=أىثۏأتڬشوأ﷽أىوتصأدىتصۄأڬۏضەأځڔہتأڬشحەأحہەأآأتىۄًڽأىەأدًتثتَألشوتۏتأ=أإځأۏًڽأزؼتأوتىڲتأڬشحەأحہەأ=““أ®تههّٔيْؤّأتؽٕلٓشٕأهٓذٍّٔٓىّتأًّؤٍّٓحٓىّت؏أًّسّنّشٓىّتأًّئْىٕخّتىّت؏أًّطّتيٓزٓىّتأًّؽّتةٓثٓىّت؏أًّظّؽٍٓشٓىّتأًّنّثٍٓشٓىّت؏أتههّٔيْؤّأوّىٕأئّذٍٍّٕٕحّيْأوٓىّٔتألّئّذٍٕٓيٓأؼّهٌّأتهٕبٓضٕهّتوٓ؏أًّوّىٕأحًّّلٍّٕٔحّيْأوٓىّٔتألّحًّّلّٔيْأؼّهٌّأتهٕبٍٓوّتىٓ¾أۗ‛‛أ"
"1328","%أذعشحأۏصۏزأثىأؼثزتههۄأثىأشڬتىۄأثىأؼثزتهوغهثأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أدثأدىتصۄأځڔہحەأحًأتضأوۏڽأۏًڽأزؼتأوتىڲحەأ““أ®تههّٔيْؤّأؼّثٕزْنّ؏أًّتثٕىْأئّوّحٓنّأتذٕحّتدّأبٓهٌّأشّذٕوّحٓنّ؏أًّئّىٕحّأؽّىٍُٓٔأؼّىٕأؼّسّتثٓيٓأبٓىٕأنّتىّأوْذٕضٓىَتألّصٓزٕألٍٓأبٓذٕضّتىٓيٓ؏أًّبٓىٕأنّتىّأوْضٍٓةَتألّحّدّتًّصّأؼّىٕيْ¾أۗ‛‛"
"1329","%أذعشحأطشذثۏهأثىأضؼزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأىەأتثًتؤأوۏڽأۄوۏڽأىوتصأدىتصۄأځڔہتةۏأۗأتىۄًڽأىەأحڬثۏشأڬۄۏأځہشأثهىزأإًتصأضەأ““أضًشۄألتحذۄأ‛‛أځڔہۏأځہشأىثۏأتڬشوأ﷽أځشأزشًزأځڔہتأځہشأۏًڽأزؼتأوتىڲۏأ““أ®تههّٔيْؤّأؼّثٕزْنّ؏أًّتثٕىْأؼّثٕزٓنّ؏أًّتثٕىْأئّوّحٓنّ؏أٍّطٕيّزْأئّىٕأهّتأبٓهّيّأبٓهّٔتأئّىٕحّأًّذٕزّنّأهّتأطّشٍٓنّأهّنّ؏أًٍّّطٕيّزْأئّىّٔأوْذّؤّزَتأؼّثٕزْنّأًّشّضًْهْنّ؏أئّظٕثّذّألّمٍٓشَتأبٓهٌّأشّذٕوّحٓنّ؏أًّئّظٕثّذٕحّأؽّىٍَٓٔتأؼّىٕأؼّسّتثٓيٓ؏أٍْرّهٌّٔأوٓىّأتهزْٔىٍّٕتأًّئّيٕهٓيّت؏أبٓىٕأنّتىّأصّتنٍَٓتألّصّنٔٓيٓ؏أًّبٓىٕأنّتىّأوْرٕغٓةَتألّتؽٕلٓشٕأهّيْأتههّٔيْؤّأهّتأحّذٕشٓوٕىّتأئّدٕشّيْ؏أًّهّتأحْعٓهّٔىّتأثّؼٕزّيْ¾أ‛‛"
"1330","%أذعشحأؼثزتههۄأثىأتثۏأتًلۏٳأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتىأڬۏأثۏټۏأڬتأتىحمتهأۄًأڲۏتأ؏أًۄأتۏڬأرډشأځشأضًتشأدىتصەأڬەأځۏډہەأإأشۄەأحہەأتًشأؼًشحۏڽأوشخۏەأځڔہأشۄۏأحہۏڽأ؏أتىۄًڽأىەأڬۄتأ=أۏۄأؼًشحۏڽأوشخۏەأځڔہۏڽأۏتأىۄأځڔہۏڽأ؏أشضًهأتههۄأ﷽أىەأوشخۏەأځڔہىەأضەأوىؼألشوتۏتأۄەأۗأتهثحۄأإىضًأدحىەأډتۄۏڽأثۄتأضڬحۏأۄۏڽأۗأځہشأتضأڬۏأىوتصأدىتصۄأځڔہتةۏأتًشأډتشأحڬثۏشۏڽأځڔہۏڽأۗأځہشأإځأډًحہۏأحڬثۏشأڬەأثؼزأتحىۏأزۏشأڬہڔەأوۏحأڬەأهۏەأزؼتأًأتضحؽلتشأڬشحەأشۄەأدحىۏأزۏشأزًأحڬثۏشًڽأڬەأزشوۏتىأڬتأزًشتىۏۄأحہتأتًشأتىۄًڽأىەألشوتۏتأ=أشضًهأتههۄأ﷽أتۏضەأۄۏأڬۏتأڬشحەأحہەأۗ"
"1331","%أذعشحأتثًؼتوشأثىأضہهأثىأذىۏلأشعۏأتههۄأؼىۄأتىظتشأڬەأؼهوتؤأتًشأوؼصصأهًڲًڽأوۏڽأطوتشأۄًحەأۄۏڽأتًشأۏۄأتىأهًڲًڽأوۏڽأضەأۄۏڽأدًأشضًهأتههۄأ﷽أڬەأۄوشتۄأؽصًۄأثزشأوۏڽأطشۏڬأۄًةەأۗأتىأڬًأشضًهأتههۄأ﷽أڬەأظذتثۄأشعۏأتههۄأؼىۄوأوۏڽأضەأثؼعأىەأىوتصأدىتصۄأڬەأوحؼهمأثحتۏتأڬۄأتوتوأحڬثۏشأڬۄەأڲتأ؏أځہشأىثۏأتڬشوأ﷽أځشأزشًزأځڔہەأڲتأتًشأحۏىأحڬثۏشتحأځشأىوتصأځًشۏأڬشەأڲتأتًشأإرشأوۏڽأورحظشأضهتوأځہۏشەأڲتأتًشأىوتصأڬەأثؼزأضىحأًۄأۄەأدًأتثًتوتوۄأىەأؼوهأڬۏتأۗ"
"1332",""" حضرت ابوہریرہ رضی اللہ عنہ سے مروی ہے کہ رسول اللہ ﷺ نے ایک نماز جنازہ پڑھائی ، اس میں چار تکبیریں کہیں اور ایک سلام ۔\n ٭٭ نماز جنازہ میں ایک سلام کے متعلق حضرت علی بن ابی طالب عبداللہ بن عمرو ، عبداللہ بن عباس ، جابر بن عبداللہ بن ابی اوفیٰ اور حضرت ابوہریرہ رضی اللہ عنہم سے یہ صحیح روایت منقول ہے کہ یہ لوگ نماز جنازہ میں ایک سلام پھیرا کرتے تھے ۔"" \nالمستدرك على الصحيحين حدیث: 1332 عربی حدیث: 1332"
"1333","%أذعشحأؼثزتههۄأثىأثشۏزۄأشعۏأتههۄأؼىۄأتځىەأًتهزأضەأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوًحأڬەأًمحأوًوىأڬۏأځۏطتىۏأځشأځضۏىۄأۄًحتأۄەأۗ"
"1334","%أتوأتهوًوىۏىأضۏزۄأؼتةطۄأشعۏأتههۄأؼىۄتأثۏتىأڬشحۏأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەأؼخوتىأثىأوػؼًىأڬۏأوۏحأڬًأشًحەأۄًةەأثًضۄأزۏتأۗأشتًۏأڬۄحەأۄۏڽأ=أإځأ﷽أڬۏأإىڬہًڽأضەأإضًأثۄۄأشۄەأحہەأۗ"
"1335","%أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أ+أوۏحأڬەأهۏەأ"
"1336","%أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄأضەأوشًۏأۄەأڬۄأىثۏأتڬشوأ﷽أضەأوطڬأڬەأثتشەأوۏڽأځًډہتأڲۏتأ=أحًأإځأ﷽أىەألشوتۏتأ=أًۄأثۄحشۏىأرًطثًأۄەأۗ"
"1337","أذعشحأتثًًتةهأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أذعشحأؼهۏأشعۏأتههۄأؼىۄأڬەأځتضأوطڬأحہۏأ؏أتىۄًڽأىەأًظۏحأڬۏأحہۏأڬۄأًلتحأڬەأثؼزأتىأڬًأۏۄۏأرًطثًأهڲتةۏأدتةەأتًشأذعشحأؼهۏأشعۏأتههۄأؼىۄألشوتحەأحہەأۏۄأًۄأرًطثًأۄەأدًأشضًهأتههۄأ﷽أڬًأثؼزأتصأتىحمتهأهڲتىەأضەأثډۏأحہۏأۗأ"
"1338","%أذعشحأتثًثشزۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأ=أظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأشضًهأتههۄأ﷽أڬًأؽضهأزۏىەأهڲەأحًأۄتحلأؽۏثۏأضەأإًتصأإةۏأ=أشضًهأتههۄأ﷽أڬۏأموۏظأوحأتحتشىتأۗ"
"1339","أذعشحأضؼۏزأثىأوضۏثأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أذعشحأؼهۏأثىأتثۏأغتهثأشعۏأتههۄأؼىۄأىەأتشطتزألشوتۏتأ=أوۏڽأىەأشضًهأتههۄأ﷽أڬًأؽضهأزۏتأ؏أودہەأإځأ﷽أوۏڽأؼتوأوشزًڽأدۏضۏأڬًةۏأډۏصأىػشأىۄۏڽأإةۏأۗأتًشأإځأ﷽أصىزڲۏأوۏڽأثہۏأغۏثأحہەأتًشأثؼزأتصأتىحمتهأثہۏأغۏثأۄۏأحہەأۗأإځأ﷽أىەأتځىەأڬلىأزلىأڬەأتوًشأډتشأإزوۏًڽأڬەأسوۄأهڲتةەأحہەأۗأؼهۏأ؏أؼثتضأ؏أتًشأشضًهأتههۄأ﷽أڬەأإصتزأڬشزۄأؽهتوأ““أظتهذأ‛‛ۗأشضًهأتههۄأ﷽أڬۏأمثشأهذزأًتهۏأثىتةۏأڲةۏأتًشأتضأڬەأتًځشأتۏىټأڲتڔہأزۏأڲةۏأۗأ"
"1340","%أذعشحأتثًشتلؼأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدًأطرظأوۏحأڬًأؽضهأزەأتًشأتضأڬەأؼۏًثأڬًأډہځتةەأ؏أتضأڬۏأډتهۏضأوشحثۄأوؽلشحأڬشأزۏأدتحۏأۄەأۗأتًشأدًأڬضۏأوۏحأڬًأڬلىأځۄىتةەأ؏أتههۄأحؼتهۏٳأتضأڬًأدىحأڬتأشۏطوۏأهثتضأځۄىتةەأڲتأتًشأدًأطرظأڬضۏأوۏحأڬەأهۏەأمثشأڬہًزەأتًشأتضأڬًأزلىتةەأحًأتههۄأحؼتهۏٳأتضأڬًأمۏتوحأحڬأتضأطرظأڬەأثشتثشأخًتثأزەأڲتأ؏أدضأىەأوڬتىأثىتأڬشأڬضۏأ+أعشًشحأوىزأ"
"1341","%أذعشحأوتهڬأثىأۄثۏشۄأشعۏأتههۄأؼىۄأظذتثۏأشضًهأۄۏڽأ؏أتىأڬًأدثأىوتصأدىتصۄأځڔہتىەأڬەأهۏەأثهتۏتأدتحتأحًأدىتصۄأځڔہىەأًتهًڽأڬًأڬۄحەأ=أحۏىأظلۏڽأثىتأهۏڽأتًشأًۄأهًڲًڽأڬًأىوتصأدىتصۄأځڔہتأزۏحەأتًشأځہشأڬۄحەأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدضأدىتصەأځشأوضهوتىًڽأڬۏأحۏىأظلۏڽأثىأدتةۏڽأ؏أًۄأدىحۏأۄەأۗ"
"1342","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أتۏڬأۏۄًزۏأڬتأثډۄأىثۏأتڬشوأ﷽أڬۏأرزوحأڬۏتأڬشحتأحہتأ؏أتۏڬأوشحثۄأًۄأثۏوتشأۄًأڲۏتأ؏أحًأشضًهأتههۄأ﷽أتضأڬۏأؼۏتزحأڬەأهۏەأحطشۏلأهەأڲةەأتًشألشوتۏتأ=أحوأڲًتۄۏأزًأڬۄأتههۄأڬەأضًتأڬًةۏأؼثتزحأڬەأهتةمأىۄۏڽأۗأ+أتًشأوۏشەأوحؼهمأڬۄًأ"
"1343","%أذعشحأوؽۏشۄأثىأطؼثۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أضًتشأدىتصەأڬەأځۏډہەأډهەأتًشأځۏزهأډهىەأًتهتأدىتصەأڬەأمشۏثأشۄەأتًشأثډەأڬۏأىوتصأدىتصۄأثہۏأځڔہۏأدتةەأڲۏأۗ"
"1344","%أذعشحأوؽۏشۄأثىأطؼثۄأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أضًتشأدىتصەأڬەأځۏډہەأډهەأ؏أځۏزهأډهىەأًتهەأدىتصەأڬەأمشۏثأ؏أتضأڬەأزتةۏڽأثتةۏڽأډهۏڽأتًشأىتحوتوأثډەأڬۏأثہۏأىوتصأدىتصۄأځڔہۏأدتةەأتًشأتضأڬۏأىوتصأدىتصۄأوۏڽأتضأڬەأوتڽأثتځأڬەأهۏەأشذوحأتًشأؼتلۏحأڬۏأزؼتأوتىڲۏأدتةەأۗ"
"1345","%أذعشحأدتثشأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدثأ+أىًوًهًزأ"
"1346","%أذعشحأصۏزأثىأرتهزأدہىۏأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أۄوأىثۏأتڬشوأ﷽أڬەأۄوشتۄأرۏثشأوۏڽأحہەأحًأۄوأوۏڽأضەأتطدؼأمثۏهەأڬتأتۏڬأإزوۏألًحأۄًأڲۏتأ؏أشضًهأتههۄأ﷽أىەألشوتۏتأ=أتضأڬۏأىوتصأدىتصۄأځڔہًأ؏أۄوۏڽأتىأوۏڽأډىزأتۏضەأ““أىڲأ‛‛أوهەأدًأۏۄًزۏأځۄىتأڬشحەأۄۏڽأتىأڬتأًصىأزًأزشۄوًڽأڬەأثشتثشأۄًأڲتأۗ"
"1347","%أذعشحأدتثشأثىأضوشۄأشعۏأتههۄأؼىۄأڬۄحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬەأصوتىەأوۏڽأتۏڬأطرظألًحأۄًأڲۏتأ؏أتۏڬأإزوۏأىثۏأتڬشوأ﷽أڬەأځتضأإۏتأتًشأإځأ﷽أڬًأثحتۏتأڬۄألهتڽأطرظألًحأۄًأڲۏتأۄەأ؏أىثۏأتڬشوأ﷽أىەأتىۄۏڽأڬۄتأ=أًۄألًحأىۄۏڽأۄًتأ؏أًۄأزًثتشۄأإۏتأتًشأڬۄىەأهڲتأ=ألهتڽأطرظألًحأۄًأڲۏتأۄەأۗأشضًهأتههۄأ﷽أىەألشوتۏتأ=أًۄألًحأىۄۏڽأۄًتأ؏أًۄأحۏضشۏأوشحثۄأځہشأإۏتأتًشأڬۄتأ=ألهتڽأطرظألًحأۄًأڲۏتأۄەأۗأحًأشضًهأتههۄأ﷽أىەألشوتۏتأ=أًۄأڬۏضەألًحأۄًتأآأتضأىەأڬۄتأ=أتضأىەأتځىەأحۏشأضەأتځىەأإځأڬًأۄهتڬأڬشأهۏتأحًأىثۏأتڬشوأ﷽أىەأتضأڬۏأىوتصأدىتصۄأىۄۏڽأځڔہۏأۗ"
"1348","%أذعشحأتثًمحتزۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أڬًأدثأڬضۏأدىتصەأڬەأهۏەأثهتۏتأدتحتأحًأإځأ﷽أتضأڬەأثتشەأوۏڽأځًډہحەأ؏أتڲشأهًڲأتضأڬًأتډہەأهلػًڽأوۏڽأۏتزأڬشحەأحًأإځأ﷽أتضأڬتأدىتصۄأځڔہتأزۏحەأتًشأتڲشأهًڲأتضأڬًأثشتأثہهتأڬۄحەأحًأإځأ﷽أتضأڬەأڲہشأًتهًڽأضەأڬۄۄأزۏحەأڬۄأتضأڬتأدىتصۄأحأځڔہأهًأتًشأإځأ﷽أتضأڬتأدىتصۄأىۄأځڔہتحەأۗ"
"1349","%أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أۄوأشضًهأتههۄأ﷽أڬەأىوتةىزەأۄًحەأحہەأ؏أډىتىډۄأدثأڬضۏأڬتأإرشۏأًمحأإحتأحًأۄوأشضًهأتههۄأ﷽أڬًأتغهتؼأزۏحەأحًأذعًشأتڬشوأ﷽أحطشۏلأهتأڬشأتضأڬەأهۏەأزؼتةەأوؽلشحألشوتحەأتًشأدثأۄوأهًڲأًۄتڽأځۄىډحەأحًأشضًهأتههۄأ﷽أتًشأدًأهًڲأإځأڬەأۄوشتۄأۄًحەأًۄأًتځضأإأشۄەأۄًحەأحہەأۗأتًشأتضأڬًأزلىأڬشأزۏتأدتحتأحہتأۗأتًشأڬةۏأوشحثۄأذعًشأتڬشوأ﷽أڬًأحڬلۏىأًأحزلۏىأڬەأضهضهەأوۏڽأثۄحأزۏشأحڬأتىحػتشأڬشىتأځڔحتأۗأۄوۏڽأشضًهأتههۄأ﷽أڬۏأتضأوطمحأڬتأثۄحأتذضتضأۄًتأ؏أۄوأىەأإځضأوۏڽأوطًشۄأڬۏتأڬۄأۄوۏڽأڬضۏأڬۏأشًذأمثعأۄًىەأضەأځۄهەأشضًهأځتڬأ﷽أڬًأىۄۏڽأثهتىتأډتۄۏەأتًشأدثأشًذأمثعأۄًأدتةەأحثأإځأڬًأثهتىتأډتۄۏەأحًأتضأوۏڽأإځأڬًأوطمحأىۄۏڽأۄًأڲۏأتًشأتىحػتشأثہۏأىۄۏڽأڬشىتأځڔەأڲتأ+أتضأڬەأثؼزأۄوأىەأۏۄۏأغشۏمۄأتځىتأهۏتأڬۄأ"
"1350","%أذعشحأتضذتمأثىأؼثزتههۄأثىأتثًغهذۄأشعۏأتههۄأؼىۄأتځىەأًتهزأضەأشًتۏحأڬشحەأۄۏڽأڬۄأتثًغهذۄأىەأشضًهأتههۄأ﷽أڬًأذعشحأؼوۏشأثىأتثۏأغهذۄأڬەأدىتصەأڬەأهۏەأثهتۏتأحًأشضًهأتههۄأ﷽أتىأڬەأځتضأحطشۏلأهەأإةەأتًشأتىأڬەأڲہشأوۏڽأتىأڬۏأىوتصأدىتصۄأځڔہتةۏأ+أىوتصأڬەأڬۏەأ"
"1351","أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدىڲأتذزأڬەأزىأ+أىثۏأتڬشوأ﷽أڬەأډډتأ"
"1352","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأڬۄأتذزأڬەأطۄزتؤأڬًأؽضهأىۄۏڽأزۏتأڲۏتأتًشأتىۄۏڽأ““أرًىأ‛‛أضوۏحأزلىأڬۏتأڲۏتأتًشأىۄأۄۏأتىأڬۏأىوتصأدىتصۄأځڔہۏأڲةۏأحہۏأۗ"
"1353","%أذعشحأتثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدثأحوأوۏحأڬًأمثشأوۏڽأشڬہًأحًأ““أ®ثٓضٕوٓأتههّٔيٓأًّؼّهٌّأوٓهّٔجٓأشّضًْهٓأتههّٔيٓ¾أ‛‛أځڔہتأڬشًأۗ"
"1354","%أذعشحأتثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأدثأًۄأوۏحأڬًأمثشأوۏڽأتحتشحەأحًأ““أ®ثٓضٕوٓأتههّٔيٓأًّؼّهٌّأضْىّٔجٓأشّضًْهٓأتههّٔيٓ¾أ‛‛أځڔہحەأۗ"
"1355","أذعشحأثۏتعۏأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدثأوۏحأڬًأمثشأوۏڽأتحتشتأدتةەأحًأتحتشىەأًتهەأتحتشحەأًمحأ““أ®ثٓتضٕوٓأتههّٔيٓأًّثٓتههّٔيٓ؏أًّؼّهٌّأوٓهّٔجٓأشّضًْهٓأتههّٔيٓأظّهٌّٔأتههيْأؼّهٍّٕيٓأًّضّهّٔوّ¾أ‛‛أځڔہۏڽأۗأ"
"1356","%أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أمثشأڬەأځتضأ+أشڬہۏأۄًةۏأ"
"1357","أذعشحأدىزثأثىأضلۏتىأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدثأتههۄأحؼتهۏٳأڬضۏأثىزەأڬۏأڬضۏأورظًظأدڲۄأځشأشًذأمثعأڬشىەأڬتأتشتزۄأڬشحتأۄەأحًأًۄتڽأتضأڬۏأڬًةۏأعشًشحأشڬہأزۏحتأۄەأۗأ"
"1358","أذعشحأؼثزتههۄأثىأوضؼًزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدثأحوأوۏڽأضەأڬضۏأتۏڬأڬۏأوًحأڬضۏأورظًظأدڲۄأځشأهڬہۏأدتحۏأۄەأحًأتضأڬەأهۏەأًۄتڽأځشأڬًةۏأعشًشحأڋتهأزۏأدتحۏأۄەأ؏أإزوۏأتضأڬەأتشتزەأضەأًۄتڽأدتحتأۄەأ؏أدثأًۄأتځىۏأوىصهأځشأځۄىډأدتحتأۄەأحًأًۄتڽأځشأتضأڬۏأشًذأڬًأمثعأڬشأهۏتأدتحتأۄەأ؏أتضأهۏەأمۏتوحأڬەأزىأصوۏىأڬۄەأڲۏأ=أتەأوۏشەأشثأ$أۏۄأۄەأًۄأتوتىحأدًأحًأىەأوۏشەأضځشزأڬۏأحہۏأۗأ"
"1359","أذعشحأوغشأثىأؼڬتوضأؼثزۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتههۄأحؼتهۏٳأتىضتىأڬۏأوًحأدضأومتوأځشأهڬہحتأۄەأ؏أتضأڬەأهۏەأًۄتڽأځشأڬًةۏأعشًشحأشڬہأزۏحتأۄەأۗأ"
"1360","أذعشحأؼشًۄأثىأوعشضأشعۏأتههۄأؼىۄأضەأثہۏأشضًهأتههۄأ﷽أڬتأتضۏأدۏضتألشوتىأوىمًهأۄەأۗأ"
"1361","أذعشحأدتثشأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أتۏڬأطرظأثهىزأإًتصأضەأسڬشأڬۏتأڬشحتأحہتأۗأتضأڬەأوحؼمأتۏڬأإزوۏأىەأڬۄتأ=أۏۄأتځىۏأإًتصأځضحأڬۏًڽأىۄۏڽأڬشحتأۗأحًأشضًهأتههۄأ﷽أىەألشوتۏتأ=أۏۄأثۄحأإۄۏڽأثہشىەأًتهتأطرظأۄەأ؏أذعشحأدتثشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأدثأًۄأطرظألًحأۄًتأحًأتۏڬأإزوۏأىەأتضأڬۏأمثشأوۏڽأىًشأزۏڬہتأحًأًۄأإزوۏأىثۏأتڬشوأ﷽أڬەأځتضأإۏتأ؏أتضأًمحأىثۏأتڬشوأ﷽أتضۏأڬەأثتشەأوۏڽأضًډأشۄەأحہەأتًشأإځأ﷽ألشوتأشۄەأحہەأ=أډهًأتځىەأضتحہۏأڬەأځتضأډهًأ+أدثأًۄتڽأدتأڬشأزۏڬہتأ"
"1362","%ذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأمثشضحتىأوۏڽأشًطىۏأزۏڬہۏأحًأًۄتڽأځشأإۏتأ؏أوۏڽأىەأًۄتڽأځشأزۏڬہتأڬۄأشضًهأتههۄأ﷽أتۏڬأمثشأوۏڽأحہەأتًشأڬۄۄأشۄەأحہەأ=أتځىەأضتحہۏأڬًأځڬڔًأۗأ+أۏؼىۏأتضأڬًأهذزأوۏڽأتحتشأشۄەأحہەأ"
"1363","أذعشحأتثًسشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتۏڬأطرظأثۏحأتههۄأڬتأغًتلأڬشأشۄتأحہتأ؏أًۄأتځىۏأزؼتأوۏڽأثۄحأإۄۏڽأثہشحتأحہتأحًأشضًهأتههۄأ﷽أىەألشوتۏتأ=أۏۄأطرظأثۄحأإۄۏڽأثہشىەأًتهتأۄەأ=أذعشحأتثًسشأڬۄحەأۄۏڽأ=أوۏڽأتۏڬأشتحأثتۄشأىڬهتأحًأىثۏأتڬشوأ﷽أڬًأزۏڬہتأڬۄأًۄأمثشضحتىأوۏڽأتضۏأإزوۏأڬًأزلىأڬشأشۄەأحہەأتًشأإځأ﷽أڬەأځتضأتۏڬأطوؼأحہۏأۗأ"
"1364","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتۏڬأزىأىثۏأتڬشوأ﷽أىەأتځىەأتۏڬأتۏضەأظذتثۏأڬتأسڬشأڬۏتأدًألًحأۄًأڲةەأحہەأ؏أتىأڬًأتىحۄتةۏأورحظشأڬځڔەأوۏڽأڬلىأزەأڬشأشتحأۄۏأشتحأوۏڽأزلىأڬشأزۏتأڲۏتأحہتأۗأىثۏأتڬشوأ﷽أىەأشتحأڬەأًمحأڬضۏأطرظأڬًأىوتصأدىتصۄأځڔہەأدتىەأڬەأثؽۏشأزلىأڬشىەأضەأڋتىټتأ؏أضًتةەأتضأظًشحأڬەأدثأڬًةۏأتىضتىأتضأؼوهأڬەأهۏەأودثًشأۄًأتًشألشوتۏتأ=أدثأڬًةۏأتځىەأثہتةۏأڬًأڬلىأزەأحًأتضأڬًأډتۄۏەأڬۄأتضەأتډہتأڬلىأزەأۗ"
"1365","أذعشحأًۄثأثىأوىثۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أۏۄأًۄأثتحأۄەأدضأڬەأثتشەأوۏڽأ؏أوۏڽأىەأدتثشأثىأؼثزتههۄأتىظتشۏأضەأځًډہتأحہتأحًأتىۄًڽأىەأودہەأثحتۏتأڬۄأىثۏأتڬشوأ﷽أىەأتۏڬأزىأرغثۄأوۏڽأتځىەأظذتثۄأشعۏأتههۄأؼىۄوأوۏڽأضەأتۏڬأتۏضەأطرظأڬتأسڬشأڬۏتأدًألًحأۄًأڲةەأحہەأتًشأتىأڬًأورحظشأڬځڔەأوۏڽأڬلىأزۏتأڲۏتأتًشأشتحأوۏڽأۄۏأتىأڬۏأحزلۏىأڬشأزۏأڲةۏأۗأىثۏأتڬشوأ﷽أىەأتضأثتحأضەأڋتىټتأڬۄأڬضۏأطرظأڬًأشتحأڬەأًمحأزلىأڬشأزۏتأدتةەأتًشأتضأڬۏأىوتصأدىتصۄأىۄأځڔہۏأدتةەأضًتةەأتضأڬەأڬۄأتىضتىأڬًأڬًةۏأودثًشۏأۄًأتًشألشوتۏتأ=أدثأحوأوۏڽأضەأڬًةۏأإزوۏأتځىەأثہتةۏأڬتأسوۄأزتشأۄًأحًأتضەأډتۄۏەأڬۄأتځىەأثہتةۏأڬًأتډہتأڬلىأځۄىتةەأۗأ"
"1366","%أذعشحأذثۏثأثىأتثۏأختثحأشعۏأتههۄأؼىۄأضەأشًتۏحأۄەأڬۄأذعشحأؼهۏأىەأتثًۄۏتدأضەأڬۄتأ=أوۏڽأحدہەأتضۏأثثتحأڬۏأحشؽۏثأزهتحتأۄًڽأدضأڬۏأشضًهأتههۄأ﷽أىەأودہەأحشؽۏثأزهتةۏأحہۏأۗأۏۄأڬۄأۄوأڬضۏأثحأڬًأحًڔەأثؽۏشأىىۄۏڽأډہًڔۏڽأڲەأتًشأڬضۏأتًىډۏأمثشأڬًأثشتثشأڬۏەأثؽۏشأىۄۏڽأډہًڔۏڽأڲەأۗ"
"1367","أذعشحأتثًًتةهأشعۏأتههۄأؼىۄأڬۏأضىزأڬەأۄوشتۄأثہۏأۏۄأذزۏخأوىمًهأۄەأۗأ"
"1368","%أذعشحأمتضوأثىأوذوزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأتوأتهوًوىۏىأضۏزۄأؼتةطۄأشعۏأتههۄأؼىۄتأڬەأځتضأڲۏتأتًشأتىأضەأڬۄتأ=أتەأتوأتهوًوىۏىأ$أوۏشەأهۏەأىثۏأتڬشوأ﷽أتًشأتىأڬەأزًىًڽأضتحہۏًڽأڬۏأمثشأضەأځشزۄأۄټتةۏەأ؏أحًأتىۄًڽأىەأحۏىًڽأمثشًڽأضەأوۏشەأهۏەأځشزۄأۄټتأزۏتأۗأًۄأحۏىًڽأمثشۏڽأىۄأحًأثۄحأتًىډۏأحہۏڽأتًشأىۄأۄۏأثۄحأىۏډۏأحہۏڽأ؏أتىأڬەأتشزڲشزأضشرأشىڲأڬۏأڬىڬشۏتڽأثډہۏأۄًةۏأحہۏڽأ؏أوۏڽأىەأزۏڬہتأڬۄأشضًهأتههۄأ﷽أتڲهۏأدتىثأۄۏڽأتًشأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأڬتأضشأإځأ﷽أڬەأڬىزہًڽأڬەأثشتثشأۄەأتًشأذعشحأؼوشأشعۏأتههۄأؼىۄأڬتأضشأىثۏأتڬشوأ﷽أڬەأمزوًڽأڬەأځتضأۄەأۗ"
"1369","%أذعشحأدتثشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأمثشأځشأؼوتشحأثىتىەأ؏أتضأځشأډًىتأڬشىەأ؏أهڬہىەأتًشأتضأځشأثۏټہىەأضەأوىؼأڬۏتأۄەأۗ"
"1370","%أذعشحأدتثشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأمثشًڽأځشأډًىتأڬشىەأ؏أهڬہىەأ؏أتضأځشأؼوتشحأثىتىەأتًشأتضأځشأثۏټہىەأضەأوىؼألشوتۏتأۄەأۗ"
"1371","%أذعشحأظىتثذۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوۏشۏأتوحأۏتأ+أطتۏزأۏۄألشوتۏتأ"
"1372","%أذعشحأؼخوتىأثىأؼلتىأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتۏڬأوشحثۄأشضًهأتههۄأ﷽أدىتصەأڬەأۄوشتۄأتۏڬأمثشأڬەأځتضأځۄىډەأ؏أوۏحأڬەأضتحہۏأتضأڬًأزلىأڬشأشۄەأحہەأ؏أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتځىەأثہتةۏأڬەأهۏەأزؼتةەأوؽلشحأڬشًأتًشأتههۄأحؼتهۏٳأضەأتضأڬۏأختثحأمزوۏأڬۏأزؼتأوتىڲًأڬۏًىڬۄأتضأضەأتثہۏأضًتهتحأڬۏەأدتةۏڽأڲەأۗ"
"1373","أذعشحأؼثزتههۄأثىأثذۏشأشعۏأتههۄأؼىۄأ؏أؼخوتىأثىأؼلتىأشعۏأتههۄأؼىۄأڬەأؽهتوأۄتىۏأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأدثأؼخوتىأثىأؼلتىأشعۏأتههۄأؼىۄأڬضۏأمثشأځشأڬہڔەأۄًحەأحًأتحىتأشًحەأڬۄأإځأڬۏأزتڔہۏأوثتشڬأحشأۄًأدتحۏأۗأإځأضەأڬۄتأدتحتأ=أدىحأتًشأزًصرأڬەأحسڬشەأځشأحًأإځأىۄۏڽأشًحەأتًشأمثشأڬەأسڬشأځشأشًأشۄەأۄۏڽأآأإځألشوتحەأ=أشضًهأتههۄأ﷽أىەألشوتۏتأ=أمثشأإرشحأڬۏأوىتصهأوۏڽأضەأضثأضەأځۄهۏأوىصهأۄەأ؏أتڲشأتضأضەأىدتحأځتأڲۏتأحًأتضأڬەأثؼزأًتهۏأضتشۏأوىصهۏڽأتضأضەأإضتىأۄۏڽأۗأتًشأتڲشأتضأضەأىدتحأىۄأوهۏأحًأتضأڬەأثؼزأڬۏأوىصهۏڽأثۄحأزطًتشأۄۏڽأۗأتًشأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوۏڽأىەأمثشأضەأثڔہأڬشأځشۏطتىأڬىأوىػشأىۄۏڽأزۏڬہتأۗأ"
"1374","%أذعشحأۏؼهۏٳأثىأوشۄأشعۏأتههۄأؼىۄأتځىەأًتهزأڬتأثۏتىأىمهأڬشحەأۄۏڽأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬەأۄوشتۄأوحؼززأضلشأڬۏەأۄۏڽأإځأ﷽أدثأڬثہۏأڬضۏأتىضتىأڬۏأىؼطأزۏڬہحەأحًأتضأڬًأزلىأڬشىەأڬتأذڬوأزۏحەأإځأۏۄأحذمۏمأىۄۏڽأڬشحەأحہەأڬۄأۏۄأىؼطأڬضۏأوضهوتىأڬۏأۄەأۏتأڬلشأڬۏأۗ"
"1375","%أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أۄشأتىضتىأڬەأحۏىأزًضحأۄًحەأۄۏڽأۗأتۏڬأزًضحأۄًحتأۄەأدًأڬۄحتأۄەأ=أدًأحًأىەأرشډأڬۏتأًۄأحۏشتأۄەأتًشأدًأحًأىەأشًڬأشڬہتأۄەأًۄأحۏشتأىۄۏڽأۄەأۏۄأتضأڬتأوتهأۄەأتًشأتۏڬأزًضحأًۄأۄًحتأۄەأدًأڬۄحتأۄەأ=أوۏڽأحۏشەأضتحہأۄًڽأهۏڬىأدثأحًأوهڬأەأزشًتصەأځشأځۄىډەأڲتأ+أۏؼىۏأمثشأوۏڽأدتةەأڲتأ"
"1376","%أذعشحأىؼوتىأثىأثطۏشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أإزوۏأتًشأوًحأڬۏأوختهأتۏضەأۄەأدۏضەأڬضۏأطرظأڬەأحۏىأزًضحأۄًڽأ؏أتىأوۏڽأضەأتۏڬأڬۄەأ=أۏۄأوۏشتأوتهأۄەأ؏أتضأوۏڽأضەأحًأدحىتأډتۄەأهەأهەأ؏أزًضشتأڬۄەأ=أوۏڽأضتشۏأصىزڲۏأحۏشەأضتحہأشۄًڽأڲتأهۏڬىأدثأحًأوشأدتةەأحًأوۏڽأحدہەأډہًڔأزًڽأڲتأتًشأحۏضشتأڬۄەأ=أحًأډتۄەأصىزۄأشۄەأۏتأوشأدتةەأ؏أوۏڽأۄشأومتوأځشأۄوۏطۄأحۏشەأضتحہأشۄًڽأڲتأۗأحًأتىأوۏڽأضەأدضأىەأۏۄأڬۄتأڬۄأتضأوۏڽأضەأدًأډتۄەأهەأهەأتًشأدًأډتۄەأډہًڔأزەأۏۄأتضأڬتأوتهأۄەأتًشأزًضشتأتضأڬتأرتىزتىأۄەأتًشأحۏضشتأتضأڬتأؼوهأۗ"
"1377","%أذعشحأؼثزتههۄأثىأدؼلشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأذعشحأدؼلشأشعۏأتههۄأؼىۄأڬۏأطۄتزحأڬۏأتغهتؼأإةۏأحًأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أدؼلشأڬەأثډًڽأڬەأهۏەأڬہتىتأځڬتاأڬۏًىڬۄأتىأڬًأتۏضتأوضةهۄأځۏطأإأڲۏتأۄەأدضأىەأتىأڬًأوظشًلأڬشأشڬہتأۄەأۗ"
"1378","أذعشحأؼثزتههۄأثىأدؼلشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأمخوأتًشأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأڬہۏهأشۄەأحہەأحًأشضًهأتههۄأ﷽أضًتشۏأځشأضًتشأۄوتشەأځتضأضەأڲصشەأ؏أإځأ﷽أىەألشوتۏتأ=أتضأڬًأودہەأځڬڔتأزًأ؏أإځأ﷽أىەأودہەأتځىەأإڲەأثټہتأهۏتأځہشأ““أمخوأ‛‛أڬەأوحؼهمأڬۄتأ=أتضأڬًأثہۏأودہەأځڬڔتاأ؏أإځأ﷽أىەأتىأڬًأتځىەأځۏډہەأثټہتأهۏتأ؏أإځأڬًأتځىەأډډتأذعشحأؼثتضأشعۏأتههۄأؼىۄوتأڬۏأغشلأضەأتضأثتحأوۏڽأڬًةۏأرزطۄأىۄۏڽأحہتأڬۄأ““أمخوأ‛‛أڬًأضًتشأڬشأهۏتأۄەأتًشأؼثۏزتههۄأڬًأډہًڔأزۏتأۄەأۗأځہشأإځأىەأوۏشەأضشأځشأحۏىأوشحثۄأۄتحہأځہۏشتأتًشأۄشأوشحثۄأۄتحہأځہۏشحەأۄًةەأ؏أإځأىەأۏۄأزؼتأزۏأۗ““أۏتأتههۄأ$أدؼلشأڬۏأتًهتزأوۏڽأتضأڬتأىتةثأځۏزتألشوتأۗ‛‛أ+أدشۏدأڬۄحەأۄۏڽأ"
"1379","أذعشحأؼثزتههۄأثىأدؼلشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأوۏشەأضشأځشأتځىتأۄتحہأځہۏشتأۗأرتهزأڬۄحەأۄۏڽأ=أوۏشتأرۏتهأۄەأڬۄأؼثزتههۄأىەأڬۄتأحہتأ=أحۏىأوشحثۄأ+أشضًهأتههۄأ﷽أىەأوۏشەأضشأځشأۄتحہأځہۏشتأ"
"1380","ذعشحأثطۏشأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أتىأڬتأدتۄهۏحأوۏڽأىتوأصذوأثىأوؼثزأحہتأۗأشضًهأتههۄأ﷽أىەأتىأضەأڬۄتأ=أحوۄتشتأىتوأڬۏتأۄەأآأتىۄًڽأىەأڬۄتأ=أصذوأثىأوؼثزأۗأإځأ﷽أىەألشوتۏتأ=أحًأثطۏشأۄەأۗأحًأتضأڬەأثؼزأتىأڬتأۏۄۏأىتوأۄًأڲۏتأۗأثطۏشأڬۄحەأۄۏڽأ=أوۏڽأتۏڬأوشحثۄأشضًهأتههۄأ﷽أڬەأۄوشتۄأډهأشۄتأحہتأإځأؼهۏۄأتهضهتوأىەألشوتۏتأ=أتەأرظتظۏۄأڬەأثۏټەأ$أحوأتههۄأحؼتهۏٳأڬۏأڬضأډۏصأڬتأتىڬتشأڬشحەأۄًأتًشأشضًهأتههۄأ﷽أڬەأۄوشتۄأډهأشۄەأۄًأوۏڽأىەأڬۄتأ=أوۏڽأتههۄأحؼتهۏٳأڬۏأڬضۏأډۏصأڬتأتىڬتشأىۄۏڽأڬشحتأۄًڽأۄشأثہهتةۏأتههۄأڬەأشضًهأودہەأؼغتألشوتأزۏأۄەأۗأځہشأإځأوطشڬًڽأڬۏأمثشًڽأڬەأځتضأإةەأتًشألشوتۏتأ=أتىأهًڲًڽأىەأثۄحأضتشۏأثہهتةۏتڽأعتةؼأڬشأزۏڽأإځأىەأحۏىأوشحثۄأۏۄۏأڬۄتأ=أځہشأإځأوضهوتىًڽأڬۏأمثشًڽأڬەأځتضأإةەأتًشألشوتۏتأ=أتىأهًڲًڽأىەأثۄحأضتشۏأثہهتةۏتڽأځتأهۏأۄۏڽأۏۄأثتحأحۏىأوشحثۄأڬۄۏأځہشأإځأډهأشۄەأحہەأڬۄأتډتىڬأتۏڬأطرظأىػشأإۏتأدًأمثشضحتىأوۏڽأدًحەأځۄىأڬشأډهأشۄتأحہتأۗأإځأىەألشوتۏتأ=أتەأدًحۏًڽأًتهەأ$أحۏشەأهۏەأۄهتڬحأۄًأ؏أتځىۏأدًحۏتڽأتحتشأزەأ؏أتضأطرظأىەأشضًهأتههۄأ﷽أڬًأزۏڬہتأ؏أدثأتضأىەأځۄډتىأهۏتأڬۄأۏۄأشضًهأتههۄأ﷽أۄۏڽأحًأتضأىەأدًحۏتڽأتحتشأڬشأځہۏىڬأزۏڽأۗأ"
"1381","%أذعشحأثطۏشأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتۏڬأطرظأڬًأدًحەأځۄىەأمثشضحتىأوۏڽأډهحەأزۏڬہتأحًألشوتۏتأ=أتەأدًحۏتڽأځۄىىەأًتهەأتىأڬًأتحتشأزەأۗ"
"1382","%أذعشحأؼثزتههۄأثىأؼوشًأثىأؼتظأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أۄوأىەأشضًهأتههۄأ﷽أڬەأۄوشتۄأتۏڬأطرظأڬۏأحزلۏىأڬۏأ؏أدثأۄوأًۄتڽأضەأهًټەأتًشأتىأڬەأزشًتصەأځشأځۄىډەأحًأإځأ﷽أىەأتۏڬأرتحًىأڬًأزۏڬہتأ؏أۄوأۏۄأضودہأشۄەأحہەأڬۄأإځأ﷽أتضأؼًشحأڬًأىۄۏڽأځۄډتىحەأۗأإځأ﷽أىەألشوتۏتأ=أتەألتغوۄأ$أحًأڬۄتأضەأإأشۄۏأۄەأآأتضأىەأدًتثأزۏتأ=أوۏڽأوۏحأڬەأڲہشأًتهًڽأڬەأځتضأضەأإةۏأۄًڽأۗأوۏحأڬەأهۏەأزؼتةەأوؽلشحأڬشىەأتًشأحؼصۏحأڬشىەأڲةۏأحہۏأۗأإځأ﷽أىەألشوتۏتأ=أطتۏزأڬۄأحًأتىأڬەأضتحہأمثشضحتىأڲةۏأحہۏأۗأتضأىەأڬۄتأ=أوۏڽأتههۄأڬۏأځىتۄأوتىڲحۏأۄًڽأڬۄأتىأڬەأضتحہأمثشضحتىأدتاڽأۗأڬۏًىڬۄأوۏڽأىەأتضأڬەأوحؼهمأإځأڬەأتشطتزتحأضىأشڬہەأۄۏڽأۗأإځأ﷽أىەألشوتۏتأ=أتڲشأحًأتىأڬەأضتحہأمثشضحتىأدتحۏأحًأتضأًمحأحڬأدىحأىۄأزۏڬہأضڬحۏأدثأحڬأڬۄأحۏشەأثتځأڬتأزتزتأىۄأزۏڬہأهۏحتأۗ"
"1383","%أذعشحأؼثزتههۄأثىأؼوشًأشعۏأتههۄأؼىۄوتأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتۏڬأؼًشحأڬًأدىتصۄأضەأًتځضأإحەأزۏڬہتأۗأحًأتضأضەأځًډہتأڬۄأحًأڬۄتڽأضەأإأشۄۏأۄەأآأتضأىەأدًتثأزۏتأ=أتضأوۏحأڬەأڲہشأًتهًڽأضەأحؼصۏحأڬشأڬەأۗأحًأشضًهأتههۄأ﷽أىەألشوتۏتأ=أتڲشأحًأتىأڬەأضتحہأمثشضحتىأډهۏأدتحۏأحًأتضأًمحأحڬأدىحأىۄأزۏڬہأضڬحۏأدثأحڬأڬۄأحۏشەأثتځأڬتأزتزتأىۄأزۏڬہأهۏحتأۗ"
"1384","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأمثشًڽأځشأدتىەأًتهۏأؼًشحًڽأځشأتًشأتىأڬۏأغشلأضدزۄأڬشىەأًتهًڽأځشأتًشأتىأځشأډشتؽأشڬہىەأًتهًڽأځشأهؼىحألشوتةۏأۄەأۗ"
"1385","%أذعشحأؼثزتهشذوىأثىأذضتىأثىأختثحأشعۏأتههۄأؼىۄأتځىەأًتهزأڬەأذًتهەأضەأثۏتىأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأمثشًڽأڬۏأصۏتشحأڬەأهۏەأدتىەأًتهۏأؼًشحًڽأځشأهؼىحألشوتةۏأۄەأۗ"
"1386","%أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوۏڽأحوۄۏڽأصۏتشحأمثًشأضەأوىؼأڬۏتأڬشحتأحہتأۗأتثأحوأصۏتشحأڬۏتأڬشًأڬۏًىڬۄأتضأوۏڽأؼثشحأۄەأۗأوۏڽأحوۄۏڽأىثۏسأضەأشًڬتأڬشحتأحہتأ؏أتثأحوأىثۏسأثىتأهۏتأڬشًأۗأتًشأوۏڽأىطەأڬًأذهتهأىۄۏڽأڬشحتأۗأوۏڽأحوۄۏڽأمشثتىۏًڽأڬەأڲًطحأضەأوىؼأڬۏتأڬشحتأحہتأۗأتثأحوأ+أدحىتأډتۄًأ"
"1387","أذعشحأؼثزتههۄأتثىأوضؼًزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوۏڽأحوۄۏڽأصۏتشحأمثًشأضەأتًشأمشثتىۏأڬتأڲًطحأحۏىأزىأضەأصۏتزۄأڬہتىەأتًشأىثۏسأڬەأثشحىًڽأضەأوىؼأڬۏتأڬشحتأحہتأ؏أرثشزتشأ$أمثشًڽأڬۏأصۏتشحأڬۏتأڬشًأڬۏًىڬۄأۏۄأزىۏتأوۏڽأثەأشؽثحۏأځۏزتأڬشحۏأۄەأۗأتًشأإرشحأڬۏأۏتزأزهتحۏأۄەأۗأتًشأمشثتىۏأڬتأڲًطحأڬہتاأتًشأدحىتأډتۄًأثډتأڬشأشڬہأهًأ؏أوۏڽأحًأتضأًمحأحوۄۏڽأوىؼأڬۏتأڬشحتأحہتأثأوتهۏأذتهتحأڬوصًشأۄًتأڬشحەأحہەأحتڬۄأهًڲًڽأځشأًضؼحأشۄەأۗأرثشزتشأ$أثشحىأڬضۏأډۏصأڬًأذشتوأىۄۏڽأڬشحەأۗأثەأطڬأۄشأىطۄأإًشأډۏصأذشتوأۄەأۗأ"
"1388","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوۏڽأحوۄۏڽأصۏتشحأمثًشأضەأوىؼأڬۏتأڬشحتأحہتأتثأحوأتضأڬۏأصۏتشحأڬۏتأڬشًأڬًۏىڬۄأۏۄأوًحأڬۏأۏتزأزهتحۏأۄۏڽأۗ"
"1389","%أذعشحأضهۏوتىأثىأثشۏزۄأشعۏأتههۄأؼىۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەأتۏڬأۄصتشأتلشتزأڬۏأوؼۏحأوۏڽأتځىۏأًتهزۄأوذحشوۄأڬۏأمثشأوثتشڬأڬۏأصۏتشحأڬۏأ؏أتضأزىأڬەأؼهتًۄأڬثہۏأثہۏأإځأڬًأتحىتأصۏتزۄأشًحەأۄًةەأىۄۏڽأزۏڬہتأڲۏتأۗ"
"1390","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتځىۏأًتهزۄأڬۏأمثشأڬۏأصۏتشحأڬۏأحًأإځأشًأځڔەأۗأ+أتًشأإځأڬەأشًىەأىەأ"
"1391","%أذعشحأثشۏزۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أۄوأشضًهأتههۄأ﷽أڬەأۄوشتۄأحمشۏثتَأتۏڬأۄصتشأضًتشأحہەأ؏أتۏڬأدڲۄأځشأإځأ﷽أىەأځڔتاأڋتهتأتًشأۄوۏڽأزًأشڬؼحۏڽأځڔہتةۏڽأۗأځہشأإځأ﷽أۄوتشۏأغشلأوحًدۄأۄًةەأحًأإځأڬۏأإىڬہًڽأضەأإىضًأثۄۄأشۄەأحہەأ؏أذعشحأؼوشأشعۏأتههۄأؼىۄأإځأڬۏأغشلأتټہأڬشأڬہڔەأۄًةەأتًشأڬۄىەأهڲەأ=أۏتأشضًهأتههۄأ$أوۏشەأوتڽأثتځأإځأځشأمشثتىأۄًڽأۗأإځأڬًأڬۏتأۄًتأآأإځأ﷽أىەألشوتۏتأ=أوۏڽأىەأتځىەأشأضەأتځىۏأًتهزۄأڬەأهۏەأزؼتةەأوؽلشحأڬۏأتدتصحأوتىڲۏأ؏أهۏڬىأودہەأتدتصحأىۄأوهۏأحًأًتهزۄأڬۏأوذثحأوۏڽأوۏشۏأإىڬہًأضەأإىضًأىڬهأإةەأۗأوۏڽأىەأتىأڬۏأصۏتشحأڬەأهۏەأتدتصحأوتىڲۏأ؏أحًأودہەأتدتصحأوهأڲةۏأۗأوۏڽأحوۄۏڽأصۏتشحأمثًشأضەأوىؼأڬشحتأحہتأ؏أتثأحوأتىأڬۏأصۏتشحأڬۏتأڬشًأۗأتًشأتىأڬۏأصۏتشحأضەأحوۄتشەأتىزشأتؼتهأظتهذأڬتأدسثۄأثڔہەأڲتأۗ"
"1392","أذعشحأؼثزتههۄأثىأتثۏأوهۏڬۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأڬۄأتۏڬأوشحثۄأتوأتهوًوىۏىأضۏزۄأؼتةطۄأشعۏأتههۄأؼىۄتأمثشضحتىأضەأإأشۄۏأحہۏڽأۗأوۏڽأىەأتىأضەأځًډہتأ=أتەأتوأتهوًوىۏىأ$أإځأڬۄتڽأضەأإأشۄۏأۄۏڽأآأتىۄًڽأىەأدًتثأزۏتأ=أتځىەأثہتةۏأؼثزتهشذوىأثىأتثۏأثڬشأڬۏأمثشأضەأۗأوۏڽأىەأتىأضەأڬۄتأ=أڬۏتأشضًهأتههۄأ﷽أىەأصۏتشحأمثًشأضەأوىؼأىۄۏڽأڬۏتأآأتىۄًڽأىەأدًتثتَأڬۄتأ=أذعًشأ﷽أځۄهەأوىؼأڬۏتأڬشحەأحہەأۗأهۏڬىأثؼزأوۏڽأإځأىەأتدتصحأزەأزۏأحہۏأۗأ"
"1393","أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوۏڽأحوۄۏأصۏتشحأمثًشأضەأشًڬتأڬشحتأحہتأ؏أتثأحوأتىأڬۏأصۏتشحأڬۏتأڬشًأڬۏًىڬۄأۏۄأزهأڬًأىشوأڬشحۏأۄەأتًشأإىڬہًڽأڬًأشهتحۏأۄەأتًشأإرشحأڬۏأۏتزأزهتحۏأۄەأۗأ"
"1394","أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أوۏڽأحوۄۏڽأصۏتشحأمثًشأضەأوىؼأڬۏتأڬشحتأحہتأ+أهۏڬىأتثأ"
"1395","%أذعشحأتثًسشأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أودہەأشضًهأتههۄأ﷽أىەألشوتۏتأ=أمثشًڽأڬۏأصۏتشحأڬۏتأڬشًأدًأإرشحأڬۏأۏتزأزهتحۏأۄەأتًشأوشزًڽأڬًأؽضهأزۏتأڬشًأڬۏًىڬۄأۏۄأوۏحأڬەأدضوأڬًأزشضحأڬشىتأثۄحشۏىأىظۏذحأۄەأۗأتًشأىوتصأدىتصۄأځڔہتأڬشًأطتۏزأڬۄأتضأًدۄأضەأحوأؽوڲۏىأۄًأدتاأڬۏًىڬۄأؽوڲۏىأطرظأتههۄأڬەأضتةەأوۏڽأۄًحتأۄەأتًشأۄشأغشذأڬۏأثہهتةۏأځتحتأۄەأۗ"
"1396","%أذعشحأؼهۏأثىأذضىأشعۏأتههۄأؼىۄوتأتځىەأًتهزأڬتأثۏتىأىمهأڬشحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أڬۏأظتذثصتزۏأذعشحألتغوۄأشعۏأتههۄأؼىۄتأۄشأدوؼۄأڬەأزىأإځأ﷽أڬەأډډتأذوصۄأڬۏأمثشأڬۏأصۏتشحأڬەأهۏەأدتحۏأحہۏڽأ؏أإځأىوتصأثہۏأځڔہحۏأتًشأإځأمثشأڬەأځتضأشًحۏأثہۏأحہۏڽأۗ"
"1397","%أذعشحأتىضأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أوۏڽأىثۏأتڬشوأ﷽أڬەأۄتڽأثۏټہتأۄًتأحہتأ؏أحًأإځأڬەأځتضأضەأتۏڬأدىتصۄأڲصشتأ؏أإځأ﷽أىەأځًډہتأ=أۏۄأڬۏتأۄەأآأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأىەأثحتۏتأ=أۏۄألهتڽأطرظأڬتأدىتصۄأۄەأدًأڬۄأتههۄأتًشأتضأڬەأشضًهأ﷽أضەأوذثحأڬۏتأڬشحتأحہتأتًشأتههۄأحؼتهۏٳأڬەأتذڬتوأڬۏأتغتؼحأڬۏتأڬشحتأحہتأتًشأتضأوۏڽأڬًططأڬۏتأڬشحتأحہتأحًأشضًهأتههۄأ﷽أىەألشوتۏتأ=أًتدثأۄًأڲةۏأ+أتضأڬەأثؼزأ"
"1398","%أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەألشوتۏتأ=أدثأڬًةۏأوضهوتىألًحأۄًأدتةەأتًشأتضأڬەأهۏەأتضأڬەأډتشأمشۏثۏأځڔًضۏأۏۄأڲًتۄۏأزەأزۏڽأڬۄأۄوأتضأڬەأوحؼهمأثہهتةۏأڬەأضًتأڬډہأىۄۏڽأدتىحەأحًأتههۄأحثتشڬأًأحؼتهۏٳألشوتحتأۄەأ=أوۏڽأىەأحوۄتشۏأڲًتۄۏأمثًهأڬشأهۏأۄەأتًشأوۏڽأىەأتضأڬەأًۄأڲىتۄأثہۏأوؼتلأڬشأزۏەأۄۏڽأدًأحوأىۄۏڽأدتىحەأۄًأۗ"
"1399","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتۏڬأطرظأشضًهأتههۄأ﷽أڬۏأرزوحأوۏڽأذتعشأۄًتأتًشأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أودہەأڬًةۏأتۏضتأؼوهأثحتأزۏدۏەأدضأڬًأتځىتأڬشأوۏڽأدىحأڬتأوضحذمأۄًأدتاڽأۗأإځأىەألشوتۏتأ=““أوذضىأ‛‛أثىأدتاأۗأتضأىەأڬۄتأ=أودہەأڬۏضەأځحۄأډهەأڲتأڬۄأوۏڽأ““أوذضىأ‛‛أۄًڽأآأإځأ﷽أىەألشوتۏتأ=أتځىەأځڔًضۏًڽأضەأځًډہأهًأ$أتڲشأًۄأڬۄۏڽأڬۄأحًأ““أوذضىأ‛‛أۄەأۗأحًأ““أوذضىأ‛‛أۄەأتًشأتڲشأًۄأڬۄۏڽأڬۄأحًأثشتأۄەأحًأضودہأهۏىتأڬۄأحًأثشتأۄەأۗ"
"1400","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أؼشعأڬۏتأڲۏتأ=أۏتأشضًهأتههۄأ﷽أ$أدىحۏأڬًىأۄەأآأإځأ﷽أىەألشوتۏتأ=أدضأڬۏأوًحأضەأځۄهەأهًڲأتضأڬًأثشەأهلػًڽأوۏڽأۏتزأڬشحەأۄًڽأۗأؼشعأڬۏتأڲۏتأ=أدۄىوۏأڬًىأۄەأآأإځأ﷽أىەألشوتۏتأ=أدضأڬۏأوًحأضەأځۄهەأهًڲأتضأڬًأثشەأهلػًڽأوۏڽأۏتزأڬشحەأۄًڽأۗ"
"1401","%أذعشحأرتشدۄأثىأصۏزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتوأتهؼهتؤأتۏڬأتىظتشۏۄأرتحًىأۄۏڽأ؏أتىۄًڽأىەأشضًهأتههۄأ﷽أڬۏأثۏؼحأڬۏأۄەأ؏أإځألشوتحۏأۄۏڽأ=أوۄتدشۏىأڬەأهۏەأمشؼۄأتىزتصۏأڬۏأڲةۏأحًأۄوتشەأذظۄأوۏڽأؼخوتىأثىأوػؼًىأڬتأىتوأىڬهتأ؏أۄوأتىأڬًأتځىەأڲہشأهەأڲةەأ؏أتىأڬًأتۏضتأطزۏزأزشزأتټہتأڬۄأتضۏأوۏڽأتىأڬتأتىحمتهأۄًأڲۏتأ؏أدثأتىأڬتأتىحمتهأۄًأڲۏتأحًأۄوأىەأتىأڬًأؽضهأزۏتأتًشأتىۄۏأڬەأڬځڔًڽأوۏڽأتىأڬًأڬلىأزەأزۏتأۗأ+أتضۏأتخىتأوۏڽأ"
"1402","%أذعشحأتثىأغتاضأشعۏأتههۄأؼىۄأتځىەأًتهزأڬەأوحؼهمأشًتۏحأڬشحەأۄۏڽأڬۄأًۄأحطۄزأڬەأثؼزأڬډہأڬهوتحأځڔہتأڬشحەأحہەأدىأڬًأثۄحأؼػۏوأضودہحەأحہەأۗأوۏڽأىەأځًډہتأ=أزًىًڽأمؼزًڽأوۏڽأآأتىۄًڽأىەأدًتثأزۏتأ=أثهڬۄأإرشۏأمؼزەأوۏڽأحطۄزأڬەأثؼزأۗأوۏڽأىەأځًډہتأ=أًۄأڬًىأضەأڬهوتحأۄۏڽأآأتىۄًڽأىەأثحتۏتأ=““أ®ئّؼًْسْأثٓتههّٔيٓأوٓىٕأؼّسّتثٓأدّيّىّٔوّ؏أًّئّؼًْسْأثٓتههّٔيٓأوٓىٕأؼّسّتثٓأتهٕمّثٕشٓ؏أًّئّؼًْسْأثٓتههّٔيٓأوٓىٕأطّشٔٓأتهٕوّضٍٓذٓأتهزّٔدّٔتهٓ؏أًّئّؼًْسْأثٓتههّٔيٓأوٓىٕألٓحٕىّجٓأتهٕوّذٍّٕتأًّتهٕوّوّتحٓ¾أ‛‛أ+أوۏڽأدۄىوأڬەأؼستثأضەأتههۄأڬۏأځىتۄأوتىڲحتأۄًڽأتًشأوۏڽأؼستثأمثشأضەأتههۄأڬۏأځىتۄأوتىڲحتأۄًڽأتًشأوۏڽأوضۏذأزدتهأضەأتههۄأڬۏأځىتۄأوتىڲحتأۄًڽأتًشأوۏڽأصىزڲۏأًأوًحأڬەألحىۄأضەأتههۄأڬۏأځىتۄأوتىڲحتأۄًڽأ"
"1403","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أدثأهًڲأوۏحأڬًأزلىأڬشأڬەأًتځضأځهټحەأۄۏڽأحًأوۏحأتىأڬەأمزوًڽأڬۏأإۄټأضىحۏأۄەأځہشأتڲشأًۄأوًوىأۄًأحًأىوتصأتضأڬەأضشأڬۏأدتىثأتًشأشًصۄأزتةۏڽأدتىثأتًشأصڬًۆأثتةۏڽأدتىثأتًشأزۏڲشأىۏڬأڬتوأۏؼىۏأظزمۄأ؏أىًتلهأ؏أظهۄأشذوۏأتًشأزۏڲشأىۏڬۏتڽأتًشأذضىأضهًڬأتضأڬەأځتاڽأڬۏأدتىثأإأدتحۏأۄۏڽأځہشأتضأڬەأضشأڬۏأغشلأضەأ+أمثشأوۏڽأ"
"1404","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتضأستحأڬۏأمضوأۄەأدضأڬەأمثعۄأمزشحأوۏڽأوۏشۏأدتىأۄەأ؏أدثأهًڲأوۏحأڬًأزلىأڬشأڬەأهًټحەأۄۏڽأحًأًۄأتىأڬەأمزوًڽأڬۏأإۄټأضىحۏأۄەأځہشأتضأڬەأثؼزأ+أذوتزأثىأضهوۄأ"
"1405","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأىەأتههۄأحؼتهۏٳأڬەأمًهأ““أ®وّؼٍٓطّجَأعّىٕنَت¾أ‛‛أڬۏأحلضۏشأثۏتىأڬشحەأۄًةەألشوتۏتأ=أتضأضەأوشتزأ““أؼستثأمثشأ‛‛أۄەأۗأ"
"1406","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أتۏڬأدىتصۄأڬەأهۏەأىڬهەأحًأإځأ﷽أڬەأۄوشتۄأذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأثہۏأحہەأ؏أتىۄًڽأىەأؼًشحًڽأڬەأشًىەأڬۏأإًتصأضىۏأحًأذعشحأؼوشأشعۏأتههۄأؼىۄأىەأتىأڬًأڋتىټتأ؏أشضًهأتههۄأ﷽أىەأتىۄۏڽألشوتۏتأ=أتەأؼوشأ$أتىأڬًأډہًڔأزًأ؏أڬۏًىڬۄأإىڬہأإىضًأثۄتحۏأۄەأتًشأزهأوظۏثحأوذضًضأڬشحتأۄەأتًشأؼۄزأثۄحأمشۏثأۄەأۗ"
"1407","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأشضًهأتههۄأ﷽أؽصًۄأتذزأضەأهًټەأحًأتىظتشۏأرًتحۏىأڬًأشًحەأۄًةەأضىتأ=أحًألشوتۏتأ=أذوصۄأڬًأشًىەأًتهتأڬًةۏأىۄۏڽأۄەأآأحًأتىظتشۏأرًتحۏىأذوصۄأشعۏأتههۄأؼىۄأڬەأهۏەأشًىەأهڲۏڽأ؏أشضًهأتههۄأ﷽أضًأڲةەأ؏أځہشأدثأتټہەأحًأًۄأ+أتثہۏأحڬأ"
"1408","%أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أذعشحألتغوۄأشعۏأتههۄأؼىۄتأىەأڬۄتأ=أتەأتىضأ$أڬۏتأحوۄتشەأزهأۏۄأڲًتشۄأڬشأهۏڽأڲەأآأڬۄأحوأشضًهأتههۄأ﷽أځشأوټۏأڋتهًأۗأتًشألتغوۄأشعۏأتههۄأؼىۄتأىەأڬۄتأ=أتەأتثتأدتىأ$أإځأىەأتځىەأشثأڬەأثهتًەأڬًأوتىأهۏتأۄەأۗأتەأتثتأدتىأ$أإځأتځىەأشثأڬەأڬحىتأمشۏثأۄًأڲةەأۗأتەأتثتأدتىأ$أدىحأتهلشزًضأإځأڬتأټہڬتىۄأۄًأۗأتەأتثتأدتىأ$أدثشۏهأتوۏىأؼهۏۄأتهضهتوأإځأڬۏأرثشأزۏىەأًتهەأۄًڽأۗ"
"1409","%أذڬۏوأثىأمۏضأثىأؼتظوأتځىەأًتهزأضەأشًتۏحأڬشحەأۄۏڽأڬۄأتىۄًڽأىەأتځىۏأوًحأڬەأًمحأًظۏحأڬشحەأۄًةەأڬۄتأ=أدثأوۏڽأوشأدتاڽأحًأحًأودہأځشأىًذۄأوحأڬشىتأڬۏًىڬۄأشضًهأتههۄأ﷽أځشأىًذۄأىۄۏڽأڬۏتأڲۏتأحہتأۗ"
"1410","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأۗأدثأشضًهأتههۄأ﷽أڬەأظتذثصتزەأذعشحأتثشتۄۏوأشعۏأتههۄأؼىۄأڬتأتىحمتهأۄًتأحًأتضتوۄأثىأصۏزأډۏرأډۏرأڬشأشًىەأهڲەأۗأشضًهأتههۄأ﷽أىەألشوتۏتأ=أۏۄأوۏشتأغشۏمۄأىۄۏڽأۄەأۗأتًشأىۄأۄۏأډۏرىەأًتهەأڬتأڬًةۏأذمأۄەأۗأزهأؽوڲۏىأۄًحتأشۄەأ؏أإىڬہأإىضًأثۄتحۏأشۄەأهۏڬىأتههۄأحؼتهۏٳأڬەأؽعثأڬًأزؼًحأىۄأزۏأدتةەأۗأ"
"1411","%أذعشحأتثًضهوۄأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأڬۄأذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأىەأۏۄأًظۏحأڬۏأحہۏأڬۄأوۏڽأدثأوشأدتاڽأحًأوۏشەأتًځشأىًذۄأوحأڬشىتأڬًۏىڬۄأىثۏأتڬشوأ﷽أځشأىًذۄأىۄۏڽأڬۏتأحہتأۗ"
"1412","%أذعشحأؼثزتههۄأثىأتثۏأتًلۏٳأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أوشخۏۄأرًتىۏأضەأوىؼأڬۏتأڬشحەأحہەأۗ"
"1413","%أذعشحأتثًوتهڬأتطؼشۏأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوۏشۏأتوحأوۏڽأدتۄهۏحأڬەأډتشأڬتوأځتةەأدتحەأۄۏڽأ=أدىأڬًأۏۄأهًڲأىۄۏڽأډہًڔۏڽأڲەأۗأ+أ4أ"
"1414","%أذعشحأتوأؼغۏۄأشعۏأتههۄأؼىۄتأڬۄحۏأۄۏڽأ=أدثأ=““أ®بٓسّتأدّتؤّنّأتهٕوْإوٓىّتحْأٍْثّتٍٓؼٕىّنّأۗۗۗۗۗأًّهّتأٍّؼٕظٍٓىّنّ¾أ‛‛أحڬأىتصهأۄًةۏأ؏أحًأتضأوۏڽأىًذۄأرًتىۏأثہۏأطتوهأحہۏأۗأوۏڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ$أضًتةەألهتڽأڬۏأإهأڬەأۗأڬۄأًۄأدتۄهۏحأوۏڽأوۏشۏأذًظهۄأتلصتةۏأڬۏتأڬشحەأحہەأتضأهۏەأوۏشتأثہۏألشعأثىحتأۄەأڬۄأوۏڽأثہۏأتىأڬۏأذًظهۄأتلصتةۏأڬشًڽأۗأحًأإځأ﷽أىەألشوتۏتأ=أ+أټہۏڬأۄەأ"
"1415","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أحۏىأډۏصًڽأڬتأحؼهمأڬلشأضەأۄەأ+أ4أ"
"1416","%أذعشحأؼثزتههۄأثىأثشۏزۄأشعۏأتههۄأؼىۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأ=أشضًهأتههۄأ﷽أتىظتشأڬتأثۄحأرۏتهأشڬہحەأحہەأۗأتىأڬۏأؼۏتزحأڬًأدتۏتأڬشحەأحہەأۗأتىأڬۏأتذًتهأځشضۏأڬۏتأڬشحەأحہەأۗأإځأ﷽أڬًأتۏڬأتىظتشۏأرتحًىأڬۏأرثشأځۄىډۏأڬۄأتضأڬتأثۏټتألًحأۄًأڲۏتأۄەأتًشأ+أتضأڬتأۏۄۏأثۏټتأتضأڬۏأڬهأڬتةىتحأحہتأۗأڬۏًىڬۄأ"
"1417","%أذعشحأوؼتًۏۄأثىأمشۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأ=أتۏڬأطرظأشضًهأتههۄأ﷽أڬۏأرزوحأوۏڽأإۏتأڬشحتأحہتأۗأتًشأتضأڬەأۄوشتۄأتضأڬتأثۏټتأثہۏأۄًحتأحہتأ+أتۏڬأوشحثۄأ"
"1418","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوًوىۏىأڬەأثډەأدىحأوۏڽأتۏڬأځۄتڔأوۏڽأ+أشڬہەأدتحەأۄۏڽأ"
"1419","%أذعشحأصۏتزأثىأؼهتمۄأشعۏأتههۄأؼىۄأتځىەأډډتأضەأشًتۏحأڬشحەأۄۏڽأڬۄأوؽۏشۄأثىأطؼثۄأىەأذعشحأؼهۏأثىأتثۏأغتهثأشعۏأتههۄأؼىۄأڬًأثشتأثہهتأڬۄتأ؏أحًأذعشحأصۏزأثىأتشموأڬہڔەأۄًةەأتًشأڬۄىەأهڲەأ=أتەأوؽۏشۄأ$أڬۏتأحوۄۏڽأوؼهًوأىۄۏڽأۄەأڬۄأشضًهأتههۄأ﷽أىەألًحأطزڲتىأڬًأثشتأثہهتأڬۄىەأضەأوىؼأڬۏتأۄەأآأحًأ““أؼهۏأ‛‛أڬًأثشتأثہهتأڬۏًڽأڬۄۄأشۄەأۄًأآأدثڬۄأًۄأحًأتىحمتهأڬشأډڬەأۄۏڽأۗ"
"1420","%أذعشحأضؼۏزأثىأصۏزأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أڬتلشأڬًأڲتهۏأزەأڬشأوضهوتىأڬًأتسۏحأوحأزًأۗ"
"1421","%أذعشحأتثىأؼوشأشعۏأتههۄأؼىۄوتأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=ألًحأطزڲتىأڬۏأرًثۏتڽأثۏتىأڬشًأتًشأڬۏأثشتةۏأثۏتىأڬشىەأضەأثتصأشۄًأۗ"
"1422","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتځىەأوشزًڽأڬًأىتځتڬأوحأڬشًأ؏أتضأهۏەأڬۄأوضهوتىأىۄأحًأصىزۄأذتهحأوۏڽأىتځتڬأۄًحتأۄەأتًشأىۄأۄۏأوشزۄأذتهحأوۏڽأۗ"
"1423","%أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=ألشطحًڽأىەأذعشحأإزوأؼهۏۄأتهضهتوأ+أڬەأدىتصۄأ"
"1424","%أذعشحأؼثزتههۄأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأإرشۏأؼوشأوۏڽأدًأدىتصەأځڔہتةەأ؏أتىأوۏڽأإځأؼهۏۄأتهضهتوأډتشأحڬثۏشۏڽأځڔہتأڬشحەأحہەأۗأتًشأذعشحأؼوشأشعۏأتههۄأؼىۄأىەأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأ+أڬەأدىتصۄأ"
"1425","%أذعشحأغهذۄأثىأؼثزتههۄأثىأؼًلأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتثىأؼثتضأشعۏأتههۄأؼىۄوتأىەأتڬأدىتصەأوۏڽأضًشۆألتحذۄأځڔہۏأ؏أتىأضەأوۏڽأىەأځًډہتأ=أحًأتىۄًڽأىەأدًتثأزۏتأ=أڬۄأۏۄأضىحأۄەأۗأۏتأ+أطتۏزأۏۄأڬۄتأ"
"1426","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوۏحأڬًأؽضهأزۏىەأڬۏأًدۄأضەأحوأځشأؽضهأهتصوأىۄۏڽأۄەأۗأڬۏًىڬۄأحوۄتشۏأوۏحأىدضأىۄۏڽأۄًحۏأ؏أحوۄتشەأهۏەأۏۄۏأڬتلۏأۄەأڬۄأتځىەأۄتحہأزہًأهۏتأڬشًأۗ"
