hadiths[133]{hadithnumber,text}:
"1788","Telah menceritakan kepadaku [Muhammad bin Basysyar]"
"1789","Telah menceritakan kepadaku [Mahmud bin Ghailan]"
"1790","Telah menceritakan kepadaku [Qutaibah]"
"1791","Telah menceritakan kepadaku [Ahmad bin Mani']"
"1792","Telah menceritakan kepadaku [Hannad]"
