"4533","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أوضدزأڬۏأحؼوۏشأڬۏهةەأضثأضەأځۄهۏأتۏىټأىثۏأتڬشوأ﷽أىەأتټہتةۏأ؏أزًضشۏأتۏىټأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأىەأتټہتةۏأ؏أځہشأذعشحأؼخوتىأىەأتۏىټأتټہتةۏأ؏أوۏڽأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أڬۏتأإځأىۄۏڽأزۏڬہأشۄەأۏۄأهًڲأڬضأغشذأإځأڬتأۄتحہأثټتأشۄەأۄۏڽأۗأحًأإځأؼهۏۄأتهضهتوأىەألشوتۏتأ=أتەأؼتةطۄأ$أۏۄأهًڲأوۏشەأثؼزأرهلتؤأۄۏڽأۗ"
