"1042","%أذضتىأثىأؼغۏۄأڬۏأضىزأڬەأۄوشتۄأثہۏأوسڬًشۄأذزۏخأدۏضۏأذزۏخأوىمًهأۄەأۗ"
"أٰٰأۏۄأذزۏخأوسڬًشۄأضىزًڽأڬەأۄوشتۄأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضەأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1043","%أذعشحأؼثزتههۄأثىأؼوشًأشعۏأتههۄأؼىۄوتأڬۄحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدًأطرظأدوؼۄأڬەأزىأؽضهأڬشەأتًشأتوتوأڬەأمشۏثأۄًأڬشأثۏټہەأتًشأحًدۄأضەأضىەأتًشأرتوًطأۄًأڬشأثۏټہتأشۄەأ؏أتضأڬًأۄشأمزوأڬەأؼًعأدًأتضأىەأوضدزأڬۏأغشلأتټہتۏتأتۏڬأضتهأڬەأشًصًڽأتًشأطثأثۏزتشۏًڽأڬتأخًتثأوهەأڲتأۗ"
"أٰٰأتضأڬۏأًدۄأضەأظذۏذأختثحأتذتزۏخأڬًأوؼههأىۄۏڽأڬۄۄأضڬحەأ؏أتضأڬۏأوحؼززأًدًۄتحأۄۏڽأ+أ4أ","أذظتىأثىأؼغۏۄأىەأتًضأثىأتًضأڬەأشضًهأتههۄأ﷽أضەأضوتؼأڬتأسڬشأڬۏتأۄەأ+أ5أ"
"1044","%أذعشحأؼثزتههۄأثىأتثۏأمحتزۄأشعۏأتههۄأؼىۄأڬۄحەأۄۏڽأ=أ+أتۏڬأوشحثۄأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄوتأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗأتًشأۄتشًىأثىأوضهوأؼدهۏأثظشۏًڽأىەأځشتىەأتضحتزأۄۏڽأۗأتىأڬًأذىتىۏأڬۄحەأۄۏڽأ=أۏۄأخمۄأۄۏڽأتىأضەأتذوزأثىأذىثهأتًشأؼثزتههۄأثىأؼوشأتهمًتشۏشۏأىەأثہۏأذزۏخأشًتۏحأڬۏأۄەأۗ%أ",""
"1045","%أذعشحأتثًۄشۏشۄأتًشأتثًضؼۏزأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدًأطرظأدوؼۄأڬەأزىأؽضهأڬشەأ؏أتډہەأڬځڔەأځۄىەأتًشأتڲشأوۏضشأۄًأحًأرًطثًأهڲتةەأځہشأوضدزأوۏڽأإةەأتًشأهًڲًڽأڬۏأڲشزىۏڽأىۄأځہهتىڲەأځہشأتههۄأڬۏأحًلۏمأضەأىوتصأځڔہەأځہشأدثأتوتوأوىثشأځشأثۏټہأدتةەأحًأًۄأرتوًطأۄًأدتةەأحًأتضأڬتأۏۄأؼوهأتڲهەأدوؼۄأحڬأڬەأڲىتۄًڽأڬەأهۏەأڬلتشۄأۄەأۗ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتضەأظذۏذۏىأوۏڽأىمهأىۄۏڽأڬۏتأڲۏتأۗأتًشأتضأذزۏخأڬًأتضوتؼۏهأثىأؼهۏۄأىەأثہۏأذوتزأثىأضهوۄأڬۏأشًتۏحأڬۏأغشذأوذوزأثىأتضذتمأضەأشًتۏحأڬۏتأۄەأتًشأتضأوۏڽأتثًضهوۄأشعۏأتههۄأؼىۄأڬەأضتحہأتثًتوتوۄأثىأضۄهأڬتأسڬشأۄەأۗ%أ",""
"1046","أذعشحأتثًۄشۏشۄأتًشأتثًضؼۏزأشعۏأتههۄأؼىۄوتأشضًهأتههۄأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أدًأطرظأدوؼۄأڬەأزىأؽضهأڬشەأتًشأتڲشأوۏضشأۄًأحًأرًطثًأهڲتةەأتًشأتډہەأڬځڔەأځۄىەأځہشأوضدزأڬۏأغشلأإةەأتًشأهًڲًڽأڬۏأڲشزىًڽأڬًأىۄأځہهتىڲەأځہشأتههۄأڬۏأزۏأۄًةۏأحًلۏمأڬەأوغتثمأىوتصأځڔہەأځہشأتوتوأضەأىڬهىەأضەأهەأڬشأتوتوأڬەأىوتصأځڔہتىەأحڬأرتوًطأشۄەأ+أحًأتضأڬتأۏۄأؼوهأ"
"1047","%أذعشحأتثىأؼوشأشعۏأتههۄأؼوۄوتألشوتحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أدثأدوؼۄأڬەأزىأإأڬشأوىثشأځشأثۏټہأدتحەأحًأذعشحأثهتهأشعۏأتههۄأؼىۄأتستىأزۏحەأۗ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضەأىمهأىۄۏڽأڬۏتأڬۏًىڬۄأۄطتوأثىأؽتصأًۄأشتًۏأۄۏڽأدىأڬۏأتذتزۏخأدوؼأڬۏأدتحۏأۄۏڽأۗ%أ",""
"1048","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتأثۏتىأڬشحەأۄۏڽأ؏أىثۏأتڬشوأ﷽أدوؼۄأڬەأزىأوىثشأځشأثۏټہەأتًشأهًڲًڽأضەألشوتۏتأ=أثۏټہأدتاأ$أتثىأوضؼًزأشعۏأتههۄأؼىۄأىەأدثأۏۄأثتحأضىۏأحًأًۄأوضدزأڬەأزشًتصەأوۏڽأحہەأًۄأًۄۏڽأثۏټہأڲةەأۗأىثۏأتڬشوأ﷽أىەأتىأضەأڬۄتأ=أتەأتثىأوضؼًزأ+أشعۏأتههۄأؼىۄأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄوتأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1049","أوذوزأثىأضۏشۏىأڬەأډډتصتزأثہتةۏأۏذۏۏأثىأوذوزأثىأۏذۏۏأڬۄحەأۄۏڽأ=أتثىأؼثتضأشعۏأتههۄأؼىۄوتأىەأتځىەأوًسىأڬًأثتشطأًتهەأزىأڬۄتأ=أدثأ““أ®تطہزأتىأوذوزأشضًهأتههۄ¾أځڔہأهًأحًأتضأڬەأثؼزأ““أ®ذۏۏأتهتؼهۏأتهظهًۆ¾أ‛‛أوحأڬۄًأثهڬۄأڬۄًأ““أ®ظهًألۏأثۏًحڬو¾أ‛‛أ+أتځىەأڲہشًڽأوۏڽأىوتصأځڔہأهًأ"
"1050","أذتشخۄأثىأىؼوتىأڬۏأثۏټۏأڬۄحۏأۄۏڽأ=أوۏڽأىەأضًشۆأمأشضًهأتههۄأ﷽أضەأضىأضىأڬشأۏتزأڬۏأۄەأۗأإځأۄشأدوؼۄأڬەأزىأضًشۆأځڔہحەأحہەأۗأۄوتشتأتًشأإځأڬتأتۏڬأۄۏأحىًشأحہتأۗأ"
"1051","%أذتشخۄأثىأىؼوتىأڬۏأثۏټۏأتوأۄطتوأڬۄحۏأۄۏڽأ=أوۏڽأىەأضًشۆأمأًأتهمشإىأتهودۏزأشضًهأتههۄأ﷽أڬەأوىۄأضەأضىأڬشأۏتزأڬۏأۄەأۗأإځأ﷽أدوؼۄأڬەأرغثۄأوۏڽأۏۄأضًشۆأځڔہتأڬشحەأحہەأۗ"
"أٰٰأۏذۏۏأثىأؼثزتههۄأؼثزتهشذوىأثىأتضؼزأثىأصشتشۄأڬەأثۏټەأۄۏڽأۗ%أ",""
"1052","%أذعشحأتثًضؼۏزأشعۏأتههۄأؼىۄأڬۄحەأۄۏڽأ=أتۏڬأزىأشضًهأتههۄأ﷽أىەأۄوۏڽأرغثۄأزۏتأحًأرغثۄأوۏڽأضًشۆأ+أظأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄوتأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗأتًشأضًشۆأظأوۏڽأضدزۄأڬەأذًتهەأضەأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأىەأذزۏخأىمهأڬۏأتًشأتضأذزۏخأڬًأڬحتثأتهدوؼۄأوۏڽأىمهأڬشىەأڬۏأؽشعأۏۄأحہۏأڬۄأتوتوأتڲشأدوؼۄأڬەأزىأوىثشأځشأإۏحأضدزۄأځڔہەأحًأضىەأۏۄأۄەأڬۄأًۄأوىثشأضەأتحشأڬشأضدزۄأڬشەأۗ%أ",""
"1053","%أذعشحأدشۏشأثىأؼثزتههۄأشعۏأتههۄأؼىۄأڬۄحەأۄۏڽأ=أدثأوۏڽأشضًهأتههۄأ﷽أڬەأطۄشأڬەأمشۏثأۄًتأحًأتځىەأتًىټأڬًأثټہتۏتأ؏أڬځڔًڽأڬتأظىزًمأڬہًهتأ+أتضأوۏڽأضەأدثۄأىڬتهأڬشأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأۗأتًشأۏۄأذزۏخأزهۏهأۄەأڬۄأتوتوأرغثۄأڬەأزًشتىأتضأوؼتوهەأوۏڽأڲلحڲًأڬشأضڬحتأۄەأدًأتضۏأًمحأڬەأهۏەأػتۄشأۄًتأۗ%أ",""
"1054","%أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ؏أدوؼۄأڬەأزىأإځأ+أدوؼۄأځڔہىەأڬەأهۏەأوضدزأوۏڽأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأتًشأۏۄأڲصطحۄأذزۏخأڬۏأطتۄزأۄەأتًشأتضأڬتأتۏڬأزًضشتأطتۄزأثہۏأۄەأدًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأځشأۄەأۗ%أ",""
"1055","أذعشحأتثًشلتؼۄأتهؼزًۏأڬۄحەأۄۏڽأ=أوۏڽأىثۏأتڬشوأ﷽أڬەأځتضأځۄىډتأحًأإځأرغثۄأتشطتزألشوتأشۄەأحہەأوۏڽأىەأؼشعأڬۏتأۏتأشضًهأتههۄأ$أتۏڬأوضتلشأتځىەأزۏىأڬەأوحؼهمأڬډہأځًډہىەأإۏتأۄەأدضأڬًأتضأضەأمثهأزۏىأڬەأثتشەأوۏڽأوؼهًوتحأىۄۏڽأۄۏڽأۗأحًأشضًهأتههۄأ﷽أرغثۄأډہًڔأڬشأوۏشۏأغشلأوحًدۄأۄًأڲةەأۗأإځأىەأتۏڬأرتهۏأڬشضۏأوىڲًتةۏأدضأڬەأځتةەأهًۄەأڬەأحہەأځہشأإځأودہەأًۄأڬډہأضڬہتىەأهڲەأدًأتههۄأىەأإځأڬًأضڬہتۏتأۄەأ+أدثأودہەأوضتةهأثحتأڬشألتشؽأۄًةەأ"
"1088","%أذعشحأؼثزتههۄأثىأثشۏزۄأشعۏأتههۄأؼىۄأتځىەأًتهزأڬەأذًتهەأضەأثۏتىأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أؼۏزتهلغشأڬەأزىأ+أىوتصأڬەأهۏەأڲہشأضەأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأ؏أتًشأخًتثأثىأؼحثۄأتهوۄشۏأڬۏأشًتۏحأڬشزۄأتذتزۏخأثۄحأڬوأۄەأتًشأتىأځشأتضأغشذأڬۏأڬًةۏأدشذأختثحأىۄۏڽأۄەأدضأڬۏأًدۄأضەأتىأڬۏأذزۏخأڬًأحشڬأڬۏتأدتةەأتًشأۏۄأؼوهأغشۏمأشًتۏحأضەأضىحأؼصۏصۄأۄەأتًشأوضهوتىًڽأڬەأووتهڬأوۏڽأوطۄًشأۄەأۗ%أ",""
"1089","%أذعشحأتىضأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أؼۏزتهلغشأڬەأزىأ+أؼۏزأڲتۄأڬۏأغشلأ"
