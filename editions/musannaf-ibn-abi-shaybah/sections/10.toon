hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"9019","(۹۰۱۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یمنعُکم أَذَانُ بِلاَلٍ مِنْ سُحُورِکُمْ ، فَإِنَّ فِی بَصَرِہِ شَیْئًا۔ (احمد ۳/۱۴۰۔ ابویعلی ۲۹۱۰)","Sahih","Musannaf Ibn Abi Shaybah 9019","","","كتاب الصيام"
"9020","(۹۰۲۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی ہِلاَلٍ ، قَالَ : حدَّثَنَا سَوَادَۃُ بْنُ حَنْظَلَۃَ الْہِلاَلِیُّ ، عَنْ سَمُرَۃََ بْنِ جُنْدُبٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَمْنَعَنَّکُمْ مِنَ السُّحُورِ أَذَانُ بِلاَلٍ ، وَلاَ الصُّبْحُ الْمُسْتَطِیلُ ، وَلَکِنِ الصُّبْحُ الْمُسْتَطِیرُ فِی الأفُقِ۔ (ترمذی ۷۰۶۔ احمد ۵/۱۳)","Hasan","Musannaf Ibn Abi Shaybah 9020","","","كتاب الصيام"
"9021","(۹۰۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، قَالَ : تَسَحَّرْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ قُمْنَا إلَی الصَّلاَۃِ ، قُلْنَا : کَمْ کَانَ بَیْنَہُمَا ؟ قَالَ : قِرَائَۃُ خَمْسِینَ آیَۃً۔ (مسلم ۷۷۱۔ ترمذی ۷۰۴)","Sahih","Musannaf Ibn Abi Shaybah 9021","","","كتاب الصيام"
"9022","(۹۰۲۲) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یَسَاف ، عَنْ سَالِمِ بْنِ عُبَیْدٍ الأَشْجَعِیِّ ، قَالَ : کُنْتُ مَعَ أَبِی بَکْرٍ ، فَقَالَ : قُمْ فَاسْتُرْنِی مِنَ الْفَجْرِ ، ثُمَّ أَکَلَ۔","Sahih","Musannaf Ibn Abi Shaybah 9022","","","كتاب الصيام"
"9023","(۹۰۲۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ شَبِیبِ بْنِ غَرْقَدَۃَ ، عَنْ أَبِی عَقِیلٍ ، قَالَ : تَسَحَّرْت مَعَ عَلِیٍّ ، ثُمَّ أَمَرَ الْمُؤَذِّنَ أَنْ یُقِیمَ۔","Da'if","Musannaf Ibn Abi Shaybah 9023","","","كتاب الصيام"
"9024","(۹۰۲۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ جَبَلَۃَ بْنِ سُحَیْمٍ ، عَنْ عَامِرِ بْنِ مَطَرٍ ، قَالَ : أَتَیْتُ عَبْدَ اللہِ فِی دَارِہِ فَأَخْرَجَ لَنَا فَضْلَ سُحُورِہِ فَتَسَحَّرْنَا مَعَہُ ، فَأُقِیمَتِ الصَّلاَۃُ ، فَخَرَجْنَا فَصَلَّیْنَا مَعَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 9024","","","كتاب الصيام"
"9025","(۹۰۲۵) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرٍو ، یَعْنِی ابْنَ حُرَیْثٍ ، قَالَ : کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَعْجَلَ النَّاسِ إفْطَارًا ، وَأَبْطَأَہَمُ سُحُورًا۔","","Musannaf Ibn Abi Shaybah 9025","","","كتاب الصيام"
"9026","(۹۰۲۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ أَبِی یَعْفُورٍ ، قَالَ: سَمِعْتُ أَبَا الشَّعْثَائِ جَابِرَ بْنَ زَیْدٍ یَقُولُ: کَانُوا یَتَسَحَّرُونَ حِینَ۔","","Musannaf Ibn Abi Shaybah 9026","","","كتاب الصيام"
"9027","(۹۰۲۷) حَدَّثَنَا وَکِیعٌ، عَنْ عَمْرِو بْنِ مَرْوَانَ أَبِی الْعَنْبَسِ، قَالَ: سَمِعْتُ إبْرَاہِیمَ یَقُولُ: مِنَ السُّنَّۃِ تَأْخِیرُ السُّحُورِ۔","","Musannaf Ibn Abi Shaybah 9027","","","كتاب الصيام"
"9028","(۹۰۲۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا الْوَلِیدُ بْنُ جُمَیع، قَالَ: حَدَّثَنَا أَبُو الطُّفَیْلِ؛ أَنَّہُ تَسَحَّرَ فِی أَہْلِہِ فِی الْجَبَّانَۃِ ، ثُمَّ جَائَ إلَی حُذَیْفَۃَ وَہُوَ فِی دَارِ الْحَارِثِ بْنِ أَبِی رَبِیعَۃَ فَوَجَدَہُ ، فَحَلَبَ لَہُ نَاقَۃً فَنَاوَلَہُ ، فَقَالَ: إنِّی أُرِیدُ الصَّوْمَ، فَقَالَ: وَأَنَا أُرِیدُ الصَّوْمَ، فَشَرِبَ حُذَیْفَۃُ، وَأَخَذَ بِیَدِہِ فَدَفَعَ إلَی الْمَسْجِدِ حِینَ أُقِیمَتِ الصَّلاَۃُ۔","Hasan","Musannaf Ibn Abi Shaybah 9028","","","كتاب الصيام"
"9029","(۹۰۲۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ التَّیْمِیِّ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : یَکُونُ بَیْنَ سُحُورِ الرَّجُلِ وَبَیْنَ إقَامَۃِ الْمُؤَذِّنِ قَدْرُ مَا یَقْرَأُ سُورَۃَ یُوسُفَ۔","","Musannaf Ibn Abi Shaybah 9029","","","كتاب الصيام"
"9030","(۹۰۳۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنْ أَبِیہِ ، قَالَ : خَرَجْت مَعَ حُذَیْفَۃَ إلَی الْمَدَائِنِ فِی رَمَضَانَ ، فَلَمَّا طَلَعَ الْفَجْرُ ، قَالَ : ہَلْ کَانَ أَحَدٌ مِنْکُمْ آکِلاً ، أَوْ شَارِبًا ؟ قُلْنَا : أَما رَجُلٌ یُرِیدُ الصَّوْمَ فَلاَ ، ثُمَّ سِرْنَا حَتَّی اسْتَبْطَأْنَاہُ فِی الصَّلاَۃِ ، ثُمَّ نَزَلَ فَصَلَّی۔","Sahih","Musannaf Ibn Abi Shaybah 9030","","","كتاب الصيام"
"9031","(۹۰۳۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : مِنْ أَخْلاَقِ الأَنْبِیَائِ تَأْخِیرُ السُّحُورِ۔","","Musannaf Ibn Abi Shaybah 9031","","","كتاب الصيام"
"9032","(۹۰۳۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ ابْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ حُذَیْفَۃُ یُعَجِّلُ بَعْضَ سحُورِہِ لِیُدْرِکَ الصَّلاَۃَ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَبَلَغَ ذَلِکَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَکَانَ یُرْسِلُ إلَیْہِ فَیَأْکُلُ مَعَہُ حَتَّی یَخْرُجَا إلَی الصَّلاَۃِ جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 9032","","","كتاب الصيام"
"9033","(۹۰۳۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حَدَّثَنَا شُعْبَۃُ ، عَنْ خُبَیبِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : سَمِعْتُ عَمَّتِی تَقُولُ ، وَکَانَتْ حَجَّتْ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إنَّ ابْنَ أُمِّ مَکْتُومٍ یُنَادِی بِلَیْلٍ ، فَکُلُوا وَاشْرَبُوا حَتَّی یُنَادِیَ بِلاَلٌ ، وَإِنَّ بِلاَلاً یُؤَذِّنُ بِلَیْلٍ فَکُلُوا وَاشْرَبُوا حَتَّی یُنَادِیَ ابْنُ أُمِّ مَکْتُومٍ ، قَالَتْ : وَکَانَ یَصْعَدُ ہَذَا وَیَنْزِلُ ہَذَا ، فَکُنَّا نَتَعَلَّقُ بِہِ فَنَقُولُ : کَمَا أَنْتَ حَتَّی نَتَسَحَّرَ۔n(طیالسی ۱۶۶۱۔ طبرانی ۴۸۱)","Sahih","Musannaf Ibn Abi Shaybah 9033","","","كتاب الصيام"
"9034","(۹۰۳۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، وَوَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ، عَنْ أَبِیہِ ، عَنْ عَاصِمِ بْنِ عُمَرَ ، عَنْ عُمَرَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا جَائَ اللَّیْلُ مِنْ ہَاہُنَا ، وَذَہَبَ النَّہَارُ مِنْ ہَاہُنَا فَقَدْ أَفْطَرَ الصَّائِمُ۔ (ابوداؤد ۲۳۴۳۔ احمد ۱/۲۸)","Sahih","Musannaf Ibn Abi Shaybah 9034","","","كتاب الصيام"
"9035","(۹۰۳۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ الشَّیْبَانِیِّ ، عَنِ ابْنِ أَبِی أَوْفَی ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ وَہُوَ صَائِمٌ ، فَلَمَّا غَابَتِ الشَّمْسُ ، قَالَ : یَا فُلاَنُ انْزِلْ فَاجْدَحْ لَنَا ، قَالَ : یَا رَسُولَ اللہِ ، إنَّ عَلَیْک نَہَارًا ، قَالَ : انْزِلْ فَاجْدَحْ لَنَا ، قَالَہَا ثَلاَثًا ، فَنَزَلَ فَجَدَحَ فَشَرِبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ قَالَ : إذَا رَأَیْتُمُ اللَّیْلَ قَدْ أَقْبَلَ مِنْ ہَاہُنَا فَقَدْ أَفْطَرَ الصَّائِمُ۔n قُلْت : وَأَنْتَ مَعَہُ ؟ قَالَ : نَعَمْ۔ (بخاری ۱۹۴۱۔ مسلم ۷۷۳)","Sahih","Musannaf Ibn Abi Shaybah 9035","","","كتاب الصيام"
"9036","(۹۰۳۶) حَدَّثَنَا زِیَادُ بْنُ الرَّبِیعِ ، وَکَانَ ثِقَۃً ، عَنْ أَبِی جَمْرَۃَ الضُّبَعِیِّ ؛ أَنَّہُ کَانَ یُفْطِرُ مَعَ ابْنِ عَبَّاسٍ فِی رَمَضَانَ ، فَکَانَ إذَا أَمْسَی بَعَثَ رَبِیبۃ لَہُ تَصْعَدُ ظَہْرَ الدَّارِ ، فَإِذَا غَابَت الشَّمْسُ أَذَّنَ ، فَیَأْکُلَ وَنَأْکُلَ ، فَإِذَا فَرَغَ أُقِیمَتِ الصَّلاَۃُ فَیَقُومَ یُصَلِّی وَنُصَلِّیَ مَعَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9036","","","كتاب الصيام"
"9037","(۹۰۳۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَزَالُ الدِّینُ ظَاہِرًا مَا عَجَّلَ النَّاسُ الْفِطْرَ ، إنَّ الْیَہُودَ وَالنَّصَارَی یُؤَخِّرُونَ۔ (ابوداؤد ۲۳۴۵۔ احمد ۲/۴۵۰)","Hasan","Musannaf Ibn Abi Shaybah 9037","","","كتاب الصيام"
"9038","(۹۰۳۸) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ، أَنَّہُ سَمِعَہُ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَزَالُ النَّاسُ بِخَیْرٍ مَا عَجَّلُوا إفْطَارَہُمْ ، وَلَمْ یُؤَخِّرُوہُ تَأْخِیرَ أَہْلِ الْمَشْرِقِ۔ (بخاری ۱۹۵۷۔ ترمذی ۶۹۹)","","Musannaf Ibn Abi Shaybah 9038","","","كتاب الصيام"
"9039","(۹۰۳۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ طَارِقٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : کَانَ عُمَرُ یَکْتُبُ إلَی أُمَرَائِہِ أَنْ لاَ تَکُونُوا مِنَ الْمُسوِفِینَ لِفِطْرِکُمْ ، وَلاَ تَنْتَظِرُوا بِصَلاَتِکُمُ اشْتِبَاکَ النُّجُومِ۔","Sahih","Musannaf Ibn Abi Shaybah 9039","","","كتاب الصيام"
"9040","(۹۰۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سِمَاک ، عَنْ ثَرْوَانَ بْنِ مِلْحَانَ التَّیْمِیِّ ، قَالَ : قَالَ رَجُلٌ لِعَمَّار بْنِ یَاسِرٍ : إنَّ أَبَا مُوسَی قَالَ : لاَ تُفْطِرُوا حِینَ تَبْدُو الْکَوَاکِبُ ، فَإِنَّ ذَلِکَ فِعْلُ الْیَہُودِ۔","Da'if","Musannaf Ibn Abi Shaybah 9040","","","كتاب الصيام"
"9041","(۹۰۴۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : أُتِیَ عَبْدُ اللہِ بِجَفْنَۃٍ ، فَقَالَ لِلْقَوْمِ : اُدْنُوْا فَکُلُوا ، فَاعْتَزَلَ رَجُلٌ مِنْہُمْ ، فَقَالَ لَہُ عَبْدُ اللہِ : مَا لَکَ ؟ قَالَ : إنِّی صَائِمٌ ، فَقَالَ عَبْدُ اللہِ : ہَذَا وَالَّذِی لاَ إلَہَ غَیْرُہُ حِینَ حَلَّ الطَّعَامُ لآکِلٍ۔","Sahih","Musannaf Ibn Abi Shaybah 9041","","","كتاب الصيام"
"9042","(۹۰۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ أَیْمَنَ ، عَنْ أَبِیہِ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : دَخَلْت عَلَیْہِ فَأَفْطَرَ عَلَی عِرْقٍ، وَأَنا أَرَی الشَّمْسَ لَمْ تَغْرُبْ۔","Sahih","Musannaf Ibn Abi Shaybah 9042","","","كتاب الصيام"
"9043","(۹۰۴۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، قَالَ : إنِّی کُنْت لآتِیَ ابْنَ عُمَرَ بِفِطْرِہِ ، فَأُغَطِّیہِ اسْتِحْیَائً مِنَ النَّاسِ أَنْ یَرَوْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9043","","","كتاب الصيام"
"9044","(۹۰۴۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنِ الْہَجَرِیِّ ، عَنْ رَجُلٍ مِنْ بَنِی سَوَادَۃَ ، قَالَ : انْطَلَقْت إلَی حُذَیْفَۃَ ، فَنَزَلْت مَعَہُ ، فَکَانَ إذَا غَابَتِ الشَّمْسُ نَزَلَ حُذَیْفَۃُ وَأَصْحَابُہُ ، لَمْ یَلْبَثْ إِلاَّ قَلِیلاً حَتَّی یُفْطِرَ۔","Da'if","Musannaf Ibn Abi Shaybah 9044","","","كتاب الصيام"
"9045","(۹۰۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مُسْلِمِ بْنِ یَزِیدَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ عَلِیُّ بْنُ أَبِی طَالِبٍ یَقُولُ لاِبْنِ النَّبَّاحِ : غَرَبَتِ الشَّمْسُ ؟ فَیَقُولُ : لاَ تَعْجَلْ ، فَیَقُولُ : غَرَبَتِ الشَّمْسُ ؟ فَیَقُولُ : لاَ تَعْجَلْ ، فَیَقُولُ : غَرَبَتِ الشَّمْسُ ؟ فَإذَا قَالَ : نَعَمْ ، أَفْطَرَ ، ثُمَّ نَزَلَ فَصَلَّی۔","Da'if","Musannaf Ibn Abi Shaybah 9045","","","كتاب الصيام"
"9046","(۹۰۴۶) حَدَّثَنَا عُمَرُ بْنُ سَعدٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَازِمٍ ، عَنْ سَہْلِ بْنِ سَعْدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَزَالُ ہَذِہِ الأُمَّۃُ بِخَیْرٍ مَا عَجَّلُوا الإِفْطَارَ۔ (مسلم ۷۷۱۔ ترمذی ۶۹۹)","Sahih","Musannaf Ibn Abi Shaybah 9046","","","كتاب الصيام"
"9047","(۹۰۴۷) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : إذَا رَأَیْت أَنَّ الْعَصْرَ قَدْ فَاتَتْک فَاشْرَبْ۔","","Musannaf Ibn Abi Shaybah 9047","","","كتاب الصيام"
"9048","(۹۰۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعَنْبَسِ عَمْرِو بْنِ مَرْوَانَ ، قَالَ : سَمِعْتُ إبْرَاہِیمَ یَقُولُ : إنَّ مِنَ السُّنَّۃِ تَعْجِیلَ الإِفْطَارِ۔","","Musannaf Ibn Abi Shaybah 9048","","","كتاب الصيام"
"9049","(۹۰۴۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُوسَی بْنِ أَنَسٍ ؛ أَنَّ أَنَسًا کَانَ یُصْعِدُ الْجَارِیَۃَ فَوْقَ الْبَیْتِ فَیَقُولُ : إذَا اسْتَوَی الأُفُقُ فَآذِنِینِی۔","Sahih","Musannaf Ibn Abi Shaybah 9049","","","كتاب الصيام"
"9050","(۹۰۵۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، عَنْ مُوَرِّقٍ الْعِجْلِیّ ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ : ثَلاث مِنْ أَخْلاَقِ النَّبِیِّینَ ؛ التَّبْکِیرُ فِی الإِفْطَارِ ، وَالإِبْلاَغُ فِی السُّحُورِ ، وَوَضْعُ الْیَمِینِ عَلَی الشِّمَالِ فِی الصَّلاَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 9050","","","كتاب الصيام"
"9051","(۹۰۵۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَیَانٍ ، عَنْ قَیْسٍ ، قَالَ : نَاوَلَ عُمَرُ رَجُلاً إنَائً إلَی جَنْبِہِ حِینَ غَرَبَتِ الشَّمْسُ ، فَقَالَ لَہُ : اشْرَبْ ، ثُمَّ قَالَ : لَعَلَّک مِنَ الْمُسَوِّفِینَ بِفِطْرِہِ ؛ سَوف سَوف۔","Sahih","Musannaf Ibn Abi Shaybah 9051","","","كتاب الصيام"
"9052","(۹۰۵۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ صَفْوَانَ بْنِ عَبْدِ اللہِ ، عَنْ أُمِّ الدَّرْدَائِ ، عَنْ کَعْبِ بْنِ عَاصِمٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ مِنَ الْبِرِّ الصِّیَامُ فِی السَّفَرِ۔ (ابن ماجہ ۱۶۶۴۔ احمد ۴۳۴)","Sahih","Musannaf Ibn Abi Shaybah 9052","","","كتاب الصيام"
"9053","(۹۰۵۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ سَعدٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو بْنِ الْحَسَنِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ ، فَرَأَی رَجُلاً قَدِ اجْتَمَعَ النَّاسُ عَلَیْہِ ، وَقَدْ ظُلِّلَ عَلَیْہِ ، فَقَالَ : مَا لَہُ ؟ قَالُوا : رَجُلٌ صَائِمٌ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ مِنَ الْبِرِّ أَنْ تَصُومُوا فِی السَّفَرِ۔ (بخاری ۱۹۴۶۔ مسلم ۹۲)","Sahih","Musannaf Ibn Abi Shaybah 9053","","","كتاب الصيام"
"9054","(۹۰۵۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ مُوَرِّقٍ ، عَنْ أَنَسٍ ، قَالَ : کُنَّا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ ، فَمِنَّا الصَّائِمُ وَمِنَّا الْمُفْطِرُ ، فَقَامَ الْمُفْطِرُونَ فَضَرَبُوا الأَبْنِیَۃَ وَسَقَوا الرِّکَابَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ذَہَبَ الْمُفْطِرُونَ الْیَوْمَ بِالأَجْرِ۔ (مسلم ۷۸۸۔ بیہقی ۲۴۳)","Sahih","Musannaf Ibn Abi Shaybah 9054","","","كتاب الصيام"
"9055","(۹۰۵۵) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی سَلَمَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، قَالَ : الصَّائِمُ فِی السَّفَرِ کَالْمُفْطِرِ فِی الْحَضَرِ۔","Hasan","Musannaf Ibn Abi Shaybah 9055","","","كتاب الصيام"
"9056","(۹۰۵۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی جَمْرَۃَ ، قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ عَنِ الصَّوْمِ فِی السَّفَرِ ؟ فَقَالَ : عُسْرٌ وَیُسْرٌ ، خُذْ بِیُسْرِ اللہِ عَلَیْک۔","Sahih","Musannaf Ibn Abi Shaybah 9056","","","كتاب الصيام"
"9057","(۹۰۵۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ زَکَرِیَّا ، عَنْ عَامِرٍ ؛ أَنَّہُ کَانَ لاَ یَصُومُ فِی السَّفَرِ۔","","Musannaf Ibn Abi Shaybah 9057","","","كتاب الصيام"
"9058","(۹۰۵۸) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ عَوْفٍ ، قَالَ : بَلَغَنِی أَنَّ الْحَسَنَ کَانَ یَقُولُ : الإِفْطَارُ فِی السَّفَرِ ، وَالْحَضَرُ رُخْصََۃ۔","","Musannaf Ibn Abi Shaybah 9058","","","كتاب الصيام"
"9059","(۹۰۵۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، أَنَّ ابْنَ عَبَّاسٍ قَالَ : الإِفْطَارُ فِی السَّفَرِ عَزِیمَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 9059","","","كتاب الصيام"
"9060","(۹۰۶۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : الإِفْطَارُ فِی السَّفَرِ صَدَقَۃٌ تَصَدَّقَ اللَّہُ بِہَا عَلَی عِبَادِہِ۔","","Musannaf Ibn Abi Shaybah 9060","","","كتاب الصيام"
"9061","(۹۰۶۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبیدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَامَ عَامَ الْفَتْحِ حَتَّی بَلَغَ الْکَدِیدَ ، ثُمَّ أَفْطَرَ ، وَإِنَّمَا یُؤْخَذُ بِالآخَرِ مِنْ فِعْلِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (بخاری ۲۹۵۳۔ احمد ۲۱۹)","Sahih","Musannaf Ibn Abi Shaybah 9061","","","كتاب الصيام"
"9062","(۹۰۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعُمَیْسِ ، قَالَ : سَأَلْتُ أَبَا جَعْدٍ عَنِ الصَّوْمِ فِی السَّفَرِ ؟ فَقَالَ : لاَ تَصُومَنَّ۔","","Musannaf Ibn Abi Shaybah 9062","","","كتاب الصيام"
"9063","(۹۰۶۳) حَدَّثَنَا وَکِیعٌ، عَنْ عَبْدِاللہِ بْنِ حُمَیْدٍ، عَنْ عَبْدِاللہِ بْنِ ذَکْوَانَ؛ أَنَّ ابْنَ عُمَرَ أَقَامَ بِالشَّامِ رَمَضَانَیْنِ فَأَفْطَرَ۔","","Musannaf Ibn Abi Shaybah 9063","","","كتاب الصيام"
"9064","(۹۰۶۴) حَدَّثَنَا أَبُوخَالِدٍ الأَحْمَرِِ، عَنْ مَنْصُورِ بْنِ حَیَّانَ، قَالَ: قَالَ سَعِیدُ بْنُ جُبَیْرٍ : مَنْ صَحِبَنِی فِی سَفَرٍ فَلاَ یَصُومَنَّ۔","","Musannaf Ibn Abi Shaybah 9064","","","كتاب الصيام"
"9065","(۹۰۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مُضَرِّسِ بْنِ عَبْدِ اللہِ ، قَالَ : قُلْتُ لِلشَّعْبِیِّ : إنِّی أُقِیمُ بِالرَّیِّ ، قَالَ : صَلِّ رَکْعَتَیْنِ ، قُلْتُ : فَالصَّوْمُ ؟ قَالَ : لاَ تَصُمْ ، أَفْطِرْ وَإِنْ أَقَمْت عَشْرَ سِنِینَ۔","","Musannaf Ibn Abi Shaybah 9065","","","كتاب الصيام"
"9066","(۹۰۶۶) حَدَّثَنَا أَبُو دَاوُدَ عُمَرُ بْنُ سَعْدٍ ، عَنْ سُفْیَانَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ فِی سَفَرٍ ، وَمَعَہُ أَبُو بَکْرٍ وَعُمَرُ ، فَأُتِیَ بِطَعَامٍ ، فَقَالَ لَہُمَا : اُدْنُوَا فَکُلاَ ، فَقَالاَ : یَا رَسُولَ اللہِ ، إنَّا صَائِمَانِ ، فَقَالَ : ارْحلُوا لِصَاحِبَیْکُمْ ، اعْمَلُوا لِصَاحِبَیْکُم ، اُدْنُوَا فَکُلاَ۔(نسائی ۲۵۷۲۔ احمد ۲/۳۳۶)","Sahih","Musannaf Ibn Abi Shaybah 9066","","","كتاب الصيام"
"9067","(۹۰۶۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَمَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، قَالَ : سُئِلَ أَنَسٌ عَنِ الصَّوْمِ فِی السَّفَرِ ؟ فَقَالَ : مَنْ أَفْطَرَ فَرُخْصَۃٌ ، وَمَنْ صَامَ فَالصَّوْمُ أَفْضَلُ۔","Sahih","Musannaf Ibn Abi Shaybah 9067","","","كتاب الصيام"
"9068","(۹۰۶۸) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : صَحِبْت عَائِشَۃَ فِی السَّفَرِ ، فَمَا أَفْطَرَتْ حَتَّی دَخَلَتْ مَکَّۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 9068","","","كتاب الصيام"
"9069","(۹۰۶۹) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنِ الْحَکَمِ بْنِ عَطِیَّۃَ ، عَنِ النَّضْرِ بْنِ عَبْدِ اللہِ الْقَیْسِیِّ ، عَنْ قَیْسِ بْنِ عُبَادٍ؛ أَنَّہُ کَانَ یَصُومُ فِی السَّفَرِ وَیُفْطِرُ۔","","Musannaf Ibn Abi Shaybah 9069","","","كتاب الصيام"
"9070","(۹۰۷۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُوسَی مَوْلَی ابْنِ عَامِرٍ ، قَالَ : سَأَلْتُ أَنَسًا عَنِ الصَّوْمِ فِی السَّفَرِ ؟ فَقَالَ : کُنَّا مَعَ أَبِی مُوسَی فِی السَّفَرِ فَصَامَ وَصُمْنَا۔","Da'if","Musannaf Ibn Abi Shaybah 9070","","","كتاب الصيام"
"9071","(۹۰۷۱) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی خَالِدٍ ، عَنِ ابْنِ الأَسْوَد ؛ أَنَّ أَبَاہُ کَانَ یَصُومُ فِی السَّفَرِ۔","","Musannaf Ibn Abi Shaybah 9071","","","كتاب الصيام"
"9072","(۹۰۷۲) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یَصُومُ فِی السَّفَرِ۔","","Musannaf Ibn Abi Shaybah 9072","","","كتاب الصيام"
"9073","(۹۰۷۳) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنِ ابْنِ عَوْنٍ، عَنِ الْقَاسِمِ، قَالَ: قَدْ رَأَیْت عَائِشَۃَ تَصُومُ فِی السَّفَرِ: حَتَّی أَذْلَقَہَا السَّمُومُ۔","Sahih","Musannaf Ibn Abi Shaybah 9073","","","كتاب الصيام"
"9074","(۹۰۷۴) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ عُثْمَانَ بْنُ أَبِی الْعَاصِ یَقُولُ فِی ذَلِکَ مِثْلَ قَوْلِ أَنَسِ بْنِ مَالِکٍ۔","Sahih","Musannaf Ibn Abi Shaybah 9074","","","كتاب الصيام"
"9075","(۹۰۷۵) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَخْرُجُ إلَی الْغَابَۃِ فَلاَ یُفْطِرُ ، وَلاَ یَقْصُرُ۔","Sahih","Musannaf Ibn Abi Shaybah 9075","","","كتاب الصيام"
"9076","(۹۰۷۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، أَنَّ عُثْمَانَ بْنَ أَبِی الْعَاصِ ، قَالَ : الصَّوْمُ فِی السَّفَرِ أَفْضَلُ ، وَالْفِطْرُ رُخْصَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 9076","","","كتاب الصيام"
"9077","(۹۰۷۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ کَہْمَسٍ ، قَالَ : سُئِلَ سَالِمٌ ، أَوْ سَأَلْتُہُ عَنِ الصَّوْمِ فِی السَّفَرِ ؟ فَقَالَ : إِنْ صُمْتُمْ فَقَدْ أَجْزَأَ عَنْکُمْ ، وَإِنْ أَفْطَرْتُمْ فَقَدْ رُخِّصَ لَکُمْ۔","","Musannaf Ibn Abi Shaybah 9077","","","كتاب الصيام"
"9078","(۹۰۷۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ؛ أَنَّ حَمْزَۃَ الأَسْلَمِیَّ سَأَلَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الصَّوْمِ فِی السَّفَرِ ؟ فَقَالَ : صُمْ إِنْ شِئْتَ ، وَأَفْطِرْ إِنْ شِئْت۔ (بخاری ۱۹۴۳۔ مسلم ۱۰۳)","Sahih","Musannaf Ibn Abi Shaybah 9078","","","كتاب الصيام"
"9079","(۹۰۷۹) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ الْعَوَّامِ ، قَالَ : قُلْتُ لِمُجَاہِدٍ : أَیُّ ذَلِکَ أَعْجَبُ إلَیْک ؟ قَالَ : إِذَا کُنْتَ تُطِیقُ الصَّوْمَ فَالصَّوْمُ أَعْجَبُ إلَیَّ۔","","Musannaf Ibn Abi Shaybah 9079","","","كتاب الصيام"
"9080","(۹۰۸۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَشْعَثِ بْنِ أَبِی الشَّعْثَائِ ، قَالَ : صَحِبْت أَبِی ، وَعَمْرَو بْنَ مَیْمُونٍ ، وَالأَسْوَد بْنَ یَزِیدَ ، وَأَبَا وَائِلٍ فَکَانُوا یَصُومُونَ رَمَضَانَ وَغَیْرَہُ فِی السَّفَرِ۔","","Musannaf Ibn Abi Shaybah 9080","","","كتاب الصيام"
"9081","(۹۰۸۱) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنْ أَبِیہِ ، قَالَ : اسْتَأْذَنْت حُذَیْفَۃَ بِالْمَدَائِنِ ، فَقَالَ لِی حُذَیْفَۃُ : بشرط عَلَی أَنْ لاَ تَقْصُرَ ، وَلاَ تُفْطِرَ۔","Hasan","Musannaf Ibn Abi Shaybah 9081","","","كتاب الصيام"
"9082","(۹۰۸۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِیُّ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : خَرَجْنَا مَعَ نَبِیِّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِن مَکَۃَ إلَی حُنَیْنٍ ، فِی اثْنَتَیْ عَشْرَۃَ بَقِیَتْ مِنْ رَمَضَانَ ، فَصَامَ طَائِفَۃٌ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَفْطَرَ آخَرُونَ ، فَلَمْ یَعِبْ ذَلِکَ۔ (مسلم ۹۴۔ احمد ۳/۹۲)","Sahih","Musannaf Ibn Abi Shaybah 9082","","","كتاب الصيام"
"9083","(۹۰۸۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : کُنَّا نَغْزُو مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَمِنَّا الصَّائِمُ وَمِنَّا الْمُفْطِرُ ، فَلاَ یَعِیبُ الصَّائِمُ عَلَی الْمُفْطِرِ ، وَلاَ الْمُفْطِرُ عَلَی الصَّائِمِ۔","Sahih","Musannaf Ibn Abi Shaybah 9083","","","كتاب الصيام"
"9084","(۹۰۸۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حُمَیْدٍ ، قَالَ : خَرَجْت فَصُمْت ، فَقَالُوا لِی : أَعِدْ ، قَالَ : فَقُلْتُ : إنَّ أَنَسًا أَخْبَرَنِی أَنَّ أَصْحَابَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانُوا یُسَافِرُونَ ، فَلاَ یَعِیبُ الصَّائِمُ عَلَی الْمُفْطِرِ ، وَلاَ الْمُفْطِرُ عَلَی الصَّائِمِ ، فَلَقِیتُ ابْنَ أَبِی مُلَیْکَۃَ فَأَخْبَرَنِی عَنْ عَائِشَۃَ ، بِمِثْلِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 9084","","","كتاب الصيام"
"9085","(۹۰۸۵) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، وَالْحَسَنِ ، وَسَعِیدِ بْنِ الْمُسَیَّبِ قَالُوا : کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُسَافِرُونَ فَیَصُومُ الصَّائِمُ ، وَیُفْطِرُ الْمُفْطِرُ ، فَلاَ یَعِیبُ الصَّائِمُ عَلَی الْمُفْطِرِ ، وَلاَ الْمُفْطِرُ عَلَی الصَّائِمِ۔","","Musannaf Ibn Abi Shaybah 9085","","","كتاب الصيام"
"9086","(۹۰۸۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمِ الأَحْوَلِ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ جَابِرٍ ، قَالَ : کُنَّا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَمِنَّا الصَّائِمُ وَمِنَّا الْمُفْطِرُ ، فَلَمْ یَکُنْ یَعِیبُ بَعْضُنَا عَلَی بَعْضٍ۔","Sahih","Musannaf Ibn Abi Shaybah 9086","","","كتاب الصيام"
"9087","(۹۰۸۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، حَدَّثَنَا الأَعْمَش ، عَنْ شَقِیقٍ ، قَالَ : کُنَّا مَعَ أَصْحَابِ عَبْدِ اللہِ فِی سَفَرٍ ، فَصَامَ بَعْضُہُمْ وَأَفْطَرَ بَعْضُہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 9087","","","كتاب الصيام"
"9088","(۹۰۸۸) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ عِمْرَانَ الْقَطَّانِ ، عَنْ عَمَّارٍ مَوْلَی بَنِی ہَاشِمٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ صَامَ رَمَضَانَ فِی سَفَرٍ ؟ فَقَالَ : لاَ یُجْزِیہِ۔","Da'if","Musannaf Ibn Abi Shaybah 9088","","","كتاب الصيام"
"9089","(۹۰۸۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ زُہَیْرٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَطَائٍ ، عَنِ الْمُحَرَّر بْنِ أَبِی ہُرَیْرَۃَ ، قَالَ : صُمْت رَمَضَانَ فِی السَّفَرِ ، فَأَمَرَنِی أَبُو ہُرَیْرَۃَ أَنْ أُعِیدَ الصِّیَامَ فِی أَہْلِی۔","Hasan","Musannaf Ibn Abi Shaybah 9089","","","كتاب الصيام"
"9090","(۹۰۹۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی الْفَیْضِ ، قَالَ : کُنَّا فِی غَزْوَۃٍ فَکَانَ عَلَیْنَا أَمِیرٌ ، فَقَالَ : لاَ تَصُومَنَّ ، فَمَنْ صَامَ فَلْیُفْطِرْ ، قَالَ أَبُو الْفَیْضِ : فَلَقِیتُ أَبَا قِرْصَافَۃَ ، رَجُلاً مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَسَأَلْتُہُ عَنْ ذَلِکَ ؟ فَقَالَ : لَوْ صُمْتُ ثُمَّ صُمْتُ مَا قَضَیْتُ۔","Sahih","Musannaf Ibn Abi Shaybah 9090","","","كتاب الصيام"
"9091","(۹۰۹۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ رَجُلٍ ، عَنْ أَبِیہِ ؛ أَنَّ رَجُلاً صَامَ رَمَضَانَ فِی السَّفَرِ ، فَأَمَرَہُ عُمَرُ رَحِمَہُ اللَّہُ أَنْ یُعِیدَ۔","Da'if","Musannaf Ibn Abi Shaybah 9091","","","كتاب الصيام"
"9092","(۹۰۹۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبِیْدَۃَ ، قَالَ : سَأَلْتُُہُ عَنْ قَوْلِہِ تَعَالَی : {فَمَنْ شَہِدَ مِنْکُمُ الشَّہْرَ فَلْیَصُمْہُ} ؟ قَالَ : مَنْ شَہِدَ أَوَّلَہُ فَلْیَصُمْ آخِرَہُ ، أَلاَ تَرَی إلَی قَوْلِہِ تَعَالَی : {فَمَنْ شَہِدَ مِنْکُمُ الشَّہْرَ فَلْیَصُمْہُ}۔","","Musannaf Ibn Abi Shaybah 9092","","","كتاب الصيام"
"9093","(۹۰۹۳) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : إذَا دَخَلَ شَہْرُ رَمَضَانَ فَلاَ یَخْرُجُ ، فَإِنْ أَبَی إِلاَّ أَنْ یَخْرُجَ فَلْیُتِمَّ صَوْمَہُ۔","","Musannaf Ibn Abi Shaybah 9093","","","كتاب الصيام"
"9094","(۹۰۹۴) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عَلِیٍّ رحمہ اللہ تَعَالَی ، قَالَ : إذَا أَدْرَکَہُ رَمَضَانُ وَہُوَ مُقِیمٌ ثُمَّ سَافَرَ فَلْیَصُمْ۔","","Musannaf Ibn Abi Shaybah 9094","","","كتاب الصيام"
"9095","(۹۰۹۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، أَخْبَرَنَا عَمْرُو بْنُ مُرَّۃَ ، قَالَ : سَمِعْتُ أَبَا الْبَخْتَرِیِّ یُحَدِّثُ ، عَنْ عُبَیْدَۃَ ، أَنَّہُ قَالَ فِی الرَّجُلِ یَصُومُ مِنْ رَمَضَانَ أَیَّامًا ، ثُمَّ یَخْرُجُ ، قَالَ : یَصُومُ ۔ وَقَالَ ابْنُ عَبَّاسٍ : إِنْ شَائَ صَامَ : وَإِنْ شَائَ أَفْطَرَ۔","","Musannaf Ibn Abi Shaybah 9095","","","كتاب الصيام"
"9096","(۹۰۹۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْحَجَّاجِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ خَرَجَ فِی رَمَضَانَ فَأَفْطَرَ۔","","Musannaf Ibn Abi Shaybah 9096","","","كتاب الصيام"
"9097","(۹۰۹۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ عَاصِمٍ، عَنِ الْحَسَنِ، أَنَّہُ قَالَ: لاَ بَأْسَ فِی السَّفَرِ فِی رَمَضَانَ، وَیُفْطِرُ إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 9097","","","كتاب الصيام"
"9098","(۹۰۹۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَامَ عَامَ الْفَتْحِ حَتَّی بَلَغَ الْکَدِیدَ ، ثُمَّ أَفْطَرَ۔","Sahih","Musannaf Ibn Abi Shaybah 9098","","","كتاب الصيام"
"9099","(۹۰۹۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : سَأَلْتُ عَبِیْدَۃَ: أُسَافِرُ فِی رَمَضَانَ؟ فَقَالَ: لاَ۔","","Musannaf Ibn Abi Shaybah 9099","","","كتاب الصيام"
"9100","(۹۱۰۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ سُفْیَانَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ عَلِیِّ بْنِ حُسَیْنٍ ؛ أَنَّہُ سُئِلَ عَنْ قَوْمٍ سَافَرُوا فِی رَمَضَانَ ؟ قَالَ : یَصُومُونَ۔","","Musannaf Ibn Abi Shaybah 9100","","","كتاب الصيام"
"9101","(۹۱۰۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ؛ فِی قولہ تعالی : {وَعَلَی الَّذِینَ یُطِیقُونَہُ فِدْیَۃٌ طَعَامُ مِسْکِینٍ} قَالَ : نَسَخَتْہَا {فَمَنْ شَہِدَ مِنْکُمُ الشَّہْرَ فَلْیَصُمْہُ}۔","","Musannaf Ibn Abi Shaybah 9101","","","كتاب الصيام"
"9102","(۹۱۰۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إِنَّہَا قَدْ نَسَخَتْ ہَذِہِ الآیَۃَ : {فَمَنْ شَہِدَ مِنْکُمُ الشَّہْرَ فَلْیَصُمْہُ} الآیَۃُ الَّتِی بَعْدَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 9102","","","كتاب الصيام"
"9103","(۹۱۰۳) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ أَیُّوبَ ، عَنْ أَبِی یَزِیدَ ، عَنْ أُمِّ ذَرَّۃَ قَالَتْ : أَتَیْتُ عَائِشَۃَ ، فَقَالَتْ : مِنْ أَیْنَ جِئْت؟ فَقُلْتُ: مِنْ عِنْدِ أَخِی ، فَقَالَتْ : مَا شَأْنُہُ ؟ قُلْتُ : وَدَّعْتُہُ یُرِیدُ أَنْ یَرْتَحِلَ ۔ قَالَتْ : فَأَقْرِئِیہِ مِنِّی السَّلاَمَ، وَمُرِیہِ فَلْیَقُمْ ، فَلَوْ أَدْرَکَنِی وَأَنَا بِبَعْضِ الطَّرِیقِ لأَقَمْتُ ، یَعْنِی رَمَضَانَ۔","Hasan","Musannaf Ibn Abi Shaybah 9103","","","كتاب الصيام"
"9104","(۹۱۰۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : خَرَجَ أَبُو مَیْسَرَۃَ فِی رَمَضَانَ مُسَافِرًا ، فَمَرَّ بِالْفُرَاتِ وَہُوَ صَائِمٌ فَأَخَذَ مِنْہُ حَسْوَۃً ، فَشَرِبَہُ وَأَفْطَرَ۔","","Musannaf Ibn Abi Shaybah 9104","","","كتاب الصيام"
"9105","(۹۱۰۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ قَالاَ : یُفْطِرُ إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 9105","","","كتاب الصيام"
"9106","(۹۱۰۶) حَدَّثَنَا أَبُو بَکْرٍ حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی الْوَرْدِ بْنِ ثُمَامَۃَ ، عَنِ اللَّجْلاَجِ ، قَالَ: کُنَّا نُسَافِرُ مَعَ عُمَرَ رضی اللَّہُ عَنْہُ ثَلاَثَۃَ أَمْیَالٍ ، فَیَتَجَوَّزُ فِی الصَّلاَۃِ وَیُفْطِرُ۔","Hasan","Musannaf Ibn Abi Shaybah 9106","","","كتاب الصيام"
"9107","(۹۱۰۷) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ : أُقْصِرُ الصَّلاَۃَ وَأُفْطِرُ إلَی رِیمٍ ؟ قَالَ : نَعَمْ ، وَہُوَ بَرِیدان مِنَ الْمَدِینَۃِ۔","","Musannaf Ibn Abi Shaybah 9107","","","كتاب الصيام"
"9108","(۹۱۰۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ عَطَائٌ : الصِّیَامُ فِی السَّفَرِ مِثْلُ الصَّلاَۃِ ، تَقْصُرُ إذَا أَفْطَرْت ، وَتَصُومُ إذَا وَفَّیْتَ الصَّلاَۃَ۔","","Musannaf Ibn Abi Shaybah 9108","","","كتاب الصيام"
"9109","(۹۱۰۹) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : سَأَلْتُ الزُّہْرِیَّ : فِی کَمْ تُقْصَرُ الصَّلاَۃُ ؟ قَالَ : فِی السَّفَرِ الْمُمْعِنِ ، قَالَ : قُلْتُ : وَمَا الإِمْعَانُ فِی نَفْسِکَ ؟ قَالَ : یَوْمَیْنِ۔","","Musannaf Ibn Abi Shaybah 9109","","","كتاب الصيام"
"9110","(۹۱۱۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنْ أَبِیہِ ، قَالَ : کُنْتُ مَعَ حُذَیْفَۃَ بِالْمَدَائِنِ ، قَالَ: فَاسْتَأْذَنْتُہُ بِالرُّجُوعِ إلَی أَہْلِی ، فَقَالَ : لاَ آذَنُ لَکَ إِلاَّ عَلَی أَنْ تَعْزِمَ أَلاَّ تُفْطِرَ حَتَّی تَدْخُلَ ، قَالَ : وَذَلِکَ فِی رَمَضَانَ ، قُلْتُ : وَأَنَا أَعْزِمُ عَلَی نَفْسِی أَنْ لاَ أُفْطِرَ ، وَلاَ أَقْصُرَ حَتَّی آتِیَ أَہْلِی۔","Sahih","Musannaf Ibn Abi Shaybah 9110","","","كتاب الصيام"
"9111","(۹۱۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مَرْثَدٍ ؛ أَنَّ أَبَا مَیْسَرَۃَ سَافَرَ فِی رَمَضَانَ ، فَأَفْطَرَ عِنْدَ بَابِ الْجِسْرِ۔","","Musannaf Ibn Abi Shaybah 9111","","","كتاب الصيام"
"9112","(۹۱۱۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَصُومُوا قَبْلَ رَمَضَانَ ، صُومُوا لِرُؤْیَتِہِ وَأَفْطِرُوا لِرُؤْیَتِہِ ، فَإِنْ حَالَتْ دُونَہُ غَیَایَۃٌ فَکَمِّلُوا ثَلاَثِینَ۔ (ترمذی ۶۸۸۔ ابویعلی ۲۳۵۵)","","Musannaf Ibn Abi Shaybah 9112","","","كتاب الصيام"
"9113","(۹۱۱۳) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ رِبْعِیٍّ ، عَنْ رَجُلٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَقَدَّمُوا الشَّہْرَ إِلاَّ أَنْ تَرَوُا الْہِلاَلَ ، أَوْ تُکْمِلُوا الْعِدَّۃَ ، وَلاَ تُفْطِرُوا حَتَّی تَرَوُا الْہِلاَلَ ، أَوْ تُکْمِلُوا الْعِدَّۃَ۔ (ابوداؤد ۲۳۲۰۔ نسائی ۲۴۳۶)","Sahih","Musannaf Ibn Abi Shaybah 9113","","","كتاب الصيام"
"9114","(۹۱۱۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ، قَالَ : صُومُوا لِرُؤْیَتِہِ وَأَفْطِرُوا لِرُؤْیَتِہِ ، فَإِنْ غُمَّ عَلَیْکُمْ فَأَتموا ثَلاَثِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 9114","","","كتاب الصيام"
"9115","(۹۱۱۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تَصِلُوا رَمَضَانَ بِشَیْئٍ ، وَلاَ تَقَدَّمُوا قَبْلَہُ بِیَوْمٍ ، وَلاَ بِیَوْمَیْنِ۔","","Musannaf Ibn Abi Shaybah 9115","","","كتاب الصيام"
"9116","(۹۱۱۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَکَرَ رَمَضَانَ ، فَقَالَ : صُومُوا لِرُؤْیَتِہِ وَأَفْطِرُوا لِرُؤْیَتِہِ ، فَإِنْ أُغْمِی عَلَیْکُمْ فَاقْدُرُوا لَہُ۔ (مسلم ۵۔ احمد ۲/۱۳)","Sahih","Musannaf Ibn Abi Shaybah 9116","","","كتاب الصيام"
"9117","(۹۱۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ أَبِی الزِّنَادِ ، عَنِ الأَعْرَجِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : ذَکَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْہِلاَلَ ، فَقَالَ : إذَا رَأَیْتُمُوہُ فَصُومُوا ، وَإِذَا رَأَیْتُمُوہُ فَأَفْطِرُوا ، فَإِنْ أُغْمِی عَلَیْکُمْ فَعُدُّوا ثَلاَثِینَ۔ (مسلم ۲۰۔ ابویعلی ۶۲۵۲)","Sahih","Musannaf Ibn Abi Shaybah 9117","","","كتاب الصيام"
"9118","(۹۱۱۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : نُہِیَ أَنْ یُتَعَجَّلَ قَبْلَ رَمَضَانَ بِیَوْمٍ ، أَوْ یَوْمَیْنِ۔","","Musannaf Ibn Abi Shaybah 9118","","","كتاب الصيام"
"9119","(۹۱۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعُمَیْسِ ، عَنِ الْعَلاَئِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ یَعْقُوبَ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا کَانَ النِّصْفُ مِنْ شَعْبَانَ ، فَأَمْسِکُوا حَتَّی یَکُونَ رَمَضَانُ۔ (ترمذی ۷۳۸۔ ابوداؤد ۲۳۳۰)","Sahih","Musannaf Ibn Abi Shaybah 9119","","","كتاب الصيام"
"9120","(۹۱۲۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی الْبَخْتَرِیِّ ، قَالَ : خَرَجْنَا لِلْعُمْرَۃِ ، فَلَمَّا نَزَلْنَا بِبَطْنِ نَخْلَۃَ ، قَالَ : تَرَائَیْنَا الْہِلاَلَ ، قَالَ بَعْضُ الْقَوْمِ : ہُوَ ابْنُ ثَلاَثٍ ، وَقَالَ بَعْضُ الْقَوْمِ : ہُوَ ابْنُ لَیْلَتَیْنِ، فَلَقِینَا ابْنَ عَبَّاسٍ فَقُلْنَا : إنَّا رَأَیْنَا الْہِلاَلَ ، فَقَالَ بَعْضُ الْقَوْمِ : ہُوَ ابْنُ ثَلاَثٍ ، وَقَالَ بَعْضُ الْقَوْمِ : ہُوَ ابْنُ لَیْلَتَیْنِ ، فَقَالَ : أَیُّ لَیْلَۃٍ رَأَیْتُمُوہُ ؟ قَالَ : فَقُلْنَا : لَیْلَۃَ کَذَا وَکَذَا ، فَقَالَ : إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّ اللَّہَ مَدَّہُ لِلرُّؤْیَۃِ ، فَہُوَ لِلَیْلَۃٍ رَأَیْتُمُوہُ۔ (مسلم ۲۹۔ طبرانی ۱۲۶۸۷)","Sahih","Musannaf Ibn Abi Shaybah 9120","","","كتاب الصيام"
"9121","(۹۱۲۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ : سَمِعْتُ أَبَا الْبَخْتَرِیِّ ، قَالَ : أَہْلَلْنَا رَمَضَانَ وَنَحْنُ بِذَاتِ عِرْقٍ ، فَأَرْسَلْنَا رَجُلاً إلَی ابْنِ عَبَّاسٍ یَسْأَلُہُ ؟ فَقَالَ ابْنُ عَبَّاسٍ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إنَّ اللَّہَ قَدْ أَمَدَّہُ لِرُؤْیَتِہِ ، فَإِنْ أُغْمِیَ عَلَیْکُمْ فَأَکْمِلُوا الْعِدَّۃَ۔ (مسلم ۳۰ احمد ۱/۳۲۷)","Sahih","Musannaf Ibn Abi Shaybah 9121","","","كتاب الصيام"
"9122","(۹۱۲۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ أَخْبَرَنَا مُجَالِدٌ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَانَ یَخْطُبُ إذَا حَضَرَ رَمَضَانُ فَیَقُولُ : أَلاَ لاَ تَقَدَّمُوا الشَّہْرَ ، إذَا رَأَیْتُمُ الْہِلاَلَ فَصُومُوا ، وَإِذَا رَأَیْتُمُ الْہِلاَلَ فَأَفْطِرُوا ، فَإِنْ أُغْمِیَ عَلَیْکُمْ فَأَتِمُّوا الْعِدَّۃَ ، قَالَ : کَانَ یَقُولُ ذَلِکَ بَعْدَ صَلاَۃِ الْعَصْرِ ، وَبَعْدَ صَلاَۃِ الْفَجْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 9122","","","كتاب الصيام"
"9123","(۹۱۲۳) حَدَّثَنَا ہُشَیْمٌ ، أَخْبَرَنَا مُجَالِدٌ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، عَنْ عُمَرَ ، مِثْلَ ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 9123","","","كتاب الصيام"
"9124","(۹۱۲۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ قَالاَ : نُہِیَ أَنْ یُتَقَدَّمَ بَیْنَ یَدَیْ رَمَضَانَ بِصَوْمٍ۔","","Musannaf Ibn Abi Shaybah 9124","","","كتاب الصيام"
"9125","(۹۱۲۵) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، وَعَطَائٍ ؛ أَنَّہُمَا کَرِہَا التَّعْجِیلَ قَبْلَ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 9125","","","كتاب الصيام"
"9126","(۹۱۲۶) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی الرَّجُلِ یَصُومُ فَیَحْضُرُ رَمَضَانُ ، قَالَ : یَفْصِلُ بَیْنَہُ وَبَیْنَ رَمَضَانَ بِأَیَّامٍ۔","Da'if","Musannaf Ibn Abi Shaybah 9126","","","كتاب الصيام"
"9127","(۹۱۲۷) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : کَانُوا یَنْظُرُونَ إلَی الْہِلاَلِ فَإنْ رَأَوْہُ صَامُوا، وَإِنْ لَمْ یَرَوْہُ نَظَرُوا مَا یَقُولُ إمَامُہُمْ۔","","Musannaf Ibn Abi Shaybah 9127","","","كتاب الصيام"
"9128","(۹۱۲۸) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أُمِّ سَلَمَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَصِلُ شَعْبَانَ بِرَمَضَانَ۔ (ترمذی ۷۳۶۔ احمد ۶/۳۰۰)","Sahih","Musannaf Ibn Abi Shaybah 9128","","","كتاب الصيام"
"9129","(۹۱۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَقَدَّمُوا رَمَضَانَ بِصَوْمِ یَوْمٍ ، وَلاَ یَوْمَیْنِ إِلاَّ رَجُلٌ کَانَ یَصُومُ صَوْمًا فَلْیَصُمْہُ۔ (مسلم ۲۱۔ ترمذی ۶۸۵)","Sahih","Musannaf Ibn Abi Shaybah 9129","","","كتاب الصيام"
"9130","(۹۱۳۰) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا کَانَ رَجُلٌ یُدِیمُ الصَّوْمَ فَلاَ بَأْسَ أَنْ یَصِلَہُ۔","","Musannaf Ibn Abi Shaybah 9130","","","كتاب الصيام"
"9131","(۹۱۳۱) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَلِیٍّ ، عَنِ ابْنِ عَوْنٍ ؛ أَنَّ مُحَمَّدًا تَسَحَّرَ وَہُوَ یَرَی أَنَّ عَلَیْہِ لَیْلاً ، ثُمَّ اسْتَبَانَ لَہُ أَنَّہُ تَسَحَّرَ بَعْدَ مَا أَصْبَحَ ، فَقَالَ : أَمَّا أَنَا الْیَوْمَ فَمُفْطِرٌ۔","","Musannaf Ibn Abi Shaybah 9131","","","كتاب الصيام"
"9132","(۹۱۳۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ؛ فِیمَنْ تَسَحَّرَ وَہُوَ یَرَی أَنَّ عَلَیْہِ لَیْلاً ، فَبَانَ أَنَّہُ تَسَحَّرَ وَقَدْ طَلَعَ الْفَجْرُ ؟ فَلْیُتِمَّ صِیَامَہُ۔","","Musannaf Ibn Abi Shaybah 9132","","","كتاب الصيام"
"9133","(۹۱۳۳) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ عَنِ الرَّجُلِ یَتَسَحَّرُ وَہُوَ یَرَی أَنَّ عَلَیْہِ لَیْلاً ؟ قَالَ : یُتِمُّ صوَمَہُ۔","","Musannaf Ibn Abi Shaybah 9133","","","كتاب الصيام"
"9134","(۹۱۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حُصَیْنٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : إذَا أَکَلَ بَعْدَ طُلُوعِ الْفَجْرِ مَضَی عَلَی صِیَامِہِ ، وَقَضَی یَوْمًا مَکَانَہُ۔","","Musannaf Ibn Abi Shaybah 9134","","","كتاب الصيام"
"9135","(۹۱۳۵) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ، عَنْ عَمْرٍو، عَنِ الْحَسَنِ؛ فِی رَجُلٍ تَسَحَّرَ وَہُوَ یَرَی أَنَّ عَلَیْہِ لَیْلاً، قَالَ: یُتِمُّ صَوْمَہُ۔","","Musannaf Ibn Abi Shaybah 9135","","","كتاب الصيام"
"9136","(۹۱۳۶) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : یُتِمُّ صَوْمَہُ۔","","Musannaf Ibn Abi Shaybah 9136","","","كتاب الصيام"
"9137","(۹۱۳۷) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ أَکَلَ أَوَّلَ النَّہَارِ فَلْیَأْکُلْ آخِرَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9137","","","كتاب الصيام"
"9138","(۹۱۳۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ جَبَلَۃَ بْنِ سُحَیْمٍ ، عَنْ عَلِیِّ بْنِ حَنْظَلَۃَ ، عَنْ أَبِیہِ ، قَالَ : شَہِدْتُ عُمَرَ بْنَ الْخَطَّابِ فِی رَمَضَانَ ، وَقُرِّبَ إلَیْہِ شَرَابٌ ، فَشَرِبَ بَعْضُ الْقَوْمِ وَہُمْ یَرَوْنَ أَنَّ الشَّمْسَ قَدْ غَرَبَتْ ، ثُمَّ ارْتَقَی الْمُؤَذِّنُ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، وَاللَّہِ لَلشَّمْسُ طَالِعَۃٌ لَمْ تَغْرُبْ ، فَقَالَ عُمَرُ : مَنَعَنَا اللَّہُ مِنْ شَرِّکَ مَرَّتَیْنِ ، أَوْ ثَلاَثَۃً ، یَا ہَؤُلاَئِ ، مَنْ کَانَ أَفْطَرَ فَلْیَصُمْ یَوْمًا مَکَانَ یَوْمٍ ، وَمَنْ لَمْ یَکُنْ أَفْطَرَ فَلْیُتِمَّ حَتَّی تَغْرُبَ الشَّمْسُ۔","Da'if","Musannaf Ibn Abi Shaybah 9138","","","كتاب الصيام"
"9139","(۹۱۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَبَلَۃَ بْنِ سُحَیْمٍ ، عَنْ عَلِیِّ بْنِ حَنْظَلَۃَ ، عَنْ أَبِیہِ ، عَنْ عُمَرَ ، نَحْوِہِ ، إِلاَّ أَنَّ سُفْیَانَ قَالَ : إنَّا لَمْ نَبْعَثکَ رَاعِیًا ، إنَّمَا بَعَثْنَاکَ دَاعِیًا ، وَقَدِ اجْتَہَدْنَا وَقَضَائُ یَوْمٍ یَسِیرٌ۔","Da'if","Musannaf Ibn Abi Shaybah 9139","","","كتاب الصيام"
"9140","(۹۱۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زِیَادِ بْنِ عِلاَقَۃَ ، عَمَّنْ سَمِعَ بِشْرَ بْنَ قَیْسٍ ؛ أَنَّ عُمَرَ رحمہ اللہ أَمَرَہُمْ بِالْقَضَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 9140","","","كتاب الصيام"
"9141","(۹۱۴۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ فَاطِمَۃَ بِنْتِ الْمُنْذِرِ ، عَنْ أَسْمَائَ ؛ أَنَّہُمْ أَفْطَرُوا عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی یَوْمِ غَیْمٍ ، ثُمَّ طَلَعَتِ الشَّمْسُ۔n قَالَ أَبُو أُسَامَۃَ: فَقُلْتُ لِہِشَامٍ : فَأُمِرُوا بِالْقَضَائِ ؟ قَالَ : وَمِنْ ذَلِکَ بُدٌّ ؟ (ابوداؤد ۲۳۵۱۔ احمد ۶/۳۴۶)","Sahih","Musannaf Ibn Abi Shaybah 9141","","","كتاب الصيام"
"9142","(۹۱۴۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْن أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : یَقْضِی ، لأَنَّ اللَّہَ تَعَالَی یَقُولُ : {أَتِمُّوا الصِّیَامَ إلَی اللَّیْلِ}۔","","Musannaf Ibn Abi Shaybah 9142","","","كتاب الصيام"
"9143","(۹۱۴۳) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، حَدَّثَنَا مَنْصُورُ بْنُ أَبِی الأَسْوَد ، عَنِ الأَعْمَشِ ، عَنِ الْمُسَیَّبِ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، عَنْ عُمَرَ ، بِنَحْوٍ مِنْ حَدِیثِ أَبِی مُعَاوِیَۃَ الَّذِی یَأْتِی۔","Hasan","Musannaf Ibn Abi Shaybah 9143","","","كتاب الصيام"
"9144","(۹۱۴۴) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، قَالَ : کَانَ الْحَسَنُ یَقُولُ فِیمَنْ أَفْطَرَ وَہُوَ یَرَی أَنَّ الشَّمْسَ قَدْ غَابَتْ ، ثُمَّ اسْتَبَانَ لَہُ أَنَّہَا لَمْ تَغِبْ ، قَالَ : کَانَ یَقُولُ : أَجْزَأَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 9144","","","كتاب الصيام"
"9145","(۹۱۴۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، قَالَ : أُخْرِجَتْ عِسَاسٌ مِنْ بَیْتِ حَفْصَۃَ وَعَلَی السَّمَائِ سَحَابٌ ، فَظَنُّوا أَنَّ الشَّمْسَ قَدْ غَابَتْ فَأَفْطَرُوا ، فَلَمْ یَلْبَثُوا أَنْ تَجَلَّی السَّحَابُ فَإِذَا الشَّمْسُ طَالِعَۃٌ ، فَقَالَ عُمَرُ : مَا تَجَانَفْنَا مِنْ إِثْمٍ۔","Sahih","Musannaf Ibn Abi Shaybah 9145","","","كتاب الصيام"
"9146","(۹۱۴۶) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ سَعِیدِ بْنِ قَطَنٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ عِنْدَ مُعَاوِیَۃَ فِی رَمَضَانَ فَأَفْطَرُوا ثُمَّ طَلَعَتِ الشَّمْسُ ، فَأَمَرَہُمْ أَنْ یَقْضُوا۔","Da'if","Musannaf Ibn Abi Shaybah 9146","","","كتاب الصيام"
"9147","(۹۱۴۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ: قُلْتُ: أَفْطَرْتُ فِی یَوْمٍ مُغَیِّمٍ فِی شَہْرِ رَمَضَانَ، وَأَنَا أَحْسِبُہُ اللَّیْلَ ، ثُمَّ بَدَتِ الشَّمْسُ ، أَفَأَقْضِی ذَلِکَ الْیَوْمَ قَطُّ ، وَلاَ أُکَفِّرُ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 9147","","","كتاب الصيام"
"9148","(۹۱۴۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، حَدَّثَنَا زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : غَزَوْت مَعَ زِیَادِ بْنِ النَّضْرِ أَرْضَ الرُّومِ ، قَالَ: فَأَہْلَلْنَا رَمَضَانَ فَصَامَ النَّاسُ وَفِیہِمْ أَصْحَابُ عَبْدِ اللہِ ؛ عَامِرِ بْنِ سَعْدٍ ، وَسُمَیْعٌ ، وَأَبُو عَبْدِ اللہِ ، وَأَبُو مَعْمَرٍ ، وَأَبُو مُسَافِعٍ فَأَفْطَرَ النَّاسُ یَوْمًا وَالسَّمَائُ مُتَغَیِّمَۃٌ ، وَنَحْنُ بَیْنَ جَبَلَیْنِ ؛ الْحَارِثِ وَالْحُوَیْرِثِ ، وَلَمْ أُفْطِرْ أَنَا حَتَّی تبدّی اللَّیْل ، ثُمَّ إنَّ الشَّمْسَ خَرَجَتْ فَأَبْصَرْنَاہَا عَلَی الْجَبَلِ ، فَقَالَ زِیَادٌ : أَمَّا ہَذَا الْیَوْمُ فَسَوْفَ نَقْضِیہِ ، وَلَمْ نَتَعَمَّدْ فِطْرَہُ۔","","Musannaf Ibn Abi Shaybah 9148","","","كتاب الصيام"
"9149","(۹۱۴۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن أَخِیہِ ، عَنْ أَبِیہِ ؛ أَفْطَرَ عُمَرُ فِی شَہْرِ رَمَضَانَ فَقِیلَ لَہُ : قَدْ طَلَعَتِ الشَّمْسُ ، فَقَالَ : خَطْبٌ یَسِیرٌ ، قَدْ کُنَّا جَاہِدِینِ۔","Sahih","Musannaf Ibn Abi Shaybah 9149","","","كتاب الصيام"
"9150","(۹۱۵۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، قَالَ : جَائَ رَجُلٌ إلَی ابْنِ عَبَّاسٍ یَسْأَلُہُ عَنِ السُّحُورِ ؟ فَقَالَ لَہُ رَجُلٌ مِنْ جُلَسَائِہِ : کُلْ حَتَّی لاَ تَشُکَّ ، فَقَالَ لَہُ ابْنُ عَبَّاسٍ : إنَّ ہَذَا لاَ یَقُولُ شَیْئًا ، کُلْ مَا شَکَکْت حَتَّی لاَ تَشُکَّ۔","Sahih","Musannaf Ibn Abi Shaybah 9150","","","كتاب الصيام"
"9151","(۹۱۵۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْوَلِیدِ ، قَالَ : حدَّثَنَا عَوْنُ بْنُ عَبْدِ اللہِ ، قَالَ : دَخَلَ رَجُلاَنِ عَلَی أَبِی بَکْرٍ وَہُوَ یَتَسَحَّرُ ، فَقَالَ أَحَدُہُمَا : قَدْ طَلَعَ الْفَجْرُ ، وَقَالَ الآخَرُ : لَمْ یَطْلُعْ بَعْدُ ، قَالَ أَبُو بَکْرٍ : کُلْ قَدِ اخْتَلَفَا۔","","Musannaf Ibn Abi Shaybah 9151","","","كتاب الصيام"
"9152","(۹۱۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ اللہِ بْنِ الْوَلِیدِ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی بَکْرٍ ، بِنَحْوِہِ۔","","Musannaf Ibn Abi Shaybah 9152","","","كتاب الصيام"
"9153","(۹۱۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَارَۃَ بْنِ زَاذَانَ ، عَنْ مَکْحُولٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ أَخَذَ دَلْوًا مِنْ زَمْزَمَ ، فَقَالَ لِرَجُلَیْنِ : أَطَلَعَ الْفَجْرُ ؟ فَقَالَ أَحَدُہُمَا : لاَ ، وَقَالَ الآخَرُ : نَعَمْ ، قَالَ : فَشَرِبَ۔","Hasan","Musannaf Ibn Abi Shaybah 9153","","","كتاب الصيام"
"9154","(۹۱۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کُلْ حَتَّی تَرَاہُ مُعْتَرِضًا۔","","Musannaf Ibn Abi Shaybah 9154","","","كتاب الصيام"
"9155","(۹۱۵۵) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : کُلْ حَتَّی تَرَاہُ مِثْلَ شِقِّ الطَّیْلَسَانِ۔","","Musannaf Ibn Abi Shaybah 9155","","","كتاب الصيام"
"9156","(۹۱۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ لِغُلاَمَیْنِ لَہُ ، وَہُوَ فِی دَارِ أُمِّ ہَانِیئٍ فِی شَہْرِ رَمَضَانَ وَہُوَ یَتَسَحَّرُ ، فَقَالَ أَحَدُہُمَا : قَدْ طَلَعَ الْفَجْرُ ، وَقَالَ الآخَرُ : لَمْ یَطْلُعْ ، قَالَ : اِسْقِیَانِی۔","Da'if","Musannaf Ibn Abi Shaybah 9156","","","كتاب الصيام"
"9157","(۹۱۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَر ، قَالَ : کُلْ حَتَّی یَتَبَیَّنَ لَکَ الْفَجْرُ۔","","Musannaf Ibn Abi Shaybah 9157","","","كتاب الصيام"
"9158","(۹۱۵۸) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ یَزِیدَ بْنِ زَیْدٍ ، قَالَ : سَمِعْتُ الْحَسَنَ وَقَالَ لَہُ رَجُلٌ : أَتَسَحَّرُ وَأَمْتَرِی فِی الصُّبْحِ ؟ فَقَالَ : کُلْ مَا امْتَرَیْت ، إِنَّہُ وَاللَّہِ لَیْسَ بِالصُّبْحِ خَفَائٌ۔","","Musannaf Ibn Abi Shaybah 9158","","","كتاب الصيام"
"9159","(۹۱۵۹) حَدَّثَنَا وَکِیعٌ ، عَنِ الْفَضْلِ بْنِ دَلْہَمٍ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ عُمَرُ : إذَا شَکَّ الرَّجُلاَنِ فِی الْفَجْرِ ، فَلْیَأْکُلاَ حَتَّی یَسْتَیْقِنَا۔","Da'if","Musannaf Ibn Abi Shaybah 9159","","","كتاب الصيام"
"9160","(۹۱۶۰) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنِ الأَعْمَشِ، عَنْ مُسْلِمِ بْنِ صُبَیْحٍ، قَالَ: جَائَ رَجُلٌ إلَی ابْنِ عَبَّاسٍ، فَقَالَ: مَتَی أَدَعُ السُّحُورَ ؟ فَقَالَ رَجُلٌ جَالِسٌ عِنْدَہُ : کُلْ حَتَّی إذَا شَکَکْت فَدَعْہُ ، فَقَالَ : کُلْ مَا شَکَکْت حَتَّی لاَ تَشُکَّ۔","Sahih","Musannaf Ibn Abi Shaybah 9160","","","كتاب الصيام"
"9161","(۹۱۶۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنِ ابْنِ عَوْنٍ، قَالَ: قَالَ مُحَمَّدٌ: وَضَعْتُ الإِنَائَ عَلَی یَدَیَّ، فَجَعَلْتُ أَنْظُرُ ہَلْ طَلَعَ الْفَجْرُ؟","","Musannaf Ibn Abi Shaybah 9161","","","كتاب الصيام"
"9162","(۹۱۶۲) حَدَّثَنَا مُلاَزِمُ بْنُ عَمْرٍو ، عَنْ عَبْدِ اللہِ بْنِ النُّعْمَانِ ، عَنْ قَیْسِ بْنِ طَلْقٍ ، قَالَ : حدَّثَنَا أَبِی طَلْقُ بْنُ عَلِیٍّ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : کُلُوا وَاشْرَبُوا ، وَلاَ یَہِیدَنَّکُمُ السَّاطِعُ الْمُصْعِدُ ، کُلُوا وَاشْرَبُوا حَتَّی یَعْتَرِضَ لَکُمُ الأَحْمَرُ ، وَقَالَ ہَکَذَا بِیَدِہِ۔ (ترمذی ۷۰۵۔ ابوداؤد ۲۳۴۰)","Hasan","Musannaf Ibn Abi Shaybah 9162","","","كتاب الصيام"
"9163","(۹۱۶۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی ہِلاَلٍ ، قَالَ : حدَّثَنَا سَوَادَۃُ بْنُ حَنْظَلَۃَ الْہِلاَلِیُّ ، عَنْ سَمُرَۃََ بْنِ جُنْدُبٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَمْنَعَنَّکُمْ أَذَانُ بِلاَلٍ مِنَ السُّحُورِ ، وَلاَ الصُّبْحُ الْمُسْتَطِیلُ ، وَلَکِنِ الصُّبْحُ الْمُسْتَطِیرُ فِی الأُفُقِ۔","Hasan","Musannaf Ibn Abi Shaybah 9163","","","كتاب الصيام"
"9164","(۹۱۶۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ خَالہ ، عَنْ ثَوْبَانَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْفَجْرُ فَجْرَانِ ؛ فَأَمَّا الَّذِی کَأَنَّہُ ذَنَبُ السِّرْحَانِ ، فَإِنَّہُ لاَ یُحِلُّ شَیْئًا ، وَلاَ یُحَرِّمُہُ ، وَلَکِنِ الْمُسْتَطِیرُ۔ (دار قطنی ۲۔ بیہقی ۲۱۵)","","Musannaf Ibn Abi Shaybah 9164","","","كتاب الصيام"
"9165","(۹۱۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ ثَابِتِ بْنِ عُمَارَۃَ ، عَنْ غُنَیْمِ بْنِ قَیْسٍ ، عَنْ أَبِی مُوسَی ، قَالَ : لَیْسَ الْفَجْرُ الَّذِی ہَکَذَا ، یَعْنِی الْمُسْتَطِیلَ ، وَلَکِنِ الْفَجْرُ الَّذِی ہَکَذَا ، یَعْنِی الْمُعْتَرِضَ۔","Hasan","Musannaf Ibn Abi Shaybah 9165","","","كتاب الصيام"
"9166","(۹۱۶۶) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَوْشَبِ بْنِ عَقِیلٍ ، عَنْ جَعْفَرِ بْنِ نَہَارٍ ، قَالَ : سَأَلْتُ الْقَاسِمَ : أَہُوَ السَّاطِعُ ، أَمِ الْمُعْتَرِضُ ؟ قَالَ : الْمُعْتَرِضُ ، وَالسَّاطِعُ : الصُّبْحُ الْکَاذِبُ۔","","Musannaf Ibn Abi Shaybah 9166","","","كتاب الصيام"
"9167","(۹۱۶۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عِمْرَانَ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : السَّاطِعُ ذَلِکَ الصُّبْحُ الْکَاذِبُ ، وَلَکِنْ إذَا انْفَضَحَ الصُّبْحُ فِی الأُفُقِ۔","","Musannaf Ibn Abi Shaybah 9167","","","كتاب الصيام"
"9168","(۹۱۶۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، قَالَ : لَمْ یَکُونُوا یَعُدُّونَ الْفَجْرَ فَجْرَکُمْ ہَذَا ، إِنَّمَا کَانُوا یَعُدُّونَ الْفَجْرَ الَّذِی یَمْلأُ الْبُیُوتَ وَالطُّرُقَ۔","","Musannaf Ibn Abi Shaybah 9168","","","كتاب الصيام"
"9169","(۹۱۶۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، قَالَ : اخْتَلَفْنَا فِی الْفَجْرِ فَأَتَیْنَا إبْرَاہِیمَ ، فَقَالَ : الْفَجْرُ فَجْرَانِ ؛ فَأَمَّا أَحَدُہُمَا فَالْفَجْرُ السَّاطِعُ فَلاَ یُحِلُّ الصَّلاَۃَ وَلاَ یُحَرِّمُ الطَّعَامَ ، وَأَمَّا الْفَجْرُ الْمُعْتَرِضُ الأَحْمَر ، فَإِنَّہُ یُحِلُّ الصَّلاَۃَ وَیُحَرِّمُ الطَّعَامَ وَالشَّرَابَ۔","","Musannaf Ibn Abi Shaybah 9169","","","كتاب الصيام"
"9170","(۹۱۷۰) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ جَابِرٍ، عَنْ عَامِرٍ، وَعَطَائٍ قَالاَ: الْفَجْرُ الْمُعْتَرِضُ الَّذِی إلَی جَنْبِہِ حُمْرَۃٌ۔","","Musannaf Ibn Abi Shaybah 9170","","","كتاب الصيام"
"9171","(۹۱۷۱) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : سَأَلْتُ الزُّہْرِیَّ وَمَیْمُونًا ، فَقُلْتُ : أُرِیدُ الصَّوْمَ ، فَأَرَی عَمُودَ الصُّبْحِ السَّاطِعِ ؟ فَقَالاَ جَمِیعًا : کُلْ وَاشْرَبْ حَتَّی تَرَاہُ فِی أُفُقِ السَّمَائِ مُعْتَرِضًا۔","","Musannaf Ibn Abi Shaybah 9171","","","كتاب الصيام"
"9172","(۹۱۷۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَدِیِّ بْنِ حَاتِمٍ ، قَالَ : لَمَّا نَزَلَتْ : {حَتَّی یَتَبَیَّنَ لَکُمُ الْخَیْطُ الأَبْیَضُ مِنَ الْخَیْطِ الأَسْوَد} ، قَالَ : قَالَ عَدِیٌّ : یَا رَسُولَ اللہِ ، إنِّی أَجْعَلُ تَحْتَ وِسَادَتِی عِقَالَیْنِ؛ عِقَالاً أَسْوَدَ وَعِقَالاً أَبْیَضَ ، فَأَعْرِفُ اللَّیْلَ مِنَ النَّہَارِ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ وِسَادَک لَطَوِیلٌ عَرِیضٌ ، إنَّمَا ہُوَ سَوَادُ اللَّیْلِ وَبَیَاضُ النَّہَارِ۔ (بخاری ۱۹۱۶۔ ابوداؤد ۲۳۴۱)","Sahih","Musannaf Ibn Abi Shaybah 9172","","","كتاب الصيام"
"9173","(۹۱۷۳) حَدَّثَنَا مُعْتَمِرُ بْنُ إسْمَاعِیلَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الصَّائِمُ بِالْخِیَارِ ، مَا بَیْنَہُ وَبَیْنَ نِصْفِ النَّہَارِ۔","Da'if","Musannaf Ibn Abi Shaybah 9173","","","كتاب الصيام"
"9174","(۹۱۷۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنِ ابْنِ عُمَرَ قَالَ : الصَّائِمُ بِالْخِیَارِ مَا بَیْنَہُ وَبَیْنَ نِصْفِ النَّہَارِ۔","Sahih","Musannaf Ibn Abi Shaybah 9174","","","كتاب الصيام"
"9175","(۹۱۷۵) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : مَنْ حَدَّثَ نَفْسَہُ بِالصِّیَامِ فَہُوَ بِالْخِیَارِ ، مَا لَمْ یَتَکَلَّمْ حَتَّی یَمْتَدَّ النَّہَارُ۔","Sahih","Musannaf Ibn Abi Shaybah 9175","","","كتاب الصيام"
"9176","(۹۱۷۶) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا أَصْبَحْت وَأَنْتَ تُرِیدُ الصَّوْمَ فَأَنْتَ بِالْخِیَارِ ، إِنْ شِئْتَ صُمْت وَإِنْ شِئْتَ أَفْطَرْت ، إِلاَّ أَنْ تَفْرِضَ عَلَی نَفْسِکَ الصَّوْمَ مِنَ اللَّیْلِ۔","Da'if","Musannaf Ibn Abi Shaybah 9176","","","كتاب الصيام"
"9177","(۹۱۷۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنْ أَبِی الأَحْوَصِ ، قَالَ : قَالَ عَبْدُ اللہِ : أَحَدُکُمْ بأَحَد النَّظَرَیْنِ مَا لَمْ یَأْکُلْ ، أَوْ یَشْرَبْ۔","Sahih","Musannaf Ibn Abi Shaybah 9177","","","كتاب الصيام"
"9178","(۹۱۷۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : قُلْتُ لإبْرَاہِیمَ : الرَّجُلُ فِی صِیَامِ التَّطَوُّعِ بِالْخِیَارِ مَا بَیْنَہُ وَبَیْنَ نِصْفِ النَّہَارِ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 9178","","","كتاب الصيام"
"9179","(۹۱۷۹) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : الصَّائِمُ بِالْخِیَارِ مَا بَیْنَہُ وَبَیْنَ نِصْفِ النَّہَارِ ، فَإِذَا جَاوَزَ ذَلِکَ فَإِنَّمَا لَہُ بِقَدْرِ مَا بَقِیَ مِنَ النَّہَارِ۔","","Musannaf Ibn Abi Shaybah 9179","","","كتاب الصيام"
"9180","(۹۱۸۰) حَدَّثَنَا مُعْتَمِرٌ، عَنْ یُونُسَ، عَنِ الْحَسَنِ، فِی الصَّوْمِ؛ یُتَخَیَّرُ مَا لَمْ یُصْبِحْ صَائِمًا، فَإِذَا أَصْبَحَ صَائِمًا صَامَ۔","","Musannaf Ibn Abi Shaybah 9180","","","كتاب الصيام"
"9181","(۹۱۸۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی مَالِکٍ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : الرَّجُلُ بِالْخِیَارِ مَا لَمْ یَطْعَمْ إلَی نِصْفِ النَّہَارِ ، فَإِنْ بَدَا لَہُ أَنْ یَطْعَمَ طَعِمَ ، وَإِنْ بَدَا لَہُ أَنْ یَجْعَلَہُ صَوْمًا کَانَ صَائِمًا۔","Sahih","Musannaf Ibn Abi Shaybah 9181","","","كتاب الصيام"
"9182","(۹۱۸۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ؛ فِی الرَّجُلِ یُرِیدُ الصَّوْمَ ؟ قَالَ : ہُوَ بِالْخِیَارِ إلَی نِصْفِ النَّہَارِ۔","","Musannaf Ibn Abi Shaybah 9182","","","كتاب الصيام"
"9183","(۹۱۸۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا تَسَحَّرَ الرَّجُلُ فَقَدْ وَجَبَ عَلَیْہِ الصَّوْمُ ، فَإِنْ أَفْطَرَ فَعَلَیْہِ الْقَضَائُ ، وَإِنْ ہَمَّ بِالصَّوْمِ فَہُوَ بِالْخِیَارِ ، إِنْ شَائَ صَامَ ، وَإِنْ شَائَ أَفْطَرَ ، وَإِنْ سَأَلَہُ إنْسَانٌ ، فَقَالَ: أَنْتَ صَائِمٌ ؟ فَقَالَ : نَعَمْ ، فَقَدْ وَجَبَ عَلَیْہِ الصَّوْمُ إِلاَّ أَنْ یَقُولَ إِنْ شَائَ اللَّہُ ، فَإِنْ قَالَ فَہُوَ بِالْخِیَارِ ، إِنْ شَائَ صَامَ ، وَإِنْ شَائَ أَفْطَرَ۔","","Musannaf Ibn Abi Shaybah 9183","","","كتاب الصيام"
"9184","(۹۱۸۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ طَلْحَۃَ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ؛ أَنَّ حُذَیْفَۃَ بَدَا لَہُ فِی الصَّوْمِ بَعْدَ مَا زَالَتِ الشَّمْسُ فَصَامَ۔","Sahih","Musannaf Ibn Abi Shaybah 9184","","","كتاب الصيام"
"9185","(۹۱۸۵) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ خُصَیْفٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّ عَائِشَۃَ وَحَفْصَۃَ أَصْبَحَتَا صَائِمَتَیْنِ فَأَفْطَرَتَا، فَأَمَرَہُمَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِقَضَائِہِ۔","Munkar","Musannaf Ibn Abi Shaybah 9185","","","كتاب الصيام"
"9186","(۹۱۸۶) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن عُثْمَانَ البَتِّی ، عَنْ أَنَسِ بْنِ سِیرِینَ؛ أَنَّہُ صَامَ یَوْمَ عَرَفَۃَ فَعَطِشَ عَطَشًا شَدِیدًا فَأَفْطَرَ ، فَسَأَلَ عِدَّۃً مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَأَمَرُوہُ أَنْ یَقْضِیَ یَوْمًا مَکَانَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9186","","","كتاب الصيام"
"9187","(۹۱۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ حَبِیبٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یَقْضِی یَوْمًا مَکَانَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9187","","","كتاب الصيام"
"9188","(۹۱۸۸) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بن جَابِرٍ ، قَالَ : سَأَلْتُ مَکْحُولاً عَنْ رَجُلٍ أَصْبَحَ صَائِمًا ، عَزَمَتْ عَلَیْہِ أُمُّہُ أَنْ یُفْطِرَ ؟ قَالَ : کَأَنَّہُ کَرِہَ ذَلِکَ ، وَقَالَ : یَقْضِی یَوْمًا مَکَانَہُ۔","","Musannaf Ibn Abi Shaybah 9188","","","كتاب الصيام"
"9189","(۹۱۸۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا تَسَحَّرَ الرَّجُلُ فَقَدْ وَجَبَ عَلَیْہِ الصَّوْمُ ، فَإِنْ أَفْطَرَ فَعَلَیْہِ الْقَضَائُ۔","","Musannaf Ibn Abi Shaybah 9189","","","كتاب الصيام"
"9190","(۹۱۹۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، عَنْ عَطَائٍ وَمُجَاہِدٍ ؛ أَنَّہُمَا کَانَا إذَا زَارَا رَجُلاً وَ دُعِیَا إلَی طَعَامٍ ، وَہُمَا صَائِمَانِ ، إِنْ سَأَلَہُمَا أَنْ یُفْطِرَا أَفْطَرَا ، کَانَا یَقُولاَنِ : نَقْضِی یَوْمًا مَکَانَہُ۔","","Musannaf Ibn Abi Shaybah 9190","","","كتاب الصيام"
"9191","(۹۱۹۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سِمَاکٍ ، عَن ابن أُمِّ ہَانِیئٍ ، عَن أُمِّ ہَانِیئٍ قَالَتْ : کُنْت قَاعِدَۃً عِنْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَأُتِیَ بِشَرَابٍ فَشَرِبَ مِنْہُ ، ثُمَّ نَاوَلَنِیہِ فَشَرِبْت قَالَتْ : فَقُلْتُ : یَا رَسُولَ اللہِ ، قَدْ أَذْنَبْت فَاسْتَغْفِرْ لِی ، قَالَ : وَمَا ذَاکَ ؟ قَالَتْ : کُنْت صَائِمَۃً فَأَفْطَرْت ، قَالَ : أَمِنْ قَضَائٍ کُنْت تَقْضِینَہُ ؟ قَالَتْ : لاَ ، قَالَ : لاَ یَضُرُّک۔ (ترمذی ۷۳۱۔ احمد ۶/۳۴۳)","Da'if","Musannaf Ibn Abi Shaybah 9191","","","كتاب الصيام"
"9192","(۹۱۹۲) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَنْ سِمَاکٍ، عَنْ عِکْرِمَۃَ، قَالَ: کَانَ ابْنُ عَبَّاسٍ یُفْطِرُ مِنْ صَوْمِ التَّطَوُّعِ، وَلاَ یُبَالِی۔","","Musannaf Ibn Abi Shaybah 9192","","","كتاب الصيام"
"9193","(۹۱۹۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ یُوسُفَ بْنِ مَاہَکَ الْمَکِّیِّ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ وَطِیئَ جَارِیَۃً لَہُ وَہُوَ صَائِمٌ ، قَالَ : فَقِیلَ لَہُ : وَطِئْتہَا وَأَنْتَ صَائِمٌ ؟ قَالَ : ہِیَ جَارِیَتِی أَعْجَبَتْنِی ، وَإِنَّمَا ہُوَ تَطَوُّعٌ۔","","Musannaf Ibn Abi Shaybah 9193","","","كتاب الصيام"
"9194","(۹۱۹۴) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ مُجَالِدٍ، عَنِ الشَّعْبِیِّ، قَالَ: کَانَ لاَ یَرَی بَأْسًا أَنْ یُصْبِحَ الرَّجُلُ صَائِمًا، ثُمَّ یُفْطِرَ۔","","Musannaf Ibn Abi Shaybah 9194","","","كتاب الصيام"
"9195","(۹۱۹۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ اللہِ ، عَنْ مُجَاہِدٍ ، عَنْ عَائِشَۃَ قَالَتْ : رُبَّمَا أُہْدِیَتْ لَنَا الطَّرْفَۃُ ، فَنَقُولُ : لَوْلاَ صَوْمُک قَرَّبْنَاہَا إلَیْکَ ، فَیَدْعُو بِہَا فَنُفْطِرُ عَلَیْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 9195","","","كتاب الصيام"
"9196","(۹۱۹۶) حَدَّثَنَا عَبِیْدَۃُ ، عَنْ أَبِی مِسْکِینٍ ، قَالَ : کَانَ إبْرَاہِیمُ وَسَعِیدُ بْنُ جُبَیْرٍ فِی دَعْوَۃٍ ، فَقَالَ سَعِیدٌ : إنِّی کُنْت حَدَّثَتْنِی نَفْسِی بِالصَّوْمِ ، ثُمَّ أَکل ۔ وَقَالَ إبْرَاہِیمُ : مَا یُعْجِبُنِی۔","","Musannaf Ibn Abi Shaybah 9196","","","كتاب الصيام"
"9197","(۹۱۹۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَیَانٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَصْبَحَ وَہُوَ صَائِمٌ فَلاَ یُفْطِرُ۔","","Musannaf Ibn Abi Shaybah 9197","","","كتاب الصيام"
"9198","(۹۱۹۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ اللہِ ، عَنْ مُجَاہِدٍ ، عَنْ عَائِشَۃَ قَالَتْ : رُبَّمَا دَعَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِغَدَائِہِ فَلاَ یَجِدُہُ ، فَیَفْرِضُ عَلَیْہِ صَوْمَ ذَلِکَ الْیَوْمَ۔","Da'if","Musannaf Ibn Abi Shaybah 9198","","","كتاب الصيام"
"9199","(۹۱۹۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ أُمِّ الدَّرْدَائِ ، عَنْ أَبِی الدَّرْدَائِ ؛ أَنَّہُ کَانَ رُبَّمَا دَعَا بِالْغَدَائِ فَلاَ یَجِدُہُ ، فَیَفْرِضُ الصَّوْمَ عَلَیْہِ ذَلِکَ الْیَوْمَ۔","Da'if","Musannaf Ibn Abi Shaybah 9199","","","كتاب الصيام"
"9200","(۹۲۰۰) حَدَّثَنَا الثَّقَفِیُّ ، وَیَزِیدُ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ؛ أَنَّ أَبَا طَلْحَۃَ کَانَ یَأْتِی أَہْلَہُ فَیَقُولُ : ہَلْ عِنْدَکُمْ مِنْ غَدَائٍ ؟ فَإِنْ قَالُوا لاَ ، قَالَ : فَإِنِّی صَائِمٌ ۔ زَادَ الثَّقَفِیُّ : إِنْ کَانَ عِنْدَہُمْ أَفْطَرَ۔","Sahih","Musannaf Ibn Abi Shaybah 9200","","","كتاب الصيام"
"9201","(۹۲۰۱) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، عَنِ الْعَلاَئِ بْنِ الْحَارِثِ ، عَنْ مُعَاذٍ ؛ أَنَّہُ کَانَ یَأْتِی أَہْلَہُ بَعْدَ الزَّوَالِ فَیَقُولُ : عِنْدَکُمْ غَدَائٌ ؟ فَیَعْتَذِرُونَ إلَیْہِ ، فَیَقُولُ : إنِّی صَائِمٌ بَقِیَّۃَ یَوْمِی ، فَیُقَالُ لَہُ : تَصُومُ آخِرَ النَّہَارِ! فَیَقُولُ : مَنْ لَمْ یَصُمْ آخِرَہُ ، لَمْ یَصُمْ أَوَّلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9201","","","كتاب الصيام"
"9202","(۹۲۰۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أُمِّ الدَّرْدَائِ قَالَتْ : کَانَ أَبُو الدَّرْدَائِ یَغْدُو أَحْیَانًا، فَیَجِیئُ فَیَسْأَلُ الْغَدَائَ ، فَرُبَّمَا لَمْ یُوَافِقْہُ عِنْدَنَا ، فَیَقُولُ : إنِّی إذًا صَائِمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 9202","","","كتاب الصيام"
"9203","(۹۲۰۳) حَدَّثَنَا الْفَضْلُ ، عَنْ أَبِی قَحْذَمٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الأَشْعَثِ ، قَالَ : کَانَ مُعَاذٌ یَأْتِی أَہْلَہُ بَعْدَ مَا یُضْحی فَیَسْأَلُہُمْ فَیَقُولُ : عِنْدَکُمْ شَیْئٌ ؟ فَإِذَا قَالُوا لاَ ، صَامَ ذَلِکَ الْیَوْمَ۔","Da'if","Musannaf Ibn Abi Shaybah 9203","","","كتاب الصيام"
"9204","(۹۲۰۴) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ إِسْحَاقَ بْنِ حَازِمٍ ، قَالَ : حدَّثَنِی عَبْدُ اللہِ بْنُ أَبِی بَکْرِ بْنِ عَمْرِو بْنِ حَزْمٍ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، عَنْ حَفْصَۃَ قَالَتْ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ صِیَامَ لِمَنْ لَمْ یُوَرِّضْہُ بِاللَّیْلِ۔ (ترمذی ۷۳۰۔ ابوداؤد ۲۴۴۶)","Hasan","Musannaf Ibn Abi Shaybah 9204","","","كتاب الصيام"
"9205","(۹۲۰۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ حَمْزَۃَ بْنِ عَبْدِ اللہِ بْنِ عُمَرَ ، عَنْ حَفْصَۃَ ، أَنَّہَا قَالَتْ : لاَ صِیَامَ لِمَنْ لَمْ یُجْمِعِ الصِّیَامَ قَبْلَ الْفَجْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 9205","","","كتاب الصيام"
"9206","(۹۲۰۶) حَدَّثَنَا یَحْیَی بْنُ سُلَیْمٍ الطَّائِفِیُّ ، عَنْ مُوسَی بْنِ عُقْبَۃَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، قَالَ : بَلَغَنِی أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سُئِلَ عَنْ تَقْطِیعِ قَضَائِ رَمَضَانَ ؟ فَقَالَ : ذَاکَ إلَیْک ، فَقَالَ : أَرَأَیْت لَوْ کَانَ عَلَی أَحَدِکُمْ دَیْنٌ ، فَقَضَی الدِّرْہَمَ وَالدِّرْہَمَیْنِ ، أَلَمْ یَکُ قَضَی ؟ وَاللَّہُ أَحَقّ أَنْ یَعْفُوَ وَیَغْفِرَ۔ (دارقطنی ۷۷)","","Musannaf Ibn Abi Shaybah 9206","","","كتاب الصيام"
"9207","(۹۲۰۷) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، وَأَبِی ہُرَیْرَۃَ قَالاَ : لاَ بَأْسَ بِقَضَائِ رَمَضَانَ مُتَفَرِّقًا۔","","Musannaf Ibn Abi Shaybah 9207","","","كتاب الصيام"
"9208","(۹۲۰۸) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ، عَنْ أَبِیہِ، قَالَ: أَنْبَأَنِی بَکْرٌ ، عَنْ أَنَسٍ ، قَالَ : إِنْ شِئْتَ فَاقْضِ رَمَضَانَ مُتَتَابِعًا، وَإِنْ شِئْتَ مُتَفَرِّقًا۔","Sahih","Musannaf Ibn Abi Shaybah 9208","","","كتاب الصيام"
"9209","(۹۲۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ عَطَائٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ؛ فِی قَضَائِ رَمَضَانَ ، قَالَ : إِنْ شَائَ فَرَّقَ۔","","Musannaf Ibn Abi Shaybah 9209","","","كتاب الصيام"
"9210","(۹۲۱۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنِ ابْنِ مُحَیْرِیزٍ ، أَنَّہُ قَالَ فِی قَضَائِ رَمَضَانَ ، قَالَ : أَحْصِ الْعِدَّۃَ ، وَصُمْ کَیْفَ شِئْت۔","","Musannaf Ibn Abi Shaybah 9210","","","كتاب الصيام"
"9211","(۹۲۱۱) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، عَنْ مُوسَی بْنِ یَزِیدَ بْنِ مَوْہَبٍ ، عَنْ أَبِیہِ ، عَنْ مَالِکِ بْنِ یُخَامِرَ ، عَنْ مُعَاذِ بْنِ جَبَلٍ ؛ أَنَّہُ سُئِلَ عَنْ قَضَائِ رَمَضَانَ ؟ فَقَالَ : أَحْصِ الْعِدَّۃَ ، وَصُمْ کَیْفَ شِئْت۔","Da'if","Musannaf Ibn Abi Shaybah 9211","","","كتاب الصيام"
"9212","(۹۲۱۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ رَافِعِ بْنِ خَدِیجٍ ، عَنْ جَدَّتِہِ ، أَنَّ رَافِعًا کَانَ یَقُولُ : أَحْصِ الْعِدَّۃَ وَصُمْ کَیْفَ شِئْت۔","Da'if","Musannaf Ibn Abi Shaybah 9212","","","كتاب الصيام"
"9213","(۹۲۱۳) حَدَّثَنَا مُعَمَّرُ بْنُ سُلَیْمَانَ الرَّقِّیُّ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : جَائَتِ امْرَأَۃٌ إلَی ابْنِ عَبَّاسٍ تسْأَلُہُ عَنْ قَضَائِ صِیَامِ رَمَضَانَ ؟ فَقَالَ : أَحْصِی الْعِدَّۃَ وَفَرِّقِی ، قَالَ : وَکَانَ سَعِیدُ بْنُ جُبَیْرٍ وَعِکْرِمَۃُ یَقُولاَنِ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 9213","","","كتاب الصيام"
"9214","(۹۲۱۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَمُجَاہِدٍ ، وَطَاوُسٍ ، وَسَعِیدِ بْنِ جُبَیْرٍ قَالُوا : إِنْ شِئْتَ فَاقْضِ رَمَضَانَ مُتَتَابِعًا ، أَوْ مُتَفَرِّقًا۔","","Musannaf Ibn Abi Shaybah 9214","","","كتاب الصيام"
"9215","(۹۲۱۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، وَعَطَائٍ ، وَمُجَاہِدٍ ، وَطَاوُسٍ ؛ أَنَّہُمْ کَانُوا لاَ یَرَوْنَ بَأْسًا بِتَفْرِیقِ قَضَائِ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 9215","","","كتاب الصيام"
"9216","(۹۲۱۶) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مُجَاہِدٍ ؛ فِی الرَّجُلِ یَکُونُ عَلَیْہِ صَوْمٌ مِنْ رَمَضَانَ ، فَیُفَرِّقُ صِیَامَہُ ، أَوْ یَصِلُہُ ، قَالَ : إنَّ اللَّہَ أَرَادَ بِعِبَادِہِ الْیُسْرَ ، فَلْیَنْظُرْ أَیْسَرَ ذَلِکَ عَلَیْہِ ، إِنْ شَائَ وَصَلَہُ ، وَإِنْ شَائَ فَرَّقَ۔","","Musannaf Ibn Abi Shaybah 9216","","","كتاب الصيام"
"9217","(۹۲۱۷) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ زُہَیْرٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ زُہَیْرٍ مِنْ أَصْحَابِ أَبِی مَیْسَرَۃَ ؛ أَنَّ أَبَا مَیْسَرَۃَ کَانَ یُقَطِّعُ قَضَائَ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 9217","","","كتاب الصيام"
"9218","(۹۲۱۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِنْ شَقَّ عَلَیْک أَنْ تَقْضِیَ مُتَتَابِعًا ، فَرِّقْ فَإنَّمَا ہِیَ عِدَّۃٌ مِنْ أَیَّامٍ أُخَرَ۔","","Musannaf Ibn Abi Shaybah 9218","","","كتاب الصيام"
"9219","(۹۲۱۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنْ عِکْرِمَۃَ ؛ {فَعِدَّۃٌ مِنْ أَیَّامٍ أُخَرَ} ، قَالَ : إِنْ شَائَ وَصَلَ ، وَإِنْ شَائَ فَرَّقَ۔","","Musannaf Ibn Abi Shaybah 9219","","","كتاب الصيام"
"9220","(۹۲۲۰) حَدَّثَنَا یَحْیَی بْنُ عَبْدِ الْمَلِکِ بْنِ أَبِی غَنِیَّۃ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، قَالَ : کَانَ لاَ یَرَی بِقَضَائِ رَمَضَانَ مُتَقَطِّعًا بَأْسًا۔","","Musannaf Ibn Abi Shaybah 9220","","","كتاب الصيام"
"9221","(۹۲۲۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ؛ فِی قَضَائِ رَمَضَانَ ، إِنْ شِئْتَ مُتَتَابِعًا ، وَإِنْ شِئْتَ مُتَفَرِّقًا۔","","Musannaf Ibn Abi Shaybah 9221","","","كتاب الصيام"
"9222","(۹۲۲۲) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ مَیْمُونٍ ، قَالَ : قَضَائُ رَمَضَانَ عِدَّۃٌ مِنْ أَیَّامٍ أُخَرَ۔","","Musannaf Ibn Abi Shaybah 9222","","","كتاب الصيام"
"9223","(۹۲۲۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إسْمَاعِیلَ الْمَکِّیِّ ، عَنْ رَبِیعَۃَ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، قَالَ : لاَ بَأْسَ أَنْ یُفرّق قَضَاء رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 9223","","","كتاب الصيام"
"9224","(۹۲۲۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی قَضَائِ رَمَضَانَ ، صُمْہُ کَیْفَ شِئْت ، وَقَالَ ابْنُ عُمَرَ : صُمْہُ کَمَا أَفْطَرْتہ۔","Sahih","Musannaf Ibn Abi Shaybah 9224","","","كتاب الصيام"
"9225","(۹۲۲۵) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ، حَدَّثَنِی مُعَاوِیَۃُ بْنُ صَالِحٍ، حَدَّثَنَا أَزْہَرُ بْنُ سَعِیدٍ، عَنْ أَبِی عَامِرٍ الْہَوْزَنِیِّ، قَالَ: سَمِعْتُ أَبَا عُبَیْدَۃَ بْنَ الْجَرَّاحِ ، وَسُئِلَ عَنْ قَضَائِ رَمَضَانَ مُتَفَرِّقًا ؟ قَالَ : أَحْصِ الْعِدَّۃَ ، وَصُمْ کَیْفَ شِئْت۔","Hasan","Musannaf Ibn Abi Shaybah 9225","","","كتاب الصيام"
"9226","(۹۲۲۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ فِی قَضَائِ رَمَضَانَ : یُتَابِعُ بَیْنَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9226","","","كتاب الصيام"
"9227","(۹۲۲۷) حَدَّثَنَا حَفْصٌ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَأْمُرُ بِقَضَائِ رَمَضَانَ مُتَتَابِعًا۔","Sahih","Musannaf Ibn Abi Shaybah 9227","","","كتاب الصيام"
"9228","(۹۲۲۸) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ، قَالَ: مَنْ کَانَ عَلَیْہِ صَوْمٌ مِنْ رَمَضَانَ، فَلْیَصُمْہُ مُتَّصِلاً ، وَلاَ یُفَرِّقْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 9228","","","كتاب الصيام"
"9229","(۹۲۲۹) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : یُواتِر قَضَاء رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 9229","","","كتاب الصيام"
"9230","(۹۲۳۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، أَنَّہُ قَالَ : لاَ یَقْطَعُہُ إذَا کَانَ صَحِیحًا۔","","Musannaf Ibn Abi Shaybah 9230","","","كتاب الصيام"
"9231","(۹۲۳۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَقُولُونَ : قَضَاء رَمَضَانَ تِبَاعًا۔","","Musannaf Ibn Abi Shaybah 9231","","","كتاب الصيام"
"9232","(۹۲۳۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : یَقْضِیہ کَہَیْئَتِہِ۔","","Musannaf Ibn Abi Shaybah 9232","","","كتاب الصيام"
"9233","(۹۲۳۳) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ الْحَسَنُ یُحِبُّ أَنْ یُتَابَعَ بَیْنَ قَضَائِ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 9233","","","كتاب الصيام"
"9234","(۹۲۳۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَحَبُّ إلَیَّ أَنْ یَقْضِیَہُ کَمَا أَفْطَرَہُ۔","","Musannaf Ibn Abi Shaybah 9234","","","كتاب الصيام"
"9235","(۹۲۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ فِی قَضَائِ رَمَضَانَ : أَحَبَّ إلَیَّ أَنْ یَصُومَہُ کَمَا أَفْطَرَہُ۔","","Musannaf Ibn Abi Shaybah 9235","","","كتاب الصيام"
"9236","(۹۲۳۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَلِیِّ بْنِ الْحَکَمِ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ عُقْبَۃَ بْنِ الْحَارِثِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : یُوَاتِرُہُ إِنْ شَائَ۔","Sahih","Musannaf Ibn Abi Shaybah 9236","","","كتاب الصيام"
"9237","(۹۲۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : سَأَلْتُہُ عَنْ قَضَائِ رَمَضَانَ ؟ قَالَ : مُتَتَابِعٌ أَحَبَّ إلَیَّ۔","","Musannaf Ibn Abi Shaybah 9237","","","كتاب الصيام"
"9238","(۹۲۳۸) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، قَالَ : صُمْہُ مُتَتَابِعًا إِلاَّ أَنْ یُقْطَعَ بِکَ کَمَا قَطَعَ بِکَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 9238","","","كتاب الصيام"
"9239","(۹۲۳۹) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ عَطَائٍ ، قَالَ : یَقْضِیہ مُتَتَابِعًا أَحَبَّ إلَیَّ، وَإِنْ فَرَّقَ أَجْزَأَہُ۔","","Musannaf Ibn Abi Shaybah 9239","","","كتاب الصيام"
"9240","(۹۲۴۰) حَدَّثَنَا شَرِیکٌ ، عَنْ عَاصِمٍ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرِ بْنِ رَبِیعَۃَ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْتَاکُ وَہُوَ صَائِمٌ۔ (ابوداؤد ۲۳۵۶۔ دارقطنی ۲)","Da'if","Musannaf Ibn Abi Shaybah 9240","","","كتاب الصيام"
"9241","(۹۲۴۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ لَمْ یَکُنْ یَرَی بَأْسًا بِالسِّوَاکِ لِلصَّائِمِ۔","Sahih","Musannaf Ibn Abi Shaybah 9241","","","كتاب الصيام"
"9242","(۹۲۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، وَسُفْیَانَ ، عَنْ أَبِی نَہِیکٍ ، عَنْ زِیَادِ بْنِ حُدَیْرٍ ، قَالَ : مَا رَأَیْت أَحَدًا أَدْوَمَ سِوَاکًا وَہُوَ صَائِمٌ مِنْ عُمَرَ بْنِ الْخَطَّابِ۔","Sahih","Musannaf Ibn Abi Shaybah 9242","","","كتاب الصيام"
"9243","(۹۲۴۳) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ أَبِی نَہِیکٍ ، عَنْ زِیَادِ بْنِ حُدَیْرٍ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ رَضِیَ اللَّہُ عَنْہُ ، بِنَحْوِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 9243","","","كتاب الصيام"
"9244","(۹۲۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شَدَّادِ أَبِی طَلْحَۃَ ، عَنِ امْرَأَۃٍ مِنْہُمْ یُقَالُ لَہَا : کَبْشَۃُ قَالَتْ : جِئْت إلَی عَائِشَۃَ فَسَأَلْت عَنِ السِّوَاکِ لِلصَّائِمِ ؟ قَالَتْ : ہَذَا سِوَاکِی فِی یَدِی وَأَنَا صَائِمَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 9244","","","كتاب الصيام"
"9245","(۹۲۴۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ عَبْدِ الْجَلِیلِ ، قَالَ : حدَّثَنِی شَہْرُ بْنُ حَوْشَبٍ ، قَالَ : سُئِلَ ابْنُ عَبَّاسٍ عَنِ السِّوَاکِ لِلصَّائِمِ ؟ فَقَالَ : نِعْمَ الطَّہُورُ ، اسْتَکْ عَلَی کُلِّ حَالٍ۔","","Musannaf Ibn Abi Shaybah 9245","","","كتاب الصيام"
"9246","(۹۲۴۶) حَدَّثَنَا ابْنُ الْمُبَارَک ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَسْتَاکُ مَرَّتَیْنِ ، غَدْوَۃً وَعَشِیَّۃً وَہُوَ صَائِمٌ۔","","Musannaf Ibn Abi Shaybah 9246","","","كتاب الصيام"
"9247","(۹۲۴۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ خُصَیْفٍ ، عَنْ عَطَائٍ ، قَالَ : اسْتَکْ أَوَّلَ النَّہَارِ ، وَلاَ تَسْتَکْ آخِرَہُ إذَا کُنْتَ صَائِمًا ، قُلْتُ : لِمَ لاَ أَسْتَاکُ فِی آخِرِ النَّہَارِ ؟ قَالَ : إنَّ خُلُوفَ الصَّائِمِ أَطْیَبُ عِنْدَ اللہِ مِنْ رِیحِ الْمِسْکِ۔","","Musannaf Ibn Abi Shaybah 9247","","","كتاب الصيام"
"9248","(۹۲۴۸) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یَسْتَاکُ مِنْ أَوَّلِ النَّہَارِ ، وَیَکْرَہہُ مِنْ آخِرِہِ۔","","Musannaf Ibn Abi Shaybah 9248","","","كتاب الصيام"
"9249","(۹۲۴۹) حَدَّثَنَا حَفْصٌ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَسْتَاکُ إذَا أَرَادَ أَنْ یَدفع إلَی الظُّہْرِ وَہُوَ صَائِمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 9249","","","كتاب الصيام"
"9250","(۹۲۵۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِالسِّوَاکِ لِلصَّائِمِ۔","","Musannaf Ibn Abi Shaybah 9250","","","كتاب الصيام"
"9251","(۹۲۵۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حُصَیْنٍ ، عَنْ سَالِمٍ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالسِّوَاکِ لِلصَّائِمِ ، إِلاَّ عِنْدَ اصْفِرَارِ الشَّمْسِ۔","","Musannaf Ibn Abi Shaybah 9251","","","كتاب الصيام"
"9252","(۹۲۵۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَرِہَ السِّوَاکَ لِلصَّائِمِ بَعْدَ الظُّہْرِ۔","","Musannaf Ibn Abi Shaybah 9252","","","كتاب الصيام"
"9253","(۹۲۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : یَسْتَاکُ الصَّائِمُ أَیَّ النَّہَارِ شَائَ۔","","Musannaf Ibn Abi Shaybah 9253","","","كتاب الصيام"
"9254","(۹۲۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ بَشِیرٍ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّہُ سُئِلَ عَنِ السِّوَاکِ لِلصَّائِمِ ، فَقَالَ: أدْمَیْت فَمِی الْیَوْمَ مَرَّتَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 9254","","","كتاب الصيام"
"9255","(۹۲۵۵) حَدَّثَنَا ابْنُ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالسِّوَاکِ لِلصَّائِمِ مِنْ أَوَّلِ النَّہَارِ ، وَقَالَ : إنَّمَا کُرِہَ لَہُ آخِرَ النَّہَارِ ، بَعْدَ مَا یَخلف فُوہُ یستحب أَنْ یَرْجِعَ فِی جَوْفِہِ۔","","Musannaf Ibn Abi Shaybah 9255","","","كتاب الصيام"
"9256","(۹۲۵۶) حَدَّثَنَا بِشْرُ بْنُ الْمُفَضَّلِ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، قَالَ : سُئِلَ سَعِیدُ بْنُ الْمُسَیَّبِ عَنِ السِّوَاکِ لِلصَّائِمِ؟ فَقَالَ: لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 9256","","","كتاب الصيام"
"9257","(۹۲۵۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، وَوَکِیعٍ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ، عَنْ أَبِیہِ؛ أَنَّہُ کَانَ یَسْتَاکُ بِالسِّوَاکِ الرَّطْبِ وَہُوَ صَائِمٌ۔","","Musannaf Ibn Abi Shaybah 9257","","","كتاب الصيام"
"9258","(۹۲۵۸) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ بَأْسَ بِالسِّوَاکِ الرَّطْبِ لِلصَّائِمِ۔","","Musannaf Ibn Abi Shaybah 9258","","","كتاب الصيام"
"9259","(۹۲۵۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ بَأْسَ بِالسِّوَاکِ الرَّطْبِ لِلصَّائِمِ۔","","Musannaf Ibn Abi Shaybah 9259","","","كتاب الصيام"
"9260","(۹۲۶۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالسِّوَاکِ الرَّطْبِ وَہُوَ صَائِمٌ۔","","Musannaf Ibn Abi Shaybah 9260","","","كتاب الصيام"
"9261","(۹۲۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِالسِّوَاکِ الرَّطْبِ لِلصَّائِمِ۔","","Musannaf Ibn Abi Shaybah 9261","","","كتاب الصيام"
"9262","(۹۲۶۲) حَدَّثَنَا عُبَیْدُ بْنُ سَہْلٍ الْغُدَّانِیُّ ، عَنْ عُقْبَۃَ بْنِ أَبِی جَسْرۃ الْمَازِنِیِّ ، قَالَ : أَتَی ابْنَ سِیرِینَ رَجُلٌ ، فَقَالَ: مَا تَرَی فِی السِّوَاکِ لِلصَّائِمِ؟ قَالَ: لاَ بَأْسَ بِہِ، قَالَ: إِنَّہُ جَرِیدَۃٌ وَلَہُ طَعْمٌ، قَالَ: وَالْمَائُ لَہُ طَعْمٌ وَأَنْتَ تَمَضْمَضُ۔","","Musannaf Ibn Abi Shaybah 9262","","","كتاب الصيام"
"9263","(۹۲۶۳) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ؟ قَالَ : لاَ بَأْسَ أَنْ یَسْتَاکَ بِالْعُودِ الرَّطْبِ وَہُوَ صَائِمٌ۔","","Musannaf Ibn Abi Shaybah 9263","","","كتاب الصيام"
"9264","(۹۲۶۴) حَدَّثَنَا عَلِیُّ بْنُ الْحَسَنِ بْنِ شَقِیقٍ ، أَخْبَرَنَا أَبُو حَمْزَۃَ ، عَنْ إبْرَاہِیمَ الصَّائِغِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ بَأْسَ أَنْ یَسْتَاکَ الصَّائِمُ بِالسِّوَاکِ الرَّطْبِ وَالْیَابِسِ۔","Hasan","Musannaf Ibn Abi Shaybah 9264","","","كتاب الصيام"
"9265","(۹۲۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سَلَمَۃَ ، عَنِ الضَّحَّاکِ ؛ أَنَّہُ کَرِہَہُ وَقَالَ : ہُوَ حُلْوٌ وَمُرٌّ۔","","Musannaf Ibn Abi Shaybah 9265","","","كتاب الصيام"
"9266","(۹۲۶۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ خَالِدٍ الْحَذَّائِ ، عَنِ الْحَکَمِ ؛ أَنَّہُ کَرِہَ السِّوَاکَ الرَّطْبَ لِلصَّائِمِ۔","","Musannaf Ibn Abi Shaybah 9266","","","كتاب الصيام"
"9267","(۹۲۶۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، وَابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ، عَنْ أَبِی مَیْسَرَۃَ؛ أَنَّہُ کَرِہَ السِّوَاکَ الرَّطْبَ لِلصَّائِمِ۔","","Musannaf Ibn Abi Shaybah 9267","","","كتاب الصيام"
"9268","(۹۲۶۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : إِنْ کَانَ یَابِسًا فَبُلَّہُ۔","","Musannaf Ibn Abi Shaybah 9268","","","كتاب الصيام"
"9269","(۹۲۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : یَسْتَاکُ ، وَلاَ یَبُلُّہُ۔","","Musannaf Ibn Abi Shaybah 9269","","","كتاب الصيام"
"9270","(۹۲۷۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ رَخَّصَ فِی مَضْغِ الْعِلْکِ لِلصَّائِمِ ، مَا لَمْ یدخل حَلْقَہُ۔","","Musannaf Ibn Abi Shaybah 9270","","","كتاب الصيام"
"9271","(۹۲۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ بَأْسَ بِالْعِلْکِ لِلصَّائِمِ مَا لَمْ یَبْلَعْ رِیقَہُ۔","","Musannaf Ibn Abi Shaybah 9271","","","كتاب الصيام"
"9272","(۹۲۷۲) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَتْ عَائِشَۃُ لاَ تَرَی بَأْسًا فِی مَضْغِ الْعِلْکِ لِلصَّائِمِ ، إِلاَّ الْقَارَ ، وَکَانَتْ تُرَخِّصُ فِی الْقَارِ وَحْدَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 9272","","","كتاب الصيام"
"9273","(۹۲۷۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیِّ ، عَنْ زَائِدَۃَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یَمْضُغَ الصَّائِمُ الْعِلْکَ ، وَلاَ یَبْلَعُ رِیقَہُ۔","","Musannaf Ibn Abi Shaybah 9273","","","كتاب الصيام"
"9274","(۹۲۷۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَرِہَہ لِلصَّائِمِ۔","","Musannaf Ibn Abi Shaybah 9274","","","كتاب الصيام"
"9275","(۹۲۷۵) حَدَّثَنَا حُمَیْدٌ بْنُ عَبْدِالرَّحْمَنِ، عَنْ حَسَنٍ، عَنْ عِیسَی، عَنِ الشَّعْبِیِّ؛ أَنَّہُ کَرِہَ لِلصَّائِمِ أَنْ یَمْضُغَ الْعلکَ۔","","Musannaf Ibn Abi Shaybah 9275","","","كتاب الصيام"
"9276","(۹۲۷۶) حَدَّثَنَا أَبُو خَالِد الأَحْمَرِِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَرِہَہُ ، وَقَالَ : ہُوَ مَرْوَاۃٌ۔","","Musannaf Ibn Abi Shaybah 9276","","","كتاب الصيام"
"9277","(۹۲۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ أبِی عَبْدِ الْمَلِکِ ، رَجُلٌ مِنْ أَہْلِ الشَّامِ ، عَنْ رَجُلٍ قَدْ سَمَّاہُ ، عَنْ أَبِیہِ ، عَنْ أُمِّ حَبِیبَۃَ زَوْجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہَا کَرِہَتْ مَضْغَ الْعلکِ لِلصَّائِمِ۔","Da'if","Musannaf Ibn Abi Shaybah 9277","","","كتاب الصيام"
"9278","(۹۲۷۸) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا ذَرَعَہُ الْقَیْئُ فَلَیْسَ عَلَیْہِ الْقَضَائُ ، وَإِذَا اسْتَقَائَ فَعَلَیْہِ الْقَضَائُ۔","Da'if","Musannaf Ibn Abi Shaybah 9278","","","كتاب الصيام"
"9279","(۹۲۷۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ : مَنْ ذَرَعَہُ الْقَیْئُ وَہُوَ صَائِمٌ فَلاَ یُفْطِرْ ، وَمَنْ تَقَیَّأَ فَقَدْ أَفْطَرَ۔","Sahih","Musannaf Ibn Abi Shaybah 9279","","","كتاب الصيام"
"9280","(۹۲۸۰) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ ، عَنْ جَدِّہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا اسْتَقَائَ الصَّائِمُ أَعَادَ۔ (ابوداؤد ۲۳۷۲۔ احمد ۲/۴۹۸)","Da'if","Musannaf Ibn Abi Shaybah 9280","","","كتاب الصيام"
"9281","(۹۲۸۱) حَدَّثَنَا أَزْہَرُ السَّمَّانُ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ قَالاَ : إذَا ذرَعَ الصَّائِمَ الْقَیْئُ فَلاَ یُفْطِرُ، وَإِذَا تَقَیَّأَ أَفْطَرَ۔","","Musannaf Ibn Abi Shaybah 9281","","","كتاب الصيام"
"9282","(۹۲۸۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الصَّائِمِ یَقِیئُ ، قَالَ : إِنْ کَانَ اسْتَقَائَ فَعَلَیْہِ أَنْ یَقْضِیَ ، وَإِنْ کَانَ ذَرَعَہُ فَلَیْسَ عَلَیْہِ أَنْ یَقْضِیَ۔","","Musannaf Ibn Abi Shaybah 9282","","","كتاب الصيام"
"9283","(۹۲۸۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا ذَرَعَہُ الْقَیْئُ فَلاَ إعَادَۃَ عَلَیْہِ ، وَإِنْ تَہَوَّعَ فَعَلَیْہِ الإِعَادَۃُ۔","","Musannaf Ibn Abi Shaybah 9283","","","كتاب الصيام"
"9284","(۹۲۸۴) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَبَّانَ السُّلَمِیِّ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، قَالَ: الصَّائِمُ إذَا ذَرَعَہُ الْقَیْئُ فَلَیْسَ عَلَیْہِ الْقَضَائُ ، وَإِنْ قَائَ مُتَعَمِّدًا فَعَلَیْہِ الْقَضَائُ۔","","Musannaf Ibn Abi Shaybah 9284","","","كتاب الصيام"
"9285","(۹۲۸۵) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَید ، عَنْ یَعْقُوبَ بْنِ قَیْسٍ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنِ الرَّجُلِ یَسْبِقُہُ الْقَیْئُ وَہُوَ صَائِمٌ ، أَیَقْضِی ذَلِکَ الْیَوْمَ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 9285","","","كتاب الصيام"
"9286","(۹۲۸۶) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُطَرِّفٍ ، عَنْ عَامِرٍ ؛ إذَا تَقَیَّأَ مُتَعَمِّدًا فَقَدْ أَفْطَرَ۔","","Musannaf Ibn Abi Shaybah 9286","","","كتاب الصيام"
"9287","(۹۲۸۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرِ ، عَنْ طَلْحَۃَ ، عَنِ الضَّحَّاکِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا تَقَیَّأَ الصَّائِمُ فَقَدْ أَفْطَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 9287","","","كتاب الصيام"
"9288","(۹۲۸۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : إذَا تَقَیَّأَ الرَّجُلُ وَہُوَ صَائِمٌ فَعَلَیْہِ الْقَضَائُ ، وَإِنْ ذَرَعَہُ الْقَیْئُ فَلَیْسَ عَلَیْہِ الْقَضَائُ۔","","Musannaf Ibn Abi Shaybah 9288","","","كتاب الصيام"
"9289","(۹۲۸۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا تَقَیَّأَ الصَّائِمُ مُتَعَمِّدًا أَفْطَرَ ، وَإِذَا ذَرَعَہُ الْقَیْئُ فَلاَ شَیْئَ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 9289","","","كتاب الصيام"
"9290","(۹۲۹۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 9290","","","كتاب الصيام"
"9291","(۹۲۹۱) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی الْجَوْدِیِّ ، عَنْ بَلْجٍ الْمَہْرِیِّ ، عَنْ أَبِی شَیْبَۃَ الْمَہْرِیِّ ، قَالَ : قِیلَ لِثَوْبَانَ : حَدِّثْنَا عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَائَ فَأَفْطَرَ۔ (احمد ۲۸۳۔ طحاوی ۹۶)","Da'if","Musannaf Ibn Abi Shaybah 9291","","","كتاب الصيام"
"9292","(۹۲۹۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ یعیش بْنِ الْوَلِیدِ بْنِ ہِشَامٍ، أَنَّ مَعْدَانَ أَخْبَرَہُ ، أَنَّ أَبَا الدَّرْدَائِ أَخْبَرَہُ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَائَ فَأَفْطَرَ ، قَالَ : فَلَقِیتُ ثَوْبَانَ ، فَقَالَ : أَنَا صَبَبْت لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَضُوئَہُ۔ (ترمذی ۸۷۔ ابوداؤد ۲۳۷۳)","Sahih","Musannaf Ibn Abi Shaybah 9292","","","كتاب الصيام"
"9293","(۹۲۹۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : الإِفْطَارُ مِمَّا دَخَلَ ، وَلَیْسَ مِمَّا خَرَجَ۔","","Musannaf Ibn Abi Shaybah 9293","","","كتاب الصيام"
"9294","(۹۲۹۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُطَرِّفٍ ، قَالَ : سُئِلَ عَامِرٌ عَنِ الصَّائِمِ یَقِیئُ ؟ قَالَ : إذَا فَجَأَہُ الْقَیْئُ فَلاَ یَقْضِی ، وَإِنْ کَانَ تَقَیَّأَ عَمْدًا فَقَدْ أَفْطَرَ۔","","Musannaf Ibn Abi Shaybah 9294","","","كتاب الصيام"
"9295","(۹۲۹۵) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، قَالَ : قَالَ أَبُو ہُرَیْرَۃَ : إذَا أَفْطَرَ الصَّائِمُ فَتَمَضْمَضَ ، فَلاَ یَمُجَّہُ ، وَلَکِنْ یَستَرطُہ۔","Sahih","Musannaf Ibn Abi Shaybah 9295","","","كتاب الصيام"
"9296","(۹۲۹۶) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ عَن ذَلِکَ ؟ فَقَالَ : لاَ بَأْسَ بِہِ أَنْ یَمُجَّہُ۔","","Musannaf Ibn Abi Shaybah 9296","","","كتاب الصيام"
"9297","(۹۲۹۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنْ عَطَائٍ ، قَالَ : قَالَ عُمَرُ رضی اللَّہُ عَنْہُ : لاَ تَزَالُ ہَذِہِ الأُمَّۃُ بِخَیْرٍ مَا عَجَّلُوا الْفِطْرَ ، فَإِذَا کَانَ یَوْمُ صَوْمِ أَحَدِکُمْ فَمَضْمَضَ فَلاَ یَمُجَّہُ ، وَلَکِنْ لِیَشْرَبْہُ ، فَإِنَّ خَیْرَہُ أَوَّلُہُ۔","","Musannaf Ibn Abi Shaybah 9297","","","كتاب الصيام"
"9298","(۹۲۹۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یُمَضْمضَ عِنْدَ الإِفْطَارِ۔","","Musannaf Ibn Abi Shaybah 9298","","","كتاب الصيام"
"9299","(۹۲۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ بَأْسَ بِالْمَضْمَضَۃِ عِنْدَ الإِفْطَارِ۔","","Musannaf Ibn Abi Shaybah 9299","","","كتاب الصيام"
"9300","(۹۳۰۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یُمَضْمضَ الرَّجُلُ إذَا أَفْطَرَ ، إذَا أَرَادَ أَنْ یَشْرَبَ۔","","Musannaf Ibn Abi Shaybah 9300","","","كتاب الصيام"
"9301","(۹۳۰۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ؛ أَنَّہُ سُئِلَ عَنِ الصَّائِمِ یُمَضْمِضَ ؟ فَکَرِہَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 9301","","","كتاب الصيام"
"9302","(۹۳۰۲) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ مَالِکِ بْنِ مِغْوَلٍ، عَنْ أَبِی إِسْحَاقَ، عَنِ الشعبی؛ أَنَّہُ کَرِہَ لِلصَّائِمِ أَنْ یُمَضْمِضَ۔","","Musannaf Ibn Abi Shaybah 9302","","","كتاب الصيام"
"9303","(۹۳۰۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی عُثْمَانَ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ وَہُوَ صَائِمٌ یَبُلُّ الثَّوْبَ ، ثُمَّ یُلْقِیہِ عَلَیْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 9303","","","كتاب الصيام"
"9304","(۹۳۰۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُکْرَہُ لِلصَّائِمِ أَنْ یَنْضَحَ فِرَاشَہُ بِالْمَائِ ، ثُمَّ یَنَامَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 9304","","","كتاب الصيام"
"9305","(۹۳۰۵) حَدَّثَنَا أَزْہَرُ السَّمَّانُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ ابْنُ سِیرِینَ لاَ یَرَی بَأْسًا أَنْ یَبُلَّ الثَّوْبَ ، ثُمَّ یُلْقِیَہُ عَلَی وَجْہِہِ۔","","Musannaf Ibn Abi Shaybah 9305","","","كتاب الصيام"
"9306","(۹۳۰۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُثْمَانَ بْنِ أَبِی الْعَاصِ ؛ أَنَّہُ کَانَ یَصُبُّ عَلَیْہِ الْمَائَ ، وَیُرَوِّحُ عَنْہُ وَہُوَ صَائِمٌ عَشِیَّۃَ عَرَفَۃَ ، أَوْ یَوْمَ عَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 9306","","","كتاب الصيام"
"9307","(۹۳۰۷) حَدَّثَنَا حَفْصٌ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ : رَأَیْتُ عَبْدَ الرَّحْمَن بْنَ الأَسْوَد یَنْقَعُ رِجْلَیْہِ فِی الْمَائِ وَہُوَ صَائِمٌ۔","","Musannaf Ibn Abi Shaybah 9307","","","كتاب الصيام"
"9308","(۹۳۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ سُمَیٍّ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ ، عَنْ رَجُلٍ رَأَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَصُبُّ عَلَی رَأْسِہِ الْمَائَ وَہُوَ صَائِمٌ ، فِی یَوْمٍ صَائِفٍ۔ (ابوداؤد ۲۳۵۷۔ احمد ۳/۴۳)","Sahih","Musannaf Ibn Abi Shaybah 9308","","","كتاب الصيام"
"9309","(۹۳۰۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُکْرَہُ لِلصَّائِمِ أَنْ یَبُلَّ ثَوْبَہُ بِالْمَائِ ، ثُمَّ یَلْبَسَہُ۔","","Musannaf Ibn Abi Shaybah 9309","","","كتاب الصيام"
"9310","(۹۳۱۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمْ یَصُمِ الْعَشْرَ قَطُّ۔","","Musannaf Ibn Abi Shaybah 9310","","","كتاب الصيام"
"9311","(۹۳۱۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَد ، عَنْ عَائِشَۃَ قَالَتْ : مَا رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَامَ الْعَشْرَ قَطُّ۔ (مسلم ۱۰۔ ابوداؤد ۲۴۳۱)","Sahih","Musannaf Ibn Abi Shaybah 9311","","","كتاب الصيام"
"9312","(۹۳۱۲) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یَصُومُ الْعَشْرَ ، عَشْرَ ذِی الْحِجَّۃِ کُلِّہِ ، فَإِذَا مَضَی الْعَشْرُ وَمَضَتْ أَیَّامُ التَّشْرِیقِ ، أَفْطَرَ تِسْعَۃَ أَیَّامٍ مِثْلَ مَا صَامَ۔","","Musannaf Ibn Abi Shaybah 9312","","","كتاب الصيام"
"9313","(۹۳۱۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ لَیْثٍ ، قَالَ : کَانَ مُجَاہِدٌ یَصُومُ الْعَشْرَ ، قَالَ : وَکَانَ عَطَائٌ یَتَکَلَّفُہَا۔","Hasan","Musannaf Ibn Abi Shaybah 9313","","","كتاب الصيام"
"9314","(۹۳۱۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنِ النُّعْمَانِ بْنِ سَعْدٍ ، قَالَ : أَتَی عَلِیًّا رَجُلٌ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، أَخْبِرْنِی بِشَہْرٍ أَصُومُہُ بَعْدَ رَمَضَانَ ، فَقَالَ : لَقَدْ سَأَلْتنِی عَنْ شَیْئٍ مَا سَمِعْت أَحَدًا یَسْأَلُ عَنْہُ، بَعْدَ رَجُلٍ سَمِعْتُہُ یَسْأَلُ عَنْہُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ لَہُ : إِنْ کُنْت صَائِمًا شَہْرًا بَعْدَ رَمَضَانَ فَصُمِ الْمُحَرَّمَ ، فَإِنَّہُ شَہْرُ اللہِ ، وَفِیہِ یَوْمٌ تَابَ فِیہِ قَوْمٌ ، وَیُتَابُ فِیہِ عَلَی آخَرِینَ۔ (ترمذی ۷۴۱۔ دارمی ۱۷۵۶)","Da'if","Musannaf Ibn Abi Shaybah 9314","","","كتاب الصيام"
"9315","(۹۳۱۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَصُومُ أَشْہُرَ الْحُرُمِ۔","","Musannaf Ibn Abi Shaybah 9315","","","كتاب الصيام"
"9316","(۹۳۱۶) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ خَالِدِ بْنِ أَبِی عُثْمَانَ ، عَنْ أَیُّوبَ ، عَنْ عَبْدِ اللہِ بْنِ یَسَارٍ ، وَسَلِیطٍ أَخِیہِ قَالاَ : کَانَ ابْنُ عُمَرَ بِمَکَّۃَ یَصُومُ أَشْہُرَ الْحُرُمِ۔","Da'if","Musannaf Ibn Abi Shaybah 9316","","","كتاب الصيام"
"9317","(۹۳۱۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ الْحِمْیَرِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : جَائَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، أَیُّ الصِّیَامِ أَفْضَلُ بَعْدَ رَمَضَانَ ؟ فَقَالَ : شَہْرُ اللہِ الَّذِی تَدْعُونَہُ الْمُحَرَّمَ۔ (مسلم ۲۰۳۔ ابوداؤد ۲۴۲۱)","Hasan","Musannaf Ibn Abi Shaybah 9317","","","كتاب الصيام"
"9318","(۹۳۱۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِیہِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَصُومُ الاِثْنَیْن وَالْخَمِیسَ۔","","Musannaf Ibn Abi Shaybah 9318","","","كتاب الصيام"
"9319","(۹۳۱۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَنِ الْمُسَیَّبِ ، عَنْ حَفْصَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَصُومُ الاِثْنَیْن وَالْخَمِیس۔ (ابوداؤد ۲۴۴۳۔ احمد ۶/۲۸۷)","","Musannaf Ibn Abi Shaybah 9319","","","كتاب الصيام"
"9320","(۹۳۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سُلَیْمَانَ الْعَبْسِیِّ ، عَنْ مُجَاہِدٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَصُومُ الاِثْنَیْن وَالْخَمِیسَ۔","","Musannaf Ibn Abi Shaybah 9320","","","كتاب الصيام"
"9321","(۹۳۲۱) حَدَّثَنَا عُثْمَانُ بْنُ مَطَر ، عَنْ ثَابِتٍ الْبُنَانِیِّ ، عَنْ أَبِی عُقْبَۃَ ، قَالَ: کَانَ أَبُو ہُرَیْرَۃَ یَصُومُ الاِثْنَیْن وَالْخَمِیسَ۔","Da'if","Musannaf Ibn Abi Shaybah 9321","","","كتاب الصيام"
"9322","(۹۳۲۲) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ أَنَّہُ کَانَ یَصُومُ الاِثْنَیْن وَالْخَمِیسَ۔","","Musannaf Ibn Abi Shaybah 9322","","","كتاب الصيام"
"9323","(۹۳۲۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : سَأَلْتُہُ عَنْ صَوْمِ الاِثْنَیْنِ وَالْخَمِیسِ ؟ فَقَالَ : لاَ أَعْلَمُ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 9323","","","كتاب الصيام"
"9324","(۹۳۲۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَانَ یَصُومُ الاِثْنَیْنِ وَالْخَمِیسَ۔","","Musannaf Ibn Abi Shaybah 9324","","","كتاب الصيام"
"9325","(۹۳۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عََنِ الحَکَمِ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَانَ یَصُومُ الاِثْنَیْنِ وَالْخَمِیسَ، ثُمَّ کَرِہَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 9325","","","كتاب الصيام"
"9326","(۹۳۲۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عُمَرَ بْنِ الْحَکَمِ بْنِ ثَوْبَانَ ، أَنَّ مَوْلَی قُدَامَۃَ حَدَّثَہُ : أَنَّ مَوْلَی أُسَامَۃَ حَدَّثَہُ : أَنَّ أُسَامَۃَ کَانَ یَخْرُجُ إلَی مَالٍ لَہُ بِوَادِی الْقُرَی ، فَیَصُومُ الاِثْنَیْنِ وَالْخَمِیسَ ، فَقُلْتُ لَہُ : لِمَ تَصُومُ الاِثْنَیْنِ وَالْخَمِیسَ وَأَنْتَ شَیْخٌ کَبِیرٌ ؟ فَقَالَ : رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَصُومُہُمَا ، فَقُلْتُ لَہُ : لِمَ تَصُومُ الاِثْنَیْنِ وَالْخَمِیسَ ؟ فَقَالَ : إنَّہُمَا یَوْمَانِ تُعْرَضُ فِیہِمَا الأَعْمَالُ۔ (ابوداؤد ۲۴۲۸۔ احمد ۵/۲۰۰)","Da'if","Musannaf Ibn Abi Shaybah 9326","","","كتاب الصيام"
"9327","(۹۳۲۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ إبْرَاہِیمَ قَالَ : کَانَ أُسَامَۃُ بْنُ زَیْدٍ یَصُومُ أَیَّامًا مِنَ الْجُمُعَۃِ ، یُتَابِعُ بَیْنَہُنَّ ، فَقِیلَ لَہُ : أَیْنَ أَنْتَ مِنَ الاِثْنَیْنِ وَالْخَمِیسِ ؟ قَالَ : فَکَانَ یَصُومُہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 9327","","","كتاب الصيام"
"9328","(۹۳۲۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ، عَنْ قَیْسٍ، عَنْ عَاصِمٍ، عَنْ زِرٍّ، عَنْ عَبْدِاللہِ؛ أَنَّہُ کَانَ یَصُومُ الاِثْنَیْنِ وَالْخَمِیسَ۔","Da'if","Musannaf Ibn Abi Shaybah 9328","","","كتاب الصيام"
"9329","(۹۳۲۹) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، وَیَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ سُئِلَ عَنْ صَوْمِ یَوْمِ الاِثْنَیْنِ وَالْخَمِیسِ ؟ فَقَالَ : یُکْرَہُ أَنْ یُوَقِّتَ یَوْمًا یَصُومُہُ ۔ إِلاَّ أَنَّ یَزیدَ قَالَ : یَنْصِبُ یَوْمًا إذَا جَائَ ذَلِکَ الْیَوْمُ صَامَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9329","","","كتاب الصيام"
"9330","(۹۳۳۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ؛ أَنَّ عَلِیًّا کَانَ یَصُومُ الاِثْنَیْنِ وَالْخَمِیسَ۔","","Musannaf Ibn Abi Shaybah 9330","","","كتاب الصيام"
"9331","(۹۳۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سُلَیْمَانَ الْعَبْسِیِّ ، عَنْ مُجَاہِدٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَصُومُ الاِثْنَیْنِ وَالْخَمِیسَ۔","","Musannaf Ibn Abi Shaybah 9331","","","كتاب الصيام"
"9332","(۹۳۳۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَصُم أَحَدُکُمْ یَوْمَ الْجُمُعَۃِ إِلاَّ أَنْ یَصُومَ قَبْلَہُ ، أَوْ یَصُومَ بَعْدَہُ۔ (مسلم ۱۴۸۔ ابوداؤد ۲۴۱۲)","Sahih","Musannaf Ibn Abi Shaybah 9332","","","كتاب الصيام"
"9333","(۹۳۳۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : دَخَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی جُوَیْرِیَۃَ بِنْتِ الْحَارِثِ یَوْمَ الْجُمُعَۃِ وَہِیَ صَائِمَۃٌ ، قَالَ : فَقَالَ : صُمْت أَمْسِ ؟ قَالَتْ : لاَ ، قَالَ : تُرِیدِینَ أَنْ تَصُومِی غَدًا ؟ قَالَتْ : لاَ ، قَالَ : فَأَفْطِرِی إذًا۔ (احمد ۲/۱۸۹۔ ابن حبان ۳۶۱۱)","Sahih","Musannaf Ibn Abi Shaybah 9333","","","كتاب الصيام"
"9334","(۹۳۳۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ مَرْثَدِ بْنِ عَبْدِ اللہِ الْیَزَنِیِّ ، عَنْ حُذَیْفَۃَ الأَزْدِیِّ ، عَنْ جُنَادَۃَ الأَزْدِیِّ ؛ دَخَلْتُ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَبْعَۃِ نَفَرٍ مِنَ الأَزْدِ ، أَنَا ثَامِنُہُمْ یَوْمَ الْجُمُعَۃِ وَنَحْنُ صِیَامٌ ، فَدَعَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی طَعَامٍ بَیْنَ یَدَیْہِ فَقُلْنَا : إنَّا صِیَامٌ ، قَالَ : ہَلْ صُمْتُمْ أَمْسِ ؟ قُلْنَا : لاَ ، قَالَ : فَہَلْ تَصُومُونَ غَدًا ؟ قُلْنَا : لاَ ، قَالَ : فَأَفْطِرُوا ، ثُمَّ خَرَجَ إلَی الْجُمُعَۃِ ، فَلَمَّا جَلَسَ عَلَی الْمِنْبَرِ دَعَا بِإِنَائٍ مِنْ مَائٍ فَشَرِبَہُ ، وَالنَّاسُ یَنْظُرُونَ إلَیْہِ ، لِیُعَلِّمَہُمْ أَنَّہُ لاَ یَصُومُ یَوْمَ الْجُمُعَۃِ۔ (نسائی ۲۷۷۴۔ حاکم ۶۰۸)","Da'if","Musannaf Ibn Abi Shaybah 9334","","","كتاب الصيام"
"9335","(۹۳۳۵) حَدَّثَنَا ابْنُ عُیَینَۃَ ، عَنْ عِمْرَانَ بْنِ ظَبْیَانَ ، عَنْ حَکِیمِ بْنِ سَعْدٍ ، عَنْ عَلِیِّ بْنِ أَبِی طَالِبٍ رَحْمَۃُ اللہِ عَلَیْہِ، قَالَ: مَنْ کَانَ مِنْکُمْ مُتَطَوِّعًا مِنَ الشَّہْرِ أَیَّامًا فَلْیَکُنْ فِی صَوْمِہِ یَوْم الْخَمِیسِ، وَلاَ یَصُومُ یَوْمَ الْجُمُعَۃِ، فَإِنَّہُ یَوْمُ طَعَامٍ وَشَرَابٍ وَذِکْرٍ ، فَیَجْمَعُ للہِ یَوْمَیْنِ صَالِحَیْنِ ، یَوْمَ صِیَامِہِ وَیَوْمَ نُسُکِہِ مَعَ الْمُسْلِمِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 9335","","","كتاب الصيام"
"9336","(۹۳۳۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ قَیْسِ بْنِ سَکَنٍ ، قَالَ : مَرَّ نَاسٌ مِنْ أَصْحَابِ عَبْدِ اللہِ عَلَی أَبِی ذَرٍّ یَوْمَ الْجُمُعَۃِ وَہُمْ صِیَامٌ ، فَقَالَ : أَقْسَمْت عَلَیْکُمْ لَتَفْطُرُنَّ ، فَإِنَّہُ یَوْمُ عِیدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 9336","","","كتاب الصيام"
"9337","(۹۳۳۷) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَنْ أَبِی إِسْحَاقَ، عَنِ الْحَارِثِ، عَنْ عَلِیٍّ، قَالَ: لاَ تَصَومُ یَوْمَ الْجُمُعَۃِ مُتَعَمِّدًا لَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 9337","","","كتاب الصيام"
"9338","(۹۳۳۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : لاَ تَصَومُ یَوْمَ الْجُمُعَۃِ إِلاَّ أَنْ تَصُومَ یَوْمًا قَبْلَہُ ، أَوْ بَعْدَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9338","","","كتاب الصيام"
"9339","(۹۳۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ کَرِہَ أَنْ یَصُومَ یَوْمَ الْجُمُعَۃِ ، یَتَعَمَّدُہ وَحْدَہُ۔","","Musannaf Ibn Abi Shaybah 9339","","","كتاب الصيام"
"9340","(۹۳۴۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُمْ کَرِہُوا صَوْمَ یَوْمِ الْجُمُعَۃِ لِیَتَقَوَّوْا بِہِ عَلَی الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 9340","","","كتاب الصيام"
"9341","(۹۳۴۱) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی أَیُّوبَ الْعَتَکِیِّ ، عَنْ جُوَیْرِیَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دَخَلَ عَلَیْہَا وَہِیَ صَائِمَۃٌ یَوْمَ الْجُمُعَۃِ ، فَقَالَ : أَصُمْتِ أَمْسِ ؟ قَالَتْ : لاَ ، قَالَ : فَتَصُومِینَ غَدًا ؟ قَالَتْ : لاَ ، قَالَ : فَأَفْطِرِی۔ (بخاری ۱۹۸۶۔ احمد ۶/۴۳۰)","Sahih","Musannaf Ibn Abi Shaybah 9341","","","كتاب الصيام"
"9342","(۹۳۴۲) حَدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ زِیَادٍ الْحَارِثِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ لَہُ رَجُلٌ : أَنْتَ الَّذِی تَنْہَی عَنْ صَوْمِ یَوْمِ الْجُمُعَۃِ ؟ قَالَ : لاَ ، وَرَبِّ ہَذِہِ الْحُرْمَۃِ ، أَوْ ہَذِہِ الْبُنْیَۃِ ، مَا أَنَا نَہَیْت عَنْہُ ، مُحَمَّدٌ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَہُ۔ (نسائی ۲۷۴۴۔ احمد ۲/۵۲۶)","Da'if","Musannaf Ibn Abi Shaybah 9342","","","كتاب الصيام"
"9343","(۹۳۴۳) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْوَلِیدِ بْنِ مُسْلِمٍ ، عَنْ حُصَیْنِ بْنِ أَبِی الْحُرِّ ، عَنْ عِمْرَانَ بْنِ حُصَیْنِ ؟ قَالَ : لاَ تَصُمْ یَوْمًا تَجْعَلُ صَوْمَہُ عَلَیْک حَتْمًا ، لَیْسَ مِنْ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 9343","","","كتاب الصيام"
"9344","(۹۳۴۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ، قَالَ : کَانَ ابْنُ عَبَّاسٍ یَنْہَی عَنِ افْتِرَادِ الْیَوْمِ کُلَّ مَا مَرَّ بِالإِنْسَان ، وَعَنْ صِیَامِ الأَیَّامِ الْمَعْلُومَۃِ ، وَکَانَ یَنْہَی عَنْ صِیَامِ الأَشْہُرِ لاَ یُخْطَأْنَ۔","","Musannaf Ibn Abi Shaybah 9344","","","كتاب الصيام"
"9345","(۹۳۴۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَفْرِضُوا عَلَی أَنْفُسِہِمْ شَیْئًا لَمْ یُفْتَرَضْ عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 9345","","","كتاب الصيام"
"9346","(۹۳۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ؟ قَالَ : لاَ تَخُصُّوا یَوْمَ الْجُمُعَۃِ بِصَوْمٍ بَیْنَ الأَیَّامِ ، وَلاَ لَیْلَۃَ الْجُمُعَۃِ بِقِیَامٍ بَیْنَ اللَّیَالِیِ۔","","Musannaf Ibn Abi Shaybah 9346","","","كتاب الصيام"
"9347","(۹۳۴۷) حَدَّثَنَا أَبُو دَاوُدَ، عَنْ زَمْعَۃَ، عَنِ ابْنِ طَاوُوس، عَنْ أَبِیہِ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَتَحَرَّی شَہْرًا، أَوْ یَوْمًا یَصُومُہُ۔","","Musannaf Ibn Abi Shaybah 9347","","","كتاب الصيام"
"9348","(۹۳۴۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَخُصُّوا یَوْمَ الْجُمُعَۃِ وَاللَّیْلَۃَ کَذَلِکَ بِالصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 9348","","","كتاب الصيام"
"9349","(۹۳۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ (ح) وعَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُمَا کَرِہَا أَنْ یَصُومَا یَومًا یُُوَقِّتَانِہِ۔","","Musannaf Ibn Abi Shaybah 9349","","","كتاب الصيام"
"9350","(۹۳۵۰) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَد ، عَنْ مُجَاہِدٍ ؟ قَالَ : لاَ تَصُومُوا شَہْرًا کُلَّہُ تُضَاہُونَ بِہِ شَہْرَ رَمَضَانَ ، وَلاَ تَصُومُوا یَوْمًا وَاحِدًا مِنَ الْجُمُعَۃِ فَتَتَّخِذُونَہُ عِیدًا ، إِلاَّ أَنْ تَصُومُوا قَبْلَہُ ، أَوْ بَعْدَہُ یَوْمًا۔","","Musannaf Ibn Abi Shaybah 9350","","","كتاب الصيام"
"9351","(۹۳۵۱) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَا رَأَیْتُہُ مُفْطِرًا یَوْمَ جُمُعَۃٍ قَطُّ۔","Da'if","Musannaf Ibn Abi Shaybah 9351","","","كتاب الصيام"
"9352","(۹۳۵۲) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ عُمَیْرِ بْنِ أَبِی عُمَیْرٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَا رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُفْطِرًا یَوْمَ الْجُمُعَۃِ قَطُّ۔ (ابویعلی ۵۷۰۹)","Da'if","Musannaf Ibn Abi Shaybah 9352","","","كتاب الصيام"
"9353","(۹۳۵۳) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ شَیْبَانَ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَبْدِ اللہِ ، قَالَ : مَا کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُفْطِرُ یَوْمَ الْجُمُعَۃِ۔ (ترمذی ۷۴۲۔ ابوداؤد ۲۴۴۲)","Da'if","Musannaf Ibn Abi Shaybah 9353","","","كتاب الصيام"
"9354","(۹۳۵۴) حَدَّثَنَا شَرِیکٌ ، عَنِ الْقَعْقَاعِ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ عَنِ السَّعُوطِ بِالصَّبِرِ لِلصَّائِمِ ؟ فَلَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 9354","","","كتاب الصيام"
"9355","(۹۳۵۵) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِالسَّعُوطِ لِلصَّائِمِ ، وَکَرِہَ الصَّبَّ فِی الأُذنِ۔","","Musannaf Ibn Abi Shaybah 9355","","","كتاب الصيام"
"9356","(۹۳۵۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَرِہَ لِلصَّائِمِ أَنْ یَسْتَسْعِطَ۔","","Musannaf Ibn Abi Shaybah 9356","","","كتاب الصيام"
"9357","(۹۳۵۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حُرَیْثٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ کَرِہَ السَّعُوطَ لِلصَّائِمِ۔","","Musannaf Ibn Abi Shaybah 9357","","","كتاب الصيام"
"9358","(۹۳۵۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ، عَنِ ابْنِ جُرَیْجٍ، قَالَ: قُلْتُ لِعَطَائٍ: الصَّبِرُ یَکْتَحِلُ بِہِ الصَّائِمُ؟ قَالَ: نَعَمْ، إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 9358","","","كتاب الصيام"
"9359","(۹۳۵۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِالْکُحْلِ لِلصَّائِمِ۔","","Musannaf Ibn Abi Shaybah 9359","","","كتاب الصيام"
"9360","(۹۳۶۰) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِالْکُحْلِ لِلصَّائِمِ۔","","Musannaf Ibn Abi Shaybah 9360","","","كتاب الصيام"
"9361","(۹۳۶۱) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِالْکُحْلِ لِلصَّائِمِ مَا لَمْ یَجِدْ طَعْمَہُ۔","","Musannaf Ibn Abi Shaybah 9361","","","كتاب الصيام"
"9362","(۹۳۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، وَمُحَمَّدِ بْنِ عَلِیٍّ ، وَعَطَائٍ ؛ أَنَّہُمْ کَانُوا یَکْتَحِلُونَ بِالإِثْمدِ وَہُمْ صِیَامٌ ، لاَ یَرَوْنَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 9362","","","كتاب الصيام"
"9363","(۹۳۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ خَالِدٍ ، عَنِ الْحَسَنِ (ح) وَعَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِالْکُحْلِ لِلصَّائِمِ۔","","Musannaf Ibn Abi Shaybah 9363","","","كتاب الصيام"
"9364","(۹۳۶۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ أَبِی مُعَاذٍ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی بَکْرٍ ، عَنْ أَنَسٍ ؛ أَنَّہُ کَانَ یَکْتَحِلُ وَہُوَ صَائِمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 9364","","","كتاب الصيام"
"9365","(۹۳۶۵) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، وَأَبِی ہِلاَلٍ ، وَقَتَادَۃَ ؛ أَنَّہُمْ کَرِہُوا الْکُحْلَ لِلصَّائِمِ۔","","Musannaf Ibn Abi Shaybah 9365","","","كتاب الصيام"
"9366","(۹۳۶۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ لاَ یَرَی بَأْسًا أَنْ یَکْتَحِلَ الرَّجُلُ وَہُوَ صَائِمٌ۔","","Musannaf Ibn Abi Shaybah 9366","","","كتاب الصيام"
"9367","(۹۳۶۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ بَأْسَ بِالْکُحْلِ لِلصَّائِمِ۔","","Musannaf Ibn Abi Shaybah 9367","","","كتاب الصيام"
"9368","(۹۳۶۸) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، أَوْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یَتَطَعَّمَ الصَّائِمُ مِنَ الْقِدْرِ۔","","Musannaf Ibn Abi Shaybah 9368","","","كتاب الصيام"
"9369","(۹۳۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ أَنْ یَذُوقَ الْخَلَّ ، أَوِ الشَّیْئَ مَا لَمْ یَدْخُلْ حَلْقَہُ وَہُوَ صَائِمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 9369","","","كتاب الصيام"
"9370","(۹۳۷۰) حَدَّثَنَا شَرِیکٌ ، عَنْ سُلَیْمَانَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ أَنْ یَتَطَاعَمَ الصَّائِمُ مِنَ الْقِدْرِ۔","Hasan","Musannaf Ibn Abi Shaybah 9370","","","كتاب الصيام"
"9371","(۹۳۷۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَتَطَاعَمَ الصَّائِمُ الْعَسَلَ وَالسَّمْنَ وَنَحْوَہُ ، ثُمَّ یَمُجَّہُ۔","","Musannaf Ibn Abi Shaybah 9371","","","كتاب الصيام"
"9372","(۹۳۷۲) حَدَّثَنَا أَبُو بَکْرٍ الْحَنَفِیُّ ، عَنِ الضَّحَّاکِ بْنِ عُثْمَانَ ، قَالَ : رَأَیْتُ عُرْوَۃَ بْنَ الزُّبَیْرِ صَائِمًا أَیَّامَ مِنًی ، وَہُوَ یَذُوقُ عَسَلاً۔","","Musannaf Ibn Abi Shaybah 9372","","","كتاب الصيام"
"9373","(۹۳۷۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ عَنِ الصَّائِمِ یَلْحَسُ الأَنْقَاسَ ؟ قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 9373","","","كتاب الصيام"
"9374","(۹۳۷۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مَسْرُوقٍ ، قَالَ : أَتَیْتُ عَائِشَۃَ أَنَا وَرَجُلٌ مَعِی، وَذَلِکَ یَوْمُ عَرَفَۃَ فَدَعَتْ لَنَا بِشَرَابٍ ، ثُمَّ قَالَتْ : لَوْلاَ أَنِّی صَائِمَۃٌ لَذُقْتُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9374","","","كتاب الصيام"
"9375","(۹۳۷۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنِ الأَوْزَاعِیِّ ، قَالَ : لاَ بَأْسَ أَنْ یُدَاوِیَ الصَّائِمُ لِثَتَہُ۔","","Musannaf Ibn Abi Shaybah 9375","","","كتاب الصيام"
"9376","(۹۳۷۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَکُونُ بِفِیہِ الْجُرْحُ وَالْعِلَّۃُ ، قَالَ : لاَ بَأْسَ أَنْ یَضَعَ عَلَیْہِ الْحُضُضَ وَأَشْبَاہَہُ مِنَ الدَّوَائِ۔","","Musannaf Ibn Abi Shaybah 9376","","","كتاب الصيام"
"9377","(۹۳۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ یَحْیَی بْنِ عَتِیقٍ ، عَنِ ابْنِ سِیرِینَ ؛ فِی رَجُلٍ أَصَابَہُ سُلاَقٌ فِی شَفَتَیْہِ ، قَالَ : لاَ بَأْسَ بِالْحُضُضِ۔","","Musannaf Ibn Abi Shaybah 9377","","","كتاب الصيام"
"9378","(۹۳۷۸) حَدَّثَنَا أَبُوبَکْرٍ الْحَنَفِیُّ، عَنْ قَتَادَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: لاَ یَتَطَوَّعُ الرَّجُلُ بِصَوْمٍ وَعَلَیْہِ شَیْئٌ مِنْ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 9378","","","كتاب الصيام"
"9379","(۹۳۷۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ؛ أَنَّہُ کَرِہَ أَنْ یَتَطَوَّعَ بِصِیَامٍ وَعَلَیْہِ قَضَائٌ مِنْ رَمَضَانَ، إِلاَّ الْعَشْرَ۔","","Musannaf Ibn Abi Shaybah 9379","","","كتاب الصيام"
"9380","(۹۳۸۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : مَثَلُ الَّذِی یَتَطَوَّعُ وَعَلَیْہِ قَضَائٌ مِنْ رَمَضَانَ ، مَثَلُ الَّذِی یُسَبِّحُ وَہُوَ یَخَافُ أَنْ تَفُوتَہُ الْمَکْتُوبَۃُ۔","","Musannaf Ibn Abi Shaybah 9380","","","كتاب الصيام"
"9381","(۹۳۸۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، قَالَ : سُئِلَ سُلَیْمَانُ بْنُ یَسَارٍ وَسَعِیدُ بْنُ الْمُسَیَّبِ عَنْ رَجُلٍ تَطَوَّعَ وَعَلَیْہِ قَضَائٌ مِنْ رَمَضَانَ ؟ فَکَرِہَا ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 9381","","","كتاب الصيام"
"9382","(۹۳۸۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا کَانَ عَلَی الرَّجُلِ قَضَائٌ مِن?? رَمَضَانَ فَتَطَوَّعَ ، فَہُوَ قَضَاؤُہُ ، وَإِنْ لَمْ یُرِدْہُ۔","","Musannaf Ibn Abi Shaybah 9382","","","كتاب الصيام"
"9383","(۹۳۸۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سَأَلَ مُغِیثٌ عَطَائٍ : أَیَسْتَدْخِلُ الرَّجُلُ الشَّیْئَ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 9383","","","كتاب الصيام"
"9384","(۹۳۸۴) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ أَنَّہُ سُئِلَ عَنِ الْحُقْنَۃِ لِلصَّائِمِ ؟ فَقَالَ : إنِّی لأَکْرَہُہَا لِلْمُفْطِرِ ، فَکَیْفَ لِلصَّائِمِ۔","","Musannaf Ibn Abi Shaybah 9384","","","كتاب الصيام"
"9385","(۹۳۸۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ تَمْضُغَ الْمَرْأَۃُ لِصَبِیِّہَا وَہِیَ صَائِمَۃٌ ، مَا لَمْ یَدْخُلْ حَلْقَہَا۔","","Musannaf Ibn Abi Shaybah 9385","","","كتاب الصيام"
"9386","(۹۳۸۶) حَدَّثَنَا وَکِیعٌ، عَنْ شَرِیکٍ، عَنْ سُلَیْمَانَ، عَنْ عِکْرِمَۃَ، قَالَ: لاَ بَأْسَ أَنْ تَمْضُغَ الْمَرْأَۃُ لِصَبِیِّہَا وَہِیَ صَائِمَۃٌ۔","","Musannaf Ibn Abi Shaybah 9386","","","كتاب الصيام"
"9387","(۹۳۸۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَبِی سُفْیَانَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَذُرَّ الصَّائِمُ عَیْنَہُ بِالذَّرُورِ۔","","Musannaf Ibn Abi Shaybah 9387","","","كتاب الصيام"
"9388","(۹۳۸۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِالذَّرُورِ لِلصَّائِمِ۔","","Musannaf Ibn Abi Shaybah 9388","","","كتاب الصيام"
"9389","(۹۳۸۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : شَہِدَ عِنْدِی نَفَرٌ مِنْ أَہْلِ الْبَصْرَۃِ ، مِنْہُمُ الْحَسَنُ بْنُ أَبِی الْحَسَنِ الْبَصْرِیُّ ، عَنْ مَعْقِلِ بْنِ سِنَان الأَشْجَعِیِّ ، قَالَ : مَرَّ عَلَیَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنَا أَحْتَجِمُ فِی ثَمَانِ عَشْرَۃَ مِنْ رَمَضَانَ ، فَقَالَ : أَفْطَرَ الْحَاجِمُ وَالْمَحْجُومُ۔ (طحاوی ۹۸۔ احمد ۳/۴۷۴)","Hasan","Musannaf Ibn Abi Shaybah 9389","","","كتاب الصيام"
"9390","(۹۳۹۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا عَاصِمٌ الأَحْوَلُ ، عَنْ عَبْدِ اللہِ بْنِ زَیْدٍ وَہُوَ أَبُو قِلاَبَۃَ ، عَنْ أَبِی الأَشْعَثِ الصَّنْعَانِیِّ ، عَنْ أَبِی أَسْمَائَ الرَّحَبِیِّ ، عَنْ شَدَّادِ بْنِ أَوْسٍ ، قَالَ : مَرَرْت مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی ثَمَانِ عَشْرَۃَ خَلَتْ مِنْ رَمَضَانَ ، فَأَبْصَرَ رَجُلاً احْتَجَمَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَفْطَرَ الْحَاجِمُ وَالْمَحْجُومُ۔ (ابوداؤد ۲۳۶۱۔ احمد ۴/۱۲۴)","Sahih","Musannaf Ibn Abi Shaybah 9390","","","كتاب الصيام"
"9391","(۹۳۹۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ عَبْدِ اللہِ بْنِ زَیْدٍ ، عَنْ أَبِی الأَشْعَثِ ، عَنْ أَبِی أَسْمَائَ الرَّحَبِیِّ ، عَنْ شَدَّادِ بْنِ أَوْسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، مِثْلَہُ۔ (احمد ۴/۱۲۴)","Sahih","Musannaf Ibn Abi Shaybah 9391","","","كتاب الصيام"
"9392","(۹۳۹۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَمَّنْ حَدَّثَہُ ، عَنْ شَدَّادِ بْنِ أَوْسٍ ، قَالَ : أَتَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی رَجُلٍ یَحْتَجِمُ بِالْبَقِیعِ ، وَہُوَ آخِذٌ بِیَدَیَّ لِثَمَانِ عَشْرَۃَ خَلَتْ مِنْ رَمَضَانَ ، فَقَالَ: أَفْطَرَ الْحَاجِمُ وَالْمَحْجُومُ۔ (ابوداؤد ۲۳۶۱۔ احمد ۴/۱۲۵)","Da'if","Musannaf Ibn Abi Shaybah 9392","","","كتاب الصيام"
"9393","(۹۳۹۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ مَکْحُولٍ ، قَالَ : أَخْبَرَنِی رَجُلٌ مِنَ الْحَیِّ مُصَدَّقٌ ، عَنْ ثَوْبَانَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أَفْطَرَ الْحَاجِمُ وَالْمَحْجُومُ۔ (ابوداؤد ۲۳۶۲۔ احمد ۵/۲۸۲)","Da'if","Musannaf Ibn Abi Shaybah 9393","","","كتاب الصيام"
"9394","(۹۳۹۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا أَیُّوبُ أَبُو الْعَلاَئِ ، عَنْ قَتَادَۃَ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ بِلاَلٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَفْطَر الْحَاجِمُ وَالْمَحْجُومُ۔ (احمد ۶/۱۲۔ طبرانی ۱۱۲۲)","","Musannaf Ibn Abi Shaybah 9394","","","كتاب الصيام"
"9395","(۹۳۹۵) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، عَنْ أَبِی ہُرَیْرَۃَ رَضِیَ اللَّہُ تَعَالَی عَنْہُ ، أَنَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أَفْطَرَ الْحَاجِمُ وَالْمَحْجُومُ۔ (نسائی ۳۱۷۲۔ احمد ۶/۳۶۴)","Hasan","Musannaf Ibn Abi Shaybah 9395","","","كتاب الصيام"
"9396","(۹۳۹۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قَالَ أَبُو ہُرَیْرَۃَ : إنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أَفْطَرَ الْحَاجِمُ وَالْمَحْجُومُ۔ (نسائی ۳۱۸۲۔ ابویعلی ۶۳۶۵)","","Musannaf Ibn Abi Shaybah 9396","","","كتاب الصيام"
"9397","(۹۳۹۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنِ ابْنِ أَبِی عَرُوبَۃَ، عَنْ مَطَرٍ، عَنِ الْحَسَنِ، قَالَ: قَالَ عَلِیٌّ: أَفْطَرَ الْحَاجِمُ وَالْمَحْجُومُ۔","Hasan","Musannaf Ibn Abi Shaybah 9397","","","كتاب الصيام"
"9398","(۹۳۹۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : یُکْرَہُ لِلْحَاجِمِ وَالْمَحْجُومِ۔","","Musannaf Ibn Abi Shaybah 9398","","","كتاب الصيام"
"9399","(۹۳۹۹) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : دَخَلْتُ عَلَی أَبِی مُوسَی وَہُوَ أَمِیرُ الْبَصْرَۃِ مُمْسِیًا ، فَوَجَدْتُہُ یَأْکُلُ تَمْرًا وَکَامَخًا ، وَقَدِ احْتَجَمَ ، فَقُلْتُ لَہُ : أَلاَ تَحْتَجِمُ بِنَہَارٍ ؟ فَقَالَ : أَتَأْمُرُنِی أَنْ أُہْرِیقَ دَمِی وَأَنَا صَائِمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 9399","","","كتاب الصيام"
"9400","(۹۴۰۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنْ طَلْقِ بْنِ حَبِیبٍ ، قَالَ : أَفْطَرَ الْحَاجِمُ وَالْمَحْجُومُ۔","","Musannaf Ibn Abi Shaybah 9400","","","كتاب الصيام"
"9401","(۹۴۰۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، قَالَ : لاَ یَحْتَجِمُ الصَّائِمُ۔","","Musannaf Ibn Abi Shaybah 9401","","","كتاب الصيام"
"9402","(۹۴۰۲) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی، عَنْ شَیْبَانَ، عَنْ لَیْثٍ، عَنْ عَطَائٍ، عَنْ عَائِشَۃَ قَالَتْ: أَفْطَرَ الْحَاجِمُ وَالْمَحْجُومُ۔","Da'if","Musannaf Ibn Abi Shaybah 9402","","","كتاب الصيام"
"9403","(۹۴۰۳) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی ، عَنْ مَنْصُورٍ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ، قَالَ : لاَ یَحْتَجِمُ الصَّائِمُ۔","","Musannaf Ibn Abi Shaybah 9403","","","كتاب الصيام"
"9404","(۹۴۰۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ یَزِیدَ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ احْتَجَمَ بَیْنَ مَکَّۃَ إِلَی الْمَدِینَۃِ ، مُحْرِمًا صَائِمًا۔ (ترمذی ۷۷۷۔ ابوداؤد ۲۳۶۵)","Da'if","Musannaf Ibn Abi Shaybah 9404","","","كتاب الصيام"
"9405","(۹۴۰۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ احْتَجَمَ وَہُوَ صَائِمٌ۔","","Musannaf Ibn Abi Shaybah 9405","","","كتاب الصيام"
"9406","(۹۴۰۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ احْتَجَمَ صَائِمًا۔ (نسائی ۳۲۲۴۔ احمد ۱/۲۸۶)","Shadh","Musannaf Ibn Abi Shaybah 9406","","","كتاب الصيام"
"9407","(۹۴۰۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ احْتَجَمَ وَہُوَ صَائِمٌ۔ (نسائی ۳۲۲۲۔ عبدالرزاق ۷۵۳۶)","","Musannaf Ibn Abi Shaybah 9407","","","كتاب الصيام"
"9408","(۹۴۰۸) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن عَطَائِ بْنِ یَسَارٍ رَفَعَہُ ، قَالَ : ثَلاَثٌ لاَ یُفْطرن الصَّائِمَ ؛ الْحِجَامَۃُ ، وَالْقَیْئُ ، وَالاِحْتِلاَمُ۔ (عبدالرزاق ۷۵۳۹۔ ابن خزیمۃ ۱۹۷۶)","","Musannaf Ibn Abi Shaybah 9408","","","كتاب الصيام"
"9409","(۹۴۰۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبَانَ بْنِ صَالِحٍ ، عَنْ مُسْلِمِ بْنِ سَعِیدٍ ، قَالَ : سُئِلَ ابْنُ مَسْعُودٍ عَنِ الْحِجَامَۃِ لِلصَّائِمِ ؟ فَقَالَ : لاَ بَأْسَ بِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 9409","","","كتاب الصيام"
"9410","(۹۴۱۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ حُمَیْدٍ ، قَالَ : سُئِلَ أَنَسٌ عَنِ الْحِجَامَۃِ لِلصَّائِمِ ؟ فَقَالَ : مَا کُنَّا نَحْسِبُ یُکْرَہُ مِنْ ذَلِکَ إِلاَّ جُہْدُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9410","","","كتاب الصيام"
"9411","(۹۴۱۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی ظَبْیَانَ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی الْحِجَامَۃِ لِلصَّائِمِ ، قَالَ : الْفِطْرُ مِمَّا دَخَلَ ، وَلَیْسَ مِمَّا یَخْرُجُ۔","Sahih","Musannaf Ibn Abi Shaybah 9411","","","كتاب الصيام"
"9412","(۹۴۱۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنَ عُمَرَ ، قَالَ : کَانَ یَحْتَجِمُ وَہُوَ صَائِمٌ ، ثُمَّ تَرَکَہَا بَعْدُ ، فَکَانَ یَحْتَجِمُ لَیْلاً۔","Sahih","Musannaf Ibn Abi Shaybah 9412","","","كتاب الصيام"
"9413","(۹۴۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ بن الغَاز ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَحْتَجِمُ عِنْدَ اللَّیْلِ وَہُوَ صَائِمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 9413","","","كتاب الصيام"
"9414","(۹۴۱۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حُمَیْدٍ ، عَنْ أَبِی الْمُتَوَکِّلِ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : لاَ بَأْسَ بِالْحِجَامَۃِ لِلصَّائِمِ۔","Hasan","Musannaf Ibn Abi Shaybah 9414","","","كتاب الصيام"
"9415","(۹۴۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی الْمُتَوَکِّلِ ، عَنْ أَبِی سَعِیدٍ ؛ أَنَّہُ کَرِہَ الْحِجَامَۃَ لِلصَّائِمِ مِنْ أَجْلِ الضَّعْفِ۔","Sahih","Musannaf Ibn Abi Shaybah 9415","","","كتاب الصيام"
"9416","(۹۴۱۶) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ یُونُسَ بْنِ عَبْدِ اللہِ الْجَرْمِیِّ ، عَنْ دِینَارٍ ، قَالَ : حَجَمْت زَیْدَ بْنَ أَرْقَمَ وَہُوَ صَائِمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 9416","","","كتاب الصيام"
"9417","(۹۴۱۷) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ أَبِی أُسَامَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : احْتَجَمَ الْحُسَیْنُ بْنُ عَلِیٍّ وَہُوَ صَائِمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 9417","","","كتاب الصيام"
"9418","(۹۴۱۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، وَطَاوُسٍ ؛ أَنَّہُمَا لَمْ یَکُونَا یَرَیَانِ بِالْحِجَامَۃِ لِلصَّائِمِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 9418","","","كتاب الصيام"
"9419","(۹۴۱۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ عَبْدِ الأَعْلَی ، قَالَ : رَأَیْتُ أَبَا عَبْدِ الرَّحْمَنِ السُّلَمِیَّ احْتَجَمَ وَہُوَ صَائِمٌ عِنْدَ غُرُوبِ الشَّمْسِ ، نَحْوًا مِمَّا یُوَافِقُ شَرْطُہُ فِطْرَہُ ، فَقُلْتُ لَہُ : یَا أَبَا عَبْدِ الرَّحْمَنِ ؛ إنَّمَا تُکْرَہُ الْحِجَامَۃُ لِلصَّائِمِ ، قَالَ : إنَّمَا تُکْرَہُ لَہُ مَخَافَۃَ الضَّعْفِ۔","","Musannaf Ibn Abi Shaybah 9419","","","كتاب الصيام"
"9420","(۹۴۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبَّاسٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالُوا : إنَّمَا نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْحِجَامَۃِ لِلصَّائِمِ ، وَالْوِصَالِ فِی الصِّیَامِ إبْقَائً عَلَی أَصْحَابِہِ۔ (ابوداؤد ۲۳۶۶۔ احمد ۴/۳۱۴)","Sahih","Musannaf Ibn Abi Shaybah 9420","","","كتاب الصيام"
"9421","(۹۴۲۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ مِسْعَرٍ ، عَنْ بُزَیْعٍ ، قَالَ : سَأَلْتُ أَبَا وَائِلٍ عَنِ الْحِجَامَۃِ لِلصَّائِمِ ؟ فَقَالَ : إنَّمَا یُکْرَہُ ذَلِکَ لِلضَّعْفِ۔","","Musannaf Ibn Abi Shaybah 9421","","","كتاب الصيام"
"9422","(۹۴۲۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَحْوَصِ بْنِ حَکِیمٍ ، عَنْ أَبِی الزَّاہِرِیَّۃِ ، عَنْ جُبَیْرِ بْنِ نُفَیْرٍ ؛ أَنَّ مُعَاذًا احْتَجَمَ وَہُوَ صَائِمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 9422","","","كتاب الصيام"
"9423","(۹۴۲۳) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ ، عَنْ عَطَائٍ ، وَسَعِیدِ بْنِ جُبَیْرٍ قَالاَ : لاَ بَأْسَ بِالْحِجَامَۃِ لِلصَّائِمِ مَا لَمْ یَخَفْ ضَعْفًا۔","","Musannaf Ibn Abi Shaybah 9423","","","كتاب الصيام"
"9424","(۹۴۲۴) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، وَسَالِمٍ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 9424","","","كتاب الصيام"
"9425","(۹۴۲۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : سَأَلَ رَجُلٌ عِکْرِمَۃَ عَنِ الْحِجَامَۃِ لِلصَّائِمِ ؟ فَقَالَ : لاَ بَأْسَ بِہَا ، إنَّمَا ہِیَ مِثْلُ کَذَا وَکَذَا یَخْرُجُ مِنْکَ ، ذَکَرَ الْحَاجَۃَ۔","","Musannaf Ibn Abi Shaybah 9425","","","كتاب الصيام"
"9426","(۹۴۲۶) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، وَأَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَحْتَجِمُ وَہُوَ صَائِمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 9426","","","كتاب الصيام"
"9427","(۹۴۲۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا سُفْیَانُ ، عَنْ فُرَاتٍ ، عَنْ مَوْلًی لأُمِّ سَلَمَۃَ ؛ أَنَّہُ رَأَی أُمَّ سَلَمَۃَ تَحْتَجِمُ وَہِیَ صَائِمَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 9427","","","كتاب الصيام"
"9428","(۹۴۲۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ یَزِیدَ ، وَعُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَحْتَجِمُ وَہُوَ صَائِمٌ ، ثُمَّ تَرَکَ ذَلِکَ ، فَلاَ أَدْرِی لأَیِّ شَیْئٍ تَرَکَہُ ؟ کَرِہَہُ ، أَوْ لِلضَّعْفِ۔","Sahih","Musannaf Ibn Abi Shaybah 9428","","","كتاب الصيام"
"9429","(۹۴۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ الْوَارِث ، عَنْ أَنَسٍ ، قَالَ : مَرَّ بِنَا أَبُو طیبۃَ ، فَقَالَ : حجَمْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ صَائِمٌ۔ (ترمذی ۳۶۶۔ ابویعلی ۴۲۱۰)","Da'if","Musannaf Ibn Abi Shaybah 9429","","","كتاب الصيام"
"9430","(۹۴۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مَعْمَرٍ ، عَنْ أَبِی جَعْفَرٍ ؛ إنَّمَا کُرِہَ الْحِجَامَۃُ لِلصَّائِمِ مَخَافَۃَ الضَّعْفِ۔","","Musannaf Ibn Abi Shaybah 9430","","","كتاب الصيام"
"9431","(۹۴۳۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ الْمُبَارَک ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی الْمَرْأَۃِ تَحِیضُ أَوَّلَ النَّہَارِ فِی شَہْرِ رَمَضَانَ ، فَقَالَ : تَأْکُلُ وَتَشْرَبُ۔","","Musannaf Ibn Abi Shaybah 9431","","","كتاب الصيام"
"9432","(۹۴۳۲) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی الْمَرْأَۃِ حَاضَتْ بَعْدَ مَا اصْفَرَّتِ الشَّمْسُ فِی رَمَضَانَ ، قَالَ : تُفْطِرُ ، قَالَ : وَإِنْ أَصْبَحَتْ حَائِضًا ، فَطَہُرَتْ بَعْدَ طُلُوعِ الْفَجْرِ ؟ قَالَ : لاَ تَأْکُلُ بَقِیَّۃَ یَوْمِہَا۔","","Musannaf Ibn Abi Shaybah 9432","","","كتاب الصيام"
"9433","(۹۴۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ فِی الْمَرْأَۃِ تُصْبِحُ صَائِمَۃً أَوَّلَ النَّہَارِ ، ثُمَّ تَحِیضُ ، قَالَ : تَأْکُلُ۔","","Musannaf Ibn Abi Shaybah 9433","","","كتاب الصيام"
"9434","(۹۴۳۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الْحَائِضِ تَطْہُرُ فَلاَ تَأْکُلُ شَیْئًا، کَرَاہَۃ أَنْ تُشْبِہَ الْمُشْرِکِینَ إلَی اللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 9434","","","كتاب الصيام"
"9435","(۹۴۳۵) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ أَکَلَ أَوَّلَ النَّہَارِ فَلْیَأْکُلْ آخِرَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9435","","","كتاب الصيام"
"9436","(۹۴۳۶) حَدَّثَنَا مُحَمَّدُ بْنُ أَبی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : فِی رَجُلٍ قَدِمَ فِی رَمَضَانَ أَوَّلَ النَّہَارِ وَقَدْ أَکَلَ ، قَالَ : لاَ یَأْکُلُ بَقِیَّۃَ یَوْمِہِ۔","","Musannaf Ibn Abi Shaybah 9436","","","كتاب الصيام"
"9437","(۹۴۳۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الْمُسَافِرِ یَقْدَمُ وَقَدْ کَانَ أَکَلَ؟ قَالَ : لاَ یَأْکُلُ بَقِیَّۃَ یَوْمِہِ۔ حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : لاَ یَأْکُلُ کَرَاہِیَۃَ أَنْ یَتَشَبَّہَ بِالْمُشْرِکِینَ ، إلَی اللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 9437","","","كتاب الصيام"
"9438","(۹۴۳۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ حُرَیْثٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا دَخَلَ الْمُسَافِرُ الْمِصْرَ لَمْ یَطْعَمْ شَیْئًا ، وَإِنْ کَانَ أَکَلَ قَبْلَ أَنْ یَقْدَمَ۔","","Musannaf Ibn Abi Shaybah 9438","","","كتاب الصيام"
"9439","(۹۴۳۹) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لِرَجُلٍ وَقَعَ عَلَی أَہْلِہِ فِی رَمَضَانَ : إِنْ کَانَ فَجَرَ ظَہْرُک ، فَلاَ یَفْجُرْ بَطْنُک۔","","Musannaf Ibn Abi Shaybah 9439","","","كتاب الصيام"
"9440","(۹۴۴۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی الَّذِی یُصِیبُ أَہْلَہُ ، یَعْنِی فِی شَہْرِ رَمَضَانَ ، قَالَ : إِنْ شَائَ أَکَلَ وَشَرِبَ۔","","Musannaf Ibn Abi Shaybah 9440","","","كتاب الصيام"
"9441","(۹۴۴۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَمْرِو بْنِ دِینَارٍ : أَلَیْسَ کَذَا یُقَالُ فِی الَّذِی یُصِیبُ أَہْلَہُ فِی رَمَضَانَ ، لِیُتِمَّ ذَلِکَ الْیَوْمَ وَیَقْضِیہ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 9441","","","كتاب الصيام"
"9442","(۹۴۴۲) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ، عَنْ عَمْرٍو، عَنِ الْحَسَنِ، قَالَ: کَانَ یَقُولُ: إذَا غَشِیَ لاَ یُبَالِی أَکَلَ، أَوْ لَمْ یَأْکُلْ۔","","Musannaf Ibn Abi Shaybah 9442","","","كتاب الصيام"
"9443","(۹۴۴۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مُحَمَّدِ بْنِ صَیْفِیٍّ ، قَالَ : قَالَ لَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ عَاشُورَائَ : مِنْکُمْ أَحَدٌ طَعِمَ الْیَوْمَ ؟ فَقُلْنَا : مِنَّا مَنْ طَعِمَ ، وَمِنَّا مَنْ لَمْ یَطْعَمْ ، قَالَ : فَقَالَ : أَتِمُّوا بَقِیَّۃَ یَوْمِکُمْ ، مَنْ کَانَ طَعِمَ ، وَمَنْ لَمْ یَطْعَمْ ، وَأَرْسِلُوا إلَی أَہْلِ الْعَرُوضِ فَلْیُتِمُّوا بَقِیَّۃَ یَوْمِہِمْ ، یَعْنِی أَہْلَ الْعَرُوضِ مِنْ حَوْلِ الْمَدِینَۃِ۔ (نسائی ۲۶۲۹)","Sahih","Musannaf Ibn Abi Shaybah 9443","","","كتاب الصيام"
"9444","(۹۴۴۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، عَنْ أَبِی مُوسَی ، قَالَ: یَوْمُ عَاشُورَائَ یَوْمٌ تُعَظِّمُہُ الْیَہُودُ تَتَّخِذُہُ عِیدًا ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صُومُوہُ أََنْتُم۔ (بخاری ۲۰۰۵۔ مسلم ۱۳۰)","Sahih","Musannaf Ibn Abi Shaybah 9444","","","كتاب الصيام"
"9445","(۹۴۴۵) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ بْنِ الزُّبَیْرِ الأَسَدِیُّ ، عَنْ شَرِیکٍ ، عَنْ مجزأۃ بْنِ زاہر، عَنْ أَبِیہِ ، قَالَ : أَمَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِصَوْمِ یَوْمِ عَاشُورَائَ۔","Sahih","Musannaf Ibn Abi Shaybah 9445","","","كتاب الصيام"
"9446","(۹۴۴۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الْہَجَرِیِّ ، عَنْ أَبِی عِیَاضٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَوْمُ عَاشُورَائَ یَوْمٌ کَانَتْ تَصُومُہُ الأَنْبِیَائُ ، فَصُومُوہُ أَنْتُمْ۔ (بزار ۱۰۴۶)","Da'if","Musannaf Ibn Abi Shaybah 9446","","","كتاب الصيام"
"9447","(۹۴۴۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ أَہْلَ الْجَاہِلِیَّۃِ کَانُوا یَصُومُونَ یَوْمَ عَاشُورَائَ ، وَأَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَامَہُ وَالْمُسْلِمُونَ قَبْلَ أَنْ یُفْتَرَضَ رَمَضَانُ ، فَلَمَّا افْتُرِضَ رَمَضَانُ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ عَاشُورَائَ یَوْم مِنْ أَیَّامِ اللہِ ، فَمَنْ شَائَ صَامَہُ ، وَمَنْ شَائَ تَرَکَہُ۔ (بخاری ۴۵۰۱۔ مسلم ۷۹۲)","Sahih","Musannaf Ibn Abi Shaybah 9447","","","كتاب الصيام"
"9448","(۹۴۴۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ قَالَتْ : کَانَ عَاشُورَائُ یَوْمًا تَصُومُہُ قُرَیْشٌ فِی الْجَاہِلِیَّۃِ ، فَلَمَّا قَدِمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمَدِینَۃَ صَامَہُ ، وَأَمَرَ بِصِیَامِہِ ، فَلَمَّا فُرِضَ رَمَضَانُ کَانَ رَمَضَانُ ہُوَ الْفَرِیضَۃَ ، وَتَرَکَ عَاشُورَائَ ، فَمَنْ شَائَ صَامَہُ وَمَنْ شَائَ تَرَکَہُ۔n(مسلم ۷۹۲۔ ابوداؤد ۲۴۳۴)","Sahih","Musannaf Ibn Abi Shaybah 9448","","","كتاب الصيام"
"9449","(۹۴۴۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا شَیْبَانُ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنْ جَعْفَرِ بْنِ أَبِی ثَوْرٍ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَأْمُرُنَا بِصِیَامِ عَاشُورَائَ وَیَحُثُّنَا عَلَیْہِ ، أَوْ یَتَعَاہَدُنَا عِنْدَہُ ، فَلَمَّا فُرِضَ رَمَضَانُ لَمْ یَأْمُرْنَا ، وَلَمْ یَنْہَنَا عَنْہُ ، وَلَمْ یَتَعَاہَدْنَا عِنْدَہُ۔ n(مسلم ۱۲۵۔ احمد ۵/۱۰۵)","Sahih","Musannaf Ibn Abi Shaybah 9449","","","كتاب الصيام"
"9450","(۹۴۵۰) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَمَّا قَدِمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمَدِینَۃَ وَالْیَہُودُ یَصُومُونَ یَوْمَ عَاشُورَائَ فَسَأَلَہُمْ عَنْ ذَلِکَ ؟ فَقَالُوا : ہُوَ الْیَوْمُ الَّذِی ظْہَرَ فِیہِ مُوسَی عَلَی فِرْعَوْنَ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لأَنْتُمْ أَوْلَی بِمُوسَی مِنْہُمْ ، فَصُومُوہُ۔ (بخاری ۴۷۳۷۔ مسلم ۷۹۶)","Sahih","Musannaf Ibn Abi Shaybah 9450","","","كتاب الصيام"
"9451","(۹۴۵۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : دَخَلَ الأَشْعَثُ بْنُ قَیْسٍ عَلَی عَبْدِ اللہِ وَہُوَ یَتَغَدَّی ، فَقَالَ : یَا أَبَا مُحَمَّدٍ ، اُدْنُ إلَی الْغَدَاء ، فَقَالَ : أَوَلَیْسَ الْیَوْمُ یَوْمَ عَاشُورَائَ ؟ فَقَالَ : وَہَلْ تَدْرِی مَا یَوْمُ عَاشُورَائَ ؟ قَالَ : وَمَا ہوَُ ؟ قَالَ : إنَّمَا ہُوَ یَوْمٌ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَصُومُہُ قَبْلَ أَنْ یُنَزَّلَ شَہْرُ رَمَضَانَ ، فَلَمَّا نَزَلَ شَہْرُ رَمَضَانَ تُرِکَ۔ (مسلم ۱۲۲۔ احمد ۱/۴۲۴)","Sahih","Musannaf Ibn Abi Shaybah 9451","","","كتاب الصيام"
"9452","(۹۴۵۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَد ، قَالَ : مَا رَأَیْتُ أَحَدًا کَانَ آمَرَ بِصِیَامِ یَوْمِ عَاشُورَائَ مِنْ عَلِیِّ بْنِ أَبِی طَالِبٍ ، وَأَبِی مُوسَی۔","Sahih","Musannaf Ibn Abi Shaybah 9452","","","كتاب الصيام"
"9453","(۹۴۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، وَعَلِیِّ بْنِ صَالِحٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَد ، قَالَ : مَا رَأَیْتُ أَحَدًا آمَرَ بِصَوْمِ یَوْمِ عَاشُورَائَ مِنْ عَلِیِّ بْنِ أَبِی طَالِبٍ ، وَأَبِی مُوسَی۔","Sahih","Musannaf Ibn Abi Shaybah 9453","","","كتاب الصيام"
"9454","(۹۴۵۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَانَ یَأْمُرُ بِصَوْمِ یَوْمِ عَاشُورَائَ۔","Da'if","Musannaf Ibn Abi Shaybah 9454","","","كتاب الصيام"
"9455","(۹۴۵۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عَبْدُ الْمَلِکِ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ ؛ أَنَّ عُمَرَ أَرْسَلَ إلَی عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ مَسَائَ لَیْلَۃِ عَاشُورَائَ : أَنْ تَسَحَّروا ، وَأَصبحَ صَائِمًا ، وَأَصْبَحَ عَبْدُ الرَّحْمَنِ صَائِمًا۔","Sahih","Musannaf Ibn Abi Shaybah 9455","","","كتاب الصيام"
"9456","(۹۴۵۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنِ الْقَاسِمِ ؛ أَنَّہُ کَانَ یَصُومُ عَاشُورَائَ۔","","Musannaf Ibn Abi Shaybah 9456","","","كتاب الصيام"
"9457","(۹۴۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْقَاسِمِ بْنِ مُخَیْمِرَۃَ ، عَنْ أَبِی عَمَّارٍ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، قَالَ : أَمَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِصِیَامِ یَوْمِ عَاشُورَائَ۔ (احمد ۴۲۱۔ نسائی ۳/۲۸۴۱)","Sahih","Musannaf Ibn Abi Shaybah 9457","","","كتاب الصيام"
"9458","(۹۴۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْقَاسِمِ ؛ فَلَمَّا نَزَلَ رَمَضَانُ لَمْ یَأْمُرْنَا ، وَلَمْ یَنْہَنَا ، وَنَحْنُ نَفْعَلُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9458","","","كتاب الصيام"
"9459","(۹۴۵۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ رَجُلاً مِنْ أَسْلَمَ یَوْمَ عَاشُورَائَ ، فَقَالَ : ائْتِ قَوْمَک فَمُرْہُمْ فَلْیَصُومُوا ہَذَا الْیَوْمَ ، فَقَالَ : مَا أَرَانِی آتِیہِمْ حَتَّی یَصْطَبِحُوا ، فَقَالَ : مُرْ مَنِ اصْطَبَحَ منْہُمْ أَنْ یَصُومَ بَقِیَّۃَ یَوْمِہِ ، وَمَنْ لَمْ یَصْطَبِحْ مِنْہُمْ أَنْ یَصُومَ۔ (عبدالرزاق ۷۸۳۴)","","Musannaf Ibn Abi Shaybah 9459","","","كتاب الصيام"
"9460","(۹۴۶۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَہُمْ بِصَوْمِہِ۔","","Musannaf Ibn Abi Shaybah 9460","","","كتاب الصيام"
"9461","(۹۴۶۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یُعْجِبُہُ صَوْمُ یَوْم عَاشُورَائَ۔","","Musannaf Ibn Abi Shaybah 9461","","","كتاب الصيام"
"9462","(۹۴۶۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنْ سُفْیَانَ، عَنْ زُبَیْدٍ، عَنْ عُمَارَۃَ، عَنْ قَیْسِ بْنِ سَکَنٍ؛ أَنَّ الأَشْعَثَ دَخَلَ عَلَی عَبْدِاللہِ یَوْمَ عَاشُورَائَ وَہُوَ یَطْعَمُ، فَقَالَ: اُدْنُ فَکُلْ، فَقَالَ: إنِّی صَائِمٌ، فَقَالَ: إنَّمَا کَانَ ہَذَا قَبْلَ أَنْ یُنَزَّلَ رَمَضَانُ۔","Sahih","Musannaf Ibn Abi Shaybah 9462","","","كتاب الصيام"
"9463","(۹۴۶۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ؛ أَنَّ عُمَرَ کَانَ لاَ یَصُومُہُ۔","","Musannaf Ibn Abi Shaybah 9463","","","كتاب الصيام"
"9464","(۹۴۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زُبَیْدٍ ، عَنْ عُمَارَۃَ ، عَنْ قَیْسِ بْنِ سَکَنٍ الأَسَدِیِّ ، عَنْ عَبْدِ اللہِ ، مِثْلَہُ ، إِلاَّ أَنَّہُ قَالَ : اُدْنُ فَکُلْ۔","Sahih","Musannaf Ibn Abi Shaybah 9464","","","كتاب الصيام"
"9465","(۹۴۶۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی یَحْیَی بْنُ عَبْدِ اللہِ بْنِ صَیْفِیٍّ ، أَنَّ عَمْرو بْنَ أَبِی یُوسُفَ ، أَخَا بَنِی نوفل ، أَخْبَرَہُ ، أَنَّہُ سَمِعَ مُعَاوِیَۃَ یَقُولُ عَلَی الْمِنْبَرِ: إنَّ یَوْمَ عَاشُورَائَ یَوْمُ عِیدٍ، فَمَنْ شَائَ صَامَ، وَقَدْ کَانَ یُصَامُ ، وَمَنْ شَائَ تَرَکَہُ ، وَلاَ حَرَجَ۔","Da'if","Musannaf Ibn Abi Shaybah 9465","","","كتاب الصيام"
"9466","(۹۴۶۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ عُمَرَ بْنِ الْوَلِیدِ ، قَالَ : سُئِلَ عِکْرِمَۃُ عَنْ صِیَامِ یَوْمِ عَاشُورَائَ وَیَوْمِ عَرَفَۃَ ؟ فَقَالَ : لاَ یَصْلُحُ لِرَجُلٍ یَصُومُ یَوْمًا یَرَی أَنَّہُ عَلَیْہِ وَاجِبٌ إِلاَّ رَمَضَانُ۔","","Musannaf Ibn Abi Shaybah 9466","","","كتاب الصيام"
"9467","(۹۴۶۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی بِشْرٍ ، قَالَ : سَمِعْتُ عَلِیًّا یَأْمُرُ بِصَوْمِ عَاشُورَائَ۔","Sahih","Musannaf Ibn Abi Shaybah 9467","","","كتاب الصيام"
"9468","(۹۴۶۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : أَخْبَرَنِی أَبُو ماویَّۃ ، قَالَ : سَمِعْتُ علیًّا یَقُولُ فِی صَوْمِ عَاشُورَاء : فَمَنْ کَانَ بَدَأَ فَلْیُتِمَّ ، وَمَنْ کَانَ أَکَلَ فَلْیَصُم۔","","Musannaf Ibn Abi Shaybah 9468","","","كتاب الصيام"
"9469","(۹۴۶۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطائَ ، عَنْ أَبِی الْخَلِیلِ ، عَنْ أَبِی قَتَادَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَوْمُ عَاشُورَائَ کَفَّارۃ سَنَۃٍ ، وَصَوْمُ یَوْمِ عَرَفَۃَ کَفَّارۃ سَنَتَیْن ؛ سَنَۃٍ مَاضِۃٍ ، وَسَنَۃٍ مُسْتَقْبَلَۃٍ۔ (نسائی ۲۸۰۹۔ احمد ۵/۳۰۷)","Da'if","Musannaf Ibn Abi Shaybah 9469","","","كتاب الصيام"
"9470","(۹۴۷۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدٍ ، سَمِعَ ابْنَ عَبَّاسٍ سئُلَ عَنْ صِیَامِ عَاشُورائَ ؟ فَقَالَ : مَا عَلِمْتُ أَنِی رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَامَ یَوْمًا قَطُّ ، یَطْلُبُ فَضْلَہُ عَنِ الأَیَامِ إِلاَّ ہَذَا الْیَوْمِ ، وَلاَ شَہْرًا إِلاَّ ہَذَا ، یَعْنِی رَمَضان۔ (بخاری ۲۰۰۶۔ مسلم ۱۳۱)","Sahih","Musannaf Ibn Abi Shaybah 9470","","","كتاب الصيام"
"9471","(۹۴۷۱) حَدَّثَنَا زَیْدُ بْنُ حُبابٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ طَاووسٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَصُومُ قَبْلَہُ وَبَعْدَہُ یَوْمًا ، مَخَافَۃَ أَنْ یَفُوتَہُ۔","","Musannaf Ibn Abi Shaybah 9471","","","كتاب الصيام"
"9472","(۹۴۷۲) حَدَّثَنَا وَکِیعُ بْنُ الجَّرَاح ، عَنْ حَاجِبِ بْن عُمَرَ ، عَنِ الحَکَم بْن الأَعْرَجِ ، قَالَ : انْتَہیتُ إِلی ابْنِ عَبَّاسٍ وَہُو مُتَوسِّدٌ رِدَائَہ فِی زَمزَم ، فَقُلتُ : أَخْبِرنِی عَنْ صَومِ عَاشورائَ ؟ فَقَالَ : إِذَا رَأَیْتَ ہِلالَ الْمُحَرَّم فاعْدُدْ، وَأَصبِحْ صَائِماً التَاسِع ، قُلْتُ : ہَکَذَا کَانَ مُحَمَّدٌ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَصُومُہُ ؟ قَالَ : نَعَمْ۔n(مسلم ۱۳۲۔ ترمذی ۷۵۴)","Sahih","Musannaf Ibn Abi Shaybah 9472","","","كتاب الصيام"
"9473","(۹۴۷۳) حَدَّثَنَا وَکِیعُ بْنُ الجَّرَاح ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ القَاسِم بْنِ عَبَّاسٍ ، عَنْ عَبْدِ اللہ بْنِ عُمَیرٍ ، عَنِ ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَئِن بَقَیتُ إِلی قَابِلٍ لأَصُومَنَّ التَاسِعَ ، یَعنی یَوْمَ عَاشوراء ۔ (مسلم ۱۳۳۔ احمد ۲۲۴)","Sahih","Musannaf Ibn Abi Shaybah 9473","","","كتاب الصيام"
"9474","(۹۴۷۴) حَدَّثَنَا عَبْدُ الْوَہَّاب ، عَنْ أَیوب ، عَنْ أَبِی سُلَیْمان مَوْلَی یَحْیَی بْنِ یَعْمَُرَ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ یَقُولُ : یَوْمَ عَاشوراء صَبِیحتُہُ تَاسِعۃَ لَیْلَۃَ عَشْرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 9474","","","كتاب الصيام"
"9475","(۹۴۷۵) حَدَّثَنَا وَکِیعٌ ، وَابن نُمَیْرٍ ، عَنْ سَلِمَۃَ ، عَنِ الضَّحَّاک ، قَالَ : عَاشورائُ یَوْمُ التَّاسِع۔","","Musannaf Ibn Abi Shaybah 9475","","","كتاب الصيام"
"9476","(۹۴۷۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ قَالاَ : عَاشُورَائُ یَوْمُ الْعَاشِرِ۔","","Musannaf Ibn Abi Shaybah 9476","","","كتاب الصيام"
"9477","(۹۴۷۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ ، وَعِکْرِمَۃَ قَالُوا : عَاشُورَائُ یَوْمُ الْعَاشِرِ۔","","Musannaf Ibn Abi Shaybah 9477","","","كتاب الصيام"
"9478","(۹۴۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : یَوْمُ الْعَاشِرِ۔","","Musannaf Ibn Abi Shaybah 9478","","","كتاب الصيام"
"9479","(۹۴۷۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْجُرَیْرِیِّ ، عَنِ الْحَکَمِ بْنِ الأَعْرَجِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : ہُوَ یَوْمُ التَّاسِعِ۔","Sahih","Musannaf Ibn Abi Shaybah 9479","","","كتاب الصيام"
"9480","(۹۴۸۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنِی ابْنُ أَبِی ذِئْبٍ ، عَنْ شُعْبَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یَصُومُ یَوْمَ عَاشُورَائَ فِی السَّفَرِ ، وَیُوَالِی بَیْنَ الْیَوْمَیْنِ مَخَافَۃَ أَنْ یَفُوتَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 9480","","","كتاب الصيام"
"9481","(۹۴۸۱) حَدَّثَنَا یَزِیدُ ، عَنِ الْجُرَیْرِیِّ ، عَنِ الْحَسَنِ ، قَالَ : عَاشُورَائُ یَوْمُ الْعَاشِرِ۔","","Musannaf Ibn Abi Shaybah 9481","","","كتاب الصيام"
"9482","(۹۴۸۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ زِیَادِ بْنِ عِلاَقَۃَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، عَنْ عَائِشَۃَ قَالَتْ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُقَبِّلُ فِی شَہْرِ الصَّوْمِ۔ (مسلم ۷۷۸۔ ابوداؤد ۲۳۷۵)","Sahih","Musannaf Ibn Abi Shaybah 9482","","","كتاب الصيام"
"9483","(۹۴۸۳) حَدَّثَنَا شَرِیکٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ قَالَتْ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُقَبِّلُ بَعْضَ نِسَائِہِ وَہُوَ صَائِمٌ ، فَضَحِکَتْ ، فَظَنَنَّا أَنَّہَا ہِیَ۔ (مسلم ۶۹)","Hasan","Musannaf Ibn Abi Shaybah 9483","","","كتاب الصيام"
"9484","(۹۴۸۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَد ، وَعَلْقَمَۃَ ، عَنْ عَائِشَۃَ قَالَتْ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُقَبِّلُ وَہُوَ صَائِمٌ ، وَیُبَاشِرُ وَہُوَ صَائِمٌ ، وَلَکِنَّہُ کَانَ أَمْلَکَکُمْ لأرْبہِ۔ (بخاری ۱۹۲۷۔ مسلم ۶۸)","Sahih","Musannaf Ibn Abi Shaybah 9484","","","كتاب الصيام"
"9485","(۹۴۸۵) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ قَابُوسَ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، قَالَ : لاَ بَأْسَ بِالْقُبْلَۃِ لِلصَّائِمِ۔","Da'if","Musannaf Ibn Abi Shaybah 9485","","","كتاب الصيام"
"9486","(۹۴۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ اللہِ بْنِ مُبَشِّرٍ ، عَنْ زَیْدٍ أَبِی عَتَّاب ، قَالَ : سُئِلَ سَعْدٌ عَنِ الْقُبْلَۃِ لِلصَّائِمِ ؟ فَقَالَ: إنِّی لآخذْتہُ مِنْہَا وَأَنَا صَائِمٌ۔","","Musannaf Ibn Abi Shaybah 9486","","","كتاب الصيام"
"9487","(۹۴۸۷) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ خَالِدٍ الْحَذَّائِ ، عَنْ أَبِی الْمُتَوَکِّلِ ، عَنْ أَبِی سَعِیدٍ ؛ أَنَّہُ سُئِلَ عَنِ الْقُبْلَۃِ لِلصَّائِمِ ؟ فَقَالَ : لاَ بَأْسَ بِہَا ، مَا لَمْ یَعْدُ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 9487","","","كتاب الصيام"
"9488","(۹۴۸۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عن أَبِی الضُّحَی ، عَنْ شُتَیْرِ بْنِ شَکَلٍ ، عَنْ حَفْصَۃَ بِنْتِ عُمَرَ قَالَتْ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُقَبِّلُ وَہُوَ صَائِمٌ۔ (مسلم ۷۷۹۔ طبرانی ۳۹۳)","Sahih","Musannaf Ibn Abi Shaybah 9488","","","كتاب الصيام"
"9489","(۹۴۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ بْنِ یَحْیَی ، عَنْ عَبْدِ اللہِ بْنِ فَرُّوخَ ، عَنْ أُمِّ سَلَمَۃَ قَالَتْ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُقَبِّلُنِی وَأَنَا صَائِمَۃٌ ، وَہُوَ صَائِمٌ۔ (طبرانی ۶۵۴۔ احمد ۶/۳۲۰)","Hasan","Musannaf Ibn Abi Shaybah 9489","","","كتاب الصيام"
"9490","(۹۴۹۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ حَبِیبِ بْنِ شِہَابٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : سُئِلَ عَنِ الْقُبْلَۃِ لِلصَّائِمِ ؟ فَقَالَ : إنِّی أُحِبّ أَنْ أَرفَّ شفَتَیْہَا وَأَنَا صَائِمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 9490","","","كتاب الصيام"
"9491","(۹۴۹۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ زَیْنَبَ بِنْتِ أُمِّ سَلَمَۃَ ، عَنْ أُمِّ سَلَمَۃَ قَالَتْ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُقَبِّلُہَا وَہُوَ صَائِمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 9491","","","كتاب الصيام"
"9492","(۹۴۹۲) حَدَّثَنَا حَفْصٌ، عَنْ عَبْدِالْمَلِکِ، عَنْ عَطَائٍ، عَنِ ابْنِ عَبَّاسٍ؛ أَنَّہُ سُئِلَ عَنِ الْقُبْلَۃِ لِلصَّائِمِ؟ فَقَالَ: لاَ بَأْسَ بِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 9492","","","كتاب الصيام"
"9493","(۹۴۹۳) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنْ مُوَرِّقٍ ، قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ عَنِ الْقُبْلَۃِ لِلصَّائِمِ ؟ فَرَخَّصَ فِیہَا۔","Sahih","Musannaf Ibn Abi Shaybah 9493","","","كتاب الصيام"
"9494","(۹۴۹۴) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : سَأَلْتُ عِکْرِمَۃَ ، وَالشَّعْبِیَّ عَنِ الْقُبْلَۃِ وَالْمُبَاشَرَۃِ لِلصَّائِمِ ؟ فَرَخَّصَا فِیہِمَا۔","","Musannaf Ibn Abi Shaybah 9494","","","كتاب الصيام"
"9495","(۹۴۹۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنِ الْقُبْلَۃِ لِلصَّائِمِ ؟ فَقَالَ : لاَ بَأْسَ بِہَا ، وَإِنَّہَا لَبَرِیدُ سُوئٍ۔","","Musannaf Ibn Abi Shaybah 9495","","","كتاب الصيام"
"9496","(۹۴۹۶) حَدَّثَنَا وَکِیعٌ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ اللہِ بْنِ جُمَیْعٍ ، قَالَ : سَأَلْتُ أبا سَلَمَۃَ عَنِ الْقُبْلَۃِ لِلصَّائِمِ ؟ فَقَالَ : إنِّی لأُقَبِّلُ الْکَلْبِیَّۃَ وَأَنَا صَائِمٌ۔","","Musannaf Ibn Abi Shaybah 9496","","","كتاب الصيام"
"9497","(۹۴۹۷) حَدَّثَنَا وَکِیعٌ، عَنْ زَکَرِیَّا، عَنِ الْعَبَّاسِ بْنِ ذُرَیْحٍ ، عَنْ عَامِرٍ ، عَنْ مُحَمَّدِ بْنِ الأَشْعَثِ ، عَنْ عَائِشَۃَ قَالَتْ: کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ یَمْتَنِعُ مِنْ وَجْہِی وَأَنَا صَائِمَۃٌ۔ (احمد ۶/۲۱۳)","Sahih","Musannaf Ibn Abi Shaybah 9497","","","كتاب الصيام"
"9498","(۹۴۹۸) حَدَّثَنَا شَبَابَۃُ ، عَنْ لَیْثٍ ، عَنْ بُکَیْرِ بْنِ الأَشَجِّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ سَعِیدٍ الأَنْصَارِیِّ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ ، قَالَ : ہَشَشْتُ إلَی الْمَرْأَۃِ فَقَبَّلْتُہَا وَأَنَا صَائِمٌ ، قَالَ : فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَرَأَیْتَ لَوْ تَمَضْمَضْتَ بِمَائٍ وَأَنْتَ صَائِمٌ ؟ قَالَ : قُلْتُ : لاَ بَأْسَ ، قَالَ : فَفِیمَ ؟ (ابوداؤد ۲۳۷۷۔ احمد ۱/۵۲)","Sahih","Musannaf Ibn Abi Shaybah 9498","","","كتاب الصيام"
"9499","(۹۴۹۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ قَالَ : حَدَّثَنَا سَعِیدُ بْنُ مَرْدانبۃ ، عَنْ أَبِی کَثِیرٍ ، عَنْ أُمِّ سَلَمَۃَ زَوْجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہَا قَالَتْ لَہُ : لَوْ دَنَوْت ، لَوْ قَبَّلْت ، وَکَانَ تَزَوَّجَ فِی رَمَضَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 9499","","","كتاب الصيام"
"9500","(۹۵۰۰) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَبِی بَکْرٍ بْنِ مُحَمَّدٍ ، عَنْ عَبْدِ اللہِ بْنِ عُبَیْدِ اللہِ بْنِ عُمَرَ؛ أنَّ عَاتِکَۃَ بِنْتَ زَیْدٍ امْرَأَۃَ عُمَرَ بْنِ الْخَطَّابِ قَبَّلَتْہُ وَہُوَ صَائِمٌ ، فَلَمْ یَنْہَہَا۔","","Musannaf Ibn Abi Shaybah 9500","","","كتاب الصيام"
"9501","(۹۵۰۱) حَدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ أَبِیہِ ، عَنِ الشَّعْبِیِّ ، عَنْ مُسْلِمِ بْنِ حَیَّانَ ، عَنْ مَسْرُوقٍ ؛ فِی الْقُبْلَۃِ لِلصَّائِمِ ، فَقَالَ : مَا أُبَالِی قَبَّلْتُہَا ، أَوْ قَبَّلْتُ یَدِی۔","","Musannaf Ibn Abi Shaybah 9501","","","كتاب الصيام"
"9502","(۹۵۰۲) حَدَّثَنَا وَکِیعٌ، عَنِ ابْنِ أَبِی ذِئْبٍ، عَنِ الزُّہْرِیِّ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ؛ أَنَّ عُمَرَ نَہَی عَنِ الْقُبْلَۃِ لِلصَّائِمِ۔","Sahih","Musannaf Ibn Abi Shaybah 9502","","","كتاب الصيام"
"9503","(۹۵۰۳) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عُبَیْدِ بْنِ عَمْرٍو قَالَ : قَالَ رَجُلٌ لِعَلِیٍّ : أَیُقَبِّلُ الرَّجُلُ امْرَأَتَہُ وَہُوَ صَائِمٌ ؟ فَقَالَ عَلِیٌّ : وَمَا إرْبُکَ إلَی خُلُوفِ فَمِ امْرَأَتِکَ ؟","Da'if","Musannaf Ibn Abi Shaybah 9503","","","كتاب الصيام"
"9504","(۹۵۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنِ الْہَزْہَازِ ؛ أَنَّ رَجُلاً لَقِیَ ابْنَ مَسْعُودٍ وَہُوَ بِالتَّمَّارِینِ ، فَسَأَلَہُ عَنْ صَائِمٍ قَبَّلَ ؟ فَقَالَ : أَفْطَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 9504","","","كتاب الصيام"
"9505","(۹۵۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، عَنْ زَاذَانَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : أَفَلا تُقَبِِّل جَمْرَۃ ؟","Sahih","Musannaf Ibn Abi Shaybah 9505","","","كتاب الصيام"
"9506","(۹۵۰۶) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنْ مُوَرِّق قَالَ : سَأَلتُ ابْنَ عُمَرَ عَنِ الْقُبْلَۃِ لِلصَّائِمِ ؟ فَنَہَی عَنْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 9506","","","كتاب الصيام"
"9507","(۹۵۰۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یُقَبِّلَ الرَّجُلُ امْرَأَتَہُ وَہُوَ صَائِمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 9507","","","كتاب الصيام"
"9508","(۹۵۰۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : سَأَلْتُ ابْنَ مُغَفَّلٍ ؟ فَکَرِہَہَا۔","","Musannaf Ibn Abi Shaybah 9508","","","كتاب الصيام"
"9509","(۹۵۰۹) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ (ح) وَجَرِیرٌ ، وَوَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، کِلاَہُمَا عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ، قَالَ : سُئِلَ عَنِ الْقُبْلَۃِ لِلصَّائِمِ ؟ فَقَالَ : یَتَّقِی اللَّہَ وَلاَ یَعُودُ۔","","Musannaf Ibn Abi Shaybah 9509","","","كتاب الصيام"
"9510","(۹۵۱۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّہُ قَالَ فِی الْقُبْلَۃِ لِلصَّائِمِ: یَنْقُصُ صِیَامہُ ، وَلاَ یُفْطِرُ بِہَا۔","","Musannaf Ibn Abi Shaybah 9510","","","كتاب الصيام"
"9511","(۹۵۱۱) حَدَّثَنَا شَبَابَۃُ ، عَنْ ہِشَامِ بْنِ الْغَازِ ، قَالَ : سَمِعْتُ مَکْحُولاً ، وَأَتَاہُ رَجُلٌ شَابٌّ ، فَقَالَ : إنِّی أُقَبِّلُ فِی شَہْرِ رَمَضَانَ وَأَنَا صَائِمٌ ، فَقَالَ : یَا بُنَیَّ ، أَمَّا أَنَا فَأَفْعَلُ ذَلِکَ ، وَأَمَّا أَنْتَ فَلاَ تَفْعَلْہُ۔","","Musannaf Ibn Abi Shaybah 9511","","","كتاب الصيام"
"9512","(۹۵۱۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ ابْنِ شُبْرُمَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : الْقُبْلَۃُ تَنْقُضُ الْوُضُوئَ ، وَتَجْرَحُ الصَّوْمَ۔","","Musannaf Ibn Abi Shaybah 9512","","","كتاب الصيام"
"9513","(۹۵۱۳) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ، عَنْ حَبِیبٍ، قَالَ: سَأَلْتُ أَبَا قِلاَبَۃَ عَنِ الْقُبْلَۃِ لِلصَّائِمِ ؟ قَالَ: لاَ تُقَبِّلْ وَأَنْتَ صَائِمٌ۔","","Musannaf Ibn Abi Shaybah 9513","","","كتاب الصيام"
"9514","(۹۵۱۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ؛ أَنَّہُ سُئِلَ عَنِ الْقُبْلَۃِ لِلصَّائِمِ ؟ فَقَالَ : مَا تَصْنَعُ بِخُلُوفِ فِیہَا ؟","","Musannaf Ibn Abi Shaybah 9514","","","كتاب الصيام"
"9515","(۹۵۱۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ یَکْرَہُ الْقُبْلَۃَ لِلصَّائِمِ۔","Sahih","Musannaf Ibn Abi Shaybah 9515","","","كتاب الصيام"
"9516","(۹۵۱۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُمَرِ بْنِ حَمْزَۃَ ، قَالَ : أَخْبَرَنِی سَالِمٌ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ عُمَر : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْمَنَامِ ، فَرَأَیْتُہُ لاَ یَنْظُرْنِی ، فَقُلْتُ : یَا رَسُولَ اللہِ ، مَا شَأْنِی ؟ فَقَالَ : أَلَسْتَ الَّذِی تُقَبِّلُ وَأَنْتَ صَائِمٌ ؟ قَالَ : فَوَالَّذِی بَعَثَکَ بِالْحَقِّ ، لاَ أُقَبِّلُ بَعْدَہَا وَأَنَا صَائِمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 9516","","","كتاب الصيام"
"9517","(۹۵۱۷) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سَالِمِ بْنِ أَبِی حَفْصَۃَ ، عَنْ أَبِی یَعْلَی ، عَنْ مُحَمَّدِ بْنِ الْحَنَفِیَّۃِ ، قَالَ : إنَّمَا الصَّوْمُ مِنَ الشَّہْوَۃِ ، وَالْقُبْلَۃُ مِنَ الشَّہْوَۃِ۔","","Musannaf Ibn Abi Shaybah 9517","","","كتاب الصيام"
"9518","(۹۵۱۸) حَدَّثَنَا شَبَابَۃُ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ ثَعْلَبَۃَ بْنِ عَبْدِ اللہِ بْنِ أَبِی صُعَیْرٍ ، قَالَ : رَأَیْتُ أَصْحَابَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُمْ یَنْہَوْنَ عَنِ الْقُبْلَۃِ لِلصَّائِمِ۔","Sahih","Musannaf Ibn Abi Shaybah 9518","","","كتاب الصيام"
"9519","(۹۵۱۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ زَیْدِ بْنِ جُبَیْرٍ ، عَنْ أَبِی یَزِیدَ الضَّنِّی ، عَنْ مَیْمُونَۃَ مَوْلاَۃِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سُئِلَ عَنْ صَائِمٍ قَبَّلَ ؟ فَقَالَ : أَفْطَرَ۔ (احمد ۶/۴۶۳۔ طبرانی ۵۷)","Da'if","Musannaf Ibn Abi Shaybah 9519","","","كتاب الصيام"
"9520","(۹۵۲۰) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ إبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، عَنْ أَبِیہِ ، عَنْ مَسْرُوقٍ ؛ أَنَّہُ سُئِلَ عَنِ الْقُبْلَۃِ لِلصَّائِمِ ؟ فَقَالَ : اللَّیْلُ قَرِیبٌ۔","","Musannaf Ibn Abi Shaybah 9520","","","كتاب الصيام"
"9521","(۹۵۲۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، وَالأَسْوَد ، عَنْ عَائِشَۃَ قَالَتْ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُبَاشِرُ وَہُوَ صَائِمٌ ، وَلَکِنَّہُ کَانَ أَمْلَکَکُمْ لأَرْبِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 9521","","","كتاب الصيام"
"9522","(۹۵۲۲) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ سَالِمٍ الأَوْسِیِّ ، قَالَ : قَالَ رَجُلٌ لِسَعْدٍ : یَا أَبَا إِسْحَاقَ ، أَتُبَاشِرُ وَأَنْتَ صَائِمٌ ؟ قَالَ : نَعَمْ ، وَآخُذُ بِجَہَازِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 9522","","","كتاب الصيام"
"9523","(۹۵۲۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہر ، ووَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، عَنْ أَبِی مَیْسَرَۃَ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : کَانَ یُبَاشِرُ امْرَأَتَہُ بِنِصْفِ النَّہَارِ وَہُوَ صَائِمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 9523","","","كتاب الصيام"
"9524","(۹۵۲۴) حَدَّثَنَا حَفْصٌ ، عَنْ دَاوُدَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَعْرَابِیٌّ أَتَاہُ فَسَأَلَہُ ؟ فَرَخَّصَ لَہُ فِی الْقُبْلَۃِ وَالْمُبَاشَرَۃِ وَوَضْعِ الْیَدِ ، مَا لَمْ یَعْدُہ إلَی غَیْرِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 9524","","","كتاب الصيام"
"9525","(۹۵۲۵) حَدَّثَنَا وَکِیعٌ، عَنْ أَبِی مَکِینٍ، عَنْ عِکْرِمَۃَ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: لاَ بَأْسَ لِلشَّیْخِ أَنْ یُبَاشِرَ، یَعْنِی وَہُوَ صَائِمٌ۔","Hasan","Musannaf Ibn Abi Shaybah 9525","","","كتاب الصيام"
"9526","(۹۵۲۶) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : سَأَلْتُ عِکْرِمَۃَ ، وَالشَّعْبِیَّ عَنِ الْمُبَاشَرَۃِ ؟ فَرَخَّصَا فِیہَا ، وَسَأَلْتُ ابْنَ مُغَفَّلٍ ؟ فَکَرِہَہَا۔","","Musannaf Ibn Abi Shaybah 9526","","","كتاب الصيام"
"9527","(۹۵۲۷) حَدَّثَنَا عَبْدَۃ بْنُ سُلَیْمَانَ ، عَنْ مُجَالِدٍ ، عَنْ وَبَرَۃَ ، قَالَ : جَائَ رَجُلٌ إلَی ابْنِ عُمَرَ ، فَقَالَ : أُبَاشِرُ امْرَأَتِی وَأَنَا صَائِمٌ ؟ فَقَالَ : لاَ ، ثُمَّ جَائَ آخَرُ ، فَقَالَ : أُبَاشِرُ امْرَأَتِی وَأَنَا صَائِمٌ ؟ قَالَ : نَعَمْ ، فَقِیلَ لَہُ : یَا أَبَا عَبْدِ الرَّحْمَنِ ، قُلْتَ لِہَذَا نَعَمْ ، وَقُلْتَ لِہَذَا لاَ ؟ فَقَالَ : إنَّ ہَذَا شَیْخٌ وَہَذَا شَابٌّ۔","Da'if","Musannaf Ibn Abi Shaybah 9527","","","كتاب الصيام"
"9528","(۹۵۲۸) حَدَّثَنَا حَفْصٌ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : قِیلَ لِاِبْنِ عَبَّاسٍ : الْمُبَاشَرَۃُ ؟ قَالَ : أَعِفُّوا صَوْمَکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 9528","","","كتاب الصيام"
"9529","(۹۵۲۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَکْرَہُ الْقُبْلَۃَ وَالْمُبَاشَرَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 9529","","","كتاب الصيام"
"9530","(۹۵۳۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، قَالَ : أَخْبَرَنَا حَنْظَلَۃُ بْنُ سَبْرَۃَ بْنِ الْمُسَیَّبِ بْنِ نَجَبَۃَ الْفَزَارِیِّ ، عَنْ عَمَّتِہِ جُمَانَۃَ بِنْتِ الْمُسَیَّبِ ، وَکَانَتْ عِنْدَ حُذَیْفَۃَ بْنِ الْیَمَانِ ، فَکَانَ إذَا صَلَّی الْفَجْرَ فِی رَمَضَانَ ، دَخَلَ مَعَہَا فِی لِحَافِہَا فَیُوَلِّیہَا ظَہْرَہُ لِیَسْتَدْفِئُ بِقُرْبِہَا ، وَلاَ یُقْبِلُ عَلَیْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 9530","","","كتاب الصيام"
"9531","(۹۵۳۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی الزِّنَادِ ، عَنِ الأَعْرَجِ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّہُ قَالَ : إذَا دُعِیَ أَحَدُکُمْ إلَی طَعَامٍ وَہُوَ صَائِمٌ فَلْیَقُلْ : إِنِّی صَائِمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 9531","","","كتاب الصيام"
"9532","(۹۵۳۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : دَخَلْتُ عَلَی قَیْسِ بْنِ أَبِی حَازِمٍ فَدَعَا لِی بِشَرَابٍ ، فَقَالَ : اشْرَبْ ، فَقُلْتُ : لاَ أُرِیدُ ، قَالَ : صَائِمٌ أَنْتَ ؟ قُلْتُ : نَعَمْ ، قَالَ : فَإِنِّی سَمِعْتُ عَبْدَ اللہِ یَقُولُ : إذَا عُرِضَ عَلَی أَحَدِکُمْ طَعَامٌ ، أَوْ شَرَابٌ وَہُوَ صَائِمٌ ، فَلْیَقُلْ : إنِّی صَائِمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 9532","","","كتاب الصيام"
"9533","(۹۵۳۳) حَدَّثَنَا وَکِیعٌ ، وَیَزِیدُ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا سُئِلَ أَحَدُکُمْ وَہُوَ صَائِمٌ ، فَلْیَقُلْ : إنِّی صَائِمٌ۔","","Musannaf Ibn Abi Shaybah 9533","","","كتاب الصيام"
"9534","(۹۵۳۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ ابْنُ عُمَرَ إذَا دُعِیَ إلَی طَعَامٍ وَہُوَ صَائِمٌ أَجَابَ ، فَإِذَا جَاؤُوا بِالْمَائِدَۃِ وَعَلَیْہَا الطَّعَامُ مَدَّ یَدَہُ ، ثُمَّ قَالَ : خُذُوا بِسْمِ اللہِ ، فَإِذَا أَہْوَی الْقَوْمُ کَفَّ یَدَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 9534","","","كتاب الصيام"
"9535","(۹۵۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : إذَا عُرِضَ عَلَی أَحَدِکُمْ طَعَامٌ ، أَوْ شَرَابٌ وَہُوَ صَائِمٌ فَلْیَقُلْ : إنِّی صَائِمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 9535","","","كتاب الصيام"
"9536","(۹۵۳۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، قَالَ : أُتِیَ أَنَسٌ بِطَعَامٍ ، فَقَالَ لِی : اُدْنُ ، فَقُلْتُ : لاَ أَطْعَمُ ، فَقَالَ : ما : لاَ أَطْعَمُ ؟ قُلْ : إنِّی صَائِمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 9536","","","كتاب الصيام"
"9537","(۹۵۳۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی الْمُہَزِّمِ ، قَالَ : قَالَ أَبُو ہُرَیْرَۃَ : إذَا سُئِلَ أَحَدُکُمْ : صَائِمٌ أَنْتَ ؟ فَلْیَقُلْ : إنِّی صَائِمٌ ، فَأَمَّا الْمُؤْمِنُ فَیَدْعُو لَہُ بِخَیْرٍ ، وَأَمَّا الْمُنَافِقُ فَیَقُولُ : مُرَائِی۔","Da'if","Musannaf Ibn Abi Shaybah 9537","","","كتاب الصيام"
"9538","(۹۵۳۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا عِمْرَانُ بْنُ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : دَخَلْتُ عَلَیْہِ وَہُوَ یَأْکُلُ ، فَقَالَ : اُدْنُ فَکُلْ ، قَالَ : قُلْتُ : إنِّی صَائِمٌ ، قَالَ : فَلَعَلَّک مِمَّنْ یَزْعُمُ أَنَّہُ صَائِمٌ وَلَیْسَ بِصَائِمٍ ، قُلْتُ : سُبْحَانَ اللہِ ، قَالَ : قَدْ کَانَ مَنْ ہُوَ خَیْرٌ مِنْک یَصُومُ ثَلاَثَۃَ أَیَامٍ مِنْ کُلِّ شَہْرٍ ، ثُمَّ یَقُولُ : إنِّی صَائِمٌ۔","","Musannaf Ibn Abi Shaybah 9538","","","كتاب الصيام"
"9539","(۹۵۳۹) حَدَّثَنَا أَبُو الأَحْوَصِِ سَلاَّمُ بْنِ سُلَیْمٍ ، عَنْ أَبِی إِسْحَاقَ، قَالَ: رَأَیْتُ الشَّعْبِیَّ یَدْخُلُ الْحَمَّامَ وَہُوَ صَائِمٌ۔","","Musannaf Ibn Abi Shaybah 9539","","","كتاب الصيام"
"9540","(۹۵۴۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَاصِمٍ ، قَالَ : سَأَلْتُ أَبَا الْعَالِیَۃِ : أَدْخُلُ الْحَمَّامَ وَأَنَا صَائِمٌ ؟ قَالَ : أَتُحِبُّ أَنْ تَنْظُرَ إلَی عَوْرتکَ وَأَنْتَ صَائِمٌ ؟ قَالَ : قُلْتُ : أَدْخُلُ الْحَمَّامَ بِمِئْزَرٍ ؟ قَالَ : أَتُحِبُّ أَنْ تَنْظُرَ إلَی عَوْرَۃِ غَیْرِکَ وَأَنْتَ صَائِمٌ ؟ قَالَ : قُلْتُ : لاَ۔","","Musannaf Ibn Abi Shaybah 9540","","","كتاب الصيام"
"9541","(۹۵۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : لاَ تَدْخُلِ الْحَمَّامَ وَأَنْتَ صَائِمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 9541","","","كتاب الصيام"
"9542","(۹۵۴۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یَحْیَی بْنِ أَبِی إِسْحَاقَ ، قَالَ : رَأَیْتُ الْہِلاَلَ ، ہِلاَلَ الْفِطْرِ قَرِیبًا مِنْ صَلاَۃِ الظُّہْرِ ، فَأَفْطَرَ نَاسٌ ، فَأَتَیْنَا أَنَسَ بْنَ مَالِکٍ ، فَذَکَرْنَا لَہُ رُؤْیَۃَ الْہِلاَلِ وَإِفْطَارَ مَنْ أَفْطَرَ ، قَالَ : وَأَمَّا أَنَا فَمُتِمّ یَوْمِی ہَذَا إلَی اللَّیْلِ۔","Sahih","Musannaf Ibn Abi Shaybah 9542","","","كتاب الصيام"
"9543","(۹۵۴۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ؛ فِی الْہِلاَلِ یُرَی بِالنَّہَارِ : لاَ تُفْطِرُوا حَتَّی تَرَوْہُ مِنْ حَیْثُ یُرَی۔","","Musannaf Ibn Abi Shaybah 9543","","","كتاب الصيام"
"9544","(۹۵۴۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ الزِّبْرِقَانِ ، قَالَ : أَفْطَرَ النَّاسُ ، فَأَتَیْت أَبَا وَائِلٍ ، فَقُلْتُ : إنِّی رَأَیْتُ الْہِلاَلَ نِصْفَ النَّہَارِ ، فَقَالَ : {أَتِمُّوا الصِّیَامَ إلَی اللَّیْلِ}۔","","Musannaf Ibn Abi Shaybah 9544","","","كتاب الصيام"
"9545","(۹۵۴۵) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ؛ أَنَّ النَّاسَ رَأَوْا ہِلاَلَ الْفِطْرِ حِینَ زَاغَتِ الشَّمْسُ ، فَأَفْطَرَ بَعْضُہُمْ ، فَذَکَرْتُ ذَلِکَ لِسَعِیدِ بْنِ الْمُسَیَّبِ ، فَقَالَ : رَآہُ النَّاسُ فِی زَمَنِ عُثْمَانَ فَأَفْطَرَ بَعْضُہُمْ ، فَقَامَ عُثْمَانُ فَقَالَ : أَمَّا أَنَا فَمُتِمّ صِیَامِی إلَی اللَّیْلِ ، قَالَ : وَرُئِیَ فِی زَمَنِ مَرْوَانَ ، فَتَوَعَّدَ مَرْوَانُ مَنْ أَفْطَرَ ، قَالَ سَعِیدٌ : فَأَصَابَ مَرْوَانُ۔","Hasan","Musannaf Ibn Abi Shaybah 9545","","","كتاب الصيام"
"9546","(۹۵۴۶) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : قَالَ عَبْدُ اللہِ : إذَا رَأَیْتُمُ الْہِلاَلَ نَہَارًا فَلاَ تُفْطِرُوا ، فَإِنَّ مَجْرَاہُ فِی السَّمَائِ ، لَعَلَّہُ أَنْ یَکُونَ أَہَلَّ سَاعَتئذ۔","","Musannaf Ibn Abi Shaybah 9546","","","كتاب الصيام"
"9547","(۹۵۴۷) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُطَرِّفٍ ، عَنْ أَبِی الْحَسَنِ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا رَأَیْتُمُ الْہِلاَلَ أَوَّلَ النَّہَارِ فَلاَ تُفْطِرُوا ، وَإِذَا رَأَیْتُمُوہُ مِنْ آخِرِ النَّہَارِ فَأَفْطِرُوا۔","Da'if","Musannaf Ibn Abi Shaybah 9547","","","كتاب الصيام"
"9548","(۹۵۴۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ سُفْیَانَ ، عَنِ الرُّکَیْنِ ، عَنْ أَبِیہِ ، قَالَ : کُنَّا مَعَ سَلْمَانَ بْنِ رَبِیعَۃَ بِبَلنْجَرَ ، فَرَأَیْنَا ہِلاَلَ شَوَّالٍ یَوْمَ تِسْعٍ وَعِشْرِینَ ضُحًی ، فَقَالَ : أَرِنِیہِ ، فَأَرَیْتُہُ ، فَأَمَرَ النَّاسَ فَأَفْطَرُوا۔","Sahih","Musannaf Ibn Abi Shaybah 9548","","","كتاب الصيام"
"9549","(۹۵۴۹) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ عُمَرَ بْنِ فَرُّوخَ ، عَنْ صَالِحٍ الدَّہَّانِ ، قَالَ : رُئِیَ الْہِلاَلُ آخِرَ رَمَضَانَ نَہَارًا ، فَوَقَعَ النَّاسُ فِی الطَّعَامِ وَالشَّرَابِ ، وَنَفَرٌ مِنَ الأَزْدِ مُعْتَکِفِینَ ، فَقَالُوا : یَا صَالِحُ ، أَنْتَ رَسُولُنَا إلَی جَابِرِ بْنِ زَیْدٍ ، فَأَتَیْتُ جَابِرَ بْنَ زَیْدٍ فَذَکَرْت ذَلِکَ لَہُ ، فَقَالَ : أَنْتَ مِمَّنْ رَأَیْتَہُ ؟ قُلْتُ : نَعَمْ ، قَالَ : أَبَیْنَ یَدَیِ الشَّمْسِ رَأَیْتَہُ ، أَمْ رَأَیْتَہُ خَلْفَہَا ؟ قُلْتُ : لاَ ، بَیْنَ یَدَیْہَا ، قَالَ : فَإِنَّ یَوْمَکُمْ ہَذَا مِنْ رَمَضَانَ ، إنَّمَا رَأَیْتُمُوہُ فِی مَسِیرِہِ ، فَمُرْ أَصْحَابَک یُتِمُّونَ صَوْمَہُمْ وَاعْتِکَافَہُمْ۔","","Musannaf Ibn Abi Shaybah 9549","","","كتاب الصيام"
"9550","(۹۵۵۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عُتْبَۃُ بْنُ فَرْقَدٍ غَائِبًا بِالسَّوَادِ ، فَأَبْصَرُوا الْہِلاَلَ مِنْ آخِرِ النَّہَارِ ، فَأَفْطَرُوا ، فَبَلَغَ ذَلِکَ عُمَرَ ، فَکَتَبَ إلَیْہِ : إِنَّ الْہِلاَلَ إذَا رُئِیَ مِنْ أَوَّلِ النَّہَارِ ، فَإِنَّہُ لِلْیَوْمِ الْمَاضِی ، فَأَفْطِرُوا ، وَإِذَا رُئِیَ مِنْ آخِرِ النَّہَارِ ، فَإِنَّہُ لِلْیَوْمِ الْجَائِی فَأَتِمُّوا الصِّیَامَ۔","","Musannaf Ibn Abi Shaybah 9550","","","كتاب الصيام"
"9551","(۹۵۵۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکر ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ: کَانَ عَطَائٌ یَقُولُ: إِنْ رُئِیَ ہِلاَلُ شَوَّالٍ نَہَارًا ، فَلاَ تُفْطِرُوا، وَیَتْلُو : {ثُمَّ أَتِمُّوا الصِّیَامَ إلَی اللَّیْلِ}۔","","Musannaf Ibn Abi Shaybah 9551","","","كتاب الصيام"
"9552","(۹۵۵۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الْحَسَنِ بْنِ عُبَیدِ اللہِ ، قَالَ : رَأَیْتُ الْہِلاَلَ قَبْلَ نِصْفِ النَّہَارِ ، فَأَتَیْتُ أَبَا بُرْدَۃَ ، فَأَمَرَنِی أَنْ أُتِمَّ صَوْمِی۔","","Musannaf Ibn Abi Shaybah 9552","","","كتاب الصيام"
"9553","(۹۵۵۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی وَائِلٍ ، قَالَ : أَتَانَا کِتَابُ عُمَرَ وَنَحْنُ بِخَانقِینَ ؛ أَنَّ الأَہِلَّۃَ بَعْضُہَا أَکْبَرُ مِنْ بَعْضٍ ، فَإِذَا رَأَیْتُمُ الْہِلاَلَ نَہَارًا فَلاَ تُفْطِرُوا ، حَتَّی یَشْہَدَ رَجُلاَنِ مُسْلِمَانِ أَنَّہُمَا أَہَلاَّہُ بِالأَمْسِ۔","Sahih","Musannaf Ibn Abi Shaybah 9553","","","كتاب الصيام"
"9554","(۹۵۵۴) حَدَّثَنَا ہُشَیْمٌ ، عَنِ أَبِی بِشْرٍ ، عَنْ أَبِی عُمَیْرِ بْنِ أَنَسٍ ، قَالَ : حَدَّثَنِی عُمُومَتِی مِنَ الأَنْصَارِ قَالُوا : أُغمِیَ عَلَیْنَا ہِلاَلُ شَوَّالٍ ، فَأَصْبَحْنَا صِیاماً ، فَجَائَ رَکْبٌ آخِرَ النَّہَارِ ، فَشَہِدُوا عِنْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُمْ رَأَوُا الْہِلاَلَ بِالأَمْسِ ، فَأَمَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ النَّاسَ أَنْ یُفْطِرُوا ، وَیَخْرُجُوا إلَی عِیدِہِمْ مِنَ الْغَدِ۔ (ابوداؤد ۱۱۵۰۔ احمد ۵/۵۷)","Sahih","Musannaf Ibn Abi Shaybah 9554","","","كتاب الصيام"
"9555","(۹۵۵۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ أَبِی یَعْفُورٍ ، عَنْ أَبِیہِ ، قَالَ : رُئِیَ ہِلاَلُ رَمَضَانَ وَالْمُغِیرَۃُ بن شُعْبَۃَ عَلَی الْکُوفَۃِ ، فَلَم یَخْرُجْ حَتَّی کَانَ مِنَ الْغَدِ ، فَخَرَجَ فَخَطَبَ النَّاسَ عَلَی بَعِیرٍ ، ثُمَّ انْصَرَفَ۔","Sahih","Musannaf Ibn Abi Shaybah 9555","","","كتاب الصيام"
"9556","(۹۵۵۶) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : شُہِدَ عِنْدَ ابْنِ عُمَرَ أَنَّہُمْ رَأَوُا الْہِلاَلَ ، فَقَالَ : اُخْرُجُوا إلَی عِیدِکُمْ مِنَ الْغَدِ ، وَقَدْ مَضَی مِنَ النَّہَارِ مَا شَائَ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 9556","","","كتاب الصيام"
"9557","(۹۵۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ أَعْرَابِیًّا شَہِدَ عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی رُؤْیَۃِ الْہِلاَلِ ، فَقَالَ : أَتَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ وَأَنِّی رَسُولُ اللہِ ؟ قَالَ : نَعَمْ ، قَالَ : فَأُمِرَ النَّاسُ أَنْ یَصُومُوا۔ (ابوداؤد ۲۳۳۴۔ نسائی ۲۴۲۴)","","Musannaf Ibn Abi Shaybah 9557","","","كتاب الصيام"
"9558","(۹۵۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفیان ، عَنْ عَبْدِ الأَعْلَی ، عَنِ ابْنِ أَبِی لَیْلَی ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَجَازَ شَہَادَۃَ رَجُلٍ فِی الْہِلاَلِ۔","Da'if","Musannaf Ibn Abi Shaybah 9558","","","كتاب الصيام"
"9559","(۹۵۵۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، قَالَ : شَہِدْتُ الْمَدِینَۃَ فِی ہِلاَلِ صَوْمٍ ، أَوْ إفْطَارٍ ، فَلَمْ یَشْہَدْ عَلَی الْہِلاَلِ إِلاَّ رَجُلٌ ، فَأَمَرَہُمُ ابْنُ عُمَرَ فَقَبِلُوا شَہَادَتَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9559","","","كتاب الصيام"
"9560","(۹۵۶۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : جَائَ أَعْرَابِیٌّ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، إنِّی رَأَیْتُ الْہِلاَلَ اللَّیْلَۃَ ، قَالَ : تَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ، وَأَنَّ مُحَمَّدًا عبْدُہُ وَرَسُولُہُ ؟ قَالَ : نَعَمْ ، قَالَ : یَا بِلاَلُ ، نَادِ فِی النَّاسِ ، فَلیَصُومُوا غَدًا۔ (ترمذی ۶۹۱۔ ابوداؤد ۲۳۳)","","Musannaf Ibn Abi Shaybah 9560","","","كتاب الصيام"
"9561","(۹۵۶۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : قَدِمَ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلاَن وَافِدَان أَعْرَابِیَّان ، فَقَالَ لَہُمَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَمُسْلِمَانِ أَنْتُمَا ؟ قَالاَ : نَعَمْ ، فَقَالَ لَہُمَا : أَہْلَلْتُمَا ؟ قَالاَ : نَعَمْ ، فَأَمَرَ النَّاسَ فَفطِرُوا ، أَوْ صَامُوا۔ (دارقطنی ۱۶۷)","","Musannaf Ibn Abi Shaybah 9561","","","كتاب الصيام"
"9562","(۹۵۶۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ؛ فِی الْہِلاَلِ قَالَ : إذَا شَہِدَ رَجُلاَنِ ذَوَا عَدْلٍ عَلَی رُؤْیَۃِ الْہِلاَلِ فَأَفْطِرُوا۔","Da'if","Musannaf Ibn Abi Shaybah 9562","","","كتاب الصيام"
"9563","(۹۵۶۳) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، قَالَ : أَبَی عُثْمَانُ أَنْ یُجِیزَ شَہَادَۃَ ہَاشِمِ بْنِ عُتبۃَ ، أَوْ غَیْرِہِ ، عَلَی رُؤْیَۃِ الْہِلاَلِ۔","","Musannaf Ibn Abi Shaybah 9563","","","كتاب الصيام"
"9564","(۹۵۶۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ فِی الرَّجُلِ یَرَی الْہِلاَلَ وَحْدَہُ قَبْلَ النَّاسِ ، قَالَ : لاَ یَصُومُ إِلاَّ مَعَ النَّاسِ ، وَلاَ یُفْطِرُ إِلاَّ مَعَ النَّاسِ۔","","Musannaf Ibn Abi Shaybah 9564","","","كتاب الصيام"
"9565","(۹۵۶۵) حَدَّثَنَا الضَّحَّاکُ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ؛ فِی رَجُلٍ شَہِدَ عَلَی رُؤْیَۃِ الْہِلاَلِ وَحْدَہُ، قَالَ: لاَ یُلْتَفَتُ إلَیْہِ۔","","Musannaf Ibn Abi Shaybah 9565","","","كتاب الصيام"
"9566","(۹۵۶۶) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی وَائِلٍ ، قَالَ : کُنَّا بِخَانِقِینَ ، فَأَہْلَلْنَا ہِلاَلَ رَمَضَانَ ، فَمِنَّا مَنْ صَامَ وَمِنَّا مَنْ أَفْطَرَ ، فَأَتَانَا کِتَابُ عُمَرَ : أَنَّ الأَہِلَّۃَ بَعْضُہَا أَکْبَرُ مِنْ بَعْضٍ ، فَإِذَا رَأَیْتُمُ الْہِلاَلَ نَہَارًا فَلاَ تُفْطِرُوا ، إِلاَّ أَنْ یَشْہَدَ رَجُلاَنِ مُسْلِمَانِ أَنَّہُمَا أَہَلاَّہُ بِالأَمْسِ۔","Sahih","Musannaf Ibn Abi Shaybah 9566","","","كتاب الصيام"
"9567","(۹۵۶۷) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَمْرِو بْنِ مُہَاجِرٍ ؛ أَنَّ مُحَمَّدَ بْنَ سُوَیْد الْفِہْرِیَّ أَفْطَرَ ، أَوْ ضَحَّی قَبْلَ النَّاسِ بِیَوْمٍ ، فَکَتَبَ إلَیْہِ عُمَرُ بْنُ عَبْدِالْعَزِیزِ: مَا حَمَلَک عَلَی أَنْ أَفْطَرْت قَبْلَ النَّاسِ؟ فَکَتَبَ إلَیْہِ مُحَمَّدٌ: إِنَّہُ شَہِدَ عِنْدِی حِزَامُ بْنُ حَکِیمٍ الْقُرَشِیُّ أَنَّہُ رَأَی الْہِلاَلَ ، فَکَتَبَ إلَیْہِ عُمَرُ: أَوْ أَحَدُ النَّاسِ، أَوْ ذُو الْیَدَیْنِ: ہُوَ۔","","Musannaf Ibn Abi Shaybah 9567","","","كتاب الصيام"
"9568","(۹۵۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ؛ أَنَّ قَوْمًا شَہِدُوا عَلَی ہِلاَلِ رَمَضَانَ بَعْدَ مَا أَصْبَحَ النَّاسُ ، فَقَالَ : مَنْ لَمْ یَأْکُلْ فَلْیُتِمَّ صَوْمَہُ ، وَمَنْ أَکَلَ فَلْیَصُمْ بَقِیَّۃَ یَوْمِہِ۔","","Musannaf Ibn Abi Shaybah 9568","","","كتاب الصيام"
"9569","(۹۵۶۹) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : أَرَأَیْتَ إِنْ أَصْبَحَ أَہْلُ مَکَّۃَ مُفْطِرِینَ ، أَوْ رَجُلٌ ، أَوْ رَجُلاَنِ ، ثُمَّ جَائَہُمْ أَنْ قَدْ رُئِیَ الْہِلاَلُ ، فَجَائَہُمُ الْخَبَرُ بِذَلِکَ مِنْ أَوَّلِ النَّہَارِ ، أَوْ مِنْ آخِرِ النَّہَارِ، کَانُوا یَصُومُونَ بَقِیَّۃَ یَوْمِہِمْ ، أَوْ یَقْضُونَہُ بَعْدُ ؟ قَالَ : یَأْکُلُونَ وَیَشْرَبُونَ إِنْ شَاؤُوا ، وَلَمْ یُوجِبْ عَلَیْہِمْ أَنْ یَصُومُوا بَقِیَّتہ۔","","Musannaf Ibn Abi Shaybah 9569","","","كتاب الصيام"
"9570","(۹۵۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا أَمْنَی الصَّائِمُ فَقَدْ أَفْطَرَ۔","","Musannaf Ibn Abi Shaybah 9570","","","كتاب الصيام"
"9571","(۹۵۷۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا أَمْنَی الصَّائِمُ أَفْطَرَ ، قُلْتُ : یُکَفِّرُ کَفَّارَۃَ الْمَنِیِّ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 9571","","","كتاب الصيام"
"9572","(۹۵۷۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا قَبَّلَ ، أَوْ لَمَسَ وَہُوَ صَائِمٌ فَأَمْنَی ، فَہُوَ بِمَنْزِلَۃِ الْمُجَامِعِ۔","","Musannaf Ibn Abi Shaybah 9572","","","كتاب الصيام"
"9573","(۹۵۷۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ عَنْ رَجُلٍ نَظَرَ إلَی امْرَأَتِہِ فِی رَمَضَانَ ، فَأَمْنَی مِنْ شَہْوَتِہَا ، ہَلْ یُفْطِرُ ؟ قَالَ : لاَ ، وَیُتِمُّ صَوْمَہُ۔","","Musannaf Ibn Abi Shaybah 9573","","","كتاب الصيام"
"9574","(۹۵۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ فِی الصَّائِمِ یُلاَعِبُ امْرَأَتَہُ حَتَّی یُمْذِیَ ، أَوْ یُودِیَ ، قَالَ : لاَ یُوجِبُ عَلَیْہِ الْقَضَائَ إِلاَّ مَا أَوْجَبَ عَلَیْہِ الْغُسْلَ۔","","Musannaf Ibn Abi Shaybah 9574","","","كتاب الصيام"
"9575","(۹۵۷۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إِنْ أَمْنَی الصَّائِمُ أَفْطَرَ۔","","Musannaf Ibn Abi Shaybah 9575","","","كتاب الصيام"
"9576","(۹۵۷۶) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، قَالَ مَرَّۃً : عَنِ ابْنِ عَبَّاسٍ (ح) وَعَنْ حُرَیْثٍ ، عَنِ الشَّعْبِیِّ، قَالاَ : إِنْ کَانَ لِغَیْرِ الصَّلاَۃِ قَضَی ، وَإِنْ کَانَ لِلصَّلاَۃِ فَلاَ قَضَائَ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 9576","","","كتاب الصيام"
"9577","(۹۵۷۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ : إذَا مَضْمَضَ وَہُوَ صَائِمٌ ، فَدَخَلَ حَلْقَہُ شَیْئٌ لَمْ یَتَعَمَّدْہُ فَلَیْسَ عَلَیْہِ شَیْئٌ ، یُتِمُّ صَوْمَہُ۔","","Musannaf Ibn Abi Shaybah 9577","","","كتاب الصيام"
"9578","(۹۵۷۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الخَالِق ، عَنْ حَمَّادٍ ؛ فِی الصَّائِمِ یُمَضْمِضَ ، فَدَخَلَ الْمَائُ حَلْقَہُ ، قَالَ : إِنْ کَانَ وُضُوء اً وَاجِبًا فَلَیْسَ عَلَیْہِ شَیْئٌ ، وَإِنْ کَانَ مَضْمَضَ عَنْ غَیْرِہِ فَإِنَّہُ یُعِیدُ۔","","Musannaf Ibn Abi Shaybah 9578","","","كتاب الصيام"
"9579","(۹۵۷۹) حَدَّثَنَا مَخْلَدٌ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ إنْسَانٌ لِعَطَائٍ : اسْتَنْثرتُ فَدَخَلَ الْمَائُ حَلْقِی ، فَلاَ بَأْسَ ؟ قَالَ : لاَ بَأْسَ ، لَمْ تَمْلِکْ۔","","Musannaf Ibn Abi Shaybah 9579","","","كتاب الصيام"
"9580","(۹۵۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الصَّائِمِ یَتَوَضَّأُ فَیَدْخُلُ حَلْقَہُ مِنْ وَضُوئِہِ ، قَالَ : إِنْ کَانَ ذَاکِرًا لِصَوْمِہِ فَعَلَیْہِ الْقَضَائُ ، وَإِنْ کَانَ نَاسِیًا فَلاَ شَیْئَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 9580","","","كتاب الصيام"
"9581","(۹۵۸۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ عَنْ رَجُلٍ کَانَ صَائِمًا فَتَوَضَّأَ ، فَسَبَقَہُ الْمَائُ إلَی حَلْقِہِ ، یُفْطِرُ ؟ قَالَ : لاَ ، وَلْیُتِمَّ صِیَامَہُ۔","","Musannaf Ibn Abi Shaybah 9581","","","كتاب الصيام"
"9582","(۹۵۸۲) حَدَّثَنَا حَفْصٌ ، عَنْ مُجَالِدٍ ، عَنْ عَامِرٍ ، قَالَ : کَانَ عَلِیٌّ ، وَعُمَرُ یَنْہَیَانِ عَنْ صَوْمِ الیَوْمٍ الَّذِی یُشَکُّ فِیہِ مِنْ رَمَضَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 9582","","","كتاب الصيام"
"9583","(۹۵۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الضَّرِیسِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَابِسٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عَبْدُ اللہِ : لأَنْ أُفْطِرَ یَوْمًا مِنْ رَمَضَانَ ، ثُمَّ أَقْضِیَہُ ، أَحَبُّ إلَیَّ مِنْ أَنْ أَزِیدَ فِیہِ مَا لَیْسَ مِنہ۔","Hasan","Musannaf Ibn Abi Shaybah 9583","","","كتاب الصيام"
"9584","(۹۵۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ حَکِیمٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُول : لَوْ صُمْت السَّنَۃَ کُلَّہَا لأَفْطَرْتُ الْیَوْمَ الَّذِی یُشَکُّ فِیہِ۔","Hasan","Musannaf Ibn Abi Shaybah 9584","","","كتاب الصيام"
"9585","(۹۵۸۵) حَدَّثَنَا حَفْصٌ ، وَعَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ الضَّحَّاکُ بْنُ قَیْسٍ : لَوْ صُمْتُ السَّنَۃَ کُلَّہَا ، مَا صُمْتُ الْیَوْمَ الَّذِی یُشَکُّ فِیہِ مِنْ رَمَضَانَ۔","Sahih","Musannaf Ibn Abi Shaybah 9585","","","كتاب الصيام"
"9586","(۹۵۸۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ مَوْلاَۃٍ لِسَلَمَۃَ بِنْتِ حُذَیْفَۃَ ، عَنْ بِنْتِ حُذَیْفَۃَ قَالَتْ : کَانَ حُذَیْفَۃُ یَنْہَی عَنْ صَوْمِ الیَوْمِ الَّذِی یُشَکُّ فِیہِ۔","Da'if","Musannaf Ibn Abi Shaybah 9586","","","كتاب الصيام"
"9587","(۹۵۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مَہْدِیِّ بْنِ مَیْمُونٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : أَصْبَحْنَا یَوْمًا بِالْبَصْرَۃِ ، وَلَسْنَا نَدْرِی عَلَی مَا نَحْنُ فِیہِ مِنْ صَوْمِنَا فِی الْیَوْمِ الَّذِی یُشَکُّ فِیہِ ، فَأَتَیْنَا أَنَسَ بْنَ مَالِکٍ ، فَإِذَا ہُوَ قَدْ أَخَذَ خزیرۃ کَانَ یَأْخُذُہَا قَبْلَ أَنْ یَغْدُوَ ، ثُمَّ غَدَوْا ، ثُمَّ أَتَیْتُ أَبَا السَّوَّارِ الْعَتَکِیَّ فَدَعَا بِغَدَائِہِ ، ثُمَّ تَغَدَّی ، ثُمَّ أَتَیْتُ مُسْلِمَ بْنَ یَسَارٍ فَوَجَدْتُہُ مُفْطِرًا۔","Sahih","Musannaf Ibn Abi Shaybah 9587","","","كتاب الصيام"
"9588","(۹۵۸۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، وَالشَّعْبِیِّ ، أَنَّہُمَا قَالاَ : لاَ تَصُمْ إِلاَّ مَعَ جَمَاعَۃِ النَّاسِ۔","","Musannaf Ibn Abi Shaybah 9588","","","كتاب الصيام"
"9589","(۹۵۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : مَا مِنْ یَوْمٍ أَصُومُہُ أَبْغَضُ إلَیَّ مِنْ یَوْمٍ یَخْتَلِفُ النَّاسُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 9589","","","كتاب الصيام"
"9590","(۹۵۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنِ امْرَأَۃٍ مِنْہُمْ ، یُقَالُ لَہَا : حَفْصَۃُ ، عَنْ بِنْتٍ أَوْ أُخْتٍ لِحُذَیْفَۃَ ، قَالَتْ : کَانَ حُذَیْفَۃُ یَنْہَی عَنْ صَوْمِ الیَوْمِ الَّذِی یُشَکُّ فِیہِ۔","Da'if","Musannaf Ibn Abi Shaybah 9590","","","كتاب الصيام"
"9591","(۹۵۹۱) حَدَّثَنَا وَکِیعٌ ، عَنِ أَبِی الْعَیْزَارِ ، قَالَ : أَتَیْتُ إبْرَاہِیمَ فِی الْیَوْمِ الَّذِی یُشَکُّ فِیہِ ، فَقَالَ : لَعَلَّک صَائِمٌ ، لاَ تَصُمْ إِلاَّ مَعَ الْجَمَاعَۃِ۔","","Musannaf Ibn Abi Shaybah 9591","","","كتاب الصيام"
"9592","(۹۵۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ دَاوُدَ بْنِ قَیْسٍ ، قَالَ : قُلْتُ لِلْقَاسِمِ : أَتَکْرَہُ صَوْمَ آخِرِ یَوْمِ شَعْبَانَ الَّذِی یَلِی رَمَضَانَ؟ قَالَ : لاَ ، إِلاَّ أَنْ یُغمَّی الْہِلاَلُ۔","","Musannaf Ibn Abi Shaybah 9592","","","كتاب الصيام"
"9593","(۹۵۹۳) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَصُومُہُ فِیمَا بَیْنَہُ وَبَیْنَ نِصْفِ النَّہَارِ لِشَہَادَۃِ شَاہِدٍ، أَوْ مَجِیئِ غَائِبٍ ، فَإِنْ جَائَ ، وَإِلاَّ أَفْطَرَ۔","","Musannaf Ibn Abi Shaybah 9593","","","كتاب الصيام"
"9594","(۹۵۹۴) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی الْمُعَلَّی ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَصُومَ الْیَوْمَ الَّذِی یُخْتَلَفُ فِیہِ مِنْ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 9594","","","كتاب الصيام"
"9595","(۹۵۹۵) حَدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ عَبْدِ الصَّمَدِ الْعَمِّیُّ ، عَنْ مَنْصُورٍ ، عَنْ رِبْعِیٍّ ، أَنَّ عَمَّارَ بْنَ یَاسِرٍ وَنَاسًا مَعَہُ أَتَوْہُمْ بِمَسْلُوخَۃٍ مَشْوِیَّۃٍ فِی الْیَوْمِ الَّذِی یُشَکُّ فِیہِ أَنَّہُ مِنْ رَمَضَانَ ، أَوْ لَیْسَ مِنْ رَمَضَانَ ، فَاجْتَمَعُوا وَاعْتَزَلَہُمْ رَجُلٌ ، فَقَالَ لَہُ عَمَّارٌ : تَعَالَ فَکُلْ ، قَالَ : فَإِنِّی صَائِمٌ ، فَقَالَ لَہُ عَمَّارٌ : إِنْ کُنْت تُؤْمِنُ بِاللَّہِ وَالْیَوْمِ الآخِرِ فَتَعَالَ فَکُلْ۔","","Musannaf Ibn Abi Shaybah 9595","","","كتاب الصيام"
"9596","(۹۵۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : مَنْ صَامَ الْیَوْمَ الَّذِی یُشَکُّ فِیہِ فَقَدْ عَصَی رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (ابوداؤد ۲۳۲۷۔ دارمی ۱۶۸۲)","","Musannaf Ibn Abi Shaybah 9596","","","كتاب الصيام"
"9597","(۹۵۹۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَیَان ، عَنْ عَامِرٍ ، قَالَ : مَا مِنْ یَوْمٍ أَبْغَضُ إلَیَّ أَنْ أَصُومَہُ مِنَ الْیَوْمِ الَّذِی یُشَکُّ فِیہِ مِنْ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 9597","","","كتاب الصيام"
"9598","(۹۵۹۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُطَرِّفٍ ، عَنْ عَامِرٍ ؛ فِی الْیَوْمِ الَّذِی یَقُولُ النَّاسُ إِنَّہُ مِنْ رَمَضَانَ ، قَالَ : فَقَالَ : لاَ تَصُومَنَّ إِلاَّ مَعَ الإِمَامِ ، فَإِنَّمَا کَانَتْ أَوَّلُ الْفُرْقَۃِ فِی مِثْلِ ہَذَا۔","","Musannaf Ibn Abi Shaybah 9598","","","كتاب الصيام"
"9599","(۹۵۹۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ قَالَ : مَا مِنْ یَوْمٍ أَبْغَضُ إلَیَّ أَنْ أَصُومَہُ ، مِنَ الْیَوْمِ الَّذِی یُشَکُّ فِیہِ مِنْ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 9599","","","كتاب الصيام"
"9600","(۹۶۰۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : قَالَ عُمَرُ : لِیَتَّقِ أَحَدُکُمْ أَنْ یَصُومَ یَوْمًا مِنْ شَعْبَانَ ، أَوْ یُفْطِرَ یَوْمًا مِنْ رَمَضَانَ ، فإِنْ تَقَدَّمَ قَبْلَ النَّاسِ ، فَلْیُفْطِرْ إذَا أَفْطَرَ النَّاسُ۔","Sahih","Musannaf Ibn Abi Shaybah 9600","","","كتاب الصيام"
"9601","(۹۶۰۱) حَدَّثَنَا یَزِیدُ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ؛ أَنَّہُ کَانَ یَصُومُ یَوْمَ الَّذِی یُشَکُّ فِیہِ مِنْ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 9601","","","كتاب الصيام"
"9602","(۹۶۰۲) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَنْ أَبِی یَعْفُورٍ، عَنْ أَبِی الصَّلْتِ، عَنْ أَبِی عَقْرَبٍ الأَسَدِیِّ، قَالَ: أَتَیْنَا ابْنَ مَسْعُودٍ فِی دَارِہِ فَوَجَدْنَاہُ فَوْقَ الْبَیْتِ ، فَسَمِعَنَاہُ یَقُولُ قَبْلَ أَنْ یَنْزِلَ : صَدَقَ اللَّہُ وَرَسُولُہُ ، فَلَمَّا نَزَلَ قُلْنَا : یَا أَبَا عَبْدِ الرَّحْمَنِ ، سَمِعْنَاک تَقُولُ: صَدَقَ اللَّہُ وَرَسُولُہُ ، فَقَالَ: لَیْلَۃُ الْقَدْرِ فِی السَّبْعِ مِنَ النِّصْفِ الآخِرِ، وَذَلِکَ أَنَّ الشَّمْسَ تَطْلُعُ یَوْمَئِذٍ بَیْضَائَ لاَ شُعَاعَ لَہَا ، فَنَظَرْتُ إلَی الشَّمْسِ فَوَجَدْتُہَا کَمَا حُدِّثْتُ ، فَکَبَّرْت۔","Da'if","Musannaf Ibn Abi Shaybah 9602","","","كتاب الصيام"
"9603","(۹۶۰۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ عُمَرَ ، قَالَ : لَقَدْ عَلِمْتُمْ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ فِی لَیْلَۃِ الْقَدْرِ : اُطْلُبُوہَا فِی الْعَشْرِ الأَوَاخِرِ۔","Sahih","Musannaf Ibn Abi Shaybah 9603","","","كتاب الصيام"
"9604","(۹۶۰۴) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، عَنْ عُبَادَۃَ بْنِ الصَّامِتِ ، قَالَ : خَرَجَ عَلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یُرِیدُ أَنْ یُخْبِرَنَا بِلَیْلَۃِ الْقَدْرِ ، فَتَلاَحَی رَجُلاَنِ ، فَقَالَ : إنِّی خَرَجْت وَأَنَا أُرِیدُ أَنْ أُخْبِرَکُمْ بِلَیْلَۃِ الْقَدْرِ فَتَلاَحَی فُلاَنٌ وَفُلاَنٌ ، لَعَلَّ ذَلِکَ أَنْ یَکُونَ خَیْرًا ، الْتَمِسُوہَا فِی التَّاسِعَۃِ ، وَالسَّابِعَۃِ ، وَالْخَامِسَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 9604","","","كتاب الصيام"
"9605","(۹۶۰۵) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ لَیْثِ بْنِ سَعْدٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ خُبِیبٍ ، عَنْ عَبْدِ اللہِ بْنِ أَنُیسٍ صَاحِبِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ سُئِلَ عَنْ لَیْلَۃِ الْقَدْرِ ؟ فَقَالَ: إنِّی سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : الْتَمِسُوہَا اللَّیْلَۃَ ، وَتِلْکَ اللَّیْلَۃُ لَیْلَۃُ ثَلاَثٍ وَعِشْرِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 9605","","","كتاب الصيام"
"9606","(۹۶۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ مَرْثَدِ بْنِ أَبِی مَرْثَدٍ ، عَنْ أَبِیہِ ؛ قَالَ : کُنْتُ مَعَ أَبِی ذَرٍّ عِنْدَ الْجَمْرَۃِ الْوُسْطَی ، فَسَأَلْتُہُ عَنْ لَیْلَۃِ الْقَدْرِ ؟ فَقَالَ : کَانَ أَسْأَلَ النَّاسِ عَنْہَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَا ، قُلْتُ : یَا رَسُولَ اللہِ ، أَخْبِرْنَا بِہَا ، فَقَالَ : لَوْ أُذِنَ لِی فِیہَا لأَخْبَرْتُکُمْ ، وَلَکِنِ الْتَمِسُوہَا فِی إحْدَی السَّبْعَیْنَ، ثُمَّ لاَ تَسْأَلْنِی عَنْہَا بَعْدَ مُقَامِکَ ، أَوْ مُقَامِی ہَذَا۔","Da'if","Musannaf Ibn Abi Shaybah 9606","","","كتاب الصيام"
"9607","(۹۶۰۷) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ قَنَّان بْنِ عَبْدِ اللہِ النَّہْمِیِّ ، قَالَ : سَأَلَتْ زِرَّ بْنَ حُبَیْشٍ عَنْ لَیْلَۃِ الْقَدْرِ ؟ فَقَالَ : کَانَ عُمَرُ ، وَحُذَیْفَۃُ ، وَنَاسٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ یَشُکُّونَ فِیہَا أَنَّہَا لَیْلَۃُ سَبْعٍ وَعِشْرِینَ ، قَالَ زِرٌّ : فَوَاصِلْہَا۔","Hasan","Musannaf Ibn Abi Shaybah 9607","","","كتاب الصيام"
"9608","(۹۶۰۸) حَدَّثَنَا شَرِیکٌ ، عَنِ الأَسْوَد بْنِ قَیْسٍ ، عَنْ أَبِیہِ ، عَنْ عُمَرَ ، قَالَ : لاَ بَأْسَ بِقَضَائِ رَمَضَانَ فِی الْعَشْرِ۔","Hasan","Musannaf Ibn Abi Shaybah 9608","","","كتاب الصيام"
"9609","(۹۶۰۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : مَنْ کَانَ عَلَیْہِ صَوْمٌ مِنْ رَمَضَانَ فَلاَ یَقْضِیہ فِی ذِی الْحِجَّۃِ ، فَإِنَّہُ شَہْرُ نُسُکٍ۔","Da'if","Musannaf Ibn Abi Shaybah 9609","","","كتاب الصيام"
"9610","(۹۶۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عُثْمَانَ بْنِ مَوْہَبٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : اِبْدَأ بِالْفَرِیضَۃِ لاَ بَأْسَ أَنْ تَصُومَہَا فِی الْعَشْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 9610","","","كتاب الصيام"
"9611","(۹۶۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ (ح) وَعَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالاَ : یَبْدَأُ بِالْفَرِیضَۃِ ، لاَ بَأْسَ أَنْ یَصُومَہَا فِی الْعَشْرِ۔","","Musannaf Ibn Abi Shaybah 9611","","","كتاب الصيام"
"9612","(۹۶۱۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَقْضِی رَمَضَانَ فِی الْعَشْرِ۔","","Musannaf Ibn Abi Shaybah 9612","","","كتاب الصيام"
"9613","(۹۶۱۳) حَدَّثَنَا غُنْدَرٌ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِقَضَائِ رَمَضَانَ فِی الْعَشْرِ۔","","Musannaf Ibn Abi Shaybah 9613","","","كتاب الصيام"
"9614","(۹۶۱۴) حَدَّثَنَا إسْمَاعِیلُ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُسٍ ، وَمُجَاہِدٍ قَالُوا : اقْضِ رَمَضَانَ مَتَی شِئْتَ ، وَقَالَ سَعِیدُ بْنُ جُبَیْرٍ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 9614","","","كتاب الصيام"
"9615","(۹۶۱۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 9615","","","كتاب الصيام"
"9616","(۹۶۱۶) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أُتیتُ فِی رَمَضَانَ وَأَنَا نَائِمٌ فَقِیلَ: إنَّ اللَّیْلَۃَ لَیْلَۃُ الْقَدْرِ، قَالَ: فَقُمْتُ وَأَنَا نَاعِسٌ فَتَعَلَّقْت بِبَعْضِ أَطْنَابِ فُسْطَاطِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، فَأَتَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یُصَلِّی، فَنَظَرْت فِی اللَّیْلَۃِ فَإِذَا ہِیَ لَیْلَۃُ ثَلاَثٍ وَعِشْرِینَ، قَالَ: وَقَالَ ابْنُ عَبَّاسٍ: الشَّیْطَانُ یَطْلُعُ مَعَ الشَّمْسِ کُلَّ یَوْمٍ إِلاَّ لَیْلَۃَ الْقَدْرِ، قَالَ: وَذَلِکَ أَنَّہَا تَطْلُعُ یَوْمَئِذٍ لاَ شُعَاعَ لَہَا۔","","Musannaf Ibn Abi Shaybah 9616","","","كتاب الصيام"
"9617","(۹۶۱۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ جَبَلَۃَ ، وَمُحَارِبٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَحَیَّنُوا لَیْلَۃَ الْقَدْرِ فِی الْعَشْرِ الأَوَاخِرِ ، أَوْ قَالَ : فِی السَّبْعِ الأَوَاخِرِ۔","Sahih","Musannaf Ibn Abi Shaybah 9617","","","كتاب الصيام"
"9618","(۹۶۱۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَحَرَّوْا لَیْلَۃَ الْقَدْرِ فِی الْعَشْرِ الأَوَاخِرِ۔ (مسلم ۲۱۹۔ احمد ۶/۲۰۴)","Sahih","Musannaf Ibn Abi Shaybah 9618","","","كتاب الصيام"
"9619","(۹۶۱۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، وَابْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ مَرْثَدِ بْنِ عَبْدِ اللہِ الْیَزَنِیِّ ، عَنِ الصُّنَابِحِیِّ ، قَالَ : سَأَلْتُ بِلاَلاً عَنْ لَیْلَۃِ الْقَدْرِ ؟ فَقَالَ : لَیْلَۃُ ثَلاَثٍ وَعِشْرِینَ۔","","Musannaf Ibn Abi Shaybah 9619","","","كتاب الصيام"
"9620","(۹۶۲۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَاصِمٍ ، عَنْ أَبِیہِ ، عَنْ خَالِہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنِّی أُرِیتُ لَیْلَۃ الْقَدْرِ فَأُنْسِیتہَا ، فَاطْلُبُوہَا فِی الْعَشْرِ الأَوَاخِرِ ، وِتْرًا۔","Hasan","Musannaf Ibn Abi Shaybah 9620","","","كتاب الصيام"
"9621","(۹۶۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : فِی رَمَضَانَ۔","Sahih","Musannaf Ibn Abi Shaybah 9621","","","كتاب الصيام"
"9622","(۹۶۲۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَد ، عَنْ عَبْدِ اللہِ ، قَالَ : تَحَرَّوْا لَیْلَۃَ الْقَدْرِ لِسَبْعٍ تَبْقَی ، تَحَرَّوْہَا لِتِسْعٍ تَبْقَی ، تَحَرَّوہا لإِحْدَی عَشْرَۃَ تَبْقَی ، صَبِیحَۃَ بَدْرٍ ، فَإِنَّ الشَّمْسَ تَطْلُعُ کُلَّ یَوْمٍ بَیْنَ قَرْنَیْ شَیْطَانٍ إِلاَّ صَبِیحَۃَ بَدْرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 9622","","","كتاب الصيام"
"9623","(۹۶۲۳) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ ابْنِ أَبِی خَالِدٍ ، عَنْ زِرٍّ ، قَالَ : سَمِعْتُ أُبَیَّ بْنَ کَعْبٍ یَقُولُ : لَیْلَۃُ الْقَدْرِ لَیْلَۃُ سَبْعٍ وَعِشْرِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 9623","","","كتاب الصيام"
"9624","(۹۶۲۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْمَسْعُودِیِّ ، عَنْ حَوْطٍ الْخُزَاعِیِّ ، قَالَ : سَأَلْتُ زَیْدَ بْنَ أَرْقَمَ عْن لَیْلَۃِ الْقَدْرِ ؟ قَالَ : فَمَا تماری وَلاَ شَکَّ ، قَالَ : لَیْلَۃُ تِسْعَ عَشْرَۃَ ، لَیْلَۃُ الْفُرْقَانِ لَیْلَۃُ الْتَقَی الْجَمْعَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 9624","","","كتاب الصيام"
"9625","(۹۶۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ عُیَیْنَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنْ أَبِی بَکْرَۃَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : الْتَمِسُوا لَیْلَۃَ الْقَدْرِ فِی الْعَشْرِ مِنْ رَمَضَانَ ؛ لِتِسْعٍ تَبْقَیْنَ ، أَوْ لِسَبْعٍ تَبْقَیْنَ ، أَوْ لِخَمْسٍ ، أَوْ لِثَلاَثٍ ، أَوْ لآخِرِ لَیْلَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 9625","","","كتاب الصيام"
"9626","(۹۶۲۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَجْلَحِ ، عَنِ الشَّعْبِیِّ ، عَنْ زِرِّ بْنِ حُبَیْشٍ ، قَالَ : سَمِعْتُ أُبَیًّا یَقُولُ : لَیْلَۃُ الْقَدْرِ ہِیَ لَیْلَۃُ سَبْعٍ وَعِشْرینَ ، ہِیَ اللَّیْلَۃُ الَّتِی أَخْبَرَنَا بِہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّ الشَّمْسَ تَطْلُعُ بَیْضَائَ ، تَرَقْرَقُ۔","Hasan","Musannaf Ibn Abi Shaybah 9626","","","كتاب الصيام"
"9627","(۹۶۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعَۃَ بْنِ کُلْثُومٍ ، قَالَ : سَمِعْتُ الْحَسَنَ یَقُولُ : لَیْلَۃُ الْقَدْرِ فِی کُلِّ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 9627","","","كتاب الصيام"
"9628","(۹۶۲۸) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : لَیْلَۃُ الْقَدْرِ تَحَوَّلُ فِی لَیَالِیِ الْعَشْرِ کُلِّہَا۔","","Musannaf Ibn Abi Shaybah 9628","","","كتاب الصيام"
"9629","(۹۶۲۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، ووَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ شَرِیکٍ ، قَالَ : سَمِعْتُ زِرًّا یَقُولُ : لَیْلَۃُ الْقَدْرِ لَیْلَۃُ سَبْعٍ وَعِشْرِینَ ، فَإِذَا کَانَ تِلْکَ اللَّیْلَۃَ فَلْیَغْتَسِلْ أَحَدُکُمْ ، وَلْیُفْطِرْ عَلَی لَبَنٍ ، وَلْیُؤَخِّرْ فِطْرَہُ إلَی السَّحَرِ۔","","Musannaf Ibn Abi Shaybah 9629","","","كتاب الصيام"
"9630","(۹۶۳۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ قَتَادَۃَ ، عَنْ مُطَرِّفٍ ، عَنْ مُعَاوِیَۃَ ، قَالَ : لَیْلَۃُ الْقَدْرِ لَیْلَۃُ ثَلاَثٍ وَعِشْرِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 9630","","","كتاب الصيام"
"9631","(۹۶۳۱) حَدَّثَنَا عَمْرُو بْنُ حَمَّادِ بْنِ طَلْحَۃَ ، عَنْ أَسْبَاطِ بْنِ نَصْرٍ ، عَنْ سِمَاکٍ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْتَمِسُوا لَیْلَۃَ الْقَدْرِ فِی الْعَشْرِ الأَوَاخِرِ۔","Hasan","Musannaf Ibn Abi Shaybah 9631","","","كتاب الصيام"
"9632","(۹۶۳۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إنِّی أُرِیتُ لَیْلَۃَ الْقَدْرِ فَأُنْسِیتہَا ، أَوْ نُسِّیتُہَا ، فَالْتَمِسُوہَا فِی الْعَشْرِ الأَوَاخِرِ ، فِی الْوِتْرِ۔ (بخاری ۸۱۳۔ ابوداؤد ۱۳۷۷)","Sahih","Musannaf Ibn Abi Shaybah 9632","","","كتاب الصيام"
"9633","(۹۶۳۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَد ؛ أَنَّ عَائِشَۃَ کَانَتْ تُوقِظُ أَہْلَہَا لَیْلَۃَ ثَلاَثٍ وَعِشْرِینَ۔","Hasan","Musannaf Ibn Abi Shaybah 9633","","","كتاب الصيام"
"9634","(۹۶۳۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، قَالَ : رَأَیْتُ ابْنَ عَبَّاسٍ یَرُشُّ عَلَی أَہْلِہِ مَائً لَیْلَۃَ ثَلاَثٍ وَعِشْرِینَ۔","","Musannaf Ibn Abi Shaybah 9634","","","كتاب الصيام"
"9635","(۹۶۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَحَرَّوْا لَیْلَۃَ الْقَدْرِ فِی الْعَشْرِ الأَوَاخِرِ مِنْ رَمَضَانَ۔","Sahih","Musannaf Ibn Abi Shaybah 9635","","","كتاب الصيام"
"9636","(۹۶۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْلَۃُ الْقَدْرِ لَیْلَۃٌ بَلْجَۃٌ سَمْحَۃٌ ، تَطْلُعُ شَمْسُہَا لَیْسَ لَہَا شُعَاعٌ۔","","Musannaf Ibn Abi Shaybah 9636","","","كتاب الصيام"
"9637","(۹۶۳۷) حَدَّثَنَا أَبُوبَکْرِ بْنُ عَیَّاشٍ، عَنْ أَبِی إِسْحَاقَ، عَنْ ہُبَیْرَۃَ، عَنْ عَلِیٍّ، قَالَ: کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا دَخَلَتِ الْعَشْرُ الأَوَاخِرُ أَیْقَظَ أَہْلَہُ وَرَفَعَ الْمِئْزَرَ ، قِیلَ لأَبِی بَکْرٍ : مَا رَفْعُ الْمِئْزَرِ؟ قَالَ: اعْتِزَالُ النِّسَائِ۔","Hasan","Musannaf Ibn Abi Shaybah 9637","","","كتاب الصيام"
"9638","(۹۶۳۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ یُوقِظُ أَہْلَہُ فِی الْعَشْرِ الأَوَاخِرِ۔","Da'if","Musannaf Ibn Abi Shaybah 9638","","","كتاب الصيام"
"9639","(۹۶۳۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُوقِظُ أَہْلَہُ فِی الْعَشْرِ الأَوَاخِرِ مِنْ رَمَضَانَ ، وَیُشَمِّرُ فِیہِنَّ۔","","Musannaf Ibn Abi Shaybah 9639","","","كتاب الصيام"
"9640","(۹۶۴۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُیَیْنَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، قَالَ : کَانَ أَبُو بَکْرۃَ یُصَلِّی فِی رَمَضَانَ کَصَلاَتِہِ فِی سَائِرِ السَّنَۃِ ، فَإِذَا دَخَلَتِ الْعَشْرُ اجْتَہَدَ۔","Sahih","Musannaf Ibn Abi Shaybah 9640","","","كتاب الصيام"
"9641","(۹۶۴۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِیَادٍ ، قَالَ : حَدَّثَنَا الْحَسَنُ بْنُ عُبَیْدِ اللہِ ، قَالَ : حدَّثَنَا إبْرَاہِیمُ ، عَنِ الأَسْوَد ، عَنْ عَائِشَۃَ قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَجْتَہِدُ فِی الْعَشْرِ اجْتِہَادًا ، لاَ یَجْتَہِدُہ فِی غَیْرِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 9641","","","كتاب الصيام"
"9642","(۹۶۴۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، وَأَبِی مَیْسَرَۃَ ، قَالاََ : جَائَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، رَجُلٌ صَامَ الأَبَدَ ؟ قَالَ : لاَ صَامَ ، وَلاَ أَفْطَرَ۔","","Musannaf Ibn Abi Shaybah 9642","","","كتاب الصيام"
"9643","(۹۶۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، وَسُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ أَبِی الْعَبَّاسِ الْمَکِّیِّ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : قَ??لَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ صَامَ مَنْ صَامَ الأَبَدَ۔ (بخاری ۱۹۷۹۔ مسلم ۱۸۷)","Sahih","Musannaf Ibn Abi Shaybah 9643","","","كتاب الصيام"
"9644","(۹۶۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مَہْدِیِّ بْنِ مَیْمُونٍ ، عَنْ غَیْلاَنَ بْنِ جَرِیرٍ ، عَنْ عَبْدِ اللہِ بْنِ مَعْبَدٍ الزِّمَّانِیْ ، عَنْ أَبِی قَتَادَۃَ ، قَالَ : قَالَ رَجُلٌ : یَا رَسُولَ اللہِ ، أَرَأَیْت رَجُلاً یَصُومُ الدَّہْرَ کُلَّہُ ؟ قَالَ : لاَ صَامَ وَلاَ أَفْطَرَ ، أَوْ مَا صَامَ وَلاَ أَفْطَرَ۔ (مسلم ۸۱۸۔ ابوداؤد ۲۴۱۸)","Sahih","Musannaf Ibn Abi Shaybah 9644","","","كتاب الصيام"
"9645","(۹۶۴۵) حَدَّثَنَا عُبَیْدُ بْنُ سَعِیدٍ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ مُطَرِّفِ بْنِ عَبْدِ اللہِ بْنِ الشِّخِّیرِ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ صَامَ الأَبَدَ فَلاَ صَامَ ، وَلاَ أَفْطَرَ۔ (ابن ماجہ ۱۷۰۵۔ طیالسی ۱۱۴۷)","Sahih","Musannaf Ibn Abi Shaybah 9645","","","كتاب الصيام"
"9646","(۹۶۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی تَمِیمَۃَ الْہُجَیْمِیِّ ، عَنْ أَبِی مُوسَی ، قَالَ : مَنْ صَامَ الدَّہْرَ ضُیِّقَتْ عَلَیْہِ جَہَنَّمُ ہَکَذَا ، وَطَبَّقَ بِکَفِّہِ۔","Sahih","Musannaf Ibn Abi Shaybah 9646","","","كتاب الصيام"
"9647","(۹۶۴۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الضَّحَّاکِ بْنِ یَسَارٍ ، سَمِعَہُ مِنْ أَبِی تَمِیمَۃَ ، عَنْ أَبِی مُوسَی ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، بِمِثْلِہِ۔ (احمد ۴/۴۱۴۔ ابن حبان ۳۵۸۴)","Da'if","Musannaf Ibn Abi Shaybah 9647","","","كتاب الصيام"
"9648","(۹۶۴۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی عَمَّارٍ الْہَمْدَانِیِّ ، عَنْ عَمْرِو بْنِ شُرَحْبِیلَ ، قَالَ : قَالَ رَجُلٌ : یَا رَسُولَ اللہِ ، أَرَأَیْتَ رَجُلاً یَصُومُ الدَّہْرَ کُلَّہُ ؟ قَالَ : وَدِدْتُ أَنَّہُ لاَ یَطْعَمُ الدَّہْرَ کُلَّہُ ، قَالَ : ثُلُثَیْہِ ؟ قَالَ : أَکْثَرُ ، قَالَ : نِصْفَہُ ؟ قَالَ : أَکْثَرُ ، ثُمَّ قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَلاَ أُنَبِّئُکُمْ مَا یُذْہِبُ وَحْر الصَّدْرِ : صِیَامُ ثَلاَثَۃِ أَیَّامٍ مِنْ کُلِّ شَہْرٍ۔","","Musannaf Ibn Abi Shaybah 9648","","","كتاب الصيام"
"9649","(۹۶۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی خَالِدٍ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، قَالَ : بَلَغَ عُمَرَ أَنَّ رَجُلاً یَصُومُ الدَّہْرَ ، فَعَلاَہُ بِالدِّرَّۃِ وَجَعَلَ یَقُولُ : کُلْ یَا دَہْرُ ، کُلْ یَا دَہْرُ۔","Sahih","Musannaf Ibn Abi Shaybah 9649","","","كتاب الصيام"
"9650","(۹۶۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، قَالَ : ذُکِرَ لِلشَّعْبِیِّ أَنَّ عُبَیْدًا الْمُکْتِبَ یَصُومُ الدَّہْرَ کُلَّہُ ، فَکَرِہَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 9650","","","كتاب الصيام"
"9651","(۹۶۵۱) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنِ الْحَسَنِ بْنِ یَزِیدَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ سُئِلَ عَنْ صَوْمِ الدَّہْرِ ؟ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 9651","","","كتاب الصيام"
"9652","(۹۶۵۲) حَدَّثَنَا مَعْنُ بْنُ عِیسَی، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ، قَالَ: لَمْ یَکُنْ سَالِمٌ، وَالْقَاسِمُ، وَعُبَیْدُاللہِ یَصُومُونَ الدَّہْرَ۔","","Musannaf Ibn Abi Shaybah 9652","","","كتاب الصيام"
"9653","(۹۶۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی جَعْفَرٍ الْفَرَّائِ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، قَالَ : قَالَ نَبِیُّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ صَامَ مَنْ صَامَ الدَّہْرَ۔","","Musannaf Ibn Abi Shaybah 9653","","","كتاب الصيام"
"9654","(۹۶۵۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ؛ أَنَّ الأَسْوَد کَانَ یَصُومُ الدَّہْرَ۔","","Musannaf Ibn Abi Shaybah 9654","","","كتاب الصيام"
"9655","(۹۶۵۵) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ عَبْدِ الْوَاحِدِ ، قَالَ : کَانَ عُرْوَۃُ یَصُومُ الدَّہْرَ فِی السَّفَرِ وَغَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 9655","","","كتاب الصيام"
"9656","(۹۶۵۶) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ الزُّبَیْرِ بْنِ عَبْدِ اللہِ بْنِ رُہَیْمَۃَ ، عَنْ جَدَّتِہِ ، قَالَتْ : کَانَ عُثْمَانَ یَصُومُ الدَّہْرَ، وَیَقُومُ اللَّیْلَ إِلاَّ ہَجْعَۃً مِنْ أَوَّلِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 9656","","","كتاب الصيام"
"9657","(۹۶۵۷) حَدَّثَنَا عَبْدَۃُ ، وَأَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ عُمَرَ سَرَدَ الصَّوْمَ قَبْلَ مَوْتِہِ بِسَنَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 9657","","","كتاب الصيام"
"9658","(۹۶۵۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ ، قَالَ : ذَکَرُوا بِالْمَدِینَۃِ رُؤْیَۃَ الْہِلاَلِ وَقَالُوا : إنَّ أَہْلَ إِسْتَارَۃَ قَدْ رَأَوْہُ ، فَقَالَ الْقَاسِمُ ، وَسَالِمٌ : مَا لَنَا وَلأَہْلِ إِسْتَارَۃَ۔","","Musannaf Ibn Abi Shaybah 9658","","","كتاب الصيام"
"9659","(۹۶۵۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ قَالَتْ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَبِیتُ جُنُبًا ، فَیَأْتِیہِ بِلاَلٌ فَیُؤْذِنُہُ بِالصَّلاَۃِ ، فَیَقُومُ فَیَغْتَسِلُ ، فَأَنْظُرُ إلَی تَحَدُّرِ الْمَائِ مِنْ رَأْسِہِ ، ثُمَّ یَخْرُجُ فَأَسْمَعُ صَوْتَہُ فِی صَلاَۃِ الْفَجْرِ ، ثُمَّ یَظَلُّ صَائِمًا ، قَالَ مُطَرِّفٌ : فَقُلْتُ لِعَامِرٍ : فِی رَمَضَانَ ؟ قَالَ : نَعَمْ ، سَوَائٌ رَمَضَانُ وَغَیْرُہُ۔ (احمد ۶/۲۵۴۔ ابن حبان ۳۴۹۰)","Sahih","Musannaf Ibn Abi Shaybah 9659","","","كتاب الصيام"
"9660","(۹۶۶۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصْبِحُ جُنُبًا ، ثُمَّ یَغْتَسِلُ ، ثُمَّ یُتِمُّ صَوْمَہُ۔ (بخاری ۱۹۲۵۔ ترمذی ۷۷۹)","Sahih","Musannaf Ibn Abi Shaybah 9660","","","كتاب الصيام"
"9661","(۹۶۶۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَائِشَۃَ ، قَالَتْ: کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصْبِحُ جُنُبًا ، ثُمَّ یَغْتَسِلُ فَیَخْرُجُ مِنْ مُغْتَسَلِہِ ، فَیُصَلِّی بِالنَّاسِ ، وَیَصُومُ ذَلِکَ الْیَوْمَ۔ (نسائی ۲۹۸۱۔ احمد ۶/۲۰۳)","Sahih","Musannaf Ibn Abi Shaybah 9661","","","كتاب الصيام"
"9662","(۹۶۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنْ أُمِّ سَلَمَۃَ قَالَتْ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصْبِحُ جُنُبًا مِنْ غَیْرِ احْتِلاَمٍ ، ثُمَّ یَغْتَسِلُ وَیَمْضِی عَلَی صَوْمِہِ۔ (مسلم ۸۰۔ احمد ۶/۳۰۶)","Hasan","Musannaf Ibn Abi Shaybah 9662","","","كتاب الصيام"
"9663","(۹۶۶۳) حَدَّثَنَا عَبْدَۃُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عِرَاکِ بْنِ مَالِکٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی بَکْرٍ ؛ أَنَّ أُمَّ سَلَمَۃَ زَوْجَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَتْ تَقُولُ : إِنْ کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَیُصْبِحُ جُنُبًا مِنْ غَیْرِ احْتِلاَمٍ ، ثُمَّ یُصْبِحُ صَائِمًا۔ (احمد ۶/۳۱۳۔ ابن حبان ۳۴۸۶)","","Musannaf Ibn Abi Shaybah 9663","","","كتاب الصيام"
"9664","(۹۶۶۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ جَامِعِ بْنِ شَدَّادٍ ، عَنِ الأَسْوَد بْنِ ہِلاَلٍ ، قَالَ : جَائَ عبْدُ اللہِ بْنُ مِرْدَاسٍ إلَی عَبْدِ اللہِ بْنِ مَسْعُودٍ ، فَقَالَ : إنِّی أَصْبَحْتُ وَأَنَا جُنُبٌ ، فَأُتِمُّ صَوْمِی ؟ قَالَ عَبْدُ اللہِ : أَصْبَحْتَ فَحَلَّ لَکَ الصَّلاَۃُ ، وَحَلَّ لَکَ الصِّیَامُ ، اغْتَسِلْ وَأَتِمَّ صَوْمَک۔","Sahih","Musannaf Ibn Abi Shaybah 9664","","","كتاب الصيام"
"9665","(۹۶۶۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ بْنِ عُمَیْرٍ ، عَنْ أَبِی عَطِیَّۃَ الْوَادِعِیِّ ، قَالَ : تَدَارَأ رَجُلاَنِ فِی الْمَسْجِدِ فِی رَجُلٍ یُصْبِحُ وَہُوَ جُنُبٌ ، فَانْطَلَقَا إلَی عَبْدِ اللہِ ، فَانْطَلَقْت مَعَہُمَا ، فَسَأَلَہُ أَحَدُہُمَا فَقَالَ : أَیَصُومُ ؟ قَالَ : نَعَمْ ، قَالَ : فَإِنْ کَانَ مِنَ النِّسَائِ ؟ قَالَ : وَإِنْ کَانَ مِنَ النِّسَائِ ، قَالَ : وَإِنْ نَامَ مُتَعَمِّدًا ؟ قَالَ : وَإِنْ نَامَ مُتَعَمِّدًا۔","Sahih","Musannaf Ibn Abi Shaybah 9665","","","كتاب الصيام"
"9666","(۹۶۶۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنْ أَبِی عَطِیَّۃَ ، عَنْ عَبْدِ اللہِ ؛ بِنَحْوٍ مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9666","","","كتاب الصيام"
"9667","(۹۶۶۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا أَصْبَحَ الرَّجُلُ وَہُوَ جُنُبٌ فَأَرَادَ أَنْ یَصُومَ ، فَلْیَصُمْ إِنْ شَائَ۔","Da'if","Musannaf Ibn Abi Shaybah 9667","","","كتاب الصيام"
"9668","(۹۶۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَمَّارٍ مَوْلَی بَنِی ہَاشِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، وَزَیْدِ بْنِ ثَابِتٍ ، وَابْنِ عَبَّاسٍ ؛ فِی الرَّجُلِ یُصْبِحُ وَہُوَ جُنُبٌ ، قَالُوا : یَمْضِی عَلَی صَوْمِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 9668","","","كتاب الصيام"
"9669","(۹۶۶۹) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، عَنْ عَطَائِ بْنِ عَبْدِ اللہِ ، قَالَ : قَالَ أَبُو ذَرٍّ : لَوْ أَصْبَحْت جُنُبًا مِنِ امْرَأَتِی لَصُمْتُ۔","","Musannaf Ibn Abi Shaybah 9669","","","كتاب الصيام"
"9670","(۹۶۷۰) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ لَیْثِ بْنِ سَعْدٍ ، عَنِ ابْنِ شِہَابٍ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ ، قَالَ : أَخْبَرَتْنِی عَائِشَۃُ ، وَأُمُّ سَلَمَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُدْرِکُہُ الْفَجْرُ وَہُوَ جُنُبٌ مِنْ أَہْلِہِ ، ثُمَّ یَغْتَسِلُ وَیَصُومُ۔ (بخاری ۱۹۳۱۔ ترمذی ۷۷۹)","Sahih","Musannaf Ibn Abi Shaybah 9670","","","كتاب الصيام"
"9671","(۹۶۷۱) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا ہِشَام بْنُ الْغَازِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لَوْ نَادَی الْمُنَادِی وَأَنَا بَیْنَ رِجْلَیْہَا لَقُمْتُ فَأَتْمَمْتُ الصِّیَامَ ، صِیَامَ رَمَضَانَ کَانَ ، أَوْ غَیْرَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9671","","","كتاب الصيام"
"9672","(۹۶۷۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ رَبِیعٍ ، عَنِ الْحَسَنِ ، قَالَ : یُجْزِیہِ فِی التَّطَوُّعِ ، وَیَقْضِیہِ فِی الْفَرِیضَۃِ۔","","Musannaf Ibn Abi Shaybah 9672","","","كتاب الصيام"
"9673","(۹۶۷۳) حَدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : عَلَیْہِ الْقَضَائُ۔","","Musannaf Ibn Abi Shaybah 9673","","","كتاب الصيام"
"9674","(۹۶۷۴) حَدَّثَنَا یَزِیدُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ؛ أَنَّ أَبَا ہُرَیْرَۃَ رَجَعَ عَنْ فُتْیَاہُ ؛ مَنْ أَصْبَحَ جُنُبًا فَلاَ صَوْمَ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9674","","","كتاب الصيام"
"9675","(۹۶۷۵) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ : حدَّثَنَا إبْرَاہِیمُ بْنُ نَافِعٍ ، قَالَ : سَمِعْتُ ابْنَ طَاوُوس یَذْکُرُ ، عَنْ طَاوُوسٍ ، قَالَ : إِنْ أَصَابَتْہُ جَنَابَۃٌ فِی شَہْرِ رَمَضَانَ ، فَإِن اسْتَیْقَظَ وَلَمْ یَغْتَسِلْ حَتَّی یُصْبِحَ ، فَإِنَّہُ یُتِمُّ ذَلِکَ الْیَوْمَ وَیَصُومُ یَوْمًا مَکَانَہُ ، فَإِنْ لَمْ یَسْتَیْقِظْ فَلَیْسَ عَلَیْہِ بَدَلٌ۔","","Musannaf Ibn Abi Shaybah 9675","","","كتاب الصيام"
"9676","(۹۶۷۶) حَدَّثَنَا حَفْصٌ ، عَنْ ہِشَامٍ ، وَأَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : قَالَ عَبْدُ اللہِ : لَوْ أَذَّنَ الْمُؤَذِّنُ وَأَنَا بَیْنَ رِجْلَیِ امْرَأَتِی ، لاَغْتَسَلْتُ ثُمَّ صُمْتُ۔","","Musannaf Ibn Abi Shaybah 9676","","","كتاب الصيام"
"9677","(۹۶۷۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، قَالَ : قَالَ عُمَرُ : لَوْ أَدْرَکَنِی النِّدَائُ وَأَنَا بَیْنَ رِجْلَیْہَا لَصُمْتُ ، أَوَ قَالَ : مَا أَفْطَرْت۔","Sahih","Musannaf Ibn Abi Shaybah 9677","","","كتاب الصيام"
"9678","(۹۶۷۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : وَاصَلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَوَاصَلْنَا، فَبَلَغَ ذَلِکَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : لَوْ أَنَّ الشَّہْرَ مُدَّ لِی لَوَاصَلْتُ وِصَالاً یَدَعُ الْمُتَعَمِّقُونَ تَعَمُّقَہُمْ ، إنِّی لَسْتُ مِثْلَکُمْ ، إنِّی أَظَلُّ یُطْعِمُنِی رَبِّی وَیَسْقِینِی۔ (بخاری ۱۹۶۱۔ ترمذی ۷۷۸)","Sahih","Musannaf Ibn Abi Shaybah 9678","","","كتاب الصيام"
"9679","(۹۶۷۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : وَاصَلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَبَلَغَ ذَلِکَ النَّاسَ فَوَاصَلُوا ، فَبَلَغَ ذَلِکَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَنَہَاہُمْ ، فَقَالَ : إنِّی لَسْتُ مِثْلَکُمْ ، إنِّی أَظَلُّ عِنْدَ رَبِّی فَیُطْعِمُنِی وَیَسْقِینِی۔ (بخاری ۱۹۶۵۔ مسلم ۷۷۵)","Sahih","Musannaf Ibn Abi Shaybah 9679","","","كتاب الصيام"
"9680","(۹۶۸۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَاصَلَ فِی رَمَضَانَ ، فَوَاصَلَ النَّاسُ فَنَہَاہُمْ ، فَقِیلَ لَہُ : إنَّک تُوَاصِلُ ؟ فَقَالَ : إنِّی لَسْتُ مِثْلَکُمْ ، إنِّی أُطْعَمُ وَأُسْقَی۔ (مسلم ۵۶۔ احمد ۲/۱۴۳)","Sahih","Musannaf Ibn Abi Shaybah 9680","","","كتاب الصيام"
"9681","(۹۶۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ بِشْرِ بْنِ حَرْبٍ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : سَمِعْتُہُ یَقُولُ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْوِصَالِ ، وَہَذِہِ أُخْتِی تُوَاصِلُ ، وَأَنَا أَنْہَاہَا۔ (بخاری ۱۹۶۳۔ ابوداؤد ۲۳۵۳)","Da'if","Musannaf Ibn Abi Shaybah 9681","","","كتاب الصيام"
"9682","(۹۶۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ عَلِیٍّ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَاصَلَ إلَی السَّحَرِ۔ (طبرانی ۱۸۵۔ احمد ۱/۹۱)","Da'if","Musannaf Ibn Abi Shaybah 9682","","","كتاب الصيام"
"9683","(۹۶۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَابِسٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالُوا : إنَّمَا نَہَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْوِصَالِ فِی الصِّیَامِ ، وَالْحِجَامَۃِ لِلصَّائِمِ ، إبْقَائً عَلَی أَصْحَابِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 9683","","","كتاب الصيام"
"9684","(۹۶۸۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ الْحَذَّائِ ، عَنْ أَبِی قِلاَبَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَاہُمْ عَنِ الْوِصَالِ، فَقَالُوا : یَا رَسُولَ اللہِ ، إنَّک تُوَاصِلُ ؟ فَقَالَ : إنِّی لَسْتُ مِثْلَکُمْ ، إنِّی أَبِیت یُطْعِمُنِی رَبِّی وَیَسْقِینِی ، فَإِنْ أَبَیْتُمْ فَمِنَ السَّحَرِ إلَی السَّحَرِ۔","","Musannaf Ibn Abi Shaybah 9684","","","كتاب الصيام"
"9685","(۹۶۸۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ الْوِصَالِ فِی الصِّیَامِ ، فَقَالُوا : إنَّک تُوَاصِلُ ؟ فَقَالَ : إنِّی لَسْتُ مِثْلَکُمْ ، إنِّی أَبِیت یُطْعِمُنِی رَبِّی وَیَسْقِینِی ، أَوْ نَحْوَ ہَذَا۔","","Musannaf Ibn Abi Shaybah 9685","","","كتاب الصيام"
"9686","(۹۶۸۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : لاَ أُوَاصِلُ أَبَدًا۔","Da'if","Musannaf Ibn Abi Shaybah 9686","","","كتاب الصيام"
"9687","(۹۶۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی جَنَابٍ ، عَنْ إسْمَاعِیلَ بْنِ رَجَائٍ ، عَنِ النَّزَّالِ بْنِ سَبْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : لاَ وِصَالَ فِی صِیَامٍ۔","Da'if","Musannaf Ibn Abi Shaybah 9687","","","كتاب الصيام"
"9688","(۹۶۸۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عُمَارَۃَ بْنِ الْقَعْقَاعِ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : سَمِعْتُہُ یَقُولُ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إیَّاکُمْ وَالْوِصَالَ ثَلاَثَ مَرَّاتٍ ، فَقَالُوا : إنَّک تُوَاصِلُ یَا رَسُولَ اللہِ ، قَالَ : لَسْتُمْ فِی ذَالِکُمْ مِثْلِی ، إنِّی أَبِیت یُطْعِمُنِی رَبِّی وَیَسْقِینِی ، فَاکْلفُوا مِنَ الأَعْمَالِ مَا تُطِیقُونَ۔n(بخاری ۱۹۶۶۔ احمد ۲/۲۳۱)","Sahih","Musannaf Ibn Abi Shaybah 9688","","","كتاب الصيام"
"9689","(۹۶۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ قُدَامَۃَ ، قَالَ : قَالَتْ عَائِشَۃُ : (ثُمَّ أَتِمُّوا الصِّیَامَ إلَی اللَّیْلِ) مَعْنَاہَا عَلَی أَنَّہَا کَرِہَتِ الْوِصَالَ۔","","Musannaf Ibn Abi Shaybah 9689","","","كتاب الصيام"
"9690","(۹۶۹۰) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن دَاوُدَ ، عَنْ أَبِی الْعَالِیَۃِ ؛ أَنَّہُ قَالَ فِی الْوِصَالِ فِی الصِّیَامِ : قَالَ اللَّہُ تَبَارَکَ وَتَعَالَی : (ثُمَّ أَتِمُّوا الصِّیَامَ إلَی اللَّیْلِ) ، فَإِذَا جَائَ اللَّیْلُ فَہُوَ مُفْطِرٌ ، ثُمَّ إِنْ شَائَ صَامَ ، وَإِنْ شَائَ تَرَکَ۔","","Musannaf Ibn Abi Shaybah 9690","","","كتاب الصيام"
"9691","(۹۶۹۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ بُکَیرِ بْنِ عَامِرٍ ، قَالَ : کَانَ ابْنُ أَبِی نُعْمٍ یُوَاصِلُ خَمْسَۃَ عَشَرَ یَوْمًا حَتَّی نَعُودَہُ۔","","Musannaf Ibn Abi Shaybah 9691","","","كتاب الصيام"
"9692","(۹۶۹۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَسْوَد بْنِ شَیْبَانَ ، عَنْ أَبِی نَوْفَلِ بْنِ أَبِی عَقْرَبٍ ، قَالَ : دَخَلْتُ عَلَی ابْنِ الزُّبَیْرِ صَبِیحَۃَ خَمْسَۃَ عَشَرَ مِنَ الشَّہْرِ ، وَہُوَ مُوَاصِلٌ۔","Sahih","Musannaf Ibn Abi Shaybah 9692","","","كتاب الصيام"
"9693","(۹۶۹۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ أَبِی خَالِدٍ ، قَالَ : حدَّثَنِی مُحَمَّدُ بْنُ سَعْدِ ، عَنْ سَعْدِ بْنِ أَبِی وَقَّاصٍ ، قَالَ : ضَرَبَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِیَدِہِ عَلَی الأُخْرَی ، ثُمَّ قَالَ : الشَّہْرُ ہَکَذَا وَہَکَذَا ، ثُمَّ نَقَصَ فِی الثَّالِثَۃِ إِصْبَعًا۔ (مسلم ۷۶۴۔ احمد ۱/۱۸۴)","Sahih","Musannaf Ibn Abi Shaybah 9693","","","كتاب الصيام"
"9694","(۹۶۹۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ رَجُلٍ مِنْ بَنِی سُلَیْمٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ عُمَرَ ، قَالَ : اعْتَزَلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نِسَائَہُ شَہْرًا ، فَلَمَّا مَضَی تِسْعٌ وَعِشْرُونَ أَتَاہُ جِبْرِیلُ ، فَقَالَ : إنَّ الشَّہْرَ قَدْ تَمَّ ، وَقَدْ بَرَرْت۔","","Musannaf Ibn Abi Shaybah 9694","","","كتاب الصيام"
"9695","(۹۶۹۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَمْ مَضَی مِنَ الشَّہْرِ ؟ قُلْنَا : مَضَی اثْنَانِ وَعِشْرُونَ یَوْمًا ، وَبَقِیَتْ ثَمَان ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : بَلْ مَضَتَ ثنَتَانِ وَعِشْرُونَ ، وَبَقِیَتْ سَبْعٌ ، الْتَمِسُوہَا اللَّیْلَۃَ ، ثُمَّ قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الشَّہْرُ ہَکَذَا ، وَالشَّہْرُ ہَکَذَا ، ثَلاَثَ مَرَّاتٍ ، وَأَمْسَکَ وَاحِدَۃً۔ (احمد ۲/۲۵۱۔ ابن حبان ۳۴۵۰)","Sahih","Musannaf Ibn Abi Shaybah 9695","","","كتاب الصيام"
"9696","(۹۶۹۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ أَبِی الزُّبَیْرِ، عَنْ جَابِرٍ، قَالَ: حَلَفَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، أَوْ أَقْسَمَ شَہْرًا، فَصَعِدَ عُلیۃ، فَلَمَّا کَانَ تِسْعٌ وَعِشْرُونَ جَائَہُ جِبْرِیلُ، فَقَالَ: انْزِلْ، فَقَدْ تَمَّ الشَّہْرُ۔","Da'if","Musannaf Ibn Abi Shaybah 9696","","","كتاب الصيام"
"9697","(۹۶۹۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الأَسْوَد بْنِ قَیْسٍ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ عَمْرٍو یُحَدِّثُ ، أَنَّہُ سَمِعَ ابْنَ عُمَرَ یُحَدِّثُ عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّا أُمَّۃٌ أُمِّیَّۃٌ ، لاَ نَکْتُبُ وَلاَ نَحْسُبُ ، الشَّہْرُ ہَکَذَا ، وَہَکَذَا ، وَہَکَذَا ، وَعَقَدَ الإِبْہَامَ فِی الثَّالِثَۃِ ؟ وَالشَّہْرُ ہَکَذَا ، وَہَکَذَا ، وَہَکَذَا ، یَعْنِی : تَمَامَ الثَّلاَثِینَ۔ (بخاری ۱۹۱۳۔ مسلم ۷۶۱)","Sahih","Musannaf Ibn Abi Shaybah 9697","","","كتاب الصيام"
"9698","(۹۶۹۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: الشَّہْرُ ہَکَذَا، وَہَکَذَا، وَہَکَذَا، ثُمَّ نقص إبْہَامَہُ ، یَعْنِی: تِسْعًا وَعِشْرِینَ۔(مسلم ۷۵۹۔ ابوداؤد ۲۳۱۴)","Sahih","Musannaf Ibn Abi Shaybah 9698","","","كتاب الصيام"
"9699","(۹۶۹۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حُمَیْدٌ ، عَنْ أَنَسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ آلَی مِنْ نِسَائِہِ شَہْرًا ، فَقَعَدَ فِی مَشْرُبَۃٍ لَہُ ، ثُمَّ نَزَلَ فِی تِسْعٍ وَعِشْرِینَ ، فَقَالُوا : یَا رَسُولَ اللہِ ، إنَّک آلَیْتَ شَہْرًا ؟ فَقَالَ : إنَّ الشَّہْرَ تِسْعٌ وَعِشْرُونَ۔ (بخاری ۱۹۱۱)","Sahih","Musannaf Ibn Abi Shaybah 9699","","","كتاب الصيام"
"9700","(۹۷۰۰) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَنِ الأَسْوَد بْنِ قَیْسٍ ، عَنْ سَعِیدِ بْنِ عَمْرٍو ، أَنَّ عَبْدَ اللہِ بْنَ عُمَرَ حَدَّثَہُمْ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّا أُمَّۃٌ أُمِّیَّۃٌ ، لاَ نَکْتُبُ وَلاَ نَحْسُبُ ، الشَّہْرُ کَذَا ، وَکَذَا ، وَضَرَبَ بِیَدِہِ ثَلاَثًا ، ثُمَّ نَقَصَ وَاحِدَۃً۔ (احمد ۲/۱۲۹)","Sahih","Musannaf Ibn Abi Shaybah 9700","","","كتاب الصيام"
"9701","(۹۷۰۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ یَحْیَی بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الشَّہْرُ تِسْعٌ وَعِشْرُونَ ، ثُمَّ طَبَّقَ بَیْنَ کَفَّیْہِ مَرَّتَیْنِ ، وَطَبَّقَ الثَّالِثَۃَ ، وَقَبَضَ الإِبْہَامَ ، فَقَالَتْ عَائِشَۃُ : غَفَرَ اللَّہُ لأَبِی عَبْدِ الرَّحْمَنِ ، إنَّمَا ہَجَرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نِسَائَہُ شَہْرًا ، فَنَزَلَ لِتِسْعٍ وَعِشْرِینَ ، فَقَالُوا : یَا رَسُولَ اللہِ ، إنَّک آلَیْتَ شَہْرًا ؟ فَقَالَ : وَإنَّ الشَّہْرَ یَکُونُ تِسْعًا وَعِشْرِینَ۔ (احمد ۲/۳۱)","Hasan","Musannaf Ibn Abi Shaybah 9701","","","كتاب الصيام"
"9702","(۹۷۰۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنِ الرُّکَیْنِ ، عَنْ حُصَیْنِ بْنِ قَبِیصَۃَ ، عَنْ عَلِیٍّ ، قَالَ : شَہْرٌ تِسْعٌ وَعِشْرُونَ ، وَشَہْرٌ ثَلاَثُونَ۔","Hasan","Musannaf Ibn Abi Shaybah 9702","","","كتاب الصيام"
"9703","(۹۷۰۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ دَاوُدَ بْنِ یَزِیدَ ، عَنِ الشَّعْبِیِّ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : سَمِعْتُ عُمَرَ یَقُولُ : الشہُور ؛ شَہْرٌ ثَلاَثُونَ ، وَشَہْرٌ تِسْعٌ وَعِشْرُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 9703","","","كتاب الصيام"
"9704","(۹۷۰۴) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنِ الْجُرَیْرِیِّ، عَنْ أَبِی مُصْعَبٍ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: رَمَضَانُ تِسْعٌ وَعِشْرُونَ۔","Hasan","Musannaf Ibn Abi Shaybah 9704","","","كتاب الصيام"
"9705","(۹۷۰۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ حُمَیْدٍ ، عَنِ الْوَلِیدِ بْنِ عُیینۃَ ، قَالَ : صُمْنَا رَمَضَانَ فِی عَہْدِ عَلِیٍّ عَلَی غَیْرِ رُؤْیَۃِ ، ثَمَانِیَۃ وَعِشْرِینَ یَوْمًا ، فَلَمَّا کَانَ یَوْمُ الْفِطْرِ أَمَرَنَا أَنْ نَقْضِیَ یَوْمًا۔","Da'if","Musannaf Ibn Abi Shaybah 9705","","","كتاب الصيام"
"9706","(۹۷۰۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، قَالَ : مَا صُمْنَا تِسْعًا وَعِشْرِینَ ، أَکْثَرَ مِمَّا صُمْنَا ثَلاَثِینَ۔","","Musannaf Ibn Abi Shaybah 9706","","","كتاب الصيام"
"9707","(۹۷۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ ذَرٍّ ، عَنْ یَزِیدَ بْنِ حُلَیْلٍ ، قَالَ : الصَّائِمُ إذَا أُکِلَ عِنْدَہُ الطَّعَامُ ، سَبَّحَتْ مَفَاصِلُہُ۔","","Musannaf Ibn Abi Shaybah 9707","","","كتاب الصيام"
"9708","(۹۷۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ حَبِیبِ بْنِ زَیْدٍ ، عَنِ امْرَأَۃٍ یُقَالُ لَہَا : لَیْلَی ، عَنْ أُمِّ عُمَارَۃَ ، قَالَتْ : أتَانَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقُرِّبَ إلَیْہِ طَعَامٌ ، فَکَانَ بَعْضُ مَنْ عِنْدَہُ صِیَامًا ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ الصَّائِمَ إذَا أُکِلَ عِنْدَہُ الطَّعَامُ ، صَلَّتْ عَلَیْہِ الْمَلاَئِکَۃُ۔ (ترمذی ۷۸۶۔ احمد ۶/۳۶۵)","Da'if","Musannaf Ibn Abi Shaybah 9708","","","كتاب الصيام"
"9709","(۹۷۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إسْمَاعِیلَ بْنِ سَا??ِمٍ ، عَنْ مُجَاہِدٍ ، قَالَ : الصَّائِمُ إذَا أُکِلَ عِنْدَہُ سَبَّحَتْ مَفَاصِلُہُ۔","","Musannaf Ibn Abi Shaybah 9709","","","كتاب الصيام"
"9710","(۹۷۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی أَیُّوبَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : الصَّائِمُ إذَا أُکِلَ عِنْدَہُ صَلَّتْ عَلَیْہِ الْمَلاَئِکَۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 9710","","","كتاب الصيام"
"9711","(۹۷۱۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ أَبِی فَاخِتَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الْمُعْتَکِفُ عَلَیْہِ الصَّوْمُ۔","","Musannaf Ibn Abi Shaybah 9711","","","كتاب الصيام"
"9712","(۹۷۱۲) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، قَالَ : لاَ اعْتِکَافَ إِلاَّ بِصَوْمٍ۔","","Musannaf Ibn Abi Shaybah 9712","","","كتاب الصيام"
"9713","(۹۷۱۳) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنِ الْحَکَمِ ، عَنْ مِقسَم ، عَنِ ابْنِ عَبَّاسٍ ، وَعَائِشَۃَ ، قَالاَ : لاَ اعْتِکَافَ إِلاَّ بِصَوْمٍ ، وَقَالَ عَلِیٌّ ، وَابْنُ مَسْعُودٍ : لَیْسَ عَلَیْہِ صَوْمٌ ، إِلاَّ أَنْ یَفْرِضَہُ ہُوَ عَلَی نَفْسِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 9713","","","كتاب الصيام"
"9714","(۹۷۱۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ اعْتِکَافَ إِلاَّ بِصوم","Da'if","Musannaf Ibn Abi Shaybah 9714","","","كتاب الصيام"
"9715","(۹۷۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبٍ ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ ؛ بِمِثْلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 9715","","","كتاب الصيام"
"9716","(۹۷۱۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ، وَعَبْدِ اللہِ ، قَالاَ : الْمُعْتَکِفُ لَیْسَ عَلَیْہِ صَوْمٌ ، إِلاَّ أَنْ یَشْتَرِطَ ذَلِکَ عَلَی نَفْسِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 9716","","","كتاب الصيام"
"9717","(۹۷۱۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الصَّوْمُ عَلَیْہِ وَاجِبٌ۔","Da'if","Musannaf Ibn Abi Shaybah 9717","","","كتاب الصيام"
"9718","(۹۷۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : لاَ اعْتِکَافَ إِلاَّ بِصَوْمٍ۔","","Musannaf Ibn Abi Shaybah 9718","","","كتاب الصيام"
"9719","(۹۷۱۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَمْ یَکُنْ یُرَی اعْتِکَافٌ إِلاَّ بِصَوْمٍ۔","","Musannaf Ibn Abi Shaybah 9719","","","كتاب الصيام"
"9720","(۹۷۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : قَالَ عَلِیٌّ : عَلَی الْمُعْتَکِفِ الصَّوْمُ ، وَإِنْ لَمْ یَفْرِضْہُ عَلَی نَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 9720","","","كتاب الصيام"
"9721","(۹۷۲۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ قَالَ : لَیْسَ عَلَیْہِ صَوْمٌ ، إِلاَّ أَنْ یَکُونَ أَوْجَبَ ذَلِکَ عَلَی نَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 9721","","","كتاب الصيام"
"9722","(۹۷۲۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِید ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ؛ مِثْل قَوْلِ إبْرَاہِیمَ۔","","Musannaf Ibn Abi Shaybah 9722","","","كتاب الصيام"
"9723","(۹۷۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ اعْتِکَافَ إِلاَّ بِصَوْمٍ۔","","Musannaf Ibn Abi Shaybah 9723","","","كتاب الصيام"
"9724","(۹۷۲۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : إِذَا اعْتَکَفَ الرَّجُلُ فَلْیَشْہَد الْجُمُعَۃَ ، وَلْیَعُد الْمَرِیضَ ، وَلْیَحْضَر الْجِنَازَۃَ ، وَلْیَأْتِ أَہْلَہُ ، وَلْیَأْمُرْہُمْ بِالْحَاجَۃِ وَہُوَ قَائِمٌ۔","Hasan","Musannaf Ibn Abi Shaybah 9724","","","كتاب الصيام"
"9725","(۹۷۲۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: أَخْبَرَنَا الشَّیْبَانِیُّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّہُ قَالَ: یَشْہَد الْجُمُعَۃَ ، وَیَعُود الْمَرِیضَ، وَیُجِیب الإِمَامَ۔","","Musannaf Ibn Abi Shaybah 9725","","","كتاب الصيام"
"9726","(۹۷۲۶) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الزُّہْرِیِّ ، قَالَ : حَدَّثَتْنَا عَمْرَۃُ ، عَنْ عَائِشَۃَ ؛ کَانَتْ لاَ تَعُودُ الْمَرِیضَ مِنْ أَہْلِہَا وَہِیَ مُعْتَکِفَۃٌ ، إِلاَّ وَہِیَ مَارَّۃٌ۔","","Musannaf Ibn Abi Shaybah 9726","","","كتاب الصيام"
"9727","(۹۷۲۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : یَشْہَدُ الْجُمُعَۃَ ، وَیَعُودُ الْمَرِیضَ ، وَیَشْہَدُ الْجِنَازَۃَ ، وَیَخْرُجُ إلَی الْحَاجَۃِ ، وَیُجِیبُ الإِمَامَ ، وَذَلِکَ أَنَّ عَمْرَو بْنَ حُرَیْثٍ أرْسلَ إلَیْہِ وَہُوَ مُعْتَکِفٌ فَلَمْ یَأْتِہِ ، فَأَرْسَلَ إلَیْہِ فَأَتَاہُ۔","","Musannaf Ibn Abi Shaybah 9727","","","كتاب الصيام"
"9728","(۹۷۲۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یُحِبُّونَ لِلْمُعْتَکِفِ أَنْ یَشْتَرِطَ ہَذِہِ الْخِصَالَ وَہِیَ لَہُ وَإِنْ لَمْ یَشْتَرِطْ ؛ عِیَادَۃَ الْمَرِیضِ ، وَأَنْ یَتَّبِعَ الْجِنَازَۃَ ، وَیَشْہَدَ الْجُمُعَۃَ۔","","Musannaf Ibn Abi Shaybah 9728","","","كتاب الصيام"
"9729","(۹۷۲۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : یَخْرُجُ إلَی الْغَائِطِ ، وَیَعُودُ الْمَرِیضَ ، وَیَأْتِی الْجُمُعَۃَ ، وَیَقُومُ عَلَی الْبَابِ۔","","Musannaf Ibn Abi Shaybah 9729","","","كتاب الصيام"
"9730","(۹۷۳۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : یَأْتِی الْجُمُعَۃَ۔","","Musannaf Ibn Abi Shaybah 9730","","","كتاب الصيام"
"9731","(۹۷۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : الْمُعْتَکِفُ یَعُودُ الْمَرِیضَ ، وَیَشْہَدُ الْجُمُعَۃَ ، وَیَقُومُ مَعَ الرَّجُلِ فِی الطَّرِیقِ یُسائلہ۔","","Musannaf Ibn Abi Shaybah 9731","","","كتاب الصيام"
"9732","(۹۷۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ ، عَنِ الْحَسَنِ ، قَالَ : یَأْتِی الْغَائِطَ ، وَیَتَّبِعُ الْجِنَازَۃَ ، وَیَعُودُ الْمَرِیضَ۔","","Musannaf Ibn Abi Shaybah 9732","","","كتاب الصيام"
"9733","(۹۷۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : یَشْہَدُ الْجُمُعَۃَ ، وَیَعُودُ الْمَرِیضَ ، وَیَحْضُرُ الْجِنَازَۃَ ، قَالَ مَرَّۃً : وَیُجِیبُ الإِمَامَ۔","","Musannaf Ibn Abi Shaybah 9733","","","كتاب الصيام"
"9734","(۹۷۳۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخبرنَا سُفْیَانُ بْنُ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ: کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا کَانَ مُعْتَکِفًا لَمْ یَدْخُلِ الْبَیْتَ ، إِلاَّ لِحَاجَۃٍ۔ (بخاری ۲۰۲۹۔ احمد ۶/۲۳۵)","Da'if","Musannaf Ibn Abi Shaybah 9734","","","كتاب الصيام"
"9735","(۹۷۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ ، عَنْ عَمْرَۃَ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَانَتْ تَمُرُّ بِالْمَرِیضِ مِنْ أَہْلِہَا وَہِیَ مُعْتَکِفَۃٌ ، فَلاَ تَعْرِضُ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9735","","","كتاب الصيام"
"9736","(۹۷۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ (ح) وَعَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالاَ : الْمُعْتَکِفُ لاَ یَشْہَدُ جِنَازَۃً ، وَلاَ یَعُودُ مَرِیضًا۔","","Musannaf Ibn Abi Shaybah 9736","","","كتاب الصيام"
"9737","(۹۷۳۷) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ، قَالَ: لاَ یَتَّبِعُ جِنَازَۃً، وَلاَ یَعُودُ مَرِیضًا، وَلاَ یُجِیبُ دَعْوَۃً۔","","Musannaf Ibn Abi Shaybah 9737","","","كتاب الصيام"
"9738","(۹۷۳۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : الْمُعْتَکِفُ لاَ یَتَّبِعُ جِنَازَۃً ، وَلاَ یَعُودُ مَرِیضًا۔","","Musannaf Ibn Abi Shaybah 9738","","","كتاب الصيام"
"9739","(۹۷۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : لاَ یُجِیبُ دَعْوَۃً ، وَلاَ یَعُودُ مَرِیضًا ، وَلاَ یَحْضُرُ جِنَازَۃً۔","","Musannaf Ibn Abi Shaybah 9739","","","كتاب الصيام"
"9740","(۹۷۴۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَمْرَۃَ ، عَنْ عَائِشَۃَ قَالَتْ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا أَرَادَ أَنْ یَعْتَکِفَ صَلَّی الصُّبْحَ ، ثُمَّ دَخَلَ الْمَکَانَ الَّذِی یَعْتَکِفُ فِیہِ۔(مسلم ۸۳۱۔ ابوداؤد ۲۴۵۶)","Hasan","Musannaf Ibn Abi Shaybah 9740","","","كتاب الصيام"
"9741","(۹۷۴۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَرَادَ الرَّجُل أَنْ یَعْتَکِفَ ، فَلْتَغْرُبْ لَہُ الشَّمْسُ مِنَ اللَّیْلَۃِ الَّتِی یُرِیدُ أَنْ یَعْتَکِفَ فِیہَا وَہُوَ فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 9741","","","كتاب الصيام"
"9742","(۹۷۴۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ؛ فِی الْمُعْتَکِفِ یَشْتَرِطُ أَنْ یَعْتَکِفَ بِالنَّہَارِ وَیَأْتِیَ أَہْلَہُ بِاللَّیْلِ ، قَالَ : لَیْسَ ہَذَا بِاعْتِکَافٍ۔","","Musannaf Ibn Abi Shaybah 9742","","","كتاب الصيام"
"9743","(۹۷۴۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا لِلْمُعْتَکِفِ أَنْ یَشْتَرِطَ أَنْ یَتَعَشَّی فِی أَہْلِہِ وَیَتَسَحَّرَ۔","","Musannaf Ibn Abi Shaybah 9743","","","كتاب الصيام"
"9744","(۹۷۴۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إِنْ شَائَ اشْتَرَطَ أَنْ یَتَعَشَّی فِی أَہْلِہِ ، وَلاَ یَدْخُلُ ظِلَّہُ ، وَلَکِنْ یُؤْتَی بِعَشَائِہِ فِی فِنَائِ دَارِہِ۔","","Musannaf Ibn Abi Shaybah 9744","","","كتاب الصيام"
"9745","(۹۷۴۵) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ یَعْلَی بْنِ أُمَیَّۃَ ؛ أَنَّہُ کَانَ یَقُولُ لِصَاحِبِہِ : انْطَلِقْ بِنَا إلَی الْمَسْجِدِ فَنَعْتَکِفُ فِیہِ سَاعَۃً۔","","Musannaf Ibn Abi Shaybah 9745","","","كتاب الصيام"
"9746","(۹۷۴۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : کَانَ ابْنُ عُمَرَ إذَا أَرَادَ أَنْ یَعْتَکِفَ ضَرَبَ خِبَائً ، أَوْ فُسْطَاطًا فَقَضَی فِیہِ حَاجَتَہُ ، وَلاَ یَأْتِی أَہْلَہُ ، وَلاَ یَدْخُلُ سَقْفًا۔","Sahih","Musannaf Ibn Abi Shaybah 9746","","","كتاب الصيام"
"9747","(۹۷۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زِیَادِ بْنِ عِلاَقَۃَ ، عَنْ عَمِّہِ قُطْبَۃَ بْنِ مَالِکٍ ؛ أَنَّ عُمَرَ رَأَی قَوْمًا اعْتَکَفُوا فِی الْمَسْجِدِ ، وَقَدْ سُتِرُوا فَأَنْکَرَہُ ، وَقَالَ : مَا ہَذَا ؟ قَالُوا : إنَّمَا نَسْتُرُہُ عَلَی طَعَامِنَا ، قَالَ : فَاسْتُرُوہُ ، فَإِذَا طَعِمْتُمْ فَاہْتِکُوہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9747","","","كتاب الصيام"
"9748","(۹۷۴۸) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَّائٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عِکْرِمَۃَ ، قَالَ : الْمُعْتَکِفُ لاَ یَدْخُلُ بَیْتًا مُسَقَّفًا۔","","Musannaf Ibn Abi Shaybah 9748","","","كتاب الصيام"
"9749","(۹۷۴۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یَدْخُلُ سَقْفًا۔","","Musannaf Ibn Abi Shaybah 9749","","","كتاب الصيام"
"9750","(۹۷۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : لاَ یَدْخُلُ دَارًا۔","","Musannaf Ibn Abi Shaybah 9750","","","كتاب الصيام"
"9751","(۹۷۵۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ یَدْخُلُ بَیْتًا۔","","Musannaf Ibn Abi Shaybah 9751","","","كتاب الصيام"
"9752","(۹۷۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یَدْخُلُ بَیْتًا۔","","Musannaf Ibn Abi Shaybah 9752","","","كتاب الصيام"
"9753","(۹۷۵۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ؛ أَنَّ أَبَا قِلاَبَۃَ اعْتَکَفَ فِی مَسْجِدِ قَوْمِہِ۔","","Musannaf Ibn Abi Shaybah 9753","","","كتاب الصيام"
"9754","(۹۷۵۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ خَالِدٍ ؛ أَنَّ أَبَا قِلاَبَۃَ فَعَلَہُ۔","","Musannaf Ibn Abi Shaybah 9754","","","كتاب الصيام"
"9755","(۹۷۵۵) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الشَّیْبَانِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ اعْتَکَفَ فِی مَسْجِدِ قَوْمِہِ۔","","Musannaf Ibn Abi Shaybah 9755","","","كتاب الصيام"
"9756","(۹۷۵۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ اعْتَکَفَ فِی مَسْجِدِ قَوْمِہِ۔","","Musannaf Ibn Abi Shaybah 9756","","","كتاب الصيام"
"9757","(۹۷۵۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ ہَمَّامِ بْنِ الْحَارِثِ ؛ أَنَّہُ اعْتَکَفَ فِی مَسْجِدِ قَوْمِہِ۔","","Musannaf Ibn Abi Shaybah 9757","","","كتاب الصيام"
"9758","(۹۷۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِالاِعْتِکَافِ فِی مَسَاجِدِ الْقَبَائِلِ۔","","Musannaf Ibn Abi Shaybah 9758","","","كتاب الصيام"
"9759","(۹۷۵۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنْ یَحْیَی ، عَنْ أَبِی سَلَمَۃَ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَعْتَکِفَ فِی مَسْجِدٍ یُصَلَّی فِیہِ۔","","Musannaf Ibn Abi Shaybah 9759","","","كتاب الصيام"
"9760","(۹۷۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزَّعْرَائِ ؛ أَنَّ أَبَا الأَحْوَصِ اعْتَکَفَ فِی مَسْجِدِ قَوْمِہِ۔","","Musannaf Ibn Abi Shaybah 9760","","","كتاب الصيام"
"9761","(۹۷۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : إِنْ شَائَ اعْتَکَفَ فِی مَسْجِدِ قَوْمِہِ۔","","Musannaf Ibn Abi Shaybah 9761","","","كتاب الصيام"
"9762","(۹۷۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ وَاصِلٍ الأَحْدَبِ ، عَنْ إبْرَاہِیمَ ، قَالَ : جَائَ حُذَیْفَۃُ إلَی عَبْدِ اللہِ ، فَقَالَ: أَلاَ أَعْجَبَک مِنْ قَوْمٍ عُکُوفٍ بَیْنَ دَارِکَ وَبَیْنَ دَارِ الأَشْعَرِیِّ، یَعْنِی: الْمَسْجِدَ؟ قَالَ عَبْدُ اللہِ :فَلَعَلَّہُمْ أَصَابُوا وَأَخْطَأْت ، فَقَالَ حُذَیْفَۃُ : أَمَا عَلِمْت أَنَّہُ لاَ اعْتِکَافَ إِلاَّ فِی ثَلاَثَۃِ مَسَاجِدَ ؛ الْمَسْجِدِ الْحَرَامِ ، وَالْمَسْجِدِ الأَقْصَی ، وَمَسْجِدِ الرَّسُولِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَمَا أُبَالِی اعْتَکَفْتُ فِیہِ ، أَوْ فِی سُوقِکُمْ ہَذِہِ۔","","Musannaf Ibn Abi Shaybah 9762","","","كتاب الصيام"
"9763","(۹۷۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ (ح) وَعَنْ جَابِرٍ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ عَلِیٍّ ، قَالَ : لاَ اعْتِکَافَ إِلاَّ فِی مِصْرٍ جَامِعٍ۔","Da'if","Musannaf Ibn Abi Shaybah 9763","","","كتاب الصيام"
"9764","(۹۷۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ ، عَنْ شَدَّادِ بْنِ الأَزْمَعِ ، قَالَ : اعْتَکَفَ رَجُلٌ فِی الْمَسْجِدِ الأَعْظَمِ وَضَرَبَ خَیْمَۃً فَحَصَبَہُ النَّاسُ ، فَبَلَغَ ذَلِکَ ابْنَ مَسْعُودٍ ، فَأَرْسَلَ إلَیْہِ رَجُلاً ، فَکَفَّ النَّاسَ عَنْہُ وَحَسَّنَ ذَلِکَ۔","Hasan","Musannaf Ibn Abi Shaybah 9764","","","كتاب الصيام"
"9765","(۹۷۶۵) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ، عَنْ ہَمَّامٍ، عَنْ قَتَادَۃَ، عَنِ ابْنِ الْمُسَیَّبِ، قَالَ: لاَ اعْتِکَافَ إِلاَّ فِی مَسْجِدِ نَبِیٍّ۔","","Musannaf Ibn Abi Shaybah 9765","","","كتاب الصيام"
"9766","(۹۷۶۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ اعْتِکَافَ إِلاَّ فِی مَسْجِدِ جَمَاعَۃٍ یُجْمَعُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 9766","","","كتاب الصيام"
"9767","(۹۷۶۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنِ الاِعْتِکَافِ ؟ فَقَالاَ : لاَ تَعْتَکِف إِلاَّ فِی مَسْجِدٍ یُجَمِّعُونَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 9767","","","كتاب الصيام"
"9768","(۹۷۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مَعْمَرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : لاَ اعْتِکَافَ إِلاَّ فِی مَسْجِدٍ یُجْمَعُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 9768","","","كتاب الصيام"
"9769","(۹۷۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : لاَ اعْتِکَافَ إِلاَّ فِی مَسْجِدِ جَمَاعَۃٍ۔","","Musannaf Ibn Abi Shaybah 9769","","","كتاب الصيام"
"9770","(۹۷۷۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ؛ أَنَّہُ أُوتِیَ یَوْمَ الْفِطْرِ فِی مَسْجِدِ قَوْمِہِ ، وَاعْتَکَفَ فِیہِ بِجُوَیْریۃٍ مُزَیَّنَۃٍ فَأَقْعَدَہَا فِی حِجْرِہِ ، ثُمَّ اعْتَنَقَہَا وَخَرَجَ إلَی الْمُصَلَّی کَمَا ہُوَ مِنَ الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 9770","","","كتاب الصيام"
"9771","(۹۷۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ لِلْمُعْتَکِفِ أَنْ یَبِیتَ لَیْلَۃَ الْفِطْرِ فِی مَسْجِدِہِ ، حَتَّی یَکُونَ غُدُوُّہُ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 9771","","","كتاب الصيام"
"9772","(۹۷۷۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : بِتْ لَیْلَۃَ الْفِطْرِ فِی الْمَسْجِدِ الَّذِی اعْتَکَفْت فِیہِ ، حَتَّی یَکُونَ غُدُوُّک إلَی مُصلاَّکَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 9772","","","كتاب الصيام"
"9773","(۹۷۷۳) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنِ ابْنِ أَبِی نَجِیحٍ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: إذَا جَامَعَ الْمُعْتَکِفُ، أَبْطَلَ اعْتِکَافَہُ وَاسْتَأْنَفَ۔","Sahih","Musannaf Ibn Abi Shaybah 9773","","","كتاب الصيام"
"9774","(۹۷۷۴) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ عَطَائٍ ، قَالَ : یَقْضِی اعْتِکَافَہُ۔","","Musannaf Ibn Abi Shaybah 9774","","","كتاب الصيام"
"9775","(۹۷۷۵) حَدَّثَنَا ابْنُ الدَّرَاوَرْدِیِّ، عَنْ مُوسَی بْنِ أَبِی مَعْبَدٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، وَالْقَاسِمِ، وَسَالِمٍ، قَالُوا: یَسْتَقْبِلُ۔","","Musannaf Ibn Abi Shaybah 9775","","","كتاب الصيام"
"9776","(۹۷۷۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ غَشِیَ امْرَأَتَہُ وَہُوَ مُعْتَکِفٌ ، أَنَّہُ بِمَنْزِلَۃِ الَّذِی غَشِیَ فِی رَمَضَانَ ، عَلَیْہِ مَا عَلَی الَّذِی أَصَابَ فِی رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 9776","","","كتاب الصيام"
"9777","(۹۷۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنِ الضَّحَّاکِ ، قَالَ : کَانُوا یُجَامِعُونَ وَہُمْ مُعْتَکِفُونَ حَتَّی نَزَلَتْ : {وَلاَ تُبَاشِرُوہُنَّ وَأَنْتُمْ عَاکِفُونَ فِی الْمَسَاجِدِ}۔","","Musannaf Ibn Abi Shaybah 9777","","","كتاب الصيام"
"9778","(۹۷۷۸) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : مَنْ أَصَابَ امْرَأَتَہُ وَہُوَ مُعْتَکِفٌ ، فَعَلَیْہِ مِنَ الْکَفَّارَۃِ مِثْلُ مَا عَلَی الَّذِی یُصِیبُ فِی رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 9778","","","كتاب الصيام"
"9779","(۹۷۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ بُکَیْرِ بْنِ الأَخْنَسِ ، عَنْ مُجَاہِدٍ ؛ فِی الْمُعْتَکِفِ إذَا جَامَعَ ، قَالَ : یَتَصَدَّقُ بِدِینَارَین۔","","Musannaf Ibn Abi Shaybah 9779","","","كتاب الصيام"
"9780","(۹۷۸۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ؛ فِی امْرَأَۃٍ نَذَرَتْ أَنْ تَعْتَکِفَ خَمْسِینَ یَوْمًا ، فَاعْتَکَفَتْ أَرْبَعِینَ ، ثُمَّ جَائَ زَوْجُہَا فَأَرْسَلَ إلَیْہَا فَأَتَتْہُ ، قَالَ : تُتِمُّ مَا بَقِیَ۔","","Musannaf Ibn Abi Shaybah 9780","","","كتاب الصيام"
"9781","(۹۷۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَطَائٍ ، أَنَّہُ کَرِہَ لِلْمُعْتَکِفِ أَنْ یُقَبِّلَ ، أَوْ یُبَاشِرَ۔","","Musannaf Ibn Abi Shaybah 9781","","","كتاب الصيام"
"9782","(۹۷۸۲) حَدَّثَنَا الفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یُقَبِّلُ الْمُعْتَکِفُ ، وَلاَ یُبَاشِرُ۔","","Musannaf Ibn Abi Shaybah 9782","","","كتاب الصيام"
"9783","(۹۷۸۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : الْمُعْتَکِفُ لاَ یَبِیعُ ، وَلاَ یَبْتَاعُ۔","","Musannaf Ibn Abi Shaybah 9783","","","كتاب الصيام"
"9784","(۹۷۸۴) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمَّارِ بْنِ عَبْدِ اللہِ بْنِ یَسَارٍ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا أَعَانَ جَعْدَۃَ بْنَ ہُبَیْرَۃَ بِسَبْعِ مِئَۃ دِرْہَمٍ مِنْ عَطَائِہِ فِی ثَمَنِ خَادِمٍ لَہُ ، فَسَأَلَہُ : ہَلَ ابْتَعْتَ خَادِمًا ؟ قَالَ : أَنَا مُعْتَکِفٌ ، قَالَ : وَمَا عَلَیْک لََوْ أَتَیْتَ السُّوقَ ، فَابْتَعْت خَادِمًا۔","Da'if","Musannaf Ibn Abi Shaybah 9784","","","كتاب الصيام"
"9785","(۹۷۸۵) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ لَیْثٍ ، قَالَ : سُئِلَ طَاوُوس عَنِ امْرَأَۃٍ مَاتَتْ وَعَلَیْہَا أَنْ تَعْتَکِفَ سَنَۃً فِی الْمَسْجِدِ الْحَرَامِ ، وَلَہَا أَرْبَعَۃُ بَنُونَ ، کُلُّہُمْ یُحِبُّ أَنْ یَقْضِیَ عَنْہَا ؟ قَالَ طَاوُوس : اعْتَکِفُوا أَرْبَعَتُکُمْ فِی الْمَسْجِدِ الْحَرَامِ ، ثَلاَثَۃَ أَشْہُرٍ ، وَصُومُوا۔","","Musannaf Ibn Abi Shaybah 9785","","","كتاب الصيام"
"9786","(۹۷۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : لاَ یُقْضَی عَنِ الْمَیِّتِ اعْتِکَافُ۔","","Musannaf Ibn Abi Shaybah 9786","","","كتاب الصيام"
"9787","(۹۷۸۷) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ ؛ أَنَّ أُمَّہُ نَذَرَتْ أَنْ تَعْتَکِفَ عَشْرَۃَ أَیَّامٍ ، فَمَاتَتْ وَلَمْ تَعْتَکِفْ ، فَقَالَ ابْنُ عَبَّاسٍ : اعْتَکِفْ عَنْ أُمِّک۔","","Musannaf Ibn Abi Shaybah 9787","","","كتاب الصيام"
"9788","(۹۷۸۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ عَامِرِ بْنِ مُصْعَبٍ ؛ أَنَّ عَائِشَۃَ اعْتَکَفَتْ عَنْ أَخِیہَا بَعْدَ مَا مَاتَ۔","Da'if","Musannaf Ibn Abi Shaybah 9788","","","كتاب الصيام"
"9789","(۹۷۸۹) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، قَالَ : حدَّثَنَا حَجَّاجٌ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالْمُعْتَکِفِ أَنْ یَغْسِلَ ثِیَابَہُ وَیَخِیطَہَا۔","","Musannaf Ibn Abi Shaybah 9789","","","كتاب الصيام"
"9790","(۹۷۹۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا سُفْیَانُ بْنُ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا کَانَ مُعْتَکِفًا ، لَمْ یَدْخُلِ الْبَیْتَ إِلاَّ لِحَاجَۃٍ ، قَالَتْ : فَغَسَلْتُ رَأْسَہُ ، وَإِنَّ بَیْنِی وَبَیْنَہُ لَعَتَبَۃَ الْبَابِ۔ (بخاری ۲۹۵۔ ابوداؤد ۲۴۶۱)","Da'if","Musannaf Ibn Abi Shaybah 9790","","","كتاب الصيام"
"9791","(۹۷۹۱) حَدَّثَنَا جَرِیرٌ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ، قَالَ: إذَا حَاضَتِ الْمُعْتَکِفَۃُ ضَرَبَتْ فِی دَارِہَا سِتْرًا، فَکَانَتْ فِیہِ۔","","Musannaf Ibn Abi Shaybah 9791","","","كتاب الصيام"
"9792","(۹۷۹۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ خَالِدٍ، عَنْ أَبِی قِلاَبَۃَ، قَالَ: الْمُعْتَکِفَۃُ تَضْرِبُ بِنَاہَا عَلَی بَابِ الْمَسْجِدِ إذَا حَاضَتْ۔","","Musannaf Ibn Abi Shaybah 9792","","","كتاب الصيام"
"9793","(۹۷۹۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ الْحَذَّائِ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ بَعْضَ أَزْوَاجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَتْ مُسْتَحَاضَۃً وَہِیَ عَاکِفٌ۔","Sahih","Musannaf Ibn Abi Shaybah 9793","","","كتاب الصيام"
"9794","(۹۷۹۴) حَدَّثَنَا عَبَّادٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَدْخُلَ الْمُعْتَکِفُ الْقَبْرَ۔","","Musannaf Ibn Abi Shaybah 9794","","","كتاب الصيام"
"9795","(۹۷۹۵) حَدَّثَنَا شَرِیکٌ ، عَنْ سَالِمٍ ؛ قَالَ : صَنَعَ طَعَامًا فَأَرْسَلَ إلَی سَعِیدِ بْنِ جُبَیْرٍ ، فَقَالَ : إنِّی صَائِمٌ ، فَحَدَّثَہُ بِحَدِیثِ سَلْمَانَ ؛ أَنَّہُ فَطَّرَ أَبَا الدَّرْدَائِ ، فَأَفْطَرَ۔","","Musannaf Ibn Abi Shaybah 9795","","","كتاب الصيام"
"9796","(۹۷۹۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ وَبَرَۃَ ، عَنْ خَرَشَۃَ بْنِ الْحُرِّ ، قَالَ : کُنَّا عِنْدَ عُمَرَ فَأُتِیَ بِطَعَامٍ ، فَقَالَ لِلْقَوْمِ : اِطْعِمُوا ، فَکُلُّہُمْ یَقُولُ : إنِّی صَائِمٌ ، فَعَزَمَ عَلَیْہِمْ أَنْ یُفْطِرُوا ، فَأَفْطَرُوا۔","","Musannaf Ibn Abi Shaybah 9796","","","كتاب الصيام"
"9797","(۹۷۹۷) حَدَّثَنَا ابْنُ مُبَارَکٍ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ، قَالَ: سَأَلَہُ سُلَیمَان بْن مُوسَی أَکَانَ یُفْطِرُ الرَّجُلُ لِضَیْفِہِ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 9797","","","كتاب الصيام"
"9798","(۹۷۹۸) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : أَخْبَرَنَا أَشْعَثُ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یُرَخِّصُ لِلرَّجُلِ الصَّائِمِ إذَا نَزَلَ بِہِ الضَّیْفُ أَنْ یُفْطِرَ ، وَیَقْضِیَ یَوْمًا مَکَانَہُ۔","","Musannaf Ibn Abi Shaybah 9798","","","كتاب الصيام"
"9799","(۹۷۹۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنِ الرَّجُلِ یَصُومُ تَطَوُّعًا فَنَہَتْہُ أُمُّہُ ؟ قَالاَ : یُطِیعُہَا ، وَیَصُومُ أَحْیَانًا۔","","Musannaf Ibn Abi Shaybah 9799","","","كتاب الصيام"
"9800","(۹۸۰۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ لَہُ : إنَّ أُمِّی تُقْسِمُ عَلَیَّ أَنْ لاَ أُصَلِّیَ بَعْدَ الْمَکْتُوبَۃِ شَیْئًا ، وَلاَ أَصُوم إِلاَّ فَرِیضَۃً ، شَفَقَۃً عَلَیَّ ؟ قَالَ : أَبْرِرْ قَسَمَہَا۔","","Musannaf Ibn Abi Shaybah 9800","","","كتاب الصيام"
"9801","(۹۸۰۱) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : سَأَلْتُ مَکْحُولاً عَنْ رَجُلٍ أَصْبَحَ صَائِمًا ، ثُمَّ عَزَمَتْ عَلَیْہِ أُمُّہُ أَنْ یُفْطِرَ ؟ کَأَنَّہُ کَرِہَ ذَلِکَ ، وَقَالَ : یَصُومُ یَوْمًا مَکَانَہُ۔","","Musannaf Ibn Abi Shaybah 9801","","","كتاب الصيام"
"9802","(۹۸۰۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : أَتَتِ امْرَأَۃٌ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : یَا نَبِیَّ اللہِ ، مَا حَقُّ الزَّوْجِ عَلَی زَوْجَتِہِ ؟ قَالَ : لاَ تَصُومُ إِلاَّ بِإِذْنِہِ إِلاَّ الْفَرِیضَۃَ ، فَإِنْ فَعَلَتْ أَثَمَتْ ، وَلَمْ یُقْبَلْ مِنْہَا۔ (ابوداؤد ۱۹۵۱)","Da'if","Musannaf Ibn Abi Shaybah 9802","","","كتاب الصيام"
"9803","(۹۸۰۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، قَالَ : کَتَبَ إلَیْنَا عُمَرُ أَنَّ الْمَرْأَۃَ لاَ تَصُومُ تَطَوُّعًا ، إِلاَّ بِإِذْنِ زَوْجِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 9803","","","كتاب الصيام"
"9804","(۹۸۰۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تَصُومُ تَطَوُّعًا وَہُوَ شَاہِدٌ إِلاَّ بِإِذْنِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 9804","","","كتاب الصيام"
"9805","(۹۸۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیانَ ، عَنْ أَبِی الزِّنَادِ ، عَنْ مُوسَی بْنِ أَبِی عُثْمَانَ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ قَالَ : لاَ تَصُومُ الْمَرْأَۃُ إِلاَّ بِإِذْنِ زَوْجِہَا۔ (بخاری ۵۱۹۵۔ مسلم ۸۴)","Da'if","Musannaf Ibn Abi Shaybah 9805","","","كتاب الصيام"
"9806","(۹۸۰۶) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ أَبِی الْخَلِیلِ ، عَنْ أَبِی قَتَادَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَوْمُ عَرَفَۃَ کَفَّارَۃُ سَنَتَیْنِ : سَنَۃٍ مَاضِیَۃٍ ، وَسَنَۃٍ مُسْتَقْبَلَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 9806","","","كتاب الصيام"
"9807","(۹۸۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مَہْدِیِّ بْنِ مَیْمُونٍ ، عَنْ غَیْلاَنَ بْنِ جَرِیرٍ ، عَنْ عَبْدِ اللہِ بْنِ مَعْبَدٍ الزِّمَّانِیِّ ، عَنْ أَبِی قَتَادَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سُئِلَ عَنْ صِیَامِ عَرَفَۃَ ؟ فَقَالَ : أحْتَسِبُ عَلَی اللہِ کَفَّارَۃَ سَنَتَیْنِ : سَنَۃً مَاضِیَۃً ، وَسَنَۃً مُسْتَقْبَلَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 9807","","","كتاب الصيام"
"9808","(۹۸۰۸) حَدَّثَنَا وَکِیعٌ، عَنْ شُعْبَۃَ، عَنْ أَبِی قَیْسٍ، عَنْ ہُزَیْلٍ، عَنْ مَسْرُوقٍ، عَنْ عَائِشَۃَ؛ أَنَّہَا کَانَتْ تَصُومُ عَرَفَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 9808","","","كتاب الصيام"
"9809","(۹۸۰۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی قَیْسٍ ، عَنْ ہُزَیْلٍ ، عَنْ مَسْرُوق ، عَنْ عَائِشَۃَ قَالَتْ : مَا مِنَ السَّنَۃِ یَوْمٌ أَحَبُّ إلَیَّ أَنْ أَصُومَہُ مِنْ یَوْمِ عَرَفَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 9809","","","كتاب الصيام"
"9810","(۹۸۱۰) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ أَبِی حَفْصٍ الطَّائِفِیِّ ، عَنْ أَبِی حَازِمٍ ، عَنْ سَہْلِ بْنِ سَعْدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَوْمُ عَرَفَۃَ کَفَّارَۃُ سَنَتَیْنِ۔ (ابویعلی ۷۵۴۸۔ طبرانی ۵۹۲۳)","Hasan","Musannaf Ibn Abi Shaybah 9810","","","كتاب الصيام"
"9811","(۹۸۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ یَصُومُ عَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 9811","","","كتاب الصيام"
"9812","(۹۸۱۲) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ إبْرَاہِیمَ ، قَالَ فِی صَوْمِ عَرَفَۃَ فِی الْحَضَرِ: إذَا کَانَ فِیہِ اخْتِلاَفٌ فَلاَ یَصُومَنَّ۔","","Musannaf Ibn Abi Shaybah 9812","","","كتاب الصيام"
"9813","(۹۸۱۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا لاَ یَرَوْنَ بِصَوْمِ عَرَفَۃَ بَأْسًا ، إِلاَّ أَنْ یَتَخَوَّفُوا أَنْ یَکُونَ یَوْمَ الذَّبْحِ۔","","Musannaf Ibn Abi Shaybah 9813","","","كتاب الصيام"
"9814","(۹۸۱۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ مُجَاہِدٍ ، أَنَّ عَائِشَۃَ قَالَتْ : إنَّ صَوْمَ عَرَفَۃَ کَفَّارَۃُ نِصْفِ سَنَۃٍ ، قَالَ : وَقَالَ مُجَاہِدٌ ، قَالَ فُلاَنٌ : کَفَّارَۃُ سَنَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 9814","","","كتاب الصيام"
"9815","(۹۸۱۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حُمَیْدٌ الطَّوِیلُ ، قَالَ : ذُکِرَ عِنْدَ الْحَسَنِ أَنَّ صِیَامَ عَرَفَۃَ یَعْدِلُ صِیَامَ سَنَۃٍ ، فَقَالَ الْحَسَنُ : مَا أَعْلَمُ لِیَوْمٍ فَضْلاً عَلَی یَوْمٍ ، وَلاَ لِلَیْلَۃٍ عَلَی لَیْلَۃٍ ، إِلاَّ لَیْلَۃَ الْقَدْرِ فَإِنَّہَا خَیْرٌ مِنْ أَلْفِ شَہْرٍ ، وَلَقَدْ رَأَیْتُ عُثْمَانَ بْنَ أَبِی الْعَاصِ صَامَ یَوْمَ عَرَفَۃَ ، یَرُشُّ عَلَیْہِ الْمَائَ مِنْ إدَاوَۃٍ مَعَہُ ، یَتَبَرَّدُ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 9815","","","كتاب الصيام"
"9816","(۹۸۱۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ سَعْدِ بْنِ سَعِیدٍ ، قَالَ : سَمِعْتُ عُمَرَ بْنَ ثَابِتٍ ، قَالَ : سَمِعْتُ أَبَا أَیُّوبَ الأَنْصَارِیَّ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ صَامَ رَمَضَانَ ، ثُمَّ أَتْبَعَہُ بِسِتَّۃِ أَیامٍ مِنْ شَوَّالٍ فَقَدْ صَامَ الدَّہْرَ ، أَوْ فَکَأَنَّمَا صَامَ الدَّہْرَ۔ (ترمذی ۷۵۹۔ ابوداؤد ۲۴۲۵)","Sahih","Musannaf Ibn Abi Shaybah 9816","","","كتاب الصيام"
"9817","(۹۸۱۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی مُوسَی ، عَنِ الْحَسَنِ ، قَالَ : إذَا ذُکِرَ عِنْدَہُ السِّتَّۃُ الأَیَّامُ الَّتِی یَصُومُہَا بَعْضُ النَّاسِ بَعْدَ رَمَضَانَ تَطَوُّعًا ، قَالَ : یَقُولُ : لَقَدْ رَضِیَ اللَّہُ عَزَّ وَجَلَّ بِہَذَا الشَّہْرِ لِلسَّنَۃِ کُلِّہَا۔","","Musannaf Ibn Abi Shaybah 9817","","","كتاب الصيام"
"9818","(۹۸۱۸) حَدَّثَنَا حَفْصٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ أَبِی سَلَمَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : قَالَتْ عَائِشَۃُ : إِنْ کَانَ لَیَکُونُ عَلَیَّ الصَّوْمُ مِنْ شَہْرِ رَمَضَانَ ، فَمَا أَقْضِیہ حَتَّی یَأْتِیَ شَعْبَانُ۔ (بخاری ۱۹۵۰۔ مسلم ۱۵۱)","Sahih","Musannaf Ibn Abi Shaybah 9818","","","كتاب الصيام"
"9819","(۹۸۱۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنِ السُّدِّیِّ ، عَنْ عَبْدِ اللہِ الْبَہِیِّ ، عَنْ عَائِشَۃَ قَالَتْ : مَا کُنْت أَقْضِی مَا یَبْقَی عَلَیَّ مِنْ رَمَضَانَ فِی حَیَاۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلاَّ فِی شَعْبَانَ۔ (ترمذی ۷۸۳۔ احمد ۶/۱۷۹)","Hasan","Musannaf Ibn Abi Shaybah 9819","","","كتاب الصيام"
"9820","(۹۸۲۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ عُمَرَ ، قَالَ : حَدَّثَنِی مَنْ لاَ أَتَّہِمُ ، عَنْ عُبَادَۃَ بْنِ الصَّامِتِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا رَأَی الْہِلاَلَ ، قَالَ : اللَّہُ أَکْبَرُ اللَّہُ أَکْبَرُ ، الْحَمْدُ لِلَّہِ، وَلاَ حَوْلَ وَلاَ قُوَّۃَ إِلاَّ بِاللَّہِ ، اللَّہُمَّ إنِّی أَسْأَلُک خَیْرَ ہَذَا الشَّہْرِ ، وَأَعُوذُ بِکَ مِنْ شَرِّ الْقَدَرِ ، وَمِنْ شَرِّ یَوْمِ الْحَشْرِ۔ (دارمی ۱۶۸۷۔ ابن حبان ۸۸۸)","Da'if","Musannaf Ibn Abi Shaybah 9820","","","كتاب الصيام"
"9821","(۹۸۲۱) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، قَالَ : انْصَرَفْتُ مَعَ سَعِیدِ بْنِ الْمُسَیَّبِ مِنَ الْمَسْجِدِ فَقُلْنَا : ہَذَا الْہِلاَلُ ، یَا أَبَا مُحَمَّدٍ ، فَلَمَّا أَبْصَرَہُ ، قَالَ : آمَنْتُ بِالَّذِی خَلَقَک فَسَوَّاک فَعَدَلَک ، ثُمَّ الْتَفَتَ إلَیَّ ، فَقَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا رَأَی الْہِلاَلَ قَالَ ہَکَذَا۔ (عبدالرزاق ۷۳۵۱)","","Musannaf Ibn Abi Shaybah 9821","","","كتاب الصيام"
"9822","(۹۸۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عُبَیْدِ بْنِ عَمْرٍو ، عَنْ عَلِیٍّ ، قَالَ : إذَا رَأَی أَحَدُکُمُ الْہِلاَلَ فَلاَ یَرْفَعْ بِہِ رَأْسَہ ، إنَّمَا یَکْفِی مِنْ أَحَدِکُمْ أَنْ یَقُولَ : رَبِّی وَرَبُّک اللَّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 9822","","","كتاب الصيام"
"9823","(۹۸۲۳) حَدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا رَأَیْت الْہِلاَلَ فَقُلْ : رَبِّی وَرَبُّک اللَّہُ۔","","Musannaf Ibn Abi Shaybah 9823","","","كتاب الصيام"
"9824","(۹۸۲۴) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، أَنَّ عَلِیًّا کَانَ یَقُولُ إذَا رَأَی الْہِلاَلَ : اللَّہُمَّ ارْزُقْنَا نَصْرَہُ وَخَیْرَہُ وَبَرَکَتَہُ وَفَتْحَہُ وَنُورَہُ ، نَعُوذُ بِکَ مِنْ شَرِّہِ وَشَرِّ مَا بَعْدَہُ۔","","Musannaf Ibn Abi Shaybah 9824","","","كتاب الصيام"
"9825","(۹۸۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ رَجُلٍ مِنَ النَّخَعِ ، عَنْ أَبِی مَسْعُودٍ الْبَدْرِیِّ ، قَالَ : لأَنْ أَخِرَّ مِنْ ہَذَا الْقَصْرِ أَحَبُّ إلَیَّ مِنْ أَنْ أَفْعَلَ کَمَا یَفْعَلُونَ ، إذَا رَأَی أَحَدُکُمُ الْہِلاَلَ کَأَنَّمَا یَرَی رَبَّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 9825","","","كتاب الصيام"
"9826","(۹۸۲۶) حَدَّثَنَا حُسَین بْنُ عَلِیٍّ ، قَالَ : سَأَلْتُ ہِشَامَ بْنَ حَسَّانَ : أَیُّ شَیْئٍ کَانَ الْحَسَنُ یَقُولُ إذَا رَأَی الْہِلاَلَ ؟ قَالَ : کَانَ یَقُولُ : اللَّہُمَّ اجْعَلْہُ شَہْرَ بَرَکَۃٍ وَنُورٍ وَأَجْرٍ وَمُعَافَاۃٍ ، اللَّہُمَّ إنَّک قَاسِمٌ بَیْنَ عِبَادِکَ فِیہِ خَیْرًا ، فَاقْسِمْ لَنَا فِیہِ مِنْ خَیْرِ مَا تُقْسِمُ فِیہِ بَیْنَ عِبَادِکَ الصَّالِحِینَ۔","Hasan","Musannaf Ibn Abi Shaybah 9826","","","كتاب الصيام"
"9827","(۹۸۲۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، قَالَ : سَأَلْتُ ابْنَ جُرَیْجٍ فَذَکَرَ ، عَنْ عَطَائٍ : أَنَّ رَجُلاً أَہَلَّ ہِلاَلاً بِفَلاَۃٍ مِنَ الأَرْضِ ، قَالَ : فَسَمِعَ قَائِلاً یَقُولُ : اللَّہُمَّ أَہِلَّہُ عَلَیْنَا بِالأَمْنِ وَالإِیمَانِ ، وَالسَّلاَمَۃِ وَالإِسْلاَمِ ، وَالْہُدَی وَالْمَغْفِرَۃِ ، وَالتَّوْفِیقِ لِمَا تَرْضَی ، وَالْحِفْظِ مِمَّا تَسْخَطُ ، رَبِّی وَرَبُّک اللَّہُ ، قَالَ : فَلَمْ یَزَلْ یُلْقیہنَّ حَتَّی حَفِظْتُہُنَّ ، وَمَا أرََی أَحَدًا۔","","Musannaf Ibn Abi Shaybah 9827","","","كتاب الصيام"
"9828","(۹۸۲۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُعْجِبُہُمْ إذَا رَأَی الرَّجُلُ الْہِلاَلَ أَنْ یَقُولَ : رَبِّی وَرَبُّک اللَّہُ۔","","Musannaf Ibn Abi Shaybah 9828","","","كتاب الصيام"
"9829","(۹۸۲۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ یَکْرَہُ الإِشَارَۃَ عِنْدَ رُؤْیَۃِ الْہِلاَلِ وَرَفْعَ الصَّوْتِ۔","","Musannaf Ibn Abi Shaybah 9829","","","كتاب الصيام"
"9830","(۹۸۳۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْر ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا رَأَی ہِلاَلاً ، قَالَ : ہِلاَلُ خَیْرٍ وَرُشْدٍ ، ہِلاَلُ خَیْرٍ وَرُشْدٍ ، آمَنْتُ بِالَّذِی خَلَقَک ، ثَلاَثًا ، الْحَمْدُ لِلَّہِ الَّذِی ذَہَبَ بِشَہْرِ کَذَا وَکَذَا۔ (ابوداؤد ۵۰۵۱)","","Musannaf Ibn Abi Shaybah 9830","","","كتاب الصيام"
"9831","(۹۸۳۱) حَدَّثَنَا یَعْلَی ، قَالَ : حدَّثَنَا حَجَّاجُ بْنُ دِینَارٍ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَرِہَ أَنْ یَنْتَصِبَ لِلْہِلاَلِ ، وَلَکِنْ یَعْتَرِضُ وَیَقُولُ : اللَّہُ أَکْبَرُ ، وَالْحَمْدُ لِلَّہِ الَّذِی ذَہَبَ بِہِلاَلِ کَذَا وَکَذَا ، وَجَائَ بِہِلاَلِ کَذَا وَکَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 9831","","","كتاب الصيام"
"9832","(۹۸۳۲) حَدَّثَنَا عَبَّادٌ ، عَنْ سَعِیدٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ سُئِلَ عَنْ صَوْمِ النَّیْرُوزِ ؟ فَکَرِہَہُ ، وَقَالَ : تُعَظِّمُونَہُ۔","","Musannaf Ibn Abi Shaybah 9832","","","كتاب الصيام"
"9833","(۹۸۳۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، قَالَ : سُئِلَ الْحَسَنُ عَنْ صَوْمِ یَوْمِ النَّیْرُوزِ ؟ فَقَالَ : مَا لَکُمْ وَلِلنَّیْرُوزِ ؟ لاَ تَلْتَفِتُوا إلَیْہِ ، فَإِنَّمَا ہُوَ لِلْعَجَمِ۔","","Musannaf Ibn Abi Shaybah 9833","","","كتاب الصيام"
"9834","(۹۸۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ نُمَیْرِ بن عَرِیبٍ ، عَنْ عَامِرِ بْنِ مَسْعُود ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الصَّوْمُ فِی الشِّتَائِ الْغَنِیمَۃُ الْبَارِدَۃُ۔ (احمد ۴/۳۳۵۔ ترمذی ۷۹۷)","Da'if","Musannaf Ibn Abi Shaybah 9834","","","كتاب الصيام"
"9835","(۹۸۳۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : قَالَ عُمَرُ : الشِّتَائُ غَنِیمَۃُ العَابِدِ۔","Sahih","Musannaf Ibn Abi Shaybah 9835","","","كتاب الصيام"
"9836","(۹۸۳۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ مُجَاہِدٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : کَانَ یَقُولُ إذَا جَائَ الشِّتَائُ : یَا أَہْلَ الْقُرْآنِ طَالَ اللَّیْلُ لِصَلاَتِکُمْ ، وَقَصُرَ النَّہَارُ لِصِیَامِکُمْ فَاغْتَنِمُوا۔","","Musannaf Ibn Abi Shaybah 9836","","","كتاب الصيام"
"9837","(۹۸۳۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ أَبِی زُہْرَۃَ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا صَامَ، ثُمَّ أَفْطَرَ ، قَالَ : اللَّہُمَّ لَکَ صُمْت وَعَلَی رِزْقِکَ أَفْطَرْت ، قَالَ : وَکَانَ الرَّبِیعُ بْنُ خُثَیْمٍ یَقُولُ : الْحَمْدُ لِلَّہِ الَّذِی أَعَانَنِی فَصُمْت ، وَرَزَقَنِی فَأَفْطَرْت۔ (ابوداؤد ۲۳۴۹۔ نسائی ۱۰۱۳۱)","Da'if","Musannaf Ibn Abi Shaybah 9837","","","كتاب الصيام"
"9838","(۹۸۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَنَسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا أَفْطَرَ عِنْدَ أَہْلِ بَیْتٍ ، قَالَ : أَفْطَرَ عِنْدَکُمُ الصَّائِمُونَ وَأَکَلَ طَعَامَکُمُ الأَبْرَارُ ، وَنَزَلَتْ عَلَیْکُمُ الْمَلاَئِکَۃُ۔ (احمد ۳/۱۱۸۔ دارمی ۱۷۷۲)","","Musannaf Ibn Abi Shaybah 9838","","","كتاب الصيام"
"9839","(۹۸۳۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ ثَابِتِ بْنِ الْحَجَّاجِ ، عَنْ عَوْفِ بْنِ مَالِکٍ الأَشْجَعِیِّ، قَالَ : قَالَ عُمَرُ : صِیَامُ یَوْمٍ مِنْ غَیْرِ رَمَضَانَ وَإِطْعَامُ مِسْکِینٍ ، یَعْدِلُ صِیَامَ یَوْمٍ مِنْ رَمَضَانَ۔","Sahih","Musannaf Ibn Abi Shaybah 9839","","","كتاب الصيام"
"9840","(۹۸۴۰) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَصُومُ مِنَ الشَّہْرِ حَتَّی نَقُولَ : مَا یُفْطِرُ ، وَیُفْطِرُ حَتَّی نَقُولَ : مَا یَصُومُ مِنْہُ شَیْئًا۔ (مسلم ۱۸۰۔ ترمذی ۷۶۹)","Sahih","Musannaf Ibn Abi Shaybah 9840","","","كتاب الصيام"
"9841","(۹۸۴۱) حَدَّثَنَا ابن نُمَیْرٍ ، قَالَ : حدَّثَنَا عُثْمَانُ بْنُ حَکِیمٍ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنْ صِیَامِ رَجَبٍ ؟ فَقَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ یَقُولُ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَصُومُ حَتَّی نَقُولَ : لاَ یُفْطِرُ ، وَیُفْطِرُ حَتَّی نَقُولَ : لاَ یَصُومُ۔ (بخاری ۱۹۷۱۔ مسلم ۱۷۸)","Sahih","Musannaf Ibn Abi Shaybah 9841","","","كتاب الصيام"
"9842","(۹۸۴۲) حَدَّثَنَا عَبْدَۃُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، عَنْ سَعدِ بْنِ ہِشَامٍ ، عَنْ عَائِشَۃَ قَالَتْ : لاَ أَعْلَمُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَامَ شَہْرًا قَطُّ کَامِلاً ، إِلاَّ رَمَضَانَ۔ (ابوداؤد ۱۳۳۹۔ مسلم ۱۳۹)","Sahih","Musannaf Ibn Abi Shaybah 9842","","","كتاب الصيام"
"9843","(۹۸۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ کَہْمَسٍ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ ، عَنْ عَائِشَۃَ ، قَالَ : سَأَلْتُُہَا عَنْ صِیَامِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَقَالَتْ : مَا عَلِمْتُہُ صَامَ شَہْرًا حَتَّی یُفْطِرَ فِیہِ إِلاَّ رَمَضَانَ ، وَلاَ أَفْطَرَہُ حَتَّی یَصُومَ مِنْہُ۔ (مسلم ۸۰۹۔ احمد ۶/۱۵۷)","Sahih","Musannaf Ibn Abi Shaybah 9843","","","كتاب الصيام"
"9844","(۹۸۴۴) حَدَّثَنَا یَحْیَی بْنُ سُلَیْمٍ ، عَنْ إسْمَاعِیلَ بْنِ کَثِیرٍ ، عَنْ عَاصِمِ بْنِ لَقِیطِ بْنِ صَبِرَۃَ ، عَنْ أَبِیہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : بَالِغْ فِی الاِسْتِنْشَاق ، إِلاَّ أَنْ تَکُونَ صَائِمًا۔","Sahih","Musannaf Ibn Abi Shaybah 9844","","","كتاب الصيام"
"9845","(۹۸۴۵) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ أَبِیہِ، قَالَ: کَانَ الضَّحَّاکُ وَأَصْحَابُہُ بِخُرَاسَانَ فِی رَمَضَانَ، فَکَانُوا لاَ یَتَمَضْمَضُونَ۔","","Musannaf Ibn Abi Shaybah 9845","","","كتاب الصيام"
"9846","(۹۸۴۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَبِی ہِلاَلٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ یَکْرَہُ أَنْ یَسْتَنْشِقَ الصَّائِمُ حَتَّی لاَ یَدْخُلَ حَلْقَہُ۔","","Musannaf Ibn Abi Shaybah 9846","","","كتاب الصيام"
"9847","(۹۸۴۷) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ عَمَّارِ بْنِ رُزَیْقٍ ، عَنْ أَبِی فَرْوَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا اسْتَنْشَقْت وَأَنْتَ صَائِمٌ فَلاَ تُبَالِغْ۔","","Musannaf Ibn Abi Shaybah 9847","","","كتاب الصيام"
"9848","(۹۸۴۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَابِسٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : إذَا کَانَ أَحَدُکُمْ صَائِمًا ، فَلْیَدَّہِنْ حَتَّی لاَ یُرَی عَلَیْہِ أَثَرُ صَوْمِہِ ، وَإِذَا بَزَقَ فَلْیَسْتُرْ بُزَاقَہُ ، وَأَشَارَ یَزِیدُ بِیَدِہِ کَأَنَّہُ یُغَطِّی بِہَا فَاہُ۔","Da'if","Musannaf Ibn Abi Shaybah 9848","","","كتاب الصيام"
"9849","(۹۸۴۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، قَالَ : قَالَ عِیسَی ابْنُ مَرْیَمَ : إذَا کَانَ یَوْمُ صَوْمِ أَحَدِکُمْ فَلْیَدَّہِنْ شَفَتَیْہِ۔","","Musannaf Ibn Abi Shaybah 9849","","","كتاب الصيام"
"9850","(۹۸۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ ، عَنْ یَحْیَی ، عَنْ مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : إذَا أَصْبَحْتُمْ صِیَامًا فَأَصْبِحُوا مُدَّہَنِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 9850","","","كتاب الصيام"
"9851","(۹۸۵۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ وَبَرَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ خَرَشَۃَ بْنِ الْحُرِّ ، قَالَ : رَأَیْتُ عُمَرَ یَضْرِبُ أَکُفَّ النَّاسِ فِی رَجَبٍ ، حَتَّی یَضَعُوہَا فِی الْجِفَانِ وَیَقُولُ : کُلُوا فَإِنَّمَا ہُوَ شَہْرٌ کَانَ یُعَظِّمُہُ أَہْلُ الْجَاہِلِیَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 9851","","","كتاب الصيام"
"9852","(۹۸۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، قَالَ : سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ صَوْمِ رَجَبٍ ؟ قَالَ : أَیْنَ أَنْتُمْ مِنْ شَعْبَانَ ؟ (عبدالرزاق ۷۸۵۸)","","Musannaf Ibn Abi Shaybah 9852","","","كتاب الصيام"
"9853","(۹۸۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ مَوْلَی الصَّہْبَائِ ، عَنْ رَجُلٍ قَدْ سَمَّاہُ ، عَنْ أَنَسٍ ، قَالَ : لاَ تَکُنْ اثْنَیْنِیًّا ، وَلاَ خَمِیسِیًّا ، وَلاَ رَجَبِیًّا۔","Da'if","Musannaf Ibn Abi Shaybah 9853","","","كتاب الصيام"
"9854","(۹۸۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عَاصِمِ بْنِ مُحَمَّدٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ ابْنُ عُمَرَ إذَا رَأَی النَّاسَ ، وَمَا یُعِدّونَ لِرَجَبٍ ، کَرِہَ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 9854","","","كتاب الصيام"
"9855","(۹۸۵۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : سَأَلْتُ عَائِشَۃَ عَنْ صِیَامِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَقَالَتْ : کَانَ یَصُومُ حَتَّی نَقُولَ : لاَ یُفْطِرُ ، وَیُفْطِرُ حَتَّی نَقُولَ : لاَ یَصُومُ ، وَلَمْ أَرَہُ فِی شَہْرٍ أَکْثَرَ صِیَامًا مِنْہُ فِی شَعْبَانَ ، کَانَ یَصُومُ شَعْبَانَ إِلاَّ قَلِیلاً ، بَلْ کَانَ یَصُومُ شَعْبَانَ کُلَّہُ۔ (بخاری ۱۹۱۹۔ ابوداؤد ۲۴۲۶)","Hasan","Musannaf Ibn Abi Shaybah 9855","","","كتاب الصيام"
"9856","(۹۸۵۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا صَدَقَۃُ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا ثَابِتٌ الْبُنَانِیُّ ، عَنْ أَنَسٍ ، قَالَ : سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ أَفْضَلِ الصِّیَامِ ؟ فَقَالَ : صِیَامُ شَعْبَانَ تَعْظِیمًا لِرَمَضَانَ۔ (ترمذی ۶۶۳۔ ابویعلی ۳۴۳۱)","Da'if","Musannaf Ibn Abi Shaybah 9856","","","كتاب الصيام"
"9857","(۹۸۵۷) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا الْمَسْعُودِیُّ ، عَنِ الْمُہَاجِرِ أَبِی الْحَسَنِ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، قَالَ : لَمْ یَکُنْ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی شَہْرٍ أَکْثَرَ صِیَامًا مِنْہُ فِی شَعْبَانَ ، وَذَلِکَ أَنَّہُ تُنْسَخُ فِیہِ آجَالُ مَنْ یَمُوتُ فِی السَّنَۃِ۔","","Musannaf Ibn Abi Shaybah 9857","","","كتاب الصيام"
"9858","(۹۸۵۸) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حَدَّثَتَا ثَابِتُ بْنُ قَیْسٍ ، قَالَ : حدَّثَنِی أَبُو سَعِیدٍ الْمَقْبُرِیُّ ، قَالَ : حَدَّثَنِی أَبُو ہُرَیْرَۃَ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، رَأَیْتُک تَصُومُ فِی شَعْبَانَ صَوْمًا لاَ تَصُومُہ فِی شَیْئٍ مِنَ الشُّہُورِ ، إِلاَّ فِی شَہْرِ رَمَضَانَ ؟ قَالَ : ذَلِکَ شَہْرٌ یَغْفُلُ النَّاسُ عَنْہُ ، بَیْنَ رَجَبٍ وَشَہْرِ رَمَضَانَ ، تُرْفَعُ فِیہِ أَعْمَالُ النَّاسِ ، فَأُحِبُّ أَنْ لاَ یُرْفَعَ لِی عَمَلٌ إِلاَّ وَأَنَا صَائِمٌ۔ (احمد ۵/۲۰۱)","Hasan","Musannaf Ibn Abi Shaybah 9858","","","كتاب الصيام"
"9859","(۹۸۵۹) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی لَبِیدٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ عَائِشَۃَ ، قَالَ : سَأَلْتُُہَا عَنْ صِیَامِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَقَالَتْ : لَمْ أَرَہُ صَائِمًا مِنْ شَہْرٍ قَطُّ أَکْثَرَ مِنْ صِیَامِہِ فِی شَعْبَانَ ، کَانَ یَصُومُ شَعْبَانَ کُلَّہ ، کَانَ یَصُومُ شَعْبَانَ إِلاَّ قَلِیلاً۔ (مسلم ۱۷۶۔ ابن ماجہ ۱۷۱۰)","Sahih","Musannaf Ibn Abi Shaybah 9859","","","كتاب الصيام"
"9860","(۹۸۶۰) حَدَّثَنَا سُفْیَانُ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی عُبَیْدٍ مَوْلَی ابْنِ أَزْہَرَ ، قَالَ : شَہِدْتُ الْعِیدَ مَعَ عُمَرَ بْنِ الْخَطَّابِ، فَبَدَأَ بِالصَّلاَۃِ قَبْلَ الْخُطْبَۃِ ، وَقَالَ : إنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ صَوْمِ ہَذَیْنِ الْیَوْمَیْنِ : أَمَّا یَوْمُ الْفِطْرِ فَیَوْمُ فِطْرِکُمْ مِنْ صِیَامِکُمْ ، وَأَمَّا یَوْمُ الأَضْحَی فَکُلُوا فِیہِ مِنْ لَحْمِ نُسُکِکُمْ۔ (بخاری ۵۵۷۳۔ ترمذی ۷۷۱)","Sahih","Musannaf Ibn Abi Shaybah 9860","","","كتاب الصيام"
"9861","(۹۸۶۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَأَبُو أُسَامَۃَ ، عَنْ سَعْدِ بْنِ سَعِیدٍ ، قَالَ : أَخْبَرَتْنِی عَمْرَۃُ بِنْتُ عَبْدِ الرَّحْمَنِ ، عنْ عَائِشَۃَ قَالَتْ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ صَوْمِ یَوْمِ الْفِطْرِ وَیَوْمِ الأَضْحَی۔ (مسلم ۱۴۳)","Hasan","Musannaf Ibn Abi Shaybah 9861","","","كتاب الصيام"
"9862","(۹۸۶۲) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، ع??نْ قَزَعَۃَ ، عَنْ أَبِی سَعِیدٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ صَوْمِ یَوْمِ الْفِطْرِ وَیَوْمِ الأَضْحَی۔ (بخاری ۱۹۹۵۔ ترمذی ۷۹۹)","Sahih","Musannaf Ibn Abi Shaybah 9862","","","كتاب الصيام"
"9863","(۹۸۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُلَیٍّ ، عَنْ أَبِیہِ ، عَنْ عُقْبَۃَ بْنِ عَامِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَوْمُ عَرَفَۃَ وَیَوْمُ الأَضْحَی وَأَیَّامُ التَّشْرِیقِ ، أَیَّامُ أَکْلٍ وَشُرْبٍ۔ (ترمذی ۷۷۳۔ ابوداؤد ۲۴۱۱)","Sahih","Musannaf Ibn Abi Shaybah 9863","","","كتاب الصيام"
"9864","(۹۸۶۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ زِیَادِ بْنِ جُبَیْرٍ ، قَالَ : جَائَ رَجُلٌ إلَی ابْنِ عُمَرَ فَسَأَلَہُ عَنْ رَجُلٍ نَذَرَ أَن یَصُومُ یَوْمًا ، فَوَافَقَ ذَلِکَ فِطْرًا ، أَوْ أَضْحَی ؟ قَالَ : أَمَرَ اللَّہُ تَعَالَی بِوَفَائِ النَّذْرِ ، وَنَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ صِیَامِ ہَذَا الْیَوْمِ۔ (بخاری ۱۹۹۴۔ مسلم ۸۰۰)","Sahih","Musannaf Ibn Abi Shaybah 9864","","","كتاب الصيام"
"9865","(۹۸۶۵) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ صَوْمِ الْفِطْرِ وَیَوْمِ الأَضْحَی۔ (بخاری ۶۷۰۵)","Da'if","Musannaf Ibn Abi Shaybah 9865","","","كتاب الصيام"
"9866","(۹۸۶۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَیَزِیدُ بْنُ ہَارُونَ قَالاَ : أَخْبَرَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ یَعْقُوبَ بْنِ عُتْبَۃَ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ صِیَامِ یَومِ الْفِطْرِ وَیَوْمِ النَّحْرِ۔ (بخاری ۱۹۹۱۔ مسلم ۱۴۱)","Sahih","Musannaf Ibn Abi Shaybah 9866","","","كتاب الصيام"
"9867","(۹۸۶۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنِ الْمُطَّلِبِ بْنِ أَبِی وَدَاعَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : جَائَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنِّی أَفْطَرْت یَوْمًا مِنْ رَمَضَانَ ، فَقَالَ لَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَصَدَّقْ ، وَاسْتَغْفِرِ اللَّہَ ، وَصُمْ یَوْمًا مَکَانَہُ۔ (ابوداؤد ۲۳۸۵۔ دارقطنی ۲۷)","","Musannaf Ibn Abi Shaybah 9867","","","كتاب الصيام"
"9868","(۹۸۶۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ الْحَذَّائِ ، قَالَ : قَالَ لِی عَاصِمٌ : سَأَلْتُ جَابِرَ بْنَ زَیْدٍ : مَا بَلَغَک فِیمَنْ أَفْطَرَ یَوْمًا مِنْ رَمَضَانَ ، مَا عَلَیْہِ ؟ قَالَ : لِیَصُمْ یَوْمًا مَکَانَہُ ، وَیَصْنَعُ مَعَ ذَلِکَ مَعْرُوفًا۔","","Musannaf Ibn Abi Shaybah 9868","","","كتاب الصيام"
"9869","(۹۸۶۹) حَدَّثَنَا شَرِیکٌ، عَنْ مُغِیرَۃَ، عَنْ إِبْرَاہِیمَ (ح) وَعَن ابْنِ أَبِی خَالِدٍ، عَنِ الشَّعْبِیِّ، قَالاَ: یَقْضِی یَوْمًا مَکَانَہُ۔","","Musannaf Ibn Abi Shaybah 9869","","","كتاب الصيام"
"9870","(۹۸۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : عَلَیْہِ یَوْمٌ مَکَانَہُ۔","","Musannaf Ibn Abi Shaybah 9870","","","كتاب الصيام"
"9871","(۹۸۷۱) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ یَعْلَی بْنِ حَکِیمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ فِی رَجُلٍ أَفْطَرَ یَوْمًا مِنْ رَمَضَانَ مُتَعَمِّدًا ، قَالَ : یَسْتَغْفِرُ اللَّہَ مِنْ ذَلِکَ وَیَتُوبُ إلَیْہِ ، وَیَقْضِی یَوْمًا مَکَانَہُ۔","","Musannaf Ibn Abi Shaybah 9871","","","كتاب الصيام"
"9872","(۹۸۷۲) حَدَّثَنَا وَکِیعٌ ، عَنْ جَرِیرٍ ، عَنْ یَعْلَی ، عَنْ سَعِیدٍ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 9872","","","كتاب الصيام"
"9873","(۹۸۷۳) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَاصِمٍ ، قَالَ : أَرْسَلَ أَبُو قِلاَبَۃَ إلَی سَعِیدِ بْنِ الْمُسَیَّبِ یَسْأَلَہُ عَن رَجُلٍ أَفْطَر یَوْمًا مِنْ رَمَضَانَ مُتَعَمِّدًا ؟ فَقَالَ سَعِیدٌ : یَصُومُ مَکَانَ کُلِّ یَوْمٍ أَفْطَر شَہْرًا۔","","Musannaf Ibn Abi Shaybah 9873","","","كتاب الصيام"
"9874","(۹۸۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی رَجُلٍ یُفْطِرُ یَوْمًا مِنْ رَمَضَانَ مُتَعَمِّدًا ، قَالَ : یَصُومُ شَہْرًا۔","","Musannaf Ibn Abi Shaybah 9874","","","كتاب الصيام"
"9875","(۹۸۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : عَلَیْہِ صَوْمُ ثَلاَثَۃِ آلاَفِ یَوْمٍ۔","","Musannaf Ibn Abi Shaybah 9875","","","كتاب الصيام"
"9876","(۹۸۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنِ ابْنِ الْمُطَوِّسِ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَفْطَرَ یَوْمًا مِنْ غَیْرِ رُخْصَۃٍ ، لَمْ یُجْزِہِ صِیَامُ الدَّہْرِ۔ (ابن ماجہ ۱۶۷۲۔ احمد ۲/۴۴۲)","Da'if","Musannaf Ibn Abi Shaybah 9876","","","كتاب الصيام"
"9877","(۹۸۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ وَاصِلٍ، عَنْ مُغِیرَۃَ الْیَشْکُرِیِّ، عَنْ فُلاَنِ بْنِ الْحَارِثِ، عَنِ ابْنِ مَسْعُودٍ، قَالَ : مَنْ أَفْطَرَ یَوْمًا مِنْ رَمَضَانَ مِنْ غَیْرِ رُخْصَۃٍ ، لَمْ یُجْزِہِ صِیَامُ الدَّہْرِ کُلِّہِ۔ (عبدالرزاق ۷۴۷۶)","Sahih","Musannaf Ibn Abi Shaybah 9877","","","كتاب الصيام"
"9878","(۹۸۷۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَمْرِو بْنِ یَعْلَی ، عَنْ عَرْفَجَۃَ ، عَنْ عَلِیٍّ ، قَالَ : مَنْ أَفْطَرَ یَوْمًا مِنْ رَمَضَانَ مُتَعَمِّدًا ، لَمْ یَقْضِہِ أَبَدًا طُولَ الدَّہْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 9878","","","كتاب الصيام"
"9879","(۹۸۷۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ حُمَیْدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : جَائَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : ہَلَکْتُ ، قَالَ : وَمَا أَہْلَکَکَ ؟ قَالَ : وَقَعْت عَلَی امْرَأَتِی فِی رَمَضَانَ ، قَالَ : أَعْتِقْ رَقَبَۃً ، قَالَ : لاَ أَجِدُ ، قَالَ : فَصُمْ شَہْرَیْنِ ، قَالَ : لاَ أَسْتَطِیعُ ، قَالَ : فَأَطْعِمْ سِتِّینَ مِسْکِینًا ، قَالَ : لاَ أَجِدُ ، قَالَ : اجْلِسْ فَجَلَسَ ، فَبَیْنَمَا ہُوَ کَذَلِکَ إذْ أُتِیَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِعَرَقٍ فِیہِ تَمْرٌ ، فَقَالَ لَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اذْہَبْ فَتَصَدَّقْ بِہِ ، قَالَ : وَالَّذِی بَعَثَک بِالْحَقِّ مَا بَیْنَ لاَبَتَیْہَا أَہْلُ بَیْتٍ أَفْقَرُ إلَیْہِ مِنَّا ، قَالَ: فَضَحِکَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی بَدَتْ أَنْیَابُہُ ، ثُمَّ قَالَ : انْطَلِقْ ، فَأَطْعِمْہُ عِیَالَک۔ (بخاری۶۷۱۱۔ مسلم ۸۱)","Sahih","Musannaf Ibn Abi Shaybah 9879","","","كتاب الصيام"
"9880","(۹۸۸۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِثْلَہُ ، وَقَالَ : صُمْ یَوْمًا مَکَانَہُ۔ (احمد ۲/۲۰۸)","","Musannaf Ibn Abi Shaybah 9880","","","كتاب الصيام"
"9881","(۹۸۸۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ مُحَمَّدِ بْنِ جَعْفَرِ بْنِ الزُّبَیْرِ ، عَنْ عَبَّادِ بْنِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، عَنْ عَائِشَۃَ قَالَتْ : أَتَی رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلٌ فَذَکَرَ أَنَّہُ احْتَرَقَ ، فَسَأَلَہُ عَنْ أَمْرِہِ ، فَذَکَرَ أَنَّہُ وَقَعَ عَلَی امْرَأَتِہِ فِی رَمَضَانَ ، فَأُتِیَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِکْتَلٍ یُدْعَی الْعَرْْقُ ، فِیہِ تَمْرٌ ، فَقَالَ : أَیْنَ الْمُحْتَرِقُ ؟ فَقَامَ الرَّجُلُ ، فَقَالَ لَہُ : تَصَدَّقْ بِہَذَا۔ (بخاری ۶۸۲۲۔ ابوداؤد ۲۳۸۶)","Sahih","Musannaf Ibn Abi Shaybah 9881","","","كتاب الصيام"
"9882","(۹۸۸۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ لاَ یُصَلِّی حَتَّی یُفْطِرَ ، وَلَوْ بِشَرْبَۃٍ مِنْ مَائٍ۔ (ابن حبان ۳۵۰۴۔ ابویعلی ۳۷۸۰)","Sahih","Musannaf Ibn Abi Shaybah 9882","","","كتاب الصيام"
"9883","(۹۸۸۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الْحَسَنِ بْنِ حَکِیمٍ ، عَنْ أُمِّہِ ، عَنْ أَبِی بَرْزَۃَ الأَسْلَمِیِّ ، قَالَ : کَانَ یَأْمُرُ أَہْلَہُ أَنْ یُفْطِرُوا قَبْلَ الصَّلاَۃِ عَلَی مَا تَیَسَّرَ۔","Da'if","Musannaf Ibn Abi Shaybah 9883","","","كتاب الصيام"
"9884","(۹۸۸۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ، قَالَ: کَانَ الأَسْوَد لاَ یُفْطِرُ فِی رَمَضَانَ حَتَّی یُصَلِّیَ الْمَغْرِبَ۔","","Musannaf Ibn Abi Shaybah 9884","","","كتاب الصيام"
"9885","(۹۸۸۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ؛ أَنَّ عُمَرَ وَعُثْمَانَ کَانَا یُصَلِّیَانِ الْمَغْرِبَ إذَا رَأَیَا اللَّیْلَ ، وَکَانَا یُفْطِرَانِ قَبْلَ أَنْ یُصَلِّیَا۔","","Musannaf Ibn Abi Shaybah 9885","","","كتاب الصيام"
"9886","(۹۸۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی مَالِکٍ ، عَنِ ابْن أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی الرَّجُلِ یَدْخُلُ حَلْقَہُ الذُّبَابُ ، قَالَ : لاَ یُفْطِرُ۔","","Musannaf Ibn Abi Shaybah 9886","","","كتاب الصيام"
"9887","(۹۸۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ یُفْطِرُ۔","","Musannaf Ibn Abi Shaybah 9887","","","كتاب الصيام"
"9888","(۹۸۸۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یُفْطِرُ۔","","Musannaf Ibn Abi Shaybah 9888","","","كتاب الصيام"
"9889","(۹۸۸۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ حَفْصَۃَ بِنْتِ سِیرِینَ ، عَنِ الرَّبَابِ ، عَنْ عَمِّہَا سَلْمَانَ بْنِ عَامِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا أَفْطَرَ أَحَدُکُمْ فَلْیُفْطِرْ عَلَی تَمْرٍ ، فَإِنْ لَمْ یَجِدْ فَلْیُفْطِرْ عَلَی مَائٍ ، فَإِنَّہُ طَہُورٌ۔ (ترمذی ۶۵۸۔ ابن ماجہ ۱۶۹۹)","Da'if","Musannaf Ibn Abi Shaybah 9889","","","كتاب الصيام"
"9890","(۹۸۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنْ حَفْصَۃَ بِنْتِ سِیرِینَ ، عَنِ الرَّبَابِ ، وَہِیَ أُمُّ الرَّائِحِ بِنْتُ صُلَیْعٍ ، عَنْ سَلْمَانَ بْنِ عَامِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا أَفْطَرَ أَحَدُکُمْ فَلْیُفْطِرْ عَلَی تَمْرٍ، فَإِنْ لَمْ یَجِدْ فَلْیُفْطِرْ عَلَی مَائٍ ، فَإِنَّہُ طَہُورٌ۔ (ترمذی ۶۵۸۔ احمد ۴/۱۷)","Da'if","Musannaf Ibn Abi Shaybah 9890","","","كتاب الصيام"
"9891","(۹۸۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ أَیْمَنَ ، عَنْ أَبِیہِ ، عَنْ أَبِی سَعِیدٍ، قَالَ: دَخَلْت عَلَیْہِ فَأَفْطَرَ عَلَی تَمْرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 9891","","","كتاب الصيام"
"9892","(۹۸۹۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ أُمِّ مُوسَی قَالَتْ : کَانُوا یَسْتَحِبُّونَ أَنْ یُفْطِرُوا عَلَی الْبُسْرِ ، أَوِ التَّمْرِ۔","","Musannaf Ibn Abi Shaybah 9892","","","كتاب الصيام"
"9893","(۹۸۹۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ أَشْعَثَ ، عَنْ مُغِیرَۃَ بْنِ عَبْدِ اللہِ الْیَشْکُرِیِّ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ أَفْطَرَ یَوْمًا مِنْ رَمَضَانَ مُتَعَمِّدًا مِنْ غَیْرِ سَفَرٍ ، وَلاَ مَرَضٍ ، لَمْ یَقْضِہِ أَبَدًا وَإِنْ صَامَ الدَّہْرَ کُلَّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 9893","","","كتاب الصيام"
"9894","(۹۸۹۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَقْضِی یَوْمًا مَکَانَہُ ، وَیَسْتَغْفِرُ رَبَّہُ۔","","Musannaf Ibn Abi Shaybah 9894","","","كتاب الصيام"
"9895","(۹۸۹۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ ہِلاَلٍ الْعَبْسِیِّ ، عَنْ جَرِیرٍ ، قَالَ : خَطَبَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَحَثَّنَا عَلَی الصَّدَقَۃِ ، فَأَبْطَؤُوا حَتَّی رُئِیَ فِی وَجْہِہِ الْغَضَبُ ، ثُمَّ إنَّ رَجُلاً مِنَ الأَنْصَارِ جَائَ بِصُرَّۃٍ فَأَعْطَاہَا ، فَتَتَابَعَ النَّاسُ حَتَّی رُئِیَ فِی وَجْہِہِ السُّرُورُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ سَنَّ سُنَّۃً حَسَنَۃً کَانَ لَہُ أَجْرُہَا ، وَمِثْلُ أَجْرِ مَنْ عَمِلَ بِہَا ، مِنْ غَیْرِ أَنْ یَنْتَقِصَ مِنْ أُجُورِہِمْ شَیْئًا ، وَمَنْ سَنَّ سُنَّۃً سَیِّئَۃً کَانَ عَلَیْہِ وِزْرُہَا ، وَوِزْرُ مَنْ عَمِلَ بِہَا ، مِنْ غَیْرِ أَنْ یَنْتَقِصَ مِنْ أَوْزَارِہِمْ شَیْئًا۔","Sahih","Musannaf Ibn Abi Shaybah 9895","","","كتاب الزكاة"
"9896","(۹۸۹۶) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ شُعْبَۃَ، قَالَ: حدَّثَنِی عَوْنُ بْنُ أَبِی جُحَیْفَۃَ ، قَالَ : سَمِعْتُ الْمُنْذِرَ بْنَ جَرِیرٍ یَذْکُرُ، عَنْ أَبِیہِ ، قَالَ : کُنَّا عِنْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَدْرَ النَّہَارِ ، قَالَ : فَجَائَہُ قَوْمٌ حُفَاۃٌ ، مُجْتَابِی النِّمَارِ ، عَلَیْہِمُ السُّیُوفُ وَالْعَمَائِمُ ، عَامَّتُہُمْ مِنْ مُضَرَ ، بَلْ کُلُّہُمْ مِنْ مُضَرَ ، قَالَ : فَرَأَیْتُ وَجْہَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَتَغَیَّرُ تَغَیُّرًا لِمَا رَأَی بِہِمْ مِنَ الْفَاقَۃِ ، قَالَ : ثُمَّ قَامَ فَدَخَلَ الْمَسْجِدَ ، ثُمَّ أَمَرَ بِلاَلاً فَأَذَّنَ، ثُمَّ أَقَامَ فَصَلَّی ، ثُمَّ قَالَ : {یَا أَیُّہَا النَّاسُ اتَّقُوا رَبَّکُمُ الَّذِی خَلَقَکُمْ مِنْ نَفْسٍ وَاحِدَۃٍ} ، ثُمَّ قَرَأَ إلَی آخِرِ الآیَۃِ : {وَاتَّقُوا اللَّہَ الَّذِی تَسَائَلُونَ بِہِ وَالأَرْحَامَ} ، {اتَّقُوا اللَّہَ وَلْتَنْظُرْ نَفْسٌ مَا قَدَّمَتْ لِغَدٍ} تَصَدَّقَ امْرُؤٌ مِنْ دِینَارِہِ وَمِنْ دِرْہَمِہِ ، وَمِنْ ثَوْبِہِ وَمِنْ صَاعِ بُرِّہِ ، یَعْنِی الْحِنْطَۃَ ، وَمِنْ صَاعِ تَمْرِہِ حَتَّی قَالَ: وَلَوْ بِشِقِّ تَمْرَۃٍ ، قَالَ : فَجَائَ رَجُلٌ مِنَ الأَنْصَارِ بِصُرَّۃٍ قَدْ کَادَتْ کَفُّہُ تَعْجَزُ عَنْہَا ، بَلْ قَدْ عَجَزَتْ ، قَالَ : ثُمَّ تَتَابَعَ النَّاسُ حَتَّی رَأَیْت کَوْمَیْنِ مِنْ طَعَامٍ وَثِیَابٍ ، قَالَ : فَرَأَیْتُ وَجْہَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَتَہَلَّلُ، کَأَنَّہُ مُذْہَبَۃٌ ، فَقَالَ: مَنْ سَنَّ فِی الإِسْلاَمِ سُنَّۃً حَسَنَۃً ، أَوْ صَالِحَۃً فَاسْتُنَّ بِہَا بَعْدَہُ ، کَانَ لَہُ أَجْرُہَا وَأَجْرُ مَنْ عَمِلَ بِہَا بَعْدَہُ، لاَ یَنْتَقِصُ مِنْ أُجُورِہِمْ شَیْئًا، وَمَنِ اسْتَنَّ فِی الإِسْلاَمِ سُنَّۃً سَیِّئَۃً فَاسْتُنَّ بِہَا بَعْدَہُ، کَانَ عَلَیْہِ وِزْرُہ وَوِزْرُ مَنْ عَمِلَ بِہَا بَعْدَہُ، لاَ یَنْتَقِصُ مِنْ أَوْزَارِہِمْ شَیْئًا۔(مسلم ۷۰۶۔ احمد ۴/۳۵۹)","Sahih","Musannaf Ibn Abi Shaybah 9896","","","كتاب الزكاة"
"9897","(۹۸۹۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ ، قَالَ : سَمِعْتُ عَطَائً ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ یَقُولُ : أَشْہَدُ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَصَلَّی قَبْلَ الْخُطْبَۃِ ، ثُمَّ خَطَبَ ، فَرَأَی أَنَّہُ لَمْ یُسْمِعِ النِّسَائَ ، فَأَتَاہُنَّ ، فَذَکَّرَہُنَّ، وَوَعَظَہُنَّ ، وَأَمَرَہُنَّ بِالصَّدَقَۃِ ، وَبِلاَلٌ قَائِلٌ بِثَوْبِہِ ، قَالَ : فَجَعَلَتِ الْمَرْأَۃُ تُلْقِی الْخَاتَمَ وَالْخُرْصَ وَالشَّیْئَ۔","Sahih","Musannaf Ibn Abi Shaybah 9897","","","كتاب الزكاة"
"9898","(۹۸۹۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ ذَرٍّ ، عَنْ وَائِلِ بْنِ مُہَانَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَصَدَّقْنَ یَا مَعْشَرَ النِّسَائِ ، فَإِنَّکُنَّ أَکْثَرُ أَہْلِ جَہَنَّمَ ، فَقَالَتِ امْرَأَۃٌ لَیْسَتْ مِنْ عِلْیَۃِ النِّسَائِ: مِمَّ ذَلِکَ یَا رَسُولَ اللہِ؟ قَالَ: لأَنَّکُنَّ تُکْثِرْنَ اللَّعَنَ وَتَکْفُرْنَ الْعَشِیرَ۔ (احمد ۱/۳۷۶۔ طیالسی ۳۸۴)","Da'if","Musannaf Ibn Abi Shaybah 9898","","","كتاب الزكاة"
"9899","(۹۸۹۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ خَیْثَمَۃَ ، عَنْ عَدِیِّ بْنِ حَاتِمٍ ، قَالَ : ذَکَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ النَّارَ فَأَعْرَضَ بِوَجْہِہِ وَأَشَاحَ ، ثُمَّ ذَکَرَ النَّارَ فَأَعْرَضَ وَأَشَاحَ ، حَتَّی ظَنَنَّا أَنَّہُ کَأَنَّمَا یَنْظُرُ إلَیْہَا ، ثُمَّ قَالَ : اتَّقُوا النَّارَ وَلَوْ بِشِقِّ تَمْرَۃٍ ، فَمَنْ لَمْ یَجِدْ فَبِکَلِمَۃٍ طَیِّبَۃٍ۔ (بخاری ۶۵۴۰۔ مسلم ۶۸)","Sahih","Musannaf Ibn Abi Shaybah 9899","","","كتاب الزكاة"
"9900","(۹۹۰۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ مَعْقِلٍ ، عَنْ عَدِیِّ بْنِ حَاتِمٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : اتَّقُوا النَّارَ وَلَوْ بِشِقِّ تَمْرَۃٍ۔ (بخاری ۱۴۱۷۔ مسلم ۷۰۳)","Sahih","Musannaf Ibn Abi Shaybah 9900","","","كتاب الزكاة"
"9901","(۹۹۰۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا دَاوُدُ بْنُ قَیْسٍ ، قَالَ : حدَّثَنَا عِیَاضُ بْنُ عَبْدِ اللہِ بْنِ سَعْدِ بْنِ أَبِی سَرْحٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَخْرُجُ یَوْمَ الْعِیدِ ، یَوْمَ الْفِطْرِ فَیُصَلِّی بِالنَّاسِ تَیْنِکَ الرَّکْعَتَیْنِ ، ثُمَّ یُسَلِّمُ ، ثُمَّ یَقُومُ فَیَسْتَقْبِلُ النَّاسَ وَہُمْ جُلُوسٌ فَیَقُولُ : تَصَدَّقُوا ، تَصَدَّقُوا : فَکَانَ أَکْثَرَ مَنْ تَصَدَّقَ النِّسَائُ بِالْقُرْطِ وَالْخَاتَمِ وَالشَّیْئِ۔ (بخاری ۱۴۶۲۔ مسلم ۶۰۵)","Sahih","Musannaf Ibn Abi Shaybah 9901","","","كتاب الزكاة"
"9902","(۹۹۰۲) حَدَّثَنَا ابْنُ نُمَیْرٍ، عَنِ الأَعْمَشِ، عَنْ شَقِیقٍ، عَنْ عَمْرِو بْنِ الْحَارِثِ، عَنْ زَیْنَبَ امْرَأَۃِ عَبْدِاللہِ، قَالَتْ: أَمَرَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالصَّدَقَۃِ ، فَقَالَ : تَصَدَّقْنَ یَا مَعْشَرَ النِّسَائِ۔(بخاری ۱۴۶۶۔ ترمذی ۶۳۶)","Sahih","Musannaf Ibn Abi Shaybah 9902","","","كتاب الزكاة"
"9903","(۹۹۰۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ مَنْصُورِ بْنِ حَیَّانَ ، عَنِ ابْنِ بِجَادٍ ، عَنْ جَدَّتِہِ ، قَالَتْ : قُلْتُ : یَا رَسُولَ اللہِ ، یَأْتِینِی السَّائِلُ ، لَیْسَ عِنْدِی شَیْئٌ أُعْطِیہ ، قَالَتْ : فَقَالَ : لاَ تَرُدِّی سَائِلَکِ إِلاَّ بِشَیْئٍ ، وَلَوْ بِظِلْفٍ۔ (بخاری ۸۴۵۔ طبرانی ۵۶۱)","Hasan","Musannaf Ibn Abi Shaybah 9903","","","كتاب الزكاة"
"9904","(۹۹۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ مَعْبَدِ بْنِ خَالِدٍ ، عَنْ حَارِثَۃَ بْنِ وَہْبٍ الْخُزَاعِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَصَدَّقُوا ، فَإِنَّہُ یُوشِکُ أَنْ یَخْرُجَ الرَّجُلُ بِصَدَقَتِہِ فَلاَ یَجِدُ مَنْ یَقْبَلُہَا۔ (بخاری ۱۴۱۱۔ مسلم ۷۰۰)","Sahih","Musannaf Ibn Abi Shaybah 9904","","","كتاب الزكاة"
"9905","(۹۹۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَمَّارٍ ، عَنْ رَاشِدِ بْنِ الْحَارِثِ ، عَنْ أَبِی ذَرٍّ ، قَالَ : مَا عَلَی الأَرْضِ مِنْ صَدَقَۃٍ تَخْرُجُ ، حَتَّی یُفکَّ عَنْہَا لَحْیَا سَبْعِینَ شَیْطَانًا ، کُلُّہُمْ یَنْہَاہُ عَنْہَا۔ (ابن خزیمۃ ۲۴۵۷۔ حاکم ۴۱۷)","Da'if","Musannaf Ibn Abi Shaybah 9905","","","كتاب الزكاة"
"9906","(۹۹۰۶) حَدَّثَنَا عُمَر بْنُ سَعْدٍ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ أَبِی الزَّعْرَائِ ، عَنْ عَبْدِ اللہِ ؛ أَنَّ رَاہِبًا عَبَدَ اللَّہَ فِی صَوْمَعَۃ سِتِّینَ سَنَۃً ، فَجَائَتِ امْرَأَۃٌ فَنَزَلَتْ إلَی جَنْبِہِ ، فَنَزَلَ إلَیْہَا فَوَاقَعَہَا سِتَّ لَیَالٍ ، ثُمَّ أُسقِط فِی یَدِہِ ، ثُمَّ ہَرَبَ ، فَأَتَی مَسْجِدًا فَأَوَی فِیہِ ، فَمَکَثَ ثَلاَثًا لاَ یَطْعَمُ شَیْئًا ، فَأُتِیَ بِرَغِیفٍ فَکَسَرَ نِصْفَہُ ، فَأَعْطَاہُ رَجُلاً عَنْ یَمِینِہِ ، وَأَعْطَی الآخَرَ عَنْ یَسَارِہِ ، ثُمَّ بُعِثَ إلَیْہِ مَلَکٌ فَقَبَضَ رُوحَہُ ، فَوُضِعَ عَمَلُ سِتِّینَ سَنَۃً فِی کِفَّۃٍ ، وَوُضِعَتِ السَّیِّئَۃُ فِی أُخْرَی ، فَرَجَحَتْ ، ثُمَّ جِیئَ بِالرَّغِیفِ ، فَرَجَحَ بِالسَّیِّئَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 9906","","","كتاب الزكاة"
"9907","(۹۹۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إنَّ اللَّہَ یَقْبَلُ الصَّدَقَۃَ ، وَیَأْخُذُہَا بِیَمِینِہِ فَیُرَبِّیہَا لِصَاحِبِہَا ، کَمَا یُرَبِّی أَحَدُکُمْ فَلُوَّہُ، أَوْ فَصِیلَہُ حَتَّی إنَّ اللُّقْمَۃَ لَتَصِیرُ مِثْلَ أُحُدٍ ، وَتَصْدِیقُ ذَلِکَ فِی کِتَابِ اللہِ عَزَّ وَجَلَّ : {ہُوَ الذی یَقْبَلُ التَّوْبَۃَ عَنْ عِبَادِہِ وَیَأْخُذُ الصَّدَقَاتِ} ، وَ{یَمْحَقُ اللَّہُ الرِّبَا وَیُرْبِی الصَّدَقَاتِ} ۔ (ترمذی ۶۶۲۔ ابن خزیمۃ ۲۴۲۷)","Da'if","Musannaf Ibn Abi Shaybah 9907","","","كتاب الزكاة"
"9908","(۹۹۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ یُونُسَ بْنِ خَبَّابٍ ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا نَقَصَتْ صَدَقَۃٌ مِنْ مَالٍ قَطُّ ، فَتَصَدَّقُوا۔ (احمد ۱/۱۹۳۔ ابویعلی ۸۴۵)","Da'if","Musannaf Ibn Abi Shaybah 9908","","","كتاب الزكاة"
"9909","(۹۹۰۹) حَدَّثَنَا یَحْیَی بْنُ عِیسَی ، عَنِ الأَعْمَشِ ، عَنْ طَلْحَۃَ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : أُہْدِیَتْ لَنَا شَاۃٌ مَشْوِیَّۃٌ ، فَقَسَّمْتُہَا کُلَّہَا إِلاَّ کَتِفَہَا ، فَدَخَلَ عَلَیَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَذَکَرْت ذَلِکَ لَہُ ، فَقَالَ: لاَ ، کُلُّہَا لَکُمْ إِلاَّ کَتِفَہَا۔ (ترمذی ۲۴۷۰۔ احمد ۶/۵۰)","Hasan","Musannaf Ibn Abi Shaybah 9909","","","كتاب الزكاة"
"9910","(۹۹۱۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمٍ ، عَنْ عَطِیَّۃَ مَوْلَی بَنِی عَامِرٍ ، عَنْ یَزِیدَ بْنِ بِشْرٍ السَّکْسَکِیِّ ، قَالَ: بَعَثَہُ یَزِیدُ بْنُ عَبْدِ الْمَلِکِ بِکُِسْوَۃٍ إلَی الْکَعْبَۃِ ، فَلَمَّا أَتَی تَیْمَائَ جَائَہُ سَائِلٌ فَسَأَلَ ، قَالَ : فَقَالَ : تَصَدَّقُوا ، فَإِنَّ الصَّدَقَۃَ تُنْجِی مِنْ سَبْعِینَ بَابًا مِنَ الشَّرِّ ، قَالَ : فَقُلْتُ : مَنْ ہَاہُنَا أَفْقَہُ ؟ قَالُوا : نُسَیٌّ ، رَجُلٌ مِنَ الْیَہُودِ ، فَأَتَیْتُ الدَّارَ ، فَقُلْتُ : ثَمَّ نُسَیٌّ ؟ فَأَشْرَفَتْ عَلَیَّ امْرَأَتُہُ ، فَأَذِنَتْ لِی فَدخلتُ عَلَیْہِ ، فَلَمَّا رَآنِی تَوَضَّأَ ، فَقُلْتُ لَہُ : مَا شَأْنُکَ حِینَ رَأَیْتَنِی تَوَضَّأْتَ ؟ قَالَ : إنَّ اللَّہَ تَعَالَی قَالَ : یَا مُوسَی ، تَوَضَّأْ ، فَإِنْ لَمْ تَفْعَلْ فَأَصَابَتْک مُصِیبَۃٌ فَلاَ تَلُومَنَّ إِلاَّ نَفْسَک ۔ قَالَ : قُلْتُ : إنَّ سَائِلاً یَسْأَلُ ، فَقَالَ : تَصَدَّقُوا ، فَإِنَّ الصَّدَقَۃَ تُنْجِی مِنْ سَبْعِینَ بَابًا مِنَ الشَّرِّ، قَالَ : صَدَقَ ، فَذَکَرَ أَشیائَ مِنَ الْمَنَایَا ، وَہَدْمِ الْحَائِطِ ، وَوَقْصِ الدَّابَّۃِ ، وَالْغَرَقِ مِمَّا شَائَ اللَّہ مِمَّا عُدَّ مِنَ الْمَنَایَا ، قَالَ : قُلْتُ : وَتُنَجِّی مِنَ النَّارِ۔","","Musannaf Ibn Abi Shaybah 9910","","","كتاب الزكاة"
"9911","(۹۹۱۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ مَرْثَدِ بْنِ عَبْدِ اللہِ الْیَزَنِیِّ ، قَالَ : حدَّثَنِی مَنْ سَمِعَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : صَدَقَۃُ الْمُؤْمِنِ ظِلُّہُ یَوْمَ الْقِیَامَۃِ۔ (احمد ۲۳۳)","Hasan","Musannaf Ibn Abi Shaybah 9911","","","كتاب الزكاة"
"9912","(۹۹۱۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ ، عَنْ أَبِی الأَحْوَصِ ، قَالَ : (قدْ أَفْلَحَ مَنْ تَزَکَّی) ، قَالَ : مَنْ رَضَخ۔","","Musannaf Ibn Abi Shaybah 9912","","","كتاب الزكاة"
"9913","(۹۹۱۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ثَابِتٍ ، عَنْ أَبِی مَدَیْنَۃَ ؛ أَنَّ سَائِلاً سَأَلَ عَبْدَ الرَّحْمَن بْنِ عَوْفٍ وَبَیْنَ یَدَیْہِ عِنَبٌ ، فَنَاوَلَہُ حَبَّۃً ، فَکَأَنَّہُمْ أَنْکَرُوا ذَلِکَ ، فَقَالَ : فِی ہَذِہِ مِثْقَالُ ذَرٍّ کَثِیرٌ۔","Hasan","Musannaf Ibn Abi Shaybah 9913","","","كتاب الزكاة"
"9914","(۹۹۱۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ خُلَیْدِ بْنِ جَعْفَرٍ ، قَالَ : سَمِعْتُ أَبَا إیَاسٍ یُحَدِّثُ عَنْ أُمِّ الْحَسَنِ ؛ أَنَّہَا کَانَتْ عِنْدَ أُمِّ سَلَمَۃَ زَوْجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَجَائَ مَسَاکِینُ ، فَقَالَتْ : أُخْرِجُہُنّ ؟ فَقَالَتْ أُمُّ سَلَمَۃَ : مَا بِہَذَا أمِرنَا ، أَبِدِّیہنَّ بِتَمْرَۃٍ تَمْرَۃٍ۔","Hasan","Musannaf Ibn Abi Shaybah 9914","","","كتاب الزكاة"
"9915","(۹۹۱۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ حَمَّادِ بْنِ الْمُخْتَارِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : کَانَ یُقَالُ : رُدُّوا السَّائِلَ وَلَوْ بِمِثْلِ رَأْسِ الْقَطَاۃ۔","","Musannaf Ibn Abi Shaybah 9915","","","كتاب الزكاة"
"9916","(۹۹۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُصْعَبِ بْنِ مُحَمَّدٍ ، عَنْ یَعْلَی بْنِ أَبِی یَحْیَی ، عَنْ فَاطِمَۃَ بِنْتِ حُسَیْنٍ ، عَنْ أَبِیہَا ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لِلسَّائِلِ حَقٌّ وَإِنْ جَائَ عَلَی فَرَسٍ۔ (ابوداؤد ۱۶۶۳۔ احمد ۱/۲۰۱)","Da'if","Musannaf Ibn Abi Shaybah 9916","","","كتاب الزكاة"
"9917","(۹۹۱۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، قَالَ : قَالَ عِیسَی ابْنُ مَرْیَمَ : لِلسَّائِلِ حَقٌّ ، وَإِنْ جَائَ عَلَی فَرَسٍ مُطَوَّقٍ بِالْفِضَّۃِ۔","","Musannaf Ibn Abi Shaybah 9917","","","كتاب الزكاة"
"9918","(۹۹۱۸) حَدَّثَنَا مَالِکُ بْنُ إسْمَاعِیلَ ، عَنْ زُہَیْرٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، قَالَ : إذَا أَتَی أَحَدَکُمُ السَّائِلُ ، وَہُوَ یُرِیدُ الصَّلاَۃَ ، أَوَ قَالَ : یُرِیدُ أَنْ یُصَلِّیَ ، فَإِنِ اسْتَطَاعَ أَنْ یَتَصَدَّقَ فَلْیَفْعَلْ ، فَإِنَّ اللَّہَ یَقُولُ : {قَدْ أَفْلَحَ مَنْ تَزَکَّی وَذَکَرَ اسْمَ رَبِّہِ فَصَلَّی} ، فَإِنِ اسْتَطَاعَ أَنْ یُقَدِّمَ بَیْنَ یَدَیْ صَلاَتِہِ صَدَقَۃً فَلْیَفْعَلْ۔","","Musannaf Ibn Abi Shaybah 9918","","","كتاب الزكاة"
"9919","(۹۹۱۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ لَمْ یُؤَدِّ الزَّکَاۃَ ، فَلاَ صَلاَۃَ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9919","","","كتاب الزكاة"
"9920","(۹۹۲۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ سَلَمَۃَ ، عَنِ الضَّحَّاکِ ، قَالَ : لاَ صَلاَۃَ إِلاَّ بِزَکَاۃٍ۔","","Musannaf Ibn Abi Shaybah 9920","","","كتاب الزكاة"
"9921","(۹۹۲۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُطَرِّفٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، قَالَ : قَالَ عَبْدُ اللہِ : مَا مَانِعُ الزَّکَاۃِ بِمُسْلِمٍ۔","Sahih","Musannaf Ibn Abi Shaybah 9921","","","كتاب الزكاة"
"9922","(۹۹۲۲) حَدَّثَنَا شَرِیکٌ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ أَبُو بَکْرٍ : لَوْ مَنَعُونِی وَلَوْ عِقَالاً مِمَّا أَعْطَوْا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَجَاہَدْتُہمْ ۔ قَالَ ، ثُمَّ تَلاَ : {وَمَا مُحَمَّدٌ إِلاَّ رَسُولٌ قَدْ خَلَتْ مِنْ قَبْلِہِ الرُّسُلُ أَفَئِنْ مَاتَ ، أَوْ قُتِلَ انْقَلَبْتُمْ عَلَی أَعْقَابِکُمْ}۔","","Musannaf Ibn Abi Shaybah 9922","","","كتاب الزكاة"
"9923","(۹۹۲۳) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ إذَا أَدَّیْتَ زَکَاۃَ مَالِکَ ، أَذْہَبْتَ عَنْک شَرَّہُ۔","","Musannaf Ibn Abi Shaybah 9923","","","كتاب الزكاة"
"9924","(۹۹۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا بْنُ إِسْحَاقَ الْمَکِّیِّ ، قَالَ : حَدَّثَنِی یَحْیَی بْنُ عَبْدِ اللہِ بْنِ صَیْفِیٍّ ، عَنْ أَبِی مَعْبَدٍ مَوْلَی ابْنِ عَبَّاسٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ مُعَاذٍ ، قَالَ : بَعَثَنِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنَّکَ تَأْتِی قَوْمًا مِنْ أَہْلِ الْکِتَابِ ، فَادْعُہُمْ إلَی شَہَادَۃِ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ وَأَنِّی رَسُولُ اللہِ ، فَإِنْ ہُمْ أَطَاعُوا لِذَلِکَ فَأَعْلِمْہُمْ ، أَنَّ اللَّہَ افْتَرَضَ عَلَیْہِمْ خَمْسَ صَلَوَاتٍ فِی کُلِّ یَوْمٍ وَلَیْلَۃٍ ، فَإِنْ ہُمْ أَطَاعُوا لِذَلِکَ، فَأَعْلِمْہُمْ أَنَّ اللَّہَ افْتَرَضَ عَلَیْہِمْ صَدَقَۃً فِی أَمْوَالِہِمْ ، تُؤْخَذُ مِنْ أَغْنِیَائِہِمْ فَتُرَدُّ فِی فُقَرَائِہِمْ ، فَإِنْ ہُمْ أَطَاعُوا لِذَلِکَ ، فَإِیَّاکَ وَکَرَائِمَ أَمْوَالِہِمْ ، وَاتَّقِ دَعْوَۃَ الْمَظْلُومِ ، فَإِنَّہَا لَیْسَ بَیْنَہَا وَبَیْنَ اللہِ حِجَابٌ۔ (بخاری ۲۴۴۸۔ ابوداؤد ۱۵۷۹)","Sahih","Musannaf Ibn Abi Shaybah 9924","","","كتاب الزكاة"
"9925","(۹۹۲۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ ابن أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : لُعِنَ مَانِعُ الصَّدَقَۃِ۔ (ترمذی ۱۱۱۹۔ ابوداؤد ۲۰۶۹)","Da'if","Musannaf Ibn Abi Shaybah 9925","","","كتاب الزكاة"
"9926","(۹۹۲۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ؛ مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 9926","","","كتاب الزكاة"
"9927","(۹۹۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ ، عَنِ الْحَارِثِ بْنِ عَبْدِ اللہِ ، عَنْ عَبْدِ اللہِ ، قَالَ : لاَوِی الصَّدَقَۃِ ، یَعْنِی : مَانِعَہَا ، مَلْعُونٌ عَلَی لِسَانِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ الْقِیَامَۃِ۔ (احمد ۱/۴۳۰۔ ابن حبان ۳۲۵۲)","Da'if","Musannaf Ibn Abi Shaybah 9927","","","كتاب الزكاة"
"9928","(۹۹۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مُثَنَّی بْنِ سَعِیدٍ ، قَالَ : سَمِعْتُ أَنَسًا وَشَکَا إلَیْہِ قَوْمٌ مِنَ الأَعْرَابِ الصَّدَقَۃَ ، فَقَالَ : اجْمَعُوہَا وَأَدُّوہَا لِوَقْتِہَا ، فَمَا أُخِذَ مِنْکُمْ بَعْدَ ذَلِکَ فَہُوَ ظُلْمٌ ظُلِمْتُمُوہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9928","","","كتاب الزكاة"
"9929","(۹۹۲۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، عَنْ جَرِیرٍ ، قَالَ : قُلْتُ لِبَنِیَّ : یَا بَنِیَّ ، إذَا جَائَکُمُ الْمُصَدِّقُ فَلاَ تَکْتُمُوہُ مِنْ نَعَمِکُمْ شَیْئًا۔","Sahih","Musannaf Ibn Abi Shaybah 9929","","","كتاب الزكاة"
"9930","(۹۹۳۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : إذَا جَائَکَ الْمُصَدِّقُ ، فَقَالَ: أَخْرِجْ صَدَقَتَکَ ، فَأَخْرِجْہَا ، فَإِنْ قَبِلَ فَبِہَا وَنَعِمَتْ ، فَإِنْ أَبَی فَوَلِّہ ظَہْرَک ، وَقُلَ : اللَّہُمَّ إنِّی أَحْتَسِبُ عِنْدَکَ مَا یَأْخُذُ مِنِّی ، وَلاَ تَلْعَنہُ۔","Sahih","Musannaf Ibn Abi Shaybah 9930","","","كتاب الزكاة"
"9931","(۹۹۳۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، عَنْ جَرِیرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لِیَصْدُرَ الْمُصَدِّقُ عَنْکُمْ حِینَ یُصْدِرُ وَہُوَ رَاضٍ ۔ وَقَالَ الشَّعْبِیُّ : الْمُعْتَدِی فِی الصَّدَقَۃِ کَمَانِعِہَا۔ (ترمذی ۶۴۸۔ احمد ۴/۳۶۵)","Sahih","Musannaf Ibn Abi Shaybah 9931","","","كتاب الزكاة"
"9932","(۹۹۳۲) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا ثَابِتُ بْن قَیْسٍ ، عَنْ خَارِجَۃَ بْنِ إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ جَابِرِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : سَیَأْتِیکُمْ رَکْبٌ مُبْغَضُونَ ، فَإِنْ جَاؤُوکُمْ فَرَحِّبُوا بِہِمْ ، وَخَلُّوا بَیْنَہُمْ وَبَیْنَ مَا یَبْغُونَ ، فَإِنْ عَدَلُوا فَلأَنْفُسِہِمْ وَإِنْ ظَلَمُوا فَعَلَیْہِمْ ، وَأَرْضُوہُمْ فَإِنَّ تَمَامَ زَکَاتِکُمْ رِضَاہُمْ ، وَلْیَدْعُوا لَکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 9932","","","كتاب الزكاة"
"9933","(۹۹۳۳) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ الرَّازِیّ ، عَنْ أَبِی سَنان ، عَنِ الضَّحَّاکِ ، قَالَ : کَانَ عُمَرُ بْنُ الْخَطَّابِ إذَا ظَہَرَ عَلَی مَالٍ قَدْ غُیِّبَ عَنِ الصَّدَقَۃِ ، خَمَّسَہُ۔","","Musannaf Ibn Abi Shaybah 9933","","","كتاب الزكاة"
"9934","(۹۹۳۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ، قَالَ: حدَّثَنَا ابْنُ أَبِی عَرُوبَۃَ، عَنْ عُبَیْدِاللہِ بْنِ رُزَیْقٍ، أَنَّہُ سَمِعَ الْحَسَنَ، قَالَ: قَالَ نَبِیُّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ أَدَّی زَکَاۃَ مَالِہِ أَدَّی الْحَقَّ الَّذِی عَلَیْہِ، وَمَنْ زَادَ فَہُوَ خَیْرٌ لَہُ۔ (ابوداؤد ۱۳۰)","Da'if","Musannaf Ibn Abi Shaybah 9934","","","كتاب الزكاة"
"9935","(۹۹۳۵) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ أَدَّی زَکَاۃَ مَالِہِ ، فَلاَ جُنَاحَ عَلَیْہِ أَنْ لاَ یَتَصَدَّقَ۔ (بخاری ۱۴۵۴۔ عبدالرزاق ۷۰۸۵)","Sahih","Musannaf Ibn Abi Shaybah 9935","","","كتاب الزكاة"
"9936","(۹۹۳۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا بَلَغَ الْمَالُ مِئَتَیْ دِرْہَمٍ ، فَفِیہِ خَمْسَۃُ دَرَاہِمَ۔","","Musannaf Ibn Abi Shaybah 9936","","","كتاب الزكاة"
"9937","(۹۹۳۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَاصِمٍ ، عَنِ الْحَسَنِ ، قَالَ : کَتَبَ عُمَرُ إلَی أَبِی مُوسَی : أَنْ خُذْ مِمَّنْ مَرَّ بِکَ مِنْ تُجَّارِ الْمُسْلِمِینَ مِنْ کُلِّ مِئَتَیْ دِرْہَمٍ ، خَمْسَۃَ دَرَاہِمَ۔","Hasan","Musannaf Ibn Abi Shaybah 9937","","","كتاب الزكاة"
"9938","(۹۹۳۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ جَابِرِ الْحَذَّائِ ، وَکَانَ عَبْدًا لِبَنِی مُجَاشِعٍ ، قَالَ : قُلْتُ لاِبْنِ عُمَرَ : ہَلْ عَلَی الْعَبْدِ زَکَاۃٌ ؟ قَالَ : أَمُسْلِمٌ ؟ قُلْتُ : نَعَمْ ، قَالَ : عَلَیْہِ فِی کُلِّ مِئَتَیْ دِرْہَمٍ خَمْسَۃُ دَرَاہِمَ۔","Da'if","Musannaf Ibn Abi Shaybah 9938","","","كتاب الزكاة"
"9939","(۹۹۳۹) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ؛ قَالَ : تَحِلُّ عَلَیْہِ الزَّکَاۃُ مِنْ یَوْمِ مَلَکَ مِئَتَیْ دِرْہَمٍ ، ثُمَّ یَحُولُ عَلَیْہِ الْحَوْلُ۔","","Musannaf Ibn Abi Shaybah 9939","","","كتاب الزكاة"
"9940","(۹۹۴۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : فِی کُلِّ مِئَتَیْ دِرْہَمٍ خَمْسَۃُ دَرَاہِمَ۔","","Musannaf Ibn Abi Shaybah 9940","","","كتاب الزكاة"
"9941","(۹۹۴۱) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، رَفَعَہُ ، قَالَ : إذَا بَلَغَتْ خَمْسَ أَوَاقٍ فَفِیہَا خَمْسَۃُ دَرَاہِمَ ، وَفِی کُلِّ أَرْبَعِینَ دِرْہَمًا دِرْہَمٌ۔","","Musannaf Ibn Abi Shaybah 9941","","","كتاب الزكاة"
"9942","(۹۹۴۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی ابْنُ حُجَیْرٍ ، عَنْ طَاوُوسٍ ؛ أَنَّہُ کَانَ یَقُولُ : فِی مِئَتَیْ دِرْہَمٍ خَمْسَۃُ دَرَاہِمَ۔","","Musannaf Ibn Abi Shaybah 9942","","","كتاب الزكاة"
"9943","(۹۹۴۳) حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنْ عَوْفٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا کَانَتْ مِئَتَیْ دِرْہَمٍ ،فَفِیہَا خَمْسَۃُ دَرَاہِمَ۔","","Musannaf Ibn Abi Shaybah 9943","","","كتاب الزكاة"
"9944","(۹۹۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ قَالَ : فِی الْمَعَادِنِ مِنْ کُلِّ مِئَتَیْنِ خَمْسَۃٌ۔","","Musannaf Ibn Abi Shaybah 9944","","","كتاب الزكاة"
"9945","(۹۹۴۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا بَلَغَتْ مِئَتَیْنِ فَفِیہَا خَمْسَۃُ دَرَاہِمَ۔","","Musannaf Ibn Abi Shaybah 9945","","","كتاب الزكاة"
"9946","(۹۹۴۶) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَکُونُ فِی الدَّرَاہِمِ زَکَاۃٌ حَتَّی تَبْلُغَ خَمْسَ أَوَاقٍ۔","","Musannaf Ibn Abi Shaybah 9946","","","كتاب الزكاة"
"9947","(۹۹۴۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : إِنْ لَمْ تَکُنْ لَکَ إِلاَّ تِسْعَۃٌ وَتِسْعِینَ وَمِئَۃٌ ، فَلَیْسَ فِیہَا زَکَاۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 9947","","","كتاب الزكاة"
"9948","(۹۹۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : لَیْسَ فِی أَقَلَّ مِنْ مِئَتَیْ دِرْہَمٍ زَکَاۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 9948","","","كتاب الزكاة"
"9949","(۹۹۴۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ قَالَ : کُلُّ شَیْئٍ دُونَ الْمِئَتَیْنِ نَفَقَۃٌ۔","","Musannaf Ibn Abi Shaybah 9949","","","كتاب الزكاة"
"9950","(۹۹۵۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَمْرِو بْنِ یَحْیَی بْنِ عُمَارَۃَ ؛ أَنَّ أَبَاہُ یَحْیَی بْنَ عُمَارَۃَ أَخْبَرَہُ أَنَّہُ سَمِعَ أَبَا سَعِیدٍ الْخُدْرِیَّ ، یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ فِیمَا دُونَ خَمْسِ أَوَاقٍ صَدَقَۃٌ ، وَکَانَتْ تُقَوَّمُ مِئَتَیْ دِرْہَمٍ۔ (بخاری ۱۴۴۷۔ مسلم ۶۷۴)","Sahih","Musannaf Ibn Abi Shaybah 9950","","","كتاب الزكاة"
"9951","(۹۹۵۱) حَدَّثَنَا عَبْدُالرَّحِیمِ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ؛ أَنَّہُ قَالَ: لَیْسَ فِیمَا دُونَ خَمْسِ أَوَاقٍ مِنْ فِضَّۃٍ صَدَقَۃٌ۔","","Musannaf Ibn Abi Shaybah 9951","","","كتاب الزكاة"
"9952","(۹۹۵۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ؛ قَالَ : لَیْسَ فِی الشَّنْقِ شَیْئٌ ، قَالَ : الشَّنْقُ : مَالٌ لَمْ یَبْلُغْ مِئَتَیْ دِرْہَمٍ۔","","Musannaf Ibn Abi Shaybah 9952","","","كتاب الزكاة"
"9953","(۹۹۵۳) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لَیْسَ فِی أَقَلَّ مِنْ مِئَتَیْ دِرْہَمٍ شَیْئٌ۔ (دارقطنی ۹۳)","Da'if","Musannaf Ibn Abi Shaybah 9953","","","كتاب الزكاة"
"9954","(۹۹۵۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمٍ ، عَنْ عَلِیٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لَیْسَ فِی أَقَلَّ مِنْ مِئَتَیْ دِرْہَمٍ شَیْئٌ۔ (ترمذی ۶۲۰۔ ابوداؤد ۱۵۶۶)","Hasan","Musannaf Ibn Abi Shaybah 9954","","","كتاب الزكاة"
"9955","(۹۹۵۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنِی عَمَّارُ بْنُ رُزَیْقٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ مِثْلَہ ، قَالَ : لَیْسَ فِی أَقَلَّ مِنْ مِئَتَیْ دِرْہَمٍ شَیْئٌ۔","Hasan","Musannaf Ibn Abi Shaybah 9955","","","كتاب الزكاة"
"9956","(۹۹۵۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ لاَ یَرَی فِیمَا زَادَ عَلَی الْمِئَتَیْنِ شَیْئٌ ، حَتَّی یَبْلُغَ أَرْبَعِینَ۔","","Musannaf Ibn Abi Shaybah 9956","","","كتاب الزكاة"
"9957","(۹۹۵۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَاصِمٍ ، عَنِ الْحَسَنِ ، قَالَ : کَتَبَ عُمَرُ إلَی أَبِی مُوسَی : فَمَا زَادَ عَلَی الْمِئَتَیْنِ ، فَفِی کُلِّ أَرْبَعِینَ دِرْہَماً دِرْہَم۔","Hasan","Musannaf Ibn Abi Shaybah 9957","","","كتاب الزكاة"
"9958","(۹۹۵۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : لَیْسَ فِیمَا زَادَ عَلَی الْمِئَتَیْنِ شَیْئٌ ، حَتَّی یَکُونَ أَرْبَعِینَ دِرْہَماً۔","","Musannaf Ibn Abi Shaybah 9958","","","كتاب الزكاة"
"9959","(۹۹۵۹) حَدَّثَنَا ابْنُ مَہْدِِیٍّ ، عَنْ سَعِیدِ بْنِ زَیْدٍ ، عَنْ وَاصِلٍ مَوْلَی أَبِی عُیَیْنَۃَ ، عَنْ مَکْحُولٍ ، قَالَ : لَیْسَ فِیمَا زَادَ عَلَی الْمِئَتَیْنِ شَیْئٌ ، حَتَّی یَبْلُغَ أَرْبَعِینَ دِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 9959","","","كتاب الزكاة"
"9960","(۹۹۶۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : حَتَّی یَبْلُغَ أَرْبَعِینَ دِرْہَمًا نَیِّفًا عَلَی الْمِئَتَیْنِ فَہِیَ حِینَئِذٍ سِتَّۃُ دَرَاہِمَ ، ثُمَّ لاَ شَیْئَ حَتَّی تَبْلُغَ ثَمَانِینَ وَمِئَتَیْ دِرْہَمٍ ، فَہِیَ سَبْعَۃُ دَرَاہِمَ ، ثُمَّ کَذَلِکَ۔","","Musannaf Ibn Abi Shaybah 9960","","","كتاب الزكاة"
"9961","(۹۹۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : لَیْسَ فِی أَقَلَّ مِنْ مِئَتَیْ دِرْہَمٍ شَیْئٌ ، فَمَا زَادَ فَبِالْحِسَابِ۔","Hasan","Musannaf Ibn Abi Shaybah 9961","","","كتاب الزكاة"
"9962","(۹۹۶۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ جَابِر الْحَذَّائِ ، وَکَانَ عَبْدًا لِبَنِی مُجَاشِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَا زَادَ عَلَی الْمِئَتَیْنِ ، فَبِالْحِسَابِ۔","Da'if","Musannaf Ibn Abi Shaybah 9962","","","كتاب الزكاة"
"9963","(۹۹۶۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَا زَادَ عَلَی الْمِئَتَیْنِ فَبِحِسَابٍ۔","","Musannaf Ibn Abi Shaybah 9963","","","كتاب الزكاة"
"9964","(۹۹۶۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ وُہَیْبٍ ، عَنْ یُونُسَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : مَا زَادَ فَبِالْحِسَابِ۔","","Musannaf Ibn Abi Shaybah 9964","","","كتاب الزكاة"
"9965","(۹۹۶۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ قَتَادَۃَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : مَا زَادَ فَبِالْحِسَابِ۔","","Musannaf Ibn Abi Shaybah 9965","","","كتاب الزكاة"
"9966","(۹۹۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنَ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : لَیْسَ فِی أَقَلَّ مِنْ عِشْرِینَ دِینَارًا شَیْئٌ ، وَفِی عِشْرِینَ دِینَارًا نِصْفُ دِینَارٍ ، وَفِی أَرْبَعِینَ دِینَارًا دِینَارٌ ، فَمَا زَادَ فَبِالْحِسَابِ۔","Hasan","Musannaf Ibn Abi Shaybah 9966","","","كتاب الزكاة"
"9967","(۹۹۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : فِی عِشْرِینَ مِثْقَالاً نِصْفُ مِثْقَالٍ ، وَفِی أَرْبَعِینَ مِثْقَالاً مِثْقَالٌ۔","","Musannaf Ibn Abi Shaybah 9967","","","كتاب الزكاة"
"9968","(۹۹۶۸) حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنْ عِمْرَانَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : فِی أَرْبَعِینَ دِینَارًا دِینَارٌ ، وَفِی عِشْرِینَ دِینَارًا نِصْفُ دِینَارٍ۔","","Musannaf Ibn Abi Shaybah 9968","","","كتاب الزكاة"
"9969","(۹۹۶۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : فِی عِشْرِینَ دِینَارًا نِصْفُ دِینَارٍ۔","","Musannaf Ibn Abi Shaybah 9969","","","كتاب الزكاة"
"9970","(۹۹۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَیْسَ فِی أَقَلَّ مِنْ عِشْرِینَ مِثْقَالاً شَیْئٌ ، وَفِی عِشْرِینَ نِصْفُ مِثْقَالٍ ، وَفِی أَرْبَعِینَ مِثْقَالاً مِثْقَالٌ۔","","Musannaf Ibn Abi Shaybah 9970","","","كتاب الزكاة"
"9971","(۹۹۷۱) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ رُزَیْقٍ مَوْلَی بَنِی فَزَارَۃَ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ إلَیْہِ حِینَ اُسْتُخْلِفَ : خُذْ مِمَّنْ مَرَّ بِکَ مِنْ تُجَّارِ الْمُسْلِمِینَ فِیمَا یُدِیرُونَ مِنْ أَمْوَالِہِمْ ، مِنْ کُلِّ أَرْبَعِینَ دِینَارًا دِینَارًا ، فَمَا نَقَصَ فَبِحِسَابِ مَا نَقَصَ حَتَّی یَبْلُغَ عشرین ، فَإِذَا نَقَصَتْ ثُلُثَ دِینَارٍ فَدَعْہَا ، لاَ تَأْخُذْ مِنْہَا شَیْئًا ، وَاکْتُبْ لَہُمْ بَرَائَۃً بِمَا تَأْخُذُ مِنْہُمْ إلَی مِثْلِہَا مِنَ الْحَوْلِ ، وَخُذْ مِمَّنْ مَرَّ بِکَ مِنْ تُجَّارِ أَہْلِ الذِّمَّۃِ ، فِیمَا یُظْہِرُونَ مِنْ أَمْوَالِہِمْ وَیُدِیرُونَ مِنَ التِّجَارَاتِ ، مِنْ کُلِّ عِشْرِینَ دِینَارًا دِینَارًا ، فَمَا نَقَصَ فَبِحِسَابِ مَا نَقَصَ حَتَّی یَبْلُغَ عَشَرَۃَ دَنَانِیرَ ، فَإِذَا نَقَصَتْ ثُلُثَ دِینَارٍ فَدَعْہَا ، لاَ تَأْخُذْ مِنْہَا شَیْئًا ، وَاکْتُبْ لَہُمْ بَرَائَۃً إلَی مِثْلِہَا مِنَ الْحَوْلِ بِمَا تَأْخُذُ مِنْہُمْ۔","","Musannaf Ibn Abi Shaybah 9971","","","كتاب الزكاة"
"9972","(۹۹۷۲) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِاللہِ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ، قَالَ: لَیْسَ فِیمَا دُونَ أَرْبَعِینَ مِثْقَالاً مِنَ الذَّہَبِ صَدَقَۃٌ۔","","Musannaf Ibn Abi Shaybah 9972","","","كتاب الزكاة"
"9973","(۹۹۷۳) حَدَّثَنَا یَحْیَی بْنُ عَبْدِ الْمَلِکِ بْنِ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ؛ أَنَّہُ کَانَ لاَ یَرَی فِی عِشْرِینَ دِینَارًا زَکَاۃً ، حَتَّی تَکُونَ عِشْرِینَ مِثْقَالاً ، فَیَکُون فِیہَا نِصْفُ مِثْقَالٍ۔","","Musannaf Ibn Abi Shaybah 9973","","","كتاب الزكاة"
"9974","(۹۹۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ؛ قَالَ : کَانَ لِاِمْرَأَۃِ عَبْدِ اللہِ طَوْقٌ فِیہِ عِشْرُونَ مِثْقَالاً ، فَأَمَرَہَا أَنْ تُخْرِجَ مِنْہُ خَمْسَۃَ دَرَاہِمَ۔","","Musannaf Ibn Abi Shaybah 9974","","","كتاب الزكاة"
"9975","(۹۹۷۵) حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنْ أَشعث ، عَنِ الْحَسَنِ ، قَالَ : فِی عِشْرِینَ دِینَارًا نِصْفُ دِینَارٍ ، وَفِی أَرْبَعِینَ دِینَارًا دِینَارٌ۔","","Musannaf Ibn Abi Shaybah 9975","","","كتاب الزكاة"
"9976","(۹۹۷۶) حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لَیْسَ فِی أَقَلَّ مِنْ أَرْبَعِینَ دِینَارًا شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 9976","","","كتاب الزكاة"
"9977","(۹۹۷۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ عَطَائٌ : لاَ یَکُونُ فِی مَالٍ صَدَقَۃٌ حَتَّی یَبْلُغَ عِشْرِینَ دِینَارًا ، فَإِذَا بَلَغَتْ عِشْرِینَ دِینَارًا فَفِیہَا نِصْفُ دِینَارٍ ، وَفِی کُلِّ أَرْبَعَۃِ دَنَانِیرَ یَزِیدُہَا الْمَالُ دِرْہَمٌ ، حَتَّی تَبْلُغَ أَرْبَعِینَ دِینَارًا ، وَفِی کُلِّ أَرْبَعِینَ دِینَارًا دِینَارٌ ، وَفِی کُلِّ أَرْبَعَۃٍ وَعِشْرِینَ دِینَارًا نِصْفُ دِینَارٍ وَدِرْہَمٌ۔","","Musannaf Ibn Abi Shaybah 9977","","","كتاب الزكاة"
"9978","(۹۹۷۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عُبَیْدَۃَ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ عَن رَجُلٍ لَہُ مِئَۃ دِرْہَمٍ وَعَشَرَۃُ دَنَانِیرَ ؟ قَالَ : یُزَکِّی مِنَ الْمِئَۃِ دِرْہَم دِرْہَمَیْنِ وَنصفًا ، وَمِنَ الدَّنَانِیرِ بِرُبْعِ دِینَارٍ ۔ قَالَ : وَسَأَلْتُ الشَّعْبِیَّ ، فَقَالَ : یُحْمَلُ الأَکْثَرُ عَلَی الأَقَلِّ ۔ أَوَ قَالَ : الأَقَلُّ عَلَی الأَکْثَرِ ، فَإِذَا بَلَغَتْ فِیہِ الزَّکَاۃُ زَکَّاہ۔","","Musannaf Ibn Abi Shaybah 9978","","","كتاب الزكاة"
"9979","(۹۹۷۹) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عُبَیْدِ اللہِ بْنُ عُبَیْدٍ ، قَالَ : قُلْتُ لِمَکْحُولٍ : یَا أَبَا عَبْدِ اللہِ ، إنَّ لِی سَیْفًا فِیہِ خَمْسُونَ وَمِئَۃُ دِرْہَمٍ ، فَہَلْ عَلَیَّ فِیہِ زَکَاۃٌ ، قَالَ : أَضِفْ إلَیْہِ مَا کَانَ لَکَ مِنْ ذَہَبٍ وَفِضَّۃٍ ، فَإِذَا بَلَغَ مِئَتَیْ دِرْہَمٍ ذَہَبٍ وَفِضَّۃٍ ، فَعَلَیْک فِیہِ الزَّکَاۃُ۔","","Musannaf Ibn Abi Shaybah 9979","","","كتاب الزكاة"
"9980","(۹۹۸۰) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَنْصَارِیُّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَقُولُ : إذَا کَانَتْ لَہُ ثَلاَثُونَ دِینَارًا وَمِئَۃُ دِرْہَمٍ کَانَ عَلَیْہِ فِیہَا الصَّدَقَۃُ ، وَکَانَ یَرَی الدَّرَاہِمَ وَالدَّنَانِیرَ عَیْنًا کُلَّہُ۔","","Musannaf Ibn Abi Shaybah 9980","","","كتاب الزكاة"
"9981","(۹۹۸۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَتَبَ کِتَابَ الصَّدَقَۃِ فَقَرَنَہُ بِسَیْفِہِ ، أَوَ قَالَ : بِوَصِیَّتِہِ ، وَلَمْ یُخْرِجْہُ حَتَّی قُبِضَ ، فَلَمَّا قُبِضَ عَمِلَ بِہِ أَبُو بَکْرٍ حَتَّی ہَلَکَ ، ثُمَّ عَمِلَ بِہِ عُمَرُ ، فَکَانَ فِیہِ : فِی خَمْسٍ مِنَ الإِبِلِ شَاۃٌ ، وَفِی عَشْرٍ شَاتَانِ ، وَفِی خَمْسَۃَ عَشَرَ ثَلاَثُ شِیَاہٍ ، وَفِی عِشْرِینَ أَرْبَعُ شِیَاہٍ ، وَفِی خَمْسٍ وَعِشْرِینَ بِنْتُ مَخَاضٍ إلَی خَمْسٍ وَثَلاَثِینَ ، فَإِذَا زَادَتْ فَفِیہَا بِنْتُ لَبُونٍ إلَی خَمْسٍ وَأَرْبَعِینَ ، فَإِذَا زَادَتْ فَحِقَّۃٌ إلَی سِتِّینَ ، فَإِذَا زَادَتْ فَجَذَعَۃٌ إلَی خَمْسٍ وَسَبْعِینَ ، فَإِنْ زَادَتْ فَابْنَتَا لَبُونٍ إلَی تِسْعِینَ ، فَإِنْ زَادَتْ فَحِقَّتَانِ إلَی عِشْرِینَ وَمِئَۃٍ ، فَإِنْ زَادَتْ عَلَی عِشْرِینَ وَمِئَۃٍ فَفِی کُلِّ خَمْسِینَ حِقَّۃٌ ، وَفِی کُلِّ أَرْبَعِینَ بِنْتُ لَبُونٍ ، لاَ یُجْمَعُ بَیْنَ مُفْتَرِقٍ ، وَلاَ یُفَرَّقُ بَیْنَ مُجْتَمِعٍ ، وَمَا کَانَ مِنْ خَلِیطَیْنِ ، فَإِنَّہُمَا یَتَرَاجَعَانِ بِالسَّوِیَّۃِ۔ (ترمذی ۶۲۱۔ ابوداؤد ۱۵۶۲)","Da'if","Musannaf Ibn Abi Shaybah 9981","","","كتاب الزكاة"
"9982","(۹۹۸۲) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ خُصَیْفٍ ، عَنْ أَبِی عُبَیْدَۃَ ، وَزِیَادِ بْنِ أَبِی مَرْیَمَ ، عْن عَبْدِ اللہِ قَالَ : فِی خَمْسٍ وَعِشْرِینَ مِنَ الإِبِلِ بِنْتُ مَخَاضٍ۔","Da'if","Musannaf Ibn Abi Shaybah 9982","","","كتاب الزكاة"
"9983","(۹۹۸۳) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : فِی خَمْسٍ مِنَ الإِبِلِ شَاۃٌ إلَی تِسْعٍ ، فَإِنْ زَادَتْ وَاحِدَۃً فَفِیہَا شَاتَانِ إلَی أَرْبَعَ عَشْرَۃَ ، فَإِنْ زَادَتْ وَاحِدَۃً فَفِیہَا ثَلاَثُ شِیَاہٍ إلَی تِسْعَ عَشْرَۃَ ، فَإِنْ زَادَتْ وَاحِدَۃً فَفِیہَا أَرْبَعٌ إلَی أَرْبَعٍ وَعِشْرِینَ ، فَإِنْ زَادَتْ وَاحِدَۃً فَفِیہَا خَمْسُ شِیَاہٍ ، فَإِنْ زَادَتْ وَاحِدَۃً فَفِیہَا بِنْتُ مَخَاضٍ ، أَوِ ابْنُ لَبُونٍ ذَکَرٌ ، أَکْبَرُ مِنْہَا بِعَامٍ إلَی خَمْسٍ وَثَلاَثِینَ ، فَإِنْ زَادَتْ وَاحِدَۃً فَفِیہَا بِنْتُ لَبُونٍ إلَی خَمْسٍ وَأَرْبَعِینَ ، فَإِنْ زَادَتْ وَاحِدَۃً فَفِیہَا حِقَّۃٌ طَرُوقَۃُ الْفَحْلِ إلَی سِتِّینَ ، فَإِنْ زَادَتْ وَاحِدَۃً فَفِیہَا جَذَعَۃٌ إلَی خَمْسٍ وَسَبْعِینَ ، فَإِنْ زَادَتْ وَاحِدَۃً فَفِیہَا بِنْتَا لَبُونٍ إلَی تِسْعِینَ ، فَإِنْ زَادَتْ وَاحِدَۃً فَفِیہَا حِقَّتَانِ إلَی عِشْرِینَ وَمِئَۃٍ ، فَإِذَا کَثُرَتِ الإِبِلُ فَفِی کُلِّ خَمْسِینَ مِنَ الإِبِلِ حِقَّۃٌ ، وَلاَ یُجْمَعُ بَیْنَ مُفْتَرِقٍ ، وَلاَ یُفَرَّقُ بَیْنَ مُجْتَمِعٍ۔","Hasan","Musannaf Ibn Abi Shaybah 9983","","","كتاب الزكاة"
"9984","(۹۹۸۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، قَالَ : وُجِدَ فِی وَصِیَّۃِ عُمَرَ : فِی خَمْسٍ وَعِشْرِینَ مِنَ الإِبِلِ بِنْتُ مَخَاضٍ۔","","Musannaf Ibn Abi Shaybah 9984","","","كتاب الزكاة"
"9985","(۹۹۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ فِطْرٍ ، عَنِ الشَّعْبِیِّ (ح) وَعَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ قَالاَ : فِی خَمْسٍ وَعِشْرِینَ بِنْتُ مَخَاضٍ۔","","Musannaf Ibn Abi Shaybah 9985","","","كتاب الزكاة"
"9986","(۹۹۸۶) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ بَہزِ بْنِ حَکِیمٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : فِی کُلِّ إبِلٍ سَائِمَۃٍ أَرْبَعِینَ بِنْتُ لَبُونٍ ، لاَ یُفَرَّقُ إبِلٌ عَنْ حِسَابِہَا ، مَنْ أَعْطَاہَا مُؤْتَجِرًا فَلَہُ أَجْرُہُ ، عَزْمَۃٌ مِنْ عَزَمَاتِ رَبِّنَا ، لاَ یَحِلُّ لآلِ مُحَمَّدٍ مِنْہَا شَیْئٌ۔ (ابوداؤد ۱۵۶۹۔ احمد ۵/۴)","Hasan","Musannaf Ibn Abi Shaybah 9986","","","كتاب الزكاة"
"9987","(۹۹۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُوسَی بْنِ عُقْبَۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ عُمَرُ : إذَا کَثُرَتِ الإِبِلُ فَفِی کُلِّ خَمْسِینَ حِقَّۃٌ ، وَفِی کُلِّ أَرْبَعِینَ بِنْتُ لَبُونٍ۔","Sahih","Musannaf Ibn Abi Shaybah 9987","","","كتاب الزكاة"
"9988","(۹۹۸۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : فِی کُلِّ خَمْسٍ وَعِشْرِینَ بِنْتُ مَخَاضٍ۔","","Musannaf Ibn Abi Shaybah 9988","","","كتاب الزكاة"
"9989","(۹۹۸۹) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ، عَنْ یَحْیَی بْنِ سَعِیدٍ، قَالَ: کَانَ فِی الْکِتَابِ الَّذِی کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ حِینَ بَعَثَہُمْ یُصَدِّقُونَ فِی الإِبِلِ : إذَا بَلَغَتْ خَمْسًا وَعِشْرِینَ فَفِیہَا بِنْتُ مَخَاضٍ ، فَإِنْ زَادَتْ فَابْنُ لَبُونٍ ذَکَرٌ۔","","Musannaf Ibn Abi Shaybah 9989","","","كتاب الزكاة"
"9990","(۹۹۹۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، قَالَ : فِی خَمْسٍ وَعِشْرِینَ بِنْتُ مَخَاضٍ۔","","Musannaf Ibn Abi Shaybah 9990","","","كتاب الزكاة"
"9991","(۹۹۹۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الأَجْلَحِ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَتَبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی الْیَمَنِ أَنْ یُؤْخَذَ مِنَ الإِبِلِ مِنْ کُلِّ خَمْسٍ شَاۃٌ ، وَمِنْ کُلِّ عَشْرٍ شَاتَانِ ، وَمِنْ خَمْسَۃَ عَشَرَ ثَلاَثُ شِیَاہٍ ، وَمِنْ عِشْرِینَ أَرْبَعُ شِیَاہٍ ، وَمِنْ خَمْسٍ وَعِشْرِینَ خَمْسُ شِیَاہٍ ، فَإِذَا زَادَتْ وَاحِدَۃً فَفِیہَا بِنْتُ مَخَاضٍ إلَی خَمْسٍ وَثَلاَثِینَ ، فَإِنْ لَمْ تَجِدْ فِی الإِبِلِ بِنْتَ مَخَاضٍ فَابْنُ لَبُونٍ ذَکَرٌ ، فَإِنْ زَادَتْ وَاحِدَۃً فَفِیہَا بِنْتُ لَبُونٍ إلَی خَمْسٍ وَأَرْبَعِینَ ، فَإِنْ زَادَتْ وَاحِدَۃً فَفِیہَا حِقَّۃٌ إلَی سِتِّینَ ، فَإِنْ زَادَتْ وَاحِدَۃً فَفِیہَا جَذَعَۃٌ إلَی خَمْسٍ وَسَبْعِینَ ، فَإِنْ زَادَتْ وَاحِدَۃً فَفِیہَا بِنْتَا لَبُونٍ إلَی تِسْعِینَ ، فَإِنْ زَادَتْ وَاحِدَۃً فَفِیہَا حِقَّتَانِ إلَی عِشْرِینَ وَمِئَۃٍ ، فَإِذَا کَثُرَتِ الإِبِلُ فَفِی کُلِّ خَمْسِینَ حِقَّۃٌ ، وَفِی کُلِّ أَرْبَعِینَ بِنْتُ لَبُونٍ ، وَلاَ یُفَرَّقُ بَیْنَ مُجْتَمِعٍ ، وَلاَ یُجْمَعُ بَیْنَ مُفْتَرِقٍ ، وَلاَ یُؤْخَذُ فِی الصَّدَقَۃِ تَیْسٌ ، وَلاَ ہَرِمَۃٌ ، وَلاَ ذَاتُ عَوَارٍ ۔ قَالَ الأَجْلَحُ : فَقُلْتُ لِلشَّعْبِیِّ : مَا یَعْنِی بِقَوْلِہِ : لاَ یُجْمَعُ بَیْنَ مُفْتَرِقٍ ، وَلاَ یُفَرَّقُ بَیْنَ مُجْتَمِعٍ ؟ قَالَ : الرَّجُلُ تَکُونُ لَہُ الْغَنَمُ فَلاَ یُفَرِّقُہَا کَیْ لاَ یُؤْخَذَ مِنْہَا صَدَقَۃٌ ، وَلاَ یُجْمَعُ بَیْنَ مُفْتَرِقٍ الْقَوْمُ تَکُونُ لَہُمَ الْغَنَمُ لاَ تَجِبُ فِیہَا الزَّکَاۃُ ، فَلاَ تُجْمَعُ فَتُؤْخَذُ مِنْہَا الصَّدَقَۃُ۔","","Musannaf Ibn Abi Shaybah 9991","","","كتاب الزكاة"
"9992","(۹۹۹۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمٍ ، عَنْ عَلِیٍّ ، قَالَ : إِنْ لَمْ تَکُنْ إِلاَّ أَرْبَعٌ مِنَ الذَّوْدِ فَلَیْسَ فِیہَا صَدَقَۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 9992","","","كتاب الزكاة"
"9993","(۹۹۹۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ ، وَعَبْدِ اللہِ ، أَنَّہُمَا قَالاَ : لَیْسَ فِی أَقَلَّ مِنْ خَمْسٍ مِنْ الإِبِلِ صَدَقَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 9993","","","كتاب الزكاة"
"9994","(۹۹۹۴) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : بَلَغَنَا أَنَّ سَالِمَ بْنَ عَبْدِ اللہِ کَانَ یَقُولُ : عِنْدَنَا کِتَابُ عُمَرَ بْنِ الْخَطَّابِ فِی صَدَقَۃِ الإِبِلِ ، فَلَمْ یَسْأَلْنَا عَنْہُ أَحَدٌ ، حَتَّی قَدِمَ عَلَیْنَا عُمَرُ بْنُ عَبْدِ الْعَزِیزِ فَأَرْسَلْنَا بِہِ إلَیْہِ ، فَکَانَ فِی الْکِتَابِ الَّذِی کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ حِینَ بَعَثَہُمْ یُصَدِّقُونَ : أَنْ لَیْسَ فِی الإِبِلِ صَدَقَۃٌ حَتَّی تَبْلُغَ خَمْسًا۔","","Musannaf Ibn Abi Shaybah 9994","","","كتاب الزكاة"
"9995","(۹۹۹۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَمْرِو بْنِ یَحْیَی بْنِ عُمَارَۃَ ، عَنْ أَبِیہِ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ فِی أَقَلَّ مِنْ خَمْسِ ذَوْدٍ صَدَقَۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 9995","","","كتاب الزكاة"
"9996","(۹۹۹۶) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لَیْسَ فِی أَقَلَّ مِنْ خَمْسِ ذَوْدٍ شَیْئٌ۔","Da'if","Musannaf Ibn Abi Shaybah 9996","","","كتاب الزكاة"
"9997","(۹۹۹۷) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، عَنْ شَیْبَانَ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لَیْسَ فِیمَا دُونَ خَمْسِ ذَوْدٍ صَدَقَۃٌ۔ (احمد ۲/۹۲۔ بزار ۸۸۸)","Da'if","Musannaf Ibn Abi Shaybah 9997","","","كتاب الزكاة"
"9998","(۹۹۹۸) حَدَّثَنَا عَلِیُّ بْنُ إِسْحَاقَ ، عَنِ ابْنِ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ سُہَیْلٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لَیْسَ فِی أَقَلَّ مِنْ خَمْسِ ذَوْدٍ صَدَقَۃٌ۔ (احمد ۲/۴۰۳۔ طحاوی ۳۵)","Sahih","Musannaf Ibn Abi Shaybah 9998","","","كتاب الزكاة"
"9999","(۹۹۹۹) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَتَبَ کِتَابَ الصَّدَقَۃِ ، فَقَرَنَہُ بِسَیْفِہِ ، أَوَ قَالَ : بِوَصِیَّتِہِ فَلَمْ یُخْرِجْہُ حَتَّی قُبِضَ ، عَمِلَ بِہِ أَبُو بَکْرٍ حَتَّی ہَلَکَ ، ثُمَّ عَمِلَ بِہِ عُمَرُ حَتَّی ہَلَکَ ، فَکَانَ فِیہِ : فِی الإِبِلِ إذَا زَادَتْ عَلَی عِشْرِینَ وَمِئَۃٍ ، فَفِی کُلِّ خَمْسِینَ حِقَّۃٌ ، وَفِی کُلِّ أَرْبَعِینَ ابْنَۃُ لَبُونٍ۔","Da'if","Musannaf Ibn Abi Shaybah 9999","","","كتاب الزكاة"
"10000","(۱۰۰۰۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : إذَا کَثُرَتِ الإِبِلُ فَفِی کُلِّ خَمْسِینَ حِقَّۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 10000","","","كتاب الزكاة"
"10001","(۱۰۰۰۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الأَجْلَحِ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَتَبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی الْیَمَنِ : إذَا کَثُرَتِ الإِبِلُ فَفِی کُلِّ خَمْسِینَ حِقَّۃٌ ، وَفِی کُلِّ أَرْبَعِینَ بِنْتُ لَبُونٍ۔","","Musannaf Ibn Abi Shaybah 10001","","","كتاب الزكاة"
"10002","(۱۰۰۰۲) حَدَّثَنَا عَبْدُ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ، قَالَ: وُجِدَ فِی وَصِیَّۃِ عُمَرَ: مَا زَادَ عَلَی عِشْرِینَ وَمِئَۃٍ ، فَفِی کُلِّ أَرْبَعِینَ بِنْتُ لَبُونٍ ، وَفِی کُلِّ خَمْسِینَ حِقَّۃٌ۔","","Musannaf Ibn Abi Shaybah 10002","","","كتاب الزكاة"
"10003","(۱۰۰۰۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا کَثُرَتِ الإِبِلُ فَفِی کُلِّ خَمْسِینَ حِقَّۃٌ۔","","Musannaf Ibn Abi Shaybah 10003","","","كتاب الزكاة"
"10004","(۱۰۰۰۴) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : بَلَغَنَا أَنَّ سَالِمًا کَانَ یَقُولُ : عِنْدَنَا کِتَابُ عُمَرَ فِی صَدَقَۃِ الإِبِلِ وَالْغَنَمِ ، حَتَّی قَدِمَ عَلَیْنَا کِتَابُ عُمَرَ بْنِ عَبْدِالْعَزِیزِ ، فَکَانَ فِی الْکِتَابِ الَّذِی کَتَبَ عُمَرُ بْنُ عَبْدِالْعَزِیزِ حِینَ بَعَثَہُمْ یُصْدِقُونَ : إِذَا زَادَتْ عَلَی عِشْرِینَ وَمِئَۃٍ فَفِی کُلِّ خَمْسِینَ حِقَّۃٌ ، وَفِی کُلِّ أَرْبَعِینَ بِنْتُ لَبُونٍ۔","","Musannaf Ibn Abi Shaybah 10004","","","كتاب الزكاة"
"10005","(۱۰۰۰۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : إذَا زَادَتْ عَلَی عِشْرِینَ وَمِئَۃٍ اسْتَقْبَلَ بِہَا الْفَرِیضَۃَ.","Hasan","Musannaf Ibn Abi Shaybah 10005","","","كتاب الزكاة"
"10006","(۱۰۰۰۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ؛ مِثْلَہُ.","No Data Available","Musannaf Ibn Abi Shaybah 10006","","","كتاب الزكاة"
"10007","(۱۰۰۰۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُجَالِدٍ ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ، عَنِ الصُّنَابِحِیِّ الأَحْمَسِیِّ ، قَالَ: أَبْصَرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَاقَۃً حَسَنَۃً فِی إبِلِ الصَّدَقَۃِ ، فَقَالَ : مَا ہَذِہِ ؟ قَالَ صَاحِبُ الصَّدَقَۃِ : إنِّی ارْتَجَعْتہَا بِبَعِیرَیْنِ مِنْ حَوَاشِی الإِبِلِ ، قَالَ : فَقَالَ : فَنَعَمْ إذًا. (احمد ۴/۳۴۹۔ طبرانی ۷۴۱۷)","Da'if","Musannaf Ibn Abi Shaybah 10007","","","كتاب الزكاة"
"10008","(۱۰۰۰۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ ہِلاَلِ بْنِ خَبَّابٍ ، عَنْ مَیْسَرَۃَ أَبِی صَالِحٍ ، قَالَ : حدَّثَنَا سُوَیْد بْنُ غَفَلَۃَ ، قَالَ : أَتَانَا مُصَدِّقُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَأَتَیْتَہُ فَجَلَسْتُ إلَیْہِ ، فَسَمِعْتُہُ یَقُولُ : إنَّ فِی عَہْدِی أَنْ لاَ آخُذَ مِنْ رَاضِعِ لَبَنٍ ، وَلاَ یُجْمَعُ بَیْنَ مُتَفَرِّقٍ ، وَلاَ یُفَرَّقُ بَیْنَ مُجْتَمِعٍ ، قَالَ : وَأَتَاہُ رَجُلٌ بِنَاقَۃٍ کَوْمَائَ ، فَأَبَی أَنْ یَأْخُذَہَا. (ابوداؤد ۱۵۷۳۔ طبرانی ۶۴۷۳)","Hasan","Musannaf Ibn Abi Shaybah 10008","","","كتاب الزكاة"
"10009","(۱۰۰۰۹) حَدَّثَنَا حَفْصٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعَثَ مُصَدِّقًا ، فَقَالَ : لاَ تَأْخُذْ مِنْ حَزَرَاتِ أَنْفُسِ النَّاسِ شَیْئًا ، وَخُذِ الشَّارِفَ ، وَذَاتَ الْعَیْبِ. (بیہد ۱۰۲)","","Musannaf Ibn Abi Shaybah 10009","","","كتاب الزكاة"
"10010","(۱۰۰۱۰) حَدَّثَنَا حَفْصٌ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ ، قَالَ : أَبْصَرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَاقَۃً حَسَنَۃً فِی إبِلِ الصَّدَقَۃِ ، فَقَالَ : مَا أَمْرُ ہَذِہِ النَّاقَۃِ ؟ فَقَالَ صَاحِبُ الصَّدَقَۃِ : یَا رَسُولَ اللہِ ، عَرَفْتُ حَاجَتَکَ إلَی الظَّہْرِ ، فَارْتَجَعْتہَا بِبَعِیرَیْنِ مِنَ الصَّدَقَۃِ.","","Musannaf Ibn Abi Shaybah 10010","","","كتاب الزكاة"
"10011","(۱۰۰۱۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ یَحْیَی ، عَنِ الْقَاسِمِ ؛ أَنَّ عُمَرَ مَرَّتْ بِہِ غَنَمُ مِنْ غَنَمِ الصَّدَقَۃِ ، فَرَأَی فِیہَا شَاۃً ذَاتَ ضَرْعٍ ، فَقَالَ : مَا ہَذِہِ ؟ قَالُوا : مِنْ غَنَمِ الصَّدَقَۃِ ، فَقَالَ : مَا أَعْطَی ہَذِہِ أَہْلُہَا وَہُمْ طَائِعُونَ ، لاَ تَفْتِنُوا النَّاسَ ، لاَ تَأْخُذُوا حَزَرَاتِ النَّاسِ ، نُکِبُوا عَنِ الطَّعَامِ.","","Musannaf Ibn Abi Shaybah 10011","","","كتاب الزكاة"
"10012","(۱۰۰۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا بْنِ إِسْحَاقَ ، عَنْ یَحْیَی بْنِ عَبْدِ اللہِ بْنِ صَیْفِیٍّ ، عَنْ أَبِی مَعْبَدٍ ، عَنِ ابْنِ عَبَّاسٍ، عَنْ مُعَاذٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إیَّاکَ وَکَرَائِمَ أَمْوَالِہِمْ ، حِینَ بَعَثَہُ إلَی الْیَمَنِ.","Sahih","Musannaf Ibn Abi Shaybah 10012","","","كتاب الزكاة"
"10013","(۱۰۰۱۳) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ خُصَیْفٍ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فِی ثَلاَثِینَ مِنَ الْبَقَرِ تَبِیعٌ ، أَوْ تَبِیعَۃٌ ، وَفِی أَرْبَعِینَ مُسِنَّۃٌ. (ترمذی ۶۲۲۔ احمد ۱/۴۱۱)","","Musannaf Ibn Abi Shaybah 10013","","","كتاب الزكاة"
"10014","(۱۰۰۱۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن مَسْرُوقٍ ، قَالَ : لَمَّا بَعَثَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُعَاذًا إلَی الْیَمَنِ ، أَمَرَہُ أَنْ یَأْخُذَ مِنْ کُلِّ ثَلاَثِینَ مِنَ الْبَقَرِ تَبِیعًا ، أَوْ تَبِیعَۃً ، وَمِنْ کُلِّ أَرْبَعِینَ مُسِنَّۃً ، وَمِنْ کُلِّ حَالِمٍ دِینَارًا ، أَوْ عَدْلَہُ مَعَافِرَ. (ابوداؤد ۱۵۷۱)","","Musannaf Ibn Abi Shaybah 10014","","","كتاب الزكاة"
"10015","(۱۰۰۱۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الأَجْلَحِ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَتَبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی الْیَمَنِ : أَنْ یُؤْخَذَ مِنْ ثَلاَثِینَ مِنَ الْبَقَرِ تَبِیعٌ ، أَوْ تَبِیعَۃٌ ، وَفِی کُلِّ أَرْبَعِینَ مُسِنَّۃٌ.","","Musannaf Ibn Abi Shaybah 10015","","","كتاب الزكاة"
"10016","(۱۰۰۱۶) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، وَأَبِی وَائِلٍ ، قَالاَ : بَعَثَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُعَاذًا إلَی الْیَمَنِ ، وَأَمَرَہُ أَنْ یَأْخُذَ مِنَ الْبَقَرِ مِنْ کُلِّ ثَلاَثِینَ تَبِیعًا ، أَوْ تَبِیعَۃً ، وَمِنْ أَرْبَعِینَ مُسِنَّۃً ، وَمِنْ کُلِّ حَالِمٍ دِینَارًا، أَوْ عَدْلَہُ مِنَ الْمَعَافِرِ. (ابوداؤد ۱۵۷۰۔ نسائی ۲۲۳۲)","","Musannaf Ibn Abi Shaybah 10016","","","كتاب الزكاة"
"10017","(۱۰۰۱۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : إذَا بَلَغَتْ ثَلاَثِینَ فَفِیہَا تَبِیعٌ ، أَوْ تَبِیعَۃٌ حَوْلِیٌّ ، فَإِذَا بَلَغَتْ أَرْبَعِینَ فَفِیہَا مُسِنَّۃٌ ، ثَنِیَّۃٌ فَصَاعِدًا.","Hasan","Musannaf Ibn Abi Shaybah 10017","","","كتاب الزكاة"
"10018","(۱۰۰۱۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، قَالَ : بَلَغَنِی أَنَّ مُعَاذًا قَالَ : فِی ثَلاَثِینَ تَبِیعٌ ، وَفِی أَرْبَعِینَ بَقَرَۃٌ.","","Musannaf Ibn Abi Shaybah 10018","","","كتاب الزكاة"
"10019","(۱۰۰۱۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : فِی ثَلاَثِینَ مِنَ الْبَقَرِ تَبِیعٌ ، أَوْ تَبِیعَۃٌ جَذَعٌ ، أَوْ جَذعَۃٌ ، وَفِی أَرْبَعِینَ مُسِنَّۃٌ.","","Musannaf Ibn Abi Shaybah 10019","","","كتاب الزكاة"
"10020","(۱۰۰۲۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ شَہْرٍ ، قَالَ : فِی سَائِمَۃِ الْبَقَرِ ، فِی کُلِّ ثَلاَثِینَ تَبِیعٌ ، وَفِی کُلِّ أَرْبَعِینَ مُسِنَّۃٌ.","","Musannaf Ibn Abi Shaybah 10020","","","كتاب الزكاة"
