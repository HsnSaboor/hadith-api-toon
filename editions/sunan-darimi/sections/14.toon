hadiths[18]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"2905","(حديث موقوف) أَخْبَرَنَا أَخْبَرَنَا عُبَيْدُ اللَّهِ بْنُ مُوسَى، عَنْ ابْنِ أَبِي لَيْلَى، عَنْ عَامِرٍ الشَّعْبِيِّ، عَنْ عَلِيٍّ: فِي امْرَأَةٍ وَأَبَوَيْنِ، قَالَ: مِنْ أَرْبَعَةٍ: لِلْمَرْأَةِ الرُّبُعُ، وَلِلْأُمِّ ثُلُثُ مَا بَقِي، وَمَا بَقِيَ فَلِلْأَبِ"".""","Da'if","Sunan al-Darimi 2905","","","3. شوہر کے ساتھ ماں باپ، اور بیوی کے ساتھ ماں باپ کے حصے کا بیان"
"2906","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ، عَنْ سُفْيَانَ، عَنْ الْأَعْمَشِ، وَمَنْصُورٍ، عَنْ إِبْرَاهِيمَ، عَنْ عَبْدِ اللَّهِ، قَالَ: كَانَ عُمَرُ إِذَا سَلَكَ بِنَا طَرِيقًا اتَّبَعْنَاهُ فِيهِ، وَجَدْنَاهُ سَهْلًا، وَإِنَّهُ قَضَى فِي امْرَأَةٍ وَأَبَوَيْنِ مِنْ أَرْبَعَةٍ: فَأَعْطَى الْمَرْأَةَ الرُّبُع، وَالأُمَّ ثُلُثَ مَا بَقِيَ، وَالْأَبَ سَهْمَيْنِ.""","Sahih","Sunan al-Darimi 2906","","","3. شوہر کے ساتھ ماں باپ، اور بیوی کے ساتھ ماں باپ کے حصے کا بیان"
"2907","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا سُفْيَانُ عَنْ عِيسَى، عَنْ الشَّعْبِيِّ، عَنْ زَيْدِ بْنِ ثَابِتٍ مِثْلَ ذَلِكَ.","Sahih","Sunan al-Darimi 2907","","","3. شوہر کے ساتھ ماں باپ، اور بیوی کے ساتھ ماں باپ کے حصے کا بیان"
"2908","(حديث موقوف) أَخْبَرَنَا مُحَمَّدٌ، حَدَّثَنَا سُفْيَانُ، عَنْ أَبِيهِ، عَنْ الْمُسَيَّبِ بْنِ رَافِعٍ، عَنْ عَبْدِ اللَّهِ، قَالَ: كَانَ يَقُولُ: مَا كَانَ اللَّهُ لِيَرَانِي أَنْ أُفَضِّلَ أُمًّا عَلَى أَبٍ"".""","Sahih","Sunan al-Darimi 2908","","","3. شوہر کے ساتھ ماں باپ، اور بیوی کے ساتھ ماں باپ کے حصے کا بیان"
"2909","(حديث موقوف) أَخْبَرَنَا أَخْبَرَنَا سَعِيدُ بْنُ عَامِرٍ، أَنْبَأَنَا شُعْبَةُ، عَنْ الْحَكَمِ، عَنْ عِكْرِمَةَ، قَالَ: أَرْسَلَ ابْنُ عَبَّاسٍ إِلَى زَيْدِ بْنِ ثَابِتٍ: أَتَجِدُ فِي كِتَابِ اللَّهِ لِلْأُمِّ ثُلُثُ مَا بَقِي؟ فَقَالَ زَيْدٌ: إِنَّمَا أَنْتَ رَجُلٌ تَقُولُ بِرَأْيِكَ، وَأَنَا رَجُلٌ أَقُولُ بِرَأْيِي"".""","Sahih","Sunan al-Darimi 2909","","","3. شوہر کے ساتھ ماں باپ، اور بیوی کے ساتھ ماں باپ کے حصے کا بیان"
"2910","(حديث موقوف) حَدَّثَنَا حَجَّاجُ بْنُ مِنْهَالٍ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، عَنْ حَجَّاجٍ، عَنْ الشَّعْبِيِّ، وَحَجَّاجٍ، عَنْ عَطَاءٍ، عَنْ ابْنِ عَبَّاسٍ: أَنَّهُمَا قَالَا فِي زَوْجٍ وَأَبَوَيْنِ: لِلزَّوْجِ النِّصْفُ، وَلِلْأُمِّ ثُلُثُ جَمِيعِ الْمَالِ، وَمَا بَقِيَ فَلِلْأَبِ"".""","Da'if","Sunan al-Darimi 2910","","","3. شوہر کے ساتھ ماں باپ، اور بیوی کے ساتھ ماں باپ کے حصے کا بیان"
"2911","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا حَجَّاجُ بْنُ مِنْهَالٍ، أَنْبَأَنَا أَبُو عَوَانَةَ، عَنْ الْأَعْمَشِ، عَنْ إِبْرَاهِيمَ، عَنْ عَلِيٍّ، قَالَ: لِلْأُمِّ ثُلُثُ جَمِيعِ الْمَالِ فِي امْرَأَةٍ وَأَبَوَيْنِ، وَفِي زَوْجٍ وَأَبَوَيْنِ"".""","","Sunan al-Darimi 2911","","","3. شوہر کے ساتھ ماں باپ، اور بیوی کے ساتھ ماں باپ کے حصے کا بیان"
"2912","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا ابْنُ إِدْرِيسَ، عَنْ أَبِيهِ، عَنْ الْفُضَيْلِ بْنِ عَمْرٍو، عَنْ إِبْرَاهِيمَ، قَالَ: خَالَفَ ابْنُ عَبَّاسٍ أَهْلَ الْقِبْلَةِ فِي امْرَأَةٍ وَأَبَوَيْنِ: جَعَلَ لِلْأُمِّ الثُّلُثَ مِنْ جَمِيعِ الْمَالِ"".""","","Sunan al-Darimi 2912","","","3. شوہر کے ساتھ ماں باپ، اور بیوی کے ساتھ ماں باپ کے حصے کا بیان"
"2913","(حديث موقوف) أَخْبَرَنَا أَخْبَرَنَا مُحَمَّدُ بْنُ يُوسُفَ، عَنْ سُفْيَانَ الثَّوْرِيِّ، عَنْ أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ، عَنْ الْأَسْوَدِ بْنِ يَزِيدَ، قَالَ:قَضَى مُعَاذُ بْنُ جَبَلٍ بِالْيَمَنِ فِي بِنْتٍ وَأُخْتٍ، فَأَعْطَى الْبِنْتَ النِّصْفَ، وَالْأُخْتَ النِّصْفَ"".""","Sahih","Sunan al-Darimi 2913","","","4. بیٹی کے ساتھ حقیقی بہن کو کتنا حصہ ملے گا؟"
"2914","(حديث موقوف) أَخْبَرَنَا أَخْبَرَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا سُفْيَانُ، عَنْ الْأَعْمَشِ، عَنْ إِبْرَاهِيمَ، عَنْ الْأَسْوَدِ بْنِ يَزِيدَ: أَنَّ ابْنَ الزُّبَيْرِ كَانَ لَا يُوَرِّثُ الْأُخْتَ مِنْ الْأَبِ، وَالْأُمِّ مَعَ الْبِنْتِ حَتَّى حَدَّثَهُ الْأَسْوَدُ أَنَّ مُعَاذَ بْنَ جَبَلٍ جَعَلَ لِلْبِنْتِ النِّصْفَ، وَلِلْأُخْتِ النِّصْفَ، فَقَالَ: أَنْتَ رَسُولِي إِلَى عَبْدِ اللَّهِ بْنِ عُتْبَة، فَأَخْبِرْهُ بِذَاكَ، وَكَانَ قَاضِيَهُ بِالْكُوفَةِ.""","Sahih","Sunan al-Darimi 2914","","","4. بیٹی کے ساتھ حقیقی بہن کو کتنا حصہ ملے گا؟"
"2915","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا بِشْرُ بْنُ عُمَرَ، قَالَ: سَأَلْتُ ابْنَ أَبِي الزِّنَادِ، عَنْ رَجُلٍ تَرَكَ بِنْتًا وَأُخْتًا؟ فَقَالَ:لِابْنَتِهِ النِّصْف، وَلأُخْتِهِ مَا بَقِيَ""قَالَ: وَقَالَ: أَخْبَرَنِي أَبِي، عَنْ خَارِجَةَ بْنِ زَيْدٍ: أَنَّ زَيْدَ بْنَ ثَابِتٍ كَانَ ""يَجْعَلُ الْأَخَوَاتِ مَعَ الْبَنَاتِ عَصَبَةً، لَا يَجْعَلُ لَهُنَّ إِلَّا مَا بَقِيَ"".""","Sahih","Sunan al-Darimi 2915","","","4. بیٹی کے ساتھ حقیقی بہن کو کتنا حصہ ملے گا؟"
"2916","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا سُفْيَانُ، عَنْ مَنْصُورٍ، وَالْأَعْمَشِ، عَنْ إِبْرَاهِيمَ: فِي زَوْجٍ، وَأُمٍّ، وَإِخْوَةٍ لِأَبٍ وَأُم، وَإِخْوَةٍ لِأُمٍّ، قَالَ: كَانَ عُمَر، وَعَبْدُ اللَّه، ِوَزَيْدٌ يُشَرِّكُونَ، وَقَالَ عُمَرُ:لَمْ يَزِدْهُمْ الْأَبُ إِلَّا قُرْبًا"".""","Sahih","Sunan al-Darimi 2916","","","5. مشرکہ یعنی بھائیوں کی شرکت کا بیان"
"2917","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا مُحَمَّدٌ، حَدَّثَنَا سُفْيَانُ، عَنْ أَبِي إِسْحَاق، عَنْ الْحَارِثِ، عَنْ عَلِيٍّ: أَنَّهُ كَانَ لَا يُشَرِّكُ"".""","Hasan","Sunan al-Darimi 2917","","","5. مشرکہ یعنی بھائیوں کی شرکت کا بیان"
"2918","(حديث موقوف) أَخْبَرَنَا أَخْبَرَنَا مُحَمَّدٌ، حَدَّثَنَا سُفْيَانُ، عَنْ سُلَيْمَانَ التَّيْمِيِّ، عَنْ أَبِي مِجْلَزٍ: أَنَّ عُثْمَانَ كَانَ يُشَرِّك، وَعَلِيٌّ كَانَ لا يُشَرِّكُ.""","Sahih","Sunan al-Darimi 2918","","","5. مشرکہ یعنی بھائیوں کی شرکت کا بیان"
"2919","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا مُحَمَّدٌ، حَدَّثَنَا سُفْيَانُ، عَنْ ابْنِ ذَكْوَانَ:أَنَّ زَيْدًا كَانَ يُشَرِّكُ"".""","Sahih","Sunan al-Darimi 2919","","","5. مشرکہ یعنی بھائیوں کی شرکت کا بیان"
"2920","(حديث مقطوع) حَدَّثَنَا مُحَمَّدٌ، حَدَّثَنَا سُفْيَانُ، عَنْ عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ، عَنْ شُرَيْح:أَنَّهُ كَانَ يُشَرِّكُ.""","Sahih","Sunan al-Darimi 2920","","","5. مشرکہ یعنی بھائیوں کی شرکت کا بیان"
"2921","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ الصَّلْتِ، حَدَّثَنَا أَبُو شِهَابٍ، عَنْ الْحَجَّاجِ، عَنْ عَبْدِ الْمَلِكِ بْنِ الْمُغِيرَةِ، عَنْ سَعِيدِ بْنِ فَيْرُوزَ، عَنْ أَبِيه: أَنَّ عُمَرَ قَالَ فِي الْمُشَرَّكَة: لَمْ يَزِدْهُمْ الْأَبُ إِلَّا قُرْبًا.""","Da'if","Sunan al-Darimi 2921","","","5. مشرکہ یعنی بھائیوں کی شرکت کا بیان"
"2922","(حديث موقوف) أَخْبَرَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا زُهَيْرٌ، عَنْ أَبِي إِسْحَاق، عَنْ الْحَارِثِ الْأَعْوَرِ، قَالَ: أُتِيَ عَبْدُ اللَّهِ فِي فَرِيضَةِ بَنِي عَمٍّ، أَحَدُهُمْ أَخٌ لِأُمٍّ، فَقَالَ: الْمَالُ أَجْمَعُ لِأَخِيهِ لِأُمِّه، فَأَنْزَلَهُ بِحِسَابِ، أَوْ بِمَنْزِلَةِ الْأَخِ مِنْ الْأَبِ وَالْأُمِّ، فَلَمَّا قَدِمَ عَلِيٌّ، سَأَلْتُهُ عَنْهَا، وَأَخْبَرْتُهُ بِقَوْلِ عَبْدِ اللَّهِ، فَقَالَ:يَرْحَمُهُ اللَّهُ، إِنْ كَانَ لَفَقِيهًا، أَمَّا أَنَا فَلَمْ أَكُنْ لِأَزِيدَهُ عَلَى مَا فَرَضَ اللَّهُ لَهُ: سَهْمٌ السُّدُسُ، ثُمَّ يُقَاسِمُهُمْ كَرَجُلٍ مِنْهُمْ"".""","Hasan","Sunan al-Darimi 2922","","","6. دو چچا زاد جن میں سے ایک شوہر یا ایک اخیافی بھائی ہو اس کا حصہ"
