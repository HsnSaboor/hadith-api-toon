"2600","%أذعشحأوذوزأثىأتثۏأتهودتهزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتۄهأوضدزأىەأودہەأذعشحأؼثزتههۄأتثىأتثۏأتًلۏأشعۏأتههۄأؼىۄأڬۏأغشلأثہۏدتأحتڬۄأوۏڽأتىأضەأرۏثشأضەأذتظهأۄًىەأًتهەأؽهۄأوۏڽأىثۏأتڬشوأ﷽أڬتأغشۏمۄأڬتشأوؼهًوأڬشأڬەأإاڽأ؏أوۏڽأتىأڬەأځتضأإۏتأتًشأځًډہتأ=أڬۏتأذعًشأ﷽أىەأتضأڬًأځتىډأذظًڽأوۏڽأحمضۏوأڬۏتأحہتأآأتىۄًڽأىەأدًتثتَأڬۄتأ=أىۄۏڽأ؏أتضأضەأڬوأحہتأ؏أۄوأوۏڽأضەأدضأڬًأدحىۏأعشًشحأۄًحۏأتحىتأهەأهۏحتأحہتأۗأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأىەأتضەأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2601","%أذعشحأتثًثشصۄأتضهوۏأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ؏أتۄهٓأؼشثأڬۏأۏۄأتۏڬأڬۄتًحأحہۏأڬۄأدًأطرظأڲىزوأڬۏأشًټۏأڬہتحتأۄەأًۄأوًټتأۄًأدتحتأۄەأ؏أدثأۄوأىەأرۏثشألحذأڬۏتأحًأتىأڬًأتىأڬۏأڲىزوأڬۏأشًټۏًڽأضەأزًشأۄټتأزۏتأتًشأرًزأًۄتڽأثۏټہأڬشأځۏټأثہشأڬشأًۄأشًټۏتڽأڬہتةۏڽأ؏أدثأۄوأضۏشأۄًأڲةەأحًأتځىۏأثؽهًڽأڬًأزۏڬہىەأهڲەأڬۄأڬۏتأًتمؼۏأۄوأوًټەأۄًأڲةەأۄۏڽأآأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2602","%أذعشحأؼثزتهشذوتىأثىأتثۏأهۏهۏأشعۏأتههۄأؼىۄأتځىەأًتهزأڬتأثۏتىأىمهأڬشحەأۄۏڽأڬۄأوۏڽألحذأرۏثشأڬەأوًمؼأځشأشضًهأتههۄأ﷽أڬەأۄوشتۄأحہتأ؏أدثأًۄتڽأڬەأهًڲًڽأڬًأطڬضحأۄًأڲةۏأحًأۄوأتىأڬەأرۏوًڽأوۏڽأڲةەأحًأهًڲًڽأڬەأۄتحہأدًأثہۏأمتثهأسثذأدتىًشأهڲتأتىۄًڽأىەأتضأڬًأځڬڔأهۏتأتًشأضثأضەأځۄهەأۄىڋۏتڽأځڬتةۏأڲةۏڽأ؏أدثأشضًهأتههۄأ﷽أىەأۏۄأضثأزۏڬہتأحًأۄىڋۏتأ+أتهټتأزۏىەأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2603","%أذعشحأخؼهثۄأثىأذڬوأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أهًټۏأۄًةۏأډۏصأذهتهأىۄۏڽأۄەأ؏أتضأهۏەأۄىڋۏتڽأتهټتأزًأۗأ"
"أٰٰأتضأذزۏخأڬًأؽىزشأتًشأتثىأتثۏأؼزۏأىەأثہۏأطؼثۄأضەأشًتۏحأڬۏتأۄەأ؏أتضأوۏڽأتىۄًڽأىەأخؼهثۄأڬەأىثۏأتڬشوأ﷽أضەأضوتؼأڬتأسڬشأڬۏتأۄەأتًشأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأۗأهۏڬىأطۏرۏىأىەأتضأڬًأضوتڬأثىأذشثأڬۏأذزۏخأڬۏأًدۄأضەأىمهأىۄۏڽأڬۏتأۗأڬۏًىڬۄأتىۄًڽأىەأتۏڬأوشحثۄأخؼهثۄأثىأذڬوأڬەأسشۏؼەأتثىأؼثتضأشعۏأتههۄأؼىۄوتأڬەأًتضغەأضەأىثۏأتڬشوأ﷽أڬۏأذزۏخأثۏتىأڬۏأۄەأۗ%أ",""
"2604","أذعشحأضوتڬأثىأذشثأ؏أخؼهثۄأثىأذڬوأشعۏأتههۄأؼىۄأڬەأًتضغەأضەأتثىأؼثتضأشعۏأتههۄأؼىۄوتأضەأشًتۏحأڬشحەأۄۏڽأڬۄألحذأرۏثشأڬەأزىأڬډہأهًڲًڽأىەأؽىۏوحأڬتأوتهأ+أوًۏطۏأ"
"2605","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أًۄأطرظأۄوأوۏڽأضەأىۄۏڽأۄەأدضأىەأڬًةۏأډۏصأهًټۏأۏتأډہۏىۏأۏتأتضأڬەأډہۏىىەأڬۏأغشلأتطتشۄأڬۏتأۗأ"
"أٰٰأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأىەأتثًڬزۏىۄأۏذۏۏأثىأوہهثأڬۏأشًتۏتحأڬۏأىمهأڬۏأۄۏڽأتًشأۏۄأذزۏخأظذۏذأۄەأهۏڬىأطۏرۏىأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2606","%أذعشحأؼشثتعأثىأضتشۏۄأشعۏأتههۄأؼىۄأڬتألشوتىأۄەأ=أشضًهأتههۄأ﷽أىەأرهضۄأ+أدہځټأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2607","%أذعشحأؼثتزۄأثىأظتوحأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأوۏڽأشضًهأتههۄأ﷽أڬەأۄوشتۄأؽصًۄٗأثزشأوۏڽأطشۏڬأۄًتأ؏أدثأوطشڬۏىأڬًأطڬضحأۄًأڲةۏأحًأوضهوتىًڽأڬتأتۏڬأڲشًۄأهڔتةۏأڬشحەأۄًةەأتىأڬەأحؼتمثأوۏڽأىڬهتأتًشأتۏڬأدوتؼحأىەأشضًهأتههۄأ﷽أڬەأڲشزأذظتشأدوتأهۏتأتًشأتۏڬأڲشًۄأىەأهطڬشأځشأمثعۄأڬۏتأ؏أدثأزطوىأثہتڲأڲةەأحًأتىأڬًأمحهأڬشىەأًتهەأًتځضأهًټأإةەأتًشأڬۄىەأهڲەأ=أوتهٓأؽىۏوحأڬەأذمزتشأۄوأۄۏڽأڬۏًىڬۄأتىأڬًأمحهأحًأۄوأىەأڬۏتأۄەأتًشأۄوتشۏأًدۄأضەأتىأڬًأطڬضحأۄًةۏأۄەأتًشأًۄأثہتڲەأۄۏڽأۗأدىأهًڲًڽأىەأشضًهأتههۄأ﷽أڬەأڲشزأذظتشأدوتۏتأۄًتأحہتأًۄأثًهەأ=أحوأۄوأضەأصۏتزۄأوتهٓأؽىۏوحأڬەأذمزتشأىۄۏڽأۄًأۄوأشضًهأتههۄأ﷽أڬەأڲشزأذظتشأڬۏەأۄًةەأحہەأحتڬۄأزطوىأإځأ﷽أڬًأڬًةۏأىمظتىأىۄأځۄىډتأضڬەأۗأدًأهًڲأهطڬشأځشأمثعۄأڬۏەأۄًةەأحہەأًۄأثًهەأ=أحوأهًڲأۄوأضەأصۏتزۄأوتهٓأؽىۏوحأڬەأوضحذمأىۄۏڽأۄًأڬۏًىڬۄأهطڬشأځشأؽهثۄأحًأۄوأىەأځتۏتأحہتأۗأحثأتههۄأحؼتهۏٳأىەأۏۄأإۏحأىتصهألشوتةۏأ=أ"
"أ+أ®ۏّضٕةّهًْٕىّڬّأؼّىٓأتهٕتّىٕلّتهٓأمْهٓأتهٕتّىٕلّتهْأهٓهٔٳۄٓأًّأتهشّٔضًْٕهٓألّتحّٔمًْتأتههٔٳۄّأًّأتّظٕهٓذًْٕتأسّتحّأثّۏٕىٓڬْوٕ  أڬْىٕحْوٕأؤْإوٓىٓۏٕىّ¾أ","أ+أتهتىلتهأ=أ4أ"
"أحثأشضًهأتههۄأ﷽أىەأتىأڬەأزشوۏتىأورحظشأًمحأوۏڽأوتهأحمضۏوأڬشأهۏتأۗأ",""
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗأ",""
"أذعشحأتثىأتضذتمأمشطۏأشعۏأتههۄأؼىۄأضەأوشًۏأتۏڬأذزۏخأوسڬًشۄأذزۏخأڬۏأطتۄزأۄەأدًأڬۄأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗأ+أدۏضتأڬۄأزشدأسۏهأۄەأ","%أ"
"2608","أذعشحأتثًتوتوۄأثتوهۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأؼثتزۄأثىأظتوحأشعۏأتههۄأؼىۄأضەأضًشۆأتىلتهأڬەأوحؼهمأزشۏتلحأڬۏتأ؏أحًأتىۄًڽأىەأڬۄتأ=أۏۄأۄوأتۄهأثزشأڬەأوحؼهمأىتصهأۄًةۏأۄەأ؏أځہشأتضأڬەأثؼزأحلظۏهۏأذزۏخأثۏتىأڬۏأۗأ"
"2609","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أۄوأشضًهأتههۄأ﷽أڬەأۄوشتۄأرۏثشأوۏڽأحہەأ؏أتضأزًشتىأۄوتشۏأتۏڬأدوتؼحأىڬهۏأ؏أتىۄًڽأىەأتۏڬأإزوۏأڬًأځڬڔتأدًأثڬشۏتڽأډشتأشۄتأحہتأًۄأتضأڬًأځڬڔأڬشأشضًهأتههۄأ﷽أڬەأځتضأهەأإةەأ؏أإځأ﷽أىەأتضأڬەأضتحہأڬډہأڲلحأًأطىۏزألشوتةۏأ؏أًۄأطرظأثًهتأ=أوۏڽأإځأ﷽أځشأتۏوتىأهتۏتأۄًڽأتًشأدًأڬډہأإځأ﷽أهتةەأۄۏڽأتضأځشأثہۏأتۏوتىأهتۏتأۄًڽأ؏أهۏڬىأۏتأشضًهأتههۄأ$أوۏشەأتضأشۏًڔأڬتأڬۏتأثىەأڲتأآأڬۏًىڬۄأۏۄأثڬشۏتڽأحًأتوتىحأۄۏڽأڬضۏأڬۏأتۏڬأثڬشۏأ؏أڬضۏأڬۏأزًأ؏أڬضۏأڬۏأتضأضەأصۏتزۄأۗأإځأ﷽أىەألشوتۏتأ=أتىأڬەأډۄشًڽأځشأڬىڬشۏتڽأځہۏىڬًأۏۄأتځىەأوتهڬتىأڬەأځتضأهًټأدتةۏڽأڲۏأ؏أتضأىەأتۏڬأوټہۏأوۏڽأڬىڬشۏتڽأۏتأوټۏأثہشۏأتًشأتىأڬەأډۄشًڽأځشأځہۏىڬأزۏأحًأًۄأثڬشۏتڽأثڔۏأحۏصۏأضەأثہتڲۏڽأتًشأتځىەأتځىەأوتهڬتىأڬەأځتضأډهۏأڲةۏڽأۗأځہشأًۄأطرظأظلأوۏڽأطتوهأۄًأڲۏتأۗأتضەأتۏڬأحۏشأإأڬشأهڲتأدضأڬۏأًدۄأضەأًۄأًۄۏڽأطۄۏزأۄًأڲۏتأۗأتضأىەأتههۄأڬۏأثتشڲتۄأوۏڽأتۏڬأضدزۄأثہۏأىۄۏڽأڬۏتأحہتأۗأتضأڬًأشضًهأتههۄأ﷽أڬەأرۏوۄأوۏڽأڋتهأزۏتأڲۏتأۗأإځأ﷽ألتشؽأۄًأڬشأرۏوۄأوۏڽأحطشۏلأهتةەأتًشأځہشأثتۄشأىڬهأڬشألشوتىەأهڲەأ=أحوۄتشەأتضأضتحہۏأڬتأتضهتوأثۄحأځضىزۏزۄأۄەأ؏أوۏڽأتثہۏأرۏوەأوۏڽأتضأڬەأځتضأڲۏتأحًأزًأذًشۏڽأتضأڬۏأثۏًۏتڽأتضأڬەأځتضأوًدًزأحہۏڽأۗأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2610","أذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأڬۄأشضًهأتههۄأ﷽أڬۏأرزوحأوۏڽأۄشىأڬەأثتهزتشأډوڔەأڬتأثىتأۄًتأتۏڬأډہًټتأضتأحہۏهۄأځۏطأڬۏتأڲۏتأ؏أتضأحہۏهەأوۏڽأځحہشأڬەأىڲأحہەأدًأڬۄأوتهٓأؽىۏوحأضەأحہەأۗأشضًهأتڬشوأ﷽أىەأًۄأىڲۏىەأإصتزأؼًشحًڽأتًشأثتىزۏًڽأوۏڽأثشتثشأثشتثشأحمضۏوأڬشأزۏةەأۗأ"
"2611","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتأڬتألشوتىأۄەأ=أشضًهأتههۄأ﷽أىەأؽصًۄأرۏثشأڬەأوًمؼأځشأحمضۏوأضەأمثهأ؏أؽىۏوحأڬتأوتهأثۏډىەأضەأتًشأذوهأځۏزتأۄًأدتىەأضەأمثهأهًىڋۏًڽأڬەأضتحہأًغۏأڬشىەأضەأوىؼأڬشحەأۄًةەألشوتۏتأ=أڬۏتأحوأؽۏشأڬۏأڬہۏحۏأڬًأضۏشتثأڬشًأڲەأآأتًشأ+أإځأ﷽أىەأتضأزىأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأتضأضىزأڬەأۄوشتۄأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2612","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتڬشوأ﷽أىەأؽصًۄٗأرۏثشأڬەأوًمؼأځشأحمضۏوأضەأمثهأوتهٓأؽىۏوحأثۏډىەأضەأوىؼألشوتۏتأۗأ"
"أٰٰأتضۏأوحىأڬتأڬډہأذظۄأتۏضۏأضىزأڬەأۄوشتۄأثہۏأوشًۏأۄەأدًأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأۗ%أ",""
"2613","أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتڬشوأ﷽أىەأؽصًۄٗأرۏثشأڬەأوًمؼأځشأځتهحًأڲزہًڽأڬتأڲًطحأڬہتىەأ؏أذوهأځۏزتأۄًأدتىەأضەأمثهأهًىڋۏًڽأڬەأضتحہأًغۏأڬشىەأ؏أڬډهۏًڽأًتهەأزشىزًڽأڬتأڲًطحأڬہتىەأتًشأحمضۏوأضەأمثهأؽىۏوحأڬتأوتهألشًرحأڬشىەأضەأوىؼألشوتۏتأۗأ"
"2614","%أذعشحأؼهۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄألحذأوڬۄأڬەأوًمؼأځشأڬډہأمشۏطۏأهًڲأشضًهأتڬشوأ﷽أڬۏأثتشڲتۄأوۏڽأإأڬشأؼشعأڬشىەأهڲەأ=أتەأوذوزأ﷽أ$أۄوأإځأ﷽أڬەأتًشأإځأ﷽أڬۏأمًوأڬەأذهۏلأۄۏڽأ؏أۄوتشەأڬډہأؽهتوأإځأ﷽أڬۏأدوتؼحأوۏڽأطشڬحأترحۏتشأڬشأډڬەأۄۏڽأدثڬۄأتىأڬًأتضهتوأوۏڽأڬًةۏأزهډضځۏأىۄۏڽأۄەأ؏أًۄأهًڲأوذعأڬتوأضەأثہتڲحەأۄۏڽأ؏أتضأهۏەأتىأڬًأۄوتشۏأغشلأهًټتأزۏدةەأۗأإځأ﷽أىەأتضأضهضهۄأوۏڽأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأضەأوطًشۄأڬۏتأحًأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأىەأڬۄتأ=أۏتأشضًهأتههۄأ$أۏۄأهًڲأضډأڬۄۄأشۄەأۄۏڽأۗأځہشأإځأ﷽أىەأذعشحأؼوشأشعۏأتههۄأؼىۄأضەأځًډہتأ=أإځأ﷽أڬتأڬۏتأرۏتهأۄەأآأتىۄًڽأىەأثہۏأذعشحأتثًثڬشأظزۏمأشعۏأتههۄأؼىۄأڬەأوًملأڬۏأحتةۏزأڬۏأۗأځہشأشضًهأتههۄأ﷽أىەألشوتۏتأ=أتەأمشطۏًأ$أوۏڽأحوأځشأتۏڬأتۏضتأطرظأىڲشتىأومششأڬشًڽأڲتأ؏أتههۄأىەأدضأڬتأزهأتۏوتىأڬەأهۏەأإصوتأهۏتأۄەأۗأًۄأزۏىأڬەأوؼتوهەأوۏڽأحوۄتشۏأڲشزىۏڽأوتشەأڲتأۗأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأثًهەأ=أۏتأشضًهأتههۄأ$أڬۏتأًۄأطرظأ““أوۏڽأ‛‛أۄًڽأآأإځأ﷽أىەألشوتۏتأ=أىۄۏڽأۗأځہشأذعشحأؼوشأشعۏأتههۄأؼىۄأثًهەأ=أۏتأشضًهأتههۄأڬۏتأًۄأطرظأوۏڽأۄًڽأآأإځأ﷽أىەألشوتۏتأ=أىۄۏڽأۗأثهڬۄأًۄأوضدزأوۏڽأدًحەأضهتةۏأڬشىۏًتهتأطرظأۄەأۗأىثۏأتڬشوأ﷽أتځىەأىؼهۏىأذلتػحأڬەأهۏەأذعشحأؼهۏأشعۏأتههۄأؼىۄأڬًأزەأزۏتأڬشحەأحہەأۗأځہشأذعشحأؼهۏأىەأشضًهأتههۄأ﷽أڬتأۏۄأتشطتزأضىتۏتأ=أؼهۏأڬًأوحأدہټهتاأڬۏًىڬۄأدًأطرظأؼهۏأڬًأدہټهتةەأًۄأدۄىوۏأۄەأۗأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتضەأظذۏذۏىأوۏڽأىمهأىۄۏڽأڬۏتأڲۏتأۗ%أ",""
"2615","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأؽصًۄٗأرۏثشأڬەأوًمؼأځشأشضًهأتڬشوأ﷽أىەأزًأضًأڲہڔأضًتشًڽأوۏڽأزًأ؏أزًأضہتوأحمضۏوأڬۏەأۗأ"
"أۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأىەأتضەأتىأتهلتػأڬەأۄوشتۄأىمهأىۄۏڽأڬۏتأدثڬۄأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأىەأۏذۏۏأثىأتۏًثأتًشأڬخۏشأتهورصًۏأڬۏأشًتۏتحأىمهأڬۏأۄۏڽأۗ%أ",""
"2616","%أذعشحأتثًؼتوشأتطؼشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أثۄحشۏىأمثۏهۄأثىۏأتضزأتًشأتطؼشۏأۄۏڽأ؏أىۄأۏۄأدىڲأضەأثہتڲحەأۄۏڽأىۄأتهڲأۄًحەأۄۏڽأ؏أۏۄأودہأضەأۄۏڽأتًشأوۏڽأتىأضەأۄًڽأۗأؼتوشألشوتحەأۄۏڽأ=أوۏڽأىەأۏۄۏأذزۏخأوؼتًۏۄأضەأسڬشأڬۏأحًأتىۄًڽأىەأڬۄتأ=أۏًڽأىۄۏڽأۗأثهڬۄأشضًهأتڬشوأ﷽أىەألشوتۏتأ=““أ®ہْوٕأوٓىٓٔۏٕأًّتٓهّۏّٔ¾أ‛‛أوۏڽأثًهتأ=أوۏشەأًتهزأىەأتۏضەأشًتۏحأثۏتىأىۄۏڽأڬۏأثهڬۄأتىأڬتأڬۄىتأحًأۏۄأۄەأڬۄأشضًهأتههۄأ﷽أىەأ““أ®ہْوٕأوٓىٓٔۏٕأًّتّىّٔتأوٓىٕہْو¾أ‛‛ألشوتۏتأۄەأۗأذعشحأوؼتًۏۄأشعۏأتههۄأؼىۄأثًهەأ=أټہۏڬأۄەأ؏أوۏشۏأثۄأىضثحأتځىەأًتهزأڬۏأشًتۏتحأڬًأحوأصۏتزۄأثۄحشأدتىحەأۄًأۗأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2617","%أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتأڬتألشوتىأۄەأ=أشضًهأتههۄأ﷽أ+أڬۏأۏۄأؼتزحأحہۏأڬۄأ"
