hadiths[count]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"35071","(۳۵۰۷۱) ابْنُ سِیرِینَ : أَبُو بَکْرٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 35071","","","كتاب التاريخ"
