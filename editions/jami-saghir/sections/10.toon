hadiths[115]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3450","«رأى عيسى ابن مريم رجلا يسرق فقال له: أسرقت؟ قال: كلا والذي لا إله إلا هو فقال عيسى: آمنت بالله وكذبت عيني»","صحيح","Sahih al-Jami al-Saghir 3450","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3451","«رأت أمي كأنه خرج منها نور أضاءت منه قصور الشام»","صحيح","Sahih al-Jami al-Saghir 3451","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3452","«رأس الكفر نحو المشرق والفخر والخيلاء في أهل الخيل والإبل والفدادين أهل الوبر والسكينة في أهل الغنم»","صحيح","Sahih al-Jami al-Saghir 3452","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3453","«رأس الكفر هاهنا من حيث يطلع قرن الشيطان» - يعني المشرق -","صحيح","Sahih al-Jami al-Saghir 3453","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3454","«راصوا الصفوف فإن الشيطان يقوم في الخلل»","صحيح","Sahih al-Jami al-Saghir 3454","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3455","«راصوا صفوفكم وقاربوا بينها وحاذوا بالأعناق»","صحيح","Sahih al-Jami al-Saghir 3455","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3456","رؤيا المؤمن جزء من أربعين جزءا من النبوة وهي على رجل طائر ما لم يحدث بها فإذا تحدث بها سقطت ولا تحدث بها إلا لبيبا أو حبيبا","صحيح","Sahih al-Jami al-Saghir 3456","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3457","«رؤيا المؤمن جزء من ستة وأربعين جزءا من النبوة»","صحيح","Sahih al-Jami al-Saghir 3457","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3458","«رؤيا المؤمن جزء من ستة وأربعين جزءا من النبوة وهي على رجل طائر ما لم يحدث بها وإذا حدث بها وقعت»","صحيح","Sahih al-Jami al-Saghir 3458","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3459","«رؤيا المسلم الصالح جزء من سبعين جزءا من النبوة»","صحيح","Sahih al-Jami al-Saghir 3459","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3460","[رأيت إبراهيم ليلة أسري بي فقال: يا محمد أقرئ أمتك السلام وأخبرهم أن الجنة طيبة التربة عذبة الماء وأنها قيعان وغراسها: سبحان الله والحمد لله ولا إله إلا الله والله أكبر ولا حول ولا قوة إلا بالله]","حسن","Sahih al-Jami al-Saghir 3460","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3461","«رأيت الذي صنعتم فلم يمنعني من الخروج إليكم إلا أني خشيت أن تفرض عليكم»","صحيح","Sahih al-Jami al-Saghir 3461","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3462","رأيت الليلة رجلين أتياني فأخذا بيدي فأخرجاني إلى الأرض المقدسة فإذا رجل جالس ورجل قائم على رأسه بيده كلوب من حديد فيدخله في شدقه فيشقه حتى يخرجه من قفاه ثم يخرجه فيدخله في شدقه الآخر ويلتئم هذا الشدق فهو يفعل ذلك به فقلت: ما هذا؟ قالا: انطلق; فانطلقت معهما فإذا رجل مستلق على قفاه ورجل قائم بيده فهر أو صخرة فيشدخ بها رأسه فيتدهده الحجر فإذا ذهب ليأخذه عاد رأسه كما كان فيصنع مثل ذلك فقلت: ما هذا؟ قالا: انطلق; فانطلقت معهما فإذا بيت مبني على بناء التنور أعلاه ضيق وأسفله واسع يوقد تحته نار فيه رجال ونساء عراة فإذا أوقدت ارتفعوا حتى يكادوا أن يخرجوا فإذا أخمدت رجعوا فيها فقلت: ما هذا؟ قالا: انطلق; فانطلقت فإذا نهر من دم فيه رجل وعلى شاطئ النهر رجل بين يديه حجارة فيقبل الرجل الذي في النهر فإذا دنا ليخرج رمى في فيه حجرا فرجع إلى مكانه فهو يفعل ذلك به فقلت: ما هذا؟ قالا: انطلق; فانطلقت فإذا روضة خضراء وإذا فيها شجرة عظيمة وإذا شيخ في أصلها حوله صبيان وإذا رجل قريب منه بين يديه نار فهو يحشها ويوقدها فصعدا بي في شجرة فأدخلاني دارا لم أر دارا قط أحسن منها فإذا فيها رجال شيوخ وشباب وفيها نساء وصبيان فأخرجاني منها فصعدا بي في الشجرة فأدخلاني دارا هي أحسن وأفضل فيها شيوخ وشباب فقلت لهما: إنكما قد طوفتماني منذ الليلة فأخبراني عما رأيت قالا: نعم; أما الرجل الأول الذي رأيت فإنه رجل كذاب يكذب الكذبة فتحمل عنه في الآفاق فهو يصنع به ما رأيت إلى يوم القيامة ثم يصنع الله تعالى به ما شاء; وأما الرجل الذي رأيت مستلقيا على قفاه فرجل آتاه الله القرآن فنام عنه بالليل ولم يعمل بما فيه بالنهار فهو يفعل به ما رأيت إلى يوم القيامة; وأما الذي رأيت في التنور فهم الزناة; وأما الذي رأيت في النهر فذاك آكل الربا; وأما الشيخ الذي رأيت في أصل الشجرة فذاك إبراهيم عليه السلام; وأما الصبيان الذين رأيت فأولاد الناس; وأما الرجل الذي رأيت يوقد النار فذلك خازن النار وتلك النار; وأما الدار التي دخلت أولا فدار عامة المؤمنين; وأما الدار الأخرى فدار الشهداء; وأنا جبريل وهذا ميكائيل; ثم قالا لي: ارفع رأسك فرفعت فإذا كهيئة السحاب فقالا لي: وتلك دارك فقلت لهما: دعاني أدخل داري فقالا: إنه قد بقي لك عمر لم تستكمله فلو استكملته دخلت دارك","صحيح","Sahih al-Jami al-Saghir 3462","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3463","«رأيت الملائكة تغسل حمزة بن عبد المطلب وحنظلة بن الراهب»","حسن","Sahih al-Jami al-Saghir 3463","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3464","«رأيت جبريل له ستمائة جناح»","صحيح","Sahih al-Jami al-Saghir 3464","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3465","«رأيت جعفر بن أبي طالب ملكا يطير في الجنة مع الملائكة بجناحين»","صحيح","Sahih al-Jami al-Saghir 3465","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3466","«رأيت ربي عز وجل»","صحيح","Sahih al-Jami al-Saghir 3466","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3467","«رأيت شابا وشابة فلم آمن من الشيطان عليهما»","صحيح","Sahih al-Jami al-Saghir 3467","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3468","«رأيت شياطين الإنس والجن فروا من عمر»","حسن","Sahih al-Jami al-Saghir 3468","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3469","«رأيت عمرو بن عامر الخزاعي يجر قصبه في النار وكان أول من سيب السوائب وبحر البحيرة»","صحيح","Sahih al-Jami al-Saghir 3469","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3470","«رأيت عمرو بن لحي بن قمعة بن خندف أخا بني كعب وهو يجر قصبه في النار»","صحيح","Sahih al-Jami al-Saghir 3470","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3471","«رأيت عيسى وموسى وإبراهيم فأما عيسى فأحمر جعد عريض الصدر وأما موسى فآدم جسيم سبط كأنه من رجال الزط وأما إبراهيم فانظروا إلى صاحبكم» - يعني نفسه -","صحيح","Sahih al-Jami al-Saghir 3471","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3472","«رأيت في المنام أني أهاجر من مكة إلى أرض بها نخل فذهب وهلي إلى أنها اليمامة أو هجر فإذا هي المدينة يثرب ورأيت في رؤياي هذه أني هززت سيفا فانقطع صدره فإذا هو ما أصيب من المؤمنين يوم أحد ثم هززته أخرى فعاد أحسن ما كان فإذا هو ما جاء الله به من الفتح واجتماع المؤمنين ورأيت فيها بقرا والله خير فإذا هم النفر من المؤمنين يوم أحد وإذا الخير ما جاء الله به من الخير بعد وثواب الصدق الذي آتانا الله بعد يوم بدر»","صحيح","Sahih al-Jami al-Saghir 3472","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3473","«رأيت قوما ممن يركب ظهر هذا البحر كالملوك على الأسرة»","صحيح","Sahih al-Jami al-Saghir 3473","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3474","«رأيت كأن امرأة سوداء ثائرة الرأس خرجت من المدينة حتى نزلت مهيعة فأولتها أن وباء المدينة نقل إليها»","صحيح","Sahih al-Jami al-Saghir 3474","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3475","«رأيت كأني الليلة في دار عقبة بن رافع وأتيت بتمر من تمر ابن طاب فأولت أن لنا الرفعة في الدنيا والعاقبة في الآخرة وأن ديننا قد طاب»","صحيح","Sahih al-Jami al-Saghir 3475","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3476","«رأيت كأني في درع حصينة ورأيت بقرا تنحر فأولت أن الدرع الحصينة المدينة وأن البقر نفر والله خير»","صحيح","Sahih al-Jami al-Saghir 3476","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3477","«رأيت ليلة أسري بي موسى رجلا آدم طوالا جعدا كأنه من رجال شنوءة ورأيت عيسى رجلا مربوع الخلق إلى الحمرة والبياض سبط الرأس ورأيت مالكا خازن النار والدجال»","صحيح","Sahih al-Jami al-Saghir 3477","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3478","رأيتني دخلت الجنة فإذا أنا بالرميصاء امرأة أبي طلحة وسمعت خشفا من أمامي فقلت: من هذا يا جبريل؟ قال: هذا بلال ورأيت قصرا أبيض بفنائه جارية فقلت: لمن هذا القصر؟ قالوا: لعمر بن الخطاب فأردت أن أدخله فأنظر إليه فذكرت غيرتك","صحيح","Sahih al-Jami al-Saghir 3478","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3479","«رباط شهر خير من صيام دهر ومن مات مرابطا في سبيل الله أمن من الفزع الأكبر وغدي عليه برزقه وريح من الجنة ويجرى عليه أجر المرابط حتى يبعثه الله»","صحيح","Sahih al-Jami al-Saghir 3479","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3480","«رباط يوم خير من صيام شهر وقيامه»","صحيح","Sahih al-Jami al-Saghir 3480","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3481","«رباط يوم في سبيل الله أفضل من صيام شهر وقيامه ومن مات فيه وقي فتنة القبر ونما له عمله إلى يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 3481","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3482","«رباط يوم في سبيل الله خير من الدنيا وما عليها وموضع سوط أحدكم من الجنة خير من الدنيا وما عليها والروحة يروحها العبد في سبيل الله أو الغدوة خير من الدنيا وما عليها»","صحيح","Sahih al-Jami al-Saghir 3482","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3483","«رباط يوم وليلة خير من صيام شهر وقيامه وإن مات مرابطا جرى عليه عمله الذي كان يعمله وأجري عليه رزقه وأمن من الفتان»","صحيح","Sahih al-Jami al-Saghir 3483","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3484","«رب أشعث مدفوع بالأبواب لو أقسم على الله لأبره»","صحيح","Sahih al-Jami al-Saghir 3484","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3485","«رب أعني ولا تعن علي وانصرني ولا تنصر علي وامكر لي ولا تمكر علي واهدني ويسر هداي إلي وانصرني على من بغى علي; اللهم اجعلني لك شاكرا لك ذاكرا لك راهبا لك مطواعا إليك مخبتا إليك أواها منيبا; رب تقبل توبتي واغسل حوبتي وأجب دعوتي وثبت حجتي واهد قلبي وسدد لساني واسلل سخيمة قلبي»","صحيح","Sahih al-Jami al-Saghir 3485","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3486","«رب اغفر لي وتب علي إنك أنت التواب الغفور»","صحيح","Sahih al-Jami al-Saghir 3486","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3487","«رب ذي طمرين لا يؤبه له لو أقسم على الله لأبره»","صحيح","Sahih al-Jami al-Saghir 3487","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3488","[رب صائم ليس له من صيامه إلا الجوع ورب قائم ليس له من قيامه إلا السهر]","صحيح","Sahih al-Jami al-Saghir 3488","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3489","«رب عذق مذلل لابن الدحداحة في الجنة»","صحيح","Sahih al-Jami al-Saghir 3489","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3490","«رب قائم حظه من قيامه السهر ورب صائم حظه من صيامه الجوع والعطش»","صحيح","Sahih al-Jami al-Saghir 3490","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3491","«رحم الله أخي يوسف لو أنا أتاني الرسول بعد طول الحبس لأسرعت الإجابة حين قال: {قَالَ ارْجِعْ إِلَى رَبِّكَ فاسْأَلْهُ مَا بَالُ النِّسْوَةِ} »","صحيح","Sahih al-Jami al-Saghir 3491","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3492","«رحم الله امرءا تكلم فغنم أو سكت فسلم»","حسن","Sahih al-Jami al-Saghir 3492","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3493","«رحم الله امرءا صلى قبل العصر أربعا»","حسن","Sahih al-Jami al-Saghir 3493","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3494","«رحم الله رجلا قام من الليل فصلى وأيقظ امرأته فصلت فإن أبت نضح في وجهها الماء ورحم الله امرأة قامت من الليل فصلت وأيقظت زوجها فصلى فإن أبى نضحت في وجهه الماء»","صحيح","Sahih al-Jami al-Saghir 3494","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3495","«رحم الله عبدا سمحا إذا باع سمحا إذا اشترى سمحا إذا قضى سمحا إذا اقتضى»","صحيح","Sahih al-Jami al-Saghir 3495","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3496","«رحم الله عبدا قال خيرا فغنم أو سكت عن سوء فسلم»","حسن","Sahih al-Jami al-Saghir 3496","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3497","«رحم الله عبدا قال فغنم أو سكت فسلم»","حسن","Sahih al-Jami al-Saghir 3497","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3498","رحم الله فلانا لقد أذكرني كذا وكذا آية كنت أسقطتها من سورة كذا وكذا","صحيح","Sahih al-Jami al-Saghir 3498","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3499","«رحم الله لوطا كان يأوي إلى ركن شديد وما بعث الله بعده نبيا إلا وهو في ثروة من قومه»","حسن","Sahih al-Jami al-Saghir 3499","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3500","«رحم الله موسى قد أوذي بأكثر من هذا فصبر»","صحيح","Sahih al-Jami al-Saghir 3500","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3501","«رحمة الله علينا وعلى موسى لو صبر لرأى من صاحبه العجب»","صحيح","Sahih al-Jami al-Saghir 3501","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3502","«ردوا السائل ولو بظلف محرق»","صحيح","Sahih al-Jami al-Saghir 3502","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3503","«ردوا القتلى إلى مضاجعها»","صحيح","Sahih al-Jami al-Saghir 3503","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3504","«رسول الرجل إلى الرجل إذنه»","صحيح","Sahih al-Jami al-Saghir 3504","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3505","«رصوا صفوفكم وقاربوا بينها وحاذوا بالأعناق فوالذي نفسي بيده إني لأرى الشياطين تدخل من خلل الصفوف كأنها الخذف»","صحيح","Sahih al-Jami al-Saghir 3505","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3506","«رضا الرب في رضا الوالد وسخط الرب في سخط الوالد»","صحيح","Sahih al-Jami al-Saghir 3506","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3507","«رضا الرب في رضا الوالدين وسخطه في سخطهما»","صحيح","Sahih al-Jami al-Saghir 3507","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3508","«رضاها صمتها» - يعني البكر -","صحيح","Sahih al-Jami al-Saghir 3508","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3509","«رضيت لأمتي ما رضي لها ابن أم عبد»","صحيح","Sahih al-Jami al-Saghir 3509","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3510","«رغم أنف رجل ذكرت عنده فلم يصل علي ورغم أنف رجل دخل عليه رمضان ثم انسلخ قبل أن يغفر له ورغم أنف رجل أدرك عنده أبواه الكبر فلم يدخلاه الجنة»","صحيح","Sahih al-Jami al-Saghir 3510","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3511","«رغم أنفه ثم رغم أنفه ثم رغم أنفه: من أدرك أبويه عنده الكبر أحدهما أو كلاهما ثم لم يدخل الجنة»","صحيح","Sahih al-Jami al-Saghir 3511","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3512","«رفع القلم عن ثلاثة: عن المجنون المغلوب على عقله حتى يبرأ وعن النائم حتى يستيقظ وعن الصبي حتى يحتلم»","صحيح","Sahih al-Jami al-Saghir 3512","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3513","«رفع القلم عن ثلاثة: عن النائم حتى يستيقظ وعن المبتلى حتى يبرأ وعن الصبي حتى يكبر»","صحيح","Sahih al-Jami al-Saghir 3513","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3514","«رفع القلم عن ثلاث: عن النائم حتى يستيقظ وعن الصبي حتى يشب وعن المعتوه حتى يعقل»","صحيح","Sahih al-Jami al-Saghir 3514","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3515","«رفع عن أمتي الخطأ والنسيان وما استكرهوا عليه»","صحيح","Sahih al-Jami al-Saghir 3515","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3516","«رفعت إلى سدرة المنتهى منتهاها في السماء السابعة نبقها مثل قلال هجر وورقها مثل آذان الفيلة فإذا أربعة أنهار نهران ظاهران ونهران باطنان فأما الظاهران: فالنيل والفرات وأما الباطنان: فنهران في الجنة وأتيت بثلاثة أقداح قدح فيه لبن وقدح فيه عسل وقدح فيه خمر فأخذت الذي فيه اللبن فشربت فقيل لي: أجبت الفطرة أنت وأمتك»","صحيح","Sahih al-Jami al-Saghir 3516","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3517","«ركعتا الفجر خير من الدنيا وما فيها»","صحيح","Sahih al-Jami al-Saghir 3517","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3518","«ركعتان خفيفتان بما تحقرون ونفلون يزيدهما هذا في عمله أحب إليه من بقية دنياكم»","صحيح","Sahih al-Jami al-Saghir 3518","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3519","«رمضان شهر مبارك تفتح فيه أبواب الجنة وتغلق فيه أبواب السعير وتصفد فيه الشياطين وينادي مناد كل ليلة: يا باغي الخير هلم ويا باغي الشر أقصر»","صحيح","Sahih al-Jami al-Saghir 3519","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3520","«رميا بني إسماعيل فإن أباكم كان راميا»","صحيح","Sahih al-Jami al-Saghir 3520","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3521","«رواح الجمعة واجب على كل محتلم»","صحيح","Sahih al-Jami al-Saghir 3521","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3522","«الراحمون يرحمهم الرحمن تبارك وتعالى: ارحموا من في الأرض يرحمكم من في السماء»","صحيح","Sahih al-Jami al-Saghir 3522","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3523","«الراكب خلف الجنازة والماشي حيث شاء منها والطفل يصلى عليه»","صحيح","Sahih al-Jami al-Saghir 3523","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3524","«الراكب شيطان والراكبان شيطانان والثلاثة ركب»","صحيح","Sahih al-Jami al-Saghir 3524","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3525","«الراكب يسير خلف الجنازة والماشي يمشي خلفها وأمامها وعن يمينها وعن يسارها قريبا منها والسقط يصلى عليه ويدعى لوالديه بالمغفرة والرحمة»","صحيح","Sahih al-Jami al-Saghir 3525","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3526","«الرؤيا الحسنة من الرجل الصالح جزء من ستة وأربعين جزءا من النبوة»","صحيح","Sahih al-Jami al-Saghir 3526","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3527","«الرؤيا الحسنة هي البشرى يراها المؤمن أو ترى له»","صحيح","Sahih al-Jami al-Saghir 3527","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3528","«الرؤيا الصالحة جزء من خمسة وعشرين جزءا من النبوة»","صحيح","Sahih al-Jami al-Saghir 3528","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3529","«الرؤيا الصالحة جزء من سبعين جزءا من النبوة»","صحيح","Sahih al-Jami al-Saghir 3529","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3530","«الرؤيا الصالحة جزء من ستة وأربعين جزءا من النبوة»","صحيح","Sahih al-Jami al-Saghir 3530","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3531","«الرؤيا الصالحة من الله والحلم من الشيطان فإذا رأى أحدكم شيئا يكرهه فلينفث حين يستيقظ عن يساره ثلاثا وليتعوذ بالله من شرها فإنها لا تضره»","صحيح","Sahih al-Jami al-Saghir 3531","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3532","«الرؤيا الصالحة من الله والرؤيا السوء من الشيطان فمن رأى رؤيا فكره منها شيئا فلينفث عن يساره وليتعوذ بالله من الشيطان فإنها لا تضره ولا يخبر بها أحدا فإن رأى رؤيا حسنة فليبشر ولا يخبر بها إلا من يحب»","صحيح","Sahih al-Jami al-Saghir 3532","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3533","الرؤيا ثلاثة فبشرى من الله وحديث النفس وتخويف من الشيطان فإذا رأى أحدكم رؤيا تعجبه فليقصها إن شاء على أحد وإن رأى شيئا يكرهه فلا يقصه على أحد وليقم يصلي وأكره الغل وأحب القيد, القيد ثبات في الدين","صحيح","Sahih al-Jami al-Saghir 3533","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3534","«الرؤيا ثلاثة: منها تهاويل من الشيطان ليحزن ابن آدم ومنها ما يهم به الرجل في يقظته فيراه في منامه ومنها جزء من ستة وأربعين جزءا من النبوة»","صحيح","Sahih al-Jami al-Saghir 3534","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3535","«الرؤيا على رجل طائر ما لم تعبر فإذا عبرت وقعت ولا تقصها إلا على واد أو ذي رأى»","صحيح","Sahih al-Jami al-Saghir 3535","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3536","«الرؤيا من الله والحلم من الشيطان فإذا رأى أحدكم شيئا يكرهه فليبصق عن يساره ثلاثا وليستعذ بالله من الشيطان الرجيم ثلاثا وليتحول عن جنبه الذي كان عليه»","صحيح","Sahih al-Jami al-Saghir 3536","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3537","«الربا اثنان وسبعون بابا أدناها مثل إتيان الرجل أمه وإن أربى الربا استطالة الرجل في عرض أخيه»","صحيح","Sahih al-Jami al-Saghir 3537","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3538","«الربا ثلاثة وسبعون بابا»","صحيح","Sahih al-Jami al-Saghir 3538","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3539","«الربا ثلاثة وسبعون بابا أيسرها مثل أن ينكح الرجل أمه وإن أربى الربا عرض الرجل المسلم»","صحيح","Sahih al-Jami al-Saghir 3539","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3540","«الربا سبعون بابا والشرك مثل ذلك»","صحيح","Sahih al-Jami al-Saghir 3540","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3541","«الربا سبعون حوبا أيسرها أن ينكح الرجل أمه»","صحيح","Sahih al-Jami al-Saghir 3541","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3542","«الربا وإن كثر فإن عاقبته تصير إلى قل»","صحيح","Sahih al-Jami al-Saghir 3542","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3543","«الرجل أحق بصدر دابته وأحق بمجلسه إذا رجع»","حسن","Sahih al-Jami al-Saghir 3543","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3544","«الرجل أحق بمجلسه وإن خرج لحاجته ثم عاد فهو أحق بمجلسه»","صحيح","Sahih al-Jami al-Saghir 3544","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3545","«الرجل على دين خليله فلينظر أحدكم من يخالل»","حسن","Sahih al-Jami al-Saghir 3545","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3546","«الرجم كفارة ما صنعت»","صحيح","Sahih al-Jami al-Saghir 3546","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3547","«الرحم شجنة معلقة بالعرش»","صحيح","Sahih al-Jami al-Saghir 3547","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3548","«الرحم شجنة من الرحمن قال الله: من وصلك وصلته ومن قطعك قطعته»","صحيح","Sahih al-Jami al-Saghir 3548","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3549","«الرحم معلقة بالعرش تقول: من وصلني وصله الله ومن قطعني قطعه الله»","صحيح","Sahih al-Jami al-Saghir 3549","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3550","«الرحمة عند الله مائة جزء فقسم بين الخلائق جزءا وأخر تسعا وتسعين إلى يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 3550","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3551","«الرزق أشد طلبا للعبد من أجله»","حسن","Sahih al-Jami al-Saghir 3551","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3552","«الرضاع يحرم ما تحرم الولادة»","صحيح","Sahih al-Jami al-Saghir 3552","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3553","«الرعد ملك من ملائكة الله موكل بالسحاب معه مخاريق من نار يسوق بها السحاب حيث شاء الله»","حسن","Sahih al-Jami al-Saghir 3553","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3554","«الرقبى جائزة»","صحيح","Sahih al-Jami al-Saghir 3554","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3555","«الرقوب التي لا يموت لها ولد»","صحيح","Sahih al-Jami al-Saghir 3555","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3556","«الرقوب الذي لا فرط له»","صحيح","Sahih al-Jami al-Saghir 3556","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3557","«الرقوب كل الرقوب الذي له ولد فمات ولم يقدم منهم شيئا»","صحيح","Sahih al-Jami al-Saghir 3557","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3558","«الركب الذي معهم الجلجل لا تصحبهم الملائكة»","صحيح","Sahih al-Jami al-Saghir 3558","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3559","«الركن والمقام ياقوتتان من يواقيت الجنة»","صحيح","Sahih al-Jami al-Saghir 3559","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3560","«الروحة والغدوة في سبيل الله أفضل من الدنيا وما فيها»","صحيح","Sahih al-Jami al-Saghir 3560","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3561","«الرهن مركوب ومحلوب»","صحيح","Sahih al-Jami al-Saghir 3561","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3562","«الرهن يركب بنفقته ويشرب لبن الدر إذا كان مرهونا»","صحيح","Sahih al-Jami al-Saghir 3562","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3563","«الريح تبعث عذابا لقوم ورحمة لآخرين»","صحيح","Sahih al-Jami al-Saghir 3563","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
"3564","«الريح من روح الله تأتي بالرحمة وتأتي بالعذاب فإذا رأيتموها فلا تسبوها واسألوا الله خيرها واستعيذوا بالله من شرها»","صحيح","Sahih al-Jami al-Saghir 3564","","","الأحاديث المبدوءة بحرف الراء Hadith Beginning with the Letter Ra (ر)"
