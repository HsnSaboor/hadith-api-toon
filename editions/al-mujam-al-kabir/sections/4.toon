hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"1801","1803  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  حَمَّادُ بْنُ خَالِدٍ ،  عَنِ  ابْنِ أَبِي ذِئْبٍ ،  عَنِ  الْمُهَاجِرِ بْنِ مِسْمَارٍ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ، قَالَ :  سَأَلْتُ  جَابِرَ بْنَ سَمُرَةَ ، عَنْ حَدِيثِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا أَعْطَى اللهُ أَحَدَكُمْ خَيْرًا فَلْيَبْدَأْ بِنَفْسِهِ وَأَهْلِهِ  .","","Al-Mu'jam al-Kabir 1803","","جابر بن سمرة السوائي عن عامر بن سعد بن أبي وقاص عن مهاجر بن مسمار الزهري عن محمد بن عبد الرحمن بن المغيرة عن حماد بن خالد الخياط عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عامر بن سعد بن أبي وقاص عن جابر بن سمرة"
"1802","1804  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  إِسْحَاقُ بْنُ إِسْمَاعِيلَ الطَّالْقَانِيُّ ، قَالَا :  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنِ  الْمُهَاجِرِ بْنِ مِسْمَارٍ ،  عَنْ  عَامِرِ بْنِ سَعْدِ بْنِ أَبِي وَقَّاصٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، عَشِيَّةَ جُمُعَةِ رَجْمِ  مَاعِزًا الْأَسْلَمِيَّ  يَقُولُ :  عُصْبَةٌ مِنَ الْمُسْلِمِينَ يَفْتَحُونَ الْبَيْتَ الْأَبْيَضَ  ، قُلْتُ :  كِسْرَى  ؟ قَالَ : ""  كِسْرَى  .","","Al-Mu'jam al-Kabir 1804","","جابر بن سمرة السوائي عن عامر بن سعد بن أبي وقاص عن مهاجر بن مسمار الزهري عن حاتم بن إسماعيل الحارثي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عامر بن سعد بن أبي وقاص عن جابر بن سمرة"
"1803","1805  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  حَمَّادُ بْنُ خَالِدٍ ،  ثَنَا  ابْنِ أَبِي ذِئْبٍ ،  عَنِ  الْمُهَاجِرِ بْنِ مِسْمَارِ  عَنْ  عَامِرِ بْنِ سَعْدٍ  عَنْ  جَابِرٍ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  تَسْتَخْرِجُونَ كَنْزَ الْأَبْيَضِ ،  كِسْرَى  وَآلِ كِسْرَى  .","","Al-Mu'jam al-Kabir 1805","","جابر بن سمرة السوائي عن عامر بن سعد بن أبي وقاص عن مهاجر بن مسمار الزهري عن محمد بن عبد الرحمن بن المغيرة عن حماد بن خالد الخياط عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عامر بن سعد بن أبي وقاص عن جابر بن سمرة"
"1804","1806  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  إِسْحَاقُ بْنُ إِسْمَاعِيلَ الطَّالْقَانِيُّ ، قَالَا :  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ الطَّالْقَانِيُّ ،  عَنِ  الْمُهَاجِرِ بْنِ مِسْمَارٍ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ         [2/199]      جَابِرِ بْنِ سَمُرَةَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  أَنَا  الْفَرَطُ  عَلَى الْحَوْضِ  .","","Al-Mu'jam al-Kabir 1806","","جابر بن سمرة السوائي عن عامر بن سعد بن أبي وقاص عن مهاجر بن مسمار الزهري عن حاتم بن إسماعيل الحارثي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عامر بن سعد بن أبي وقاص عن جابر بن سمرة"
"1805","1807  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  حَمَّادُ بْنُ خَالِدٍ ،  عَنِ  ابْنِ أَبِي ذِئْبٍ ،  عَنِ  الْمُهَاجِرِ ،  عَنْ  عَامِرٍ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَنَا  فَرَطُكُمْ  عَلَى الْحَوْضِ  .","","Al-Mu'jam al-Kabir 1807","","جابر بن سمرة السوائي عن عامر بن سعد بن أبي وقاص عن مهاجر بن مسمار الزهري عن محمد بن عبد الرحمن بن المغيرة عن حماد بن خالد الخياط عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عامر بن سعد بن أبي وقاص عن جابر بن سمرة"
"1806","1808  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  أَبِي  ، ثَنَا  حَمَّادُ بْنُ خَالِدٍ ،  عَنِ  ابْنِ أَبِي ذِئْبٍ ،  عَنِ  الْمُهَاجِرِ بْنِ مِسْمَارٍ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَزَالُ الدِّينُ قَائِمًا حَتَّى يَكُونَ اثْنَا عَشَرَ  خَلِيفَةً  مِنْ  قُرَيْشٍ  ، ثُمَّ يَخْرُجُ كَذَّابُونَ بَيْنَ يَدَيِ السَّاعَةِ  .","","Al-Mu'jam al-Kabir 1808","","جابر بن سمرة السوائي عن عامر بن سعد بن أبي وقاص عن مهاجر بن مسمار الزهري عن محمد بن عبد الرحمن بن المغيرة عن حماد بن خالد الخياط عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عامر بن سعد بن أبي وقاص عن جابر بن سمرة"
"1807","1809  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنِ  الْمُهَاجِرِ ،  عَنْ  عَامِرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا يَزَالُ الدِّينُ قَائِمًا حَتَّى تَقُومَ السَّاعَةُ  ، أَوْ يَكُونَ اثْنَا عَشَرَ  خَلِيفَةً  كُلُّهُمْ مِنْ  قُرَيْشٍ  .","","Al-Mu'jam al-Kabir 1809","","جابر بن سمرة السوائي عن عامر بن سعد بن أبي وقاص عن مهاجر بن مسمار الزهري عن حاتم بن إسماعيل الحارثي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عامر بن سعد بن أبي وقاص عن جابر بن سمرة"
"1808","بَابٌ  تَمِيمُ بْنُ طَرَفَةَ الطَّائِيُّ  عَنْ  جَابِرِ بْنِ سَمُرَةَ  1810  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمٍ الطَّائِيِّ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلَا تَصُفُّونَ خَلْفِي كَمَا تَصُفُّ الْمَلَائِكَةُ عِنْدَ رَبِّهِمْ  ؟ "" قَالُوا : وَكَيْفَ تَصُفُّ الْمَلَائِكَةُ عِنْدَ رَبِّهِمْ ؟ قَالَ : "" يُتِمُّونَ الصُّفُوفَ الْمُقَدَّمَةَ وَيَتَرَاصُّونَ فِي الصَّفِّ  .","","Al-Mu'jam al-Kabir 1810","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب تميم بن طرفة الطائي عن جابر بن سمرة"
"1809","1811  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو  ثَنَا  زَائِدَةُ  عَنِ  الْأَعْمَشِ  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ  عَنْ  تَمِيمِ بْنِ طَرَفَةَ  عَنْ  جَابِرِ بْنِ سَمُرَةَ         [2/200]      قَالَ :  دَخَلَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  أَلَا تَصُفُّونَ كَمَا تَصُفُّ الْمَلَائِكَةُ عِنْدَ رَبِّهِمْ  ؟ "" فَقَالُوا : يَا رَسُولَ اللهِ وَكَيْفَ تَصُفُّ الْمَلَائِكَةُ عِنْدَ رَبِّهِمْ ؟ قَالَ : "" يُتِمُّونَ الصُّفُوفَ الْمُقَدَّمَةَ وَيَتَرَاصُّونَ فِي الصَّفِّ  .","","Al-Mu'jam al-Kabir 1811","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب تميم بن طرفة الطائي عن جابر بن سمرة"
"1810","1812  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ، ثَنَا  زُهَيْرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ الطَّائِيِّ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلَا تَصُفُّونَ كَمَا تَصُفُّ الْمَلَائِكَةُ عِنْدَ رَبِّهِمْ  ؟ "" قَالُوا : يَا رَسُولَ اللهِ وَكَيْفَ تَصُفُّ الْمَلَائِكَةُ عِنْدَ رَبِّهِمْ ؟ قَالَ : "" يُتِمُّونَ الصُّفُوفَ الْمُقَدَّمَةَ وَيَتَرَاصُّونَ فِي الصَّفِّ  .","","Al-Mu'jam al-Kabir 1812","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن الأعمش عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","باب تميم بن طرفة الطائي عن جابر بن سمرة"
"1811","1813  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلَا تَصُفُّونَ كَمَا تَصُفُّ الْمَلَائِكَةُ الَّذِينَ عِنْدَ رَبِّهِمْ  ؟ "" قَالُوا : وَكَيْفَ تَصُفُّ الْمَلَائِكَةُ الَّذِينَ عِنْدَ رَبِّهِمْ ؟ قَالَ : "" يُقِيمُونَ الصُّفُوفَ الْأُولَى وَيَتَرَصُّونَ فِي الصَّفِّ  .","","Al-Mu'jam al-Kabir 1813","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","باب تميم بن طرفة الطائي عن جابر بن سمرة"
"1812","1814  -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ الْحُسَيْنِ بْنِ رَاشِدٍ السُّلَمِيُّ النَّيْسَابُورِيُّ  ، ثَنَا  أَحْمَدُ بْنُ حَفْصٍ ،  حَدَّثَنِي  أَبِي  ، ثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  عُمَرَ بْنِ سَعِيدٍ ،  عَنْ  سُلَيْمَانَ الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلَا تَصُفُّونَ كَمَا تَصُفُّ الْمَلَائِكَةُ عِنْدَ رَبِّهِمْ  ؟ "" قَالُوا : يَا رَسُولَ اللهِ وَكَيْفَ تَصُفُّ الْمَلَائِكَةُ عِنْدَ رَبِّهِمْ ؟ قَالَ : "" يُتِمُّونَ الصَّفَّ الْمُقَدَّمَ وَيَتَرَاصُّونَ فِي الصَّفِّ  .","","Al-Mu'jam al-Kabir 1814","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن عمر بن سعيد بن مسروق عن إبراهيم بن طهمان عن حفص بن عبد الله بن راشد النيسابوري عن أحمد بن حفص بن عبد الله النيسابوري عن عبد الله بن الحسين النيسابوري عن الطبراني","باب تميم بن طرفة الطائي عن جابر بن سمرة"
"1813","1815  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 1815","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن أبو معاوية الضرير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","باب تميم بن طرفة الطائي عن جابر بن سمرة"
"1814","1816  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  ابْنُ فُضَيْلٍ وَالْمُحَارِبِيُّ ،  عَنْ  أَشْعَثَ ، (  ح  )  وَحَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  وَاصِلُ بْنُ عَبْدِ الْأَعْلَى ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،         [2/201]      عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنْ  عَلِيِّ بْنِ مُدْرِكٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  صَلَّيْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَوْمَأَ إِلَيْنَا أَنِ اجْلِسُوا فَجَلَسْنَا ، فَقَالَ :  مَا يَمْنَعُكُمْ أَنْ تَصُفُّوا كَمَا تَصُفُّ الْمَلَائِكَةُ عِنْدَ الرَّحْمَنِ  ؟ "" قَالُوا : وَكَيْفَ يَصُفُّونَ يَا رَسُولَ اللهِ ؟ قَالَ : "" يُتِمُّونَ الصُّفُوفَ الْأُولَى  وَيَرْصُفُونَ فِي الصُّفُوفِ رَصْفًا أَوْ يَرُصُّوهَا رَصًّا  .","","Al-Mu'jam al-Kabir 1816","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن علي بن مدرك الوهبيلي عن أشعث بن سوار عن محمد بن فضيل بن غزوان عن واصل بن عبد الأعلى الأسدي عن عبد الله بن أحمد الجواليقي عن الطبراني","باب تميم بن طرفة الطائي عن جابر بن سمرة"
"1815","بَابٌ  1817  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ، (  ح  )  وَحَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ، قَالَا :  حَدَّثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَيَنْتَهِيَنَّ أَقْوَامٌ يَرْفَعُونَ أَبْصَارَهُمْ فِي الصَّلَاةِ إِلَى السَّمَاءِ  أَوْ لَا تَرْجِعُ إِلَيْهِمْ  .","","Al-Mu'jam al-Kabir 1817","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"1816","1818  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ، ثَنَا  زُهَيْرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  دَخَلَ عَلَيْهِمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُمْ رَافِعُونَ أَبْصَارَهُمْ ، فَقَالَ :  لَيَنْتَهِيَنَّ أَقْوَامٌ عَنْ رَفْعِهِمْ أَبْصَارَهُمْ إِلَى السَّمَاءِ فِي الصَّلَاةِ  أَوْ لَا تَرْجِعُ إِلَيْهِمْ  .","","Al-Mu'jam al-Kabir 1818","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","باب"
"1817","1819  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، حَدَّثَنَا  مُسَدَّدٌ ، قَالَا :  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرٍ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيَنْتَهِيَنَّ أَقْوَامٌ يَرْفَعُونَ أَبْصَارَهُمْ إِلَى السَّمَاءِ فِي الصَّلَاةِ  أَوْ لَا تَرْجِعُ إِلَيْهِمْ  .","","Al-Mu'jam al-Kabir 1819","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن أبو معاوية الضرير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","باب"
"1818","1820  -  حَدَّثَنَا  سَلَمَةُ بْنُ أَحْمَدَ الْفَوْزِيُّ الْحِمْصِيُّ ،  حَدَّثَنِي  جَدِّي لِأُمِّي خَطَّابُ بْنُ عُثْمَانَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  جَعْفَرِ بْنِ الْحَارِثِ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [2/202]      قَالَ :  لَيَنْتَهِيَنَّ أَقْوَامٌ يَرْفَعُونَ أَبْصَارَهُمْ إِلَى السَّمَاءِ  فِي الصَّلَاةِ أَوْ لَا تَرْجِعُ إِلَيْهِمْ  .","","Al-Mu'jam al-Kabir 1820","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن جعفر بن الحارث الواسطي عن إسماعيل بن عياش الأحول عن خطاب الفوزي عن سلمة بن أحمد الفوزي عن الطبراني","باب"
"1819","1821  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  عَبْثَرُ بْنُ الْقَاسِمِ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيَنْتَهِيَنَّ أَقْوَامٌ عَنْ رَفْعِهِمْ أَبْصَارَهُمْ فِي الصَّلَاةِ  أَوْ لَا تَرْجِعُ إِلَيْهِمْ  .","","Al-Mu'jam al-Kabir 1821","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن زيد بن وهب الجهني عن المسيب بن رافع الكاهلي عن الأعمش عن عبثر بن القاسم الزبيدي عن عبد الله بن عمر مشكدانة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"1820","1822  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ  ، ثَنَا  قَبِيصَةُ بْنُ عُقْبَةَ ،  ثَنَا  سُفْيَانُ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  دَخَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمَسْجِدَ فَرَآهُمْ رَافِعِي أَيْدِيهِمْ ، قَالَ :  مَا لَهُمْ رَافِعِي أَيْدِيهِمْ كَأَنَّهَا أَذْنَابُ خَيْلٍ  شُمْسٍ  ؟ اسْكُنُوا فِي الصَّلَاةِ  .","","Al-Mu'jam al-Kabir 1822","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن سفيان الثوري عن قبيصة بن عقبة السوائي عن حفص بن عمر سنجة ألف عن الطبراني","باب"
"1821","1823  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرٍ ، قَالَ :  جَاءَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابُهُ جُلُوسٌ ، فَقَالَ :  مَا لِي أَرَاكُمْ  عِزِينَ  ؟  قَالَ  سُفْيَانُ  :  يَعْنِي حِلَقٌ مُتَفَرِّقِينَ  .","","Al-Mu'jam al-Kabir 1823","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"1822","بَابٌ  1824  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ بْنِ سَوْرَةَ الْبَغْدَادِيُّ  ، ثَنَا  أَبُو الْوَلِيدِ ،  ثَنَا  شُعْبَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، رَأَى قَوْمًا قَدْ رَفَعُوا أَيْدِيَهُمْ فِي الصَّلَاةِ ، فَقَالَ :  قَدْ رَفَعُوا أَيْدِيَهُمْ كَأَنَّهَا أَذْنَابُ خَيْلٍ  شُمْسٍ  ،  اسْكُنُوا فِي الصَّلَاةِ  .","","Al-Mu'jam al-Kabir 1824","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن محمد بن يعقوب بن سورة البغدادي عن الطبراني","باب"
"1823","1825  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،         [2/203]      عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرٍ ، قَالَ :  دَخَلَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمَسْجِدَ فَرَآهُمْ رَافِعِي أَيْدِيهِمْ فِي الصَّلَاةِ ، فَقَالَ :  مَا لِي أَرَاهُمْ رَافِعِي أَيْدِيهِمْ كَأَنَّهَا أَذْنَابُ الْخَيْلِ الشُّمْسِ  ؟ اسْكُنُوا فِي الصَّلَاةِ  .","","Al-Mu'jam al-Kabir 1825","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب"
"1824","1826  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ، ثَنَا  زُهَيْرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَرَجَ عَلَيْهِمْ ،  أُرَاهُ قَالَ : فِي الْمَسْجِدِ  ، وَهُمْ رَافِعُو أَيْدِيهِمْ ، وَقَالَ :  مَا لِي أَرَاكُمْ رَافِعِي أَيْدِيكُمْ كَأَنَّهَا أَذْنَابُ خَيْلٍ  شُمْسٍ  ، اسْكُنُوا فِي الصَّلَاةِ  .","","Al-Mu'jam al-Kabir 1826","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","باب"
"1825","1827  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، حَدَّثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  ثَنَا  إِسْرَائِيلُ بْنُ يُونُسَ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  خَرَجَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَدَخَلَ الْمَسْجِدَ فَرَأَى النَّاسَ رَافِعِي أَيْدِيهِمْ ، فَقَالَ :  مَا لِي أَرَى النَّاسَ رَافِعِي أَيْدِيهِمْ كَأَنَّهَا أَذْنَابُ الْخَيْلِ الشُّمْسِ  ؟ اسْكُنُوا فِي الصَّلَاةِ  .","","Al-Mu'jam al-Kabir 1827","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"1826","1828  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، حَدَّثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَأَى قَوْمًا قَدْ رَفَعُوا أَيْدِيَهُمْ ، فَقَالَ :  كَأَنَّهَا أَذْنَابُ خَيْلٍ  شُمْسٍ  ، اسْكُنُوا فِي الصَّلَاةِ  .","","Al-Mu'jam al-Kabir 1828","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","باب"
"1827","1829  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  حَدَّثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : خَرَجَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 1829","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن أبو معاوية الضرير عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","باب"
"1828","1830  -  ثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  خَرَجَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى الْمَسْجِدِ فَرَآهُمْ حِلَقًا جُلُوسٌ ، فَقَالَ :  مَا لِي أَرَاكُمْ         [2/204]      عِزِينَ  .","","Al-Mu'jam al-Kabir 1830","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","باب"
"1829","1831  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، حَدَّثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  دَخَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمَسْجِدَ وَهُمْ جُلُوسٌ ، فَقَالَ :  مَا لِي أَرَاكُمْ  عِزِينَ  .","","Al-Mu'jam al-Kabir 1831","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","باب"
"1830","1832  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 1832","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن أبو معاوية الضرير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","باب"
"1831","بَابٌ  1833  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  أَصَابَ الْعَدُوُّ نَاقَةَ  رَجُلٍ مِنْ بَنِي سُلَيْمٍ  ، ثُمَّ اشْتَرَاهَا  رَجُلٌ  مِنَ الْمُسْلِمِينَ فَعَرَفَهَا صَاحِبُهَا ، فَأَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فَأَمَرَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَأْخُذَهَا بِالثَّمَنِ الَّذِي اشْتَرَاهَا بِهِ مِنَ الْعَدُوِّ  وَإِلَّا خَلَّى بَيْنَهَا وَبَيْنَهُ  .","","Al-Mu'jam al-Kabir 1833","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن سماك بن حرب البكري عن سفيان الثوري عن عبد الرحيم بن سليمان الأشل عن سهل بن عثمان العسكري عن الحسين بن إسحاق التستري عن الطبراني","باب"
"1832","1834  -  حَدَّثَنَا  أَحْمَدُ بْنُ سُلَيْمَانَ بْنِ يُوسُفَ الْعُقَيْلِيُّ الْأَصْبَهَانِيُّ  ، حَدَّثَنِي  أَبِي  ، ثَنَا  الْحُسَيْنُ بْنُ حَفْصٍ ،  عَنْ  يَاسِينَ الزَّيَّاتِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرٍ :  أَنَّ رَجُلَيْنِ اخْتَصَمَا إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي بَعِيرٍ  ، وَأَقَامَ كُلُّ وَاحِدٍ مِنْهُمَا بَيِّنَةً أَنَّهُ لَهُ فَقَضَى بَيْنَهُمَا  .","","Al-Mu'jam al-Kabir 1834","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن تميم بن طرفة المذحجي عن سماك بن حرب البكري عن ياسين بن معاذ الزيات عن الحسين بن حفص الهمداني عن سليمان بن يوسف بن صالح العقيلي عن أحمد بن سليمان بن يوسف الفابزاني عن الطبراني","باب"
"1833","1835  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ الْحِمْصِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ،  ثَنَا  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ،  أَنَّ رَجُلَيْنِ ، "" اخْتَصَمَا إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي بَعِيرٍ ،  فَأَقَامَ كُلُّ وَاحِدٍ مِنْهُمَا شَاهِدَيْنِ أَنَّهُ لَهُ ، فَجَعَلَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَهُمَا  .","","Al-Mu'jam al-Kabir 1835","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن سماك بن حرب البكري عن حجاج بن أرطاة عن سويد بن عبد العزيز السلمي عن محمد بن مصفى بن بهلول عن إبراهيم بن محمد بن عرق الحمصي عن الطبراني","باب"
"1834","[2/205]      عُبَيْدُ اللهِ بْنُ الْقِبْطِيَّةِ  عَنْ  جَابِرِ بْنِ سَمُرَةَ  1836  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  عُبَيْدِ اللهِ بْنِ الْقِبْطِيَّةِ ، قَالَ :  سَمِعْتُ  جَابِرَ بْنَ سَمُرَةَ ، يَقُولُ :  كُنَّا إِذَا صَلَّيْنَا خَلْفَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قُلْنَا : السَّلَامُ عَلَيْكُمُ السَّلَامُ عَلَيْكُمْ ، وَأَشَارَ  مِسْعَرٌ  بِيَدِهِ عَنْ يَمِينِهِ وَعَنْ شِمَالِهِ ، فَقَالَ :  مَا بَالُ هَؤُلَاءِ يَرْفَعُونَ أَيْدِيَهُمْ كَأَنَّهَا أَذْنَابُ الْخَيْلِ الشُّمْسِ  ، أَمَا يَكْفِي  أَحَدَكُمْ ، أَوْ أَحَدَهُمْ  ، أَنْ يَضَعَ يَدَهُ عَلَى فَخِذِهِ ، ثُمَّ يُسَلِّمُ عَلَى أَخِيهِ مِنْ عَنْ يَمِينِهِ وَشِمَالِهِ  .","","Al-Mu'jam al-Kabir 1836","","جابر بن سمرة السوائي عن عبيد الله بن القبطية اللخمي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبيد الله بن القبطية عن جابر بن سمرة"
"1835","1837  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،  عَنْ  مِسْعَرٍ ،  عَنِ  ابْنِ الْقِبْطِيَّةِ ، قَالَ :  سَمِعْتُ  جَابِرَ بْنَ سَمُرَةَ ، يَقُولُ :  كُنَّا نُصَلِّي مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَنَقُولُ بِأَيْدِينَا : السَّلَامُ عَلَيْكُمُ ، السَّلَامُ عَلَيْكُمْ ، فَقَالَ :  مَا بَالُ أَقْوَامٍ يُلْقُونَ أَيْدِيَهُمْ كَأَنَّهَا أَذْنَابُ خَيْلٍ  شُمْسٍ  ،  أَلَا يَكْفِي أَحَدَكُمْ أَوْ إِنَّمَا يَكْفِي أَحَدَكُمْ  أَنْ يَضَعَ يَدَهُ عَلَى فَخِذِهِ ، ثُمَّ يُسَلِّمَ عَلَى أَخِيهِ عَنْ يَمِينِهِ وَعَنْ شِمَالِهِ  .","","Al-Mu'jam al-Kabir 1837","","جابر بن سمرة السوائي عن عبيد الله بن القبطية اللخمي عن مسعر بن كدام عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عبيد الله بن القبطية عن جابر بن سمرة"
"1836","1838  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ  ثَنَا  وَكِيعٌ  عَنْ  مِسْعَرٍ  عَنْ  عُبَيْدِ اللهِ بْنِ الْقِبْطِيَّةِ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 1838","","جابر بن سمرة السوائي عن عبيد الله بن القبطية اللخمي عن مسعر بن كدام عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبيد الله بن القبطية عن جابر بن سمرة"
"1837","1839  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ  ، ثَنَا  الْحَسَنُ بْنُ إِدْرِيسَ الْحُلْوَانِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ أَبِي هَوْذَةَ ،  ثَنَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  فُرَاتٍ الْقَزَّازِ ،  عَنْ  عُبَيْدِ اللهِ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  دَخَلْتُ أَنَا وَأَبِي ، عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَصَلَّى بِنَا فَلَمَّا سَلَّمَ أَوْمَأَ النَّاسُ بِأَيْدِيهِمْ يَمِينًا وَشِمَالًا فَأَبْصَرَهُمْ ، فَقَالَ :  مَا شَأْنُكُمْ تُقَلِّبُونَ أَيْدِيَكُمْ كَأَنَّهَا أَذْنَابُ الْخَيْلِ الشُّمْسِ  ، إِذَا سَلَّمَ أَحَدُكُمْ فَلْيُسَلِّمْ عَلَى مَنْ عَنْ يَمِينِهِ وَعَلَى مَنْ عَنْ يَسَارِهِ "" ، فَلَمَّا صَلَّوْا مَعَهُ أَيْضًا لَمْ يَفْعَلُوا ذَلِكَ  .","","Al-Mu'jam al-Kabir 1839","","جابر بن سمرة السوائي عن عبيد الله بن القبطية اللخمي عن فرات بن أبي عبد الرحمن القزاز عن عمرو بن أبي قيس عن سليمان بن أبى هوذة عن الحسن بن إدريس القافلائي عن أحمد بن يحيى بن إسحاق الحلواني عن الطبراني","عبيد الله بن القبطية عن جابر بن سمرة"
"1838","[2/206]      1840  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  مُصْعَبُ بْنُ الْمِقْدَامِ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  فُرَاتٍ الْقَزَّازِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ الْقِبْطِيَّةِ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  صَلَّيْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَكُنَّا إِذَا سَلَّمْنَا أَشَرْنَا بِأَيْدِينَا السَّلَامُ عَلَيْكُمْ ، فَنَظَرَ إِلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  مَا شَأْنُكُمْ تُشِيرُونَ بِأَيْدِيكُمْ كَأَنَّهَا أَذْنَابُ خَيْلٍ  شُمْسٍ  ، إِذَا سَلَّمَ أَحَدُكُمْ فَلْيَلْتَفِتْ إِلَى أَصْحَابِهِ وَلَا يُومِئْ بِيَدِهِ  .","","Al-Mu'jam al-Kabir 1840","","جابر بن سمرة السوائي عن عبيد الله بن القبطية اللخمي عن فرات بن أبي عبد الرحمن القزاز عن إسرائيل بن يونس بن أبي إسحاق عن مصعب بن المقدام الخثعمي عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عبيد الله بن القبطية عن جابر بن سمرة"
"1839","1841  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ  ، ثَنَا  الْحَسَنُ بْنُ إِدْرِيسَ الْحُلْوَانِيُّ ،  حَدَّثَنَا  سُلَيْمَانُ بْنُ أَبِي هَوْذَةَ ،  ثَنَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  فُرَاتٍ الْقَزَّازِ ،  عَنْ  عُبَيْدِ اللهِ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  دَخَلْتُ مَعَ أَبِي عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَجَلَسْنَا عِنْدَهُ ، فَقَالَ :  لَا يَزَالُ الْإِسْلَامُ ظَاهِرًا حَتَّى يَكُونَ اثْنَا عَشَرَ  أَمِيرًا أَوْ  خَلِيفَةً  كُلُّهُمْ مِنْ  قُرَيْشٍ  .","","Al-Mu'jam al-Kabir 1841","","جابر بن سمرة السوائي عن عبيد الله بن القبطية اللخمي عن فرات بن أبي عبد الرحمن القزاز عن عمرو بن أبي قيس عن سليمان بن أبى هوذة عن الحسن بن إدريس القافلائي عن أحمد بن يحيى بن إسحاق الحلواني عن الطبراني","عبيد الله بن القبطية عن جابر بن سمرة"
"1840","أَبُو إِسْحَاقَ السَّبِيعِيُّ  عَنْ  جَابِرِ بْنِ سَمُرَةَ  1842  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  ابْنُ الْأَصْبَهَانِيِّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِيُّ ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي لَيْلَةٍ إِضْحِيَانٍ وَعَلَيْهِ  حُلَّةٌ  حَمْرَاءُ  قَالَ : فَجَعَلْتُ أَنْظُرُ إِلَيْهِ وَإِلَى الْقَمَرِ فَلَهُوَ أَحْسَنُ فِي عَيْنِي مِنَ الْقَمَرِ  .","","Al-Mu'jam al-Kabir 1842","","جابر بن سمرة السوائي عن أبو إسحاق السبيعي عن أشعث بن سوار عن عبد الرحمن بن محمد المحاربي عن محمد بن سعيد حمدان عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو إسحاق السبيعي عن جابر بن سمرة"
"1841","أَبُو خَالِدٍ الْوَالِبِيُّ  عَنْ  جَابِرٍ  اسْمُهُ  هَرِمُ بْنُ هُرْمُزَ  1843  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  فِطْرٌ ، قَالَ :  حَدَّثَنِي  أَبُو خَالِدٍ الْوَالِبِيُّ ، قَالَ :  سَمِعْتُ  جَابِرَ بْنَ سَمُرَةَ ، يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بُعِثْتُ أَنَا وَالسَّاعَةُ كَهَذِهِ مِنْ هَذِهِ  إِصْبَعَيْهِ الْوُسْطَى وَالسَّبَّابَةِ  .","","Al-Mu'jam al-Kabir 1843","","جابر بن سمرة السوائي عن أبو خالد الوالبي عن فطر بن خليفة عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو خالد الوالبي عن جابر اسمه هرم بن هرمز"
"1842","[2/207]      1844  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  عَثَّامُ بْنُ عَلِيٍّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي خَالِدٍ ،  عَنْ  جَابِرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  بُعِثْتُ أَنَا وَالسَّاعَةُ كَهَاتَيْنِ  .","","Al-Mu'jam al-Kabir 1844","","جابر بن سمرة السوائي عن أبو خالد الوالبي عن الأعمش عن عثام بن علي الوحيدي عن أبو كريب محمد بن العلاء عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو خالد الوالبي عن جابر اسمه هرم بن هرمز"
"1843","1845  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي خَالِدٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بُعِثْتُ أَنَا وَالسَّاعَةُ كَهَاتَيْنِ  .","","Al-Mu'jam al-Kabir 1845","","جابر بن سمرة السوائي عن أبو خالد الوالبي عن منصور بن المعتمر عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","أبو خالد الوالبي عن جابر اسمه هرم بن هرمز"
"1844","1846  -  حَدَّثَنَا  الْقَاسِمُ بْنُ مُحَمَّدٍ الدَّلَّالُ  ، ثَنَا  مُخَوَّلُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  إِسْرَائِيلُ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبِي  رَحِمَهُ اللهُ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي خَالِدٍ الْوَالِبِيِّ ،  عَنْ  جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بُعِثْتُ أَنَا وَالسَّاعَةُ كَهَاتَيْنِ  .","","Al-Mu'jam al-Kabir 1846","","جابر بن سمرة السوائي عن أبو خالد الوالبي عن منصور بن المعتمر عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرحمن بن مهدي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو خالد الوالبي عن جابر اسمه هرم بن هرمز"
"1845","1847  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  أَبُو الْجَوَّابِ ،  عَنْ  عَمَّارِ بْنِ رُزَيْقٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي خَالِدٍ ،  عَنْ  جَابِرٍ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَقُولُ :  بُعِثْتُ أَنَا وَالسَّاعَةُ كَهَذِهِ مِنْ هَذِهِ  .","","Al-Mu'jam al-Kabir 1847","","جابر بن سمرة السوائي عن أبو خالد الوالبي عن الأعمش عن عمار بن رزيق الضبي عن أحوص بن جواب الضبي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو خالد الوالبي عن جابر اسمه هرم بن هرمز"
"1846","1848  -  حَدَّثَنَا  الْقَاسِمُ الدَّلَّالُ الْكُوفِيُّ  ، ثَنَا  مُخَوَّلُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي خَالِدٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  بُعِثْتُ أَنَا وَالسَّاعَةُ كَهَاتَيْنِ  .","","Al-Mu'jam al-Kabir 1848","","جابر بن سمرة السوائي عن أبو خالد الوالبي عن منصور بن المعتمر عن إسرائيل بن يونس بن أبي إسحاق عن مخول بن إبراهيم الكوفي عن قاسم بن محمد بن حماد الدلال عن الطبراني","أبو خالد الوالبي عن جابر اسمه هرم بن هرمز"
"1847","1849  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ ، (  ح  )         [2/208]      وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  شِهَابُ بْنُ عَبَّادٍ ، قَالَا :  ثَنَا  إِبْرَاهِيمُ بْنُ حُمَيْدٍ ،  عَنِ  ابْنِ أَبِي خَالِدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَزَالُ هَذَا الدِّينُ قَائِمًا حَتَّى يَقُومَ اثْنَا عَشَرَ  خَلِيفَةً  ، قَالَ  إِسْمَاعِيلُ  :  أَظُنُّ ظَنًّا أَنَّ أَبِي قَالَ :  كُلُّهُمْ تَجْتَمِعُ عَلَيْهِ الْأُمَّةُ  .","","Al-Mu'jam al-Kabir 1849","","جابر بن سمرة السوائي عن أبو خالد الأحمسي عن إسماعيل بن أبي خالد عن إبراهيم بن حميد الرؤاسي عن شهاب بن عباد الرواس عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو خالد الوالبي عن جابر اسمه هرم بن هرمز"
"1848","1850  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 1850","","جابر بن سمرة السوائي عن أبو خالد الأحمسي عن إسماعيل بن أبي خالد عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو خالد الوالبي عن جابر اسمه هرم بن هرمز"
"1849","1851  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ الدِّمَشْقِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 1851","","جابر بن سمرة السوائي عن أبو خالد الأحمسي عن إسماعيل بن أبي خالد عن مروان بن معاوية الفزاري عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","أبو خالد الوالبي عن جابر اسمه هرم بن هرمز"
"1850","1852  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  فِطْرٌ ،  أَنَا  أَبُو خَالِدٍ ، قَالَ :  سَمِعْتُ  جَابِرَ بْنَ سَمُرَةَ ، يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَضُرُّ هَذَا الدِّينُ مَنْ نَاوَأَهُ حَتَّى يَقُومَ اثْنَا عَشَرَ  خَلِيفَةً  كُلُّهُمْ مِنْ  قُرَيْشٍ  .","","Al-Mu'jam al-Kabir 1852","","جابر بن سمرة السوائي عن أبو خالد الوالبي عن فطر بن خليفة عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو خالد الوالبي عن جابر اسمه هرم بن هرمز"
"1851","1853  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ الْقَاسِمِ الْأَسَدِيُّ ،  ثَنَا  فِطْرٌ ،  عَنْ  أَبِي خَالِدٍ الْوَالِبِيِّ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  ثَلَاثٌ أَخَافُ عَلَى أُمَّتِي : اسْتِسْقَاءٌ بِالْأَنْوَاءِ  ، وَحَيْفُ السُّلْطَانِ ، وَتَكْذِيبٌ بِالْقَدَرِ  .","","Al-Mu'jam al-Kabir 1853","","جابر بن سمرة السوائي عن أبو خالد الوالبي عن فطر بن خليفة عن محمد بن القاسم الأسدي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","أبو خالد الوالبي عن جابر اسمه هرم بن هرمز"
"1852","1854  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،         [2/209]      عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي خَالِدٍ الْوَالِبِيِّ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ رَضِيَ اللهُ عَنْهُ ، قَالَ :  أَوَّلُ مَنْ رَمَى بِسَهْمٍ فِي  سَبِيلِ  اللهِ  سَعْدٌ  ""  .","","Al-Mu'jam al-Kabir 1854","","جابر بن سمرة السوائي عن أبو خالد الوالبي عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","أبو خالد الوالبي عن جابر اسمه هرم بن هرمز"
"1853","1855  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي عُبَيْدَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي خَالِدٍ الْوَالِبِيِّ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  أَوَّلُ مَنْ رَمَى بِسَهْمٍ فِي  سَبِيلِ  اللهِ  سَعْدٌ  ""  .","","Al-Mu'jam al-Kabir 1855","","جابر بن سمرة السوائي عن أبو خالد الوالبي عن الأعمش عن عبد الملك بن معن المسعودي عن محمد بن أبي عبيدة المسعودي عن محمد بن عبد الله بن نمير عن عبيد بن غنام النخعي عن الطبراني","أبو خالد الوالبي عن جابر اسمه هرم بن هرمز"
"1854","1856  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  أَبِي  ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ أَبِي عُبَيْدَةَ ،  حَدَّثَنِي  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي خَالِدٍ الْوَالِبِيِّ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  بَعَثَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَرِيَّةٍ  فَهَزَمْنَا فَاتَّبَعَ  سَعْدٌ  رَاكِبًا مِنْهُمْ ، فَالْتَفَتَ إِلَيْهِ فَرَأَى سَاقَهُ خَارِجَةً مِنَ الْغَرْزِ فَرَمَاهُ بِسَهْمٍ ، فَرَأَيْتُ الدَّمَ يَسِيلُ كَأَنَّهُ شِرَاكٌ فَأَنَاخَ  .","","Al-Mu'jam al-Kabir 1856","","جابر بن سمرة السوائي عن أبو خالد الوالبي عن الأعمش عن عبد الملك بن معن المسعودي عن محمد بن أبي عبيدة المسعودي عن محمد بن عبد الله بن نمير عن عبيد بن غنام النخعي عن الطبراني","أبو خالد الوالبي عن جابر اسمه هرم بن هرمز"
"1855","1857  -  حَدَّثَنَا  أَحْمَدُ بْنُ خُلَيْدٍ الْحَلَبِيُّ ،  ثَنَا  سَعِيدُ بْنُ الْمُغِيرَةِ الصَّيَّادُ ،  ثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي خَالِدٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  خَرَجْنَا فِي سَرِيَّةٍ  فَذَكَرَ نَحْوَهُ  .","","Al-Mu'jam al-Kabir 1857","","جابر بن سمرة السوائي عن أبو خالد الوالبي عن الأعمش عن عيسى بن يونس بن أبي إسحاق عن سعيد سعيد بن المغيرة الصياد عن أحمد بن خليد بن يزيد الحلبي عن الطبراني","أبو خالد الوالبي عن جابر اسمه هرم بن هرمز"
"1856","1858  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عُمَرُ بْنُ حَفْصِ بْنِ غِيَاثٍ ،  حَدَّثَنِي  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي خَالِدٍ الْوَالِبِيِّ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، أَوْ رَجُلٍ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَرْعَى غَنَمًا فَاسْتَعْلَى الْغَنَمَ ، فَكَانَ فِي الْإِبِلِ هُوَ  وَشَرِيكٌ لَهُ  ، فَأَكْرَيَا  أُخْتَ خَدِيجَةَ  ، فَلَمَّا قَضَوُا السَّفَرَ بَقِيَ لَهُمْ عَلَيْهَا شَيْءٌ ، فَجَعَلَ شَرِيكُهُ يَأْتِيهِمْ وَيَتَقَاضَاهُمْ وَيَقُولُ  لِمُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : انْطَلِقْ ، فَيَقُولُ :  اذْهَبْ أَنْتَ فَإِنِّي أَسْتَحْيِي  ، فَقَالَتْ مَرَّةً وَأَتَاهُمْ : فَأَيْنَ  مُحَمَّدٌ  لَا يَجِيءُ مَعَكَ ؟ قَالَ : قَدْ قُلْتُ لَهُ فَزَعَمَ أَنَّهُ يَسْتَحْيِي ، فَقَالَتْ : مَا رَأَيْتُ رَجُلًا أَشَدَّ حَيَاءً وَلَا أَعَفَّ وَلَاءً ، فَوَقَعَ فِي نَفْسِ أُخْتِهَا  خَدِيجَةَ  فَبَعَثَتْ إِلَيْهِ ،         [2/210]      فَقَالَتِ : ائْتِ أَبِي فَاخْطُبْنِي إِلَيْهِ ، فَقَالَ : "" أَبُوكِ رَجُلٌ كَثِيرُ الْمَالِ وَهُوَ لَا يَفْعَلُ "" ، قَالَتِ : انْطَلِقْ فَالْقَهُ وَكَلِّمْهُ ، ثُمَّ أَنَا أَكْفِيكَ وَائْتِ عِنْدَ سُكْرِهِ فَفَعَلَ ، فَأَتَاهُ فَزَوَّجَهُ ، فَلَمَّا أَصْبَحَ جَلَسَ فِي الْمَجْلِسِ ، فَقِيلَ لَهُ : قَدْ أَحْسَنْتَ زَوَّجْتَ  مُحَمَّدًا  ، قَالَ : أَوَفَعَلْتُ ؟ قَالُوا : نَعَمْ ، فَقَامَ فَدَخَلَ عَلَيْهَا ، فَقَالَ : إِنَّ النَّاسَ يَقُولُونَ : إِنِّي قَدْ زَوَّجْتُ  مُحَمَّدًا  وَمَا فَعَلْتُ ، قَالَتْ : فَلَا تُسَفِّهَنَّ رَأْيَكَ ، فَإِنَّ  مُحَمَّدًا  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَذَا ، فَلَمْ تَزَلْ بِهِ حَتَّى رَضِيَ ، ثُمَّ بَعَثَتْ إِلَى  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِوِقَّتَيْنِ مِنْ  فِضَّةٍ أَوْ ذَهَبٍ  وَقَالَتِ : اشْتَرِ  حُلَّةً  فَاهْدِهَا لِي وَكَبْشًا وَكَذَا وَكَذَا فَفَعَلَ  .","","Al-Mu'jam al-Kabir 1858","","أحد الصحابة عن أبو خالد الوالبي عن الأعمش عن حفص بن غياث النخعي عن عمر بن حفص بن غياث عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو خالد الوالبي عن جابر اسمه هرم بن هرمز"
"1857","جَعْفَرُ بْنُ أَبِي ثَوْرٍ  عَنْ  جَابِرِ بْنِ سَمُرَةَ  1859  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَعْفَرِ بْنِ أَبِي ثَوْرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  أَتَى  رَجُلٌ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَنَا عِنْدَهُ ، فَقَالَ : يَا رَسُولَ اللهِ أَتَطَهَّرُ مِنْ لُحُومِ الْغَنَمِ ؟ قَالَ :  إِنْ شِئْتَ فَتَطَهَّرْ وَإِنْ شِئْتَ فَدَعْ  ، قَالَ : فَأُصَلِّي فِي  مَرَابِضِ  الْغَنَمِ ؟ قَالَ : "" نَعَمْ "" ، قَالَ : أَفَأَتَطَهَّرُ مِنْ لُحُومِ الْإِبِلِ ؟ قَالَ : "" نَعَمْ "" ، قَالَ : أَفَأُصَلِّي فِي مَبَارِكِ الْإِبِلِ ؟ قَالَ : "" لَا  .","","Al-Mu'jam al-Kabir 1859","","جابر بن سمرة السوائي عن جعفر بن أبي ثور السوائي عن سماك بن حرب البكري عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","جعفر بن أبي ثور عن جابر بن سمرة"
"1858","1860  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَعْفَرِ بْنِ أَبِي ثَوْرٍ ،  عَنْ  جَدِّهِ جَابِرِ بْنِ سَمُرَةَ  أَنَّ  رَجُلًا  ، قَالَ : يَا رَسُولَ اللهِ أَتَوَضَّأُ مِنْ لُحُومِ الْغَنَمِ ؟ قَالَ :  إِنْ شِئْتَ فَعَلْتَ وَإِنْ شِئْتَ لَمْ تَفْعَلْ  ، قَالَ : أَتَوَضَّأُ مِنْ لُحُومِ الْإِبِلِ ؟ قَالَ : "" نَعَمْ "" ، قَالَ : يَا رَسُولَ اللهِ أُصَلِّي فِي مَبَاتِ الْغَنَمِ ؟ قَالَ : "" نَعَمْ "" ، قَالَ : أُصَلِّي فِي مَبَاتِ الْإِبِلِ ؟ قَالَ : "" لَا  .","","Al-Mu'jam al-Kabir 1860","","جابر بن سمرة السوائي عن جعفر بن أبي ثور السوائي عن سماك بن حرب البكري عن حماد بن سلمة عن سليمان بن حرب الواشحي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","جعفر بن أبي ثور عن جابر بن سمرة"
"1859","1861  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )         [2/211]      وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  زَكَرِيَّا بْنُ أَبِي زَائِدَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَعْفَرِ بْنِ أَبِي ثَوْرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  قَالَ  رَجُلٌ  لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَيُتَوَضَّأُ مِنْ لُحُومِ الْغَنَمِ ؟ قَالَ :  إِنْ شِئْتَ فَتَوَضَّأْ وَإِنْ شِئْتَ فَلَا تَوَضَّأْ  ، قَالَ : فَأُصَلِّي فِي بَيْتِ الْغَنَمِ ؟ قَالَ : "" نَعَمْ  .","","Al-Mu'jam al-Kabir 1861","","جابر بن سمرة السوائي عن جعفر بن أبي ثور السوائي عن سماك بن حرب البكري عن زكريا بن أبي زائدة الوادعي عن عبيد الله بن موسى عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","جعفر بن أبي ثور عن جابر بن سمرة"
"1860","1862  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  حَسَنُ بْنُ صَالِحٍ ،  عَنْ  سِمَاكٍ ، قَالَ :  حَدَّثَنِي  جَعْفَرُ بْنُ أَبِي ثَوْرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  مَرَّ  رَجُلٌ  عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : أَتَطَهَّرُ مِنْ لُحُومِ الْإِبِلِ ؟ فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" نَعَمْ "" ، قَالَ : فَأُصَلِّي فِي مَبَارِكِ الْإِبِلِ ؟ فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَا "" ، قَالَ : أَفَأَتَطَهَّرُ عَنْ لُحُومِ الْغَنَمِ ؟ قَالَ :  إِنْ شِئْتَ فَتَطَهَّرْ وَإِنْ شِئْتَ فَلَا تَطَهَّرْ  ، قَالَ : فَأُصَلِّي فِي  مَرَابِضِ  الْغَنَمِ ؟ قَالَ : "" نَعَمْ  .","","Al-Mu'jam al-Kabir 1862","","جابر بن سمرة السوائي عن جعفر بن أبي ثور السوائي عن سماك بن حرب البكري عن الحسن بن صالح بن صالح بن حي عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","جعفر بن أبي ثور عن جابر بن سمرة"
"1861","1863  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  الْجَرَّاحُ بْنُ مَخْلَدٍ ،  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ، وَأَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ ،  عَنْ  جَعْفَرِ بْنِ أَبِي ثَوْرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سُئِلَ أَيُصَلَّى فِي  أَعْطَانِ  الْإِبِلِ ؟ قَالَ : "" لَا  ، قِيلَ : أَيُتَوَضَّأُ مِنْ لُحُومِهَا ؟ قَالَ : "" نَعَمْ "" ، قَالَ : فَيُصَلَّى فِي  مَرَابِضِ  الْغَنَمِ ؟ قَالَ : "" نَعَمْ "" قِيلَ : يُتَوَضَّأُ مِنْ لُحُومِهَا ؟ قَالَ : "" لَا  .","","Al-Mu'jam al-Kabir 1863","","جابر بن سمرة السوائي عن جعفر بن أبي ثور السوائي عن أشعث بن أبي الشعثاء عن شعبة بن الحجاج عن روح بن عبادة القيسي عن الجراح بن مخلد عن عبد الله بن أحمد الجواليقي عن الطبراني","جعفر بن أبي ثور عن جابر بن سمرة"
"1862","1864  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  الْحَسَنُ بْنُ مُوسَى الْأَشْيَبُ ،  ثَنَا  شَيْبَانُ ،  عَنْ  أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ ،  عَنْ  جَعْفَرِ بْنِ أَبِي ثَوْرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  أَمَرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ نَتَوَضَّأَ مِنْ لُحُومِ الْإِبِلِ  ، وَلَا نَتَوَضَّأُ مِنْ لُحُومِ الْغَنَمِ ، وَأَنْ نُصَلِّيَ فِي  دِبْنِ  الْغَنَمِ ، وَلَا نُصَلِّيَ فِي  أَعْطَانِ  الْإِبِلِ  .","","Al-Mu'jam al-Kabir 1864","","جابر بن سمرة السوائي عن جعفر بن أبي ثور السوائي عن أشعث بن أبي الشعثاء عن شيبان بن عبد الرحمن المؤدب عن الحسن بن موسى الأشيب عن بشر بن موسى بن صالح الأسدي عن الطبراني","جعفر بن أبي ثور عن جابر بن سمرة"
"1863","1865  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْخُزَاعِيُّ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  أَشْعَثَ ،  عَنْ  جَعْفَرِ بْنِ أَبِي ثَوْرٍ ،  عَنْ  جَابِرٍ ، قَالَ :  أَمَرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ نَتَوَضَّأَ مِنْ لُحُومِ الْإِبِلِ  ، وَلَا نَتَوَضَّأُ مِنْ لُحُومِ الْغَنَمِ ، وَأَنْ نُصَلِّيَ فِي  مَرَابِضِ  الْغَنَمِ ، وَلَا نُصَلِّيَ فِي  أَعْطَانِ  الْإِبِلِ  .","","Al-Mu'jam al-Kabir 1865","","جابر بن سمرة السوائي عن جعفر بن أبي ثور السوائي عن أشعث بن أبي الشعثاء عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن كثير العبدي عن أحمد بن محمد بن علي الخزاعي عن الطبراني","جعفر بن أبي ثور عن جابر بن سمرة"
"1864","[2/212]      1866  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ، (  ح  )  وَحَدَّثَنَا  طَالِبُ بْنُ قُرَّةَ الْأَذَنِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عِيسَى الطَّبَّاعُ ، (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالُوا :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عُثْمَانَ بْنِ عَبْدِ اللهِ بْنِ مَوْهَبٍ ،  عَنْ  جَعْفَرِ بْنِ أَبِي ثَوْرٍ ،  عَنْ  جَابِرٍ ، قَالَ :  كُنْتُ جَالِسًا عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَسُئِلَ : أَنَتَوَضَّأُ مِنْ لُحُومِ الْإِبِلِ ؟ فَقَالَ :  نَعَمْ فَتَوَضَّأُوا مِنْ لُحُومِ الْإِبِلِ  ، فَقَالُوا : أَنُصَلِّي فِي مَبَارِكِ الْإِبِلِ ؟ قَالَ : "" لَا "" ، قَالُوا : أَنَتَوَضَّأُ مِنْ لُحُومِ الْغَنَمِ ؟ قَالَ : "" إِنْ شِئْتَ فَتَوَضَّأْ وَإِنْ شِئْتَ فَلَا تَوَضَّأْ "" ، قَالُوا : أَنُصَلِّي فِي  مَرَابِضِ  الْغَنَمِ ؟ قَالَ : "" نَعَمْ  .","","Al-Mu'jam al-Kabir 1866","","جابر بن سمرة السوائي عن جعفر بن أبي ثور السوائي عن عثمان بن عبد الله بن موهب الأعرج عن الوضاح بن عبد الله اليشكري عن ابن الطباع ، محمد بن عيسى بن نجيح البغدادي عن طالب بن قرة الأذني عن الطبراني","جعفر بن أبي ثور عن جابر بن سمرة"
"1865","1867  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  عَنْ  شَيْبَانَ ،  عَنْ  عُثْمَانَ بْنِ عَبْدِ اللهِ بْنِ مَوْهَبٍ ،  عَنْ  جَعْفَرِ بْنِ أَبِي ثَوْرٍ ،  أَخْبَرَنِي  جَدِّي جَابِرُ بْنُ سَمُرَةَ ، قَالَ :  كُنْتُ قَاعِدًا مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَتَاهُ  رَجُلٌ  ، فَقَالَ : يَا رَسُولَ اللهِ أَنَتَوَضَّأُ مِنْ لُحُومِ الْغَنَمِ ؟ قَالَ :  إِنْ شِئْتَ فَتَوَضَّأْ وَإِنْ شِئْتَ فَلَا تَوَضَّأْ  ، قَالَ : أَتَوَضَّأُ مِنْ لُحُومِ الْإِبِلِ ؟ قَالَ : "" نَعَمْ "" ، قَالَ : أُصَلِّي فِي مَبَارِكِ الْإِبِلِ ؟ قَالَ : "" لَا "" ، قَالَ : أَفَأُصَلِّي فِي  مَرَابِضِ  الْغَنَمِ ؟ قَالَ : "" نَعَمْ  .","","Al-Mu'jam al-Kabir 1867","","جابر بن سمرة السوائي عن جعفر بن أبي ثور السوائي عن عثمان بن عبد الله بن موهب الأعرج عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","جعفر بن أبي ثور عن جابر بن سمرة"
"1866","1868  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْأُبُلِّيُّ  ، حَدَّثَنَا  جَمِيلُ بْنُ الْحَسَنِ الْعَتَكِيُّ ،  ثَنَا  وَكِيعٌ ،  ثَنَا  مُحَمَّدُ بْنُ قَيْسٍ الْأَسَدِيُّ ،  عَنْ  جَعْفَرٍ السُّوَائِيِّ ،  عَنْ  جَدِّهِ جَابِرِ بْنِ سَمُرَةَ قَالَ :  كُنَّا نُصَلِّي فِي  مَرَابِضِ  الْغَنَمِ  ، وَلَا نُصَلِّي فِي مَبَارِكِ الْإِبِلِ ، وَكُنَّا نَتَوَضَّأُ مِنْ لُحُومِ الْإِبِلِ ، وَلَا نَتَوَضَّأُ مِنْ لُحُومِ الْغَنَمِ  "" .","","Al-Mu'jam al-Kabir 1868","","جابر بن سمرة السوائي عن جعفر بن أبي ثور السوائي عن محمد بن قيس الوالبي عن وكيع بن الجراح عن جميل بن الحسن الجهضمي عن محمد بن موسى بن عمران الأبلي عن الطبراني","جعفر بن أبي ثور عن جابر بن سمرة"
"1867","1869  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  الْحَسَنُ بْنُ مُوسَى الْأَشْيَبُ ،  ثَنَا  شَيْبَانُ ،  عَنْ  أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ ،  عَنْ  جَعْفَرِ بْنِ أَبِي ثَوْرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" يَأْمُرُنَا بِصِيَامِ عَاشُورَاءَ وَيَحُثُّنَا وَيَتَعَاهَدُنَا عِنْدَهُ  ، فَلَمَّا فُرِضَ رَمَضَانُ لَمْ يَأْمُرْنَا بِهِ وَلَمْ يَنْهَنَا عَنْهُ ، وَلَمْ يَتَعَاهَدْنَا عِنْدَهُ  .","","Al-Mu'jam al-Kabir 1869","","جابر بن سمرة السوائي عن جعفر بن أبي ثور السوائي عن أشعث بن أبي الشعثاء عن شيبان بن عبد الرحمن المؤدب عن الحسن بن موسى الأشيب عن بشر بن موسى بن صالح الأسدي عن الطبراني","جعفر بن أبي ثور عن جابر بن سمرة"
"1868","[2/213]      عَبْدُ الْمَلِكِ بْنُ عُمَيْرٍ  عَنْ  جَابِرِ بْنِ سَمُرَةَ  1870  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ الرَّقِّيُّ ،  ثَنَا  قَبِيصَةُ بْنُ عُقْبَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا هَلَكَ  كِسْرَى  فَلَا كِسْرَى بَعْدَهُ  .","","Al-Mu'jam al-Kabir 1870","","جابر بن سمرة السوائي عن عبد الملك بن عمير القبطي عن سفيان الثوري عن قبيصة بن عقبة السوائي عن حفص بن عمر سنجة ألف عن الطبراني","عبد الملك بن عمير عن جابر بن سمرة"
"1869","1871  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، وَعُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ، قَالَا :  ثَنَا  أَبُو الْوَلِيدِ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ، قَالَا :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا هَلَكَ  قَيْصَرُ  فَلَا قَيْصَرَ بَعْدَهُ  ، وَإِذَا هَلَكَ  كِسْرَى  فَلَا كِسْرَى بَعْدَهُ ، وَالَّذِي نَفْسِي بِيَدِهِ لَتُنْفَقَنَّ كُنُوزُهُمَا فِي  سَبِيلِ  اللهِ عَزَّ وَجَلَّ  .","","Al-Mu'jam al-Kabir 1871","","جابر بن سمرة السوائي عن عبد الملك بن عمير القبطي عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عبد الملك بن عمير عن جابر بن سمرة"
"1870","1872  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا هَلَكَ  كِسْرَى  فَلَا كِسْرَى بَعْدَهُ  ، وَإِذَا هَلَكَ  قَيْصَرُ  فَلَا قَيْصَرَ بَعْدَهُ  .","","Al-Mu'jam al-Kabir 1872","","جابر بن سمرة السوائي عن عبد الملك بن عمير القبطي عن أبو بكر بن عياش عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","عبد الملك بن عمير عن جابر بن سمرة"
"1871","1873  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  جَعْفَرُ بْنُ مُحَمَّدِ بْنِ فُضَيْلٍ الرَّاسِبِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُوسَى بْنِ أَعْيَنَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ يَزِيدَ بْنِ مَرْدَانْبَهْ ،  عَنْ  رَقَبَةَ بْنِ مَصْقَلَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِذَا هَلَكَ  كِسْرَى  فَلَا كِسْرَى بَعْدَهُ  ، وَإِذَا هَلَكَ  قَيْصَرُ  فَلَا قَيْصَرَ بَعْدَهُ ، وَالَّذِي نَفْسِي بِيَدِهِ لَتُنْفَقَنَّ كُنُوزُهُمَا فِي  سَبِيلِ  اللهِ عَزَّ وَجَلَّ  .","","Al-Mu'jam al-Kabir 1873","","جابر بن سمرة السوائي عن عبد الملك بن عمير القبطي عن رقبة بن مصقلة عن إبراهيم بن يزيد بن مردانبه عن محمد بن موسى بن أعين الجزري عن جعفر بن محمد بن الفضيل الرسعني عن علي بن سعيد بن بشير عليك عن الطبراني","عبد الملك بن عمير عن جابر بن سمرة"
"1872","1874  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  حَدَّثَنَا  شَيْبَانُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا ذَهَبَ  قَيْصَرُ  فَلَا قَيْصَرَ بَعْدَهُ  ، وَإِذَا ذَهَبَ  كِسْرَى  فَلَا كِسْرَى بَعْدَهُ ، وَالَّذِي نَفْسِي بِيَدِهِ لَتُنْفَقَنَّ كُنُوزُهُمَا فِي         [2/214]      سَبِيلِ  اللهِ  .","","Al-Mu'jam al-Kabir 1874","","جابر بن سمرة السوائي عن عبد الملك بن عمير القبطي عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","عبد الملك بن عمير عن جابر بن سمرة"
"1873","1875  -  حَدَّثَنَا  بِشْرُ  ، ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَكُونُ بَعْدِي اثْنَا عَشَرَ أَمِيرًا  ثُمَّ قَالَ كَلِمَةً لَمْ أَفْهَمْهَا  فَسَأَلْتُ  أَبِي : مَاذَا قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : "" كُلُّهُمْ مِنْ  قُرَيْشٍ  .","","Al-Mu'jam al-Kabir 1875","","سمرة بن جنادة السوائي عن جابر بن سمرة السوائي عن عبد الملك بن عمير القبطي عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","عبد الملك بن عمير عن جابر بن سمرة"
"1874","1876  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، حَدَّثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَزَالُ هَذَا الْأَمْرُ قَائِمًا حَتَّى يَكُونَ اثْنَا عَشَرَ  خَلِيفَةً  .","","Al-Mu'jam al-Kabir 1876","","جابر بن سمرة السوائي عن عبد الملك بن عمير القبطي عن سفيان الثوري عن وكيع بن الجراح عن سهل بن عثمان العسكري عن الحسين بن إسحاق التستري عن الطبراني","عبد الملك بن عمير عن جابر بن سمرة"
"1875","1877  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  حَدَّثَنَا  رَوْحُ بْنُ عَطَاءِ بْنِ أَبِي مَيْمُونَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  أَتَى  أَعْرَابِيٌّ  رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ مَا تَقُولُ فِي الضَّبِّ ؟ فَقَالَ :  مُسِخَتْ  أُمَّةٌ مِنْ  بَنِي إِسْرَائِيلَ  لَا أَدْرِي أَيَّ الدَّوَابِّ  مُسِخَتْ  ، وَلَا آمُرُ بِهِ وَلَا أَنْهَى عَنْهُ  .","","Al-Mu'jam al-Kabir 1877","","جابر بن سمرة السوائي عن عبد الملك بن عمير القبطي عن روح بن عطاء بن أبي ميمونة البصري عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","عبد الملك بن عمير عن جابر بن سمرة"
"1876","1878  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  مُوسَى الْأَنْصَارِيُّ ،  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  ثَنَا  قَيْسٌ ،  عَنْ  سِمَاكٍ ، وَعَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَيَفْتَحَنَّ أَبْيَضَ  آلِ كِسْرَى  عِصَابَةٌ مِنَ الْمُسْلِمِينَ  .","","Al-Mu'jam al-Kabir 1878","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن قيس بن الربيع الأسدي عن يونس بن بكير عن موسى الأنصاري عن عبد الله بن أحمد الجواليقي عن الطبراني","عبد الملك بن عمير عن جابر بن سمرة"
"1877","1879  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ الْمَسْرُوقِيُّ الْكُوفِيُّ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَا :  ثَنَا  هَارُونُ بْنُ أَبِي بُرْدَةَ ،  حَدَّثَنِي  أَخِي حُسَيْنُ بْنُ أَبِي بُرْدَةَ  ،  عَنْ  قَيْسٍ ،  عَنْ  عَبْدِ الْمَلِكِ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ وَغَيْرِهِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُسْتَشَارُ مُؤْتَمَنٌ  .","","Al-Mu'jam al-Kabir 1879","","أحد الصحابة عن عبد الملك بن عمير القبطي عن قيس بن الربيع الأسدي عن الحسين بن أبي بردة الكوفي عن هارون بن أبي بردة عن الحسين بن إسحاق التستري عن الطبراني","عبد الملك بن عمير عن جابر بن سمرة"
"1878","[2/215]      1880  -  حَدَّثَنَا  أَحْمَدُ بْنُ سُلَيْمَانَ بْنِ يُوسُفَ الْعُقَيْلِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ الشَّاذَكُونِيُّ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَتَخْرُجَنَّ الظَّعِينَةُ مِنَ  الْمَدِينَةِ  حَتَّى تَدْخُلَ  الْحِيرَةَ  ،  لَا تَخَافُ أَحَدًا إِلَّا اللهَ عَزَّ وَجَلَّ  .","","Al-Mu'jam al-Kabir 1880","","جابر بن سمرة السوائي عن عبد الملك بن عمير القبطي عن أبو بكر بن عياش عن الشاذكوني عن أحمد بن سليمان بن يوسف الفابزاني عن الطبراني","عبد الملك بن عمير عن جابر بن سمرة"
"1879","1881  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْفَسَوِيُّ  ، ثَنَا  عَبْدُ الْجَبَّارِ بْنُ عَاصِمٍ ، (  ح  )  وَحَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عُبَيْدِ اللهِ الْحَلَبِيُّ ، قَالَا :  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  عَبْدِ الْمَلِكِ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ،  أَنَّ  رَجُلًا  سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ أُصَلِّي فِي الثَّوْبِ الَّذِي أُجَامِعُ فِيهِ ؟ قَالَ :  نَعَمْ ، إِلَّا أَنْ تَرَى فِيهِ شَيْئًا فَتَغْسِلَهُ  .","","Al-Mu'jam al-Kabir 1881","","جابر بن سمرة السوائي عن عبد الملك بن عمير القبطي عن عبيد الله بن عمرو بن أبي الوليد عن عبد الرحمن بن عبيد الله بن حكيم الأسدي عن عبد الله بن أحمد الجواليقي عن الطبراني","عبد الملك بن عمير عن جابر بن سمرة"
"1880","مَعْبَدٌ الْجَدَلِيُّ  عَنْ  جَابِرِ بْنِ سَمُرَةَ  1882  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  عَاصِمُ بْنُ عُمَرَ بْنِ عَلِيٍّ الْمُقَدَّمِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  فِطْرٌ ،  عَنْ  أَبِي خَالِدٍ الْوَالِبِيِّ ، وَمَعْبَدٍ الْجَدَلِيِّ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَزَالُ هَذَا الْأَمْرُ ظَاهِرًا لَا يَضُرُّهُ مَنْ نَاوَأَهُ  .","","Al-Mu'jam al-Kabir 1882","","جابر بن سمرة السوائي عن معبد بن خالد بن مزين الجدلي عن فطر بن خليفة عن عمر بن علي بن عطاء عن عاصم بن عمر بن علي المقدمي عن عبد الله بن أحمد بن حنبل عن الطبراني","معبد الجدلي عن جابر بن سمرة"
"1881","الْمُسَيِّبُ بْنُ رَافِعٍ  عَنْ  جَابِرِ بْنِ سَمُرَةَ  1883  -  حَدَّثَنَا  أَبُو زَيْدٍ الْحَوْطِيُّ  ، ثَنَا  عَبْدُ الْوَهَّابِ بْنُ نَجْدَةَ الْحَوْطِيُّ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  جَعْفَرِ بْنِ الْحَارِثِ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ هَذَا الْأَمْرَ لَا يَزَالُ ظَاهِرًا لَا         [2/216]      يَضُرُّهُ مَنْ خَالَفَهُ  حَتَّى يَقُومَ اثْنَا عَشَرَ أَمِيرًا كُلُّهُمْ مِنْ  قُرَيْشٍ  .","","Al-Mu'jam al-Kabir 1883","","جابر بن سمرة السوائي عن المسيب بن رافع الكاهلي عن العوام بن حوشب عن جعفر بن الحارث الواسطي عن إسماعيل بن عياش الأحول عن عبد الوهاب بن نجدة عن أحمد بن عبد الرحيم بن يزيد الحوطي عن الطبراني","المسيب بن رافع عن جابر بن سمرة"
"1882","سِمَاكُ بْنُ حَرْبٍ  عَنْ  جَابِرِ بْنِ سَمُرَةَ  سُفْيَانُ الثَّوْرِيُّ  عَنْ  سِمَاكٍ  1884  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ الرَّقِّيُّ ،  ثَنَا  قَبِيصَةُ ،  ثَنَا  سُفْيَانُ ، (  ح  )  وَحَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ، قَالَ :  سَمِعْتُ  جَابِرَ بْنَ سَمُرَةَ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، "" يَجْلِسُ بَيْنَ الْخُطْبَتَيْنِ يَوْمَ الْجُمُعَةِ وَيَخْطُبُ قَائِمًا  ، وَكَانَتْ صَلَاتُهُ  قَصْدًا  وَخُطْبَتُهُ  قَصْدًا ،  وَيَقْرَأُ آيَاتٍ مِنَ الْقُرْآنِ عَلَى الْمِنْبَرِ  .","","Al-Mu'jam al-Kabir 1884","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سفيان الثوري عن سماك"
"1883","1885  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" يَجْلِسُ فِي مُصَلَّاهُ إِذَا طَلَعَ الْفَجْرُ  حَتَّى تَطْلُعَ الشَّمْسُ حَسْنَاءَ  .","","Al-Mu'jam al-Kabir 1885","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سفيان الثوري عن سماك"
"1884","شُعْبَةُ بْنُ الْحَجَّاجِ  عَنْ  سِمَاكٍ  1886  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ، قَالَ :  سَأَلْتُ  جَابِرَ بْنَ سَمُرَةَ ، عَنْ خُطْبَةِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  كَانَ يَخْطُبُ قَائِمًا ثُمَّ يَقْعُدُ قَعْدَةً ثُمَّ يَقُومُ  .","","Al-Mu'jam al-Kabir 1886","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","شعبة بن الحجاج عن سماك"
"1885","1887  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ، قَالَ :  سَمِعْتُ  جَابِرَ بْنَ سَمُرَةَ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" يَخْطُبُ قَائِمًا ثُمَّ يَقْعُدُ قَعْدَةً ثُمَّ يَقُومُ  .","","Al-Mu'jam al-Kabir 1887","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن أحمد بن عمرو بن حفص القريعي عن الطبراني","شعبة بن الحجاج عن سماك"
"1886","1888  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  شُعْبَةُ ،  عَنْ         [2/217]      سِمَاكِ بْنِ حَرْبٍ ، قَالَ :  سَأَلْتُ  جَابِرَ بْنَ سَمُرَةَ مَا كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَصْنَعُ إِذَا صَلَّى الصُّبْحَ ؟ قَالَ :  كَانَ يَجْلِسُ فِي مَجْلِسِهِ حَتَّى تَطْلُعَ الشَّمْسُ  .","","Al-Mu'jam al-Kabir 1888","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","شعبة بن الحجاج عن سماك"
"1887","1889  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْحَسَنِ الْعَطَّارُ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  ثَنَا  أَبِي  ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي دَارِ  أَبِي أَيُّوبَ  ، فَكَانَ إِذَا أُتِيَ بِالطَّعَامِ فَأَكَلَ مِنْهُ أَرْسَلَ بِفَضْلِهِ إِلَى  أَبِي أَيُّوبَ  ، فَأُتِيَ بِطَعَامٍ وَفِيهِ ثُومٌ فَلَمْ يَأْكُلْ مِنْهُ ، وَأَرْسَلَ بِهِ إِلَى  أَبِي أَيُّوبَ  فَلَمْ يَأْكُلْ مِنْهُ  أَبُو أَيُّوبَ  ، إِذْ لَمْ يَرَ فِيهِ أَثَرَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ أَتَاهُ فَسَأَلَهُ عَنْهُ ، فَقَالَ : يَا رَسُولَ اللهِ أَحَرَامٌ هُوَ ؟ قَالَ :  لَا وَلَكِنْ كَرِهْتُهُ مِنْ أَجْلِ الرِّيحِ  ، قَالَ : فَإِنِّي أَكْرَهُ مَا كَرِهْتَ  .","","Al-Mu'jam al-Kabir 1889","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن سليمان بن الحسن العطار عن الطبراني","شعبة بن الحجاج عن سماك"
"1888","1890  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْحَسَنِ الْعَطَّارُ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  سَمِعَ  جَابِرَ بْنَ سَمُرَةَ ، قَالَ :  كَانَتْ شَيْبُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا  سَرَّحَ  لِحْيَتَهُ  ،  أَظُنُّهُ قَالَ وَدَهَنَهَا  ، لَمْ يَتَبَيَّنْ ، وَإِذَا تَرَكَهَا تَبَيَّنَ  .","","Al-Mu'jam al-Kabir 1890","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن سليمان بن الحسن العطار عن الطبراني","شعبة بن الحجاج عن سماك"
"1889","1891  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْحَسَنِ الْعَطَّارُ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  ثَنَا  أَبِي  ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ، قَالَ :  سَمِعَ  جَابِرَ بْنَ سَمُرَةَ ، يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَبْرَحُ هَذَا الدِّينُ قَائِمًا يُقَاتِلُ عَلَيْهِ عِصَابَةٌ مِنَ الْمُسْلِمِينَ  حَتَّى تَقُومَ السَّاعَةُ  .","","Al-Mu'jam al-Kabir 1891","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن سليمان بن الحسن العطار عن الطبراني","شعبة بن الحجاج عن سماك"
"1890","1892  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  شُعْبَةَ ، (  ح  )  وَحَدَّثَنَا  سُلَيْمَانُ بْنُ الْحَسَنِ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  ثَنَا  أَبِي  ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ، قَالَ :  سَمِعْتُ  جَابِرَ بْنَ سَمُرَةَ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  سُمِّيَ  الْمَدِينَةُ  طَابَةَ  .","","Al-Mu'jam al-Kabir 1892","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن سليمان بن الحسن العطار عن الطبراني","شعبة بن الحجاج عن سماك"
"1891","[2/218]      1893  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  أَبُو الْخَطَّابِ زِيَادُ بْنُ يَحْيَى ،  ثَنَا  أَبُو دَاوُدَ الطَّيَالِسِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَقْرَأُ  فِي الظُّهْرِ         {      وَاللَّيْلِ إِذَا يَغْشَى         }      ،         {      وَالشَّمْسِ وَضُحَاهَا         }      وَنَحْوِهَا وَيَقْرَأُ فِي الصُّبْحِ بِأَطْوَلَ مِنْ ذَلِكَ  .","","Al-Mu'jam al-Kabir 1893","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن أبو داود الطيالسي عن زياد بن يحيى الحساني عن محمد بن صالح النرسي عن الطبراني","شعبة بن الحجاج عن سماك"
"1892","1894  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْحَسَنِ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  ثَنَا  أَبِي  ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ،  سَمِعَ  جَابِرَ بْنَ سَمُرَةَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا دَحَضَتِ الشَّمْسُ صَلَّى الظُّهْرَ  وَقَرَأَ بِنَحْوٍ مِنَ اللَّيْلِ إِذَا يَغْشَى ، وَالْعَصْرِ كَذَلِكَ ، وَالصَّلَوَاتِ كَذَلِكَ إِلَّا الصُّبْحَ فَإِنَّهُ يُطِيلُهَا  .","","Al-Mu'jam al-Kabir 1894","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن سليمان بن الحسن العطار عن الطبراني","شعبة بن الحجاج عن سماك"
"1893","1895  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى ،  عَنْ  شُعْبَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي الظُّهْرَ حِينَ  تَدْحَضُ  الشَّمْسُ  ، يَعْنِي حِينَ تَزُولُ ، وَيُصَلِّي الْعَصْرَ نَحْوًا مِنْ صَلَاتِكُمْ  .","","Al-Mu'jam al-Kabir 1895","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","شعبة بن الحجاج عن سماك"
"1894","1896  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ الْأَنْمَاطِيُّ ،  ثَنَا  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَكُونُ اثْنَا عَشَرَ أَمِيرًا  ، ثُمَّ قَالَ كَلِمَةً لَمْ أَفْهَمْهَا ، فَقَالَ  الْقَوْمُ  : قَالَ : "" كُلُّهُمْ مِنْ  قُرَيْشٍ  .","","Al-Mu'jam al-Kabir 1896","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن يحيى بن معين عن محمد بن الحسين الأنماطي عن الطبراني","شعبة بن الحجاج عن سماك"
"1895","1897  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْحَسَنِ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  ثَنَا  أَبِي  ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  أَنَّهُ سَمِعَ  جَابِرَ بْنَ سَمُرَةَ ، يَقُولُ :  أُتِيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِرَجُلٍ  أَشْعَرَ  قَصِيرٍ ذِي  عَضَلَاتٍ  أَقَرَّ بِالزِّنَا فَرَدَّهُ مَرَّتَيْنِ ثُمَّ أَمَرَ بِهِ فَرُجِمَ وَقَالَ :  أَكُلَّمَا نَفَرْنَا غَازِينَ فِي  سَبِيلِ  اللهِ يَتَخَلَّفُ أَحَدُكُمْ يَنِبُّ نَبِيبَ التَّيْسِ يَمْنَحُ إِحْدَاهُنَّ  الْكُثْبَةَ  ، أَمَا إِنِّي لَنْ أُوتِيَ بِأَحَدٍ مِنْكُمْ فَعَلَ هَذَا إِلَّا جَعَلْتُهُ نَكَالًا ، وَرُبَّمَا قَالَ  سِمَاكٌ  : إِلَّا نَكَّلْتُهُ  .","","Al-Mu'jam al-Kabir 1897","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن سليمان بن الحسن العطار عن الطبراني","شعبة بن الحجاج عن سماك"
"1896","1898  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، حَدَّثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى ،  عَنْ  شُعْبَةَ ،  عَنْ         [2/219]      سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ بَيْنَ يَدَيِ السَّاعَةِ كَذَّابِينَ  .","","Al-Mu'jam al-Kabir 1898","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","شعبة بن الحجاج عن سماك"
"1897","1899  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، (  ح  )  وَحَدَّثَنَا  سُلَيْمَانُ بْنُ الْحَسَنِ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  ثَنَا  أَبِي  ، قَالَا :  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ،  سَمِعَ  جَابِرَ بْنَ سَمُرَةَ ، قَالَ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى  ابْنِ الدَّحْدَاحِ  وَنَحْنُ شُهُودٌ ثُمَّ أُتِيَ بِفَرَسٍ فَعُقِلَ حَتَّى رَكِبَهُ فَجَعَلَ  يَتَوَقَّصُ  بِهِ وَنَحْنُ نَسْعَى حَوْلَهُ ، فَقَالَ رَجُلٌ عِنْدَ  جَابِرِ بْنِ سَمُرَةَ  : إِنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  كَمْ مِنْ  عِذْقٍ  لِابْنِ الدَّحْدَاحِ  مُعَلَّقٍ فِي الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 1899","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن سليمان بن الحسن العطار عن الطبراني","شعبة بن الحجاج عن سماك"
"1898","1900  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو دَاوُدَ الطَّيَالِسِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي جِنَازَةِ  ابْنِ الدَّحْدَاحِ  وَهُوَ عَلَى فَرَسٍ وَهُوَ يَتَهَوَّدُ بِهِ  .","","Al-Mu'jam al-Kabir 1900","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن أبو داود الطيالسي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","شعبة بن الحجاج عن سماك"
"1899","1901  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  الْأَسْوَدُ بْنُ عَامِرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَمْ مِنْ  عِذْقٍ  لِابْنِ الدَّحْدَاحِ  فِي الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 1901","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن الأسود بن عامر شاذان عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","شعبة بن الحجاج عن سماك"
"1900","1902  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْحَسَنِ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  ثَنَا  أَبِي  ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ،  سَمِعَ  جَابِرَ بْنَ سَمُرَةَ ، سَمِعَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَتَفْتَحَنَّ كَنْزَ  آلِ كِسْرَى  الْأَبْيَضِ ، أَوْ قَالَ : الَّذِي فِي الْأَبْيَضِ  ،  عِصَابَةٌ مِنَ الْمُسْلِمِينَ  .","","Al-Mu'jam al-Kabir 1902","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن سليمان بن الحسن العطار عن الطبراني","شعبة بن الحجاج عن سماك"
"1901","1903  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْحَسَنِ بْنِ شَقِيقٍ ،  ثَنَا  عَبْدَانُ بْنُ عُثْمَانَ ،  ثَنَا  أَبِي  ،  عَنْ  شُعْبَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ رَضِيَ اللهُ عَنْهُ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَشْكَلَ         [2/220]      الْعَيْنَيْنِ  ،  قَالَ  شُعْبَةُ  :  قُلْتُ  لِسِمَاكٍ  : مَا  أَشْكَلُ  الْعَيْنَيْنِ ؟ قَالَ : "" باذام جشم  "" .","","Al-Mu'jam al-Kabir 1903","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن عثمان بن جبلة عن عبد الله بن عثمان بن جبلة عن محمد بن علي بن الحسن بن شقيق المطوعي عن عبد الله بن أحمد بن حنبل عن الطبراني","شعبة بن الحجاج عن سماك"
"1902","1904  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، وَسُلَيْمَانُ بْنُ الْحَسَنِ ، قَالَا :  ثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  ثَنَا  أَبِي  ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ، قَالَ :  سَأَلْتُ  جَابِرَ بْنَ سَمُرَةَ عَنْ صِفَةِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  كَانَ  أَشْكَلَ  الْعَيْنَيْنِ ،  ضَلِيعَ  الْفَمِ ،  مَنْهُوسَ  الْعَقِبِ  .","","Al-Mu'jam al-Kabir 1904","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن سليمان بن الحسن العطار عن الطبراني","شعبة بن الحجاج عن سماك"
"1903","1905  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو دَاوُدَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرٍ : "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ  يَقْرَأُ  فِي الظُّهْرِ بِـ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      ،  وَفِي الصُّبْحِ بِأَطْوَلَ مِنْ ذَلِكَ  .","","Al-Mu'jam al-Kabir 1905","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن أبو داود الطيالسي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","شعبة بن الحجاج عن سماك"
"1904","1906  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَ :  وَجَدْتُ فِي كِتَابِ  أَبِي بِخَطِّهِ  قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اطْلُبُوا لَيْلَةَ الْقَدْرِ فِي الْعَشْرِ الْأَوَاخِرِ مِنْ رَمَضَانَ  .","","Al-Mu'jam al-Kabir 1906","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن إبراهيم بن عثمان أبو شيبة العبسي عن أبو بكر ابن أبي شيبة عن عبد الله بن أحمد بن حنبل عن الطبراني","شعبة بن الحجاج عن سماك"
"1905","1907  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْمَعِيبِيُّ الْأَصْبَهَانِيُّ ،  ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  شُعْبَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنِّي لَأَعْرِفُ حَجَرًا كَانَ يُسَلِّمُ عَلَيَّ قَبْلَ أَنْ أُبْعَثَ إِنِّي لَأَعْرِفُهُ  .","","Al-Mu'jam al-Kabir 1907","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن يحيى القطان عن زيد بن الحريش الأهوزاي عن أحمد بن محمد بن سعيد الأصبهاني عن الطبراني","شعبة بن الحجاج عن سماك"
"1906","1908  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ  ، ثَنَا  مُعَاذُ بْنُ أَسَدٍ ،  ثَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَبَيْنَ كَتِفَيْهِ مِثْلُ بَيْضَةِ الْحَمَامَةِ  ، خَاتَمُ النُّبُوَّةِ  .","","Al-Mu'jam al-Kabir 1908","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن النضر بن شميل عن معاذ بن أسد الغنوي عن محمد بن محمد بن حيان التمار عن الطبراني","شعبة بن الحجاج عن سماك"
"1907","[2/221]      1909  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عِيسَى بْنِ شَيْبَةَ الْمِصْرِيُّ  ، ثَنَا  أَحْمَدُ بْنُ سَيَّارٍ الْمَرْوَزِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُثْمَانَ ،  أَنَا  أَبِي  ،  عَنْ  شُعْبَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ :  كَانَ الصِّبْيَانُ يَمُرُّونَ بِالنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَمِنْهُمْ مَنْ يَمْسَحُ خَدَّهُ  وَمِنْهُمْ مَنْ يَمْسَحُ خَدَّيْهِ ، فَمَرَرْتُ بِهِ فَمَسَحَ خَدِّي قَالَ : فَكَانَ الْخَدُّ الَّذِي مَسَحَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَحْسَنَ مِنَ الْخَدِّ الْآخَرِ  .","","Al-Mu'jam al-Kabir 1909","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن عثمان بن جبلة عن عبد الله بن عثمان بن جبلة عن أحمد بن سيار المروزي عن محمد بن عيسى بن شيبة السدوسي عن الطبراني","شعبة بن الحجاج عن سماك"
"1908","1910  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ  ، ثَنَا  أَحْمَدُ بْنُ سَهْلِ بْنِ عَلِيٍّ الْبَاهِلِيُّ ،  حَدَّثَنَا  صِلَةُ بْنُ سُلَيْمَانَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كَانَ أَصْحَابُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَتَنَاشَدُونَ الشِّعْرَ  وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَسْمَعُ  .","","Al-Mu'jam al-Kabir 1910","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن صلة بن سليمان الواسطي عن أحمد بن سهل بن علي الباهلي عن بحشل عن الطبراني","شعبة بن الحجاج عن سماك"
"1909","إِسْرَائِيلُ بْنُ يُونُسَ  عَنْ  سِمَاكٍ  1911  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  سِمَاكٍ ، قَالَ :  سَمِعْتُ  جَابِرَ بْنَ سَمُرَةَ ، يَقُولُ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْطُبُ يَوْمَ الْجُمُعَةِ قَائِمًا  ، ثُمَّ يَقْعُدُ فَلَا يَتَكَلَّمُ ثُمَّ يَقُومُ فَيَخْطُبُ خُطْبَةً أُخْرَى ، فَمَنْ حَدَّثَكَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَطَبَ قَاعِدًا فَقَدْ كَذَبَ  .","","Al-Mu'jam al-Kabir 1911","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","إسرائيل بن يونس عن سماك"
"1910","1912  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كَانَ  مُؤَذِّنُ رَسُولِ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُؤَذِّنُ  ، ثُمَّ يُمْهِلُ فَلَا يُقِيمُ حَتَّى إِذَا رَأَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ خَرَجَ أَقَامَ الصَّلَاةَ حِينَ يَرَاهُ  .","","Al-Mu'jam al-Kabir 1912","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","إسرائيل بن يونس عن سماك"
"1911","1913  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  سِمَاكٍ ، قَالَ :  سَمِعْتُ  جَابِرَ بْنَ سَمُرَةَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا صَلَّى الْغَدَاةَ قَعَدَ فِي مَجْلِسِهِ  حَتَّى تَطْلُعَ الشَّمْسُ  .","","Al-Mu'jam al-Kabir 1913","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","إسرائيل بن يونس عن سماك"
"1912","[2/222]      1914  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  سِمَاكٍ ،  أَنَّهُ سَمِعَ  جَابِرَ بْنَ سَمُرَةَ ، يَقُولُ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي الصَّلَوَاتِ كَنَحْوٍ مِنْ صَلَاتِكُمُ الَّتِي تُصَلُّونَ الْيَوْمَ  ، وَلَكِنَّهُ كَانَ يُخَفِّفُ ، كَانَتْ صَلَاتُهُ أَخَفَّ مِنْ صَلَاتِكُمْ ، كَانَ يَقْرَأُ فِي الْفَجْرِ الْوَاقِعَةَ وَنَحْوَهَا مِنَ السُّوَرِ  .","","Al-Mu'jam al-Kabir 1914","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","إسرائيل بن يونس عن سماك"
"1913","1915  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلَطِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيَفْتَحَنَّ رَهْطٌ مِنَ الْمُسْلِمِينَ كُنُوزَ  كِسْرَى  .","","Al-Mu'jam al-Kabir 1915","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","إسرائيل بن يونس عن سماك"
"1914","1916  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ  ، ثَنَا  آدَمُ بْنُ أَبِي إِيَاسٍ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ""  كَثَّ  الشَّعَرِ وَاللِّحْيَةِ  .","","Al-Mu'jam al-Kabir 1916","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن آدم بن أبي إياس عن أبو زرعة الدمشقي عن الطبراني","إسرائيل بن يونس عن سماك"
"1915","1917  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  سِمَاكٍ ، قَالَ :  سَمِعْتُ  جَابِرَ بْنَ سَمُرَةَ ، يَقُولُ :  أُتِيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِمَاعِزِ بْنِ مَالِكٍ  رَجُلٍ قَصِيرٍ فِي إِزَارٍ مَا عَلَيْهِ رِدَاءٌ ، فَكَلَّمَهُ ، وَمَا أَدْرِي مَا يُكَلِّمُهُ وَأَنَا بَعِيدٌ مِنْهُ ، وَبَيْنِي وَبَيْنَهُ  الْقَوْمُ  ، فَقَالَ : "" اذْهَبُوا بِهِ "" ، ثُمَّ قَالَ : "" رُدُّوهُ "" فَكَلَّمَهُ وَأَنَا أَسْمَعُ غَيْرَ أَنَّ بَيْنِي وَبَيْنَهُ  الْقَوْمَ  ، ثُمَّ قَالَ : "" اذْهَبُوا بِهِ فَارْجُمُوهُ "" ثُمَّ قَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَخَطَبَ وَأَنَا أَسْمَعُهُ ، فَقَالَ :  كُلَّمَا نَفَرْنَا فِي  سَبِيلِ  اللهِ  خَلَفَ  أَحَدُهُمْ لَهُ نَبِيبٌ  كَنَبِيبِ  التَّيْسِ يَمْنَحُ إِحْدَاهُنَّ  الْكُثْبَةَ  مِنَ اللَّبَنِ  ، وَاللهِ لَا أَقْدُمُ عَلَى أَحَدٍ مِنْهُمْ إِلَّا نَكَّلْتُ بِهِ  .","","Al-Mu'jam al-Kabir 1917","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","إسرائيل بن يونس عن سماك"
"1916","1918  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرٍ ، قَالَ :  رَأَيْتُ الْخَاتَمَ عِنْدَ كَتِفِهِ مِثْلَ بَيْضَةِ الْحَمَامَةِ يُشْبِهُ جِلْدَهُ  .","","Al-Mu'jam al-Kabir 1918","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","إسرائيل بن يونس عن سماك"
"1917","[2/223]      1919  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ :  أَنَّهُمْ دَخَلُوا عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ مُتَّكِئٌ  عَلَى وِسَادَةٍ عَنْ يَسَارِهِ  .","","Al-Mu'jam al-Kabir 1919","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","إسرائيل بن يونس عن سماك"
"1918","1920  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ، (  ح  )  وَثَنَا  يُوسُفُ الْقَاضِي  ، حَدَّثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  أَنَّهُ سَمِعَ  جَابِرَ بْنَ سَمُرَةَ ، يَقُولُ :  مَاتَ  رَجُلٌ  عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَتَاهُ  رَجُلٌ  ، فَقَالَ : يَا رَسُولَ اللهِ قَدْ مَاتَ فُلَانٌ ، قَالَ : "" لَمْ يَمُتْ "" ثُمَّ أَتَاهُ الثَّانِيَةَ ثُمَّ الثَّالِثَةَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" كَيْفَ مَاتَ ؟ "" قَالَ :  نَحَرَ نَفْسَهُ  بِمِشْقَصٍ  كَانَ عِنْدَهُ ، فَلَمْ يُصَلِّ عَلَيْهِ  .","","Al-Mu'jam al-Kabir 1920","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","إسرائيل بن يونس عن سماك"
"1919","1921  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  خَلَفُ بْنُ الْوَلِيدِ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ :  مَا كَانَ فِي رَأْسِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَلِحْيَتِهِ مِنَ الشَّيْبِ إِلَّا شَعَرَاتٌ فِي مَفْرِقِ رَأْسِهِ  ، إِذَا  سَرَّحَ  لِحْيَتَهُ وَدَهَنَ تَبَيَّنَ ، وَإِذَا تَرَكَهَا لَمْ يَتَبَيَّنْ  .","","Al-Mu'jam al-Kabir 1921","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن خلف بن الوليد الجوهري عن بشر بن موسى بن صالح الأسدي عن الطبراني","إسرائيل بن يونس عن سماك"
"1920","1922  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  خَلَفُ بْنُ الْوَلِيدِ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَبْرَحُ هَذَا الدِّينُ قَائِمًا يُقَاتِلُ عَلَيْهِ عِصَابَةٌ مِنَ الْمُسْلِمِينَ  حَتَّى تَقُومَ السَّاعَةُ  .","","Al-Mu'jam al-Kabir 1922","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن خلف بن الوليد الجوهري عن بشر بن موسى بن صالح الأسدي عن الطبراني","إسرائيل بن يونس عن سماك"
"1921","1923  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  خَلَفُ بْنُ الْوَلِيدِ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَكُونُ بَعْدِي اثْنَا عَشَرَ أَمِيرًا  ثُمَّ تَكَلَّمَ بِشَيْءٍ لَمْ أَفْهَمْهُ فَسَأَلْتُ  الْقَوْمَ  ، فَقَالُوا : "" كُلُّهُمْ مِنْ  قُرَيْشٍ  .","","Al-Mu'jam al-Kabir 1923","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن خلف بن الوليد الجوهري عن بشر بن موسى بن صالح الأسدي عن الطبراني","إسرائيل بن يونس عن سماك"
"1922","1924  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  خَلَفٌ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ :  مَاتَ جَمَلٌ  بِالْحَرَّةِ  وَإِلَى جَنْبِهِ قَوْمٌ مُحْتَاجُونَ  ، فَرَخَّصَ لَهُمُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي أَكْلِهِ  .","","Al-Mu'jam al-Kabir 1924","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن خلف بن الوليد الجوهري عن بشر بن موسى بن صالح الأسدي عن الطبراني","إسرائيل بن يونس عن سماك"
"1923","[2/224]      1925  -  وَعَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الصُّبْحَ فَجَعَلَ يَنْتَهِرُ شَيْئًا قُدَّامَهُ ، فَلَمَّا انْصَرَفَ سَأَلْنَاهُ ، فَقَالَ :  ذَاكَ شَيْطَانٌ أَلْقَى عَلَى قَدَمَيَّ شَرَرًا مِنَ النَّارِ لِيَفْتِنَنِي عَنِ الصَّلَاةِ  وَلَوْ أَخَذْتُهُ  لَنِيطَ  إِلَى سَارِيَةٍ مِنْ  سَوَارِي  الْمَسْجِدِ حَتَّى يُطِيفَ بِهِ وِلْدَانُ  أَهْلِ الْمَدِينَةِ  .","","Al-Mu'jam al-Kabir 1925","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن خلف بن الوليد الجوهري عن بشر بن موسى بن صالح الأسدي عن الطبراني","إسرائيل بن يونس عن سماك"
"1924","1926  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  عَلِيُّ بْنُ مُحَمَّدٍ الطَّنَافِسِيُّ ،  ثَنَا  وَكِيعٌ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  قَالَ  :  قِيلَ لِجَابِرٍ : أَكَانَ وَجْهُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَ السَّيْفِ  ؟ قَالَ : "" لَا ، بَلْ مِثْلَ الشَّمْسِ وَالْقَمَرِ  .","","Al-Mu'jam al-Kabir 1926","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن وكيع بن الجراح عن علي بن محمد الطنافسي عن علي بن سعيد بن بشير عليك عن الطبراني","إسرائيل بن يونس عن سماك"
"1925","زَائِدَةُ بْنُ قُدَامَةَ  عَنْ  سِمَاكٍ  1927  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ، (  ح  )  وَثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ  ، ثَنَا  أَبُو الْوَلِيدِ ، قَالَا :  ثَنَا  زَائِدَةُ ،  ثَنَا  سِمَاكُ بْنُ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" إِذَا صَلَّى الْفَجْرَ يَقْعُدُ فِي مَجْلِسِهِ  حَتَّى تَطْلُعَ الشَّمْسُ  .","","Al-Mu'jam al-Kabir 1927","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زائدة بن قدامة عن أبو الوليد الطيالسي عن محمد بن محمد بن حيان التمار عن الطبراني","زائدة بن قدامة عن سماك"
"1926","1928  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  سِمَاكُ بْنُ حَرْبٍ ، قَالَ :  قَالَ  جَابِرُ بْنُ سَمُرَةَ :  كَانَتْ صَلَاةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَخُطْبَتُهُ  قَصْدًا  .","","Al-Mu'jam al-Kabir 1928","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","زائدة بن قدامة عن سماك"
"1927","1929  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ، (  ح  )  وَحَدَّثَنَا  أَبُو خَلِيفَةَ ، وَمُحَمَّدُ بْنُ إِبْرَاهِيمَ الطَّيَالِسِيُّ ، قَالَا :  ثَنَا  أَبُو الْوَلِيدِ ،  ثَنَا         [2/225]      زَائِدَةُ ، (  ح  )  وَحَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" يَقْرَأُ فِي صَلَاةِ الْفَجْرِ  بِـ         {      ق             *          وَالْقُرْآنِ الْمَجِيدِ         }      وَكَانَتْ صَلَاتُهُ بَعْدُ تَخْفِيفًا  .","","Al-Mu'jam al-Kabir 1929","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","زائدة بن قدامة عن سماك"
"1928","1930  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ النَّضْرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  سِمَاكُ بْنُ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  مَا رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْطُبُ قَطُّ فِي الْجُمُعَةِ إِلَّا قَائِمًا  ، فَمَنْ حَدَّثَكَ أَنَّهُ جَلَسَ فَكَذِّبْهُ فَإِنَّهُ لَمْ يَفْعَلْ  ،  قَالَ  جَابِرٌ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" يَخْطُبُ ثُمَّ يَقْعُدُ ثُمَّ يَقُومُ فَيَخْطُبُ  ، وَكَانَ يَخْطُبُ خُطْبَتَيْنِ يَقْعُدُ بَيْنَهُمَا  .","","Al-Mu'jam al-Kabir 1930","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","زائدة بن قدامة عن سماك"
"1929","1931  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  حُسَيْنُ بْنُ عَلِيٍّ الْجُعْفِيُّ ،  عَنْ  زَائِدَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَنْ يَبْرَحَ هَذَا الدِّينُ قَائِمًا يُقَاتِلُ عَلَيْهِ عِصَابَةٌ مِنَ الْمُسْلِمِينَ حَتَّى تَقُومَ السَّاعَةُ  .","","Al-Mu'jam al-Kabir 1931","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زائدة بن قدامة عن الحسين بن علي الجعفي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","زائدة بن قدامة عن سماك"
"1930","زُهَيْرُ بْنُ مُعَاوِيَةَ  عَنْ  سِمَاكٍ  1932  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلَطِيُّ ،  ثَنَا  أَبُو نُعَيْمٍ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ، قَالَا :  ثَنَا  زُهَيْرُ بْنُ مُعَاوِيَةَ ،  ثَنَا  سِمَاكُ بْنُ حَرْبٍ ،  حَدَّثَنِي  جَابِرُ بْنُ سَمُرَةَ ، قَالَ :  مَرِضَ  رَجُلٌ  فَصِيحَ عَلَيْهِ ، فَجَاءَ جَارُهُ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنَّهُ قَدْ مَاتَ ، فَقَالَ :  مَا يُدْرِيكَ ؟ "" قَالَ : أَنَا رَأَيْتُهُ يَا رَسُولَ اللهِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِنَّهُ لَمْ يَمُتْ  فَرَجَعَ الرَّجُلُ فَصِيحَ عَلَيْهِ ، فَقَالَتِ امْرَأَتُهُ : انْطَلِقْ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَخْبِرْهُ ، فَقَالَ  الرَّجُلُ  : اللَّهُمَّ الْعَنْهُ ، قَالَ : ثُمَّ انْطَلَقَ الرَّجُلُ فَرَآهُ قَدْ نَحَرَ نَفْسَهُ بِمَشَاقِصَ مَعَهُ ، فَانْطَلَقَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَخْبَرَهُ أَنَّهُ قَدْ مَاتَ ، قَالَ : "" مَا يُدْرِيكَ ؟ "" قَالَ : رَأَيْتُهُ نَحَرَ نَفْسَهُ بِمَشَاقِصَ مَعَهُ ، قَالَ : "" أَنْتَ رَأَيْتَهُ ؟ "" قَالَ : نَعَمْ ، قَالَ : "" إِذًا لَا أُصَلِّي عَلَيْهِ  .","","Al-Mu'jam al-Kabir 1932","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زهير بن معاوية بن حديج عن أحمد بن عبد الله اليربوعي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","زهير بن معاوية عن سماك"
"1931","[2/226]      1933  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، حَدَّثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ يُونُسَ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ، قَالُوا :  ثَنَا  زُهَيْرُ بْنُ مُعَاوِيَةَ ،  ثَنَا  سِمَاكٌ ، قَالَ :  قُلْتُ  لِجَابِرِ بْنِ سَمُرَةَ : أَكُنْتَ تُجَالِسُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : نَعَمْ كَثِيرًا ،  كَانَ "" لَا يَقُومُ مِنْ مُصَلَّاهُ الَّذِي يُصَلِّي فِيهِ حَتَّى تَطْلُعَ الشَّمْسُ  ، فَإِذَا طَلَعَتْ قَامَ ، وَكَانَ يُطِيلُ الصَّمْتَ ، وَكَانُوا يَتَحَدَّثُونَ فَيَأْخُذُونَ فِي أَمْرِ الْجَاهِلِيَّةِ فَيَضْحَكُونَ وَيَبْتَسِمُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 1933","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","زهير بن معاوية عن سماك"
"1932","1934  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  سِمَاكٌ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ : "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَخْطُبُ قَائِمًا ثُمَّ يَجْلِسُ ثُمَّ يَقُومُ فَيَخْطُبُ قَائِمًا  ، فَمَنْ نَبَّأَكَ أَنَّهُ يَخْطُبُ جَالِسًا أَوْ قَاعِدًا فَقَدْ كَذَبَ ، فَقَدْ وَاللهِ صَلَّيْتُ مَعَهُ أَكْثَرَ مِنْ أَلْفَيْ مَرَّةٍ  .","","Al-Mu'jam al-Kabir 1934","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","زهير بن معاوية عن سماك"
"1933","1935  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  سِمَاكٌ ، قَالَ :  سَمِعْتُ  جَابِرَ بْنَ سَمُرَةَ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ بَيْنَ يَدَيِ السَّاعَةِ كَذَّابِينَ  ، قُلْتُ  لِجَابِرٍ  : أَنْتَ سَمِعْتَهُ ؟ قَالَ : أَنَا سَمِعْتُهُ .","","Al-Mu'jam al-Kabir 1935","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","زهير بن معاوية عن سماك"
"1934","1936  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  سِمَاكٌ ، قَالَ :  سَمِعْتُ  جَابِرَ بْنَ سَمُرَةَ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَكُونُ بَعْدِي اثْنَا عَشَرَ أَمِيرًا  ثُمَّ تَكَلَّمَ بِشَيْءٍ لَمْ أَفْهَمْهُ ، فَسَأَلْتُ  الْقَوْمَ  كُلَّهُمْ ، فَقَالُوا : قَالَ : "" كُلُّهُمْ مِنْ  قُرَيْشٍ  .","","Al-Mu'jam al-Kabir 1936","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","زهير بن معاوية عن سماك"
"1935","1937  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  سِمَاكٌ ، قَالَ :  سَأَلْتُ  جَابِرَ بْنَ سَمُرَةَ عَنْ صَلَاةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  كَانَ يَخِفُّ بِهِمْ وَلَا يُصَلِّي صَلَاةَ هَؤُلَاءِ  .","","Al-Mu'jam al-Kabir 1937","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","زهير بن معاوية عن سماك"
"1936","[2/227]      1938  -  ثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  سِمَاكٌ ،  حَدَّثَنِي  جَابِرُ بْنُ سَمُرَةَ : "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَقْرَأُ فِي الْفَجْرِ بِـ         {      ق             *          وَالْقُرْآنِ الْمَجِيدِ         }      وَنَحْوِهَا  .","","Al-Mu'jam al-Kabir 1938","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","زهير بن معاوية عن سماك"
"1937","1939  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  حَدَّثَنَا  زُهَيْرٌ ،  ثَنَا  سِمَاكٌ ، قَالَ :  سَمِعْتُ  جَابِرَ بْنَ سَمُرَةَ ، يَقُولُ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَاةَ الصُّبْحِ ، فَجَعَلَ يَنْتَهِرُ شَيْئًا قُدَّامَهُ ، فَلَمَّا انْصَرَفَ سَأَلْنَاهُ ، فَقَالَ :  ذَاكَ شَيْطَانٌ أَلْقَى عَلَى قَدَمَيَّ شَرَرًا مِنْ نَارٍ لِيَفْتِنَنِي عَنِ الصَّلَاةِ  قَالَ : "" وَقَدِ انْتَهَرْتُهُ وَلَوْ أَخَذْتُهُ  لَنِيطَ  إِلَى سَارِيَةٍ مِنْ  سَوَارِي  الْمَسْجِدِ حَتَّى يُطِيفَ بِهِ وِلْدَانُ  أَهْلِ الْمَدِينَةِ  .","","Al-Mu'jam al-Kabir 1939","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","زهير بن معاوية عن سماك"
"1938","1940  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  سِمَاكٌ ،  حَدَّثَنِي  جَابِرُ بْنُ سَمُرَةَ ، قَالَ :  كَانَ يُهْدَى لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْقِصَاعُ وَهُوَ فِي دَارِ  أَبِي أَيُّوبَ  ، فَكَانَ يَبْعَثُ إِلَيْهِ فَضْلَ مَا يَأْكُلُ ، فَأَتَتْهُ قَصْعَةٌ فَأَرْسَلَ بِهَا كَمَا هِيَ لَمْ يَنْقُصْ مِنْهَا شَيْءٌ ، فَقَالَ  أَبُو أَيُّوبَ  لِأَهْلِهِ : لَا تَأْكُلُوا حَتَّى أَعْلَمَ لِمَ تَرَكَهَا ؟ قَالَ : فَاسْتَأْذَنَ عَلَيْهِ فَدَخَلَ ، فَقَالَ : لَمْ يَكُنْ يَأْتِينَا مِنْ عِنْدِكَ شَيْءٌ إِلَّا أَكَلْتَ مِنْهُ غَيْرَ هَذِهِ الْقَصْعَةِ لَا أَدْرِي مَا شَأْنُهَا ؟ قَالَ :  كَانَ فِيهَا ثُومٌ فَكَرِهْتُ رِيحَهُ ، أَمَا إِنَّهُ لَا بَأْسَ بِهِ إِلَّا أَنِّي كَرِهْتُ رِيحَهُ  قَالَ : فَإِنِّي أَكْرَهُ مَا تَكْرَهُ إِذًا ، قَالَ : "" فَأَنْتَ أَبْصَرُ  .","","Al-Mu'jam al-Kabir 1940","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","زهير بن معاوية عن سماك"
"1939","أَسْبَاطُ بْنُ نَصْرٍ الْهَمْدَانِيُّ  عَنْ  سِمَاكِ بْنِ حَرْبٍ  1941  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَمْرُو بْنُ حَمَّادِ بْنِ طَلْحَةَ الْقَنَّادُ ،  ثَنَا  أَسْبَاطُ بْنُ نَصْرٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اطْلُبُوا لَيْلَةَ الْقَدْرِ فِي الْعَشْرِ الْأَوَاخِرِ  .","","Al-Mu'jam al-Kabir 1941","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن أسباط بن نصر الهمداني عن عمرو بن حماد القناد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أسباط بن نصر الهمداني عن سماك بن حرب"
"1940","1942  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَمْرُو بْنُ حَمَّادِ بْنِ طَلْحَةَ الْقَنَّادُ ،         [2/228]      حَدَّثَنَا  أَسْبَاطُ بْنُ نَصْرٍ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ : "" عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ صَلَّى فِي يَوْمِ عِيدٍ بِلَا أَذَانٍ وَلَا إِقَامَةٍ  .","","Al-Mu'jam al-Kabir 1942","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن أسباط بن نصر الهمداني عن عمرو بن حماد القناد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أسباط بن نصر الهمداني عن سماك بن حرب"
"1941","1943  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَمْرُو بْنُ حَمَّادٍ ،  ثَنَا  أَسْبَاطُ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ :  لَمَّا مَاتَ  ابْنُ الدَّحْدَاحِ  تَبِعَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جِنَازَتَهُ  ، فَلَمَّا دُفِنَ وَفُرِغَ مِنْهُ أُتِيَ بِفَرَسٍ فَرَكِبَهُ فَرَجَعَ عَلَيْهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 1943","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن أسباط بن نصر الهمداني عن عمرو بن حماد القناد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أسباط بن نصر الهمداني عن سماك بن حرب"
"1942","1944  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَمْرُو بْنُ حَمَّادِ بْنِ طَلْحَةَ الْقَنَّادُ ،  ثَنَا  أَسْبَاطُ بْنُ نَصْرٍ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  صَلَّيْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْأُولَى ثُمَّ خَرَجَ إِلَى أَهْلِهِ  ، وَخَرَجْتُ مَعَهُ فَاسْتَقْبَلَهُ وِلْدَانُ  الْمَدِينَةِ  فَجَعَلَ يَمْسَحُ خَدَّيْ أَحَدِهِمْ وَاحِدًا وَاحِدًا قَالَ : وَأَوْمَى  فَمَسَحَ خَدِّي فَوَجَدْتُ لِيَدِهِ بَرْدًا وَرِيحًا كَأَنَّمَا أَخْرَجَهَا مِنْ  جُونَةِ  عَطَّارٍ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  في طبعة مكتبة ابن تيمية : ( وأما ) والمثبت من الظاهرية ( 2 ) .","","Al-Mu'jam al-Kabir 1944","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن أسباط بن نصر الهمداني عن عمرو بن حماد القناد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أسباط بن نصر الهمداني عن سماك بن حرب"
"1943","1945  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  الْفَضْلُ بْنُ أَبِي حَسَّانَ ،  ثَنَا  عَمْرُو بْنُ حَمَّادِ بْنِ طَلْحَةَ الْقَنَّادُ ،  ثَنَا  أَسْبَاطُ بْنُ نَصْرٍ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  دَخَلْتُ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَبُولُ فَسَلَّمْتُ عَلَيْهِ فَلَمْ يَرُدَّ عَلَيَّ ، ثُمَّ قَامَ فَدَخَلَ بَيْتَهُ فَتَوَضَّأَ ثُمَّ خَرَجَ إِلَيَّ ، فَقَالَ :  وَعَلَيْكُمُ السَّلَامُ وَعَلَيْكُمُ السَّلَامُ  .","","Al-Mu'jam al-Kabir 1945","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن أسباط بن نصر الهمداني عن عمرو بن حماد القناد عن الفضل بن أبي حسان الوراق عن الحسين بن إسحاق التستري عن الطبراني","أسباط بن نصر الهمداني عن سماك بن حرب"
"1944","شَرِيكُ بْنُ عَبْدِ اللهِ النَّخَعِيُّ  عَنْ  سِمَاكٍ  1946  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ جَعْفَرٍ الْقَتَّاتُ ،  ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  ابْنُ الْأَصْبَهَانِيِّ ، (  ح  )  وَحَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ  ، ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ (  ح  )         [2/229]      وَحَدَّثَنَا  أَبُو حَصِينٍ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالُوا :  ثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ :  مَاتَتْ نَاقَةٌ  بِالْحَرَّةِ  إِلَى جَنْبِهَا أَهْلُ بَيْتٍ مِنْ  بَنِي سُلَيْمٍ  مُحْتَاجُونَ  فَرَخَّصَ لَهُمُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي أَكْلِهَا ، فَكَانُوا يَأْكُلُونَ مِنْهَا شِتَاءَهُمْ فَأَذَابُوهُ  وَاللَّفْظُ لِحَدِيثِ  ابْنِ الْأَصْبَهَانِيِّ  .","","Al-Mu'jam al-Kabir 1946","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","شريك بن عبد الله النخعي عن سماك"
"1945","1947  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى ،  ثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ :  كَانَ بِلَالٌ يُؤَذِّنُ الظُّهْرَ إِذَا دَحَضَتِ الشَّمْسُ  ، وَكَانَ رُبَّمَا أَخَّرَ الْإِقَامَةَ وَلَا يُؤَخِّرُ الْأَذَانَ ""  .","","Al-Mu'jam al-Kabir 1947","","بلال بن رباح سابق الحبشة عن جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","شريك بن عبد الله النخعي عن سماك"
"1946","1948  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  جَالَسْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَكْثَرَ مِنْ مِائَةِ مَرَّةٍ فَكَانَ أَصْحَابُهُ يَتَنَاشَدُونَ الشِّعْرَ  وَيَتَذَاكَرُونَ أَشْيَاءَ مِنْ أَمْرِ الْجَاهِلِيَّةِ فَرُبَّمَا تَبَسَّمَ مَعَهُمْ  .","","Al-Mu'jam al-Kabir 1948","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","شريك بن عبد الله النخعي عن سماك"
"1947","1949  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كَانَتْ صَلَاةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  قَصْدًا  وَخُطْبَتُهُ  قَصْدًا  .","","Al-Mu'jam al-Kabir 1949","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","شريك بن عبد الله النخعي عن سماك"
"1948","1950  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ  ، ثَنَا  زَكَرِيَّا بْنُ يَحْيَى ،  ثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  جَالَسْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِائَةَ مَرَّةٍ فَمَا كَانَ يَخْطُبُ إِلَّا قَائِمًا  ، وَكَانَ يَقْعُدُ قَعْدَةً  .","","Al-Mu'jam al-Kabir 1950","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","شريك بن عبد الله النخعي عن سماك"
"1949","1951  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ جَعْفَرٍ الْقَتَّاتُ ،  ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ، (  ح  )  وَحَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى ، (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالُوا :  ثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،         [2/230]      عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كُنَّا إِذَا أَتَيْنَا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَجْلِسُ أَحَدُنَا حَيْثُ يَنْتَهِي  .","","Al-Mu'jam al-Kabir 1951","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","شريك بن عبد الله النخعي عن سماك"
"1950","1952  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ  ، ثَنَا  زَكَرِيَّا بْنُ يَحْيَى ، (  ح  )  وَحَدَّثَنَا  أَبُو الْحَصِينِ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  صَلَّيْتُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي يَوْمِ عِيدٍ فَلَمْ يُؤَذَّنْ  لَهُ وَلَمْ يُقَمْ  .","","Al-Mu'jam al-Kabir 1952","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","شريك بن عبد الله النخعي عن سماك"
"1951","1953  -  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ، قَالَ :  قُلْتُ  لِجَابِرٍ : أَكُنْتَ تُجَالِسُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : "" نَعَمْ  كَانَ طَوِيلَ الصَّمْتِ  .","","Al-Mu'jam al-Kabir 1953","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","شريك بن عبد الله النخعي عن سماك"
"1952","1954  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَلِيُّ بْنُ حَكِيمٍ الْأَوْدِيُّ ، وَمِنْجَابُ بْنُ الْحَارِثِ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ، (  ح  )  وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ شَيْبَةَ الْجُدِّيُّ ، (  ح  )  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالُوا :  ثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَجَمَ  يَهُودِيًّا  وَيَهُودِيَّةً  .","","Al-Mu'jam al-Kabir 1954","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","شريك بن عبد الله النخعي عن سماك"
"1953","1955  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ الرَّازِيُّ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ، (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالُوا :  ثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  قَتَلَ  رَجُلٌ  نَفْسَهُ فَلَمْ يُصَلِّ عَلَيْهِ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 1955","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","شريك بن عبد الله النخعي عن سماك"
"1954","1956  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ جَعْفَرٍ الْقَتَّاتُ  ، ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ، قَالَا :  ثَنَا         [2/231]      شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ :  أَنَّ  رَجُلًا مِنْ أَصْحَابِ النَّبِيِّ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَصَابَتْهُ جِرَاحٌ فَآلَمَتْ بِهِ فَدَبَّ إِلَى قَرْنٍ لَهُ فِي سَيْفِهِ  فَأَخَذَ  مِشْقَصًا  فَقَتَلَ نَفْسَهُ ، فَلَمْ يُصَلِّ عَلَيْهِ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 1956","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","شريك بن عبد الله النخعي عن سماك"
"1955","1957  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ الْعَبَّادِيُّ الْبَصْرِيُّ ،  ثَنَا  أَبُو نُعَيْمٍ النَّخَعِيُّ عَبْدُ الرَّحْمَنِ بْنُ هَانِئٍ ،  ثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كَانَ  بِلَالٌ  يُؤَذِّنُ ثُمَّ يَسْتَأْذِنُ عَلَى النَّبِيِّ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 1957","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن عبد الرحمن بن هانئ الحارثي عن عبد الله بن محمد العبادي عن عبد الله بن أحمد الجواليقي عن الطبراني","شريك بن عبد الله النخعي عن سماك"
"1956","1958  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَسْعُودٍ الْمَقْدِسِيُّ  ، ثَنَا  الْهَيْثَمُ بْنُ جَمِيلٍ ، (  ح  )  وَثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى بِهِمُ الْفَجْرَ  فَقَرَأَ         {      وَالشَّمْسِ وَضُحَاهَا         }             {      وَالسَّمَاءِ وَالطَّارِقِ         }      .","","Al-Mu'jam al-Kabir 1958","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","شريك بن عبد الله النخعي عن سماك"
"1957","1959  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ : "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُؤَخِّرُ صَلَاةَ الْعِشَاءِ الْآخِرَةِ  .","","Al-Mu'jam al-Kabir 1959","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","شريك بن عبد الله النخعي عن سماك"
"1958","1960  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا صَلَّى الْفَجْرَ لَمْ يَقُمْ مِنْ مَجْلِسِهِ  الَّذِي صَلَّى فِيهِ حَتَّى تَطْلُعَ الشَّمْسُ  .","","Al-Mu'jam al-Kabir 1960","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","شريك بن عبد الله النخعي عن سماك"
"1959","1961  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدِ بْنِ الصَّبَّاحِ  ، ثَنَا  إِسْمَاعِيلُ بْنُ مُوسَى السُّدِّيُّ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنِّي لَأَعْرِفُ حَجَرًا  بِمَكَّةَ  كَانَ يُسَلِّمُ عَلَيَّ  لَيَالِيَ بُعِثْتُ  .","","Al-Mu'jam al-Kabir 1961","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن إسماعيل بن موسى الفزاري عن جعفر بن عبد الله بن الصباح الأصبهاني عن الطبراني","شريك بن عبد الله النخعي عن سماك"
"1960","1962  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  خَلَّادُ بْنُ يَزِيدَ ،  عَنْ  شَرِيكٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ،  يَرْفَعُ  الْحَدِيثَ قَالَ :  أُرِيتُ لَيْلَةَ الْقَدْرِ فَأُنْسِيتُهَا فَاطْلُبُوهَا فِي الْعَشْرِ الْأَوَاخِرِ  ، وَقَالَ : وَهِيَ لَيْلَةُ رِيحٍ وَمَطَرٍ وَرَعْدٍ  .","","Al-Mu'jam al-Kabir 1962","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن خلاد بن يزيد الجعفي عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","شريك بن عبد الله النخعي عن سماك"
"1961","[2/232]      حَمَّادُ بْنُ سَلَمَةَ  عَنْ  سِمَاكٍ  1963  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، (  ح  )  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  مَا كَانَ فِي رَأْسِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَفِي لِحْيَتِهِ مِنَ الشَّيْبِ  إِلَّا شَعَرَاتٌ فِي مَفْرِقِ رَأْسِهِ إِذَا ادَّهَنَ وَارَاهُنَّ الدُّهْنُ  .","","Al-Mu'jam al-Kabir 1963","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","حماد بن سلمة عن سماك"
"1962","1964  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ، (  ح  )  وَثَنَا  إِبْرَاهِيمُ بْنُ أَحْمَدَ بْنِ عَمْرٍو الْوَكِيعِيُّ ، قَالَ :  ثَنَا  عَلِيُّ بْنُ عُثْمَانَ اللَّاحِقِيُّ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْطُبُ وَهُوَ يَقُولُ :  إِنَّ الْإِسْلَامَ لَا يَزَالُ عَزِيزًا إِلَى اثْنَيْ عَشَرَ  خَلِيفَةً  ثُمَّ قَالَ كَلِمَةً لَمْ أَفْهَمْهَا ، فَقُلْتُ : مَا قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَقَالَ : "" كُلُّهُمْ مِنْ  قُرَيْشٍ  .","","Al-Mu'jam al-Kabir 1964","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن حماد بن سلمة عن علي بن عثمان بن عبد الحميد اللاحقي عن إبراهيم بن أحمد بن عمر الوكيعي عن الطبراني","حماد بن سلمة عن سماك"
"1963","1965  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجٌ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْطُبُ قَائِمًا  .","","Al-Mu'jam al-Kabir 1965","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","حماد بن سلمة عن سماك"
"1964","1966  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرٍ : "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ  يَقْرَأُ  فِي الظُّهْرِ وَالْعَصْرِ         {      وَالسَّمَاءِ ذَاتِ الْبُرُوجِ         }      ،         {      وَالسَّمَاءِ وَالطَّارِقِ         }      وَنَحْوِهِمَا  .","","Al-Mu'jam al-Kabir 1966","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن حماد بن سلمة عن هدبة بن خالد عن عبد الله بن أحمد بن حنبل عن الطبراني","حماد بن سلمة عن سماك"
"1965","1967  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ رَضِيَ اللهُ عَنْهُ :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَجَمَ  مَاعِزًا  وَلَمْ يَذْكُرْ جَلْدًا  .","","Al-Mu'jam al-Kabir 1967","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن حماد بن سلمة عن سليمان بن حرب الواشحي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","حماد بن سلمة عن سماك"
"1966","1968  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ :  أَنَّ  بِلَالًا  كَانَ يُؤَذِّنُ الظُّهْرَ إِذَا دَحَضَتِ الشَّمْسُ  .","","Al-Mu'jam al-Kabir 1968","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن حماد بن سلمة عن سليمان بن حرب الواشحي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","حماد بن سلمة عن سماك"
"1967","1969  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ         [2/233]      بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ بَيْنَ يَدَيِ السَّاعَةِ كَذَّابِينَ  .","","Al-Mu'jam al-Kabir 1969","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","حماد بن سلمة عن سماك"
"1968","1970  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ  ، ثَنَا  سُرَيْجُ بْنُ النُّعْمَانِ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرٍ ، قَالَ :  كَانُوا يَقُولُونَ :  الْمَدِينَةُ  وَيَثْرِبُ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ عَزَّ وَجَلَّ سَمَّاهَا  طَابَةَ  .","","Al-Mu'jam al-Kabir 1970","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","حماد بن سلمة عن سماك"
"1969","1971  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  أَبُو عُمَرَ الضَّرِيرُ ، (  ح  )  وَحَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  أَنَّهُ سَمِعَ  جَابِرَ بْنَ سَمُرَةَ ،  أَنَّ  رَجُلًا  كَانَ  بِالْحَرَّةِ  وَمَعَهُ  امْرَأَةٌ  لَهُ ، فَأَضَلَّ  رَجُلٌ  بَعِيرًا لَهُ فَوَجَدَهُ الرَّجُلُ الَّذِي  بِالْحَرَّةِ  ، فَحَبَسَهُ عِنْدَهُ وَمَرِضَ الْبَعِيرُ ، فَقَالَتْ لَهُ امْرَأَتُهُ : لَوْ ذَبَحْتَهُ وَقَدَدْنَا لَحْمَهُ وَشَحْمَهُ فَأَكَلْنَاهَا ، فَأَبَى عَلَيْهَا حَتَّى مَاتَ فَأَتَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَخْبَرَهُ ، فَقَالَ :  هَلْ لَكُمْ شَيْءٌ يُعِيشُكُمْ غَيْرُ ذَلِكَ ؟ أَوْ قَالَ : "" هَلْ عِنْدَكَ شَيْءٌ يُعِيشُكَ غَيْرُ ذَلِكَ  ؟ "" قَالَ : لَا ، قَالَ : "" فَقَدِّدُوا شَحْمَهُ وَلَحْمَهُ وَكُلُوهُ "" .  وَجَاءَ صَاحِبُ الْبَعِيرِ بَعْدَ ذَلِكَ ، فَقَالَ : هَلَّا كُنْتَ نَحَرْتَهُ ؟ فَقَالَ : اسْتَحْيَيْتُ مِنْكَ  .","","Al-Mu'jam al-Kabir 1971","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن حماد بن سلمة عن أبو الوليد الطيالسي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","حماد بن سلمة عن سماك"
"1970","1972  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، (  ح  )  وَحَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  سَهْلُ بْنُ بَكَّارٍ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  ثَنَا  سِمَاكُ بْنُ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ : "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا أُتِيَ بِطَعَامٍ فَأَكَلَ مِنْهُ بَعَثَ بِفَضْلِهِ إِلَى  أَبِي أَيُّوبَ  ، وَكَانَ  أَبُو أَيُّوبَ  يَتَتَبَّعُ أَصَابِعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَضَعُ أَصَابِعَهُ حَيْثُ يَرَى أَصَابِعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأُتِيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَاتَ يَوْمٍ بِصَفْحَةٍ فَوَجَدَ فِيهَا رِيحَ ثُومٍ فَلَمْ يَأْكُلْ مِنْهَا ، وَبَعَثَ بِهَا إِلَى  أَبِي أَيُّوبَ  فَلَمْ يَرَ  أَبُو أَيُّوبَ  فِيهَا أَثَرَ أَصَابِعِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ لَمْ أَرَ فِيهَا أَثَرَ         [2/234]      أَصَابِعِكَ ، فَقَالَ :  إِنِّي وَجَدْتُ فِيهَا أَثَرَ ثُومٍ  ، فَقَالَ : بَعَثْتَ إِلَيَّ بِمَا لَا تَأْكُلُهُ ، فَقَالَ : "" إِنَّهُ يَأْتِينِي الْمَلَكُ  .","","Al-Mu'jam al-Kabir 1972","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن حماد بن سلمة عن سهل بن بكار الدارمي عن عثمان بن عمر الضبي عن الطبراني","حماد بن سلمة عن سماك"
"1971","الْوَضَّاحُ أَبُو عَوَانَةَ  عَنْ  سِمَاكٍ  1973  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْطُبُ قَائِمًا ثُمَّ يَقْعُدُ قَعْدَةً لَا يَتَكَلَّمُ  ، ثُمَّ يَقُومُ فَيَخْطُبُ خُطْبَةً أُخْرَى عَلَى مِنْبَرِهِ ، فَمَنْ حَدَّثَكَ أَنَّهُ رَآهُ يَخْطُبُ قَاعِدًا فَلَا تُصَدِّقْهُ  .","","Al-Mu'jam al-Kabir 1973","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","الوضاح أبو عوانة عن سماك"
"1972","1974  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ، قَالَا :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي الصَّلَوَاتِ نَحْوًا مِنْ صَلَاتِكُمْ  وَيُؤَخِّرُ  الْعَتَمَةَ  بَعْدَ صَلَاتِكُمْ شَيْئًا وَكَانَ يُخِفُّ الصَّلَاةَ  .","","Al-Mu'jam al-Kabir 1974","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","الوضاح أبو عوانة عن سماك"
"1973","1975  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ، (  ح  )  وَحَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، قَالَا :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَيَفْتَحَنَّ عِصَابَةٌ  مِنَ الْمُسْلِمِينَ أَوْ مِنَ الْمُؤْمِنِينَ  كَنْزَ  آلِ كِسْرَى  الَّذِي فِي الْأَبْيَضِ  .","","Al-Mu'jam al-Kabir 1975","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","الوضاح أبو عوانة عن سماك"
"1974","1976  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ : سَمِعْتُهُ يَعْنِي النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  سَمَّى  الْمَدِينَةَ  طَابَةَ  .","","Al-Mu'jam al-Kabir 1976","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","الوضاح أبو عوانة عن سماك"
"1975","1977  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ، قَالَا :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  مَاتَ بَغْلٌ عِنْدَ  رَجُلٍ  فَأَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَسْتَفْتِيهِ فَزَعَمَ         [2/235]      جَابِرٌ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ لِصَاحِبِهِ :  أَمَا لَكَ مَا يُغْنِيكَ عَنْهَا ؟ "" قَالَ : لَا ، قَالَ : "" اذْهَبْ فَكُلْهَا  .","","Al-Mu'jam al-Kabir 1977","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","الوضاح أبو عوانة عن سماك"
"1976","1978  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ بَيْنَ يَدَيِ السَّاعَةِ كَذَّابِينَ  .","","Al-Mu'jam al-Kabir 1978","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","الوضاح أبو عوانة عن سماك"
"1977","1979  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرٍ ، قَالَ :  رَأَيْتُ  مَاعِزًا  حِينَ جِيءَ بِهِ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَجُلٌ قَصِيرٌ  أَعْضَلُ  ، فَشَهِدَ عَلَى نَفْسِهِ أَرْبَعَ شَهَادَاتٍ أَنَّهُ قَدْ زَنَى ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" فَلَعَلَّكَ "" ، قَالَ : لَا وَاللهِ إِنَّهُ قَدْ زَنَى الْآخِرُ فَرَجَمَهُ ، ثُمَّ خَطَبَ ، فَقَالَ :  أَلَا كُلَّمَا نَفَرْنَا فِي  سَبِيلِ  اللهِ  خَلَفَ  أَحَدُهُمْ لَهُ نَبِيبٌ  كَنَبِيبِ  التَّيْسِ يَمْنَحُ إِحْدَاهُنَّ  الْكُثْبَةَ  ، أَمَا إِنَّ اللهَ يُمَكِّنِّي مِنْ أَحَدٍ مِنْهُمْ إِلَّا نَكَّلْتُهُ عَنْهُنَّ  .","","Al-Mu'jam al-Kabir 1979","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","الوضاح أبو عوانة عن سماك"
"1978","1980  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  حَدَّثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَجَمَ  مَاعِزًا  وَلَمْ يَذْكُرْ جَلْدًا  .","","Al-Mu'jam al-Kabir 1980","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن أبو الوليد الطيالسي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","الوضاح أبو عوانة عن سماك"
"1979","أَبُو الْأَحْوَصِ سَلَّامُ بْنُ سُلَيْمٍ  عَنْ  سِمَاكٍ  1981  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، حَدَّثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، (  ح  )  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ، قَالُوا :  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  صَلَّيْتُ الْعِيدَ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ غَيْرَ مَرَّةٍ  وَلَا مَرَّتَيْنِ بِغَيْرِ أَذَانٍ وَلَا إِقَامَةٍ  .","","Al-Mu'jam al-Kabir 1981","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن أبو الوليد الطيالسي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","أبو الأحوص سلام بن سليم عن سماك"
"1980","1982  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )         [2/236]      وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ، قَالَا :  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا صَلَّى الْفَجْرَ قَعَدَ  فِي مُصَلَّاهُ حَتَّى تَطْلُعَ الشَّمْسُ  .","","Al-Mu'jam al-Kabir 1982","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو الأحوص سلام بن سليم عن سماك"
"1981","1983  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ، قَالَا :  ثَنَا  أَبُو الْأَحْوَصِ ،  ثَنَا  سِمَاكٌ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُؤَخِّرُ صَلَاةَ الْعِشَاءِ الْآخِرِ  .","","Al-Mu'jam al-Kabir 1983","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو الأحوص سلام بن سليم عن سماك"
"1982","1984  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ، قَالَا :  ثَنَا  أَبُو الْأَحْوَصِ ،  ثَنَا  سِمَاكٌ ،  عَنْ  جَابِرٍ ، قَالَ :  كُنْتُ أُصَلِّي مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَكَانَتْ صَلَاتُهُ  قَصْدًا  وَخُطْبَتُهُ  قَصْدًا  .","","Al-Mu'jam al-Kabir 1984","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو الأحوص سلام بن سليم عن سماك"
"1983","1985  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ، قَالَا :  ثَنَا  أَبُو الْأَحْوَصِ ،  ثَنَا  سِمَاكٌ ،  عَنْ  جَابِرٍ ، قَالَ :  كَانَتْ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خُطْبَتَانِ  يَجْلِسُ بَيْنَهُمَا يَقْرَأُ الْقُرْآنَ وَيُذَكِّرُ النَّاسَ  .","","Al-Mu'jam al-Kabir 1985","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو الأحوص سلام بن سليم عن سماك"
"1984","1986  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  ثَنَا  سِمَاكٌ ،  عَنْ  جَابِرٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا أُهْدِيَ لَهُ طَعَامٌ أَصَابَ مِنْهُ ثُمَّ بَعَثَ بِفَضْلِهِ إِلَى  أَبِي أَيُّوبَ  فَأُهْدِيَ لَهُ طَعَامٌ فِيهِ ثُومٌ ، فَبَعَثَ بِهِ إِلَى  أَبِي أَيُّوبَ  وَلَمْ يَنَلْ مِنْهُ شَيْئًا ، فَلَمَّا لَمْ يَرَ  أَبُو أَيُّوبَ  أَثَرَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الطَّعَامِ أَتَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَسَأَلَهُ عَنْ ذَلِكَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّمَا تَرَكْتُهُ مِنْ أَجْلِ رِيحِهِ  ، قَالَ  أَبُو أَيُّوبَ  : وَأَنَا أَكْرَهُ مَا تَكْرَهُ  .","","Al-Mu'jam al-Kabir 1986","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","أبو الأحوص سلام بن سليم عن سماك"
"1985","1987  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُعَلَّى بْنُ مَهْدِيٍّ ، قَالَا :  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ اللهَ عَزَّ وَجَلَّ أَمَرَنِي أَنْ أُسَمِّيَ  الْمَدِينَةَ  طَيْبَةَ  وَقَالَ  أَبُو بَكْرٍ  :  طَابَةَ  .","","Al-Mu'jam al-Kabir 1987","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو الأحوص سلام بن سليم عن سماك"
"1986","[2/237]      1988  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ بَيْنَ يَدَيِ السَّاعَةِ كَذَّابِينَ  ، قُلْتُ : أَنْتَ سَمِعْتَ هَذَا مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : نَعَمْ .","","Al-Mu'jam al-Kabir 1988","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو الأحوص سلام بن سليم عن سماك"
"1987","1989  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ الْعَسَّالُ الْأَصْبَهَانِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بِحَسْبِ أَحَدِكُمْ إِذَا قَضَى صَلَاتَهُ أَنْ يَضَعَ يَدَهُ عَلَى فَخِذِهِ وَيُسَلِّمَ عَلَى أَخِيهِ  عَنْ يَمِينِهِ السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ وَعَنْ شِمَالِهِ مِثْلَ ذَلِكَ  .","","Al-Mu'jam al-Kabir 1989","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن إسماعيل بن عمرو البجلي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","أبو الأحوص سلام بن سليم عن سماك"
"1988","سَعِيدُ بْنُ سِمَاكِ بْنِ حَرْبٍ  عَنْ أَبِيهِ  1990  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ الطَّائِيُّ  ، ثَنَا  عَبْدُ الْمَلِكِ بْنُ عَبْدِ رَبِّهِ الطَّائِيُّ ،  ثَنَا  ابْنُ السِّمَاكِ بْنِ حَرْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  جَالَسْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَكْثَرَ مِنْ مِائَةِ مَرَّةٍ فِي الْمَسْجِدِ  يَجْلِسُ أَصْحَابُهُ يَتَنَاشَدُونَ الشِّعْرَ وَرُبَّمَا تَذَاكَرُوا أَمْرَ الْجَاهِلِيَّةِ فَيَبْتَسِمُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَعَهُمْ  .","","Al-Mu'jam al-Kabir 1990","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن سعيد بن سماك بن حرب عن عبد الملك بن عبد ربه الطائي عن أحمد بن القاسم بن محمد الطائي عن الطبراني","سعيد بن سماك بن حرب عن أبيه"
"1989","دَاوُدُ بْنُ أَبِي هِنْدٍ  عَنْ  سِمَاكِ بْنِ حَرْبٍ  1991  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَيْثَمَةَ  ، ثَنَا  مُحَمَّدُ بْنُ وَرْدِ بْنِ عَبْدِ اللهِ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَدِيُّ بْنُ الْفَضْلِ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ : "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَخْطُبُ خُطْبَتَيْنِ يَجْلِسُ بَيْنَهُمَا  .","","Al-Mu'jam al-Kabir 1991","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن داود بن أبي هند عن عدي بن الفضل التيمي عن ورد بن عبد الله التميمي عن محمد بن الورد التميمي عن محمد بن أحمد بن أبي خيثمة النسائي عن الطبراني","داود بن أبي هند عن سماك بن حرب"
"1990","[2/238]      مَالِكُ بْنُ مِغْوَلٍ  عَنْ  سِمَاكٍ  1992  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ، قَالَا :  ثَنَا  مَالِكُ بْنُ مِغْوَلٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى جِنَازَةِ  ابْنِ الدَّحْدَاحِ  فَلَمَّا رَجَعَ أُتِيَ بِفَرَسٍ مُعْرَوْرًى فَرَكِبَهُ وَمَشَيْنَا  .","","Al-Mu'jam al-Kabir 1992","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن مالك بن مغول الصهيبي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مالك بن مغول عن سماك"
"1991","1993  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  مَالِكِ بْنِ مِغْوَلٍ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ :  لَمَّا انْصَرَفَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ جِنَازَةِ  ابْنِ الدَّحْدَاحِ  أُتِيَ بِفَرَسٍ مُعْرَوْرًى فَرَكِبَهُ وَنَحْنُ نَمْشِي حَوْلَهُ  .","","Al-Mu'jam al-Kabir 1993","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن مالك بن مغول الصهيبي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","مالك بن مغول عن سماك"
"1992","نُصَيْرُ بْنُ أَبِي الْأَشْعَثِ  عَنْ  سِمَاكٍ  1994  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَلِيٍّ الْأَبَّارُ  ، ثَنَا  أَبُو الْأَصْبَغِ الْحَرَّانِيُّ ،  ثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  نُصَيْرِ بْنِ أَبِي الْأَشْعَثِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرٍ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَشَى مَعَ جِنَازَةٍ  وَرَكِبَ حِينَ أَقْبَلَ فَرَسًا  عَرِيًّا  لَيْسَ عَلَيْهِ إِلَّا لِجَامُهُ  .","","Al-Mu'jam al-Kabir 1994","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن نصير بن أبي الأشعث القرادي عن عيسى بن يونس بن أبي إسحاق عن عبد العزيز بن يحيى البكائي عن أحمد بن علي بن مسلم النخشبي عن الطبراني","نصير بن أبي الأشعث عن سماك"
"1993","إِبْرَاهِيمُ بْنُ طَهْمَانَ  عَنْ  سِمَاكٍ  1995  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنِّي لَأَعْلَمُ حَجَرًا  بِمَكَّةَ  كَانَ يُسَلِّمُ عَلَيَّ حِينَ بُعِثْتُ  .","","Al-Mu'jam al-Kabir 1995","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إبراهيم بن طهمان عن موسى بن مسعود النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","إبراهيم بن طهمان عن سماك"
"1994","1996  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ أَبِي بُكَيْرٍ ،  ثَنَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  حَدَّثَنِي  سِمَاكُ بْنُ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَزَالُ هَذَا الدِّينُ قَائِمًا يُقَاتِلُ عَلَيْهِ عِصَابَةٌ مِنَ الْمُسْلِمِينَ  حَتَّى تَقُومَ السَّاعَةُ  .","","Al-Mu'jam al-Kabir 1996","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إبراهيم بن طهمان عن يحيى بن أبي بكير عن عبد الله بن محمد بن يحيى الكرماني عن أحمد بن يحيى بن زهير التستري عن الطبراني","إبراهيم بن طهمان عن سماك"
"1995","[2/239]      عَنْبَسَةُ بْنُ الْأَزْهَرِ  عَنْ  سِمَاكٍ  1997  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، حَدَّثَنَا  عُبَيْدُ بْنُ يَعِيشَ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ، قَالَا :  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  عَنْ  عَنْبَسَةَ بْنِ الْأَزْهَرِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كَأَنِّي أَنْظُرُ إِلَى شَعَرِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَجُمَّتُهُ  يَضْرِبُ هَذَا الْمَكَانَ وَضَرَبَ بِيَدِهِ عَلَى صَدْرِهِ فَوْقَ ثَدْيَيْهِ  .","","Al-Mu'jam al-Kabir 1997","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن عنبسة بن الأزهر الشيباني عن يونس بن بكير عن محمد بن عبد الله بن نمير عن عبد الله بن أحمد الجواليقي عن الطبراني","عنبسة بن الأزهر عن سماك"
"1996","1998  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  فَرْوَةُ بْنُ أَبِي الْمَغْرَاءِ ،  أَنَا  إِبْرَاهِيمُ بْنُ الْمُخْتَارِ ،  ثَنَا  عَنْبَسَةُ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بُعِثْتُ أَنَا وَالسَّاعَةُ كَهَاتَيْنِ  ، وَأَشَارَ بِإِصْبَعَيْهِ السَّبَّابَةِ وَالْوُسْطَى  .","","Al-Mu'jam al-Kabir 1998","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن عنبسة بن الأزهر الشيباني عن حبويه ، إبراهيم بن المختار عن فروة بن أبي المغراء الكندي عن محمد بن عثمان بن أبي شيبة عن الطبراني","عنبسة بن الأزهر عن سماك"
"1997","1999  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَصْبَهَانِيُّ  ، ثَنَا  أَبُو مَسْعُودٍ أَحْمَدُ بْنُ الْفُرَاتِ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ سُلَيْمَانَ ،  ثَنَا  عَنْبَسَةُ بْنُ سَعِيدٍ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُطِيلُ الصَّمْتَ  فَيَتَحَدَّثُونَ بِأَمْرِ الْجَاهِلِيَّةِ فَيَضْحَكُونَ وَيَبْتَسِمُ مَعَهُمْ  .","","Al-Mu'jam al-Kabir 1999","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن عنبسة بن سعيد بن الضريس عن إسحاق بن سليمان الرازي عن أحمد بن الفرات الضبي عن محمد بن عبد الله بن رسته الضبي عن الطبراني","عنبسة بن الأزهر عن سماك"
"1998","أَبُو الْأَشْهَبِ جَعْفَرُ بْنُ الْحَارِثِ  عَنِ  سِمَاكٍ  2000  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ حَسَّانَ الْبُرْجُنَانِيُّ  ثَنَا  مُحَمَّدُ بْنُ يَزِيدَ ،  ثَنَا  جَعْفَرُ بْنُ الْحَارِثِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ، قَالَ :  قَالَ  جَابِرُ بْنُ سَمُرَةَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ فِي صَلَاةِ الْفَجْرِ  بِـ         {      ق         }      .  كذا في طبعة مكتبة ابن تيمية وهو مصحف ، وصوابه : (البرجلاني) .","","Al-Mu'jam al-Kabir 2000","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن جعفر بن الحارث الواسطي عن محمد بن يزيد الكلاعي عن محمد بن حسان البرجلاني عن بحشل عن الطبراني","أبو الأشهب جعفر بن الحارث عن سماك"
"1999","2001  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ حَسَّانَ الْبُرْجُنَانِيُّ  ،  ثَنَا  مُحَمَّدُ بْنُ يَزِيدَ ،  ثَنَا  جَعْفَرُ بْنُ الْحَارِثِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرٍ ، قَالَ :  مَا رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْطُبُ قَطُّ إِلَّا قَائِمًا  فِي يَوْمِ الْجُمُعَةِ ، فَكَانَ يَخْطُبُ ثُمَّ يَقْعُدُ ثُمَّ يَقُومُ فَيَخْطُبُ ، كَانَ يَخْطُبُ خُطْبَتَيْنِ بَيْنَهُمَا قَعْدَةٌ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب :(البرجلاني).","","Al-Mu'jam al-Kabir 2001","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن جعفر بن الحارث الواسطي عن محمد بن يزيد الكلاعي عن محمد بن حسان البرجلاني عن بحشل عن الطبراني","أبو الأشهب جعفر بن الحارث عن سماك"
"2000","[2/240]      زِيَادُ بْنُ خَيْثَمَةَ  عَنْ  سِمَاكٍ  2002  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ الرَّازِيُّ ، وَمُحَمَّدُ بْنُ يَزْدَادَ التَّوَّزِيُّ ، قَالَا :  ثَنَا  الْوَلِيدُ بْنُ شُجَاعٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  زِيَادُ بْنُ خُثَيْمَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَنَا  فَرَطُكُمْ  عَلَى الْحَوْضِ ،  وَإِنَّ بُعْدَ مَا بَيْنَ طَرَفَيْهِ ، كَمَا بَيْنَ  صَنْعَاءَ  وَأَيْلَةَ ،  كَأَنَّ الْأَبَارِيقَ فِيهِ النُّجُومُ  .","","Al-Mu'jam al-Kabir 2002","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زياد بن خيثمة الجعفي عن شجاع بن الوليد السكوني عن الوليد بن شجاع عن محمد بن يزداد التوزي عن الطبراني","زياد بن خيثمة عن سماك"
"2001","زَكَرِيَّا بْنُ أَبِي زَائِدَةَ  عَنْ  سِمَاكٍ  2003  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ الْأَصْبَهَانِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُومُ عَلَى الْمِنْبَرِ فَيَخْطُبُ  ثُمَّ يَجْلِسُ ثُمَّ يَقُومُ فَيَخْطُبُ يَجْلِسُ بَيْنَ الْخُطْبَتَيْنِ  .","","Al-Mu'jam al-Kabir 2003","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زكريا بن أبي زائدة الوادعي عن يحيى بن زكريا بن أبي زائدة عن سهل بن عثمان العسكري عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","زكريا بن أبي زائدة عن سماك"
"2002","2004  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا ،  حَدَّثَنِي  أَبِي  ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا خَطَبَ يَوْمَ الْجُمُعَةِ  يَقْرَأُ مِنْ كِتَابِ اللهِ وَيُذَكِّرُ النَّاسَ  .","","Al-Mu'jam al-Kabir 2004","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زكريا بن أبي زائدة الوادعي عن يحيى بن زكريا بن أبي زائدة عن سهل بن عثمان العسكري عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","زكريا بن أبي زائدة عن سماك"
"2003","2005  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  عَنْ  زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  حَدَّثَنَا  يَحْيَى بْنُ زَكَرِيَّا ،  حَدَّثَنِي  أَبِي  ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ :  كُنْتُ أُصَلِّي مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الصَّلَوَاتِ  وَكَانَتْ صَلَاتُهُ  قَصْدًا  وَخُطْبَتُهُ  قَصْدًا  .","","Al-Mu'jam al-Kabir 2005","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زكريا بن أبي زائدة الوادعي عن يحيى بن زكريا بن أبي زائدة عن سهل بن عثمان العسكري عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","زكريا بن أبي زائدة عن سماك"
"2004","2006  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  عَنْ  زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ : "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا صَلَّى الْفَجْرَ قَعَدَ فِي مُصَلَّاهُ  حَتَّى تَطْلُعَ الشَّمْسُ  .","","Al-Mu'jam al-Kabir 2006","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زكريا بن أبي زائدة الوادعي عن محمد بن بشر بن الفرافصة عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","زكريا بن أبي زائدة عن سماك"
"2005","2007  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ         [2/241]      بِشْرٍ ،  عَنْ  زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّهُ سَيَقُومُ بَعْدِي اثْنَا عَشَرَ أَمِيرًا  ثُمَّ قَالَ كَلِمَةً فَسَأَلْتُ أَبِي فَقَالَ : "" كُلُّهُمْ مِنْ  قُرَيْشٍ  .","","Al-Mu'jam al-Kabir 2007","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زكريا بن أبي زائدة الوادعي عن محمد بن بشر بن الفرافصة عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","زكريا بن أبي زائدة عن سماك"
"2006","الْحَسَنُ بْنُ صَالِحِ بْنِ حَيٍّ  عَنْ  سِمَاكٍ  2008  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  حَسَنُ بْنُ صَالِحٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  مَا مَاتَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى صَلَّى قَاعِدًا  .","","Al-Mu'jam al-Kabir 2008","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الحسن بن صالح بن صالح بن حي عن عبيد الله بن موسى عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","الحسن بن صالح بن حي عن سماك"
"2007","2009  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  عَلِيُّ بْنُ حَكِيمٍ الْأَوْدِيُّ ،  ثَنَا  حُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ ، (  ح  )  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، قَالَا :  ثَنَا  حَسَنُ بْنُ صَالِحٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرٍ ، قَالَ :  رَأَيْتُ الْخَاتَمَ فِي ظَهْرِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مِثْلَ بَيْضَةِ الْحَمَامَةِ  .","","Al-Mu'jam al-Kabir 2009","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الحسن بن صالح بن صالح بن حي عن عبيد الله بن موسى عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","الحسن بن صالح بن حي عن سماك"
"2008","2010  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  أَنَا  الْحَسَنُ بْنُ صَالِحٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  حَدَّثَنِي  جَابِرُ بْنُ سَمُرَةَ ، قَالَ :  صَلَّيْنَا عَلَى  ابْنِ الدَّحْدَاحِ  رَجُلٍ مِنَ  الْأَنْصَارِ  ، فَلَمَّا فَرَغْنَا مِنْهُ أَتَى  رَجُلٌ  رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِفَرَسٍ حَصَانٍ فَرَكِبَهُ حِينَ رَجَعَ مِنَ الْجِنَازَةِ  .","","Al-Mu'jam al-Kabir 2010","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الحسن بن صالح بن صالح بن حي عن عبيد الله بن موسى عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","الحسن بن صالح بن حي عن سماك"
"2009","2011  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  عَنْ  حَسَنِ بْنِ صَالِحٍ ،  عَنْ  سِمَاكٍ ، قَالَ :  حَدَّثَنِي  جَابِرُ بْنُ سَمُرَةَ ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَنْ يَزَالَ هَذَا الْأَمْرُ قَائِمًا يُقَاتِلُ عَلَيْهِ عِصَابَةٌ مِنَ الْمُسْلِمِينَ  حَتَّى تَقُومَ السَّاعَةُ  .","","Al-Mu'jam al-Kabir 2011","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الحسن بن صالح بن صالح بن حي عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","الحسن بن صالح بن حي عن سماك"
"2010","2012  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  عَنْ  حَسَنِ بْنِ صَالِحٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ، قَالَ :  سَمِعْتُ         [2/242]      جَابِرَ بْنَ سَمُرَةَ ، قَالَ :  لَمْ يَكُنْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْطُبُ وَهُوَ جَالِسٌ  إِلَّا وَهُوَ قَائِمٌ  .","","Al-Mu'jam al-Kabir 2012","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الحسن بن صالح بن صالح بن حي عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","الحسن بن صالح بن حي عن سماك"
"2011","عَنْبَسَةُ بْنُ سَعِيدٍ  عَنْ  سِمَاكٍ  2013  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ نَاجِيَةَ  ، ثَنَا  يُوسُفُ بْنُ مُوسَى الْقَطَّانُ ،  ثَنَا  حَكَّامُ بْنُ سَلْمٍ ،  عَنْ  عَنْبَسَةَ بْنِ سَعِيدٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرٍ ، قَالَ :  لَمْ أَرَ رَسُولَ اللهِ يَوْمًا يَقُومُ مِنْ مَكَانِهِ الَّذِي يُصَلِّي فِيهِ الْفَجْرَ  حَتَّى تَطْلُعَ الشَّمْسُ ثُمَّ يَقُومُ  .","","Al-Mu'jam al-Kabir 2013","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن عنبسة بن سعيد بن الضريس عن حكام بن سلم الكناني عن يوسف بن موسى بن راشد عن عبد الله بن محمد بن ناجية البربري عن الطبراني","عنبسة بن سعيد عن سماك"
"2012","2014  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ الْأَصْبَهَانِيُّ  ، ثَنَا  أَبُو مَسْعُودٍ أَحْمَدُ بْنُ الْفُرَاتِ ،  ثَنَا  إِسْحَاقُ بْنُ سُلَيْمَانَ ،  عَنْ  عَنْبَسَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ، قَالَ :  قُلْتُ  لِجَابِرِ بْنِ سَمُرَةَ : هَلْ كُنْتُمْ تَذْكُرُونَ الشِّعْرَ عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : نَعَمْ ،  كُنَّا نَذْكُرُ عِنْدَهُ الْأَشْعَارَ فَنَضْحَكُ وَيَبْتَسِمُ  .","","Al-Mu'jam al-Kabir 2014","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن عنبسة بن سعيد بن الضريس عن إسحاق بن سليمان الرازي عن أحمد بن الفرات الضبي عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","عنبسة بن سعيد عن سماك"
"2013","شَيْبَانُ أَبُو مُعَاوِيَةَ  عَنْ  سِمَاكٍ  2015  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ حَسَّانَ الْأَنْمَاطِيُّ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  شَيْبَانُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَا يُطِيلُ الْمَوْعِظَةَ يَوْمَ الْجُمُعَةِ  إِنَّمَا هِيَ كَلِمَاتٌ يَسِيرَاتٌ  .","","Al-Mu'jam al-Kabir 2015","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شيبان بن عبد الرحمن المؤدب عن الوليد بن مسلم القرشي عن هشام بن عمار عن إسحاق بن إبراهيم بن أبي حسان الأنماطي عن الطبراني","شيبان أبو معاوية عن سماك"
"2014","قَيْسُ بْنُ الرَّبِيعِ الْأَسَدِيُّ  عَنْ  سِمَاكٍ  2016  -  حَدَّثَنَا  الْفُضَيْلُ بْنُ مُحَمَّدٍ الْمَلَطِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي الْعَصْرَ نَحْوًا مِنْ صَلَاتِكُمْ  ، وَكَانَ يُصَلِّي الْمَغْرِبَ نَحْوًا مِنْ صَلَاتِكُمْ ، وَكَانَ يُؤَخِّرُ الْعِشَاءَ عَنْ صَلَاتِكُمْ شَيْئًا وَكَانَ  بِلَالٌ  يُؤَخِّرُ الظُّهْرَ حَتَّى  تَدْحَضَ  الشَّمْسُ ، لَا يَخْرِمُ عَنْ وَقْتٍ وَاحِدٍ ، فَأَمَّا الْإِقَامَةُ فَرُبَّمَا خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [2/243]      فَعَجَّلَ وَرُبَّمَا أَخَّرَ  .","","Al-Mu'jam al-Kabir 2016","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن قيس بن الربيع الأسدي عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","قيس بن الربيع الأسدي عن سماك"
"2015","2017  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ، ( ح )  وَثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ، قَالَا :  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  حَدَّثَنِي  سِمَاكُ بْنُ حَرْبٍ ،  عَنْ  جَابِرٍ ، قَالَ :  قُلْتُ لَهُ :  أَكُنْتَ تُجَالِسُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : "" نَعَمْ ، وَكَانَ طَوِيلَ الصَّمْتِ ، وَكَانَ أَصْحَابُهُ يُنَاشِدُونَ الشِّعْرَ عِنْدَهُ  وَيَذْكُرُونَ أَشْيَاءَ مِنْ أَمْرِ الْجَاهِلِيَّةِ ، وَيَضْحَكُونَ وَيَبْتَسِمُ مَعَهُمْ إِذَا ضَحِكُوا  .","","Al-Mu'jam al-Kabir 2017","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن قيس بن الربيع الأسدي عن علي بن الجعد عن محمد بن عبدوس السراج عن الطبراني","قيس بن الربيع الأسدي عن سماك"
"2016","2018  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ بْنِ سَوْرَةَ ، وَأَبُو خَلِيفَةَ ، وَمُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ ، قَالُوا :  ثَنَا  أَبُو الْوَلِيدِ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَجَعَ مِنْ جِنَازَةِ  ابْنِ الدَّحْدَاحِ  عَلَى فَرَسٍ عُرًى  .","","Al-Mu'jam al-Kabir 2018","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن قيس بن الربيع الأسدي عن أبو الوليد الطيالسي عن محمد بن محمد بن حيان التمار عن الطبراني","قيس بن الربيع الأسدي عن سماك"
"2017","2019  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ الْمَسْرُوقِيُّ  ، ثَنَا  عَوْنُ بْنُ سَلَّامٍ ،  ثَنَا  قَيْسٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ،  يَرْفَعُهُ  :  أَنَّهُ كَانَ يُصَلِّي الْفَجْرَ ثُمَّ يَقْعُدُ إِلَى طُلُوعِ الشَّمْسِ  .","","Al-Mu'jam al-Kabir 2019","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن قيس بن الربيع الأسدي عن عون بن سلام الهاشمي عن محمد بن عبد الله بن عبد الرحمن المسروقي عن الطبراني","قيس بن الربيع الأسدي عن سماك"
"2018","2020  -  حَدَّثَنَا  مَحْمُودُ بْنُ عَلِيٍّ الْأَصْبَهَانِيُّ ،  ثَنَا  يُونُسُ بْنُ حَبِيبٍ ،  ثَنَا  أَبُو دَاوُدَ ،  ثَنَا  قَيْسٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَيُفْتَحَنَّ أَبْيَضُ كِسْرَى عَلَى طَائِفَةٍ مِنَ الْمُسْلِمِينَ  .","","Al-Mu'jam al-Kabir 2020","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن قيس بن الربيع الأسدي عن أبو داود الطيالسي عن يونس بن حبيب الماصر عن محمود بن علي بن مالك الشيباني عن الطبراني","قيس بن الربيع الأسدي عن سماك"
"2019","2021  -  وَعَنْ  سِمَاكِ بْنِ حَرْبٍ ، قَالَ :  قُلْتُ  لِجَابِرِ بْنِ سَمُرَةَ :  كَيْفَ كَانَتْ صَلَاةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ :  كَانَتْ خُطْبَتُهُ  قَصْدًا  وَصَلَاتُهُ  قَصْدًا  .","","Al-Mu'jam al-Kabir 2021","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن قيس بن الربيع الأسدي عن أبو داود الطيالسي عن يونس بن حبيب الماصر عن محمود بن علي بن مالك الشيباني عن الطبراني","قيس بن الربيع الأسدي عن سماك"
"2020","2022  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عَقِيلٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبَانَ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ :  صَعِدَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمِنْبَرَ ، فَقَالَ : "" آمِينَ آمِينَ آمِينَ "" قَالَ :  أَتَانِي  جِبْرِيلُ  عَلَيْهِ         [2/244]      السَّلَامُ فَقَالَ : يَا  مُحَمَّدُ  مَنْ أَدْرَكَ أَحَدَ وَالِدَيْهِ فَمَاتَ فَدَخَلَ النَّارَ  فَأَبْعَدَهُ  اللهُ  قُلْ آمِينَ ، فَقُلْتُ : آمِينَ ، قَالَ : يَا  مُحَمَّدُ  مَنْ أَدْرَكَ شَهْرَ رَمَضَانَ فَمَاتَ فَلَمْ يُغْفَرْ لَهُ فَأُدْخِلَ النَّارَ  فَأَبْعَدَهُ  اللهُ قُلْ آمِينَ ، فَقُلْتُ : آمِينَ ، قَالَ : وَمَنْ ذُكِرْتَ عِنْدَهُ فَلَمْ يُصَلِّ عَلَيْكَ فَمَاتَ فَدَخَلَ النَّارَ  فَأَبْعَدَهُ  اللهُ ، قُلْ آمِينَ ، فَقُلْتُ : آمِينَ  .","","Al-Mu'jam al-Kabir 2022","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن قيس بن الربيع الأسدي عن إسماعيل بن أبان عن محمد بن عبد الله بن عبيد بن عقيل الهلالي عن عبد الله بن أحمد الجواليقي عن الطبراني","قيس بن الربيع الأسدي عن سماك"
"2021","2023  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  الْحَسَنُ بْنُ مُحَمَّدِ بْنِ عَبْدِ الْعَزِيزِ الْجُنْدَيْسَابُورِيُّ ،  ثَنَا  أَبُو بِلَالٍ الْأَشْعَرِيُّ ،  ثَنَا  قَيْسٌ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرٍ :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَسَحَ عَلَى الْخُفَّيْنِ  .","","Al-Mu'jam al-Kabir 2023","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن قيس بن الربيع الأسدي عن أبو بلال الأشعري عن الحسن بن محمد بن عبد العزيز الجنديسابوري عن الساجي عن الطبراني","قيس بن الربيع الأسدي عن سماك"
"2022","حَجَّاجُ بْنُ أَرْطَاةَ  عَنْ  سِمَاكٍ  2024  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ (  ح  )  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عُبَيْدِ اللهِ الْحَلَبِيُّ ، قَالُوا :  ثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ :  كَانَ فِي سَاقَيْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  حُمُوشَةٌ  ، وَكَانَ لَا يَضْحَكُ إِلَّا تَبَسُّمًا  ، وَكُنْتُ إِذَا نَظَرْتُ إِلَيْهِ قُلْتُ  أَكْحَلُ  الْعَيْنَيْنِ وَلَيْسَ بِأَكْحَلَ  وَاللَّفْظُ لِحَدِيثِ  عَبْدِ الرَّحْمَنِ بْنِ عُبَيْدِ اللهِ  .","","Al-Mu'jam al-Kabir 2024","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن حجاج بن أرطاة عن عباد بن العوام الكلابي عن عبد الرحمن بن عبيد الله بن حكيم الأسدي عن الحسين بن إسحاق التستري عن الطبراني","حجاج بن أرطأة عن سماك"
"2023","2025  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  الْحُسَيْنُ بْنُ عَبْدِ الْأَوَّلِ ،  ثَنَا  أَبُو خَالِدٍ الْأَحْمَرُ ،  عَنْ  حَجَّاجٍ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَا يَنْبَعِثُ فِي الضَّحِكِ  .","","Al-Mu'jam al-Kabir 2025","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن حجاج بن أرطاة عن سليمان بن حيان الأحمر عن الحسين بن عبد الأول الأحول عن محمد بن عبد الله مطين الحضرمي عن الطبراني","حجاج بن أرطأة عن سماك"
"2024","2026  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  حَجَّاجٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَطَبَ قَائِمًا ثُمَّ قَعَدَ  .","","Al-Mu'jam al-Kabir 2026","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن حجاج بن أرطاة عن أبو معاوية الضرير عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","حجاج بن أرطأة عن سماك"
"2025","[2/245]      سُلَيْمَانُ بْنُ مُعَاذٍ الضَّبِّيُّ  عَنْ  سِمَاكٍ  2027  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عُثْمَانُ بْنُ طَالُوتَ ، قَالَا :  ثَنَا  أَبُو دَاوُدَ ،  ثَنَا  سُلَيْمَانُ بْنُ مُعَاذٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْتَمِسُوا لَيْلَةَ الْقَدْرِ فِي الْعَشْرِ الْأَوَاخِرِ  .","","Al-Mu'jam al-Kabir 2027","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن سليمان بن قرم الضبي عن أبو داود الطيالسي عن عثمان بن طالوت الجحدري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","سليمان بن معاذ الضبي عن سماك"
"2026","2028  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  أَبُو دَاوُدَ ،  ثَنَا  سُلَيْمَانُ بْنُ مُعَاذٍ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ : أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ  بِمَكَّةَ  حَجَرًا يُسَلِّمُ عَلَيَّ إِنِّي لَأَعْرِفُهُ إِذَا رَأَيْتُهُ  .","","Al-Mu'jam al-Kabir 2028","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن سليمان بن قرم الضبي عن أبو داود الطيالسي عن محمد بن أبي بكر المقدمي عن عبد الله بن أحمد بن حنبل عن الطبراني","سليمان بن معاذ الضبي عن سماك"
"2027","نَاصِحٌ أَبُو عَبْدِ اللهِ  عَنْ  سِمَاكٍ  2029  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  عَبْدُ الْعَزِيزِ بْنُ الْخَطَّابِ ،  ثَنَا  نَاصِحٌ أَبُو عَبْدِ اللهِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كَانَ  شَابٌّ  يَخْدُمُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَيَخِفُّ فِي حَوَائِجِهِ ، فَقَالَ : "" سَلْنِي حَاجَةً "" ، فَقَالَ :  ادْعُ اللهَ تَعَالَى لِي بِالْجَنَّةِ ، قَالَ : فَرَفَعَ رَأْسَهُ فَتَنَفَّسَ وَقَالَ : "" نَعَمْ وَلَكِنْ أَعِنِّي بِكَثْرَةِ السُّجُودِ  .","","Al-Mu'jam al-Kabir 2029","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن ناصح بن عبد الله المحلمي عن عبد العزيز بن الخطاب الكوفي عن أبو مسلم الكجي عن الطبراني","ناصح أبو عبد الله عن سماك"
"2028","2030  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  عَبْدُ الْعَزِيزِ بْنُ الْخَطَّابِ ،  حَدَّثَنَا  نَاصِحٌ أَبُو عَبْدِ اللهِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ دَفَنَ ثَلَاثَةً مِنَ الْوَلَدِ فَصَبَرَ عَلَيْهِمْ  وَاحْتَسَبَهُمْ  وَجَبَتْ لَهُ الْجَنَّةُ  ، فَقَالَتْ  أُمُّ أَيْمَنَ  : أَوِ اثْنَيْنِ ، قَالَ : "" وَمَنْ دَفَنَ اثْنَيْنِ فَصَبَرَ عَلَيْهِمَا  وَاحْتَسَبَهُمَا  وَجَبَتْ لَهُ الْجَنَّةُ "" ، فَقَالَتْ  أُمُّ أَيْمَنَ  : أَوْ وَاحِدَةٌ ؟ قَالَ :  فَسَكَتَ أَوْ أَمْسَكَ  ، فَقَالَ : سَمِعْتُ  أُمَّ أَيْمَنَ  : "" مَنْ دَفَنَ وَاحِدًا فَصَبَرَ  وَاحْتَسَبَ  كَانَتْ لَهُ         [2/246]      الْجَنَّةُ  .","","Al-Mu'jam al-Kabir 2030","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن ناصح بن عبد الله المحلمي عن عبد العزيز بن الخطاب الكوفي عن أبو مسلم الكجي عن الطبراني","ناصح أبو عبد الله عن سماك"
"2029","2031  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ  ، حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  نَاصِحٌ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  أَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِسَدِّ أَبْوَابِ الْمَسْجِدِ كُلِّهَا غَيْرَ بَابِ  عَلِيٍّ  رَضِيَ اللهُ عَنْهُ ، فَقَالَ  الْعَبَّاسُ  : يَا رَسُولَ اللهِ قَدْرَ مَا أَدْخُلُ أَنَا وَحْدِي وَأَخْرُجُ قَالَ : "" مَا أُمِرْتُ بِشَيْءٍ مِنْ ذَلِكَ "" فَسَدَّهَا كُلَّهَا غَيْرَ بَابِ  عَلِيٍّ  وَرُبَّمَا مَرَّ وَهُوَ  جُنُبٌ  .","","Al-Mu'jam al-Kabir 2031","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن ناصح بن عبد الله المحلمي عن إسماعيل بن عمرو البجلي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","ناصح أبو عبد الله عن سماك"
"2030","2032  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  عَبْدُ الْعَزِيزِ بْنُ الْخَطَّابِ ،  ثَنَا  نَاصِحٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَأَنْ يُؤَدِّبَ أَحَدُكُمْ وَلَدَهُ خَيْرٌ لَهُ مِنْ أَنْ يَتَصَدَّقَ كُلَّ يَوْمٍ بِنِصْفِ صَاعٍ عَلَى مَسَاكِينَ  .","","Al-Mu'jam al-Kabir 2032","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن ناصح بن عبد الله المحلمي عن عبد العزيز بن الخطاب الكوفي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","ناصح أبو عبد الله عن سماك"
"2031","2033  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  أَحْمَدُ بْنُ صُبَيْحٍ الْأَسَدِيُّ ،  ثَنَا  يَحْيَى بْنُ يَعْلَى ،  ثَنَا  نَاصِحٌ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  لَمَّا سَأَلَ  أَهْلُ قُبَاءٍ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَبْنِيَ لَهُمْ مَسْجِدًا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لِيَقُومَ بَعْضُكُمْ فَيَرْكَبَ النَّاقَةَ "" ، فَقَامَ  أَبُو بَكْرٍ  رَضِيَ اللهُ عَنْهُ فَرَكِبَهَا فَحَرَّكَهَا فَلَمْ تَنْبَعِثْ ، فَرَجَعَ فَقَعَدَ فَقَامَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ فَرَكِبَهَا فَحَرَّكَهَا فَلَمْ تَنْبَعِثْ فَرَجَعَ فَقَعَدَ ، ثُمَّ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِأَصْحَابِهِ : "" لِيَقُومَ بَعْضُكُمْ فَيَرْكَبَ النَّاقَةَ "" فَقَامَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ ، فَلَمَّا وَضَعَ رِجْلَهُ فِي غَرَزِ الرِّكَابِ وَثَبَّتَ بِهِ ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  عَلِيُّ  أَرْخِ زِمَامَهَا وَابْنُوا عَلَى مَدَارِهَا فَإِنَّهَا مَأْمُورَةٌ  .","","Al-Mu'jam al-Kabir 2033","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن ناصح بن عبد الله المحلمي عن يحيى بن يعلى القطواني عن أحمد بن صبيح الأسدي عن محمد بن عثمان بن أبي شيبة عن الطبراني","ناصح أبو عبد الله عن سماك"
"2032","2034  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  عَبْدُ الْعَزِيزِ بْنُ         [2/247]      الْخَطَّابِ ،  ثَنَا  نَاصِحٌ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَعِدَ الْمِنْبَرَ ، فَقَالَ : "" آمِينَ آمِينَ آمِينَ  ، فَقَالَ : "" أَتَانِي  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، فَقَالَ : يَا  مُحَمَّدُ  مَنْ أَدْرَكَ أَحَدَ وَالِدَيْهِ  فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 2034","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن ناصح بن عبد الله المحلمي عن عبد العزيز بن الخطاب الكوفي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","ناصح أبو عبد الله عن سماك"
"2033","2035  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  يُوسُفُ بْنُ مُوسَى ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبَانَ ،  ثَنَا  نَاصِحٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِعَلِيٍّ  رَضِيَ اللهُ عَنْهُ :  أَنْتَ مِنِّي بِمَنْزِلَةِ  هَارُونَ  مِنْ  مُوسَى  إِلَّا أَنَّهُ لَا نَبِيَّ بَعْدِي  .","","Al-Mu'jam al-Kabir 2035","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن ناصح بن عبد الله المحلمي عن إسماعيل بن أبان عن يوسف بن موسى بن راشد عن عبد الله بن أحمد الجواليقي عن الطبراني","ناصح أبو عبد الله عن سماك"
"2034","2036  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  يُوسُفُ بْنُ مُوسَى ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبَانَ ،  ثَنَا  نَاصِحٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ :  قَالُوا : يَا رَسُولَ اللهِ مَنْ يَحْمِلُ رَايَتَكَ يَوْمَ الْقِيَامَةِ ؟ قَالَ :  مَنْ يُحْسِنُ أَنْ يَحْمِلَهَا إِلَّا مَنْ حَمَلَهَا فِي الدُّنْيَا  عَلِيُّ بْنُ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُ  .","","Al-Mu'jam al-Kabir 2036","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن ناصح بن عبد الله المحلمي عن إسماعيل بن أبان عن يوسف بن موسى بن راشد عن عبد الله بن أحمد الجواليقي عن الطبراني","ناصح أبو عبد الله عن سماك"
"2035","2037  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ بْنِ أَحْمَدَ  ، ثَنَا  يُوسُفُ بْنُ مُوسَى ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبَانَ ،  ثَنَا  نَاصِحٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  قَالَ رَسُولُ اللهِ  لِعَلِيٍّ  رَضِيَ اللهُ عَنْهُ : "" مَنْ أَشْقَى ثَمُودَ "" ؟ قَالَ : مَنْ عَقَرَ النَّاقَةَ ، قَالَ :  فَمَنْ أَشَقَى هَذِهِ الْأُمَّةَ ؟ "" قَالَ : اللهُ أَعْلَمُ ، قَالَ : "" قَاتِلُكَ  .","","Al-Mu'jam al-Kabir 2037","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن ناصح بن عبد الله المحلمي عن إسماعيل بن أبان عن يوسف بن موسى بن راشد عن عبد الله بن أحمد الجواليقي عن الطبراني","ناصح أبو عبد الله عن سماك"
"2036","2038  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ بْنِ الْأَخْرَمِ الْأَصْبَهَانِيُّ  ، ثَنَا  عَبَّادُ بْنُ يَعْقُوبَ ،  ثَنَا  عَلِيُّ بْنُ هَاشِمٍ ،  ثَنَا  نَاصِحٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِعَلِيٍّ  رَضِيَ اللهُ عَنْهُ :  إِنَّكَ امْرُؤٌ مُسْتَخْلَفٌ وَإِنَّكَ مَقْتُولٌ وَهَذِهِ مَخْضُوبَةٌ مِنْ هَذِهِ  لِحْيَتُهُ مِنْ رَأْسِهِ  .","","Al-Mu'jam al-Kabir 2038","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن ناصح بن عبد الله المحلمي عن علي بن هاشم العائذي عن عباد بن يعقوب الرواجني عن محمد بن العباس ابن الأخرم عن الطبراني","ناصح أبو عبد الله عن سماك"
"2037","2039  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ الْعَطَّارُ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ الْعِجْلِيُّ ،  ثَنَا  نَاصِحٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ،         [2/248]      قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَا يَغْدُو يَوْمَ الْفِطْرِ حَتَّى يَأْكُلَ سَبْعَ تَمَرَاتٍ  .","","Al-Mu'jam al-Kabir 2039","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن ناصح بن عبد الله المحلمي عن عبد الله بن صالح العجلي عن الحسين بن إسحاق العطار عن أحمد بن يحيى بن زهير التستري عن الطبراني","ناصح أبو عبد الله عن سماك"
"2038","الْجَرَّاحُ بْنُ الضَّحَّاكِ الْكِنْدِيُّ  عَنْ  سِمَاكٍ  2040  -  حَدَّثَنَا  عَبْدَانُ  ، حَدَّثَنَا  عَلِيُّ بْنُ حَرْبٍ الْجُنْدَيْسَابُورِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ سُلَيْمَانَ ،  ثَنَا  الْجَرَّاحُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرٍ ، قَالَ :  لَمْ يَكُنْ يُؤَذَّنُ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَلَا يُقَامُ فِي الْعِيدَيْنِ  .","","Al-Mu'jam al-Kabir 2040","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الجراح بن الضحاك الكندي عن إسحاق بن سليمان الرازي عن علي بن حرب الجند يسابوري عن عبد الله بن أحمد الجواليقي عن الطبراني","الجراح بن الضحاك الكندي عن سماك"
"2039","عُمَرُ بْنُ عُبَيْدِ الطَّنَافِسِيُّ  عَنْ  سِمَاكٍ  2041  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ أَسَدٍ ،  ثَنَا  عُمَرُ بْنُ عُبَيْدٍ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ بَيْنَ يَدَيِ السَّاعَةِ كَذَّابِينَ  .","","Al-Mu'jam al-Kabir 2041","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن عمر بن عبيد الطنافسي عن أحمد بن أسد بن عاصم بن مغول البجلي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عمر بن عبيد الطنافسي عن سماك"
"2040","2042  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عُمَرُ بْنُ عُبَيْدٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  مَا رُئِيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْطُبُ إِلَّا قَائِمًا  .","","Al-Mu'jam al-Kabir 2042","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن عمر بن عبيد الطنافسي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عمر بن عبيد الطنافسي عن سماك"
"2041","عَمْرُو بْنُ أَبِي قَيْسٍ  عَنْ  سِمَاكٍ  2043  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عُثْمَانُ بْنُ سَعِيدٍ الْبَصْرِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ الدَّشْتَكِيُّ ،  ثَنَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ :  جَاءَ  رَجُلٌ مِنْ بَنِي سُلَيْمٍ  كَانَ فِي  الْحَرَّةِ  هُوَ وَوَلَدُهُ وَكَانَ يَغْشَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  الْمَدِينَةِ  فَإِذَا أَمْسَى أَتَى أَهْلَهُ ، فَمَاتَتْ نَاقَةٌ فَقَالَتْ لَهُ امْرَأَتُهُ : أَطْعِمْنَا لَحْمَهَا فَإِنَّا مُضْطَرُّونَ ، قَالَ : لَا وَاللهِ حَتَّى أُعْلِمَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَتَاهُ فَأَخْبَرَهُ الْخَبَرَ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هَلْ لَكَ مَا يُغْنِيكَ عَنْهَا ؟ "" قَالَ : لَا ، قَالَ : "" اذْهَبْ فَكُلْهَا  فَاسْتَذَابُوا وَدَكَهَا وَاسْتَعَانُوا بِلَحْمِهَا بَقِيَّةَ سَنَتِهِمْ  .","","Al-Mu'jam al-Kabir 2043","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن عمرو بن أبي قيس عن عبد الرحمن بن عبد الله الدشتكي عن عثمان بن محمد بن سعيد الدشتكي عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن أبي قيس عن سماك"
"2042","2044  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  مُوسَى بْنُ سُفْيَانَ الْجُنْدَيْسَابُورِيُّ ،         [2/249]      ثَنَا  عَبْدُ اللهِ بْنُ الْجَهْمِ ،  عَنْ  عَمْرِو بْنِ أَبِي قَيْسٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَكُونُ اثْنَا عَشَرَ أَمِيرًا "" ثُمَّ تَكَلَّمَ بِشَيْءٍ لَمْ أَسْمَعْهُ فَزَعَمَ  الْقَوْمُ  أَنَّهُ قَالَ : "" كُلُّهُمْ مِنْ  قُرَيْشٍ  .","","Al-Mu'jam al-Kabir 2044","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن عمرو بن أبي قيس عن عبد الله بن الجهم الرازي عن موسى بن سفيان الجند يسابوري عن زكريا بن يحيى السجزي عن الطبراني","عمرو بن أبي قيس عن سماك"
"2043","2045  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  مُوسَى بْنُ سُفْيَانَ الْجُنْدَيْسَابُورِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْجَهْمِ ،  عَنْ  عَمْرٍو ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ لَا يَقُومُ مِنْ مَكَانِهِ الَّذِي يُصَلِّي فِيهِ حَتَّى تَطْلُعَ الشَّمْسُ  "" .","","Al-Mu'jam al-Kabir 2045","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن عمرو بن أبي قيس عن عبد الله بن الجهم الرازي عن موسى بن سفيان الجند يسابوري عن زكريا بن يحيى السجزي عن الطبراني","عمرو بن أبي قيس عن سماك"
"2044","2046  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ الْأَصْبَهَانِيُّ  ، ثَنَا  أَبُو مَسْعُودٍ أَحْمَدُ بْنُ الْفُرَاتِ ،  ثَنَا  مُحَمَّدُ بْنُ سَعِيدِ بْنِ سَابِقٍ ،  ثَنَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرٍ ،  أَنَّ  رَجُلًا  قَالَ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنَّ فُلَانًا مَاتَ ، قَالَ : "" لَمْ يَمُتْ  ثَلَاثًا يَقُولُهَا  .","","Al-Mu'jam al-Kabir 2046","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن عمرو بن أبي قيس عن محمد بن سعيد القزويني عن أحمد بن الفرات الضبي عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","عمرو بن أبي قيس عن سماك"
"2045","2047  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  مُوسَى بْنُ سُفْيَانَ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْجَهْمِ ،  عَنْ  عَمْرٍو ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ :  أُتِيَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِقَصْعَةٍ فِيهَا ثُومٌ "" فَبَعَثَ بِهَا إِلَى  أَبِي أَيُّوبَ  فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 2047","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن عمرو بن أبي قيس عن عبد الله بن الجهم الرازي عن موسى بن سفيان الجند يسابوري عن الساجي عن الطبراني","عمرو بن أبي قيس عن سماك"
"2046","2048  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ الْجُذُوعِيُّ الْقَاضِي  ، ثَنَا  عُثْمَانُ بْنُ سَعِيدٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ الدَّشْتَكِيُّ ،  عَنْ  عَمْرٍو ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرٍ ، قَالَ :  قَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي الْغَدَاةَ  فَأَهْوَى  بِيَدِهِ  فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 2048","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن عمرو بن أبي قيس عن عبد الرحمن بن عبد الله الدشتكي عن عثمان بن محمد بن سعيد الدشتكي عن الجذوعى محمد بن محمد بن إسماعيل عن الطبراني","عمرو بن أبي قيس عن سماك"
"2047","الْوَلِيدُ بْنُ أَبِي ثَوْرٍ  عَنْ  سِمَاكٍ  2049  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ، (  ح  )  وَحَدَّثَنَا  يَحْيَى بْنُ عَبْدِ الْبَاقِي الْأَذَنِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ لُوَيْنٌ قَالَا :  ثَنَا  الْوَلِيدُ بْنُ أَبِي ثَوْرٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  جِيءَ  بِمَاعِزٍ  رَجُلٍ قَصِيرٍ مُتَّزِرٍ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُتَّكِئًا عَلَى وِسَادَةٍ ، فَلَمَّا أُتِيَ بِهِ  اجْتَنَحَ  الْوِسَادَةَ فَكَلَّمَهُ فَاحْمَرَّ وَجْهُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَعَرَفَ أَنَّهُ قَدْ أَغْضَبَهُ ، فَأَوْمَأَ بِيَدِهِ أَنِ ارْجُمُوهُ ، ثُمَّ أَرْسَلَ  رَجُلًا  فِي أَثَرِهِ وَكَلَّمَهُ قَلِيلًا ثُمَّ قَالَ :  اذْهَبُوا بِهِ فَارْجُمُوهُ "" فَثَارَ  الْقَوْمُ  ، فَصَعِدَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمِنْبَرَ         [2/250]      فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ثُمَّ قَالَ : "" أَمَا بَعْدُ كُلَّمَا نَفَرْنَا فِي  سَبِيلِ  اللهِ  تَخَلَّفَ  أَحَدُهُمْ لَهُ نَبِيبٌ  كَنَبِيبِ  التَّيْسِ يَمْنَحُ إِحْدَاهُنَّ شَيْئًا ، أَمَا لَئِنْ أَمْكَنَنِي اللهُ مِنْ أَحَدِهِمْ لَأُنَكِّلَنَّ بِهِ  .","","Al-Mu'jam al-Kabir 2049","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الوليد بن عبد الله بن أبي ثور المرهبي عن محمد بن سليمان لوين عن يحيى بن عبد الباقي الثغري عن الطبراني","الوليد بن أبي ثور عن سماك"
"2048","عُمَرُ بْنُ مُوسَى بْنِ وَجِيهٍ  عَنْ  سِمَاكٍ  2050  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عَبْدُ اللهِ بْنُ سَعْدٍ ،  حَدَّثَنَا  عَمِّي ،  ثَنَا  أَبِي  ،  عَنِ  ابْنِ إِسْحَاقَ ،  حَدَّثَنِي  عُمَرُ بْنُ مُوسَى ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" خَرَجَ فِي جِنَازَةِ  ثَابِتِ بْنِ الدَّحْدَاحِ  وَهُوَ عَلَى فَرَسٍ أَغَرَّ مُحَجَّلٍ  لَيْسَ عَلَيْهِ شَيْءٌ وَمَعَهُ النَّاسُ وَهُمْ حَوْلَهُ ، قَالَ : فَنَزَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ جَلَسَ حَتَّى فَرَغَ ثُمَّ قَامَ فَقَعَدَ عَلَى فَرَسِهِ ثُمَّ انْطَلَقَ يَسِيرُ  "" .","","Al-Mu'jam al-Kabir 2050","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن عمر بن موسى بن الوجيه الميثمي عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن عبد الله بن سعد بن إبراهيم بن سعد الزهري عن عبد الله بن أحمد الجواليقي عن الطبراني","عمر بن موسى بن وجيه عن سماك"
"2049","عَمْرُو بْنُ ثَابِتٍ  عَنْ  سِمَاكٍ  2051  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  عَبَّادُ بْنُ يَعْقُوبَ ،  ثَنَا  عَمْرُو بْنُ ثَابِتٍ ،  حَدَّثَنِي  سِمَاكُ بْنُ حَرْبٍ ،  عَنْ  جَابِرٍ ، قَالَ :  مَنْ حَدَّثَكَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَخْطُبُ عَلَى الْمِنْبَرِ النَّاسَ جَالِسًا فَكَذِّبْهُ  ، قَالَ  جَابِرٌ  : وَأَنَا شَاهِدٌ أَنَّهُ كَانَ يَخْطُبُ قَائِمًا ثُمَّ يَجْلِسُ ثُمَّ يَقُومُ فَيَخْطُبُ خُطْبَةَ الْآخِرَةِ ، قَالَ : فَقُلْتُ : كَيْفَ كَانَتْ خُطْبَتُهُ ؟ قَالَ : "" كَلَامًا يَعِظُ بِهِ النَّاسَ وَيَقْرَأُ آيَاتٍ مِنْ كِتَابِ اللهِ وَكَانَتْ  قَصْدًا  ، وَكَانَتْ صَلَاتُهُ  قَصْدًا  بِنَحْوٍ مِنَ : الشَّمْسِ وَضُحَاهَا ،         {      وَالسَّمَاءِ وَالطَّارِقِ         }      ، إِلَّا صَلَاةَ الْغَدَاةِ وَصَلَاةَ الظُّهْرِ ، فَإِنَّ  بِلَالًا  كَانَ يُؤَذِّنُ حِينَ  تَدْحَضُ  الشَّمْسُ وَرُبَّمَا أَخَّرَ الْإِقَامَةَ قَلِيلًا وَرُبَّمَا عَجَّلَهَا ، فَأَمَّا الْأَذَانُ فَلَا يَخْرِمُ عَنِ الْوَقْتِ ، وَالْعَصْرَ نَحْوًا مِمَّا تُصَلُّونَ ، وَالْمَغْرِبَ نَحْوًا مِمَّا تُصَلُّونَ ، وَالْعِشَاءَ الْآخِرَةَ يُؤَخِّرُهَا عَنْ صَلَاتِكُمْ قَلِيلًا  .","","Al-Mu'jam al-Kabir 2051","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن عمرو  بن أبي المقدام عن عباد بن يعقوب الرواجني عن محمد بن عثمان بن أبي شيبة عن الطبراني","عمرو بن ثابت عن سماك"
"2050","[2/251]      يَزِيدُ بْنُ عَطَاءٍ  عَنْ  سِمَاكٍ  2052  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ، (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  عَنْ  يَزِيدَ بْنِ عَطَاءٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرٍ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي الصَّلَوَاتِ كَنَحْوٍ مِنْ صَلَاتِكُمْ ،  كَانَ يُصَلِّي الظُّهْرَ حِينَ تَزُولُ الشَّمْسُ  ، وَكَانَ  يَقْرَأُ  فِي صَلَاةِ الْفَجْرِ بِـ         {      ق وَالْقُرْآنِ الْمَجِيدِ         }      ، وَ         {      يس         }      وَنَحْوِ ذَلِكَ  "" .","","Al-Mu'jam al-Kabir 2052","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن يزيد بن عطاء بن يزيد اليشكري عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","يزيد بن عطاء عن سماك"
"2051","مُفَضَّلُ بْنُ صَالِحٍ  عَنْ  سِمَاكٍ  2053  -  حَدَّثَنَا  مُحَمَّدُ بْنُ فَضَاءٍ الْجَوْهَرِيُّ  ، ثَنَا  أَحْمَدُ بْنُ بُدَيْلٍ ،  ثَنَا  مُفَضَّلُ بْنُ صَالِحٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  صَلَّيْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَاةً مَكْتُوبَةً فَضَمَّ يَدَيْهِ فِي الصَّلَاةِ ، فَلَمَّا قَضَى الصَّلَاةَ قُلْنَا : يَا رَسُولَ اللهِ أَحَدَثَ فِي الصَّلَاةِ شَيْءٌ ؟ قَالَ :  لَا إِلَّا أَنَّ الشَّيْطَانَ أَرَادَ أَنْ يَمُرَّ بَيْنَ يَدَيَّ فَخَنَقْتُهُ حَتَّى وَجَدْتُ بَرْدَ لِسَانِهِ عَلَى يَدَيَّ  ، وَأَيْمُ اللهِ لَوْلَا مَا سَبَقَنِي إِلَيْهِ أَخِي  سُلَيْمَانُ  لَنِيطَ  إِلَى سَارِيَةٍ مِنْ  سَوَارِي  الْمَسْجِدِ حَتَّى يُطِيفَ بِهِ وِلْدَانُ  أَهْلِ الْمَدِينَةِ  .","","Al-Mu'jam al-Kabir 2053","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن المفضل بن صالح النخاس عن أحمد بن بديل اليامى عن محمد بن قضاء الجوهري عن الطبراني","مفضل بن صالح عن سماك"
"2052","أَيُّوبُ بْنُ جَابِرٍ  عَنْ  سِمَاكٍ  2054  -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ وَاقِدٍ ،  ثَنَا  أَبِي  ،  ثَنَا  أَيُّوبُ بْنُ جَابِرٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرٍ ،  أَنَّ "" جَرْمَقَانِيًّا أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 2054","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن أيوب بن جابر السحيمي عن عبد الرحمن بن واقد الواقدي عن عبيد الله بن أبي مسلم الواقدي عن الطبراني","أيوب بن جابر عن سماك"
"2053","2055  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَبَانَ الْوَاسِطِيُّ ،  ثَنَا  أَيُّوبُ بْنُ جَابِرٍ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ""         [2/252]      يُصَلِّي الصَّلَاةَ الْمَكْتُوبَةَ صَلَاةَ وَسَطٍ لَا يُطِيلُ فِيهَا  ، وَلَا يُخِفُّ وَكَانَ يُؤَخِّرُ  الْعَتَمَةَ  "" .","","Al-Mu'jam al-Kabir 2055","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن أيوب بن جابر السحيمي عن محمد بن أبان بن عمران السلمي عن الحسين بن إسحاق التستري عن الطبراني","أيوب بن جابر عن سماك"
"2054","2056  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ خُزَيْمَةَ الْبَصْرِيُّ ،  ثَنَا  أَبِي ،  ثَنَا  إِسْحَاقُ بْنُ إِدْرِيسَ ،  حَدَّثَنَا  أَيُّوبُ بْنُ جَابِرٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  رَأَيْتُ خَاتَمَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَإِذَا هُوَ عِنْدَ كَتِفِهِ كَبَيْضَةِ الْحَمَامَةِ  .","","Al-Mu'jam al-Kabir 2056","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن أيوب بن جابر السحيمي عن إسحاق بن إدريس الأسواري عن والد محمد بن أحمد بن خزيمة البصري عن محمد بن أحمد بن خزيمة البصري عن الطبراني","أيوب بن جابر عن سماك"
"2055","مُحَمَّدُ بْنُ الْفَضْلِ بْنِ عَطِيَّةَ  عَنْ  سِمَاكٍ  2057  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ رَاشِدٍ الْأَدَمِيُّ ،  ثَنَا  دَاوُدُ بْنُ مِهْرَانَ ،  ثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ بْنِ عَطِيَّةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ الْحَيَوَانِ بِالْحَيَوَانِ  نَسِيئَةً  .","","Al-Mu'jam al-Kabir 2057","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن محمد بن الفضل بن عطية العبسي عن داود بن مهران الدباغ عن إبراهيم بن راشد بن سليمان الآدمي عن أحمد بن يحيى بن زهير التستري عن الطبراني","محمد بن الفضل بن عطية عن سماك"
"2056","عَائِذُ بْنُ نُصَيْبٍ  عَنْ  جَابِرِ بْنِ سَمُرَةَ  2058  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلَطِيُّ  ، حَدَّثَنَا  أَبُو نُعَيْمٍ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ، (  ح  )  وَحَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ، قَالُوا :  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  عَائِذِ بْنِ نُصَيْبٍ ، قَالَ :  سَمِعْتُ  جَابِرَ بْنَ سَمُرَةَ ، يَقُولُ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يُشِيرُ  بِإِصْبَعِهِ وَهُوَ فِي الصَّلَاةِ ، فَلَمَّا سَلَّمَ سَمِعْتُهُ يَقُولُ :  اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنَ الْخَيْرِ كُلِّهِ مَا عَلِمْتُ مِنْهُ وَمَا لَمْ أَعْلَمْ  ، وَأَعُوذُ بِكَ مِنَ الشَّرِّ كُلِّهِ مَا عَلِمْتُ مِنْهُ وَمَا لَمْ أَعْلَمْ  .","","Al-Mu'jam al-Kabir 2058","","جابر بن سمرة السوائي عن عائذ بن نصيب الأسدي عن قيس بن الربيع الأسدي عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","عائذ بن نصيب عن جابر بن سمرة"
"2057","[2/253]      الْأَسْوَدُ بْنُ سَعِيدٍ الْهَمْدَانِيُّ  عَنْ  جَابِرِ بْنِ سَمُرَةَ  2059  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عِقَالٍ الْحَرَّانِيُّ  ، ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ، قَالَا :  ثَنَا  زُهَيْرٌ ،  ثَنَا  زِيَادُ بْنُ خَيْثَمَةَ ،  عَنِ  الْأَسْوَدِ بْنِ سَعِيدٍ الْهَمْدَانِيِّ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَزَالُ هَذِهِ الْأُمَّةُ مُسْتَقِيمًا أَمْرُهَا ظَاهِرَةً عَلَى عَدُوِّهَا حَتَّى يَمْضِيَ مِنْهُمُ اثْنَا عَشَرَ  خَلِيفَةً  كُلُّهُمْ مِنْ  قُرَيْشٍ  فَلَمَّا رَجَعَ إِلَى مَنْزِلِهِ أَتَتْهُ  قُرَيْشٌ  ، قَالُوا : ثُمَّ يَكُونُ مَاذَا ؟ قَالَ : "" ثُمَّ يَكُونُ  الْهَرْجُ  .","","Al-Mu'jam al-Kabir 2059","","جابر بن سمرة السوائي عن الأسود بن سعيد الهمداني عن زياد بن خيثمة الجعفي عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","الأسود بن سعيد الهمداني عن جابر بن سمرة"
"2058","النَّضْرُ بْنُ صَالِحٍ  عَنْ  جَابِرِ بْنِ سَمُرَةَ  2060  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَمَّارُ بْنُ خَالِدٍ ،  ثَنَا  إِسْحَاقُ الْأَزْرَقُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ ،  عَنِ  النَّضْرِ بْنِ صَالِحٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كُنْتُ مَعَ أَبِي وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْطُبُ ، فَقَالَ :  لَا تَبْرَحُونَ بِخَيْرٍ مَا قَامَ عَلَيْكُمُ اثْنَا عَشَرَ أَمِيرًا  ، قُلْتُ لِأَبِي : سَمِعْتَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ آنِفًا كَذَلِكَ ؟ قَالَ أَبِي : قَدْ قَالَ : "" كُلُّهُمْ مِنْ  قُرَيْشٍ  .","","Al-Mu'jam al-Kabir 2060","","جابر بن سمرة السوائي عن النضر بن صالح العبسي عن عبد الملك بن أبي سليمان العرزمي عن إسحاق بن يوسف الأزرق عن عمار بن خالد بن يزيد التمار عن محمد بن عبد الله مطين الحضرمي عن الطبراني","النضر بن صالح عن جابر بن سمرة"
"2059","زِيَادُ بْنُ عِلَاقَةَ  عَنْ  جَابِرِ بْنِ سَمُرَةَ  2061  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ الصَّفَّارُ ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَزَالُ أُمَّتِي عَلَى الْحَقِّ ظَاهِرِينَ حَتَّى يَكُونَ عَلَيْهِمُ اثْنَا عَشَرَ أَمِيرًا كُلُّهُمْ مِنْ  قُرَيْشٍ  .","","Al-Mu'jam al-Kabir 2061","","جابر بن سمرة السوائي عن زياد بن علاقة الثعلبي عن سفيان الثوري عن معاوية بن هشام القصار عن عبدة بن عبد الله بن عبدة الخزاعي عن عبد الله بن أحمد الجواليقي عن الطبراني","زياد بن علاقة عن جابر بن سمرة"
"2060","2062  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَلِيِّ بْنِ الْجَارُودِ الْأَصْبَهَانِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ سَعِيدٍ الْكِنْدِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ مَالِكٍ الْهَمْدَانِيُّ ، قَالَ :  سَمِعْتُ  زِيَادَ بْنَ عِلَاقَةَ ، وَعَبْدَ الْمَلِكِ بْنَ عُمَيْرٍ ،  يُحَدِّثَانِ عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كُنْتُ مَعَ أَبِي عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَسَمِعْتُهُ يَقُولُ :  يَكُونُ بَعْدِي اثْنَا عَشَرَ أَمِيرًا  ، ثُمَّ أَخْفَى         [2/254]      صَوْتَهُ  فَقُلْتُ  لِأَبِي : قَدْ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : "" يَكُونُ بَعْدِي اثْنَا عَشَرَ أَمِيرًا "" فَمَا الَّذِي أَخْفَى صَوْتَهُ ؟ قَالَ : "" كُلُّهُمْ مِنْ  قُرَيْشٍ  .","","Al-Mu'jam al-Kabir 2062","","سمرة بن جنادة السوائي عن جابر بن سمرة السوائي عن زياد بن علاقة الثعلبي عن إبراهيم بن محمد بن مالك الخيوانى عن عبد الله بن سعيد الأشج عن الجارودي أحمد بن علي الأصبهاني عن الطبراني","زياد بن علاقة عن جابر بن سمرة"
"2061","2063  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  ثَنَا  زُهَيْرٌ ،  عَنْ  سِمَاكٍ ، وَزِيَادِ بْنِ عِلَاقَةَ ، وَحُصَيْنٍ ،  عَنْ  جَابِرٍ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَكُونُ مِنْ بَعْدِي اثْنَا عَشَرَ أَمِيرًا  ثُمَّ تَكَلَّمَ بِشَيْءٍ لَمْ أَسْمَعْهُ ، فَسَأَلْتُ أَبِي مَا قَالَ ؟ فَقَالَ : "" كُلُّهُمْ مِنْ  قُرَيْشٍ  .","","Al-Mu'jam al-Kabir 2063","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زهير بن معاوية بن حديج عن علي بن الجعد عن موسى بن هارون الحمال عن الطبراني","زياد بن علاقة عن جابر بن سمرة"
"2062","2064  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدٍ الْهَمْدَانِيُّ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ (  ح  ) قَالَ  سَهْلٌ  :  وَثَنَا  عَبْدُ الرَّحِيمِ ،  عَنْ  يَاسِينَ الزَّيَّاتِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  تَمِيمٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَصَابَ الْعَدُوُّ نَاقَةَ  رَجُلٍ  مِنَ الْمُسْلِمِينَ فَاشْتَرَاهَا  رَجُلٌ  مِنَ الْمُسْلِمِينَ فَعَرَفَهَا صَاحِبُهَا ، فَأَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فَأَمَرَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَأْخُذَهَا بِالثَّمَنِ الَّذِي اشْتَرَاهَا بِهِ مِنَ الْعَدُوِّ ، وَإِلَّا خَلَّى بَيْنَهُ وَبَيْنَهَا  .","","Al-Mu'jam al-Kabir 2064","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن سماك بن حرب البكري عن ياسين بن معاذ الزيات عن عبد الرحيم بن سليمان الأشل عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","زياد بن علاقة عن جابر بن سمرة"
"2063","حُصَيْنُ بْنُ عَبْدِ الرَّحْمَنِ  عَنْ  جَابِرِ بْنِ سَمُرَةَ  2065  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  ثَنَا  الرَّبِيعُ بْنُ سَهْلٍ الْوَاسِطِيُّ ،  ثَنَا  حُصَيْنُ بْنُ عَبْدِ الرَّحْمَنِ السُّلَمِيُّ ،  حَدَّثَنِي  جَابِرُ بْنُ سَمُرَةَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ أَهْلَ الدَّرَجَاتِ الْعُلَى يَرَاهُمْ مَنْ هُوَ أَسْفَلُ مِنْهُمْ كَمَا يُرَى الْكَوْكَبُ  الدُّرِّيُّ  فِي أُفُقِ السَّمَاءِ  وَأَبُو بَكْرٍ  وَعُمَرُ  مِنْهُمْ وَأَنْعِمَا  .","","Al-Mu'jam al-Kabir 2065","","جابر بن سمرة السوائي عن حصين بن عبد الرحمن السلمي عن الربيع بن سهل الواسطي عن عبيد الله بن عمر القواريري عن عبد الله بن أحمد بن حنبل عن الطبراني","حصين بن عبد الرحمن عن جابر بن سمرة"
"2064","2066  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عَبْدُ اللهِ بْنُ حَمَّادِ بْنِ نُمَيْرٍ  ،  ثَنَا  حُصَيْنُ بْنُ نُمَيْرٍ ،  ثَنَا  حُصَيْنٌ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :         [2/255]      أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ خَلْفِهِ لِأَنْظُرَ إِلَى مَوْضِعِ الْخَاتَمِ  ، فَلَمَّا نَظَرَ إِلَيَّ أَلْقَى رِدَاءَهُ فَنَظَرْتُ إِلَيْهِ  .  زاد بعده في طبعة مكتبة ابن تيمية : ( ثنا حصين عن نمير ) وهي زيادة خطأ والمثبت من النسخ الخطية","","Al-Mu'jam al-Kabir 2066","","جابر بن سمرة السوائي عن حصين بن عبد الرحمن السلمي عن حصين بن نمير الأنصاري عن عبد الله بن حماد بن نمير عن عبد الله بن أحمد الجواليقي عن الطبراني","حصين بن عبد الرحمن عن جابر بن سمرة"
"2065","2067  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  عَمْرُو بْنُ عَوْنٍ ،  ثَنَا  خَالِدٌ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  حُصَيْنٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَقُومُ مِنْ بَعْدِي اثْنَا عَشَرَ أَمِيرًا  ثُمَّ تَكَلَّمَ بِشَيْءٍ لَمْ أَسْمَعْهُ فَسَأَلْتُ  الْقَوْمَ  وَسَأَلْتُ أَبِي مَا قَالَ ؟ وَكَانَ أَقْرَبَ إِلَيْهِ مِنِّي ، فَقَالَ : "" كُلُّهُمْ مِنْ  قُرَيْشٍ  .","","Al-Mu'jam al-Kabir 2067","","جابر بن سمرة السوائي عن حصين بن عبد الرحمن السلمي عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","حصين بن عبد الرحمن عن جابر بن سمرة"
"2066","2068  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلُّوَيْهِ الْقَطَّانُ  ، ثَنَا  إِسْمَاعِيلُ بْنُ عِيسَى الْعَطَّارُ ،  ثَنَا  مُحَمَّدُ بْنُ حِمْيَرَ ،  عَنْ  إِسْمَاعِيلَ بْنِ عَيَّاشٍ ،  عَنْ  جَعْفَرِ بْنِ الْحَارِثِ ،  عَنْ  حُصَيْنِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  دَخَلْتُ مَعَ أَبِي عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  إِنَّ هَذَا الْأَمْرَ لَنْ يَمْضِيَ وَلَنْ يَنْقَضِيَ حَتَّى يَنْقَضِيَ اثْنَا عَشَرَ  خَلِيفَةً  ثُمَّ تَكَلَّمَ بِشَيْءٍ لَمْ أَفْهَمْهُ ، قُلْتُ لِأَبِي : مَا الَّذِي قَالَ ؟ قَالَ : "" كُلُّهُمْ مِنْ  قُرَيْشٍ  .","","Al-Mu'jam al-Kabir 2068","","جابر بن سمرة السوائي عن حصين بن عبد الرحمن السلمي عن جعفر بن الحارث الواسطي عن إسماعيل بن عياش الأحول عن محمد بن حمير القضاعي عن إسماعيل بن عيسى البغدادي عن ابن علويه الحسن بن علي القطان عن الطبراني","حصين بن عبد الرحمن عن جابر بن سمرة"
"2067","2069  -  حَدَّثَنَا  مُحَمَّدُ بْنُ هِشَامٍ الْمُسْتَمْلِي ،  ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  حُصَيْنِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2069","","جابر بن سمرة السوائي عن حصين بن عبد الرحمن السلمي عن سفيان بن عيينة عن علي ابن المديني عن ابن أبى الدميك محمد بن هشام بن علي عن الطبراني","حصين بن عبد الرحمن عن جابر بن سمرة"
"2068","أَبُو بَكْرِ بْنُ أَبِي مُوسَى  عَنْ  جَابِرِ بْنِ سَمُرَةَ  2070  -  حَدَّثَنَا  مُحَمَّدُ بْنُ اللَّيْثِ الْجَوْهَرِيُّ ، وَأَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ، قَالَا :  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  عُمَرُ بْنُ عُبَيْدٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَكُونُ بَعْدِي اثْنَا عَشَرَ أَمِيرًا  ثُمَّ تَكَلَّمَ فَخَفِيَ عَلَيَّ  فَسَأَلْتُ  الَّذِي يَلِينِي ، فَقَالَ : "" كُلُّهُمْ مِنْ  قُرَيْشٍ  .","","Al-Mu'jam al-Kabir 2070","","سمرة بن جنادة السوائي عن جابر بن سمرة السوائي عن سماك بن حرب البكري عن عمر بن عبيد الطنافسي عن أبو كريب محمد بن العلاء عن أحمد بن يحيى بن زهير التستري عن الطبراني","أبو بكر بن أبي موسى عن جابر بن سمرة"
"2069","2071  -  حَدَّثَنَا  مُحَمَّدُ بْنُ اللَّيْثِ ، وَأَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ، قَالَا :  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  عُمَرُ بْنُ عُبَيْدٍ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِي بَكْرِ بْنِ أَبِي مُوسَى ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2071","","جابر بن سمرة السوائي عن أبو بكر بن أبي موسى الأشعري عن عبيد بن أبي أمية الطنافسي عن عمر بن عبيد الطنافسي عن أبو كريب محمد بن العلاء عن أحمد بن يحيى بن زهير التستري عن الطبراني","أبو بكر بن أبي موسى عن جابر بن سمرة"
"2070","[2/256]      عَلِيُّ بْنُ عُمَارَةَ  عَنْ  جَابِرِ بْنِ سَمُرَةَ  2072  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالَا :  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  أَبُو أُسَامَةَ  عَنْ  زَكَرِيَّا بْنِ سِيَاهٍ ،  حَدَّثَنِي  عِمْرَانُ بْنُ رَبَاحٍ ،  عَنْ  عَلِيِّ بْنِ عُمَارَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  كُنْتُ فِي مَجْلِسِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَسَمُرَةُ  وَأَبُو أُمَامَةَ  ، فَقَالَ :  إِنَّ  الْفُحْشَ  وَالتَّفَحُّشَ لَيْسَا مِنَ الْإِسْلَامِ فِي شَيْءٍ وَإِنَّ أَحْسَنَ النَّاسِ إِسْلَامًا أَحَاسِنُهُمْ  أَخْلَاقًا  .","","Al-Mu'jam al-Kabir 2072","","جابر بن سمرة السوائي عن علي بن عمارة عن عمران بن مسلم بن رياح الثقفي عن زكريا بن سياه الثقفي عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","علي بن عمارة عن جابر بن سمرة"
"2071","عَطَاءُ بْنُ أَبِي مَيْمُونَةَ  عَنْ  جَابِرِ بْنِ سَمُرَةَ  2073  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  رَوْحُ بْنُ عَطَاءِ بْنِ أَبِي مَيْمُونَةَ ،  عَنْ  عَطَاءِ بْنِ أَبِي مَيْمُونَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَخْطُبُ عَلَى الْمِنْبَرِ وَيَقُولُ :  اثْنَا عَشَرَ قَيِّمًا مِنْ  قُرَيْشٍ  لَا يَضُرُّهُمْ عَدَاوَةُ مَنْ عَادَاهُمْ  قَالَ : فَالْتَفَتُّ خَلْفِي فَإِذَا أَنَا بِعُمَرَ بْنِ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ وَأَبِي فِي نَاسٍ فَأَثْبَتُوا لِيَ الْحَدِيثَ كَمَا سَمِعْتُ .","","Al-Mu'jam al-Kabir 2073","","جابر بن سمرة السوائي عن عطاء بن أبي ميمونة البصرى عن روح بن عطاء بن أبي ميمونة البصري عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","عطاء بن أبي ميمونة عن جابر بن سمرة"
"2072","مَيْسَرَةُ مَوْلَى جَابِرِ بْنِ سَمُرَةَ  عَنْ  جَابِرِ بْنِ سَمُرَةَ  2074  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالَا :  ثَنَا  أَحْمَدُ بْنُ مَالِكٍ الْغُبَرِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ ،  حَدَّثَنِي  أَبُو مُحَمَّدٍ السُّوَائِيُّ مِنْ وَلَدِ جَابِرِ بْنِ سَمُرَةَ ،  عَنْ  عَمِّهِ حَرْبِ بْنِ خَالِدٍ ،  عَنْ  مَيْسَرَةَ مَوْلَى جَابِرِ بْنِ سَمُرَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَعَنَ اللهُ مَنْ بَدَا بَعْدَ هِجْرَةٍ ، لَعَنَ اللهُ مَنْ بَدَا بَعْدَ هِجْرَةٍ  ، لَعَنَ اللهُ مَنْ بَدَا بَعْدَ هِجْرَةٍ ،         [2/257]      إِلَّا فِي فِتْنَةٍ ، فَإِنَّ الْبَدْوَ خَيْرٌ مِنَ الْمَقَامِ فِي الْفِتْنَةِ  .","","Al-Mu'jam al-Kabir 2074","","جابر بن سمرة السوائي عن ميسرة مولى سمرة بن جندب عن حرب بن خالد بن جابر السوائي عن أبو محمد السوائي من ولد جابر بن سمرة عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن أحمد بن مالك الغبري عن عبد الله بن أحمد الجواليقي عن الطبراني","ميسرة مولى جابر بن سمرة عن جابر بن سمرة"
"2073","أَبُو تَمِيمَةَ الْهُجَيْمِيُّ  عَنْ  جَابِرِ بْنِ سَمُرَةَ  2075  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ  ، ثَنَا  تَمِيمُ بْنُ الْمُنْتَصِرِ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  ثَنَا  أَبُو جَنَابٍ ،  عَنْ  أَبِي تَمِيمَةَ الْهُجَيْمِيِّ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلَا تَصُفُّونَ كَمَا تَصُفُّ الْمَلَائِكَةُ عِنْدَ رَبِّهِمْ ؟  قَالُوا : يَا رَسُولَ اللهِ وَكَيْفَ تَصُفُّ الْمَلَائِكَةُ عِنْدَ رَبِّهِمْ ؟ قَالَ : "" يُتِمُّونَ الصُّفُوفَ الْمُقَدَّمَةَ وَيَتَرَاصُّونَ فِي الصَّفِّ  .","","Al-Mu'jam al-Kabir 2075","","جابر بن سمرة السوائي عن طريف بن مجالد الهجيمي عن يحيى بن أبي حية عن يزيد بن هارون عن تميم بن المنتصر مولى ابن عباس عن بحشل عن الطبراني","أبو تميمة الهجيمي عن جابر بن سمرة"
"2074","195 -  جَابِرُ بْنُ أُسَامَةَ الْجُهَنِيُّ  2076  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ الْعَطَّارُ الْمَكِّيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى التَّيْمِيُّ  ،  ثَنَا  أُسَامَةُ بْنُ زَيْدٍ ،  عَنْ  مُعَاذِ بْنِ عَبْدِ اللهِ بْنِ خُبَيْبٍ ،  عَنْ  جَابِرِ بْنِ أُسَامَةَ الْجُهَنِيِّ ، قَالَ :  ذَهَبْتُ إِلَى السُّوقِ فَلَقِيتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي أَصْحَابِهِ سَأَلْتُهُمْ أَيْنَ يُرِيدُ ؟ فَقَالُوا :  يَخُطُّ  لِقَوْمِكَ مَسْجِدًا فَرَجَعْتُ فَوَجَدْتُ قَوْمِي قِيَامًا فَقُلْتُ : مَا بَالُكُمْ ؟ فَقَالُوا :  خَطَّ لَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَسْجِدًا بِرِجْلِهِ ، وَأَقَامَ فِي الْقِبْلَةِ خَشَبَةً غَرَزَهَا فِيهِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عبد الله بن موسى التيمي )","","Al-Mu'jam al-Kabir 2076","","جابر بن أسامة الأنصاري عن معاذ بن عبد الله بن خبيب الجهني عن أسامة بن زيد الليثي المدني عن عبد الله بن موسى بن إبراهيم الطلحي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","جابر بن أسامة الجهني"
"2075","196 -  جَابِرٌ أَبُو عَبْدِ اللهِ الْعَبْدِيُّ  رَحِمَهُ اللهُ  2077  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو عُبَيْدٍ الْقَاسِمُ بْنُ سَلَّامٍ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  (  ح  )  وَحَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  أَحْمَدُ بْنُ حَنْبَلٍ ، قَالَا :  ثَنَا  أَبُو مُرَّةَ الْحَارِثُ بْنُ مُرَّةَ بْنِ مُجَّاعَةَ الْيَمَامِيُّ ،  ثَنَا  نَفِيسٌ ،  عَنْ  عَبْدِ اللهِ بْنِ جَابِرٍ يَعْنِي الْعَبْدِيَّ ، قَالَ :  كُنْتُ فِي الْوَفْدِ الَّذِينَ أَنْزَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ  عَبْدِ الْقَيْسِ  وَلَسْتُ مِنْهُمْ ،         [2/258]      وَإِنَّمَا كُنْتُ مَعَ أَبِي قَالَ :  فَنَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الشُّرْبِ فِي  الدُّبَّاءِ  وَالْحَنْتَمِ  وَالنَّقِيرِ  وَالْمُزَفَّتِ  .","","Al-Mu'jam al-Kabir 2077","","عبد الله بن جابر العبدي عن نفيس البصري عن الحارث بن مرة اليمامي عن أحمد بن حنبل عن موسى بن هارون الحمال عن الطبراني","جابر أبو عبد الله العبدي"
"2076","-  جَابِرُ بْنُ طَارِقٍ أَبُو حَكِيمٍ الْأَحْمَسِيُّ  2078  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، قَالَ : سَمِعْتُ  مُحَمَّدَ بْنَ عَبْدِ اللهِ بْنِ نُمَيْرٍ  ، يَقُولُ :  جَابِرُ بْنُ أَبِي طَارِقٍ  رَوَى عَنْهُ ابْنُهُ حَدِيثًا عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" كَذَا قَالَ  ابْنُ نُمَيْرٍ  :  جَابِرُ بْنُ أَبِي طَارِقٍ  .","","Al-Mu'jam al-Kabir 2078","","","جابر بن طارق أبو حكيم الأحمسي"
"2077","2079  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  عَنْ  عُمَرَ بْنِ أَبِي زَائِدَةَ ، قَالَ :  رَأَيْتُ حَكِيمَ بْنَ جَابِرٍ يَخْضِبُ بِالصُّفْرَةِ  "" .","","Al-Mu'jam al-Kabir 2079","","حكيم بن جابر الأحمسي عن عمر بن أبي زائدة الهمداني عن زيد بن الحباب العكلي عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","جابر بن طارق أبو حكيم الأحمسي"
"2078","2080  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  ابْنُ الْأَصْبَهَانِيِّ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  شَرِيكٌ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  حَكِيمِ بْنِ جَابِرٍ ،  عَنْ  أَبِيهِ ،  قَالَ :  دَخَلْتُ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَعِنْدَهُ  دُبَّاءٌ  فَقُلْتُ : مَا تَصْنَعُونَ ؟ قَالَ :  نُكَثِّرُ بِهِ طَعَامَنَا  .","","Al-Mu'jam al-Kabir 2080","","جابر بن طارق الأحمسي عن حكيم بن جابر الأحمسي عن إسماعيل بن أبي خالد عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","جابر بن طارق أبو حكيم الأحمسي"
"2079","2081  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  حَكِيمِ بْنِ جَابِرٍ الْأَحْمَسِيِّ ،  عَنْ  أَبِيهِ  ، قَالَ :  دَخَلْتُ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَرَأَيْتُ عِنْدَهُ  الدُّبَّاءَ  فَقُلْتُ : مَا هَذَا يَا رَسُولَ اللهِ ؟ قَالَ :  نُكَثِّرُ بِهِ طَعَامَ أَهْلِنَا  .","","Al-Mu'jam al-Kabir 2081","","جابر بن طارق الأحمسي عن حكيم بن جابر الأحمسي عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","جابر بن طارق أبو حكيم الأحمسي"
"2080","2082  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  حَكِيمِ بْنِ جَابِرٍ ،  عَنْ  أَبِيهِ ،  قَالَ :  دَخَلْتُ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَعِنْدَهُ هَذَا  الدُّبَّاءُ  فَقُلْتُ : أَيُّ شَيْءٍ هَذَا ؟ فَقَالَ :  هَذَا  الدُّبَّاءُ  هَذَا الْقَرْعُ نُكَثِّرُ بِهِ طَعَامَنَا  .","","Al-Mu'jam al-Kabir 2082","","جابر بن طارق الأحمسي عن حكيم بن جابر الأحمسي عن إسماعيل بن أبي خالد عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","جابر بن طارق أبو حكيم الأحمسي"
"2081","[2/259]      2083  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  حَكِيمِ بْنِ جَابِرٍ ،  عَنْ  أَبِيهِ ،  قَالَ :  رَأَيْتُ عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَرْعًا ، فَقُلْتُ : مَا هَذَا ؟ قَالَ : "" نُكَثِّرُ بِهِ طَعَامَنَا  .","","Al-Mu'jam al-Kabir 2083","","جابر بن طارق الأحمسي عن حكيم بن جابر الأحمسي عن إسماعيل بن أبي خالد عن محمد بن بشر بن الفرافصة عن محمد بن عبد الله بن نمير عن محمد بن عبد الله مطين الحضرمي عن الطبراني","جابر بن طارق أبو حكيم الأحمسي"
"2082","2084  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ الْفَرَحِ الْهَاشِمِيُّ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  حَكِيمِ بْنِ جَابِرِ بْنِ طَارِقٍ ، قَالَ :  كَانَ أَهْلُنَا يَصْنَعُونَ الْقَرْعَ ،  فَقَالَ لِي  جَابِرُ بْنُ طَارِقٍ : قَدْ رَأَيْتُ هَذَا عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، فَقُلْتُ : يَا رَسُولَ اللهِ مَا هَذَا ؟ قَالَ : "" شَيْءٌ نُكَثِّرُ بِهِ طَعَامَنَا  .","","Al-Mu'jam al-Kabir 2084","","جابر بن طارق الأحمسي عن حكيم بن جابر الأحمسي عن إسماعيل بن أبي خالد عن حماد بن أسامة القرشي عن سليمان بن الفرح الهاشمي عن أبو مسلم الكجي عن الطبراني","جابر بن طارق أبو حكيم الأحمسي"
"2083","2085  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ ،  ثَنَا  مُحَمَّدُ بْنُ مَحْبُوبٍ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  حَكِيمِ بْنِ جَابِرٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  رَأَيْتُ بَيْنَ يَدَيْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَرْعًا مَقْطُوعًا فَقُلْتُ : مَا تَصْنَعُ بِهَذَا ؟ قَالَ :  نُكَثِّرُ بِهِ طَعَامَنَا  .","","Al-Mu'jam al-Kabir 2085","","جابر بن طارق الأحمسي عن حكيم بن جابر الأحمسي عن إسماعيل بن أبي خالد عن حفص بن غياث النخعي عن محمد بن محبوب البناني عن محمد بن محمد بن حيان التمار عن الطبراني","جابر بن طارق أبو حكيم الأحمسي"
"2084","-  جَبْرُ بْنُ أَنَسٍ بَدْرِيٌّ  2086  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ،  قَالَ فِي كِتَابِ  عُبَيْدِ اللهِ بْنِ أَبِي رَافِعٍ  : ""  فِي تَسْمِيَةِ مَنْ شَهِدَ مَعَ  عَلِيِّ بْنِ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُ ،  وَجَبَرُ بْنُ أَنَسٍ  بَدْرِيٌّ مِنْ  بَنِي زُرَيْقٍ  "" .","","Al-Mu'jam al-Kabir 2086","","","جبر بن أنس"
"2085","199 -  جَارِيَةُ بْنُ ظَفَرٍ أَبُو نِمْرَانَ الْحَنَفِيُّ  2087  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ، (  ح  )         [2/260]      وَحَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ، قَالَا :  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  ثَنَا  دَهْثَمُ بْنُ قُرَّانٍ ،  ثَنَا  نِمْرَانُ بْنُ جَارِيَةَ الْحَنَفِيُّ ،  عَنْ  أَبِيهِ  ، قَالَ :  اخْتَصَمَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَوْمٌ فِي  خُصٍّ  ، فَبَعَثَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  حُذَيْفَةَ  يَقْضِي بَيْنَهُمْ  ، فَقَضَى لِلَّذِي يَلِيهِمُ  الْقِمْطُ  ، فَلَمَّا رَجَعَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَبَّرَهُ ، فَقَالَ : ""  أَصَبْتَ أَوْ أَحْسَنْتَ  .","","Al-Mu'jam al-Kabir 2087","","جارية بن ظفر اليمامي عن نمران بن جارية بن ظفر الحنفي عن دهثم بن قران العكلي عن أبو بكر بن عياش عن هدبة بن خالد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","جارية بن ظفر أبو نمران الحنفي"
"2086","2088  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  ثَنَا  دَهْثَمُ بْنُ قُرَّانٍ ،  عَنْ  عَقِيلِ بْنِ دِينَارٍ مَوْلَى جَارِيَةَ بْنِ ظَفَرٍ ،  عَنْ  جَارِيَةَ بْنِ ظَفَرٍ ،  أَنَّ أَخَوَيْنِ كَانَ بَيْنَهُمَا حِظَارٌ وَسَطَ دَارٍ فَمَاتَا وَتَرَكَ كُلُّ وَاحِدٍ مِنْهُمَا عَقِبًا ، فَادَّعَى عَقِبُ كُلِّ وَاحِدٍ مِنْهُمَا أَنَّ الْحِظَارَ لَهُ دُونَ صَاحِبِهِ ، فَاخْتَصَمَا إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فَأَرْسَلَ مَعَهُمَا  حُذَيْفَةَ بْنَ الْيَمَانِ  ، فَقَضَى بِالْحِظَارِ لِمَنْ وَجَدَ مَعَاقِدَ  الْقِمْطِ  تَلِيهِ  ، ثُمَّ رَجَعَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَخْبَرَهُ بِذَلِكَ ، فَقَالَ : ""  أَصَبْتَ أَوْ أَحْسَنْتَ  .","","Al-Mu'jam al-Kabir 2088","","جارية بن ظفر اليمامي عن عقيل بن دينار مولى جارية بن ظفر عن دهثم بن قران العكلي عن مروان بن معاوية الفزاري عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","جارية بن ظفر أبو نمران الحنفي"
"2087","2089  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ، (  ح  )  وَحَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  ثَنَا  دَهْثَمُ بْنُ قُرَّانٍ ،  ثَنَا  نِمْرَانُ بْنُ جَارِيَةَ الْحَنَفِيُّ ،  عَنْ  أَبِيهِ ،  قَالَ :  ضَرَبَ  رَجُلٌ  رَجُلًا  بِالسَّيْفِ عَلَى سَاعِدِهِ عَلَى غَيْرِ مَفْصِلٍ فَاسْتَعْدَى عَلَيْهِ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَضَى لَهُ بِالدِّيَةِ ، وَأَرَادَ الْمَضْرُوبُ الْقِصَاصَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بَارَكَ اللهُ لَكَ فِيهَا  وَلَمْ يَقْضِ لَهُ بِالْقِصَاصِ  .","","Al-Mu'jam al-Kabir 2089","","جارية بن ظفر اليمامي عن نمران بن جارية بن ظفر الحنفي عن دهثم بن قران العكلي عن أبو بكر بن عياش عن هدبة بن خالد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","جارية بن ظفر أبو نمران الحنفي"
"2088","2090  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  أَسَدُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  عَنْ  دَهْثَمِ بْنِ قُرَّانٍ ،  عَنْ  نِمْرَانَ بْنِ جَارِيَةَ ،  عَنْ  أَبِيهِ  ،  أَنَّ  رَجُلًا  قَطَعَ يَدَ  رَجُلٍ  مِنْ نِصْفِ الذِّرَاعِ فَخَاصَمَهُ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَضَى لَهُ بِخَمْسَةِ آلَافِ دِرْهَمٍ  وَقَالَ : "" خُذْهَا بُورِكَ لَكَ فِيهَا  .","","Al-Mu'jam al-Kabir 2090","","جارية بن ظفر اليمامي عن نمران بن جارية بن ظفر الحنفي عن دهثم بن قران العكلي عن أسد بن عمرو بن عامر البجلي عن سليمان بن داود العتكي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","جارية بن ظفر أبو نمران الحنفي"
"2089","2091  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا         [2/261]      أَسَدُ بْنُ عَمْرٍو ،  عَنْ  دَهْثَمٍ ،  عَنْ  نِمْرَانَ بْنِ جَارِيَةَ ،  عَنْ  أَبِيهِ ،  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خُذُوا لِلرَّأْسِ مَاءً جَدِيدًا  .","","Al-Mu'jam al-Kabir 2091","","جارية بن ظفر اليمامي عن نمران بن جارية بن ظفر الحنفي عن دهثم بن قران العكلي عن أسد بن عمرو بن عامر البجلي عن سليمان بن داود العتكي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","جارية بن ظفر أبو نمران الحنفي"
"2090","200 -  جَارِيَةُ بْنُ مُجَمِّعِ بْنِ جَارِيَةَ الْأَنْصَارِيُّ  2092  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عُثْمَانَ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ، قَالَ :  جَمَعَ الْقُرْآنَ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سِتَّةٌ مِنَ  الْأَنْصَارِ :  زَيْدُ بْنُ ثَابِتٍ  ،  وَأَبُو زَيْدٍ  ،  وَمُعَاذُ بْنُ جَبَلٍ  ،  وَأَبُو الدَّرْدَاءِ  ،  وَسَعْدُ بْنُ عُبَادَةَ  ،  وَأُبَيُّ بْنُ كَعْبٍ  ، وَفِي حَدِيثِ  زَكَرِيَّا  : وَكَانَ  جَارِيَةُ بْنُ مُجَمِّعِ بْنِ جَارِيَةَ  قَدْ قَرَأَهُ إِلَّا سُورَةً أَوْ سُورَتَيْنِ ""  .  قال الحافظ ابن حجر : "" ذكر علي بن المديني أن اسمه أوس ، وعن يحيى بن معين هو ثابت بن زيد ، وقيل هو سعد بن عبيد بن النعمان وبذلك جزم الطبراني عن شيخه أبي بكر بن صدقة قال : وهو الذي كان يقال له القارئ وكان على القادسية واستشهد بها ، وهو والد عمير بن سعد . وعن الواقدي : هو قيس بن السكن بن قيس بن زعور بن حرام الأنصاري النجاري ، ويرجحه قول أنس "" أحد عمومتي "" فإنه من قبيلة بني حرام "" . [ الفتح ( 11 / 122 ) ] .","","Al-Mu'jam al-Kabir 2092","","الشعبي عن زكريا بن أبي زائدة الوادعي عن محمد بن فضيل بن غزوان عن إبراهيم بن محمد بن عثمان الحضرمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","جارية بن مجمع بن جارية الأنصاري"
"2091","201 -  جَارِيَةُ بْنُ قُدَامَةَ السَّعْدِيُّ التَّمِيمِيُّ عَمُّ الْأَحْنَفِ بْنِ قَيْسٍ وَلَيْسَ بِعَمِّهِ أَخُو أَبِيهِ ،  وَلَكِنَّهُ كَانَ يَدْعُوهُ عَمَّهُ عَلَى سَبِيلِ الْإِعْظَامِ .  بَابٌ  2093  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،         [2/262]      عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ، عَنِ  الْأَحْنَفِ بْنِ قَيْسٍ ،  عَنْ  عَمِّهِ أَوْ غَيْرِهِ  ذَكَرَ جَارِيَةَ بْنَ قُدَامَةَ  أَنَّهُ  قَالَ  : يَا رَسُولَ اللهِ ، قُلْ لِي فِي الْإِسْلَامِ قَوْلًا لَعَلِّي أَعْقِلُهُ وَأَقْلِلْ ، قَالَ :  لَا تَغْضَبْ  .","","Al-Mu'jam al-Kabir 2093","","جارية بن قدامة بن زهير التميمي عن غيره عن الأحنف بن قيس السعدي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","باب"
"2092","2094  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُعَاذٍ الْحَلَبِيُّ  ، ثَنَا  الْقَعْنَبِيُّ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْأَحْنَفِ بْنِ قَيْسٍ ،  عَنْ  جَارِيَةَ بْنِ قُدَامَةَ ، قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ قُلْ لِي قَوْلًا يَنْفَعُنِي وَأَقْلِلْ لَعَلِّي أَعِيهِ ، قَالَ :  لَا تَغْضَبْ  ، فَأَعَادَهَا عَلَيْهِ مِرَارًا يَقُولُ : "" لَا تَغْضَبْ  .","","Al-Mu'jam al-Kabir 2094","","جارية بن قدامة بن زهير التميمي عن الأحنف بن قيس السعدي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن مسلمة القعنبي عن إسماعيل بن مسلمة بن قعنب القعنبي عن محمد بن معاذ بن سفيان العنزي عن الطبراني","باب"
"2093","2095  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْأَحْنَفِ بْنِ قَيْسٍ ،  عَنْ  جَارِيَةَ بْنِ قُدَامَةَ ،  أَنَّ  رَجُلًا  قَالَ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : قُلْ لِي قَوْلًا وَأَقْلِلْ لَعَلِّي أَعْقِلُهُ ، قَالَ :  لَا تَغْضَبْ  ، فَأَعَادَهَا عَلَيْهِ قَالَ : "" لَا تَغْضَبْ  .","","Al-Mu'jam al-Kabir 2095","","جارية بن قدامة بن زهير التميمي عن الأحنف بن قيس السعدي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","باب"
"2094","2096  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنِ  الْأَحْنَفِ بْنِ قَيْسٍ ،  عَنْ  جَارِيَةَ بْنِ قُدَامَةَ ،  أَنَّهُ قَالَ : يَا رَسُولَ اللهِ قُلْ لِي قَوْلًا يَنْفَعُنِي وَأَقْلِلْ لَعَلِّي أَعْقِلُهُ ، قَالَ :  لَا تَغْضَبْ  فَعَادَ لَهُ مِرَارًا كُلَّ ذَلِكَ يَرْجِعُ إِلَيْهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" لَا تَغْضَبْ  .","","Al-Mu'jam al-Kabir 2096","","جارية بن قدامة بن زهير التميمي عن الأحنف بن قيس السعدي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","باب"
"2095","2097  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنِ  الْأَحْنَفِ بْنِ قَيْسٍ ،  عَنْ  جَارِيَةَ بْنِ قُدَامَةَ ،  أَنَّ عَمَّهُ أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا رَسُولَ اللهِ ، قُلْ لِي قَوْلًا وَأَقْلِلْ ؛ لَعَلِّي أَعِيهِ ، قَالَ :  لَا تَغْضَبْ  ، فَأَعَادَ عَلَيْهِ مِرَارًا كُلَّ ذَلِكَ يَقُولُهُ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَا تَغْضَبْ  .","","Al-Mu'jam al-Kabir 2097","","جارية بن قدامة بن زهير التميمي عن الأحنف بن قيس السعدي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن علي بن مسهر القرشي عن منجاب بن الحارث التميمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"2096","2098  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  أَبِي  ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَارِيَةَ بْنِ قُدَامَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2098","","جارية بن قدامة بن زهير التميمي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن عبيد بن غنام النخعي عن الطبراني","باب"
"2097","2099  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ حُمْرَانَ الْحَنَفِيُّ الْأَصْبَهَانِيُّ  ، ثَنَا  أَزْهَرُ بْنُ جَمِيلٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ الطُّفَاوِيُّ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ         [2/263]      طَلْحَةَ بْنِ قَيْسٍ ،  عَنِ  الْأَحْنَفِ بْنِ قَيْسٍ ،  عَنْ  جَارِيَةَ بْنِ قُدَامَةَ ،  عَنِ  ابْنِ عَمٍّ لَهُ قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ عَلِّمْنِي فِي الْإِسْلَامِ شَيْئًا يَنْفَعُنِي ، قَالَ :  لَا تَغْضَبْ  فَأَعَدْتُ عَلَيْهِ فَلَمْ يَزِدْنِي عَلَى ذَلِكَ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب :(العباس بن حمدان).","","Al-Mu'jam al-Kabir 2099","","أحد الصحابة عن جارية بن قدامة بن زهير التميمي عن الأحنف بن قيس السعدي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن عبد الرحمن الطفاوي عن أزهر بن جميل الشطي عن العباس بن حمدان الأصبهاني عن الطبراني","باب"
"2098","2100  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنِ  الْأَحْنَفِ بْنِ قَيْسٍ ،  عَنِ  ابْنِ عَمٍّ لَهُ قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ قُلْ لِي قَوْلًا وَأَقْلِلْ لَعَلِّي أَعْقِلُهُ قَالَ :  لَا تَغْضَبْ  فَعُدْتُ لَهُ مِرَارًا كُلَّ ذَلِكَ يَقُولُ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَا تَغْضَبْ  .","","Al-Mu'jam al-Kabir 2100","","أحد الصحابة عن الأحنف بن قيس السعدي عن عروة بن الزبير عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","باب"
"2099","2101  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ الْأَصْبَهَانِيُّ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلَمَةَ الرَّازِيُّ ،  ثَنَا  أَبُو زُهَيْرٍ عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ ،  ثَنَا  مُحَمَّدُ بْنُ كُرَيْبٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  شَهِدْتُ  الْأَحْنَفَ بْنَ قَيْسٍ  يُحَدِّثُ  عَمَّهُ ، وَعَمُّهُ  جَارِيَةُ بْنُ قُدَامَةَ  وَهُوَ عِنْدَ  ابْنِ عَبَّاسٍ  قَالَ :  يَا رَسُولَ اللهِ قُلْ لِي قَوْلًا يَنْفَعُنِي وَأَقْلِلْ لَعَلِّي أَعْقِلُهُ قَالَ :  لَا تَغْضَبْ  ثُمَّ عَادَ ، فَقَالَ : "" لَا تَغْضَبْ  .","","Al-Mu'jam al-Kabir 2101","","الأحنف بن قيس السعدي عن أبو الزناد عن محمد بن كريب بن أبي مسلم الهاشمي عن عبد الرحمن بن مغراء الدوسي عن عبد الرحمن بن سلمة الأزداني عن محمد بن شعيب التاجر عن الطبراني","باب"
"2100","2102  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْأَحْنَفِ بْنِ قَيْسٍ ،  عَنِ  ابْنِ عَمٍّ لَهُ مِنْ بَنِي تَمِيمٍ ،  عَنْ  جَارِيَةَ بْنِ قُدَامَةَ ،  أَنَّهُ قَالَ : يَا رَسُولَ اللهِ قُلْ لِي قَوْلًا  ، ثُمَّ ذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2102","","جارية بن قدامة بن زهير التميمي عن ابن عم له من بني تميم عن الأحنف بن قيس السعدي عن أبو الزناد عن هشام بن عروة بن الزبير عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"2101","2103  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنِ  الْأَحْنَفِ بْنِ قَيْسٍ ،  عَنْ  عَمٍّ لَهُ مِنْ  بَنِي تَمِيمٍ  يُقَالُ لَهُ : جَارِيَةُ بْنُ قُدَامَةَ  أَنَّهُ سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : قُلْ لِي قَوْلًا وَأَقْلِلْ  ، فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2103","","جارية بن قدامة بن زهير التميمي عن الأحنف بن قيس السعدي عن أبو الزناد عن هشام بن عروة بن الزبير عن عبد الله بن نمير عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"2102","2104  -  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنِ  الْأَحْنَفِ بْنِ قَيْسٍ ،  عَنْ  عَمٍّ لَهُ مِنْ بَنِي تَمِيمٍ ،  عَنْ  جَارِيَةَ بْنِ قُدَامَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2104","","جارية بن قدامة بن زهير التميمي عن عم الأحنف بن قيس السعدي من بني تميم عن الأحنف بن قيس السعدي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبدة بن سليمان الكلابي عن أبو بكر ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"2103","2105  -  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْأَحْنَفِ ،  عَنْ  جَارِيَةَ بْنِ قُدَامَةَ ،  عَنِ         [2/264]      ابْنِ عَمٍّ لَهُ مِنْ بَنِي تَمِيمٍ  سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2105","","أحد الصحابة عن جارية بن قدامة بن زهير التميمي عن الأحنف بن قيس السعدي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبدة بن سليمان الكلابي عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"2104","2106  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ سَعِيدٍ الْكِنْدِيُّ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  حَدَّثَنِي  الْأَحْنَفُ بْنُ قَيْسٍ ،  عَنِ  ابْنِ عَمٍّ لَهُ يُدْعَى جَارِيَةَ بْنَ قُدَامَةَ قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ : قُلْ لِي فِي الْإِسْلَامِ قَوْلًا وَأَقْلِلْ لَعَلِّي أَعْقِلُ وَأَعِيهِ  ، فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2106","","جارية بن قدامة بن زهير التميمي عن الأحنف بن قيس السعدي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن أسامة القرشي عن عبد الله بن سعيد الأشج عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"2105","2107  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُرْوَةَ ،  عَنِ  الْأَحْنَفِ بْنِ قَيْسٍ ،  عَنْ  جَارِيَةَ بْنِ قُدَامَةَ ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مِثْلَهُ .","","Al-Mu'jam al-Kabir 2107","","جارية بن قدامة بن زهير التميمي عن الأحنف بن قيس السعدي عن عروة بن الزبير عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"2106","202 -  الْجَارُودُ بْنُ عَمْرِو بْنِ الْمُعَلَّى الْعَبْدِيُّ يُكَنَّى أَبَا الْمُنْذِرِ  2108  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ الْوَارِثِ بْنُ عَبْدِ الصَّمَدِ بْنِ عَبْدِ الْوَارِثِ ،  حَدَّثَنَا  أَبِي  ،  ثَنَا  زَرْبِيُّ بْنُ عَبْدِ اللهِ ،  حَدَّثَنَا  أَنَسُ بْنُ مَالِكٍ ، قَالَ :  لَمَّا قَدِمَ  أَهْلُ الْبَحْرَيْنِ  وَقَدِمَ  الْجَارُودُ  وَافِدًا عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَرِحَ بِهِ  فَقَرَّبَهُ وَأَدْنَاهُ  .","","Al-Mu'jam al-Kabir 2108","","أنس بن مالك عن زربي بن عبد الله الأزدي عن عبد الصمد بن عبد الوارث التنوري عن عبد الوارث بن عبد الصمد التنوري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","الجارود بن عمرو بن المعلى العبدي"
"2107","2109  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالُوا :  ثَنَا  أَبُو كَامِلٍ الْجَحْدَرِيُّ ،  ثَنَا  أَبُو مَعْشَرٍ الْبَرَّاءُ ،  ثَنَا  الْمُثَنَّى بْنُ سَعِيدٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ بَابَيْ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ الْجَارُودَ أَبَا الْمُنْذِرِ ،  أَخْبَرَهُ  أَنَّهُ سَأَلَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الضَّوَالِّ ، فَقَالَ :  ضَالَّةُ الْمُسْلِمِ  حَرَقُ  النَّارِ  .","","Al-Mu'jam al-Kabir 2109","","الجارود ظئر العناق عن عبد الله بن عمرو بن العاص عن عبد الله بن باباه البصري عن قتادة بن دعامة عن المثنى بن سعيد القسام عن يوسف بن يزيد البراء عن فضيل بن حسين الجحدري عن عبد الله بن أحمد الجواليقي عن الطبراني","الجارود بن عمرو بن المعلى العبدي"
"2108","2110  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ الشِّخِّيرِ ،  عَنْ  مُطَرِّفِ بْنِ         [2/265]      الشِّخِّيرِ ،  عَنِ  الْجَارُودِ الْعَبْدِيِّ ،  رَفَعَهُ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  ضَالَّةُ الْمُسْلِمِ  حَرَقُ  النَّارِ فَلَا تَقْرَبَنَّهَا  .","","Al-Mu'jam al-Kabir 2110","","الجارود ظئر العناق عن مطرف بن عبد الله بن الشخير الحرشي عن يزيد بن عبد الله بن الشخير العامري عن خالد الحذاء عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","الجارود بن عمرو بن المعلى العبدي"
"2109","2111  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ ،  عَنِ  الْجَارُودِ الْعَبْدِيِّ ،  أَنَّهُ سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ إِبِلٍ عُجَابٍ ضَوَالَّ تَرِدُ عَلَيْهِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ضَالَّةُ  الْمُؤْمِنِ  حَرَقُ  النَّارِ  .","","Al-Mu'jam al-Kabir 2111","","الجارود ظئر العناق عن يزيد بن عبد الله بن الشخير العامري عن خالد الحذاء عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن أحمد بن داود بن موسى السدوسي عن الطبراني","الجارود بن عمرو بن المعلى العبدي"
"2110","2112  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ  ، ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِي مُسْلِمٍ الْجَذْمِيِّ ،  عَنِ  الْجَارُودِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  ضَالَّةُ الْمُسْلِمِ  حَرَقُ  النَّارِ  .","","Al-Mu'jam al-Kabir 2112","","الجارود ظئر العناق عن أبو مسلم الجذمي عن يزيد بن عبد الله بن الشخير العامري عن خالد الحذاء عن شعبة بن الحجاج عن روح بن عبادة القيسي عن إدريس بن جعفر العطار عن الطبراني","الجارود بن عمرو بن المعلى العبدي"
"2111","2113  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ  ، ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ، (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  مُطَرِّفِ بْنِ عَبْدِ اللهِ بْنِ الشِّخِّيرِ ،  عَنْ  أَبِي مُسْلِمٍ ،  عَنِ  الْجَارُودِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  ضَالَّةُ الْمُسْلِمِ  حَرَقُ  النَّارِ  .","","Al-Mu'jam al-Kabir 2113","","الجارود ظئر العناق عن أبو مسلم الجذمي عن مطرف بن عبد الله بن الشخير الحرشي عن خالد الحذاء عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","الجارود بن عمرو بن المعلى العبدي"
"2112","2114  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  أَبَانُ بْنُ يَزِيدَ ،  عَنْ  قَتَادَةَ ،  عَنْ  يَزِيدَ أَخِي مُطَرِّفٍ ،  عَنْ  أَبِي مُسْلِمٍ الْجَذْمِيِّ ،  عَنِ  الْجَارُودِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  ضَالَّةُ الْمُسْلِمِ  حَرَقُ  النَّارِ  .","","Al-Mu'jam al-Kabir 2114","","الجارود ظئر العناق عن أبو مسلم الجذمي عن يزيد بن عبد الله بن الشخير العامري عن قتادة بن دعامة عن أبان بن يزيد العطار عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","الجارود بن عمرو بن المعلى العبدي"
"2113","2115  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَمُحَمَّدُ بْنُ يَحْيَى الْقَزَّازُ ، قَالَا :  ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ،  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  يَزِيدَ أَخِي مُطَرِّفٍ ،  عَنْ  أَبِي مُسْلِمٍ الْجَذْمِيِّ ،  عَنِ  الْجَارُودِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  ضَالَّةُ الْمُسْلِمِ  حَرَقُ  النَّارِ  .","","Al-Mu'jam al-Kabir 2115","","الجارود ظئر العناق عن أبو مسلم الجذمي عن يزيد بن عبد الله بن الشخير العامري عن قتادة بن دعامة عن همام بن يحيى بن دينار عن حفص بن عمر الحوضى عن محمد بن يحيى بن المنذر القزاز عن الطبراني","الجارود بن عمرو بن المعلى العبدي"
"2114","2116  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ صَالِحٍ الشِّيرَازِيُّ  ، ثَنَا  حَجَّاجُ بْنُ نُصَيْرٍ ،  ثَنَا         [2/266]      الْمُثَنَّى بْنُ سَعِيدٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ الشِّخِّيرِ ،  عَنْ  أَبِي مُسْلِمٍ الْجَذْمِيِّ ،  عَنِ  الْجَارُودِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ضَالَّةُ الْمُسْلِمِ  حَرَقُ  النَّارِ  .","","Al-Mu'jam al-Kabir 2116","","الجارود ظئر العناق عن أبو مسلم الجذمي عن يزيد بن عبد الله بن الشخير العامري عن قتادة بن دعامة عن المثنى بن سعيد القسام عن حجاج بن نصير الفساطيطي عن إبراهيم بن صالح الشيرازي عن الطبراني","الجارود بن عمرو بن المعلى العبدي"
"2115","2117  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الْفَرَجِ ،  ثَنَا  عَبْدُ الْوَهَّابِ بْنُ عَطَاءٍ ،  عَنْ  سَعِيدٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي مُسْلِمٍ الْجَذْمِيِّ ،  عَنِ  الْجَارُودِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  ضَالَّةُ الْمُسْلِمِ  حَرَقُ  النَّارِ  وَلَمْ يَذْكُرْ  سَعِيدٌ  يَزِيدَ بْنَ عَبْدِ اللهِ  .","","Al-Mu'jam al-Kabir 2117","","الجارود ظئر العناق عن أبو مسلم الجذمي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبد الوهاب بن عطاء الخفاف عن محمد بن الفرج الفراء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","الجارود بن عمرو بن المعلى العبدي"
"2116","2118  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمُ أَبُو النُّعْمَانِ ، (  ح  )  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ شُعَيْبٍ السِّمْسَارُ  ، ثَنَا  خَالِدُ بْنُ خِدَاشٍ ، قَالُوا :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي الْعَلَاءِ ،  عَنْ  أَبِي مُسْلِمٍ الْجَذْمِيِّ ،  عَنِ  الْجَارُودِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ضَالَّةُ الْمُسْلِمِ  حَرَقُ  النَّارِ  .","","Al-Mu'jam al-Kabir 2118","","الجارود ظئر العناق عن أبو مسلم الجذمي عن يزيد بن عبد الله بن الشخير العامري عن أيوب السختياني عن حماد بن زيد عن خالد المهلبي عن محمد بن علي بن شعيب السمسار عن الطبراني","الجارود بن عمرو بن المعلى العبدي"
"2117","2119  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ الْهَرَوِيُّ ،  ثَنَا  إِسْمَاعِيلُ ابْنُ عُلَيَّةَ ،  ثَنَا  الْجُرَيْرِيُّ ،  عَنْ  أَبِي الْعَلَاءِ ،  عَنْ  مُطَرِّفٍ  ، ثَنَا  أَبُو مُسْلِمٍ الْجَذْمِيُّ جَذِيمَةَ عَبْدِ الْقَيْسِ ،  ثَنَا  الْجَارُودُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ضَالَّةُ الْمُسْلِمِ  حَرَقُ  النَّارِ فَلَا تَقْرَبَنَّهَا  .","","Al-Mu'jam al-Kabir 2119","","الجارود ظئر العناق عن أبو مسلم الجذمي عن مطرف بن عبد الله بن الشخير الحرشي عن يزيد بن عبد الله بن الشخير العامري عن سعيد بن إياس الجريري عن إسماعيل ابن علية عن إبراهيم بن عبد الله الهروي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","الجارود بن عمرو بن المعلى العبدي"
"2118","2120  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  ثَنَا  عَبْدُ الْوَارِثِ ،  ثَنَا  سَعِيدٌ الْجُرَيْرِيُّ ،  عَنْ  أَبِي الْعَلَاءِ ،  عَنْ  مُطَرِّفٍ  ، قَالَ : حَدِيثَانِ حَدَّثْتُهُمَا قَدْ حُفِظَا لِي ،  حَدَّثَنِي  أَبُو مُسْلِمٍ الْجَذْمِيُّ ،  عَنِ  الْجَارُودِ ، قَالَ :  كُنَّا مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ وَفِي الظَّهْرِ قِلَّةٌ ، فَتَذَاكَرَ  الْقَوْمُ  الظَّهْرَ بَيْنَهُمْ ، فَقُلْتُ أَنَا : يَا         [2/267]      رَسُولَ اللهِ إِنَّا نَمُرُّ بِذَوْدٍ مِنَ الظَّهْرِ فِي جُرُفٍ فَنَسْتَمْتِعُ بِظُهُورِهِنَّ ؟ قَالَ :  لَا ، ضَالَّةُ الْمُسْلِمِ  حَرَقُ  النَّارِ ،  ضَالَّةُ الْمُسْلِمِ  حَرَقُ  النَّارِ ، ضَالَّةُ الْمُسْلِمِ  حَرَقُ  النَّارِ "" ، ثَلَاثًا قَالَ : "" وَاللُّقَطَةُ تَجِدُهَا فَأَنْشِدْهَا ثُمَّ لَا تَكْتُمْ وَلَا تُغَيِّبْ ، فَإِنْ وَجَدْتَ رَبَّهَا فَأَدِّهَا ، وَإِلَّا فَإِنَّمَا هُوَ مَالُ اللهِ عَزَّ وَجَلَّ يُوَجِّهُهُ إِلَى مَنْ يَشَاءُ  .","","Al-Mu'jam al-Kabir 2120","","الجارود ظئر العناق عن أبو مسلم الجذمي عن مطرف بن عبد الله بن الشخير الحرشي عن يزيد بن عبد الله بن الشخير العامري عن سعيد بن إياس الجريري عن عبد الوارث بن سعيد بن ذكوان عن إبراهيم بن الحجاج السامي عن أحمد بن داود بن موسى السدوسي عن الطبراني","الجارود بن عمرو بن المعلى العبدي"
"2119","2121  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  ثَنَا  الْجُرَيْرِيُّ ،  عَنْ  أَبِي الْعَلَاءِ ،  عَنْ  مُطَرِّفٍ  ، ثَنَا  أَبُو مُسْلِمٍ الْجَذْمِيُّ ،  عَنِ  الْجَارُودِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ضَالَّةُ الْمُسْلِمِ  حَرَقُ  النَّارِ فَلَا تَقْرَبَنَّهَا  ، وَقَالَ : "" الضَّالَّةُ وَاللُّقَطَةُ تَجِدُهَا فَأَنْشِدْهَا وَلَا تَكْتُمْ وَلَا تُغَيِّبْ ، فَإِنْ عُرِفَتْ فَأَدِّهَا ، وَإِلَّا فَمَالُ اللهِ يُؤْتِيهِ مَنْ يَشَاءُ  .","","Al-Mu'jam al-Kabir 2121","","الجارود ظئر العناق عن أبو مسلم الجذمي عن مطرف بن عبد الله بن الشخير الحرشي عن يزيد بن عبد الله بن الشخير العامري عن سعيد بن إياس الجريري عن بشر بن المفضل عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","الجارود بن عمرو بن المعلى العبدي"
"2120","2122  -  ثَنَا  مُحَمَّدُ بْنُ أَزْهَرَ الْأُبُلِّيُّ  ، ثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَيْمُونٍ الْعَتَكِيُّ ،  ثَنَا  هِلَالُ بْنُ حِقٍّ ،  عَنْ  أَبِي مَسْعُودٍ الْجُرَيْرِيِّ ،  عَنْ  أَبِي الْعَلَاءِ ،  عَنْ  أَخِيهِ مُطَرِّفِ بْنِ عَبْدِ اللهِ  ، عَنْ  أَبِي مُسْلِمٍ الْجَذْمِيِّ ،  عَنِ  الْجَارُودِ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ وَفِي الظَّهْرِ قِلَّةٌ ، فَتَذَاكَرْنَا مَا يَكْفِينَا مِنَ الظَّهْرِ ، قُلْنَا : ذَوْدٌ نَأْتِي عَلَيْهِمْ بِجُرُفٍ فَنَسْتَمْتِعُ بِظُهُورِهِمْ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ضَالَّةُ الْمُسْلِمِ  حَرَقُ  النَّارِ ، ثَلَاثَ مَرَّاتٍ ، فَلَا تَقْرَبَنَّهَا  ، وَقَالَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" فِي الضَّالَّةِ تَجِدُهَا فَلَا تُغَيِّبْ وَلَا تَكْتُمْ ، فَإِنْ عُرِفَتْ فَأَدِّهَا ، وَإِلَّا فَمَالُ اللهِ يُؤْتِيهِ مَنْ يَشَاءُ  .","","Al-Mu'jam al-Kabir 2122","","الجارود ظئر العناق عن أبو مسلم الجذمي عن مطرف بن عبد الله بن الشخير الحرشي عن يزيد بن عبد الله بن الشخير العامري عن سعيد بن إياس الجريري عن هلال بن حق البصرى عن محمد بن يحيى بن ميمون العتكي عن محمد بن أزهر الأبلي عن الطبراني","الجارود بن عمرو بن المعلى العبدي"
"2121","2123  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مَحْمُودُ بْنُ غَيْلَانَ ،  ثَنَا  مُحَمَّدُ بْنُ بَكْرٍ الْبُرْسَانِيُّ ،  ثَنَا  سَعِيدٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي مُسْلِمٍ الْجَذْمِيِّ ،  عَنِ  الْجَارُودِ ،  أَنَّهُ سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الشُّرْبِ قَائِمًا "" فَنَهَاهُ  .","","Al-Mu'jam al-Kabir 2123","","الجارود ظئر العناق عن أبو مسلم الجذمي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن محمد بن بكر بن عثمان البرساني عن محمود بن غيلان المروزي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","الجارود بن عمرو بن المعلى العبدي"
"2122","2124  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، حَدَّثَنَا  إِسْحَاقُ بْنُ إِسْمَاعِيلَ الطَّالْقَانِيُّ ، (  ح  )  وَحَدَّثَنَا  أَبُو خَلِيفَةَ ، وَالْعَبَّاسُ بْنُ الْفَضْلِ ، قَالَا :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْمُبَارَكِ ،         [2/268]      قَالَا :  ثَنَا  خَالِدُ بْنُ الْحَارِثِ ،  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي مُسْلِمٍ الْجَذْمِيِّ ،  عَنِ  الْجَارُودِ بْنِ الْمُعَلَّى : عَنِ "" النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ  نَهَى أَنْ يَشْرَبَ الرَّجُلُ قَائِمًا  .","","Al-Mu'jam al-Kabir 2124","","الجارود ظئر العناق عن أبو مسلم الجذمي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن خالد الصدق عن إسحاق بن إسماعيل الطالقاني عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","الجارود بن عمرو بن المعلى العبدي"
"2123","2125  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  ثَنَا  خَالِدٌ ،  عَنِ  الْجُرَيْرِيِّ ،  عَنْ  أَبِي الْعَلَاءِ ،  عَنْ  مُطَرِّفٍ  ،  عَنِ  الْجَارُودِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِ حَدِيثِ  هِلَالِ بْنِ حَقٍّ  .","","Al-Mu'jam al-Kabir 2125","","الجارود ظئر العناق عن مطرف بن عبد الله بن الشخير الحرشي عن يزيد بن عبد الله بن الشخير العامري عن سعيد بن إياس الجريري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","الجارود بن عمرو بن المعلى العبدي"
"2124","2126  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  ابْنُ الْأَصْبَهَانِيِّ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنِ  الْجَارُودِ الْعَبْدِيِّ ، قَالَ :  أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقُلْتُ :  إِنَّ لِي دِينًا فَلِي إِنْ تَرَكْتُ دِينِي وَدَخَلْتُ دِينَكَ أَنْ لَا يُعَذِّبَنِي اللهُ فِي الْآخِرَةِ ؟ قَالَ : "" نَعَمْ  .","","Al-Mu'jam al-Kabir 2126","","الجارود ظئر العناق عن محمد بن سيرين عن أشعث بن سوار عن علي بن مسهر القرشي عن محمد بن سعيد حمدان عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","الجارود بن عمرو بن المعلى العبدي"
"2125","2127  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ، وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَا :  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  خَالِدُ بْنُ مَخْلَدٍ ،  ثَنَا  عَلِيُّ بْنُ هَاشِمٍ ،  عَنْ  أَشْعَثَ ،  عَنِ  ابْنِ سِيرِينَ ،  عَنِ  الْجَارُودِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2127","","الجارود ظئر العناق عن محمد بن سيرين عن أشعث بن سوار عن علي بن هاشم العائذي عن خالد بن مخلد القطواني عن أبو بكر ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","الجارود بن عمرو بن المعلى العبدي"
"2126","2128  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مَحْمُودُ بْنُ غَيْلَانَ ،  ثَنَا  نَصْرُ بْنُ خَالِدٍ النَّحْوِيُّ ،  ثَنَا  هَدَّابٌ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الضُّرَيْسِ ،  عَنِ  الْهَيْثَمِ ،  عَنِ  الْجَارُودِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ طَلَبَ الدُّنْيَا بِعَمَلِ الْآخِرَةِ طُمِسَ وَجْهُهُ وَمُحِقَ ذِكْرُهُ وَأُثْبِتَ اسْمُهُ فِي النَّارِ  .","","Al-Mu'jam al-Kabir 2128","","الجارود ظئر العناق عن الهيثم عن إبراهيم بن الضريس عن هدبة بن خالد عن نصر بن خالد النحوي عن محمود بن غيلان المروزي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","الجارود بن عمرو بن المعلى العبدي"
"2127","203 -  جَزْءٌ السُّلَمِيُّ  2129  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُعَلَّى بْنُ مَهْدِيٍّ ،  ثَنَا  حِصْنُ بْنُ عَبْدِ اللهِ بْنِ عَيَّاشٍ السُّلَمِيُّ ، قَالَ :  سَمِعْتُ  مُطَرِّفَ بْنَ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ         [2/269]      بْنِ جَزْءٍ ، يَقُولُ :  أَنْبَأَنِي  حِبَّانُ بْنُ جَزْءٍ ،  عَنْ  جَزْءٍ ،  أَنَّهُ أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِأَسِيرٍ  كَانَ عِنْدَهُ مِنْ صَحَابَةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانُوا أَسَرُوهُ وَهُمْ مُشْرِكُونَ ، ثُمَّ أَسْلَمُوا ، فَأَتَوُا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِذَاكَ الْأَسِيرِ ،  فَكَسَا  جَزْءًا  بُرْدَيْنِ وَأَسْلَمَ  جَزْءٌ  عِنْدَهُ ، ثُمَّ قَالَ : "" ادْخُلْ عَلَى  عَائِشَةَ  تُعْطِيكَ مِنَ الْأَبْرُدِ الَّتِي عِنْدَهَا بُرْدَيْنِ  فَدَخَلَ عَلَى  عَائِشَةَ  أُمِّ الْمُؤْمِنِينَ ، فَقَالَ : أَيْ نَضَّرَكِ اللهُ اخْتَارِي لِي مِنْ هَذِهِ الْأَبْرُدِ الَّتِي عِنْدَكَ بُرْدَيْنِ ، فَإِنَّ نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَسَانِي مِنْهَا بُرْدَيْنِ ، فَقَالَتْ وَمَدَّتْ سِوَاكًا مِنْ أَرَاكٍ طَوِيلًا ، فَقَالَتْ: خُذْ هَذَا وَخُذْ هَذَا ، وَكَانَتْ نِسَاءُ الْعَرَبِ حِينَئِذٍ لَا يُرَيْنَ  .","","Al-Mu'jam al-Kabir 2129","","جزي السلمي عن حبان بن جزء السلمي عن مطرف بن عبد الرحمن بن عبد الله بن جزء عن حصن بن عبد الله بن عياش السلمي عن معلى بن مهدي الموصلي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","جزء السلمي"
"2128","204 -  جَزْءٌ  غَيْرُ مَنْسُوبٍ  2130  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ، أَنَّ أَسَدَ بْنَ وَدَاعَةَ ،  حَدَّثَهُ  أَنَّ  رَجُلًا يُقَالُ لَهُ : جَزْءٌ - أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ  إِنَّ أَهْلِي يُغْضِبُونِي فَبِمَ أُعَاقِبُهُمْ ؟ فَقَالَ : "" تَعْفُو "" ، ثُمَّ قَالَ الثَّانِيَةَ حَتَّى قَالَهَا ثَلَاثًا  قَالَ : "" فَإِنْ عَاقَبْتَ فَعَاقِبْ بِقَدْرِ الذَّنْبِ وَاتَّقِ الْوَجْهَ  .","","Al-Mu'jam al-Kabir 2130","","جزء الشامى عن أسد بن وداعة الشامي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","جزء غير منسوب"
"2129","-  جَزْءُ بْنُ مَالِكِ بْنِ عَامِرٍ الْأَنْصَارِيُّ  اسْتُشْهِدَ  يَوْمَ الْيَمَامَةِ  2131  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ،  عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  : ""  فِي تَسْمِيَةِ مَنْ قُتِلَ  يَوْمَ الْيَمَامَةِ  مِنَ  الْأَنْصَارِ  ، ثُمَّ مِنْ  بَنِي جَحْجَبَا  جَزْءُ بْنُ مَالِكِ بْنِ عَامِرِ بْنِ حُدَيْرٍ  "" .","","Al-Mu'jam al-Kabir 2131","","","جزء بن مالك بن عامر الأنصاري"
"2130","2132  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ،  ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ،  عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  : ""  فِي تَسْمِيَةِ مَنِ اسْتُشْهِدَ  يَوْمَ الْيَمَامَةِ  مِنَ  الْأَنْصَارِ  ، ثُمَّ مِنَ  الْأَوْسِ  ، ثُمَّ مِنْ  بَنِي عَمْرِو بْنِ عَوْفٍ  جَزْءُ بْنُ مَالِكٍ  "" .","","Al-Mu'jam al-Kabir 2132","","","جزء بن مالك بن عامر الأنصاري"
"2131","[2/270]      206 -  جَبَّارُ بْنُ صَخْرٍ الْأَنْصَارِيُّ ،  عَقَبِيٌّ بَدْرِيٌّ  2133  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ،  عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  : ""  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ  ثُمَّ مِنْ  بَنِي خُنَاسِ بْنِ سِنَانِ بْنِ عُبَيْدِ بْنِ عَدِيِّ بْنِ غَنْمِ بْنِ عَوْفِ بْنِ الْخَزْرَجِ  جُبَارُ بْنُ صَخْرِ بْنِ أُمَيَّةَ بْنِ خَنْسَاءَ بْنِ عُبَيْدِ بْنِ عَدِيِّ بْنِ غَنْمٍ  "" .","","Al-Mu'jam al-Kabir 2133","","","جبار بن صخر الأنصاري"
"2132","2134  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ  ،  ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ،  عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  : ""  فِي تَسْمِيَةِ مَنْ شَهِدَ الْعَقَبَةَ مِنَ  الْأَنْصَارِ  جَبَّارُ بْنُ صَخْرٍ  "" .","","Al-Mu'jam al-Kabir 2134","","","جبار بن صخر الأنصاري"
"2133","2135  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ،  حَدَّثَنَا  يَحْيَى بْنُ بُكَيْرٍ  ، قَالَ : ""  تُوُفِّيَ  جَبَّارُ بْنُ صَخْرٍ  بِالْمَدِينَةِ  سَنَةَ ثَلَاثِينَ ، وَسِنُّهُ ثِنْتَيْنِ وَسِتِّينَ سَنَةً  "" .","","Al-Mu'jam al-Kabir 2135","","","جبار بن صخر الأنصاري"
"2134","2136  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  هَنَّادُ بْنُ السَّرِيِّ ،  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ، قَالَ :  إِنَّمَا خَرَصَ  عَبْدُ اللهِ بْنُ رَوَاحَةَ  عَلَى  أَهْلِ خَيْبَرَ  عَامًا وَاحِدًا فَأُصِيبَ  يَوْمَ مُؤْتَةَ  ، ثُمَّ إِنَّ  جَابِرَ بْنَ صَخْرِ بْنِ خَنْسَاءَ  كَانَ يَبْعَثُهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعْدَ  ابْنِ رَوَاحَةَ  فَيَخْرُصُ عَلَيْهِمْ  .","","Al-Mu'jam al-Kabir 2136","","عبد الله بن أبي بكر بن محمد  ابن حزم عن محمد بن إسحاق عن يونس بن بكير عن هناد بن السري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","جبار بن صخر الأنصاري"
"2135","مَا  أَسْنَدَ  جَبَّارُ بْنُ صَخْرٍ  2137  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  ثَنَا  حُسَيْنُ بْنُ مُحَمَّدٍ ،  ثَنَا  أَبُو أُوَيْسٍ ،  ثَنَا  شُرَحْبِيلُ بْنُ سَعْدٍ ،  عَنْ  جَبَّارِ بْنِ صَخْرٍ ، قَالَ :  صَلَّيْتُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَقَامَنِي عَنْ يَمِينِهِ  .","","Al-Mu'jam al-Kabir 2137","","جبار بن صخر بن أمية بن خنساء الخزرجي عن شرحبيل بن سعد الخطمي عن عبد الله بن عبد الله بن أويس عن الحسين بن محمد بن بهرام المروذي عن إبراهيم بن سعيد الجوهري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ما أسند جبار بن صخر"
"2136","[2/271]      207 -  جَرْهَدٌ الْأَسْلَمِيُّ  2138  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ ،  ثَنَا  قَبِيصَةُ بْنُ عُقْبَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي الزِّنَادِ ،  عَنْ  زُرْعَةَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ جَرْهَدٍ ،  عَنْ  جَرْهَدٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ لَهُ :  غَطِّ فَخِذَكَ فَإِنَّ الْفَخِذَ  عَوْرَةٌ  .","","Al-Mu'jam al-Kabir 2138","","جرهد بن رزاح الأسلمي عن زرعة بن عبد الرحمن الأسلمي عن أبو الزناد عن سفيان الثوري عن قبيصة بن عقبة السوائي عن حفص بن عمر سنجة ألف عن الطبراني","جرهد الأسلمي"
"2137","2139  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  أَبِي الزِّنَادِ ،  عَنِ  ابْنِ جَرْهَدٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  مَرَّ بِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَنَا كَاشِفٌ فَخِذِي ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  غَطِّهَا فَإِنَّهَا مِنَ  الْعَوْرَةِ  .","","Al-Mu'jam al-Kabir 2139","","جرهد بن رزاح الأسلمي عن عبد الرحمن بن جرهد الأسلمي عن أبو الزناد عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","جرهد الأسلمي"
"2138","2140  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ، وَيَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ، قَالَا :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  ابْنُ أَبِي الزِّنَادِ ،  حَدَّثَنِي  أَبِي  ،  حَدَّثَنِي  زُرْعَةُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ جَرْهَدٍ الْأَسْلَمِيُّ ،  عَنْ  جَدِّهِ جَرْهَدٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ عَلَيْهِ وَفَخِذُهُ مَكْشُوفَةٌ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  غَطِّ فَخِذَكَ يَا  جَرْهَدُ  ؛ فَإِنَّ الْفَخِذَ  عَوْرَةٌ  .  في طبعة مكتبة ابن تيمية : ( ابن أبي الزناد ( ح ) وحدثني ) والمثبت من نسخة الظاهرية ( 1 ) .","","Al-Mu'jam al-Kabir 2140","","جرهد بن رزاح الأسلمي عن زرعة بن عبد الرحمن الأسلمي عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","جرهد الأسلمي"
"2139","2141  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ الْأَصْبَهَانِيُّ ،  ثَنَا  أَبُو حَفْصٍ عَمْرُو بْنُ عَلِيٍّ ،  ثَنَا  مُحَمَّدُ بْنُ سَوَاءٍ ،  عَنْ  رَوْحِ بْنِ الْقَاسِمِ ،  عَنْ  أَبِي الزِّنَادِ ،  عَنِ  ابْنِ جَرْهَدٍ ،  عَنْ  جَرْهَدٍ ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ رَآهُ وَقَدِ انْكَشَفَ فَخِذُهُ ، فَقَالَ :  غَطِّهَا فَإِنَّ الْفَخِذَ  عَوْرَةٌ  .","","Al-Mu'jam al-Kabir 2141","","جرهد بن رزاح الأسلمي عن عبد الرحمن بن جرهد الأسلمي عن أبو الزناد عن روح بن القاسم العنبري عن محمد بن سواء السدوسي عن الفلاس عن محمد بن أبان الأصبهاني عن الطبراني","جرهد الأسلمي"
"2140","2142  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ  ، ثَنَا  رِزْقُ اللهِ بْنُ مُوسَى ،  ثَنَا  شَبَابَةُ ،  ثَنَا  وَرْقَاءُ ،  عَنْ  أَبِي الزِّنَادِ ،  عَنِ  ابْنِ جَرْهَدٍ ،  عَنْ  جَرْهَدٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ بِهِ وَهُوَ كَاشِفٌ عَنْ فَخِذِهِ ، فَقَالَ :  غَطِّهَا فَإِنَّهَا مِنَ  الْعَوْرَةِ  .","","Al-Mu'jam al-Kabir 2142","","جرهد بن رزاح الأسلمي عن عبد الرحمن بن جرهد الأسلمي عن أبو الزناد عن ورقاء بن عمر عن شبابة بن سوار المدائني عن رزق الله بن موسى الناجي عن محمد بن أبان الأصبهاني عن الطبراني","جرهد الأسلمي"
"2141","[2/272]      2143  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ ،  عَنْ  أَبِي النَّضْرِ ،  عَنْ  زُرْعَةَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ جَرْهَدٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَ جَرْهَدٌ مِنْ  أَصْحَابِ الصُّفَّةِ  قَالَ : جَلَسَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عِنْدَنَا وَفَخِذِي مُنْكَشِفَةٌ ، فَقَالَ :  أَمَا عَلِمْتَ أَنَّ الْفَخِذَ  عَوْرَةٌ .  ؟","","Al-Mu'jam al-Kabir 2143","","جرهد بن رزاح الأسلمي عن عبد الرحمن بن جرهد الأسلمي عن زرعة بن عبد الرحمن الأسلمي عن سالم بن أبي أمية التيمي عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","جرهد الأسلمي"
"2142","2144  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ الْمِصْرِيُّ ،  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، قَالَ :  قَرَأْتُ عَلَى  عَبْدِ اللهِ بْنِ نَافِعٍ ،  أَنَا  مَالِكٌ ،  عَنْ  أَبِي النَّضْرِ ،  عَنْ  زُرْعَةَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ جَرْهَدٍ الْأَسْلَمِيِّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَلَسَ إِلَيْهِ وَكَانَ مِنْ  أَصْحَابِ الصُّفَّةِ  فَرَأَى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَخِذَهُ مَكْشُوفَةً ، فَقَالَ :  خَمِّرْ  فَخِذَكَ ؛ فَإِنَّ الْفَخِذَ  عَوْرَةٌ  .","","Al-Mu'jam al-Kabir 2144","","جرهد بن رزاح الأسلمي عن عبد الرحمن بن جرهد الأسلمي عن زرعة بن عبد الرحمن الأسلمي عن سالم بن أبي أمية التيمي عن مالك بن أنس عن عبد الله بن نافع الصائغ عن أحمد بن صالح المصري عن إسماعيل بن الحسن الخفاف المصري عن الطبراني","جرهد الأسلمي"
"2143","2145  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  شُعَيْبُ بْنُ يَحْيَى ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي النَّضْرِ ،  عَنْ  زُرْعَةَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ جَرْهَدٍ ،  عَنْ  أَبِيهِ  ، وَكَانَ مِنْ  أَصْحَابِ الصُّفَّةِ  أَنَّهُ قَالَ :  جَلَسَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عِنْدَنَا يَوْمًا وَفَخِذِي مَكْشُوفَةٌ ، فَقَالَ :  خَمِّرْ  عَلَيْكَ ، أَمَا عَلِمْتَ أَنَّ الْفَخِذَ  عَوْرَةٌ  .","","Al-Mu'jam al-Kabir 2145","","عبد الرحمن بن جرهد الأسلمي عن زرعة بن عبد الرحمن الأسلمي عن سالم بن أبي أمية التيمي عن عبد الله بن لهيعة عن شعيب بن يحيى التجيبي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","جرهد الأسلمي"
"2144","2146  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  سُفْيَانُ ،  ثَنَا  سَالِمٌ أَبُو النَّضْرِ ،  حَدَّثَنِي  زُرْعَةُ بْنُ مُسْلِمِ بْنِ جَرْهَدٍ ،  عَنْ  جَدِّهِ جَرْهَدٍ ، قَالَ :  مَرَّ بِي النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَنَا فِي الْمَسْجِدِ وَعَلَيَّ بُرْدَةٌ قَدِ انْكَشَفَ فَخِذِي ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  غَطِّ فَخِذَكَ يَا  جَرْهَدُ  فَإِنَّ الْفَخِذَ  عَوْرَةٌ  .","","Al-Mu'jam al-Kabir 2146","","جرهد بن رزاح الأسلمي عن زرعة بن عبد الرحمن الأسلمي عن سالم بن أبي أمية التيمي عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","جرهد الأسلمي"
"2145","2147  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ سَهْلٍ الْعَسْكَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ ثَعْلَبَةَ بْنِ سَوَاءٍ ،  ثَنَا  عَمِّي ،  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ         [2/273]      عَبْدِ الْمَلِكِ بْنِ جَرْهَدٍ  ،  عَنْ  أَبِيهِ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ بِهِ وَهُوَ كَاشِفٌ فَخِذَهُ ، فَقَالَ :  غَطِّهَا فَإِنَّهَا مِنَ  الْعَوْرَةِ  .  كذا في طبعة مكتبة ابن تيمية ، ولعل الصواب:(عبد الرحمن بن جرهد) ، كذا هو في جميع طرق الحديث .","","Al-Mu'jam al-Kabir 2147","","جرهد بن رزاح الأسلمي عن عبد الرحمن بن جرهد الأسلمي عن الزهري عن معمر بن راشد عن سعيد بن أبي عروبة عن محمد بن سواء السدوسي عن محمد بن ثعلبة السدوسي عن محمد بن يحيى بن سهل العسكري عن الطبراني","جرهد الأسلمي"
"2146","2148  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَعَلِيُّ بْنُ إِبْرَاهِيمَ الْعَامِرِيُّ الْكُوفِيُّ ، قَالَا :  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  حَسَنُ بْنُ صَالِحٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ جَرْهَدٍ ،  عَنْ  أَبِيهِ ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  فَخِذُ الرَّجُلِ مِنَ  الْعَوْرَةِ  .","","Al-Mu'jam al-Kabir 2148","","جرهد بن رزاح الأسلمي عن عبد الرحمن بن جرهد الأسلمي عن عبد الله بن محمد بن عقيل بن أبي طالب عن الحسن بن صالح بن صالح بن حي عن أحمد بن عبد الله اليربوعي عن علي بن إبراهيم العامري الكوفي عن الطبراني","جرهد الأسلمي"
"2147","2149  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ  ، ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  زُهَيْرُ بْنُ مُحَمَّدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَرْهَدٍ الْأَسْلَمِيِّ ،  أَنَّهُ سَمِعَ  أَبَاهُ  ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  فَخِذُ الْمَرْءِ الْمُسْلِمِ مِنْ  عَوْرَتِهِ  .","","Al-Mu'jam al-Kabir 2149","","جرهد بن رزاح الأسلمي عن عبد الله بن جرهد الأسلمي عن عبد الله بن محمد بن عقيل بن أبي طالب عن زهير بن محمد التميمي عن موسى بن مسعود النهدي عن حفص بن عمر سنجة ألف عن الطبراني","جرهد الأسلمي"
"2148","2150  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ، قَالَ :  سَمِعْتُ  الْأَوْزَاعِيَّ ، يَقُولُ :  الْفَخِذُ فِي الْمَسْجِدِ  عَوْرَةٌ  ، وَفِي الْحَمَّامِ لَيْسَتْ  بِعَوْرَةٍ  "" .","","Al-Mu'jam al-Kabir 2150","","أبو عمرو الأوزاعي عن الوليد بن مسلم العنبري عن هشام بن عمار عن أحمد بن المعلى الأسدي عن الطبراني","جرهد الأسلمي"
"2149","2151  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ  ، ثَنَا  حَرْمَلَةُ بْنُ يَحْيَى ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ أَنَّ بُكَيْرًا  حَدَّثَهُ  عَنْ  سُفْيَانَ بْنِ فَرْوَةَ ،  عَنْ  بَعْضِ بَنِي جَرْهَدٍ ،  عَنْ  جَرْهَدٍ ،  أَنَّهُ أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَبَيْنَ يَدَيْهِ طَعَامٌ ،  فَأَدْنَى  جَرْهَدٌ  يَدَهُ الشِّمَالَ لِيَأْكُلَ ، وَكَانَتِ الْيُمْنَى مُصَابَةً ، فَقَالَ : "" كُلْ بِالْيَمِينِ  ، فَقَالَ : يَا رَسُولَ اللهِ إِنَّهَا مُصَابَةٌ ، فَنَفَثَ عَلَيْهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَمَا شَكَى حَتَّى مَاتَ  .","","Al-Mu'jam al-Kabir 2151","","جرهد بن رزاح الأسلمي عن بعض بني جرهد عن سفيان بن فروة الأسلمي عن بكير بن عبد الله بن الأشج القرشي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن حرملة بن يحيى التجيبي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","جرهد الأسلمي"
"2150","[2/274]      208 -  جَهْجَاهٌ الْغِفَارِيُّ  2152  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالُوا :  ثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  حَدَّثَنِي  مُوسَى بْنُ عُبَيْدَةَ ،  حَدَّثَنِي  عُبَيْدُ بْنُ سَلْمَانَ الْأَغَرُّ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  جَهْجَاهٍ الْغِفَارِيِّ ،  أَنَّهُ قَدِمَ فِي نَفَرٍ مِنْ قَوْمِهِ يُرِيدُونَ الْإِسْلَامَ ، فَحَضَرُوا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمَغْرِبَ ، فَلَمَّا سَلَّمَ قَالَ : "" يَأْخُذُ كُلُّ رَجُلٍ بِيَدِ جَلِيسِهِ "" ، فَلَمْ يَبْقَ فِي الْمَسْجِدِ غَيْرُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَغَيْرِي ، وَكُنْتُ عَظِيمًا طَوِيلًا لَا يُقَدَّمُ عَلَيَّ أَحَدٌ ، فَذَهَبَ بِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى مَنْزِلِهِ ، فَحَلَبَ لِي عَنْزًا ، فَأَتَيْتُ عَلَيْهَا حَتَّى حَلَبَ لِي سَبْعَ أَعْنُزٍ ، فَأَتَيْتُ عَلَيْهَا ، ثُمَّ أُتِيتُ بِصَنِيعِ  بُرْمَةٍ  ، فَأَتَيْتُ عَلَيْهَا ، وَقَالَتْ  أُمُّ أَيْمَنَ  : أَجَاعَ اللهُ مَنْ أَجَاعَ رَسُولَ اللهِ هَذِهِ اللَّيْلَةَ ، قَالَ : "" مَهْ يَا  أُمَّ أَيْمَنَ  أَكَلَ رِزْقَهُ ، وَرِزْقُنَا عَلَى اللهِ "" فَأَصْبَحُوا فَغَدَوْا ، فَاجْتَمَعَ هُوَ وَأَصْحَابُهُ ، فَجَعَلَ الرَّجُلُ يُخْبِرُ بِمَا أُتِيَ إِلَيْهِ ، فَقَالَ  جَهْجَاهٌ  : حُلِبَتْ لِي سَبْعُ أَعْنُزٍ ، فَأَتَيْتُ عَلَيْهَا وَصَنِيعُ  بُرْمَةٍ  فَأَتَيْتُ عَلَيْهَا ، فَصَلَّوْا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمَغْرِبَ ، فَقَالَ : "" لِيَأْخُذْ كُلُّ رَجُلٍ بِيَدِ جَلِيسِهِ "" ، فَلَمْ يَبْقَ فِي الْمَسْجِدِ غَيْرُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَغَيْرِي ، وَكُنْتُ عَظِيمًا طَوِيلًا لَا يُقَدَّمُ عَلَيَّ أَحَدٌ ، فَذَهَبَ بِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى مَنْزِلِهِ فَحَلَبَ لِي عَنْزًا ، فَرُوِيتُ وَشَبِعْتُ ، فَقَالَتْ  أُمُّ أَيْمَنَ  : يَا رَسُولَ اللهِ أَلَيْسَ هَذَا ضَيْفَنَا ؟ قَالَ : "" بَلَى "" فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّهُ أَكَلَ فِي  مِعَى  مُؤْمِنٍ اللَّيْلَةَ وَأَكَلَ قَبْلَ ذَلِكَ فِي  مِعَى  كَافِرٍ ، الْكَافِرُ يَأْكُلُ فِي سَبْعَةِ أَمْعَاءٍ ، وَالْمُؤْمِنُ يَأْكُلُ فِي  مِعًى  وَاحِدٍ  .","","Al-Mu'jam al-Kabir 2152","","جهجاه بن سعيد الغفاري عن عطاء بن يسار الهلالي عن عبيد بن سلمان الأغر عن موسى بن عبيدة بن نشيط الحميري عن زيد بن الحباب العكلي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","جهجاه الغفاري"
"2151","[2/275]      209 -  جُلَيْحَةُ بْنُ عَبْدِ اللهِ اللَّيْثِيُّ  اسْتُشْهِدَ  يَوْمَ الطَّائِفِ  2153  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ  ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ  : ""  فِي تَسْمِيَةِ مَنِ اسْتُشْهِدَ  يَوْمَ الطَّائِفِ  جُلَيْحَةُ بْنُ عَبْدِ اللهِ بْنِ مُحَارِبِ بْنِ نَاشِبِ بْنِ سَعْدِ بْنِ لَيْثٍ  "" .","","Al-Mu'jam al-Kabir 2153","","","جليحة بن عبد الله الليثي"
"2152","210 -  جَدُّ بْنُ قَيْسٍ الْأَنْصَارِيُّ السُّلَمِيُّ  2154  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ ،  ثَنَا  بِشْرُ بْنُ عُمَارَةَ ،  عَنْ  أَبِي رَوْقٍ ،  عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  لَمَّا أَرَادَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  غَزْوَةَ تَبُوكَ  ، قَالَ  لِجَدِّ بْنِ قَيْسٍ  :  هَلْ لَكَ فِي بَنَاتِ  الْأَصْفَرِ  "" فَقَالَ : ائْذَنْ لِي وَلَا تَفْتِنِّي ، فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ :         {      وَمِنْهُمْ مَنْ يَقُولُ ائْذَنْ لِي وَلا تَفْتِنِّي         }      .","","Al-Mu'jam al-Kabir 2154","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن عطية بن الحارث الهمداني عن بشر بن عمارة الخثعمي عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","جد بن قيس الأنصاري السلمي"
"2153","211 -  جَهْمٌ الْبَلَوِيُّ  2155  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ خَلَّادٍ أَبُو أُمَيَّةَ الْوَاسِطِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ عِمْرَانَ ،  عَنْ  جَهْمِ بْنِ مُطِيعٍ ،  عَنْ  عَلِيِّ بْنِ جَهْمٍ الْبَلَوِيِّ ،  عَنْ  أَبِيهِ  ، قَالَ :  وَافَيْنَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمَ الْجُمُعَةِ  فَسَأَلَنَا مَنْ نَحْنُ؟ فَقُلْنَا : نَحْنُ  بَنُو عَبْدِ مَنَافٍ  فَقَالَ : "" أَنْتُمْ بَنُو عَبْدِ اللهِ  .","","Al-Mu'jam al-Kabir 2155","","جهم البلوي عن علي بن جهم البلوي عن جهم بن مطيع عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن يعقوب بن محمد بن عيسى عن عبد الله بن محمد بن خلاد العراقي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","جهم البلوي"
"2154","212 -  جُودَانُ وَيُقَالُ ابْنُ جُودَانَ  2156  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  وَكِيعٌ ،         [2/276]      (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  مَلِيحُ بْنُ وَكِيعٍ ،  ثَنَا  أَبِي  ،  عَنْ  سُفْيَانَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  الْعَبَّاسِ بْنِ عَبْدِ الْمُطَّلِبِ ،  عَنِ  العَبَّاسِ بْنِ عَبْدِ الرَّحْمَنِ بْنُ  مِينَاء ،  عَنْ  جُودَانَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنِ اعْتَذَرَ إِلَى أَخِيهِ مَعْذِرَةً فَلَمْ يَقْبَلْهَا ، فَإِنَّهُ عَلَيْهِ مِثْلُ خَطِيئَةِ صَاحِبِ  مَكْسٍ  .  سقط من طبعة مكتبة ابن تيمية والمثبت من النسخ الخطية","","Al-Mu'jam al-Kabir 2156","","جودان العبدي الكوفي عن عباس بن عبد الرحمن بن مينا الأشجعي عن العباس بن عبد المطلب عن ابن جريج عن سفيان الثوري عن وكيع بن الجراح عن مليح بن وكيع بن الجراح عن الحسين بن إسحاق التستري عن الطبراني","جودان ويقال ابن جودان"
"2155","-  جَمِيلُ بْنُ بَصْرَةَ أَبُو بَصْرَةَ الْغِفَارِيُّ  "" وَيُقَالُ  حَمِيلٌ  ، وَيُقَالُ  خَمِيلٌ  ، وَالصَّوَابُ  جَمِيلٌ  ""  2157  -  حَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِيُّ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّهُ أَقْبَلَ مِنَ  الطُّورِ  ، فَلَقِيَ جَمِيلَ بْنَ بَصْرَةَ الْغِفَارِيَّ ،  فَقَالَ لَهُ  جَمِيلٌ  :  لَوْ لَقِيتُكَ قَبْلَ أَنْ تَأْتِيَ  الطُّورَ  لَمْ تَأْتِهِ  فَذَكَرَ الْحَدِيثَ  .","","Al-Mu'jam al-Kabir 2157","","حميل بن بصرة الغفاري عن أبو هريرة الدوسي عن سعيد المقبري عن زيد بن أسلم عن عبد العزيز بن محمد الدراوردي عن يحيى بن عبد الله بن بكير المخزومي عن عمرو بن أبي الطاهر المصري عن الطبراني","جميل بن بصرة أبو بصرة الغفاري"
"2156","2158  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ مُجَبَّرٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ ،  عَنْ  جَمِيلٍ الْغِفَارِيِّ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا تُضْرَبُ الْمَطَايَا إِلَّا إِلَى ثَلَاثَةِ مَسَاجِدَ  :  مَسْجِدِ الْحَرَامِ  ، وَمَسْجِدِي هَذَا ،  وَمَسْجِدِ بَيْتِ الْمَقْدِسِ  .","","Al-Mu'jam al-Kabir 2158","","حميل بن بصرة الغفاري عن أبو هريرة الدوسي عن سعيد المقبري عن زيد بن أسلم عن محمد بن عبد الرحمن بن المجبر عن سعيد بن سليمان سعدويه عن أحمد بن يحيى بن إسحاق الحلواني عن الطبراني","جميل بن بصرة أبو بصرة الغفاري"
"2157","2159  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ،  ثَنَا  أُمَيَّةُ بْنُ بِسْطَامٍ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  رَوْحِ بْنِ الْقَاسِمِ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ الْمَقْبُرِيِّ  أَنَّ  أَبَا بَصْرَةَ جَمِيلَ بْنَ بَصْرَةَ لَقِيَ  أَبَا هُرَيْرَةَ  وَهُوَ مُقْبِلٌ مِنَ  الطُّورِ  ، فَقَالَ : لَوْ لَقِيتُكَ قَبْلَ أَنْ تَأْتِيَهُ ، إِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّمَا  تُضْرَبُ  أَكْبَادُ  الْمَطِيِّ  إِلَى ثَلَاثَةِ مَسَاجِدَ  :  الْمَسْجِدِ الْحَرَامِ  ، وَمَسْجِدِي هَذَا ،         [2/277]      وَالْمَسْجِدِ الْأَقْصَى  .","","Al-Mu'jam al-Kabir 2159","","حميل بن بصرة الغفاري عن سعيد المقبري عن زيد بن أسلم عن روح بن القاسم العنبري عن يزيد بن زريع العيشي عن أمية بن بسطام عن إبراهيم بن هاشم البغوي عن الطبراني","جميل بن بصرة أبو بصرة الغفاري"
"2158","2160  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  عُمَرَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ،  عَنْ  أَبِي بَصْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تُشَدُّ الرِّحَالُ إِلَّا إِلَى ثَلَاثَةِ مَسَاجِدَ  :  الْمَسْجِدِ الْحَرَامِ  ،  وَمَسْجِدِ الرَّسُولِ  ،  وَمَسْجِدِ الْأَقْصَى  .","","Al-Mu'jam al-Kabir 2160","","حميل بن بصرة الغفاري عن عمر بن عبد الرحمن بن الحارث المخزومي عن عبد الملك بن عمير القبطي عن الوضاح بن عبد الله اليشكري عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","جميل بن بصرة أبو بصرة الغفاري"
"2159","2161  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ ،  حَدَّثَنِي  أَبِي  ،  عَنِ  ابْنِ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  مَرْثَدِ بْنِ عَبْدِ اللهِ الْيَزَنِيِّ ،  عَنْ  أَبِي بَصْرَةَ الْغِفَارِيِّ قَالَ :  لَقِيتُ  أَبَا هُرَيْرَةَ  ، فَقُلْتُ : إِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا تُشَدُّ  الْمَطِيُّ  إِلَّا إِلَى ثَلَاثَةِ مَسَاجِدَ  : مَسْجِدِي ،  وَمَسْجِدِ الْحَرَامِ  ،  وَمَسْجِدِ الْأَقْصَى  .","","Al-Mu'jam al-Kabir 2161","","حميل بن بصرة الغفاري عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","جميل بن بصرة أبو بصرة الغفاري"
"2160","بَابٌ  2162  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  حَدَّثَنَا  أَبُو عَاصِمٍ ،  عَنْ  عَبْدِ الْحَمِيدِ بْنِ جَعْفَرٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  مَرْثَدِ بْنِ عَبْدِ اللهِ الْيَزَنِيِّ ،  عَنْ  أَبِي بَصْرَةَ الْغِفَارِيِّ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ لَهُمْ :  إِنِّي أَرْكَبُ إِلَى يَهُودَ ، فَمَنِ انْطَلَقَ مَعِي مِنْكُمْ فَلَا تَبْدَءُوهُمُ السَّلَامَ  ، فَإِنْ سَلَّمُوا فَقُولُوا : وَعَلَيْكُمْ "" "" فَلَمَّا جِئْنَاهُمْ سَلَّمُوا عَلَيْنَا ، فَقُلْنَا : وَعَلَيْكُمْ  .","","Al-Mu'jam al-Kabir 2162","","حميل بن بصرة الغفاري عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن عبد الحميد بن جعفر الأوسي عن أبو عاصم النبيل عن أبو مسلم الكجي عن الطبراني","باب"
"2161","2163  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ         [2/278]      يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  أَبِي الْخَيْرِ مَرْثَدِ بْنِ عَبْدِ اللهِ الْيَزَنِيِّ ،  عَنْ  أَبِي بَصْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّا ذَاهِبُونَ غَدًا إِلَى الْيَهُودِ ، فَإِذَا لَقِيتُمُوهُمْ فَسَلَّمُوا عَلَيْكُمْ ، فَقُولُوا : وَعَلَيْكُمْ  "" فَلَقِينَاهُمْ وَسَلَّمُوا عَلَيْنَا فَقُلْنَا : وَعَلَيْكُمْ  .","","Al-Mu'jam al-Kabir 2163","","حميل بن بصرة الغفاري عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","باب"
"2162","2164  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  مَرْثَدِ بْنِ عَبْدِ اللهِ الْيَزَنِيِّ ،  عَنْ  أَبِي بَصْرَةَ الْغِفَارِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنِّي مُنْطَلِقٌ غَدًا إِلَى يَهُودَ فَلَا تَبْدَءُوهُمْ بِالسَّلَامِ ، فَإِنْ سَلَّمُوا عَلَيْكُمْ فَقُولُوا : وَعَلَيْكُمْ  .","","Al-Mu'jam al-Kabir 2164","","حميل بن بصرة الغفاري عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن عمرو بن خالد بن فروخ عن روح بن الفرج القطان عن الطبراني","باب"
"2163","بَابٌ  2165  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي حَبِيبٍ ،  عَنْ  خَيْرِ بْنِ نُعَيْمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ هُبَيْرَةَ ،  عَنْ  أَبِي تَمِيمٍ الْجَيْشَانِيِّ ،  عَنْ  أَبِي بَصْرَةَ الْغِفَارِيِّ رَضِيَ اللهُ عَنْهُ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى يَوْمًا صَلَاةَ الْعَصْرِ  بِالْمُخَمَّصِ  ثُمَّ انْصَرَفَ  ، فَقَالَ : "" هَذِهِ الصَّلَاةُ عُرِضَتْ عَلَى مَنْ كَانَ قَبْلَكُمْ فَتَوَانَوْا عَنْهَا وَتَرَكُوهَا ، فَمَنْ صَلَّاهَا مِنْكُمْ ضُعِّفَ لَهُ أَجْرُهَا ضِعْفَيْنِ ، وَلَا صَلَاةَ بَعْدَهَا حَتَّى يَطْلُعَ  الشَّاهِدُ  ، قَالَ  اللَّيْثُ  : وَقَدْ سَمِعْتُهُ مِنْ  خَيْرِ بْنِ نُعَيْمٍ  بِهَذَا  الْإِسْنَادِ  .","","Al-Mu'jam al-Kabir 2165","","حميل بن بصرة الغفاري عن عبد الله بن مالك بن أبي الأسحم الجيشاني عن عبد الله بن هبيرة السبئي عن خير بن نعيم الناهضى عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","باب"
"2164","2166  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ (  ح  ) .  وَحَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ، قَالَا :  ثَنَا  ابْنُ لَهِيعَةَ ،  ثَنَا  ابْنُ هُبَيْرَةَ ، أَنَّ أَبَا تَمِيمٍ الْجَيْشَانِيَّ عَبْدَ اللهِ بْنَ مَالِكٍ  حَدَّثَهُ  أَنَّهُ سَمِعَ  أَبَا بَصْرَةَ الْغِفَارِيَّ ، يَقُولُ :  صَلَّى لَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْعَصْرَ بِالْمُخَمَّصِ وَادٍ مِنْ بَعْضِ أَوْدِيَتِهِمْ ثُمَّ قَالَ :  إِنَّ هَذِهِ الصَّلَاةَ عُرِضَتْ عَلَى الَّذِينَ مِنْ قَبْلِكُمْ         [2/279]      فَتَرَكُوهَا  ، أَلَا وَمَنْ صَلَّاهَا ضُعِّفَ لَهُ أَجْرُهَا ، وَلَا صَلَاةَ بَعْدَهَا حَتَّى تَرَوُا  الشَّاهِدَ  وَهُوَ النَّجْمُ  .","","Al-Mu'jam al-Kabir 2166","","حميل بن بصرة الغفاري عن عبد الله بن مالك بن أبي الأسحم الجيشاني عن عبد الله بن هبيرة السبئي عن عبد الله بن لهيعة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","باب"
"2165","بَابٌ  2167  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنِي  ابْنُ هُبَيْرَةَ ، أَنَّ أَبَا تَمِيمٍ الْجَيْشَانِيَّ عَبْدَ اللهِ بْنَ مَالِكٍ  أَخْبَرَهُ  أَنَّهُ سَمِعَ  عَمْرَو بْنَ الْعَاصِ ، يَقُولُ :  أَخْبَرَنِي  رَجُلٌ مِنْ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ اللهَ عَزَّ وَجَلَّ قَدْ زَادَكُمْ صَلَاةً فَصَلُّوهَا فِيمَا بَيْنَ صَلَاةِ الْعِشَاءِ إِلَى صَلَاةِ الصُّبْحِ  الْوِتْرَ  الْوِتْرَ  ، أَلَا وَإِنَّهُ أَبُو بَصْرَةَ الْغِفَارِيُّ ، قَالَ  أَبُو تَمِيمٍ  : فَكُنْتُ أَنَا  وَأَبُو ذَرٍّ  قَاعِدَيْنِ فَأَخَذَ بِيَدِي  أَبُو ذَرٍّ  ، فَانْطَلَقْنَا إِلَى  أَبِي بَصْرَةَ  فَوَجَدْنَاهُ عِنْدَ الْبَابِ الَّذِي عِنْدَ دَارِ  عَمْرٍو  فَقَالَ لَهُ  أَبُو ذَرٍّ  : يَا  أَبَا بَصْرَةَ  أَنْتَ سَمِعْتَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : "" إِنَّ اللهَ قَدْ زَادَكُمْ صَلَاةً فَصَلُّوهَا فِيمَا بَيْنَ الْعِشَاءِ إِلَى صَلَاةِ الصُّبْحِ  الْوِتْرَ  الْوِتْرَ  "" ، قَالَ : نَعَمْ ، قَالَ : أَنْتَ سَمِعْتَ ؟ قَالَ : نَعَمْ  .","","Al-Mu'jam al-Kabir 2167","","حميل بن بصرة الغفاري عن عمرو بن العاص بن وائل السهمي عن عبد الله بن مالك بن أبي الأسحم الجيشاني عن عبد الله بن هبيرة السبئي عن عبد الله بن لهيعة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","باب"
"2166","2168  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  سَعِيدِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ هُبَيْرَةَ ،  عَنْ  أَبِي تَمِيمٍ ،  عَنْ  أَبِي بَصْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ عَزَّ وَجَلَّ زَادَكُمْ صَلَاةً فَحَافِظُوا عَلَيْهَا  ، وَجَعَلَ وَقْتَهَا فِيمَا بَيْنَ الْعِشَاءِ إِلَى الْفَجْرِ وَهِيَ  الْوِتْرُ  .","","Al-Mu'jam al-Kabir 2168","","حميل بن بصرة الغفاري عن عبد الله بن مالك بن أبي الأسحم الجيشاني عن عبد الله بن هبيرة السبئي عن سعيد بن يزيد الحميري عن عبد الله بن المبارك عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"2167","2169  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ الْبَصْرِيُّ ،  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ،  ثَنَا  سَعِيدُ بْنُ أَبِي أَيُّوبَ قَالَ :  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي حَبِيبٍ ، أَنَّ كُلَيْبَ بْنَ ذُهْلٍ ،  حَدَّثَهُ  أَنَّ         [2/280]      عُبَيْدَ بْنَ جَبْرٍ ، قَالَ :  رَكِبْتُ مَعَ أَبِي بَصْرَةَ صَاحِبِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَفِينَةً مِنَ  الْفُسْطَاطِ  ثُمَّ قَرَّبَ غَدَاءَهُ ، ثُمَّ قَالَ لِي : "" اقْتَرِبْ  فَقُلْتُ : أَلَيْسَ نَحْنُ فِي الْبُيُوتِ ؟ فَقَالَ  أَبُو بَصْرَةَ  : "" أَرَغِبْتَ عَنْ سُنَّةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ "" .","","Al-Mu'jam al-Kabir 2169","","حميل بن بصرة الغفاري عن عبيد بن جبر القبطي عن كليب بن ذهل الحضرمي عن يزيد بن أبي حبيب الأزدي عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","باب"
"2168","2170  -  حَدَّثَنَا  الْمُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ (  ح  ) .  وَحَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  اللَّيْثُ بْنُ سَعْدٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  كُلَيْبِ بْنِ ذُهْلٍ الْحَضْرَمِيِّ ،  عَنْ  عُبَيْدِ بْنِ جَبْرٍ  أَنَّهُ سَافَرَ مَعَ أَبِي بَصْرَةَ الْغِفَارِيِّ فِي رَمَضَانَ ، فَلَمَّا دَفَعُوا مِنَ  الْفُسْطَاطِ  دَعَا بِطَعَامٍ  وَنَحْنُ نَنْظُرُ إِلَى  الْفُسْطَاطِ  ، فَقُلْتُ لَهُ : تَأْكُلُ وَلَوْ نُرِيدُ أَنْ نَنْظُرَ إِلَى  الْفُسْطَاطِ  نَظَرْنَا إِلَيْهِ ؟ فَقَالَ : "" تَرْغَبُ عَنْ سُنَّةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابِهِ ؟ فَأَفْطَرَ "" .","","Al-Mu'jam al-Kabir 2170","","حميل بن بصرة الغفاري عن عبيد بن جبر القبطي عن كليب بن ذهل الحضرمي عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","باب"
"2169","2171  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  أَبِي هَانِئٍ الْخَوْلَانِيِّ ، عَمَّنْ  حَدَّثَهُ  ،  عَنْ  أَبِي بَصْرَةَ الْغِفَارِيِّ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  سَأَلْتُ رَبِّي أَرْبَعًا فَأَعْطَانِي ثَلَاثًا وَمَنَعَنِي وَاحِدَةً  ، سَأَلْتُهُ أَنْ لَا يَجْمَعَ أُمَّتِي عَلَى ضَلَالَةٍ فَأَعْطَانِيهَا ، وَسَأَلْتُهُ أَنْ لَا يُهْلِكَهُمْ بِالسِّنِينَ كَمَا أَهْلَكَ الْأُمَمَ قَبْلَهُمْ فَأَعْطَانِيهَا ، وَسَأَلْتُهُ أَنْ لَا يُظْهِرَ عَلَيْهِمْ عَدُوًّا مِنْ غَيْرِهِمْ فَأَعْطَانِيهَا ، وَسَأَلْتُهُ أَنْ لَا  يَلْبِسَهُمْ  شِيَعًا  وَلَا يُذِيقَ بَعْضَهُمْ بَأْسَ بَعْضٍ فَمَنَعَنِيهَا  .","","Al-Mu'jam al-Kabir 2171","","حميل بن بصرة الغفاري عن عمن عن حميد بن هانئ الخولاني عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","باب"
"2170","214 -  جُعَيْلٌ الْأَشْجَعِيُّ  2172  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الرَّقَاشِيُّ ،  ثَنَا  رَافِعُ بْنُ سَلَمَةَ بْنِ زِيَادٍ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ أَبِي الْجَعْدِ ،  عَنْ  جُعَيْلٍ الْأَشْجَعِيِّ ، قَالَ :  غَزَوْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي بَعْضِ غَزَوَاتِهِ ، وَأَنَا عَلَى فَرَسٍ لِي عَجْفَاءَ ضَعِيفَةٍ ، فَكُنْتُ فِي آخِرِ النَّاسِ فَلَحِقَنِي ، فَقَالَ :  سِرْ يَا صَاحِبَ الْفَرَسِ  ، فَقُلْتُ : يَا رَسُولَ اللهِ عَجْفَاءُ ضَعِيفَةٌ ، فَرَفَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مِخْفَقَةً  كَانَتْ         [2/281]      مَعَهُ فَضَرَبَهَا بِهَا ، وَقَالَ : "" اللَّهُمَّ بَارِكْ لَهُ فِيهَا "" قَالَ : فَلَقَدْ رَأَيْتُنِي أَمْسِكُ رَأْسَهَا أَنْ تَقَدَّمَ النَّاسَ ، قَالَ : وَلَقَدْ بِعْتُ مِنْ بَطْنِهَا بِاثْنَيْ عَشَرَ أَلْفًا  .","","Al-Mu'jam al-Kabir 2172","","جعيل بن زياد الأشجعي عن عبد الله بن أبي الجعد الغطفاني عن رافع بن سلمة الغطفاني عن محمد بن عبد الله بن محمد بن عبد الملك الرقاشي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","جعيل الأشجعي"
"2171","215 -  جُنَادَةُ بْنُ أَبِي أُمَيَّةَ الْأَزْدِيُّ  بَابٌ  2173  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ (  ح  ) .  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  أَحْمَدُ بْنُ خَالِدٍ الْوَهْبِيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  مَرْثَدِ بْنِ عَبْدِ اللهِ الْيَزَنِيِّ ،  عَنْ  حُذَافَةَ الْأَزْدِيِّ ،  عَنْ  جُنَادَةَ الْأَزْدِيِّ ، قَالَ :  دَخَلْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي نَفَرٍ مِنَ  الْأَزْدِ  يَوْمَ الْجُمُعَةِ ، فَدَعَانَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى طَعَامٍ بَيْنَ يَدَيْهِ ، فَقُلْنَا : إِنَّا صِيَامٌ ، فَقَالَ : "" صُمْتُمْ أَمْسِ ؟ "" قُلْنَا : لَا ، قَالَ : "" فَتَصُومُونَ غَدًا ؟ "" قُلْنَا : لَا ، قَالَ : "" فَأَفْطِرُوا "" ثُمَّ قَالَ :  لَا تَصُومُوا يَوْمَ الْجُمُعَةِ مُفْرَدًا  .","","Al-Mu'jam al-Kabir 2173","","جنادة بن أبي أمية الأزدي عن حذيفة البارقي عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن يزيد بن هارون عن إدريس بن جعفر العطار عن الطبراني","جنادة بن أبي أمية الأزدي"
"2172","2174  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  مَرْثَدِ بْنِ عَبْدِ اللهِ الْيَزَنِيِّ ،  عَنْ  حُذَافَةَ الْأَزْدِيِّ ،  عَنْ  جُنَادَةَ الْأَزْدِيِّ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2174","","جنادة بن أبي أمية الأزدي عن حذيفة البارقي عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","جنادة بن أبي أمية الأزدي"
"2173","2175  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي حَبِيبٍ ،  عَنْ  أَبِي الْخَيْرِ ،  عَنْ  حُذَيْفَةَ الْأَزْدِيِّ ،  عَنْ  جُنَادَةَ الْأَزْدِيِّ ،  أَنَّهُمْ وَلَجُوا عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُمْ ثَمَانِيَةُ رَهْطٍ هُوَ ثَامِنُهُمْ يَوْمَ الْجُمُعَةِ فَدَعَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِطَعَامٍ ، فَقَالَ  لِرَجُلٍ  : "" كُلْ "" فَقَالَ : صَائِمٌ ، قَالَ  لِآخَرَ  : "" كُلْ "" فَقَالَ : صَائِمٌ حَتَّى سَأَلَهُمْ جَمِيعًا ، فَقَالَ :  صُمْتُمْ أَمْسِ ؟         [2/282]      فَقَالُوا : لَا ، فَقَالَ : "" أَصُيَّامٌ غَدًا ؟ "" قَالُوا : لَا "" فَأَمَرَهُمْ أَنْ يُفْطِرُوا  .","","Al-Mu'jam al-Kabir 2175","","جنادة بن أبي أمية الأزدي عن حذيفة البارقي عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","جنادة بن أبي أمية الأزدي"
"2174","2176  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  ابْنُ لَهِيعَةَ ،  ثَنَا  يَزِيدُ بْنُ أَبِي حَبِيبٍ ، أَنَّ أَبَا الْخَيْرِ  حَدَّثَهُ  ، أَنَّ حُذَيْفَةَ الْبَارِقِيَّ  حَدَّثَهُ  أَنَّ جُنَادَةَ بْنَ أَبِي أُمَيَّةَ الْأَزْدِيَّ  حَدَّثَهُ  ،  أَنَّهُمْ دَخَلُوا عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثَمَانِيَةُ نَفَرٍ هُوَ ثَامِنُهُمْ فَقَرَّبَ إِلَيْهِمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ طَعَامًا فِي يَوْمِ جُمُعَةٍ ، فَقَالَ : "" كُلُوا "" فَقَالُوا : صِيَامٌ ، فَقَالَ :  أَصُمْتُمْ أَمْسِ ؟  ، قَالُوا : لَا قَالَ : "" أَفَصَائِمُونَ أَنْتُمْ غَدًا ؟ "" قَالُوا : لَا ، قَالَ : "" فَأَفْطِرُوا  .","","Al-Mu'jam al-Kabir 2176","","جنادة بن أبي أمية الأزدي عن حذيفة البارقي عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","جنادة بن أبي أمية الأزدي"
"2175","2177  -  حَدَّثَنَا  أَبُو حَبِيبٍ يَحْيَى بْنُ نَافِعٍ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ الْيَسَعِ ،  حَدَّثَنِي  أَبُو بَكْرٍ الْهُذَلِيُّ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الصَّنْعَانِيِّ ،  أَنَّ  جُنَادَةَ الْأَزْدِيَّ أَمَّ قَوْمًا ، فَلَمَّا قَامَ إِلَى الصَّلَاةِ الْتَفَتَ عَنْ يَمِينِهِ ، فَقَالَ : أَتَرْضَوْنَ ، قَالُوا : نَعَمْ ، ثُمَّ فَعَلَ مِثْلَ ذَلِكَ عَنْ يَسَارِهِ ، ثُمَّ قَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  مَنْ أَمَّ قَوْمًا وَهُمْ لَهُ كَارِهُونَ فَإِنَّ صَلَاتَهُ لَا تُجَاوِزُ تَرْقُوَتَهُ  .","","Al-Mu'jam al-Kabir 2177","","جنادة بن أبي أمية الأزدي عن يزيد بن مرثد الهمداني عن شهر بن حوشب عن أبو بكر الهذلي عن إسماعيل بن اليسع الكوفي عن سعيد بن الحكم الجمحي عن يحيى بن نافع بن خالد المصري عن الطبراني","جنادة بن أبي أمية الأزدي"
"2176","216 -  جُنَادَةُ بْنُ مَالِكٍ  2178  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ، وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ الرَّحْمَنِ الْأَزْدِيُّ  ،  عَنْ  عُبَيْدَةَ بْنِ الْأَسْوَدِ ،  عَنْ  قَاسِمِ بْنِ الْوَلِيدِ ،  عَنْ  مُصْعَبِ بْنِ عُبَيْدِ اللهِ بْنِ جُنَادَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ جُنَادَةَ بْنِ مَالِكٍ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ثَلَاثٌ مِنْ فِعْلِ أَهْلِ الْجَاهِلِيَّةِ لَا يَدَعُهُنَّ أَهْلُ الْإِسْلَامِ  : اسْتِسْقَاءٌ بِالْكَوَاكِبِ ، وَطَعْنٌ فِي النَّسَبِ ، وَالنِّيَاحَةُ عَلَى الْمَيِّتِ  .  كذا في طبعة مكتبة ابن تيمية ، وقد اشار محقق "" الجرح والتعديل "" لابن أبي حاتم في ترجمته (9 / 167): بأن كلمة ( الارحبي ) تصحفت إلى (الازدي) .","","Al-Mu'jam al-Kabir 2178","","جنادة بن مالك الأزدي عن عبيد الله بن جنادة الأزدي عن مصعب بن عبيد الله بن جنادة الأزدي عن القاسم بن الوليد الخبذعي عن عبيدة بن الأسود بن سعيد الهمداني عن يحيى بن عبد الرحمن بن مالك الأرحبي عن أبو كريب محمد بن العلاء عن الحسين بن إسحاق التستري عن الطبراني","جنادة بن مالك"
"2177","[2/283]      217 -  جُنَادَةُ بْنُ جَرَادٍ الْغَيْلَانِيُّ  2179  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  عَوْنُ بْنُ الْحَكَمِ بْنِ سَعْدٍ  الْبَاهِلِيُّ ،  حَدَّثَنَا  زِيَادُ بْنُ قُرَيْعٍ ، أَحَدُ بَنِي غَيْلَانَ بْنِ جَاوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  جُنَادَةَ بْنِ جَرَادَةَ أَحَدِ بَنِي غَيْلَانَ بْنِ جَاوَةَ ، قَالَ :  أَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِإِبِلٍ قَدْ  وَسَمْتُهَا  فِي أَنْفِهَا فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  جُنَادَةُ  مَا وَجَدْتَ فِيهَا عُضْوًا  تَسِمُهُ  إِلَّا فِي الْوَجْهِ  ، أَمَا إِنَّ أَمَامَكَ الْقِصَاصَ "" فَقَالَ : أَمْرُهَا إِلَيْكَ يَا رَسُولَ اللهِ ، فَقَالَ : "" ائْتِنِي بِشَيْءٍ لَيْسَ عَلَيْهِ وَسْمٌ "" فَأَتَيْتُهُ بِابْنِ  لَبُونٍ  وَحِقَّةٍ فَوَضَعْتُ  الْمِيسَمَ  فِي الْعُنُقِ فَلَمْ يَزَلْ يَقُولُ : "" أَخِّرْ أَخِّرْ "" حَتَّى بَلَغَ الْفَخِذَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" سِمْ عَلَى بَرَكَةِ اللهِ "" فَوَسَمْتُهَا فِي أَفْخَاذِهَا وَكَانَتْ صَدَقَتُهَا حِقَّتَانِ ، وَكَانَتْ تِسْعِينَ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : (بن سنان).","","Al-Mu'jam al-Kabir 2179","","جنادة بن جراد العيلاني عن قريع الغيلاني عن زياد بن قريع عن عون بن الحكم بن سنان القربي عن أحمد بن داود بن موسى السدوسي عن الطبراني","جنادة بن جراد الغيلاني"
"2178","218 -  جُرْمُوزٌ الْهُجَيْمِيُّ  2180  -  حَدَّثَنَا  مُحَمَّدُ بْنُ هِشَامٍ الْمُسْتَمْلِي ،  أَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عَرْعَرَةَ ،  ثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ هَوْذَةَ ،  عَنْ  جُرْمُوزٍ الْهُجَيْمِيِّ ، يَقُولُ :  قُلْتُ : يَا رَسُولَ اللهِ أَوْصِنِي ، قَالَ :  أُوصِيكَ أَنْ لَا تَكُونَ لَعَّانًا  .","","Al-Mu'jam al-Kabir 2180","","جرموز بن أوس الهجيمي عن عبيد الله بن هوذة القريعي عن عبد الصمد بن عبد الوارث التنوري عن إبراهيم بن محمد بن عرعرة عن ابن أبى الدميك محمد بن هشام بن علي عن الطبراني","جرموز الهجيمي"
"2179","2181  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ الْوَارِثِ بْنُ عَبْدِ الصَّمَدِ بْنِ عَبْدِ الْوَارِثِ ،  حَدَّثَنِي  أَبِي  ،  حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ هَوْذَةَ الْقُرَيْعِيُّ ، قَالَ :  حَدَّثَنِي  رَجُلٌ  أَنَّهُ سَمِعَ  جُرْمُوزً الْهُجَيْمِيَّ ، يَقُولُ :  قُلْتُ : يَا رَسُولَ اللهِ أَوْصِنِي ، قَالَ :  أُوصِيكَ أَنْ لَا تَكُونَ لَعَّانًا  .         [2/284]","","Al-Mu'jam al-Kabir 2181","","جرموز بن أوس الهجيمي عن رجل عن عبيد الله بن هوذة القريعي عن عبد الصمد بن عبد الوارث التنوري عن عبد الوارث بن عبد الصمد التنوري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","جرموز الهجيمي"
"2180","2182  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْوَهَّابِ الصَّيْرَفِيُّ ،  ثَنَا  الْحَسَنُ بْنُ حَبِيبِ بْنِ نُدْبَةَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ هَوْذَةَ الْقُرَيْعِيِّ ،  عَنْ  شَيْخٍ ،  عَنْ  جُرْمُوزٍ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2182","","جرموز بن أوس الهجيمي عن شيخ عن عبيد الله بن هوذة القريعي عن الحسن بن حبيب بن ندبة التميمي عن عبد الرحمن بن عبد الوهاب الصيرفي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","جرموز الهجيمي"
"2181","219 -  جَعْدَةُ الْجُشَمِيُّ  2183  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبْدُوسٍ ،  ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  أَنَا  شُعْبَةُ ،  أَخْبَرَنِي  أَبُو إِسْرَائِيلَ مَوْلَى بَنِي جُشَمَ بْنِ مُعَاوِيَةَ ، قَالَ :  سَمِعْتُ  جَعْدَةَ ، رَجُلًا مِنْهُمْ يُحَدِّثُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  جَاءُوا  بِرَجُلٍ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالُوا : إِنَّ هَذَا أَرَادَ أَنْ يَقْتُلَكَ فَقَالَ لَهُ :  لَمْ  تُرَعْ  لَمْ  تُرَعْ  لَوْ أَرَدْتَ ذَلِكَ لَمْ تُسَلَّطْ عَلَيَّ  .","","Al-Mu'jam al-Kabir 2183","","جعدة بن خالد بن الصمة الجشمي عن أبو إسرائيل الجشمي عن شعبة بن الحجاج عن علي بن الجعد عن محمد بن عبدوس السراج عن الطبراني","جعدة الجشمي"
"2182","2184  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  أَنَا  وَكِيعٌ ،  عَنْ  شُعْبَةَ ،  ثَنَا  أَبُو إِسْرَائِيلَ الْجُشَمِيُّ ،  عَنْ  شَيْخٍ لَهُمْ يُقَالُ لَهُ : جَعْدَةُ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَأَى لَهُ  رَجُلٌ  رُؤْيَا فَبَعَثَ إِلَيْهِ فَجَاءَ فَقَصَّهَا عَلَيْهِ ، وَكَانَ عَظِيمَ الْبَطْنِ ، فَقَالَ بِإِصْبَعِهِ فِي بَطْنِهِ :  لَوْ كَانَ هَذَا فِي غَيْرِ هَذَا لَكَانَ خَيْرًا لَكَ  .","","Al-Mu'jam al-Kabir 2184","","جعدة بن خالد بن الصمة الجشمي عن أبو إسرائيل الجشمي عن شعبة بن الحجاج عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","جعدة الجشمي"
"2183","2185  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْرَائِيلَ ،  عَنْ  شَيْخٍ لَهُمْ يُقَالُ لَهُ : جَعْدَةُ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَأَى  رَجُلًا  عَظِيمَ الْبَطْنِ ، فَقَالَ بِإِصْبَعِهِ فِي بَطْنِهِ ، وَقَالَ :  لَوْ كَانَ هَذَا فِي غَيْرِ هَذَا لَكَانَ خَيْرًا لَكَ  .","","Al-Mu'jam al-Kabir 2185","","جعدة بن خالد بن الصمة الجشمي عن أبو إسرائيل الجشمي عن شعبة بن الحجاج عن النضر بن شميل عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","جعدة الجشمي"
"2184","220 -  جَعْدَةُ بْنُ هُبَيْرَةَ  2186  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى ،  عَنْ  سُفْيَانَ ،  عَنْ         [2/285]      مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  جَعْدَةَ بْنِ هُبَيْرَةَ ، قَالَ :  ذُكِرَ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَوْلًى  لِبَنِي عَبْدِ الْمُطَّلِبِ  يُصَلِّي وَلَا يَنَامُ وَيَصُومُ وَلَا يُفْطِرُ ، فَقَالَ :  أَنَا أُصَلِّي وَأَنَامُ وَأَصُومُ وَأُفْطِرُ  ، وَلِكُلِّ عَمَلٍ  شِرَّةٌ  وَلِكُلِّ  شِرَّةٍ  فَتْرَةٌ  ، فَمَنْ يَكُنْ فَتْرَتُهُ إِلَى السُّنَّةِ فَقَدِ اهْتَدَى ، وَمَنْ يَكُ إِلَى غَيْرِ ذَلِكَ فَقَدْ ضَلَّ  .","","Al-Mu'jam al-Kabir 2186","","جعدة بن هبيرة بن أبي وهب المخزومي عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن سفيان الثوري عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","جعدة بن هبيرة"
"2185","2187  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  جَعْدَةَ بْنِ هُبَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خَيْرُ النَّاسِ  قَرْنِي  ثُمَّ الَّذِينَ يَلُونَهُمْ  ، ثُمَّ الَّذِينَ يَلُونَهُمْ ، ثُمَّ الَّذِينَ يَلُونَهُمْ ثُمَّ الْآخَرُونَ أَرْذَلُ  .","","Al-Mu'jam al-Kabir 2187","","جعدة بن هبيرة الأشجعي عن يزيد بن عبد الرحمن بن الأسود الزعافري عن إدريس بن يزيد الزعافري عن عبد الله بن إدريس الأودي عن أبو بكر ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","جعدة بن هبيرة"
"2186","2188  -  حَدَّثَنَا  الْقَاسِمُ بْنُ زَكَرِيَّا الْمُطَرِّزُ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  ابْنُ إِدْرِيسَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  جَعْدَةَ بْنِ هُبَيْرَةَ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خَيْرُ النَّاسِ  قَرْنِي  ثُمَّ الَّذِي يَلِيهِ ثُمَّ الْآخَرُونَ أَرْذَلُ  .","","Al-Mu'jam al-Kabir 2188","","جعدة بن هبيرة الأشجعي عن يزيد بن عبد الرحمن بن الأسود الزعافري عن إدريس بن يزيد الزعافري عن عبد الله بن إدريس الأودي عن أبو كريب محمد بن العلاء عن القاسم بن زكريا المطرز عن الطبراني","جعدة بن هبيرة"
"2187","2189  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  ابْنُ جُرَيْجٍ ،  حَدَّثَنِي  أَبُو الزُّبَيْرِ ،  عَنْ  مُجَاهِدٍ ،  أَنَّهُ حَدَّثَهُ  جَعْدَةُ بْنُ هُبَيْرَةَ رَضِيَ اللهُ عَنْهُ ، قَالَ :  نَهَانِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ ثَلَاثٍ  : أَنْ أَتَخَتَّمَ بِالذَّهَبِ وَلُبْسِ  الْقَسِّيِّ  وَعَنِ الْمِيثَرَةِ  .","","Al-Mu'jam al-Kabir 2189","","جعدة بن هبيرة بن أبي وهب المخزومي عن مجاهد بن جبر المخزومي عن أبو الزبير المكي عن ابن جريج عن روح بن عبادة القيسي عن محمد بن عبد الله بن نمير عن محمد بن عبد الله مطين الحضرمي عن الطبراني","جعدة بن هبيرة"
"2188","221 -  جَفْشِيشٌ الْكِنْدِيُّ  2190  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  الْحَسَنُ بْنُ صَالِحٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْجَفْشِيشِ الْكِنْدِيِّ ، قَالَ :  جَاءَ قَوْمٌ         [2/286]      مِنْ  كِنْدَةَ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالُوا : أَنْتَ مِنَّا ، فَادَّعَوْهُ ، فَقَالَ :  لَا  نَقْفُو  أُمَّنَا وَلَا نَنْتَفِي مِنْ أَبِينَا نَحْنُ وَلَدُ  النَّضْرِ بْنِ كِنَانَةَ  .","","Al-Mu'jam al-Kabir 2190","","جفشيش بن النعمان الكندي عن صالح بن صالح بن حي الثوري عن الحسن بن صالح بن صالح بن حي عن إسماعيل بن عمرو البجلي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","جفشيش الكندي"
"2189","2191  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  حَيَّانُ بْنُ بِشْرٍ الْقَاضِي ،  ثَنَا  يَحْيَى بْنُ آدَمَ ،  حَدَّثَنِي  عَلِيُّ بْنُ حَيٍّ ،  عَنْ  أَبِيهِ  ،  ثَنَا  الْجَفْشِيشُ الْكِنْدِيُّ ، قَالَ :  قُلْتُ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْتَ مِمَّنْ يَا رَسُولَ اللهِ ؟ قَالَ :  نَحْنُ  بَنُو النَّضْرِ بْنِ كِنَانَةَ  لَا  نَقْفُو  أُمَّنَا وَلَا نَنْتَفِي مِنْ أَبِينَا  .","","Al-Mu'jam al-Kabir 2191","","جفشيش بن النعمان الكندي عن صالح بن صالح بن حي الثوري عن علي بن صالح بن حي عن يحيى بن آدم عن حيان بن بشر الحنفي عن علي بن سعيد بن بشير عليك عن الطبراني","جفشيش الكندي"
"2190","222 -  جَبَلَةُ بْنُ حَارِثَةَ الْكَلْبِيُّ أَخُو زَيْدِ بْنِ حَارِثَةَ  2192  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَمُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ،  أَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  أَبِي عَمْرٍو الشَّيْبَانِيِّ ،  حَدَّثَنِي  جَبَلَةُ بْنُ حَارِثَةَ ، قَالَ :  قَدِمْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقُلْتُ : يَا رَسُولَ اللهِ أَرْسِلْ مَعِي أَخِي  زَيْدًا  ، قَالَ :  هُوَ ذَاكَ فَإِنِ انْطَلَقَ مَعَكَ لَمْ أَمْنَعْهُ  ، فَقَالَ : لَا وَاللهِ يَا رَسُولَ اللهِ لَا أَخْتَارُ عَلَيْكَ أَحَدًا أَبَدًا قَالَ : فَرَأَيْتُ رَأْيَ أَخِي أَفْضَلَ مِنْ رَأْيِي  .","","Al-Mu'jam al-Kabir 2192","","جبلة بن حارثة الكلبي عن سعد بن إياس الشيباني عن إسماعيل بن أبي خالد عن علي بن مسهر القرشي عن منجاب بن الحارث التميمي عن محمد بن عثمان بن أبي شيبة عن الطبراني","جبلة بن حارثة الكلبي"
"2191","2193  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ عَمْرِو بْنِ سُكَيْنٍ ،  ثَنَا  عَمْرُو بْنُ النَّضْرِ ،  أَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  أَبِي عَمْرٍو الشَّيْبَانِيِّ ،  عَنْ  جَبَلَةَ بْنِ حَارِثَةَ ، قَالَ :  أَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2193","","جبلة بن حارثة الكلبي عن سعد بن إياس الشيباني عن إسماعيل بن أبي خالد عن عمرو بن النضر البصري عن الوليد بن عمرو بن السكين الضبعي عن الساجي عن الطبراني","جبلة بن حارثة الكلبي"
"2192","2194  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  مُحَمَّدُ بْنُ سَعِيدِ بْنِ الْأَصْبَهَانِيِّ ، (  ح  ) ،  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الطُّفَيْلِ ، (  ح  ) ،         [2/287]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالُوا :  ثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  جَبَلَةَ بْنِ حَارِثَةَ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا لَمْ يَغْزُ أَعْطَى سِلَاحَهُ  عَلِيًّا  أَوْ  أُسَامَةَ  رَضِيَ اللهُ عَنْهُمَا  .","","Al-Mu'jam al-Kabir 2194","","جبلة بن حارثة الكلبي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن محمد بن سعيد حمدان عن بشر بن موسى بن صالح الأسدي عن الطبراني","جبلة بن حارثة الكلبي"
"2193","2195  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الطُّفَيْلِ ،  ثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  جَبَلَةَ بْنِ حَارِثَةَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا أَوَيْتَ إِلَى فِرَاشِكَ فَاقْرَأْ         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      حَتَّى تَمُرَّ بِآخِرِهَا ، فَإِنَّهَا بَرَاءَةٌ مِنَ  الشِّرْكِ  .","","Al-Mu'jam al-Kabir 2195","","جبلة بن حارثة الكلبي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن محمد بن الطفيل بن مالك النخعي عن أحمد بن عمرو بن حفص القريعي عن الطبراني","جبلة بن حارثة الكلبي"
"2194","223 -  جَبَلَةُ بْنُ الْأَزْرَقِ  2196  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  رَاشِدِ بْنِ سَعْدٍ ،  عَنْ  جَبَلَةَ بْنِ الْأَزْرَقِ وَكَانَ مِنْ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى إِلَى جَنْبِ جِدَارٍ كَثِيرِ الْأَحْجِرَةِ صَلَّى  ظَهْرًا أَوْ عَصْرًا  ، فَلَمَّا جَلَسَ فِي الرَّكْعَتَيْنِ خَرَجَتْ عَقْرَبٌ فَلَدَغَتْهُ فَغُشِيَ عَلَيْهِ فَرَقَاهُ النَّاسُ ، فَلَمَّا  أَفَاقَ  قَالَ : "" اللهُ شَفَانِي وَلَيْسَ بِرُقْيَتِكُمْ  .","","Al-Mu'jam al-Kabir 2196","","جبلة بن الأزرق الشامي عن راشد بن سعد المقرائي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","جبلة بن الأزرق"
"2195","-  جَبَلَةُ بْنُ عَمْرٍو أَخُو أَبِي مَسْعُودٍ  2197  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ،  قَالَ  : وَفِي حَدِيثِ  عُبَيْدِ اللهِ بْنِ أَبِي رَافِعٍ  : ""  فِي تَسْمِيَةِ مَنْ شَهِدَ مَعَ  عَلِيِّ بْنِ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُ  جَبَلَةُ         [2/288]      بْنُ عَمْرٍو  وَمِنْ  بَنِي بَيَاضَةَ ،  بَدْرِيٌّ  "" .","","Al-Mu'jam al-Kabir 2197","","","جبلة بن عمرو"
"2196","-  جَبَلَةُ بْنُ ثَعْلَبَةَ الْأَنْصَارِيُّ  مِنْ  بَنِي بَيَاضَةَ ،  بَدْرِيٌّ  2198  -  ثَنَا  الْحَضْرَمِيُّ  قَالَ  : وَفِي حَدِيثِ  عُبَيْدِ اللهِ بْنِ أَبِي رَافِعٍ  : ""  فِي تَسْمِيَتِهِ مَنْ شَهِدَ مَعَ  عَلِيِّ بْنِ أَبِي طَالِبٍ  جَبَلَةُ مِنْ بَنِي بَيَاضَةَ ،  بَدْرِيٌّ  ""  .","","Al-Mu'jam al-Kabir 2198","","","جبلة بن ثعلبة الأنصاري"
"2197","227 -  جَحْشٌ الْجُهَنِيُّ  2199  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَلِيُّ بْنُ عَبْدِ الْأَعْلَى الْمُحَارِبِيُّ ، وَهَنَّادُ بْنُ السَّرِيِّ ، قَالَا :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِيُّ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ جَحْشٍ ،  عَنْ  أَبِيهِ الْجُهَنِيِّ  ، قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ إِنَّ لِي بَادِيَةً أُصَلِّي فِيهَا فَمُرْنِي بِلَيْلَةٍ أَنْزِلُهَا إِلَى الْمَسْجِدِ فَأُصَلِّيَ فِيهِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  انْزِلْ لَيْلَةَ ثَلَاثٍ وَعِشْرِينَ  .","","Al-Mu'jam al-Kabir 2199","","جحش الجهني عن عبد الله بن جحش بن رباب الأسدي عن محمد بن إبراهيم بن الحارث التيمي عن محمد بن إسحاق عن عبد الرحمن بن محمد المحاربي عن هناد بن السري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","جحش الجهني"
"2198","228 -  جَهْرٌ أَبُو عَبْدِ اللهِ  2200  -  حَدَّثَنَا  أَبُو عُبَيْدَةَ عَبْدُ الْوَارِثِ بْنُ إِبْرَاهِيمَ الْعَسْكَرِيُّ ،  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى بْنِ خَلَّادٍ الْمِنْقَرِيُّ ،  ثَنَا  الْحَسَنُ بْنُ عُمَرَ السَّدُوسِيُّ ،  ثَنَا  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الْمَدَنِيُّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ جَهْرٍ ،  عَنْ  أَبِيهِ جَهْرٍ  قَالَ :  قَرَأْتُ خَلْفَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا انْصَرَفَ ، قَالَ :  يَا  جَهْرُ  أَسْمِعْ رَبَّكَ وَلَا         [2/289]      تُسْمِعْنِي  .","","Al-Mu'jam al-Kabir 2200","","جهر أبو عبد الله عن عبد الله بن جهر عن الزهري عن عثمان بن عبد الرحمن بن عمر الوقاصي عن الحسن بن عمرو السدوسي عن زكريا بن يحيى المنقري عن عبد الوارث بن إبراهيم العسكري عن الطبراني","جهر أبو عبد الله"
"2199","229 -  جُفَيْنَةُ  2201  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَمْرُو بْنُ عَوْنٍ ،  ثَنَا  أَبُو بَكْرٍ الدَّاهِرِيُّ ،  عَنْ  سُفْيَانَ  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عُرَيْنَةَ الْعُرَنِيِّ ،  عَنْ  جُفَيْنَةَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَتَبَ إِلَيْهِ كِتَابًا فَرَقَعَ بِهِ دَلْوَهُ ، فَقَالَتْ لَهُ ابْنَتُهُ : عَمَدْتَ إِلَى كِتَابِ سَيِّدِ الْعَرَبِ فَرَقَعْتَ بِهِ دَلْوَكَ ، فَهَرَبَ وَأَخَذَ كُلَّ قَلِيلٍ وَكَثِيرٍ هُوَ لَهُ ، ثُمَّ جَاءَ بَعْدُ مُسْلِمًا ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  انْظُرْ مَا وَجَدْتَ مِنْ مَتَاعِكَ قَبْلَ قِسْمَةِ السِّهَامِ فَخُذْهُ  .","","Al-Mu'jam al-Kabir 2201","","جفينة الجهني عن عرينة العرني عن أبو إسحاق السبيعي عن سفيان الثوري عن عبد الله بن حكيم الداهري عن عمرو بن عون الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","جفينة"
"2200","230 -  جَاهِمَةُ أَبُو مُعَاوِيَةَ السُّلَمِيُّ  2202  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ الْبَصْرِيُّ  ، حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْمُبَارَكِ الْعَيْشِيُّ ،  ثَنَا  سُفْيَانُ بْنُ حَبِيبٍ ،  ثَنَا  ابْنُ جُرَيْجٍ ،  عَنْ  مُحَمَّدِ بْنِ طَلْحَةَ بْنِ يَزِيدَ بْنِ رُكَانَةَ ،  عَنْ  مُعَاوِيَةَ بْنِ جَاهِمَةَ ،  عَنْ  أَبِيهِ  قَالَ :  أَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَسْتَشِيرُهُ فِي  الْجِهَادِ  ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلَكَ وَالِدَانِ ؟ "" قُلْتُ : نَعَمْ ، قَالَ : "" الْزَمْهُمَا فَإِنَّ الْجَنَّةَ تَحْتَ أَرْجُلِهِمَا  .","","Al-Mu'jam al-Kabir 2202","","جاهمة بن العباس السلمي عن معاوية بن جاهمة المحاربي عن محمد بن طلحة بن عبد الله القرشي عن ابن جريج عن سفيان بن حبيب البصري عن عبد الرحمن بن المبارك الخلقاني عن محمد بن محمد بن حيان التمار عن الطبراني","جاهمة أبو معاوية السلمي"
"2201","231 -  جِدَارٌ  2203  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  أَبُو مُوسَى الْهَرَوِيُّ ، (  ح  ) ،         [2/290]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ  ، ثَنَا  سَعْدُ بْنُ عَبْدِ الْحَمِيدِ بْنِ جَعْفَرٍ الْأَنْصَارِيُّ ، قَالَا :  ثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَنْصَارِيُّ ،  حَدَّثَنِي  الْقَاسِمُ بْنُ عَبْدِ الرَّحْمَنِ الْأَنْصَارِيُّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  يَزِيدَ بْنِ شَجَرَةَ ،  عَنْ  جِدَارٍ رَجُلٍ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  غَزَوْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَلَقِيَنَا عَدُوُّنَا ، فَقَامَ فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ثُمَّ قَالَ :  أَيُّهَا النَّاسُ إِنَّكُمْ قَدْ أَصْبَحْتُمْ بَيْنَ أَخْضَرَ وَأَصْفَرَ وَأَحْمَرَ وَفِي  الرِّحَالِ  مَا فِيهَا ، فَإِذَا لَقِيتُمْ عَدُوَّكُمْ  فَقُدُمًا  قُدُمًا  فَإِنَّهُ لَيْسَ أَحَدٌ يَحْمِلُ فِي  سَبِيلِ  اللهِ إِلَّا ابْتَدَرَتْ إِلَيْهِ ثِنْتَانِ مِنَ  الْحُورِ  الْعِينِ  ، فَإِذَا اسْتُشْهِدَ فَإِنَّ أَوَّلَ قَطْرَةٍ تَقَعُ مِنْ دَمِهِ يُكَفِّرُ اللهُ عَزَّ وَجَلَّ عَنْهُ كُلَّ ذَنْبٍ وَتَمْسَحَانِ الْغُبَارَ عَنْ وَجْهِهِ تَقُولَانِ قَدْ أَنَا لَكَ وَيَقُولُ قَدْ أَنَا لَكُمَا  .","","Al-Mu'jam al-Kabir 2203","","جدار العذري عن يزيد بن شجرة الرهاوي عن الزهري عن القاسم بن عبد الرحمن المسعودي عن عباس بن الفضل الواقفي عن سعد بن عبد الحميد الأنصاري عن لحية الليف محمد بن العباس عن الطبراني","جدار"
"2202","232 -  جُنَيْدُ بْنُ سَبْعٍ  "" وَيُقَالُ  حَبِيبُ بْنُ سِبَاعٍ وَهُوَ أَبُو جُمُعَةَ  قَدْ خَرَّجْتُ حَدِيثَهُ فِي بَابِ الْحَاءِ ""  2204  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي عَبَّادٍ الْمَكِّيُّ  ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ أَبُو سَعِيدٍ مَوْلَى بَنِي هَاشِمٍ ،  ثَنَا  حُجْرُ بْنُ خَلَفٍ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَوْفٍ ، يَقُولُ :  سَمِعْتُ  جُنَيْدَ بْنَ سَبْعٍ ، يَقُولُ :  قَاتَلْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَوَّلَ النَّهَارِ كَافِرًا ، وَقَاتَلْتُ مَعَهُ آخِرَ النَّهَارِ مُسْلِمًا  وَنَزَلَتْ فِينَا :         {      وَلَوْلا رِجَالٌ مُؤْمِنُونَ وَنِسَاءٌ مُؤْمِنَاتٌ         }      ، قَالَ : كُنَّا تِسْعَةَ نَفَرٍ سَبْعَةَ رِجَالٍ وَامْرَأَتَيْنِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : (محمد بن عباد المكي) وهو ما دلت عليه مصادر التخريج والتراجم.","","Al-Mu'jam al-Kabir 2204","","أبو جمعة الأنصاري عن عبد الله بن عوف الكناني عن حجر بن الحارث الغساني عن عبد الرحمن بن عبد الله بن عبيد جردقة عن عبد الرحمن بن أبى عباد عن روح بن الفرج القطان عن الطبراني","جنيد بن سبع"
"2203","233 -  جَرِيرُ بْنُ عَبْدِ اللهِ الْبَجَلِيُّ يُكَنَّى أَبَا عَبْدِ اللهِ وَيُقَالُ : أَبُو عَمْرٍو  2205  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  الْأَسْوَدُ بْنُ         [2/291]      شَيْبَانَ ،  ثَنَا  زِيَادُ بْنُ أَبِي سُفْيَانَ الْبَجَلِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ جَرِيرٍ ،  قَالَ  :  غَدَا أَبُو عَبْدِ اللهِ يَعْنِي جَرِيرًا إِلَى الْكُنَاسَةِ لِيَبْتَاعَ مِنْهَا دَابَّةً  ""  .","","Al-Mu'jam al-Kabir 2205","","جرير بن عبد الله بن جابر يوسف الأمة عن إبراهيم بن جرير البجلي عن زياد بن أبي سفيان البجلي عن الأسود بن شيبان السدوسي عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","جرير بن عبد الله البجلي"
"2204","2206  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ،  ثَنَا  أَبُو كُرَيْبٍ  ،  ثَنَا  أَبُو أُسَامَةَ  ،  حَدَّثَنَا  جَرِيرُ بْنُ أَيُّوبَ  ،  حَدَّثَنِي  شَيْخٌ مِنْ بَنِي سُلَيْمٍ  قَالَ : ""  قُلْتُ  لِجَرِيرٍ  : يَا  أَبَا عَمْرٍو  ""  .","","Al-Mu'jam al-Kabir 2206","","","جرير بن عبد الله البجلي"
"2205","2207  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، حَدَّثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  زَائِدَةُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ  قَالَ  :  رَأَيْتُ جَرِيرًا يُصَفِّرُ لِحْيَتَهُ  ""  .","","Al-Mu'jam al-Kabir 2207","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الملك بن عمير القبطي عن زائدة بن قدامة عن أحمد بن عبد الله اليربوعي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","جرير بن عبد الله البجلي"
"2206","2208  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  هَنَّادُ بْنُ السَّرِيِّ ،  ثَنَا  الْمُحَارِبِيُّ قَالَ :  سَمِعْتُ  عَبْدَ الْمَلِكِ بْنَ عُمَيْرٍ قَالَ :  رَأَيْتُ  جَرِيرًا يَخْضِبُ بِالصُّفْرَةِ وَالزَّعْفَرَانِ  "" .","","Al-Mu'jam al-Kabir 2208","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الملك بن عمير القبطي عن عبد الرحمن بن محمد المحاربي عن هناد بن السري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","جرير بن عبد الله البجلي"
"2207","2209  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مَنْصُورٍ الْكَلْبِيُّ ، قَالَ :  حَدَّثَنِي  سُلَيْمٌ أَبُو الْهُذَيْلِ قَالَ :  رَأَيْتُ  جَرِيرَ بْنَ عَبْدِ اللهِ يَخْضِبُ رَأْسَهُ وَلِحْيَتَهُ بِالسَّوَادِ  "" .","","Al-Mu'jam al-Kabir 2209","","جرير بن عبد الله بن جابر يوسف الأمة عن سليم أبو الهذيل عن محمد بن منصور الكلبي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","جرير بن عبد الله البجلي"
"2208","مِنْ أَخْبَارِهِ  2210  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  عَنْ  سُفْيَانَ ،  عَنْ  مُحَمَّدِ بْنِ السَّائِبِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  طَلَعَ  جَرِيرُ بْنُ عَبْدِ اللهِ  فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَطْلُعُ عَلَيْكُمْ خَيْرُ  ذِي  يَمَنٍ عَلَيْهِ  مَسْحَةُ  مَلَكٍ  "" فَطَلَعَ  جَرِيرُ بْنُ عَبْدِ اللهِ  .","","Al-Mu'jam al-Kabir 2210","","عبد الله بن عباس عن باذام عن محمد بن السائب الكلبي عن سفيان الثوري عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","من أخباره"
"2209","2211  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  سُلَيْمَانُ بْنُ إِبْرَاهِيمَ بْنِ جَرِيرٍ ،  عَنْ  أَبَانَ بْنِ عَبْدِ اللهِ الْبَجَلِيِّ ،  عَنْ  أَبِي بَكْرِ بْنِ حَفْصٍ قَالَ :  قَالَ  عَلِيُّ بْنُ أَبِي طَالِبٍ رَضِيَ اللهُ عَنْهُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  جَرِيرٌ         [2/292]      مِنَّا أَهْلَ الْبَيْتِ ظَهْرًا لِبَطْنٍ "" قَالَهَا ثَلَاثًا  .","","Al-Mu'jam al-Kabir 2211","","علي بن أبي طالب عن عبد الله بن حفص بن عمر بن سعد بن أبي وقاص عن أبان بن عبد الله بن أبي حازم عن سليمان بن إبراهيم بن جرير بن عبد الله البجلي عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","من أخباره"
"2210","2212  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  جَعْفَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ الْمَعْرُوفُ بِابْنِ التَّلِّ ،  ثَنَا  أَحْمَدُ بْنُ بِشْرٍ  ،  عَنِ  ابْنِ شُبْرُمَةَ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّ  جَرِيرًا رَضِيَ اللهُ عَنْهُ بَارَزَ  مِهْرَانَ  فَقَتَلَهُ فَقُوِّمَتْ مِنْطَقَتُهُ ثَلَاثِينَ أَلْفًا  ، وَكَانَ مَنْ بَارَزَ رَجُلًا فَقَتَلَهُ فَلَهُ  سَلَبُهُ  ، فَكَتَبُوا إِلَى  عُمَرَ  رَضِيَ اللهُ عَنْهُ فَقَالَ عُمَرُ :  لَيْسَ هَذَا مِنَ السَّلَبِ الَّذِي يُعْطَى لَيْسَ مِنَ السِّلَاحِ  ، وَلَا مِنَ  الْكُرَاعِ  ، وَلَمْ يُنَفِّلْهُ وَجَعَلَهُ مَغْنَمًا ""  .  كذا في طبعة مكتبة ابن تيمية ، والصواب ( بشير ) .","","Al-Mu'jam al-Kabir 2212","","عمر بن الخطاب عن الشعبي عن عبد الله بن شبرمة عن أحمد بن بشير المخزومى عن جعفر بن محمد بن الحسن الأسدي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","من أخباره"
"2211","2213  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى ،  عَنْ  مُجَالِدٍ ،  ثَنَا  عَامِرٌ ،  عَنْ  جَرِيرٍ :  أَنَّ  عُمَرَ رَضِيَ اللهُ عَنْهُ صَلَّى بِالنَّاسِ فَخَرَجَ مِنْ إِنْسَانٍ شَيْءٌ فَقَالَ : عَزَمْتُ عَلَى صَاحِبِ هَذِهِ إِلَّا تَوَضَّأَ وَأَعَادَ صَلَاتَهُ  ،  فَقَالَ  جَرِيرٌ  :  أَوَتَعْزِمُ  عَلَى كُلِّ مَنْ سَمِعَهَا أَنْ يَتَوَضَّأَ وَأَنْ يُعِيدَ الصَّلَاةَ  ، قَالَ : نِعِمَّا ، قُلْتُ : جَزَاكَ اللهُ خَيْرًا ، فَأَمَرَهُمْ بِذَلِكَ  ""  .","","Al-Mu'jam al-Kabir 2213","","عمر بن الخطاب عن جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن مجالد بن سعيد عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","من أخباره"
"2212","2214  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مَنْصُورٍ الْكَلْبِيُّ ،  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  ثَنَا  سُلَيْمٌ أَبُو الْهُذَيْلِ ،  قَالَ  :  كُنْتُ رَفًّا عَلَى بَابِ جَرِيرِ بْنِ عَبْدِ اللهِ وَكَانَ يَخْرُجُ فَيَرْكَبُ بَغْلَةً لَهُ وَيَحْمِلُ غُلَامَهُ خَلْفَهُ  ""  .","","Al-Mu'jam al-Kabir 2214","","جرير بن عبد الله بن جابر يوسف الأمة عن سليم أبو الهذيل عن يونس بن بكير عن محمد بن منصور الكلبي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","من أخباره"
"2213","2215  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  عَنْ  عَبَّادِ بْنِ الْعَوَّامِ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرٍ قَالَ :  إِنَّ الرَّجُلَ لَيَكْتَسِي وَهُوَ عَارٍ  يَعْنِي الثِّيَابَ الرِّقَاقَ  ""  .","","Al-Mu'jam al-Kabir 2215","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن عباد بن العوام الكلابي عن سعيد بن سليمان سعدويه عن أحمد بن يحيى بن إسحاق الحلواني عن الطبراني","من أخباره"
"2214","2216  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَلِيُّ بْنُ حَكِيمٍ الْأَوْدِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ         [2/293]      قَالَ  :  اجْتَمَعَ جَرِيرٌ ، وَالْأَشْعَثُ بْنُ قَيْسٍ فِي جِنَازَةٍ فَقَدَّمَ الْأَشْعَثُ جَرِيرًا فَصَلَّى عَلَيْهَا  ""  .","","Al-Mu'jam al-Kabir 2216","","الأشعث بن قيس الكندي عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن علي بن حكيم بن ذبيان عن محمد بن عبد الله مطين الحضرمي عن الطبراني","من أخباره"
"2215","2217  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مُغِيرٍ  قَالَ  :  خَرَجَ مِنَ  الْكُوفَةِ  جَرِيرٌ ، وَعَدِيُّ بْنُ حَاتِمٍ ، وَحَنْظَلَةُ الْكَاتِبُ إِلَى  قَرْقِيسِيَا  ، وَقَالُوا :  لَا نُقِيمُ فِي بَلْدَةٍ يُشْتَمُ فِيهَا  عُثْمَانُ  رَضِيَ اللهُ عَنْهُ  "" .","","Al-Mu'jam al-Kabir 2217","","حنظلة بن الربيع الكاتب عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","من أخباره"
"2216","أَنَسُ بْنُ مَالِكٍ  عَنْ  جَرِيرٍ  2218  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَرْعَرَةَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ  قَالَ  :  صَحِبْتُ جَرِيرًا فَكَانَ يَخْدُمُنِي "" وَكَانَ أَكْبَرَ مِنْ  أَنَسٍ  ، وَقَالَ  جَرِيرٌ  : "" إِنِّي رَأَيْتُ  الْأَنْصَارَ  يَصْنَعُونَ بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ شَيْئًا لَا أَرَى أَحَدًا مِنْهُمْ إِلَّا أَكْرَمْتُهُ  .","","Al-Mu'jam al-Kabir 2218","","جرير بن عبد الله بن جابر يوسف الأمة عن أنس بن مالك عن ثابت البناني عن يونس بن عبيد عن شعبة بن الحجاج عن محمد بن عرعرة عن أبو مسلم الكجي عن الطبراني","أنس بن مالك عن جرير"
"2217","قَيْسُ بْنُ أَبِي حَازِمٍ  عَنْ  جَرِيرٍ  بَابٌ فِي فَضْلِ  جَرِيرٍ  2219  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرٍ رَضِيَ اللهُ عَنْهُ قَالَ :  مَا حَجَبَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُنْذُ أَسْلَمْتُ وَلَا رَآنِي إِلَّا تَبَسَّمَ  .","","Al-Mu'jam al-Kabir 2219","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","باب في فضل جرير"
"2218","2220  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ، قَالَ :  سَمِعْتُ  جَرِيرَ بْنَ عَبْدِ اللهِ يَقُولُ :  مَا رَآنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَطُّ إِلَّا تَبَسَّمَ فِي وَجْهِي  .","","Al-Mu'jam al-Kabir 2220","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","باب في فضل جرير"
"2219","2221  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ (  ح  ) ،         [2/294]      وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  وَكِيعٌ ، وَأَبُو أُسَامَةَ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  مَا حَجَبَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُنْذُ أَسْلَمْتُ وَلَا رَآنِي قَطُّ إِلَّا تَبَسَّمَ فِي وَجْهِي  .","","Al-Mu'jam al-Kabir 2221","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","باب في فضل جرير"
"2220","2222  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  أَبُو حَاتِمٍ السِّجِسْتَانِيُّ النَّحْوِيُّ ،  ثَنَا  أَبُو جَابِرٍ مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ ،  ثَنَا  شُعْبَةُ ،  عَنْ  هُشَيْمٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ الْبَجَلِيِّ قَالَ :  مَا حَجَبَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُنْذُ أَسْلَمْتُ وَلَا رَآنِي إِلَّا تَبَسَّمَ  .","","Al-Mu'jam al-Kabir 2222","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن هشيم بن بشير عن شعبة بن الحجاج عن أبو جابر محمد بن عبد الملك الأزدي عن سهل بن محمد السجستاني عن البزار عن الطبراني","باب في فضل جرير"
"2221","2223  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ  ، ثَنَا  أَبُو مَسْعُودٍ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ الْبَجَلِيِّ ، قَالَ :  مَا حَجَبَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُنْذُ أَسْلَمْتُ وَلَا رَآنِي إِلَّا تَبَسَّمَ  .","","Al-Mu'jam al-Kabir 2223","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن محمد بن عبيد بن أبي أمية عن أحمد بن الفرات الضبي عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","باب في فضل جرير"
"2222","بَابُ بَيَانِ كُفْرِ الْجَهْمِيَّةِ الضُّلَّالِ بِرُؤْيَةِ الرَّبِّ عَزَّ وَجَلَّ فِي الْقِيَامَةِ  2224  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبِي  ، قَالَا :  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  ثَنَا  قَيْسٌ ، قَالَ :  قَالَ لِي  جَرِيرٌ :  كُنَّا جُلُوسًا عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَيْلَةَ الْبَدْرِ ، فَقَالَ : "" إِنَّكُمْ سَتَرَوْنَ رَبَّكُمْ كَمَا تَرَوْنَ هَذَا الْقَمَرَ لَا  تُضَامُونَ  فِي رُؤْيَتِهِ  ، فَإِنِ اسْتَطَعْتُمْ أَنْ لَا تُغْلَبُوا عَلَى صَلَاتَيْنِ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ غُرُوبِهَا "" ثُمَّ تَلَا هَذِهِ الْآيَةَ :         {      وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ غُرُوبِهَا         }      .","","Al-Mu'jam al-Kabir 2224","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى القطان عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","باب بيان كفر الجهمية الضلال برؤية الرب عز وجل في القيامة"
"2223","2225  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ قَالَ :  سَمِعْتُ  قَيْسَ بْنَ أَبِي حَازِمٍ  يُحَدِّثُ عَنْ  جَرِيرٍ قَالَ :  كُنَّا عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَيْلَةَ الْبَدْرِ ، فَقَالَ : "" إِنَّكُمْ         [2/295]      سَتَرَوْنَ رَبَّكُمْ كَمَا تَرَوْنَ الْقَمَرَ لَا  تُضَامُونَ  فِي رُؤْيَتِهِ  ، فَإِنِ اسْتَطَعْتُمْ أَنْ لَا تُغْلَبُوا عَلَى صَلَاتَيْنِ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ غُرُوبِهَا "" ثُمَّ تَلَا هَذِهِ الْآيَةَ :         {      وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ غُرُوبِهَا         }      .","","Al-Mu'jam al-Kabir 2225","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","باب بيان كفر الجهمية الضلال برؤية الرب عز وجل في القيامة"
"2224","2226  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  ابْنُ نُمَيْرٍ ، وَأَبُو أُسَامَةَ ، وَوَكِيعٌ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  كُنَّا جُلُوسًا عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَنْظُرُ إِلَى الْقَمَرِ لَيْلَةَ الْبَدْرِ فَقَالَ :  أَمَا إِنَّكُمْ سَتُعْرَضُونَ عَلَى رَبِّكُمْ فَتَرَوْنَهُ كَمَا تَرَوْنَ هَذَا الْقَمَرَ لَا  تُضَامُونَ  فِي رُؤْيَتِهِ  ، فَإِنِ اسْتَطَعْتُمْ أَنْ لَا تُغْلَبُوا عَلَى صَلَاةٍ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ غُرُوبِهَا "" ثُمَّ قَرَأَ :         {      وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ الْغُرُوبِ         }      .","","Al-Mu'jam al-Kabir 2226","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","باب بيان كفر الجهمية الضلال برؤية الرب عز وجل في القيامة"
"2225","2227  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  حَمَّادُ بْنُ أُسَامَةَ ، وَيَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ، وَوَكِيعٌ ، قَالُوا :  ثَنَا  إِسْمَاعِيلُ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  كُنَّا جُلُوسًا مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَنَظَرَ إِلَى الْقَمَرِ لَيْلَةَ أَرْبَعَ عَشْرَةَ ، فَقَالَ :  إِنَّكُمْ سَتَرَوْنَ رَبَّكُمْ كَمَا تَرَوْنَ هَذَا لَا  تُضَامُونَ  فِي رُؤْيَتِهِ  ، فَإِنِ اسْتَطَعْتُمْ أَنْ لَا تُغْلَبُوا عَنْ صَلَاةٍ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ غُرُوبِهَا فَافْعَلُوا "" ثُمَّ قَرَأَ هَذِهِ الْآيَةَ :         {      وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ غُرُوبِهَا         }      .","","Al-Mu'jam al-Kabir 2227","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن وكيع بن الجراح عن عثمان ابن أبي شيبة عن عبد الله بن أحمد بن حنبل عن الطبراني","باب بيان كفر الجهمية الضلال برؤية الرب عز وجل في القيامة"
"2226","2228  -  حَدَّثَنَا  الْحَسَنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 2228","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","باب بيان كفر الجهمية الضلال برؤية الرب عز وجل في القيامة"
"2227","2229  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَطَاءٍ الْخُزَاعِيُّ ،  عَنْ  سُفْيَانَ الثَّوْرِيِّ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تَرَوْنَ رَبَّكُمْ كَمَا تَرَوْنَ الْقَمَرَ لَا  تُضَامُونَ  فِي رُؤْيَتِهِ  .","","Al-Mu'jam al-Kabir 2229","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن سفيان الثوري عن معاوية بن عطاء الخزاعي عن أحمد بن داود بن موسى السدوسي عن الطبراني","باب بيان كفر الجهمية الضلال برؤية الرب عز وجل في القيامة"
"2228","2230  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ سُلَيْمَانَ لُوَيْنٌ ،  ثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [2/296]      نَحْوَهُ .","","Al-Mu'jam al-Kabir 2230","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن عيسى بن يونس بن أبي إسحاق عن محمد بن سليمان لوين عن عبد الله بن أحمد بن حنبل عن الطبراني","باب بيان كفر الجهمية الضلال برؤية الرب عز وجل في القيامة"
"2229","2231  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  عَبْدُ الْوَهَّابِ بْنُ عَبْدِ الْحَكَمِ الْوَرَّاقُ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ الْأُمَوِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 2231","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى بن سعيد بن أبان عن عبد الوهاب بن عبد الحكم الوراق عن عبد الله بن أحمد بن حنبل عن الطبراني","باب بيان كفر الجهمية الضلال برؤية الرب عز وجل في القيامة"
"2230","2232  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ، وَعَبْدَةُ بْنُ سُلَيْمَانَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّكُمْ سَتَرَوْنَ رَبَّكُمْ لَا  تُضَامُونَ  فِي رُؤْيَتِهِ كَمَا تَنْظُرُونَ لَيْلَةَ الْبَدْرِ  .","","Al-Mu'jam al-Kabir 2232","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن عبدة بن سليمان الكلابي عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","باب بيان كفر الجهمية الضلال برؤية الرب عز وجل في القيامة"
"2231","2233  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  خَلَفُ بْنُ هِشَامٍ الْبَزَّارُ ،  ثَنَا  أَبُو شِهَابٍ الْخَيَّاطُ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  كُنَّا مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ فَنَظَرَ إِلَى الْقَمَرِ لَيْلَةَ الْبَدْرِ ، فَقَالَ :  إِنَّكُمْ سَتَرَوْنَ رَبَّكُمْ يَوْمَ الْقِيَامَةِ عِيَانًا كَمَا تَرَوْنَ هَذَا لَا  تُضَامُونَ  فِي رُؤْيَتِهِ  ، فَإِنِ اسْتَطَعْتُمْ أَنْ لَا تُغْلَبُوا عَنْ صَلَاةٍ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ الْغُرُوبِ فَافْعَلُوا "" ثُمَّ قَرَأَ :         {      وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ الْغُرُوبِ         }      قَالَ أَبُو الْقَاسِمِ :  فِي هَذَا الْحَدِيثِ زِيَادَةُ لَفْظَةِ قَوْلِهِ عِيَانًا  تَفَرَّدَ بِهِ  أَبُو شِهَابٍ  وَهُوَ  حَافِظٌ مُتْقِنٌ  مِنْ  ثِقَاتِ  الْمُسْلِمِينَ  .","","Al-Mu'jam al-Kabir 2233","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن عبد ربه بن نافع الحناط عن خلف بن هشام البزار عن موسى بن هارون الحمال عن الطبراني","باب بيان كفر الجهمية الضلال برؤية الرب عز وجل في القيامة"
"2232","2234  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  الْحُمَيْدِيُّ ، (  ح  )  وَثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ ، وَمَرْوَانُ بْنُ مُعَاوِيَةَ الْفَزَارِيُّ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  كُنَّا عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَيْلَةَ أَرْبَعَ عَشْرَةَ مِنْ شَهْرٍ ، فَقَالَ :  أَتَرَوْنَ هَذَا الْقَمَرَ ؟ فَإِنَّكُمْ سَتَرَوْنَ رَبَّكُمْ كَمَا تَرَوْنَ هَذَا الْقَمَرَ لَا  تُضَامُونَ  فِي رُؤْيَتِهِ ،  فَمَنِ اسْتَطَاعَ مِنْكُمْ فَلَا يُغْلَبَنَّ عَلَى صَلَاةٍ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ غُرُوبِهَا  .","","Al-Mu'jam al-Kabir 2234","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","باب بيان كفر الجهمية الضلال برؤية الرب عز وجل في القيامة"
"2233","2235  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ الْأَصْبَهَانِيُّ ،  ثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَلَوَّرِيُّ ،  ثَنَا  يَحْيَى بْنُ كَثِيرٍ أَبُو غَسَّانَ ،  ثَنَا  شُعْبَةُ ، وَعَبْدُ اللهِ بْنُ عُثْمَانَ ، قَالَا :         [2/297]      ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ بْنِ عَبْدِ اللهِ ، قَالَ :  كُنَّا عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَاتَ لَيْلَةٍ فَشَخَصَتْ أَبْصَارُنَا فَجَعَلْنَا نَنْظُرُ إِلَى الْقَمَرِ لَيْلَةَ الْبَدْرِ ، فَقَالَ :  أَمَا إِنَّكُمْ تَنْظُرُونَ إِلَى رَبِّكُمْ كَمَا تَنْظُرُونَ إِلَى هَذَا لَا  تُضَامُونَ  فِي رُؤْيَتِهِ  ، فَإِنِ اسْتَطَعْتُمْ أَنْ لَا تُغْلَبُوا عَلَى صَلَاتَيْنِ فَافْعَلُوا ، صَلَاةٍ قَبْلَ طُلُوعِ الشَّمْسِ وَصَلَاةٍ قَبْلَ غُرُوبِهَا  .","","Al-Mu'jam al-Kabir 2235","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن عبد الله بن عثمان عن يحيى بن كثير العنبري عن محمد بن عمرو بن العباس القلوري عن محمد بن العباس ابن الأخرم عن الطبراني","باب بيان كفر الجهمية الضلال برؤية الرب عز وجل في القيامة"
"2234","2236  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ، قَالَ :  سَمِعْتُ  إِسْمَاعِيلَ بْنَ أَبِي خَالِدٍ  يُحَدِّثُ ، عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ ، قَالَ :  كُنَّا عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَنَظَرَ إِلَى الْقَمَرِ لَيْلَةَ الْبَدْرِ ، فَقَالَ لَنَا :  إِنَّكُمْ سَتَرَوْنَ رَبَّكُمْ  كَمَا  تَرَوْنَ هَذَا لَا  تُضَامُونَ  فِي رُؤْيَتِهِ  .","","Al-Mu'jam al-Kabir 2236","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن معتمر بن سليمان عن عبد الأعلى بن حماد النرسي عن زكريا بن يحيى السجزي عن الطبراني","باب بيان كفر الجهمية الضلال برؤية الرب عز وجل في القيامة"
"2235","2237  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَلِيٍّ الْجَارُودِيُّ الْأَصْبَهَانِيُّ ،  ثَنَا  أَسِيدُ بْنُ عَاصِمٍ ،  ثَنَا  عَامِرُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  يَعْقُوبُ الْقُمِّيُّ ،  عَنْ  عَنْبَسَةَ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَطَلَعَ الْقَمَرُ فَقَالَ :  لَتَنْظُرُونَ إِلَى رَبِّكُمْ لَا  تُضَامُونَ  فِي رُؤْيَتِهِ كَمَا تَنْظُرُونَ إِلَى الْقَمَرِ  .","","Al-Mu'jam al-Kabir 2237","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن عنبسة بن سعيد بن الضريس عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن عامر بن إبراهيم الأصبهاني عن أسيد بن عاصم الأصبهاني عن الجارودي أحمد بن علي الأصبهاني عن الطبراني","باب بيان كفر الجهمية الضلال برؤية الرب عز وجل في القيامة"
"2236","بَابٌ  2238  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَا يَرْحَمِ النَّاسَ لَا يَرْحَمْهُ اللهُ  .","","Al-Mu'jam al-Kabir 2238","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","باب"
"2237","2239  -  حَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ ،  ثَنَا  سُفْيَانُ ، وَمَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَا يَرْحَمِ النَّاسَ لَا يَرْحَمْهُ اللهُ  .","","Al-Mu'jam al-Kabir 2239","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","باب"
"2238","2240  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،         [2/298]      ثَنَا  وَكِيعٌ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَرْحَمُ اللهُ مَنْ لَا يَرْحَمُ النَّاسَ  .","","Al-Mu'jam al-Kabir 2240","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن وكيع بن الجراح عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","باب"
"2239","2241  -  حَدَّثَنَا  أَحْمَدُ بْنُ شُعَيْبٍ النَّسَائِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ رَافِعٍ النَّيْسَابُورِيُّ ،  ثَنَا  مُصْعَبُ بْنُ الْمِقْدَامِ ،  عَنْ  دَاوُدَ الطَّائِيِّ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَا يَرْحَمِ النَّاسَ لَا يَرْحَمْهُ اللهُ  .","","Al-Mu'jam al-Kabir 2241","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن داود بن نصير الطائي عن مصعب بن المقدام الخثعمي عن محمد بن رافع القشيري عن النسائي عن الطبراني","باب"
"2240","2242  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى بْنُ مُطِيعٍ الشَّيْبَانِيُّ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ الْمَلِكِ بْنِ أَبِي غَنِيَّةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ لَا يَرْحَمِ النَّاسَ لَا يَرْحَمْهُ اللهُ  .","","Al-Mu'jam al-Kabir 2242","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى بن عبد الملك بن حميد عن يحيى بن محمد بن مطيع عن الحسين بن إسحاق التستري عن الطبراني","باب"
"2241","2243  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ الْأَصْبَهَانِيُّ ،  ثَنَا  أَبُو مَسْعُودٍ أَحْمَدُ بْنُ الْفُرَاتِ ،  ثَنَا  أَبُو أُسَامَةَ ، وَيَعْلَى بْنُ عُبَيْدٍ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ لَا يَرْحَمِ النَّاسَ لَا يَرْحَمْهُ اللهُ  .","","Al-Mu'jam al-Kabir 2243","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يعلى بن عبيد الطنافسي عن أحمد بن الفرات الضبي عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","باب"
"2242","بَابٌ  2244  -  حَدَّثَنَا  أَبُو خَلِيفَةَ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  سَمِعَ  قَيْسَ بْنَ أَبِي حَازِمٍ ، قَالَ :  سَمِعْتُ  جَرِيرًا ، يَقُولُ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى إِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَالنُّصْحِ لِكُلِّ مُسْلِمٍ  .","","Al-Mu'jam al-Kabir 2244","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","باب"
"2243","2245  -  ثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ، وَعَبْدَةُ بْنُ سُلَيْمَانَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى إِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَالنُّصْحِ لِكُلِّ مُسْلِمٍ  .","","Al-Mu'jam al-Kabir 2245","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","باب"
"2244","2246  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ         [2/299]      قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى إِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَالنُّصْحِ لِكُلِّ مُسْلِمٍ  .","","Al-Mu'jam al-Kabir 2246","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","باب"
"2245","2247  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  يَزِيدُ بْنُ عَطَاءٍ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى إِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَالنُّصْحِ لِكُلِّ مُسْلِمٍ  .","","Al-Mu'jam al-Kabir 2247","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يزيد بن عطاء بن يزيد اليشكري عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","باب"
"2246","2248  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  ثَنَا  ابْنُ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى إِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَالنُّصْحِ لِكُلِّ مُسْلِمٍ  .","","Al-Mu'jam al-Kabir 2248","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى بن زكريا بن أبي زائدة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","باب"
"2247","2249  -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ صَدَقَةَ ،  ثَنَا  مُحَمَّدُ بْنُ خَالِدِ بْنِ خَلِيٍّ الْحِمْصِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  سَلَمَةُ الْعَوْصِيُّ ،  ثَنَا  أَبُو الْحَسَنِ الْهَمْدَانِيُّ وَهُوَ عَلِيُّ بْنُ صَالِحٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ ، قَالَ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى إِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَالنُّصْحِ لِكُلِّ مُسْلِمٍ  .","","Al-Mu'jam al-Kabir 2249","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن علي بن صالح بن حي عن سلمة بن عبد الملك العوصي عن خالد بن خلي الكلاعي عن محمد بن خالد بن خلي الكلاعي عن أحمد بن محمد بن عبد الله البغدادي عن الطبراني","باب"
"2248","2250  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، حَدَّثَنَا  جُمْهُورُ بْنُ مَنْصُورٍ ،  حَدَّثَنِي  إِسْمَاعِيلُ بْنُ مُجَالِدٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  بَايَعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى السَّمْعِ وَالطَّاعَةِ  .","","Al-Mu'jam al-Kabir 2250","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن إسماعيل بن مجالد بن سعيد الهمداني عن جمهور بن منصور عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"2249","2251  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ الْأَصْبَهَانِيُّ ،  ثَنَا  أَبُو مَسْعُودٍ أَحْمَدُ بْنُ الْفُرَاتِ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ، وَيَعْلَى بْنُ عُبَيْدٍ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2251","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يعلى بن عبيد الطنافسي عن أحمد بن الفرات الضبي عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","باب"
"2250","بَابٌ  2252  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلَا تُرِيحُنِي مِنْ ذِي         [2/300]      الْخَلَصَةِ  ، وَكَانَ بَيْتًا فِي  خَثْعَمَ  يُسَمَّى كَعْبَةَ الْيَمَانِيَةِ ، فَانْطَلَقْتُ فِي سِتِّينَ وَمِائَةِ فَارِسٍ مِنْ  أَحْمَسَ  وَكَانُوا أَصْحَابَ خَيْلٍ ، وَكُنْتُ لَا أَثْبُتُ عَلَى الْخَيْلِ ، فَضَرَبَ صَدْرِي حَتَّى رَأَيْتُ أَثَرَ أَصَابِعِهِ فِي صَدْرِي ، وَقَالَ : "" اللَّهُمَّ ثَبِّتْهُ وَاجْعَلْهُ هَادِيًا مَهْدِيًّا "" ، فَانْطَلَقَ إِلَيْهَا فَكَسَرَهَا وَحَرَّقَهَا ، وَبَعَثَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُخْبِرُهُ ، فَقَالَ رَسُولُ  جَرِيرٍ  : وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا جِئْتُكَ حَتَّى تَرَكْتُهَا كَأَنَّهَا جَمَلٌ أَجْرَبُ ، فَبَارَكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى خَيْلِ  أَحْمَسَ  وَرِجَالِهَا خَمْسَ مَرَّاتٍ  .","","Al-Mu'jam al-Kabir 2252","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","باب"
"2251","2253  -  حَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ ، وَمَرْوَانُ بْنُ مُعَاوِيَةَ ، قَالَا :  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  سَمِعَ  قَيْسَ بْنَ أَبِي حَازِمٍ ،  سَمِعَ  جَرِيرًا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلَا تَكْفِينِي  ذَا الْخَلَصَةِ  فَقُلْتُ : يَا رَسُولَ اللهِ إِنِّي رَجُلٌ لَا أَثْبُتُ عَلَى الْخَيْلِ ، فَصَكَّ فِي صَدْرِي ، وَقَالَ : "" اللَّهُمَّ اجْعَلْهُ هَادِيًا مَهْدِيًّا "" ، قَالَ : فَخَرَجْتُ إِلَيْهَا فِي خَمْسِينَ مِنْ قَوْمِي فَحَرَّقْتُهَا بِالنَّارِ ، فَرَجَعْتُ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقُلْتُ : يَا رَسُولَ اللهِ مَا أَتَيْتُكَ حَتَّى تَرَكْتُهَا مِثْلَ الْجَمَلِ  الْأَجْرَدِ  ، فَدَعَا  لِأَحْمَسَ  خَيْلِهَا وَرِجَالِهَا ثَلَاثًا  .","","Al-Mu'jam al-Kabir 2253","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","باب"
"2252","2254  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  كُنْتُ لَا أَثْبُتُ عَلَى الْخَيْلِ ، فَذَكَرْتُ ذَلِكَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَضَرَبَ يَدَهُ عَلَى صَدْرِي حَتَّى رَأَيْتُ أَثَرَ يَدِهِ فِي صَدْرِي  ، فَقَالَ : "" اللَّهُمَّ ثَبِّتْهُ وَاجْعَلْهُ هَادِيًا مَهْدِيًّا "" ، فَمَا سَقَطْتُ عَنْ فَرَسٍ بَعْدُ  .","","Al-Mu'jam al-Kabir 2254","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"2253","2255  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ، وَوَكِيعٌ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  جَرِيرُ  أَلَا تُرِيحُنِي مِنْ  ذِي الْخَلَصَةِ  ؟  بَيْتٍ  لِخَثْعَمَ  يُدْعَى كَعْبَةَ الْيَمَانِيَةِ ، فَنَفَرْتُ فِي خَمْسِينَ وَمِائَةِ فَارِسٍ مِنْ  أَحْمَسَ  ، وَكُنْتُ لَا أَثْبُتُ عَلَى الْخَيْلِ فَذَكَرْتُ ذَلِكَ لَهُ ، فَضَرَبَ فِي صَدْرِي حَتَّى رَأَيْتُ أَثَرَ أَصَابِعِهِ فِي صَدْرِي ثُمَّ قَالَ : "" اللَّهُمَّ ثَبِّتْهُ وَاجْعَلْهُ هَادِيًا مَهْدِيًّا "" ، فَانْطَلَقْتُ فَظَهَرْتُ عَلَيْهِمْ وَحَرَّقْتُهَا         [2/301]      بِالنَّارِ ، فَبَعَثَ  جَرِيرٌ  رَجُلًا يُكْنَى  أَبَا أَرْطَاةَ  بَشِيرًا إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا جِئْتُكَ حَتَّى رَأَيْتُهَا كَأَنَّهَا جَمَلٌ أَجْرَبُ ، فَبَرَّكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى خَيْلِ  أَحْمَسَ  وَرِجَالِ  أَحْمَسَ  ثَلَاثَ مَرَّاتٍ  .","","Al-Mu'jam al-Kabir 2255","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن وكيع بن الجراح عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","باب"
"2254","2256  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ ،  ثَنَا  أَبُو مَسْعُودٍ أَحْمَدُ بْنُ الْفُرَاتِ ،  ثَنَا  يَعْلَى بْنُ عُبَيْدٍ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2256","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يعلى بن عبيد الطنافسي عن أحمد بن الفرات الضبي عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","باب"
"2255","2257  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  الْحَسَنُ بْنُ بِشْرٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَمْ يَبْقَ مِنْ طَوَاغِيتِ الْجَاهِلِيَّةِ إِلَّا ذُو  الْخَلَصَةِ  .","","Al-Mu'jam al-Kabir 2257","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن بشر بن سلم بن المسيب الهمداني عن الحسن بن بشر الكاهلي عن محمد بن عبد الله بن نمير عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"2256","بَابٌ  2258  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يَدْخُلُ عَلَيْكُمْ مِنَ الْبَابِ رَجُلٌ مِنْ خَيْرِ  ذِي  يَمَنٍ عَلَى وَجْهِهِ  مَسْحَةُ  مَلَكٍ  ، فَدَخَلَ  جَرِيرٌ  .","","Al-Mu'jam al-Kabir 2258","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","باب"
"2257","بَابٌ  2259  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  كُنْتُ  بِالْيَمَنِ  ، وَمَعِي  ذُو كَلَاعٍ  وَذُو عَمْرٍو  ، فَأَقْبَلْتُ أُخْبِرُهُمْ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، فَقَالَ  ذُو عَمْرٍو  : يَا  جَرِيرُ  إِنْ يَكُ صَاحِبُكَ كَمَا تَذْكُرُ ، لَقَدْ أَتَى عَلَى أَجَلِهِ مُنْذُ ثَلَاثٍ ، فَرَفَعَ لَنَا  رَجُلٌ  ، فَقُلْنَا : مَا الْخَبَرُ ؟ قَالُوا : قُبِضَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَاسْتُخْلِفَ  أَبُو بَكْرٍ  رَضِيَ اللهُ عَنْهُ         [2/302]      وَالنَّاسُ صَالِحُونَ ، ثُمَّ رَجَعْنَا ، فَقَالَا : أَقْرِئْ صَاحِبَكَ السَّلَامَ ، ثُمَّ قَالَ  ذُو عَمْرٍو  : يَا  جَرِيرُ  إِنَّكُمْ لَنْ تَزَالُوا صَالِحِينَ ، مَا إِذَا هَلَكَ أَمِيرٌ قَامَ أَمِيرٌ ، فَإِذَا مَا كَانَ سُيُوفًا كُنْتُمْ مُلُوكًا تَرْضَوْنَ رِضَا الْمُلُوكِ ، وَتَغْضَبُونَ غَضَبَ الْمُلُوكِ  ""  .","","Al-Mu'jam al-Kabir 2259","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن عبد الله بن إدريس الأودي عن أبو كريب محمد بن العلاء عن البزار عن الطبراني","باب"
"2258","بَابٌ  2260  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ (  ح  ) ،  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ مُوسَى السُّدِّيُّ (  ح  ) ،  وَحَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ الْجَوْهَرِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ، قَالُوا :  ثَنَا  سَيْفُ بْنُ هَارُونَ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  بَايَعْنَا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى مِثْلِ مَا بَايَعَ عَلَيْهِ النِّسَاءُ :  مَنْ مَاتَ مِنَّا وَلَمْ يَأْتِ بِشَيْءٍ مِنْهُنَّ ضَمِنَ لَهُ الْجَنَّةَ  ، وَمَنْ مَاتَ وَقَدْ أَتَى شَيْئًا مِنْهُنَّ وَقَدْ أُقِيمَ عَلَيْهِ  الْحَدُّ  فَهُوَ كَفَّارَتُهُ ، وَمَنْ مَاتَ مِنَّا وَأَتَى شَيْئًا مِنْهُنَّ فَسُتِرَ عَلَيْهِ فَعَلَى اللهِ حِسَابُهُ  .","","Al-Mu'jam al-Kabir 2260","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن سيف بن هارون البرجمي عن سعيد بن سليمان سعدويه عن أحمد بن القاسم بن مساور الجوهري عن الطبراني","باب"
"2259","بَابٌ  2261  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ الْبَجَلِيِّ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ أَقَامَ مَعَ الْمُشْرِكِينَ فَقَدْ بَرِئَتْ مِنْهُ  الذِّمَّةُ  .","","Al-Mu'jam al-Kabir 2261","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن حجاج بن أرطاة عن حماد بن سلمة عن العباس بن الوليد النرسي عن عبد الله بن أحمد بن حنبل عن الطبراني","باب"
"2260","[2/303]      2262  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ ، وَمُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ ، قَالَا :  ثَنَا  الْحَسَنُ بْنُ يَحْيَى الْأَرُزِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ بِلَالٍ ،  عَنْ  عِمْرَانَ الْقَطَّانِ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  بَرِئَتِ  الذِّمَّةُ  مِمَّنْ أَقَامَ مَعَ الْمُشْرِكِينَ فِي دِيَارِهِمْ  .","","Al-Mu'jam al-Kabir 2262","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن حجاج بن أرطاة عن عمران بن داور القطان عن محمد بن بلال التمار عن الحسن بن يحيى الرزي عن محمد بن صالح النرسي عن الطبراني","باب"
"2261","بَابٌ  2263  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ،  ثَنَا  حُصَيْنُ بْنُ عُمَرَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ سُلِبَتْ  كَرِيمَتَيْهِ  عَوَّضْتُهُ مِنْهُمَا الْجَنَّةَ  .","","Al-Mu'jam al-Kabir 2263","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن حصين بن عمر بن الفرات الأحمسي عن منجاب بن الحارث التميمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"2262","2264  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ السَّرَّاجُ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  بَعَثَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَرِيَّةً إِلَى  خَثْعَمَ  فَاعْتَصَمَ نَاسٌ مِنْهُمْ بِالسُّجُودِ ، فَأَسْرَعَ فِيهِمُ الْقَتْلُ ، فَبَلَغَ ذَلِكَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَمَرَ لَهُمْ بِنِصْفِ  الْعَقْلِ  وَقَالَ :  إِنِّي بَرِيءٌ مِنْ كُلِّ مُسْلِمٍ يُقِيمُ بَيْنَ ظَهْرَانَيِ الْمُشْرِكِينَ  ، قَالُوا : يَا رَسُولَ اللهِ وَلِمَ ؟ قَالَ : "" لَا  تَرَاءَى  نَارَاهُمَا  .","","Al-Mu'jam al-Kabir 2264","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن أبو معاوية الضرير عن عبد الله بن عمر مشكدانة عن محمد بن عبدوس السراج عن الطبراني","باب"
"2263","بَابٌ  2265  -  حَدَّثَنَا  الْقَاسِمُ بْنُ مُحَمَّدٍ الدَّلَّالُ الْكُوفِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ مَيْمُونٍ ،  ثَنَا  صَالِحُ بْنُ عُمَرَ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  بَعَثَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَيْشًا إِلَى  خَثْعَمَ ،  فَلَمَّا غَشِيَتْهُمُ الْخَيْلُ اعْتَصَمُوا بِالصَّلَاةِ ، فَقُتِلَ  رَجُلٌ  مِنْهُمْ فَجَعَلَ لَهُمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نِصْفَ  الْعَقْلِ  بِصَلَاتِهِمْ ، وَقَالَ :         [2/304]      إِنِّي بَرِيءٌ مِنْ كُلِّ مُسْلِمٍ مَعَ مُشْرِكٍ  .","","Al-Mu'jam al-Kabir 2265","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن صالح بن عمر الواسطي عن إبراهيم بن محمد بن ميمون الكندي عن قاسم بن محمد بن حماد الدلال عن الطبراني","باب"
"2264","بَابٌ  2266  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ ،  ثَنَا  مُحَمَّدُ بْنُ مُقَاتِلٍ الْمَرْوَزِيُّ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ أَبِي خَلَفٍ ، قَالَا :  ثَنَا  حُصَيْنُ بْنُ عُمَرَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  لَمَّا بُعِثَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَتَيْتُهُ  لِأُبَايِعَهُ  ، فَقَالَ : "" لِأَيِّ شَيْءٍ جِئْتَ يَا  جَرِيرُ  ؟  قُلْتُ : جِئْتُ لِأُسْلِمَ عَلَى يَدَيْكَ ، قَالَ : "" فَدَعَانِي إِلَى شَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَنِّي رَسُولُ اللهِ ، وَتُقِيمُ الصَّلَاةَ الْمَكْتُوبَةَ ، وَتُؤَدِّي الزَّكَاةَ الْمَفْرُوضَةَ ، وَتُؤْمِنُ بِالْقَدَرِ خَيْرِهِ وَشَرِّهِ "" قَالَ : فَأَلْقَى إِلَيَّ كِسَاءَهُ ثُمَّ أَقْبَلَ عَلَى أَصْحَابِهِ فَقَالَ : "" إِذَا جَاءَكُمْ كَرِيمُ قَوْمٍ فَأَكْرِمُوهُ  وَاللَّفْظُ لِحَدِيثِ  الْحَضْرَمِيِّ  .","","Al-Mu'jam al-Kabir 2266","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن حصين بن عمر بن الفرات الأحمسي عن أحمد بن محمد بن أحمد بن محمد القطيعي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"2265","2267  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ  ، ثَنَا  مُحَمَّدُ بْنُ مُقَاتِلٍ الْمَرْوَزِيُّ ،  ثَنَا  حُصَيْنُ بْنُ عُمَرَ الْأَحْمَسِيُّ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ إِبْلِيسَ قَدْ يَئِسَ أَنْ يُعْبَدَ فِي أَرْضِ الْعَرَبِ  .","","Al-Mu'jam al-Kabir 2267","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن حصين بن عمر بن الفرات الأحمسي عن محمد بن مقاتل الكسائي عن محمد بن علي بن زيد الصائغ عن الطبراني","باب"
"2266","2268  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يَحْيَى بْنُ مُطِيعٍ الشَّيْبَانِيُّ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ الْمَلِكِ بْنِ أَبِي غَنِيَّةَ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  دَخَلَ  عُيَيْنَةُ بْنُ حِصْنٍ  عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَعِنْدَهُ  رَجُلٌ  ، فَاسْتَسْقَى ، فَأُتِيَ بِمَاءٍ ، فَسَتَرَهُ فَشَرِبَ ، فَقَالَ : مَا هَذَا ؟ قَالَ :  الْحَيَاءُ وَالْإِيمَانُ أُوتُوهُمَا         [2/305]      وَمُنِعْتُمُوهُمَا  .","","Al-Mu'jam al-Kabir 2268","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى بن عبد الملك بن حميد عن يحيى بن محمد بن مطيع عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"2267","بَابٌ  2269  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  يَحْيَى بْنُ مُطِيعٍ الشَّيْبَانِيُّ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ الْمَلِكِ بْنِ أَبِي غَنِيَّةَ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ،  أَنَّ  عُيَيْنَةَ بْنَ حِصْنٍ  دَخَلَ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَعِنْدَهُ  عَائِشَةُ  ، فَقَالَ : مَنْ هَذِهِ الْجَالِسَةُ إِلَى جَانِبِكَ ؟ قَالَ : ""  عَائِشَةُ  "" قَالَ : أَفَلَا أَنْزِلُ لَكَ عَنْ خَيْرٍ مِنْهَا ؟ يَعْنِي امْرَأَتَهُ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَا "" قَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" اخْرُجْ فَاسْتَأْذِنْ "" قَالَ : إِنَّهَا يَمِينٌ عَلَيَّ أَنْ لَا أَسْتَأْذِنَ عَلَى مُضَرِيٍّ ، فَقَالَتْ  عَائِشَةُ  رَحِمَهَا اللهُ : مَنْ هَذَا ، قَالَ :  هَذَا أَحْمَقُ مُتَّبَعٌ  .","","Al-Mu'jam al-Kabir 2269","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى بن عبد الملك بن حميد عن يحيى بن محمد بن مطيع عن علي بن سعيد بن بشير عليك عن الطبراني","باب"
"2268","2270  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  خَالِدُ بْنُ يَزِيدَ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَدْعُو : "" اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ دُعَاءٍ لَا  يُسْمَعُ  ، وَقَلْبٍ لَا يَخْشَعُ ، وَنَفْسٍ لَا تَشْبَعُ  .","","Al-Mu'jam al-Kabir 2270","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن خالد بن يزيد الهمداني عن هشام بن عمار عن عبد الله بن أحمد الجواليقي عن الطبراني","باب"
"2269","بَابٌ  2271  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ يَتَزَوَّدْ فِي الدُّنْيَا يَنْفَعْهُ فِي الْآخِرَةِ  .","","Al-Mu'jam al-Kabir 2271","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن مروان بن معاوية الفزاري عن هشام بن عمار عن عبد الله بن أحمد الجواليقي عن الطبراني","باب"
"2270","2272  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ خَلَفٍ الْعَطَّارُ ،  ثَنَا  سَهْلُ بْنُ عَامِرٍ ،  ثَنَا  يَحْيَى بْنُ سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  بَيَانٍ ، وَإِسْمَاعِيلَ ،         [2/306]      عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ رَفَعَ بَصَرَهُ إِلَى السَّمَاءِ فَقَالَ :  سُبْحَانَ اللهِ مَاذَا يُرْسَلُ عَلَيْهِمْ مِنَ الْفِتَنِ إِرْسَالَ الْقَطْرِ ؟  .","","Al-Mu'jam al-Kabir 2272","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى بن سلمة بن كهيل عن سهل بن عامر البجلي عن محمد بن علي بن خلف الأطروش عن علي بن سعيد بن بشير عليك عن الطبراني","باب"
"2271","بَابٌ  2273  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي النَّضْرِ ، (  ح  )  وَثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ السِّرَاجُ  ، ثَنَا  الْحَسَنُ بْنُ الصَّبَّاحِ الْبَزَّارُ ، قَالَا :  ثَنَا  خَلَفُ بْنُ تَمِيمٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ إِبْرَاهِيمَ بْنِ الْمُهَاجِرِ ، قَالَ :  سَمِعْتُ  إِسْمَاعِيلَ بْنَ أَبِي خَالِدٍ ،  يُحَدِّثُ عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ ، قَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ لَيُعْطِي عَلَى  الرِّفْقِ  مَا لَا يُعْطِي عَلَى  الْعُنْفِ  .","","Al-Mu'jam al-Kabir 2273","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن إسماعيل بن إبراهيم بن مهاجر النخعي عن خلف بن تميم الدارمي عن الحسن بن الصباح البزار عن محمد بن عبدوس السراج عن الطبراني","باب"
"2272","بَابٌ  2274  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَلِيُّ بْنُ مُحَمَّدِ بْنِ أَبِي الْمَضَاءِ الْمِصِّيصِيُّ ،  ثَنَا  خَلَفُ بْنُ تَمِيمٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ، قَالَ :  سَمِعْتُ  إِسْمَاعِيلَ بْنَ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ لَيُعْطِي عَلَى  الرِّفْقِ  مَا لَا يُعْطِي عَلَى الْخُرْقِ  ، وَإِذَا أَحَبَّ اللهُ عَبْدًا أَعْطَاهُ  الرِّفْقَ  ، مَا مِنْ أَهْلِ بَيْتٍ يُحْرَمُونَ  الرِّفْقَ  إِلَّا قَدْ حُرِمُوا  .","","Al-Mu'jam al-Kabir 2274","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن إسماعيل بن إبراهيم بن مهاجر النخعي عن خلف بن تميم الدارمي عن علي بن محمد بن علي بن أبي المضاء المصيصي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","باب"
"2273","2275  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ هِشَامِ بْنِ أَبِي خَيْرَةَ السَّدُوسِيُّ ،  ثَنَا  عُمَرُ بْنُ عَلِيٍّ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْمُعْتَدِي  فِي الصَّدَقَةِ كَمَانِعِهَا  .","","Al-Mu'jam al-Kabir 2275","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن عمر بن علي بن عطاء عن محمد بن هشام بن شبيب السدوسي عن الحسن بن علي بن شبيب المعمري عن الطبراني","باب"
"2274","[2/307]      بَابٌ  2276  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  عَلِيُّ بْنُ مَنْصُورٍ الْأَهْوَازِيُّ ،  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْوَكِيعِيُّ ،  عَنْ  إِبْرَاهِيمَ بْنِ عُيَيْنَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أُمِرْتُ أَنْ أُقَاتِلَ النَّاسَ حَتَّى يَقُولُوا لَا إِلَهَ إِلَّا اللهُ  ، فَإِذَا قَالُوهَا  عَصَمُوا  مِنِّي دِمَاءَهُمْ وَأَمْوَالَهُمْ إِلَّا بِحَقِّهَا ، وَحِسَابُهُمْ عَلَى اللهِ عَزَّ وَجَلَّ  .","","Al-Mu'jam al-Kabir 2276","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن إبراهيم بن عيينة الهلالي عن أحمد بن جعفر الوكيعي عن علي بن منصور الأهوازي عن عبد الله بن أحمد الجواليقي عن الطبراني","باب"
"2275","بَابٌ  2277  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  إِبْرَاهِيمُ بْنُ زِيَادٍ الرُّصَافِيُّ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى  بْنِ مَنْدَهْ الْأَصْبَهَانِيُّ  ، ثَنَا  أَبُو عُبَيْدَةَ بْنُ أَبِي السَّفَرِ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  "" اسْتَنْصِتِ النَّاسَ "" ، ثُمَّ قَالَ :  لَا تَرْجِعُوا بَعْدِي  كُفَّارًا  يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ  .  في طبعة مكتبة ابن تيمية : ( الحسين ) والمثبت من النسخ الخطية","","Al-Mu'jam al-Kabir 2277","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن عبد الله بن نمير عن أحمد بن عبد الله بن محمد بن عبد الله الهمداني عن محمد بن يحيى بن مندة عن الطبراني","باب"
"2276","2278  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  عَنْ  عَبَّادِ بْنِ الْعَوَّامِ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ، قَالَ :  قَالَ  جَرِيرُ بْنُ عَبْدِ اللهِ :  يُعَدِّدُونَ الْمَيِّتَ أَوْ قَالَ : أَهْلَ الْمَيِّتِ  بَعْدَمَا يُدْفَنُ  ؟ "" -  شَكَّ  إِسْمَاعِيلُ  - قُلْتُ : نَعَمْ ، قَالَ : "" كُنَّا نَعُدُّهَا النِّيَاحَةَ  ""  .","","Al-Mu'jam al-Kabir 2278","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن عباد بن العوام الكلابي عن سعيد بن سليمان سعدويه عن أحمد بن يحيى بن إسحاق الحلواني عن الطبراني","باب"
"2277","2279  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  أَحْمَدُ بْنُ مَنِيعٍ  ثَنَا  هُشَيْمٌ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  كَانُوا يَرَوْنَ أَنَّ اجْتِمَاعَ أَهْلِ الْمَيِّتِ         [2/308]      وَصَنْعَةَ الطَّعَامِ مِنَ النِّيَاحَةِ  ""  .","","Al-Mu'jam al-Kabir 2279","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن هشيم بن بشير عن أحمد بن منيع البغوي عن عبد الله بن أحمد الجواليقي عن الطبراني","باب"
"2278","بَابٌ  2280  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ الْأَصْبَهَانِيُّ  ، ثَنَا  زِيَادُ بْنُ أَيُّوبَ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ الْمَلِكِ بْنِ أَبِي غَنِيَّةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ : كَانَ يُقَالُ :  النَّظْرَةُ الْأُولَى لَا يَمْلِكُهَا الرَّجُلُ ، وَلَكِنَّ الَّذِي يُدْمِنُ النَّظَرَ دَسًّا  ""  .","","Al-Mu'jam al-Kabir 2280","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى بن عبد الملك بن حميد عن دلويه زياد بن أيوب عن محمد بن العباس ابن الأخرم عن الطبراني","باب"
"2279","2281  -  حَدَّثَنَا  أَبُو حَنِيفَةَ مُحَمَّدُ بْنُ حَنِيفَةَ الْوَاسِطِيُّ  ، ثَنَا  أَبُو الْأَشْعَثِ أَحْمَدُ بْنُ الْمِقْدَامِ ،  ثَنَا  عُبَيْدُ بْنُ الْقَاسِمِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  لَمَّا نَزَلَتْ :         {      وَمَا كَانَ رَبُّكَ لِيُهْلِكَ الْقُرَى بِظُلْمٍ وَأَهْلُهَا مُصْلِحُونَ         }      ، قَالَ : "" وَأَهْلُهَا يُنْصِفُ بَعْضُهُمْ بَعْضًا  ""  .","","Al-Mu'jam al-Kabir 2281","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن عبيد بن القاسم الأسدي عن أحمد بن المقدام العجلي عن محمد بن حنيفة القصبى عن الطبراني","باب"
"2280","بَابٌ  2282  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، وَزَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ، قَالُوا :  ثَنَا  الْحَسَنُ بْنُ قَزَعَةَ ،  ثَنَا  بُهْلُولُ بْنُ عُبَيْدٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ، قَالَ :  سَأَلَ  رَجُلٌ  جَرِيرًا عَنِ الْمَسْحِ عَلَى الْخُفَّيْنِ ، فَقَالَ : "" كُنَّا نَمْسَحُ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  قُلْنَا : أَقَبْلَ نُزُولِ الْمَائِدَةِ أَوْ بَعْدَ نُزُولِ الْمَائِدَةِ ؟ قَالَ : إِنَّمَا أَسْلَمْتُ بَعْدَ نُزُولِ الْمَائِدَةِ  .","","Al-Mu'jam al-Kabir 2282","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن بهلول بن عبيد الكندي عن الحسن بن قزعة الخلقاني عن الساجي عن الطبراني","باب"
"2281","بَابٌ  2283  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نَصْرٍ الْقَطَّانُ الْهَمْدَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ الْعَطَّارُ ،  ثَنَا  دَاوُدُ بْنُ الزِّبْرِقَانِ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فِي قَوْلِهِ :         {      وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ غُرُوبِهَا         }             [2/309]      ، قَالَ :  طُلُوعُ الشَّمْسِ صَلَاةُ الصُّبْحِ  ، وَقَبْلَ غُرُوبِهَا صَلَاةُ الْعَصْرِ  .","","Al-Mu'jam al-Kabir 2283","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن داود بن الزبرقان عن يحيى بن سعيد الأنصاري عن محمد بن مصفى بن بهلول عن محمد بن نصر مموس الهمداني عن الطبراني","باب"
"2282","بَابٌ  2284  -  حَدَّثَنَا  عَلِيُّ بْنُ إِسْحَاقَ الْوَزِيرُ الْأَصْبَهَانِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  الْحَسَنُ بْنُ عَطِيَّةَ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُهَاجِرُونَ  وَالْأَنْصَارُ  بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ فِي الدُّنْيَا وَالْآخِرَةِ  ،  وَالطُّلَقَاءُ  مِنْ  قُرَيْشٍ  ، وَالْعُتَقَاءُ مِنْ  ثَقِيفٍ  بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ فِي الدُّنْيَا وَالْآخِرَةِ  .","","Al-Mu'jam al-Kabir 2284","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن قيس بن الربيع الأسدي عن الحسن بن عطية البزاز عن أبو كريب محمد بن العلاء عن الوزير علي بن إسحاق بن إبراهيم عن الطبراني","باب"
"2283","2285  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ الْأَحْمَسِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ الْقَاسِمِ ،  ثَنَا  إِسْمَاعِيلُ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ مَاتَ لَا يُشْرِكُ بِاللهِ شَيْئًا لَمْ  يَتَنَدَّ  بِدَمٍ حَرَامٍ  أُدْخِلَ مِنْ أَيِّ أَبْوَابِ الْجَنَّةِ شَاءَ  .","","Al-Mu'jam al-Kabir 2285","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن الوليد بن القاسم الخبذعي عن محمد بن إسماعيل الأحمسي عن الساجي عن الطبراني","باب"
"2284","بَيَانُ بْنُ بِشْرٍ  عَنْ  قَيْسٍ  عَنْ  جَرِيرٍ  2286  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  بَيَانٌ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  مَا حَجَبَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُنْذُ أَسْلَمْتُ وَلَا رَآنِي إِلَّا ضَحِكَ  .","","Al-Mu'jam al-Kabir 2286","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن بيان بن بشر الأحمسي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","بيان بن بشر عن قيس عن جرير"
"2285","2287  -  حَدَّثَنَا  أَبُو يَزِيدُ يُوسُفُ بْنُ يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ، (  ح  )         [2/310]      وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالُوا :  ثَنَا  خَالِدٌ ،  عَنْ  بَيَانٍ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  مَا حَجَبَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُنْذُ أَسْلَمْتُ وَلَا رَآنِي إِلَّا ضَحِكَ  .","","Al-Mu'jam al-Kabir 2287","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن بيان بن بشر الأحمسي عن خالد بن عبد الله الطحان عن سعيد بن منصور عن يوسف بن يزيد القراطيسي عن الطبراني","بيان بن بشر عن قيس عن جرير"
"2286","2288  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  الْحُسَيْنُ بْنُ عَلِيٍّ الْجُعْفِيُّ ،  عَنْ  زَائِدَةَ ،  ثَنَا  بَيَانٌ الْبَجَلِيُّ  عَنْ  قَيْسٍ ،  ثَنَا  جَرِيرٌ ، قَالَ :  خَرَجَ عَلَيْنَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَيْلَةَ الْبَدْرِ فَقَالَ :  إِنَّكُمْ سَتَرَوْنَ رَبَّكُمْ يَوْمَ الْقِيَامَةِ كَمَا تَرَوْنَ هَذَا الْقَمَرَ لَا  تُضَامُونَ  فِي رُؤْيَتِهِ  .","","Al-Mu'jam al-Kabir 2288","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن بيان بن بشر الأحمسي عن زائدة بن قدامة عن الحسين بن علي الجعفي عن عبد الله بن عمر مشكدانة عن عبد الله بن أحمد بن حنبل عن الطبراني","بيان بن بشر عن قيس عن جرير"
"2287","2289  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ، (  ح  )  وَحَدَّثَنَا  عَبْدَانُ  ، ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالُوا :  ثَنَا  خَالِدٌ ،  عَنْ  بَيَانٍ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  كَانَ فِي الْجَاهِلِيَّةِ  بَيْتٌ يُقَالُ لَهُ ذَا الْخَلَصَةِ  ، كَانَ يُقَالُ لَهُ الْكَعْبَةُ الْيَمَانِيَةُ ، فَقَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هَلْ أَنْتَ مُرِيحِي مِنْ  ذِي الْخَلَصَةِ  ؟  قَالَ : فَمَرَرْتُ إِلَيْهِ بِخَمْسِينَ وَمِائَةِ فَارِسٍ مِنْ  أَحْمَسَ  فَكَسَرْتُهُ ، وَقَتَلْنَا مَنْ وَجَدْنَاهُ عِنْدَهُ ، فَأَتَيْتُهُ فَأَخْبَرْتُهُ فَدَعَا لَنَا وَلِلْأَحْمَسِيِّينَ  .","","Al-Mu'jam al-Kabir 2289","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن بيان بن بشر الأحمسي عن خالد بن عبد الله الطحان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","بيان بن بشر عن قيس عن جرير"
"2288","2290  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ خَلَفٍ الْعَطَّارُ ،  حَدَّثَنَا  سَهْلُ بْنُ عَامِرٍ الْبَجَلِيُّ ،  ثَنَا  يَحْيَى بْنُ سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، وَبَيَانٍ  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ رَفَعَ بَصَرَهُ إِلَى السَّمَاءِ ، فَقَالَ :  سُبْحَانَ اللهِ مَاذَا يُرْسَلُ عَلَيْهِمْ مِنَ الْفِتَنِ إِرْسَالَ الْقَطْرِ ؟  .","","Al-Mu'jam al-Kabir 2290","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى بن سلمة بن كهيل عن سهل بن عامر البجلي عن محمد بن علي بن خلف الأطروش عن علي بن سعيد بن بشير عليك عن الطبراني","بيان بن بشر عن قيس عن جرير"
"2289","2291  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ ،  ثَنَا  تَمِيمُ بْنُ الْمُنْتَصِرِ ،  ثَنَا  عَلِيُّ بْنُ عَاصِمٍ ،  عَنْ  بَيَانِ بْنِ بِشْرٍ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَا يَرْحَمُ لَا يَرْحَمُهُ اللهُ  .","","Al-Mu'jam al-Kabir 2291","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن بيان بن بشر الأحمسي عن علي بن عاصم بن صهيب عن تميم بن المنتصر مولى ابن عباس عن بحشل عن الطبراني","بيان بن بشر عن قيس عن جرير"
"2290","مُجَالِدُ بْنُ سَعِيدٍ  عَنْ  قَيْسٍ  2292  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَأَحْمَدُ بْنُ عَلِيٍّ الْأَبَّارُ ، قَالَا :         [2/311]      ثَنَا  عُمَرُ بْنُ إِسْمَاعِيلَ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  بَيَانٍ ، وَإِسْمَاعِيلَ ، وَمُجَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  خَرَجَ إِلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَيْلَةَ الْبَدْرِ فَنَظَرَ إِلَى الْقَمَرِ ، فَقَالَ :  تَنْظُرُونَ إِلَى رَبِّكُمْ يَوْمَ الْقِيَامَةِ كَمَا تَنْظُرُونَ إِلَى هَذَا الْقَمَرِ لَا  تُضَامُونَ  فِي رُؤْيَتِهِ  .","","Al-Mu'jam al-Kabir 2292","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن مجالد بن سعيد عن إسماعيل بن مجالد بن سعيد الهمداني عن عمر بن إسماعيل بن مجالد الهمداني عن أحمد بن علي بن مسلم النخشبي عن الطبراني","بيان بن بشر عن قيس عن جرير"
"2291","إِبْرَاهِيمُ بْنُ جَرِيرٍ  عَنْ  قَيْسٍ  عَنْ  جَرِيرٍ  2293  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ، (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  شَرِيكٌ ،  عَنْ  إِبْرَاهِيمَ بْنِ جَرِيرٍ ،  عَنْ  قَيْسٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَالَ فَتَوَضَّأَ ، وَمَسَحَ عَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 2293","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إبراهيم بن جرير البجلي عن شريك بن عبد الله النخعي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","إبراهيم بن جرير عن قيس عن جرير"
"2292","إِبْرَاهِيمُ بْنُ جَرِيرٍ عَنْ جَرِيرٍ  2294  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  عَنْ  دَاوُدَ بْنِ عَبْدِ الْجَبَّارِ ، قَالَ :  خَرَجْتُ مَعَ  إِبْرَاهِيمَ بْنِ جَرِيرٍ  فِي جِنَازَةٍ ، وَكَانَ رَاكِبًا فَلَمَّا بَلَغْنَا الْمَقْبَرَةَ خَرَجَتْ حَيَّةٌ ،  فَقَالَ  إِبْرَاهِيمُ :  حَدَّثَنِي  أَبِي  أَنَّهُ سَمِعَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ رَأَى حَيَّةً فَلَمْ يَقْتُلْهَا خَوْفًا مِنْهَا فَلَيْسَ مِنِّي  .","","Al-Mu'jam al-Kabir 2294","","جرير بن عبد الله بن جابر يوسف الأمة عن إبراهيم بن جرير البجلي عن داود بن عبد الجبار الأودي عن سعيد بن سليمان سعدويه عن أحمد بن يحيى بن إسحاق الحلواني عن الطبراني","إبراهيم بن جرير عن جرير"
"2293","2295  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  سَعِيدُ بْنُ مُحَمَّدٍ الْجَرْمِيُّ ،  ثَنَا  دَاوُدُ بْنُ عَبْدِ الْجَبَّارِ ،  عَنْ  إِبْرَاهِيمَ بْنِ جَرِيرٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ لِصَاحِبِ الْحَقِّ : "" خُذْ حَقَّكَ فِي عَفَافٍ وَافٍ أَوْ غَيْرِ وَافٍ  .","","Al-Mu'jam al-Kabir 2295","","جرير بن عبد الله بن جابر يوسف الأمة عن إبراهيم بن جرير البجلي عن داود بن عبد الجبار الأودي عن سعيد بن محمد الجرمي عن عبد الله بن أحمد بن حنبل عن الطبراني","إبراهيم بن جرير عن جرير"
"2294","طَارِقُ بْنُ عَبْدِ الرَّحْمَنِ  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ  عَنْ  جَرِيرٍ  2296  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  الْحَسَنُ بْنُ سَهْلٍ         [2/312]      الْخَيَّاطُ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنِ  الْحَسَنِ بْنِ عُمَارَةَ ،  عَنْ  طَارِقِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَمْ يَبْقَ مِنْ طَوَاغِيتِ الْجَاهِلِيَّةِ إِلَّا  بَيْتُ ذِي الْخَلَصَةِ  ، فَمَنْ يَنْتَدِبُ لِلهِ وَلِرَسُولِهِ ؟  فَقَالَ  جَرِيرٌ  : أَنَا  فَانْتَدَبَ  مَعَهُ سَبْعُمِائَةٍ كُلُّهُمْ مِنْ  أَحْمَسَ  ، فَلَمْ يَفْجَأِ  الْقَوْمُ  إِلَّا بِنَوَاصِي الْخَيْلِ ، فَقَتَلُوا وَخَرَّبُوا الْبَيْتَ ، وَكَتَبُوا إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِبِشَارَةٍ ، وَأَخْبَرَهُ أَنَّهُ لَمْ يَبْقَ مِنْهُ إِلَّا  كَالْبَعِيرِ الْمُهَنَّى أَوْ كَالْبَعِيرِ الْأَجْرَبِ  فَخَرَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَاجِدًا ثُمَّ قَالَ : "" اللَّهُمَّ بَارِكْ  لِأَحْمَسَ  فِي خَيْلِهَا وَرِجَالِهَا "" .","","Al-Mu'jam al-Kabir 2296","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن طارق بن عبد الرحمن البجلي عن الحسن بن عمارة عن عبد الرحيم بن سليمان الأشل عن الحسن بن سهل الخياط عن محمد بن عبد الله مطين الحضرمي عن الطبراني","طارق بن عبد الرحمن عن قيس بن أبي حازم عن جرير"
"2295","زَيْدُ بْنُ وَهْبٍ الْجُهَنِيُّ  عَنْ  جَرِيرٍ  2297  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ لَا يَرْحَمِ النَّاسَ لَا يَرْحَمْهُ اللهُ  .","","Al-Mu'jam al-Kabir 2297","","جرير بن عبد الله بن جابر يوسف الأمة عن زيد بن وهب الجهني عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","زيد بن وهب الجهني عن جرير"
"2296","2298  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ أَبِي عَبَّادٍ الْمَكِّيُّ ،  ثَنَا  فُضَيْلُ بْنُ عِيَاضٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ لَا يَرْحَمِ النَّاسَ لَا يَرْحَمْهُ اللهُ  .","","Al-Mu'jam al-Kabir 2298","","جرير بن عبد الله بن جابر يوسف الأمة عن زيد بن وهب الجهني عن الأعمش عن الفضيل بن عياض عن يعقوب بن إسحاق القلزمي عن يوسف بن يزيد القراطيسي عن الطبراني","زيد بن وهب الجهني عن جرير"
"2297","2299  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ ،  عَنْ  جَرِيرٍ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ لَا يَرْحَمِ النَّاسَ لَا يَرْحَمْهُ اللهُ  .","","Al-Mu'jam al-Kabir 2299","","جرير بن عبد الله بن جابر يوسف الأمة عن زيد بن وهب الجهني عن الأعمش عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","زيد بن وهب الجهني عن جرير"
"2298","2300  -  حَدَّثَنَا  أَبُو حَصِينٍ مُحَمَّدُ بْنُ الْحُسَيْنِ الْقَاضِي  ، ثَنَا  إِبْرَاهِيمُ بْنُ أَبِي مُعَاوِيَةَ ،  حَدَّثَنِي  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَا يَرْحَمِ النَّاسَ لَا يَرْحَمْهُ اللهُ  .","","Al-Mu'jam al-Kabir 2300","","جرير بن عبد الله بن جابر يوسف الأمة عن زيد بن وهب الجهني عن الأعمش عن أبو معاوية الضرير عن إبراهيم بن أبي معاوية عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","زيد بن وهب الجهني عن جرير"
"2299","2301  -  حَدَّثَنَا  مُحَمَّدُ بْنُ قَضَاءٍ الْجَوْهَرِيُّ  ، ثَنَا  عَلِيُّ بْنُ مُسْلِمٍ الطُّوسِيُّ ،         [2/313]      ثَنَا  مُحَمَّدُ بْنُ أَبِي عُبَيْدَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ ،  عَنْ  جَرِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ يَرْحَمِ النَّاسَ يَرْحَمْهُ اللهُ  .","","Al-Mu'jam al-Kabir 2301","","جرير بن عبد الله بن جابر يوسف الأمة عن زيد بن وهب الجهني عن الأعمش عن عبد الملك بن معن المسعودي عن محمد بن أبي عبيدة المسعودي عن علي بن مسلم الطوسي عن محمد بن قضاء الجوهري عن الطبراني","زيد بن وهب الجهني عن جرير"
"2300","أَبُو وَائِلٍ شَقِيقُ بْنُ سَلَمَةَ  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ  سَلَمَةُ بْنُ كُهَيْلٍ  عَنْ  أَبِي وَائِلٍ  2302  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُهَاجِرُونَ  بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ فِي الدُّنْيَا وَالْآخِرَةِ  ،  وَالطُّلَقَاءُ  مِنْ  قُرَيْشٍ  ، وَالْعُتَقَاءُ مِنْ  ثَقِيفٍ  بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ فِي الدُّنْيَا وَالْآخِرَةِ  .","","Al-Mu'jam al-Kabir 2302","","جرير بن عبد الله بن جابر يوسف الأمة عن شقيق بن سلمة عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن موسى بن مسعود النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سلمة بن كهيل عن أبي وائل"
"2301","2303  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عَبْدِ رَبِّهِ بْنِ سَعِيدٍ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  شَقِيقِ بْنِ سَلَمَةَ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ رَضِيَ اللهُ عَنْهُ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا بَايَعَ بَايَعَ عَلَى شَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَنَّ  مُحَمَّدًا  رَسُولُ اللهِ  ، وَإِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَالسَّمْعِ وَالطَّاعَةِ لِلهِ وَلِرَسُولِهِ ، وَالنُّصْحِ لِكُلِّ مُسْلِمٍ  .","","Al-Mu'jam al-Kabir 2303","","جرير بن عبد الله بن جابر يوسف الأمة عن شقيق بن سلمة عن سلمة بن كهيل الحضرمي عن عبد ربه بن سعيد النجاري عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","سلمة بن كهيل عن أبي وائل"
"2302","2304  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عَبْدِ رَبِّهِ بْنِ سَعِيدٍ ،  عَنْ  سَلَمَةَ ،  عَنْ  شَقِيقٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا بَعَثَ سَرِيَّةً قَالَ :  بِسْمِ اللهِ وَفِي  سَبِيلِ  اللهِ وَعَلَى مِلَّةِ رَسُولِ اللهِ  ، لَا تَغُلُّوا وَلَا تَغْدِرُوا وَلَا تُمَثِّلُوا وَلَا تَقْتُلُوا الْوِلْدَانَ "" .","","Al-Mu'jam al-Kabir 2304","","جرير بن عبد الله بن جابر يوسف الأمة عن شقيق بن سلمة عن سلمة بن كهيل الحضرمي عن عبد ربه بن سعيد النجاري عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","سلمة بن كهيل عن أبي وائل"
"2303","2305  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ أَبُو يَحْيَى صَاعِقَةُ ،  ثَنَا  عَلِيُّ بْنُ ثَابِتٍ الدَّهَّانُ ،  ثَنَا  أَبُو مَرْيَمَ عَبْدُ الْغَفَّارِ بْنُ الْقَاسِمِ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  شَقِيقٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا بَعَثَ         [2/314]      جُيُوشَهُ قَالَ :  بِسْمِ اللهِ وَفِي  سَبِيلِ  اللهِ وَعَلَى مِلَّةِ رَسُولِ اللهِ  ، لَا تَغُلُّوا ، وَلَا تُمَثِّلُوا ، وَلَا تَقْتُلُوا  وَلِيدًا  "" .","","Al-Mu'jam al-Kabir 2305","","جرير بن عبد الله بن جابر يوسف الأمة عن شقيق بن سلمة عن سلمة بن كهيل الحضرمي عن عبد الغفار بن القاسم الأنصاري عن علي بن ثابت الدهان عن محمد بن عبد الرحيم  صاعقة عن البزار عن الطبراني","سلمة بن كهيل عن أبي وائل"
"2304","عَاصِمُ بْنُ بَهْدَلَةَ  عَنْ  أَبِي وَائِلٍ  عَنْ  جَرِيرٍ  2306  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  عَاصِمٍ ،  عَنْ  شَقِيقٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ اشْتَرِطْ عَلَيَّ فَأَنْتَ أَعْلَمُ بِالشَّرْطِ مِنِّي قَالَ :  أُبَايِعُكَ  عَلَى أَنْ تَعْبُدَ اللهَ لَا تُشْرِكُ بِهِ شَيْئًا ، وَتُقِيمَ الصَّلَاةَ  ، وَتُؤْتِيَ الزَّكَاةَ ، وَتَنْصَحَ الْمُسْلِمَ ، وَتُفَارِقَ الْمُشْرِكَ "" .","","Al-Mu'jam al-Kabir 2306","","جرير بن عبد الله بن جابر يوسف الأمة عن شقيق بن سلمة عن عاصم بن بهدلة عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","عاصم بن بهدلة عن أبي وائل عن جرير"
"2305","2307  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  ابْنُ عَائِشَةَ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ اشْتَرِطْ عَلَيَّ فَإِنَّكَ أَعْلَمُ ، قَالَ :  اعْبُدِ اللهَ لَا تُشْرِكْ بِهِ شَيْئًا ، وَتُقِيمُ الصَّلَاةَ ، وَتُؤْتِي الزَّكَاةَ  ، وَتَنْصَحُ الْمُسْلِمَ ، وَتَبْرَأُ مِنَ الْكَافِرِ "" .","","Al-Mu'jam al-Kabir 2307","","جرير بن عبد الله بن جابر يوسف الأمة عن شقيق بن سلمة عن عاصم بن بهدلة عن حماد بن سلمة عن ابن عائشة عن أحمد بن داود بن موسى السدوسي عن الطبراني","عاصم بن بهدلة عن أبي وائل عن جرير"
"2306","2308  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ  ، ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  عِكْرِمَةُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقُلْتُ : يَا رَسُولَ اللهِ اشْتَرِطْ عَلَيَّ فَأَنْتَ أَعْلَمُ بِالشَّرْطِ مِنِّي ثُمَّ ابْسُطْ يَدَكَ  فَأُبَايِعَكَ  ، قَالَ :  تَعْبُدُ اللهَ لَا تُشْرِكُ بِهِ شَيْئًا ، وَتُقِيمُ الصَّلَاةَ ، وَتُؤْتِي الزَّكَاةَ  ، وَتَنْصَحُ الْمُسْلِمَ ، وَتُفَارِقُ الْمُشْرِكَ  .","","Al-Mu'jam al-Kabir 2308","","جرير بن عبد الله بن جابر يوسف الأمة عن شقيق بن سلمة عن عاصم بن بهدلة عن عكرمة بن إبراهيم الباهلى عن شيبان بن فروخ الحبطي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","عاصم بن بهدلة عن أبي وائل عن جرير"
"2307","2309  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُسْلِمُ بْنُ سَلَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 2309","","جرير بن عبد الله بن جابر يوسف الأمة عن شقيق بن سلمة عن عاصم بن بهدلة عن أبو بكر بن عياش عن مسلم بن سلام الحنفي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عاصم بن بهدلة عن أبي وائل عن جرير"
"2308","2310  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُهَاجِرُونَ  بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ فِي الدُّنْيَا وَالْآخِرَةِ  ،  وَالطُّلَقَاءُ  مِنْ  قُرَيْشٍ  ، وَالْعُتَقَاءُ مِنْ  ثَقِيفٍ  بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ فِي الدُّنْيَا وَالْآخِرَةِ  .","","Al-Mu'jam al-Kabir 2310","","جرير بن عبد الله بن جابر يوسف الأمة عن شقيق بن سلمة عن عاصم بن بهدلة عن أبو بكر بن عياش عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","عاصم بن بهدلة عن أبي وائل عن جرير"
"2309","[2/315]      2311  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ الْأَصْبَهَانِيُّ  ، ثَنَا  أَبُو مَسْعُودٍ أَحْمَدُ بْنُ الْفُرَاتِ ،  ثَنَا  مُحَمَّدُ بْنُ سَعِيدِ بْنِ سَابِقٍ ،  ثَنَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  عَاصِمِ بْنِ بَهْدَلَةَ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُهَاجِرُونَ  وَالْأَنْصَارُ  بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ فِي الدُّنْيَا وَالْآخِرَةِ  ،  وَالطُّلَقَاءُ  مِنْ  قُرَيْشٍ  ، وَالْعُتَقَاءُ مِنْ  ثَقِيفٍ  بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ  .","","Al-Mu'jam al-Kabir 2311","","جرير بن عبد الله بن جابر يوسف الأمة عن شقيق بن سلمة عن عاصم بن بهدلة عن عمرو بن أبي قيس عن محمد بن سعيد القزويني عن أحمد بن الفرات الضبي عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","عاصم بن بهدلة عن أبي وائل عن جرير"
"2310","2312  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ، (  ح  )  وَحَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ ، قَالَا :  ثَنَا  سُفْيَانُ ،  حَدَّثَنَا  عَاصِمُ بْنُ أَبِي النَّجُودِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  جَاءَ قَوْمٌ مِنْ أَهْلِ الْبَادِيَةِ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مُجْتَابِي  النِّمَارِ  ، فَسَأَلُوهُ فَحَثَّ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ النَّاسَ عَلَى الصَّدَقَةِ ، فَأَبْطَأُوا بِهَا حَتَّى عُرِفَ ذَلِكَ فِي وَجْهِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَجَاءَ  رَجُلٌ مِنَ الْأَنْصَارِ  بِقِطْعَةِ  تِبْرٍ  فَأَلْقَاهَا ، فَتَتَابَعَ النَّاسُ فِي الصَّدَقَةِ حَتَّى عُرِفَ السُّرُورُ فِي وَجْهِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقَالَ :  مَنْ سَنَّ سُنَّةً حَسَنَةً فَعُمِلَ بِهَا بَعْدَهُ كَانَ لَهُ مِثْلُ أَجْرِهَا وَأَجْرِ مَنْ عَمِلَ بِهَا  مِنْ غَيْرِ أَنْ يَنْقُصَ مِنْ أُجُورِهِمْ شَيْءٌ ، وَمَنْ سَنَّ سُنَّةً سَيِّئَةً فَعُمِلَ بِهَا كَانَ عَلَيْهِ وِزْرُهَا وَوِزْرُ مَنْ عَمِلَ بِهَا مِنْ غَيْرِ أَنْ يَنْقُضَ مِنْ أَوْزَارِهِمْ شَيْءٌ "" .","","Al-Mu'jam al-Kabir 2312","","جرير بن عبد الله بن جابر يوسف الأمة عن شقيق بن سلمة عن عاصم بن بهدلة عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","عاصم بن بهدلة عن أبي وائل عن جرير"
"2311","2313  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  سَأَلَ  رَجُلٌ  رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَحَثَّ النَّاسَ عَلَى الصَّدَقَةِ حَتَّى رُئِيَ ذَلِكَ فِي وَجْهِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَجَاءَ  رَجُلٌ مِنَ الْأَنْصَارِ  بِذَهَبَةٍ فَنَبَذَهَا إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَرُئِيَ السُّرُورُ فِي وَجْهِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  مَنْ سَنَّ سُنَّةً حَسَنَةً فِي الْإِسْلَامِ فَعُمِلَ بِهَا مِنْ بَعْدِهِ كَانَ لَهُ أَجْرُهَا وَمِثْلُ أَجْرِ مَنْ عَمِلَ بِهَا  لَا يَنْقُصُ مِنْ أُجُورِهِمْ شَيْءٌ ، وَمَنْ سَنَّ سُنَّةً سَيِّئَةً فِي الْإِسْلَامِ فَعُمِلَ بِهَا بَعْدَهُ كَانَ عَلَيْهِ وِزْرُهَا وَمِثْلُ وِزْرِ مَنْ عَمِلَ بِهَا لَا يَنْقُصُ مِنْ أَوْزَارِهِمْ شَيْءٌ "" .","","Al-Mu'jam al-Kabir 2313","","جرير بن عبد الله بن جابر يوسف الأمة عن شقيق بن سلمة عن عاصم بن بهدلة عن أبو بكر بن عياش عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","عاصم بن بهدلة عن أبي وائل عن جرير"
"2312","[2/316]      الْحَكَمُ بْنُ عُتَيْبَةَ  عَنْ  أَبِي وَائِلٍ  2314  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  حَجَّاجٍ ،  عَنِ  الْحَكَمِ ،  عَنْ  أَبِي وَائِلٍ شَقِيقِ بْنِ سَلَمَةَ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الطُّلَقَاءُ  مِنْ  قُرَيْشٍ  ، وَالْعُتَقَاءُ مِنْ  ثَقِيفٍ  بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ فِي الدُّنْيَا وَالْآخِرَةِ "" .","","Al-Mu'jam al-Kabir 2314","","جرير بن عبد الله بن جابر يوسف الأمة عن شقيق بن سلمة عن الحكم بن عتيبة الكندي عن حجاج بن أرطاة عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن محمد بن عثمان بن أبي شيبة عن الطبراني","الحكم بن عتيبة عن أبي وائل"
"2313","سُلَيْمَانُ الْأَعْمَشُ  عَنْ  أَبِي وَائِلٍ  عَنْ  جَرِيرٍ  2315  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عَبْدُ الْحَمِيدِ بْنُ صَالِحٍ ،  ثَنَا  أَبُو شِهَابٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ بَايِعْنِي وَاشْتَرِطْ عَلَيَّ فَأَنْتَ أَعْلَمُ فَبَسَطَ يَدَهُ فَبَايَعَهُ ، فَقَالَ :  لَا تُشْرِكْ بِاللهِ شَيْئًا ، وَتُقِيمُ الصَّلَاةَ ، وَتُؤْتِي الزَّكَاةَ  ، وَتَنْصَحُ الْمُسْلِمَ ، وَتُفَارِقُ الْكَافِرَ  .","","Al-Mu'jam al-Kabir 2315","","جرير بن عبد الله بن جابر يوسف الأمة عن شقيق بن سلمة عن الأعمش عن عبد ربه بن نافع الحناط عن عبد الحميد بن صالح البرجمي عن الحسين بن إسحاق التستري عن الطبراني","سليمان الأعمش عن أبي وائل عن جرير"
"2314","2316  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَلِيٍّ الْجَارُودِيُّ  ، ثَنَا  أُسَيْدُ بْنُ عَاصِمٍ ،  ثَنَا  عَامِرُ بْنُ إِبْرَاهِيمَ ،  عَنْ  يَعْقُوبَ الْقُمِّيِّ ،  عَنْ  أَبِي رِبْعِيٍّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  شَقِيقِ بْنِ سَلَمَةَ ،  عَنْ  جَرِيرٍ ، قَالَ :  أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقُلْتُ : يَا رَسُولَ اللهِ ابْسُطْ يَدَكَ  أُبَايِعْكَ  وَخُذْ عَلَيَّ فَأَنْتَ أَعْلَمُ بِالشَّرْطِ مِنِّي ، قَالَ :  أُبَايِعُكَ  عَلَى أَنْ لَا تُشْرِكَ بِاللهِ شَيْئًا ، وَتُقِيمَ الصَّلَاةَ  ، وَتُؤْتِيَ الزَّكَاةَ ، وَتَنْصَحَ الْمُسْلِمَ ، وَتُفَارِقَ الْمُشْرِكَ "" .","","Al-Mu'jam al-Kabir 2316","","جرير بن عبد الله بن جابر يوسف الأمة عن شقيق بن سلمة عن الأعمش عن أبو ربعي عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن عامر بن إبراهيم الأصبهاني عن أسيد بن عاصم الأصبهاني عن الجارودي أحمد بن علي الأصبهاني عن الطبراني","سليمان الأعمش عن أبي وائل عن جرير"
"2315","مَنْصُورُ بْنُ الْمُعْتَمِرِ  عَنْ  أَبِي وَائِلٍ  عَنْ  جَرِيرٍ  2317  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  صَالِحُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ سَعِيدٍ الْقَطَّانُ ،  ثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  ثَنَا  شُعْبَةُ ،  عَنِ  الْأَعْمَشِ ، وَمَنْصُورٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  جَرِيرٍ ، قَالَ :  بَايَعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَاشْتَرَطَ عَلَيَّ  أَنْ أَعْبُدَ اللهَ لَا  أَشْرَكُ  بِهِ شَيْئًا وَالنُّصْحَ لِكُلِّ مُسْلِمٍ  .","","Al-Mu'jam al-Kabir 2317","","جرير بن عبد الله بن جابر يوسف الأمة عن شقيق بن سلمة عن منصور بن المعتمر عن شعبة بن الحجاج عن عثمان بن عمر بن فارس عن صالح بن محمد بن يحيى بن سعيد القطان عن البزار عن الطبراني","منصور بن المعتمر عن أبي وائل عن جرير"
"2316","[2/317]      أَبُو نُخَيْلَةَ الْبَجَلِيُّ  عَنْ  جَرِيرٍ  2318  -  حَدَّثَنَا  مُعَاذٌ  ، ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  حَدَّثَنِي  أَبِي  ، (  ح  )  وَثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالُوا :  ثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  أَبِي نُخَيْلَةَ الْبَجَلِيِّ ، قَالَ :  قَالَ  جَرِيرٌ :  أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يُبَايِعُ النَّاسَ ، فَقُلْتُ : يَا رَسُولَ اللهِ ابْسُطْ يَدَكَ حَتَّى  أُبَايِعَكَ  ، فَقَالَ : كَيْفَ  تُبَايِعُنِي  ؟ فَقَالَ :  أُبَايِعُكَ  عَلَى أَنْ تَعْبُدَ اللهَ ، وَتُقِيمَ الصَّلَاةَ ، وَتُؤْتِيَ الزَّكَاةَ  ، وَتُنَاصِحَ الْمُسْلِمَ ، وَتُفَارِقَ الْمُشْرِكَ "" .","","Al-Mu'jam al-Kabir 2318","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو نخيلة البجلي عن شقيق بن سلمة عن منصور بن المعتمر عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","أبو نخيلة البجلي عن جرير"
"2317","زَاذَانُ أَبُو عُمَرَ  عَنْ  جَرِيرٍ  بَابٌ  2319  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ  ،  عَنْ  زَاذَانَ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اللَّحْدُ لَنَا وَالشَّقُّ لِغَيْرِنَا  .  كذا في طبعة مكتبة ابن تيمية ، ونسخة الظاهرية ( 1 ) ، والصواب : ( سلم بن عبد الرحمن ) كما في نسخة الظاهرية ( 2 ) وإن كان كتب أمامه في حاشيتها : ( سلمة ) وينظر ترجمته في التهذيبين ، إسناد الحديث فيه اختلاف وينظر علل الدارقطني ، والله أعلم .","","Al-Mu'jam al-Kabir 2319","","جرير بن عبد الله بن جابر يوسف الأمة عن زاذان الكندي عن سلم بن عبد الرحمن النخعي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","زاذان أبو عمر عن جرير"
"2318","2320  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ  عَنْ  أَبِي الْيَقْظَانِ ،  عَنْ  زَاذَانَ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اللَّحْدُ لَنَا وَالشَّقُّ لِغَيْرِنَا  .","","Al-Mu'jam al-Kabir 2320","","جرير بن عبد الله بن جابر يوسف الأمة عن زاذان الكندي عن عثمان بن عمير البجلي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","زاذان أبو عمر عن جرير"
"2319","2321  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُوسَى بْنُ عَبْدِ الرَّحْمَنِ الْمَسْرُوقِيُّ ،  ثَنَا  حُسَيْنُ بْنُ عَلِيٍّ ،  عَنْ  زَائِدَةَ ،  عَنْ  سُفْيَانَ الثَّوْرِيِّ ،  عَنْ  أَبِي الْيَقْظَانِ ،         [2/318]      عَنْ  زَاذَانَ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اللَّحْدُ لَنَا وَالشَّقُّ لِغَيْرِنَا  .","","Al-Mu'jam al-Kabir 2321","","جرير بن عبد الله بن جابر يوسف الأمة عن زاذان الكندي عن عثمان بن عمير البجلي عن سفيان الثوري عن زائدة بن قدامة عن الحسين بن علي الجعفي عن موسى بن عبد الرحمن بن سعيد المسروقي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","زاذان أبو عمر عن جرير"
"2320","2322  -  حَدَّثَنَا  أَبُو عَامِرٍ مُحَمَّدُ بْنُ إِبْرَاهِيمَ الصُّورِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  دَاوُدَ بْنِ عِيسَى ،  عَنْ  عَمْرِو بْنِ قَيْسٍ ،  عَنْ  أَبِي الْيَقْظَانِ ،  عَنْ  زَاذَانَ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اللَّحْدُ لَنَا وَالشَّقُّ لِغَيْرِنَا  .","","Al-Mu'jam al-Kabir 2322","","جرير بن عبد الله بن جابر يوسف الأمة عن زاذان الكندي عن عثمان بن عمير البجلي عن عمرو بن قيس الملائي عن داود بن عيسى النخعي عن إسماعيل بن عياش الأحول عن سليمان بن عبد الرحمن التميمي عن محمد بن إبراهيم الصوري عن الطبراني","زاذان أبو عمر عن جرير"
"2321","2323  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْحَكَمِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  دَاوُدَ بْنِ عِيسَى ،  عَنْ  عَمْرِو بْنِ قَيْسٍ ،  عَنْ  عُثْمَانَ أَبِي الْيَقْظَانِ ،  عَنْ  زَاذَانَ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اللَّحْدُ لَنَا وَالشَّقُّ لِغَيْرِنَا  .","","Al-Mu'jam al-Kabir 2323","","جرير بن عبد الله بن جابر يوسف الأمة عن زاذان الكندي عن عثمان بن عمير البجلي عن عمرو بن قيس الملائي عن داود بن عيسى النخعي عن إسماعيل بن عياش الأحول عن عبد الله بن عبد الحكم بن أعين عن يوسف بن يزيد القراطيسي عن الطبراني","زاذان أبو عمر عن جرير"
"2322","2324  -  حَدَّثَنَا  زَكَرِيَّا السَّاجِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ مُوسَى السُّدِّيُّ ، (  ح  )  وَثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  شَرِيكٌ ،  عَنْ  أَبِي الْيَقْظَانِ ،  عَنْ  زَاذَانَ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اللَّحْدُ لَنَا وَالشَّقُّ لِغَيْرِنَا  .","","Al-Mu'jam al-Kabir 2324","","جرير بن عبد الله بن جابر يوسف الأمة عن زاذان الكندي عن عثمان بن عمير البجلي عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","زاذان أبو عمر عن جرير"
"2323","2325  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَثَنَا  أَبُو حَصِينٍ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  حَجَّاجٍ ،  عَنْ  أَبِي الْيَقْظَانِ ،  عَنْ  زَاذَانَ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اللَّحْدُ لَنَا وَالشَّقُّ لِغَيْرِنَا  .","","Al-Mu'jam al-Kabir 2325","","جرير بن عبد الله بن جابر يوسف الأمة عن زاذان الكندي عن عثمان بن عمير البجلي عن حجاج بن أرطاة عن أبو معاوية الضرير عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","زاذان أبو عمر عن جرير"
"2324","2326  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  أَبُو كَامِلٍ الْجَحْدَرِيُّ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  أَبِي الْيَقْظَانِ ،  عَنْ  زَاذَانَ ،  عَنْ  جَرِيرٍ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اللَّحْدُ لَنَا وَالشَّقُّ لِغَيْرِنَا  .","","Al-Mu'jam al-Kabir 2326","","جرير بن عبد الله بن جابر يوسف الأمة عن زاذان الكندي عن عثمان بن عمير البجلي عن حجاج بن أرطاة عن عبد الواحد بن زياد عن فضيل بن حسين الجحدري عن عبد الله بن أحمد بن حنبل عن الطبراني","زاذان أبو عمر عن جرير"
"2325","2327  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  أَبِي الْيَقْظَانِ ،  عَنْ  زَاذَانَ ،         [2/319]      عَنْ  جَرِيرٍ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَسَأَلَهُ عَنِ الْإِسْلَامِ فَقَالَ :  تَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، وَتُقِيمُ الصَّلَاةَ ، وَتُؤْتِي الزَّكَاةَ  ، وَتَصُومُ رَمَضَانَ ، وَتَحُجُّ الْبَيْتَ ، وَتُحِبُّ لِلنَّاسِ مَا تُحِبُّ لِنَفْسِكَ ، وَتَكْرَهُ لِلنَّاسِ مَا تَكْرَهُ لِنَفْسِكَ "" .","","Al-Mu'jam al-Kabir 2327","","جرير بن عبد الله بن جابر يوسف الأمة عن زاذان الكندي عن عثمان بن عمير البجلي عن حجاج بن أرطاة عن عبد الرحيم بن سليمان الأشل عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","زاذان أبو عمر عن جرير"
"2326","2328  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  أَبِي حَمْزَةَ الْيَقْظَانِ ،  عَنْ  زَاذَانَ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اللَّحْدُ لَنَا وَالشَّقُّ لِغَيْرِنَا  .","","Al-Mu'jam al-Kabir 2328","","جرير بن عبد الله بن جابر يوسف الأمة عن زاذان الكندي عن ثابت بن أبي صفية الثمالي عن أبو بكر بن عياش عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","زاذان أبو عمر عن جرير"
"2327","2329  -  حَدَّثَنَا  عَلَّانُ بْنُ عَبْدِ الصَّمَدِ مَاغَمَّهُ  ، حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ الْهَيَّاجِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  أَبُو حَمْزَةَ الثُّمَالِيُّ ثَابِتُ بْنُ سَعِيدٍ ،  عَنْ  أَبِي الْيَقْظَانِ ،  عَنْ  زَاذَانَ ،  عَنْ  جَرِيرٍ ، قَالَ :  خَرَجْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى رَوَاحِلِنَا مِنَ  الْمَدِينَةِ  وَهِيَ آكِلَةُ النَّوَى ، فَرَفَعَ لَهُ شَخَصٌ ، فَقَالَ : "" هَذَا  رَجُلٌ  لَا عَهْدَ لَهُ بِالطَّعَامِ "" ، فَأَسْرَعَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ السَّيْرَ وَأَسْرَعْنَا مَعَهُ ، فَإِذَا فَتًى شَابٌّ قَدِ اسْتَلْقَتْ شَفَتَاهُ مِنْ أَكْلِ لِحَى الشَّجَرِ فَسَأَلَهُ : "" مِنْ أَيْنَ أَقْبَلْتَ ؟ "" فَقَالَ : أُرِيدُ  مُحَمَّدًا  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِأُبَايِعَهُ  ، قَالَ : "" فَأَنَا  مُحَمَّدٌ  أَنَا رَسُولُ اللهِ "" ، فَقَالَ : السَّلَامُ عَلَيْكَ دُلَّنِي عَلَى الْإِسْلَامِ يَا رَسُولَ اللهِ قَالَ : "" تَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَنِّي رَسُولُ اللهِ وَتُقِرُّ بِمَا جَاءَ مِنْ عِنْدِ اللهِ "" قَالَ : أَقْرَرْتُ قَالَ : "" وَتُقِيمُ الصَّلَاةَ "" ، قَالَ : أَقْرَرْتُ قَالَ : "" وَتَصُومُ رَمَضَانَ "" قَالَ : أَقْرَرْتُ قَالَ : "" وَتَحُجُّ الْبَيْتَ "" قَالَ : أَقْرَرْتُ ثُمَّ انْصَرَفَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  جَرِيرٌ  : وَازْدَحَمْنَا عَلَيْهِ حِينَ أَنْشَأَ يَصِفُ لَهُ الْإِسْلَامَ نَنْظُرُ إِلَى أَيِّ شَيْءٍ يَنْتَهِي صِفَتُهُ ، ثُمَّ انْصَرَفَ وَانْصَرَفْنَا ، فَوَقَعَتْ يَدُ بَكْرِهِ فِي أَخَافِيقِ الْجِرْذَانِ فَانْدَقَّتْ عُنُقُهُ ، فَالْتَفَتَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" عَلَيَّ الرَّجُلُ "" فَوَجَدْنَاهُ قَدِ انْثَنَتْ عُنُقُهُ فَمَاتَ ، فَأَتَاهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَنَظَرَ إِلَيْهِ ثُمَّ أَعْرَضَ عَنْهُ بِوَجْهِهِ ، فَقَالَ : "" احْمِلُوهُ إِلَى الْمَاءِ ""         [2/320]      فَغَسَّلْنَاهُ وَكَفَّنَّاهُ وَحَنَّطْنَاهُ ، ثُمَّ قَالَ :  احْفُرُوا لَهُ وَالْحِدُوا  لَحْدًا  فَإِنَّ اللَّحْدَ لَنَا وَالشَّقَّ لِغَيْرِنَا  ، وَجَلَسَ عَلَى قَبْرِهِ لَا يُحَدِّثُنَا بِشَيْءٍ ثُمَّ قَالَ : "" أَلَا أُحَدِّثُكُمْ بِحَدِيثِ هَذَا الرَّجُلِ ؟ هَذَا مِمَّنْ عَمِلَ قَلِيلًا وَأُجِرَ كَثِيرًا مِمَّنْ قَالَ اللهُ عَزَّ وَجَلَّ :         {      الَّذِينَ آمَنُوا وَلَمْ يَلْبِسُوا إِيمَانَهُمْ بِظُلْمٍ         }      إِنِّي أَعْرَضْتُ عَنْهُ وَمَلَكَانِ يَدُسَّانِ فِي فَمِهِ ثِمَارَ الْجَنَّةِ "" .","","Al-Mu'jam al-Kabir 2329","","جرير بن عبد الله بن جابر يوسف الأمة عن زاذان الكندي عن عثمان بن عمير البجلي عن ثابت بن أبي صفية الثمالي عن عبيد الله بن موسى عن محمد بن عمر بن هياج الصائدي عن علي بن عبد الصمد علان ماغمه عن الطبراني","زاذان أبو عمر عن جرير"
"2328","2330  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  زَاذَانَ ،  عَنْ  جَرِيرٍ ،  أَنَّ  رَجُلًا  دَخَلَ فِي الْإِسْلَامِ فَكَانَ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي مَسِيرٍ لَهُ فَدَخَلَ خُفُّ بَعِيرِهِ فِي حُجْرِ  يَرْبُوعٍ  فَوَقَصَهُ  فَمَاتَ ، فَأَتَى عَلَيْهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  عَمِلَ قَلِيلًا وَأُجِرَ كَثِيرًا  وَقَالَ : "" اللَّحْدُ لَنَا وَالشَّقُّ لِغَيْرِنَا "" .","","Al-Mu'jam al-Kabir 2330","","جرير بن عبد الله بن جابر يوسف الأمة عن زاذان الكندي عن عمرو بن مرة المرادي عن حجاج بن أرطاة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","زاذان أبو عمر عن جرير"
"2329","عَامِرٌ الشَّعْبِيُّ  عَنْ  جَرِيرٍ  مَنْصُورُ بْنُ عَبْدِ الرَّحْمَنِ الْغُدَانِيُّ  عَنِ  الشَّعْبِيِّ  2331  -  حَدَّثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الْقَاضِي  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  مَنْصُورِ بْنِ عَبْدِ الرَّحْمَنِ الْغُدَانِيِّ ،  سَمِعَ  الشَّعْبِيَّ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فِي الْعَبْدِ  الْآبِقِ  :  لَا تُقْبَلُ لَهُ صَلَاةٌ حَتَّى يَرْجِعَ إِلَى مَوَالِيهِ  .","","Al-Mu'jam al-Kabir 2331","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن منصور بن عبد الرحمن الغداني عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","منصور بن عبد الرحمن الغداني عن الشعبي"
"2330","2332  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُعَلَّى بْنُ أَسَدٍ الْعَمِّيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ الْمُخْتَارِ ،  عَنْ  مَنْصُورٍ ،  حَدَّثَنِي  الشَّعْبِيُّ ،  أَنَّهُ سَمِعَ  جَرِيرَ بْنَ عَبْدِ اللهِ ، يَقُولُ :  أَيُّمَا عَبْدٍ  أَبَقَ  مِنْ مَوَالِيهِ فَقَدْ كَفَرَ حَتَّى يَرْجِعَ إِلَيْهِمْ  قَالَ  مَنْصُورٌ  : قَدْ وَاللهِ قَالَهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَلَكِنْ لَا أُرِيدُ أَنْ يُرْوَى عَنِّي "" .","","Al-Mu'jam al-Kabir 2332","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن منصور بن عبد الرحمن الغداني عن عبد العزيز بن المختار الدباغ عن معلى بن أسد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","منصور بن عبد الرحمن الغداني عن الشعبي"
"2331","[2/321]      دَاوُدُ بْنُ أَبِي هِنْدَ  عَنِ  الشَّعْبِيِّ  2333  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ  ، ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  ثَنَا  دَاوُدُ بْنُ أَبِي هِنْدَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لِيَرْجِعِ الْمُصَدِّقُ وَهُوَ عَنْكُمْ رَاضٍ  .","","Al-Mu'jam al-Kabir 2333","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن داود بن أبي هند عن يزيد بن هارون عن إدريس بن جعفر العطار عن الطبراني","داود بن أبي هند عن الشعبي"
"2332","2334  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  دَاوُدُ بْنُ أَبِي هِنْدَ ،  حَدَّثَنِي  عَامِرٌ الشَّعْبِيُّ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لِيَرْجِعِ الْمُصَدِّقُ وَهُوَ عَنْكُمْ رَاضٍ  .","","Al-Mu'jam al-Kabir 2334","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن داود بن أبي هند عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","داود بن أبي هند عن الشعبي"
"2333","2335  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ، (  ح  )  وَثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ ،  ثَنَا  جَدِّي أَحْمَدُ بْنُ أَبِي شُعَيْبٍ ، قَالَا :  حَدَّثَنَا  زُهَيْرُ بْنُ مُعَاوِيَةَ ،  ثَنَا  دَاوُدُ بْنُ أَبِي هِنْدَ ،  ثَنَا  عَامِرٌ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لِيَرْجِعِ الْمُصَدِّقُ وَهُوَ عَنْكُمْ رَاضٍ  .","","Al-Mu'jam al-Kabir 2335","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن داود بن أبي هند عن زهير بن معاوية بن حديج عن أحمد بن عبد الله بن مسلم عن أبو شعيب الحراني عن الطبراني","داود بن أبي هند عن الشعبي"
"2334","2336  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ  ، ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  ثَنَا  وُهَيْبٌ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدَ ،  عَنْ  عَامِرٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا أَتَاكُمُ الْمُصَدِّقُ فَلَا يَصْدُرْ عَنْكُمْ إِلَّا وَهُوَ عَنْكُمْ رَاضٍ  .","","Al-Mu'jam al-Kabir 2336","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن داود بن أبي هند عن وهيب بن خالد الكرابيسي عن عفان بن مسلم الصفار عن لحية الليف محمد بن العباس عن الطبراني","داود بن أبي هند عن الشعبي"
"2335","2337  -  حَدَّثَنَا  الْفَضْلُ بْنُ الْحُبَابِ الْجُمَحِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدَ ، وَمُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا أَتَاكُمُ الْمُصَدِّقُ فَلَا يَصْدُرْ إِلَّا عَنْ رِضًى  .","","Al-Mu'jam al-Kabir 2337","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن مجالد بن سعيد عن سفيان الثوري عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","داود بن أبي هند عن الشعبي"
"2336","2338  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ، وَأَبُو خَالِدٍ الْأَحْمَرُ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لِيَرْجِعِ الْمُصَدِّقُ حِينَ يَرْجِعُ وَهُوَ رَاضٍ  .","","Al-Mu'jam al-Kabir 2338","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن داود بن أبي هند عن سليمان بن حيان الأحمر عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","داود بن أبي هند عن الشعبي"
"2337","2339  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  إِسْمَاعِيلُ ابْنُ عُلَيَّةَ ، وَعَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا جَاءَكُمُ الْمُصَدِّقُ فَلْيَصْدُرْ         [2/322]      عَنْكُمْ وَهُوَ عَنْكُمْ رَاضٍ  .","","Al-Mu'jam al-Kabir 2339","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن داود بن أبي هند عن عبد الرحيم بن سليمان الأشل عن عثمان ابن أبي شيبة عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","داود بن أبي هند عن الشعبي"
"2338","2340  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ بْنِ أَبِي الشَّوَارِبِ ،  ثَنَا  مَسْلَمَةُ بْنُ عَلْقَمَةَ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لِيَصْدُرِ الْمُصَدِّقُ عَنْكُمْ وَهُوَ رَاضٍ  .","","Al-Mu'jam al-Kabir 2340","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن داود بن أبي هند عن مسلمة بن علقمة المازني عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن البزار عن الطبراني","داود بن أبي هند عن الشعبي"
"2339","2341  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  دَاوُدَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لِيَرْجِعِ الْمُصَدِّقُ مِنْ عِنْدِكُمْ وَهُوَ عَنْكُمْ رَاضٍ  .","","Al-Mu'jam al-Kabir 2341","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن داود بن أبي هند عن محمد بن فضيل بن غزوان عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","داود بن أبي هند عن الشعبي"
"2340","2342  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ مُسَاوِرٍ الْجَوْهَرِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا ،  عَنْ  دَاوُدَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، قَالَ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى إِقَامِ الصَّلَاةِ  ، وَإِيتَاءِ الزَّكَاةِ ، وَالنُّصْحِ لِكُلِّ مُسْلِمٍ "" - قَالَ  الشَّعْبِيُّ  : وَكَانَ  جَرِيرٌ  فَطِنًا - فَقُلْتُ : يَا رَسُولَ اللهِ فِيمَا اسْتَطَعْتُ .","","Al-Mu'jam al-Kabir 2342","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن داود بن يزيد الزعافري عن إسماعيل بن زكريا شقوصا عن سعيد بن سليمان سعدويه عن أحمد بن القاسم بن مساور الجوهري عن الطبراني","داود بن أبي هند عن الشعبي"
"2341","2343  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلِيُّ ، وَالْحَضْرَمِيُّ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ أَبِي زِيَادٍ الْقَطَوَانِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ الرَّبِيعِ الْعُصْفُرِيُّ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدَ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا مِنْ ذِي رَحِمٍ يَأْتِي رَحِمَهُ  ، فَيَسْأَلُهُ فَضْلًا أَعْطَاهُ اللهُ إِيَّاهُ فَيَبْخَلُ عَلَيْهِ إِلَّا أُخْرِجَ لَهُ يَوْمَ الْقِيَامَةِ مِنْ  جَهَنَّمَ  حَيَّةٌ يُقَالُ لَهَا شُجَاعٌ  يَتَلَمَّظُ  فَيُطَوَّقُ بِهِ "" .","","Al-Mu'jam al-Kabir 2343","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن داود بن أبي هند عن إسحاق بن الربيع العصفري عن عبد الله بن الحكم القطواني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","داود بن أبي هند عن الشعبي"
"2342","أَبُو إِسْحَاقَ السَّبِيعِيُّ  عَنِ  الشَّعْبِيِّ  عَنْ  جَرِيرٍ  2344  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ الْمَسْرُوقِيُّ الْكُوفِيُّ  ، ثَنَا  عَلِيُّ بْنُ حَكِيمٍ الْأَوْدِيُّ ،  ثَنَا  حُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ الرُّوَاسِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا لَحِقَ الْعَبْدُ بِأَرْضِ الْعَدُوِّ فَقَدْ حَلَّ دَمُهُ  .","","Al-Mu'jam al-Kabir 2344","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن أبو إسحاق السبيعي عن عبد الرحمن بن حميد الرؤاسي عن حميد بن عبد الرحمن الرؤاسي عن علي بن حكيم بن ذبيان عن محمد بن عبد الله بن عبد الرحمن المسروقي عن الطبراني","أبو إسحاق السبيعي عن الشعبي عن جرير"
"2343","[2/323]      2345  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا  أَبَقَ  الْعَبْدُ إِلَى الْعَدُوِّ فَقَدْ بَرِئَتْ مِنْهُ  الذِّمَّةُ  .","","Al-Mu'jam al-Kabir 2345","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرحمن بن مهدي عن أبو موسى الزمن عن أحمد بن يحيى بن زهير التستري عن الطبراني","أبو إسحاق السبيعي عن الشعبي عن جرير"
"2344","2346  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  نَصْرُ بْنُ عَلِيٍّ ،  ثَنَا  أَبُو أَحْمَدَ الزُّبَيْرِيُّ ،  ثَنَا  إِسْرَائِيلُ  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ أَخَاكُمُ  النَّجَاشِيَّ  قَدْ مَاتَ فَصَلُّوا عَلَيْهِ  .","","Al-Mu'jam al-Kabir 2346","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن عبد الله بن الزبير عن نصر بن علي بن نصر الجهضمي عن الحسين بن إسحاق التستري عن الطبراني","أبو إسحاق السبيعي عن الشعبي عن جرير"
"2345","2347  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْحُسَيْنِ الْمِصِّيصِيُّ  ، ثَنَا  مُوسَى بْنُ دَاوُدَ الضَّبِّيُّ ، (  ح  )  وَحَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، قَالَا :  ثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ أَخَاكُمُ  النَّجَاشِيَّ  مَاتَ فَاسْتَغْفِرُوا لَهُ  .","","Al-Mu'jam al-Kabir 2347","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن أبو الوليد الطيالسي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","أبو إسحاق السبيعي عن الشعبي عن جرير"
"2346","2348  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  سُوَيْدُ بْنُ عَمْرٍو الْكَلْبِيُّ ،  عَنْ  شَرِيكٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَامِرٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اسْتَغْفِرُوا  لِلنَّجَاشِيِّ  .","","Al-Mu'jam al-Kabir 2348","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن سويد بن عمرو الكلبي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","أبو إسحاق السبيعي عن الشعبي عن جرير"
"2347","أَبُو إِسْحَاقَ الشَّيْبَانِيُّ  عَنِ  الشَّعْبِيِّ  عَنْ  جَرِيرٍ  2349  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ الشَّيْبَانِيِّ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا  أَبَقَ  الْعَبْدُ إِلَى أَرْضِ الْعَدُوِّ فَقَدْ بَرِئَتْ مِنْهُ  الذِّمَّةُ  .","","Al-Mu'jam al-Kabir 2349","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن سليمان بن فيروز الشيباني عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","أبو إسحاق الشيباني عن الشعبي عن جرير"
"2348","2350  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ حَمْدَانَ الْحَنَفِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ بْنِ ثَعْلَبَةَ ،  حَدَّثَنَا  أَبِي  ،  ثَنَا  شَرِيكٌ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، قَالَ :  قَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ أَخَاكُمُ  النَّجَاشِيَّ  قَدْ مَاتَ فَاسْتَغْفِرُوا لَهُ  .","","Al-Mu'jam al-Kabir 2350","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن سليمان بن فيروز الشيباني عن شريك بن عبد الله النخعي عن والد الجرب ، محمد بن عبيد بن محمد بن ثعلبة عن الجرب ، محمد بن عبيد بن محمد بن ثعلبة عن العباس بن حمدان الأصبهاني عن الطبراني","أبو إسحاق الشيباني عن الشعبي عن جرير"
"2349","[2/324]      إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ  عَنِ  الشَّعْبِيِّ  عَنْ  جَرِيرٍ  2351  -  حَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ  ، ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ، وَمُجَالِدٌ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، قَالَ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى شَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ  ، وَالسَّمْعِ وَالطَّاعَةِ ، وَإِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَالنُّصْحِ لِكُلِّ مُسْلِمٍ "" .","","Al-Mu'jam al-Kabir 2351","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن مجالد بن سعيد عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","إسماعيل بن أبي خالد عن الشعبي عن جرير"
"2350","2352  -  حَدَّثَنَا  مَحْمُودُ بْنُ عَلِيٍّ الْأَصْبَهَانِيُّ  ، ثَنَا  يُونُسُ بْنُ حَبِيبٍ ،  ثَنَا  أَبُو دَاوُدَ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا أَتَاكُمُ الْمُصَدِّقُ فَلَا يَصْدُرَنَّ عَنْكُمْ إِلَّا وَهُوَ رَاضٍ  .","","Al-Mu'jam al-Kabir 2352","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن إسماعيل بن أبي خالد عن هشيم بن بشير عن أبو داود الطيالسي عن يونس بن حبيب الماصر عن محمود بن علي بن مالك الشيباني عن الطبراني","إسماعيل بن أبي خالد عن الشعبي عن جرير"
"2351","2353  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  أَبُو سَلَمَةَ يَحْيَى بْنُ خَلَفٍ ،  ثَنَا  عُمَرُ بْنُ عَلِيٍّ ،  عَنْ  إِسْمَاعِيلَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّمَا يَرْحَمُ اللهُ مِنْ عِبَادِهِ الرُّحَمَاءَ  .","","Al-Mu'jam al-Kabir 2353","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن إسماعيل بن أبي خالد عن عمر بن علي بن عطاء عن يحيى بن خلف الجوباري عن عبد الله بن أحمد الجواليقي عن الطبراني","إسماعيل بن أبي خالد عن الشعبي عن جرير"
"2352","سَيَّارُ أَبُو الْحَكَمِ  عَنِ  الشَّعْبِيِّ  2354  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  سَيَّارٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، قَالَ :  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقُلْتُ : عَلَى السَّمْعِ وَالطَّاعَةِ  - فَلَقَّنَنِي "" فِيمَا اسْتَطَعْتُ - وَالنُّصْحِ لِكُلِّ مُسْلِمٍ "" .","","Al-Mu'jam al-Kabir 2354","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن سيار بن أبي سيار العنزي عن هشيم بن بشير عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","سيار أبو الحكم عن الشعبي"
"2353","مُغِيرَةُ بْنُ مِقْسَمٍ  عَنِ  الشَّعْبِيِّ  2355  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، وَجَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ، قَالَا :  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا يَصْدُرِ الْمُصَدِّقُونَ إِلَّا عَنْ رِضًى  .","","Al-Mu'jam al-Kabir 2355","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","مغيرة بن مقسم عن الشعبي"
"2354","2356  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ ،  ثَنَا  جَرِيرٌ ،  عَنْ         [2/325]      مُغِيرَةَ ،  عَنْ  أَبِي وَائِلٍ ، وَالشَّعْبِيِّ ، قَالَا :  قَالَ  جَرِيرٌ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقُلْتُ :  أُبَايِعُكَ  عَلَى السَّمْعِ وَالطَّاعَةِ فِيمَا أَحْبَبْتُ وَكَرِهْتُ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَتَسْتَطِيعُ ذَلِكَ يَا  جَرِيرُ  ؟ أَوْ تُطِيقُ ذَلِكَ  ؟  قُلْ مَا اسْتَطَعْتُ "" ، قَالَ : قُلْتُ : مَا اسْتَطَعْتُ ، قَالَ : فَبَايَعَنِي وَعَلَى النُّصْحِ لِلْمُسْلِمِ .","","Al-Mu'jam al-Kabir 2356","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","مغيرة بن مقسم عن الشعبي"
"2355","2357  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ ،  ثَنَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  عَامِرٍ ، قَالَ : كَانَ جَرِيرٌ  يُحَدِّثُ عَنِ  النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  إِذَا  أَبَقَ  الْعَبْدُ لَمْ تُقْبَلْ لَهُ صَلَاةٌ وَإِنْ مَاتَ مَاتَ كَافِرًا  فَأَبَقَ  غُلَامٌ لِجَرِيرٍ  فَأَخَذَهُ فَضَرَبَ عُنُقَهُ  ، قَالَ أَبُو الْقَاسِمِ : ""  مَعْنَاهُ أَنَّهُ كَفَرَ وَلَحِقَ بِدَارِ الْحَرْبِ  "" .","","Al-Mu'jam al-Kabir 2357","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","مغيرة بن مقسم عن الشعبي"
"2356","فِرَاسُ بْنُ يَحْيَى  عَنِ  الشَّعْبِيِّ  عَنْ  جَرِيرٍ  2358  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  خَالِدٌ ،  عَنِ  الْحَسَنِ بْنِ عُمَارَةَ ،  عَنْ  فِرَاسٍ ،  عَنْ  عَامِرٍ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا أَتَاكُمْ كَرِيمُ قَوْمٍ فَأَكْرِمُوهُ  .","","Al-Mu'jam al-Kabir 2358","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن فراس بن يحيى الخارفي عن الحسن بن عمارة عن خالد بن عبد الله الطحان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","فراس بن يحيى عن الشعبي عن جرير"
"2357","مُجَالِدُ بْنُ سَعِيدٍ  عَنِ  الشَّعْبِيِّ  2359  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ الرَّقِّيُّ  ، ثَنَا  مُعَلَّى بْنُ أَسَدٍ الْعَمِّيُّ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا  أَبَقَ  الْعَبْدُ فَقَدْ بَرِئَتْ مِنْهُ ذِمَّةُ اللهِ وَرَسُولِهِ  .","","Al-Mu'jam al-Kabir 2359","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن مجالد بن سعيد عن عبد الواحد بن زياد عن معلى بن أسد عن حفص بن عمر سنجة ألف عن الطبراني","مجالد بن سعيد عن الشعبي"
"2358","2360  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا  أَبَقَ  الْعَبْدُ فَقَدْ بَرِئَتْ مِنْهُ  الذِّمَّةُ  .","","Al-Mu'jam al-Kabir 2360","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن مجالد بن سعيد عن حماد بن أسامة القرشي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","مجالد بن سعيد عن الشعبي"
"2359","2361  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى ،  عَنْ  مُجَالِدٍ ،  عَنْ  عَامِرٍ         [2/326]      الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِذَا جَاءَكُمُ الْمُصَدِّقُ فَلَا يُفَارِقْكُمْ إِلَّا وَهُوَ رَاضٍ  .","","Al-Mu'jam al-Kabir 2361","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن مجالد بن سعيد عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","مجالد بن سعيد عن الشعبي"
"2360","2362  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَرْجِعِ الْمُصَدِّقُ عَنْكُمْ إِلَّا وَهُوَ رَاضٍ  .","","Al-Mu'jam al-Kabir 2362","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن مجالد بن سعيد عن عبد الله بن المبارك عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","مجالد بن سعيد عن الشعبي"
"2361","عَبْدُ اللهِ بْنُ حَبِيبِ بْنِ أَبِي ثَابِتٍ  عَنِ  الشَّعْبِيِّ  2363  -  حَدَّثَنِي  أَبُو أُسَامَةَ الدَّقَّاقُ الْبَصْرِيُّ  ، ثَنَا  الْعَبَّاسُ بْنُ مُحَمَّدِ بْنِ حَاتِمٍ ،  ثَنَا  سَوْرَةُ بْنُ الْحَكَمِ ،  ثَنَا  عَبْدُ اللهِ بْنُ حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بُنِيَ الْإِسْلَامُ عَلَى خَمْسٍ : شَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَنِّي رَسُولُ اللهِ  ، وَإِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَحَجِّ الْبَيْتِ ، وَصَوْمِ رَمَضَانِ "" .","","Al-Mu'jam al-Kabir 2363","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن عبد الله بن حبيب بن أبي ثابت عن سورة بن الحكم البغدادي عن عباس الدوري عن أبو أسامة الدقاق البصري عن الطبراني","عبد الله بن حبيب بن أبي ثابت عن الشعبي"
"2362","دَاوُدُ بْنُ يَزِيدَ الْأَوْدِيُّ  عَنِ  الشَّعْبِيِّ  عَنْ  جَرِيرٍ  2364  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ الدِّيبَاجِيُّ التُّسْتَرِيُّ  ، حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  دَاوُدُ بْنُ يَزِيدَ الْأَوْدِيُّ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  بُنِيَ الْإِسْلَامُ عَلَى خَمْسٍ : شَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ  ، وَإِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَحَجِّ الْبَيْتِ ، وَصَوْمِ رَمَضَانِ "" .","","Al-Mu'jam al-Kabir 2364","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن داود بن يزيد الزعافري عن عبيد الله بن موسى عن عثمان ابن أبي شيبة عن محمد بن عبد الرحمن الديباجي عن الطبراني","داود بن يزيد الأودي عن الشعبي عن جرير"
"2363","2365  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ  ، ثَنَا  سَلَمَةُ بْنُ شَبِيبٍ ،  ثَنَا  مَكِّيُّ بْنُ إِبْرَاهِيمَ ،  ثَنَا  دَاوُدُ بْنُ يَزِيدَ الْأَوْدِيُّ ،  عَنْ  عَامِرٍ ،  عَنْ  جَرِيرٍ ،  أَنَّهُ أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِيُبَايِعَهُ  فَقَالَ : "" مُدَّ يَدَكَ يَا  جَرِيرُ  "" فَقَالَ : عَلَى مَهْ ؟ قَالَ :  عَلَى أَنْ تُسْلِمَ وَجْهَكَ لِلهِ  وَالنَّصِيحَةِ  لِكُلِّ مُسْلِمٍ  ، فَأَدْرَكَهَا  جَرِيرٌ  وَكَانَ رَجُلًا عَاقِلًا ،         [2/327]      فَقَالَ : يَا رَسُولَ اللهِ : فِيمَا اسْتَطَعْتُ ، فَكَانَتْ رُخْصَةً لِلنَّاسِ بَعْدَهُ .","","Al-Mu'jam al-Kabir 2365","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن داود بن يزيد الزعافري عن مكي بن إبراهيم عن سلمة بن شبيب المسمعي عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","داود بن يزيد الأودي عن الشعبي عن جرير"
"2364","2366  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  الْفَضْلُ بْنُ سَهْلٍ الْأَعْرَجُ ،  ثَنَا  مَكِّيُّ بْنُ إِبْرَاهِيمَ ،  ثَنَا  دَاوُدُ الْأَوْدِيُّ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا  أَبَقَ  الْعَبْدُ فَلَحِقَ بِالْعَدُوِّ فَمَاتَ وَهُوَ كَافِرٌ  .","","Al-Mu'jam al-Kabir 2366","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن داود بن يزيد الزعافري عن مكي بن إبراهيم عن الفضل بن سهل الخراساني عن البزار عن الطبراني","داود بن يزيد الأودي عن الشعبي عن جرير"
"2365","جَابِرِ بْنِ يَزِيدُ الْجُعْفِيِّ  عَنِ  الشَّعْبِيِّ  2367  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلَطِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ،  حَدَّثَنَا  إِسْرَائِيلُ ،  عَنْ  جَابِرٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  ارْضُوا سُعَاتَكُمْ وَمُصَدِّقِيكُمْ  .","","Al-Mu'jam al-Kabir 2367","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن جابر الجعفي عن إسرائيل بن يونس بن أبي إسحاق عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","جابر بن يزيد الجعفي عن الشعبي"
"2366","2368  -  حَدَّثَنَا  الْحَسَنُ بْنُ عُلَيْلٍ الْغَزِّيُّ  ، حَدَّثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  ثَنَا  شَيْبَانُ ،  عَنْ  جَابِرٍ ،  عَنِ  الشَّعْبِيِّ  ، عَنْ  جَرِيرٍ ، قَالَ :  بُنِيَ الْإِسْلَامُ عَلَى خَمْسٍ : شَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَإِقَامِ الصَّلَاةِ  ، وَإِيتَاءِ الزَّكَاةِ ، وَحَجِّ الْبَيْتِ ، وَصِيَامِ رَمَضَانِ "" .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( العنزي )","","Al-Mu'jam al-Kabir 2368","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن جابر الجعفي عن شيبان بن عبد الرحمن المؤدب عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن الحسن بن عليل العنزي عن الطبراني","جابر بن يزيد الجعفي عن الشعبي"
"2367","الْحَسَنُ بْنُ عَمْرٍو الْفُقَيْمِيُّ  عَنِ  الشَّعْبِيِّ  عَنْ  جَرِيرٍ  2369  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عَلِيُّ بْنُ سَبَابَةَ الْكُوفِيُّ  ،  ثَنَا  عَمْرُو بْنُ أَخِي الْحَسَنِ بْنِ عَمْرٍو ،  حَدَّثَنِي  الْحَسَنُ بْنُ عَمْرٍو الْفُقَيْمِيُّ ،  عَنْ  جَرِيرٍ ، قَالَ :  لَمَّا رَآنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَا أُمْسِكُ شَيْئًا إِنَّمَا أَنَا أُنْفِقُهُ قَالَ :  يَا  جَرِيرُ  لَا عَلَيْكَ أَنْ تُمْسِكَ عَلَيْكَ مَالَكَ ، فَإِنَّ لِهَذَا الْأَمْرِ مُدَّةً  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( علي بن شبابة )","","Al-Mu'jam al-Kabir 2369","","جرير بن عبد الله بن جابر يوسف الأمة عن الحسن بن عمرو الفقيمي عن عمرو بن عبد الغفار الفقيمي عن علي بن دوست بن أحمد البلخي عن الحسين بن إسحاق التستري عن الطبراني","الحسن بن عمرو الفقيمي عن الشعبي عن جرير"
"2368","عَبْدُ اللهِ بْنُ أَبِي الْهُذَيْلِ  عَنْ  جَرِيرٍ  2370  -  حَدَّثَنَا  أَبُو زُرْعَةَ الدِّمَشْقِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِنْدَلُ بْنُ عَلِيٍّ ،  عَنْ         [2/328]      جَعْفَرِ بْنِ أَبِي الْمُغِيرَةِ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي الْهُذَيْلِ ،  عَنْ  جَرِيرٍ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : مَا  خَلَصْتُ  مِنَ الْمُشْرِكِينَ إِلَّا  بِقَيْنَةٍ  أُرِيدُ بِهَا السُّوقَ ، وَأَنَا  أَعْزِلُ  عَنْهَا ، قَالَ :  جَاءَهَا مَا قُدِّرَ لَهَا  .","","Al-Mu'jam al-Kabir 2370","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الله بن أبي الهذيل الغنوي عن جعفر بن أبي المغيرة عن مندل بن علي عن الفضل بن دكين عن أبو زرعة الدمشقي عن الطبراني","عبد الله بن أبي الهذيل عن جرير"
"2369","2371  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  يَعْقُوبُ الْقُمِّيُّ ،  عَنْ  جَعْفَرِ بْنِ أَبِي الْمُغِيرَةِ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي الْهُذَيْلِ ،  عَنْ  جَرِيرٍ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ مَا  خَلَصْتُ  مِنَ الْمُشْرِكِينَ إِلَّا  بِقَيْنَةٍ  وَأَنَا  أَعْزِلُ  عَنْهَا أُرِيدُ بِهَا السُّوقَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  جَاءَهَا مَا قُدِّرَ لَهَا  .","","Al-Mu'jam al-Kabir 2371","","جرير بن عبد الله بن جابر يوسف الأمة عن عبد الله بن أبي الهذيل الغنوي عن جعفر بن أبي المغيرة عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","عبد الله بن أبي الهذيل عن جرير"
"2370","مَا رَوَى وَلَدُ  جَرِيرٍ  عَنْ  جَرِيرٍ  مِنْهُمُ  الْمُنْذِرُ بْنُ جَرِيرٍ  عَنْ أَبِيهِ  2372  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ (  ح  )  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ حَبِيبٍ  (  ح  )  وَحَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ، (  ح  )  وَحَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ (  ح  )  وَثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ الْمُنْذِرِ الْقَزَّازُ  ، ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ، قَالُوا :  ثَنَا  شُعْبَةُ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ، قَالَ :  سَمِعْتُ  مُنْذِرَ بْنَ جَرِيرٍ  يُحَدِّثُ ، عَنْ  أَبِيهِ  ، قَالَ :  كُنَّا عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي صَدْرِ النَّهَارِ ، فَجَاءَ نَاسٌ مِنَ الْأَعْرَابِ حُفَاةً عُرَاةً  مُجْتَابِي  النِّمَارِ  عَلَيْهِمُ السُّيُوفُ  وَالْعَبَاءُ  ، فَقُلْتُ : عَامَّتُهُمْ مِنْ  مُضَرَ  بَلْ كُلُّهُمْ مِنْ  مُضَرَ  ، فَرَأَيْتُ وَجْهَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَغَيَّرَ لَمَّا رَأَى بِهِمْ ، فَقَامَ فَدَخَلَ ثُمَّ أَمَرَ  بِلَالًا  فَأَذَّنَ وَأَقَامَ ، ثُمَّ خَرَجَ فَصَلَّى الظُّهْرَ وَخَطَبَ :         {      يَا أَيُّهَا النَّاسُ اتَّقُوا رَبَّكُمُ الَّذِي خَلَقَكُمْ مِنْ نَفْسٍ وَاحِدَةٍ         }      الْآيَةَ قَرَأَهَا إِلَى قَوْلِهِ :         {      وَلْتَنْظُرْ نَفْسٌ مَا قَدَّمَتْ لِغَدٍ         }      تَصَدَّقَ  امْرُؤٌ مِنْ دِرْهَمِهِ ،  تَصَدَّقَ  امْرُؤٌ مِنْ دِينَارِهِ ، مِنْ صَاعِ تَمْرِهِ مِنْ صَاعِ شَعِيرِهِ مِنْ كَذَا مِنْ كَذَا "" ، حَتَّى ذَكَرَ رَسُولُ         [2/329]      اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ شِقَّ تَمْرَةٍ ، فَجَاءَ  رَجُلٌ  بِصُرَّةٍ قَدْ كَادَتْ كَفُّهُ  تَعْجِزُ أَوْ قَدْ عَجَزَتْ  ، قَالَ : وَتَتَابَعَ النَّاسُ حَتَّى رَأَيْتُ  كَوْمَيْنِ  مِنْ طَعَامٍ وَثِيَابٍ ، فَرَأَيْتُ وَجْهَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَتَهَلَّلُ كَأَنَّهُ  مُذْهَبَةٌ ،  فَقَالَ :  مَنْ سَنَّ فِي الْإِسْلَامِ سُنَّةً صَالِحَةً كَانَ لَهُ أَجْرُهَا وَأَجْرُ مَنْ عَمِلَ بِهَا مِنْ بَعْدِهِ إِلَى يَوْمِ الْقِيَامَةِ  لَا يَنْقُصُ مِنْ أُجُورِهِمْ شَيْءٌ ، وَمَنْ سَنَّ فِي الْإِسْلَامِ سُنَّةً سَيِّئَةً كَانَ عَلَيْهِ وِزْرُهَا وَوِزْرُ مَنْ عَمِلَ بِهَا بَعْدَهُ إِلَى يَوْمِ الْقِيَامَةِ لَا يَنْقُصُ مِنْ أَوْزَارِهِمْ شَيْءٌ  .  كذا في طبعة مكتبة ابن تيمية وهو تصحيف صوابه : ( بن حرب وهو بن بجيل ) ولا يروي الكشي عن ابن حبيب. والله أعلم.","","Al-Mu'jam al-Kabir 2372","","جرير بن عبد الله بن جابر يوسف الأمة عن المنذر بن جرير البجلي عن عون بن أبي جحيفة السوائي عن شعبة بن الحجاج عن حفص بن عمر الحوضى عن محمد بن يحيى بن المنذر القزاز عن الطبراني","ما روى ولد جرير عن جرير منهم المنذر بن جرير عن أبيه"
"2371","2373  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ كَيْسَانَ الْمِصِّيصِيُّ ،  ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  سُفْيَانُ  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنِ  الْمُنْذِرِ بْنِ جَرِيرٍ ،  عَنْ  أَبِيهِ  ، قَالَ : كُنَّا عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي صَدْرِ النَّهَارِ ، وَذَكَرَ الْحَدِيثَ بِطُولِهِ .","","Al-Mu'jam al-Kabir 2373","","جرير بن عبد الله بن جابر يوسف الأمة عن المنذر بن جرير البجلي عن عون بن أبي جحيفة السوائي عن سفيان الثوري عن موسى بن مسعود النهدي عن محمد بن الحسن بن كيسان المصيصي عن الطبراني","ما روى ولد جرير عن جرير منهم المنذر بن جرير عن أبيه"
"2372","2374  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ ، وَعَبْدُ اللهِ بْنُ أَحْمَدَ ، وَزَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ، قَالُوا :  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  رَقَبَةَ بْنِ مَصْقَلَةَ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنِ  الْمُنْذِرِ بْنِ جَرِيرٍ ،  عَنْ  جَرِيرٍ  ، قَالَ :  كُنْتُ جَالِسًا عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعْضَ النَّهَارِ إِذْ جَاءَ نَاسٌ وَعَامَّتُهُمْ مِنْ  مُضَرَ  بَلْ كُلُّهُمْ مِنْ  مُضَرَ  ،  مُجْتَابِي  النِّمَارِ  مُتَقَلِّدِي السُّيُوفِ ، فَلَقَدْ رَأَيْتُ وَجْهَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَتَغَيَّرُ لَمَّا رَأَى بِهِمْ مِنَ الضُّرِّ ، ثُمَّ قَالَ : "" يَا  بِلَالُ  عَجِّلِ الصَّلَاةَ "" ، فَلَمَّا صَلَّى قَعَدَ قَعْدَةً ، فَحَمِدَ اللهَ عَزَّ وَجَلَّ وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ :         {      وَاتَّقُوا  اللهَ الَّذِي تَسَاءَلُونَ بِهِ وَالأَرْحَامَ إِنَّ اللهَ كَانَ عَلَيْكُمْ رَقِيبًا         }      رَحِمَ اللهُ رَجُلًا  تَصَدَّقَ  مِنْ دِينَارِهِ وَدِرْهَمِهِ وَصَاعِ تَمْرِهِ  حَتَّى رَدَّ الصَّدَقَةَ إِلَى شِقِّ التَّمْرَةِ ، وَكَانَ مِمَّنْ قَامَ  رَجُلٌ مِنَ الْأَنْصَارِ  بِصُرَّةٍ كَادَتْ كَفُّهُ تَعْجِزُ عَنْهَا ، بَلْ عَجَزَتْ عَنْهَا لَا يُدْرَى أَذَهَبٌ أَمْ فِضَّةٌ ، ثُمَّ تَتَابَعَ النَّاسُ حَتَّى جَمَعُوا  كَوْمَيْنِ  ضَخْمَيْنِ مِنْ طَعَامٍ وَثِيَابٍ ، فَلَقَدْ رَأَيْتُ وَجْهَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَتَهَلَّلُ كَأَنَّهُ  مُذْهَبَةٌ ،  فَلَمَّا انْتَهَتِ الصَّدَقَةُ ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِنَّهُ لَيْسَ أَحَدٌ مِنْ أُمَّتِي يَسْتَنُّ سُنَّةً حَسَنَةً ، فَيُعْمَلُ بِهَا بَعْدَهُ إِلَّا كَانَ لَهُ أَجْرُهُ وَمِثْلُ أَجْرِ الَّذِينَ اسْتَنُّوا بِسُنَّتِهِ مِنْ غَيْرِ أَنْ يَنْقُصَ مِنْ أُجُورِهِمْ شَيْءٌ ، وَمَنْ سَنَّ فِي الْإِسْلَامِ سُنَّةً سَيِّئَةً فَعُمِلَ بِهَا بَعْدَهُ إِلَّا كَانَ عَلَيْهِ وِزْرُهُ وَمِثْلُ أَوْزَارِ الَّذِينَ اسْتَنُّوا بِسُنَّتِهِ مِنْ غَيْرِ أَنْ         [2/330]      يَنْقُصَ مِنْ أَوْزَارِهِمْ شَيْءٌ "" .  في طبعة مكتبة ابن تيمية ( اتقوا ) بدون الواو .","","Al-Mu'jam al-Kabir 2374","","جرير بن عبد الله بن جابر يوسف الأمة عن المنذر بن جرير البجلي عن عون بن أبي جحيفة السوائي عن رقبة بن مصقلة عن الوضاح بن عبد الله اليشكري عن عبد الواحد بن غياث عن أحمد بن عمرو بن حفص القريعي عن الطبراني","ما روى ولد جرير عن جرير منهم المنذر بن جرير عن أبيه"
"2373","2375  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  سَهْلُ بْنُ بَكَّارٍ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنِ  الْمُنْذِرِ بْنِ جَرِيرِ بْنِ عَبْدِ اللهِ الْبَجَلِيِّ ،  عَنْ  أَبِيهِ  ، قَالَ :  كُنْتُ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَتَاهُ قَوْمٌ  مُجْتَابِي  النِّمَارِ  مُتَقَلِّدِي السُّيُوفِ وَلَيْسَ عَلَيْهِمْ أُزُرٌ ، وَلَا شَيْءَ غَيْرَهَا عَامَّتُهُمْ مِنْ  مُضَرَ  بَلْ كُلُّهُمْ مِنْ  مُضَرَ  ، فَلَمَّا رَأَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَا بِهِمْ مِنَ  الْجَهْدِ  وَالْعُرْيِ وَالْجُوعِ تَغَيَّرَ وَجْهُهُ ، وَدَخَلَ بَيْتَهُ ، ثُمَّ رَاحَ إِلَى الْمَسْجِدِ فَصَلَّى الظُّهْرَ ، ثُمَّ صَعِدَ مِنْبَرًا صَغِيرًا فَحَمِدَ اللهَ ، وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ : "" أَمَّا بَعْدُ فَإِنَّ اللهَ عَزَّ وَجَلَّ أَنْزَلَ فِي كِتَابِهِ :         {      يَا أَيُّهَا النَّاسُ اتَّقُوا رَبَّكُمُ الَّذِي خَلَقَكُمْ مِنْ نَفْسٍ وَاحِدَةٍ         }      ، إِلَى آخِرِ الْآيَةِ ،         {      يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللهَ وَلْتَنْظُرْ نَفْسٌ مَا قَدَّمَتْ لِغَدٍ         }      ، إِلَى قَوْلِهِ :         {      هُمُ الْفَائِزُونَ         }      ، تَصَدَّقُوا قَبْلَ أَنْ لَا تَصَدَّقُوا ،  تَصَدَّقَ  رَجُلٌ مِنْ دِينَارِهِ ،  تَصَدَّقَ  رَجُلٌ مِنْ دِرْهَمِهِ ،  تَصَدَّقَ  رَجُلٌ مِنْ بُرِّهِ ،  تَصَدَّقَ  رَجُلٌ مِنْ تَمْرِهِ ، مِنْ شَعِيرِهِ ، لَا تَحْقِرَنَّ شَيْئًا مِنَ الصَّدَقَةِ ، وَلَوْ  بِشِقِّ  تَمْرَةٍ "" ، فَقَامَ  رَجُلٌ مِنَ الْأَنْصَارِ  فِي كَفِّهِ صُرَّةٌ ، فَنَاوَلَهَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ عَلَى الْمِنْبَرِ ، فَقَبَضَهَا فَعُرِفَ السُّرُورُ فِي وَجْهِهِ ثُمَّ قَالَ :  مَنْ سَنَّ سُنَّةً حَسَنَةً فَعُمِلَ بِهَا كَانَ لَهُ أَجْرُهَا وَمِثْلُ أَجْرِ مَنْ عَمِلَ بِهَا  لَا يَنْقُصُ مِنْ أُجُورِهِمْ شَيْءٌ ، وَمَنْ سَنَّ سُنَّةً سَيِّئَةً فَعُمِلَ بِهَا كَانَ عَلَيْهِ وِزْرُهَا وَوِزْرُ مَنْ عَمِلَ بِهَا بَعْدَهُ لَا يَنْقُصُ مِنْ أَوْزَارِهِمْ شَيْءٌ "" ، فَقَامَ النَّاسُ فَتَفَرَّقُوا فَمِنْ ذَا دِينَارٌ ، وَمِنْ ذَا دِرْهَمٌ فَاجْتَمَعَ فَقَسَمَهُ بَيْنَهُمْ .","","Al-Mu'jam al-Kabir 2375","","جرير بن عبد الله بن جابر يوسف الأمة عن المنذر بن جرير البجلي عن عبد الملك بن عمير القبطي عن الوضاح بن عبد الله اليشكري عن سهل بن بكار الدارمي عن أبو مسلم الكجي عن الطبراني","ما روى ولد جرير عن جرير منهم المنذر بن جرير عن أبيه"
"2374","2376  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى ،  عَنْ  أَبِي حَيَّانَ التَّيْمِيِّ ،  ثَنَا  الضَّحَّاكُ ، خَالُ الْمُنْذِرِ بْنِ جَرِيرٍ ،  عَنِ  الْمُنْذِرِ بْنِ جَرِيرٍ ،  عَنْ  جَرِيرٍ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا يُؤْوِي الضَّالَّةَ إِلَّا ضَالٌّ  .","","Al-Mu'jam al-Kabir 2376","","جرير بن عبد الله بن جابر يوسف الأمة عن المنذر بن جرير البجلي عن الضحاك بن المنذر البجلي عن يحيى بن سعيد التيمي عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","ما روى ولد جرير عن جرير منهم المنذر بن جرير عن أبيه"
"2375","2377  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  شِهَابُ بْنُ عَبَّادٍ الْعَبْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  أَبِي حَيَّانَ التَّيْمِيِّ ،  ثَنَا  الضَّحَّاكُ بْنُ الْمُنْذِرِ ،  عَنْ  مُنْذِرِ بْنِ جَرِيرٍ قَالَ :  كُنْتُ مَعَ أَبِي  بِالْبَوَازِيجِ  فَرَاحَتِ الْبَقَرُ فَرَأَى بَقَرَةً أَنْكَرَهَا ، فَقَالَ         [2/331]      لِلرَّاعِي  : مَا هَذِهِ ؟ قَالُوا : هَذِهِ بَقَرَةٌ لَحِقَتْ بِالْبَقَرِ لَا يُدْرَى لِمَنْ هِي ، فَأَمَرَ بِهَا ، فَطُرِدَتْ حَتَّى تَوَارَتْ عَنْهُ ثُمَّ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا يُؤْوِي الضَّالَّةَ إِلَّا ضَالٌّ  .","","Al-Mu'jam al-Kabir 2377","","جرير بن عبد الله بن جابر يوسف الأمة عن المنذر بن جرير البجلي عن الضحاك بن المنذر البجلي عن يحيى بن سعيد التيمي عن عبد الله بن نمير عن شهاب بن عباد الرواس عن محمد بن أحمد بن النضر النضري عن الطبراني","ما روى ولد جرير عن جرير منهم المنذر بن جرير عن أبيه"
"2376","2378  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  ابْنُ الْمُبَارَكِ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَعْلَى بْنُ عُبَيْدٍ ، جَمِيعًا  عَنْ  أَبِي حَيَّانَ التَّيْمِيِّ ،  عَنِ  الضَّحَّاكِ بْنِ الْمُنْذِرِ ،  عَنِ  الْمُنْذِرِ بْنِ جَرِيرٍ ،  عَنْ  جَرِيرٍ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2378","","جرير بن عبد الله بن جابر يوسف الأمة عن المنذر بن جرير البجلي عن الضحاك بن المنذر البجلي عن يحيى بن سعيد التيمي عن يعلى بن عبيد الطنافسي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","ما روى ولد جرير عن جرير منهم المنذر بن جرير عن أبيه"
"2377","2379  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ  ، ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  شَرِيكٌ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَيْثَمَةَ  ، ثَنَا  الْفَضْلُ بْنُ سَهْلٍ الْأَعْرَجُ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْمُنْذِرِ بْنِ جَرِيرٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا مِنْ قَوْمٍ يُعْمَلُ بَيْنَ أَظْهُرِهِمْ بِالْمَعَاصِي هُمْ أَعَزُّ مِنْهُمْ  وَأَمْنَعُ لَمْ يُغَيِّرُوا إِلَّا أَصَابَهُمُ اللهُ مِنْهُ بِعِقَابٍ "" .","","Al-Mu'jam al-Kabir 2379","","جرير بن عبد الله بن جابر يوسف الأمة عن المنذر بن جرير البجلي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن يزيد بن هارون عن الفضل بن سهل الخراساني عن محمد بن أحمد بن أبي خيثمة النسائي عن الطبراني","ما روى ولد جرير عن جرير منهم المنذر بن جرير عن أبيه"
"2378","عُبَيْدُ اللهِ بْنُ جَرِيرٍ  عَنْ أَبِيهِ  2380  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ جَرِيرٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا مِنْ قَوْمٍ يَكُونُ بَيْنَ أَظْهُرِهِمْ رَجُلٌ يَعْمَلُ بِالْمَعَاصِي هُمْ أَمْنَعُ مِنْهُ  ، وَأَعَزُّ لَا يُغَيِّرُونَ عَلَيْهِ إِلَّا أَصَابَهُمُ اللهُ بِعِقَابٍ "" .","","Al-Mu'jam al-Kabir 2380","","جرير بن عبد الله بن جابر يوسف الأمة عن عبيد الله بن جرير بن عبد الله البجلي عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عبيد الله بن جرير عن أبيه"
"2379","2381  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ         [2/332]      جَعْفَرٍ  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ جَرِيرٍ ،  عَنْ  أَبِيهِ  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا مِنْ قَوْمٍ يُعْمَلُ بَيْنَهُمْ بِالْمَعَاصِي هُمْ أَعَزُّ  ، وَأَكْثَرُ مِمَّنْ يَعْمَلُهُ لَمْ يُغَيِّرُوا إِلَّا أَصَابَهُمُ اللهُ بِعِقَابِهِ "" .","","Al-Mu'jam al-Kabir 2381","","جرير بن عبد الله بن جابر يوسف الأمة عن عبيد الله بن جرير بن عبد الله البجلي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عبيد الله بن جرير عن أبيه"
"2380","2382  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، وَأَبُو خَلِيفَةَ ، قَالَا :  ثَنَا  أَبُو الْوَلِيدِ ، (  ح  ) ،  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ، قَالَا :  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ جَرِيرٍ ،  عَنْ  أَبِيهِ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَا مِنْ رَجُلٍ يَكُونُ فِي قَوْمٍ يَعْمَلُ فِيهِمْ بِالْمَعَاصِي  يَقْدِرُونَ أَنْ يُغَيِّرُوا عَلَيْهِ وَلَا يُغَيِّرُونَ إِلَّا أَصَابَهُمُ اللهُ بِعِقَابٍ قَبْلَ أَنْ يَمُوتُوا  .","","Al-Mu'jam al-Kabir 2382","","جرير بن عبد الله بن جابر يوسف الأمة عن عبيد الله بن جرير بن عبد الله البجلي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عبيد الله بن جرير عن أبيه"
"2381","2383  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ جَرِيرٍ ،  عَنْ  أَبِيهِ ،  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ قَوْمٍ يَكُونُ فِيهِمْ رَجُلٌ يَعْمَلُ بِالْمَعَاصِي  يَقْدِرُونَ أَنْ يُغَيِّرُوا عَلَيْهِ فَلَا يُغَيِّرُونَ إِلَّا عَمَّهُمُ اللهُ بِعِقَابٍ قَبْلَ أَنْ يَمُوتُوا "" .","","Al-Mu'jam al-Kabir 2383","","جرير بن عبد الله بن جابر يوسف الأمة عن عبيد الله بن جرير بن عبد الله البجلي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","عبيد الله بن جرير عن أبيه"
"2382","2384  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  ابْنُ الْأَصْبَهَانِيِّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِيُّ ،  عَنْ  عَبْدِ الْمَجِيدِ بْنِ أَبِي جَعْفَرٍ الْفَرَّاءِ  ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ جَرِيرٍ ،  عَنْ  أَبِيهِ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَا مِنْ رَجُلٍ يُجَاوِرُ قَوْمًا فَيَعْمَلُ بَيْنَ  ظَهْرَانَيْهِمْ  بِالْمَعَاصِي  وَلَا يَأْخُذُونَ عَلَى يَدَيْهِ إِلَّا أَوْشَكَ أَنْ يَعُمَّهُمُ اللهُ مِنْهُ بِعِقَابٍ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عبد الحميد )","","Al-Mu'jam al-Kabir 2384","","جرير بن عبد الله بن جابر يوسف الأمة عن عبيد الله بن جرير بن عبد الله البجلي عن أبو إسحاق السبيعي عن عبد الحميد بن أبي جعفر الفراء عن عبد الرحمن بن محمد المحاربي عن محمد بن سعيد حمدان عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبيد الله بن جرير عن أبيه"
"2383","2385  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  الْأَزْرَقُ بْنُ عَلِيٍّ ،  ثَنَا  حَسَّانُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  يُوسُفُ بْنُ أَبِي إِسْحَاقَ ،  عَنْ  أَبِي إِسْحَاقَ  عَنْ  عُبَيْدِ اللهِ بْنِ جَرِيرٍ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ قَوْمٍ يَكُونُ فِيهِمْ مَنْ يَعْمَلُ بِالْمَعَاصِي هُمْ أَكْثَرُ مِنْهُ وَأَعَزُّ  فَيَدْهُنُونَ وَيَسْكُتُونَ فَلَا يُغَيِّرُونَ إِلَّا أَصَابَتْهُمْ فِيهِ عُقُوبَةٌ "" .","","Al-Mu'jam al-Kabir 2385","","جرير بن عبد الله بن جابر يوسف الأمة عن عبيد الله بن جرير بن عبد الله البجلي عن أبو إسحاق السبيعي عن يوسف بن إسحاق بن أبي إسحاق السبيعي عن حسان بن إبراهيم الكرماني عن الأزرق بن علي بن مسلم الحنفي عن عبد الله بن أحمد بن حنبل عن الطبراني","عبيد الله بن جرير عن أبيه"
"2384","2386  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  مَعْمَرُ بْنُ سَهْلٍ ،  ثَنَا  عَامِرُ بْنُ مُدْرِكٍ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ اللهِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ جَرِيرٍ ،  عَنْ         [2/333]      جَرِيرٍ  ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَاقِفًا  بِعَرَفَةَ  مُتَأَبِّطًا رِدَاءَهُ  رَافِعًا يَدَيْهِ لَا يُجَاوِزَانِ رَأْسَهُ ،  وَعَضَلَتَاهُ  تُرْعَدَانِ "" .","","Al-Mu'jam al-Kabir 2386","","جرير بن عبد الله بن جابر يوسف الأمة عن عبيد الله بن جرير بن عبد الله البجلي عن أبو إسحاق السبيعي عن محمد بن عبيد الله بن أبي سليمان العرزمي عن عامر بن مدرك بن أبي الصفيراء الحارثي عن معمر بن سهل بن معمر الأهوازي عن أحمد بن يحيى بن زهير التستري عن الطبراني","عبيد الله بن جرير عن أبيه"
"2385","2387  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  يَحْيَى بْنُ آدَمَ  عَنْ  إِسْمَاعِيلَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ جَرِيرٍ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَمْ يَرْحَمِ النَّاسَ لَمْ يَرْحَمْهُ اللهُ  .","","Al-Mu'jam al-Kabir 2387","","جرير بن عبد الله بن جابر يوسف الأمة عن عبيد الله بن جرير بن عبد الله البجلي عن أبو إسحاق السبيعي عن إسماعيل بن أبي خالد عن يحيى بن آدم عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عبيد الله بن جرير عن أبيه"
"2386","2388  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْكُوفِيُّ ،  ثَنَا  حُسَيْنُ بْنُ عَلِيٍّ الْجُعْفِيُّ ،  عَنْ  زَائِدَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ جَرِيرٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ لَا يَرْحَمْ لَا يُرْحَمْ  .","","Al-Mu'jam al-Kabir 2388","","جرير بن عبد الله بن جابر يوسف الأمة عن عبيد الله بن جرير بن عبد الله البجلي عن يزيد بن أبي زياد القرشي عن زائدة بن قدامة عن الحسين بن علي الجعفي عن محمد بن يحيى بن الضريس الفيدي عن البزار عن الطبراني","عبيد الله بن جرير عن أبيه"
"2387","2389  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  عَبْدُ الْوَارِثِ بْنُ عَبْدِ الصَّمَدِ بْنِ عَبْدِ الْوَارِثِ ،  ثَنَا  أَبِي  ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ  عَنْ  عُبَيْدِ اللهِ بْنِ جَرِيرٍ ،  عَنْ  أَبِيهِ  ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ اللهَ لَا يَرْحَمُ مَنْ لَا يَرْحَمُ النَّاسَ  .","","Al-Mu'jam al-Kabir 2389","","جرير بن عبد الله بن جابر يوسف الأمة عن عبيد الله بن جرير بن عبد الله البجلي عن عبد الملك بن عمير القبطي عن حماد بن سلمة عن عبد الصمد بن عبد الوارث التنوري عن عبد الوارث بن عبد الصمد التنوري عن البزار عن الطبراني","عبيد الله بن جرير عن أبيه"
"2388","2390  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ جَرِيرٍ ،  عَنْ  أَبِيهِ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ اللهَ عَزَّ وَجَلَّ لَا يَرْحَمُ مَنْ لَا يَرْحَمُ النَّاسَ  .","","Al-Mu'jam al-Kabir 2390","","جرير بن عبد الله بن جابر يوسف الأمة عن عبيد الله بن جرير بن عبد الله البجلي عن عبد الملك بن عمير القبطي عن حماد بن سلمة عن هدبة بن خالد عن عبد الله بن أحمد بن حنبل عن الطبراني","عبيد الله بن جرير عن أبيه"
"2389","إِسْمَاعِيلُ بْنُ جَرِيرٍ  عَنْ أَبِيهِ  2391  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  سَعِيدُ بْنُ يَحْيَى اللَّخْمِيُّ ،  عَنِ  الْحَسَنِ الْبَجَلِيِّ وَهُوَ ابْنُ عُمَارَةَ ،  عَنِ  الْحَكَمِ بْنِ عُتَيْبَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ جَرِيرٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ صَامَ مِنَ  الشَّهْرِ  ثَلَاثَةَ أَيَّامٍ  ، فَلْيَصُمِ اللَّيَالِيَ  الْبِيضَ  ثَلَاثَ عَشْرَةَ ، وَأَرْبَعَ عَشْرَةَ ، وَخَمْسَ عَشْرَةَ "" .","","Al-Mu'jam al-Kabir 2391","","جرير بن عبد الله بن جابر يوسف الأمة عن إسماعيل بن جرير عن الحكم بن عتيبة بن النهاس العجلي عن الحسن بن عمارة عن سعيد بن يحيى سعدان عن هشام بن عمار عن عبد الله بن أحمد الجواليقي عن الطبراني","إسماعيل بن جرير عن أبيه"
"2390","[2/334]      إِبْرَاهِيمُ بْنُ جَرِيرٍ  عَنْ أَبِيهِ  2392  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ، (  ح  )  وَحَدَّثَنَا  فُضَيْلُ بْنُ أَحْمَدَ الْمَلَطِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  أَبَانُ بْنُ عَبْدِ اللهِ الْبَجَلِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ جَرِيرٍ ،  عَنْ  جَرِيرٍ  ، قَالَ :  بَعَثَ إِلَيَّ  عَلِيُّ بْنُ أَبِي طَالِبٍ  ابْنَ عَبَّاسٍ  ،  وَالْأَشْعَثَ بْنَ قَيْسٍ  ، وَأَنَا  بِقِرْقِيسِيَا  ، فَقَالَا : إِنَّ أَمِيرَ الْمُؤْمِنِينَ  يُقْرِئُكَ  السَّلَامَ ، وَيَقُولُ : نِعْمَ مَا أَرَاكَ اللهُ مِنْ مُفَارَقَتِكَ  مُعَاوِيَةَ  وَإِنِّي أُنْزِلُكَ مِنِّي بِمَنْزِلَةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الَّتِي أَنْزَلَكَهَا ، فَقَالَ  جَرِيرٌ  :  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعَثَنِي إِلَى  الْيَمَنِ  أُقَاتِلُهُمْ وَأَدْعُوهُمْ أَنْ يَقُولُوا لَا إِلَهَ إِلَّا اللهُ  ، فَإِذَا قَالُوهَا حَرُمَتْ دِمَاؤُهُمْ وَأَمْوَالُهُمْ ، وَلَا أُقَاتِلُ أَحَدًا يَقُولُ : لَا إِلَهَ إِلَّا اللهُ "" فَرَجَعْنَا عَلَى ذَلِكَ .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( فضيل بن محمد )","","Al-Mu'jam al-Kabir 2392","","جرير بن عبد الله بن جابر يوسف الأمة عن إبراهيم بن جرير البجلي عن أبان بن عبد الله بن أبي حازم عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","إبراهيم بن جرير عن أبيه"
"2391","2393  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  أَبَانُ بْنُ عَبْدِ اللهِ الْبَجَلِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ جَرِيرٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ دَخَلَ  الْغَيْضَةَ  فَقَضَى حَاجَتَهُ فَأَتَاهُ  جَرِيرٌ  بِإِدَاوَةٍ  مِنْ مَاءٍ فَاسْتَنْجَى ، وَمَسَحَ يَدَهُ بِالتُّرَابِ ، ثُمَّ غَسَلَ وَجْهَهُ وَذِرَاعَيْهِ ، وَمَسَحَ عَلَى رَأْسِهِ ، وَعَلَى خُفَّيْهِ ، فَقُلْتُ : يَا نَبِيَّ اللهِ قَدَمَيْكَ قَالَ :  إِنِّي أَدْخَلْتُهُمَا طَاهِرَتَيْنِ  .","","Al-Mu'jam al-Kabir 2393","","جرير بن عبد الله بن جابر يوسف الأمة عن إبراهيم بن جرير البجلي عن أبان بن عبد الله بن أبي حازم عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","إبراهيم بن جرير عن أبيه"
"2392","2394  -  حَدَّثَنَا  سَعِيدُ بْنُ سَيَّارٍ الْوَاسِطِيُّ  ، ثَنَا  عَمْرُو بْنُ عَوْنٍ ،  أَنَا  حَفْصُ بْنُ سُلَيْمَانَ ،  عَنْ  قَيْسِ بْنِ مُسْلِمٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ جَرِيرِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ ، وَمَسَحَ عَلَى خُفَّيْهِ  ، وَلَا يَنْزِعُهُمَا ثُمَّ يُصَلِّي فِيهِمَا "" .","","Al-Mu'jam al-Kabir 2394","","جرير بن عبد الله بن جابر يوسف الأمة عن إبراهيم بن جرير البجلي عن قيس بن مسلم الجدلي عن حفيص الأسدي عن عمرو بن عون الواسطي عن سعيد بن سيار الواسطي عن الطبراني","إبراهيم بن جرير عن أبيه"
"2393","2395  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  الْأَسْوَدُ بْنُ شَيْبَانَ ،  ثَنَا  زِيَادُ بْنُ أَبِي سُفْيَانَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ جَرِيرٍ الْبَجَلِيُّ ،  عَنْ  أَبِيهِ  ، قَالَ  : غَدَا  أَبُو عَبْدِ اللهِ  إِلَى  الْكُنَاسَةِ  لِيَبْتَاعَ مِنْهَا دَابَّةً ، وَغَدَا مَوْلًى لَهُ فَوَقَفَ فِي         [2/335]      نَاحِيَةِ السُّوقِ ، فَجَعَلَتِ الدَّوَابُّ تَمُرُّ عَلَيْهِ ، فَمَرَّ بِهِ فَرَسٌ فَأَعْجَبَهُ ، فَقَالَ لِمَوْلَاهُ : انْطَلِقْ فَاشْتَرِ ذَلِكَ الْفَرَسَ ، فَانْطَلَقَ مَوْلَاهُ ، فَأَعْطَى صَاحِبَهُ بِهِ ثَلَاثَمِائَةِ دِرْهَمٍ ، فَأَبَى صَاحِبُهُ أَنْ يَبِيعَهُ فَمَاكَسَهُ ، فَأَبَى صَاحِبُهُ أَنْ يَبِيعَهُ ، فَقَالَ : هَلْ لَكَ أَنْ تَنْطَلِقَ إِلَى صَاحِبٍ لَنَا نَاحِيَةَ السُّوقِ ؟ قَالَ : لَا  أُبَالِي  فَانْطَلَقَا إِلَيْهِ ، فَقَالَ لَهُ مَوْلَاهُ : إِنِّي أَعْطَيْتُ هَذَا بِفَرَسِهِ ثَلَاثَمِائَةِ دِرْهَمٍ فَأَبَى ، وَذَكَرَ أَنَّهُ خَيْرٌ مِنْ ذَلِكَ ، قَالَ  صَاحِبُ الْفَرَسِ  : صَدَقَ أَصْلَحَكَ اللهُ فَتَرَى ذَلِكَ ثَمَنًا ، قَالَ : لَا ، فَرَسُكَ خَيْرٌ مِنْ ذَلِكَ ، تَبِيعُهُ بِخَمْسِمِائَةٍ حَتَّى بَلَغَ  سَبْعَمِائَةِ دِرْهَمٍ أَوْ ثَمَانَمِائَةٍ  ، فَلَمَّا أَنْ ذَهَبَ الرَّجُلُ أَقْبَلَ عَلَى مَوْلَاهُ ، فَقَالَ لَهُ : وَيْحَكَ انْطَلَقْتَ لِتَبْتَاعَ لِي دَابَّةً ، فَأَعْجَبَتْنِي دَابَّةُ رَجُلٍ ، فَأَرْسَلْتُكَ تَشْتَرِيهَا ، فَجِئْتَ  بِرَجُلٍ  مِنَ الْمُسْلِمِينَ يَقُودُهُ وَهُوَ يَقُولُ : مَا تَرَى مَا تَرَى ؟ وَقَدْ  بَايَعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى النُّصْحِ لِكُلِّ مُسْلِمٍ  .","","Al-Mu'jam al-Kabir 2395","","جرير بن عبد الله بن جابر يوسف الأمة عن إبراهيم بن جرير البجلي عن زياد بن أبي سفيان عن الأسود بن شيبان السدوسي عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","إبراهيم بن جرير عن أبيه"
"2394","2396  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  دَاوُدُ بْنُ عَبْدِ الْجَبَّارِ ،  ثَنَا  إِبْرَاهِيمُ بْنُ جَرِيرٍ ،  عَنْ  جَرِيرٍ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اقْتُلُوا الْحَيَّاتِ كُلَّهَا  ، مَنْ تَرَكَهَا خَشْيَةَ ثَأْرِهَا فَلَيْسَ مِنَّا "" .","","Al-Mu'jam al-Kabir 2396","","جرير بن عبد الله بن جابر يوسف الأمة عن إبراهيم بن جرير البجلي عن داود بن عبد الجبار الأودي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","إبراهيم بن جرير عن أبيه"
"2395","خَالِدُ بْنُ جَرِيرٍ  عَنْ أَبِيهِ  2397  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ الْأَصْبَهَانِيُّ  ، ثَنَا  عَبْدُ السَّلَامِ بْنُ عَاصِمٍ الرَّازِيُّ ،  ثَنَا  الصَّبَّاحُ بْنُ مُحَارِبٍ ،  ثَنَا  دَاوُدُ الْأَوْدِيُّ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  خَالِدِ بْنِ جَرِيرٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ  شَرِبَ  الْخَمْرَ فَاجْلِدُوهُ  ، فَإِنْ عَادَ فَاجْلِدُوهُ ، فَإِنْ عَادَ فَاجْلِدُوهُ ، فَإِنْ عَادَ الرَّابِعَةَ  فَاقْتُلُوهُ  "" .","","Al-Mu'jam al-Kabir 2397","","جرير بن عبد الله بن جابر يوسف الأمة عن خالد بن جرير بن عبد الله البجلي عن سماك بن حرب البكري عن داود بن يزيد الزعافري عن صباح بن محارب التيمي عن عبد السلام بن عاصم الهسنجاني عن محمد بن شعيب التاجر عن الطبراني","خالد بن جرير عن أبيه"
"2396","2398  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،         [2/336]      ثَنَا  مَكِّيُّ بْنُ إِبْرَاهِيمَ ،  ثَنَا  دَاوُدُ الْأَوْدِيُّ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  خَالِدِ بْنِ جَرِيرٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 2398","","جرير بن عبد الله بن جابر يوسف الأمة عن خالد بن جرير بن عبد الله البجلي عن سماك بن حرب البكري عن داود بن يزيد الزعافري عن مكي بن إبراهيم عن أبو موسى الزمن عن محمد بن صالح النرسي عن الطبراني","خالد بن جرير عن أبيه"
"2397","2399  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  أَبُو بَكْرٍ الْحَنَفِيُّ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ الْأَنْصَارِيُّ ،  عَنْ  أَيُّوبَ بْنِ جَرِيرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَدِّهِ  ، قَالَ :  سَأَلْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الْمَسْحِ عَلَى الْخُفَّيْنِ ، فَقَالَ :  ثَلَاثَةُ أَيَّامٍ لِلْمُسَافِرِ ، وَيَوْمٌ وَلَيْلَةٌ لِلْمُقِيمِ  .  كذا في طبعة مكتبة ابن تيمية والنسخ الخطية ، ولعل الصواب : ( عن أبيه جرير ) كما في الأوسط ومجمع البحرين ، وينظر ترجمة أيوب في الجرح والتعديل ، والله أعلم  كذا في طبعة مكتبة ابن تيمية والنسخ الخطية ، ولعل الصواب : ( عن أبيه جرير ) كما في الأوسط ومجمع البحرين ، وينظر ترجمة أيوب في الجرح والتعديل ، والله أعلم","","Al-Mu'jam al-Kabir 2399","","أحد الصحابة عن جرير بن عبد الله بن جابر يوسف الأمة عن أيوب بن جرير البجلي عن عبد الحميد بن جعفر الأوسي عن عبد الكبير بن عبد المجيد الحنفي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","خالد بن جرير عن أبيه"
"2398","عَبْدُ اللهِ بْنُ جَرِيرٍ  عَنْ أَبِيهِ  2400  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  الْفَضْلُ بْنُ سَهْلٍ الْأَعْرَجُ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ الْعِجْلِيُّ ،  ثَنَا  نَاصِحٌ أَبُو الْعَلَاءِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَرِيرٍ ،  عَنْ  أَبِيهِ  :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 2400","","جرير بن عبد الله بن جابر يوسف الأمة عن عبيد الله بن جرير بن عبد الله البجلي عن سماك بن حرب البكري عن ناصح بن عبد الله المحلمي عن عبد الله بن صالح العجلي عن الفضل بن سهل الخراساني عن البزار عن الطبراني","عبد الله بن جرير عن أبيه"
"2399","أَبُو زُرْعَةَ بْنُ عَمْرِو بْنِ جَرِيرٍ  عَنْ جَدِّهِ  2401  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  بُكَيْرُ بْنُ عَامِرٍ ،  عَنْ  أَبِي زُرْعَةَ ، قَالَ :  بَالَ جَرِيرٌ ، وَمَسَحَ عَلَى الْخُفَّيْنِ فَعَابَ عَلَيْهِ قَوْمٌ ، فَقَالُوا : إِنَّ هَذَا كَانَ قَبْلَ الْمَائِدَةِ ، قَالَ : "" مَا أَسْلَمْتُ إِلَّا بَعْدَمَا أُنْزِلَتِ الْمَائِدَةُ ،  وَمَا رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَمْسَحُ إِلَّا بَعْدَمَا نَزَلَتْ  .","","Al-Mu'jam al-Kabir 2401","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو زرعة بن عمرو بن جرير الغلابي عن بكير بن عامر البجلي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو زرعة بن عمرو بن جرير عن جده"
"2400","2402  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، (  ح  )  وَحَدَّثَنَا  أَبُو خَلِيفَةَ  ، حَدَّثَنَا  أَبُو الْوَلِيدِ ، قَالَا :  ثَنَا  شُعْبَةُ ،  عَنْ  عَلِيِّ بْنِ مُدْرِكٍ ، قَالَ :  سَمِعْتُ  أَبَا زُرْعَةَ بْنَ عَمْرِو بْنِ جَرِيرٍ ،  عَنْ  جَدِّهِ جَرِيرٍ قَالَ :  قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  حَجَّةِ الْوَدَاعِ  : "" اسْتَنْصِتِ النَّاسَ "" ، ثُمَّ قَالَ :  لَا تَرْجِعُوا بَعْدِي  كُفَّارًا         [2/337]      يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ  .","","Al-Mu'jam al-Kabir 2402","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو زرعة بن عمرو بن جرير الغلابي عن علي بن مدرك الوهبيلي عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","أبو زرعة بن عمرو بن جرير عن جده"
