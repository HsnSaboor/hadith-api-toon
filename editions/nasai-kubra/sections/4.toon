hadiths[165]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"496","أَخْبَرَنَا عَلِيُّ بْنُ حُجْرٍ ، قَالَ : أنبا عَلِيُّ بْنُ مُسْهِرٍ ، عَنْ سُفْيَانَ ، عَنْ سُهَيْلِ بْنِ أَبِي صَالِحٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ كَانَ مُصَلِّيًا بَعْدَ الْجُمُعَةِ فَلْيُصَلِّ أَرْبَعًا """"""","","Sunan al-Kubra al-Nasai 496","","أَخْبَرَنَا إِبْرَاهِيمُ بْنُ مُحَمَّدٍ قَالَ حَدَّثَنَا يَحْيَى عَنْ سُفْيَانَ عَنْ زُبَيْدٍ عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى قَالَ","The Book of Prayer"
"497","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أنبا سُفْيَانُ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنْ أَبِيهِ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يُصَلِّي بَعْدَ الْجُمُعَةِ رَكْعَتَيْنِ """"""","Sahih|Sahih|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 497","","أَخْبَرَنَا عَبْدُ اللهِ بْنُ سَعِيدٍ الْأَشَجُّ قَالَ حَدَّثَنَا ابْنُ إِدْرِيسَ قَالَ أَخْبَرَنَا شُعْبَةُ عَنْ عَدِيٍّ عَنْ سَعِيدِ بْنِ جُبَيْرٍ عَنِ ابْنِ عَبَّاسٍ","The Book of Prayer"
"498","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا اللَّيْثُ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّهُ كَانَ إِذَا صَلَّى الْجُمُعَةَ انْصَرَفَ فَصَلَّى سَجْدَتَيْنِ فِي بَيْتِهِ ، ثُمَّ قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَصْنَعُ ذَلِكَ """"""","","Sunan al-Kubra al-Nasai 498","","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ قَالَ حَدَّثَنَا يَحْيَى قَالَ حَدَّثَنَا شُعْبَةُ عَنْ عَدِيَّ بْنِ ثَابِتٍ عَنْ سَعِيدِ بْنِ جُبَيْرٍ عَنِ ابْنِ عَبَّاسٍ","The Book of Prayer"
"499","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ ، عَنْ عَبَّادِ بْنِ تَمِيمٍ ، عَنْ عَمِّهِ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ اسْتَسْقَى ، وَصَلَّى رَكْعَتَيْنِ ، وَقَلَبَ رِدَاءَهُ """"""","","Sunan al-Kubra al-Nasai 499","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا اللَّيْثُ بْنُ سَعْدٍ عَنْ أَبِي الزُّبَيْرِ عَنْ جَابِرٍ قَالَ","The Book of Prayer"
"500","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا يَزِيدُ يَعْنِي بْنَ زُرَيْعٍ ، قَالَ : حَدَّثَنَا يُونُسُ ، عَنِ الْحَسَنِ ، عَنْ أَبِي بَكْرَةَ ، قَالَ :  كُنَّا عِنْدَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَفَانْكَسَفَتِ الشَّمْسُ ، فَقَامَ إِلَى الْمَسْجِدِ يَجُرُّ رِدَاءَهُ مِنَ الْعَجَلَةِ ، فَقَامَ إِلَيْهِ النَّاسُ فَصَلَّى رَكْعَتَيْنِ كَمَا تُصَلُّونَ """"""","","Sunan al-Kubra al-Nasai 500","","أَخْبَرَنَا عِمْرَانُ بْنُ مُوسَى قَالَ حَدَّثَنَا يَزِيدُ بْنُ زُرَيْعٍ قَالَ حَدَّثَنَا سُفْيَانُ بْنُ سَعِيدٍ عَنْ زُبَيْدٍ الْيَامِيِّ عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى أَنَّهُ ذَكَرُهُ عَنْ عُمَرَ بْنِ الْخَطَّابِ قَالَ","The Book of Prayer"
"501","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أنبا الْوَلِيدُ بْنُ مُسْلِمٍ ، عَنِ الأَوْزَاعِيِّ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، قَالَتْ : كَسَفَتِ الشَّمْسُ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَنُودِيَ الصَّلاةُ جَامِعَةٌ ، فَاجْتَمَعَ النَّاسُ ، فَصَلَّى بِهِمْ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَرْبَعَ رَكَعَاتٍ فِي رَكْعَتَيْنِ ، وَأَرْبَعَ سَجَدَاتٍ """"""","","Sunan al-Kubra al-Nasai 501","","أَخْبَرَنَا عَلِيُّ بْنُ حُجْرٍ قَالَ أَخْبَرَنَا عَلِيُّ بْنُ مُسْهِرٍ عَنْ سُفْيَانَ عَنْ سُهَيْلِ بْنِ أَبِي صَالِحٍ عَنْ أَبِيهِ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Prayer"
"502","أَخْبَرَنَا عَبْدَةُ بْنُ عَبْدِ الرَّحِيمِ ، قَالَ : أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ عَمْرَةَ ، عَنْ عَائِشَةَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى فِي كُسُوفٍ فِي صِفَةِ زَمْزَمَ أَرْبَعَ رَكَعَاتٍ فِي أَرْبَعِ سَجَدَاتٍ ""، خَالَفَهُمَا عُبَيْدُ بْنُ عُمَيْرٍ""","","Sunan al-Kubra al-Nasai 502","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ أَخْبَرَنَا سُفْيَانُ عَنْ عَمْرِو بْنِ دِينَارٍ عَنِ الزُّهْرِيِّ عَنْ سَالِمٍ عَنْ أَبِيهِ","The Book of Prayer"
"503","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أنبا مُعَاذُ بْنُ هِشَامٍ ، قَالَ : حَدَّثَنِي أَبِي ، عَنْ قَتَادَةَ ، فِي صَلاةِ الآيَاتِ ، عَنْ عَطَاءٍ ، عَنْ عُبَيْدِ بْنِ عُمَيْرٍ ، عَنْ عَائِشَةَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى سِتَّ رَكَعَاتٍ فِي أَرْبَعِ سَجَدَاتٍ """"""","","Sunan al-Kubra al-Nasai 503","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا اللَّيْثُ عَنْ نَافِعٍ عَنِ ابْنِ عُمَرَ","The Book of Prayer"
"504","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أنبا وَكِيعٌ ، عَنْ هِشَامٍ ، عَنْ قَتَادَةَ ، عَنْ عَطَاءٍ ، عَنْ عُبَيْدِ بْنِ عُمَيْرٍ ، عَنْ عَائِشَةَ ، قَالَتْ : صَلاةُ الآيَاتِ سِتُّ رَكَعَاتٍ فِي أَرْبَعِ سَجَدَاتٍ """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 504","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا سُفْيَانُ عَنْ عَبْدِ اللهِ بْنِ أَبِي بَكْرٍ عَنْ عَبَّادِ بْنِ تَمِيمٍ عَنْ عَمِّهِ","The Book of Prayer"
"505","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ : حَدَّثَنَا يَحْيَى بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا هِشَامٌ ، عَنْ قَتَادَةَ ، عَنْ عَطَاءٍ ، عَنْ عُبَيْدِ بْنِ عُمَيْرٍ ، عَنْ عَائِشَةَ ، فِي صَلاةِ الآيَاتِ سِتُّ رَكَعَاتٍ ، فِي أَرْبَعِ سَجَدَاتٍ """"""","","Sunan al-Kubra al-Nasai 505","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا يَزِيدُ يَعْنِي ابْنَ زُرَيْعٍ قَالَ حَدَّثَنَا يُونُسُ عَنِ الْحَسَنِ عَنْ أَبِي بَكْرَةَ قَالَ","The Book of Prayer"
"506","أَخْبَرَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ ، عَنِ ابْنِ عُلَيَّةَ ، قَالَ : حَدَّثَنَا سُفْيَانُ الثَّوْرِيُّ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، عَنْ طَاوُسٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى عِنْدَ كُسُوفٍ ثَمَانِيَ رَكَعَاتٍ وَأَرْبَعَ سَجَدَاتٍ ""، وَعَنْ عَطَاءٍ مِثْلُ ذَلِكَ ، قَالَ لَنَا أَبُو عَبْدِ الرَّحْمَنِ : هَذَا حَدِيثٌ جَيِّدٌ""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 506","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ حَدَّثَنَا الْوَلِيدُ بْنُ مُسْلِمٍ عَنِ الْأَوْزَاعِيِّ عَنِ الزُّهْرِيِّ عَنْ عُرْوَةَ عَنْ عَائِشَةَ قَالَتْ","The Book of Prayer"
"507","أَخْبَرَنَا عَمْرُو بْنُ عُثْمَانَ ، قَالَ : حَدَّثَنِي الْوَلِيدُ ، عَنِ الأَوْزَاعِيِّ ، عَنِ الزُّهْرِيِّ ، قَالَ : أَخْبَرَنِي كَثِيرُ بْنُ عَبَّاسٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى يَوْمُ كَسَفَتِ الشَّمْسُ أَرْبَعَ رَكَعَاتٍ ، فِي رَكْعَتَيْنِ ، وَأَرْبَعَ سَجَدَاتٍ """"""","","Sunan al-Kubra al-Nasai 507","","أَخْبَرَنِي عَبْدَةُ بْنُ عَبْدِ الرَّحِيمِ قَالَ أَخْبَرَنِي ابْنُ عُيَيْنَةَ عَنْ يَحْيَى بْنِ سَعِيدٍ عَنْ عَمْرَةَ عَنْ عَائِشَةَ","The Book of Prayer"
"508","أَخْبَرَنَا مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْحَسَنِ بْنِ شَقِيقٍ ، قَالَ : أنبا أَبِي ، قَالَ : أنبا أَبُو حَمْزَةَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَلْقَمَةَ ، عَنْ عَبْدِ اللَّهِ ، قَالَ : صَلَّيْتُ مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي السَّفَرِ رَكْعَتَيْنِ """"""","","Sunan al-Kubra al-Nasai 508","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ أَخْبَرَنَا مُعَاذُ بْنُ هِشَامٍ قَالَ حَدَّثَنِي أَبِي عَنْ قَتَادَةَ فِي صَلَاةِ الْآيَاتِ عَنْ عَطَاءٍ عَنْ عُبَيْدِ بْنِ عُمَيْرٍ عَنْ عَائِشَةَ","The Book of Prayer"
"509","أَخْبَرَنَا يَعْقُوبُ بْنُ مَاهَانَ ، قال : أنبا الْقَاسِمُ بْنُ مَالِكٍ ، عَنْ أَيُّوبَ هُوَ أَبُو عَائِذٍ ، عَنْ بُكَيْرِ بْنِ الأَخْنَسِ ، عَنْ مُجَاهِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إِنَّ اللَّهَ فَرْضَ الصَّلاةَ عَلَى لِسَانِ نَبِيِّكُمْ ، فِي الْحَضَرِ أَرْبَعًا ، وَفِي السَّفَرِ رَكْعَتَيْنِ ، وَفِي الْخَوْفِ رَكْعَةٌ """"""","","Sunan al-Kubra al-Nasai 509","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ أَخْبَرَنَا وَكِيعٌ عَنْ هِشَامٍ عَنْ قَتَادَةَ عَنْ عَطَاءٍ عَنْ عُبَيْدِ بْنِ عُمَيْرٍ عَنْ عَائِشَةَ قَالَتْ","The Book of Prayer"
"510","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ ، قَالَ : حَدَّثَنَا يَزِيدُ يَعْنِي بْنَ زُرَيْعٍ ، قَالَ : حَدَّثَنَا سَعِيدٌ ، قَالَ : حَدَّثَنَا قَتَادَةُ أَنَّ مُوسَى بْنَ سَلَمَةَ حَدَّثَهُمْ ، أَنَّهُ سَأَلَ ابْنَ عَبَّاسٍ ، قَالَ : قُلْتُ :تَفُوتُنِي الصَّلاةُ فِي الْجَمَاعَةِ وَأَنَا بِالْبَطْحَاءِ ، مَا تَرَى أَنْ أُصَلِّيَ ؟ قَالَ :  رَكْعَتَيْنِ سُنَّةَ أَبِي الْقَاسِمِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ """"""","","Sunan al-Kubra al-Nasai 510","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ حَدَّثَنَا يَحْيَى بْنُ سَعِيدٍ قَالَ حَدَّثَنَا هِشَامٌ عَنْ قَتَادَةَ عَنْ عَطَاءٍ عَنْ عُبَيْدِ بْنِ عُمَيْرٍ","The Book of Prayer"
"511","أَخْبَرَنَا عَبْدُ الرَّحْمَنِ بْنُ الأَسْوَدِ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ رَبِيعَةَ ، عَنْ عَبْدِ الْحَمِيدِ بْنِ جَعْفَرٍ ، عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ ، عَنْ عِرَاكِ بْنِ مَالِكٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَقَامَ بِمَكَّةَ خَمْسَةَ عَشَرَ يُصَلِّي رَكْعَتَيْنِ """"""","","Sunan al-Kubra al-Nasai 511","","أَخْبَرَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ عَنِ ابْنِ عُلَيَّةَ قَالَ حَدَّثَنَا سُفْيَانُ الثَّوْرِيُّ عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ عَنْ طَاوُسٍ عَنِ ابْنِ عَبَّاسٍ","The Book of Prayer"
"512","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ حَارِثَةَ بْنِ وَهْبٍ الْخُزَاعِيِّ ، قَالَ : صَلَّيْتُ مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمِنًى أَأْمَنُ مَا كَانَ النَّاسُ ، وَأَكْثَرُهُ رَكْعَتَيْنِ """"""","Sahih|Sahih|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 512","","أَخْبَرَنِي عَمْرُو بْنُ عُثْمَانَ قَالَ حَدَّثَنَا الْوَلِيدُ عَنِ الْأَوْزَاعِيِّ عَنِ الزُّهْرِيِّ قَالَ أَخْبَرَنِي كَثِيرُ بْنُ عَبَّاسٍ عَنْ عَبْدِ اللهِ بْنِ عَبَّاسٍ","The Book of Prayer"
"513","أَخْبَرَنَا عَلِيُّ بْنُ خَشْرَمٍ ، قَالَ : حَدَّثَنَا عِيسَى ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، قَالَ : صَلَّى عُثْمَانُبِمِنًى أَرْبَعًا ، حَتَّى بَلَغَ ذَلِكَ عَبْدُ اللَّهِ ، فَقَالَ :  صَلَّيْتُ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَكْعَتَيْنِ """"""","","Sunan al-Kubra al-Nasai 513","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْحَسَنِ بْنِ شَقِيقٍ قَالَ أَخْبَرَنَا أَبِي قَالَ أَخْبَرَنَا أَبُو حَمْزَةَ عَنْ مَنْصُورٍ عَنْ إِبْرَاهِيمَ عَنْ عَلْقَمَةَ عَنْ عَبْدِ اللهِ قَالَ","The Book of Prayer"
"514","أَخْبَرَنَا عَمْرُو بْنُ يَزِيدَ ، قَالَ : حَدَّثَنَا بَهْزُ بْنُ أَسَدٍ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، قَالَ : حَدَّثَنَا سَلَمَةُ ، قَالَ : سَمِعْتُ سَعِيدَ بْنَ جُبَيْرٍ ، قَالَ : رَأَيْتُ عَبْدَ اللَّهِ بْنَ عُمَرَ صَلَّى بِجَمْعٍ ، فَأَقَامَ فَصَلَّى الْمَغْرِبَ ثَلاثًا ، ثُمَّ صَلَّى الْعِشَاءَ رَكْعَتَيْنِ ، ثُمَّ قَالَ : هَكَذَا رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَنَعَ """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 514","","أَخْبَرَنَا يَعْقُوبُ بْنُ مَاهَانَ قَالَ حَدَّثَنَا الْقَاسِمُ بْنُ مَالِكٍ عَنْ أَيُّوبَ هُوَ ابْنُ عَائِذٍ عَنْ بُكَيْرِ بْنِ الْأَخْنَسِ عَنْ مُجَاهِدٍ عَنِ ابْنِ عَبَّاسٍ قَالَ","The Book of Prayer"
"515","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ : حَدَّثَنَا يَحْيَى بْنُ سَعِيدٍ ، عَنْ سُفْيَانَ ، قَالَ : حَدَّثَنِي أَبُو بَكْرِ بْنُ أَبِي الْجَهْمِ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : صَلَّى بِذِي قَرَدٍ فَصَفَّ النَّاسَ خَلْفَهُ صَفَّيْنِ ، صَفٌّ خَلْفَهُ ، وَصَفٌّ مُصَافُّو الْعَدُوِّ ، فَصَلَّى بِالَّذِينَ خَلْفَهُ رَكْعَةً ، ثُمَّ انْصَرَفَ هَؤُلاءِ إِلَى مَكَانِ هَؤُلاءِ ، وَجَاءَ أُولَئِكَ فَصَلَّى بِهِمْ رَكْعَةً وَلَمْ يَقْضُوا """"""","","Sunan al-Kubra al-Nasai 515","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ قَالَ حَدَّثَنَا يَزِيدُ يَعْنِي ابْنَ زُرَيْعٍ قَالَ حَدَّثَنَا سَعِيدٌ قَالَ حَدَّثَنَا قَتَادَةُ أَنَّ مُوسَى بْنَ سَلَمَةَ حَدَّثَهُمْ أَنَّهُ سَأَلَ ابْنَ عَبَّاسٍ قُلْتُ تَفُوتُنِي الصَّلَاةُ فِي الْجَمَاعَةِ وَأَنَا بِالْبَطْحَاءِ مَا تَرَى أَنْ أُصَلِّيَ؟ قَالَ","The Book of Prayer"
"516","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ ، قَالَ : حَدَّثَنَا خَالِدٌ هُوَ ابْنُ الْحَارِثِ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، عَنْ أَبِي بَكْرَةَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : صَلَّى بِالْقَوْمِ فِي الْخَوْفِ رَكْعَتَيْنِ ، ثُمَّ سَلَّمَ ، ثُمَّ صَلَّى بِالْقَوْمِ الآخَرِينَ رَكْعَتَيْنِ ، ثُمَّ سَلَّمَ ، فَصَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَرْبَعًا """"""","","Sunan al-Kubra al-Nasai 516","","أَخْبَرَنَا عَبْدُ الرَّحْمَنِ بْنُ الْأَسْوَدِ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ رَبِيعَةَ عَنْ عَبْدِ الْحَمِيدِ بْنِ جَعْفَرٍ عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ عَنْ عِرَاكِ بْنِ مَالِكٍ عَنْ عَبْدِ اللهِ بْنِ عَبَّاسٍ","The Book of Prayer"
"517","أَخْبَرَنَا عِمْرَانُ بْنُ مُوسَى ، عَنْ عَبْدِ الْوَارِثِ ، قَالَ : حدَّثَنَا يُونُسُ ، عَنِ الْحَسَنِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى بِأَصْحَابِهِ صَلاةَ الْخَوْفِ ، فَصَلَّى بِطَائِفَةٍ رَكْعَتَيْنِ ، وَالآخَرُونَ يُقْبِلُونَ عَلَى عَدُوِّهِمْ ، ثُمَّ سَلَّمَ ، ثُمَّ جَاءَ الآخَرُونَ فَصَلَّى بِهِمْ رَكْعَتَيْنِ ، ثُمَّ سَلَّمَ فَكَانَتْ لِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَرْبَعَ رَكَعَاتٍ ، وَلِلنَّاسِ رَكْعَتَيْنِ رَكْعَتَيْنِ """"""","Sahih|Sahih|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 517","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا أَبُو الْأَحْوَصِ عَنْ أَبِي إِسْحَاقَ عَنْ حَارِثَةَ بْنِ وَهْبٍ الْخُزَاعِيِّ قَالَ","The Book of Prayer"
"518","أَخْبَرَنَا مُحَمَّدُ بْنُ وَهْبٍ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ سَلَمَةَ ، قالَ : حَدَّثَنِي أَبُو عَبْدِ الرَّحِيمِ وَهُوَ خَالِدُ بْنُ أَبِي يَزِيدَ ، قَالَ : حَدَّثَنِي زَيْدٌ ، عَنْ أَيُّوبَ ، عَنْ بُكَيْرِ بْنِ الأَخْنَسِ ، عَنْ مُجَاهِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : فُرِضَتْ صَلاةُ الْحَضَرِ عَلَى لِسَانِ نَبِيِّكُمْ أَرْبَعًا ، وَصَلاةُ السَّفَرِ رَكْعَتَيْنِ ، وَصَلاةُ الْخَوْفِ رَكْعَةً """"""","","Sunan al-Kubra al-Nasai 518","","أَخْبَرَنَا عَلِيُّ بْنُ خَشْرَمٍ قَالَ حَدَّثَنَا عِيسَى عَنِ الْأَعْمَشِ عَنْ إِبْرَاهِيمَ عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ قَالَ","The Book of Prayer"
"519","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى ، قَالَ : حَدَّثَنَا الْمُعْتَمِرُ ، قالَ : سَمِعْتُ عُمَارَةَ بْنَ غَزِيَّةَ ، يُحَدِّثُ عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ عَامِرِ بْنِ عَبْدِ اللَّهِ بْنِ الزُّبَيْرِ ، عَنْ عَمْرِو بْنِ سُلَيْمٍ ، عَنْ أَبِي قَتَادَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : إِذَا دَخَلَ أَحَدُكُمُ الْمَسْجِدَ فَلا يَجْلِسْ فِيهِ حَتَّى يَرْكَعَ رَكْعَتَيْنِ """"""","","Sunan al-Kubra al-Nasai 519","","أَخْبَرَنَا عَمْرُو بْنُ يَزِيدَ قَالَ حَدَّثَنَا بَهْزُ بْنُ أَسَدٍ قَالَ حَدَّثَنَا شُعْبَةُ قَالَ حَدَّثَنَا سَلَمَةُ قَالَ سَمِعْتُ سَعِيدَ بْنَ جُبَيْرٍ يَقُولُ رَأَيْتُ عَبْدَ اللهِ بْنَ عُمَرَ §صَلَّى بِجَمْعٍ فَأَقَامَ فَصَلَّى الْمَغْرِبَ ثَلَاثًا ثُمَّ صَلَّى الْعِشَاءَ رَكْعَتَيْنِ ثُمَّ قَالَ","The Book of Prayer"
"520","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، عَنْ سُفْيَانَ بْنِ عُيَيْنَةَ ، وَيَزِيدَ هُوَ ابْنُ زُرَيْعٍ ، عَنْ مَعْمَرٍ هُوَ ابْنُ رَاشِدٍ الْبَصْرِيِّ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ ضَمْضَمٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : أَمْرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِقَتْلِ الأَسْوَدَيْنِ فِي الصَّلاةِ الْحَيَّةِ وَالْعَقْرَبِ """"""","","Sunan al-Kubra al-Nasai 520","","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ قَالَ حَدَّثَنَا يَحْيَى بْنُ سَعِيدٍ عَنْ سُفْيَانَ قَالَ حَدَّثَنِي أَبُو بَكْرِ بْنُ أَبِي الْجَهْمِ عَنْ عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ عَنِ ابْنِ عَبَّاسٍ","The Book of Forgetfulness"
"521","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا مَالِكٌ ، عَنْ عَامِرِ بْنِ عَبْدِ اللَّهِ بْنِ الزُّبَيْرِ ، عَنْ عَمْرِو بْنِ سُلَيْمٍ ، عَنْ أَبِي قَتَادَةَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يُصَلِّي وَهُوَ حَامِلٌ أُمَامَةَ فَإِذَا سَجَدَ وَضَعَهَا ، وَإِذَا قَامَ رَفَعَهَا """"""","","Sunan al-Kubra al-Nasai 521","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ قَالَ حَدَّثَنَا خَالِدٌ وَهُوَ ابْنُ الْحَارِثِ عَنْ أَشْعَثَ عَنِ الْحَسَنِ عَنْ أَبِي بَكْرَةَ","The Book of Forgetfulness"
"522","أَخْبَرَنَا مُحَمَّدُ بْنُ صَدَقَةَ الْحِمْصِيُّ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ حَرْبٍ ، عَنِ الزُّبَيْدِيِّ ، عَنْ عَامِرِ بْنِ عَبْدِ اللَّهِ بْنِ الزُّبَيْرِ ، عَنْ عَمْرِو بْنِ سُلَيْمٍ ، عَنْ أَبِي قَتَادَةَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : خَرَجَ إِلَى الصَّلاةِ وَهُوَ حَامِلٌ عَلَى عَاتِقِهِ أُمَامَةَ بِنْتِ أَبِي الْعَاصِ بْنِ الرَّبِيعِ ، وَأُمُّهَا زَيْنَبٌ بِنْتُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَكَانَ إِذَا رَكَعَ وَضَعَهَا عَلَى عَاتِقِهِ ، وَإِذَا فَرَغَ مِنْ سُجُودِهِ حَمَلَهَا عَنْ عَاتِقِهِ ، فَلَمْ يَزَلْ كَذَلِكَ حَتَّى فَرَغَ مِنْ صَلاتِهِ """"""","","Sunan al-Kubra al-Nasai 522","","أَخْبَرَنَا عِمْرَانُ بْنُ مُوسَى عَنْ عَبْدِ الْوَارِثِ قَالَ حَدَّثَنَا يُونُسُ عَنِ الْحَسَنِ عَنْ جَابِرِ بْنِ عَبْدِ اللهِ","The Book of Forgetfulness"
"523","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أنبا حَاتِمُ بْنُ وَرْدَانَ ، قَالَ : حَدَّثَنَا بَرَدُ بْنُ سِنَانٍ أَبُو الْعَلاءِ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، قَالَتِ : اسْتَفْتَحْتُ الْبَابَ وَرَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي تَطَوُّعًا وَالْبَابُ عَلَى الْقِبْلَةِ فَمَشَى عَنْ يَمِينِهِ ، أَوْ عَنْ يَسَارِهِ ، فَفَتَحَ الْبَابَ ثُمَّ رَجَعَ إِلَى مُصَلاهُ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 523","","أَخْبَرَنِي مُحَمَّدُ بْنُ وَهْبٍ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ سَلَمَةَ قَالَ حَدَّثَنِي أَبُو عَبْدِ الرَّحِيمِ وَهُوَ خَالِدُ بْنُ أَبِي يَزِيدَ قَالَ حَدَّثَنِي زَيْدٌ عَنْ أَيُّوبَ عَنْ بُكَيْرِ بْنِ الْأَخْنَسِ عَنْ مُجَاهِدٍ عَنِ ابْنِ عَبَّاسٍ قَالَ","The Book of Forgetfulness"
"524","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ بَزِيعٍ ، قَالَ : حَدَّثَنَا عَبْدُ الأَعْلَى بْنُ عَبْدِ الأَعْلَى ، قَالَ : حَدَّثَنَا عُبَيْدُ اللَّهِ ، عَنْ أَبِي حَازِمٍ ، عَنْ سَهْلِ بْنِ سَعْدٍ ، قَالَ :انْطَلَقَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصْلِحُ بَيْنَ بَنِي عَمْرِو بْنِ عَوْفٍ ، فَحَضَرَتِ الصَّلاةُ فَجَاءَ الْمُؤَذِّنُ إِلَى أَبِي بَكْرٍ فَأَمَرَهُ أَنْ يَجْمَعَ بِالنَّاسِ وَيَؤُمَّهُمْ ، فَجَاءَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَخَرَقَ الصُّفُوفَ حَتَّى قَامَ فِي الصَّفِّ الْمُقَدَّمِ ، وَصَفَّحَ النَّاسُ بِأَبِي بَكْرٍ لِيُؤْذِنُوهُ بِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَكَانَ أَبُو بَكْرٍ لا يَلْتَفِتُ فِي الصَّلاةِ ، فَلَمَّا أَكْثَرُوا عِلْمَ أَنَّهُ قَدْ نَابَهُمْ شَيْءٌ فِي صَلاتِهِمْ ، فَالْتَفَتَ فَإِذَا هُوَ بِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَأَوْمَأَ إِلَيْهِ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، أَيْ كَمَا أَنْتَ فَرَفَعَ أَبُو بَكْرٍ يَدَيْهِ فَحَمِدَ اللَّهَ وَأَثْنَى عَلَيْهِ لِقَوْلِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ رَجَعَ الْقَهْقَرَى وَتَقَدَّمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَصَلَّى فَلَمَّا انْصَرَفَ ، قَالَ لأَبِي بَكْرٍ :  مَا مَنَعَكَ إِذَا أَوْمَأْتُ إِلَيْكَ أَنْ تُصَلِّيَ "" ، قَالَ أَبُو بَكْرٍ : مَا كَانَ يَنْبَغِي لابْنِ أَبِي قُحَافَةَ أَنْ يَؤُمَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ قَالَ لِلنَّاسِ : "" مَا لَكُمْ صَفَّحْتُمْ إِنَّمَا التَّصْفِيحُ لِلنِّسَاءِ "" ، ثُمَّ قَالَ : "" إِذَا نَابَكُمْ شَيْءٌ فِي صَلاتِكُمْ فَسَبَّحُوا """"""","","Sunan al-Kubra al-Nasai 524","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى قَالَ حَدَّثَنَا الْمُعْتَمِرُ قَالَ سَمِعْتُ عُمَارَةَ بْنَ غَزِيَّةَ يُحَدِّثُ عَنْ يَحْيَى بْنِ سَعِيدٍ عَنْ عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ عَنْ عَمْرِو بْنِ سُلَيْمٍ عَنْ أَبِي قَتَادَةَ","The Book of Forgetfulness"
"525","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّحْمَنِ ، قَالَ حَدَّثَنَا زَائِدَةُ ، عَنْ أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ ، عَنْ أَبِيهِ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَةَ ، قَالَتْ : سَأَلْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَيْهِ وَسَلَّمَ عَنِ الالْتِفَاتِ فِي الصَّلاةِ ، قَالَ : اخْتِلاسٌ يَخْتَلِسُهُ الشَّيْطَانُ مِنَ الصَّلاةِ ""خَالَفَهُ إِسْرَائِيلُ""","","Sunan al-Kubra al-Nasai 525","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ عَنْ سُفْيَانَ بْنِ عُيَيْنَةَ وَيَزِيدَ هُوَ ابْنُ زُرَيْعٍ عَنْ مَعْمَرٍ هُوَ ابْنُ رَاشِدٍ الْبَصْرِيِّ عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ عَنْ ضَمْضَمٍ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Forgetfulness"
"526","أَخْبَرَنَا أَحْمَدُ بْنُ بَكَّارٍ الْحَرَّانِيُّ ، عَنْ مَخْلَدٍ وَهُوَ ابْنُ يَزِيدَ الْحَرَّانِيُّ ، عَنْ إِسْرَائِيلَ ، عَنْ أَشْعَثَ ، عَنْ أَبِي عَطِيَّةَ الْكُوفِيِّ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَةَ ، قَالَتْ : سَأَلْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِالالْتِفَاتِ فِي الصَّلاةِ ، قَالَ :  هُوَ اخْتِلاسٌ يَخْتَلِسُهُ الشَّيْطَانُ مِنْ صَلاةِ الْعَبْدِ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 526","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ أَخْبَرَنَا مَالِكٌ عَنْ عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ عَنْ عَمْرِو بْنِ سُلَيْمٍ عَنْ أَبِي قَتَادَةَ","The Book of Forgetfulness"
"527","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ ، قَالَ : أنبا عَبْدُ اللَّهِ هُوَ ابْنُ الْمُبَارَكِ ، عَنْ يُونُسَ ، عَنِ الزُّهْرِيِّ ، قَالَ : سَمِعْتُ أَبَا الأَحْوَصِ ، يُحَدِّثُنَا فِي مَجْلِسِ سَعِيدِ بْنِ الْمُسَيِّبِ ، وَابْنُ الْمُسَيِّبِ جَالِسٌ ، أَنَّهُ سَمِعَ أَبَا ذَرٍّ ، يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِنَّ اللَّهَ مُقْبِلٌ عَلَى الْعَبْدِ فِي صَلاتِهِ مَا لَمْ يَلْتَفِتْ ، فَإِذَا صَرْفَ وَجْهَهُ انْصَرَفَ عَنْهُ """"""","","Sunan al-Kubra al-Nasai 527","","أَخْبَرَنِي مُحَمَّدُ بْنُ صَدَقَةَ الْحِمْصِيُّ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ حَرْبٍ عَنِ الزُّبَيْدِيِّ عَنْ عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ عَنْ عَمْرِو بْنِ سُلَيْمٍ عَنْ أَبِي قَتَادَةَ","The Book of Forgetfulness"
"528","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا اللَّيْثُ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : رَأَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نُخَامَةً فِي قِبْلَةِ الْمَسْجِدِ ، وَهُوَ يُصَلِّي بَيْنَ يَدَيِ النَّاسِ ، فَحَتَّهَا ، ثُمَّ قَالَ حِينَ انْصَرَفَ : إِنَّ أَحَدَكُمْ إِذَا كَانَ فِي الصَّلاةِ فَإِنَّ اللَّهَ قِبَلُ وَجْهِهِ ، فَلا يَتَنَخَّمَنَّ أَحَدُكُمْ قِبَلَ وَجْهِهِ فِي الصَّلاةِ """"""","Hasan|Hasan|Daif","Sunan al-Kubra al-Nasai 528","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ قَالَ حَدَّثَنَا بَرَدُ بْنُ سِنَانٍ أَبُو الْعَلَاءِ عَنِ الزُّهْرِيِّ عَنْ عُرْوَةَ عَنْ عَائِشَةَ","The Book of Forgetfulness"
"529","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أنبا الْفَضْلُ بْنُ مُوسَى ، قَالَ : حَدَّثَنَا عَبْدُ اللَّهِ بْنُ سَعِيدِ بْنِ أَبِي هِنْدَ ، عَنْ ثَوْرِ بْنِ زَيْدٍ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَلْحَظُ فِي صَلاتِهِ يَمِينًا وَشِمَالا ، وَلا يَلْوِي عُنُقَهُ خَلْفَ ظَهْرِهِ """"""","Sahih|Sahih|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 529","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ بَزِيعٍ قَالَ حَدَّثَنَا عَبْدُ الْأَعْلَى بْنُ عَبْدِ الْأَعْلَى قَالَ حَدَّثَنَا عُبَيْدُ اللهِ عَنْ أَبِي حَازِمٍ عَنْ سَهْلِ بْنِ سَعْدٍ قَالَ","The Book of Forgetfulness"
"530","أَخْبَرَنَا هَنَّادُ بْنُ السَّرِيِّ ، فِي حَدِيثِهِ ، عَنْ أَبِي مُعَاوِيَةَ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَةَ بْنِ عُمَيْرٍ ، عَنْ أَبِي مَعْمَرٍ ، قَالَ : قُلْنَا لِخَبَّابٍ : هَلْ كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُقْرَأُ فِي الظُّهْرِ وَالْعَصْرِ ؟ قَالَ : نَعَمْ ، قُلْتُ : بِأَيِّ شَيْءٍ كُنْتُمْ تَعْرِفُونَ ؟ قَالَ : بِاضْطِرَابِ لِحْيَتِهِ """"""","","Sunan al-Kubra al-Nasai 530","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا عَبْدُ الرَّحْمَنِ قَالَ حَدَّثَنَا زَائِدَةُ عَنْ أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ عَنْ أَبِيهِ عَنْ مَسْرُوقٍ عَنْ عَائِشَةَ قَالَتْ","The Book of Forgetfulness"
"531","أَخْبَرَنَا عَلِيُّ بْنُ الْحُسَيْنِ ، قَالَ : حَدَّثَنَا أُمَيَّةُ ، عَنْ شُعْبَةَ ، عَنْ أَبِي إِسْحَاقَ ، قَالَ : سَمِعْتُ عَبْدَ اللَّهِ بْنَ يَزِيدَ ، وَهُوَ يَخْطُبُ ، قَالَ : حَدَّثَنِي الْبَرَاءُ ، وَهُوَ غَيْرُ كَذُوبٍ أَنَّهُمْ إِذَا صَلَّوْا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَرَفَعُوا رُءُوسَهُمْ مِنَ الرُّكُوعِ ، قَامُوا قِيَامًا حَتَّى يَرَوْهُ قَدْ سَجَدَ """"""","","Sunan al-Kubra al-Nasai 531","","أَخْبَرَنِي أَحْمَدُ بْنُ بَكَّارٍ الْحَرَّانِيُّ عَنْ مَخْلَدٍ وَهُوَ ابْنُ يَزِيدَ الْحَرَّانِيُّ عَنْ إِسْرَائِيلَ عَنْ أَشْعَثَ عَنْ أَبِي عَطِيَّةَ الْكُوفِيِّ عَنْ مَسْرُوقٍ عَنْ عَائِشَةَ قَالَتْ","The Book of Forgetfulness"
"532","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، وَالْحُسَيْنُ بْنُ حُرَيْثٍ ، وَاللَّفْظُ لَهُ ، عَنْ سُفْيَانَ ، عَنِ الزُّهْرِيِّ ، عَنْ أَبِي الأَحْوَصِ ، عَنْ أَبِي ذَرٍّ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا قَامَ أَحَدُكُمْ فِي الصَّلاةِ فَلا يَمْسَحِ الْحَصَى ، فَإِنَّ الرَّحْمَةَ تُوَاجِهُهُ """"""","Daif|Daif|Isnaad Hasan","Sunan al-Kubra al-Nasai 532","","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ بْنِ سُوَيْدٍ قَالَ حَدَّثَنَا عَبْدُ اللهِ وهُوَ ابْنُ الْمُبَارَكِ عَنْ يُونُسَ عَنِ الزُّهْرِيِّ قَالَ سَمِعْتُ أَبَا الْأَحْوَصِ يُحَدِّثُنَا فِي مَجْلِسِ ابْنِ الْمُسَيِّبِ وَابْنُ الْمُسَيِّبِ جَالِسٌ أَنَّهُ سَمِعَ أَبَا ذَرٍّ يَقُولُ","The Book of Forgetfulness"
"533","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ ، قَالَ : أنبا عَبْدُ اللَّهِ بْنُ الْمُبَارَكِ ، عَنِ الأَوْزَاعِيِّ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، قَالَ : حَدَّثَنِي أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ : حَدَّثَنِي مُعَيْقِيبٌ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : إِنْ كُنْتَ فَاعِلا فَمَرَّةً """"""","","Sunan al-Kubra al-Nasai 533","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا اللَّيْثُ عَنْ نَافِعٍ عَنِ ابْنِ عُمَرَ قَالَ","The Book of Forgetfulness"
"534","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، وَمُحَمَّدُ بْنُ الْمُثَنَّى ، قَالا : حَدَّثَنَا سُفْيَانُ ، عَنِ الزُّهْرِيِّ ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : التَّسْبِيحُ لِلرِّجَالِ ، وَالتَّصْفِيقُ لِلنِّسَاءِ ""فِي حَدِيثِ ابْنِ الْمُثَنَّى ، في الصَّلاةِ ، لَفْظُ الْحَدِيثِ لِقُتَيْبَةَ""","Sahih|Sahih|Isnaad Hasan","Sunan al-Kubra al-Nasai 534","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ أَخْبَرَنَا الْفَضْلُ بْنُ مُوسَى قَالَ حَدَّثَنَا عَبْدُ اللهِ بْنُ سَعِيدِ بْنِ أَبِي هِنْدَ عَنْ ثَوْرِ بْنِ زَيْدٍ عَنْ عِكْرِمَةَ عَنِ ابْنِ عَبَّاسٍ قَالَ","The Book of Forgetfulness"
"535","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا اللَّيْثُ ، عَنْ أَبِي الزُّبَيْرٍ ، عَنْ جَابِرٍ ، أَنَّهُ قَالَ : اشْتَكَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَصَلَّيْنَا وَرَاءَهُ وَهُوَ قَاعِدٌ وَأَبُو بَكْرٍ يُكَبِّرُ ، وَيُسْمِعُ النَّاسَ تَكْبِيرَهُ ، فَالْتَفَتَ إِلَيْنَا فَرَآنَا قِيَامًا ، فَأَشَارَ إِلَيْنَا فَقَعَدْنَا فَصَلَّيْنَا بِصَلاتِهِ قُعُودًا فَلَمَّا سَلَّمَ ، قَالَ : إِنْ كِدْتُمْ آنِفًا لَتَفْعَلُونَ فِعْلَ فَارِسٍ وَالرُّومِ يَقُومُونَ عَلَى مُلُوكِهِمْ وَهُمْ قُعُودٌ ، فَلا تَفْعَلُوا ائْتَمُّوا بِأَئِمَّتِكُمْ ، إِنْ صَلَّى قَائِمًا فَصَلَّوْا قِيَامًا ، وَإِنْ صَلَّى قَاعِدًا فَصَلَّوْا قُعُودًا """"""","","Sunan al-Kubra al-Nasai 535","","أَخْبَرَنَا هَنَّادُ بْنُ السَّرِيِّ فِي حَدِيثِهِ عَنْ أَبِي مُعَاوِيَةَ عَنِ الْأَعْمَشِ عَنْ عُمَارَةَ بْنِ عُمَيْرٍ عَنْ أَبِي مَعْمَرٍ قَالَ","The Book of Forgetfulness"
"536","أَخْبَرَنَا أَحْمَدُ بْنُ سُلَيْمَانَ ، قَالَ : حَدَّثَنَا يَحْيَى بْنُ آدَمَ ، عَنْ مِسْعَرٍ ، عَنْ عُبَيْدِ اللَّهِ بْنِ الْقِبْطِيَّةِ ، عَنْ جَابِرِ بْنِ سَمُرَةَ ، قَالَ : كُنَّا نُصَلِّي خَلْفَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَنُسَلِّمُ بِأَيْدِينَا ، فَقَالَ : مَا بَالُ هَؤُلاءِ يُسَلِّمُونَ بِأَيْدِيهِمْ كَأَنَّهَا أَذْنَابُ خَيْلِ شَمْسٍ ، أَمَا يَكْفِي أَحَدَهُمْ أَنْ يَضَعَ يَدَهُ عَلَى فَخِذِهِ ، ثُمَّ يَقُولُ : السَّلامُ عَلَيْكُمُ السَّلامُ عَلَيْكُمْ """"""","","Sunan al-Kubra al-Nasai 536","","أَخْبَرَنَا عَلِيُّ بْنُ الْحُسَيْنِ قَالَ حَدَّثَنَا أُمَيَّةُ عَنْ شُعْبَةَ عَنْ أَبِي إِسْحَاقَ قَالَ سَمِعْتُ عَبْدَ اللهِ بْنَ يَزِيدَ وَهُوَ يَخْطُبُ قَالَ","The Book of Forgetfulness"
"537","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا اللَّيْثُ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرٍ ، قَالَ : بَعَثَنِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِحَاجَةٍ ، ثُمَّ أَدْرَكْتُهُ وَهُوَ يُصَلِّي فَسَلَّمْتُ عَلَيْهِ ، فَأَشَارَ إِلَيَّ فَلَمَّا فَرَغَ دَعَانِي ، قَالَ : إِنَّكَ سَلَّمْتَ عَلَيَّ آنِفًا ، وَأَنَا أُصَلِّي ، وَإِنَّمَا هُوَ مُوَجَّهٌ حِينَئِذٍ إِلَى الْمَشْرِقِ """"""","Daif|Daif|Hasan","Sunan al-Kubra al-Nasai 537","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ وَالْحُسَيْنُ بْنُ حُرَيْثٍ وَاللَّفْظُ لَهُ عَنْ سُفْيَانَ عَنِ الزُّهْرِيِّ عَنْ أَبِي الْأَحْوَصِ عَنْ أَبِي ذَرٍّ قَالَ","The Book of Forgetfulness"
"538","أَخْبَرَنَا مُحَمَّدُ بْنُ الْعَلاءِ ، قَالَ : حَدَّثَنَا أَبُو خَالِدٍ وَهُوَ سُلَيْمَانُ بْنُ حَيَّانَ الأَحْمَرُ ، عَنْ شُعْبَةَ ، عَنِ الْحَكَمِ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَلْقَمَةَ ، عَنْ عَبْدِ اللَّهِ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : إِنَّ فِي الصَّلاةِ شُغْلا ""خَالَفَهُ بِشْرُ بْنُ الْمُفَضَّلِ""","","Sunan al-Kubra al-Nasai 538","","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ قَالَ أَخْبَرَنَا عَبْدُ اللهِ بْنُ الْمُبَارَكِ عَنِ الْأَوْزَاعِيِّ عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ قَالَ حَدَّثَنِي أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ قَالَ حَدَّثَنِي مُعَيْقِيبٌ","The Book of Forgetfulness"
"539","أَخْبَرَنَا حُمَيْدُ بْنُ مَسْعَدَةَ ، قَالَ : حَدَّثَنَا بِشْرٌ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنِ الْحَكَمِ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَبْدِ اللَّهِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فِي الرَّجُلِ يُسَلِّمُ عَلَيْهِ وَهُوَ يُصَلِّي ، قَالَ :  إِنَّفِي الصَّلاةِ شُغْلا """"""","","Sunan al-Kubra al-Nasai 539","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ وَمُحَمَّدُ بْنُ الْمُثَنَّى قَالَا حَدَّثَنَا سُفْيَانُ عَنِ الزُّهْرِيِّ عَنْ أَبِي سَلَمَةَ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Forgetfulness"
"540","أَخْبَرَنَا حُمَيْدُ بْنُ مَسْعَدَةَ ، قَالَ : حَدَّثَنَا بِشْرُ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنْ سُلَيْمَانَ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَبْدِ اللَّهِ ، قَالَ : كُنَّا نُسَلِّمُ عَلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَهُوَ يُصَلِّي فَيَرُدُّ عَلَيْنَا السَّلامَ ، فَلَمَّا أَتَيْنَا الْحَبَشَ فَرَجَعْنَا ، فَسَلَّمْنَا عَلَيْهِ فَلَمْ يُرِدَّ فَسَأَلْنَاهُ ، فَقَالَ :  إِنَّفِي الصَّلاةِ شُغْلا """"""","Sahih|Sahih|Sahih Muslim","Sunan al-Kubra al-Nasai 540","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا اللَّيْثُ عَنْ أَبِي الزُّبَيْرٍ عَنْ جَابِرٍ","The Book of Forgetfulness"
"541","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ : حَدَّثَنَا وَهْبٌ ، قَالَ : حَدَّثَنَا أَبِي ، قَالَ : حَدَّثَنَا قَيْسُ بْنُ سَعْدٍ ، عَنْ عَطَاءٍ ، عَنْ مُحَمَّدِ بْنِ عَلِيٍّ ، عَنْ عَمَّارِ بْنِ يَاسِرٍ ، أَنَّهُ سَلَّمَ عَلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَهُوَ يُصَلِّي فَرَدَّ عَلَيْهِ """"""","Sahih|Sahih|Sahih Muslim","Sunan al-Kubra al-Nasai 541","","أَخْبَرَنَا أَحْمَدُ بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا يَحْيَى بْنُ آدَمَ عَنْ مِسْعَرٍ عَنْ عُبَيْدِ اللهِ بْنِ الْقِبْطِيَّةِ عَنْ جَابِرِ بْنِ سَمُرَةَ قَالَ","The Book of Forgetfulness"
"542","أَخْبَرَنَا عُبَيْدُ اللَّهِ بْنُ سَعِيدٍ أَبُو قُدَامَةَ السَّرَخْسِيُّ ، وَشُعَيْبُ بْنُ يُوسُفَ أَبُو عُمَرَ النَّسَائِيُّ ، عَنْ يَحْيَى يَعْنِي بْنَ سَعِيدٍ الْقَطَّانَ ، عَنِ ابْنِ أَبِي عَرُوبَةَ ، عَنْ قَتَادَةَ ، عَنْ أَنَسِ بْنِ مَالِكٍ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَا بَالُ أَقْوَامٍ يَرْفَعُونَ أَبْصَارَهُمْ إِلَى السَّمَاءِ فِي صَلاتِهِمْ ، فَاشْتَدَّ قَوْلُهُ فِي ذَلِكَ حَتَّى قَالَ : لَيَنْتَهُنَّ ، أَوْ لَتُخْطَفَنَّ أَبْصَارَهُمْ """"""","","Sunan al-Kubra al-Nasai 542","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا اللَّيْثُ عَنْ أَبِي الزُّبَيْرِ عَنْ جَابِرٍ قَالَ","The Book of Forgetfulness"
"543","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا الْفُضَيْلُ ، عَنِ الأَعْمَشِ ، عَنْ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : التَّسْبِيحُ لِلرِّجَالِ ، وَالتَّصْفِيقُ لِلنِّسَاءِ """"""","","Sunan al-Kubra al-Nasai 543","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْعَلَاءِ قَالَ حَدَّثَنَا أَبُو خَالِدٍ وَهُوَ سُلَيْمَانُ بْنُ حَيَّانَ الْأَحْمَرُ عَنْ شُعْبَةَ عَنِ الْحَكَمِ عَنْ إِبْرَاهِيمَ عَنْ عَلْقَمَةَ عَنْ عَبْدِ اللهِ","The Book of Forgetfulness"
"544","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ ، قَالَ : أنبا عَبْدُ اللَّهِ هُوَ ابْنُ الْمُبَارَكِ ، عَنْ حَمَّادِ بْنِ سَلَمَةَ ، عَنْ ثَابِتٍ الْبُنَانِيِّ ، عَنْ مُطَرِّفٍ ، عَنْ أَبِيهِ ، قَالَ : أَتَيْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يُصَلِّي ، وَلِجَوْفِهِ أَزِيزٌ كَأَزِيزِ الْمِرْجَلِ ""، يَعْنِي يُبْكِي""","","Sunan al-Kubra al-Nasai 544","","أَخْبَرَنَا حُمَيْدُ بْنُ مَسْعَدَةَ قَالَ حَدَّثَنَا بِشْرٌ قَالَ حَدَّثَنَا شُعْبَةُ عَنِ الْحَكَمِ عَنْ إِبْرَاهِيمَ عَنْ عَبْدِ اللهِ","The Book of Forgetfulness"
"545","أَخْبَرَنَا عِيسَى بْنُ يُونُسَ ، عَنْ ضَمْرَةَ ، عَنِ السَّرِيِّ بْنِ يَحْيَى ، عَنْ عَبْدِ الْكَرِيمِ بْنِ رَاشِدٍ ، عَنِ ابْنِ الشِّخِّيرِ ، عَنْ أَبِيهِ ، قَالَ : كَانَ يُسْمَعُ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَزِيزٌ بِالدُّعَاءِ وَهُوَ سَاجِدٌ كَأَزِيزِ الْمِرْجَلِ """"""","","Sunan al-Kubra al-Nasai 545","","أَخْبَرَنَا حُمَيْدُ بْنُ مَسْعَدَةَ قَالَ حَدَّثَنَا بِشْرُ قَالَ حَدَّثَنَا شُعْبَةُ عَنْ سُلَيْمَانَ عَنْ إِبْرَاهِيمَ عَنْ عَبْدِ اللهِ قَالَ","The Book of Forgetfulness"
"546","أَخْبَرَنَا مُحَمَّدُ بْنُ الْعَلاءِ ، قَالَ : حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا أَبُو إِسْحَاقَ ، عَنِ السَّائِبِ بْنِ مَالِكٍ ، عَنْ عَبْدِ اللَّهِ ، قَالَ : انْكَسَفَتِ الشَّمْسُ يَوْمَ مَاتَ إِبْرَاهِيمُ ، فَصَلَّى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، رَكْعَتَيْنِ فَجَعَلَ يَتَقَدَّمُ وَيَنْفُخُ ، وَيَتَأَخَّرُ وَيَتَقَدَّمُ وَيَنْفُخُ ، وَيَتَأَخَّرُ فَانْصَرَفَ حِينَ انْصَرَفَ وَقَدْ تَجَلَّتْ """"""","","Sunan al-Kubra al-Nasai 546","","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ قَالَ حَدَّثَنَا وَهْبٌ قَالَ حَدَّثَنَا أَبِي قَالَ حَدَّثَنَا قَيْسُ بْنُ سَعْدٍ عَنْ عَطَاءٍ عَنْ مُحَمَّدِ بْنِ عَلِيٍّ عَنْ عَمَّارِ بْنِ يَاسِرٍ","The Book of Forgetfulness"
"547","أَخْبَرَنَا يَحْيَى بْنُ أَيُّوبَ ، قَالَ : حَدَّثَنَا أَبُو صَالِحٍ ، قَالَ : حَدَّثَنَا حَمَّادٌ ، عَنْ عَطَاءِ بْنِ السَّائِبِ ، عَنْ أَبِيهِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : كَانَ سَاجِدًا فِي آخِرِ سُجُودِهِ فِي صَلاةِ الآيَاتِ فَنَفَخَ فِي آخِرِ سَجْدَةٍ ، فَقَالَ : أُفٍّ أُفٍّ أُفٍّ ، ثُمَّ قَالَ : رَبِّ أَلَمْ تَعِدْنِي أَلا تُعَذِّبْهُمْ وَأَنَا فِيهِمْ ، رَبِّ أَلَمْ تَعِدْنِي أَلا تُعَذِّبْهُمْ وَهُمْ يَسْتَغْفِرُونَ """"""","Sahih|Sahih|Sahih Bukhari","Sunan al-Kubra al-Nasai 547","","أَخْبَرَنَا عُبَيْدُ اللهِ بْنُ سَعِيدٍ أَبُو قُدَامَةَ السَّرَخْسِيُّ وَشُعَيْبُ بْنُ يُوسُفَ أَبُو عُمَرَ النَّسَائِيُّ عَنْ يَحْيَى يَعْنِي ابْنَ سَعِيدٍ الْقَطَّانَ عَنِ ابْنِ أَبِي عَرُوبَةَ عَنْ قَتَادَةَ عَنْ أَنَسِ بْنِ مَالِكٍ","The Book of Forgetfulness"
"548","أَخْبَرَنَا الْحُسَيْنُ بْنُ عِيسَى الْقُومَسِيُّ الْبِسْطَامِيُّ ، قَالَ : حَدَّثَنَا أَحْمَدُ بْنُ أَبِي طَيِّبَةَ ، وَعَفَّانُ بْنُ سَيَّارٍ ، عَنْ عَنْبَسَةَ بْنِ الأَزْهَرِ ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ ، عَنْ كُرَيْبٍ ، عَنْ أُمِّ سَلَمَةَ ، قَالَتْ : مَرَّ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِغُلامٍ لَهُمْ يُقَالُ لَهُ رَبَاحٌ وَهُوَ يُصَلِّي ، فَنَفَخَ فِي سُجُودِهِ ، فَقَالَ لَهُ : يَا رَبَاحُ لا تَنْفُخْ ، إِنَّ مَنْ نَفَخَ فَقَدْ تَكَلَّمَ """"""","","Sunan al-Kubra al-Nasai 548","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا الْفُضَيْلُ عَنِ الْأَعْمَشِ عَنْ أَبِي صَالِحٍ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Forgetfulness"
"549","أَخْبَرَنَا مُحَمَّدُ بْنُ سَلَمَةَ ، عَنِ ابْنِ وَهْبٍ ، عَنْ مُعَاوِيَةَ بْنِ صَالِحٍ ، قَالَ : حَدَّثَنِي رَبِيعَةُ بْنُ يَزِيدَ ، عَنْ أَبِي إِدْرِيسَ الْخَوْلانِيِّ ، عَنْ أَبِي الدَّرْدَاءِ ، قَالَ : قَامَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي ، فَسَمِعْنَاهُ يَقُولُ :  أَعُوذُ بِاللَّهِ مِنْكَ "" ثُمَّ قَالَ : "" أَلْعَنُكَ بِلَعْنَةِ اللَّهِ ثَلاثًا "" ، وَبَسَطَ يَدَهُ كَأَنَّهُ يَتَنَاوَلُ شَيْئًا ، فَلَمَّا فَرَغَ مِنَ الصَّلاةِ ، قُلْنَا : يَا رَسُولَ اللَّهِ قَدْ سَمِعْنَاكَ تَقُولُ فِي الصَّلاةِ شَيْئًا لَمْ نَسْمَعْكَ تَقُولُهُ قَبْلَ ذَلِكَ ، وَرَأَيْنَاكَ بُسِطَتْ يَدَكَ ، قَالَ : ""إِنَّ عَدُوَّ اللَّهِ إِبْلِيسَ جَاءَ بِشِهَابٍ مِنْ نَارٍ لِيَجْعَلَهُ فِي وَجْهِي ، فَقُلْتُ : أَعُوذُ بِاللَّهِ مِنْكَ ثَلاثَ مَرَّاتٍ ، ثُمَّ قُلْتُ أَلْعَنُكَ بِلَعْنَةِ اللَّهِ فَلَمْ يَسْتَأْخِرْ ثَلاثَ مَرَّاتٍ ، ثُمَّ أَرَدْتُ أَنْ آخُذَهُ ، وَاللَّهِ لَوْلا دَعْوَةُ أَخِينَا سُلَيْمَانَ لأَصْبَحَ مُوَثَّقًا يَلْعَبُ بِهِ وُلْدَانُ أَهْلِ الْمَدِينَةِ """"""","Sahih|Sahih|Isnaad Sahih","Sunan al-Kubra al-Nasai 549","","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ قَالَ أَخْبَرَنَا عَبْدُ اللهِ هُوَ ابْنُ الْمُبَارَكِ عَنْ حَمَّادِ بْنِ سَلَمَةَ عَنْ ثَابِتٍ الْبُنَانِيِّ عَنْ مُطَرِّفٍ عَنْ أَبِيهِ قَالَ","The Book of Forgetfulness"
"550","أَخْبَرَنَا عَمْرُو بْنُ عُثْمَانَ ، قَالَ : حَدَّثَنَا بَقِيَّةُ ، قَالَ : حَدَّثَنِي الزُّبَيْدِيُّ ، قَالَ : أَخْبَرَنِي الزُّهْرِيُّ ، عَنْ سَعِيدٍ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : بَيْنَا أَنَا قَائِمٌ أُصَلِّي اعْتَرَضَ لِي الشَّيْطَانُ ، فَأَخَذْتُ بِحَلْقِهِ فَخَنَقْتُهُ حَتَّى إِنِّي لأَجِدُ بَرْدَ لِسَانِهِ عَلَى إِبْهَامِي ، فَرَحِمَ اللَّهُ سُلَيْمَانَ لَوْلا دَعَوْتُهُ أَصْبَحَ مَرْبُوطًا تَنْظُرُونَ إِلَيْهِ ""، خَالَفَهُ أَبُو سَلَمَةَ فِي لَفْظِهِ""","","Sunan al-Kubra al-Nasai 550","","أَخْبَرَنَا عِيسَى بْنُ يُونُسَ عَنْ ضَمْرَةَ عَنِ السَّرِيِّ بْنِ يَحْيَى عَنْ عَبْدِ الْكَرِيمِ بْنِ رَاشِدٍ عَنِ ابْنِ الشِّخِّيرِ عَنْ أَبِيهِ قَالَ «كَانَ","The Book of Forgetfulness"
"551","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أنبا الْفَضْلُ بْنُ مُوسَى ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، قَالَ : حَدَّثَنَا أَبُو سَلَمَةُ ، عَنْ أَبِي هُرَيْرَةَ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : اعْتَرَضَ لِي الشَّيْطَانُ فِي مُصَلايَ فَأَخَذْتُ بِحَلْقَةِ فَخَنَقْتُهُ ، حَتَّى وَجَدْتُ بَرْدَ لِسَانِهِ عَلَى كَفَّيَّ ، وَلَوْلا مَا كَانَ مِنْ دَعْوَةِ أَخِي سُلَيْمَانَ ، لأَصْبَحَ مَرْبُوطًا تَنْظُرُونَ إِلَيْهِ """"""","","Sunan al-Kubra al-Nasai 551","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْعَلَاءِ قَالَ حَدَّثَنَا أَبُو بَكْرٍ قَالَ حَدَّثَنَا أَبُو إِسْحَاقَ عَنِ السَّائِبِ بْنِ مَالِكٍ عَنْ عَبْدِ اللهِ قَالَ","The Book of Forgetfulness"
"552","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا عَبْثَرٌ هُوَ ابْنُ الْقَاسِمِ أَبُو زُبَيْدٍ الْكُوفِيِّ ، عَنِ الأَعْمَشِ ، عَنِ الْمُسَيِّبِ بْنِ رَافِعٍ ، عَنْ تَمِيمِ بْنِ طَرَفَةَ ، عَنْ جَابِرِ بْنِ سَمُرَةَ ، قَالَ : خَرَجَ عَلَيْنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَنَحْنُ ، يَعْنِي رَافِعُوا أَيْدِينَا فِي الصَّلاةِ ، فَقَالَ : مَا لَهُمْ رَافِعِينَ أَيْدِيَهُمْ فِي الصَّلاةِ كَأَنَّهَا أَذْنَابُ الْخَيْلِ الشَّمْسِ ، اسْكُنُوا فِي الصَّلاةِ """"""","","Sunan al-Kubra al-Nasai 552","","أَخْبَرَنَا يَحْيَى بْنُ أَيُّوبَ قَالَ حَدَّثَنَا أَبُو صَالِحٍ قَالَ حَدَّثَنَا حَمَّادٌ عَنْ عَطَاءِ بْنِ السَّائِبِ عَنْ أَبِيهِ عَنْ عَبْدِ اللهِ بْنِ عَمْرٍو","The Book of Forgetfulness"
"553","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : أنبا سُفْيَانُ ، عَنِ الزُّهْرِيِّ ، وأنبأ مُحَمَّدُ بْنُ مَنْصُورٍ ، عَنْ سُفْيَانَ ، قَالَ : حَدَّثَنَا الزُّهْرِيُّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : صَلَّى فِي خَمِيصَةٍ لَهَا أَعْلامٌ ، قَالَ : شَغَلَتْنِي أَعْلامُ هَذِهِ اذْهَبُوا بِهَا إِلَى أَبِي جَهْمٍ ، وَائْتُونِي بِأَنْبِجَانِيَّةِ """"""","","Sunan al-Kubra al-Nasai 553","","أَخْبَرَنِي الْحُسَيْنُ بْنُ عِيسَى الْقُومَسِيُّ الْبِسْطَامِيُّ قَالَ حَدَّثَنَا أَحْمَدُ بْنُ أَبِي طَيِّبَةَ وَعَفَّانُ بْنُ سَيَّارٍ عَنْ عَنْبَسَةَ بْنِ الْأَزْهَرِ عَنْ سَلَمَةَ بْنِ كُهَيْلٍ عَنْ كُرَيْبٍ عَنْ أُمِّ سَلَمَةَ قَالَتْ","The Book of Forgetfulness"
"554","أَخْبَرَنَا كَثِيرُ بْنُ عُبَيْدِ الْحِمْصِيُّ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ حَرْبٍ ، عَنِ الزُّبَيْدِيِّ ، عَنِ الزُّهْرِيِّ ، عَنْ أَبِي سَلَمَةَ ، أَنَّ أَبَا هُرَيْرَةَ ، قَالَ : قَامَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَى الصَّلاةِ وَقُمْنَا مَعَهُ ،فَقَالَ أَعْرَابِيٌّ وَهُوَ فِي الصَّلاةِ : اللَّهُمُ ارْحَمْنِي وَمُحَمَّدًا ، وَلا تَرْحَمْ مَعَنَا أَحَدًا ، فَلَمَّا سَلَّمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ لِلأَعْرَابِيِّ :  لَقَدْ تَحَجَّرْتَ وَاسِعًا ، يُرِيدُ رَحْمَةَ اللَّهِ ""خَالَفَهُ سُفْيَانُ بْنُ عُيَيْنَةَ""","","Sunan al-Kubra al-Nasai 554","","أَخْبَرَنَا مُحَمَّدُ بْنُ سَلَمَةَ عَنِ ابْنِ وَهْبٍ عَنْ مُعَاوِيَةَ بْنِ صَالِحٍ قَالَ حَدَّثَنِي رَبِيعَةُ بْنُ يَزِيدَ عَنْ أَبِي إِدْرِيسَ الْخَوْلَانِيِّ عَنْ أَبِي الدَّرْدَاءِ قَالَ","The Book of Forgetfulness"
"555","أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ الزُّهْرِيِّ الْبَصْرِيِّ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، قَالَ : أَحْفَظْهُ مِنَ الزُّهْرِيِّ ، قَالَ : أَخْبَرَنِي سَعِيدٌ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّأَعْرَابِيًّا دَخَلَ الْمَسْجِدَ فَصَلَّى رَكْعَتَيْنِ ، ثُمَّ قَالَ : اللَّهُمَّ ارْحَمْنِي وَمُحَمَّدًا وَلا تُرْحَمْ مَعَنَا أَحَدًا ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  لَقَدْ تَحَجَّرْتَ وَاسِعًا """"""","","Sunan al-Kubra al-Nasai 555","","أَخْبَرَنَا عَمْرُو بْنُ عُثْمَانَ قَالَ حَدَّثَنَا بَقِيَّةُ قَالَ حَدَّثَنِي الزُّبَيْدِيُّ قَالَ أَخْبَرَنِي الزُّهْرِيُّ عَنْ سَعِيدٍ عَنْ أَبِي هُرَيْرَةَ","The Book of Forgetfulness"
"556","أَخْبَرَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : أنبا مُحَمَّدُ بْنُ يُوسُفَ ، قَالَ : حَدَّثَنَا الأَوْزَاعِيُّ ، قَالَ : حَدَّثَنِي يَحْيَى بْنُ أَبِي كَثِيرٍ ، عَنْ هِلالِ بْنِ أَبِي مَيْمُونَةَ ، قَالَ : حَدَّثَنِي عَطَاءُ بْنُ يَسَارٍ ، عَنْ مُعَاوِيَةَ بْنِ الْحَكَمِ السَّلَمِيِّ ، قَالَ : بَيْنَا أَنَا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الصَّلاةِ إِذْ عَطَسَ رَجُلٌ مِنَ الْقَوْمِ ، فَقُلْتُ : يَرْحَمُكَ اللَّهُ ، فَحَذَفَنِي الْقَوْمُ بِأَبْصَارِهِمْ فَقُلْتُ : وَاثُكْلَ أُمِّيَا مَا لَكُمْ تَنْظُرُونَ إِلَيَّ ؟ ، قَالَ : فَضَرَبَ الْقَوْمُ بِأَيْدِيهِمْ عَلَى أَفْخَاذِهِمْ ، فَلَمَّا رَأَيْتُهُمْ يُسَكِّتُونِي لَكِنِّي سَكَتُّ ، فَلَمَّا انْصَرَفَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، دَعَانِي بِأَبِي وَأُمِّي هُوَ ،مَا ضَرَبَنِي وَلا كَهَرَنِي وَلا سَبَّنِي ، مَا رَأَيْتُ مُعَلِّمًا قَبْلَهُ وَلا بَعْدَهُ أَحْسَنَ تَعْلِيمًا مِنْهُ ، قَالَ :  إِنَّ صَلاتَنَا هَذِهِ لا يُصْلِحُ فِيهَا شَيْءٌ مِنْ كَلامِ النَّاسِ إِنَّمَا هِيَ التَّسْبِيحُ وَالتَّكْبِيرُ وَتِلاوَةُ الْقُرْآنِ ""، ثُمَّ اطَّلَعْتُ غُنَيْمَةً لِي فَذَكَرَ الْحَدِيثَ مُخْتَصَرٌ""","","Sunan al-Kubra al-Nasai 556","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ أَخْبَرَنَا الْفَضْلُ بْنُ مُوسَى قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو قَالَ حَدَّثَنَا أَبُو سَلَمَةُ عَنْ أَبِي هُرَيْرَةَ","The Book of Forgetfulness"
"557","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ ، قَالَ : أنبا عَبْدُ اللَّهِ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، عَنِ الْحَارِثِ بْنِ شُبَيْلٍ ، عَنْ أَبِي عَمْرٍو الشَّيْبَانِيِّ ، عَنْ زَيْدِ بْنِ أَرْقَمَ ، قَالَ : كُنَّا فِي عَهْدِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُكَلِّمُ أَحَدُنَا صَاحِبَهُ فِي الصَّلاةِ فِي حَاجَتِهِ ، حَتَّى نَزَلَتْ هَذِهِ الآيَةُ  حَافِظُوا عَلَى الصَّلَوَاتِ وَالصَّلاةِ الْوُسْطَى وَقُومُوا لِلَّهِ قَانِتِينَ فَأُمِرْنَا حِينَئِذٍ بِالسُّكُوتِ """"""","Sahih|Sahih|Sahih Muslim","Sunan al-Kubra al-Nasai 557","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا عَبْثَرٌ هُوَ ابْنُ الْقَاسِمِ أَبُو زُبَيْدٍ الْكُوفِيِّ عَنِ الْأَعْمَشِ عَنِ الْمُسَيِّبِ بْنِ رَافِعٍ عَنْ تَمِيمِ بْنِ طَرَفَةَ عَنْ جَابِرِ بْنِ سَمُرَةَ قَالَ","The Book of Forgetfulness"
"558","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ عَمَّارٍ الْمُوصِلِيُّ ، قَالَ : حَدَّثَنَا ابْنُ أَبِي غَنِيَّةَ ، وَالْقَاسِمُ ، عَنْ سُفْيَانَ ، عَنِ الزُّبَيْرِ بْنِ عَدِيٍّ ، عَنْ كُلْثُومٍ ، عَنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ ، وَهَذَا حَدِيثُ الْقَاسِمِ ، قَالَ : كُنْتُ آتِي النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يُصَلِّي ، فَأُسَلِّمُ عَلَيْهِ ، فَيَرُدُّ عَلَيَّ ، فَأَتَيْتُهُ فَسَلَّمْتُ عَلَيْهِ وَهُوَ يُصَلِّي فَلَمْ يُرِدَّ عَلَيَّ ، فَلَمَّا سَلَّمَ أَشَارَ إِلَى الْقَوْمِ ، فَقَالَ : إِنَّ اللَّهَ ، يَعْنِي ، أَحْدَثَ فِي الصَّلاةِ إِلا تَكَلَّمُوا إِلا بِذِكْرِ اللَّهِ ، وَمَا يَنْبَغِي لَكُمْ ، وَأَنْ تَقُومُوا لِلَّهِ قَانِتِينَ """"""","","Sunan al-Kubra al-Nasai 558","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ أَخْبَرَنَا سُفْيَانُ عَنِ الزُّهْرِيِّ وأَخْبَرَنَا مُحَمَّدُ بْنُ مَنْصُورٍ عَنْ سُفْيَانَ قَالَ حَدَّثَنَا الزُّهْرِيُّ عَنْ عُرْوَةَ عَنْ عَائِشَةَ","The Book of Forgetfulness"
"559","أَخْبَرَنَا الْحُسَيْنُ بْنُ حُرَيْثٍ ، قَالَ : أنبا سُفْيَانُ ، عَنْ عَاصِمٍ ، عَنْ أَبِي وَائِلٍ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : كُنَّا نُسَلِّمُ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَيَرُدُّ عَلَيْنَا السَّلامَ ، حَتَّى قَدِمْنَا مِنْ أَرْضِ الْحَبَشَةِ ، فَسَلَّمْتُ عَلَيْهِ فَلَمْ يُرِدَّ عَلَيَّ ، فَأَخَذَنِي مَا قَرُبَ وَمَا بَعُدَ ، فَجَلَسْتُ حَتَّى إِذَا قَضَى الصَّلاةِ ، قَالَ : إِنَّ اللَّهَ يُحْدِثُ مِنْ أَمْرِهِ مَا يَشَاءُ ، وَقَدْ أَحْدَثَ مِنْ أَمْرِهِ أَنْ لا يُتَكَلَّمَ فِي الصَّلاةِ """"""","","Sunan al-Kubra al-Nasai 559","","أَخْبَرَنَا كَثِيرُ بْنُ عُبَيْدِ الْحِمْصِيُّ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ حَرْبٍ عَنِ الزُّبَيْدِيِّ عَنِ الزُّهْرِيِّ عَنْ أَبِي سَلَمَةَ أَنَّ أَبَا هُرَيْرَةَ قَالَ","The Book of Forgetfulness"
"560","أَخْبَرَنَا سُلَيْمَانُ بْنُ عُبَيْدِ اللَّهِ الْغَيْلانِيُّ ، قَالَ : حَدَّثَنَا بَهْزٌ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنْ سَعْدِ بْنِ إِبْرَاهِيمَ ، أَنَّهُ سَمِعَ أَبَا سَلَمَةَ ، يُحَدِّثُ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى الظُّهْرَ رَكْعَتَيْنِ ثُمَّ سَلَّمَ ، فَقَالُوا : أَقَصُرَتِ الصَّلاةُ ، فَقَامَ فَصَلَّى رَكْعَتَيْنِ ثُمَّ سَلِمَ ، ثُمَّ سَجَدَ سَجْدَتَيْنِ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : لا أَعْلَمُ أَحَدًا ذَكَرَ عَنْ أَبِي سَلَمَةَ فِي هَذَا الحَدِيثِ "" ثُمَّ سَجَدَ سَجْدَتَيْنِ "" غَيْرَ سَعْدٍ""","","Sunan al-Kubra al-Nasai 560","","أَخْبَرَنَا عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ الزُّهْرِيِّ الْبَصْرِيِّ قَالَ حَدَّثَنَا سُفْيَانُ قَالَ أَحْفَظْهُ مِنَ الزُّهْرِيِّ قَالَ أَخْبَرَنِي سَعِيدٌ عَنْ أَبِي هُرَيْرَةَ أَنَّ أَعْرَابِيًّا دَخَلَ الْمَسْجِدَ فَصَلَّى رَكْعَتَيْنِ ثُمَّ قَالَ اللهُمَّ ارْحَمْنِي وَمُحَمَّدًا وَلَا تُرْحَمْ مَعَنَا أَحَدًا فَقَالَ","The Book of Forgetfulness"
"561","أَخْبَرَنَا عِيسَى بْنُ حَمَّادٍ ، قَالَ : أنبا اللَّيْثُ ، عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ ، عَنْ عِمْرَانَ بْنِ أَبِي أَنَسٍ ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى يَوْمًا فَسَلَّمَ فِي رَكْعَتَيْنِ ، ثُمَّ انْصَرَفَ فَأَدْرَكَهُ ذُو الشِّمَالَيْنِ ، فَقَالَ : يَا رَسُولَ اللَّهِ ، أَنَقَصَتِ الصَّلاةُ أَمْ نَسِيتَ ؟ قَالَ : لَمْ تَنْقُصِ الصَّلاةُ ، وَلَمْ أَنَسَ ، قَالَ : بَلَى ، وَالَّذِي بَعَثَكَ بِالْحَقِّ ، قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَصَدَقَ ذُو الْيَدَيْنِ ؟ ، قَالُوا نَعَمْ ، فَصَلَّى بِالنَّاسِ رَكْعَتَيْنِ """"""","","Sunan al-Kubra al-Nasai 561","","أَخْبَرَنَا إِسْحَاقُ بْنُ مَنْصُورٍ قَالَ أَخْبَرَنَا مُحَمَّدُ بْنُ يُوسُفَ قَالَ حَدَّثَنَا الْأَوْزَاعِيُّ قَالَ حَدَّثَنِي يَحْيَى بْنُ أَبِي كَثِيرٍ عَنْ هِلَالِ بْنِ أَبِي مَيْمُونَةَ قَالَ حَدَّثَنِي عَطَاءُ بْنُ يَسَارٍ عَنْ مُعَاوِيَةَ بْنِ الْحَكَمِ السَّلَمِيِّ قَالَ","The Book of Forgetfulness"
"562","أَخْبَرَنَا إِبْرَاهِيمُ بْنُ يَعْقُوبَ ، قَالَ : حَدَّثَنَا الْحَسَنُ بْنُ مُوسَى قَالَ : حَدَّثَنَا شَيْبَانُ ، قَالَ : حَدَّثَنَا يَحْيَى بْنُ أَبِي كَثِيرٍ ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : بَيْنَمَا أَنَا أُصَلِّي مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلاةَ الظُّهْرِ فَسَلَّمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ رَكْعَتَيْنِ ، فَقَامَ رَجُلٌ مِنْ بَنِي سُلَيْمٍ ، فَقَالَ : يَا رَسُولَ اللَّهِ ، أَقَصُرَتِ الصَّلاةُ أَمْ نَسِيتَ ؟ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لَمْ تُقْصَرْ وَلَمْ أَنَسَ ، فَقَالَ : يَا رَسُولَ اللَّهِ ، إِنَّمَا صَلَّيْتَ رَكْعَتَيْنِ ، قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَحَقٌّ مَا يَقُولُ ذُو الْيَدَيْنِ ؟ ، قَالُوا : نَعَمْ ، فَصَلَّى بِهِمْ رَكْعَتَيْنِ """"""","","Sunan al-Kubra al-Nasai 562","","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ قَالَ أَخْبَرَنَا عَبْدُ اللهِ عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ عَنِ الْحَارِثِ بْنِ شُبَيْلٍ عَنْ أَبِي عَمْرٍو الشَّيْبَانِيِّ عَنْ زَيْدِ بْنِ أَرْقَمَ قَالَ","The Book of Forgetfulness"
"563","أَخْبَرَنَا أَحْمَدُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا حَبَّانُ بْنُ هِلالٍ ، قَالَ : حَدَّثَنَا أَبَانُ بْنُ يَزِيدَ الْعَطَّارُ ، قَالَ : حَدَّثَنِي يَحْيَى بْنُ أَبِي كَثِيرٍ ، قَالَ : حَدَّثَنِي أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى بِأَصْحَابِهِ فَسَلَّمَ فِي رَكْعَتَيْنِ ، فَقَالَ رَجُلٌ يُقَالُ لَهُ ذُو الْيَدَيْنِ ، وَكَانَ طَوِيلَ الْيَدَيْنِ : يَا رَسُولَ اللَّهِ ، أَقَصُرَتِ الصَّلاةُ أَمْ نَسِيتَ ؟ ، قَالَ : مَا قَصُرَتِ الصَّلاةُ وَمَا نَسِيتُ ، قَالَ : مَا يَقُولُ ذُو الْيَدَيْنِ ؟ ، قَالُوا : صَدَقَ ، فَصَلَّى بِهِمْ رَكْعَتَيْنِ """"""","Sahih|Sahih|Daif","Sunan al-Kubra al-Nasai 563","","أَخْبَرَنِي مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عَمَّارٍ الْمُوصِلِيُّ قَالَ حَدَّثَنَا ابْنُ أَبِي غَنِيَّةَ وَالْقَاسِمُ عَنْ سُفْيَانَ عَنِ الزُّبَيْرِ بْنِ عَدِيٍّ عَنْ كُلْثُومٍ عَنْ عَبْدِ اللهِ بْنِ مَسْعُودٍ وَهَذَا حَدِيثُ الْقَاسِمِ قَالَ","The Book of Forgetfulness"
"564","أَخْبَرَنَا هَارُونُ بْنُ مُوسَى ، قَالَ : حَدَّثَنَا أَبُو ضَمْرَةَ ، عَنْ يُونُسَ ، عَنِ ابْنِ شِهَابٍ ، قَالَ : أَخْبَرَنِي أَبُو سَلَمَةَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : نَسِيَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَسَلَّمَ فِي سَجْدَتَيْنِ ، فَقَالَ لَهُ ذُو الشِّمَالَيْنِ : أَقَصُرَتِ الصَّلاةُ أَمْ نَسِيتَ يَا رَسُولَ اللَّهِ ؟ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَصَدَقَ ذُو الْيَدَيْنِ ؟ قَالُوا : نَعَمْ ، فَقَامَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَأَتَمَّ الصَّلاةَ """"""","","Sunan al-Kubra al-Nasai 564","","أَخْبَرَنَا الْحُسَيْنُ بْنُ حُرَيْثٍ قَالَ أَخْبَرَنَا سُفْيَانُ عَنْ عَاصِمٍ عَنْ أَبِي وَائِلٍ عَنِ ابْنِ مَسْعُودٍ قَالَ","The Book of Forgetfulness"
"565","أَخْبَرَنَا مُحَمَّدُ بْنُ رَافِعٍ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، قَالَ أنبا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : صَلَّى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الظُّهْرَ أَوِ الْعَصْرَ فَسَلَّمَ فِي رَكْعَتَيْنِ ، فَقَالَ لَهُ ذُو الشِّمَالَيْنِ بْنُ عَمْرٍو : أَنَقَصَتِ الصَّلاةُ أَمْ نَسِيتَ ؟ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَا يَقُولُ ذُو الْيَدَيْنِ ؟ ، قَالُوا : صَدَقَ يَا نَبِيَّ اللَّهِ ، فَأَتَمَّ بِهِمُ الرَّكْعَتَيْنِ اللَّتَيْنِ نَقَصَ ""، أَخْبَرَنَا أَبُو دَاوُدَ ، قَالَ : حَدَّثَنَا يَعْقُوبُ ، قَالَ : حَدَّثَنَا أَبِي ، عَنْ صَالِحٍ ، عَنِ ابْنِ شِهَابٍ ، أَنَّ أَبَا بَكْرِ بْنَ سُلَيْمَانَ بْنِ أَبِي حَثْمَةَ أَخْبَرَهُ أَنَّهُ ، بَلَغَهُ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" صَلَّى رَكْعَتَيْنِ ، فَقَالَ لَهُ ذُو الشِّمَالَيْنِ نَحْوَهُ . قَالَ ابْنُ شِهَابٍ : أَخْبَرَنِي هَذَا الْخَبَرَ سَعِيدُ بْنُ الْمُسَيِّبِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : وَأَخْبَرَنِيه أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ ، وَأَبُو بَكْرِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ وَهُوَ ابْنُ هِشَامٍ ، وَعُبَيْدُ اللَّهِ بْنُ عَبْدِ اللَّهِ ، أنبا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ عَبْدِ الْحَكَمِ ، عَنْ شُعَيْبٍ ، قَالَ : أنبا اللَّيْثُ ، عَنْ عُقَيْلٍ ، قَالَ : حَدَّثَنِي ابْنُ شِهَابٍ ، عَنْ سَعِيدٍ ، وَأَبِي سَلَمَةَ ، وَأَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ ، وَابْنِ أَبِي حَثْمَةَ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّهُ "" لَمْ يَسْجُدْ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَوْمَئِذٍ قَبْلَ السَّلامِ ، وَلا بَعْدَهُ """"""","","Sunan al-Kubra al-Nasai 565","","أَخْبَرَنَا سُلَيْمَانُ بْنُ عُبَيْدِ اللهِ الْغَيْلَانِيُّ قَالَ حَدَّثَنَا بَهْزٌ قَالَ حَدَّثَنَا شُعْبَةُ عَنْ سَعْدِ بْنِ إِبْرَاهِيمَ أَنَّهُ سَمِعَ أَبَا سَلَمَةَ يُحَدِّثُ عَنْ أَبِي هُرَيْرَةَ","The Book of Forgetfulness"
"566","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ ، قَالَ : أنبا عَبْدُ اللَّهِ ، عَنْ عِكْرِمَةَ بْنِ عَمَّارٍ ، قَالَ : أنبا ضَمْضَمُ بْنُ جَوْسٍ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : سَجَدَ سَجْدَتَيِ السَّهْوِ وَهُوَ جَالِسٌ ثُمَّ سَلِمَ ""، ذَكَرَهُ فِي حَدِيثِ ذِي الْيَدَيْنِ""","Sahih|Sahih|Isnaad Sahih","Sunan al-Kubra al-Nasai 566","","أَخْبَرَنَا عِيسَى بْنُ حَمَّادٍ قَالَ أَخْبَرَنَا اللَّيْثُ عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ عَنْ عِمْرَانَ بْنِ أَبِي أَنَسٍ عَنْ أَبِي سَلَمَةَ عَنْ أَبِي هُرَيْرَةَ","The Book of Forgetfulness"
"567","أَخْبَرَنَا إِبْرَاهِيمُ بْنُ يَعْقُوبٍ ، قَالَ : أَخْبَرَنِي الْحَسَنُ بْنُ مُوسَى قَالَ : أنبا شَيْبَانُ ، قَالَ : حَدَّثَنَا يَحْيَى بْنُ أَبِي كَثِيرٍ ، حَدَّثَنِي ضَمْضَمُ بْنُ جَوْسٍ ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ ، يَقُولُ : سَجَدَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سَجْدَتَيْنِ """"""","","Sunan al-Kubra al-Nasai 567","","أَخْبَرَنِي إِبْرَاهِيمُ بْنُ يَعْقُوبَ قَالَ حَدَّثَنَا الْحَسَنُ بْنُ مُوسَى قَالَ حَدَّثَنَا شَيْبَانُ قَالَ حَدَّثَنَا يَحْيَى بْنُ أَبِي كَثِيرٍ عَنْ أَبِي سَلَمَةَ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Forgetfulness"
"568","أَخْبَرَنَا عَمْرُو بْنُ سَوَادِ بْنِ الأَسْوَدِ بْنِ عَمْرٍو ، قَالَ : أنبا عَبْدُ اللَّهِ بْنُ وَهْبٍ ، قَالَ : أنبا اللَّيْثُ بْنُ سَعْدٍ ، عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ ، عَنْ جَعْفَرِ بْنِ رَبِيعَةَ ، عَنْ عِرَاكِ بْنِ مَالِكٍ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : سَجَدَ يَوْمَ ذِي الْيَدَيْنِ سَجْدَتَيْنِ بَعْدَ السَّلامِ ""، أَخْبَرَنَا عَمْرُو بْنُ سَوَادٍ ، قَالَ : أنبا ابْنُ وَهْبٍ ، قَالَ : أنبا عَمْرِو بْنِ الْحَارِثِ ، قَالَ : حَدَّثَنِي قَتَادَةُ ، عَنْ مُحَمَّدِ بْنِ سِيرِينَ ، عَنْ أَبِي هُرَيْرَةَ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِهِ""","","Sunan al-Kubra al-Nasai 568","","أَخْبَرَنَا أَحْمَدُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا حَبَّانُ بْنُ هِلَالٍ قَالَ حَدَّثَنَا أَبَانُ بْنُ يَزِيدَ الْعَطَّارُ قَالَ حَدَّثَنِي يَحْيَى بْنُ أَبِي كَثِيرٍ قَالَ حَدَّثَنِي أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ عَنْ أَبِي هُرَيْرَةَ","The Book of Forgetfulness"
"569","أَخْبَرَنَا مُحَمَّدُ بْنُ سَلَمَةَ ، قَالَ : أنبا ابْنُ الْقَاسِمِ ، عَنْ مَالِكٍ ، قَالَ : حَدَّثَنِي أَيُّوبُ ، عَنْ مُحَمَّدِ بْنِ سِيرِينَ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : انْصَرَفَ مِنَ اثْنَتَيْنِ ، فَقَالَ لَهُ ذُو الْيَدَيْنِ : أَقَصُرَتِ الصَّلاةُ ، أَمْ نَسِيتَ يَا رَسُولَ اللَّهِ ؟ فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَصَدَقَ ذُو الْيَدَيْنِ ؟ فَقَالَ النَّاسُ : نَعَمْ ، فَقَامَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَصَلَّى اثْنَتَيْنِ ، ثُمَّ سَلَّمَ ، ثُمَّ كَبَّرَ ، فَسَجَدَ مِثْلَ سُجُودِهِ أَوْ أَطْوَلَ ، ثُمَّ رَفَعَ رَأْسَهُ ، فَسَجَدَ مِثْلَ سُجُودِهِ ، أَوْ أَطْوَلَ ثُمَّ رَفَعَ """"""","","Sunan al-Kubra al-Nasai 569","","أَخْبَرَنَا هَارُونُ بْنُ مُوسَى قَالَ حَدَّثَنَا أَبُو ضَمْرَةَ عَنْ يُونُسَ عَنِ ابْنِ شِهَابٍ قَالَ أَخْبَرَنِي أَبُو سَلَمَةَ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Forgetfulness"
"570","أَخْبَرَنَا حُمَيْدُ بْنُ مَسْعَدَةَ ، قَالَ : حَدَّثَنَا يَزِيدُ وَهُوَ بْنُ زُرَيْعٍ ، قَالَ : حَدَّثَنَا ابْنُ عَوْنٍ ، عَنْ مُحَمَّدِ بْنِ سِيرِينَ ، قَالَ : قَالَ أَبُو هُرَيْرَةَ :صَلَّى بِنَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِحْدَى صَلاتِي الْعَشِيِّ ، قَالَ أَبُو هُرَيْرَةَ : وَلَكِنِّي نَسِيتُ ، قَالَ :  فَصَلَّى بِنَا رَكْعَتَيْنِ ، ثُمَّ سَلَّمَ ، فَانْطَلَقَ إِلَى خَشَبَةٍ مَعْرُوضَةٍ فِي الْمَسْجِدِ ، فَقَالَ بِيَدِهِ عَلَيْهَا كَأَنَّهُ غَضْبَانُ ، وَخَرَجَتِ السَّرَعَانُ مِنْ أَبْوَابِ الْمَسْجِدِ ، فَقَالُوا : قَصُرَتِ الصَّلاةُ ؟ ، وَفِي الْقَوْمِ أَبُو بَكْرٍ وَعُمَرَ فَهَابَا أَنْ يُكَلِّمَاهُ ، وَفِي الْقَوْمِ رَجُلٌ فِي يَدَيْهِ طُولٌ ، قَالَ : وَكَانَ يُسَمَّى ذَا الْيَدَيْنِ ، فَقَالَ : يَا رَسُولَ اللَّهِ أَنَسِيتَ أَمْ قَصُرَتِ الصَّلاةُ ؟ ، قَالَ : لَمْ أَنَسَ ، وَلَمْ تَقْصُرِ الصَّلاةُ ، قَالَ : وَقَالَ : أَكَمَا يَقُولُ ذُو الْيَدَيْنِ ؟ قَالُوا : نَعَمْ ، فَجَاءَ فَصَلَّى الَّذِي كَانَ تَرَكَ ثُمَّ سَلَّمَ ، ثُمَّ كَبَّرَ ، ثُمَّ سَجَدَ مِثْلَ سُجُودِهِ ، أَوْ أَطْوَلَ ثُمَّ رَفَعَ رَأْسَهُ ، وَكَبِّرَ ثُمَّ كَبَّرَ فَسَجَدَ مِثْلَ سُجُودِهِ ، أَوْ أَطْوَلَ ثُمَّ رَفَعَ رَأْسَهُ فَكَبَّرَ """"""","","Sunan al-Kubra al-Nasai 570","","أَخْبَرَنَا مُحَمَّدُ بْنُ رَافِعٍ قَالَ حَدَّثَنَا عَبْدُ الرَّزَّاقِ قَالَ أَخْبَرَنَا مَعْمَرٌ عَنِ الزُّهْرِيِّ عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ وَأَبِي بَكْرِ بْنِ سُلَيْمَانَ بْنِ أَبِي حَثْمَةَ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Forgetfulness"
"571","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، عَنْ مَالِكٍ ، عَنْ دَاوُدَ بْنِ الْحُصَيْنِ ، عَنْ أَبِي سُفْيَانَ مَوْلَى ابْنِ أَبِي أَحْمَدَ قَالَ : سَمِعْتُ أَبَا هُرَيْرَةَ ، يَقُولُ : صَلَّى بِنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، صَلاةَ الْعَصْرِ فَسَلَّمَ فِي رَكْعَتَيْنِ ، فَقَامَ ذُو الْيَدَيْنِ ، فَقَالَ : أَقَصُرَتِ الصَّلاةُ يَا رَسُولَ اللَّهِ أَمْ نَسِيتَ ؟ فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : كُلُّ ذَلِكَ لَمْ يَكُنْ ، فَقَالَ : كَانَ بَعْضُ ذَلِكَ يَا رَسُولَ اللَّهِ ، فَأَقْبَلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى النَّاسِ ، فَقَالَ : أَصَدَقَ ذُو الْيَدَيْنِ ؟ ، فَقَالُوا : نَعَمْ ، فَأَتَمَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَا بَقِيَ مِنَ الصَّلاةِ ثُمَّ سَجَدَ سَجْدَتَيْنِ ، وَهُوَ جَالِسٌ بَعْدَ التَّسْلِيمِ """"""","","Sunan al-Kubra al-Nasai 571","","","The Book of Forgetfulness"
"572","أَخْبَرَنَا أَبُو الأَشْعَثِ ، عَنْ يَزِيدَ بْنِ زُرَيْعٍ ، قَالَ : حَدَّثَنَا خَالِدٌ الْحَذَّاءُ ، عَنْ أَبِي قِلابَةَ ، عَنْ أَبِي الْمُهَلَّبِ ، عَنْ عِمْرَانَ بْنِ الْحُصَيْنِ ، قَالَ : سَلَّمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ ثَلاثِ رَكَعَاتٍ مِنَ الْعَصْرِ ، فَدَخَلَ فَقَامَ إِلَيْهِ رَجُلٌ يُقَالُ لَهُ الْخِرْبَاقُ ، فَقَالَ : الصَّلاةُ يَا رَسُولَ اللَّهِ ، فَخَرَجَ مُغْضِبًا يَجُرُّ رِدَاءَهُ ، فَقَالَ : أَصَدَقَ ؟ ، قَالُوا : نَعَمْ ، فَقَامَ فَصَلَّى تِلْكَ الرَّكْعَةَ ، ثُمَّ سَلَّمَ ثُمَّ سَجَدَ سَجْدَتَهَا ثُمَّ سَلَّمَ """"""","","Sunan al-Kubra al-Nasai 572","","","The Book of Forgetfulness"
"573","أَخْبَرَنَا أَحْمَدُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا وَهْبُ بْنُ جَرِيرٍ ، قَالَ : حَدَّثَنَا أَبِي ، قَالَ : سَمِعْتُ الأَعْمَشَ ، يُحَدِّثُ عَنْ إِبْرَاهِيمَ ، عَنْ عَلْقَمَةَ ، عَنْ عَبْدِ اللَّهِ ، أَنَّهُ صَلَّى خَمْسًا فَذَكَرَ فِي السَّادِسَةِ فَجَلَسَ ، وَسَجَدَ سَجْدَتَيْنِ "" ، وَقَالَ : هَكَذَا صَنَعَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ""","","Sunan al-Kubra al-Nasai 573","","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ قَالَ أَخْبَرَنَا عَبْدُ اللهِ عَنْ عِكْرِمَةَ بْنِ عَمَّارٍ قَالَ أَخْبَرَنَا ضَمْضَمُ بْنُ جَوْسٍ عَنْ أَبِي هُرَيْرَةَ","The Book of Forgetfulness"
"574","أَخْبَرَنَا عَبْدَةُ بْنُ عَبْدِ الرَّحِيمِ ، قَالَ : أنبا ابْنُ شُمَيْلٍ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنِ الْحَكَمِ ، وَمُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَلْقَمَةَ ، عَنْ عَبْدِ اللَّهِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ صَلَّى بِهِمُ الظُّهْرَ خَمْسًا ، فَقَالُوا : إِنَّكَ صَلَّيْتَ خَمْسًا ، فَسَجَدَ سَجْدَتَيْنِ ، بَعْدَمَا سَلَّمَ وَهُوَ جَالِسٌ ""، أنبا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا أَبُو عَوَانَةَ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى مُرْسَلا""","","Sunan al-Kubra al-Nasai 574","","أَخْبَرَنِي إِبْرَاهِيمُ بْنُ يَعْقُوبٍ قَالَ أَخْبَرَنِي الْحَسَنُ بْنُ مُوسَى قَالَ أَخْبَرَنَا شَيْبَانُ قَالَ يَحْيَى بْنُ أَبِي كَثِيرٍ حَدَّثَنِي ضَمْضَمُ بْنُ جَوْسٍ","The Book of Forgetfulness"
"575","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ ، قَالَ : أنبا عَبْدُ اللَّهِ ، عَنْ أَبِي بَكْرٍ النَّهْشَلِيِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِيهِ ، عَنْ عَبْدِ اللَّهِ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : صَلَّى إِحْدَى صَلاتِي الْعَشِيِّ خَمْسًا ، فَقِيلَ لَهُ : أَزِيدَ فِي الصَّلاةِ ؟ فَقَالَ : وَمَا ذَاكَ ؟ فَقَالُوا : صَلَّيْتَ خَمْسًا ، فَقَالَ : إِنَّمَا أَنَا بَشَرٌ أَنْسَى كَمَا تَنْسَوْنَ ، وَأَذْكُرُ كَمَا تَذْكُرُونَ ، فَسَجَدَ سَجْدَتَيْنِ ثُمَّ انْفَتَلَ """"""","","Sunan al-Kubra al-Nasai 575","","أَخْبَرَنَا عَمْرُو بْنُ سَوَادِ بْنِ الْأَسْوَدِ بْنِ عَمْرٍو قَالَ أَخْبَرَنَا عَبْدُ اللهِ بْنُ وَهْبٍ قَالَ أَخْبَرَنَا اللَّيْثُ بْنُ سَعْدٍ عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ عَنْ جَعْفَرِ بْنِ رَبِيعَةَ عَنْ عِرَاكِ بْنِ مَالِكٍ عَنْ أَبِي هُرَيْرَةَ","The Book of Forgetfulness"
"576","أَخْبَرَنَا الْحَسَنُ بْنُ إِسْمَاعِيلَ بْنِ سُلَيْمَانَ ، قَالَ : أنبا فُضَيْلٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَلْقَمَةَ ، عَنْ عَبْدِ اللَّهِ ، قَالَ : صَلَّى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلاةً فَزَادَ فِيهَا ، أَوْ نَقَصَ ، فَلَمَّا سَلَّمَ قُلْنَا : يَا نَبِيَّ اللَّهِ ، هَلْ حَدَثَ فِي الصَّلاةِ شَيْءٌ ؟ قَالَ : وَمَا ذَاكَ ؟ ، قَالَ : فَذَكَرْنَا لَهُ الَّذِي فَعَلَ ، فَثَنَى رِجْلَهُ فَاسْتَقْبَلَ الْقِبْلَةَ فَسَجَدَ سَجْدَتَيِ السَّهْوِ ، ثُمَّ أَقْبَلَ عَلَيْنَا بِوَجْهِهِ ، فَقَالَ : "" لَوْ حَدَثَ فِي الصَّلاةِ شَيْءٌ لأَنْبَأْتُكُمْ بِهِ "" ، ثُمَّ قَالَ : "" إِنَّمَا أَنَا بَشَرٌ ، أَنْسَى كَمَا تَنْسَوْنَ ، فَأَيُّكُمْ مَا نَسِيَ فِي صَلاتِهِ شَيْئًا ، فَلْيَتَحَرَّ الَّذِي يَرَى أَنَّهُ صَوَابٌ ، ثُمَّ يُسَلِّمُ ، ثُمَّ يَسْجُدُ سَجْدَتَيِ السَّهْوِ ""خَالَفَهُ شَقِيقُ بْنُ سَلَمَةَ أَبُو وَائِلٍ ، فَجَعَلَ التَّحَرِّيَ مِنْ قَوْلِ عَبْدِ اللَّهِ""","","Sunan al-Kubra al-Nasai 576","","","The Book of Forgetfulness"
"577","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ غُنْدَرٌ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنِ الْحَكَمِ ، قَالَ : سَمِعْتُ أَبَا وَائِلٍ ، يُحَدِّثُ ، عَنْ عَبْدِ اللَّهِ ، قَالَ : إِذَا وَهِمْ أَحَدُكُمْ فِي الصَّلاةِ فَلْيَتَحَرَّ الصَّوَابَ ، وَلْيَسْجُدْ سَجْدَتَيْنِ وَهُوَ قَاعِدٌ بَعْدَمَا يُفْرِغُ """"""","Sahih|Sahih|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 577","","أَخْبَرَنَا مُحَمَّدُ بْنُ سَلَمَةَ قَالَ أَخْبَرَنَا ابْنُ الْقَاسِمِ عَنْ مَالِكٍ قَالَ حَدَّثَنِي أَيُّوبُ عَنْ مُحَمَّدِ بْنِ سِيرِينَ عَنْ أَبِي هُرَيْرَةَ","The Book of Forgetfulness"
"578","أَخْبَرَنَا عِمْرَانُ بْنُ يَزِيدَ ، قَالَ : حَدَّثَنَا عَبْدُ الْعَزِيزِ ، قَالَ : حَدَّثَنَا زَيْدُ بْنُ أَسْلَمَ ، عَنْ عَطَاءِ بْنِ يَسَارٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : إِذَا شَكَّ أَحَدُكُمْ فِي صَلاتِهِ فَلَمْ يَدْرِ أَصَلَّى ثَلاثًا ، أَوْ أَرْبَعًا ، فَلْيَقُمْ فَلْيَرْكَعْ ، يَعْنِي رَكْعَةً ، وَيَسْجُدُ سَجْدَتَيْنِ ، فَإِنْ كَانَتْ خَامِسَةً شَفَعَهُمَا بِسَجْدَتَيْنِ ، وَإِنْ كَانَتْ رَابِعَةٌ كَانَتِ السَّجْدَتَانِ تَرْغِيمًا لِلشَّيْطَانِ """"""","","Sunan al-Kubra al-Nasai 578","","أَخْبَرَنَا حُمَيْدُ بْنُ مَسْعَدَةَ قَالَ حَدَّثَنَا يَزِيدُ وَهُوَ ابْنُ زُرَيْعٍ قَالَ حَدَّثَنَا ابْنُ عَوْنٍ عَنْ مُحَمَّدِ بْنِ سِيرِينَ قَالَ","The Book of Forgetfulness"
"579","أَخْبَرَنَا يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ ، قَالَ : حَدَّثَنَا خَالِدٌ هُوَ ابْنُ الْحَارِثِ ، عَنِ ابْنِ عَجْلانَ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ عَطَاءٍ ، عَنْ أَبِي سَعِيدٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : إِذَا شَكَّ أَحَدُكُمْ فِي صَلاتِهِ فَلْيُلْغِ الشَّكَّ ، وَلْيَبْقَ عَلَى الْيَقِينِ ، فَإِذَا اسْتَيْقَنَ بِالتَّمَامِ ، فَلْيَسْجُدْ سَجْدَتَيْنِ وَهُوَ قَاعِدٌ """"""","Sahih|Sahih|Sahih Muslim","Sunan al-Kubra al-Nasai 579","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ عَنْ مَالِكٍ عَنْ دَاوُدَ بْنِ الْحُصَيْنِ عَنْ أَبِي سُفْيَانَ مَوْلَى ابْنِ أَبِي أَحْمَدَ قَالَ","The Book of Forgetfulness"
"580","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ ، قَالَ : حَدَّثَنَا يَحْيَى بْنُ مُحَمَّدِ بْنِ قَيْسٍ أَبُو زُكَيْرٍ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ عَطَاءِ بْنِ يَسَارٍ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : إِذَا شَكَّ أَحَدُكُمْ فَلَمْ يَدْرِ أَصَلَّى ثَلاثًا ، أَمْ أَرْبَعًا ، فَلْيُصَلِّ رَكْعَةً تَامَّةً ثُمَّ يَسْجُدْ سَجْدَتَيْنِ ، وَهُوَ جَالِسٌ فَإِنْ كَانَتِ الرَّكْعَةُ خَامِسَةً شَفَعَ بِهَاتَيْنِ السَّجْدَتَيْنِ ، وَإِنْ كَانَتْ رَابِعَةً كَانَتَا تَرْغِيمًا لِلشَّيْطَانِ ""خَالَفَهُ عِيَاضُ بْنُ هِلالٍ فِي لَفْظِهِ""","Sahih|Sahih|Sahih Muslim","Sunan al-Kubra al-Nasai 580","","أَخْبَرَنَا أَبُو الْأَشْعَثِ عَنْ يَزِيدَ بْنِ زُرَيْعٍ قَالَ حَدَّثَنَا خَالِدٌ الْحَذَّاءُ عَنْ أَبِي قِلَابَةَ عَنْ أَبِي الْمُهَلَّبِ عَنْ عِمْرَانَ بْنِ الْحُصَيْنِ قَالَ","The Book of Forgetfulness"
"581","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ ، قَالَ : حَدَّثَنَا خَالِدٌ يَعْنِي ابْنَ الْحَارِثِ ، قَالَ : حَدَّثَنَا هِشَامٌ هُوَ الدَّسْتُوَائِيُّ ، عَنْ يَحْيَى هُوَ ابْنُ أَبِي كَثِيرٍ ، عَنْ عِيَاضٍ ، قَالَ : سَأَلْتُ أَبَا سَعِيدٍ الْخُدْرِيِّ ، قُلْتُ : يُصَلِّي أَحَدُنَا فَلا يَدْرِي كَمْ صَلَّى ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا صَلَّى أَحَدُكُمْ فَلَمْ يَدْرِ كَمْ صَلَّى ، فَلْيَسْجُدْ سَجْدَتَيْنِ وَهُوَ جَالِسٌ """"""","","Sunan al-Kubra al-Nasai 581","","أَخْبَرَنَا أَحْمَدُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا وَهْبُ بْنُ جَرِيرٍ قَالَ حَدَّثَنَا أَبِي قَالَ سَمِعْتُ الْأَعْمَشَ يُحَدِّثُ عَنْ إِبْرَاهِيمَ عَنْ عَلْقَمَةَ عَنْ عَبْدِ اللهِ أَنَّهُ §صَلَّى خَمْسًا فَذَكَرَ فِي السَّادِسَةِ فَجَلَسَ وَسَجَدَ سَجْدَتَيْنِ","The Book of Forgetfulness"
"582","أَخْبَرَنَا إِبْرَاهِيمُ بْنُ يَعْقُوبَ ، قَالَ : حَدَّثَنَا الْحَسَنُ بْنُ مُوسَى قَالَ : حَدَّثَنَا شَيْبَانُ ، عَنْ يَحْيَى ، قَالَ : حَدَّثَنِي عِيَاضُ بْنُ هِلالٍ الأَنْصَارِيُّ ، قَالَ : سَمِعْتُ أَبَا سَعِيدٍ الْخُدْرِيِّ ، يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا صَلَّى أَحَدُكُمْ فَنَسِيَ "" ، أَوْ قَالَ : "" فَلَمْ يَدْرِ زَادَ أَمْ نَقَصَ ، فَلْيَسْجُدْ سَجْدَتَيْنِ ، وَهُوَ جَالِسٌ """"""","","Sunan al-Kubra al-Nasai 582","","أَخْبَرَنَا عَبْدَةُ بْنُ عَبْدِ الرَّحِيمِ قَالَ أَخْبَرَنَا ابْنُ شُمَيْلٍ قَالَ أَخْبَرَنَا شُعْبَةُ عَنِ الْحَكَمِ وَمُغِيرَةَ عَنْ إِبْرَاهِيمَ عَنْ عَلْقَمَةَ عَنْ عَبْدِ اللهِ","The Book of Forgetfulness"
"583","أَخْبَرَنَا شُعَيْبُ بْنُ شُعَيْبِ بْنِ إِسْحَاقَ ، قَالَ : حَدَّثَنَا عَبْدُ الْوَهَّابِ ، قَالَ : حَدَّثَنَا شُعَيْبُ ، قَالَ : حَدَّثَنَا الأَوْزَاعِيُّ ، قَالَ : حَدَّثَنِي يَحْيَى ، أَنَّ عِيَاضَ بْنَ هِلالٍ ، حَدَّثَهُ ، قَالَ : سَمِعْتُ أَبَا سَعِيدٍ ، يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا سَهَا أَحَدُكُمْ فِي صَلاتِهِ ، فَلَمْ يَدْرِ زَادَ أَوْ نَقَصَ ، فَلْيَسْجُدْ سَجْدَتَيْنِ ، وَهُوَ جَالِسٌ ""خَالَفَهُ بَقِيَّةُ""","","Sunan al-Kubra al-Nasai 583","","","The Book of Forgetfulness"
"584","أَخْبَرَنَا عَمْرُو بْنُ عُثْمَانَ ، عَنْ بَقِيَّةَ ، عَنِ الأَوْزَاعِيِّ ، عَنْ يَحْيَى ، أَنَّ عِيَاضَ بْنَ هِلالٍ ، حَدَّثَهُ ، قَالَ : سَمِعْتُ أَبَا سَعِيدٍ الْخُدْرِيِّ ، يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا سَهَا أَحَدُكُمْ فِي صَلاتِهِ فَلا يَدْرِي أَزَادَ أَوْ نَقَصَ ، فَلْيَسْجُدْ سَجْدَتَيْنِ وَهُوَ جَالِسٌ ""خَالَفَهُمْ عِكْرِمَةُ بْنُ عَمَّارٍ""","Hasan Sahih|Hasan Sahih|Sahih Muslim","Sunan al-Kubra al-Nasai 584","","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ قَالَ أَخْبَرَنَا عَبْدُ اللهِ عَنْ أَبِي بَكْرٍ النَّهْشَلِيِّ عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ عَنْ أَبِيهِ عَنْ عَبْدِ اللهِ","The Book of Forgetfulness"
"585","أَخْبَرَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : أنبا عُمَرُ بْنُ يُونُسَ ، قَالَ : حَدَّثَنَا عِكْرِمَةُ بْنُ عَمَّارٍ ، قَالَ : حَدَّثَنَا يَحْيَى ، قَالَ : حَدَّثَنِي هِلالُ بْنُ عِيَاضٍ الأَنْصَارِيُّ ، قَالَ : حَدَّثَنِي أَبُو سَعِيدٍ الْخُدْرِيِّ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا صَلَّى أَحَدُكُمْ فَلا يَدْرِي أَزَادَ أَوْ نَقَصَ ، فَلْيَسْجُدْ سَجْدَتَيْنِ وَهُوَ جَالِسٌ ثُمَّ يُسَلِّمُ """"""","","Sunan al-Kubra al-Nasai 585","","أَخْبَرَنِي الْحَسَنُ بْنُ إِسْمَاعِيلَ بْنِ سُلَيْمَانَ قَالَ أَخْبَرَنَا فُضَيْلٌ عَنْ مَنْصُورٍ عَنْ إِبْرَاهِيمَ عَنْ عَلْقَمَةَ عَنْ عَبْدِ اللهِ قَالَ","The Book of Forgetfulness"
"586","أَخْبَرَنَا عِمْرَانُ بْنُ يَزِيدَ ، قَالَ : حَدَّثَنَا إِسْمَاعِيلُ بْنُ عَبْدِ اللَّهِ هُوَ ابْنُ سَمَاعَةَ ، عَنِ الأَوْزَاعِيِّ ، قَالَ : حَدَّثَنِي الزُّهْرِيُّ ، وَيَحْيَى ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : إِذَا لَبَّسَ الشَّيْطَانُ عَلَى أَحَدِكُمْ فِي صَلاتِهِ ، فَلَمْ يَدْرِ أَثَلاثًا صَلَّى أَمْ أَرْبَعًا ، فَلْيَسْجُدْ سَجْدَتَيْنِ وَهُوَ جَالِسٌ """"""","","Sunan al-Kubra al-Nasai 586","","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ غُنْدَرٌ قَالَ حَدَّثَنَا شُعْبَةُ عَنِ الْحَكَمِ قَالَ سَمِعْتُ أَبَا وَائِلٍ يُحَدِّثُ عَنْ عَبْدِ اللهِ قَالَ","The Book of Forgetfulness"
"587","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، عَنْ مَالِكٍ ، عَنِ ابْنِ شِهَابٍ ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : إِنَّ أَحَدَكُمْ إِذَا قَامَ لَيُصَلِّي جَاءَهُ الشَّيْطَانُ فَلَبَّسَ عَلَيْهِ حَتَّى لا يَدْرِي كَمْ صَلَّى ، فَإِذَا وَجَدَ ذَلِكَ أَحَدُكُمْ فَلْيَسْجُدْ سَجْدَتَيْنِ وَهُوَ جَالِسٌ """"""","","Sunan al-Kubra al-Nasai 587","","أَخْبَرَنِي عِمْرَانُ بْنُ يَزِيدَ قَالَ حَدَّثَنَا عَبْدُ الْعَزِيزِ قَالَ حَدَّثَنَا زَيْدُ بْنُ أَسْلَمَ عَنْ عَطَاءِ بْنِ يَسَارٍ عَنِ ابْنِ عَبَّاسٍ","The Book of Forgetfulness"
"588","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ ، قَالَ : أنبا عَبْدُ اللَّهِ وَهُوَ ابْنُ الْمُبَارَكِ عَنِ ابْنِ جُرَيْجٍ ، قَالَ : حَدَّثَنِي عَبْدُ اللَّهِ بْنُ مُسَافِعٍ ، عَنْ عُتْبَةَ بْنِ مُحَمَّدِ بْنِ الْحَارِثِ ، عَنْ عَبْدِ اللَّهِ بْنِ جَعْفَرٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ شَكَّ فِي صَلاتِهِ فَلْيَسْجُدْ سَجْدَتَيْنِ بَعْدَمَا يُسَلِّمُ """"""","","Sunan al-Kubra al-Nasai 588","","أَخْبَرَنَا يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ قَالَ حَدَّثَنَا خَالِدٌ هُوَ ابْنُ الْحَارِثِ عَنِ ابْنِ عَجْلَانَ عَنْ زَيْدِ بْنِ أَسْلَمَ عَنْ عَطَاءٍ عَنْ أَبِي سَعِيدٍ","The Book of Forgetfulness"
"589","أَخْبَرَنَا الرَّبِيعُ بْنُ سُلَيْمَانَ ، قَالَ : أنبا شُعَيْبُ بْنُ اللَّيْثِ ، قَالَ : حَدَّثَنَا اللَّيْثُ ، عَنْ محمد بن عجلان عن مُحَمَّدِ بْنِ يُوسُفَ مَوْلَى عُثْمَانَ ، عَنْ أَبِيهِ ، أَنَّ مُعَاوِيَةَ ، صَلَّى أَمَامَهُمْ فَقَامَ فِي الصَّلاةِ وَعَلَيْهِ جُلُوسٌ فَسَبِّحَ النَّاسُ ، فَتَمَّ عَلَى قِيَامِهِ ثُمَّ سَجَدَ بِنَا سَجْدَتَيْنِ وَهُوَ جَالِسٌ بَعْدَ أَنْ أَتَمَّ الصَّلاةَ ، ثُمَّ قَعَدَ عَلَى الْمِنْبَرِ ، فَقَالَ : إِنِّي سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : مَنْ نَسِيَ مِنْ صَلاتِهِ شَيْئًا فَلْيَسْجُدْ مِثْلَ هَاتَيْنِ السَّجْدَتَيْنِ """"""","","Sunan al-Kubra al-Nasai 589","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ قَالَ حَدَّثَنَا يَحْيَى بْنُ مُحَمَّدِ هو ابْنِ قَيْسٍ أَبُو زُكَيْرٍ عَنْ زَيْدِ بْنِ أَسْلَمَ عَنْ عَطَاءِ بْنِ يَسَارٍ عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ","The Book of Forgetfulness"
"590","أَخْبَرَنَا مُحَمَّدُ بْنُ آدَمَ ، عَنْ حَفْصٍ هُوَ ابْنُ غِيَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَلْقَمَةَ ، عَنْ عَبْدِ اللَّهِ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : سَلَّمَ ، ثُمَّ تَكَلَّمَ ، ثُمَّ سَجَدَ سَجْدَتَيِ السَّهْوِ """"""","","Sunan al-Kubra al-Nasai 590","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ قَالَ حَدَّثَنَا خَالِدٌ يَعْنِي ابْنَ الْحَارِثِ قَالَ حَدَّثَنَا هِشَامٌ هُوَ الدَّسْتُوَائِيُّ عَنْ يَحْيَى هُوَ ابْنُ أَبِي كَثِيرٍ عَنْ عِيَاضٍ قَالَ","The Book of Forgetfulness"
"591","أَخْبَرَنَا مَحْمُودُ بْنُ غَيْلانَ ، قَالَ : حَدَّثَنَا وَهْبُ بْنُ جَرِيرٍ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنْ عَبْدِ رَبِّهِ بْنِ سَعِيدٍ ، عَنْ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ، عَنْ مَالِكِ بْنِ بُحَيْنَةَ ، أَنَّهُ صَلَّى مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَامَ فِي الشَّفْعِ الَّذِي يُرِيدُ أَنْ يَجْلِسَ فِيهِ ، فَسَبَّحْنَا فَمَضَى ، ثُمَّ سَجَدَ سَجْدَتَيْنِ "". قَالَ لنا أَبُو عَبْدِ الرَّحْمَنِ : هَذَا خَطَأٌ ، وَالصَّوَابُ عَبْدُ اللَّهِ بْنُ مَالِكِ بْنِ بُحَيْنَةَ""","","Sunan al-Kubra al-Nasai 591","","أَخْبَرَنِي إِبْرَاهِيمُ بْنُ يَعْقُوبَ قَالَ حَدَّثَنَا الْحَسَنُ بْنُ مُوسَى قَالَ حَدَّثَنَا شَيْبَانُ عَنْ يَحْيَى قَالَ حَدَّثَنِي عِيَاضُ بْنُ هِلَالٍ الْأَنْصَارِيُّ قَالَ سَمِعْتُ أَبَا سَعِيدٍ الْخُدْرِيِّ يَقُولُ","The Book of Forgetfulness"
"592","أَخْبَرَنَا أَبُو دَاوُدَ ، قَالَ : حَدَّثَنَا وَهْبٌ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ عَبْدِ الرَّحْمَنِ الأَعْرَجِ ، عَنِ ابْنِ بُحَيْنَةَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى فَقَامَ فِي الرَّكْعَتَيْنِ ، فَسَبَّحُوا فَمَضَى ، فَلَمَّا فَرَغَ مِنْ صَلاتِهِ سَجَدَ سَجْدَتَيْنِ """"""","","Sunan al-Kubra al-Nasai 592","","أَخْبَرَنِي شُعَيْبُ بْنُ شُعَيْبِ بْنِ إِسْحَاقَ قَالَ حَدَّثَنَا عَبْدُ الْوَهَّابِ قَالَ حَدَّثَنَا شُعَيْبُ قَالَ حَدَّثَنَا الْأَوْزَاعِيُّ قَالَ حَدَّثَنِي يَحْيَى أَنَّ عِيَاضَ بْنَ أَبِي زُهَيْرٍ حَدَّثَهُ قَالَ سَمِعْتُ أَبَا سَعِيدٍ يَقُولُ","The Book of Forgetfulness"
"593","أَخْبَرَنَا يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ ، قَالَ : حَدَّثَنَا حَمَّادٌ ، عَنْ يَحْيَى ، عَنْ عَبْدِ الرَّحْمَنِ الأَعْرَجِ ، عَنِ ابْنِ بُحَيْنَةَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى فَقَامَ فِي الشَّفْعِ الَّذِي كَانَ يُرِيدُ أَنْ يَجْلِسَ فِيهِ ، فَمَضَى فِي صَلاتِهِ ، حَتَّى إِذَا كَانَ فِي آخِرِ صَلاتِهِ ، سَجَدَ سَجْدَتَيْنِ ، قَبْلَ أَنْ يُسَلِّمَ ثُمَّ سَلَّمَ """"""","","Sunan al-Kubra al-Nasai 593","","أَخْبَرَنِي عَمْرُو بْنُ عُثْمَانَ عَنْ بَقِيَّةَ عَنِ الْأَوْزَاعِيِّ عَنْ يَحْيَى أَنَّ عِيَاضَ بْنَ أَبِي زُهَيْرٍ حَدَّثَهُ قَالَ سَمِعْتُ أَبَا سَعِيدٍ الْخُدْرِيِّ يَقُولُ","The Book of Forgetfulness"
"594","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ ، قَالَ : أنبا عَبْدُ اللَّهِ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، أَنَّ عَبْدِ الرَّحْمَنِ بْنِ هُرْمُزَ أَخْبَرَهُ ، عَنْ عَبْدِ اللَّهِ بْنِ مَالِكِ بْنِ بُحَيْنَةَ ، قَالَ : قَامَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الرَّكْعَتَيْنِ مِنَ الظُّهْرِ ، فَاسْتَتَمَّ قَائِمًا ثُمَّ سَجَدَ سَجْدَتَيْنِ ، ثُمَّ سَلَّمَ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : هَذَا الصَّوَابُ""","","Sunan al-Kubra al-Nasai 594","","أَخْبَرَنَا إِسْحَاقُ بْنُ مَنْصُورٍ قَالَ أَخْبَرَنَا عُمَرُ بْنُ يُونُسَ قَالَ حَدَّثَنَا عِكْرِمَةُ بْنُ عَمَّارٍ قَالَ حَدَّثَنَا يَحْيَى قَالَ حَدَّثَنِي هِلَالُ بْنُ عِيَاضٍ الْأَنْصَارِيُّ قَالَ حَدَّثَنِي أَبُو سَعِيدٍ الْخُدْرِيِّ قَالَ","The Book of Forgetfulness"
"595","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، عَنْ مَالِكٍ ، عَنِ ابْنِ شِهَابٍ ، عَنِ الأَعْرَجِ ، عَنْ عَبْدِ اللَّهِ بْنِ بُحَيْنَةَ ، قَالَ : صَلَّى لَنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَكْعَتَيْنِ ، ثُمَّ قَامَ فَلَمْ يَجْلِسْ ، فَقَامَ النَّاسُ مَعَهُ فَلَمَّا قَضَى صَلاتَهُ وَنَظَرْنَا تَسْلِيمَهُ كَبَّرَ فَسَجَدَ سَجْدَتَيْنِ وَهُوَ جَالِسٌ قَبْلَ التَّسْلِيمِ ثُمَّ سَلَّمَ """"""","","Sunan al-Kubra al-Nasai 595","","أَخْبَرَنِي عِمْرَانُ بْنُ يَزِيدَ قَالَ حَدَّثَنَا إِسْمَاعِيلُ بْنُ عَبْدِ اللهِ وَهُوَ ابْنُ سَمَاعَةَ عَنِ الْأَوْزَاعِيِّ قَالَ حَدَّثَنِي الزُّهْرِيُّ وَيَحْيَى عَنْ أَبِي سَلَمَةَ عَنْ أَبِي هُرَيْرَةَ","The Book of Forgetfulness"
"596","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ ، قَالَ : حَدَّثَنَا خَالِدٌ ، قَالَ : حَدَّثَنَا هِشَامٌ ، عَنْ يَحْيَى ، قَالَ : حَدَّثَنِي عَبْدُ الرَّحْمَنِ الأَعْرَجُ ، وَأَنْبَا سُلَيْمَانُ بْنُ سَلْمٍ ، قَالَ : أنبا النَّضْرُ ، قَالَ : أنبا هِشَامٌ ، عَنْ يَحْيَى ، عَنْ عَبْدِ الرَّحْمَنِ الأَعْرَجِ ، عَنْ عَبْدِ اللَّهِ بْنِ مَالِكِ بْنِ بُحَيْنَةَ ، أَنَّهُ  شَهِدَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَحِينَ قَامَ مِنَ الرَّكْعَتَيْنِ وَنَسِيَ أَنْ يَقْعُدَ ، فَمَضَى فِي قِيَامِهِ فَسَجَدَ سَجْدَتَيْنِ بَعْدَمَا فَرَغَ مِنْ صَلاتِهِ """"""","","Sunan al-Kubra al-Nasai 596","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ عَنْ مَالِكٍ عَنِ ابْنِ شِهَابٍ عَنْ أَبِي سَلَمَةَ عَنْ أَبِي هُرَيْرَةَ","The Book of Forgetfulness"
"597","أَخْبَرَنَا أَبُو بَكْرِ بْنُ إِسْحَاقَ ، قَالَ : أنبا أَبُو زَيْدٍ الْهَرَوِيِّ سَعِيدُ بْنُ الرَّبِيعِ ، قَالَ : حَدَّثَنِي عَلِيُّ بْنُ الْمُبَارَكِ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ ضَمْضَمِ بْنِ جَوْسٍ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : صَلَّى الظُّهْرَ ، فَقَامَ فِي الرَّكْعَتَيْنِ الأُولَيَيْنِ فَلَمْ يَقْعُدْ حَتَّى إِذَا كَانَ فِي آخِرِ صَلاتِهِ ، فَسَجَدَ سَجْدَتَيْنِ قَبْلَ أَنْ يُسَلِّمَ ، ثُمَّ سَلَّمَ """"""","Daif|Daif|Isnaad Hasan","Sunan al-Kubra al-Nasai 597","","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ قَالَ أَخْبَرَنَا عَبْدُ اللهِ وَهُوَ ابْنُ الْمُبَارَكِ عَنِ ابْنِ جُرَيْجٍ قَالَ حَدَّثَنِي عَبْدُ اللهِ بْنُ مُسَافِعٍ عَنْ عُتْبَةَ بْنِ مُحَمَّدِ بْنِ الْحَارِثِ عَنْ عَبْدِ اللهِ بْنِ جَعْفَرٍ قَالَ","The Book of Forgetfulness"
"598","أَخْبَرَنَا أَحْمَدُ بْنُ عَمْرٍو ، قَالَ : أنبا ابْنُ وَهْبٍ قَالَ : أَخْبَرَنِي عَمْرٌو ، وَيُونُسُ ، وَاللَّيْثُ ، أَنَّ ابْنَ شِهَابٍ أَخْبَرَهُمْ ، عَنْ عَبْدِ الرَّحْمَنِ الأَعْرَجِ ، أَنَّ عَبْدَ اللَّهِ بْنَ بُحَيْنَةَ حَدَّثَهُ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَامَ فِي اثْنَتَيْنِ مِنَ الظُّهْرِ فَلَمْ يَجْلِسْ فَلَمَّا قَضَى صَلاتَهُ ، سَجَدَ سَجْدَتَيْنِ كَبَّرَ فِي كُلِّ سَجْدَةٍ ، وَهُوَ جَالِسٌ قَبْلَ أَنْ يُسَلِّمَ ، وَسَجَدَهُمَا النَّاسُ مَعَهُ مَكَانَ مَا نَسِيَ مِنَ الْجُلُوسِ """"""","","Sunan al-Kubra al-Nasai 598","","أَخْبَرَنَا الرَّبِيعُ بْنُ سُلَيْمَانَ قَالَ أَخْبَرَنَا شُعَيْبُ بْنُ اللَّيْثِ قَالَ حَدَّثَنَا اللَّيْثُ عَنْ مُحَمَّدِ بْنِ عَجْلَانَ عَنْ مُحَمَّدِ بْنِ يُوسُفَ مَوْلَى عُثْمَانَ عَنْ أَبِيهِ","The Book of Forgetfulness"
"599","أَخْبَرَنَا عَمْرُو بْنُ هِشَامٍ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ سَلَمَةَ ، عَنْ خُصَيْفٍ ، عَنْ أَبِي عُبَيْدَةَ ، عَنْ أَبِيهِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : إِذَا كُنْتَ فِي صَلاةِ فَشَكَكْتَ فِي ثَلاثٍ وَأَرْبَعٍ ، وَأَكْثَرُ ظَنِّكَ عَلَى أَرْبَعٍ تَشَهَّدْتَ ، ثُمَّ سَجَدْتَ قَبْلَ أَنْ تُسَلِّمَ ، ثُمَّ تَشَهَّدْتَ أَيْضًا ثُمَّ سَلِّمْ """"""","Sahih|Sahih|Sahih Muslim","Sunan al-Kubra al-Nasai 599","","أَخْبَرَنِي مُحَمَّدُ بْنُ آدَمَ عَنْ حَفْصٍ هُوَ ابْنُ غِيَاثٍ عَنِ الْأَعْمَشِ عَنْ إِبْرَاهِيمَ عَنْ عَلْقَمَةَ عَنْ عَبْدِ اللهِ","The Book of Forgetfulness"
"600","أَخْبَرَنَا مُحَمَّدُ بْنُ يَحْيَى بْنِ عَبْدِ اللَّهِ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ للَّهِ الأَنْصَارِيُّ ، قَالَ : أَخْبَرَنِي أَشْعَثُ هُوَ ابْنُ عَبْدِ الْمَلِكِ ، عَنْ مُحَمَّدِ بْنِ سِيرِينَ ، عَنْ خَالِدٍ الْحَذَّاءِ ، عَنْ أَبِي قِلابَةَ ، عَنْ أَبِي الْمُهَلَّبِ ، عَنْ عِمْرَانَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى بِهِمْ فَسَهَا ، فَسَجَدَ ثُمَّ سَلَّمَ """"""","","Sunan al-Kubra al-Nasai 600","","أَخْبَرَنَا مَحْمُودُ بْنُ غَيْلَانَ قَالَ حَدَّثَنَا وَهْبُ بْنُ جَرِيرٍ قَالَ حَدَّثَنَا شُعْبَةُ عَنْ عَبْدِ رَبِّهِ بْنِ سَعِيدٍ عَنْ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ عَنْ مَالِكِ بْنِ بُحَيْنَةَ","The Book of Forgetfulness"
"601","أَخْبَرَنَا يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ ، قَالَ : حَدَّثَنَا حَمَّادٌ ، قَالَ : حَدَّثَنَا خَالِدٌ ، عَنْ أَبِي قِلابَةَ ، عَنْ أَبِي الْمُهَلَّبِ ، عَنْ عِمْرَانَ بْنِ حُصَيْنٍ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : صَلَّى ثَلاثًا ثُمَّ سَلَّمَ ، فَقَالَ الْخِرْبَاقُ : إِنَّكَ صَلَّيْتَ ثَلاثًا ، فَصَلَّى بِهِمُ الرَّكْعَةَ الْبَاقِيَةَ ثُمَّ سَلَّمَ ، ثُمَّ سَجَدَ سَجْدَتَيِ السَّهْوِ ثُمَّ سَلَّمَ """"""","","Sunan al-Kubra al-Nasai 601","","وَأَخْبَرَنَا أَبُو دَاوُدَ قَالَ حَدَّثَنَا وَهْبٌ قَالَ حَدَّثَنَا شُعْبَةُ عَنْ يَحْيَى بْنِ سَعِيدٍ عَنْ عَبْدِ الرَّحْمَنِ الْأَعْرَجِ عَنِ ابْنِ بُحَيْنَةَ","The Book of Forgetfulness"
"602","أَخْبَرَنَا أَحْمَدُ بْنُ سُلَيْمَانَ ، قَالَ : حَدَّثَنَا يَحْيَى بْنُ آدَمَ ، قَالَ : حَدَّثَنَا مَالِكٌ هُوَ ابْنُ مِغْوَلٍ ، عَنْ طَلْحَةَ بْنِ مُصَرِّفٍ ، عَنْ زَيْدِ بْنِ وَهْبٍ ، عَنْ حُذَيْفَةَ ، أَنَّهُ رَأَى رَجُلا يُصَلِّي فَطَفَّفَ ، فَقَالَ لَهُ حُذَيْفَةُ : مُنْذُ كَمْ تُصَلِّي هَذِهِ الصَّلاةَ ؟ "" ، قَالَ : مُنْذُ أَرْبَعِينَ عَامًا ، قَالَ : "" مَا صَلَّيْتَ مُنْذُ أَرْبَعِينَ سَنَةً ، وَلَوْ مِتَّ وَأَنْتَ تُصَلِّي هَذِهِ الصَّلاةَ لَمِتَّ عَلَى غَيْرِ فِطْرَةِ مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ "" ، ثُمَّ قَالَ : "" إِنَّ الرَّجُلَ لَيُخِفُّ ، وَيُتِمُّ وَيُحْسِنُ """"""","Sahih|Sahih|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 602","","أَخْبَرَنِي يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ قَالَ حَدَّثَنَا حَمَّادٌ عَنْ يَحْيَى عَنْ عَبْدِ الرَّحْمَنِ الْأَعْرَجِ عَنِ ابْنِ بُحَيْنَةَ","The Book of Forgetfulness"
"603","أَخْبَرَنَا أَحْمَدُ بْنُ سُلَيْمَانَ الرُّهَاوِيُّ ، قَالَ : حَدَّثَنَا يَزِيدُ ، قَالَ : أنبا شُعْبَةُ ، عَنْ قَتَادَةَ ، عَنْ أَنَسٍ ، قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ أَخَفِّ النَّاسِ صَلاةً فِي تَمَامٍ """"""","","Sunan al-Kubra al-Nasai 603","","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ بْنِ سُوَيْدٍ قَالَ أَخْبَرَنَا عَبْدُ اللهِ عَنْ يَحْيَى بْنِ سَعِيدٍ أَنَّ عَبْدِ الرَّحْمَنِ بْنِ هُرْمُزَ أَخْبَرَهُ عَنْ عَبْدِ اللهِ بْنِ مَالِكِ بْنِ بُحَيْنَةَ قَالَ","The Book of Forgetfulness"
"604","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى الصَّنْعَانِيُّ ، قَالَ : حَدَّثَنَا خَالِدٌ ، عَنْ شُعْبَةَ ، عَنْ حَمْزَةَ ، قَالَ : سَمِعْتُ أَنَسًا ، يَقُولُ : مَا صَلَّيْتُ وَرَاءَ إِنْسَانٍ قَطُّ أَخَفَّ صَلاةً مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 604","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ عَنْ مَالِكٍ عَنِ ابْنِ شِهَابٍ عَنِ الْأَعْرَجِ عَنْ عَبْدِ اللهِ بْنِ بُحَيْنَةَ قَالَ","The Book of Forgetfulness"
"605","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا يَحْيَى وَهُوَ الْقَطَّانُ ، قَالَ : حَدَّثَنَا عُبَيْدُ اللَّهِ ، قَالَ : حَدَّثَنِي سَعِيدُ بْنُ أَبِي سَعِيدٍ ، عَنْ عُمَرَ بْنِ أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِيهِ ، أَنَّ عَمَّارَ بْنَ يَاسِرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  إِنَّالرَّجُلَ لَيُصَلِّي وَلَعَلَّهُ أَلا يَكُونَ لَهُ مِنْ صَلاتِهِ إِلا عُشْرُهَا ، أَوْ تُسْعُهَا ، أَوْ ثُمْنُهَا ، أَوْ سُبْعُهَا حَتَّى انْتَهَى إِلَى آخِرِ الْعَدَدِ """"""","","Sunan al-Kubra al-Nasai 605","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ قَالَ حَدَّثَنَا خَالِدٌ قَالَ حَدَّثَنَا هِشَامٌ عَنْ يَحْيَى قَالَ حَدَّثَنِي عَبْدُ الرَّحْمَنِ الْأَعْرَجُ وَأَخْبَرَنَا سُلَيْمَانُ بْنُ سَلْمٍ قَالَ أَخْبَرَنَا النَّضْرُ قَالَ أَخْبَرَنَا هِشَامٌ عَنْ يَحْيَى عَنْ عَبْدِ الرَّحْمَنِ الْأَعْرَجِ عَنْ عَبْدِ اللهِ بْنِ مَالِكِ بْنِ بُحَيْنَةَ","The Book of Forgetfulness"
"606","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا بَكْرٌ هُوَ ابْنُ مُضَرٍ ، عَنِ ابْنِ عَجْلانَ ، عَنْ سَعِيدٍ هُوَ ابْنُ أَبِي سَعِيدٍ الْمَقْبُرِيُّ ، عَنْ عُمَرَ بْنِ الْحَكَمِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَنَمَةَ ، أَنَّ عَمَّارَ بْنَ يَاسِرٍ ، قَالَ : إِنِّي سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  إِنَّالرَّجُلَ لَيَنْصَرِفُ ، وَمَا كُتِبَ لَهُ إِلا عُشْرُ صَلاتِهِ ، تُسْعُهَا ، ثُمْنُهَا ، سُبْعُهَا ، خُمْسُهَا رُبْعُهَا ثُلْثُهَا نِصْفُهَا """"""","","Sunan al-Kubra al-Nasai 606","","أَخْبَرَنِي أَبُو بَكْرِ بْنُ إِسْحَاقَ قَالَ حَدَّثَنَا أَبُو زَيْدٍ الْهَرَوِيِّ سَعِيدُ بْنُ الرَّبِيعِ قَالَ حَدَّثَنَا عَلِيُّ بْنُ الْمُبَارَكِ عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ عَنْ ضَمْضَمِ بْنِ جَوْسٍ عَنْ أَبِي هُرَيْرَةَ","The Book of Forgetfulness"
"607","أَخْبَرَنَا مُحَمَّدُ بْنُ سَلَمَةَ الْمِصْرِيُّ ، قَالَ : حَدَّثَنَا ابْنُ وَهْبٍ ، عَنْ عَمْرِو بْنِ الْحَارِثِ ، عَنْ سَعِيدِ بْنِ أَبِي هِلالٍ ، عَنْ عُمَرَ بْنِ الْحَكَمِ الأَنْصَارِيِّ ، عَنْ أَبِي الْيُسْرِ صَاحِبِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مِنْكُمْ مَنْ يُصَلِّي الصَّلاةَ كَامِلَةً ، وَمِنْكُمْ مَنْ يُصَلِّي النِّصْفَ ، وَالثُّلُثَ ، وَالرُّبُعَ ، وَالْخَمْسَ ، حَتَّى بَلَغَ الْعُشْرَ """"""","Sahih|Sahih|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 607","","أَخْبَرَنَا أَحْمَدُ بْنُ عَمْرٍو قَالَ حَدَّثَنَا ابْنُ وَهْبٍ قَالَ أَخْبَرَنِي عَمْرٌو وَيُونُسُ وَاللَّيْثُ أَنَّ ابْنَ شِهَابٍ أَخْبَرَهُمْ عَنْ عَبْدِ الرَّحْمَنِ الْأَعْرَجِ أَنَّ عَبْدَ اللهِ ابْنَ بُحَيْنَةَ حَدَّثَهُ","The Book of Forgetfulness"
"608","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ عَبْدِ الْحَكَمِ ، عَنْ شُعَيْبٍ ، قَالَ : حَدَّثَنَا اللَّيْثُ ، قَالَ : نا خَالِدٌ ، عَنِ ابْنِ أَبِي هِلالٍ ، عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ الْمَقْبُرِيِّ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّ الْعَبْدَ لَيُصَلِّي فَمَا يُكْتَبُ لَهُ إِلا عُشْرُ صَلاتِهِ ، فَالتُّسْعُ ، فَالثُّمْنُ ، فَالسُّبْعُ ، حَتَّى تُكْتَبَ صَلاتُهُ تَامَّةً """"""","","Sunan al-Kubra al-Nasai 608","","أَخْبَرَنِي عَمْرُو بْنُ هِشَامٍ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ سَلَمَةَ عَنْ خُصَيْفٍ عَنْ أَبِي عُبَيْدَةَ عَنْ أَبِيهِ","The Book of Forgetfulness"
"609","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ ، قَالَ : أنبا عَبْدُ اللَّهِ هُوَ ابْنُ الْمُبَارَكِ ، عَنْ لَيْثِ بْنِ سَعْدٍ ، قَالَ : حَدَّثَنِي عَبْدُ رَبِّهِ بْنُ سَعِيدٍ ، عَنْ عِمْرَانَ بْنِ أَبِي أَنَسٍ ، عَنْ عَبْدِ اللَّهِ بْنِ نَافِعِ بْنِ الْعَمْيَاءِ ، عَنْ رَبِيعَةَ بْنِ الْحَارِثِ ، عَنِ الْفَضْلِ بْنِ الْعَبَّاسِ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : الصَّلاةُ مَثْنَى مَثْنَى ، تَشَهَّدُ فِي كُلِّ رَكْعَتَيْنِ ، وَتَضَرَّعُ وَتَخَشَّعُ ، وَتَمَسْكَنُ وَتُقْنِعُ يَدَيْكَ "" ، يَقُولُ : "" تَرْفَعُهُمَا إِلَى رَبِّكَ مُسْتَقْبِلا بِبُطُونِهِمَا وَجْهِكَ ، وَتَقُولُ : يَا رَبِّ ، يَا رَبِّ ، فَمَنْ لَمْ يَفْعَلْ ذَلِكَ كَذَا وَكَذَا "" ، يَعْنِي خِدَاجٌخَالَفَهُ شُعْبَةُ""","","Sunan al-Kubra al-Nasai 609","","أَخْبَرَنِي مُحَمَّدُ بْنُ يَحْيَى بْنِ عَبْدِ اللهِ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَنْصَارِيُّ قَالَ أَخْبَرَنِي أَشْعَثُ هُوَ ابْنُ عَبْدِ الْمَلِكِ عَنْ مُحَمَّدِ بْنِ سِيرِينَ عَنْ خَالِدٍ الْحَذَّاءِ عَنْ أَبِي قِلَابَةَ عَنْ أَبِي الْمُهَلَّبِ عَنْ عِمْرَانَ","The Book of Forgetfulness"
"610","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أنبا سَعِيدُ بْنُ عَامِرٍ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنْ عَبْدِ رَبِّهِ بْنِ سَعِيدٍ ، عَنْ أَنَسِ بْنِ أَبِي أَنَسٍ ، عَنْ عَبْدِ اللَّهِ بْنِ نَافِعٍ ، عَنْ عَبْدِ اللَّهِ بْنِ الْحَارِثِ ، عَنِ الْمُطَّلِبِ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : الصَّلاةُ مَثْنَى مَثْنَى ، وَتَشَهَّدُ فِي كُلِّ رَكْعَتَيْنِ ، وَتَبَاءَسُ وَتَمَسْكَنُ وَتُقْنِعُ يَدَيْكَ ، وَتَقُولُ : اللَّهُمَّ اللَّهُمَّ ، فَمَنْ لَمْ يَفْعَلْ ذَلِكَ فَهِيَ خِدَاجٌ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 610","","أَخْبَرَنَا يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ قَالَ حَدَّثَنَا حَمَّادٌ قَالَ حَدَّثَنَا خَالِدٌ عَنْ أَبِي قِلَابَةَ عَنْ أَبِي الْمُهَلَّبِ عَنْ عِمْرَانَ بْنِ حُصَيْنٍ","The Book of Forgetfulness"
"611","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ ، قَالَ : حَدَّثَنَا خَالِدٌ ، عَنْ شُعْبَةَ ، عَنْ سُلَيْمَانَ ، قَالَ : سَمِعْتُ إِبْرَاهِيمَ يُحَدِّثُ ، عَنْ عَلْقَمَةَ وَالأَسْوَدِ ، أنهما كانا مع عبد الله في بيته ، فقال : أصلى هؤلاء ؟ قَالا : نَعَمْ ، فَأَمَّهُمَا ، ثُمَّ قَامَ بَيْنَهُمَا بِغَيْرِ أَذَانٍ وَلا إِقَامَةٍ ، وَقَالَ : إِذَا كُنْتُمْ ثَلاثَةً ، فَاصْنَعُوا هَكَذَا ، وَإِذَا كُنْتُمْ أَكْثَرَ مِنْ ذَلِكَ ، فَلْيَؤُمَّكُمْ أَحَدُكُمْ ، وَلْيَفْرِشْ كَفَّيْهِ وَفَخِذَيْهِ ، فَكَأَنَّمَا أَنْظُرُ إِلَى اخْتِلافِ أَصَابِعِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ """"""","","Sunan al-Kubra al-Nasai 611","","أَخْبَرَنَا أَحْمَدُ بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا يَحْيَى بْنُ آدَمَ قَالَ حَدَّثَنَا مَالِكٌ هُوَ ابْنُ مِغْوَلٍ عَنْ طَلْحَةَ بْنِ مُصَرِّفٍ عَنْ زَيْدِ بْنِ وَهْبٍ عَنْ حُذَيْفَةَ أَنَّهُ رَأَى رَجُلًا يُصَلِّي فَطَفَّفَ فَقَالَ لَهُ حُذَيْفَةُ «مُنْذُ كَمْ تُصَلِّي هَذِهِ الصَّلَاةَ؟» قَالَ مُنْذُ أَرْبَعِينَ عَامًا قَالَ","The Book of Tatbiq"
"612","أَخْبَرَنَا أَبُو عَبْدِ اللَّهِ مُحَمَّدُ بْنُ رَافِعٍ ، قَالَ : نا يَحْيَى بْنُ آدَمَ ، قَالَ : نا مُفَضَّلُ بْنُ مُهَلْهِلٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَلْقَمَةَ وَالأَسْوَدِ ، أنهما دخلا على عبد الله ، قال :  صَلَّى هَؤُلاءِ خَلْفَكُمْ ؟ "" قَالا : قُلْنَا : لا ، قَالَ : "" فَصَلَّوْا "" ، قَالَ : فَقَامَ بَيْنَنَا ثُمَّ صَلَّى فَلَمَّا رَكَعْنَا وَضَعْنَا أَيْدِينَا عَلَى الرُّكَبِ نُسَرُّ بِهَا ، فَإِذَا هُوَ قَدْ طَبَّقَ فَلَمَّا قَضَى الصَّلاةَ ، قَالَ : "" إِنَّهَاسَتَكُونُ أُمَرَاءٌ يُمِيتُونَ الصَّلاةَ ، يَخْنُقُونَهَا شَرَقَ الْمَوْتَى ، وَتِلْكَ صَلاةُ مَنْ لا يَجِدُ بُدٌّ وَمَنْ هُوَ شَرٌّ مِنْ حَارٍّ ، فَصَلَّوَا الصَّلاةَ لِمِيقَاتِهَا وَصَلَّوْا مَعَهُمْ سُبْحَةً ، فَإِذَا كُنْتُمْ ثَلاثَةً فَصَلَّوْا جَمِيعًا ، وَإِذَا كُنْتُمْ أَكْثَرَ فَلْيَؤُمَّكُمْ أَحَدُكُمْ ، فَإِذَا رَكَعَ أَحَدُكُمْ فَلْيَضَعْ يَدَيْهِ بَيْنَ رُكْبَتَيْهِ ، أَوْ بَيْنَ فَخِذَيْهِ ، وَانْجَبَى فَكَأَنِّي أَنْظُرُ إِلَى اخْتِلافِ أَصَابِعِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ """"""","","Sunan al-Kubra al-Nasai 612","","أَخْبَرَنَا أَحْمَدُ بْنُ سُلَيْمَانَ الرُّهَاوِيُّ قَالَ حَدَّثَنَا يَزِيدُ قَالَ أَخْبَرَنَا شُعْبَةُ عَنْ قَتَادَةَ عَنْ أَنَسٍ قَالَ","The Book of Tatbiq"
"613","أَخْبَرَنَا أَحْمَدُ بْنُ سَعِيدٍ الْمَرْوَزِيُّ الرِّبَاطِيُّ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللَّهِ ، قَالَ : أنبا عَمْرُو ، عَنِ الزُّبَيْرِ وَهُوَ ابْنُ عَدِيٍّ ، عَنْ إِبْرَاهِيمَ ، عَنِ الأَسْوَدِ ، وَعَلْقَمَةَ ، قَالا : صَلَّيْنَا مَعَ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ فِي بَيْتِهِ فَقَامَ بَيْنَنَا ، فَوَضَعْنَا ، يَعْنِي أَيْدِينَا ، عَلَى رُكَبِنَا فَنَزَعَهَا فَخَالَفْنَا بَيْنَ أَصَابِعِنَا ، وَقَالَ : رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَفْعَلُهُ """"""","","Sunan al-Kubra al-Nasai 613","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى الصَّنْعَانِيُّ قَالَ حَدَّثَنَا خَالِدٌ عَنْ شُعْبَةَ عَنْ حَمْزَةَ قَالَ","The Book of Tatbiq"
"614","أَخْبَرَنَا نُوحُ بْنُ حَبِيبٍ الْقُومَسِيُّ ، قَالَ : حَدَّثَنَا ابْنُ إِدْرِيسَ ، عَنْ عَاصِمِ بْنِ كُلَيْبٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ عَلْقَمَةَ ، عَنْ عَبْدِ اللَّهِ ، قَالَ : عَلَّمَنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الصَّلاةَ فَقَامَ فَكَبَّرَ فَلَمَّا أَرَادَ أَنْ يَرْكَعَ ، طَبَّقَ يَدَيْهِ بَيْنَ رُكْبَتَيْهِ ، وَرَكَعَ ""، فَبَلَغَ ذَلِكَ سَعْدًا ، فَقَالَ : صَدَقَ أَخِي ، قَدْ كُنَّا نَفْعَلُ هَذَا ، ثُمَّ أُمِرْنَا بِهَذَا ، يَعْنِي الإِمْسَاكَ بِالرُّكَبِ""","","Sunan al-Kubra al-Nasai 614","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا يَحْيَى وَهُوَ الْقَطَّانُ قَالَ حَدَّثَنَا عُبَيْدُ اللهِ قَالَ حَدَّثَنِي سَعِيدُ بْنُ أَبِي سَعِيدٍ عَنْ عُمَرَ بْنِ أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ عَنْ أَبِيهِ أَنَّ عَمَّارَ بْنَ يَاسِرٍ قَالَ","The Book of Tatbiq"
"615","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا أَبُو عَوَانَةَ ، عَنْ أَبِي يَعْفُورٍ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، قَالَ :صَلَّيْتُ إِلَى جَنْبِ أَبِي ، قَالَ :  وَجَعَلْتُ يَدَيَّ بَيْنَ رُكْبَتَيَّ ، فَقَالَ لِي : "" اضْرِبْ بِكَفَّيْكَ عَلَى رُكْبَتَيْكَ "" ، قَالَ : ثُمَّ فَعَلْتُ ذَلِكَ مُرَّةً أُخْرَى ، فَضَرَبَ يَدَيَّ ، وَقَالَ : "" إِنَّا قَدْ نُهِينَا عَنْ هَذَا ، وَأُمِرْنَا أَنْ نَضْرِبَ بِالأَكُفِّ عَلَى الرُّكَبِ """"""","","Sunan al-Kubra al-Nasai 615","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا بَكْرٌ هُوَ ابْنُ مُضَرٍ عَنِ ابْنِ عَجْلَانَ عَنْ سَعِيدٍ الْمَقْبُرِيٍّ عَنْ عُمَرَ بْنِ الْحَكَمِ عَنْ عَبْدِ اللهِ بْنِ عَنْمَةَ أَنَّ عَمَّارَ بْنَ يَاسِرٍ قَالَ إِنِّي","The Book of Tatbiq"
"616","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا يَحْيَى ، عَنْ إِسْمَاعِيلَ ، عَنِ الزُّبَيْرِ بْنِ عَدِيٍّ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، قَالَ :رَكَعْتُ فَطَبَّقْتُ ، فَقَالَ أَبِي :  هَذَا شَيْءٌ كُنَّا نَفْعَلُهُ ، ثُمَّ ارْتَفَعْنَا إِلَى الرُّكَبِ """"""","","Sunan al-Kubra al-Nasai 616","","أَخْبَرَنَا مُحَمَّدُ بْنُ سَلَمَةَ الْمِصْرِيُّ قَالَ حَدَّثَنَا ابْنُ وَهْبٍ عَنْ عَمْرِو بْنِ الْحَارِثِ عَنْ سَعِيدِ بْنِ أَبِي هِلَالٍ عَنْ عُمَرَ بْنِ الْحَكَمِ الْأَنْصَارِيِّ","The Book of Tatbiq"
"617","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ : حَدَّثَنِي أَبُو دَاوُدَ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنْ أَبِي عَبْدِ الرَّحْمَنِ ، عَنْ عُمَرَ ، قَالَ : سُنَّتْ لَكُمُ الرُّكَبُ ، فَأَمْسِكُوا بِالرُّكَبِ """"""","","Sunan al-Kubra al-Nasai 617","","أَخْبَرَنِي مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الْحَكَمِ عَنْ شُعَيْبٍ قَالَ حَدَّثَنَا اللَّيْثُ قَالَ حَدَّثَنَا خَالِدٌ عَنِ ابْنِ أَبِي هِلَالٍ عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ الْمَقْبُرِيِّ عَنْ أَبِيهِ عَنْ أَبِي هُرَيْرَةَ","The Book of Tatbiq"
"618","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ ، قَالَ : أنبا عَبْدُ اللَّهِ ، عَنْ سُفْيَانَ ، عَنْ أَبِي حَصِينٍ ، عَنْ أَبِي عَبْدِ الرَّحْمَنِ السَّلَمِيِّ ، قَالَ : قَالَ عُمَرُ : أَمَّا السَّنَةُ الأَخْذُ بِالرُّكَبِ """"""","","Sunan al-Kubra al-Nasai 618","","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرِ بن سُوَيْدٍ قَالَ أَخْبَرَنَا عَبْدُ اللهِ هُوَ ابْنُ الْمُبَارَكِ عَنْ لَيْثِ بْنِ سَعْدٍ قَالَ حَدَّثَنِي عَبْدُ رَبِّهِ بْنُ سَعِيدٍ عَنْ عِمْرَانَ بْنِ أَبِي أَنَسٍ عَنْ عَبْدِ اللهِ بْنِ نَافِعِ بْنِ الْعَمْيَاءِ عَنْ رَبِيعَةَ بْنِ الْحَارِثِ عَنِ الْفَضْلِ بْنِ الْعَبَّاسِ قَالَ","The Book of Tatbiq"
"619","أَخْبَرَنَا هَنَّادُ بْنُ السَّرِيِّ ، فِي حَدِيثِهِ ، عَنْ أَبِي الأَحْوَصِ ، عَنْ عَطَاءٍ ، عَنْ سَالِمٍ ، قَالَ : أَتَيْنَا أَبَا مَسْعُودٍ فَقُلْنَا لَهُ : حَدِّثْنَاعَنْ صَلاةِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  فَقَامَ بَيْنَ أَيْدِينَا فَكَبَّرَ ، فَلَمَّا رَكَعَ وَضْعَ رَاحَتَيْهِ عَلَى رُكْبَتَيْهِ ، وَجَعَلَ أَصَابِعَهُ أَسْفَلَ مِنْ ذَلِكَ ، وَجَافَى بِمِرْفَقَيْهِ حَتَّى اسْتَوَى كُلُّ شَيْءٍ مِنْهُ ، ثُمَّ قَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ ، فَقَامَ حَتَّى اسْتَوَى كُلُّ شَيْءٍ مِنْهُ """"""","","Sunan al-Kubra al-Nasai 619","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ أَخْبَرَنَا سَعِيدُ بْنُ عَامِرٍ قَالَ حَدَّثَنَا شُعْبَةُ عَنْ عَبْدِ رَبِّهِ بْنِ سَعِيدٍ عَنْ أَنَسِ بْنِ أَبِي أَنَسٍ عَنْ عَبْدِ اللهِ بْنِ نَافِعٍ عَنْ عَبْدِ اللهِ بْنِ الْحَارِثِ عَنِ الْمُطَّلِبِ","The Book of Tatbiq"
"620","أَخْبَرَنَا أَحْمَدُ بْنُ سُلَيْمَانَ الرُّهَاوِيُّ ، قَالَ : حَدَّثَنَا حُسَيْنٌ ، عَنْ زَائِدَةَ ، عَنْ عَطَاءٍ ، عَنْ سَالِمٍ أَبِي عَبْدِ اللَّهِ ، عَنْ عُقْبَةَ بْنِ عَمْرٍو ، قَالَ :  أَلا أُصَلِّي لَكُمْ كَمَا رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي ؟ "" فَقُلْنَا : بَلَى ، ""فَقَامَ فَلَمَّا رَكَعَ وَضْعَ رَاحَتَيْهِ عَلَى رُكْبَتَيْهِ ، وَجَعَلَ أَصَابِعَهُ مِنْ وَرَاءِ رُكْبَتَيْهِ ، وَجَافَى إِبِطَيْهِ حَتَّى اسْتَقَرَّ كُلُّ شَيْءٍ مِنْهُ ، ثُمَّ رَفَعَ رَأْسَهُ فَقَامَ حَتَّى اسْتَقَرَّ كُلُّ شَيْءٍ مِنْهُ ، ثُمَّ سَجَدَ فَجَافَى إِبِطَيْهِ حَتَّى اسْتَقَرَّ كُلُّ شَيْءٍ مِنْهُ ، ثُمَّ قَعَدَ حَتَّى اسْتَقَرَّ كُلُّ شَيْءٍ مِنْهُ ، ثُمَّ صَنَعَ كَذَلِكَ أَرْبَعَ رَكَعَاتٍ "" ، ثُمَّ قَالَ : هَكَذَا رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي ، وَهَكَذَا كَانَ يُصَلِّي بِنَا """"""","","Sunan al-Kubra al-Nasai 620","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ قَالَ حَدَّثَنَا خَالِدٌ عَنْ شُعْبَةَ عَنْ سُلَيْمَانَ قَالَ سَمِعْتُ إِبْرَاهِيمَ يُحَدِّثُ","The Book of Tatbiq"
"621","أَخْبَرَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ ، عَنِ ابْنِ عُلَيَّةَ ، عَنْ عَطَاءِ بْنِ السَّائِبِ ، عَنْ سَالِمٍ الْبَرَّادِ ، قَالَ : قَالَ أَبُو مَسْعُودٍ وَهُوَ الأَنْصَارِيُّ :  أَلا أُرِيَكُمْ كَيْفَ كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي ؟ "" فَقُلْنَا : بَلَى ، ""فَقَامَ فَكَبَّرَ ، فَلَمَّا رَكَعَ جَافَى بَيْنَ إِبِطَيْهِ حَتَّى لَمَّا اسْتَقَرَّ كُلُّ شَيْءٍ مِنْهُ رَفَعَ رَأْسَهُ ، فَصَلَّى أَرْبَعَ رَكَعَاتٍ هَكَذَا ، وَقَالَ : هَكَذَا رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي """"""","","Sunan al-Kubra al-Nasai 621","","أَخْبَرَنَا أَبُو عَبْدِ اللهِ مُحَمَّدُ بْنُ رَافِعٍ قَالَ حَدَّثَنَا يَحْيَى بْنُ آدَمَ قَالَ حَدَّثَنَا مُفَضَّلُ بْنُ مُهَلْهِلٍ عَنِ الْأَعْمَشِ عَنْ إِبْرَاهِيمَ عَنْ عَلْقَمَةَ وَالْأَسْوَدِ أَنَّهُمَا دَخَلَا عَلَى عَبْدِ اللهِ قَالَ «صَلَّى هَؤُلَاءِ خَلْفَكُمْ؟» قَالَا قُلْنَا لَا قَالَ «فَصَلُّوا» قَالَ","The Book of Tatbiq"
"622","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ : حَدَّثَنَا يَحْيَى ، قَالَ : حدَّثَنَا عَبْدُ الْحَمِيدِ بْنِ جَعْفَرٍ ، قَالَ : حَدَّثَنِي مُحَمَّدُ بْنُ عَمْرِو بْنِ عَطَاءَ ، عَنْ أَبِي حُمَيْدٍ السَّاعِدِيِّ ، قَالَ : كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا رَكَعَ اعْتَدَلَ فَلَمْ يَصُبَّ رَأْسَهُ ، وَلَمْ يُقْنِعْهُ ، وَوُضِعَ يَدَيْهِ عَلَى رُكْبَتَيْهِ """"""","","Sunan al-Kubra al-Nasai 622","","أَخْبَرَنِي أَحْمَدُ بْنُ سَعِيدٍ الْمَرْوَزِيُّ الرِّبَاطِيُّ قَالَ حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ قَالَ أَخْبَرَنَا عَمْرُو عَنِ الزُّبَيْرِ وَهُوَ ابْنُ عَدِيٍّ عَنْ إِبْرَاهِيمَ عَنِ الْأَسْوَدِ وَعَلْقَمَةَ قَالَا §صَلَّيْنَا مَعَ عَبْدِ اللهِ بْنِ مَسْعُودٍ فِي بَيْتِهِ فَقَامَ بَيْنَنَا فَوَضَعْنَا يَعْنِي أَيْدِينَا عَلَى رُكَبِنَا فَنَزَعَهَا فَخَالَفْنَا بَيْنَ أَصَابِعِنَا","The Book of Tatbiq"
"623","أَخْبَرَنَا عُبَيْدُ اللَّهِ بْنُ سَعِيدٍ السَّرَخْسِيُّ أَبُو قُدَامَةَ ، قَالَ : حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَةَ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، عَنْ عُبَيْدَةَ ، عَنْ عَلِيٍّ ، قَالَ : نَهَانِي النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، عَنِ الْقَسِّيِّ ، وَالْحَرِيرِ ، وَخَاتَمِ الذَّهَبِ ، وَأَنْ أَقْرَأَ وَأَنَا رَاكِعٌ ""وَقَالَ مَرَّةً أُخْرَى "" وَأَنْ أَقْرَأَ رَاكِعًا """"""","Sahih|Sahih|Isnaad Sahih","Sunan al-Kubra al-Nasai 623","","أَخْبَرَنَا نُوحُ بْنُ حَبِيبٍ الْقُومَسِيُّ قَالَ حَدَّثَنَا ابْنُ إِدْرِيسَ عَنْ عَاصِمِ بْنِ كُلَيْبٍ عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ عَنْ عَلْقَمَةَ عَنْ عَبْدِ اللهِ قَالَ","The Book of Tatbiq"
"624","أَخْبَرَنَا عُبَيْدُ اللَّهِ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا يَحْيَى بْنُ سَعِيدٍ ، قَالَ : عَنِ ابْنِ عَجْلانَ ، عَنْ إِبْرَاهِيمَ بْنِ عَبْدِ اللَّهِ بْنِ حُنَيْنٍ ، عَنْ أَبِيهِ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ عَلِيٍّ ، قَالَ : نَهَانِي النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ خَاتَمِ الذَّهَبِ ، وَعَنِ الْقِرَاءَةِ رَاكِعًا ، وَعَنِ الْقَسِّيِّ وَالْمُعَصْفَرِ """"""","Sahih|Sahih|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 624","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا أَبُو عَوَانَةَ عَنْ أَبِي يَعْفُورٍ عَنْ مُصْعَبِ بْنِ سَعْدٍ قَالَ صَلَّيْتُ إِلَى جَنْبِ أَبِي قَالَ وَجَعَلْتُ يَدَيَّ بَيْنَ رُكْبَتَيَّ فَقَالَ لِي «اضْرِبْ بِكَفَّيْكَ عَلَى رُكْبَتَيْكَ» قَالَ ثُمَّ فَعَلْتُ ذَلِكَ مُرَّةً أُخْرَى فَضَرَبَ يَدَيَّ وَقَالَ «§إِنَّا قَدْ نُهِينَا عَنْ هَذَا وَأُمِرْنَا","The Book of Tatbiq"
"625","أَخْبَرَنَا الْحَسَنُ بْنُ دَاوُدَ الْمُنْكَدِرِيُّ ، قَالَ : أنبا ابْنُ أَبِي فُدَيْكٍ ، عَنِ الضَّحَّاكِ بْنِ عُثْمَانَ ، عَنْ إِبْرَاهِيمَ بْنِ حُنَيْنٍ ، عَنْ أَبِيهِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبَّاسٍ ، عَنْ عَلِيٍّ هُوَ ابْنُ أَبِي طَالِبٍ ، قَالَ : نَهَانِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَلا أَقُولُ نَهَاكُمْ عَنْ تَخْتِمِ الذَّهَبِ ، وَعَنْ لُبِسِ الْقَسِّيِّ ، وَعَنْ لُبِسِ الْمُفَدَّمِ وَالْمُعَصْفَرِ ، وَعَنِ الْقِرَاءَةِ رَاكِعًا """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 625","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا يَحْيَى عَنْ إِسْمَاعِيلَ عَنِ الزُّبَيْرِ بْنِ عَدِيٍّ عَنْ مُصْعَبِ بْنِ سَعْدٍ قَالَ §رَكَعْتُ فَطَبَّقْتُ فَقَالَ","The Book of Tatbiq"
"626","أَخْبَرَنَا عِيسَى بْنُ حَمَّادِ بْنِ زُغْبَةَ ، عَنِ اللَّيْثِ ، عَنْ يَزِيدَ ، أَنَّ إِبْرَاهِيمَ بْنَ عَبْدِ اللَّهِ بْنِ حُنَيْنٍ حَدَّثَهُ ، أَنَّ أَبَاهُ حَدَّثَهُ ، أَنَّهُ سَمِعَ عَلِيًا ، يَقُولُ : نَهَانِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ خَاتَمِ الذَّهَبِ ، وَعَنْ لُبِسِ الْقَسِّيِّ ، وَالْمُعَصْفَرِ ، وَقِرَاءَةِ الْقُرْآنِ ، وَأَنَا رَاكِعٌ """"""","Sahih Isnaad|Sahih Isnaad|Hasan","Sunan al-Kubra al-Nasai 626","","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ قَالَ حَدَّثَنِي أَبُو دَاوُدَ قَالَ حَدَّثَنَا شُعْبَةُ عَنِ الْأَعْمَشِ عَنْ إِبْرَاهِيمَ عَنْ أَبِي عَبْدِ الرَّحْمَنِ عَنْ عُمَرَ قَالَ","The Book of Tatbiq"
"627","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، عَنْ مَالِكٍ ، عَنْ نَافِعٍ ، عَنْ إِبْرَاهِيمَ بْنِ عَبْدِ اللَّهِ بْنِ حُنَيْنٍ ، عَنْ أَبِيهِ ، عَنْ عَلِيٍّ ، قَالَ : نَهَانِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ لُبِسِ الْقَسِّيِّ وَالْمُعَصْفَرِ ، وَعَنْ تَخَتُّمِ الذَّهَبِ ، وَعَنِ الْقِرَاءَةِ فِي الرُّكُوعِ """"""","Sahih Isnaad|Sahih Isnaad|Hasan","Sunan al-Kubra al-Nasai 627","","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ قَالَ أَخْبَرَنَا عَبْدُ اللهِ عَنْ سُفْيَانَ عَنْ أَبِي حَصِينٍ عَنْ أَبِي عَبْدِ الرَّحْمَنِ السَّلَمِيِّ قَالَ","The Book of Tatbiq"
"628","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، عَنْ سُلَيْمَانَ بْنِ سُحَيْمٍ ، عَنْ إِبْرَاهِيمَ بْنِ عَبْدِ اللَّهِ بْنِ مَعْبَدِ بْنِ عَبَّاسٍ ، عَنْ أَبِيهِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : كَشَفَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ السِّتَارَةَ ، وَالنَّاسُ صُفُوفٌ خَلْفَ أَبِي بَكْرٍ ، فَقَالَ : أَيُّهَا النَّاسُ إِنَّهُ لَمْ يَبْقَ مِنْ مُبَشِّرَاتِ النُّبُوَّةِ إِلا الرُّؤْيَا الصَّالِحَةُ ، يَرَاهَا الْمُسْلِمُ أَوْ تُرَى لَهُ "" ، ثُمَّ قَالَ : "" أَلا إِنِّي نُهِيتُ أَنْ أَقْرَأَ رَاكِعًا أَوْ سَاجِدًا ، فَأَمَّا الرُّكُوعُ فَعَظِّمُوا فِيهِ الرَّبَّ ، وَأَمَّا السُّجُودُ فَاجْتَهِدُوا فِي الدُّعَاءِ ، قَمَنٌ أَنْ يُسْتَجَابَ لَكُمْ """"""","Sahih|Sahih|Isnaad Hasan","Sunan al-Kubra al-Nasai 628","","أَخْبَرَنَا هَنَّادُ بْنُ السَّرِيِّ فِي حَدِيثِهِ عَنْ أَبِي الْأَحْوَصِ عَنْ عَطَاءٍ عَنْ سَالِمٍ قَالَ أَتَيْنَا أَبَا مَسْعُودٍ فَقُلْنَا لَهُ","The Book of Tatbiq"
"629","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ رَاهَوَيْهِ ، قَالَ : أنبا أَبُو مُعَاوِيَةَ ، قَالَ : حَدَّثَنَا الأَعْمَشُ ، عَنْ سَعْدِ بْنِ عُبَيْدَةَ ، عَنِ الْمُسْتَوْرِدِ بْنِ الأَحْنَفِ ، عَنْ صِلَةَ بْنِ زُفَرٍ ، عَنْ حُذَيْفَةَ ، قَالَ : صَلَّيْتُ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَرَكَعَ ، فَقَالَ فِي رُكُوعِهِ : "" سُبْحَانَ رَبِّيَ الْعَظِيمِ "" ، وَفِي سُجُودِهِ : "" سُبْحَانَ رَبِّيَ الأَعْلَى """"""","Sahih|Sahih|Isnaad Hasan","Sunan al-Kubra al-Nasai 629","","أَخْبَرَنَا أَحْمَدُ بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا حُسَيْنٌ عَنْ زَائِدَةَ عَنْ عَطَاءٍ عَنْ سَالِمٍ أَبِي عَبْدِ اللهِ عَنْ عُقْبَةَ بْنِ عَمْرٍو قَالَ","The Book of Tatbiq"
"630","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ ، قَالَ : حَدَّثَنَا خَالِدٌ ، وَيَزِيدُ ، قَالا : حَدَّثَنَا شُعْبَةُ ، عَنْ مَنْصُورٍ ، عَنْ أَبِي الضُّحَى ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَةَ ، قَالَتْ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُكْثِرُ أَنْ يَقُولُ فِي رُكُوعِهِ وَسُجُودِهِ : سُبْحَانَكَ رَبِّنَا وَبِحَمْدِكَ اللَّهُمَّ اغْفِرْ لِي """"""","","Sunan al-Kubra al-Nasai 630","","أَخْبَرَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ عَنِ ابْنِ عُلَيَّةَ عَنْ عَطَاءِ بْنِ السَّائِبِ عَنْ سَالِمٍ الْبَرَّادِ قَالَ","The Book of Tatbiq"
"631","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى ، قَالَ : حَدَّثَنَا خَالِدٌ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، قَالَ : أَنْبَأَنِي قَتَادَةُ ، عَنْ مُطَرِّفٍ ، عَنْ عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَقُولُ فِي رُكُوعَهُ : سُبُّوحٌ قُدُّوسٌ رَبُّ الْمَلائِكَةِ وَالرُّوحِ """"""","Sahih|Sahih|Isnaad Sahih Sahih Bukhari","Sunan al-Kubra al-Nasai 631","","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ قَالَ حَدَّثَنَا يَحْيَى قَالَ حَدَّثَنَا عَبْدُ الْحَمِيدِ بْنِ جَعْفَرٍ قَالَ حَدَّثَنِي مُحَمَّدُ بْنُ عَطَاءٍ عَنْ أَبِي حُمَيْدٍ السَّاعِدِيِّ قَالَ","The Book of Tatbiq"
"632","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ، قَالَ : حَدَّثَنَا عَبْدُ الْعَزِيزِ بْنِ أَبِي سَلَمَةَ ، قَالَ : حَدَّثَنِي عَمِّي الْمَاجِشُونُ بْنُ أَبِي سَلَمَةَ ، عَنْ عَبْدِ الرَّحْمَنِ الأَعْرَجِ ، عَنْ عُبَيْدِ اللَّهِ بْنِ أَبِي رَافِعٍ ، عَنْ عَلِيِّ بْنِ أَبِي طَالِبٍ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا رَكَعَ ، قَالَ : اللَّهُمَّ لَكَ رَكَعْتُ ، وَلَكَ أَسْلَمْتُ ، وَبِكَ آمَنْتُ ، خَشَعَ لَكَ سَمْعِي ، وَبَصَرِي ، وَعِظَامِي ، وَمُخِّي ، وَعَصَبِي """"""","Sahih|Sahih|Isnaad Sahih","Sunan al-Kubra al-Nasai 632","","أَخْبَرَنَا عُبَيْدُ اللهِ بْنُ سَعِيدٍ السَّرَخْسِيُّ أَبُو قُدَامَةَ قَالَ حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَةَ عَنْ أَشْعَثَ عَنْ مُحَمَّدٍ عَنْ عُبَيْدَةَ عَنْ عَلِيٍّ قَالَ","The Book of Tatbiq"
"633","أَخْبَرَنَا يَحْيَى بْنُ عُثْمَانَ الْحِمْصِيُّ ، قَالَ : حَدَّثَنَا أَبُو حَيْوَةَ ، قَالَ : حَدَّثَنَا شُعَيْبٌ ، عَنْ مُحَمَّدِ بْنِ الْمُنْكَدِرِ ، عَنْ جَابِرٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِنَحْوٍ : أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا رَكَعَ ، قَالَ : اللَّهُمَّ لَكَ رَكَعْتُ ، وَبِكَ آمَنْتُ ، وَلَكَ أَسْلَمْتُ ، وَعَلَيْكَ تَوَكَّلْتُ ، أَنْتَ رَبِّي خَشَعَ سَمْعِي ، وَبَصَرِي ، وَدَمِي ، وَلَحْمِي ، وَعَظْمِي ، وَعَصَبِي ، لِلَّهِ رَبِّ الْعَالَمِينَ """"""","Hasan Sahih Isnaad|Hasan Sahih Isnaad|Sahih Muslim","Sunan al-Kubra al-Nasai 633","","أَخْبَرَنَا عُبَيْدُ اللهِ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا يَحْيَى بْنُ سَعِيدٍ عَنِ ابْنِ عَجْلَانَ عَنْ إِبْرَاهِيمَ بْنِ عَبْدِ اللهِ بْنِ حُنَيْنٍ عَنْ أَبِيهِ عَنِ ابْنِ عَبَّاسٍ عَنْ عَلِيٍّ قَالَ","The Book of Tatbiq"
"634","أَخْبَرَنَا يَحْيَى بْنُ عُثْمَانَ ، قَالَ : حَدَّثَنَا ابْنُ حِمْيَرَ ، قَالَ : حَدَّثَنَا شُعَيْبٌ ، عَنْ مُحَمَّدِ بْنِ الْمُنْكَدِرِ ، وَذَكَرَ آخَرُ قَبْلَهُ ، عَنْ عَبْدِ الرَّحْمَنِ الأَعْرَجِ ، عَنْ مُحَمَّدِ بْنِ مَسْلَمَةَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا قَامَ يُصَلِّي تَطَوُّعًا ، يَقُولُ إِذَا رَكَعَ : اللَّهُمَّ لَكَ رَكَعْتُ ، وَبِكَ آمَنْتُ ، وَلَكَ أَسْلَمْتُ ، وَعَلَيْكَ تَوَكَّلْتُ ، أَنْتَ رَبِّي خَشَعَ جَمِيعُ سَمْعِي ، وَبَصَرِي ، وَلَحْمِي ، وَدَمِي ، وَمُخِّي ، وَعَصَبِي لِلَّهِ رَبِّ الْعَالَمِينَ """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 634","","أَخْبَرَنَا الْحَسَنُ بْنُ دَاوُدَ الْمُنْكَدِرِيُّ قَالَ حَدَّثَنَا ابْنُ أَبِي فُدَيْكٍ عَنِ الضَّحَّاكِ بْنِ عُثْمَانَ عَنْ إِبْرَاهِيمَ بْنِ حُنَيْنٍ عَنْ أَبِيهِ عَنْ عَبْدِ اللهِ بْنِ عَبَّاسٍ عَنْ عَلِيٍّ هُوَ ابْنُ أَبِي طَالِبٍ قَالَ","The Book of Tatbiq"
"635","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا بَكْرُ بْنُ مُضَرٍ ، عَنِ ابْنِ عَجْلانَ ، عَنْ عَلِيِّ بْنِ يَحْيَى الزُّرَقِيِّ ، عَنْ أَبِيهِ ، عَنْ عَمِّهِ ، وَكَانَ بَدْرِيًّا ، قَالَ : كُنَّا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، إِذْ دَخَلَ رَجُلٌ الْمَسْجِدَ فَصَلَّى ، وَرَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَرْمُقُهُ وَلا يَشْعُرُ ، ثُمَّ انْصَرَفَ ، فَأَتَى رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَرَدَّ عَلَيْهِ السَّلامَ ، ثُمَّ قَالَ :  ارْجِعْ فَصَلِّ فَإِنَّكَ لَمْ تُصَلِّ "" ، قَالَ : لا أَدْرِي ، قَالَ فِي الثَّانِيَةِ أَوْ فِي الثَّالِثَةِ ، قَالَ : وَالَّذِي أَنْزَلَ عَلَيْكَ الْكِتَابَ لَقَدْ جَهَدْتُ فَعَلِّمْنِي وَأَرِنِي ، قَالَ : ""إِذَا أَرَدْتَ الصَّلاةَ فَتَوَضَّأْ ، فَأَحْسَنِ الْوُضُوءَ ، ثُمَّ قُمْ فَاسْتَقْبِلِ الْقِبْلَةَ ، ثُمَّ كَبِّرْ ، ثُمَّ اقْرَأْ ، ثُمَّ ارْكَعْ حَتَّى تَطْمَئِنَّ رَاكِعًا ، ثُمَّ ارْفَعْ حَتَّى تَعْتَدِلَ قَائِمًا ثُمَّ اسْجُدْ حَتَّى تَطْمَئِنَّ سَاجِدًا ، ثُمَّ ارْفَعْ رَأْسَكَ حَتَّى تَطْمَئِنَّ قَاعِدًا ، ثُمَّ اسْجُدْ حَتَّى تَطْمَئِنَّ سَاجِدًا ، فَإِذَا صَنَعْتَ ذَلِكَ فَقَدْ قَضَيْتَ صَلاتَكَ ، وَمَا انْتَقَصْتَ مِنْ ذَلِكَ فَإِنَّمَا تَنْتَقِصُهُ مِنْ صَلاتِكَ """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 635","","أَخْبَرَنَا عِيسَى بْنُ حَمَّادِ زُغْبَةَ عَنِ اللَّيْثِ عَنْ يَزِيدَ عَنْ إِبْرَاهِيمَ بْنَ عَبْدِ اللهِ بْنِ حُنَيْنٍ أَنَّ أَبَاهُ حَدَّثَهُ","The Book of Tatbiq"
"636","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى ، عَنْ خَالِدٍ ، قَالَ : حدَّثَنَا شُعْبَةُ ، عَنْ قَتَادَةَ ، قَالَ : سَمِعْتُ أَنَسًا يُحَدِّثُ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : أَتِمُّوا الرُّكُوعَ وَالسُّجُودَ إِذَا رَكَعْتُمْ وَسَجَدْتُمْ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 636","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ عَنْ مَالِكٍ عَنْ نَافِعٍ عَنْ إِبْرَاهِيمَ بْنِ عَبْدِ اللهِ بْنِ حُنَيْنٍ عَنْ أَبِيهِ عَنْ عَلِيٍّ قَالَ","The Book of Tatbiq"
"637","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ ، قَالَ : أنبا عَبْدُ اللَّهِ ، عَنْ قَيْسِ بْنِ سُلَيْمٍ الْعَنْبَرِيِّ ، قَالَ : حَدَّثَنِي عَلْقَمَةُ بْنُ وَائِلٍ ، قَالَ : حَدَّثَنِي أَبِي ، قَالَ : صَلَّيْتُ خَلْفَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَرَأَيْتُهُ يَرْفَعُ يَدَيْهِ إِذَا افْتَتَحَ الصَّلاةَ ، وَإِذَا رَكَعَ ، وَإِذَا قَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ ""، هَكَذَا فَأَشَارَ قَيْسٌ إِلَى نَحْوِ الأُذُنَيْنِ""","Sahih|Sahih|Sahih Muslim","Sunan al-Kubra al-Nasai 637","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ أَخْبَرَنَا سُفْيَانُ عَنْ سُلَيْمَانَ بْنِ سُحَيْمٍ عَنْ إِبْرَاهِيمَ بْنِ عَبْدِ اللهِ بْنِ مَعْبَدِ بْنِ عَبَّاسٍ عَنْ أَبِيهِ عَنِ ابْنِ عَبَّاسٍ قَالَ","The Book of Tatbiq"
"638","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ ، قَالَ : حَدَّثَنَا يَزِيدُ هُوَ ابْنُ زُرَيْعٍ ، قَالَ : حَدَّثَنَا سَعِيدٌ ، عَنْ قَتَادَةَ ، عَنْ نَصْرِ بْنِ عَاصِمٍ ، أَنَّهُ حَدَّثَهُمْ ، عَنْ مَالِكِ بْنِ الْحُوَيْرِثِ ، أَنَّهُ رَأَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَرْفَعُ يَدَيْهِ إِذَا رَكَعَ ، وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ ، حَتَّى يُحَاذِي بِهِمَا فُرُوعَ أُذُنَيْهِ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 638","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ رَاهَوَيْهِ قَالَ أَخْبَرَنَا أَبُو مُعَاوِيَةَ قَالَ حَدَّثَنَا الْأَعْمَشُ عَنْ سَعْدِ بْنِ عُبَيْدَةَ عَنِ الْمُسْتَوْرِدِ بْنِ الْأَحْنَفِ عَنْ صِلَةَ بْنِ زُفَرٍ عَنْ حُذَيْفَةَ قَالَ","The Book of Tatbiq"
"639","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا يَحْيَى بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا مَالِكُ بْنُ أَنَسٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنْ أَبِيهِ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  كَانَيَرْفَعُ يَدَيْهِ إِذَا دَخَلَ الصَّلاةَ حَذْوَ مَنْكِبَيْهِ ، وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ فَعَلَ مِثْلَ ذَلِكَ ، وَإِذَا قَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ قَالَ : "" رَبَّنَا لَكَ الْحَمْدُ "" ، وَكَانَ لا يَرْفَعُ يَدَيْهِ بَيْنَ السَّجْدَتَيْنِ """"""","Sahih|Sahih|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 639","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ قَالَ حَدَّثَنَا خَالِدٌ وَيَزِيدُ قَالَا حَدَّثَنَا شُعْبَةُ عَنْ مَنْصُورٍ عَنْ أَبِي الضُّحَى عَنْ مَسْرُوقٍ عَنْ عَائِشَةَ قَالَتْ","The Book of Tatbiq"
"640","أَخْبَرَنَا مَحْمُودُ بْنُ غَيْلانَ الْمَرْوَزِيُّ ، قَالَ : أنبا وَكِيعٌ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، عَنْ عَاصِمِ بْنِ كُلَيْبٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ عَلْقَمَةَ ، عَنْ عَبْدِ اللَّهِ أَنَّهُ قَالَ : أَلا أُصَلِّي بِكُمْ صَلاةَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ؟ فَصَلَّى فَلَمْ يَرْفَعْ يَدَيْهِ إِلا مُرَّةً وَاحِدَةً """"""","","Sunan al-Kubra al-Nasai 640","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى قَالَ حَدَّثَنَا خَالِدٌ قَالَ حَدَّثَنَا شُعْبَةُ قَالَ أَنْبَأَنِي قَتَادَةُ عَنْ مُطَرِّفٍ عَنْ عَائِشَةَ قَالَتْ","The Book of Tatbiq"
"641","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ ، قَالَ : أنبا عَبْدُ اللَّهِ ، عَنْ مَالِكِ بْنِ أَنَسٍ ، عَنِ ابْنِ شِهَابٍ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا افْتَتَحَ الصَّلاةَ ، رَفَعَ يَدَيْهِ حَذْوَ مَنْكِبَيْهِ ، وَإِذَا كَبَّرَ لِلرُّكُوعِ ، وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ رَفَعَهُمَا كَذَلِكَ أَيْضًا ، وَقَالَ : "" سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ ، رَبِّنَا وَلَكَ الْحَمْدُ "" ، وَكَانَ لا يَفْعَلُ ذَلِكَ فِي السُّجُودِ""","Sahih|Sahih|Sahih Muslim","Sunan al-Kubra al-Nasai 641","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا عَبْدُ الرَّحْمَنِ قَالَ حَدَّثَنَا عَبْدُ الْعَزِيزِ بْنِ أَبِي سَلَمَةَ قَالَ حَدَّثَنِي عَمِّي الْمَاجِشُونُ بْنُ أَبِي سَلَمَةَ عَنْ عَبْدِ الرَّحْمَنِ الْأَعْرَجِ عَنْ عُبَيْدِ اللهِ بْنِ أَبِي رَافِعٍ عَنْ عَلِيِّ بْنِ أَبِي طَالِبٍ","The Book of Tatbiq"
"642","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أنبا عَبْدُ الرَّزَّاقِ ، قَالَ : أنبا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا رَفَعَ رَأْسَهُ مِنَ الرَّكْعَةِ ، قَالَ : "" اللَّهُمَّ رَبِّنَا وَلَكَ الْحَمْدُ """"""","Sahih|Sahih|Isnaad Sahih","Sunan al-Kubra al-Nasai 642","","أَخْبَرَنَا يَحْيَى بْنُ عُثْمَانَ الْحِمْصِيُّ قَالَ حَدَّثَنَا أَبُو حَيْوَةَ قَالَ حَدَّثَنَا شُعَيْبٌ عَنْ مُحَمَّدِ بْنِ الْمُنْكَدِرِ عَنْ جَابِرٍ","The Book of Tatbiq"
"643","أَخْبَرَنَا هَنَّادُ بْنُ السَّرِيِّ ، عَنِ ابْنِ عُيَيْنَةَ ، عَنِ الزُّهْرِيِّ ، عَنْ أَنَسٍ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : سَقَطَ مِنْ فَرَسٍ عَلَى شِقِّهِ الأَيْمَنِ فَدَخَلُوا عَلَيْهِ يَعُودُونَهُ فَحَضَرَتِ الصَّلاةُ ، فَلَمَّا قَضَى الصَّلاةَ ، قَالَ : إِنَّمَا الإِمَامُ لِيُؤْتَمَّ بِهِ ، فَإِذَا رَكَعَ فَارْكَعُوا ، وَإِذَا رَفَعَ فَارْفَعُوا ، وَإِذَا قَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ ، فَقُولُوا : رَبَّنَا وَلَكَ الْحَمْدُ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 643","","أَخْبَرَنَا يَحْيَى بْنُ عُثْمَانَ قَالَ حَدَّثَنَا ابْنُ حِمْيَرَ قَالَ حَدَّثَنَا شُعَيْبٌ عَنْ مُحَمَّدِ بْنِ الْمُنْكَدِرِ وَذَكَرَ آخَرُ قَبْلَهُ عَنْ عَبْدِ الرَّحْمَنِ الْأَعْرَجِ عَنْ مُحَمَّدِ بْنِ مَسْلَمَةَ","The Book of Tatbiq"
"644","أَخْبَرَنَا مُحَمَّدُ بْنُ سَلَمَةَ أَبُو الْحَارِثِ الْمِصْرِيُّ ، قَالَ : أنبا ابْنُ الْقَاسِمِ ، عَنْ مَالِكٍ ، قَالَ : حَدَّثَنِي نُعَيْمُ بْنُ عَبْدِ اللَّهِ ، عَنْ عَلِيِّ بْنِ يَحْيَى الزُّرَقِيِّ ، عَنْ أَبِيهِ ، عَنْ رِفَاعَةَ بْنِ رَافِعٍ ، قَالَ : كُنَّا يَوْمًا نُصَلِّي وَرَاءَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا رَفَعَ رَأْسَهُ مِنَ الرَّكْعَةِ ، قَالَ : "" سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ "" ، فَقَالَ رَجُلٌ وَرَاءَهُ : رَبِّنَا وَلَكَ الْحَمْدُ حَمْدًا كَثِيرًا طَيِّبًا مُبَارَكًا فِيهِ ، فَلَمَّا انْصَرَفَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : "" مِنَ الْمُتَكَلِّمُ آنِفًا ؟ "" قَالَ رَجُلٌ : أَنَا يَا رَسُولَ اللَّهِ ، قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" لَقَدْ رَأَيْتُ بِضْعَةً وَثَلاثِينَ مَلِكًا يَبْتَدِرُونَهَا أَيُّهُمْ يَكْتُبُهَا أَوَّلُ ؟ """"""","","Sunan al-Kubra al-Nasai 644","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا بَكْرٌ عَنِ ابْنِ عَجْلَانَ عَنْ عَلِيِّ بْنِ يَحْيَى الزُّرَقِيِّ عَنْ أَبِيهِ عَنْ عَمِّهِ وَكَانَ بَدْرِيًّا قَالَ","The Book of Tatbiq"
"645","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، عَنْ مَالِكٍ ، عَنْ سُمَيٍّ ، عَنْ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : إِذَا قَالَ الإِمَامُ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ ، فَقُولُوا : رَبَّنَا وَلَكَ الْحَمْدُ ، فَإِنَّهُ مَنْ وَافَقَ قَوْلُهُ قَوْلَ الْمَلائِكَةِ غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ """"""","Sahih|Sahih|Isnaad Sahih","Sunan al-Kubra al-Nasai 645","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى عَنْ خَالِدٍ قَالَ حَدَّثَنَا شُعْبَةُ عَنْ قَتَادَةَ قَالَ سَمِعْتُ أَنَسًا يُحَدِّثُ","The Book of Tatbiq"
"646","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ ، قَالَ : حَدَّثَنَا خَالِدٌ ، قَالَ : حَدَّثَنَا سَعِيدٌ ، عَنْ قَتَادَةَ ، عَنْ يُونُسَ بْنِ جُبَيْرٍ ، عَنْ حِطَّانِ بْنِ عَبْدِ اللَّهِ ، أَنَّهُ شَهِدَ أَبَا مُوسَى ، قَالَ : إِنَّ نَبِيَّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خَطَبَنَا فَبَيَّنَ لَنَا سُنَّتَنَا ، وَعَلَّمَنَا صَلاتَنَا ، فَقَالَ : إِذَا صَلَّيْتُمْ فَأَقِيمُوا صُفُوفَكُمْ ، ثُمَّ لِيَؤُمَّكُمْ أَحَدُكُمْ ، فَإِذَا كَبَّرَ الإِمَامُ فَكَبِّرُوا ، وَإِذَا قَرَأَ  غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ فَقُولُوا : آمِينَ يُجِبْكُمُ اللَّهُ ، فَإِذَا كَبَّرَ وَرَكَعَ فَكَبِّرُوا وَارْكَعُوا ، فَإِنَّ الإِمَامَ يَرْكَعُ قَبْلَكُمْ وَيَرْفَعُ قَبْلَكُمْ "" ، قَالَ نَبِيُّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" فَتِلْكَ بِتِلْكَ ، وَإِذَا قَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ ، فَقُولُوا : اللَّهُمَّ رَبَّنَا لَكَ الْحَمْدُ ، يُسْمَعِ اللَّهُ لَكُمْ ، فَإِنَّ اللَّهَ قَالَ عَلَى لِسَانِ نَبِيِّهِ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ ، فَإِذَا كَبَّرَ وَسَجَدَ فَكَبِّرُوا وَاسْجُدُوا ، فَإِنَّ الإِمَامَ يَسْجُدُ قَبْلَكُمْ وَيَرْفَعُ قَبْلَكُمْ "" ، قَالَ نَبِيُّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" فَتِلْكَ بِتِلْكَ ، فَإِذَا كَانَ عِنْدَ الْقَعْدَةِ فَلْيَكُنْ مِنْ أَوَّلِ قَوْلِ أَحَدِكُمْ : التَّحِيَّاتُ الطَّيِّبَاتُ الصَّلَوَاتُ لِلَّهِ ، سَلامٌ عَلَيْكُمْ أَيُّهَا النَّبِيُّ وَرَحِمَهُ اللَّهِ وَبَرَكَاتُهُ ، سَلامٌ عَلَيْنَا وَعَلَى عَبَّادِ اللَّهِ الصَّالِحِينَ ، أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ ، وَأَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ ، سَبْعُ كَلِمَاتٍ وَهِيَ تَحِيَّةُ الصَّلاةِ """"""","","Sunan al-Kubra al-Nasai 646","","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ قَالَ أَخْبَرَنَا عَبْدُ اللهِ عَنْ قَيْسِ بْنِ سُلَيْمٍ الْعَنْبَرِيِّ قَالَ حَدَّثَنِي عَلْقَمَةُ بْنُ وَائِلٍ قَالَ حَدَّثَنِي أَبِي قَالَ","The Book of Tatbiq"
"647","أَخْبَرَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ ، قَالَ : حَدَّثَنَا ابْنُ عُلَيَّةَ ، قَالَ : أنبا شُعْبَةُ ، عَنِ الْحَكَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ، عَنِ الْبَرَاءِ بْنِ عَازِبٍ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ رُكُوعُهُ وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ وَسُجُودُهُ ، وَمَا بَيْنَ السَّجْدَتَيْنِ قَرِيبًا مِنَ السَّوَاءِ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 647","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ قَالَ حَدَّثَنَا يَزِيدُ وَهُوَ ابْنُ زُرَيْعٍ قَالَ حَدَّثَنَا سَعِيدٌ عَنْ قَتَادَةَ عَنْ نَصْرِ بْنِ عَاصِمٍ أَنَّهُ حَدَّثَهُمْ عَنْ مَالِكِ بْنِ الْحُوَيْرِثِ","The Book of Tatbiq"
"648","أَخْبَرَنَا أَبُو دَاوُدَ سُلَيْمَانُ بْنُ سَيْفٍ الْحَرَّانِيُّ ، قَالَ : حَدَّثَنَا سَعِيدُ بْنُ عَامِرٍ ، قَالَ : حَدَّثَنَا هِشَامُ بْنُ حَسَّانَ ، عَنْ قَيْسِ بْنِ سَعْدٍ ، عَنْ عَطَاءٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : كَانَ إِذَا قَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ ، قَالَ : اللَّهُمَّ رَبِّنَا لَكَ الْحَمْدُ مِلْءَ السَّمَوَاتِ وَالأَرْضِ ، وَمِلْءَ مَا شِئْتَ مِنْ شَيْءٍ بَعْدُ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 648","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا يَحْيَى بْنُ سَعِيدٍ قَالَ حَدَّثَنَا مَالِكُ بْنُ أَنَسٍ عَنِ الزُّهْرِيِّ عَنْ سَالِمٍ عَنْ أَبِيهِ","The Book of Tatbiq"
"649","أَخْبَرَنَا مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ إِبْرَاهِيمَ ، قَالَ : حَدَّثَنَا يَحْيَى ، قَالَ : حَدَّثَنَا إِبْرَاهِيمُ وَهُوَ ابْنُ نَافِعٍ ، عَنْ وَهْبِ بْنِ مِينَاسٍ الْعَدَنِيِّ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا أَرَادَ السُّجُودَ بَعْدَ الرَّكْعَةِ يَقُولُ : اللَّهُمَّ لَكَ الْحَمْدُ مِلْءَ السَّمَوَاتِ وَمِلْءَ الأَرْضِ ، وَمِلْءَ مَا شِئْتَ مِنْ شَيْءٍ بَعْدُ """"""","","Sunan al-Kubra al-Nasai 649","","أَخْبَرَنَا مَحْمُودُ بْنُ غَيْلَانَ الْمَرْوَزِيُّ قَالَ حَدَّثَنَا وَكِيعٌ قَالَ حَدَّثَنَا سُفْيَانُ عَنْ عَاصِمِ بْنِ كُلَيْبٍ عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ عَنْ عَلْقَمَةَ عَنْ عَبْدِ اللهِ","The Book of Tatbiq"
"650","أَخْبَرَنَا عَمْرُو بْنُ هِشَامٍ الْحَرَّانِيُّ أَبُو أُمَيَّةَ ، قَالَ : حَدَّثَنَا مَخْلَدٌ ، عَنْ سَعِيدِ بْنِ عَبْدِ الْعَزِيزِ ، عَنْ عَطِيَّةَ بْنِ قَيْسٍ ، عَنْ قَزْعَةَ بْنِ يَحْيَى ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  كَانَيَقُولُ حِينَ يَقُولُ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ ، رَبِّنَا لَكَ الْحَمْدُ مِلْءَ السَّمَوَاتِ ، وَمِلْءَ الأَرْضِ ، وَمِلْءَ مَا شِئْتَ مِنْ بَعْدُ ، أَهْلَ الثَّنَاءِ وَالْمَجْدِ ، حَقُّ مَا قَالَ الْعَبْدُ ، كُلُّنَا لَكَ عَبْدٌ ، لا نَازَعَ لَمَّا أَعْطَيْتَ ، وَلا يَنْفَعُ ذَا الْجَدِّ مِنْكَ الْجَدُّ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 650","","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ قَالَ حَدَّثَنَا عَبْدُ اللهِ عَنْ مَالِكٍ عَنِ ابْنِ شِهَابٍ عَنْ سَالِمٍ عَنِ ابْنِ عُمَرَ","The Book of Tatbiq"
"651","أَخْبَرَنَا حُمَيْدُ بْنُ مَسْعَدَةَ الْبَصْرِيُّ ، قَالَ : حَدَّثَنَا يَزِيدُ بْنُ زُرَيْعٍ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنْ عَمْرِو بْنِ مُرَّةَ ، عَنْ أَبِي حَمْزَةَ ، عَنْ رَجُلٍ مِنْ بَنِي عَبْسٍ ، عَنْ حُذَيْفَةَ ، أَنَّهُ صَلَّى مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ذَاتَ لَيْلَةٍ فَسَمِعَ حِينَ كَبَّرَ قَالَ : اللَّهُ أَكْبَرُ ذَا الْجَبَرُوتِ ، وَالْمَلَكُوتِ ، وَالْكِبْرِيَاءِ ، وَالْعَظَمَةِ ، وَكَانَ يَقُولُ فِي رُكُوعِهِ : سُبْحَانَ رَبِّي الْعَظِيمِ ، وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ ، قَالَ : لِرَبِّيَ الْحَمْدُ لِرَبِّيَ ، وَفِي سُجُودِهِ : سُبْحَانَ رَبِّيَ الأَعْلَى ، وَبَيْنَ السَّجْدَتَيْنِ : رَبِّ اغْفِرْ لِي ، رَبِّ اغْفِرْ لِي ، وَكَانَ قِيَامُهُ وَرُكُوعُهُ ، وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ وَسُجُودُهُ وَمَا بَيْنَ السَّجْدَتَيْنِ قَرِيبًا مِنَ السَّوَاءِ """"""","","Sunan al-Kubra al-Nasai 651","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ حَدَّثَنَا عَبْدُ الرَّزَّاقِ قَالَ حَدَّثَنَا مَعْمَرٌ عَنِ الزُّهْرِيِّ عَنْ أَبِي سَلَمَةَ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Tatbiq"
"652","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أنبا جَرِيرُ ، عَنْ سُلَيْمَانَ التَّيْمِيِّ ، عَنْ أَبِي مِجْلَزٍ ، عَنْ أَنَسِ بْنِ مَالِكٍ ، قَالَ : قَنَتَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ شَهْرًا بَعْدَ الرُّكُوعِ ، يَدْعُو عَلَى رِعْلٍ وَذَكْوَانَ وَعُصَيَّةَ عَصَتِ اللَّهَ وَرَسُولِهِ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 652","","أَخْبَرَنَا هَنَّادُ بْنُ السَّرِيِّ عَنِ ابْنِ عُيَيْنَةَ عَنِ الزُّهْرِيِّ عَنْ أَنَسٍ","The Book of Tatbiq"
"653","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا حَمَّادٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ أَنَسِ بْنِ مَالِكٍ ، سُئِلَ هَلْ قَنَتَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي صَلاةِ الصُّبْحِ ؟ فَقَالَ : نَعَمْ ، فَقِيلَ لَهُ : قَبْلَ الرُّكُوعِ أَوْ بَعْدَهُ ؟ ، فَقَالَ : بَعْدَ الرُّكُوعِ """"""","","Sunan al-Kubra al-Nasai 653","","أَخْبَرَنَا مُحَمَّدُ بْنُ سَلَمَةَ أَبُو الْحَارِثِ الْمِصْرِيُّ قَالَ حَدَّثَنَا ابْنُ الْقَاسِمِ عَنْ مَالِكٍ قَالَ حَدَّثَنِي نُعَيْمُ بْنُ عَبْدِ اللهِ عَنْ عَلِيِّ بْنِ يَحْيَى الزُّرَقِيِّ عَنْ أَبِيهِ عَنْ رِفَاعَةَ بْنِ رَافِعٍ قَالَ","The Book of Tatbiq"
"654","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ ، قَالَ : حَدَّثَنَا بِشْرُ بْنُ الْمُفَضَّلِ ، عَنْ يُونُسَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ : حَدَّثَنِي بَعْضُ مَنْ صَلَّى مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلاةَ الصُّبْحِ ، فَلَمَّا قَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ فِي الرَّكْعَةِ الثَّانِيَةِ ، قَامَ هُنَيَّهَةً """"""","","Sunan al-Kubra al-Nasai 654","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ عَنْ مَالِكٍ عَنْ سُمَيٍّ عَنْ أَبِي صَالِحٍ عَنْ أَبِي هُرَيْرَةَ","The Book of Tatbiq"
"655","أَخْبَرَنَا مُحَمَّدُ بْنُ مَنْصُورٍ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، قَالَ : حَفِظْنَا مِنَ الزُّهْرِيِّ ، عَنْ سَعِيدٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : لَمَّا رَفَعَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَأْسَهُ مِنَ الرَّكْعَةِ الثَّانِيَةِ مِنْ صَلاةِ الصُّبْحِ ، قَالَ : اللَّهُمَّ أَنْجِ الْوَلِيدَ بْنَ الْوَلِيدِ ، وَسَلَمَةَ بْنَ هِشَامٍ ، وَعَيَّاشَ بْنَ أَبِي رَبِيعَةَ ، بِمَكَّةَ ، اللَّهُمَّ اشْدُدْ وَطْأَتَكَ عَلَى مُضَرٍ ، وَاجْعَلْهَا عَلَيْهِمْ سِنِينَ كَسِنِيِّ يُوسُفَ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 655","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ قَالَ حَدَّثَنَا خَالِدٌ قَالَ حَدَّثَنَا سَعِيدٌ عَنْ قَتَادَةَ عَنْ يُونُسَ بْنِ جُبَيْرٍ عَنْ حِطَّانِ بْنِ عَبْدِ اللهِ أَنَّهُ حَدَّثَ أَنَّهُ شَهِدَ أَبَا مُوسَى قَالَ","The Book of Tatbiq"
"656","أَخْبَرَنَا عَمْرُو بْنُ عُثْمَانَ ، قَالَ : حَدَّثَنَا بَقِيَّةُ ، عَنِ ابْنِ أَبِي حَمْزَةَ ، قَالَ : حَدَّثَنِي مُحَمَّدُ ، قَالَ : حَدَّثَنِي سَعِيدُ بْنُ الْمُسَيِّبِ ، وَأَبُو سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّ أَبَا هُرَيْرَةَ كَانَ يُحَدِّثُ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَدْعُو فِي الصَّلاةِ حِينَ يَقُولُ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ ، رَبِّنَا وَلَكَ الْحَمْدُ ، ثُمَّ يَقُولُ وَهُوَ قَائِمٌ قَبْلَ أَنْ يَسْجُدَ : اللَّهُمَّ أَنْجِ الْوَلِيدَ بْنَ الْوَلِيدِ ، وَسَلَمَةَ بْنَ هِشَامٍ ، وَعَيَّاشَ بْنَ أَبِي رَبِيعَةَ ، مِنَ الْمُؤْمِنِينَ ، اللَّهُمَّ اشْدُدْ وَطْأَتَكَ عَلَى مُضَرٍ ، وَاجْعَلْهَا عَلَيْهِمْ كَسِنِيِّ يُوسُفَ ، ثُمَّ يَقُولُ : اللَّهُ أَكْبَرُ ، فَيَسْجُدُ وَضَاحِيَةُ مُضَرٍ يَوْمَئِذٍ مُخَالِفُونَ لِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ""","Sahih|Sahih|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 656","","أَخْبَرَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ قَالَ حَدَّثَنَا ابْنُ عُلَيَّةَ قَالَ أَخْبَرَنَا شُعْبَةُ عَنِ الْحَكَمِ عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى عَنِ الْبَرَاءِ بْنِ عَازِبٍ","The Book of Tatbiq"
"657","أَخْبَرَنَا سُلَيْمَانُ بْنُ سَلْمٍ أَبُو دَاوُدَ الْبَلْخِيُّ ، قَالَ : حَدَّثَنَا النَّضْرُ ، قَالَ : أنبا هِشَامٌ ، عَنْ يَحْيَى ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : لأُقَرِّبَنَّ بِكُمْ صَلاةَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : فَكَانَ أَبُو هُرَيْرَةَ يَقْنُتُ فِي الرَّكْعَةِ الآخِرَةِ مِنْ صَلاةِ الظُّهْرِ ، وَصَلاةِ الْعِشَاءِ الآخِرَةِ ، وَصَلاةِ الصُّبْحِ ، بَعْدَمَا يَقُولُ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ ، فَيَدْعُو لِلْمُؤْمِنِينَ وَيَلْعَنُ الْكَفَرَةَ """"""","","Sunan al-Kubra al-Nasai 657","","أَخْبَرَنَا أَبُو دَاوُدَ سُلَيْمَانُ بْنُ سَيْفٍ الْحَرَّانِيُّ قَالَ حَدَّثَنَا سَعِيدُ بْنُ عَامِرٍ قَالَ حَدَّثَنَا هِشَامُ بْنُ حَسَّانَ عَنْ قَيْسِ بْنِ سَعْدٍ عَنْ عَطَاءٍ عَنِ ابْنِ عَبَّاسٍ","The Book of Tatbiq"
"658","أَخْبَرَنَا عُبَيْدُ اللَّهِ بْنُ سَعِيدٍ ، عَنْ عَبْدِ الرَّحْمَنِ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، وَشُعْبَةُ ، عَنْ عَمْرِو بْنِ مُرَّةَ ، وَأَنْبَا عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حَدَّثَنَا يَحْيَى ، عَنْ شُعْبَةَ ، وَسُفْيَانَ ، قَالا : حَدَّثَنَا عَمْرُو بْنُ مُرَّةَ ، عَنِ ابْنِ أَبِي لَيْلَى ، عَنِ الْبَرَاءِ بْنِ عَازِبٍ ،  أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""كَانَ يَقْنُتُ فِي الصُّبْحِ وَالْمَغْرِبِ """"""","","Sunan al-Kubra al-Nasai 658","","أَخْبَرَنِي مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ إِبْرَاهِيمَ قَالَ حَدَّثَنَا يَحْيَى قَالَ حَدَّثَنَا إِبْرَاهِيمُ وَهُوَ ابْنُ نَافِعٍ عَنْ وَهْبِ بْنِ مِينَاسٍ الْعَدَنِيِّ عَنْ سَعِيدِ بْنِ جُبَيْرٍ عَنِ ابْنِ عَبَّاسٍ","The Book of Tatbiq"
"659","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ : حَدَّثَنَا أَبُو دَاوُدَ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنْ قَتَادَةَ ، وَحَدَّثَنَا هِشَامٌ ، عَنْ قَتَادَةَ ، عَنْ أَنَسٍ ، أَنَّ النَّبِيَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَنَتَ شَهْرًا ، قَالَ شُعْبَةُ :  لَعَنَ رِجَالا "" ، وَقَالَ هِشَامٌ : "" يَدْعُو عَلَى أَحْيَاءَ مِنْ أَحْيَاءِ الْعَرَبِ "" ، ثُمَّ تَرَكَهُ بَعْدَ الرُّكُوعِ ، هَذَا قَوْلُ هِشَامٍ ، وَقَالَ شُعْبَةُ ، عَنْ قَتَادَةَ ، عَنْ أَنَسٍ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""قَنَتَ شَهْرًا يَلْعَنُ رَعْلا ، وَذَكْوَانَ ، وَلَحْيَانَ """"""","","Sunan al-Kubra al-Nasai 659","","أَخْبَرَنِي عَمْرُو بْنُ هِشَامٍ الْحَرَّانِيُّ أَبُو أُمَيَّةَ قَالَ حَدَّثَنَا مَخْلَدٌ عَنْ سَعِيدِ بْنِ عَبْدِ الْعَزِيزِ عَنْ عَطِيَّةَ بْنِ قَيْسٍ عَنْ قَزْعَةَ بْنِ يَحْيَى عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ","The Book of Tatbiq"
"660","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أنبا عَبْدُ الرَّزَّاقِ ، حَدَّثَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنْ أَبِيهِ ، أَنَّهُ سَمِعَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ،حِينَ رَفَعَ رَأْسَهُ فِي صَلاةِ الصُّبْحِ مِنَ الرَّكْعَةِ الآخِرَةِ ، قَالَ :  اللَّهُمَّ الْعَنْ فُلانًا وَفُلانًا ، دَعَا عَلَى نَاسٍ مِنَ الْمُنَافِقِينَ ، فَأَنْزَلَ اللَّهُ  لَيْسَ لَكَ مِنَ الأَمْرِ شَيْءٌ أَوْ يَتُوبَ عَلَيْهِمْ أَوْ يُعَذِّبَهُمْ فَإِنَّهُمْ ظَالِمُونَ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : لَمْ يَرْوِ هَذَا الْحَدِيثَ أَحَدٌ مِنَ الثِّقَاتِ إِلا مَعْمَرٌ""","Sahih|Sahih|Isnaad Sahih","Sunan al-Kubra al-Nasai 660","","أَخْبَرَنَا حُمَيْدُ بْنُ مَسْعَدَةَ الْبَصْرِيُّ قَالَ حَدَّثَنَا يَزِيدُ بْنُ زُرَيْعٍ قَالَ حَدَّثَنَا شُعْبَةُ عَنْ عَمْرِو بْنِ مُرَّةَ عَنْ أَبِي حَمْزَةَ عَنْ رَجُلٍ مِنْ بَنِي عَبْسٍ عَنْ حُذَيْفَةَ","The Book of Tatbiq"
