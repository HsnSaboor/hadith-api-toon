"15008","(۱۵۰۰۸) حدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ شَرِیکٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِالتَّنَوُّرِ فِی الْعَشْرِ۔","","Musannaf Ibn Abi Shaybah 15008","","","كتاب الحج"
"15009","(۱۵۰۰۹) حدَّثَنَا ابْنُ یَمَانٍ، عَنْ مَعْمَرٍ، عَنْ قَتَادَۃَ، عَنِ ابْنِ الْمُسَیَّبِ؛ أَنَّہُ کَانَ یَسْتَحِبُّ تَوْفِیرَ الشَّعْرِ عِنْدَالإِحْرَامِ۔","No Data Available","Musannaf Ibn Abi Shaybah 15009","","","كتاب الحج"
"15010","(۱۵۰۱۰) حدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ سَعِیدِ بْنِ یُوسُفَ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عِکْرِمَۃَ مَوْلَی ابْنِ عَبَّاسٍ، قَالَ: غَیَّرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ثَوبَیْہِ بِالتَّنْعِیمِ وَہُوَ مُحْرِمٌ۔ (ابوداؤد ۱۵۷۔ طبرانی ۱۱۵۱۰)","Da'if","Musannaf Ibn Abi Shaybah 15010","","","كتاب الحج"
"15011","(۱۵۰۱۱) حدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ إِبْرَاہِیمَ، قَالَ: یُغَیِّرُ الْمُحْرِمُ مِنْ ثِیَابِہِ مَا شَائَ، بَعْدَ أَنْ یَلْبَسَ ثِیَابَ الْمُحْرِمِ۔","No Data Available","Musannaf Ibn Abi Shaybah 15011","","","كتاب الحج"
"15012","(۱۵۰۱۲) حدَّثَنَا وَکِیعٌ ، عَنِ الصَّبَّاحِ بْنِ ثَابِتٍ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ : أَیَبِیعُ الْمُحْرِمُ ثِیَابَہُ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 15012","","","كتاب الحج"
"15013","(۱۵۰۱۳) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الصَّبَّاحِ ، عَنْ سَعِیدٍ ؛ بِنَحْوِ??ِ۔","No Data Available","Musannaf Ibn Abi Shaybah 15013","","","كتاب الحج"
"15014","(۱۵۰۱۴) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ (ح) وَیُونُسَ ، عَنِ الْحَسَنِ ، وَحَجَّاجٍ ، وَعَبْدِ الْمَلِکِ، وَعَطَائٍ؛ أَنَّہُمْ لَمْ یَرَوْا بَأْسًا أَنْ یُبَدِّلَ الْمُحْرِمُ ثِیَابَہُ ، أَوْ مَا سِوَی ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 15014","","","كتاب الحج"
"15015","(۱۵۰۱۵) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : لِلْمُحْرِمِ أَنْ یُبَدِّلَ مِنَ الثِّیَابِ مَا شَائَ۔","No Data Available","Musannaf Ibn Abi Shaybah 15015","","","كتاب الحج"
"15016","(۱۵۰۱۶) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ دَخَلَ حَمَّامَ الْجُحْفَۃِ وَہُوَ مُحْرِمٌ ، قَالَ: إِنَّ اللَّہَ لاَ یَصْنَعُ بِأَوْسَاخِکُمْ شَیْئًا۔","Sahih","Musannaf Ibn Abi Shaybah 15016","","","كتاب الحج"
"15017","(۱۵۰۱۷) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَدْخُلَ الْمُحْرِمُ الْحَمَّامَ ، وَیَقُولُ : إِنَّہُ لَفِی شُغُلٍ مِنْ دُخُولِ الْحَمَّامِ۔","No Data Available","Musannaf Ibn Abi Shaybah 15017","","","كتاب الحج"
"15018","(۱۵۰۱۸) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَرِہَ لِلْمُحْرِمِ أَنْ یَدْخُلَ الْحَمَّامَ۔","No Data Available","Musannaf Ibn Abi Shaybah 15018","","","كتاب الحج"
"15019","(۱۵۰۱۹) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَانَتْ لاَ تَرَی بَأْسًا أَنْ یَطُوفَ الرَّجُلُ ثَلاَثَۃَ أَسْبَاعٍ ، أَوْ خَمْسَۃً ، ثُمَّ یُصَلِّیَ۔","Da'if","Musannaf Ibn Abi Shaybah 15019","","","كتاب الحج"
"15020","(۱۵۰۲۰) حدَّثَنَا ابْنُ إِدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَانَتْ تَقْرُنُ بَیْنَ الأَسَابِیعِ۔","","Musannaf Ibn Abi Shaybah 15020","","","كتاب الحج"
"15021","(۱۵۰۲۱) حدَّثَنَا أَبُو بَکْرٍ ، عَنِْ لَیْثٍ ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : لاَ بَأْسَ أَنْ یَطُوفَ الرَّجُلُ ثَلاَثَۃَ أَسْبَاعٍ ، أَوْ خَمْسَۃً ، ثُمَّ یُصَلِّیَ رَکْعَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 15021","","","كتاب الحج"
"15022","(۱۵۰۲۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ قَرَنَ مَرَّۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 15022","","","كتاب الحج"
"15023","(۱۵۰۲۳) حدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ أَنْکَرَہُ ، وَقَالَ : مَا فَعَلَہُ أَحَدٌ إِلاَّ رَجُلٌ مِنْ قُرَیْشٍ ، الْمِسْوَرُ بْنُ مَخْرَمَۃَ۔","","Musannaf Ibn Abi Shaybah 15023","","","كتاب الحج"
"15024","(۱۵۰۲۴) حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ حَنْظَلَۃَ ، عَنْ طَاوُوسٍ ؛ أَنَّہُ طَافَ ثَلاَثَۃَ أَسْبَاعٍ ، ثُمَّ صَلَّی سِتَّ رَکَعَاتٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 15024","","","كتاب الحج"
"15025","(۱۵۰۲۵) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّ طَاوُوسًا ، وَالْمِسْوَرَ بْنَ مَخْرَمَۃَ کَانَا یَقْرِنَانِ بَیْنَ الأَسَابِیعِ ، وَکَانَ عَطَائٌ لاَ یَرَی بِذَلِکَ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 15025","","","كتاب الحج"
"15026","(۱۵۰۲۶) حدَّثَنَا حَفْصٌ ، عَنْ عَبْدِ الْمَلِکِ ، قَالَ : جَاوَرْتُ بِمَکَّۃَ وَثَمَّ سعِیدُ بْنُ جُبَیْرٍ ، وَعَلِیُّ بْنُ حُسَیْنٍ ، فَطَافَ عَلِیُّ بْنُ حُسَیْنٍ ثَلاَثَۃَ أَسَابِیعَ ، وَصَلَّی لِکُلِّ سُبُوعٍ رَکْعَتَیْنِ ، ثُمَّ أَتَی الْحَجَرَ فَاسْتَلَمَہُ ، وَکَانَ سَعِیدُ بْنُ جُبَیْرٍ یَفْعَلُہُ بِالنَّہَارِ۔","No Data Available","Musannaf Ibn Abi Shaybah 15026","","","كتاب الحج"
"15027","(۱۵۰۲۷) حدَّثَنَا حَفْصٌ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، قَالَ : ذَکَرُوا عِنْدَ الْقَاسِمِ أَنَّ عَائِشَۃَ کَانَتْ تَقْرِنُ بَیْنَ الأَسَابِیعِ، فَقَالَ : اتَّقُوا اللَّہَ ، وَلاَ تَقُولُوا عَلَی أُمِّ الْمُؤْمِنِینَ مَا لَمْ تَکُنْ تَفْعَلُ۔","Da'if","Musannaf Ibn Abi Shaybah 15027","","","كتاب الحج"
"15028","(۱۵۰۲۸) حدَّثَنَا یَحْیَی بْنُ سُلَیْمٍ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنِ الزُّہْرِیِّ ، قَالَ : مَضَتِ السُّنَّۃُ أَنَّ مَعَ کُلِّ سُبُوعٍ رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 15028","","","كتاب الحج"
"15029","(۱۵۰۲۹) حدَّثَنَا مَعْنٌ ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، قَالَ : رَأَیْتُ الْقَاسِمَ بْنَ مُحَمَّدٍ ، وَسَالِمًا ، وَعُبَیْدَ اللہِ بْنَ عَبْدِ اللہِ یُصَلُّونَ عِنْدَ کُلِّ سُبُوعٍ رَکْعَتَیْنِ ، وَلاَ یَقْرِنُونَ بَیْنَ السَّبُوعِ۔","","Musannaf Ibn Abi Shaybah 15029","","","كتاب الحج"
"15030","(۱۵۰۳۰) حدَّثَنَا مَعْنٌ ، عَنْ زَیْدِ بْنِ السَّائِبِ ، قَالَ : رَأَیْتُ خَارِجَۃَ بْنَ زَیْدٍ یُصَلِّی عِنْدَ کُلِّ سُبُوعٍ رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 15030","","","كتاب الحج"
