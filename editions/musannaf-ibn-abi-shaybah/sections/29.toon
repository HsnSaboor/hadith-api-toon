hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"28057","(۲۸۰۵۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : الْقِصَاصُ فِیْمَا بَیْنَ الرَّجُلِ وَالْمَرْأَۃِ فِی الْعَمْدِ ، فِیمَا بَیْنَہُ وَبَیْنَ النَّفْسِ۔","","Musannaf Ibn Abi Shaybah 28057","","","كتاب الديات"
"28058","(۲۸۰۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ (ح) وَعَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، قَالاَ : الْقِصَاصُ فِیمَا بَیْنَ الرَّجُلِ وَالْمَرْأَۃِ فِی الْعَمْدِ ، فِی کُلِّ شَیْئٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 28058","","","كتاب الديات"
"28059","(۲۸۰۵۹) حَدَّثَنَا حَفْصٌ، عَنِ الشَّیْبَانِیِّ، عَن حَمَّادٍ؛ أَنَّہُ کَانَ لاَ یَرَی بَیْنَ الرِّجَالِ وَالنِّسَائِ قِصَاصًا فِیمَا دُونَ النَّفْسِ۔n وَقَالَ الْحَکَمُ : مَا سَمِعْنَا فِیہِمَا بِشَیْئٍ ، وَإِنَّ الْقِصَاصَ بَیْنَہُمَا لَحَسَنٌ۔","","Musannaf Ibn Abi Shaybah 28059","","","كتاب الديات"
"28060","(۲۸۰۶۰) حَدَّثَنَا عِیسَی ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ ، قَالَ : مَضَتِ السُّنَّۃُ فِی الرَّجُلِ یَضْرِبُ امْرَأَتَہُ فَیَجْرَحُہَا أَنْ لاَ تَقْتَصَّ مِنْہُ ، وَیَعْقِلَ لَہَا۔","","Musannaf Ibn Abi Shaybah 28060","","","كتاب الديات"
"28061","(۲۸۰۶۱) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ إِسْمَاعِیلَ بْنِ أُمَیَّۃَ، عَنِ الزُّہْرِیِّ، قَالَ: لاَ یُقَصُّ لِلْمَرْأَۃِ مِنْ زَوْجِہَا۔","","Musannaf Ibn Abi Shaybah 28061","","","كتاب الديات"
"28062","(۲۸۰۶۲) حَدَّثَنَا وکیع ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَن عِیسَی بْنِ أَبِی عَزَّۃَ ، عَنِ الشَّعْبِیِّ ؛ فِی رَجُلٍ أَبْرَکَ امْرَأَتَہُ أَنْ یُجَامِعَہَا فَدَقَّ سِنَّہَا ، قَالَ : یَضْمَنُ۔","","Musannaf Ibn Abi Shaybah 28062","","","كتاب الديات"
"28063","(۲۸۰۶۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن حَمَّادٍ ، قَالَ : لَیْسَ بَیْنَ الرَّجُلِ وَالْمَرْأَۃِ قِصَاصٌ فِیمَا دُونَ النَّفْسِ فِی الْعَمْدِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28063","","","كتاب الديات"
"28064","(۲۸۰۶۴) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ، عَنِ الْحَسَنِ؛ فِی رَجُلٍ لَطَمَ امْرَأَتَہُ، فَأَتَتْ تَطْلُبُ الْقِصَاصَ، فَجَعَلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیْنَہُمَا الْقِصَاصَ ، فَأَنْزَلَ اللَّہُ تَعَالَی : {وَلاَ تَعْجَلْ بِالْقُرْآنِ مِنْ قَبْلِ أَنْ یُقْضَی إِلَیْک وَحْیُہُ} وَنَزَلَتْ : {الرِّجَالُ قَوَّامُونَ عَلَی النِّسَائِ بِمَا فَضَّلَ اللَّہُ بَعْضَہُمْ عَلَی بَعْضٍ}۔","Hasan","Musannaf Ibn Abi Shaybah 28064","","","كتاب الديات"
"28065","(۲۸۰۶۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْقَاسِمُ بْنُ الْفَضْلِ الْحُدَّانِیُّ ، عَنْ مُحَمَّدِ بْنِ زِیَادٍ ، قَالَ : کَانَتْ جَدَّتِی أُمَّ وَلَدٍ لِعُثْمَانَ بْنِ مَظْعُونٍ ، فَلَمَّا مَاتَ عُثْمَانُ جَرَحَہَا ابْنُ عُثْمَانَ جُرْحًا ، فَذَکَرَتْ ذَلِکَ لِعُمَرَ بْنِ الْخَطَّابِ ، فَقَالَ لَہُ عُمَر : أَعْطِہَا أَرْشًا مِمَّا صَنَعْتَ بِہَا۔","","Musannaf Ibn Abi Shaybah 28065","","","كتاب الديات"
"28066","(۲۸۰۶۶) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ، قَالَ : تَسْتَوِی جِرَاحَاتُ الرِّجَالِ وَالنِّسَائِ فِی السِّنِّ وَالْمُوضِحَۃِ۔","","Musannaf Ibn Abi Shaybah 28066","","","كتاب الديات"
"28067","(۲۸۰۶۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، عَنْ شُرَیْحٍ ، قَالَ : أَتَانِی عُرْوَۃُ الْبَارِقِیُّ مِنْ عِندِ عُمَرَ ؛ أَنَّ جِرَاحَاتِ الرِّجَالِ وَالنِّسَائِ تَسْتَوِی فِی السِّنِّ وَالْمُوضِحَۃِ ، وَمَا فَوْقَ ذَلِکَ فَدِیَۃُ الْمَرْأَۃِ عَلَی النِّصْفِ مِنْ دِیَۃِ الرَّجُلِ۔","Sahih","Musannaf Ibn Abi Shaybah 28067","","","كتاب الديات"
"28068","(۲۸۰۶۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ؛ أَنَّ ہِشَامَ بْنَ ہُبَیْرَۃَ کَتَبَ إِلَیْہِ یَسْأَلُہُ، فَکَتَبَ إِلَیْہِ : إِنَّ دِیَۃَ الْمَرْأَۃِ عَلَی النِّصْفِ مِنْ دِیَۃِ الرَّجُلِ ، إِلا فِی السِّنِّ وَالْمُوضِحَۃِ۔","","Musannaf Ibn Abi Shaybah 28068","","","كتاب الديات"
"28069","(۲۸۰۶۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَا ، وَابْنُ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ عَلِیٌّ یَقُولُ : دِیَۃُ الْمَرْأَۃِ فِی الْخَطَأِ عَلَی النِّصْفِ مِنْ دِیَۃِ الرَّجُلِ ، فِیمَا دَقَّ وَجَلَّ۔n وَکَانَ ابْنُ مَسْعُودٍ یَقُولُ : دِیَۃُ الْمَرْأَۃِ فِی الْخَطَأِ عَلَی النِّصْفِ مِنْ دِیَۃِ الرَّجُلِ ، إِلاَّ السِّنَّ وَالْمُوضِحَۃَ فَہُمَا فِیہِ سَوَائٌ۔n وَکَانَ زَیْدُ بْنُ ثَابِتٍ یَقُولُ : دِیَۃُ الْمَرْأَۃِ فِی الْخَطَأِ مِثْلُ دِیَۃِ الرَّجُلِ ، حَتَّی تَبْلُغَ ثُلُثَ الدِّیَۃِ ، فَمَا زَادَ فَہِیَ عَلَی النِّصْفِ۔","Sahih","Musannaf Ibn Abi Shaybah 28069","","","كتاب الديات"
"28070","(۲۸۰۷۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَن خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَن زَیْدِ بْنِ ثَابِتٍ ، أَنَّہُ قَالَ : یَسْتَوُونَ إِلَی الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 28070","","","كتاب الديات"
"28071","(۲۸۰۷۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الْحَسَنِ ، قَالَ : تَسْتَوِی جِرَاحَاتُ الرِّجَالِ وَالنِّسَائِ عَلَی النِّصْفِ ، فَإِذَا بَلَغَتِ النِّصْفَ فَہِیَ عَلَی النِّصْفِ۔","","Musannaf Ibn Abi Shaybah 28071","","","كتاب الديات"
"28072","(۲۸۰۷۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : تُعَاقِلُ الْمَرْأَۃُ الرَّجُلَ إِلَی الثُّلُثِ ، إِصْبَعُہَا کَإِصْبَعِہِ ، وَسِنُّہَا کَسِنِّہِ ، وَمُوضِحَتُہَا کَمُوضِحَتِہِ ، وَمُنَقِّلَتُہَا کَمُنَقِّلَتِہِ۔","","Musannaf Ibn Abi Shaybah 28072","","","كتاب الديات"
"28073","(۲۸۰۷۳) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، وَإِسْمَاعِیلُ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ ، قَالَ : تَسْتَوِی جِرَاحَاتُ النِّسَائِ وَالرِّجَالِ فِی کُلِّ شَیْئٍ۔","Sahih","Musannaf Ibn Abi Shaybah 28073","","","كتاب الديات"
"28074","(۲۸۰۷۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ بْنِ ذَکْوَانَ أَبِی الزِّنَادِ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : فِی مُوضِحَۃِ الْمَرْأَۃِ ، وَمُنَقِّلَتِہَا ، وَسِنِّہَا مِثْلُ الرَّجُلِ فِی الدِّیَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28074","","","كتاب الديات"
"28075","(۲۸۰۷۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ رَجُلٍ ، عَنْ عُرْوَۃَ بْنِ الزُّبَیْرِ ، قَالَ : مُنَقِّلَتُہَا ، وَمُوَضِحَتُہَا ، وَسِنُّہَا مِثْلُ الرَّجُلِ فِی الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 28075","","","كتاب الديات"
"28076","(۲۸۰۷۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن رَبِیعَۃَ بْنِ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : قُلْتُ لِسَعِیدِ بْنِ الْمُسَیَّبِ: کَمْ فِی ہَذِہِ مِنَ الْمَرْأَۃِ ؟ یَعْنِی الْخِنْصَرِ ، فَقَالَ : عَشْرٌ مِنَ الإِبِلِ ، قَالَ : قُلْتُ : فِی ہَذَیْنِ ؟ یَعْنِی الْخِنْصَرَ وَالَّتِی تَلِیہَا ، قَالَ : عِشْرُونَ ، قَالَ : قُلْتُ : فَہَؤُلاَئِ ؟ یَعْنِی الثَّلاَثَۃَ ، قَالَ : ثَلاَثُونَ ، قَالَ : قُلْتُ : فَفِی ہَؤُلاَئِ ؟ وَأَوْمَأَ إِلَی الأَرْبَعِ ، قَالَ : عِشْرُونَ ، قَالَ : قُلْتُ : حِینَ آلَمَتْ جِرَاحُہَا وَعَظُمَتْ مُصِیبَتُہَا کَانَ الأَقَلَّ لأَِرْشِہَا ؟ قَالَ : أَعِرَاقِیٌّ أَنْتَ ؟ قَالَ : قُلْتُ : عَالِمٌ مُتَثَبِّتٌ ، أَوْ جَاہِلٌ مُتَعَلِّمٌ ، قَالَ : یَا ابْنَ أَخِی ، السُّنَّۃُ۔n(مالک۸۶۰۔ عبدالرزاق ۱۷۷۴۹)","","Musannaf Ibn Abi Shaybah 28076","","","كتاب الديات"
"28077","(۲۸۰۷۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنِ الْحَکَمِ بْنِ عُتَیْبَۃَ ، قَالَ : کَتَبَ شُرَیْحٌ إِلَی ہِشَامِ بْنِ ہُبَیْرَۃَ: أَنَّ دِیَۃَ الْمَرْأَۃِ عَلَی النِّصْفِ مِنْ دِیَۃِ الرَّجُلِ ، إِلاَّ السِّنَّ وَالْمُوضِحَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 28077","","","كتاب الديات"
"28078","(۲۸۰۷۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ (ح) وَعَنْ مَکْحُولٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ؛ أَنَّہُمَا قَالاَ : یُعَاقِلُ الرَّجُلُ الْمَرْأَۃَ فِی ثُلُثِ دِیَتِہَا ، ثُمَّ یَخْتَلِفَانِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28078","","","كتاب الديات"
"28079","(۲۸۰۷۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، حَدَّثَنَا ابن أَبِی عَرُوبَۃ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَن سَمُرَۃَ بْنِ جُنْدُبٍ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ قَتَلَ عَبْدَہُ قَتَلْنَاہُ ، وَمَنْ جَدَعَ عَبْدَہُ جَدَعْناہُ۔n(ابوداؤد ۴۵۰۴۔ ترمذی ۱۴۱۴)","Hasan","Musannaf Ibn Abi Shaybah 28079","","","كتاب الديات"
"28080","(۲۸۰۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إِذَا قَتَلَ عَبْدَہُ عَمْدًا قُتِلَ بِہِ۔","","Musannaf Ibn Abi Shaybah 28080","","","كتاب الديات"
"28081","(۲۸۰۸۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یُقْتَلُ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28081","","","كتاب الديات"
"28082","(۲۸۰۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ عَنِ الرَّجُلِ یَقْتُلُ عَبْدَہُ عَمْدًا ؟ قَالَ : أَرَاہُ یُقْتَلُ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28082","","","كتاب الديات"
"28083","(۲۸۰۸۳) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ إِسْحَاقَ بْنِ أَبِی فَرْوَۃَ ، عَنْ إِبْرَاہِیمَ بْنِ عَبْدِ اللہِ بْنِ حُنَیْنٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، قَالَ : أُتِیَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِرَجُلٍ قَتَلَ عَبْدَہُ مُتَعَمِّدًا ،فَجَلَدَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِئَۃَ جَلْدَۃٍ ، وَنَفَاہُ سَنَۃً ، وَمَحَا سَہْمَہُ مِنَ الْمُسْلِمِینَ ، وَلَمْ یُقِدْہ مِنْہُ۔n(ابن ماجہ ۲۶۶۴۔ دارقطنی ۱۴۳)","Da'if","Musannaf Ibn Abi Shaybah 28083","","","كتاب الديات"
"28084","(۲۸۰۸۴) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ إِسْحَاقَ بْنِ أَبِی فَرْوَۃَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ مِثْلَہُ۔ (بیہقی ۳۷)","Da'if","Musannaf Ibn Abi Shaybah 28084","","","كتاب الديات"
"28085","(۲۸۰۸۵) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا شُعْبَۃُ ، عَنْ مُغِیرَۃَ ، عَنْ عَامِرٍ ، قَالَ : إِذَا قَتَلَ الرَّجُلُ عَبْدَہُ عَمْدًا لَمْ یُقْتَلْ بِہِ۔","","Musannaf Ibn Abi Shaybah 28085","","","كتاب الديات"
"28086","(۲۸۰۸۶) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنِ ابْنِ لَہِیعَۃَ ، عَن خَالِدِ بْنِ أَبِی عِمْرَانَ ، قَالَ : سَأَلْتُ سَالِمًا ، وَالْقَاسِمَ عَنْ رَجُلٍ قَتَلَ عَبْدَہُ ؟ قَالاَ : عُقُوبَتُہُ أَنْ یُقْتَلَ ، وَلَکِنْ لاَ یُقْتَلُ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28086","","","كتاب الديات"
"28087","(۲۸۰۸۷) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ؛ أَنَّ أَبَا بَکْرٍ ، وَعُمَرَ کَانَا یَقُولاَنِ : لاَ یُقْتَلُ الْمَوْلَی بِعَبْدِہِ ، وَلَکِنْ یُضْرَبُ ، وَیُطَالُ حَبْسُہُ ، وَیُحْرَمُ سَہْمُہُ۔","","Musannaf Ibn Abi Shaybah 28087","","","كتاب الديات"
"28088","(۲۸۰۸۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ؛ أَنَّ أَبَا بَکْرٍ ، وَعُمَرَ کَانَا لاَ یَقْتُلاَنِ الْحُرَّ بِقَتلِ الْعَبْد۔","","Musannaf Ibn Abi Shaybah 28088","","","كتاب الديات"
"28089","(۲۸۰۸۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ، وَعَبْدِ اللہِ ، أَنَّہُمَا قَالاَ : إِذَا قَتَلَ الْحُرُّ الْعَبْدَ ، فَہُوَ بِہِ قَود۔","Da'if","Musannaf Ibn Abi Shaybah 28089","","","كتاب الديات"
"28090","(۲۸۰۹۰) حَدَّثَنَا ہُشَیمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یُقْتَلُ الْعَبْدُ بِالْحُرِّ ، وَالْحُرُّ بِالْعَبْدِ۔","","Musannaf Ibn Abi Shaybah 28090","","","كتاب الديات"
"28091","(۲۸۰۹۱) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَن سُہَیْلِ بْنِ أَبِی صَالِحٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : سَأَلْتُہُ عَنْ رَجُلٍ حُرٍّ قَتَلَ مَمْلُوکًا ؟ قَالَ : یُقْتَلُ بِہِ ، ثُمَّ رَجَعْتُ إِلَیْہِ ، فَقَالَ : یُقْتَلُ بِہِ ، ثُمَّ قَالَ : وَاللَّہِ لَوِ اجْتَمَعَ عَلَیْہِ أَہْلُ الْیَمَنِ لَقَتَلْتہمْ بِہِ۔","","Musannaf Ibn Abi Shaybah 28091","","","كتاب الديات"
"28092","(۲۸۰۹۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن سُہَیْلِ بْنِ أَبِی صَالِحٍ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ عَنِ الْحُرِّ یَقْتُلُ الْعَبْدَ عَمْدًا ؟ قَالَ : اقْتُلْہُ ، وَلَوِ اجْتَمَعَ عَلَیْہِ أَہْلُ الْیَمَنِ۔","","Musannaf Ibn Abi Shaybah 28092","","","كتاب الديات"
"28093","(۲۸۰۹۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَلِیُّ بْنُ صَالِحٍ ، عَنْ أَبِی الْوَضِینِ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ عَنِ الْحُرِّ یَقْتُلُ الْعَبْدَ عَمْدًا ؟ قَالَ : اقْتُلْہُ بِہِ صَاغِرًا لَئِیمًا۔","No Data Available","Musannaf Ibn Abi Shaybah 28093","","","كتاب الديات"
"28094","(۲۸۰۹۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : لاَ یُقَادُ الْحُرُّ مِنَ الْعَبْدِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28094","","","كتاب الديات"
"28095","(۲۸۰۹۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَمِعْتُ سُفْیَانَ ، یَقُولُ : یُقْتَلُ الرَّجُلُ بِعَبْدِ غَیْرِہِ ، وَلاَ یُقْتَلُ بِعَبْدِہِ ، کَمَا لَوْ قَتَلَ ابْنَہُ لَمْ یُقْتَلْ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28095","","","كتاب الديات"
"28096","(۲۸۰۹۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : وَسَمِعْت سُفْیَانَ ، یَقُولُ : لاَ یُقْتَلُ الرَّجُلُ بِعَبْدِہِ ، وَیُعَزَّرُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28096","","","كتاب الديات"
"28097","(۲۸۰۹۷) حَدَّثَنَا عَبَّادٌ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَنْ زَیْدٍ ؛ فِی السِّقْطِ یَقَعُ فَیَتَحَرَّکُ ، قَالَ : کَمُلَتْ دِیَتُہُ ؛ اسْتَہَلَّ ، أَوْ لَمْ یَسْتَہِلَّ۔","","Musannaf Ibn Abi Shaybah 28097","","","كتاب الديات"
"28098","(۲۸۰۹۸) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : فِی الْجَنِینِ إِذَا سَقَطَ حَیًّا فَفِیہِ الدِّیَۃُ ، وَإِنْ سَقَطَ مَیِّتًا فَفِیہِ غُرَّۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 28098","","","كتاب الديات"
"28099","(۲۸۰۹۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا ضَرَبَ الرَّجُلُ بَطْنَ الْحَامِلِ فَأَسْقَطَتْ مَیِّتًا فَفِیہِ غُرَّۃُ عَبْدٍ ، أَوْ أَمَۃٍ فِی مَالِہِ ، وَإِنْ کَانَ حَیًّا فَالدِّیَۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28099","","","كتاب الديات"
"28100","(۲۸۱۰۰) حَدَّثَنَا مَعْنُ بْنُ عِیسَی، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ: إِذَا اسْتَہَلَّ الْجَنِینُ ، ثُمَّ مَاتَ فَفِیہِ الدِّیَۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28100","","","كتاب الديات"
"28101","(۲۸۱۰۱) حَدَّثَنَا جَرِیرٌ، عَن مَنْصُورٍ، عَنْ إِبْرَاہِیمَ، قَالَ: وَلَدَتِ امْرَأَۃٌ وَلَدًا، فَشَہِدَ نِسْوَۃٌ أَنَّہُ اخْتَلَجَ وَوُلِدَ حَیًّا، وَلَمْ یَشْہَدْنَ عَلَی الاِسْتِہْلاَلِ، قَالَ شُرَیْحٌ: الْحَیُّ یَرِثُ الْمَیِّتَ ، ثُمَّ أَبْطَلَ مِیرَاثَہُ لأَنَّہُ لَمْ یَشْہَدْنَ عَلَی اسْتِہْلاَلِہِ۔","","Musannaf Ibn Abi Shaybah 28101","","","كتاب الديات"
"28102","(۲۸۱۰۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ حَجَّاجٍ ، عَن جُنْدُبٍ الْقَاص ، عَنْ أَسْلَمَ مَوْلَی عُمَرَ ، عَنْ عُمَرَ ؛ أَنَّہُ قَضَی فِی سِنِّ الصَّبِیِّ إِذَا سَقَطَتْ قَبْلَ أَنْ یُثْغِرَ بَعِیرًا۔","","Musannaf Ibn Abi Shaybah 28102","","","كتاب الديات"
"28103","(۲۸۱۰۳) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لَیْسَ فِی سِنِّ الصَّبِیِّ إِذَا لَمْ یُثْغِرْ إِلاَّ الأَلَمُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28103","","","كتاب الديات"
"28104","(۲۸۱۰۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا أَصَابَ سِنَّہُ وَلَمْ یُثْغِرْ فَفِیہِ حُکْمٌ۔","","Musannaf Ibn Abi Shaybah 28104","","","كتاب الديات"
"28105","(۲۸۱۰۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ ابْنُ شِہَابٍ فِی غُلاَمٍ صَغِیرٍ لَمْ یُثْغِرْ کَسَرَ سِنَّ غُلاَمٍ آخَرَ ، قَالَ : عَلَیْہِ الْغُرْمُ بِقَدْرِ مَا یَرَی الْحَکَمُ۔","","Musannaf Ibn Abi Shaybah 28105","","","كتاب الديات"
"28106","(۲۸۱۰۶) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : فِی سِنِّ الصَّبِیِّ إِذَا لَمْ یُثْغِرْ ، قَالَ : یَنْظُرُ فِیہِ ذَوَا عَدْلٍ ، فَإِنْ نَبَتَتْ جُعِلَ لَہُ شَیْئٌ ، وَإِنْ لَمْ تَنْبُتْ کَانَ کَسِنِّ الرَّجُلِ۔","","Musannaf Ibn Abi Shaybah 28106","","","كتاب الديات"
"28107","(۲۸۱۰۷) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : مَا أَصَابَ الْمَجْنُونُ فِی حَالِ جُنُونِہِ فَعَلَی عَاقِلَتِہِ ، وَمَا أَصَابَ فِی حَالِ إِفَاقَتِہِ أُقِیدَ مِنْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28107","","","كتاب الديات"
"28108","(۲۸۱۰۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ قَالَ فِی الْمَجْنُونِ وَالْمَغْلُوبِ عَلَی عَقْلِہِ ، وَالْمَعْتُوہِ ، وَالَّذِی یُصِیبُہُ فِی الشَّہْرِ الْمَرَّۃَ وَالْمَرَّتَیْنِ ، قَالَ : إِذَا ذَہَبَ عَنْہُ ذَاکَ ، فَصَامَ وَصَلَّی وَعَقَلَ وَأَصَابَ شَیْئًا ، فَہُوَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 28108","","","كتاب الديات"
"28109","(۲۸۱۰۹) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ؛ أَنَّہُ جَعَلَ جِنَایَۃَ الْمَجْنُونِ عَلَی الْعَاقِلَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28109","","","كتاب الديات"
"28110","(۲۸۱۱۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا صَخْرُ بْنُ جُوَیْرِیَۃَ ، عَن نَافِعٍ ؛ أَنَّ رَجُلاً مَجْنُونًا فِی عَہْدِ ابْنِ الزُّبَیْرِ کَانَ یُفِیقُ أَحْیَانًا ، فَلاَ یُرَی بِہِ بَأْسًا ، وَیَعُودُ بِہِ وَجَعُہُ ، فَبَیْنَمَا ہُوَ نَائِمٌ مَعَ ابْنِ عَمِّہِ إِذْ دَخَلَ الْبَیْتَ بِخْنْجَرٍ فَطَعَنَ ابْنَ عَمِّہِ فَقَتَلَہُ ، فَقَضَی عَبْدُ اللہِ بْنُ الزُّبَیْرِ أَنْ یُخْلَعَ مِنْ مَالِہِ ، وَیُدْفَعَ إِلَی أَہْلِ الْمَقْتُولِ۔","Sahih","Musannaf Ibn Abi Shaybah 28110","","","كتاب الديات"
"28111","(۲۸۱۱۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا قَتَلَ الْمُسْلِمُ الذِّمِّیَّ فَلَیْسَ عَلَیْہِ کَفَّارَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 28111","","","كتاب الديات"
"28112","(۲۸۱۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانُ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنِ الشَّعْبِیِّ ؛ فِی الْمُسْلِمِ یَقْتُلُ الذِّمِّیَّ خَطَأً ، قَالَ : کَفَّارَتُہُمَا سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 28112","","","كتاب الديات"
"28113","(۲۸۱۱۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَفَّارَتُہُمَا سَوَائٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 28113","","","كتاب الديات"
"28114","(۲۸۱۱۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ یَزِیدَ الْجُعفی ، عَنِ الشَّعْبِیِّ ؛ فِی الرَّجُلِ یقْتُلُ فَتَعْفُو الْمَرْأَۃُ ، قَالَ : یُؤَدِّی الْقَاتِلُ سَبْعَۃَ أَثْمَانِ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 28114","","","كتاب الديات"
"28115","(۲۸۱۱۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ؛ أَنَّ امْرَأَۃً عَفَتْ عَن دَمِ زَوْجِہَا ، قَالَ : صَارَتْ دِیَۃً ، وَیُرْفَعُ عَنْہُ الثُّمُنَ۔","No Data Available","Musannaf Ibn Abi Shaybah 28115","","","كتاب الديات"
"28116","(۲۸۱۱۶) حَدَّثَنَا وَکِیعٌ ، عَنِ ابن صَالِحٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ؛ فِی امْرَأَۃٍ قُتِلَ زَوْجُہَا فَعَفَتْ ، قَالَ : عَفْوُہَا جَائِزٌ ، وَیُرْفَعُ نَصِیبُہَا مِنَ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 28116","","","كتاب الديات"
"28117","(۲۸۱۱۷) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لِکُلِّ ذِی سَہْمٍ عَفْوٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 28117","","","كتاب الديات"
"28118","(۲۸۱۱۸) حَدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ؛ أَنَّہُمَا قَالاَ فِی الرَّجُلِ یَقْتُلُ الرَّجُلَ فَتَعْفُو الْمَرْأَۃُ ، قَالاَ: مَنْ عَفَا مِنْ رَجُلٍ ، أَوِ امْرَأَۃٍ فَإِنَّہُ یَدْرَأَ عَنْہُ الْقَتْل۔","","Musannaf Ibn Abi Shaybah 28118","","","كتاب الديات"
"28119","(۲۸۱۱۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عُمَرَ ، قَالَ : الزَّوْجُ وَالْمَرْأَۃُ لاَ عَفْوَ لَہُمَا۔","Da'if","Musannaf Ibn Abi Shaybah 28119","","","كتاب الديات"
"28120","(۲۸۱۲۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ إِسْمَاعِیلَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لَیْسَ لِلزَّوْجِ ، وَلاَ لِلْمَرْأَۃِ عَفْوٌ فِی الدَّمِ ، إِنَّمَا الْعَفْوُ إِلَی أَوْلِیَائِ الْمَقْتُولِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28120","","","كتاب الديات"
"28121","(۲۸۱۲۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ إِسْمَاعِیلَ ، عَنِ الْحَسَنِ ، قَالَ : لَیْسَ لِلزَّوْجِ ، وَلاَ لِلْمَرْأَۃِ عَفْوٌ فِی الدَّمِ ، وَإِنْ عَفَا أَحَدٌ مِنَ الْوَرَثَۃِ جَازَ عَفْوُہُ وَصَارَتِ الدِّیَۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28121","","","كتاب الديات"
"28122","(۲۸۱۲۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ، عَن صَاعِدِ بْنِ مُسْلِمٍ، عَنِ الشَّعْبِیِّ؛ فِی رَجُلٍ قُتِلَ وَتَرَکَ ابْنَتَہُ وَأُخْتَہُ وَامْرَأَتَیْہِ، فَعَفَتْ إِحْدَی الْمَرْأَتَیْنِ ، قَالَ الشَّعْبِیُّ : لَیْسَ لِلْمَرْأَۃِ عَفْوٌ ، إِلاَّ امْرَأَۃٌ لَہَا رَحِمٌ مَاسَّۃٌ ، وَسَہْمٌ فِی الْمِیرَاثِ۔","","Musannaf Ibn Abi Shaybah 28122","","","كتاب الديات"
"28123","(۲۸۱۲۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ ؛ أَنَّ عُمَرَ کَانَ یَقُولُ : الدِّیَۃُ لِلْعَاقِلَۃِ ، وَلاَ تَرِثُ الْمَرْأَۃُ مِنْ دِیَۃِ زَوْجِہَا شَیْئًا ، حَتَّی کَتَبَ إِلَیْہِ الضَّحَّاکُ بْنُ سُفْیَانَ الْکِلاَبِیُّ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَرَّثَ امْرَأَۃَ أَشْیَمَ الضَّبَابِیِّ مِنْ دِیَۃِ زَوْجِہَا۔ (ابوداؤد ۲۹۱۹۔ ترمذی ۱۴۱۵)","Sahih","Musannaf Ibn Abi Shaybah 28123","","","كتاب الديات"
"28124","(۲۸۱۲۴) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قامَ عُمَرُ بِمِنًی ، فَسَأَلَ النَّاسَ ، فَقَالَ : مَنْ عِندَہُ عِلْمٌ مِنْ مِیرَاثِ الْمَرْأَۃِ مِنْ عَقْلِ زَوْجِہَا ؟ فَقَامَ الضَّحَّاکُ بْنُ سُفْیَانَ الْکِلاَبِیُّ ، فَقَالَ : ادْخُلْ قُبَّتَکَ حَتَّی أُخْبِرَک ، فدخل فَأَتَاہُ ، فَقَالَ : کَتَبَ إِلَیَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ أُوَرِّثَ امْرَأَۃَ أَشْیَمَ الضَّبَابِیِّ مِنْ عَقْلِ زَوْجِہَا۔ (نسائی ۶۳۶۵)","Sahih","Musannaf Ibn Abi Shaybah 28124","","","كتاب الديات"
"28125","(۲۸۱۲۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ فِی الرَّجُلِ یقْتُلُ عَمْدًا فَیَعْفُو بَعْضُ الْوَرَثَۃِ ، قَالَ : لامْرَأَتِہِ مِیرَاثُہَا مِنَ الدِّیَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28125","","","كتاب الديات"
"28126","(۲۸۱۲۶) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : تَرِثُ الْمَرْأَۃُ مِنْ دَمِ زَوْجِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 28126","","","كتاب الديات"
"28127","(۲۸۱۲۷) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إِذَا قَبِلَ الْعَقْلَ فِی الْعَمْدِ ، کَانَ مِیرَاثًا تَرِثُہُ الزَّوْجَۃُ وَغَیْرُہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 28127","","","كتاب الديات"
"28128","(۲۸۱۲۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عُمَرَ ؛ أَنَّہُ قَالَ : یَرِثُ مِنَ الدِّیَۃِ کُلُّ وَارِثٍ ، وَالزَّوْجُ وَالْمَرْأَۃُ فِی الْخَطَأِ وَالْعَمْدِ۔","Da'if","Musannaf Ibn Abi Shaybah 28128","","","كتاب الديات"
"28129","(۲۸۱۲۹) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ أَبِی عَمْرٍو الْعَبْدِیِّ ، عَنْ عَلِیٍّ ، قَالَ : تُقْسَمُ الدِّیَۃُ لِمَنْ أَحْرَزَ الْمِیرَاثَ۔","Da'if","Musannaf Ibn Abi Shaybah 28129","","","كتاب الديات"
"28130","(۲۸۱۳۰) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الدِّیَۃُ لِلْمِیرَاثِ ، وَالْعَقْلُ عَلَی الْعَصَبَۃِ۔ (عبدالرزاق ۱۷۷۶۸)","","Musannaf Ibn Abi Shaybah 28130","","","كتاب الديات"
"28131","(۲۸۱۳۱) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ؛ أَنَّہُ کَانَ یَتَحَدَّثُ : أَنَّ الدِّیَۃَ سَبِیلُہَا سَبِیلُ الْمِیرَاثِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28131","","","كتاب الديات"
"28132","(۲۸۱۳۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ (ح) وَجَہْم ، عَنْ إِبْرَاہِیمَ ، قَالاَ : الدِّیَۃُ لِلْمِیرَاثِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28132","","","كتاب الديات"
"28133","(۲۸۱۳۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : عَلَی کِتَابِ اللہِ کَسَائِرِ مَالِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28133","","","كتاب الديات"
"28134","(۲۸۱۳۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوسٍ ؛ أَنَّ أَبَاہُ کَانَ یَقُولُ وَیَقْضِی : بِأَنَّ الْوُرَّاثَ أَجْمَعِینَ یَرِثُونَ مِنَ الْعَقْلِ مِثْلَ الْمِیرَاثِ۔","","Musannaf Ibn Abi Shaybah 28134","","","كتاب الديات"
"28135","(۲۸۱۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : الْعَقْلُ کَہَیْئَۃِ الْمِیرَاثِ ؟ قَالَ : نَعَمْ ، قُلْتُ : وَیَرِثُ الإِخْوَۃُ مِنَ الأُمِّ فِیْہِ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 28135","","","كتاب الديات"
"28136","(۲۸۱۳۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَلِیٍّ ، قَالَ : قَالَ عَلِیٌّ : قَدْ ظَلَمَ مَنْ لَمْ یُوَرِّثِ الإِخْوَۃَ مِنَ الأُمِّ مِنَ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 28136","","","كتاب الديات"
"28137","(۲۸۱۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عُمَرَ ؛ أَنَّہُ کَانَ یُوَرِّثُ الإِخْوَۃَ مِنَ الأُمِّ مِنَ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 28137","","","كتاب الديات"
"28138","(۲۸۱۳۸) حَدَّثَنَا ابْنُ إِدْرِیسَ ، وَابْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : الإِخْوَۃُ مِنَ الأُمِّ یَرِثُونَ مِنَ الدِّیَۃِ، وَکُلُّ وَارِثٍ۔","","Musannaf Ibn Abi Shaybah 28138","","","كتاب الديات"
"28139","(۲۸۱۳۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَن حُمَیْدٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : کَتَبَ فِی الإِخْوَۃِ مِنَ الأُمِّ : یَرِثُونَ مِنَ الدِّیَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28139","","","كتاب الديات"
"28140","(۲۸۱۴۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : یَرِثُ الإِخْوَۃُ مِنَ الأُمِّ ؟ یَعْنِی مِنَ الْعَقْلِ ، قَالَ : نَعَمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 28140","","","كتاب الديات"
"28141","(۲۸۱۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ : أَیَرِثُ الإِخْوَۃُ مِنَ الأُمِّ مِنَ الدِّیَۃِ ؟ قَالَ: نَعَمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 28141","","","كتاب الديات"
"28142","(۲۸۱۴۲) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَن ہَمَّامٍ ، عَنْ عَاصِمٍ الأَحْوَلِ ، قَالَ : سَأَلْتُ الْحَسَنَ ؟ فَقَالَ : لَہُمْ کِتَابُ اللہِ۔","","Musannaf Ibn Abi Shaybah 28142","","","كتاب الديات"
"28143","(۲۸۱۴۳) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ مُحَمَّدِ بْنِ عَلِیٍّ ، قَالَ : لَقَدْ ظَلَمَ مَنْ لَمْ یُوَرِّثِ الإِخْوَۃَ مِنَ الأُمِّ مِنَ الدِّیَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28143","","","كتاب الديات"
"28144","(۲۸۱۴۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَن زَیْدِ بْنِ وَہْبٍ ، قَالَ : رَأَی رَجُلٌ مَعَ امْرَأَتِہِ رَجُلاً فَقَتَلَہَا ، فَرُفِعَ إِلَی عُمَرَ فَوَہَبَ بَعْضُ إِخْوَتِہَا نَصِیبَہُ لَہُ ، فَأَمَرَ عُمَرُ سَائِرَہُمْ أَنْ یَأْخُذُوا الدِّیَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 28144","","","كتاب الديات"
"28145","(۲۸۱۴۵) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی رَجُلٍ قَتَلَ رَجُلاً مُتَعَمِّدًا ، فَعَفَا بَعْضُ الأَوْلِیَائِ ، فَرُفِعَ ذَلِکَ إِلَی عُمَرَ ، فَقَالَ لِعَبْدِ اللہِ : قُلْ فِیہَا ، فَقَالَ : أَنْتَ أَحَقُّ أَنْ تَقُولَ یَا أَمِیرَ الْمُؤْمِنِینَ ، فَقَالَ عَبْدُ اللہِ : إِذَا عَفَا بَعْضُ الأَوْلِیَائِ فَلاَ قَوَدَ ، یُحَطُّ عَنْہُ حِصَّۃِ الَّذِی عَفَا ، وَلَہُمْ بَقِیَّۃُ الدِّیَۃِ ، فَقَالَ عُمَرُ : ذَاکَ الرَّأْیُ ، وَوَافَقْتَ مَا فِی نَفْسِی۔","","Musannaf Ibn Abi Shaybah 28145","","","كتاب الديات"
"28146","(۲۸۱۴۶) حَدَّثَنَا وَکِیعٌ ، عَن عِیسَی ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا عَفَا بَعْضُ الْوَرَثَۃِ یُتْبَعُ الْعَفْوُ مِنْ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 28146","","","كتاب الديات"
"28147","(۲۸۱۴۷) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ؛ أَنَّہُ قَالَ : مَنْ عَفَا فَلاَ نَصِیبَ لَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28147","","","كتاب الديات"
"28148","(۲۸۱۴۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَن زَمْعَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ : إِذَا عَفَا بَعْضُ أَوْلِیَائِ الدَّمِ فَہِیَ الدِّیَۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28148","","","كتاب الديات"
"28149","(۲۸۱۴۹) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنِ الزُّہْرِیِّ ، قَالَ : صَاحِبُ الْعَفْوِ أَوْلَی بِالدَّمِ۔","","Musannaf Ibn Abi Shaybah 28149","","","كتاب الديات"
"28150","(۲۸۱۵۰) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَن مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَتَبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کِتَابًا بَیْنَ الْمُہَاجِرِینَ وَالأَنْصَارِ : أَنْ یَعْقِلُوا مَعَاقِلَہُمْ ، وَأَنْ یَفْدُوا عَانِیہمْ بِالْمَعْرُوفِ ، وَالإِصْلاَحِ بَیْنَ الْمُسْلِمِینَ۔ (احمد ۲۷۱۔ ابویعلی ۲۴۷۹)","","Musannaf Ibn Abi Shaybah 28150","","","كتاب الديات"
"28151","(۲۸۱۵۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، قَالَ : جَعَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَقْلَ قُرَیْشٍ عَلَی قُرَیْشٍ ، وَعَقْلَ الأَنْصَارِ عَلَی الأَنْصَارِ۔ (ابن حزم ۲۱۴۰)","Da'if","Musannaf Ibn Abi Shaybah 28151","","","كتاب الديات"
"28152","(۲۸۱۵۲) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَعَلَ الْعَقْلَ عَلَی الْعَصَبَۃِ۔","","Musannaf Ibn Abi Shaybah 28152","","","كتاب الديات"
"28153","(۲۸۱۵۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : اخْتَصَمَ عَلِیٌّ ، وَالزُّبَیْرُ فِی وَلاَئِ مَوَالِی صَفِیَّۃَ إِلَی عُمَرَ ، فَقَضَی عُمَرُ بِالْمِیرَاثِ لِلزُّبَیْرِ ، وَبِالْعَقْلِ عَلَی عَلِیٍّ۔","","Musannaf Ibn Abi Shaybah 28153","","","كتاب الديات"
"28154","(۲۸۱۵۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ، قَالَ: حدَّثَنَی عَبْدُ الْعَزِیزِ بْنُ عُمَرَ، قَالَ: کُتِبَ إِلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ فِی رَجُلٍ قَالَ مَوَالِیہِ : لاَ نَعْقِلُ عَنْہُ ، فَکَتَبَ إِلَی الْقَاضِی: أَنْ أَلْزِمْہُمُ الْعَقْلَ ، فَمَا أَشُکُّ أَنَّہُمْ کَانُوا آخذی مِیرَاثِہِ۔","","Musannaf Ibn Abi Shaybah 28154","","","كتاب الديات"
"28155","(۲۸۱۵۵) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ : لَوْ لَمْ یَدَعْ قَرَابَۃً إِلاَّ مَوَالِیہِ ، کَانُوا أَحَقَّ النَّاسِ بِمِیرَاثِہِ ، فَاحْمِلْ عَلَیْہِمْ عَقْلَہُ کَمَا یَرِثُونَہُ۔","","Musannaf Ibn Abi Shaybah 28155","","","كتاب الديات"
"28156","(۲۸۱۵۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : الْمِیرَاثُ لِلرَّحِمِ ، وَالْجَرَائِرُ عَلَی مَنْ أَعْتَقَ۔","No Data Available","Musannaf Ibn Abi Shaybah 28156","","","كتاب الديات"
"28157","(۲۸۱۵۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ فِی رَجُلٍ أَعْتَقَہُ قَوْمٌ ، وَأَعْتَقَ أبَاہُ آخَرُونَ ، قَالَ : یَتَوَارَثَانِ بِالأَرْحَامِ ، وَجِنَایَتُہُمَا عَلَی عَاقِلَۃِ مَوَالِیہِمَا۔","","Musannaf Ibn Abi Shaybah 28157","","","كتاب الديات"
"28158","(۲۸۱۵۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَن حَمَّادٍ ، قَالَ : جِنَایَۃُ الْمَوْلَی عَلَی عَاقِلَۃِ مَوَالِیہِ۔","","Musannaf Ibn Abi Shaybah 28158","","","كتاب الديات"
"28159","(۲۸۱۵۹) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَن خُصَیْفٍ ، عَن مُجَاہِدٍ ؛ أَنَّ رَجُلاً أَتَی عُمَرَ ، فَقَالَ : إِنَّ رَجُلاً أَسْلَمَ عَلَی یَدَیَّ ، فَمَاتَ وَتَرَکَ أَلْفَ دِرْہَمٍ ، فَتَحَرَّجْتُ مِنْہَا وَرَفَعْتہَا إِلَیْک ، فَقَالَ : أَرَأَیْتَ لَوْ جَنَی جِنَایَۃً ، عَلَی مَنْ کَانَتْ تَکُونُ ؟ قَالَ : عَلَیَّ ، قَالَ : فَمِیرَاثُہُ لَکَ۔","Da'if","Musannaf Ibn Abi Shaybah 28159","","","كتاب الديات"
"28160","(۲۸۱۶۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : الْعَقْلُ عَلَی مَنْ لَہُ الْمِیرَاثُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28160","","","كتاب الديات"
"28161","(۲۸۱۶۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : أَبَی الْقَوْمُ أَنْ یَعْقِلُوا عَن مَوْلاَہُمْ ؟ قَالَ عَطَائٌ : إِنْ أَبَی أَہْلُہُ وَالنَّاسُ أَنْ یَعْقِلُوا عَنْہُ ، فَہُوَ مَوْلَی الْمُصَابِ۔","","Musannaf Ibn Abi Shaybah 28161","","","كتاب الديات"
"28162","(۲۸۱۶۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : قَالَ عُمَرُ فِیہِ : إِذَا وَالَی الرَّجُلُ رَجُلاً فَلَہُ مِیرَاثُہُ، وَعَلَی عَاقِلَتِہِ عَقْلُہُ۔","","Musannaf Ibn Abi Shaybah 28162","","","كتاب الديات"
"28163","(۲۸۱۶۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ؛ فِی رَجُلٍ تَوَلَّی قَوْمًا ، قَالَ : إِذَا عَقَلَ عَنہُمْ ، فَہُوَ مِنْہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 28163","","","كتاب الديات"
"28164","(۲۸۱۶۴) حَدَّثَنَا حَفْصٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُمَرَ ، قَالَ : حدَّثَنِی بَعْضُ الَّذِینَ قَدِمُوا عَلَی أَبِی ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَیُّمَا طَبِیبٍ تَطَبَّبَ عَلَی قَوْمٍ ، وَلَمْ یُعْرَفْ بِالطِّبِّ قَبْلَ ذَلِکَ ، فَأَعْنتَ فَہُوَ ضَامِنٌ ، قَالَ عَبْدُ الْعَزِیزِ : أَمَّا إِنَّہُ لَیْسَ بِالنَّعْتِ ، وَلَکِنَّہُ قَطْعُ الْعُرُوقِ وَالْبَطُّ۔ (ابوداؤد ۴۵۷۷۔ مسند ۹۸۳)","Da'if","Musannaf Ibn Abi Shaybah 28164","","","كتاب الديات"
"28165","(۲۸۱۶۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا جَاوَزَ الطَّبِیبُ مَا أُمِرَ بِہِ ، فَہُوَ ضَامِنٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 28165","","","كتاب الديات"
"28166","(۲۸۱۶۶) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، وَعُمَرُ بْنُ ہَارُونَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی الطَّبِیبِ یَبُطُّ فَیَمُوتُ ، قَالَ: لَیْسَ عَلَیْہِ عَقْلٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 28166","","","كتاب الديات"
"28167","(۲۸۱۶۷) حَدَّثَنَا إِسْمَاعِیلُ ، عَنْ ہِشَامٍ بْنِ الْغَازِ الْجُرَشِیِّ ، عَنْ أَبِی قُرَّۃَ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ضَمَّنَ الْخَاتِنَ۔","No Data Available","Musannaf Ibn Abi Shaybah 28167","","","كتاب الديات"
"28168","(۲۸۱۶۸) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ سَعِیدِ بْنِ یُوسُفَ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ؛ أَنَّ امْرَأَۃً خَفَضَتْ جَارِیَۃً فَأَعَنتْتہَا فَمَاتَتْ ، فَضَمَّنَہَا عَلِیٌّ الدِّیَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 28168","","","كتاب الديات"
"28169","(۲۸۱۶۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَن غَیْلاَنَ بْنِ جَامِعٍ الْمُحَارِبِیِّ ، عَنْ أَبِی عَوْنٍ الثَّقَفِیِّ ، عَنْ شُرَیْحٍ ، قَالَ : لَیْسَ عَلَی الْمُدَاوِی ضَمَانٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 28169","","","كتاب الديات"
"28170","(۲۸۱۷۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا یُونُسُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لَیْسَ عَلَی مُدَاوٍ ضَمَانٌ۔","","Musannaf Ibn Abi Shaybah 28170","","","كتاب الديات"
"28171","(۲۸۱۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یُونُسُ بن أَبِی إِسْحَاقَ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یَقُولُ : لَیْسَ عَلَی حَجَّامٍ ، وَلاَ بَیْطَارٍ ، وَلاَ مُدَاوٍ ضَمَانٌ۔","","Musannaf Ibn Abi Shaybah 28171","","","كتاب الديات"
"28172","(۲۸۱۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ فِی بَیْطَارٍ نَزَعَ ظُفْرَۃً مِنْ عَیْنِ فَرَسٍ فَنَفَقَ الْفَرَسُ ، قَالَ : یَضْمَنُ۔","","Musannaf Ibn Abi Shaybah 28172","","","كتاب الديات"
"28173","(۲۸۱۷۳) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الْمَلِیحِ ؛ أَنَّ خَتَّانَۃً بِالْمَدِینَۃِ خَتَنَتْ جَارِیَۃً فَمَاتَتْ، فَقَالَ لَہَا عُمَرُ : أَلاَ أَبْقَیْتِ کَذَا ، وَجَعَلَ دِیَتَہَا عَلَی عَاقِلَتِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 28173","","","كتاب الديات"
"28174","(۲۸۱۷۴) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ؛ أَنَّ امْرَأَۃً کَانَتْ تَخْفِضُ جَوَارٍ فَأَعَنتَتْ ، فَضَمَّنَہَا عُمَرُ ، وَقَالَ : أَلاَ أَبْقَیْتِ کَذَا۔","","Musannaf Ibn Abi Shaybah 28174","","","كتاب الديات"
"28175","(۲۸۱۷۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، قَالَ : قُلْتُ لأَبِی : الرَّجُلُ یُقْتَلُ فَیَعْفُو عَن دَمِہِ ، قَالَ : جَائِزٌ ، قَالَ : قُلْتُ : خَطَأً ، أَمْ عَمْدًا ؟ قَالَ : نَعَمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 28175","","","كتاب الديات"
"28176","(۲۸۱۷۶) حَدَّثَنَا ہُشَیْمٌ ، عَن یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ : إِذَا عَفَا الرَّجُلُ عَن قَاتِلِہِ فِی الْعَمْدِ قَبْلَ أَنْ یَمُوتَ ، فَہُوَ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 28176","","","كتاب الديات"
"28177","(۲۸۱۷۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ؛ أَنَّ عُرْوَۃَ بْنَ مَسْعُودٍ الثَّقَفِیَّ دَعَا قَوْمَہُ إِلَی اللہِ وَإِلَی رَسُولِہِ ، فَرَمَاہُ رَجُلٌ مِنْہُمْ بِسَہْمٍ فَمَاتَ فَعَفَا ، فَرُفِعَ ذَلِکَ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَجَازَ عَفْوَہُ ، وَقَالَ : ہُوَ کَصَاحِبِ یَاسِینَ۔ (طبرانی ۱۲۱۵۶)","","Musannaf Ibn Abi Shaybah 28177","","","كتاب الديات"
"28178","(۲۸۱۷۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سَمِعْتُ عَطَائً یَقُولُ : إِنْ وَہَبَ الَّذِی یُقْتَلُ خَطَأً دِیَتَہُ لِمَنْ قَتَلَہُ ، فَإِنَّمَا لَہُ مِنْہَا الثُّلُثُ ، إِنَّمَا ہُوَ مَالٌ یُوصِی بِہِ۔","","Musannaf Ibn Abi Shaybah 28178","","","كتاب الديات"
"28179","(۲۸۱۷۹) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنِ ابْنِ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ سِمَاکِ بْنِ الْفَضْلِ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : مِنَ الثُّلُثِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28179","","","كتاب الديات"
"28180","(۲۸۱۸۰) حَدَّثَنَا إِسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ : حدَّثَنَی عَبْدُ الرَّحْمَنِ بْنُ أَبِی زَیْد ، عَن نَافِعِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یُزَادُ فِی دِیَۃِ الْمَقْتُولِ فِی أَشْہُرِ الْحُرُمِ أَرْبَعَۃُ آلاَفٍ ، وَالْمَقْتُولُ فِی الْحَرَمِ یُزَادُ فِی دِیَتِہِ أَرْبَعَۃُ آلاَفٍ ، قِیمَۃُ دِیَۃِ الْحرمِیِّ عِشْرِینَ أَلْفًا۔","Da'if","Musannaf Ibn Abi Shaybah 28180","","","كتاب الديات"
"28181","(۲۸۱۸۱) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ عَمْرِو بْنِ عَبْدِ اللہِ ، عَن عِکْرِمَۃَ ، عن عُمَرَ بْنِ الْخَطَّابِ ؛ قَضَی بِالدِّیَۃِ عَلَی أَہْلِ الْقُرَی اثْنَیْ عَشَرَ أَلْفًا ، وَقَالَ : إِنَّ الزَّمَانَ یَخْتَلِفُ ، وَأَخَافُ عَلَیْکُمُ الْحُکَّامَ بَعْدِی ، فَلَیْسَ عَلَی أَہْلِ الْقُرَی زِیَادَۃٌ فِی تَغْلِیظِ عَقْلٍ ، وَلاَ فِی الشَّہْرِ الْحَرَامِ ، وَلاَ الْحُرْمَۃِ ، وَعَقْلِ أَہْلِ الْقُرَی فِیہِ تَغْلِیظٌ لاَ زِیَادَۃَ فِیہِ۔","Da'if","Musannaf Ibn Abi Shaybah 28181","","","كتاب الديات"
"28182","(۲۸۱۸۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ أَبِیہِ ؛ أَنَّ عُثْمَانَ قَضَی فِی امْرَأَۃٍ قُتِلَتْ فِی الْحَرَمِ بِدِیَۃٍ وَثُلُثِ دِیَۃٍ۔","","Musannaf Ibn Abi Shaybah 28182","","","كتاب الديات"
"28183","(۲۸۱۸۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، وَأَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَسُلَیْمَانَ بْنِ یَسَارٍ ، وَعَطَائٍ ، قَالُوا : إِذَا قُتِلَ فِی الْبَلَدِ الْحَرَامِ فَدِیَۃٌ وَثُلُثُ دِیَۃٍ ، وَإِذَا قُتِلَ فِی الشَّہْرِ الْحَرَامِ وَہُوَ مُحْرِمٌ فَدِیَۃٌ مُغَلَّظَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 28183","","","كتاب الديات"
"28184","(۲۸۱۸۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَن قَیْسِ بْنِ سَعْدٍ ، عَنْ عَطَائٍ ، وَسَعِیدِ بْنِ جُبَیْرٍ ، وَمُجَاہِدٍ؛ أَنَّہُمْ قَالُوا: فِی الَّذِی یَقْتُلُ فِی الْحرمِ دِیَۃٌ وَثُلُثُ دِیَۃٍ۔ وَقَالَ أَحَدُہُمْ ، أَحْسِبُہُ قَالَ : سَعِیدَ بْنَ جُبَیْرٍ : وَالَّذِی یَقْتُلُ فِی الْحرمِ دِیَۃٌ وَثُلُثُ دِیَۃٍ۔","","Musannaf Ibn Abi Shaybah 28184","","","كتاب الديات"
"28185","(۲۸۱۸۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّہُ قَالَ : فِی الرَّجُلِ یُقْتَلُ فِی الْحَرَمِ ، أَوْ فِی أَشْہُرِ الْحُرُمِ ، دِیَۃٌ وَثُلُثُ دِیَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 28185","","","كتاب الديات"
"28186","(۲۸۱۸۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ: دِیَۃُ الَّذِی یَقْتُلُ فِی الْحَرَمِ وَغَیْرِ الْحَرَمِ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 28186","","","كتاب الديات"
"28187","(۲۸۱۸۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : دِیَتُہُمَا سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 28187","","","كتاب الديات"
"28188","(۲۸۱۸۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِید بن أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا قُتِلَ فِی الْبَلَدِ الْحَرَامِ وَفِی غَیْرِ الْبَلَدِ الْحَرَامِ فَالدِّیَۃُ وَاحِدَۃٌ۔","","Musannaf Ibn Abi Shaybah 28188","","","كتاب الديات"
"28189","(۲۸۱۸۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یُزَادُ عَلَی دِیَۃٍ وَاحِدَۃٍ ، مِثْلَ قَوْلِ إِبْرَاہِیمَ۔","","Musannaf Ibn Abi Shaybah 28189","","","كتاب الديات"
"28190","(۲۸۱۹۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ : تُغَلَّظُ الدِّیَۃُ فِی الشَّہْرِ الْحَرَامِ ، وَالْحُرْمَۃِ ، وَالْمُحْرِمِ ، وَفِی الْجَارِ۔","","Musannaf Ibn Abi Shaybah 28190","","","كتاب الديات"
"28191","(۲۸۱۹۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فِی الْجَارِ وَفِی الشَّہْرِ الْحَرَامِ تَغْلِیظٌ۔","","Musannaf Ibn Abi Shaybah 28191","","","كتاب الديات"
"28192","(۲۸۱۹۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عَمْرُو بْنُ دِینَارٍ ، وَسُلَیْمَانُ الأَحْوَلُ ؛ أَنَّہُمَا سَمِعَا طَاوُوسًا یَقُولُ : فِی الْحَرَمِ ، وَالشَّہْرِ الْحَرَامِ ، وَالْجَارِ تَغْلِیظٌ۔","","Musannaf Ibn Abi Shaybah 28192","","","كتاب الديات"
"28193","(۲۸۱۹۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یُزَادُ الَّذِی یُقْتَلُ فِی الْحَرَمِ عَلَی دِیَۃِ الَّذِی یُقْتَلُ فِی الْحِلِّ۔","","Musannaf Ibn Abi Shaybah 28193","","","كتاب الديات"
"28194","(۲۸۱۹۴) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ سِمَاکِ بْنِ الْفَضْلِ ؛ أَنَّ رَجُلاً خَنَقَ صَبِیًّا عَلَی أَوْضَاحٍ لَہُ ، قَالَ : فَکَتَبَ فِیہِ إِلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، فَکَتَبَ أَنْ یُقْتَلَ۔","","Musannaf Ibn Abi Shaybah 28194","","","كتاب الديات"
"28195","(۲۸۱۹۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا خَنَقَہُ حَتَّی یَقْتُلَہُ قُتِلَ بِہِ۔","","Musannaf Ibn Abi Shaybah 28195","","","كتاب الديات"
"28196","(۲۸۱۹۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا إِسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : إِذَا خَنَقَ الرَّجُلُ الرَّجُلَ فَلَمْ یَرْفَعْ عَنْہُ حَتَّی یَقْتُلَہُ فَہُوَ قَودٌ ، وَإِذَا رَفَعَ عَنْہُ ثُمَّ مَاتَ فَدِیَۃٌ مُغَلَّظَۃٌ۔","","Musannaf Ibn Abi Shaybah 28196","","","كتاب الديات"
"28197","(۲۸۱۹۷) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ؛ أَنَّ رَجُلاً خَنَقَ رَجُلاً فَقَتَلَہُ ، فَجُعِلَتْ عَلَیْہِ الدِّیَۃُ مُغَلَّظَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 28197","","","كتاب الديات"
"28198","(۲۸۱۹۸) حَدَّثَنَا أَبُو قُتَیْبَۃَ ، وَأَبُو دَاوُد الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، عَن حَمَّادٍ ، قَالَ : ہُوَ خَطَأٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 28198","","","كتاب الديات"
"28199","(۲۸۱۹۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ ؛ فِی الرَّجُلِ یَضْرِبُ الرَّجُلَ ، قَالَ : إِذَا شَہِدَتِ الشُّہُودُ أَنَّہُ ضَرَبَہُ فَلَمْ یَزَلْ مَرِیضًا مِنْ ضَرْبِہِ حَتَّی مَاتَ أَلْزَمْتُہُ الدِّیَۃَ ، فَإِنْ کَانَ عَامِدًا فَالْقَودُ ، وَإِنْ کَانَ خَطَأً فَالدِّیَۃُ عَلَی الْعَاقِلَۃِ۔","","Musannaf Ibn Abi Shaybah 28199","","","كتاب الديات"
"28200","(۲۸۲۰۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَضْرِبُ الرَّجُلَ ، فَلاَ یَزَالُ مُضْنًی عَلَی فِرَاشِہِ حَتَّی یَمُوتَ ، قَالَ : فِیہِ الْقَودُ۔","","Musannaf Ibn Abi Shaybah 28200","","","كتاب الديات"
"28201","(۲۸۲۰۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَن تَمِیمِ بْنِ سَلَمَۃَ ، قَالَ : شَہِدَ رَجُلاَنِ عَندَ شُرَیْحٍ عَلَی رَجُلٍ ، فَقَالاَ : نَشْہَدُ أَنَّ ہَذَا صَرَعَ ہَذَا ، فَلَمْ یَزَلْ یَعْصِرُہُ بِمِرْفَقِہِ حَتَّی مَاتَ ، فَقَالَ شُرَیْحٌ : تَشْہَدَان أَنَّہُ قَتَلَہُ ؟ فَقَالاَ : نَشْہَدُ أَنَّہُ صَرَعَہُ ، فَلَمْ یَزَلْ یَعْصِرُہُ بِمِرْفَقِہِ حَتَّی مَاتَ ، فَقَالَ : تَشْہَدَان أَنَّہُ قَتَلَہُ؟۔n(عبدالرزاق ۱۸۳۰۰۔ بیہقی ۱۳۴)","","Musannaf Ibn Abi Shaybah 28201","","","كتاب الديات"
"28202","(۲۸۲۰۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی ابْنُ شِہَابٍ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَوْطَأَ فِی زَمَانِہِ رَجُلٌ مِنْ جُہَیْنَۃَ رَجُلاً مِنْ بَنِی غِفَارٍ ، أَوْ رَجُلٌ مِنْ بَنِی غِفَارٍ رَجُلاً مِنْ جُہَیْنَۃَ ، فَادَّعَی أَہْلُہُ أَنَّہُ مَاتَ مِنْ ذَلِکَ ۔ فَأَحْلَفَہُمْ عُمَرُ خَمْسِینَ رَجُلاً مِنْہُمْ مِنَ الْمُدَّعِینَ فَأَبَوْا أَنْ یَحْلِفُوا ، وَأَبَی الْمُدَّعَی عَلَیْہِمْ أَنْ یَحْلِفُوا ، فَقَضَی عُمَرُ فِیہَا بِشَطْرِ الدِّیَۃِ۔ (عبدالرزاق ۱۸۲۹۷۔ مالک ۳)","","Musannaf Ibn Abi Shaybah 28202","","","كتاب الديات"
"28203","(۲۸۲۰۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی حَسَنُ بْنُ مُسْلِمٍ ؛ أَنَّ أَمَۃً عَضَّتْ إِصْبَعًا لِمَوْلَی لِبَنِی زَیْدٍ ، فَطُمِرَ فِیہَا فَمَاتَ ، فَاعْتَرَفَتِ الْجَارِیَۃُ بِعَضَّتِہَا إِیَّاہُ ، فَقَضَی فِیہَا عُمَرُ بْنُ عَبْدِ الْعَزِیزِ بِأَنْ یُحَلِّفَ بَنُو زَیْدٍ خَمْسِینَ یَمِینًا ، تُرَدَّدُ عَلَیْہِمُ الأَیْمَانُ ، لَمَاتَ مِنْ عَضَّتِہَا ، ثُمَّ الأَمَۃُ لَہُمْ ، وَإِلاَّ فَلاَ حَقَّ لَہُمْ ، فَأَبَوْا أَنْ یَحْلِفُوا۔","Hasan","Musannaf Ibn Abi Shaybah 28203","","","كتاب الديات"
"28204","(۲۸۲۰۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی عَوْنٍ ، عَنْ شُرَیْحٍ ؛ أَنَّ رَجُلاً لَقِیَ رَجُلاً بِکُرْسِیٍّ فَصَدَمَہُ فَقَتَلَہُ ، فَقَالَ شُرَیْحٌ : ضَمِنَ الصَّادِمُ لِلْمَصْدُومِ۔","","Musannaf Ibn Abi Shaybah 28204","","","كتاب الديات"
"28205","(۲۸۲۰۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلِیٍّ ؛ فِی فَارِسَیْنِ اصْطَدَمَا فَمَاتَ أَحَدُہُمَا ، فَضَمِنَ الْحَیُّ الْمَیِّتَ۔","Da'if","Musannaf Ibn Abi Shaybah 28205","","","كتاب الديات"
"28206","(۲۸۲۰۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إِسْمَاعِیلَ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ سُئِلَ عَن سَفِینَتَیْنِ اصْطَدَمَتَا ، فَغَرِقَتْ إِحْدَاہُمَا ؟ فَقَالَ : لَیْسَ عَلَی الآخِرین ضَمَان ، وَلَکِنْ أَیُّمَا رَجُلٍ أَوْثَقَ سَفِینَۃً عَلَی طَرِیقِ الْمُسْلِمِینَ فَأَصَابَتْ ، فَہُوَ ضَامِنٌ۔","","Musannaf Ibn Abi Shaybah 28206","","","كتاب الديات"
"28207","(۲۸۲۰۷) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ؛ فِی الْفَارِسَیْنِ یَصْطَدِمَانِ ، قَالَ : یَضْمَنُ الْحَیُّ دِیَۃَ الْمَیِّتِ۔","Da'if","Musannaf Ibn Abi Shaybah 28207","","","كتاب الديات"
"28208","(۲۸۲۰۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ قَتَادَۃَ ، عَن کَعْبِ بْنِ سُورٍ ؛ أَنَّ رَجُلاً کَانَ عَلَی حِمَارٍ ، فَاسْتَقْبَلَہُ رَجُلٌ عَلَی بَعِیرٍ فِی زُقَاقٍ ، فَنَفَرَ الْحِمَارُ ، فَصُرعَ الرَّجُلُ فَأَصَابَہُ شَیْئٌ ، فَلَمْ یضَمِّنْ کَعْبُ بْنُ سُورٍ صَاحِبَ الْبَعِیرِ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 28208","","","كتاب الديات"
"28209","(۲۸۲۰۹) حَدَّثَنَا شَبَابَۃُ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الْمُطَّلِبِ بْنِ السَّائِبِ السَّہْمِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ عُثْمَانَ قَضَی أَنَّ کُلَّ مُقْتَتِلَیْنِ اقْتَتَلاَ ضَمِنَا مَا بَیْنَہُمَا۔","Hasan","Musannaf Ibn Abi Shaybah 28209","","","كتاب الديات"
"28210","(۲۸۲۱۰) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا أُشْہِدَ عَلَی صَاحِبِ الْحَائِطِ الْمَائِلِ فَوَقَعَ فَأَصَابَ ، فَہُوَ ضَامِنٌ۔","","Musannaf Ibn Abi Shaybah 28210","","","كتاب الديات"
"28211","(۲۸۲۱۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ شُرَیْحٍ ، قَالَ : إِذَا کَانَ حَائِطُ الرَّجُلِ مَائِلاً فَأَشْہَدَ عَلَیْہِ ، ضَمِنَ۔","No Data Available","Musannaf Ibn Abi Shaybah 28211","","","كتاب الديات"
"28212","(۲۸۲۱۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28212","","","كتاب الديات"
"28213","(۲۸۲۱۳) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ الْخَفَّافُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ؛ أَنَّہُ کَانَ یَقُولُ فِی الْحَائِطِ الْمَائِلِ إِذَا شَہِدُوا عَلَی صَاحِبِہِ فَقَتَلَ إِنْسَانًا ، فَہُوَ ضَامِنٌ۔","","Musannaf Ibn Abi Shaybah 28213","","","كتاب الديات"
"28214","(۲۸۲۱۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی عَوْنٍ ، عَنْ شُرَیْحٍ ؛ أَنَّ غُلاَمًا وَثَبَ عَلَی آخَرَ ، فَتَنَحَّی الأَسْفَلُ وَانْکَسَرَتْ ثَنِیَّۃُ الأَعْلَی ، فَضَمَّنَ الأَعْلَی ، وَلَمْ یُضَمِّنِ الأَسْفَلَ۔","","Musannaf Ibn Abi Shaybah 28214","","","كتاب الديات"
"28215","(۲۸۲۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِمْرَانُ بْنُ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : لَوْ صَرَعَ رَجُلٌ عَلَی رَجُلٍ فَمَاتَ أَحَدُہُمَا ضمن الْبَاقِی ، قَالَ : قُلْتُ : لِمَ ؟ قَالَ : لأَنَّہُ لاَ یُطَلُّ دَمُ مُسْلِمٍ۔","","Musannaf Ibn Abi Shaybah 28215","","","كتاب الديات"
"28216","(۲۸۲۱۶) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّ غُلاَمَیْنِ کَانَا یَلْعَبَانِ التَّحِیَۃَ ، فَصَرَعَ أَحَدُہُمَا الآخَرَ ، فَشُجَّ أَحَدُہُمَا وَانْکَسَرَتْ ثَنِیَّۃُ الآخَرِ ، فَضَمَّنَ الأَعْلَی الأَسْفَلَ ، وَلَمْ یُضَمنْ الأَسْفَلُ الأَعْلَی۔","","Musannaf Ibn Abi Shaybah 28216","","","كتاب الديات"
"28217","(۲۸۲۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی حَصیْنٍ ، عَنْ شُرَیْحٍ ؛ فِی رَجُلٍ وَقَعَ عَلَی رَجُلٍ مِنْ فَوْقِ بَیْتٍ ، فَمَاتَ الأَعْلَی ، قَالَ شُرَیْحٌ : أُضَمِّنُ الأَرْضَ۔","","Musannaf Ibn Abi Shaybah 28217","","","كتاب الديات"
"28218","(۲۸۲۱۸) حَدَّثَنَا شَرِیکٌ ، قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : إِنْ مَاتَ الأَسْفَلُ ضَمِنَ الأَعْلَی۔","","Musannaf Ibn Abi Shaybah 28218","","","كتاب الديات"
"28219","(۲۸۲۱۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلِیِّ بْنِ أَبِی طَالِبٍ ، قَالَ : کَانَ غُلاَمَانِ یَلْعَبَانِ ، فَوَثَبَ أَحَدُہُمَا عَلَی ظَہْرِ صَاحِبِہِ ، فَانْکَسَرَتْ ثَنِیَّۃُ الأَعْلَی ، وَشُجَّ الأَسْفَلُ ، فَضَمَّنَ بَعْضُہُمْ بَعْضًا۔","","Musannaf Ibn Abi Shaybah 28219","","","كتاب الديات"
"28220","(۲۸۲۲۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ؛ فِی رَجُلٍ وَقَعَ عَلَی رَجُلٍ مِن فَوْق بَیْتٍ ، فَمَاتَ أَحَدُہُمَا ، قَالَ: یَضْمَنُ الْحَیُّ مِنْہُمَا۔","","Musannaf Ibn Abi Shaybah 28220","","","كتاب الديات"
"28221","(۲۸۲۲۱) حَدَّثَنَا أَبُو بَکْرٍ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ فِی رَجُلٍ وَثَبَ عَلَی رَجُلٍ ، فَانْکَسَرَتْ ثَنِیَّۃُ الْوَاثِبِ وَشُجَّ الْمَوْثُوبُ عَلَیْہِ ، فَأَبْطَلَ ثَنِیَّۃَ الْوَاثِبِ ، وَضَمَّنَہُ شَجَّۃَ الْمَوْثُوبِ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 28221","","","كتاب الديات"
"28222","(۲۸۲۲۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عَطَائٌ ، قَالَ : أَخْبَرَنِی صَفْوَانُ بْنُ یَعْلَی بْنِ أُمَیَّۃَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ لِی أَجِیرٌ ، فَقَاتَلَ إِنْسَانًا ، فَعَضَّ أَحَدُہُمَا یَدَ الآخَرِ ، قَالَ عَطَائٌ : لَقَدْ أَخْبَرَنِی صَفْوَانُ أَیُّہُمَا عَضَّ الآخَرَ ، فَانْتَزَعَ الْمَعْضُوضُ یَدَہُ مِنْ فِی الْعَاضِّ ، فَانْتَزَعَ إِحْدَی ثَنِیَّتِہِ ، فَأَتَیَا إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَہْدَرَ ثَنِیَّتَہُ۔ (بخاری ۶۸۹۳۔ مسلم ۱۳۰۱)","Sahih","Musannaf Ibn Abi Shaybah 28222","","","كتاب الديات"
"28223","(۲۸۲۲۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَن زُرَارَۃَ ، عَن عِمْرَانَ بْنِ حُصَیْنٍ ، قَالَ : فَأَطَلَّہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (بخاری ۶۸۹۲۔ طبرانی ۵۳۳)","Sahih","Musannaf Ibn Abi Shaybah 28223","","","كتاب الديات"
"28224","(۲۸۲۲۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ ؛ أَنَّ رَجُلاً عَضَّ یَدَ آخَرَ عَلَی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَانْتَزَعَ ثَنِیَّتَہُ ، فَأَہْدَرَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 28224","","","كتاب الديات"
"28225","(۲۸۲۲۵) حَدَّثَنَا إِسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ؛ قَالَ : نُبِّئْتُ أَنَّ رَجُلاً عَضَّ یَدَ رَجُلٍ ، فَانْتَزَعَ یَدَہُ مِنْ فِیہِ فَأَسْقَطَ ثَنِیَّۃً ، أَوْ ثَنِیَّتَیْنِ مِنْ فِیہِ ، فَأَتَی إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْتَقِیدُ ، فَقَالَ لَہُ: أَفَیَدَعُ یَدَہُ فِی فِیکَ تَأْکُلُہَا ؟ إِنْ شِئْتَ دَفَعْتَ یَدَک إِلَیْہِ یَعَضُّہَا ، ثُمَّ انْتَزَعْہَا۔ (مسلم ۱۳۰۱۔ احمد ۴۳۵)","","Musannaf Ibn Abi Shaybah 28225","","","كتاب الديات"
"28226","(۲۸۲۲۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنَی ابْنُ أَبِی مُلَیْکَۃَ ، عَنْ جَدِّہِ ؛ أَنَّ إِنْسَانًا أَتَی أَبَا بَکْرٍ ، وَعَضَّہُ إِنْسَانٌ فَنَزَعَ یَدَہُ مِنْہُ فَنَدَرَتْ ثَنِیَّتُہُ ، فَقَالَ أَبُو بَکْرٍ : بَعِدتْ ثَنِیَّتَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 28226","","","كتاب الديات"
"28227","(۲۸۲۲۷) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ؛ أَنَّ أَبَا بَکْرٍ ، وَعُمَرَ أَبْطَلاَہَا۔","","Musannaf Ibn Abi Shaybah 28227","","","كتاب الديات"
"28228","(۲۸۲۲۸) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنْ مُحَمَّدِ بْنِ عُبَیْدِ اللہِ ، عَنْ شُرَیْحٍ ؛ فِی رَجُلٍ عَضَّ رَجُلاً فَنَزَعَ یَدَہُ، فَانْتُزِعَتْ ثَنِیَّتُہُ ، فَأَبْطَلَہَا شُرَیْحٌ۔","","Musannaf Ibn Abi Shaybah 28228","","","كتاب الديات"
"28229","(۲۸۲۲۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ؛ أَنَّ رَجُلَیْنِ مِنَ الأَعْرَابِ اخْتَصَمَا بِالْمَدِینَۃِ فِی زَمَانِ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، فَقَالَ أَحَدُہُمَا لِصَاحِبِہِ : ضَرَبْتُہُ وَاللَّہِ حَتَّی سَلَحَ ، فَقَالَ : اشْہَدُوا ، فَقَدْ وَاللَّہِ صَدَقَ ، فَأَرْسَلَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ إِلَی سَعِیدِ بْنِ الْمُسَیَّبِ یَسْأَلُہُ عَنْ رَجُلٍ ضَرَبَ رَجُلاً حَتَّی سَلَحَ ، ہَلْ فِی ذَلِکَ أَمْر مَضَی ، أَوْ سُنَّۃٌ ؟ قَالَ سَعِیدٌ : قَضَی فِیہَا عُثْمَانُ بِثُلُثِ الدِّیَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 28229","","","كتاب الديات"
"28230","(۲۸۲۳۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ، عَنِ الشَّیْبَانِیِّ، عَنِ الشَّعْبِیِّ؛ فِی الرَّجُلِ إِذَا أَصَابَ بِجِرَاحَۃٍ فَاقْتُصَّ مِنْہُ فَمَاتَ، قَالَ : یُدْفَع مِنْ دِیَۃِ الْمَیِّتِ ??ِرَاحَۃَ الأَوَّلِ۔ قَالَ عَبْدُ اللہِ بْنُ ذَکْوَانَ : لَیْسَ لَہُ مِنْ دِیَۃِ الْمَیِّتِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 28230","","","كتاب الديات"
"28231","(۲۸۲۳۱) حَدَّثَنَا أَبُو بَکْرٍ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یُرْفَعُ عَنْہُ بِقَدْرِ الْجِرَاحَۃِ۔","","Musannaf Ibn Abi Shaybah 28231","","","كتاب الديات"
"28232","(۲۸۲۳۲) حَدَّثَنَا عَبْدَہُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ، قَالَ : یُرْفَعُ عَنْہُ بِقَدْرِ الْجِرَاحَۃِ ، وَیَکُونُ ضَامِنًا لِبَقِیَّۃِ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 28232","","","كتاب الديات"
"28233","(۲۸۲۳۳) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ، قَالَ: إِذَا مَاتَ الَّذِی یُقْتَصُّ مِنْہُ ،فَالْمُقْتَصُّ ضَامِنٌ لِلدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 28233","","","كتاب الديات"
"28234","(۲۸۲۳۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ؛ فِی الْمُقْتَصِّ مِنْہُ : أَیُّہُمَا مَاتَ وُدِیَ۔","","Musannaf Ibn Abi Shaybah 28234","","","كتاب الديات"
"28235","(۲۸۲۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : اسْتَأْذَنْتُ زِیَادَ بْنَ جُبَیْرٍ فِی الْحَجِّ ، فَسَأَلَنِی عَنْ رَجُلٍ شَجَّ رَجُلاً فَاقْتَصَّ لَہُ مِنْہُ ، فَمَاتَ الْمُقْتَصُّ مِنْہُ ؟ فَقُلْتُ : عَلَیْہِ الدِّیَۃُ ، وَیُرْفَعُ عَنْہُ بِقَدْرِ الشَّجَّۃِ ، ثُمَّ ہِبْتُ ذَلِکَ فَجَائَ إِبْرَاہِیمُ فَسَأَلْتُہُ ؟ فَقَالَ : عَلَیْہِ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 28235","","","كتاب الديات"
"28236","(۲۸۲۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَن ذَلِکَ ؟ فَقَالاَ : عَلَیْہِ الدِّیَۃُ ، وَقَالَ حَمَّادٌ : یُرْفَعُ عَنْہُ بِقَدْرِ الشَّجَّۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28236","","","كتاب الديات"
"28237","(۲۸۲۳۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، وَالشَّعْبِیِّ ، قَالاَ : عَلَیْہِ الدِّیَۃُ ، وَیُرْفَعُ عَنْہُ بِقَدْرِ الشَّجَّۃِ۔","","Musannaf Ibn Abi Shaybah 28237","","","كتاب الديات"
"28238","(۲۸۲۳۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ (ح) وَعَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالاَ : عَلَیْہِ الدِّیَۃُ ، وَلاَ یُرْفَعُ عَنْہُ شَیْئٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 28238","","","كتاب الديات"
"28239","(۲۸۲۳۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنْ عَامِرٍ (ح) وَعَنْ حَجَّاجٍ ، عَنْ عُمَیْرِ بْنِ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَن خِلاَسٍ ، عَنْ عَلِیٍّ ؛ أَنَّہُ قَالَ : مَنْ مَاتَ فِی قِصَاصٍ بِکِتَابِ اللہِ فَلاَ دِیَۃَ لَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28239","","","كتاب الديات"
"28240","(۲۸۲۴۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ سَعِید ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدٍ ، عَنْ عُمَرَ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 28240","","","كتاب الديات"
"28241","(۲۸۲۴۱) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ؛ فِی الرَّجُلِ یُقْتَصُّ مِنْہُ فَیَمُوتُ: لاَ دِیَۃَ لَہُ ، قَتَلَہُ کِتَابُ اللہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28241","","","كتاب الديات"
"28242","(۲۸۲۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ، عَن یُونُسَ، عَنِ الْحَسَنِ؛ فِی الرَّجُلِ یَمُوتُ فِی الْقِصَاصِ ، قَالَ : لاَ دِیَۃَ لَہُ۔","","Musannaf Ibn Abi Shaybah 28242","","","كتاب الديات"
"28243","(۲۸۲۴۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَن شَیْخٍ مِنْ أَہْلِ الْبَصْرَۃِ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ ؛ أَنَّ أَبَا بَکْرٍ ، وَعُمَرَ ، قَالاَ : مَنْ قَتَلَہُ حَدٌّ فَلاَ عَقْلَ لَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 28243","","","كتاب الديات"
"28244","(۲۸۲۴۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ؛ فِی الرَّجُلِ یُقَامُ عَلَیْہِ الْحَدُّ فَیَمُوتُ ، قَالاَ : لاَ دِیَۃَ لَہُ۔","","Musannaf Ibn Abi Shaybah 28244","","","كتاب الديات"
"28245","(۲۸۲۴۵) حَدَّثَنَا عَبَّادٌ ، عَنْ حَجَّاجٍ ، عَنْ عُمَیْرِ بْنِ سَعِیدٍ ، قَالَ : قَالَ عَلِیٌّ : إِذَا أُقِیمَ عَلَی الرَّجُلِ الْحَدُّ فِی الزنَی، أَوْ سَرِقَۃٍ ، أَوْ قَذْفٍ فَمَاتَ ، فَلاَ دِیَۃَ لَہُ۔","","Musannaf Ibn Abi Shaybah 28245","","","كتاب الديات"
"28246","(۲۸۲۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، وَسُفْیَانُ ، عَنْ أَبِی حَصِینٍ ، عَنْ عُمَیْرِ بْنِ سَعِید النَّخَعِیِّ ، قَالَ : قَالَ عَلِیٌّ : مَا کُنْتُ لأُِقِیمَ عَلَی رَجُلٍ حَدًّا فَیَمُوت فَأَجِد فِی نَفْسِی مِنْہُ شَیْئًا إِلاَّ صَاحِبَ الْخَمْرِ لَوْ مَاتَ وَدَیْتُہُ۔ وَزَادَ سُفْیَانُ : وَذَلِکَ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمْ یَسُنَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 28246","","","كتاب الديات"
"28247","(۲۸۲۴۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ، قَالَ: حدَّثَنَا سَعِیدٌ، عَنْ مَطَرٍ، عَنْ عَطَائٍ، عَن عُبَیْدِ بْنِ عُمَیْرٍ؛ أَنَّ عَلِیًّا وَ عُمَرَ، قَالاَ : مَنْ قَتَلَہُ قِصَاصٌ فَلاَ دِیَۃَ لَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 28247","","","كتاب الديات"
"28248","(۲۸۲۴۸) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَلِیٍّ ، وَعَبْدِ اللہِ ، قَالاَ : الْعَمْدُ السِّلاَحُ۔","","Musannaf Ibn Abi Shaybah 28248","","","كتاب الديات"
"28249","(۲۸۲۴۹) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28249","","","كتاب الديات"
"28250","(۲۸۲۵۰) حَدَّثَنَا أَبُو خَالِدٍ، عَنِ ابْنِ جُرَیْجٍ، عَمَّنْ حَدَّثَہُ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، قَالَ: الْعَمْدُ بِالإِبْرَۃِ فَمَا فَوْقَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 28250","","","كتاب الديات"
"28251","(۲۸۲۵۱) حَدَّثَنَا عَبَّادٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَن مَسْرُوقٍ ، قَالَ : الْعَمْدُ بِالْحَدِیدَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28251","","","كتاب الديات"
"28252","(۲۸۲۵۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : کُلُّ شَیْئٍ بِحَدِیدَۃٍ ، فَہُوَ عَمْدٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 28252","","","كتاب الديات"
"28253","(۲۸۲۵۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یُقَادُ مِنْ ضَارِبٍ ، إِلاَّ أَنْ یَضْرِبَ بِحَدِیدَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 28253","","","كتاب الديات"
"28254","(۲۸۲۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ أَبِی عَازِبٍ ، عَنِ النُّعْمَانِ بْنِ بَشِیرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کُلُّ شَیْئٍ خَطَأٌ إِلاَّ السَّیْفَ ، وَلِکُلِّ خَطَأٍ أَرْشٌ۔","Da'if","Musannaf Ibn Abi Shaybah 28254","","","كتاب الديات"
"28255","(۲۸۲۵۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : الْعَمْدُ بِالسِّلاَحِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28255","","","كتاب الديات"
"28256","(۲۸۲۵۶) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَن زِیَادِ بْنِ عِلاَقَۃَ ، عَنْ رَجُلٍ ؛ أَنَّ رَجُلاً رَمَی رَجُلاً بِجُلْمُودٍ فَقَتَلَہُ ، فَأَقَادَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (بخاری ۱۹۰۳۔ بیہقی ۴۳)","Da'if","Musannaf Ibn Abi Shaybah 28256","","","كتاب الديات"
"28257","(۲۸۲۵۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : الضَّرْبُ بِالصَّخْرَۃِ عَمْدٌ ، وَفِیہَا الْقَوَدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28257","","","كتاب الديات"
"28258","(۲۸۲۵۸) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَن عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : یَعْمِدُ الرَّجُلُ الأَیْدُ ، یَعْنِی الشَّدِیدَ ، إِلَی الصَّخْرَۃِ ، أَوْ إِلَی الْخَشَبَۃِ فَیَشْدَخُ بِہَا رَأْسَ الرَّجُلِ ، وَأَیُّ عَمْدٍ أَعْمَدُ مِنْ ہَذَا ؟۔","","Musannaf Ibn Abi Shaybah 28258","","","كتاب الديات"
"28259","(۲۸۲۵۹) حَدَّثَنَا شَرِیکٌ ، عَن زَیْدِ بْنِ جُبَیْرٍ ، عَنْ جَرْوَۃَ بْنِ حُمیلٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عُمَرُ : یَعْمِدُ أَحَدُکُمْ إِلَی أَخِیہِ فَیَضْرِبُہُ بِمِثْلِ آکِلَۃِ اللَّحْمِ ، لاَ أُوتَی بِرَجُلٍ فَعَلَ ذَلِکَ فَقَتَلَ ، إِلاَّ أَقَدْتُہُ مِنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 28259","","","كتاب الديات"
"28260","(۲۸۲۶۰) حَدَّثَنَا عَبْدُالأَعْلَی، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ، قَالَ: أَیَضْرِبُہُ بِالْعَصَا عمْدًا؟ إِذَا قَتَلَتْ صَاحِبَہَا قُتِلَ الضَّارِبُ۔","","Musannaf Ibn Abi Shaybah 28260","","","كتاب الديات"
"28261","(۲۸۲۶۱) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : شِبْہُ الْعَمْدِ ؛ بِالْعَصَا ، وَالْحَجَرِ الْعَظِیمِ۔","Hasan","Musannaf Ibn Abi Shaybah 28261","","","كتاب الديات"
"28262","(۲۸۲۶۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ قَیْسٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا ضَرَبَ بِالْعَصَا فَأَعَادَ وَأَبْدَأَ ، قُتِلَ۔","","Musannaf Ibn Abi Shaybah 28262","","","كتاب الديات"
"28263","(۲۸۲۶۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنِ الرَّجُلِ یَضْرِبُ الرَّجُلَ بِالْعَصَا فَیَقْتُلُ ؟ قَالَ الْحَکَمُ : لَیْسَ عَلَیْہِ قَوَدٌ ، وَقَالَ حَمَّادٌ : یُقْتَلُ۔","","Musannaf Ibn Abi Shaybah 28263","","","كتاب الديات"
"28264","(۲۸۲۶۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : إِذَا عَلاَ بِالْعَصَا ، فَہُوَ قَوَدٌ۔","","Musannaf Ibn Abi Shaybah 28264","","","كتاب الديات"
"28265","(۲۸۲۶۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ؛ أَنَّ یَہُودِیًّا رَضَخَ رَأْسَ امْرَأَۃٍ بِحَجَرٍ ، فَرَضَخَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأْسَہُ بَیْنَ حَجَرَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 28265","","","كتاب الديات"
"28266","(۲۸۲۶۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ إِنْسَانًا قُتِلَ بِصَنْعَائَ ، وَأَنَّ عُمَرَ قَتَلَ بِہِ سَبْعَۃَ نَفَرٍ ، وَقَالَ : لَوْ تَمَالاَ عَلَیْہِ أَہْلُ صَنْعَائَ لَقَتَلْتُہُمْ بِہِ جَمِیعًا۔ (مالک ۸۷۱)","","Musannaf Ibn Abi Shaybah 28266","","","كتاب الديات"
"28267","(۲۸۲۶۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : قَالَ عُمَرُ : لَوِ اشْتَرَکَ فِیہِ أَہْلُ صَنْعَائَ لَقَتَلْتُہُمْ۔","","Musannaf Ibn Abi Shaybah 28267","","","كتاب الديات"
"28268","(۲۸۲۶۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْعُمَرِیُّ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ قَتَلَ سَبْعَۃً مِنْ أَہْلِ صَنْعَائَ بِرَجُلٍ ، وَقَالَ : لَوِ اشْتَرَکَ فِیہِ أَہْلُ صَنْعَائَ لَقَتَلْتُہُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 28268","","","كتاب الديات"
"28269","(۲۸۲۶۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ وَہْبٍ ، قَالَ : خَرَجَ رِجَالٌ سَفَرٌ فَصَحِبَہُمْ رَجُلٌ ، فَقَدِمُوا وَلَیْسَ مَعَہُمْ ، قَالَ: فَاتَّہَمَہُمْ أَہْلُہُ ، فَقَالَ شُرَیْحٌ : شُہُودُکُمْ أَنَّہُمْ قَتَلُوا صَاحِبَکُمْ، وَإِلاَّ حَلَفُوا بِاللَّہِ مَا قَتَلُوہُ ، فَأَتَوْا بِہِمْ عَلِیًّا وَأَنَا عِنْدَہُ ، فَفَرَّقَ بَیْنَہُمْ فَاعْتَرَفُوا ، فَسَمِعْتُ عَلِیًّا یَقُولُ : أَنَا أَبُو الْحَسَنِ الْقرْم ، فَأَمَرَ بِہِمْ فَقُتِلُوا۔","Sahih","Musannaf Ibn Abi Shaybah 28269","","","كتاب الديات"
"28270","(۲۸۲۷۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سَمِعْتُ سُلَیْمَانَ بْنَ مُوسَی ، قَالَ : فِی الْقَوْمِ یُدْلُونَ جَمِیعًا فِی الرَّجُلِ ، یَقْتُلُہُمْ جَمِیعًا بِہِ۔","","Musannaf Ibn Abi Shaybah 28270","","","كتاب الديات"
"28271","(۲۸۲۷۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : رَجُلٌ قَتَلَ رَجُلَیْنِ حُرَّیْنِ عَمْدًا ؟ قَالَ : ہُوَ بِہِمَا قَوَدٌ۔ (عبدالرزاق ۱۸۰۸۷)","","Musannaf Ibn Abi Shaybah 28271","","","كتاب الديات"
"28272","(۲۸۲۷۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَن مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنِ الْمُغِیرَۃَ بْنِ شُعْبَۃَ ؛ أَنَّہُ قَتَلَ سَبْعَۃً بِرَجُلٍ۔","Da'if","Musannaf Ibn Abi Shaybah 28272","","","كتاب الديات"
"28273","(۲۸۲۷۳) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَن حَبِیبِ بْنِ أَبِی ثَابِتٍ ، قَالَ ، لاَ یُقْتَلُ رَجُلاَنِ بِرَجُلٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 28273","","","كتاب الديات"
"28274","(۲۸۲۷۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، قَالَ : کَانَ عَبْدُ الْمَلِکِ ، وَابْنُ الزُّبَیْرِ لاَ یَقْتُلاَنِ مِنْہُمْ إِلاَّ وَاحِدًا۔","","Musannaf Ibn Abi Shaybah 28274","","","كتاب الديات"
"28275","(۲۸۲۷۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، قَالَ : لاَ یُقْتَلُ مِنْہُمْ إِلاَّ وَاحِد۔","","Musannaf Ibn Abi Shaybah 28275","","","كتاب الديات"
"28276","(۲۸۲۷۶) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَن حَسَنِ بْنِ صَالِحٍ ، عَن سِمَاکٍ ، عَن ذُہْلِ بْنِ کَعْبٍ ؛ أَنَّ مُعَاذًا قَالَ لِعُمَرَ : لَیْسَ لَکَ أَنْ تَقْتُلَ نَفْسَیْنِ بِنَفْسٍ۔","Da'if","Musannaf Ibn Abi Shaybah 28276","","","كتاب الديات"
"28277","(۲۸۲۷۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : کَانَ رَجُلٌ یَسُوقُ حِمَارًا وَکَانَ رَاکِبًا عَلَیْہِ، فَضَرَبَہُ بِعَصًا مَعَہُ ، فَطَارَتْ مِنْہَا شَظِیَّۃٌ فَأَصَابَتْ عَیْنَہُ فَفَقَأَتْہَا، فَرُفِعَ ذَلِکَ إِلَی عُمَرَ بْنِ الْخَطَّابِ ، فَقَالَ: ہِیَ یَدٌ مِنْ أَیْدِی الْمُسْلِمِینَ، لَمْ یُصِبْہَا اعْتِدَائٌ عَلَی أَحَدٍ، فَجَعَلَ دِیَۃَ عَیْنِہِ عَلَی عَاقِلَتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 28277","","","كتاب الديات"
"28278","(۲۸۲۷۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : الرَّجُلُ یُصِیبُ نَفْسَہُ بِالْجُرْحِ خَطَأً ، عَلَیْہِ بَیِّنَۃٌ ؟ قَالَ : تَعْقِلُہُ عَاقِلَتُہُ۔","","Musannaf Ibn Abi Shaybah 28278","","","كتاب الديات"
"28279","(۲۸۲۷۹) حَدَّثَنَا حَرَمِیُّ بْنُ عُمَارَۃَ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَن رَجُلَیْنِ شَہِدَا عَلَی رَجُلٍ فَقُطِعَتْ یَدُہُ ، فَنَظَرُوا فَإِذَا أَحَدُ الشَّاہِدَیْنِ عَبْدٌ ؟ قَالاَ : یَضْمَنُ الإِمَامُ۔","","Musannaf Ibn Abi Shaybah 28279","","","كتاب الديات"
"28280","(۲۸۲۸۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : حَملَ رَجُلٌ ابْنَہُ عَلَی فَرَسٍ لِیَشُورَہُ ، فَنَخَسَ بِہِ وَصَوَّتَ بِہِ فَقَتَلَہُ ، فَجَعَلَ دِیَتَہُ عَلَی عَاقِلَتِہِ ، وَلَمْ یُوَرِّثِ الأَبَ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 28280","","","كتاب الديات"
"28281","(۲۸۲۸۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : الرَّجُلُ یَقْتُلُ ابْنَہُ خَطَأً ؟ قَالَ : تَعْقِلُہُ عَاقِلَتُہُ۔","","Musannaf Ibn Abi Shaybah 28281","","","كتاب الديات"
"28282","(۲۸۲۸۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عَمْرُو بْنُ دِینَارٍ ؛ أَنَّ عَبْدَ الْمَلِکِ بْنَ مَرْوَانَ جَائَہُ رَجُلٌ قَتَلَ أَبَاہُ وَأَخَاہُ ، فَقَالَ : فِی مَالِکَ خَاصَّۃً۔","","Musannaf Ibn Abi Shaybah 28282","","","كتاب الديات"
"28283","(۲۸۲۸۳) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَن سِمَاکٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَعْقَاعِ ، قَالَ : دَعَوْتُ إِلَی بَیْتِی قَوْمًا فَطَعِمُوا وَشَرِبُوا، فَسَکِرُوا وَقَامُوا إِلَی سَکَاکِینَ الْبَیْتِ، فَاضْطَرَبُوا بِہَا، فَجَرَحَ بَعْضُہُمْ بَعْضًا وَہُمْ أَرْبَعَۃٌ ، فَمَاتَ اثْنَان وَبَقِیَ اثْنَان، فَجَعَلَ عَلِیٌّ الدِّیَۃَ عَلَی الأَرْبَعَۃِ جَمِیعًا، وَقَصَّ لِلْمَجْرُوحِینَ مَا أَصَابَہُمَا مِنْ جِرَاحَاتِہِمَا۔","Da'if","Musannaf Ibn Abi Shaybah 28283","","","كتاب الديات"
"28284","(۲۸۲۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، عَنْ عَامِرٍ ؛ أَنَّ الْحَسَنَ بْنَ عَلِیٍّ أُتِیَ بِرَجُلَیْنِ قَتَلاَ ثَلاَثَۃً ، وَقَدْ جُرِحَ الرَّجُلاَنِ ، فَقَالَ الْحَسَنُ بْنُ عَلِیٍّ : عَلَی الرَّجُلَیْنِ دِیَۃُ الثَّلاَثَۃِ ، وَیُرْفَعُ عَنہُمَا جِرَاحَۃُ الرَّجُلَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 28284","","","كتاب الديات"
"28285","(۲۸۲۸۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، وَابْنِ أَبِی مُلَیْکَۃَ ، قَالاَ : لَوْ أَنَّ رَجُلاً قَتَلَ رَجُلاً ، وَجَرَحَ الْمَقْتُولُ الْقَاتِلَ جُرْحًا ، قُتِلَ الْقَاتِلُ ، وَوَدَی أَہْلُ الْمَقْتُولِ جُرْحَ الْقَاتِلِ۔","","Musannaf Ibn Abi Shaybah 28285","","","كتاب الديات"
"28286","(۲۸۲۸۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : وُجِدَ فِی بَیْتٍ قَتْلَی وَشِجَاجٌ ، فَجُعِلَ بَعْضَہُمْ بِبَعْضٍ۔","","Musannaf Ibn Abi Shaybah 28286","","","كتاب الديات"
"28287","(۲۸۲۸۷) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : خَرَجَ قَوْمٌ مِنْ زُرَارَۃَ فَاقْتَتَلُوا ، فَقَتَلَ بَعْضُہُمْ بَعْضًا، فَضَمَّنَ عَلِیٌّ دِیَۃَ الْمَقْتُولِینَ ، وَرَفَعَ عَنِ الْمَجْرُوحِینَ بِقَدْرِ جِرَاحَتِہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 28287","","","كتاب الديات"
"28288","(۲۸۲۸۸) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا کَانَ الْکَلْبُ فِی الدَّارِ ، فَأَذِنَ أَہْلُ الدَّارِ لِلرَّجُلِ فَدَخَلَ فَعَقَرَہُ ضَمِنُوا ، وَإِنْ دَخَلَ بِغَیْرِ إِذْنٍ ، فَعَقَرَہُ لَمْ یَضْمَنُوا۔","","Musannaf Ibn Abi Shaybah 28288","","","كتاب الديات"
"28289","(۲۸۲۸۹) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا زَکَرِیَّا، عَنْ عَامِرٍ، قَالَ: إِنْ عَقَرَ کَلْبُہُمْ خَارِجًا مِنْ دَارِہِمْ شِبْرًا فَمَا فَوْقَہُ ضَمِنُوا۔","","Musannaf Ibn Abi Shaybah 28289","","","كتاب الديات"
"28290","(۲۸۲۹۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّد بْن قَیْسٍ ، سَمِعَہُ مِنَ الشَّعْبِیِّ ، قَالَ ، إِذَا أَدْخَلَ الرَّجُلُ الرَّجُلَ دَارَہُ، فَہُوَ ضَامِنٌ لَہُ حَتَّی یُخْرِجَہُ کَمَا أَدْخَلَہُ۔","","Musannaf Ibn Abi Shaybah 28290","","","كتاب الديات"
"28291","(۲۸۲۹۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا دَخَلَ بِإِذْنِہِمْ فَعَقَرَہُ ضَمِنُوا ، وَإِنْ دَخَلَ بِغَیْرِ إِذْنِہِمْ ، فَعَقَرَہُ لَمْ یَضْمَنُوا۔","","Musannaf Ibn Abi Shaybah 28291","","","كتاب الديات"
"28292","(۲۸۲۹۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن طَارِقِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : کُنْتُ عندَ شُرَیْحٍ ، فَجَائَہُ سَائِلٌ قَدْ خُرِقَ جِرَابُہُ وَخُمِشَتْ سَاقُہُ ، فَقَالَ : إِنِّی دَخَلْتُ دَارَ قَوْمٍ فَعَقَرَنِی کَلْبُہُمْ ، فَقَالَ شُرَیْحٌ : إِنْ کَانَ أَذِنُوا لَکَ فَہُمْ ضَامِنُونَ ، وَإِلاَّ فَلاَ ضَمَانَ عَلَیْہِمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 28292","","","كتاب الديات"
"28293","(۲۸۲۹۳) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ؛ فِی الْکَلْبِ الْعَقُورِ ، قَالَ : لاَ یُضْمَنُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28293","","","كتاب الديات"
"28294","(۲۸۲۹۴) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ عَامِرٍ ، قَالَ : کَانَ یَقُولُ فِی الْکِلاَبِ إِذَا غَشِیَہَا الرَّجُلُ وَہِیَ مَعَ الْغَنَمِ فَعَقَرَتْہُ ، فَلَیْسَ عَلَیْہِ ضَمَانٌ ، وَإِنْ تَعَرَّضَتْ لِلنَّاسِ فِی الطَّرِیقِ فَأَصَابَتْ أَحَدًا ، فَعَلَیْہِ الضَّمَانُ۔","","Musannaf Ibn Abi Shaybah 28294","","","كتاب الديات"
"28295","(۲۸۲۹۵) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ أَشْعَثَ ، وَعَمْرٌو ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ قَوَدَ إِلاَّ بِالسَّیْفِ۔","Hasan","Musannaf Ibn Abi Shaybah 28295","","","كتاب الديات"
"28296","(۲۸۲۹۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ فِی الرَّجُلِ یَقْتُلُ الرَّجُلَ بِالْحَصَی ، أَوْ یُمَثِّلُ بِہِ ، قَالَ : إِنَّمَا الْقَوَدُ بِالسَّیْفِ ، لَمْ یَکُنْ مِنْ أَمْرِہِمُ الْمُثْلَۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28296","","","كتاب الديات"
"28297","(۲۸۲۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ قَوَدَ إِلاَّ بِحَدِیدَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 28297","","","كتاب الديات"
"28298","(۲۸۲۹۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ، عَنِ ابْنِ أَبِی عَرُوبَۃَ، عَنْ أَبِی مَعْشَرٍ، عَنْ إِبْرَاہِیمَ، قَالَ: لاَ قَوَدَ إِلاَّ بِحَدِیدَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 28298","","","كتاب الديات"
"28299","(۲۸۲۹۹) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ؛ مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28299","","","كتاب الديات"
"28300","(۲۸۳۰۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی الْعَبْدِ یَجْنِی الْجِنَایَاتِ ، قَالَ : یُدْفَعُ إِلَیْہِمْ ، فَیَقْتَسِمُونَہُ عَلَی قَدْرِ الْجِنَایَاتِ۔","","Musannaf Ibn Abi Shaybah 28300","","","كتاب الديات"
"28301","(۲۸۳۰۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنْ سُفْیَانَ ، عَنْ عَبْدِالْمَلِکِ ، عَنِ الشَّعْبِیِّ ؛ فِی عَبْدٍ شَجَّ رَجُلاً ، ثُمَّ شَجَّ آخَرَ، ثُمَّ شَجَّ آخَرَ ، فَقَضَی بِہِ لِلآخَرِ۔","","Musannaf Ibn Abi Shaybah 28301","","","كتاب الديات"
"28302","(۲۸۳۰۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَن حَمَّادٍ ، وَرَبِیعَۃَ ، قَالاَ : یَقْتَسِمُونَہُ بِالْحِصَصِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28302","","","كتاب الديات"
"28303","(۲۸۳۰۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن کَرَدْمِ ؛ أَنَّ رَجُلاً سَأَلَ ابْنَ عَبَّاسٍ ، وَأَبَا ہُرَیْرَۃَ ، وَابْنَ عُمَرَ عَنْ رَجُلٍ قَتَلَ مُؤْمِنًا ، فَہَلْ لَہُ مِنْ تَوْبَۃٍ ؟ فَکُلُّہُمْ قَالَ : یَسْتَطِیعُ أَنْ یُحْیِیَہُ ؟ یَسْتَطِیعُ أَنْ یَبْتَغِیَ نَفَقًا فِی الأَرْضِ ، أَوْ سُلَّمًا فِی السَّمَائِ ؟ یَسْتَطِیعُ أَنْ لاَ یَمُوتَ ؟۔","Da'if","Musannaf Ibn Abi Shaybah 28303","","","كتاب الديات"
"28304","(۲۸۳۰۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی نَصْرٍ ، وَیَحْیَی الْجَابِرِ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَتَاہُ رَجُلٌ ، فَقَالَ : یَا أَبَا عَبَّاسٍ ، أَرَأَیْتَ رَجُلاً قَتَلَ مُتَعَمِّدًا ، مَا جَزَاؤُہُ ؟ قَالَ : {جَزَاؤُہُ جَہَنَّمُ خَالِدًا فِیہَا وَغَضِبَ اللَّہُ عَلَیْہِ} الآیَۃَ ، قَالَ : أَرَأَیْتَ إِنْ تَابَ ، وَآمَنَ ، وَعَمِلَ عَمَلاً صَالِحًا ، ثُمَّ اہْتَدَی ؟ فَقَالَ : وَأَنَّی لَہُ التَّوْبَۃُ ، ثَکِلَتْک أُمُّک ؟ إِنَّہُ یَجِیئُ یَوْمَ الْقِیَامَۃِ آخِذًا بِرَأْسِہِ ، تَشْخَبُ أَوْدَاجُہُ حَتَّی یَقِفَ بِہِ عَندَ الْعَرْشِ ، فَیَقُولُ : یَا رَبِّ ، سَلْ ہَذَا فِیمَ قَتَلَنِی۔ (ترمذی ۳۰۲۹۔ احمد ۲۲۲)","Sahih","Musannaf Ibn Abi Shaybah 28304","","","كتاب الديات"
"28305","(۲۸۳۰۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُطَرِّفٍ ، عَنْ أَبِی السَّفَرِ ، عَن نَاجِیَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : ہُمَا الْمُبْہَمَتَانِ : الشِّرْکُ ، وَالْقَتْلُ۔","Hasan","Musannaf Ibn Abi Shaybah 28305","","","كتاب الديات"
"28306","(۲۸۳۰۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حُریثُ بْنُ السَّائِبِ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا نَازَلْتُ رَبِّی فِی شَیْئٍ ، مَا نَازَلْتُہُ فِی قَاتِلِ الْمُؤْمِنِ ، فَلَمْ یُجِبْنِی۔","Hasan","Musannaf Ibn Abi Shaybah 28306","","","كتاب الديات"
"28307","(۲۸۳۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن ہَارُونَ بْنِ سَعْدٍ ، عَنْ أَبِی الضُّحَی ، قَالَ : کُنْتُ مَعَ ابْنِ عُمَرَ فِی فُسْطَاطِہِ ، فَسَأَلَہُ رَجُلٌ عَنْ رَجُلٍ قَتَلَ مُؤْمِنًا مُتَعَمِّدًا ؟ قَالَ : فَقَرَأَ عَلَیْہِ ابْنُ عُمَرَ : {وَمَنْ یَقْتُلْ مُؤْمِنًا مُتَعَمِّدًا فَجَزَاؤُہُ جَہَنَّمُ خَالِدًا فِیہَا} الآیَۃِ ، فَانْظُرْ مَنْ قَتَلْتَ۔","Hasan","Musannaf Ibn Abi Shaybah 28307","","","كتاب الديات"
"28308","(۲۸۳۰۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سَلَمَۃُ بْنُ نُبَیْطٍ ، عَنِ الضَّحَّاکِ ، قَالَ : لَیْسَ لِقَاتِلِ الْمُؤْمِنِ تَوْبَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 28308","","","كتاب الديات"
"28309","(۲۸۳۰۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ أَبُو مُوسَی : مَا مِنْ خَصْمٍ یَوْمَ الْقِیَامَۃِ أَبْغَضُ إِلَیَّ مِنْ رَجُلٍ قَتَلْتُہُ ، تَشْخبُ أَوْدَاجُہُ دَمًا ، یَقُولُ : یَا رَبِّ ، سَلْ ہَذَا عَلاَمَ قَتَلَنِی ؟۔","Hasan","Musannaf Ibn Abi Shaybah 28309","","","كتاب الديات"
"28310","(۲۸۳۱۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سَلَمَۃُ بْنُ نُبَیْطٍ ، عَنِ الضَّحَّاکِ بْنِ مُزَاحِمٍ ، قَالَ : لأَنْ أَتُوبَ مِنَ الشِّرْکِ ، أَحَبَّ إِلَیَّ مِنْ أَنْ أَتُوبَ مِنْ قَتْلِ مُؤْمِنٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 28310","","","كتاب الديات"
"28311","(۲۸۳۱۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سَلَمَۃُ بْنُ نُبَیْطٍ ، عَنِ الضَّحَّاکِ ؛ (وَمَنْ یَقْتُلْ مُؤْمِنًا مُتَعَمِّدًا فَجَزَاؤُہُ جَہَنَّمُ خَالِدًا فِیہَا) قَالَ : مَا نَسَخَہَا شَیْئٌ مُنْذُ نَزَلَتْ۔","","Musannaf Ibn Abi Shaybah 28311","","","كتاب الديات"
"28312","(۲۸۳۱۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْمَاعِیلُ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَائِذٍ ، عَن عُقْبَۃَ بْنِ عَامِرٍ الْجُہَنِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ لَقِیَ اللَّہَ لاَ یُشْرِکُ بِہِ شَیْئًا ، لَمْ یَتَنَدَّ بِدَمٍ حَرَامٍ دَخَلَ الْجَنَّۃَ۔n(ابن ماجہ ۲۶۱۸۔ حاکم ۳۵۱)","","Musannaf Ibn Abi Shaybah 28312","","","كتاب الديات"
"28313","(۲۸۳۱۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إِبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ : لاَ یَزَالُ الرَّجُلُ فِی فُسْحَۃٍ مِنْ دِینِہِ مَا نَقِیَتْ کَفُّہُ مِنَ الدَّمِ ، فَإِذَا غَمَسَ یَدَہُ فِی دَمٍ حَرَامٍ نُزِعَ حَیَاؤُہُ۔","","Musannaf Ibn Abi Shaybah 28313","","","كتاب الديات"
"28314","(۲۸۳۱۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن شِمْرٍ ، عَن شَہْرِ بْنِ حَوْشَبٍ ، عنْ أَبِی الدَّرْدَائِ ، قَالَ : یَجِیئُ الْمَقْتُولُ یَوْمَ الْقِیَامَۃِ ، فَیُجْلِسُ عَلَی الْجَادَّۃِ ، فَإِذَا مَرَّ بِہِ الْقَاتِلُ قَامَ إِلَیْہِ فَأَخَذَ بِتَلْبِیبِہِ ، فَیَقُولُ : یَا رَبِّ ، سَلْ ہَذَا فِیمَ قَتَلَنِی ؟ قَالَ : فَیَقُولُ : أَمَرَنِی فُلاَن ، قَالَ : فَیُؤْخَذُ الْقَاتِلُ وَالآمِرُ فَیُلْقَیَانِ فِی النَّارِ۔","","Musannaf Ibn Abi Shaybah 28314","","","كتاب الديات"
"28315","(۲۸۳۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو الأَشْہَبِ ، قَالَ : سَمِعْتُ مُزَاحِمًا الضَّبِّیَّ یُحَدِّثُ الْحَسَنَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : بَیْنَمَا رَجُلٌ قَدْ سَقَی فِی حَوْضٍ لَہُ ، یَنْتَظِرُ ذَوْدًا تَرِدُ عَلَیْہِ ، إِذْ جَائَہُ رَجُلٌ رَاکِبٌ ظَمْآنُ مُطْمَئِنٌّ ، قَالَ : أَرِدْ ؟ قَالَ : لاَ ، قَالَ : فَتَنَحَّی ، فَعَقَلَ رَاحِلَتَہُ ، فَلَمَّا رَأَتِ الْمَائَ دَنَتْ مِنَ الْحَوْضِ ، فَفَجَّرَتِ الْحَوْضَ ، قَالَ : فَقَامَ صَاحِبُ الْحَوْضِ فَأَخَذَ سَیْفًا مِنْ عنقِہِ ، ثُمَّ ضَرَبَہ بِہِ حَتَّی قَتَلَہُ، قَالَ: فَخَرَجَ یَسْتَفْتِی، فَسَأَلَ رِجَالاً مِنْ أَصْحَابِ مُحَمَّدٍ ، لَسْتُ أُسَمِّیہِمْ ، وَکُلُّہُمْ یُؤَیِّسُہُ ، حَتَّی أَتَی رَجُلاً مِنْہُمْ ، فَقَالَ : ہَلْ تَسْتَطِیعُ أَنْ تُصْدِرَہُ کَمَا أَوْرَدْتَہُ ؟ قَالَ : لاَ ، قَالَ : فَہَلَ تَسْتَطِیعُ أَنْ تَبْتَغِیَ نَفَقًا فِی الأَرْضِ ، أَوْ سُلَّمًا فِی السَّمَائِ ؟ فَقَالَ : لاَ ، قَالَ : فَقَامَ الرَّجُلُ ، فَذَہَبَ غَیْرَ بَعِیدٍ ، فَدَعَاہُ فَرَدَّہُ ، فَقَالَ : ہَلْ لَکَ مِنْ وَالِدَیْنِ ؟ قَالَ : نَعَمْ ، أُمِّی حَیَّۃٌ ، قَالَ : احْمِلْہَا وَبِرَّہَا ، فَإِنْ دَخَلَ الاٰخَرُ النَّارَ ، فَأَبْعَدَ اللَّہُ مَنْ أَبْعَدَہُ۔","","Musannaf Ibn Abi Shaybah 28315","","","كتاب الديات"
"28316","(۲۸۳۱۶) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا سَلاَّمُ بْنُ مِسْکِینٍ ، قَالَ ، حَدَّثَنِی سُلَیْمَانُ بْنُ عَلِیٍّ ، عَنْ أَبِی سَعِیدٍ الخدری ، قَالَ : قِیلَ لَہُ فِی ہَذِہِ الآیَۃِ : {مَنْ قَتَلَ نَفْسًا بِغَیْرِ نَفْسٍ ، أَوْ فَسَادٍ فِی الأَرْضِ فَکَأَنَّمَا قَتَلَ النَّاسَ جَمِیعًا} ، أَہِیَ لنا کَمَا کَانَتْ لِبَنِی إِسْرَائِیلَ ؟ قَالَ : فَقَالَ : إِی ، وَالَّذِی لاَ إِلَہَ إِلاَّ ہُوَ۔","Hasan","Musannaf Ibn Abi Shaybah 28316","","","كتاب الديات"
"28317","(۲۸۳۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، قَالَ : لِقَاتِلِ الْمُؤْمِنِ تَوْبَۃٌ۔","","Musannaf Ibn Abi Shaybah 28317","","","كتاب الديات"
"28318","(۲۸۳۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن مَنْصُورٍ ، عَن مُجَاہِدٍ ، قَالَ : کَانَ یُقَالُ : تَوْبَۃُ الْقَاتِلِ إِذَا نَدِمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 28318","","","كتاب الديات"
"28319","(۲۸۳۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی حَصِینٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لاَ أَعْلَمُ لِقَاتِلِ الْمُؤْمِنِ تَوْبَۃً ، إِلاَّ الاِسْتِغْفَارُ۔","","Musannaf Ibn Abi Shaybah 28319","","","كتاب الديات"
"28320","(۲۸۳۲۰) حَدَّثَنَا الْفَضْلُ ، عَنِ الصَّبَّاحِ بْنِ ثَابِتٍ ، عَن عِکْرِمَۃَ ، قَالَ : لِلْقَاتِلِ تَوْبَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 28320","","","كتاب الديات"
"28321","(۲۸۳۲۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : جَائَ رَجُلٌ إِلَی عُمَرَ ، فَقَالَ : إِنِّی قَتَلْتُ ، فَہَلْ لِی مِنْ تَوْبَۃٍ ؟ قَالَ : نَعَمْ ، فَلاَ تَیْأَسْ ، وَقَرَأَ عَلَیْہِ مِنْ حم الْمُؤْمِنِ : {غَافِرِ الذَّنْبِ وَقَابِلِ التَّوْبِ شَدِیدِ الْعِقَابِ}۔","","Musannaf Ibn Abi Shaybah 28321","","","كتاب الديات"
"28322","(۲۸۳۲۲) حَدَّثَنَا ابْنُ سَعِیدٍ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ؛ {فَجَزَاؤُہُ جَہَنَّمُ}، قَالَ : ہِیَ جَزَاؤُہُ ، فَإِنْ شَائَ أَنْ یَتَجَاوَزَ عَنْ جَزَائِہِ فَعَلَ۔","No Data Available","Musannaf Ibn Abi Shaybah 28322","","","كتاب الديات"
"28323","(۲۸۳۲۳) حَدَّثَنَا عَمْرُو بْنُ مُحَمَّدٍ ، عَنْ شُعْبَۃَ ، عَنْ سَیَّارٍ ، عَنْ أَبِی صَالِحٍ ؛ نَحْوَہُ۔","","Musannaf Ibn Abi Shaybah 28323","","","كتاب الديات"
"28324","(۲۸۳۲۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَن زِیَادِ بْنِ أَبِی مَرْیَمَ ، عَنِ ابْنِ مَعْقِلٍ ، قَالَ لَہُ : أَسَمِعْتَ أَبَاک یَقُولُ : سَمِعْتُ عَبْدَ اللہِ یَقُولُ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : التَّوْبَۃُ نَدَمٌ ؟ قَالَ : نَعَمْ۔n(ابن ماجہ ۴۲۵۲۔ احمد ۳۷۶)","Sahih","Musannaf Ibn Abi Shaybah 28324","","","كتاب الديات"
"28325","(۲۸۳۲۵) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا سُفْیَانُ الثَّوْرِیُّ ، عَنْ عَبْدِ الْکَرِیمِ ، عَن زِیَادِ بْنِ أَبِی مَرْیَمَ ، عْن عَبْدِ اللہِ بْنِ مَعْقِلٍ ؛ أَنَّ أَبَاہُ مَعْقِلَ بْنَ مُقَرِّنٍ الْمُزَنِیَّ قَالَ لابْنِ مَسْعُودٍ : أَسَمِعْتَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : التَّوْبَۃُ نَدَمٌ ؟ قَالَ : نَعَمْ۔ (احمد ۴۳۳)","Sahih","Musannaf Ibn Abi Shaybah 28325","","","كتاب الديات"
"28326","(۲۸۳۲۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا أَبُو مَالِکٍ الأَشْجَعِیُّ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، قَالَ : جَائَ رَجُلٌ إِلَی ابْنِ عَبَّاسٍ فَقَالَ : لِمَنْ قَتَلَ مُؤْمِنًا تَوْبَۃٌ ؟ قَالَ : لاَ ، إِلاَّ النَّارُ ، فَلَمَّا ذَہَبَ قَالَ لَہُ جُلَسَاؤُہُ : مَا ہَکَذَا کُنْتَ تُفْتِینَا ، کُنْتَ تُفْتِینَا أَنَّ لِمَنْ قَتَلَ مُؤْمِنًا تَوْبَۃٌ مَقْبُولَۃٌ ، فَمَا بَالُ الْیَوْمِ ؟ قَالَ : إِنِّی أَحْسِبُہُ رَجُلاً مُغْضَبًا یُرِیدُ أَنْ یَقْتُلَ مُؤْمِنًا ، قَالَ : فَبَعَثُوا فِی أَثَرِہِ فَوَجَدُوہُ کَذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 28326","","","كتاب الديات"
"28327","(۲۸۳۲۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ نَظَرَ إِلَی الْکَعْبَۃِ ، فَقَالَ : مَا أَعْظَمَ حُرْمَتَکَ ، وَمَا أَعْظَمَ حَقَّک ، وَلَلْمُسْلِمُ أَعْظَمُ حُرْمَۃً مِنْکِ ، حَرَّمَ اللَّہُ مَالَہُ ، وَحَرَّمَ دَمَہُ ، وَحَرَّمَ عِرْضَہُ وَأَذَاہُ ، وَأَنْ یُظَنَّ بِہِ ظَنَّ سوئٍ۔","Da'if","Musannaf Ibn Abi Shaybah 28327","","","كتاب الديات"
"28328","(۲۸۳۲۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بِنْ عَمْرٍو ، قَالَ : قَتْلُ الْمُؤْمِنِ أَعْظَمُ عِنْدَ اللہِ مِنْ زَوَالِ الدُّنْیَا۔ (ترمذی ۱۳۹۵۔ نسائی ۳۴۴۹)","Sahih","Musannaf Ibn Abi Shaybah 28328","","","كتاب الديات"
"28329","(۲۸۳۲۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن خُصَیْفٍ ، عَن مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ {فَکَأَنَّمَا قَتَلَ النَّاسَ جَمِیعًا} ، قَالَ : مَنْ أَوْبَقَہَا ، {وَمَنْ أَحْیَاہَا فَکَأَنَّمَا أَحْیَا النَّاسَ جَمِیعًا} ، قَالَ : مَنْ کَفَّ عَن قَتْلِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 28329","","","كتاب الديات"
"28330","(۲۸۳۳۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن مَنْصُورٍ ، عَن مُجَاہِدٍ ؛ {وَمَنْ أَحْیَاہَا} ، قَالَ : مَنْ أَنْجَاہَا مِنْ غَرَقٍ ، أَوْ حَرْقٍ فَقَدْ أَحْیَاہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 28330","","","كتاب الديات"
"28331","(۲۸۳۳۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْعَلاَئُ بْنُ عَبْدِ الْکَرِیمِ ، قَالَ : سَمِعْتُ مُجَاہِدًا ، یَقُولُ : {وَمَنْ أَحْیَاہَا فَکَأَنَّمَا أَحْیَا النَّاسَ جَمِیعًا} ، قَالَ : مَنْ کَفَّ عَن قَتْلِہَا فَقَدْ أَحْیَاہَا۔","","Musannaf Ibn Abi Shaybah 28331","","","كتاب الديات"
"28332","(۲۸۳۳۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی الْمِقْدَامِ ، عَن حَبَّۃَ بْنِ جُوَیْنٍ الْحَضْرَمِیِّ ، عَنْ عَلِیٍّ ؛ {رَبَّنَا أَرِنَا اللَّذَیْنِ أَضَلاَّنَا مِنَ الْجِنِّ وَالإِنْسِ} ، ابْنَ آدَمَ الَّذِی قَتَلَ أَخَاہُ ، وَإِبْلِیسَ الأَبَالِسِ۔","Da'if","Musannaf Ibn Abi Shaybah 28332","","","كتاب الديات"
"28333","(۲۸۳۳۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ مَالِکِ بْنِ حُصَیْنٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، قَالَ : ابْنُ آدَمَ الَّذِی قَتَلَ أَخَاہُ وَإِبْلِیسُ۔","Da'if","Musannaf Ibn Abi Shaybah 28333","","","كتاب الديات"
"28334","(۲۸۳۳۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ ، عَن مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تُقْتَلُ نَفْسٌ ظُلْمًا ، إِلاَّ کَانَ عَلَی ابْنِ آدَمَ الأَوَّلِ کِفْلٌ مِنْ دَمِہَا ، لأَنَّہُ أَوَّلُ مَنْ سَنَّ الْقَتْلَ۔ (بخاری ۶۸۶۷۔ مسلم ۲۷)","Sahih","Musannaf Ibn Abi Shaybah 28334","","","كتاب الديات"
"28335","(۲۸۳۳۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْحَسَنُ بْنُ صَالِحٍ ، عَنْ إِبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : مَا مِنْ نَفْسٍ تُقْتَلُ ظُلْمًا ، إِلاَّ کَانَ عَلَی ابْنِ آدَمَ الأَوَّلِ وَالشَّیْطَانِ کِفْلٌ مِنْہَا۔","","Musannaf Ibn Abi Shaybah 28335","","","كتاب الديات"
"28336","(۲۸۳۳۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ لَیْثٍ ، عَن مُجَاہِدٍ ؛ {ظَہَرَ الْفَسَادُ فِی الْبَرِّ وَالْبَحْرِ بِمَا کَسَبَتْ أَیْدِی النَّاسِ}، قَالَ: فِی الْبَرِّ ابْنُ آدَمَ الَّذِی قَتَلَ أَخَاہُ، وَفِی الْبَحْرِ الَّذِی کَانَ یَأْخُذُ کُلَّ سَفِینَۃٍ غَصْبًا۔","","Musannaf Ibn Abi Shaybah 28336","","","كتاب الديات"
"28337","(۲۸۳۳۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہُشَیْمٌ ، عَنْ إِسْمَاعِیلَ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : مَنْ قَتَلَ رَجُلَیْنِ فَہُوَ جَبَّارٌ ، وَتَلاَ: {أَتُرِیدُ أَنْ تَقْتُلَنِی کَمَا قَتَلْت نَفْسًا بِالأَمْسِ، إِنْ تُرِیدُ إِلاَّ أَنْ تَکُونَ جَبَّارًا} الآیۃ۔","","Musannaf Ibn Abi Shaybah 28337","","","كتاب الديات"
"28338","(۲۸۳۳۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : مَا کَانَ مِنْ قَتْلٍ بِسِلاَحٍ عَمْدٍ ، فَفِیہِ الْقَوَدُ۔","","Musannaf Ibn Abi Shaybah 28338","","","كتاب الديات"
"28339","(۲۸۳۳۹) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ عَلِیٌّ : الْعَمْدُ کُلُّہُ قَوَدٌ۔","Da'if","Musannaf Ibn Abi Shaybah 28339","","","كتاب الديات"
"28340","(۲۸۳۴۰) حَدَّثَنَا عَبْدُالرَّحِیمِ، عَنْ أَشْعَثَ، عَنْ عَامِرٍ، وَالْحَسَنِ، وَابْنِ سِیرِینَ، وَعَمْرِو بْنِ دِینَارٍ، قَالُوا: الْعَمْدُ قَوَدٌ۔","","Musannaf Ibn Abi Shaybah 28340","","","كتاب الديات"
"28341","(۲۸۳۴۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ إِسْمَاعِیلَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَن طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْعَمْدُ قَوَدٌ ، إِلاَّ أَنْ یَعْفُوَ وَلِیُّ الْمَقْتُولِ۔ (ابوداؤد ۴۵۲۷۔ نسائی ۶۹۹۲)","Da'if","Musannaf Ibn Abi Shaybah 28341","","","كتاب الديات"
"28342","(۲۸۳۴۲) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، وَالْحَکَمِ ، وَحَمَّادٍ ، قَالُوا : مَا کَانَ مِنْ ضَرْبَۃٍ بِسَوْطٍ ، أَوْ عَصًا ، أَوْ حَجَرٍ ، فَکَانَ دُونَ النَّفْسِ ، فَہُوَ عَمْدٌ ، وَفِیہِ الْقَوَدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28342","","","كتاب الديات"
"28343","(۲۸۳۴۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إِذَا اجْتَمَعَ رَجُلٌ وَغُلاَمٌ عَلَی قَتْلِ رَجُلٍ ، قُتِلَ الرَّجُلُ ، وَعَلَی عَاقِلَۃِ الْغُلاَمِ الدِّیَۃُ کَامِلَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 28343","","","كتاب الديات"
"28344","(۲۸۳۴۴) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، قَالَ ، سُئِلَ حَمَّادٌ عَنْ رَجُلٍ وَصَبِیٍّ قَتَلاَ رَجُلاً عَمْدًا ؟ قَالَ : أَمَّا الرَّجُلُ یُقْتَلُ ، وَأَمَّا الصَّبِیُّ فَعَلَی أَوْلِیَائِہِ حِصَّتَۃُ مِنَ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 28344","","","كتاب الديات"
"28345","(۲۸۳۴۵) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ ، عَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا أَعَانَہُ مَنْ لاَ یُقَادُ بِہِ ، فَإِنَّمَا ہِیَ دِیَۃٌ۔","","Musannaf Ibn Abi Shaybah 28345","","","كتاب الديات"
"28346","(۲۸۳۴۶) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : إِذَا اجْتَمَعَ صَبِیٌّ وَعَبْدٌ عَلَی قَتْلٍ فَہِیَ دِیَۃٌ ، فَإِذَا اجْتَمَعَا ، فَضَرَبَ ہَذَا بِسَیْفٍ وَہَذَا بِعَصًا ، فَہِیَ دِیَۃٌ۔","","Musannaf Ibn Abi Shaybah 28346","","","كتاب الديات"
"28347","(۲۸۳۴۷) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخبَرَنَا ہِشَامٌ ، عَنِ الْحَسَنِ ؛ فِی الْقَوْمِ یَقْتُلُونَ عَمْدًا ، وَفِیہِمُ الصَّبِیُّ وَالْمَعْتُوہُ ، قَالَ ، ہِیَ دِیَۃُ خَطَأٍ عَلَی الْعَاقِلَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28347","","","كتاب الديات"
"28348","(۲۸۳۴۸) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ إِبْرَاہِیمَ (ح) وَعَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالا فِی رَجُلٍ قُتِلَ عَمْدًا ، فَحُبِسَ الْقَاتِلُ لِیُقَادَ بِالْمَقْتُولِ ، فَجَائَ رَجُلٌ فَقَتَلَ الْقَاتِلَ خَطَأً ، فقَالا : دِیَتُہُ لأَہْلِ الْمَحْبُوسِ ، وَقَالَ عَطَائٌ : لأَہْلِ الْمَقْتُولِ الأَوَّلِ۔","","Musannaf Ibn Abi Shaybah 28348","","","كتاب الديات"
"28349","(۲۸۳۴۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنْ الْحَسَنِ ، قَالَ : الدِّیَۃُ لأَہْلِ الْمَقْتُولِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28349","","","كتاب الديات"
"28350","(۲۸۳۵۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَمَّادٍ ، مِثْلَ قَوْلِ الْحَسَنِ۔","","Musannaf Ibn Abi Shaybah 28350","","","كتاب الديات"
"28351","(۲۸۳۵۱) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ قُتِلَ وَلَہُ وَلَدٌ صِغَارٌ ، قَالَ : ذَاکَ إِلَی أَوْلِیَائِہِ۔","","Musannaf Ibn Abi Shaybah 28351","","","كتاب الديات"
"28352","(۲۸۳۵۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، قَالَ : سَمِعْتُ حَمَّادًا یَقُولُ فِی رَجُلٍ قُتِلَ ، وَبَعْضُ أَوْلِیَائِہِ صِغَارٌ ، قَالَ : یَقْتُلُ أَوْلِیَاؤُہُ الْکِبَارُ إِنْ شَاؤُوا ، وَلاَ یَنْتَظِرُوا۔","","Musannaf Ibn Abi Shaybah 28352","","","كتاب الديات"
"28353","(۲۸۳۵۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حُسَیْنٍ ، عَنْ زَیْدٍ ، عَنْ بَعْضِ أَہْلِہِ ؛ أَنَّ الْحَسَنَ بْنَ عَلِیٍّ قَتَلَ ابْنَ مُلْجِمٍ الَّذِی قَتَلَ عَلِیًّا ، وَلَہُ وَلَدٌ صِغَارٌ۔","Da'if","Musannaf Ibn Abi Shaybah 28353","","","كتاب الديات"
"28354","(۲۸۳۵۴) حَدَّثَنَا قَبِیصَۃُ ، عَنْ سُفْیَانَ ، عَن خَالِدٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : یُسْتَأْنَی بِہِ حَتَّی یَکْبُرُوا۔","","Musannaf Ibn Abi Shaybah 28354","","","كتاب الديات"
"28355","(۲۸۳۵۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ حَجَّاجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَن نَافِعِ بْنِ عَبْدِ الْحَارِثِ ، قَالَ : کَتَبْتُ إِلَی عُمَرَ أَسْأَلُہُ عَنْ رَجُلٍ کُسِرَ أَحَدُ زَنْدَیْہِ ؟ فَکَتَبَ إِلَیَّ عُمَرُ : أَنَّ فِیہِ حِقَّتَیْنِ بَکْرَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 28355","","","كتاب الديات"
"28356","(۲۸۳۵۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، عَن زَیْدِ بْنِ ثَابِتٍ ، قَالَ : فِی السَّاعِدَیْنِ ، وَہُمَا الزَّنْدَانِ خَمْسُونَ دِینَارًا۔","Da'if","Musannaf Ibn Abi Shaybah 28356","","","كتاب الديات"
"28357","(۲۸۳۵۷) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ یُقْتَصُّ لِمَجْرُوحٍ حَتَّی تَبْرَأَ جِرَاحُہُ۔","","Musannaf Ibn Abi Shaybah 28357","","","كتاب الديات"
"28358","(۲۸۳۵۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یُقْتَصُّ مِنَ الْجَارِحِ حَتَّی یَبْرَأَ صَاحِبُ الْجُرْحِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28358","","","كتاب الديات"
"28359","(۲۸۳۵۹) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یُنْتَظَرُ بِالْقَوَدِ أَنْ یَبْرَأَ صَاحِبُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28359","","","كتاب الديات"
"28360","(۲۸۳۶۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ جَابِرٍ ؛ أَنَّ رَجُلاً طَعَنَ رَجُلاً بِقَرْنٍ فِی رُکْبَتِہِ ، فَأَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْتَقِیدُ ، فَقِیلَ لَہُ : حتَّی تَبْرَأَ ، فَأَبَی وَعَجَّلَ وَاسْتَقَادَ ، قَالَ : فَعَنِتَتْ رِجْلُہُ وَبَرِئَتْ رِجْلُ الْمُسْتَقَادِ مِنْہُ ، فَأَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : لَیْسَ لَکَ شَیْئٌ ، أَبَیْتَ۔n(دارقطنی ۸۹۔ احمد ۲۱۷)","Sahih","Musannaf Ibn Abi Shaybah 28360","","","كتاب الديات"
"28361","(۲۸۳۶۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، قَالَ: سَأَلْتُ الْحَکَمَ، وَحَمَّادًا عَنِ الرَّجُلِ یَأْمُرُ الرَّجُلَ یَقْتُلُ الرَّجُلَ؟ قَالاَ : یُقْتَلُ الْقَاتِلُ ، وَلَیْسَ عَلَی الآمِرِ قَوَدٌ۔","","Musannaf Ibn Abi Shaybah 28361","","","كتاب الديات"
"28362","(۲۸۳۶۲) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ فِی رَجُلٍ أَمَرَ عَبْدَہُ فَقَتَلَ رَجُلاً عَمْدًا؟ قَالَ: یُقْتَلُ الْعَبْدُ۔","","Musannaf Ibn Abi Shaybah 28362","","","كتاب الديات"
"28363","(۲۸۳۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی الرَّجُلِ یَأْمُرُ الرَّجُلَ فَیَقْتُلُ ، قَالَ : ہُمَا شَرِیکَانِ۔n قَالَ وَکِیعٌ : ہَذَا عَندَنَا فِی الإِثْمِ ، فَأَمَّا الْقَوَدُ فَإِنَّمَا ہُوَ عَلَی الْقَاتِلِ۔","","Musannaf Ibn Abi Shaybah 28363","","","كتاب الديات"
"28364","(۲۸۳۶۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَن مَنْصُورٍ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ عَن أَمِیرٍ أَمَرَ رَجُلاً فَقَتَلَ رَجُلاً ؟ قَالَ : ہُمَا شَرِیکَانِ فِی الإِثْمِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28364","","","كتاب الديات"
"28365","(۲۸۳۶۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سَلَمَۃُ بْنُ نُبَیْطٍ ، عَنِ الضَّحَّاکِ بْنِ مُزَاحِمٍ ؛ فِی السُّلْطَانِ یَأْمُرُ الرَّجُلَ یَقْتُلُ الرَّجُلَ ؟ فَقَالَ الضَّحَّاکُ : کُنْ أَنْتَ الْمَقْتُولُ۔","","Musannaf Ibn Abi Shaybah 28365","","","كتاب الديات"
"28366","(۲۸۳۶۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ؛ فِی الرَّجُلِ یَأْمُرُ عَبْدَہُ یَقْتُلُ الرَّجُلَ؟ قَالَ: یُقْتَلُ الرَّجُلُ۔","","Musannaf Ibn Abi Shaybah 28366","","","كتاب الديات"
"28367","(۲۸۳۶۷) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَن خِلاَسٍ ، عَنْ عَلِیٍّ ؛ فِی رَجُلٍ أَمَرَ عَبْدَہُ أَنْ یَقْتُلَ رَجُلاً ؟ قَالَ : إِنَّمَا ہُوَ بِمَنْزِلَۃِ سَوْطِہِ ، أَوْ سَیْفِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 28367","","","كتاب الديات"
"28368","(۲۸۳۶۸) حَدَّثَنَا عُمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ فِی الرَّجُلِ یَأْمُرُ عَبْدَہُ فَیَقْتُلُ رَجُلاً ، قَالَ : یُقْتَلُ الْمَوْلَی۔","","Musannaf Ibn Abi Shaybah 28368","","","كتاب الديات"
"28369","(۲۸۳۶۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنِ الْقَاسِمِ ، عَن عُبَیْدِ بْنِ عُمَیْرٍ ؛ أَنَّ رَجُلاً أَضَافَ إِنْسَانًا مِنْ ہُذَیْلٍ ، فَذَہَبَتْ جَارِیَۃٌ مِنْہُمْ تَحْتَطِبُ ، فَأَرَادَہَا عَلَی نَفْسِہَا ، فَرَمَتْہُ بِفِہْرٍ فَقَتَلَتْہُ ، فَرُفِعَ إِلَی عُمَرَ بْنِ الْخَطَّابِ ، قَالَ : ذَلِکَ قَتِیلُ اللہِ ، لاَ یُودَی أَبَدًا۔","Sahih","Musannaf Ibn Abi Shaybah 28369","","","كتاب الديات"
"28370","(۲۸۳۷۰) حَدَّثَنَا حَفْصٌ ، عَنْ مُحَمَّدِ بْنِ یُوسُفَ ، عَنِ السَّائِبِ بْنِ یَزِیدَ ؛ أَنَّ رَجُلاً أَرَادَ امْرَأَۃً عَلَی نَفْسِہَا ، فَرَفَعَتْ حَجَرًا فَقَتَلَتْہُ ، فَرُفِعَ ذَلِکَ إِلَی عُمَرَ ، فَقَالَ : ذَاکَ قَتِیلُ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 28370","","","كتاب الديات"
"28371","(۲۸۳۷۱) حَدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَن سُلَیْمَانَ بْنِ یَسَارٍ ؛ أَنَّ امْرَأَۃً بِالشَّامِ أَتَتِ الضَّحَّاکَ بْنَ قَیْسٍ ، فَذَکَرَتْ لَہُ أَنَّ إِنْسَانًا اسْتَفْتَحَ عَلَیْہَا بَابَہَا ، وَأَنَّہَا اسْتَغَاثَتْ فَلَمْ یُغِثْہَا أَحَدٌ ، وَکَانَ الشِّتَائُ ، فَفَتَحَتْ لَہُ الْبَابَ ، وَأَخَذَتْ رَحًی فَرَمَتْہُ بِہَا فَقَتَلَتْہُ ، فَبَعَثَ مَعَہَا ، وَإِذَا لِصٌّ مِنَ اللُّصُوصِ ، وَإِذَا مَعَہُ مَتَاعٌ فَأَبْطَلَ دَمَہُ۔","","Musannaf Ibn Abi Shaybah 28371","","","كتاب الديات"
"28372","(۲۸۳۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ إِسْمَاعِیلَ بْنِ أُمَیَّۃَ ، قَالَ : قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی رَجُلٍ أَمْسَکَ رَجُلاً وَقَتَلَہُ آخَرُ ، أَنْ یُقْتَلَ الْقَاتِلُ ، وَیُحْبَسَ الْمُمْسِکُ۔ (دارقطنی ۱۴۰۔ بیہقی ۵۰)","","Musannaf Ibn Abi Shaybah 28372","","","كتاب الديات"
"28373","(۲۸۳۷۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ عَلِیٍّ ؛ أَنَّہُ قَضَی بِقَتْلِ الْقَاتِلِ ، وَبِحَبْسِ الْمُمْسِکِ۔ (عبدالرزاق ۱۸۰۸۹)","Da'if","Musannaf Ibn Abi Shaybah 28373","","","كتاب الديات"
"28374","(۲۸۳۷۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنِ الرَّجُلِ یُمْسِکُ الرَّجُلَ ، وَیَقْتُلُہُ آخَرُ ؟ قَالاَ : یُقْتَلُ الْقَاتِلُ۔","","Musannaf Ibn Abi Shaybah 28374","","","كتاب الديات"
"28375","(۲۸۳۷۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سَمِعْتُ سُلَیْمَانَ بْنَ مُوسَی یَقُولُ : الاِجْتِمَاعُ فِینَا عَلَی الْمَقْتُولِ أَنْ یُمْسِکَ الرَّجُلَ ، وَیَضْرِبَہُ الآخَرُ ، فَہُمَا شَرِیکَانِ عَندَنَا فِی دَمِہِ ، یُقْتَلاَنِ جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 28375","","","كتاب الديات"
"28376","(۲۸۳۷۶) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ؛ أَنَّ عَلِیًّا أُتِیَ بِرَجُلَیْنِ قَتَلَ أَحَدُہُمَا، وَأَمْسَکَ الآخَرُ ، فَقَتَلَ الَّذِی قَتَلَ ، وَقَالَ لِلَّذِی أَمْسَکَ : أَمْسَکْتَہُ لِلْمَوْتِ ، فَأَنَا أَحْبِسُکَ فِی السِّجْنِ حَتَّی تَمُوتَ۔","","Musannaf Ibn Abi Shaybah 28376","","","كتاب الديات"
"28377","(۲۸۳۷۷) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ أَمَرَ أَنْ تُعْقَلَ الْمُوضِحَۃَ۔","","Musannaf Ibn Abi Shaybah 28377","","","كتاب الديات"
"28378","(۲۸۳۷۸) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عن رَجُلٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : لاَ تَعْقِلُ الْعَاقِلَۃُ ، إِلاَّ الثُّلُثُ فَمَا زَادَ۔","No Data Available","Musannaf Ibn Abi Shaybah 28378","","","كتاب الديات"
"28379","(۲۸۳۷۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عُمَرَ بْنِ عَبْدِ الرَّحْمَنِ السَّہْمِیِّ ، عَنْ رَجُلٍ ؛ أَنَّ رَجُلاً أَتَی عُمَرَ بْنَ الْخَطَّابِ فِی مُوضِحَۃٍ ؟ فَقَالَ : إِنَّا لاَ نَتَعَاقَلُ الْمُضَغَ بَیْنَنَا۔","Da'if","Musannaf Ibn Abi Shaybah 28379","","","كتاب الديات"
"28380","(۲۸۳۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِیسَی ، عَنِ الشَّعْبِیِّ ، قَالَ : لَیْسَ فِیمَا دُونَ الْمُوضِحَۃِ عَقْلٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 28380","","","كتاب الديات"
"28381","(۲۸۳۸۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : مَتَی یَبْلُغُ الْعَقْلُ أَنْ تَعْقِلَہُ الْعَاقِلَۃُ عَامَّۃً أَجْمَعُونَ، إِذَا بَلَغَ الثُّلُثَ؟ قَالَ: نَعَمْ، إِخَالُ، وَلاَ أَشُکَّ أَنَّہُ قَالَ: وَمَا لَمْ یَبْلُغِ الثُّلُثَ فَعَلَی قَوْمِ الرَّجُلِ خَاصَّۃً۔","","Musannaf Ibn Abi Shaybah 28381","","","كتاب الديات"
"28382","(۲۸۳۸۲) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ عَبْدِ اللہِ بْنِ مُؤَمِّلٍ ، قَالَ : حدَّثَنِی عُمَرُ بْنُ عَبْدِ الرَّحْمَنِ السَّہْمِیُّ ، عَنْ عَطَائِ بْنِ أَبِی رَبَاحٍ ، عَنْ أَبِی أُمَیَّۃَ الأَخْنَسِ ، قَالَ : کُنْتُ عِندَ عُمَرَ بْنِ الْخَطَّابِ جَالِسًا ، فَجَائَ رَجُلٌ مِنْ بَنِی غِفَارٍ ، فَقَالَ : إِنَّ ابْنِی شُجَّ ، فَقَالَ : إِنَّ ہَذِہِ الْمُضَغ لاَ یَتَعَاقَلُہَا أَہْلُ الْقُرَی۔","Da'if","Musannaf Ibn Abi Shaybah 28382","","","كتاب الديات"
"28383","حَدَّثَنَا أَبُو مُحَمَّدٍ عَبْدُاللہِ بْنُ یُونُسَ، قَالَ: حدَّثَنَا أَبُو عَبْدِالرَّحْمَنِ بَقِیُّ بْنُ مَخْلَدٍ، قَالَ: حدَّثَنَا أَبُو بَکْرٍ، قَالَ:n(۲۸۳۸۳) حَدَّثَنَا عَبْدُ الأَعْلَی بْنِ عَبْدِ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ الْقَسَامَۃَ کَانَتْ فِی الْجَاہِلِیَّۃِ ، فَأَقَرَّہَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی قَتِیلٍ مِنَ الأَنْصَارِ وُجِدَ فِی جُبٍّ لِلْیَہُودِ ، قَالَ: فَبَدَأَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْیَہُودِ ، فَکَلَّفَہُمْ قَسَامَۃً خَمْسِینَ ، فَقَالَتِ الْیَہُودُ : لَنْ نَحْلِفَ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِلأَنْصَارِ : أَفَتَحْلِفُونَ ؟ فَأَبَتِ الأَنْصَارُ أَنْ تَحْلِفَ ، فَأَغْرَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْیَہُودَ دِیَتَہُ ، لأَنَّہُ قُتِلَ بَیْنَ أَظْہُرِہِمْ۔ (مسلم ۱۲۹۵۔ نسائی ۶۹۱۱)","No Data Available","Musannaf Ibn Abi Shaybah 28383","","","كتاب الديات"
"28384","(۲۸۳۸۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : دَعَانِی عُمَرُ بْنُ عَبْدِ الْعَزِیزِ فَسَأَلَنِی عَنِ الْقَسَامَۃِ؟ فَقَالَ: قَدْ بَدَا لِی أَنْ أَرُدَّہَا ، إِنَّ الأَعْرَابِیَّ یَشْہَدُ ، وَالرَّجُلُ الْغَائِبُ یَجِیئُ فَیَشْہَدُ، فَقُلْتُ: یَا أَمِیرَ الْمُؤْمِنِینَ، إِنَّک لَنْ تَسْتَطِیعَ رَدَّہَا ، قَضَی بِہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالْخُلَفَائُ بَعْدَہُ۔","","Musannaf Ibn Abi Shaybah 28384","","","كتاب الديات"
"28385","(۲۸۳۸۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ، قَالَ: حدَّثَنَا سَعِیدٌ، عَنْ قَتَادَۃَ؛ أَنَّ سُلَیْمَانَ بْنَ یَسَارٍ حَدَّث؛ أَنَّ عُمَرَ بْنَ عَبْدِالْعَزِیزِ، قَالَ: مَا رَأَیْتُ مِثْلَ الْقَسَامَۃِ قَطُّ أُقَیِّدُ بِہَا ، وَاللَّہُ یَقُولُ : {وَأَشْہِدُوا ذَوَیْ عَدْلٍ مِنْکُمْ} ، وَقَالَتِ الأَسْبَاطُ: {وَمَا شَہِدْنَا إِلاَّ بِمَا عَلِمْنَا وَمَا کُنَّا لِلْغَیْبِ حَافِظِینَ} ، وَقَالَ اللَّہُ : {إِلاَّ مَنْ شَہِدَ بِالْحَقِّ وَہُمْ یَعْلَمُونَ}۔n وَقَالَ سُلَیْمَانُ بْنُ یَسَارٍ : الْقَسَامَۃُ حَقٌّ ، قَضَی بِہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، بَیْنَمَا الأَنْصَارُ عِندَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِذْ خَرَجَ رَجُلٌ مِنْہُمْ ، ثُمَّ خَرَجُوا مِنْ عِندِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَإِذَا ہُمْ بِصَاحِبِہِمْ یَتَشَحَّطُ فِی دَمِہِ ، فَرَجَعُوا إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالُوا : قَتَلَتْنَا الْیَہُودُ ، وَسَمَّوْا رَجُلاً مِنْہُمْ ، وَلَمْ تَکُنْ لَہُمْ بَیِّنَۃٌ ، فَقَالَ لَہُمْ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : شَاہِدَانِ مِنْ غَیْرِکُمْ حَتَّی أَدْفَعَہُ إِلَیْکُمْ بِرُمَّتِہِ ، فَلَمْ تَکُنْ لَہُمْ بَیِّنَۃٌ ، فَقَالَ : اسْتَحِقُّوا بِخَمْسینَ قَسَامَۃٍ أَدْفَعَہُ إِلَیْکُمْ بِرُمَّتِہِ ، فَقَالُوا : یَا رَسُولَ اللہِ ، إِنَّا نَکْرَہُ أَنْ نَحْلِفَ عَلَی غَیْبٍ ، فَأَرَادَ نَبِیُّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یَأْخُذَ قَسَامَۃَ الْیَہُودِ بِخَمْسِینَ مِنْہُمْ، فَقَالَتِ الأَنْصَارُ: یَا رَسُولَ اللہِ ، إِنَّ الْیَہُودَ لاَ یُبَالُونَ الْحَلِفَ، مَتَی مَا نَقْبَلُ ہَذَا مِنْہُمْ یَأْتُونَا عَلَی آخِرِنَا، فَوَدَاہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ عِندِہِ۔ (بیہقی ۱۶۳۷۱)","","Musannaf Ibn Abi Shaybah 28385","","","كتاب الديات"
"28386","(۲۸۳۸۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ؛ أَنَّ حُوَیِّصَۃَ ، وَمُحَیِّصَۃَ ابْنَیْ مَسْعُودٍ، وَعَبْدَ اللہِ ، وَعَبْدَ الرَّحْمَن ابْنَیْ فُلاَنٍ خَرَجُوا یَمْتَارُونَ بِخَیْبَرَ ، فَعُدِیَ عَلَی عَبْدِاللہِ ، فَقُتِلَ، قَالَ : فَذُکِر ذَلِکَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تُقْسِمُونَ بِخَمْسِین فَتَسْتَحِقُّونَ ، قَالُوا : یَا رَسُولَ اللہِ ، کَیْفَ نُقْسِمُ وَلَمْ نَشْہَدْ ؟ قَالَ : فَتُبَرِّئُکُمْ یَہُودُ ، یَعْنِی یَحْلِفُونَ ، قَالَ : فَقَالُوا : یَا رَسُولَ اللہِ ، إِذًا تَقْتُلُنَا الْیَہُودُ ، قَالَ : فَوَدَاہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ عِندِہِ۔n(ابن ماجہ ۲۶۷۸۔ نسائی ۶۹۲۲)n (۲۸۳۸۶ م) قَالَ أبو خالد : أَخْبَرَنِی یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ یَسَارٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ نَحْوَ ہَذَا ، إِلاَّ أَنَّہُ قَالَ : ذَہَبَ عَبْدُ الرَّحْمَنِ أَخُو الْمَقْتُولِ یَتَکَلَّمُ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْکُبْرَ الْکُبْرَ ، قَالَ: فَتَکَلَّمَ الْکُبْر ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تُقْسِمُونَ بِخَمْسِینَ یَمِینًا فَتَسْتَحِقُّونَ، أَوْ تُقْسِمُ لَکُمْ بِخَمْسِینَ ؟ قَالَ : فَقَالُوا : یَا رَسُولَ اللہِ ، کَیْفَ نَقْبَلُ أَیْمَانَ قَوْمٍ کُفَّارٍ ؟ قَالَ : فَوَدَاہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ عِندِہِ۔","","Musannaf Ibn Abi Shaybah 28386","","","كتاب الديات"
"28387","(۲۸۳۸۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : انْطَلَقَ رَجُلاَنِ مِنْ أَہْلِ الْکُوفَۃِ إِلَی عُمَرَ بْنِ الْخَطَّابِ ، فَوَجَدَاہُ قَدْ صَدَرَ عَنِ الْبَیْتِ عَامِدًا إِلَی مِنًی ، فَطَافَا بِالْبَیْتِ ، ثُمَّ أَدْرَکَاہُ فَقَصَّا عَلَیْہِ قِصَّتَہُمَا ، فَقَالاَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، إِنَّ ابْنَ عَمٍّ لَنَا قُتِلَ ، نَحْنُ إِلَیْہِ شَرَعٌ سَوَائٌ فِی الدَّمِ ، وَہُوَ سَاکِتٌ عَنہُمَا لاَ یَرْجِعُ إِلَیْہِمَا شَیْئًا ، حَتَّی نَاشَدَاہُ اللَّہَ فَحَمَلَ عَلَیْہِمَا ، ثُمَّ ذَکَّرَاہُ اللَّہَ فَکَفَّ عَنہُمَا ، ثُمَّ قَالَ عُمَرُ : وَیْلٌ لَنَا إِذَا لَمْ نُذَکَّرْ بِاللَّہِ ، وَوَیْلٌ لَنَا إِذَا لَمْ نَذْکُرِ اللَّہَ ، فِیکُمْ شَاہِدَانِ ذَوَا عَدْلٍ تَجِیئَانِ بِہِمَا عَلَی مَنْ قَتَلَہُ فَنُقِیدُکُمْ مِنْہُ ، وَإِلاَّ حَلَفَ مَنْ یَدْرَؤکُمْ بِاللَّہِ : مَا قَتَلْنَا ، وَلاَ عَلِمْنَا قَاتِلاً ، فَإِنْ نَکَلُوا حَلَفَ مِنْکُمْ خَمْسُونَ ، ثُمَّ کَانَتْ لَکُمُ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 28387","","","كتاب الديات"
"28388","(۲۸۳۸۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ؛ أَنَّ قَتِیلاً وُجِدَ فِی بَنِی سَلُولَ ، فَجَائَ الأَوْلِیَائُ فَأَبْرَؤُوا بَنِی سَلُولَ، وَادَّعُوا عَلَی حَیٍّ آخَرَ، وَأَتَوْا شُرَیْحًا بِبَنِی سَلُولَ، فَسَأَلَہُمُ الْبَیِّنَۃَ عَلَی الْمُدَّعَی عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 28388","","","كتاب الديات"
"28389","(۲۸۳۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا وُجِدَ قَتِیلٌ فِی حَیٍّ ، أُخِذَ مِنْہُم خَمْسُونَ رَجُلاً فِیہِمُ الْمُدَّعَی عَلَیْہِ، وَإِنْ کَانُوا أَقَلَّ مِنْ خَمْسِینَ رُدَّتْ عَلَیْہِمُ الأَیْمَانُ، الأَوَّلُ فَالأَوَّلُ۔","","Musannaf Ibn Abi Shaybah 28389","","","كتاب الديات"
"28390","(۲۸۳۹۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ بْنِ الأَزْمَعِ ، قَالَ : وُجِدَ قَتِیلٌ بِالْیَمَنِ بَیْنَ وَادِعَۃَ وَأَرْحَبَ ، فَکَتَبَ عَامِلُ عُمَرَ بْنِ الْخَطَّابِ إِلَیْہِ ، فَکَتَبَ إِلَیْہِ عُمَرُ : أَنْ قِسْ مَا بَیْنَ الْحَیَّیْنِ، فَإِلَی أَیِّہِمَا کَانَ أَقْرَبَ فَخُذْہُمْ بِہِ ، قَالَ : فَقَاسُوا ، فَوَجَدُوہُ أَقْرَبَ إِلَی وَادِعَۃَ ، قَالَ : فَأَخَذْنَا، وَأَغْرَمْنَا ، وَأَحْلَفْنَا ، فَقُلْنَا : یَا أَمِیرَ الْمُؤْمِنِینَ ، أَتُحَلِّفُنَا وَتُغَرِّمُنَا ؟ قَالَ : نَعَمْ ، قَالَ : فَأَحْلَفَ مِنَّا خَمْسِینَ رَجُلاً بِاللَّہِ مَا فَعَلْتُ ، وَلاَ عَلِمْتُ قَاتِلاً۔","Da'if","Musannaf Ibn Abi Shaybah 28390","","","كتاب الديات"
"28391","(۲۸۳۹۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ؛ أَنَّ قَتِیلاً وُجِدَ بِالْیَمَنِ بَیْنَ حَیَّیْنِ ، قَالَ : فَقَالَ عُمَرُ : انْظُرُوا أَقْرَبَ الْحَیَّیْنِ إِلَیْہِ ، فَأَحْلِفُوا مِنْہُمْ خَمْسِینَ رَجُلاً بِاللَّہِ مَا قَتَلْنَا ، وَلاَ عَلِمْنَا قَاتِلاً ، ثُمَّ یَکُونُ عَلَیْہِمُ الدِّیَۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 28391","","","كتاب الديات"
"28392","(۲۸۳۹۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ؛ أَنَّ الزُّہْرِیِّ سُئِلَ عَن قَتِیلٍ وُجِدَ فِی دَارِ رَجُلٍ ، فَقَالَ رَبُّ الدَّارِ : إِنَّہُ طَرَقَنِی لِیَسْرِقَنِی فَقَتَلْتہ ، وَقَالَ أَہْلُ الْقَتِیلِ : إِنَّہُ دَعَاہُ إِلَی بَیْتِہِ فَقَتَلَہُ ، فَقَالَ : إِنْ أَقْسَمَ مِنْ أَہْلِ الْقَتِیلِ خَمْسُونَ أَنَّہُ دَعَاہُ فَقَتَلَہُ ، أُقِیدَ بِہِ ، وَإِنْ نَکَلُوا غَرِمُوا الدِّیَۃَ ، قَالَ الزُّہْرِیُّ : فَقَضَی ابْنُ عَفَّانَ فِی قَتِیلٍ مِنْ بَنِی بَاقِرِۃِ أَبَی أَوْلِیَاؤُہُ أَنْ یَحْلِفُوا ، فَأَغْرَمَہُم عُثْمَانُ الدِّیَۃَ۔","","Musannaf Ibn Abi Shaybah 28392","","","كتاب الديات"
"28393","(۲۸۳۹۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الْقَتِیلِ یُؤْخَذُ غِیلَۃً ، قَالَ : یُقْسِمُ مِنَ الْمُدَّعَی عَلَیْہِمْ خَمْسُونَ خَمْسِینَ یَمِینًا : مَا قَتَلْنَا ، وَلاَ عَلِمْنَا قَاتِلاً ، فَإِنْ حَلَفُوا فَقَدْ بَرِئُوا ، وَإِنْ نَکَلُوا أَقْسَمَ مِنَ الْمُدَّعِینَ خَمْسُونَ : أَنَّ دَمَنَا قِبَلَکُمْ ، ثُمَّ یُودَی۔","","Musannaf Ibn Abi Shaybah 28393","","","كتاب الديات"
"28394","(۲۸۳۹۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ فِی الْقَسَامَۃِ : لَمْ یَزَلْ یُعْمَلُ بِہَا فِی الْجَاہِلِیَّۃِ وَالإِسْلاَمِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28394","","","كتاب الديات"
"28395","(۲۸۳۹۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سَعِیدِ بْنِ عُبَیْدٍ ، عَن بُشَیْرِ بْنِ یَسَارٍ ؛ زَعَمَ أَنَّ رَجُلاً مِنَ الأَنْصَارِ یُقَالُ لَہُ: سَہْلُ بْنُ أَبِی حَثْمَۃَ أَخْبَرَہُ ؛ أَنَّ نَفَرًا مِنْ قَوْمِہِ انْطَلَقُوا إِلَی خَیْبَرَ ، فَتَفَرَّقُوا فِیہَا ، فَوَجَدُوا أَحَدَہُمْ قَتِیلاً ، فَقَالُوا لِلَّذِینَ وَجَدُوہُ عِنْدَہُمْ : قَتَلْتُمْ صَاحِبَنَا ، قَالُوا : مَا قَتَلْنَا ، وَلاَ عَلِمْنَا ، فَانْطَلَقُوا إِلَی نَبِیِّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالُوا : یَا نَبِیَّ اللہِ ، انْطَلَقْنَا إِلَی خَیْبَرَ فَوَجَدْنَا أَحَدَنَا قَتِیلاً ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: الْکُبْرَ الْکُبْرَ، فَقَالَ لَہُمْ: تَأْتُونَ بِالْبَیِّنَۃِ عَلَی مَنْ قَتَلَ ، فَقَالُوا : مَا لَنَا بَیِّنَۃٌ ، قَالَ : فَیَحْلِفُونَ لَکُمْ ، قَالُوا: لاَ نَرْضَی بِأَیْمَانِ الْیَہُودِ ، فَکَرِہَ نَبِیُّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُبْطِلَ دَمَہُ ، فَوَدَاہُ بِمِئَۃٍ مِنْ إِبِلِ الصَّدَقَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 28395","","","كتاب الديات"
"28396","(۲۸۳۹۶) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی الْقَسَامَۃِ أَنَّ الْیَمِینَ عَلَی الْمُدَّعَی عَلَیْہِمْ۔ (بخاری ۶۸۹۸)","","Musannaf Ibn Abi Shaybah 28396","","","كتاب الديات"
"28397","(۲۸۳۹۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عُبَیْدُ اللہِ بْنُ عُمَرَ ، أَنَّہُ سَمِعَ أَصْحَابًا لَہُمْ یُحَدِّثُونَ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ بَدَّأَ الْمُدَّعَی عَلَیْہِمْ بِالْیَمِینِ ، ثُمَّ ضَمَّنَہُمُ الْعَقْلَ۔","","Musannaf Ibn Abi Shaybah 28397","","","كتاب الديات"
"28398","(۲۸۳۹۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَن مُطِیعٍ ، عَن فُضَیْلِ بْنِ عَمْرٍو ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ قَضَی بِالْقَسَامَۃِ عَلَی الْمُدَّعَی عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 28398","","","كتاب الديات"
"28399","(۲۸۳۹۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّہُ کَانَ یَرَی الْقَسَامَۃَ عَلَی الْمُدَّعَی عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 28399","","","كتاب الديات"
"28400","(۲۸۴۰۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ؛ قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْقَسَامَۃِ عَلَی الْمُدَّعَی عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 28400","","","كتاب الديات"
"28401","(۲۸۴۰۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لابْنِ شِہَابٍ : الْقَسَامَۃُ فِی الدَّمِ عَلَی الْعِلْمِ ، أَمْ عَلَی الْبَتَّۃِ ؟ قَالَ : عَلَی الْبَتَّۃِ۔","","Musannaf Ibn Abi Shaybah 28401","","","كتاب الديات"
"28402","(۲۸۴۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ؛ أَنَّہُ قَالَ فِی الْقَسَامَۃِ : أُؤَثّمہُمْ وَأَنَا أَعْلَمُ ، یَعْنِی أَسْتَحْلِفُہُمْ : مَا قَتَلْنَا ، وَلاَ عَلِمْنَا قَاتِلاً۔","No Data Available","Musannaf Ibn Abi Shaybah 28402","","","كتاب الديات"
"28403","(۲۸۴۰۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یُسْتَحْلفُ کُلُّ رَجُلٍ مِنْہُمْ بِاللَّہِ: مَا قَتَلْتُ ، وَلاَ عَلِمْتُ قَاتِلاً ، ثُمَّ یَدِیہِ۔","","Musannaf Ibn Abi Shaybah 28403","","","كتاب الديات"
"28404","(۲۸۴۰۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : وُجِدَ قَتِیلٌ بِالْیَمَنِ فِی وَادِعَۃَ ، فَرُفِعَ إِلَی عُمَرَ فَأَحْلَفَہُمْ بِخَمْسِینَ : مَا قَتَلْنَا ، وَلاَ عَلِمْنَا قَاتِلاً ، ثُمَّ وَدَاہُ۔","","Musannaf Ibn Abi Shaybah 28404","","","كتاب الديات"
"28405","(۲۸۴۰۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، قَالَ: یُسْتَحْلفُ عَنِ الْقَسَامَۃِ بِاللَّہِ: مَا قَتَلْنَا، وَلاَ عَلِمْنَا قَاتِلاً۔","No Data Available","Musannaf Ibn Abi Shaybah 28405","","","كتاب الديات"
"28406","(۲۸۴۰۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ؛ أَنَّ شُرَیْحًا اسْتَحْلَفَہُمْ بِاللَّہِ : مَا قَتَلْنَا ، وَلاَ عَلِمْنَا قَاتِلاً۔","No Data Available","Musannaf Ibn Abi Shaybah 28406","","","كتاب الديات"
"28407","(۲۸۴۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ، وَابْنَ الزُّبَیْرِ أَقَادَا بِالْقَسَامَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 28407","","","كتاب الديات"
"28408","(۲۸۴۰۸) حَدَّثَنَا عَبْد الأَعَلَی ، عَنْ مَعْمَر ، عَنِ الزہری ؛ أَنَّہُ کَانَ یَقُولُ : إِنَّ الْقَسَامَۃ یُقَادُ بِہَا۔","","Musannaf Ibn Abi Shaybah 28408","","","كتاب الديات"
"28409","(۲۸۴۰۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنِ الْقَاسِمِ ، قَالَ : قَالَ عُمَرُ : إِنَّ الْقَسَامَۃَ إِنَّمَا تُوجِبُ الْعَقْلَ، وَلاَ تُشِیطُ الدَّمَ۔","","Musannaf Ibn Abi Shaybah 28409","","","كتاب الديات"
"28410","(۲۸۴۱۰) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ أَنَّ أَبَا بَکْرٍ ، وَعُمَرَ ، وَالْجَمَاعَۃَ الأُولَی لَمْ یَکُونُوا یَقْتُلُونَ بِالْقَسَامَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 28410","","","كتاب الديات"
"28411","(۲۸۴۱۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنْ فُضَیْلٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : الْقَوَدُ بِالْقَسَامَۃِ جَوْرٌ۔","","Musannaf Ibn Abi Shaybah 28411","","","كتاب الديات"
"28412","(۲۸۴۱۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ، قَالَ: حدَّثَنَا سَعِیدٌ، عَنْ قَتَادَۃَ، قَالَ: الْقَسَامَۃُ یَسْتَحِقُّونَ بِہَا الدِّیَۃَ، وَلاَ یُقَادُ بِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 28412","","","كتاب الديات"
"28413","(۲۸۴۱۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، قَالَ : حَدَّثَنَا أَبُو مَعْشَرٍ ، عَنِ النَّخَعِیّ ،ِ قَالَ : الْقَسَامَۃُ یُسْتَحَقُّ بِہَا الدِّیَۃُ ، وَلاَ یُقَادُ بِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 28413","","","كتاب الديات"
"28414","(۲۸۴۱۴) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ یُقْتَلُ بِالْقَسَامَۃِ إِلاَّ وَاحِدٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 28414","","","كتاب الديات"
"28415","(۲۸۴۱۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ حَجَّاجِ بْنِ أَبِی عُثْمَانَ، قَالَ: حدَّثَنِی أَبُو رَجَاء مَوْلَی أَبِی قِلاَبَۃَ، عَنْ أَبِی قِلاَبَۃَ؛ أَنَّ عُمَرَ بْنَ عَبْدِالْعَزِیزِ أَبْرَزَ سَرِیرَہُ یَوْمًا لِلنَّاسِ، ثُمَّ أَذِنَ لَہُمْ فَدَخَلُوا عَلَیْہِ، فَقَالَ: مَا تَقُولُونَ فِی الْقَسَامَۃِ؟ فَأَضَبَّ النَّاسُ، فَقَالُوا: نَقُولُ الْقَسَامَۃُ الْقَوَدُ بِہَا حَقٌّ، وَقَدْ أَقَادَتْ بِہَا الْخُلَفَائُ۔ (بخاری ۶۸۹۹۔ ابوداؤد ۲۷۳)","","Musannaf Ibn Abi Shaybah 28415","","","كتاب الديات"
"28416","(۲۸۴۱۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَن سُلَیْمَانَ بْنِ یَسَارٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : شَاہِدَانِ مِنْ غَیْرِکُمْ۔ (ابوداؤد ۴۵۱۳)","","Musannaf Ibn Abi Shaybah 28416","","","كتاب الديات"
"28417","(۲۸۴۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنِ الْقَاسِمِ ، قَالَ : انْطَلَقَ رَجُلاَنِ مِنْ أَہْلِ الْکُوفَۃِ إِلَی عُمَرَ بْنِ الْخَطَّابِ ، فَوَجَدَاہُ قَدْ صَدَرَ عَنِ الْبَیْتِ ، فَقَالاَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، إِنَّ ابْنَ عَمٍّ لَنَا قُتِلَ وَنَحْنُ إِلَیْہِ شَرَعٌ سَوَائٌ فِی الدَّمِ ، وَہُوَ سَاکِتٌ عَنہُمَا ، قَالَ : شَاہِدَانِ ذَوَا عَدْلٍ تَجِیئَانِ بِہِ عَلَی مَنْ قَتَلَہُ ، فَنُقِیدُکُمْ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 28417","","","كتاب الديات"
"28418","(۲۸۴۱۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنْ فُضَیْلٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : شَاہِدَانِ عَلَی الدَّمِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28418","","","كتاب الديات"
"28419","(۲۸۴۱۹) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یَجُوزُ فِی الْقَوَدِ إِلاَّ شَہَادَۃُ أَرْبَعَۃٍ۔","","Musannaf Ibn Abi Shaybah 28419","","","كتاب الديات"
"28420","(۲۸۴۲۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : شَاہِدَانِ۔","","Musannaf Ibn Abi Shaybah 28420","","","كتاب الديات"
"28421","(۲۸۴۲۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا لَمْ تَبْلُغِ الْقَسَامَۃُ ، کَرَّرُوا حَتَّی یَحْلِفُوا خَمْسِینَ یَمِینًا۔","No Data Available","Musannaf Ibn Abi Shaybah 28421","","","كتاب الديات"
"28422","(۲۸۴۲۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ، قَالَ : جَائَتْ قَسَامَۃٌ فَلَمْ یُوفُوا خَمْسِینَ ، فَرَدَّدَ عَلَیْہِم الْقَسَامَۃَ حَتَّی أَوْفَوْا۔","No Data Available","Musannaf Ibn Abi Shaybah 28422","","","كتاب الديات"
"28423","(۲۸۴۲۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ، قَالَ : إِذَا کَانُوا أَقَلَّ مِنْ خَمْسِینَ ، رُدِّدَتْ عَلَیْہِم الأَیْمَانُ۔","","Musannaf Ibn Abi Shaybah 28423","","","كتاب الديات"
"28424","(۲۸۴۲۴) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ الْہُذَلِیِّ، عَنْ أَبِی مَلِیحٍ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ رَدَّدَ عَلَیْہِم الأَیْمَانُ۔","Da'if","Musannaf Ibn Abi Shaybah 28424","","","كتاب الديات"
"28425","(۲۸۴۲۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا کَانُوا أَقَلَّ مِنْ خَمْسِینَ رُدِّدَتْ عَلَیْہِم الأَیْمَانُ ، الأَوَّلُ فَالأَوَّلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28425","","","كتاب الديات"
"28426","(۲۸۴۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی الزِّنَادِ ، عَنْ أَبِیہِ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ؛ أَنَّہُ رَدَّدَ الأَیْمَانَ عَلَی سَبْعَۃِ نَفَرٍ فِی الْقَسَامَۃِ ، أَحَدُہُمْ خَالِی۔","","Musannaf Ibn Abi Shaybah 28426","","","كتاب الديات"
"28427","(۲۸۴۲۷) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ، قَالَ: إِذَا نَقَصَ مِنَ الْخَمْسِینَ فِی الْقَسَامَۃِ رَجُلٌ، لَمْ نُجِزْہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 28427","","","كتاب الديات"
"28428","(۲۸۴۲۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ، عَنِ ابْنِ جُرَیْجٍ، عَنِ ابْنِ شِہَابٍ، قَالَ: أَمَّا الَّذِی عَلَیْہِ النَّاسُ الْیَوْمَ فَتَرْدِیدُ الأَیْمَانِ۔","","Musannaf Ibn Abi Shaybah 28428","","","كتاب الديات"
"28429","(۲۸۴۲۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ أَبِی جَعْفَرٍ ؛ أَنَّ عَلِیًّا کَانَ إِذَا وُجِدَ الْقَتِیل بَیْنَ الْقَرْیَتَیْنِ ، قَاسَ مَا بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 28429","","","كتاب الديات"
"28430","(۲۸۴۳۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : قُتِلَ قَتِیلٌ بَیْنَ حَیَّیْنِ مِنْ ہَمْدَانَ ، بَیْنَ وَادِعَۃَ وَخَیْوَانَ ، فَبَعَثَ مَعَہُمْ عُمَرُ الْمُغِیرَۃَ بْنَ شُعْبَۃَ ، فَقَالَ : انْطَلِقْ مَعَہُمْ فَقِسْ مَا بَیْنَ الْقَرْیَتَیْنِ ، فَأَیَّتُہُمَا کَانَتْ أَقْرَبَ فَأَلْحِقْ بِہِمُ الْقَتِیلَ۔","Da'if","Musannaf Ibn Abi Shaybah 28430","","","كتاب الديات"
"28431","(۲۸۴۳۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ بْنِ الأَزْمَعِ ، قَالَ : وُجِدَ قَتِیلٌ بِالْیَمَنِ بَیْنَ وَادِعَۃَ وَأَرْحَبَ ، فَکَتَبَ عَامِلُ عُمَرَ إِلَیْہِ ، فَکَتَبَ إِلَیْہِ عُمَرُ : أَنْ قِسْ مَا بَیْنَ الْحَیَّیْنِ ، فَإِلَی أَیِّہِمَا کَانَ أَقْرَبَ فَخُذْہُمْ بِہِ۔","","Musannaf Ibn Abi Shaybah 28431","","","كتاب الديات"
"28432","(۲۸۴۳۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یَحْیَی بْنِ أَبِی إِسْحَاقَ ، قَالَ : سَمِعْتُ سَالِمَ بْنَ عَبْدِ اللہِ ، یَقُولُ : وَقَدْ تَیَسَّرَ قَوْمٌ مِنْ بَنِی لَیْثٍ لِیَحْلِفُوا الْغَدَ فِی الْقَسَامَۃِ ، فَقَالَ : یَالِعِبَادَ اللہِ ، لَقَوْمٌ یَحْلِفُونَ عَلَی مَا لَمْ یَرَوْہُ ، وَلَمْ یَحْضُرُوہُ ، وَلَمْ یَشْہَدُوہُ ، وَلَوْ کَانَ لِی ، أَوْ إِلَیَّ مِنَ الأَمْرِ شَیْئٌ لَعَاقَبْتُہُمْ ، أَوْ لَنَکَلْتُہُمْ ، أَوْ لَجَعَلْتُہُمْ نَکَالاً، وَمَا قَبِلْتُ لَہُمْ شَہَادَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 28432","","","كتاب الديات"
"28433","(۲۸۴۳۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ حَجَّاجِ بْنِ أَبِی عُثْمَانَ، قَالَ: حدَّثَنَی أَبُو رَجَائٍ ، مَوْلَی أَبِی قِلاَبَۃَ ، عَنْ أَبِی قِلاَبَۃَ؛ أَنَّ عُمَرَ بْنَ عَبْدِالْعَزِیزِ أَبْرَزَ سَرِیرَہُ یَوْمًا لِلنَّاسِ ، ثُمَّ أَذِنَ لَہُمْ فَدَخَلُوا عَلَیْہِ ، فَقَالَ : مَا تَقُولُونَ فِی الْقَسَامَۃِ؟ فَأَضَبَّ النَّاسُ ، فَقَالُوا : نَقُولُ : الْقَسَامَۃُ الْقَوَدُ بِہَا حَقٌّ ، وَقَدْ أَقَادَتْ بِہَا الْخُلَفَائُ ، فَقَالَ : مَا تَقُولُ یَا أَبَا قِلاَبَۃَ ؟ وَنَصَبَنِی لِلنَّاسِ ، قُلْتُ : یَا أَمِیرَ الْمُؤْمِنِینَ ، عِنْدَکَ أَشْرَافُ الْعَرَبِ وَرُؤُوسُ الأَجْنَادِ ، أَرَأَیْتَ لَوْ أَنَّ خَمْسِینَ مِنْہُمْ شَہِدُوا عَلَی رَجُلٍ بِحِمْصٍ أَنَّہُ قَدْ سَرَقَ وَلَمْ یَرَوْہُ ، أَکُنْت تَقْطَعُہُ ؟ قَالَ : لاَ ، قُلْتُ : وَمَا قَتَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَحَدًا قَطُّ ، إِلاَّ فِی إِحْدَی ثَلاَثِ خِصَالٍ : رَجُلٍ یُقْتَلُ بِجَرِیرَۃِ نَفْسِہِ ، أَوْ رَجُلٍ زَنَی بَعْدَ إِحْصَانِہِ ، أَوْ رَجُلٍ حَارَبَ اللَّہَ وَرَسُولَہُ وَارْتَدَّ عَنِ الإِسْلاَمِ۔","","Musannaf Ibn Abi Shaybah 28433","","","كتاب الديات"
"28434","(۲۸۴۳۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنْ عَطَائٍ ؛ أَنَّ النَّاسَ أُجْلُوا عَن قَتِیلٍ فِی الطَّوَافِ ، فَوَدَاہُ مِنْ بَیْتِ الْمَالِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28434","","","كتاب الديات"
"28435","(۲۸۴۳۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حد??َثَنَا وَہْبُ بْنُ عُقْبَۃَ ، وَمُسْلِمُ بْنُ یَزِیدَ بْنِ مَذْکُورٍ ، سَمِعَاہُ مِنْ یَزِیدَ بْنِ مَذْکُورٍ؛ أَنَّ النَّاسَ ازْدَحَمُوا فِی الْمَسْجِدِ الْجَامِعِ بِالْکُوفَۃِ یَوْمَ الْجُمُعَۃِ ، فَأَفْرَجُوا عَن قَتِیلٍ ، فَوَدَاہُ عَلِیُّ بْنُ أَبِی طَالِبٍ مِنْ بَیْتِ الْمَالِ۔","Da'if","Musannaf Ibn Abi Shaybah 28435","","","كتاب الديات"
"28436","(۲۸۴۳۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّ رَجُلاً قُتِلَ فِی الطَّوَافِ ، فَاسْتَشَارَ عُمَرُ النَّاسَ ، فَقَالَ عَلِیٌّ : دِیَتُہُ عَلَی الْمُسْلِمِینَ ، أَوْ فِی بَیْتِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 28436","","","كتاب الديات"
"28437","(۲۸۴۳۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ، قَالَ: أَتَی حَجَرٌ عَائِرٌ فِی إِمْرَۃِ مَرْوَانَ ، فَأَصَابَ ابْنَ نِسْطَاسٍ بن عَامِرِ بْنِ عَبْدِ اللہِ بْنِ نِسْطَاسٍ ، لاَ یُعْلَمُ مَنْ صَاحِبُہُ فَقَتَلَہُ ، فَضَرَبَ مَرْوَانُ دِیَتَہُ عَلَی النَّاسِ۔","","Musannaf Ibn Abi Shaybah 28437","","","كتاب الديات"
"28438","(۲۸۴۳۸) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی قَوْمٍ تَنَاضَلُوا ، فَأَصَابُوا إِنْسَانًا لاَ یُدْرَی أَیُّہُمْ أَصَابَہُ ، قَالَ : الدِّیَۃُ عَلَیْہِمْ کُلِّہِمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 28438","","","كتاب الديات"
"28439","(۲۸۴۳۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ، عَن عِکْرِمَۃَ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: یُودَی الْمُکَاتَبُ بِقَدْرِ مَا عَتَقَ مِنْہُ دِیَۃَ الْحُرِّ، وَبِقَدْرِ مَا رُقَّ مِنْہُ دِیَۃَ الْعَبْدِ۔n(ابوداؤد ۴۵۷۔ احمد ۲۶۰)","Sahih","Musannaf Ibn Abi Shaybah 28439","","","كتاب الديات"
"28440","(۲۸۴۴۰) حَدَّثَنَا إِسْمَاعِیلُ بْنُ إِبْرَاہِیمَ، عَن أَیُّوبَ، عَن عِکْرِمَۃَ، قَالَ: قَالَ عَلِیٌّ: یُودَی مِنَ الْمُکَاتَبِ بِقَدْرِ مَا أَدَّاہُ۔","Sahih","Musannaf Ibn Abi Shaybah 28440","","","كتاب الديات"
"28441","(۲۸۴۴۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ؛ أَنَّ عَلِیًّا ، وَمَرْوَانَ کَانَا یَقُولاَنِ فِی الْمُکَاتَبِ : یُودَی مِنْہُ دِیَۃَ الْحُرِّ بِقَدْرِ مَا أَدَّی ، وَمَا رَقَّ مِنْہُ دِیَۃَ الْعَبْدِ۔","","Musannaf Ibn Abi Shaybah 28441","","","كتاب الديات"
"28442","(۲۸۴۴۲) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : جِرَاحَۃُ الْمُکَاتَبِ جِرَاحَۃُ عَبْدٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 28442","","","كتاب الديات"
"28443","(۲۸۴۴۳) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : تُودَی جِرَاحَتُہُ بِحِسَابِ مَا أَدَّی۔","No Data Available","Musannaf Ibn Abi Shaybah 28443","","","كتاب الديات"
"28444","(۲۸۴۴۴) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ، عَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَنْ شُرَیْحٍ ، قَالَ : جِرَاحَۃُ الْمُکَاتَبِ جِرَاحَۃُ عَبْدٍ۔","","Musannaf Ibn Abi Shaybah 28444","","","كتاب الديات"
"28445","(۲۸۴۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنْ رَجُلٍ رَمَی بِنَارٍ فِی دَارِ قَوْمٍ فَاحْتَرَقُوا ؟ قَالاَ : لَیْسَ عَلَیْہِ قَوَدٌ ، لاَ یُقْتَلُ۔","","Musannaf Ibn Abi Shaybah 28445","","","كتاب الديات"
"28446","(۲۸۴۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ حُصَیْنٍ ، عَنْ یَحْیَی بْنِ یَحْیَی الْغَسَّانِیِّ ، قَالَ : أَحْرَقَ رَجُلٌ تِبْنًا فِی قَرَاحٍ لَہُ ، فَخَرَجَتْ شَرَارَۃٌ مِنْ نَارٍ ، حَتَّی أَحْرَقَتْ شَیْئًا لِجَارِہِ ، قَالَ : فَکَتَبْتُ فِیہِ إِلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، فَکَتَبَ إِلَیَّ : إِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : الْعَجْمَائُ جُبَارٌ ، وَأَرَی أَنَّ النَّارَ جُبَارٌ۔n(ابوداؤد ۴۵۸۲۔ ابن ماجہ ۲۶۷۶)","","Musannaf Ibn Abi Shaybah 28446","","","كتاب الديات"
"28447","(۲۸۴۴۷) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنْ رَجُلٍ أَحْرَقَ دَارًا ، فَأَحْرَقَ فِیہَا قَوْمًا؟ قَالاَ : لاَ یُقْتَلُ۔","","Musannaf Ibn Abi Shaybah 28447","","","كتاب الديات"
"28448","(۲۸۴۴۸) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ : حدَّثَنِی مَکْحُولٌ ، قَالَ : لَمَّا قَدِمَ عَلَیْنَا عُمَرُ بَیْتَ الْمَقْدِسِ أَعْطَی عُبَادَۃُ بْنُ الصَّامِتِ رَجُلاً مِنْ أَہْلِ الذِّمَّۃِ دَابَّتَہُ یُمْسِکُہَا ، فَأَبَی عَلَیْہِ فَشَجَّہُ مُوضِحَۃً ، ثُمَّ دَخَلَ الْمَسْجِدَ ، فَلَمَّا خَرَجَ عُمَرُ صَاحَ النَّبَطِیُّ إِلَی عُمَرَ ، فَقَالَ عُمَرُ : مَنْ صَاحِبُ ہَذَا ؟ قَالَ عُبَادَۃُ : أَنَا صَاحِبُ ہَذَا ، قَالَ : مَا أَرَدْتَ إِلَی ہَذَا ؟ قَالَ : أَعْطَیُْتہُ دَابَّتِی یُمْسِکُہَا فَأَبَی ، وَکُنْتُ امْرَئًا فِی حَدٍّ ، قَالَ : إِمَّا لاَ ، فَاقْعُدْ لِلْقَوَدِ ، فَقَالَ لَہُ زَیْدُ بْنُ ثَابِتٍ : مَا کُنْتَ لِتَقِیدَ عَبْدَک مِنْ أَخِیک ، قَالَ : أَمَا وَاللَّہِ لَئِنْ تَجَافَیْتُ لَکَ عَنِ الْقَوَدِ لأُعْنِتَنَّکَ فِی الدِّیَۃِ ، أَعْطِہِ عَقْلَہَا مَرَّتَیْنِ۔","","Musannaf Ibn Abi Shaybah 28448","","","كتاب الديات"
"28449","(۲۸۴۴۹) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ قَوَدَ بَیْنَ النَّصْرَانِیِّ وَالْحُرِّ الْمُسْلِمِ ، وَلاَ بَیْنَ النَّصْرَانِیِّ وَالْعَبْدِ الْمُسْلِمِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28449","","","كتاب الديات"
"28450","(۲۸۴۵۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ سُفْیَانَ ، عَن خَالِدٍ النِّیلِیِّ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ؛ أَنَّہُمَا قَالاَ فِی رَجُلٍ شَجَّ رَجُلاً فَذَہَبَتْ عَیْنُہُ ، فَقَالَ الْحَکَمُ : إِنْ شَہِدُوا أَنَّہَا ذَہَبَتْ مِنَ الضَّرْبَۃِ ، فَہُوَ جَائِزٌ ، وَقَالَ حَمَّادٌ : إِنْ شَہِدُوا أَنَّہُ ضَرَبَہُ یَوْمَ ضَرَبَہُ وَہِیَ صَحِیحَۃٌ ، فَہُوَ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 28450","","","كتاب الديات"
"28451","(۲۸۴۵۱) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَن سِمَاکٍ ، عَن حَنَشِ بْنِ الْمُعْتَمِرِ ، قَالَ : حُفِرَتْ زُبْیَۃٌ بِالْیَمَنِ لِلأَسَدِ فَوَقَعَ فِیہَا الأَسَدُ ، فَأَصْبَحَ النَّاسُ یَتَدَافَعُونَ عَلَی رَأْسِ الْبِئْرِ ، فَوَقَعَ فِیہَا رَجُلٌ ، فَتَعَلَّقَ بِآخَرَ ، وَتَعَلَّقَ الآخَرُ بِآخَرَ ، فَہَوَی فِیہَا أَرْبَعَۃٌ فَہَلَکُوا فِیہَا جَمِیعًا ، فَلَمْ یَدْرِ النَّاسُ کَیْفَ یَصْنَعُونَ ، فَجَائَ عَلِیٌّ ، فَقَالَ : إِنْ شِئْتُمْ قَضَیْتُ بَیْنَکُمْ بِقَضَائٍ یَکُونُ جَائِزًا بَیْنَکُمْ ، حَتَّی تَأْتُوا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَإِنِّی أَجْعَلُ الدِّیَۃَ عَلَی مَنْ حَضَرَ رَأْسَ الْبِئْرِ ، فَجَعَلَ لِلأَوَّلِ الَّذِی ہَوَی فِی الْبِئْرِ رُبُعَ الدِّیَۃِ ، وَلِلثَّانِی ثُلُثَ الدِّیَۃِ ، وَالثَّالِثِ نِصْفَ الدِّیَۃِ ، وَالرَّابِعِ کَامِلَۃً ، قَالَ : فَتَرَاضَوْا عَلَی ذَلِکَ حَتَّی أَتَوُا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَخْبَرُوہُ بِقَضَائِ عَلِیٍّ ، فَأَجَازَ الْقَضَائَ۔ (احمد ۷۷۔ طیالسی ۱۱۴)","Da'if","Musannaf Ibn Abi Shaybah 28451","","","كتاب الديات"
"28452","(۲۸۴۵۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ عَامِرٍ ، عَن مَسْرُوقٍ ؛ أَنَّ سِتَّۃَ غِلْمَۃٍ ذَہَبُوا یَسْبَحُونَ ، فَغَرِقَ أَحَدُہُمْ ، فَشَہِدَ ثَلاَثَۃٌ عَلَی اثْنَیْنِ أَنَّہُمَا أَغْرَقَاہُ ، وَشَہِدَ اثْنَانِ عَلَی ثَلاَثَۃٍ أَنَّہُمْ أَغَرقُوہُ ، فَقَضَی عَلِیٌّ أَنَّ عَلَی الثَّلاَثَۃِ خُمُسَیِ الدِّیَۃِ ، وَعَلَی الاِثْنَیْنِ ثَلاَثَۃُ أَخْمَاسِ الدِّیَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 28452","","","كتاب الديات"
"28453","(۲۸۴۵۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَن فِرَاسٍ ، عَنِ الشَّعْبِیِّ ، عَن مَسْرُوقٍ ؛ أَنَّہُ جَعَلَ الدِّیَۃَ أَسْبَاعًا : أَرْبَعَۃً عَلَی ثَلاَثَۃٍ ، وَثَلاَثَۃً عَلَی أَرْبَعَۃٍ۔","","Musannaf Ibn Abi Shaybah 28453","","","كتاب الديات"
"28454","(۲۸۴۵۴) حَدَّثَنَا ابْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَن خِلاَسٍ ، قَالَ : اسْتَأْجَرَ رَجُلٌ أَرْبَعَۃَ رِجَالٍ لِیَحْفِرُوا لَہُ بِئْرًا ، فَحَفَرُوہَا فَانْخَسَفَتْ بِہِمُ الْبِئْرُ ، فَمَاتَ أَحَدُہُمْ ، فَرُفِعَ ذَلِکَ إِلَی عَلِیٍّ ، فَضَمَّنَ الثَّلاَثَۃَ ثَلاَثَۃَ أَرْبَاعِ الدِّیَۃِ ، وَطَرَحَ عَنہُمْ رُبُعَ الدِّیَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 28454","","","كتاب الديات"
"28455","(۲۸۴۵۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو مَالِکٍ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ؛ أَنَّ رَجُلاً اسْتَأْجَرَ ثَلاَثَۃً یَحْفِرُونَ لَہُ حَائِطًا، فَضَرَبُوا فِی أَصْلِہِ جَمِیعًا ، فَوَقَعَ عَلَیْہِمْ فَمَاتَ أَحَدُہُمْ ، فَاخْتَصَمُوا إِلَی شُرَیْحٍ ، فَقَضَی عَلَی الْبَاقِیَیْنِ بِثُلُثَیِ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 28455","","","كتاب الديات"
"28456","(۲۸۴۵۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّہُ سُئِلَ عَن أُجَرَائَ اسْتُؤْجِرُوا یَہْدِمُونَ حَائِطًا ، فَخَرَّ عَلَیْہِمْ ، فَمَاتَ بَعْضُہُمْ ؟ أَنَّہُ یَغْرَمُ بَعْضٌ لِبَعْضٍ ، وَالدِّیَۃَ عَلَی مَنْ بَقِیَ۔","","Musannaf Ibn Abi Shaybah 28456","","","كتاب الديات"
"28457","(۲۸۴۵۷) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا مُوسَی بْنُ عُلَیٍّ، عَنْ أَبِیہِ، قَالَ: جَائَ أَعْمَی یَنْشُدُ النَّاسَ فِی زَمَانِ عُمَرَ یَقُولُ:nیَا أَیُّہَا النَّاسُ لَقِیت مُنْکَرًا ہَلْ یَعْقِلُ الأَعْمَی الصَّحِیحَ الْمُبْصِرَا۔n خَرَّا مَعًا کِلاَہُمَا تَکَسَّرَا ؟n قالَ وَکِیعٌ : کَانُوا یَرَوْنَ أَنَّ رَجُلاً صَحِیحًا کَانَ یَقُودُ أَعْمَی ، فَوَقَعَا فِی بِئْرٍ ، فَوَقَعَ عَلَیْہِ ، فَإِمَّا قَتَلَہُ ، وَإِمَّا جَرَحَہُ ، فَضَمَّنَ الأَعْمَی۔","","Musannaf Ibn Abi Shaybah 28457","","","كتاب الديات"
"28458","(۲۸۴۵۸) حَدَّثَنَا عَبْدَۃُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ رَجُلاً مِنْ أَہْلِ الشَّامِ یُقَالُ لَہُ : ابْنُ خَیْبَرِیٍّ وَجَدَ مَعَ امْرَأَتِہِ رَجُلاً فَقَتَلَہَا ، أَوْ قَتَلَہُمَا ، فَرُفِعَ إِلَی مُعَاوِیَۃَ ، فَأَشْکَلَ عَلَیْہِ الْقَضَائُ فِی ذَلِکَ ، فَکَتَبَ إِلَی أَبِی مُوسَی : أَنْ سَلْ عَلِیًّا عَنْ ذَلِکَ ، فَسَأَلَ أَبُو مُوسَی عَلِیًّا ؟ فَقَالَ : إِنَّ ہَذَا لَشَیْئٌ مَا ہُوَ بِأَرْضِنَا، عَزَمْتُ عَلَیْک لِتُخْبِرَنِی ، فَأَخْبَرَہُ ، فَقَالَ عَلِیٌّ : أَنَا أَبُو حَسَنٍ ، إِنْ لَمْ یَجِئْ بِأَرْبَعَۃِ شُہَدَائَ ، فَلِیَدْفَعُوہُ بِرُمَّتِہِ۔ (عبدالرزاق ۱۷۹۱۵)","Sahih","Musannaf Ibn Abi Shaybah 28458","","","كتاب الديات"
"28459","(۲۸۴۵۹) حَدَّثَنَا أَسْبَاطٌ ، عَنِ الشَّیْبَانِیِّ ، عَن سَلَمَۃَ ، قَالَ : رُفِعَ إِلَی مُصْعَبٍ رَجُلٌ وَجَدَ مَعَ امْرَأَتِہِ رَجُلاً فَقَتَلَہُ ، فَأَبْطَلَ دَمَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28459","","","كتاب الديات"
"28460","(۲۸۴۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی عَاصِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ رَجُلاَنِ أَخَوَانِ مِنَ الأَنْصَارِ ، یُقَالُ لأَحَدِہِمَا : أَشْعَث ، فَغَزَا فِی جَیْشٍ مِنْ جُیُوشِ الْمُسْلِمِینَ ، قَالَ : فَقَالَتِ امْرَأَۃُ أَخِیہِ لأَخِیہِ : ہَلْ لَکَ فِی امْرَأَۃِ أَخِیک مَعَہَا رَجُلٌ یُحَدِّثُہَا ؟ فَصَعِدَ فَأَشْرَفَ عَلَیْہِ وَہُوَ مَعَہَا عَلَی فِرَاشِہَا ، وَہِیَ تَنْتِفُ لَہُ دَجَاجَۃً ، وَہُوَ یَقُولُ :nوَأَشْعَثُ غَرَّہُ الإِسْلاَمُ مِنِّیnأَبِیتُ عَلَی حَشَایَاہَا وَیُمْسِیnکَأَنَّ مَوَاضِعَ الرَّبَلاَتِ مِنْہَاnخَلَوْتُ بِعُرْسِہِ لَیْلَ التمَامِnعَلَی دَہْمَائَ لاَحِقَۃِ الْحِزَامِnفِئَامٌ قَدْ جُمِعنْ إِلَی فِئَامِn قالَ : فَوَثَبَ إِلَیْہِ الرَّجُلُ فَضَرَبَہُ بِالسَّیْفِ حَتَّی قَتَلَہُ ، ثُمَّ أَلْقَاہُ فَأَصْبَحَ قَتِیلاً بِالْمَدِینَۃِ ، فَقَالَ عُمَرُ : أُنْشِدُ اللَّہَ رَجُلاً کَانَ عِندَہُ مِنْ ہَذَا عِلْمٌ إِلاَّ قَامَ بِہِ ، فَقَامَ الرَّجُلُ فَأَخْبَرَہُ بِالْقِصَّۃِ ، فَقَالَ : سَحِقَ وَبَعُدَ۔","","Musannaf Ibn Abi Shaybah 28460","","","كتاب الديات"
"28461","(۲۸۴۶۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : الرَّجُلُ یَجِدُ عَلَی امْرَأَتِہِ رَجُلاً فَیَقْتُلُہُ ، أَیُہْدَرُ دَمُہُ ؟ قَالَ : مَا مِنْ أَمْرٍ إِلاَّ بِالْبَیِّنَۃِ ، قُلْتُ : إِنْ شُہِدَ عَلَیْہِ أَنَّہُ زَانِی فِی أَہْلِی ، قَالَ : وَإِنْ شُہِدَ ، لاَ أَمْرَ إِلاَّ بِالْبَیِّنَۃِ ، لاَ أَمْرَ إِلاَّ فِی بَیِّنَۃٍ۔","","Musannaf Ibn Abi Shaybah 28461","","","كتاب الديات"
"28462","(۲۸۴۶۲) حَدَّثَنَا عَبْدَۃُ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : بَیْنَا نَحْنُ لَیْلَۃ فِی الْمَسْجِدِ ، إِذْ جَائَ رَجُلٌ فَقَالَ : لَوْ أَنَّ رَجُلاً وَجَدَ مَعَ امْرَأَتِہِ رَجُلاً فَقَتَلَہُ ، قَتَلْتُمُوہُ ؟ ، أَوْ تَکَلَّمَ جَلَدْتُمُوہُ ؟ لأَذْکُرَنَّ ذَلِکَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَأَتَاہُ ، فَذَکَرَ ذَلِکَ لَہُ ، فَسَکَتَ عَنْہُ ، فَنَزَلَتْ آیَۃُ اللِّعَانِ ، فَدَعَاہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَرَأَہَا عَلَیْہِ ، فَجَائَ الرَّجُلُ بَعْدُ یَقْذِفُ امْرَأَتَہُ ، فَلاَعَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیْنَہُمَا ، وَقَالَ : عَسَی أَنْ تَجِیئَ بِہِ أَسْوَدَ جَعْدًا ، فَجَائَتْ بِہِ أَسْوَدَ جَعْدًا۔ (مسلم ۱۰۔ ابوداؤد ۲۲۴۷)","Sahih","Musannaf Ibn Abi Shaybah 28462","","","كتاب الديات"
"28463","(۲۸۴۶۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ ، عَن وَرَّادٍ ، عَنِ الْمُغِیرَۃِ ، قَالَ : بَلَغَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّ سَعْدَ بْنَ عُبَادَۃَ یَقُولُ : لَوْ وَجَدْت مَعَہَا رَجُلاً لَضَرَبْتُہُ بِالسَّیْفِ غَیْرَ مُصْفَحٍ ، قَالَ : فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَتَعْجَبُونَ مِنْ غَیْرَۃِ سَعْدٍ ؟ فَوَاللَّہِ لأَنَا أَغْیَرُ مِنْ سَعْدٍ ، وَاللَّہُ أَغْیَرُ مِنِّی ، وَمِنْ أَجْلِ غَیْرَۃِ اللہِ حَرَّمَ اللَّہُ الْفَوَاحِشَ ، مَا ظَہَرَ مِنْہَا وَمَا بَطَنَ۔","Sahih","Musannaf Ibn Abi Shaybah 28463","","","كتاب الديات"
"28464","(۲۸۴۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْمُغِیرَۃِ بْنِ النُّعْمَانِ ، عَن ہَانِئِ بْنِ حِزَامٍ ، زَادَ فِیہِ یَحْیَی بْنُ آدَمَ : عَن مَالِکِ بْنِ أَنَسٍ ، عَن ہَانِئِ بْنِ حِزَامٍ ؛ أَنَّ رَجُلاً وَجَدَ مَعَ امْرَأَتِہِ رَجُلاً فَقَتَلَہَا ، فَکَتَبَ فِیہِ إِلَی عُمَرَ ، فَکَتَبَ فِیہِ عُمَرُ کِتَابَیْنِ : کِتَابٌ فِی الْعَلاَنِیَۃِ : یُقْتَلُ ، وَکِتَابٌ فِی السِّرِّ : تُؤْخَذُ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 28464","","","كتاب الديات"
"28465","(۲۸۴۶۵) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ، عَنِ الرَّبِیعِ بْنِ النُّعْمَانِ، عَن أُمِّہِ؛ أَنَّ امْرَأَۃً مِنْ بَنِی لَیْثٍ، یُقَالُ لَہَا: أُمُّ ہَارُونَ، بَیْنَمَا ہِیَ جَالِسَۃٌ تَقْطَعُ مِنْ لَحْمِ أُضْحِیَّتِہَا، إِذْ شَدَّ کَلْبٌ فِی الدَّارِ عَلَی ذَلِکَ اللَّحْمِ، فَرَمَتْہُ بِالسِّکِّینِ فَأَخْطَأَتْہُ ، وَاعْتَرَضَ ابْنٌ لَہَا فَوَقَعَتِ السِّکِّینُ فِی بَطْنِہِ مُرْتَزَّۃ ، فَمَاتَ ، فَوَدَاہُ عَلِیٌّ مِنْ بَیْتِ الْمَالِ۔","Da'if","Musannaf Ibn Abi Shaybah 28465","","","كتاب الديات"
"28466","(۲۸۴۶۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ، عَن خِلاَسٍ، قَالَ: رَمَی رَجُلٌ أُمَّہُ بِحَجَرٍ فَقَتَلَہَا، فَطَلَبَ مِیرَاثَہَا مِنْ إِخْوَتِہِ ، فَقَالَ إِخْوَتُہُ : لاَ مِیرَاثَ لَکَ ، فَارْتَفَعُوا إِلَی عَلِیٍّ ، فَأَخْرَجَہُ مِنَ الْمِیرَاثِ ، وَقَضَی عَلَیْہِ بِالدِّیَۃِ ، وَقَالَ : حَظَّک مِنْہَا ذَلِکَ الْحَجَرُ۔","Da'if","Musannaf Ibn Abi Shaybah 28466","","","كتاب الديات"
"28467","(۲۸۴۶۷) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ (ح) وَعَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ، عَنْ جَدِّہِ (ح) وَعَنْ قَتَادَۃَ ، عَنْ أَبِی الْمَلِیحِ (ح) وَعَنْ عَطَائٍ ؛ أَنَّ قَتَادَۃَ کَانَتْ لَہُ أُمُّ وَلَدٍ تَرْعَی غَنَمَہُ ، فَقَالَ لَہُ ابْنُہُ مِنْہَا : حَتَّی مَتَی تَسْتَأْمِی أُمِّی ، واللہِ لاَ تَسْتَأْمِیہَا أَکْثَرَ مِمَّا اسْتَأْمَیْتہَا ، قَالَ : إِنَّکَ لَہَا ہُنَا ؟ فَخَذَفَہُ بِالسَّیْفِ فَقَتَلَہُ ، فَکَتَبَ فِی ذَلِکَ سُرَاقَۃُ بْنُ جُعْشُمٍ إِلَی عُمَرَ ، فَکَتَبَ إِلَیْہِ : وَافِنِی بِہِ ، وَبِعِشْرِینَ وَمِئَۃٍ ، قَالَ حَجَّاجٌ : وَقَالَ بَعْضُہُمْ : وَبِأَرْبَعِینَ وَمِئَۃٍ ، فَأَخَذَ مِنْہَا ثَلاَثِینَ حِقَّۃً ، وَثَلاَثِینَ جَذَعَۃً ، وَأَرْبَعِینَ مَا بَیْنَ ثَنِیَّۃٍ إِلَی بَازِلٍ عَامُہَا کُلُّہَا خِلْفَۃٌ ، فَقَسَمَہَا بَیْنَ إِخْوَتِہِ ، وَلَمْ یُوَرِّثْہُ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 28467","","","كتاب الديات"
"28468","(۲۸۴۶۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَوْفٍ ، قَالَ : کَانَ عُمَرُ بْنُ حَیَّانَ الْحِمَّانِیُّ یَصْنَعُ الْخَیْلَ ، وَإِنَّہُ حَمَلَ ابْنَہُ عَلَی فَرَسٍ ، فَخَرَّ فَتَقَطَّرَ مِنَ الْفَرَسِ فَمَاتَ ، فَجُعِلَتْ دِیَتُہُ عَلَی عَاقِلَتِہِ ، زَمَانَ زِیَادٍ عَلَی الْبَصْرَۃِ۔","","Musannaf Ibn Abi Shaybah 28468","","","كتاب الديات"
"28469","(۲۸۴۶۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : حمَِلَ رَجُلٌ ابْنَہُ عَلَی فَرَسٍ لِیَشُوِّرہُ ، فَنَخَسَ بِہِ ، وَصَوَّتَ بِہِ فَقَتَلَہُ ، فَجُعِلَتْ دِیَتَہُ عَلَی عَاقِلَتِہِ ، وَلَمْ یُوَرِّثِ الأَبَ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 28469","","","كتاب الديات"
"28470","(۲۸۴۷۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ عَن خِلاَسٍ ، عَنْ عَلِیٍّ ؛ أَنَّ رَجُلَیْنِ أَتَیَا عَلِیًّا ، فَشَہِدَا عَلَی رَجُلٍ أَنَّہُ سَرَقَ ، فَقَطَعَ یَدَہُ ، ثُمَّ جَائَا بِآخَرَ ، فَقَالاَ : ہُوَ ہَذَا ، قَالَ : فَاتَّہَمَہُمَا عَلَی ہَذَا ، وَضَمَّنَہُمَا دِیَۃَ الأَوَّلِ۔","Da'if","Musannaf Ibn Abi Shaybah 28470","","","كتاب الديات"
"28471","(۲۸۴۷۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : أَخْبَرَنَا ابْنُ جُرَیْجٍ ، قَالَ : أَخْبَرَنَی عَمَرَّد ؛ أَنَّ حُیَیَّ بْنَ یَعْلَی أَخْبَرَہُ ، أَنَّہُ سَمِعَ یَعْلَی یُخْبِرُ ؛ أَنَّ رَجُلاً أَتَی یَعْلَی ، فَقَالَ لَہُ : قَاتِلِی ہَذَا ، فَدَفَعَہُ إِلَیْہِ یَعْلَی ،فَجَدَعُوہُ بِسُیُوفِہِمْ ، حَتَّی رُؤُوا أَنَّہُمْ قَتَلُوہُ وَبِہِ رَمَقٌ ، فَأَخَذَہُ أَہْلُہُ فَدَاوُوہُ حَتَّی بَرِأَ ، فَجَائَ یَعْلَی ،فَقَالَ : أَوَلَسْتُ قَدْ دَفَعْتُہُ إِلَیْک ؟ فَأَخْبَرَہُ خَبَرَہُ ، فَدَعَاہُ یَعْلَی ، فَوَجَدَہُ قَدْ شُلِّلَ ، فَحُسِبَتْ جُرُوحُہُ فَوَجَدُوا فِیہِ الدِّیَۃَ ، فَقَالَ لَہُ یَعْلَی : إِنْ شِئْتَ فَادْفَعْ إِلَیْہِ دِیَتَہُ وَاقْتُلْہُ ، وَإِلاَّ فَدَعْہُ ، فَلَحِقَ بِعُمَرَ فَاسْتَأْدَی عَلَی یَعْلَی ، فَاتَّفَقَ عُمَرُ وَعَلِیٌّ عَلَی قَضَائِ یَعْلَی، أَنْ یَدْفَعَ إِلَیْہِ الدِّیَۃَ وَیَقْتُلَہُ ، أَوْ یَدَعَہُ فَلاَ یَقْتُلُہُ ، وَقَالَ عُمَرُ لِیَعْلَی : إِنَّک لَقَاضٍ ، ثُمَّ رَدَّہُ إِلَی عَمَلِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 28471","","","كتاب الديات"
"28472","(۲۸۴۷۲) حَدَّثَنَا عَبَّادٌ ، وَأَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَنْ عُمَرَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : لاَ یُقْتَلُ الْوَالِدُ بِالْوَلَدِ۔ (ابن ماجہ ۲۶۶۲۔ دارقطنی ۱۸۱)","","Musannaf Ibn Abi Shaybah 28472","","","كتاب الديات"
"28473","(۲۸۴۷۳) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ لَیْثٍ، عَن مُجَاہِدٍ، وَعَطَائٍ، قَالاَ: لاَ یُقَادُ الرَّجُلُ مِنْ وَالِدَیْہِ، وَإِنْ قَتَلاَہُ صَبْرًا۔","No Data Available","Musannaf Ibn Abi Shaybah 28473","","","كتاب الديات"
"28474","(۲۸۴۷۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، قَالَ : کُتِبَ إِلَی عُمَرَ فِی امْرَأَۃٍ أَخَذَتْ بِأُنْثَیَیْ رَجُلٍ ، فَخَرَقَتِ الْجِلْدَ وَلَمْ تَخْرِقِ الصِّفَاقَ ، قَالَ عُمَرُ لأَصْحَابِہِ : مَا تَرَوْنَ فِی ہَذَا ؟ قَالُوا : اجْعَلْہَا بِمَنْزِلَۃِ الْجَائِفَۃِ ، فَقَالَ عُمَرُ : لَکِنِّی أَرَی غَیْرَ ذَلِکَ ، أَرَی أَنَّ فِیہَا نِصْفَ مَا فِی الْجَائِفَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 28474","","","كتاب الديات"
"28475","(۲۸۴۷۵) حَدَّثَنَا ہُشَیْمٌ ، عَن دَاوُد ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ؛ أَنَّ رَجُلاً اسْتَکْرَہَ امْرَأَۃً فَأَفْضَاہَا ، فَضَرَبَہُ عُمَرُ الْحَدَّ ، وَغَرَّمَہُ ثُلُثَ دِیَتِہَا۔","","Musannaf Ibn Abi Shaybah 28475","","","كتاب الديات"
"28476","(۲۸۴۷۶) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَن خَالِدِ بْنِ عَبْدِ اللہِ ، عَن خَالِدٍ الْحَذَّائِ ، عَنْ أَبَانَ بْنِ عُثْمَانَ ؛ أَنَّہُ رُفِعَ إِلَیْہِ رَجُلٌ تَزَوَّجَ جَارِیَۃً فَأَفْضَاہَا ، فَقَالَ فِیہَا ہُوَ وَعُمَرُ بْنُ عَبْدِ الْعَزِیزِ : إِنْ کَانَتْ مِمَّنْ یُجَامَعُ مِثْلُہَا فَلاَ شَیْئَ عَلَیْہِ ، وَإِنْ کَانَتْ مِمَّنْ لاَ یُجَامَعُ مِثْلُہَا ، فَعَلَیْہِ ثُلُثُ الدِّیَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28476","","","كتاب الديات"
"28477","(۲۸۴۷۷) حَدَّثَنَا وَکِیعٌ ، عَن شَیْخٍ ، عَنْ قَتَادَۃَ ، عَن زَیْدِ بْنِ ثَابِتٍ ؛ فِی الرَّجُلِ یُفضِی الْمَرْأَۃَ ، قَالَ : إِذَا أَمْسَکَ أَحَدُہُمَا عَنِ الآخَرِ فَالثُّلُثُ ، وَإِنْ لَمْ یُمْسِکْ فَالدِّیَۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 28477","","","كتاب الديات"
"28478","(۲۸۴۷۸) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّ رَجُلاً اسْتَسْقَی عَلَی بَابِ قَوْمٍ فَأَبَوْا أَنْ یُسْقُوہُ ، فَأَدْرَکَہُ الْعَطَشُ فَمَاتَ ، فَضَمَّنَہُمْ عُمَرُ دِیَتَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 28478","","","كتاب الديات"
"28479","(۲۸۴۷۹) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : مَا قُتِلَ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَلاَ أَبِی بَکْرٍ ، وَلاَ عُمَرَ رَجُلٌ مِنَ الْمُسْلِمِینَ إِلاَّ فِی زِنَی ، أَوْ قَتْلٍ ، أَوْ حَارَبَ اللَّہَ وَرَسُولَہُ۔","","Musannaf Ibn Abi Shaybah 28479","","","كتاب الديات"
"28480","(۲۸۴۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ ، عَن مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لاَ یَحِلُّ دَمُ امْرِئٍ یَشْہَدُ أَنْ لاَ إِلَہَ إِلاَّ اللَّہُ، وَأَنِّی رَسُولُ اللہِ، إِلاَّ أَحَدُ ثَلاَثَۃِ نَفَرٍ ؛ النَّفْسِ بِالنَّفْسِ ، وَالثَّیِّبِ الزَّانِی ، وَالتَّارِکِ لِدِینِہِ ، الْمُفَارِقِ لِلْجَمَاعَۃِ۔(بخاری ۶۸۷۸۔ مسلم ۱۳۰۲)","Sahih","Musannaf Ibn Abi Shaybah 28480","","","كتاب الديات"
"28481","(۲۸۴۸۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ غَالِبٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَحِلُّ دَمُ امْرِئٍ مُسْلِمٍ ، إِلاَّ رَجُلٌ قَتَلَ فَقُتِلَ ، أَوْ رَجُلٌ زَنَی بَعْدَ مَا أُحْصِنَ ، أَوْ رَجُلٌ ارْتَدَّ بَعْدَ إِسْلاَمِہِ۔ (احمد ۲۰۵۔ طیالسی ۱۵۴۳)","Sahih","Musannaf Ibn Abi Shaybah 28481","","","كتاب الديات"
"28482","(۲۸۴۸۲) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ غَالِبٍ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ مِثْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 28482","","","كتاب الديات"
"28483","(۲۸۴۸۳) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَنْ أَبِی مَعْشَرٍ، عَن مَسْرُوقٍ، عَنْ عَائِشَۃَ، قَالَتْ : مَا حَلَّ دَمُ أَحَدٍ مِنْ أَہْلِ ہَذِہِ الْقِبْلَۃِ ، إِلاَّ مَنِ اسْتَحَلَّ ثَلاَثَۃَ أَشْیَائَ ؛ قَتْلَ النَّفْسِ بِالنَّفْسِ ، وَالثَّیِّبَ الزَّانِی ، وَالْمُفَارِقَ جَمَاعَۃَ الْمُسْلِمِینَ ، أَوِ الْخَارِجَ مِنْ جَمَاعَۃِ الْمُسْلِمِینَ۔ (حاکم ۳۵۴)","Sahih","Musannaf Ibn Abi Shaybah 28483","","","كتاب الديات"
"28484","(۲۸۴۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ قَیْسٍ ، عَنْ أَبِی حَصِیْنٍ ؛ أَنَّ عُثْمَانَ أَشْرَفَ عَلَی النَّاسِ یَوْمَ الدَّارِ ، فَقَالَ : أَمَا عَلِمْتُمْ أَنَّہُ لاَ یَحِلُّ دَمُ امْرِئٍ مُسْلِمٍ إِلاَّ أَرْبَعَۃٌ ؛ رَجُلٌ قَتَلَ فَقُتِلَ ، أَوْ رَجُلٌ زَنَی بَعْدَ مَا أُحْصِنَ ، أَوْ رَجُلٌ ارْتَدَّ بَعْدَ إِسْلاَمِہِ ، أَوْ رَجُلٌ عَمِلَ عَمَلَ قَوْمِ لُوطٍ۔ (نسائی ۳۵۲۰۔ احمد ۶۳)","","Musannaf Ibn Abi Shaybah 28484","","","كتاب الديات"
"28485","(۲۸۴۸۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ ، قَالَ : وَجَدْت مَمْلُوکًا لَنَا کَانَ یَعْمَلُ فِی بِئْرٍ فِی دَارِ عُتْبَۃَ ، فَخَاصَمْتُہُ إِلَی شُرَیْحٍ ، فَقَالَ : بَیِّنَتُکَ أَنَّہُمْ أَکْرَہُوہُ ، وَإِلاَّ أَقْسَمَ لَکَ مِنْ أَہْلِ الدَّارِ مَنْ شِئْتَ۔","No Data Available","Musannaf Ibn Abi Shaybah 28485","","","كتاب الديات"
"28486","(۲۸۴۸۶) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ لِی ابْنُ شِہَابٍ : لَیْسَ فِی الْعَبْدِ قَسَامَۃٌ ، وَلاَ تُرَدَّ بِہِ الْقَسَامَۃَ ، إِنَّمَا ہِیَ الأَثْمَانُ کَہَیْئَۃِ الْحَقِّ یُدَّعَی۔","","Musannaf Ibn Abi Shaybah 28486","","","كتاب الديات"
"28487","(۲۸۴۸۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قضَی ہِشَامُ بْنُ عَبْدِ الْمَلِکِ فِی عَبْدِ أَیُّوبَ مَوْلَی ابْنِ نَافِعٍ بِخَمْسِینَ یَمِینًا عَلَی أَیُّوبَ ، فَحَلَفَ فَأَخَذَ ثَمَنَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28487","","","كتاب الديات"
"28488","(۲۸۴۸۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَن عُمَارَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزید ، قَالَ : قَالَ سَلْمَانُ : أَمَّا الدَّمُ فَیَقْضِی فِیہِ عُمَرُ۔","Sahih","Musannaf Ibn Abi Shaybah 28488","","","كتاب الديات"
"28489","(۲۸۴۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا مِسْعَرٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنِ النَّزَّالِ بْنِ سَبْرَۃَ ، قَالَ : کَتَبَ عُمَرُ إِلَی أُمَرَائِ الأَجْنَادِ : أَنْ لاَ تُقْتَلَ نَفْسٌ دُونِی۔","Sahih","Musannaf Ibn Abi Shaybah 28489","","","كتاب الديات"
"28490","(۲۸۴۹۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ لاَ یُقْضَی فِی دَمٍ دُونَ أَمِیرِ الْمُؤْمِنِینَ۔","No Data Available","Musannaf Ibn Abi Shaybah 28490","","","كتاب الديات"
"28491","(۲۸۴۹۱) حَدَّثَنَا عَبْدَۃُ، عَن عُبَیْدِاللہِ بْنِ عُمَرَ، عَن نَافِعٍ، عَنِ ابْنِ عُمَرَ؛ أَنَّ جَارِیَۃً لِحَفْصَۃَ سَحَرَتْہَا، وَوَجَدُوا سِحْرَہَا وَاعْتَرَفَتْ بِہِ ، فَأَمَرْت عَبْدَ الرَّحْمَن بْنَ زَیْدٍ فَقَتَلَہَا ، فَبَلَغَ ذَلِکَ عُثْمَانَ فَأَنْکَرَہُ وَاشْتَدَّ عَلَیْہِ ، فَأَتَاہُ ابْنُ عُمَرَ فَأَخْبَرَہُ أَنَّہَا سَحَرَتْہَا وَاعْتَرَفَتْ بِہِ، وَوَجَدُوا سِحْرَہَا، فَکَأَنَّ عُثْمَانَ إِنَّمَا أَنْکَرَ ذَلِکَ لأَنَّہَا قُتِلَتْ بِغَیْرِ إِذْنِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 28491","","","كتاب الديات"
"28492","(۲۸۴۹۲) حَدَّثَنَا حَفْصٌ ، قَالَ : سَأَلْتُ عُمَرًا : مَا کَانَ الْحَسَنُ یَقُولُ فِی الْمُعَاہَدِ یُقْتَلُ ؟ قَالَ : إِنْ کَانُوا یَتَعَاقَلُونَ فَعَلَی الْعَوَاقِلِ ، وَإِنْ کَانُوا لاَ یَتَعَاقَلُونَ فَدَیْنٌ عَلَیْہِ فِی مَالِہِ۔","","Musannaf Ibn Abi Shaybah 28492","","","كتاب الديات"
"28493","(۲۸۴۹۳) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ؛ فِی الْمُعَاہَدِ یَقْتُلُ ، قَالَ : دِیَتُہُ لِلْمُسْلِمِینَ وَعَقْلُہُ عَلَیْہِمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 28493","","","كتاب الديات"
"28494","(۲۸۴۹۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ؛ فِی رَجُلٍ مِنْ أَہْلِ الذِّمَّۃِ فَقَأَ عَیْنَ رَجُلٍ مُسْلِمٍ ، قَالَ : دِیَتُہُ عَلَی أَہْلِ طَسَّوجہ۔","","Musannaf Ibn Abi Shaybah 28494","","","كتاب الديات"
"28495","(۲۸۴۹۵) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَن حَمَّادٍ ؛ فِی أَرْبَعَۃٍ شَہِدُوا عَلَی رَجُلٍ بِالزِّنَی فَرُجِمَ ، ثُمَّ رَجَعَ أَحَدُہُمْ ، قَالَ : عَلَیْہِ رُبُعُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 28495","","","كتاب الديات"
"28496","(۲۸۴۹۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ مَطَرٍ ، عَن عِکْرِمَۃَ ؛ فِی أَرْبَعَۃٍ شَہِدُوا عَلَی رَجُلٍ بِحَدٍّ ، ثُمَّ أَکْذَبَ أَحَدُہُمْ نَفْسَہُ ، قَالَ : یَغْرَمُ رُبُعَ الدِّیَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28496","","","كتاب الديات"
"28497","(۲۸۴۹۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : یُقْتَلُ ، وَعَلَی الآخَرِینَ الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 28497","","","كتاب الديات"
"28498","(۲۸۴۹۸) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ ، قَالَ : قَالَ أَبُو ہَاشِمٍ ؛ فِی أَرْبَعَۃٍ شَہِدُوا عَلَی رَجُلٍ بِالزِّنَی ، ثُمَّ رَجَعَ أَحَدُہُمْ : عَلَیْہِ رُبُعُ الدِّیَۃِ ، وَقَالَ ابْنُ سِیرِینَ : إِذَا قَالَ أَخْطَأْتُ وَأَرَدْتُ غَیْرَہُ ، فَعَلَیْہِ الدِّیَۃُ کَامِلَۃً ، وَإِنْ قَالَ تَعَمَّدْتُ قَتْلَہُ ، قُتِلَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28498","","","كتاب الديات"
"28499","(۲۸۴۹۹) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا وَہَبَ الأَبُ الشَّجَّۃَ الصَّغِیرَۃَ الَّتِی تُصِیبُ ابْنَہُ ، جَازَتْ عَلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28499","","","كتاب الديات"
"28500","(۲۸۵۰۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ؛ فِی رَجُلٍ قُطِعَتْ یَدُہُ فِی السَّرِقَۃِ ، ثُمَّ قَطَعَ رَجُلٌ یَدَہُ الأُخْرَی بَعْدُ ، قَالَ : فِیہَا نِصْفُ الدِّیَۃِ۔","","Musannaf Ibn Abi Shaybah 28500","","","كتاب الديات"
"28501","(۲۸۵۰۱) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنْ رَجُلٍ تَوَضَّأَ فَصَبَّ مَائً فِی الطَّرِیقِ ؟ قَالَ حَمَّادٌ : یُضَمَّنُ ، وَقَالَ الْحَکَمُ : لاَ یُضَمَّنُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28501","","","كتاب الديات"
"28502","(۲۸۵۰۲) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ جَابِرٍ، عَنْ عَامِرٍ؛ فِی الْقَصَّابِ، وَالْقَصَّارِ یَنْضَحُ بَابَہُ، قَالَ: یُضْمَنُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28502","","","كتاب الديات"
"28503","(۲۸۵۰۳) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ؛ فِی الرَّجُلِ السّوقِیِّ یَنْضَحُ بَیْنَ یَدَیْ بَابِہِ ، فَیَمُرُّ بِہِ إِنْسَانٌ فَیَزْلَقُ فَیَعْنَتُ ، قَالَ حَمَّادٌ : یَضْمَنُ ، وَقَالَ الْحَکَمُ : لاَ یَضْمَنُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28503","","","كتاب الديات"
"28504","(۲۸۵۰۴) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ عَوْفٍ ، قَالَ : شَہِدْتُ عَبْدَ الرَّحْمَن بْنَ أُذَیْنَۃَ أَقَصَّ رَجُلاً حَارِصَتَیْنِ فِی رَأْسِہِ ، ثُمَّ حَبَسَ الْمُقْتَصَّ لَہُ حَتَّی یَنْظُرَ الْمُقْتَصَّ مِنْہُ۔ قَالَ : وَکَانَ ابْنُ سِیرِینَ یُنْکِرُ ہَذَا الْحَبْسَ۔","","Musannaf Ibn Abi Shaybah 28504","","","كتاب الديات"
"28505","(۲۸۵۰۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ عَطَائٌ : لِلْجُرُوحِ قِصَاصٌ ، وَلَیْسَ لِلإِمَامِ أَنْ یَضْرِبَہُ، وَلاَ أَنْ یَحْبِسَہُ ، إِنَّمَا ہُوَ الْقِصَاصُ ، مَا کَانَ اللَّہُ نَسِیًّا ، لَوْ شَائَ لأَمَرَ بِالسِّجْنِ وَالضَّرْبِ۔","","Musannaf Ibn Abi Shaybah 28505","","","كتاب الديات"
"28506","(۲۸۵۰۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَن شِبَاکٍ ، عَنْ إِبْرَاہِیمَ ، عَن ہُنَیِّ بْن نُوَیْرَۃَ ، عَنْ عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَعَفَّ النَّاسِ قِتْلَۃً أَہْلُ الإِیمَانِ۔n(ابوداؤد ۲۶۵۹۔ ابن حبان ۵۹۹۴)","Da'if","Musannaf Ibn Abi Shaybah 28506","","","كتاب الديات"
"28507","(۲۸۵۰۷) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ ؛ أَنَّہُ مَرَّ عَلَی ابْنِ مُکَعْبَرٍ ، وَقَدْ قَطَعَ زِیَادٌ یَدَیْہِ وَرِجْلَیْہِ ، فَقَالَ : سَمِعْتُ عَبْدَ اللہِ یَقُولُ : إِنَّ أَعَفَّ النَّاسِ قِتْلَۃً أَہْلُ الإِیِمَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 28507","","","كتاب الديات"
"28508","(۲۸۵۰۸) حَدَّثَنَا حَفْصٌ ، عَن خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الأَشْعَثِ ، عَن شَدَّادِ بْنِ أَوْسٍ ، رَفَعَہُ ، قَالَ : إِنَّ اللَّہَ کَتَبَ الإِحْسَانَ عَلَی کُلِّ شَیْئٍ ، فَإِذَا قَتَلْتُمْ فَأَحْسِنُوا الْقَتْلَ۔ (مسلم ۱۵۴۹۔ ابوداؤد ۲۸۰۷)","Sahih","Musannaf Ibn Abi Shaybah 28508","","","كتاب الديات"
"28509","(۲۸۵۰۹) حَدَّثَنَا وَکِیعٌ ، عَن مَسْلَمَۃَ بْنِ نَوْفَلٍ ، عَن صَفِیَّۃَ بِنْتِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، قَالَتْ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْمُثْلَۃِ۔ (احمد ۲۴۶)","","Musannaf Ibn Abi Shaybah 28509","","","كتاب الديات"
"28510","(۲۸۵۱۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَن خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الأَشْعَثِ ، عَن شَدَّادِ بْنِ أَوْسٍ ، رَفَعَہُ ، قَالَ : إِنَّ اللَّہَ کَتَبَ عَلَیْکُم الإِحْسَانَ فِی کُلِّ شَیْئٍ ، فَإِذَا قَتَلْتُمْ فَأَحْسِنُوا الْقِتْلَۃَ ، وَإِذَا ذَبَحْتُمْ فَأَحْسِنُوا الذَّبْحَ۔n(مسلم ۱۵۴۸۔ بیہقی ۶۸)","Sahih","Musannaf Ibn Abi Shaybah 28510","","","كتاب الديات"
"28511","(۲۸۵۱۱) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الْمَسْعُودِیُّ ، عَن سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ إِبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ، قَالَ : أَعَفَّ النَّاسِ قِتْلَۃً أَہْلُ الإِِِیِمَانِ۔","Hasan","Musannaf Ibn Abi Shaybah 28511","","","كتاب الديات"
"28512","(۲۸۵۱۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَن بُکَیْر بْنِ عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَنْ عُبَیْدِ بن تِعْلَی ، قَالَ : غَزَوْنَا أَرْضَ الرُّومِ وَمَعَنا أَبُو أَیُّوبَ الأَنْصَارِیُّ صَاحِبُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَعَلَی النَّاسِ عَبْدُ الرَّحْمَنِ بْنُ خَالِدِ بْنِ الْوَلِیدِ فِی زَمَانِ مُعَاوِیَۃَ ، فَبَیْنَا نَحْنُ عَندَہُ إِذْ أَتَاہُ رَجُلٌ ، فَقَالَ : أُتِیَ الأَمِیرُ آنفًا بِأَعْلاَجٍ أَرْبَعَۃٍ ، فَأَمَرَ بِہِم فَصُبِرُوا ، یُرْمَوْنَ بِالنَّبْلِ حَتَّی قُتِلُوا ، قَالَ : فَقَامَ أَبُو أَیُّوبَ فَزِعًا حَتَّی أَتَی عَبْدَ الرَّحْمَن ، فَقَالَ : أَصَبَرْتَہمْ ؟ لَقَدْ سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْہَی عَن صَبْرِ الْبَہِیمَۃِ ، وَمَا أَحَبُّ أَنـِّی صَبْرَتُ دَجَاجَۃً وَأَنَّ لِی کَذَا وَکَذَا ، قَالَ : فَأَعْظَمَ ذَلِکَ ، فَدَعَا عَبْدُ الرَّحْمَنِ بِغِلْمَانٍ لَہُ أَرْبَعَۃٍ فَأَعْتَقَہُمْ مَکَانَ الَّذِی صَنَعَ۔","","Musannaf Ibn Abi Shaybah 28512","","","كتاب الديات"
"28513","(۲۸۵۱۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْمُثْلَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 28513","","","كتاب الديات"
"28514","(۲۸۵۱۴) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا ہَمَّامٌ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَن ہَیَّاجِ بْنِ عِمْرَانَ الْبُرْجُمِیِّ ، عَنْ عِمْرَانَ بْنَ حُصَیْنٍ ، وَسَمُرَۃَ بْنَ جُنْدُبٍ ، قَالاَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْمُثْلَۃِ۔n(ابوداؤد ۲۶۶۰۔ احمد ۴۲۹)","Hasan","Musannaf Ibn Abi Shaybah 28514","","","كتاب الديات"
"28515","(۲۸۵۱۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائٍ ، عَنْ عَبْدِ اللہِ بْنِ حَفْصٍ ، عَنْ یَعْلَی بْنِ مُرَّۃَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : قَالَ اللَّہُ : لاَ تُمَثِّلُوا بِعِبَادِی۔ (احمد ۱۷۳۔ طبرانی ۶۹۸)","Da'if","Musannaf Ibn Abi Shaybah 28515","","","كتاب الديات"
"28516","(۲۸۵۱۶) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَن مَنْصُورٍ ، عَن طَلْقِ بْنِ حَبِیبٍ ؛ فِی قَوْلِہِ : {فَلاَ یُسْرِفْ فِی الْقَتْلِ} ، قَالَ : أَنْ تَقْتُلَ غَیْرَ قَاتِلِکَ ، أَوْ تُمَثِّلَ بِقَاتِلِک۔","","Musannaf Ibn Abi Shaybah 28516","","","كتاب الديات"
"28517","(۲۸۵۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَن خُصَیْفٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ {فَلاَ یُسْرِفْ فِی الْقَتْلِ} ، قَالَ : أَنْ یَقْتُلَ اثْنَیْنِ بِوَاحِدٍ۔","","Musannaf Ibn Abi Shaybah 28517","","","كتاب الديات"
"28518","(۲۸۵۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَن سُلَیْمَانَ بْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِذَا بَعَثَ سَرِیَّۃً ، قَالَ : لاَ تُمَثِّلُوا۔ (مسلم ۱۳۵۶۔ ابوداؤد ۲۶۰۵)","Sahih","Musannaf Ibn Abi Shaybah 28518","","","كتاب الديات"
"28519","(۲۸۵۱۹) حَدَّثَنَا عُقْبَۃُ بْنُ خَالِدٍ السَّکُونِیُّ ، عَن مُوسَی بْنِ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، قَالَ : حدَّثَنَی أَبِی ، عَنْ أَبِی سَعِیدٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُمَثَّلَ بِالْبَہَائِمِ۔","Da'if","Musannaf Ibn Abi Shaybah 28519","","","كتاب الديات"
"28520","(۲۸۵۲۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا رَبِیعَۃُ بْنُ عُثْمَانَ التَّیْمِیُّ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ؛ أَنَّ أَبَا مُوسَی کَتَبَ إِلَی عُمَرَ : إِنَّ الرَّجُل یَمُوتُ قِبَلَنَا وَلَیْسَ لَہُ رَحِمٌ ، وَلاَ وَلِیٌّ ، قَالَ : فَکَتَبَ إِلَیْہِ عُمَرُ : إِنْ تَرَکَ ذَا رَحِمٍ فَالرَّحِمُ ، وَإِلاَّ فَالْوَلاَئُ ، وَإِلاَّ فَبَیْتُ الْمَالِ یَرِثُونَہُ ، وَیَعْقِلُونَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 28520","","","كتاب الديات"
"28521","(۲۸۵۲۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ (ح) وَعَن یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یُسْلِمُ وَلَیْسَ لَہُ مَوْلًی ، قَالاَ : مِیرَاثُہُ لِلْمُسْلِمِینَ ، وَعَقْلُہُ عَلَیْہِمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 28521","","","كتاب الديات"
"28522","(۲۸۵۲۲) حَدَّثَنَا جَرِیرٌ، عَن مَنْصُورٍ، عَنْ إِبْرَاہِیمَ، قَالَ: إِذَا أَسْلَمَ الرَّجُلُ عَلَی یَدِ الرَّجُلِ فَلَہُ مِیرَاثُہُ، وَیَعْقِل عَنْہُ۔","","Musannaf Ibn Abi Shaybah 28522","","","كتاب الديات"
"28523","(۲۸۵۲۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن یُونُسَ ، عَنِ الْحَکَمِ بْنِ الأَعْرَجِ ، عَنِ الأَشْعَثِ بْنِ ثُرْمُلَۃَ ، عنْ أَبِی بَکْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَتَلَ نَفْسًا مُعَاہَدَۃً بِغَیْرِ حِلِّہَا ، حَرَّمَ اللَّہُ عَلَیْہِ الْجَنَّۃَ أَنْ یَشُمَّ رِیحَہَا۔ (حاکم ۸۷۴۳۔ احمد ۳۸)","Sahih","Musannaf Ibn Abi Shaybah 28523","","","كتاب الديات"
"28524","(۲۸۵۲۴) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَن یُونُسَ، عَنِ الْحَکَمِ، عَنْ أَشْعَثَ، عنْ أَبِی بَکْرَۃَ، عَنِ النَّبِیِّ؛ مِثْلَہُ۔ (احمد ۵۲)","Sahih","Musannaf Ibn Abi Shaybah 28524","","","كتاب الديات"
"28525","(۲۸۵۲۵) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا عُیَیْنَۃُ بْنُ عَبْدِالرَّحْمَنِ، عَنْ أبیہ ، عَنْ أَبِی بَکْرَۃَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَتَلَ نَفْسًا مُعَاہَدَۃً فِی غَیْرِ کُنْہِہِ ، حَرَّمَ اللَّہُ عَلَیْہِ الْجَنَّۃَ۔ (ابوداؤد ۲۷۵۴۔ احمد ۳۸)","Sahih","Musannaf Ibn Abi Shaybah 28525","","","كتاب الديات"
"28526","(۲۸۵۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، قَالَ : حدَّثَنَا الْحَسَنُ بْنُ عَمْرٍو ، عَن مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَتَلَ مُعَاہَدًا بِغَیْرِ حَقٍّ ، لَمْ یَرَحْ رَائِحَۃَ الْجَنَّۃِ ، وَإِنَّہُ لَیُوجَدُ رِیحُہَا مِنْ مَسِیرَۃِ أَرْبَعِینَ عَامًا۔ (بخاری ۳۱۶۶۔ ابن ماجہ ۲۶۸۶)","Sahih","Musannaf Ibn Abi Shaybah 28526","","","كتاب الديات"
"28527","(۲۸۵۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَوَّلُ مَا یُقْضَی بَیْنَ النَّاسِ یَوْمَ الْقِیَامَۃِ فِی الدِّمَائِ۔ (مسلم ۱۳۰۴۔ ترمذی ۱۳۹۷)","Sahih","Musannaf Ibn Abi Shaybah 28527","","","كتاب الديات"
"28528","(۲۸۵۲۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَمْرِو بْنِ شُرَحْبِیلِ ، قَالَ : أوَّلُ مَا یُقْضَی بَیْنَ النَّاسِ یَوْمَ الْقِیَامَۃِ فِی الدِّمَائِ ، یَجِیئُ الرَّجُلُ آخِذًا بِیَدِ الرَّجُلِ ، قَالَ : فَیَقُولُ : یَا رَبِّ ، ہَذَا قَتَلَنِی ، فَیَقُولُ : فِیمَ قَتَلْتَہُ ؟ فَیَقُولُ : قَتَلَتُہُ لِتَکُونَ الْعِزَّۃُ لِفُلاَنٍ ، فَیُقَالُ : إِنَّہَا لَیْستَْ لَہُ ، بُؤْ بِعَمَلِکَ ، وَیَجِیئُ الرَّجُلُ آخِذًا بِیَدِ الرَّجُلِ ، فَیَقُولُ : یَا رَبِّ ، ہَذَا قَتَلَنِی ، فَیَقُولُ : فِیمَ قَتَلْتَہُ ؟ فَیَقُولُ : قَتَلَتُہُ لِتَکُونَ الْعِزَّۃُ لَک۔ قَالَ : فَیَقُولُ : إِنَّ الْعِزَّۃَ لِی۔ (نسائی ۳۴۶۰۔ طبرانی ۱۰۰۷۵)","","Musannaf Ibn Abi Shaybah 28528","","","كتاب الديات"
"28529","(۲۸۵۲۹) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، عَن قَیْسِ بْنِ عُبَادٍ ، قَالَ : قَالَ عَلِیٌّ : أَنَا أَوَّلُ مَنْ یَجْثُو لِلْخَصْمِ بَیْنَ یَدِی اللہِ یَوْمَ الْقِیَامَۃِ۔ (بخاری ۴۷۴۴)","Sahih","Musannaf Ibn Abi Shaybah 28529","","","كتاب الديات"
"28530","(۲۸۵۳۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا فُضَیْلُ بْنُ مَرْزُوقٍ ، عَنْ عَطِیَّۃَ بْنِ سَعْدٍ الْعَوْفِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ جُنْدَبٍ ، عَنْ عَلِیٍّ ؛ أَنَّہُ سُئِلَ عَن قَتْلاَہُ ، وَقَتْلَی مُعَاوِیَۃَ ؟ فَقَالَ : أَجِیئُ أَنَا وَمُعَاوِیَۃُ فَنَخْتَصِمُ عَندَ ذِی الْعَرْشِ ، فَأَیُّنَا فَلَجَ ، فَلَجَ أَصْحَابُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 28530","","","كتاب الديات"
"28531","(۲۸۵۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إِبْرَاہِیمِ بْنِ الْمُہَاجِرِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : أَوَّلُ مَا یُقْضَی بَیْنَ النَّاسِ یَوْمَ الْقِیَامَۃِ فِی الدِّمَائِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28531","","","كتاب الديات"
"28532","(۲۸۵۳۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا أُصِیبَ الرَّجُلُ بِجِرَاحَۃٍ فَاقْتُصُّ مِنْ صَاحِبِہِ ، کَانَتْ دِیَۃُ الْمُقْتَصِّ مِنْہُ عَلَی عَاقِلَۃِ الْقَاصِّ۔","No Data Available","Musannaf Ibn Abi Shaybah 28532","","","كتاب الديات"
"28533","(۲۸۵۳۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ؛ فِی الَّذِی یُقْتَصُّ مِنْہُ فَیَمُوتُ ، یُرْفَعُ عَنِ الَّذِی اقْتَصَّ مِنْہُ دِیَۃُ جِرَاحَتِہِ ، وَعَلَیْہِ دِیَتُہُ عَلَی عَاقِلَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28533","","","كتاب الديات"
"28534","(۲۸۵۳۴) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنِ ابْن أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ؛ فِی الَّذِی یُقْتَصُّ مِنْہُ فَیَمُوتُ ، قَالَ : الدِّیَۃُ عَلَی عَاقِلَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28534","","","كتاب الديات"
"28535","(۲۸۵۳۵) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ فِی السِّنِّ الزَّائِدَۃِ ، قَالَ : حکُومَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 28535","","","كتاب الديات"
"28536","(۲۸۵۳۶) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : حدِّثْتُ عَنْ مَکْحُولٍ ، عن زَیْدِ بْنِ ثَابِتٍ ؛ أَنَّہُ قَالَ : فِی السِّنِّ الزَّائِدَۃِ ثُلُثُ السِنِّ۔","Da'if","Musannaf Ibn Abi Shaybah 28536","","","كتاب الديات"
"28537","(۲۸۵۳۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : أَقْبَلَ رَجُلٌ بِجَارِیَۃٍ مِنَ الْقَادِسِیَّۃِ ، فَمَرَّ عَلَی رَجُلٍ وَاقِفٍ عَلَی دَابَّۃٍ ، فَنَخَسَ الرَّجُلُ الدَّابَّۃَ ، فَرَفَعَتِ الدَّابَّۃُ رِجْلَہَا ، فَلَمْ تُخْطِئْ عَیْنَ الْجَارِیَۃِ ، فَرُفِعَ إِلَی سَلْمَانَ بْنِ رَبِیعَۃَ الْبَاہِلِیِّ ، فَضَمَّنَ الرَّاکِبَ ، فَبَلَغَ ذَلِکَ ابْنَ مَسْعُودٍ ، فَقَالَ : عَلَیّ الرَّجُل ، إِنَّمَا یُضَمَّنُ النَّاخِسُ۔","","Musannaf Ibn Abi Shaybah 28537","","","كتاب الديات"
"28538","(۲۸۵۳۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : سَأَلْتُہُ عَنْ رَجُلٍ نَخَسَ دَابَّۃَ رَجُلٍ؟ فَقَالَ : یُضَمَّنُ النَّاخِسُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28538","","","كتاب الديات"
"28539","(۲۸۵۳۹) حَدَّثَنَا أَبُو أُسَامَۃَ، عَن مُجَالِدٍ، عَنِ الشَّعْبِیِّ، عَنْ شُرَیْحٍ، قَالَ: إِلاَّ أَنْ یَنْخُسَہَا إِنْسَانٌ فَیُضَمَّن النَّاخِسُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28539","","","كتاب الديات"
"28540","(۲۸۵۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ (ح) وَحَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُمَا قَالاَ فِی رَجُلٍ جَدَعَ أَنْفَ عَبْدٍ کُلَّہُ ، قَالَ : یَغْرَمُ ثَمَنَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28540","","","كتاب الديات"
"28541","(۲۸۵۴۱) حَدَّثَنَا قَبِیصَۃُ بْنُ عُقْبَۃَ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی عُبَیْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی رَجُلٍ قُطِعَتْ یَدُہُ ، فَصَالَحَ عَلَیْہَا ، ثُمَّ انْتَقَضَتْ یَدُہُ فَمَاتَ ، قَالَ : الصُّلْحُ مَرْدُودٌ ، وَیُؤْخَذُ بِالدِّیَۃُ۔","Hasan","Musannaf Ibn Abi Shaybah 28541","","","كتاب الديات"
"28542","(۲۸۵۴۲) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : ہَاجَتِ الْفِتْنَۃُ وَأَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُتَوَافِرُونَ ، فَأَجْمَعَ رَأْیُہُمْ عَلَی أَنَّہُ لاَ یُقَادُ ، وَلاَ یُودَی مَا أُصِیبَ عَلَی تَأْوِیلِ الْقُرْآنِ ، وَلاَ یُرَدُّ مَا أُصِیبَ عَلَی تَأْوِیلِ الْقُرْآنِ ، إِلاَّ مَا یُوجَدُ بِعَیْنِہِ۔","","Musannaf Ibn Abi Shaybah 28542","","","كتاب الديات"
"28543","(۲۸۵۴۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : سَأَلْتُہُ عَن غُلاَمٍ کَانَ یُطَیِّرُ حَمَامًا فَوْقَ بَیْتٍ ، وَرَجُلٌ فَوْقَ بَیْتٍ ، فَوَقَعَ الْغُلاَمُ ، فَقَالَ إِبْرَاہِیمُ : لَعَلَّہُمْ یَقُولُونَ لَعَلَّہُ أَمَرَہُ بِشَیْئٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 28543","","","كتاب الديات"
"28544","(۲۸۵۴۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِمْرَانُ بْنُ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : لو قُلْتَ لِرَجُلٍ وَہُوَ عَلَی مَقْتَلِہِ ، یَعْنِی مَہْلِکَہُ : جِسْرًا ، أَوْ حَائِطًا ، بَاعِد اتَّقِہِ ، فَصُرِعَ غَرِمْتَہُ۔","","Musannaf Ibn Abi Shaybah 28544","","","كتاب الديات"
"28545","(۲۸۵۴۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : رَجُلٌ نَادَی صَبِیًّا اسْتَأْخِرْ ، فَخَرَّ فَمَاتَ ؟ قَالَ : یَرْوُونَ عَنْ عَلِیٍّ أَنَّہُ یُغَرِّمُہُ ، یَقُولُونَ : أَفْزَعَہُ ، قُلْتُ : فَنَادَی کَبِیرًا ؟ قَالَ : مَا أَرَاہُ إِلاَّ مِثْلَہُ ، فَرَادَدْتُہُ ، فَکَانَ یَرَی أَنْ یُغَرَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 28545","","","كتاب الديات"
"28546","(۲۸۵۴۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلَیْنِ شَجَّا رَجُلاً ، فَشَجَّہُ أَحَدُہُمَا آمَّۃً ، وَشَجَّہُ الآخَرُ مُوضِحَۃً ، لاَ یُعْلَمُ ، وَلاَ یُدْرَی أَیُّہُمَا شَجَّ الْمُوضِحَۃَ ، وَلاَ أَیُّہُمَا شَجَّ الآمَّۃَ ، فَقَالَ : عَلَی کُلِّ وَاحِدٍ مِنْہُمَا نِصْفُ الآمَّۃِ ، وَنِصْفُ الْمُوضِحَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28546","","","كتاب الديات"
"28547","(۲۸۵۴۷) حَدَّثَنَا وَکِیعٌ ، عَن خَلِیفَۃَ بْنِ خَیَّاطٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ قَالَ فِی خُطْبَتِہِ ، وَہُوَ مُسْنِدٌ ظَہْرَہُ إِلَی الْکَعْبَۃِ ، قَالَ : الْمُسْلِمُونَ تَتَکَافَأُ دِمَاؤُہُمْ ، یَسْعَی بِذِمَّتِہِمْ أَدْنَاہُمْ ، وَہُمْ یَدٌ عَلَی مَنْ سِوَاہُمْ۔ (ابوداؤد ۲۷۴۵۔ ابن ماجہ ۲۶۸۵)","Hasan","Musannaf Ibn Abi Shaybah 28547","","","كتاب الديات"
"28548","(۲۸۵۴۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا أَبُو الأَشْہَبِ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْمُسْلِمُونَ تَتَکَافَأُ دِمَاؤُہُمْ ، یَسْعَی بِذِمَّتِہِمْ أَدْنَاہُمْ ، وَہُمْ یَدٌ عَلَی مَنْ سِوَاہُمْ۔n(ابوداؤد ۴۵۱۹۔ ابن ماجہ ۲۶۸۴)","Hasan","Musannaf Ibn Abi Shaybah 28548","","","كتاب الديات"
"28549","(۲۸۵۴۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَن سِمَاکٍ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَت قُرَیْظَۃُ وَالنَّضِیرُ ، وَکَانَتِ النَّضِیرُ أَشْرَفَ مِنْ قُرَیْظَۃَ ، فَکَانَ إِذَا قَتَلَ رَجُلٌ مِنْ قُرَیْظَۃَ رَجُلاً مِنَ النَّضِیرِ قُتِلَ بِہِ ، وَإِنْ قَتَلَ رَجُلٌ مِنَ النَّضِیرِ رَجُلاً مِنْ قُرَیْظَۃَ وَدَاہ مِئَۃَ وَسْقٍ مِنْ تَمْرٍ ، فَلَمَّا بُعِثَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَتَلَ رَجُلٌ مِنَ النَّضِیرِ رَجُلاً مِنْ قُرَیْظَۃَ ، قَالُوا : ادْفَعُوہُ إِلَیْنَا نَقْتُلُہُ ، فَقَالُوا : بَیْنَنَا وَبَیْنَکُمَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَتَوْہُ ، فَنَزَلَتْ : {وَإِنْ حَکَمْتَ فَاحْکُمْ بَیْنَہُمْ بِالْقِسْطِ} فَالْقِسْطُ : النَّفْسُ بِالنَّفْسِ ، ثُمَّ نَزَلَتْ : {أَفَحُکْمَ الْجَاہِلِیَّۃِ یَبْغُونَ}۔ (ابوداؤد ۴۴۸۸۔ نسائی ۶۹۳۴)","","Musannaf Ibn Abi Shaybah 28549","","","كتاب الديات"
"28550","(۲۸۵۵۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَن مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ فِی بَنِی إِسْرَائِیلَ الْقِصَاصُ ، وَلَمْ تَکُنْ فِیہِم الدِّیَۃُ ، فَقَالَ اللَّہُ لِہَذِہِ الأُمَّۃِ : {کُتِبَ عَلَیْکُمَ الْقِصَاصُ فِی الْقَتْلَی الْحُرُّ بِالْحُرِّ ، وَالْعَبْدُ بِالْعَبْدِ ، وَالأُنْثَی بِالأُنْثَی ، فَمَنْ عُفِیَ لَہُ مِنْ أَخِیہِ شَیْئٌ ، فَاتِّبَاعٌ بِالْمَعْرُوفِ وَأَدَائٌ إِلَیْہِ بِإِحْسَانٍ} فَالْعَفْوُ : أَنْ تُقْبَلَ الدِّیَۃُ فِی الْعَمْدِ : {ذَلِکَ تَخْفِیفٌ مِنْ رَبِّکُمْ وَرَحْمَۃٌ} قَالَ : فَعَلَی ہَذَا : أَنْ یَتَّبِعَ بِالْمَعْرُوفِ ، وَعَلَی ذَاکَ أَنْ یُؤَدِّیَ إِلَیْہِ بِإِحْسَانٍ، {فَمَنَ اع??تَدَی بَعْدَ ذَلِکَ فَلَہُ عَذَابٌ أَلِیمٌ}۔(بخاری۴۴۹۸۔ ابن الجارود ۷۷۵)","Sahih","Musannaf Ibn Abi Shaybah 28550","","","كتاب الديات"
"28551","(۲۸۵۵۱) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : مَا قَوْلُہُ : {الْحُرُّ بِالْحُرِّ وَالْعَبْدُ بِالْعَبْدِ}؟ قَالَ : الْعَبْدُ یَقْتُلُ عَبْدًا ، مِثْلَہُ ، فَہُوَ بِہِ قَوَدٌ ، وَإِنْ کَانَ الْقَاتِلُ أَفْضَلَ لَمْ یَکُنْ لَہُم إِلاَّ قِیمَۃُ الْمَقْتُولِ۔","","Musannaf Ibn Abi Shaybah 28551","","","كتاب الديات"
"28552","(۲۸۵۵۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ ابْنِ أَشْوَعَ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ بَیْنَ حَیَّیْنِ مِنَ الْعَرَبِ قِتَالٌ ، فَقُتِلَ مِنْ ہَؤُلاَئِ وَمِنْ ہَؤُلاَئِ ، فَقَالَ أَحَدُ الْحَیَّیْنِ : لاَ نَرْضَی حَتَّی نَقْتُلَ بِالْمَرْأَۃِ الرَّجُلَ ، وَبِالرَّجُلِ الرَّجُلَیْنِ ، قَالَ : فَأَبَی عَلَیْہِم الآخَرُونَ ، فَارْتَفَعُوا إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْقَتْلُ بَوَائٌ ، أَیْ سَوَائٌ ، قَالَ : فَاصْطَلَحَ الْقَوْمُ بَیْنَہُمْ عَلَی الدِّیَاتِ۔ قَالَ : فَحَسَبُوا لِلرَّجُلِ دِیَۃَ الرَّجُلِ ، وَلِلْمَرْأَۃِ دِیَۃَ الْمَرْأَۃِ ، وَلِلْعَبْدِ دِیَۃَ الْعَبْدِ ، فَقََضَی لأَحَدِ الْحَیَّیْنِ عَلَی الآخَرِ ، قَالَ : فَہُوَ قَوْلُہُ : {یَا أَیُّہَا الَّذِینَ آمَنُوا کُتِبَ عَلَیْکُمُ الْقِصَاصُ فِی الْقَتْلَی الْحُرُّ بِالْحُرِّ ، وَالْعَبْدُ بِالْعَبْدِ ، وَالأُنْثَی بِالأُنْثَی}۔n قَالَ سُفْیَانُ : {فَمَنْ عُفِیَ لَہُ مِنْ أَخِیہِ شَیْئٌ} ، قَالَ : فَمَنْ فَضَلَ لَہُ عَلَی أَخِیہِ شَیْئٌ فَلْیُؤَدِّہِ بِالْمَعْرُوفِ ، وَلِیَتْبَعہُ الطَّالِبُ بِإِحْسَانٍ ، إِلَی قَولِہِ : {عَذَابٌ أَلِیمٌ}۔","","Musannaf Ibn Abi Shaybah 28552","","","كتاب الديات"
"28553","(۲۸۵۵۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَن غَنَمٍ سَقَطَتْ فِی زَرْعِ قَوْمٍ ؟ قَالَ حَمَّادٌ : لاَ یُضَمَّنُ ، وَقَالَ الْحَکَمُ : یُضَمَّنُ۔","","Musannaf Ibn Abi Shaybah 28553","","","كتاب الديات"
"28554","(۲۸۵۵۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَن طَارِقٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ شَاۃً دَخَلَتْ عَلَی نَسَّاجٍ فَأَفْسَدَتْ غَزْلَہُ، فَلَمْ یُضَمِّنِ الشَّعْبِیُّ صَاحِبَ الشَّاۃِ بِالنَّہَارِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28554","","","كتاب الديات"
"28555","(۲۸۵۵۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ ، وَحَرَامِ بْنِ سَعْدٍ ؛ أَنَّ نَاقَۃً لِلْبَرَائِ بْنِ عَازِبٍ دَخَلَتْ حَائِطَ قَوْمٍ فَأَفْسَدَتْ عَلَیْہِمْ ، فَقَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّ حِفْظَ الأَمْوَالِ عَلَی أَہْلِہَا بِالنَّہَارِ ، وَأَنَّ عَلَی أَہْلِ الْمَاشِیَۃِ مَا أَصَابَتِ الْمَاشِیَۃُ بِاللَّیْلِ۔ (ابوداؤد ۳۵۶۵۔ احمد ۲۹۵)","","Musannaf Ibn Abi Shaybah 28555","","","كتاب الديات"
"28556","(۲۸۵۵۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ (ح) وَإِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ شَاۃً أَکَلَتْ عَجِینًا ، وَقَالَ الآخَرُ : غَزْلاً نَہَارًا ، فَأَبْطَلَہُ شُرَیْحٌ ، وَقَرَأَ : {إِذْ نَفَشَتْ فِیہِ غَنَمُ الْقَوْمِ}، فَقَالَ فِی حَدِیثِ إِسْمَاعِیلَ : إِنَّمَا کَانَ النَّفْشُ بِاللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 28556","","","كتاب الديات"
"28557","(۲۸۵۵۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی خَالِدٍ ، عَنْ عَامِرٍ ، قَالَ : جَائَ رَجُلٌ إِلَی شُرَیْحٍ ، فَقَالَ : إِنَّ شَاۃَ ہَذَا قَطَعَتْ غَزْلِی ، فَقَالَ : لَیْلاً ، أَوْ نَہَارًا ؟ فَإِنْ کَانَ نَہَارًا ، فَقَدْ بَرِئَ ، وَإِنْ کَانَ لَیْلاً ، فَقَدْ ضَمِنَ ، وَقَرَأَ : {إِذْ نَفَشَتْ فِیہِ غَنَمُ الْقَوْمِ} ، وَقَالَ : إِنَّمَا کَانَ النَّفْشُ بِاللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 28557","","","كتاب الديات"
"28558","(۲۸۵۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَن مُرَّۃَ بْنِ شَرَاحِیلَ ، عَن مَسْرُوقٍ ؛ {إِذْ نَفَشَتْ فِیہِ غَنَمُ الْقَوْمِ} ، قَالَ : کَانَ کَرمًا ، فَدَخَلَتْ فِیہِ لَیْلاً ، فَمَا أَبْقَتْ فِیہِ خَضِرًا۔","","Musannaf Ibn Abi Shaybah 28558","","","كتاب الديات"
"28559","(۲۸۵۵۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ مُحَمَّدِ بْنِ عَلِیٍّ ، قَالَ : قَالَ عُثْمَانُ : مَنْ جَالَسَ أَعْمَی ، فَأَصَابَہُ الأَعْمَی بِشَیْئٍ ، فَہُوَ ہَدَرٌ۔","","Musannaf Ibn Abi Shaybah 28559","","","كتاب الديات"
"28560","(۲۸۵۶۰) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنِ الْحَارِثِ بْنِ حَصیرۃ ، عَن زَیْدِ بْنِ وَہْبٍ ؛ أَنَّ عَلِیًّا لَمَّا رَجَمَ الْمَرْأَۃَ قَالَ لأَوْلِیَائِہَا : ہَذَا ابْنُکُمْ تَرِثُونَہُ وَیَرِثُکُمْ ، وَإِنْ جَنَی جِنَایَۃً فَعَلَیْکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 28560","","","كتاب الديات"
"28561","(۲۸۵۶۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا لاَعَنِ الرَّجُلُ امْرَأَتَہُ فُرِّقَ بَیْنَہُمَا ، وَلاَ یَجْتَمِعَانِ أَبَدًا، وَأُلْحِقَ الْوَلَدُ بِعَصَبَۃِ أُمِّہِ ، یَرِثُونَہُ وَیَعْقِلُونَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 28561","","","كتاب الديات"
"28562","(۲۸۵۶۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عُمَرَ ، عَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : مِیرَاثُہُ کُلُّہُ لأُِمِّہِ ، وَیَعْقِلُ عَنْہُ عَصَبَتُہَا ، کَذَلِکَ وَلَدُ الزِّنَی ، وَوَلَدُ النَّصْرَانِیِّ وَأُمّہُ مُسْلِمَۃٌ۔","","Musannaf Ibn Abi Shaybah 28562","","","كتاب الديات"
"28563","(۲۸۵۶۳) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ ، وَأَبِی ہَاشِمٍ ، قَالاَ فِی رَجُلٍ قَتَلَ رَجُلاً عَمْدًا ، فَحُبِسَ لِیُقَادَ بِہِ ، فَجَائَ رَجُلٌ فَقَتَلَہُ عَمْدًا ، قَالاَ : لاَ یُقَادُ بِہِ۔","","Musannaf Ibn Abi Shaybah 28563","","","كتاب الديات"
"28564","(۲۸۵۶۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إِذَا قَتَلَ الرَّجُلُ مُتَعَمِّدًا ، ثُمَّ قَتَلَ الْقَاتِلَ رَجُلٌ مُتَعَمِّدًا ، قُتِلَ الأَوْسَطُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28564","","","كتاب الديات"
"28565","(۲۸۵۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَن قَیْسِ بْنِ مُسْلِمٍ ، عَن طَارِقِ بْنِ شِہَابٍ ، عَنِ الْہَیْثَمِ بْنِ الأَسْوَدِ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ؛ {فَمَنْ تَصَدَّقَ بِہِ فَہُوَ کَفَّارَۃٌ لَہُ} ، قَالَ : ہُدِمَ عَنْہُ مِنْ ذُنُوبِہِ مِثْلُ ذَلِکَ۔","Hasan","Musannaf Ibn Abi Shaybah 28565","","","كتاب الديات"
"28566","(۲۸۵۶۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ {فَمَنْ تَصَدَّقَ بِہِ فَہُوَ کَفَّارَۃٌ لَہُ} قَالَ : لِلْمَجْرُوحِ ، وَقَالَ مُجَاہِدٌ : لِلْجَارِحِ۔","","Musannaf Ibn Abi Shaybah 28566","","","كتاب الديات"
"28567","(۲۸۵۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، وَمُجَاہِدٍ ، قَالاَ : کَفَّارَۃٌ لِلْجَارِحِ ، وَأَجْرُ الَّذِی أُصِیبَ عَلَی اللہِ۔","","Musannaf Ibn Abi Shaybah 28567","","","كتاب الديات"
"28568","(۲۸۵۶۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الْحَسَنِ ؛ {فَمَنْ تَصَدَّقَ بِہِ فَہُوَ کَفَّارَۃٌ لَہُ} قَالَ: لِلْمَجْرُوحِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28568","","","كتاب الديات"
"28569","(۲۸۵۶۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن زَیْدِ بْنِ أَسْلَمَ ، قَالَ : سَمِعْتُہ یَقُولُ : إِنْ عَفَی عَنْہُ ، أَوِ اقْتَصَّ مِنْہُ ، أَوْ قَبِلَ مِنْہُ الدِّیَۃَ فَہُوَ کَفَّارَۃٌ۔","","Musannaf Ibn Abi Shaybah 28569","","","كتاب الديات"
"28570","(۲۸۵۷۰) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، وَمُجَاہِدٍ ، قَالاَ : کَفَّارَۃٌ لِلَّذِی تَصَدَّقَ عَلَیْہِ ، وَأَجْرُ الَّذِی أُصِیبَ عَلَی اللہِ۔","","Musannaf Ibn Abi Shaybah 28570","","","كتاب الديات"
"28571","(۲۸۵۷۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، وَیَحْیَی بْنُ آدَمَ ، عَنْ سُفْیَانَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ {فَمَنْ تَصَدَّقَ بِہِ فَہُوَ کَفَّارَۃٌ لَہُ} ، قَالَ : لِلْجَارِحِ ، وَأَجرُ الْمُتَصَدِق عَلَی اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 28571","","","كتاب الديات"
"28572","(۲۸۵۷۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَن عُمَارَۃَ ، عَنْ أَبِی عُقْبَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ؛ {فَمَنْ تَصَدَّقَ بِہِ فَہُوَ کَفَّارَۃٌ لَہُ} ، قَالَ : لِلجَارِحِ۔","","Musannaf Ibn Abi Shaybah 28572","","","كتاب الديات"
"28573","(۲۸۵۷۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی إِدْرِیسَ ، عَن عُبَادَۃَ بْنِ الصَّامِتِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ قَالَ : تُبَایِعُونِی عَلَی أَنْ لاَ تُشْرِکُوا بِاَللَّہِ شَیْئًا ، وَلاَ تَزْنُوا ، وَلاَ تَسْرِقُوا ، فَمَنْ أَصَابَ مِنْ ذَلِکَ شَیْئًا فَعُوقِبَ بِہِ ، فَہُوَ کَفَّارَتُہُ۔ (بخاری ۴۸۹۴۔ مسلم ۱۳۳۳)","Sahih","Musannaf Ibn Abi Shaybah 28573","","","كتاب الديات"
"28574","(۲۸۵۷۴) حَدَّثَنَا وَکِیعٌ ، عَن زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، قَالَ : لِلَّذِی تَصَدَّقَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28574","","","كتاب الديات"
"28575","(۲۸۵۷۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الْحَارِثِ بْنِ فُضَیْلٍ ، عَنِ ابْنِ أَبِی الْعَوْجَائِ ، عَنْ أَبِی شُرَیْحٍ الْخُزَاعِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ أُصِیبَ بِدَمٍ ، أَوْ خَبْلٍ ، وَالْخَبْلُ: الْجُرْحُ ، فَہُوَ بِالْخِیَارِ بَیْنَ إِحْدَی ثَلاَثٍ ، فَإِنْ أَرَادَ الرَّابِعَۃَ فَخُذُوا عَلَی یَدَیْہِ ؛ أَنْ یَقْتُلَ ، أَوْ یَعْفُوَ ، أَوْ یَأْخُذَ الدِّیَۃَ ، فَمَنْ فَعَلَ شَیْئًا مِنْ ذَلِکَ فَعَادَ ، فَلَہُ نَارُ جَہَنَّمَ خَالِدًا مُخَلَّدًا فِیہَا أَبَدًا۔ (ابوداؤد ۴۴۹۰۔ احمد ۳۱)","Da'if","Musannaf Ibn Abi Shaybah 28575","","","كتاب الديات"
"28576","(۲۸۵۷۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَوْفٍ ، عَن حَمْزَۃَ أَبِی عُمَرَ ، عَنْ عَلْقَمَۃَ بْنِ وَائِلٍ ، عَنْ أَبِیہِ ، قَالَ : شَہِدْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ أُتِیَ بِالْقَاتِلِ یُجَرُّ فِی نِسْعَتِہِ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِوَلِیِّ الْمَقْتُولِ ، أَتَعْفُو عَنْہُ ؟ قَالَ : لاَ ، قَالَ : فَتَأْخُذُ الدِّیَۃَ ؟ قَالَ : لاَ ، قَالَ : فَتَقْتُلُہُ ؟ قَالَ : نَعَمْ ، فَأَعَادَ عَلَیْہِ ثَلاَثًا ، فَقَالَ لَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنْ عَفَوْتَ عَنْہُ فَإِنَّہُ یَبُوئُ بِإِثْمِہِ ، قَالَ : فَعَفَا ، فَرَأَیْتُہُ یَجُرُّ نِسْعَتَہُ ، قَدْ عُفِیَ عَنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 28576","","","كتاب الديات"
"28577","(۲۸۵۷۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قُتِلَ رَجُلٌ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَرُفِعَ ذَلِکَ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَدَفَعَہُ إِلَی وَلِیِّ الْمَقْتُولِ ، فَقَالَ الْقَاتِلُ : یَا رَسُولَ اللہِ ، مَا أَرَدْتُ قَتْلَہُ ، قَالَ : فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِلْوَلِیِّ : أَمَا إِنْ کَانَ صَادِقًا ، ثُمَّ قَتَلْتَہُ دَخَلْتَ النَّارَ ، قَالَ : فَخَلَّی سَبِیلَہُ۔ قَالَ : وَکَانَ مَکْتُوفًا بِنِسْعَۃٍ ، قَالَ : فَخَرَجَ یَجُرُّ نِسْعَتَہُ ، قَالَ : فَسُمِّیَ ذَا النِّسْعَۃِ۔ (ابوداؤد ۴۴۹۲۔ ترمذی ۱۴۰۷)","Sahih","Musannaf Ibn Abi Shaybah 28577","","","كتاب الديات"
"28578","(۲۸۵۷۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَن حُرٍّ وَعَبْدٍ اصْطَدَمَا فَمَاتَا ؟ قَالاَ : أَمَّا دِیَۃُ الْحُرِّ فَلَیْسَتْ عَلَی الْمَمْلُوکِ ، وَأَمَّا دِیَۃُ الْمَمْلُوکِ فَعَلَی الْعَاقِلَۃِ۔","","Musannaf Ibn Abi Shaybah 28578","","","كتاب الديات"
"28579","(۲۸۵۷۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ سُفْیَانَ ، عَن سِمَاکٍ ، عَن عِکْرِمَۃَ (ح) وَعن مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ؛ {وَإِنْ کَانَ مِنْ قَوْمٍ بَیْنَکُمْ وَبَیْنَہُمْ مِیثَاقٌ} ، قَالاَ : الرَّجُلُ یُسْلِمُ فِی دَارِ الْحَرْبِ فَیَقْتُلُہُ الرَّجُلُ ، لَیْسَ عَلَیْہِ الدِّیَۃُ ، وَعَلَیْہِ الْکَفَّارَۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28579","","","كتاب الديات"
"28580","(۲۸۵۸۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ فِی قَوْلِہِ تَعَالَی : {وَمَنْ قَتَلَ مُؤْمِنًا خَطَأً فَتَحْرِیرُ رَقَبَۃٍ مُؤْمِنَۃٍ وَدِیَۃٌ مُسَلَّمَۃٌ إِلَی أَہْلِہِ} ، إِذَا قُتِلَ الْمُسْلِمُ فَہَذَا لَہُ وَلِوَرَثَتِہِ الْمُسْلِمِینَ ، {فَإِنْ کَانَ مِنْ قَوْمٍ عَدُوٍّ لَکُمْ وَہُوَ مُؤْمِنٌ}، الرَّجُلُ الْمُسْلِمُ یقْتَلُ وَقَوْمُہُ مُشْرِکُونَ، لَیْسَ بَیْنَہُمْ وَبَیْنَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَہْدٌ، فَعَلَیْہِ تَحْرِیرُ رَقَبَۃٍ مُؤْمِنَۃٍ ، وَإِنْ قَتَلَ مُسْلِمًا مِنْ قَوْمٍ مُشْرِکِینَ وَبَیْنَہُمْ وَبَیْنَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَہْدٌ ، فَعَلَیْہِ تَحْرِیرُ رَقَبَۃٍ مُؤْمِنَۃٍ ، وَتُؤَدَی دِیَتُہُ إِلَی قَوْمِہِ الَّذِینَ بَیْنَہُمْ وَبَیْنَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَہْدٌ ، فَیَکُونُ مِیرَاثُہُ لِلْمُسْلِمِینَ ، وَیَکُونُ عَقْلُہُ لِقَوْمِہِ الْمُشْرِکِینَ الَّذِینَ بَیْنَہُمْ وَبَیْنَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَہْدٌ ، فَیَرِثُ الْمُسْلِمُونَ مِیرَاثَہُ ، وَیَکُونُ عَقْلُہُ لِقَوْمِہِ لأَنَّہُمْ یَعْقِلُونَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 28580","","","كتاب الديات"
"28581","(۲۸۵۸۱) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَن عِیسَی بْنِ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ؛ فِی قَوْلِہِ : {وَإِنْ کَانَ مِنْ قَوْمٍ بَیْنَکُمْ وَبَیْنَہُمْ مِیثَاقٌ} ، قَالَ : مِنْ أَہْلِ الْعَہْدِ وَلَیْسَ بِمُؤْمِنٍ۔","","Musannaf Ibn Abi Shaybah 28581","","","كتاب الديات"
"28582","(۲۸۵۸۲) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا عَمَّارُ بْنُ رُزَیْقٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی یَحْیَی ، عَنِ ابْنِ عَبَّاسٍ ؛ {فَإِنْ کَانَ مِنْ قَوْمٍ عَدُوٍّ لَکُمْ وَہُوَ مُؤْمِنٌ فَتَحْرِیرُ رَقَبَۃٍ مُؤْمِنَۃٍ} قَالَ : کَانَ الرَّجُلُ یَأْتِی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَیُسْلِمُ ، ثُمَّ یَرْجِعُ إِلَی قَوْمِہِ فَیَکُونُ فِیہِمْ وَہُمْ مُشْرِکُونَ ، فَیُصِیبُہُ الْمُسْلِمُونَ خَطَأً فِی سَرِیَّۃٍ ، أَوْ غَزَاۃٍ ، فَیُعْتِقُ الَّذِی یُصِیبُہُ رَقَبَۃً ، {وَإِنْ کَانَ مِنْ قَوْمٍ بَیْنَکُمْ وَبَیْنَہُمْ مِیثَاقٌ} ، قَالَ : ہُوَ الرَّجُلُ یَکُونُ مُعَاہَدًا ، وَیَکُونُ قَوْمُہُ أَہْلَ عَہْدٍ ، فَیُسْلَمُ إِلَیْہِم الدِّیَۃُ ، وَیُعْتِقُ الَّذِی أَصَابَہُ رَقَبَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 28582","","","كتاب الديات"
"28583","(۲۸۵۸۳) حَدَّثَنَا یَحْیَی بْنُ عَبْدِ الْمَلِکِ بْنِ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ؛ أَنَّ الْعَبَّاسَ بْنَ عَبْدِ الْمُطَّلِبِ لَطَمَ رَجُلاً ، فَأَقَادَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنَ الْعَبَّاسِ ، فَعَفَا عَنْہُ۔ (نسائی ۶۹۷۷)","","Musannaf Ibn Abi Shaybah 28583","","","كتاب الديات"
"28584","(۲۸۵۸۴) حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ الْمَسْعُودِیُّ : عَبْدِ اللہِ بْنِ عَبْدِ الْمَلِکِ بْنِ أَبِی عُبَیْدَۃَ ، عَن نَاجِیَۃَ أَبِی الْحَسَنِ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا قَالَ فِی رَجُلٍ لَطَمَ رَجُلاً ، فَقَالَ لِلْمَلْطُومِ : اقْتَصَّ۔","Da'if","Musannaf Ibn Abi Shaybah 28584","","","كتاب الديات"
"28585","(۲۸۵۸۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الْحَسَنِ بْنِ صَالِحٍ ، عَن مُخَارِقٍ ، عَن طَارِقِ بْنِ شِہَابِ ؛ أَنَّ خَالِدَ بْنَ الْوَلِیدِ أَقَادَ رَجُلاً مِنْ مُرَادٍ مِنْ لَطْمَۃٍ لَطَمَ ابْنَ أَخِیہِ۔","Sahih","Musannaf Ibn Abi Shaybah 28585","","","كتاب الديات"
"28586","(۲۸۵۸۶) حَدَّثَنَا شَرِیکٌ ، عَن مُخَارِقٍ ، عَن طَارِقٍ ؛ أَنَّ خَالِدَ بْنَ الْوَلِیدِ أَقَادَ مِنْ لَطْمَۃ۔","Hasan","Musannaf Ibn Abi Shaybah 28586","","","كتاب الديات"
"28587","(۲۸۵۸۷) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ شُرَیْحٍ ؛ أَنَّہُ أَقَادَ مِنْ لَطْمَۃٍ وَخُمَاشٍ۔","","Musannaf Ibn Abi Shaybah 28587","","","كتاب الديات"
"28588","(۲۸۵۸۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ شُرَیْحٍ ؛ أَنَّہُ أَقَادَ مِنْ لَطْمَۃٍ۔","","Musannaf Ibn Abi Shaybah 28588","","","كتاب الديات"
"28589","(۲۸۵۸۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنِ ابْنِ الزُّبَیْرِ ؛ أَنَّہُ أَقَادَ مِنْ لَطْمَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 28589","","","كتاب الديات"
"28590","(۲۸۵۹۰) حَدَّثَنَا أَبُو عَبْدِالرَّحْمَنِ الْمَسْعُودِیُّ، عَن زُرَارَۃَ بْنِ یَحْیَی، عَنْ أَبِیہِ؛ أَنَّ الْمُغِیرَۃَ بْنَ عَبْدِاللہِ أَقَادَ مِنْ لَطْمَۃٍ۔","","Musannaf Ibn Abi Shaybah 28590","","","كتاب الديات"
"28591","(۲۸۵۹۱) حَدَّثَنَا شَبَابَۃُ، عَنْ شُعْبَۃَ، عَنْ یَحْیَی بْنِ الْحُصَیْنِ، قَالَ: سَمِعْتُ طَارِقَ بْنَ شِہَابٍ ، یَقُولُ : لَطَمَ أَبُوبَکْرٍ یَوْمًا رَجُلاً لَطْمَۃً، فَقِیلَ: مَا رَأَیْنَا کَالْیَوْمِ قَطُّ، مَنْعَہُ وَلَطْمَہُ، فَقَالَ أَبُوبَکْرٍ: إِنَّ ہَذَا أَتَانِی لِیَسْتَحْمِلُنِی، فَحَمَلْتُہُ فَإِذَا ہُوَ یَبیعُہُمْ ، فَحَلَفْت أَنْ لاَ أَحْمِلَہُ : وَاللَّہِ لاَ حَمَلْتُہُ ، ثَلاَثَ مَرَّاتٍ ، ثُمَّ قَالَ لَہُ : اقْتَصَّ ، فَعَفَا الرَّجُلُ۔","Sahih","Musannaf Ibn Abi Shaybah 28591","","","كتاب الديات"
"28592","(۲۸۵۹۲) حَدَّثَنَا وَکِیعٌ ، عَن حَسَنِ بْنِ صَالِحٍ ، قَالَ : قُلْتُ لاِبْنِ أَبِی لَیْلَی : أقَدْتَ مِنْ لَطْمَۃٍ ؟ قَالَ : نَعَمْ ، وَمِنْ لَطَمَاتٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 28592","","","كتاب الديات"
"28593","(۲۸۵۹۳) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، عَن مَسْرُوقٍ ؛ أَنَّہُ أَقَادَ مِنْ لَطْمَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 28593","","","كتاب الديات"
"28594","(۲۸۵۹۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّ جِلْوَازًا قَنَعَ رَجُلاً بِسَوْطٍ ، فَأَقَادَہُ مِنْہُ شُرَیْحٌ۔","","Musannaf Ibn Abi Shaybah 28594","","","كتاب الديات"
"28595","(۲۸۵۹۵) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنْ فُضَیْلٍ ، عَنْ عَبْدِاللہِ بْنِ مغفلٍ، قَالَ: کُنْتُ جَالِسًا عَندَ عَلِیٍّ، فَجَائَہُ رَجُلٌ فَسَارَّہُ ، فَقَالَ عَلِیٌّ : یَا قَنْبَرُ ، فَقَالَ النَّاسُ : یَا قَنْبَرُ ، قَالَ : أَخْرِجْ ہَذَا فَاجْلِدْہُ ، ثُمَّ جَائَ الْمَجْلُودُ، فَقَالَ : إِنَّہُ قَدْ زَادَ عَلَیَّ ثَلاَثَۃَ أَسْوَاطٍ ، فَقَالَ لَہُ عَلِیٌّ : مَا یَقُولُ ؟ قَالَ : صَدَقَ یَا أَمِیرَ الْمُؤْمِنِینَ ، قَالَ : خُذِ السَّوْطَ فَاجْلِدْہُ ثَلاَثَۃَ أَسْوَاطٍ ، ثُمَّ قَالَ : یَا قَنْبَرُ ، إِذَا جَلَدْتَ فَلاَ تَعْد الْحُدُودَ۔","Da'if","Musannaf Ibn Abi Shaybah 28595","","","كتاب الديات"
"28596","(۲۸۵۹۶) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، وَالْحَکَمِ ، وَحَمَّادٍ ، قَالُوا : مَا أُصِیبَ بِہِ سَوْطٍ ، أَوْ عَصًا، أَوْ حَجَرٍ ، فَکَانَ دُونَ النَّفْسِ فَہُوَ عَمْدٌ ، دِیَتُہُ الْقَوَدُ۔","","Musannaf Ibn Abi Shaybah 28596","","","كتاب الديات"
"28597","(۲۸۵۹۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ فِی رَجُلٍ اسْتَعَارَ مِنْ رَجُلٍ فَرَسًا ، فَرَکضَہُ حَتَّی مَاتَ ، قَالَ : لَیْسَ عَلَیْہِ ضَمَانٌ لأَنَّ الرَّجُلَ یُرْکِضُ فَرَسَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28597","","","كتاب الديات"
"28598","(۲۸۵۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ فِی رَجُلٍ أَعْطَی رَجُلاً فَرَسًا فَقَتَلَہُ ، قَالَ : لاَ یَضْمَنُ ، إِلاَّ أَنْ یَکُونَ عَبْدًا ، أَوْ صَبِیًّا۔","No Data Available","Musannaf Ibn Abi Shaybah 28598","","","كتاب الديات"
"28599","(۲۸۵۹۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ فِی رَجُلٍ قَتَلَ رَجُلاً قَدْ ذَہَبَتِ الرُّوحُ مِنْ نِصْفِ جَسَدِہِ ، قَالَ : یُضَمَّنُہُ۔","","Musannaf Ibn Abi Shaybah 28599","","","كتاب الديات"
"28600","(۲۸۶۰۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : مَنْ أَوْقَفَ دَابَّتَہُ فِی طَرِیقِ الْمُسْلِمِینَ ، أَوْ وَضَعَ شَیْئًا ، فَہُوَ ضَامِنٌ لِجِنَایَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28600","","","كتاب الديات"
"28601","(۲۸۶۰۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ أَشْعَثَ ؛ عَنِ الشَّعْبِیِّ (ح) وَعَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالاَ : مَنْ رَبَطَ دَابَّۃً فِی طَرِیقٍ فَہُوَ ضَامِنٌ۔","","Musannaf Ibn Abi Shaybah 28601","","","كتاب الديات"
"28602","(۲۸۶۰۲) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یُوَقِّتُ فِی الْہَاشِمَۃِ شَیْئًا۔","No Data Available","Musannaf Ibn Abi Shaybah 28602","","","كتاب الديات"
"28603","(۲۸۶۰۳) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ؛ أَنَّ عَبْدَ الْمَلِکِ بْنَ مَرْوَانَ قَضَی فِی الدَّامِیَۃِ بِبَعِیرٍ ، وَفِی الْبَاضِعَۃِ بِبَعِیرَیْنِ ، وَقَضَی فِی الْمُتَلاَحِمَۃِ بِثَلاَثَۃِ أَبْعِرَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 28603","","","كتاب الديات"
"28604","(۲۸۶۰۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ (ح) وَعَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی الْعَبْدَیْنِ یَفْقَأُ أَحَدُہُمَا عَیْنَ صَاحِبِہِ ، قَالَ : إِنْ کَانَتْ قِیمَتُہُمَا سَوَائً ، فَالْعَیْنُ بِالْعَیْنِ ، وَإِنْ کَانَتْ قِیمَۃُ أَحَدِہِمَا أَکْثَرَ مِنَ الآخَرِ ، رُدَّ الأَکْثَرُ عَلَی الأَقَلِّ۔","No Data Available","Musannaf Ibn Abi Shaybah 28604","","","كتاب الديات"
"28605","(۲۸۶۰۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : الْعَبْدُ یَقْتُلُ الْعَبْدَ عَمْدًا ، وَالْمَقْتُولُ خَیْرٌ مِنَ الْقَاتِلِ ؟ قَالَ : لَیْسَ لِسَادَۃِ الْمَقْتُولِ إِلاَّ قَاتِلُ عَبْدِہِمْ ، لَیْسَ لَہُمْ غَیْرَہُ۔ وَقَالَہَا عَمْرُو بْنُ دِیِنَارٍ : لَیْسَ لَہُمْ إِلاَّ قَاتِلُ عَبْدِہِم ، إِنْ شَاؤُوا قَتَلُوہُ ، وَإِنْ شَاؤُوا اسْتَرَقوہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28605","","","كتاب الديات"
"28606","(۲۸۶۰۶) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ زِیَادِ بْنِ مُسْلِمٍ ؛ أَنَّ رَجُلاً مِنْ أَہْلِ الْہِنْدِ قَدِمَ بِأَمَانٍ عَدَنَ ، فَقَتَلَہُ رَجُلٌ مِنَ الْمُسْلِمِینَ بِأَخِیہِ ، فَکَتَبَ فِی ذَلِکَ إِلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ فَکَتَبَ : أَنْ لاَ تَقْتُلْہُ وَخُذْ مِنْہُ الدِّیَۃَ ، فَابْعَثْ بِہَا إِلَی وَرَثَتِہِ ، وَأَمَرَ بِہِ فَسُجِنَ۔","","Musannaf Ibn Abi Shaybah 28606","","","كتاب الديات"
"28607","(۲۸۶۰۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَن یُوسُفَ بْنِ یَعْقُوبَ ؛ أَنَّ رَجُلاً مِنَ الْمُشْرِکِینَ قَتَلَ رَجُلاً مِنَ الْمُسْلِمِینَ ، ثُمَّ دَخَلَ بِأَمَانٍ فَقَتَلَہُ أَخُوہُ ، فَقَضَی عَلَیْہِ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ بِالدِّیَۃِ ،وَجَعَلَہَا عَلَیْہِ فِی مَالِہِ ، وَحَبَسَہُ فِی السِّجْنِ ، وَبَعَثَ بِدِیَتِہِ إِلَی وَرَثَتِہِ مِنْ أَہْلِ الْحَرْبِ۔","","Musannaf Ibn Abi Shaybah 28607","","","كتاب الديات"
"28608","(۲۸۶۰۸) حَدَّثَنَا الثَّقَفِیُّ ، عَن حَبِیبٍ الْمُعَلِّمِ ، عَنِ الْحَسَنِ ؛ أَنَّ رَجُلاً مِنَ الْمُشْرِکِینَ حَجَّ ، فَلَمَّا رَجَعَ صَادِرًا لَقِیَہُ رَجُلٌ مِنَ الْمُسْلِمِینَ فَقَتَلَہُ ، فَأَمَرَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُؤَدِّی دِیَتَہُ إِلَی أَہْلِہِ۔ (ابوداؤد ۳۶۷)","Hasan","Musannaf Ibn Abi Shaybah 28608","","","كتاب الديات"
"28609","(۲۸۶۰۹) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ أَبِی حُرَّۃَ ، عَنِ الْحَسَنِ ؛ فِی قَوْمٍ لَقُوا العَدُو فَاسْتَأْجَلُوہُمْ خَمْسَۃَ أَیَّامٍ ، فَقُتِلَ بَیْنَہُمْ قَتِیلٌ ، قَالَ : عَلَی الْمُسْلِمِینَ دِیَتُہُ۔","","Musannaf Ibn Abi Shaybah 28609","","","كتاب الديات"
"28610","(۲۸۶۱۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَبِی طَلْقٍ ، عَنْ أُخْتِہِ ہِنْدِ بِنْتِ طَلْقٍ ، قَالَتْ : کُنْتُ فِی نِسْوَۃٍ وَصَبِیٌّ مُسَجًّی ، قَالَتْ : فَمَرَّتِ امْرَأَۃٌ فَوَطَئَتْہُ ، قُلْتُ : الصَّبِیَّ قَتَلَتْہُ وَاللَّہِ ، قَالَتْ : فَشَہِدْنَ عِندَ عَلِیٍّ عَشْرُ نِسْوَۃٍ ، أَنَا عَاشِرَتُہُنَّ ، فَقَضَی عَلَیْہَا بِالدِّیَۃِ ، وَأَعَانَہَا بِأَلْفَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 28610","","","كتاب الديات"
"28611","(۲۸۶۱۱) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ أَبِی حَنِیفَۃَ ، عَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ یَکُونُ التَّغْلِیظُ فِی شَیْئٍ مِنَ الدِّیَۃِ ، إِلاَّ فِی الإِبِلِ ، وَالتَّغْلِیظُ فِی إِنَاثِ الإِبِلِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28611","","","كتاب الديات"
"28612","(۲۸۶۱۲) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ؛ فِی امْرَأَۃٍ ضُرِبَتْ فَأَسْقَطَتْ ثَلاَثَۃَ أَسْقَاطٍ ، قَالَ : أَرَی أَنَّ فِی کُلِّ وَاحِدٍ مِنْہُمْ غُرَّۃً ، کَمَا أَنَّ فِی کُلِّ وَاحِدٍ مِنْہُم الدِّیَۃَ۔","","Musannaf Ibn Abi Shaybah 28612","","","كتاب الديات"
"28613","(۲۸۶۱۳) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : أَرَی الْعُطَاسَ اسْتِہْلاَلاً۔","","Musannaf Ibn Abi Shaybah 28613","","","كتاب الديات"
"28614","(۲۸۶۱۴) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا إِسْرَائِیلُ ، عَن سِمَاکٍ، عَن عِکْرِمَۃَ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: اسْتِہْلاَلُہُ صِیَاحُہُ۔","","Musannaf Ibn Abi Shaybah 28614","","","كتاب الديات"
"28615","(۲۸۶۱۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَن سُلَیْمَانَ بْنِ بِلاَلٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، قَالَ : الاِسْتِہْلاَلُ النِّدَائُ ، أَوِ الْعُطَاسُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28615","","","كتاب الديات"
"28616","(۲۸۶۱۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَن زَائِدَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : الاِسْتِہْلاَلُ الصِّیَاحُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28616","","","كتاب الديات"
"28617","(۲۸۶۱۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَن صَاعِدِ بْنِ مُسْلِمٍ ، عَنِ الشَّعْبِیِّ ؛ فِی اللِّحْیَۃِ الدِّیَۃُ ، إِذَا نُتِفَتْ فَلَمْ تَنْبُتْ۔","","Musannaf Ibn Abi Shaybah 28617","","","كتاب الديات"
"28618","(۲۸۶۱۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ ، کَانَ عُمَرُ بْنُ الْخَطَّابِ یُعَدِّی الْمَمْلُوکَ عَلَی سَیِّدِہِ إِذَا اسْتَعْدَاہُ ، قَالَ مُحَمَّدٌ : اسْتَعْدَی أَبِی عَلَی أَنَسٍ عُمَرَ۔","Sahih","Musannaf Ibn Abi Shaybah 28618","","","كتاب الديات"
"28619","(۲۸۶۱۹) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَارِثِ ؛ أَنَّ عَبْدًا أَتَی عَلِیًّا قَدْ وَسَمَہُ أَہْلُہُ ، فَأَعْتَقَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 28619","","","كتاب الديات"
"28620","(۲۸۶۲۰) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَن حَمَّادٍ، عَنْ إِبْرَاہِیمَ، قَالَ: إِذَا دَخَلَ اللِّصُّ دَارَ الرَّجُلِ فَقَتَلَہُ فَلاَ ضِرَارَ عَلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28620","","","كتاب الديات"
"28621","(۲۸۶۲۱) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : اقْتُلِ اللِّصَّ وَأَنَا ضَامِنٌ أَنْ لاَ تَتْبَعَک مِنْہُ تَبِعَۃٌ۔","","Musannaf Ibn Abi Shaybah 28621","","","كتاب الديات"
"28622","(۲۸۶۲۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمِ بْنِ عَبْدِ اللہِ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ وَجَدَ سَارِقًا فِی بَیْتِہِ ، فَأَصْلَتَ عَلَیْہِ بِالسَّیْفِ ، وَلَوْ تَرَکْنَاہُ لَقَتَلَہُ۔","","Musannaf Ibn Abi Shaybah 28622","","","كتاب الديات"
"28623","(۲۸۶۲۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عنْ حُمَیْدِ بْنِ ہِلاَلٍ ، عَن حُجَیْرِ بْنِ الرَّبِیعِ ، قَالَ : قُلْتُ لِعِمْرَانَ بْنِ حُصَیْنٍ : أَرَأَیْتَ إِنْ دَخَلَ عَلَیَّ دَاخِلٌ ، یُرِیدُ نَفْسِی وَمَالِی ؟ فَقَالَ : لَوْ دَخَلَ عَلَیَّ دَاخِلٌ یُرِیدُ نَفْسِی وَمَالِی، لَرَأَیْتُ أَنْ قَدْ حَلَّ لِی قَتْلُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 28623","","","كتاب الديات"
"28624","(۲۸۶۲۴) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَن سِمَاکٍ ، عَن قَابُوسَ بْنِ الْمُخَارِقِ ، عَنْ أَبِیہِ ، قَالَ : أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلٌ ، فَقَالَ : یَا رَسُولَ اللہِ ، الرَّجُلُ یَأْتِینِی یُرِیدُ مَالِی ؟ قَالَ : ذَکِّرْہُ اللَّہَ ، قَالَ : فَإِنْ لَمْ یَذْکُرْ ؟ قَالَ : فَاسْتَعِنْ عَلَیْہِ بِمَنْ حَوْلَک مِنَ الْمُسْلِمِینَ ، قَالَ : فَإِنْ لَمْ یَکُنْ أَحَدٌ حَوْلِی مِنَ الْمُسْلِمِینَ ؟ قَالَ : فَاسْتَعِنْ عَلَیْہِ بِالسُّلْطَانِ ، قَالَ : فَإِنْ نَأَی عَنِّی السُّلْطَانُ ؟ قَالَ : فَقَاتِلْ دُونَ مَالِکَ حَتَّی تَمْنَعَ مَالَک ، وَتَکُونَ فِی شُہَدَائِ الآخِرَۃِ۔ (احمد ۲۹۴۔ طبرانی ۷۴۷)","Hasan","Musannaf Ibn Abi Shaybah 28624","","","كتاب الديات"
"28625","(۲۸۶۲۵) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : سَمِعْتُہ یَقُولُ : مَا عَلِمْت أَنَّ أَحَدًا مِنَ الْمُسْلِمِینَ تَرَکَ قِتَالَ رَجُلٍ یَقْطَعُ عَلَیْہِ الطَّرِیقَ ، أَوْ یَطْرُقُہُ فِی بَیْتِہِ تَأَثُّمًا مِنْ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 28625","","","كتاب الديات"
"28626","(۲۸۶۲۶) حَدَّثَنَا عَبَّادٌ ، عَنْ عَوْفٍ ، عَنِ الْحَسَنِ ، قَالَ : اقْتُلِ اللِّصَّ ، وَالْحَرُورِیَّ ، وَالْمُسْتَعْرِضَ۔","","Musannaf Ibn Abi Shaybah 28626","","","كتاب الديات"
"28627","(۲۸۶۲۷) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَن عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَن نَافِعٍ ، قَالَ : أَصْلَتَ ابْنُ عُمَرَ عَلَی لِصٍّ بِالسَّیْفِ ، فَلَوْ تَرَکْنَاہُ لَقَتَلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 28627","","","كتاب الديات"
"28628","(۲۸۶۲۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَن طَلْحَۃَ بْنِ عَبْدِ اللہِ ، عَنْ سَعِیدِ بْنِ زَیْدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قُتِلَ دُونَ مَالِہِ فَہُوَ شَہِیدٌ۔ (ابوداؤد ۴۷۳۹۔ ترمذی ۱۴۲۱)","Sahih","Musannaf Ibn Abi Shaybah 28628","","","كتاب الديات"
"28629","(۲۸۶۲۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ قُتِلَ دُونَ مَالِہِ فَہُوَ شَہِیدٌ۔ (بخاری ۲۴۸۰۔ ابوداؤد ۴۷۳۸)","","Musannaf Ibn Abi Shaybah 28629","","","كتاب الديات"
"28630","(۲۸۶۳۰) حَدَّثَنَا ہشیم ، عن جریر ، عن الضحاک ، عن ابن عباس، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ قُتِلَ دُونَ مَالِہِ فَہُوَ شَہِیدٌ۔ (احمد ۳۰۵۔ طبرانی ۱۲۶۴۲)","Da'if","Musannaf Ibn Abi Shaybah 28630","","","كتاب الديات"
"28631","(۲۸۶۳۱) حَدَّثَنَا مَرْوَانُ ، عَنْ یَزِیدَ بْنِ سِنَانٍ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قُتِلَ دُونَ مَالِہِ فَہُوَ شَہِیدٌ۔ (ابن ماجہ ۲۵۸۱)","Da'if","Musannaf Ibn Abi Shaybah 28631","","","كتاب الديات"
"28632","(۲۸۶۳۲) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ جَابِرٍ، عَنْ عَامِرٍ، قَالَ: سَأَلَہُ ابْنُ ہُبَیْرَۃَ عَنِ الْعَقْلِ عَلَی رُؤُوسِ الرِّجَالِ، أَوْ عَلَی الأَعْطِیَۃِ ؟ قَالَ : لاَ ، بَلْ عَلَی رُؤُوسِ الرِّجَالِ۔","","Musannaf Ibn Abi Shaybah 28632","","","كتاب الديات"
"28633","(۲۸۶۳۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَمِعْتُ سُفْیَانَ یَقُولُ : الْعَقْلُ ، وَالْقَسَامَۃُ ، وَالشُّفْعَۃُ عَلَی رُؤُوسِ الرِّجَالِ۔","","Musannaf Ibn Abi Shaybah 28633","","","كتاب الديات"
"28634","(۲۸۶۳۴) حَدَّثَنَا جَرِیرٌ ، عَن رَقَبَۃَ ، عَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی الْجَرَّۃِ تُوضَعُ عَلَی الْجِدَارِ فَتُصِیبُ إِنْسَانًا، قَالَ: إِنْ کَانَ أَصْلُ الْجِدَارِ لِصَاحِبِ الْجَرَّۃِ لَمْ یَضْمَنْ مَا أَصَابَتْ، وَفِی الشَّیْئِ یُوضَعُ عَلَیْہِ الشَّیْئِ مِنْ مِلْکِہِ۔","","Musannaf Ibn Abi Shaybah 28634","","","كتاب الديات"
"28635","(۲۸۶۳۵) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : أَخْبَرَنَی أَشْعَثُ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی أَنْ یَقْتَصَّ الرَّجُلُ مِنَ الرَّجُلَیْنِ فِیمَا دُونَ النَّفْسِ۔","","Musannaf Ibn Abi Shaybah 28635","","","كتاب الديات"
"28636","(۲۸۶۳۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، کَانَ یَقُولُ : إِذَا قُتِلَتِ الْمَرْأَۃُ وَہِیَ حَامِلٌ فِدْیَۃٌ وَغُرَّۃٌ ، وَإِنْ لَمْ تُلْقِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28636","","","كتاب الديات"
"28637","(۲۸۶۳۷) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ؛ فِی الْمَرْأَۃِ تُقْتَلُ وَہِیَ حَامِلٌ ، فِی جَنِینِہَا شَیْئٌ ؟ قَالَ: کَانَ یَقُولُ : لَیْسَ فِیہَا شَیْئٌ حَتَّی تَقْذِفَہُ۔","","Musannaf Ibn Abi Shaybah 28637","","","كتاب الديات"
"28638","(۲۸۶۳۸) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَن مُوسَی بْنِ أَبِی الْفُرَاتِ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ قَالَ : أَیُّمَا عَبْدٍ قَتَلَ عَبْدًا عَمْدًا فَاقْتُلْہُ بِہِ ، وَثَمَنُ الأَوَّلِ فَأَخْرِجْہُ مِنْ بَیْتِ الْمَالِ ، فَأَعْطِہِ مَوَالِیَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28638","","","كتاب الديات"
"28639","(۲۸۶۳۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، قَالَ : کَتَبَ عَدِیُّ بْنُ أَرْطَاۃَ قَاضِی الْبَصْرَۃِ إِلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ : إِنِّی وَجَدْتُ قَتِیلاً فِی سُوقِ الْجَزَّارِینَ ؟ فَقَالَ : أَمَّا الْقَتِیلُ فَدِیَتُہُ مِنْ بَیْتِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 28639","","","كتاب الديات"
"28640","(۲۸۶۴۰) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنِ الْمُکَارِی یَسُوقُ بِالْمَرْأَۃِ ؟ فَأَکْثَرُ عِلْمِی أَنَّہُمَا قَالاَ : لَیْسَ عَلَیْہِ ضَمَانٌ۔","","Musannaf Ibn Abi Shaybah 28640","","","كتاب الديات"
"28641","(۲۸۶۴۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْمُجَالِدِ ، قَالَ : حدَّثَنَی عَرِیفٌ لِجُہَیْنَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أُوتِیَ بِأَسِیرٍ فِی الشِّتَائِ ، فَقَالَ لأُِنَاسٍ مِنْ جُہَیْنَۃَ : اذْہَبُوا بِہِ فَأَدْفُوہُ ، قَالَ : وَکَانَ الدَّفْئُ بِلِسَانِہِمْ عِنْدَہُمُ الْقَتْلَ ، فَذَہَبُوا بِہِ فَقَتَلُوہُ ، فَسَأَلَہُمُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعْدُ ؟ فَقَالُوا : یَا رَسُولَ اللہِ ، أَلَمْ تَأْمُرْنَا أَنْ نَقْتُلَہُ ، قَالَ: وَکَیْفَ قُلْتُ لَکُمْ؟ قَالَ : قُلْتَ لَنَا: اذْہَبُوا بِہِ فَأَدْفُوہُ، قَالَ: فَقَالَ: قَدْ شَرِکْتُکُمْ إِذًا، اعْقِلُوہُ وَأَنَا شَرِیکُکُمْ۔n قَالَ : فَحَدَّثْتُ ہَذَا الْحَدِیثَ عَامِرًا ، قَالَ : صَدَقَ ، وَعَرَفَ الْحَدِیثَ۔","Da'if","Musannaf Ibn Abi Shaybah 28641","","","كتاب الديات"
"28642","(۲۸۶۴۲) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : نَذَرَتِ امْرَأَۃٌ أَنْ تُقَادَ مَزْمُومَۃً بِزِمَامٍ فِی أَنْفِہَا ، فَوَقَعَ بَعِیرُہَا ، فَانْقَطَعَ زِمَامُہَا ، فَخُرِمَ أَنْفُہَا ، فَأَتَتْ عَلِیًّا تَطْلُبُ عَقْلَہَا ، فَأَبْطَلَہُ وَقَالَ : إِنَّمَا نَذَرْتِیہِ لِلَّہِ۔","","Musannaf Ibn Abi Shaybah 28642","","","كتاب الديات"
"28643","(۲۸۶۴۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ عَطَائٌ : إِنْ قَتَلَ رَجُلٌ رَجُلاً خَطَأً ثُمَّ آخَرَ عَمْدًا ، قَالَ: فَلْیُؤَدِّ الْخَطَأَ مِنْ أَجْلِ أَنَّہُ قَدْ ثَبَتَ عَقْلُہُ قَبْلَ الْعَمْدِ ، قَالَ لَہُ إِنْسَانٌ : وَقَتَلَ عَمْدًا ، ثُمَّ قَتَلَ خَطَأً ؟ قَالَ : فَلاَ یُؤَدِّ ، مِنْ أَجْلِ إِنَّہُ قَدْ غُلِقَ دَمہُ۔","","Musannaf Ibn Abi Shaybah 28643","","","كتاب الديات"
"28644","(۲۸۶۴۴) حَدَّثَنَا مُحَمَّدٌ بْنُ بَکْرِ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : رَجُلٌ قَتَلَ رَجُلاً عَمْدًا ، فَفَرَّ فَلَمْ یُقْدَرْ عَلَیْہِ حَتَّی مَاتَ ، وَتَرَکَ مَالاً ، فَدِیَتُہُ فِی مَالِہِ دِیَۃُ الْمَقْتُولِ ، قِیلَ لَہُ : سُجِنَ الْقَاتِلُ حَتَّی مَاتَ ؟ قَالَ : قَدْ قَتَلُوہُ ، حَبَسُوہُ حَتَّی مَاتَ فِی السِّجْنِ۔","","Musannaf Ibn Abi Shaybah 28644","","","كتاب الديات"
"28645","(۲۸۶۴۵) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَن صَاعِدِ بْنِ مُسْلِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : سُئِلَ عَن قَتِیلٍ وُجِدَ فِی ثَلاَثَۃِ أَحْیَائٍ ؛ رَأْسُہُ فِی حَیٍّ ، وَرِجْلاَہُ فِی حَیٍّ ، وَوَسَطُہُ فِی حَیٍّ ، قَالَ الشَّعْبِیُّ : یُصَلَّی عَلَی الْوَسَطِ ، وَعَلَی أَہْلِ الْوَسَطِ الدِّیَۃُ ، وَقَسَامَۃٌ : مَا قَتَلْنَا ، وَلاَ عَلِمْنَا قَاتِلاً۔","","Musannaf Ibn Abi Shaybah 28645","","","كتاب الديات"
"28646","(۲۸۶۴۶) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَن عِکْرِمَۃَ قَالَ : لَیْسَ فِی دِیَۃِ الدَّنَانِیرِ وَالدَّرَاہِمِ مُغَلَّظَۃٌ ، إِنَّمَا الْمُغَلَّظَۃُ فِی الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 28646","","","كتاب الديات"
"28647","(۲۸۶۴۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنِ الْقَاسِمِ بْنِ الْفَضْلِ ، عَن ہَارُونَ ، عَن عِکْرِمَۃَ ؛ فِی رَجُلٍ قَتَلَ بَعْدَ أَخْذِہِ الدِّیَۃَ، قَالَ : یُقْتَلُ ، أَمَا سَمِعْتَ اللَّہَ یَقُولُ : (فَلَہُ عَذَابٌ أَلِیمٌ)؟ ۔","","Musannaf Ibn Abi Shaybah 28647","","","كتاب الديات"
"28648","(۲۸۶۴۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَن یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : یُؤْخَذُ مِنْہُ الدِّیَۃُ وَلاَ یُقْتَلُ۔","","Musannaf Ibn Abi Shaybah 28648","","","كتاب الديات"
"28649","(۲۸۶۴۹) حَدَّثَنَا أَبُو دَاوُدَ ، عَن وَہْبٍ ، عَن یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ قُتِلَ لَہُ قَتِیلٌ ، فَعَفَا عَنْہُ ، ثُمَّ رَاحَ فَقَتَلَہُ ، قَالَ الْحَسَنُ : لاَ یُقْتَلُ۔","","Musannaf Ibn Abi Shaybah 28649","","","كتاب الديات"
"28650","(۲۸۶۵۰) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَن زُہَیْرٍ ، عَنْ جَابِرٍ ؛ فِی امْرَأَۃٍ حَمَلَتْ مِنَ الزِّنَی ، فَحُبِسَتْ لِتَضَعَ مَا فِی بَطْنِہَا ثُمَّ تُرْجَمُ ، فَدَخَلَ عَلَیْہَا رَجُلٌ فَقَتَلَہَا ، قَالَ : قَالَ عَامِرٌ : لاَ أَعْلَمُ فِیہَا شَیْئًا ، غَیْرَ أَنَّ الْوَلَدَ لِلسُّلْطَانِ ، یَحْکُمُ فِیہِ مَا شَائَn قَالَ : وَحَدَّثَنِی حَمَّادٌ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لَیْسَ أَحَدٌ مِنَ الْمُسْلِمِینَ بِأَحَقَّ بِہَا ، بَعْضُہُمْ مِنْ بَعْضٍ ، وَقَالَ حَمَّادٌ : فِی الْوَلَدِ غُرَّۃٌ۔","","Musannaf Ibn Abi Shaybah 28650","","","كتاب الديات"
"28651","(۲۸۶۵۱) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَن حَسَنٍ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، فِی صَاحِبِ الْمَعْبَرِ یَعْبُرُ بِدَوَابَّ فَغَرِقَتْ ، قَالَ : لاَ ضَمَانَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 28651","","","كتاب الديات"
"28652","(۲۸۶۵۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، وَابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَن زَیْدِ بْنِ ثَابِتٍ ، قَالَ : فِی شَحْمَۃِ الأُذُنِ ثُلُثُ دِیَۃِ الأُذُنِ۔","","Musannaf Ibn Abi Shaybah 28652","","","كتاب الديات"
"28653","(۲۸۶۵۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ عَامِرٍ ، قَالَ : اخْتُصِمَ إِلَی عَلِیٍّ فِی ثَوْرٍ نَطَحَ حِمَارًا فَقَتَلَہُ ، فَقَالَ عَلِیٌّ : إِنْ کَانَ الثَّوْرُ دَخَلَ عَلَی الْحِمَارِ فَقَتَلَہُ ، فَقَدْ ضَمِنَ ، وَإِنْ کَانَ الْحِمَارُ دَخَلَ عَلَی الثَّوْرِ فَقَتَلَہُ ، فَلاَ ضَمَانَ عَلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 28653","","","كتاب الديات"
"28654","(۲۸۶۵۴) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : یُقْتَصُّ لِبَعْضِہِمْ مِنْ بَعْضٍ ، ثُمَّ تُقَامُ الْحُدُودُ ، یَعْنِی فِی الْقَوْمِ یَجْرَحُ بَعْضُہُمْ بَعْضًا۔","","Musannaf Ibn Abi Shaybah 28654","","","كتاب الديات"
"28655","(۲۸۶۵۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لأُِسَامَۃَ : یَا أُسَامَۃُ، لاَ تَشْفَعْ فِی حَدٍّ ، وَکَانَ إِذَا شَفَعَ شَفَّعَہُ۔ (ابن سعد ۶۹)","No Data Available","Musannaf Ibn Abi Shaybah 28655","","","كتاب أقضية رسول الله ﷺ"
"28656","(۲۸۶۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَن وَاصِلٍ ، عَنْ أَبِی وَائِلٍ ، عَن کَعْبٍ ، قَالَ : لاَ یُشَفَّعْ فِی حَدٍّ۔","Sahih","Musannaf Ibn Abi Shaybah 28656","","","كتاب أقضية رسول الله ﷺ"
"28657","(۲۸۶۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عُرْوَۃَ ، عَنِ الْفُرَافِصَۃِ الْحَنَفِیِّ ، قَالَ : مَرُّوا عَلَی الزُّبَیْرِ بِسَارِقٍ فَتَشَفَّعَ لَہُ ، فَقَالُوا : أَتَشْفَعُ لِسَارِقٍ ؟ فَقَالَ : نَعَمْ ، مَا لَمْ یُؤْتَ بِہِ إِلَی الإِمَامِ ، فَإِذَا أُتِیَ بِہِ إِلَی الإِمَامِ ، فَلاَ عَفَا اللَّہُ عَنْہُ إِنْ عَفَا عَنْہُ۔","Hasan","Musannaf Ibn Abi Shaybah 28657","","","كتاب أقضية رسول الله ﷺ"
"28658","(۲۸۶۵۸) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ ہِشَامٍ ، عَنْ عَبْدِ اللہِ بْنِ عُرْوَۃَ ، عَنِ الْفُرَافِصَۃِ ، عَنِ الزُّبَیْرِ ، مِثْلَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 28658","","","كتاب أقضية رسول الله ﷺ"
"28659","(۲۸۶۵۹) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ الرُّؤَاسِیُّ ، عَنْ ہِشَامٍ ، عَنْ أَبِی حَازِمٍ ؛ أَنَّ عَلِیًّا شَفَعَ لِسَارِقٍ ، فَقِیلَ لَہُ، تَشْفَعُ لِسَارِقٍ ؟ فَقَالَ : نَعَمْ ، إِنَّ ذَلِکَ یُفْعَلُ مَا لَمْ یُبَلَّغْ بِہِ الإِمَامُ ، فَإِذَا بُلِّغَ بِہِ الإِمَامُ فَلاَ أَعْفَاہُ اللَّہُ إِنْ أَعْفَاہُ۔","","Musannaf Ibn Abi Shaybah 28659","","","كتاب أقضية رسول الله ﷺ"
"28660","(۲۸۶۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ عُبَیْدٍ ، عَن سُلَیْمَانَ بْنِ أَبِی کَبْشَۃَ ؛ أَنَّ سَارِقًا مَرَّ بِہِ عَلَی سَعِیدِ بْنِ جُبَیْرٍ ، وَعَطَائٍ فَشَفَعَا لَہُ ، فَقِیلَ لَہُمَا : وَتَرَیَانِ ذَلِکَ ؟ فَقَالاَ : نَعَمْ ، مَا لَمْ یُؤْتَ بِہِ إِلَی الإِمَامِ۔","","Musannaf Ibn Abi Shaybah 28660","","","كتاب أقضية رسول الله ﷺ"
"28661","(۲۸۶۶۱) حَدَّثَنَا عَبْدَۃُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ الْوَہَّابِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَنْ حَالَتْ شَفَاعَتُہُ دُونَ حَدٍّ مِنْ حُدُودِ اللہِ ، فَقَدْ ضَادَّ اللَّہَ فِی خَلْقِہِ۔ (ابوداؤد ۳۵۹۲۔ احمد ۷۰)","Sahih","Musannaf Ibn Abi Shaybah 28661","","","كتاب أقضية رسول الله ﷺ"
"28662","(۲۸۶۶۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کُلِّمَ فِی شَیْئٍ ، فَقَالَ : لَوْ کَانَتْ فَاطِمَۃُ ابْنَۃُ مُحَمَّدٍ لأَقَمْتُ عَلَیْہَا الْحَدَّ۔ (بخاری ۳۴۷۵۔ مسلم ۱۳۱۵)","Shadh","Musannaf Ibn Abi Shaybah 28662","","","كتاب أقضية رسول الله ﷺ"
"28663","(۲۸۶۶۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ طَلْحَۃَ بْنِ رُکَانَۃَ ، عَنْ أُمِّہِ عَائِشَۃَ بِنْتِ مَسْعُودِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہَا مَسْعُودٍ ، قَالَ : لَمَّا سَرَقَتِ الْمَرْأَۃُ تِلْکَ الْقَطِیفَۃَ مِنْ بَیْتِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَعْظَمْنَا ذَلِکَ ، وَکَانَتِ الْمَرْأَۃُ مِنْ قُرَیْشٍ ، فَجِئْنَا إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نُکَلِّمُہُ وَقُلْنَا : نَحْنُ نَفْدِیہَا بِأَرْبَعِینَ أُوقِیَّۃً ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَطَّہَّرُ خَیْرٌ لَہَا ، فَلَمَّا سَمِعْنَا لِینَ قَوْلِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَتَیْنَا أُسَامَۃَ ، فَقُلْنَا : کَلِّمْ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَلَمَّا رَأَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَلِکَ ، قَامَ خَطِیبًا ، فَقَالَ : مَا إِکْثَارُکُمْ عَلَیَّ فِی حَدٍّ مِنْ حُدُودِ اللہِ ، وَقَعَ عَلَی أَمَۃٍ مِنْ إِمَائِ اللہِ ؟ وَالَّذِی نَفْسِی بِیَدِہِ ، لَوْ کَانَتْ فَاطِمَۃُ بِنْتُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَزَلَتْ بِالَّذِی نَزَلَتْ بِہِ ، لَقَطَعَ مُحَمَّدٌ یَدَہَا۔ (احمد ۴۰۹۔ طبرانی ۷۹۲)","Hasan","Musannaf Ibn Abi Shaybah 28663","","","كتاب أقضية رسول الله ﷺ"
"28664","(۲۸۶۶۴) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ حَرْبِ بْنِ شَدَّادٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ ، عَنْ زُییْدِ بْنِ الصَّلْتِ ، قَالَ : سَمِعْتُ أَبَا بَکْرٍ الصِّدِّیقَ ، یَقُولُ : لَوْ أَخَذْتُ شَارِبًا لأَحْبَبْتُ أَنْ یَسْتُرَہُ اللَّہُ ، وَلَوْ أَخَذْتُ سَارِقًا لأَحْبَبْتُ أَنْ یَسْتُرَہُ اللَّہُ۔","Hasan","Musannaf Ibn Abi Shaybah 28664","","","كتاب أقضية رسول الله ﷺ"
"28665","(۲۸۶۶۵) حَدَّثَنَا شَرِیکٌ ، عَنْ سَعِیدِ بْنِ مَسْرُوقٍ ، عَن عِکْرِمَۃَ ، قَالَ : سُرِقَتْ عَیْبَۃٌ لِعَمَّارٍ بِالْمُزْدَلِفَۃِ ، فَوَضَعَ فِی أَثَرِہَا جَفْنًۃً، وَدَعَا الْقَافَۃَ ، فَقَالُوا: حَبَشِیٌّ، فَاتَّبَعُوا أَثَرَہُ حَتَّی انْتَہَوْا إِلَی حَائِطٍ وَہُوَ یُقَلِّبُہَا ، فَأَخَذَہَا وَتَرَکَہُ، فَقِیلَ لَہُ ؟ فَقَالَ : أَسْتُرُ عَلَیْہِ لَعَلَّ اللَّہَ أَنْ یَسْتُرَ عَلَیَّ۔","","Musannaf Ibn Abi Shaybah 28665","","","كتاب أقضية رسول الله ﷺ"
"28666","(۲۸۶۶۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَن عِکْرِمَۃَ ؛ أَنَّ ابْنَ عَبَّاسٍ ، وَعَمَّارًا ، وَالزُّبَیْرَ أَخَذُوا سَارِقًا فَخَلَّوْا سَبِیلَہُ ، فَقُلْتُ لابْنِ عَبَّاسٍ : بِئْسَ مَا صَنَعْتُمْ حِینَ خَلَّیْتُمْ سَبِیلَہُ ، فَقَالَ : لاَ أُمَّ لَکَ ، أَمَّا لَوْ کُنْتَ أَنْتَ لَسَرَّک أَنْ یُخَلَّی سَبِیلُک۔","Sahih","Musannaf Ibn Abi Shaybah 28666","","","كتاب أقضية رسول الله ﷺ"
"28667","(۲۸۶۶۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَن عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قطَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی مِجَنٍّ قِیمَتُہُ ثَلاَثَۃُ دَرَاہِمَ۔ (بخاری ۶۷۹۷۔ مسلم ۱۳۱۴)","Sahih","Musannaf Ibn Abi Shaybah 28667","","","كتاب أقضية رسول الله ﷺ"
"28668","(۲۸۶۶۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا سُلَیْمَانُ بْنُ کَثِیرٍ ، وَإِبْرَاہِیمُ بْنُ سَعْدٍ ، قَالاَ جَمِیعًا : أَخْبَرَنَا الزُّہْرِیُّ ، عَنْ عَمْرَۃَ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْقَطْعُ فِی رُبْعِ دِینَارٍ فَصَاعِدًا۔ (بخاری ۲۷۹۰۔ مسلم ۱۳۱۲)","Sahih","Musannaf Ibn Abi Shaybah 28668","","","كتاب أقضية رسول الله ﷺ"
"28669","(۲۸۶۶۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَن عِیسَی بْنِ أَبِی عَزَّۃَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَطَعَ فِی خَمْسَۃِ دَرَاہِمَ۔ (ابوداؤد ۲۴۳۔ ابویعلی ۵۳۳۳)","","Musannaf Ibn Abi Shaybah 28669","","","كتاب أقضية رسول الله ﷺ"
"28670","(۲۸۶۷۰) حَدَّثَنَا أَحْمَدُ بْنُ إِسْحَاقَ ، عَن وُہَیْبٍ ، قَالَ : حدَّثَنَا أَبُو وَاقِدٍ ، عَنْ عَامِرِ بْنِ سَعْدٍ ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : یُقْطَعُ السَّارِقُ فِی ثَمَنِ الْمِجَنِّ۔ (ابن ماجہ ۲۵۸۶۔ احمد ۱۶۹)","Da'if","Musannaf Ibn Abi Shaybah 28670","","","كتاب أقضية رسول الله ﷺ"
"28671","(۲۸۶۷۱) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ قَطَعَ یَدَ سَارِقٍ فِی بَیْضَۃٍ حَدِیدٍ ، ثَمَنُہَا رُبْعُ دِینَارٍ۔","","Musannaf Ibn Abi Shaybah 28671","","","كتاب أقضية رسول الله ﷺ"
"28672","(۲۸۶۷۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، یَقُولُ : الْقَطْعُ فِی ثَمَنِ الْمِجَنِّ۔ (احمد ۱۸۰۔ بیہقی ۲۵۹)","Hasan","Musannaf Ibn Abi Shaybah 28672","","","كتاب أقضية رسول الله ﷺ"
"28673","(۲۸۶۷۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَمْرَۃَ ، عَنْ عَائِشَۃَ أُمِّ الْمُؤْمِنِینَ ، قَالَتْ : الْقَطْعُ فِی رُبْعِ دِینَارٍ فَصَاعِدًا۔ (مالک ۸۳۲۔ ابن حبان ۴۴۶۲)","Sahih","Musannaf Ibn Abi Shaybah 28673","","","كتاب أقضية رسول الله ﷺ"
"28674","(۲۸۶۷۴) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَن حُمَیْدٍ ، قَالَ : سُئِلَ أَنَسٌ : فِی کَمْ یُقْطَعُ یَدُ السَّارِقِ ؟ فَقَالَ : قَدْ قَطَعَ أَبُو بَکْرٍ فِیمَا لاَ یَسُرُّنِی أَنَّہُ لِی بِخَمْسَۃِ دَرَاہِمَ ، أَوْ ثَلاَثَۃِ دَرَاہِمَ۔","Sahih","Musannaf Ibn Abi Shaybah 28674","","","كتاب أقضية رسول الله ﷺ"
"28675","(۲۸۶۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ؛ أَنَّ رَجُلاً سَرَقَ مِجَنًّا عَلَی عَہْدِ أَبِی بَکْرٍ فَقُطِعَ۔","Sahih","Musannaf Ibn Abi Shaybah 28675","","","كتاب أقضية رسول الله ﷺ"
"28676","(۲۸۶۷۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَن خَالِدٍ ، عَن عِکْرِمَۃَ ، قَالَ : تُقْطَعُ الْیَدُ فِی ثَمَنِ الْمِجَنِّ ، قَالَ : قُلْتُ : ذَکَرَ لَکَ ثَمَنَہُ ؟ قَالَ : أَرْبَعَۃٌ ، أَوْ خَمْسَۃٌ۔","","Musannaf Ibn Abi Shaybah 28676","","","كتاب أقضية رسول الله ﷺ"
"28677","(۲۸۶۷۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَن دَاوُد بْنِ فَرَاہِیجَ ؛ أَنَّہُ سَمِعَ أَبَا ہُرَیْرَۃَ ، وَأَبَا سَعِیدٍ الْخُدْرِیَّ ، یَقُولاَنِ : لاَ تُقْطَعُ الْیَدُ إِلاَّ فِی أَرْبَعَۃِ دَرَاہِمَ فَصَاعِدًا۔","Hasan","Musannaf Ibn Abi Shaybah 28677","","","كتاب أقضية رسول الله ﷺ"
"28678","(۲۸۶۷۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ ، عَنْ عَمْرَۃَ ، قَالَتْ: قَدْ عَلِمْت أَنَّ عُثْمَانَ قَطَعَ فِی أُتْرُجَّۃٍ، قُوِّمَتْ ثَلاَثَۃَ دَرَاہِمَ۔ (مالک ۸۳۲)","","Musannaf Ibn Abi Shaybah 28678","","","كتاب أقضية رسول الله ﷺ"
"28679","(۲۸۶۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ ، عَنْ عَمْرَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : تُقْطَعُ فِی رُبْعِ دِینَارٍ ، وَقَالَتْ عَمْرَۃُ : قَطَعَ عُمَرُ فِی أُتْرُجَّۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 28679","","","كتاب أقضية رسول الله ﷺ"
"28680","(۲۸۶۸۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : یُقْطَعُ السَّارِقُ فِی ثَمَنِ الْمِجَنِّ۔","No Data Available","Musannaf Ibn Abi Shaybah 28680","","","كتاب أقضية رسول الله ﷺ"
"28681","(۲۸۶۸۱) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ (ح) وَإِسْمَاعِیلُ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عُمَرَ ، قَالَ : لاَ تُقْطَعُ الْخَمْسُ إِلاَّ فِی خَمْسٍ۔","Da'if","Musannaf Ibn Abi Shaybah 28681","","","كتاب أقضية رسول الله ﷺ"
"28682","(۲۸۶۸۲) حَدَّثَنَا أَبُو دَاوُدَ، عَنْ ہِشَامٍ، عَنْ قَتَادَۃَ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، قَالَ: لاَ تُقْطَعُ الْخَمْسُ إِلاَّ فِی خَمْسٍ۔","","Musannaf Ibn Abi Shaybah 28682","","","كتاب أقضية رسول الله ﷺ"
"28683","(۲۸۶۸۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنْ سُفْیانَ، عن عَبْدِالرَّحْمَنِ بْنِ الْقَاسِمِ، عَنْ أَبِیہِ؛ أَنَّ ابْنَ الزُّبَیْرِ قَطَعَ فِی نَعْلَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 28683","","","كتاب أقضية رسول الله ﷺ"
"28684","(۲۸۶۸۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن عُبَیْدِ اللہِ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانُوا یَتَسَارَقُونَ السِّیَاطَ فِی طَرِیقِ مَکَّۃَ ، فَقَالَ عُثْمَانُ : لَئِنْ عُدْتُمْ لأَقْطَعَن فِیہِ۔","Sahih","Musannaf Ibn Abi Shaybah 28684","","","كتاب أقضية رسول الله ﷺ"
"28685","(۲۸۶۸۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَعَنَ اللَّہُ السَّارِقَ ، یَسْرِقُ الْبَیْضَۃَ فَتُقْطَعُ یَدُہُ ، وَیَسْرِقُ الْحَبْلَ فَتُقْطَعُ یَدُہُ۔n(مسلم ۱۳۱۴۔ ابن ماجہ ۲۵۸۳)","Sahih","Musannaf Ibn Abi Shaybah 28685","","","كتاب أقضية رسول الله ﷺ"
"28686","(۲۸۶۸۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ أَبِی بَکْرِ بْنِ مُحَمَّدٍ ، قَالَ : أُتِیَ عُثْمَانُ بِرَجُلٍ سَرَقَ أُتْرُجَّۃً ، فَقَوَّمَہَا رُبْعَ دِینَارٍ ، فَقَطَعَ یَدَہُ۔","","Musannaf Ibn Abi Shaybah 28686","","","كتاب أقضية رسول الله ﷺ"
"28687","(۲۸۶۸۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ : حدَّثَنَی أَیُّوبُ بْنُ مُوسَی ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ : لاَ یُقْطَعُ السَّارِقُ فِی دُونِ ثَمَنِ الْمِجَنِّ ، وَثَمَنُ الْمِجَنِّ عَشَرَۃُ دَرَاہِمَ۔","Hasan","Musannaf Ibn Abi Shaybah 28687","","","كتاب أقضية رسول الله ﷺ"
"28688","(۲۸۶۸۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، وَعَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : کَانَ یَقُولُ : ثَمَنُ الْمِجَنِّ عَشَرَۃُ دَرَاہِمَ۔","","Musannaf Ibn Abi Shaybah 28688","","","كتاب أقضية رسول الله ﷺ"
"28689","(۲۸۶۸۹) حَدَّثَنَا ابْنُ مُبَارَکٍ ، وَوَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنِ الْقَاسِمِ ، عَنِ ابْنِ مَسْعُودٍ ، أَنَّہُ قَالَ : لاَ یُقْطَعُ إِلاَّ فِی دِینَارٍ ، أَوْ عَشَرَۃِ دَرَاہِمَ۔","","Musannaf Ibn Abi Shaybah 28689","","","كتاب أقضية رسول الله ﷺ"
"28690","(۲۸۶۹۰) حَدَّثَنَا وَکِیعٌ ، عَن حَمْزَۃَ الزَّیَّاتِ ، عَنِ الْحَکَمِ ، عَنْ أَبِی جَعْفَرٍ قَالَ : قیمَۃُ الْمِجَنِّ دِینَارٌ ، الَّذِی تُقْطَعُ فِیہِ الْیَدُ۔","","Musannaf Ibn Abi Shaybah 28690","","","كتاب أقضية رسول الله ﷺ"
"28691","(۲۸۶۹۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ عَطَائٍ ، قَالَ : أَدْنَی مَا یُقْطَعُ فِیہِ السَّارِقُ ثَمَنُ الْمِجَنِّ ، وَکَانَ یُقَوَّمُ الْمِجَنُّ فِی زَمَانِہِمْ دِینَارًا ، أَوْ عَشَرَۃَ دَرَاہِمَ۔","","Musannaf Ibn Abi Shaybah 28691","","","كتاب أقضية رسول الله ﷺ"
"28692","(۲۸۶۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ : لاَ تُقْطَعُ الْیَدُ إِلاَّ فِی تُرْسٍ ، أَوْ حَجَفَۃٍ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : کَمْ قِیمَتُہُ ؟ قَالَ : دِینَارٌ۔","","Musannaf Ibn Abi Shaybah 28692","","","كتاب أقضية رسول الله ﷺ"
"28693","(۲۸۶۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ السَّارِقُ عَلَی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُقْطَعُ فِی ثَمَنِ الْمِجَنِّ ، وَکَانَ الْمِجَنُّ یَوْمَئِذٍ لَہُ ثَمَنٌ ، وَلَمْ یَکُنْ یُقْطَعُ فِی الشَّیْئِ التَّافِہِ۔n(عبدالرزاق ۱۸۹۵۹)","","Musannaf Ibn Abi Shaybah 28693","","","كتاب أقضية رسول الله ﷺ"
"28694","(۲۸۶۹۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ : یُقْطَعُ فِی ثَمَنِ الْمِجَنِّ۔","No Data Available","Musannaf Ibn Abi Shaybah 28694","","","كتاب أقضية رسول الله ﷺ"
"28695","(۲۸۶۹۵) حَدَّثَنَا شَرِیکٌ ، عَنْ عَطِیَّۃَ بْنِ عَبْدِ الرَّحْمَن ، عَنِ الْقَاسِمِ ، قَالَ : أُتِیَ عُمَرُ بِسَارِقٍ فَأَمَرَ بِقَطْعِہِ ، فَقَالَ عُثْمَانُ : إِنَّ سَرِقَتَہُ لاَ تَسْوَی عَشَرَۃَ دَرَاہِمَ ، قَالَ : فَأَمَرَ بِہَا عُمَرُ فَقُوِّمَتْ ثَمَانیَۃَ دَرَاہِمَ ، فَلَمْ یَقْطَعْہُ۔","","Musannaf Ibn Abi Shaybah 28695","","","كتاب أقضية رسول الله ﷺ"
"28696","(۲۸۶۹۶) حَدَّثَنَا الثَّقَفِیُّ ، عَنِ الْمُثَنَّی ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، قَالَ : دَخَلْتُ عَلَی سَعِیدِ بْنِ الْمُسَیَّبِ ، فَقُلْت لَہُ : إِنَّ أَصْحَابَک ؛ عُرْوَۃَ بْنَ الزُّبَیْرِ ، وَمُحَمَّدَ بْنَ مُسْلِمٍ الزُّہْرِیَّ ، وَابْنَ یَسَارٍ یَقُولُونَ : ثَمَنُ الْمِجَنِّ خَمْسَۃُ دَرَاہِمَ ، فَقَالَ : أَمَّا ہَذَا فَقَدْ مَضَتْ فِیہِ سُنَّۃٌ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ عَشَرَۃُ دَرَاہِمَ۔n(عبدالرزاق ۱۸۹۵۱)","Da'if","Musannaf Ibn Abi Shaybah 28696","","","كتاب أقضية رسول الله ﷺ"
"28697","(۲۸۶۹۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : لَمْ یَکُنْ یُقْطَعُ عَلَی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الشَّیْئِ التَّافِہِ۔ (بخاری ۶۷۹۲۔ مسلم ۱۳۱۳)","","Musannaf Ibn Abi Shaybah 28697","","","كتاب أقضية رسول الله ﷺ"
"28698","(۲۸۶۹۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَن سُلَیْمَانَ بْنِ مُوسَی ، عَنْ عُثْمَانَ ، قَالَ : لَیْسَ عَلَیْہِ قَطْعٌ حَتَّی یَخْرُجَ بِالْمَتَاعِ مِنَ الْبَیْتِ۔","","Musannaf Ibn Abi Shaybah 28698","","","كتاب أقضية رسول الله ﷺ"
"28699","(۲۸۶۹۹) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لَیْسَ عَلَیْہِ قَطْعٌ حَتَّی یَخْرُجَ بِالْمَتَاعِ مِنَ الْبَیْتِ۔","","Musannaf Ibn Abi Shaybah 28699","","","كتاب أقضية رسول الله ﷺ"
"28700","(۲۸۷۰۰) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَن مُوسَی بْنِ أَبِی الْفُرَاتِ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : لاَ یُقْطَعُ حَتَّی یَخْرُجَ بِالْمَتَاعِ مِنَ الْبَیْتِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28700","","","كتاب أقضية رسول الله ﷺ"
"28701","(۲۸۷۰۱) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ حُصَیْنٍ الْحَارِثِیِّ ، عَنِ الشَّعْبِیِّ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : أُتِیَ بِرَجُلٍ قَدْ نَقَبَ ، فَأُخِذَ عَلَی تِلْکَ الْحَالِ ، فَلَمْ یَقْطَعْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 28701","","","كتاب أقضية رسول الله ﷺ"
"28702","(۲۸۷۰۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ ، أَنَّہُ سُئِلَ عَنْ رَجُلٍ سَرَقَ سَرِقَۃً ، ثُمَّ کَوَّرَہَا ، فَأُدْرِکَ قَبْلَ أَنْ یَخْرُجَ مِنَ الْبَیْتِ ؟ قَالَ : لَیْسَ عَلَیْہِ قَطْعٌ۔","","Musannaf Ibn Abi Shaybah 28702","","","كتاب أقضية رسول الله ﷺ"
"28703","(۲۸۷۰۳) حَدَّثَنَا ابْنُ مُسْہِرٍ ، عَن زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، قَالَ : لَیْسَ عَلَیْہِ قَطْعٌ حَتَّی یُخْرِجَ الْمَتَاعَ مِنَ الْبَیْتِ۔","","Musannaf Ibn Abi Shaybah 28703","","","كتاب أقضية رسول الله ﷺ"
"28704","(۲۸۷۰۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : یُؤْخَذُ السَّارِقُ قَدْ أَخَذَ الْمَتَاعَ ، وَقَدْ جَمَعَہُ فِی الْبَیْتِ ؟ قَالَ : لاَ قَطْعَ عَلَیْہِ حَتَّی یَخْرُجَ بِہِ ، زَعَمُوا ، قَالَ : وَقَالَ عَمْرُو بْنُ دِینَارٍ : مَا أَرَی عَلَیْہِ قَطْعًا۔","","Musannaf Ibn Abi Shaybah 28704","","","كتاب أقضية رسول الله ﷺ"
"28705","(۲۸۷۰۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن دَاوُد ، عَنْ أَبِی حَرْبِ بْنِ أَبِی الأَسْوَدِ ؛ أَنَّ لِصًّا نَقَبَ بَیْتَ قَوْمٍ ، فَأَدْرَکَہُ الْحُرَّاسُ فَأَخَذُوہُ ، فَرُفِعَ إِلَی أَبِی الأَسْوَدِ ، فَقَالَ : وَجَدْتُمْ مَعَہُ شَیْئًا ، فَقَالُوا : لاَ ، فَقَالَ : الْبَائِسُ أَرَادَ أَنْ یَسْرِقَ فَأَعْجَلْتُمُوہُ ، فَجَلَدَہُ خَمْسَۃً وَعِشْرِینَ سَوْطًا۔","","Musannaf Ibn Abi Shaybah 28705","","","كتاب أقضية رسول الله ﷺ"
"28706","(۲۸۷۰۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَن حُمَیْدٍ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ فِی سَارِقٍ : لاَ یُقْطَعُ حَتَّی یَخْرُجَ بِالْمَتَاعِ مِنَ الدَّارِ ، لَعَلَّہُ تَعْرِضُ لَہُ تَوْبَۃٌ قَبْلَ أَنْ یَخْرُجَ مِنَ الدَّارِ۔","","Musannaf Ibn Abi Shaybah 28706","","","كتاب أقضية رسول الله ﷺ"
"28707","(۲۸۷۰۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، قَالَ : بَلَغَ عَائِشَۃَ أَنَّہُمْ یَقُولُونَ : إِذَا لَمْ یَخْرُجْ بِالْمَتَاعِ لَمْ یُقْطَعْ ، فَقَالَتْ : لَوْ لَمْ أَجِدْ إِلاَّ سِکِّینًا لَقَطَعْتُہُ۔","","Musannaf Ibn Abi Shaybah 28707","","","كتاب أقضية رسول الله ﷺ"
"28708","(۲۸۷۰۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا زَنَی ، وَسَرَقَ ، وَقَتَلَ ، وَعَمِلَ حُدُودًا ، قَالَ : یُقْتَلُ ، وَلاَ یُزَادُ عَلَی ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 28708","","","كتاب أقضية رسول الله ﷺ"
"28709","(۲۸۷۰۹) حَدَّثَنَا حَفْصٌ، عَن مُجَالِدٍ، عَنِ الشَّعْبِیِّ، عَن مَسْرُوقٍ، قَالَ: قَالَ عَبْدُ اللہِ: إِذَا اجْتَمَعَ حَدَّانِ أَحَدُہُمَا الْقَتْلُ ، أَتَی الْقَتْلُ عَلَی الآخَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 28709","","","كتاب أقضية رسول الله ﷺ"
"28710","(۲۸۷۱۰) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : إِذَا اجْتَمَعَتْ حُدُودٌ ، أُقِیمَتْ کُلُّہَا عَلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28710","","","كتاب أقضية رسول الله ﷺ"
"28711","(۲۸۷۱۱) حَدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِیُّ ، عَن حُسَیْنِ بْنِ حَازِمٍ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ضَرَبَ عَنقَ سَارِقٍ ، بَعْدَ أَنْ قُطِعَتْ أَرْبَعُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28711","","","كتاب أقضية رسول الله ﷺ"
"28712","(۲۸۷۱۲) حَدَّثَنَا ابْنُ الدَّرَاوَرْدِیِّ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ رَجُلٍ مِنْ أَہْلِ الشِّفَائِ ؛ أَنَّ عُثْمَانَ بْنَ عَفَّانَ ضَرَبَ عَنقَ قیناس بَعْدَ أَنْ قُطِعَتْ أَرْبَعُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 28712","","","كتاب أقضية رسول الله ﷺ"
"28713","(۲۸۷۱۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ؛ قَالَ : کَانَ عَطَائٌ یَقُولُ : إِنْ سَرَقَ وَشَرِبَ الْخَمْرَ ، ثُمَّ قَتَلَ ، فَہُوَ الْقَتْلُ ، لاَ یُقْطَعُ ، وَلاَ یُحَدُّ۔","No Data Available","Musannaf Ibn Abi Shaybah 28713","","","كتاب أقضية رسول الله ﷺ"
"28714","(۲۸۷۱۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ، عَنِ ابْنِ جُرَیْجٍ، قَالَ: سَمِعْتُ ابْنَ أَبِی مُلَیْکَۃَ، یَقُولُ: تُقَامُ عَلَیْہِ الْحُدُودُ، ثُمَّ یُقْتَلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28714","","","كتاب أقضية رسول الله ﷺ"
"28715","(۲۸۷۱۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : تُقَامُ عَلَیْہِ الْحُدُودُ ، ثُمَّ یُقْتَلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28715","","","كتاب أقضية رسول الله ﷺ"
"28716","(۲۸۷۱۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا کَانَتْ حُدُودٌ فِیہَا قَتْلٌ ، فَإِنَّ الْقَتْلَ یَأْتِی عَلَی ذَلِکَ أَجْمَعَ۔","","Musannaf Ibn Abi Shaybah 28716","","","كتاب أقضية رسول الله ﷺ"
"28717","(۲۸۷۱۷) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ؛ فِی الرَّجُلِ یَسْرِقُ فَتُقْطَعُ یَدُہُ ، قَالَ : لَیْسَ عَلَیْہِ شَیْئٌ إِلاَّ أَنْ یُوجَدَ مَعَہُ شَیْئٌ ، وَقَالَ حَمَّادٌ : یُتْبَعُ بِہَا۔","","Musannaf Ibn Abi Shaybah 28717","","","كتاب أقضية رسول الله ﷺ"
"28718","(۲۸۷۱۸) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ (ح) وَأَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، قَالاَ : لَیْسَ عَلَیْہِ شَیْئٌ إِذَا قُطِعَتْ یَدُہُ ، إِلاَّ أَنْ یُوجَدَ شَیْئٌ بِعَیْنِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 28718","","","كتاب أقضية رسول الله ﷺ"
"28719","(۲۸۷۱۹) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ قَالَ فِی السَّارِقِ : إِنْ وُجِدَتِ السَّرِقَۃُ عَندَہُ بِعَیْنِہَا أُخِذَتْ مِنْہُ ، وَقُطِعَتْ یَدُہُ ، وَإِنْ کَانَ قَدَ اسْتَہْلَکَہَا ، قُطِعَتْ یَدُہُ وَلاَ ضَمَانَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 28719","","","كتاب أقضية رسول الله ﷺ"
"28720","(۲۸۷۲۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ (ح) وَأَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ؛ مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28720","","","كتاب أقضية رسول الله ﷺ"
"28721","(۲۸۷۲۱) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ یَغْرَمُ السَّارِقُ بَعْدَ قَطْعِ یَمِینِہِ ، إِلاَّ أَنْ تُوجَدَ السَّرِقَۃُ بِعَیْنِہَا ، فَتُؤْخَذَ مِنْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28721","","","كتاب أقضية رسول الله ﷺ"
"28722","(۲۸۷۲۲) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یُضَمِّنُ السَّارِقَ بَعْدَ مَا یُقْطَعُ۔","","Musannaf Ibn Abi Shaybah 28722","","","كتاب أقضية رسول الله ﷺ"
"28723","(۲۸۷۲۳) حَدَّثَنَا أَبُو خَالِدٍ ، وَلَیْسَ بِالأَحْمَرِ ، عَن قُرَیْشِ بْنِ حَیَّانَ الْعِجْلِیّ ، عَن مَطَرٍ الْوَرَّاقِ ،قَالَ : سُئِلَ سَعِیدُ بْنُ جُبَیْرٍ عَنِ الرَّجُلِ یَسْرِقُ السَّرِقَۃَ فَتُقْطَعُ یَدُہُ ، أَیَغْرَمُ السَّرِقَۃَ ؟ قَالَ : کَفَی بِالْقَطْعِ غُرْمًا۔","No Data Available","Musannaf Ibn Abi Shaybah 28723","","","كتاب أقضية رسول الله ﷺ"
"28724","(۲۸۷۲۴) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : دَخَلْتُ عَلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، فَسَأَلَنِی عَنِ الْعَبْدِ الآبِقِ السَّارِقِ یُقْطَعُ ؟ فَقُلْتُ : مَا بَلَغَنِی فِیہِ شَیْئٌ ، فَلَمَّا قَدِمْتُ الْمَدِینَۃَ لَقِیتُ سَالِمَ بْنَ عَبْدِ اللہِ ، فَأَخْبَرَنِی أَنَّ عَبْدَ اللہِ بْنَ عُمَرَ قَطَعَ عَبْدًا لَہُ ، سَارِقًا ، آبِقًا۔","No Data Available","Musannaf Ibn Abi Shaybah 28724","","","كتاب أقضية رسول الله ﷺ"
"28725","(۲۸۷۲۵) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، فِی الْعَبْدِ الآبِقِ یَسْرِقُ ، قَالَ : یُقْطَعُ۔","","Musannaf Ibn Abi Shaybah 28725","","","كتاب أقضية رسول الله ﷺ"
"28726","(۲۸۷۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : یُقْطَعُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28726","","","كتاب أقضية رسول الله ﷺ"
"28727","(۲۸۷۲۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن حَسَنِ بْنِ صَالِحٍ ، عَنْ إِبْرَاہِیمَ بْنِ عَامِرٍ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ سَأَلَ عُرْوَۃَ عَنْہُ ؟ فَقَالَ : یُقْطَعُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28727","","","كتاب أقضية رسول الله ﷺ"
"28728","(۲۸۷۲۸) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ، وَالْقَاسِمَ، قَالاَ : الْعَبْدُ الآبِقُ إِذَا سَرَقَ قُطِعَ۔","No Data Available","Musannaf Ibn Abi Shaybah 28728","","","كتاب أقضية رسول الله ﷺ"
"28729","(۲۸۷۲۹) حَدَّثَنَا مَحْبُوبٌ الْقَوَارِیرِیُّ ، عَنْ سُفْیَانَ ، عَن خَالِدٍ الْحَذَّائِ ، عَنِ الْحَسَنِ ؛ سُئِلَ عَنِ الْعَبْدِ الآبِقِ یَسْرِقُ ، تُقْطَعُ یَدَہُ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 28729","","","كتاب أقضية رسول الله ﷺ"
"28730","(۲۸۷۳۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ عَمْرٍو ، عَن مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ یُقْطَعُ الْعَبْدُ الآبِقُ إِذَا سَرَقَ فِی إِبَاقِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 28730","","","كتاب أقضية رسول الله ﷺ"
"28731","(۲۸۷۳۱) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : کَانَ عُثْمَانُ ، وَمَرْوَانُ یَقُولاَنِ : لاَ یُقْطَعُ۔","","Musannaf Ibn Abi Shaybah 28731","","","كتاب أقضية رسول الله ﷺ"
"28732","(۲۸۷۳۲) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ عُثْمَانَ ، وَعُمَرَ بْنَ عَبْدِ الْعَزِیزِ ، وَمَرْوَانَ کَانُوا لاَ یَقْطَعُونَ الْعَبْدَ الآبِقَ إِذَا سَرَقَ۔","","Musannaf Ibn Abi Shaybah 28732","","","كتاب أقضية رسول الله ﷺ"
"28733","(۲۸۷۳۳) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَن عُبَیْدِ اللہِ ، وَیَحْیَی ، عَن نَافِعٍ ، قَالَ : سَرَقَ عَبْدٌ لاِبْنِ عُمَرَ ، فَبَعَثَ بِہِ إِلَی سَعِیدِ بْنِ الْعَاصِ ، فَقَالَ : إِنَّ ہَذَا سَرَقَ فَاقْطَعْہُ ، قَالَ : لاَ یُقْطَعُ الْعَبْدُ الآبِقُ۔","Sahih","Musannaf Ibn Abi Shaybah 28733","","","كتاب أقضية رسول الله ﷺ"
"28734","(۲۸۷۳۴) حَدَّثَنَا عُبَیْدُ اللہِ ، عَن حَنْظَلَۃَ ، عَن سَالِمٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : لَیْسَ عَلَیْہِ قَطْعٌ۔","Sahih","Musannaf Ibn Abi Shaybah 28734","","","كتاب أقضية رسول الله ﷺ"
"28735","(۲۸۷۳۵) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی حَصِینٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : أُتِیَ عُثْمَانُ بِغُلاَمٍ قَدْ سَرَقَ ،فَقَالَ : انْظُرُوا إِلَی مُؤْتَزَرِہِ ، ہَلْ أَنْبَتَ ؟۔","","Musannaf Ibn Abi Shaybah 28735","","","كتاب أقضية رسول الله ﷺ"
"28736","(۲۸۷۳۶) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، وَمِسْعَرٍ، عَنْ أَبِی حَصِینٍ، عَنْ عَبْدِاللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ، عَنْ عُثْمَانَ؛ بِمِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 28736","","","كتاب أقضية رسول الله ﷺ"
"28737","(۲۸۷۳۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ إِسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ، قَالَ : ابْتَہَرَ غُلاَمٌ مِنَّا فِی شِعْرہِ بِامْرَأَۃٍ ، فَرُفِعَ إِلَی عُمَرَ ، فَشَکَّ فِیہِ ، فَنَظَرَ إِلَیْہِ ، فَلَمْ یُوجَد أَنْبَتَ ، فَقَالَ : لَوْ وَجَدْتُک أَنْبَتَّ لَجَلَدْتُک ، أَوْ لَحَدَدْتُک۔ (ابوعبید ۲۸۹)","","Musannaf Ibn Abi Shaybah 28737","","","كتاب أقضية رسول الله ﷺ"
"28738","(۲۸۷۳۸) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَن حُمَیْدٍ ، عَنْ أَنَسٍ ؛ أَنَّ أَبَا بَکْرٍ أُتِیَ بِغُلاَمٍ قَدْ سَرَقَ ، فَلَمْ یَتَبَیَّن احْتِلاَمُہُ، فَشَبَرَہُ فَنَقَصَ أُنْمُلَۃً ، فَتَرَکَہُ فَلَمْ یَقْطَعْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 28738","","","كتاب أقضية رسول الله ﷺ"
"28739","(۲۸۷۳۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃ ، عَنْ قَتَادَۃ ، عَنْ خِلاَسٍ ، عَنْ عَلِیٍّ ، قَالَ : إِذَا بَلَغَ الْغُلاَمُ خَمْسَۃَ أَشْبَارٍ ، اقْتُصَّ مِنہِ ، وَاقْتُصَّ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 28739","","","كتاب أقضية رسول الله ﷺ"
"28740","(۲۸۷۴۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : أُتِیَ ابْنُ الزُّبَیْرِ بِعَبْدٍ لِعُمَرَ بْنِ أَبِی رَبِیعَۃَ سَرَقَ ، فَأَمَرَ بِہِ فَشُبِرَ وَہُوَ وَصِیفٌ ، فَبَلَغَ سِتَّۃَ أَشْبَارٍ ، فَقَطَعَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 28740","","","كتاب أقضية رسول الله ﷺ"
"28741","(۲۸۷۴۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَن ہَمَّامٍ ، عَنْ قَتَادَۃَ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ، وَالْحَسَنَ کَانَا لاَ یُقِیمَانِ عَلَی الْغُلاَمِ حَدًّا حَتَّی یَحْتَلِمَ۔","","Musannaf Ibn Abi Shaybah 28741","","","كتاب أقضية رسول الله ﷺ"
"28742","(۲۸۷۴۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، فِی الصَّبِیِّ یَسْرِقُ ، قَالَ : لاَ قَطْعَ عَلَیْہِ حَتَّی یَحْتَلِمَ ، وَقَالَ عَمْرُو بْنُ دِینَارٍ : مَا أَرَی عَلَیْہِ قَطْعًا۔","","Musannaf Ibn Abi Shaybah 28742","","","كتاب أقضية رسول الله ﷺ"
"28743","(۲۸۷۴۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ، عَن حَسَنٍ، عَن مَنْصُورٍ، عَنْ إِبْرَاہِیمَ، قَالَ: لاَ یُقْطَعُ حَتَّی یَعْقِلَ، یَعْنِی یَحْتَلِمَ۔","","Musannaf Ibn Abi Shaybah 28743","","","كتاب أقضية رسول الله ﷺ"
"28744","(۲۸۷۴۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَن سُلَیْمَانَ بْنِ مُوسَی ، قَالَ : لاَ حَدَّ ، وَلاَ قَوَدَ عَلَی مَنْ لَمْ یَبْلُغِ الْحُلُمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 28744","","","كتاب أقضية رسول الله ﷺ"
"28745","(۲۸۷۴۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی ، عَن سُلَیْمَانَ بْنِ یَسَارٍ ، قَالَ : أُتِیَ عُمَرُ بِغُلاَمٍ قَدْ سَرَقَ ، فَأَمَرَ بِہِ فَشُبِرَ ، فَوُجِدَ سِتَّۃَ أَشْبَارٍ ، إِلاَّ أُنْمُلَۃً فَتَرَکَہُ ، فَسُمِّیَ الْغُلاَمُ ، نُمَیلَۃَ۔","","Musannaf Ibn Abi Shaybah 28745","","","كتاب أقضية رسول الله ﷺ"
"28746","(۲۸۷۴۶) حَدَّثَنَا وَکِیعٌ ، عَن مُسْعِرٍ ، عَنِ الْقَاسِمِ ، قَالَ : أُتِیَ عَبْدُ اللہِ بِجَارِیَۃٍ سَرَقَتْ لَمْ تَحِضْ ، فَلَمْ یَقْطَعْہَا۔","","Musannaf Ibn Abi Shaybah 28746","","","كتاب أقضية رسول الله ﷺ"
"28747","(۲۸۷۴۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی الْجَارِیَۃِ تُزَوَّجُ فَیُدْخَلُ بِہَا ، ثُمَّ تُصِیبُ فَاحِشَۃً ، قَالَ : لَیْسَ عَلَیْہَا حَدٌّ حَتَّی تَحِیضَ۔","","Musannaf Ibn Abi Shaybah 28747","","","كتاب أقضية رسول الله ﷺ"
"28748","(۲۸۷۴۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : لَیْسَ عَلَی الْجَارِیَۃِ حَدٌّ حَتَّی تَحِیضَ۔","No Data Available","Musannaf Ibn Abi Shaybah 28748","","","كتاب أقضية رسول الله ﷺ"
"28749","(۲۸۷۴۹) حَدَّثَنَا عَبْدُالأَعْلَی، عن مَعْمَرٍ، عَنِ الزُّہْرِیِّ، قَالَ: لَیْسَ عَلَی الْجَارِیَۃِ حَدٌّ حَتَّی تَحِیضَ، أَوْ تَحِیضَ لِدَاتُہَا۔","","Musannaf Ibn Abi Shaybah 28749","","","كتاب أقضية رسول الله ﷺ"
"28750","(۲۸۷۵۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : لَیْسَ عَلَی الْجَارِیَۃِ حَدٌّ حَتَّی تَحِیضَ ، أَوْ تَحِیضَ لِدَاتُہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 28750","","","كتاب أقضية رسول الله ﷺ"
"28751","(۲۸۷۵۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ أَبِی بَکْرٍ بْنِ عَمْرِو بْنِ حَزْمٍ ؛ أَنَّہُ أُتِیَ بِجَارِیَۃٍ لَمْ تَبْلُغِ الْحَیْضَ ، أَخَذَتْ غُلاَمًا فَقَتَلَتْہُ ، وَغَیَّبَتْ مَا عَلَیْہِ ، فَلَمَّا رَآہَا قَدِ احْتَالَتْ حِیلَۃَ الْکَبِیرِ ، أَمَرَ بِہَا فَقُتِلَتْ۔","","Musannaf Ibn Abi Shaybah 28751","","","كتاب أقضية رسول الله ﷺ"
"28752","(۲۸۷۵۲) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ أَبِی بَکْرٍ ، قَالَ : سَمِعْتُ مَکْحُولاً ، یَقُولُ : إِذَا بَلَغَ الْغُلاَمُ خَمْسَ عَشْرَۃَ سَنَۃً ، جَازَتْ شَہَادَتُہُ ، وَوَجَبَتْ عَلَیْہِ الْحُدُودُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28752","","","كتاب أقضية رسول الله ﷺ"
"28753","(۲۸۷۵۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا سَرَقَ مِرَارًا ، فَإِنَّمَا تُقْطَعُ یَدٌ وَاحِدَۃٌ ، وَإِذَا شَرِبَ الْخَمْرَ مِرَارًا ، وَإِذَا قَذَفَ مِرَارًا فَإِنَّمَا عَلَیْہِ حَدٌّ وَاحِدٌ۔","","Musannaf Ibn Abi Shaybah 28753","","","كتاب أقضية رسول الله ﷺ"
"28754","(۲۸۷۵۴) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یُؤْخَذُ ، وَقَدْ زَنَی غَیْرَ مَرَّۃٍ بِامْرَأَۃٍ وَاحِدَۃٍ ، أَوْ أَکْثَرَ مِنْ ذَلِکَ مِنَ النِّسَائِ ؟ قَالَ : حَدٌّ وَاحِدٌ ، وَالسَّارِقُ یُؤْخَذُ وَقَدْ سَرَقَ مِرَارًا ، مِثْلُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 28754","","","كتاب أقضية رسول الله ﷺ"
"28755","(۲۸۷۵۵) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ یَقُولُ ، أَوْ یُقَالُ : إِذَا سَرَقَ الرَّجُلُ مِنْ شَتَّی ، ثُمَّ قُطِعَ لِوَاحِدٍ ، کَانَ لَہُمْ جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 28755","","","كتاب أقضية رسول الله ﷺ"
"28756","(۲۸۷۵۶) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَن حَمَّادٍ ، قَالَ : إِذَا سَرَقَ مِرَارًا فَلَمْ یَقْدِرُوا عَلَیْہِ إِلاَّ بَعْدُ ، فَإِنَّمَا تُقْطَعُ یَدٌ وَاحِدَۃٌ۔","","Musannaf Ibn Abi Shaybah 28756","","","كتاب أقضية رسول الله ﷺ"
"28757","(۲۸۷۵۷) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : إِذَا سَرَقَ مِنْ شَتَّی ، فَقُطِعَ لِبَعْضِہِمْ ، لَمْ یُقْطَعْ بَعْدُ ، إِلاَّ أَنْ یُحْدِثَ سَرِقَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 28757","","","كتاب أقضية رسول الله ﷺ"
"28758","(۲۸۷۵۸) حَدَّثَنَا عُمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إِذَا سَرَقَ ، ثُمَّ سَرَقَ ، ثُمَّ أُتِیَ بِہِ فَحَدٌّ وَاحِدٌ ، وَکَذَلِکَ فِی الزِّنَی۔","","Musannaf Ibn Abi Shaybah 28758","","","كتاب أقضية رسول الله ﷺ"
"28759","(۲۸۷۵۹) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ ابْنُ شِہَابٍ فِی رَجُلٍ سَرَقَ ، ثُمَّ شُہِدَ عَلَیْہِ أَنَّہُ قَدْ سَرَقَ قَبْلَ ذَلِکَ مِرَارًا ، أَوِ اعْتَرَفَ مَعَ عُقُوبَتِہِ ؟ قَالَ : تُقْطَعُ یَدُہُ ، وَقَالَ ابْنُ شِہَابٍ فِی رَجُلٍ زَنَی فَشُہِدَ عَلَیْہِ ، أَوِ اعْتَرَفَ بِذَلِکَ ، قَالَ : یُقَامُ عَلَیْہِ حَدٌّ وَاحِدٌ۔","","Musannaf Ibn Abi Shaybah 28759","","","كتاب أقضية رسول الله ﷺ"
"28760","(۲۸۷۶۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی حُرَّۃَ ، عَنِ الْحَسَنِ ، قَالَ : یَجُوزُ إِقْرَارُ الْعَبْدِ فِیمَا أُقِرَّ بِہِ مِنْ حَدٍّ یُقَامُ عَلَیْہِ ، وَمَا أَقَرَّ بِہِ مِمَّا تَذْہَبُ فِیہِ رَقَبَتُہُ فَلاَ یَجُوزُ۔","","Musannaf Ibn Abi Shaybah 28760","","","كتاب أقضية رسول الله ﷺ"
"28761","(۲۸۷۶۱) حَدَّثَنَا ابْنُ عَیَّاشٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی إِسْحَاقَ ؛ أَنَّ عَبْدًا أَقَرَّ عِندَ شُرَیْحٍ بِالسَّرِقَۃِ ، فَلَمْ یَقْطَعْہُ۔","","Musannaf Ibn Abi Shaybah 28761","","","كتاب أقضية رسول الله ﷺ"
"28762","(۲۸۷۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، وَعَبْدِ اللہِ بْنِ عیسی ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ قَالَ : لَیْسَ عَلَی الْعَبْدِ یُقِرُّ بِالسَّرِقَۃِ قَطْعٌ۔","","Musannaf Ibn Abi Shaybah 28762","","","كتاب أقضية رسول الله ﷺ"
"28763","(۲۸۷۶۳) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَن سُلَیْمَانَ بْنِ مُوسَی ، قَالَ : لاَ یَجُوزُ اعْتِرَافُ الْعَبْدِ ، إِلاَّ بِبَیِّنَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 28763","","","كتاب أقضية رسول الله ﷺ"
"28764","(۲۸۷۶۴) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ یَجُوزُ اعْتِرَافُ الْعَبْدِ۔","","Musannaf Ibn Abi Shaybah 28764","","","كتاب أقضية رسول الله ﷺ"
"28765","(۲۸۷۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی الضُّحَی ، وَالشَّعْبِیِّ ، قَالاَ : لاَ یُقَامُ عَلَی عَبْدٍ حَدٌّ بِاعْتِرَافٍ ، إِلاَّ بِبَیِّنَۃٍ۔","","Musannaf Ibn Abi Shaybah 28765","","","كتاب أقضية رسول الله ﷺ"
"28766","(۲۸۷۶۶) حَدَّثَنَا مُعَاذٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ : لاَ یَجُوزُ إِقْرَارُ الْعَبْدِ عَلَی نَفْسِہِ إِذَا بَلَغَ النَّفْسَ فِی خَطَأٍ ، وَلاَ عَمْدٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 28766","","","كتاب أقضية رسول الله ﷺ"
"28767","(۲۸۷۶۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، قَالَ : حدَّثَنِی أَہْلُ ہُرْمُزَ وَالْحَیُّ ، عَن ہُرْمُزَ ، أَنَّہُ أَتَی عَلِیًّا ، فَقَالَ : إِنِّی أَصَبْتُ حَدًّا ، فَقَالَ : تُبْ إِلَی اللہِ وَاسْتَتَرَ ، قَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، طَہِّرْنِی ، قَالَ : قُمْ یَا قَنْبَرُ ، فَاضْرِبْہُ الْحَدَّ ، وَلَیَکنْ ہُوَ یَعُدُّ لِنَفْسِہِ ، فَإِذَا نَہَاک فَانْتَہِ ، وَکَانَ مَمْلُوکًا۔","Da'if","Musannaf Ibn Abi Shaybah 28767","","","كتاب أقضية رسول الله ﷺ"
"28768","(۲۸۷۶۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَن یُوسُفَ بْنِ مَاہِکٍ ؛ أَنَّ عَبْدًا لِبَعْضِ أَہْلِ مَکَّۃَ سَرَقَ رِدَائً لِصَفْوَانَ بْنِ أُمَیَّۃَ ، فَأُتِیَ بِہِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَأَمَرَ بِقَطْعِہِ ، فَقَالَ : یَا رَسُولَ اللہِ ، تَقْطَعُہُ مِنْ أَجْلِ ثَوْبِی ؟ قَالَ : فَہَلاَ قَبْلَ أَنْ تَأْتِیَنِی بہ۔ (ابوداؤد ۴۳۹۴۔ ابن ماجہ ۲۵۹۵)","","Musannaf Ibn Abi Shaybah 28768","","","كتاب أقضية رسول الله ﷺ"
"28769","(۲۸۷۶۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ عَطَائٍ ؛ فِی الْعَبْدِ یَسْرِقُ ، قَالَ: یُقْطَعُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28769","","","كتاب أقضية رسول الله ﷺ"
"28770","(۲۸۷۷۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی أَبُو بَکْرِ بْنُ عَبْدِ اللہِ ، عَنْ أَبِی الزِّنَادِ ؛ أَنَّہُ أَخْبَرَہُ أَنَّ عَبْدَ اللہِ بْنَ عَامِرٍ أَخْبَرَہُ ، أَنَّ أَبَا بَکْرٍ قَطَعَ یَدَ عَبْدٍ سَرَقَ۔","Da'if","Musannaf Ibn Abi Shaybah 28770","","","كتاب أقضية رسول الله ﷺ"
"28771","(۲۸۷۷۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إِسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ؛ فِی أَرْبَعَۃٍ شَہِدُوا عَلَی رَجُلٍ بِالزِّنَی ، فَکَانَ أَحَدُہُمْ لَیْسَ بِعَدْلٍ ؟ قَالَ : یُدْرَأُ عَنْہُمُ الْحَدُّ لأَنَّہُمْ أَرْبَعَۃٌ۔","","Musannaf Ibn Abi Shaybah 28771","","","كتاب أقضية رسول الله ﷺ"
"28772","(۲۸۷۷۲) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ أَشْعَثَ، عَنِ الشَّعْبِیِّ، قَالَ: إِذَا شَہِدَ أَرْبَعَۃٌ بِالزِّنَی، ثُمَّ لَمْ یَکُونُوا عُدُولاً لَمْ أَجْلِدْہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 28772","","","كتاب أقضية رسول الله ﷺ"
"28773","(۲۸۷۷۳) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَنْصَارِیُّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا شَہِدَ أَرْبَعَۃٌ بِالزِّنَی عَلَی رَجُلٍ فَلَمْ یُعَدَّلُوا ، دُرِئَ عَنہُ الْحَدُّ ، وَلَمْ یُجْلَدْ أَحَد مِنْہُمْ۔","","Musannaf Ibn Abi Shaybah 28773","","","كتاب أقضية رسول الله ﷺ"
"28774","(۲۸۷۷۴) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنِ الأَعْمَشِ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، قَالَ : کُنْتُ قَاعِدًا عِندَ عَلِیٍّ فَجَائَ رَجُلٌ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، إِنِّی قَدْ سَرَقْتُ ، فَانْتَہَرَہُ ، ثُمَّ عَادَ الثَّانِیَۃَ ، فَقَالَ : إِنِّی قَدْ سَرَقْتُ ، فَقَالَ لَہُ عَلِیٌّ : قَدْ شَہِدْتَ عَلَی نَفْسِکَ شَہَادَتَیْنِ ، قَالَ : فَأَمَرَ بِہِ فَقُطِعَتْ یَدُہُ ، فَرَأَیْتُہَا مُعَلَّقَۃً ، یَعْنِی فِی عُنُقِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 28774","","","كتاب أقضية رسول الله ﷺ"
"28775","(۲۸۷۷۵) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَن حَسَنِ بْنِ صَالِحٍ ، عَن غَالِبٍ أَبِی الْہُذَیْلِ ، قَالَ : سَمِعْتُ سُبَیْعًا أَبَا سَالِمٍ ، یَقُولُ : شَہِدْتُ الْحَسَنَ بْنَ عَلِیٍّ وَأُتِیَ بِرَجُلٍ أَقَرَّ بِسَرِقَۃٍ ، فَقَالَ لَہُ الْحَسَنُ : فَلَعَلَّک اخْتَلَسْتَہُ ، لِکَیْ یَقُولَ لاَ ، حَتَّی أَقَرَّ عَندَہُ مَرَّتَیْنِ ، أَوْ ثَلاَثًا ، فَأَمَرَ بِہِ فَقُطِعَ۔","Da'if","Musannaf Ibn Abi Shaybah 28775","","","كتاب أقضية رسول الله ﷺ"
"28776","(۲۸۷۷۶) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : رَجُلٌ شَہِدَ عَلَی نَفْسِہِ مَرَّۃً وَاحِدَۃً بِأَنَّہُ سَرَقَ ؟ قَالَ : حَسْبُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 28776","","","كتاب أقضية رسول الله ﷺ"
"28777","(۲۸۷۷۷) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ (ح) وَعَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُمَا قَالاَ : إِذَا قَذَفَ قَوْمًا جَمِیعًا جُلِدَ حَدًّا وَاحِدًا ، وَإِذَا قَذَفَ شَتَّی جُلِدَ لِکُلِّ وَاحِدٍ مِنْہُمْ حَدًّا۔","No Data Available","Musannaf Ibn Abi Shaybah 28777","","","كتاب أقضية رسول الله ﷺ"
"28778","(۲۸۷۷۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَقْذِفُ الْقَوْمَ جَمِیعًا ، قَالَ : یُجْلَدُ لِکُلِّ إِنْسَانٍ مِنْہُمْ حَدًّا۔","","Musannaf Ibn Abi Shaybah 28778","","","كتاب أقضية رسول الله ﷺ"
"28779","(۲۸۷۷۹) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی الرَّجُلِ یَقْذِفُ الْقَوْمَ مُجْتَمَعِینَ بِقَذْفٍ وَاحِدٍ ، قَالَ : عَلَیْہِ حَدٌّ وَاحِدٌ۔وَقَالَ قَتَادَۃُ ، عَنِ الْحَسَنِ : لِکُلِّ رَجُلٍ مِنْہُمْ حَدٌّ۔","No Data Available","Musannaf Ibn Abi Shaybah 28779","","","كتاب أقضية رسول الله ﷺ"
