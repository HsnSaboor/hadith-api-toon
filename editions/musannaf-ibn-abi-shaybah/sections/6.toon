"5850","(۵۸۵۰) حَدَّثَنَا ہُشَیْمٌ ، وَحَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ فَاتَہُ الْعِیدُ فَلْیُصَلِّ أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5850","","","كتاب الجمعة"
"5851","(۵۸۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : یُصَلِّی أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5851","","","كتاب الجمعة"
"5852","(۵۸۵۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یُصَلِّی رَکْعَتَیْنِ وَیُکَبِّرُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5852","","","كتاب الجمعة"
"5853","(۵۸۵۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، قَالَ : حدَّثَنِی بَعْضُ آلِ أَنَسٍ ؛ أَنَّ أَنَسًا کَانَ رُبَّمَا جَمَعَ أَہْلَہُ وَحَشَمَہُ یَوْمَ الْعِیدِ ، فَصَلَّی بِہِمْ عَبْدُ اللہِ بْنُ أَبِی عُتْبَۃَ رَکْعَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 5853","","","كتاب الجمعة"
"5854","(۵۸۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : کَانَ أَبُو عِیَاضٍ مُسْتَخْفِیًا ، قَالَ : فَجَائَہُ مُجَاہِدٌ یَوْمَ عِیدٍ ، فَصَلَّی بِہِ رَکْعَتَیْنِ ، وَدَعَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5854","","","كتاب الجمعة"
"5855","(۵۸۵۵) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : مَنْ کَانَ لَہُ عُذْرٌ یُعْذَرُ بِہِ فِی یَوْمِ فِطْرٍ ، أَوْ جُمُعَۃٍ ، أَوْ أَضْحَی ، فَصَلاَتُہُ أَرْبَعُ رَکَعَاتٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5855","","","كتاب الجمعة"
"5856","(۵۸۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ ، عَنْ أَبِی عُمَرَ ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، قَالَ : یُصَلِّی رَکْعَتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5856","","","كتاب الجمعة"
"5857","(۵۸۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، عَنِ الْحَسَنِ ، قَالَ : یُصَلِّی مِثْلَ صَلاَۃِ الإِمَام۔","No Data Available","Musannaf Ibn Abi Shaybah 5857","","","كتاب الجمعة"
"5858","(۵۸۵۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا فَاتَتْک الصَّلاَۃُ مَعَ الإِمَامِ فَصَلِّ مِثْلَ صَلاَتِہِ ۔ وَقَالَ إِبْرَاہِیمُ : وَإِذَا اسْتَقْبَلَ النَّاسَ رَاجِعِینَ فَلْیَدْخُلْ أَدْنَی مَسْجِدٍ ، ثُمَّ لِیُصَلِّ صَلاَۃَ الإِمَامِ ، وَمَنْ لاَ یَخْرُجُ إِلَی الْعِیدِ ، فَلْیُصَلِّ مِثْلَ صَلاَۃِ الإِمَام۔","No Data Available","Musannaf Ibn Abi Shaybah 5858","","","كتاب الجمعة"
"5859","(۵۸۵۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ؛ فِیمَنْ لَمْ یُدْرِکِ الصَّلاَۃَ یَوْمَ الْعِیدِ ، قَالَ : یُصَلِّی مِثْلَ صَلاَتِہِ ، وَیُکَبِّرُ مِثْلَ تَکْبِیرِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5859","","","كتاب الجمعة"
"5860","(۵۸۶۰) حَدَّثَنَا شَرِیکٌ ، قَالَ : سَأَلْتُ أَبَا إِسْحَاقَ عَنِ الرَّجُلِ یَجِیئُ یَوْمَ الْعِیدِ وَقَدْ فَرَغَ الإِمَامُ ؟ قَالَ : یُصَلِّی رَکْعَتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5860","","","كتاب الجمعة"
"5861","(۵۸۶۱) حَدَّثَنَا حسن بن عَبْدُ الرَّحْمَان الْحَارِثِیُّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدِ ؛ فِی الَّذِی یَفُوتُہُ الْعِیدُ ، قَالَ : کَانَ یُسْتَحَبُّ أَنْ یُصَلِّیَ مِثْلَ صَلاَۃِ الإِمَامِ ، وَإِنْ عَلِمَ مَا قَرَأَ بِہِ الإِمَام قَرَأَ بِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 5861","","","كتاب الجمعة"
"5862","(۵۸۶۲) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، قَالَ : إِذَا فَاتَتْک مِنْ صَلاَۃِ الْعِیدِ رَکْعَۃٌ فَاقْضِہَا، وَاصْنَعْ فِیہَا مِثْلَ مَا یَصْنَعُ الإِمَامُ فِی الرَّکْعَۃِ الأُولَی۔","No Data Available","Musannaf Ibn Abi Shaybah 5862","","","كتاب الجمعة"
"5863","(۵۸۶۳) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : یُکَبِّرُ مَعَہُ فِی ہَذِہِ مَا أَدْرَکَ مِنْہَا ، وَیَقْضِی الَّتِی فَاتَتْہُ وَیُکَبِّرُ فِیہَا مِثْلَ تَکْبِیرِ الإِمَامِ فِی الرَّکْعَۃِ الثَّانِیَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5863","","","كتاب الجمعة"
"5864","(۵۸۶۴) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ لَیْثٍ ، عَنِ الْحَکَمِ ، عَنْ حَنَشٍ ، قَالَ : قیلَ لِعَلِیِّ بْنِ أَبِی طَالِبٍ : إِنَّ ضَعَفَۃً مِنْ ضَعَفَۃِ النَّاسِ لاَ یَسْتَطِیعُونَ الْخُرُوجَ إِلَی الْجَبَّانَۃِ ، فَأَمَرَ رَجُلاً یُصَلِّی بِالنَّاسِ أَرْبَعَ رَکَعَاتٍ ؛ رَکْعَتَیْنِ لِلْعِیدِ ، وَرَکْعَتَیْنِ لِمَکَانِ خُرُوجِہِمْ إِلَی الْجَبَّانَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 5864","","","كتاب الجمعة"
"5865","(۵۸۶۵) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ أَبِی إِسْحَاقَ؛ أَنَّ عَلِیًّا أَمَرَ رَجُلاً یُصَلِّی بِضَعَفَۃِ النَّاسَ فِی الْمَسْجِدِ رَکْعَتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5865","","","كتاب الجمعة"
"5866","(۵۸۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی قَیْسٍ ، قَالَ : أَظُنُّہُ ، عَنْ ہُزََیْلٍ ؛ أَنَّ عَلِیًّا أَمَرَ رَجُلاً یُصَلِّی بِضَعَفَۃِ النَّاسِ یَوْمَ الْعِیدِ أَرْبَعًا ، کَصَلاَۃِ الْہَجِیرِ۔","Hasan","Musannaf Ibn Abi Shaybah 5866","","","كتاب الجمعة"
"5867","(۵۸۶۷) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِالرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عِیسَی ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : صَلَّی بِالنَّاسِ فِی مَسْجِدِ الْکُوفَۃِ رَکْعَتَیْنِ ، فِی إِمَارَۃِ مُصْعَبِ بْنِ الزُّبَیْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5867","","","كتاب الجمعة"
"5868","(۵۸۶۸) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنِ ابْنِ أَبِی لَیْلَی ؛ أَنَّ عَلِیًّا أَمَرَ رَجُلاً یُصَلِّی بِالنَّاسِ فِی مَسْجِدِ الْکُوفَۃِ رَکْعَتَیْنِ ۔ قَالَ : وَقَالَ ابْنُ أَبِی لَیْلَی : یُصَلِّی رَکْعَتَیْنِ ، فَقَالَ رَجُلٌ لْاِبْنِ أَبِی لَیْلَی : یُصَلِّی بِغَیْرِ خُطْبَۃٍ ؟ قَالَ : نَعَمْ۔","Sahih","Musannaf Ibn Abi Shaybah 5868","","","كتاب الجمعة"
"5869","(۵۸۶۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُسْلِمُ بْنِ یَزِیدَ بْنِ مَذْکُورٍ الْخَارِقِیِّ ، قَالَ : صَلَّی بِنَا الْقَاسِمُ بْنُ عَبْدِ الرَّحْمَنِ یَوْمَ عِیدٍ فِی الْمَسْجِدِ الْجَامِعِ رَکْعَتَیْنِ ، وَخَطَبَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5869","","","كتاب الجمعة"
"5870","(۵۸۷۰) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عُرَیْفِ بْنِ دِرْہَمٍ ، قَالَ : رَأَیْتُ عَبْدَ اللہِ بْنَ أَبِی ہُذَیْلٍ یَأْتِی الْمَسْجِدَ الأَعْظَمَ یَوْمَ الْعِیدِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5870","","","كتاب الجمعة"
"5871","(۵۸۷۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : یُکَبِّرُ ، ثُمَّ یَقُومُ فَیَقْضِی ، ثُمَّ یُکَبِّرُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5871","","","كتاب الجمعة"
"5872","(۵۸۷۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ ابْنِ شُبْرُمَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : یَقْضِی ، ثُمَّ یُکَبِّرُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5872","","","كتاب الجمعة"
"5873","(۵۸۷۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، قَالَ : رَأَیْتُ ابْنَ شُبْرُمَۃَ غَیْرَ مَرَّۃٍ ، إِذَا فَاتَہُ شَیْئٌ مِنَ الصَّلاَۃِ أَیَّامَ التَّشْرِیقِ قَامَ فَقَضَی ، ثُمَّ کَبَّرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5873","","","كتاب الجمعة"
"5874","(۵۸۷۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَقُولُ : یُکَبِّرُ مَعَہُ ، ثُمَّ یَقُومُ فَیَقْضِی۔","No Data Available","Musannaf Ibn Abi Shaybah 5874","","","كتاب الجمعة"
"5875","(۵۸۷۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ؛ فِی الرَّجُلِ تَفُوتُہُ الرَّکْعَۃُ أَیَّامَ التَّشْرِیقِ ، قَالَ ابْنُ سِیرِینَ : یَقْضِی ، ثُمَّ یُکَبِّرُ ، وَقَالَ الْحَسَنُ : یُکَبِّرُ ، ثُمَّ یَقْضِی ۔","No Data Available","Musannaf Ibn Abi Shaybah 5875","","","كتاب الجمعة"
"5876","(۵۸۷۶) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ، قَالَ: إِذَا فَاتَتْک رَکْعَۃٌ أَیَّامَ التَّشْرِیقِ فَلاَ تُکَبِّرْ حَتَّی تَقْضِیَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5876","","","كتاب الجمعة"
"5877","(۵۸۷۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ، قَالَ : یُکَبِّرُ مَعَ الإِمَامِ ، ثُمَّ یَقْضِی مَا سُبِقَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5877","","","كتاب الجمعة"
"5878","(۵۸۷۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ یَقُولُ : یَقْضِی مَا فَاتَہُ ، ثُمَّ یُکَبِّرُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5878","","","كتاب الجمعة"
"5879","(۵۸۷۹) حَدَّثَنَا حَکَّامٌ الرَّازِیُّ ، عَنْ عَنْبَسَۃَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُجَاہِدٍ ، قَالَ : یُکَبِّرُ مَعَ الإِمَامِ ، ثُمَّ یُکَبِّرُ إِذَا قَضَی۔ قَالَ أَبُو بَکْرٍ : وَبَلَغَنِی أَنَّ ہَکَذَا قَوْلُ ابْنِ أَبِی لَیْلَی۔","No Data Available","Musannaf Ibn Abi Shaybah 5879","","","كتاب الجمعة"
"5880","(۵۸۸۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ عَمْرٍو، عَنِ الْحَسَنِ، قَالَ: إِذَا صَلَّی وَحْدَہُ، أَوْ فِی جَمَاعَۃٍ، أَوْ تَطَوَّعَ، کَبَّرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5880","","","كتاب الجمعة"
"5881","(۵۸۸۱) حَدَّثَنَا حَفْصٌ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ یُکَبِّرُ إِلاَّ أَنْ یُصَلِّیَ فِی جَمَاعَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5881","","","كتاب الجمعة"
"5882","(۵۸۸۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ ہَمَّامٍ ، قَالَ : رَأَیْتُ قَتَادَۃَ صَلَّی وَحْدَہُ أَیَّامَ التَّشْرِیقِ ، فَکَبَّرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5882","","","كتاب الجمعة"
"5883","(۵۸۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَبِّرْ فِی التَّطَوُّعِ وَإِنْ صَلَّیْت وَحْدَک۔","No Data Available","Musannaf Ibn Abi Shaybah 5883","","","كتاب الجمعة"
"5884","(۵۸۸۴) حَدَّثَنَا حَکَّامٌ الرَّازِیُّ ، عَنْ عَنْبَسَۃَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : التَّکْبِیرُ أَیَّامَ التَّشْرِیقِ فِی کُلِّ نَافِلَۃٍ وَفَرِیضَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5884","","","كتاب الجمعة"
"5885","(۵۸۸۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانُوا یُکَبِّرُونَ فِی دُبُرِ الرَّکْعَتَیْنِ یَوْمَ النَّحْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5885","","","كتاب الجمعة"
"5886","(۵۸۸۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَنْ وَہْبِ بْنِ کَیْسَانَ ، قَالَ : اجْتَمَعَ عِیدَانِ فِی عَہْدِ ابْنِ الزُّبَیْرِ ، فَأَخَّرَ الْخُرُوجَ ، ثُمَّ خَرَجَ فَخَطَبَ فَأَطَالَ الْخُطْبَۃَ ، ثُمَّ صَلَّی ، وَلَمْ یَخْرُجْ إِلَی الْجُمُعَۃِ ، فَعَابَ ذَلِکَ أُنَاسٌ عَلَیْہِ ، فَبَلَغَ ذَلِکَ عِنْدَ ابْنِ عَبَّاسٍ ، فَقَالَ : أَصَابَ السُّنَّۃَ ۔ فَبَلَغَ ابْنَ الزُّبَیْرِ ، فَقَالَ : شَہِدْتُ الْعِیدَ مَعَ عُمَرَ فَصَنَعَ کَمَا صَنَعْتُ۔ (ابوداؤد ۱۰۶۴۔ نسائی ۱۷۹۴)","Hasan","Musannaf Ibn Abi Shaybah 5886","","","كتاب الجمعة"
"5887","(۵۸۸۷) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی عُبَیْدٍ مَوْلَی ابْنِ أَزْہَرَ ، قَالَ : شَہِدْتُ الْعِیدَ مَعَ عُثْمَانَ وَوَافَقَ یَوْمَ جُمُعَۃٍ ، فَقَالَ : إِنَّ ہَذَا یَوْمٌ اجْتَمَعَ فِیہِ عِیدَانِ لِلْمُسْلِمِینَ ، فَمَنْ کَانَ ہَاہُنَا مِنْ أَہْلِ الْعَوَالِی فَقَدْ أَذِنَّا لَہُ أَنْ یَنْصَرِفَ ، وَمَنْ أَحَبَّ أَنْ یَمْکُثَ فَلْیَمْکُثْ۔","Sahih","Musannaf Ibn Abi Shaybah 5887","","","كتاب الجمعة"
"5888","(۵۸۸۸) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : اجْتَمَعَ عِیدَانِ عَلَی عَہْدِ عَلِیٍّ فَصَلَّی بِالنَّاسِ ، ثُمَّ خَطَبَ عَلَی رَاحِلَتِہِ ، ثُمَّ قَالَ : یَا أَیَّہَا النَّاسُ ، مَنْ شَہِدَ مِنْکُمُ الْعِیدَ فَقَدْ قَضَی جُمُعَتَہُ إِنْ شَائَ اللَّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 5888","","","كتاب الجمعة"
"5889","(۵۸۸۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : اجْتَمَعَ عِیدَانِ عَلَی عَہْدِ عَلِیٍّ فَشَہِدَ بِہِمُ الْعِیدَ ، ثُمَّ قَالَ : إِن??َا مُجَمِّعُونَ ، فَمَنْ أَرَادَ أَنْ یَشْہَدَ فَلْیَشْہَدْ۔","No Data Available","Musannaf Ibn Abi Shaybah 5889","","","كتاب الجمعة"
"5890","(۵۸۹۰) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ إِبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، عَنْ أَبِیہِ ، عَنْ حَبِیبِ بْنِ سَالِمٍ ، عَنِ النُّعْمَانِ بْنِ بَشِیرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقْرَأُ فِی الْعِیدَیْنِ بِـ : {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} ، وَ{ہَلْ أَتَاک حَدِیثُ الْغَاشِیَۃِ} ، وَإِذَا اجْتَمَعَ الْعِیدَانِ فِی یَوْمٍ قَرَأَ بِہِمَا فِیہِمَا۔","Sahih","Musannaf Ibn Abi Shaybah 5890","","","كتاب الجمعة"
"5891","(۵۸۹۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ وَہْبِ بْنِ کَیْسَانَ ، قَالَ : اجْتَمَعَ عِیدَانِ فِی یَوْمٍ ، فَخَرَجَ عَبْدُ اللہِ بْنُ الزُّبَیْرِ فَصَلَّی الْعِیدَ بَعْدَ مَا ارْتَفَعَ النَّہَارُ ، ثُمَّ دَخَلَ ، فَلَمْ یَخْرُجْ حَتَّی صَلَّی الْعَصْرَ ۔ قَالَ ہِشَامٌ : فَذَکَرْتُ ذَلِکَ لِنَافِعٍ ، أَوْ ذُکِرَ لَہُ ، فَقَالَ : ذُکِرَ ذَلِکَ لاِبْنِ عُمَرَ فَلَمْ یُنْکِرْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 5891","","","كتاب الجمعة"
"5892","(۵۸۹۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنْ عَطَائٍ ، قَالَ : اجْتَمَعَ عِیدَانِ فِی عَہْدِ ابْنِ الزُّبَیْرِ فَصَلَّی بِہِمُ الْعِیدَ ، ثُمَّ صَلَّی بِہِمُ الْجُمُعَۃَ صَلاَۃَ الظُّہْرِ أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5892","","","كتاب الجمعة"
"5893","(۵۸۹۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : اجْتَمَعَ عِیدَانِ عَلَی عَہْدِ الْحَجَّاجِ ، فَصَلَّی أَحَدَہُمَا ، فَقَالَ أَبُو الْبَخْتَرِیِّ : قَاتَلَہُ اللَّہُ أَنَّی عَلِقَ ہَذَا ؟۔","No Data Available","Musannaf Ibn Abi Shaybah 5893","","","كتاب الجمعة"
"5894","(۵۸۹۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : تُجْزِئُہُ الأُولَی مِنْہُمَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5894","","","كتاب الجمعة"
"5895","(۵۸۹۵) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : إِذَا اجْتَمَعَ عِیدَانِ فِی یَوْمٍ ، فَأَیُّہُمَا أَتَیْتَ أَجْزَأَکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5895","","","كتاب الجمعة"
"5896","(۵۸۹۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ إِسْرَائِیلَ ، عَنْ عُثْمَانَ الثَّقَفِیِّ ، عَنِ ابْنِ أَبِی رَمْلَۃَ الشَّامِیِّ ، قَالَ : شَہِدْتُ مُعَاوِیَۃَ یَسْأَلُ زَیْدَ بْنَ أَرْقَمَ : ہَلْ شَہِدْتَ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عِیدَیْنِ اجْتَمَعَا ؟ قَالَ : نَعَمْ ، قَالَ: فَکَیْفَ صَنَعَ ؟ قَالَ : صَلَّی الْعِیدَ ، ثُمَّ رَخَّصَ فِی الْجُمُعَۃِ ، قَالَ : مَنْ شَائَ أَنْ یُصَلِّیَ فَلْیُصَلِّ۔ (ابوداؤد ۱۰۶۳۔ احمد ۴/۳۷۲)","Hasan","Musannaf Ibn Abi Shaybah 5896","","","كتاب الجمعة"
"5897","(۵۸۹۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : اجْتَمَعَ الْعِیدَانِ فِی یَوْمٍ ، فَقَامَ الْحَجَّاجُ فِی الْعِیدِ الأَوَّلِ ، فَقَالَ : مَنْ شَائَ أَنْ یُجَمِّعَ مَعَنَا فَلْیُجَمِّعْ ، وَمَنْ شَائَ أَنْ یَنْصَرِفَ فَلْیَنْصَرِفْ ، وَلاَ حَرَجَ ، فَقَالَ أَبُو الْبَخْتَرِیِّ ، وَمَیْسَرَۃُ : مَا لَہُ ، قَاتَلَہُ اللَّہُ تَعَالَی مِنْ أَیْنَ سَقَطَ عَلَی ہَذَا ؟۔","No Data Available","Musannaf Ibn Abi Shaybah 5897","","","كتاب الجمعة"
"5898","(۵۸۹۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا الْحَجَّاجُ ، عَنْ عَطَائٍ ، عَنْ عَلِیٍّ ) (ح) وَعَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ، عَنْ إِبْرَاہِیمَ ؛ فِی الْعِیدَیْنِ إِذَا اجْتَمَعَا ؟ قَالاَ : یُجْزِئُ أَحَدُہُمَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5898","","","كتاب الجمعة"
"5899","(۵۸۹۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ: أَخْبَرَنَا حَجَّاجٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ، عَنِ الزُّبَیْرِ، قَالَ: یُجْزِئُ أَحَدُہُمَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5899","","","كتاب الجمعة"
"5900","(۵۹۰۰) حَدَّثَنَا مُعَاوِیَۃُ بن ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا کَانَ یَوْمُ جُمُعَۃٍ وَعِیدٍ ، أَجْزَأَ أَحَدُہُمَا مِنَ الآخَرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5900","","","كتاب الجمعة"
"5901","(۵۹۰۱) حَدَّثَنَا شَرِیکٌ ، عَنْ زُبَیْدِ ، عَنِ ابْنِ أَبِی لَیْلَی، عَنْ عُمَرَ، قَالَ: صَلاَۃُ السَّفَرِ رَکْعَتَانِ ، وَالْجُمُعَۃُ رَکْعَتَانِ، وَالْعِیدَانِ رَکْعَتَانِ ، تَمَامٌ غَیْرُ قَصْرٍ ، عَلَی لِسَانِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (ابن ماجہ ۱۰۶۳۔ نسائی ۱۷۳۳)","Hasan","Musannaf Ibn Abi Shaybah 5901","","","كتاب الجمعة"
"5902","(۵۹۰۲) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : خَرَجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ عِیدِ فِطْرٍ ، أَوْ أَضْحَی فَصَلَّی بِالنَّاسِ رَکْعَتَیْنِ ثُمَّ انْصَرَفَ ، وَلَمْ یُصَلِّ قَبْلَہَا ، وَلاَ بَعْدَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 5902","","","كتاب الجمعة"
"5903","(۵۹۰۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ دَاوُدَ بْنِ قَیْسٍ ، قَالَ : حدَّثَنِی عِیَاضُ بْنُ عَبْدِ اللہِ بْنِ أَبِی سَرْحٍ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَخْرُجُ یَوْمَ الْعِیدِ یَوْمَ الْفِطْرِ ، فَیُصَلِّی بِالنَّاسِ رَکْعَتَیْنِ ، ثُمَّ یُسَلِّمُ۔ (مسلم ۶۰۵۔ نسائی ۱۷۸۵)","Sahih","Musannaf Ibn Abi Shaybah 5903","","","كتاب الجمعة"
"5904","(۵۹۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ دَاوُدَ بْنِ قَیْسٍ ، عَنْ عِیَاضٍ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : إِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَطَبَ یَوْمَ عِیدٍ عَلَی رَاحِلَتِہِ۔ (ابویعلی ۱۱۷۷۔ ابن حبان ۲۸۲۵)","Sahih","Musannaf Ibn Abi Shaybah 5904","","","كتاب الجمعة"
"5905","(۵۹۰۵) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ مَیْسَرَۃَ أَبِی جَمِیلَۃَ ، قَالَ : شَہِدْتُ مَعَ عَلِیٍّ الْعِیدَ ، فَلَمَّا صَلَّی خَطَبَ عَلَی رَاحِلَتِہِ ، قَالَ : وَکَانَ عُثْمَانُ یَفْعَلُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 5905","","","كتاب الجمعة"
"5906","(۵۹۰۶) حَدَّثَنَا أَبُوبَکْرِ بْنُ عَیَّاشٍ، عَنْ یَزِیدَ، عَنِ ابْنِ أَبِی لَیْلَی، قَالَ: صَلَّی بِنَا عَلِیٌّ الْعِیدَ، ثُمَّ خَطَبَ عَلَی رَاحِلَتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 5906","","","كتاب الجمعة"
"5907","(۵۹۰۷) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ قَیْسٍ ، قَالَ : رَأَیْتُ الْمُغِیرَۃَ بْنَ شُعْبَۃَ یَخْطُبُ عَلَی بُخْتِیَّۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 5907","","","كتاب الجمعة"
"5908","(۵۹۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ أَخِیہِ ، عَنْ أَبِی کَاہِلٍ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَخْطُبُ عَلَی نَاقَۃٍ خَرْمَاء ، وَحَبَشِیٌّ مُمْسِکٌ بِخِطَامِہَا۔ (ابن ماجہ ۱۲۸۴۔ احمد ۴/۳۰۶)","Da'if","Musannaf Ibn Abi Shaybah 5908","","","كتاب الجمعة"
"5909","(۵۹۰۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا سَعِیدُ بْنُ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ ، عَنْ عَمْرِو بْنِ خَارِجَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَطَبَہُمْ وَہُوَ عَلَی رَاحِلَتِہِ ۔ قَالَ : وَإِنَّ رَاحِلَتَہُ لَتَقَصَعُ بِجِرَّتِہَا ، وَإِنَّ لُعَابَہَا لَیَسِیلُ بَیْنَ کَتِفَیَّ۔ (ترمذی ۲۱۲۱۔ احمد ۴/۱۸۷)","Da'if","Musannaf Ibn Abi Shaybah 5909","","","كتاب الجمعة"
"5910","(۵۹۱۰) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِم ، عَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ ، قَالَ : حدَّثَنَا الْہِرْمَاسُ بْنُ زِیَادٍ ، قَالَ : کُنْتُ رِدْفَ أَبی یَوْمِ الأَضْحَی ، وَرَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَخْطُبُ عَلَی نَاقَۃٍ بِمِنًی۔ (بخاری ۲۸۸۳۔ ابوداؤد ۱۹۴۹)","Hasan","Musannaf Ibn Abi Shaybah 5910","","","كتاب الجمعة"
"5911","(۵۹۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی جَنَابٍ، عَنْ أَبِیہِ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ، قَالَ: خَطَبَنَا عَلِیٌّ یَوْمَ عِیدٍ عَلَی رَاحِلَتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 5911","","","كتاب الجمعة"
"5912","(۵۹۱۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ شِبَاکٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ الإِمَامُ یَوْمَ الْعِیدِ یَبْدَأُ فَیُصَلِّی ، ثُمَّ یَرْکَبُ فَیَخْطُبُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5912","","","كتاب الجمعة"
"5913","(۵۹۱۳) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، أَنَّہُ سَمِعَہُ یَذْکُرُہُ ، قَالَ : رَأَیْتُ الْمُغِیرَۃَ بْنَ شُعْبَۃَ یَخْطُبُ النَّاسَ یَوْمَ الْعِیدِ ، عَلَی بَعِیرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 5913","","","كتاب الجمعة"
"5914","(۵۹۱۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ یُحِبُّ لِلنِّسَائِ أَنْ یُکَبِّرْنَ دُبُرَ الصَّلاَۃ أَیَّامَ التَّشْرِیقِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5914","","","كتاب الجمعة"
"5915","(۵۹۱۵) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، قَالَ : کَانَ الْحَسَنُ لاَ یَرَی التَّکْبِیرَ عَلَی النِّسَائِ أَیَّامَ التَّشْرِیقِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5915","","","كتاب الجمعة"
"5916","(۵۹۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ الْقَارِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، قَالَ: مِنَ السُّنَّۃِ أَنْ یُکَبِّرَ الإِمَامُ عَلَی الْمِنْبَرِ فِی الْعِیدَیْنِ تِسْعًا قَبْلَ الْخُطْبَۃِ، وَسَبْعًا بَعْدَہَا۔(عبدالرزاق ۵۶۷۲)","","Musannaf Ibn Abi Shaybah 5916","","","كتاب الجمعة"
"5917","(۵۹۱۷) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنِ الْحَسَنِ بْنِ أَبِی الْحَسْنَائِ ، عَنِ الْحَسَنِ ، قَالَ : یُکَبِّرُ یَوْمَ الْعِیدَیْنِ أَرْبَعَ عَشْرَۃَ تَکْبِیرَۃً۔","Hasan","Musannaf Ibn Abi Shaybah 5917","","","كتاب الجمعة"
"5918","(۵۹۱۸) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ بُکَیْرِ بْنِ عَامِرٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یَتَیَمَّمُ لِلْعِیدَیْنِ وَالْجِنَازَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5918","","","كتاب الجمعة"
"5919","(۵۹۱۹) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنْ جَعْفَرِ بْنِ نَجِیحٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ؛ فِی الرَّجُلِ یُحْدِثُ فِی الْعِیدِ وَیَخَافُ الْفَوْتَ ، قَالَ : یَتَیَمَّمُ وَیُصَلِّی إِذَا خَافَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5919","","","كتاب الجمعة"
"5920","(۵۹۲۰) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یُحْدِثُ یَوْمَ الْعِیدِ ، قَالَ : یَطْلُبُ الْمَائَ فَیَتَوَضَّأْ ، وَلاَ یَتَیَمَّمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 5920","","","كتاب الجمعة"
"5921","(۵۹۲۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا عَطَائٌ الْخُرَاسَانِیُّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : کَانَتِ الصَّلاَۃُ الَّتِی أَرَادَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُحَرِّقَ عَلَی مَنْ تَخَلَّفَ عَنْہَا صَلاَۃَ الْعِشَائِ۔","","Musannaf Ibn Abi Shaybah 5921","","","كتاب الجمعة"
"5922","(۵۹۲۲) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، وَغَیْرِہِ ، عَنِ الْحَسَنِ ، قَالَ : کَانَتِ الصَّلاَۃُ الَّتِی أَرَادَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُحَرِّقَ عَلَی مَنْ تَخَلَّفَ عَنْہَا الْجُمُعَۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 5922","","","كتاب الجمعة"
"5923","(۵۹۲۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِح ، عَنْ أَبِی ہُرَیْرَۃَ ، فِی حَدِیثٍ ذَکَرَہُ عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ قَالَ : ہِیَ الْعِشَائُ وَالْفَجْرُ۔ (بخاری ۶۴۴۔ نسائی ۹۲۱)","Sahih","Musannaf Ibn Abi Shaybah 5923","","","كتاب الجمعة"
"5924","(۵۹۲۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ زُہَیْرٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَص ، قَالَ : سَمِعَہُ مِنْہُ ، عَنْ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ قَالَ : ہِیَ الْجُمُعَۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 5924","","","كتاب الجمعة"
"5925","(۵۹۲۵) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَتَبْتُ إِلَی نَافِعٍ أَسْأَلُہُ عَنِ الْقَوْمِ یَکُونُونَ فِی الرَُسْتَاقِ وَیَحْضُرُہُمُ الْعِیدُ ، ہَلْ یَجْتَمِعُونَ فَیُصَلِّی بِہِمْ رَجُلٌ ؟ وَعَنِ الْجُمُعَۃِ ؟ فَکَتَبَ إِلَیَّ : أَمَّا الْعِیدُ فَإِنَّہُمْ یَجْتَمِعُونَ فَیُصَلِّی بِہِمْ رَجُلٌ ، وَأَمَّا الْجُمُعَۃُ فَلاَ عِلْمَ لِی بِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5925","","","كتاب الجمعة"
"5926","(۵۹۲۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عِکْرِمَۃَ ؛ أَنَّہُ قَالَ فِی الْقَوْمِ یَکُونُونَ فِی السَّوَادِ فِی السَّفَرِ فِی یَوْمِ عِیدِ فِطْرِ ، أَوْ أَضْحَی ، قَالَ : یَجْتَمِعُونَ فَیُصَلُّونَ ، وَیَؤُمُّہُمْ أَحَدُہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 5926","","","كتاب الجمعة"
"5927","(۵۹۲۷) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ فِی أَہْلِ الْقُرَی وَأَہْلِ السَّوَادِ یَحْضُرُہُمُ الْعِیدُ ، قَالَ : کَانَ لاَ یَرَی أَنْ یَخْرُجُوا فَیُصَلِّی بِہِمْ رَجُلٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5927","","","كتاب الجمعة"
"5928","(۵۹۲۸) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی، قَالَ: حدَّثَنَا شَیْبَانُ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، قَالَ : سُئِلَ عَطَائُ بْنُ أَبِی رَبَاحٍ؟ قَالَ : إِذَا کَانَتْ قَرْیَۃً جَامِعَۃً فَلْیُصَلُّوا رَکْعَتَیْنِ مِثْلَ یَوْمِ الْجُمُعَۃِ ۔n قَالَ یَحْیَی : وَسُئِلَ الْحَکَمُ بْنُ عُتَیْبَۃَ ؟ فَقَالَ : لاَ جُمُعَۃَ إِلاَّ مَعَ الإِمَامِ فِی الْمَسْجِدِ الْجَامِعِ ۔n قَالَ یَحْیَی ، وَقَالَ قَتَادَۃُ : لاَ أَعْلَمُ الْجُمُعَۃَ إِلاَّ مَعَ السُّلْطَانِ فِی أَمْصَارِ الْمُسْلِمِینَ ۔n قَالَ یَحْیَی : یُقَالُ : لاَ جُمُعَۃَ ، وَلاَ أَضْحَی ، وَلاَ فِطْرَ إِلاَّ لِمَنْ حَضَرَ مَعَ الإِمَام۔","No Data Available","Musannaf Ibn Abi Shaybah 5928","","","كتاب الجمعة"
"5929","(۵۹۲۹) حَدَّثَنَا مُعَمَّرُ بْنُ سُلَیْمَانَ الرَّقِّیُّ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ إِلَی أَہْلِ الْقُرَی یَأْمُرہُمْ أَنْ یُصَلُّوا الْفِطْرَ وَالأَضْحَی ، وَأَنْ یُجَمِّعُوا۔","No Data Available","Musannaf Ibn Abi Shaybah 5929","","","كتاب الجمعة"
"5930","(۵۹۳۰) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ مَکْحُولٍ ، قَالَ : إِذَا کَانَتِ الْقَرْیَۃُ لَہَا أَمِیرٌ فَعَلَیْہِمُ الْجُمُعَۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5930","","","كتاب الجمعة"
"5931","(۵۹۳۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ ، قَالَ : خَرَجَ مَسْرُوقٌ ، وَعُرْوَۃُ بْنُ الْمُغِیرَۃِ إِلَی بَدْوٍ لَہُمْ ، قَالَ : فَحَضَرَتِ الْجُمُعَۃُ ، فَلَمْ یُجَمِّعُوا ، وَحَضَرَ الْفِطْرُ فَلَمْ یُفْطِرُوا۔","No Data Available","Musannaf Ibn Abi Shaybah 5931","","","كتاب الجمعة"
"5932","(۵۹۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنٍ ، عَنْ مُطَرِّفٍ ، عَمَّنْ سَمِعَ عَطَائً ، وَمُجَاہِدًا ، قَالاَ : یُقْضَی التَّکْبِیرُ فِی الْعِیدَیْنِ ، کَمَا تُقْضَی الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 5932","","","كتاب الجمعة"
"5933","(۵۹۳۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یُصَلِّی رَکْعَتَیْنِ وَیُکَبِّرُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5933","","","كتاب الجمعة"
"5934","(۵۹۳۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، قَالَ : یُصَلِّی مِثْلَ صَلاَتِہِ ، وَیُکَبِّرُ مِثْلَ تَکْبِیرِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5934","","","كتاب الجمعة"
"5935","(۵۹۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، قَالَ : کَانُوا یَقُولُونَ : إِذَا شَکَّ الرَّجُلُ فِی صَلاَۃِ الْمَغْرِبِ فَأَرَادَ أَنْ یُعِیدَ ، صَلَّی رَکْعَۃً فَشَفَّعَہَا ، ثُمَّ صَلَّی ثَلاَثَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 5935","","","كتاب الجمعة"
"5936","(۵۹۳۶) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الْقَاسِمِ ، مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5936","","","كتاب الجمعة"
"5937","(۵۹۳۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، قَالَ : أَخَذَ بِیَدِی زِیَادُ بْنُ أَبِی الْجَعْدِ فَأَوْقَفَنِی عَلَی شَیْخٍ بِالرَّقَّۃِ ، یُقَالَ لَہُ : وَابِصَۃُ بْنُ مَعْبَدٍ ، فَقَالَ : صَلَّی رَجُلٌ خَلْفَ الصَّفِّ وَحْدَہُ فَأَمَرَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُعِیدَ۔ (ترمذ ی۲۳۰۔ احمد ۴/۲۲۸)","Sahih","Musannaf Ibn Abi Shaybah 5937","","","كتاب الجمعة"
"5938","(۵۹۳۸) حَدَّثَنَا مُلاَزِمُ بْنُ عَمْرٍو ، عَنْ عَبْدِ اللہِ بْنِ بَدْرٍ ، قَالَ : حدَّثَنِی عَبْدُ الرَّحْمَنِ بْنُ عَلِیِّ بْنِ شَیْبَانَ ، عَنْ أَبِیہِ عَلِیِّ بْنِ شَیْبَانَ ، وَکَانَ مِنَ الْوَفْدِ ، قَالَ : خَرَجْنَا حَتَّی قَدِمْنَا عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَبَایَعْنَاہُ وَصَلَّیْنَا خَلْفَہُ ، فَرَأَی رَجُلاً یُصَلِّی خَلْفَ الصَّفِّ وَحْدَہُ ، فَوَقَفَ عَلَیْہِ نَبِیُّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی انْصَرَفَ ، فَقَالَ : اسْتَقْبِلْ صَلاَتَکَ ، فَلاَ صَلاَۃَ لِلَّذِی خَلْفَ الصَّفِّ۔","Sahih","Musannaf Ibn Abi Shaybah 5938","","","كتاب الجمعة"
"5939","(۵۹۳۹) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرِو بْنِ مَرْوَانَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یُعِیدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5939","","","كتاب الجمعة"
"5940","(۵۹۴۰) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : لاَ یَقُمْ وَحْدَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5940","","","كتاب الجمعة"
"5941","(۵۹۴۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ عَمْرِو بْنِ مُرۃ : عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ عَمْرِو بْنِ رَاشِدٍ ، عَنْ وَابِصَۃَ بْنِ مَعْبَدٍ ؛ أَنَّ رَجُلاً صَلَّی خَلْفَ الصُفُوفِ وَحْدَہُ ، فَأَمَرَہُ رَسُول اللہ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُعِیدَ الصَلاَۃَ۔ (ابوداؤد ۶۸۲۔ احمد ۴/۲۲۸)","Da'if","Musannaf Ibn Abi Shaybah 5941","","","كتاب الجمعة"
"5942","(۵۹۴۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنْ جُوَیْبِرٍ، عَنِ الضَّحَّاکِ، عَنْ حُذَیْفَۃَ ، قَالَ: سُئِلَ عَنْ رَجُلٍ صَلَّی خَلْفَ الصُّفُوفِ وَحْدَہُ ؟ قَالَ : لاَ یُعِیدُ۔","Da'if","Musannaf Ibn Abi Shaybah 5942","","","كتاب الجمعة"
"5943","(۵۹۴۳) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، وَعَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : یُجْزِئُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5943","","","كتاب الجمعة"
"5944","(۵۹۴۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَدْخُلُ الْمَسْجِدَ فَلاَ یَسْتَطِیعُ أَنْ یَدْخُلَ فِی الصَّفِّ ، قَالَ : کَانَ یَرَی ذَلِکَ یُجْزِئُہُ إِنْ صَلَّی خَلْفَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 5944","","","كتاب الجمعة"
"5945","(۵۹۴۵) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ سَلمِ بْنِ أَبِی الذَّیَّالِ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یُسْبَقُ بِرَکْعَۃٍ فَیُحْدِثُ الإِمَام، فَیَأْخُذُ بِیَدِ الَّذِی سُبِقَ فَیُقَدِّمُہُ، کَیْفَ یَصْنَعُ؟ قَالَ: یُصَلِّی رَکْعَۃً وَیَجْلِسُ، ثُمَّ یَبْنِی عَلَی صَلاَۃِ الْقَوْمِ، فَإِذَا أَتَمَّ بِہِمْ أَرْبَعًا جَلَسَ فَتَشَہَّدَ ، ثُمَّ أَخَذَ بِیَدِ رَجُلٍ فَسَلَّمَ ، ثُمَّ قَامَ الرَّجُلُ فَصَلَّی رَکْعَتَہُ الَّتِی سُبِقَ بِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5945","","","كتاب الجمعة"
"5946","(۵۹۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ أَبِی عَبْدِ اللہِ الشَّقَرِیِّ ، عَنْ إِبْرَاہِیمَ ؛ فِی رَجُلٍ صَلَّی رَکْعَۃً فَأَحْدَثَ ، فَأَخَذَ بِیَدِ رَجُلٍ فَقَدَّمَہُ ، وَقَدْ فَاتَتْہُ تِلْکَ الرَّکْعَۃُ ، قَالَ : یُصَلِّی بِہِمْ بَقِیَّۃَ صَلاَتِہِمْ ، فَإِذَا أَتَمَّ أَخَذَ بِیَدِ رَجُلٍ مِمَّنْ شَہِدَ تِلْکَ الرَّکْعَۃَ ، فَقَدَّمَہُ فَسَلَّمَ بِہِمْ ، ثُمَّ قَامَ فَقَضَی تِلْکَ الرَّکْعَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5946","","","كتاب الجمعة"
"5947","(۵۹۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَرْقَمَ بْنِ شُرَحْبِیلَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمَّا جَائَ إِلَی أَبِی بَکْرٍ وَہُوَ فِی الصَّلاَۃ فِی مَرَضِہِ ، أَخَذَ مِنَ الْقِرَائَۃِ مِنْ حَیْثُ بَلَغَ أَبُو بَکْرٍ۔ (احمد ۱/۳۵۵)","Sahih","Musannaf Ibn Abi Shaybah 5947","","","كتاب الجمعة"
"5948","(۵۹۴۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ فِی رَجُلٍ أَحْدَثَ فِی الصَّلاَۃ ، فَأَخَذَ بِیَدِ رَجُلٍ فَقَدَّمَہُ ، قَالَ : تُجْزِئُہِ قِرَائَتُہُ إِنْ کَانَ قَرَأَ ، وَتَکْبِیرُہُ إِنْ کَانَ کَبَّرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5948","","","كتاب الجمعة"
"5949","(۵۹۴۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ ہِشَامٍ ، قَالَ : کَانَ الْحَسَنُ یَقُولُ فِی الَّذِی یُقَدِّمُہُ الإِمَامُ : إِنْ شَائَ قَرَأَ مِنْ حَیْثُ انْتَہَی الإِمَامُ ، وَإِنْ شَائَ اخْتَصَّ بَعْضَ السُّوَرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5949","","","كتاب الجمعة"
"5950","(۵۹۵۰) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ حَجَّاجٍ ، عَنْ رَجُلٍ ، عَنْ عَمْرِو بْنِ الْحَارِثِ بْنِ أَبِی ضِرَارٍ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ ؛ فِی الرَّجُلِ إِذَا رَعَفَ فِی الصَّلاَۃِ ، قَالَ : یَنْفَتِلُ فَیَتَوَضَّأُ ، ثُمَّ یَرْجِعُ فَیُصَلِّی ، وَیَعْتَدُّ بِمَا مَضَی۔","Da'if","Musannaf Ibn Abi Shaybah 5950","","","كتاب الجمعة"
"5951","(۵۹۵۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ، عَنْ حَجَّاجٍ، قَالَ: حدَّثَنِی شَیْخٌ مِنْ أَہْلِ الْحَدِیثِ، عَنْ أَبِی بَکْرٍ، بِمِثْلِ قَوْلِ عُمَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 5951","","","كتاب الجمعة"
"5952","(۵۹۵۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، عَنْ خِلاَسٍ، عَنْ عَلِیٍّ، قَالَ: إِذَا رَعَفَ الرَّجُلُ فِی صَلاَتِہِ، أَوْ قَائَ فَلْیَتَوَضَّأْ ، وَلاَ یَتَکَلَّمْ ، وَلْیَبْنِ عَلَی صَلاَتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 5952","","","كتاب الجمعة"
"5953","(۵۹۵۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ابْنُ أَبِی لَیْلَی ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَنْ رَعَفَ فِی صَلاَتِہِ فَلْیَنْصَرِفْ فَلْیَتَوَضَّأْ ، فَإِنْ لَمْ یَتَکَلَّمْ بَنَی عَلَی صَلاَتِہِ ، وَإِنْ تَکَلَّمَ اسْتَأْنَفَ الصَّلاَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 5953","","","كتاب الجمعة"
"5954","(۵۹۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عِمْرَانَ بْنِ ظَبْیَانَ ، عَنْ أَبِی تِحْیَی حُکَیْمِ بْنِ سَعْدٍ ، عَنْ سَلْمَانَ ، قَالَ : إِذَا أَحْدَثَ أَحَدُکُمْ فِی الصَّلاَۃِ فَلْیَنْصَرِفْ غَیْرَ وَاعٍ لِصُنْعِہِ فَلْیَتَوَضَّأْ ، ثُمَّ لْیَعُدْ فِی آیَتِہِ الَّتِی کَانَ یَقْرَأُ۔","Da'if","Musannaf Ibn Abi Shaybah 5954","","","كتاب الجمعة"
"5955","(۵۹۵۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَلِیُّ بْنُ صَالِحٍ ، وَإِسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : إِذَا وَجَدَ أَحَدُکُمْ فِی بَطْنِہِ رزًّا ، أَوْ قَیْئًا ، أَوْ رُعَافًا فَلْیَنْصَرِفْ ، فَلْیَتَوَضَّأْ ، ثُمَّ لِیَبْنِ عَلَی صَلاَتِہِ مَا لَمْ یَتَکَلَّمْ۔","Hasan","Musannaf Ibn Abi Shaybah 5955","","","كتاب الجمعة"
"5956","(۵۹۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّ عَلْقَمَۃَ رَعَفَ فِی الصَّلاَۃِ ، فَأَخَذَ بِیَدِ رَجُلٍ فَقَدَّمَہُ ، ثُمَّ ذَہَبَ فَتَوَضَّأَ ، ثُمَّ جَائَ فَبَنَی عَلَی مَا بَقِیَ مِنْ صَلاَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5956","","","كتاب الجمعة"
"5957","(۵۹۵۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ طَاوُوسٍ ، قَالَ : إِذَا رَعَفَ الرَّجُلُ فِی صَلاَتِہِ انْصَرَفَ فَتَوَضَّأَ ، ثُمَّ بَنَی عَلَی مَا بَقِیَ مِنْ صَلاَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5957","","","كتاب الجمعة"
"5958","(۵۹۵۸) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، قَالَ : أَبْصَرْتُ سَالِمَ بْنَ عَبْدِ اللہِ صَلَّی صَلاَۃَ الْغَدَاۃِ رَکْعَۃً ، ثُمَّ رَعَفَ ، فَخَرَجَ فَتَوَضَّأَ ، ثُمَّ جَائَ فَبَنَی عَلَی مَا بَقِیَ مِنْ صَلاَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5958","","","كتاب الجمعة"
"5959","(۵۹۵۹) حَدَّثَنَا ہُشَیْمٌ ، وَابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، وَالشَّعْبِیِّ ، أَنَّہُمَا قَالاَ فِی الْحَدَثِ وَالرُّعَافِ : یَنْصَرِفُ فَیَتَوَضَّأُ ، فَإِنْ تَکَلَّمَ اسْتَأْنَفَ الصَّلاَۃَ ، وَإِنْ لَمْ یَتَکَلَّمْ بَنَی عَلَی صَلاَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5959","","","كتاب الجمعة"
"5960","(۵۹۶۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَقُولُ فِیمَنْ رَعَفَ فِی صَلاَتِہِ ، قَالَ : یَنْصَرِفُ فَیَتَوَضَّأُ ، ثُمَّ یَبْنِی عَلَی مَا بَقِیَ مِنْ صَلاَتِہِ مَا لَمْ یَتَکَلَّمْ ، فَإِنْ تَکَلَّمَ اسْتَأْنَفَ الصَّلاَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5960","","","كتاب الجمعة"
"5961","(۵۹۶۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَبْدُ الْمَلِکِ ، عَنْ عَطَائٍ ؛ أَنَّہُ قَالَ مِثْلَ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5961","","","كتاب الجمعة"
"5962","(۵۹۶۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ ؛ فِی صَاحِبِ الْقَیْئِ ، وَالرُّعَافِ ، وَالْقُبْلَۃِ : یَنْصَرِفُ فَیَتَوَضَّأُ ، فَإِنْ لَمْ یَتَکَلَّمْ بَنَی عَلَی مَا بَقِیَ ، وَإِنْ تَکَلَّمَ اسْتَأْنَفَ ۔ وَکَانَ یَقُولُ فِی صَاحِبِ الْغَائِطِ وَالْبَوْلِ : یَنْصَرِفُ فَیَتَوَضَّأُ ، وَیَسْتَقْب??لُ الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 5962","","","كتاب الجمعة"
"5963","(۵۹۶۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یُشَدِّدُونَ فِی الْغَائِطِ وَالْبَوْلِ ، وَیَرَوْنَ أَنَّہُ أَشَدُّ مِنَ الْمَنِیِّ وَالدَّمِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5963","","","كتاب الجمعة"
"5964","(۵۹۶۴) حَدَّثَنَا عَبْدُالأَعْلَی، عَنْ بُرْدٍ، عَنْ مَکْحُولٍ، أَنَّہُ کَانَ یَقُولُ: إِنَّہُ إِذَا رَعَفَ الرَّجُلُ فِی صَلاَتِہِ، فَإِنَّہُ یَنْصَرِفُ فَیَتَوَضَّأُ ، ثُمَّ یَجِیئُ فَیَبْنِی عَلَی مَا مَضَی ، مَا لَمْ یَتَکَلَّمْ إِنْ شَائَ ، فَإِنْ أَحْدَثَ أَعَادَ الْوُضُوئَ وَأَعَادَ الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 5964","","","كتاب الجمعة"
"5965","(۵۹۶۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَبْدُ الْحَمِیدِ الْمَدَنِیُّ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ قُسَیْطٍ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ الْمُسَیَّبِ رَعَفَ وَہُوَ فِی صَلاَتِہِ ، فَأَتَی دَارَ أُمِّ سَلَمَۃَ زَوْجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَتَوَضَّأَ وَلَمْ یَتَکَلَّمْ ، وَبَنَی عَلَی صَلاَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5965","","","كتاب الجمعة"
"5966","(۵۹۶۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ عَامِرٍ ، قَالَ : إِذَا أَحْدَثْتَ فِی الصَّلاَۃِ ، فَصَلِّ مَا بَقِیَ وَإِنْ تَکَلَّمْتَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5966","","","كتاب الجمعة"
"5967","(۵۹۶۷) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ، عَنْ علی ؛ فِی رَجُلٍ یُصِیبُہُ الْقَیْئُ وَالرُّعَافُ فِی الصَّلاَۃِ ، قَالَ : یَنْفَتِلُ فَیَتَوَضَّأُ ، ثُمَّ یَبْنِی عَلَی صَلاَتِہِ مَا لَمْ یَتَکَلَّمْ۔","Sahih","Musannaf Ibn Abi Shaybah 5967","","","كتاب الجمعة"
"5968","(۵۹۶۸) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ سَعِیدٍ ، عَنْ أَبِی معشرٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ، بِمِثْلِہِ ، إِلاَّ أَنَّہُ لَمْ یَذْکُرِ الْقَیْئَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5968","","","كتاب الجمعة"
"5969","(۵۹۶۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : أَجْمَعُوا عَلَی أَنَّہُ إِذَا تَکَلَّمَ اسْتَأْنَفَ ، وَأَنَا أُحِبُّ أَنْ یَتَکَلَّمَ وَیَسْتَأْنِفَ الصَّلاَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5969","","","كتاب الجمعة"
"5970","(۵۹۷۰) حَدَّثَنَا أَبُو بَکْرٍ ، قَالَ : حَدَّثَنَا رَبِیعٌ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا اسْتَدْبَرَ الرَّجُلُ الْقِبْلَۃَ اسْتَقْبَلَ ، وَإِنِ الْتَفَتَ عَنْ یَمِینِہِ ، أَوْ عَنْ شِمَالِہِ مَضَی فِی صَلاَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5970","","","كتاب الجمعة"
"5971","(۵۹۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : أَحَبُّ إِلَیَّ فِی الرُّعَافِ إِذَا اسْتَدْبَرَ الْقِبْلَۃَ أَنْ یَسْتَقْبِلَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5971","","","كتاب الجمعة"
"5972","(۵۹۷۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ عَمِّہِ ، قَالَ : سَاعَۃٌ مَا أَتَیْتُ عَبْدَ اللہِ بْنَ مَسْعُودٍ فِیہَا إِلاَّ وَجَدْتُہُ یُصَلِّی ؛ مَا بَیْنَ الْمَغْرِبِ وَالْعِشَائِ ، وَکَانَ یَقُولُ : ہِیَ سَاعَۃُ غَفْلَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 5972","","","كتاب الجمعة"
"5973","(۵۹۷۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُوسَی بْنُ عُبَیْدَۃَ ، عَنْ أَخِیہِ عَبْدِ اللہِ بْنِ عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : صَلاَۃُ الأَوَّابِینَ مَا بَیْنَ أَنْ یَنْکَفِتَ أَہْلُ الْمَغْرِبِ إِلَی أَنْ یُثَوَّب إِلَی الْعِشَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 5973","","","كتاب الجمعة"
"5974","(۵۹۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنِ الْعَلاَئِ بْنِ بَدْرٍ ، عَنْ أَبِی الشَّعْثَائِ ، قَالَ : قَالَ سَلْمَانُ : عَلَیْکُمْ بِالصَّلاَۃ فِیمَا بَیْنَ الْعِشَائَیْنِ ، فَإِنَّہُ یُخَفِّفُ عَنْ أَحَدِکُمْ مِنْ حِزْبِہِ ، وَیُذْہِبُ عَنْہُ مَلْغَاہُ أَوَّلَ اللَّیْلِ ، فَإِنَّ مَلْغَاہُ أَوَّلَ اللَّیْلِ مَہْدَنَۃٌ ، أَوْ مَذْہَبَۃٌ لآخِرِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5974","","","كتاب الجمعة"
"5975","(۵۹۷۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ وِقَائِ بْنِ إِیَاسٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ یُصَلِّی مَا بَیْنَ الْمَغْرِبِ وَالْعِشَائِ ، وَیَقُولُ : ہِیَ نَاشِئَۃُ اللَّیْلِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5975","","","كتاب الجمعة"
"5976","(۵۹۷۶) حَدَّثَنَا عَبْدُ اللہِ بْنِ دَاوُد ، عَنْ بُکَیْرِ بنِ عَامِرٍ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ؛ أَنَّہُ کَانَ یُصَلِّی مَا بَیْنَ الْمَغْرِبِ وَالْعِشَائِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5976","","","كتاب الجمعة"
"5977","(۵۹۷۷) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ عُمَارَۃَ بْنِ زَاذَانَ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ ؛ أَنَّہُ کَانَ یُصَلِّی مَا بَیْنَ الْمَغْرِبِ وَالْعِشَائِ ، وَیَقُولُ : ہِیَ نَاشِئَۃُ اللَّیْلِ۔","Hasan","Musannaf Ibn Abi Shaybah 5977","","","كتاب الجمعة"
"5978","(۵۹۷۸) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، عَنْ إِبْرَاہِیمَ بْنِ نَافِعٍ ، قَالَ : کَانَ الْحَسَنُ بْنُ مُسْلِمٍ یُصَلِّی مَا بَیْنَ الْمَغْرِبِ وَالْعِشَائِ ، قَالَ : وَزَعَمَ الْحَسَنُ أَنَّ طَاوُوسًا لَمْ یَکُنْ یَرَاہُ شَیْئًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5978","","","كتاب الجمعة"
"5979","(۵۹۷۹) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ : حدَّثَنَا إِبْرَاہِیمُ بْنُ نَافِعٍ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : لَمْ یَکُنْ یَعُدُّہَا مِنْ صَلاَۃِ اللَّیْلِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5979","","","كتاب الجمعة"
"5980","(۵۹۸۰) حَدَّثَنَا یَحْیَی بْنُ أَبی بُکَیْر ، قَالَ : حدَّثَنَا إِبْرَاہِیمُ بْنُ نَافِعٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّ عَبْدَ اللہِ بْنَ عُمَرَ لَمْ یَکُنْ یُصَلِّیہَا إِلاَّ فِی رَمَضَانَ ، یَعْنِی مَا بَیْنَ الْمَغْرِبِ وَالْعِشَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 5980","","","كتاب الجمعة"
"5981","(۵۹۸۱) حَدَّثَنَا مُحَمَّدُ بْنُ بِشرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ؛ فِی قَوْلِہِ : {تَتَجَافَی جُنُوبُہُمْ عَنِ الْمَضَاجِعِ} قَالَ : کَانُوا یَتَطَوَّعُونَ فِیمَا بَیْنَ الصَّلاَتَیْنِ ؛ الْمَغْرِبِ وَالْعِشَائِ ، فَیُصَلُّونَ۔","Sahih","Musannaf Ibn Abi Shaybah 5981","","","كتاب الجمعة"
"5982","(۵۹۸۲) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ، عَنْ إِسْرَائِیلَ، عَنْ مَیْسَرَۃَ بْنِ حَبِیبٍ النَّہْدِیِّ ، عَنِ الْمِنْہَالِ ، عَنْ زِرِّ بْنِ حُبَیْشٍ، عَنْ حُذَیْفَۃَ ، قَالَ : أَتَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَصَلَّیْتُ مَعَہُ الْمَغْرِبَ ، ثُمَّ قَامَ یُصَلِّی حَتَّی صَلاَۃِ الْعِشَائِ۔ (ترمذی ۳۷۸۱۔ احمد ۵/۴۰۴)","Sahih","Musannaf Ibn Abi Shaybah 5982","","","كتاب الجمعة"
"5983","(۵۹۸۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَنْ ثُوَیْرِ بْنِ أَبِی فَاخِتَۃَ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، قَالَ : ذُکِرَ لَہُ أَنَّ مَا بَیْنَ الْمَغْرِبِ وَالْعِشَائِ صَلاَۃُ الْغَفْلَۃِ ، فَقَالَ عَلِیٌّ : فِی الْغَفْلَۃِ وَقَعْتُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 5983","","","كتاب الجمعة"
"5984","(۵۹۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُوسَی بْنُ عُبَیْدَۃَ ، عَنْ أَیُّوبَ بْنِ خَالِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَنْ صَلَّی أَرْبَعًا بَعْدَ الْمَغْرِبِ کَانَ کَالْمُعَقِّبِ غَزْوَۃً بَعْدَ غَزْوَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 5984","","","كتاب الجمعة"
"5985","(۵۹۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، قَالَ : صَلَّیْتُ إِلَی جَنْبِ الْحَسَنِ بْنِ عَلِیٍّ الْمَغْرِبَ ، ثُمَّ صَلَّیْتُ رَکْعَتَیْنِ بَعْدَ الْمَغْرِبِ ، ثُمَّ قُمْتُ أُصَلِّی فَنَہَرَنِی ، وَقَالَ : إِنَّمَا ہُمَا رَکْعَتَانِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5985","","","كتاب الجمعة"
"5986","(۵۹۸۶) حَدَّثَنَا أَبُو بَکْرٍ ، قَالَ : حَدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ عُمَرَ ، قَالَ : سَمِعْتُ مَکْحُولاً ، یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ صَلَّی رَکْعَتَیْنِ بَعْدَ الْمَغْرِبِ ، یَعْنِی قَبْلَ أَنْ یَتَکَلَّمَ ، رُفِعَتْ صَلاَتُہُ فِی عِلِّیِّینَ۔","","Musannaf Ibn Abi Shaybah 5986","","","كتاب الجمعة"
"5987","(۵۹۸۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنْ عِیسَی بْنِ عَاصِمِ الأَسَدِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ: لَقَدْ تَرَکْتُ ، أَوْ لَوْ تَرَکْتُ الرَّکْعَتَیْنِ بَعْدَ الْمَغْرِبِ لَخَشِیتُ أَنْ لاَ یُغْفَرَ لِی۔","No Data Available","Musannaf Ibn Abi Shaybah 5987","","","كتاب الجمعة"
"5988","(۵۹۸۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا فُضَیْلُ بْنُ غَزْوَانَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُحْیِی مَا بَیْنَ الظُّہْرِ وَالْعَصْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 5988","","","كتاب الجمعة"
"5989","(۵۹۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ إِبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یُشْبِہُونَ صَلاَۃَ الْعِشَائِ ، وَمَا بَیْنَ الظُّہْرِ وَالْعَصْرِ بِصَلاَۃِ اللَّیْلِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5989","","","كتاب الجمعة"
"5990","(۵۹۹۰) حَدَّثَنَا عَبْدُاللہِ بْنُ دَاوُد، عَنْ بُکَیْرِ بْنِ عَامِرٍ، عَنِ الشَّعْبِیِّ، قَالَ: کَانَ عَبْدُاللہِ یُصَلِّی مَا بَیْنَ الظُّہْرِ وَالْعَصْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 5990","","","كتاب الجمعة"
"5991","(۵۹۹۱) حَدَّثَنَا جَرِیرٌ ، عَنْ أَبِی سِنَانٍ ، عَنْ أَبِی صَالِحٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَرْبَعُ رَکَعَاتٍ قَبْلَ الظُّہْرِ یُعْدَلْنَ بِصَلاَۃِ السَّحَرِ۔","","Musannaf Ibn Abi Shaybah 5991","","","كتاب الجمعة"
"5992","(۵۹۹۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سَعِیدِ بْنِ مَسْرُوقٍ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، قَالَ : قَالَ أَبُو أَیُّوبَ الأَنْصَارِیُّ: یَا رَسُولَ اللہِ ، مَا أَرْبَعُ رَکَعَاتٍ تُوَاظِبُ عَلَیْہِنَّ قَبْلَ الظُّہْرِ ؟ فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ أَبْوَابَ الْجَنَّۃِ تُفْتَحُ عِنْدَ زَوَالِ الشَّمْسِ ، فَلاَ تُرْتَجُّ حَتَّی تُقَامَ الصَّلاَۃُ ، فَأُحِبُّ أَنْ أُقَدِّمَ۔ (ابوداؤد ۱۲۶۴۔ احمد ۵/۴۱۶)","","Musannaf Ibn Abi Shaybah 5992","","","كتاب الجمعة"
"5993","(۵۹۹۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنِ الأَعْمَشِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ عَلِیِّ بْنِ الصَّلْتِ ، عَنْ أَبِی أَیُّوبَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، بِنَحْوِہِ۔ (بخاری ۲۴۰۳۔ احمد ۵/۴۱۸)","Da'if","Musannaf Ibn Abi Shaybah 5993","","","كتاب الجمعة"
"5994","(۵۹۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، عَنْ أَبِیہِ ، قَالَ : صَلَّیْتُ مَعَ عُمَرَ أَرْبَعَ رَکَعَاتٍ قَبْلَ الظُّہْرِ فِی بَیْتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 5994","","","كتاب الجمعة"
"5995","(۵۹۹۵) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ حُصَیْنٍ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : لَمْ یَکُنْ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَتْرُکُونَ أَرْبَعَ رَکَعَاتٍ قَبْلَ الظُّہْرِ ، وَرَکْعَتَیْنِ قَبْلَ الْفَجْرِ عَلَی حَالٍ۔","Sahih","Musannaf Ibn Abi Shaybah 5995","","","كتاب الجمعة"
"5996","(۵۹۹۶) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حُصَیْنٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ : أَرْبَعٌ قَبْلَ الظُّہْرِ لاَ یُسَلِّمُ بَیْنَہُنَّ إِلاَّ أَنْ یَتَشَہَّدَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5996","","","كتاب الجمعة"
"5997","(۵۹۹۷) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ، عَنْ أَبِی صَخْرَۃَ، عَنْ عَبْدِاللہِ بْنِ عُتْبَۃَ، قَالَ: رَأَیْتُ عُمَرَ یُصَلِّی أَرْبَعًا قَبْلَ الظُّہْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 5997","","","كتاب الجمعة"
"5998","(۵۹۹۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ عُمَرَ بْنِ حَمْزَۃَ ، عَنِ ابْنِ أَبِی نَمِرٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّہُ کَانَ یُصَلِّی أَرْبَعًا قَبْلَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5998","","","كتاب الجمعة"
"5999","(۵۹۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ بَشِیرٍ ، عَنْ شَیْخٍ مِنَ الأَنْصَارِ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ صَلَّی أَرْبَعًا قَبْلَ الظُّہْرِ کُنَّ لَہُ کَعِتْقِ رَقَبَۃٍ مِنْ وَلَدِ إِسْمَاعِیلَ۔ (طبرانی ۹۶۵)","Da'if","Musannaf Ibn Abi Shaybah 5999","","","كتاب الجمعة"
"6000","(۶۰۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُصَلِّی قَبْلَ الظُّہْرِ أَرْبَعًا۔","Sahih","Musannaf Ibn Abi Shaybah 6000","","","كتاب الجمعة"
"6001","(۶۰۰۱) حَدَّثَنَا یَزِیدُ ، عَنِ الأَصْبَغِ ، عَنِ الْقَاسِمِ بْنِ أَبِی أَیُّوبَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ یُصَلِّی قَبْلَہَا أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 6001","","","كتاب الجمعة"
"6002","(۶۰۰۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی أَرْبَعًا قَبْلَ الظُّہْرِ۔ (بخاری ۱۱۸۲۔ ابوداؤد ۱۲۴۷)","Da'if","Musannaf Ibn Abi Shaybah 6002","","","كتاب الجمعة"
"6003","(۶۰۰۳) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ قَابُوسَ ، عَنْ أَبِیہِ ، قَالَ : أَرْسَلَ أَبِی إِلَی عَائِشَۃَ : أَیُّ صَلاَۃٍ کَانَتْ أَحَبَّ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُوَاظِبَ عَلَیْہَا ؟ قَالَتْ : کَانَ یُصَلِّی أَرْبَعًا قَبْلَ الظُّہْرِ ، یُطِیلُ فِیہِنَّ الْقِیَامَ ، وَیُحْسِنُ فِیہِنَّ الرُّکُوعَ وَالسُّجُودَ۔","Da'if","Musannaf Ibn Abi Shaybah 6003","","","كتاب الجمعة"
"6004","(۶۰۰۴) حَدَّثَنَا جَرِیرٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ یُصَلِّی أَرْبَعًا قَبْلَ الظُّہْرِ ، یُطِیلُہُنَّ۔","Sahih","Musannaf Ibn Abi Shaybah 6004","","","كتاب الجمعة"
"6005","(۶۰۰۵) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنِ ابْنِ عُمَرَ ، مِثْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 6005","","","كتاب الجمعة"
"6006","(۶۰۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ أَبِی عَوْنٍ الثَّقَفِیِّ ؛ أَنَّ الْحَسَنَ بْنَ عَلِیٍّ کَانَ یُصَلِّی أَرْبَعًا قَبْلَ الظُّہْرِ ، یُطِیلُ فِیہِنَّ ۔ قَالَ أَبُو عَوْنٍ : إِنْ کَانَ خَفِیفَ الْقِرَائَۃِ فَمِنَ الطِّوَالِ ، وَإِنْ کَانَ بَطِیئَ الْقِرَائَۃِ فَمِنَ الْمِئِینَ۔","Hasan","Musannaf Ibn Abi Shaybah 6006","","","كتاب الجمعة"
"6007","(۶۰۰۷) حَدَّثَنَا ابن أَبِی غَنِیَّۃ ، عَنِ الصَّلْتِ بْنِ بَہْرَامَ ، عَمَّنْ حَدَّثَہُ ، عَنْ حُذَیْفَۃَ بْنِ أَسِیدٍ ، قَالَ : رَأَیْتُ عَلِیًّا إِذَا زَالَتِ الشَّمْسُ صَلَّی أَرْبَعًا طِوَالاً۔","Da'if","Musannaf Ibn Abi Shaybah 6007","","","كتاب الجمعة"
"6008","(۶۰۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ بُدَیْلٍ ، قَالَ : حدَّثَنِی أَبْطَنُ النَّاسِ بِعَبْدِ اللہِ بْنِ مَسْعُودٍ : أَنَّہُ کَانَ یُصَلِّی فِی بَیْتِہِ إِذَا زَالَتِ الشَّمْسُ أَرْبَعَ رَکَعَاتٍ ، یُطِیلُ فِیہِنَّ ، فَإِذَا تَجَاوَبَ الْمُؤَذِّنُونَ خَرَجَ ، فَجَلَسَ فِی الْمَسْجِدِ حَتَّی تُقَامَ الصَّلاَۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 6008","","","كتاب الجمعة"
"6009","(۶۰۰۹) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنِ الأَعْمَشِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ رَجُلٍ ؛ أَنَّ عُمَرَ قَرَأَ فِی الأَرْبَعِ قَبْلَ الظُّہْرِ بِـ : (ق)۔","Da'if","Musannaf Ibn Abi Shaybah 6009","","","كتاب الجمعة"
"6010","(۶۰۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ؛ أَنَّ أَبَا أَیُّوبَ کَانَ یُصَلِّی ثَمَانَ رَکَعَاتٍ قَبْلَ الظُّہْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 6010","","","كتاب الجمعة"
"6011","(۶۰۱۱) حَدَّثَنَا عَبْدَۃُ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ کَانَ یُصَلِّی ثَمَانِ رَکَعَاتِ قَبْلَ الظُّہْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 6011","","","كتاب الجمعة"
"6012","(۶۰۱۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یُصَلِّی بَعْدَ الظُّہْرِ أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 6012","","","كتاب الجمعة"
