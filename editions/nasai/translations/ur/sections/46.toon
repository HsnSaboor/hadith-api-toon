hadiths[114]{hadithnumber,text}:
"4870","ابوہریرہ رضی اللہ عنہ روایت کرتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”کوئی شخص ایمان رکھ"
"4871","ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”جب زنا کرنے والا زنا کرت"
"4872","ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ جب کوئی زنا کرتا ہے تو زنا کے وقت وہ مومن نہیں رہتا، چوری کرتا ہے"
"4873","ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”اللہ تعالیٰ کی لعنت نازل"
"4874","نعمان بن بشیر رضی اللہ عنہما سے روایت ہے کہ ان کے پاس قبیلہ کلاع کے کچھ لوگ مقدمہ لائے کہ کچھ بنکرو"
"4875","بہز بن حکیم کے دادا معاویہ بن حیدہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے کچھ لوگ"
"4876","بہز بن حکیم کے دادا معاویہ بن حیدہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے ایک شخص"
"4877","ابوامیہ مخزومی رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم کے پاس ایک چور پکڑ کر لایا گیا"
"4878","صفوان بن امیہ رضی اللہ عنہ کہتے ہیں کہ ایک شخص نے ان کی چادر چرا لی، وہ اسے لے کر رسول اللہ صلی الل"
"4879","صفوان بن امیہ رضی اللہ عنہ کہتے ہیں کہ ایک شخص نے ایک چادر چرائی، وہ اسے لے کر نبی اکرم صلی اللہ عل"
"4880","عطا بن ابی رباح کہتے ہیں کہ ایک شخص نے ایک کپڑا چرایا، اسے رسول اللہ صلی اللہ علیہ وسلم کے پاس لایا"
"4881","صفوان بن امیہ رضی اللہ عنہ کہتے ہیں کہ انہوں نے بیت اللہ کا طواف کیا، پھر نماز پڑھی، پھر اپنی چادر"
"4882","عبداللہ بن عباس رضی اللہ عنہما کہتے ہیں کہ صفوان رضی اللہ عنہ مسجد میں سو رہے تھے، ان کی چادر ان کے"
"4883","صفوان بن امیہ رضی اللہ عنہ کہتے ہیں کہ میں مسجد میں اپنی ایک چادر پر سو رہا تھا، جس کی قیمت تیس درہ"
"4884","صفوان بن امیہ رضی اللہ عنہ کہتے ہیں کہ ایک چادر ان کے سر کے نیچے سے چوری ہو گئی اور وہ مسجد نبوی می"
"4885","عبداللہ بن عمرو رضی اللہ عنہما سے روایت ہے کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: ”حدود کو میرے"
"4886","عبداللہ بن عمرو بن عاص رضی اللہ عنہما سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”حدود"
"4887","عبداللہ بن عمر رضی اللہ عنہما کہتے ہیں کہ قبیلہ مخزوم کی ایک عورت لوگوں کا سامان مانگ لیتی تھی، پھر"
"4888","عبداللہ بن عمر رضی اللہ عنہما کہتے ہیں کہ قبیلہ مخزوم کی ایک عورت پڑوسی عورتوں ( کی گواہیوں ) کے"
"4889","عبداللہ بن عمر رضی اللہ عنہما کہتے ہیں کہ ایک عورت لوگوں کے زیورات مانگ لیتی پھر اسے رکھ لیتی، تو ر"
"4890","نافع کہتے ہیں کہ ایک عورت رسول اللہ صلی اللہ علیہ وسلم کے زمانے میں زیورات مانگ لیتی تھی، چنانچہ اس"
"4891","جابر رضی اللہ عنہ کہتے ہیں کہ بنی مخزوم کی ایک عورت نے چوری کی، چنانچہ اسے نبی اکرم صلی اللہ علیہ و"
"4892","سعید بن مسیب کہتے ہیں کہ بنی مخزوم کی ایک عورت نے کچھ لوگوں ( کی گواہیوں ) کے ذریعہ زیورات مانگے"
"4893","اس سند سے بھی سعید بن مسیب سے اسی طرح سے مروی ہے۔"
"4894","سفیان بن عیینہ بیان کرتے ہیں کہ ایک مخزومی عورت سامان مانگ لیتی پھر مکر جاتی۔ یہ بات رسول اللہ صلی"
"4895","ام المؤمنین عائشہ رضی اللہ عنہا کہتے ہیں کہ ایک عورت نے چوری کی چنانچہ وہ نبی اکرم صلی اللہ علیہ وس"
"4896","ام المؤمنین عائشہ رضی اللہ عنہا کہتی ہیں کہ نبی اکرم صلی اللہ علیہ وسلم کے پاس ایک چور لایا گیا ۱؎"
"4897","ام المؤمنین عائشہ رضی اللہ عنہا سے روایت ہے کہ ایک عورت نے رسول اللہ صلی اللہ علیہ وسلم کے زمانے می"
"4898","ام المؤمنین عائشہ رضی اللہ عنہا کہتی ہیں کہ ایک غیر معروف عورت نے کچھ معروف لوگوں ( کی گواہی ) کے"
"4899","ام المؤمنین عائشہ رضی اللہ عنہا کہتی ہیں کہ قریش کو اس مخزومی عورت کے معاملے نے فکر میں ڈال دیا جس"
"4900","ام المؤمنین عائشہ رضی اللہ عنہا کہتی ہیں کہ قریش یعنی بنی مخزوم کی ایک عورت نے چوری کی، اسے نبی اکر"
"4901","ام المؤمنین عائشہ رضی اللہ عنہا کہتی ہیں کہ قریش کو مخزومی عورت کے معاملے نے فکر میں ڈال دیا جس نے"
"4902","ام المؤمنین عائشہ رضی اللہ عنہا کہتی ہیں کہ ایک عورت نے رسول اللہ صلی اللہ علیہ وسلم کے عہد میں فتح"
"4903","عروہ بن زبیر کہتے ہیں کہ فتح مکہ کے وقت رسول اللہ صلی اللہ علیہ وسلم کے زمانے میں ایک عورت نے چوری"
"4904","ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”ایک حد کا نافذ ہونا اہل"
"4905","ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ زمین میں ایک حد کا نفاذ زمین والوں کے لیے چالیس دن کی بارش سے زیا"
"4906","عبداللہ بن عمر رضی اللہ عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے ایک ڈھال کی چوری میں ہاتھ"
"4907","عبداللہ بن عمر رضی اللہ عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے ایک ڈھال ( چرانے ) میں"
"4908","عبداللہ بن عمر رضی اللہ عنہما سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے ایک ڈھال ( چرانے ) پ"
