hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"31063","(۳۱۰۶۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا دَاوُد ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، عَنْ تَمِیمٍ الدَّارِیِّ بِمِثْلِ حَدِیثِ یَزِیدَ ، إلاَّ أَنَّہُ لَمْ یَذْکُرْ فِیہِ وَیُؤْخَذُ بِطَرَفَیْہِ فَیُقْذَفُ بِہِ فِی النَّارِ۔","Sahih","Musannaf Ibn Abi Shaybah 31063","","","كتاب الإيمان"
"31064","(۳۱۰۶۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حَدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، عَنْ زُبَیْدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: کَیْفَ أَصْبَحْت یَا حَارِثَ بْنَ مَالِکٍ ، قَالَ : أَصْبَحْت مُؤْمِنًا حَقًّا ، قَالَ : إنَّ لِکُلِّ قَوْلٍ حَقِیقَۃً فَمَا حَقِیقَۃُ ذَلِکَ ، قَالَ : أَصْبَحْت عَزَفَتْ نَفْسِی عَنِ الدُّنْیَا فَأَسْہَرْت لَیْلِی وَأَظْمَأْت نَہَارِی وَلکَأَنِّی أَنْظُرُ إِلَی عَرْشِ رَبِّی قَدْ أُبْرِزَ لِلْحِسَابِ ، وَلکَأَنِّی أَنْظُرُ إِلَی أَہْلِ الْجَنَّۃِ یَتَزَاوَرُونَ فِی الْجَنَّۃِ ، وَلکَأَنِّی أَسْمَعُ عُوَائَ أَہْلِ النَّارِ، قَالَ : فَقَالَ لَہُ : عَبْدٌ نَوَّرَ الإِیمَانِ فِی قَلْبِہِ ، إذْ عَرَفْت فَالْزَمْ۔ (عبدالرزاق ۲۰۱۱۴۔ بزار ۳۲)","","Musannaf Ibn Abi Shaybah 31064","","","كتاب الإيمان"
"31065","(۳۱۰۶۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُوسَی بْنِ مُسْلِمٍ ، قَالَ : حدَّثَنَا ابْنُ سَابِطٍ ، قَالَ : کَانَ عَبْدُ اللہِ بْنُ رَوَاحَۃَ یَأْخُذُ بِیَدِ النَّفَرِ مِنْ أَصْحَابِہِ فَیَقُولُ : تَعَالَوْا نُؤْمِنُ سَاعَۃً تَعَالَوْا فَلْنَذْکُرُ اللَّہَ وَنَزْدَدْ إیمَانًا ، تَعَالَوْا نَذْکُرُہُ بِطَاعَتِہِ لَعَلَّہُ یَذْکُرُنَا بِمَغْفِرَتِہِ۔ (احمد ۲۶۵)","","Musannaf Ibn Abi Shaybah 31065","","","كتاب الإيمان"
"31066","(۳۱۰۶۶) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا الْعَوَّامُ بْنُ حَوْشَبٍ ، عَنْ أَبِی صَادِقٍ ، عَنْ عَلِیٍّ ، قَالَ : إنَّ الإسْلامَ ثَلاثُ أَثَافِیِ : الإِیمَانُ وَالصَّلاۃُ وَالْجَمَاعَۃُ ، فَلا تُقْبَلُ صَلاۃٌ إلاَّ بِإِیمَانٍ ، وَمَنْ آمَنَ صَلَّی وَمَنْ صَلَّی جَامَعَ ، وَمَنْ فَارَقَ الْجَمَاعَۃَ قَیْدَ شِبْرٍ فَقَدْ خَلَعَ رِبْقَۃَ الإسْلامِ مِنْ عُنُقِہِ۔","","Musannaf Ibn Abi Shaybah 31066","","","كتاب الإيمان"
"31067","(۳۱۰۶۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ مُطَرِّفٍ ، عَنْ حَسَّانَ بْنِ عَطِیَّۃَ ، عَنْ أَبِی أُمَامَۃَ الباہلی، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْحَیَائُ وَالْعِیُّ شُعْبَتَانِ مِنَ الإِیمَانِ۔ (احمد ۲۶۹۔ حاکم ۵۲)","","Musannaf Ibn Abi Shaybah 31067","","","كتاب الإيمان"
"31068","(۳۱۰۶۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ مُحَارِبِ بْنِ دِثَارٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، قَالَ: وَرَدْنَا الْمَدِینَۃِ، فَأَتَیْنَا عَبْدَ اللہِ بْنَ عُمَرَ ، فَقُلْنَا : یَا أَبَا عَبْدِ الرَّحْمَنِ ، إنَّا نُمْعِنُ فِی الأَرْضِ فَنَلْقَی قَوْمًا یَزْعُمُونَ أَنْ لاَ قَدَرَ ، فَقَالَ : مِنَ الْمُسْلِمِینَ مِمَّنْ یُصَلِّی إِلَی الْقِبْلَۃِ ، قُلْنَا نَعَمْ مِمَّنْ یُصَلِّی إِلَی الْقِبْلَۃِ ، قَالَ : فَغَضِبَ حتَّی وَدِدْت أَنِّی لَمْ أَکُنْ سَأَلْتُہُ ، ثُمَّ قَالَ : إذَا لَقِیت أُولَئِکَ فَأَخْبِرْہُمْ ، أَنَّ عَبْدَ اللہِ بْنَ عُمَرَ مِنْہُمْ بَرِیئٌ وَأَنَّہُمْ مِنْہُ بُرَآئُ ، ثُمَّ قَالَ : إِنْ شِئْتَ حَدَّثْتُک ، عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فقلت : أَجَلْ فَقَالَ : کُنَّا عِنْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ رَجُلٌ جَیِّدُ الثِّیَابِ طَیِّبُ الرِّیحِ حَسَنُ الْوَجْہِ ، فَقَالَ : یَا رَسُولَ اللہِ ، مَا الإسْلامُ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تُقِیمُ الصَّلاۃَ وَتُؤْتِی الزَّکَاۃَ وَتَصُومُ رَمَضَانَ وَتَحُجُّ الْبَیْتَ وَتَغْتَسِلُ مِنَ الْجَنَابَۃِ ، قَالَ : صَدَقْت ، فَمَا الإِیمَانُ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تُؤْمِنُ بِاللہِ وَالْیَوْمِ الآخِرِ وَالْمَلائِکَۃِ وَالْکِتَابِ وَالنَّبِیُّینَ وَبِالْقَدَرِ کُلِّہِ خَیْرِہِ وَشَرِّہِ وَحُلْوِہِ وَمُرِّہِ ، قَالَ : صَدَقْت ، ثُمَّ انْصَرَفَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عَلَیَّ بِالرَّجُلِ ، قَالَ : فَقُمْنَا بِأَجْمَعِنَا فَلَمْ نَقْدِرْ عَلَیْہِ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ہَذَا جِبْرِیلُ أَتَاکُمْ یُعَلِّمُکُمْ أَمْرَ دِینَکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 31068","","","كتاب الإيمان"
"31069","(۳۱۰۶۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا أَبَانُ الْعَطَّارُ ، قَالَ : حَدَّثَنَا یَحْیَی بْنُ أَبِی کَثِیرٍ ، عَنْ زَیْدٍ ، عَنْ أَبِی سَلاَّمٍ ، عَنْ أَبِی مَالِکٍ الأَشْعَرِیِّ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ : الطُّہْرُ شَطْرُ الإِیمَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 31069","","","كتاب الإيمان"
"31070","(۳۱۰۷۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی لَیْلَی الْکِنْدِیِّ ، عَنْ حُجْرِ بْنِ عَدِیٍّ ، قَالَ : حدَّثَنَا عَلِیٌّ ، أَنَّ الطُّہُورَ شَطْرُ الإِیمَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 31070","","","كتاب الإيمان"
"31071","(۳۱۰۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَوْزَاعِیُّ ، عَنْ حَسَّانَ بْنِ عَطِیَّۃَ ، قَالَ : الْوُضُوئُ شَطْرُ الإِیمَانِ۔","","Musannaf Ibn Abi Shaybah 31071","","","كتاب الإيمان"
"31072","(۳۱۰۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی لَیْلَی الْکِنْدِیِّ ، عَنْ غُلامٍ لِحُجْر ، أَنَّ حُجْرًا رَأَی ابْنًا لَہُ خَرَجَ مِنَ الْغَائِطِ ، فَقَالَ : یَا غُلامُ نَاوِلْنِی الصَّحِیفَۃَ مِنَ الْکُوَّۃِ فَسَمِعْت عَلِیًّا یَقُولُ : الطُّہُورُ نِصْفُ الإِیمَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 31072","","","كتاب الإيمان"
"31073","(۳۱۰۷۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، قَالَ : حَدَّثَنِی الْحَوَارِیُّ ، أَنَّ عَبْدَ اللہِ بْنَ عمر ، قَالَ : إنَّ عُرَی الدِّینِ وَقِوَامَہُ الصَّلاۃُ وَالزَّکَاۃُ لاَ یُفَرَّقُ بَیْنَہُمَا ، وَحَجُّ الْبَیْتِ وَصَوْمُ رَمَضَانَ ، وَإِنَّ مِنْ إصْلاحِ الأَعْمَالِ الصَّدَقَۃَ وَالْجِہَادَ ، قُمْ فَانْطَلِقْ۔","Da'if","Musannaf Ibn Abi Shaybah 31073","","","كتاب الإيمان"
"31074","(۳۱۰۷۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَکْمَلُ الْمُؤْمِنِینَ إیمَانًا أَحْسَنُہُمْ خُلُقًا۔","Hasan","Musannaf Ibn Abi Shaybah 31074","","","كتاب الإيمان"
"31075","(۳۱۰۷۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ أَبِی إسْمَاعِیلَ ، عَنْ مَعْقِلٍ الْخَثْعَمِیِّ ، قَالَ : أَتَی عَلِیًّا رَجُلٌ وَہُوَ فِی الرَّحْبَۃِ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، مَا تَرَی فِی امْرَأَۃٍ لاَ تُصَلِّی ، قَالَ : مَنْ لَمْ یُصَلِّ فَہُوَ کَافِرٌ۔","Da'if","Musannaf Ibn Abi Shaybah 31075","","","كتاب الإيمان"
"31076","(۳۱۰۷۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ عَبْدِ اللہِ بْنِ ضَمْرَۃَ ، عَنْ کَعْبٍ ، قَالَ : مَنْ أَقَامَ الصَّلاۃَ وَآتَی الزَّکَاۃَ فَقَدْ تَوسَّطَ الإِیمَانَ۔","","Musannaf Ibn Abi Shaybah 31076","","","كتاب الإيمان"
"31077","(۳۱۰۷۷) حَدَّثَنَا مُحَمَّد بْنُ عُبَیْد ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ عَبْدِ اللہِ بْنِ ضَمْرَۃَ ، عَنْ کَعْبٍ ، قَالَ : مَنْ أَقَامَ الصَّلاۃَ وَآتَی الزَّکَاۃَ وَسَمِعَ وَأَطَاعَ فَقَدْ تَوَسَّطَ الإِیمَانَ ، وَمَنْ أَحَبَّ لِلَّہِ وَأَبْغَضَ لِلَّہِ وَأَعْطَی لِلَّہِ وَمَنَعَ لِلَّہِ فَقَدِ اسْتَکْمَلَ الإِیمَانَ۔","","Musannaf Ibn Abi Shaybah 31077","","","كتاب الإيمان"
"31078","(۳۱۰۷۸) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُبَیْدٍ الْکَلاعِیِّ ، قَالَ : أَخَذَ بِیَدِی مَکْحُولٌ ، فَقَالَ : یَا أَبَا وَہْبٍ ، لِیَعْظُمْ شَأْنُ الإِیمَانِ فِی نَفْسِکَ ، مَنْ تَرَکَ صَلاۃً مَکْتُوبَۃً مُتَعَمِّدًا فَقَدْ بَرِئَتْ مِنْہُ ذِمَّۃُ اللہِ ، وَمَنْ بَرِئَتْ مِنْہُ ذِمَّۃُ اللہِ فَقَدْ کَفَرَ۔","","Musannaf Ibn Abi Shaybah 31078","","","كتاب الإيمان"
"31079","(۳۱۰۷۹) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ عَمْرِو بْنِ قَیْسٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : قَالَ عَلِیٌّ : الصَّبْرُ مِنَ الإِیمَانِ بِمَنْزِلَۃِ الرَّأْسِ مِنَ الْجَسَدِ ، فَإِذَا ذَہَبَ الصَّبْرُ ذَہَبَ الإِیمَانُ۔","","Musannaf Ibn Abi Shaybah 31079","","","كتاب الإيمان"
"31080","(۳۱۰۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ صِلَۃَ ، عَنْ عَمَّارٍ ، قَالَ : ثَلاثٌ مَنْ جَمَعَہُنَّ جَمَعَ الإِیمَانَ : الإِنْصَافُ مِنْ نَفْسِکَ ، وَالإِنْفَاقُ مِنَ الإِقْتَارِ ، وَبَذْلُ السَّلامِ لِلْعَالِمِ۔","Sahih","Musannaf Ibn Abi Shaybah 31080","","","كتاب الإيمان"
"31081","(۳۱۰۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ صِلَۃَ ، عَنْ عَمَّارٍ : {إنَّہُمْ لاَ أَیْمَانَ لَہُمْ} قَالَ : لاَ عَہْدَ لَہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 31081","","","كتاب الإيمان"
"31082","(۳۱۰۸۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُقَالَ : لاَ یَدْخُلُ النَّارَ إنْسَانٌ فِی قَلْبِہِ مِثْقَالُ حَبَّۃِ خَرْدَلٍ مِنْ إیمَانٍ۔ (مسلم ۹۳)","","Musannaf Ibn Abi Shaybah 31082","","","كتاب الإيمان"
"31083","(۳۱۰۸۳) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنِ الصَّعْقِ بْنِ حَزْنٍ ، قَالَ : حدَّثَنِی عَقِیلُ الْجَعْدِی ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَوْثَقُ عُرَی الإِیمَانِ الْحُبُّ فِی اللہِ وَالْبُغْضُ فِی اللہِ۔ (طیالسی ۳۷۸۔ حاکم ۴۸۰)","Da'if","Musannaf Ibn Abi Shaybah 31083","","","كتاب الإيمان"
"31084","(۳۱۰۸۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، قَالَ : حدَّثَنِی عِیسَی بْنُ عَاصِمٍ ، قَالَ : حَدَّثَنا عَدِیُّ بْنُ عَدِیٍّ ، قَالَ : کَتَبَ إلَیَّ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ أَمَّا بَعْدُ فَإِنَّ الإِیمَان فَرَائِضَ وَشَرَائِعَ وَحُدُودَ وَسُنَن ، فَمَنِ اسْتَکْمَلَہَا اسْتَکْمَلَ الإِیمَانَ ، وَمَنْ لَمْ یَسْتَکْمِلْہَا لَمْ یَسْتَکْمِلِ الإِیمَانَ ، فَإِنْ أَعِشْ فَسَأُبَیِّنُہَا لَکُمْ حَتَّی تَعْمَلُوا بِہَا ، وَإِنْ أَمُتْ قَبْلَ ذَلِکَ فَمَا أَنَا عَلَی صُحْبَتِکُمْ بِحَرِیصٍ۔","","Musannaf Ibn Abi Shaybah 31084","","","كتاب الإيمان"
"31085","(۳۱۰۸۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ سَعْدٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، قَالَ : لاَ بُدَّ لأَہْلِ ہَذَا الدِّینِ مِنْ أَرْبَعٍ : دُخُولٌ فِی دَعْوَۃِ الإسْلامِ ، وَلا بُدَّ مِنَ الإِیمَانِ وَتَصْدِیقٌ بِاللہِ وَبِالْمُرْسَلِینَ أَوَّلِہِمْ وَآخِرِہِمْ وَبِالْجَنَّۃِ وَالنَّارِ وَالْبَعْثِ بَعْدَ الْمَوْتِ ، وَلا بُدَّ من أَنْ تَعْمَلَ عَمَلاً تُصَدِّقُ بِہِ ، وَلا بُدَّ مِنْ أَنْ تَعْلَمَ عِلْمًا یُحْسِنُ بِہِ عَمَلَک ، ثُمَّ قَرَأَ : {وَإِنِّی لَغَفَّارٌ لِمَنْ تَابَ وَآمَنَ وَعَمِلَ صَالِحًا ثُمَّ اہْتَدَی}۔","","Musannaf Ibn Abi Shaybah 31085","","","كتاب الإيمان"
"31086","(۳۱۰۸۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیْرِیِّ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ ، قَالَ : مَا کَانُوا یَقُولُونَ لِعَمَلٍ تَرَکَہُ رَجُلٌ کُفْرٌ غَیْرِ الصَّلاۃِ ، قَالَ : کَانُوا یَقُولُونَ : تَرْکُہَا کُفْرٌ۔","Sahih","Musannaf Ibn Abi Shaybah 31086","","","كتاب الإيمان"
"31087","(۳۱۰۸۷) حَدَّثَنَا أَبُو بَکْرٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : قیلَ لَہُ : إنَّ أُنَاسًا یَزْعُمُونَ أَنَّ الْمُؤْمِنِینَ یَدْخُلُونَ النَّارَ ، قَالَ : لَعَمْرُک وَاللہِ إنَّ حَشْوَہَا غَیْرُ الْمُؤْمِنِینَ۔","","Musannaf Ibn Abi Shaybah 31087","","","كتاب الإيمان"
"31088","(۳۱۰۸۸) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، قَالَ : سَمِعْتُ شَقِیقًا یَقُولُ وَسَأَلَہُ رَجُلٌ : سَمِعْتَ ابْنَ مَسْعُودٍ یَقُولُ : أَنَّہُ مَنْ شَہِدَ أَنَّہُ مُؤْمِنٌ فَلْیَشْہَدْ ، أَنَّہُ فِی الْجَنَّۃِ ، قَالَ : نَعَمْ۔","Sahih","Musannaf Ibn Abi Shaybah 31088","","","كتاب الإيمان"
"31089","(۳۱۰۸۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ وَکِیعِ بْنِ عُدُسٍ الْعُقَیْلِیِّ ، عَنْ عَمِّہِ أَبِی رَزِینٍ : أَنَّہُ سَمِعَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : الرُّؤْیَا عَلَی رِجْلِ طَائِرٍ مَا لَمْ تُعْبَرْ فَإِذَا عُبِرَتْ وَقَعَتْ۔n قَالَ : وَالرُّؤْیَا جُزْئٌ مِنْ سِتَّۃٍ وَأَرْبَعِینَ جُزْئًا مِنَ النُّبُوَّۃِ۔n قَالَ : وَأَحْسَبُہُ قَالَ : لاَ تَقُصَّہَا إلاَّ عَلَی وَادٍّ ، أَوْ ذِی رَأْیٍ۔ (احمد ۱۲۔ حاکم ۳۹۰)","Da'if","Musannaf Ibn Abi Shaybah 31089","","","كتاب الرؤيا"
"31090","(۳۱۰۹۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُ قَالَ : رُؤْیَا الْمُسْلِمِ جُزْئٌ مِنْ سِتَّۃٍ وَأَرْبَعِینَ جُزْئًا مِنَ النُّبُوَّۃِ۔n(بخاری ۶۹۸۸۔ مسلم ۱۷۷۴)","Sahih","Musannaf Ibn Abi Shaybah 31090","","","كتاب الرؤيا"
"31091","(۳۱۰۹۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : رُؤْیَا الْمُسْلِمِ جُزْئٌ مِنْ سِتَّۃٍ وَأَرْبَعِینَ جُزْئًا مِنَ النُّبُوَّۃِ۔ (مسلم ۱۷۷۴۔ احمد ۴۹۵)","Sahih","Musannaf Ibn Abi Shaybah 31091","","","كتاب الرؤيا"
"31092","(۳۱۰۹۲) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی صَالِحٍ ، عَنْ عَطَائِ بْنِ یَسَارٍ، عَنْ رَجُلٍ کَانَ یُفْتِی بِمِصْرٍ، قَالَ : سَأَلْتُ أَبَا الدَّرْدَائِ عَنْ ہَذِہِ الآیَۃِ : {لَہُمُ الْبُشْرَی فِی الْحَیَاۃِ الدُّنْیَا} قَالَ مَا سَأَلَنِی عنہا أَحَدٌ مُنْذُ سَأَلْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عنہا ، فَقَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا سَأَلَنِی أَحَدٌ قَبْلَک : ہِیَ الرُّؤْیَا الصَّالِحَۃُ یَرَاہَا الْمُسْلِمُ ، أَوْ تُرَی لَہُ ، وَفِی الآخِرَۃِ الْجَنَّۃُ۔ (ترمذی ۳۱۰۶۔ احمد ۴۴۷)","Da'if","Musannaf Ibn Abi Shaybah 31092","","","كتاب الرؤيا"
"31093","(۳۱۰۹۳) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ، قَالَ: حدَّثَنَا شُعْبَۃُ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ، عَنْ عُبَادَۃَ بْنِ الصَّامِتِ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ: رُؤْیَا الْمُسْلِمِ جُزْئٌ مِنْ سِتَّۃٍ وَأَرْبَعِینَ جُزْئًا مِنَ النُّبُوَّۃِ۔ (بخاری ۶۹۸۷۔ مسلم ۱۷۷۴)","Sahih","Musannaf Ibn Abi Shaybah 31093","","","كتاب الرؤيا"
"31094","(۳۱۰۹۴) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ : سَأَلْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْبُشْرَی فِی الْحَیَاۃِ الدُّنْیَا ؟ قَالَ : الرُّؤْیَا الْحَسَنَۃُ یَرَاہَا الْمُسْلِمُ ، أَوْ تُرَی لَہُ۔ (ترمذی ۳۱۰۶)","","Musannaf Ibn Abi Shaybah 31094","","","كتاب الرؤيا"
"31095","(۳۱۰۹۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ وَأَبُو أُسَامَۃَ ، قَالاَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : الرُّؤْیَا الصَّالِحَۃُ جُزْئٌ مِنْ سَبْعِینَ جُزْئًا مِنَ النُّبُوَّۃِ۔n(مسلم ۱۷۷۵۔ احمد ۱۸)","Sahih","Musannaf Ibn Abi Shaybah 31095","","","كتاب الرؤيا"
"31096","(۳۱۰۹۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ سُلَیْمَانَ بْنِ سُحَیْمٍ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ اللہِ بْنِ مَعْبَدٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَشَفَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ السِّتْرَ وَالنَّاسُ صُفُوفٌ خَلْفَ أَبِی بَکْرٍ ، فَقَالَ : أَیُّہَا النَّاسُ ، إِنَّہُ لَمْ یَبْقَ مِنْ مُبَشِّرَاتِ النُّبُوَّۃِ إلاَّ الرُّؤْیَا الصَّالِحَۃَ یَرَاہَا الْمُسْلِمُ ، أَوْ تُرَی لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31096","","","كتاب الرؤيا"
"31097","(۳۱۰۹۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ الْمُخْتَارِ بْنِ فُلْفُلٍ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ النُّبُوَّۃَ قَدِ انْقَطَعَتْ وَالرِّسَالَۃُ ، فَحَرِجَ النَّاسُ ، فَقَالَ : قَدْ بَقِیَتْ مُبَشِّرَاتٌ ، وَہِیَ جُزْئٌ مِنَ النُّبُوَّۃِ۔n(ترمذی ۲۲۷۲۔ احمد ۲۶۷)","Sahih","Musannaf Ibn Abi Shaybah 31097","","","كتاب الرؤيا"
"31098","(۳۱۰۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی عِمْرَانَ الْجَوْنِیِّ ، عَنْ عَبْدِ اللہِ بْنِ الصَّامِتِ ، عَنْ أَبِی ذَرٍّ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، الرَّجُلُ یَعْمَلُ الْعَمَلَ یُحِبُّہُ النَّاسُ عَلَیْہِ ؟ قَالَ : تِلْکَ بُشْرَی الْمُؤْمِنِ۔n(مسلم ۱۶۶۔ ابن ماجہ ۴۲۲۵)","Sahih","Musannaf Ibn Abi Shaybah 31098","","","كتاب الرؤيا"
"31099","(۳۱۰۹۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، قَالَ : حَدَّثَنِی أَبُو حَصِینٍ ، عَنْ زَاہِرٍ الأَسْلَمِیِّ : عَنْ أَبِیہِ : أَنَّ عَبْدِ اللہِ کَانَ یَقُولُ : الرُّؤْیَا الصَّالِحَۃُ الصَّادِقَۃُ جُزْئٌ مِنْ سَبْعِینَ جُزْئًا مِنَ النُّبُوَّۃِ۔ (طبرانی ۹۰۵۷)","","Musannaf Ibn Abi Shaybah 31099","","","كتاب الرؤيا"
"31100","(۳۱۱۰۰) حَدَّثَنَا الْقَسْمَلِیُّ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : رُؤْیَا الْمُؤْمِنِ جُزْئٌ مِنْ سِتَّۃٍ وَأَرْبَعِینَ جُزْئًا مِنَ النُّبُوَّۃِ۔n(ابویعلی ۳۴۱۷)","Sahih","Musannaf Ibn Abi Shaybah 31100","","","كتاب الرؤيا"
"31101","(۳۱۱۰۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ، عَنْ أَبِی حَصِینٍ، عَنْ أَبِی صَالِحٍ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: الرُّؤْیَا مِنَ الْمُبَشِّرَاتِ، وَہِیَ جُزْئٌ مِنْ سَبْعِینَ جُزْئًا مِنَ النُّبُوَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 31101","","","كتاب الرؤيا"
"31102","(۳۱۱۰۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ : {لَہُمُ الْبُشْرَی فِی الْحَیَاۃِ الدُّنْیَا} قَالَ : ہِیَ الرُّؤْیَا الصَّالِحَۃُ یَرَاہَا الْعَبْدُ الصَّالِحُ۔ (مالک ۹۵۸)","","Musannaf Ibn Abi Shaybah 31102","","","كتاب الرؤيا"
"31103","(۳۱۱۰۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ : {لَہُمُ الْبُشْرَی فِی الْحَیَاۃِ الدُّنْیَا} قَالَ : ہِیَ الرُّؤْیَا الصَّالِحَۃُ یَرَاہَا الْمُسْلِمُ ، أَوْ تُرَی لَہُ۔","","Musannaf Ibn Abi Shaybah 31103","","","كتاب الرؤيا"
"31104","(۳۱۱۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ الْقَنَّادِ ، عَنْ جَعْفَرٍ ، عَنْ سَ[corrupt]ِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ : {لَہُمُ الْبُشْرَی فِی الْحَیَاۃِ الدُّنْیَا} قَالَ : الرُّؤْیَا الْحَسَنَۃُ یَرَاہَا الرَّجُلُ الْمُسْلِمُ لِنَفْسِہِ ، أَوْ لأَخِیہِ۔","Da'if","Musannaf Ibn Abi Shaybah 31104","","","كتاب الرؤيا"
"31105","(۳۱۱۰۵) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ شَیْبان ، عَنْ فِرَاسٍ ، عَنْ عَطِیَّۃَ ، عَنْ أَبِی سَعِیدٍ : أَنَّ نَبِیَّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : رُؤْیَا الرَّجُلِ الْمُسْلِمِ الصَّالِحِ جُزْئٌ مِنْ سَبْعِینَ جُزْئًا مِنَ النُّبُوَّۃِ۔n(بخاری ۶۹۸۹۔ ابویعلی ۱۳۵۷)","Da'if","Musannaf Ibn Abi Shaybah 31105","","","كتاب الرؤيا"
"31106","(۳۱۱۰۶) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ رَآنِی فِی الْمَنَامِ فَقَدْ رَآنِی۔ (احمد ۴۷۲)","Sahih","Musannaf Ibn Abi Shaybah 31106","","","كتاب الرؤيا"
"31107","(۳۱۱۰۷) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ۔ وَعَنْ سُفْیَان ، عَنْ أَبِی حَصِینٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ رَآنِی فِی الْمَنَامِ فَقَدْ رَآنِی ، إنَّ الشَّیْطَانَ لاَ یَتَمَثَّلُ فِی صُورَتِی۔ (بخاری ۶۹۹۳۔ مسلم ۱۷۷۵)","Sahih","Musannaf Ibn Abi Shaybah 31107","","","كتاب الرؤيا"
"31108","(۳۱۱۰۸) حَدَّثَنَا ہَوْذَۃُ بْنُ خَلِیفَۃَ ، قَالَ : حدَّثَنِی عَوْفٌ ، عَنْ یَزِیدَ الْفَارِسِیِّ ، قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی النَّوْمِ زَمَنَ ابْنِ عَبَّاسٍ عَلَی الْبَصْرَۃِ ، قَالَ : قُلْتُ لاِبْنِ عَبَّاسٍ : إنِّی رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی النَّوْمِ ، فَقَالَ ابْنُ عَبَّاسٍ : فَإِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ : إنَّ الشَّیْطَانَ لاَ یَسْتَطِیعُ أَنْ یَتَشَبَّہَ بِی ، فَمَنْ رَآنِی فِی النَّوْمِ فَقَدْ رَآنِی۔ (ابن ماجہ ۳۹۰۵۔ احمد ۲۷۹)","Hasan","Musannaf Ibn Abi Shaybah 31108","","","كتاب الرؤيا"
"31109","(۳۱۱۰۹) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللہِ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : مَنْ رَآنِی فِی النَّوْمِ فَقَدْ رَآنِی ، إِنَّ الشَّیْطَانَ لاَ یَتَمَثَّلُ فِی صُورَتِی۔n(مسلم ۱۷۷۶۔ احمد ۳)","Sahih","Musannaf Ibn Abi Shaybah 31109","","","كتاب الرؤيا"
"31110","(۳۱۱۱۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ مُخْتَارٍ ، قَالَ : حَدَّثَنَا ثَابِتٌ ، قَالَ : حَدَّثَنَا أَنَسٌ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ رَآنِی فِی الْمَنَامِ فَقَدْ رَآنِی ، إنَّ الشَّیْطَانَ لاَ یَتَمَثَّلُ بِی۔n(بخاری ۶۹۹۴۔ ابویعلی ۳۲۷۱)","Sahih","Musannaf Ibn Abi Shaybah 31110","","","كتاب الرؤيا"
"31111","(۳۱۱۱۱) حَدَّثَنَا بَکْرُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ : أَخْبَرَنَا عِیسَی ، عَنْ مُحَمَّدِ بْنِ أَبِی لَیْلَی ، عَنْ عطِیَّۃَ الْعَوْفِیِّ ، عَنْ أَبِی سَعِیدٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ رَآنِی فِی الْمَنَامِ فَقَدْ رَآنِی ، إنَّ الشَّیْطَانَ لاَ یَتَمَثَّلُ بِی۔ (بخاری ۶۹۹۷۔ ابن ماجہ ۳۹۰۳)","Da'if","Musannaf Ibn Abi Shaybah 31111","","","كتاب الرؤيا"
"31112","(۳۱۱۱۲) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ : قَالَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنِّی رَأَیْت کَأَنَّ عُنُقِی ضُرِبَتْ ! قَالَ : لِمَ یُخْبِرُ أَحَدُکُمْ بِلَعِبِ الشَّیْطَانِ بِہِ؟!۔ (مسلم ۱۷۷۶۔ احمد ۳۸۳)","Sahih","Musannaf Ibn Abi Shaybah 31112","","","كتاب الرؤيا"
"31113","(۳۱۱۱۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : جَائَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، رَأَیْت فِی الْمَنَامِ کَأَنَّ رَأْسِی قُطِعَ ! قَالَ : فَضَحِکَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَقَالَ : إذَا لَعِبَ الشَّیْطَانُ بِأَحَدِکُمْ فِی مَنَامِہِ فَلاَ یُحَدِّثْ بِہِ النَّاسَ۔ (مسلم ۱۷۷۷۔ احمد ۳۱۵)","Hasan","Musannaf Ibn Abi Shaybah 31113","","","كتاب الرؤيا"
"31114","(۳۱۱۱۴) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ عُمَرَ بْنِ سَعِیدِ بْنِ أَبِی الْحُسَینِ ، قَالَ : حدَّثَنِی عَطَائُ بْنُ أَبِی رَبَاحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : جَائَ رَجُلٌ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنِّی رَأَیْت فِی الْمَنَامِ کَأَنَّ رَأْسِی ضُرِبَتْ ، فَرَأَیْتہ بِیَدِی ہَذِہِ ! قَالَ : فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَعْمِدُ الشَّیْطَانُ إلَی أَحَدِکُمْ فَیَتَہَوَّلُ لَہُ ، ثُمَّ یَغْدُو فَیُخْبِرُ النَّاسَ!۔ (ابن ماجہ ۳۹۱۱۔ احمد ۳۶۴)","Hasan","Musannaf Ibn Abi Shaybah 31114","","","كتاب الرؤيا"
"31115","(۳۱۱۱۵) حَدَّثَنَا مُعَاوِیَۃ بْن ہِشَامٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ حَارِثَۃَ بْنِ مُضَرِّبٍ : أَنَّ رَجُلاً رَأَی رُؤْیَا : مَنْ صَلَّی اللَّیْلَۃَ فِی الْمَسْجِدِ دَخَلَ الْجَنَّۃَ ! ، فَخَرَجَ عَبْدُ اللہِ بْنُ مَسْعُودٍ وَہُوَ یَقُولُ : اخْرُجُوا لاَ تَغْتَرُّوا فَإِنَّمَا ہِیَ نَفْخَۃُ شَیْطَانٍ!۔","Sahih","Musannaf Ibn Abi Shaybah 31115","","","كتاب الرؤيا"
"31116","(۳۱۱۱۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : رَأَیْت فِی یَدَیَّ سِوَارَین مِنْ ذَہَبٍ فَنَفَخْتَہُمَا فَأَوَّلْتہمَا ہَذَیْنِ الْکَذَّابَیْنِ : مُسَیْلِمَۃَ وَالْعَنْسِیَّ۔ (بخاری ۳۶۲۱۔ مسلم ۱۷۸۱)","Hasan","Musannaf Ibn Abi Shaybah 31116","","","كتاب الرؤيا"
"31117","(۳۱۱۱۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : رَأَیْت کَأَنَّ فِی یَدَیَّ سِوَارَیْنِ مِنْ ذَہَبٍ فَکَرِہْتہمَا فَنَفَخْتہمَا فَذَہَبَا : کِسْرَی وَقَیْصَرَ۔","Hasan","Musannaf Ibn Abi Shaybah 31117","","","كتاب الرؤيا"
"31118","(۳۱۱۱۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، قَالَ : أَتَی رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، رَأَیْت رَجُلاً یَخْرُجُ مِنَ الأَرْضِ وَعَلَی رَأْسِہِ رَجُلٌ فِی یَدِہِ مِرْزَبَّۃٌ مِنْ حَدِیدٍ ، کُلَّمَا أَخْرَجَ رَأْسَہُ ضَرَبَ رَأْسَہُ فَیَدْخُلُ فِی الأَرْضِ ، ثُمَّ یَخْرُجُ مِنْ مَکَان آخَرَ ، فَیَأْتِیہ فَیَضْرِبُ رَأْسَہُ فَقَالَ : ذَاکَ أَبُو جَہْلِ بْنُ ہِشَامٍ ، لاَ یَزَالُ یُصْنَعُ بِہِ ذَلِکَ إلَی یَوْمِ الْقِیَامَۃِ۔","","Musannaf Ibn Abi Shaybah 31118","","","كتاب الرؤيا"
"31119","(۳۱۱۱۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لأَبِی بَکْرٍ : إنِّی رَأَیْتُنِی یَتْبَعَنِی غَنَمٌ سُودٌ یَتْبَعُہَا غَنَمٌ عُفْرٌ ، فَقَالَ أَبُو بَکْرٍ : یَا رَسُولَ اللہِ ، ہَذِہِ الْعَرَبُ تَتْبَعُک تَتْبَعُہَا الْعَجَمُ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَذَلِکَ عَبَرَہَا الْمَلَکُ۔n(حاکم ۳۹۵۔ احمد ۴۵۵)","","Musannaf Ibn Abi Shaybah 31119","","","كتاب الرؤيا"
"31120","(۳۱۱۲۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنِ الْحُرِّ بْنِ الْصَیَّاح ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَذَلِکَ عَبَرَہَا الْمَلَکُ بِالسَّحَرِ۔","","Musannaf Ibn Abi Shaybah 31120","","","كتاب الرؤيا"
"31121","(۳۱۱۲۱) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا سُفْیَانُ بْنُ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : جَائَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنِّی رَأَیْت ظُلَّۃً تَنْطُفُ سَمْنًا وَعَسَلا ، وَکَأَنََّ النَّاسُ یَأْخُذُونَ مِنْہَا فَبَیْنَ مُسْتَکْثِرٍ وَبَیْنَ مُسْتَقِلٍّ ، وَبَیْنَ ذَلِکَ ، وَکَأَنَّ سَبَبًا دُلِّیَ مِنَ السَّمَائِ فَجِئْتَ فَأَخَذْتَ بِہِ فَعَلَوْتَ ، فَأَعْلاَک اللَّہُ ، ثُمَّ جَائَ رَجُلٌ مِنْ بَعْدِکَ فَأَخَذَ بِہِ فَعَلاَ ، فَأَعْلاَہُ اللَّہُ ، ثُمَّ جَائَ رَجُلٌ مِنْ بَعْدِکُمَا فَأَخَذَ بِہِ فَعَلاَ ، فَأَعْلاَہُ اللَّہُ ، ثُمَّ جَائَ رَجُلٌ مِنْ بَعْدِکُمْ فَأَخَذَ بِہِ ، ثُمَّ قَطَعَ بِہِ ثُمَّ وُصِلَ لَہُ فَعَلاَ ، فَأَعْلاَہُ اللَّہُ۔n فَقَالَ أَبُو بَکْرٍ : یَا رَسُولَ اللہِ ائْذَنْ لِی فَأعْبُرُہَا ، فَأَذِنَ لَہُ ، فَقَالَ : أَمَّا الظُّلَّۃُ فَالإِسْلاَمُ ، وَأَمَّا السَّمْنُ وَالْعَسَلُ فَالْقُرْآنُ ، وَأَمَّا السَّبَبُ فَمَا أَنْتَ عَلَیْہِ ، تَعْلُو فَیُعْلِیک اللَّہُ ، ثُمَّ یَکُونُ رَجُلٌ مِنْ بَعْدِکَ عَلَی مِنْہَاجِکَ فَیَعْلُو فَیُعْلِیہ اللَّہُ ، ثُمَّ یَکُونُ رَجُلٌ مِنْ بَعْدِکُمَا فَیَأْخُذُ بِأَخْذِکُمَا فَیَعْلُو فَیُعْلِیہ اللَّہُ ، ثُمَّ یَکُونُ رَجُلٌ مِنْ بَعْدِکُمْ عَلَی مِنْہَاجِکُمْ ثُمَّ یُقْطَعُ بِہِ ، ثُمَّ یُوصَلُ لَہُ فَیَعْلُو فَیُعْلِیہ اللَّہُ ، قَالَ : أَصَبْتُ یَا رَسُولَ اللہِ ؟ قَالَ : أَصَبْتَ وَأَخْطَأْتَ ، قَالَ : أَقْسَمْت یَا رَسُولَ اللہِ لَتُخْبِرنِّی ، قَالَ : لاَ تُقْسِمْ۔ (بخاری ۷۰۴۶۔ مسلم ۱۷۷۷)","Sahih","Musannaf Ibn Abi Shaybah 31121","","","كتاب الرؤيا"
"31122","(۳۱۱۲۲) حَدَّثَنَا قَبِیصَۃُ بْنُ عُقْبَۃَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرَۃَ ، عَنْ أَبِیہِ ، قَالَ : وَفَدْنَا مَعَ زِیَادٍ إلَی مُعَاوِیَۃَ فَمَا أُعْجِبَ بِوَفْدٍ مَا أُعْجِبَ بِنَا ، قَالَ : فَقَالَ : یَا أَبَا بَکْرَۃَ ! حَدِّثْنا بِشَیْئٍ سَمِعْتَہُ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ: - وَکَانَتْ تُعْجِبُہُ الرُّؤْیَا الْحَسَنَۃُ یَسْأَلُ عنہا - فَسَمِعْتَہُ یَقُولُ : رَأَیْتُ کَأَنَّ مِیزَانًا أُنْزِلَ مِنَ السَّمَائِ فَوُزِنْت فِیہِ أَنَا وَأَبُو بَکْرٍ فَرَجَحْت بِأَبِی بَکْرٍ ، وَوُزِنَ أَبُو بَکْرٍ وَعُمَرُ فَرَجَحَ أَبُو بَکْرٍ ، ثُمَّ وُزِنَ عُمَرُ وَعُثْمَان فَرَجَحَ عُمَرُ بِعُثْمَانَ ، ثُمَّ رُفِعَ الْمِیزَانُ إلَی السَّمَائِ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خِلاَفَۃٌ ونُبُوَّۃ، ثُمَّ یُؤْتِی اللَّہُ الْمُلْکَ مَنْ یَشَائُ، قَالَ: فَزُخَّ فِی أَقْفِیَتِنَا فَأُخْرِجْنَا۔ (ابوداؤد ۴۶۱۰۔ ترمذی ۲۲۸۷)","Da'if","Musannaf Ibn Abi Shaybah 31122","","","كتاب الرؤيا"
"31123","(۳۱۱۲۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا وُہَیْب ، قَالَ : حَدَّثَنِی مُوسَی بْنُ عُقْبَۃَ ، قَالَ : حَدَّثَنِی سَالِمٌ ، عَنْ رُؤْیَا رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی وَبَائِ الْمَدِینَۃِ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ : رَأَیْتُ امْرَأَۃً سَوْدَائَ ثَائِرَۃَ الرَّأْسِ خَرَجَتْ مِنَ الْمَدِینَۃِ حَتَّی قَدِمَتْ مَہْیَعَۃَ ، فَأَوَّلْت أَنَّ وَبَائَ الْمَدِینَۃِ نُقِلَ إلَی مَہْیَعَۃَ۔ (بخاری ۷۰۳۸۔ ترمذی ۲۲۹۰)","Sahih","Musannaf Ibn Abi Shaybah 31123","","","كتاب الرؤيا"
"31124","(۳۱۱۲۴) حَدَّثَنَا أَبُو دَاوُدَ عُمَرُ بْنُ سَعْدٍ ، عَنْ بَدْرِ بْنِ عُثْمَانَ ، عَنْ عُبَیْدِ اللہِ بْنِ مَرْوَانَ ، عَنْ أَبِی عَائِشَۃَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : خَرَجَ إلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَاتَ غَدَاۃٍ ، فَقَالَ : رَأَیْت آنِفًا أَنِّی أُعْطِیت الْمَوَازِینَ وَالْمَقَالَیدَ ، فَأَمَّا الْمَقَالَیدُ فَہَذِہِ الْمَفَاتِیحُ ، فَوُضِعْت فِی کِفَّۃٍ وَوُضِعَتْ أُمَّتِی فِی کِفَّۃٍ فَرَجَحْت بِہِمْ ، ثُمَّ جِیئَ بِأَبِی بَکْرٍ فَرَجَحَ ، ثُمَّ جِیئَ بِعُمَرَ فَرَجَحَ ، ثُمَّ جِیئَ بِعُثْمَانَ فَرَجَحَ ، قَالَ : ثُمَّ رُفِعْت ، قَالَ : فَقَالَ لَہُ رَجُلٌ : فَأَیْنَ نَحْنُ ؟ قَالَ : حَیْثُ جَعَلْتُمْ أَنْفُسَکُمْ۔ (احمد ۷۶)","Da'if","Musannaf Ibn Abi Shaybah 31124","","","كتاب الرؤيا"
"31125","(۳۱۱۲۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، قَالَ : حَدَّثَنِی أَبُو بَکْرِ بْنُ سَالِمِ ، عَنْ سَالِمِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : رَأَیْتُ فِی النَّوْمِ کَأَنِّی أَنْزَعُ بِدَلْوِ بَکَرَۃٍ عَلَی قَلِیبٍ ، فَجَائَ أَبُو بَکْرٍ فَنَزَعَ ذَنُوباً أَوْ ذَنُوبَیْنِ ، فَنَزَعَ نَزْعًا ضَعِیفًا ، وَاللَّہُ یَغْفِرُ لَہُ ، ثُمَّ جَائَ عُمَرُ بْنُ الْخَطَّابِ فَاسْتَقَی فَاسْتَحَالَتْ غَرْبًا ، فَلَمْ أَرَ عَبْقَرِیًّا مِنَ النَّاسِ یَفْرِی فَرِیَّہُ ، حَتَّی رَوِیَ النَّاسُ وَضَرَبُوا بِعَطَنٍ۔ (بخاری ۳۶۷۶۔ مسلم ۱۹)","Sahih","Musannaf Ibn Abi Shaybah 31125","","","كتاب الرؤيا"
"31126","(۳۱۱۲۶) حَدَّثَنَا ہَوْذَۃُ بْنُ خَلِیفَۃَ ، قَالَ : حدَّثَنَا عَوْفٌ ، عَنْ أَبِی رَجَائٍ ، قَالَ : حَدَّثَنَا سَمُرَۃُ بْنُ جُنْدُبٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِمَّا یَقُولُ لأَصْحَابِہِ : ہَلْ رَأَی أَحَدٌ مِنْکُمْ رُؤْیَا ، فَیَقُصُّ عَلَیْہِ مَا شَائَ اللَّہُ أَنْ یَقُصَّ ، فَقَالَ لَنَا ذَاتَ غَدَاۃٍ : إنِّی أَتَانِی اللَّیْلَۃَ آتِیَانِ ، أَو اثْنَانِ الشَّکُّ مِنْ ہَوْذَۃَ ، فَقَالاَ لِی : انْطَلِقْ ، فَانْطَلَقْت مَعَہُمَا ، وَإِنَّا أَتَیْنَا عَلَی رَجُلٍ مُضْطَجِعٍ وَإِذَا آخَرُ قَائِمٌ عَلَیْہِ بِصَخْرَۃٍ ، وَإِذَا ہُوَ یَہْوِی بِالصَّخْرَۃِ لِرَأْسِہِ ، فَیَثْلَغُ رَأْسَہُ فَیَتَدَہْدَہُ الْحَجَرُ ہَاہُنَا فَیَأْخُذُہُ ، وَلاَ یَرْجِعُ إلَیْہِ حَتَّی یَصِحَّ رَأْسُہُ کَمَا کَانَ ، ثُمَّ یَعُودُ عَلَیْہِ فَیَفْعَلُ بِہِ مِثْلَ الْمَرَّۃِ الأُولَی ، قَالَ : قُلْتُ لَہُمَا : سُبْحَانَ اللہِ مَا ہَذَا فَقَالاَ لِی : انْطَلِقْ۔n فَانْطَلَقْنَا حَتَّی أَتَیْنَا عَلَی رَجُلٍ مُسْتَلْقٍ لِقَفَاہُ وَإِذَا آخَرُ قَائِمٌ عَلَیْہِ بِکَلُّوبٍ مِنْ حَدِیدٍ ، وَإِذَا ہُوَ یَأْتِی أَحَدَ شِقَّیْ وَجْہِہِ فَیُشَرْشِرُ شِدْقَہُ إلَی قَفَاہُ ، وَعَیْنَہُ إلَی قَفَاہُ ، وَمَنْخِرَہُ إلَی قَفَاہُ ، ثُمَّ یَتَحَوَّلُ إلَی الْجَانِبِ الآخَرِ ، فَیَفْعَلُ بِہِ مِثْلَ ذَلِکَ ، فَمَا یَفْرُغُ مِنْہُ حَتَّی یَصِحَّ ذَلِکَ الْجَانِبُ کَمَا کَانَ ، ثُمَّ یَعُودُ عَلَیْہِ فَیَفْعَلُ بِہِ کَمَا فَعَلَ فِی الْمَرَّۃِ الأُولَی ، فَقُلْتُ لَہُمَا : سُبْحَانَ اللہِ مَا ہَذَا ؟ قَالَ : قَالاَ لِی : انْطَلِقَ انْطَلِقْ۔n فَانْطَلَقْنَا حَتَّی أَتَیْنَا عَلَی مِثْلِ بِنَائِ التَّنُّورِ ، قَالَ : فَأَحْسِبُ أَنَّہُ قَالَ سَمِعَنَّا فِیہِ لَغَطًا وَأَصْوَاتًا ، فَاطلعنَا فَإِذَا فِیہِ رِجَالٌ وَنِسَائٌ عُرَاۃٌ وَإِذَا ہُمْ یَأْتِیہِمْ لَہَبٌ مِنْ أَسْفَلَ مِنْہُمْ ، فَإِذَا أَتَاہُمْ ذَلِکَ اللَّہَبُ ضَوْضَوا ، قَالَ : قُلْتُ لَہُمَا : مَا ہَؤُلاَئِ ؟ قَالَ : قَالاَ لِی : انْطَلِقَ انْطَلِقْ۔n قَالَ : فَانْطَلَقْنَا حَتَّی أَتَیْنَا عَلَی نَہْرٍ - حَسِبْت أَنَّہُ قَالَ أَحْمَرَ - مِثْلِ الدَّمِ ، فَإِذَا فِی النَّہَرِ رَجُلٌ یَسْبَحُ وَإِذَا عَلَی شَاطِیئِ النَّہَرِ رَجُلٌ قَدْ جَمَعَ عِنْدَہُ حِجَارَۃً کَثِیرَۃً ، وَإِذَا ذَلِکَ السَّابِحُ یَسْبَحُ مَا سَبَحَ ، ثُمَّ یَأْتِی ذَلِکَ الَّذِی قَدْ جَمَعَ عِنْدَہُ الْحِجَارَۃَ فَیَفْغَرُ لَہُ فَاہُ ، فَیُلْقِمُہُ حَجَرًا ، فَیَذْہَبُ فَیَسْبَحُ مَا سَبَحَ ، ثُمَّ یَأْتِی ذَلِکَ الَّذِی کُلَّمَا رَجَعَ فَغَرَ لَہُ فَاہُ فَأَلْقَمَہُ الْحَجَرَ ، قَالَ : قُلْتُ : مَا ہَذَا ؟ قَالَ : قَالاَ : لِی : انْطَلِقَ انْطَلِقْ۔n قَالَ : فَانْطَلَقْنَا ، فَأَتَیْنَا عَلَی رَجُلٍ کَرِیہِ الْمَرْآۃِ کَأَکْرَہِ مَا أَنْتَ رَائٍ رَجُلاً مَرْآۃً ، وَإِذَا ہُوَ عِنْدَ نَارٍ یَحشُہَا وَیَسْعَی حَوْلَہَا ، قَالَ : قُلْتُ لَہُمَا : مَا ہَذَا ؟ قَالاَ لِی : انْطَلِقَ انْطَلِقْ۔n فَانْطَلَقْنَا حَتَّی أَتَیْنَا عَلَی رَوْضَۃٍ مُعْتمَّۃٍ فِیہَا مِنْ کُلِّ نَوْرِ الرَّبِیعِ وَإِذَا بَیْنَ ظَہْرَانَیِ الرَّوْضَۃِ رَجُلٌ طَوِیلٌ لاَ أَکَادُ أَرَی رَأْسَہُ طُولاً فِی السَّمَائِ وَإِذَا حَوْلَ الرَّجُلِ مِنْ أَکْثَرِ وِلْدَانٍ رَأَیْتہمْ قَطُّ وَأَحْسَنِہ ، قَالَ : قُلْتُ لَہُمَا: مَا ہَذَا ؟ وَمَا ہَؤُلاَئِ ؟ قَالَ : قَالاَ لِی : انْطَلِقْ۔n فَانْطَلَقْنَا ، فَانْتَہَیْنَا إلَی دَرَجَۃٍ عَظِیمَۃٍ لَمْ أَرَ قَطُّ دَرَجَۃً أَعْظَمَ مِنْہَا وَلاَ أَحْسَنَ ، قَالَ : قَالاَ لِی : ارْقَ فِیہَا ، فَارْتَقَیْتہَا فَانْتَہَیْنَا إلَی مَدِینَۃٍ مَبْنِیَّۃٍ بِلَبِنِ ذَہَبٍ وَلَبِنِ فِضَّۃٍ ، قَالَ : فَأَتَیْنَا بَابَ الْمَدِینَۃِ فَاسْتَفْتَحْنَاہَا فَفُتِحَ لَنَا ، فَدَخَلْنَاہَا فَتَلَقَّانَا فِیہَا رِجَالٌ شَطْرٌ مِنْ خَلْقِہِمْ کَأَحْسَنِ مَا أَنْتَ رَائٍ وَشَطْرٌ کَأَقْبَحِ مَا أَنْتَ رَائٍ ، قَالَ : قَالاَ لَہُمْ : اذْہَبُوا فَقَعُوا فِی ذَلِکَ النَّہَرِ ، قَالَ : فَإِذَا نَہْرٌ مُعْتَرِضٌ یَجْرِی کَأَنَّ مَائَہُ الْمَحْضُ مِنَ الْبَیَاضِ ، قَالَ : فَذَہَبُوا فَوَقَعُوا فِیہِ ، ثُمَّ رَجَعُوا إلَیْنَا وَقَدْ ذَہَبَ السُّوئُ عَنْہُمْ وَصَارُوا فِی أَحْسَنِ صُورَۃٍ۔n قَالَ : قَالاَ لِی : ہَذِہِ جَنَّۃُ عَدْنٍ ، وَہَا ہُوَ ذَاکَ مَنْزِلُک ، قَالَ : فَسَمَا بَصَرِی صُعَدَاً ، فَإِذَا قَصْرٌ مِثْلُ الرَّبَابَۃِ الْبَیْضَائِ ، قَالَ : قَالاَ لِی : ہَا ہُوَ ذَاک مَنْزِلُک ، قَالَ : قُلْتُ لَہُمَا : بَارَکَ اللَّہُ فِیکُمَا ذَرَانِی فَلأَدْخُلُہُ ، قَالَ : قَالاَ لِی : أَمَّا الآنَ فَلاَ ، وَأَنْتَ دَاخِلُہُ۔n قَالَ : قُلْتُ لَہُمَا : إنِّی قَدْ رَأَیْت ہَذِہِ اللَّیْلَۃَ عَجَبًا ، فَمَا ہَذَا الَّذِی رَأَیْت ؟ قَالَ : قَالاَ : أَمَا إنَّا سَنُخْبِرُک ، أَمَّا الرَّجُلُ الأَوَّلُ الَّذِی أَتَیْتَ عَلَیْہِ یُثْلَغُ رَأْسُہُ بِالْحَجَرِ فَإِنَّہُ رَجُلٌ یَأْخُذُ الْقُرْآنَ وَیَنَامُ عَنِ الصَّلاَۃِ الْمَکْتُوبَۃِ۔ وَأَمَّا الرَّجُلُ الَّذِی أَتَیْتَ عَلَیْہِ یُشَرْشَرُ شَدْقَہُ وَعَیْنَہُ وَمَنْخِرَہُ إلَی قَفَاہُ فَإِنَّہُ رَجُلٌ یَغْدُو مِنْ بَیْتِہِ فَیَکْذِبُ الْکِذْبَۃَ تَبْلُغُ الآفَاقَ۔ وَأَمَّا الرِّجَالُ وَالنِّسَائُ الْعُرَاۃُ الَّذِینَ فِی مِثْلِ بِنَائِ التَّنُّورِ فَإِنَّہُمَ الزُّنَاۃُ وَالزَّوَانِی۔ وَأَمَّا الرَّجُلُ الَّذِی یَسْبَحُ فِی النَّہَرِ وَیُلْقَمُ الْحِجَارَۃَ فَإِنَّہُ آکِلُ الرِّبَا۔ وَأَمَّا الرَّجُلُ الَّذِی عِنْدَ النَّارِ کَرِیہِ الْمِرْآۃِ فَإِنَّہُ مَالِکٌ خَازِنُ جَہَنَّمَ۔ وَأَمَّا الرَّجُلُ الطَّوِیلُ الَّذِی فِی الرَّوْضَۃِ فَإِنَّہُ إبْرَاہِیمُ ، وَأَمَّا الْوِلْدَانُ الَّذِینَ حَوْلَہُ فَکُلُّ مَوْلُودٍ مَاتَ عَلَی الْفِطْرَۃِ ، قَالَ : فَقَالَ بَعْضُ الْمُسْلِمِینَ : یَا رَسُولَ اللہِ ، وَأَوْلاَدُ الْمُشْرِکِینَ ؟ قَالَ : وَأَوْلاَدُ الْمُشْرِکِینَ۔n وَأَمَّا الْقَوْمُ الَّذِینَ شَطْرٌ مِنْہُمْ کَأَقْبَحِ مَا رَأَیْت وَشَطْرٌ کَأَحْسَنِ مَا رَأَیْت فَإِنَّہُمْ قَوْمٌ خَلَطُوا عَمَلاً صَالِحًا وَآخَرَ سَیِّئًا فَتَجَاوَزَ اللَّہُ عَنْہُمْ۔ (بخاری ۱۳۸۶۔ مسلم ۱۷۸۱)","Sahih","Musannaf Ibn Abi Shaybah 31126","","","كتاب الرؤيا"
"31127","(۳۱۱۲۷) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَاصِمِ بْنِ بَہْدَلَۃَ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ خَرَشَۃَ بْنِ الْحُرِّ ، قَالَ : قَدِمْت الْمَدِینَۃَ فَجَلَسْت إلَی مَشْیَخَۃٍ فِی الْمَسْجِدِ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَجَائَ شَیْخٌ مُتَوَکِّئٌ عَلَی عَصًا لَہُ ، فَقَالَ الْقَوْمُ : مَنْ سَرَّہُ أَنْ یَنْظُرَ إلَی رَجُلٍ مِنْ أَہْلِ الْجَنَّۃِ فَلْیَنْظُرْ إلَی ہَذَا ، قَالَ : فَقَامَ خَلْفَ سَارِیَۃٍ فَصَلَّی رَکْعَتَیْنِ فَقُمْت إلَیْہِ فَقُلْتُ لَہُ : قَالَ بَعْضُ الْقَوْمِ کَذَا وَکَذَا ، فَقَالَ : الْجَنَّۃُ لِلَّہِ یُدْخِلُہَا مَنْ یَشَائُ ، وَإِنِّی رَأَیْت عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رُؤْیَا : رَأَیْت کَأَنَّ رَجُلاً یَأْتِی ، فَقَالَ لِی : انْطَلِقْ فَذَہَبْت مَعَہُ فَسَلِکَ بِی فِی مَنْہَجٍ عَظِیمٍ ، فَعَرَضَت لِی طَرِیقٌ عَنْ یَسَارِی ، فَأَرَدْت أَنْ أَسْلُکَہَا ، فَقِیلَ : إنَّک لَسْت مِنْ أَہْلِہَا ، ثُمَّ عَرَضَتْ لِی طَرِیقٌ عَنْ یَمِینِی ، فَسَلِکْتہَا حَتَّی إذَا انْتَہَیْت إلَی جَبَلٍ زَلْق ، فَأَخَذَ بِیَدِی فَأَدْخَلَنِی فَإِذَا أَنَا عَلَی ذُرْوَتِہِ فَلَمْ أَتَقَارَّ وَلَمْ أَتَمَاسَک ، وَإِذَا عَمُودٌ مِنْ حَدِیدٍ فِی ذُرْوَتِہِ حَلْقَۃٌ مِنْ ذَہَبٍ ، فَأَخَذَ بِیَدِی فَدَحَانِی حَتَّی أَخَذْت بِالْعُرْوَۃِn فَقَالَ : اسْتَمْسِکَ ، فَقُلْتُ : نَعَمْ ، فَضَرَبَ الْعَمُودَ بِرِجْلِہِ وَاسْتَمْسَکْت بِالْعُرْوَۃِ۔n فَقَصَصْتہَا عَلَی رَسُولِ اللہِ ، فَقَالَ : رَأَیْت خَیْرًا ، أَمَّا الْمَنْہَجُ الْعَظِیمُ : فَالْمَحْشَرُ ، وَأَمَّا الطَّرِیقُ الَّتِی عَرَضَتْ عَنْ یَسَارِکَ : فَطَرِیقُ أَہْلِ النَّارِ ، وَلَسْت مِنْ أَہْلِہَا ، وَأَمَّا الطَّرِیقُ الَّتِی عَرَضَتْ عَنْ یَمِینِکَ : فَطَرِیقُ أَہْلِ الْجَنَّۃِ ، وَأَمَّا الْجَبَلُ الزَّلِقُ : فَمَنْزِلُ الشُّہَدَائِ ، وَأَمَّا الْعُرْوَۃُ الَّتِی اسْتَمْسَکْت بِہَا : فَعُرْوَۃُ الإسْلاَمِ ، فَاسْتَمْسِکْ بِہَا حَتَّی تَمُوتَ۔n قَالَ : فَأَنَا أَرْجُو أَنْ أَکُونَ مِنْ أَہْلِ الْجَنَّۃِ ، قَالَ : فَإِذَا ہُوَ عَبْدُ اللہِ بْنُ سَلاَمٍ۔ (بخاری ۳۸۱۴۔ مسلم ۱۴۸)","Sahih","Musannaf Ibn Abi Shaybah 31127","","","كتاب الرؤيا"
"31128","(۳۱۱۲۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : رَأَیْتُ کَأَنِّی فِی دَارِ عُقْبَۃَ بْنِ رَافِعٍ وَأُتِینَا بِرُطَبٍ مِنْ رُطَبِ ابْنِ طَّاب ، فَأَوَّلْت : أَنَّ الرِّفْعَۃَ لَنَا فِی الدُّنْیَا ، وَالْعَاقِبَۃَ فِی الأُخْرَی ، وَأَنَّ دِینَنَا قَدْ طَابَ۔ (مسلم ۱۷۷۹۔ ابوداؤد ۴۹۸۶)","Sahih","Musannaf Ibn Abi Shaybah 31128","","","كتاب الرؤيا"
"31129","(۳۱۱۲۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : رَأَیْت کَأَنِّی فِی دِرْعٍ حَصِینَۃٍ ، وَرَأَیْت بَقَرَاً مَنْحُورَۃً ، فَأَوَّلْت : أَنَّ الدِّرْعَ الْمَدِینَۃُ ، وَالْبَقَرَۃَ نَفَرٌ۔ (دارمی ۲۱۵۹۔ بزار ۲۱۳۳)","Sahih","Musannaf Ibn Abi Shaybah 31129","","","كتاب الرؤيا"
"31130","(۳۱۱۳۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ أَنَسٍ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : رَأَیْتُ فِیمَا یَرَی النَّائِمُ کَأَنِّی مُرْدِفٌ کَبْشًا ، وَکَأَنَّ ضُبَّۃَ سَیْفِی انْکَسَرَتْ ، فَأَوَّلْت أَنِّی أَقْتُلُ صَاحِبَ الْکَتِیبَۃِ ، قَالَ عَفَّانَ : کَانَ بَعْدَ ہَذَا شَیْئٌ لَمْ أَدْرِ مَا ہُوَ۔ (بزار ۲۱۳۱۔ طبرانی ۲۹۵۱)","Da'if","Musannaf Ibn Abi Shaybah 31130","","","كتاب الرؤيا"
"31131","(۳۱۱۳۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا الأَشْعَثُ بْنُ عَبْدِ الرَّحْمَنِ الْجَرْمِیُّ ، عَنْ أَبِیہِ، عَنْ سَمُرَۃََ بْنِ جُنْدُبٍ : أَنَّ رَجُلاً قَالَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : رَأَیْت کَأَنَّ دَلْوًا دُلیَتْ مِنَ السَّمَائِ، فَجَائَ أَبُو بَکْرٍ فَأَخَذَ بِعَرَاقِیہَا فَشَرِبَ شُرْبًا وَفِیہِ ضَعْفٌ ، ثُمَّ جَائَ عُمَرُ فَأَخَذَ بِعَرَاقِیہَا فَشَرِبَ حَتَّی تَضَلَّعَ ، ثُمَّ جَائَ عُثْمَانُ فَأَخَذَ بِعَرَاقِیہَا فَشَرِبَ حَتَّی تَضَلَّعَ۔ (ابوداؤد ۴۶۱۳۔ طبرانی ۶۹۶۵)","Sahih","Musannaf Ibn Abi Shaybah 31131","","","كتاب الرؤيا"
"31132","(۳۱۱۳۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ مُبَارَکٍ ، عَنْ یُونُسَ ، عَنِ الزُّہْرِیِّ ، عَنْ حَمْزَۃَ بْنِ عَبْدِ اللہِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : رَأَیْت فِی الْمَنَامِ کَأَنَّ الرِّیَّ یَجْرِی بَیْنَ ظُفْرِی ، أَوْ أَظْفَارِی ، قَالُوا : مَا أَوَّلْتہ ؟ قَالَ : الْعِلْمُ۔ (بخاری ۳۶۸۱۔ مسلم ۱۸۵۹)","Sahih","Musannaf Ibn Abi Shaybah 31132","","","كتاب الرؤيا"
"31133","(۳۱۱۳۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی قَتَادَۃَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : الرُّؤْیَا مِنَ اللہِ ، وَالْحُلْمُ مِنَ الشَّیْطَانِ ، فَإِذَا رَأَی أَحَدُکُمْ مَا یَکْرَہُ ، فَلْیَنْفِثْ عَنْ یَسَارِہِ ثَلاَثًا ، وَلْیَتَعَوَّذْ بِاللہِ مِنْ شَرِّہَا ، فَإِنَّہَا لاَ تَضُرُّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31133","","","كتاب الرؤيا"
"31134","(۳۱۱۳۴) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللہِ ، عَنْ لَیْثِ بْنِ سَعْدٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا رَأَی أَحَدُکُمَ الرُّؤْیَا یَکْرَہُہَا فَلْیَبْصُقْ ، عَنْ یَسَارِہِ ثَلاَثًا ، وَلْیَسْتَعِذْ بِاللہِ مِنَ الشَّیْطَانِ ثَلاَثًا ، وَلْیَتَحَوَّلْ عَنْ جَنْبِہِ الَّذِی کَانَ عَلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31134","","","كتاب الرؤيا"
"31135","(۳۱۱۳۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ یَزِیدَ الرَّقَاشِیِّ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لِلرُّؤْیَا کُنًی ، وَلَہَا أَسْمَائٌ ، فَکَنُّوہَا بِکُنَاہَا وَعَبِّروہَا بِأَسْمَائِہَا ، وَالرُّؤْیَا لأَوَّلِ عَابِرٍ۔n(ابن ماجہ ۳۹۱۵۔ ابویعلی ۴۱۱۷)","Da'if","Musannaf Ibn Abi Shaybah 31135","","","كتاب الرؤيا"
"31136","(۳۱۱۳۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ، قَالَ : مَرَّ صُہَیْبٌ بِأَبِی بَکْرٍ فَأَعْرَضَ عَنْہُ، فَقَالَ : مَالَک أَعْرَضْت عَنِّی ؟ أَبْلَغَک شَیْئٌ تَکْرَہُہُ ؟ قَالَ : لاَ وَاللہِ إلاَّ رُؤْیَا رَأَیْتہَا لَکَ کَرِہْتُہَا ، قَالَ : وَمَا رَأَیْت ؟ قَالَ : رَأَیْتُ یَدَک مَغْلُولَۃً إلَی عُنُقِکَ عَلَی بَابِ رَجُلٍ مِنَ الأَنْصَارِ یُقَالَ لَہُ : أَبُو الْحَشْرِ ! فَقَالَ لَہُ أَبُو بَکْرٍ : نِعْمَ مَا رَأَیْت ، جَمَعَ لِی دَیْنِی إلَی یَوْمِ الْحَشْرِ۔","Hasan","Musannaf Ibn Abi Shaybah 31136","","","كتاب الرؤيا"
"31137","(۳۱۱۳۷) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ : أَنَّ عَائِشَۃَ قَالَتْ لأَبِیہَا : إِنِّی رَأَیْت فِی النَّوْمِ کَأَنَّ قَمَرًا وَقَعَ فِی حُجْرَتِی حَتَّی ذَکَرَتْ ثَلاَثَ مِرار ، فَقَالَ لَہَا أَبُو بَکْرٍ : إنْ صَدَقَتْ رُؤْیَاکِ ، دُفِنَ فِی بَیْتِکَ خَیْرُ أَہْلِ الأَرْضِ : ثَلاَثَۃٌ۔ (طبرانی ۱۲۷)","","Musannaf Ibn Abi Shaybah 31137","","","كتاب الرؤيا"
"31138","(۳۱۱۳۸) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ : أَنَّ رَجُلاً أَتَی أَبَا بَکْرٍ ، فَقَالَ : إنِّی رَأَیْت فِی النَّوْمِ کَأَنِّی أَبُولُ دَمًا ، قَالَ : أَرَاک تَأْتِی امْرَأَتَکَ وَہِیَ حَائِضٌ ، قَالَ : نَعَمْ ، قَالَ : فَاتَّقِ اللَّہَوَلاَ تَعُدْ۔","","Musannaf Ibn Abi Shaybah 31138","","","كتاب الرؤيا"
"31139","(۳۱۱۳۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، عَنْ عَامِرٍ ، قَالَ : أَتَی رَجُلٌ أَبَا بَکْرٍ فَقَالَ : إنِّی رَأَیْت فِی الْمَنَامِ کَأَنِّی أُجْرِی ثَعْلَبًا ، قَالَ : أَنْتَ رَجُلٌ کَذُوبٌ ، فَاتَّقِ اللَّہَ وَلاَ تَعُدْ۔","Da'if","Musannaf Ibn Abi Shaybah 31139","","","كتاب الرؤيا"
"31140","(۳۱۱۴۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : قالَتْ عَائِشَۃُ لأَبِی بَکْرٍ : إنِّی رَأَیْت فِی الْمَنَامِ بَقَرًا یُنْحَرْنَ حَوْلِی ، قَالَ : إنْ صَدَقَتْ رُؤْیَاک قُتِلَتْ حَوْلَک فِئَۃٌ!۔","Da'if","Musannaf Ibn Abi Shaybah 31140","","","كتاب الرؤيا"
"31141","(۳۱۱۴۱) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادۃ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ الْغَطَفَانِیِّ، عَنْ مَعْدَانَ بْنِ أَبِی طَلْحَۃَ الْیَعْمُرِیِّ : أَنَّ عُمَرَ بْنَ الْخَطَّابِ قَالَ یَوْمَ جُمُعَۃِ ، أَوْ خَطَبَ یَوْمَ جُمُعَۃَ ، فَحَمِدَ اللَّہَ وَأَثْنَی عَلَیْہِ ثُمَّ قَالَ: أَیُّہَا النَّاسُ! إنِّی رَأَیْت دِیکًا أَحْمَرَ نَقَرَنِی نَقْرَتَیْنِ، وَلاَ أُرَی ذَلِکَ إلاَّ حُضُورَ أَجَلِی۔ n(مسلم ۳۹۷۔ احمد ۴۸)","Sahih","Musannaf Ibn Abi Shaybah 31141","","","كتاب الرؤيا"
"31142","(۳۱۱۴۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی جَمْرَۃَ ، عَنْ جَارِیَۃَ بْنِ قُدَامَۃَ السَّعْدِیِّ، قَالَ: حجَجْت الْعَامَ الَّذِی أُصِیبَ فِیہِ عُمَرُ ، قَالَ : فَخَطَبَ ، فَقَالَ : إنِّی رَأَیْت کَأَنَّ دِیکًا نَقَرَنِی نَقْرَتَیْنِ ، أَوْ ثَلاَثًا۔","Sahih","Musannaf Ibn Abi Shaybah 31142","","","كتاب الرؤيا"
"31143","(۳۱۱۴۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سُفْیَانَ ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ الْخُزَاعِیِّ ، قَالَ : سَمِعْتُ عُمَرَ بْنَ الْخَطَّابِ یَقُولُ فِی خُطْبَتِہِ : إنِّی رَأَیْت الْبَارِحَۃَ دِیکًا نَقَرَنِی وَرَأَیْتہ یُجْلِیہ النَّاسُ عَنِّی ، فَلَمْ یَلْبَثْ إلاَّ ثَلاَثًا حَتَّی قَتَلَہُ عَبْدُ الْمُغِیرَۃِ : أَبُو لُؤْلُؤَۃَ۔ (بیہقی ۲۳۲)","Sahih","Musannaf Ibn Abi Shaybah 31143","","","كتاب الرؤيا"
"31144","(۳۱۱۴۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُمَر بْنِ حَمْزَۃَ ، قَالَ : أَخْبَرَنِی سَالِمٌ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ عُمَرُ : رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْمَنَامِ ، فَرَأَیْتہ لاَ یَنْظُرُنِی ، فَقُلْتُ : یَا رَسُولَ اللہِ مَا شَأْنِی ؟ قَالَ : أَلَسْت الَّذِی تُقَبِّلُ وَأَنْتَ صَائِمٌ ؟ قُلْتُ : وَالَّذِی بَعَثَک بِالْحَقِّ لاَ أُقَبِّلُ بَعْدَہَا وَأَنَا صَائِمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 31144","","","كتاب الرؤيا"
"31145","(۳۱۱۴۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : حدَّثَنِی غَیْرُ وَاحِدٍ : أَنْ قَاضِیًا مِنْ قُضَاۃِ أَہْلِ الشَّامِ أَتَی عُمَرَ بْنَ الْخَطَّابِ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، رَأَیْت رُؤْیَا أَفْظَعَتْنِی ، قَالَ مَا ہِیَ ؟ قَالَ : رَأَیْتُ الشَّمْسَ وَالْقَمَرَ یَقْتَتِلاَنِ وَالنُّجُومَ مَعَہُمَا نِصْفَیْنِ ، قَالَ : فَمَعَ أَیِّہِمَا کُنْت ، قَالَ : مَعَ الْقَمَرِ عَلَی الشَّمْسِ ، فَقَالَ عُمَرُ : وَجَعَلْنَا اللَّیْلَ وَالنَّہَارَ آیَتَیْنِ فَمَحَوْنَا آیَۃَ اللَّیْلِ وَجَعَلْنَا آیَۃَ النَّہَارِ مُبْصِرَۃً ، قَالَ : فَانْطَلِقْ فَوَاللہِ لاَ تَعْمَلُ لِی عَمَلاً أَبَدًا۔","Da'if","Musannaf Ibn Abi Shaybah 31145","","","كتاب الرؤيا"
"31146","(۳۱۱۴۶) حَدَّثَنَا سُرَیْجُ بْنُ النُّعْمَانِ ، قَالَ : حدَّثَنِی عَبْدُ الْعَزِیزِ بْنُ أَبِی سَلَمَۃَ ، عَنْ زَیْدِ بْنِ أسْلَمَ ، عْن أَبِیہِ ، قَالَ : خَطَبَ عُمَرُ بْنُ الْخَطَّابِ النَّاسَ ، فَقَالَ : إنِّی رَأَیْت فِی مَنَامِی دِیکًا أَحْمَرَ نَقَرَنِی عَلَی مَعْقِدِ إزَارِی ثَلاَثَ نَقَرَاتٍ ، فَاسْتَعْبَرْتُہَا أَسْمَائَ بِنْتَ عُمَیْسٍ ، فَقَالَتْ : إنْ صَدَقَتْ رُؤْیَاک ، قَتَلَک رَجُلٌ مِنَ الْعَجَمِ۔","Sahih","Musannaf Ibn Abi Shaybah 31146","","","كتاب الرؤيا"
"31147","(۳۱۱۴۷) حَدَّثَنَا الْمُعَلَّی بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنِی یَحْیَی بْنُ حَمْزَۃَ ، عَنْ یَزِیدَ بْنِ عَبِیدَۃَ ، عَنْ أَبِی عُبَیْدِ اللہِ ، عَنْ عَوْفِ بْنِ مَالِکٍ الأَشْجَعِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الرُّؤْیَا عَلَی ثَلاَثَۃٍ : مِنْہَا تَخْوِیفٌ مِنَ الشَّیْطَانِ لِیَحْزُنَ بِہِ ابْنَ آدَمَ ، وَمِنْہُ الأَمْرُ یُحَدِّثُ بِہِ نَفْسَہُ فِی الْیَقَظَۃِ فَیَرَاہُ فِی الْمَنَامِ ، وَمِنْہَا جُزْئٌ مِنْ سِتَّۃٍ وَأَرْبَعِینَ جُزْئًا مِنَ النُّبُوَّۃِ۔ (ابن ماجہ ۳۹۰۷۔ ابن حبان ۶۰۴۲)","Hasan","Musannaf Ibn Abi Shaybah 31147","","","كتاب الرؤيا"
"31148","(۳۱۱۴۸) حَدَّثَنَا ہَوْذَۃُ بْنُ خَلِیفَۃَ ، عَنْ عَوْفٍ ، عَنْ مُحَمَّدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الرُّؤْیَا ثَلاَثٌ : فَالْبُشْرَی مِنَ اللہِ ، وَحَدِیثُ النَّفْسِ ، وَتَخْوِیفٌ مِنَ الشَّیْطَانِ ، فَإِذَا رَأَی أَحَدُکُمْ رُؤْیَا تُعْجِبُہُ ، فَلْیَقُصَّہَا إِنْ شَائَ ، وَإِذَا رَأَی شَیْئًا یَکْرَہُہُ فَلاَ یَقُصَّہُ عَلَی أَحَدٍ وَلْیَقُمْ یُصَلِّی۔ n(بخاری ۷۰۱۷۔ مسلم ۱۷۷۳)","","Musannaf Ibn Abi Shaybah 31148","","","كتاب الرؤيا"
"31149","(۳۱۱۴۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ وَوَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی ظَبْیَانَ ، عَنْ عَلْقَمَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : الرُّؤْیَا ثَلاَثَۃٌ : حُضُورُ الشَّیْطَانِ ، وَالرَّجُلُ یُحَدِّثُ نَفْسَہُ بِالنَّہَارِ فَیَرَاہُ بِاللَّیْ[corrupt]ِ ، وَالرُّؤْیَا الَّتِی ہِیَ الرُّؤْیَا۔","Sahih","Musannaf Ibn Abi Shaybah 31149","","","كتاب الرؤيا"
"31150","(۳۱۱۵۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا وُہَیْبٌ ، قَالَ : حَدَّثَنَا دَاوُد ، عَنْ زِیَادِ بْنِ عَبْدِ اللہِ ، عَنْ أُمِّ ہِلاَلٍ بِنْتِ وَکِیعٍ، عَنِ امْرَأَۃِ عُثْمَانَ ، قَالَتْ : أَغْفَی عُثْمَان ، فَلَمَّا اسْتَیْقَظَ قَالَ : إنَّ الْقَوْمَ یَقْتُلُونَنِی ، قُلْتُ : کَلاَّ یَا أَمِیرَ الْمُؤْمِنِینَ ، قَالَ : إِنِّی رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَبَا بَکْرٍ وَعُمَرَ ، قَالَ : فَقَالُوا : أَفْطِرْ عِنْدَنَا اللَّیْلَۃَ ، أَوْ قَالَ : إنَّک تُفْطِرُ عِنْدَنَا اللَّیْلَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 31150","","","كتاب الرؤيا"
"31151","(۳۱۱۵۱) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی جَعْفَرٍ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : أَنَّ عُثْمَانَ أَصْبَحَ یُحَدِّثُ النَّاسَ ، قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اللَّیْلَۃَ فِی الْمَنَامِ ، فَقَالَ : یَا عُثْمَان أَفْطِرْ عِنْدَنَا ، فَأَصْبَحَ صَائماً وَقُتِلَ مِنْ یَوْمِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 31151","","","كتاب الرؤيا"
"31152","(۳۱۱۵۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أُحِبُّ الْقَیْدَ فِی الْمَنَامِ ، وَأَکْرَہُ الْغُل، الْقَیْدُ ثَبَاتٌ فِی الدِّینِ ، وَقَالَ أَبُو ہُرَیْرَۃَ : اللَّبَنُ فِی الْمَنَامِ الْفِطْرَۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 31152","","","كتاب الرؤيا"
"31153","(۳۱۱۵۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : رَأَیْتُنِی عَلَی تَلٍّ کَأَنَّ حَوْلِی بَقَرًا تُنْحَر ، فَقَالَ مَسْرُوقٌ : إنِ اسْتَطَعْتِ أَنْ لاَ تَکُونِی أَنْتِ ہِیَ فَافْعَلِی ، قَالَ : فَابْتُلِیت بِذَلِکَ رَحِمَہَا اللَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31153","","","كتاب الرؤيا"
"31154","(۳۱۱۵۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ بَکْرٍ السَّہْمِیُّ ، عَنْ حَاتِمِ بْنِ أَبِی صَغِیرَۃٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ عَائِشَۃَ بِنْتِ طَلْحَۃَ ، عَنْ عَائِشَۃَ أُمِّ الْمُؤْمِنِینَ ، أَنَّہَا قَتَلَتْ جَانًّا ، فَأُتِیَتْ فِیمَا یَرَی النَّائِمُ ، فَقِیلَ لَہَا : أَمَا وَاللہِ لَقَدْ قَتَلْتِ مُسْلِمًا ، قَالَتْ : فَلِمَ یَدْخُلْ عَلَیَّ أَزْوَاجُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَقِیلَ لَہَا : مَا یَدْخُلُ عَلَیْک إلاَّ وَعَلَیْک ثِیَابُک ، فَأَصْبَحَتْ فَزِعَۃً وَأَمَرَتْ بِاثْنَیْ عَشَرَ أَلْفًا ، فَجعلَت فِی سَبِیلِ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31154","","","كتاب الرؤيا"
"31155","(۳۱۱۵۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی جَعْفَرٍ الْخَطْمِیِّ ، عَنْ عُمَارَۃَ بْنِ خُزَیْمَۃَ بْنِ ثَابِتٍ ، عَنْ أَبِیہِ : أَنَّہُ رَأَی فِی الْمَنَامِ کَأَنَّہُ یَسْجُدُ عَلَی جَبِینِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَذَکَرَ ذَلِکَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ الرُّوحَ لَیَلْقَی الرُّوحَ، أَو قَالَ : الرُّوحُ یَلْقَی الرُّوحَ ، شَکَّ یَزِیدُ ، فَأَقْنَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأْسَہُ ثُمَّ أَمَرَہُ فَسَجَدَ مِنْ خَلْفِہِ عَلَی جَبِینِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 31155","","","كتاب الرؤيا"
"31156","(۳۱۱۵۶) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا عَلِیُّ بْنُ زَیْدٍ وَأَبُو عِمْرَانَ الْجَوْنِیُّ : أَنَّ سَمُرَۃَ بْنَ جُنْدُبٍ قَالَ لأَبِی بَکْرٍ : رَأَیْت فِی الْمَنَامِ کَأَنِّی أَفْتِلُ شَرِیطًا وَأَضَعُہُ إلَی جَنْبِی وَنَقَدٌ یَأْکُلْنَہُ ، قَالَ : تَزَوَّجُ امْرَأَۃً ذَاتَ وَلَدٍ یَأْکُلُ کَسْبَک۔ قَالَ : وَرَأَیْت ثَوْرًا خَرَجَ مِنْ جُحْرٍ فَلَمْ یَسْتَطِعْ یَعُودُ فِیہِ ، قَالَ : ہَذِہِ الْعَظِیمَۃُ تَخْرُجُ مِنْ فِی الرَّجُلِ فَلاَ یَسْتَطِیعُ أَنْ یَرُدَّہَا ، قَالَ : وَرَأَیْت کَأَنَّہُ قِیلَ : الدَّجَّالُ یَخْرُجُ ، فَجَعَلْتُ أَتَقَحَّمُ الْجُدُرَ ، فَالْتَفَتّ خَلْفِی فَفُرِجَتْ لِی الأَرْضُ فَدَخَلْتہَا ، قَالَ : تُصِیبُک قُحَمٌ فِی دِینِکَ ، وَالدَّجَّالُ عَلَی إِثْرِکَ قَرِیبًا۔","Hasan","Musannaf Ibn Abi Shaybah 31156","","","كتاب الرؤيا"
"31157","(۳۱۱۵۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ بَکْرٍ ، قَالَ : حدَّثَنَا حُمَیْدٌ ، عَنْ أَنَسٍ ، قَالَ : رَأَیْتُ فِیمَا یَرَی النَّائِمُ کَأَنَّ عَبْدَ اللہِ بْنَ عُمَرَ یَأْکُلُ تَمْرًا ، فَکَتَبْتُ إلَیْہِ : إنِّی رَأَیْتُک تَأْکُلُ تَمْرًا وَہُوَ حَلاَوَۃُ الإِیمَانِ إنْ شَائَ اللَّہُ تَعَالَی۔","Sahih","Musannaf Ibn Abi Shaybah 31157","","","كتاب الرؤيا"
"31158","(۳۱۱۵۸) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، قَالَ : حدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، عَنِ الْعَلاَئِ بْنِ زِیَادٍ الْعَدَوِیِّ ،َقَالَ : رَأَیْت فِی النَّوْمِ کَأَنِّی أَرَی عَجُوزًا کَبِیرَۃً عَوْرَائَ الْعَیْنِ وَالأُخْرَی قَدْ کَادَتْ تَذْہَبُ عَلَیْہَا مِنَ الزَّبَرْجَدِ ، وَمِنَ الْحِلْیَۃُ شَیْئٌ عَجَبٌ ، قَالَ : قُلْتُ : مَا أَنْتِ ؟ قَالَتْ : الدُّنْیَا ، قُلْتُ : أَعُوذُ بِاللہِ مِنْ شَرِّکَ، قَالَتْ : إنْ سَرَّک أَنْ یُعِیذَکَ اللہ مِنْ شَرِّی فَأَبْغِضِ الدِّرْہَمَ۔","","Musannaf Ibn Abi Shaybah 31158","","","كتاب الرؤيا"
"31159","(۳۱۱۵۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا فُضَیْلُ بْنُ غَزْوَانَ ، قَالَ : حَدَّثَنَا عَبْدُ اللہِ بْنُ الْقَاسِمِ ، قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَأَلْتُہُ عَنِ الأَشْرِبَۃِ ، فَقَالَ : بَیْنَ شَارِبٍ وَتَارِکٍ۔","","Musannaf Ibn Abi Shaybah 31159","","","كتاب الرؤيا"
"31160","(۳۱۱۶۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، قَالَ : قِیلَ لِمُحَمَّدِ بْنِ سِیرِینَ : إنَّ فُلاَنًا یَضْحَکُ ، قَالَ : وَلِمَ لاَ یَضْحَکُ ، فَقَدْ ضَحِکَ مَنْ ہُوَ خَیْرٌ مِنْہُ ، حُدِّثْت أَنَّ عَائِشَۃَ قَالَتْ : ضَحِکَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ رُؤْیَا قَصَّہَا عَلَیْہِ رَجُلٌ ضَحِکًا مَا رَأَیْتہ ضَحِکَ مِنْ شَیْئٍ قَطُّ أَشَدَّ مِنْہُ ، قَالَ مُحَمَّدٌ : وَقَدْ عَلِمْت مَا الرُّؤْیَا ، وَمَا تَأْوِیلُہَا ، رَأَی کَأَنَّ رَأْسَہُ قُطِعَ ، قَالَ : فَذَہَبَ یَتْبَعُہُ ، فَالرَّأْسُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالرَّجُلُ یُرِیدُ أَنْ یَلْحَقَ بِعَمَلِہِ عَمَلَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ لاَ یُدْرِکُہُ۔","","Musannaf Ibn Abi Shaybah 31160","","","كتاب الرؤيا"
"31161","(۳۱۱۶۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنِی ثَابِتٌ ، عَنْ أَنَسِ بْنِ مَالِکٍ : أَنَّ أَبَا مُوسَی الأَشْعَرِیَّ ، أَوْ أَنَسًا قَالَ : رَأَیْتُ فِی الْمَنَامِ کَأَنِّی أَخَذْت جَوَادَّ کَثِیرَۃً فَسَلَکْتہَا حَتَّی انْتَہَیْت إلَی جَبَلٍ ، فَإِذَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَوْقَ الْجَبَلِ ، وَأَبُو بَکْرٍ إلَی جَنْبِہِ وَجَعَلَ یُومِئُ بِیَدِہِ إلَی عُمَرَ ، فَقُلْتُ: إنَّا لِلَّہِ وَإِنَّا إلَیْہِ رَاجِعُونَ ، مَاتَ وَاللہِ عُمَرُ ، فَقُلْتُ : أَلاَ تَکْتُبُ بِہِ إلَی عُمَرَ ، فَقَالَ : مَا کُنْت أَنْعَی إلَی عُمَرَ نَفْسَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31161","","","كتاب الرؤيا"
"31162","(۳۱۱۶۲) حَدَّثَنَا حُسَیْنُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنْ نَافِعٍ : أَنَّ ابْنَ عُمَرَ رَأَی رُؤْیَا : کَأَنَّ مَلَکًا انْطَلَقَ بِہِ إلَی النَّارِ ، فَلَقِیَہُ مَلَکٌ آخَرُ وَہُوَ یَزَعُہُ ، فَقَالَ : لَمْ تُرَعْ ، ہَذَا نِعْمَ الرَّجُلُ لَوْ کَانَ یُصَلِّی مِنَ اللَّیْلِ، قَالَ : فَکَانَ بَعْدَ ذَلِکَ یُطِیلُ الصَّلاَۃَ باللَّیْلِ ، قَالَ : وَقَدِ انْتَہَی بِی إلَی جَہَنَّمَ وَأَنَا أَقُولُ : أَعُوذُ بِاللہِ مِنَ النَّارِ ، فَإِذَا ہِیَ ضَیِّقَۃٌ کَالْبَیْتِ أَسْفَلُہُ وَاسِعٌ وَأَعْلاَہُ ضَیِّقٌ ، وَإِذَا رِجَالٌ مِنْ قُرَیْشٍ أَعْرِفُہُمْ مُنَکَّسُونَ بِأَرْجُلِہِمْ۔n(بخاری ۱۱۵۶۔ مسلم ۱۹۲۸)","Sahih","Musannaf Ibn Abi Shaybah 31162","","","كتاب الرؤيا"
"31163","(۳۱۱۶۳) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ إبْرَاہِیمَ التَّیْمِیَّ یَقُولُ : إنَّمَا حَمَلَنِی عَلَی مَجْلِسِی ہَذَا أَنِّی رَأَیْت کَأَنِّی أَقْسِمُ رَیْحَانًا بَیْنَ النَّاسِ ، فَذَکَرْت ذَلِکَ لإِبْرَاہِیمَ النَّخَعِیِّ ، فَقَالَ : إنَّ الرَّیْحَانَ لَہُ مَنْظَرٌ وَطَعْمُہُ مُرٌّ۔","","Musannaf Ibn Abi Shaybah 31163","","","كتاب الرؤيا"
"31164","(۳۱۱۶۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ شِبْلٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ : {وَعَلَّمْتَنِی مِنْ تَأْوِیلِ الأَحَادِیثِ} قَالَ: عِبَارَۃُ الرُّؤْیَا۔","","Musannaf Ibn Abi Shaybah 31164","","","كتاب الرؤيا"
"31165","(۳۱۱۶۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی سِنَانٍ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ : أَنَّہُ سَمِعَ قَوْمًا یَذْکُرُونَ رُؤْیَا وَہُوَ یُصَلِّی ، فَلَمَّا انْصَرَفَ سَأَلَہُمْ عنہا فَکَتَمُوہُ ، فَقَالَ : أَمَا أَنَّہُ جَائَ تَأْوِیلُ رُؤْیَا یُوسُفَ بَعْدَ أَرْبَعِینَ ۔ یَعْنِی : سَنَۃً۔","","Musannaf Ibn Abi Shaybah 31165","","","كتاب الرؤيا"
"31166","(۳۱۱۶۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : سَأَلَ رَجُلٌ مُحَمَّدًا ، قَالَ : رَأَیْتُ کَأَنِّی آکُلُ خَبِیصًا فِی الصَّلاَۃِ ؟ فَقَالَ : الْخَبِیصُ حَلاَلٌ ، وَلاَ یَحِلُّ لَک الأَکْلُ فِی الصَّلاَۃِ ، فَقَالَ لَہُ : تُقَبِّلُ امْرَأَتَکَ وَأَنْتَ صَائِمٌ ؟ قَالَ : نَعَمْ، قَالَ : فَلاَ تَفْعَلْ۔","","Musannaf Ibn Abi Shaybah 31166","","","كتاب الرؤيا"
"31167","(۳۱۱۶۷) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، عَنْ سَلْمَانَ ، قَالَ : کَانَ بَیْنَ رُؤْیَا یُوسُفَ وَتَأْوِیلِہَا أَرْبَعُونَ سَنَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 31167","","","كتاب الرؤيا"
"31168","(۳۱۱۶۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا عَبْدُ اللہِ بْنُ عَوْنٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا إذَا رَأَی أَحَدُہُمْ مَا یَکْرَہُ ، قَالَ : أَعُوذُ بِمَا عَاذَتْ بِہِ مَلاَئِکَۃُ اللہِ وَرَسُولُہُ مِنْ شَرِّ مَا رَأَیْت فِی مَنَامِی أَنْ یُصِیبَنِی مِنْہُ شَیْئٌ أَکْرَہُہُ فِی الدُّنْیَا وَالآخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 31168","","","كتاب الرؤيا"
"31169","(۳۱۱۶۹) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ ، قَالَ : حدَّثَنَا بُکَیْر بْنُ أَبِی السُّمَیْطِ ، قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ سِیرِینَ وَسُئِلَ عَنْ رَجُلٍ رَأَی فِی الْمَنَامِ کَأَنَّ مَعَہُ سَیْفًا مُخْتَرِطَۃً ، فَقَالَ : وَلَدٌ ذَکَرٌ ، قَالَ : انْدَقَّ السَّیْفُ ، قَالَ : یَمُوتُ۔n قَالَ : وَسُئِلَ ابْنُ سِیرِینَ عَنِ الْحِجَارَۃِ فِی النَّوْمِ ، فَقَالَ : قَسْوَۃٌ۔n وَسُئِلَ عَنِ الْخَشَبِ فِی النَّوْمِ ، فَقَالَ : نِفَاقٌ۔","","Musannaf Ibn Abi Shaybah 31169","","","كتاب الرؤيا"
"31170","(۳۱۱۷۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : سُئِلَ عَنْ رَجُلٍ رَأَی ضَوْئًا فِی جَوْفِ اللَّیْلِ ، فَقَالَ : لَوْ کَانَ ہَذَا خَیْرًا نَظَرَ إِلَیْہِ أَصْحَابُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 31170","","","كتاب الرؤيا"
"31171","(۳۱۱۷۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، قَالَ : قَالَ صِلَۃُ بْنُ أَشْیَمَ : رَأَیْت فِی النَّوْمِ کَأَنِّی فِی رَہْطٍ ، وَکَانَ رَجُلٌ خَلْفِی مَعَہُ السَّیْفُ شَاہِرُہُ ، قَالَ : کُلَّمَا أَتَی عَلَی أَحَدٍ مِنَّا ضَرَبَ رَأْسَہُ فَوَقَعَ ، ثُمَّ یَقْعُدُ فَیَعُودُ کَمَا کَانَ ، قَالَ : فَجَعَلْتُ أَنْظُرُ مَتَی یَأْتِی عَلَیَّ فَیَصْنَعُ بِی ذَاکَ ، قَالَ : فَأَتَی عَلَیَّ فَضَرَبَ رَأْسِی فَوَقَعَ فَکَأَنِّی أَنْظُرُ إلَی رَأْسِی حِینَ أَخَذْتہ أَنْفُضُ عَنْ شَفَتَیَّ التُّرَابَ ، ثُمَّ أَخَذْتہ فَأَعَدْتہ کَمَا کَانَ۔","","Musannaf Ibn Abi Shaybah 31171","","","كتاب الرؤيا"
"31172","(۳۱۱۷۲) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا سُلَیْمَانُ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، قَالَ : قَالَ صِلَۃُ : رَأَیْت أَبَا رِفَاعَۃَ بَعْدَ مَا أُصِیبَ فِی النَّوْمِ عَلَی نَاقَۃٍ سَرِیعَۃٍ ، وَأَنَا عَلَی جَمَلٍ ثَفَالَ قَطُوفٍ ، وَأَنَا آخِذ عَلَی أَثَرِہِ ، قَالَ : فَیُعَوِّجُہَا عَلَی، فَأَقُولُ : الآنَ أُسْمِعُہُ الصَّوْتَ ، فَسَرَّحہَا ، وَأَنَا أَتْبَعُ أَثَرَہُ ، قَالَ : فَأَوَّلْت رُؤْیَایَ آخُذُ طَرِیقَ أَبِی رِفَاعَۃَ وَأَنَا أُکُدُّ الْعَمَلَ بَعْدَہُ کَدًّا۔ (حاکم ۴۳۲)","","Musannaf Ibn Abi Shaybah 31172","","","كتاب الرؤيا"
"31173","(۳۱۱۷۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ : أَنَّ أَبَا ثَامِرٍ رَأَی فِیمَا یَرَی النَّائِمُ : وَیْلٌ لِلْمُتَسَمِّنَاتِ مِنْ فَتَرَۃٍ فِی الْعِظَامِ یَوْمَ الْقِیَامَۃِ۔","","Musannaf Ibn Abi Shaybah 31173","","","كتاب الرؤيا"
"31174","(۳۱۱۷۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، قَالَ : قَالَ عَبْدُ الْمَلِکِ : دَخَلَ شَقِیقٌ عَلَی الْحَجَّاجِ فَقَالَ : مَا اسْمُک ؟ قَالَ : مَا بَعَثَ إلَیَّ الأَمِیرُ حَتَّی عَلِمَ اسْمِی ، قَالَ : أُرِیدُ أَنْ أَسْتَعِینَ بِکَ عَلَی بَعْضِ عَمَلِی ، قَالَ : فَقَالَ : أَمَا إنِّی أَخَافُ عَلَیْکَ نَفْسِی ، فَاسْتَعْفَاہُ فَأَعْفَاہُ ، قَالَ : فَلَمَّا خَرَجَ مِنْ عِنْدِہِ قَامَ وَہُوَ یَقُولُ : ہَکَذَا یَتَعَاشی ، قَالَ : فَقَالَ الْحَجَّاجُ : سَدِّدُوا الشَّیْخَ ، سَدِّدُوا الشَّیْخَ۔","","Musannaf Ibn Abi Shaybah 31174","","","كتاب الأمراء"
"31175","(۳۱۱۷۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنِ ابْنِ أَبْجَرَ ، قَالَ : بَعَثَ ابْنُ أَوْسَطَ بِالشَّعْبِیِّ إلَی الْحَجَّاجِ وَکَانَ عَامِلاً عَلَی الرَّیِّ ، قَالَ : فَأُدْخِلَ عَلَی ابْنِ أَبِی مُسْلِمٍ وَکَانَ الَّذِی بَیْنَہُ وَبَیْنَہُ لَطِیفًا ، قَالَ : فَعَذَلَہُ ابْنُ أَبِی مُسْلِمٍ ، وَقَالَ : إنِّی مُدْخِلُک عَلَی الأَمِیرِ فَإِنْ ضَحِکَ فِی وَجْہِکَ فَلاَ تَضْحَکَنَّ ، قَالَ : فَأُدْخِلَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 31175","","","كتاب الأمراء"
"31176","(۳۱۱۷۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ شَیْخٍ مِنَ النَّخَعِ ، عَنْ جَدَّتِہ ، قَالَتْ : کَانَ سَعِیدُ بْنُ جُبَیْرٍ مُسْتَخْفٍ عِنْدَ أَبِیک زَمَنَ الْحَجَّاجِ فَأَخْرَجَہُ أَبُوک فِی صُنْدُوقٍ إلَی مَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 31176","","","كتاب الأمراء"
"31177","(۳۱۱۷۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : قَالَ الْوَلِیدُ بْنُ عُقْبَۃَ وَہُوَ یَخْطُبُ : یَا أَہْلَ الْکُوفَۃِ ، أَعْزِمُ عَلَی مَنْ سَمَّانِی أَشْعَرَ بَرَکاً لَمَا قَامَ ، فَتَحَرَّجَ عَدِیٌّ مِنْ عَزْمَتِہِ ، فَقَامَ ، فَقَالَ لَہُ : إِنَّہُ لَذُو نَدبَۃ الَّذِی یَقُومُ فَیَقُولُ : أَنَا الَّذِی سَمَّیْتُک ، قَالَ ابْنُ عَوْنٍ : وَکَانَ ہُوَ الَّذِی سَمَّاہُ۔","","Musannaf Ibn Abi Shaybah 31177","","","كتاب الأمراء"
"31178","(۳۱۱۷۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبْجَرَ ، قَالَ : کَانُوا یَتَکَلَّمُونَ ، قَالَ : فَخَرَجَ عَلِیٌّ مَرَّۃً وَمَعَہُ عَقِیلٌ ، قَالَ : وَمَعَ عَقِیلٍ کَبْشٌ ، قَالَ : فَقَالَ عَلِیٌّ : عضَّ أَحَدُنَا بِذِکْرِہِ ، قَالَ : فَقَالَ عَقِیلٌ : أَمَّا أَنَا وَکَبْشِی فَلاَ۔","","Musannaf Ibn Abi Shaybah 31178","","","كتاب الأمراء"
"31179","(۳۱۱۷۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ مُجَمِّعٍ ، قَالَ : دَخَلَ عَبْدُ الرَّحْمَنِ بْنُ أَبِی لَیْلَی عَلَی الْحَجَّاجِ ، فَقَالَ لِجُلَسَائِہِ : إذَا أَرَدْتُمْ أَنْ تَنْظُرُوا إلَی رَجُلٍ یَسُبُّ أَمِیرَ الْمُؤْمِنِینَ عُثْمَانَ فَہَذَا عِنْدَکُمْ ، - یَعْنِی : عَبْدَ الرَّحْمَن - ، فَقَالَ عَبْدُ الرَّحْمَنِ : مَعَاذَ اللہِ أَیُّہَا الأَمِیرُ أَنْ أَکُونَ أَسُبُّ عُثْمَانَ ، أَنَّہُ لَیَحْجُزنِی عَنْ ذَلِکَ ثَلاث آیَاتٌ فِی کِتَابِ اللہِ ، قَالَ اللَّہُ : {لِلْفُقَرَائِ الْمُہَاجِرِینَ الَّذِینَ أُخْرِجُوا مِنْ دِیَارِہِمْ وَأَمْوَالِہِمْ یَبْتَغُونَ فَضْلاً مِنَ اللہِ وَرِضْوَانًا وَیَنْصُرُونَ اللَّہَ وَرَسُولَہُ أُولَئِکَ ہُمُ الصَّادِقُونَ} قَالَ : فَکَانَ عُثْمَان مِنْہُمْ ، قَالَ : ثُمَّ قَالَ : {وَالَّذِینَ تَبَوَّؤُوا الدَّارَ وَالإِیمَانَ مِنْ قَبْلِہِمْ} ، فَکَانَ أَبِی مِنْہُمْ : {وَالَّذِینَ جَاؤُوا مِنْ بَعْدِہِمْ یَقُولُونَ رَبَّنَا اغْفِرْ لَنَا وَلاِِخْوَانِنَا الَّذِینَ سَبَقُونَا بِالإِیمَانِ} فَکُنْت مِنْہُمْ ، قَالَ : صَدَقْت۔","","Musannaf Ibn Abi Shaybah 31179","","","كتاب الأمراء"
"31180","(۳۱۱۸۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی وَہْبٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : قَالَ لِی أَبُو جَعْفَرٍ مُحَمَّدُ بْنُ عَلِیٍّ: مِمَّنْ أَنْتَ ؟ قَالَ : قُلْتُ : مِنْ قَوْمٍ یُبْغِضُہُمُ النَّاسُ : مِنْ ثَقِیفٍ۔","","Musannaf Ibn Abi Shaybah 31180","","","كتاب الأمراء"
"31181","(۳۱۱۸۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی مُوسَی ، قَالَ : قَالَ الْمُغِیرَۃُ بْنُ شُعْبَۃَ لِعَلِیٍّ : اکْتُبْ إلَی ہَذَیْنِ الرَّجُلَیْنِ بِعَہْدِہِمَا إلَی الْکُوفَۃِ وَالْبَصْرَۃِ ، یَعْنِی الزُّبَیْرَ وَطَلْحَۃَ ، وَاکْتُبْ إلَی مُعَاوِیَۃَ بِعَہْدِہِ إلَی الشَّامِ فَإِنَّہُ سَیَرْضَی مِنْک بِذَلِکَ ، قَالَ : قَالَ عَلِیٌّ : لَمْ أَکُنْ لأُعْطِی الدَّنِیَّۃَ فِی دِینِی ، قَالَ : فَلَمَّا کَانَ بَعْدُ لَقِیَ الْمُغِیرَۃُ مُعَاوِیَۃَ ، فَقَالَ لَہُ مُعَاوِیَۃُ : أَنْتَ صَاحِبُ الْکَلِمَۃِ ؟ قَالَ : نَعَمْ ، قَالَ : أَمَ وَاللہِ مَا وَقَی شَرَّہَا إلاَّ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 31181","","","كتاب الأمراء"
"31182","(۳۱۱۸۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی مُوسَی ، قَالَ : کَتَبَ زِیَادٌ إلَی عَائِشَۃَ أُمِّ الْمُؤْمِنِینَ : مِنْ زِیَادِ بْنِ أَبِی سُفْیَانَ رَجَائَ أَنْ تَکْتُبَ إلَیْہِ : ابْنِ أَبِی سُفْیَانَ ، قَالَ فَکَتَبَت إلَیْہ : مِنْ عَائِشَۃَ أُمِّ الْمُؤْمِنِینَ إلَی زِیَادٍ ابْنِہَا۔","","Musannaf Ibn Abi Shaybah 31182","","","كتاب الأمراء"
"31183","(۳۱۱۸۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنِ الْوَلِیدِ بْنِ عَلِیٍّ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، قَالَ : مَا جَالَسْت فِی أَہْلِ بَیْتِہِ مِثْلَہُ : یَعْنِی : عَلِی بْن حُسَیْن۔","Hasan","Musannaf Ibn Abi Shaybah 31183","","","كتاب الأمراء"
"31184","(۳۱۱۸۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی مُوسَی ، قَالَ : قَالَ رَجُلٌ لِلْحَسَنِ : یَا أَبَا سَعِیدٍ وَاللہِ مَا أَرَاک تَلْحَنُ ، قَالَ : ابْنَ أَخِی قَدْ سَبَقْتُ اللَّحْنَ۔","","Musannaf Ibn Abi Shaybah 31184","","","كتاب الأمراء"
"31185","(۳۱۱۸۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَصْبَہَانِیِّ ، قَالَ: حدَّثَنِی عَبْدُ اللہِ بْنُ شَدَّادٍ، قَالَ : قَالَ لِی ابْنُ عَبَّاسٍ : أَلاَ أُعجِّبُک ! قَالَ : إنِّی یَوْمًا فِی الْمَنْزِلِ وَقَدْ أَخَذْت مَضْجِعِی لِلْقَائِلَۃِ إذْ قِیلَ : رَجُلٌ بِالْبَابِ ، قَالَ : قُلْتُ : مَا جَائَ ہَذَا ہَذِہِ السَّاعَۃَ إلاَّ لِحَاجَۃٍ ، أَدْخِلُوہُ ، قَالَ : فَدَخَلَ ، قَالَ : قُلْتُ : لَک حَاجَۃٌ ؟ قَالَ : مَتَی یُبْعَث ذَلِکَ الرَّجُلُ ؟ قُلْتُ : أَیُّ رَجُلٍ ؟ قَالَ : عَلِیٌّ ، قَالَ : قُلْتُ : لاَ یُبْعَثُ حَتَّی یَبْعَثَ اللَّہُ مَنْ فِی الْقُبُورِ! قَالَ : فَقَالَ : تَقُولُ مَا یَقُولُ ہَؤُلاَئِ الْحَمْقَی ! قَالَ : قُلْتُ : أَخْرِجُوا ہَذَا عَنِّی۔","Sahih","Musannaf Ibn Abi Shaybah 31185","","","كتاب الأمراء"
"31186","(۳۱۱۸۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبْجَرَ ، قَالَ : انتہی الشعبی إلی رجلین وہما یغتابانہ ویقعان فیہ ، فقال :nہَنِیئًا مَرِیئًا غَیْرَ دَائِ مُخَامِرٍ لِعَزَّۃَ مِنْ أَعْرَاضِنَا مَا اسْتَحَلَّتِ","","Musannaf Ibn Abi Shaybah 31186","","","كتاب الأمراء"
"31187","(۳۱۱۸۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبْجَرَ ، قَالَ : لَمَّا دَخَلَ سَعِیدُ بْنُ جُبَیْرٍ عَلَی الْحَجَّاجِ ، قَالَ: أَنْتَ الشَّقِیُّ بْنُ کُسَیْرٍ ، قَالَ : لاَ ، أَنَا سَعِیدُ بْنُ جُبَیْرٍ ، قَالَ : إنِّی قَاتِلُک ، قَالَ : لَئِنْ قَتَلْتَنِی ، لَقَدْ أَصَابَتْ أُمِّی اسْمِی۔","","Musannaf Ibn Abi Shaybah 31187","","","كتاب الأمراء"
"31188","(۳۱۱۸۸) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ ، قَالَ : قُلْتُ لِعَائِشَۃَ : إنَّ رَجُلاً مِنَ الطُّلَقَائِ یُبَایَعُ لَہُ - یَعْنِی : مُعَاوِیَۃَ - ، قَالَتْ : یَا بُنَیَّ لاَ تَعْجَبْ ، ہُوَ مُلْکُ اللہِ یُؤْتِیہ مَنْ یَشَائُ۔","","Musannaf Ibn Abi Shaybah 31188","","","كتاب الأمراء"
"31189","(۳۱۱۸۹) حَدَّثَنَا عَبِیدُ اللہِ ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ حَارِثَۃَ ، عَنِ الْوَلِیدِ بْنِ عُقْبَۃَ : أَنَّہُ قَالَ : لَمْ تَکُنْ نُبُوَّۃٌ إلاَّ کَانَ بَعْدَہَا مُلْکٌ۔","","Musannaf Ibn Abi Shaybah 31189","","","كتاب الأمراء"
"31190","(۳۱۱۹۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ : أَنَّ رَجُلاً مِنْ قُرَیْشٍ یُقَالَ لَہُ : ثُمَامَۃُ کَانَ عَلَی صَنْعَائَ ، فَلَمَّا جَائَہ قَتْلُ عُثْمَانَ بَکَی فَأَطَالَ الْبُکَائَ ، فَلَمَّا أَفَاقَ قَالَ : الْیَوْمُ اُنْتُزِعَتِ النُّبُوَّۃُ - أوَخِلاَفَۃُ النُّبُوَّۃِ - مِنْ أُمَّۃِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَصَارَتْ مُلْکًا وَجَبْرِیَّۃً ، مَنْ غَلَبَ عَلَی شَیْئٍ أَکَلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31190","","","كتاب الأمراء"
"31191","(۳۱۱۹۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : قَالَ لِی الْحَسَنُ : أَلاَ تَعْجَبُ مِنْ سَعِیدِ بْنِ جُبَیْرٍ! دَخَلَ عَلَیَّ فَسَأَلَنِی عَنْ قِتَالِ الْحَجَّاجِ وَمَعَہُ بَعْضُ الرُّؤَسَائِ ، یَعْنِی : أَصْحَابَ ابْنِ الأَشْعَثِ۔","","Musannaf Ibn Abi Shaybah 31191","","","كتاب الأمراء"
"31192","(۳۱۱۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ قَیْسٍ ، قَالَ : سَمِعْتُ مُعَاوِیَۃَ فِی مَرَضِہِ الَّذِی مَاتَ فِیہِ حَسَرَ عَنْ ذِرَاعَیْہِ کَأَنَّہُمَا عَسِیبَا نَخْلٍ وَہُوَ یَقُولُ : وَاللہِ لَوَدِدْت أَنِّی لاَ أَغْبرَ فِیکُمْ فَوْقَ ثَلاَثٍ ، فَقَالُوا : إلَی رَحْمَۃِ اللہِ وَمَغْفِرَتِہِ ، فَقَالَ : مَا شَائَ اللَّہُ أَنْ یَفْعَلَ وَلَوْ کَرِہَ أَمْرًا غَیْرَہُ۔n وَزَادَ فِیہِ ابْنُ بِشْرٍ : ہَلِ الدُّنْیَا إلاَّ مَا عَرَفْنَا وَجَرَّبْنَا؟!","Sahih","Musannaf Ibn Abi Shaybah 31192","","","كتاب الأمراء"
"31193","(۳۱۱۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ قَیْسٍ ، قَالَ : حَدَّثَنِی قَیْسُ بْنُ رُمَّانَۃَ ، عَنْ أَبِی بُرْدَۃَ ، قَالَ : قَالَ مُعَاوِیَۃُ : مَا قَاتَلْت عَلِیًّا إلاَّ فِی أَمْرِ عُثْمَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 31193","","","كتاب الأمراء"
"31194","(۳۱۱۹۴) حَدَّثَنَا حَفْصٌ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : دَخَلَ شَابٌّ مِنْ قُرَیْشٍ عَلَی مُعَاوِیَۃَ فَأَغْلَظَ لَہُ ، فَقَالَ لَہُ : یَا ابْنَ أَخِی ، أَنْہَاک عَنِ السُّلْطَانِ ، إنَّ السُّلْطَانَ یَغْضَبُ غَضَبَ الصَّبِیِّ وَیَأْخُذُ أَخْذَ الأَسَدِ۔","Da'if","Musannaf Ibn Abi Shaybah 31194","","","كتاب الأمراء"
"31195","(۳۱۱۹۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ زِیَادٌ : مَا غَلَبَنِی أَمِیرُ الْمُؤْمِنِینَ بِشَیْئٍ مِنَ السِّیَاسَۃِ إلاَّ بِبَابٍ وَاحِدٍ ، اسْتَعْمَلْت فُلاَنًا فَکَسرَ خَرَاجُہُ فَخَشِیَ أَنْ أُعَاقِبَہُ ، فَفَرَّ إلَی أَمِیرُ الْمُؤْمِنِینَ فَکَتَبَ إلَیْہِ : إنَّ ہَذَا أَدَبُ سُوئٍ لِمَنْ قِبَلِی ، فَکَتَبَ إلَیَّ : أَنَّہُ لَیْسَ یَنْبَغِی لِی وَلاَ لَک أَنْ نَسُوسَ النَّاسَ سِیَاسَۃً وَاحِدَۃً ، أَنْ نَلِینَ جَمِیعًا فَیَمْرَجَ النَّاسُ فِی الْمَعْصِیَۃِ ، وَلاَ أَنْ نَشْتَدَّ جَمِیعًا فَنَحْمِلَ النَّاسَ عَلَی الْمَہَالِکَ ، وَلَکِنْ تَکُونُ لِلشِّدَّۃِ وَالْفَظَاظَۃِ وَالْغِلْظَۃ ، وَأَکُونُ لِلِّینِ وَالرَّأْفَۃِ وَالرَّحْمَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 31195","","","كتاب الأمراء"
"31196","(۳۱۱۹۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : أَخْبَرَنَا مُجَالِدٌ ، قَالَ : أَخْبَرَنَا عَامِرٌ ، قَالَ : سَمِعْتُ مُعَاوِیَۃَ یَقُولُ : مَا تَفَرَّقَتْ أُمَّۃٌ قَطُّ إلاَّ ظَہَرَ أَہْلُ الْبَاطِلِ عَلَی أَہْلِ الْحَقِّ إلاَّ ہَذِہِ الأُمَّۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 31196","","","كتاب الأمراء"
"31197","(۳۱۱۹۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ سَعِیدِ بْنِ سُوَیْد ، قَالَ : صَلَّی بِنَا مُعَاوِیَۃُ الْجُمُعَۃَ بِالنُّخَیلَۃِ فِی الضُّحَی ، ثُمَّ خَطَبْنَا فَقَالَ : مَا قَاتَلْتُکُمْ لِتُصَلُّوا وَلاَ لِتَصُومُوا وَلاَ لِتَحُجُّوا وَلاَ لِتُزَکُّوا ، وَقَدْ أَعْرِفُ أَنَّکُمْ تَفْعَلُونَ ذَلِکَ، وَلَکِنْ إنَّمَا قَاتَلْتُکُمْ لأَتَأَمَّرَ عَلَیْکُمْ، فَقَدْ أَعْطَانِی اللَّہُ ذَلِکَ وَأَنْتُمْ کَارِہُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 31197","","","كتاب الأمراء"
"31198","(۳۱۱۹۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ حَبِیبٍ ، عَنْ ہُزَیْلَ بْنِ شُرَحْبِیلَ ، قَالَ : خَطَبَہُمْ مُعَاوِیَۃُ ، فَقَالَ : أَیُّہَا النَّاسُ ! إنَّکُمْ جِئْتُمْ فَبَایَعْتُمُونِی طَائِعِینَ ، وَلَوْ بَایَعْتُمْ عَبْدًا حَبَشِیًّا مُجَدَّعًا لَجِئْت حَتَّی أُبَایِعَہُ مَعَکُمْ ، قَالَ : فَلَمَّا نَزَلَ عَنِ الْمِنْبَرِ قَالَ لَہُ عَمْرُو بْنُ الْعَاصِ : تَدْرِی أَیَّ شَیْئٍ جِئْت بِہِ الْیَوْمَ ؟! زَعَمْت أَنَّ النَّاسَ بَایَعُوک طَائِعِینَ ، وَلَوْ بَایَعُوا عَبْدًا حَبَشِیًّا مُجَدَّعًا لَجِئْت حَتَّی تُبَایِعَہُ مَعَہُمْ ، قَالَ : فَقَامَ مُعَاوِیَۃُ إلَی الْمِنْبَرِ ، فَقَالَ : أَیُّہَا النَّاسُ ! وَہَلْ کَانَ أَحَدٌ أَحَقَّ بِہَذَا الأَمْرِ مِنِّی؟۔","Sahih","Musannaf Ibn Abi Shaybah 31198","","","كتاب الأمراء"
"31199","(۳۱۱۹۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ مُعَاوِیَۃُ : لاَ حِلْمَ إلاَّ التَّجَارِبُ۔","Sahih","Musannaf Ibn Abi Shaybah 31199","","","كتاب الأمراء"
"31200","(۳۱۲۰۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حُسَیْنِ بْنِ وَاقِدٍ ، قَالَ : حدَّثَنِی عَبْدُ اللہِ بْنُ بُرَیْدَۃَ : أَنَّ حُسَیْنَ بْنَ عَلِیٍّ دَخَلَ عَلَی مُعَاوِیَۃَ، فَقَالَ: لأَجِیزَنَّکَ بِجَائِزَۃٍ لَمْ أُجِزْ بِہَا أَحَدًا قَبْلَک، وَلاَ أُجِیزُ بِہَا أَحَدًا بَعْدَکَ مِنَ الْعَرَبِ، فَأَجَازَہُ بِأَرْبَعِمِئَۃِ أَلْفٍ ، فَقَبِلَہَا۔","Hasan","Musannaf Ibn Abi Shaybah 31200","","","كتاب الأمراء"
"31201","(۳۱۲۰۱) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ، عَنْ حُسَیْنِ بْنِ وَاقِدٍ، قَالَ: حدَّثَنَا عَبْدُ اللہِ بْنُ بُرَیْدَۃَ، قَالَ: دَخَلْت أَنَا وَأَبِی عَلَی مُعَاوِیَۃَ فَأَجْلَسَ أَبِی عَلَی السَّرِیرِ وَأُتِیَ بِالطَّعَامِ فَطَعِمنَا وَأَتَی بِشَرَابٍ فَشَرِبَ، فَقَالَ مُعَاوِیَۃُ: مَا شَیْئٌ کُنْت أَسْتَلِذُّہُ وَأَنَا شَابٌّ فَآخُذُہُ الْیَوْمَ إلاَّ اللَّبَنَ ، فَإِنِّی آخُذُہُ کَمَا کُنْت آخُذُہُ قَبْلَ الْیَوْمِ ، وَالْحَدِیثَ الْحَسَنَ۔","Hasan","Musannaf Ibn Abi Shaybah 31201","","","كتاب الأمراء"
"31202","(۳۱۲۰۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا أَبُو مُحَلِّمٍ الْہَمْدَانِیُّ ، عَنْ عَامِرٍ ، قَالَ : أَتَی رَجُلٌ مُعَاوِیَۃَ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، عِدَتَکَ الَّتِی وَعَدْتنِی ، قَالَ : وَمَا وَعَدْتُک ؟ قَالَ : أَنْ تَزِیدَنِی مِئَۃ فِی عَطَائِی ، قَالَ : مَا فَعَلْت ، قَالَ : بَلَی ، قَالَ : مَنْ یَعْلَمُ ذَلِکَ ؟ قَالَ الأَسْوَدُ ، أَو ابْنُ الأَسْوَدِ ، قَالَ : مَا یَقُولُ ہَذَا یَا ابْنَ الأَسْوَدِ؟ قَالَ : نَعَمْ قَدْ زِدْتہ ، فَأَمَرَ لَہُ بِہَا ، ثُمَّ إنَّ مُعَاوِیَۃَ ضَرَبَ بِیَدَیْہِ إحْدَاہُمَا عَلَی الأُخْرَی ، فَقَالَ : مَا بِی مِئَۃٌ زِدْتہَا رَجُلاً وَلَکِنْ بِی غَفْلتی أَنْ أَزِیدَ رَجُلاً مِنَ الْمُہَاجِرِینَ مِئَۃ ، ثُمَّ أَنْسَاہَا ، فَقَالَ لَہُ ابْنُ الأَسْوَدِ : یَا أَمِیرَ الْمُؤْمِنِینَ ! فَہُوَ آمِن عَلَیْہَا ؟ قَالَ : نَعَمْ ، قَالَ : فَوَاللہِ مَا زِدْتہ شَیْئًا وَلَکِنَّہُ لاَ یَدْعُونِی رَجُلٌ إلَی خَیْرٍ یُصِیبُہُ مِنْ ذِی سُلْطَانٍ إلاَّ شَہِدْت لَہُ بِہِ ، وَلاَ شَرٍّ أَصْرِفُہُ عَنْہُ مِنْ ذِی سُلْطَانٍ إلاَّ شَہِدْت لَہُ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31202","","","كتاب الأمراء"
"31203","(۳۱۲۰۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنِی الْوَلِیدُ بْنُ کَثِیرٍ ، عَنْ وَہْبِ بْن کَیْسَانَ ، قَالَ : سَمِعْتُ جَابِرَ بْنِ عَبْدِ اللہِ یَقُولُ : لَمَّا کَانَ عَامُ الْجَمَاعَۃِ بَعَثَ مُعَاوِیَۃُ إلَی الْمَدِینَۃِ بُسْرَ بْنَ أَرْطَاۃَ لِیُبَایِعَ أَہْلَہَا عَلَی رَایَاتِہِمْ وَقَبَائِلِہِمْ فَلَمَّا کَانَ یَوْمَ جَائَتْہُ الأَنْصَارُ ، جَائَتْہُ بَنُو سَلِمۃ ، قَالَ : أَفِیہِمْ جَابِرٌ ؟ قَالُوا : لاَ ، قَالَ : فَلْیَرْجِعُوا فَإِنِّی لَسْتُ مُبَایِعَہُمْ حَتَّی یَحْضُرَ جَابِرٌ ، قَالَ : فَأَتَانِی ، فَقَالَ : نَاشَدْتُک اللَّہَ إلاَّ مَا انْطَلَقْت مَعَنا فَبَایَعْت فَحَقَنْت دَمَک وَدِمَائَ قَوْمِکَ ، فَإِنَّک إنْ لَمْ تَفْعَلْ قُتِلَتْ مُقَاتِلَتُنَا وَسُبِیَتْ ذَرَارِیّنَا ، قَالَ : فَأَسْتَنْظَرْتہُمْ إلَی اللَّیْلِ ، فَلَمَّا أَمْسَیْت دَخَلْتُ عَلَی أُمِّ سَلَمَۃَ زَوْجِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَخْبَرْتہَا الْخَبَرَ فَقَالَتْ : یَا ابْنَ أَخِی ، انْطَلِقْ فَبَایِعْ وَاحْقِنْ دَمَک وَدِمَائَ قَوْمِکَ ، فَإِنِّی قَدْ أَمَرْت ابْنَ أَخِی یَذْہَبُ فَیُبَایِعُ۔","Sahih","Musannaf Ibn Abi Shaybah 31203","","","كتاب الأمراء"
"31204","(۳۱۲۰۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ وَہْبِ بْنِ کَیْسَانَ ، قَالَ : کَتَبَ رَجُلٌ مِنْ أَہْلِ الْعِرَاقِ إلَی ابْنِ الزُّبَیْرِ حِینَ بُویِعَ : سَلاَمٌ عَلَیْک فَإِنِّی أَحْمَدُ إلَیْک اللَّہَ الَّذِی لاَ إلَہَ إلاَّ ہُوَ ، أَمَّا بَعْدُ : فَإِنَّ لأَہْلِ طَاعَۃِ اللہِ وَلأَہْلِ الْخَیْرِ عَلاَمَۃٌ یُعْرَفُونَ بِہَا وَتُعْرَفُ فِیہِمْ : مِنَ الأَمْرِ بِالْمَعْرُوفِ وَالنَّہْیِ عَنِ الْمُنْکَرِ وَالْعَمَلِ بِطَاعَۃِ اللہِ ، وَاعْلَمْ أَنَّمَا مَثَلُ الإِمَامِ مَثَلُ السُّوقِ : یَأْتِیہ مَا کَانَ فِیہِ ، فَإِنْ کَانَ بَرًّا جَائَ ہُ أَہْلُ الْبِرِّ بِبِرِّہِمْ ، وَإِنْ کَانَ فَاجِرًا جَائَ ہُ أَہْلُ الْفُجُورِ بِفُجُورِہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 31204","","","كتاب الأمراء"
"31205","(۳۱۲۰۵) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ وَہْبٍ ، قَالَ : کُنْتُ عِنْدَ عَبْدِ اللہِ بْنِ الزُّبَیْرِ فَقِیلَ لَہُ : إنَّ الْمُخْتَارَ یَزْعُمُ أَنَّہُ یُوحَی إلَیْہِ ، فَقَالَ : صَدَقَ ، ثُمَّ تَلاَ {ہَلْ أُنَبِّئُکُمْ عَلَی مَنْ تَنَزَّلُ الشَّیَاطِینُ تَنَزَّلُ عَلَی کُلِّ أَفَّاکٍ أَثِیمٍ}۔","","Musannaf Ibn Abi Shaybah 31205","","","كتاب الأمراء"
"31206","(۳۱۲۰۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ زَائِدَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شِمْرٍ ، عَنْ أَنَسٍ ، قَالَ : إِنَّہَا سَتَکُونُ مُلُوکٌ ، ثُمَّ الْجَبَابِرَۃُ ، ثُمَّ الطَّوَاغِیتُ۔","","Musannaf Ibn Abi Shaybah 31206","","","كتاب الأمراء"
"31207","(۳۱۲۰۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ لَیْثٍ ، عَنْ أَبِی نَضرَۃَ ، قَالَ : کُنَّا نُحَدَّثُ أَنَّ بَنِی فُلاَنٍ یُصِیبُہُمْ قَتْلٌ شَدِیدٌ ، فَإِذَا کَانَ ذَلِکَ ہَرَبَ مِنْہُمْ أَرْبَعَۃُ رَہْطٍ إلَی الرُّومِ ، فَجَلَبُوا الرُّومَ عَلَی الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 31207","","","كتاب الأمراء"
"31208","(۳۱۲۰۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُمَرَ بْنِ حَمْزَۃَ ، قَالَ : خَبَّرَنِی سَالِمٌ ، قَالَ : لَمَّا أَرَادُوا أَنْ یُبَایِعُوا لِیَزِیدَ بْنَ مُعَاوِیَۃَ ، قَامَ مَرْوَانُ فَقَالَ : سُنَّۃُ أَبِی بَکْرٍ الرَّاشِدَۃُ الْمَہْدِیَّۃُ فَقَامَ عَبْدُ الرَّحْمَنِ بْنُ أَبِی بَکْرٍ ، فَقَالَ : لَیْسَ بِسُنَّۃِ أَبِی بَکْرٍ وَقَدْ تَرَکَ أَبُو بَکْرٍ الأَہْلَ وَالْعَشِیرَۃَ وَالأَصْلَ ، وَعَمَدَ إلَی رَجُلٍ مِنْ بَنِی عَدِیِّ بْنِ کَعْبٍ أَنْ رَأَی أَنَّہُ لِذَلِکَ أَہْلٌ ، فَبَایَعَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 31208","","","كتاب الأمراء"
"31209","(۳۱۲۰۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْمُجَالِدِ ، عَنْ عَامِرٍ ، قَالَ : قَالَ مُحَمَّدُ بْنُ الأَشْعَثِ : إنَّ لِکُلِّ شَیْئٍ دَوْلَۃً ، حَتَّی إِنَّ لِلْحُمْقِ عَلَی الْحِلْمِ دَوْلَۃً۔","","Musannaf Ibn Abi Shaybah 31209","","","كتاب الأمراء"
"31210","(۳۱۲۱۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُمَرَ بْنِ حَمْزَۃَ ، قَالَ : أَخْبَرَنِی سَالِمٌ ، عَنْ أَبِیہِ : أَنَّ عُمَرَ لَمَّا نَزَعَ شُرَحْبِیلَ بْنَ حَسَنَۃَ ، قَالَ : یَا عُمَرُ عَنْ سَخْطَۃٍ نَزَعَتْنِی ؟ قَالَ : لاَ ، وَلَکِنَّا رَأَیْنَا مَنْ ہُوَ أَقْوَی مِنْک فَتَحَرَّجْنَا مِنَ اللہِ أَنْ نَتْرُککَ وَقَدْ رَأَیْنَا مَنْ ہُوَ أَقْوَی مِنْک ، فَقَالَ لَہُ شُرَحْبِیلُ : فَأَعْذِرْنِی فَقَامَ عُمَرُ عَلَی الْمِنْبَرِ ، فَقَالَ : کُنَّا اسْتَعْمَلْنَا شُرَحْبِیلَ بْنَ حَسَنَۃَ ، ثُمَّ نَزَعْنَاہُ مِنْ غَیْرِ سَخْطَۃٍ وَجَدْتہَا عَلَیْہِ ، وَلَکِنْ رَأَیْنَا مَنْ ہُوَ أَقْوَی مِنْہُ ، فَتَحَرَّجْنَا مِنَ اللہِ أَنْ نُقِرَّہُ وَقَدْ رَأَیْنَا مَنْ ہُوَ أَقْوَی مِنْہُ ، فَنَظَرَ عُمَرُ مِنَ الْعَشِیِّ إلَی النَّاسِ وَہُمْ یَلُوذُونَ بِالْعَامِلِ الَّذِی اُسْتُعْمِلَ ، وَشُرَحْبِیلُ مُحْتَبٍ وَحْدَہُ ، فَقَالَ عُمَرُ : أَمَّا الدُّنْیَا فَإِنَّہَا لَکَاعٌ۔","Da'if","Musannaf Ibn Abi Shaybah 31210","","","كتاب الأمراء"
"31211","(۳۱۲۱۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُمَرَ بْنِ حَمْزَۃَ ، عَنْ مُحَمَّدٍ الْکَاتِبِ : أَنَّ عُمَرَ کَانَ یَقُولُ : لاَ یُصْلِحُ ہَذَا الأَمْرَ إلاَّ شِدَّۃٌ فِی غَیْرِ تَجَبُّرٍ ، وَلِینٌ فِی غَیْرِ وَہَنٍ۔","Da'if","Musannaf Ibn Abi Shaybah 31211","","","كتاب الأمراء"
"31212","(۳۱۲۱۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عُمَرَ بْنِ عَلِیٍّ ، قَالَ : حدَّثَنِی أَبِی ، قَالَ : قَالَ عَلِیٌّ : وَالَّذِی فَلَقَ الْحَبَّۃَ وَبَرَأَ النَّسْمَۃَ ، لإزَالَۃُ الْجِبَالِ مِنْ مَکَانِہَا أَہْوَنُ مِنْ إزَالَۃِ مَلِکٍ مُؤَجَّلٍ۔","","Musannaf Ibn Abi Shaybah 31212","","","كتاب الأمراء"
"31213","(۳۱۲۱۳) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِالْحَمِیدِ، عَنْ مُغِیرَۃَ، عَنْ سِمَاکِ بْنِ سَلَمَۃَ، عَنْ عَبْدِالرَّحْمَنِ بْنِ عصمۃ، قَالَ: کُنْتُ عِنْدَ عَائِشَۃَ فَأَتَاہَا رَسُولٌ مِنْ مُعَاوِیَۃَ بِہَدِیَّۃٍ ، فَقَالَ : أَرْسَلَ بِہَذَا أَمِیرُ الْمُؤْمِنِینَ ، فَقَبِلَتْ ہَدِیَّتَہُ ، فَلَمَّا خَرَجَ الرَّسُولُ قُلْنَا : یَا أُمَّ الْمُؤْمِنِینَ أَلَسْنَا مُؤْمِنِینَ وَہُوَ أَمِیرُنَا ؟ قَالَتْ : أَنْتُمْ إنْ شَائَ اللَّہُ الْمُؤْمِنُونَ ، وَہُوَ أَمِیرُکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 31213","","","كتاب الأمراء"
"31214","(۳۱۲۱۴) حَدَّثَنَا جَرِیرُ ، عَنِ الْمُغِیرَۃِ ، عَنْ عُثْمَانَ بْنِ یَسَارٍ ، عَنْ تَمِیمِ بْنِ حَذْلَمٍ ، قَالَ : إنَّ أَوَّلَ یَوْمٍ سُلِّمَ عَلَیَّ أَمِیرٌ بِالْکُوفَۃِ بِالإِمْرَۃِ ، قَالَ : خَرَجَ الْمُغِیرَۃ بْن شُعْبَۃ مِنَ الْقَصْرِ ، فَعَرَضَ لَہُ رَجُلٌ مِنْ کِنْدَۃَ ، فَسَلَّمَ عَلَیْہِ بِالإِمْرَۃِ ، فَقَالَ : مَا ہَذَا ؟ مَا أَنَا إلاَّ رَجُلٌ مِنْہُمْ ، فَتُرِکَتْ زَمَانًا ، ثُمَّ أَقَرَّہَا بَعْدُ۔","Hasan","Musannaf Ibn Abi Shaybah 31214","","","كتاب الأمراء"
"31215","(۳۱۲۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، قَالَ : سَمِعْتُ جَابِرَ بْنَ عَبْدِ اللہِ یَقُولُ : دَخَلْتُ عَلَی الْحَجَّاجِ فَلَمْ أُسَلِّمْ عَلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31215","","","كتاب الأمراء"
"31216","(۳۱۲۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، قَالَ : بَلَغَ ابْنَ عُمَرَ أَنَّ یَزِیدَ بْنَ مُعَاوِیَۃَ بُویِعَ لَہُ ، قَالَ : إنْ کَانَ خَیْرًا رَضِینَا ، وَإِنْ کَانَ شَرًّا صَبَرْنَا۔","Sahih","Musannaf Ibn Abi Shaybah 31216","","","كتاب الأمراء"
"31217","(۳۱۲۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ ، عَنْ قَیْسٍ ، قَالَ : شَہِدْت عَبْدَ اللہِ بْنَ مَسْعُودٍ جَائَ یَتَقَاضَی سَعْدًا دَرَاہِمَ أَسْلَفَہَا إیَّاہُ مِنْ بَیْتِ الْمَالِ ، فَقَالَ : رُدَّ ہَذَا الْمَالَ ، فَقَالَ سَعْدُ : أَظُنُّک لاَقِیًا شَرًّا ، قَالَ : رُدَّ ہَذَا الْمَالَ ، قَالَ : فَقَالَ سَعْدُ : ہَلْ أَنْتَ ابْنُ مَسْعُودٍ إلاَّ عَبْدٌ مِنْ ہُذَیْلٍ ؟ قَالَ : فَقَالَ عَبْدُ اللہِ : ہَلْ أَنْتَ إلاَّ ابْنُ حُمَیْنَۃَ ، قَالَ : فَقَالَ ابْنُ أَخِی سَعْدٌ : أَجَل ، أَنَّکُمَا لَصَاحِبَا رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْظُرُ النَّاسُ إلَیْکُمَا ! فَرَفَعَ سَعْدُ یَدَیْہِ یَقُولُ : اللَّہُمَّ رَبَّ السَّمَاوَاتِ وَالأَرْضِ ، فَقَالَ ابْنُ مَسْعُودٍ : وَیْحَک ، قُلْ قَوْلاً وَلاَ تَلْعَنْ ، قَالَ : فَقَالَ سَعْدٌ : أَمَ وَاللہِ أَنْ لَوْلاَ مَخَافَۃُ اللہِ لَدَعَوْت عَلَیْک دَعْوَۃً لاَ تُخْطِئُک ، قَالَ : فَانْصَرَفَ عَبْدُ اللہِ کَمَا ہُوَ۔","Sahih","Musannaf Ibn Abi Shaybah 31217","","","كتاب الأمراء"
"31218","(۳۱۲۱۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ ، عَنْ زِیَادٍ ، قَالَ : لَمَّا أَرَادَ عُثْمَان أَنْ یَجْلِدَ الْوَلِیدَ ، قَالَ لِطَلْحَۃَ : قُمْ فَاجْلِدْہُ ، قَالَ : إنِّی لَمْ أَکُنْ مِنَ الْجَلاَدِینَ ، فَقَامَ إلَیْہِ عَلِیٌّ فَجَلَدَہُ ، فَجَعَلَ الْوَلِیدُ یَقُولُ لِعَلِیٍّ : أَنَا صَاحِبُ مَکِینَۃٍ ، قَالَ : قُلْتُ لِزِیَادٍ : وَمَا صَاحِبُ مَکِینَۃٍ ؟ قَالَ : امْرَأَۃٌ کَانَ یَتَحَدَّثُ إِلَیْہَا۔","","Musannaf Ibn Abi Shaybah 31218","","","كتاب الأمراء"
"31219","(۳۱۲۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ ، قَالَ : کَانَ مَرْوَانُ مَعَ طَلْحَۃَ یَوْمَ الْجَمَلِ ، فَلَمَّا اشْتَبَکَت الْحَرْبُ ، قَالَ مَرْوَانُ : لاَ أَطْلُبُ بِثَأْرِی بَعْدَ الْیَوْمِ ، قَالَ : ثُمَّ رَمَاہُ بِسَہْمٍ فَأَصَابَ رُکْبَتَہُ ، فَمَا رَقَأَ الدَّمُ حَتَّی مَاتَ ، قَالَ : وَقَالَ طَلْحَۃُ : دَعُوہُ فَإِنَّہُ سَہْمٌ أَرْسَلَہُ اللَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31219","","","كتاب الأمراء"
"31220","(۳۱۲۲۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عُیَیْنَۃَ ، عَنْ أَبِیہِ ، قَالَ : لَقِیَ أَبُو بَکْرَۃَ الْمُغِیرَۃَ بْنَ شُعْبَۃَ یَوْمًا نِصْفَ النَّہَارِ وَہُوَ مُتَقَنِّعٌ ، فَقَالَ : أَیْنَ تُرِیدُ ؟ فَقَالَ : أُرِیدُ حَاجَۃً ، قَالَ : إنَّ الأَمِیرَ یُزَارُ ، وَلاَ یَزُورُ۔","Sahih","Musannaf Ibn Abi Shaybah 31220","","","كتاب الأمراء"
"31221","(۳۱۲۲۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : بَلَغَنِی أَنَّ الْمُغِیرَۃَ بْنَ شُعْبَۃَ وَلِیَ الْمَوْسِمَ ، فَبَلَغَہُ أَنْ أَمِیرًا یَقدَمُ عَلَیْہِ ، فَقَدِمَ یَوْمَ عَرَفَۃَ ، فَجَعَلَہُ یَوْمَ الأَضْحَی۔","","Musannaf Ibn Abi Shaybah 31221","","","كتاب الأمراء"
"31222","(۳۱۲۲۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ ، قَالَ : کَانَ قَیْسُ بْنُ سَعْد بْنُ عُبَادَۃَ مَعَ عَلِیٍّ عَلَی مُقَدِّمَتَہُ ، وَمَعَہُ خَمْسَۃُ آلاَفٍ قَدْ حَلَقُوا رُؤُوسَہُمْ بَعْدَ مَا مَاتَ عَلِیٌّ ، فَلَمَّا دَخَلَ الْحَسَنُ فِی بَیْعَۃِ مُعَاوِیَۃَ أَبَی قَیْسٌ أَنْ یَدْخُلَ ، فَقَالَ لأَصْحَابِہِ : مَا شِئْتُمْ ، إنْ شِئْتُمْ جَالَدْت بِکُمْ أَبَدًا حَتَّی یَمُوتَ الأَعْجَلُ ، وَإِنْ شِئْتُمْ أَخَذْت لَکُمْ أَمَانًا ، فَقَالُوا لَہُ : خُذْ لَنَا أَمَانًا ، فَأَخَذَ لَہُمْ أَنَّ لَہُمْ کَذَا وَکَذَا ، وَلاَ یُعَاقَبُوا بِشَیْئٍ وَإِنِّی رَجُلٌ مِنْہُمْ ، وَلَمْ یَأْخُذْ لِنَفْسِہِ خَاصّۃ شَیْئًا ، فَلَمَّا ارْتَحَل نَحْوَ الْمَدِینَۃِ وَمَضَی بِأَصْحَابِہِ جَعَلَ یَنْحَرُ لَہُمْ کُلَّ یَوْمٍ جَزُورًا حَتَّی بَلَغَ۔","Sahih","Musannaf Ibn Abi Shaybah 31222","","","كتاب الأمراء"
"31223","(۳۱۲۲۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی جَعْفَرٍ : أَنَّ عَلِیًّا بَلَغَہُ عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ شَیْئٌ ، فَقَالَ : لأَنْ أَخَذْتہ لأَتْبَعْتہُ أَحْجَارُہُ۔","","Musannaf Ibn Abi Shaybah 31223","","","كتاب الأمراء"
"31224","(۳۱۲۲۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی جَعْفَرٍ : أَنَّ فُلاَنًا شَہِدَ عِنْدَ عُمَرَ فَرَدَّ شَہَادَتَہُ۔","","Musannaf Ibn Abi Shaybah 31224","","","كتاب الأمراء"
"31225","(۳۱۲۲۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ، قَالَ : سَمِعْتُ أَبِی یُحَدِّثُ : أَنَّہُ سَمِعَ عَمْرَو بْنَ الْعَاصِ قَالَ : لَمَّا مَاتَ عَبْدُ الرَّحْمَنِ بْنُ عَوْف ، قَالَ : اذْہَبِ ابْنَ عَوْفٍ بِبَطْنَتک ، لَمْ تَتَغَضْغَضْ مِنْہَا بِشَیْئٍ۔n(ابن سعد ۱۳۶۔ طبرانی ۲۶۳)","Sahih","Musannaf Ibn Abi Shaybah 31225","","","كتاب الأمراء"
"31226","(۳۱۲۲۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : سَمِعَ ابْنُ سِیرِینَ رَجُلاً یَسُبُّ الْحَجَّاجَ ، فَقَالَ ابْنُ سِیرِینَ : إنَّ اللَّہَ حَکَمٌ عَدْلٌ ، یَأْخُذُ لِلْحَجَّاجِ مِمَّنْ ظَلَمَہُ ، کَمَا یَأْخُذُ لِمَنْ ظَلَمَہُ الْحَجَّاجُ۔","","Musannaf Ibn Abi Shaybah 31226","","","كتاب الأمراء"
"31227","(۳۱۲۲۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا سُفْیَانَ ، قَالَ : حَدَّثَنِی أَبُو الْجَحَّاف ، قَالَ : أَخْبَرَنِی مُعَاوِیَۃُ بْنُ ثَعْلَبَۃٍ ، قَالَ : أَتَیْتُ مُحَمَّدَ بْنَ الْحَنَفِیَّۃِ ، فَقُلْتُ : إنَّ رَسُولَ الْمُخْتَارِ أَتَانَا یَدْعُونَا ، قَالَ : فَقَالَ لِی : لاَ تُقَاتِلْ ، إنِّی لاَکْرَہُ أَنْ أَبْتَزَّ ہَذِہِ الأُمَّۃَ أَمْرَہَا ، أَوْ آتِیہَا مِنْ غَیْرِ وَجْہِہَا۔","","Musannaf Ibn Abi Shaybah 31227","","","كتاب الأمراء"
"31228","(۳۱۲۲۸) حَدَّثَنَا قَبِیصَۃُ ، عَنْ سُفْیَانَ ، عَنِ الْحَارِثِ الأَزْدِیِّ ، قَالَ : قَالَ ابْنُ الْحَنَفِیَّۃِ : رَحِمَ اللَّہُ امْرَئًا أَغْنَی نَفْسَہُ وَکَفَّ یَدَہُ ، وَأَمْسَکَ لِسَانَہُ ، وَجَلَسَ فِی بَیْتِہِ ، لَہُ مَا احْتَسَبَ ، وَہُوَ مَعَ مَنْ أَحَبَّ۔","","Musannaf Ibn Abi Shaybah 31228","","","كتاب الأمراء"
"31229","(۳۱۲۲۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ رِضَی بْنِ أَبِی عَقِیلٍ ، عَنْ أَبِیہِ ، قَالَ : کُنَّا عَلَی بَابِ ابْنِ الْحَنَفِیَّۃِ بِالشِّعبِ فَخَرَجَ ابْنٌ لَہُ - لَہُ ذُؤَابَتَانِ - فَقَالَ یَا مَعْشَرَ الشِّیعَۃِ ، إنَّ أَبِی یُقْرِئُکُمُ السَّلاَمَ ، قَالَ : فَکَأَنَّمَا کَانَتْ عَلَی رُؤُوسِہِمُ الطَّیْرُ ، قَالَ : إنَّ أَبِی یَقُولُ : إنَّا لاَ نُحِبُّ اللَّعَّانِینَ ، وَلاَ الْمُفرِطِینَ ، وَلاَ الْمُسْتَعْجِلِینَ بِالْقَدَرِ۔","","Musannaf Ibn Abi Shaybah 31229","","","كتاب الأمراء"
"31230","(۳۱۲۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِیہِ ، عَنْ مُنْذِرٍ ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، قَالَ : لَوْ أَنَّ عَلِیًّا أَدْرَکَ أَمْرَنَا ہَذَا ، کَانَ ہَذَا مَوْضِعَ رَحْلِہِ ، یَعْنِی : الشِّعْبَ۔","","Musannaf Ibn Abi Shaybah 31230","","","كتاب الأمراء"
"31231","(۳۱۲۳۱) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ الأَسَدِیُّ ، عَنْ شَرِیکٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ ابْنِ الزُّبَیْرِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَقُومُ السَّاعَۃُ حَتَّی یَخْرُجَ ثَلاَثُونَ کَذَّابًا مِنْہُمَ الْعَنْسِیُّ وَمُسَیْلِمَۃُ وَالْمُخْتَارُ۔n(ابویعلی ۶۷۸۶۔ بزار ۳۳۷۶)","Da'if","Musannaf Ibn Abi Shaybah 31231","","","كتاب الأمراء"
"31232","(۳۱۲۳۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سُفْیَانُ بْنُ سَعِیدٍ ، عَنْ أَبِی الْجَحَّافِ ، عَنْ مُوسَی بْنِ عُمَیْرٍ ، عَنْ أَبِیہِ ، قَالَ : أَمَرَ الْحُسَیْنُ مُنَادِیًا فَنَادَی فَقَالَ : لاَ یقبلَنَّ رَجُلٌ مَعِی عَلَیْہِ دَیْنٌ ، فَقَالَ رَجُلٌ : ضَمِنَتِ امْرَأَتِی دَیْنِی ، فَقَالَ : امْرَأَۃ ! مَا ضَمَانُ امْرَأَۃٍ ؟ قَالَ : وَنَادَی فِی الْمَوَالِی : فَإِنَّہُ بَلَغَنِی أَنَّہُ لاَ یُقْتَلُ رَجُلٌ لَمْ یَتْرُکْ وَفَائً إلاَّ دَخَلَ النَّارَ۔","Da'if","Musannaf Ibn Abi Shaybah 31232","","","كتاب الأمراء"
"31233","(۳۱۲۳۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، قَالَ : قَالَ لِی إبْرَاہِیمُ : إیَّاکَ أَنْ تُقْتَلَ مَعَ فِتْنۃٍ۔","","Musannaf Ibn Abi Shaybah 31233","","","كتاب الأمراء"
"31234","(۳۱۲۳۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : سَمِعْتُ مِسْعَرًا یَذْکُرُ ، عَنْ إبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ : أَنَّ مَسْرُوقًا کَانَ یَرْکَبُ کُلَّ جُمُعَۃٍ بَغْلَۃً لَہُ وَیَجْعَلُنِی خَلْفَہُ ، فَیَأْتِی کُنَاسَۃً بِالْحِیرَۃِ قَدِیمَۃً فَیَحْمِلُ عَلَیْہَا بَغْلَتَہُ ، ثُمَّ یَقُولُ : الدُّنْیَا تَحْتَنَا۔","","Musannaf Ibn Abi Shaybah 31234","","","كتاب الأمراء"
"31235","(۳۱۲۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : سَمِعْتُ حُمَیْدَ بْنَ عَبْدِ اللہ الأَصَمِّ ، یَذْکُرُ عَنْ أُمِّ رَاشِدٍ جَدَّتِہِ ، قَالَتْ : کُنْت عِنْدَ أُمِّ ہَانِئٍ فَأَتَاہَا عَلِیٌّ فَدَعَتْ لَہُ بِطَعَامٍ ، قَالَتْ : وَنَزَلْت فَلَقِیتُ رَجُلَیْنِ فِی الرَّحْبَۃِ ، فَسَمِعْتُ أَحَدَہُمَا یَقُولُ لِصَاحِبِہِ : بَایَعَتْہُ أَیْدِینَا وَلَمْ تُبَایِعْہُ قُلُوبُنَا ، قَالَ : فَقُلْتُ : مَنْ ہَذَانِ الرَّجُلاَنِ ؟ قَالُوا : طَلْحَۃُ وَالزُّبَیْرُ ، قُلْتُ : فَإِنِّی سَمِعْت أَحَدُہُمَا یَقُولُ لِصَاحِبِہِ : بَایَعَتْہُ أَیْدِینَا وَلَمْ تُبَایِعْہُ قُلُوبُنَا ، فَقَالَ عَلِیٌّ : (فَمَنْ نَکَثَ فَإِنَّمَا یَنْکُثُ عَلَی نَفْسِہِ ، وَمَنْ أَوْفَی بِمَا عَاہَدَ عَلَیْہُ اللَّہَ فَسَیُؤْتِیہِ أَجْرًا عَظِیمًا)۔","Da'if","Musannaf Ibn Abi Shaybah 31235","","","كتاب الأمراء"
"31236","(۳۱۲۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیِّ بْنِ حُسَیْنٍ ، قَالَ : حدَّثَنِی ابْنُ عَبَّاسٍ ، قَالَ : أَرْسَلِنِی عَلِیٌّ إلَی طَلْحَۃَ وَالزُّبَیْرِ یَوْمَ الْجَمَلِ ، قَالَ : فَقُلْتُ لَہُمَا : إنَّ أَخَاکُمَا یُقْرِئُکُمَا السَّلاَمَ وَیَقُولُ لَکُمَا : ہَلْ وَجَدْتُمَا عَلَیَّ فِی حَیْفٍ فِی حُکْمٍ ، أَوْ فِی اسْتِئْثَارٍ فِی فَیْئٍ ، أَوْ فِی کَذَا ، أَوْ فِی کَذَا ؟ قَالَ : فَقَالَ الزُّبَیْرُ : لاَ ولاَ فِی وَاحِدَۃٍ مِنْہُمَا ، وَلَکِنْ مَعَ الْخَوْفِ شِدَّۃُ الْمَطَامِعِ۔","Sahih","Musannaf Ibn Abi Shaybah 31236","","","كتاب الأمراء"
"31237","(۳۱۲۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ ، عَنْ أَبِی صَادِقٍ ، عَنْ حَنَشٍ الْکِنَانِیِّ ، عَنْ عُلَیمٍ الْکِنْدِیِّ ، عَنْ سَلْمَانَ ، قَالَ : لَیُحْرَقَنَّ ہَذَا الْبَیْتُ عَلَی یَدِ رَجُلٍ مِنْ آلِ الزُّبَیْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 31237","","","كتاب الأمراء"
"31238","(۳۱۲۳۸) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ أَبِی حَصِینٍ ، قَالَ : مَا رَأَیْت رَجُلاً ہُوَ أَسَبَّ مِنْہُ۔ یَعْنِی : ابْنَ الزُّبَیْرِ۔","","Musannaf Ibn Abi Shaybah 31238","","","كتاب الأمراء"
"31239","(۳۱۲۳۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ الأَجْلَحِ ، قَالَ : قُلْتُ لِعَامِرٍ : إنَّ النَّاسَ یَزْعُمُونَ أَنَّ الْحَجَّاجَ مُؤْمِنٌ ؟ فَقَالَ : وَأَنَا أَشْہَدُ أَنَّہُ مُؤْمِنٌ بِالطَّاغُوتِ کَافِرٌ بِاللہِ۔","","Musannaf Ibn Abi Shaybah 31239","","","كتاب الأمراء"
"31240","(۳۱۲۴۰) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، قَالَ : مَا رَأَیْت أَبَا وَائِلٍ سَبَّ دَابَّۃً قَطُّ إلاَّ الْحَجَّاجَ مَرَّۃً وَاحِدَۃً، فَإِنَّہُ ذَکَرَ بَعْضَ صَنِیعَہُ ، فَقَالَ : اللَّہُمَّ أَطْعِمَ الْحَجَّاجَ طَعَامًا مِنْ ضَرِیعٍ لاَ یُسْمِنُ وَلاَ یُغْنِی مِنْ جُوعٍ ، قَالَ: ثُمَّ تَدَارَکَہَا بَعْدُ ، فَقَالَ : إنْ کَانَ ذَلِکَ أَحَبَّ إلَیْک ، فَقُلْتُ : أَتَشُکُّ فِی الْحَجَّاجِ ؟ قَالَ : وَتَعُدُّ ذَلِکَ ذَنْبًا؟۔","","Musannaf Ibn Abi Shaybah 31240","","","كتاب الأمراء"
"31241","(۳۱۲۴۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ، قَالَ : سَمِعْتُ أَبِی یَقُولُ ، قَالَ : بَلَغَ عَلِیَّ بْنَ أَبِی طَالِبٍ أَنَّ طَلْحَۃَ یَقُولُ : إنَّمَا بَایَعْت وَاللُّجُّ عَلَی قَفَای ، فَأَرْسَل ابْنُ عَبَّاسٍ فَسَأَلَہُ ، قَالَ : فَقَالَ أُسَامَۃُ : أَمَّا اللُّجُّ عَلَی قَفَاہُ فَلا ، وَلَکِنْ قَدْ بَایَعَ وَہُوَ کَارِہٌ ، قَالَ : فَوَثَبَ النَّاسُ إلَیْہِ حَتَّی کَادُوا أَنْ یَقْتُلُوہُ ، قَالَ : فَخَرَجَ صُہَیْبٌ وَأَنَا إلَی جَنْبِہِ ، فَالْتَفَتَ إلَیَّ فَقَالَ : قَدْ عَلِمْت أَنَّ أُمَّ عَوْفٍ حَائِنَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 31241","","","كتاب الأمراء"
"31242","(۳۱۲۴۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، قَالَ : دَخَلْنَا عَلَی ابْنِ أَبِی الْہُذَیْلِ فَقَالَ : قَتَلُوا عُثْمَانَ ، ثُمَّ جَائُونِی ، فَقُلْتُ لَہُ : أَتَرِیبُک نَفْسُک ؟۔","","Musannaf Ibn Abi Shaybah 31242","","","كتاب الأمراء"
"31243","(۳۱۲۴۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہَارُونَ بْنِ عَنْتَرَۃَ ، قَالَ : سَمِعْتُ أَبَا عُبَیْدَۃَ یَقُولُ : کَیْفَ أَرْجُو الشَّہَادَۃَ بَعْدَ قَوْلِی : أَرَأَیْت أَبَاکَ یُزْجَرُ زَجْرَ الأَعْرَابِ۔","","Musannaf Ibn Abi Shaybah 31243","","","كتاب الأمراء"
"31244","(۳۱۲۴۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہَارُونَ بْنِ عَنْتَرَۃَ ، عَنْ سُلَیْمِ بْنِ حَنْظَلَۃَ ، قَالَ : أَتَیْنَا أُبَیَّ بْنَ کَعْبٍ لِنَتَحَدَّثَ مَعَہُ ، فَلَمَّا قَامَ یَمْشِی قُمْنَا لِنَمْشِی مَعَہُ ، فَلَحِقَہُ عُمَرُ فَرَفَعَ عَلَیْہِ الدِّرَّۃَ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ : أَعْلَمُ مَا تَصْنَعُ ، قَالَ : مَا تَرَی فِتْنَۃً لِلْمَتْبُوعِ ذِلَّۃً لِلتَّابِعِ۔","Hasan","Musannaf Ibn Abi Shaybah 31244","","","كتاب الأمراء"
"31245","(۳۱۲۴۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مِسْعَرٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : جَائَ رَجُلٌ إلَی کَعْبِ بْنِ عُجْرَۃَ فَجَعَلَ یَذْکُرُ عَبْدَ اللہِ بْنَ أُبَیٍّ ، وَمَا نَزَلَ فِیہِ مِنَ الْقُرْآنِ وَیَعِیبَہُ ، وَکَانَ بَیْنَہُ وَبَیْنَہُ حُرْمَۃٌ وَقَرَابَۃٌ ، وَکَعْبٌ سَاکِتٌ ، قَالَ : فَانْطَلَقَ الرَّجُلُ إلَی عُمَرَ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ أَلَمْ تَرَ أَنِّی ذَکَرْت مَا نَزَلَ فِی عَبْدِ اللہِ بْنِ أُبَی، فَلَمْ یَکُنْ مِنْ کَعْبٍ، فَالْتَقَی عُمَرُ کَعْبًا ، فَقَالَ: أَلَمْ أُخْبِرْ أَنَّ عَبْدَ اللہِ بْنَ أُبَیٍّ ذُکِرَ عِنْدَکَ فَلَمْ یَکُنْ مِنْک ، قَالَ کَعْبٌ: قَدْ سَمِعْت مَقَالَتَہُ ، فَلَمَّا رَأَیْتہ کَأَنَّہُ تَعَمَّد مَسَائَتِی ، کَرِہْتُ أَنْ أُعِینُہُ عَلَی مَسَائَتِی ، قَالَ : فَقَالَ عُمَرُ : وَدِدْت أَنْ لَوْ ضَرَبْت أَنْفَہُ ، أَوْ وَدِدْت أَنْ لَوْ کَسَرْت أَنْفَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31245","","","كتاب الأمراء"
"31246","(۳۱۲۴۶) حَدَّثَنَا عَبْدُاللہِ بْنُ إدْرِیسَ، عَنْ ہَارُونَ بْنِ أَبِی إِبْرَاہِیمَ، عَن عَبْدِاللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ: أَنَ الأَشْتَرَ وَابْنَ الزُّبَیْرِ الْتَقَیَا ، فَقَالَ ابْنُ الزُّبَیْرِ : مَا ضَرَبْتہ إلاَّ ضَرْبَۃً حَتَّی ضَرَبَنِی خَمْسًا أَوْ سِتًّا ، ثُمَّ قَالَ : فَأَلْقَانِی بِرجلی ، ثُمَّ قَالَ : أَما واللہِ لَوْلاَ قَرَابَتُک مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَا تَرَکْت مِنْک عُضْوًا مَعَ صَاحِبِہِ ، قَالَ : وَقَالَتْ عَائِشَۃُ : وَا ثُکْلَ أَسْمَائَ ، قَالَ : فَلَمَّا کَانَ بَعْدُ أَعْطَتَ الَّذِی بَشَّرَہَا ، أَنَّہُ حَیٌّ عَشَرَۃَ آلاَفٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31246","","","كتاب الأمراء"
"31247","(۳۱۲۴۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی السَّفَرِ ، عَنِ الشَّعْبِیِّ ، قَالَ : مَا عَلِمْت أَحَدًا انْتَصَفَ مِنْ شُرَیْحٍ إلاَّ أَعْرَابِیٌّ ، قَالَ لَہُ شُرَیْحٌ : إنَّ لِسَانَک أَطْوَلُ مِنْ یَدِکَ ، فَقَالَ الأَعْرَابِیُّ : أَسَامِرِیٌّ أَنْتَ فَلاَ تُمَسُّ ، قَالَ لَہُ شُرَیْحٌ : أَقْبِلْ قِبَلَ أَمْرِک ، قَالَ : ذَاکَ أَعملَنِی إلَیْک ، قَالَ : فَلَمَّا أَرَادَ أَنْ یَقُومَ ، قَالَ لَہُ شُرَیْحٌ : إنِّی لَمْ أُرِدْک بِقَوْلِی ، قَالَ : وَلاَ اجْتَرَمْتُ عَلَیْک۔","","Musannaf Ibn Abi Shaybah 31247","","","كتاب الأمراء"
"31248","(۳۱۲۴۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ شَمْرِ بْنِ عَطِیَّۃَ : أَنَّ ابْنَ مِخْنَفٍ الأَزْدِیَّ جَلَسَ إلَی عَلِیٍّ ، قَالَ : فَقَالَ لَہُ عَلِیٌّ : اقْرَا ، فَقَرَأَ سُورَۃَ الْبَقَرَۃِ ، فَمَا فَرَغَ مِنْہَا حَتَّی شَقَّ عَلیَّ ، قَالَ : فَبَعَثَہُ إِلَی أَصْبَہَانَ ، قَالَ : فَأَخَذَ مَا أَخَذَ وَحَمَلَ بَقِیَّۃَ الْمَالِ إلَی مُعَاوِیَۃَ۔","","Musannaf Ibn Abi Shaybah 31248","","","كتاب الأمراء"
"31249","(۳۱۲۴۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ سِیَاہٍ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ ثَعْلَبَۃَ بْنِ یَزِیدَ الْحِمَّانِیِّ ، قَالَ : سَمِعْتُ عَلِیًّا عَلَی ہَذَا الْمِنْبَرِ یَقُولُ : أَیُّہَا النَّاسُ ، أَعِینُونِی عَلَی أَنْفُسِکُمْ ، فَإِنْ کَانَتِ الْقَرْیَۃُ لَیُصْلِحُہَا السَّبْعَۃُ ، وَإِنْ کُنْتُمْ لاَ بُدَّ مُنْتَہِبِیہِ فَہَلُمَّ حَتَّی أُقَسِّمَہُ بَیْنَکُمْ ، فَإِنَّ الْقَوْمَ مَتَی یَنْزِلُوا بِالْقَوْمِ یَضْرِبُوا وُجُوہَہُمْ عَن قَرْیَتِہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 31249","","","كتاب الأمراء"
"31250","(۳۱۲۵۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، قَالَ : مَرَّ ابْنُ عُمَرُ بِحُذَیْفَۃَ ، فَقَالَ حُذَیْفَۃُ : لَقَدْ جَلَسَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَجْلِسًا مَا مِنْہُمْ مِنْ أَحَدٍ إلاَّ أَعْطَی مِنْ دَیْنِہِ إلاَّ ہَذَا الرَّجُلُ۔","Da'if","Musannaf Ibn Abi Shaybah 31250","","","كتاب الأمراء"
"31251","(۳۱۲۵۱) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ شُعْبَۃَ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ، عَنِ ابْنِ مِینَائَ، عَنِ الْمِسْوَرِ بْنِ مَخْرَمَۃَ، قَالَ: سَمِعْتُ عُمَرَ، وَإِنَّ أَحَدَ أَصَابِعِی فِی جُرْحِہِ ہَذِہِ أَوْ ہُوَ یَقُولُ : یَا مَعْشَرَ قُرَیْشٍ ، إنِّی لاَ أَخَافُ النَّاسَ عَلَیْکُمْ ، إنَّمَا أَخَافُکُم عَلَی النَّاسِ ، وَإِنِّی قَدْ تَرَکْت فِیکُمَ اثْنَتَیْنِ لَمْ تَبْرَحُوا بِخَیْرٍ مَا لَزِمْتُمُوہَا : الْعَدْلَ فِی الْحُکْمِ ، وَالْعَدْلَ فِی الْقَسْمِ ، وَإِنِّی قَدْ تَرَکَتْکُمْ عَلَی مِثْلِ مَخْرَفَۃِ الْنَعَمِ إلاَّ أَنْ یَعْوَجَّ قَوْمٌ فَیُعْوَجَّ بِہِمْ۔ (بیہقی ۱۳۴)","Sahih","Musannaf Ibn Abi Shaybah 31251","","","كتاب الأمراء"
"31252","(۳۱۲۵۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، قَالَ : مَرَرْنَا عَلَی أَبِی ذَرٍّ بِالرَّبَذَۃِ ، فَسَأَلْنَاہُ عَنْ مَنْزِلِہِ ، قَالَ : کُنْتُ بِالشَّامِ فَقَرَأْت ہَذِہِ الآیَۃَ : {الَّذِینَ یَکْنِزُونَ الذَّہَبَ وَالْفِضَّۃَ وَلاَ یُنْفِقُونَہَا فِی سَبِیلِ اللہِ} فَقَالَ مُعَاوِیَۃُ : إنَّمَا ہِیَ فِی أَہْلِ الْکِتَابِ ، فَقُلْتُ : إِنَّہَا لَفِینَا وَفِیہِمْ ، فَکَتَبْتُ إلَی عُثْمَان ، قَالَ : فَکَتَبَ إلَیَّ عُثْمَان : أَنْ أَقْبِلْ ، فَلَمَّا قَدِمْت رَکِبَنِی النَّاسُ کَأَنَّہُمْ لَمْ یَرَوْنِی قَبْلَ ذَلِکَ ، فَشَکَوْت ذَلِکَ إلَی عُثْمَانَ ، فَقَالَ : لَوِ اعْتَزَلْت فَکُنْت قَرِیبًا ، فَنَزَلْت ہَذَا الْمَنْزِلَ ، فَلاَ أَدَعُ قَوْلَہ وَلَوْ أَمَّرُوا عَلَیَّ عَبْدًا حَبَشِیًّا۔","Sahih","Musannaf Ibn Abi Shaybah 31252","","","كتاب الأمراء"
"31253","(۳۱۲۵۳) حَدَّثَنَا جَرِیرٌ ، عَنْ أَبِی جَعْفَر ، عَنْ مُغِیرَۃَ ، قَالَ : قَالَ إبْرَاہِیمُ : کَفَی بِمَنْ شَکَّ فِی الْحَجَّاجِ لَحَاہُ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 31253","","","كتاب الأمراء"
"31254","(۳۱۲۵۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ : أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَانَ لَہُ سُمَّارٌ ، فَکَانَ عَلاَمَۃُ مَا بَیْنَہُ وَبَیْنَہُمْ أَنْ یَقُولَ لَہُمْ : إذَا شِئْتُمْ۔","","Musannaf Ibn Abi Shaybah 31254","","","كتاب الأمراء"
"31255","(۳۱۲۵۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، قَالَ : کَانَ إبْرَاہِیمُ إذَا ذُکِرَ عِنْدَ ابْنِ سِیرِینَ ، قَالَ : قَدْ رَأَیْت فَتًی یَغْشَی عَلْقَمَۃَ فِی عَیْنِہِ بَیَاضٌ فَأَمَّا الشَّعْبِیُّ فَقَدْ رَأَیْتہ۔ یَعْنِی : فِی زَمَانِ ابْنِ زِیَادٍ۔","","Musannaf Ibn Abi Shaybah 31255","","","كتاب الأمراء"
"31256","(۳۱۲۵۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ مُعَاذُ شَابًّا آدَمَ وَضَّاحَ الثَّنَایَا ، وَکَانَ إذَا جَلَسَ مَعَ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَوْا لَہُ مَا یَرَوْنَ لِلْکَہْلِ۔","","Musannaf Ibn Abi Shaybah 31256","","","كتاب الأمراء"
"31257","(۳۱۲۵۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حَسَنِ بْنِ فُرَاتٍ ، عَنْ أَبِیہِ ، عَنْ عُمَیْرِ بْنِ سَعِیدٍ ، قَالَ : لَمَّا رَجَعَ عَلِیٌّ مِنَ الْجَمَلِ ، وَتَہَیَّأَ إلَی صِفِّینَ اجْتَمَعَتِ النَّخْعُ حَتَّی دَخَلُوا عَلَی الأَشْتَرِ ، فَقَالَ : ہَلْ فِی الْبَیْتِ إلاَّ نَخْعِیٌّ ، قَالُوا : لاَ ، قَالَ : إنَّ ہَذِہِ الأُمَّۃَ عَمَدَتْ إلَی خَیْرِہَا فَقَتَلَتْہُ ، وَسِرْنَا إلَی أَہْلِ الْبَصْرَۃِ قوْمٌ لَنَا عَلَیْہِمْ بَیْعَۃٌ فَنُصِرْنَا عَلَیْہِمْ بِنَکْثِہِمْ ، وَإِنَّکُمْ سَتَسِیرُونَ إلَی أَہْلِ الشَّامِ قَوْمٌ لَیْسَ لَکُمْ عَلَیْہِمْ بَیْعَۃٌ ، فَلْیَنْظُرَ امْرُؤٌ مِنْکُم أَیْنَ یَضَعُ سَیْفَہُ ؟!۔","Sahih","Musannaf Ibn Abi Shaybah 31257","","","كتاب الأمراء"
"31258","(۳۱۲۵۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ قِیلَ لِعُمَرَ : اکْتُبْ إلَی جَوَانَانَ ، قَالَ : وَمَا جَوَانَانُ ، قَالُوا : خَیْرُ الْفِتْیَانِ ، قَالَ : اکْتُبْ إلَی شَرِّ الْفِتْیَانِ۔ (عبدالرزاق ۱۹۸۵۵)","","Musannaf Ibn Abi Shaybah 31258","","","كتاب الأمراء"
"31259","(۳۱۲۵۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، قَالَ : رَأَیْتُ عَبْدَ الرَّحْمَن بْنَ أَبِی لَیْلَی ضَرَبَہُ الْحَجَّاجُ وَأَوْقَفَہُ عَلَی بَابِ الْمَسْجِدِ ، قَالَ : فَجَعَلُوا یَقُولُونَ لَہُ : الْعَنِ الْکَذَّابِینَ ، فَجَعَلَ یَقُولُ : لَعَن اللَّہُ الْکَذَّابِینَ ، ثُمَّ سَکَتَ حِینَ سَکَتَ ، ثُمَّ یَقُولُ : عَلِیُّ بْنُ أَبِی طَالِبٍ ، وَعَبْدُ اللہِ بْنُ الزُّبَیْرِ وَالْمُخْتَارُ بْنُ أَبِی عُبَیْدٍ ، فَعَرَفْت حِینَ سَکَتَ ، ثُمَّ ابْتَدَأَہُمْ فَعِرَّفَہُمْ ، أَنَّہُ لَیْسَ یُرِیدُہُمْ۔","","Musannaf Ibn Abi Shaybah 31259","","","كتاب الأمراء"
"31260","(۳۱۲۶۰) حَدَّثَنَا مَالِکُ بْنُ إسْمَاعِیلَ ، قَالَ : أَخْبَرَنَا جَعْفَرُ بْنُ زِیَادٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : کُنْتُ جَالِسًا مَعَ أَبِی الْبَخْترِیِّ الطَّائِیِّ وَالْحَجَّاجُ یَخْطُبُ ، فَقَالَ : مَثَلُ عُثْمَانَ عِنْدَ اللہِ کَمَثَلِ عِیسَی ابْنِ مَرْیَمَ ، قَالَ : فَرَفَعَ رَأْسَہُ ثُمَّ تَأَوَّہَ ، ثُمَّ قَالَ : {إنِّی مُتَوَفِّیک وَرَافِعُک إلَیَّ} إِلَی قَوْلِہ {وَجَاعِلُ الَّذِینَ اتَّبَعُوک فَوْقَ الَّذِینَ کَفَرُوا إلَی یَوْمِ الْقِیَامَۃِ} قَالَ : فَقَالَ أَبُو الْبَخْترِیِّ : کَفَرَ وَرَبِّ الْکَعْبَۃِ۔","","Musannaf Ibn Abi Shaybah 31260","","","كتاب الأمراء"
"31261","(۳۱۲۶۱) حَدَّثَنَا مالک بن إسْمَاعِیلَ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، قَالَ : حَدَّثَنَا کِنَانَۃٌ ، قَالَ : کُنْتُ أَقُودُ بِصَفِیَّۃَ لِتَرُدَّ عَنْ عُثْمَانَ ، قَالَ : فَلَقِیَہَا الأَشْتَرُ فَضَرَبَ وَجْہَ بَغْلَتِِہَا حَتَّی مَالَتْ وَحَتَّی قَالَتْ : رُدُّونِی لاَ یَفْضَحُنِی ہَذَا۔n(ابن سعد ۱۲۸)","Hasan","Musannaf Ibn Abi Shaybah 31261","","","كتاب الأمراء"
"31262","(۳۱۲۶۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الرَّبِیعِ بْنِ أَبِی صَالِحٍ ، قَالَ : لَمَّا قَدِمَ سَعِیدُ بْنُ جُبَیْرٍ مِنْ مَکَّۃَ إلَی الْکُوفَۃِ لِیُنْطَلَقَ بِہِ إلَی الْحَجَّاجِ إلَی وَاسِطٍ ، قَالَ : فَأَتَیْنَاہُ وَنَحْنُ ثَلاَثَۃُ نَفَرٍ ، أَوْ أَرْبَعَۃٌ ، فَوَجَدْنَاہُ فِی کُنَاسَۃِ الْخَشَبِ فَجَلَسْنَا إلَیْہِ ، فَبَکَی رَجُلٌ مِنَّا ، فَقَالَ لَہُ سَعِیدٌ : مَا یُبْکِیَک ، قَالَ : أَبْکِی لِلَّذِی نَزَلَ بِکَ مِنَ الأَمْرِ ، قَالَ : فَلاَ تَبْکِ فَإِنَّہُ قَدْ کَانَ سَبَقَ فِی عِلْمِ اللہِ یَکُونُ ہَذَا ، ثُمَّ قَرَأَ : {مَا أَصَابَ مِنْ مُصِیبَۃٍ فِی الأَرْضِ ، وَلاَ فِی أَنْفُسِکُمْ إلاَّ فِی کِتَابٍ مِنْ قَبْلِ أَنْ نَبْرَأَہَا إنَّ ذَلِکَ عَلَی اللہِ یَسِیرٌ}۔","","Musannaf Ibn Abi Shaybah 31262","","","كتاب الأمراء"
"31263","(۳۱۲۶۳) حَدَّثَنَا عَفَّانُ، قَالَ: حدَّثَنَا أَبُو عَوَانَۃَ، قَالَ: حَدَّثَنَا الْمُغِیرَۃُ، عَنْ ثَابِتِ بْنِ ہُرْمُزَ، عَنْ عَبَّادٍ، قَالَ: أَتَی الْمُخْتَارُ عَلِیَّ بْنَ أَبِی طَالِبٍ بِمَالٍ مِنَ الْمَدَائِنِ وَعَلَیْہَا عَمُّہُ سَعْدُ بْنُ مَسْعُودٍ ، قَالَ : فَوَضَعَ الْمَالَ بَیْنَ یَدَیْہِ وَعَلَیْہِ مُقَطَّعَۃٌ حَمْرَائُ، قَالَ: فَأَدْخَلَ یَدَہُ فَاسْتَخْرَجَ کِیسًا فِیہِ نَحْوٌ مِنْ خَمْسَ عَشْرَۃَ مِئَۃ، قَالَ: ہَذَا مِنْ أُجُورِ الْمُومِسَاتِ قَالَ : فَقَالَ عَلِیٌّ : لاَ حَاجَۃَ لَنَا فِی أُجُورِ الْمُومِسَاتِ ، قَالَ : وَأَمَرَ بِمَالِ الْمَدَائِنِ فَرُفِعَ إلَی بَیْتِ الْمَالِ ، قَالَ : فَلَمَّا أَدْبَرَ ، قَالَ لَہُ عَلِیٌّ : قَاتَلَہُ اللہ ، لَوْ شُقَّ عَلَی قَلْبِہِ لَوُجِدَ مَلآنُ مِنْ حُبِّ اللاَّتِ وَالْعُزَّی۔","","Musannaf Ibn Abi Shaybah 31263","","","كتاب الأمراء"
"31264","(۳۱۲۶۴) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا وُہَیْبٌ ، قَالَ : حَدَّثَنَا دَاوُد ، عَنِ الْحَسَنِ ، عَنِ الزُّبَیْرِ بْنِ الْعَوَّامِ : فِی ہَذِہِ الآیَۃِ : {وَاتَّقُوا فِتْنَۃً لاَ تُصِیبَنَّ الَّذِینَ ظَلَمُوا مِنْکُمْ خَاصَّۃً} قَالَ لَقَدْ نَزَلَتْ ، وَمَا نَدْرِی مَنْ یَخلُفُ لَہَا ، قَالَ : فَقَالَ بَعْضُہُمْ : یَا أَبَا عَبْدِ اللہِ ، فَلِمَ جِئْت إلَی الْبَصْرَۃِ ؟ قَالَ : وَیْحَک إنَّا نُبْصِرُ وَلَکِنَّا لاَ نَصْبِرُ۔","Hasan","Musannaf Ibn Abi Shaybah 31264","","","كتاب الأمراء"
"31265","(۳۱۲۶۵) حَدَّثَنَا عَفَّانُ ، قَالَ : نَا أَبُو عَوَانَۃَ ، عَنِ الْمُغِیرَۃِ ، عَنْ قُدَامَۃَ بْنِ عِتَابٍ ، قَالَ : رَأَیْتُ عَلِیًّا یَخْطُبُ فَأَتَاہُ آتٍ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، أَدْرِکْ بَکْرَ بْنَ وَائِلٍ فَقَدْ ضَرَبَتْہَا بَنُو تَمِیمٍ بِالْکُنَاسَۃِ ، قَالَ عَلِیٌّ : ہَاہ ، ثُمَّ أَقْبَلَ عَلَی خُطْبَتِہِ ، ثُمَّ أَتَاہُ آخَرُ فَقَالَ مِثْلَ ذَلِکَ ، فَقَالَ : آہٍ ، ثُمَّ أَتَاہُ الثَّالِثَۃَ ، أَو الرَّابِعَۃَ ، فَقَالَ : أَدْرِکْ بَکْرَ بْنَ وَائِلٍ فَقَدْ ضَرَبَتْہَا بَنُو تَمِیمٍ ہِیَ بِالْکُنَاسَۃِ ، فَقَالَ : الآن صَدَقْتنِی سِن بَکْرِکَ یَا شَدَّادُ ؟ أَدْرِکْ بَکْرَ بْنَ وَائِلٍ وَبَنِی تَمِیمٍ فَأَقْرِعْ بَیْنَہُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 31265","","","كتاب الأمراء"
"31266","(۳۱۲۶۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا الْعَوَّامُ بْنُ حَوْشَبٍ ، عَنْ إبْرَاہِیمَ مَوْلَی صُخَیرٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : بَعَثَ إلَیَّ الْحَجَّاجُ فَقَدِمْت عَلَیْہِ الأَہْوَازَ ، قَالَ لِی : مَا مَعَک مِنَ الْقُرْآنِ ، قَالَ : قُلْتُ : مَعِی مَا إنِ اتَّبَعْتہ کَفَانِی ، قَالَ : إنِّی أُرِیدُ أَنْ أَسْتَعِینَ بِکَ عَلَی بَعْضِ عَمَلِی ، قَالَ : قُلْتُ : إنْ تُقْحِمْنِی أَقْتَحِمْ ، وَإِنْ تَجْعَلْ مَعِی غَیْرِی خِفْت بَطَائِنَ السُّوئِ ، قَالَ : فَقَالَ الْحَجَّاجُ : وَاللہِ لَئِنْ قُلْتَ ذَاکَ إنَّ بَطَائِنَ السُّوئِ لَمَفْسَدَۃٌ للرَّجُلِ ، قَالَ : قُلْتُ : مَا زِلْت أُقَحَّزُ مُنْذُ اللَّیْلَۃَ عَلَی فِرَاشِی مَخَافَۃَ أَنْ تَقْتُلَنِی ، قَالَ : وَعَلاَمَ أَقْتُلُک ؟ أَمَا وَاللہِ لَئِنْ قُلْتَ ذَاکَ ، إنِّی لأقْتُلُ الرَّجُلَ عَلَی أَمْرٍ قَدْ کَانَ مَنْ قَبْلِی یُہَابُ الْقَتْلُ عَلَی مِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 31266","","","كتاب الأمراء"
"31267","(۳۱۲۶۷) حَدَّثَنَا زَیْدُ بْنُ حَبَّابٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ ہِلاَلٍ الْقُرَشِیُّ ، قَالَ : أَخْبَرَنَا أَبِی ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یَقُولُ لِمَرْوَانَ وَأَبْطَأَ بِالْجُمُعَۃِ : تَظَلُّ عِنْدَ بِنْتِ فُلاَنٍ تُرَوِّحُک بِالْمَرَاوِحِ وَتَسْقِیک الْمَائَ الْبَارِدَ ، وَأَبْنَائُ الْمُہَاجِرِینَ یُسْلَقُونَ مِنَ الْحَرِ ، لَقَدْ ہَمَمْت أَنِّی أَفْعَلُ وَأَفْعَلُ ، ثُمَّ قَالَ : اسْمَعُوا لأَمِیرِکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 31267","","","كتاب الأمراء"
"31268","(۳۱۲۶۸) حَدَّثَنَا حَمَّادُ بْنُ أُسَامَۃَ ، قَالَ : حدَّثَنَ[corrupt] حماد بن زید ، قَالَ : حدَّثَنَا أَبُو نَعَامَۃَ عَمْرُو بْنُ عِیسَی ، قَالَ : قَالَتْ عَائِشَۃُ : اللَّہُمَّ أَدْرِکْ خُفْرَتَکَ فِی عُثْمَانَ وَأَبْلِغِ الْقِصَاصَ فِی مُذَمَّمْ وَأَبْدِ عَوْرَۃ أَعْیَن رَجُلٌ مِنْ بَنِی تَمِیمٍ أَبِی امْرَأَۃِ الْفَرَزْدَقَ۔","","Musannaf Ibn Abi Shaybah 31268","","","كتاب الأمراء"
"31269","(۳۱۲۶۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، قَالَ : أَخْبَرَنَا أَبُو نَضْرَۃَ : أَنَّ رَبِیعَۃَ کَلَّمَت طَلْحَۃَ فِی مَسْجِدِ بَنِی سَلَمَۃَ ، فَقَالَت : کُنَّا فِی نَحْرِ الْعَدُوِّ حِینَ جَائَتْنَا بَیْعَتُک ہَذَا الرَّجُلَ ، ثُمَّ أَنْتَ الآنَ تُقَاتِلُہُ ، أَوْ کَمَا قَالُوا ، فَقَالَ : إنِّی أُدْخِلْت الْحُشَّ وَوُضِعَ عَلَی عُنُقِی اللُّج ، فَقِیلَ : بَایِعْ وَإِلاَّ قَتَلْنَاک ، قَالَ : فَبَایَعْت ، وَعَرَفْتُ أَنَّہَا بَیْعَۃُ ضَلاَلَۃٍ۔ قَالَ التَّیْمِیُّ : وَقَالَ وَلِیدُ بْنُ عَبْدِ الْمَلِکِ : إنَّ مُنَافِقًا مِنْ مُنَافِقِی أَہْلِ الْعِرَاقِ جَبَلَۃَ بْنَ حَکِیمٍ قَالَ لِلزُّبَیْرِ : فإنَّک قَدْ بَایَعْت ، فَقَالَ الزُّبَیْرُ : إنَّ السَّیْفَ وُضِعَ عَلَی عنقِی فَقِیلَ لِی : بَایِعْ وَإِلاَّ قَتَلْنَاک ، قَالَ : فَبَایَعْت۔","Hasan","Musannaf Ibn Abi Shaybah 31269","","","كتاب الأمراء"
"31270","(۳۱۲۷۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ : أَنَّ أُنَاسًا کَانُوا عِنْدَ فُسْطَاطِ عَائِشَۃَ ، فَمَرَّ عُثْمَان أُری ذَاکَ بِمَکَّۃَ ، قَالَ أَبُو سَعِیدٍ : فَمَا بَقِیَ أَحَدٌ مِنْہُمْ إلاَّ لَعَنَہُ ، أَوْ سَبَّہُ غَیْرِی، وَکَانَ فِیہِمْ رَجُلٌ مِنْ أَہْلِ الْکُوفَۃِ ، فَکَانَ عُثْمَان عَلَی الْکُوفِیِّ أَجْرَأَ مِنْہُ عَلَی غَیْرِہِ ، فَقَالَ : یَا کُوفِی ، أَتَشْتِمُنِی ؟ اقْدَمِ الْمَدِینَۃَ ، کَأَنَّہُ یَتَہَدَّدُہُ ، قَالَ : فَقَدِمَ الْمَدِینَۃَ ، فَقِیلَ لَہُ : عَلَیْک بِطَلْحَۃِ ، قَالَ : فَانْطَلَقَ مَعَہُ طَلْحَۃُ حَتَّی أَتَی عُثْمَانَ ، قَالَ عُثْمَان : وَاللہِ لاَجْلِدَنَّکَ مِئَۃ ، قَالَ طَلْحَۃُ : وَاللہِ لاَ تَجْلِدُہُ مِئَۃ إلاَّ أَنْ یَکُونَ زَانِیًا ، قَالَ : لأَحْرِمَنَّکَ عَطَائَک ، قَالَ : فَقَالَ طَلْحَۃُ : إنَّ اللَّہَ سَیَرْزُقُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31270","","","كتاب الأمراء"
"31271","(۳۱۲۷۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ عُمَرَ بْنِ جَاوَانَ ، عَنِ الأَحْنَفِ بْنِ قَیْسٍ ، قَالَ : قدِمْنَا الْمَدِینَۃَ وَنَحْنُ نُرِیدُ الْحَجَّ ، قَالَ الأَحْنَفُ : فَانْطَلَقْتُ فَأَتَیْتُ طَلْحَۃَ وَالزُّبَیْرَ ، فَقُلْتُ : مَنْ تَأْمُرَانِی بِہِ وَتَرْضَیَانِہِ لِی ؟ فَإِنِّی مَا أَرَی ہَذَا إلاَّ مَقْتُولاً ، یَعْنِی عُثْمَانَ ، قَالاَ : نَأْمُرُک بِعَلِیّ ، قُلْتُ تَأْمُرَانِی بِہِ وَتَرْضَیَانِہِ لِی ؟ قَالاَ : نَعَمْ ، قَالَ : ثُمَّ انْطَلَقْت حَاجًّا حَتَّی قَدِمْت مَکَّۃَ ، فَبَیْنَا نَحْنُ بِہَا إذْ أَتَانَا قَتْلُ عُثْمَانَ ، وَبِہَا عَائِشَۃُ أُمُّ الْمُؤْمِنِینَ ، فَلَقِیتُہَا ، فَقُلْتُ : مَنْ تَأْمُرِینِی بِہِ أَنْ أُبَایِعَ ؟ قَالَتْ : عَلِی ، قُلْتُ : أَتَأْمُرِینِی بِہِ وَتَرْضَیْنَہُ لِی ؟ قَالَتْ : نَعَمْ ، فَمَرَرْت عَلَی عَلِیٍّ بِالْمَدِینَۃِ فَبَایَعْتہ ، ثُمَّ رَجَعْت إلَی الْبَصْرَۃِ وَأَنَا أَرَی أَنَّ الأَمْرَ قَدِ اسْتَقَامَ۔n فَبَیْنَا أَنَا کَذَلِکَ إذْا أَتَانِی آتٍ ، فَقَالَ : ہَذِہِ عَائِشَۃُ أُمُّ الْمُؤْمِنِینَ وَطَلْحَۃُ وَالزُّبَیْرُ قَدْ نَزَلُوا جَانِبَ الْخُرَیْبَۃِ ، قَالَ : فَقُلْتُ : مَا جَائَ بِہِمْ ؟ قَالُوا : أَرْسَلُوا إلَیْک یَسْتَنْصِرُونَک عَلَی دَمِ عُثْمَانَ ، قُتِلَ مَظْلُومًا ، قَالَ : فَأَتَانِی أَفْظَعُ أَمْرٍ أَتَانِی قَطُّ ، قَالَ : قُلْتُ : إنَّ خِذَلاَنِی ہَؤُلاَئِ وَمَعَہُمْ أُمُّ الْمُؤْمِنِینَ وَحَوَارِیُّ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَشَدِیدٌ ، وَإِنَّ قِتَالِی ابْنِ عَمِّ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعْدَ أَنْ أَمَرُونِی بِبَیْعَتِہِ لَشَدِیدٌ۔n قَالَ : فَلَمَّا أَتَیْتہمْ ، قَالوا : جِئْنَا نَسْتَنْصِرُک عَلَی دَمِ عُثْمَانَ قُتِلَ مَظْلُومًا ، قَالَ : قُلْتُ : یَا أُمَّ الْمُؤْمِنِینَ ، أُنْشِدُک بِاللہِ أَقُلْتُ لَکِ : مَنْ تَأْمُرِینِی فَقُلْتِ : عَلِیّ ، وَقُلْتُ : تَأْمُرِینِی بِہِ وَتَرْضِینَہُ لِی ؟ قُلْتُ : نَعَم ؟ قَالَتْ : نَعَمْ ، وَلَکِنَّہُ بَدَّل ، فَقُلْتُ : یَا زُبَیْرُ یَا حَوَارِیَّ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، یَا طَلْحَۃُ ، نَشَدْتُکُمَا بِاللہِ: أَقُلْت لَکُمَا : مَنْ تَأْمُرَانِی بِہِ ، فَقُلْتُمَا : عَلِیًّا ، فَقُلْتُ : تَأْمُرَانِی بِہِ وَتَرْضَیَانِہِ لِی ، فَقُلْتُمَا : نَعَمْ ؟ قَالاَ : بَلَی ، وَلَکِنَّہُ بَدَّلَ۔n قَالَ : قُلْتُ : لاَ أُقَاتِلُکُمْ وَمَعَکُمْ أُمُّ الْمُؤْمِنِینَ وَحَوَارِیُّ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَلاَ أُقَاتِلُ ابْنَ عَمِّ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرْتُمُونِی بِبَیْعَتِہِ ، اخْتَارُوا مِنِّی إِحْدَی ثَلاَثَ خِصَالٍ : إمَّا أَنْ تَفْتَحُوا لِی بَابَ الْجِسْرِ فَأَلْحَقَ بِأَرْضِ الأَعَاجِمِ حَتَّی یَقْضِیَ اللَّہُ مِنْ أَمْرِہِ مَا قَضَی ، أَوْ أَلْحَقَ بِمَکَّۃَ فَأَکُونَ بِہَا حَتَّی یَقْضِیَ اللَّہُ مِنْ أَمْرِہِ مَا قَضَی ، أَوْ أَعْتَزِلُ فَأَکُونَ قَرِیبًا ، قَالُوا : نَأْتَمر ، ثُمَّ نُرْسِلُ إلَیْک ، فَأْتَمَرُوا ، فَقَالُوا : نَفْتَحُ لَہُ بَابَ الْجِسْرِ یَلْحَقُ بِہِ الْمُفَارِقُ وَالْخَاذِلُ ، أَوْ یَلْحَقُ بِمَکَّۃَ فَیَتَعَجَّسَکُمْ فِی قُرَیْشٍ وَیُخْبِرُہُمْ بِأَخْبَارِکُمْ ، لَیْسَ ذَلِکَ بِرَأْی ، اجْعَلُوہُ ہَاہُنَا قَرِیبًا حَیْثُ تَطَؤُونَ عَلَی صِمَاخِہِ وَتَنْظُرُونَ إلَیْہِ۔n فَاعْتَزَلَ بِالْجَلْحَائِ مِنَ الْبَصْرَۃِ وَاعْتَزَلَ مَعَہُ زُہَائُ سِتَّۃِ آلاَفٍ ، ثُمَّ الْتَقَی الْقَوْمُ ، فَکَانَ أَوَّلُ قَتِیلٍ طَلْحَۃَ وَکَعْبَ بْنَ سُورٍ وَمَعَہُ الْمُصْحَفُ ، یُذَکِّرُ ہَؤُلاَئِ وَہَؤُلاَئِ حَتَّی قُتِلَ بَیْنَہُمْ ، وَبَلَغَ الزُّبَیْرُ سَفَوَانَ مِنَ الْبَصْرَۃِ کَمَکَانِ الْقَادِسِیَّۃِ مِنْکُمْ ، فَلَقِیَہُ النَّعِرُ : رَجُلٌ مِنْ مُجَاشِعٍ ، فَقَالَ : أَیْنَ تَذْہَبُ یَا حَوَارِیَّ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ إلَیَّ ، فَأَنْتَ فِی ذِمَّتِی لاَ یُوصَلُ إلَیْک ، فَأَقْبَلَ مَعَہُ ، فَأَتَی إنْسَانٌ الأَحْنَفَ ، فَقَالَ : ہَذَا الزُّبَیْرُ قَدْ لَحِقَ بِسَفوَانَ ، قَالَ : فَمَا یَأْمَن ؟ جَمَعَ بَیْنَ الْمُسْلِمِینَ حَتَّی ضَرَبَ بَعْضُہُمْ حَوَاجِبَ بَعْضٍ بِالسُّیُوفِ ، ثُمَّ لَحِقَ بِبَیْتہِ وَأَہْلِہِ۔n قَالَ : فَسَمِعَہُ عُمَیْرُ بْنُ جُرْمُوزٍ ، وَغُوَاۃٌ مِنْ غُوَاۃِ بَنِی تَمِیمٍ ، وَفُضَالَۃُ بْنُ حَابِسٍ ، وَنُفَیْعٌ ، فَرَکِبُوا فِی طَلَبِہِ فَلَقُوہُ مَعَ النَّعِرِ ، فَأَتَاہُ عُمَیْرُ بْنُ جُرْمُوزٍ مِنْ خَلْفِہِ وَہُوَ عَلَی فَرَسٍ لَہُ ضَعِیفَۃ فَطَعَنَہُ طَعْنَۃً خَفِیفَۃً ، وَحَمَلَ عَلَیْہِ الزُّبَیْرُ وَہُوَ عَلَی فَرَسٍ لَہُ یُقَالَ لَہُ : ذُو الْخِمَارِ ، حَتَّی إذَا ظَنَّ ، أَنَّہُ نَائِلُہُ نَادَی صَاحِبَیْہ یَا نُفَیْعٌ ، یَا فُضَالَۃُ ، فَحَمَلُوا عَلَیْہِ حَتَّی قَتَلُوہُ۔","Da'if","Musannaf Ibn Abi Shaybah 31271","","","كتاب الأمراء"
"31272","(۳۱۲۷۲) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ یَحْیَی بْنِ عَبْدِاللہِ بْن أَبِی قَتَادَۃَ، قَالَ: مَازَحَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَبَا قَتَادَۃَ، فَقَالَ: لاَجُزَّنَّ جُمَّتَکَ، فَقَالَ لَہُ: لَک مَکَانُہَا أَسِیرٌ، فَقَالَ لَہُ بَعْدَ ذَلِکَ: أَکْرِمْہَا، فَکَانَ یَتَّخِذُ لَہَا السُّک۔","","Musannaf Ibn Abi Shaybah 31272","","","كتاب الأمراء"
"31273","(۳۱۲۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی بَکْرِ بْنِ حَفْصٍ ، عَنِ الْحَسَنِ بْنِ الْحَسَنِ : أَنَّ عَبْدَ اللہِ بْنَ جَعْفَرٍ زَوَّجَ ابْنَتَہُ فَخَلاَ بِہَا ، فَقَالَ لَہَا : إذَا نَزَلَ بِکَ الْمَوْتُ ، أَوْ أَمْرٌ مِنْ أُمُورِ الدُّنْیَا فَظِیعٌ فَاسْتَقْبِلِیہِ بِأَنْ تَقُولِی لاَ إلَہَ إلاَّ اللَّہُ الْحَلِیمُ الْکَرِیمُ سُبْحَانَ اللہِ رَبِّ الْعَرْشِ الْعَظِیمِ الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ۔n قَالَ الْحَسَنُ بْنُ الْحَسَنِ : فَبَعَثَ إلَیَّ الْحَجَّاجُ فَقُلْ[corrupt]ہنَّ ، فَلَمَّا مَثُلْت بَیْنَ یَدَیْہِ ، قَالَ : لَقَدْ بَعَثْت إلَیْک وَأَنَا أُرِیدُ أَنْ أَضْرِبَ عُنُقَک ، وَلَقَدْ صِرْت وَمَا مِنْ أَہْلِ بَیْتِکَ أَحَدٌ أَکْرَمُ عَلَیَّ مِنْک ، سَلْنِی حَاجَتَک۔","Hasan","Musannaf Ibn Abi Shaybah 31273","","","كتاب الأمراء"
"31274","(۳۱۲۷۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ نَافِعِ بْنِ عُمَرَ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : قَالَ ابْن الزُّبَیْرُ لِعُبَیْدِ بْنِ عُمَیْرٍ : کَلِّمْ ہَؤُلاَئِ لأَہْلِ الشَّامِ رَجَائَ أَنْ یَرُدَّہُمْ ذَاکَ ، فَسَمِعَ ذَلِکَ الْحَجَّاجُ فَأَرْسَلِ إلَیْہِمْ : ارْفَعُوا أَصْوَاتَکُمْ ، فَلاَ تَسْمَعُوا مِنْہُ شَیْئًا ، فَقَالَ عُبَیْدٌ : وَیْحَکُمْ ، لاَ تَکُونُوا کَاَلَّذِینَ قَالُوا : {لاَ تَسْمَعُوا لِہَذَا الْقُرْآنِ وَأَلْغَوْا فِیہِ لَعَلَّکُمْ تَغْلِبُونَ}۔","Sahih","Musannaf Ibn Abi Shaybah 31274","","","كتاب الأمراء"
"31275","(۳۱۲۷۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : قَالَ أَبُو جَعْفَرٍ مُحَمَّدُ بْنُ عَلِیٍّ : اللَّہُمَّ إنَّک تَعْلَمُ أَنِّی لَسْتُ لَہُمْ بِإِمَامٍ۔","","Musannaf Ibn Abi Shaybah 31275","","","كتاب الأمراء"
"31276","(۳۱۲۷۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا جَرِیرُ بْنُ حَازِمٍ ، قَالَ : حَدَّثَنِی شَیْخٌ مِنْ أَہْلِ الْکُوفَۃِ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ فِی أَیَّامِ ابْنِ الزُّبَیْرِ ، قَدْ دَخَلَ الْمَسْجِدَ فَإِذَا السِّلاَح ، فَجَعَلَ یَقُولُ : لَقَدْ أَعْظَمْتُمَ الدُّنْیَا ! حَتَّی اسْتَلَمَ الْحَجَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 31276","","","كتاب الأمراء"
"31277","(۳۱۲۷۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ طَلْحَۃَ ، قَالَ : حَدَّثَنَا إبْرَاہِیمُ بْنُ عَبْدِ الأَعْلَی الْجُعْفِیُّ ، قَالَ : أَرْسَلَ الْحَجَّاجُ إلَی سُوَیْد بْنِ غَفَلَۃَ فَقَالَ : لاَ تَؤُمَّ قَوْمَک ، وَإِذَا رَجَعْت فَاسْبِبْ عَلِیًّا ، قَالَ : قُلْتُ : سَمْع وَطَاعَۃً۔","","Musannaf Ibn Abi Shaybah 31277","","","كتاب الأمراء"
"31278","(۳۱۲۷۸) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، قَالَ : ذَکَرَ إبْرَاہِیمُ : أَنَّہُ أُرْسِلَ إلَیْہِ زَمَنَ الْمُخْتَارِ بْنِ أَبِی عُبَیْدٍ ، قَالَ : فَطَلاَ وَجْہَہُ بِطِلاَئٍ ، وَشَرِبَ دَوَائً ، فَلَمْ یَأْتِہِمْ فَتَرَکُوہُ۔","","Musannaf Ibn Abi Shaybah 31278","","","كتاب الأمراء"
"31279","(۳۱۲۷۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ زَکَرِیَّا ، عَنِ الْعَبَّاسِ بْنِ ذَرِیحٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَتَبَتْ عَائِشَۃُ إلَی مُعَاوِیَۃَ : أَمَّا بَعْدُ فَإِنَّہُ مَنْ یَعْمَلْ بِسَخَطِ اللہِ یُعَدُّ حَامِدُہُ مِنَ النَّاسِ ذَامًّا۔ (حمیدی ۲۶۶۔ ابن حبان ۲۷۷)","Sahih","Musannaf Ibn Abi Shaybah 31279","","","كتاب الأمراء"
"31280","(۳۱۲۸۰) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : رَأَیْتُ حُجْرٌ بْنَ عَدِیٍّ وَہُوَ یَقُولُ : ہاہ ! بَیْعَتِی لاَ أَقِیلُہَا وَلاَ أَسْتَقِیلُہَا ، سَمَاعُ اللہِ وَالنَّاسِ۔ یَعْنِی بِقَوْلِہِ الْمُغِیرَۃَ۔","","Musannaf Ibn Abi Shaybah 31280","","","كتاب الأمراء"
"31281","(۳۱۲۸۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا قُطْبَۃُ بْنُ عَبْدِ الْعَزِیزِ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، قَالَ : کَتَبَ أَصْحَابُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَیْبَ عُثْمَانَ فَقَالُوا : مَنْ یَذْہَبُ بِہِ إلَیْہِ، فَقَالَ عَمَّارُ : أَنَا ، فَذَہَبَ بِہِ إلَیْہِ ، فَلَمَّا قَرَأَہُ قَالَ : أَرْغَمَ اللَّہُ بِأَنْفِکَ ، فَقَالَ عَمَّارُ : وَبِأَنْفِ أَبِی بَکْرٍ وَعُمَرَ ، قَالَ : فَقَامَ وَوَطِئَہُ حَتَّی غُشِیَ عَلَیْہِ ، قَالَ : وَکَانَ عَلَیْہِ تُبَّان۔n قَالَ : ثُمَّ بَعَثَ إلَیْہِ الزُّبَیْرِ وَطَلْحَۃَ فَقَالاَ لَہُ : اخْتَرْ إحْدَی ثَلاَثٍ : إمَّا أَنْ تَعْفُوَ ، وَإِمَّا أَنْ تَأْخُذَ الأَرْشَ ، وَإِمَّا أَنْ تَقْتَصَّ ، قَالَ : فَقَالَ عَمَّارُ : لاَ أَقْبَلُ مِنْہُنَّ شَیْئًا حَتَّی أَلْقَی اللَّہَ۔n قَالَ أَبُو بَکْرٍ : سَمِعْت یَحْیَی بْنَ آدَمَ ، قَالَ : ذَکَرْت ہَذَا الْحَدِیثَ لِحَسَنِ بْنِ صَالِحٍ ، فَقَالَ : مَا کَانَ عَلَی عُثْمَانَ أَکْثَرَ مِمَّا صَنَعَ۔","","Musannaf Ibn Abi Shaybah 31281","","","كتاب الأمراء"
"31282","(۳۱۲۸۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی حَیَّانَ ، عَنْ حَمَّادٍ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : إِنَّ الْکُتُب تَجِیئُ مِنْ قِبَلِ قُتَیْبَۃَ فِیہَا الْبَاطِلُ وَالْکَذِبُ ، فَإِذَا أَرَدْت أَنْ أُحَدِّثَ جَلِیسِی أَفْعَلُ ؟ قَالَ : لاَ بَلْ أَنْصِتْ۔","","Musannaf Ibn Abi Shaybah 31282","","","كتاب الأمراء"
"31283","(۳۱۲۸۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ إسْرَائِیلَ ، قَالَ : قَالَ رَجُلٌ لِعُثْمَانَ بْنِ أَبِی الْعَاصِ : ذَہَبْتُمْ بِالدُّنْیَا وَالآخِرَۃِ ، قَالَ : وَمَا ذَاکَ ؟ قَالَ : لَکُمْ أَمْوَالٌ تَصَدَّقُونَ مِنْہَا وَتَصِلُونَ مِنْہَا ، وَلَیْسَتْ لَنَا أَمْوَالٌ ، قَالَ : لَدِرْہَمٌ یَأْخُذُہُ أَحَدُکُمْ فَیَضَعُہُ فِی حَقٍّ أَفْضَلَ مِنْ عَشَرَۃِ آلاَفٍ یَأْخُذُہا أَحَدُنَا غَیضًا مِنْ فَیْضٍ فَلاَ یَجِدُ لَہَا مَسًّا۔","","Musannaf Ibn Abi Shaybah 31283","","","كتاب الأمراء"
"31284","(۳۱۲۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ یَحْیَی بْنِ الْحُصَیْنِ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، قَالَ : کَانَ بَیْنَ خَالِدِ بْنِ الْوَلِیدِ وَبَیْنَ سَعْدٍ کَلاَمُ ، قَالَ : فَتَنَاوَلَ رَجُلٌ خَالِدًا عِنْد سَعْدٍ ، فَقَالَ سَعْدٌ : مَہْ ، إنَّ مَا بَیْنَنَا لَمْ یَبْلُغْ دِینَنَا۔","Sahih","Musannaf Ibn Abi Shaybah 31284","","","كتاب الأمراء"
"31285","(۳۱۲۸۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، قَالَ : حدَّثَنِی مَنْ سَمِعَ سَالِمًا ، قَالَ : کَانَ عُمَرُ إذَا نَہَی النَّاسَ عَنْ شَیْئٍ جَمَعَ أَہْلَ بَیْتِہِ ، فَقَالَ : إنِّی نَہَیْت النَّاسَ عَنْ کَذَا وَکَذَا ، وَإنَّ النَّاسَ لَیَنْظُرُونَ إلَیْکُمْ نَظَرَ الطَّیْرِ إلَی اللَّحْمِ ، وَایْمُ اللہِ لاَ أَجِدُ أَحَدًا مِنْکُمْ فَعَلَہُ إلاَّ أَضْعَفْتُ لَہُ الْعُقُوبَۃَ ضِعْفَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 31285","","","كتاب الأمراء"
"31286","(۳۱۲۸۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الصَّبَاحِ بْنِ ثَابِتٍ ، قَالَ : کَانَ أَبِی یَسْمَعُ الْخَادِمَ تَسُبُّ الشَّاۃَ ، فَیَقُولُ : تَسُبِّینَ شَاۃً تَشْرَبِینَ مِنْ لَبَنِہَا۔","","Musannaf Ibn Abi Shaybah 31286","","","كتاب الأمراء"
"31287","(۳۱۲۸۷) حَدَّثَنَا مَرْحُومُ بْنُ عَبْدِ الْعَزِیزِ ، عَنْ مَالِکِ بْنِ دِینَارٍ سَمِعَہُ یَقُولُ : قَالَ سَالِمُ بْنُ عَبْدِ اللہِ : قَالَ لِی عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : اکْتُبْ إلَیَّ بِسُنَّۃِ عُمَرَ ، قَالَ : قُلْتُ : إنَّک إنْ عَمِلْت بِمَا عَمِلَ عُمَرُ فَأَنْتَ أَفْضَلُ مِنْ عُمَرَ ، إِنَّہُ لَیْسَ لَکَ مِثْلُ زَمَانِ عُمَرَ ، وَلاَ رِجَالٌ مِثْلُ رِجَالِ عُمَرَ۔","","Musannaf Ibn Abi Shaybah 31287","","","كتاب الأمراء"
"31288","(۳۱۲۸۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عُثْمَانَ بْنِ وَاقِدٍ عَمَّنْ حَدَّثَہُ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ وَہُوَ سَاجِدٌ فِی الْکَعْبَۃِ نَحْوَ الْحَجَرِ وَہُوَ یَقُولُ : إنِّی أَعُوذُ بِکَ مِنْ شَرِّ مَا تَسَوِّطُ۔","Da'if","Musannaf Ibn Abi Shaybah 31288","","","كتاب الأمراء"
"31289","(۳۱۲۸۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنِی عَبْدُ اللہِ بْنُ الْوَلِیدِ ، قَالَ : أَخْبَرَنِی عُمَرُ بْنُ أَیُّوبَ ، قَالَ : أَخْبَرَنِی أَبُو إیَاسٍ مُعَاوِیَۃُ بْنُ قُرَّۃَ ، قَالَ : کُنْتُ نَازِلاً عِنْدَ عَمْرِو بْنِ النُّعْمَانِ بْنِ مُقَرِّنٍ ، فَلَمَّا حضَرَ رَمَضَانُ ، جَائَہُ رَجُلٌ بِأَلْفَیْ دِرْہَمٍ مِنْ قِبَلِ مُصْعَبِ بْنِ الزُّبَیْرِ ، فَقَالَ : إنَّ الأَمِیرَ یُقْرِئُک السَّلاَمَ وَیَقُولُ : إنَّا لَمْ نَدَعْ قَارِئًا شَرِیفًا إلاَّ وَقَدْ وَصَلَ إلَیْہِ مِنَّا مَعْرُوفٌ ، فَاسْتَعِنْ بِہَذَیْنِ عَلَی نَفَقَۃِ شَہْرِکَ ہَذَا ، فَقَالَ عَمْرٌو : اقْرَأْ عَلَی الأَمِیرِ السَّلاَمَ ، وَقُلْ لَہُ : إنَّا وَاللہِ مَا قَرَأْنَا الْقُرْآنَ نُرِیدُ بِہِ الدُّنْیَا ، وَرَدَّہُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 31289","","","كتاب الأمراء"
"31290","(۳۱۲۹۰) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَاصِمِ بْنِ مُحَمَّدٍ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، قَالَ : بَیْنَا أَنَا جَالِسٌ فِی الْمَسْجِدِ الْحَرَامِ ، وَابْنُ عُمَرَ جَالِسٌ فِی نَاحِیَۃٍ وَابْنَاہُ عَنْ یَمِینِہِ وَشِمَالِہِ ، وَقَدْ خَطَبَ الْحَجَّاجُ بْنُ یُوسُفَ النَّاسَ ، فَقَالَ : أَلاَ إنَّ ابْنَ الزُّبَیْرِ نَکَّسَ کِتَابَ اللہِ ، نَکَّسَ اللَّہُ قَلْبَہُ ، فَقَالَ ابْنُ عُمَرَ : أَلاَ إنَّ ذَلِکَ لَیْسَ بِیَدِکَ ، وَلاَ بِیَدِہِ ، فَسَکَتَ الْحَجَّاجُ ہُنَیْہَۃً - إنْ شِئْتَ قُلْتَ طَوِیلاً ، وَإِنْ شِئْتَ قُلْتُ لَیْسَ بِطَوِیلٍ - ، ثُمَّ قَالَ : أَلاَ إنَّ اللَّہَ قَدْ عَلَّمَنَا وَکُلَّ مُسْلِمٍ وَإِیَّاکَ أَیُّہَا الشَّیْخُ ، أَنَّہُ ہُوَ نفعک ، قَالَ : فَجَعَلَ ابْنُ عُمَرَ یَضْحَکُ وَقَالَ لِمَنْ حَوْلَہُ : أَمَّا إنِّی قَدْ تَرَکْت الَّتِی فِیہَا الْفَضْلُ : أَنْ أَقُولَ : کَذَبْتَ۔","Sahih","Musannaf Ibn Abi Shaybah 31290","","","كتاب الأمراء"
"31291","(۳۱۲۹۱) حَدَّثَنَا مالک بن إسْمَاعِیلَ ، عَنْ کَامِلِ بْنِ حَبِیبٍ ، قَالَ : کَانَ الْعَبَّاسُ أَقْرَبَ شَحْمَۃِ أذَنٍ إلَی السَّمَائِ۔","","Musannaf Ibn Abi Shaybah 31291","","","كتاب الأمراء"
"31292","(۳۱۲۹۲) حَدَّثَنَا قَبِیصَۃُ ، قَالَ : حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَنِ الْوَلِیدِ بْنِ الْعَیْزَارِ ، قَالَ : بَیْنَمَا عَمْرُو بْنُ الْعَاصِ فِی ظِلِّ الْکَعْبَۃِ ، إذْ رَأَی الْحُسَیْنَ بْن عَلِیٍّ مُقْبِلاً ، فَقَالَ : ہَذَا أَحَبُّ أَہْلِ الأَرْضِ إلَی أَہْلِ السَّمَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 31292","","","كتاب الأمراء"
"31293","(۳۱۲۹۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ أَیْمَنَ ، قَالَ : قُلْتُ لِسَعِیدِ بْنِ جُبَیْرٍ : إنَّک قَادِمٌ عَلَی الْحَجَّاجِ فَانْظُرْ مَإِذَا تَقُولُ ، لاَ تَقُلْ مَا یَسْتَحِلُّ بِہِ دَمَک ، قَالَ : إنَّمَا یَسْأَلُنِی کَافِرٌ أَنَا أَوْ مُؤْمِنٌ ؟ فَلَمْ أَکُنْ لأَشْہَدَ عَلَی نَفْسِی بِالْکُفْرِ وَأَنَا لاَ أَدْرِی أَنْجُو مِنْہُ أَمْ لاَ۔","","Musannaf Ibn Abi Shaybah 31293","","","كتاب الأمراء"
"31294","(۳۱۲۹۴) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنِ النُّعْمَانِ ، قَالَ : کَتَبَ عُمَرُ إلَی مُعَاوِیَۃَ : الْزَمِ الْحَقَّ یَلْزَمْک الْحَقُّ۔","","Musannaf Ibn Abi Shaybah 31294","","","كتاب الأمراء"
"31295","(۳۱۲۹۵) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُبَیْدٍ ، قَالَ : قَالَ عُمَرُ : نَسْتَعِینُ بِقُوَّۃِ الْمُنَافِقِ وَإِثْمُہُ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 31295","","","كتاب الأمراء"
"31296","(۳۱۲۹۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ ابْنِ شُبْرُمَۃَ ، قَالَ : سَمِعْتُ الْفَرَزْدَقَ یَقُولُ : کَانَ ابْنُ حِطَّانَ مِنْ أَشْعَرِ النَّاسِ۔","","Musannaf Ibn Abi Shaybah 31296","","","كتاب الأمراء"
"31297","(۳۱۲۹۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، قَالَ : کُنْتُ إذَا لَقِیت عُبَیْد اللہِ بْنَ عَبْدِ اللہِ فَکَأَنَّمَا أُفَجِّرُ بِہِ بَحْرًا۔","","Musannaf Ibn Abi Shaybah 31297","","","كتاب الأمراء"
"31298","(۳۱۲۹۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حَمْزَۃَ أَبِی عُمَارَۃَ ، قَالَ : قَالَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ لِعُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ : مَالَک وَلِلشِّعْرِ ، قَالَ : ہَلْ یَسْتَطِیعُ الْمَصْدُورُ إلاَّ أَنْ یَنْفِثَ۔","","Musannaf Ibn Abi Shaybah 31298","","","كتاب الأمراء"
"31299","(۳۱۲۹۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا سُلَیْمُ بْنُ أَخْضَرَ ، قَالَ : حَدَّثَنَا ابْنُ عَوْنٍ ، قَالَ : کَانَ مُسْلِمُ بْنُ یَسَارٍ أَرْفَعَ عِنْدَ أَہْلِ الْبَصْرَۃِ مِنَ الْحَسَنِ ، حَتَّی خَفَّ مَعَ ابْنِ الأَشْعَثِ وَکَفُّ الآخَرُ ، فَلَمْ یَزَلْ أَبُو سَعِیدٍ فِی عُلوّ مِنْہَا وَسَقَطَ الآخَرُ۔","","Musannaf Ibn Abi Shaybah 31299","","","كتاب الأمراء"
"31300","(۳۱۳۰۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : أَخْبَرَنِی عَبْدُ الرَّحْمَنِ بْنُ ثَوْبَان ، قَالَ : أَخْبَرَنِی عُمَیْرُ بْنُ ہَانِئٍ ، قَالَ : أَخْبَرَنِی مُنْقِذٌ صَاحِبُ الْحَجَّاجِ : أَنَّ الْحَجَّاجَ لَمَّا قَتَلَ سَعِیدَ بْنَ جُبَیْرٍ مَکَثَ ثَلاَثَ لَیَالٍ یَقُولُ : مَالِی وَلِسَعِیدِ بْنِ جُبَیْرٍ۔","","Musannaf Ibn Abi Shaybah 31300","","","كتاب الأمراء"
"31301","(۳۱۳۰۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ الْمُرَادِیِّ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، قَالَ : بَیْنَا شَاعِرٌ یَوْمَ صِفِّینَ یُنْشِدُ ہِجَائً لِمُعَاوِیَۃَ وَعَمْرِو بْنِ الْعَاصِ ، قَالَ : وَعَمَّارٌ یَقُولُ : الْزَق بِالْعَجُوزَیْنِ ، قَالَ : فَقَالَ رَجُلٌ : سُبْحَانَ اللہِ ، تَقُولُ ہَذَا وَأَنْتُمْ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ لَہُ عَمَّارٌ : إنْ شِئْت أَنْ تَجْلِسَ فَاجْلِسْ ، وَإِنْ شِئْت أَنْ تَذْہَبَ فَاذْہَبْ۔","Hasan","Musannaf Ibn Abi Shaybah 31301","","","كتاب الأمراء"
"31302","(۳۱۳۰۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ حَبِیبٍ بْنِ الشَّہِیدِ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، قَالَ : کَانَ ابْنُ عُمَرَ یَقُولُ : رَحِمَ اللَّہُ ابْنَ الزُّبَیْرِ ، أَرَادَ دَنَانِیرَ الشَّامِ ، رَحِمَ اللَّہُ مَرْوَانَ أَرَادَ دَرَاہِمَ الْعِرَاقِ۔","Sahih","Musannaf Ibn Abi Shaybah 31302","","","كتاب الأمراء"
"31303","(۳۱۳۰۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَتَبَ زِیَادٌ إلَی الْحَکَمِ بْنِ عَمْرٍو الْغِفَارِیِّ وَہُوَ عَلَی خُرَاسَانَ: إِنَّ أَمِیرَ الْمُؤْمِنِینَ کَتَبَ: أَنْ تُصْطَفَی لَہُ الصَّفْرَائُ وَالْبَیْضَائُ ، فَلاَ یُقَسَّمُ بَیْنَ النَّاسِ ذَہَبًا وَلاَ فِضَّۃً، فَکَتَبَ إلَیْہِ: بَلَغَنِی کِتَابُک، تَذْکُرُ أَنَّ أَمِیرَ الْمُؤْمِنِینَ کَتَبَ أَنْ تُصْطَفَی لَہُ الْبَیْضَائُ وَالصَّفْرَائُ، وَأَنِّی وَجَدْت کِتَابَ اللہِ قَبْلَ کِتَابِ أَمِیرِ الْمُؤْمِنِینَ ، وَإِنَّہُ وَاللہِ لَوْ أَنَّ السَّمَاوَاتِ وَالأَرْضَ کَانَتَا رَتْقًا عَلَی عَبْدٍ ثُمَّ اتَّقَی اللَّہَ جَعَلَ اللَّہُ لَہُ مَخْرَجًا ، وَالسَّلاَمُ عَلَیْکُمْ ، ثُمَّ قَالَ لِلنَّاسِ : اغْدُوَا عَلَیَّ بِمَالِکُمْ ، فَغَدَوْا ، فَقَسمَہُ بَیْنَہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 31303","","","كتاب الأمراء"
"31304","(۳۱۳۰۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عُمَرَ بْنِ عَلِیٍّ ، قَالَ : قَالَ عَلِیٌّ : مَا زَالُ الزُّبَیْرِ کَأَنَّہُ رَجُلٌ مِنَّا أَہْلَ الْبَیْتِ حَتَّی أَدْرَکَ بُنَیَّہُ عَبْدُ اللہِ فَلَفَتَہُ عَنَّا۔","","Musannaf Ibn Abi Shaybah 31304","","","كتاب الأمراء"
"31305","(۳۱۳۰۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی شُرَاعَۃَ ، عَنْ عُبَادَۃَ بْنِ نُسَیٍّ ، قَالَ : ذَکَرُوا الشُّعَرَاء عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَذَکَرُوا امْرَأَ الْقِیسِ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَذْکُورٌ فِی الدُّنْیَا مَذْکُورٌ فِی الآخِرَۃِ: حَامِلٌ لِوَائَ الشِّعْرِ یَوْمَ الْقِیَامَۃِ فِی جَہَنَّمَ ، أَو قَالَ فِی النَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 31305","","","كتاب الأمراء"
"31306","(۳۱۳۰۶) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہُنَیْدَۃَ بْنِ خَالِدٍ الْخُزَاعِیِّ ، قَالَ : أَوَّلُ رَأْسٍ أُہْدِیَ فِی الإسْلاَمِ : رَأْسُ ابْنِ الْحَمِق۔","","Musannaf Ibn Abi Shaybah 31306","","","كتاب الأمراء"
"31307","(۳۱۳۰۷) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی الْجُوَیْرِیَۃِ الْجَرْمِیِّ ، قَالَ : کُنْتُ فِیمَنْ صَارَ إلَی أَہْلِ الشَّامِ یَوْمَ الْخَازِرِ ، فَالْتَقَیْنَا ، فَہَبَّ الرِّیحُ عَلَیْہِمْ ، فَأَدْبَرُوا ، فَقَتَلْنَاہُمْ عَشِیَّتَنَا وَلَیْلَتَنَا حَتَّی أَصْبَحْنَا ، قَالَ : فَقَالَ : إبْرَاہِیمُ۔ یَعْنِی : ابْنَ الأَشْتَرِ : إِنِّی قَتَلْت الْبَارِحَۃَ رَجُلاً وَإِنِّی وَجَدْت مِنْہُ رِیحَ طِیبٍ ، وَمَا أُرَاہُ إلاَّ ابْنَ مَرْجَانَۃَ ، شَرَّقَتْ رِجْلاَہُ وَغَرَّبَ رَأْسُہُ ، أَوْ شَرَّقَ رَأْسُہُ وَغَرَّبَتْ رِجْلاَہُ ، قَالَ : فَانْطَلَقْت فَإِذَا ہُوَ وَاللہِ ہُوَ۔","","Musannaf Ibn Abi Shaybah 31307","","","كتاب الأمراء"
"31308","(۳۱۳۰۸) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنِی الْعَلاَئُ بْنُ الْمِنْہَالِ الْغَنَوِیُّ ، قَالَ : حَدَّثَنِی أَبُو الْجَہْمِ الْقُرَشِیُّ ، عَنْ أَبِیہِ ، قَالَ : بَلَغَ عَلِیًّا عَنِّی شَیْئٌ فَضَرَبَنِی أَسْوَاطًا ، ثُمَّ بَلَغَہُ بَعْدَ ذَلِکَ أَنَّ مُعَاوِیَۃَ کَتَبَ إلَیْہِ ، فَأَرْسَلِ رَجُلَیْنِ یُفَتِّشَانِ مَنْزِلَہُ ، فَوَجَدَا الْکِتَابَ فِی مَنْزِلِہِ ، فَقَالَ لأَحَدِ الرَّجُلَیْنِ وَہُوَ مِنْ الْعَشِیرَۃِ : إنَّک مِنَ الْعَشِیرَۃِ فَاسْتُرْ عَلَیَّ ، قَالَ : فَأَتَیَا عَلِیًّا فَأَخْبَرَاہُ ، قَالَ : فَرَکِبَ عَلِیٌّ وَرَکِبَ أَبِی ، فَقَالَ لأَبِی : أَمَا إنَّا فَتَّشْنَا عَلَیْہِ ذَلِکَ فَوَجَدْنَاہُ بَاطِلاً ، قَالَ : مَا ضَرَبَنِی فِیہِ أَبْطَلُ۔","Da'if","Musannaf Ibn Abi Shaybah 31308","","","كتاب الأمراء"
"31309","(۳۱۳۰۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، حَدَّثَنَا شَیْبَانُ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، قَالَ : حدَّثَنِی مَنْ سَمِعَ عُمَرَ یَقُولُ إذَا رَأَی الْمُغِیرَۃَ بْنَ شُعْبَۃَ : وَیْحَک یَا مُغِیرَۃُ ، وَاللہِ مَا رَأَیْتُک قَطُّ إلاَّ خَشِیت۔","Da'if","Musannaf Ibn Abi Shaybah 31309","","","كتاب الأمراء"
"31310","(۳۱۳۱۰) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا شَیْبَانُ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللہِ بْنِ سِنَانٍ ، قَالَ : خَرَجَ إلَیْنَا ابْنُ مَسْعُودٍ وَنَحْنُ فِی الْمَسْجِدِ ، فَقَالَ : یَا أَہْلَ الْکُوفَۃِ فُقِدَت مِنْ بَیْتِ مَالِکُمُ اللَّیْلَۃَ مِئَۃَ أَلْفٍ لَمْ یَأْتِنِی بِہَا کِتَابٌ مِنْ أَمِیرِ الْمُؤْمِنِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 31310","","","كتاب الأمراء"
"31311","(۳۱۳۱۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا فِطْرٌ ، قَالَ : حَدَّثَنَا مُنْذِرٌ الثَّوْرِیُّ ، عَنْ مُحَمَّدِ بْنِ عَلِیِّ ابْنِ الْحَنَفِیَّۃِ ، قَالَ : اتَّقُوا ہَذِہِ الْفِتَنَ فَإِنَّہُ لاَ یُشْرِفُ لَہَا أَحَدٌ إلاَّ انْتَسَفَتْہُ ، أَلاَ إنَّ ہَؤُلاَئِ الْقَوْمَ لَہُمْ أَجَلٌ وَمُدَّۃٌ ، لَوْ أَجْمَعَ مَنْ فِی الأَرْضِ أَنْ یُزِیلُوا مُلْکَہُمْ لَمْ یَقْدِرُوا عَلَی ذَلِکَ حَتَّی یَکُونَ اللَّہُ ہُوَ الَّذِی یَأْذَنُ فِیہِ ، أَتَسْتَطِیعُونَ أَنْ تُزِیلُوا ہَذِہِ الْجِبَالَ ؟!۔","","Musannaf Ibn Abi Shaybah 31311","","","كتاب الأمراء"
"31312","(۳۱۳۱۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا مِسْعَرٌ ، حَدَّثَنِی أَبُو بَکْرِ بْنُ عَمْرِو بْنِ عُتْبَۃَ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : بَعَثَنِی سَعْدٌ أَقْسِمُ بَیْنَ الزُّبَیْرِ وَخَبَّابٍ أَرْضًا ، فَتَرَامَیَا بِالْجَنْدَلِ ، فَرَجَعْت فَأَخْبَرْت سَعْدًا ذَلِکَ ، فَضَحِکَ حَتَّی ضَرَبَ بِرِجْلِہِ ، وَقَالَ : فِی الأَرْضِ مِثْلُ ہَذَا الْمَسْجِدِ ، أَو قلََّ مَا یَزِیدُ عَلَیْہِ ، قَالَ : فَہَلا رَدَدْتہمَا۔","Da'if","Musannaf Ibn Abi Shaybah 31312","","","كتاب الأمراء"
"31313","(۳۱۳۱۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا مِسْعَرٌ ، حَدَّثَنَا سَعِیدُ بْنُ شَیْبَانَ ، عَمَّنْ حَدَّثَہُ ، عَنْ عَدِیِّ بْنِ حَاتِمٍ قُدِّمَ إلَیْہِ لَحْمُ جَدَاوِلاً ، فَقَالَ : انْہشُوا نَہْشًا۔","Da'if","Musannaf Ibn Abi Shaybah 31313","","","كتاب الأمراء"
"31314","(۳۱۳۱۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لَمَّا بُویِعَ لِعَلِیٍّ أَتَانِی فَقَالَ : إنَّک امْرُؤٌ مُحَبَّبٌ فِی أَہْلِ الشَّام ، وَقَدِ اسْتَعْمَلْتُک عَلَیْہِمْ ، فَسِرْ إلَیْہِمْ ، قَالَ : فَذَکَرْت الْقَرَابَۃَ وَذَکَرْت الصِّہْر ، فَقُلْتُ : أَمَّا بَعْدُ فَوَاللہِ لاَ أُبَایِعُک ، قَالَ : فَتَرَکَنِی وَخَرَجَ ، فَلَمَّا کَانَ بَعْدَ ذَلِکَ جَائَ ابْنُ عُمَرَ إلَی أُمِّ کُلْثُومٍ فَسَلَّمَ عَلَیْہَا وَتَوَجَّہَ إلَی مَکَّۃَ ، فَأُتِیَ عَلِیٌّ رحمہ اللہ فَقِیلَ لَہُ : إنَّ ابْنَ عُمَرَ قَدْ تَوَجَّہَ إلَی الشَّامِ ، فَاسْتَنْفِرَ النَّاسَ ، قَالَ : فَإِنْ کَانَ الرَّجُلُ لَیَعْجَلُ حَتَّی یُلْقِیَ رِدَائَہُ فِی عُنُقِ بَعِیرِہِ ، قَالَ : وَأَتَیْت أُمَّ کُلْثُومٍ فَأُخْبِرَتْ ، فَأَرْسَلتْ إلَی أَبِیہَا : مَا ہَذَا الَّذِی تَصْنَعُ ، قَدْ جَائَنِی الرَّجُلُ فَسَلَّمَ عَلَیَّ ، وَتَوَجَّہَ إلَی مَکَّۃَ ، فَتَرَاجَعَ النَّاسُ۔","Sahih","Musannaf Ibn Abi Shaybah 31314","","","كتاب الأمراء"
"31315","(۳۱۳۱۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ دَاوُدَ بْنِ شَابُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کُنَّا نَفْخَرُ عَلَی النَّاسِ بِأَرْبَعَۃٍ : بِفَقِیہِنَا وَقَاصِّنَا وَمُؤَذِّنِنَا وَقَارِئِنَا ، فَفَقِیہُنَا : ابْنُ عَبَّاسٍ ، وَمُؤَذِّنُنَا : أَبُو مَحْذُورَۃَ ، وَقَاصُّنَا : عُبَیْدُ بْنُ عُمَیْرٍ ، وَقَارِئُنَا : عَبْدُ اللہِ بْنُ السَّائِبِ۔","","Musannaf Ibn Abi Shaybah 31315","","","كتاب الأمراء"
"31316","(۳۱۳۱۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ دَاوُدَ بْنِ شَابُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لَمَّا أَجْمَعَ ابْنُ الزُّبَیْرِ عَلَی ہَدْمِہَا ، خَرَجْنَا إلَی مِنًی ، نَنْتَظِرُ الْعَذَابَ ، یَعْنِی ہَدْمَ الْکَعْبَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 31316","","","كتاب الأمراء"
"31317","(۳۱۳۱۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مَنْصُورٍ بْنِ صَفِیَّۃَ ، عَنْ أُمِّہِ ، قَالَتْ : دَخَلَ ابْنُ عُمَرَ الْمَسْجِدَ ، وَابْنُ الزُّبَیْرِ مَصْلُوبٌ ، فَقَالُوا لَہُ : ہَذِہِ أَسْمَائُ ، فَأَتَاہَا فَذَکَّرَہَا وَوَعَظَہَا ، وَقَالَ : إنَّ الْجُثَّۃُ لَیْسَتْ بِشَیْئٍ ، وَإِنَّمَا الأَرْوَاحُ عِنْدَ اللہِ ، فَاصْبِرِی وَاحْتَسِبِی ، فَقَالَتْ : مَا یَمْنَعُنِی مِنَ الصَّبْرِ ، وَقَدْ أُہْدِیَ رَأْسُ یَحْیَی بْنُ زَکَرِیَّا إلَی بَغِیٍّ مِنْ بَغَایَا بَنِی إسْرَائِیلَ۔","Sahih","Musannaf Ibn Abi Shaybah 31317","","","كتاب الأمراء"
"31318","(۳۱۳۱۸) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : أَتَیْتُ أَسْمَائَ بَعْدَ قَتْلِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ فَقَالَتْ : بَلَغَنِی أَنَّہُمْ صَلَبُوا عَبْدَ اللہِ مُنَکَّسًا وَعَلَّقُوا مَعَہُ الْہِرَّۃَ ، وَاللہِ لَوَدِدْت أَنِّی لاَ أَمُوتُ حَتَّی یُدْفَعَ إلَیَّ فَأُغَسِّلَہُ وَأُحَنِّطَہُ وَأُکَفِّنَہُ ، ثُمَّ أَدْفِنَہُ ، فَمَا لَبِثُوا أَنْ جَائَہُ کِتَابُ عَبْدِ الْمَلِکِ أَنْ یُدْفَعَ إلَی أَہْلِہِ ، قَالَ : فَأُتِیَتْ بِہِ أَسْمَائَ فَغَسَّلَتْہُ وَحَنَّطَتْہُ وَکَفَّنَتْہُ ، ثُمَّ دَفَنَتْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31318","","","كتاب الأمراء"
"31319","(۳۱۳۱۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ ، قَالَ : دَخَلْت أَنَا وَعَبْدُ اللہِ بْنُ الزُّبَیْرِ عَلَی أَسْمَائَ قَبْلَ قَتْلِ عَبْدِ اللہِ بِعَشْرِ لَیَالٍ ، وَأَسْمَائُ وَجِعَۃٌ ، فَقَالَ لَہَا عَبْدُ اللہِ : کَیْفَ تَجِدِینَک ، قَالَتْ : وَجِعَۃً ، قَالَ : إنَّ فِی الْمَوْتِ لَعَافِیَۃً ، قَالَتْ : لَعَلَّکَ تشمتُ بِمَوْتِی فَلِذَلِکَ تَتَمَنَّاہُ ؟ فَلاَ تَفْعَلْ ، فَوَاللہِ مَا أَشْتَہِی أَنْ أَمُوتَ حَتَّی یَأْتِیَ عَلَیَّ أَحَد طَرفَیْک ، إمَّا أَنْ تُقْتَلَ فَأَحْتَسِبَک ، وَإِمَّا تَظْہَرَ فَتَقَرُّ عَیْنِی ، فَإِیَّاکَ أَنْ تُعْرَضَ عَلَیْک خِطَّۃ لاَ تُوَافِقُک ، فَتَقْبَلُہَا کَرَاہَۃَ الْمَوْتِ ، قَالَ : وَإِنَّمَا عَنَی ابْنُ الزُّبَیْرِ لَیُقْتَل فَیُحْزِنُہَا ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 31319","","","كتاب الأمراء"
"31320","(۳۱۳۲۰) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ أَبِیہِ ، قَالَ : أَخْبَرَنِی أَبِی : أَنَّ الْحَجَّاجَ حِینَ قَتَلَ ابْنَ الزُّبَیْرِ جَائَ بِہِ إلَی مِنًی فَصَلَبَہُ عِنْدَ الثَّنِیَّۃِ فِی بَطْنِ الْوَادِی ، ثُمَّ قَالَ لِلنَّاسِ : انْظُرُوا إلَی ہَذَا ! ہَذَا شَرِّ الأُمَّۃِ ، فَقَالَ : إنِّی رَأَیْت ابْنَ عُمَرَ جَائَ عَلَی بَغْلَۃٍ لَہُ فَذَہَبَ لِیُدْنِیَہَا مِنَ الْجِذْعِ فَجَعَلَتْ تَنْفِرُ ، فَقَالَ لِمَوْلاَہُ : وَیْحَک خُذْ بِلِجَامِہَا فَأَدْنِہَا ، قَالَ : فَرَأَیْتہ أَدْنَاہَا فَوَقَفَ عَبْدُ اللہِ بْنُ عُمَرَ وَہُوَ یَقُولُ : رَحِمَک اللَّہُ ، إنْ کُنْت لَصَوَّامًا قَوَّامًا ، وَلَقَدْ أَفْلَحَتْ أُمَّۃٌ أَنْتَ شَرُّہَا۔","Da'if","Musannaf Ibn Abi Shaybah 31320","","","كتاب الأمراء"
"31321","(۳۱۳۲۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شَمِرٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، قَالَ : حدَّثَنِی الْبَرِیدُ الَّذِی جَائَ بِرَأْسِ الْمُخْتَارِ إلَی عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، قَالَ : فَلَمَّا وَضَعْتہُ بَیْنَ یَدَیْہِ ، قَالَ : مَا حَدَّثَنِی کَعْبٌ بِحَدِیثٍ إلاَّ رَأَیْت مِصْدَاقَہُ غَیْرَ ہَذَا ، فَإِنَّہُ حَدَّثَنِی أَنَّہُ یَقْتُلُنِی رَجُلٌ مِنْ ثَقِیفٍ ، أُرَانِی أَنَا الَّذِی قَتَلْتہ۔","Da'if","Musannaf Ibn Abi Shaybah 31321","","","كتاب الأمراء"
"31322","(۳۱۳۲۲) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی ، عَنْ أَبِیہِ یَعْلَی بْنِ حَرْمَلَۃَ ، قَالَ : تَکَلَّمَ الْحَجَّاجُ یَوْمَ عَرَفَۃَ بِعَرَفَاتٍ فَأَطَالَ الْکَلاَمُ ، فَقَالَ عَبْدُ اللہِ بْنُ عُمَرَ : أَلاَ إِنَّ الْیَوْمَ یَوْمُ ذِکْرٍ ، قَالَ : فَمَضَی الْحَجَّاجُ فِی خُطْبَتِہِ ، قَالَ : فَأَعَادَہَا عَبْدُ اللہِ مَرَّتَیْنِ ، أَوْ ثَلاَثًا ، ثُمَّ قَالَ : یَا نَافِعُ نَادِ بِالصَّلاَۃِ ، فَنَزَلَ الْحَجَّاجُ۔","Da'if","Musannaf Ibn Abi Shaybah 31322","","","كتاب الأمراء"
"31323","(۳۱۳۲۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ أَخْبَرَنَا قَیْسٌ ، قَالَ : قَالَ عُمَرُ : أَلاَ تُخْبِرانِی عَنْ منْزِلَیکُمْ ہَذَیْنِ ، وَمَعَ ہَذَا إنِّی لأَسْأَلُکُمَا ، وَإِنِّی لأَتَبَیَّنُ فِی وُجُوہِکُمَا أَیُّ الْمَنْزِلَیْنِ خَیْرٌ ، قَالَ : فَقَالَ لَہُ جَرِیرٌ : أَنَا أُخْبِرُک یَا أَمِیرَ الْمُؤْمِنِینَ ، أَمَّا إحْدَی الْمَنْزِلَتَیْنِ : فَأَدْنَی نَخْلَۃٍ بِالسَّوَادِ إلَی أَرْضِ الْعَرَبِ ، وَأَمَّا الْمَنْزِلُ الآ خَرُ : فَأَرْضُ فَارِسٍ ، وَعْکُہَا وَحَرُّہَا وَبَقُّہَا۔ یَعْنِی : الْمَدَائِنَ ، قَالَ : فَکَذَّبَنِی عَمَّارٌ ، فَقَالَ : کَذَبْت ، فَقَالَ عُمَرُ : أَنْتَ أَکْذَبُ ، ثُمَّ قَالَ عُمَرُ : أَلاَ تُخْبِرُونِی عَنْ أَمِیرِکُمْ ہَذَا أَمُجْزِیئٌ ہُوَ ؟ قُلْتُ : وَاللہِ مَا ہُوَ بِمُجْزِیئٍ وَلاَ کَافٍ وَلاَ عَالِمٌ بِالسِّیَاسَۃِ ، فَعَزَلَہُ وَبَعَثَ الْمُغِیرَۃَ بْنَ شُعْبَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 31323","","","كتاب الأمراء"
"31324","(۳۱۳۲۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ ، عَنْ قَیْسٍ ، قَالَ : کَانَ بَیْنَ ابْنِ مَسْعُودٍ وَالْوَلِیدِ بْنِ عُقْبَۃَ حَسَنٌ ، قَالَ : فَدَعَا عَلَیْہِمَا سَعْدٌ ، فَقَالَ : اللَّہُمَّ أَمِسَّ بَیْنَہُمَا ، فَکَانَ أَحَدُہُمَا یَقُولُ لِصَاحِبِہِ : لَقَدْ أُجِیبَ فِینَا سَعْدٌ۔","Sahih","Musannaf Ibn Abi Shaybah 31324","","","كتاب الأمراء"
"31325","(۳۱۳۲۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ طَاوسٍ ، قَالَ : ذَکَرْت الأُمَرَائَ عِنْدَ ابْنِ عَبَّاسٍ ، فَابْتَرَک فِیہِمْ رَجُلٌ فَتَطَاوَلَ حَتَّی مَا أَرَی فِی الْبَیْتِ أَطْوَلَ مِنْہُ ، فَسَمِعْت ابْنَ عَبَّاسٍ یَقُولُ : یَا ہَزَہَازُ ، لاَ تَجْعَلْ نَفْسَک فِتْنَۃً لِلظَّالِمِینَ ، فَتَقَاصَرَ حَتَّی مَا رَأَیْت فِی الْقَوْمِ أَقْصَرَ مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31325","","","كتاب الأمراء"
"31326","(۳۱۳۲۶) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ الأَسَدِیُّ ، قَالَ : أَخْبَرَنَا یَحْیَی بْنُ الْمُہَلَّبِ أَبُو کُدَیْنَۃَ ، عَنِ الأَعْمَشِ ، قَالَ : ذَکَرُوا عِنْدَ ابْنِ عُمَرَ الْخُلَفَائَ وَحُبَّ النَّاسُ تَغْیِیرَہُمْ ، فَقَالَ ابْنُ عُمَرَ : لَوْ وَلِیَ النَّاسَ صَاحِبُ ہَذِہِ السَّارِیَۃِ مَا رَضُوا بِہِ۔ یَعْنِی : عَبْدَ الْمَلِکِ بْنَ مَرْوَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 31326","","","كتاب الأمراء"
"31327","(۳۱۳۲۷) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ الأَسَدِیُّ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ أَبِی الْجَحَّافِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ عَلِیٍّ ، قَالَ: إنَّ حُمَۃً کَحُمَۃِ الْعَقْرَبِ ، فَإِذَا کَانَ ذَلِکَ فَالْحَقُوا بِعَمَّتِکُمُ النَّخْلَۃِ۔ یَعْنِی: السَّوَادَ۔","Da'if","Musannaf Ibn Abi Shaybah 31327","","","كتاب الأمراء"
"31328","(۳۱۳۲۸) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ، قَالَ: حدَّثَنَا شَرِیکٌ، عَنْ دَاوُدَ، عَنْ رَجُلٍ، عَنْ عَلِیٍّ: أَنَّہُ قَالَ: سَتَکُونُ عَکَرَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 31328","","","كتاب الأمراء"
"31329","(۳۱۳۲۹) حَدَّثَنَا مُحَمَّدُ بْنُ کُنَاسَۃَ ، قَالَ : حدَّثَنَا إِسْحَاقُ بْنُ سَعِیدٍ ، عَنْ أَبِیہِ ، قَالَ : أَتَی مُصْعَبُ بْنُ الزُّبَیْرِ عَبْدَ اللہِ بْنَ عُمَرَ وَہُوَ یَطُوفُ بَیْنَ الصَّفَا وَالْمَرْوَۃِ ، فَقَالَ : مَنْ أَنْتَ ؟ فَقَالَ : ابْنُ أَخِیک مُصْعَبُ بْنُ الزُّبَیْرِ ، قَالَ: صَاحِبُ الْعِرَاقِ ؟ قَالَ : نَعَمْ ، جِئْتُک لأَسْأَلَک عَنْ قَوْمٍ خَلَعُوا الطَّاعَۃَ ، وَسَفَکُوا الدِّمَائَ ، وَجَبَوا الأَمْوَالَ ، فَقُوتِلُوا فَغُلِبُوا فَدَخَلُوا قَصْرًا فَتَحَصَّنُوا فِیہِ ، ثُمَّ سَأَلُوا الأَمَانَ فَأُعْطُوہُ ، ثُمَّ قُتِلُوا ؟ قَالَ : وَکَمَ الْعِدَّۃُ ؟ قَالَ : خَمْسَۃُ آلاَفٍ ، قَالَ : فَسَبَّحَ ابْنُ عُمَرَ عِنْدَ ذَلِکَ ، وَقَالَ : عَمْرَکَ اللہِ یَا ابْنَ الزُّبَیْرِ ! لَوْ أَنَّ رَجُلاً أَتَی مَاشِیَۃً لِلزُّبَیْرِ فَذَبَحَ مِنْہَا فِی غَدَاۃٍ خَمْسَۃَ آلاَفٍ أَکُنْتَ تَرَاہُ مُسْرِفًا ؟ قَالَ : نَعَمْ ، قَالَ : فَتَرَاہُ إسْرَافًا فِی بَہَائِمَ لاَ تَدْرِی مَا اللَّہُ ، وَتَسْتَحِلُّہُ مِمَّنْ ہَلَّلَ اللَّہَ یَوْمًا وَاحِدًا ؟۔","Sahih","Musannaf Ibn Abi Shaybah 31329","","","كتاب الأمراء"
"31330","(۳۱۳۳۰) حَدَّثَنَا مُحَمَّدُ بْنُ کُنَاسَۃَ ، عَنْ إِسْحَاقَ بْنِ سَعِیدٍ ، عَنْ أَبِیہِ ، قَالَ : أَتَی عَبْدُ اللہِ بْنُ عُمَرَ عَبْدَ اللہِ بْنَ الزُّبَیْرِ ، فَقَالَ : یَا ابْنَ الزُّبَیْرِ ، إیَّاکَ وَالإِلْحَادَ فِی حَرَمِ اللہِ ، فَإِنِّی سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : سَیُلْحِدُ فِیہِ رَجُلٌ مِنْ قُرَیْشٍ لَوْ أَنَّ ذُنُوبَہُ تُوزَنُ بِذُنُوبِ الثَّقَلَیْنِ لَرَجَحَتْ عَلَیْہِ۔ فَانْظُرْ لاَ تَکُنْہُ۔n(احمد ۱۳۶۔ حاکم ۳۸۸)","","Musannaf Ibn Abi Shaybah 31330","","","كتاب الأمراء"
"31331","(۳۱۳۳۱) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنِ الْمُثَنَّی بْنِ سَعِیدٍ ، عَنْ أَبِی سُفْیَانَ ، قَالَ : خَطَبَنَا ابْنُ الزُّبَیْرِ فَقَالَ : إنَّا قَدِ اُبْتُلِینَا بِمَا قَدْ تَرَوْنَ ، فَمَا أَمَرْنَاکُمْ بِأَمْرٍ لِلَّہِ فِیہِ طَاعَۃٌ فَلَنَا عَلَیْکُمْ فِیہِ السَّمْعُ وَالطَّاعَۃُ ، وَمَا أَمَرْنَاکُمْ بِأَمْرٍ لَیْسَ لِلَّہِ فِیہِ طَاعَۃٌ فَلَیْسَ لَنَا عَلَیْکُمْ فِیہِ طَاعَۃٌ ، وَلاَ نِعْمَۃُ عَیْنٍ۔","Hasan","Musannaf Ibn Abi Shaybah 31331","","","كتاب الأمراء"
"31332","(۳۱۳۳۲) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ حَارِثَۃَ بْنِ مُضَرِّبٍ ، عَنْ عَلِیٍّ : أَنَّہُ خَطَبَ ثُمَّ قَالَ : إنَّ ابْنَ أَخِیکُمَ الْحَسَنَ بْنَ عَلِیٍّ قَدْ جَمَعَ مَالاً وَہُوَ یُرِیدُ أَنْ یُقَسِّمَہُ بَیْنَکُمْ ، فَحَضَرَ النَّاسُ فَقَامَ الْحَسَنُ ، فَقَالَ : إنَّمَا جَمَعْتہ لِفُقَرَائِکُمْ ، فَقَامَ نِصْفُ النَّاسِ ، ثُمَّ کَانَ أَوَّلُ مَنْ أَخَذَ مِنْہُ الأَشْعَثُ بْنُ قَیْسٍ۔","","Musannaf Ibn Abi Shaybah 31332","","","كتاب الأمراء"
"31333","(۳۱۳۳۳) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہَانِئٍ ، عَنْ عَلِیٍّ ، قَالَ : لَیُقْتَلَنَّ الْحُسَیْنُ ظُلْمًا ، وَإِنِّی لاَعْرَفُ تُرْبَۃَ الأَرْضِ الَّتِی یُقْتَلُ فِیہَا : قَرِیبًا مِنَ النَّہْرَیْنِ۔ (طبرانی ۲۸۲۴)","","Musannaf Ibn Abi Shaybah 31333","","","كتاب الأمراء"
"31334","(۳۱۳۳۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ السُّلَمِیِّ ، قَالَ : جَائَ الأَشْعَثُ بْنُ قَیْسٍ فَجَلَسَ إلَی کَعْبِ بْنِ عُجْرَۃَ فِی الْمَسْجِدِ فَوَضَعَ إحْدَی رِجْلَیْہِ عَلَی الأُخْرَی ، فَقَالَ لَہُ کَعْبٌ : ضَعْہَا ، فَإِنَّہَا لاَ تَصْلُحُ لِبَشَرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31334","","","كتاب الأمراء"
"31335","(۳۱۳۳۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ مَالِکِ بْنِ الْحَارِثِ ، عَنْ أَبِی خَالِدٍ ، قَالَ : وَفَدْت إلَی عُمَرَ فَفَضَّلَ أَہْلَ الشَّامِ عَلَیْنَا فِی الْجَائِزَۃِ ، فَقُلْنَا لَہُ ، فَقَالَ : یَا أَہْلَ الْکُوفَۃِ ، أَجَزِعْتُمْ أَنِّی فَضَّلْت عَلَیْکُمْ أَہْلَ الشَّامِ فِی الْجَائِزَۃِ ، لِبُعْدِ شُقَّتکُمْ ، فَقَدْ آثَرْتُکُمْ بِابْنِ أُمِّ عَبْدِ۔","Sahih","Musannaf Ibn Abi Shaybah 31335","","","كتاب الأمراء"
"31336","(۳۱۳۳۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ سَالِمِ بْنِ أَبِی حَفْصَۃَ ، عَنْ مُنْذِرٍ ، قَالَ : کُنْتُ عِنْدَ ابْنِ الْحَنَفِیَّۃِ فَرَأَیْتہ یَتَقَلَّبُ عَلَی فِرَاشِہِ وَیَنْفُخُ ، فَقَالَتْ لَہُ امْرَأَتُہُ : مَا یَکْرِثُک مِنْ أَمْرِ عَدُوِّکَ ہَذَا ابْنُ الزُّبَیْرِ ؟ فَقَالَ : وَاللہِ مَا بِی عَدُوُّ اللہِ ہَذَا ابْنُ الزُّبَیْرِ ، وَلَکِنْ بِی مَا یُفْعَلُ فِی حَرَمِہِ غَدًا ، قَالَ : ثُمَّ رَفَعَ یَدَیْہِ إلَی السَّمَائِ ، ثُمَّ قَالَ : اللَّہُمَّ أَنْتَ تَعْلَمُ أَنِّی کُنْت أَعْلَمُ مِمَّا عَلَّمْتنِی ، أَنَّہُ یَخْرُجُ مِنْہَا قَتِیلاً یُطَافُ بِرَأْسِہِ فِی الأَمْصَارِ ، أَوْ فِی الأَسْوَاقِ۔","","Musannaf Ibn Abi Shaybah 31336","","","كتاب الأمراء"
"31337","(۳۱۳۳۷) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنَا شُعْبَۃُ بْنُ الْحَجَّاجِ ، قَالَ : حَدَّثَنَا عُمَارَۃُ بْنُ أَبِی حَفْصَۃَ ، عَنْ أَبِی مِجْلَزٍ ، عَنْ قَیْسِ بْنِ عُبَادٍ ، قَالَ : خَرَجْت إلَی الْمَدِینَۃِ أَطْلُبُ الشَّرَفَ وَالْعِلْمَ ، فَأَقْبَلَ رَجُلٌ عَلَیْہِ حُلَّۃٌ جَمِیلَۃٌ ، فَوَضَعَ یَدَیْہِ عَلَی مَنْکِبَیْ عُمَرَ ، فَقُلْتُ مَنْ ہَذَا ، فَقَالُوا : عَلِیُّ بْنُ أَبِی طَالِبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31337","","","كتاب الأمراء"
"31338","(۳۱۳۳۸) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ حَکِیمِ بْنِ جَابِرٍ ، قَالَ : لَمَّا حُصِرَ عُثْمَان أَتَی عَلِیٌّ طَلْحَۃَ وَہُوَ مُسْنِدٌ ظَہْرَہُ إلَی وَسَائِدَ فِی بَیْتِہِ ، فَقَالَ : أُنْشِدُک اللَّہَ لَمَّا رَدَدْت النَّاسَ عَنْ أَمِیرِ الْمُؤْمِنِینَ ، فَقَالَ طَلْحَۃُ : حَتَّی یُعْطُوا الْحَقَّ مِنْ أَنْفُسِہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 31338","","","كتاب الأمراء"
"31339","(۳۱۳۳۹) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ وَہْبٍ ، أَوِ ابْنِ أَخِیہِ عَبْدِ الرَّحْمَنِ : أَنَّہُ سَمِعَ الْمُخْتَارَ وَہُوَ یَقُولُ : مَا بَقِیَ مِنْ عِمَامَۃِ عَلِیٍّ إلاَّ زِرَاعَانِ حَتَّی یَجِیئَ ، قَالَ : قلْت : لِمَ تُضِلُّ النَّاسَ ؟ قَالَ : دَعَنْی أَتَأَلَّفُہُمْ۔","","Musannaf Ibn Abi Shaybah 31339","","","كتاب الأمراء"
"31340","(۳۱۳۴۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنِی ابْنُ عُیَیْنَۃَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ حَکِیمِ بْنِ جَابِرٍ، قَالَ: سَمِعْتُ طَلْحَۃَ بْنَ عُبَیْدِ اللہِ یَقُولُ یَوْمَ الْجَمَلِ : إنَّا کُنَّا قَدْ دَاہَنَّا فِی أَمْرِ عُثْمَانَ ، فَلاَ نَجِدُ بُدًّا مِنَ الْمُبَالَغَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 31340","","","كتاب الأمراء"
"31341","(۳۱۳۴۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مُجَالِدِ بْنِ سَعِیدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَمَّا کَانَ الصُّلْحُ بَیْنَ الْحَسَنِ بْنِ عَلِیٍّ وَبَیْنَ مُعَاوِیَۃَ بْنِ أَبِی سُفْیَانَ أَرَادَ الْحَسَنُ الْخُرُوجَ - یَعْنِی : إلَی الْمَدِینَۃِ - فَقَالَ لَہُ مُعَاوِیَۃُ : مَا أَنْتَ بِالَّذِی تَذْہَبُ حَتَّی تَخْطُبَ النَّاسَ ، قَالَ الشَّعْبِیُّ : فَسَمِعْتہ عَلَی الْمِنْبَرِ حَمِدَ اللَّہَ وَأَثْنَی عَلَیْہِ ، ثُمَّ قَالَ : أَمَّا بَعْدُ ، فَإِنَّ أَکَیْسَ الْکَیْسِ التُّقَی ، وَإِنَّ أَعْجَزَ الْعَجْزِ الْفُجُورُ ، وَإِنَّ ہَذَا الأَمْرَ الَّذِی اخْتَلَفْت فِیہِ أَنَا وَمُعَاوِیَۃُ حَقٌّ کَانَ لِی فَتَرَکْتہ لِمُعَاوِیَۃَ ، أَوْ حَقٌّ کَانَ لاِمْرِئٍ أَحَقَّ بِہِ مِنِّی ، وَإِنَّمَا فَعَلْت ہَذَا لِحَقْنِ دِمَائِکُمْ {وَإِنْ أَدْرِی لَعَلَّہُ فِتْنَۃٌ لَکُمْ وَمَتَاعٌ إلَی حِینٍ}۔","Da'if","Musannaf Ibn Abi Shaybah 31341","","","كتاب الأمراء"
"31342","(۳۱۳۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ أَبِی الضُّحَی ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : اللَّہُمَّ إنِّی أَبْرَأُ إلَیْک مِنْ مُغِیرَۃَ وَبَیَانَ۔","","Musannaf Ibn Abi Shaybah 31342","","","كتاب الأمراء"
"31343","(۳۱۳۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنِ السُّمَیْطِ ، عَنْ کَعْبٍ ، قَالَ : لِکُلِّ زَمَانٍ مُلُوک ، فَإِذَا أَرَادَ اللَّہُ بِقَوْمٍ خَیْرًا بَعَثَ فِیہِمْ مُصْلِحِیہِمْ ، وَإِذَا أَرَادَ اللَّہُ بِقَوْمٍ شَرًّا بَعَثَ فِیہِمْ مُتْرَفِیہِمْ۔","","Musannaf Ibn Abi Shaybah 31343","","","كتاب الأمراء"
"31344","(۳۱۳۴۴) حَدَّثَنَا ابْنُ فَضْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ مَیْسَرَۃَ ، قَالَ : کَانَ یَمُرُّ عَلَیْہِ الْغُلاَمُ ، أَو الْجَارِیَۃُ مِمَّنْ یُخْرِجُہُ الْحَجَّاجُ إلَی السَّوَادِ فَیَقُولُ : مَنْ رَبُّک ؟ فَیَقُولُ : اللَّہُ ، فَیَقُولُ : مَنْ نَبِیُّک ؟ فَیَقُولُ : مُحَمَّدٌ رَسُولُ اللہ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَیَقُولُ : وَاللہِ الَّذِی لاَ إلَہَ إلاَّ ہُوَ ، لاَ أَجِدُ أَحَدًا یُقَاتِلُ الْحَجَّاجَ إلاَّ قَاتَلْت مَعَہُ الْحَجَّاجَ۔","","Musannaf Ibn Abi Shaybah 31344","","","كتاب الأمراء"
"31345","(۳۱۳۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یَزِیدَ ، عَنْ أَبِی الْبَخْتَرِیِّ : أَنَّہُ رَأَی رَجُلاً انْحَازَ ، فَقَالَ : حرُّ النَّارِ أَشَدُّ مِنْ حَرِّ السَّیْفِ۔","","Musannaf Ibn Abi Shaybah 31345","","","كتاب الأمراء"
"31346","(۳۱۳۴۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حُصَیْنٍ ، قَالَ : سَمِعْتُ عَبْدَ الرَّحْمَن بْنَ أَبِی لَیْلَی یُحَضِّضُ النَّاسَ أَیَّامَ الْجَمَاجِمِ۔","","Musannaf Ibn Abi Shaybah 31346","","","كتاب الأمراء"
"31347","(۳۱۳۴۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجًرَیرِیِّ ، عَنِ أَبِی الْعَلاَئِ ، قَالَ : قالَوا لِمُطَرِّفٍ : ہَذَا عَبْدُ الرَّحْمَنِ بْنُ الأَشْعَثِ قَدْ أَقْبَلَ ، فَقَالَ مُطَرِّفٌ : وَاللہِ لَقَدْ نَزَی بَیْنَ أَمْرَیْنِ ، لَئِنْ ظَہَرَ لاَ یَقُومُ لِلَّہِ دِینٌ ، وَلَئِنْ ظُہِرَ عَلَیْہِ لاَ تَزَالُون أَذِلَّۃً إلَی یَوْمِ الْقِیَامَۃِ۔","","Musannaf Ibn Abi Shaybah 31347","","","كتاب الأمراء"
"31348","(۳۱۳۴۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : أَخْبَرَنِی غَیْرُ وَاحِدٍ : أَنَّ قَاضِیًا مِنْ قُضَاۃِ أَہْلِ الشَّامِ أَتَی عُمَرَ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، رَأَیْت رُؤْیَا أَفْظَعَتْنِی ، قَالَ : وَمَا رَأَیْت ؟ قَالَ : رَأَیْتُ الشَّمْسَ وَالْقَمَرَ یَقْتَتِلاَنِ ، وَالنُّجُومَ مَعَہُمَا نِصْفَیْنِ ، قَالَ : فَمَعَ أَیِّہِمَا کُنْت ، قَالَ : کُنْتُ مَعَ الْقَمَرِ عَلَی الشَّمْسِ ، فَقَالَ : عُمَرُ : {وَجَعَلْنَا اللَّیْلَ وَالنَّہَارَ آیَتَیْنِ فَمَحَوْنَا آیَۃَ اللَّیْلِ وَجَعَلْنَا آیَۃَ النَّہَارِ مُبْصِرَۃً} فَانْطَلِقْ فَوَاللہِ لاَ تَعْمَلُ لِی عَمَلاً أَبَدًا۔n قَالَ عَطَائٌ : فَبَلَغَنِی ، أَنَّہُ قُتِلَ مَعَ مُعَاوِیَۃَ یَوْمَ صِفِّینَ۔","Da'if","Musannaf Ibn Abi Shaybah 31348","","","كتاب الأمراء"
"31349","(۳۱۳۴۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائٍ ، قَالَ : اجْتَمَعَ عِیدَانِ فِی یَوْمٍ ، فَقَامَ الْحَجَّاجُ فِی الْعِیدِ الأَوَّلِ ، فَقَالَ : مَنْ شَائَ أَنْ یُجَمِّعْ مَعَنا فَلْیُجَمِّعْ ، وَمَنْ شَائَ أَنْ یَنْصَرِفَ فَلْیَنْصَرِفْ ، وَلاَ حَرَجَ ، فَقَالَ أَبُو الْبَخْتَرِیِّ وَمَیْسَرَۃُ : مَا لَہُ قَاتَلَہُ اللَّہُ ، مِنْ أَیْنَ سَقَطَ عَلَی ہَذَا ؟","","Musannaf Ibn Abi Shaybah 31349","","","كتاب الأمراء"
"31350","(۳۱۳۵۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ وَاصِلٍ الأَحْدَبِ ، قَالَ : رَأَی إبْرَاہِیمُ أَمِیرَ حُلْوَانَ یَمُرُّ بِدَوَابِّہ فِی زَرْعِ قَوْمٍ ، فَقَالَ إبْرَاہِیم : الْجَوْرُ فِی الطَّرِیقِ خَیْرٌ مِنَ الْجَوْرِ فِی الدِّینِ۔","","Musannaf Ibn Abi Shaybah 31350","","","كتاب الأمراء"
"31351","(۳۱۳۵۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا زَائِدَۃٌ ، قَالَ : حَدَّثَنَا عَبْدُ الْمَلِکِ بْنُ عُمَیْرٍ ، عَنْ رِبْعِیٍّ ، عَنْ أَبِی مُوسَی ، قَالَ : قَالَ عَمْرُو بْنُ الْعَاصِ : لَئنْ کَانَ أَبُو بَکْرٍ وَعُمَرُ تَرَکَا ہَذَا الْمَالَ وَہُوَ یَحِلُّ لَہُمَا مِنْہُ شَیْئٌ لَقَدْ غُبِنَا وَنَقَصَ رَأْیُہُمَا ، وَلَعَ[corrupt]ْرُ اللہِ مَا کَانَا بِمَغْبُونَیْنِ ، وَلاَ نَاقِصِی الرَّأْی ، وَلَئنْ کَانَا امْرَأَیْنِ یَحْرُمُ عَلَیْہِمَا مِنْ ہَذَا الْمَالِ الَّذِی أَصَبْنَا بَعْدَہُمَا لَقَدْ ہَلَکْنَا وَایْمُ اللہِ مَا جَائَ الْوَہَمُ إلاَّ مِنْ قِبَلِنَا۔","Sahih","Musannaf Ibn Abi Shaybah 31351","","","كتاب الأمراء"
"31352","(۳۱۳۵۲) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، قَالَ سَمِعْت مُحَمَّدَ بْنَ سِیرِینَ ، قَالَ : بَعَثَ عَلِیُّ بْنُ أَبِی طَالِبٍ قَیْسَ بْنَ سَعْدٍ أَمِیرًا عَلَی مِصْرَ ، قَالَ : فَکَتَبَ إلَیْہِ مُعَاوِیَۃُ وَعَمْرُو بْنُ الْعَاصِ بِکِتَابٍ فَأَغْلَظَا لَہُ فِیہِ وَشَتَمَاہُ وَأَوْعَدَاہُ فَکَتَبَ إلَیْہِمَا بِکِتَابٍ لَیِّنٍ یُقَارِبُہُمَا وَیُطْمِعَہُمَا فِی نَفْسِہِ، قَالَ: فَلَمَّا أَتَاہُمَا الْکِتَابَ کَتَبَا إلَیْہِ بِکِتَابٍ لَیِّنٍ یَذْکُرَانِ فَضْلَہُ وَیُطْمِعَانِہِ فِیمَا قِبلَہُمَا ، فَکَتَبَ إلَیْہِمَا بِجَوَابِ کِتَابِہِمَا الأَوَّلِ یُغْلِظُ لَہُمَا ، فَلَمْ یَدَعْ شَیْئًا إلاَّ قَالَہُ ، فَقَالَ أَحَدُہُمَا لِلآخَرِ: لاَ وَاللہِ مَا نُطِیقُ نَحْنُ قَیْسَ بْنَ سَعْدٍ ، وَلَکِنْ تَعَالَ نَمْکُرُ بِہِ عِنْدَ عَلِیٍّ ، قَالَ : فَبَعْثَا بِکِتَابِہِ الأُولَی إلَی عَلِیٍّ، قَالَ: فَقَالَ لَہُ أَہْلُ الْکُوفَۃِ : عَدُوُّ اللہِ قَیْسُ بْنُ سَعْدٍ فَاعْزِلْہُ ، فَقَالَ عَلِیٌّ : وَیْحَکُمْ أَنَا وَاللہِ أَعْلَمُ ہِیَ وَاللہِ إحْدَی فِعْلاَتِہِ ، فَأَبَوْا إلاَّ عَزْلَہُ فَعَزَلَہُ ، وَبَعَثَ مُحَمَّدُ بْنُ أَبِی بَکْرٍ ، فَلَمَّا قَدِمَ عَلَی قَیْسِ بْنِ سَعْدٍ ، قَالَ لَہُ قَیْسٌ : اُنْظُرْ مَا آمُرُک بِہِ ، إذَا کَتَبَ إلَیْک مُعَاوِیَۃُ بِکَذَا وَکَذَا فَاکْتُبْ إلَیْہِ بِکَذَا وَکَذَا ، وَإِذَا صَنَعَ کَذَا فَاصْنَعْ کَذَا ، وَإِیَّاکَ أَنْ تُخَالِفَ مَا أَمَرْتُک بِہِ ، وَاللہِ لَکَأَنِّی أَنْظُرُ إلَیْک إنْ فَعَلْت قَدْ قُتِلْت ، ثُمَّ أُدْخِلْت فِی جَوْفَ حِمَارٍ فَأُحْرِقْت بِالنَّارِ ، قَالَ : فَفَعَلَ ذَلِکَ بِہِ۔","","Musannaf Ibn Abi Shaybah 31352","","","كتاب الأمراء"
"31353","(۳۱۳۵۳) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، قَالَ : مَا عَلِمْت أَنَّ عَلِیًّا اتُّہِمَ فِی قَتْلِ عُثْمَانَ حَتَّی بُویِعَ ، فَلَمَّا بُویِعَ اتَّہَمَہُ النَّاسُ۔","","Musannaf Ibn Abi Shaybah 31353","","","كتاب الأمراء"
"31354","(۳۱۳۵۴) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، قَالَ : قَالَ قَیْسُ بْنُ سَعْدِ بْنِ عُبَادَۃَ : لَوْلاَ أَنْ یَمْکُرَ الرَّجُلُ حَتَّی یَفْجُرَ لَمَکَرْت بِأَہْلِ الشَّامِ مَکْرًا یَضْطَرِبُونَ یَوْمًا إلَی اللَّیْلِ۔","Sahih","Musannaf Ibn Abi Shaybah 31354","","","كتاب الأمراء"
"31355","(۳۱۳۵۵) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَبِی مَعْدَانَ ، عَنْ مَالِکِ بْنِ دِینَارٍ ، قَالَ : شَہِدْت الْحَسَنَ وَمَالِکَ بْنَ دِینَارٍ وَمُسْلِمَ بْنَ یَسَارٍ وَسَعِیدًا یَأْمُرُونَ بِقِتَالِ الْحَجَّاجِ مَعَ ابْنِ الأَشْعَثِ ، فَقَالَ الْحَسَنُ : إنَّ الْحَجَّاجِ عُقُوبَۃٌ جَائَتْ مِنَ السَّمَائِ ، فَلْنَسْتَقْبِلْ عُقُوبَۃَ اللہِ بِالسَّیْفِ۔","","Musannaf Ibn Abi Shaybah 31355","","","كتاب الأمراء"
"31356","(۳۱۳۵۶) حَدَّثَنَا أَبُو سُفْیَانَ الْحِمْیَرِیُّ ، قَالَ : حدَّثَنَا خَالِدُ بْنُ مُحَمَّدٍ الْقُرَشِیُّ ، قَالَ : قَالَ عَبْدُ الْمَلِکِ بْنُ مَرْوَانَ : مَنْ أَرَاْدَ أَنْ یَتَّخِذَ جَارِیَۃً لِلتَّلَذُّذِ فَلْیَتَّخِذْہَا بَرْبَرِیَّۃً ، وَمَنْ أَرَاْدَ أَنْ یَتَّخِذَہَا لِلْوَلَدِ فَلْیَتَّخِذْہَا فَارِسِیَّۃً ، وَمَنْ أَرَاْدَ أَنْ یَتَّخِذَہَا لِلْخِدْمَۃِ فَلْیَتَّخِذْہَا رُومِیَّۃً۔","","Musannaf Ibn Abi Shaybah 31356","","","كتاب الأمراء"
"31357","(۳۱۳۵۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا ابْنُ أَبِی غُنْیَۃً ، عَنْ شَیْخٍ مِنْ أَہْلِ الْمَدِینَۃِ ، قَالَ : قَالَ مُعَاوِیَۃُ : أَنَا أَوَّلُ الْمُلُوکِ۔","Da'if","Musannaf Ibn Abi Shaybah 31357","","","كتاب الأمراء"
"31358","(۳۱۳۵۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إسْمَاعِیلَ بْنِ إِبْرَاہِیمَ ، عَن عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ : قَالَ مُعَاوِیَۃُ : مَا زِلْت أَطْمَعُ فِی الْخِلاَفَۃِ مُنْذُ قَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَا مُعَاوِیَۃُ ، إنْ مَلَکْت فَأَحْسِنْ۔n(طبرانی ۸۵۰۔ بیہقی ۴۴۶)","Da'if","Musannaf Ibn Abi Shaybah 31358","","","كتاب الأمراء"
"31359","حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ ، قَالَ : حَدَّثَنَا أَبُو بَکْرِ ، قَالَ :n(۳۱۳۵۹) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ شُرَحْبِیلَ بْنِ مُسْلِمٍ ، قَالَ : سَمِعْتُ أَبَا أُمَامَۃَ الْبَاہِلِیَّ یَقُولُ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی خُطْبَتِہِ عَامَ حَجَّۃِ الْوَدَاعِ یَقُولُ : إنَّ اللَّہَ قَدْ أَعْطَی کُلَّ ذِی حَقٍّ حَقَّہُ ، فَلاَ وَصِیَّۃَ لِوَارِثٍ۔","Hasan","Musannaf Ibn Abi Shaybah 31359","","","كتاب الوصايا"
"31360","(۳۱۳۶۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ ، عَنْ عَمْرِو بْنِ خَارِجَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ وَصِیَّۃَ لِوَارِثٍ۔","","Musannaf Ibn Abi Shaybah 31360","","","كتاب الوصايا"
"31361","(۳۱۳۶۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ، عَنْ حَجَّاجٍ، عَنْ أَبِی إِسْحَاقَ، عَنِ الْحَارِثِ، عَنْ عَلِیٍّ، قَالَ: لَیْسَ لِوَارِثٍ وَصِیَّۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 31361","","","كتاب الوصايا"
"31362","(۳۱۳۶۲) حَدَّثَنَا مُلاَزِمُ بْنُ عَمْرٍو ، عَنْ عَبْدِ اللہِ بْنِ بَدْرٍ ، قَالَ : سَأَلَ رَجُلٌ ابْنَ عُمَرَ ، فَقَالَ : یَا ابْنَ عُمَرَ مَا تَرَی فِی الْوَصِیَّۃِ لِلْوَارِثِ ؟ فَانْتَہَرَہُ وَقَالَ : ہَلْ قَارَبْت الْحَرُورِیَّۃَ ، فَقَالَ : لاَ تَجُوزُ الْوَصِیَّۃُ لِلْوَارِثِ۔","Sahih","Musannaf Ibn Abi Shaybah 31362","","","كتاب الوصايا"
"31363","(۳۱۳۶۳) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ وَابْنِ سِیرِینَ، قَالاَ: لَیْسَ لِوَارِثٍ وَصِیَّۃٌ إلاَّ إنْ یَشَائَ الْوَرَثَۃُ۔","","Musannaf Ibn Abi Shaybah 31363","","","كتاب الوصايا"
"31364","(۳۱۳۶۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی مِسْکِینٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لَیْسَ لِوَارِثٍ وَصِیَّۃٌ۔","","Musannaf Ibn Abi Shaybah 31364","","","كتاب الوصايا"
"31365","(۳۱۳۶۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَوْصَی الرَّجُلُ بِوَصِیَّۃَ لِوَارِثٍ ، فَأَجَازَ الْوَرَثَۃُ قَبْلَ أَنْ یَمُوتَ ، ثُمَّ رَجِعَ الْوَرَثَۃُ بَعْدَ مَوْتِہِ ، فَہُمْ عَلَی رَأْسِ أَمْرِہِمْ ، وَإِذَا کَانَ لِغَیْرِ وَارِثٍ زِیَادَۃ عَلَی الثُّلُثِ فَمِثْلُ ذَلِکَ ، وَإِذَا کَانَتْ لِغَیْرِ وَارِثٍ مَا بَیْنَہُ وَبَیْنَ الثُّلُثِ فَإِنَّہَا جَائِزَۃٌ۔","","Musannaf Ibn Abi Shaybah 31365","","","كتاب الوصايا"
"31366","(۳۱۳۶۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، قَالَ : إذَا اسْتَأْذَنَ الرَّجُلُ وَرَثَتَہُ فِی الْوَصِیَّۃِ فَأَوْصَی بِأَکْثَرَ مِنَ الثُّلُثِ ، فَطَیَّبُوا لَہُ ، فَإِذَا نَفَضُوا أَیْدِیَہُمْ مِنْ قَبْرِہِ فَہُمْ عَلَی رَأْسِ أَمْرِہِمْ ، إنْ شَاؤُوا أَجَازُوا ، وَإِنْ شَاؤُوا لَمْ یُجِیزُوا۔","","Musannaf Ibn Abi Shaybah 31366","","","كتاب الوصايا"
"31367","(۳۱۳۶۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ صَالِحِ بْنِ مُسْلِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَأَلْتُہ ؟ فَقَالَ : ہُمْ عَلَی رَأْسِ أَمْرِہِمْ۔","","Musannaf Ibn Abi Shaybah 31367","","","كتاب الوصايا"
"31368","(۳۱۳۶۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ : یَرْجِعُونَ إنْ شَاؤُوا۔","","Musannaf Ibn Abi Shaybah 31368","","","كتاب الوصايا"
"31369","(۳۱۳۶۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : فِی رَجُلٍ أَوْصَی بِأَکْثَرَ مِنَ الثُّلُثِ بِرِضًا مِنَ الْوَرَثَۃِ ، فَلَمَّا مَاتَ أَنْکَرُوا ذَلِکَ ، قَالَ : ہُوَ جَائِزٌ عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 31369","","","كتاب الوصايا"
"31370","(۳۱۳۷۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : کَانَ عَطَائٌ یَقُولُ : جَائِزٌ ، قَدْ أَذِنُوا۔","","Musannaf Ibn Abi Shaybah 31370","","","كتاب الوصايا"
"31371","(۳۱۳۷۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ : أَنَّہُ قَالَ : فِی الرَّجُلِ یُوصِی بِأَکْثَرَ مِنَ الثُّلُثِ یُجِیزُہُ الْوَرَثَۃُ ، ثُمَّ یَرْجِعُونَ فِیہِ ؟ قَالَ : لَیْسَ لَہُمْ أَنْ یَرْجِعُوا ، وَقَالَ الْحَکَمُ : إنْ شَاؤُوا رَجَعُوا فِیہِ۔","","Musannaf Ibn Abi Shaybah 31371","","","كتاب الوصايا"
"31372","(۳۱۳۷۲) حَدَّثَنَا ابْنُ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، قَالَ : إذَا أَوْصَی الرَّجُلُ فَزَادَ عَلَی الثُّلُثِ فَاسْتَأْذَنَ ابْنَہُ فِی حَیَاتِہِ فَأَذِنَ لَہُ ، فَإِذَا مَاتَ فَعَادَ إلَی ابْنِہِ ، إنْ شَائَ أَجَازَہُ وَإِنْ شَائَ رَدَّہُ۔","","Musannaf Ibn Abi Shaybah 31372","","","كتاب الوصايا"
"31373","(۳۱۳۷۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنْ أَبِی عَوْنٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ : أَنَّ رَجُلاً اسْتَأْذَنَ وَرَثَتَہُ فِی مَرَضِہِ فِی أَنْ یُوصِیَ بِأَکْثَرَ مِنَ الثُّلُثِ فَأَذِنُوا لَہُ ، فَلَمَّا مَاتَ رَجَعُوا ، فَسُئِلَ ابْنُ مَسْعُودٍ عَنْ ذَلِکَ ؟ فَقَالَ : ذَلِکَ لَہُمْ ، ذَلِکَ التَّکَرُّہُ لاَ یَجُوزُ۔","","Musannaf Ibn Abi Shaybah 31373","","","كتاب الوصايا"
"31374","(۳۱۳۷۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ عَامِرٍ۔ وَعَنْ خَالِدٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ، قَالَ : إذَا أَوْصَی الرَّجُلُ فِی مَرَضِہِ بِأَکْثَرَ مِنَ الثُّلُثِ لِغَیْرِ وَارِثٍ أَوْ لِوَارِثٍ ، فَأَذِنَ الْوَرَثَۃُ ، ثُمَّ مَاتَ فَلَہُمْ أَنْ یَرْجِعُوا۔","","Musannaf Ibn Abi Shaybah 31374","","","كتاب الوصايا"
"31375","(۳۱۳۷۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ یَزِیدَ أَبِی خَالِدٍ الدَّالاَنِیِّ ، قَالَ : سَمِعْتُ أَبَا عَوْنٍ مُحَمَّدِ بْنِ عُبَیْدِ اللہِ یُحَدِّثُ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ : أَنَّہُ قَالَ ؛ فِی الرَّجُلِ یُوصِی بِأَکْثَرَ مِنَ الثُّلُثِ یُجِیزُہُ الْوَارِثُ ، ثُمَّ لاَ یُجِیزُہُ بَعْدَ مَوْتِہِ ، قَالَ : ذَلِکَ التَّکَرُّہُ لاَ یَجُوزُ۔","","Musannaf Ibn Abi Shaybah 31375","","","كتاب الوصايا"
"31376","(۳۱۳۷۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، أَوْ ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا أَوْصَی بِوَصِیَّۃٍ ، ثُمَّ أَوْصَی بِأُخْرَی بَعْدَہَا ، قَالَ : یُؤْخَذُ بِالأُخْرَی مِنْہُمَا۔","","Musannaf Ibn Abi Shaybah 31376","","","كتاب الوصايا"
"31377","(۳۱۳۷۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ عَمْرِو بْنِ دِینَارٍ، عَنْ عَطَائٍ وَطَاوُوسٍ وَأَبِی الشَّعْثَائِ ، قَالُوا : یُؤْخَذُ بِآخِرِ وَصِیَّۃٍ۔","","Musannaf Ibn Abi Shaybah 31377","","","كتاب الوصايا"
"31378","(۳۱۳۷۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ : أَنَّ رَجُلاً أَوْصَی فَدَعَا نَاسًا ، فَقَالَ : أُشْہِدُکُمْ أَنَّ غُلاَمِی فُلاَنًا إنْ حَدَثَ بِی حَدَثٌ فَہُوَ حُرٌّ ، فَخَرَجُوا مِنْ عِنْدِہِ فَقِیلَ لَہُ : أَعْتَقْت فُلاَنًا وَتَرَکْت فُلاَنًا وَکَانَ أَحْسَنَ بَلاَئً ، فَقَالَ : رُدُّوا عَلَیَّ الْبَیِّنَۃَ ، أُشْہِدُکُمْ أَنِّی قَدْ رَجَعْت فِی عِتْقِ فُلاَنٍ ، وَأَنَّ فُلاَنًا لِعَبْدِہِ الآخَرِ إنْ حَدَثَ بِی حَدَثٌ فَہُوَ حُرٌّ ، فَمَاتَ الرَّجُلُ ، فَقَالَ الأَوَّلُ : أَنَا حُرٌّ ، وَقَالَ الآخَرُ : أَنَا حُرٌّ ، فَاخْتَصَمَا إلَی عَبْدِ الْمَلِکِ بْنِ مَرْوَانَ ، فَرَدَّ عِتْقَ الأَوَّلِ وَأَجَازَ عِتْقَ الآخَرِ۔","","Musannaf Ibn Abi Shaybah 31378","","","كتاب الوصايا"
"31379","(۳۱۳۷۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إذَا أَوْصَی الرَّجُلُ بِوَصِیَّۃٍ ، ثُمَّ نَقَضَہَا فَہِیَ الآخِرَۃُ ، وَإِنْ لَمْ یَنْقُضْہَا فَإِنَّہُمَا تَجُوزَانِ جَمِیعًا فِی ثُلُثِہِ بِالْحِصَصِ۔","","Musannaf Ibn Abi Shaybah 31379","","","كتاب الوصايا"
"31380","(۳۱۳۸۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ : أَنَّ ابْنَ أَبِی رَبِیعَۃَ کَتَبَ إلَی عُمَرَ بْنِ الْخَطَّابِ : فِی الرَّجُلُ یُوصِی بِوَصِیَّۃٍ ثُمَّ یُوصِی بِأُخْرَی ، قَالَ : أَمْلَکُہُمَا آخِرُہُمَا۔","","Musannaf Ibn Abi Shaybah 31380","","","كتاب الوصايا"
"31381","(۳۱۳۸۱) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ : فِی رَجُلٍ أَوْصَی لِرَجُلٍ فَمَاتَ الَّذِی أُوصِیَ لَہُ قَبْلَ أَنْ تَأْتِیَہُ ، قَالَ : ہِیَ لِوَرَثَۃِ الْمُوصَی لَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 31381","","","كتاب الوصايا"
"31382","(۳۱۳۸۲) حَدَّثَنَا حَفْصٌ ، قَالَ سَأَلَتْ عَمْرًا عَنْہُ ، قَالَ : کَانَ الْحَسَنُ یَقُولُ : ہِیَ لِوَرَثَۃِ الْمُوصَی لَہُ۔","","Musannaf Ibn Abi Shaybah 31382","","","كتاب الوصايا"
"31383","(۳۱۳۸۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَوْصَی لِرَجُلٍ وَہُوَ مَیِّتٌ یَوْمَ یُوصِی لَہُ فَإِنَّ الْوَصِیَّۃَ تَرْجِعُ إلَی وَرَثَۃِ الْمُوصِی ، وَإِذَا أَوْصَی لِرَجُلٍ ثُمَّ مَاتَ فَإِنَّ الْوَصِیَّۃَ لِوَرَثَۃِ الْمُوصَی لَہُ۔","","Musannaf Ibn Abi Shaybah 31383","","","كتاب الوصايا"
"31384","(۳۱۳۸۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : لاَ وَصِیَّۃَ لِمَیِّتٍ۔","","Musannaf Ibn Abi Shaybah 31384","","","كتاب الوصايا"
"31385","(۳۱۳۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ قَالَ : لاَ وَصِیَّۃَ لِمَیِّتٍ۔","","Musannaf Ibn Abi Shaybah 31385","","","كتاب الوصايا"
"31386","(۳۱۳۸۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ : فِی الرَّجُلِ یُوصِی بِالْوَصِیَّۃِ فَیَمُوتُ الَّذِی أُوصِیَ لَہُ قَبْلَ الَّذِی أَوْصَی ، قَالَ : لَیْسَ لَہُ شَیْئٌ ، أَنَّہُ أَوْصَی لَہُ وَہُوَ مَیِّتٌ۔","","Musannaf Ibn Abi Shaybah 31386","","","كتاب الوصايا"
"31387","(۳۱۳۸۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ : فِی الرَّجُلِ یُوصِی بِالْوَصِیَّۃِ فَیَمُوتُ الْمُوصَی لَہُ قَبْلَ الَّذِی أَوْصَی ، قَالَ : تَبْطُلُ ، وَإِنْ مَاتَ الَّذِی أَوْصَی ، ثُمَّ الَّذِی أُوصِیَ لَہُ ، کَانَ لِوَرَثَتِہِ۔","","Musannaf Ibn Abi Shaybah 31387","","","كتاب الوصايا"
"31388","(۳۱۳۸۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ أَوْصَی لِرَجُلٍ بِثُلُثِ مَالِہِ وَأَفَادَ مَالاً قَبْلَ أَنْ یَمُوتَ ثُمَّ مَاتَ ، قَالَ : لَہُ ثُلُثُ الَّذِی أَوْصَی لَہُ ، وَلَہُ ثُلُثُ مَا أَفَادَ۔","","Musannaf Ibn Abi Shaybah 31388","","","كتاب الوصايا"
"31389","(۳۱۳۸۹) حَدَّثَنَا حَفْصٌ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ، عَنْ عَلِیٍّ : فِی رَجُلٍ أَوْصَی بِثُلُثِ مَالِہِ وَقُتِلَ خَطَأً، قَالَ : الثُّلُثُ دَاخِلٌ فِی دِیَتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 31389","","","كتاب الوصايا"
"31390","(۳۱۳۹۰) حَدَّثَنَا حَفْصٌ، عَنْ أَشْعَثَ، عَنْ أَبِی إِسْحَاقَ، عَنِ الْحَارِثِ، عَنْ عَلِیٍّ ، قَالَ: لَہُ ثُلُثُ مَالِہِ ، وَثُلُثُ دِیَتِہ۔","Da'if","Musannaf Ibn Abi Shaybah 31390","","","كتاب الوصايا"
"31391","(۳۱۳۹۱) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ : فِی الرَّجُلِ أَوْصَی بِثُلُثِ مَالِہِ فَقُتِلَ خَطَأً ، قَالَ : یَدْخُلُ ثُلُثُ الدِّیَۃِ فِی ثُلُثِ مَالِہِ۔","","Musannaf Ibn Abi Shaybah 31391","","","كتاب الوصايا"
"31392","(۳۱۳۹۲) حَدَّثَنَا عَبَّادٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَہْلُ الْوَصِیَّۃِ شُرَکَائُ فِی الْوَصِیَّۃِ ، إنْ زَادَتْ وَإِنْ نَقَصَتْ ، قَالَ : فَأَخْبَرْت بِہِ ابْنَ سِیرِینَ فَأَعْجَبَہُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 31392","","","كتاب الوصايا"
"31393","(۳۱۳۹۳) حَدَّثَنَا زَیْدُ بْنُ حُبَابِ ، عَنِ ابْنِ لَہِیعَۃَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ : فِی رَجُلٍ أَوْصَی لِرَجُلٍ بِوَصِیَّۃٍ ، ثُمَّ جَائَہُ مَالٌ أَوْ أَفَادَ مَالاً ، قَالَ : لاَ یَدْخُلُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 31393","","","كتاب الوصايا"
"31394","(۳۱۳۹۴) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَوْصَی الرَّجُلُ لِلرَّجُلِ بِخَمْسِینَ دِرْہَمًا عُجِّلَتْ لَہُ مِنَ الْعَیْنِ ، وَإِذَا أَوْصَی بِثُلُثٍ أَوْ رُبُعٍ کَانَ فِی الْعَیْنِ وَالدَّیْنِ۔","","Musannaf Ibn Abi Shaybah 31394","","","كتاب الوصايا"
"31395","(۳۱۳۹۵) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ : فِی الرَّجُلِ یُوصِی لِلرَّجُلِ بِخَمْسِینَ دِرْہَمًا مِنْ مَالِہِ ، قَالَ : یُعَجِّلُ لَہُ مَا بَیْنَہُ وَبَیْنَ ثُلُثِ الْعَیْنِ۔","","Musannaf Ibn Abi Shaybah 31395","","","كتاب الوصايا"
"31396","(۳۱۳۹۶) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ یَعْقُوبَ ، عَنْ عَطَائٍ وَقَتَادَۃَ۔ وَعَنْ مَطَرٍ ، عَنِ الْحَسَنِ : فِی رَجُلٍ أَوْصَی لِبَنِی عَمِّہِ رِجَالٍ وَنِسَائٍ ، قَالُوا لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَی ، إلاَّ أَنْ یَکُونَ قَالَ : {لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ}۔","","Musannaf Ibn Abi Shaybah 31396","","","كتاب الوصايا"
"31397","(۳۱۳۹۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ طَلْحَۃَ بْنِ الأَعْلَمِ الْحَنَفِیِّ ، عَنِ الشَّعْبِیِّ : أَنَّ رَجُلاً أَوْصَی لأَرَامِلَ بَنِی حَنِیفَۃَ ، فَقَالَ الشَّعْبِیُّ : ہُوَ لِلرِّجَالِ وَالنِّسَائِ مِمَّنْ خَرَجَ مِنْ کَمَرَۃِ حَنِیفَۃَ۔","","Musannaf Ibn Abi Shaybah 31397","","","كتاب الوصايا"
"31398","(۳۱۳۹۸) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ وُہَیْبٍ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : فِی الرَّجُلِ یَقُولُ : لِبَنِی فُلاَنٍ کَذَا وَکَذَا ، قَالَ : ہُوَ لِغَنِیِّہِمْ وَفَقِیرِہِمْ وَذَکَرِہِمْ وَأُنْثَاہُمْ۔","","Musannaf Ibn Abi Shaybah 31398","","","كتاب الوصايا"
"31399","(۳۱۳۹۹) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ عَبْدِ اللہِ بْنِ جَعْفَرٍ ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ، قَالَ : سَأَلْتُ الْقَاسِمَ عْن رَجُلٍ کَانَتْ لَہُ مَسَاکِنُ فَأَوْصَی بِثُلُثِ کُلِّ مَسْکَنٍ لَہُ ؟ قَالَ : یُخْرَجُ حَتَّی یَکُونَ فِی مَسْکَنٍ وَاحِدٍ۔","","Musannaf Ibn Abi Shaybah 31399","","","كتاب الوصايا"
"31400","(۳۱۴۰۰) حَدَّثَنَا یَعْلَی ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ : فِی رَجُلٍ أَوْصَی بِثُلُثِ مَالِہِ وَأَشْیَائَ سِوَی ذَلِکَ ، وَتَرَکَ دَارًا تَکُونُ ثُلُثُہَا ، أَیُعْطَاہَا الْمُوصَی لَہُ بِالثُّلُثِ ، قَالَ : لاَ وَلَکِنْ یُعْطَی بِالْحِصَّۃِ مِنَ الْمَالِ وَالدَّارِ۔","","Musannaf Ibn Abi Shaybah 31400","","","كتاب الوصايا"
"31401","(۳۱۴۰۱) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ وَحَمَّادٌ ، عَنْ إبْرَاہِیمَ : أَنَّہُ سُئِلَ عَنْ رَجُلٍ ، قَالَ : ثُلُثَیْ ثَلاَثُمِئَۃ دِرْہَمٍ : مِئَۃٌ لِفُلاَنٍ ، وَمِئَۃٌ لِفُلاَنٍ ، وَمَا بَقِیَ مِنْ ثُلُثی ؛ فَہُوَ لِفُلاَنٍ ، قَالَ : فَلِفُلاَنٍ مِئَۃٌ ، وَلِفُلاَنٍ مِئَۃٌ ، وَمَا بَقِیَ فَلِفُلاَنٍ ، وَإِنْ لَمْ یَبْقَ شَیْئٌ ، فَلَیْسَ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 31401","","","كتاب الوصايا"
"31402","(۳۱۴۰۲) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : فِی رَجُلٍ أَوْصَی ، قَالَ : ثُلُثَیْ لِفُلاَنٍ ، فَإِنْ مَاتَ فَہُوَ لِفُلاَنٍ ، قَالَ : ہُوَ لِلأَوَّلِ۔","","Musannaf Ibn Abi Shaybah 31402","","","كتاب الوصايا"
"31403","(۳۱۴۰۳) حَدَّثَنَا زَیْدُ بْنُ الحُبَابٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : ہُوَ لِلأَوَّلِ۔","","Musannaf Ibn Abi Shaybah 31403","","","كتاب الوصايا"
"31404","(۳۱۴۰۴) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ حَمَّادٍ ، عَنْ قَتَادَۃَ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : یُجْرِی کَمَا قَالَ۔","","Musannaf Ibn Abi Shaybah 31404","","","كتاب الوصايا"
"31405","(۳۱۴۰۵) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ حَمَّادٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 31405","","","كتاب الوصايا"
"31406","(۳۱۴۰۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : بَلَغَنِی أَنَّ صَفِیَّۃَ أَوْصَتْ لِقَرَابَۃٍ لَہَا بِمَالٍ عَظِیمٍ، وَکَثِیرٍ مِنَ الْیَہُودِ کَانُوا وَرَثَتَہَا لَوْ کَانُوا مُسْلِمِینَ فَوَرِثَہَا غَیْرُہُمْ مِنَ الْمُسْلِمِینَ وَجَازَ لَہُمْ مَا أَوْصَتْ۔","","Musannaf Ibn Abi Shaybah 31406","","","كتاب الوصايا"
"31407","(۳۱۴۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ : أَنَّ صَفِیَّۃَ أَوْصَتْ لِقَرَابَۃٍ لَہَا یَہُود۔","Da'if","Musannaf Ibn Abi Shaybah 31407","","","كتاب الوصايا"
"31408","(۳۱۴۰۸) حَدَّثَنَا مُعَاذٌ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، قَالَ : وَصِیَّۃُ الرَّجُلِ جَائِزَۃٌ لِذِمِّیٍّ کَانَ أَوْ لِغَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 31408","","","كتاب الوصايا"
"31409","(۳۱۴۰۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یَقُولُ : الْوَصِیَّۃُ لِلْیَہُودِیِّ وَالنَّصْرَانِیِّ وَالْمَجُوسِیِّ وَالْمَمْلُوکِ جَائِزَۃً۔","","Musannaf Ibn Abi Shaybah 31409","","","كتاب الوصايا"
"31410","(۳۱۴۱۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ : أَنَّ امْرَأَۃً مِنْ أَزْوَاجِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَوْصَتْ لِقَرَابَۃٍ لَہَا مِنَ الْیَہُودِ۔","Da'if","Musannaf Ibn Abi Shaybah 31410","","","كتاب الوصايا"
"31411","(۳۱۴۱۱) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ جَابِرٍ، عَنْ عَامِرٍ، قَالَ: لاَ بَأْسَ أَنْ یُوصَی لِلْیَہُودِیِّ وَالنَّصْرَانِیِّ۔","","Musannaf Ibn Abi Shaybah 31411","","","كتاب الوصايا"
"31412","(۳۱۴۱۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ {إلاَّ أَنْ تَفْعَلُوا إلَی أَوْلِیَائِکُمْ مَعْرُوفًا} قَالَ : أَوْلِیَائِکَ مِنْ أَہْلِ الْکِتَابِ ، یَقُولُ : وَصِیَّۃٌ وَلاَ مِیرَاثَ لَہُمْ۔","","Musannaf Ibn Abi Shaybah 31412","","","كتاب الوصايا"
"31413","(۳۱۴۱۳) حَدَّثَنَا عُمَرُ بْنُ ہَارون، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ: سَمِعَہُ وَہُوَ یُسْأَلُ عَنِ الْوَصِیَّۃِ لأَہْلِ الشِّرْکِ؟ قَالَ : لاَ بَأْسَ بِہَا۔","","Musannaf Ibn Abi Shaybah 31413","","","كتاب الوصايا"
"31414","(۳۱۴۱۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ : أَنَّ عُمَرَ أَوْصَی إلَی حَفْصَۃَ۔","","Musannaf Ibn Abi Shaybah 31414","","","كتاب الوصايا"
"31415","(۳۱۴۱۵) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا أَبُو جَنَابٍ، عَنْ أَبِی عَوْنٍ الثَّقَفِیِّ: أَنَّ رَجُلاً أَوْصَی إلَی امْرَأَتِہِ، فَأَجَازَ ذَلِکَ شُرَیْحٌ۔","","Musannaf Ibn Abi Shaybah 31415","","","كتاب الوصايا"
"31416","(۳۱۴۱۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُمَرَ بْنِ عَمْرٍو الأَزْدِیِّ ، قَالَ : حدَّثَتْنِی خَالَتِی ، وَکَانَتِ امْرَأَۃُ إبْرَاہِیمَ ، قَالَتْ : أَوْصَی إلَیَّ إبْرَاہِیمُ بِشَیْئٍ مِنْ وَصِیَّتِہِ۔","","Musannaf Ibn Abi Shaybah 31416","","","كتاب الوصايا"
"31417","(۳۱۴۱۷) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : لاَ تَکُونُ الْمَرْأَۃُ وَصِیًّا ، فَإِنْ فَعَلَ نُظِرَ إلَی رَجُلٍ یَوْثقُ بِہِ ، فَجُعِلَ ذَلِکَ إلَیْہِ","","Musannaf Ibn Abi Shaybah 31417","","","كتاب الوصايا"
"31418","(۳۱۴۱۸) وَسَمِعْت وَکِیعًا یَقُولُ : قَالَ سُفْیَانُ : تَکُونُ وَصِیًّا ، رُبَّ امْرَأَۃٍ خَیْرٌ مِنْ رَجُلٍ۔","","Musannaf Ibn Abi Shaybah 31418","","","كتاب الوصايا"
"31419","(۳۱۴۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِکْرِمَۃَ : فِی رَجُلٍ أَوْصَی وَصِیَّۃً لِلْمُحْوِجِینَ ، قَالَ : یُجْعَلُ فِی الْقَرَابَۃِ ، فَإِنْ لَمْ یَکُونُوا فَللْمَوَالِی ، فَإِنْ لَمْ یَکُونُوا فَللْجِیرَانِ۔","","Musannaf Ibn Abi Shaybah 31419","","","كتاب الوصايا"
"31420","(۳۱۴۲۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، قَالَ : قَالَ عُبَیْدُ اللہِ بْنُ عَبْدِ اللہِ بْنِ مَعْمَرٍ فِی الْوَصِیَّۃِ : مَنْ سَمَّی : جَعَلْنَاہَا حَیْثُ سَمَّی ، وَمَنْ قَالَ حَیْثُ أَمَرَ اللَّہُ : جَعَلْنَاہَا فِی قَرَابَتِہِ۔ (عبدالرزاق ۱۶۴۳۰)","","Musannaf Ibn Abi Shaybah 31420","","","كتاب الوصايا"
"31421","(۳۱۴۲۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، عَنِ الْحَسَنِ : فِی الرَّجُلِ یُوصِی لِلأَبَاعِدِ وَیَتْرُکُ الأَقَارِبَ ، قَالَ : تُجْعَلُ وَصِیَّتُہُ ثَلاَثَۃُ أَثْلاَثٍ : لِلأَقَارِبِ ثُلُثَانِ ، وَلِلأَبَاعِدِ ثُلُثٌ ، وَأَمَّا مُحَمَّدُ بْنُ کَعْبٍ ، فَقَالَ : إنَّمَا ہُوَ مَالٌ ، أَعْطَاہُ اللَّہُ ، یَضَعُہُ حَیْثُ أَحَبَّ۔","","Musannaf Ibn Abi Shaybah 31421","","","كتاب الوصايا"
"31422","(۳۱۴۲۲) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ حُمَیْدٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : ضَعُوہَا حَیْثُ أَمَرَ بِہَا۔","","Musannaf Ibn Abi Shaybah 31422","","","كتاب الوصايا"
"31423","(۳۱۴۲۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ ہَمَّامٍ : أَنَّ قَتَادَۃَ سُئِلَ عَنِ الرَّجُلِ یُوصِی لِغَیْرِ قَرَابَتِہِ ؟ قَالَ : کَانَ سَالِمٌ وَسُلَیْمَانُ بْنُ یَسَارٍ وَعَطَائٌ یَقُولُونَ : ہِیَ لِمَنْ أُوصِی لَہُ بِہَا۔","","Musannaf Ibn Abi Shaybah 31423","","","كتاب الوصايا"
"31424","(۳۱۴۲۴) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ : أَوْصَی إِنْسَانٌ فِی سَبِیلِ اللہِ ، وَفِی الْمَسَاکِینِ ، وَتَرَکَ قَرَابَۃً مُحْتَاجِینَ ؟ قَالَ : وَصِیَّتُہُ حَیْثُ أَوْصَی بِہَا۔","","Musannaf Ibn Abi Shaybah 31424","","","كتاب الوصايا"
"31425","(۳۱۴۲۵) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : أَمَرَہُمْ بِأَمْرٍ فَإِنْ خَالَفُوا جَازَ وَبِئْسَ مَا صَنَعُوا ، وَقَدْ کَانَ عَطَاء قَالَ : ذُو الْقَرَابَۃِ أَحَقُّ بِہَا۔","","Musannaf Ibn Abi Shaybah 31425","","","كتاب الوصايا"
"31426","(۳۱۴۲۶) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا إسْرَائِیلُ، عَنْ جَابِرٍ، عَنْ عَامِرٍ، قَالَ: لِلرَّجُلِ ثُلُثُہُ، یَطْرَحُہُ فِی الْبَحْرِ إنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 31426","","","كتاب الوصايا"
"31427","(۳۱۴۲۷) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ : فِی الرَّجُلِ یُوصِی لِلأَبَاعِدِ وَیَتْرُکُ الأَقَارِبَ ، قَالَ : تُجْعَلُ وَصِیَّتُہُ ثَلاَثَۃَ أَثْلاَثٍ : لِلأَقَارِبِ ثُلُثَانِ ، وَلِلأَبَاعِدِ ثُلُثٌ۔","","Musannaf Ibn Abi Shaybah 31427","","","كتاب الوصايا"
"31428","(۳۱۴۲۸) حَدَّثَنَا الضَّحَّاکُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : کَانَ لاَ یَرَی الْوَصِیَّۃَ إلاَّ لِذَوِی الأَرْحَامِ أَہْلِ الْفَقْرِ ، فَإِنْ أَوْصَی بِہَا لِغَیْرِہِمْ إنْتُزِعَتْ مِنْہُمْ فَرُدَّتْ إلَیْہِمْ ، فَإِنْ لَمْ یَکُنْ فِیہِمْ فُقَرَائُ فَلأَہْلِ الْفَقْرِ مَا کَانُوا ، وَإِنْ سَمَّی أَہْلُہَا الَّذِینَ أُوصِی لَہُمْ۔","","Musannaf Ibn Abi Shaybah 31428","","","كتاب الوصايا"
"31429","(۳۱۴۲۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ أَبِی مَیْمُونَۃَ ، قَالَ : سَأَلْتُ الْعَلاَئَ بْنَ زِیَادٍ وَمُسْلِمَ بْنَ یَسَارٍ عَنِ الْوَصِیَّۃِ ؟ فَدَعَا بِالْمُصْحَفِ فَقَرَأَ : {إنْ تَرَکَ خَیْرًا الْوَصِیَّۃُ لِلْوَالِدَیْنِ وَالأَقْرَبِینَ} قَالاَ: ہِیَ لِلْقَرَابَۃِ۔","","Musannaf Ibn Abi Shaybah 31429","","","كتاب الوصايا"
"31430","(۳۱۴۳۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ ہَمَّامِ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ وَعَبْدِ الْمَلِکِ بْنِ یَعْلَی ، قَالاَ : تُرَدُّ عَلَی قَرَابَتِہِ۔","","Musannaf Ibn Abi Shaybah 31430","","","كتاب الوصايا"
"31431","(۳۱۴۳۱) حَدَّثَنَا حَفْصٌ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ : أَنَّ أَبَا طَلْحَۃَ أَتَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : یَا رَسُولَ اللہِ ، إنِّی جَعَلْت حَائِطِی لِلَّہِ ، وَلَوَ اسْتَطَعْت أَنْ أُخْفِیَہُ لَمْ أُظْہِرْہُ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اجْعَلْہُ فِی فُقَرَائِ أَہْلِک۔ (مسلم ۲۸۵۔ ابوداؤد ۱۶۸۶)","Sahih","Musannaf Ibn Abi Shaybah 31431","","","كتاب الوصايا"
"31432","(۳۱۴۳۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَقُولُ : فِی الرَّجُلِ إذَا أَوْصَی فِی مَرَضِہِ ، ثُمَّ بَرَأَ فَلَمْ یُغَیِّرْ وَصِیَّتَہُ تِلْکَ حَتَّی یَمُوتَ بَعْدُ ، قَالَ : یُؤْخَذُ بِمَا فِیہَا۔","","Musannaf Ibn Abi Shaybah 31432","","","كتاب الوصايا"
"31433","(۳۱۴۳۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ یَعْلَی : فِی رَجُلٍ أَوْصَی بِوَصِیَّۃٍ فِی مَرَضِہِ فَبَرَأَثُمَّ تَرَکَہَا حَتَّی مَاتَ ، قَالَ : جَائِزَۃٌ۔","","Musannaf Ibn Abi Shaybah 31433","","","كتاب الوصايا"
"31434","(۳۱۴۳۴) حَدَّثَنَا حَفْصٌ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، قَالَ : سُئِلَ عَامِرٌ عَنْ رَجُلٍ مَاتَ وَتَرَکَ ثَلاَثَۃَ بَنِینَ ، وَأَوْصَی بِمِثْلِ نَصِیبِ أَحَدِہِمْ ؟ قَالَ : ہُوَ رَابِعٌ ، لَہُ الرُّبْعُ۔","","Musannaf Ibn Abi Shaybah 31434","","","كتاب الوصايا"
"31435","(۳۱۴۳۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ وَالأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا تَرَکَ الرَّجُلُ ثَلاَثَۃَ بَنِینَ وَأَوْصَی بِمِثْلِ نَصِیبِ أَحَد بَنِیہِ ، قَالَ : زِدْ وَاحِدًا اجْعَلْہَا مِنْ أَرْبَعَۃٍ۔","","Musannaf Ibn Abi Shaybah 31435","","","كتاب الوصايا"
"31436","(۳۱۴۳۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : زِدْ وَاحِدًا وَاجْعَلْہَا مِنْ أَرْبَعَۃٍ۔","","Musannaf Ibn Abi Shaybah 31436","","","كتاب الوصايا"
"31437","(۳۱۴۳۷) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ مَنْص[corrupt]ورٍ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ تَرَکَ ابْنَیْنِ وَأَبَوَیْنِ ، وَأَوْصَی بِمِثْلِ نَصِیبِ أَحَدِ الاِبْنَیْنِ ، قَالَ ، ہِیَ مِنْ ثَمَانِیَۃٍ۔","","Musannaf Ibn Abi Shaybah 31437","","","كتاب الوصايا"
"31438","(۳۱۴۳۸) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ مَنْصُورٍ وَمُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ تَرَکَ سِتَّۃَ بَنِینَ وَأَوْصَی بِمِثْلِ نَصِیبِ بَعْضِ وَلَدِہِ ، قَالَ : قَالَ مَنْصُورٌ : ہِیَ مِنْ سَبْعَۃٍ ، یَدْخُلُ مَعَہُمْ ، وَقَالَ مُغِیرَۃُ : یُنْقَصُ وَلاَ یُتَمُّ لَہُ مِثْلُ نَصِیبِ أَحَدِہِمْ۔","","Musannaf Ibn Abi Shaybah 31438","","","كتاب الوصايا"
"31439","(۳۱۴۳۹) حَدَّثَنَا أَبُو مُعَاویَۃ ، حَدَّثَنَا أَبُو عَاصِمٍ الثَّقَفِیُّ ، قَالَ : لَقِیَنِی إبْرَاہِیمُ فَقَالَ : مَا تَقُولُ فِی رَجُلٍ أَوْصَی بِنِصْفِہِ وَثُلُثِہِ وَرُبْعِہِ ، قَالَ : فَلَمْ یَکُنْ عِنْدِی فِیہَا شَیْئٌ ، فَقَالَ : إبْرَاہِیمُ ، خُذْ مَالاً لَہُ نِصْفٌ وَثُلُثٌ وَرُبْعٌ : اثْنَا عَشَرَ فَخُذْ نِصْفَہَا سِتَّۃً وَثُلُثَہَا أَرْبَعَۃً وَرُبْعَہَا ثَلاَثَۃً ، فَاقْسِمَ الْمَالَ عَلَی ثَلاَثَۃَ عَشَرَ ، فَمَا أَصَابَ سِتَّۃً کَانَ لِصَاحِبِ النِّصْفِ ، وَمَا أَصَابَ أَرْبَعَۃً کَانَ لِصَاحِبِ الثُّلُثِ ، وَمَا أَصَابَ ثَلاَثَۃً کَانَ لِصَاحِبِ الرُّبْعِ۔","","Musannaf Ibn Abi Shaybah 31439","","","كتاب الوصايا"
"31440","(۳۱۴۴۰) حَدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یُوصِیَ الرَّجُلُ بِمِثْلِ نَصِیبِ أَحَدِ الْوَرَثَۃِ حَتَّی یَکُونَ أَقَلَّ۔","","Musannaf Ibn Abi Shaybah 31440","","","كتاب الوصايا"
"31441","(۳۱۴۴۱) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا عُبَادَۃُ الصَّیْدَلاَنِیُّ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ : أَنَّہُ أَوْصَی بِمِثْلِ نَصِیبِ أَحَدِ وَلَدِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 31441","","","كتاب الوصايا"
"31442","(۳۱۴۴۲) حَدَّثَنَا وَکِیعٌ حَدَّثَنَا زَائِدَۃُ أَبُو قُتَیْبَۃَ الْہَمْدَانِیُّ ، عَنْ یَسَارِ بْنِ أَبِی کَرِبٍ ، عَنْ شُرَیْحٍ : أَنَّہُ قَضَی فِی رَجُلٍ أَوْصَی لِرَجُلٍ بِسَہْمٍ مِنْ مَالِہِ وَلَمْ یُسَمِّ ، قَالَ : تُرْفَعُ السِّہَامُ فَیَکُونُ لِلْمُوصَی لَہُ سَہْمٌ۔","","Musannaf Ibn Abi Shaybah 31442","","","كتاب الوصايا"
"31443","(۳۱۴۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ رَجُلٍ مِنْ أَہْلِ خُرَاسَانَ ، عَنْ عِکْرِمَۃَ ، قَالَ : لَیْسَ لَہُ شَیْئٌ ، ہَذَا مَجْہُولٌ۔","","Musannaf Ibn Abi Shaybah 31443","","","كتاب الوصايا"
"31444","(۳۱۴۴۴) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ یَعْقُوبَ بْنِ الْقَعْقَاعِ ، عَنْ عَطَائٍ۔ وَیَعْقُوبَ ، عَنْ مُحَمَّدِ بْنِ صُہَیْبٍ ، عَنْ عِکْرِمَۃَ : فِی رَجُلٍ أَوْصَی لِرَجُلٍ بِسَہْمٍ مِنْ مَالِہِ ، قَالَ : لَیْسَ بِشَیْئٍ ، لَمْ یُبَیِّنْ۔","","Musannaf Ibn Abi Shaybah 31444","","","كتاب الوصايا"
"31445","(۳۱۴۴۵) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ أَیُّوبَ ، عَنْ إیَاسِ بْنِ مُعَاوِیَۃَ ، قَالَ : کَانَتِ الْعَرَبُ تَقُولُ : لَہُ السُّدُسُ۔","","Musannaf Ibn Abi Shaybah 31445","","","كتاب الوصايا"
"31446","(۳۱۴۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ ، عَنْ أَبِی قَیْسٍ ، عَنِ الْہُزَیْلِ : أَنَّ رَجُلاً جَعَلَ لِرَجُلٍ سَہْمًا مِنْ مَالِہِ وَلَمْ یُسَمِّ ، فَقَالَ عَبْدُ اللہِ : لَہُ السُّدُسُ۔","Da'if","Musannaf Ibn Abi Shaybah 31446","","","كتاب الوصايا"
"31447","(۳۱۴۴۷) حَدَّثَنَا عَفَّانُ ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ حُمَیْدٍ : أَنْ عَدِیًّا سَأَلَ إیَاسًا ؟ فَقَالَ : السَّہْمُ فِی کَلاَمُ الْعَرَبِ السُّدُسُ۔","","Musannaf Ibn Abi Shaybah 31447","","","كتاب الوصايا"
"31448","(۳۱۴۴۸) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ، أَنَّ امْرَأَۃً قِیلَ لَہَا فِی مَرَضِہَا : أَوْصِی بِکَذَا ، أَوْصِی بِکَذَا ، فَأَوْمَأَتْ بِرَأْسِہَا ، فَلَمْ یُجِزْہُ عَلِیُّ بْنُ أَبِی طَالِبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31448","","","كتاب الوصايا"
"31449","(۳۱۴۴۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ حُسَیْنِ الْمُعَلِّمِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ بْنِ أَبِی رَبِیعَۃَ ، أَو الْحَارِثِ بْنِ عَبْدِ اللہِ بْنِ أَبِی رَبِیعَۃَ ، قَالَ : قُلْتُ لِعُمَرَ : شَیْئٌ یَصْنَعُہُ أَہْلُ الْیَمَنِ ، یُوصِی الرَّجُلُ، ثُمَّ یُغَیِّرُ وَصِیَّتَہُ ، قَالَ : لِیُغَیِّرْ مَا شَائَ مِنْ وَصِیَّتِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 31449","","","كتاب الوصايا"
"31450","(۳۱۴۵۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ عُمَرُ : مَا أَعْتَقَ الرَّجُلُ فِی مَرَضِہِ مِنْ رَقِیقِہِ فَہِیَ وَصِیَّۃٌ إنْ شَائَ رَجَعَ فِیہَا۔","Da'if","Musannaf Ibn Abi Shaybah 31450","","","كتاب الوصايا"
"31451","(۳۱۴۵۱) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یُغَیِّرُ الرَّجُلُ مِنْ وَصِیَّتِہِ مَا شَائَ إلاَّ الْعَتَاقَۃ۔","","Musannaf Ibn Abi Shaybah 31451","","","كتاب الوصايا"
"31452","(۳۱۴۵۲) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : کُلُّ وَصِیَّۃٍ إنْ شَائَ رَجَعَ فِیہَا غَیْرِ الْعَتَاقَۃَ۔","","Musannaf Ibn Abi Shaybah 31452","","","كتاب الوصايا"
"31453","(۳۱۴۵۳) حَدَّثَنَا ابْنُ مَہْدِی، عَنْ حَمَّادِ بْنِ سَلَمَۃَ، عَنْ حَجَّاجٍ، عَنِ الْحَکَمِ، عَنْ إبْرَاہِیمَ، قَالَ: إذَا أَوْصَی الرَّجُلُ بِوَصَایَا، وَأَعْتَقَ غُلاَمًا لَہُ إنْ حَدَثَ بِہِ حَدَثُ الْمَوْتِ، قَالَ: لاَ یَرْجِعُ فِی الْعِتْقِ؛ لَیْسَ الْعِتْق کَسَائِرِ الْوَصِیَّۃ۔","","Musannaf Ibn Abi Shaybah 31453","","","كتاب الوصايا"
"31454","(۳۱۴۵۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا أَوْصَی الرَّجُلُ فَإِنَّہُ یُغَیِّرُ وَصِیَّتَہُ مَا شَائَ ، قِیلَ لَہُ : فَالْعَتَاقَۃُ ، قَالَ الْعَتَاقَۃُ وَغَیْرُ الْعَتَاقَۃِ ، وَإِنَّمَا یُؤْخَذُ بِآخِرِہَا۔","","Musannaf Ibn Abi Shaybah 31454","","","كتاب الوصايا"
"31455","(۳۱۴۵۵) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ طَاوُوسٍ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَعُودَ الرَّجُلُ فِی عَتَاقِہِ۔","","Musannaf Ibn Abi Shaybah 31455","","","كتاب الوصايا"
"31456","(۳۱۴۵۶) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ عَاصِمٍ ، قَالَ : مَرِضَ أَبُو الْعَالِیَۃَ فَأَعْتَقَ مَمْلُوکًا لَہُ ذَکَرُوا لَہُ أَنَّہُ مِنْ وَرَائِ النَّہَرِ ، فَقَالَ : إنْ کَانَ حَیًّا فَلاَ أُعْتِقُہُ ، وَإِنْ کَانَ مَیِّتًا فَہُوَ عَتِیقٌ ، وَذَکَرَ ہَذِہِ الآیَۃَ : {وَلَہُ ذُرِّیَّۃٌ ضُعَفَائُ}۔","","Musannaf Ibn Abi Shaybah 31456","","","كتاب الوصايا"
"31457","(۳۱۴۵۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانُوا یُوصُونَ ، فَیَکْتُبُ الرَّجُلُ فِی وَصِیَّتِہِ : إنْ حَدَثَ بِی حَدَثٌ قَبْلَ أَنْ أُغَیِّرَ وَصِیَّتِی ہَذِہِ فَإِنْ بَدَا لَہُ أَنْ یُغَیِّرَ غَیَّرَ إنْ شَائَ الْعَتَاقَۃَ وَغَیْرَہَا ، فَإِنْ لَمْ یَسْتَثْنِ فِی وَصِیَّتِہِ غَیَّرَ مِنْہَا مَا شَائَ غَیْرَ الْعَتَاقَۃِ۔","","Musannaf Ibn Abi Shaybah 31457","","","كتاب الوصايا"
"31458","(۳۱۴۵۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ رُوحِ بْنِ الْقَاسِمِ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ : کَانَ یُقْسِمُ عَلَیْہِ قَسَمًا ، أَنَّ الْمُعْتَقَ عَنْ دُبُرِ وَصِیَّۃٍ ، وَأَنَّ لِلرَّجُلِ أَنْ یُغَیِّرَ مِنْ وَصِیَّتِہِ مَا شَائَ۔","","Musannaf Ibn Abi Shaybah 31458","","","كتاب الوصايا"
"31459","(۳۱۴۵۹) حَدَّثَنَا سَعِیدُ بْنُ خُثَیْمٍ ، عَنْ حَنْظَلَۃَ ، عَنْ طَاوُوسٍ ، قَالَ : یَرْجِعُ مَوْلَی الْمُدَبَّرِ فِیہِ مَتَی شَائَ۔","","Musannaf Ibn Abi Shaybah 31459","","","كتاب الوصايا"
"31460","(۳۱۴۶۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ نَافِعٍ ، قَالَ : قالَتْ عَائِشَۃُ : لِیَکْتُبَ الرَّجُلُ فِی وَصِیَّتِہِ : إنْ حَدَثَ بِی حَدَثٌ قَبْلَ أَنْ أُغَیِّرَ وَصِیَّتِی ہَذِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31460","","","كتاب الوصايا"
"31461","(۳۱۴۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ عَامِرِ بْنِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ : أَنَّ ابْنَ مَسْعُودٍ أَوْصَی فَکَتَبَ فِی وَصِیَّتِہِ : بِسْمِ اللہِ الرَّحْمَن الرَّحِیمِ ، ہَذَا مَا أَوْصَی بِہِ ابْنُ مَسْعُودٍ : إنْ حَدَثَ بِہِ حَدَثٌ فِی مَرَضِہِ ہَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 31461","","","كتاب الوصايا"
"31462","(۳۱۴۶۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانُوا یُوصُونَ فَیَکْتُبُ الرَّجُلُ فِی وَصِیَّتِہِ : إنْ حَدَثَ بِی حَدَثٌ قَبْلَ أَنْ أُغَیِّرَ وَصِیَّتِی ہَذِہِ۔","","Musannaf Ibn Abi Shaybah 31462","","","كتاب الوصايا"
"31463","(۳۱۴۶۳) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ أَبِی خَلْدَۃَ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : أَوْصَیْت بِضْعَ عَشْرَ مَرَّۃٍ أُوَقِّت وَقْتًا إذَا جَائَ الْوَقْتُ کُنْت بِالْخِیَارِ۔","","Musannaf Ibn Abi Shaybah 31463","","","كتاب الوصايا"
"31464","(۳۱۴۶۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی عُمَیْرٍ الْحَارِثُ بْنُ عُمَیْرٍ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : أَنَّہُ کَانَ یَشْتَرِطُ : إنْ حَدَثَ بِی حَدَثٌ قَبْلَ أُغَیِّرَ کِتَابِی ہَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 31464","","","كتاب الوصايا"
"31465","(۳۱۴۶۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوس : أَنَّ رَجُلاً مِنْ أَہْلِ الْیَمَنِ أَوْصَی ، فَقَالَ : فُلاَنٌ حُرٌّ وَفُلاَنٌ حُرٌّ - وَلَمْ یُسَمِّ - إنْ مِتّ فِی مَرَضِی ہَذَا ، فَبَرَأَ الرَّجُلُ فَخَاصَمَہُ مَمْلُوکَاہُ إِلَی قَاضِی أَہْلِ الْجَنَدِ ، فَشَاوَرَ فِی ذَلِکَ طَاوُوسًا ، فَقَالَ طَاوُوس : ہُمْ عَبِیدٌ ، إنَّمَا کَانَتْ نِیَّتُہُ : إنْ حَدَثَ بِہِ حَدَثٌ۔","","Musannaf Ibn Abi Shaybah 31465","","","كتاب الوصايا"
"31466","(۳۱۴۶۸) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ : أَنَّہُ سُئِلَ عَنْ رَجُلٍ أَوْصَی بِجَارِیَتِہِ لاِبْنِ أَخِیہِ ، ثُمَّ وَطِئَہَا ؟ قَالَ : أَفْسَدَ وَصِیَّتَہُ۔","","Musannaf Ibn Abi Shaybah 31466","","","كتاب الوصايا"
"31467","(۳۱۴۶۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَوْصَی بِہِمَا فَہُمَا مِنَ الثُّلُثِ۔ یَعْنِی : الْحَجَّ وَالزَّکَاۃَ۔","","Musannaf Ibn Abi Shaybah 31467","","","كتاب الوصايا"
"31468","(۳۱۴۶۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَوْصَی بِحَجَّۃ وَلَمْ یَکُنْ حَجَّ فَمِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31468","","","كتاب الوصايا"
"31469","(۳۱۴۶۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31469","","","كتاب الوصايا"
"31470","(۳۱۴۷۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ وَمَنْصُورٍ ، عَنِ الْحَسَنِ ، قَالَ : ہُوَ مِنْ جَمِیعِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 31470","","","كتاب الوصايا"
"31471","(۳۱۴۷۱) حَدَّثَنَا جَرِیرٌ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنِ الْحَسَنِ وَطَاوُسٍ : فِی الرَّجُلِ عَلَیْہِ حِجَّۃُ الإسْلاَمِ وَتَکُونُ عَلَیْہِ الزَّکَاۃُ فِی مَالِہِ ؟ قَالاَ : یَکُونَانِ ہَذَیْنِ بِمَنْزِلَۃِ الدَّیْنِ۔","","Musannaf Ibn Abi Shaybah 31471","","","كتاب الوصايا"
"31472","(۳۱۴۷۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ ، عَنِ الشَّعْبِیِّ : فِی الرَّجُلِ یَمُوتُ وَیُوصِی أَنْ یُحَجَّ عَنْہُ ، أَوْ یُتَصَدَّقَ عَنْہُ کَفَّارَۃُ رَمَضَانَ ، أَوْ کَفَّارَۃُ یَمِینٍ ؟ قَالَ : مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31472","","","كتاب الوصايا"
"31473","(۳۱۴۷۳) حَدَّثَنَا عَبْدُالأَعْلَی، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ، قَالَ: إذَا کَانَ عَلَی الرَّجُلِ شَیْئٌ وَاجِبٌ فَہُوَ مِنْ جَمِیعِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 31473","","","كتاب الوصايا"
"31474","(۳۱۴۷۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : ہُوَ مِنْ جَمِیعِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 31474","","","كتاب الوصايا"
"31475","(۳۱۴۷۵) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ صَالِحِ بْنِ خَوَّاتٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ : أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ : أَنَّ الْمُکَاتَبَ لاَ تَجُوزُ لَہُ وَصِیَّۃٌ ، وَلاَ ہِبَۃٌ إلاَّ بِإِذْنِ مَوْلاَہُ۔","","Musannaf Ibn Abi Shaybah 31475","","","كتاب الوصايا"
"31476","(۳۱۴۷۶) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : الْمُکَاتَبُ لاَ یَعْتِقُ ، وَلاَ یَہَبُ إلاَّ بِإِذْنِ مَوْلاَہُ۔","","Musannaf Ibn Abi Shaybah 31476","","","كتاب الوصايا"
"31477","(۳۱۴۷۷) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : الأَحْمَقُ وَالمُوَسْوَسُ أَتَجُوزُ وَصِیَّتُہُمَا إنْ أَصَابَا الْحَقَّ وَہُمَا مَغْلُوبَانِ عَلَی عُقُولِہِمَا ؟ قَالَ : مَا أَحْسَبُ لَہُمَا وَصِیَّۃ۔","","Musannaf Ibn Abi Shaybah 31477","","","كتاب الوصايا"
"31478","(۳۱۴۷۸) حَدَّثَنَا ابْنُ مَہْدِی ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ إیَاسِ بْنِ مُعَاوِیَۃَ : فِی وَصِیَّۃِ الْمَجْنُونِ ، قَالَ : إِذَا أَصَابَ الْحَقّ جَازَ۔","","Musannaf Ibn Abi Shaybah 31478","","","كتاب الوصايا"
"31479","(۳۱۴۷۹) حَدَّثَنَا ابْنُ مَہْدِیٌّ ، عَنْ ہَمَّامٍ ، عَنْ قَتَادَۃَ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : لاَ تَجُوزُ وَصِیَّۃ وَلاَ طَلاَق إِلاَّ فِی عَقْلٍ۔","","Musannaf Ibn Abi Shaybah 31479","","","كتاب الوصايا"
"31480","(۳۱۴۸۰) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، قَالَ : إنْ کَانَ سَمَّی الْغُزَاۃَ : أُعْطِیَ الْغُزَاۃَ ، وَإِلاَّ : طَاعَۃُ اللہِ : سَبِیلُہُ۔","","Musannaf Ibn Abi Shaybah 31480","","","كتاب الوصايا"
"31481","(۳۱۴۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی حَبِیبَۃَ ، عَنْ أَبِی الدَّرْدَائِ : فِی الرَّجُلِ أَوْصَی بِشَیْئٍ فِی سَبِیلِ اللہِ ، قَالَ فِی الْمُجَاہِدِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 31481","","","كتاب الوصايا"
"31482","(۳۱۴۸۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ : أَنَّ امْرَأَۃً أَوْصَتْ بِثَلاَثِینَ دِرْہَمًا فِی سَبِیلِ اللہِ ، فَلَمَّا کَانَ زَمَنُ الفُرْقَۃِ قُلْتُ لاِبْنِ عُمَرَ : امْرَأَۃٌ أَوْصَتْ بِثَلاَثِینَ دِرْہَمًا فِی سَبِیلِ اللہِ ، فَنُعْطِیہَا فِی الْحَجِّ ؟ فَقَالَ : أَمَا إِنَّہُ مِنْ سَبِیلِ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31482","","","كتاب الوصايا"
"31483","(۳۱۴۸۳) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ وَاقِدِ بْنِ مُحَمَّدِ بْنِ زَیْدٍ : أَنَّ رَجُلاً مَاتَ وَتَرَکَ مَالاً وَأَوْصَی بِہِ فِی سَبِیلِ اللہِ ، فَذَکَرَ ذَلِکَ الْوَصِیُّ لِعُمَرَ بْنَ الْخَطَّابِ ، فَقَالَ : أَعْطِہِ عُمَّالَ اللہِ ، قَالَ : وَمَا عُمَّالُ اللہِ ؟ قَالَ : حُجَّاجُ بَیْتِ اللہِ۔","Da'if","Musannaf Ibn Abi Shaybah 31483","","","كتاب الوصايا"
"31484","(۳۱۴۸۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ أَیْمَنَ بْنِ نَابِلٍ ، قَالَ : سَأَلَ رَجُلٌ مُجَاہِدًا عَنْ رَجُلٍ ، قَالَ : کُلُّ شَیْئٍ لِی فِی سَبِیلِ اللہِ ؟ قَالَ مُجَاہِدٌ : لَیْسَ سَبِیلُ اللہِ وَاحِدًا ، کُلُّ خَیْرٍ عَمِلَہُ فَہُوَ فِی سَبِیلِ اللہِ۔","","Musannaf Ibn Abi Shaybah 31484","","","كتاب الوصايا"
"31485","(۳۱۴۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَنَسِ بْنِ سِیرِینَ : أَنَّ رَجُلاً أَوْصَی بِشَیْئٍ فِی سَبِیلِ اللہِ ، فَقَالَ ابْنُ عُمَرَ: الْحَجُّ فِی سَبِیلِ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31485","","","كتاب الوصايا"
"31486","(۳۱۴۸۶) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ : أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ فِی رَجُلٍ تَصَدَّقَ بِمَالِہِ کُلِّہِ عَلَی غَیْرِ وَارِثٍ ، ثُمَّ حَبَسَہُ حَتَّی مَاتَ ، یُرَدُّ ذَلِکَ إلَی الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31486","","","كتاب الوصايا"
"31487","(۳۱۴۸۷) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : مَنْ صَنَعَ فِی مَالِہِ شَیْئًا لَمْ یُنَفِّذْہُ حَتَّی یَحْضُرَہُ الْمَوْتُ : فَہُوَ فِی سَبِیلِہِ۔","","Musannaf Ibn Abi Shaybah 31487","","","كتاب الوصايا"
"31488","(۳۱۴۸۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، قَالَ : جَائَ رَجُلٌ إلَی الْحَسَنِ بِوَصِیَّۃٍ مَخْتُومَۃٍ لِیَشْہَدَ عَلَیْہَا ، فَقَالَ الْحَسَنُ : مَا تَجِدُ فِی ہَؤُلاَئِ النَّاسِ رَجُلَیْنِ تَثِقْہُمَا تُشْہِدُہُمَا عَلَی کِتَابِکَ ہَذَا ؟!۔","","Musannaf Ibn Abi Shaybah 31488","","","كتاب الوصايا"
"31489","(۳۱۴۸۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : أَرَاہُ عَنْ إبْرَاہِیمَ : فِی الرَّجُلِ یَخْتِمُ وَصِیَّتَہُ ، وَیَقُولُ لِلْقَوْمِ : اشْہَدُوا عَلَی مَا فِیہَا ، قَالَ : لاَ تَجُوزُ إلاَّ أَنْ یَقْرَأَہَا عَلَیْہِمْ ، أَوْ تُقْرَأَ عَلَیْہِ فَیُقِرَّ بِمَا فِیہَا۔","","Musannaf Ibn Abi Shaybah 31489","","","كتاب الوصايا"
"31490","(۳۱۴۹۰) حَدَّثَنَا أَبُو أُسَامَۃ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ : فِی الرَّجُلِ یَکْتب الوَصِیَّۃ وَیَقُولُ : اشْہَدُوا عَلَی مَا فِی ہَذِہِ الصَّحِیفَۃِ ، قَالَ : لاَ ، حَتَّی یُعْلَمَ مَا فِیہَا۔","","Musannaf Ibn Abi Shaybah 31490","","","كتاب الوصايا"
"31491","(۳۱۴۹۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، عَنْ سَعِیدِ بْنِ زَیْدٍ ، قَالَ : ذَہَبْت مَعَ حَفْصِ بْنِ عَاصِمٍ إلَی سَالِمٍ وَقَدْ خَتَمَ وَصِیَّتَہُ ، فَقَالَ : إنْ حَدَثَ بِی حَادِثٌ فَاشْہَدُوا عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 31491","","","كتاب الوصايا"
"31492","(۳۱۴۹۲) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ یَعْلَی قَاضِی الْبَصْرَۃِ : فِی الرَّجُلِ یَکْتُبُ وَصِیَّتَہُ ، ثُمَّ یَخْتِمُہَا ، ثُمَّ یَقُولُ : اشْہَدُوا عَلَی مَا فِیہَا ، قَالَ : جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 31492","","","كتاب الوصايا"
"31493","(۳۱۴۹۳) حَدَّثَنَا عَبَّادٌ ، عَنْ رَوْحِ بْنِ الْقَاسِمِ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرِ بْنِ عَمْرِو بْنِ حَزْمٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ غُلاَمٌ مِنْ غَسَّانَ بِالْمَدِینَۃِ ، وَکَانَ لَہُ وَرَثَۃٌ بِالشَّامِ ، وَکَانَتْ لَہُ عَمَّۃٌ بِالْمَدِینَۃِ ، فَلَمَّا حُضِرَ أَتَتْ عُمَرَ بْنَ الْخَطَّابِ فَذَکَرَتْ ذَلِکَ لَہُ وَقَالَتْ : أَفَیُوصِی ؟ قَالَ : احْتَلَمَ بَعْدُ ؟ قَالَ : قُلْتُ : لاَ ، قَالَ : فَلْیُوصِ، قَالَ : فَأَوْصَی لَہَا بِنَخْلٍ ، فَبِعْتہ أَنَا لَہَا بِثَلاَثِینَ أَلْفِ دِرْہَمٍ۔","","Musannaf Ibn Abi Shaybah 31493","","","كتاب الوصايا"
"31494","(۳۱۴۹۴) حَدَّثَنَا أَبُو عِصَامٍ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ : أَنَّ عُثْمَانَ أَجَازَ وَصِیَّۃَ ابْنِ إحْدَی عَشْرَۃَ سَنَۃً۔","","Musannaf Ibn Abi Shaybah 31494","","","كتاب الوصايا"
"31495","(۳۱۴۹۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ : أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ أَجَازَ وَصِیَّۃَ الصَّبِیِّ۔","","Musannaf Ibn Abi Shaybah 31495","","","كتاب الوصايا"
"31496","(۳۱۴۹۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، أَنَّ عَبْد اللہِ بْنِ عُتْبَۃَ سُئِلَ عَنْ وَصِیَّۃِ جَارِیَۃٍ صَغَّرُوہَا وَحَقَّرُوہَا ؟ فَقَالَ : مَنْ أَصَابَ الْحَقَّ أُجِر۔","","Musannaf Ibn Abi Shaybah 31496","","","كتاب الوصايا"
"31497","(۳۱۴۹۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی بَکْرِ بْنِ أَبِی مُوسَی ، قَالَ : أَوْصَی ابْنٌ لأَبِی مُوسَی غُلاَمٌ صَغِیرٌ بِوَصِیَّۃٍ ، فَأَرَادَ إخْوَتُہُ أَنْ یَرُدُّوا وَصِیَّتَہُ ، فَارْتَفَعُوا إلَی شُرَیْحٍ ، فَأَجَازَ وَصِیَّۃَ الْغُلاَمِ۔","","Musannaf Ibn Abi Shaybah 31497","","","كتاب الوصايا"
"31498","(۳۱۴۹۸) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ ہِشَامٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : تَجُوزُ وَصِیَّۃُ الصَّبِیِّ فِی مَالِہِ فِی الثُّلُثِ فَمَا دُونَہُ۔","","Musannaf Ibn Abi Shaybah 31498","","","كتاب الوصايا"
"31499","(۳۱۴۹۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : قُلْتُ لَہُ : تَجُوزُ وَصِیَّتُہُ ؟ قَالَ : جَائِزَۃٌ۔","","Musannaf Ibn Abi Shaybah 31499","","","كتاب الوصايا"
"31500","(۳۱۵۰۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عُمَارَۃَ ، قَالَ : سَمِعْتُ أَبَا عَمْرِو بْنِ الأَجْدَعِ ، قَالَ : اخْتَصَمَ إلَی عَلِیٍّ ظِئْرُ غُلاَمٍ ، فَأَمَرَ عَلِیٌّ أَنْ نُعْتِقَہُ ، فَأَعْتَقْنَاہُ۔","Da'if","Musannaf Ibn Abi Shaybah 31500","","","كتاب الوصايا"
"31501",") حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ : أَنَّہُ قَالَ فِی وَصِیَّۃِ الصَّبِیِّ : أَیُّمَا مُوصٍ أَوْصَی فَأَصَابَ حَقًّا جَازَ۔","","Musannaf Ibn Abi Shaybah 31501","","","كتاب الوصايا"
"31502","( (۳۱۵۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَنْ أَبِیہِ : أَنَّ صَبِیًّا أَوْصَی لِظِئْرٍ لَہُ مِنْ أَہْلِ الْحِیرَۃِ بِأَرْبَعِینَ دِرْہَمًا ، فَأَجَازَہُ شُرَیْحٌ۔","","Musannaf Ibn Abi Shaybah 31502","","","كتاب الوصايا"
"31503","(۳۱۵۰۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَنْ أَبِیہِ ، عَنْ شُرَیْحٍ ، قَالَ : إذَا اتَّقَی الصَّبِیُّ الرُّکّی، أَنْ یَقَعَ فِیہَا فَقَدْ جَازَتْ وَصِیَّتُہُ۔","","Musannaf Ibn Abi Shaybah 31503","","","كتاب الوصايا"
"31504","(۳۱۵۰۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ تَجُوزُ وَصِیَّۃُ غُلاَمٍ وَلاَ جَارِیَۃٍ حَتَّی یُصَلِّیَا۔","","Musannaf Ibn Abi Shaybah 31504","","","كتاب الوصايا"
"31505","(۳۱۵۰۵) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ یَجُوزُ عِتْقُ الصَّبِیِّ ، وَلاَ وَصِیَّتُہُ ، وَلاَ بَیْعُہُ ، وَلاَ شِرَاؤُہُ ، وَلاَ طَلاَقُہُ۔","","Musannaf Ibn Abi Shaybah 31505","","","كتاب الوصايا"
"31506","(۳۱۵۰۶) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، قَالَ: لاَ تَجُوزُ وَصِیَّۃُ غُلاَمٍ حَتَّی یَحْتَلِمَ، وَلاَ جَارِیَۃٍ حَتَّی تَحِیضَ۔","","Musannaf Ibn Abi Shaybah 31506","","","كتاب الوصايا"
"31507","(۳۱۵۰۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : وَصِیَّتُہُ لَیْسَتْ بِجَائِزَۃٍ إلاَّ مَا لَیْسَ بِذِی بَالٍ۔","","Musannaf Ibn Abi Shaybah 31507","","","كتاب الوصايا"
"31508","(۳۱۵۰۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ اللہِ ، عَنْ مَکْحُولٍ ، قَالَ : سَمِعْتُہُ یَقُولُ : إذَا بَلَغَ الْغُلاَمُ خَمْسَۃَ عَشَرَ جَازَتْ وَصِیَّتُہُ۔","","Musannaf Ibn Abi Shaybah 31508","","","كتاب الوصايا"
"31509","(۳۱۵۰۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ تَجُوزُ وَصِیَّتُہُ۔","","Musannaf Ibn Abi Shaybah 31509","","","كتاب الوصايا"
"31510","(۳۱۵۱۰) حَدَّثَنَا أَبُو دَاوُدَ ، عَنِ الْمُسْتَمِرِّ بْنِ الرَّیَّانِ ، قَالَ : حضَرْت جَابِرَ بْنَ زَیْدٍ فِی الْمَسْجِدِ الْجَامِعِ ، وَقَالَ لَہُ زُرَارَۃُ بْنُ أَوْفَی - وَہُوَ یَوْمَئِذٍ عَلَی الْقَضَائِ : أَنَّہُ رُفِعَ إلَیَّ غُلاَمٌ أَعْتَقَ عَبْدًا لَہُ ، فَأَنْکَرَ ذَلِکَ الأَوْلِیَائُ ، فَرَأَیْت أَنْ أَرُدَّ ذَلِکَ ، ثُمَّ یُؤدِّی الْغُلاَمُ ، حَتَّی یَشِبَّ الْغُلاَمُ وَیُحِبَّ الْمَالَ ، فَإِنْ شَائَ أَنْ یَمْضِیَ أَمْضَی ، وَإِنْ شَائَ أَنْ یَرُدَّ رَدَّ۔","","Musannaf Ibn Abi Shaybah 31510","","","كتاب الوصايا"
"31511","(۳۱۵۱۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَوْف ، قَالَ : شَہِدْت ہِشَامَ بْنَ ہُبَیْرَۃٍ قَضَی فِی رَجُلٍ أَوْصَی لأُخْتٍ لَہُ عِنْدَ مَوْتِہِ بِمِثْلِ نَصِیبِ اثْنَیْنِ مِنْ وَلَدِہِ ، وَتَرَکَ الْمَیِّتُ بَنِینَ وَبَنَاتٍ ، فَأَرَادَتِ الْمُوصَی لَہَا أَنْ تَجْعَلَ نَفْسَہَا بِمَنْزِلَۃِ الذَّکَرِ ، وَأَبَی الْوَرَثَۃُ أَنْ یَجْعَلُوہَا إلاَّ بِمَنْزِلَۃِ الأُنْثَی ، فَقَضَی أَنَّہَا بِمَنْزِلَتِہَا إنْ لَمْ تَکُنْ تُبَیِّنَ۔","","Musannaf Ibn Abi Shaybah 31511","","","كتاب الوصايا"
"31512","(۳۱۵۱۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَوْفٍ الأَعْرَابِیِّ ، عَنْ ہِشَامِ بْنِ ہُبَیْرَۃَ : أَنَّہُ قَضَی فِی رَجُلٍ أَوْصَی لِرَجُلٍ بِمِثْلِ نَصِیبِ أَحَدِ وَلَدِہِ ، وَلَہُ ذَکَرٌ وَأُنْثَی ، أَنَّ لَہُ نَصِیبَ الأُنْثَی۔ قَالَ أَبُو بَکْرٍ : قَالَ وَکِیعٌ : قَالَ سُفْیَانُ : لَہُ نَصِیبُ أُنْثَی۔","","Musannaf Ibn Abi Shaybah 31512","","","كتاب الوصايا"
"31513","(۳۱۵۱۳) حَدَّثَنَا عُمَرُ ، عَنْ یُونُسَ ، عَنِ الزُّہْرِیِّ : فِی رَجُلٍ أَوْصَی لِرَجُلٍ بِفَرَسٍ وَسَمَّاہُ ، وَقَالَ : ثُلُثُ مَالِی لِفُلاَنٍ وَفُلاَنٍ ، وَکَانَ الْفَرَسُ کَفَاف ثُلُثِ مَالِہِ ، قَالَ الزُّہْرِیُّ : نَرَی أَنْ یُقَسِّمَ ثُلُثَ مَالِہِ عَلَی حِصَصِہِمْ۔","","Musannaf Ibn Abi Shaybah 31513","","","كتاب الوصايا"
"31514","(۳۱۵۱۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ بَعْضِ أَصْحَابِہِ ، عَنِ الْحَسَنِ : أَنَّہُ قَالَ فِی رَجُلٍ أَوْصَی بِدَرَاہِمٍ وَبِالسُّدُسِ وَنَحْوِہِ : یَتَحَاصُّونَ جَمِیعًا۔","Hasan","Musannaf Ibn Abi Shaybah 31514","","","كتاب الوصايا"
"31515","(۳۱۵۱۵) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُوصِیَ الرَّجُلُ لِمَمْلُوکِہِ بِمِئَۃِ دِرْہَمٍ وَالْمِئَتَیْنِ إذَا رَضِیَ الأَوْلِیَائُ ، وَإِنْ جَعَلَ لَہُ شَیْئًا مِنْ ثُلُثِہِ فَہُوَ فِی عُنُقِہِ۔","","Musannaf Ibn Abi Shaybah 31515","","","كتاب الوصايا"
"31516","(۳۱۵۱۶) حَدَّثَنَا حَفْصٌ ، قَالَ : سَأَلْتُ عُمَرَاً عَنِ الرَّجُلِ یُوصِی لِعَبْدِہِ ؟ فَقَالَ : کَانَ الْحَسَنُ یَقُولُ : لَوْ أَوَصَی لَہُ بِرَغِیفٍ وَصِلَتُہُ عَتَاقَتُہُ۔","","Musannaf Ibn Abi Shaybah 31516","","","كتاب الوصايا"
"31517","(۳۱۵۱۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ شَبِیبِ بْنِ غَرْقَدَۃَ ، عَنْ جُنْدُبٍ ، قَالَ : سَأَلَ طَہْمَانُ ابْنَ عَبَّاسٍ : أَیُوصِی الْعَبْدُ ؟ قَالَ : لاَ۔","Da'if","Musannaf Ibn Abi Shaybah 31517","","","كتاب الوصايا"
"31518","(۳۱۵۱۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ ، قَالاَ : وَصِیَّۃُ الرَّجُلِ حَیْثُ جَعَلَہَا إلاَّ أَنْ یُتَّہَمَ الْوَصِیُّ بِہِ۔","","Musannaf Ibn Abi Shaybah 31518","","","كتاب الوصايا"
"31519","(۳۱۵۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : الْوَصِیُّ بِمَنْزِلَۃِ الْوَالِدِ ، وَإِذَا اتُّہِمَ الْوَصِیُّ عُزِلَ ، أَوْ جُعِلَ مَعَہُ غَیْرُہُ۔","","Musannaf Ibn Abi Shaybah 31519","","","كتاب الوصايا"
"31520","(۳۱۵۲۰) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنْ عُمَرَ ، قَالَ : إذَا کَانَتْ وَصِیَّۃٌ وَعَتَاقَۃٌ تَحَاصُّوا۔","Da'if","Musannaf Ibn Abi Shaybah 31520","","","كتاب الوصايا"
"31521","(۳۱۵۲۱) حَدَّثَنَا حَفْصٌ وَابْنُ عُلَیَّۃَ، عَنْ أَشْعَثَ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، قَالَ: إذَا کَانَتْ عَتَاقَۃٌ وَوَصِیَّۃٌ بُدِئَ بِالْعَتَاقَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 31521","","","كتاب الوصايا"
"31522","(۳۱۵۲۲) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ وَحَجَّاجٌ ، عَنِ الْحَکَمِ ، عَنْ شُرَیْحٍ : أَنَّہُ کَانَ یَبْدَأُ بِالْعَتَاقَۃِ۔","","Musannaf Ibn Abi Shaybah 31522","","","كتاب الوصايا"
"31523","(۳۱۵۲۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : فِی الرَّجُلِ یُوصِی بِعَتَاقِ عَبْدِہِ فِی مَرَضِہِ وَیُوصِی مَعَہُ بِوَصَایَا، قَالَ : یُبْدَأُ بِعَتَاقِ الْعَبْدِ قَبْلَ الْوَصَایَا ، فَإِنْ أَوْصَی أَنْ یَشْتَرِیَ لَہُ نَسَمَۃً فَتَعْتِقُ : کَانَتِ النَّسَمَۃُ کَسَائِرِ الْوَصِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 31523","","","كتاب الوصايا"
"31524","(۳۱۵۲۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ یُونُسَ، عَنِ الْحَسَنِ: أَنَّہُ کَانَ یَقُولُ : یُبْدَأُ بِالْعَتَاقِ وَإِنْ أَتَی ذَلِکَ عَلَی الثُّلُثِ کُلِّہِ۔","","Musannaf Ibn Abi Shaybah 31524","","","كتاب الوصايا"
"31525","(۳۱۵۲۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ : أَنَّہُ کَانَ یَقُولُ فِی الْوَصِیَّۃِ یَکُونُ فِیہَا الْعِتْقُ فَتَزِیدُ عَلَی الثُّلُثِ ، قَالَ : الثُّلُثُ بَیْنَہُمْ بِالْحِصَصِ۔","","Musannaf Ibn Abi Shaybah 31525","","","كتاب الوصايا"
"31526","(۳۱۵۲۶) حَدَّثَنَا ہُشَیْمٌ، عَنِ الشَّیْبَانِیِّ عَمَّنْ حَدَّثَہُ، عَنْ مَسْرُوقٍ: أَنَّہُ قَالَ فِی الْعَتَاقَۃِ وَالْوَصِیَّۃِ، قَالَ: یُبْدَأُ بِالْوَصِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 31526","","","كتاب الوصايا"
"31527","(۳۱۵۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ بِالْحِصَصِ۔","","Musannaf Ibn Abi Shaybah 31527","","","كتاب الوصايا"
"31528","(۳۱۵۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُبْدَأُ بِالْعَتَاقَۃِ۔","","Musannaf Ibn Abi Shaybah 31528","","","كتاب الوصايا"
"31529","(۳۱۵۲۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إنَّمَا یُبْدَأُ بِالْعَتَاقَۃِ إذَا سَمَّی مَمْلُوکًا بِعَیْنِہِ۔","","Musannaf Ibn Abi Shaybah 31529","","","كتاب الوصايا"
"31530","(۳۱۵۳۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : قَالَ سُفْیَانُ : إذَا أَوْصَی بِأَشْیَائَ ، وَقَالَ : أَعْتِقُوا عَنِّی فَبِالْحِصَصِ ، وَإِذَا أَوْصَی ، فَقَالَ : فُلاَنٌ حُرٌّ ، بُدِئَ بِالْعَتَاقَۃِ۔","","Musannaf Ibn Abi Shaybah 31530","","","كتاب الوصايا"
"31531","(۳۱۵۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یُبْدَأُ بِالْعَتَاقَۃِ۔","","Musannaf Ibn Abi Shaybah 31531","","","كتاب الوصايا"
"31532","(۳۱۵۳۲) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : بِالْحِصَصِ۔","","Musannaf Ibn Abi Shaybah 31532","","","كتاب الوصايا"
"31533","(۳۱۵۳۳) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ ، یُبْدَأُ بِالْعَتَاقَۃِ۔","","Musannaf Ibn Abi Shaybah 31533","","","كتاب الوصايا"
"31534","(۳۱۵۳۴) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ حَجَّاجٍ ، عَنِ الشَّعْبِیِّ : فِی رَجُلٌ مَاتَ وَتَرَکَ أَلْفَیْ دِرْہَمٍ وَعَبْدًا قِیمَتُہُ أَلْفُ دِرْہَمٍ ، وَأَوْصَی لِرَجُلٍ بِخَمْسِمِئَۃٍ وَأَعْتَق الْعَبْد ، قَالَ : یَعْتِقُ الْعَبْدُ وَتَبْطُلُ الْوَصِیَّۃُ۔","","Musannaf Ibn Abi Shaybah 31534","","","كتاب الوصايا"
"31535","(۳۱۵۳۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : فِی قَوْلِہِ : {وَإِذَا حَضَرَ الْقِسْمَۃَ أُوْلُواْ الْقُرْبَی وَالْیَتَامَی وَالْمَسَاکِینُ فَارْزُقُوہُم مِّنْہُ} فَحَدَّثَ عَنْ مُحَمَّدٍ ، عَنْ عَبِیدَۃَ : أَنَّہُ وَلِیَ وَصِیَّۃً فَأَمَرَ بِشَاۃٍ فَذُبِحَتْ فَصَنَعَ طَعَامًا لأَجْلِ ہَذِہِ الآیَۃِ ، وَقَالَ : لَوْلاَ ہَذِہِ الآیَۃُ لَکَانَ ہَذَا مِنْ مَالِی۔","","Musannaf Ibn Abi Shaybah 31535","","","كتاب الوصايا"
"31536","(۳۱۵۳۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی قَوْلِہِ : {وَإِذَا حَضَرَ الْقِسْمَۃَ أُولُوا الْقُرْبَی وَالْیَتَامَی وَالْمَسَاکِینُ فَارْزُقُوہُمْ مِنْہُ} قَالَ : کَانَ إذَا قَسَمَ الْقَوْمُ الْمِیرَاثَ ، وَکَانَ ہَؤُلاَئِ شُہُودًا رُضِخَ لَہُمْ مِنَ الْمِیرَاثِ ، فَإِنْ کَانُوا غَیَبًا وَأَحَدٌ مِنْہُمْ شَاہِدٌ ، فَإِنْ شَائَ أَعْطَی مِنْ نَصِیبِہِ وَإِلاَّ قَالَ لَہُمْ قَوْلاً مَعْرُوفًا ، قَالَ : یَقُولُ : إنَّ لَکُمْ فِیہِ حَقًّا۔","","Musannaf Ibn Abi Shaybah 31536","","","كتاب الوصايا"
"31537","(۳۱۵۳۷) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی الْعَالِیَۃِ وَالْحَسَنِ ، قَالاَ : یَرْضَخُونَ وَیَقُولُونَ قَوْلاً مَعْرُوفًا۔","","Musannaf Ibn Abi Shaybah 31537","","","كتاب الوصايا"
"31538","(۳۱۵۳۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ رَجُلٌ یَقْسِمُ مِیرَاثًا ، فَقَالَ لِصَاحِبِہِ : أَلاَ تَجِیئُ نُحْیِی آیَۃً مِنْ کِتَابِ اللہِ قَدْ أُمِیتَتْ ، فَقَسَمَ بَیْنَہُمْ مِنْ نَصِیبِہِ۔","","Musannaf Ibn Abi Shaybah 31538","","","كتاب الوصايا"
"31539","(۳۱۵۳۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عنَْسُفْیَانُ بْنُ حُسَیْنٍ، عَنِ الْحَسَنِ وَابْنِ سِیرِینَ: فِی قَوْلِہِ: {وَإِذَا حَضَرَ الْقِسْمَۃَ أُولُوا الْقُرْبَی وَالْیَتَامَی} ، قَالاَ : ہِیَ مُثبتۃٌ ، فَإِذَا حَضَرَتْ وَحَضَرَ ہَؤُلاَئِ الْقَوْمِ أُعْطُوا مِنْہَا وَرُضِخَ لَہُمْ۔","","Musannaf Ibn Abi Shaybah 31539","","","كتاب الوصايا"
"31540","(۳۱۵۴۰) حَدَّثَنَا عَبْدُالأَعْلَی، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ: فِی قَوْلِہِ: {وَإِذَا حَضَرَ الْقِسْمَۃَ أُولُوا الْقُرْبَی} إنَّہَا مُحْکَمَۃٌ۔","","Musannaf Ibn Abi Shaybah 31540","","","كتاب الوصايا"
"31541","(۳۱۵۴۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، قَالَ : سَمِعْتُ یُونُسَ بْنَ جُبَیْر یُحَدِّثُ عَنْ حِطَّانَ ، عَنْ أَبِی مُوسَی: فِی ہَذِہِ الآیَۃِ : {إِذَا حَضَرَ الْقِسْمَۃَ أُولُوا الْقُرْبَی وَالْیَتَامَی وَالْمَسَاکِینُ فَارْزُقُوہُمْ مِنْہُ وَقُولُوا لَہُمْ قَوْلاً مَعْرُوفًا} قَالَ : قَضَی بِہَا أَبُو مُوسَی۔","Sahih","Musannaf Ibn Abi Shaybah 31541","","","كتاب الوصايا"
"31542","(۳۱۵۴۲) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ : أَنَّ عُرْوَۃَ قَسَمَ مِیرَاثَ أَخِیہِ مُصْعَبٍ ، فَأَعْطَی مَنْ حَضَرَہُ مِنْ ہَؤُلاَئِ وَبَنُوہُ صِغَارٌ۔","","Musannaf Ibn Abi Shaybah 31542","","","كتاب الوصايا"
"31543","(۳۱۵۴۳) حَدَّثَنَا عَبْدُ الصَّمَدِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی بَکْرِ بْنِ أَبِی مُوسَی وَعَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرٍ : أَنَّہُمَا کَانَا یُعْطِیَانِ مَنْ حَضَرَ مِنْ ہَؤُلاَئِ۔","","Musannaf Ibn Abi Shaybah 31543","","","كتاب الوصايا"
"31544","(۳۱۵۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ السُّدِّیِّ ، عَنْ أَبِی سَعِیدٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ : {وَإِذَا حَضَرَ الْقِسْمَۃَ أُولُوا الْقُرْبَی وَالْیَتَامَی وَالْمَسَاکِینُ فَارْزُقُوہُمْ مِنْہُ}، قَالَ : إنْ کَانُوا کِبَارًا رُضِخُوا ، وَإِنْ کَانُوا صِغَارًا اعْتُذِرَ إلَیْہِمْ ، فَذَلِکَ قَوْلہ {قَوْلاً مَعْرُوفًا}۔","","Musannaf Ibn Abi Shaybah 31544","","","كتاب الوصايا"
"31545","(۳۱۵۴۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : وَلِیَ أَبِی مِیرَاثًا فَأَمَرَ بِشَاۃٍ فَذُبِحَتْ فَصُنِعَتْ ، فَلَمَّا قَسَمَ ذَلِکَ الْمِیرَاثَ أَطْعَمَہُمْ ، وَقَالَ : لِمَنْ لَمْ یَرِثْ مَعْرُوفًا۔","","Musannaf Ibn Abi Shaybah 31545","","","كتاب الوصايا"
"31546","(۳۱۵۴۶) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنِ السُّدِّیِّ ، عَنْ أَبِی مَالِکٍ : نَسَخَتْہَا آیَۃُ الْمِیرَاثِ۔","","Musannaf Ibn Abi Shaybah 31546","","","كتاب الوصايا"
"31547","(۳۱۵۴۷) حَدَّثَنَا ابْنُ یَمَانٍ، عَنْ سُفْیَانَ، عَنِ الشَّیْبَانِیِّ، عَنْ عِکْرِمَۃَ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: مُحْکَمَۃٌ لَیْسَتْ بِمَنْسُوخَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31547","","","كتاب الوصايا"
"31548","(۳۱۵۴۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یَقُولُ فِی الْمَسْجِدِ مَرَّۃً : سَمِعْت حَدِیثًا مَا بَقِیَ أَحَدٌ سَمِعَہُ غَیْرِی، سَمِعْت عَمْرَو بْنَ شُرَحْبِیلَ یَقُولُ: قَالَ عَبْدُ اللہِ: إنَّکُمْ مَعْشَرَ الْیَمَنِ مِنْ أَجْدَرِ قَوْمٍ أَنْ یَمُوتَ الرَّجُلُ، وَلاَ یَدْعُ عُصْبَۃً فَلْیَضَعْ مَالَہُ حَیْثُ شَائَ، قَالَ الأَعْمَشُ: فَقُلْتُ لإِبْرَاہِیمَ: إنَّ الشَّعْبِیَّ، قَالَ کَذَا وَکَذَا، قَالَ إبْرَاہِیمُ: حَدَّثَنِی ہَمَّامُ بْنُ الْحَارِثِ، عَنْ عَمْرِو بْنِ شُرَحْبِیلَ، عَنْ عَبْدِاللہِ مِثْلَہُ۔n(سعید بن منصور ۲۱۷)","Sahih","Musannaf Ibn Abi Shaybah 31548","","","كتاب الوصايا"
"31549","(۳۱۵۴۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : سَأَلْتُ عَبِیدَۃَ عَنْ رَجُلٍ لَیْسَ عَلَیْہِ عَقْدٌ وَلَیْسَ عَلَیْہِ عُصْبَۃٌ ، یُوصِی بِمَالِہِ کُلِّہِ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 31549","","","كتاب الوصايا"
"31550","(۳۱۵۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ؛ سُئِلَ عَنْ رَجُلٍ مَاتَ وَلَمْ یَتْرُکْ مَوْلًی عَتَاقَۃٍ ، وَلاَ وَارِثًا ؟ قَالَ : مَالُہُ حیْثُ وَضَعَہُ ، فَإِنْ لَمْ یَکُنْ أَوْصَی بِشَیْئٍ فَمَالُہُ فِی بَیْتِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 31550","","","كتاب الوصايا"
"31551","(۳۱۵۵۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : فِی رَجُلٍ وَالَی رَجُلاً فَأَسْلَمَ عَلَی یَدَیْہِ ، قَالَ : إنْ شَائَ أَوْصَی بِمَالِہِ کُلِّہِ۔","","Musannaf Ibn Abi Shaybah 31551","","","كتاب الوصايا"
"31552","(۳۱۵۵۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ : أَنَّ أَبَا الْعَالِیَۃِ أَوْصَی بِمِیرَاثِہِ لِبَنِی ہَاشِمٍ۔","","Musannaf Ibn Abi Shaybah 31552","","","كتاب الوصايا"
"31553","(۳۱۵۵۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ : أَنَّ عَبْدَ اللہِ بْنَ مَسْعُودٍ وَعُثْمَانَ وَالْمِقْدَادَ بْنَ الأَسْوَدِ، وَعَبْدَ الرَّحْمَن بْنَ عَوْفٍ وَمُطِیعَ بْنَ الأَسْوَدِ أَوْصَوا إلَی الزُّبَیْرِ بْنِ الْعَوَّامِ ، قَالَ : وَأَوْصَی إلَی عَبْدِ اللہِ بْنِ الزُّبَیْرِ۔","","Musannaf Ibn Abi Shaybah 31553","","","كتاب الوصايا"
"31554","(۳۱۵۵۴) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : کَانَ وَصّی لِرَجُلٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31554","","","كتاب الوصايا"
"31555","(۳۱۵[corrupt]۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : أَوْصَی إلَیَّ ابْن عَمٍّ لِی ، قَالَ : فَکَرِہْت ذَلِکَ ، فَسَأَلْت عَمْرًا ؟ فَأَمَرَنِی أَنْ أَقْبَلَہَا ، قَالَ : وَکَانَ ابْنُ سِیرِینَ یَقْبَلُ الْوَصِیَّۃَ۔","","Musannaf Ibn Abi Shaybah 31555","","","كتاب الوصايا"
"31556","(۳۱۵۵۶) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ إسْمَاعِیلَ، عَنْ قَیْسٍ، قَالَ: کَانَ أَبُو عُبَیْد عَبَرَ الْفُرَاتِ فَأَوْصَی إلَی عُمَرَ بْنِ الْخَطَّابِ۔","Sahih","Musannaf Ibn Abi Shaybah 31556","","","كتاب الوصايا"
"31557","(۳۱۵۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ أَبِی الْہَیْثُمَّ ، قَالَ : بَعَثَ إلَیَّ إبْرَاہِیمُ فَأَوْصَی إلَیَّ۔","","Musannaf Ibn Abi Shaybah 31557","","","كتاب الوصايا"
"31558","(۳۱۵۵۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عَامِرِ بْنِ سَعْدٍ ، عَنْ أَبِیہِ : أَنَّہُ قَالَ : مَرِضَ مَرَضًا أَشْفَی مِنْہُ ، فَأَتَاہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَعُودُہُ ، فَقَالَ : یَا رَسُولَ اللہِ ، إنَّ لِی مَالاً کَثِیرًا وَلَیْسَ یَرِثُنِی إِلاَّ ابْنَۃٌ لِی ، أَفَأَتَصَدَّقُ بِالثُّلُثَیْنِ ؟ قَالَ : لاَ ، قَالَ : فَالشَّطْرَ ؟ قَالَ : لاَ ، قُلْتُ : فَالثُّلُثُ ؟ قَالَ : الثُّلُثُ کَثِیرٌ۔n(بخاری ۶۷۳۳۔ مسلم ۱۲۵۲)","Sahih","Musannaf Ibn Abi Shaybah 31558","","","كتاب الوصايا"
"31559","(۳۱۵۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : وَدِدْت أَنَّ النَّاسَ غَضُّوا مِنَ الثُّلُثِ إلَی الرُّبُعِ ، لأَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الثُّلُثُ کَثِیرٌ۔ (بخاری ۲۷۴۳۔ مسلم ۱۲۵۳)","Sahih","Musannaf Ibn Abi Shaybah 31559","","","كتاب الوصايا"
"31560","(۳۱۵۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، أَنَّ الزُّبَیْرَ أَوْصَی بِثُلُثِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31560","","","كتاب الوصايا"
"31561","(۳۱۵۶۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : ذُکِرَ عِنْدَ عُمَرَ الثُّلُثُ فِی الْوَصِیَّۃِ ، قَالَ : الثُّلُثُ وَسَطٌ لاَ بَخْسٌ ، وَلاَ شَطَطٌ۔","Sahih","Musannaf Ibn Abi Shaybah 31561","","","كتاب الوصايا"
"31562","(۳۱۵۶۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ : أَنَّ مُعَاذَ بْنَ جَبَلٍ قَالَ : إنَّ اللَّہَ تَصَدَّقَ عَلَیْکُمْ بِثُلُثِ أَمْوَالِکُمْ زِیَادَۃً فِی حَیَاتِکُمْ۔ یَعْنِی : الْوَصِیَّۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 31562","","","كتاب الوصايا"
"31563","(۳۱۵۶۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ خَالِدِ بْنِ أَبِی عَزَّۃَ ، قَالَ : قَالَ أَبُو بَکْرٍ : آخُذُ مِنْ مَالِی مَا أَخَذَ اللَّہُ مِنَ الْفَیْئِ فَأَوْصَی بِالْخُمُسِ۔","Da'if","Musannaf Ibn Abi Shaybah 31563","","","كتاب الوصايا"
"31564","(۳۱۵۶۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : أَوْصَی أَبُو بَکْرٍ وَعَلِیٌّ بِالْخُمُسِ۔","Da'if","Musannaf Ibn Abi Shaybah 31564","","","كتاب الوصايا"
"31565","(۳۱۵۶۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ : أَنَّ حُمَیْدَ بْنَ عَبْدِ الرَّحْمَنِ ، قَالَ : مَا کُنْت لأَقْبَلَ وَصِیَّۃَ رَجُلٍ یُوصِی بِالثُّلُثِ وَلَہُ وَلَدٌ۔","","Musannaf Ibn Abi Shaybah 31565","","","كتاب الوصايا"
"31566","(۳۱۵۶۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، عَنْ شُرَیْحٍ ، قَالَ : الثُّلُثُ جَیِّدٌّ وَہُوَ جَائِزٌ۔","Sahih","Musannaf Ibn Abi Shaybah 31566","","","كتاب الوصايا"
"31567","(۳۱۵۶۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ بَشِیرِ بْنِ عُقْبَۃَ ، عَنْ یَزِیدَ بْنِ الشِّخِّیرِ ، قَالَ : کَانَ مُطَرِّفٌ یَرَی الْخُمُسَ فِی الْوَصِیَّۃِ حَسَنًا۔","","Musannaf Ibn Abi Shaybah 31567","","","كتاب الوصايا"
"31568","(۳۱۵۶۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَقُولُونَ الَّذِی یُوصِی بِالْخُمُسِ أَفْضَلُ مِنَ الَّذِی یُوصِی بِالرُّبُعِ ، وَالَّذِی یُوصِی بِالرُّبُعِ أَفْضَلُ مِنَ الَّذِی یُوصِی بِالثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31568","","","كتاب الوصايا"
"31569","(۳۱۵۶۹) حَدَّثَنَا یَعْلَی وَابْنُ نُمَیْرٍ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إنَّمَا کَانُوا یُوصُونَ بِالْخُمُسِ وَالرُّبُعِ ، وَالثُّلُثُ مُنْتَہَی الْجَامِحِ ، وَقَالَ ابْنُ نُمَیْرٍ : مُنْتَہَی الْجِمَاحِ۔","","Musannaf Ibn Abi Shaybah 31569","","","كتاب الوصايا"
"31570","(۳۱۵۷۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : لأَنْ أُوصِیَ بِالْخُمُسِ أَحَبُّ إلَیَّ مِنْ أَنْ أُوصِیَ بِالرُّبُعِ ، وَلأَنْ أُوصِیَ بِالرُّبُعِ أَحَبُّ إلَیَّ مِنْ أَنْ أُوصِیَ بِالثُّلُثِ ، وَمَنْ أَوْصَی لَمْ یَتْرُکْ۔","Da'if","Musannaf Ibn Abi Shaybah 31570","","","كتاب الوصايا"
"31571","(۳۱۵۷۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا مَنْدَل ، عَنِ الأَعْمَشِ ، عَنْ طَلْحَۃَ ، عَنْ أَبِی عَمَّارٍ ، عَنْ عَمْرِو بْنِ شُرَحْبِیلَ ، قَالَ : الثُّلُثُ حَیْفٌ وَالرُّبُعُ حَیْفٌ۔","","Musannaf Ibn Abi Shaybah 31571","","","كتاب الوصايا"
"31572","(۳۱۵۷۲) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا مَنْدَل ، عَنِ الأَعْمَشِ ، عَنْ مَالِکِ بْنِ الْحَارِثِ ، عَنِ الْعَبَّاسِ ، قَالَ : الرُّبُعُ حَیْفٌ وَالثُّلُثُ حَیْفٌ۔","","Musannaf Ibn Abi Shaybah 31572","","","كتاب الوصايا"
"31573","(۳۱۵۷۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، قَالَ : قَالَ إبْرَاہِیمُ : کَانَ یُقَالَ : السُّدُسُ خَیْرٌ مِنَ الثُّلُثِ فِی الْوَصِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 31573","","","كتاب الوصايا"
"31574","(۳۱۵۷۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : کَانُوا یَسْتَحِبُّونَ أَنْ یَتْرُکُوا مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31574","","","كتاب الوصايا"
"31575","(۳۱۵۷۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ قُثَم مَوْلَی ابْنِ عَبَّاسٍ ، قَالَ : قَالَ عَلِیٌّ : وَصِیَّتِی إلَی أَکْبَرِ وَلَدِی غَیْرَ طَاعن عَلَیْہِ فِی بَطْنٍ وَلاَ فِی فَرْجٍ۔","Hasan","Musannaf Ibn Abi Shaybah 31575","","","كتاب الوصايا"
"31576","(۳۱۵۷۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَا حَقُّ امْرِئٍ مُسْلِمٍ یَبِیتُ لَیْلَتَیْنِ وَلَہُ شَیْئٌ یُوصِی بِہِ ، إلاَّ وَوَصِیَّتُہُ مَکْتُوبَۃٌ عِنْدَہُ۔n(مسلم ۱۲۴۹۔ ابوداؤد ۲۸۵۴)","Sahih","Musannaf Ibn Abi Shaybah 31576","","","كتاب الوصايا"
"31577","(۳۱۵۷۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنْ عَامِرٍ ، قَالَ : مَنْ أَوْصَی بِوَصِیَّۃٍ لَمْ یَحِفْ فِیہَا وَلَمْ یُضَارَّ أَحَدًا أَنْ یَکُونَ لَہُ مِنَ الأَجْرِ مَا لَوْ تَصَدَّقَ بِہِ فِی حَیَاتِہِ فِی صِحَّتِہِ۔","","Musannaf Ibn Abi Shaybah 31577","","","كتاب الوصايا"
"31578","(۳۱۵۷۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ دَاوُدَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الضِّرَارُ فِی الْوَصِیَّۃِ مِنَ الْکَبَائِرِ ، ثُمَّ تَلاَ {غَیْرَ مُضَارٍّ وَصِیَّۃً مِنَ اللہِ}۔","Da'if","Musannaf Ibn Abi Shaybah 31578","","","كتاب الوصايا"
"31579","(۳۱۵۷۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبٍ ، قَالَ : ذَہَبْت أَنَا وَالْحُکْمُ إلَی سَعِیدِ بْنِ جُبَیْرٍ فَسَأَلْتُہُ عَنْ قولہ : {وَلْیَخْشَ الَّذِینَ لَوْ تَرَکُوا مِنْ خَلْفِہِمْ ذُرِّیَّۃً ضِعَافًا خَافُوا عَلَیْہِمْ} إلَی قَوْلہ {سَدِیدًا} قَالَ : ہُوَ الَّذِی یَحْضُرُہُ الْمَوْتُ فَیَقُولُ لَہُ مَنْ یَحْضُرُہُ : اتَّقِ اللَّہَ وَأَعْطِہِمْ صِلْہُمْ بَرَّہُمْ وَلَوْ کَانُوا ہُمَ الَّذِینَ یَأْمُرُونَہُ بِالْوَصِیَّۃِ لأَحَبُّوا أَنْ یُنْفِقُوا لأَوْلاَدِہِمْ۔n فَأَتَیْنَا مِقْسَمًا فَسَأَلَنَاہ ؟ فَقَالَ : مَا قَالَ سَعِیدٌ ؟ فَقُلْنَا : کَذَا وَکَذَا ، قَالَ : لاَ ، وَلَکِنَّہُ الرَّجُلُ یَحْضُرُہُ الْمَوْتُ فَیُقَالُ لَہُ : اتَّقِ اللَّہَ وَأَمْسِکْ عَلَیْک مَالِکَ فَإِنَّہُ لَیْسَ أَحَدٌ أَحَقَّ بِمَالِکَ مِنْ وَلَدِکَ وَلَوْ کَانَ الَّذِی یُوصِی ذَا قَرَابَۃٍ لاَحَبُّوا أَنْ یُوصِیَ لَہُمْ۔","","Musannaf Ibn Abi Shaybah 31579","","","كتاب الوصايا"
"31580","(۳۱۵۸۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ دَاوُدَ بْنَ أَبِی ہِنْدٍ ، عَنِ الْقَاسِمِ بْنِ عَمْروٍ ، قَالَ : اشْتَکَی أَبِی فَلَقِیت ثُمَامَۃَ بْنَ حَزَنٍ الْقُشَیْرِیَّ ، فَقَالَ لِی : أَوْصَی أَبُوک ؟ قُلْتُ : لاَ ، قَالَ : إنِ اسْتَطَعْت أَنْ یُوصِیَ فَلْیُوصِ ، فَإِنَّہَا تَمَامٌ لِمَا انْتَقَصَ مِنْ زَکَاتِہِ۔ (طبرانی ۶۹)","","Musannaf Ibn Abi Shaybah 31580","","","كتاب الوصايا"
"31581","(۳۱۵۸۱) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الضِّرَارُ فِی الْوَصِیَّۃِ مِنَ الْکَبَائِرِ ، ثُمَّ قَرَأَ: {وَمَنْ یَعْصِ اللَّہَ وَرَسُولَہُ وَیَتَعَدَّ حُدُودَہُ یُدْخِلْہُ نَارًا خَالِدًا فِیہَا}۔","Hasan","Musannaf Ibn Abi Shaybah 31581","","","كتاب الوصايا"
"31582","(۳۱۵۸۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی إبْرَاہِیمُ بْنُ مَیْسَرَۃَ ، أَنَّہُ سَمِعَ طَاوُوسًا یَقُولُ : مَا مِنْ مُسْلِمٍ یُوقِنُ بِالْوَصِیَّۃِ یَمُوتُ لَمْ یُوصِ إلاَّ أَہْلُہُ مَحْقُوقُونَ أَنْ یُوصُوا عَنْہُ۔","","Musannaf Ibn Abi Shaybah 31582","","","كتاب الوصايا"
"31583","(۳۱۵۸۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، قَالَ : حَدَّثَنَا أَبُو حَمْزَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إِنَّمَا کَانُوا یَکْرَہُونَ أَنْ یَمُوتَ الرَّجُلُ قَبْلَ أَنْ یُوصِیَ قَبْلَ أَنْ تُنَزَّلَ الْمَوَارِیثُ۔","","Musannaf Ibn Abi Shaybah 31583","","","كتاب الوصايا"
"31584","(۳۱۵۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ طَلْحَۃَ ، قَالَ : قُلْتُ لاِبْنِ أَبِی أَوْفَی : أَوْصَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : لاَ ، قُلْتُ : فَکَیْفَ أَمَرَ النَّاسَ بِالْوَصِیَّۃِ ؟ قَالَ : أَوْصَی بِکِتَابِ اللہِ۔n(بخاری ۲۷۴۰۔ مسلم ۱۲۵۶)","Sahih","Musannaf Ibn Abi Shaybah 31584","","","كتاب الوصايا"
"31585","(۳۱۵۸۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ وَابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیق ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : مَا تَرَکَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دِینَارًا ، وَلاَ دِرْہَمًا ، وَلاَ أَوْصَی بِشَیْئٍ۔ (مسلم ۱۲۵۶۔ ابن ماجہ ۲۶۹۵)","Sahih","Musannaf Ibn Abi Shaybah 31585","","","كتاب الوصايا"
"31586","(۳۱۵۸۶) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَرَقْمَ بْنِ شُرَحْبِیلَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَاتَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَلَمْ یُوصِ۔ (احمد ۳۴۳۔ ابویعلی ۲۵۵۳)","","Musannaf Ibn Abi Shaybah 31586","","","كتاب الوصايا"
"31587","(۳۱۵۸۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : ذَکَرُوا عِنْدَ عَائِشَۃَ أَنَّ عَلِیًّا کَانَ وَصِیًّا ، فَقَالَتْ : مَتَی أَوْصَی إلَیْہِ ؟ فَلَقَدْ کُنْت مُسْنِدَتَہُ إلَی حِجْرِی ، فَانْخَنَثَ فَمَاتَ ، فَمَتَی أَوْصَی إلَیْہِ؟!۔n(بخاری ۲۷۴۱۔ احمد ۳۲)","Sahih","Musannaf Ibn Abi Shaybah 31587","","","كتاب الوصايا"
"31588","(۳۱۵۸۸) حَدَّثَنَا ابْنِ جُرَیْجٍ، عَنْ لَیْثٍ، عَنْ طَاوُوسٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: إِذَا تَرَکَ الْمَیِّت سَبْعمِئۃ دِرْہَم فَلا یُوصِی۔n(سعید بن منصور ۲۵۰)","Da'if","Musannaf Ibn Abi Shaybah 31588","","","كتاب الوصايا"
"31589","(۳۱۵۸۹) حَدَّثَنَا زَیْدُ بْنُ حَبَّابٍ ، عَنْ ہَمَّامٍ ، عَنْ قَتَادَۃَ {إنْ تَرَکَ خَیْرًا الْوَصِیَّۃُ} قَالَ : خَیْرُ الْمَالِ ، کَانَ یُقَالَ : أَلْفُ دِرْہَمٍ فَصَاعِدًا۔","","Musannaf Ibn Abi Shaybah 31589","","","كتاب الوصايا"
"31590","(۳۱۵۹۰) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ : أَنَّ عَلِیًّا دَخَلَ عَلَی رَجُلٍ مِنْ بَنِی ہَاشِمٍ یَعُودُہُ ، فَأَرَادَ أَنْ یُوصِیَ فَنَہَاہُ ، وَقَالَ : إنَّ اللَّہَ یَقُولُ : {إنْ تَرَکَ خَیْرًا} وَإِنَّک لَمْ تَدَعْ مَالا ، فَدَعْہُ لِعِیَالِک۔","Hasan","Musannaf Ibn Abi Shaybah 31590","","","كتاب الوصايا"
"31591","(۳۱۵۹۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ مُحَمَّدِ بْنِ شَرِیکٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ عَائِشَۃَ ، قَالَ : قَالَ لَہَا رَجُلٌ : إنِّی أُرِیدُ أَنْ أُوصِیَ ، قَالَتْ : کَمْ مَالُک ؟ قَالَ : ثَلاَثَۃُ آلاَفٍ ، قَالَتْ : فَکَمْ عِیَالُک ؟ قَالَ : أَرْبَعَۃٌ ، قَالَتْ : فَإِنَّ اللَّہَ یَقُولُ : {إنْ تَرَکَ خَیْرًا} وَإِنَّہُ شَیْئٌ یَسِیرٌ ، فَدَعْہُ لِعِیَالِکَ فَإِنَّہُ أَفْضَلُ۔","Sahih","Musannaf Ibn Abi Shaybah 31591","","","كتاب الوصايا"
"31592","(۳۱۵۹۲) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ حَبِیبٍ، عَنْ إبْرَاہِیمَ: فِی قَوْلِہِ {وَصِیَّۃً لأَزْوَاجِہِمْ} قَالَ: ہِیَ مَنْسُوخَۃٌ۔","","Musannaf Ibn Abi Shaybah 31592","","","كتاب الوصايا"
"31593","(۳۱۵۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْجَہْضَمِ ، عَنْ عَبْدِ اللہِ بْنِ بَدْرٍ ، عَنِ ابْنِ عُمَرَ {إنْ تَرَکَ خَیْرًا الْوَصِیَّۃُ} ، قَالَ : نَسَخَتْہَا آیَۃُ الْمِیرَاثُ۔","Sahih","Musannaf Ibn Abi Shaybah 31593","","","كتاب الوصايا"
"31594","(۳۱۵۹۴) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ قَالَ: نَسَخَتْہَا آیَۃُ الْفَرَائِضِ، وَتَرَکَ الأَقْرَبُونَ مِمَّنْ لاَ یَرِثُ۔","","Musannaf Ibn Abi Shaybah 31594","","","كتاب الوصايا"
"31595","(۳۱۵۹۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : الْوَصِیَّۃُ لَیْسَتْ بِمَضْمُونَۃٍ ، إنَّمَا ہِیَ بِمَنْزِلَۃِ الدَّیْنِ فِی مَالِ الرَّجُلِ۔","","Musannaf Ibn Abi Shaybah 31595","","","كتاب الوصايا"
"31596","(۳۱۵۹۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ طَاوُوسٍ : أَنَّہُ کَانَ یَرَی الْوَصِیَّۃَ مَضْمُونَۃً۔","","Musannaf Ibn Abi Shaybah 31596","","","كتاب الوصايا"
"31597","(۳۱۵۹۷) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالَ : إذَا أَوْصَی رَجُلٌ إلَی رَجُلٍ غَائِبٍ ، ثُمَّ قَدِمَ فَأَقَرَّ بِالْوَصِیَّۃِ ، ثُمَّ أَنْکَرَ فَلَیْسَ لَہُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 31597","","","كتاب الوصايا"
"31598","(۳۱۵۹۸) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، أَنَّہُ قَرَأَ عَلَی فُضَیْلِ بْنِ مَیْسَرَۃَ ، عَنْ أَبِی حَرِیزٍ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ ، عَنْ عُمَرَ ، قَالَ : إذَا الْتَقَی الزَّحْفَانِ وَالْمَرْأَۃُ یَضْرِبُہَا الْمَخَاضُ لاَ یَجُوزُ لَہُمَا فِی مَالِہِمَا إلاَّ الثُّلُثُ۔","Da'if","Musannaf Ibn Abi Shaybah 31598","","","كتاب الوصايا"
"31599","(۳۱۵۹۹) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ : فِی الرَّجُلِ یُعْطِی فِی الْمُزَاحَفَۃِ وَرُکُوبِ الْبَحْرِ وَالطَّاعُونِ وَالْحَامِلِ ، قَالَ : مَا أَعْطَوا فَہُوَ جَائِزٌ ، لاَ یَکُن مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31599","","","كتاب الوصايا"
"31600","(۳۱۶۰۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : مَا صَنَعَت الْحَامِلُ فِی شَہْرِہَا فَہُوَ مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31600","","","كتاب الوصايا"
"31601","(۳۱۶۰۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ : فِی الرَّجُلِ یَکُونُ بِہِ السِّلُّ وَالْحُمَّی وَہُوَ یَجِیئُ وَیَذْہَبُ ، قَالَ : مَا صَنَعَ مِنْ شَیْئٍ فَہُوَ مِنْ جَمِیعِ الْمَالِ ، إلاَّ أَنْ یَکُونَ أُضْنِی عَلَی فِرَاشِہِ۔","","Musannaf Ibn Abi Shaybah 31601","","","كتاب الوصايا"
"31602","(۳۱۶۰۲) حَدَّثَنَا عُمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : مَا صَنَعَتِ الْحَامِلُ فَہُوَ وَصِیَّۃٌ۔","","Musannaf Ibn Abi Shaybah 31602","","","كتاب الوصايا"
"31603","(۳۱۶۰۳) حَدَّثَنَا وَکِیعٌ قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنِِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : الْحَامِلُ وَصِیَّۃٌ۔","","Musannaf Ibn Abi Shaybah 31603","","","كتاب الوصايا"
"31604","(۳۱۶۰۴) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ شُرَیْحٍ ، قَالَ : الْحَامِلُ وَصِیَّۃٌ۔","","Musannaf Ibn Abi Shaybah 31604","","","كتاب الوصايا"
"31605","(۳۱۶۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ أَعْطَتِ امْرَأَتِی عَطیَّۃ وَہِیَ حَامِلٌ ، فَقَالَتْ لِلْقَاسِمِ بْنِ مُحَمَّدٍ ، فَقَالَ : ہُوَ مِنْ جَمِیعِ الْمَالِ۔n قَالَ حَمَّادٌ : قَالَ یَحْیَی : وَنَحْنُ نَقُولُ : ہُوَ مِنْ جَمِیعِ الْمَالِ مَا لَمْ یَضْرِبْہَا الطَّلْقُ۔","","Musannaf Ibn Abi Shaybah 31605","","","كتاب الوصايا"
"31606","(۳۱۶۰۶) حَدَّثَنَا وَکِیعٌ حَدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : الْحَامِلُ وَصِیَّۃٌ۔","","Musannaf Ibn Abi Shaybah 31606","","","كتاب الوصايا"
"31607","(۳۱۶۰۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُحَمَّدٍ ، قَالَ : حُبِسَ إیَاسُ بْنُ مُعَاوِیَۃَ فِی الظِّنَّۃِ ، فَأَرْسَلِنِی ، فَقَالَ : انْطَلِقْ إلَی الْحَسَنِ فَاسْأَلْہُ مَا حَالِی فِیمَا أخذتُ مِنْ مَالِی عَلَی حَالِی ہَذِہِ ؟ قَالَ : فَأَتَیْت الْحَسَنَ فَقُلْتُ لَہُ : إنَّ أَخَاک إیَاسًا یُقْرِئُک السَّلاَمَ وَیَقُولُ : مَالِی فِیمَا أحدِثُ فِی یَوْمِی ہَذَا ؟ فَقَالَ الْحَسَنُ : حَالُہُ حَالُ الْمَرِیضِ ، لاَ یَجُوزُ لَہُ إلاَّ الثُّلُثُ۔","","Musannaf Ibn Abi Shaybah 31607","","","كتاب الوصايا"
"31608","(۳۱۶۰۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ سِمَاکٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا وَضَعَ رِجْلَہُ فِی الْغَرْزِ فَمَا أَوْصَی بِہِ فَہُوَ مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31608","","","كتاب الوصايا"
"31609","(۳۱۶۰۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، قَالَ : إذَا وَضَعَ رِجْلَہُ فِی الْغَرْزِ فَمَا تَکَلَّمَ بِہِ مِنْ شَیْئٍ فَہُوَ مِنْ ثُلُثِہِ۔","","Musannaf Ibn Abi Shaybah 31609","","","كتاب الوصايا"
"31610","(۳۱۶۱۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ سِمَاکٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، أَنَّہُ قَالَ : إذَا وَضَعَ الرَّجُلُ رِجْلَہُ فِی الْغَرْزِ یَقُولُ : إذَا سَافَرَ فَمَا أَوْصَی بِہِ فَہُوَ مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31610","","","كتاب الوصايا"
"31611","(۳۱۶۱۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ : فِی الأَسِیرِ فِی أَیْدِی الْعَدُوِّ : إنْ أَعْطَی عَطِیَّۃً ، أَوْ نَحَلَ نَحْلاً ، أَوْ أَوْصَی بِثُلُثِہِ فَہُوَ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 31611","","","كتاب الوصايا"
"31612","(۳۱۶۱۲) حَدَّثَنَا مَعْن بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ یَجُوزُ لِلأَسِیرِ فِی مَالِہِ إلاَّ الثُّلُثُ۔","","Musannaf Ibn Abi Shaybah 31612","","","كتاب الوصايا"
"31613","(۳۱۶۱۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : بَیْعُ الْوَصِیِّ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 31613","","","كتاب الوصايا"
"31614","(۳۱۶۱۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ شَرِیکٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : الْوَصِیُّ بِمَنْزِلَۃِ الأَبِ۔","","Musannaf Ibn Abi Shaybah 31614","","","كتاب الوصايا"
"31615","(۳۱۶۱۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ یَحْیَی بْنِ حَمْزَۃَ ، عَنْ أَبِی وَہْبٍ ، قَالَ : أمْرُ الْوَصِیِّ جَائِزٌ إلاَّ فِی الرِّبَاعِ ، وَإِنْ بَاعَ بَیْعًا لَمْ یُقَلْ۔","","Musannaf Ibn Abi Shaybah 31615","","","كتاب الوصايا"
"31616","(۳۱۶۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ الْحَسَنِ ، قَالَ : یَنْظُرُ والِی الْیَتِیمِ مِثْلُ مَا یُرَی لِلْیَتِیمِ یَعْمَل لِلْیَتِیمِ بِہِ۔","","Musannaf Ibn Abi Shaybah 31616","","","كتاب الوصايا"
"31617","(۳۱۶۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : الْوَصِیُّ بِمَنْزِلَۃِ الْوَالِدِ۔","","Musannaf Ibn Abi Shaybah 31617","","","كتاب الوصايا"
"31618","(۳۱۶۱۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ : أَنَّ شُرَیْحًا کَانَ یُجِیزُ شَہَادَۃَ الأَوْصِیَائِ۔","","Musannaf Ibn Abi Shaybah 31618","","","كتاب الوصايا"
"31619","(۳۱۶۱۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، مِثْلُہُ۔","","Musannaf Ibn Abi Shaybah 31619","","","كتاب الوصايا"
"31620","(۳۱۶۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ تَجُوزُ ، ہُوَ خَصْمٌ۔","","Musannaf Ibn Abi Shaybah 31620","","","كتاب الوصايا"
"31621","(۳۱۶۲۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ : أَنَّ عُمَرَ أَوْصَی لأُمَّہَاتِ أَوْلاَدِہِ بِأَرْبَعَۃِ آلاَفٍ ، أَرْبَعَۃِ آلاَفٍ۔","Hasan","Musannaf Ibn Abi Shaybah 31621","","","كتاب الوصايا"
"31622","(۳۱۶۲۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَنِ الْحَسَنِ : أَنَّ عِمْرَانَ بْنَ حُصَیْنٍ أَوْصَی لأُمَّہَاتِ أَوْلاَدِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31622","","","كتاب الوصايا"
"31623","(۳۱۶۲۳) حَدَّثَنَا خَالِدُ بْنُ حَیَّانَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : قُلْتُ لِمَیْمُونِ بْنِ مِہْرَانَ : الرَّجُلُ یُوصِی لأُمِّ وَلَدِہِ ؟ قَالَ : ہُوَ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 31623","","","كتاب الوصايا"
"31624","(۳۱۶۲۴) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : أَوْصَی الشَّعْبِیُّ لأُمِّ وَلَدِہِ۔","","Musannaf Ibn Abi Shaybah 31624","","","كتاب الوصايا"
"31625","(۳۱۶۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ : فِی الرَّجُلِ یَہَبُ لأُمِّ وَلَدِہِ ، قَالَ : ہُوَ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 31625","","","كتاب الوصايا"
"31626","(۳۱۶۲۶) حَدَّثَنَا مُعْتَمِرٌ، قَالَ: قُلْتُ لِیُونُسَ: رَجُلٌ وَہَبَ لأُمِّ وَلَدٍ شَیْئًا ثُمَّ مَاتَ؟ قَالَ: کَانَ الْحَسَنُ یَقُولُ: ہُوَ لَہَا۔","","Musannaf Ibn Abi Shaybah 31626","","","كتاب الوصايا"
"31627","(۳۱۶۲۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَحْرَزَتْ أُمُّ الْوَلَدِ شَیْئًا فِی حَیَاۃِ سَیِّدِہَا فَمَاتَ سَیِّدُہَا فَہُوَ لَہَا وَقَدْ عَتَقَتْ ، فَإِنِ انْتَزَعَ الْمَیِّتُ شَیْئًا قَبْلَ أَنْ یَمُوتَ ، أَوْ أَوْصَی بِشَیْئٍ مِمَّا کَانَتْ أَحْرَزَتْ فِی حَیَاتِہِ : یَصْنَعُ فِیہِ مَا شَائَ۔","","Musannaf Ibn Abi Shaybah 31627","","","كتاب الوصايا"
"31628","(۳۱۶۲۸) حَدَّثَنَا جَرِیرٌ ، عَنْ عَبْدِ الْکَرِیمِ بْنِ رُفَیْعٍ ، قَالَ : تُوُفِّیَ رَجُلٌ بِالرَّیِّ وَتَرَکَ مَالاً وَرَقِیقًا ، فَقَالَ : عَبْدِی فُلاَنٌ لِفُلاَنٍ وَعَبْدِی فُلاَنٌ لِفُلاَنٍ ، وَلَمْ تَبْلُغْ وَصِیَّتُہُ الثُّلُثَ ، فَلَمَّا أَقْبَلَ بِالرَّقِیقِ إلَی الْکُوفَۃِ مَاتَ بَعْضُ رَقِیقِ الْوَرَثَۃِ ، وَلَمْ یَمُتْ رَقِیقُ الَّذِی أَوْصَی لَہُمْ ، فَسَأَلْت إبْرَاہِیمَ ؟ فَقَالَ : یُعْطَی أَصْحَابَ الْوَصِیَّۃِ عَلَی مَا أَوْصَی بِہِ صَاحِبُہُ۔","","Musannaf Ibn Abi Shaybah 31628","","","كتاب الوصايا"
"31629","(۳۱۶۲۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ: فِی رَجُلٍ جَعَلَ وَصِیَّتَہُ إلَی مُکَاتَبِہِ ، فَقَالَ : الْمُکَاتَبُ : إنِّی قَدْ أَنْفَقْت مُکَاتَبَتِی عَلَی عِیَالِ مَوْلاَیَ ، فَقَالَ : یُصَدَّقُ ، وَیَجُوزُ ذَلِکَ ، وَلاَ بَأْسَ أَنْ یُوصِیَ إلَی عَبْدِہِ ، فَإِنْ قَالَ الْعَبْدُ : إنِّی قَدْ کَاتَبْت نَفْسِی ، أَوْ بِعْت نَفْسِی ، لَمْ یَجُزْ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 31629","","","كتاب الوصايا"
"31630","(۳۱۶۳۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : سُئِلَ عَنْ رَجُلٍ أَوْصَی لِبَنِی ہَاشِمٍ ، أَیَدْخُلُ مَوَالِیہِمْ مَعَہُمْ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 31630","","","كتاب الوصايا"
"31631","(۳۱۶۳۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ : أَنَّ سَعْدَ بْنَ عُبَادَۃَ قَسَمَ مَالَہُ بَیْنَ وَرَثَتِہِ عَلَی کِتَابِ اللہِ ، وَامْرَأَۃٌ لَہُ قَدْ وَضَعَتْ رَجُلاً ، فَأَرْسَلِ أَبُو بَکْرٍ وَعُمَرُ إلَی قَیْسِ بْنِ سَعْدٍ أَنْ أَخْرِجْ لِہَذَا الْغُلاَمِ حَقَّہُ ، قَالَ : قَالَ أَمَّا شَیْئٌ صَنَعَہُ سَعْدٌ فَلاَ أَرْجِعُ فِیہِ ، وَلَکِنْ نَصِیبِی لَہُ ، فَقِبَلاَ ذَلِکَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 31631","","","كتاب الوصايا"
"31632","(۳۱۶۳۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَیَانٍ ، عَنْ وَبَرَۃَ ، قَالَ : اشْتَرَی رَجُلٌ أُخْتًا لَہُ کَانَتْ سُبِیَّت فِی الْجَاہِلِیَّۃِ فَاشْتَرَاہَا وَابْنًا لَہَا لاَ یُدْرَی مَنْ أَبُوہُ ، فَشَبَّ فَأَصَابَ مَالاً ، ثُمَّ مَاتَ فَأَتَوْا عُمَرَ فَقَصُّوا عَلَیْہِ الْقِصَّۃَ ، فَقَالَ : خُذُوا مِیرَاثَہُ فَاجْعَلُوہُ فِی بَیْتِ الْمَالِ ، مَا أُرَاہُ تَرَکَ وَلِیَّ نِعْمَۃٍ ، وَلاَ أَرَی لَک فَرِیضَۃً ، فَبَلَغَ ذَلِکَ ابْنَ مَسْعُودٍ ، فَقَالَ : مَہْ ، حَتَّی أَلْقَاہُ ، فَلَقِیَہُ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ عَصَبَۃٌ وَوَلِیُّ نِعْمَۃٍ ، قَالَ : کَذَا ؟ قَالَ : نَعَمْ، فَأَعْطَاہُ الْمَالَ۔","Sahih","Musannaf Ibn Abi Shaybah 31632","","","كتاب الوصايا"
"31633","(۳۱۶۳۳) حَدَّثَنَا یَحْیَی بْنُ عِیسَی ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : جَائَ رَجُلٌ إلَی عُمَرَ ، فَقَالَ لَہُ : کَانَتْ لِی أُخْتٌ بَغِیٌّ فَتُوُفِّیَتْ وَتَرَکَتْ غُلاَمًا فَمَاتَ وَتَرَکَ ذَوْدًا مِنَ الإِبِلِ ، فَقَالَ عُمَرُ : مَا أَرَی بَیْنَکَ وَبَیْنَہُ نَسَبًا ، ائْتِ بِہَا فَاجْعَلْہَا فِی إبِلِ الصَّدَقَۃِ ، قَالَ : فَأَتَی ابْنَ مَسْعُودٍ فَذَکَرَ ذَلِکَ لَہُ ، فَقَامَ عَبْدُ اللہِ فَأَتَی عُمَرَ ، فَقَالَ : مَا تَقُولُ یَا أَمِیرَ الْمُؤْمِنِینَ ؟ فَقَالَ : مَا أَرَی بَیْنَہُ وَبَیْنَہُ نَسَبًا ، فَقَالَ : أَلَیْسَ ہُوَ خَالُہُ وَوَلِیُّ نِعْمَتِہِ ؟ فَقَالَ : مَا تَرَی ؟ قَالَ : أَرَی أَنَّہُ أَحَقُّ بِمَالِہِ ، فَرَدَّہَا عَلَیْہِ عُمَرُ۔","Sahih","Musannaf Ibn Abi Shaybah 31633","","","كتاب الوصايا"
"31634","(۳۱۶۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی عَوَانَۃَ ، قَالَ : سُئِلَ حَمَّادٌ عَنْ رَجُلٍ أَوْصَی فِی الْفُقَرَائِ بِدَرَاہِمَ ؟ قَالَ : لَمْ یَرَ بَأْسًا أَنْ یُفَضِّلَ بَعْضَہُمْ عَلَی بَعْضٍ بِقَدْرِ الْحَاجَۃِ۔","","Musannaf Ibn Abi Shaybah 31634","","","كتاب الوصايا"
"31635","(۳۱۶۳۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : أَحَقٌّ تَسْوِیَۃُ النِّحَلِ بَیْنَ الْوَلَدِ عَلَی کِتَابِ اللہِ ؟ قَالَ : نَعَمْ ، وَقَدْ بَلَغَنَا ذَلِکَ عَنْ نَبِیِّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُ قَالَ : سَوَّیْت بَیْنَ وَلَدِکَ ؟ قُلْتُ : فِی النُّعْمَانِ ؟ قَالَ : وَغَیْرِہِ ، زَعَمُوا۔","","Musannaf Ibn Abi Shaybah 31635","","","كتاب الوصايا"
"31636","(۳۱۶۳۶) حَدَّثَنَا عَبَّادٌ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَمِعْتُ النُّعْمَانَ بْنَ بَشِیرٍ یَقُولُ : أَعْطَانِی أَبِی عَطِیَّۃً ، فَقَالَتْ أُمِّی عَمْرَۃُ ابْنَۃُ رَوَاحَۃَ : فَلاَ أَرْضَی حَتَّی تُشْہِدَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَتَی رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، إنِّی أَعْطَیْت ابْنَ عَمْرَۃَ عَطِیَّۃً فَأَمَرَتْنِی أَنْ أُشْہِدَک ، فَقَالَ : أَعْطَیْت کُلَّ وَلَدِکَ مِثْلَ ہَذَا ؟ قَالَ : لاَ ، قَالَ : فَاتَّقُوا اللَّہَ وَاعْدِلُوا بَیْنَ أَوْلاَدِکُمْ ، قَالَ : فَرَجَعَ فَرَدَّ عَطِیَّتَہُ۔n(بخاری ۲۵۸۷۔ مسلم ۱۲۴۲)","Sahih","Musannaf Ibn Abi Shaybah 31636","","","كتاب الوصايا"
"31637","(۳۱۶۳۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، وَعَنْ مُحَمَّدِ بْنِ النُّعْمَانِ ، عَنْ أَبِیہِ : أَنْ أَبَاہُ نَحَلَہُ غُلاَمًا وَأَنَّہُ أَتَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِیُشْہِدَہُ ، فَقَالَ : أَکُلَّ وَلَدِکَ أَعْطَیْتہ مِثْلَ ہَذَا ، قَالَ : لاَ قَالَ : فَارْدُدْہُ۔ (مسلم ۱۲۴۲۔ ترمذی ۱۳۶۷)","Sahih","Musannaf Ibn Abi Shaybah 31637","","","كتاب الوصايا"
"31638","(۳۱۶۳۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ أَبِی حَیَّانَ ، عَنِ الشَّعْبِیِّ ، عَنِ النُّعْمَانِ بْنِ بَشِیرٍ ، قَالَ : انْطَلَقَ بِی أَبِی إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِیُشْہِدَہُ عَلَی عَطِیَّۃٍ أَعْطَانِیہَا ، قَالَ : لَک غَیْرُہُ ، قَالَ : نَعَمْ ، قَالَ : کُلَّہُم أَعْطَیْتَہُمْ مِثْلَ أُعْطِیَّتِہِ ؟ قَالَ : لاَ ، قَالَ : فَلاَ أَشْہَدُ عَلَی جَوْرٍ۔ (بخاری ۲۶۵۰۔ احمد ۲۶۸)","Sahih","Musannaf Ibn Abi Shaybah 31638","","","كتاب الوصايا"
"31639","(۳۱۶۳۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، قَالَ : کَانَ طَاوس إذَا سُئِلَ عَنْہُ ، قَرَأَ : {أَفَحُکْمَ الْجَاہِلِیَّۃِ یَبْغُونَ}۔","","Musannaf Ibn Abi Shaybah 31639","","","كتاب الوصايا"
"31640","(۳۱۶۴۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ، قَالَ: قَالَ عُرْوَۃٌ: یُرَدُّ مِنْ حَیْفِ الْحَیِّ مَا یُرَدُّ مِنْ حَیْفِ الْمَیِّتِ۔","","Musannaf Ibn Abi Shaybah 31640","","","كتاب الوصايا"
"31641","(۳۱۶۴۱) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ مِسْمَعِ بْنِ ثَابِتٍ ، عَنْ عِکْرِمَۃَ : أَنَّہُ کَانَ یَکْرَہُہُ۔","","Musannaf Ibn Abi Shaybah 31641","","","كتاب الوصايا"
"31642","(۳۱۶۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ أَنْ یَعْدِلَ الرَّجُلُ بَیْنَ وَلَدِہِ حَتَّی فِی الْقُبَلِ۔","","Musannaf Ibn Abi Shaybah 31642","","","كتاب الوصايا"
"31643","(۳۱۶۴۳) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ : أَنَّہُ کَرِہَ أَنْ یُفَضِّلَ الرَّجُلُ بَعْضَ وَلَدِہِ عَلَی بَعْضٍ وَکَانَ یُجِیزُہُ فِی الْقَضَائِ۔","","Musannaf Ibn Abi Shaybah 31643","","","كتاب الوصايا"
"31644","(۳۱۶۴۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا مُجَالِدٌ ، عَنْ عَامِرٍ ، عَنْ شُرَیْحٍ ، أَنَّہُ قَالَ : لاَ بَأْسَ أَنْ یُفَضِّلَ الرَّجُلُ بَعْضَ وَلَدِہِ عَلَی بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 31644","","","كتاب الوصايا"
"31645","(۳۱۶۴۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ أَبِی حَیَّانَ ، قَالَ : حدَّثَنِی أَبِی ، قَالَ : حَضَرَ جَارٌ لِشُرَیْحٍ وَلَہُ بَنُونَ ، فَقَسَمَ مَالَہُ بَیْنَہُمْ لاَ یَأْلُو أَنْ یَعْدِلَ ، ثُمَّ دَعَا شُرَیْحًا فَجَائَ ، فَقَالَ : أَبَا أُمَیَّۃَ إنِّی قَسَمْت مَالِی بَیْنَ وَلَدِی وَلَمْ آلُ ، وَقَدْ أَشْہَدْتُک ، فَقَالَ شُرَیْحٌ : قِسْمَۃُ اللہِ أَعْدَلُ مِنْ قِسْمَتِکَ ، فَارْدُدْہُمْ إلَی سِہَامِ اللہِ وَفَرَائِضِہِ وَأَشْہِدْنِی وَإِلاَّ فَلاَ تُشْہِدْنِی ، فَإِنِّی لاَ أَشْہَدُ عَلَی جَوْرٍ۔","","Musannaf Ibn Abi Shaybah 31645","","","كتاب الوصايا"
"31646","(۳۱۶۴۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَن[corrupt] مَسْرُوقٍ : أَنَّہُ حَضَرَ رَجُلاً یُوصِی فَأَوْصَی بِأَشْیَائَ لاَ تََنْبَغِی ، فَقَالَ مَسْرُوقٌ : إنَّ اللَّہَ قَدْ قَسَمَ بَیْنَکُمْ فَأَحْسَنَ ، وَإِنَّہُ مَنْ یَرْغَبْ بِرَأْیِہِ عَنْ رَأْیِ اللہِ یَضِل ، أَوْصِ لِذَوِی قَرَابَتِکَ مِمَّنْ لاَ یَرْغَب ، ثُمَّ دَع الْمَالَ عَلَی مَنْ قَسَمَہُ اللَّہُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 31646","","","كتاب الوصايا"
"31647","(۳۱۶۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنِ الْقَاسِمِ وَالشَّعْبِیِّ : فِی رَجُلٍ کَانَ بِہِ جُذَامٌ ، فَقَالَ : أَخِی شَرِیکِی فِی مَالِی ، فَقَالَ : إنْ شَہِدَتِ الشُّہُودُ أَنَّہُ أَوْصَی بِہِ قَبْلَ أَنْ یُصِیبَہُ وَجَعَہُ شَرَّکَہُ۔","","Musannaf Ibn Abi Shaybah 31647","","","كتاب الوصايا"
"31648","(۳۱۶۴۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ وَالْحَسَنِ ، قَالَ : إذَا أَقَرَّ بَعْضُ الْوَرَثَۃِ بِدَیْنٍ عَلَی الْمَیِّتِ جَازَ عَلَیْہِ فِی نَصِیبِہِ۔","","Musannaf Ibn Abi Shaybah 31648","","","كتاب الوصايا"
"31649","(۳۱۶۴۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ : فِی وَارِثٍ أَقَرَّ بِدَیْنٍ ، قَالَ : عَلَیْہِ فِی نَصِیبِہِ بِحِصَّتِہِ ، قَالَ : ثُمَّ قَالَ بَعْدَ ذَلِکَ : یُخَرَّجُ مِنْ نَصِیبِہِ۔","","Musannaf Ibn Abi Shaybah 31649","","","كتاب الوصايا"
"31650","(۳۱۶۵۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : عَلَیْہِ فِی نَصِیبِہِ بِحِصَّتِہِ۔","","Musannaf Ibn Abi Shaybah 31650","","","كتاب الوصايا"
"31651","(۳۱۶۵۱) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ مُغِیرَۃَ ، عَنْ عَامِرٍ : فِی رَجُلٍ مَاتَ وَتَرَکَ ابْنَیْنِ ، وَتَرَکَ مِئَتَیْ دِینَارٍ ، فَأَقَرَّ أَحَدُ الاِبْنَیْنِ أَنَّ عَلَی أَبِیہِ خَمْسِینَ دِینَارًا ، قَالَ : یُؤْخَذُ مِنْ نَصِیبِ ہَذَا وَیَسْلََمُ لِلآخَرِ نَصِیبُہُ۔","","Musannaf Ibn Abi Shaybah 31651","","","كتاب الوصايا"
"31652","(۳۱۶۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا أَقَرَّ بَعْضُ الْوَرَثَۃِ بِدَیْنٍ عَلَی الْمَیِّتِ جَازَ عَلَیْہِ فِی نَصِیبِہِ۔","","Musannaf Ibn Abi Shaybah 31652","","","كتاب الوصايا"
"31653","(۳۱۶۵۳) حَدَّثَنَا حَفْصٌ، عَنْ أَشْعَثَ، عَنِ الشَّعْبِیِّ، قَالَ: إذَا شَہِدَ رَجُلاَنِ أَوْ ثَلاَثَۃٌ مِنَ الْوَرَثَۃِ فَإِنَّمَا أَقَرُّوا عَلَی أَنْفُسِہِمْ۔","","Musannaf Ibn Abi Shaybah 31653","","","كتاب الوصايا"
"31654","(۳۱۶۵۴) حَدَّثَنَا حَفْصٌ، عَنْ أَشْعَثَ، عَنِ الْحَکَمِ وَحَمَّادٌ، عَنْ إبْرَاہِیمَ، قَالَ: یَجُوزُ عَلَی الْوَرَثَۃِ بِحِسَابِ مَا وَرِثُوا۔","","Musannaf Ibn Abi Shaybah 31654","","","كتاب الوصايا"
"31655","(۳۱۶۵۵) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : ہُمَا شَاہِدَانِ مِنَ الْمُسْلِمِینَ ، تَجُوزُ شَہَادَتُہُمَا عَلَی الْوَرَثَۃِ کُلِّہِمْ۔","","Musannaf Ibn Abi Shaybah 31655","","","كتاب الوصايا"
"31656","(۳۱۶۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا شَہِدَ اثْنَانِ مِنَ الْوَرَثَۃِ جَازَ عَلَیْہِمَا فِی أَنْصِبَائِہِمَا ، وَقَالَ الْحَکَمُ : یَجُوزُ عَلَیْہِمْ جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 31656","","","كتاب الوصايا"
"31657","(۳۱۶۵۷) حَدَّثَنَا عَبْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ مَنْصُورٍ ، عَنِ الْحَارِثِ ، قَالَ : إذَا شَہِدَ اثْنَانِ مِنَ الْوَرَثَۃِ لِرَجُلٍ بِدَیْنٍ أُعْطِیَ دَیْنَہُ۔","","Musannaf Ibn Abi Shaybah 31657","","","كتاب الوصايا"
"31658","(۳۱۶۵۸) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا شَہِدَ أَحَدُ الْوَرَثَۃِ جَازَ عَلَیْہِمْ کُلِّہِمْ۔","","Musannaf Ibn Abi Shaybah 31658","","","كتاب الوصايا"
"31659","(۳۱۶۵۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ مَرْوَانَ ، عَنْ إبْرَاہِیمَ ، عَنِ ابْنِ سِیرِینَ : سُئِلَ عَنْ رَجُلٍ ، قَالَ : إنْ حَدَثَ بِی حَدَثٌ فَعَبْدِی حُرٌّ ، فَاحْتَاجَ إلَیْہِ ، أَلَہُ أَنْ یَبِیعَہُ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 31659","","","كتاب الوصايا"
"31660","(۳۱۶۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ : فِی رَجُلٍ قَالَ لِعَبْدِہِ : إنْ مِتّ فِی مَرَضِی ہَذَا فَأَنْتَ حُرٌّ ، قَالَ : لَیْسَ لَہُ أَنْ یَبِیعَہُ حَتَّی یَمُوتَ۔","","Musannaf Ibn Abi Shaybah 31660","","","كتاب الوصايا"
"31661","(۳۱۶۶۱) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ وَمُحَمَّدٍ: أَنَّہُمَا کَرِہَا أَنْ یَشْتَرِیَ الْوَصِیُّ مِنَ الْمِیرَاثِ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 31661","","","كتاب الوصايا"
"31662","(۳۱۶۶۲) حَدَّثَنَا عَبْدُ اللہِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ وَعَطَائٍ ، قَالاَ : لاَ یَجُوزُ لِوَالٍ أَنْ یَشْتَرِیَ مِمَّا وَلِیَ عَلَیْہِ۔n قَالَ : وَقَالَ مُجَاہِدٌ : لاَ تَشْتَرِ إحْدَی یَدَیْک مِنَ الأُخْرَی۔","","Musannaf Ibn Abi Shaybah 31662","","","كتاب الوصايا"
"31663","(۳۱۶۶۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ صِلَۃَ بْنِ زُفَرَ ، قَالَ : کَانَ عِنْدَ عَبْدِ اللہِ فَأَتَاہُ رَجُلٌ عَلَی فَرَسٍ أَبْلَقٍ ، فَقَالَ : تَأْمُرُنِی أَنْ أَشْتَرِیَ ہَذَا ؟ قَالَ : وَمَا شَأْنُہُ ؟ قَالَ : أَوْصَی إلَیَّ رَجُلٌ وَتَرَکَہُ فَأَقَمْتہ فِی السُّوقِ عَلَی ثَمَنٍ ، قَالَ : لاَ تَشْتَرِہِ ، وَلاَ تَسْتَسْلِفْ مِنْ مَالِہِ۔n قَالَ أَبُو إِسْحَاقَ : سَمِعْتہ مِنْ صِلَۃَ مُنْذُ سِتِّینَ سَنَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 31663","","","كتاب الوصايا"
"31664","(۳۱۶۶۴) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا سِنَانُ بْنُ ہَارُونَ الْبُرْجُمِیُّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ وَابْنِ سِیرِینَ، قَالاَ : فِی رَجُلٍ أَوْصَی لِعَبْدِہِ بِالثُّلُثِ ، قَالاَ : ذَلِکَ مِنْ رَقَبَتِہِ ، فَإِنْ کَانَ الثُّلُثُ أَکْثَرَ مِنْ ثَمَنِہِ عَتَقَ وَدَفَعَ إلَیْہِ مَا بَقِی ، وَإِنْ کَانَ أَقَلَّ مِنْ ثُمَّنِہِ عَتَقَ وَسَعَی لَہُمْ فِیمَا بَقِی ، وَإِنْ أَوْصَی لَہُمْ بِدَرَاہِمَ ، فَإِنْ شَائَ الْوَرَثَۃُ أَجَازُوا ، وَإِنْ شَاؤُوا لَمْ یُجِیزُوا۔","","Musannaf Ibn Abi Shaybah 31664","","","كتاب الوصايا"
"31665","(۳۱۶۶۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ أَبِی خَالِدٍ ، عَنْ حَکِیمِ بْنِ جَابِرٍ : أَنَّہُ قِیلَ لَہُ فِی الْوَصِیَّۃِ عِنْدَ الْمَوْتِ : لَوْ أَعْتَقْت غُلاَمَک ! فَقَرَأَ ہَذِہِ الآیَۃَ : {وَلْیَخْشَ الَّذِینَ لَوْ تَرَکُوا مِنْ خَلْفِہِمْ ذُرِّیَّۃً ضِعَافًا خَافُوا عَلَیْہِمْ}۔","","Musannaf Ibn Abi Shaybah 31665","","","كتاب الوصايا"
"31666","(۳۱۶۶۶) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ عَبْدِ الْعَزِیزِ ، عَنْ إسْمَاعِیلَ ، عَنْ حَکِیمِ بْنِ جَابِرٍ : أَنَّہُ لَمَّا حَضَرَہُ الْمَوْتُ وَکَانَ لَہُ غُلاَمٌ فَقِیلَ لَہُ : لَوْ أَعْتَقْت ہَذَا ؟ فَقَالَ : إنِّی لَمْ أَتْرُکْ لِوَلَدِی غَیْرَہُ ، قَالَ : فَأَعَادُوا عَلَیْہِ : لَوْ أَعْتَقَہُ ، فَقَرَأَ ہَذِہِ الآیَۃَ {وَلْیَخْشَ الَّذِینَ لَوْ تَرَکُوا مِنْ خَلْفِہِمْ ذُرِّیَّۃً ضِعَافًا خَافُوا عَلَیْہِمْ} إلَی قَوْلِہِ {سَدِیدًا}۔","","Musannaf Ibn Abi Shaybah 31666","","","كتاب الوصايا"
"31667","(۳۱۶۶۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ نُسَیْرٍ ، قَالَ : قَالَ رَجُلٌ لِلرَّبِیعِ بْنِ خُثَیْمٍ : أَوْصِ لِی بِمُصْحَفِکَ ، قَالَ : فَنَظَرَ إلَی ابْنٍ لَہُ صَغِیرٍ ، فَقَالَ : {وَأُولُوا الأَرْحَامِ بَعْضُہُمْ أَوْلَی بِبَعْضٍ فِی کِتَابِ اللہِ}۔","","Musannaf Ibn Abi Shaybah 31667","","","كتاب الوصايا"
"31668","(۳۱۶۶۸) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ عَاصِمٍ ، قَالَ : مَرِضَ أَبُو الْعَالِیَۃِ فَأَعْتَقَ مَمْلُوکًا ، ذَکَرَوا لَہُ أَنَّہ مِنْ وَرَائِ النَّہَرِ ، فَقَالَ : إنْ کَانَ حَیًّا فَلاَ أَعْتِقُہُ ، وَإِنْ کَانَ مَیِّتًا فَہُوَ عَتِیقٌ وَذَکَرَ ہَذِہِ الآیَۃَ {وَلَہُ ذُرِّیَّۃٌ ضُعَفَائُ}۔","","Musannaf Ibn Abi Shaybah 31668","","","كتاب الوصايا"
"31669","(۳۱۶۶۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنِ الأَشْجَعِیِّ سَمِعَ سُفْیَانَ یَقُولُ : فِی رَجُلٍ أَوْصَی بِثُلُثِہِ لِرَجُلَیْنِ فَیُوجَدُ أَحَدُہُمَا مَیِّتًا ، قَالَ : یَکُونُ لِلآخَرِ۔ یَعْنِی : الثُّلُثَ کُلَّہُ۔n قَالَ یَحْیَی : وَہُوَ الْقَوْلُ۔","","Musannaf Ibn Abi Shaybah 31669","","","كتاب الوصايا"
"31670","(۳۱۶۷۰) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ : فِی رَجُلٍ أَوْصَی لِعَقِبِ بَنِی فُلاَنٍ ، قَالَ : لَیْسَ الْمَرْأَۃُ مِنَ الْعَقِبِ۔","","Musannaf Ibn Abi Shaybah 31670","","","كتاب الوصايا"
"31671","(۳۱۶۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : عَقِبُ الرَّجُلِ : وَلَدُہُ ، وَوَلَدُ وَلَدِہِ مِنَ الذُّکُورِ۔","","Musannaf Ibn Abi Shaybah 31671","","","كتاب الوصايا"
"31672","(۳۱۶۷۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا وَضَّاحٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ : فِی رَجُلٍ تُوُفِّیَ وَتَرَکَ ثَلاَثَۃَ بَنِینَ ، وَقَالَ : ثُلُثُ مَالِی لأَصْغَرِ بَنِیَّ ، فَقَالَ : الأَکْبَرُ : أَنَا لاَ أُجِیزُ ، وَقَالَ الأَوْسَطُ : أَنَا أُجِیزُ ، فَقَالَ : اجْعَلْہَا عَلَی تِسْعَۃِ أَسْہُمٍ : یُرْفَعُ ثَلاَثَۃ ، فَلَہُ سَہْمُہُ وَسَہْمُ الَّذِی أَجَازَہُ۔n وَقَالَ حَمَّادٌ : یُرَدُّ عَلَیْہِمَ السَّہْمُ جَمِیعًا۔n وَقَالَ عَامِرٌ : الَّذِی رَدَّ إنَّمَا رَدَّ عَلَی نَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 31672","","","كتاب الوصايا"
"31673","(۳۱۶۷۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْفَزَارِیِّ ، عَنِ الأَوْزَاعِیِّ ، قَالَ : سُئِلَ الزُّہْرِیُّ عَنِ امْرَأَۃٍ أَوْصَتْ بِثُلُثِ مَالِہَا لِزَوْجِہَا فِی سَبِیلِ اللہِ ؟ قَالَ : لاَ یَجُوزُ إلاَّ أَنْ تَقُولَ : ہُوَ فِی سَبِیلِ اللہِ إلَی زَوْجِی ، یَضَعُہُ حَیْثُ شَاء ۔","","Musannaf Ibn Abi Shaybah 31673","","","كتاب الوصايا"
"31674","(۳۱۶۷۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، قَالَ : کُنْتُ عِنْدَ دَاوُد بْنِ أَبِی ہِنْدٍ ، فَجَائَ رَجُلاَنِ أَوْ أَکْثَرُ مِنْ آلِ أَنَسِ بْنِ مَالِکٍ بَیْنَہُمْ عُبَیْدُ اللہِ بْنُ أَبِی بَکْرٍ ، وَجَاؤُوا مَعَہُمْ بِکِتَابٍ فِی صَحِیفَۃٍ ذَکَرُوا أَنَّہَا وَصِیَّۃُ أَنَسِ بْنِ مَالِکَ ، فَفُتِحْت صَدْرُہَا : بِسْمِ اللہِ الرَّحْمَن الرَّحِیمِ ہَذَا ذِکْرُ مَا کَتَبَ أَنَسُ بْنُ مَالِکٍ فِی ہَذِہِ الصَّحِیفَۃِ مِنْ أَمْرِ وَصِیَّتِہِ ، إنِّی أُوصِی مَنْ تَرَکْت مِنْ أَہْلِی کُلّہُم بِتَقْوَی اللہِ وَشُکْرِہِ وَاسْتِمْسَاکٍ بِحَبْلِہِ ، وَإِیمَانٍ بِوَعْدِہِ ، وَأُوصِیہِمْ بِصَلاَحِ ذَاتِ بَیْنِہِم وَالتَّرَاحُمِ وَالْبِرِّ وَالتَّقْوَی ، ثُمَّ أَوْصَی إنْ تُوُفِّیَ أَنَّ ثُلُثَ مَالِہِ صَدَقَۃٌ إلاَّ أَنْ یُغَیِّرَ وَصِیَّتَہُ قَبْلَ أَنْ یَلْحَقَ بِاللہِ ، أَلْف فِی سَبِیلِ اللہِ إنْ کَانَ أَمْرُ الأُمَّۃِ یَوْمئِذٍ جَمِیعًا ، وَفِی الرِّقَابِ وَالأَقْرَبِینَ ، وَمَنْ سَمَّیْت لَہُ الْعِتْقَ مِنْ رَقِیقِی یَوْمَ دُبُر مِنِّی فَأَدْرَکَہُ الْعِتْقُ فَإِنَّہُ یُقِیمُہُ وَلِیُّ وَصِیَّتِی فِی الثُّلُثِ غَیْرَ حَرِجٍ ، وَلاَ مُنَازِعٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31674","","","كتاب الوصايا"
"31675","(۳۱۶۷۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنِ ابْنِ عَوْنٍ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ مِنْہُمْ مَنْ یُوَرِّثُ الصَّامِتَ وَمِنْہُمْ مَنْ لاَ یُوَرِّثُہُ۔","","Musannaf Ibn Abi Shaybah 31675","","","كتاب الوصايا"
"31676","(۳۱۶۷۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُوسَی ، قَالَ : قَالَ سُفْیَانُ : لاَ تَجُوزُ وَصِیَّۃٌ لأَہْلِ الْحَرْبِ۔","","Musannaf Ibn Abi Shaybah 31676","","","كتاب الوصايا"
"31677","(۳۱۶۷۷) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ سَعِیدِ بْنِ السَّائِبِ : أَنَّ رَجُلاً أَوْصَی أَنْ تُعْتَقَ عَنْہُ رَقَبَتَانِ بِثَمَنٍ ، وَسَمَّاہُ ، فَلَمْ یُوجَدْ بِذَلِکَ الثَمَنُ رَقَبَتَانِ ، فَسَأَلْت عَطَائً ، فَقَالَ : اشْتَرُوا رَقَبَۃً وَاحِدَۃً وَأَعْتِقُوہَا عَنْہُ۔","","Musannaf Ibn Abi Shaybah 31677","","","كتاب الوصايا"
"31678","(۳۱۶۷۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامُ بْنُ حَسَّانٍ ، قَالَ : کَانَ أَوَّلُ وَصِیَّۃِ مُحَمَّدِ بْنِ سِیرِینَ : ہَذَا مَا أَوْصَی بِہِ مُحَمَّدُ بْنُ أَبِی عَمْرَۃَ ، أَنَّہُ یَشْہَدُ أَنْ لاَ إلَہَ إلاَّ اللَّہُ ، وَأَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ، وَأَوْصَی بَنِیہِ وَأَہْلِہِ أَنِ {اتَّقُوا اللَّہَ وَأَصْلِحُوا ذَاتَ بَیْنِکُمْ وَأَطِیعُوا اللَّہَ وَرَسُولَہُ إنْ کُنْتُمْ مُؤْمِنِینَ} ، وَأُوصِیہِمْ بِمَا أَوْصَی بِہِ إبْرَاہِیمُ بَنِیہِ وَیَعْقُوبُ : {یَا بَنِیَّ إنَّ اللَّہَ اصْطَفَی لَکُمُ الدِّینَ فَلاَ تَمُوتُنَّ إلاَّ وَأَنْتُمْ مُسْلِمُونَ} وَزَعَمَ أَنَّہَا کَانَتْ أَوَّلَ وَصِیَّۃِ أَنَسِ بْنِ مَالِکٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31678","","","كتاب الوصايا"
"31679","حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ ، قَالَ : حَدَّثَنَا أَبُو بَکْرِ بْنُ أَبِی شَیْبَۃَ ، قَالَ :n(۳۱۶۷۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ تَعَلَّمَ الْقُرْآنَ فَلْیَتَعَلَّمِ الْفَرَائِضَ ، وَلاَ یَکُنْ کَرَجُلٍ لَقِیَہُ أَعْرَابِیٌّ فَقَالَ لَہُ : أَمُہَاجِرٌ أَنْتَ یَا عَبْدَ اللہِ ، فَیَقُولُ : نَعَمْ ، فَیَقُولُ : إنَّ بَعْضَ أَہْلِی مَاتَ وَتَرَکَ کَذَا وَکَذَا ، فَإِنْ ہُوَ عَلِمَہُ فَعِلْمٌ آتَاہُ اللَّہُ إِیَّاہُ ، وَإِنْ کَانَ لاَ یُحْسِنُ فَیَقُولُ : فَبِمَ تَفْضُلُونَا یَا مَعْشَرَ الْمُہَاجِرِینَ؟۔ (بیہقی ۲۰۹)","Sahih","Musannaf Ibn Abi Shaybah 31679","","","كتاب الفرائض"
"31680","(۳۱۶۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ، بِنَحْوِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31680","","","كتاب الفرائض"
"31681","(۳۱۶۸۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ وَوَکِیعٌ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ، قَالَ: قَالَ عُمَرُ: تَعَلَّمُوا الْفَرَائِضَ فَإِنَّہَا مِنْ دِینِکُمْ۔","","Musannaf Ibn Abi Shaybah 31681","","","كتاب الفرائض"
"31682","(۳۱۶۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ زِیَاد بْنِ أَبِی مُسْلِمٍ ، عَنْ صَالِحٍ أَبِی الْخَلِیلِ ، عَنْ أَبِی مُوسَی ، قَالَ : مَثَلُ الَّذِی یَقْرَأُ الْقُرْآنَ ، وَلاَ یُحْسِنُ الْفَرَائِضَ کَالْیَدَیْنِ بِلاَ رَأْسٍ۔","","Musannaf Ibn Abi Shaybah 31682","","","كتاب الفرائض"
"31683","(۳۱۶۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ قَیْسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ قَرَأَ سُورَۃَ النِّسَائِ ، فَعَلِمَ مَا یَحْجُبُ مِمَّا لاَ یَحْجُبُ عَلِمَ الْفَرَائِضَ۔","Da'if","Musannaf Ibn Abi Shaybah 31683","","","كتاب الفرائض"
"31684","(۳۱۶۸۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ : أَنَّہُ قِیلَ لَہُ : ہَلْ کَانَتْ عَائِشَۃُ تُحْسِنُ الْفَرَائِضَ ، فَقَالَ : إی وَالَّذِی نَفْسِی بِیَدِہِ ، لَقَدْ رَأَیْت مَشْیَخَۃَ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الأَکَابِرَ یَسْأَلُونَہَا ، عَنِ الْفَرَائِضِ ؟","Sahih","Musannaf Ibn Abi Shaybah 31684","","","كتاب الفرائض"
"31685","(۳۱۶۸۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : مَا رَأَیْت أَحَدًا أَعْلَمَ بِفَرِیضَۃٍ ، وَلاَ أَعْلَمَ بِفِقْہٍ وَلاَ بِشِعْرٍ : مِنْ عَائِشَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 31685","","","كتاب الفرائض"
"31686","(۳۱۶۸۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُوسَی بْنُ عُلَیِّ بْنِ رَبَاحٍ ، عَنْ أَبِیہِ : أَنَّ عُمَرَ خَطَبَ النَّاسَ بِالْجَابِیَۃِ فَحَمِدَ اللَّہَ وَأَثْنَی عَلَیْہِ ، ثُمَّ قَالَ : مَنْ أَحَبَّ أَنْ یَسْأَلَ عَنِ الْقُرْآنِ فَلِیَأْتِ أُبَیَّ بْنَ کَعْبٍ ، وَمَنْ أَحَبَّ أَنْ یَسْأَلَ عَنِ الْفَرَائِضِ فَلِیَأْتِ زَیْدَ بْنَ ثَابِتٍ۔","","Musannaf Ibn Abi Shaybah 31686","","","كتاب الفرائض"
"31687","(۳۱۶۸۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : قَالَ عَبْدُ اللہِ : تَعَلَّمُوا الْقُرْآنَ وَالْفَرَائِضَ ، فَإِنَّہُ یُوشِکُ أَنْ یَفْتَقِرَ الرَّجُلُ إلَی عِلْمٍ کَانَ یَعْلَمُہُ ، أَوْ یَبْقَی فِی قَوْمٍ لاَ یَعْلَمُونَ۔","","Musannaf Ibn Abi Shaybah 31687","","","كتاب الفرائض"
"31688","(۳۱۶۸۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الْعُقَیْلِیُّ ، عَنْ أَبِی سَلَمَۃَ الْحِمْصِیِّ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَبْطَلَ مِیرَاثًا فَرَضَہُ اللَّہُ فِی کِتَابِہِ أَبْطَلَ اللَّہُ مِیرَاثَہُ مِنَ الْجَنَّۃِ۔ (سعید بن منصور ۲۸۵)","","Musannaf Ibn Abi Shaybah 31688","","","كتاب الفرائض"
"31689","(۳۱۶۸۹) حَدَّثَنَا زَیْدُ بْنُ حَبَّابٍ ، قَالَ : أَخْبَرَنَا أَبُو سِنَانٍ ، قَالَ : حَدَّثَنِی أَبُو إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونً ، قَالَ: کَانُوا إذَا اخْتَلَفُوا فِی فَرِیضَۃٍ أَتَوْا عَائِشَۃَ فَأَخْبَرَتْہُمْ بِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 31689","","","كتاب الفرائض"
"31690","(۳۱۶۹۰) حَدَّثَنَا عِیسَی بْنُ یُونُسَ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ ، قَالَ: قُلْتُ لِعَلْقَمَۃَ: عَلِّمْنِی الْفَرَائِضَ، قَالَ: ائْتِ جِیرَانَک۔","","Musannaf Ibn Abi Shaybah 31690","","","كتاب الفرائض"
"31691","(۳۱۶۹۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ مُوَرِّقٍ ، قَالَ : قَالَ عُمَرُ : تَعَلَّمُوا اللَّحْنَ وَالْفَرَائِضَ وَالسُّنَّۃَ کَمَا تَعَلَّمُونَ الْقُرْآنَ۔","Sahih","Musannaf Ibn Abi Shaybah 31691","","","كتاب الفرائض"
"31692","(۳۱۶۹۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن مَعْبَدٍ الْجَہْنَیِّ ، عَنْ مُعَاوِیَۃَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ یُرِدَ اللَّہُ بِہِ خَیْرًا یُفَقِّہْہُ فِی الدِّینِ۔ (بخاری ۷۱۔ مسلم ۷۱۸)","Hasan","Musannaf Ibn Abi Shaybah 31692","","","كتاب الفرائض"
"31693","(۳۱۶۹۳) حَدَّثَنَا یَعْلَی ، عَنْ عُثْمَانَ بْنِ حَکِیمٍ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ الْقُرَظِیِّ ، قَالَ : سَمِعْتُ مُعَاوِیَۃَ ابْنَ أَبِی سُفْیَانَ یَخْطُبُ یَقُولُ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ عَلَی ہَذِہِ الأَعْوَادِ ، اللَّہُمَّ لاَ مَانِعَ لِمَا أَعْطَیْت ، وَلاَ مُعْطِیَ لِمَا مَنَعْت ، مَنْ یُرِدَ اللَّہُ بِہِ خَیْرًا یُفَقِّہْہُ فِی الدِّینِ۔ (احمد ۹۵۔ مالک ۹۰۰)","Sahih","Musannaf Ibn Abi Shaybah 31693","","","كتاب الفرائض"
"31694","(۳۱۶۹۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ تَمِیمِ بْنِ سَلَمَۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ یُرِدَ اللَّہُ بِہِ خَیْرًا یُفَقِّہْہُ فِی الدِّینِ۔","","Musannaf Ibn Abi Shaybah 31694","","","كتاب الفرائض"
"31695","(۳۱۶۹۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : إذَا أَرَادَ اللَّہُ بِعَبْدٍ خَیْرًا فَقَّہَہُ فِی الدِّینِ وَأَلْہَمَہُ رُشْدَہُ۔","","Musannaf Ibn Abi Shaybah 31695","","","كتاب الفرائض"
"31696","(۳۱۶۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ ، قَالَ : إذَا أَرَادَ اللَّہُ بِعَبْدٍ خَیْرًا ، فَقَّہَہُ فِی الدِّینِ ، وَزَہَّدَہُ فِی الدُّنْیَا ، وَبَصَّرَہُ عَیْبَہُ ، فَمَنْ أُوتِیَہُنَّ فَقَدْ أُوتِیَ خَیْرَ الدُّنْیَا وَالآخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 31696","","","كتاب الفرائض"
"31697","(۳۱۶۹۷) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الْمُہَلَّبِ : أَنَّ عُثْمَانَ سُئِلَ عَنْہَا ، فَقَالَ : لِلْمَرْأَۃِ الرُّبْعُ ، وَلِلأُمِّ ثُلُثُ مَا بَقِیَ ، وَسَائِرُ ذَلِکَ لِلأَبِ۔","Hasan","Musannaf Ibn Abi Shaybah 31697","","","كتاب الفرائض"
"31698","(۳۱۶۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : أَنَّ زَیْدَ بْنَ ثَابِتٍ سُئِلَ عَنِ امْرَأَۃٍ وَأَبَوَیْنِ ، فَأَعْطَی الْمَرْأَۃَ الرُّبْعَ ، وَالأُمَّ ثُلُثَ مَا بَقِیَ ، وَمَا بَقِیَ لِلأَبِ۔","Sahih","Musannaf Ibn Abi Shaybah 31698","","","كتاب الفرائض"
"31699","(۳۱۶۹۹) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ : فِی امْرَأَۃٍ وَأَبَوَیْنِ ، قَالَ : الرُّبْعُ ، وَثُلُثُ مَا بَقِیَ۔","Da'if","Musannaf Ibn Abi Shaybah 31699","","","كتاب الفرائض"
"31700","(۳۱۷۰۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : أُتِیَ عَبْدُ اللہِ فِی امْرَأَۃٍ وَأَبَوَیْنِ ، فَقَالَ : إنَّ عُمَرَ کَانَ إذَا سَلِکَ طَرِیقًا فَسَلِکْنَاہُ وَجَدْنَاہُ سَہْلا ، وَإنَّہُ أُتِیَ فِی امْرَأَۃٍ وَأَبَوَیْنِ فَجَعَلَہَا مِنْ أَرْبَعَۃٍ ، فَأَعْطَی الْمَرْأَۃَ الرُّبْعَ ، وَالأُمَّ ثُلُثَ مَا بَقِی ، وَأَعْطَی الأَبَ سَائِرَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 31700","","","كتاب الفرائض"
"31701","(۳۱۷۰۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَبْدِ اللہِ ، عَنْ عُمَرَ ، بِمِثْلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31701","","","كتاب الفرائض"
"31702","(۳۱۷۰۲) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ : فِی امْرَأَۃٍ وَأَبَوَیْنِ : لِلْمَرْأَۃِ الرُّبْعُ وَلِلأُمِّ ثُلُثُ مَا بَقِیَ ، وَمَا بَقِیَ فَلِلأَبِ۔","Da'if","Musannaf Ibn Abi Shaybah 31702","","","كتاب الفرائض"
"31703","(۳۱۷۰۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ، عَنْ عُمَرَ ، بِمِثْلِہِ ، إلاَّ أَنَّہُ قَالَ : أُتِیَ فِی امْرَأَۃٍ وَأَبَوَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 31703","","","كتاب الفرائض"
"31704","(۳۱۷۰۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ : أَنَّہُ قَالَ : کَانَ عُمَرُ إذَا سَلِکَ طَرِیقًا فَسَلِکْنَاہُ وَجَدْنَاہُ سَہْلا ، فَسُئِلَ عَنْ زَوْجَۃٍ وَأَبَوَیْنِ ، فَقَالَ : لِلزَّوْجَۃِ الرُّبْعُ ، وَلِلأُمِّ ثُلُثُ مَا بَقِیَ ، وَمَا بَقِیَ فَلِلأَبِ۔","Sahih","Musannaf Ibn Abi Shaybah 31704","","","كتاب الفرائض"
"31705","(۳۱۷۰۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : خَالَفَ ابْنُ عَبَّاسٍ أَہْلَ الصَّلاَۃِ فِی امْرَأَۃٍ وَأَبَوَیْنِ وَزَوْجٍ ، قَالَ : لِلأُمِّ الثُّلُثُ مِنْ جَمِیعِ الْمَالِ۔ (عبدالرزاق ۱۹۰۱۸۔ بیہقی ۲۲۸)","","Musannaf Ibn Abi Shaybah 31705","","","كتاب الفرائض"
"31706","(۳۱۷۰۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : مَا یَمْنَعُہُمْ أَنْ یَجْعَلُوہَا مِنَ اثْنَیْ عَشَرَ سَہْمًا ، فَیُعْطُونَ الْمَرْأَۃَ ثَلاَثَۃَ أَسْہُمٍ وَلِلأُمِّ أَرْبَعَۃَ أَسْہُمٍ وَلِلأَبِ خَمْسَۃَ أَسْہُمٍ۔","","Musannaf Ibn Abi Shaybah 31706","","","كتاب الفرائض"
"31707","(۳۱۷۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِیہِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، قَالَ : قَالَ عَبْدُ اللہِ : مَا کَانَ اللَّہُ لِیَرَانِی أُفَضِّلُ أُمًّا عَلَی أَبٍ۔","","Musannaf Ibn Abi Shaybah 31707","","","كتاب الفرائض"
"31708","(۳۱۷۰۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : قَالَ عَبْدُ اللہِ : إنَّ عُمَرَ کَانَ إذَا سَلِکَ طَرِیقًا فَسَلِکْنَاہُ وَجَدْنَاہُ سَہْلا ، وَأَنَّہُ أُتِیَ فِی امْرَأَۃٍ وَأَبَوَیْنِ ، فَجَعَلَ لِلْمَرْأَۃِ الرُّبْعُ ، وَلِلأُمِّ ثُلُثُ مَا بَقِیَ، وَمَا بَقِیَ لِلأَبِ۔","Sahih","Musannaf Ibn Abi Shaybah 31708","","","كتاب الفرائض"
"31709","(۳۱۷۰۹) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ شَیْخٍ ، عَنِ ابْنِ الْحَنَفِیَّۃِ : فِی امْرَأَۃٍ وَأَبَوَیْنِ : لِلْمَرْأَۃِ الرُّبْعُ ، وَلِلأُمِّ ثُلُثُ مَا بَقِیَ۔n قَالَ أَبُوبَکْرٍ: فَہَذِہِ مِنْ أَرْبَعَۃِ أَسْہُمٍ: لِلْمَرْأَۃِ سَہْمٌ وَہُوَ الرُّبْعُ، وَلِلأُمِّ ثُلُثُ مَا بَقِیَ وَہُوَ سَہْمٌ، وَلِلأَبِ سَہْمَانِ۔","","Musannaf Ibn Abi Shaybah 31709","","","كتاب الفرائض"
"31710","(۳۱۷۱۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَصْبَہَانِیِّ ، عَنْ عِکْرِمَۃَ ، قَالَ : بَعَثَنِی ابْنُ عَبَّاسٍ إلَی زَیْدِ بْنِ ثَابِتٍ أَسْأَلُہُ عَنْ زَوْجٍ وَأَبَوَیْنِ ، فَقَالَ زَیْدٌ : لِلزَّوْجِ النِّصْفُ ، وَلِلأُمِّ ثُلُثُ مَا بَقِیَ وَہُوَ السُّدُسُ ، فَأَرْسَلِ إلَیْہِ ابْنُ عَبَّاسٍ : أَفِی کِتَابِ اللہِ تَجِدُ ہَذَا ؟ قَالَ : أَکْرَہُ أَنْ أُفَضِّلَ أُمًّا علَی أَبٍ ، وَکَانَ ابْنُ عَبَّاسٍ یُعْطِی الأُمَّ الثُّلُثَ مِنْ جَمِیعِ الْمَالِ۔","Sahih","Musannaf Ibn Abi Shaybah 31710","","","كتاب الفرائض"
"31711","(۳۱۷۱۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ سُلَیْمَانَ ، قَالَ : کَانَ إبْرَاہِیمُ یَفْرِضُہَا کَمَا فَرَضَہَا زَیْدٌ۔","","Musannaf Ibn Abi Shaybah 31711","","","كتاب الفرائض"
"31712","(۳۱۷۱۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ شَیْخٍ ، عَنِ ابْن الْحَنَفِیَّۃِ: فِی زَوْجٍ وَأَبَوَیْنِ: لِلزَّوْجِ النِّصْفُ، وَلِلأُمِّ ثُلُثُ مَا بَقِی ، وَمَا بَقِیَ فَلِلأَبِ۔","","Musannaf Ibn Abi Shaybah 31712","","","كتاب الفرائض"
"31713","(۳۱۷۱۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا مِنْدَلٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلِیٍّ وَزَیْدِ بْنِ ثَابِتٍ : فِی امْرَأَۃٍ وَأَبَوَیْنِ وَزَوْجٍ وَأَبَوَیْنِ ، قَالَ : قَالَ : لِلأُمِّ ثُلُثُ مَا بَقِیَ۔","","Musannaf Ibn Abi Shaybah 31713","","","كتاب الفرائض"
"31714","(۳۱۷۱۴) حَدَّثَنَا عَبْدَۃُ ، عَنِ الأَعْمَشِ : أَنَّ ابْنَ عَبَّاسٍ أَرْسَلِ إلَی زَیْدٍ یَسْأَلُہُ عَنْ زَوْجٍ وَأَبَوَیْنِ ؟ فَقَالَ زَیْدٌ : لِلزَّوْجِ النِّصْفُ ، وَلِلأُمِّ ثُلُثُ مَا بَقِیَ ، فَقَالَ ابْنُ عَبَّاسٍ : تَجِدُ لَہَا فِی کِتَابِ اللہِ ثُلُثَ مَا بَقِیَ ؟ فَقَالَ زَیْدٌ : ہَذَا رَأْیِی وَاللَّہُ أَعْلَمُ۔n قَالَ أَبُو بَکْرٍ : ہَذِہِ سِتَّۃُ أَسْہُمٍ : لِلزَّوْجِ ثَلاَثَۃٌ ، وَلِلأُمِّ سَہْمٌ ، وَلِلأَبِ سَہْمَانِ۔","","Musannaf Ibn Abi Shaybah 31714","","","كتاب الفرائض"
"31715","(۳۱۷۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنِ الأَسْوَدِ بْنِ یَزِیدَ ، قَالَ : قضَی مُعَاذٌ بِالْیَمَنِ فِی ابْنَۃٍ وَأُخْتٍ لأَبٍ وَأَمٍّ : لِلأُخْتِ النِّصْفُ ، وَلِلاِبْنَۃِ النِّصْفُ۔","Sahih","Musannaf Ibn Abi Shaybah 31715","","","كتاب الفرائض"
"31716","(۳۱۷۱۶) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ مُعَاذٍ ، مِثْلَ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 31716","","","كتاب الفرائض"
"31717","(۳۱۷۱۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن وَبَرَۃَ بْنِ عَبْدِ الرَّحْمَن ، عَنِ الأَسْوَدِ بْنِ یَزِیدَ ، قَالَ : کَانَ ابْنُ الزُّبَیْرِ لاَ یُعْطِی الأُخْتَ مَعَ الاِبْنَۃِ شَیْئًا حَتَّی حَدَّثْتہ أَنَّ مُعَاذًا قَضَی بِالْیَمَنِ فِی ابْنَۃٍ وَأُخْتٍ لأَبٍ وَأَمٍّ : لِلاِبْنَۃِ النِّصْفُ وَلِلأُخْتِ النِّصْفُ ، فَقَالَ : أَنْتَ رَسُولِی إلَی ابْنِ عُتْبَۃَ فَمُرْہُ بِذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 31717","","","كتاب الفرائض"
"31718","(۳۱۷۱۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : حدَّثْت ابْنَ الزُّبَیْرِ بِقَوْلِ مُعَاذٍ ، فَقَالَ : أَنْتَ رَسُولِی إلَی ابْنِ عُتْبَۃَ فَمُرْہُ بِذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 31718","","","كتاب الفرائض"
"31719","(۳۱۷۱۹) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنِی یَحْیَی بْنُ أَیُّوبَ الْمِصْرِیُّ ، قَالَ : حَدَّثَنَا یَزِیدُ بْنُ أَبِی حَبِیبٍ ، عَنْ أَبِی سَلَمَۃَ : أَنَّ عُمَرَ جَعَلَ الْمَالَ بَیْنَ الاِبْنَۃِ وَالأُخْتِ نِصْفَیْنِ۔","","Musannaf Ibn Abi Shaybah 31719","","","كتاب الفرائض"
"31720","(۳۱۷۲۰) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی حَصِینٍ ، عَنْ عَبْدِ اللہِ بْنِ عُتْبَۃَ : فِی ابْنَۃٍ وَأُخْتٍ، قَالَ : النِّصْفُ ، وَالنِّصْفُ۔","","Musannaf Ibn Abi Shaybah 31720","","","كتاب الفرائض"
"31721","(۳۱۷۲۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، عَنِ الأَسْوَدِ ، قَالَ : کَانَ ابْنُ الزُّبَیْرِ قَدْ ہَمَّ أَنْ یَمْنَعَ الأَخَوَاتِ مَعَ الْبَنَاتِ الْمِیرَاثَ فَحَدَّثْتہ أَنَّ مُعَاذًا قَضَی بِہِ فِینَا : وَرَّثَ ابْنَۃً وَأُخْتًا۔","Sahih","Musannaf Ibn Abi Shaybah 31721","","","كتاب الفرائض"
"31722","(۳۱۷۲۲) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ جَابِرٍ، عَنْ عَامِرٍ، قَالَ: کَانَ عَلِیٌّ وَابْنُ مَسْعُودٍ وَمُعَاذٌ یَقُولُونَ فِی ابْنَۃٍ وَأُخْتٍ: النِّصْفُ وَالنِّصْفُ، وَہُوَ قَوْلُ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلاَّ ابْنَ الزُّبَیْرِ، وَابْنَ عَبَّاسٍ۔","Da'if","Musannaf Ibn Abi Shaybah 31722","","","كتاب الفرائض"
"31723","(۳۱۷۲۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، قَالَ : کُنْتُ جَالِسًا عِنْدَ عَبْدِ اللہِ بْنِ عُتْبَۃَ وَقَدْ أَمَرَنِی أَنْ أُصْلِحَ بَیْنَ الاِبْنَۃِ وَالأُخْتِ فِی الْمِیرَاثِ ، وَقَدْ کَانَ ابْنُ الزُّبَیْرِ أَمَرَہُ أَنْ لاَ یُوَرِّثَ الأُخْتَ مَعَ الاِبْنَۃِ شَیْئًا ، فَإِنِّی لأُصْلِحُ بَیْنَہُمَا عِنْدَہُ إذَا جَائَ الأَسْوَدُ بْنُ یَزِیدَ ، فَقَالَ : إنِّی شَہِدْت مُعَاذًا بِالْیَمَنِ قَسَمَ الْمَالَ بَیْنَ الاِبْنَۃِ وَالأُخْتِ ، وَإِنِّی أَتَیْتُ ابْنَ الزُّبَیْرِ فَأَعْلَمْتہ ذَلِکَ ، فَأَمَرَنِی أَنْ آتِیَک فَأُعْلِمَک ذَلِکَ لِتَقْضِیَ بِہِ وَتَکْتُبَ بِہِ إلَیْہِ ، فَقَالَ : یَا أَسْوَدُ ، إنَّک عِنْدَنَا لَمُصَدَّقٌ فَأْتِہِ فَأَعْلِمْہُ ذَلِکَ فَلِیَقْضِ بِہِ۔n قَالَ أَبُو بَکْرٍ : وَہَذِہِ مِنْ سَہْمَیْنِ : لِلاِبْنَۃِ سَہْمٌ وَلِلأُخْتِ سَہْمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 31723","","","كتاب الفرائض"
"31724","(۳۱۷۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی قَیْسٍ ، عَنْ ہُزَیْلِ بْنِ شُرَحْبِیلَ ، قَالَ : جَائَ رَجُلٌ إلَی أَبِی مُوسَی وَسَلْمَانَ بْنِ رَبِیعَۃَ فَسَأَلَہُمَا عَنِ ابْنَۃٍ ، وَابْنَۃِ ابْنٍ ، وَأُخْتٍ لأَبٍ وَأُمٍ ؟ فَقَالاَ : لِلاِبْنَۃِ النِّصْفُ ، وَمَا بَقِیَ لِلأُخْتِ ، وَائْتِ ابْنَ مَسْعُودٍ فَسَلْہُ ، فَإِنَّہُ سَیُتَابِعنَا ، قَالَ : فَأَتَی الرَّجُلُ ابْنَ مَسْعُودٍ فَسَأَلَہُ وَأَخْبَرَہُ بِمَا قَالاَ ، فَقَالَ : لَقَدْ ضَلَلْت إذًا وَمَا أَنَا مِنَ الْمُہْتَدِینَ ، وَلَکِنْ سَأَقْضِی بِمَا قَضَی بِہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لِلاِبْنَۃِ النِّصْفُ ، وَلاِبْنَۃِ الاِبْنِ السُّدُسُ تَکْمِلَۃُ الثُّلُثَیْنِ ، وَمَا بَقِیَ فَلِلأُخْتِ۔","Sahih","Musannaf Ibn Abi Shaybah 31724","","","كتاب الفرائض"
"31725","(۳۱۷۲۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی قَیْسٍ ، عَنْ ہُزَیْلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی ابْنَۃٍ ، وَابْنَۃِ ابْنٍ ، وَأُخْتٍ : أَعْطَی الْبِنْتِ النِّصْفَ ، وَابْنَۃَ الاِبْنِ السُّدُسَ تَکْمِلَۃَ الثُّلُثَیْنِ ، وَالأُخْتَ مَا بَقِیَ۔n قَالَ أَبُو بَکْرٍ : وَہَذِہِ مِنْ سِتَّۃِ أَسْہُمٍ : لِلاِبْنَۃِ ثَلاَثَۃُ أَسْہُمٍ ، وَلاِبْنَۃِ الاِبْنِ سَہْمٌ ، وَلِلأُخْتِ سَہْمَانِ۔","","Musannaf Ibn Abi Shaybah 31725","","","كتاب الفرائض"
"31726","(۳۱۷۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَعْبَدِ بْنِ خَالِدٍ ، عَنْ مَسْرُوقٍ ، عَنِ ابْنِ مَسْعُودٍ : أَنَّہُ کَانَ یَجْعَلُ لِلأَخَوَاتِ وَالْبَنَاتِ الثُّلُثَیْنِ ، وَیَجْعَلُ مَا بَقِیَ لِلذُّکُورِ دُونَ الإِنَاثِ ، وَأَنَّ عَائِشَۃَ شَرَّکَتْ بَیْنَہُمْ ، فَجَعَلَتْ مَا بَقِیَ بَعْدَ الثُّلُثَیْنِ {لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ}۔","Sahih","Musannaf Ibn Abi Shaybah 31726","","","كتاب الفرائض"
"31727","(۳۱۷۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ حَکِیمِ بْنِ جَابِرٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ : أَنَّہُ قَالَ فِیہَا : ہَذَا مِنْ قَضَائِ أَہْلِ الْجَاہِلِیَّۃِ : یَرِثُ الرِّجَالُ دُونَ النِّسَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 31727","","","كتاب الفرائض"
"31728","(۳۱۷۲۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن مَسْرُوقٍ ، قَالَ : کَانَ یَأْخُذُ بِقَوْلِ عَبْدِ اللہِ فِی أَخَوَاتٍ لأُمٍّ وَأَبٍ ، وَإِخْوَۃٍ وَأَخَوَاتٍ لأَبٍ ، یَجْعَلُ مَا بَقِیَ عَلَی الثُّلُثَیْنِ لِلذِّکُور دُونَ الإِنَاثِ ، فَخَرَجَ خَرْجَۃً إلَی الْمَدِینَۃِ ، قَالَ : فَجَائَ وَہُوَ یَرَی أَنْ یُشَرِّکَ بَیْنَہُمْ ، قَالَ : فَقَالَ لَہُ عَلْقَمَۃُ : مَا رَدَّک عَنْ قَوْلِ عَبْدِ اللہِ ؟ أَلَقِیت أَحَدًا ہُوَ أَثْبَتُ فِی نَفْسِکَ مِنْہُ ؟ قَالَ : فَقَالَ : لاَ ، وَلَکِنْ لَقِیت زَیْدَ بْنَ ثَابِتٍ فَوَجَدْتہ مِنَ الرَّاسِخِینَ فِی الْعِلْمِ۔","Sahih","Musannaf Ibn Abi Shaybah 31728","","","كتاب الفرائض"
"31729","(۳۱۷۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن مَسْرُوقٍ ، قَالَ : قدِمَ فَقَالَ لَہُ عَلْقَمَۃُ : مَا کَانَ ابْنُ مَسْعُودٍ بِثَبْتٍ ؟ فَقَالَ لَہُ مَسْرُوقٌ : کَلاَّ ، وَلَکِنْ رَأَیْت زَیْدَ بْنَ ثَابِتٍ وَأَہْلَ الْمَدِینَۃِ یُشَرِّکُونَ۔","Sahih","Musannaf Ibn Abi Shaybah 31729","","","كتاب الفرائض"
"31730","(۳۱۷۳۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لأُخْتَیْہِ لأَبِیہِ وَأُمِّہِ الثُّلُثَانِ ، وَلإِخْوَتِہِ لأَبِیہِ وَأَخَوَاتِہِ مَا بَقِیَ {لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ} فِی قَوْلِ عَلِیٍّ وَزَیْدٍ ، وَفِی قَوْلِ عَبْدِ اللہِ : لأُخْتَیْہِ لأَبِیہِ وَأُمِّہِ الثُّلُثَانِ ، وَمَا بَقِیَ فَلِلذُّکُورِ مِنْ إخْوَتِہِ دُونَ إنَاثِہِمْ۔n قَالَ أَبُو بَکْرٍ : وَہَذِہِ فِی الْقَوْلَیْنِ جَمِیعًا مِنْ ثَلاَثَۃِ أَسْہُمٍ : لِلأَخَوَاتِ وَالْبَنَاتِ الثُّلُثَانِ ، وَیَبْقَی الثُّلُثُ فَہُوَ بَیْنَ الإِخْوَۃِ وَالأَخَوَاتِ ، أَوْ بَیْنَ بَنَاتِ ابْنِہِ ، وَبَنِی ابْنِہِ ، لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ۔","","Musannaf Ibn Abi Shaybah 31730","","","كتاب الفرائض"
"31731","(۳۱۷۳۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ تَرَکَ ابْنَتَیْہِ وَابْنَۃَ ابْنٍ ، وَابْنَ ابْنٍ أَسْفَلَ مِنْہَا : فَلاِبْنَتَیْہِ الثُّلُثَانِ ، وَمَا فَضَلَ لاِبْنِ ابْنِہِ ، یُرَدُّ عَلَی مَنْ فَوْقَہُ وَمَنْ مَعَہُ مِنَ الْبَنَاتِ ، فِی قَوْلِ عَلِیٍّ وَزَیْدٍ : {لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ} وَلاَ یُرَدُّ عَلَی مَنْ أَسْفَلَ مِنْہُ ، وَفِی قَوْلِ عَبْدِ اللہِ : لاِبْنَتَیْہِ الثُّلُثَانِ ، وَلاِبْنِ ابْنِہِ مَا بَقِی ، لاَ یَردُّ عَلَی أُخْتِہِ شَیْئًا ، وَلاَ عَلَی مَنْ فَوْقَہُ مِنْ أَجْلِ أَنَّہُ اسْتَکْمَلَ الثُّلُثَیْنِ۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ مِنْ تِسْعَۃٍ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ : فَیَصِیرُ لِلاِبْنَتَیْنِ الثُّلُثَانِ : وَتَبْقَی ثَلاَثَۃُ أَسْہُمٍ : فَلاِبْنِ الاِبْنِ سَہْمَانِ ، وَلأُخْتِہِ سَہْمٌ ، وَفِی قَوْلِ عَبْدِ اللہِ : مِنْ ثَلاَثَۃٍ أَسْہُمٍ : لِلْبِنْتَیْنِ الثُّلُثَانِ سَہْمَانِ ، وَلاِبْنِ الاِبْنِ مَا بَقِیَ وَہُوَ سَہْمٌ۔","","Musannaf Ibn Abi Shaybah 31731","","","كتاب الفرائض"
"31732","(۳۱۷۳۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ عَبْدُ اللہِ یَقُولُ فِی ابْنَۃٍ ، وَابْنَۃِ ابْنٍ ، وَبَنِی ابْنٍ ، وَبَنِی أُخْتٍ لأَبٍ وَأُمٍّ ، وَأُخْتٍ وَإِخْوَۃٍ لأَبٍ : أَنَّ ابْنَ مَسْعُودٍ کَانَ یُعْطِی ہَذِہِ النِّصْفَ ، ثُمَّ یَنْظُرُ، فَإِنْ کَانَ إذَا قَاسَمَتِ الذُّکُورَ أَصَابَہَا أَکْثَرُ مِنَ السُّدُسِ ، لَمْ یُزِدْہَا عَلَی السُّدُسِ ، وَإِنْ أَصَابَہَا أَقَلُّ مِنَ السُّدُسِ قَاسَمَ بِہَا ، لَمْ یُلْزِمْہَا الضَّرَرُ ، وَکَانَ غَیْرُہُ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : لِہَذِہِ النِّصْفُ ، وَمَا بَقِیَ فَلِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ۔n قَالَ أَبُو بَکْرٍ : ہَذِہِ أَصْلُہَا مِنْ سِتَّۃِ أَسْہُمٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31732","","","كتاب الفرائض"
"31733","(۳۱۷۳۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ عَلِیٌّ وَزَیْدٌ یَقُولاَنِ فِی بَنِی عَمٍّ أحَدُہُمْ أَخٌ لأُمٍّ : یُعْطِیَانِہِ السُّدُسَ ، وَمَا بَقِیَ بَیْنَہُ وَبَیْنَ بَنِی عَمِّہِ ، وَکَانَ عَبْدُ اللہِ یُعْطِیہ الْمَالَ کُلَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31733","","","كتاب الفرائض"
"31734","(۳۱۷۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : أُتِیَ فِی بَنِی عَمٍّ أَحَدُہُمْ أَخٌ لأُمٍّ ، وَکَانَ ابْنُ مَسْعُودٍ أَعْطَاہُ الْمَالَ کُلَّہُ ، فَقَالَ عَلِیٌّ : یَرْحَمُ اللَّہُ أَبَا عَبْدِ الرَّحْمَنِ ، إِنْ کَانَ لَفَقِیہًا ، لَوْ کُنْت أَنَا لأَعْطیْتُہُ السُّدُسَ ، وَکَانَ شَرِیکَہُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 31734","","","كتاب الفرائض"
"31735","(۳۱۷۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ خَالِدٍ الْحَذَّائِ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ : أَنَّہُ کَانَ یَقْضِی فِی بَنِی عَمٍّ أَحَدُہُمْ أَخٌ لأُمٍّ بِقَضَائِ عَبْدِ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31735","","","كتاب الفرائض"
"31736","(۳۱۷۳۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی امْرَأَۃٍ تَرَکَتْ بَنِی عَمِّہَا ، أَحَدُہُمْ أَخُوہَا لأُمِّہَا ، قَالَ : فَقَضَی فِیہَا عُمَرُ وَعَلِیٌّ وَزَیْدٌ : أَنَّ لأَخِیہَا مِنْ أُمِّہَا السُّدُسَ ، وَہُوَ شَرِیکُہُمْ بَعْدُ فِی الْمَالِ ، وَقَضَی فِیہَا عَبْدُ اللہِ : أَنَّ الْمَالَ لَہُ دُونَ بَنِی عَمِّہِ۔n قَالَ أَبُو بَکْرٍ : فَہِیَ فِی قَوْلِ عُمَرَ وَعَلِیٍّ وَزَیْدٍ : مِنْ سِتَّۃِ أَسْہُمٍ ، وَہِیَ فِی قَوْلِ عَبْدِ اللہِ وَشُرَیْحٍ : مِنْ سَہْمٍ وَاحِدٍ وَہُوَ جَمِیعُ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 31736","","","كتاب الفرائض"
"31737","(۳۱۷۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَوْسٍ ، عَنْ حَکِیمِ بْنِ عِقَالٍ ، قَالَ : أُتِیَ عَلِیٌّ فِی ابْنَیْ عَمٍّ أَحَدُہُمَا زَوْجٌ، وَالآخَرُ أَخٌ لأُمٍّ ، فَقَالَ لِشُرَیْحٍ : قُلْ فِیہَا ، فَقَالَ شُرَیْحٌ : لِلزَّوْجِ النِّصْفُ ، وَمَا بَقِیَ فَلِلأَخِ ، فَقَالَ لَہُ عَلِیٌّ : رَأْیٌ ؟ قَالَ : کَذَلِکَ رَأَیْت ، فَأَعْطَی عَلِیٌّ الزَّوْجَ النِّصْفَ ، وَالأَخ السُّدُسَ ، وَجَعَلَ مَا بَقِیَ بَیْنَہُمَا۔","Da'if","Musannaf Ibn Abi Shaybah 31737","","","كتاب الفرائض"
"31738","(۳۱۷۳۸) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا بْنُ أَبِی زَائِدَۃَ ، عَنْ إسْرَائِیلَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ : فِی امْرَأَۃٍ تَرَکَتْ ثَلاَثَۃً بَنِی عَمٍّ أَحَدُہُمْ زَوْجُہَا ، وَالآخَرُ أَخُوہَا لأُمِّہَا ، فَقَالَ عَلِیٌّ وَزَیْدٌ : لِلزَّوْجِ النِّصْفُ ، وَلِلأَخِ مِنَ الأُمِّ السُّدُسُ ، وَمَا بَقِیَ فَہُوَ بَیْنَہُمْ سَوَائٌ ، وَقَالَ ابْنُ مَسْعُودٍ : لِلزَّوْجِ النِّصْفُ ، وَمَا بَقِیَ فَلِلأَخِ مِنَ الأُمِّ۔n قَالَ أَبُو بَکْرٍ : وَہَذِہِ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ مِنْ سِتَّۃِ : لِلزَّوْجِ النِّصْفُ ثَلاثَۃ ، وَلِلأَخِ لِلأُمِّ السُّدُسُ ، وَیَبْقَی سَہْمَانِ ، فَہُمَا بَیْنَہُمَا ، وَفِی قَوْلِ ابْنِ مَسْعُودٍ مِنْ سَہْمَیْنِ : لِلزَّوْجِ النِّصْفُ ، وَمَا بَقِیَ فَلِلأَخِ لِلأُمِّ۔","","Musannaf Ibn Abi Shaybah 31738","","","كتاب الفرائض"
"31739","(۳۱۷۳۹) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا ، عَنْ إسْرَائِیلَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ : فِی امْرَأَۃٍ تَرَکَتْ أَخَوَیْہَا لأُمِّہَا ، أَحَدُہُمَا ابْنُ عَمِّہَا، فَقَالَ عَلِیٌّ وَزَیْدٌ: الثُّلُثُ بَیْنَہُمَا، وَمَا بَقِیَ فَلاِبْنِ عَمِّہَا، وَقَالَ ابْنُ مَسْعُودٍ: الْمَالُ بَیْنَہُمَا۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ مِنْ ثَلاَثَۃِ أَسْہُمٍ ، وَفِی قَوْلِ ابْنِ مَسْعُودٍ مِنْ سَہْمَیْنِ۔","","Musannaf Ibn Abi Shaybah 31739","","","كتاب الفرائض"
"31740","(۳۱۷۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ عَبْدِ الْمَلِکِ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنْ أبْنَۃٍ وَابْنَیْ عَمٍّ أَحَدُہُمَا أَخٌ لأُمٍّ ؟ فَقَالَ : لِلاِبْنَۃِ النِّصْفُ ، وَمَا بَقِیَ فَلاِبْنِ الْعَمِّ الَّذِی لَیْسَ بِأَخٍ لأُمٍّ ، وَلاَ یَرِث أَخٌ لأُمٍّ مَعَ وَلَدٍ ، قَالَ : فَسَأَلْت عَطَائً ، فَقَالَ : أَخْطَأَ سَعِیدٌ ، لِلاِبْنَۃِ النِّصْفُ ، وَمَا بَقِیَ بَیْنَہُمَا نِصْفَیْنِ۔n قَالَ : أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ سَعِیدِ بْنِ جُبَیْرٍ مِنْ سَہْمَیْنِ : لِلاِبْنَۃِ النِّصْفُ وَلاِبْنِ الْعَمِّ الَّذِی لَیْسَ بِأَخٍ لأُمٍّ النِّصْفُ ، وَفِی قَوْلِ عَطَائٍ مِنْ أَرْبَعَۃٍ : سَہْمَانِ لِلاِبْنَۃِ ، وَسَہْمَانِ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 31740","","","كتاب الفرائض"
"31741","(۳۱۷۴۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی امْرَأَۃٍ تَرَکَتْ أَعْمَامَہَا أَحَدُہُمْ أَخُوہَا لأُمِّہَا ، فَقَضَی فِیہَا عَلِیٌّ وَزَیْدٌ : أَنَّ لأَخِیہَا لأُمِّہَا السُّدُسَ ، ثُمَّ ہُوَ شَرِیکُہُمْ بَعْدُ فِی الْمَالِ ، وَقَضَی فِیہَا ابْنُ مَسْعُودٍ : أَنَّ الْمَالَ کُلَّہُ لَہُ ، وَہَذَا نَسَب یَکُونُ فِی الشِّرْکِ ، ثُمَّ یُسلمُ أَہْلَہُ بَعْدُ۔n قَالَ أَبُو بَکْرٍ: فَہَذِہِ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ مِنْ سِتَّۃِ أَسْہُمٍ ، وَفِی قَوْلِ عَبْدِ اللہِ: مِنْ سَہْمٍ وَاحِدٍ لأَنَّہُ ا[corrupt]ْمَالُ کُلُّہُ۔","","Musannaf Ibn Abi Shaybah 31741","","","كتاب الفرائض"
"31742","(۳۱۷۴۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی امْرَأَۃٍ تَرَکَتْ إخْوَتَہَا لأُمِّہَا رِجَالاً وَنِسَائً، وَہُمْ بَنُو عَمِّہَا فِی الْعَصَبَۃِ ، قَالَ : یَقْتَسِمُونَ الثُّلُثَ بَیْنَہُمْ : الرِّجَالُ وَالنِّسَائُ فِیہِ سَوَائٌ ، وَالثُّلُثَانِ الْبَاقِیَانِ لِذُکُورِہِمْ خَالِصًا دُونَ النِّسَائِ فِی قَضَائِ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کُلِّہِمْ۔n وَہَذِہِ فِی قَوْلِہِمْ جَمِیعًا مِنْ ثَلاَثَۃِ أَسْہُمٍ۔","","Musannaf Ibn Abi Shaybah 31742","","","كتاب الفرائض"
"31743","(۳۱۷۴۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ تَرَکَ ابْنَتَیْہِ وَبَنِی ابْنِہِ رِجَالاً وَنِسَائً : فَلاِبْنَتَیْہِ الثُّلُثَانِ ، وَمَا بَقِیَ فَلِلذُّکُورِ دُونَ الإِنَاثِ ، وَکَانَ عَبْدُ اللہِ لاَ یَزِیدُ الأَخَوَاتِ وَالْبَنَاتِ عَلَی الثُّلُثَیْنِ ، وَکَانَ عَلِیٌّ وَزَیْدٌ یُشَرِّکُونَ فِیمَا بَیْنَہُمْ ، فَمَا بَقِیَ {لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ}۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ مِنْ ثَلاَثَۃِ أَسْہُمٍ فِی قَوْلِہِمْ جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 31743","","","كتاب الفرائض"
"31744","(۳۱۷۴۴) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ سِمَاکِ بْنِ الْفَضْلِ ، قَالَ : سَمِعْتُ وَہْبًا یُحَدِّثُ ، عَنِ الْحَکَمِ بْنِ مَسْعُودٍ ، قَالَ : شَہِدْت عُمَرَ أَشْرَکَ الإِخْوَۃَ مِنَ الأَبِ وَالأُمِّ مَعَ الإِخْوَۃِ مِنَ الأُمِّ فِی الثُّلُثِ ، فَقَالَ لَہُ رَجُلٌ : قَدْ قَضَیْت فِی ہَذَہ عَامَ الأَوَّلِ بِغَیْرِ ہَذَا ، قَالَ : وَکَیْفَ قَضَیْت ؟ قَالَ : جَعَلْتہ لِلإِخْوَۃِ لِلأُمِّ وَلَمْ تَجْعَلْ لِلإِخْوَۃِ مِنَ الأَبِ وَالأُمِّ شَیْئًا ، فَقَالَ : ذَلِکَ عَلَی مَا قَضَیْنَا ، وَہَذَا عَلَی مَا نَقْضِی۔ (عبدالرزاق ۱۹۰۰۵)","Da'if","Musannaf Ibn Abi Shaybah 31744","","","كتاب الفرائض"
"31745","(۳۱۷۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ : أَنَّ عُمَرَ وَزَیْدًا وَابْنَ مَسْعُودٍ کَانُوا یُشَرِّکُونَ فِی زَوْجٍ وَأُمٍّ وَإِخْوَۃٍ لأُمٍّ وَأَبٍ وَأَخَوَاتٍ لأُمٍّ ، یُشَرِّکُونَ بَیْنَ الإِخْوَۃِ مِنَ الأَبِ وَالأُمِّ مَعَ الإِخْوَۃِ لِلأُمِّ فِی سَہْمٍ ، وَکَانُوا یَقُولُونَ : لَمْ یَزِدْہُمَ الأَبُ إلاَّ قُرْبًا ، وَیَجْعَلُونَ ذُکُورَہُمْ وَإِنَاثَہُمْ فِیہِ سَوَائً۔","","Musannaf Ibn Abi Shaybah 31745","","","كتاب الفرائض"
"31746","(۳۱۷۴۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی امْرَأَۃٍ تَرَکَتْ زَوْجَہَا وَأُمَّہَا وَإِخْوَتَہَا لأَبِیہَا وَأُمِّہَا وَإِخْوَتَہَا لأُمِّہَا : فَلِزَوْجِہَا النِّصْفُ ثَلاَثَۃُ أَسْہُمٍ ، وَلأُمِّہَا السُّدُسُ سَہْمٌ ، وَلاِِخْوَتِہَا لأُمِّہَا الثُّلُثُ سَہْمَانِ ، وَلَمْ یَجْعَلْ لاِِخْوَتِہَا لأَبِیہَا وَأُمِّہَا مِنَ الْمِیرَاثِ شَیْئًا فِی قَضَائِ عَلِی ، وَشَرَّک بَیْنَہُمْ عُمَرُ وَعَبْدُ اللہِ وَزَیْدُ بْنُ ثَابِتٍ : بَیْنَ الإِخْوَۃِ مِنَ الأَبِ وَالأُمِّ مَعَ بَنِی الأُمِّ فِی الثُّلُثِ الَّذِی وَرِثُوا ، غَیْرَ أَنَّہُمْ شَرَّکُوا ذُکُورَہُمْ وَإِنَاثَہُمْ فِیہِ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 31746","","","كتاب الفرائض"
"31747","(۳۱۷۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ : أَنَّ عُثْمَانَ شَرَّک بَیْنَہُمْ۔","","Musannaf Ibn Abi Shaybah 31747","","","كتاب الفرائض"
"31748","(۳۱۷۴۸) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنِ ابْنِ الْمُنْتَشِرِ ، عَنْ شُرَیْحٍ وَمَسْرُوقٍ : أَنَّہُمَا شَرَّکَا الإِخْوَۃَ مِنَ الأَبِ وَالأُمِّ مَعَ الإِخْوَۃِ مِنَ الأُمِّ۔","","Musannaf Ibn Abi Shaybah 31748","","","كتاب الفرائض"
"31749","(۳۱۷۴۹) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، بِمِثْلِہِ ، قَالَ : مَا زَادَہُمَ الأَبُ إلاَّ قُرْبًا۔","","Musannaf Ibn Abi Shaybah 31749","","","كتاب الفرائض"
"31750","(۳۱۷۵۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، أَنَّہُ قَالَ : لأُمِّہَا السُّدُسُ ، وَلِزَوْجِہَا الشَّطْرُ ، وَالثُّلُثُ بَیْنَ الإِخْوَۃِ مِنَ الأُمِّ وَالإِخْوَۃِ مِنَ الأَبِ وَالأُمِّ۔","","Musannaf Ibn Abi Shaybah 31750","","","كتاب الفرائض"
"31751","(۳۱۷۵۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، قَالَ : مَاتَتِ ابْنَۃٌ لِلْحَسَنِ بْنِ الْحَسَنِ وَتَرَکَتْ زَوْجَہَا وَأُمَّہَا وَإِخْوَتَہَا لأُمِّہَا وَإِخْوَتَہَا لأَبِیہَا وَأُمِّہَا ، فَارْتَفَعُوا إلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ، فَأَعْطَی الزَّوْجَ النِّصْفَ ، وَالأُمَّ السُّدُسَ ، وَأَشْرَکَ بَیْنَ الإِخْوَۃِ مِنَ الأُمِّ وَالإِخْوَۃِ مِنَ الأَبِ وَالأُمِّ ، وَقَالَ لِلزَّوْجِ : أَمْسِکْ عَنْ أَتْرَابِکَ ، أَیَلْحَقُ بِہِمْ سَہْمٌ آخَرُ ، حَتَّی یُنْظر حُبْلَی ہِیَ أَمْ لاَ ؟۔","","Musannaf Ibn Abi Shaybah 31751","","","كتاب الفرائض"
"31752","(۳۱۷۵۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ وَعُمَرُ یُشَرِّکَانِ ، قَالَ : وَکَانَ عَلِیٌّ لاَ یُشَرِّکُ۔n قَالَ أَبُو بَکْرٍ : وَہَذِہِ مِنْ سِتَّۃِ أَسْہُمٍ : لِلزَّوْجِ النِّصْفُ ثَلاَثَۃُ أَسْہُمٍ ، وَلِلأُمِّ السُّدُسُ ، وَلِلإِخْوَۃِ مِنَ الأُمِّ الثُّلُثُ وَہُوَ سَہْمَانِ۔","","Musannaf Ibn Abi Shaybah 31752","","","كتاب الفرائض"
"31753","(۳۱۷۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، عَنْ عَلِیٍّ : أَنَّہُ کَانَ لاَ یُشَرِّکُ۔","Hasan","Musannaf Ibn Abi Shaybah 31753","","","كتاب الفرائض"
"31754","(۳۱۷۵۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ : أَنَّہُ کَانَ لاَ یُشَرِّکُ۔","Da'if","Musannaf Ibn Abi Shaybah 31754","","","كتاب الفرائض"
"31755","(۳۱۷۵۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَلِیٌّ لاَ یُشَرِّکُ۔","","Musannaf Ibn Abi Shaybah 31755","","","كتاب الفرائض"
"31756","(۳۱۷۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی قَیْسٍ ، عَنْ ہُزَیْلٍ ، عَنْ عَبْدِ اللہِ : أَنَّہُ کَانَ لاَ یُشَرِّکُ ، وَیَقُولُ : تَنَاہَت السِّہَامُ۔","Sahih","Musannaf Ibn Abi Shaybah 31756","","","كتاب الفرائض"
"31757","(۳۱۷۵۷) حَدَّثَنَا مَعْشَرٌ ، عَنْ أَبِیہِ ، عَنْ أَبِی مِجْلَزٍ ، عَنْ عَلِیٍّ : أَنَّہُ کَانَ لاَ یُشَرِّکُ بَیْنَہُمْ۔","","Musannaf Ibn Abi Shaybah 31757","","","كتاب الفرائض"
"31758","(۳۱۷۵۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، عَنْ زَیْدِ بْنِ ثَابِتٍ : أَنَّہُ کَانَ لاَ یُشَرِّکُ۔","Da'if","Musannaf Ibn Abi Shaybah 31758","","","كتاب الفرائض"
"31759","(۳۱۷۵۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ دَاوُد ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ : أَنَّ عَلِیًّا وَأَبَا مُوسَی وَأُبَیًّا کَانُوا لاَ یُشَرِّکُونَ ، قَالَ وَکِیعٌ : وَلَیْسَ أَحَدٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلاَّ اخْتَلَفُوا عَنْہُ فِی الشَّرِکَۃِ ، إلاَّ عَلِیٌّ فَإِنَّہُ کَانَ لاَ یُشَرِّکُ۔","Da'if","Musannaf Ibn Abi Shaybah 31759","","","كتاب الفرائض"
"31760","(۳۱۷۶۰) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عُمَرَ : أَنَّہُ قَسَمَ الْمَالَ بَیْنَ عَمَّۃٍ وَخَالَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 31760","","","كتاب الفرائض"
"31761","(۳۱۷۶۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، عَنْ زِیَادٍ ، قَالَ : إنِّی لأَعْلَمُ مَا صَنَعَ عُمَرُ ، جَعَلَ الْعَمَّۃَ بِمَنْزِلَۃِ الأَبِ ، وَالْخَالَۃَ بِمَنْزِلَۃِ الأُمِّ۔","Sahih","Musannaf Ibn Abi Shaybah 31761","","","كتاب الفرائض"
"31762","(۳۱۷۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ الْحَسَنِ ، عَنْ عُمَرَ ، قَالَ : لِلْعَمَّۃِ الثُّلُثَانِ ، وَلِلْخَالَۃِ الثُّلُثُ۔","Hasan","Musannaf Ibn Abi Shaybah 31762","","","كتاب الفرائض"
"31763","(۳۱۷۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سُلَیْمَانَ الْعَبْسِیِّ ، عَنْ رَجُلٍ ، عَنْ عَلِیٍّ : أَنَّہُ کَانَ یَقُولُ فِی الْعَمَّۃِ وَالْخَالَۃِ بِقَوْلِ عُمَرَ : لِلْعَمَّۃِ الثُّلُثَانِ ، وَلِلْخَالَۃِ الثُّلُثُ۔","Da'if","Musannaf Ibn Abi Shaybah 31763","","","كتاب الفرائض"
"31764","(۳۱۷۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ یُونُسَ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، أَنَّہُ کَانَ یُنَزِّلُ الْعَمَّۃَ بِمَنْزِلَۃِ الأَبِ ، وَالْخَالَۃَ بِمَنْزِلَۃِ الأُمِّ۔","","Musannaf Ibn Abi Shaybah 31764","","","كتاب الفرائض"
"31765","(۳۱۷۶۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عُمَرُ وَعَبْدُ اللہِ یُوَرِّثَانِ الْخَالَۃَ وَالْعَمَّۃَ إذَا لَمْ یَکُنْ غَیْرُہُمَا۔n قَالَ إبْرَاہِیمُ : کَانُوا یَجْعَلُونَ الْعَمَّۃَ بِمَنْزِلَۃِ الأَبِ ، وَالْخَالَۃَ بِمَنْزِلَۃِ الأُمِّ۔","","Musannaf Ibn Abi Shaybah 31765","","","كتاب الفرائض"
"31766","(۳۱۷۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ بَشِیرٍ الْہَمْدَانِیِّ ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ مَسْعُودٍ ، أَنَّہُ کَانَ یَقُولُ فِی الْخَالَۃِ وَالْعَمَّۃِ : لِلْعَمَّۃِ الثُّلُثَانِ ، وَلِلْخَالَۃِ الثُّلُثُ۔","Da'if","Musannaf Ibn Abi Shaybah 31766","","","كتاب الفرائض"
"31767","(۳۱۷۶۷) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ مَنْصُورٍ وَمُغِیرَۃ، عَنْ إبْرَاہِیمَ، قَالَ: کَانُوا یُوَرَّثُونَ بِقَدْرِ أَرْحَامِہِمْ۔","","Musannaf Ibn Abi Shaybah 31767","","","كتاب الفرائض"
"31768","(۳۱۷۶۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیِّ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّ عُمَرَ وَرَّثَ الْخَالَۃَ وَالْعَمَّۃَ ، فَوَرَّثَ الْعَمَّۃَ الثُّلُثَیْنِ ، وَالْخَالَۃَ الثُّلُثَ۔","Hasan","Musannaf Ibn Abi Shaybah 31768","","","كتاب الفرائض"
"31769","(۳۱۷۶۹) حَدَّثَنَا سُوَیْد بْنُ عَمْرو ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ ابْنُ مَسْعُودٍ : لِلْعَمَّۃِ الثُّلُثَانِ ، وَلِلْخَالَۃِ الثُّلُثُ۔","","Musannaf Ibn Abi Shaybah 31769","","","كتاب الفرائض"
"31770","(۳۱۷۷۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ سَعْدٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، قَالَ : دُعِیَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی جِنَازَۃِ رَجُلٍ مِنَ الأَنْصَارِ ، فَجَائَ عَلَی حِمَارٍ ، فَقَالَ : مَا تَرَکَ ؟ قَالُوا : تَرَکَ عَمَّۃً وَخَالَۃً ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : رَجُلٌ مَاتَ وَتَرَکَ عَمَّۃً وَخَالَۃً ، ثُمَّ سَارَ ، ثُمَّ قَالَ : رَجُلٌ مَاتَ وَتَرَکَ عَمَّۃً وَخَالَۃً ، ثُمَّ قَالَ : لَمْ أَجِدْ لَہُمَا شَیْئًا۔ (ابوداؤد ۳۶۱۔ سعید بن منصور ۱۶۳)","","Musannaf Ibn Abi Shaybah 31770","","","كتاب الفرائض"
"31771","(۳۱۷۷۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی بَکْرٍ ، قَالَ : قَالَ عُمَرُ : عَجَبًا لِلْعَمَّۃِ تُورثُ، وَلاَ تَرِثُ۔","","Musannaf Ibn Abi Shaybah 31771","","","كتاب الفرائض"
"31772","(۳۱۷۷۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ شَرِیکِ بْنِ عَبْدِ اللہِ بْنِ أَبِی نَمِرٍ ، قَالَ : سُئِلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ مِیرَاثِ الْعَمَّۃِ وَالْخَالَۃِ وَہُوَ رَاکِبٌ ، فَسَکَتَ ، ثُمَّ سَارَ ہُنَیْہَۃً ، ثُمَّ قَالَ : حَدَّثَنِی جِبْرِیلُ أَنَّہُ لاَ مِیرَاثَ لَہُمَا۔","","Musannaf Ibn Abi Shaybah 31772","","","كتاب الفرائض"
"31773","(۳۱۷۷۳) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ: أَنَّہُ کَانَ یَرَی الْمِیرَاثَ لِلْمَوَالِی دُونَ الْعَمَّۃِ وَالْخَالَۃِ۔","","Musannaf Ibn Abi Shaybah 31773","","","كتاب الفرائض"
"31774","(۳۱۷۷۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ عَیَّاش بْنِ أَبِی رَبِیعَۃَ الزُّرَقِیِّ ، عَنْ حَکِیمِ بْنِ حَکِیمِ بْنِ عَبَّادِ بْنِ حُنَیْفٍ الأَنْصَارِیِّ ، عَنْ أَبِی أُمَامَۃَ بْنِ سَہْلِ بْنِ حُنَیْفٍ : أَنَّ رَجُلاً رَمَی رَجُلاً بِسَہْمٍ فَقَتَلَہُ وَلَیْسَ لَہُ وَارِثٌ إلاَّ خَالٌ ، فَکَتَبَ فِی ذَلِکَ أَبُو عُبَیْدَۃَ بْنُ الْجَرَّاحِ إلَی عُمَرَ ، فَکَتَبَ إلَیْہِ عُمَرُ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : اللَّہُ وَرَسُولُہُ مَوْلَی مَنْ لاَ مَوْلَی لَہُ ، وَالْخَالُ وَارِثُ مَنْ لاَ وَارِثَ لَہُ۔ (ترمذی ۲۱۰۳۔ ابن ماجہ ۲۷۳۷)","Da'if","Musannaf Ibn Abi Shaybah 31774","","","كتاب الفرائض"
"31775","(۳۱۷۷۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ، قَالَ: وَرَّثَ عُمَرُ الْخَالَ الْمَالَ کُلَّہُ، قَالَ: کَانَ خَالاً وَمَوْلًی۔","","Musannaf Ibn Abi Shaybah 31775","","","كتاب الفرائض"
"31776","(۳۱۷۷۶) حَدَّثَنَا وَکِیعٌ، عَنِ الْحَکَمِ بْنِ عَطِیَّۃَ، عَنْ عَبْدِاللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ: أَنَّ عُمَرَ وَرَّثَ خَالاً وَمَوْلًی مِنْ مَوْلاَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 31776","","","كتاب الفرائض"
"31777","(۳۱۷۷۷) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، قَالَ : حَدَّثَنَا بُدَیْلُ بْنُ مَیْسَرَۃَ الْعُقَیْلِیُّ ، عَنِ ابْنِ أَبِی طَلْحَۃَ ، عَنْ رَاشِدِ بْنِ سَعْدٍ ، عَنْ أَبِی عَامِرٍ الْہَوْزَنِیُّ ، عَنِ الْمِقْدَامِ رَجُلٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْخَالُ وَارِثُ مَنْ لاَ وَارِثَ لَہُ۔ (ابوداؤد ۲۸۹۱۔ ابن حبان ۶۰۳۵)","Hasan","Musannaf Ibn Abi Shaybah 31777","","","كتاب الفرائض"
"31778","(۳۱۷۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، عَنْ عَامِرٍ ، قَالَ : سُئِلَ مَسْرُوقٌ عَنْ رَجُلٍ مَاتَ وَلَیْسَ لَہُ وَارِثٌ إلاَّ خَالُہُ وَابْنَۃُ أَخِیہ ؟ قَالَ : لِلْخَالِ نَصِیبُ أُخْتِہِ ، وَلاِبْنَۃِ الأَخِ نَصِیبُ أَبِیہَا۔","","Musannaf Ibn Abi Shaybah 31778","","","كتاب الفرائض"
"31779","(۳۱۷۷۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ، عَنْ عَمِّہِ وَاسِعِ بْنِ حَبَّانَ، قَالَ : ہَلَکَ ابْنُ دَحْدَاحَۃَ وَکَانَ ذَا رَأْیٍ فِیہِمْ ، فَدَعَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَاصِمَ بْنَ عَدِیٍّ ، فَقَالَ : ہَلْ کَانَ لَہُ فِیکُمْ نَسَبٌ ؟ قَالَ : لاَ ، قَالَ : فَأَعْطَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِیرَاثَہُ ابْنَ أُخْتِہِ أَبَا لُبَابَۃَ بْنَ عَبْدِ الْمُنْذِرِ۔ (عبدالرزاق ۱۹۱۲۰)","","Musannaf Ibn Abi Shaybah 31779","","","كتاب الفرائض"
"31780","(۳۱۷۸۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ وُہَیْبٍ ، عَنِ ابْنِ طَاوس ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَلْحِقُوا الْفَرَائِضَ بِأَہْلِہَا فَمَا بَقِیَ فَہُوَ لأَوْلَی رَجُلٍ۔ (بخاری ۶۷۳۲۔ مسلم ۱۲۳۳)","Sahih","Musannaf Ibn Abi Shaybah 31780","","","كتاب الفرائض"
"31781","(۳۱۷۸۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ رَجُلٍ مِنْ أَہْلِ الْمَدِینَۃِ ، عَنْ مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ، عَنْ عَمِّہِ وَاسِعِ بْنِ حَبَّانَ ، قَالَ : کَانَ ثَابِتُ ابْنُ الدَّحْدَاحَ رَجُلاً أَتِیًّا - یَعْنِی : طَارِئًا - وَکَانَ فِی بَنِی أُنَیفٍ ، أَوْ فِی بَنِی الْعَجْلاَنِ ، فَمَاتَ وَلَمْ یَدَعْ وَارِثًا إلاَّ ابْنَ أُخْتِہِ أَبَا لُبَابَۃَ بْنَ عَبْدِ الْمُنْذِرِ ، فَأَعْطَاہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِیرَاثَہُ۔ (عبدالرزا ق۱۹۱۲۰)","Da'if","Musannaf Ibn Abi Shaybah 31781","","","كتاب الفرائض"
"31782","(۳۱۷۸۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عُبَیْدِ بْنِ أَبِی الْجَعْدِ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، قَالَ : تَدْرِی مَا ابْنَۃُ حَمْزَۃَ مِنِّی ہِیَ أُخْتِی لأُمِّی ، أَعْتَقَتْ رَجُلاً فَمَاتَ فَقُسِمَ مِیرَاثُہُ بَیْنَ ابْنَتِہِ وَبَیْنَہَا ، قَالَ : عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (سعید بن منصور ۱۷۳)","","Musannaf Ibn Abi Shaybah 31782","","","كتاب الفرائض"
"31783","(۳۱۷۸۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، عَنِ ابْنَۃِ حَمْزَۃَ - قَالَ مُحَمَّدٌ : وَہِیَ أُخْتُ ابْنِ شَدَّادٍ لأُمِّہِ - قَالَتْ : مَاتَ مَوْلًی لِی وَتَرَکَ ابْنَتَہُ ، فَقَسَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَالَہُ بَیْنِی وَبَیْنَ ابْنَتِہِ ، فَجَعَلَ لِی النِّصْفَ وَلَہَا النِّصْفَ۔","Da'if","Musannaf Ibn Abi Shaybah 31783","","","كتاب الفرائض"
"31784","(۳۱۷۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أعْطَی ابْنَۃَ حَمْزَۃَ النِّصْفَ وَابْنَتَہُ النِّصْفَ۔","","Musannaf Ibn Abi Shaybah 31784","","","كتاب الفرائض"
"31785","(۳۱۷۸۵) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ الحَسَنِ بْنِ صَالِحٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ أَبِی بُرْدَۃَ : أَنَّ رَجُلاً مَاتَ وَتَرَکَ ابْنَتَہُ وَمَوَالِیَہُ الَّذِینَ أَعْتَقُوہُ فَأَعْطَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ابْنَتَہُ النِّصْفَ وَمَوَالِیَہُ النِّصْفَ۔ (ابوداؤد ۳۶۳۔ بیہقی ۲۴۱)","","Musannaf Ibn Abi Shaybah 31785","","","كتاب الفرائض"
"31786","(۳۱۷۸۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الْحَکَمِ ، عَنْ شَمُوسٍ الْکِنْدِیَّۃِ ، قَالَتْ : قاضَیْت إلَی عَلِیٍّ فِی أَبِی : مَاتَ وَلَمْ یَتْرُکْ غَیْرِی وَمَوْلاَہُ ، فَأَعْطَانِی النِّصْفَ وَمَوْلاَہُ النِّصْفَ۔","Da'if","Musannaf Ibn Abi Shaybah 31786","","","كتاب الفرائض"
"31787","(۳۱۷۸۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الْحَکَمِ ، عَنْ شَمُوسٍ ، عَنْ عَلِیٍّ ، بِمِثْلِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 31787","","","كتاب الفرائض"
"31788","(۳۱۷۸۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ أَبِی الْکَنُودِ ، عَنْ عَلِیٍّ : أَنَّہُ قَضَی فِی ابْنَۃٍ وَمَوْلًی ، أَعْطَی الْبِنْتَ النِّصْفَ ، وَالْمَوْلَی النِّصْفَ۔","Da'if","Musannaf Ibn Abi Shaybah 31788","","","كتاب الفرائض"
"31789","(۳۱۷۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ : أَنَّ مَوْلًی لاِبْنَۃِ حَمْزَۃَ مَاتَ وَتَرَکَ ابْنَتَہُ وَابْنَۃَ حَمْزَۃَ ، فَأَعْطَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ابْنَۃَ حَمْزَۃَ النِّصْفَ ، وَابْنَتَہُ النِّصْفَ۔","","Musannaf Ibn Abi Shaybah 31789","","","كتاب الفرائض"
"31790","(۳۱۷۹۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ عَبْدِ الرَّحْمَنِ الْمُحَارِبِیُّ ، عَنْ زَائِدَۃَ ، عَنْ أَبِی حَصِینٍ ، قَالَ : خَاصَمْت إلَی شُرَیْحٍ فِی مَوْلًی لَنَا مَاتَ وَتَرَکَ ابْنَتَیْہِ وَمَوَالِیَہُ ، فَأَعْطَی شُرَیْحٌ ابْنَتَیْہِ الثُّلُثَیْنِ ، وَأَعْطَی مَوْلاَہُ الثُّلُثَ۔","","Musannaf Ibn Abi Shaybah 31790","","","كتاب الفرائض"
"31791","(۳۱۷۹۱) حَدَّثَنَا عَبْدَۃُ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : ذُکِرَ عِنْدَہُ حَدِیثُ ابْنَۃِ حَمْزَۃَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَعْطَاہَا النِّصْفَ ، فَقَالَ : إنَّمَا أَطْعَمَہَا إیَّاہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ طُعْمَۃً۔","","Musannaf Ibn Abi Shaybah 31791","","","كتاب الفرائض"
"31792","(۳۱۷۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورِ بْنِ حَیَّانَ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ : أَنَّ مَوْلًی لاِبْنَۃِ حَمْزَۃَ مَاتَ وَتَرَکَ ابْنَتَہُ وَابْنَۃَ حَمْزَۃَ ، فَأَعْطَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ابْنَتَہُ النِّصْفَ ، وَابْنَۃَ حَمْزَۃَ النِّصْفَ۔n قَالَ أَبُو بَکْرٍ : وَہَذِہِ مِنْ سَہْمَیْنِ : لِلْبِنْتِ النِّصْفُ وَلِلْمَوْلَی النِّصْفُ۔ (طحاوی ۴۰۱۔ بیہقی ۲۴۱)","","Musannaf Ibn Abi Shaybah 31792","","","كتاب الفرائض"
"31793","(۳۱۷۹۳) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ۔ وَعَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ : أَنَّ عَلِیًّا کَانَ یَقُولُ فِی الْمَمْلُوکِینَ وَأَہْلِ الْکِتَابِ : لاَ یَحْجُبُونَ ، وَلاَ یَرِثُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 31793","","","كتاب الفرائض"
"31794","(۳۱۷۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، عَنِ زَیْدِ بْنِ ثَابِتٍ قَالَ : لاَ یَحْجُبُونَ وَلاَ یَرِثُونَ۔","","Musannaf Ibn Abi Shaybah 31794","","","كتاب الفرائض"
"31795","(۳۱۷۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ ، قَالَ عُمَرُ : لاَ یَحْجُبُ مَنْ لاَ یَرِثُ۔","","Musannaf Ibn Abi Shaybah 31795","","","كتاب الفرائض"
"31796","(۳۱۷۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ أَبِی صَادِقٍ ، عَنْ عَلِیٍّ ، قَالَ : الْمَمْلُوکُونَ لاَ یَرِثُونَ ، وَلاَ یَحْجُبُونَ۔","","Musannaf Ibn Abi Shaybah 31796","","","كتاب الفرائض"
"31797","(۳۱۷۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ أَبِی صَادِقٍ : أَنَّ رَجُلاً سَأَلَ عَلِیًّا عَنِ امْرَأَۃٍ مَاتَتْ وَتَرَکَتْ أُخْتُہَا وَأُمُّہَا مَمْلُوکَۃٌ ؟ فَقَالَ عَلِیٌّ : ہَلْ یُحِیطُ السُّدُسُ بِرَقَبَتِہَا ؟ فَقَالَ : لاَ ، فَقَالَ : دَعْنَا مِنْہَا سَائِرَ الْیَوْمِ۔","","Musannaf Ibn Abi Shaybah 31797","","","كتاب الفرائض"
"31798","(۳۱۷۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، عَنْ شُرَیْحٍ ، أَنَّہُ أَعْطَی مِیرَاثَ رَجُلٍ - أَخُوہُ مَمْلُوکُ - بَنِی أَخِیہِ الأَحْرَارَ۔","","Musannaf Ibn Abi Shaybah 31798","","","كتاب الفرائض"
"31799","(۳۱۷۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : یَرِثُہُ بَنُو أَخِیہِ الأَحْرَارُ۔","","Musannaf Ibn Abi Shaybah 31799","","","كتاب الفرائض"
"31800","(۳۱۸۰۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ : فِی رَجُلٍ مَاتَ وَتَرَکَ أُمَّہُ مَمْلُوکَۃً ، وَجَدَّتَہُ حُرَّۃً ، قَالَ : الْمَالُ لِلْجَدَّۃِ۔","","Musannaf Ibn Abi Shaybah 31800","","","كتاب الفرائض"
"31801","(۳۱۸۰۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَعْمَرٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلِیٍّ وَزَیْدٍ : فِی الْمَمْلُوکِینَ وَالْمُشْرِکِینَ ، قَالاَ : لاَ یَحْجُبُونَ ، وَلاَ یَرِثُونَ۔","","Musannaf Ibn Abi Shaybah 31801","","","كتاب الفرائض"
"31802","(۳۱۸۰۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ۔ وَعَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ مَسْعُودٍ : أَنَّہُ کَانَ یَحْجُبُ بِالْمَمْلُوکِینَ وَأَہْلِ الْکِتَابِ ، وَلاَ یُوَرِّثُہُمْ۔","","Musannaf Ibn Abi Shaybah 31802","","","كتاب الفرائض"
"31803","(۳۱۸۰۳) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ : إذَا مَاتَ الرَّجُلُ وَتَرَکَ أَبَاہُ ، أَوْ أَخَاہُ، أَو ابْنَہُ مَمْلُوکًا وَلَمْ یَتْرُکْ وَارِثًا فَإِنَّہُ یُشْتَرَی فَیُعْتَقُ ، ثُمَّ یُوَرَّثُ۔","","Musannaf Ibn Abi Shaybah 31803","","","كتاب الفرائض"
"31804","(۳۱۸۰۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، عَنِ ابْنِ مَسْعُودٍ : فِی رَجُلٍ مَاتَ وَتَرَکَ أَبَاہُ مَمْلُوکًا، قَالَ : یُشْتَرَی مِنْ مَالِہِ فَیُعْتَقُ ، ثُمَّ یُوَرَّثُ ، قَالَ : وَکَانَ الْحَسَنُ یَقُولُہُ۔","","Musannaf Ibn Abi Shaybah 31804","","","كتاب الفرائض"
"31805","(۳۱۸۰۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ، بِمِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 31805","","","كتاب الفرائض"
"31806","(۳۱۸۰۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عُمَرُ وَعَبْدُ اللہِ یُعْطِیَانِ الْمِیرَاثَ ذَوِی الأَرْحَامِ، قَالَ فُضَیْلٌ: فَقُلْتُ لإِبْرَاہِیمَ: فَعَلِیٌّ؟ قَالَ: کَانَ أَشَدَّہُمْ فِی ذَلِکَ: أَنْ یُعْطِیَ ذَوِی الأَرْحَامِ۔","","Musannaf Ibn Abi Shaybah 31806","","","كتاب الفرائض"
"31807","(۳۱۸۰۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ وَعُمَرَ وَعَلِیٍّ ، وَعَبْدِ اللہِ ، بِمِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 31807","","","كتاب الفرائض"
"31808","(۳۱۸۰۸) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، عَنْ أَبِی الزَّاہِرِیَّۃِ - قَالَ أَبُو بَکْرٍ : أَظُنُّہُ ، عَنْ جُبَیْرِ بْنِ نُفَیْرٍ - قَالَ : کُنْتُ جَالِسًا عِنْدَ أَبِی الدَّرْدَائِ - وَکَانَ قَاضِیًا - فَأَتَاہُ رَجُلٌ ، فَقَالَ : إنَّ ابْنَ أُخْتِی مَاتَ وَلَمْ یَدَعْ وَارِثًا ، فَکَیْفَ تَرَی فِی مَالِہِ ؟ قَالَ : انْطَلِقْ فَاقْبِضْہُ۔","Hasan","Musannaf Ibn Abi Shaybah 31808","","","كتاب الفرائض"
"31809","(۳۱۸۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَیَّانَ الْجُعْفِیِّ ، عَنْ سُوَیْد بْنِ غَفَلَۃً : أَنَّ عَلِیًّا أُتِیَ فِی ابْنَۃٍ وَامْرَأَۃٍ وَمَوَالِی ، فَأَعْطَی الاِبْنَۃَ النِّصْفَ ، وَالْمَرْأَۃَ الثُّمُنَ ، وَرَدَّ مَا بَقِیَ عَلَی الاِبْنَۃِ ، وَلَمْ یُعْطِ الْمَوَالِی شَیْئًا۔","Sahih","Musannaf Ibn Abi Shaybah 31809","","","كتاب الفرائض"
"31810","(۳۱۸۱۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ مَیْسَرَۃَ ، عَنْ إبْرَاہِیمَ : أَنَّہُ أَنْکَرَ حَدِیثَ ابْنَۃِ حَمْزَۃَ ، وَقَالَ : إنَّمَا أَطْعَمَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ طُعْمَۃً۔","","Musannaf Ibn Abi Shaybah 31810","","","كتاب الفرائض"
"31811","(۳۱۸۱۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : أَوْصَی مَوْلًی لِعَلْقَمَۃَ لأَہْلِ عَلْقَمَۃَ بِالثُّلُثِ ، وَأَعْطَی ابْنَ أَخِیہِ لأُمِّہِ الثُّلُثَیْنِ۔","","Musannaf Ibn Abi Shaybah 31811","","","كتاب الفرائض"
"31812","(۳۱۸۱۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ سَالِمٍ ، قَالَ : أُتِیَ عَلِیٌّ فِی رَجُلٍ تَرَکَ جَدَّتَہُ وَمَوَالِیَہُ ، فَأَعْطَی الْجَدَّۃَ الْمَالَ دُونَ الْمَوَالِی۔","Sahih","Musannaf Ibn Abi Shaybah 31812","","","كتاب الفرائض"
"31813","(۳۱۸۱۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کُنْتُ أَمْشِی مَعَہُ فَأَدْرَکَتْہُ امْرَأَۃٌ عِنْدَ الصَّیَاقِلَۃِ ، قَالَتْ : إنَّ مَوْلاَتَکَ قَدْ مَاتَتْ فَخُذْ مِیرَاثَہَا ، قَالَ : ہُوَ لَک ، فَقَالَتْ : بَارَکَ اللَّہُ لَک فِیہِ ، قَالَ : أَمَا إِنَّہُ لَوْ کَانَ لِی لَمْ أَدَعْہُ لَک ، وَإِنَّہُ لَمُحْتَاجٌ یَوْمَئِذٍ إلَی تَوْرٍ یُصِیبہُ مِنْ مِیرَاثِہَا ، مِنْ خَمْسَۃِ دَرَاہِمَ ، فَقُلْتُ لَہُ : مَا ہَذِہِ مِنْہَا : قَالَ : ابْنَۃُ أُخْتِہَا لأُمِّہَا۔","","Musannaf Ibn Abi Shaybah 31813","","","كتاب الفرائض"
"31814","(۳۱۸۱۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : أُتِیَ ابْنُ مَسْعُودٍ فِی أُمٍّ وَإِخْوَۃٍ لأُمٍّ ، فَأَعْطَی الإِخْوَۃَ لِلأُمِّ الثُّلُثَ ، وَأَعْطَی الأُمَّ سَائِرَ الْمَالِ ، وَقَالَ : الأُمُّ عَصَبَۃُ مَنْ لاَ عَصَبَۃَ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 31814","","","كتاب الفرائض"
"31815","(۳۱۸۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن مَسْرُوقٍ ، قَالَ : أُتِیَ عَبْدُ اللہِ فِی أُمٍّ وَإِخْوَۃٍ لأُمٍ ، فَأَعْطَی الأُمَّ السُّدُسَ وَالإِخْوَۃَ الثُّلُثَ ، وَرَدَّ مَا بَقِیَ عَلَی الأُمِّ ، وَقَالَ : الأُمُّ عَصَبَۃُ مَنْ لاَ عَصَبَۃَ لَہُ، وَکَانَ ابْنُ مَسْعُودٍ لاَ یَرُدُّ عَلَی أُخْتٍ لأَبٍ مَعَ أُخْتٍ لأَبٍ وَأَمٍ، وَلاَ عَلَی ابْنَۃِ ابْنٍ مَعَ ابْنَۃِ صُلْبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31815","","","كتاب الفرائض"
"31816","(۳۱۸۱۶) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ وَالأَعْمَشِ ، عَنْ إبْرَاہِیمَ : أَنَّ عَلِیًّا کَانَ یَرُدُّ عَلَی کُلِّ ذِی سَہْمٍ إلاَّ الزَّوْجَ وَالْمَرْأَۃَ۔","","Musannaf Ibn Abi Shaybah 31816","","","كتاب الفرائض"
"31817","(۳۱۸۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، قَالَ : بَلَغَنِی عَنْ عَلِیٍّ أَنَّہُ کَانَ یَرُدُّ عَلَی کُلِّ ذِی سَہْمٍ إلاَّ الزَّوْجَ وَالْمَرْأَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 31817","","","كتاب الفرائض"
"31818","(۳۱۸۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ : أَنَّ عَلِیًّا کَانَ یَرُدُّ عَلَی ذَوِی السِّہَامِ مِنْ ذَوِی الأَرْحَامِ۔","Da'if","Musannaf Ibn Abi Shaybah 31818","","","كتاب الفرائض"
"31819","(۳۱۸۱۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ : أَنَّہُ ذُکِرَ عِنْدَہُ قَضَائً قَضَی بِہِ أَبُو عُبَیْدَۃَ بْنُ عَبْدِ اللہِ : أَنَّہُ أَعْطَی ابْنَۃً أِوْ أُخْتِاً الْمَالَ کُلَّہُ ، فَقَالَ الشَّعْبِیُّ : ہَذَا قَضَائُ عَبْدِ اللہِ۔","","Musannaf Ibn Abi Shaybah 31819","","","كتاب الفرائض"
"31820","(۳۱۸۲۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ إسْمَاعِیلَ ، عَنْ عَامِرٍ ، عَنْ عَبْدِ اللہِ : أَنَّہُ کَانَ یَرُدُّ عَلَی الاِبْنَۃِ وَالأُخْتِ وَالأُمِّ إذَا لَمْ تَکُنْ عَصَبَۃٌ ، وَکَانَ زَیْدٌ لاَ یُعْطِیہِمْ إلاَّ نَصِیبَہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 31820","","","كتاب الفرائض"
"31821","(۳۱۸۲۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ لاَ یَرُدُّ عَلَی سِتَّۃٍ : عَلَی زَوْجٍ ، وَلاَ امْرَأَۃٍ ، وَلاَ جَدَّۃٍ ، وَلاَ عَلَی أَخَوَاتٍ لأَبٍ مَعَ أَخَوَاتٍ لأَبٍ وَأَمٍ ، وَلاَ عَلَی بَنَاتِ ابْنٍ مَعَ بَنَاتِ صُلْبٍ ، وَلاَ عَلَی أُخْتٍ لأُمٍّ مَعَ أُمٍّ ، قَالَ إبْرَاہِیمُ : فَقُلْتُ لِعَلْقَمَۃَ یُرَدُّ عَلَی الأُخْوَۃِ مِنَ الأُمِّ مَعَ الْجَدَّۃِ ، قَالَ : إنْ شِئْت ، قَالَ : وَکَانَ عَلِیٌّ یَرُدُّ عَلَی جَمِیعِہِمْ إلاَّ الزَّوْجَ وَالْمَرْأَۃَ۔","","Musannaf Ibn Abi Shaybah 31821","","","كتاب الفرائض"
"31822","(۳۱۸۲۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ لاَ یَرُدُّ عَلَی سِتَّۃٍ : لاَ یَرُدُّ عَلَی زَوْجٍ ، وَلاَ امْرَأَۃٍ ، وَلاَ جَدَّۃٍ ، وَلاَ عَلَی أُخْتٍ لأَبٍ مَعَ أُخْتٍ لأَبٍ وَأَمٍ ، وَلاَ عَلَی أُخْتٍ لأُمٍّ مَعَ أُمٍ ، وَلاَ عَلَی ابْنَۃِ ابْنٍ مَعَ ابْنَۃِ صُلْبٍ۔","","Musannaf Ibn Abi Shaybah 31822","","","كتاب الفرائض"
"31823","(۳۱۸۲۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : اُسْتُشْہِدَ سَالِمٌ مَوْلَی أَبِی حُذَیْفَۃَ ، قَالَ : فَأَعْطَی أَبُو بَکْرٍ ابْنَتَہُ النِّصْفَ وَأَعْطَی النِّصْفَ الثَّانِی فِی سَبِیلِ اللہِ۔","","Musannaf Ibn Abi Shaybah 31823","","","كتاب الفرائض"
"31824","(۳۱۸۲۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلِ بْنِ عَمْرٍو ، قَالَ : قَالَ إبْرَاہِیمُ : لَمْ یَکُنْ أَحَدٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَرُدُّ عَلَی الْمَرْأَۃِ وَالزَّوْجِ شَیْئًا ، قَالَ : وَکَانَ زَیْدٌ یُعْطِی کُلَّ ذِی فَرْضٍ فَرِیضَتَہُ، وَمَا بَقِیَ جَعَلَہُ فِی بَیْتِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 31824","","","كتاب الفرائض"
"31825","(۳۱۸۲۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ لاَ یَرُدُّ عَلَی أُخْتٍ لأَبٍ مَعَ أُخْتٍ لأَبٍ وَأَمٍّ ، وَلاَ یَرُدُّ عَلَی ابْنَۃِ ابْنٍ مَعَ ابْنَۃٍ شَیْئًا ، وَلاَ عَلَی إخْوَۃٍ لأُمٍّ مَعَ أُمٍّ شَیْئًا ، وَلاَ عَلَی زَوْجٍ ، وَلاَ امْرَأَۃٍ۔","","Musannaf Ibn Abi Shaybah 31825","","","كتاب الفرائض"
"31826","(۳۱۸۲۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ وَالأَعْمَشِ ، قَالاَ : لَمْ یَکُنْ أَحَدٌ یَرُدُّ عَلَی جَدَّۃٍ إلاَّ أَنْ یَکُونَ غَیْرَہَا۔","","Musannaf Ibn Abi Shaybah 31826","","","كتاب الفرائض"
"31827","(۳۱۸۲۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ عَنِ الْعَمَّۃِ : أَہِیَ أَحَقُّ بِالْمِیرَاثِ ، أَو ابْنَۃُ الأَخِ ؟ قَالَ : فَقَالَ لِی : وَأَنْتَ لاَ تَعْلَمُ ذَلِکَ ، قَالَ : قُلْتُ : ابْنَۃُ الأَخِ أَحَقُّ مِنَ الْعَمَّۃِ ، قَالَ أَبُو إِسْحَاقَ : وَشَہِدَ عَامِرٌ عَلَی مَسْرُوقٍ أَنَّہُ قَالَ : أَنْزِلُوہُمْ مَنَازِلَ آبَائِہِمْ۔","","Musannaf Ibn Abi Shaybah 31827","","","كتاب الفرائض"
"31828","(۳۱۸۲۸) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنِ الشَّیْبَانِیِّ، عَنِ الشَّعْبِیِّ، عَنِ مَسْرُوقٍ، قَالَ: أَنْزِلُوا ذَوِی الأَرْحَامِ مَنَازِلَ آبَائِہِمْ۔","","Musannaf Ibn Abi Shaybah 31828","","","كتاب الفرائض"
"31829","(۳۱۸۲۹) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنِ الشَّیْبَانِیِّ، عَنِ الشَّعْبِیِّ: فِی ابْنَۃِ أَخٍ وَعَمَّۃٍ، قَالَ: الْمَالُ لاِبْنَۃِ الأَخِ۔","","Musannaf Ibn Abi Shaybah 31829","","","كتاب الفرائض"
"31830","(۳۱۸۳۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ إبْرَاہِیمَ ، قَالَ : الْمَالُ لِلْعَمَّۃِ۔","","Musannaf Ibn Abi Shaybah 31830","","","كتاب الفرائض"
"31831","(۳۱۸۳۱) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ مُغِیرَۃَ وَمَنْصُورٍ، عَنْ إبْرَاہِیمَ، قَالَ: کَانُوا یُوَرَّثُونَ بِقَدْرِ أَرْحَامِہِمْ۔","","Musannaf Ibn Abi Shaybah 31831","","","كتاب الفرائض"
"31832","(۳۱۸۳۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ عَنِ ابْنَۃِ أَخٍ وَعَمَّۃٍ أَیُّہُمَا أَحَقُّ بِالْمِیرَاثِ ؟ قَالَ : ابْنَۃُ الأَخِ ، قَالَ : أَنْزِلُوہُمْ مَنَازِلَ آبَائِہِمْ۔","","Musannaf Ibn Abi Shaybah 31832","","","كتاب الفرائض"
"31833","(۳۱۸۳۳) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، قَالَ : قَالَ إبْرَاہِیمُ : قَالَ عَلِیٌّ : لاَ یُضْرَبُ بِسَہْمِ مَنْ لاَ یَرِثُ۔","","Musannaf Ibn Abi Shaybah 31833","","","كتاب الفرائض"
"31834","(۳۱۸۳۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُقَالَ : ذُو السَّہْمِ أَحَقُّ مِمَّنْ لاَ سَہْمَ لَہُ","","Musannaf Ibn Abi Shaybah 31834","","","كتاب الفرائض"
"31835","(۳۱۸۳۵) قَالَ وَکِیعٌ : وَقَالَ غَیْرُ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ مَاتَ وَتَرَکَ أُخْتَیْنِ لأَبٍ وَأُخْتَیْنِ لأَبٍ وَأَمٍّ ، قَالَ : کَانَ یُقَالَ : ذُو السَّہْمِ أَحَقُّ مِمَّنْ لاَ سَہْمَ لَہُ۔","","Musannaf Ibn Abi Shaybah 31835","","","كتاب الفرائض"
"31836","(۳۱۸۳۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی امْرَأَۃٍ مُسْلِمَۃٍ تَرَکَتْ زَوْجَہَا مُسْلِمًا وَإِخْوَتَہَا لأُمِّہَا مُسْلِمِینَ وَلَہَا ابْنٌ نَصْرَانِیٌّ ، أَوْ یَہُودِیٌّ ، أَوْ کَافِرٌ ، فَلِزَوْجِہَا النِّصْفُ ثَلاَثَۃُ أَسْہُمٍ وَلاِِخْوَتِہَا لأُمِّہَا الثُّلُثُ سَہْمَانِ ، وَمَا بَقِیَ فَلِذِی الْعَصَبَۃِ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ ، وَلاَ یَرِثُ یَہُودِیٌّ ، وَلاَ نَصْرَانِیٌّ مُسْلِمًا، وَقَضَی فِیہَا عَبْدُ اللہِ : أَنَّ لِلزَّوْجِ الرُّبْعَ مِنْ أَجْلِ أَنَّ لَہَا وَلَدًا کَافِرًا ، وَہُمْ یَحْجِبُونَ فِی قَوْلِ عَبْدِ اللہِ ، وَلاَ یَرِثُونَ ، وَفِی قَوْلِ عَلِیٍّ وَزَیْدٍ : لاَ یَحْجُبُونَ وَلاَ یَرِثُونَ ، قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ مِنْ سِتَّۃِ أَسْہُمٍ ، وَفِی قَوْلِ عَبْدِ اللہِ بْنِ مَسْعُودٍ مِنْ أَرْبَعَۃٍ۔","","Musannaf Ibn Abi Shaybah 31836","","","كتاب الفرائض"
"31837","(۳۱۸۳۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، قَالَ : قَالَ إبْرَاہِیمُ فِی امْرَأَۃٍ مُسْلِمَۃٍ تَرَکَتْ أُمَّہَا مُسْلِمَۃً وَلَہَا إخْوَۃٌ نَصَارَی أَوْ یَہُودٌ ، أَوْ کُفَّارٌ ، فَقَضَی عَبْدُ اللہِ : أَنَّ لَہَا مَعَہُمَ السُّدُسَ ، وَجَعَلَہُمْ یَحْجُبُونَ وَلاَ یَرِثُونَ ، وَقَضَی فِیہَا سَائِرُ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَنَّہُمْ لاَ یَحْجُبُونَ وَلاَ یَرِثُونَ۔n قَالَ أَبُو بَکْرٍ : فَہِیَ فِیمَا قَضَی سَائِرُ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ غَیْرُ عَبْدِ اللہِ مِنْ أَرْبَعَۃِ أَسْہُمٍ ، فَہِیَ لِذِی الْعَصَبَۃِ ، وَہِیَ فِی قَضَائِ عَبْدِ اللہِ : مِنْ خَمْسَۃُ أَسْہُمٍ ، فَہِیَ لِذِی الْعَصَبَۃِ بِالرَّحِمِ۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِہِمْ جَمِیعًا مِنْ سِتَّۃِ أَسْہُمٍ ، إنْ کَانَ فِی قَوْلِ عَبْدِ اللہِ : فَلِلأُمِّ السُّدُسُ وَیَبْقَی خَمْسَۃٌ ، وَإِنْ کَانَ فِی قَوْلِ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فَلِلأُمِّ الثُّلُثُ وَہُوَ سَہْمَانِ ، وَأَرْبَعَۃٌ لِسَائِرِ الْعَصَبَۃِ۔","","Musannaf Ibn Abi Shaybah 31837","","","كتاب الفرائض"
"31838","(۳۱۸۳۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، قَالَ : قَالَ إبْرَاہِیمُ : فِی امْرَأَۃٍ تَرَکَتْ زَوْجَہَا وَإِخْوَتَہَا لأُمِّہَا أَحْرَارًا ، وَلَہَا ابْنٌ مَمْلُوکٌ : فَلِزَوْجِہَا النِّصْفُ ثَلاَثَۃُ أَسْہُمٍ ، وَلإِخْوَتِہَا لأُمِّہَا الثُّلُثُ سَہْمَانِ ، وَیَبْقَی السُّدُسُ فَہُوَ لِلْعَصَبَۃِ ، وَلاَ یَرِثُ ابْنُہَا الْمَمْلُوکُ شَیْئًا فِی قَضَائِ عَلِی۔n وَقَضَی فِیہَا عَبْدُ اللہِ : أَنَّ لِزَوْجِہَا الرُّبْعَ سَہْم وَنِصْف ، وَأَنَّ ابْنَہَا یَحْجُبُ الإِخْوَۃَ مِنَ الأُمِّ إذَا کَانَ مَمْلُوکًا، وَلاَ یَرِثُ ابْنُہَا شَیْئًا وَیَحْجُبُ الزَّوْجَ ، وَأَنَّ الثَّلاَثَۃَ أَرْبَاعٍ الْبَاقِیَۃِ لِلْعَصَبَۃِ۔n وَقَضَی فِیہَا زَیْدٌ : أَنَّ لِزَوْجِہَا النِّصْفَ ثَلاَثَۃَ أَسْہُمٍ ، وَأَنَّ لاِِخْوَتِہَا لأُمِّہَا الثُّلُثَ سَہْمَانِ ، وَمَا بَقِیَ فَہُوَ فِی بَیْتِ الْمَالِ إذَا لَمْ یَکُنْ ، وَلاَئٌ ، وَلاَ رَحِمٌn قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ مِنْ سِتَّۃِ أَسْہُمٍ ، وَفِی قَوْلِ عَبْدِ اللہِ بْنِ مَسْعُودٍ مِنْ أَرْبَعَۃِ أَسْہُمٍ۔","","Musannaf Ibn Abi Shaybah 31838","","","كتاب الفرائض"
"31839","(۳۱۸۳۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ جُرَیْج ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الْفَرَائِضُ لاَ تَعُولُ۔","","Musannaf Ibn Abi Shaybah 31839","","","كتاب الفرائض"
"31840","(۳۱۸۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلِیٍّ وَعَبْدِ اللہِ وَزَیْدٍ : أَنَّہُمْ أَعَالُوا الْفَرِیضَۃَ۔","","Musannaf Ibn Abi Shaybah 31840","","","كتاب الفرائض"
"31841","(۳۱۸۴۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ : فِی أُخْتَیْنِ لأَبٍ وَأَمٍّ ، وَأُخْتَیْنِ لأُمٍّ ، وَزَوْجٍ ، وَأَمٍّ ، قَالَ : مِنْ عَشَرَۃٍ ، لِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ أَرْبَعَۃٌ ، وَلِلأُخْتَیْنِ مِنَ الأُمّ سَہْمَانِ ، وَلِلزَّوْجِ ثَلاَثَۃُ أَسْہُمٍ ، وَلِلأُمِّ سَہْمٌ۔n وَقَالَ وَکِیعٌ : وَالنَّاسُ عَلَی ہَذَا ، وَہَذِہِ قِسْمَۃُ ابْن الْفَرُّوخِ۔","","Musannaf Ibn Abi Shaybah 31841","","","كتاب الفرائض"
"31842","(۳۱۸۴۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یَحْجُبُنِی بَنُو بَنِیَّ دُونَ إخْوَتِی ، وَلاَ أَحْجُبُہُمْ دُونَ إخْوَتِہِمْ۔","","Musannaf Ibn Abi Shaybah 31842","","","كتاب الفرائض"
"31843","(۳۱۸۴۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی امْرَأَۃٍ تَرَکَتْ أُخْتَہَا لأُمِّہَا وَأُمَّہَا ، وَلاَ عَصَبَۃَ لَہَا ، فَلأُخْتِہَا مِنْ أُمِّہَا السُّدُسُ ، وَلأُمِّہَا خَمْسَۃُ أَسْدَاسٍ فِی قَضَائِ عَبْدِ اللہِ ، وَقَضَی فِیہَا زَیْدٌ : أَنَّ لأُخْتِہَا مِنْ أُمِّہَا السُّدُسَ ، وَلأُمِّہَا الثُّلُثَ ، وَیَجْعَلُ سَائِرَہُ فِی بَیْتِ الْمَالِ ، وَقَضَی فِیہَا عَلَیَّ : أَنَّ لَہُمَا الْمَالَ عَلَی قَدْرِ مَا وَرِثَا ، فَجَعَلَ لِلأُخْتِ مِنَ الأُمِّ الثُّلُثَ وَلِلأُمِّ الثُّلُثَیْنِ۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ عَلِیٍّ مِنْ ثَلاَثَۃِ أَسْہُمٍ ، وَفِی قَوْلِ عَبْدِ اللہِ وَزَیْدٍ مِنْ سِتَّۃٍ۔","","Musannaf Ibn Abi Shaybah 31843","","","كتاب الفرائض"
"31844","(۳۱۸۴۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، قَالَ : قَالَ إبْرَاہِیمُ فِی امْرَأَۃٍ تَرَکَتْ أُخْتَہَا لأَبِیہَا وَأُمَّہَا وَأُخْتَہَا مِنْ أَبِیہَا ، وَلاَ عَصَبَۃَ لَہَا غَیْرُہُمَا : فَلأُخْتِہَا لأَبِیہَا وَأُمِّہَا ثَلاَثَۃُ أَرْبَاعٍ ، وَلأُخْتِہَا مِنْ أَبِیہَا الرُّبْعُ فِی قَضَائِ عَلِی ، وَقَضَی عَبْدُ اللہِ : أَنَّ لِلأُخْتِ مِنَ الأَبِ وَالأُمِّ خَمْسَۃَ أَسْہُمٍ ، وَلِلأُخْتِ مِنَ الأَبِ السُّدُسُ ، وَقَضَی فِیہَا زَیْدٌ : أَنَّ لِلأُخْتِ لِلأَبِ وَالأُمِّ ثَلاَثَۃَ أَسْہُمٍ وَلِلأُخْتِ لِلأَبِ السُّدُسَ ، وَمَا بَقِیَ لِبَیْتِ الْمَالِ إذَا لَمْ یَکُنْ وَلاَئٌ وَلاَ عَصَبَۃٌ۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ عَلِیٍّ مِنْ ثَلاَثَۃِ أَسْہُمٍ ، وَفِی قَوْلِ عَبْدِ اللہِ وَزَیْدٍ مِنْ سِتَّۃِ أَسْہُمٍ۔","","Musannaf Ibn Abi Shaybah 31844","","","كتاب الفرائض"
"31845","(۳۱۸۴۵) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، قَالَ : قَالَ إبْرَاہِیمُ فِی امْرَأَۃٍ تَرَکَتِ ابْنَتَہَا وَابْنَۃَ ابْنِہَا وَأُمَّہَا، وَلاَ عَصَبَۃَ لَہَا : فَلاِبْنَتِہَا ثَلاَثَۃُ أَخْمَاسٍ ، وَلاِبْنَۃِ ابْنِہَا خُمُسٌ ، وَلأُمِّہَا خُمُسٌ فِی قَضَائِ عَلِی ، وَقَضَی فِیہَا عَبْدُ اللہِ : أَنَّہَا مِنْ أَرْبَعَۃٍ وَعِشْرِینَ سَہْمًا : فَلاِبْنَۃِ الاِبْنِ مِنْ ذَلِکَ السُّدُسُ أَرْبَعَۃُ أَسْہُمٍ ، وَلِلأُمِّ رُبْعُ مَا بَقِیَ خَمْسَۃُ أَسْہُمٍ ، وَلِلاِبْنَۃِ ثَلاَثَۃُ أَرْبَاعِ عِشْرِینَ : خَمْسَۃَ عَشَرَ سَہْمًا ، وَقَضَی فِیہَا زَیْدٌ : لِلاِبْنَۃِ النِّصْفُ وَلاِبْنَۃِ الاِبْنِ السُّدُسُ وَلِلأُمِّ السُّدُسُ ، وَمَا بَقِیَ فَفِی بَیْتِ الْمَالِ إذَا لَمْ یَکُنْ وَلاَئٌ وَلاَ عَصَبَۃٌ۔","","Musannaf Ibn Abi Shaybah 31845","","","كتاب الفرائض"
"31846","(۳۱۸۴۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ بْنِ عَمْرو ، قَالَ : قَالَ إبْرَاہِیمُ : یَرِثُ مِنَ النِّسَائِ سِتُّ نِسْوَۃٍ : الاِبْنَۃُ، وَابْنَۃُ الاِبْنِ، وَالأُمُّ، وَالْجَدَّۃُ، وَالأُخْتُ، وَالْمَرْأَۃُ، وَیَرِثُ النِّسَائُ مِنَ الرِّجَالِ سَبْعَۃَ نَفَرٍ: تَرِثُ أَبَاہَا، وَابْنَہَا، وَابْنَ ابْنِہَا، وَأَخَاہَا، وَزَوْجَہَا، وَجَدَّہَا، وَتَرِثُ مِنَ ابْنِ ابْنَتِہَا سُدُسًا إلاَّ أَنْ یَکُونَ لَہُ عَصَبَۃٌ غَیْرُہَا۔","","Musannaf Ibn Abi Shaybah 31846","","","كتاب الفرائض"
"31847","(۳۱۸۴۷) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا مِنْدَلٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ: یَرِثُ الرَّجُلُ سِتُّ نِسْوَۃٍ: ابْنَتَہُ ، وَابْنَۃَ ابْنِہِ ، وَأُمَّہُ ، وَجَدَّتَہُ ، وَأُخْتَہ ، وَزَوْجَتَہُ ، وَتَرِثُ الْمَرْأَۃُ سَبْعَۃ نَفَرٍ : ابْنَہَا ، وَابْنَ ابْنِہَا ، وَأَبَاہَا ، وَجَدَّہَا ، وَزَوْجَہَا ، وَأَخَاہَا ، وَتَرِثُ مِنَ ابْنِ ابْنَتِہَا سُدُسًا ، وَلاَ یَرِثُ ہُوَ مِنْہَا شَیْئًا فِی قَوْلِہِمْ کُلِّہِمْ۔","","Musannaf Ibn Abi Shaybah 31847","","","كتاب الفرائض"
"31848","(۳۱۸۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ النُّعْمَانِ بْنِ سَالِمٍ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنِ ابْنِ ابْنَۃٍ : أَرَأَیْت رَجُلاً تَرَکَ ابْنِ ابْنَتہ ، أَیَرِثہُ ؟ قَالَ : لا۔","Sahih","Musannaf Ibn Abi Shaybah 31848","","","كتاب الفرائض"
"31849","(۳۱۸۴۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ مِنْدَلٍ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، قَالَ : فِی قَوْلِ عَلِیٍّ وَزَیْدٍ : ابْنُ الاِبْنِ یُرَدُّ عَلَی مَنْ تَحْتَہُ وَمَنْ فَوْقَہُ لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ ، وَفِی قَوْلِ عَبْدِ اللہِ : إذَا اسْتَکْمَلَ الثُّلُثَیْنِ فَلَیْسَ لِبَنَاتِ الاِبْنِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 31849","","","كتاب الفرائض"
"31850","(۳۱۸۵۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا مِنْدَلٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ فِی قَوْلِ عَبْدِ اللہِ : لِلاِبْنَۃِ النِّصْفُ ، وَمَا بَقِیَ لِبَنِی الاِبْنِ وَبَنَاتِ الاِبْنِ : لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ ، مَا لَمْ یَزِدْنَ بَنَاتُ الاِبْنِ عَلَی السُّدُسِ۔","","Musannaf Ibn Abi Shaybah 31850","","","كتاب الفرائض"
"31851","(۳۱۸۵۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا مِنْدَلٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یَرِثُ الإِخْوَۃُ مِنَ الأُمِّ مَعَ وَلَدٍ ، وَلاَ وَلَدَ ابْنٍ ذَکَرٍ وَلاَ أُنْثَی ، وَلاَ مَعَ أَبٍ ، وَلاَ مَعَ جَدٍّ۔","","Musannaf Ibn Abi Shaybah 31851","","","كتاب الفرائض"
"31852","(۳۱۸۵۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ رَجُلٍ لَمْ یُسَمِّہِ ، قَالَ : مَا رَأَیْت رَجُلاً کَانَ أَحْسَبُ مِنْ عَلِیٍّ سُئِلَ عَنِ ابْنَتَیْنِ وَأَبَوَیْنِ وَامْرَأَۃٍ ، فَقَالَ : صَارَ ثَمَنُہَا تُسُعًا۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ مِنْ سَبْعَۃٍ وَعِشْرِینَ سَہْمًا : لِلاِبْنَتَیْنِ سِتَّۃَ عَشَرَ ، وَلِلأَبَوَیْنِ ثَمَانِیَۃٌ وَلِلْمَرْأَۃِ ثَلاَثَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 31852","","","كتاب الفرائض"
"31853","(۳۱۸۵۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ خَالِدٍ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ : أَنَّ أَبَا بَکْرٍ کَانَ یَرَی الْجَدَّ أَبًا۔","Sahih","Musannaf Ibn Abi Shaybah 31853","","","كتاب الفرائض"
"31854","(۳۱۸۵۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ کُرْدُوسِ بْنِ عَبَّاسٍ الثَّعْلبِیِّ ، عَنْ أَبِی مُوسَی : أَنَّ أَبَا بَکْرٍ جَعَلَ الْجَدَّ أَبًا۔","Hasan","Musannaf Ibn Abi Shaybah 31854","","","كتاب الفرائض"
"31855","(۳۱۸۵۵) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : قَالَ ابْنُ الزُّبَیْرِ : إنَّ الَّذِی قَالَ فِیہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْ کُنْت مُتَّخِذًا خَلِیلاً لاَتَّخَذْتہ خَلِیلاً جَعَلَ الْجَدَّ أَبًا۔ یَعْنِی : أَبَا بَکْرٍ۔n(بخاری ۳۶۵۸۔ احمد ۴)","Sahih","Musannaf Ibn Abi Shaybah 31855","","","كتاب الفرائض"
"31856","(۳۱۸۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ فُرَاتٍ الْقَزَّازِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : کَتَبَ ابْنُ الزُّبَیْرِ إلَی عَبْدِ اللہِ بْنِ عُتْبَۃَ : إنَّ أَبَا بَکْرٍ کَانَ یَجْعَلُ الْجَدَّ أَبًا۔ (احمد ۴۔ ابویعلی ۶۷۷۲)","Sahih","Musannaf Ibn Abi Shaybah 31856","","","كتاب الفرائض"
"31857","(۳۱۸۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ خَالِدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ مَعْقِلٍ ، قَالَ : کُنْتُ عِنْدَ ابْنِ عَبَّاسٍ فَسَأَلَہُ رَجُلٌ عَنِ الْجَدِّ ؟ فَقَالَ لَہُ ابْنُ عَبَّاسٍ : أَیُّ أَبٍ لَک أَکْبَرُ ؟ فَلَمْ یَدْرِ الرَّجُلُ مَا یَقُولُ ، فَقُلْتُ أَنَا : آدَم ، فَقَالَ ابْنُ عَبَّاسٍ : إنَّ اللَّہَ یَقُولُ : یَا بَنِی آدَمَ۔","Hasan","Musannaf Ibn Abi Shaybah 31857","","","كتاب الفرائض"
"31858","(۳۱۸۵۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنْ أَبِی بَکْرٍ وَابْنِ عَبَّاسٍ وَعُثْمَانَ : أَنَّہُمْ جَعَلُوا الْجَدَّ أَبًا۔","Da'if","Musannaf Ibn Abi Shaybah 31858","","","كتاب الفرائض"
"31859","(۳۱۸۵۹) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّہُ جَعَلَہُ أَبًا۔","Hasan","Musannaf Ibn Abi Shaybah 31859","","","كتاب الفرائض"
"31860","(۳۱۸۶۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنِ الزُّہْرِیِّ ، عَنْ قَبِیصَۃَ بْنِ ذُؤَیْبٍ : أَنَّ عُمَرَ کَانَ یَفْرِضُ لِلْجَدِّ الَّذِی یَفْرِضُ لَہُ النَّاسُ الْیَوْمَ ، قُلْتُ لَہُ : یَعْنِی : قَوْلَ زَیْدِ بْنِ ثَابِتٍ ؟ قَالَ : نَعَمْ۔","Sahih","Musannaf Ibn Abi Shaybah 31860","","","كتاب الفرائض"
"31861","(۳۱۸۶۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنْ عَطَائٍ ، عَنْ أَبِی بَکْرٍ ، قَالَ : الْجَدُّ بِمَنْزِلَۃِ الأَبِ مَا لَمْ یَکُنْ أَبٌ دُونَہُ ، وَابْنُ الاِبْنِ بِمَنْزِلِہِ الاِبْنِ مَا لَمْ یَکُنَ ابْنٌ دُونَہُ۔","","Musannaf Ibn Abi Shaybah 31861","","","كتاب الفرائض"
"31862","(۳۱۸۶۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ إسْمَاعِیلَ بْنِ سُمَیْعٍ ، قَالَ : قَالَ رَجُلٌ لأَبِی وَائِلٍ : إنَّ أَبَا بُرْدَۃَ یَزْعُمُ أَنَّ أَبَا بَکْرٍ جَعَلَ الْجَدَّ أَبًا ؟ فَقَالَ : کَذَبَ ، لَوْ جَعَلَہُ أَبًا لَمَا خَالَفَہُ عُمَرُ۔","","Musannaf Ibn Abi Shaybah 31862","","","كتاب الفرائض"
"31863","(۳۱۸۶۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا ہِمَّامٌ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ : أَنَّ رَجُلاً أَتَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنَّ ابْنَ ابْنِی مَاتَ فَمَا لِی مِنْ مِیرَاثِہِ ؟ قَالَ : لَکَ السُّدُسُ ، فَلَمَّا أَدْبَرَ دَعَاہُ ، قَالَ : لَک سُدُسٌ آخَرُ ، فَلَمَّا أَدْبَرَ دَعَاہُ ، قَالَ : إنَّ السُّدُسَ الآخَر طُعْمَۃٌ۔n(ابوداؤد ۲۸۸۸۔ احمد ۴۲۸)","Hasan","Musannaf Ibn Abi Shaybah 31863","","","كتاب الفرائض"
"31864","(۳۱۸۶۴) حَدَّثَنَا شَبَابَۃُ ، عَنْ یُونُسَ بْنِ أَبِی إِسْحَاقَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، عَنْ مَعْقِلِ بْنِ یَسَارٍ الْمُزَنِیّ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أُتِیَ بِفَرِیضَۃٍ فِیہَا جَدٌّ فَأَعْطَاہُ ثُلُثًا أَوْ سُدُسًا۔ (ابن ماجہ ۶۷۲۲۔ طبرانی ۵۳۶)","Hasan","Musannaf Ibn Abi Shaybah 31864","","","كتاب الفرائض"
"31865","(۳۱۸۶۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّ عُمَرَ ، قَالَ : مَنْ یَعْلَم قَضِیَّۃَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْجَدِّ ؟ فَقَالَ : مَعْقِلُ بْنُ یَسَارٍ الْمُزَنِیّ : فِینَا قَضَی بِہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَا ذَاک ؟ قَالَ : السُّدُسُ ، قَالَ : مَعَ مَنْ ؟ قَالَ لاَ أَدْرِی ، قَالَ : لاَ دَرَیْت ، فَمَا تُغْنِی إذًا۔","Hasan","Musannaf Ibn Abi Shaybah 31865","","","كتاب الفرائض"
"31866","(۳۱۸۶۶) حَدَّثَنَا قَبِیصَۃُ ، عَنْ سُفْیَانَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن عِیَاضٍ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : کُنَّا نُوَرِّثُہُ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ یَعْنِی : الْجَدَّ۔ (ابویعلی ۱۰۹۰)","","Musannaf Ibn Abi Shaybah 31866","","","كتاب الفرائض"
"31867","(۳۱۸۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَلِیٌّ لاَ یَزِیدُ الْجَدَّ مَعَ الْوَلَدِ عَلَی السُّدُسِ۔","","Musannaf Ibn Abi Shaybah 31867","","","كتاب الفرائض"
"31868","(۳۱۸۶۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عُبَیْدِ بْنِ نُضَیْلَۃَ ، قَالَ : کَانَ عُمَرُ وَعَبْدُ اللہِ یُقَاسِمَانِ بِالْجَدِّ مَعَ الإِخْوَۃِ مَا بَیْنَہُ وَبَیْنَ أَنْ یَکُونَ السُّدُسُ خَیْرًا لَہُ مِنْ مُقَاسَمَتِہِمْ ، ثُمَّ إنَّ عُمَرَ کَتَبَ إلَی عَبْدِ اللہِ : مَا أَرَی إلاَّ أَنَّا قَدْ أَجْحَفْنَا بِالْجَدِّ ، فَإِذَا جَائَک کِتَابِی ہَذَا فَقَاسِمِ بِہِ مَعَ الإِخْوَۃِ مَا بَیْنَہُ وَبَیْنَ أَنْ یَکُونَ الثُّلُثُ خَیْرًا لَہُ مِنْ مُقَاسَمَتِہِمْ ، فَأَخَذَ بِہِ عَبْدُ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31868","","","كتاب الفرائض"
"31869","(۳۱۸۶۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : کَانَ عَبْدُ اللہِ یُشَرِّکُ الْجَدَّ مَعَ الإِخْوَۃِ ، فَإِذَا کَثُرُوا وَفَّاہ الثُّلُثَ ، فَلَمَّا تُوُفِّیَ عَلْقَمَۃُ أَتَیْتُ عَبِیدَۃَ ، فَحَدَّثَنِی أَنَّ ابْنَ مَسْعُودٍ کَانَ یُشَرِّکُ الْجَدَّ مَعَ الإِخْوَۃِ ، فَإِذَا کَثُرُوا وَفَّاہُ السُّدُسَ ، فَرَجَعْت مِنْ عِنْدِہِ وَأَنَا خَاثِرٌ۔n فَمَرَرْت بِعُبَیْدِ بْنِ نُضَیْلَۃَ فَقَالَ : مَا لِی أَرَاک خَاثِراً ؟ قَالَ : قُلْتُ : کَیْفَ لاَ أَکُونُ خَاثِرًا ، فَحَدَّثْتہ ، فَقَالَ : صَدَقَاک کِلاَہُمَا ، قُلْتُ : لِلَّہِ أَبُوک وَکَیْفَ صَدَقَانِی کِلاَہُمَا ، قَالَ : کَانَ رَأْیُ عَبْدِ اللہِ وَقِسْمَتُہُ أَنْ یُشَرِّکَہُ مَعَ الإِخْوَۃِ ، فَإِذَا کَثُرُوا وَفَّاہُ السُّدُسَ ، ثُمَّ وَفَدَ إلَی عُمَرَ فَوَجَدَہُ یُشَرِّکُہُ مَعَ الإِخْوَۃِ ، فَإِذَا کَثُرُوا وَفَّاہُ الثُّلُثَ ، فَتَرَکَ رَأْیَہُ وَتَابَعَ عُمَرَ۔","Hasan","Musannaf Ibn Abi Shaybah 31869","","","كتاب الفرائض"
"31870","(۳۱۸۷۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، عَنْ عَلِیٍّ : أَنَّہُ کَانَ یُقَاسِمُ بِالْجَدِّ الإِخْوَۃَ إلَی السُّدُسِ۔","Hasan","Musannaf Ibn Abi Shaybah 31870","","","كتاب الفرائض"
"31871","(۳۱۸۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ : أَنَّہُ أُتِیَ فِی سِتَّۃِ إخْوَۃٍ وَجَدٍّ ، فَأَعْطَی الْجَدَّ السُّدُسَ۔","Sahih","Musannaf Ibn Abi Shaybah 31871","","","كتاب الفرائض"
"31872","(۳۱۸۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ فِرَاسٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَتَبَ ابْنُ عَبَّاسٍ إلَی عَلِیٍّ یَسْأَلُہُ عَنْ سِتَّۃِ إخْوَۃٍ وَجَدٍّ ؟ فَکَتَبَ إلَیْہِ : أَنِ اجْعَلْہُ کَأَحَدِہِمْ ، وَامْحُ کِتَابِی۔","Sahih","Musannaf Ibn Abi Shaybah 31872","","","كتاب الفرائض"
"31873","(۳۱۸۷۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ : أَنَّ زَیْدًا کَانَ یُقَاسِمُ بِالْجَدِّ مَعَ الإِخْوَۃِ مَا بَیْنَہُ وَبَیْنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31873","","","كتاب الفرائض"
"31874","(۳۱۸۷۴) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عُمَرَ وَعَبْدِ اللہِ : أَنَّہُمَا کَانَا یُقَاسِمَانِ الْجَدَّ مَعَ الإِخْوَۃِ مَا بَیْنَہُ وَبَیْنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 31874","","","كتاب الفرائض"
"31875","(۳۱۸۷۵) حَدَّثَنَا حَفْصٌ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ: أَنَّ عَلِیًّا کَانَ یُقَاسِمُ الْجَدَّ مَعَ الإِخْوَۃِ مَا بَیْنَہُ وَبَیْنَ السُّدُسِ۔","","Musannaf Ibn Abi Shaybah 31875","","","كتاب الفرائض"
"31876","(۳۱۸۷۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَتَبَ عُمَرُ إلَی عَبْدِ اللہِ بْنِ مَسْعُودٍ : إنَّا قَدْ خَشِینَا أَنْ نَکُونَ قَدْ أَجْحَفْنَا بِالْجَدِّ ، فَأَعْطِہِ الثُّلُثَ مَعَ الإِخْوَۃِ۔","","Musannaf Ibn Abi Shaybah 31876","","","كتاب الفرائض"
"31877","(۳۱۸۷۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّ زَیْدًا کَانَ یَقُول : یُقَاسَمُ الْجَدَّ مَعَ الْوَاحِدِ وَالاِثْنَیْنِ، فَإِذَا کَانُوا ثَلاَثَۃً کَانَ لَہُ ثُلُثُ جَمِیعِ الْمَالِ ، فَإِنْ کَانَ مَعَہُ فَرَائِضُ نُظِرَ لَہُ ، فَإِنْ کَانَ الثُّلُثُ خَیْرًا لَہُ أُعْطِیَہُ ، وَإِنْ کَانَتِ الْمُقَاسَمَۃُ خَیْرًا لَہُ قَاسَمَ ، وَلاَ یُنْتَقَصُ مِنْ سُدُسِ جَمِیعِ الْمَالِ۔","Hasan","Musannaf Ibn Abi Shaybah 31877","","","كتاب الفرائض"
"31878","(۳۱۸۷۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ وَزَیْدٌ یَجْعَلاَنِ لِلْجَدِّ الثُّلُثَ وَلِلإِخْوَۃِ الثُّلُثَیْنِ ، وَفِی رَجُلٍ تَرَکَ أَرْبَعَۃَ إخْوَۃٍ لأَبِیہِ وَأُمِّہِ وَأُخْتَیْہِ لأَبِیہِ وَأُمِّہِ وَجَدِّہِ ، قَالَ : کَانَ عَلِیٌّ یَجْعَلُہَا أَسْہُمًا أَسْدَاسًا لِلْجَدِّ السُّدُسَ ، لَمْ یَکُنْ عَلِیٌّ یَجْعَلُ لِلْجَدِّ أَقَلَّ مِنَ السُّدُسِ مَعَ الإِخْوَۃِ ، وَمَا بَقِیَ فَلِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ ، وَکَانَ عَبْدُ اللہِ وَزَیْدٌ یُعْطِیَانِ الْجَدَّ الثُّلُثَ وَالإِخْوَۃَ الثُّلُثَیْنِ لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ ، وَقَالَ فِی خَمْسَۃِ إخْوَۃٍ وَجَدٍّ ، قَالَ : فَلِلْجَدِّ فِی قَوْلِ عَلِیٍّ السُّدُسُ ، وَلِلإِخْوَۃِ خَمْسَۃُ أَسْدَاسٍ ، وَکَانَ عَبْدُ اللہِ وَزَیْدٌ یُعْطِیَانِ الْجَدَّ الثُّلُثَ ، وَالإِخْوَۃَ الثُّلُثَیْنِ۔","","Musannaf Ibn Abi Shaybah 31878","","","كتاب الفرائض"
"31879","(۳۱۸۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ مَسْرُوقٍ ، قَالَ : کَانَ ابْنُ مَسْعُودٍ لاَ یَزِیدُ الْجَدَّ عَلَی السُّدُسِ مَعَ الإِخْوَۃِ ، قَالَ : فَقُلْتُ لَہُ : شَہِدْت عُمَرَ بْنَ الْخَطَّابِ أَعْطَاہُ الثُّلُثَ مَعَ الإِخْوَۃِ ، فَأَعْطَاہُ الثُّلُثَ۔","Da'if","Musannaf Ibn Abi Shaybah 31879","","","كتاب الفرائض"
"31880","(۳۱۸۸۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ ، قَالَ : إنَّ أَوَّلَ جَدٍّ ورِّثَ فِی الإسْلاَمِ : عُمَرُ بْنُ الْخَطَّابِ ، فَأَرَادَ أَنْ یَحْتَازَ الْمَالَ ، فَقُلْتُ لَہُ : یَا أَمِیرَ الْمُؤْمِنِینَ ، إنَّہُمْ شَجَرَۃٌ دُونَک۔ یَعْنِی : بَنِی بَنِیہِ۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ عُمَرَ ، وَعَبْدِ اللہِ وَزَیْدٍ مِنْ ثَلاَثَۃِ أَسْہُمٍ ، فَلِلْجَدِّ الثُّلُثُ ، وَمَا بَقِیَ فَلِلإِخْوَۃِ ، وَفِی قَوْلِ عَلِیٍّ مِنْ سِتَّۃِ أَسْہُمٍ : لِلْجَدِّ السُّدُسُ سَہْمٌ ، وَلِلإِخْوَۃِ خَمْسَۃُ أَسْہُمٍ۔","","Musannaf Ibn Abi Shaybah 31880","","","كتاب الفرائض"
"31881","(۳۱۸۸۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ : فِی أُخْتٍ وَجَدٍّ : النِّصْفُ ، وَالنِّصْفُ۔","","Musannaf Ibn Abi Shaybah 31881","","","كتاب الفرائض"
"31882","(۳۱۸۸۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ تَرَکَ جَدَّہُ وَأَخَاہُ لأَبِیہِ وَأُمِّہِ : فَلِلْجَدِّ النِّصْفُ وَلأَخِیہِ النِّصْفُ فِی قَوْلِ عَلِیٍّ وَعَبْدِ اللہِ وَزَیْدٍ ، قَالُوا فِی رَجُلٍ تَرَکَ جَدَّہُ وَإِخْوَیہ لأَبِیہِ وَأُمِّہِ : فَلِلْجَدِّ الثُّلُثُ وَلِلإِخْوَۃِ الثُّلُثَانِ فِی قَوْلِہِمْ جَمِیعًا۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ مِنْ سَہْمَیْنِ إذَا کَانَتْ أُخْتٌ ، أَوْ أَخٌ وَجَدٌّ ، فَلِلْجَدِّ النِّصْفُ ، وَلِلأُخْتِ - أَو الأَخِ - النِّصْفُ ، وَإِنْ کَانَا أَخَوَیْنِ فَلِلْجَدِّ الثُّلُثُ ، وَلِلأَخَوَیْنِ الثُّلُثَانِ۔","","Musannaf Ibn Abi Shaybah 31882","","","كتاب الفرائض"
"31883","(۳۱۸۸۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ تَرَکَ جَدَّہُ ، وَابْنَ أَخِیہِ لأَبِیہِ وَأُمِّہِ : فَلِلْجَدِّ الْمَالُ فِی قَضَائِ عَلِیٍّ ، وَعَبْدِ اللہِ وَزَیْدٍ۔n فَہَذِہِ مِنْ سَہْمٍ وَاحِدٍ وَہُوَ الْمَالُ کُلُّہُ۔","","Musannaf Ibn Abi Shaybah 31883","","","كتاب الفرائض"
"31884","(۳۱۸۸۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ تَرَکَ جَدَّہُ وَأَخَاہُ لأَبِیہِ وَأُمِّہِ وَأَخَاہُ لأَبِیہِ : فَلِلْجَدِّ النِّصْفُ ، وَلأَخِیہِ لأَبِیہِ وَأُمِّہِ النِّصْفُ فِی قَوْلِ عَلِیٍّ وَعَبْدِ اللہِ ، وَکَانَ زَیْدٌ یُعْطِی الْجَدَّ الثُّلُثَ، وَالأَخَ مِنَ الأَبِ وَالأُمِّ الثُّلُثَیْنِ ، قَاسَمَ بِالأَخِ مِنَ الأَبِ مَعَ الأَخِ مِنَ الأَبِ وَالأُمِّ ، وَلاَ یَرِثُ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 31884","","","كتاب الفرائض"
"31885","(۳۱۸۸۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ یُقَاسِمُ بِالْجَدِّ الأُخْوَۃَ إلَی الثُّلُثِ ، وَیُعْطِی کُلَّ صَاحِبِ فَرِیضَۃٍ فَرِیضَتَہُ ، وَلاَ یُوَرِّثُ الأُخْوَۃَ مِنَ الأُمِّ مَعَ الْجَدِّ ، وَلاَ یُقَاسِمُ بِالأُخْوَۃِ لِلأَبِ الأُخْوَۃُ لِلأَبِ وَالأُمِّ مَعَ الْجَدِّ ، وَإِذَا کَانَتْ أُخْتٌ لأَبٍ وَأُمٌّ وَأُخْتٌ لأَبٍ وَجَدٌّ ، أَعْطَی الأُخْتَ مِنَ الأَبِ وَالأُمِّ النِّصْفَ ، وَالْجَدَّ النِّصْفَ۔n وَکَانَ عَلِیٌّ یُقَاسِمُ بِالْجَدِّ الأُخْوَۃَ إلَی السُّدُسِ ، وَیُعْطِی کُلَّ صَاحِبِ فَرِیضَۃٍ فَرِیضَتَہُ ، وَلاَ یُوَرِّثُ الأخْوَۃَ مِنَ الأُمِّ مَعَ الْجَدِّ ، وَلاَ یَزِیدُ الْجَدَّ مَعَ الْوَلَدِ عَلَی السُّدُسِ إلاَّ أَنْ لاَ یَکُونَ غَیْرَہُ ، فَإِذَا کَانَتْ أُخْتٌ لأَبٍ وَأَمٍّ ، وَأَخٌ وَأُخْتٌ لأَبٍ ، وَجَدٌّ ، أَعْطَی الأُخْتَ مِنَ الأَبِ وَالأُمِّ النِّصْفَ ، وَقَاسَمَ بِالأَخِ وَالأُخْتِ الْجَدَّn قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ عَلِیٍّ وَعَبْدِ اللہِ مِنْ سَہْمَیْنِ ، وَفِی قَوْلِ زَیْدٍ مِنْ ثَلاَثَۃِ أَسْہُمٍ۔","","Musannaf Ibn Abi Shaybah 31885","","","كتاب الفرائض"
"31886","(۳۱۸۸۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، قَالَ : أَرَادَ عُبَیْدُ اللہِ بْنُ زِیَادٍ أَنْ یُوَرِّثَ الأُخْتَ مِنَ الأُمِّ مَعَ الْجَدِّ ، وَقَالَ : إنَّ عُمَرَ قَدْ وَرَّثَ الأُخْتَ مَعَہُ ، فَقَالَ عَبْدُ اللہِ بْنُ عُتْبَۃَ : إنِّی لَسْتُ بِسَبَئِیٍّ وَلاَ حَرُورِی ، فَاقْتَفِرِ الأَثَرَ ، فَإِنَّک لَنْ تُخْطِئَ فِی الطَّرِیقِ مَا دُمْت عَلَی الأَثَرِ۔","Sahih","Musannaf Ibn Abi Shaybah 31886","","","كتاب الفرائض"
"31887","(۳۱۸۸۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ ، عَنِ الشَّعْبِیِّ ، قَالَ : مَا وَرَّثَ أَحَدٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إخْوَۃً مِنْ أُمٍّ مَعَ جَدٍّ۔","Sahih","Musannaf Ibn Abi Shaybah 31887","","","كتاب الفرائض"
"31888","(۳۱۸۸۸) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ زَیْدٌ لاَ یُوَرِّثُ أَخًا لأُمٍّ ، وَلاَ أُخْتًا لأُمٍّ مَعَ جَدٍّ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 31888","","","كتاب الفرائض"
"31889","(۳۱۸۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَلِیٌّ وَعَبْدُ اللہِ لاَ یُوَرِّثَانِ الإِخْوَۃَ مِنَ الأُمِّ مَعَ الْجَدِّ شَیْئًا۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ مِنْ سَہْمٍ وَاحِدٍ لأَنَّ الْمَالَ کُلَّہُ لِلْجَدِّ۔","","Musannaf Ibn Abi Shaybah 31889","","","كتاب الفرائض"
"31890","(۳۱۸۹۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ یَجْعَلُ الأَکْدَرِیَّۃَ مِنْ ثَمَانِیَۃٍ : لِلزَّوْجِ ثَلاَثَۃٌ ، وَثَلاَثَۃٌ لِلأُخْتِ ، وَسَہْمٌ لِلأُمِ ، وَسَہْمٌ لِلْجَدِّ۔ قَالَ : وَکَانَ عَلِیٌّ یَجْعَلُہَا مِنْ تِسْعَۃٍ : ثَلاَثَۃٌ لِلزَّوْجِ ، وَثَلاَثَۃٌ لِلأُخْتِ ، وَسَہْمَانِ لِلأُمِّ ، وَسَہْمٌ لِلْجَدِّ۔ وَکَانَ زَیْدٌ یَجْعَلُہَا مِنْ تِسْعَۃٍ : ثَلاَثَۃٌ لِلزَّوْجِ ، وَثَلاَثَۃٌ لِلأُخْتِ ، وَسَہْمَانِ لِلأُمِّ ، وَسَہْمٌ لِلْجَدِّ ، ثُمَّ یَضْرِبُہَا فِی ثَلاَثَۃٍ فَتَصِیرُ سَبْعَۃً وَعِشْرِینَ ، فَیُعْطِی الزَّوْجَ تِسْعَۃً ، وَالأُمَّ سِتَّۃً ، وَیَبْقَی اثْنَا عَشَرَ ، فَیُعْطِی الْجَدَّ ثَمَانِیَۃً ، وَیُعْطِی الأُخْتَ أَرْبَعَۃً۔","","Musannaf Ibn Abi Shaybah 31890","","","كتاب الفرائض"
"31891","(۳۱۸۹۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلِیٍّ وَعَبْدِ اللہِ وَزَیْدٍ بِمِثْلِ حَدِیثِ أَبِی مُعَاوِیَۃَ ، وَزَادَ فِیہِ : وَبَلَغَنِی عَنِ ابْنِ عَبَّاسٍ أَنَّہُ کَانَ یَجْعَلُ الْجَدَّ وَالِدًا ، لاَ یَرِثُ الإِخْوَۃَ مَعَہُ شَیْئًا ، وَیَجْعَلُ لِلزَّوْجِ النِّصْفَ وَلِلْجَدِّ السُّدُسَ : سَہْمٌ ، وَلِلأُمِّ الثُّلُثُ : سَہْمَانِ۔","","Musannaf Ibn Abi Shaybah 31891","","","كتاب الفرائض"
"31892","(۳۱۸۹۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلِیٍّ وَعَبْدِ اللہِ وَزَیْدٍ ، مِثْلَ حَدِیثِ أَبِی مُعَاوِیَۃَ۔","","Musannaf Ibn Abi Shaybah 31892","","","كتاب الفرائض"
"31893","(۳۱۸۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، قَالَ : قُلْتُ لِلأَعْمَشِ : لِمَ سُمِّیَت الأَکْدَرِیَّۃَ ؟ قَالَ : طَرَحَہَا عَبْدُ الْمَلِکِ بْنُ مَرْوَانَ عَلَی رَجُلٍ یُقَالَ لَہُ : الأَکْدَرُ ، کَانَ یَنْظُرُ فِی الْفَرَائِضِ ، فَأَخْطَأَ فِیہَا ، فَسَمَّاہَا الأَکْدَرِیَّۃَ۔n قَالَ وَکِیعٌ : وَکُنَّا نَسْمَعُ قَبْلَ أَنْ یُفَسِّرَ سُفْیَانُ إنَّمَا سُمِّیَتِ الأَکْدَرِیَّۃَ ، لأَنَّ قَوْلَ زَیْدٍ تَکَدَّرَ فِیہَا ، لَمْ یُفَسِّر قَوْلَہُ۔","","Musannaf Ibn Abi Shaybah 31893","","","كتاب الفرائض"
"31894","(۳۱۸۹۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْوَاحِدِ ، عَنْ إسْمَاعِیلَ بْنِ رَجَائٍ ، عَنْ إبْرَاہِیمَ۔ وَعَنْ سُفْیَانَ ، عَمَّنْ سَمِعَ الشَّعْبِیَّ قَالَ فِی أُمٍّ ، وَأُخْتٍ لأَبٍ وَأَمٍّ ، وَجَدٍّ : إنَّ زَیْدَ بْنَ ثَابِتٍ قَالَ : مِنْ تِسْعَۃِ أَسْہُمٍ : لِلأُمِّ ثَلاَثَۃٌ ، وَلِلْجَدِّ أَرْبَعَۃٌ ، وَلِلأُخْتِ سَہْمَانِ۔ وَإِنَّ عَلِیًّا قَالَ : لِلأُخْتِ النِّصْفُ : ثَلاَثَۃٌ ، وَلِلأُمِّ الثُّلُثُ : سَہْمَانِ ، وَمَا بَقِیَ فَلِلْجَدِّ وَہُوَ سَہْمٌ۔ وَقَالَ ابْنُ مَسْعُودٍ : لِلأُخْتِ النِّصْفُ : ثَلاَثَۃٌ ، وَلِلأُمِّ السُّدُسُ : سَہْمٌ ، وَمَا بَقِیَ فَلِلْجَدِّ وَہُوَ سَہْمَانِ۔ وَقَالَ عُثْمَان : أَثْلاَثًا : ثُلُثٌ لِلأُمِ ، وَثُلُثٌ لِلأُخْتِ ، وَثُلُثٌ لِلْجَدِّ ، وَقَالَ ابْنُ عَبَّاسٍ : لِلأُمِّ الثُّلُثُ ، وَمَا بَقِیَ فَلِلْجَدِّ۔n قَالَ وَکِیعٌ : وَقَالَ الشَّعْبِیُّ : سَأَلَنِی الْحَجَّاجُ بْنُ یُوسُفَ عنہا ؟ فَأَخْبَرْتہ بِأَقَاوِیلِہِمْ فَأَعْجَبَہُ قَوْلُ عَلِیٍّ ، فَقَالَ: قَوْلُ مَنْ ہَذَا ؟ فَقُلْتُ : قَوْلُ أَبِی تُرَابٍ ، فَفَطِنَ الْحَجَّاجُ ، فَقَالَ : إنَّا لَمْ نَعِبْ عَلَی عَلِیٍّ قَضَائِہِ ، إنَّمَا عِبْنَا کَذَا وَکَذَا۔","","Musannaf Ibn Abi Shaybah 31894","","","كتاب الفرائض"
"31895","(۳۱۸۹۵) حَدَّثَنَا ابْنِ فُضَیْلٌ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی امْرَأَۃٍ تَرَکَتْ أُخْتَہَا لأَبِیہَا وَأُمِّہَا ، وَجَدَّہَا ، وَأُمَّہَا ، فَلأُخْتِہَا لأَبِیہَا وَأُمِّہَا النِّصْفُ ، وَلأُمِّہَا الثُّلُثُ ، وَلِلْجَدِّ السُّدُسُ فِی قَوْلِ عَلِی۔n وَکَانَ عَبْدُ اللہِ یَقُولُ : لِلأُمِّ السُّدُسُ ، وَلِلْجَدِّ الثُّلُثُ ، وَلِلأُخْتِ النِّصْفُ ، وَکَانَ عَبْدُ اللہِ یَقُولُ : لَمْ یَکُنِ اللَّہُ لِیَرَانِی أُفَضِّلُ أُمًّا عَلَی جَدٍّ فِی ہَذِہِ الْفَرِیضَۃِ وَلاَ فِی غَیْرِہَا مِنَ الْحُدُودِ۔n وَکَانَ زَیْدٌ یُعْطِی الأُمَّ الثُّلُثَ ، وَالأُخْتَ ثُلُثَ مَا بَقِیَ ، قَسَمَہَا زَیْدٌ عَلَی تِسْعَۃِ أَسْہُمٍ : لِلأُمِّ الثُّلُثُ ثَلاَثَۃُ أَسْہُمٍ ، وَلِلأُخْتِ ثُلُثُ مَا بَقِیَ سَہْمَانِ ، وَلِلْجَدِّ أَرْبَعَۃُ أَسْہُمٍ۔n وَکَانَ عُثْمَان یَجْعَلُہَا بَیْنَہُمْ أَثْلاَثًا : لِلأُمِّ الثُّلُثُ ، وَلِلأُخْتِ الثُّلُثُ ، وَلِلْجَدِّ الثُّلُثُ۔n وَکَانَ ابْنُ عَبَّاسٍ یَقُولُ : الْجَدُّ بِمَنْزِلَۃِ الأَبِ۔","","Musannaf Ibn Abi Shaybah 31895","","","كتاب الفرائض"
"31896","(۳۱۸۹۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ : کَانَ عَبْدُ اللہِ یَقُولُ فِی أُخْتٍ وَأَمٍّ وَجَدٍّ : لِلأُخْتِ النِّصْفُ ، وَالنِّصْفُ الْبَاقِی بَیْنَ الْجَدِّ وَالأُمِّ۔","","Musannaf Ibn Abi Shaybah 31896","","","كتاب الفرائض"
"31897","(۳۱۸۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عُمَرَ : فِی أُخْتٍ وَأَمٍّ وَجَدٍّ ، قَالَ : لِلأُخْتِ النِّصْفُ ، وَلِلأُمِّ السُّدُسُ ، وَمَا بَقِیَ فَلِلْجَدِّ۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ عَلِیٍّ وَعَبْدِ اللہِ مِنْ سِتَّۃِ أَسْہُمٍ ، وَفِی قَوْلِ زَیْدِ بْنِ ثَابِتٍ مِنْ تِسْعَۃِ أَسْہُمٍ۔","","Musannaf Ibn Abi Shaybah 31897","","","كتاب الفرائض"
"31898","(۳۱۸۹۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ : أَنَّہُ قَالَ فِی ابْنَۃٍ وَأُخْتٍ وَجَدٍّ : أَعْطَی الاِبْنَۃَ النِّصْفَ ، وَجَعَلَ مَا بَقِیَ بَیْنَ الْجَدِّ وَالأُخْتِ ، لَہُ نِصْفٌ ، وَلَہَا نِصْفٌ۔n وَسُئِلَ عَنِ ابْنَۃٍ ، وَأُخْتَیْنِ ، وَجَدٍّ ، فَأَعْطَی الْبِنْتَ النِّصْفَ ، وَجَعَلَ مَا بَقِیَ بَیْنَ الْجَدِّ وَالأُخْتَیْنِ ، لَہُ نِصْفٌ وَلَہُمَا نِصْفٌ۔n وَسُئِلَ عَنِ ابْنَۃٍ وَثَلاَثَۃِ أَخَوَاتٍ وَجَدٍّ ، فَأَعْطَی الْبِنْتَ النِّصْفَ ، وَجَعَلَ لِلْجَدِّ خُمُسَیْ مَا بَقِیَ وَأَعْطَی الأَخَوَاتِ خُمُسًا خُمُسًا۔","","Musannaf Ibn Abi Shaybah 31898","","","كتاب الفرائض"
"31899","(۳۱۸۹۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبِیدَۃَ : فِی ابْنَۃٍ وَأُخْتٍ وَجَدٍّ ، قَالَ : ہِیَ مِنْ أَرْبَعَۃٍ : سَہْمَانِ لِلْبِنْتِ ، وَسَہْمٌ لِلْجَدِّ ، وَسَہْمٌ لِلأُخْتِ ، قُلْتُ لَہُ : فَإِنْ کَانَتَا أُخْتَیْنِ ؟ قَالَ : جَعَلَہَا عَبِیدَۃُ مِنْ أَرْبَعَۃٍ : لِلْبِنْتِ سَہْمَانِ ، وَسَہْمٌ لِلْجَدِّ ، وَلِلأُخْتَیْنِ سَہْمٌ ، قُلْتُ لَہُ : فَإِنْ کُنَّ ثَلاَث أَخَوَاتٍ ؟ قَالَ : جَعَلَہَا مَسْرُوقٌ مِنْ عَشَرَۃٍ : لِلْبِنْتِ خَمْسَۃُ أَسْہُمٍ ، وَلِلْجَدِّ سَہْمَانِ ، وَلِکُلِّ وَاحِدَۃٍ مِنْہُنَّ سَہْمٌ سَہْمٌ۔","","Musannaf Ibn Abi Shaybah 31899","","","كتاب الفرائض"
"31900","(۳۱۹۰۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن مَسْرُوقٍ : فِی بِنْتٍ وَثَلاَثِ أَخَوَاتٍ وَجَدٍّ ، قَالَ : مِنْ عَشَرَۃٍ : لِلْبِنْتِ النِّصْفُ خَمْسَۃُ أَسْہُمٍ ، وَلِلْجَدِّ سَہْمَانِ ، وَلِکُلِّ أُخْتٍ سَہْمٌ۔","","Musannaf Ibn Abi Shaybah 31900","","","كتاب الفرائض"
"31901","(۳۱۹۰۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبِیدَۃَ : فِی ابْنَۃٍ وَأُخْتٍ وَجَدٍّ ، قَالَ: مِنْ أَرْبَعَۃٍ سہْمَانِ : لِلإِبْنِۃِ النِّصْفُ ، وَسَہْمٌ لِلْجَدِّ ، وَسَہْمٌ لِلأُخْتِ۔","","Musannaf Ibn Abi Shaybah 31901","","","كتاب الفرائض"
"31902","(۳۱۹۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن مَسْرُوقٍ : فِی ابْنَۃٍ وَأُخْتَیْنِ وَجَدٍّ ، قَالَ : مِنْ ثَمَانِیَۃِ أَسْہُمٍ : لِلْبِنْتِ النِّصْفُ أَرْبَعَۃٌ ، وَلِلْجَدِّ سَہْمَانِ ، وَلِکُلِّ أُخْتٍ سَہْمٌ۔","","Musannaf Ibn Abi Shaybah 31902","","","كتاب الفرائض"
"31903","(۳۱۹۰۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ تَرَکَ ابْنَتَہُ وَأُخْتَہ لأَبِیہِ وَأُمِّہِ وَجَدًّا ، فَلاِبْنَتِہِ النِّصْفُ ، وَلِجَدِّہِ السُّدُسُ ، وَمَا بَقِیَ فَلأُخْتِہِ فِی قَوْلِ عَلِی ، لَمْ یَکُنْ یَزِیدُ الْجَدَّ مَعَ الْوَلَدِ عَلَی السُّدُسِ شَیْئًا ، وَفِی قَوْلِ عَبْدِ اللہِ لاِبْنَتِہِ النِّصْفُ ، وَمَا بَقِیَ فَبَیْنَ الأُخْتِ وَالْجَدِّ۔n فَإِنْ کَانَتَا أُخْتَانِ فَمَا بَقِیَ بَیْنَ الْجَدِّ وَالأُخْتَیْنِ فِی قَوْلِ عَبْدِ اللہِ وَزَیْدٍ ، وَفِی قَوْلِ عَلِیٍّ : لِلْجَدِّ السُّدُسُ ، وَللأُخْتَیْہِ مَا بَقِی ، وَإِنْ کُنَّ ثَلاَثَ أَخَوَاتٍ مَعَ الاِبْنَۃِ وَالْجَدِّ ، فَلِلاِبْنَۃِ النِّصْفُ وَلِلْجَدِّ خُمُسَا مَا بَقِی ، وَلِلأَخَوَاتِ ثَلاَثَۃُ أَخْمَاسٍ فِی قَوْلِ عَبْدِ اللہِ وَزَیْدٍ۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ عَلِیٍّ مِنْ سِتَّۃِ أَسْہُمٍ ، وَفِی قَوْلِ عَبْدِ اللہِ وَزَیْدٍ مِنْ عَشَرَۃِ أَسْہُمٍ : خَمْسَۃٌ لِلْبِنْتِ وَسَہْمَانِ لِلْجَدِّ وَلِلأَخَوَاتِ سَہْمٌ ، سَہْمٌ۔","","Musannaf Ibn Abi Shaybah 31903","","","كتاب الفرائض"
"31904","(۳۱۹۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ فِطْرٍ ، قَالَ : قُلْتُ لِلشَّعْبِیِّ : کَیْفَ قَوْلُ عَلِیٍّ فِی ابْنَۃٍ وَأُخْتٍ وَجَدٍّ ؟ قَالَ : مِنْ أَرْبَعَۃٍ ، قَالَ : قُلْتُ : إنَّمَا ہَذِہِ فِی قَوْلِ عَبْدِ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 31904","","","كتاب الفرائض"
"31905","(۳۱۹۰۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، قَالَ : قَالَ إبْرَاہِیمُ فِی امْرَأَۃٍ تَرَکَتْ زَوْجَہَا وَأُمَّہَا وَأَخَاہَا لأَبِیہَا وَجَدِّہَا : لِلزَّوْجِ النِّصْفُ ثَلاَثَۃُ أَسْہُمٍ ، وَلِلأُمِّ الثُّلُثُ سَہْمَانِ ، وَلِلْجَدِّ سَہْمٌ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ ، وَفِی قَوْلِ عَبْدِ اللہِ : لِلزَّوْجِ النِّصْفُ ، وَلِلأُمِّ ثُلُثُ مَا بَقِیَ سَہْمٌ ، وَلِلْجَدِّ سَہْمٌ ، وَلِلأَخِ سَہْمٌ ، وَإِنْ کَانَا أَخَوَانِ أَوْ أَکْثَرَ مِنْ ذَلِکَ : فَلِلزَّوْجِ النِّصْفُ وَلِلأُمِّ سَہْمٌ ، وَلِلْجَدِّ سَہْمٌ ، وَبَقِیَ سَہْمٌ فَہُوَ لاِِخْوَتِہِ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ وَعَبْدِ اللہِ۔","","Musannaf Ibn Abi Shaybah 31905","","","كتاب الفرائض"
"31906","(۳۱۹۰۶) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ: أَتَیْنَا شُرَیْحًا فَسَأَلْنَاہُ عَنْ زَوْجٍ ، وَأَمٍّ ، وَأَخٍ، وَجَدٍّ ؟ فَقَالَ : لِلْبَعْلِ الشَّطْرُ ، وَلِلأُمِّ الثُّلُثُ ، ثُمَّ سَکَتَ ، ثُمَّ قَالَ الَّذِی عَلَی رَأْسِہِ : أَنَّہُ لاَ یَقُولُ فِی الْجَدِّ شَیْئًا ، قَالَ : فَأَتَیْنَا عَبِیدَۃَ فَقَسَمَہَا مِنْ سِتَّۃٍ فِی قَوْلِ عَبْدِ اللہِ ، فَأَعْطَی الزَّوْجَ ثَلاَثَۃً ، وَالأُمَّ سَہْمًا ، وَالْجَدَّ سَہْمًا ، وَالأَخَ سَہْمًا۔n فَہَذِہِ فِی قَوْلِہِمْ جَمِیعًا مِنْ سِتَّۃِ أَسْہُمٍ۔","","Musannaf Ibn Abi Shaybah 31906","","","كتاب الفرائض"
"31907","(۳۱۹۰۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ : فِی امْرَأَۃٍ تَرَکَتْ أُخْتَہَا لأَبِیہَا وَأُمِّہَا وَجَدَّہَا ، فَلأُخْتِہَا لأَبِیہَا وَأُمِّہَا النِّصْفُ فِی قَوْلِ عَلِیٍّ وَعَبْدِ اللہِ ، وَکَانَ زَیْدٌ یُعْطِی الأُخْتَ الثُّلُثَ وَالْجَدَّ الثُّلُثَیْنِ۔nقَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ عَلِیٍّ وَعَبْدِ اللہِ مِنْ سَہْمَیْنِ ، وَفِی قَوْلِ زَیْدٍ : مِنْ ثَلاَثَۃِ أَسْہُمٍ۔","","Musannaf Ibn Abi Shaybah 31907","","","كتاب الفرائض"
"31908","(۳۱۹۰۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، قَالَ : قَالَ إبْرَاہِیمُ : فِی رَجُلٍ تَرَکَ جَدَّہُ ، وَأُخْتَہ لأَبِیہِ وَأُمِّہِ، وَأَخَاہُ لأَبِیہِ ، فَلِلْجَدِّ فِی قَضَائِ زَیْدٍ الْخُمُسَانِ مِنْ عَشَرَۃٍ ، أَرْبَعَۃُ أَسْہُمٍ ، وَلأُخْتِہِ مِنْ أَبِیہِ وَأُمِّہِ النِّصْفُ ، خَمْسَۃٌ ، وَلأَخِیہِ لأَبِیہِ سَہْمٌ ، یَرُدُّ الأَخُ مِنَ الأَبِ فِی قَضَائِ زَیْدٍ عَلَی الأُخْت مِنَ الأَبِ وَالأُمِّ کَانَ لَہَا ثَلاَثَۃُ أَخْمَاسِ الْمَالِ فَأُعْطِیَتَ النِّصْفُ مِنْ أَجْلِ أَنَّ ثَلاَثَۃَ أَخْمَاسٍ أَکْثَرُ مِنَ النِّصْفِ ، وَلَیْسَ لِلأُخْتِ الْوَاحِدۃ وَإِنْ قَاسَمَہَا أَکْثَرَ مِنَ النِّصْفِ۔n وَکَانَ ابْنُ مَسْعُودٍ یُعْطِی الأُخْتَ مِنَ الأَبِ وَالأُمِّ النِّصْفَ ، وَالْجَدَّ النِّصْفَ ، وَلاَ یَعْتَدُّ بِالأُخْوَۃِ مِنَ الأَبِ مَعَ الأخْوَۃِ مِنَ الأَبِ وَالأُمِ۔n وَکَانَ عَلِیٌّ یَجْعَلُ لِلأُخْتِ مِنَ الأَبِ وَالأُمِّ النِّصْفَ ، وَیَقْسِمُ النِّصْفَ الْبَاقِی بَیْنَ الأُخْوَۃِ وَالْجَدِّ ، الْجَدُّ کَأَحَدِہِمْ مَا لَمْ یَکُنْ نَصِیبُ الْجَدِّ أَقَلَّ مِنَ السُّدُسِ ، إِنْ کَانَ أَخٌ وَاحِدٌ فَالنِّصْفُ الَّذِی بَقِیَ بَیْنَہُمَا ، وَإِنْ کَانَا أَخَوَیْنِ فَالنِّصْفُ بَیْنَہُمَا ، وَإِنْ کَانُوا ثَلاَثَۃٌ ، فَلِلْجَدِّ السُّدُسِ ، وَمَا بَقِیَ فَلِلأُخْوَۃِ۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ زَیْدٍ مِنْ عَشَرَۃِ أَسْہُمٍ ، وَفِی قَوْلِ عَبْدِ اللہِ : مِنْ سَہْمَیْنِ ، وَکَانَ عَلِیٌّ یَجْعَلُہَا مِنْ سِتَّۃٍ إذَا کَثُرَ الأُخْوَۃُ۔","","Musannaf Ibn Abi Shaybah 31908","","","كتاب الفرائض"
"31909","(۳۱۹۰۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، قَالَ : قَالَ إبْرَاہِیمُ : فِی امْرَأَۃٍ تَرَکَتْ أُمَّہَا ، وَأُخْتَہَا لأَبِیہَا وَأُمِّہَا ، وَأَخَاہَا لأَبِیہَا ، وَجَدَّہَا ، قَضَی فِیہَا زَیْدٌ : أَنَّ لِلأُمِّ السُّدُسَ ، وَلِلْجَدِّ خُمُسَا مَا بَقِی ، وَلِلأُخْتِ ثَلاَثَۃُ أَخْمَاسِ مَا بَقِی ، رَدَّ الأَخُ عَلَی أُخْتِہِ وَلَمْ یَرِثْ شَیْئًا ، وَقَضَی فِیہَا عَبْدُ اللہِ : أَنَّ لِلأُخْتِ ثَلاَثَۃُ أَسْہُمٍ ، وَلِلأُمِّ سَہْمٌ ، وَلِلْجَدِّ سَہْمٌ ، وَقَضَی فِیہَا عَلِیٌّ : أَنَّ لِلأُخْتِ مِنَ الأَبِ وَالأُمِّ ثَلاَثَۃُ أَسْہُمٍ ، وَلِلأُمِّ سَہْماً ، وَبَقِیَ سَہْمَانِ : لِلْجَدِّ سَہْمٌ ، وَلِلأَخِ سَہْمٌ۔n فَہَذِہِ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ مِنْ سِتَّۃِ أَسْہُمٍ ، وَفِی قَوْلِ عَبْدِ اللہِ مِنْ خَمْسَۃٍ۔","","Musannaf Ibn Abi Shaybah 31909","","","كتاب الفرائض"
"31910","(۳۱۹۱۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ فِی امْرَأَۃٍ تَرَکَتْ زَوْجَہَا ، وَأُمَّہَا ، وَأَرْبَعَ أَخَوَاتٍ لَہَا مِنْ أَبِیہَا وَأُمَّہَا ، وَجَدَّہَا ، قضَی فِیہَا زَیْدٌ : أَنَّ لِلزَّوْجِ ثَلاَثَۃُ أَسْہُمٍ ، وَلِلأُمِّ سَہْماً ، وَلِلْجَدِّ سَہْمَاً، وَلِلأَخَوَاتِ سَہْمَاً ، وَقَضَی فِیہَا عَلِیٌّ وَعَبْدُ اللہِ عَلَی تِسْعَۃِ أَسْہُمٍ : لِلزَّوْجِ ثَلاَثَۃُ أَسْہُمٍ ، وَلِلأُمِّ سَہْمٌ، وَلِلْجَدِّ سَہْمٌ ، وَلِلأَخَوَاتِ أَرْبَعَۃُ أَسْہُمٍ۔n قَالَ أَبُو بَکْرٍ : فَہَذِہِ فِی قَوْلِ زَیْدٍ مِنْ سِتَّۃِ أَسْہُمٍ ، وَفِی قَوْلِ عَلِیٍّ وَعَبْدِ اللہِ مِنْ تِسْعَۃِ أَسْہُمٍ۔","","Musannaf Ibn Abi Shaybah 31910","","","كتاب الفرائض"
"31911","(۳۱۹۱۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ سَالِمٍ ، عَنِ الشَّعْبِیِّ : فِی أُخْتٍ لأَمٍّ وأَبٍ ْ وَأَخٍ وَأُخْتٍ لأَبٍ ، وَجَدٍّ ، فِی قَوْلِ عَلِیٍّ : لِلأُخْتِ مِنَ الأَبِ وَالأُمِّ النِّصْفُ ، وَمَا بَقِیَ فَبَیْنَ الْجَدِّ وَالأُخْتِ وَالأَخِ مِنَ الأَبِ عَلَی الأَخْمَاسِ : لِلْجَدِّ خُمُسَانِ ، وَلِلأُخْتِ خُمُسٌ۔ وَفِی قَوْلِ عَبْدِ اللہِ : لِلأُخْتِ مِنَ الأَبِ وَالأُمِّ النِّصْفُ ، وَلِلْجَدِّ مَا بَقِی ، وَلَیْسَ لِلأَخِ وَالأُخْتِ مِنَ الأَبِ شَیْئٌ۔ وَفِی قَوْلِ زَیْدٍ : مِنْ ثَمَانیَۃَ عَشَرَ سَہْمًا : لِلْجَدِّ الثُّلُثُ سِتَّۃٌ ، وَلِلأَخِ مِنَ الأَبِ سِتَّۃٌ ، وَلِلأُخْتِ مِنَ الأَبِ ثَلاَثَۃٌn وَلِلأُخْتِ مِنَ الأَبِ وَالأُمِّ ثَلاَثَۃٌ ، ثُمَّ تَرُدُّ الأُخْتُ وَالأَخُ مِنَ الأَبِ عَلَی الأُخْتِ مِنَ الأَبِ وَالأُمِّ سِتَّۃَ أَسْہُمٍ ، فَاسْتَکْمَلَتِ النِّصْفَ تِسْعَۃً ، وَبَقِیَ لَہُمَا ثَلاَثَۃُ أَسْہُمٍ : لِلأَخِ سَہْمَانِ وَلِلأُخْتِ سَہْمٌ۔n وَفِی أُخْتَینِ لأَبٍ وَأُم ، وَأَخٍ لأَبٍ ، وَجَدٍّ فِی قَوْلِ عَلِیٍّ : لِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ الثُّلُثَانِ ، وَمَا بَقِیَ فَبَیْنَ الْجَدِّ وَالأَخِ ، وَفِی قَوْلِ عَبْدِ اللہِ : لِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ الثُّلُثَانِ ، وَلِلْجَدِّ مَا بَقِی ، وَلَیْسَ لِلأَخِ مِنَ الأَبِ شَیْئٌ۔ وَفِی قَوْلِ زَیْدٍ : ہِیَ ثَلاَثَۃُ أَسْہُمٍ : لِلْجَدِّ سَہْمٌ ، وَلِلأَخِ سَہْمٌ وَلِلأُخْتَیْنِ سَہْمٌ ، ثُمَّ یَرُدُّ الأَخُ مِنَ الأَبِ عَلَی الأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ سَہْمَہُما ، فَتَسْتَکْمِلاَنِ الثُّلُثَیْنِ ، وَلَمْ یَبْقَ لَہُ شَیْئٌ۔n وَفِی أُخْتَیْنِ لأَبٍ وَأَمٍّ ، وَأُخْتٍ لأَبٍ ، وَجَدٍّ ، فِیn قَوْلِ عَلِیٍّ ، وَعَبْدِ اللہِ : لِلأُخْتَیْنِ لِلأَبِ وَالأُمِّ الثُّلُثَانِ ، وَمَا بَقِیَ لِلْجَدِّ ، وَلَیْسَ لِلأُخْتِ مِنَ الأَبِ شَیْئٌ وَفِی قَوْلِ زَیْدٍ : مِنْ خَمْسَۃِ أَسْہُمٍ : لِلْجَدِّ سَہْمَانِ ، وَلِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ سَہْمَانِ ، وَلِلأُخْتِ مِنَ الأَبِ سَہْمٌ ، ثُمَّ تَرُدُّ الأُخْتُ مِنَ الأَبِ عَلَی الأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ سَہْمَہُمَا ، وَلَمْ یَبْقَ لَہَا شَیْئٌ۔n وَفِی أُخْتَیْنِ لأَبٍ وَأَمٍّ ، وَأَخٍ وَأُخْتٍ لأَبٍ ، وَجَدٍّ فِی قَوْلِ عَلِیٍّ : لِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ الثُّلُثَانِ ، وَلِلْجَدِّ السُّدُسُ ، وَمَا بَقِیَ فَبَیْنَ الأُخْتِ وَالأَخِ مِنَ الأَبِ لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ ، وَفِی قَوْلِ عَبْدِ اللہِ : لِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ الثُّلُثَانِ ، وَلِلْجَدِّ مَا بَقِی ، وَلَیْسَ لِلأَخِ وَالأُخْتِ مِنَ الأَبِ شَیْئٌ وَفِی قَوْلِ زَیْدٍ : مِنْ خَمْسَۃَ عَشَرَ سَہْمًا : لِلْجَدِّ الثُّلُثُ خَمْسَۃُ أَسْہُمٍ ، وَلِلأَخِ مِنَ الأَبِ أَرْبَعَۃٌ ، وَلِلأُخْتِ مِنَ الأَبِ سَہْمَانِ وَلِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ أَرْبَعَۃُ أَسْہُمٍ ، ثُمَّ یَرُدُّ الأَخُ وَالأُخْتُ مِنَ الأَبِ عَلَی الأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ نَصِیبَہُمَا ، یَسْتَکْمِلاَنِ الثُّلُثَین وَلَمْ یَبْقَ لَہُمَا شَیْئٌ۔n وَفِی أُخْتَیْنِ لأَبٍ وَأَمٍّ ، وَأُخْتَیْنِ لأَبٍ ، وَجَدٍّ فِی قَوْلِ عَلِیٍّ وَعَبْدِ اللہِ : لِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ الثُّلُثَانِ ، وَلِلْجَدِّ مَا بَقِی ، وَلَیْسَ لِلأُخْتَیْنِ مِنَ الأَبِ شَیْئٌ۔ وَفِی قَوْلِ زَیْدٍ : مِنْ سِتَّۃِ أَسْہُمٍ : لِلْجَدِّ سَہْمَانِ ، وَلِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ سَہْمَانِ ، وَلِلأُخْتَیْنِ مِنَ الأَبِ سَہْمَانِ ، ثُمَّ تَرُدُّ الأُخْتَانِ مِنَ الأَبِ عَلَی الأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ سَہْمَیْہِمَا ، فَیَسْتَکْمِلاَنِ الثُّلُثَیْنِ ، وَلَمْ یَبْقَ لَہُمَا شَیْئٌ۔n وَفِی أُخْتٍ لأَبٍ وَأَمٍّ ، وَثَلاَثِ أَخَوَاتٍ لأَبٍ ، وَجَدِّہِ : فِی قَوْلِ عَلِیٍّ وَعَبْدِ اللہِ : لِلأُخْتِ مِنَ الأَبِ وَالأُمِّ النِّصْفُ ، وَلِلأَخَوَاتِ مِنْ الأَبِ السُّدُسُ تَکْمِلَۃَ الثُّلُثَیْنِ ، وَلِلْجَدِّ مَا بَقِی ، وَفِی قَوْلِ زَیْدٍ : ثَمَانیَۃَ عَشَرَ سَہْمًا : لِلْجَدِّ الثُّلُثُ سِتَّۃٌ ، وَلِلأُخْتِ مِنَ الأَبِ وَالأُمِّ ثَلاَثَۃُ أَسْہُمٍ ، وَلِلأَخَوَاتِ مِنَ الأَبِ تِسْعَۃُ أَسْہُمٍ ، ثُمَّ تَرُدُّ الأَخَوَاتُ مِنَ الأَبِ عَلَی الأُخْتِ مِنَ الأَبِ وَالأُمِّ سِتَّۃَ أَسْہُمٍ ، فَاسْتَکْمَلَتِ النِّصْفَ تِسْعَۃً ، وَبَقِیَ لَہُنَّ سَہْمٌ سَہْمٌ۔n وَفِی أُخْتَیْنِ لأَبٍ وَأَمٍّ ، وَأَخٍ ، وَأُخْتَیْنِ لأَبٍ ، وَجَدٍّ : فِی قَوْلِ عَلِیٍّ : لِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ الثُّلُثَانِ ، وَلِلْجَدِّ السُّدُسُ ، وَمَا بَقِیَ فَبَیْنَ الأَخِ وَالأُخْتَیْنِ مِنَ الأَبِ لِلذَّکَرِ مِثْلُ حَظِّ الأُنْثَیَیْنِ ، وَفِی قَوْلِ عَبْدِ اللہِ : لِلأُخْتَیْنِ مِنَ الأَبِ وَالأُمِّ الثُّلُثَانِ ، وَلِلْجَدِّ مَا بَقِی ، وَلَیْسَ لِلأَخِ وَالأُخْتَیْنِ مِنَ الأَبِ شَیْئٌ۔n وَفِی أُمٍّ وَأُخْتٍ وَجَدٍّ فِی قَوْلِ عَلِیٍّ : لِلأُخْتِ النِّصْفُ ، وَلِلأُمِّ ثُلُث مَا بَقِی ، وَلِلْجَدِّ مَا بَقِیَ۔n وَفِی قَوْلِ زَیْدٍ : مِنْ تِسْعَۃِ أَسْہُمٍ : لِلأُمِّ الثُّلُثُ ثَلاَثَۃٌ ، وَلِلْجَدِّ أَرْبَعَۃٌ ، وَلِلأُخْتِ سَہْمَانِ ، جَعَلَہُ مَعَہُمَا بِمَنْزِلَۃِ الأَخِ ، وَفِی قَوْلِ عُثْمَانَ: لِلأُمِّ الثُّلُثُ ، وَلِلْجَدِّ الثُّلُثُ ، وَلِلأُخْتِ الثُّلُثُ ، وَفِی قَوْلِ ابْنِ عَبَّاسٍ: لِلأُمِّ الثُّلُثُ، وَلِلْجَدِّ مَا بَقِی ، لَیْسَ لِلأُخْتِ شَیْئٌ ، لَمْ یَکُنْ یُوَرِّثُ أَخًا وَأُخْتًا مَعَ جَدٍّ شَیْئًا۔","Da'if","Musannaf Ibn Abi Shaybah 31911","","","كتاب الفرائض"
"31912","(۳۱۹۱۲) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ زَیْدٌ یُشَرِّکُ الْجَدَّ إِلَی الثُّلُثِ مَعَ الإِخْوَۃِ وَالأَخَوَاتِ ، فَإِذَا بَلَغَ الثُّلُثَ أَعْطَاہُ الثُّلُثَ ، وَکَانَ لِلأُخْوَۃِ وَالأَخَوَاتِ مَا بَقِی ، وَلاَ للأَخٍ لأُمٍّ ، وَلاَ للأُخْتٍ لأُمٍّ مَعَ جَدٍّ شَیْئٌ ، وَیُقَاسِمُ الأُخْوَۃَ مِنَ الأَبِ الإِخْوَۃَ مِنَ الأَبِ وَالأُمِّ ، وَلاَ یُوَرِّثُہُمْ شَیْئًا ، فَإِذَا کَانَ أَخٌ لأَبٍ وَأَمٍّ وَجَدٍّ ، أَعْطَی الْجَدَّ النِّصْفَ ، وَإِذَا کَانَا أَخَوَیْنِ أَعْطَاہُ الثُّلُثَ ، فَإِنْ زَادُوا أَعْطَاہُ الثُّلُثَ ، وَکَانَ لِلإِخْوَۃِ مَا بَقِی وَإِذَا کَانَتْ أُخْتٌ وَجَدٌّ أَعْطَاہُ مَعَ الأُخْتِ الثُّلُثَیْنِ ، وَلِلأُخْتِ الثُّلُثَ ، وَإِذَا کَانَتَا أُخْتَیْنِ أَعْطَاہُمَا النِّصْفَ ، وَلَہُ النِّصْفَ مَا دَامَتِ الْمُقَاسَمَۃُ خَیْرًا لَہُ ، فَإِنْ لَحِقَتْ فَرَائِضُ امْرَأَۃٍ وَ أُمٍّ وَزَوْجٍ أَعْطَی أَہْلَ الْفَرَائِضِ فَرَائِضَہُمْ ، وَمَا بَقِیَ قَاسَمَ الإِخْوَۃُ وَالأَخَوَاتُ ، فَإِنْ کَانَ ثُلُثُ مَا بَقِیَ خَیْرًا لَہُ مِنَ الْمُقَاسَمَۃِ أَعْطَاہُ ثُلُثَ مَا بَقِی ، وَإِنْ کَانَتِ الْمُقَاسَمَۃُ خَیْرًا لَہُ أَعْطَاہُ الْمُقَاسَمَۃَ ، وَإِنْ کَانَ سُدُسُ جَمِیعِ الْمَالِ خَیْرًا لَہُ مِنَ الْمُقَاسَمَۃِ أَعْطَاہُ السُّدُسَ ، وَإِنْ کَانَتِ الْمُقَاسَمَۃُ خَیْرًا لَہُ مِنْ سُدُسِ جَمِیعِ الْمَالِ أَعْطَاہُ الْمُقَاسَمَۃَ۔","","Musannaf Ibn Abi Shaybah 31912","","","كتاب الفرائض"
"31913","(۳۱۹۱۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إِبْرَاہِیمَ ، عَن عُمَرَ وَعَبْدِ اللہِ : أَنَّہُمَا کَانَا لاَ یُفَضِّلاَنِ أُمًّا عَلَی جَدٍّ۔","","Musannaf Ibn Abi Shaybah 31913","","","كتاب الفرائض"
"31914","(۳۱۹۱۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، عَنْ عَبِیدَۃَ ، قَالَ : إنِّی لأُحِیلُ الْجَدَّ عَلَی مِئَتَیْ قَضِیَّۃٍ۔","","Musannaf Ibn Abi Shaybah 31914","","","كتاب الفرائض"
"31915","(۳۱۹۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ أَیُّوب ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبِیدَۃَ ، قَالَ : حَفِظْت عَن عُمَرَ مِئَۃَ قَضِیَّۃٍ فِی الْجَدِّ مُخْتَلِفَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31915","","","كتاب الفرائض"
"31916","(۳۱۹۱۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عُبَیْدِ بْنِ عَمْرٍو الْخَارِفِیِّ : أَنَّ رَجُلاً سَأَلَ عَلِیًّا عَنْ فَرِیضَۃٍ ؟ فَقَالَ : ہَاتِ إنْ لَمْ یَکُنْ فِیہَا جَدٌّ۔","Da'if","Musannaf Ibn Abi Shaybah 31916","","","كتاب الفرائض"
"31917","(۳۱۹۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَیُّوبَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنْ رَجُلٍ مِنْ مُرَادٍ ، قَالَ : سَمِعْتُ عَلِیًّا یَقُولُ : مَنْ أَحَبَّ أَنْ یَتَقَحَّمَ جَرَاثِیمَ جَہَنَّمَ فَلْیَقْضِ بَیْنَ الْجَدِّ وَالإِخْوَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 31917","","","كتاب الفرائض"
"31918","(۳۱۹۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : أَتَیْنَا شُرَیْحًا فَسَأَلْنَاہُ ؟ فَقَالَ الَّذِی عَلَی رَأْسِہِ : إنَّہُ لاَ یَقُولُ فِی الْجَدِّ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 31918","","","كتاب الفرائض"
"31919","(۳۱۹۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ ، عَنِ الشَّعْبِیِّ ، قَالَ : خُذْ فِی أَمْرِ الْجَدِّ بِمَا اجْتَمَعَ عَلَیْہِ النَّاسُ۔ یَعْنِی : قَوْلَ زَیْدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31919","","","كتاب الفرائض"
"31920","(۳۱۹۲۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ : أَنَّ عُمَرَ کَتَبَ فِی أَمْرِ الْجَدِّ وَالْکَلاَلَۃِ فِی کَتِفٍ ، ثُمَّ طَفِقَ یَسْتَخِیرُ رَبَّہُ ، فَلَمَّا طُعِنْ دَعَا بِالْکَتِفِ فَمَحَاہَا ، ثُمَّ قَالَ : إنِّی کُنْت کَتَبْت کِتَابًا فِی الْجَدِّ وَالْکَلاَلَۃِ ، وَإِنِّی قَدْ رَأَیْت أَنْ أَرُدَّکُمْ عَلَی مَا کُنْتُمْ عَلَیْہِ ، فَلَمْ یَدْرُوا مَا کَانَ فِی الْکَتِفِ۔","Sahih","Musannaf Ibn Abi Shaybah 31920","","","كتاب الفرائض"
"31921","(۳۱۹۲۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ سَعِیدٍ ، قَالَ : حدَّثَنِی رَجُلٌ مِنْ مُرَادٍ ، عَنْ عَلِیٍّ ، قَالَ : مَنْ أَحَبَّ أَنْ یَتَقَحَّمَ فِی جَرَاثِیمِ جَہَنَّمَ فَلْیَقْضِ بَیْنَ الإِخْوَۃِ وَالْجَدِّ۔","Da'if","Musannaf Ibn Abi Shaybah 31921","","","كتاب الفرائض"
"31922","(۳۱۹۲۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ قَبِیصَۃَ ، قَالَ : جَائَتِ الْجَدَّۃُ بِالأُمِّ وَابْنِ الاِبْنِ بَعْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی أَبِی بَکْرٍ ، فَقَالَتْ : إنَّ ابْنَ ابْنِی وَابْنَ ابْنَتِی مَاتَ ، وَقَدْ أُخْبِرْتُ أَنَّ لِی حَقًّا ، فَقَالَ أَبُو بَکْرٍ : مَا أَجِدُ لَکِ فِی کِتَابِ اللہِ مِنْ حَقٍّ ، وَمَا سَمِعْت فِیکِ شَیْئًا مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَسَأَسْأَلُ النَّاسَ ، قَالَ : فَشَہِدَ الْمُغِیرَۃُ بْنُ شُعْبَۃَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَعْطَاہَا السُّدُسَ ، فَقَالَ : مَنْ یَشْہَدُ مَعَک ؟ قَالَ : مُحَمَّدُ بْنُ مَسْلَمَۃَ ، فَشَہِدَ فَأَعْطَاہَا السُّدُسَ ، وَجَائَتِ الْجَدَّۃُ الَّتِی تُخَالِفُہَا إلَی عُمَرَ ، فَأَعْطَاہَا السُّدُسَ ، فَقَالَ : إذَا اجْتَمَعْتُمَا فَہُوَ بَیْنَکُمَا۔n زَادَ مَعْمَرٌ : وَأَیُّکُمَا انْفَرَدَتْ بِہِ فَہُوَ لَہَا۔ (ترمذی ۲۱۰۰)","","Musannaf Ibn Abi Shaybah 31922","","","كتاب الفرائض"
"31923","(۳۱۹۲۳) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَعْطَی الْجَدَّۃَ السُّدُسَ۔ (ابن ماجہ ۲۷۲۵۔ سعید بن منصور ۸۳)","Da'if","Musannaf Ibn Abi Shaybah 31923","","","كتاب الفرائض"
"31924","(۳۱۹۲۴) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ أَبِی الْمُنِیبِ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ ، قَالَ : حدَّثَنِی ابْنُ بُرَیْدَۃَ ، عَنْ أَبِیہِ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَطْعَمَ الْجَدَّۃَ السُّدُسَ إذَا لَمْ یَکُنْ ابنٌ۔ (ابوداؤد ۲۸۸۷۔ دارقطنی ۷۴)","Da'if","Musannaf Ibn Abi Shaybah 31924","","","كتاب الفرائض"
"31925","(۳۱۹۲۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : أَخْبَرَنَا ابْنُ عُمَیْرٍ ، عَنْ أَیُّوبَ ، عَنْ رَجُلٍ ، عَنْ طَاوُوسٍ ، قَالَ : الْجَدَّۃُ بِمَنْزِلَۃِ الأُمِ ، تَرِثُ مَا تَرِثُ الأُمُّ۔","","Musannaf Ibn Abi Shaybah 31925","","","كتاب الفرائض"
"31926","(۳۱۹۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : أَطْعَمَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ثَلاَثَ جَدَّاتٍ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : مَنْ ؟ قَالَ : جَدَّتَا أَبِیہِ : أُمّ أُمّہِ ، وَأُمّ أَبِیہِ ،وَجَدَّتِہِ أُمّ أُمّہِ۔n(ابوداؤد ۳۵۵۔ دارمی ۲۹۳۵)","","Musannaf Ibn Abi Shaybah 31926","","","كتاب الفرائض"
"31927","(۳۱۹۲۷) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : یَرِثُ مِنَ الْجَدَّاتِ ثَلاَثَۃٌ ، وَأَقْعَدُ الْجَدَّاتِ فِی النَّسَبِ أَحَقُّہُنَّ بِالسُّدُسِ۔","","Musannaf Ibn Abi Shaybah 31927","","","كتاب الفرائض"
"31928","(۳۱۹۲۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنْ عَامِرٍ ، قَالَ : إذَا اجْتَمَعَ أَرْبَعُ جَدَّاتٍ لَمْ تَرِثَ أُمُّ أَبِی الأُمِّ۔","","Musannaf Ibn Abi Shaybah 31928","","","كتاب الفرائض"
"31929","(۳۱۹۲۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : یَرِثُ ثَلاَثُ جَدَّاتٍ : جَدَّتَانِ مِنْ قِبَلِ الأُمِّ ، وَجَدَّۃَّ مِنْ قِبَلِ الأَبِ۔","","Musannaf Ibn Abi Shaybah 31929","","","كتاب الفرائض"
"31930","(۳۱۹۳۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ لَیْثٍ ، عَنْ طَاووسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : تَرِثُ الْجَدَّاتُ الأَرْبَعُ جَمِیعًا۔","Da'if","Musannaf Ibn Abi Shaybah 31930","","","كتاب الفرائض"
"31931","(۳۱۹۳۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَہْمٍ الْفَرَائِِضِیِّ ، قَالَ : کَانَ جَابِرُ بْنُ زَیْدٍ یُوَرِّثُ أَرْبَعَ جَدَّاتٍ۔","","Musannaf Ibn Abi Shaybah 31931","","","كتاب الفرائض"
"31932","(۳۱۹۳۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ : سُئِلَ عَنْ أَرْبَعِ جَدَّاتٍ ؟ فَقَالَ : یَرِثُ مِنْہُنَّ ثَلاَثٌ ، وَتُلْغی أُمَّ أَبِی الأُمِّ۔","","Musannaf Ibn Abi Shaybah 31932","","","كتاب الفرائض"
"31933","(۳۱۹۳۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ : أَنَّہُ کَانَ یُوَرِّثُ تِسْعَ جَدَّاتٍ وَیَقُولُ : إذَا کَانَتْ إحْدَی الْجَدَّاتِ أَقْرَبَ فَہُوَ لَہَا دُونَہُنَّ۔","","Musannaf Ibn Abi Shaybah 31933","","","كتاب الفرائض"
"31934","(۳۱۹۳۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ یُوَرِّثُ ثَلاَثَ جَدَّاتٍ وَیَقُولُ : أَیَّتُہُنَّ کَانَتْ أَقْرَبَ فَہُوَ لَہَا دُونَ الأُخْرَی ، فَإِذَا اسْتَوَتَا فَہُوَ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 31934","","","كتاب الفرائض"
"31935","(۳۱۹۳۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، قَالَ : قَالَ إبْرَاہِیمُ : جَعَلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیْنَ جَدَّۃٍ مِنْ قِبَلِ أُمِّہِ ، وَجَدَّتَیْنِ مِنْ قِبَلِ أَبِیہِ السُّدُسَ ، قَالَ زَائِدَۃُ : قُلْتُ لِمَنْصُورٍ : الَّتِی مِنْ قِبَلِ أَبِیہِ: أُمُّ أَبِیہِ ، وَأُمّ أُمِّہِ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 31935","","","كتاب الفرائض"
"31936","(۳۱۹۳۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، قَالَ : قَالَ إبْرَاہِیمُ : إذَا کَانَتِ الْجَدَّاتُ مِنْ نَحْوٍ وَاحِدٍ ، بَعْضُہُنَّ أَقْرَبُ سَقَطَتِ الْقُصْوَی۔","","Musannaf Ibn Abi Shaybah 31936","","","كتاب الفرائض"
"31937","(۳۱۹۳۷) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ بَسَّامٍ، عَنْ فُضَیْلٍ، قَالَ: قَالَ إبْرَاہِیمُ: تَرِثُ الْجَدَّاتُ السُّدُسَ، فَإِنْ کَانَتْ وَاحِدَۃً أَو اثْنَتَیْنِ أَوْ ثَلاَثًا فَبَیْنَہُنَّ سَہْمٌ فِی قَوْلِ عَلِیٍّ وَزَیْدٍ ، وَإذَا اجْتَمَعْن ثَلاَثُ جَدَّاتٍ ہُنَّ إلَی الْمَیِّتِ شرعٌ سَوَائٌ قَالَ: بَیْنَہُنَّ سَہْمٌ تَکُونُ جَدَّۃُ الأُمِّ ، وَجَدَّۃٌ بَنِی الأَبِ : أُمَّ أَبِیہِ ، وَأَمَّ أُمِّہِ ، وَفِی قَوْلِ عَبْدِ اللہِ : إذَا اجْتَمَعْن ثَلاَثُ جَدَّاتٍ کَانَ بَیْنَہُنَّ السُّدُسُ ، وَإِنْ کَانَ بَعْضُہُنَّ أَقْرَبَ نَسَبًا لَمْ یَکُنْ بَعْضُہُنَّ أُمَّہَاتِ بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 31937","","","كتاب الفرائض"
"31938","(۳۱۹۳۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، قَالَ : جِئْنَ أَرْبَعُ جَدَّاتٍ یَتَسَاوَقْنَ إلَی مَسْرُوقٍ فَوَرَّثَ ثَلاَثًا ، وَطَرَحَ أُمَّ أَبِی الأُمِّ۔","","Musannaf Ibn Abi Shaybah 31938","","","كتاب الفرائض"
"31939","(۳۱۹۳۹) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الْمُہَلَّبِ : أَنَّ جَدَّتَیْنِ أَتَتَا شُرَیْحًا ، فَجَعَلَ السُّدُسَ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 31939","","","كتاب الفرائض"
"31940","(۳۱۹۴۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ عَبْدُ اللہِ یُوَرِّثُ الْجَدَّاتِ وَإِنْ کُنَّ عَشْرًا ، وَیَقُولُ : إنَّمَا ہُوَ سَہْمٌ أَطْعَمَہُ إیَّاہُنَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (عبدالرزاق ۱۹۰۹۳)","","Musannaf Ibn Abi Shaybah 31940","","","كتاب الفرائض"
"31941","(۳۱۹۴۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَشْعَثِ ، عَنِ الشَّعْبِیِّ ، قَالَ : جَائَتْ أَرْبَعُ جَدَّاتٍ یَتَسَاوَقْنَ إلَی مَسْرُوقٍ ، فَوَرَّثَ ثَلاَثًا ، وَطَرَحَ وَاحِدَۃً : أُمَّ أَبِی الأُمِّ۔","","Musannaf Ibn Abi Shaybah 31941","","","كتاب الفرائض"
"31942","(۳۱۹۴۲) حَدَّثَنَا یَعْلَی ، عَنْ یَحْیَی ، عَنِ الْقَاسِمِ ، قَالَ : تُوُفِّیَ رَجُلٌ وَتَرَکَ جَدَّتَیْہِ : أُمَّ أُمِّہِ ، وَأَمَّ أَبِیہِ ، فَوَرَّثَ أَبُو بَکْرٍ أُمَّ أُمِّہِ ، وَتَرَکَ الأُخْرَی ، فَقَالَ رَجُلٌ مِنَ الأَنْصَارِ : لَقَدْ تَرَکْت امْرَأَۃً لَوْ أَنَّ الْجَدَّتَیْنِ مَاتَتَا وَابْنُہُمَا حَیٌّ مَا وَرِثَ مِنَ الَّتِی وَرَّثْتہَا مِنْہُ شَیْئًا ، وَوَرِثَ الَّتِی تَرَکَتَ : أَمَّ أَبِیہِ ! فَوَرَّثَہَا أَبُو بَکْرٍ ، فَشَرَّکَ بَیْنَہُمَا فِی السُّدُسِ۔ (سعید بن منصور ۸۲)","","Musannaf Ibn Abi Shaybah 31942","","","كتاب الفرائض"
"31943","(۳۱۹۴۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی الزِّنَادِ : سَمِعْت خَارِجَۃَ بْنَ زَیْدٍ وَسُلَیْمَانَ بْنَ یَسَارٍ وَطَلْحَۃَ بْنَ عَبْدِ اللہِ بْنِ عَوْفٍ یَقُولُونَ : إذَا کَانَتِ الْجَدَّۃُ الَّتِی مِنْ قِبَلِ الأُمِّ أَقْرَبَ فَہِیَ أَحَقُّ بِہِ۔","","Musannaf Ibn Abi Shaybah 31943","","","كتاب الفرائض"
"31944","(۳۱۹۴۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا بَشِیرٌ ، عَنْ عَبْدِ اللہِ بْنِ ذَکْوَانَ ، عَنْ خَارِجَۃَ بْنِ زَیْدٍ ، قَالَ : إذَا کَانَتِ الْجَدَّۃُ مِنْ قِبَلِ الأُمِّ أَقْعَدَ مِنَ الْجَدَّۃِ الَّتِی مِنْ قِبَلِ الأَبِ کَانَ السُّدُسُ لَہَا ، وَإِذَا کَانَتِ الْجَدَّۃُ مِنْ قِبَلِ الأَبِ أَقْعَدَ مِنَ الْجَدَّۃِ مِنْ قِبَلِ الأُمِّ کَانَ بَیْنَہُمَا السُّدُسُ۔","","Musannaf Ibn Abi Shaybah 31944","","","كتاب الفرائض"
"31945","(۳۱۹۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا فِطْرٌ ، عَنْ شَیْخٍ مِنْ أَہْلِ الْمَدِینَۃِ ، عَنْ خَارِجَۃَ بْنِ زَیْدٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، قَالَ : إذَا کَانَتِ الْجَدَّۃُ مِنْ قِبَلِ الأُمِّ ہِیَ أَقْعَدَ مِنَ الْجَدَّۃِ مِنْ قِبَلِ الأَبِ کَانَ لَہَا السُّدُسُ ، وَإِذَا کَانَتِ الْجَدَّۃُ مِنْ قِبَلِ الأَبِ أَقْعَدُ مِنَ الْجَدَّۃِ مِنْ قِبَلِ الأُمِّ کَانَ السُّدُسُ بَیْنَہُمَا۔","Da'if","Musannaf Ibn Abi Shaybah 31945","","","كتاب الفرائض"
"31946","(۳۱۹۴۶) حَدَّثَنَا حَفْصٌ بْنِ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ وَزَیْدٍ ، قَالاَ فِی الْجَدَّاتِ : السَّہْمُ لِذَوِی الْقُرْبَی مِنْہُنَّ۔","Da'if","Musannaf Ibn Abi Shaybah 31946","","","كتاب الفرائض"
"31947","(۳۱۹۴۷) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ مُحَمَّدٍ ، قَالَ : الْجَدَّتَانِ : أَیُّہُمَا أَقْرَبُ فَلَہَا الْمِیرَاثُ۔","","Musannaf Ibn Abi Shaybah 31947","","","كتاب الفرائض"
"31948","(۳۱۹۴۸) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ عَمَّارٍ مَوْلَی بَنِی ہَاشِمٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ : فِی الْجَدَّاتِ إذَا کَانَتِ الْجَدَّۃُ أَقْرَبَ فَہِیَ أَحَقُّ۔","Sahih","Musannaf Ibn Abi Shaybah 31948","","","كتاب الفرائض"
"31949","(۳۱۹۴۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، عَنْ سُلَیْمَان الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : لاَ تَحْجُبُ الْجَدَّاتِ إلاَّ الأُمُّ۔","Sahih","Musannaf Ibn Abi Shaybah 31949","","","كتاب الفرائض"
"31950","(۳۱۹۵۰) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ : سَمِعَ سَعِیدُ بْنُ الْمُسَیَّبِ : أَنَّ عُمَرَ وَرَّثَ جَدَّۃَ رَجُلٍ مِنْ ثَقِیفٍ مَعَ ابْنِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 31950","","","كتاب الفرائض"
"31951","(۳۱۹۵۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، قَالَ : کَانَ عَبْدُ اللہِ یُوَرِّثُ الْجَدَّۃَ مَعَ ابْنِہَا وَابْنُہَا حَیٌّ۔","Sahih","Musannaf Ibn Abi Shaybah 31951","","","كتاب الفرائض"
"31952","(۳۱۹۵۲) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، عَنْ أَبِی الدَّہْمَائِ ، قَالَ : قَالَ عِمْرَانُ بْنُ حُصَیْنٍ : تَرِثُ الْجَدَّۃُ وَابْنُہَا حَیٌّ۔","Sahih","Musannaf Ibn Abi Shaybah 31952","","","كتاب الفرائض"
"31953","(۳۱۹۵۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَطْعَمَ جَدَّۃً مِنَ ابْنِہَا السُّدُسَ ، فَکَانَتْ أَوَّلَ جَدَّۃٍ وَرِثَتْ فِی الإسْلاَمِ۔ (عبدالرزاق ۱۹۰۹۳)q","Da'if","Musannaf Ibn Abi Shaybah 31953","","","كتاب الفرائض"
"31954","(۳۱۹۵۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ الْحِمْیَرِیِّ ، عَنْ أَبِیہِ ، قَالَ : مَاتَ ابْنٌ لِحَسَکَۃَ الْحَنْظَلِیُّ وَتَرَکَ حَسْکَۃَ وَأَمَّ حَسْکَۃَ ، فَکَتَبَ فِیہَا أَبُو مُوسَی إلَی عُمَرَ بْنِ الْخَطَّابِ ، فَکَتَبَ إلَیْہِ عُمَرُ : أَنْ وَرِّثْہَا مَعَ ابْنِہَا السُّدُسَ۔","","Musannaf Ibn Abi Shaybah 31954","","","كتاب الفرائض"
"31955","(۳۱۹۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ وَہَمَّامٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، عَنْ شُرَیْحٍ : أَنَّہُ وَرَّثَ جَدَّۃً مَعَ ابْنِہَا۔n(عبدالرزاق ۱۹۰۹۵)","","Musannaf Ibn Abi Shaybah 31955","","","كتاب الفرائض"
"31956","(۳۱۹۵۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ یُوَرِّثُ الْجَدَّۃَ وَابْنُہَا حَیٌّ۔","","Musannaf Ibn Abi Shaybah 31956","","","كتاب الفرائض"
"31957","(۳۱۹۵۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ : أَنَّہُ کَانَ یُوَرِّثُ الْجَدَّۃَ مَعَ ابْنِہَا ، وَابْنُہَا حَیٌّ۔","","Musannaf Ibn Abi Shaybah 31957","","","كتاب الفرائض"
"31958","(۳۱۹۵۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، أَنَّہُ قَالَ : أَوَّلُ جَدَّۃٍ أُطْعِمَتِ السُّدُسُ فِی الإسْلاَمِ جَدَّۃٌ أُطْعِمَتْہُ وَابْنُہَا حَیٌّ۔","","Musannaf Ibn Abi Shaybah 31958","","","كتاب الفرائض"
"31959","(۳۱۹۵۹) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، عَنْ شُرَیْحٍ : أَنَّہُ وَرَّثَ جَدَّتَیْنِ : أُمَّ أُمٍّ ، وَأُمَّ أَبٍ ، وَابْنَہُمَا حَیٌّ۔","","Musannaf Ibn Abi Shaybah 31959","","","كتاب الفرائض"
"31960","(۳۱۹۶۰) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِاللہِ الزُّبَیْرِیُّ، عَنْ سُفْیَانَ، عَنْ ہِشَامٍ، عَنْ أَبِیہِ: أَنَّہُ کَانَ یُوَرِّثُ الْجَدَّۃَ وَابْنُہَا حَیٌّ۔","","Musannaf Ibn Abi Shaybah 31960","","","كتاب الفرائض"
"31961","(۳۱۹۶۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، قَالَ : مَنَعَہَا ابْنُہَا الْمِیرَاثَ۔","Sahih","Musannaf Ibn Abi Shaybah 31961","","","كتاب الفرائض"
"31962","(۳۱۹۶۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ : أَنَّ عُثْمَانَ کَانَ لاَ یُوَرِّثُ الْجَدَّۃَ أُمَّ الأَبِ وَابْنُہَا حَیٌّ ، قَالَ الزُّہْرِیُّ : وَتُوُفِّیَ ابْنُ الزُّبَیْرِ فَلَمْ یُوَرِّثْ۔","","Musannaf Ibn Abi Shaybah 31962","","","كتاب الفرائض"
"31963","(۳۱۹۶۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَسَّامٍ ، عَنْ فُضَیْلٍ ، قَالَ : قَالَ إبْرَاہِیمُ : لاَ تَرِثُ الْجَدَّۃُ مَعَ ابْنِہَا إذَا کَانَ حَیًّا ، فِی قَوْلِ عَلِیٍّ وَزَیْدٍ۔n قَالَ أَبُو بَکْرٍ : سَمِعْت وَکِیعًا یَقُولُ : النَّاسُ عَلَی ہَذَا۔","","Musannaf Ibn Abi Shaybah 31963","","","كتاب الفرائض"
"31964","(۳۱۹۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لَمْ یُوَرِّثْ أَحَدٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْجَدَّۃَ مَعَ ابْنِہَا إلاَّ ابْنُ مَسْعُودٍ۔","Da'if","Musannaf Ibn Abi Shaybah 31964","","","كتاب الفرائض"
"31965","(۳۱۹۶۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : أَنَّ زَیْدًا لَمْ یَکُن یَجْعَلْ لِلْجَدَّۃِ مَعَ ابْنِہَا مِیرَاثًا۔","Sahih","Musannaf Ibn Abi Shaybah 31965","","","كتاب الفرائض"
"31966","(۳۱۹۶۶) حَدَّثَنَا یَزِیدُ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ وَزَیْدٍ : أَنَّہُمَا لَمْ یَکُونَا یَجْعَلاَنِ لِلْجَدَّۃِ مَعَ ابْنِہَا مِیرَاثًا۔","Da'if","Musannaf Ibn Abi Shaybah 31966","","","كتاب الفرائض"
"31967","(۳۱۹۶۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ مَکْحُولٍ ، قَالَ : ابْنُ الْمُلاعَنَۃ تَرِثُ أُمُّہُ مِیرَاثَہُ کُلَّہُ۔","","Musannaf Ibn Abi Shaybah 31967","","","كتاب الفرائض"
"31968","(۳۱۹۶۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَقُولُ : لِلْمُلاَعِنَۃِ مِیرَاثُ وَلَدِہَا کُلُّہُ۔","","Musannaf Ibn Abi Shaybah 31968","","","كتاب الفرائض"
"31969","(۳۱۹۶۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عُمَر بْنِ عَامِرٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ، قَالَ فِی وَلَدِ الْمُلاعَنَۃ : مِیرَاثُہُ کُلُّہُ لأُمِّہِ ، فَإِنْ لَمْ یَکُنْ لَہُ أُمٌّ فَہُوَ لِعَصَبَتِہِ۔n وَقَالَ إبْرَاہِیمُ : مِیرَاثُہُ کُلُّہُ لأُمِّہِ ، وَیَعْقِلُ عَنْہُ عَصَبَتُہَا ، وَکَذَلِکَ وَلَدُ الزِّنَا وَوَلَدُ النَّصْرَانِیِّ وَأُمُّہُ مُسْلِمَۃٌ۔","","Musannaf Ibn Abi Shaybah 31969","","","كتاب الفرائض"
"31970","(۳۱۹۷۰) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ : فِی ابْنِ الْمُلاعَنَۃ : مِیرَاثُہُ لأُمِّہِ ، فَإِنْ کَانَتْ أُمُّہُ قَدْ مَاتَتْ یَرِثُہُ وَرَثَتُہَا۔","","Musannaf Ibn Abi Shaybah 31970","","","كتاب الفرائض"
"31971","(۳۱۹۷۱) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : یَرِثُ ابْنُ الْمُلاعَنَۃ أُمَّہُ ، فَإِذَا مَاتَ وَرِثَہُ مَنْ کَانَ یَرِثُ أُمَّہُ۔","","Musannaf Ibn Abi Shaybah 31971","","","كتاب الفرائض"
"31972","(۳۱۹۷۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ: حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ، عَنْ عَبْدِ اللہِ ، قَالَ: مِیرَاثُ ابْنِ الْمُلاعَنَۃ لأُمِّہِ۔","","Musannaf Ibn Abi Shaybah 31972","","","كتاب الفرائض"
"31973","(۳۱۹۷۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ عَلِیٍّ وَزَیْدٍ : فِی ابْنِ الْمُلاعَنَۃ ، قَالاَ : الثُّلُثُ لأُمِّہِ ، وَمَا بَقِیَ فِی بَیْتِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 31973","","","كتاب الفرائض"
"31974","(۳۱۹۷۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ ، قَالَ : تَرِثُہُ مِیرَاثَہَا ، وَبَقِیَّتُہُ فِی بَیْتِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 31974","","","كتاب الفرائض"
"31975","(۳۱۹۷۵) حَدَّثَنَا مَعْن بْنُ عِیسَی ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ عُرْوَۃَ : فِی ابْنِ الْمُلاعَنَۃ وَوَلَدِ الزِّنَا إذَا مَاتَ : وَرِثَتْہُ أُمُّہُ حَقَّہَا فِی کِتَابِ اللہِ وَإِخْوَتُہُ لأُمِّہِ حُقُوقَہُمْ ، وَکَانَ مَا بَقِیَ لِلْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 31975","","","كتاب الفرائض"
"31976","(۳۱۹۷۶) حدَّثَنَا عِیسَی ، عَنْ مَالِکٍ ، أَنَّہُ بَلَغَہُ عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 31976","","","كتاب الفرائض"
"31977","(۳۱۹۷۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : مَارَأْیُ إبْرَاہِیمَ بْنِ یَزِیدَ فِی ابْنِ الْمُلاعَنَۃ ؟ فَقُلْتُ : یَلْحَقُ بِأُمِّہِ ، وَقَالَ إبْرَاہِیمُ : یَلْحَقُ بِأَبِیہِ ، فَأَتَیْنَا عَبْدَ اللہِ بْنَ ہُرْمُزَ ، فَکَتَبَ لَنَا إلَی الْمَدِینَۃِ إلَی أَہْلِ الْبَیْتِ الَّذِی کَانَ ذَلِکَ فِیہِمْ ، فَجَائَ جَوَابُ کِتَابِہِمْ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَلْحَقَہُ بِأُمِّہِ۔n(عبدالرزاق ۱۲۴۸۶)","","Musannaf Ibn Abi Shaybah 31977","","","كتاب الفرائض"
"31978","(۳۱۹۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : کَتَبْت إلَی أَخٍ لِی فِی بَنِی زُرَیْقٍ : لِمَنْ قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِابْنِ الْمُلاعَنَۃ ؟ فَکَتَبَ إلَیَّ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی بِہِ لأُمِّہِ ، ہِیَ بِمَنْزِلَۃِ أَبِیہِ وَمَنْزِلَۃِ أُمِّہِ۔n(ابوداؤد ۳۶۲۔ عبدالرزاق ۱۲۴۷۷)","","Musannaf Ibn Abi Shaybah 31978","","","كتاب الفرائض"
"31979","(۳۱۹۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ وَعَبْدِ اللہِ ، أَنَّہُمَا قَالاَ فِی ابْنِ الْمُلاعَنْۃ : عَصَبَتُہُ عَصَبَۃُ أُمِّہِ۔","Da'if","Musannaf Ibn Abi Shaybah 31979","","","كتاب الفرائض"
"31980","(۳۱۹۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُوسَی بْنُ عُبَیْدَۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : ابْنُ الْمُلاعَنَۃ عَصَبَتُہُ عَصَبَۃُ أُمِّہِ یَرِثُہُمْ وَیَرِثُونَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 31980","","","كتاب الفرائض"
"31981","(۳۱۹۸۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : ابْنُ الْمُلاعَنَۃ عَصَبَتُہُ عَصَبَۃُ أُمِّہِ ، یَرِثُونَہُ وَیَعْقِلُونَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 31981","","","كتاب الفرائض"
"31982","(۳۱۹۸۲) حَدَّثَنَا أَسْبَاطُ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : یَرِثُہُ أَقْرَبُ النَّاسِ إِلَی أُمِّہِ۔","","Musannaf Ibn Abi Shaybah 31982","","","كتاب الفرائض"
"31983","(۳۱۹۸۳) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، قَالاَ : ابْنُ الْمُلاعَنْۃ یَرِثُہُ مَنْ یَرِثُ أُمَّہُ۔","","Musannaf Ibn Abi Shaybah 31983","","","كتاب الفرائض"
"31984","(۳۱۹۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمْزَۃُ الزَّیَّاتُ ، عَنْ رَجُلٍ یُقَالَ لَہُ : عُمَرُ ، عَنِ الشَّعْبِیِّ : فِی ابْنِ مُلاعَنَۃٍ مَاتَ وَتَرَکَ خَالَہُ وَخَالَتَہُ ، قَالَ : الْمَالُ لِلْخَالِ۔","","Musannaf Ibn Abi Shaybah 31984","","","كتاب الفرائض"
"31985","(۳۱۹۸۵) حدَّثَنَا وَکِیعٌ ، قَالَ : قَالَ حَمْزَۃُ : وَکَانَ ابْنُ أَبِی لَیْلَی یَقُولُ : لِلْخَالِ الثُّلُثَانِ وَلِلْخَالَۃِ الثُّلُثُ۔","","Musannaf Ibn Abi Shaybah 31985","","","كتاب الفرائض"
"31986","(۳۱۹۸۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَمَّنْ سَمِعَ الشَّعْبِیَّ یَقُولُ : فِی ابْنِ مُلاَعَنَۃٍ مَاتَ وَتَرَکَ ابْنَ أَخِیہِ وَجَدَّہُ أَبَا أُمِّہِ ، قَالَ : الْمَالُ لابْنِ الأَخِ۔","","Musannaf Ibn Abi Shaybah 31986","","","كتاب الفرائض"
"31987","(۳۱۹۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ عَمَّنْ سَمِعَ الشَّعْبِیَّ ، عَنْ عَلِیٍّ وَعَبْدِ اللہِ ، أَنَّہُمَا قَالاَ فِی ابْنِ مُلأَعَنْۃٍ مَاتَ وَتَرَکَ أُمَّہُ وَأَخَاہُ لأُمِّہِ ، قَالَ : کَانَ عَلِیٌّ یَقُولُ : لِلأُمِّ الثُّلُثُ ، وَلِلأَخِ السُّدُسُ ، وَیَرُدُّ مَا بَقِیَ عَلَیْہِمَا الثُّلُثَانِ وَالثُّلُثُ ، وَکَانَ ابْنُ مَسْعُودٍ یَقُولُ : لِلأُمِّ الثُّلُثُ ، وَلِلأَخِ السُّدُسُ ، وَیَرُدُّ مَا بَقِیَ عَلَی الأُمِّn قَالَ أَبُو بَکْرٍ : فَہَذِہِ مِنْ قَوْلِہِمْ جَمِیعًا تَصِیرُ مِنْ سِتَّۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 31987","","","كتاب الفرائض"
"31988","(۳۱۹۸۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی الْمِنْہَالِ ، عَنْ إیَاسِ بْنِ عَبْدٍ ، الْمُزَنِیّ : أَنَّہُ سُئِلَ عَنْ أُنَاسٍ سَقَطَ عَلَیْہِمْ بَیْتٌ فَمَاتُوا جَمِیعًا ؟ فَوَرِثَ بَعْضُہُمْ مِنْ بَعْضٍ۔","Sahih","Musannaf Ibn Abi Shaybah 31988","","","كتاب الفرائض"
"31989","(۳۱۹۸۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، قَالَ : أَخْبَرَنِی قَطَنُ بْنُ عَبْدِ اللہِ الضَّبِّیُّ : أَنَّ امْرَأَۃً رَکِبَتِ الْفُرَاتِ وَمَعَہَا ابْنٌ لَہَا فَغَرِقَا جَمِیعًا ، فَلَمْ یُدْرَ أَیُّہُمَا مَاتَ قَبْلَ صَاحِبِہِ فَأَتَیْنَا شُرَیْحًا فَأَخْبَرْنَاہُ بِذَلِکَ ، فَقَالَ : وَرِثُوا کُلَّ وَاحِدٍ مِنْہُمَا مِنْ صَاحِبِہِ ، وَلاَ تَرُدُّوا عَلَی وَاحِدٍ مِنْہُمَا مِمَّا وَرِثَ مِنْ صَاحِبِہِ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 31989","","","كتاب الفرائض"
"31990","(۳۱۹۹۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی الزَّعْرَائِ عَمْرِو بْنِ عَمْرٍو الْجُشَمِیِّ ، عَنْ عَبْدِ اللہِ بْنِ عُتْبَۃَ - وَکَانَ قَاضِیًا لابْنِ الزُّبَیْرِ - : أَنَّہُ وَرَّثَ الْغَرْقَی بَعْضَہُمْ مِنْ بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 31990","","","كتاب الفرائض"
"31991","(۳۱۹۹۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سِمَاکٍ ، عَنْ رَجُلٍ ، عَنْ عُمَرَ ، أَنَّہُ وَرَّثَ قَوْمًا غَرِقُوا بَعْضَہُمْ مِنْ بَعْضٍ۔","Da'if","Musannaf Ibn Abi Shaybah 31991","","","كتاب الفرائض"
"31992","(۳۱۹۹۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی حُصَینٍ : أَنَّ قَوْمًا غَرِقُوا عَلَی جِسْرِ مَنْبِجٍ ، فَوَرَّثَ عُمَرُ بَعْضَہُمْ مِنْ بَعْضٍ ، قَالَ سُفْیَانُ لأَبِی حُصَیْنٍ : مِنَ الشَّعْبِیِّ سَمِعْتہ ، قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 31992","","","كتاب الفرائض"
"31993","(۳۱۹۹۳) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ : أَنَّ أَہْلَ بَیْتٍ غَرِقُوا فِی سَفِینَۃٍ ، فَوَرَّثَ عَلِیٌّ بَعْضَہُمْ مِنْ بَعْضٍ۔","Da'if","Musannaf Ibn Abi Shaybah 31993","","","كتاب الفرائض"
"31994","(۳۱۹۹۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، عَنْ عَبِیدَۃَ : أَنَّ قَوْمًا وَقَعَ عَلَیْہِمْ بَیْتٌ ، أَوْ مَاتُوا فِی طَاعُونٍ ، فَوَرَّثَ عُمَرُ بَعْضَہُمْ مِنْ بَعْضٍ۔","Da'if","Musannaf Ibn Abi Shaybah 31994","","","كتاب الفرائض"
"31995","(۳۱۹۹۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ حُرَیسِ الْبَجَلِیِّ ، عَنْ أَبِیہِ : أَنَّ رَجُلاً وَابْنَہُ - أَوْ أَخَوَیْنِ - قُتِلاَ یَوْمَ صِفِّینَ جَمِیعًا ، لاَ یُدْرَی أَیُّہُمَا قُتِلَ أَوَّلاً ، قَالَ : فَوَرَّثَ عَلِیٌّ کُلَّ وَاحِدٍ مِنْہُمَا صَاحِبَہُ۔n(عبدالرزاق ۱۹۱۵۲۔ دارمی ۳۰۴۸)","Da'if","Musannaf Ibn Abi Shaybah 31995","","","كتاب الفرائض"
"31996","(۳۱۹۹۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ رَجُلٍ ، عَنْ قَبِیصَۃَ بْنِ ذُؤَیْبٍ : أَنَّ طَاعُونًا وَقَعَ بِالشَّامِ ، فَکَانَ أَہْلُ الْبَیْتِ یَمُوتُونَ جَمِیعًا ، فَکَتَبَ عُمَرُ أَنْ یُوَرَّثُ الأَعْلَی مِنَ الأَسْفَلِ ، وَإِذَا لَمْ یَکُونُوا کَذَلِکَ وَرَّثَ ہَذَا مِنْ ذَا ، وَہَذَا مِنْ ذَا۔n قَالَ سَعِیدٌ : الأَعْلَی مِنَ الأَسْفَلِ : کَانَ الْمَیِّتُ مِنْہُمْ یَمُوتُ وَقَدْ وَضَعَ یَدُہُ عَلَی آخَرَ إلَی جَنْبِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 31996","","","كتاب الفرائض"
"31997","(۳۱۹۹۷) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عَلِیٍّ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 31997","","","كتاب الفرائض"
"31998","(۳۱۹۹۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، قَالَ إبْرَاہِیمُ : فِی الْقَوْمِ یَمُوتُونَ لاَ یُدْرَی أَیُّہُمْ مَاتَ قَبْلُ ، قَالَ : یُوَرَّثُ بَعْضُہُمْ مِنْ بَعْضٍ۔n قَالَ مَنْصُورٌ : لاَ یَضُرُّک بِأَیِّہِمْ بَدَأْت إذَا وَرَّثْت بَعْضَہُمْ مِنْ بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 31998","","","كتاب الفرائض"
"31999","(۳۱۹۹۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ : أَنَّہُ کَانَ یُوَرِّثُ الأَحْیَائَ مِنَ الأَمْوَاتِ ، وَلاَ یُوَرِّثُ الْغَرْقَی بَعْضَہُمْ مِنْ بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 31999","","","كتاب الفرائض"
"32000","(۳۲۰۰۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، قَالَ : کَانَ فِی کِتَابِ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ : یَرِثُ کُلُّ إنْسَانٍ وَارِثُہُ مِنَ النَّاسِ۔","","Musannaf Ibn Abi Shaybah 32000","","","كتاب الفرائض"
"32001","(۳۲۰۰۱) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : أَتَتْہُ امْرَأَۃٌ فَقَالَتْ : إنَّ أَخِی وَابْنَ أَخِی خَرَجَا فِی سَفِینَۃٍ فَغَرِقَا ، فَلَمْ یُوَرِّثْہُمَا شَیْئًا۔","","Musannaf Ibn Abi Shaybah 32001","","","كتاب الفرائض"
"32002","(۳۲۰۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حُسَیْنٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یَرِثُ وَاحِدٌ مِنْہُمَا مِمَّا وَرِثَ مِنْ صَاحِبِہِ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 32002","","","كتاب الفرائض"
"32003","(۳۲۰۰۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ فِی الَّذِینَ یَمُوتُونَ جَمِیعًا ، لاَ یُدْرَی أیُّہُمْ مَاتَ قَبْلَ صَاحِبِہِ ، قَالَ : لاَ یُوَرَّثُ بَعْضُہُمْ مِنْ بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 32003","","","كتاب الفرائض"
"32004","(۳۲۰۰۴) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ جَہْمٍ ، عَنْ إبْرَاہِیمَ : أَنَّ عَلِیًّا وَرَّثَ ثَلاَثَۃً غَرِقُوا فِی سَفِینَۃٍ بَعْضَہُمْ مِنْ بَعْضٍ وَأُمُّہُمْ حَیَّۃٌ ، فَوَرَّثَ أُمَّہُمُ السُّدُسَ مِنْ صُلْبِ کُلِّ وَاحِدٍ مِنْہُمْ ، ثُمَّ وَرَّثَہَا الثُّلُثَ بِمَا وَرِثَ کُلُّ وَاحِدٍ مِنْ صَاحِبِہِ ، وَجَعَلَ مَا بَقِیَ لِلْعَصَبَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 32004","","","كتاب الفرائض"
"32005","(۳۲۰۰۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنْ إبْرَاہِیمَ وَالشَّعْبِیِّ : أَنَّہُ سَمِعَہُمَا یُفَسِّرَانِ قَوْلَہُمْ : یُوَرَّثُ بَعْضُہُمْ مِنْ بَعْضٍ ، قَالاَ : إذَا مَاتَ أَحَدُہُمَا وَتَرَکَ مَالا ، وَلَمْ یَتْرُکَ الآخَرُ شَیْئًا ، وَرِثَ وَرَثَۃُ الَّذِی لَمْ یَتْرُکْ شَیْئًا مِیرَاثَ صَاحِبِ الْمَالِ ، وَلَمْ یَکُنْ لِوَرَثَۃِ صَاحِبِ الْمَالِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 32005","","","كتاب الفرائض"
"32006","(۳۲۰۰۶) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : مِیرَاثُ اللَّقِیطِ بِمَنْزِلَۃِ اللُّقَطَۃِ۔","","Musannaf Ibn Abi Shaybah 32006","","","كتاب الفرائض"
"32007","(۳۲۰۰۷) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنِ الْحَارِثِ بْنِ حَصِیرَۃ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، قَالَ : لَمَّا رَجَمَ عَلِیٌّ الْمَرْأَۃَ ، قَالَ لاَہْلِہَا : ہَذَا ابْنُکُمْ تَرِثُونَہُ ، وَیَرِثُکُمْ ، وَإِنْ جَنَی جِنَایَۃً فَعَلَیْکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 32007","","","كتاب الفرائض"
"32008","(۳۲۰۰۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ وَعَبْدِ اللہِ : فِی ابْنِ الْمُلاعَنَۃ : أُمُّہُ عَصَبَتُہُ وَعَصَبَتُہَا عَصَبَتُہُ وَوَلَدُ الزِّنَا بِمَنْزِلَتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 32008","","","كتاب الفرائض"
"32009","(۳۲۰۰۹) حَدَّثَنَا عَبَّادُ ، عَنْ عُمَرَ بْنِ عَامِرٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : مِیرَاثُہُ کُلُّہُ لأُمِّہِ - یَعْنِی : ابْنَ الْمُلاعَنَۃ - ، وَیَعْقِلُ عَنْہُ عَصَبَتُہَا ، وَکَذَلِکَ وَلَدُ الزِّنَا ، وَوَلَدُ النَّصْرَانِیِّ وَأُمُّہُ مُسْلِمَۃٌ۔","","Musannaf Ibn Abi Shaybah 32009","","","كتاب الفرائض"
"32010","(۳۲۰۱۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : وَلَدُ الْمُلاعَنَۃ وَوَلَدُ الزِّنَا : یَتَوَارَثَانِ مِنْ قِبَلِ الأُمِّ۔","","Musannaf Ibn Abi Shaybah 32010","","","كتاب الفرائض"
"32011","(۳۲۰۱۱) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : وَلَدُ الزِّنَا بِمَنْزِلَۃِ ابْنِ الْمُلاعَنَۃ ، أَو ابْنُ الْمُلاعَنَۃ بِمَنْزِلَۃِ وَلَدِ الزِّنَا۔","","Musannaf Ibn Abi Shaybah 32011","","","كتاب الفرائض"
"32012","(۳۲۰۱۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَشْعَثِ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَتَبَ ہِشَامُ بْنُ ہُبَیْرَۃَ إلَی شُرَیْحٍ یَسْأَلُہُ عَنْ مِیرَاثِ وَلَدِ الزِّنَا ؟ فَکَتَبَ إلَیْہِ : ارْفَعْہُ إلَی السُّلْطَانِ فَلْیَلِ حُزُونَتَہُ وَسُہُولَتَہُ۔","","Musannaf Ibn Abi Shaybah 32012","","","كتاب الفرائض"
"32013","(۳۲۰۱۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ، عَنْ إبْرَاہِیمَ، عَنِ الْحَسَنِ بْنِ الْحُرّ، عَنِ الْحَکَمِ، قَالَ: وَلَدُ الزِّنَا وَوَلَدُ الْمُتَلاعَنْینَ تَرِثُہُمَا أُمُّہُمَا وَأَخْوَالُہُمَا۔","","Musannaf Ibn Abi Shaybah 32013","","","كتاب الفرائض"
"32014","(۳۲۰۱۴) حَدَّثَنَا ہُشَیْمٌ، عَنْ مُغِیرَۃَ، عَنْ شِبَاکٍ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ: فِی الْخُنْثَی ، قَالَ: یُوَرَّثُ مِنْ قِبَلِ مَبَالِہِ۔","","Musannaf Ibn Abi Shaybah 32014","","","كتاب الفرائض"
"32015","(۳۲۰۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْحَسَنُ بْنُ کَثِیرٍ الأَحْمَسِیُّ ، عَنْ أَبِیہِ : أَنَّ مُعَاوِیَۃَ أُتِیَ فِی خُنْثَی فَأَرْسَلِہُمْ إلَی عَلِیّ ، فَقَالَ : یُوَرَّثُ مِنْ حَیْثُ یَبُولُ۔","Da'if","Musannaf Ibn Abi Shaybah 32015","","","كتاب الفرائض"
"32016","(۳۲۰۱۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ وَالْحَسَنِ : فِی الْخُنْثَی ، قَالاَ : یُوَرَّثُ مِنْ مَبَالِہِ۔n قَالَ قَتَادَۃُ : فَذَکَرْتُ ذَلِکَ لِسَعِیدِ بْنِ الْمُسَیَّبِ ، فَقَالَ : نَعَمْ ، وَإِنْ بَالَ مِنْہُمَا جَمِیعًا فَمِنْ أَیِّہِمَا سَبَقَ۔","","Musannaf Ibn Abi Shaybah 32016","","","كتاب الفرائض"
"32017","(۳۲۰۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُمَرُ بْنُ بَشِیرٍ الْہَمْدَانِیُّ ، عَنِ الشَّعْبِیِّ : فِی مَوْلُودٍ وُلِدَ لَیْسَ لَہُ مَا لِلذَّکَرِ ، وَلاَ مَا لِلأُنْثَی ، یَبُولُ منْ سُرَّتِہِ ! قَالَ : لَہُ نِصْفُ حَظِّ الأُنْثَی وَنِصْفُ حَظِّ الذَّکَرِ۔","","Musannaf Ibn Abi Shaybah 32017","","","كتاب الفرائض"
"32018","(۳۲۰۱۸) حَدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ الْعَدَنِیِّ ، عَنْ أَبِی جَعْفَرٍ : فِی الْخُنْثَی یُوَرَّثُ مِنْ مَبَالِہِ ، وَإِنْ بَالَ مِنْہُمَا جَمِیعًا فَمِنْ أَیِّہِمَا سَبَقَ۔","","Musannaf Ibn Abi Shaybah 32018","","","كتاب الفرائض"
"32019","(۳۲۰۱۹) حَدَّثَنَا جَرِیرٌ، عَنْ لَیْثٍ، عَنْ حَمَّادٍ، عَنْ إبْرَاہِیمَ، قَالَ: لَمْ یَکُنْ أَبُوبَکْرٍ وَعُمَرُ وَعُثْمَان یُوَرِّثُونَ الْحَمِیلَ۔","Da'if","Musannaf Ibn Abi Shaybah 32019","","","كتاب الفرائض"
"32020","(۳۲۰۲۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَبِی طَلْقٍ ، عَنْ أَبِیہِ ، قَالَ : أَدْرَکْت الْحُمَلاَئَ فِی زَمَانِ عَلِیٍّ وَعُثْمَانَ لاَ یُوَرَّثُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 32020","","","كتاب الفرائض"
"32021","(۳۲۰۲۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَابْنِ سِیرِینَ ، قَالاَ : مَا یُوَرَّثُ الْحَمِیلُ إلاَّ بِبَیِّنَۃٍ۔","","Musannaf Ibn Abi Shaybah 32021","","","كتاب الفرائض"
"32022","(۳۲۰۲۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَلِیُّ بْنُ الْمُبَارَکِ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ : أَنَّ عُمَرَ کَتَبَ : أَنْ لاَ یُوَرَّثُ بِوِلاَدَۃِ الشِّرْکِ۔","","Musannaf Ibn Abi Shaybah 32022","","","كتاب الفرائض"
"32023","(۳۲۰۲۳) حَدَّثَنَا ابْنُ نُمَیْرٍ، قَالَ: حدَّثَنَا مُجَالِدٌ، عَنِ الشَّعْبِیِّ، قَالَ: کُتِبَ إلَی شُرَیْحٍ أَنْ لاَ یُوَرَّثَ حَمِیلٌ إلاَّ بِبَیِّنَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 32023","","","كتاب الفرائض"
"32024","(۳۲۰۲۴) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : ذُکِرَ لِمُحَمَّدٍ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ فِی الْحُمَلاَئِ: لاَ یُوَرَّثُونَ إلاَّ بِشَہَادَۃِ الشُّہُودِ ، قَالَ : فَقَالَ مُحَمَّدٌ : قَدْ تَوَارَثَ الْمُہَاجِرُونَ وَالأَنْصَارُ بِنَسَبِہِمَ الَّذِی کَانَ فِی الْجَاہِلِیَّۃِ ، فَأَنَا أُنْکِرُ أَنْ یَکُونَ عُمَرُ کَتَبَ بِہَذَا۔","","Musannaf Ibn Abi Shaybah 32024","","","كتاب الفرائض"
"32025","(۳۲۰۲۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَتَوَارَثُونَ بِالأَرْحَامِ الَّتِی یَتَوَاصَلُونَ بِہَا۔","","Musannaf Ibn Abi Shaybah 32025","","","كتاب الفرائض"
"32026","(۳۲۰۲۶) حَدَّثَنَا جَرِیرٌ ، عَنِ الأَعْمَشِ ، عَنْ إیَاسِ بْنِ عَبَّاسٍ ، عَنْ شَیْخٍ مِنْ قَوْمِہِ : أَنَّ أَبَا سُلَیْمَانَ غَرِقَ أَخٌ لَہُ یُقَالَ لَہُ : رَاشِدٌ ، فَاخْتَصَمَ فِیہِ بَنُو زَبِیدٍ وَبَنُو أَسَدٍ ، فَارْتَفَعُوا إلَی مَسْرُوقٍ ، فَقَالَ : مَسْرُوقٌ لِبَنِی أَسَدٍ : أَتَشْہَدُونَ أَنَّہُ کَانَ یَحْرُمُ عَنْہُ مَا یَحْرُمُ الأَخَ مِنْ أُخْتِہِ ، فَشَہِدُوا بِذَلِکَ ، فَأَعْطَی أَبَا سُلَیْمَانَ مِیرَاثَہُ۔","","Musannaf Ibn Abi Shaybah 32026","","","كتاب الفرائض"
"32027","(۳۲۰۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ سَمِعْت الأَعْمَشَ ، قَالَ : کَانَ أَبِی حَمِیلاً فَمَاتَ أَخُوہُ ، فَوَرَّثَہُ مَسْرُوقٌ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 32027","","","كتاب الفرائض"
"32028","(۳۲۰۲۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عُمَرُ : کُلّ نَسَبٍ یُتَوَصَل عَلَیْہِ فِی الإسْلاَمِ فَہُوَ وَارِثٌ مَوْرُوثٌ۔","","Musannaf Ibn Abi Shaybah 32028","","","كتاب الفرائض"
"32029","(۳۲۰۲۹) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ أَشْعَثَ، عَنِ الشَّعْبِیِّ، قَالَ: إذَا کَانَ نَسَبًا مَعْرُوفًا مَوْصُولاً وَرِثَ۔ یَعْنِی: الْحَمِیلَ۔","","Musannaf Ibn Abi Shaybah 32029","","","كتاب الفرائض"
"32030","(۳۲۰۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنِ الْحَمِیلِ ؟ فَقَالاَ : لاَ یَرِثُ إلاَّ بِبَیِّنَۃٍ۔","","Musannaf Ibn Abi Shaybah 32030","","","كتاب الفرائض"
"32031","(۳۲۰۳۱) حَدَّثَنَا عَبْدُالرَّحِیمِ بْنُ عَبْدِالرَّحْمَنِ الْمُحَارِبِیُّ، قَالَ: حدَّثَنَا زَائِدَۃُ بْنُ قُدَامَۃَ، قَالَ: حَدَّثَنَا أَشْعَثُ بْنُ أَبِی الشَّعْثَائِ، قَالَ: أَقَرَّتِ امْرَأَۃٌ مِنْ مُحَارِبٍ جَلِیبَۃٌ بِنَسَبِ أَخٍ لَہَا جَلِیبٌ، فَوَرَّثَہُ عَبْدُالرَّحْمَنِ بْن عُتْبَۃَ مِنْ أُخْتِہِ۔","","Musannaf Ibn Abi Shaybah 32031","","","كتاب الفرائض"
"32032","(۳۲۰۳۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْحَکَمُ بْنُ عَطِیَّۃَ ، قَالَ : سَأَلْتُ الْحَسَنَ عَنِ الْحَمِیلِ یُقِیمُ الْبَیِّنَۃَ أَنَّہُ أَخُوہُ ، قَالَ : یَرِثُہُ فِی کِتَابِ اللہِ {وَأُولُو الأَرْحَامِ بَعْضُہُمْ أَوْلَی بِبَعْضٍ فِی کِتَابِ اللہِ}۔","","Musannaf Ibn Abi Shaybah 32032","","","كتاب الفرائض"
"32033","(۳۲۰۳۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْوَلِیدِ بْنِ جُمَیْعٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَبْدِ اللہِ ، قَالَ : إذَا ارْتَدَّ الْمُرْتَدُّ وَرِثَہُ وَلَدُہُ۔","","Musannaf Ibn Abi Shaybah 32033","","","كتاب الفرائض"
"32034","(۳۲۰۳۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، عَنْ عَلِیٍّ : أَنَّہُ أُتِیَ بِمسْتورِد الْعِجْلِیّ وَقَدِ ارْتَدَ ، فَعَرَضَ عَلَیْہِ الإسْلاَمَ فَأَبَی فَقَتَلَہُ وَجَعَلَ مِیرَاثَہُ بَیْنَ وَرَثَتِہِ مِنَ الْمُسْلِمِینَ۔n(عبدالرزاق ۱۹۲۹۶۔ دارمی ۳۰۷۵)","Sahih","Musannaf Ibn Abi Shaybah 32034","","","كتاب الفرائض"
"32035","(۳۲۰۳۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ حَجَّاجٍ، عَنِ الْحَکَمِ، عَنْ عَلِیٍّ: فِی مِیرَاثِ الْمُرْتَدِّ: لِوَرَثَتِہِ مِنَ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 32035","","","كتاب الفرائض"
"32036","(۳۲۰۳۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : فِی مِیرَاثِ الْمُرْتَدِّ ، أَنَّہُ لِوَرَثَتِہِ مِنَ الْمُسْلِمِینَ ، وَلَیْسَ لأَہْلِ ۔۔ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 32036","","","كتاب الفرائض"
"32037","(۳۲۰۳۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، عَنِ الْحَسَنِ، قَالَ: یُقْتَلُ، وَمِیرَاثُہُ لِوَرَثَتِہِ مِنَ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 32037","","","كتاب الفرائض"
"32038","(۳۲۰۳۸) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرو ، عَنِ الْحَسَنِ ، قَالَ : جُعِلَ مِیرَاثُ الْمُرْتَدِّ لِوَرَثَتِہِ۔","","Musannaf Ibn Abi Shaybah 32038","","","كتاب الفرائض"
"32039","(۳۲۰۳۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُوسَی بْنِ أَبِی کَثِیرٍ قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ عَنْ مِیرَاثِ الْمُرْتَدِّ ، ہَلْ یُوصَلُ ؟ قَالَ : مَا یُوصَلُ ؟ قُلْتُ : یَرِثُہُ بَنُوہُ ، قَالَ نَرِثُہُمْ لاَ یَرِثُونَنَا۔","","Musannaf Ibn Abi Shaybah 32039","","","كتاب الفرائض"
"32040","(۳۲۰۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ أَبِی الصَّبَّاحِ مُوسَی بْنِ أَبِی کَثِیرٍ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ الْمُسَیَّبِ یَقُولُ : الْمُرْتَدُّونَ نَرِثُہُمْ ، وَلاَ یَرِثُونَنَا۔","","Musannaf Ibn Abi Shaybah 32040","","","كتاب الفرائض"
"32041","(۳۲۰۴۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ وَالْحَکَمِ ، قَالاَ : یُقَسَّمُ مِیرَاثُہُ بَیْنَ امْرَأَتِہِ وَبَیْنَ وَرَثَتِہِ مِنَ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 32041","","","كتاب الفرائض"
"32042","(۳۲۰۴۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَمِعْتُ سُفْیَانَ یَقُولُ : إذَا لَحِقَ بِدَارِ الْحَرْبِ ، ثُمَّ رَجَعَ قَبْلَ أَنْ یُقَسَّمَ مِیرَاثُہُ ، أَوْ یَعْتِقَ الْحَاکِمُ أُمَّہَاتِ أَوْلاَدِہِ وَمُدَبَّرَتَہُ فَہُوَ أَحَقُّ بِہِمْ۔","","Musannaf Ibn Abi Shaybah 32042","","","كتاب الفرائض"
"32043","(۳۲۰۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : کَانَ الْمُسْلِمُونَ یُطَیِّبُونَ لأَہْلِ الْمُرْتَدِّ مِیرَاثَہُ۔ یَعْنِی : إذَا قُتِلَ۔","","Musannaf Ibn Abi Shaybah 32043","","","كتاب الفرائض"
"32044","(۳۲۰۴۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ : أَنَّ قَتَادَۃَ - رَجُلاً مِنْ بَنِی مُدْلِجٍ - قَتَلَ ابْنَہُ ، فَأَخَذَ بِہِ عُمَرُ بْنُ الْخَطَّابِ مِئَۃ مِنَ الإِبِلِ : ثَلاَثِینَ حِقَّۃً ، وَثَلاَثِینَ جَذَعَۃً ، وَأَرْبَعِینَ خَلِفَۃً ، وَقَالَ لاَبِی الْمَقْتُولِ: سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ: لَیْسَ لِقَاتِلٍ مِیرَاثٌ۔(ابن ماجہ ۲۶۴۶۔ مالک ۸۶۷)","","Musannaf Ibn Abi Shaybah 32044","","","كتاب الفرائض"
"32045","(۳۲۰۴۵) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ عُمَرُ : لاَ یَرِثُ الْقَاتِلُ۔","","Musannaf Ibn Abi Shaybah 32045","","","كتاب الفرائض"
"32046","(۳۲۰۴۶) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ، عَنْ مُطَرِّفٍ، عَنِ الشَّعْبِیِّ ، قَالَ: قَالَ عُمَرُ: لاَ یَرِثُ الْقَاتِلُ عَمْدًا ، وَلاَ خَطَأً۔","","Musannaf Ibn Abi Shaybah 32046","","","كتاب الفرائض"
"32047","(۳۲۰۴۷) حَدَّثَنَا عَبَّادٌ ، عَنْ حَجَّاجٍ ، عَنْ حَبِیبٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّ رَجُلاً قَتَلَ أَخَاہُ خَطَا ، فَسُئِلَ عَنْ ذَلِکَ ابْنُ عَبَّاسٍ ؟ فَلَمْ یُوَرِّثْہُ ، وَقَالَ : لاَ یَرِثُ قَاتِلٌ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 32047","","","كتاب الفرائض"
"32048","(۳۲۰۴۸) حَدَّثَنَا شَبَابَۃُ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قضَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَرِثُ قَاتِلٌ مَنْ قَتَلِ قَرِیبِہِ شَیْئًا مِنَ الدِّیَۃِ عَمْدًا أَوْ خَطَأً۔n وَقَالَ الزُّہْرِیُّ الْقَاتِلُ لاَ یَرِثُ مِنْ دِیَۃ مَنْ قُتِلَ شَیْئًا وَإِنْ کَانَ وَلَدًا ، أَوْ وَالِدًا ، وَلَکِنْ یَرِثُ مِنْ مَالِہِ ، لأَنَّ اللَّہَ قَدْ عَلِمَ أَنَّ النَّاسَ یَقْتُلُ بَعْضُہُمْ بَعْضًا ، وَلاَ یَنْبَغِی لأَحَدٍ أَنْ یَقْطَعَ الْمَوَارِیثَ الَّتِی فَرَضَہَا۔","","Musannaf Ibn Abi Shaybah 32048","","","كتاب الفرائض"
"32049","(۳۲۰۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی عَمْرٍو الْعَبْدِیِّ ، عَنْ عَلِیٍّ ، قَالَ : لاَ یَرِثُ الْقَاتِلُ۔","Da'if","Musannaf Ibn Abi Shaybah 32049","","","كتاب الفرائض"
"32050","(۳۲۰۵۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ یَرِثُ الْقَاتِلُ مِنَ دِیَۃٍ مَنْ قُتِلَ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 32050","","","كتاب الفرائض"
"32051","(۳۲۰۵۱) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانُ، عَنْ مَنْصُورٍ، عَنْ إِبْرَاہِیمَ قَالَ: لاَ یَرِثُ الْقَاتِلُ مِنَ الدِّیَۃ ولاَ مِنَ الْمَالُ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 32051","","","كتاب الفرائض"
"32052","(۳۲۰۵۲) حَدَّثَنَا إبْرَاہِیمُ بْنُ صَدَقَۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ لاَ یُوَرِّثُ الْقَاتِلَ وَیَرَی ، أَنَّہُ یَحْجبُ۔","","Musannaf Ibn Abi Shaybah 32052","","","كتاب الفرائض"
"32053","(۳۲۰۵۳) حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، قَالَ : سَأَلْتُ ابْنَ شِہَابٍ عَنِ الْقَاتِلِ یَرِثُ شَیْئًا ؟ قَالَ : فَقَالَ سَعِیدُ بْنُ الْمُسَیَّبِ : مَضَتِ السُّنَّۃُ أَنَّ الْقَاتِلَ لاَ یَرِثُ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 32053","","","كتاب الفرائض"
"32054","(۳۲۰۵۴) حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ أَبِی عَوْنٍ ، قَالَ : قَالَ مُحَمَّدُ بْنُ جُبَیْرٍ: الْقَاتِلُ عَمْدًا لاَ یَرِثُ مِنَ الدِّیَۃِ ، وَلاَ مِنْ غَیْرِہَا شَیْئًا ، وَالْقَاتِلُ خَطَأً لاَ یَرِثُ مِنَ الدِّیَۃِ شَیْئًا وَیَرِثُ مِنْ غَیْرِہَا إنْ کَانَ۔","","Musannaf Ibn Abi Shaybah 32054","","","كتاب الفرائض"
"32055","(۳۲۰۵۵) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عُرْوَۃَ ، قَالَ : لاَ یَرِثُ الْقَاتِلُ۔","","Musannaf Ibn Abi Shaybah 32055","","","كتاب الفرائض"
"32056","(۳۲۰۵۶) حَدَّثَنَا حَاتِمٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : لاَ یَرِثُ قَاتِلٌ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 32056","","","كتاب الفرائض"
"32057","(۳۲۰۵۷) حَدَّثَنَا ابْنُ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، قَالَ : إذَا قَتَلَ الرَّجُلُ ابْنَہُ ، أَوْ أَخَاہُ لَمْ یَرِثْہُ ، وَوَرِثَہُ أَقْرَبُ النَّاسِ بَعْدَہُ۔","","Musannaf Ibn Abi Shaybah 32057","","","كتاب الفرائض"
"32058","(۳۲۰۵۸) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إنْ قَتَلَہُ خَطَأً وَرِثَہُ مِنْ مَالِہِ ، وَلَمْ یَرِثْ مِنْ دِیَتِہِ ، وَإِنْ قَتَلَہُ عَمْدًا لَمْ یَرِثْ مِنْ مَالِہِ ، وَلاَ مِنْ دِیَتِہِ۔","","Musannaf Ibn Abi Shaybah 32058","","","كتاب الفرائض"
"32059","(۳۲۰۵۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إذَا قَتَلَ وَلِیَّہُ خَطَأً وَرِثَ مِنْ مَالِہِ ، وَلَمْ یَرِثْ مِنْ دِیَتِہِ ، وَإِنْ قَتَلَہُ عَمْدًا لَمْ یَرِثْ مِنْ مَالِہِ ، وَلاَ مِنْ دِیَتِہِ۔","","Musannaf Ibn Abi Shaybah 32059","","","كتاب الفرائض"
"32060","(۳۲۰۶۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَلِیُّ بْنُ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عَلِیٍّ : فِی رَجُلٍ قَتَلَ أُمَّہُ قَالَ : إنْ کَانَ خَطَأً وَرِثَ ، وَإِنْ کَانَ عَمْدًا لَمْ یَرِثْ۔n قَالَ وَکِیعٌ : لاَ یَرِثُ قَاتِلُ عَمْدٍ وَلاَ خَطَأٍ مِنَ الدِّیَۃِ ، وَلاَ مِنَ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 32060","","","كتاب الفرائض"
"32061","(۳۲۰۶۱) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یَرِثُ الْقَاتِلُ۔","","Musannaf Ibn Abi Shaybah 32061","","","كتاب الفرائض"
"32062","(۳۲۰۶۲) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ ، قَالَ: لاَ یَرِثُ الْقَاتِلُ شَیْئًا مِنْ دِیَتِہِ ، وَلاَ مِنْ مَالِہِ۔","","Musannaf Ibn Abi Shaybah 32062","","","كتاب الفرائض"
"32063","(۳۲۰۶۳) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ رَجُلٍ ، عَنِ الْقَاسِمِ ، قَالَ : لاَ یَرِثُ الْقَاتِلُ۔","","Musannaf Ibn Abi Shaybah 32063","","","كتاب الفرائض"
"32064","(۳۲۰۶۴) حَدَّثَنَا یَحْیَی بْنُ یَمَانِ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : لاَ یَرِثُ الْقَاتِلُ۔","","Musannaf Ibn Abi Shaybah 32064","","","كتاب الفرائض"
