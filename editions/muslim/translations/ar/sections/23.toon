hadiths[23]{hadithnumber,text}:
"4011","وحَدَّثَنِي  مُحَمَّدُ بْنُ حَاتِمٍ ، حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ الْقَطَّانُ ، عَنْ  مُحَمَّدِ بْنِ يُوسُفَ ، قَالَ: سَمِعْتُ  السَّائِبَ بْنَ يَزِيدَ ، يُحَدِّثُ، عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ: سَمِعْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: "" شَرُّ الْكَسْبِ: مَهْرُ الْبَغِيِّ، وَثَمَنُ الْكَلْبِ، وَكَسْبُ الْحَجَّامِ "".\nصحیح مسلم حدیث: 4011 عربی حدیث: 1568"
"4012","حَدَّثَنَا  إِسْحَاق بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ، عَنْ  الْأَوْزَاعِيِّ ، عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ، حَدَّثَنِي  إِبْرَاهِيمُ بْنُ قَارِظٍ ، عَنْ  السَّائِبِ بْنِ يَزِيدَ ، حَدَّثَنِي  رَافِعُ بْنُ خَدِيجٍ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" ثَمَنُ الْكَلْبِ خَبِيثٌ، وَمَهْرُ الْبَغِيِّ خَبِيثٌ، وَكَسْبُ الْحَجَّامِ خَبِيثٌ ""،\nصحیح مسلم حدیث: 4012 عربی حدیث: 1568"
"4013","حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا  عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا  مَعْمَرٌ ، عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ، بِهَذَا الْإِسْنَادِ مِثْلَهُ.\nصحیح مسلم حدیث: 4013 عربی حدیث: 1568"
"4014","وحَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا  النَّضْرُ بْنُ شُمَيْلٍ ، حَدَّثَنَا  هِشَامٌ ، عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ، حَدَّثَنِي  إِبْرَاهِيمُ بْنُ عَبْدِ اللَّهِ ، عَنْ  السَّائِبِ بْنِ يَزِيدَ ، حَدَّثَنَا  رَافِعُ بْنُ خَدِيجٍ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِهِ.\nصحیح مسلم حدیث: 4014 عربی حدیث: 1568"
"4015","حَدَّثَنِي  سَلَمَةُ بْنُ شَبِيبٍ ، حَدَّثَنَا  الْحَسَنُ بْنُ أَعْيَنَ ، حَدَّثَنَا  مَعْقِلٌ ، عَنْ  أَبِي الزُّبَيْرِ ، قَالَ: سَأَلْتُ  جَابِرًا :"" عَنْ ثَمَنِ الْكَلْبِ وَالسِّنَّوْرِ؟ قَالَ: زَجَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ ذَلِكَ"".\nصحیح مسلم حدیث: 4015 عربی حدیث: 1569"
"4016","حَدَّثَنَا  يَحْيَى بْنُ يَحْيَى ، قَالَ: قَرَأْتُ عَلَى  مَالِكٍ ، عَنْ  نَافِعٍ ، عَنْ  ابْنِ عُمَرَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" أَمَرَ بِقَتْلِ الْكِلَابِ "".\nصحیح مسلم حدیث: 4016 عربی حدیث: 1570"
"4017","حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا  أَبُو أُسَامَةَ ، حَدَّثَنَا  عُبَيْدُ اللَّهِ ، عَنْ  نَافِعٍ ، عَنْ  ابْنِ عُمَرَ ، قَالَ: "" أَمَرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِقَتْلِ الْكِلَابِ ""، فَأَرْسَلَ فِي أَقْطَارِ الْمَدِينَةِ: أَنْ تُقْتَلَ.\nصحیح مسلم حدیث: 4017 عربی حدیث: 1570"
"4018","وحَدَّثَنِي  حُمَيْدُ بْنُ مَسْعَدَةَ ، حَدَّثَنَا  بِشْرٌ يَعْنِي ابْنَ الْمُفَضَّلِ ، حَدَّثَنَا  إِسْمَاعِيل وَهُوَ ابْنُ أُمَيَّةَ ، عَنْ  نَافِعٍ ، عَنْ  عَبْدِ اللَّهِ ، قَالَ: كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" يَأْمُرُ بِقَتْلِ الْكِلَابِ ""، فَنَنْبَعِثُ فِي الْمَدِينَةِ، وَأَطْرَافِهَا، فَلَا نَدَعُ كَلْبًا، إِلَّا قَتَلْنَاهُ، حَتَّى إِنَّا لَنَقْتُلُ كَلْبَ الْمُرَيَّةِ مِنْ أَهْلِ الْبَادِيَةِ يَتْبَعُهَا.\nصحیح مسلم حدیث: 4018 عربی حدیث: 1570"
"4019","حَدَّثَنَا  يَحْيَى بْنُ يَحْيَى ، أَخْبَرَنَا  حَمَّادُ بْنُ زَيْدٍ ، عَنْ  عَمْرِو بْنِ دِينَارٍ ، عَنْ  ابْنِ عُمَرَ : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" أَمَرَ بِقَتْلِ الْكِلَابِ، إِلَّا كَلْبَ صَيْدٍ، أَوْ كَلْبَ غَنَمٍ، أَوْ مَاشِيَةٍ ""، فَقِيلَ لِابْنِ عُمَرَ: إِنَّ أَبَا هُرَيْرَةَ، يَقُولُ: أَوْ كَلْبَ زَرْعٍ، فَقَالَ ابْنُ عُمَرَ: إِنَّ لِأَبِي هُرَيْرَةَ زَرْعًا.\nصحیح مسلم حدیث: 4019 عربی حدیث: 1571"
"4020","حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَلَفٍ ، حَدَّثَنَا  رَوْحٌ . ح وحَدَّثَنِي  إِسْحَاقُ بْنُ مَنْصُورٍ ، أَخْبَرَنَا  رَوْحُ بْنُ عُبَادَةَ ، حَدَّثَنَا  ابْنُ جُرَيْجٍ ، أَخْبَرَنِي  أَبُو الزُّبَيْرِ ، أَنَّهُ سَمِعَ  جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ: "" أَمَرَنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِقَتْلِ الْكِلَابِ، حَتَّى إِنَّ الْمَرْأَةَ تَقْدَمُ مِنَ الْبَادِيَةِ بِكَلْبِهَا فَنَقْتُلُهُ، ثُمَّ نَهَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ قَتْلِهَا ""، وَقَالَ: "" عَلَيْكُمْ بِالْأَسْوَدِ الْبَهِيمِ ذِي النُّقْطَتَيْنِ، فَإِنَّهُ شَيْطَانٌ "".\nصحیح مسلم حدیث: 4020 عربی حدیث: 1572"
"4021","حَدَّثَنَا  عُبَيْدُ اللَّهِ بْنُ مُعَاذٍ ، حَدَّثَنَا  أَبِي ، حَدَّثَنَا  شُعْبَةُ ، عَنْ  أَبِي التَّيَّاحِ ، سَمِعَ  مُطَرِّفَ بْنَ عَبْدِ اللَّهِ ، عَنْ  ابْنِ الْمُغَفَّلِ ، قَالَ: "" أَمَرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِقَتْلِ الْكِلَابِ ""، ثُمَّ قَالَ: "" مَا بَالُهُمْ وَبَالُ الْكِلَابِ ""، ثُمَّ "" رَخَّصَ فِي كَلْبِ الصَّيْدِ، وَكَلْبِ الْغَنَمِ "".\nصحیح مسلم حدیث: 4021 عربی حدیث: 1573"
"4022","وحَدَّثَنِيهِ  يَحْيَى بْنُ حَبِيبٍ ، حَدَّثَنَا  خَالِدٌ يَعْنِي ابْنَ الْحَارِثِ . ح وحَدَّثَنِي  مُحَمَّدُ بْنُ حَاتِمٍ ، حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ . ح وحَدَّثَنِي  مُحَمَّدُ بْنُ الْوَلِيدِ ، حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ . ح وحَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا  النَّضْرُ . ح وحَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا  وَهْبُ بْنُ جَرِيرٍ ، كُلُّهُمْ عَنْ  شُعْبَةَ ، بِهَذَا الْإِسْنَادِ، وقَالَ ابْنُ حَاتِمٍ فِي حَدِيثِهِ، عَنْ يَحْيَى: وَرَخَّصَ فِي كَلْبِ الْغَنَمِ، وَالصَّيْدِ، وَالزَّرْعِ.\nصحیح مسلم حدیث: 4022 عربی حدیث: 1573"
"4023","حَدَّثَنَا  يَحْيَى بْنُ يَحْيَى ، قَالَ: قَرَأْتُ عَلَى  مَالِكٍ ، عَنْ  نَافِعٍ ، عَنْ  ابْنِ عُمَرَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" مَنِ اقْتَنَى كَلْبًا، إِلَّا كَلْبَ مَاشِيَةٍ، أَوْ ضَارِي، نَقَصَ مِنْ عَمَلِهِ كُلَّ يَوْمٍ قِيرَاطَانِ "".\nصحیح مسلم حدیث: 4023 عربی حدیث: 1574"
"4024","وحَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  وَزُهَيْرُ بْنُ حَرْبٍ ،  وَابْنُ نُمَيْرٍ ، قَالُوا: حَدَّثَنَا  سُفْيَانُ ، عَنْ  الزُّهْرِيِّ ، عَنْ  سَالِمٍ ، عَنْ  أَبِيهِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" مَنِ اقْتَنَى كَلْبًا، إِلَّا كَلْبَ صَيْدٍ، أَوْ مَاشِيَةٍ، نَقَصَ مِنْ أَجْرِهِ كُلَّ يَوْمٍ قِيرَاطَانِ "".\nصحیح مسلم حدیث: 4024 عربی حدیث: 1574"
"4025","حَدَّثَنَا  يَحْيَى بْنُ يَحْيَى ،  وَيَحْيَى بْنُ أَيُّوبَ ،  وَقُتَيْبَةُ ،  وَابْنُ حُجْرٍ ، قَالَ يَحْيَى بْنُ يَحْيَى: أَخْبَرَنَا، وَقَالَ الْآخَرُونَ: حَدَّثَنَا  إِسْمَاعِيلُ وَهُوَ ابْنُ جَعْفَرٍ ، عَنْ  عَبْدِ اللَّهِ بْنِ دِينَارٍ ، أَنَّهُ سَمِعَ  ابْنَ عُمَرَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" مَنِ اقْتَنَى كَلْبًا، إِلَّا كَلْبَ ضَارِيَةٍ، أَوْ مَاشِيَةٍ، نَقَصَ مِنْ عَمَلِهِ كُلَّ يَوْمٍ قِيرَاطَانِ "".\nصحیح مسلم حدیث: 4025 عربی حدیث: 1574"
"4026","حَدَّثَنَا  يَحْيَى بْنُ يَحْيَى ،  وَيَحْيَى بْنُ أَيُّوبَ ،  وَقُتَيْبَةُ ،  وَابْنُ حُجْرٍ ، قَالَ يَحْيَى: أَخْبَرَنَا، وَقَالَ الْآخَرُونَ: حَدَّثَنَا  إِسْمَاعِيلُ ، عَنْ  مُحَمَّدٍ وَهُوَ ابْنُ أَبِي حَرْمَلَةَ ، عَنْ  سَالِمِ بْنِ عَبْدِ اللَّهِ ، عَنْ  أَبِيهِ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" مَنِ اقْتَنَى كَلْبًا، إِلَّا كَلْبَ مَاشِيَةٍ، أَوْ كَلْبَ صَيْدٍ، نَقَصَ مِنْ عَمَلِهِ كُلَّ يَوْمٍ قِيرَاطٌ ""، قَالَ  عَبْدُ اللَّهِ ، وَقَالَ  أَبُو هُرَيْرَةَ : أَوْ كَلْبَ حَرْثٍ.\nصحیح مسلم حدیث: 4026 عربی حدیث: 1574"
"4027","حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا  وَكِيعٌ ، حَدَّثَنَا  حَنْظَلَةُ بْنُ أَبِي سُفْيَانَ ، عَنْ  سَالِمٍ ، عَنْ  أَبِيهِ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" مَنِ اقْتَنَى كَلْبًا، إِلَّا كَلْبَ ضَارٍ، أَوْ مَاشِيَةٍ، نَقَصَ مِنْ عَمَلِهِ كُلَّ يَوْمٍ قِيرَاطَانِ ""، قَالَ سَالِمٌ: وَكَانَ أَبُو هُرَيْرَةَ ، يَقُولُ: أَوْ كَلْبَ حَرْثٍ، وَكَانَ صَاحِبَ حَرْثٍ.\nصحیح مسلم حدیث: 4027 عربی حدیث: 1574"
"4028","حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ، حَدَّثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ، أَخْبَرَنَا  عُمَرُ بْنُ حَمْزَةَ بْنِ عَبْدِ اللَّهِ بْنِ عُمَرَ ، حَدَّثَنَا  سَالِمُ بْنُ عَبْدِ اللَّهِ ، عَنْ  أَبِيهِ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" أَيُّمَا أَهْلِ دَارٍ اتَّخَذُوا كَلْبًا، إِلَّا كَلْبَ مَاشِيَةٍ، أَوْ كَلْبَ صَائِدٍ، نَقَصَ مِنْ عَمَلِهِمْ كُلَّ يَوْمٍ قِيرَاطَانِ "".\nصحیح مسلم حدیث: 4028 عربی حدیث: 1574"
"4029","حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  وَابْنُ بَشَّارٍ ، وَاللَّفْظُ لِابْنِ الْمُثَنَّى، قَالَا: حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا  شُعْبَةُ ، عَنْ  قَتَادَةَ ، عَنْ  أَبِي الْحَكَمِ ، قَالَ: سَمِعْتُ  ابْنَ عُمَرَ ، يُحَدِّثُ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" مَنِ اتَّخَذَ كَلْبًا، إِلَّا كَلْبَ زَرْعٍ، أَوْ غَنَمٍ، أَوْ صَيْدٍ، يَنْقُصُ مِنْ أَجْرِهِ كُلَّ يَوْمٍ قِيرَاطٌ "".\nصحیح مسلم حدیث: 4029 عربی حدیث: 1574"
"4030","وحَدَّثَنِي  أَبُو الطَّاهِرِ ،  وَحَرْمَلَةُ ، قَالَا: أَخْبَرَنَا  ابْنُ وَهْبٍ ، أَخْبَرَنِي  يُونُسُ ، عَنْ  ابْنِ شِهَابٍ ، عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، عَنْ  أَبِي هُرَيْرَةَ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" مَنِ اقْتَنَى كَلْبًا لَيْسَ بِكَلْبِ صَيْدٍ، وَلَا مَاشِيَةٍ، وَلَا أَرْضٍ، فَإِنَّهُ يَنْقُصُ مِنْ أَجْرِهِ قِيرَاطَانِ كُلَّ يَوْمٍ "". وَلَيْسَ فِي حَدِيثِ أَبِي الطَّاهِرِ: وَلَا أَرْضٍ.\nصحیح مسلم حدیث: 4030 عربی حدیث: 1575"
"4031","حَدَّثَنَا  عَبْدُ بْنُ حُمَيْدٍ ، حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا  مَعْمَرٌ ، عَنْ  الزُّهْرِيِّ ، عَنْ  أَبِي سَلَمَةَ ، عَنْ  أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" مَنِ اتَّخَذَ كَلْبًا، إِلَّا كَلْبَ مَاشِيَةٍ، أَوْ صَيْدٍ، أَوْ زَرْعٍ، انْتَقَصَ مِنْ أَجْرِهِ كُلَّ يَوْمٍ قِيرَاطٌ "". قَالَ الزُّهْرِيُّ: فَذُكِرَ لِابْنِ عُمَرَ، قَوْلُ أَبِي هُرَيْرَةَ، فَقَالَ: يَرْحَمُ اللَّهُ أَبَا هُرَيْرَةَ كَانَ صَاحِبَ زَرْعٍ.\nصحیح مسلم حدیث: 4031 عربی حدیث: 1575"
"4032","حَدَّثَنِي  زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ، حَدَّثَنَا  هِشَامٌ الدَّسْتَوَائِيُّ ، حَدَّثَنَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ، عَنْ  أَبِي سَلَمَةَ ، عَنْ  أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" مَنْ أَمْسَكَ كَلْبًا، فَإِنَّهُ يَنْقُصُ مِنْ عَمَلِهِ كُلَّ يَوْمٍ قِيرَاطٌ، إِلَّا كَلْبَ حَرْثٍ، أَوْ مَاشِيَةٍ ""،\nصحیح مسلم حدیث: 4032 عربی حدیث: 1575"
"4033","حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا  شُعَيْبُ بْنُ إِسْحَاقَ ، حَدَّثَنَا  الْأَوْزَاعِيُّ ، حَدَّثَنِي  يَحْيَى بْنُ أَبِي كَثِيرٍ ، حَدَّثَنِي  أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ ، حَدَّثَنِي  أَبُو هُرَيْرَةَ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِهِ،\nصحیح مسلم حدیث: 4033 عربی حدیث: 1575"
