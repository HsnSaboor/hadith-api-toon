"5386","(۵۳۸۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ حَمَّادٍ، عَنْ ہِشَامٍ، عَنْ أَبِیہِ، قَالَ: إِذَا أَدْرَکَ رَکْعَۃً مِنَ الْجُمُعَۃِ صَلَّی إِلَیْہَا أُخْرَی۔","No Data Available","Musannaf Ibn Abi Shaybah 5386","","","كتاب الجمعة"
"5387","(۵۳۸۷) حَدَّثَنَا خَالِدُ بْنُ حَیَّانَ ، عَنْ جَعْفَرٍ ، قَالَ : قُلْتُ لِمَیْمُونٍ : أَدْرَکْتُ رَکْعَۃً مِنَ الْجُمُعَۃِ ؟ فَقَالَ : أَمَّا أَنَا فَکُنْتُ بَانِیًا عَلَی مَا بَقِیَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5387","","","كتاب الجمعة"
"5388","(۵۳۸۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یَقُولُونَ : مَنْ فَاتَتْہُ رَکْعَۃٌ مِنَ الْجُمُعَۃِ فَلْیُصَلِّ إِلَیْہَا رَکْعَۃً أُخْرَی ، وَمَنْ لَمْ یُدْرِکْ فَلْیُصَلِّ أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5388","","","كتاب الجمعة"
"5389","(۵۳۸۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، قَالَ : إِذَا أَدْرَکْتَ رَکْعَۃً فَأَضِفْ إِلَیْہَا أُخْرَی۔","No Data Available","Musannaf Ibn Abi Shaybah 5389","","","كتاب الجمعة"
"5390","(۵۳۹۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ سَالِمٍ ، قَالَ : إِذَا أَدْرَکَ مِنَ الْجُمُعَۃِ رَکْعَۃً أَضَافَ إِلَیْہَا أُخْرَی۔","No Data Available","Musannaf Ibn Abi Shaybah 5390","","","كتاب الجمعة"
"5391","(۵۳۹۱) حَدَّثَنَا إِسْحَاقُ الرَّازِیّ ، عَنْ حَنْظَلَۃَ ، عَنِ الْقَاسِمِ ؛ أَنَّ سَالِمًا قَالَ : لَوْ لَمْ أُدْرِکْ مِنَ الْجُمُعَۃِ إِلاَّ رَکْعَۃً ، لأَضَفْتُ إِلَیْہَا رَکْعَۃً أُخْرَی۔","No Data Available","Musannaf Ibn Abi Shaybah 5391","","","كتاب الجمعة"
"5392","(۵۳۹۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَأَنَسٍ ، وَالْحَسَنِ ، قَالُوا : إِذَا أَدْرَکَ مِنَ الْجُمُعَۃِ رَکْعَۃً أَضَافَ إِلَیْہَا أُخْرَی ، فَإِذَا أَدْرَکَہُمْ جُلُوسًا صَلَّی أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5392","","","كتاب الجمعة"
"5393","(۵۳۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ عَلْقَمَۃَ ، وَالأَسْوَدِ ، قَالاَ : إِذَا أَدْرَکَہُمْ جُلُوسًا صَلَّی أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5393","","","كتاب الجمعة"
"5394","(۵۳۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا جَائَ وَالإِمَامُ جَالِسٌ یَوْمَ الْجُمُعَۃِ ؟ قَالَ : یُصَلِّی أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5394","","","كتاب الجمعة"
"5395","(۵۳۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مُبَارَکٍ ، عَنِ الْحَسَنِ ، قَالَ : یُصَلِّی أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5395","","","كتاب الجمعة"
"5396","(۵۳۹۶) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : إِذَا أَدْرَکَہُمْ یَوْمَ الْجُمُعَۃِ جُلُوسًا صَلَّی أَرْبَعًا۔","Sahih","Musannaf Ibn Abi Shaybah 5396","","","كتاب الجمعة"
"5397","(۵۳۹۷) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدٍ ، وَخِلاَسٍ ، وَالْحَسَنِ (ح) وَعَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ؛ مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5397","","","كتاب الجمعة"
"5398","(۵۳۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنِ الرَّجُلِ یَجِیئُ یَوْمَ الْجُمُعَۃِ قَبْلَ أَنْ یُسَلِّمَ الإِمَامُ ؟ قَالاَ : یُصَلِّی رَکْعَتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5398","","","كتاب الجمعة"
"5399","(۵۳۹۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا جُوَیْبِرٌ ، عَنِ الضَّحَّاکِ ، قَالَ : إِذَا أَدْرَکَ النَّاسَ یَوْمَ الْجُمُعَۃِ جُلُوسًا صَلَّی رَکْعَتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5399","","","كتاب الجمعة"
"5400","(۵۴۰۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یُصَلِّی رَکْعَتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5400","","","كتاب الجمعة"
"5401","(۵۴۰۱) حَدَّثَنَا شَرِیکٌ ، عَنْ عَامِرِ بْنِ شَقِیقٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ أَدْرَکَ التَّشَہُّدَ فَقَدْ أَدْرَکَ الصَّلاَۃ۔","Hasan","Musannaf Ibn Abi Shaybah 5401","","","كتاب الجمعة"
"5402","(۵۴۰۲) حَدَّثَتَا ابْنُ فُضَیْلٍ ، عَنْ خُصَیْفٍ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : کَانَ یُصَلِّی قَبْلَ الْجُمُعَۃِ أَرْبَعًا۔","Da'if","Musannaf Ibn Abi Shaybah 5402","","","كتاب الجمعة"
"5403","(۵۴۰۳) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ یُہَجِّرُ یَوْمَ الْجُمُعَۃِ ، فَیُطِیلُ الصَّلاَۃ قَبْلَ أَنْ یَخْرُجَ الإِمَامُ۔","Sahih","Musannaf Ibn Abi Shaybah 5403","","","كتاب الجمعة"
"5404","(۵۴۰۴) حَدَّثَنَا شَرِیکٌ ، عَنْ عَمْرِو بْنِ عُثْمَانَ ، قَالَ : قَالَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : صَلِّ قَبْلَ الْجُمُعَۃِ عَشْرَ رَکَعَاتٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5404","","","كتاب الجمعة"
"5405","(۵۴۰۵) حَدَّثَنَا حَفْصٌ، عَنِ الأَعْمَشِ، عَنْ إِبْرَاہِیمَ، قَالَ: کَانُوا یُصَلُّونَ قَبْلَہَا أَرْبَعًا۔(ترمذی ۴۷۸۔ احمد ۳/۴۱۱)","No Data Available","Musannaf Ibn Abi Shaybah 5405","","","كتاب الجمعة"
"5406","(۵۴۰۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ عِمْرَانَ ، عَنْ أَبِی مِجْلَزٍ ؛ أَنَّہُ کَانَ یُصَلِّی فِی بَیْتِہِ رَکْعَتَیْنِ یَوْمَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5406","","","كتاب الجمعة"
"5407","(۵۴۰۷) حَدَّثَنَا عَبْدُالصَّمَدِ بْنُ عَبْدِالْوَارِثِ ، عَنْ وُہَیْبٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ لاَ یَأْتِی الْمَسْجِدَ یَوْمَ الْجُمُعَۃِ حَتَّی یُصَلِّیَ فِی بَیْتِہِ رَکْعَتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5407","","","كتاب الجمعة"
"5408","(۵۴۰۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی بَعْدَ الْجُمُعَۃِ رَکْعَتَیْنِ۔ (بخاری ۱۱۶۵۔ ترمذی ۵۲۱)","Sahih","Musannaf Ibn Abi Shaybah 5408","","","كتاب الجمعة"
"5409","(۵۴۰۹) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، قَالَ : حدَّثَنَا یُونُسُ بْنُ عُبَیْدٍ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ؛ أَنَّہُ کَانَ یُصَلِّی بَعْدَ الْجُمُعَۃِ رَکْعَتَیْنِ ، فَقِیلَ لَہُ : یَا أَبَا نُجَیْدٍ ، مَا یَقُولُ النَّاسُ ؟ قَالَ : وَمَا یَقُولُونَ؟ قَالَ: یَقُولُونَ: إِنَّک تُصَلِّی رَکْعَتَیْنِ إِلَی الْجُمُعَۃِ فَتَکُونُ أَرْبَعًا ۔ قَالَ : فَقَالَ عِمْرَانُ : لأَنْ تَخْتَلِفَ النَّیَازِکُ بَیْنَ أضْلاَعِی أَحَبُّ إِلَیَّ مِنْ أَنْ أَفْعَلَ ذَلِکَ ۔ فَلَمَّا کَانَتِ الْجُمُعَۃُ الْمُقْبِلَۃُ صَلَّی الْجُمُعَۃَ ، ثُمَّ احْتَبَی فَلَمْ یُصَلِّ شَیْئًا حَتَّی أُقِیمَتْ صَلاَۃُ الْعَصْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 5409","","","كتاب الجمعة"
"5410","(۵۴۱۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَطَائُ بْنُ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : قَدِمَ عَلَیْنَا ابْنُ مَسْعُودٍ ، فَکَانَ یَأْمُرنَا أَنْ نُصَلِّیَ بَعْدَ الْجُمُعَۃِ أَرْبَعًا ، فَلَمَّا قَدِمَ عَلَیْنَا عَلِیٌّ أَمَرَنَا أَنْ نُصَلِّیَ سِتًّا ،فَأَخَذْنَا بِقَوْلِ عَلِیٍّ ، وَتَرَکْنَا قَوْلَ عَبْدِ اللہِ ، قَالَ : کَانَ یُصَلِّی رَکْعَتَیْنِ ، ثُمَّ أَرْبَعًا۔","Da'if","Musannaf Ibn Abi Shaybah 5410","","","كتاب الجمعة"
"5411","(۵۴۱۱) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ حَبِیبٍ ، قَالَ : کَانَ عَبْدُ اللہِ یُصَلِّی أَرْبَعًا ، فَلَمَّا قَدِمَ عَلِیٌّ صَلَّی سِتًّا ، رَکْعَتَیْنِ ، وَأَرْبَعًا۔","Sahih","Musannaf Ibn Abi Shaybah 5411","","","كتاب الجمعة"
"5412","(۵۴۱۲) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَطَائٍ ، قَالَ : کَانَ ابْنُ عُمَرَ إِذَا صَلَّی الْجُمُعَۃَ ، صَلَّی بَعْدَہَا سِتَّ رَکَعَاتٍ ، رَکْعَتَیْنِ ، ثُمَّ أَرْبَعًا۔","Sahih","Musannaf Ibn Abi Shaybah 5412","","","كتاب الجمعة"
"5413","(۵۴۱۳) حَدَّثَنَا عَلِیُّ بْنِ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی بَکْرِ بْنِ أَبِی مُوسَی ، عَنْ أَبِیہِ ؛ کَانَ یُصَلِّی بَعْدَ الْجُمُعَۃِ سِتَّ رَکَعَاتٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5413","","","كتاب الجمعة"
"5414","(۵۴۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنْ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، عَنْ مَسْرُوقٍ ، قَالَ : کَانَ یُصَلِّی بَعْدَ الْجُمُعَۃِ سِتًّا ، رَکْعَتَیْنِ ، وَأَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5414","","","كتاب الجمعة"
"5415","(۵۴۱۵) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : صَلِّ بَعْدَ الْجُمُعَۃِ رَکْعَتَیْنِ ، ثُمَّ صَلِّ بَعْدَہُمَا مَا شِئْتَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5415","","","كتاب الجمعة"
"5416","(۵۴۱۶) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ سُہَیْلٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ کَانَ مِنْکُمْ مُصَلِّیًا بَعْدَ الْجُمُعَۃِ ، فَلْیُصَلِّ أَرْبَعًا۔ (ترمذی ۵۲۳۔ ابوداؤد ۱۱۲۴)","Sahih","Musannaf Ibn Abi Shaybah 5416","","","كتاب الجمعة"
"5417","(۵۴۱۷) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِاللہِ بْنِ حَبِیبٍ، قَالَ: کَانَ عَبْدُاللہِ یُصَلِّی بَعْدَ الْجُمُعَۃِ أَرْبَعًا۔","Sahih","Musannaf Ibn Abi Shaybah 5417","","","كتاب الجمعة"
"5418","(۵۴۱۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ خُصَیْفٍ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ یُصَلِّی بَعْدَ الْجُمُعَۃِ أَرْبَعًا۔","Da'if","Musannaf Ibn Abi Shaybah 5418","","","كتاب الجمعة"
"5419","(۵۴۱۹) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ، عَنْ أَبِیہِ، قَالَ: کَانَ عَبْدُاللہِ یُصَلِّی بَعْدَ الْجُمُعَۃِ أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5419","","","كتاب الجمعة"
"5420","(۵۴۲۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ، عَن عَلْقَمَۃَ؛ أَنَّہُ کَانَ یُصَلِّی أَرْبَعًا بَعْدَ الْجُمُعَۃِ، لاَ یَفْصِلُ بَیْنَہُنَّ۔","No Data Available","Musannaf Ibn Abi Shaybah 5420","","","كتاب الجمعة"
"5421","(۵۴۲۱) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی حُصَینٍ ، قَالَ : رَأَیْتُ الأَسْوَدَ بْنَ یَزِیدَ صَلَّی بَعْدَ الْجُمُعَۃِ أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5421","","","كتاب الجمعة"
"5422","(۵۴۲۲) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یُصَلُّونَ بَعْدَہَا أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5422","","","كتاب الجمعة"
"5423","(۵۴۲۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ عِمْرَانَ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : إِذَا سَلَّمَ الإِمَامُ صَلَّی رَکْعَتَیْنِ یَوْمَ الْجُمُعَۃِ ، وَإِذَا رَجَعَ صَلَّی رَکْعَتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5423","","","كتاب الجمعة"
"5424","(۵۴۲۴) حَدَّثَنَا جَرِیرُ بن عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، قَالَ : کَانَ یُسْتَحَبُّ فِی الأَرْبَعِ الَّتِی بَعْدَ الْجُمُعَۃِ أَنْ لاَ یُسَلَّمَ بَیْنَہُنَّ۔","No Data Available","Musannaf Ibn Abi Shaybah 5424","","","كتاب الجمعة"
"5425","(۵۴۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی بَکْرِ بْنِ عَمْرِو بْنِ عُتْبَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ یُصَلِّی بَعْدَ الْجُمُعَۃِ أَرْبَعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5425","","","كتاب الجمعة"
"5426","(۵۴۲۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ کُلْثُومِ بْنِ جَبْرٍ ، قَالَ : قَالَ لِی مُسْلِمُ بْنُ یَسَارٍ : إِِذَا عَلِمْتَ أَنَّ النَّہَارَ قَدِ انْتَصَفَ یَوْمَ الْجُمُعَۃِ فَلاَ تَبْتَاعَنَّ شَیْئًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5426","","","كتاب الجمعة"
"5427","(۵۴۲۷) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَانَ یَمْنَعُ النَّاسَ الْبَیْعَ یَوْمَ الْجُمُعَۃِ إِذَا نُودِیَ بِالصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 5427","","","كتاب الجمعة"
"5428","(۵۴۲۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا جُوَیْبِرٌ ، عَنِ الضَّحَّاکِ ، قَالَ : إِذَا زَالَتِ الشَّمْسُ مِنْ یَوْمِ الْجُمُعَۃِ ، فَقَدْ حَرُمَ الْبَیْعُ وَالشِّرَائُ ، حَتَّی تُقْضَی الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 5428","","","كتاب الجمعة"
"5429","(۵۴۲۹) حَدَّثَنَا ہُشَیْمٌ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ (ح) وَعَنْ بَعْضِ أَصْحَابِہِ ، عَنِ الْحَسَنِ ؛ أَنَّہُمَا قَالاَ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5429","","","كتاب الجمعة"
"5430","(۵۴۳۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو الْمِقْدَامِ مَوْلَی لِقُرَیْشٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ؛ أَنَّہُ اشْتَرَی مِنْ رَجُلٍ شَیْئًا یَوْمَ الْجُمُعَۃِ ، فَلَقِیَہُ بَعْدَ ذَلِکَ ، فَقَالَ : تَارِکْنِی الْبَیْعَ ، فَإِنِّی أَحْسَبُنِی اشْتَرَیْتُ مِنْکَ مَا اشْتَرَیْتُ بَعْدَ زَوَالِ الشَّمْسِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5430","","","كتاب الجمعة"
"5431","(۵۴۳۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ، عَنْ عَبْدِ الْکَرِیمِ، عَنْ مُجَاہِدٍ، أَوْ غَیْرِہِ، قَالَ: مَنْ بَاعَ شَیْئًا بَعْدَ زَوَالِ الشَّمْسِ یَوْمَ الْجُمُعَۃِ ، فَإِنَّ بَیْعَہُ مَرْدُودٌ ، لأَنَّ اللَّہَ نَہَی عَنِ الْبَیْعِ إِذَا نُودِیَ لِلصَّلاَۃِ مِنْ یَوْمِ الْجُمُعَۃِ ۔ شَکَّ سُفْیَانُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5431","","","كتاب الجمعة"
"5432","(۵۴۳۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ بُرْدٍ ، قَالَ : قُلْتُ لِلزُّہْرِیِّ : مَتَی یَحْرُمُ الْبَیْعُ وَالشِّرَائُ یَوْمَ الْجُمُعَۃِ ؟ فَقَالَ : کَانَ الأَذَانُ عِنْدَ خُرُوجِ الإِمَامِ ، فَأَحْدَثَ أَمِیرُ الْمُؤْمِنِینَ عُثْمَانُ التَّأْذِینَۃَ الثَّالِثَۃَ ، فَأَذَّنَ عَلَی الزَّوْرَائِ لِیَجْتَمِعَ النَّاسُ ، فَأَرَی أَنْ یُتْرَکَ الْبَیْعُ وَالشِّرَائُ عِنْدَ التَّأْذِینَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5432","","","كتاب الجمعة"
"5433","(۵۴۳۳) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ مَیْمُونٍ ، قَالَ : کَانَ بِالْمَدِینَۃِ إِذَا أَذَّنَ الْمُؤَذِّنُ یَوْمَ الْجُمُعَۃِ یُنَادُونَ فِی الأَسْوَاقِ : حَرُمَ الْبَیْعُ ، حَرُمَ الْبَیْعُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5433","","","كتاب الجمعة"
"5434","(۵۴۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنِ الشَّعْبِیِّ ؛ فِی السَّاعَۃِ الَّتِی تُرْجَی فِی الْجُمُعَۃِ ، قَالَ : فِیمَا بَیْنَ أَنْ یَحْرُمَ الْبَیْعُ إِلَی أَنْ یَحِلَّ۔","No Data Available","Musannaf Ibn Abi Shaybah 5434","","","كتاب الجمعة"
"5435","(۵۴۳۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنِ ابْنِ سِیرِینَ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ؛ أَنَّہُ رَاحَ إِلَی الْجُمُعَۃِ ، فَإِذَا النَّاسُ قَدِ اسْتَقْبَلُوہُ وَقَدْ صَلَّوْا ، قَالَ : فَمَالَ إِلَی مَسْجِدٍ ، أَوْ إِلَی دَارٍ فَصَلَّی ، قَالَ : فَقِیلَ لَہُ فِی ذَلِکَ ؟ فَقَالَ : إِنَّہُ مَنْ لاَ یَسْتَحْیِی مِنَ النَّاسِ ، لاَ یَسْتَحْیِی مِنَ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 5435","","","كتاب الجمعة"
"5436","(۵۴۳۶) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ عَوْنٍ ، وَحَجَّاجِ بْنِ أَبِی عُثْمَانَ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ یَقُولُ : إِذَا اسْتَقْبَلَکَ النَّاسُ یَوْمَ الْجُمُعَۃِ وَقَدْ صَلَّوْا ، فَامْضِ إِلَی الْمَسْجِدِ ، فَإِنْ عَلِمْتَ مَا قَرَأَ بِہِ الإِمَامُ ، فَاقْرَأْ بِہِ وَصَلِّ۔","No Data Available","Musannaf Ibn Abi Shaybah 5436","","","كتاب الجمعة"
"5437","(۵۴۳۷) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّ زَیْدَ بْنِ ثَابِتٍ لَقِیَ النَّاسَ رَاجِعِینَ مِنَ الْجُمُعَۃِ ، فَمَالَ إِلَی دَارٍ ، فَقِیلَ لَہُ ؟ فَقَالَ : مَنْ لاَ یَسْتَحْیِی مِنَ النَّاسِ ، لاَ یَسْتَحْیِی مِنَ اللہِ ۔ قَالَ : وَقَالَ الْحَسَنُ ، وَابْنُ سِیرِینَ : یَمْضِی۔","Sahih","Musannaf Ibn Abi Shaybah 5437","","","كتاب الجمعة"
"5438","(۵۴۳۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُوسَی بْنِ مُسْلِمٍ ، قَالَ : شَہِدْتُ إِبْرَاہِیمَ التَّیْمِیَّ ، وَإِبْرَاہِیمَ النَّخَعِیّ ، وَزِرًّا ، وَسَلَمَۃَ بْنَ کُہَیْلٍ ، فَذَکَّرَ زِرٌّ ، وَالتَّیْمِیُّ فِی یَوْمِ جُمُعَۃٍ ، ثُمَّ صَلَّوُا الْجُمُعَۃَ أَرْبَعًا فِی مَکَانِہِمْ ، وَکَانُوا خَائِفِینَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5438","","","كتاب الجمعة"
"5439","(۵۴۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، قَالَ : أَذَّنَ مُؤَذِّنٌ وَنَحْنُ بِالرَّوْحَائِ فِی یَوْمِ جُمُعَۃٍ ، فَجِئْنَا وَقَدْ صَلَّوْا ، فَصَلَّی الْقَاسِمُ وَلَمْ یُجَمِّعْ۔","No Data Available","Musannaf Ibn Abi Shaybah 5439","","","كتاب الجمعة"
"5440","(۵۴۴۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی قَوْمٍ فَاتَتْہُمُ الْجُمُعَۃُ ، قَالَ : یُصَلُّونَ شَتَّی۔","No Data Available","Musannaf Ibn Abi Shaybah 5440","","","كتاب الجمعة"
"5441","(۵۴۴۱) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ، عَنِ الْقَاسِمِ بْنِ الْوَلِیدِ، قَالَ: قَالَ عَلِیٌّ: لاَ جَمَاعَۃَ یَوْمَ جُمُعَۃٍ إِلاَّ مَعَ الإِمَامِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5441","","","كتاب الجمعة"
"5442","(۵۴۴۲) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنَا جَمِیلُ بْنُ عُبَیْدٍ الطَّائِیُّ ، قَالَ : رَأَیْتُ إِیَاسَ بْنَ مُعَاوِیَۃَ ، وَہُوَ یَوْمئِذٍ قَاضِی الْبَصْرَۃِ ، جَائَ إِلَی الْجُمُعَۃِ وَفَاتَتْہُ ، فَتَقَدَّمَ فَصَلَّی بِنَا الظُّہْرَ أَرْبَعَ رَکَعَاتٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5442","","","كتاب الجمعة"
"5443","(۵۴۴۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ : أَتَیْتُ الْمَسْجِدَ أَنَا وَزِرٌّ یَوْمَ الْجُمُعَۃِ ، فَوَجَدْنَاہُمْ قَدْ صَلَّوْا ، فَصَلَّیْنَا جَمِیعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5443","","","كتاب الجمعة"
"5444","(۵۴۴۴) حَدَّثَنَا شَرِیکٌ ، عَنْ مُخْتَارٍ أَبِی غَسَّانَ، عَنْ أَبِی ظَبْیَانَ الْجَنْبِیِّ، قَالَ: قَالَ عَلِیٌّ: تُؤْتَی الْجُمُعَۃُ وَلَوْ حَبْوًا۔","Da'if","Musannaf Ibn Abi Shaybah 5444","","","كتاب الجمعة"
"5445","(۵۴۴۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنِ الْحَسَنِ بْنِ الْحُرِّ ، عَنْ مَیْمُونِ بْنِ أَبِی شَبِیبٍ ، قَالَ : أَرَدْتُ الْجُمُعَۃَ فِی زَمَنِ الْحَجَّاجِ ، فَتَہَیَّأْتُ لِلذَّہَابِ ، ثُمَّ قُلْتُ : أَیْنَ أَذْہَبُ ، أُصَلِّی خَلْفَ ہَذَا ؟ قَالَ : فَقُلْتُ مَرَّۃً : أَذْہَبُ ، وَمَرَّۃً: لاَ أَذْہَبُ ، قَالَ : فَاجْتَمَعَ رَأْیِی عَلَی الذَّہَابِ ، قَالَ : فَنَادَانِی مُنَادٍ مِنْ جَانِبِ الْبَیْتِ : { یَا أَیُّہَا الَّذِینَ آمَنُوا إِِذَا نُودِیَ لِلصَّلاَۃِ مِنْ یَوْمِ الْجُمُعَۃِ ، فَاسْعَوْا إِلَی ذِکْرِ اللہِ وَذَرُوا الْبَیْعَ } ۔n قَالَ : وَجَلَسْتُ مَرَّۃً أَکْتُبُ کِتَابًا ، فَعَرَضَ لِی شَیْئٌ ، إِنْ أَنَا کَتَبْتُہُ فِی کِتَابِی زَیَّنَ کِتَابِی ، وَکُنْتُ قَدْ کَذَبْتُ ، وَإِنْ أَنَا تَرَکْتُہُ کَانَ فِی کِتَابِی بَعْضُ الْقُبْحِ ، وَکُنْتُ قَدْ صَدَقْتُ ، فَقُلْتُ مَرَّۃً : أَکْتُبُہُ ، وَقُلْتُ مَرَّۃً : لاَ أَکْتُبُہُ ، قَالَ : فَاجْتَمَعَ رَأْیِی عَلَی تَرْکِہِ ، فَتَرَکْتُہُ ، قَالَ : فَنَادَانِی مُنَادٍ مِنْ جَانِبِ الْبَیْتِ : { یُثَبِّتُ اللَّہُ الَّذِینَ آمَنُوا بِالْقَوْلِ الثَّابِتِ فِی الْحَیَاۃِ الدُّنْیَا وَفِی الآخِرَۃِ } ۔","No Data Available","Musannaf Ibn Abi Shaybah 5445","","","كتاب الجمعة"
"5446","(۵۴۴۶) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَبِی سِنَانٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی الْہُذَیْلِ ، قَالَ : تَذَاکَرُوا الْجُمُعَۃَ زَمَانَ الْمُخْتَارِ ، فَقَالَ : ائْتُوہَا وَإِنْ بَلَغَ الْمَائُ الْحَصَی۔","No Data Available","Musannaf Ibn Abi Shaybah 5446","","","كتاب الجمعة"
"5447","(۵۴۴۷) حَدَّثَنَا ہُشَیْمٌ، عَنْ عَبْدِالْحَمِیدِ بْنِ جَعْفَرٍ، عَنْ أَبِیہِ، قَالَ: کَانَ عَبْدُ اللہِ بْنُ رَوَاحَۃَ یَأْتِی الْجُمُعَۃَ مَاشِیًا، فَإِذَا رَجَعَ رَجَعَ کَیْفَ شَائَ ، إِنْ شَائَ مَاشِیًا ، وَإِنْ شَائَ رَاکِبًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5447","","","كتاب الجمعة"
"5448","(۵۴۴۸) حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِیئُ ، عَنْ سَعِیدِ بْنِ أَبِی أَیُّوبَ ، قَالَ : حدَّثَنِی الْوَلِیدُ بْنُ أَبِی الْوَلِیدِ ، قَالَ: رَأَیْتُ أَبَا ہُرَیْرَۃَ یَأْتِی الْجُمُعَۃَ مِنْ ذِی الْحُلَیْفَۃِ مَاشِیًا۔","Sahih","Musannaf Ibn Abi Shaybah 5448","","","كتاب الجمعة"
"5449","(۵۴۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إِبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ الرُّکُوبَ إِلَی الْجُمُعَۃِ وَالْعِیدَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5449","","","كتاب الجمعة"
"5450","(۵۴۵۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ التَّحَلُّق لِلْحَدِیثِ یَوْمَ الْجُمُعَۃِ قَبْلَ الصَّلاَۃ۔","Hasan","Musannaf Ibn Abi Shaybah 5450","","","كتاب الجمعة"
"5451","(۵۴۵۱) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنْ یُوسُفَ بْنِ السَّائِبِ ، عَنِ السَّائِبِ ، قَالَ : کُنَّا نَتَحَلَّقُ یَوْمَ الْجُمُعَۃِ قَبْلَ الصَّلاَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5451","","","كتاب الجمعة"
"5452","(۵۴۵۲) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، عَنْ أَبِی الزَّاہِرِیَّۃِ ، قَالَ : کُنْتُ مَعَ عَبْدِ اللہِ بْنِ بُسْرٍ یَوْمَ الْجُمُعَۃِ ، فَمَا زَالَ یُحَدِّثُنِی حَتَّی خَرَجَ الإِمَامُ۔","Sahih","Musannaf Ibn Abi Shaybah 5452","","","كتاب الجمعة"
"5453","(۵۴۵۳) حَدَّثَنَا جَدِّی أَبُو عَامِرٍ الْعَقَدِیُّ ، عَنْ مُحَمَّدِ بْنِ ہِلاَلٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ أَبُو ہُرَیْرَۃَ یُحَدِّثُنَا یَوْمَ الْجُمُعَۃِ حَتَّی یَخْرُجَ الإِمَامُ۔","Da'if","Musannaf Ibn Abi Shaybah 5453","","","كتاب الجمعة"
"5454","(۵۴۵۴) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : أَخْبَرَنَا الضَّحَّاکُ بْنُ عُثْمَانَ ، قَالَ : أَخْبَرَنِی نَافِعٌ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَتَرَبَّعُ وَیَسْتَوِی فِی مَجْلِسِہِ یَوْمَ الْجُمُعَۃِ قَبْلَ أَنْ یَخْرُجَ الإِمَامُ۔","Hasan","Musannaf Ibn Abi Shaybah 5454","","","كتاب الجمعة"
"5455","(۵۴۵۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : الْقُنُوتُ یَوْمَ الْجُمُعَۃِ بِدْعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5455","","","كتاب الجمعة"
"5456","(۵۴۵۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ أَنَّہُ کَانَ یَکْرَہُ الْقُنُوتَ یَوْمَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5456","","","كتاب الجمعة"
"5457","(۵۴۵۷) حَدَّثَنَا شَرِیکٌ ، عَنْ عبد اللہِ بْنِ یَزِیدَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : الْقُنُوتُ فِی الْجُمُعَۃِ بِدْعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5457","","","كتاب الجمعة"
"5458","(۵۴۵۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ شَرِیکٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : صَلَّیْتُ خَلْفَ الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، وَالنُّعْمَانِ بْنِ بَشِیرٍ الْجُمُعَۃَ فَلَمْ یَقْنُتَا ، وَخَلْفَ عَلِیٍّ ۔ فَقُلْتُ : أَقَنَتَ بِکُمْ ؟ قَالَ : لاَ۔","Hasan","Musannaf Ibn Abi Shaybah 5458","","","كتاب الجمعة"
"5459","(۵۴۵۹) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ : حَدَّثَنِی أَبِی ، قَالَ : أَدْرَکْتُ النَّاسَ قَبْلَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ یَقْنُتُونَ فِی الْجُمُعَۃِ ، فَلَمَّا کَانَ زَمَنُ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ تُرِکَ الْقُنُوتُ فِی الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5459","","","كتاب الجمعة"
"5460","(۵۴۶۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنْ نَافِعٍ ، قَالَ : لَمْ یَکُنْ عَبْدُ اللہِ بْنُ عُمَرَ یَقْنُتُ فِی الْفَجْرِ وَالْجُمُعَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 5460","","","كتاب الجمعة"
"5461","(۵۴۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُسْتَحَبُّ لِلإِمَامِ إذَا صَلَّی أَنْ یَدْخُلَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5461","","","كتاب الجمعة"
"5462","(۵۴۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ مُحَمَّدِ بْنِ عَمْرو بْنِ حَلْحَلَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرو بْنِ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ إِذَا صَلَّی الْجُمُعَۃَ فَسَلَّمَ ، دَخَلَ۔","Sahih","Musannaf Ibn Abi Shaybah 5462","","","كتاب الجمعة"
"5463","(۵۴۶۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ ر??سُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی الرَّکْعَتَیْنِ بَعْدَ الْجُمُعَۃِ فِی بَیْتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5463","","","كتاب الجمعة"
"5464","(۵۴۶۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : صَلَّیْتُ مَعَہُ الْجُمُعَۃَ ، فَلَمَّا قَضَیْتُ صَلاَتِی أَخَذَ بِیَدِی ، فَقَامَ فِی مَقَامِی ، وَأَقَامَنِی فِی مُقَامِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5464","","","كتاب الجمعة"
"5465","(۵۴۶۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَیرٍرے ، قَالَ : رَأَیْتُ عُقْبَۃَ بْنَ عبْدِ الْغَافِرِ ، وَحَسَّانَ بْنَ بِلاَلٍ یَوْمَ الْجُمُعَۃِ إِذَا قَضَی الإِمَامُ صَلاَتَہُ تَحَوَّلاَ مِنْ مَقَامِہِمَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5465","","","كتاب الجمعة"
"5466","(۵۴۶۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، قَالَ : حدَّثَنِی دِعَامَۃُ بْنُ یَزِیدَ الْعَنْبَرِیُّ ؛ أَنَّہُ صَلَّی إِلَی جَنْبِ أَبِی مِجْلَزٍ فِی الْجُمُعَۃِ ، فَلَمَّا قُضِیَتِ الصَّلاَۃُ أَخَذَ بِیَدِی ، فَأَقَامَنِی فِی مُقَامِہِ الَّذِی کَانَ فِیہِ ، وَقَامَ فِی مَقَامِی۔","No Data Available","Musannaf Ibn Abi Shaybah 5466","","","كتاب الجمعة"
"5467","(۵۴۶۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ ہَمَّامٍ ، عَنْ قَتَادَۃَ ، عَنْ حَبِیبٍ ، قَالَ : صَلَّیْتُ إِلَی جَنْبِ صَفْوَانَ بْنِ مُحْرِزٍ الْجُمُعَۃَ ، فَحَوَّلَنِی إِلَی مَکَانِہِ ، وَتَحَوَّلَ فِی مَکَانِی۔","No Data Available","Musannaf Ibn Abi Shaybah 5467","","","كتاب الجمعة"
"5468","(۵۴۶۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عَبْدُ الْمَلِکِ بْنُ أَبِی سُلَیْمَانَ ، قَالَ : حَدَّثَنَا عَطَائٌ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ صَلَّی الْجُمُعَۃَ ، ثُمَّ تَنَحَّی عَنْ مَکَانِہِ ، فَصَلَّی رَکْعَتَیْنِ فِیہِمَا خِفَّۃٌ ، ثُمَّ تَنَحَّی عَنْ مَقَامِہِ ذَلِکَ فَصَلَّی أَرْبَعًا ، ہِیَ أَطْوَلُ مِنْ تَیْنِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 5468","","","كتاب الجمعة"
"5469","(۵۴۶۹) حَدَّثَنَا غُنْدَرٌ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عُمَرُ بْنُ عَطَائِ بْنِ أَبِی الْخُوَارِ ؛ أَنَّ نَافِعَ بْنَ جُبَیْرٍ أَرْسَلَہُ إِلَی السَّائِبِ ابْنِ أُخْتِ نَمِرٍ ، یَسْأَلُہُ عَنْ شَیْئٍ رَآہُ مِنْہُ مُعَاوِیَۃُ فِی الصَّلاَۃِ ، فَقَالَ : نَعَمْ ، صَلَّیْتُ مَعَہُ الْجُمُعَۃَ فِی الْمَقْصُورَۃِ ، فَلَمَّا سَلَّمَ الإِمَامُ قُمْتُ فِی مَقَامِی فَصَلَّیْتُ ، فَلَمَّا دَخَلَ أَرْسَلَ إِلَیَّ ، وَقَالَ : لاَ تَعُدْ لِمَا فَعَلْتَ ، إِذَا صَلَّیْتَ الْجُمُعَۃَ فَلاَ تَصِلْہَا بِصَلاَۃٍ حَتَّی تَکَلَّمَ ، أَوْ تَخْرُجَ ، فَإِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَنَا بِذَلِکَ : أَنْ لاَ نُوصِلَ صَلاَۃً حَتَّی نَتَکَلَّمَ ، أَوْ نَخْرُجَ۔ (مسلم ۷۳۔ ابوداؤد ۱۲۲)","Sahih","Musannaf Ibn Abi Shaybah 5469","","","كتاب الجمعة"
"5470","(۵۴۷۰) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ ثَوْرٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، عَنْ عَمْرِو بْنِ الْعَاصِ ، قَالَ : کَانَ یَکْرَہُ الصَّلاَۃَ نِصْفَ النَّہَارِ ، إِلاَّ یَوْمَ جُمُعَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5470","","","كتاب الجمعة"
"5471","(۵۴۷۱) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : یَوْمُ الْجُمُعَۃِ صَلاَۃٌ کُلُّہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5471","","","كتاب الجمعة"
"5472","(۵۴۷۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، قَالَ : تُکْرَہُ الصَّلاَۃ نِصْفَ النَّہَارِ إِلاَّ یَوْمَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5472","","","كتاب الجمعة"
"5473","(۵۴۷۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ مُعَاوِیَۃَ بْنَ قُرَّۃَ عَنِ الصَّلاَۃِ قَبْلَ أَنْ تَزُولَ الشَّمْسُ یَوْمَ الْجُمُعَۃِ ؟ فَلَمْ یَرَ بِہَا بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5473","","","كتاب الجمعة"
"5474","(۵۴۷۴) حَدَّثَنَا مُحَمَّدُ بْنُ مُیَسَّر ، عَنْ مُبَارَکٍ ، عَنِ الْحَسَنِ ، قَالَ : تُکْرَہُ الصَّلاَۃُ نِصْفَ النَّہَارِ ، إِلاَّ یَوْمَ جُمُعَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5474","","","كتاب الجمعة"
"5475","(۵۴۷۵) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ : یَوْمُ الْجُمُعَۃِ صَلاَۃٌ کُلُّہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5475","","","كتاب الجمعة"
"5476","(۵۴۷۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِالصَّلاَۃ یَوْمَ الْجُمُعَۃِ نِصْفَ النَّہَارِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5476","","","كتاب الجمعة"
"5477","(۵۴۷۷) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، عَنْ مَنْصُورٍ ، عَنِ الْحَسَنِ ، أَنَّہُ قَالَ : النِّدَائُ الأَوَّلُ یَوْمَ الْجُمُعَۃِ ؛ الَّذِی یَکُونُ عِنْدَ خُرُوجِ الإِمَامِ ، وَالَّذِی قَبْلَ ذَلِکَ مُحْدَثٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5477","","","كتاب الجمعة"
"5478","(۵۴۷۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا شَیْخٌ مِنْ قُرَیْشٍ ، عَنْ نَافِعٍ ، قَالَ : سَمِعْتُہُ یُحَدِّثُ عَنِ ابْنِ عُمَرَ ، أَنَّہُ قَالَ : الأَذَانُ یَوْمَ الْجُمُعَۃِ ؛ الَّذِی یَکُونُ عِنْدَ خُرُوجِ الإِمَامِ ، وَالَّذِی قَبْلَ ذَلِکَ مُحْدَثٌ۔","Da'if","Musannaf Ibn Abi Shaybah 5478","","","كتاب الجمعة"
"5479","(۵۴۷۹) حَدَّثَنَا شَبَابَۃُ، قَالَ: حدَّثَنَا ہِشَامُ بْنُ الْغَازِ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، قَالَ: الأَذَانُ الأَوَّلُ یَوْمَ الْجُمُعَۃِ بِدْعَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 5479","","","كتاب الجمعة"
"5480","(۵۴۸۰) حَدَّثَنَا ہُشَیْمٌ، عَنْ أَشْعَثَ، عَنِ الزُّہْرِیِّ، قَالَ: أَوَّلُ مَنْ أَحْدَثَ الأَذَانَ الأَوَّلَ عُثْمَانُ، لِیُؤْذِنَ أَہْلَ الأَسْوَاقِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5480","","","كتاب الجمعة"
"5481","(۵۴۸۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ إِسْمَاعِیلَ ، عَنِ الْحَسَنِ ، أَنَّہُ حَدَّثَہُمْ : أَنَّ الأَذَانَ کَانَ عَلَی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِذَا خَرَجَ ، فَإِذَا فَرَغَ مِنَ الْخُطْبَۃِ أُقِیمَتِ الصَّلاَۃ۔ (بخاری ۹۱۲)","","Musannaf Ibn Abi Shaybah 5481","","","كتاب الجمعة"
"5482","(۵۴۸۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ بُرْدٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : کَانَ الأَذَانُ عِنْدَ خُرُوجِ الإِمَامِ ، فَأَحْدَثَ أَمِیرُ الْمُؤْمِنِینَ عُثْمَانُ التَّأْذِینَۃَ الثَّالِثَۃَ عَلَی الزَّوْرَائِ ، لِیَجْتَمِعَ النَّاسُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5482","","","كتاب الجمعة"
"5483","(۵۴۸۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ الْغَازِ ، قَالَ : سَأَلْتُ نَافِعًا مَوْلَی ابْنِ عُمَرَ عَنِ الأَذَانِ الأَوَّلِ یَوْمَ الْجُمُعَۃِ ؟ فَقَالَ : قَالَ ابْنُ عُمَرَ : بِدْعَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 5483","","","كتاب الجمعة"
"5484","(۵۴۸۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی فَرْوَۃَ ، عَنْ أَبِی الأَحْوَص ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْرَأُ فِی صَلاَۃِ الْغَدَاۃِ ، یَوْمَ الْجُمُعَۃِ : (الم تَنْزِیلُ) السَّجْدَۃِ ، وَسُورَۃً مِنَ الْمُفَصَّلِ۔","","Musannaf Ibn Abi Shaybah 5484","","","كتاب الجمعة"
"5485","(۵۴۸۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ یُسْتَحَبُّ أَنْ یُقْرَأَ یَوْمَ الْجُمُعَۃِ بِسُورَۃٍ فِیہَا سَجْدَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5485","","","كتاب الجمعة"
"5486","(۵۴۸۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : مَا شَہِدْتُ ابْنَ عَبَّاسٍ قَرَأَ یَوْمَ الْجُمُعَۃِ إِلاَّ بـ : (الم تَنْزِیلُ) ، وَ(ہَلْ أَتَی عَلَی الإِنْسَانِ) ۔","Da'if","Musannaf Ibn Abi Shaybah 5486","","","كتاب الجمعة"
"5487","(۵۴۸۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ شَرِیکٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : مَا صَلَّیْتُ خَلْفَ ابْنِ عَبَّاسٍ یَوْمَ الْجُمُعَۃِ الْغَدَاۃَ ، إِلاَّ قَرَأَ سُورَۃً فِیہَا سَجْدَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5487","","","كتاب الجمعة"
"5488","(۵۴۸۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الْحَسَنِ بْنِ صَالِحٍ ، عَنْ أَبِیہِ ، عَنْ عُثْمَانَ بْنِ أَبِی صَفِیَّۃَ ، عَنْ عَلِیٍّ ؛ أَنَّہُ قَرَأَ فِی الْفَجْرِ یَوْمَ الْجُمُعَۃِ بِسُورَۃِ الْحَشْرِ ، وَسُورَۃِ الْجُمُعَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 5488","","","كتاب الجمعة"
"5489","(۵۴۸۹) حَدَّثَنَا مُحَمَّدُ بْنِ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانُوا یَقْرَؤُونَ یَوْمَ الْجُمُعَۃِ بِسُورَۃٍ فِیہَا سَجْدَۃٌ ، فَسَأَلْتُ مُحَمَّدًا ، فَقَالَ : لاَ أَعْلَمُ بِہِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5489","","","كتاب الجمعة"
"5490","(۵۴۹۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ سُفْیَانَ ، عَنْ مُخوَّلٍ ، عَنْ مُسْلِمٍ الْبَطِینِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقْرَأُ فِی صَلاَۃِ الْفَجْرِ یَوْمَ الْجُمُعَۃِ بِـ : (الم تَنْزِیلُ) ، وَ{ہَلْ أَتَی عَلَی الإِنْسَان حِینٌ مِنَ الدَّہْرِ}۔ (ترمذی ۵۲۰۔ ابوداؤد ۱۰۶۷)","Hasan","Musannaf Ibn Abi Shaybah 5490","","","كتاب الجمعة"
"5491","(۵۴۹۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : أَمَّنَا إِبْرَاہِیمُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ وَنَحْنُ بِالْمَدِینَۃِ ، فَصَلَّیْتُ وَرَائَہُ یَوْمَ الْجُمُعَۃِ صَلاَۃَ الْغَدَاۃِ ، فَقَرَأَ : (الم تَنْزِیلُ) وَ{ہَلْ أَتَی عَلَی الإِنْسَان}۔","No Data Available","Musannaf Ibn Abi Shaybah 5491","","","كتاب الجمعة"
"5492","(۵۴۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ ہُرْمُزَ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقْرَأُ فِی الْفَجْرِ یَوْمَ الْجُمُعَۃِ بِـ : (الم تَنْزِیلُ) ، وَ{ہَلْ أَتَی عَلَی الإِنْسَان}۔ (بخاری ۱۰۶۸۔ مسلم ۶۶)","Sahih","Musannaf Ibn Abi Shaybah 5492","","","كتاب الجمعة"
"5493","(۵۴۹۳) حَدَّثَنَا ابْنُ فُضَیْلِ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی حَمْزَۃَ الأَعْوَرِ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ صَلَّی بِہِمْ یَوْمَ الْجُمُعَۃِ الْفَجْر، فَقَرَأَ بِہِمْ بِـ : (کہیعص)۔","No Data Available","Musannaf Ibn Abi Shaybah 5493","","","كتاب الجمعة"
"5494","(۵۴۹۴) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ إِبْرَاہِیمَ بْنِ مُحَمَّدِ بن الْمُنْتَشِرِ ، عَنْ أَبِیہِ ، عَنْ حَبِیبِ بْنِ سَالِمٍ ، عَنِ النُّعْمَانِ بْنِ بَشِیرٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقْرَأُ فِی الْعِیدَیْنِ وَالْجُمُعَۃِ بِـ : {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} ، وَ{ہَلْ أَتَاکَ حَدِیثُ الْغَاشِیَۃِ} وَإِذَا اجْتَمَعَ الْعِیدَانِ فِی یَوْمٍ ، قَرَأَ بِہِمَا فِیہِمَا۔ (مسلم ۶۲۔ ابوداؤد ۱۱۱۵)","Sahih","Musannaf Ibn Abi Shaybah 5494","","","كتاب الجمعة"
"5495","(۵۴۹۵) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی رَافِعٍ ، قَالَ : اسْتَخْلَفَ مَرْوَانُ أَبَا ہُرَیْرَۃَ عَلَی الْمَدِینَۃِ ، وَخَرَجَ إِلَی مَکَّۃَ ، فَصَلَّی بِنَا أَبُو ہُرَیْرَۃَ الْجُمُعَۃَ ، فَقَرَأَ بِسُورَۃِ الْجُمُعَۃِ فِی السَّجْدَۃِ الأُولَی ، وَفِی الآخِرَۃِ : {إِذَا جَائَکَ الْمُنَافِقُونَ} ۔n فَقَالَ عُبَیْدُ اللہِ : فَأَدْرَکْتُ أَبَا ہُرَیْرَۃَ حِینَ انْصَرَفَ ، فَقُلْتُ لَہُ : إِنَّک قَرَأْتَ بِسُورَتَیْنِ کَانَ عَلِیٌّ یَقْرَأُ بِہِمَا بِالْکُوفَۃِ ، فَقَالَ أَبُو ہُرَیْرَۃَ : إِنِّی سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْرَأُ بِہِمَا۔ (مسلم ۶۱۔ ابوداؤد ۱۱۱۷)","Sahih","Musannaf Ibn Abi Shaybah 5495","","","كتاب الجمعة"
"5496","(۵۴۹۶) حَدَّثَنَا عَبْدَۃُ ، عَنْ سُفْیَانَ ، عَنْ مُخَوَّلٍ ، عَنْ مُسْلِمٍ الْبَطِینِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقْرَأُ فِی الْجُمُعَۃِ بِسُورَۃِ الْجُمُعَۃِ ، وَ{إِذَا جَائَکَ الْمُنَافِقُونَ}۔ (ابوداؤد ۱۰۶۸۔ نسائی ۱۷۳۶)","Sahih","Musannaf Ibn Abi Shaybah 5496","","","كتاب الجمعة"
"5497","(۵۴۹۷) حَدَّثَنَا یَعْلَی ، عَنْ مِسْعَرٍ ، عَنْ مَعْبَدِ بْنِ خَالِدٍ ، عَنْ زَیْدِ بْنِ عُقْبَۃَ ، عَنْ سَمُرَۃََ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْرَأُ فِی الْجُمُعَۃِ بِـ : {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} ، وَ{ہَلْ أَتَاکَ حَدِیثُ الْغَاشِیَۃِ}۔ (ابوداؤد ۱۱۸۔ نسائی ۱۷۳۹)","Sahih","Musannaf Ibn Abi Shaybah 5497","","","كتاب الجمعة"
"5498","(۵۴۹۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَنِ الْحَکَمِ ، عَنْ أُنَاسٍ مِنْ أَہْلِ الْمَدِینَۃِ ، أُرَی فِیہِمْ أَبَا جَعْفَرٍ ، قَالَ : کَانَ یُقْرَأُ فِی الْجُمُعَۃِ بِسُورَۃِ الْجُمُعَۃِ وَالْمُنَافِقِینَ ، فَأَمَّا سُورَۃُ الْجُمُعَۃِ فَیُبَشِّرُ بِہَا الْمُؤْمِنِینَ وَیُحَرِّضُہُمْ ، وَأَمَّا سُورَۃُ الْمُنَافِقِینَ فَیُؤَیِّسُ بِہَا الْمُنَافِقِینَ وَیُوَبِّخُہُمْ بِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5498","","","كتاب الجمعة"
"5499","(۵۴۹۹) حَدَّثَنَا عَبْدَۃُ ، وَوَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عُمَیْرِ بْنِ سَعِیدٍ ، قَالَ : صَلَّیْتُ خَلْفَ أَبِی مُوسَی الْجُمُعَۃَ فَقَرَأَ بِـ : {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} ، وَ{ہَلْ أَتَاک حَدِیثُ الْغَاشِیَۃِ} ۔","Sahih","Musannaf Ibn Abi Shaybah 5499","","","كتاب الجمعة"
"5500","(۵۵۰۰) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، قَالَ : صَلَّیْتُ خَلْفَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، وَأَبِی بَکْرِ بْنِ عَمْرٍو الْجُمُعَۃَ ، فَقَرَآ فِی الرَّکْعَۃِ الأُولَی بِسُورَۃِ الْجُمُعَۃِ ، وَفِی الرَّکْعَۃِ الثَّانِیَۃِ بِـ : {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی}۔","No Data Available","Musannaf Ibn Abi Shaybah 5500","","","كتاب الجمعة"
"5501","(۵۵۰۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی الْقِرَائَۃِ یَوْمَ الْجُمُعَۃِ ، قَالَ : یَقْرَأُ الإِمَامُ بِمَا شَائَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5501","","","كتاب الجمعة"
"5502","(۵۵۰۲) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، وَعَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَوْفِ بْنِ حَصِیرَۃ ؛ فِی السَّاعَۃِ الَّتِی تُرْجَی فِی الْجُمُعَۃِ : مَا بَیْنَ خُرُوجِ الإِمَامِ إِلَی أَنْ تُقْضَی الصَّلاَۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5502","","","كتاب الجمعة"
"5503","(۵۵۰۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حَجَّاجٌ ، عَنْ عَطَائٍ ، عَنْ عَبْدِ اللہِ بْنِ سَلاَمٍ ، قَالَ : مَا بَیْنَ الْعَصْرِ إِلَی أَنْ تَغْرُبَ الشَّمْسُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5503","","","كتاب الجمعة"
"5504","(۵۵۰۴) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْن أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، وَأَبِی ہُرَیْرَۃَ ، قَالاَ : السَّاعَۃُ الَّتِی تُذْکَرُ فِی الْجُمُعَۃِ : مَا بَیْنَ الْعَصْرِ إِلَی أَنْ تَغْرُبَ الشَّمْسُ۔","Da'if","Musannaf Ibn Abi Shaybah 5504","","","كتاب الجمعة"
"5505","(۵۵۰۵) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 5505","","","كتاب الجمعة"
"5506","(۵۵۰۶) حَدَّثَنَا ہُشَیْمٌ، عَنْ مُغِیرَۃَ، عَنْ وَاصِلٍ ، عَنْ أَبِی بُرْدَۃَ، قَالَ: کُنْتُ عِنْدَ ابْنِ عُمَرَ، فَسُئِلَ عَنِ السَّاعَۃِ الَّتِی فِی الْجُمُعَۃِ ؟ قَالَ : فَقُلْتُ ہِیَ السَّاعَۃُ الَّتِی اخْتَارَ اللَّہُ لَہَا ، أَوْ فِیہَا الصَّلاَۃَ ، قَالَ : فَمَسَحَ رَأْسِی ، وَبَرَّکَ عَلَیَّ ، وَأَعْجَبَہُ مَا قُلْتُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5506","","","كتاب الجمعة"
"5507","(۵۵۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی بُرْدَۃَ ، قَالَ : ہِیَ عِنْدَ خُرُوجِ الإِمَام۔","No Data Available","Musannaf Ibn Abi Shaybah 5507","","","كتاب الجمعة"
"5508","(۵۵۰۸) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنَا مُعَاوِیَۃُ بْنُ صَالِحٍ ، قَالَ : حَدَّثَنَا مُوسَی بْنُ یَزِیدَ بْنِ مَوْہَبٍ أَبُو عَبْدِ الرَّحْمَنِ الأَمْلُوکِیُّ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : إِنِّی لأَرْجُو أَنْ تَکُونَ السَّاعَۃُ الَّتِی فِی الْجُمُعَۃِ إِحْدَی ہَذِہِ السَّاعَاتِ: إِذَا أَذَّنَ الْمُؤَذِّنُ ، أَوْ الإِمَامُ عَلَی الْمِنْبَرِ ، أَوَعِنْدَ الإِقَامَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 5508","","","كتاب الجمعة"
"5509","(۵۵۰۹) حَدَّثَنَا ہُشَیْمٌ، قَالَ: أَخْبَرَنَا مَنْصُورٌ، عَنِ الْحَسَنِ؛ أَنَّہُ کَانَ یَقُولُ ہِیَ عِنْدَ زَوَالِ الشَّمْسِ، فِی وَقْتِ الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 5509","","","كتاب الجمعة"
"5510","(۵۵۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : ہِیَ مَا بَیْنَ أَنْ یَحْرُمَ الْبَیْعُ إِلَی أَنْ یَحْلِل۔","No Data Available","Musannaf Ibn Abi Shaybah 5510","","","كتاب الجمعة"
"5511","(۵۵۱۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ مُجَاہِدٍ ، قَالَ : ہِیَ بَعْدَ الْعَصْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5511","","","كتاب الجمعة"
"5512","(۵۵۱۲) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُلَیْمَانُ بْنُ قَرْمٍ ، عَنْ أَبِی حَبِیبٍ ، عَنْ نُبَلَ ، عَنْ سَلاَمَۃَ بِنْتِ أَفْعَی ، قَالَتْ : کُنْتُ عِنْدَ عَائِشَۃَ فِی نِسْوَۃٍ ، فَسَمِعْتُہَا تَقُولُ : إِنَّ یَوْمَ الْجُمُعَۃِ مِثْلُ یَوْمِ عَرَفَۃَ ، وَإِنَّ فِیہِ لَسَاعَۃً تُفْتَحُ فِیہَا أَبْوَابُ الرَّحْمَۃِ ، فَقُلْنَا : أَیُّ سَاعَۃٍ ؟ فَقَالَتْ : حِینَ یُنَادِی الْمُنَادِی بِالصَّلاَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 5512","","","كتاب الجمعة"
"5513","(۵۵۱۳) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ سِنَانِ بْنِ حَبِیبٍ ، عَنْ نُبَلَ بِنْتِ بَدْرٍ ، عَنْ سَلاَمَۃَ بِنْتِ أفْعَی ، عَنْ عَائِشَۃَ ، قَالَتْ : إِنَّ یَوْمَ الْجُمُعَۃِ مِثْلُ یَوْمِ عَرَفَۃَ ، تُفْتَحُ فِیہِ أَبْوَابُ الرَّحْمَۃِ ، وَفِیہِ سَاعَۃٌ لاَ یَسْأَلُ اللَّہَ الْعَبْدُ شَیْئًا إِلاَّ أَعْطَاہُ، قِیلَ : وَأَیَّۃُ سَاعَۃٍ ؟ قَالَتْ : إِذَا أَذَّنَ الْمُؤَذِّنُ لِصَلاَۃِ الْغَدَاۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 5513","","","كتاب الجمعة"
"5514","(۵۵۱۴) حَدَّثَنَا أَحْمَدُ بْنُ إِسْحَاقَ ، عَنْ وُہَیْبٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ : إِنَّ السَّاعَۃَ الَّتِی تُرْجَی فِی الْجُمُعَۃِ بَعْدَ الْعَصْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5514","","","كتاب الجمعة"
"5515","(۵۵۱۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، وَمَنْصُورٍ ، عَنِ الْحَسَنِ ، قَالَ : بَیْنَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَخْطُبُ إِذْ جَائَ رَجُلٌ یَتَخَطَّی رِقَابَ النَّاسِ یَوْمَ الْجُمُعَۃِ ، حَتَّی جَلَسَ قَرِیبًا مِنَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَلَمَّا قَضَی صَلاَتَہُ ، قَالَ لَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَا فُلاَنُ ، أَمَا جَمَّعْتَ ؟ قَالَ : یَا رَسُولَ اللہِ ، أَمَا رَأَیْتَنِی ؟ قَالَ : قَدْ رَأَیْتُک آنَیْتَ وَآذَیْتَ۔ (ابوداؤد ۱۱۱۱۔ ابن خزیمۃ ۱۸۱۱)","","Musannaf Ibn Abi Shaybah 5515","","","كتاب الجمعة"
"5516","(۵۵۱۶) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنِ الأَوْزَاعِیِّ ، عَنْ مُوسَی بْنِ سُلَیْمَانَ ، عَنِ الْقَاسِمِ بْنِ مُخَیْمِرَۃَ ، قَالَ : مَثَلُ الَّذِی یَتَخَطَّی رِقَابَ النَّاسِ یَوْمَ الْجُمُعَۃِ وَالإِمَامُ یَخْطُبُ ، کَالرَّافِعِ قَدَمَیْہِ فِی النَّارِ ، وَوَاضِعِہِمَا فِی النَّارِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5516","","","كتاب الجمعة"
"5517","(۵۵۱۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْوَلِیدِ ، قَالَ : حدَّثَنِی عُثْمَانُ بْنُ عَبْدِ اللہِ بْنِ مَوْہَبٍ ، قَالَ : قَالَ سَعِیدُ بْنُ الْمُسَیَّبِ : لأَنْ أُصَلِّیَ الْجُمُعَۃَ بِالْحَرَّۃِ ، أَحَبُّ إِلَیَّ مِنَ التَّخَطِّی۔","No Data Available","Musannaf Ibn Abi Shaybah 5517","","","كتاب الجمعة"
"5518","(۵۵۱۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْوَلِیدِ ، عَنْ عُبَیْدِ بْنِ الْحَسَنِ ، قَالَ : رَأَیْتُ عُرْوَۃَ بْنَ الْمُغِیرَۃِ جَائَ إِلَی الْجُمُعَۃِ ، فَلَمَّا انْتَہَی قَامَ ، یَعْنِی وَلَمْ یَتَخَطَّ۔","No Data Available","Musannaf Ibn Abi Shaybah 5518","","","كتاب الجمعة"
"5519","(۵۵۱۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قَالَ مُحَمَّدٌ : إِنَّہُمْ یَقُولُونَ : إِنَّ مُحَمَّدًا یَتَخَطَّی رِقَابَ النَّاسِ یَوْمَ الْجُمُعَۃِ ، وَلَسْتُ أَتَخَطَّی ، إِنَّمَا أَجِیئُ فَأَقُومُ فَیَعْرِفُنِی الرَّجُلُ ، فَیُوَسِّعُ لِی۔","No Data Available","Musannaf Ibn Abi Shaybah 5519","","","كتاب الجمعة"
"5520","(۵۵۲۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حُمَیْدٍ الأَصَمِّ ، عَنْ أَبِی قَیْسٍ ، قَالَ : دَخَلَ عَبْدُ اللہِ بْنُ مَسْعُودٍ الْمَسْجِدَ یَوْمَ جُمُعَۃٍ ، وَعَلَیْہِ ثِیَابٌ بِیضٌ حِسَانٌ ، فَرَأَی مَکَانًا فِیہِ سَعَۃٌ فَجَلَسَ وَلَمْ یَتَخَطَّ۔","No Data Available","Musannaf Ibn Abi Shaybah 5520","","","كتاب الجمعة"
"5521","(۵۵۲۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ أَنْ یَتَخَطَّی رِقَابَ النَّاسِ إِِذَا کَانَ فِی الْمَسْجِدِ سَعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5521","","","كتاب الجمعة"
"5522","(۵۵۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : رَأَیْتُ شُرَیْحًا جَائَ یَوْمَ الْجُمُعَۃِ وَالإِمَامُ یَخْطُبُ فَجَلَسَ ، یَعْنِی وَلَمْ یَتَخَطَّ۔","No Data Available","Musannaf Ibn Abi Shaybah 5522","","","كتاب الجمعة"
"5523","(۵۵۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ عُمَرَ بْنِ عَطِیَّۃَ ، عَنْ سَلْمَانَ ، قَالَ : إِیَّاکَ وَتَخَطِّیَ رِقَابِ النَّاسِ یَوْمَ الْجُمُعَۃِ ، وَاجْلِسْ حَیْثُ تَبْلُغُکَ الْجُمُعَۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 5523","","","كتاب الجمعة"
"5524","(۵۵۲۴) حَدَّثَنَا وَکِیعٌ ، وَالْفَضْلُ ، عَنْ سُفْیَانَ ، عَنْ صَالِحٍ مَوْلَی التَّوْأَمَۃِ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یَقُولُ : لأَنْ أُصَلِّیَ بِالْحَرَّۃِ أَحَبُّ إلَیَّ مِنْ أَنْ أَتَخَطَّی رِقَابَ النَّاسِ یَوْمَ الْجُمُعَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 5524","","","كتاب الجمعة"
"5525","(۵۵۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ جُوَیْرِیَۃَ بْنِ أَسْمَائَ ، عَنْ خَوَّاتِ بْنِ بُکَیْر ، عَنْ کَعْبٍ ، قَالَ : لأَنْ أَدَعَ الْجُمُعَۃَ أَحَبُّ إِلَیَّ مِنْ أَنْ أَتَخَطَّی رِقَابَ النَّاسِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5525","","","كتاب الجمعة"
"5526","(۵۵۲۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : أَطَالَ بَعْضُ الأُمَرَائِ الْخُطْبَۃَ ، فَأَنْکَیْتُ یَدَیَّ حَتَّی أَدْمَیْتُہَا ، ثُمَّ قُمْتُ وَأَخَذَتْیِح السِّیَاطُ ، فَمَضَیْتُ فَخَرَجْتُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5526","","","كتاب الجمعة"
"5527","(۵۵۲۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَوَّارٍ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ سَبْرَۃَ ؛ أَنَّ سَالِمًا حَدَّثَ الْقَاسِمَ بْنَ مُحَمَّدٍ ، قَالَ : لَمَّا قَدِمَ عَلَیْنَا الأَمِیرُ ، جَائَتِ الْجُمُعَۃُ ، فَجَمَّعَ بِنَا ، فَمَا زَالَ یَخْطُبُ وَیَقْرَأُ الْکُتُبَ حَتَّی مَضَی وَقْتُ الْجُمُعَۃِ ، وَلَمْ یَنْزِلْ یُصَلِّی ۔ فَقَالَ لَہُ الْقَاسِمُ : فَمَا قُمْتَ فَصَلَّیْتَ ؟ قَالَ : لاَ وَاللَّہِ ، خَشِیتُ أَنْ یُقَالَ : رَجُلٌ مِنْ آلِ عُمَرَ ، قَالَ : فَمَا صَلَّیْتَ قَاعِدًا ؟ قَالَ : لاَ ، قَالَ : فَمَا أَوْمَأْتَ ؟ قَالَ : لاَ ، قَالَ : ثُمَّ مَا زَالَ یَخْطُبُ وَیَقْرَأُ حَتَّی مَضَی وَقْتُ الْعَصْرِ وَلَمْ یَنْزِلْ یُصَلِّی ، فَقَالَ لَہُ الْقَاسِمُ : فَمَا قُمْتَ صَلَّیْتَ ؟ قَالَ : لاَ ، قَالَ : فَمَا صَلَّیْت قَاعِدًا ؟ قَالَ : لاَ ، قَالَ : فَمَا أَوْمَأْتَ ؟ قَالَ : لاَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5527","","","كتاب الجمعة"
"5528","(۵۵۲۸) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ إِبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ أَبِی بَکْرِ بْنِ عَمْرِو بْنِ عُتْبَۃَ الزُّہْرِیِّ ، قَالَ : أَخَّرَ الْحَجَّاجُ الْجُمُعَۃَ ، فَلَمَّا صَلَّی صَلاَّہَا مَعَہُ أَبُو جُحَیْفَۃَ ، ثُمَّ قَامَ فَوَصَلَہَا بِرَکْعَتَیْنِ ، ثُمَّ قَالَ : یَا أَبَا بَکْرٍ ، أُشْہِدُکَ أَنَّہَا الْعَصْرُ۔","Da'if","Musannaf Ibn Abi Shaybah 5528","","","كتاب الجمعة"
"5529","(۵۵۲۹) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ إِبْرَاہِیمَ بْنِ مُہَاجِرٍ ، قَالَ : کَانَ الْحَجَّاجُ یُؤَخِّرُ الْجُمُعَۃَ ، فَکُنْت أَنَا أُصَلِّی ، وَإِبْرَاہِیمُ وَسَعِیدُ بْنُ جُبَیْرٍ نُصَلِّی الظُّہْرَ ، ثُمَّ نَتَحَدَّثُ وَہُوَ یَخْطُبُ ، ثُمَّ نُصَلِّی مَعَہُمْ ، ثُمَّ نَجْعَلُہَا نَافِلَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 5529","","","كتاب الجمعة"
"5530","(۵۵۳۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، قَالَ: کُنْتُ أَجْلِسُ مَعَ مَسْرُوقٍ ، وَأَبِی عُبَیْدَۃَ زَمَنَ زِیَادٍ، فَإِذَا دَخَلَ وَقْتُ الصَّلاَۃِ قَامَا فَصَلَّیَا ، ثُمَّ یَجْلِسَانِ حَتَّی إِذَا أَذَّنَ الْمُؤَذِّنُ وَخَرَجَ الإِمَامُ ، قَامَا فَصَلَّیَا مَعَہُ ، وَیَفْعَلاَنِہِ فِی الْعَصْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5530","","","كتاب الجمعة"
"5531","(۵۵۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی ہَاشِمٍ ؛ أَنَّ الْحَجَّاجَ أَخَّرَ الصَّلاَۃَ ، فَأَوْمَأَ أَبُو وَائِلٍ وَہُوَ جَالِسٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5531","","","كتاب الجمعة"
"5532","(۵۵۳۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ بْنِ خُثَیْمٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ؛ أَنَّ الْوَلِیدَ بْنَ عُقْبَۃَ أَخَّرَ الصَّلاَۃَ بِالْکُوفَۃِ وَأَنَا جَالِسٌ مَعَ أَبِی فِی الْمَسْجِدِ ، فَقَامَ عَبْدُ اللہِ فَثَوَّبَ بِالصَّلاَۃ ، فَصَلَّی لِلنَّاسِ ، فَأَرْسَلَ إِلَہِ الْوَلِیدُ بْنُ عُقْبَۃَ : مَا حَمَلَک عَلَی مَا صَنَعْتَ ؟ أَجَائَک مِنْ أَمِیرِ الْمُؤْمِنِینَ أَمْرٌ فِیمَا قِبَلَنَا ، فَسَمْعٌ وَطَاعَۃٌ ، أَمِ ابْتَدَعْتَ مَا صَنَعْتَ الْیَوْمَ ؟ قَالَ : لَمْ یَأْتِنِی مِنْ أَمِیرِ الْمُؤْمِنِینَ أَمْرٌ ، وَمَعَاذَ اللہِ أَنْ أَکُونَ ابْتَدَعْتُ ، أَبَی اللَّہُ وَرَسُولُہُ أَنْ نَنْتَظِرَک بِصَلاَتِنَا وَأَنْتَ فِی حَوَائِجِک۔","Sahih","Musannaf Ibn Abi Shaybah 5532","","","كتاب الجمعة"
"5533","(۵۵۳۳) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنِ الزِّبْرِقَانَ ، قَالَ : قُلْتُ لِشَقِیقٍ : إِنَّ الْحَجَّاجَ یُمِیتُ الْجُمُعَۃَ ، قَالَ : تَکَتَّمَ عَیََّ ؟ قَالَ : قُلْتُ : نَعَمْ ، قَالَ : صَلِّہَا فِی بَیْتِکَ لِوَقْتِہَا ، وَلاَ تَدَعِ الْجَمَاعَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5533","","","كتاب الجمعة"
"5534","(۵۵۳۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : رَفْعُ الأَیْدِی یَوْمَ الْجُمُعَۃِ مُحْدَثٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5534","","","كتاب الجمعة"
"5535","(۵۵۳۵) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : أَوَّلُ مَنْ رَفَعَ یَدَیْہِ فِی الْجُمُعِ عُبَیْدُ اللہِ بْنُ عَبْدِ اللہِ بْنِ مَعْمَرٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5535","","","كتاب الجمعة"
"5536","(۵۵۳۶) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : کَانَ یَکْرَہُ دُعَائَہُمُ الَّذِی یَدْعُونَہُ یَوْمَ الْجُمُعَۃِ ، وَکَانَ لاَ یَرْفَعُ یَدَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5536","","","كتاب الجمعة"
"5537","(۵۵۳۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ ، عَنْ مَسْرُوقٍ ، قَالَ : رَفَعَ الإِمَامُ یَوْمَ الْجُمُعَۃِ یَدَیْہِ عَلَی الْمِنْبَرِ ، فَرَفَعَ النَّاسُ أَیْدِیَہُمْ ، فَقَالَ مَسْرُوقٌ : مَا لَہُمْ ، قَطَعَ اللَّہُ أَیْدِیَہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 5537","","","كتاب الجمعة"
"5538","(۵۵۳۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ عُمَارَۃَ بْنِ رُوَیْبَۃَ ؛ أَنَّہُ رَأَی بِشْرَ بْنَ مَرْوَانَ رَافِعًا یَدَیْہِ یَدْعُو ، حَتَّی کَادَ یَسْتَلْقِی خَلْفَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 5538","","","كتاب الجمعة"
"5539","(۵۵۳۹) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ عُمَارَۃَ بْنِ رُوَیْبَۃَ ، قَالَ : رَأَی بِشْرَ بْنَ مَرْوَانَ رَافِعًا یَدَیْہِ عَلَی الْمِنْبَرِ ، فَقَالَ : قَبَّحَ اللَّہُ ہَاتَیْنِ الْیَدَیْنِ ، لَقَدْ رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَا یَزِیدُ عَلَی أَنْ یَقُولَ بِیَدَیْہِ ہَکَذَا ، وَأَشَارَ بِإِصْبَعِہِ الْمُسَبِّحَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 5539","","","كتاب الجمعة"
"5540","(۵۵۴۰) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ أَصْحَابُ عَبْدِ اللہِ یُصَلُّونَ مَعَ الْمُخْتَارِ الْجُمُعَۃَ ، وَیَحْتَسِبُونَ بِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 5540","","","كتاب الجمعة"
"5541","(۵۵۴۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عُقْبَۃَ الأَسَدِیِّ ، عَنْ یَزِیدَ بْنِ أَبِی سُلَیْمَانَ ؛ أَنَّ أَبَا وَائِلٍ جَمَّعَ مَعَ الْمُخْتَارِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5541","","","كتاب الجمعة"
"5542","(۵۵۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ السَّائِبِ ، عَنْ صَالِحِ بْنِ سَعِیدٍ ، قَالَ : خَرَجْتُ مَعَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ إِلَی السُّوَیْدَائِ مُتَبَدِّیًا ، فَلَمَّا حَضَرَتِ الْجُمُعَۃُ أَذَّنَ الْمُؤَذِّنُ ، فَجَمَعُوا لَہُ حَصْبَائَ ، قَالَ : فَقَامَ فَخَطَبَ ، ثُمَّ صَلَّی الْجُمُعَۃَ رَکْعَتَیْنِ ، ثُمَّ قَالَ : الإِمَامُ یُجَمِّعُ حَیْثُ مَا کَانَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5542","","","كتاب الجمعة"
"5543","(۵۵۴۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ سَعِیدِ بْنِ سُوَیْد ، قَالَ : صَلَّی بِنَا مُعَاوِیَۃُ الْجُمُعَۃَ بِالنَّخِیلَۃِ فِی الضُّحَی ، ثُمَّ خَطَبَنَا۔","Hasan","Musannaf Ibn Abi Shaybah 5543","","","كتاب الجمعة"
"5544","(۵۵۴۴) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، عَنِ الْحَسَنِ ، عَنْ قَیْسِ بْنِ عُبَادٍ (ح) وَعَنْ زُرَارَۃَ بْنِ أَوْفَی ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّہُمَا قَالاَ : مَنْ لَمْ یُصَلِّ فِی الْمَسْجِدِ فَلاَ صَلاَۃَ لَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5544","","","كتاب الجمعة"
"5545","(۵۵۴۵) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِالصَّلاَۃ یَوْمَ الْجُمُعَۃِ فِی السُّدَّۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 5545","","","كتاب الجمعة"
"5546","(۵۵۴۶) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِالصَّلاَۃِ یَوْمَ الْجُمُعَۃِ فِی الرَّحَبَۃِ ، وَإِنْ کَانَ یَقْدِرُ أَنْ یَدْخُلَ فَلاَ صَلاَۃَ لَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5546","","","كتاب الجمعة"
"5547","(۵۵۴۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : رَأَیْتُ عُرْوَۃَ بْنَ الْمُغِیرَۃِ بْنِ شُعْبَۃَ صَلَّی فِی السُّدَّۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5547","","","كتاب الجمعة"
"5548","(۵۵۴۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، وَابْنُ نُمَیْرٍ ، قَالاَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ؛ أَنَّ أَبَا ہُرَیْرَۃَ أَتَی عَلَی رِجَالٍ جُلُوسٍ فِی الرَّحْبَۃِ ، فَقَالَ : اُدْخُلُوا الْمَسْجِدَ ، فَإِنَّہُ لاَ جُمُعَۃَ إِلاَّ فِی الْمَسْجِدِ۔","Sahih","Musannaf Ibn Abi Shaybah 5548","","","كتاب الجمعة"
"5549","(۵۵۴۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، أَنَّہُ قَالَ : لاَ جُمُعَۃَ لِمَنْ صَلَّی فِی الرَّحْبَۃِ ، إِلاَّ أَنْ لاَ یَقْدِرَ عَلَی الدُّخُولِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5549","","","كتاب الجمعة"
"5550","(۵۵۵۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ الصَّلْتِ الرَّبْعِی ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : سَمِعْتُہُ یَقُولُ : إِذَا لَمْ تَسْمَعْ قِرَائَۃَ الإِمَامِ یَوْمَ الْجُمُعَۃِ فَاقْرَأْ۔","No Data Available","Musannaf Ibn Abi Shaybah 5550","","","كتاب الجمعة"
"5551","(۵۵۵۱) حَدَّثَنَا حَاتِمٌ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، عَنِ ابن الْمُسَیَّبِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : سَیِّدُ الأَیَّامِ یَوْمُ الْجُمُعَۃِ۔ (ابن خزیمۃ ۱۷۲۸۔ بیہقی ۲۹۷۱)","","Musannaf Ibn Abi Shaybah 5551","","","كتاب الجمعة"
"5552","(۵۵۵۲) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہُبَیْرَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : إِنَّ سَیِّدَ الأَیَّامِ یَوْمُ الْجُمُعَۃِ ، وَسَیِّدَ الشُّہُورِ رَمَضَانُ۔","Sahih","Musannaf Ibn Abi Shaybah 5552","","","كتاب الجمعة"
"5553","(۵۵۵۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الأَجْلَحِ ، عَنْ أَبِی بُرْدَۃَ بن أَبِی مُوسَی ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ فِی الْجُمُعَۃِ لَسَاعَۃً ، مَا دَعَا اللَّہَ فِیہَا عَبْدٌ مُسْلِمٌ بَشَیئٍ إِلاَّ اسْتَجَابَ لَہُ۔(بخاری ۶۴۰۰۔ مسلم ۵۸۴)","Hasan","Musannaf Ibn Abi Shaybah 5553","","","كتاب الجمعة"
"5554","(۵۵۵۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، عَنْ أَبِی الأَشْعَثِ الصَّنْعَانِیِّ ، عَنْ أَوْسِ بْنِ أَوْسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ مِنْ أَفْضَلِ أَیَّامِکُمْ یَوْمَ الْجُمُعَۃِ ، فِیہِ خُلِقَ آدَم ، وَفِیہِ النَّفْخَۃُ ، وَفِیہِ الصَّعْقَۃُ۔ (ابوداؤد ۱۵۲۶۔ احمد ۴/۸)","Sahih","Musannaf Ibn Abi Shaybah 5554","","","كتاب الجمعة"
"5555","(۵۵۵۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ ضَمْرَۃَ ، عَنْ کَعْبٍ ، قَالَ : لَمْ تَطْلُعِ الشَّمْسُ بِیَوْمٍ ہُوَ أَعْظَمُ مِنَ الْجُمُعَۃِ ، إِنَّہَا إِذَا طَلَعَتْ فَزِعَ لَہَا کُلُّ شَیْئٍ إِلاَّ الثَّقَلَینِ ، اللَّذیْنِ عَلَیْہِمَا الْحِسَابُ وَالْعَذَابُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5555","","","كتاب الجمعة"
"5556","(۵۵۵۶) حَدَّثَنَا أبو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ ضَمْرَۃَ ، عَنْ کَعْبٍ ، قَالَ : الصَّدَقَۃُ تُضَاعَفُ یَوْمَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5556","","","كتاب الجمعة"
"5557","(۵۵۵۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ کَعْبٍ ؛ أَنَّ یَوْمَ الْجُمُعَۃِ لَیَفْزَعُ لَہُ الْخَلاَئِقُ وَالْجِنُّ وَالإِنْسُ ، وَإِنَّہُ لَتُضَاعَفُ فِیہِ الْحَسَنَۃُ وَالسَّیِّئَۃُ ، وَإِنَّہُ لَیَوْمُ الْقِیَامَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5557","","","كتاب الجمعة"
"5558","(۵۵۵۸) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا کَثِیرُ بْنُ عَبْدِ اللہِ الْمُزَنِیُّ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، یَقُولُ : فِی الْجُمُعَۃِ سَاعَۃٌ مِنَ النَّہَارِ ، لاَ یَسْأَلُ فِیہَا الْعَبْدُ شَیْئًا إِلاَّ أُعْطِیَ سُؤْلَہُ ، قِیلَ : أَیُّ سَاعَۃٍ ہِیَ ؟ قَالَ : حَیْثُ تُقَامُ الصَّلاَۃُ إِلَی الانْصِرَافِ مِنْہَا۔ (ترمذی ۴۹۰۔ ابن ماجہ ۱۱۳۸)","Da'if","Musannaf Ibn Abi Shaybah 5558","","","كتاب الجمعة"
"5559","(۵۵۵۹) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ : حدَّثَنَا زُہَیْرُ بْنُ مُحَمَّدٍ ، عَنْ عَبْدِ الل??ِ بْنِ مُحَمَّدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ أَبِی لُبَابَۃَ بْنِ عَبْدِ الْمُنْذِرِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ یَوْمَ الْجُمُعَۃِ سَیِّدُ الأَیَّامِ ، وَأَعْظَمُہَا عِنْدَ اللہِ ، وَأَعْظَمُ عِنْدَ اللہِ مِنْ یَوْمِ الأَضْحَی وَیَوْمِ الْفِطْرِ ، فِیہِ خَمْسُ خِلاَلٍ : خَلَقَ اللَّہُ فِیہِ آدَمَ ، وَأَہْبَطَ اللَّہُ فِیہِ آدَمَ ، وَفِیہِ تَوَفَّی اللَّہُ آدَمَ ، وَفِیہِ سَاعَۃٌ لاَ یَسْأَلُ اللَّہَ الْعَبْدُ فِیہَا شَیْئًا إِلاَّ أَعْطَاہُ إِیَّاہُ، مَا لَمْ یَسْأَلْ حَرَامًا ، وَفِیہِ تَقُومُ السَّاعَۃُ ، مَا مِنْ مَلَکٍ مُقَرَّبٍ ، وَلاَ أَرْضٍ ، وَلاَ سَمَائٍ ، وَلاَ رِیَاحٍ ، وَلاَ جِبَالٍ ، وَلاَ بَحْرٍ إِلاَّ ہُنَّ یُشْفِقْنَ مِنْ یَوْمِ الْجُمُعَۃِ۔ (ابن ماجہ ۱۰۸۴۔ احمد ۳/۴۳۰)","Da'if","Musannaf Ibn Abi Shaybah 5559","","","كتاب الجمعة"
"5560","(۵۵۶۰) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَنْ لَیْثٍ ، عَنْ عُثْمَانَ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَتَانِی جِبْرِیلُ ، وَفِی یَدِہِ کَالْمِرْآۃِ الْبَیْضَائِ ، فِیہَا کَالنُّکْتَۃِ السَّوْدَائِ ، فَقُلْتُ : یَا جِبْرِِیلُ! مَا ہَذِہِ ؟ قَالَ : ہَذِہِ الْجُمُعَۃ ۔n قَالَ : قُلْتُ : وَمَا الْجُمُعَۃُ ؟ قَالَ : لَکُمْ فِیہَا خَیْرٌ ۔ قَالَ : قُلْتُ : وَمَا لَنَا فِیہَا ؟ قَالَ : تَکُونُ عِیدًا لَکَ وَلِقَوْمِکَ مِنْ بَعْدِکَ ، وَیَکُونُ الْیَہُودُ وَالنَّصَارَی تَبَعًا لَکَ ۔ قَالَ : قُلْتُ : وَمَا لَنَا فِیہَا ؟ قَالَ : لَکُمْ فِیہَا سَاعَۃٌ ، لاَ یُوَافِقُہَا عَبْدٌ مُسْلِمٌ یَسْأَلُ اللَّہَ فِیہَا شَیْئًا مِنَ الدُّنْیَا وَالأَخِرَۃِ ، ہُوَ لَہُ قَسَمٌ إِلاَّ أَعْطَاہُ إِیَّاہُ ، أَوْ لَیْسَ لَہُ بِقَسَمٍ إِلاَّ ذُخِرَ لَہُ عِنْدَہُ مَا ہُوَ أَفْضَلُ مِنْہُ ، أَوْ یَتَعَوَّذُ بِہِ مِنْ شَرٍّ ، ہُوَ عَلَیْہِ مَکْتُوبٌ إِلاَّ صَرَفَ عَنْہُ مِنَ الْبَلاَئِ مَا ہُوَ أَعْظَمُ مِنْہُ ۔n قَالَ : قُلْتُ لَہُ : وَمَا ہَذِہِ النُّکْتَۃُ فِیہَا ؟ قَالَ : ہِیَ السَّاعَۃُ ، وَہِیَ تَقُومُ یَوْمَ الْجُمُعَۃِ ، وَہُوَ عِنْدَنَا سَیِّدُ الأَیَّامِ ، وَنَحْنُ نَدْعُوہُ یَوْمَ الْقِیَامَۃِ ، یَوْمَ الْمَزِیدِ ۔n قَالَ : قُلْتُ : مِمَّ ذَاکَ ؟ قَالَ : لأَنَّ رَبَّک ، تَبَارَکَ وَتَعَالَی اتَّخَذَ فِی الْجَنَّۃِ وَادِیًا مِنْ مِسْکٍ أبْیَضَ ، فَإِذَا کَانَ یَوْمُ الْجُمُعَۃِ ہَبَطَ مِنْ عِلِّیِّینَ عَلَی کُرْسِیِّہِ ، تَبَارَکَ وَتَعَالَی ، ثُمَّ حَفَّ الْکُرْسِیَّ بِمَنَابِرَ مِنْ ذَہَبٍ مُکَلَّلَۃٍ بِالْجَوَاہِرِ ، ثُمَّ یَجِیئُ النَّبِیُّونَ حَتَّی یَجْلِسُوا عَلَیْہَا ، وَیَنْزِلُ أَہْلُ الْغُرَفِ حَتَّی یَجْلِسُوا عَلَی ذَلِکَ الْکَثِیبِ ، ثُمَّ یَتَجَلَّی لَہُمْ رَبُّہُم ، تَبَارَکَ وَتَعَالَی ، ثُمَّ یَقُولُ : سَلُونِی أُعْطِکُمْ ، قَالَ : فَیَسْأَلُونَہُ الرِّضَی ، فَیَقُولُ : رِضَائِی أَحَلَّکُمْ دَارِی ، وَأَنَالَکُمْ کَرَامَتِی ، فَسَلُونِی أُعْطِکُمْ ، قَالَ : فَیَسْأَلُونَہُ الرَّضَی ، قَالَ : فَیُشْہِدُہُمْ أَنَّہُ قَدْ رَضِیَ عَنْہُمْ ، قَالَ : فَیُفْتَحُ لَہُمْ مَا لَمْ تَرَ عَیْنٌ ، وَلَمْ تَسْمَعْ أُذُنٌ ، وَلَمْ یَخْطِرْ عَلَی قَلْبِ بَشَرٍ ، قَالَ : وَذَلِکُمْ مِقْدَارُ انْصِرَافِکُمْ مِنْ یَوْمِ الْجُمُعَۃِ ۔n قال ثُمَّ یَرْتَفِعُ ، وَیَرْتَفِعُ مَعَہُ النَّبِیُّونَ ، وَالصِّدِّیقُونَ ، وَالشُّہَدَائُ ، وَیَرْجِعُ أَہْلُ الْغُرَفِ إِلَی غُرَفِہِمْ ، وَہِیَ دُرَّۃٌ بَیْضَائُ ، لَیْسَ فِیہَا قَصْمٌ ، وَلاَ فَصْمٌ ، أَوْ دُرَّۃٌ حَمْرَائُ ، أَوْ زَبَرْجَدَۃٌ خَضْرَائُ فِیہَا غُرَفُہَا وَأَبْوَابُہَا مَطْرُورَۃٌ ، وَفِیہَا أَنْہَارُہَا وَثِمَارُہَا مُتَدَلِّیَۃٌ ، قَالَ : فَلَیْسُوا إِلَی شَیْئٍ أَحْوَجَ مِنْہُمْ إِلَی یَوْمِ الْجُمُعَۃِ لِیَزْدَادُوا إِلَی رَبِّہِمْ نَظَرًا ، وَلِیَزْدَادُوا مِنْہُ کَرَامَۃً۔ (طبرانی ۶۷۱۳۔ بزار ۳۵۱۹)","Da'if","Musannaf Ibn Abi Shaybah 5560","","","كتاب الجمعة"
"5561","(۵۵۶۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ یَزِیدَ الرَّقَاشِیِّ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : جَائَنِی جِبْرِیلُ بِمِرْآۃٍ بَیْضَائَ فِیہَا نُکْتَۃٌ سَوْدَائُ ، قَالَ : فَقُلْتُ : مَا ہَذِہِ ؟ قَالَ : ہَذِہِ الْجُمُعَۃُ وَفِیہَا السَّاعَۃٌ۔ (ابو یعلی ۴۰۸۹)","Da'if","Musannaf Ibn Abi Shaybah 5561","","","كتاب الجمعة"
"5562","(۵۵۶۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنِ الأَغَرِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْمُتَعَجِّلُ إِلَی الْجُمُعَۃِ کَالَّذِی یُہْدِی بَدَنَۃً ، ثُمَّ کَالْمُہْدِی بَقَرَۃً ، ثُمَّ کَالْمُہْدِی شَاۃً، ثُمَّ کَالْمُہْدِی طَائِرًا۔ (بخاری ۹۲۹۔ مسلم ۲۴)","Sahih","Musannaf Ibn Abi Shaybah 5562","","","كتاب الجمعة"
"5563","(۵۵۶۳) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنِ الْمَقْبُرِیِّ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ وَدِیعَۃَ ، عَنْ سَلْمَانَ الْخَیْرِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ یَغْتَسِلُ الرَّجُلُ یَوْمَ الْجُمُعَۃِ وَیَتَطَہَّرُ بِمَا اسْتَطَاعَ مِنْ طَہُورِہِ ، وَیَدَّہِنُ مِنْ دُہْنِہِ ، أَوْ یَمَسُّ طِیبًا مِنْ بَیْتِہِ ، ثُمَّ رَاحَ ، فَلَمْ یُفَرِّقْ بَیْنَ اثْنَیْنِ ، ثُمَّ صَلَّی مَا کَتَبَ اللَّہُ لَہُ ، ثُمَّ أَنْصَتَ إِذَا تَکَلَّمَ الإِمَامُ ، إِلاَّ غُفِرَ لَہُ مَا بَیْنَہُ وَبَیْنَ الْجُمُعَۃِ الأُخْرَی۔ (بخاری ۸۸۳۔ احمد ۵/۴۴۰)","Sahih","Musannaf Ibn Abi Shaybah 5563","","","كتاب الجمعة"
"5564","(۵۵۶۴) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا عَلِیُّ بْنُ زَیْدٍ ، عَنْ أَوْسِ بْنِ خَالِدٍ ، عَنْ أَبِی ہُرَیْرَۃَ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إِنَّ الْمَلاَئِکَۃَ عَلَی أَبْوَابِ الْمَسْجِدِ یَکْتُبُونَ النَّاسَ عَلَی مَنَازِلِہِمْ : جَائَ فُلاَنٌ مِنْ سَاعَۃِ کَذَا وَکَذَا ، جَائَ فُلاَنٌ مِنْ سَاعَۃِ کَذَا ، جَائَ فُلاَنٌ وَالإِمَامُ یَخْطُبُ ، جَائَ فُلاَنٌ فَأَدْرَکَ الصَّلاَۃَ وَلَمْ یُدْرِکِ الْخُطْبَۃَ۔ (احمد ۲/۳۴۳۔ طیالسی ۲۵۶۵)","Da'if","Musannaf Ibn Abi Shaybah 5564","","","كتاب الجمعة"
"5565","(۵۵۶۵) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : نُبِّئْت أَنَّ مُحَمَّدًا اشْتَدَّ الْمَطَرُ یَوْمَ جُمُعَۃٍ فَلَمْ یُجَمِّعْ۔","No Data Available","Musannaf Ibn Abi Shaybah 5565","","","كتاب الجمعة"
"5566","(۵۵۶۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ کَثِیرٍ مَوْلَی ابْنِ سَمُرَۃَ ، قَالَ : مَرَرْتُ بِعَبْدِ الرَّحْمَنِ بْنِ سَمُرَۃَ وَہُوَ عَلَی بَابِہِ جَالِسٌ ، فَقَالَ : مَا خَطْبُ أَمِیرِکُمْ ؟ قُلْتُ : أَمَا جَمَّعْتَ ؟ قَالَ : مَنَعَنَا مِنْہَا ہَذَا الرَّدْغُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5566","","","كتاب الجمعة"
"5567","(۵۵۶۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ؛ أَنَّ ابْنَ عَبَّاسٍ أَمَرَ مُنَادِیَہُ فَنَادَی فِی یَوْمٍ مَطِیرٍ یَوْمَ جُمُعَۃٍ : الصَّلاَۃُ فِی الرِّحَالِ ، الصَّلاَۃُ فِی الرِّحَالِ۔","Sahih","Musannaf Ibn Abi Shaybah 5567","","","كتاب الجمعة"
"5568","(۵۵۶۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ نَافِعٍ ؛ أَنَّ ابْنًا لِسَعِیدِ بْنِ زَیْدِ بْنِ نُفَیْلٍ کَانَ بِأَرْضٍ لَہُ بِالْعَقِیقِ ، عَلَی رَأْسِ أَمْیَالٍ مِنَ الْمَدِینَۃِ ، فَأَتَی ابْنَ عُمَرَ غَدَاۃَ یَوْمِ الْجُمُعَۃِ ، فَذَکَرَ لَہُ شَکَوَاہُ ، فَانْطَلَقَ إِلَیْہِ وَتَرَکَ الْجُمُعَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 5568","","","كتاب الجمعة"
"5569","(۵۵۶۹) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، قَالَ : سَأَلْتُ یُونُسَ عَنِ الرَّجُلِ تُحْتَضَرُ وَالِدَتُہُ ، أَوْ وَالِدُہُ ، أَوْ نَسِیبُہُ ، أَلَہُ عُذْرٌ فِی تَرْکِ الْجُمُعَۃِ ؟ فَقَالَ : کَانَ الْحَسَنُ یُرَخِّصُ فِیہَا لِصَاحِبِ الْجِنَازَۃِ ، یَخَافُ عَلَیْہَا ، أَوِ الرَّجُلُ یَکُونُ خَائِفًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5569","","","كتاب الجمعة"
"5570","(۵۵۷۰) حَدَّثَنَا عُمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إِذَا اسْتُصْرِخَ عَلَی ابْنِکَ یَوْمَ الْجُمُعَۃِ وَالإِمَامُ یَخْطُبُ، فَقُمْ إِلَیْہِ ، وَاتْرُکق الْجُمُعَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5570","","","كتاب الجمعة"
"5571","(۵۵۷۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، قَالَ : قَالَ رَجُلٌ لأَبِی مِجْلَزٍ : أَوْ قُلْتُ لَہُ : آتِی الْجُمُعَۃَ وَأَنَا أَشْتَکِی بَطْنِی ؟ قَالَ : عَجْزٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5571","","","كتاب الجمعة"
"5572","(۵۵۷۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ ، عَنْ أَبِی مِجْلَزٍ ، نَحْوَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5572","","","كتاب الجمعة"
"5573","(۵۵۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الْفَضْلِ ، عَنِ الْحَسَنِ ، قَالَ : لَیْسَ عَلَی الْخَائِفِ ، وَلاَ عَلَی الْعَبْدِ الَّذِی یَخْدِمُ أَہْلَہُ ، وَلاَ عَلَی وَلِیِّ الْجِنَازَۃِ ، وَلاَ عَلَی الأَعْمَی إِذَا لَمْ یَجِدْ قَائِدًا جُمُعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5573","","","كتاب الجمعة"
"5574","(۵۵۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَمَّامٍ ، قَالَ : سَمِعْتُ الْحَسَنَ وَسُئِلَ عَنِ الْخَائِفِ ، عَلَیْہِ جُمُعَۃٌ ؟ فَقَالَ : وَمَا خَوْفُہُ؟ قَالَ : مِنَ السُّلْطَانِ ، قَالَ : إِنَّ لَہُ عُذْرًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5574","","","كتاب الجمعة"
"5575","(۵۵۷۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : تَجِبُ الْجُمُعَۃُ عَلَی الأَعْمَی إِذَا وَجَدَ قَائِدًا ، وَعَلَی الْعَبْدِ إِذَا کَانَ یُؤَدِّی الضَّرِیبَۃَ ۔ قَالَ : وَکَانَ یُرَخِّصُ لِلْخَائِفِ فِی الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5575","","","كتاب الجمعة"
"5576","(۵۵۷۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، وَمُحَمَّدُ بْنُ بِشْرٍ ، وَابْنُ إِدْرِیسَ ، قَالُوا : أَخْبَرَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ عَبِیْدَۃَ بْنِ سُفْیَانَ الْحَضْرَمِیِّ ، قَالَ : سَمِعْتُ أَبَا الْجَعْدِ الضَّمْرِیَّ ، وَکَانَتْ لَہُ صُحْبَۃٌ ، یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ تَرَکَ الْجُمُعَۃَ ثَلاَثَ مَرَّاتٍ تَہَاوُنًا ، طُبِعَ عَلَی قَلْبِہِ۔ (ترمذی ۵۰۰۔ ابوداؤد ۱۰۴۵)","Hasan","Musannaf Ibn Abi Shaybah 5576","","","كتاب الجمعة"
"5577","(۵۵۷۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامُ الدَّسْتَوَائِیُّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلاَّمٍ ، عَنِ الْحَکَمِ بْنِ مِینَائَ ، عَنِ ابْنِ عُمَرَ ، وَابْنِ عَبَّاسٍ ؛ أَنَّہُمَا شَہِدَا عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُ قَالَ، وَہُوَ عَلَی أَعْوَادِ الْمِنْبَرِ : لَیَنْتَہِیَنَّ أَقْوَامٌ عَنْ وَدَعِہِمُ الْجُمُعَاتِ ، أَوْ لَیَطْبَعَنَّ اللَّہُ عَلَی قُلُوبِہِمْ ، وَلَیُکْتَبُنَّ مِنَ الْغَافِلِینَ۔ (مسلم ۴۰۔ نسائی ۱۶۵۸)","Sahih","Musannaf Ibn Abi Shaybah 5577","","","كتاب الجمعة"
"5578","(۵۵۷۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہَمَّامُ بْنُ یَحْیَی ، عَنْ قَتَادَۃَ ، عَنْ قُدَامَۃَ بْنِ وَبَرَۃَ الْعُجَیْفِیِّ ، عَنْ سَمُرَۃََ بْنِ جُنْدُبٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ تَرَکَ الْجُمُعَۃَ مِنْ غَیْرِ عُذْرٍ فَلْیَتَصَدَّقْ بِدِینَارٍ، فَإِنْ لَمْ یَجِدْ فَبِنِصْفِ دِینَارٍ۔ (ابوداؤد ۱۰۴۶۔ ابن حبان ۲۷۸۸)","No Data Available","Musannaf Ibn Abi Shaybah 5578","","","كتاب الجمعة"
"5579","(۵۵۷۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَوْفٍ ، عَنْ سَعِیدِ بْنِ أَبِی الْحَسَنِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ تَرَکَ الْجُمُعَۃَ ثَلاَثًا مُتَوَالِیَاتٍ ، طَبَعَ اللَّہُ عَلَی قَلْبِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5579","","","كتاب الجمعة"
"5580","(۵۵۸۰) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنِ الْعَبَّاسِ بْنِ عَبْدِ اللہِ بْنِ مَعْبَدٍ ، قَالَ : قَالَ : أَبُو ہُرَیْرَۃَ : مَا أُحِبُّ أَنَّ لِی حُمْرَ النِّعَمِ ، وَلاَ أَنَّ الْجُمُعَۃَ تَفُوتُنِی إِلاَّ مِنْ عُذْرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 5580","","","كتاب الجمعة"
"5581","(۵۵۸۱) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ مُحَمَّدِ بْنِ عَبَّادِ بْنِ جَعْفَرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عَسَی أَحَدُکُمْ أَنْ یَتَّخِذَ الصَّبَّۃَ مِنَ الْغَنَمِ عَلَی رَأْسِ الْمِیلَیْنِ ، أَوِ الثَّلاَثَۃِ ، فَتَکُونُ الْجُمُعَۃُ فَلاَ یَشْہَدُہَا ، ثُمَّ تَکُونُ فَلاَ یَشْہَدُہَا ، ثُمَّ تَکُونُ فَلاَ یَشْہَدُہَا ، فَیَطْبَعُ اللَّہُ عَلَی قَلْبِہِ۔ (احمد ۳/۳۳۲۔ ابو یعلی ۲۱۹۸)","","Musannaf Ibn Abi Shaybah 5581","","","كتاب الجمعة"
"5582","(۵۵۸۲) حَدَّثَنَا الْفُضَیْلُ بْنُ دُکَیْنٍ ، عَنْ زُہَیْرٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَص ، سَمِعَہُ مِنْہُ ، عَنْ عَبْدِ اللہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لِقَوْمٍ یَتَخَلَّفُونَ عَنِ الْجُمُعَۃِ : لَقَدْ ہَمَمْتُ أَنْ آمُرَ رَجُلاً یُصَلِّی بِالنَّاسِ، ثُمَّ أُحَرِّقَ عَلَی رِجَالٍ یَتَخَلَّفُونَ عَنِ الْجُمُعَۃِ بُیُوتَہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 5582","","","كتاب الجمعة"
"5583","(۵۵۸۳) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : اخْتَلَفَ رَجُلٌ إِلَی ابْنِ عَبَّاسٍ شَہْرًا ، یَسْأَلُہُ عَنْ رَجُلٍ یَقُومُ اللَّیْلَ وَیَصُومُ النَّہَارَ ، وَلاَ یَشْہَدُ جَمَاعَۃً ، وَلاَ جُمُعَۃً ، قَالَ : فِی النَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 5583","","","كتاب الجمعة"
"5584","(۵۵۸۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یَزِیدُ بْنُ أبی زِیَادٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ مِنَ الْحَقِّ عَلَی الْمُسْلِمِینَ أَنْ یَغْتَسِلَ أَحَدُہُمْ یَوْمَ الْجُمُعَۃِ ، وَأَنْ یَمَسَّ مِنْ طِیبٍ إِنْ کَانَ عِنْدَہُ ، فَإِنْ لَمْ یَکُنْ عِنْدَہُ طِیبٌ فَإِنَّ الْمَائَ لَہُ طِیبٌ۔","Da'if","Musannaf Ibn Abi Shaybah 5584","","","كتاب الجمعة"
"5585","(۵۵۸۵) حَدَّثَنَا عَبْدَۃُ، عَنْ عُثْمَانَ بْنِ حَکِیمٍ، عَنْ عُثْمَانَ بْنِ أَبِی سُلَیْمَانَ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ، قَالَ: إِنَّ مِنَ الْحَقِّ عَلَی الْمُسْلِمِ إِذَا کَانَ یَوْمُ الْجُمُعَۃِ، السِّوَاکَ، وَأَنْ یَلْبَسَ مِنْ صَالِحِ ثِیَابِہِ، وَأَنْ یَتَطَیَّبَ بِطِیبٍ إِنْ کَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 5585","","","كتاب الجمعة"
"5586","(۵۵۸۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ إِذَا رَاحَ إِلَی الْجُمُعَۃِ اغْتَسَلَ، وَتَطَیَّبَ بِأَطْیَبِ طِیبٍ عِنْدَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 5586","","","كتاب الجمعة"
"5587","(۵۵۸۷) حَدَّثَنَا ہُشَیْمٌ، عَنْ أَبِی بِشْرٍ، عَنْ مُجَاہِدٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: أَقُولُ بِرَأْیِی، وَیَمَسُّ طِیبًا إِنْ کَانَ عِنْدَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5587","","","كتاب الجمعة"
"5588","(۵۵۸۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، وَالْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی بَکْرِ بْنِ عَمْرِو بْنِ عُتْبَۃَ ، عَنِ ابْنِ مُغَفَّلٍ ، قَالَ : لَہَا غُسْلٌ وَطِیبٌ إِنْ کَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 5588","","","كتاب الجمعة"
"5589","(۵۵۸۹) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ عُثْمَانَ ، عَنْ مُجَاہِدٍ ، قَالَ : اِلْبَسْ أَفْضَلَ ثِیَابِکَ یَوْمَ الْجُمُعَۃِ ، وَتَطَیَّبْ بِأَطْیَبِ مَا تَجِدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5589","","","كتاب الجمعة"
"5590","(۵۵۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شَدَّادٍ أَبِی طَلْحَۃَ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃٍ ، قَالَ : أَدْرَکْتُ ثَلاَثِینَ مِنْ مُزَیْنَۃَ کُلُّہُمْ قَدْ طَعَنَ ، أَوْ طُعِنَ ، أَوْ ضَرَبَ ، أَوْ ضُرِبَ ، إِذَا کَانَ یَوْمَ الْجُمُعَۃِ اغْتَسَلُوا ، وَلَبِسُوا مِنْ أَحْسَنِ ثِیَابِہِمْ ، وَتَطَیَّبُوا ، ثُمَّ رَاحُوا وَصَلَّوْا رَکْعَتَیْنِ ، ثُمَّ جَلَسُوا ، فَبَثَّوا عِلْمًا۔","No Data Available","Musannaf Ibn Abi Shaybah 5590","","","كتاب الجمعة"
"5591","(۵۵۹۱) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مُوسَی بْنِ عُقْبَۃَ، عَنْ نَافِعٍ؛ أَنَّ ابْنَ عُمَرَ کَانَ یُجَمِّرُ ثِیَابَہُ فِی کُلِّ جُمُعَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 5591","","","كتاب الجمعة"
"5592","(۵۵۹۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الْحَجَّاجُ ، عَنْ أَبِی جَعْفَرٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَلْبَسُ بُرْدَہُ الأَحْمَر یَوْمَ الْجُمُعَۃِ ، وَیَعْتَمُّ یَوْمَ الْعِیدَیْنِ۔ (ابن سعد ۴۵۱)","","Musannaf Ibn Abi Shaybah 5592","","","كتاب الجمعة"
"5593","(۵۵۹۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ یَغْتَسِلُ لِلْجُمُعَۃِ کَاغْتِسَالِہِ مِنَ الْجَنَابَۃِ ، وَیَلْبَسُ مِنْ أَحْسَنِ ثِیَابِہِ ، ثُمَّ یَخْرُجُ حَتَّی یَأْتِیَ الْمُصَلَّی۔","No Data Available","Musannaf Ibn Abi Shaybah 5593","","","كتاب الجمعة"
"5594","(۵۵۹۴) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا إِسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : أَدْرَکْتُ أَصْحَابَ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، مِنْ أَصْحَابِ بَدْرٍ وَأَصْحَابِ الشَّجَرَۃِ ، إِذَا کَانَ یَوْمَ الْجُمُعَۃِ لَبِسُوا أَحْسَنَ ث??یَابِہِمْ ، وَإِنْ کَانَ عِنْدَہُمْ طِیبٌ مَسُّوا مِنْہُ ، ثُمَّ رَاحُوا إِلَی الْجُمُعَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 5594","","","كتاب الجمعة"
"5595","(۵۵۹۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ: نَظَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلَی النَّاسِ یَوْمَ الْجُمُعَۃِ بَاذَّۃٌ ہَیْئَتُہُمْ ، فَقَالَ : مَا ضَرَّ رَجُلاً لَوِ اتَّخَذَ لِہَذَا الْیَوْمِ ثَوْبَیْنِ؟۔ (ابن ماجہ ۱۰۹۵۔ ابن خزیمۃ ۱۷۶۵)","Da'if","Musannaf Ibn Abi Shaybah 5595","","","كتاب الجمعة"
"5596","(۵۵۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن جَابِرٍ ، عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، مِثْلَہُ ، وَزَادَ فِیہِ : ثَوْبَیْنِ یَرُوحُ فِیہِمَا۔","Da'if","Musannaf Ibn Abi Shaybah 5596","","","كتاب الجمعة"
"5597","(۵۵۹۷) حَدَّثَنَا مَرْحُومُ بْنُ عَبْدِ الْعَزِیزِ ، أَنَّہُ سَمِعَ ثَابِتًا الْبُنَانِیَّ ، یَقُولُ : کُنْت مَعَ أَنَسِ بْنِ مَالِکٍ یَوْمَ جُمُعَۃٍ ، فَلَمَّا أَنْ سَمِعَ النِّدَائَ بِالصَّلاَۃِ ، قَالَ : قُمْ نَسْعَی۔","Sahih","Musannaf Ibn Abi Shaybah 5597","","","كتاب الجمعة"
"5598","(۵۵۹۸) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : {فَاسْعَوْا إِلَی ذِکْرِ اللہِ} قَالَ : بِقَلْبِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5598","","","كتاب الجمعة"
"5599","(۵۵۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَیَّانَ ، عَنْ عِکْرِمَۃَ ، قَالَ : السَّعْیُ الْعَمَلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5599","","","كتاب الجمعة"
"5600","(۵۶۰۰) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مَنْصُورٍ، عَنْ رَجُلٍ، عَنْ مَسْرُوقٍ؛ {فَاسْعَوْا إِلَی ذِکْرِ اللہِ} قَالَ: الْوَقْتُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5600","","","كتاب الجمعة"
"5601","(۵۶۰۱) حَدَّثَنَا وَکِیعٌ، عَنْ مُوسَی بْنِ دِینَارٍ، عَنْ مُوسَی بْنِ أَبِی کَثِیرٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ: مَوْعِظَۃُ الإِمَامِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5601","","","كتاب الجمعة"
"5602","(۵۶۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ ، قَالَ : السَّعْیُ الْعَمَلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5602","","","كتاب الجمعة"
"5603","(۵۶۰۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَبَّادِ بْنِ رَاشِدٍ ، عَنِ الْحَسَنِ ؛ فِی قَوْلِہِ : (فَاسْعَوْا إِلَی ذِکْرِ اللہِ) قَالَ : أَمَا وَاللَّہِ مَا ہُوَ بِالسَّعْیِ عَلَی الأَقْدَامِ ، وَقَدْ نُہُوا أَنْ یَأْتُوا الصَّلاَۃَ إِلاَّ وَعَلَیْہِمُ السَّکِینَۃُ وَالْوَقَارُ ، وَلَکِنْ بِالْقُلُوبِ ، وَالنِّیَاتِ، وَالْخُشُوعِ۔ (بخاری ۶۳۵۔ مسلم ۱۵۵)","No Data Available","Musannaf Ibn Abi Shaybah 5603","","","كتاب الجمعة"
"5604","(۵۶۰۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ یَقْرَؤُہَا : (فَامْضُوا إِلَی ذِکْرِ اللہِ) وَیَقُولُ : لَوْ قَرَأْتُہَا : (فَاسْعَوْا) لَسَعَیْتُ حَتَّی یَسْقُطَ رِدَائِی۔","No Data Available","Musannaf Ibn Abi Shaybah 5604","","","كتاب الجمعة"
"5605","(۵۶۰۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، عَن خَرَشَۃَ ، قَالَ : قرَأَہَا عُمَرُ بْنُ الْخَطَّابِ : {فَامْضُوا إلَی ذِکْرِ اللہِ}۔","No Data Available","Musannaf Ibn Abi Shaybah 5605","","","كتاب الجمعة"
"5606","(۵۶۰۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، فِی قَوْلِہِ : {فَإِذَا قُضِیَتِ الصَّلاَۃُ فَانْتَشِرُوا فِی الأَرْضِ وَابْتَغُوا مِنْ فَضْلِ اللہِ} قَالَ : ہُوَ إِذْنٌ مِنَ اللہِ ، فَإِذَا فَرَغَ فَإِنْ شَائَ خَرَجَ ، وَإِنْ شَائَ قَعَدَ فِی الْمَسْجِدِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5606","","","كتاب الجمعة"
"5607","(۵۶۰۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ (ح) وَعَنِ الْقَاسِمِ ، عَنْ مُجَاہِدٍ ؛ (فَإِذَا قُضِیَتِ الصَّلاَۃُ فَانْتَشِرُوا فِی الأَرْضِ) قَالاَ : إِنْ شَائَ فَعَلَ ، وَإِنْ شَائَ لَمْ یَفْعَلْ۔","No Data Available","Musannaf Ibn Abi Shaybah 5607","","","كتاب الجمعة"
"5608","(۵۶۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی جَنَابٍ ، عَنْ یَزِیدَ بْنِ الْبَرَائِ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَطَبَہُمْ یَوْمَ عِیدٍ ، وَفِی یَدِہِ قَوْسٌ ، أَوْ عَصًا۔ (عبدالرزاق ۵۶۵۸۔ احمد ۲۸۲)","Da'if","Musannaf Ibn Abi Shaybah 5608","","","كتاب الجمعة"
"5609","(۵۶۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ بْنِ یَحْیَی ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَخْطُبُ وَبِیَدِہِ قَضِیبٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 5609","","","كتاب الجمعة"
"5610","(۵۶۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ وَاصِلٍ ، عَنْ أَبِی وَائِلٍ ؛ أَنَّ کَعْبًا رَأَی جَرِیرًا وَفِی یَدِہِ قَضِیبٌ ، فَقَالَ : إِنَّ ہَذَا لاَ یَصْلُحُ إِلاَّ لِرَاعٍ ، أَوْ وَالٍ۔","Sahih","Musannaf Ibn Abi Shaybah 5610","","","كتاب الجمعة"
"5611","(۵۶۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَمَّامٍ ، قَالَ : سَمِعْتُ قَتَادَۃَ یَقُولُ فِی رَجُلٍ افْتَتَحَ مَعَ الإِمَامِ یَوْمَ الْجُمُعَۃِ فَلَمْ یَقْدِرْ عَلَی رُکُوعٍ ، وَلاَ سُجُودٍ حَتَّی صَلَّی الإِمَامُ ، قَالَ : کَانَ الْحَسَن وَإِبْرَاہِیمُ یَقُولاَنِ : یُصَلِّی رَکْعَتَیْنِ ۔ یَعْنِی یَوْمَ الْجُمُعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5611","","","كتاب الجمعة"
"5612","(۵۶۱۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، قَالَ : سُئِلَ عَنْ رَجُلٍ رَکَعَ رَکْعَتَیْنِ یَوْمَ الْجُمُعَۃِ ، فَلَمْ یَقْدِرْ عَلَی السُّجُودِ حَتَّی سَلَّمَ الإِمَامُ ؟ فَقَالَ : نُبِّئْتُ عَنِ الْحَسَنِ أَنَّہُ قَالَ : یَسْجُدُ سَجْدَتَیْنِ ، ثُمَّ یَقُومُ فَیَقْضِی الرَّکْعَۃَ الأُولَی۔","No Data Available","Musannaf Ibn Abi Shaybah 5612","","","كتاب الجمعة"
"5613","(۵۶۱۳) حَدَّثَنَا أَزْہَرُ السَّمَّانُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قَالَ رَجُلٌ لِنَافِعٍ : زُحِمْتُ یَوْمَ الْجُمُعَۃِ ، فَلَمْ أَقْدِرْ عَلَی الرُّکُوعِ وَالسُّجُودِ ، فَقَالَ : أَمَّا أَنَا فَلَوْ کُنْتُ لأَوْمَأْتُ۔","No Data Available","Musannaf Ibn Abi Shaybah 5613","","","كتاب الجمعة"
"5614","(۵۶۱۴) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ ، عَنْ مِعْقَلٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إِذَا ازْدَحَمَ النَّاسُ فِی الْجُمُعَۃِ فَلَمْ تَسْتَطِعْ أَنْ تَسْجُدَ ، فَانْتَظِرْ حَتَّی إِذَا قَامُوا فَاسْجُدْ۔","No Data Available","Musannaf Ibn Abi Shaybah 5614","","","كتاب الجمعة"
"5615","(۵۶۱۵) حَدَّثَنَا حَفْصٌ، عَنْ أَشْعَثَ، عَنِ الْحَکَمِ، وَحَمَّادٍ، عَنْ إِبْرَاہِیمَ، قَالَ: یُنَقِّی الرَّجُلُ أَظْفَارَہُ فِی کُلِّ جُمُعَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5615","","","كتاب الجمعة"
"5616","(۵۶۱۶) حَدَّثَنَا مُعَاذٌ ، عَنِ الْمَسْعُودِیِّ ، عَنِ ابْنِ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ؛ أَنَّہُ قَالَ فِیمَنْ قَلَّمَ أَظْفَارَہُ یَوْمَ الْجُمُعَۃِ : أَخْرَجَ اللَّہُ مِنْہَا الدَّائَ ، وَأَدْخَلَ فِیہَا الشِّفَائَ۔","No Data Available","Musannaf Ibn Abi Shaybah 5616","","","كتاب الجمعة"
"5617","(۵۶۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مُبَارَکٍ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمِ بْنِ یَسَارٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَدْعُو بِالْقَلَمَیْنِ یَوْمَ الْجُمُعَۃِ ، یَعْنِی الْمِقَصَّیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5617","","","كتاب الجمعة"
"5618","(۵۶۱۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا مِنْدَلٌ ، عَنْ عِمْرَانَ بْنِ أَبِی عَطَائٍ ، قَالَ : رَأَیْتُ ابْنَ الْحَنَفِیَّۃِ یُنَقِّی أَظْفَارَہُ فِی یَوْمِ جُمُعَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 5618","","","كتاب الجمعة"
