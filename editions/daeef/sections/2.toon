hadiths[199]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"109","كنت كنزا مخفيا فأحببت ان اعرف فخلقت خلقا","","Majmu'a Da'eef Ahadith 109","","","I was a hidden treasure"
"110","ما وسعني ارضي ولا سمائى و وسعنى قلب عبدي المومن","","Majmu'a Da'eef Ahadith 110","","","I dwell in the heart of the believer"
"111","ان بين يدي الرحمٰن للوحا فيه ثلاث مائة و خمس عشر شريعة ، يقول الرحمن : و عزتي و جلالي لا ياتيني عبد من عبادي لا يشرك بي شيئا فيه واحدة منها الا دخل الجنة","","Majmu'a Da'eef Ahadith 111","","","Three hundred and fifteen (315) laws"
"112","انا خلقت الخير و الشر فطوبي لمن قدرت على يده الخير و ويل لمن قدرت على يده الشر","","Majmu'a Da'eef Ahadith 112","","","Creation of good and evil and destiny"
"113","من اقر لي بالتوحيد دخل حصني ومن دخل حصني امن من عذابي","","Majmu'a Da'eef Ahadith 113","","","Testifying to tawheed saves from punishment"
"114","انا الله خلقت العباد بعلمي ، فمن اردت به خيرا منحته خلقا حسنا ومن اردت به سوء منحته خلقا سيئا","","Majmu'a Da'eef Ahadith 114","","","Cause of beauty and ugliness"
"115","ان من عبادي من لا يصلح ايمانه الا بالغني ولو افقرته لكفر وان من عبادي من لا يصلح ايمانه الا بالفقر ولو اغنيه لكفر","","Majmu'a Da'eef Ahadith 115","","","Wisdom behind wealth and poverty"
"116","ابن آدم ! صل لي ركعتين اول النهار اضمن لك آخره","","Majmu'a Da'eef Ahadith 116","","","Great benefit of two nafl at dawn"
"117","ان العبد اذا صلى فى العلانية فاحسن و صلى فى السر فاحسن، قال الله تعالىٰ : هذا عبدي حقا","","Majmu'a Da'eef Ahadith 117","","","Allah’s true servant"
"118","ثلاث من حافظ عليهن فهو ولي حقا ومن ضيعهن فهو عدوي حقا : الصلاة والصوم و غسل الجنابة","","Majmu'a Da'eef Ahadith 118","","","Allah’s true friend"
"119","اني لاهم باهل الارض عذابا فاذا نظرت الي عمار بيوتي المتحاربين فى والي المستغفرين بالاسحار صرفت عنهم","","Majmu'a Da'eef Ahadith 119","","","Reason for no punishment on earth’s people"
"120","لما خلق الله الارض جعلت تميد فخلق الجبال فقال بها عليها فاستقرت فعجبت الملائكته من شدة الجبال فقالو يا رب ! هل من خلقك شئي اشد من الجبال؟ قال : نعم الحديد فقالوا يا رب ! هل من خلقك اشد من الحديد؟ قال : نعم النار فقالو يا رب ! هل من خلقك شيئ اشد من النار؟ قال : نعم الماء فقالوا يا رب ! اهل من خلقك شيئ اشد من الماء؟ قال نعم الريح فقالوا يا رب ! هل من خلقك شيئ اشد من الريح؟ قال نعم ، ابن آدم تصدق صدقة بيمينه يخفيها من شماله","","Majmu'a Da'eef Ahadith 120","","","Son of Adam is stronger than the wind"
"121","اذا نام العبد فى سجوده باهي الله عزوجل به ملائكته ، قال : انظروا الي عبدي ، روحه عندي وجسده فى طاعتي","","Majmu'a Da'eef Ahadith 121","","","One who sleeps in prostration and the Lord"
"122","اني خلقت الف الف امة لا تعلم امة اني خلقت سواها","","Majmu'a Da'eef Ahadith 122","","","One hundred thousand nations"
"123","قرا رسول الله صلى الله عليه وسلم ”هل جزاء الاحسان الا الاحسان“ وقال : هل تدرون ما قال ربكم؟ قالوا : الله و رسوله اعلم ، قال : يقول : هل جزاء من انعمت عليه بالتوحيد الا الجنة","","Majmu'a Da'eef Ahadith 123","","","Reward for tawheed is Paradise"
"124","قربوا اهل لا اله الا الله من ظل عرشي فاني احبهم","","Majmu'a Da'eef Ahadith 124","","","Bring the monotheists near the Throne"
"125","مكتوب على العرش لا اله الا الله محمد رسول الله ، لا اعذب من قالها","","Majmu'a Da'eef Ahadith 125","","","Kalima is inscribed on the Throne"
"126","الاخلاص سر من سري استودعته قلب من احببت من عبادي","","Majmu'a Da'eef Ahadith 126","","","Sincerity is My secret"
"127","اني حلفت لا يقراكن احد من عبادي دبر كل صلاة الا جلعت الجنة مثواه","","Majmu'a Da'eef Ahadith 127","","","Promise of Paradise for three surahs"
"128","انا العزيز من اراد عز الدارين فليطع العزيز","","Majmu'a Da'eef Ahadith 128","","","Honor in this world and Hereafter is in obedience to Allah"
"129","لا تحقروا عبدا آتيته علما فاني لم احقره","","Majmu'a Da'eef Ahadith 129","","","Do not belittle a person of knowledge"
"130","السخي مني وانا منه واني لا رفع عن السخي عذاب القبر","","Majmu'a Da'eef Ahadith 130","","","The generous is safe from grave’s punishment"
"131","يقول الله عزوجل يوم القيامة اين جيراني فتقول الملائكة من هذا الذى ينبغي له ان يجاورك فيقول اين قراء القرآن وعمار المساجد","","Majmu'a Da'eef Ahadith 131","","","Allah’s neighbors"
"132","من شغله قراءة القرآن عن دعائي ومسالتي اعطيته افضل ثواب الشاكرين","","Majmu'a Da'eef Ahadith 132","","","Virtue of being engaged in Quran recitation"
"133","اجتنبو الكبر فان العبد لا يزال يتكبر حتي يقول الله : اكتبوا عبدي هذا من الجبارين","","Majmu'a Da'eef Ahadith 133","","","Beware of arrogance"
"134","اوحي الله الي الدنيا : اخدمي من خدمني واتعبي من خدمك","","Majmu'a Da'eef Ahadith 134","","","Servant of the world is in fatigue"
"135","لولاك ما خلق الله عرشا ولا كرسيا ولا ارضا و سماء ولا شمسا ولا قمرا ولا غير ذالك","","Majmu'a Da'eef Ahadith 135","","","The Throne and everything created for the Prophet ﷺ"
"136","من تكلم عند الاذان خيف عليه زوال الايمان","","Majmu'a Da'eef Ahadith 136","","","Talking during adhan risks loss of faith"
"137","ثلاث من اصل الايمان الكف عمن قال لا اله الا الله ولا نكفره بذنب ولا نخرجه من الاسلام بعمل والجهاد ماض منذ بعثني الله الي ان يقاتل آخر امتي الدجال لا يبطله جور جائر ولا عدل عادل و الايمان بالاقدار","","Majmu'a Da'eef Ahadith 137","","","Three things are the essence of faith"
"138","اذا مدح المومن فى وجهه ربا الايمان فى قلبه","","Majmu'a Da'eef Ahadith 138","","","Praise on a believer’s face increases his faith"
"139","اشرف الايمان ان يامنك الناس","","Majmu'a Da'eef Ahadith 139","","","Noblest faith"
"140","افضل الايمان ان تعلم ان الله معك حيثما كنت","","Majmu'a Da'eef Ahadith 140","","","Best faith"
"141","ان الايمان سربال يسربله الله من يشاء فاذا زني العبد نزع منه سربال الايمان فان تاب رد عليه","","Majmu'a Da'eef Ahadith 141","","","Faith is a garment"
"142","الايمان عريان و لباسه التقوي و زينته الحياء وثمرته العلم","","Majmu'a Da'eef Ahadith 142","","","The garment of faith is piety"
"143","ان الغيره من الايمان وان البذاء من النفاق","","Majmu'a Da'eef Ahadith 143","","","Honor is from faith"
"144","الالتفاع لبسة الايمان","","Majmu'a Da'eef Ahadith 144","","","Turning white in old age is a garment of faith"
"145","الايمان اربعة وستون بابا","","Majmu'a Da'eef Ahadith 145","","","Doors of faith"
"146","الايمان بالقدر يذهب الهم والحزن","","Majmu'a Da'eef Ahadith 146","","","Benefit of believing in destiny"
"147","الايمان بالنية واللسان و الهجرة بالنفس و المال","","Majmu'a Da'eef Ahadith 147","","","What is faith?"
"148","الايمان عفيف عن المحارم و عفيف عن المطامع","","Majmu'a Da'eef Ahadith 148","","","Faith protects from forbidden and greed"
"149","الايمان نصفان فنصف فى الصبر و نصف فى الشكر","","Majmu'a Da'eef Ahadith 149","","","Faith is two halves"
"150","الايمان والعمل اخوان . . . لا يقبل الله احدهما الا بصاحبه","","Majmu'a Da'eef Ahadith 150","","","Faith and deeds are brothers"
"151","بحسب امري من الايمان ان يقول رضيت بالله ربا و بمحمد رسولا و بالاسلام دينا","","Majmu'a Da'eef Ahadith 151","","","A single statement of faith suffices"
"152","تخللوا فانه نظافة والنظافة تدعو الي الايمان والايمان مع صاحبه فى الجنة","","Majmu'a Da'eef Ahadith 152","","","Cleanliness calls to faith"
"153","ثلاث من كن فيه استوجب الثواب و استكمل الايمان؛ خلق يعيش به فى الناس ، وورع يحجزه عن محارم الله ، و حلم يرده عن جهل الجاهل","","Majmu'a Da'eef Ahadith 153","","","Three things complete faith"
"154","خمس من الايمان من لم يكن فيه شيئ منهن فلا ايمان له؛ التسليم لامر الله والرضا بقضاء الله و التفويض الي الله والتوكل على الله والصبر عند الصدمة الاولي","","Majmu'a Da'eef Ahadith 154","","","Five things are part of faith"
"155","حب ابي بكر و عمر من الايمان و بغضهما كفر ، وحب الانصار من الايمان و بغضهم كفر ، وحب العرب من الايمان و بغضهم كفر","","Majmu'a Da'eef Ahadith 155","","","Love for Abu Bakr and Umar (RA) is part of faith"
"156","الحسد يفسد الايمان كما يفسد الصبر العسل","","Majmu'a Da'eef Ahadith 156","","","Envy corrupts faith"
"157","السواك نصف الايمان والوضوء نصف الايمان","","Majmu'a Da'eef Ahadith 157","","","Miswak is half of faith"
"158","الصبر من الايمان بمنزلة الراس من الجسد","","Majmu'a Da'eef Ahadith 158","","","Patience’s rank in faith"
"159","الصبر نصف الايمان و اليقين الايمان كله","","Majmu'a Da'eef Ahadith 159","","","Certainty is complete faith"
"160","اعف الناس قتلة اهل الايمان","","Majmu'a Da'eef Ahadith 160","","","Believers are the gentlest in killing and slaughter"
"161","الصلاة عماد الايمان والجهاد سنام العمل والزكاة بين ذالك","","Majmu'a Da'eef Ahadith 161","","","Prayer is the pillar of faith"
"162","عليكم بلباس الصوف تجدوا حلاوة الايمان فى قلوبكم","","Majmu'a Da'eef Ahadith 162","","","Wearing woolen clothes brings sweetness of faith"
"163","العلم حياة الاسلام و عماد الايمان","","Majmu'a Da'eef Ahadith 163","","","Knowledge is the pillar of faith"
"164","كما لا ينفع مع الشرك شىء كذالك لا يضر مع الايمان شىء","","Majmu'a Da'eef Ahadith 164","","","Nothing harms with faith"
"165","لكل شىء اس واس الايمان الورع","","Majmu'a Da'eef Ahadith 165","","","Foundation of faith is piety"
"166","لكل شىء صفوة و صفوة الايمان الصلاة و صفوة الصلاة التكبيرة الاولي","","Majmu'a Da'eef Ahadith 166","","","Summary of faith is prayer"
"167","ليس بمومن مستكمل الايمان من لم يعد البلاء نعمة والرخاء مصيبة","","Majmu'a Da'eef Ahadith 167","","","Perfect believer considers trial a blessing"
"168","مثل الايمان مثل القميص تقمصه مرة وتنزعه مرة","","Majmu'a Da'eef Ahadith 168","","","Faith is like a shirt"
"169","من شرب الخمر نزع الله منه الايمان كما يخلع الانسان القميص من راسه","","Majmu'a Da'eef Ahadith 169","","","Faith is removed from the drunkard"
"170","من غدا الي صلاة الصبح غدا براية الايمان ومن غدا الي السوق غدا براية ابليس","","Majmu'a Da'eef Ahadith 170","","","One who goes for Fajr prayer at dawn"
"171","المدينة قبة الاسلام و دار الايمان","","Majmu'a Da'eef Ahadith 171","","","Madinah is the abode of faith"
"172","لا يبلغ العبد حقيقة الايمان حتي يخزن من لسانه","","Majmu'a Da'eef Ahadith 172","","","Access to true faith is not possible without restraining the tongue"
"173","قيل : فاي الايمان افضل؟ قال : الهجرة","","Majmu'a Da'eef Ahadith 173","","","Best faith is migration"
"174","من لم يكثر ذكر الله فقد بريء من الايمان","","Majmu'a Da'eef Ahadith 174","","","Believer is one who remembers Allah abundantly"
"175","لا ايمان لمن لا حياء له","","Majmu'a Da'eef Ahadith 175","","","No faith without modesty"
"176","الغيبة و النميمة تحتان الايمان كما يعضد الراعي الشجر","","Majmu'a Da'eef Ahadith 176","","","Backbiting and slander destroy faith"
"177","حب الوطن من الايمان","","Majmu'a Da'eef Ahadith 177","","","Love for homeland is part of faith"
"178","حب الهرة من الايمان","","Majmu'a Da'eef Ahadith 178","","","Love for cats is part of faith"
"179","الايمان مثبت فى القلب كالجبال الرواسي و زيادته و نقصه كفر","","Majmu'a Da'eef Ahadith 179","","","Increase or decrease in faith is disbelief"
"180","جاء وفد ثقيف الي رسول الله صلى الله عليه وسلم فقالوا يا رسول الله ! الايمان يزيد و ينقص؟ قال : لا ، الايمان مكمل فى القلب زيادته كفر و نقصانه شرك","","Majmu'a Da'eef Ahadith 180","","","Increase in faith is disbelief, decrease is shirk"
"181","الايمان لا يزيد ولا ينقص","","Majmu'a Da'eef Ahadith 181","","","Faith does not increase or decrease"
"182","لا يومن الرجل الايمان كله حتي يدع الكذب فى المزاح و المراء وان كان صادقا","","Majmu'a Da'eef Ahadith 182","","","Perfect believer does not lie even in jest"
"183","من شك فى ايمانه فقد حبط عمله وهو فى الاخرة من الخاسرين","","Majmu'a Da'eef Ahadith 183","","","Doubt in faith destroys deeds"
"184","من اسلم على يديه رجل وجبت له الجنة","","Majmu'a Da'eef Ahadith 184","","","One who makes a man Muslim enters Paradise"
"185","من قال انا مومن ان شاء الله فليس له فى الاسلام نصيب","","Majmu'a Da'eef Ahadith 185","","","Saying inshaAllah is an expression of faith"
"186","ان من تمام ايمان العبد ان يستثني فى كل حديثه","","Majmu'a Da'eef Ahadith 186","","","Sign of a perfect believer"
"187","من لم يكن مومنا حقا فهو كافر حقا","","Majmu'a Da'eef Ahadith 187","","","If not a true believer, then a true disbeliever"
"188","اغبط اوليائى عندي منزلة رجل مومن خفيف الحاذ ذو حظ من صلاة","","Majmu'a Da'eef Ahadith 188","","","Enviable believer is thin and lean"
"189","لو وزن خوف المومن ورجاء ه لا عتدلا","","Majmu'a Da'eef Ahadith 189","","","Weight of believer’s fear and hope"
"190","من انتهر صاحب بدعة ملا الله قلبه امنا و ايمانا","","Majmu'a Da'eef Ahadith 190","","","Rebuking an innovator brings faith"
"191","ان الله خلق خيلا و اجراها فعرقت و خلق نفسه من ذالك العرق","","Majmu'a Da'eef Ahadith 191","","","From what did Allah create His own self?"
"192","بين الله و بين الخلق سبعون الف حجاب","","Majmu'a Da'eef Ahadith 192","","","Seventy thousand veils between creation and Allah"
"193","خلق الله عزوجل الف امة منها ستمائة فى البحر واربعمائة فى البر","","Majmu'a Da'eef Ahadith 193","","","Six hundred nations in the sea"
"194","القلب بيت الرب","","Majmu'a Da'eef Ahadith 194","","","The heart is the house of the Lord"
"195","تفكروا فى كل شىء ولا تفكروا فى ذات الله تعالىٰ","","Majmu'a Da'eef Ahadith 195","","","Do not ponder about the essence of Allah"
"196","الخلق كلهم عيال الله و احبهم اليه انفعهم لعياله","","Majmu'a Da'eef Ahadith 196","","","All creation is Allah’s family"
"197","لو لا النساء لعبد الله حقا","","Majmu'a Da'eef Ahadith 197","","","If there were no women, Allah would be worshipped"
"198","لو لا المراة لدخل الرجل الجنة","","Majmu'a Da'eef Ahadith 198","","","If there were no women, men would enter Paradise"
"199","احياء ابوى النبى صلى الله عليه وسلم حتى آمنا به","","Majmu'a Da'eef Ahadith 199","","","The parents of the Prophet (PBUH) being alive"
"200","اول ما خلق الله القلم ثم خلق النون وهى الدواة و ذالك فى قول الله تعالىٰ ن، والقلم وما يسطرون","","Majmu'a Da'eef Ahadith 200","","","Creation of the inkwell after the pen"
"201","لما اقترف آدم الخطيئة قال يا رب ! اسالك بحق محمد صلى الله عليه وسلم لما غفرت لي فقال الله عزوجل يا آدم و كيف عرفت محمدا صلى الله عليه وسلم ولم اخلقه؟ قال يا رب لما خلقني بيدك ونفخت فى من روحك رفعت راسي فرايت على قوائم العرش مكتوبا : لا اله الا الله محمد رسول الله فعلمت انك لم تضف الي اسمك الا احب الخلق اليك ، فقال الله صدقت يا آدم ! انه لا حب الخلق الي ادعني فقد غفرت لك ولو لا محمد صلى الله عليه وسلم ما خلقتك","","Majmu'a Da'eef Ahadith 201","","","Adam (AS) sought intercession through Muhammad (PBUH)"
"202","قال داود عليه السلام اسئلك بحق آبائي ابراهيم واسحٰق و يعقوب","","Majmu'a Da'eef Ahadith 202","","","David (AS) sought intercession through his ancestors"
"203","اذا سالتم الله فاسئلو بجاهي","","Majmu'a Da'eef Ahadith 203","","","Seek my intercession"
"204","عن جابر بن عبدالله قال قلت يا رسول الله ! بابي انت و امي اخبرني عن اول شيىء خلقه الله قبل الاشياء ، قال : يا جابر ان الله خلق قبل الاشياء نور نبيك من نوره ، فجعل ذالك النور يدور بالقدرة حيث شاء الله ولم يكن فى ذالك الوقت لوح ولا قلم ولا جنة ولا نار ولا ملك ولا سماء ولا ارض ولا شمس ولا قمر ولا جني ولا انسي","","Majmu'a Da'eef Ahadith 204","","","First creation was the Prophet’s (PBUH) light"
"205","انا من نور الله والمومنون مني و الخير فى وفي امتي الي يوم القيامة","","Majmu'a Da'eef Ahadith 205","","","Light from the Light of Allah"
"206","كنت نبيا و آدم بين الماء و الطين","","Majmu'a Da'eef Ahadith 206","","","Adam (AS) between water and clay"
"207","كان صلى الله عليه وسلم يرى فى الظلمة كما يرى فى الضوء","","Majmu'a Da'eef Ahadith 207","","","The Prophet (PBUH) saw in darkness like in light"
"208","آل محمد كل تقي","","Majmu'a Da'eef Ahadith 208","","","All family of Muhammad (PBUH) are pious"
"209","ان رسول الله صلى الله عليه وسلم لم يكن يرٰى له ظل فى شمس ولا قمر","","Majmu'a Da'eef Ahadith 209","","","The Prophet (PBUH) had no shadow"
"210","ان الله اعطاني موسي الكلام و اعطاني الروية و فضلني بالمقام المحمود و الحوض المورود","","Majmu'a Da'eef Ahadith 210","","","Muhammad (PBUH) honored with vision of Allah"
"211","لما اسرى بى الى السماء فرايت ربى بينى وبينه حجاب بارز فرايت كل شىء من حتي رايت تاجا","","Majmu'a Da'eef Ahadith 211","","","Vision of Allah on the night of Mi’raj"
"212","رايت ربى بمنى على جمل عليه جبة","","Majmu'a Da'eef Ahadith 212","","","Vision of Allah at Mina"
"213","من زار قبرى وجبت له شفاعتى","","Majmu'a Da'eef Ahadith 213","","","Visiting the Prophet’s grave is a means of intercession"
"214","اكثروا الصلاة على يوم الجمعة فانه يوم مشهود تشهده الملائكة ، ليس من عبد يصلي على الا بلغنى صوته حيث كان قلنا و بعد و فاتك قال و بعد و فاتي ان الله حرم على الارض ان تاكل اجساد الانبياء","","Majmu'a Da'eef Ahadith 214","","","The Prophet (PBUH) hears the voice of one sending blessings"
"215","انا خاتم النبيين ، لا نبى بعدى ، الا ان يشاء الله","","Majmu'a Da'eef Ahadith 215","","","If Allah wills, a prophet after me"
"216","عن معاذ بن جبل رضى الله عنه ان النبى حين بعثه الى اليمن قال له : كيف تقضي اذا عرض لك قضاء؟ قال : اقضي بما فى كتاب الله قال : فان لم يكن فى كتاب الله؟ قال : بسنة رسول الله ، قال : فان لم يكن فى سنة رسول الله ، قال : اجتهد راي لا الو ، قال : فضرب رسول الله صلى الله عليه وسلم صدره ، قال : الحمد لله الذى وفق رسول الله لما يرضي رسول الله صلى الله عليه وسلم","","Majmu'a Da'eef Ahadith 216","","","Narration of Mu’adh’s (RA) ijtihad"
"217","انا تكون بعدى رواة يروون عنى الحديث فاعرضوا حديثهم على القرآن فما وافق القرآن فخذوا به وما لم يوافق القرآن فلا تاخذوا به","","Majmu'a Da'eef Ahadith 217","","","Judge hadith by the Quran"
"218","اذا كتبتم الحديث فاكتبوه باسناده","","Majmu'a Da'eef Ahadith 218","","","Write hadith with its chain"
"219","ابي الله ان يصح الا كتابه","","Majmu'a Da'eef Ahadith 219","","","Reject authenticity of every book except Quran"
"220","كلامي لا ينسخ كلام الله وكلام الله ينسخ كلامي","","Majmu'a Da'eef Ahadith 220","","","Sunnah does not abrogate Quran"
"221","من حفظ على امتي اربين حديثا فى امر دينها بعثه الله فقيها","","Majmu'a Da'eef Ahadith 221","","","Virtue of memorizing forty hadith"
"222","ما حدثتم عني مما تعرفونه فخذوه وما حدثتم عني مما تنكرونه فلا تاخذوا به","","Majmu'a Da'eef Ahadith 222","","","Accept well-known hadith"
"223","اذا ظهرت البدع ولعن آخر هذه الامة اولها فمن كان عنده علم فلينشره","","Majmu'a Da'eef Ahadith 223","","","Spread knowledge when innovations appear"
"224","من ادي الي امتي حديثا يقيم به سنة او يثلم به بدعة فله الجنة","","Majmu'a Da'eef Ahadith 224","","","Paradise for one who ends innovation"
"225","من مشي الي صاحب بدعة ليوقره فقد اعان على هدم الاسلام","","Majmu'a Da'eef Ahadith 225","","","Warning for going to an innovator"
"226","من اعرض عن صاحب بدعة بوجهه بغضاله فى الله ملا الله قلبه امنا و ايمانا","","Majmu'a Da'eef Ahadith 226","","","Reward for avoiding innovators"
"227","اذا مات صاحب بدعة فتح فى السلام فتح","","Majmu'a Da'eef Ahadith 227","","","Death of an innovator is Islam’s victory"
"228","كل بدعة ضلالة الا بدة فى العبادة","","Majmu'a Da'eef Ahadith 228","","","Innovation in worship is not misguidance"
"229","اهل البدع شر الخلق","","Majmu'a Da'eef Ahadith 229","","","Innovators are the worst creation"
"230","يكون فى امتى رجل يقال له محمد بن ادريس اضر على امتى من ابليس و يكون فى امتى رجل يقال له ابوحنيفة هو سراج امتى","","Majmu'a Da'eef Ahadith 230","","","Imam Shafi’i more harmful than Satan"
"231","اهل بيتى كالنجوم بايهم اقتديتم اهتديتم","","Majmu'a Da'eef Ahadith 231","","","Following Ahl al-Bayt is guidance"
"232","اتبعوا العلماء فانهم سرج الدنيا و مصابيح الآخرة","","Majmu'a Da'eef Ahadith 232","","","Order to follow scholars"
"233","سلمان منا اهل البيت","","Majmu'a Da'eef Ahadith 233","","","Salman is among Ahl al-Bayt"
"234","من قال فى ديننا برايه فاقتلوه","","Majmu'a Da'eef Ahadith 234","","","Punishment for expressing personal opinion in religion"
"235","على خير البشر فمن ابى فقد كفر","","Majmu'a Da'eef Ahadith 235","","","Ali is the best of mankind"
"236","لو يعلم الناس متى سمى على امير المومنين ما انكروا فضله سمى امير المومنين و آدم بين الروح و الجسد","","Majmu'a Da'eef Ahadith 236","","","When was Ali given the title Amir al-Mu’minin?"
"237","يا على ! انت اخى فى الدنيا والآخرة","","Majmu'a Da'eef Ahadith 237","","","Ali is my brother in this world and the Hereafter"
"238","على امام البررة و قاتل الفجرة منصور من نصره مخذول من خذله","","Majmu'a Da'eef Ahadith 238","","","Ali is the leader of the righteous"
"239","انا خاتم النبيين وانت يا على ! خاتم الاولياء","","Majmu'a Da'eef Ahadith 239","","","Ali is the Imam of the saints"
"240","احبو قريشا فانه من احبهم احبه الله عزوجل","","Majmu'a Da'eef Ahadith 240","","","Love the Quraysh"
"241","حب قريش ايمان و بغضهم كفر و حب العرب ايمان و بغضهم كفر","","Majmu'a Da'eef Ahadith 241","","","Love for Quraysh and Arabs is faith"
"242","انما سماها فاطمة لان الله فطمها و محبيها من النار","","Majmu'a Da'eef Ahadith 242","","","Reason for the Prophet’s daughter being named Fatimah"
"243","ان الله غير معذبك ولا ولدك","","Majmu'a Da'eef Ahadith 243","","","Fatimah and her children are safe from punishment"
"244","يبعث الاسلام يوم القيامة على صورة الرجل","","Majmu'a Da'eef Ahadith 244","","","Islam will come in human form"
"245","الدنيا مزرعة الاخرة","","Majmu'a Da'eef Ahadith 245","","","The world is the field of the Hereafter"
"246","القبر روضة من رياض الجنة او حفرة من حفر النار","","Majmu'a Da'eef Ahadith 246","","","The grave is a garden of Paradise or..."
"247","يقول القبر للميت حين يوضع فيه ويحك يا ابن آدم ما غرك بى الم تعلم ابى بيت الظلمة وبيت الفتنة و بيت الوحدة","","Majmu'a Da'eef Ahadith 247","","","The grave calls: I am the house of loneliness"
"248","ان القبر يناديكم كل يوم خمس مرات","","Majmu'a Da'eef Ahadith 248","","","The grave calls five times daily"
"249","ليس على اهل لا اله الا الله وحشة فى قبور هم ولا فى نشوزهم","","Majmu'a Da'eef Ahadith 249","","","No terror in the grave for monotheists"
"250","من زار قبر ابويه او احدهما كل جمعة غفرله","","Majmu'a Da'eef Ahadith 250","","","Virtue of visiting parents’ graves on Friday"
"251","من زار قبر والديه كل جمعة فقرا عندهما يس غفرله بعدد كل آية او حرف","","Majmu'a Da'eef Ahadith 251","","","Visiting parents’ graves and reciting Yasin on Friday"
"252","النظر الي الوجه الحسن يجلو البصر","","Majmu'a Da'eef Ahadith 252","","","Looking at a beautiful face sharpens vision"
"253","النظر الي الوجه الجميل عبادة","","Majmu'a Da'eef Ahadith 253","","","Looking at a beautiful face is worship"
"254","التمسوا الخير عند حسان الوجوده","","Majmu'a Da'eef Ahadith 254","","","Goodness is near beautiful faces"
"255","لا كبيرة مع الاستغفار ولا صغيرة مع الاصرار","","Majmu'a Da'eef Ahadith 255","","","Major sins erased with seeking forgiveness"
"256","اتاني جبريل فقال يا محمد ! ان الله يقرا عليك السلام ويقول و عزتي و جلالي لا اعذب احدا يسمى باسمك يا محمد ! بالنار","","Majmu'a Da'eef Ahadith 256","","","One named Muhammad is safe from Hellfire"
"257","الخلافة بالمدينة والملك بالشام","","Majmu'a Da'eef Ahadith 257","","","Caliphate in Madinah, kingship in Syria"
"258","لا يدخل الجنة ولد زنا","","Majmu'a Da'eef Ahadith 258","","","Illegitimate child forbidden from Paradise"
"259","ان لصاحب القرآن عند كل ختمه دعوة مستجابة","","Majmu'a Da'eef Ahadith 259","","","Acceptance of supplication at Quran completion"
"260","البلاء موكل بالمنطق","","Majmu'a Da'eef Ahadith 260","","","Speaking leads to trial"
"261","خير الامور اوسطها","","Majmu'a Da'eef Ahadith 261","","","Best deed is moderation"
"262","لو احسن احدكم ظنه بحجر لنفعه","","Majmu'a Da'eef Ahadith 262","","","Good opinion always benefits"
"263","نية المؤمن خير من عمله","","Majmu'a Da'eef Ahadith 263","","","Intention is better than action"
"264","من عشق فعف فكتم فمات مات شهيدا","","Majmu'a Da'eef Ahadith 264","","","Hadith of love"
"265","دفن البنات من المكرمات","","Majmu'a Da'eef Ahadith 265","","","Burying daughters is an honorable act"
"266","من مات فقد قامت قيامته","","Majmu'a Da'eef Ahadith 266","","","Death is one’s personal resurrection"
"267","حاسبو انفسكم قبل ان تحاسبوا","","Majmu'a Da'eef Ahadith 267","","","Keep accounting of your souls"
"268","اول من يكسى بعد النبيين والشهداء بلال","","Majmu'a Da'eef Ahadith 268","","","After prophets and martyrs, Bilal will be clothed"
"269","علماء امتى كانبياء بنى اسرائيل","","Majmu'a Da'eef Ahadith 269","","","Scholars are like prophets"
"270","من قلد عالما لقى الله سالما","","Majmu'a Da'eef Ahadith 270","","","Virtue of following a scholar"
"271","آفة العلم النسيان","","Majmu'a Da'eef Ahadith 271","","","Affliction of knowledge"
"272","من خرج فى طلب العلم فهو فى سبيل الله حتى يرجع","","Majmu'a Da'eef Ahadith 272","","","One who seeks knowledge is in Allah’s path"
"273","فقيه واحد اشد على الشيطان من الف عابد","","Majmu'a Da'eef Ahadith 273","","","A jurist is superior to a thousand worshippers"
"274","فضل العالم على العابد كفضلى على امتي","","Majmu'a Da'eef Ahadith 274","","","Scholar’s superiority over worshipper"
"275","من كتب عنى علما او حديثا لم يزل يكتب له الاجر ما بقى ذالك العلم او الحديث","","Majmu'a Da'eef Ahadith 275","","","Reward for writing knowledge"
"276","اجودهم من بعدى رجل علم علما فنشر علمه","","Majmu'a Da'eef Ahadith 276","","","Spreader of knowledge is the most generous"
"277","اذا كان يوم القيامة وضعت منابر من ذهب . . . ينادى منادى الرحمٰن اين من حمل الي امة محمد صلى الله عليه وسلم علما يحمله اليهم يريد به وجه الله اجلسوا عليها ثم ادخلوا الجنة","","Majmu'a Da'eef Ahadith 277","","","Great reward for scholars on Judgment Day"
"278","فان خيانة الرجل فى علمه اشد من خيانته فى ماله","","Majmu'a Da'eef Ahadith 278","","","Betrayal in knowledge is worse than financial betrayal"
"279","لا تطرحو الدرفى افواه الكلاب يعنى العلم","","Majmu'a Da'eef Ahadith 279","","","Do not throw knowledge to dogs"
"280","استودعوا العلم الاحداث","","Majmu'a Da'eef Ahadith 280","","","Transmit knowledge forward"
"281","اذا اتى على يوم لا ازداد فيه علما فلا بورك فى طلوع الشمس فى ذالك اليوم","","Majmu'a Da'eef Ahadith 281","","","If knowledge does not increase, blessing is removed"
"282","اربع لا يشبعن من اربع : عين من نظر وارض من مطر وانثى من ذكر وعالم من علم","","Majmu'a Da'eef Ahadith 282","","","Four things are never satisfied"
"283","ليس من اخلاق المومن الملق الا فى طلب العلم","","Majmu'a Da'eef Ahadith 283","","","Flattery is allowed in seeking knowledge"
"284","فان المعلم اذا قال للصبى بسم الله الرحمٰن الرحيم فقال الصبى بسم الله الرحمٰن الرحيم كتب الله براءة للصبى وبراءة لوالديه وبراءة لمعلمه من النار","","Majmu'a Da'eef Ahadith 284","","","Virtue of teaching and learning"
"285","شراركم معلموكم اقلهم رحمة على اليتيم","","Majmu'a Da'eef Ahadith 285","","","Worst people are teachers"
"286","حضور مجالس العلم خير من حضور الف جنازة","","Majmu'a Da'eef Ahadith 286","","","Attending knowledge gatherings better than a thousand funerals"
"287","اجر المعلمين والموذنين والائمة حرام","","Majmu'a Da'eef Ahadith 287","","","Teacher’s wage is forbidden"
"288","لا تجلسوا مع كل عالم الا عالما يدعوكم من خمس الي خمس : من الشك الى اليقين ومن العداوة الى النصيحة ومن الكبر الى التواضع ومن الرئاء الي الاخلاص ومن الرغبة الى الزهد","","Majmu'a Da'eef Ahadith 288","","","Sit with a scholar who gives five advices"
"289","اذا حدثتم عني بحديث يوافق الحق فخذوا به حدثت اولم احدث","","Majmu'a Da'eef Ahadith 289","","","Accept hadith that matches the truth"
"290","من علم عبدا آية من كتاب الله فهو له عبد","","Majmu'a Da'eef Ahadith 290","","","Teaching one verse earns a slave"
"291","العلم علمان : علم الابدان وعلم الاديان","","Majmu'a Da'eef Ahadith 291","","","Two types of knowledge"
"292","العلم علمان؛ فعلم فى القلب فذاك العلم النافع و علم اللسان فتلك حجة الله على ابن آدم","","Majmu'a Da'eef Ahadith 292","","","Two more types of knowledge"
"293","من تعلم بابا من العلم ليعلمه الناس ابتغاء وجه الله اعطاه الله اجر سبعين نبيا","","Majmu'a Da'eef Ahadith 293","","","Rank of prophets through knowledge"
"294","ان اهل الجنة ليحتاجون الى العلماء فى الجنة","","Majmu'a Da'eef Ahadith 294","","","Even people of Paradise need scholars"
"295","طلب العلم ساعة خير من قيام ليلة و طلب العلم يوما خير من صيام ثلاثة ايام","","Majmu'a Da'eef Ahadith 295","","","Virtue of a moment spent seeking knowledge"
"296","اذا جلس المتعلم بين يدي المعلم فتح الله عليه سبعين بابا من الرحمة","","Majmu'a Da'eef Ahadith 296","","","Doors of mercy open for the student"
"297","من زار العلماء فقد زارني ومن صافح العلماء فقد صافحنى","","Majmu'a Da'eef Ahadith 297","","","Visiting scholars is like visiting me"
"298","من عمل بما علم ورثه الله علم مالم يعلم","","Majmu'a Da'eef Ahadith 298","","","Virtue of knowledge and action"
"299","الشيخ فى قومه كالنبى فى امته","","Majmu'a Da'eef Ahadith 299","","","Sheikh is like a prophet among his people"
"300","الصلاة خلف العالم باربعة الاف و اربعمائة و اربعين صلاة","","Majmu'a Da'eef Ahadith 300","","","Virtue of praying behind a scholar"
"301","مداد العلماء افضل من دم الشهداء","","Majmu'a Da'eef Ahadith 301","","","Ink of scholars is superior to blood of martyrs"
"302","اكثر منافقى هذه الامة قراءها","","Majmu'a Da'eef Ahadith 302","","","Most hypocrites of this ummah are reciters"
"303","شرار العلماء الذين ياتون الامراء و خيار الامراء الذين ياتون العلماء","","Majmu'a Da'eef Ahadith 303","","","Worst scholars and best rulers"
"304","ياتي على امتى زمان يحسد الفقهاء بعضهم بعضا","","Majmu'a Da'eef Ahadith 304","","","Envy among jurists"
"306","النظر الى وجه العالم عبادة","","Majmu'a Da'eef Ahadith 306","","","Looking at a scholar’s face is worship"
"307","انا مدينة العلم وعلى بابها","","Majmu'a Da'eef Ahadith 307","","","I am the city of knowledge and Ali is its gate"
"308","موت العالم مصيبة لا تجبر و ثلمة لا تسد","","Majmu'a Da'eef Ahadith 308","","","Death of a scholar is a great loss"
