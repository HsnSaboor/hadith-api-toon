"590","(۵۹۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ یَسَارِ بْنِ نُمَیْرٍ ، قَالَ: کَانَ عُمَرُ إذَا بَالَ مَسَحَ ذَکَرَہُ بِحَائِطٍ، أَوْ بِحَجَرٍ ، وَلَمْ یَمَسَّہُ مَائً۔",": Sahih","Musannaf Ibn Abi Shaybah 590","","","كتاب الطهارة"
"591","(۵۹۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، أَوْ مَالِکِ بْنِ الْحَارِثِ ، قَالَ : مَرَّ سَعْدٌ بِرَجُلٍ یَغْسِلُ مَبَالَہُ، فَقَالَ : لِمَ تَخْلِطُوا فِی دِینِکُمْ مَا لَیْسَ مِنْہُ ؟!",": No Data Available","Musannaf Ibn Abi Shaybah 591","","","كتاب الطهارة"
"592","(۵۹۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْمُسْتَوْرِدِ ، قَالَ : رَآنِی مُجَمِّعُ بْنُ یَزِیدَ وَأَنَا أَغْسِلُ ذَکَرِی ، فَقَالَ : أَلَمْ تَکُنْ تَنَفَّضْت حِینَ بُلْتَ ؟ قُلْتُ : بَلَی ، قَالَ : حَسْبُک۔",": No Data Available","Musannaf Ibn Abi Shaybah 592","","","كتاب الطهارة"
"593","(۵۹۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : کَانَ أَبِی لاَ یَغْسِلُ مَبَالَہُ ، یَتَوَضَّأُ وَلاَ یَمَسُّ مَائً۔",": No Data Available","Musannaf Ibn Abi Shaybah 593","","","كتاب الطهارة"
"594","(۵۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ؛ أَنَّ ابْنَ الزُّبَیْرِ رَأَی رَجُلاً یَغْسِلُ ذَکَرَہُ ، فَقَالَ : أَلاَ یَغْسِلُ اسْتَہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 594","","","كتاب الطهارة"
"595","(۵۹۵) حَدَّثَنَا عَبْدُالأَعْلَی، عَنْ یُونُسَ، عَنِ الْحَسَنِ؛ فِی رَجُلٍ بَال وَنَسِیَ أَنْ یَغْسِلَ ذَکَرَہُ، قَالَ: أَجْزَأَ ذَلِکَ عَنْہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 595","","","كتاب الطهارة"
"596","(۵۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عُبَیْدِ اللہِ ابْنِ الْقِبْطِیَّۃِ ، عَنِ ابْنِ الزُّبَیْرِ ؛ أَنَّہُ رَأَی رَجُلاً یَغْسِلُ عَنْہُ أَثَرَ الْغَائِطِ ، فَقَالَ : مَا کُنَّا نَفْعَلُہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 596","","","كتاب الطهارة"
"597","(۵۹۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ اللہِ بْنِ یَحْیَی التَّوْأَمِ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ أُمِّہِ ، عَنْ عَائِشَۃَ ، قَالَتِ : انْطَلَقَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَبُولُ ، فَاتَّبَعَہُ عُمَرُ بِمَائٍ ، فَقَالَ : مَا ہَذَا یَا عُمَرُ ؟ فَقَالَ: مَائٌ تَوَضَّأ بِہِ ، فَقَالَ: مَا أُمِرْت کُلَّمَا بُلْتُ أَنْ أَتَوَضَّأَ ، وَلَوْ فَعَلْتُ لَکَانَتْ سُنَّۃً۔ (ابوداؤد ۴۳۔ ابن راھویہ ۱۲۶۲)",": Da'if","Musannaf Ibn Abi Shaybah 597","","","كتاب الطهارة"
"598","(۵۹۸) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ، عَنْ غَیْلاَنَ بْنِ عَبْدِاللہِ، مَوْلَی بَنِی مَخْزُومٍ، قَالَ:رَأَیْتُ ابْنَ عُمَرَ یَغْسِلُ أَثَرَ الْبَوْلِ۔",": Da'if","Musannaf Ibn Abi Shaybah 598","","","كتاب الطهارة"
"599","(۵۹۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَاصِمٍ ، قَالَ : رَأَیْتُ أَنَسًا یَغْسِلُ أَثَرَ الْبَوْلِ ، وَرَأَیْت ابْنَ سِیرِینَ یَغْسِلُ أَثَرَ الْبَوْلِ ، وَرَأَیْت النضْرَ بْنَ أَنَسٍ یَغْسِلُ أَثَرَ الْبَوْلِ۔",": Sahih","Musannaf Ibn Abi Shaybah 599","","","كتاب الطهارة"
"600","(۶۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ کَہْمَسٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، قَالَ ابْنُ عَبَّاسٍ : أَحْمَدُ إلَیْکُمْ غَسْلَ الإِحْلِیلِ۔",": Sahih","Musannaf Ibn Abi Shaybah 600","","","كتاب الطهارة"
"601","(۶۰۱) حَدَّثَنَا وَکِیعٌ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ، عَنْ رَجُلٍ مِنْ بَنِی أَسَدٍ، قَالَ: رَأَیْتُ أَبَا ہُرَیْرَۃَ بَالَ، فَغَسَلَ مَا ہُنَالِکَ۔",": Da'if","Musannaf Ibn Abi Shaybah 601","","","كتاب الطهارة"
"602","(۶۰۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : بَالَ ثُمَّ أَخَذَ مَائً ، فَأَدْخَلَ یَدَہُ فِی تُبَّانِہِ ، فَمَسَحَ ذَکَرَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 602","","","كتاب الطهارة"
"603","(۶۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، أَنَّہُ بَالَ ثُمَّ أَدْخَلَ یَدَہُ فِی سَرَاوِیلِہِ فَغَسَلَ ذَکَرَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 603","","","كتاب الطهارة"
"604","(۶۰۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ : کَانَ إبْرَاہِیمُ إذَا بَالَ أَدْخَلَ یَدَہُ تَحْتَ إزَارِہِ فَمَسَحَ ذَکَرَہُ ، فَذَکَرْت ذَلِکَ لِطَلْحَۃَ فَأَعْجَبَہُ ذَلِکَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 604","","","كتاب الطهارة"
"605","(۶۰۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعَلاَئِ ، قَالَ : رَأَیْتُ إبْرَاہِیمَ بَالَ فَغَسَلَ ذَکَرَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 605","","","كتاب الطهارة"
"606","(۶۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إِبْرَاہِیمَ بن عُمَرَ ، عَنْ سُلَیْمَانَ الأَحْوَلِ ، عَنْ طَاوُوسٍ ؛ فِی رَجُلٍ تَوَضَّأَ فَخَضْخَضَ رِجْلَیْہِ فِی الْمَائِ ، قَالَ : ہَذَا غَیْرُ طَائِلٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 606","","","كتاب الطهارة"
"607","(۶۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، قَالَ : سَأَلْتُ عَطَائً ، وَعَامِرًا ، وَسَالِمًا عَنِ الرَّجُلِ یَتَوَضَّأُ ، فَخَضْخَضَ رِجْلَیْہِ فِی الْمَائِ ؟ قَالُوا: یُجْزِئُہ۔",": No Data Available","Musannaf Ibn Abi Shaybah 607","","","كتاب الطهارة"
"608","(۶۰۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی حُرَّۃَ، عَنِ الْحَسَنِ ، قَالَ: إذَا خَضْخَضَ رِجْلَیْہِ فِی الْمَائِ فَقَدْ أَجْزَأَہُ مِنَ الْوُضُوئِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 608","","","كتاب الطهارة"
"609","(۶۰۹) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ رُبَّمَا بَلَغَ بِالْوُضُوئِ إبِطَہُ فِی الصَّیْفِ۔",": Da'if","Musannaf Ibn Abi Shaybah 609","","","كتاب الطهارة"
"610","(۶۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عُقْبَۃَ بْنِ أَبِی صَالِحٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَرِہَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 610","","","كتاب الطهارة"
"611","(۶۱۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عُمَارَۃَ بْنِ الْقَعْقَاعِ ، عَنْ أَبِی زُرْعَۃَ ، قَالَ : دَخَلْت مَعَ أَبِی ہُرَیْرَۃَ دَارَ مَرْوَانَ فَدَعَا بِوَضُوئٍ فَتَوَضَّأَ ، فَلَمَّا غَسَلَ ذِرَاعَیْہِ جَاوَزَ الْمِرْفَقَیْنِ ، فَلَمَّا غَسَلَ رِجْلَیْہِ جَاوَزَ الْکَعْبَیْنِ إلَی السَّاقَیْنِ ، فَقُلْتُ : مَا ہَذَا ؟ فَقَالَ : ہَذَا مَبْلَغُ الْحِلْیَۃِ۔ (بخاری ۵۹۵۳۔ مسلم ۲۱۹)",": Sahih","Musannaf Ibn Abi Shaybah 611","","","كتاب الطهارة"
"612","(۶۱۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ، عَنْ یَحْیَی بْنِ أَیُّوبَ الْبَجَلِیِّ، عَنْ أَبِی زُرْعَۃَ قَالَ: دَخَلْتُ عَلَی أَبِی ہُرَیْرَۃَ فَتَوَضَّأَ إلَی مَنْکِبَیْہِ وَإِلَی رُکْبَتَیْہِ، فَقُلْتُ لَہُ: أَلاَّ تَکْتَفِی بِمَا فَرَضَ اللَّہُ عَلَیْک مِنْ ہَذَا؟ قَالَ: بَلَی، وَلَکِنِّی سَمِعْت رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَقُولُ: مَبْلَغُ الْحِلْیَۃِ مَبْلَغُ الْوُضُوئِ، فَأَحْبَبْتُ أَنْ یَزِیدَنِی فِی حِلْیَتِی۔ \n(مسلم ۱۰۱)",": Hasan","Musannaf Ibn Abi Shaybah 612","","","كتاب الطهارة"
"613","(۶۱۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ یَحْیَی بْنِ وَثَّابٍ ، قَالَ : سُئِلَ ابْنُ عَبَّاسٍ عَنْ رَجُلٍ خَرَجَ إلَی الصَّلاَۃِ فَوَطِیئَ عَلَی عَذِرَۃٍ ؟ قَالَ : إِنْ کَانَتْ رَطْبَۃً غَسَلَ مَا أَصَابَہُ ، وَإِنْ کَانَتْ یَابِسَۃً لَمْ تَضُرَّہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 613","","","كتاب الطهارة"
"614","(۶۱۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ قَالَ ؛ فِی الرَّجُلِ یَطَأُ عَلَی الْعَذِرَۃِ وَہُوَ طَاہِرٌ قَالَ : إِنْ کَانَ رَطْبًا غَسَلَ مَا أَصَابَہُ ، وَإِنْ کَانَ یَابِسًا فَلاَ شَیْئَ عَلَیْہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 614","","","كتاب الطهارة"
"615","(۶۱۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إِنْ کَانَ رَطْبًا غَسَلَہُ ، وَإِنْ کَانَ یَابِسًا فَلاَ یَضُرُّہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 615","","","كتاب الطهارة"
"616","(۶۱۶) حَدَّثَنَا یزَیْدُ بْنُ ہَارُونَ ، عَنِ التَّیْمِیِّ ، عَنِ الْحَسَنِ قَالَ؛ فِی الرَّجُلِ یَطَأُ عَلَی الْعَذِرَۃِ الرَّطْبَۃِ، قَالَ: یَغْسِلُہُ، وَلاَ یَتَوَضَّأُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 616","","","كتاب الطهارة"
"617","(۶۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ فِیمَنْ وَطِیئَ عَلَی جِیفَۃٍ ، أَوْ حَیْضَۃٍ ، أَوْ عَذِرَۃٍ یَابِسَۃٍ : فَلاَ بَأْسَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 617","","","كتاب الطهارة"
"618","(۶۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ طَلْحَۃَ ، عَنْ زُبَیْدٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لاَ بَأْسَ بِطِینٍ یُخَالِطُہُ الْبَوْلُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 618","","","كتاب الطهارة"
"619","(۶۱۹) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَنْ سنان بْنِ حَبِیبٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَطَأُ عَلَی الْعَذِرَۃِ وَہُوَ یُرِیدُ الْمَسْجِدَ ، قَالَ : قَالَ إبْرَاہِیمُ : لاَ ، یُعِیدُ الْوُضُوئَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 619","","","كتاب الطهارة"
"620","(۶۲۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عُمَارَۃَ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَن أُمِّ وَلَدٍ لإِبْرَاہِیمَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ، قَالَتْ : کُنْتُ أُطِیلُ ذَیْلِی ، فَأَمُرُّ بِالْمَکَانِ الْقَذِرِ وَالْمَکَانِ الطَّیِّبِ ، فَدَخَلْتُ عَلَی أُمِّ سَلَمَۃَ فَسَأَلْتُہَا ، فَقَالَتْ أُمُّ سَلَمَۃَ : سَمِعْت رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : یُطَہِّرُہُ مَا بَعْدَہُ۔\n(طبرانی ۸۴۶۔ مالک ۱۶)",": Da'if","Musannaf Ibn Abi Shaybah 620","","","كتاب الطهارة"
"621","(۶۲۱) حَدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ اللہِ بْنِ عِیسَی ، عَنْ مُوسَی بْنِ عَبْدِ اللہِ بْنِ یَزِیدَ ، عَنِ امْرَأَۃٍ مِنْ بَنِی عَبْدِ الأَشْہَلِ ، أَنَّہَا سَأَلَتِ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : أَنَّ بَیْنِی وَبَیْنَ الْمَسْجِدِ طَرِیقًا قَذِرًا ؟ قَالَ : فَبَعْدَہَا طَرِیقٌ أَنْظَفَ مِنْہَا ؟ قَالَتْ : نَعَمْ ، قَالَ : ہَذِہِ بِہَذِہِ۔ (احمد ۶/۴۳۵)",": Hasan","Musannaf Ibn Abi Shaybah 621","","","كتاب الطهارة"
"622","(۶۲۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخبَرَنَأَ یَحْیَی بْنُ سَعِیدٍ ، عَمَّنْ حَدَّثَہُ عَنْ عَائِشَۃَ ؛ أَنَّہَا سُئِلَتْ ، عَنِ الرَّجُلِ یَمُرُّ بِالْمَکَانِ الْقَذِرِ وَہُوَ عَلَی طَہَارَۃٍ ؟ فَقَالَتْ : إِنَّہُ قَدْ یَمُرُّ بِالْمَکَانِ النَّظِیفِ فَیُطَہِّرُ بَعْضُہُ بَعْضًا۔",": Da'if","Musannaf Ibn Abi Shaybah 622","","","كتاب الطهارة"
"623","(۶۲۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : الأَرْضُ یُطَہِّرُ بَعْضُہَا بَعْضًا۔",": Da'if","Musannaf Ibn Abi Shaybah 623","","","كتاب الطهارة"
"624","(۶۲۴) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، قَالَ : بَلَغَنِی عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَابْنِ عَبَّاسٍ : أَنَّہُمَا کَانَا یَقُولاَنِ : الأَرْضُ یُطَہِّرُ بَعْضُہَا بَعْضًا۔",": Sahih","Musannaf Ibn Abi Shaybah 624","","","كتاب الطهارة"
"625","(۶۲۵) حَدَّثَنَا شَرِیکٌ وَہُشَیْمٌ ، وَابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ: کُنَّا لاَ نَتَوَضَّأُ مِنْ مَوْطِئٍ۔ (ابوداؤد ۲۰۶)","","Musannaf Ibn Abi Shaybah 625","","","كتاب الطهارة"
"626","(۶۲۶) حَدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : الأَرْضُ یُطَہِّرُ بَعْضُہَا بَعْضًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 626","","","كتاب الطهارة"
"627","(۶۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ عَلْقَمَۃَ ، وَالأَسْوَدِ ؛ أَنَّہُمَا کَانَا لاَ یَتَوَضَّآنِ مِمَّا وَطِئَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 627","","","كتاب الطهارة"
"628","(۶۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ ، عَنْ أَبِی جَعْفَرٍ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ عَلْقَمَۃَ ، قَالَ : لاَ وُضُوئَ مِنْ مَوْطِئٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 628","","","كتاب الطهارة"
"629","(۶۲۹) حَدَّثَنَا الْمُطَّلِبُ بْنُ زِیَادٍ ، عَنْ مُحَمَّدِ بْنِ الْمُہَاجِرِ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : زَکَاۃُ الأَرْضِ یُبْسُہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 629","","","كتاب الطهارة"
"630","(۶۳۰) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنِ الْحَارِثِ بْنِ عُمَیْرٍ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : إذَا جَفَّتِ الأَرْضُ فَقَدْ زَکَتْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 630","","","كتاب الطهارة"
"631","(۶۳۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ إسْمَاعِیلَ الأَزْرَقِ ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، قَالَ : إذَا جَفَّتِ الأَرْضُ فَقَدْ زَکَتْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 631","","","كتاب الطهارة"
"632","(۶۳۲) حَدَّثَنَا مَرْحُومُ بْنُ عَبْدِ الْعَزِیزِ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ الْحَسَنَ جَالِسًا عَلَی أَثَرِ بَوْلٍ جَافٍّ ، فَقُلْتُ لَہُ ؟ فَقَالَ : إِنَّہُ جَافٍّ۔",": No Data Available","Musannaf Ibn Abi Shaybah 632","","","كتاب الطهارة"
"633","(۶۳۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ یَذْکُرُہُ عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : تَمَضْمَضُوا مِنَ اللَّبَنِ ، فَإِنَّ لَہُ دَسَمًا۔","","Musannaf Ibn Abi Shaybah 633","","","كتاب الطهارة"
"634","(۶۳۴) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، بِمِثْلِہِ۔ (احمد ۱/۳۲۹)",": Da'if","Musannaf Ibn Abi Shaybah 634","","","كتاب الطهارة"
"635","(۶۳۵) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ مُوسَی بْنِ یَعْقُوبَ الزَّمْعِیِّ ، قَالَ : أَنْبَأَنِی ابْنُ أَبِی عُبَیْدَۃَ بْنُ عَبْدِ اللہِ بْنِ زَمْعَۃَ، عَنْ أَبِیہِ ، عَنْ أُمِّ سَلَمَۃَ زَوْجِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : إِذَا شَرِبْتُمُ اللَّبَنَ فَمَضْمِضُوا مِنْہُ ، فَإِنَّ لَہُ دَسَمًا۔",": Hasan","Musannaf Ibn Abi Shaybah 635","","","كتاب الطهارة"
"636","(۶۳۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ وَإِسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ؛ أَنَّ أَنَسَ بْنَ مَالِکٍ وَالْحَارِثَ الْہَمْدَانِیَّ کَانَا یُمَضْمِضَانِ مِنَ اللَّبَنِ ثَلاَثًا۔",": Sahih","Musannaf Ibn Abi Shaybah 636","","","كتاب الطهارة"
"637","(۶۳۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَبِی جَعْفَرٍ الْخِطْمِیِّ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، قَالَ : کَانَ یَشْرَبُ اللَّبَنَ فَیُمَضْمِضُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 637","","","كتاب الطهارة"
"638","(۶۳۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ رَجُلٍ مِنْ ہُذَیْلٍ ، أُرَاہُ قَدْ ذَکَرَ أَنَّ لَہُ صُحْبَۃً ، قَالَ : یُمَضْمَضُ مِنَ اللَّبَنِ ، وَلاَ یُمَضْمَضُ مِنَ التَّمْرِ۔",": Sahih","Musannaf Ibn Abi Shaybah 638","","","كتاب الطهارة"
"639","(۶۳۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَنْ أَکَلَ لَحْمًا ، أَوْ شَرِبَ لَبَنًا فَلْیُمَضْمِضْ ، إِنْ شَائَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 639","","","كتاب الطهارة"
"640","(۶۴۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَاصِمٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَأْمُرُ بِالْمَضْمَضَۃِ مِنَ اللَّبَنِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 640","","","كتاب الطهارة"
"641","(۶۴۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ ہِشَامِ بْنِ حَسَّانَ؛ أَنَّ أَبَا مُوسَی وَأَنَسًا وَالْحَارِثَ الْہَمْدَانِیَّ کَانُوا یُمَضْمِضُونَ مِنَ اللَّبَنِ۔",": Da'if","Musannaf Ibn Abi Shaybah 641","","","كتاب الطهارة"
"642","(۶۴۲) حَدَّثَنَا عَبْدُاللہِ بْنُ نُمَیْرٍ ، قَالَ: حَدَّثَنَا عُثْمَانُ بْنُ حَکِیمٍ ، عَنْ عَبَّادِ بْنِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، عَنْ أَبِی سَعِیدٍ، قَالَ : لاَ وُضُوئَ إِلاَّ مِنَ اللَّبَنِ ، لإِنَّہُ یَخْرُجُ مِنْ بَیْنِ فَرْثٍ وَدَمٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 642","","","كتاب الطهارة"
"643","(۶۴۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا عُثْمَانُ بْنُ حَکِیمٍ ، عَنْ عَبْدِ الرَّحْمَنِ الأَعْرَجِ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یَقُولُ : لاَ وُضُوئَ إِلاَّ مِنَ اللَّبَنِ۔",": Sahih","Musannaf Ibn Abi Shaybah 643","","","كتاب الطهارة"
"644","(۶۴۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ الْقَاسِمَ عَنِ الْمَضْمَضَۃِ ، أَوِ الْوُضُوئِ مِنَ اللَّبَنِ ؟ فَقَالَ : لاَ أَعْلَمُ بِہِ بَأْسًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 644","","","كتاب الطهارة"
"645","(۶۴۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا یَزِیدُ الشَّیْبَانِیُّ ، قَالَ : سَمِعْتُ عَبْدَ الْمَلِکِ بْنَ مَیْسَرَۃَ ، عَنِ ابْنِ وَاثِلَۃَ ؛ أَنَّ حُذَیْفَۃَ دَعَا بِلَبَنٍ فَشَرِبَ وَشَرِبْت ، ثُمَّ دَعَا بِمَائٍ فَتَمَضْمَضَ وَتَمَضْمَضْتُ۔",": Sahih","Musannaf Ibn Abi Shaybah 645","","","كتاب الطهارة"
"646","(۶۴۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : نُبِّئْتُ أَنَّ ابْنَ عَبَّاسٍ شَرِبَ لَبَنًا ، فَذَکَرُوا لَہُ الْوُضُوئَ وَالْمَضْمَضَۃَ قَالَ : لاَ أُبَالِیہ بَالَۃً ، اسْمَحْ یُسْمَحْ لَک۔",": Da'if","Musannaf Ibn Abi Shaybah 646","","","كتاب الطهارة"
"647","(۶۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ قُرَّۃَ بْنِ خَالِدٍ ، عَنْ یَزِیدَ ، عَنْ أَخِیہِ مُطَرِّفِ بْنِ الشِّخِّیرِ ، قَالَ : شَرِبْت لَبَنًا مَحْضًا بَعْدَ مَا تَوَضَّأْتُ فَسَأَلْت ابْنَ عَبَّاسٍ ، فَقَالَ : مَا أُبَالِیہ بَالَۃً ، اسْمَحْ یُسْمَحْ لَک۔",": Sahih","Musannaf Ibn Abi Shaybah 647","","","كتاب الطهارة"
"648","(۶۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ طَلْحَۃَ ، قَالَ : سَأَلْتُ أَبَا عَبْدِ الرَّحْمَنِ ، عَنِ الْوُضُوئِ مِنَ اللَّبَنِ قَالَ : مِنْ شَرَابٍ سَائِغٍ لِلشَّارِبِینَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 648","","","كتاب الطهارة"
"649","(۶۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، قَالَ : قُلْتُ لِجَبَلَۃَ : أَسَمِعْت ابْنَ عُمَرَ یَقُولُ : إنِّی لآَکُلُ اللَّحْمَ وَأَشْرَبُ اللَّبَنَ ، وَأُصَلِّی وَلاَ أَتَوَضَّأُ ؟ قَالَ : نَعَمْ۔",": Sahih","Musannaf Ibn Abi Shaybah 649","","","كتاب الطهارة"
"650","(۶۵۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : کَانَ أَبُو عَبْدِ الرَّحْمَنِ فِی الْمَسْجِدِ ، فَأَتَاہُ مُدْرِکُ بْنُ عُمَارَۃَ بِلَبَنٍ فَشَرِبَہُ ، فَقَالَ مُدْرِکٌ : ہَذَا مَائٌ فَمَضْمِضْ ، قَالَ : مِنْ أَیِّ شَیْئٍ ؟ أمِنَ السَّائِغِ الطَّیِّبِ؟!",": No Data Available","Musannaf Ibn Abi Shaybah 650","","","كتاب الطهارة"
"651","(۶۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ جَبْرِ بْنِ عَتِیکٍ ، قَالَ : أَتَانَا ابْنُ عُمَرَ فِی دَارِنَا ، فَأَتَیْنَاہُ بِوَضُوئٍ فِی نُحَاسٍ فَکَرِہَہُ ، وَقَالَ : ائْتُونِی بِحَجَرٍ ، أَوْ خَشَبٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 651","","","كتاب الطهارة"
"652","(۶۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ أُمِّ غُرَابٍ ، عَنْ بُنَانَۃَ ، أَنَّ عُثْمَانَ کَانَ یَتَوَضَّأُ فِی کُوزٍ ، أَوْ تَوْرٍ مِنْ بِرَامٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 652","","","كتاب الطهارة"
"653","(۶۵۳) حَدَّثَنَا وَکِیعٌ، عَنْ جَرِیرِ بْنِ حَازِمٍ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ کَانَ یَتَوَضَّأُ فِی أُدُمٍ، أَوْ فِی قَدَحِ خَشَبٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 653","","","كتاب الطهارة"
"654","(۶۵۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ مَرْزُوقٍ أَبِی بُکَیْر ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : سَأَلَ رَجُلٌ ابْنَ عَبَّاسٍ ، قَالَ : إنَّا نَنْتَجِعُ الْکَلأَ وَلاَ نَجِدُ الْمَائَ فَنَتَوَضَّأُ بِاللَّبَنِ ؟ قَالَ : لاَ ، عَلَیْکُمْ بِالتَّیَمُّمِ۔",": Hasan","Musannaf Ibn Abi Shaybah 654","","","كتاب الطهارة"
"655","(۶۵۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَمَّنْ سَمِعَ الْحَسَنَ یَقُولُ : لاَ یُتَوَضَّأُ بِنَبِیذٍ ، وَلاَ لَبَنٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 655","","","كتاب الطهارة"
"656","(۶۵۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ أَبِیہِ ، عَنْ إبْرَاہِیمَ : فِی الذُّبَابِ یَقَعُ فِی الإِنَائِ فَیَمُوتُ ، قَالَ : لاَ بَأْسَ بِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 656","","","كتاب الطهارة"
"657","(۶۵۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ لَمْ یَرَ بَأْسًا بِالْعَقْرَبِ وَالْخُنْفُسَائِ وَکُلِّ نَفْسٍ لَیْسَتْ بِسَائِلَۃٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 657","","","كتاب الطهارة"
"658","(۶۵۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ، وَعَطَائٍ : أَنَّہُمَا لَمْ یَرَیَا بَأْسًا بِالْخُنْفُسَائِ وَالْعَقْرَبِ وَالصِّرَارِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 658","","","كتاب الطهارة"
"659","(۶۵۹) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا عَبْدُ اللہِ بْنُ سَبْرَۃَ ، عَنِ الشَّعْبِیِّ ؛ فِی دَجَاجَۃٍ مَاتَتْ فِی بِئْرٍ ، قَالَ : تُعَادُ مِنْہَا الصَّلاَۃُ وَتُغْسَلُ الثِّیَابُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 659","","","كتاب الطهارة"
"660","(۶۶۰) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ أَبِی ہَاشِمٍ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ، قَالَ: اقرأ علیَّ آیۃً بغسل الثیاب۔",": No Data Available","Musannaf Ibn Abi Shaybah 660","","","كتاب الطهارة"
"661","(۶۶۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَمِعْتُ سُفْیَانَ یَقُولُ : إذَا اسْتَیْقَنْت أَنَّک تَوَضَّأَت وَہِیَ فِی الْبِئْرِ ، فَالثِّقَۃُ فِی غَسْلِ الثِّیَابِ وَإِعَادَۃِ الصَّلاَۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 661","","","كتاب الطهارة"
"662","(۶۶۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ عَائِشَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا أَرَادَ أَنْ یَنَامَ وَہُوَ جُنُبٌ ، تَوَضَّأَ وُضُوئَہُ لِلصَّلاَۃِ۔ (مسلم ۲۴۸۔ ابن ماجہ ۵۸۴)",": Sahih","Musannaf Ibn Abi Shaybah 662","","","كتاب الطهارة"
"663","(۶۶۳) حَدَّثَنَا ابْنُ المُبَارَکٍ ، عَنْ یُونُسَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ عَائِشَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا أَرَادَ أَنْ یَنَامَ تَوَضَّأَ ، وَإِذَا أَرَادَ أَنْ یَأْکُلَ غَسَلَ یَدَیْہِ ، تَعْنِی وَہُوَ جُنُبٌ۔ (ابن ماجہ ۵۹۳۔ ابوداؤد ۲۲۵)",": Sahih","Musannaf Ibn Abi Shaybah 663","","","كتاب الطهارة"
"664","(۶۶۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، قَالَ : قَالَ عَلِیٌّ : إذَا أَجْنَبَ الرَّجُلُ فَأَرَادَ أَنْ یَطْعَمَ ، أَوْ یَنَامَ تَوَضَّأَ وُضُوئَہُ لِلصَّلاَۃِ۔",": Da'if","Musannaf Ibn Abi Shaybah 664","","","كتاب الطهارة"
"665","(۶۶۵) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ إذَا أَرَادَ أَنْ یَأْکُلَ ، أَوْ یَنَامَ وَہُوَ جُنُبٌ ، غَسَلَ وَجْہَہُ وَیَدَیْہِ ، وَمَسَحَ بِرَأْسِہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 665","","","كتاب الطهارة"
"666","(۶۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : إذَا أَرَادَ أَحَدُکُمْ أَنْ یَرْقُدَ وَہُوَ جُنُب?? فَلْیَتَوَضَّأْ، فَإِنَّہُ لاَ یَدْرِی لَعَلَّہُ یُصَابُ فِی مَنَامِہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 666","","","كتاب الطهارة"
"667","(۶۶۷) حَدَّثَنَا ابْنُ مُبَارَکٍ ، وَابْنُ نُمَیْرٍ ، عَنْ زَکَرِیَّا ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ ، عَنْ أَبِی الضُّحَی ؛ سُئِلَ أَیَأْکُلُ الْجُنُبُ؟ قَالَ : نَعَمْ ، وَیَمْشِی فِی الأَسْوَاقِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 667","","","كتاب الطهارة"
"668","(۶۶۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ شَدَّادِ بْنِ أَوْسٍ ، قَالَ : إذَا أَجْنَبَ أَحَدُکُمْ مِنَ اللَّیْلِ ، ثُمَّ أَرَادَ أَنْ یَنَامَ فَلْیَتَوَضَّأْ ، فَإِنَّہُ نِصْفُ الْجَنَابَۃِ۔",": Da'if","Musannaf Ibn Abi Shaybah 668","","","كتاب الطهارة"
"669","(۶۶۹) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ حَبِیبِ بْنِ شَہِیدٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، قَالَ : إذَا أَرَادَ الْجُنُبُ أَنْ یَأْکُلَ ، أَوْ یَنَامَ فَلْیَتَوَضَّأْ وُضُوئَہُ لِلصَّلاَۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 669","","","كتاب الطهارة"
"670","(۶۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، وَابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : إذَا أَرَادَ الْجُنُبُ أَنْ یَأْکُلَ غَسَلَ یَدَیْہِ ، وَمَضْمَضَ فَاہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 670","","","كتاب الطهارة"
"671","(۶۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زُبَیْدٍ ، عَنْ مُجَاہِدٍ ؛ فِی الْجُنُبِ یَأْکُلُ ؟ قَالَ : یَغْسِلُ یَدَیْہِ وَیَأْکُلُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 671","","","كتاب الطهارة"
"672","(۶۷۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : إِنْ شَائَ الْجُنُبُ نَامَ قَبْلَ أَنْ یَتَوَضَّأَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 672","","","كتاب الطهارة"
"673","(۶۷۳) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ ، قَالَ : الْجُنُبُ إذَا أَرَادَ أَنْ یَأْکُلَ غَسَلَ یَدَیْہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 673","","","كتاب الطهارة"
"674","(۶۷۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَشْرَبُ الْجُنُبُ قَبْلَ أَنْ یَتَوَضَّأَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 674","","","كتاب الطهارة"
"675","(۶۷۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، وَغُنْدَرٌ ، وَوَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ إذَا کَانَ جُنُبًا ، فَأَرَادَ أَنْ یَأْکُلَ ، أَوْ یَنَامَ یَتَوَضَّأُ۔\n(مسلم ۲۴۸۔ ابوداؤد ۲۲۶)",": Sahih","Musannaf Ibn Abi Shaybah 675","","","كتاب الطهارة"
"676","(۶۷۶) حَدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ الْعَدَنِیِّ ، قَالَ ، سَمِعْتُ مُحَمَّدَ بْنَ عَلِیٍّ یَقُولُ فِی الْجُنُبِ إذَا أَرَادَ أَنْ یَنَامَ ، أَوْ یَأْکُلَ ، أَوْ یَشْرَبَ : تَوَضَّأَ وُضُوئَہُ لِلصَّلاَۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 676","","","كتاب الطهارة"
"677","(۶۷۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، وَأَبِی قِلاَبَۃَ قَالاَ : اسْتَفْتَی عُمَرُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ أَیَنَامُ أَحَدُنَا وَہُوَ جُنُبٌ ؟ فَقَالَ : یَتَوَضَّأُ وَیَنَامُ ۔ قَالَ أَیُّوبُ ، أَظُنُّ فِی حَدِیثِ أَبِی قِلاَبَۃَ : غَسْلَ الْفَرْجِ۔\n(بخاری ۲۹۰۔ طحاوی ۱۲۷)","","Musannaf Ibn Abi Shaybah 677","","","كتاب الطهارة"
"678","(۶۷۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، قَالَ : حدَّثَنَا یَحْیَی بْنُ أَبِی کَثِیرٍ ، قَالَ : حَدَّثَنَا أَبُو سَلَمَۃَ ؛ أَنَّہُ سَأَلَ عَائِشَۃَ : أَکَانَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَرْقُدُ وَہُوَ جُنُبٌ ؟ قَالَتْ : نَعَمْ ، وَیَتَوَضَّأُ وُضُوئَہُ لِلصَّلاَۃِ۔\n(بخاری ۲۸۶۔ احمد ۶/۱۲۸)",": Sahih","Musannaf Ibn Abi Shaybah 678","","","كتاب الطهارة"
"679","(۶۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنْ سَالِمِ بْنِ عَبْدِ اللہِ بْنِ عُمَرَ ، عَنْ أَبِیہِ ، قَالَ : إذَا أَرَادَ الْجُنُبُ أَنْ یَأْکُلَ ، أَوْ یَنَامَ ، أَوْ یَشْرَبَ تَوَضَّأَ۔",": Sahih","Musannaf Ibn Abi Shaybah 679","","","كتاب الطهارة"
"680","(۶۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَرَادَ الْجُنُبُ أَنْ یَأْکُلَ ، أَوْ یَنَامَ تَوَضَّأَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 680","","","كتاب الطهارة"
"681","(۶۸۱) حَدَّثَنَا عَثَّامُ بْنُ عَلِیٍّ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ؛ فِی الرَّجُلِ تُصِیبُہُ جَنَابَۃٌ مِنَ اللَّیْلِ فَیُرِیدُ أَنْ یَنَامَ، قَالَتْ : یَتَوَضَّأُ ، أَوْ یَتَیَمَّمُ۔",": Sahih","Musannaf Ibn Abi Shaybah 681","","","كتاب الطهارة"
"682","(۶۸۲) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ عُمَرَ سَأَلَ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : تُصِیبُنِی الْجَنَابَۃُ فَأَرْقُدُ ؟ قَالَ : إذَا أَرَدْت أَنْ تَرْقُدَ فَتَوَضَّأَ۔ (بخاری ۲۸۹۔ مسلم ۲۴)",": Sahih","Musannaf Ibn Abi Shaybah 682","","","كتاب الطهارة"
"683","(۶۸۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَطَائٍ الْخُرَاسَانِیِّ ، عَنْ یَحْیَی بْنِ یَعْمَُرَ ، عَنْ عَمَّارٍ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ رَخَّصَ لِلْجُنُبِ إذَا أَرَادَ أَنْ یَنَامَ ، أَوْ یَأْکُلَ ، أَوْ یَشْرَبَ ، أَنْ یَتَوَضَّأَ وُضُوئَہُ لِلصَّلاَۃِ۔ (ابوداؤد ۲۲۷۔ ترمذی ۶۱۳)",": Da'if","Musannaf Ibn Abi Shaybah 683","","","كتاب الطهارة"
"684","(۶۸۴) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ بُرْدِ بْنِ سِنَانٍ ، عَنْ عُبَادَۃَ بْنِ نُسَیٍّ ، عَنْ غُضَیْفِ بْنِ الْحَارِثِ ، قَالَ : أَتَیْتُ عَائِشَۃَ، فَقُلْتُ : أَرَأَیْت رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ أَفِی أَوَّلِ اللَّیْلِ کَانَ یَغْتَسِلُ مِنَ الْجَنَابَۃِ ، أَمْ فِی آخِرِہِ؟ فَقَالَتْ : رُبَّمَا اغْتَسَلَ فِی أَوَّلِ اللَّیْلِ ، وَرُبَّمَا اغْتَسَلَ فِی آخِرِہِ۔ (احمد ۶/۱۳۸۔ ترمذی ۲۹۲۴)",": Sahih","Musannaf Ibn Abi Shaybah 684","","","كتاب الطهارة"
"685","(۶۸۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنْ أَبِی مَعْمَرٍ ، عَنْ حُذَیْفَۃَ، قَالَ : نَوْمُہ قَبْلَ الْغُسْلِ أَوْعَبُ لِخُرُوجِہِ۔","","Musannaf Ibn Abi Shaybah 685","","","كتاب الطهارة"
"686","(۶۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ طَلْحَۃَ بْنِ مُصَرِّفٍ ، قَالَ : قَالَ حُذَیْفَۃُ : نَوْمُہ بَعْدَ الْجَنَابَۃِ أَوْعَبُ لِلْغُسْلِ۔",": Da'if","Musannaf Ibn Abi Shaybah 686","","","كتاب الطهارة"
"687","(۶۸۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ إذَا کَانَتْ لَہُ حَاجَۃٌ إلَی أَہْلِہِ قَضَاہَا ، ثُمَّ نَامَ کَہَیْئَتِہِ لاَ یَمَسُّ مَائً۔ (ابن ماجہ ۵۸۲)",": Da'if","Musannaf Ibn Abi Shaybah 687","","","كتاب الطهارة"
"688","(۶۸۸) حَدَّثَنَا شَرِیکٌ ، عَنْ إِبْرَاہِیمَ ، عَن مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا جَامَعَ الرَّجُلُ ، ثُمَّ أَرَادَ أَنْ یَعُودَ فَلاَ بَأْسَ أَنْ یُؤَخِّرَ الْغُسْلَ۔ (طبرانی ۹۲۱۳)",": Hasan","Musannaf Ibn Abi Shaybah 688","","","كتاب الطهارة"
"689","(۶۸۹) حَدَّثَنَا وَکِیعٍ ، قَالَ : حَدَّثَنَا الأَعْمَشُ ، عَنْ سَالِمٍ ، عَنْ کُرَیْبٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : حدَّثَنَا عَنْ خَالَتِہِ مَیْمُونَۃَ ، قَالَتْ : وَضَعْتُ لِلنَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ غُسْلاً ، فَاغْتَسَلَ مِنَ الْجَنَابَۃِ ، فَأَکْفَأَ الإِنَائَ بِشِمَالِہِ عَلَی یَمِینِہِ ، فَغَسَلَ کَفَّہُ ، ثُمَّ أَفَاضَ عَلَی فَرْجِہِ فَغَسَلَہُ ، ثُمَّ دَلَک یَدَہُ بِالأَرْضِ ، ثُمَّ مَضْمَضَ وَاسْتَنْشَقَ وَغَسَلَ وَجْہَہُ وَذِرَاعَیْہِ ، ثُمَّ أَفَاضَ عَلَی رَأْسِہِ ، ثُمَّ أَفَاضَ عَلَی سَائِرِ جَسَدِہِ الْمَائَ ، ثُمَّ تَنَحَّی فَغَسَلَ رِجْلَیْہِ ، قَالَتْ : فَأَتَیْتُہُ بِثَوْبٍ فَرَدَّہُ ، وَجَعَلَ یَقُولُ بِالْمَائِ ہَکَذَا ؛ یَنْفُضُ الْمَائَ۔ (احمد ۳۳۵۔ ترمذی ۱۰۳)",": Sahih","Musannaf Ibn Abi Shaybah 689","","","كتاب الطهارة"
"690","(۶۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ اغْتَسَلَ مِنَ الْجَنَابَۃِ ، فَبَدَأَ فَغَسَلَ کَفَّیْہِ ثَلاَثًا ، ثُمَّ تَوَضَّأَ وُضُوئَہُ لِلصَّلاَۃِ ، ثُمَّ أَدْخَلَ یَدَہُ فَخَلَّلَ بِہَا أُصُولَ الشَّعْرِ ، حَتَّی تخَیَّلَ إلَیَّ أَنَّہُ اسْتَبْرَأَ الْبَشرَۃَ ، ثُمَّ صَبَّ عَلَی رَأْسِہِ الْمَائَ ثَلاَثًا ، ثُمَّ أَفَاضَ عَلَی سَائِرِ جَسَدِہِ الْمَائَ۔ (بخاری ۲۴۸۔ نسائی ۲۴۶)",": Sahih","Musannaf Ibn Abi Shaybah 690","","","كتاب الطهارة"
"691","(۶۹۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : حدَّثَنَا أَبُو سَلَمَۃَ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ: حَدَّثَتْنِی عَائِشَۃُ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا اغْتَسَلَ مِنَ الْجَنَابَۃِ وُضِعَ لَہُ الإِنَائُ ، فَیَصُبُّ عَلَی یَدَیْہِ قَبْلَ أَنْ یُدْخِلَہُمَا فِی الإِنَائِ ، حَتَّی إذَا غَسَلَ یَدَیْہِ أَدْخَلَ یَدَہُ الْیُمْنَی فِی الإِنَائِ ، فَصَبَّ بِالْیُمْنَی وَغَسَلَ فَرْجَہُ بِالْیُسْرَی ، فَإِذَا فَرَغَ صَبَّ بِالْیُمْنَی عَلَی الْیُسْرَی فَغَسَلَہا ، ثُمَّ تَمَضْمَضَ وَاسْتَنْشَقَ ثَلاَثًا ، ثُمَّ یَصُبُّ عَلَی رَأْسِہِ مِلْئَ کَفَّیْہِ ثَلاَثَ مَرَّاتٍ ، ثُمَّ یَغْسِلُ سَائِرَ جَسَدِہِ۔ (احمد ۶/۱۷۳۔ نسائی ۲۴۴)",": Sahih","Musannaf Ibn Abi Shaybah 691","","","كتاب الطهارة"
"692","(۶۹۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ عِکْرِمَۃَ بْنِ خَالِدٍ ، قَالَ : کَانَ عُمَرُ إذَا أَجْنَبَ غَسَلَ سِفْلَتَہُ ، ثُمَّ تَوَضَّأَ وُضُوئَہُ لِلصَّلاَۃِ ، ثُمَّ أَفْرَغَ عَلَیْہِ۔",": Hasan","Musannaf Ibn Abi Shaybah 692","","","كتاب الطهارة"
"693","(۶۹۳) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ مُحَارِبِ بْنِ دِثَارٍ ، عَنِ ابْنِ عُمَرَ ؛ فِی الْغُسْلِ مِنَ الْجَنَابَۃِ ، قَالَ : یَتَوَضَّأُ وُضُوئَہُ لِلصَّلاَۃِ ، ثُمَّ یَغْسِلُ مَا أَصَابَہُ ، ثُمَّ یَضْرِبُ بِیَدِہِ عَلَی الا??َرْضِ فیدلکُہَا بِالتُّرَابِ ثُمَّ یَغْسِلُہَا ، ثُمَّ یُفِیضُ عَلَیْہِ الْمَائَ۔",": Sahih","Musannaf Ibn Abi Shaybah 693","","","كتاب الطهارة"
"694","(۶۹۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، قَالَ : سَأَلْتُ عَبْدَ الرَّحْمَنِ بْنَ أَبِی لَیْلَی عَنِ الْغُسْلِ مِنَ الْجَنَابَۃِ؟ فَقَالَ : تَغْسِلُ کَفَّیْک ، ثُمَّ تُفْرِغُ بِیَمِینِکَ عَلَی شِمَالِکَ ، ثُمَّ تَغْسِلُ فَرْجَک ، ثُمَّ تَغْسِلُ یَدَیْک ، ثُمَّ تَوَضَّأُ وُضُوئَک لِلصَّلاَۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 694","","","كتاب الطهارة"
"695","(۶۹۵) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الْعَوَّامِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ؛ أَنَّہُ کَانَ یَقُولُ فِی الْجُنُبِ : یَبْدَأُ فَیَغْسِلُ یَدَہُ الْیُمْنَی ، ثُمَّ یُفْرِغُ بِہَا عَلَی یَدِہِ الْیُسْرَی ، وَیَغْسِلُ فَرْجَہُ ، وَمَا أَصَابَ مِنْہُ ، ثُمَّ یُدَلِّکُ یَدَہُ بِالْجِدَارِ ، ثُمَّ یَتَوَضَّأُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 695","","","كتاب الطهارة"
"696","(۶۹۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ : الطُّہْرُ قَبْلَ الْغُسْلِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 696","","","كتاب الطهارة"
"697","(۶۹۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی الْغُسْلِ مِنَ الْجَنَابَۃِ : إذَا غَسَلْت یَدَیْک فَابْدَأْ بِأَیَّۃِ۔۔ شِئْتَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 697","","","كتاب الطهارة"
"698","(۶۹۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ کَانَ لاَ یَرَی الْوُضُوئَ فِی الْغُسْلِ مِنَ الْجَنَابَۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 698","","","كتاب الطهارة"
"699","(۶۹۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ طَارِقٍ ، عَنْ عَاصِمِ بْنِ عُمَرَ ، قَالَ : خَرَجَ نَفَرٌ مِنْ أَہْلِ الْعِرَاقِ إلَی عُمَرَ فَسَأَلُوہُ عَنْ غُسْلِ الْجَنَابَۃِ ؟ فَقَالَ : سَأَلْتُُمُونِی عَنْ خِصَالٍ مَا سَأَلَنِی عَنْہَا أَحَدٌ مُنْذُ سَأَلْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ غَیْرُکُمْ ! أَمَّا غُسْلُ الْجَنَابَۃِ فَتَوَضَّأَ وُضُوئَکَ لِلصَّلاَۃِ۔ (سعید بن منصور ۲۱۴۳)",": Da'if","Musannaf Ibn Abi Shaybah 699","","","كتاب الطهارة"
"700","(۷۰۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سُلَیْمَانَ بْنِ صُرَدٍ ، عَنْ جُبَیْرِ بْنِ مُطْعِمٍ ، قَالَ : تَمَارَوْا فِی الْغُسْلِ عِنْدَ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ بَعْضُ الْقَوْمِ : أَمَّا أَنَا فَأَغْسِلُ رَأْسِی کَذَا وَکَذَا ، فَقَالَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : أَمَّا أَنَا فَأُفِیضُ عَلَی رَأْسِی ثَلاَثَۃَ أَکُفٍّ۔ (مسلم ۲۵۸۔ نسائی ۲۴۷)",": Sahih","Musannaf Ibn Abi Shaybah 700","","","كتاب الطهارة"
"701","(۷۰۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : سَأَلَہُ رَجُلٌ : کَمْ أُفِیضُ عَلَی رَأْسِی وَأَنَا جُنُبٌ ؟ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَحْثُو عَلَی رَأْسِہِ ثَلاَثَ حَثَیَاتٍ ، فَقَالَ : الرَّجُلُ : إنَّ شَعْرِی طَوِیلٌ ، فَقَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ أَکْثَرَ شَعْرًا مِنْک وَأَطْیَبَ۔ (ابن ماجہ ۵۷۸)",": Da'if","Musannaf Ibn Abi Shaybah 701","","","كتاب الطهارة"
"702","(۷۰۲) حَدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، إِنَّا فِی أَرْضٍ بَارِدَۃٍ فَکَیْفَ الْغُسْلُ مِنَ الْجَنَابَۃِ ؟ فَقَالَ : أَمَّا أَنَا فَأَحْفِنُ عَلَی رَأْسِی الْمَائَ ثَلاَثًا۔ (بخاری ۲۵۵۔ نسائی ۲۳۳)",": Sahih","Musannaf Ibn Abi Shaybah 702","","","كتاب الطهارة"
"703","(۷۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ اغْتَسَلَ مِنَ الْجَنَابَۃِ ، وَصَبَّ عَلَی رَأْسِہِ الْمَائَ ثَلاَثًا۔",": Sahih","Musannaf Ibn Abi Shaybah 703","","","كتاب الطهارة"
"704","(۷۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ بُکَیْرِ بْنِ الأَخْنَسِ ، عَنِ الْمَعْرُورِ بْنِ سُوَیْد ، قَالَ : قَالَ عُمَرُ : أَمَّا أَنَا فَأُفِیضُ عَلَی رَأْسِی ثَلاَثًا۔",": Sahih","Musannaf Ibn Abi Shaybah 704","","","كتاب الطهارة"
"705","(۷۰۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، سَمِعَ ابْنَ عَبَّاسٍ یَقُولُ : الْجُنُبُ یَغْرِفُ عَلَی رَأْسِہِ ثَلاَثًا۔",": Sahih","Musannaf Ibn Abi Shaybah 705","","","كتاب الطهارة"
"706","(۷۰۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ جَابِرٍ ، قَالَ : یَغْرِفُ عَلَی رَأْسِہِ ثَلاَثًا۔",": Sahih","Musannaf Ibn Abi Shaybah 706","","","كتاب الطهارة"
"707","(۷۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَانَ یَغْسِلُ رَأْسَہُ مَرَّتَیْنِ مِنَ الْجَنَابَۃِ۔",": Da'if","Musannaf Ibn Abi Shaybah 707","","","كتاب الطهارة"
"708","(۷۰۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّ نَبِیَّ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لَہُ أُنَاسٌ مِنْ أَہْلِ الطَّائِفِ : إنَّ أَرْضَنَا بَارِدَۃٌ ، فَمَا یُجْزِئُ عَنَّا مِنَ الْغُسْلِ ؟ قَالَ : أَمَّا أَنَا فَأَحْفِنُ عَلَی رَأْسِی ثَلاَثَ حَفَنَاتٍ۔","","Musannaf Ibn Abi Shaybah 708","","","كتاب الطهارة"
"709","(۷۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی مَکِینٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أُمِّ ہَانِیئٍ ، قَالَتْ : إذَا اغْتَسَلْت مِنَ الْجَنَابَۃِ ، فَاغْسِلْ کُلَّ عُضْوٍ مِنْک ثَلاَثًا۔",": Da'if","Musannaf Ibn Abi Shaybah 709","","","كتاب الطهارة"
"710","(۷۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ فُضَیْلٍ ، عَنْ مَرْزُوقٍ ، عَنْ عَطِیَّۃَ ، عَنْ أَبِی سَعِیدٍ ، أَنَّ رَجُلاً سَأَلَہُ ، فَقَالَ : اغْسِلْ ثَلاَثًا، فَقَالَ : إنَّ شَعْرِی کَثِیرٌ ، فَقَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ أَکْثَرَ شَعْرًا مِنْک وَأَطْیَبَ۔\n(احمد ۳/۵۴۔ ابن ماجہ ۵۷۶)",": Da'if","Musannaf Ibn Abi Shaybah 710","","","كتاب الطهارة"
"711","(۷۱۱) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَبِی رَیْحَانَۃَ ، عَنْ سَفِینَۃَ صَاحِبِ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: کَانَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَغْتَسِلُ بِالصَّاعِ ، وَیَتَطَہَّرُ بِالْمُدِّ۔ (مسلم ۲۵۸۔ ابن ماجہ ۲۶۷)",": Sahih","Musannaf Ibn Abi Shaybah 711","","","كتاب الطهارة"
"712","(۷۱۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَغْتَسِلُ مِنَ الْفَرْقِ ، وَہُوَ الْقَدَحُ۔ (ابن ماجہ ۳۷۶۔ ابن راھویہ ۵۵۷)",": Sahih","Musannaf Ibn Abi Shaybah 712","","","كتاب الطهارة"
"713","(۷۱۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنْ جَابِرٍ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : یُجْزِئُ مِنَ الْوُضُوئِ الْمُدُّ ، وَمِنَ الْجَنَابَۃِ الصَّاعُ ، فَقَالَ رَجُلٌ : مَا یَکْفِینَا یَا جَابِرُ ، فَقَالَ : قَدْ کَفَی مَنْ ہُوَ خَیْرٌ مِنْک وَأَکْثَرُ شَعْرًا۔",": Da'if","Musannaf Ibn Abi Shaybah 713","","","كتاب الطهارة"
"714","(۷۱۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّ رَجُلاً حَدَّثَہُمْ ، قَالَ : دَخَلْتُ عَلَی عَائِشَۃَ ، فَقُلْتُ : یَا أُمَّ الْمُؤْمِنِینَ ، مَا کَانَ یَقْضِی عَنْ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ غُسْلَہُ ؟ قَالَ : فَدَعَتْ بِإِنَائٍ حَزَرْتُہُ صَاعًا مِنْ صَاعِکُمْ ہَذَا۔",": Da'if","Musannaf Ibn Abi Shaybah 714","","","كتاب الطهارة"
"715","(۷۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنِ ابْنِ جَبْرٍ ، عَنْ أَنَسٍ ، قَالَ : تَتَوَضَّأُ بِالْمُدِّ ، وتَغْتَسِلُ بِالصَّاعِ إِلَی خَمْسَۃِ أَمْدَادٍ۔ (بخاری ۲۰۱)",": Sahih","Musannaf Ibn Abi Shaybah 715","","","كتاب الطهارة"
"716","(۷۱۶) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ أَبِی خَالِدٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : سُئِلَ جَابِرٌ ، عَنْ غُسْلِ الْجَنَابَۃِ ؟ فَقَالَ : صَاعٌ ، فَقَالَ : مَا أَرَی یَکْفِینِی ؟ فَقَالَ جَابِرٌ : بَلَی۔",": Sahih","Musannaf Ibn Abi Shaybah 716","","","كتاب الطهارة"
"717","(۷۱۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، سَمِعَ ابْنَ عَبَّاسٍ یَقُولُ : یُجْزِیئُ الصَّاعُ لِلْجُنُبِ ، فَقَالَ عُبَیْدُ اللہِ : لاَ أَدْرِی قَبْلَ الْوُضُوئِ ، أَوْ بَعْدَہُ ؟",": Sahih","Musannaf Ibn Abi Shaybah 717","","","كتاب الطهارة"
"718","(۷۱۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنِ الْحَجَّاجِ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَتَوَضَّأُ بِمُدٍّ مِنْ مَائٍ ، وَیَغْتَسِلُ بِصَاعٍ۔","","Musannaf Ibn Abi Shaybah 718","","","كتاب الطهارة"
"719","(۷۱۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ حَجَّاجٍ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ صَفِیَّۃَ ابْنَۃِ شَیْبَۃَ ، عَنْ عَائِشَۃَ ، بِمِثْلِہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 719","","","كتاب الطهارة"
"720","(۷۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَطِیَّۃَ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ تَوَضَّأَ مِنْ کُوزٍ وَأَفْضَلَ فِیہِ ، قُلْتُ : یَکُونُ مُدًّا ؟ قَالَ : وَأَفْضَلَ۔",": Da'if","Musannaf Ibn Abi Shaybah 720","","","كتاب الطهارة"
"721","(۷۲۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانُوا یَرَوْنَ مُدًّا لِلْوُضُوئِ ، وَلِلْغُسْلِ صَاعًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 721","","","كتاب الطهارة"
"722","(۷۲۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ : یَکْفِی الرَّجُلَ لِغُسْلِہِ رُبُعُ الْفَرْقِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 722","","","كتاب الطهارة"
"723","(۷۲۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، قَالَ : کَانَ یُقَالُ : مِنَ الْوُضُوئِ إسْرَافٌ ، وَلَوْ کُنْتَ عَلَی شَاطِیئِ نَہَرٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 723","","","كتاب الطهارة"
"724","(۷۲۴) حَدَّثَنَا قَطَنُ بْنُ عَبْدِ اللہِ أَبُو مُرَیٍّ ، عَنْ أَبِی غَالِبٍ ، قَالَ : رَأَیْتُ أَبَا أُمَامَۃَ تَوَضَّأَ بِکُوزٍ مِنْ مَائٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 724","","","كتاب الطهارة"
"725","(۷۲۵) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ سِمَاکٍ ، قَالَ : رَأَیْتُ جَابِرَ بْنَ سَمُرَۃَ أُتِیَ بِکُوزٍ مِنْ مَائٍ فَتَوَضَّأَ وَمَسَحَ عَلَی خُفَّیْہِ ، ثُمَّ صَلَّی الْعَصْرَ ، وَأَنَا أَنْظُرُ۔",": Sahih","Musannaf Ibn Abi Shaybah 725","","","كتاب الطهارة"
"726","(۷۲۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ خَالِدِ بْنِ دِینَارٍ ، قَالَ : رَأَیْتُ سَالِمًا یَتَوَضَّأُ وُضُوئًا خَفِیفًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 726","","","كتاب الطهارة"
"727","(۷۲۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مِسْعَرٍ ، قَالَ : رَأَیْتُ عَمْرَو بْنَ مُرَّۃَ تَوَضَّأَ فَمَا سَالَ الْمَائُ ، یَعْنِی : مِنْ قِلَّتہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 727","","","كتاب الطهارة"
"728","(۷۲۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ،وَوَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنِ الأَسْوَدِ ، قَالَ : کَانَ لَہُ قَعْبٌ یَتَوَضَّأُ بِہِ ، زَادَ أَبُو مُعَاوِیَۃَ : قَدْرَ رَیِّ الرَّجُلِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 728","","","كتاب الطهارة"
"729","(۷۲۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ الْعَوَّامِ، عَنْ أَبِی الْہُذَیْلِ؛ أَنَّہُ رَأَی جَارًا لَہُ یَتَوَضَّأُ ، فَقَالَ: اقْصِدْ فِی الْوُضُوئِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 729","","","كتاب الطهارة"
"730","(۷۳۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْعَوَّامِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : أَوَّلُ مَا یَبْدَأُ الْوَسْوَاسُ مِنَ الْوُضُوئِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 730","","","كتاب الطهارة"
"731","(۷۳۱) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا الْعَوَّامُ ، عَمَّنْ أَخْبَرَہُ عَنْ أَبِی الدَّرْدَائِ ، قَالَ : اقْصِدْ فِی الْوُضُوئِ ، وَلَوْ کُنْتَ عَلَی شَاطِیئِ نَہَرٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 731","","","كتاب الطهارة"
"732","(۷۳۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، قَالَ : إنِّی لاَتَوَضَّأُ بِکُوزٍ مِن الْحُبِّ مَرَّتَیْنِ ، یَعْنِی : بِنِصْفِ الْکُوزِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 732","","","كتاب الطهارة"
"733","(۷۳۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَقُولُونَ : کَثْرَۃُ الْوُضُوئِ مِنَ الشَّیْطَانِ۔\n(ابن خزیمۃ ۱۲۲۔ طیالسی ۵۴۷)",": No Data Available","Musannaf Ibn Abi Shaybah 733","","","كتاب الطهارة"
"734","(۷۳۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَلْطِمُوا وُجُوہَہُمْ بِالْمَائِ لَطْمًا ، وَکَانُوا یَمْسَحُونَہَا قَلِیلاً قَلِیلاً۔",": No Data Available","Musannaf Ibn Abi Shaybah 734","","","كتاب الطهارة"
"735","(۷۳۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا الْتَقَی الْمَائَانِ فَقَدْ تَمَّ الْوُضُوئُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 735","","","كتاب الطهارة"
"736","(۷۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ خَالِدِ بْنِ زَیْدٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ یَتَوَضَّأُ فَکَانَ یَسُنُّ الْمَائَ عَلَی وَجْہِہِ سَنًّا۔",": Hasan","Musannaf Ibn Abi Shaybah 736","","","كتاب الطهارة"
"737","(۷۳۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : الْمَائُ عَلَی أَثَرِ الْمَائِ یُجْزِئُ ، وَلَیْسَ بَعْدَ الثَّلاَثِ شَیْئٌ۔",": Da'if","Musannaf Ibn Abi Shaybah 737","","","كتاب الطهارة"
"738","(۷۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سَوَادَۃَ بْنِ أَبِی الأَسْوَدِ ، عَنِ الْحَسَنِ ؛ أَنَّہُ تَوَضَّأَ بِکُوزٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 738","","","كتاب الطهارة"
"739","(۷۳۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی حَفْصٍ ، عَنِ السُّدِّیِّ ، عَنِ الْبَہِیِّ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ تَوَضَّأَ بِکُوزٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 739","","","كتاب الطهارة"
"740","(۷۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ اللہِ بْنِ عِیسَی ، عَنِ ابْنِ جَبْرٍ ، عَنْ أَنَسٍ ، أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ تَوَضَّأَ بِرِطْلَیْنِ مِنْ مَائٍ۔ (احمد ۳/۱۷۹۔ ابوداؤد ۹۶)",": Shadh","Musannaf Ibn Abi Shaybah 740","","","كتاب الطهارة"
"741","(۷۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : سَنَّ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ الاِسْتِنْشَاقَ فِی الْجَنَابَۃِ ثَلاَثًا۔ (دار قطنی ۱۱۵)","","Musannaf Ibn Abi Shaybah 741","","","كتاب الطهارة"
"742","(۷۴۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ فُضَیْلِ بْنِ عَمْرٍو ، قَالَ : قَالَ عُمَرُ : إذَا اغْتَسَلْت مِنَ الْجَنَابَۃِ فَتَمَضْمَضْ ثَلاَثًا ، فَإِنَّہُ أَبْلَغُ۔",": Da'if","Musannaf Ibn Abi Shaybah 742","","","كتاب الطهارة"
"743","(۷۴۳) حَدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ ، عَنِ الزُّبَیْرِ بْنِ عَبْدِ اللہِ بْنِ رُہَیْمَۃَ ، قَالَ : حدَّثَتْنِی جَدَّتِی ؛ أَنَّ عُثْمَانَ کَانَ إذَا اغْتَسَلَ مِنَ الْجَنَابَۃِ یَشُوصُ فَاہُ بِإِصْبَعِہِ ، ثَلاَثَ مَرَّاتٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 743","","","كتاب الطهارة"
"744","(۷۴۴) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ أَبَانَ الْعَطَّارِ ، عَنْ قَتَادَۃَ ، عَنْ حَسَّانَ بْنِ بِلاَلٍ ، قَالَ : الاِسْتِنْشَاقُ مِنَ الْبَوْلِ مَرَّۃً ، وَمِنَ الْغَائِطِ مَرَّتَیْنِ ، وَمِنَ الْجَنَابَۃِ ثَلاَثًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 744","","","كتاب الطهارة"
"745","(۷۴۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، قَالَ : حَدَّثَنَا عَطَائُ بْنُ السَّائِبِ ، قَالَ : حَدَّثَنِی أَبُو سَلَمَۃَ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ : حَدَّثَتْنِی عَائِشَۃُ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا اغْتَسَلَ مِنَ الْجَنَابَۃِ ، مَضْمَضَ وَاسْتَنْشَقَ ثَلاَثًا۔",": Sahih","Musannaf Ibn Abi Shaybah 745","","","كتاب الطهارة"
"746","(۷۴۶) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ سَالِمٍ ، عَنْ قَتَادَۃَ ، قَالَ : کَانَ یَقُولُ : تَمَضْمَضْ مِنَ الْجَنَابَۃِ ثَلاَثًا ، وَمِنَ الْغَائِطِ مَرَّتَیْنِ ، وَمِنَ الْبَوْلِ مَرَّۃً۔",": No Data Available","Musannaf Ibn Abi Shaybah 746","","","كتاب الطهارة"
"747","(۷۴۷) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ شَیْبَانَ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ أَنْ یَسْتَنْشِقُوا مِنَ الْجَنَابَۃِ ثَلاَثًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 747","","","كتاب الطهارة"
"748","(۷۴۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ الأَحْوَلِ ، عَنْ غُنَیْمِ بْنِ قَیْسٍ ، عَنِ ابْنِ عُمَرَ قَالَ : سُئِلَ عَنِ الْوُضُوئِ بَعْدَ الْغُسْلِ ؟ فَقَالَ : وَأَیُّ وُضُوئٍ أَعَمُّ مِنَ الْغُسْلِ ؟!",": Sahih","Musannaf Ibn Abi Shaybah 748","","","كتاب الطهارة"
"749","(۷۴۹) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ لاَ یَتَوَضَّأُ بَعْدَ الْغُسْلِ مِنَ الْجَنَابَۃِ۔ (ابن ماجہ ۵۷۹۔ احمد ۶/۲۵۸)",": Hasan","Musannaf Ibn Abi Shaybah 749","","","كتاب الطهارة"
"750","(۷۵۰) حَدَّثَنَا أَبُو الأَحْوَصِِ سَلاَّمٌ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : قَالَ رَجُلٌ مِنَ الْحَیِّ لاِبْنِ عُمَرَ : إنِّی أَتَوَضَّأُ بَعْدَ الْغُسْلِ ، قَالَ : لَقَدْ تَعَمَّقْت۔",": Da'if","Musannaf Ibn Abi Shaybah 750","","","كتاب الطهارة"
"751","(۷۵۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : جَائَ رَجُلٌ إلَی عَلْقَمَۃَ فَقَالَ لَہُ : إنَّ بِنْتَ أَخِیک تَوَضَّأَتْ بَعْدَ الْغُسْلِ ، فَقَالَ : أَمَا إِنَّہَا لَوْ کَانَتْ عِنْدَنَا لَمْ تَفْعَلْ ذَلِکَ ، وَأَیُّ وُضُوئٍ أَعَمُّ مِنَ الْغُسْلِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 751","","","كتاب الطهارة"
"752","(۷۵۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : وَأَیُّ وُضُوئٍ أَعَمُّ مِنَ الْغُسْلِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 752","","","كتاب الطهارة"
"753","(۷۵۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ الْمُہَلَّبِ بْنِ أَبِی حَبِیبَۃَ ، سُئِلَ جَابِرُ بْنُ زَیْدٍ عَنْ رَجُلٍ اغْتَسَلَ مِنَ الْجَنَابَۃِ ، فَتَوَضَّأَ وُضُوئَہُ لِلصَّلاَۃِ ، فَخَرَجَ مِنْ مُغْتَسَلِہِ ، أَیَتَوَضَّأُ ؟ قَالَ : لاَ ، یُجْزِئُہُ أَنْ یَغْسِلَ قَدَمَیْہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 753","","","كتاب الطهارة"
"754","(۷۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مُعَاذِ بْنِ الْعَلاَئِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ، قَالَ: سَأَلْتُہ عَنِ الْوُضُوئِ بَعْدَ الْغُسْلِ مِنَ الْجَنَابَۃِ؟ فَکَرِہَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 754","","","كتاب الطهارة"
"755","(۷۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ عِکْرِمَۃَ ؛ فِی الرَّجُلِ یَغْتَسِلُ مِنَ الْجَنَابَۃِ ، وَتَحْضُرُہُ الصَّلاَۃُ ، أَیَتَوَضَّأُ ؟ قَالَ : لاَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 755","","","كتاب الطهارة"
"756","(۷۵۶) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ طَلْحَۃَ ، عَنْ إِبْرَاہِیمَ ، عَن حُذَیْفَۃَ ، قَالَ : أَمَا یَکْفِی أَحَدُکُمْ أَنْ یَغْسِلَ مِنْ لَدُنْ قَرْنِہِ إلَی قَدَمِہِ ، حَتَّی یَتَوَضَّأ !",": Da'if","Musannaf Ibn Abi Shaybah 756","","","كتاب الطهارة"
"757","(۷۵۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ : الطّہر قَبْلَ الْغُسْلِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 757","","","كتاب الطهارة"
"758","(۷۵۸) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : قَالَ رَجُلٌ لِعَبْدِ اللہِ : إنَّ فُلاَنَۃً تَوَضَّأَتْ بَعْدَ الْغُسْلِ ، قَالَ : لَوْ کَانَتْ عِنْدِی لَمْ تَفْعَلْ ذَلِکَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 758","","","كتاب الطهارة"
"759","(۷۵۹) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی الْبَخْتَرِیِّ ؛ أَنَّ عَلِیًّا کَانَ یَتَوَضَّأُ بَعْدَ الْغُسْلِ۔",": Da'if","Musannaf Ibn Abi Shaybah 759","","","كتاب الطهارة"
"760","(۷۶۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا الأَعْمَشُ ، عَنْ سَالِمٍ ، عَنْ کُرَیْبٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ مَیْمُونَۃَ ؛ أَنَّ النَّبِیََ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ اغْتَسَلَ ، ثُمَّ تَنَحَّی فَغَسَلَ قَدَمَیْہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 760","","","كتاب الطهارة"
"761","(۷۶۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ مُسْلِمِ بْنِ یَسَارٍ ، عَنْ حُمْرَانَ ؛ أَنَّ عُثْمَانَ کَانَ إذَا اغْتَسَلَ مَنَ الْجَنَابَۃِ ، فَخَرَجَ مِنْ مُغْتَسَلِہِ غَسَلَ بُطُونَ قَدَمَیْہِ ، قَالَ : وَقَالَ مُسْلِمٌ : مَا أُبَالِی أَنْ أَخْرُج مِنْ مُغْتَسَلِی إلَی مُصَلاَّی۔",": Da'if","Musannaf Ibn Abi Shaybah 761","","","كتاب الطهارة"
"762","(۷۶۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ مُسْلِمُ بْنُ یَسَارٍ : مَا أُبَالِی أَنْ أَغْتَسِلَ مِنَ الْجَنَابَۃِ فِی مَکَان نَظِیفٍ ، ثُمَّ أَخْرُجُ إلَی مَسْجِدِی۔",": No Data Available","Musannaf Ibn Abi Shaybah 762","","","كتاب الطهارة"
"763","(۷۶۳) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا کَانَ الْمَکَانُ الَّذِی یُغْتَسَلُ فِیہِ مِنَ الْجَنَابَۃِ یَسْتَنْقِعُ فِیہِ الْمَائُ ، فَلْیَغْسِلْ قَدَمَیْہِ إذَا فَرَغَ ، وَإِنْ کَانَ نَظِیفًا فَلاَ یَغْسِلْہُمَا إِنْ شَائَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 763","","","كتاب الطهارة"
"764","(۷۶۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : سَأَلَ رَجُلٌ سَعِیدَ بْنَ الْمُسَیَّبِ : أَرَأَیْت إذَا اغْتَسَلْت ، أَیَکْفِینِی الْغُسْلُ مِنَ الْجَنَابَۃِ مِنَ الْوُضُوئِ ؟ قَالَ : نَعَمْ ، وَلَکِنِ اغْسِلْ قَدَمَیْک۔",": No Data Available","Musannaf Ibn Abi Shaybah 764","","","كتاب الطهارة"
"765","(۷۶۵) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ مُحَمَّدٍ ، قَالَ : إذَا خَرَجْت فَاغْسِلْ قَدَمَیْک۔",": No Data Available","Musannaf Ibn Abi Shaybah 765","","","كتاب الطهارة"
"766","(۷۶۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قُلْتُ لِلْحَسَنِ ، أَوْ مُجَاہِدٍ : کَیْفَ تَصْنَعُ بِرِجْلَیْک فِی الْغُسْلِ مِنَ الْجَنَابَۃِ ؟ قَالَ : أَمَّا أَنَا فَأَقُولُ ہَکَذَا ، فَوَصَفَ ابْنُ عَوْنٍ أَنَّہُ یَصُبُّ الْمَائَ عَلَی ظہورِ قَدَمَیْہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 766","","","كتاب الطهارة"
"767","(۷۶۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الْعَوَّامُ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ؛ أَنَّہُ کَانَ یَقُولُ فِی الْجُنُبِ إذَا فَرَغَ : فَلْیَغْسِلْ قَدَمَیْہِ إذَا خَرَجَ مِنْ مُغْتَسَلِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 767","","","كتاب الطهارة"
"768","(۷۶۸) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ مُعَاذِ بْنِ الْعَلاَئِ ، قَالَ : سَأَلْنَا سَعِیدَ بْنَ جُبَیْرٍ ، فَقَالَ : إِنْ کَانَ فِی مَکَانِہِ شَیْئٌ غَسَلَ رِجْلَیْہِ ، وَإِلاَّ فَلاَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 768","","","كتاب الطهارة"
"769","(۷۶۹) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا تَوَضَّأْت فِی مُغْتَسَلٍ یُبَالُ فِیہِ ، فَاغْسِلْ رِجْلَیْک إذَا خَرَجْت۔",": No Data Available","Musannaf Ibn Abi Shaybah 769","","","كتاب الطهارة"
"770","(۷۷۰) حَدَّثَنَا یَعْقُوبُ بْنِ إِبْرَاہِیمَ ، عَن مُطَرِّفٍ ، عَنْ أَبِی جَعْفَرٍ الأَشْجَعِیِّ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنِ الْغُسْلِ مِنَ الْجَنَابَۃِ ؟ فَقَالَ : أَفِضْ عَلَیْک ، ثُمَّ تَنَحَّ فَاغْسِلْ رِجْلَیْک۔",": Da'if","Musannaf Ibn Abi Shaybah 770","","","كتاب الطهارة"
"771","(۷۷۱) حَدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَنِ الْمُسْتَمِرِّ بْنِ الرَّیَّانِ ، عَنْ أَبِی الْجَوْزَائِ ، قَالَ : إذَا اغْتَسَلَ الرَّجُلُ فِی الْمُغْتَسَلِ فَکَانَ نَظِیفًا لَمْ یَغْسِلْ رِجْلَیْہِ ، وَإِنْ لَمْ یَکُنْ نَظِیفًا غَسَلَ رِجْلَیْہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 771","","","كتاب الطهارة"
"772","(۷۷۲) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یُفَرِّقَ غُسْلَہُ مِنَ الْجَنَابَۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 772","","","كتاب الطهارة"
"773","(۷۷۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی حُرَّۃَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَغْسِلَ الْجُنُبُ رَأْسَہُ قَبْلَ جَسَدِہِ ، أَوْ جَسَدَہُ قَبْلَ رَأْسِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 773","","","كتاب الطهارة"
"774","(۷۷۴) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ؛ أَنَّ رَجُلاً مِنْ أَہْلِہِ اغْتَسَلَ مِنَ الْجَنَابَۃِ وَنَسِیَ أَنْ یَغْسِلَ رَأْسَہُ ، قَالَ : فَأَمَرَنِی أَنْ أَسْأَلَ سَعِیدَ بْنَ الْمُسَیَّبِ عَنْ ذَلِکَ ، فَسَأَلْـتُہُ ، فَقَالَ : فَلْیَرْجِعْ فَلْیَغْسِلْ رَأْسَہُ، قَالَ : فَذَہَبْت فَسَکَبْت عَلَیْہِ مِنَ الْوَضُوئِ حَتَّی غَسَلَ رَأْسَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 774","","","كتاب الطهارة"
"775","(۷۷۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ إسْمَاعِیلَ ، عَنِ الزُّہْرِیِّ ، قَالَ : کَانَ أَبُو سَلَمَۃَ بْنُ عَبْدِ الرَّحْمَنِ یَسْتَسِرُّ عَلَی أَہْلِہِ ، فَیَکْرَہُ أَنْ یَعْلَمُوا بِہِ ، وَکَانَ یَغْسِلُ جَسَدَہُ إلَی حَلْقِہِ ، وَیَکْرَہُ أَنْ یَغْسِلَ رَأْسَہُ فَیَعْلَمُوا بِہِ ، فَیَأْتِی أَہْلَہُ فَیَقُولُ : إنِّی لاَجِدُ فِی رَأْسِی ، فَیَدْعُو بِالْخِطْمِیِّ فَیَغْسِلُہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 775","","","كتاب الطهارة"
"776","(۷۷۶) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ بْنِ الأَزْمَعِ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ غَسَلَ رَأْسَہُ بِالْخِطْمِیِّ وَہُوَ جُنُبٌ ، فَقَدْ أَبْلَغَ الْغُسْلَ۔",": Da'if","Musannaf Ibn Abi Shaybah 776","","","كتاب الطهارة"
"777","(۷۷۷) حَدَّثَنَا یَعْقُوبُ بْنُ إبْرَاہِیمَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، مِثْلَہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 777","","","كتاب الطهارة"
"778","(۷۷۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : مَنْ غَسَلَ رَأْسَہُ بِغِسْلٍ وَہُوَ جُنُبٌ ، فَقَدْ أَبْلَغَ الْغُسْلَ۔",": Da'if","Musannaf Ibn Abi Shaybah 778","","","كتاب الطهارة"
"779","(۷۷۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ بْنِ الأَزْمَعِ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ یَقُولُ : مَنْ غَسَلَ رَأْسَہُ بِالْخِطْمِیِّ وَہُوَ جُنُبٌ ، فَقَدْ أَبْلَغَ الْغُسْلَ ۔ وَقَالَ : الْحَارِثُ : وَلَکِنْ لاَ یُعِیدُ مَا سَالَ مِنَ الْخِطْمِیِّ عَلَی رَأْسِہِ أَیْضًا۔ (بخاری ۲۵۱۹)",": Da'if","Musannaf Ibn Abi Shaybah 779","","","كتاب الطهارة"
"780","(۷۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی نَوْفَلِ بْنِ أَبِی عَقْرَبَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یُجْزِئُہُ أَنْ لاَ یُعِیدَ عَلَی رَأْسِہِ الْغُسْلَ۔",": Sahih","Musannaf Ibn Abi Shaybah 780","","","كتاب الطهارة"
"781","(۷۸۱) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ إذَا غَسَلَ الْجُنُبُ رَأْسَہُ بِالْخِطْمِیِّ أَجْزَأَہُ ذَلِکَ ، قَالَ : وَقَالَ إبْرَاہِیمُ مِثْلَ ذَلِکَ ، أَوْ قَالَ : لاَ یُعِیدُ عَلَیْہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 781","","","كتاب الطهارة"
"782","(۷۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ سَالِمٍ ۔ وَحَفْصٍ ، عَنِ الأَعْمَشِ ، عَنْ سَالِمٍ ، عَنْ سَارِیَۃَ ، وَلَمْ یَذْکُرْ سُفْیَانُ سَارِیَۃَ ، قَالَ : سُئِلَ عَبْدُ اللہِ عَنِ الْجُنُبِ ، یَغْسِلُ رَأْسَہُ بِالْخِطْمِیِّ ؟ فَقَالَ : یُجْزِئُہُ إذَا غَسَلَ أَنْ لاَ یُعِیدَ عَلَی رَأْسِہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 782","","","كتاب الطهارة"
"783","(۷۸۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورِ بْنِ صَفِیَّۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ فِی الْجُنُبِ یَغْسِلُ رَأْسَہُ بِالسِّدْرِ ، قَالَ : لاَ یَغْسِلُ رَأْسَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 783","","","كتاب الطهارة"
"784","(۷۸۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِی سَلَمَۃَ ؛ فِی الْجُنُبِ یَغْسِلُ رَأْسَہُ بِالْخِطْمِیِّ ، قَالَ : یُجْزِئُہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 784","","","كتاب الطهارة"
"785","(۷۸۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ مُحَرَّرِ بْنِ قَعْنَبٍ ، عَنِ الضَّحَّاکِ ، بِنَحْوٍ مِنْہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 785","","","كتاب الطهارة"
"786","(۷۸۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ طَلْحَۃَ الْیَامِیِّ ؛ أَنَّہُ کَانَ یَغْتَسِلُ مِنَ الْجَنَابَۃِ فِی الْبَیْتِ الَّذِی کَانَ یَکُونُ فِیہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 786","","","كتاب الطهارة"
"787","(۷۸۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، قَالَ : سَأَلْتُ الزُّہْرِیَّ عَنِ الرَّجُلِ تُصِیبُہُ الْجَنَابَۃُ ، وَمَعَہُ مَائٌ یَکْفِیہِ لِلْوُضُوئِ ؟ قَالَ : یَتَیَمَّمُ ۔ وَقَالَ عَبْدَۃُ بْنُ أَبِی لُبَابَۃَ : یَتَوَضَّأُ وَیَتَیَمَّمُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 787","","","كتاب الطهارة"
"788","(۷۸۸) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا أَجْنَبَ وَلَیْسَ مَعَہُ مِنَ الْمَائِ قَدْرُ مَا یَغْتَسِلُ بِہِ ، قَالَ : یَتَیَمَّمُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 788","","","كتاب الطهارة"
"789","(۷۸۹) حَدَّثَنَا حَفْصٌ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی الرَّجُلِ یَغْتَسِلُ مِنَ الْجَنَابَۃِ ، فَیَنْتَضِحُ فِی إنَائِہِ مِنْ غُسْلِہِ ، فَقَالَ : لاَ بَأْسَ بِہِ۔",": Hasan","Musannaf Ibn Abi Shaybah 789","","","كتاب الطهارة"
"790","(۷۹۰) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قُلْتُ لِمُحَمَّدٍ : أَغْتَسِلُ فَیَنْتَضِحُ فِی إنَائِی مِنْ غُسْلِی ؟ قَالَ : وَہَلْ تَجِدُ مِنْ ذَلِکَ بُدًّا ؟",": No Data Available","Musannaf Ibn Abi Shaybah 790","","","كتاب الطهارة"
"791","(۷۹۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ سُئِلَ عَنِ الرَّجُلِ یَغْتَسِلُ مِنَ الْجَنَابَۃِ فَیَقْطُرُ فِی إنَائِہِ مِنْ غُسْلِہِ ؟ قَالَ : لاَ بَأْسَ بِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 791","","","كتاب الطهارة"
"792","(۷۹۲) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، قَالَ: سُئِلَ عَنِ الرَّجُلِ یَغْتَسِلُ فَیَنْتَضِحُ فِی إنَائِہِ مِنْ غُسْلِہِ؟ قَالَ : یَقْدِرُ أَنْ یَمْتَنِعَ مِنْ ہَذَا ؟",": No Data Available","Musannaf Ibn Abi Shaybah 792","","","كتاب الطهارة"
"793","(۷۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مَعْمَرِ بْنِ مُوسَی ، عَنْ أَبِی جَعْفَرٍ ۔ وَعَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ؛ أَنَّہُ لَمْ یَرَ بَأْسًا أَنْ یَنْتَضِحَ مِنْ غُسْلِہِ فِی إنَائِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 793","","","كتاب الطهارة"
"794","(۷۹۴) حَدَّثَنَا خَالِدُ بْنُ حَیَّانَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : قُلْتُ لِلزُّہْرِیِّ : أَغْتَسِلُ مِنَ الْجَنَابَۃِ فَیَنْتَضِحُ مِنْ غُسْلِی فِی إنَائِی ؟ قَالَ : لاَ بَأْسَ بِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 794","","","كتاب الطهارة"
"795","(۷۹۵) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ الْحُسَامِ بْنِ مِصَک ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : سَأَلَ رَجُلٌ أَبَا ہُرَیْرَۃَ ، فِیہِ حَبَشِیِّۃ ، قَالَ : أَغْتَسِلُ فَیَرْجِعُ مِنْ جِسْمِی فِی إنَائِی ؟ قَالَ : لاَ بَأْسَ بِہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 795","","","كتاب الطهارة"
"796","(۷۹۶) أَخْبَرَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ یَحْیَی بْنِ عَتِیقٍ ، قَالَ : سَأَلْتُ الْحَسَنَ ، وَابْنَ سِیرِینَ عَنِ الرَّجُلِ یَغْتَسِلُ فَیَنْتَضِحُ مِنْ غُسْلِہِ فِی إنَائِہِ ؟ فَقَالَ الْحَسَنُ : وَمَنْ یَمْلِکُ انْتِشَارَ الْمَاء ؟ِ وَقَالَ ابْنُ سِیرِینَ : إنَّا لَنَرْجُو مِنْ رَحْمَۃِ رَبِّنَا مَا ہُوَ أَوْسَعُ مِنْ ہَذَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 796","","","كتاب الطهارة"
"797","(۷۹۷) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ بْنِ مُوسَی ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ رَافِعٍ ، عَنْ أُمِّ سَلَمَۃَ ، قَالَتْ : قُلْتُ : یَا رَسُولَ اللہِ ، إنِّی امْرَأَۃٌ أَشُدُّ ضَفْرَ رَأْسِی ، أَفَأَنْقُضُہُ لِغُسْلِ الْجَنَابَۃِ ؟ فَقَالَ : إنَّمَا یَکْفِیک مِنْ ذَلِکَ أَنْ تَحْثِی عَلَیْہِ ثَلاَثَ حَثَیَاتٍ مِنْ مَائٍ ، ثُمَّ تُفِیضِینَ عَلَیْک مِنَ الْمَائِ فَتَطْہُرِینَ ، أَوْ : فَإِذا أَنْتِ قَدْ طَہُرْت۔ (مسلم ۲۵۹۔ ابن ماجہ ۶۰۳)",": Sahih","Musannaf Ibn Abi Shaybah 797","","","كتاب الطهارة"
"798","(۷۹۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : بَلَغَ عَائِشَۃَ أَنَّ عَبْدَ اللہِ بْنَ عَمْرٍو یَأْمُرُ النِّسَائَ إذَا اغْتَسَلْنَ ، أَنْ یَنْقُضْنَ رُؤُوسَہُنَّ ، فَقَالَتْ : یَا عَجَبًا لابْنِ عَمْرٍو ہَذَا ، أَفَلاَ یَأْمُرُہُنَّ أَنْ یَحْلِقْنَ رُؤُوسَہُنَّ! قَدْ کُنْتُ أَنَا وَرَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ نَغْتَسِلُ مِنْ إنَائٍ وَاحِدٍ ، فَلاَ أَزِیدُ عَلَی أَنْ أُفْرِغَ عَلَی رَأْسِی ثَلاَثَ إفْرَاغَاتٍ۔ (مسلم ۲۶۰۔ ابن ماجہ ۶۰۴)",": Sahih","Musannaf Ibn Abi Shaybah 798","","","كتاب الطهارة"
"799","(۷۹۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَقُولُ : الْعَرُوسُ تَنْقُضُ شَعْرَہَا إذَا أَرَادَتْ أَنْ تَغْتَسِلَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 799","","","كتاب الطهارة"
"800","(۸۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عُثْمَانَ بْنِ مَوْہَبٍ ، عَنِ امْرَأَۃٍ شَکَتْ إلَی عَائِشَۃَ الْغُسْلَ مِنَ الْجَنَابَۃِ ، فَقَالَتْ : صُبِّی ثَلاَثًا ، فَمَا أَصَابَ أَصَابَ ، وَمَا أَخْطَأَ أَخْطَأَ۔",": Da'if","Musannaf Ibn Abi Shaybah 800","","","كتاب الطهارة"
"801","(۸۰۱) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ ہِشَامٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ؛ أَنَّ امْرَأَۃً سَأَلَتْ أُمَّ سَلَمَۃَ ، فَقَالَتْ : صُبِّی ثَلاَثًا ، فَقَالَتْ : إنَّ شَعْرِی کَثِیرٌ ، فَقَالَتْ : ضَعِی بَعْضَہُ عَلَی بَعْضٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 801","","","كتاب الطهارة"
"802","(۸۰۲) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ زَمْعَۃَ ، عَنْ سَلَمَۃَ بْنِ وَہْرَام ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ قَالَ : یُجْزِئُ الْمُمْتَشِّطَۃَ ثَلاَثٌ۔",": Da'if","Musannaf Ibn Abi Shaybah 802","","","كتاب الطهارة"
"803","(۸۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنِ الْمَقْبُرِیِّ ، عَنْ أُمِّ سَلَمَۃَ ؛ أَنَّہَا سَأَلَتِ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فَقَالَتْ : إنِّی امْرَأَۃٌ شَدِیدَۃُ ضَفْرِ الرَّأْسِ ، فَکَیْفَ أَصْنَعُ إذَا اغْتَسَلْتُ ؟ قَالَ : احْفِنِی عَلَی رَأْسِکِ ثَلاَثًا ، ثُمَّ اغْمِزِی عَلَی إِثْرِ کُلِّ حَفْنَۃٍ غَمْزَۃ۔ (ابوداؤد ۲۵۶)",": Hasan","Musannaf Ibn Abi Shaybah 803","","","كتاب الطهارة"
"804","(۸۰۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ ، وَعَطَائٍ أَنَّہُمَا قَالاَ : لاَ تُرْخِی شَعْرَہَا ، وَلَکِنْ تَصُبُّ ثَلاَثَ مَرَّاتٍ ، ثُمَّ تَفْرُکُہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 804","","","كتاب الطهارة"
"805","(۸۰۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الْمَرْأَۃِ تَغْتَسِلُ قَالَ : یُجْزِیہَا ثَلاَثُ حَفَنَاتٍ ، وَإِنْ شَائَتْ لَمْ تَنْقُضْ شَعْرَہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 805","","","كتاب الطهارة"
"806","(۸۰۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ حَمَّادًا عَنِ الْمَرْأَۃِ إذَا اغْتَسَلَتْ ؟ فَقَالَ : إِنْ کَانَتْ تَرَی أَنَّ الْمَائَ أَصَابَہُ أَجْزَأَ عَنْہَا ، وَإِنْ کَانَتْ تَرَی أَنَّ الْمَائَ لَمْ یُصِبْہُ فَلْتَنْقُضْہُ ۔ وَقَالَ : الْحَکَمُ : تَبُلُّ أُصُولَہُ وَأَطْرَافَہُ وَلاَ تَنْقُضُہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 806","","","كتاب الطهارة"
"807","(۸۰۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : الْحَائِضُ وَالْجُنُبُ یَصُبَّانِ الْمَائَ عَلَی رُؤُوسِہِمَا ، وَلاَ یَنْقُضَانِ۔",": Da'if","Musannaf Ibn Abi Shaybah 807","","","كتاب الطهارة"
"808","(۸۰۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن ہَمَّامٍ ، عَنْ حُذَیْفَۃَ ، قَالَ : قَالَ لإِمْرَأَتِہِ : خَلِّلِی رَأْسَک بِالْمَائِ ، لاَ تُخَلِّلُہُ نَارٌ قَلِیلٌ بُقْیَاہَا عَلَیْہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 808","","","كتاب الطهارة"
"809","(۸۰۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ القُردوانی ، عَنْ عَطَائٍ ، وَالزُّہْرِیِّ قَالاَ : الْغُسْلُ مِنَ الْحَیْضِ وَالْجَنَابَۃِ وَاحِدٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 809","","","كتاب الطهارة"
"810","(۸۱۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ؛ أَنَّ نِسَائَ ابْنِ عُمَرَ ، وَأُمَّہَاتِ أَوْلاَدِہِ کُنَّ یَغْتَسِلْنَ مِنَ الْجَنَابَۃِ وَالْحَیْضِ وَلاَ یَنْقُضْنَ رُؤُوسَہُنَّ ، وَلَکِنْ یُبَالِغْنَ فِی بَلِّہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 810","","","كتاب الطهارة"
"811","(۸۱۱) حَدَّثَنَا خَالِدُ بْنُ حَیَّانَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ عِکْرِمَۃَ ؛ أَنَّہُ سُئِلَ عَنِ امْرَأَۃٍ تَغْتَسِلُ مِنَ الْجَنَابَۃِ وَالْحَیْضِ؟ قَالَ: تُرْخِی الذَّوَائِبَ ، وَتَصُبُّ عَلَی رَأْسِہَا الْمَائَ حَتَّی تَبُلَّ أُصُولَ الشَّعْرِ، وَلاَ تَنْقُضُ لَہَا رَأْسًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 811","","","كتاب الطهارة"
"812","(۸۱۲) حَدَّثَنَا أَبْوُخَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ فُضَیْلٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : تُخَلِّلُہُ بِأَصَابِعِہَا ۔ وَقَالَ عَطَائٌ ، مِثْلَہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 812","","","كتاب الطهارة"
"813","(۸۱۳) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : الْجُنُبُ إذَا ارْتَمَسَ فِی الْمَائِ أَجْزَأَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 813","","","كتاب الطهارة"
"814","(۸۱۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : یُجْزِئُہُ رَمْسہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 814","","","كتاب الطهارة"
"815","(۸۱۵) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ ، قَالَ : یُجْزِئُہُ رَمْسہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 815","","","كتاب الطهارة"
"816","(۸۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مَہْدِیِّ بْنِ مَیْمُونٍ ، عَنْ شُعَیْبٍ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : یُجْزِیئُ الْجُنُبَ إذَا غَاصَ غَوْصَۃً وَلَمَسَ بِیَدَیْہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 816","","","كتاب الطهارة"
"817","(۸۱۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ مُغِیرَۃَ بْنِ مُسْلِمٍ ، قَالَ : سَأَلْتُ عِکْرِمَۃَ ، قَالَ : قُلْتُ لَہُ : الْجُنُبُ یَغْمِسُ فِی الرَّنْقِ ، یُجْزِئُہُ مِنْ غُسْلِ الْجَنَابَۃِ ؟ قَالَ : نَعَمْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 817","","","كتاب الطهارة"
"818","(۸۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الْجُنُبِ یَرْتَمِسُ فِی الْمَائِ ؟ قَالَ : یُجْزِئُہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 818","","","كتاب الطهارة"
"819","(۸۱۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ عَطَائٍ ، قَالَ : إِنْ دَخَلَ النَّہَرَ فَارْتَمَسَ فِیہِ أَجْزَأَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 819","","","كتاب الطهارة"
"820","(۸۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ سَالِمٍ ، وَعَطَائٍ ، وَعَامِرٍ قَالُوا : الْجُنُبُ إذَا ارْتَمَسَ فِی الْمَائِ رَمْسَۃً أَجْزَأَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 820","","","كتاب الطهارة"
"821","(۸۲۱) حَدَّثَنَا عَمْرٌو ، عَنِ الأَصَمِّ الْخُزَاعِیِّ ، عَنِ ابْنِ بُدَیْلِ بْنِ وَرْقَائَ ، قَالَ : سَمِعْتُ الْقَاسِمَ یَقُولُ فِی الْجُنُبِ یَغْتَمِسُ فِی الْمَائِ اغْتِمَاسَۃً ، قَالَ : إذَا تَدَلَّکَ فَقَدْ أَجْزَأَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 821","","","كتاب الطهارة"
"822","(۸۲۲) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : یُجْزِئُ الْجُنُبَ رَمْسَۃٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 822","","","كتاب الطهارة"
"823","(۸۲۳) حَدَّثَنَا ابْنُ مُبَارَکٍ ، وَابْنُ نُمَیْرٍ ، عَنْ زَکَرِیَّا ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ ، قَالَ : سُئِلَ أَبُو الضُّحَی ، أَیَأْکُلُ الْجُنُبُ ؟ قَالَ : نَعَمْ ، وَیَمْشِی فِی الأَسْوَاقِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 823","","","كتاب الطهارة"
"824","(۸۲۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ الزِّبْرِقَانِ ، عَنْ أَبِی رَزِینٍ ، قَالَ : إنِّی لاَکُونُ جُنُبًا فَأَتَوَضَّأُ ، ثُمَّ أَخْرُجُ إلَی السُّوقِ ، فَأَقْضِی حَاجَتِی۔",": No Data Available","Musannaf Ibn Abi Shaybah 824","","","كتاب الطهارة"
"825","(۸۲۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ تُصِیبُہُ الْجَنَابَۃُ ثُمَّ یُرِیدُ الْخُرُوجَ ، قَالَ : یَتَوَضَّأُ وُضُوئَہُ لِلصَّلاَۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 825","","","كتاب الطهارة"
"826","(۸۲۶) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ الْجُنُبِ یَأْتِی الْحَاجَۃَ وَیَأْتِی السُّوقَ ؟ قَالَ: یَغْسِلُ فَرْجَہُ ، وَیَتَوَضَّأُ وُضُوئَہُ لِلصَّلاَۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 826","","","كتاب الطهارة"
"827","(۸۲۷) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ ، عَنْ ہِشَامٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، مِثْلَ ذَلِکَ۔",": Da'if","Musannaf Ibn Abi Shaybah 827","","","كتاب الطهارة"
"828","(۸۲۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِیُّ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ بُکَیْرِ بْنِ الأَخْنَسِ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، عَنْ سَعْدٍ ؛ أَنَّہُ رُبَّمَا أَجْنَبَ ثُمَّ تَوَضَّأَ ، ثُمَّ خَرَجَ۔",": Sahih","Musannaf Ibn Abi Shaybah 828","","","كتاب الطهارة"
"829","(۸۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ نُسَیرٍ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ؛ أَنَّ عُمَرَ کَانَ یَسْتَدْفِیئُ بِامْرَأَتِہِ بَعْدَ الْغُسْلِ۔",": Da'if","Musannaf Ibn Abi Shaybah 829","","","كتاب الطهارة"
"830","(۸۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَطَائٍ الْخُرَاسَانِیِّ ، عَنْ أُمِّ الدَّرْدَائِ ، قَالَتْ : کَانَ أَبُو الدَّرْدَائِ یَغْتَسِلُ ، ثُمَّ یَجِیئُ وَلَہُ قَرْقَفَۃٌ یَسْتَدْفِیئُ بِی۔",": Da'if","Musannaf Ibn Abi Shaybah 830","","","كتاب الطهارة"
"831","(۸۳۱) حَدَّثَنَا حَفْصٌ ، وَوَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ جَبَلَۃَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إنِّی لاَغْتَسِلُ مِنَ الْجَنَابَۃِ ، ثُمَّ أَتَکَوَّی بِالْمَرْأَۃِ قَبْلَ أَنْ تَغْتَسِلَ۔",": Sahih","Musannaf Ibn Abi Shaybah 831","","","كتاب الطهارة"
"832","(۸۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : ذَاکَ عَیْشُ قُرَیْشٍ فِی الشِّتَائِ۔",": Hasan","Musannaf Ibn Abi Shaybah 832","","","كتاب الطهارة"
"833","(۸۳۳) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ حَجَّاجِ بْنِ أَبِی عُثْمَانَ ، قَالَ : حدَّثَنَا یَحْیَی بْنُ أَبِی کَثِیرٍ ، قَالَ : حَدَّثَنِی أَبُو کَثِیرٍ ، قَالَ : قُلْتُ لإِبِی ہُرَیْرَۃَ : الرَّجُلُ یَغْتَسِلُ مِنَ الْجَنَابَۃِ ، ثُمَّ یَضْطَجِعُ مَعَ أَہْلِہِ ؟ قَالَ : لاَ بَأْسَ۔",": Sahih","Musannaf Ibn Abi Shaybah 833","","","كتاب الطهارة"
"834","(۸۳۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ : کَانَ الأَسْوَدُ یُجْنِبُ فَیَغْتَسِلُ ، ثُمَّ یَأْتِی أَہْلَہُ فَیُضَاجِعُہَا یَسْتَدْفِیئُ بِہَا قَبْلَ أَنْ تَغْتَسِلَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 834","","","كتاب الطهارة"
"835","(۸۳۵) حَدَّثَنَا حَفْصٌ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ، قَالَ: کَانَ عَلْقَمَۃُ یَغْتَسِلُ، ثُمَّ یَسْتَدْفِیئُ بِالْمَرْأَۃِ وَہِیَ جُنُبٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 835","","","كتاب الطهارة"
"836","(۸۳۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ؛ أَنَّہُ کَانَ یَسْتَدْفِیئُ بِامْرَأَتِہِ ، ثُمَّ یَقُومُ فَیَتَوَضَّأُ وُضُوئَہُ لِلصَّلاَۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 836","","","كتاب الطهارة"
"837","(۸۳۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَانَ یَغْتَسِلُ مِنَ الْجَنَابَۃِ، ثُمَّ یَجِیئُ فَیَسْتَدْفِیئُ بِامْرَأَتِہِ قَبْلَ أَنْ تَغْتَسِلَ ، ثُمَّ یُصَلِّی وَلاَ یَمَسُّ مَائً۔",": Da'if","Musannaf Ibn Abi Shaybah 837","","","كتاب الطهارة"
"838","(۸۳۸) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا اغْتَسَلَ الْجُنُبُ ، ثُمَّ أَرَادَ أَنْ یُبَاشِرَ امْرَأَتَہُ ، فَعَلَ إِنْ شَائَ۔",": Da'if","Musannaf Ibn Abi Shaybah 838","","","كتاب الطهارة"
