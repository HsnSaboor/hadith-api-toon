hadiths[161]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3801","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي التَّمِيمِيُّ ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ، عَنْ الْأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى عَنِ الْمُلَامَسَةِ وَالْمُنَابَذَةِ """".","Sahih","Sahih Muslim 3801","","","1. باب: بیع ملامسہ اور منابذہ باطل ہے۔والد کو آزاد کرنے کی فضیلتChapter: The virtue of manumitting one's father"
"3802","وحَدَّثَنَا أَبُو كُرَيْبٍ ، وَابْنُ أَبِي عُمَرَ ، قَالَا: حَدَّثَنَا وَكِيعٌ ، عَنْ سُفْيَانَ ، عَنْ أَبِي الزِّنَادِ ، عَنْ الْأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ.","Sahih","Sahih Muslim 3802","","","1. باب: بیع ملامسہ اور منابذہ باطل ہے۔ملامسہ اور منابذہ کی بیع باطل ہے"
"3803","وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا ابْنُ نُمَيْرٍ ، وَأَبُو أُسَامَةَ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، حَدَّثَنَا أَبِي . ح وحَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا عَبْدُ الْوَهَّابِ ، كُلُّهُمْ عَنْ عُبَيْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ خُبَيْبِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ حَفْصِ بْنِ عَاصِمٍ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِهِ،","Sahih","Sahih Muslim 3803","","","1. باب: بیع ملامسہ اور منابذہ باطل ہے۔ملامسہ اور منابذہ کی بیع باطل ہے"
"3804","وحَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا يَعْقُوبُ يَعْنِي ابْنَ عَبْدِ الرَّحْمَنِ ، عَنْ سُهَيْلِ بْنِ أَبِي صَالِحٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ.","Sahih","Sahih Muslim 3804","","","1. باب: بیع ملامسہ اور منابذہ باطل ہے۔ملامسہ اور منابذہ کی بیع باطل ہے"
"3805","وحَدَّثَنِي وحَدَّثَنِي مُحَمَّدُ بْنُ رَافِعٍ ، حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا ابْنُ جُرَيْجٍ ، أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، عَنْ عَطَاءِ بْنِ مِينَاءَ ، أَنَّهُ سَمِعَهُ يُحَدِّثُ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّهُ قَالَ: "" نُهِيَ عَنْ بَيْعَتَيْنِ: الْمُلَامَسَةِ، وَالْمُنَابَذَةِ، أَمَّا الْمُلَامَسَة، فَأَنْ يَلْمِسَ كُلُّ وَاحِدٍ مِنْهُمَا ثَوْبَ صَاحِبِهِ بِغَيْرِ تَأَمُّلٍ، وَالْمُنَابَذَةُ أَنْ يَنْبِذَ كُلُّ وَاحِدٍ مِنْهُمَا ثَوْبَهُ إِلَى الْآخَرِ، وَلَمْ يَنْظُرْ وَاحِدٌ مِنْهُمَا إِلَى ثَوْبِ صَاحِبِهِ """".","Sahih","Sahih Muslim 3805","","","1. باب: بیع ملامسہ اور منابذہ باطل ہے۔ملامسہ اور منابذہ کی بیع باطل ہے"
"3806","وحَدَّثَنِي أَبُو الطَّاهِرِ ، وَحَرْمَلَةُ بْنُ يَحْيَي ، وَاللَّفْظُ لِحَرْمَلَةَ، قَالَا: أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي يُونُسُ ، عَنْ ابْنِ شِهَابٍ ، أَخْبَرَنِي عَامِرُ بْنُ سَعْدِ بْنِ أَبِي وَقَّاصٍ ، أن أبا سعيد الخدري ، قَالَ: "" نَهَانَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعَتَيْنِ، وَلِبْسَتَيْنِ، نَهَى عَنْ: الْمُلَامَسَةِ، وَالْمُنَابَذَةِ فِي الْبَيْعِ """"، وَالْمُلَامَسَةُ: لَمْسُ الرَّجُلِ ثَوْبَ الْآخَرِ بِيَدِهِ بِاللَّيْلِ، أَوْ بِالنَّهَارِ وَلَا يَقْلِبُهُ إِلَّا بِذَلِكَ، وَالْمُنَابَذَةُ أَنْ يَنْبِذَ الرَّجُلُ إِلَى الرَّجُلِ بِثَوْبِهِ، وَيَنْبِذَ الْآخَرُ إِلَيْهِ ثَوْبَهُ وَيَكُونُ ذَلِكَ بَيْعَهُمَا مِنْ غَيْرِ نَظَرٍ وَلَا تَرَاضٍ.","Sahih","Sahih Muslim 3806","","","1. باب: بیع ملامسہ اور منابذہ باطل ہے۔ملامسہ اور منابذہ کی بیع باطل ہے"
"3807","وحَدَّثَنِيهِ عَمْرٌو النَّاقِدُ ، حَدَّثَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ ، حَدَّثَنَا أَبِي ، عَنْ صَالِحٍ ، عَنْ ابْنِ شِهَابٍ ، بِهَذَا الْإِسْنَادِ.","Sahih","Sahih Muslim 3807","","","1. باب: بیع ملامسہ اور منابذہ باطل ہے۔ملامسہ اور منابذہ کی بیع باطل ہے"
"3808","وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا عَبْدُ اللَّهِ بْنُ إِدْرِيسَ ، وَيَحْيَى بْنُ سَعِيدٍ ، وَأَبُو أُسَامَةَ ، عَنْ عُبَيْدِ اللَّهِ . ح وحَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، وَاللَّفْظُ لَهُ: حَدَّثَنَا يَحْيَى بْنُ سَعِيدٍ ، عَنْ عُبَيْدِ اللَّهِ ، حَدَّثَنِي أَبُو الزِّنَادِ ، عَنْ الْأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: "" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ الْحَصَاةِ، وَعَنْ بَيْعِ الْغَرَرِ """".","Sahih","Sahih Muslim 3808","","","2. باب: کنکری کی بیع اور دھوکے کی بیع باطل ہے۔ملامسہ اور منابذہ کی بیع باطل ہے"
"3809","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، وَمُحَمَّدُ بْنُ رُمْحٍ ، قَالَا: أَخْبَرَنَا اللَّيْثُ . ح وحَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ ، عَنْ نَافِعٍ ، عَنْ عَبْدِ اللَّهِ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، أَنَّهُ: "" نَهَى عَنْ بَيْعِ حَبَلِ الْحَبَلَةِ """".","Sahih","Sahih Muslim 3809","","","3. باب: حبل الحبلہ کی بیع کی ممانعت۔ملامسہ اور منابذہ کی بیع باطل ہے"
"3810","حَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، وَمُحَمَّدُ بْنُ الْمُثَنَّى ، وَاللَّفْظُ لِزُهَيْرٍ، قَالَا: حَدَّثَنَا يَحْيَى وَهُوَ الْقَطَّانُ ، عَنْ عُبَيْدِ اللَّهِ ، أَخْبَرَنِي نَافِعٌ ، عَنْ ابْنِ عُمَرَ ، قَالَ: "" كَانَ أَهْلُ الْجَاهِلِيَّةِ يَتَبَايَعُونَ لَحْمَ الْجَزُورِ إِلَى حَبَلِ الْحَبَلَةِ، وَحَبَلُ الْحَبَلَةِ: أَنْ تُنْتَجَ النَّاقَةُ، ثُمَّ تَحْمِلَ الَّتِي نُتِجَتْ، فَنَهَاهُمْ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ ذَلِكَ """".","Sahih","Sahih Muslim 3810","","","3. باب: حبل الحبلہ کی بیع کی ممانعت۔کنکر پھینک کر بیع کرنا اور ایسی بیع کرنا جس میں دھوکا ہو ‘باطل ہیں"
"3811","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" لَا يَبِعْ بَعْضُكُمْ عَلَى بَيْعِ بَعْضٍ """".","Sahih","Sahih Muslim 3811","","","4. باب: اپنے بھائی کے نرخ پر نرخ نہ کرے، نہ اس کی بیع پر بیچے اور دھوکہ دینا اور تھن میں دودھ بھر رکھنا حرام ہے۔حبل الحبلہ کی بیع حرام ہے"
"3812","حَدَّثَنَا زُهَيْرُ بْنُ حَرْبٍ ، وَمُحَمَّدُ بْنُ الْمُثَنَّى ، وَاللَّفْظُ لِزُهَيْرٍ، قَالَا: حَدَّثَنَا يَحْيَي ، عَنْ عُبَيْدِ اللَّهِ ، أَخْبَرَنِي نَافِعٌ ، عَنْ ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" لَا يَبِعِ الرَّجُلُ عَلَى بَيْعِ أَخِيهِ، وَلَا يَخْطُبْ عَلَى خِطْبَةِ أَخِيهِ إِلَّا أَنْ يَأْذَنَ لَهُ """".","Sahih","Sahih Muslim 3812","","","4. باب: اپنے بھائی کے نرخ پر نرخ نہ کرے، نہ اس کی بیع پر بیچے اور دھوکہ دینا اور تھن میں دودھ بھر رکھنا حرام ہے۔مسلمان )بھائی کی بیع پر بیع کرنا ‘اس کے سودے پر سودا بازی کرنا ‘بھاؤ چڑھانے کے لیے قیمت لگانا اور جانور کے تھنوں میں دودھ روکنا حرام ہے"
"3813","حَدَّثَنَا يَحْيَي بْنُ أَيُّوبَ ، وَقُتَيْبَةُ بْنُ سَعِيدٍ ، وَابْنُ حُجْرٍ ، قَالُوا: حَدَّثَنَا إِسْمَاعِيلُ وَهُوَ ابْنُ جَعْفَرٍ ، عَنْ الْعَلَاءِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ : أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" لَا يَسُمْ الْمُسْلِمُ عَلَى سَوْمِ أَخِيهِ """".","Sahih","Sahih Muslim 3813","","","4. باب: اپنے بھائی کے نرخ پر نرخ نہ کرے، نہ اس کی بیع پر بیچے اور دھوکہ دینا اور تھن میں دودھ بھر رکھنا حرام ہے۔مسلمان )بھائی کی بیع پر بیع کرنا ‘اس کے سودے پر سودا بازی کرنا ‘بھاؤ چڑھانے کے لیے قیمت لگانا اور جانور کے تھنوں میں دودھ روکنا حرام ہے"
"3814","وحَدَّثَنِيهِ أَحْمَدُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ ، حَدَّثَنِي عَبْدُ الصَّمَدِ ، حَدَّثَنَا شُعْبَةُ ، عَنْ الْعَلَاءِ ، وَسُهَيْلٍ ، عَنْ أَبِيهِمَا ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ. ح وحَدَّثَنَاه مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا عَبْدُ الصَّمَدِ ، حَدَّثَنَا شُعْبَةُ ، عَنْ الْأَعْمَشِ ، عَنْ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ. ح وحَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ مُعَاذٍ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا شُعْبَةُ ، عَنْ عَدِيٍّ وَهُوَ ابْنُ ثَابِتٍ ، عَنْ أَبِي حَازِمٍ ، عَنْ أَبِي هُرَيْرَةَ : أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى أَنْ يَسْتَامَ الرَّجُلُ عَلَى سَوْمِ أَخِيهِ """"، وَفِي رِوَايَةِ الدَّوْرَقِيِّ: عَلَى سِيمَةِ أَخِيهِ.","Sahih","Sahih Muslim 3814","","","4. باب: اپنے بھائی کے نرخ پر نرخ نہ کرے، نہ اس کی بیع پر بیچے اور دھوکہ دینا اور تھن میں دودھ بھر رکھنا حرام ہے۔مسلمان )بھائی کی بیع پر بیع کرنا ‘اس کے سودے پر سودا بازی کرنا ‘بھاؤ چڑھانے کے لیے قیمت لگانا اور جانور کے تھنوں میں دودھ روکنا حرام ہے"
"3815","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ أَبِي الزِّنَادِ ، عَنْ الْأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" لَا يُتَلَقَّى الرُّكْبَانُ لِبَيْعٍ، وَلَا يَبِعْ بَعْضُكُمْ عَلَى بَيْعِ بَعْضٍ، وَلَا تَنَاجَشُوا، وَلَا يَبِعْ حَاضِرٌ لِبَادٍ، وَلَا تُصَرُّوا الْإِبِلَ وَالْغَنَمَ، فَمَنِ ابْتَاعَهَا بَعْدَ ذَلِكَ، فَهُوَ بِخَيْرِ النَّظَرَيْنِ بَعْدَ أَنْ يَحْلُبَهَا، فَإِنْ رَضِيَهَا أَمْسَكَهَا وَإِنْ سَخِطَهَا رَدَّهَا وَصَاعًا مِنْ تَمْرٍ """".","Sahih","Sahih Muslim 3815","","","4. باب: اپنے بھائی کے نرخ پر نرخ نہ کرے، نہ اس کی بیع پر بیچے اور دھوکہ دینا اور تھن میں دودھ بھر رکھنا حرام ہے۔مسلمان )بھائی کی بیع پر بیع کرنا ‘اس کے سودے پر سودا بازی کرنا ‘بھاؤ چڑھانے کے لیے قیمت لگانا اور جانور کے تھنوں میں دودھ روکنا حرام ہے"
"3816","حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ مُعَاذٍ الْعَنْبَرِيُّ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا شُعْبَةُ ، عَنْ عَدِيٍّ وَهُوَ ابْنُ ثَابِتٍ ، عَنْ أَبِي حَازِمٍ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى عَنِ التَّلَقِّي لِلرُّكْبَانِ، وَأَنْ يَبِيعَ حَاضِرٌ لِبَادٍ، وَأَنْ تَسْأَلَ الْمَرْأَةُ طَلَاقَ أُخْتِهَا، وَعَنِ النَّجْشِ وَالتَّصْرِيَةِ، وَأَنْ يَسْتَامَ الرَّجُلُ عَلَى سَوْمِ أَخِيهِ """".","Sahih","Sahih Muslim 3816","","","4. باب: اپنے بھائی کے نرخ پر نرخ نہ کرے، نہ اس کی بیع پر بیچے اور دھوکہ دینا اور تھن میں دودھ بھر رکھنا حرام ہے۔مسلمان )بھائی کی بیع پر بیع کرنا ‘اس کے سودے پر سودا بازی کرنا ‘بھاؤ چڑھانے کے لیے قیمت لگانا اور جانور کے تھنوں میں دودھ روکنا حرام ہے"
"3817","وحَدَّثَنِيهِ أَبُو بَكْرِ بْنُ نَافِعٍ ، حَدَّثَنَا غُنْدَرٌ . ح وحَدَّثَنَاه مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا وَهْبُ بْنُ جَرِيرٍ . ح وحَدَّثَنَا عَبْدُ الْوَارِثِ بْنُ عَبْدِ الصَّمَدِ ، حَدَّثَنَا أَبِي ، قَالُوا جَمِيعًا: حَدَّثَنَا شُعْبَةُ ، بِهَذَا الْإِسْنَادِ فِي حَدِيثِ غُنْدَرٍ، وَوَهْبٍ: نُهِيَ، وَفِي حَدِيثِ عَبْدِ الصَّمَدِ: أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَى بِمِثْلِ حَدِيثِ مُعَاذٍ، عَنْ شُعْبَةَ.","Sahih","Sahih Muslim 3817","","","4. باب: اپنے بھائی کے نرخ پر نرخ نہ کرے، نہ اس کی بیع پر بیچے اور دھوکہ دینا اور تھن میں دودھ بھر رکھنا حرام ہے۔مسلمان )بھائی کی بیع پر بیع کرنا ‘اس کے سودے پر سودا بازی کرنا ‘بھاؤ چڑھانے کے لیے قیمت لگانا اور جانور کے تھنوں میں دودھ روکنا حرام ہے"
"3818","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى عَنِ النَّجْشِ """".","Sahih","Sahih Muslim 3818","","","4. باب: اپنے بھائی کے نرخ پر نرخ نہ کرے، نہ اس کی بیع پر بیچے اور دھوکہ دینا اور تھن میں دودھ بھر رکھنا حرام ہے۔مسلمان )بھائی کی بیع پر بیع کرنا ‘اس کے سودے پر سودا بازی کرنا ‘بھاؤ چڑھانے کے لیے قیمت لگانا اور جانور کے تھنوں میں دودھ روکنا حرام ہے"
"3819","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا ابْنُ أَبِي زَائِدَةَ . ح وحَدَّثَنَا ابْنُ الْمُثَنَّى ، حَدَّثَنَا يَحْيَي يَعْنِي ابْنَ سَعِيدٍ . ح وحَدَّثَنَا ابْنُ نُمَيْرٍ ، حَدَّثَنَا أَبِي ، كُلُّهُمْ عَنْ عُبَيْدِ اللَّهِ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى أَنْ تُتَلَقَّى السِّلَعُ حَتَّى تَبْلُغَ الْأَسْوَاقَ """"، وَهَذَا لَفْظُ ابْنِ نُمَيْرٍ، وقَالَ الْآخَرَانِ: إِنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: """" نَهَى عَنِ التَّلَقِّي """".","Sahih","Sahih Muslim 3819","","","5. باب: آگے بڑھ کر تاجروں سے ملنے کی ممانعت۔مسلمان )بھائی کی بیع پر بیع کرنا ‘اس کے سودے پر سودا بازی کرنا ‘بھاؤ چڑھانے کے لیے قیمت لگانا اور جانور کے تھنوں میں دودھ روکنا حرام ہے"
"3820","وحَدَّثَنِي مُحَمَّدُ بْنُ حَاتِمٍ ، وَإِسْحَاقُ بْنُ مَنْصُورٍ ، جَمِيعًا عَنْ ابْنِ مَهْدِيٍّ ، عَنْ مَالِكٍ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِ حَدِيثِ ابْنِ نُمَيْرٍ، عَنْ عُبَيْدِ اللَّهِ.","Sahih","Sahih Muslim 3820","","","5. باب: آگے بڑھ کر تاجروں سے ملنے کی ممانعت۔باہر سے لایا جانے والا سامان (راستے میں جا کر )خریدنا حرام ہے"
"3821","وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مُبَارَكٍ ، عَنْ التَّيْمِيِّ ، عَنْ أَبِي عُثْمَانَ ، عَنْ عَبْدِ اللَّهِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، أَنَّهُ: "" نَهَى عَنْ تَلَقِّي الْبُيُوعِ """".","Sahih","Sahih Muslim 3821","","","5. باب: آگے بڑھ کر تاجروں سے ملنے کی ممانعت۔باہر سے لایا جانے والا سامان (راستے میں جا کر )خریدنا حرام ہے"
"3822","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، أَخْبَرَنَا هُشَيْمٌ ، عَنْ هِشَامٍ ، عَنْ ابْنِ سِيرِينَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: "" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يُتَلَقَّى الْجَلَبُ """".","Sahih","Sahih Muslim 3822","","","5. باب: آگے بڑھ کر تاجروں سے ملنے کی ممانعت۔باہر سے لایا جانے والا سامان (راستے میں جا کر )خریدنا حرام ہے"
"3823","حَدَّثَنَا ابْنُ أَبِي عُمَرَ ، حَدَّثَنَا هِشَامُ بْنُ سُلَيْمَانَ ، عَنْ ابْنِ جُرَيْجٍ ، أَخْبَرَنِي هِشَامٌ الْقُرْدُوسِيُّ ، عَنْ ابْنِ سِيرِينَ ، قَالَ: سَمِعْتُ أَبَا هُرَيْرَةَ ، يَقُولُ: إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" لَا تَلَقَّوْا الْجَلَبَ، فَمَنْ تَلَقَّاهُ، فَاشْتَرَى مِنْهُ، فَإِذَا أَتَى سَيِّدُهُ السُّوقَ، فَهُوَ بِالْخِيَارِ """".","Sahih","Sahih Muslim 3823","","","5. باب: آگے بڑھ کر تاجروں سے ملنے کی ممانعت۔باہر سے لایا جانے والا سامان (راستے میں جا کر )خریدنا حرام ہے"
"3824","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَعَمْرٌو النَّاقِدُ ، وَزُهَيْرُ بْنُ حَرْبٍ ، قَالُوا: حَدَّثَنَا سُفْيَانُ ، عَنْ الزُّهْرِيِّ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، عَنْ أَبِي هُرَيْرَةَ ، يَبْلُغُ بِهِ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" لَا يَبِعْ حَاضِرٌ لِبَادٍ """". وقَالَ زُهَيْرٌ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ نَهَى أَنْ يَبِيعَ حَاضِرٌ لِبَادٍ.","Sahih","Sahih Muslim 3824","","","6. باب: شہر والا باہر والے کا مال نہ بیچے۔باہر سے لایا جانے والا سامان (راستے میں جا کر )خریدنا حرام ہے"
"3825","وحَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، وَعَبْدُ بْنُ حميد ، قَالَا: حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، عَنْ ابْنِ عَبَّاسٍ ، قَالَ: "" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ تُتَلَقَّى الرُّكْبَانُ، وَأَنْ يَبِيعَ حَاضِرٌ لِبَادٍ """". قَالَ: فَقُلْتُ لِابْنِ عَبَّاسٍ: مَا قَوْلُهُ حَاضِرٌ لِبَادٍ، قَالَ: لَا يَكُنْ لَهُ سِمْسَارًا.","Sahih","Sahih Muslim 3825","","","6. باب: شہر والا باہر والے کا مال نہ بیچے۔شہری کا دیہاتی کے لیے بیع کرنا حرام ہے"
"3826","حَدَّثَنَا يَحْيَي بْنُ يَحْيي التَّمِيمِيُّ ، أَخْبَرَنَا أَبُو خَيْثَمَةَ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرٍ . ح وحَدَّثَنَا أَحْمَدُ بْنُ يُونُسَ ، حَدَّثَنَا زُهَيْرٌ ، حَدَّثَنَا أَبُو الزُّبَيْرِ ، عَنْ جَابِرٍ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" لَا يَبِعْ حَاضِرٌ لِبَادٍ دَعُوا النَّاسَ يَرْزُقْ اللَّهُ بَعْضَهُمْ مِنْ بَعْضٍ """"، غَيْرَ أَنَّ فِي رِوَايَةِ يَحْيَى: يُرْزَقُ.","Sahih","Sahih Muslim 3826","","","6. باب: شہر والا باہر والے کا مال نہ بیچے۔شہری کا دیہاتی کے لیے بیع کرنا حرام ہے"
"3827","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَعَمْرٌو النَّاقِدُ ، قَالَا: حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، بِمِثْلِهِ.","Sahih","Sahih Muslim 3827","","","6. باب: شہر والا باہر والے کا مال نہ بیچے۔شہری کا دیہاتی کے لیے بیع کرنا حرام ہے"
"3828","وحَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، أَخْبَرَنَا هُشَيْمٌ ، عَنْ يُونُسَ ، عَنْ ابْنِ سِيرِينَ ، عَنْ أَنَسِ بْنِ مَالِكٍ ، قَالَ: "" نُهِينَا أَنْ يَبِيعَ حَاضِرٌ لِبَادٍ، وَإِنْ كَانَ أَخَاهُ أَوْ أَبَاهُ """".","Sahih","Sahih Muslim 3828","","","6. باب: شہر والا باہر والے کا مال نہ بیچے۔شہری کا دیہاتی کے لیے بیع کرنا حرام ہے"
"3829","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا ابْنُ أَبِي عَدِيٍّ ، عَنْ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، عَنْ أَنَسٍ . ح وحَدَّثَنَا ابْنُ الْمُثَنَّى ، حَدَّثَنَا مُعَاذٌ ، حَدَّثَنَا ابْنُ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ: قَالَ أَنَسُ بْنُ مَالِكٍ : "" نُهِينَا عَنْ أَنْ يَبِيعَ حَاضِرٌ لِبَادٍ """".","Sahih","Sahih Muslim 3829","","","6. باب: شہر والا باہر والے کا مال نہ بیچے۔شہری کا دیہاتی کے لیے بیع کرنا حرام ہے"
"3830","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ بْنِ قَعْنَبٍ ، حَدَّثَنَا دَاوُدُ بْنُ قَيْسٍ ، عَنْ مُوسَى بْنِ يَسَارٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" مَنِ اشْتَرَى شَاةً مُصَرَّاةً، فَلْيَنْقَلِبْ بِهَا فَلْيَحْلُبْهَا، فَإِنْ رَضِيَ حِلَابَهَا أَمْسَكَهَا، وَإِلَّا رَدَّهَا وَمَعَهَا صَاعٌ مِنْ تَمْرٍ """".","Sahih","Sahih Muslim 3830","","","7. باب: مصراۃ کی بیع کا بیان۔شہری کا دیہاتی کے لیے بیع کرنا حرام ہے"
"3831","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا يَعْقُوبُ يَعْنِي ابْنَ عَبْدِ الرَّحْمَنِ الْقَارِيَّ ، عَنْ سُهَيْلٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" مَنِ ابْتَاعَ شَاةً مُصَرَّاةً، فَهُوَ فِيهَا بِالْخِيَارِ ثَلَاثَةَ أَيَّامٍ، إِنْ شَاءَ أَمْسَكَهَا، وَإِنْ شَاءَ رَدَّهَا وَرَدَّ مَعَهَا صَاعًا مِنْ تَمْرٍ """".","Sahih","Sahih Muslim 3831","","","7. باب: مصراۃ کی بیع کا بیان۔جس جانور کا دودھروکا گیا ہو ‘اس کی بیع"
"3832","حَدَّثَنَا مُحَمَّدُ بْنُ عَمْرِو بْنِ جَبَلَةَ بْنِ أَبِي رَوَّادٍ ، حَدَّثَنَا أَبُو عَامِرٍ يَعْنِي الْعَقَدِيَّ ، حَدَّثَنَا قُرَّةُ ، عَنْ مُحَمَّدٍ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" مَنِ اشْتَرَى شَاةً مُصَرَّاةً، فَهُوَ بِالْخِيَارِ ثَلَاثَةَ أَيَّامٍ، فَإِنْ رَدَّهَا رَدَّ مَعَهَا صَاعًا مِنْ طَعَامٍ لَا سَمْرَاءَ """".","Sahih","Sahih Muslim 3832","","","7. باب: مصراۃ کی بیع کا بیان۔جس جانور کا دودھروکا گیا ہو ‘اس کی بیع"
"3833","حَدَّثَنَا ابْنُ أَبِي عُمَرَ ، حَدَّثَنَا سُفْيَانُ ، عَنْ أَيُّوبَ ، عَنْ مُحَمَّدٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" مَنِ اشْتَرَى شَاةً مُصَرَّاةً، فَهُوَ بِخَيْرِ النَّظَرَيْنِ إِنْ شَاءَ أَمْسَكَهَا، وَإِنْ شَاءَ رَدَّهَا وَصَاعًا مِنْ تَمْرٍ لَا سَمْرَاءَ """".","Sahih","Sahih Muslim 3833","","","7. باب: مصراۃ کی بیع کا بیان۔جس جانور کا دودھروکا گیا ہو ‘اس کی بیع"
"3834","وحَدَّثَنَاه ابْنُ أَبِي عُمَرَ ، حَدَّثَنَا عَبْدُ الْوَهَّابِ ، عَنْ أَيُّوبَ ، بِهَذَا الْإِسْنَادِ، غَيْرَ أَنَّهُ قَالَ: مَنِ اشْتَرَى مِنَ الْغَنَمِ، فَهُوَ بِالْخِيَارِ.","Sahih","Sahih Muslim 3834","","","7. باب: مصراۃ کی بیع کا بیان۔جس جانور کا دودھروکا گیا ہو ‘اس کی بیع"
"3835","حَدَّثَنَا مُحَمَّدُ بْنُ رَافِعٍ ، حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، حَدَّثَنَا مَعْمَرٌ ، عَنْ هَمَّامِ بْنِ مُنَبِّهٍ ، قَالَ: هَذَا مَا حَدَّثَنَا أَبُو هُرَيْرَةَ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَذَكَرَ أَحَادِيثَ مِنْهَا، وَقَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" إِذَا مَا أَحَدُكُمُ اشْتَرَى لِقْحَةً مُصَرَّاةً، أَوْ شَاةً مُصَرَّاةً، فَهُوَ بِخَيْرِ النَّظَرَيْنِ بَعْدَ أَنْ يَحْلُبَهَا إِمَّا هِيَ، وَإِلَّا فَلْيَرُدَّهَا وَصَاعًا مِنْ تَمْرٍ """".","Sahih","Sahih Muslim 3835","","","7. باب: مصراۃ کی بیع کا بیان۔جس جانور کا دودھروکا گیا ہو ‘اس کی بیع"
"3836","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ . ح وحَدَّثَنَا أَبُو الرَّبِيعِ الْعَتَكِيُّ ، وَقُتَيْبَةُ ، قَالَا: حَدَّثَنَا حَمَّادٌ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ طَاوُسٍ ، عَنْ ابْنِ عَبَّاسٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" مَنِ ابْتَاعَ طَعَامًا فَلَا يَبِعْهُ حَتَّى يَسْتَوْفِيَهُ """"، قَالَ ابْنُ عَبَّاسٍ: وَأَحْسِبُ كُلَّ شَيْءٍ مِثْلَهُ.","Sahih","Sahih Muslim 3836","","","8. باب: قبضہ سے پہلے خریدار کو دوسرے کے ہاتھ بیچنا درست نہیں ہے۔جس جانور کا دودھروکا گیا ہو ‘اس کی بیع"
"3837","حَدَّثَنَا ابْنُ أَبِي عُمَرَ ، وَأَحْمَدُ بْنُ عَبْدَةَ ، قَالَا: حَدَّثَنَا سُفْيَانُ . ح وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو كُرَيْبٍ ، قَالَا: حَدَّثَنَا وَكِيعٌ ، عَنْ سُفْيَانَ وَهُوَ الثَّوْرِيُّ ، كلاهما عَنْ عَمْرِو بْنِ دِينَارٍ ، بِهَذَا الْإِسْنَادِ نَحْوَهُ.","Sahih","Sahih Muslim 3837","","","8. باب: قبضہ سے پہلے خریدار کو دوسرے کے ہاتھ بیچنا درست نہیں ہے۔خریدے گئے سامان کو قبضے میں لینے سے پہلے آگے بیچنا باطل ہے"
"3838","حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، وَمُحَمَّدُ بْنُ رَافِعٍ ، وَعَبْدُ بْنُ حميد ، قَالَ ابْنُ رَافِعٍ: حَدَّثَنَا، وقَالَ الْآخَرَانِ: أَخْبَرَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، عَنْ ابْنِ عَبَّاسٍ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" مَنِ ابْتَاعَ طَعَامًا فَلَا يَبِعْهُ حَتَّى يَقْبِضَهُ """"، قَالَ ابْنُ عَبَّاسٍ: وَأَحْسِبُ كُلَّ شَيْءٍ بِمَنْزِلَةِ الطَّعَامِ.","Sahih","Sahih Muslim 3838","","","8. باب: قبضہ سے پہلے خریدار کو دوسرے کے ہاتھ بیچنا درست نہیں ہے۔خریدے گئے سامان کو قبضے میں لینے سے پہلے آگے بیچنا باطل ہے"
"3839","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَأَبُو كُرَيْبٍ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ إِسْحاَقُ: أَخْبَرَنَا، وقَالَ الْآخَرَانِ: حَدَّثَنَا وَكِيعٌ ، عَنْ سُفْيَانَ ، عَنْ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، عَنْ ابْنِ عَبَّاسٍ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" مَنِ ابْتَاعَ طَعَامًا فَلَا يَبِعْهُ حَتَّى يَكْتَالَهُ """"، فَقُلْتُ لِابْنِ عَبَّاسٍ: لِمَ، فَقَالَ: أَلَا تُرَاهُمْ يَتَبَايَعُونَ بِالذَّهَبِ وَالطَّعَامُ مُرْجَأٌ، وَلَمْ يَقُلْ أَبُو كُرَيْبٍ: مُرْجَأٌ.","Sahih","Sahih Muslim 3839","","","8. باب: قبضہ سے پہلے خریدار کو دوسرے کے ہاتھ بیچنا درست نہیں ہے۔خریدے گئے سامان کو قبضے میں لینے سے پہلے آگے بیچنا باطل ہے"
"3840","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ الْقَعْنَبِيُّ ، حَدَّثَنَا مَالِكٌ . ح وحَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" مَنِ ابْتَاعَ طَعَامًا، فَلَا يَبِعْهُ حَتَّى يَسْتَوْفِيَهُ """".","Sahih","Sahih Muslim 3840","","","8. باب: قبضہ سے پہلے خریدار کو دوسرے کے ہاتھ بیچنا درست نہیں ہے۔خریدے گئے سامان کو قبضے میں لینے سے پہلے آگے بیچنا باطل ہے"
"3841","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، قَالَ: كُنَّا فِي زَمَانِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَبْتَاعُ الطَّعَامَ، فَيَبْعَثُ عَلَيْنَا مَنْ يَأْمُرُنَا بِانْتِقَالِهِ مِنَ الْمَكَانِ الَّذِي ابْتَعْنَاهُ فِيهِ إِلَى مَكَانٍ سِوَاهُ قَبْلَ أَنْ نَبِيعَهُ """".","Sahih","Sahih Muslim 3841","","","8. باب: قبضہ سے پہلے خریدار کو دوسرے کے ہاتھ بیچنا درست نہیں ہے۔خریدے گئے سامان کو قبضے میں لینے سے پہلے آگے بیچنا باطل ہے"
"3842","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا عَلِيُّ بْنُ مُسْهِرٍ ، عَنْ عُبَيْدِ اللَّهِ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، وَاللَّفْظُ لَهُ: حَدَّثَنَا أَبِي ، حَدَّثَنَا عُبَيْدُ اللَّهِ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" مَنِ اشْتَرَى طَعَامًا فَلَا يَبِعْهُ حَتَّى يَسْتَوْفِيَهُ """"،","Sahih","Sahih Muslim 3842","","","8. باب: قبضہ سے پہلے خریدار کو دوسرے کے ہاتھ بیچنا درست نہیں ہے۔خریدے گئے سامان کو قبضے میں لینے سے پہلے آگے بیچنا باطل ہے"
"3843","قَالَ: وَكُنَّا نَشْتَرِي الطَّعَامَ مِنَ الرُّكْبَانِ جِزَافًا، فَنَهَانَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ نَبِيعَهُ حَتَّى نَنْقُلَهُ مِنْ مَكَانِهِ.","Sahih","Sahih Muslim 3843","","","8. باب: قبضہ سے پہلے خریدار کو دوسرے کے ہاتھ بیچنا درست نہیں ہے۔خریدے گئے سامان کو قبضے میں لینے سے پہلے آگے بیچنا باطل ہے"
"3844","حَدَّثَنِي حَرْمَلَةُ بْنُ يَحْيَي ، أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ وَهْبٍ ، حَدَّثَنِي عُمَرُ بْنُ مُحَمَّدٍ ، عَنْ نَافِعٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" مَنِ اشْتَرَى طَعَامًا فَلَا يَبِعْهُ حَتَّى يَسْتَوْفِيَهُ وَيَقْبِضَهُ """".","Sahih","Sahih Muslim 3844","","","8. باب: قبضہ سے پہلے خریدار کو دوسرے کے ہاتھ بیچنا درست نہیں ہے۔خریدے گئے سامان کو قبضے میں لینے سے پہلے آگے بیچنا باطل ہے"
"3845","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، وَعَلِيُّ بْنُ حُجْرٍ ، قَالَ يَحْيَي: أَخْبَرَنَا إِسْمَاعِيلُ بْنُ جَعْفَرٍ ، وقَالَ عَلِيٌّ: حَدَّثَنَا إِسْمَاعِيلُ، عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ ، أَنَّهُ سَمِعَ ابْنَ عُمَرَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" مَنِ ابْتَاعَ طَعَامًا، فَلَا يَبِعْهُ حَتَّى يَقْبِضَهُ """".","Sahih","Sahih Muslim 3845","","","8. باب: قبضہ سے پہلے خریدار کو دوسرے کے ہاتھ بیچنا درست نہیں ہے۔خریدے گئے سامان کو قبضے میں لینے سے پہلے آگے بیچنا باطل ہے"
"3846","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا عَبْدُ الْأَعْلَى ، عَنْ مَعْمَرٍ ، عَنْ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنْ ابْنِ عُمَرَ ، أَنَّهُمْ كَانُوا يُضْرَبُونَ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، "" إِذَا اشْتَرَوْا طَعَامًا جِزَافًا، أَنْ يَبِيعُوهُ فِي مَكَانِهِ حَتَّى يُحَوِّلُوهُ """".","Sahih","Sahih Muslim 3846","","","8. باب: قبضہ سے پہلے خریدار کو دوسرے کے ہاتھ بیچنا درست نہیں ہے۔خریدے گئے سامان کو قبضے میں لینے سے پہلے آگے بیچنا باطل ہے"
"3847","وحَدَّثَنِي حَرْمَلَةُ بْنُ يَحْيَي ، حَدَّثَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي يُونُسُ ، عَنْ ابْنِ شِهَابٍ ، أَخْبَرَنِي سَالِمُ بْنُ عَبْدِ اللَّهِ ، أَنَّ أَبَاهُ ، قَال: "" قَدْ رَأَيْتُ النَّاسَ فِي عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا ابْتَاعُوا الطَّعَامَ جِزَافًا، يُضْرَبُونَ فِي أَنْ يَبِيعُوهُ فِي مَكَانِهِمْ، وَذَلِكِ حَتَّى يُؤْوُوهُ إِلَى رِحَالِهِمْ """". قَالَ ابْنُ شِهَابٍ: وَحَدَّثَنِي عُبَيْدُ اللَّهِ بْنُ عَبْدِ اللَّهِ بْنِ عُمَرَ، أَنَّ أَبَاهُ كَانَ يَشْتَرِي الطَّعَامَ جِزَافًا، فَيَحْمِلُهُ إِلَى أَهْلِهِ.","Sahih","Sahih Muslim 3847","","","8. باب: قبضہ سے پہلے خریدار کو دوسرے کے ہاتھ بیچنا درست نہیں ہے۔خریدے گئے سامان کو قبضے میں لینے سے پہلے آگے بیچنا باطل ہے"
"3848","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَابْنُ نُمَيْرٍ ، وَأَبُو كُرَيْبٍ ، قَالُوا: حَدَّثَنَا زَيْدُ بْنُ حُبَابٍ ، عَنْ الضَّحَّاكِ بْنِ عُثْمَانَ ، عَنْ بُكَيْرِ بْنِ عَبْدِ اللَّهِ بْنِ الْأَشَجِّ ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" مَنِ اشْتَرَى طَعَامًا، فَلَا يَبِعْهُ حَتَّى يَكْتَالَهُ """"، وَفِي رِوَايَةِ أَبِي بَكْرٍ: مَنِ ابْتَاعَ.","Sahih","Sahih Muslim 3848","","","8. باب: قبضہ سے پہلے خریدار کو دوسرے کے ہاتھ بیچنا درست نہیں ہے۔خریدے گئے سامان کو قبضے میں لینے سے پہلے آگے بیچنا باطل ہے"
"3849","حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ الْحَارِثِ الْمَخْزُومِيُّ ، حَدَّثَنَا الضَّحَّاكُ بْنُ عُثْمَانَ ، عَنْ بُكَيْرِ بْنِ عَبْدِ اللَّهِ بْنِ الْأَشَجِّ ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّهُ قَالَ لِمَرْوَانَ: أَحْلَلْتَ بَيْعَ الرِّبَا، فَقَالَ مَرْوَانُ: مَا فَعَلْتُ، فَقَالَ أَبُو هُرَيْرَةَ: أَحْلَلْتَ بَيْعَ الصِّكَاكِ، "" وَقَدْ نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ الطَّعَامِ حَتَّى يُسْتَوْفَى """"، قَالَ: فَخَطَبَ مَرْوَانُ النَّاسَ، فَنَهَى عَنْ بَيْعِهَا، قَالَ سُلَيْمَانُ: فَنَظَرْتُ إِلَى حَرَسٍ يَأْخُذُونَهَا مِنْ أَيْدِي النَّاسِ.","Sahih","Sahih Muslim 3849","","","8. باب: قبضہ سے پہلے خریدار کو دوسرے کے ہاتھ بیچنا درست نہیں ہے۔خریدے گئے سامان کو قبضے میں لینے سے پہلے آگے بیچنا باطل ہے"
"3850","حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا رَوْحٌ ، حَدَّثَنَا ابْنُ جُرَيْجٍ ، حَدَّثَنِي أَبُو الزُّبَيْرِ ، أَنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ: كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: "" إِذَا ابْتَعْتَ طَعَامًا فَلَا تَبِعْهُ حَتَّى تَسْتَوْفِيَهُ """".","Sahih","Sahih Muslim 3850","","","8. باب: قبضہ سے پہلے خریدار کو دوسرے کے ہاتھ بیچنا درست نہیں ہے۔خریدے گئے سامان کو قبضے میں لینے سے پہلے آگے بیچنا باطل ہے"
"3851","حَدَّثَنِي أَبُو الطَّاهِرِ أَحْمَدُ بْنُ عَمْرِو بْنِ سَرْحٍ ، أَخْبَرَنَا ابْنُ وَهْبٍ ، حَدَّثَنِي ابْنُ جُرَيْجٍ ، أَنَّ أَبَا الزُّبَيْرِ ، أَخْبَرَهُ، قَالَ: سَمِعْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ: "" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ الصُّبْرَةِ مِنَ التَّمْرِ، لَا يُعْلَمُ مَكِيلَتُهَا بِالْكَيْلِ الْمُسَمَّى مِنَ التَّمْرِ """"،","Sahih","Sahih Muslim 3851","","","9. باب: کھجور کے ڈھیر کو جس کا وزن معلوم نہ ہو کھجور کے بدلے بیچنا درست نہیں ہے۔خریدے گئے سامان کو قبضے میں لینے سے پہلے آگے بیچنا باطل ہے"
"3852","حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، حَدَّثَنَا رَوْحُ بْنُ عُبَادَةَ ، حَدَّثَنَا ابْنُ جُرَيْجٍ ، أَخْبَرَنِي أَبُو الزُّبَيْرِ ، أَنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ: نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِهِ، غَيْرَ أَنَّهُ لَمْ يَذْكُرْ مِنَ التَّمْرِ فِي آخِرِ الْحَدِيثِ.","Sahih","Sahih Muslim 3852","","","9. باب: کھجور کے ڈھیر کو جس کا وزن معلوم نہ ہو کھجور کے بدلے بیچنا درست نہیں ہے۔نا معلوم مقدار میں کھجور کے ڈھیر کو (متعین مقدار کی )کھجور وں کے عوض بیچنا حرام ہے"
"3853","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" الْبَيِّعَانِ كُلُّ وَاحِدٍ مِنْهُمَا بِالْخِيَارِ عَلَى صَاحِبِهِ مَا لَمْ يَتَفَرَّقَا، إِلَّا بَيْعَ الْخِيَارِ """"،","Sahih","Sahih Muslim 3853","","","10. باب: بائع اور مشتری دونوں کو اختیار ہے جب تک اس مقام میں رہیں جہاں بیع ہوئی ہے۔نا معلوم مقدار میں کھجور کے ڈھیر کو (متعین مقدار کی )کھجور وں کے عوض بیچنا حرام ہے"
"3854","حَدَّثَنَا زُهَيْرُ بْنُ حَرْبٍ ، وَمُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَا: حَدَّثَنَا يَحْيَي وَهُوَ الْقَطَّانُ . ح وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ . ح وحَدَّثَنَا ابْنُ نُمَيْرٍ ، حَدَّثَنَا أَبِي ، كُلُّهُمْ عَنْ عُبَيْدِ اللَّهِ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ. ح وحَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، وَعَلِيُّ بْنُ حُجْرٍ ، قَالَا: حَدَّثَنَا إِسْمَاعِيلُ . ح وحَدَّثَنَا أَبُو الرَّبِيعِ ، وَأَبُو كَامِلٍ ، قَالَا: حَدَّثَنَا حَمَّادٌ وَهُوَ ابْنُ زَيْدٍ ، جَمِيعًا عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ. ح وحَدَّثَنَا ابْنُ الْمُثَنَّى ، وَابْنُ أَبِي عُمَرَ ، قَالَا: حَدَّثَنَا عَبْدُ الْوَهَّابِ ، قَالَ: سَمِعْتُ يَحْيَى بْنَ سَعِيدٍ . ح وحَدَّثَنَا ابْنُ رَافِعٍ، حَدَّثَنَا ابْنُ أَبِي فُدَيْكٍ ، أَخْبَرَنَا الضَّحَّاكُ ، كِلَاهُمَا عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، نَحْوَ حَدِيثِ مَالِكٍ، عَنْ نَافِعٍ.","Sahih","Sahih Muslim 3854","","","10. باب: بائع اور مشتری دونوں کو اختیار ہے جب تک اس مقام میں رہیں جہاں بیع ہوئی ہے۔مجلس (ایک جگہ موجود گی )ختم ہونے سے پہلے بیچنے یا خریدنے والے کو سودا واپس کرنے کا اختیار ہے"
"3855","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ . ح وَحَدَّثَنَا مُحَمَّدُ بْنُ رُمْحٍ ، أَخْبَرَنَا اللَّيْثُ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، أَنَّهُ قَالَ: "" إِذَا تَبَايَعَ الرَّجُلَانِ فَكُلُّ وَاحِدٍ مِنْهُمَا بِالْخِيَارِ مَا لَمْ يَتَفَرَّقَا، وَكَانَا جَمِيعًا أَوْ يُخَيِّرُ أَحَدُهُمَا الْآخَرَ، فَإِنْ خَيَّرَ أَحَدُهُمَا الْآخَرَ فَتَبَايَعَا عَلَى ذَلِكِ، فَقَدْ وَجَبَ الْبَيْعُ، وَإِنْ تَفَرَّقَا بَعْدَ أَنْ تَبَايَعَا وَلَمْ يَتْرُكْ وَاحِدٌ مِنْهُمَا الْبَيْعَ، فَقَدْ وَجَبَ الْبَيْعُ """".","Sahih","Sahih Muslim 3855","","","10. باب: بائع اور مشتری دونوں کو اختیار ہے جب تک اس مقام میں رہیں جہاں بیع ہوئی ہے۔مجلس (ایک جگہ موجود گی )ختم ہونے سے پہلے بیچنے یا خریدنے والے کو سودا واپس کرنے کا اختیار ہے"
"3856","وحَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، وَابْنُ أَبِي عُمَرَ ، كِلَاهُمَا عَنْ سُفْيَانَ، قَالَ زُهَيْرٌ حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ ابْنِ جُرَيْجٍ ، قَالَ: أَمْلَى عَلَيَّ نَافِعٌ ، سَمِعَ عَبْدَ اللَّهِ بْنَ عُمَرَ ، يَقُولُ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" إِذَا تَبَايَعَ الْمُتَبَايِعَانِ بِالْبَيْعِ، فَكُلُّ وَاحِدٍ مِنْهُمَا بِالْخِيَارِ مِنْ بَيْعِهِ مَا لَمْ يَتَفَرَّقَا، أَوْ يَكُونُ بَيْعُهُمَا عَنْ خِيَارٍ، فَإِذَا كَانَ بَيْعُهُمَا، عَنْ خِيَارٍ، فَقَدْ وَجَبَ """"، زَادَ ابْنُ أَبِي عُمَرَ فِي رِوَايَتِهِ: قَالَ نَافِعٌ: كَانَ إِذَا بَايَعَ رَجُلًا فَأَرَادَ أَنْ لَا يُقِيلَهُ قَامَ، فَمَشَى هُنَيَّةً ثُمَّ رَجَعَ إِلَيْهِ.","Sahih","Sahih Muslim 3856","","","10. باب: بائع اور مشتری دونوں کو اختیار ہے جب تک اس مقام میں رہیں جہاں بیع ہوئی ہے۔مجلس (ایک جگہ موجود گی )ختم ہونے سے پہلے بیچنے یا خریدنے والے کو سودا واپس کرنے کا اختیار ہے"
"3857","حَدَّثَنَا يَحْيَي بْنُ يَحْيَى ، وَيَحْيَي بْنُ أَيُّوبَ ، وَقُتَيْبَةُ ، وَابْنُ حُجْرٍ ، قَالَ يَحْيَى بْنُ يَحْيَى: أَخْبَرَنَا، وقَالَ الْآخَرُونَ: حَدَّثَنَا إِسْمَاعِيلُ بْنُ جَعْفَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ ، أَنَّهُ سَمِعَ ابْنَ عُمَرَ ، يَقُولُ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" كُلُّ بَيِّعَيْنِ لَا بَيْعَ بَيْنَهُمَا حَتَّى يَتَفَرَّقَا، إِلَّا بَيْعُ الْخِيَارِ """".","Sahih","Sahih Muslim 3857","","","10. باب: بائع اور مشتری دونوں کو اختیار ہے جب تک اس مقام میں رہیں جہاں بیع ہوئی ہے۔مجلس (ایک جگہ موجود گی )ختم ہونے سے پہلے بیچنے یا خریدنے والے کو سودا واپس کرنے کا اختیار ہے"
"3858","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا يَحْيَي بْنُ سَعِيدٍ ، عَنْ شُعْبَةَ . ح وحَدَّثَنَا عَمْرُو بْنُ عَلِيٍّ ، حَدَّثَنَا يَحْيَي بْنُ سَعِيدٍ ، وَعَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ، قَالَا: حَدَّثَنَا شُعْبَةُ ، عَنْ قَتَادَةَ ، عَنْ أَبِي الْخَلِيلِ ، عَنْ عَبْدِ اللَّهِ بْنِ الْحَارِثِ ، عَنْ حَكِيمِ بْنِ حِزَامٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" الْبَيِّعَانِ بِالْخِيَارِ مَا لَمْ يَتَفَرَّقَا، فَإِنْ صَدَقَا وَبَيَّنَا بُورِكَ لَهُمَا فِي بَيْعِهِمَا، وَإِنْ كَذَبَا وَكَتَمَا مُحِقَ بَرَكَةُ بَيْعِهِمَا """".","Sahih","Sahih Muslim 3858","","","11. باب: تجارت اور بیان میں راست بازی کا بیان۔مجلس (ایک جگہ موجود گی )ختم ہونے سے پہلے بیچنے یا خریدنے والے کو سودا واپس کرنے کا اختیار ہے"
"3859","حَدَّثَنَا عَمْرُو بْنُ عَلِيٍّ ، حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ، حَدَّثَنَا هَمَّامٌ ، عَنْ أَبِي التَّيَّاحِ ، قَالَ: سَمِعْتُ عَبْدَ اللَّهِ بْنَ الْحَارِثِ ، يُحَدِّثُ، عَنْ حَكِيمِ بْنِ حِزَامٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، بِمِثْلِهِ، قَالَ مُسْلِم بْن الْحَجَّاج: وُلِدَ حَكِيمُ بْنُ حِزَامٍ فِي جَوْفِ الْكَعْبَةِ، وَعَاشَ مِائَةً وَعِشْرِينَ سَنَةً.","Sahih","Sahih Muslim 3859","","","11. باب: تجارت اور بیان میں راست بازی کا بیان۔بیع میں سچ بولنا اور حقیقت حال کو واضع کرنا"
"3860","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، وَيَحْيَي بْنُ أَيُّوبَ ، وَقُتَيْبَةُ ، وَابْنُ حُجْرٍ ، قَالَ يَحْيَى بْنُ يَحْيَى: أَخْبَرَنَا، وقَالَ الْآخَرُونَ: حَدَّثَنَا إِسْمَاعِيلُ بْنُ جَعْفَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ ، أَنَّهُ سَمِعَ ابْنَ عُمَرَ ، يَقُولُ: ذَكَرَ رَجُلٌ لِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، أَنَّهُ يُخْدَعُ فِي الْبُيُوعِ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" مَنْ بَايَعْت فَقُلْ: لَا خِلَابَةَ """"، فَكَانَ إِذَا بَايَعَ، يَقُولُ: لَا خِيَابَةَ.","Sahih","Sahih Muslim 3860","","","12. باب: جو شخص بیع میں دھوکا کھائے۔بیع میں سچ بولنا اور حقیقت حال کو واضع کرنا"
"3861","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا وَكِيعٌ ، حَدَّثَنَا سُفْيَانُ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا شُعْبَةُ ، كِلَاهُمَا عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ ، بِهَذَا الْإِسْنَادِ مِثْلَهُ وَلَيْسَ فِي حَدِيثِهِمَا، فَكَانَ إِذَا بَايَعَ، يَقُولُ: لَا خِيَابَةَ.","Sahih","Sahih Muslim 3861","","","12. باب: جو شخص بیع میں دھوکا کھائے۔جو شخص بیع میں دھوکا کھاتا ہو"
"3862","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى عَنْ بَيْعِ الثَّمَرِ حَتَّى يَبْدُوَ صَلَاحُهَا، نَهَى الْبَائِعَ وَالْمُبْتَاعَ """".","Sahih","Sahih Muslim 3862","","","13. باب: میوہ جب تک اس کی صلاحیت کا یقین نہ ہو درخت پر بیچنا درست نہیں جب کاٹنے کی شرط نہ ہوئی ہو۔جو شخص بیع میں دھوکا کھاتا ہو"
"3863","حَدَّثَنَا ابْنُ نُمَيْرٍ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا عُبَيْدُ اللَّهِ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِهِ.","Sahih","Sahih Muslim 3863","","","13. باب: میوہ جب تک اس کی صلاحیت کا یقین نہ ہو درخت پر بیچنا درست نہیں جب کاٹنے کی شرط نہ ہوئی ہو۔پھلوں کی (پکنے کی)صلاحیت ظاہر ہونے سے پہلے توڑنے کی شرط لگائے بغیر بیع کرنا منع ہے"
"3864","وحَدَّثَنِي عَلِيُّ بْنُ حُجْرٍ السَّعْدِيُّ ، وَزُهَيْرُ بْنُ حَرْبٍ ، قَالَا: حَدَّثَنَا إِسْمَاعِيلُ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى عَنْ بَيْعِ النَّخْلِ حَتَّى يَزْهُوَ، وَعَنِ السُّنْبُلِ حَتَّى يَبْيَضَّ، وَيَأْمَنَ الْعَاهَةَ، نَهَى الْبَائِعَ وَالْمُشْتَرِيَ """".","Sahih","Sahih Muslim 3864","","","13. باب: میوہ جب تک اس کی صلاحیت کا یقین نہ ہو درخت پر بیچنا درست نہیں جب کاٹنے کی شرط نہ ہوئی ہو۔پھلوں کی (پکنے کی)صلاحیت ظاہر ہونے سے پہلے توڑنے کی شرط لگائے بغیر بیع کرنا منع ہے"
"3865","حَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا جَرِيرٌ ، عَنْ يَحْيَي بْنِ سَعِيدٍ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" لَا تَبْتَاعُوا الثَّمَرَ حَتَّى يَبْدُوَ صَلَاحُهُ، وَتَذْهَبَ عَنْهُ الْآفَةُ """"، قَالَ: """" يَبْدُوَ صَلَاحُهُ حُمْرَتُهُ وَصُفْرَتُهُ """".","Sahih","Sahih Muslim 3865","","","13. باب: میوہ جب تک اس کی صلاحیت کا یقین نہ ہو درخت پر بیچنا درست نہیں جب کاٹنے کی شرط نہ ہوئی ہو۔پھلوں کی (پکنے کی)صلاحیت ظاہر ہونے سے پہلے توڑنے کی شرط لگائے بغیر بیع کرنا منع ہے"
"3866","وحَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، وَابْنُ أَبِي عُمَرَ ، قَالَا: حَدَّثَنَا عَبْدُ الْوَهَّابِ ، عَنْ يَحْيَي ، بِهَذَا الْإِسْنَادِ حَتَّى يَبْدُوَ صَلَاحُهُ لَمْ يَذْكُرْ مَا بَعْدَهُ،","Sahih","Sahih Muslim 3866","","","13. باب: میوہ جب تک اس کی صلاحیت کا یقین نہ ہو درخت پر بیچنا درست نہیں جب کاٹنے کی شرط نہ ہوئی ہو۔پھلوں کی (پکنے کی)صلاحیت ظاہر ہونے سے پہلے توڑنے کی شرط لگائے بغیر بیع کرنا منع ہے"
"3867","حَدَّثَنَا ابْنُ رَافِعٍ ، حَدَّثَنَا ابْنُ أَبِي فُدَيْكٍ ، أَخْبَرَنَا الضَّحَّاكُ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، بِمِثْلِ حَدِيثِ عَبْدِ الْوَهَّابِ،","Sahih","Sahih Muslim 3867","","","13. باب: میوہ جب تک اس کی صلاحیت کا یقین نہ ہو درخت پر بیچنا درست نہیں جب کاٹنے کی شرط نہ ہوئی ہو۔پھلوں کی (پکنے کی)صلاحیت ظاہر ہونے سے پہلے توڑنے کی شرط لگائے بغیر بیع کرنا منع ہے"
"3868","حَدَّثَنَا سُوَيْدُ بْنُ سَعِيدٍ ، حَدَّثَنَا حَفْصُ بْنُ مَيْسَرَةَ ، حَدَّثَنِي مُوسَى بْنُ عُقْبَةَ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، بِمِثْلِ حَدِيثِ مَالِكٍ، وَعُبَيْدِ اللَّهِ.","Sahih","Sahih Muslim 3868","","","13. باب: میوہ جب تک اس کی صلاحیت کا یقین نہ ہو درخت پر بیچنا درست نہیں جب کاٹنے کی شرط نہ ہوئی ہو۔پھلوں کی (پکنے کی)صلاحیت ظاہر ہونے سے پہلے توڑنے کی شرط لگائے بغیر بیع کرنا منع ہے"
"3869","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، وَيَحْيَي بْنُ أَيُّوبَ ، وَقُتَيْبَةُ ، وَابْنُ حُجْرٍ ، قَالَ يَحْيَى بْنُ يَحْيَى: أَخْبَرَنَا، وقَالَ الْآخَرُونَ: حَدَّثَنَا إِسْمَاعِيلُ وَهُوَ ابْنُ جَعْفَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ ، أَنَّهُ سَمِعَ ابْنَ عُمَرَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" لَا تَبِيعُوا الثَّمَرَ حَتَّى يَبْدُوَ صَلَاحُهُ """".","Sahih","Sahih Muslim 3869","","","13. باب: میوہ جب تک اس کی صلاحیت کا یقین نہ ہو درخت پر بیچنا درست نہیں جب کاٹنے کی شرط نہ ہوئی ہو۔پھلوں کی (پکنے کی)صلاحیت ظاہر ہونے سے پہلے توڑنے کی شرط لگائے بغیر بیع کرنا منع ہے"
"3870","وحَدَّثَنِيهِ زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا عَبْدُ الرَّحْمَنِ ، عَنْ سُفْيَانَ . ح وَحَدَّثَنَا ابْنُ الْمُثَنَّى ، حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا شُعْبَةُ ، كِلَاهُمَا عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ ، بِهَذَا الْإِسْنَادِ، وَزَادَ فِي حَدِيثِ شُعْبَةَ، فَقِيلَ لِابْنِ عُمَرَ: مَا صَلَاحُهُ؟ قَالَ: تَذْهَبُ عَاهَتُهُ.","Sahih","Sahih Muslim 3870","","","13. باب: میوہ جب تک اس کی صلاحیت کا یقین نہ ہو درخت پر بیچنا درست نہیں جب کاٹنے کی شرط نہ ہوئی ہو۔پھلوں کی (پکنے کی)صلاحیت ظاہر ہونے سے پہلے توڑنے کی شرط لگائے بغیر بیع کرنا منع ہے"
"3871","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، أَخْبَرَنَا أَبُو خَيْثَمَةَ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرٍ . ح وحَدَّثَنَا أَحْمَدُ بْنُ يُونُسَ ، حَدَّثَنَا زُهَيْرٌ ، حَدَّثَنَا أَبُو الزُّبَيْرِ ، عَنْ جَابِرٍ ، قَالَ: "" نَهَى أَوْ نَهَانَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ الثَّمَرِ حَتَّى يَطِيبَ """".","Sahih","Sahih Muslim 3871","","","13. باب: میوہ جب تک اس کی صلاحیت کا یقین نہ ہو درخت پر بیچنا درست نہیں جب کاٹنے کی شرط نہ ہوئی ہو۔پھلوں کی (پکنے کی)صلاحیت ظاہر ہونے سے پہلے توڑنے کی شرط لگائے بغیر بیع کرنا منع ہے"
"3872","حَدَّثَنَا أَحْمَدُ بْنُ عُثْمَانَ النَّوْفَلِيُّ ، حَدَّثَنَا أَبُو عَاصِمٍ . ح حَدَّثَنِي مُحَمَّدُ بْنُ حَاتِمٍ ، وَاللَّفْظُ لَهُ: حَدَّثَنَا رَوْحٌ ، قَالَا: حَدَّثَنَا زَكَرِيَّاءُ بْنُ إِسْحَاقَ ، حَدَّثَنَا عَمْرُو بْنُ دِينَارٍ ، أَنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُول: "" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ الثَّمَرِ حَتَّى يَبْدُوَ صَلَاحُهُ """".","Sahih","Sahih Muslim 3872","","","13. باب: میوہ جب تک اس کی صلاحیت کا یقین نہ ہو درخت پر بیچنا درست نہیں جب کاٹنے کی شرط نہ ہوئی ہو۔پھلوں کی (پکنے کی)صلاحیت ظاہر ہونے سے پہلے توڑنے کی شرط لگائے بغیر بیع کرنا منع ہے"
"3873","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، وَابْنُ بَشَّارٍ ، قَالَا: حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا شُعْبَةُ ، عَنْ عَمْرِو بْنِ مُرَّةَ ، عَنْ أَبِي الْبَخْتَرِيِّ ، قَالَ: سَأَلْتُ ابْنَ عَبَّاسٍ ، عَنْ بَيْعِ النَّخْلِ، فَقَالَ: "" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ النَّخْلِ حَتَّى يَأْكُلَ مِنْهُ، أَوْ يُؤْكَلَ، وَحَتَّى يُوزَنَ """"، قَالَ: فَقُلْتُ: مَا يُوزَنُ؟ فَقَالَ: رَجُلٌ عِنْدَهُ حَتَّى يُحْزَرَ.","Sahih","Sahih Muslim 3873","","","13. باب: میوہ جب تک اس کی صلاحیت کا یقین نہ ہو درخت پر بیچنا درست نہیں جب کاٹنے کی شرط نہ ہوئی ہو۔پھلوں کی (پکنے کی)صلاحیت ظاہر ہونے سے پہلے توڑنے کی شرط لگائے بغیر بیع کرنا منع ہے"
"3874","حَدَّثَنِي أَبُو كُرَيْبٍ مُحَمَّدُ بْنُ الْعَلَاءِ ، حَدَّثَنَا مُحَمَّدُ بْنُ فُضَيْلٍ ، عَنْ أَبِيهِ ، عَنْ ابْنِ أَبِي نُعْمٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" لَا تَبْتَاعُوا الثِّمَارَ حَتَّى يَبْدُوَ صَلَاحُهَا """".","Sahih","Sahih Muslim 3874","","","13. باب: میوہ جب تک اس کی صلاحیت کا یقین نہ ہو درخت پر بیچنا درست نہیں جب کاٹنے کی شرط نہ ہوئی ہو۔پھلوں کی (پکنے کی)صلاحیت ظاہر ہونے سے پہلے توڑنے کی شرط لگائے بغیر بیع کرنا منع ہے"
"3875","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، أَخْبَرَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ الزُّهْرِيِّ . ح وحَدَّثَنَا ابْنُ نُمَيْرٍ ، وَزُهَيْرُ بْنُ حَرْبٍ ، وَاللَّفْظُ لَهُمَا، قَالَا: حَدَّثَنَا سُفْيَانُ ، حَدَّثَنَا الزُّهْرِيُّ ، عَنْ سَالِمٍ ، عَنْ ابْنِ عُمَرَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى عَنْ بَيْعِ الثَّمَرِ حَتَّى يَبْدُوَ صَلَاحُهُ، وَعَنْ بَيْعِ الثَّمَرِ بِالتَّمْرِ """"،","Sahih","Sahih Muslim 3875","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔پھلوں کی (پکنے کی)صلاحیت ظاہر ہونے سے پہلے توڑنے کی شرط لگائے بغیر بیع کرنا منع ہے"
"3876","قَالَ ابْنُ عُمَرَ : وَحَدَّثَنَا زَيْدُ بْنُ ثَابِتٍ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: رَخَّصَ فِي بَيْعِ الْعَرَايَا ""، زَادَ ابْنُ نُمَيْرٍ فِي رِوَايَتِهِ: أَنْ تُبَاعَ.","Sahih","Sahih Muslim 3876","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3877","وحَدَّثَنِي أَبُو الطَّاهِرِ ، وَحَرْمَلَةُ ، وَاللَّفْظُ لِحَرْمَلَةَ، قَالَا: أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي يُونُسُ ، عَنْ ابْنِ شِهَابٍ ، حَدَّثَنِي سَعِيدُ بْنُ الْمُسَيِّبِ ، وَأَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ ، أن أبا هريرة ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" لَا تَبْتَاعُوا الثَّمَرَ حَتَّى يَبْدُوَ صَلَاحُهُ، وَلَا تَبْتَاعُوا الثَّمَرَ بِالتَّمْرِ """". قَالَ ابْنُ شِهَابٍ : وَحَدَّثَنِي سَالِمُ بْنُ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ أَبِيهِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، مِثْلَهُ سَوَاءً.","Sahih","Sahih Muslim 3877","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3878","وَحَدَّثَنِي وَحَدَّثَنِي مُحَمَّدُ بْنُ رَافِعٍ ، حَدَّثَنَا حُجَيْنُ بْنُ الْمُثَنَّى ، حَدَّثَنَا اللَّيْثُ ، عَنْ عُقَيْلٍ ، عَنْ ابْنِ شِهَابٍ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى عَنْ بَيْعِ الْمُزَابَنَةِ وَالْمُحَاقَلَةِ """"، وَالْمُزَابَنَةُ: أَنْ يُبَاعَ ثَمَرُ النَّخْلِ بِالتَّمْرِ، وَالْمُحَاقَلَةُ: أَنْ يُبَاعَ الزَّرْعُ بِالْقَمْحِ، وَاسْتِكْرَاءُ الْأَرْضِ بِالْقَمْحِ، قَالَ: وَأَخْبَرَنِي سَالِمُ بْنُ عَبْدِ اللَّهِ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ: """" لَا تَبْتَاعُوا الثَّمَرَ حَتَّى يَبْدُوَ صَلَاحُهُ، وَلَا تَبْتَاعُوا الثَّمَرَ بِالتَّمْرِ """". وقَالَ سَالِمٌ : أَخْبَرَنِي عَبْدُ اللَّهِ ، عَنْ زَيْدِ بْنِ ثَابِتٍ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: """" أَنَّهُ رَخَّصَ بَعْدَ ذَلِكَ فِي بَيْعِ الْعَرِيَّةِ بِالرُّطَبِ أَوْ بِالتَّمْرِ، وَلَمْ يُرَخِّصْ فِي غَيْرِ ذَلِكَ """".","Sahih","Sahih Muslim 3878","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3879","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، عَنْ زَيْدِ بْنِ ثَابِتٍ : "" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَخَّصَ لِصَاحِبِ الْعَرِيَّةِ أَنْ يَبِيعَهَا بِخَرْصِهَا مِنَ التَّمْرِ """".","Sahih","Sahih Muslim 3879","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3880","وحَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، أَخْبَرَنَا سُلَيْمَانُ بْنُ بِلَالٍ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، أَخْبَرَنِي نَافِعٌ ، أَنَّهُ سَمِعَ عَبْدَ اللَّهِ بْنَ عُمَرَ ، يُحَدِّثُ، أَنَّ زَيْدَ بْنَ ثَابِتٍ ، حَدَّثَهُ: "" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، رَخَّصَ فِي الْعَرِيَّةِ يَأْخُذُهَا أَهْلُ الْبَيْتِ بِخَرْصِهَا تَمْرًا يَأْكُلُونَهَا رُطَبًا """".","Sahih","Sahih Muslim 3880","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3881","وحَدَّثَنَاه مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا عَبْدُ الْوَهَّابِ ، قَال: سَمِعْتُ يَحْيَى بْنَ سَعِيدٍ ، يَقُولُ: أَخْبَرَنِي نَافِعٌ ، بِهَذَا الْإِسْنَادِ مِثْلَهُ،","Sahih","Sahih Muslim 3881","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3882","وحَدَّثَنَاه يَحْيَى بْنُ يَحْيَى ، أَخْبَرَنَا هُشَيْمٌ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، بِهَذَا الْإِسْنَادِ، غَيْرَ أَنَّهُ قَالَ: وَالْعَرِيَّةُ: النَّخْلَةُ تُجْعَلُ لِلْقَوْمِ، فَيَبِيعُونَهَا بِخَرْصِهَا تَمْرًا.","Sahih","Sahih Muslim 3882","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3883","وحَدَّثَنَا مُحَمَّدُ بْنُ رُمْحِ بْنِ الْمُهَاجِرِ ، حَدَّثَنَا اللَّيْثُ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ نَافِعٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، حَدَّثَنِي زَيْدُ بْنُ ثَابِتٍ : "" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، رَخَّصَ فِي بَيْعِ الْعَرِيَّةِ بِخَرْصِهَا تَمْرًا """". قَالَ يَحْيَى: الْعَرِيَّةُ: أَنْ يَشْتَرِيَ الرَّجُلُ ثَمَرَ النَّخَلَاتِ لِطَعَامِ أَهْلِهِ رُطَبًا بِخَرْصِهَا تَمْرًا.","Sahih","Sahih Muslim 3883","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3884","وحَدَّثَنَا ابْنُ نُمَيْرٍ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا عُبَيْدُ اللَّهِ ، حَدَّثَنِي نَافِعٌ ، عَنْ ابْنِ عُمَرَ ، عَنْ زَيْدِ بْنِ ثَابِتٍ : "" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَخَّصَ فِي الْعَرَايَا أَنْ تُبَاعَ بِخَرْصِهَا كَيْلًا """".","Sahih","Sahih Muslim 3884","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3885","وحَدَّثَنَاه ابْنُ الْمُثَنَّى ، حَدَّثَنَا يَحْيَى بْنُ سَعِيدٍ ، عَنْ عُبَيْدِ اللَّهِ، بِهَذَا الْإِسْنَادِ، وَقَالَ: أَنْ تُؤْخَذَ بِخَرْصِهَا،","Sahih","Sahih Muslim 3885","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3886","وحَدَّثَنَا أَبُو الرَّبِيعِ ، وَأَبُو كَامِلٍ ، قَالَا: حَدَّثَنَا حَمَّادٌ . ح وحَدَّثَنِيهِ عَلِيُّ بْنُ حُجْرٍ ، حَدَّثَنَا إِسْمَاعِيلُ ، كِلَاهُمَا عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، بِهَذَا الْإِسْنَادِ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: رَخَّصَ فِي بَيْعِ الْعَرَايَا بِخَرْصِهَا.","Sahih","Sahih Muslim 3886","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3887","وحَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ الْقَعْنَبِيُّ ، حَدَّثَنَا سُلَيْمَانُ يَعْنِي ابْنَ بِلَالٍ ، عَنْ يَحْيَى وَهُوَ ابْنُ سَعِيدٍ ، عَنْ بُشَيْرِ بْنِ يَسَارٍ ، عَنْ بَعْضِ أَصْحَابِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ أَهْلِ دَارِهِمْ مِنْهُمْ سَهْلُ بْنُ أَبِي حَثْمَةَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى عَنْ بَيْعِ الثَّمَرِ بِالتَّمْرِ، وَقَالَ: ذَلِكَ الرِّبَا، تِلْكَ الْمُزَابَنَةُ """"، إِلَّا أَنَّهُ رَخَّصَ فِي بَيْعِ الْعَرِيَّةِ النَّخْلَةِ وَالنَّخْلَتَيْنِ، يَأْخُذُهَا أَهْلُ الْبَيْتِ بِخَرْصِهَا تَمْرًا يَأْكُلُونَهَا رُطَبًا """".","Sahih","Sahih Muslim 3887","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3888","وحَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ . ح وَحَدَّثَنَا ابْنُ رُمْحٍ ، أَخْبَرَنَا اللَّيْثُ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ بُشَيْرِ بْنِ يَسَارٍ ، عَنْ أَصْحَابِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، أَنَّهُمْ قَالُوا: "" رَخَّصَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي بَيْعِ الْعَرِيَّةِ بِخَرْصِهَا تَمْرًا """".","Sahih","Sahih Muslim 3888","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3889","وحَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ ، وَابْنُ أَبِي عُمَرَ ، جَمِيعًا عَنْ الثَّقَفِيِّ ، قَالَ: سَمِعْتُ يَحْيَى بْنَ سَعِيدٍ ، يَقُولُ: أَخْبَرَنِي بُشَيْرُ بْنُ يَسَارٍ ، عَنْ بَعْضِ أَصْحَابِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ أَهْلِ دَارِهِ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَى، فَذَكَرَ بِمِثْلِ حَدِيثِ سُلَيْمَانَ بْنِ بِلَالٍ، عَنْ يَحْيَى، غَيْرَ أَنَّ إِسْحَاقَ، وَابْنَ الْمُثَنَّى جَعَلَا مَكَانَ الرِّبَا: الزَّبْنَ، وقَالَ ابْنُ أَبِي عُمَرَ: الرِّبَا.","Sahih","Sahih Muslim 3889","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3890","وحَدَّثَنَاه عَمْرٌو النَّاقِدُ ، وَابْنُ نُمَيْرٍ ، قَالَا: حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ بُشَيْرِ بْنِ يَسَارٍ ، عَنْ سَهْلِ بْنِ أَبِي حَثْمَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، نَحْوَ حَدِيثِهِمْ.","Sahih","Sahih Muslim 3890","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3891","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَحَسَنٌ الْحُلْوَانِيُّ ، قَالَا: حَدَّثَنَا أَبُو أُسَامَةَ ، عَنْ الْوَلِيدِ بْنِ كَثِيرٍ ، حَدَّثَنِي بُشَيْرُ بْنُ يَسَارٍ مَوْلَى بَنِي حَارِثَةَ، أَنَّ رَافِعَ بْنَ خَدِيجٍ ، وَسَهْلَ بْنَ أَبِي حَثْمَةَ ، حَدَّثَاهُ: أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى عَنِ الْمُزَابَنَةِ الثَّمَرِ بِالتَّمْرِ، إِلَّا أَصْحَابَ الْعَرَايَا، فَإِنَّهُ قَدْ أَذِنَ لَهُمْ """".","Sahih","Sahih Muslim 3891","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3892","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ بْنِ قَعْنَبٍ ، حَدَّثَنَا مَالِكٌ . ح وحَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، وَاللَّفْظُ لَهُ، قَالَ: قُلْتُ لِمَالِكٍ : حَدَّثَكَ دَاوُدُ بْنُ الْحُصَيْنِ ، عَنْ أَبِي سُفْيَانَ مَوْلَى ابْنِ أَبِي أَحْمَدَ، عَنْ أَبِي هُرَيْرَةَ : "" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، رَخَّصَ فِي بَيْعِ الْعَرَايَا بِخَرْصِهَا فِيمَا دُونَ خَمْسَةِ أَوْسُقٍ، أَوْ فِي خَمْسَةِ """"، يَشُكُّ دَاوُدُ، قَالَ: خَمْسَةٌ أَوْ دُونَ خَمْسَةٍ، قَالَ: نَعَمْ.","Sahih","Sahih Muslim 3892","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3893","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى التَّمِيمِيُّ ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى عَنِ الْمُزَابَنَةِ """"، وَالْمُزَابَنَةُ: بَيْعُ الثَّمَرِ بِالتَّمْرِ كَيْلًا، وَبَيْعُ الْكَرْمِ بِالزَّبِيبِ كَيْلًا """".","Sahih","Sahih Muslim 3893","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3894","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَمُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، قَالَا: حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا عُبَيْدُ اللَّهِ ، عَنْ نَافِعٍ ، أَنَّ عَبْدَ اللَّهِ ، أَخْبَرَهُ: أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى عَنِ الْمُزَابَنَةِ بَيْعِ ثَمَرِ النَّخْلِ بِالتَّمْرِ كَيْلًا، وَبَيْعِ الْعِنَبِ بِالزَّبِيبِ كَيْلًا، وَبَيْعِ الزَّرْعِ بِالْحِنْطَةِ كَيْلًا """".","Sahih","Sahih Muslim 3894","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3895","وحَدَّثَنَاه أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا ابْنُ أَبِي زَائِدَةَ ، عَنْ عُبَيْدِ اللَّهِ ، بِهَذَا الْإِسْنَادِ مِثْلَهُ.","Sahih","Sahih Muslim 3895","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3896","حَدَّثَنِي يَحْيَى بْنُ مَعِينٍ ، وَهَارُونُ بْنُ عَبْدِ اللَّهِ ، وَحُسَيْنُ بْنُ عِيسَى ، قَالُوا: حَدَّثَنَا أَبُو أُسَامَةَ ، حَدَّثَنَا عُبَيْدُ اللَّهِ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، قَالَ: "" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الْمُزَابَنَةِ، وَالْمُزَابَنَةُ: بَيْعُ ثَمَرِ النَّخْلِ بِالتَّمْرِ كَيْلًا، وَبَيْعُ الزَّبِيبِ بِالْعِنَبِ كَيْلًا، وَعَنْ كُلِّ ثَمَرٍ بِخَرْصِهِ """".","Sahih","Sahih Muslim 3896","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3897","حَدَّثَنِي عَلِيُّ بْنُ حُجْرٍ السَّعْدِيُّ ، وَزُهَيْرُ بْنُ حَرْبٍ ، قَالَا: حَدَّثَنَا إِسْمَاعِيلُ وَهُوَ ابْنُ إِبْرَاهِيمَ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى عَنْ: الْمُزَابَنَةِ، وَالْمُزَابَنَةُ: أَنْ يُبَاعَ مَا فِي رُءُوسِ النَّخْلِ بِتَمْرٍ بِكَيْلٍ مُسَمَّى، إِنْ زَادَ فَلِي، وَإِنْ نَقَصَ فَعَلَيَّ """".","Sahih","Sahih Muslim 3897","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3898","وحَدَّثَنَاه أَبُو الرَّبِيعِ ، وَأَبُو كَامِلٍ ، قَالَا: حَدَّثَنَا حَمَّادٌ ، حَدَّثَنَا أَيُّوبُ ، بِهَذَا الْإِسْنَادِ نَحْوَهُ.","Sahih","Sahih Muslim 3898","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3899","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ . ح وَحَدَّثَنِي مُحَمَّدُ بْنُ رُمْحٍ ، أَخْبَرَنَا اللَّيْثُ ، عَنْ نَافِعٍ ، عَنْ عَبْدِ اللَّهِ ، قَالَ: "" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الْمُزَابَنَةِ أَنْ يَبِيعَ ثَمَرَ حَائِطِهِ، إِنْ كَانَتْ نَخْلًا بِتَمْرٍ كَيْلًا، وَإِنْ كَانَ كَرْمًا أَنْ يَبِيعَهُ بِزَبِيبٍ كَيْلًا، وَإِنْ كَانَ زَرْعًا أَنْ يَبِيعَهُ بِكَيْلِ طَعَامٍ، نَهَى عَنْ ذَلِكَ كُلِّهِ """"، وَفِي رِوَايَةِ قُتَيْبَةَ: أَوْ كَانَ زَرْعًا.","Sahih","Sahih Muslim 3899","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3900","وحَدَّثَنِيهِ أَبُو الطَّاهِرِ ، أَخْبَرَنَا ابْنُ وَهْبٍ ، حَدَّثَنِي يُونُسُ . ح وحَدَّثَنِي ابْنُ رَافِعٍ ، حَدَّثَنَا ابْنُ أَبِي فُدَيْكٍ ، أَخْبَرَنِي الضَّحَّاكُ . ح وحَدَّثَنِيهِ سُوَيْدُ بْنُ سَعِيدٍ ، حَدَّثَنَا حَفْصُ بْنُ مَيْسَرَةَ ، حَدَّثَنِي مُوسَى بْنُ عُقْبَةَ ، كُلُّهُمْ عَنْ نَافِعٍ ، بِهَذَا الْإِسْنَادِ نَحْوَ حَدِيثِهِمْ.","Sahih","Sahih Muslim 3900","","","14. باب: تر کھجور کو خشک کھجور کے بدلے بیچنا حرام ہے مگر عریہ میں درست ہے۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3901","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" مَنْ بَاعَ نَخْلًا قَدْ أُبِّرَتْ، فَثَمَرَتُهَا لِلْبَائِعِ، إِلَّا أَنْ يَشْتَرِطَ الْمُبْتَاعُ """".","Sahih","Sahih Muslim 3901","","","15. باب: جو شخص کھجور کا درخت بیچے اور اس پر کھجور لگی ہو۔عرایا کے سوا تازہ کھجور کو خشک کھجور کے عوض بیچنا حرام ہے"
"3902","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا يَحْيَى بْنُ سَعِيدٍ . ح وحَدَّثَنَا ابْنُ نُمَيْرٍ ، حَدَّثَنَا أَبِي ، جَمِيعًا عَنْ عُبَيْدِ اللَّهِ . ح وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَاللَّفْظُ لَهُ: حَدَّثَنَا مُحَمَّدُ بْنُ بِشْر ، حَدَّثَنَا عُبَيْدُ اللَّهِ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" أَيُّمَا نَخْلٍ اشْتُرِيَ أُصُولُهَا وَقَدْ أُبِّرَتْ، فَإِنَّ ثَمَرَهَا لِلَّذِي أَبَّرَهَا، إِلَّا أَنْ يَشْتَرِطَ الَّذِي اشْتَرَاهَا """".","Sahih","Sahih Muslim 3902","","","15. باب: جو شخص کھجور کا درخت بیچے اور اس پر کھجور لگی ہو۔جو شخص کھجور کا ایسا درخت فروخت کرے جس پر پھل لگا ہو"
"3903","وحَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ . ح وحَدَّثَنَا ابْنُ رُمْحٍ ، أَخْبَرَنَا اللَّيْثُ ، عن نَافِعٍ ، عَنْ ابْنِ عُمَرَ : أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" أَيُّمَا امْرِئٍ أَبَّرَ نَخْلًا، ثُمَّ بَاعَ أَصْلَهَا، فَلِلَّذِي أَبَّرَ ثَمَرُ النَّخْلِ إِلَّا أَنْ يَشْتَرِطَ الْمُبْتَاعُ """".","Sahih","Sahih Muslim 3903","","","15. باب: جو شخص کھجور کا درخت بیچے اور اس پر کھجور لگی ہو۔جو شخص کھجور کا ایسا درخت فروخت کرے جس پر پھل لگا ہو"
"3904","وحَدَّثَنَاه أَبُو الرَّبِيعِ ، وَأَبُو كَامِلٍ ، قَالَا: حَدَّثَنَا حَمَّادٌ . ح وحَدَّثَنِيهِ زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا إِسْمَاعِيلُ ، كِلَاهُمَا عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، بِهَذَا الْإِسْنَادِ نَحْوَهُ.","Sahih","Sahih Muslim 3904","","","15. باب: جو شخص کھجور کا درخت بیچے اور اس پر کھجور لگی ہو۔جو شخص کھجور کا ایسا درخت فروخت کرے جس پر پھل لگا ہو"
"3905","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، وَمُحَمَّدُ بْنُ رُمْحٍ ، قَالَا: أَخْبَرَنَا اللَّيْثُ . ح وحَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا لَيْثٌ ، عَنْ ابْنِ شِهَابٍ ، عَنْ سَالِمِ بْنِ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، قَالَ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: "" مَنِ ابْتَاعَ نَخْلًا بَعْدَ أَنْ تُؤَبَّرَ، فَثَمَرَتُهَا لِلَّذِي بَاعَهَا، إِلَّا أَنْ يَشْتَرِطَ الْمُبْتَاعُ، وَمَنِ ابْتَاعَ عَبْدًا، فَمَالُهُ لِلَّذِي بَاعَهُ، إِلَّا أَنْ يَشْتَرِطَ الْمُبْتَاعُ """".","Sahih","Sahih Muslim 3905","","","15. باب: جو شخص کھجور کا درخت بیچے اور اس پر کھجور لگی ہو۔جو شخص کھجور کا ایسا درخت فروخت کرے جس پر پھل لگا ہو"
"3906","وحَدَّثَنَاه يَحْيَى بْنُ يَحْيَى ، وَأَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَزُهَيْرُ بْنُ حَرْبٍ ، قَالَ يَحْيَى: أَخْبَرَنَا، وَقَالَ الْآخَرَانِ: حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ الزُّهْرِيِّ ، بِهَذَا الْإِسْنَادِ مِثْلَهُ،","Sahih","Sahih Muslim 3906","","","15. باب: جو شخص کھجور کا درخت بیچے اور اس پر کھجور لگی ہو۔جو شخص کھجور کا ایسا درخت فروخت کرے جس پر پھل لگا ہو"
"3907","وحَدَّثَنِي حَرْمَلَةُ بْنُ يَحْيَى ، أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي يُونُسُ ، عَنْ ابْنِ شِهَابٍ ، حَدَّثَنِي سَالِمُ بْنُ عَبْدِ اللَّهِ بْنِ عُمَرَ ، أَنَّ أَبَاهُ ، قَالَ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ بِمِثْلِهِ.","Sahih","Sahih Muslim 3907","","","15. باب: جو شخص کھجور کا درخت بیچے اور اس پر کھجور لگی ہو۔جو شخص کھجور کا ایسا درخت فروخت کرے جس پر پھل لگا ہو"
"3908","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَمُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، وَزُهَيْرُ بْنُ حَرْبٍ ، قَالُوا جَمِيعًا: حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، قَالَ: "" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّم عَنْ: الْمُحَاقَلَةِ، وَالْمُزَابَنَةِ، وَالْمُخَابَرَةِ، وَعَنْ بَيْعِ الثَّمَرِ حَتَّى يَبْدُوَ صَلَاحُهُ، وَلَا يُبَاعُ إِلَّا بِالدِّينَارِ وَالدِّرْهَمِ، إِلَّا الْعَرَايَا """".","Sahih","Sahih Muslim 3908","","","16. باب: محاقلہ اور مزابنہ اور مخابرہ کی ممانعت اور پھل کی بیع قبل صلاحیت کے اور معاومہ کا منع ہونا۔جو شخص کھجور کا ایسا درخت فروخت کرے جس پر پھل لگا ہو"
"3909","وحَدَّثَنَا عَبْدُ بْنُ حُمَيْدٍ ، أَخْبَرَنَا أَبُو عَاصِمٍ ، أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ ، وَأَبِي الزُّبَيْرِ ، أَنَّهُمَا سَمِعَا جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ: نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَذَكَرَ بِمِثْلِهِ.","Sahih","Sahih Muslim 3909","","","16. باب: محاقلہ اور مزابنہ اور مخابرہ کی ممانعت اور پھل کی بیع قبل صلاحیت کے اور معاومہ کا منع ہونا۔بیع محاقلہ ‘مزانبہ ‘مخابرہ ‘صلاحیت ظاہر ہونے سے پہلے پھلو ں کو بیچنا اور بیع معاومہ یعنی کئی سالوں کے لیے (درخت کا پھل )بیچ دینا ممنوع ہے"
"3910","حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ الْحَنْظَلِيُّ ، أَخْبَرَنَا مَخْلَدُ بْنُ يَزِيدَ الْجَزَرِيُّ ، حَدَّثَنَا ابْنُ جُرَيْجٍ ، أَخْبَرَنِي عَطَاءٌ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى عَنِ الْمُخَابَرَةِ، وَالْمُحَاقَلَةِ، وَالْمُزَابَنَةِ، وَعَنْ بَيْعِ الثَّمَرَةِ حَتَّى تُطْعِمَ، وَلَا تُبَاعُ إِلَّا بِالدَّرَاهِمِ وَالدَّنَانِيرِ، إِلَّا الْعَرَايَا """". قَالَ عَطَاءٌ: فَسَّرَ لَنَا جَابِرٌ، قَالَ: أَمَّا الْمُخَابَرَةُ: فَالْأَرْضُ الْبَيْضَاءُ، يَدْفَعُهَا الرَّجُلُ إِلَى الرَّجُل، فَيُنْفِقُ فِيهَا، ثُمَّ يَأْخُذُ مِنَ الثَّمَرِ، وَزَعَمَ أَنَّ الْمُزَابَنَةَ: بَيْعُ الرُّطَبِ فِي النَّخْلِ بِالتَّمْرِ كَيْلًا، وَالْمُحَاقَلَةُ فِي الزَّرْعِ: عَلَى نَحْوِ ذَلِكَ يَبِيعُ الزَّرْعَ الْقَائِمَ بِالْحَبِّ كَيْلًا.","Sahih","Sahih Muslim 3910","","","16. باب: محاقلہ اور مزابنہ اور مخابرہ کی ممانعت اور پھل کی بیع قبل صلاحیت کے اور معاومہ کا منع ہونا۔بیع محاقلہ ‘مزانبہ ‘مخابرہ ‘صلاحیت ظاہر ہونے سے پہلے پھلو ں کو بیچنا اور بیع معاومہ یعنی کئی سالوں کے لیے (درخت کا پھل )بیچ دینا ممنوع ہے"
"3911","حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، وَمُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَلَفٍ، كِلَاهُمَا، عَنْ زَكَرِيَّاءَ، قَالَ ابْنُ خَلَفٍ ، حَدَّثَنَا زَكَرِيَّاءُ بْنُ عَدِيٍّ ، أَخْبَرَنَا عُبَيْدُ اللَّهِ ، عَنْ زَيْدِ بْنِ أَبِي أُنَيْسَةَ ، حَدَّثَنَا أَبُو الْوَلِيدِ الْمَكِّيُّ ، وَهُوَ جَالِسٌ عِنْدَ عَطَاءِ بْنِ أَبِي رَبَاحٍ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى عَنِ الْمُحَاقَلَةِ، وَالْمُزَابَنَةِ، وَالْمُخَابَرَةِ، وَأَنْ تُشْتَرَى النَّخْلُ حَتَّى تُشْقِهَ """"، وَالْإِشْقَاهُ: أَنْ يَحْمَرَّ، أَوْ يَصْفَرَّ، أَوْ يُؤْكَلَ مِنْهُ شَيْءٌ، وَالْمُحَاقَلَةُ: أَنْ يُبَاعَ الْحَقْلُ بِكَيْلٍ مِنَ الطَّعَامِ مَعْلُومٍ، وَالْمُزَابَنَةُ: أَنْ يُبَاعَ النَّخْلُ بِأَوْسَاقٍ مِنَ التَّمْرِ، وَالْمُخَابَرَةُ: الثُّلُثُ وَالرُّبُعُ وَأَشْبَاهُ ذَلِكَ، قَالَ زَيْدٌ: قُلْتُ لِعَطَاءِ بْنِ أَبِي رَبَاحٍ : أَسَمِعْتَ جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَذْكُرُ هَذَا، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ؟ قَالَ: نَعَمْ.","Sahih","Sahih Muslim 3911","","","16. باب: محاقلہ اور مزابنہ اور مخابرہ کی ممانعت اور پھل کی بیع قبل صلاحیت کے اور معاومہ کا منع ہونا۔بیع محاقلہ ‘مزانبہ ‘مخابرہ ‘صلاحیت ظاہر ہونے سے پہلے پھلو ں کو بیچنا اور بیع معاومہ یعنی کئی سالوں کے لیے (درخت کا پھل )بیچ دینا ممنوع ہے"
"3912","وحَدَّثَنَا عَبْدُ اللَّهِ بْنُ هَاشِمٍ ، حَدَّثَنَا بَهْزٌ ، حَدَّثَنَا سَلِيمُ بْنُ حَيَّانَ ، حَدَّثَنَا سَعِيدُ بْنُ مِينَاءَ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، قَالَ: "" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ: الْمُزَابَنَةِ، وَالْمُحَاقَلَةِ، وَالْمُخَابَرَةِ، وَعَنْ بَيْعِ الثَّمَرَةِ حَتَّى تُشْقِحَ """"، قَالَ: قُلْتُ لِسَعِيدٍ: مَا تُشْقِحُ؟ قَالَ: تَحْمَارُّ، وَتَصْفَارُّ، وَيُؤْكَلُ مِنْهَا.","Sahih","Sahih Muslim 3912","","","16. باب: محاقلہ اور مزابنہ اور مخابرہ کی ممانعت اور پھل کی بیع قبل صلاحیت کے اور معاومہ کا منع ہونا۔بیع محاقلہ ‘مزانبہ ‘مخابرہ ‘صلاحیت ظاہر ہونے سے پہلے پھلو ں کو بیچنا اور بیع معاومہ یعنی کئی سالوں کے لیے (درخت کا پھل )بیچ دینا ممنوع ہے"
"3913","حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ، وَمُحَمَّدُ بْنُ عُبَيْدٍ الْغُبَرِيُّ ، وَاللَّفْظُ لِعُبَيْدِ اللَّهِ، قَالَا: حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ ، حَدَّثَنَا أَيُّوبُ ، عَنْ أَبِي الزُّبَيْرِ ، وَسَعِيدِ بْنِ مِينَاءَ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، قَالَ: "" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ: الْمُحَاقَلَةِ، وَالْمُزَابَنَةِ، وَالْمُعَاوَمَةِ، وَالْمُخَابَرَةِ، قَالَ أَحَدُهُمَا: بَيْعُ السِّنِينَ هِيَ: الْمُعَاوَمَةُ، وَعَنِ الثُّنْيَا، وَرَخَّصَ فِي الْعَرَايَا """".","Sahih","Sahih Muslim 3913","","","16. باب: محاقلہ اور مزابنہ اور مخابرہ کی ممانعت اور پھل کی بیع قبل صلاحیت کے اور معاومہ کا منع ہونا۔بیع محاقلہ ‘مزانبہ ‘مخابرہ ‘صلاحیت ظاہر ہونے سے پہلے پھلو ں کو بیچنا اور بیع معاومہ یعنی کئی سالوں کے لیے (درخت کا پھل )بیچ دینا ممنوع ہے"
"3914","وحَدَّثَنَاه أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَعَلِيُّ بْنُ حُجْرٍ ، قَالَا: حَدَّثَنَا إِسْمَاعِيلُ وَهُوَ ابْنُ عُلَيَّةَ ، عَنْ أَيُّوبَ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، بِمِثْلِهِ غَيْرَ أَنَّهُ لَا يَذْكُرُ بَيْعُ السِّنِينَ: هِيَ الْمُعَاوَمَةُ.","Sahih","Sahih Muslim 3914","","","16. باب: محاقلہ اور مزابنہ اور مخابرہ کی ممانعت اور پھل کی بیع قبل صلاحیت کے اور معاومہ کا منع ہونا۔بیع محاقلہ ‘مزانبہ ‘مخابرہ ‘صلاحیت ظاہر ہونے سے پہلے پھلو ں کو بیچنا اور بیع معاومہ یعنی کئی سالوں کے لیے (درخت کا پھل )بیچ دینا ممنوع ہے"
"3915","وحَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ عَبْدِ الْمَجِيدِ ، حَدَّثَنَا رَبَاحُ بْنُ أَبِي مَعْرُوفٍ ، قَالَ: سَمِعْتُ عَطَاءً ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، قَالَ: "" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ كِرَاءِ الْأَرْضِ، وَعَنْ بَيْعِهَا السِّنِينَ، وَعَنْ بَيْعِ الثَّمَرِ حَتَّى يَطِيبَ """".","Sahih","Sahih Muslim 3915","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔بیع محاقلہ ‘مزانبہ ‘مخابرہ ‘صلاحیت ظاہر ہونے سے پہلے پھلو ں کو بیچنا اور بیع معاومہ یعنی کئی سالوں کے لیے (درخت کا پھل )بیچ دینا ممنوع ہے"
"3916","وحَدَّثَنِي أَبُو كَامِلٍ الْجَحْدَرِيُّ ، حَدَّثَنَا حَمَّادٌ يَعْنِي ابْنَ زَيْدٍ ، عَنْ مَطَرٍ الْوَرَّاقِ ، عَنْ عَطَاءٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى عَنْ كِرَاءِ الْأَرْضِ """".","Sahih","Sahih Muslim 3916","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔بیع محاقلہ ‘مزانبہ ‘مخابرہ ‘صلاحیت ظاہر ہونے سے پہلے پھلو ں کو بیچنا اور بیع معاومہ یعنی کئی سالوں کے لیے (درخت کا پھل )بیچ دینا ممنوع ہے"
"3917","وحَدَّثَنَا عَبْدُ بْنُ حُمَيْدٍ ، حَدَّثَنَا مُحَمَّدُ بْنُ الْفَضْلِ لَقَبُهُ عَارِمٌ وَهُوَ أَبُو النُّعْمَانِ السَّدُوسِيُّ ، حَدَّثَنَا مَهْدِيُّ بْنُ مَيْمُونٍ ، حَدَّثَنَا مَطَرٌ الْوَرَّاقُ ، عَنْ عَطَاءٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" مَنْ كَانَتْ لَهُ أَرْضٌ، فَلْيَزْرَعْهَا، فَإِنْ لَمْ يَزْرَعْهَا، فَلْيُزْرِعْهَا أَخَاهُ """".","Sahih","Sahih Muslim 3917","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3918","حَدَّثَنَا الْحَكَمُ بْنُ مُوسَى ، حَدَّثَنَا هِقْلٌ يَعْنِي ابْنَ زِيَادٍ ، عَنْ الْأَوْزَاعِيِّ ، عَنْ عَطَاءٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، قَالَ: كَانَ لِرِجَالٍ فُضُولُ أَرَضِينَ مِنْ أَصْحَابِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" مَنْ كَانَتْ لَهُ فَضْلُ أَرْضٍ، فَلْيَزْرَعْهَا، أَوْ لِيَمْنَحْهَا أَخَاهُ، فَإِنْ أَبَى، فَلْيُمْسِكْ أَرْضَهُ """".","Sahih","Sahih Muslim 3918","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3919","وحَدَّثَنِي مُحَمَّدُ بْنُ حَاتِمٍ ، حَدَّثَنَا مُعَلَّى بْنُ مَنْصُورٍ الرَّازِيُّ ، حَدَّثَنَا خَالِدٌ ، أَخْبَرَنَا الشَّيْبَانِيُّ ، عَنْ بُكَيْرِ بْنِ الْأَخْنَسِ ، عَنْ عَطَاءٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، قَالَ: "" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يُؤْخَذَ لِلْأَرْضِ أَجْرٌ، أَوْ حَظٌّ """".","Sahih","Sahih Muslim 3919","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3920","حَدَّثَنَا ابْنُ نُمَيْرٍ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا عَبْدُ الْمَلِكِ ، عَنْ عَطَاءٍ ، عَنْ جَابِرٍ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" مَنْ كَانَتْ لَهُ أَرْضٌ، فَلْيَزْرَعْهَا، فَإِنْ لَمْ يَسْتَطِعْ أَنْ يَزْرَعَهَا وَعَجَزَ عَنْهَا، فَلْيَمْنَحْهَا أَخَاهُ الْمُسْلِمَ، وَلَا يُؤَاجِرْهَا إِيَّاهُ """".","Sahih","Sahih Muslim 3920","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3921","وحَدَّثَنَا شَيْبَانُ بْنُ فَرُّوخَ ، حَدَّثَنَا هَمَّامٌ ، قَالَ: سَأَلَ سُلَيْمَانُ بْنُ مُوسَى عَطَاءً ، فَقَالَ: أَحَدَّثَكَ جَابِرُ بْنُ عَبْدِ اللَّهِ : أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" مَنْ كَانَتْ لَهُ أَرْضٌ، فَلْيَزْرَعْهَا، أَوْ لِيُزْرِعْهَا أَخَاهُ، وَلَا يُكْرِهَا """"، قَالَ: نَعَمْ.","Sahih","Sahih Muslim 3921","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3922","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا سُفْيَانُ ، عَنْ عَمْرٍو ، عَنْ جَابِرٍ : أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى عَنِ الْمُخَابَرَةِ """".","Sahih","Sahih Muslim 3922","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3923","وحَدَّثَنِي حَجَّاجُ بْنُ الشَّاعِرِ ، حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ عَبْدِ الْمَجِيدِ ، حَدَّثَنَا سَلِيمُ بْنُ حَيَّانَ ، حَدَّثَنَا سَعِيدُ بْنُ مِينَاءَ ، قَالَ: سَمِعْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ: إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" مَنْ كَانَ لَهُ فَضْلُ أَرْضٍ، فَلْيَزْرَعْهَا، أَوْ لِيُزْرِعْهَا أَخَاهُ، وَلَا تَبِيعُوهَا """"، فَقُلْتُ لِسَعِيدٍ: مَا قَوْلُهُ: وَلَا تَبِيعُوهَا: يَعْنِي الْكِرَاء، قَالَ: نَعَمْ.","Sahih","Sahih Muslim 3923","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3924","حَدَّثَنَا أَحْمَدُ بْنُ يُونُسَ ، حَدَّثَنَا زُهَيْرٌ ، حَدَّثَنَا أَبُو الزُّبَيْرِ ، عَنْ جَابِرٍ ، قَالَ: كُنَّا نُخَابِرُ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَنُصِيبُ مِنَ الْقِصْرِيِّ، وَمِنْ كَذَا، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" مَنْ كَانَتْ لَهُ أَرْضٌ، فَلْيَزْرَعْهَا، أَوْ فَلْيُحْرِثْهَا أَخَاهُ، وَإِلَّا فَلْيَدَعْهَا """".","Sahih","Sahih Muslim 3924","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3925","حَدَّثَنِي أَبُو الطَّاهِرِ ، وَأَحْمَدُ بْنُ عِيسَى ، جميعا عَنْ ابْنِ وَهْبٍ ، قَالَ ابْنُ عِيسَى، حَدَّثَنَا عَبْدُ اللَّهِ بْنُ وَهْبٍ، حَدَّثَنِي هِشَامُ بْنُ سَعْدٍ ، أَنَّ أَبَا الزُّبَيْرِ الْمَكِّيّ ، حَدَّثَهُ، قَالَ: سَمِعْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ: كُنَّا فِي زَمَانِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَأْخُذُ الْأَرْضَ بِالثُّلُثِ، أَوِ الرُّبُعِ بِالْمَاذِيَانَاتِ، فَقَامَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي ذَلِكَ فَقَالَ: "" مَنْ كَانَتْ لَهُ أَرْضٌ، فَلْيَزْرَعْهَا، فَإِنْ لَمْ يَزْرَعْهَا، فَلْيَمْنَحْهَا أَخَاهُ، فَإِنْ لَمْ يَمْنَحْهَا أَخَاهُ، فَلْيُمْسِكْهَا """".","Sahih","Sahih Muslim 3925","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3926","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا يَحْيَى بْنُ حَمَّادٍ ، حَدَّثَنَا أَبُو عَوَانَةَ ، عَنْ سُلَيْمَانَ ، حَدَّثَنَا أَبُو سُفْيَانَ ، عَنْ جَابِرٍ ، قَالَ: سَمِعْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: "" مَنْ كَانَتْ لَهُ أَرْضٌ، فَلْيَهَبْهَا أَوْ لِيُعِرْهَا """".","Sahih","Sahih Muslim 3926","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3927","وحَدَّثَنِيهِ حَجَّاجُ بْنُ الشَّاعِرِ ، حَدَّثَنَا أَبُو الْجَوَّابِ ، حَدَّثَنَا عَمَّارُ بْنُ رُزَيْقٍ ، عَنْ الْأَعْمَشِ ، بِهَذَا الْإِسْنَادِ، غَيْرَ أَنَّهُ قَالَ: فَلْيَزْرَعْهَا، أَوْ فَلْيُزْرِعْهَا رَجُلًا.","Sahih","Sahih Muslim 3927","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3928","وحَدَّثَنِي هَارُونُ بْنُ سَعِيدٍ الْأَيْلِيُّ ، حَدَّثَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي عَمْرٌو وَهُوَ ابْنُ الْحَارِثِ ، أَنَّ بُكَيْرًا ، حَدَّثَهُ: أَنَّ عَبْدَ اللَّهِ بْنَ أَبِي سَلَمَةَ ، حَدَّثَهُ، عَنْ النُّعْمَانِ بْنِ أَبِي عَيَّاشٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى عَنْ كِرَاءِ الْأَرْضِ """". قَالَ بُكَيْرٌ : وَحَدَّثَنِي نَافِعٌ ، أَنَّهُ سَمِعَ ابْنَ عُمَرَ ، يَقُولُ: كُنَّا نُكْرِي أَرْضَنَا، ثُمَّ تَرَكْنَا ذَلِكَ حِينَ سَمِعْنَا حَدِيثَ رَافِعِ بْنِ خَدِيجٍ.","Sahih","Sahih Muslim 3928","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3929","وحَدَّثَنَاه يَحْيَى بْنُ يَحْيَى ، أَخْبَرَنَا أَبُو خَيْثَمَةَ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرٍ ، قَالَ: "" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ الْأَرْضِ الْبَيْضَاءِ سَنَتَيْنِ أَوْ ثَلَاثًا """".","Sahih","Sahih Muslim 3929","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3930","وحَدَّثَنَا سَعِيدُ بْنُ مَنْصُورٍ ، وَأَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَعَمْرٌو النَّاقِدُ ، وَزُهَيْرُ بْنُ حَرْبٍ ، قَالُوا: حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ حُمَيْدٍ الْأَعْرَجِ ، عَنْ سُلَيْمَانَ بْنِ عَتِيقٍ ، عَنْ جَابِرٍ ، قَالَ: "" نَهَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ السِّنِينَ """"، وَفِي رِوَايَةِ ابْنِ أَبِي شَيْبَةَ: عَنْ بَيْعِ الثَّمَرِ سِنِينَ.","Sahih","Sahih Muslim 3930","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3931","حَدَّثَنَا حَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ، حَدَّثَنَا أَبُو تَوْبَةَ ، حَدَّثَنَا مُعَاوِيَةُ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" مَنْ كَانَتْ لَهُ أَرْضٌ، فَلْيَزْرَعْهَا، أَوْ لِيَمْنَحْهَا أَخَاهُ، فَإِنْ أَبَى، فَلْيُمْسِكْ أَرْضَهُ """".","Sahih","Sahih Muslim 3931","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3932","وحَدَّثَنَا الْحَسَنُ الْحُلْوَانِيُّ ، حَدَّثَنَا أَبُو تَوْبَةَ ، حَدَّثَنَا مُعَاوِيَةُ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، أَنَّ يَزِيدَ بْنَ نُعَيْمٍ ، أَخْبَرَهُ، أَنَّ جَابِرَ بْنَ عَبْدِ اللَّهِ ، أَخْبَرَهُ: أَنَّهُ سَمِعَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" يَنْهَى عَنْ: الْمُزَابَنَةِ، وَالْحُقُولِ """"، فَقَالَ جَابِرُ بْنُ عَبْدِ اللَّهِ: الْمُزَابَنَةُ: الثَّمَرُ بِالتَّمْرِ، وَالْحُقُولُ: كِرَاءُ الْأَرْضِ.","Sahih","Sahih Muslim 3932","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3933","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا يَعْقُوبُ يَعْنِي ابْنَ عَبْدِ الرَّحْمَنِ الْقَارِيَّ ، عَنْ سُهَيْلِ بْنِ أَبِي صَالِحٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ: "" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ: الْمُحَاقَلَةِ، وَالْمُزَابَنَةِ """".","Sahih","Sahih Muslim 3933","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3934","وحَدَّثَنِي أَبُو الطَّاهِرِ ، أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي مَالِكُ بْنُ أَنَسٍ ، عَنْ دَاوُدَ بْنِ الْحُصَيْنِ ، أَنَّ أَبَا سُفْيَانَ مَوْلَى ابْنِ أَبِي أَحْمَدَ، أَخْبَرَهُ، أَنَّهُ سَمِعَ أَبَا سَعِيدٍ الْخُدْرِيَّ ، يَقُولُ: "" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ: الْمُزَابَنَةِ، وَالْمُحَاقَلَةِ """"، وَالْمُزَابَنَةُ: اشْتِرَاءُ الثَّمَرِ فِي رُءُوسِ النَّخْلِ، وَالْمُحَاقَلَةُ: كِرَاءُ الْأَرْضِ.","Sahih","Sahih Muslim 3934","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3935","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، وَأَبُو الرَّبِيعِ الْعَتَكِيُّ ، قَالَ أَبُو الرَّبِيعِ: حدثنا، قَالَ يَحْيَى: أَخْبَرَنَا حَمَّادُ بْنُ زَيْدٍ ، عَنْ عَمْرٍو ، قَالَ: سَمِعْتُ ابْنَ عُمَرَ ، يَقُولُ: "" كُنَّا لَا نَرَى بِالْخِبْرِ بَأْسًا حَتَّى كَانَ عَامُ أَوَّلَ، فَزَعَمَ رَافِعٌ : أَنَّ نَبِيَّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْهُ """".","Sahih","Sahih Muslim 3935","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3936","وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا سُفْيَانُ . ح وحَدَّثَنِي عَلِيُّ بْنُ حُجْرٍ ، وَإِبْرَاهِيمُ بْنُ دِينَارٍ ، قَالَا: حَدَّثَنَا إِسْمَاعِيل وَهُوَ ابْنُ عُلَيَّةَ ، عَنْ أَيُّوبَ . ح وحَدَّثَنَا إِسْحَاق بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا وَكِيعٌ ، حَدَّثَنَا سُفْيَانُ ، كُلُّهُمْ عَنْ عَمْرِو بْنِ دِينَارٍ ، بِهَذَا الْإِسْنَادِ مِثْلَهُ، وَزَادَ فِي حَدِيثِ ابْنِ عُيَيْنَةَ: فَتَرَكْنَاهُ مِنْ أَجْلِهِ.","Sahih","Sahih Muslim 3936","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3937","وحَدَّثَنِي وحَدَّثَنِي عَلِيُّ بْنُ حُجْرٍ ، حَدَّثَنَا إِسْمَاعِيلُ ، عَنْ أَيُّوبَ ، عَنْ أَبِي الْخَلِيلِ ، عَنْ مُجَاهِدٍ ، قَالَ: قَالَ ابْنُ عُمَرَ : "" لَقَدْ مَنَعَنَا رَافِعٌ نَفْعَ أَرْضِنَا """".","Sahih","Sahih Muslim 3937","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3938","وحَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، أَخْبَرَنَا يَزِيدُ بْنُ زُرَيْعٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ : "" أَنَّ ابْنَ عُمَرَ كَانَ يُكْرِي مَزَارِعَهُ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، وَفِي إِمَارَةِ أَبِي بَكْرٍ، وَعُمَرَ، وَعُثْمَانَ، وَصَدْرًا مِنْ خِلَافَةِ مُعَاوِيَةَ، حَتَّى بَلَغَهُ فِي آخِرِ خِلَافَةِ مُعَاوِيَةَ، أَنَّ رَافِعَ بْنَ خَدِيجٍ ، يُحَدِّثُ فِيهَا بِنَهْيٍ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَدَخَلَ عَلَيْهِ، وَأَنَا مَعَهُ فَسَأَلَهُ، فَقَالَ: كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: """" يَنْهَى عَنْ كِرَاءِ الْمَزَارِعِ """"، فَتَرَكَهَا ابْنُ عُمَرَ بَعْدُ، وَكَانَ إِذَا سُئِلَ عَنْهَا بَعْدُ قَالَ: زَعَمَ رَافِعُ بْنُ خَدِيجٍ : أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْهَا.","Sahih","Sahih Muslim 3938","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3939","وَحَدَّثَنَا أَبُو الرَّبِيعِ ، وَأَبُو كَامِلٍ ، قَالَا: حَدَّثَنَا حَمَّادٌ . ح وحَدَّثَنِي عَلِيُّ بْنُ حُجْرٍ ، حَدَّثَنَا إِسْمَاعِيلُ ، كِلَاهُمَا عَنْ أَيُّوبَ ، بِهَذَا الْإِسْنَادِ مِثْلَهُ، وَزَادَ فِي حَدِيثِ ابْنِ عُلَيَّةَ، قَالَ: فَتَرَكَهَا ابْنُ عُمَرَ بَعْدَ ذَلِكَ، فَكَانَ لَا يُكْرِيهَا.","Sahih","Sahih Muslim 3939","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3940","وحَدَّثَنَا ابْنُ نُمَيْرٍ ، حَدَّثَنَا أَبِي ، حَدَّثَنَا عُبَيْدُ اللَّهِ ، عَنْ نَافِعٍ ، قَالَ: ذَهَبْتُ مَعَ ابْنِ عُمَرَ إِلَى رَافِعِ بْنِ خَدِيجٍ ، حَتَّى أَتَاهُ بِالْبَلَاطِ، فَأَخْبَرَهُ: أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى عَنْ كِرَاءِ الْمَزَارِعِ """".","Sahih","Sahih Muslim 3940","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3941","وحَدَّثَنِي ابْنُ أَبِي خَلَفٍ ، وَحَجَّاجُ بْنُ الشَّاعِرِ ، قَالَا: حَدَّثَنَا زَكَرِيَّاءُ بْنُ عَدِيٍّ ، أَخْبَرَنَا عُبَيْدُ اللَّهِ بْنُ عَمْرٍو ، عَنْ زَيْدٍ ، عَنْ الْحَكَمِ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، أَنَّهُ أَتَى رَافِعًا ، فَذَكَرَ هَذَا الْحَدِيثَ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ.","Sahih","Sahih Muslim 3941","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3942","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا حُسَيْنٌ يَعْنِي ابْنَ حَسَنِ بْنِ يَسَارٍ ، حَدَّثَنَا ابْنُ عَوْنٍ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ، كَانَ يَأْجُرُ الْأَرْضَ، قَالَ: فَنُبِّئَ حَدِيثًا عَنْ رَافِعِ بْنِ خَدِيجٍ ، قَالَ: فَانْطَلَقَ بِي مَعَهُ إِلَيْهِ، قَالَ: فَذَكَرَ عَنْ بَعْضُ عُمُومَتِهِ ذَكَرَ فِيهِ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" أَنَّهُ نَهَى عَنْ كِرَاءِ الْأَرْضِ """"، قَالَ: فَتَرَكَهُ ابْنُ عُمَرَ، فَلَمْ يَأْجُرْهُ.","Sahih","Sahih Muslim 3942","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3943","وحَدَّثَنِيهِ مُحَمَّدُ بْنُ حَاتِمٍ ، حَدَّثَنَا يَزِيدُ بْنُ هَارُونَ ، حَدَّثَنَا ابْنُ عَوْنٍ ، بِهَذَا الْإِسْنَادِ، وَقَالَ: فَحَدَّثَهُ عَنْ بَعْضِ عُمُومَتِهِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ.","Sahih","Sahih Muslim 3943","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3944","وَحَدَّثَنِي عَبْدُ الْمَلِكِ بْنُ شُعَيْبِ بْنِ اللَّيْثِ بْنِ سَعْدٍ ، حَدَّثَنِي أَبِي ، عَنْ جَدِّي ، حَدَّثَنِي عُقَيْلُ بْنُ خَالِدٍ ، عَنْ ابْنِ شِهَابٍ ، أَنَّهُ قَالَ: أَخْبَرَنِي سَالِمُ بْنُ عَبْدِ اللَّهِ ، أَنَّ عَبْدَ اللَّهِ بْنَ عُمَرَ ، كَانَ يُكْرِي أَرَضِيهِ حَتَّى بَلَغَهُ أَنَّ رَافِعَ بْنَ خَدِيجٍ الْأَنْصَارِيَّ كَانَ يَنْهَى عَنْ كِرَاءِ الْأَرْضِ، فَلَقِيَهُ عَبْدُ اللَّهِ، فَقَالَ: يَا ابْنَ خَدِيجٍ، مَاذَا تُحَدِّثُ عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي كِرَاءِ الْأَرْضِ؟ قَالَ رَافِعُ بْنُ خَدِيجٍ ، لِعَبْدِ اللَّهِ: سَمِعْتُ عَمَّيَّ ، وَكَانَا قَدْ شَهِدَا بَدْرًا، يُحَدِّثَانِ أَهْلَ الدَّارِ: أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى عَنْ كِرَاءِ الْأَرْضِ """"، قَالَ عَبْدُ اللَّهِ: لَقَدْ كُنْتُ أَعْلَمُ فِي عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، أَنَّ الْأَرْضَ تُكْرَى، ثُمَّ خَشِيَ عَبْدُ اللَّهِ: أَنْ يَكُونَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَحْدَثَ فِي ذَلِكَ شَيْئًا لَمْ يَكُنْ عَلِمَهُ، فَتَرَكَ كِرَاءَ الْأَرْضِ.","Sahih","Sahih Muslim 3944","","","17. باب: زمین کو کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3945","وحَدَّثَنِي عَلِيُّ بْنُ حُجْرٍ السَّعْدِيُّ ، وَيَعْقُوبُ بْنُ إِبْرَاهِيمَ ، قَالَا: حَدَّثَنَا إِسْمَاعِيلُ وَهُوَ ابْنُ عُلَيَّةَ ، عَنْ أَيُّوبَ ، عَنْ يَعْلَى بْنِ حَكِيمٍ ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ ، عَنْ رَافِعِ بْنِ خَدِيجٍ ، قَالَ: كُنَّا نُحَاقِلُ الْأَرْضَ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَنُكْرِيهَا بِالثُّلُثِ، وَالرُّبُعِ، وَالطَّعَامِ الْمُسَمَّى، فَجَاءَنَا ذَاتَ يَوْمٍ رَجُلٌ مَنْ عُمُومَتِي ، فَقَالَ: "" نَهَانَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ أَمْرٍ كَانَ لَنَا نَافِعًا وَطَوَاعِيَةُ اللَّهِ وَرَسُولِهِ أَنْفَعُ لَنَا، نَهَانَا أَنْ نُحَاقِلَ بِالْأَرْضِ، فَنُكْرِيَهَا عَلَى الثُّلُثِ، وَالرُّبُعِ، وَالطَّعَامِ الْمُسَمَّى، وَأَمَرَ رَبَّ الْأَرْضِ أَنْ يَزْرَعَهَا، أَوْ يُزْرِعَهَا، وَكَرِهَ كِرَاءَهَا وَمَا سِوَى ذَلِكَ """".","Sahih","Sahih Muslim 3945","","","18. باب: اناج کے بدلے زمین کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3946","وحَدَّثَنَاه يَحْيَى بْنُ يَحْيَى ، أَخْبَرَنَا حَمَّادُ بْنُ زَيْدٍ ، عَنْ أَيُّوبَ ، قَالَ: كَتَبَ إِلَيَّ يَعْلَى بْنُ حَكِيمٍ ، قَالَ: سَمِعْتُ سُلَيْمَانَ بْنَ يَسَارٍ ، يُحَدِّثُ عَنْ رَافِعِ بْنِ خَدِيجٍ ، قَالَ: كُنَّا نُحَاقِلُ بِالْأَرْضِ، فَنُكْرِيهَا عَلَى الثُّلُثِ، وَالرُّبُعِ، ثُمَّ ذَكَرَ بِمِثْلِ حَدِيثِ ابْنِ عُلَيَّةَ.","Sahih","Sahih Muslim 3946","","","18. باب: اناج کے بدلے زمین کرایہ پر دینے کا بیان۔زمین کو کرایہ پر دینا"
"3947","وحَدَّثَنَا يَحْيَى بْنُ حَبِيبٍ ، حَدَّثَنَا خَالِدُ بْنُ الْحَارِثِ . ح وحَدَّثَنَا عَمْرُو بْنُ عَلِيٍّ ، حَدَّثَنَا عَبْدُ الْأَعْلَى . ح وحَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا عَبْدَةُ ، كُلُّهُمْ عَنْ ابْنِ أَبِي عَرُوبَةَ ، عَنْ يَعْلَى بْنِ حَكِيمٍ ، بِهَذَا الْإِسْنَادِ مِثْلَهُ،","Sahih","Sahih Muslim 3947","","","18. باب: اناج کے بدلے زمین کرایہ پر دینے کا بیان۔زمین کو غلہ کے عوض بٹائی پر دینا"
"3948","وحَدَّثَنِيهِ أَبُو الطَّاهِرِ ، أَخْبَرَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي جَرِيرُ بْنُ حَازِمٍ ، عَنْ يَعْلَى بْنِ حَكِيمٍ ، بِهَذَا الْإِسْنَادِ، عَنْ رَافِعِ بْنِ خَدِيجٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، وَلَمْ يَقُلْ: عَنْ بَعْضِ عُمُومَتِهِ.","Sahih","Sahih Muslim 3948","","","18. باب: اناج کے بدلے زمین کرایہ پر دینے کا بیان۔زمین کو غلہ کے عوض بٹائی پر دینا"
"3949","حَدَّثَنِي إِسْحَاقُ بْنُ مَنْصُورٍ ، أَخْبَرَنَا أَبُو مُسْهِرٍ ، حَدَّثَنِي يَحْيَى بْنُ حَمْزَةَ ، حَدَّثَنِي أَبُو عَمْرٍو الْأَوْزَاعِيُّ ، عَنْ أَبِي النَّجَاشِيِّ مَوْلَى رَافِعِ بْنِ خَدِيجٍ، عَنْ رَافِعٍ : أَنَّ ظُهَيْرَ بْنَ رَافِعٍ ، وَهُوَ عَمُّهُ، قَالَ: أَتَانِي ظُهَيْرٌ، فَقَالَ: لَقَدْ نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ أَمْرٍ كَانَ بِنَا رَافِقًا، فَقُلْتُ: وَمَا ذَاكَ؟ مَا قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَهُوَ حَقٌّ، قَالَ: سَأَلَنِي كَيْفَ تَصْنَعُونَ بِمَحَاقِلِكُمْ؟ فَقُلْتُ: نُؤَاجِرُهَا يَا رَسُولَ اللَّهِ، عَلَى الرَّبِيعِ، أَوِ الْأَوْسُقِ مِنَ التَّمْرِ، أَوِ الشَّعِيرِ، قَالَ: "" فَلَا تَفْعَلُوا، ازْرَعُوهَا، أَوْ أَزْرِعُوهَا، أَوْ أَمْسِكُوهَا """".","Sahih","Sahih Muslim 3949","","","18. باب: اناج کے بدلے زمین کرایہ پر دینے کا بیان۔زمین کو غلہ کے عوض بٹائی پر دینا"
"3950","حَدَّثَنَا مُحَمَّدُ بْنُ حَاتِمٍ ، حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ، عَنْ عِكْرِمَةَ بْنِ عَمَّارٍ ، عَنْ أَبِي النَّجَاشِيِّ ، عَنْ رَافِعٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِهَذَا، وَلَمْ يَذْكُرْ عَنْ عَمِّهِ ظُهَيْرٍ.","Sahih","Sahih Muslim 3950","","","18. باب: اناج کے بدلے زمین کرایہ پر دینے کا بیان۔زمین کو غلہ کے عوض بٹائی پر دینا"
"3951","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ رَبِيعَةَ بْنِ أَبِي عَبْدِ الرَّحْمَنِ ، عَنْ حَنْظَلَةَ بْنِ قَيْسٍ ، أَنَّهُ سَأَلَ رَافِعَ بْنَ خَدِيجٍ : عَنْ كِرَاءِ الْأَرْضِ، فَقَالَ: "" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ كِرَاءِ الْأَرْضِ """"، قَالَ: فَقُلْتُ: أَبِالذَّهَبِ وَالْوَرِقِ؟، فَقَالَ: أَمَّا بِالذَّهَبِ وَالْوَرِقِ، فَلَا بَأْسَ بِهِ.","Sahih","Sahih Muslim 3951","","","19. باب: سونے اور چاندی کے بدلے زمین کرایہ پر دینا۔زمین کو غلہ کے عوض بٹائی پر دینا"
"3952","حَدَّثَنَا إِسْحَاقُ ، أَخْبَرَنَا عِيسَى بْنُ يُونُسَ ، حَدَّثَنَا الْأَوْزَاعِيُّ ، عَنْ رَبِيعَةَ بْنِ أَبِي عَبْدِ الرَّحْمَنِ ، حَدَّثَنِي حَنْظَلَةُ بْنُ قَيْسٍ الْأَنْصَارِيُّ ، قَالَ: سَأَلْتُ رَافِعَ بْنَ خَدِيجٍ : عَنْ كِرَاءِ الْأَرْضِ بِالذَّهَبِ وَالْوَرِقِ؟ فَقَالَ: "" لَا بَأْسَ بِهِ، إِنَّمَا كَانَ النَّاسُ يُؤَاجِرُونَ عَلَى عَهْدِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى الْمَاذِيَانَاتِ، وَأَقْبَالِ الْجَدَاوِلِ، وَأَشْيَاءَ مِنَ الزَّرْعِ، فَيَهْلِكُ هَذَا وَيَسْلَمُ هَذَا، وَيَسْلَمُ هَذَا وَيَهْلِكُ هَذَا، فَلَمْ يَكُنْ لِلنَّاسِ كِرَاءٌ إِلَّا هَذَا، فَلِذَلِكَ زُجِرَ عَنْهُ، فَأَمَّا شَيْءٌ مَعْلُومٌ مَضْمُونٌ، فَلَا بَأْسَ بِهِ """".","Sahih","Sahih Muslim 3952","","","19. باب: سونے اور چاندی کے بدلے زمین کرایہ پر دینا۔زمین کو غلہ کے عوض بٹائی پر دینا"
"3953","حَدَّثَنَا عَمْرٌو النَّاقِدُ ، حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ حَنْظَلَةَ الزُّرَقِيِّ ، أَنَّهُ سَمِعَ رَافِعَ بْنَ خَدِيجٍ ، يَقُولُ: كُنَّا أَكْثَرَ الْأَنْصَارِ حَقْلًا، قَالَ: "" كُنَّا نُكْرِي الْأَرْضَ عَلَى أَنَّ لَنَا هَذِهِ وَلَهُمْ هَذِهِ، فَرُبَّمَا أَخْرَجَتْ هَذِهِ، وَلَمْ تُخْرِجْ هَذِهِ، فَنَهَانَا عَنْ ذَلِكَ، وَأَمَّا الْوَرِقُ، فَلَمْ يَنْهَنَا """"،","Sahih","Sahih Muslim 3953","","","19. باب: سونے اور چاندی کے بدلے زمین کرایہ پر دینا۔زمین کو غلہ کے عوض بٹائی پر دینا"
"3954","حَدَّثَنَا أَبُو الرَّبِيعِ ، حَدَّثَنَا حَمَّادٌ . ح وحَدَّثَنَا ابْنُ الْمُثَنَّى ، حَدَّثَنَا يَزِيدُ بْنُ هَارُونَ جَمِيعًا، عَنْ يَحْيَى بْنِ سَعِيدٍ ، بِهَذَا الْإِسْنَادِ نَحْوَهُ.","Sahih","Sahih Muslim 3954","","","19. باب: سونے اور چاندی کے بدلے زمین کرایہ پر دینا۔سونے اور چاندی کے عوض زمین کو کرایہ پر دینا"
"3955","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، أَخْبَرَنَا عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ . ح وَحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا عَلِيُّ بْنُ مُسْهِرٍ ، كِلَاهُمَا عَنْ الشَّيْبَانِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ السَّائِبِ ، قَالَ: سَأَلْتُ عَبْدَ اللَّهِ بْنَ مَعْقِلٍ : عَنِ الْمُزَارَعَةِ، فَقَالَ أَخْبَرَنِي ثَابِتُ بْنُ الضَّحَّاكِ: أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى عَنِ الْمُزَارَعَةِ """"، وَفِي رِوَايَةِ ابْنِ أَبِي شَيْبَةَ: نَهَى عَنْهَا، وَقَالَ: سَأَلْتُ ابْنَ مَعْقِلٍ: وَلَمْ يُسَمِّ عَبْدَ اللَّهِ.","Sahih","Sahih Muslim 3955","","","20. باب: مزارعت اور مؤاجرت کا بیان۔سونے اور چاندی کے عوض زمین کو کرایہ پر دینا"
"3956","حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، أَخْبَرَنَا يَحْيَى بْنُ حَمَّادٍ ، أَخْبَرَنَا أَبُو عَوَانَةَ ، عَنْ سُلَيْمَانَ الشَّيْبَانِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ السَّائِبِ ، قَالَ: دَخَلْنَا عَلَى عَبْدِ اللَّهِ بْنِ مَعْقِلٍ ، فَسَأَلْنَاهُ: عَنِ الْمُزَارَعَةِ، فَقَالَ: زَعَمَ ثَابِتٌ : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: "" نَهَى عَنِ الْمُزَارَعَةِ، وَأَمَرَ بِالْمُؤَاجَرَةِ """"، وَقَالَ: لَا بَأْسَ بِهَا.","Sahih","Sahih Muslim 3956","","","20. باب: مزارعت اور مؤاجرت کا بیان۔سونے اور چاندی کے عوض زمین کو کرایہ پر دینا"
"3957","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، أَخْبَرَنَا حَمَّادُ بْنُ زَيْدٍ ، عَنْ عَمْرٍو ، أَنَّ مُجَاهِدًا، قَالَ لِطَاوُسٍ : انْطَلِقْ بِنَا إِلَى ابْنِ رَافِعِ بْنِ خَدِيجٍ، فَاسْمَعْ مِنْهُ الْحَدِيثَ، عَنْ أَبِيهِ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ: فَانْتَهَرَهُ، قَالَ: إِنِّي وَاللَّهِ لَوْ أَعْلَمُ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْهُ، مَا فَعَلْتُهُ، وَلَكِنْ حَدَّثَنِي مَنْ هُوَ أَعْلَمُ بِهِ مِنْهُمْ يَعْنِي ابْنَ عَبَّاسٍ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" لَأَنْ يَمْنَحَ الرَّجُلُ أَخَاهُ أَرْضَهُ، خَيْرٌ لَهُ مِنْ أَنْ يَأْخُذَ عَلَيْهَا خَرْجًا مَعْلُومًا """".","Sahih","Sahih Muslim 3957","","","21. باب: زمین ہبہ کرنے کا بیان۔سونے اور چاندی کے عوض زمین کو کرایہ پر دینا"
"3958","وحَدَّثَنَا ابْنُ أَبِي عُمَرَ ، حَدَّثَنَا سُفْيَانُ ، عَنْ عَمْرٍو ، وَابْنُ طَاوُسٍ ، عَنْ طَاوُسٍ ، أَنَّهُ كَانَ يُخَابِرُ، قَالَ عَمْرٌو: فَقُلْتُ لَهُ: يَا أَبَا عَبْدِ الرَّحْمَنِ: لَوْ تَرَكْتَ هَذِهِ الْمُخَابَرَةَ، فَإِنَّهُمْ يَزْعُمُونَ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنِ الْمُخَابَرَةِ، فَقَالَ: أَيْ عَمْرُو، أَخْبَرَنِي أَعْلَمُهُمْ بِذَلِكَ يَعْنِي ابْنَ عَبَّاسٍ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَمْ يَنْهَ عَنْهَا، إِنَّمَا قَالَ: "" يَمْنَحُ أَحَدُكُمْ أَخَاهُ خَيْرٌ لَهُ، مِنْ أَنْ يَأْخُذَ عَلَيْهَا خَرْجًا مَعْلُومًا """"،","Sahih","Sahih Muslim 3958","","","21. باب: زمین ہبہ کرنے کا بیان۔مزارعت (زمین کو پیدا وار کی متعین مقدار کے عوض )اور مؤاجرت (نقدی کے عوض کرائے پر دینے )کا حکم"
"3959","حَدَّثَنَا ابْنُ أَبِي عُمَرَ ، حَدَّثَنَا الثَّقَفِيُّ ، عَنْ أَيُّوبَ . ح وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ، جَمِيعًا عَنْ وَكِيعٍ ، عَنْ سُفْيَانَ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ رُمْحٍ ، أَخْبَرَنَا اللَّيْثُ ، عَنْ ابْنِ جُرَيْجٍ . ح وحَدَّثَنِي عَلِيُّ بْنُ حُجْرٍ ، حَدَّثَنَا الْفَضْلُ بْنُ مُوسَى ، عَنْ شَرِيكٍ ، عَنْ شُعْبَةَ ، كُلُّهُمْ عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ طَاوُسٍ ، عَنْ ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، نَحْوَ حَدِيثِهِمْ.","Sahih","Sahih Muslim 3959","","","21. باب: زمین ہبہ کرنے کا بیان۔مزارعت (زمین کو پیدا وار کی متعین مقدار کے عوض )اور مؤاجرت (نقدی کے عوض کرائے پر دینے )کا حکم"
"3960","وحَدَّثَنِي عَبْدُ بْنُ حُمَيْدٍ ، وَمُحَمَّدُ بْنُ رَافِعٍ ، قَالَ عبدَ: أَخْبَرَنَا، وَقَالَ ابْنُ رَافِعٍ: حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، عَنْ ابْنِ عَبَّاسٍ : أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" لَأَنْ يَمْنَحَ أَحَدُكُمْ أَخَاهُ أَرْضَهُ، خَيْرٌ لَهُ مِنْ أَنْ يَأْخُذَ عَلَيْهَا كَذَا وَكَذَا لِشَيْءٍ مَعْلُومٍ """"، قَالَ: وَقَالَ ابْنُ عَبَّاسٍ: هُوَ الْحَقْلُ، وَهُوَ بِلِسَانِ الْأَنْصَارِ: الْمُحَاقَلَةُ.","Sahih","Sahih Muslim 3960","","","21. باب: زمین ہبہ کرنے کا بیان۔کسی کو زمین عاریتاًدینا"
"3961","وحَدَّثَنَا عَبْدُ اللَّهِ بْنُ عَبْدِ الرَّحْمَنِ الدَّارِمِيُّ ، أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ جَعْفَرٍ الرَّقِّيُّ ، حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ عَمْرٍو ، عَنْ زَيْدِ بْنِ أَبِي أُنَيْسَةَ ، عَنْ عَبْدِ الْمَلِكِ بْنِ زَيْدٍ ، عَنْ طَاوُسٍ ، عَنْ ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: "" مَنْ كَانَتْ لَهُ أَرْضٌ، فَإِنَّهُ أَنْ يَمْنَحَهَا أَخَاهُ خَيْرٌ """".","Sahih","Sahih Muslim 3961","","","21. باب: زمین ہبہ کرنے کا بیان۔کسی کو زمین عاریتاًدینا"
