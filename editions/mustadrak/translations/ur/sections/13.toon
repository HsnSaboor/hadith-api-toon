"1288","%أذعشحأؼثزتهشذوىأثىأتصۄشأشعۏأتههۄأؼىۄأضەأشًتۏحأۄەأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أثىزۄأوًوىأڬًأدثأثرتشأۏتأڬًةۏأتًشأحڬهۏلأإحۏأۄەأحًأتضأڬۏأوختهأۏۄأۄەأڬۄأدۏضەأهًۄەأڬًأإڲأوۏڽأڋتهأزۏتأدتةەأ؏أدضأضەأتضأڬتأصىڲأرحوأۄًأدتةەأتًشأظتلأضحہشتأهًۄتأثتمۏأثډأدتةەأۗ"
"1289","%أذعشحأتثًتهزشزتؤأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأشضًهأتههۄأ﷽أڬًأۏۄألشوتحەأۄًةەأضىتأۄەأڬۄأتههۄأحؼتهۏٳأىەألشوتۏتأ=أتەأؼۏضۏٳأؼهۏۄأتهضهتوأ$أوۏڽأحوۄتشەأثؼزأتۏڬأتۏضۏأتوحأځۏزتأڬشىەأًتهتأۄًڽأڬۄأتىأڬًأتڲشأتۏضۏأډۏصأځۄىډەأدًأتىأڬًأځضىزأۄًأحًأًۄأتههۄأڬۏأذوزأڬشۏڽأتًشأطڬشأڬشۏڽأڲەأتًشأتڲشأتىأڬًأڬًةۏأتۏضۏأډۏصأځۄىډەأدًأتىأڬًأىتځضىزأۄًأحًأًۄأتضأځشأطڬشأڬشۏڽأڲەأ؏أذتهتىڬۄأتىأوۏڽأىۄأؼهوأۄًأڲتأىۄأذهوأۗأ+أذعشحأؼۏضۏٳأؼهۏۄأتهضهتوأىەأ"
