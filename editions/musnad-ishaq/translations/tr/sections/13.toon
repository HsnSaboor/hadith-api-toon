hadiths[3]{hadithnumber,text}:
"469","[AI-translation] ((Seyyidünâ Ebû Hüreyre (radıyallahu anh) Resulullah'tan (sallallahu aleyhi ve sellem) rivayet etti — buyurdu: ""Binek hayvanı rehin tutulursa üzerindeki masraf sebebiyle binilebilir; sağmal hayvanın sütü içilebilir. Binen veya süt içen masrafı üstlenir.""))"
"470","[AI-translation] ((Seyyidünâ Ebû Hüreyre (radıyallahu anh) Resulullah'tan (sallallahu aleyhi ve sellem) rivayet etti — buyurdu: ""Rehin hayvan bakımına karşılık binilebilir; sağmal hayvan rehin tutulursa bakıma karşılık sütü içilebilir. Binen veya sütünü içen, bakımı onun sorumluluğudur.""))"
"471","[AI-translation] ((Seyyidünâ Ebû Hüreyre'den (radıyallahu anh) rivayet edildi — dedi ki: Rehin hayvana binilebilir, sütü içilebilir.))"
