hadiths[count]{hadithnumber,text}:
"1042.1","Hişam b. Urve (r.a.) babasından naklederek şöyle diyor: \"\"Rasulullah Sallallahu Aleyhi ve Sellem'e: \"\"Ey Allah'ın RasÜlü çölden bazı bedeviler bize bazı etler getiriyorlar"
"1042.2","Hişam b. Urve (r.a.) babasından naklederek şöyle diyor: \"\"Rasulullah Sallallahu Aleyhi ve Sellem'e: \"\"Ey Allah'ın RasÜlü çölden bazı bedeviler bize bazı etler getiriyorlar"
"1043.1","Yahya b. Said (r.a.)'den rivayete göre"
"1043.2","Yahya b. Said (r.a.)'den rivayete göre"
"1044.1","Ata b. Yesar (r.a)'dan rivayete göre"
"1044.2","Ata b. Yesar (r.a)'dan rivayete göre"
"1045.1","Muaz b. Sa'd (r.a.) -veya Sa'd b. Muaz'dan rivayete göre"
"1045.2","Muaz b. Sa'd (r.a.) -veya Sa'd b. Muaz'dan rivayete göre"
"1046.1","Sevr b. Zeyd ed Dili (r.a.)'den rivayete göre"
"1046.2","Sevr b. Zeyd ed Dili (r.a.)'den rivayete göre"
"1047.1","Malik (r.a.)'e ulaşan haberlere göre"
"1047.2","Malik (r.a.)'e ulaşan haberlere göre"
"1048.1","Malik"
"1048.2","Malik"
"1049.1","Yahya bana Malik'ten, o da Yahya ibn Said'den, Ebu Murra'dan rivayet etti."
"1049.2","Yahya bana Malik'ten, o da Yahya ibn Said'den, Ebu Murra'dan rivayet etti."
"1050.1","Nafi' (r.a)'den rivayete göre"
"1050.2","Nafi' (r.a)'den rivayete göre"
"1051.1","Said b. Müseyyeb (r.a)'den rivayete göre"
"1051.2","Said b. Müseyyeb (r.a)'den rivayete göre"
