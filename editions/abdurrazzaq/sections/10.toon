hadiths[count]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"5446","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ ، قَالَ : \" رَأَيْتُ أَنَسَ بْنَ مَالِكٍ ، وَالْحَسَنَ ، وَأَخَاهُ سَعِيدًا ، وَجَابِرَ بْنَ زَيْدٍ أَبَا الشَّعْثَاءِ ،يُصَلُّونَ يَوْمَ الْعِيدِ قَبْلَ خُرُوجِ الإِمَامِ ""","","","","","Book of the Two Eid Prayers"
"5447","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ ، قَالا : \"صَلاةُ الضُّحَى مِثْلُ صَلاةِ الْفِطْرِ ، رَكْعَتَانِ رَكْعَتَانِ ""","","","","","Book of the Two Eid Prayers"
"5448","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ ، عَنِ الأَزْرَقِ بْنِ قَيْسٍ ، عَنْ رَجُلٍ ، قَالَ : جَاءَنَا نَاسٌ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَوْمَ الْعِيدِ قَبْلَ خُرُوجِ الإِمَامِ فَصَلَّوْا ، وَجَاءَ ابْنُ عُمَرَ ، فَلَمْ يُصَلِّ ، فَقَالَ الرَّجُلُ لابْنِ عُمَرَ :جَاءَ نَاسٌ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَصَلَّوْا ، وَجِئْتَ فَلَمْ تُصَلِّ ، فَقَالَ ابْنُ عُمَرَ : \" مَا اللَّهُ تَبَارَكَ وَتَعَالَى بِرَادٍّ عَلَى عَبْدٍ إِحْسَانًا ، أَحْسِبُهُ ""","","","","","Book of the Two Eid Prayers"
"5449","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ شَيْخٍ ، مِنْ أَهْلِ الْبَصْرَةِ ، قَالَ : سَمِعْتُ الْعَلاءَ بْنَ زَيْدٍ ، يَقُولُ : خَرَجَ عَلِيٌّ يَوْمَ عِيدٍ ، فَوَجَدَ النَّاسَ يُصَلُّونَ قَبْلَ خُرُوجِهِ ، فَقِيلَ لَهُ لَوْ نَهَيْتَهُمْ ، فَقَالَ \"مَا أَنَا بِالَّذِي أَنْهَى عَبْدًا إِنْ صَلاهَا ، وَلَكِنْ سَأُخْبِرُكُمْ بِمَا شَهِدْنَا ، أَوْ قَالَ : بِمَا حَضَرْنَا ""","","","","","Book of the Two Eid Prayers"
"5450","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، أَنَّ ابْنَ مَسْعُودٍ ، وَحُذَيْفَةَ كَانَا يَنْهَيَانِ النَّاسَ ، أَوْ قَالَ : \"يُجْلِسَانِ مَنْ رَأَيَاهُ يُصَلِّي قَبْلَ خُرُوجِ الإِمَامِ يَوْمَ الْعِيدِ ""","","","","","Book of the Two Eid Prayers"
"5451","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، قَالَ : سُئِلَ عَلْقَمَةُ بْنُ قَيْسٍ عَنِالصَّلاةِ قَبْلَ خُرُوجِ الإِمَامِ يَوْمَ الْعِيدِ ، فَقَالَ : \" كَانَ أَصْحَابُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لا يُصَلُّونَ قَبْلَهَا \"، قَالَ السَّائِلُ : أَرَأَيْتَ قَدْ صَلَّيْتُ ؟ قَالَ : \" قَدْ أَخْبَرْتُكَ عَنْ فِعْلِ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَأَنْتَ أَعْلَمُ ""","","","","","Book of the Two Eid Prayers"
"5452","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، عَنِ الشَّعْبِيِّ ، قَالَ : \"خَرَجْتُ مَعَهُ فِي يَوْمِ عِيدٍ ، فَلَمْ يُصَلِّ قَبْلَهَا وَلا بَعْدَهَا \" ، قَالَ : \" ثُمَّ خَرَجْتُ أَنَا وَمَسْرُوقٌ وَشُرَيْحٌ إِلَى الْجَبَّانَةِ ، فَلَمْ نُصَلِّهَا قَبْلَهَا وَلا بَعْدَهَا \" ، قَالَ إِسْمَاعِيلُ : وَقَامَ رَجُلٌ يُصَلِّي يَوْمَ الْعِيدِ بَعْدَ الصَّلاةِ ، فَنَهَاهُ عَامِرٌ وَلَمْ يَدَعْهُ يُصَلِّي بَعْدَهَا","","","","","Book of the Two Eid Prayers"
"5453","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي حَسَنُ بْنُ مُسْلِمٍ \" أَنَّ سَعِيدَ بْنَ جُبَيْرٍ كَانَلا يُصَلِّي قَبْلَ خُرُوجِ الإِمَامِ ""","","","","","Book of the Two Eid Prayers"
"5454","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ ابْنِ أَبِي الْمُخَارِقِ ، \" أَنَّ أَصْحَابَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانُوالا يُصَلُّونَ حَتَّى يَخْرُجَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","Book of the Two Eid Prayers"
"5455","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ \" أَنَّهُ كَانَلا يُصَلِّي قَبْلَ الْعِيدَيْنِ وَلا بَعْدَهُمَا شَيْئًا \"، عَنِ ابْنِ جُرَيْجٍ ، عَنْ مُوسَى بْنِ عُقْبَةَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ مِثْلَهُ ، وَزَادَ قَالَ : كَانَ لا يُصَلِّي يَوْمَئِذٍ ، حَتَّى يَتَحَوَّلَ النَّهَارُ ، عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ عُمَرَ مِثْلَهُ . عَنِ الثَّوْرِيِّ ، وَمَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ مِثْلَهُ ، وَزَادَ ، قَالَ : كَانَ يُصَلِّي الْغَدَاةَ يَوْمَ الْعِيدِ وَعَلَيْهِ ثِيَابُهُ ، ثُمَّ يَغْدُو إِلَى الْمُصَلَّى","","","","","Book of the Two Eid Prayers"
"5456","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ \"مَا عَلِمْنَا أَحَدًا كَانَ يُصَلِّي قَبْلَ خُرُوجِ الإِمَامِ يَوْمَ الْعِيدِ وَلا بَعْدَهُ \"، عَنْ شَيْخٍ مِنْ أَهْلِ الطَّائِفِ ، يُقَالُ لَهُ : عَبْدُ اللَّهِ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ : كَانَ عَمْرُو بْنُ شُعَيْبٍ يَأْمُرُنَا أَنْ لا نُصَلِّيَ قَبْلَهَا وَلا بَعْدَهَا","","","","","Book of the Two Eid Prayers"
"5457","عَنِ ابْنِ التَّيْمِيِّ ، وَغَيْرِهِ ، عَنْ شُعْبَةَ ، قَالَ : أَنْبَأَنَا عَدِيُّ بْنُ ثَابِتٍ ، أَنَّهُ سَمِعَ سَعِيدَ بْنَ جُبَيْرٍ يُحَدِّثُ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : \"خَرَجَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَوْمَ فِطْرٍ ، أَوْ أَضْحَى ، فَصَلَّى رَكْعَتَيْنِ لَمْ يُصَلِّ قَبْلَهُمَا وَلا بَعْدَهُمَا ""","","","","","Book of the Two Eid Prayers"
"5458","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي ابْنُ أَبِي عَيَّاشٍ ، أَنَّ أَنَسَ بْنَ مَالِكٍ ، أَخْبَرَهُ ، \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ،لَمْ يُصَلِّ قَبْلَ صَلاةِ الْفِطْرِ وَلا بَعْدَهَا ، وَأَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَمْ يَكُنْ صَلَّى قَبْلَ صَلاةِ الأَضْحَى وَلا بَعْدَهَا شَيْئًا ""","","","","","Book of the Two Eid Prayers"
"5459","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَلْقَمَةَ ، قَالَ \" كَانَلا يُصَلِّي قَبْلَ الْعِيدَيْنِ شَيْئًا ، وَيُصَلِّي بَعْدَهُمَا أَرْبَعًا ""","","","","","Book of the Two Eid Prayers"
"5460","عَنِ الثَّوْرِيِّ ، عَنْ صَالِحٍ ، عَنِ الشَّعْبِيِّ ، قَالَ : \" كَانَ ابْنُ مَسْعُودٍيُصَلِّي بَعْدَ الْعِيدَيْنِ أَرْبَعًا ""","","","","","Book of the Two Eid Prayers"
"5461","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، وَقَتَادَةَ ، \" أَنَّ ابْنَ مَسْعُودٍ كَانَيُصَلِّي بَعْدَهَا أَرْبَعَ رَكَعَاتٍ أَوْ ثَمَانٍ ، وَكَانَ لا يُصَلِّي قَبْلَهَا ""","","","","","Book of the Two Eid Prayers"
"5462","عَنْ إِسْرَائِيلَ بْنِ يُونُسَ ، عَنْ عِيسَى بْنِ أَبِي عَزَّةَ ، قَالَ \" رَأَيْتُ عَامِرًايُصَلِّي بَعْدَ الْعِيدَيْنِ رَكْعَتَيْنِ ""","","","","","Book of the Two Eid Prayers"
"5463","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ \"هَلْ بَلَغَكَ مِنْ شَيءٍ مِنَ الصَّلاةِ كَانَ يُسَبَّحُ بِهِ بَعْدَ صَلاةِ الْفِطْرِ ؟ \" ، قَالَ : لا ، قُلْتُ : \" إِلا بِمَا أَكْثَرْتَ أَحَبُّ إِلَيْكَ ؟ \" ، قَالَ : نَعَمْ","","","","","Book of the Two Eid Prayers"
"5464","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : بَلَغَنِي ، عَنْ مَوْلًى لابْنِ عَبَّاسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ \"لا يُصَلِّي قَبْلَهَا وَلا بَعْدَهَا \"، قَالَ عَبْدُ الرَّزَّاقِ : وَرَأَيْتُ ابْنَ جُرَيْجٍ ، وَمَعْمَرًا لا يُصَلِّيَانِ قَبْلَهَا وَلا بَعْدَهَا","","","","","Book of the Two Eid Prayers"
"5465","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : حُدِّثْتُ حَدِيثًا رُفِعَ إِلَى الشَّعْبِيِّ ، أَنَّهُ سَمِعَ أَصْحَابَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُونَ : \"لا صَلاةَ قَبْلَ الأَضْحَى وَلا بَعْدَهَا ، وَلا قَبْلَ صَلاةِ الْفِطْرِ وَلا بَعْدَهَا ، حَتَّى تَزِيغَ الشَّمْسُ ""","","","","","Book of the Two Eid Prayers"
"5466","عَنِ الْحَسَنِ بْنِ عُمَارَةَ ، عَنِ الْمِنْهَالِ بْنِ عَمْرٍو ، عَنْ رَجُلٍ قَدْ سَمَّاهُ ، قَالَ \" خَرَجْنَا مَعَ عَلِيِّ بْنِ أَبِي طَالِبٍ فِييَوْمِ عِيدٍ إِلَى الْجَبَّانَةِ ، فَرَأَى نَاسًا يُصَلُّونَ قَبْلَ صَلاةِ الإِمَامِ ، فَقَالَ كَالْمُتَعَجِّبِ : أَلا تَرَوْنَ هَؤُلاءِ يُصَلُّونَ ؟ فَقُلْنَا : أَلا تَنْهَاهُمْ ؟ فَقَالَ : أَكْرَهُ أَنْ أَكُونَ كَالَّذِي يَنْهَى عَبْدًا إِذَا صَلَّى ، قَالَ : ثُمَّ بَدَأَ بِالصَّلاةِ قَبْلَ الْخُطْبَةِ ، وَلَمْ يُصَلِّ قَبْلَهَا وَلا بَعْدَهَا ""","","","","","Book of the Two Eid Prayers"
"5467","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَطَاءٌ ، عَنِ ابْنِ عَبَّاسٍ ، وَعَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ الأَنْصَارِيِّ ، قَالا : \"لَمْ يَكُنْ يُؤَذَّنُ يَوْمَ الْفِطْرِ وَلا يَوْمَ الأَضْحَى ""","","","","","Book of the Two Eid Prayers"
"5468","ثُمَّ سَأَلْتُهُ بَعْدَ حِينٍ عَنْ ذَلِكَ فَأَخْبَرَنِي ، قَالَ : أَخْبَرَنِي جَابِرُ بْنُ عَبْدِ اللَّهِ الأَنْصَارِيِّ ، أَنْلا أَذَانَ لِلصَّلاةِ يَوْمَ الْفِطْرِ حِينَ يَخْرُجُ الإِمَامُ ، وَلا بَعْدَ أَنْ يَخْرُجَ وَلا إِقَامَةَ وَلا نِدَاءَ وَلا شَيءَ \" ، قَالَ : \" وَلا نِدَاءَ يَوْمَئِذٍ ، وَلا إِقَامَةَ ""","","","","","Book of the Two Eid Prayers"
"5469","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَطَاءٌ ، \" أَنَّ ابْنَ عَبَّاسٍ ، أَرْسَلَ إِلَى ابْنِ الزُّبَيْرِ أَوَّلَ مَا بُويعَ أَنَّهُلَمْ يَكُنْ يُؤَذَّنُ لِلصَّلاةِ يَوْمَ الْفِطْرِ ، فَلا تُؤَذِّنْ لَهَا ، قَالَ : فَلَمْ يُؤَذِّنْ لَهَا ابْنُ الزُّبَيْرِ يَوْمَئِذٍ وَأَرْسَلَ إِلَيْهِ مَعَ ذَلِكَ : إِنَّمَا الْخُطْبَةُ بَعْدَ الصَّلاةِ ، وَإِنَّ ذَلِكَ قَدْ كَانَ يُفْعَلُ ، قَالَ : فَصَلَّى ابْنُ الزُّبَيْرِ قَبْلَ الْخُطْبَةِ ، فَسَأَلَهُ أَصْحَابُهُ ، ابْنُ صَفْوَانَ وَأَصْحَابٌ لَهُ قَالُوا : هَلْ لا آذَنْتَنَا ؟ فَاتَتْهُمُ الصَّلاةُ يَوْمَئِذٍ ، فَلَمَّا سَاءَ الَّذِي بَيْنَهُ وَبَيْنَ ابْنِ عَبَّاسٍ ، لَمْ يَعْدُ ابْنَ الزُّبَيْرِ لأَمْرِ ابْنِ عَبَّاسٍ ""","","","","","Book of the Two Eid Prayers"
"5470","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ أَبِي سَعِيدٍ مَوْلَى عَبْدِ الرَّحْمَنِ بْنِ عَوْف ، \" أَنَّهُ شَهِدَ الْعِيدَ مَعَ عُمَرَ ، وَعُثْمَانَ وَعَلِيٍّ ،فَكُلُّهُمْ صَلَّى بِغَيْرِ أَذَانٍ وَلا إِقَامَةٍ ""","","","","","Book of the Two Eid Prayers"
"5471","عَنْ إِسْرَائِيلَ ، عَنْ سِمَاكٍ ، قَالَ : \" بَلَغَنِي أَنَّهُ شَهِدَ الْمُغِيرَةَ بْنَ شُعْبَةَ فِييَوْمِ عِيدٍ فَصَلَّى بِهِمْ قَبْلَ الْخُطْبَةِ بِغَيْرِ أَذَانٍ وَلا إِقَامَةٍ ، ثُمَّ جَاءَ يُقَادُ بِهِ عَلَى بَعِيرِهِ ، حَتَّى خَطَبَ بَعْدَ الصَّلاةِ عَلَى بَعِيرِهِ ""","","","","","Book of the Two Eid Prayers"
"5472","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَطَاءٌ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ الأَنْصَارِيِّ ، قَالَ : سَمِعْتُهُ يَقُولُ : \" إِنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَقَامَ يَوْمَ الْفِطْرِ ، فَصَلَّى ، فَبَدَأَ بِالصَّلاةِ قَبْلَ الْخُطْبَةِ ، ثُمَّ خَطَبَ النَّاسَ ، فَلَمَّا فَرَغَ نَبِيُّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، نَزَلَ ، فَأَتَى النِّسَاءَ فَذَكَّرَهُنَّ وَهُوَ مُتَّكِئٍ عَلَى بِلالٍ ، وَبِلالٌ بَاسِطٌ ثَوْبَهُ يُلْقِينَ فِيهِ النِّسَاءُ صَدَقَةً \"، قُلْتُ لِعَطَاءٍ : أَزَكَاةُ يَوْمِ الْفِطْرِ ؟ قَالَ : لا ، وَلَكِنَّهُ صَدَقَةً يَتَصَدَّقْنَ بِهَا حِينَئِذٍ ، تُلْقِي الْمَرْأَةُ فَتْخَتَهَا ، وَيُلْقِينَ وَيُلْقِينَ ، قَالَ : قُلْتُ لِعَطَاءٍ : أَتَرَى حَقًّا عَلَى الإِمَامِ الآنَ حَتَّى يَأْتِيَ النِّسَاءَ حِينَ يَفْرُغُ فَيُذَكِّرَهُنَّ ؟ قَالَ : أَيْ لَعَمْرِي ، إِنَّ ذَلِكَ لَحَقٌّ عَلَيْهِمْ ، وَمَا لَهُمْ لا يَفْعَلُونَ ذَلِكَ ؟ ""","","","","","Book of the Two Eid Prayers"
"5473","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي حَسَنُ بْنُ مُسْلِمٍ ، عَنْ طَاوُسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : شَهِدْتُالصَّلاةَ يَوْمَ الْفِطْرِ مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَمَعَ أَبِي بَكْرٍ ، وَعُمَرَ ، وَعُثْمَانَ ، كُلُّهُمْ يُصَلِّيهَا قَبْلَ الْخُطْبَةِ ، ثُمَّ يَخْطُبُ بَعْدُ ، قَالَ : \" نَزَلَ نَبِيُّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَكَأَنِّي أَنْظُرُ إِلَيْهِ حِينَ يَجْلِسُ الرِّجَالُ بِيَدِهِ ، ثُمَّ أَقْبَلَ يَشُقُّهُمْ حَتَّى جَاءَ النِّسَاءَ مَعَهُ بِلالٌ ، فَقَالَ :  يَأَيُّهَا النَّبِيُّ إِذَا جَاءَكَ الْمُؤْمِنَاتُ يُبَايِعْنَكَ عَلَى أَنْ لا يُشْرِكْنَ بِاللَّهِ شَيْئًا ، فَتَلا هَذِهِ الآيَةَ حَتَّى فَرَغَ مِنْهَا ، ثُمَّ قَالَ حِينَ فَرَغَ مِنْهَا : أَنْتُنَّ عَلَى ذَلِكَ ، فَقَالَتِ امْرَأَةٌ وَاحِدَةٌ وَلَمْ تُجِبْهُ غَيْرُهَا مِنْهُنَّ : نَعَمْ يَا نَبِيَّ اللَّهِ ، لا يَدْرِي حَسَنٌ مَنْ هِيَ ، قَالَ : فَتَصَدَّقْنَ ، قَالَ : فَبَسَطَ بِلالٌ ثَوْبَهُ ، ثُمَّ قَالَ : هَلُمَّ ، لَكُنَّ فِدًا لَكُنَّ أَبِي وَأُمِّي ، فَجَعَلْنَ يُلْقِينَ الْفَتَخَ وَالْخَوَاتِيمَ فِي ثَوْبِ بِلالٍ، قُلْنَا لَهُ : مَا الْفَتَخُ ؟ قَالَ : \" خَوَاتِيمُ مِنْ عِظَامِ كُنَّ يُلْبَسْنَ فِي الْجَاهِلِيَّةِ ""","","","","","Book of the Two Eid Prayers"
"5474","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : \" شَهِدْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَصَلَّى يَوْمَ الْعِيدِ ، ثُمَّ خَطَبَ ، فظَنَّ أَنَّهُ لَمْ يُسْمِعِ النِّسَاءَ ، فَأَتَاهُنَّ فَوَعَظَهُنَّ ، وَقَالَ : تَصَدَّقْنَ ، قَالَ : فَجَعَلَتِ الْمَرْأَةُ تُلْقِي الْخَاتَمَ وَالْخُرْصَ وَالشَّيءَ ، ثُمَّ أَمَرَ بِلالا فَجَعَلَهُ فِي ثَوْبٍ ، حَتَّى أَمْضَاهُ ""","","","","","Book of the Two Eid Prayers"
"5475","عَنْ دَاوُدَ بْنِ قَيْسٍ ، قَالَ : أَخْبَرَنِي عِيَاضُ بْنُ عَبْدِ اللَّهِ بْنِ أَبِي سَرْحٍ ، أَنَّهُ سَمِعَ أَبَا سَعِيدٍ الْخُدْرِيُّ يُحَدِّثُ : \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَيَخْرُجُ يَوْمَ الْعِيدِ وَيَوْمَ الْفِطْرِ ، فَيُصَلِّي تِينْكَ الرَّكْعَتَيْنِ ، ثُمَّ يُسَلِّمُ ، فَيَقُومُ فَيَسْتَقْبِلُ النَّاسَ وَهُمْ جُلُوسٌ حَوْلَهُ ، فَيَقُولُ : تَصَدَّقُوا ، تَصَدَّقُوا ، فَكَانَ أَكْثَرُ مَنْ يَتَصَدَّقُ النِّسَاءُ بِالْخَاتَمِ وَالْقُرْطِ وَالشَّيءِ ، فَإِنْ كَانَ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَاجَةٌ فِي أَنْ يَضْرِبَ عَلَى النَّاسِ بَعْثَا ذَكَرَهُ ، وَإِلا انْصَرَفَ ""","","","","","Book of the Two Eid Prayers"
"5476","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي الْحَارِثُ بْنُ عَبْدِ اللَّهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ سَعْدِ بْنِ أَبِي ذُبَابٍ ، عَنْ عِيَاضِ بْنِ عَبْدِ اللَّهِ بْنِ سَعْدِ بْنِ أَبِي سَرْحٍ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَيَبْدَأُ يَوْمَ الْفِطْرِ وَالأَضْحَى بِالصَّلاةِ قَبْلَ الْخُطْبَةِ ، ثُمَّ يَخْطُبُ ، فَيَكُونُ فِي خُطْبَتِهِ الأَمْرُ بِالْبَعْثِ وَبِالسَّرِيَّةِ ""","","","","","Book of the Two Eid Prayers"
"5477","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ أَبِي عُبَيْدٍ مَوْلَى عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ أَنَّهُ شَهِدَ الْعِيدَ مَعَ عُمَرَ بْنِ الْخَطَّابِ ، فَصَلَّى قَبْلَ أَنْ يَخْطُبَ بِلا أَذَانٍ وَلا إِقَامَةٍ ، ثُمَّ خَطَبَ ، فَقَالَ : \" يَأَيُّهَا النَّاسُ ، إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنْ صِيَامِ هَذَيْنِ الْيَوْمَيْنِ ، أَمَّا أَحَدُهُمَا فَيَوْمُ فِطْرِكُمْ مِنْ صِيَامِكُمْ وَعِيدِكُمْ ، وَأَمَّا الآخَرُ فَيَوْمُكُمْ تَأْكُلُونَ فِيهِ نُسُكَكُمْ ""","","","","","Book of the Two Eid Prayers"
"5478","قَالَ : ثُمَّ شَهِدْتُهُ مَعَ عُثْمَانَ ، وَذَلِكَ يَوْمَ الْجُمُعَةِ ، فَصَلَّى قَبْلَ أَنْ يَخْطُبَ بِلا أَذَانٍ وَلا إِقَامَةٍ ، ثُمَّ خَطَبَ النَّاسَ ، فَقَالَ : \" إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنْ صِيَامِ هَذَيْنِ الْيَوْمَيْنِ ، أَمَّا أَحَدُهُمَا فَيَوْمُ فِطْرِكُمْ مِنْ صِيَامِكُمْ وَعِيدِكُمْ ، وَأَمَّا الآخَرُ فَيَوْمٌ تَأْكُلُونَ فِيهِ نُسُكَكُمْ ""","","","","","Book of the Two Eid Prayers"
"5479","قَالَ : ثُمَّ شَهِدْتُهُ مَعَ عُثْمَانَ ، وَكَانَ ذَلِكَ يَوْمَ الْجُمُعَةِ صَلَّى قَبْلَ أَنْ يَخْطُبَ بِلا أَذَانٍ وَلا إِقَامَةٍ ، ثُمَّ خَطَبَ النَّاسَ ، فَقَالَ : \" يَأَيُّهَا النَّاسُ ، إِنَّهَذَا يَوْمٌ اجْتَمَعَ لَكُمْ عِيدَانِ فَمَنْ كَانَ مِنْكُمْ مِنْ أَهْلِ الْعَوَالِي فَقَدْ أَذِنَّا لَهُ فَلْيَرْجِعْ ، وَمَنْ شَاءَ فَلْيَشْهَدِ الصَّلاةَ ""","","","","","Book of the Two Eid Prayers"
"5480","قَالَ : ثُمَّ شَهِدْتُهُ مَعَ عَلِيٍّ ، فَصَلَّى قَبْلَ أَنْ يَخْطُبَ بِلا أَذَانٍ وَلا إِقَامَةٍ ، ثُمَّ خَطَبَ ، فَقَالَ : \" يَأَيُّهَا النَّاسُ ، إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَدْنَهَى أَنْ تَأْكُلُوا نُسُكَكُمْ بَعْدَ ثَلاثِ لَيَالٍ ، فَلا تَأْكُلُوهَا بَعْدَهُ ""","","","","","Book of the Two Eid Prayers"
"5481","عَنْ إِسْرَائِيلَ ، عَنْ سِمَاكِ بْنِ حَرْبٍ \" أَنَّهُ شَهِدَ الْمُغِيرَةَ بْنَ شُعْبَةَ فِييَوْمِ عِيدٍ صَلَّى بِغَيْرِ أَذَانٍ وَلا إِقَامَةٍ ، ثُمَّ جَاءَ يُقَادُ بِهِ بَعِيرُهُ حَتَّى خَطَبَ بَعْدَ الصَّلاةِ عَلَى بَعِيرِهِ ""","","","","","Book of the Two Eid Prayers"
"5482","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ الْكَرِيمِ الْجَزْرِيِّ ، قَالَ : أَخْبَرَنِي زِيَادُ بْنُ أَبِي مَرْيَمَ \" أَنَّهُ شَهِدَ الْمُغِيرَةَ بْنَ شُعْبَةَ ،صَلَّى قَبْلَ الْخُطْبَةِ ، ثُمَّ رَكِبَ بُخَيْتًا لَهُ فَخَطَبَهُمْ ، فَلَمَّا فَرَغَ دَفَعَهُ ""","","","","","Book of the Two Eid Prayers"
"5483","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ وَهْبِ بْنِ كَيْسَانَ ، عَنْ رَجُلٍ ، قَالَ : \" شَهِدْتُ مَعَ أَبِي بَكْرٍيَوْمَ عِيدٍ فَبَدَأَ بِالصَّلاةِ قَبْلَ الْخُطْبَةِ بِلا أَذَانٍ وَلا إِقَامَةٍ ، ثُمَّ شَهِدْتُهُ مَعَ عُمَرَ ، فَبَدَأَ بِالصَّلاةِ قَبْلَ الْخُطْبَةِ بِلا أَذَانٍ وَلا إِقَامَةٍ ، ثُمَّ شَهِدْتُهُ مَعَ عُثْمَانَ ، فَبَدَأَ بِالصَّلاةِ قَبْلَ الْخُطْبَةِ بِلا أَذَانٍ وَلا إِقَامَةٍ ""","","","","","Book of the Two Eid Prayers"
"5484","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ \"أَيَذْكُرُ اللَّهَ الإِنْسَانُ وَالإِمَامُ يَخْطُبُ يَوْمَ عَرَفَةَ أَوْ يَوْمَ الْفِطْرِ وَهُوَ يَعْقِلُ قَوْلَ الإِمَامِ ؟ قَالَ : لا كُلُّ عِيدٍ فَلا يُتَكَلَّمُ فِيهِ ""","","","","","Book of the Two Eid Prayers"
"5485","عَنِ حَسَنِ بْنِ عُمَارَةَ ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ ، عَنْ مُجَاهِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ \"السُّكُوتُ فِي أَرْبَعَةِ مَوَاطِنَ : الْجُمُعَةِ ، وَالْعِيدَيْنِ ، وَالاسْتِسْقَاءِ ""","","","","","Book of the Two Eid Prayers"
"5486","عَنْ قَيْسِ بْنِ الرَّبِيعِ ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ ، عَنْ مُجَاهِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ \"وَجَبَ الإِنْصَاتُ فِي أَرْبَعَةِ مَوَاطِنَ : الْجُمُعَةِ ، وَالْفِطْرِ ، وَالأَضْحَى ، وَالاسْتِسْقَاءِ ""","","","","","Book of the Two Eid Prayers"
"5487","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ \"هَلْ تَدْرِي أَوَّلَ مَنْ خَطَبَ يَوْمَ الْفِطْرِ ثُمَّ صَلَّى ؟ قَالَ : لا أَدْرِي ، أَدْرَكْتُ النَّاسَ عَلَى ذَلِكَ ""","","","","","Book of the Two Eid Prayers"
"5488","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي يَحْيَى بْنُ سَعِيدٍ ، قَالَ : أَخْبَرَنِي يُوسُفُ بْنُ عَبْدِ اللَّهِ بْنِ سَلامٍ ، قَالَ : \" أَوَّلُ مَنْبَدَأَ بِالْخُطْبَةِ قَبْلَ الصَّلاةِ يَوْمَ الْفِطْرِ عُمَرُ بْنُ الْخَطَّابِ ، لَمَّا رَأَى النَّاسَ يَنْقُصُونَ فَلَمَّا صَلَّى حَبَسَهُمْ فِي الْخُطْبَةِ \"، عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ يُوسُفَ مِثْلَهُ ، إِلا أَنَّهُ قَالَ : عُثْمَانُ بْنُ عَفَّانَ","","","","","Book of the Two Eid Prayers"
"5489","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قَالَ ابْنُ شِهَابٍ \"أَوَّلُ مَنْ بَدَأَ بِالْخُطْبَةِ قَبْلَ الصَّلاةِ مُعَاوِيَةُ ""","","","","","Book of the Two Eid Prayers"
"5490","عَنْ مَعْمَرٍ ، قَالَ \" بَلَغَنِي أَنَّأَوَّلَ مَنْ خَطَبَ مُعَاوِيَةُ فِي الْعِيدِ أَوْ عُثْمَانُ فِي آخِرِ خِلافَتِهِ \"، شَكَّ مَعْمَرٌ ، قَالَ : وَبَلَغَنِي أَيْضًا : \" أَنَّ عُثْمَانَ فَعَلَ ذَلِكَ ، كَانَ لا يُدْرِكُ غَايِبُهُمُ الصَّلاةَ ، فَبَدَأَ بِالْخُطْبَةِ حَتَّى يَجْتَمِعَ النَّاسُ ""","","","","","Book of the Two Eid Prayers"
"5491","عَنْ دَاوُدَ بْنِ قَيْسٍ ، قَالَ : حَدَّثَنِي عِيَاضُ بْنُ عَبْدِ اللَّهِ بْنِ أَبِي سَرْحٍ ، أَنَّهُ سَمِعَ أَبَا سَعِيدٍ الْخُدْرِيُّ ، يَقُولُ :\" خَرَجْتُ مَعَ مَرْوَانَ فِي يَوْمِ عِيدِ فِطْرٍ ، أَوْ أَضْحَى ، هُوَ بَيْنِي وَبَيْنَ أَبِي مَسْعُودٍ ، حَتَّى أَفْضَيْنَا إِلَى الْمُصَلَّى ، فَإِذَا كَثِيرُ بْنُ الصَّلْتِ الْكِنْدِيُّ قَدْ بَنَى لِمَرْوَانَ مِنْبَرًا مِنْ لَبِنٍ وَطِينٍ ، فَعَدَلَ مَرْوَانُ إِلَى الْمِنْبَرِ حَتَّى حَاذَى بِهِ ، فَجَاذَبْتُهُ لِيَبْدَأَ بِالصَّلاةِ \" ، فَقَالَ : يَا أَبَا سَعِيدٍ ، تُرِكَ مَا تَعْلَمُ ، فَقَالَ : كَلا ، وَرَبِّ الْمَشَارِقِ وَالْمَغَارِبِ ، ثَلاثَ مَرَّاتٍ ، لا تَأْتُونَ بِخَيْرٍ مِمَّا نَعْلَمُ ثُمَّ بَدَأَ بِالْخُطْبَةِ ""","","","","","Book of the Two Eid Prayers"
"5492","عَنِ الثَّوْرِيِّ ، عَنْ قَيْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِهَابٍ ، قَالَ : أَوَّلُ مَنْ قَدَّمَ الْخُطْبَةَ قَبْلَ الصَّلاةِ يَوْمَ الْعِيدِ مَرْوَانُ ، فَقَامَ إِلَيْهِ رَجُلٌ ، فَقَالَ : يَا مَرْوَانُ خَالَفْتَ السُّنَّةَ ، فَقَالَ مَرْوَانُ : يَا فُلانُ تُرِكَ مَا هُنَالِكَ ، فَقَالَ أَبُو سَعِيدٍ : أَمَّا هَذَا فَقَدْ قَضَى الَّذِي عَلَيْهِ ، سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : \"مَنْ رَأَى مِنْكُمْ مُنْكَرًا فَاسْتَطَاعَ أَنْ يُغَيِّرَهُ بِيَدِهِ فَلْيَفْعَلْ ، فَإِنْ لَمْ يَسْتَطِعْ فَبِلِسَانِهِ ، فَإِنْ لَمْ يَسْتَطِعْ فَبِقَلْبِهِ ، وَذَلِكَ أَضْعَفُ الإِيمَانِ ""","","","","","Book of the Two Eid Prayers"
"5493","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : مَتَى كَانَ مَنْ مَضَى يَخْرُجُ أَحَدُهُمْ مِنْ بَيْتِهِ يَوْمَ الْفِطْرِ لِلصَّلاةِ ؟ فَقَالَ : كَانُوا يَخْرُجُونَ حَتَّى يَمْتَدَّ الضُّحَى فَيُصَلُّونَ ، ثُمَّ يَخْطُبُونَ قَلِيلا سُوَيْعَةً ، يُقَلِّلُ خُطْبَتَهُمْ ؟ قَالَ : لا يَحْبِسُونَ النَّاسَ شَيْئًا ، قَالَ : ثُمَّ يَنْزِلُونَ فَيَخْرُجُ النَّاسُ ؟ قَالَ :مَا جَلَسَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى مِنْبَرٍ حَتَّى مَاتَ ، مَا كَانَ يَخْطُبُ إِلا قَائِمًا ، فَكَيْفَ يُخْشَى أَنْ يَحْبِسُوا النَّاسَ ؟ وَإِنَّمَا كَانُوا يَخْطُبُونَ قِيَامًا لا يَجْلِسُونَ ، إِنَّمَا كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَأَبُو بَكْرٍ ، وَعُمَرُ ، وَعُثْمَانُ ، يَرْتَقِي أَحَدُهُمْ عَلَى الْمِنْبَرِ ، فَيَقُومُ كَمَا هُوَ قَائِمًا لا يَجْلِسُ عَلَى الْمِنْبَرِ ، حَتَّى يَرْتَقِيَ عَلَيْهِ ، وَلا يَجْلِسُ عَلَيْهِ بَعْدَمَا يَنْزِلُ ؟ وَإِنَّمَا خُطْبَتُهُ جَمِيعًا وَهُوَ قَائِمٌ ، إِنَّمَا كَانُوا يَتَشَهَّدُونَ مَرَّةً وَاحِدَةً الأُولَى، قَالَ : لَمْ يَكُنْ مِنْبَرٌ ، إِلا مِنْبَرُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، حَتَّى جَاءَ مُعَاوِيَةُ حِينَ حَجَّ بِالْمِنْبَرِ ، فَتَرَكَهُ ، قَالَ : فَلا يَزَالُونَ يَخْطُبُونَ عَلَى الْمَنَابِرِ بَعْدُ","","","","","Book of the Two Eid Prayers"
"5494","عَنِ ابْنِ أَبِي يَحْيَى ، عَنْ أَبِي الْحُوَيْرِثِ ، قَالَ : كَتَبَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَى عَمْرِو بْنِ حَزْمٍ حِينَ وَجَّهَهُ إِلَى نَجْرَانَ : \" أَنْأَخِّرِ الْفِطْرَ ، وَذَكِّرِ النَّاسَ ، وَعَجِّلِ الأَضْحَى ""","","","","","Book of the Two Eid Prayers"
"5495","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، \" أَنَّخُطْبَةَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَوْمَ الْجُمُعَةِ كَانَتْ مَرَّتَيْنِ قَائِمًا \"، قَالَ مَعْمَرٌ : قُلْتُ فبلَغَكَ ذَلِكَ مِنْ ثِقَةٍ ؟ قَالَ : نَعَمْ ، مَا شِئْتَ","","","","","Book of the Two Eid Prayers"
"5496","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ \" كَانَالنَّاسُ يَخْطُبُونَ يَوْمَ الْجُمُعَةِ خُطْبَتَيْنِ ، بَيْنَهُمَا جَلْسَةٌ ""","","","","","Book of the Two Eid Prayers"
"5497","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي أَبُو الزُّبَيْرِ ، أَنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَإِذَا خَطَبَ يَسْتَنِدُ إِلَى جِذْعِ نَخْلَةٍ مِنْ سَوَارِي الْمَسْجِدِ ، فَلَمَّا صُنِعَ الْمِنْبَرُ فَاسْتَوَى عَلَيْهِ ، اضْطَرَبَ تِلْكَ السَّارِيَةُ كَحَنِينِ النَّاقَةِ ، حَتَّى سَمِعَهَا أَهْلُ الْمَسْجِدِ حَتَّى نَزَلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَاعْتَنَقَهَا فَسَكَتَتْ ""","","","","","Book of the Two Eid Prayers"
"5498","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : حَدَّثَنِي أَبَانُ ، أَنَّ أَنَسَ بْنَ مَالِكٍ أَخْبَرَهُ ، \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَيَوْمَ الْفِطْرِ ، وَيَوْمَ الأَضْحَى يَخْطُبُ عَلَى رَاحِلَتِهِ بَعْدَ الصَّلاةِ ، قَالَ : يَتَشَهَّدُ ، ثُمَّ يَقْرَأُ بِسُورَةٍ مِنَ الْقُرْآنِ ، يَدْعُو بِدَعَوَاتٍ ، ثُمَّ يَنْطَلِقُ ""","","","","","Book of the Two Eid Prayers"
"5499","عَنْ إِسْرَائِيلَ بْنِ يُونُسَ ، عَنْ سِمَاكِ بْنِ حَرْبٍ \" أَنَّهُ شَهِدَ الْمُغِيرَةَ بْنَ شُعْبَةَ فِي يَوْمِ عِيدٍصَلَّى بِغَيْرِ أَذَانٍ وَلا إِقَامَةٍ ، ثُمَّ جَاءَ يُقَادُ بِهِ بَعِيرُهُ ، حَتَّى خَطَبَ بَعْدَ الصَّلاةِ عَلَى بَعِيرِهِ ""","","","","","Book of the Two Eid Prayers"
"5500","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ الْكَرِيمِ الْجَزْرِيِّ ، قَالَ : أَخْبَرَنَا زِيَادُ بْنُ أَبِي مَرْيَمَ \" أَنَّهُ شَهِدَ الْمُغِيرَةَصَلَّى فِيهِ قَبْلَ الْخُطْبَةِ ، ثُمَّ رَكِبَ بُخَيْتًا لَهُ ، ثُمَّ خَطَبَهُمْ ، فَلَمَّا فَرَغَ دَفَعَهُ ""","","","","","Book of the Two Eid Prayers"
"5501","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ أَبِي جَنَابٍ ، قَالَ : سَمِعْتُ يَزِيدَ بْنَ الْبَرَاءِ بْنِ عَازِبٍ ، يُحَدِّثُ عَنْ أَبِيهِ ، قَالَ : \" لَمَّا كَانَيَوْمُ الأَضْحَى ، أَتَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْبَقِيعَ ، فَنُوِّلَ قَوْسًا فَخَطَبَ عَلَيْهِا ""","","","","","Book of the Two Eid Prayers"
"5502","عَنِ الثَّوْرِيِّ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، قَالَ : \" رَأَيْتُ عَبْدَ اللَّهِ بْنَ الزُّبَيْرِيَخْطُبُ ، وَفِي يَدِهِ عَصًا ""","","","","","Book of the Two Eid Prayers"
"5503","عَنْ مَعْمَرٍ ، قَالَ : بَلَغَنِي أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ،لَمْ يَكُنْ لَهُ يُخْرِجُ مِنْبَرًا وَلا لأَصْحَابِهِ فِي يَوْمِ عِيدٍ ، وَأَوَّلُ مَنْ أَخْرَجَ الْمِنْبَرَ مَرْوَانُ \" ، فَقَالَ لَهُ رَجُلٌ : \" أَخْرَجْتَ الْمِنْبَرَ وَلَمْ يَكُنْ يَخْرُجُ ، وَبَدَأْتَ بِالْخُطْبَةِ قَبْلَ الصَّلاةِ وَلَمْ يَكُنْ يَفْعَلُ ، وَجَلَسْتَ فِي الْخُطْبَةِ وَلَمْ يَكُنْ يَجْلِسُ \" ، قَالَ : \" إِنَّ تِلْكَ السُّنَّةَ قَدْ تُرِكَتْ ""","","","","","Book of the Two Eid Prayers"
"5504","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَخْرُجُ مَعَهُ يَوْمَ الْفِطْرِ بِعَنْزَةٍ ، فَيَرْكُزُهَا فِي الْمُصَلَّى بَيْنَ يَدَيْهِ فَيُصَلِّي إِلَيْهِا ""","","","","","Book of the Two Eid Prayers"
"5505","عَنْ مَعْمَرٍ ، قَالَ : سَمِعْتُ بَعْضَ أَهْلِ الْمَدِينَةِ ، يَذْكُرُ \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَإِذَا خَطَبَ ، اعْتَمَدَ عَلَى عَصَاهُ اعْتِمَادًا ""","","","","","Book of the Two Eid Prayers"
"5506","عَنِ الثَّوْرِيِّ ، عَنْ صَاحِبٍ لَهُ ، عَنْ رَجُلٍ ، حَدَّثَهُ ، عَنْ عَلِيٍّ ، قَالَ \"رَأَيْتُهُ يَأْتِي الْعِيدَ مَاشِيًا ""","","","","","Book of the Two Eid Prayers"
"5507","عَنِ الثَّوْرِيِّ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : كَتَبَ ابْنُ عَبْدِ الْعَزِيزِ يُرَغِّبُهُمْ فِي الْعِيدَيْنِمَنِ اسْتَطَاعَ أَنْ يَأْتِيَهُمَا مَاشِيًا ، فَلْيَفْعَلْ ""","","","","","Book of the Two Eid Prayers"
"5508","عَنِ الثَّوْرِيِّ ، عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ ، عَنْ إِبْرَاهِيمَ النَّخْعِيِّ \" أَنَّهُ كَانَيَكْرَهُ الرُّكُوبَ فِي الْعِيدِ ، وَالْجُمُعَةِ ""","","","","","Book of the Two Eid Prayers"
"5509","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ ، عَنْ مِحْنَفِ بْنِ سُلَيْمٍ ، وَكَانَتْ لَهُ صُحْبَةٌ ، قَالَ \"خُرُوجُ يَوْمِ الْفِطْرِ يَعْدِلُ عُمْرَةً ، وَخُرُوجُ يَوْمِ الأَضْحَى يَعْدِلُ حَجَّةً ""","","","","","Book of the Two Eid Prayers"
"5510","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِيٍّ ، قَالَ : \" مِنَ السُّنَّةِ أَنْتَأْتِيَ الْمُصَلَّى يَوْمَ الْعِيدِ مَاشِيًا ""","","","","","Book of the Two Eid Prayers"
"5511","عَنِ الثَّوْرِيِّ ، عَنْ جُوَيْبِرٍ ، عَنِ الضَّحَّاكِ بْنِ مُزَاحِمٍ ، قَالَ :\" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، أَنْ يُخْرَجَ بِالسِّلاحِ يَوْمَ الْعِيدِ \"، عَنْ هُشَيْمٍ ، عَنْ جُوَيْبِرٍ ، عَنِ الضَّحَّاكِ مِثْلَهُ ، وَزَادَ فِيهِ : \" إِلا أَنْ يَخَافُوا عَدُوًّا ، فَيَخْرُجُوا ""","","","","","Book of the Two Eid Prayers"
"5512","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَطَاءٌ ، قَالَ بَلَغَنِي أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ ، يَقُولُ : \"إِذَا قَضَيْنَا الصَّلاةَ فَمَنْ شَاءَ ، فَلْيَنْتَظِرِ الْخُطْبَةَ ، وَمَنْ شَاءَ فَلْيَذْهَبْ \"، قَالَ : فَكَانَ عَطَاءٌ ، يَقُولُ : لَيْسَ عَلَى النَّاسِ حُضُورُ الْخُطْبَةِ يَوْمَئِذٍ","","","","","Book of the Two Eid Prayers"
"5513","عَنْ مَعْمَرٍ ، عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ ، قَالَ \"سَمِعْتُ أَنَّهُ يُكَبَّرُ فِي الْعِيدِ تِسْعًا وَسَبْعًا ""","","","","","Book of the Two Eid Prayers"
"5514","عَنْ مَعْمَرٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللَّهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَبْدٍ الْقَارِيِّ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ بْنِ مَسْعُودٍ ، أَنَّهُ قَالَ : \"يُكَبِّرُ الإِمَامُ يَوْمَ الْفِطْرِ ، قَبْلَ أَنْ يَخْطُبَ ، تِسْعًا حِينَ يُرِيدُ الْقِيَامَ ، وَسَبْعًا فِي \"، عَالَجْتُهُ عَلَى أَنْ يُفَسِّرَ لِي أَحْسَنَ مِنْ هَذَا فَلَمْ يَسْتَطِعْ ، فَظَنَنْتُ أَنَّ قَوْلَهُ : \" حِينَ يُرِيدُ الْقِيَامَ فِي الْخُطْبَةِ الآخِرَةِ ""","","","","","Book of the Two Eid Prayers"
"5515","عَنِ ابْنِ أَبِي يَحْيَى ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ مُحَمَّدٍ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ ، قَالَ \"السُّنَّةُ التَّكْبِيرُ عَلَى الْمِنْبَرِ يَوْمَ الْعِيدِ ، يَبْدَأُ خُطْبَتَهُ الأُولَى بِتِسْعِ تَكْبِيرَاتٍ قَبْلَ أَنْ يَخْطُبَ ، وَيَبْدَأُ الآخِرَةَ بِسَبْعٍ \"، عَنِ ابْنِ جُرَيْجٍ ، عَنْ إِبْرَاهِيمَ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ نَحْوَهُ","","","","","Book of the Two Eid Prayers"
"5516","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، أَنَّهُ سَمِعَ مَكْحُوَلا ، يَقُولُ : \"بَيْنَ كُلِّ تَكْبِيرَتَيْنِ ، صَلاةٌ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","Book of the Two Eid Prayers"
"5517","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ \"التَّكْبِيرُ فِي الصَّلاةِ يَوْمَ الْفِطْرِ ثَلاثَ عَشْرَةَ تَكْبِيرَةً ، يُكَبِّرُهُنَّ وَهُوَ قَائِمٌ ، سَبْعَةٌ فِي الرَّكْعَةِ الأُولَى : مِنْهُنَّ تَكْبِيرَةُ اسْتِفْتَاحٍ لِلصَّلاةِ ، وَمِنْهُنَّ تَكْبِيرَةُ الرَّكْعَةِ ، وَمِنْهُنَّ سِتٌّ قَبْلَ الْقِرَاءَةِ ، وَمِنْهُنَّ وَاحِدَةٌ بَعْدَهَا ، وَفِي الأُخْرَى سِتُّ تَكْبِيرَاتٍ : مِنْهُنَّ تَكْبِيرَةٌ لِلرَّكْعَةِ ، وَمِنْهُنَّ خَمْسٌ قَبْلَ الْقِرَاءَةِ ، وَوَاحِدَةٌ بَعْدَهَا \"، قُلْتُ لَهُ : إِنَّ يُوسُفَ بْنَ مَاهَكَ ، أَخْبَرَنِي أَنَّ ابْنَ الزُّبَيْرِ ، كَانَ لا يُكَبِّرُ إِلا أَرْبَعًا فِي كُلِّ رَكْعَةٍ سَوَاءٌ يُكَبِّرُهُنَّ فِي كُلِّ رَكْعَتَيْنِ ، سَمِعْنَا ذَلِكَ مِنْهُ ، فَقَالَ عَطَاءٌ : إِنَّ الَّذِي أَخَذْتُ هَذَا الْحَدِيثَ عَنْهُ هُوَ ، وَاللَّهُ أَعْلَمُ مِنِ ابْنِ الزُّبَيْرِ ، قُلْتُ : مَنْ ؟ قَالَ : ابْنُ عَبَّاسٍ","","","","","Book of the Two Eid Prayers"
"5518","عَنْ عَبْدِ اللَّهِ بْنِ عَبْدِ الرَّحْمَنِ الطَّائِفيِّ ، أَنَّهُ سَمِعَ عَمْرَو بْنَ شُعَيْبٍ يُحَدِّثُ ، عَنْ أَبِيهِ ، عَنْ جَدِّهِ : \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَكَبَّرَ يَوْمَ الْفِطْرِ فِي الرَّكْعَةِ الأُولَى سَبْعًا ، ثُمَّ قَرَأَ ، فَكَبَّرَ تَكْبِيرَةَ الرَّكْعَةِ ، ثُمَّ كَبَّرَ فِي الأُخْرَى خَمْسًا ، ثُمَّ قَرَأَ ، ثُمَّ كَبَّرَ ، ثُمَّ رَكَعَ ""","","","","","Book of the Two Eid Prayers"
"5519","عَنِ ابْنِ أَبِي يَحْيَى ، عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ ، عَنْ أَبِيهِ ، قَالَ : \" عَلِيٌّيُكَبِّرُ فِي الأَضْحَى ، وَالْفِطْرِ ، وَالاسْتِسْقَاءِ سَبْعًا فِي الأُولَى ، وَخَمْسًا فِي الأُخْرَى ، وَيُصَلِّي قَبْلَ الْخُطْبَةِ وَيَجْهَرُ بِالْقِرَاءَةِ \" ، قَالَ : \" وَكَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَأَبُو بَكْرٍ ، وَعُمَرُ ، وَعُثْمَانُ ، يَفْعَلُونَ ذَلِكَ ""","","","","","Book of the Two Eid Prayers"
"5520","عَنِ ابْنِ أَبِي يَحْيَى ، عَنِ الْحَارِثِ ، عَنْ أَبِي إِسْحَاقَ بْنِ عَبْدِ اللَّهِ بْنِ كِنَانَةَ ، عَنْ أَبِيهِ ، عَنِ ابْنِ عَبَّاسٍ ، أَحْسِبُهُ قَدْ بَلَغَ بِهِ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أَنَّهُ كَانَيُكَبِّرُ فِي الأَضْحَى وَالْفِطْرِ سَبْعًا فِي الأُولَى ، وَخَمْسًا فِي الآخِرَةِ ""","","","","","Book of the Two Eid Prayers"
"5521","عَنْ مَالِكٍ ، عَنْ نَافِعٍ ، قَالَ \"شَهِدْتُ الْعِيدَ مَعَ أَبِي هُرَيْرَةَ يُكَبِّرُ فِي الأُولَى سَبْعًا ، وَفِي الآخِرَةِ خَمْسًا قَبْلَ الْقِرَاءَةِ \"، عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنْ أَبِي هُرَيْرَةَ مِثْلَهُ . عَنِ ابْنِ جُرَيْجٍ ، عَنْ مُوسَى بْنِ عُقْبَةَ ، عَنْ نَافِعٍ ، عَنْ أَبِي هُرَيْرَةَ مِثْلَهُ","","","","","Book of the Two Eid Prayers"
"5522","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : سَمِعْتُهُ ، يَقُولُ : \"التَّكْبِيرُ يَوْمَ الْعِيدِ قَبْلَ الْقِرَاءَةِ سَبْعًا وَخَمْسًا ""","","","","","Book of the Two Eid Prayers"
"5523","عَنْ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ أَبِي سَبْرَةَ ، عَنْ رَبِيعَةَ ، وَأَبِي الزِّنَادِ ، وَعَبْدِ اللَّهِ بْنِ مُحَمَّدٍ ، وَغَيْرِهِمْ ، \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَيُكَبِّرُ يَوْمَ الْفِطْرِ ، وَالأَضْحَى ، وَالاسْتِسْقَاءِ تَكْبِيرًا وَاحِدًا ، سَبْعًا فِي الأُولَى ، وَخَمْسًا فِي الأُخْرَى ""","","","","","Book of the Two Eid Prayers"
"5524","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ الْكَرِيمِ بْنِ أَبِي الْمُخَارِقِ ، عَنْ إِبْرَاهِيمَ النَّخْعِيِّ ، عَنْ عَلْقَمَةَ بْنِ قَيْسٍ ، عَنِ الأَسْوَدِ بْنِ يَزِيدَ ، عَنِ ابْنِ مَسْعُودٍ :\" فِي الأُولَى خَمْسَ تَكْبِيرَاتٍ بِتَكْبِيرَةِ الرَّكْعَةِ ، وَبِتَكْبِيرَةِ الاسْتِفْتَاحِ ، وَفِي الرَّكْعَةِ الأُخْرَى أَرْبَعَةٌ بِتَكْبِيرَةِ الرَّكْعَةِ ""","","","","","Book of the Two Eid Prayers"
"5525","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَلْقَمَةَ ، وَالأَسْوَدِ بْنِ يَزِيدَ ، \" أَنَّ ابْنَ مَسْعُودٍ كَانَيُكَبِّرُ فِي الْعِيدَيْنِ تِسْعًا تِسْعًا : أَرْبَعًا قَبْلَ الْقِرَاءَةِ ، ثُمَّ كَبَّرَ فَرَكَعَ ، وَفِي الثَّانِيَةِ يَقْرَأُ ، فَإِذَا فَرَغَ كَبَّرَ أَرْبَعًا ، ثُمَّ رَكَعَ ""","","","","","Book of the Two Eid Prayers"
"5526","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَلْقَمَةَ ، وَالأَسْوَدِ بْنِ يَزِيدَ ، قَالَ : كَانَ ابْنُ مَسْعُودٍ جَالِسًا ، وَعِنْدَهُ حُذَيْفَةُ ، وَأَبُو مُوسَى الأَشْعَرِيُّ ، فَسَأَلَهُمَا سَعِيدُ بْنُ الْعَاصِ عَنِالتَّكْبِيرِ فِي الصَّلاةِ يَوْمَ الْفِطْرِ وَالأَضْحَى ، فَجَعَلَ هَذَا يَقُولُ : سَلْ هَذَا ، وَهَذَا يَقُولُ : سَلْ هَذَا ، فَقَالَ لَهُ حُذَيْفَةُ : سَلْ هَذَا ، لِعَبْدِ اللَّهِ بْنِ مَسْعُودٍ ، فَسَأَلَهُ ، فَقَالَ ابْنُ مَسْعُودٍ \" يُكَبِّرُ أَرْبَعًا ، ثُمَّ يَقْرَأُ ، ثُمَّ يُكَبِّرُ فَيَرْكَعُ ، ثُمَّ يَقُومُ فِي الثَّانِيَةِ فَيَقْرَأُ ، ثُمَّ يُكَبِّرُ أَرْبَعًا بَعْدَ الْقِرَاءَةِ ""","","","","","Book of the Two Eid Prayers"
"5527","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، ذَكَرَ أَنَّ زِيَادًا ، سَأَلَ مَسْرُوقًا عَنْ تَكْبِيرِ الإِمَامِ ، قَالَ \"يُكَبِّرُ الإِمَامُ وَاحِدَةً ثُمَّ يُكَبِّرُ أَرْبَعًا ، ثُمَّ يَقْرَأُ ، ثُمَّ يُكَبِّرُ ، ثُمَّ يَسْجُدُ ، ثُمَّ يَقُومُ فِي الآخِرَةِ فَيَقْرَأُ ، ثُمَّ يُكَبِّرُ ثَلاثًا ، ثُمَّ يُكَبِّرُ وَاحِدَةً يَرْكَعُ بِهَا \"، قَالَ قَتَادَةُ : وَبَلَغَنِي مِثْلَ هَذَا عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ","","","","","Book of the Two Eid Prayers"
"5528","قَالَ : أَخْبَرَنَا إِسْمَاعِيلُ بْنُ أَبِي الْوَلِيدِ ، قَالَ : حَدَّثَنَا خَالِدٌ الْحَذَّاءُ ، عَنْ عَبْدِ اللَّهِ بْنِ الْحَارِثِ ، قَالَ : \" شَهِدْتُ ابْنَ عَبَّاسٍكَبَّرَ فِي صَلاةِ الْعِيدِ بِالْبَصْرَةِ تِسْعَ تَكْبِيرَاتٍ ، وَالَى بَيْنَ الْقِرَاءَتَيْنِ \"، قَالَ : وَشَهِدْتُ الْمُغِيرَةَ بْنَ شُعْبَةَ فَعَلَ ذَلِكَ أَيْضًا ، فَسَأَلْتُ خَالِدًا كَيْفَ فَعَلَ ابْنُ عَبَّاسٍ ؟ فَفَسَّرَ لَنَا كَمَا صَنَعَ ابْنُ مَسْعُودٍ فِي حَدِيثِ مَعْمَرٍ ، وَالثَّوْرِيِّ عَنْ أَبِي إِسْحَاقَ سَوَاءً","","","","","Book of the Two Eid Prayers"
"5529","قَالَ : أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : فِي الأَضْحَى يَوْمَئِذٍ عَلَى أَهْلِ الآفَاقِ سُنَّةٌ مَسْنُونَةٌ فِي شَيءٍ يَصْنَعُونَهُ ؟ قَالَ \"صَلاةٌ وَاحِدَةٌ كَالْفِطْرِ ، وَلا تَجِبُ إِلا فِي جَمَاعَتِهَا رَكْعَتَانِ قَطُّ ، وَذَبْحٌ إِنْ شَاءَ \" ، وَقَالَ : \" حَقٌّ عَلَيْهِمْ أَنْ يَحْضُرُوهَا ، كَمَا حَقٌّ عَلَيْهِمْ حُضُورُ صَلاةِ الْفِطْرِ ""","","","","","Book of the Two Eid Prayers"
"5530","قَالَ : أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى \" أَنَّفِي الأَضْحَى ، عِنْدَهُمْ مِنَ التَّكْبِيرِ مِثْلَمَا يَكُونُ عِنْدَهُمْ فِي الْفِطْرِ ""","","","","","Book of the Two Eid Prayers"
"5531","قَالَ : أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى \" أَنَّفِي الأَضْحَى عِنْدَهُمْ مَا فِي الْفِطْرِ ""","","","","","Book of the Two Eid Prayers"
"5532","قَالَ : أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قَالَ لِي عَطَاءٌ \" إِنِّيلا أَكْرَهُ فِي الرَّكْعَتَيْنِ مِنَ التَّكْبِيرِ فِي يَوْمِ الأَضْحَى مِثْلَمَا فِي يَوْمِ الْفِطْرِ ، وَمَا بَلَغَنِي ذَلِكَ عَنْ أَحَدٍ ""","","","","","Book of the Two Eid Prayers"
"5533","عَنْ إِبْرَاهِيمَ بْنِ يَزِيدَ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، قَالَ : \"التَّكْبِيرُ فِي يَوْمِ الْعِيدِ فِي الرَّكْعَةِ الأُولَى أَرْبَعًا ، وَفِي الآخِرَةِ ثَلاثًا ، فَالتَّكْبِيرُ سَبْعٌ سِوَى تَكْبِيرُ الصَّلاةِ ""","","","","","Book of the Two Eid Prayers"
"5534","قَالَ : أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قَالَ عَبْدُ الْكَرِيمِ : \"سُنَّةُ الأَضْحَى سُنَّةُ الْفِطْرِ إِلا الذَّبْحَ \" ، قَالَ : \" وَسَوَاءٌ فِي الْخُرُوجِ وَالْخُطْبَةِ وَالتَّكْبِيرِ إِلا الذَّبْحَ ""","","","","","Book of the Two Eid Prayers"
"5535","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قَالَ لِي عَطَاءٌ \"يَقُومُ الإِمَامُ فَيُكَبِّرُ لاسْتِفْتَاحِ الصَّلاةِ ، ثُمَّ يَمْكُثُ سَاعَةً يَدْعُو وَيَذْكُرُ فِي نَفْسِهِ مِنْ غَيْرِ أَنْ يَكُونَ بَلَغَهُمْ قَوْلٌ مَعَلُومٌ ، وَلا مِنْ دُعَاءٍ وَلا مِنْ غَيْرِهِ ، ثُمَّ يُكَبِّرُ الثَّانِيَةَ ، ثُمَّ يَمْكُثُ كَذَلِكَ سَاعَةً يَدْعُو فِي نَفْسِهِ وَيُكَبِّرُ ، ثُمَّ كَذَلِكَ بَيْنَ كُلِّ تَكْبِيرَتَيْنِ سَاعَةٌ يَدْعُو وَيَذْكُرُ فِي نَفْسِهِ حَتَّى يُكَبِّرَ سِتًّا بِتَكْبِيرَةِ الاسْتِفْتَاحِ ، ثُمَّ يَقْرَأُ ، فَإِذَا خَتَمَ كَبَّرَ السَّابِعَةَ لِلرَّكْعَةِ ، ثُمَّ قَامَ فِي الثَّانِيَةِ ، فَإِذَا اسْتَوَى قَائِمًا ، كَبَّرَ ، ثُمَّ مَكَثَ سَاعَةً يَدْعُو فِي نَفْسِهِ وَيَذْكُرُ ، ثُمَّ يُكَبِّرُ الثَّانِيَةِ ، ثُمَّ كَذَلِكَ حَتَّى يُكَبِّرَ خَمْسًا قَبْلَ الْقِرَاءَةِ ، فَإِذَا خَتَمَ كَبَّرَ السَّادِسَةَ ، فَتِلْكَ ثَلاثَ عَشْرَةَ تَكْبِيرَةً ، كُلُّهُنَّ يُكَبِّرُ الإِمَامُ وَهُوَ قَائِمٌ \"، قَالَ ذَلِكَ غَيْرَ مَرَّةٍ ، وَلا يُحْتَسَبُ فِي ذَلِكَ بِتَكْبِيرَةِ السُّجُودِ","","","","","Book of the Two Eid Prayers"
"5536","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ ، عَنْ إِبْرَاهِيمَ النَّخْعِيِّ ، عَنْ عَلْقَمَةَ ، وَالأَسْوَدِ ، عَنِ ابْنِ مَسْعُودٍ \" أَنَّبَيْنَ كُلِّ تَكْبِيرَتَيْنِ قَدْرُ كَلِمَةٍ ""","","","","","Book of the Two Eid Prayers"
"5537","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ \"هَلْ مِنْ تَهْلِيلٍ أَوْ تَسْبِيحٍ أَوْ حَمْدٍ ، يُقَالَ يَوْمَئِذٍ كَمَا يُقَالَ التَّكْبِيرُ ، فَيَحِقُّ أَنْ يُعْمَلَ بِهِ فِي الصَّلاةِ ، أَوْ بَعْدَهَا ، أَوْ قَبْلَهَا ، أَوْ عَلَى الْمِنْبَرِ ، قَالَ : لَمْ يَبْلُغْنِي ""","","","","","Book of the Two Eid Prayers"
"5538","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ \"يَرْفَعُ الإِمَامُ يَدَيْهِ كُلَّمَا كَبَّرَ هَذِهِ التَّكْبِيرَةِ الزِّيَادَةَ فِي صَلاةِ الْفِطْرِ ؟ \" ، قَالَ : \" نَعَمْ ، وَيَرْفَعُ النَّاسُ أَيْضًا ""","","","","","Book of the Two Eid Prayers"
"5539","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِيٍّ : \" فِيالْقِرَاءَةِ فِي الْعِيدَيْنِ تُسْمِعُ مَنْ يَلِيكَ ""","","","","","Book of the Two Eid Prayers"
"5540","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي إِبْرَاهِيمُ بْنُ مَيْسَرَةَ ، أَنَّهُ سَمِعَ طَاوُسًا ، يَقُولُ : \" كَانَيُقْرَأُ فِي الصَّلاةِ يَوْمَ الْفِطْرِ : اقْتَرَبَتِ السَّاعَةُ \"، قَالَ : \" وَلا أَعْلَمُ إِلا ذَكَرَهُ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","Book of the Two Eid Prayers"
"5541","عَنْ مَعْمَرٍ ، وَابْنِ جُرَيْجٍ ، عَنْ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، كَانَيَقْرَأُ فِي الصَّلاةِ يَوْمَ الْعِيدِ : ق ، وَ اقْتَرَبَتِ السَّاعَةُ ""","","","","","Book of the Two Eid Prayers"
"5542","عَنْ مَالِكٍ ، وَابْنِ عُيَيْنَةَ ، عَنْ ضَمْرَةَ بْنِ سَعِيدٍ ، قَالَ : سَمِعْتُ عُبَيْدَ اللَّهِ بْنَ عُتْبَةَ ، يَقُولُ : خَرَجَ عُمَرُ بْنُ الْخَطَّابِ فِي يَوْمِ عِيدٍ ، فَسَأَلَ أَبَا وَاقِدٍ اللَّيْثِيَّ \" بِأَيِّ شَيءٍ كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَقْرَأُ فِي الصَّلاةِ يَوْمَ الْعِيدِ ؟ فَقَالَ : بِقَافٍ ، وَ اقْتَرَبَتِ ""","","","","","Book of the Two Eid Prayers"
"5543","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ، قَالَ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَقْرَأُ فِي الصَّلاةِ يَوْمَ الْعِيدِ : \" بِـ سَبِّحِ اسْمَ رَبِّكَ الأَعْلَى ، وَ هَلْ أَتَاكَ ""","","","","","Book of the Two Eid Prayers"
"5544","عَنِ الثَّوْرِيِّ ، عَنْ مُوسَى بْنِ عُبَيْدَةَ ، عَنْ مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَقْرَأُ فِي الْعِيدَيْنِ فِي الرَّكْعَةِ الأُولَى : بِفَاتِحَةِ الْكِتَابِ ، وَ سَبِّحِ اسْمَ رَبِّكَ الأَعْلَى ، وَفِي الآخِرَةِ : بِفَاتِحَةِ الْكِتَابِ ، وَ هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ ""","","","","","Book of the Two Eid Prayers"
"5545","عَنِ الثَّوْرِيِّ ، عَنْ إِبْرَاهِيمَ بْنِ الْمُنْتَشِرِ ، عَنْ أَبِيهِ ، عَنْ حَبِيبِ بْنِ سَالِمٍ ، عَنِ النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَقْرَأُ فِي يَوْمِ الْجُمُعَةِ ، وَفِي الْعِيدَيْنِ : بِـ سَبِّحِ اسْمَ رَبِّكَ الأَعْلَى ، وَ هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ ""","","","","","Book of the Two Eid Prayers"
"5546","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِيٍّ ، قَالَ \"مِنَ السُّنَّةِ أَنْ تَأْتِيَ الصَّلاةَ يَوْمَ الْعِيدِ ""","","","","","Book of the Two Eid Prayers"
"5547","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ \"أَوَاجِبَةٌ صَلاةُ يَوْمِ الْفِطْرِ عَلَى النَّاسِ أَجْمَعِينَ ؟ قَالَ : لا ، إِلا فِي الْجَمَاعَةِ ، قَالَ : مَا الْجُمُعَةُ بِأَنْ يُؤْتَى أَوْجَبُ بِذَلِكَ مِنْهَا ، إِلا فِي الْجَمَاعَةِ فَكَيْفَ فِي الْفِطْرِ ؟ قَالَ عَطَاءٌ : لا يَتِمَّانِ أَرْبَعًا فِي جَمَاعَةٍ وَلا غَيْرِهَا ، قَالَ : قُلْتُ لِعَطَاءٍ : أَحَقٌّ عَلَى أَهْلِ الْقَرْيَةِ أَنْ يَحْضُرُوا صَلاةَ الْفِطْرِ ، كَمَا حَقَّ عَلَيْهِمْ حُضُورُ يَوْمِ الْجُمُعَةِ ؟ قَالَ : نَعَمْ ، قَالَ : ذَلِكَ تَتْرَى ، وَقَدْ كَانَ قَالَ لِي مَرَّةً أُخْرَى قَبْلَ هَذِهِ : حَقَّ ذَلِكَ ، فَأَمَّا كَحَقِّ الْجُمُعَةِ فَلا ، أُمِرُوا بِالْجُمُعَةِ ، ثُمَّ قَالَ : \" مَا مِنْ يَوْمٍ أَعْظَمُ مِنْ يَوْمِ الْجُمُعَةِ ، هُوَ أَعْظَمُ الأَيَّامِ كُلِّهَا ، أَعْظَمُ مِنْ يَوْمِ عَرَفَةَ ، وَيَوْمِ الْفِطْرِ ، وَقَدْ بَلَغَنَا أَنَّهُ لَيْسُ شَيءٌ لا بَرٌّ ، وَلا بَحْرٌ ، وَلا شَجَرٌ ، وَلا حَجَرٌ ، إِلا وَهُوَ لا يَزَالُ يَدْعُو يَوْمَئِذٍ ، حَتَّى تَطْلُعَ الشَّمْسُ إِلا الثَّقَلانِ الْجِنَّ وَالإِنْسَ ""","","","","","Book of the Two Eid Prayers"
"5548","عَنْ مَعْمَرٍ ، قَالَ \"مَا رَأَيْتُ الْجُمُعَةَ ، إِلا أَوْجَبَ عِنْدَهُمْ مِنَ الْفِطْرِ ، يَقُولُونَ : هَذِهِ فَرِيضَةٌ ، وَهَذِهِ سُنَّةٌ ""","","","","","Book of the Two Eid Prayers"
"5549","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ ، قَالا : \"صَلاةُ الأَضْحَى مِثْلُ صَلاةِ الْفِطْرِ ، رَكْعَتَانِ رَكْعَتَانِ ""","","","","","Book of the Two Eid Prayers"
"5550","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ \" أَرَأَيْتَلَوْ صَلَّيْتُ صَلاةَ الْفِطْرِ غَيْرَ مُتَوَضِّئٍ ، فَذَكَرْتُ بَعْدَ مَا فَرَغَ الإِمَامُ ؟ قَالَ : تُعِيدُهَا \"، وَقَالَ لِي ذَلِكَ عَمْرُو بْنُ دِينَارٍ","","","","","Book of the Two Eid Prayers"
"5551","عَنِ الثَّوْرِيِّ ، عَنْ بَكْرٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ \"إِذَا خَشِيتَ فِي الْعِيدَيْنِ أَنْ تَفُوتَكَ الصَّلاةُ وَأَنْتَ حَاقِنٌ ، فَبُلْ ثُمَّ تَيَمَّمْ ""","","","","","Book of the Two Eid Prayers"
"5552","عَنِ الثَّوْرِيِّ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِيِّ ، قَالَ : قَالَ عَبْدُ اللَّهِ :\" مَنْ فَاتَهُ الْعِيدَانِ ، فَلْيُصَلِّ أَرْبَعًا ""","","","","","Book of the Two Eid Prayers"
"5553","عَنِ الثَّوْرِيِّ : فِي رَجُلٍ يَفُوتُهُ رَكْعَةٌ مِنَ الْعِيدِ ، قَالَ \"يُصَلِّي مَعَ الإِمَامِ ، ثُمَّ يَقْضِي الرَّكْعَةَ الَّتِي فَاتَتْهُ ، وَيُكَبِّرُ كَمَا يُكَبِّرُ الإِمَامُ ، وَلَوْ وَجَدَ الإِمَامَ يَقْرَأُ ، كَبَّرَ ، كَمَا يُكَبِّرُ الإِمَامُ ""","","","","","Book of the Two Eid Prayers"
"5554","عَنِ الثَّوْرِيِّ ، عَنْ رَجُلِ ، عَنْ إِبْرَاهِيمَ ، قَالَ \"مَنْ فَاتَتْهُ صَلاةُ الْعِيدِ مَعَ الإِمَامِ ، فَلَيْسَ عَلَيْهِ تَكْبِيرٌ ""","","","","","Book of the Two Eid Prayers"
"5555","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ \"مَنْ فَاتَتْهُ الصَّلاةُ يَوْمَ الْفِطْرِ ، صَلَّى كَمَا يُصَلِّي الإِمَامُ \"، قَالَ مَعْمَرٌ : \" إِنْ فَاتَتْ إِنْسَانًا الْخُطْبَةُ ، أَوِ الصَّلاةُ يَوْمَ فِطْرٍ أَوْ أَضْحَى ، ثُمَّ حَضَرَ بَعْدَ ذَلِكَ ، فَإِنَّهُ يُصَلِّي رَكْعَتَيْنِ ""","","","","","Book of the Two Eid Prayers"
"5556","عَنِ ابْنِ أَبِي يَحْيَى ، عَنِ الْحَجَّاجِ ، عَنِ الزُّهْرِيِّ ، قَالَ : بَعَثَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَى قُرَى غَرِيبَةٍ ، فَدَكَ ، وَيَنْبُعَ وَنَحْوِهَا مِنَ الْقُرَى عَلَى مَسِيرَةِ ثَلاثٍ مِنَ الْمَدِينَةِ ، أَنْيُجَمِّعُوا وَأَنْ يُصَلُّوا الْعِيدَيْنِ","","","","","Book of the Two Eid Prayers"
"5557","عَنِ ابْنِ التَّيْمِيِّ ، وَغَيْرِهِ ، عَنْ شُعْبَةَ ، عَنِ الْحَكَمِ بْنِ عُتَيْبَةَ ، قَالَ \"كَانَ أَبُو عِيَاضٍ وَمُجَاهِدٌ مُتَوَارِيَيْنِ زَمَنَ الْحَجَّاجِ ، وَكَانَ يَوْمُ فِطْرٍ فَكُلِّمَ أَبُو عِيَاضٍ ، وَدَعَا لَهُمْ وَأَمَّهُمْ بِرَكْعَتَيْنِ \"، قَالَ : وَأَخْبَرَنَا شُعْبَةُ ، عَنْ قَتَادَةَ ، عَنْ عِكْرِمَةَ ، مَوْلَى ابْنِ عَبَّاسٍ ، أَنَّهُ كَانَ يَقُولُ مِثْلَ ذَلِكَ","","","","","Book of the Two Eid Prayers"
"5558","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِيٍّ ، قَالَ : \"لا جُمُعَةَ وَلا تَشْرِيقَ ، إِلا فِي مَصْرٍ جَامِعٍ \", قَالَ مَعْمَرٌ : يَعْنِي بِالتَّشْرِيقِ يَوْمَ الْفِطْرِ وَالأَضْحَى : الْخُرُوجَ إِلَى الْجَبَّانَةَ","","","","","Book of the Two Eid Prayers"
"5559","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ \"لَيْسَ عَلَى الْمُسَافِرِ صَلاةُ الأَضْحَى ، وَلا صَلاةُ الْفِطْرِ إِلا أَنْ يَكُونَ فِي مِصْرٍ أَوْ قَرْيَةٍ ، فَيَشْهَدَ مَعَهُمُ الصَّلاةَ ""","","","","","Book of the Two Eid Prayers"
"5560","عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنْ حَفْصَةَ بِنْتِ سِيرِينَ ، أَنَّ امْرَأَةً حَدَّثَتْهَا ، قَالَتْ : \"غَزَا زَوْجِي مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ اثْنَتَيْ عَشْرَةَ غَزْوَةً ، فَخَرَجْتُ مَعَهُ فِي خَمْسٍ مِنْهُنَّ ، فَكُنَّا نَقُومُ عَلَى الْمَرْضَى ، وَنُدَاوِي الْكَلْمَى ، وَأُمِرْنَا فِي الْعِيدَيْنِ أَنَّ مَنْ لَمْ يَكُنْ لَهَا جِلْبَابٌ أَنْ يُلْبِسَهَا صَاحِبَتُهَا مَعَهَا مِنْ جِلْبَابِهَا ، قَالَتْ حَفْصَةُ : فَقَدِمَتْ عَلَيْنَا أُمُّ عَطِيَّةَ الأَنْصَارِيَّةُ ، فَذَكَرْتُ ذَلِكَ لَهَا ، فَقَالَتْ : نَعَمْ بِأَبِي هُوَ وَأُمِّي ، أَمَرَنَا أَنْ نُخْرِجَ فِي الْعِيدَيْنِ الْعَوَاتِقَ ، وَذَوَاتِ الْخُدُورِ وَالحُيَّضِ ، قَالَتْ : فَأَمَّا الْحُيَّضُ فَيَعْتَزِلْنَ الْمُصَلَّى ، وَيَشْهَدْنَ الْخَيْرَ وَدَعْوَةَ الْمُسْلِمِينَ \"، عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ حَفْصَةَ بِنْتِ سِيرِينَ مِثْلَهُ","","","","","Book of the Two Eid Prayers"
"5561","عَنْ عَبْدِ اللَّهِ ، عَنْ سَعِيدٍ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ : \" كَانَتِامْرَأَةُ عَلْقَمَةَ جَلِيلَةً ، وَكَانَتْ تَخْرُجُ فِي الْعِيدَيْنِ ""","","","","","Book of the Two Eid Prayers"
"5562","عَنْ عُبَيْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ \" أَنَّهُ كَانَلا يُخْرِجُ نِسَاءَهُ فِي الْعِيدِ ""","","","","","Book of the Two Eid Prayers"
"5563","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قَالَ عَطَاءٌ \"إِنِ اجْتَمَعَ يَوْمُ الْجُمُعَةِ وَيَوْمُ الْفِطْرِ فِي يَوْمٍ وَاحِدٍ ، فَلْيَجْمَعْهُمَا ، فَلْيُصَلِّ رَكْعَتَيْنِ قَطُّ ، حَيْثُ يُصَلِّي صَلاةَ الْفِطْرِ ثُمَّ هِيَ حَتَّى الْعَصْرِ \"، ثُمَّ أَخْبَرَنِي عِنْدَ ذَلِكَ ، قَالَ : \" اجْتَمَعَ يَوْمُ فِطْرٍ وَيَوْمُ جُمُعَةٍ فِي يَوْمٍ وَاحِدٍ ، فِي زَمَانِ ابْنِ الزُّبَيْرِ ، فَقَالَ ابْنُ الزُّبَيْرِ : عِيدَانِ اجْتَمَعَا فِي يَوْمٍ وَاحِدٍ ، فَجَمَعَهُمَا جَمِيعًا بِجَعْلِهِمَا وَاحِدًا ، وَصَلَّى يَوْمَ الْجُمُعَةِ رَكْعَتَيْنِ بُكْرَةَ صَلاةَ الْفِطْرِ ، ثُمَّ لَمْ يَزِدْ عَلَيْهَا حَتَّى صَلَّى الْعَصْرَ \" ، قَالَ : \" فَأَمَّا الْفُقَهَاءُ فَلَمْ يَقُولُوا فِي ذَلِكَ ، وَأَمَّا مَنْ لَمْ يَفْقَهْ فَأَنْكَرَ ذَلِكَ عَلَيْهِ \" ، قَالَ : \" وَلَقَدْ أَنْكَرْتُ أَنَا ذَلِكَ عَلَيْهِ ، وَصَلَّيْتُ الظُّهْرَ يَوَمَئِذٍ \" ، قَالَ : \" حَتَّى بَلَغَنَا بَعْدُ أَنَّ الْعِيدَيْنِ كَانَا إِذَا اجْتَمَعَا كَذَلِكَ صُلِّيَا وَاحِدَةً \" ، وَذُكِرَ ذَلِكَ عَنْ مُحَمَّدِ بْنِ عَلِيِّ بْنِ حُسَيْنٍ ، أَخْبَرَ أَنَّهُمَا كَانَا يَجْمَعَانِ إِذَا اجْتَمَعَا ، قَالا : إِنَّهُ وَجَدَهُ فِي كِتَابٍ لِعَلِيٍّ ، زَعَمَ","","","","","Book of the Two Eid Prayers"
"5564","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي أَبُو الزُّبَيْرِ ، فِيجَمْعِ ابْنِ الزُّبَيْرِ بَيْنَهُمَا يَوْمَ جَمَعَ بَيْنَهُمَا","","","","","Book of the Two Eid Prayers"
"5565","قَالَ : سَمِعْنَا ذَلِكَ ، أَنَّ ابْنَ عَبَّاسٍ قَالَ : \"أَصَابَ عِيدَانِ اجْتَمَعَا فِي يَوْمٍ وَاحِدٍ ""","","","","","Book of the Two Eid Prayers"
"5566","عَنِ الثَّوْرِيِّ ، عَنِ الْحَكَمِ ، عَنْ إِبْرَاهِيمَ ، قَالَ \"يُجْزِئُ وَاحِدٌ مِنْهُمَا عَنْ صَاحِبِهِ ""","","","","","Book of the Two Eid Prayers"
"5567","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الْعَزِيزِ ، عَنْ ذَكْوَانَ ، قَالَ :اجْتَمَعَ عِيدَانِ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِطْرٌ وَجُمُعَةٌ ، أَوْ أَضْحَى وَجُمُعَةٌ ، قَالَ : فَخَرَجَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : \" إِنَّكُمْ قَدْ أَصَبْتُمْ ذِكْرًا وَخَيْرًا ، وَإِنَّا مُجَمِّعُونَ ، مَنْ أَرَادَ أَنْ يُجَمِّعُ فَلْيُجَمِّعْ ، وَمَنْ أَرَادَ أَنْ يَجْلِسَ فَلْيَجْلِسْ ""","","","","","Book of the Two Eid Prayers"
"5568","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي بَعْضُ أَهْلِ الْمَدِينَةِ ، عَنْ غَيْرِ وَاحِدٍ مِنْهُمْ ، \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَاجْتَمَعَ فِي زَمَانِهِ يَوْمُ جُمُعَةٍ وَيَوْمُ فِطْرٍ ، أَوْ يَوْمُ جُمُعَةٍ وَأَضْحَى ، فَصَلَّى بِالنَّاسِ الْعِيدَ الأَوَّلَ ، ثُمَّ خَطَبَ ، فَأَذِنَ لِلأَنْصَارِ فِي الرِّجُوعِ إِلَى الْعَوَالِي ، وَتَرْكِ الْجُمُعَةِ ، فَلَمْ يَزَلِ الأَمْرُ عَلَى ذَلِكَ بَعْدُ ""","","","","","Book of the Two Eid Prayers"
"5569","قَالَ ابْنُ جُرَيْجٍ : وَحُدِّثْتُ عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، وَعَنْ أَبِي صَالِحٍ الزَّيَّاتِ : أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَاجْتَمَعَ فِي زَمَانِهِ يَوْمُ الْجُمُعَةِ وَيَوْمُ فِطْرٍ ، فَقَالَ : \" إِنَّ هَذَا الْيَوْمَ يَوْمٌ قَدِ اجْتَمَعَ فِيهِ عِيدَانِ ، فَمَنْ أَحَبَّ فَلْيَنْقَلِبْ ، وَمَنْ أَحَبَّ أَنْ يَنْتَظِرَ فَلْيَنْتَظِرْ ""","","","","","Book of the Two Eid Prayers"
"5570","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي جَعْفَرُ بْنُ مُحَمَّدٍ ، أَنَّهُمَا اجْتَمَعَا وَعَلِيٌّ بِالْكُوفَةِ ، فَصَلَّى ثُمَّ صَلَّى الْجُمُعَةَ ،وَقَالَ حِينَ صَلَّى الْفِطْرَ : \" مَنْ كَانَ هَا هُنَا ، فَقَدْ أَذِنَّا لَهُ ، كَأَنَّهُ لِمَنْ حَوْلَهُ يُرِيدُ الْجُمُعَةَ ""","","","","","Book of the Two Eid Prayers"
"5571","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ اللَّهِ ، عَنْ أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ ، عَنْ عَلِيٍّ ، قَالَ :اجْتَمَعَ عِيدَانِ فِي يَوْمٍ ، فَقَالَ : \" مَنْ أَرَادَ أَنْ يُجَمِّعَ فَلْيُجَمِّعْ ، وَمَنْ أَرَادَ أَنْ يَجْلِسَ فَلْيَجْلِسْ \"، قَالَ سُفْيَانُ : يَعْنِي يَجْلِسُ فِي بَيْتِهِ","","","","","Book of the Two Eid Prayers"
"5572","عَنْ مَعْمَرٍ ، وَابْنِ جُرَيْجٍ ، عَنِ الزُّهْرِيِّ ، عَنْ أَبِي عُبَيْدٍ ، مَوْلَى عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ، قَالَ : شَهِدْتُ عُثْمَانَوَاجْتَمَعَ فِطْرٌ وَجُمُعَةٌ ، فَخَطَبَ عُثْمَانُ النَّاسَ بَعْدَ الصَّلاةِ ، ثُمَّ قَالَ : \" إِنَّ هَذَيْنِ الْعِيدَيْنِ قَدِ اجْتَمَعَا فِي يَوْمٍ وَاحِدٍ ، فَمَنْ كَانَ مِنْ أَهْلِ الْعَوَالِي فَأَحَبَّ أَنْ يَمْكُثَ حَتَّى يَشْهَدَ الْجُمُعَةَ فَلْيَفْعَلْ ، وَمَنْ أَحَبَّ أَنْ يَنْصَرِفَ قَدْ أَذِنَّا لَهُ ""","","","","","Book of the Two Eid Prayers"
"5573","عَنْ مَعْمَرٍ ، عَنْ صَاحِبٍ لَهُ ، \" أَنَّ عَلِيًّا كَانَ إِذَا اجْتَمَعَا فِي يَوْمٍ وَاحِدٍ ،صَلَّى فِي أَوَّلِ النَّهَارِ الْعِيدَ ، وَصَلَّى فِي آخِرِ النَّهَارِ الْجُمُعَةَ ""","","","","","Book of the Two Eid Prayers"
"5574","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَطَاءٌ ، قَالَ : إِنَّهُ سَمِعَ ابْنَ عَبَّاسٍ ، يَقُولُ :\" إِنِ اسْتَطَعْتُمْ أَنْ لا يَغْدُوَ أَحَدُكُمْ يَوْمَ الْفِطْرِ حَتَّى يَطْعَمَ ، فَلْيَفْعَلْ \"، قَالَ : فَلَمْ أَدَعْ أَنْ آكُلَ قَبْلَ أَنْ أَغْدُوَ مُنْذُ سَمِعْتُ ذَلِكَ مِنَ ابْنِ عَبَّاسٍ ، فَآكُلُ مِنْ طَرَفِ الصَّرِيفَةِ ، قُلْنَا لَهُ : مَا الصَّرِيفَةُ ؟ قَالَ : خُبْزُ الرِّقَاقِ الأَكْلَةُ ، أَوْ أَشْرَبُ مِنَ اللَّبَنِ ، أَوِ النَّبِيذِ أَوِ الْمَاءِ ، قُلْتُ : فَعَلامَ تُؤَوِّلُ هَذَا ؟","","","","","Book of the Two Eid Prayers"
"5575","قَالَ : سَمِعْتُهُ ، قَالَ : أَظُنُّ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ :كَانُوا لا يَخْرُجُونَ حَتَّى يَمْتَدَّ الضُّحَى ، فَيَقُولُونَ نَطْعَمُ لأَنْ لا نَعْجَلَ عَنِ الصَّلاةِ، قَالَ : وَرُبَّمَا غَدَوْتُ ، وَلَمْ أَذُقْ إِلا الْمَاءَ ، ابْنُ عَبَّاسٍ الْقَائِلُ","","","","","Book of the Two Eid Prayers"
"5576","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ ، قَالَ \" كَانَيُؤْمَرُ الإِنْسَانُ أَنْ يَأْكُلَ يَوْمَ الْفِطْرِ ، قَبْلَ أَنْ يَخْرُجَ الإِمَامُ إِلَى الْمُصَلَّى \"، قَالَ مَعْمَرٌ : فَكَانَ الزُّهْرِيُّ يَأْكُلُ يَوْمَ الْفِطْرِ قَبْلَ أَنْ يَغْدُوَ ، وَلا يَأْكُلُ يَوْمَ النَّحْرِ ، حَتَّى يَنْحَرُوا","","","","","Book of the Two Eid Prayers"
"5577","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ \" كَانَيَأْكُلُ يَوْمَ الْفِطْرِ قَبْلَ أَنْ يَغْدُوَهُ ""","","","","","Book of the Two Eid Prayers"
"5578","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنِ الْحَارِثِ ، أَوْ عَمَّنْ ، سَمِعَ عَلِيًّا ، أَنَا أَشُكُّ ، عَنْ عَلِيٍّ \" أَنَّهُ كَانَلا يَخْرُجُ يَوْمَ الْفِطْرِ حَتَّى يَطْعَمَ ، كَانَ يَأْمُرُ بِذَلِكَ ""","","","","","Book of the Two Eid Prayers"
"5579","عَنْ أَبِي حَنِيفَةَ عَنْ إِبْرَاهِيمَ ، قَالَ \" كَانُوايَسْتَحِبُّونَ أَنْ يَأْكُلُوا يَوْمَ الْفِطْرِ قَبْلَ أَنْ يَخْرُجُوا إِلَى الْمُصَلَّى ""","","","","","Book of the Two Eid Prayers"
"5580","عَنْ عِيسَى بْنِ أَبِي عَزَّةَ ، قَالَ \" رَأَيْتُ عَامِرًا الشَّعْبِيَّ يَوْمَ الْفِطْرِ وَنَحْنُ مَعَهُ ، وَاجْتَمَعَ إِلَيْهِ جِيرَانُهُ ، فَخَرَجَ وَفِي يَدِهِ رَغِيفٌ ،فَأَعْطَى كُلَّ إِنْسَانٍ كِسْرَةً فَأَكَلَهَا ، ثُمَّ انْطَلَقَ إِلَى الْمَسْجِدِ، أَوْ قَالَ : إِلَى الْمُصَلَّى ""","","","","","Book of the Two Eid Prayers"
"5581","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، قَالَ \" كَانَ ابْنُ عُمَرَيَغْدُو يَوْمَ الْفِطْرِ مِنَ الْمَسْجِدِ \" ، قَالَ : \" وَلا أَعْلَمُهُ أَكَلَ شَيْئًا ""","","","","","Book of the Two Eid Prayers"
"5582","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : \" كَانَالنَّاسُ يَأْكُلُونَ يَوْمَ الْفِطْرِ قَبْلَ أَنْ يَخْرُجُوا ""","","","","","Book of the Two Eid Prayers"
"5583","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَلْقَمَةَ ، وَالأَسْوَدِ ، أَنَّ ابْنَ مَسْعُودٍ ، قَالَ \"لا تَأْكُلُوا قَبْلَ أَنْ تَخْرُجُوا يَوْمَ الْفِطْرِ إِنْ شِئْتُمْ ""","","","","","Book of the Two Eid Prayers"
"5584","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، \" أَنَّ ابْنَ عُمَرَ كَانَلا يَأْكُلُ يَوْمَ الْفِطْرِ ""","","","","","Book of the Two Eid Prayers"
"5585","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ سُلَيْمٍ ، عَنِ ابْنِ الْمُسَيِّبِ ، أَنَّهُ قَالَ : \"السِّوَاكُ يَوْمَ الْجُمُعَةِ سُنَّةٌ ""","","","","","Book of the Two Eid Prayers"
"5586","عَنْ أَبِي بَكْرِ بْنِ عَبْدِ اللَّهِ بْنِ أَبِي سَبْرَةَ ، عَنْ أَبِيهِ ، قَالَ : ذَاكَرْتُ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ يَوْمَ نُزُولِ عُثْمَانَ بْنِ عَفَّانَ ، عَنِ الْمِنْبَرِ يَوْمَ الْجُمُعَةِ ، وَقَوْلُهُ : يَأَيُّهَا النَّاسُ إِنِّي نَسِيتُ السِّوَاكَ ، فَنَزَلَ فَاسْتَنَّ ، ثُمَّ رَجَعَ إِلَى الْمِنْبَرِ ، فَقَالَ عُمَرُ \" أَمَا إِنَّمِنَ السُّنَّةِ فِي السِّوَاكِ يَوْمَ الْعِيدِ ، كَهِيَئتِهِ فِي يَوْمِ الْجُمُعَةِ ""","","","","","Book of the Two Eid Prayers"
"5587","قَالَ أَبُو بَكْرٍ ، وَأَخْبَرَنِي عَمْرُو بْنُ سُلَيْمٍ ، عَنِ ابْنِ الْمُسَيِّبِ ، أَنَّهُ قَالَ : \"السِّوَاكُ فِي يَوْمِ الْعِيدِ سُنَّةٌ ""","","","","","Book of the Two Eid Prayers"
"5588","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : الاسْتِنَانُ فِي يَوْمِ الْفِطْرِ ؟ قَالَ : لَمْ يَبْلُغْنِي أَنَّهُ كَانَ يُؤْمَرُ بِهِ يَوْمَ الْفِطْرِ فَيُخَصُّ ، وَلَكِنْهُ بَلَغَنَا عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ : \"لَوْلا أَنْ أَشُقَّ عَلَى أُمَّتِي ، لأَمَرْتُهُمْ بِالسِّوَاكِ لِكُلِّ صَلاةٍ ""","","","","","Book of the Two Eid Prayers"
"5589","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَلْقَمَةَ ، قَالَ \" كَانَيَغْتَسِلُ يَوْمَ الْفِطْرِ قَبْلَ أَنْ يَغْدُوَ ""","","","","","Book of the Two Eid Prayers"
"5590","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ أَنَّهُ كَانَ يَأْمُرُ بِالاغْتِسَالِ يَوْمَ الْفِطْرِ ، وَيَقُولُ : \"لَيْسَ بِوَاجِبٍ وَلَكِنَّهُ حَسَنٌ مُسْتَحَبٌّ ""","","","","","Book of the Two Eid Prayers"
"5591","عَنِ ابْنِ جُرَيْجٍ ، قَالَ \"الاغْتِسَالُ يَوْمَ الْفِطْرِ حَسَنٌ لأَنَّهُ يَوْمُ عِيدٍ ، وَلَسْتُ أَنْ أَدَعَ أَنْ أَغْتَسِلَ فِي يَوْمِ الْفِطْرِ ، قُلْتُ : أَفَيُتَحَرَّى الْغُسْلُ فِيهِ ، كَمَا يُتَحَرَّى الْغُسْلُ فِي الْجَنَابَةِ ؟ قَالَ : لا ""","","","","","Book of the Two Eid Prayers"
"5592","عَنْ أَبِي بَكْرِ بْنِ أَبِي سَبْرَةَ ، عَنْ عَمْرِو بْنِ سُلَيْمٍ ، عَنِ ابْنِ الْمُسَيِّبِ ، وَنَضْرَةَ ، قَالُوا : \"الْغُسْلُ فِي يَوْمِ الْعِيدَيْنِ سُنَّةٌ \"، قَالَ : وَقَالَ ابْنُ الْمُسَيِّبِ : \" كَغُسْلِ الْجَنَابَةِ ""","","","","","Book of the Two Eid Prayers"
"5593","عَنْ رَجُلٍ ، مِنْ أَسْلَمَ ، عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ ، عَنْ أَبِيهِ ، \" أَنَّ عَلِيًّا كَانَيَغْتَسِلُ يَوْمَ الْفِطْرِ وَيَوْمَ الأَضْحَى قَبْلَ أَنْ يَغْدُوَ \"، عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي مُوسَى بْنُ عُقْبَةَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ مِثْلَهُ ، وَزَادَ وَيَتَطَيَّبُ","","","","","Book of the Two Eid Prayers"
"5594","عَنْ مَالِكٍ ، عَنْ نَافِعٍ ، \" أَنَّ ابْنَ عُمَرَ ، كَانَيَغْتَسِلُ يَوْمَ الْفِطْرِ قَبْلَ أَنْ يَغْدُوَ \"، قَالَ عَبْدُ الرَّزَّاقِ : وَأَنَا أَفْعُلُهُ","","","","","Book of the Two Eid Prayers"
"5595","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، قَالَ : \" مَا رَأَيْتُ ابْنَ عُمَرَاغْتَسَلَ لِلْعِيدِ قَطُّ ، كَانَ يَبِيتُ فِي الْمَسْجِدِ لَيْلَةَ الْفِطْرِ ، ثُمَّ يَغْدُو مِنْهُ إِذَا صَلَّى الصُّبْحَ ، وَلا يَأْتِي مَنْزِلَهُ ""","","","","","Book of the Two Eid Prayers"
"5596","عَنِ الثَّوْرِيِّ ، عَنْ عُبَيْدٍ الْمُكْتِبِ ، عَنْ إِبْرَاهِيمَ ، قَالَ \" كَانُوايُصَلُّونَ الصُّبْحَ عَلَيْهِمْ ثِيَابُهُمْ ، ثُمَّ يَغْدُونَ إِلَى الْمُصَلَّى يَوْمَ الْفِطْرِ \"، قَالَ سُفْيَانُ : مَنْ فَعَلَ ذَلِكَ ، فَأَحَبُّ إِلَيَّ أَنْ يَغْتَسِلَ قَبْلَ طُلُوعِ الْفَجْرِ","","","","","Book of the Two Eid Prayers"
"5597","عَنْ رَجُلٍ ، مِنْ أَهْلِ الْبَصْرَةِ ، عَنْ أَبِي سِنَانٍ ، عَنِ الشَّيْبَانِيِّ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ ، يَقُولُ : \"إِنِّي لأَغْتَسِلُ يَوْمَ الْفِطْرِ ، وَيَوْمَ النَّحْرِ ، وَيَوْمَ عَرَفَةَ ، وَيَوْمَ الْجُمُعَةِ ، وَمِنَ الْجَنَابَةِ وَالاحْتِلامِ ، وَمِنَ الْحَمَّامِ ، وَإِذَا احْتَجَمْتُ ""","","","","","Book of the Two Eid Prayers"
"5598","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ \"إِنِّي لأُحِبُّ أَنْ أُعْطِيَ زَكَاةَ الْفِطْرِ بِمِكْيَالِ الْيَوْمِ ، مِكْيَالٍ نَأْخُذُ بِهِ ، وَنَقْتَاتُ بِهِ ""","","","","","Book of the Two Eid Prayers"
"5599","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ \" أَنَّهُ كَانَيُعْطِي زَكَاةَ الْفِطْرِ بِالْمُدِّ الَّذِي يَقُوتُ بِهِ أَهْلُهُ ""","","","","","Book of the Two Eid Prayers"
"5600","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ \" أَرَأَيْتَ لَوْ كُنْتُ بِمِصْرٍ غَيْرِ مِصْرِي فَكَانَ مِكْيَالُهُمْ أَكْبَرَ مِنْ مِكْيَالِي ، فَأُؤَدِّي الْفِطْرَ بِهِ ، أَوْ أُؤَدِّي ، بِمِكْيَالِ مِصْرِي ؟ قَالَ :مَا عَلَيْكَ إِلا ذَلِكَ ، وَزِيَادَةُ الْخَيْرِ خَيْرٌ ، قَالَ : كَمْ بَلَغَكَ بَيْنَ الْمِكْيَالِ الْيَوْمَ ، وَالْمِكْيَالِ الَّذِي كَانَ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَأَبِي بَكْرٍ ، وَعُمَرَ ، وَعُثْمَانَ ؟ قَالَ : لا أَدْرِي غَيْرَ أَنَّ ذَلِكَ الْمِكْيَالَ أَصْغَرُ ""","","","","","Book of the Two Eid Prayers"
"5601","عَنِ ابْنِ جُرَيْجٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ عُرْوَةَ ، أَنَّمُدَّ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ثُلُثُ الْمُدِّ الَّذِي جَعَلَهُ مَرْوَانُ بْنُ الْحَكَمِ. قَالَ ابْنُ جُرَيْجٍ : فَأَخْبَرَنِي أَبُو بَكْرٍ ، قَالَ : عِنْدَنَا أَرْبَعَةُ أَرْطَالٍ وَنِصْفٌ","","","","","Book of the Two Eid Prayers"
"5602","قَالَ ابْنُ جُرَيْجٍ : وَأَخْبَرَنِي هِشَامُ بْنُ عُرْوَةَ ، \" أَنَّهُ كَانَ يُلْقِي زَكَاتَهُ بِالْمُدِّ الَّذِي كَانَ يَأْكُلُ بِهِ ،وَمُدُّ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يُؤْخَذُ بِهِ الصَّدَقَاتُ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رِطْلٌ وَنِصْفٌ ""","","","","","Book of the Two Eid Prayers"
"5603","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : \"زَكَاةُ الْفِطْرِ عَلَى كُلِّ حُرٍّ وَعَبْدٍ ، ذَكَرٍ وَأُنْثَى ، صَغِيرٍ وَكَبِيرٍ ، غَنِيٍّ وَفَقِيرٍ ، صَاعٌ مِنْ تَمْرٍ ، أَوْ نِصْفُ صَاعٍ مِنْ قَمْحٍ \"، قَالَ مَعْمَرٌ : وَبَلَغَنِي ، أَنَّ الزُّهْرِيَّ ، كَانَ يَرْفَعُهُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ","","","","","Book of the Two Eid Prayers"
"5604","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : \" فَرَضَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَزَكَاةَ الْفِطْرِ عَلَى الذَّكَرِ وَالأُنْثَى ، وَالْحُرِّ وَالْعَبْدِ ، صَاعٌ مِنْ تَمْرٍ ، أَوْ صَاعٌ مِنْ شَعِيرٍ \"، قَالَ ابْنُ عُمَرَ : فَعَدَلَهُ النَّاسُ بَعْدُ بِمُدَّيْنِ مِنْ قَمْحٍ ، قَالَ ابْنُ عُمَرَ : فَكَانَ يُعْجِبُهُ أَنْ يُعْطِي التَّمْرَ","","","","","Book of the Two Eid Prayers"
"5605","عَنِ الثَّوْرِيِّ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ . وعَنِ ابْنِ أَبِي لَيْلَى ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : \" أَمَرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَبِزَكَاةِ الْفِطْرِ عَلَى كُلِّ حُرٍّ ، عَبْدٍ مُسْلِمٍ ، صَغِيرٍ وَكَبِيرٍ ، صَاعٌ مِنْ تَمْرٍ أَوْ صَاعٌ مِنْ شَعِيرٍ \"، قَالَ ابْنُ أَبِي لَيْلَى فِي حَدِيثِهِ عَنْ نَافِعٍ : قَالَ ابْنُ عُمَرَ : فَعَدَلَهُ النَّاسُ بَعْدُ بِمُدَّيْنِ مِنْ بُرٍّ ، عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، مِثْلَ حَدِيثِ عُبَيْدِ اللَّهِ","","","","","Book of the Two Eid Prayers"
"5606","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ \"عَلَى كُلِّ رَجُلٍ عَبْدٍ ، أَوْ حُرٍّ ، أَوْ حُرَّةٍ ، أَوْ مَمْلُوكَةٍ ، وَالنَّاسُ فِي ذَلِكَ سَوَاءٌ الصَّغِيرُ وَالْكَبِيرُ ، إِلا أَعْبُدٌ يُدَارُونَ مُدَّانِ مِنْ قَمْحٍ ، أَوْ صَاعٌ مِنْ شَعِيرٍ أَوْ تَمْرٍ \"، قَالَ عَطَاءٌ : \" فَاطْرَحْ عَنْ عَبْدِكَ ، وَإِنْ طَرَحَ الْعَبْدُ عَنْ نَفْسِهِ كَفَى سَيِّدَهُ ""","","","","","Book of the Two Eid Prayers"
"5607","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، أَنَّهُ سَمِعَ ابْنَ الزُّبَيْرِ ، يَقُولُ عَلَى الْمِنْبَرِ : \"زَكَاةُ الْفِطْرِ مُدَّانِ مِنْ قَمْحٍ ، أَوْ صَاعٌ مِنْ تَمْرٍ أَوْ شَعِيرٍ ، الْحُرُّ وَالْعَبْدُ سَوَاءٌ ""","","","","","Book of the Two Eid Prayers"
"5608","عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنْ مُحَمَّدِ بْنِ سِيرِينَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : \"زَكَاةُ الْفِطْرِ عَلَى كُلِّ عَبْدٍ أَوْ حُرٍّ ، صَغِيرٍ وَكَبِيرٍ ، مَنْ أَدَّى زَبِيبًا قُبِلَ مِنْهُ ، وَمَنْ أَدَّى تَمْرًا قُبِلَ مِنْهُ ، وَمَنْ أَدَّى شَعِيرًا قَبِلَ مِنْهُ ، وَمَنْ أَدَّى سُلْتًا قُبِلَ مِنْهُ صَاعًا صَاعًا ""","","","","","Book of the Two Eid Prayers"
"5609","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قَالَ لِي عَمْرُو بْنُ دِينَارٍ : وَبَلَغَنِي ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّهُ قَالَ : \"زَكَاةُ الْفِطْرِ مُدَّانِ مِنْ قَمْحٍ ، أَوْ صَاعًا مِنْ تَمْرٍ ، أَوْ شَعِيرٍ ""","","","","","Book of the Two Eid Prayers"
"5610","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ أَبُو أُمَيَّةَ ، عَنْ إِبْرَاهِيمَ النَّخْعِيِّ ، عَنْ عَلْقَمَةَ ، وَالأَسْوَدِ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ \"مُدَّانِ مِنْ قَمْحٍ ، أَوْ صَاعٌ مِنْ تَمْرٍ أَوْ شَعِيرٍ ""","","","","","Book of the Two Eid Prayers"
"5611","عَنْ مَعْمَرٍ ، وَابْنِ جُرَيْجٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، أَنَّهُ كَانَ يَقُولُ : \"عَلَى الْحُرِّ وَالْعَبْدِ مُدَّانِ مِنْ قَمْحٍ ، أَوْ صَاعٌ مِنْ تَمْرٍ ، وَالذُّرَةُ ضِعْفُ الْقَمْحِ ""","","","","","Book of the Two Eid Prayers"
"5612","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاهِدٍ ، قَالَ \"كُلُّ شَيءٍ سِوَى الْحِنْطَةِ صَاعٌ ، وَالْحِنْطَةُ نِصْفُ صَاعٍ ""","","","","","Book of the Two Eid Prayers"
"5613","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي أَبُو الزُّبَيْرِ ، أَنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ : \"صَدَقَةُ الْفِطْرِ عَلَى كُلِّ مُسْلِمٍ صَغِيرٍ وَكَبِيرٍ ، عَبْدٌ أَوْ حُرٌّ مُدَّانِ مِنْ قَمْحٍ ، أَوْ صَاعٌ مِنْ تَمْرٍ ، أَوْ شَعِيرٍ ""","","","","","Book of the Two Eid Prayers"
"5614","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الأَعْلَى ، عَنْ أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ ، عَنْ عَلِيٍّ ، قَالَ \"عَلَى مَنْ جَرَتْ عَلَيْهِ نَفَقَتُكَ نِصْفُ صَاعٍ مِنْ بُرٍّ ، أَوْ صَاعٌ مِنْ تَمْرٍ ""","","","","","Book of the Two Eid Prayers"
"5615","عَنْ مَعْمَرٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِي قِلابَةَ ، قَالَ : أَنْبَأَنِي رَجُلٌ ، \" أَنَّ أَبَا بَكْرٍ الصِّدِّيقَ ،أَلْحَقَ إِلَيْهِ نِصْفَ صَاعٍ مِنْ بُرٍّ بَيْنَ رَجُلَيْنِ ""","","","","","Book of the Two Eid Prayers"
"5616","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي أَيُّوبُ بْنُ مُوسَى ، أَنَّ نَافِعًا أَخْبَرَهُ ، عَنِ ابْنِ عُمَرَ ، أَنَّهُ قَالَ : \" أَمَرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيزَكَاةِ الْفِطْرِ صَاعٌ مِنْ تَمْرٍ ، أَوْ صَاعٌ مِنْ شَعِيرٍ \"، قَالَ عَبْدُ اللَّهِ ، فَجَعَلَ النَّاسُ مُدَّيْنِ حِنْطَةً عِدْلَهُ","","","","","Book of the Two Eid Prayers"
"5617","عَنِ الثَّوْرِيِّ ، عَنْ عَاصِمٍ ، عَنْ أَبِي قِلابَةَ ، قَالَ : أَنْبَأَنِي مَنْأَدَّى أَبِي بَكْرٍ نِصْفَ صَاعٍ مِنْ بُرٍّ بَيْنَ رَجُلَيْنِ ""","","","","","Book of the Two Eid Prayers"
"5618","عَنْ مَعْمَرٍ ، قَالَ : بَلَغَنِي ، \" أَنَّ أَبَا بَكْرٍأَخْرَجَ زَكَاةَ الْفِطْرِ مُدَّيْنِ ""","","","","","Book of the Two Eid Prayers"
"5619","عَنْ مَعْمَرٍ ، قَالَ \" كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِعَلَى كُلِّ اثْنَيْنِ دِرْهَمٌ ، يَعْنِي زَكَاةَ الْفِطْرِ \" ، قَالَ مَعْمَرٌ : \" هَذَا عَلَى حِسَابِ مَا يُعْطَى مِنَ الْكَيْلِ ""","","","","","Book of the Two Eid Prayers"
"5620","عَنْ دَاوُدَ بْنِ قَيْسٍ ، قَالَ : حَدَّثِنِي عِيَاضُ بْنُ عَبْدِ اللَّهِ بْنِ سَعْدِ بْنِ أَبِي سَرْحٍ ، أَنَّهُ سَمِعَ أَبَا سَعِيدٍ الْخُدْرِيَّ ، يَقُولُ : \" كُنَّا نُخْرِجُ إِذْ كَانَ فِينَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَزَكَاةَ الْفِطْرِ ، عَلَى كُلِّ صَغِيرٍ وَكَبِيرٍ ، حُرٍّ وَمَمْلُوكٍ صَاعًا مِنْ أَقِطٍ ، صَاعًا مِنْ تَمْرٍ ، صَاعًا مِنْ شَعِيرٍ ، صَاعًا مِنْ زَبِيبٍ، فَلَمْ نَزَلْ نُخْرِجُهُ كَذَلِكَ حَتَّى قَدِمَ مُعَاوِيَةُ حَاجًّا ، أَوْ مُعْتَمِرًا ، فَكَلَّمَ النَّاسَ عَلَى الْمِنْبَرِ ، فَكَانَ فِيمَا كَلَّمَهُمْ بِهِ أَنْ قَالَ : أَرَى مُدَّيْنِ مِنْ سَمْرَاءِ الشَّامِ ، تَعْدِلُ بِصَاعٍ مِنْ تَمْرٍ فَأَخَذَ النَّاسُ مُدَّيْنِ \" ، قَالَ أَبُو سَعِيدٍ : فَأَمَّا أَنَا ، فَلا أَزَالُ أُخْرِجُهُ كَمَا كُنْتُ أُخْرِجُهُ أَبَدًا","","","","","Book of the Two Eid Prayers"
"5621","عَنِ الثَّوْرِيِّ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، قَالَ : حَدَّثَنِي عِيَاضُ بْنُ عَبْدِ اللَّهِ بْنِ سَعْدِ بْنِ أَبِي سَرْحٍ ، أَنَّهُ سَمِعَ أَبَا سَعِيدٍ الْخُدْرِيَّ ، يَقُولُ : \" كَانَتْزَكَاةُ الْفِطْرِ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَاعًا مِنْ تَمْرٍ ، صَاعًا مِنْ شَعِيرٍ ، صَاعًا مِنْ زَبِيبٍ ، صَاعًا مِنْ أَقِطٍ، فَلَمَّا جَاءَ مُعَاوِيَةُ ، جَاءَتِ السَّمْرَاءُ ، فَرَأَى أَنَّ مُدَّيْنِ تَعْدِلُ مُدًّا ""","","","","","Book of the Two Eid Prayers"
"5622","عَنْ مَعْمَرٍ ، عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ ، عَنْ عِيَاضِ بْنِ عَبْدِ اللَّهِ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيُّ ، قَالَ : \" كُنَّا نُخْرِجُزَكَاةَ الْفِطْرِ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَاعًا مِنْ تَمْرٍ ، صَاعًا مِنْ شَعِيرٍ ، صَاعًا مِنْ زَبِيبٍ، حَتَّى كَانَ مُعَاوِيَةُ ، وَكَثُرَ بُدُّ الْحِنْطَةِ فَأُخْرِجَتْ ""","","","","","Book of the Two Eid Prayers"
"5623","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ \" كَانَيُؤْمَرُ أَنْ يُلْقِي الرَّجُلُ ، قَبْلَ أَنْ يَخْرُجَ صَاعًا مِنْ تَمْرٍ أَوْ نِصْفَ صَاعٍ مِنْ قَمْحٍ ""","","","","","Book of the Two Eid Prayers"
"5624","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ سُلَيْمَانَ التَّيْمِيِّ ، عَنْ أَبِي مِجْلَزٍ ، \" أَنَّ ابْنَ عُمَرَ كَانَيَسْتَحِبُّ أَنْ يُعْطِي التَّمْرَ ""","","","","","Book of the Two Eid Prayers"
"5625","عَنْ بَكَّارِ بْنِ عَبْدِ اللَّهِ ، عَنْ خَلادِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : سَأَلْتُ عُرْوَةَ بْنَ الزُّبَيْرِ ، وَسَعِيدَ بْنَ جُبَيْرٍ ، عَنْ إِطْعَامِ الْفِطْرِ ، فَقَالا : \"صَاعٌ مِنْ تَمْرٍ ، أَوْ صَاعٌ مِنْ شَعِيرٍ ، أَوْ مُدٌّ مِنْ قَمْحٍ ""","","","","","Book of the Two Eid Prayers"
"5626","عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ شِهَابٍ ، عَنْ عَبْدِ اللَّهِ بْنِ ثَعْلَبَةَ ، قَالَ : خَطَبَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ النَّاسَقَبْلَ الْفِطْرِ بِيَوْمٍ ، أَوْ يَوْمَيْنِ ، فَقَالَ : \" أَدُّوا صَاعًا مِنْ بُرٍّ ، أَوْ قَمْحٍ بَيْنَ اثْنَيْنِ ، أَوْ صَاعًا مِنْ تَمْرٍ ، أَوْ صَاعًا مِنْ شَعِيرٍ عَلَى كُلِّ أَحَدٍ صَغِيرٍ أَوْ كَبِيرٍ ""","","","","","Book of the Two Eid Prayers"
"5627","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ ، قَالَ \"زَكَاةُ الْفِطْرِ عَلَى مَنْ صَامَ مُدَّانِ مِنْ حِنْطَةٍ ، أَوْ صَاعٌ مِنْ تَمْرٍ ""","","","","","Book of the Two Eid Prayers"
"5628","قَالَ مَعْمَرٌ وَأَخْبَرَنِي مَنْ سَمِعَ الْحَسَنَ ، يَقُولُ : \"لا زَكَاةَ إِلا عَلَى مَنْ صَامَ أَوْ صَلَّى ""","","","","","Book of the Two Eid Prayers"
"5629","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي الْحَارِثُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللَّهِ بْنِ أَبِي ذُبَابٍ ، عَنْ عِيَاضِ بْنِ عَبْدِ اللَّهِ بْنِ سَعْدِ بْنِ أَبِي سَرْحٍ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيُّ ، قَالَ : \" كُنَّا نُخْرِجُزَكَاةَ الْفِطْرِ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، مِنْ ثَلاثَةِ أَصْنَافٍ : مِنَ الشَّعِيرِ ، وَالأَقِطِ ، وَالتَّمْرِ \"، قَالَ عِيَاضٌ : قُلْتُ لَهُ : مَا شَأْنُ الْحِنْطَةِ ؟ قَالَ : \" كَثُرَتْ بَعْدُ فَأُخْرِجَتْ عَلَى عَهْدِ مُعَاوِيَةَ ""","","","","","Book of the Two Eid Prayers"
"5630","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ ، قَالَ : \" كَانَيُعْجِبُهُمْ أَنْ يُعْطُوا زَكَاةَ الْفِطْرِ عَنِ الصَّغِيرِ وَالْكَبِيرِ ، حَتَّى عَلَى الْحَبَلِ فِي بَطْنِ أُمِّهِ ""","","","","","Book of the Two Eid Prayers"
"5631","عَنِ ابْنِ جُرَيْجٍ ، قَالَ \" قُلْتُ لِعَطَاءٍ :جَنِينٌ لَيْسَ يَتَحَرَّكُ فِي بَطْنِ أُمِّهِ أُزَكِّي عَلَيْهِ ؟ قَالَ : لا ، لأَنَّكَ لا تَدْرِي أَيَتِمُّ أَمْ لا ؟ أَيَخْرُجُ مَيِّتًا أَمْ حَيًّا ؟ ""","","","","","Book of the Two Eid Prayers"
"5632","عَنْ مَالِكِ بْنِ أَنَسٍ ، عَنْ رَجُلٍ ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ ، قَالَ \" سَأَلْتُهُ عَنِالْحَبَلِ ، هَلْ يُزَكَّى عَنْهُ ؟ قَالَ : نَعَمْ ""","","","","","Book of the Two Eid Prayers"
"5633","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ \" كَانَيُسْتَحَبُّ لأَهْلِ الْبَادِيَةِ أَنْ يَخْرُجُوا يَوْمَ الْعِيدِ ، فَيَؤُمُّهُمْ أَحَدُهُمْ ، وَيُخْرِجُونَ زَكَاةَ الْفِطْرِ ""","","","","","Book of the Two Eid Prayers"
"5634","عَنْ زَمْعَةَ ، عَنْ صَالِحٍ ، قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ عَطَاءِ بْنِ يُحَنِّسَ ، عَنْ خَالِهِ أَبِي الْعَبَّاسِ الْمُدْلِجِيِّ ، قَالَ : جَلَسَ ابْنُ الزُّبَيْرِ عَلَى الْمِنْبَرِ قَبْلَ الْفِطْرِ بِيَوْمٍ ، أَوْ يَوْمَيْنِ ، فَقَالَ : \"زَكَاةُ الْفِطْرِ عَلَى كُلِّ مُسْلِمٍ مُدَّانِ مِنْ قَمْحٍ ، أَوْ صَاعٌ مِنْ تَمْرٍ ، فَلْيُؤَدِّ الرَّجُلُ عَنْ نَفْسِهِ ، وَعَنْ وَلَدِهِ ، وَعَنْ رَقِيقِهِ \"، قَالَ أَبُو الْعَبَّاسِ : فَقُلْتُ : وَعَلَى أَهْلِ الْبَادِيَةِ ؟ قَالَ : \" نَعَمْ ، أَلا كَانُوا مُسْلِمِينَ وَلا إِخَالُهُمْ ، يَعْنِي إِلا مُسْلِمِينَ \" ، عَنِ ابْنِ جُرَيْجٍ ، عَنْ رَجُلٍ ، عَنْ أَبِي الْعَبَّاسِ ، عَنْ أَبِي الزُّبَيْرِ مِثْلَهُ","","","","","Book of the Two Eid Prayers"
"5635","عَنِ ابْنِ جُرَيْجٍ ، قَالَ \" قُلْتُ لِعَطَاءٍ :أَوْدِيَتُنَا مَرٌّ ، وَنَخْلَةٌ ، وَعَرَفَةٌ ، عَلَيْهِمْ زَكَاةُ الْفِطْرِ ؟ قَالَ : نَعَمْ ، قُلْتُ : أَعِنْدَنَا أَمْ عِنْدَهُمْ ؟ قَالَ : بَلْ عِنْدَنَا ""","","","","","Book of the Two Eid Prayers"
"5636","عَنْ مَعْمَرٍ ، عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ ، أَنَّ ابْنَ الْمُسَيِّبِ ، قَالَعَلَى أَهْلِ الْبَوَادِي :  قَدْ أَفْلَحَ مَنْ تَزَكَّى ، قَالَ عُمَرُ قَالَ قَتَادَةُ :  قَدْ أَفْلَحَ مَنْ تَزَكَّى ، قَالَ \" بِعَمَلٍ صَالِحٍ ""","","","","","Book of the Two Eid Prayers"
"5637","عَنِ ابْنِ جُرَيْجٍ ، قَالَ \" قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ قَوْلَهُ : قَدْ أَفْلَحَ مَنْ تَزَكَّى لِلْفِطْرِ ؟ قَالَ : هِيَ فِي الصَّدَقَةِ كُلِّهَا ""","","","","","Book of the Two Eid Prayers"
"5638","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ \"عَلَى أَهْلِ الْبَادِيَةِ مِنْ زَكَاةٍ ؟ قَالَ : لا ، لَمْ أَسْمَعْ بِهَا إِلا عَلَى أَهْلِ الْقُرَى ""","","","","","Book of the Two Eid Prayers"
"5639","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قَالَ لِي عَطَاءٌ \"أَهْلُ الْبَادِيَةِ هُمْ أَنْفُسُهُمْ رِعَاءُ مَاشِيَتِهِمْ وَعُمَّالُهَا ، يَعْنِي : أَهْلَ الْعَمُودِ ""","","","","","Book of the Two Eid Prayers"
"5640","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ \"زَكَاةُ الْفِطْرِ سُنَّةٌ هِيَ عَلَى أَهْلِ الْبَوَادِي ""","","","","","Book of the Two Eid Prayers"
"5641","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ ، قَالَ : كَانَتِ الْقَسَامَةُ فِي الْجَاهِلِيَّةِ فِي الدَّمِ ، وَفِي الرَّجُلِ يُولَدُ عَلَى فِرَاشِهِ فِيدَّعِيِّهِ رَجُلٌ آخَرُ ، فَيُقْسِمُونَ عَلَيْهِ خَمْسُونَ يَمِينًا ، كَقَسَامَةِ الدَّمِ فَيَذْهَبُونَ بِهِ ، فَلَمَّا أَنْ حَجَّ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ لَهُ الْعَبَّاسُ بْنُ عَبْدِ الْمُطَّلِبِ : إِنَّ فُلانًا ابْنِي ، وَنَحْنُ مُقْسِمُونَ عَلَيْهِ ، فَقَالَ النَّبِيُّ : \" لا ، الْوَلَدُ لِلْفِرَاشِ وَلِلْعَاهِرِ الْحَجَرُ \" ، ثُمَّ بَعَثَ صَارِخًا ، يَصْرُخُ فِي أَهْلِ مَكَّةَ : \" أَلا إِنَّزَكَاةَ الْفِطْرِ حَقٌّ وَاجِبٌ عَلَى كُلِّ مُسْلِمٍ مِنْ ذَكَرٍ وَأُنْثَى ، حُرٍّ أَوْ عَبْدٍ ، صَغِيرٍ أَوْ كَبِيرٍ ، حَاضِرٍ أَوْ بَادٍ ، مُدَّانِ مِنْ حِنْطَةٍ ، أَوْ صَاعٌ ، مِمَّا سِوَى ذَلِكَ مِنَ الطَّعَامِ ، أَلا وَإِنَّ الْوَلَدَ لِلْفِرَاشِ وَلِلْعَاهِرِ الأَثْلَبُ \" ، يَعْنِي : الْحَجَرَ ، فَأَقَرَّ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَسَامَةَ الدَّمِ ، كَمَا كَانَتْ فِي الْجَاهِلِيَّةِ","","","","","Book of the Two Eid Prayers"
"5642","عَنِ الثَّوْرِيِّ ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ ، قَالَ : حَدَّثَنِي الْقَاسِمُ بْنُ مُخَيْمِرَةَ ، عَنْ أَبِي عَمَّارٍ ، قَالَ : سَأَلْنَا سَعْدَ بْنَ قَيْسِ بْنِ عُبَادَةَ ، عَنْزَكَاةِ الْفِطْرِ ، فَقَالَ : \" أَمَرَنَا بِهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَبْلَ أَنْ تَنْزِلَ الزَّكَاةُ ، فَلَمَّا نَزَلَتِ الزَّكَاةُ ، لَمْ يَأْمُرْنَا وَلَمْ يَنْهَنَا ، وَنَحْنُ نَفْعلُهُ ""","","","","","Book of the Two Eid Prayers"
"5643","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ \"إِذَا كَانَ عِنْدَ أَحَدٍ عَبِيدٌ يُدَارُونَ ، فَلا يَطْرَحْنَ عَلَيْهِمْ \"، وَقَالَهُ الثَّوْرِيُّ","","","","","Book of the Two Eid Prayers"
"5644","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ \"إِنْ صَامُوا عِنْدَكَ رَمَضَانَ حَتَّى يُفْطِرُوا ، فَأَطْعِمْهُمْ عَنْهُمْ ""","","","","","Book of the Two Eid Prayers"
"5645","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ \"اطْرَحْ عَنْ عَبْدِكَ ، فَإِنَّ طَرْحَ الْعَبْدِ عَنْ نَفْسِهِ كَفَى سَيِّدَهُ ، وَإِنْ كَانَ مُكَاتَبًا ، فَطَرَحَ عَنْ نَفْسِهِ فَقَدْ كَفَى سَيِّدَهُ ، وَإِنْ لَمْ يَطْرَحْ عَنْ نَفْسِهِ فَلْيَطْرَحْ عَنْهُ سَيِّدُهُ ، فَإِنَّهُ عَبْدٌ حَتَّى يُعْتَقَ ، فَإِنْ كُنْتَ غَائِبًا يَوْمَ الْفِطْرِ ، فَإِذَا قَدِمْتَ فَزَكِّ عَنْ نَفْسِكَ ، فَإِنْ كَانَ لَكَ أَعْبُدٌ نَصَارَى لا يُدَارُونَ فَزَكِّ عَنْهُمْ ، وَاطْرَحْ عَنْ عَبْدِكَ الْمُسَافِرِ ""","","","","","Book of the Two Eid Prayers"
"5646","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، قَالَ \" كَانَ لابْنِ عُمَرَمُكَاتَبَانِ فَكَانَ لا يُؤَدِّي عَنْهُمَا زَكَاةَ الْفِطْرِ \"، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ مِثْلَهُ","","","","","Book of the Two Eid Prayers"
"5647","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ أَبِي سَلَمَةَ ، قَالَ \"لا يُؤَدِّي الرَّجُلُ عَنْ مُكَاتَبِهِ زَكَاةَ الْفِطْرِ إِنْ شَاءَ ""","","","","","Book of the Two Eid Prayers"
"5648","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ الْكَرِيمِ الْجَزْرِيِّ ، فِي رَقِيقٍ نَصَارَى ، قَالَ \"لا يُدَارُونَ ، قَالَ : هُمْ مَالٌ فَلْيُطْرَحْ عَنْهُمْ \"، قَالَ عَبْدُ الرَّزَّاقِ : يُدَارُونَ بِالتِّجَارَةِ","","","","","Book of the Two Eid Prayers"
"5649","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ ، قَالَهُ الْحَسَنُ ، أَيْضًا قَالَ \"لا تَطْرَحْ إِلا عَلَى مَنْ صَلَّى وَصَامَ ""","","","","","Book of the Two Eid Prayers"
"5650","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي عَبْدِ الْكَرِيمِ ، عَنْ إِبْرَاهِيمَ ، قَالَ \"يُطْعِمُ الرَّجُلُ عَنْ عَبْدِهِ ، وَإِنْ كَانَ نَصْرَانِيًّا ""","","","","","Book of the Two Eid Prayers"
"5651","عَنْ ثَوْرِ بْنِ يَزِيدَ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى ، عَنْ عَطَاءٍ ، قَالَ \"يُطْعِمُ الرَّجُلُ عَنْ عَبْدِهِ ، وَإِنْ كَانَ مَجُوسِيًّا ""","","","","","Book of the Two Eid Prayers"
"5652","عَنْ رَجُلٍ ، مِنْ أَسْلَمَ ، عَنْ دَاوُدَ بْنِ الْحُصَيْنِ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : \"يُخْرِجُ الرَّجُلُ زَكَاةَ الْفِطْرِ عَنْ مُكَاتَبِهِ ، وَعَنْ كُلِّ مَمْلُوكٍ لَهُ ، وَإِنْ كَانَ يَهُوَدِيًّا أَوْ نَصْرَانِيًّا ""","","","","","Book of the Two Eid Prayers"
"5653","عَنْ رَجُلٍ ، مِنْ أَسْلَمَ ، عَنْ عُبَيْدِ اللَّهِ بْنِ أَبِي جَعْفَرٍ ، عَنِ الأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ \" كُنَّانُخْرِجُ زَكَاةَ الْفِطْرِ عَلَى كُلِّ نَفْسٍ نَعُولُهَا ، وَإِنْ كَانَ نَصْرَانِيًّا ""","","","","","Book of the Two Eid Prayers"
"5654","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ \"إِنْ كَانَ لِعَبْدِكَ بَنُونَ صِغَارٌ أَحْرَارٌ ، فَلا يُزَكِّي عَنْهُمْ أَبُوهُمْ إِلا بِإِذْنِ سَيِّدِهِ \"، عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، مِثْلَ قَوْلِ عَطَاءٍ ، قَالَ : \" لا يَطْرَحْ عَنْهُمْ ، إِلا بِإِذْنِ سَيِّدِهِ ""","","","","","Book of the Two Eid Prayers"
"5655","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي الْعَبَّاسُ بْنُ عَبْدِ اللَّهِ بْنِ مَعْبَدٍ ، قَالَ : بَلَغَنَا أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \"لِيُؤَدِّ كُلُّ إِنْسَانٍ مِنْكُمْ صَغِيرٌ أَوْ كَبِيرٌ ، حُرٌّ أَوْ مَمْلُوكٌ ، مِسْكِينٌ أَوْ غَنِيٌّ ، نِصْفَ صَاعٍ مِنْ بُرٍّ ، أَوْ صَاعًا مِنْ تَمْرٍ ، فَأَمَّا مِسْكِينُنَا فَإِنَّهُ يَرْجِعُ إِلَيْهِ أَكْثَرُ مِمَّا أَخَذُوا مِنْهُ ، وَأَمَّا غَنِيًّا فَيُوجَدُ ""","","","","","Book of the Two Eid Prayers"
"5656","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ الأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : \" كَانَزَكَاةُ الْفِطْرِ عَلَى كُلِّ غَنِيٍّ وَفَقِيرٍ ""","","","","","Book of the Two Eid Prayers"
"5657","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قَالَ إِنْسَانٌ لِعَطَاءٍ \"يُلْقِي زَكَاةَ الْفِطْرِ عَنْهُ ، وَعَنْ عِيَالِهِ ، أَيَأْخُذُ مِنْهَا إِذَا قُسِّمَتْ ؟ قَالَ : نَعَمْ ، إِنْ كَانَ مُحْتَاجًا ""","","","","","Book of the Two Eid Prayers"
"5658","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ \"إِنْسَانٌ فَقِيرٌ مُحْتَاجٌ ، وَهُوَ مَدِينٌ أَيُلْقِي ؟ قَالَ : نَعَمْ ، فَقَالَ : إِنْسَانٌ أَيَأْخُذُ مِنْهَا ؟ قَالَ : نَعَمْ ""","","","","","Book of the Two Eid Prayers"
"5659","عَنِ الثَّوْرِيِّ ، عَنْ يُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : \"يُعْطَى الْمِسْكِينُ زَكَاةَ الْفِطْرِ وَإِنْ أَخَذَهَا ""","","","","","Book of the Two Eid Prayers"
"5660","عَنِ الثَّوْرِيِّ ، عَنِ الْحَكَمِ ، عَنْ إِبْرَاهِيمَ ، قَالَ \"إِذَا كَانَ الْفَقِيرُ يَأْخُذُ الزَّكَاةَ يَوْمَ الْفِطْرِ لَمْ يَطْرَحْ عَنْ نَفْسِهِ ""","","","","","Book of the Two Eid Prayers"
"5661","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ \" أَرَأَيْتَ فَقِيرًا لا يَجِدُهَا أَيَسْأَلُ حَتَّى يُؤَدِّيهَا ؟ قَالَ : لا ،لَيْسَتْ إِلا عَلَى مَنْ وَجَدَ ""","","","","","Book of the Two Eid Prayers"
"5662","عَنِ الثَّوْرِيِّ ، عَنْ شُعْبَةَ ، عَنِ الْحَكَمِ ، عَنْ إِبْرَاهِيمَ ، قَالَ \" إِنْ كَانَالْفَقِيرُ يَأْخُذُ الزَّكَاةَ يَوْمَ الْفِطْرِ لَمْ يَطْرَحْ عَنْ نَفْسِهِ \"، وَكِيعٌ ، عَنْ شُعْبَةَ ، عَنِ الْحَكَمِ ، عَنْ إِبْرَاهِيمَ مِثْلَهُ","","","","","Book of the Two Eid Prayers"
"5663","عَنِ ابْنِ جُرَيْجٍ ، قَالَ \" سُئِلَ عَطَاءٌ :هَلْ عَلَى غُلامٍ فِي حَائِطٍ ، أَوْ مَاشِيَةٍ زَكَاةٌ ؟ قَالَ : لا ، مِنْ أَجْلِ أَنَّهُ قَدْ صَدَّقَ الْمَالَ الَّذِي هُوَ فِيهِ ""","","","","","Book of the Two Eid Prayers"
"5664","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي أُمَيَّةُ بْنُ أَبِي عُثْمَانَ ، عَنْ أُمَيَّةَ بْنِ عَبْدِ اللَّهِ بْنِ خَالِدٍ \" أَنَّ عَبْدَ الْمَلِكِ بْنَ مَرْوَانَ كَتَبَ إِلَى ابْنِ عَلْقَمَةَ فِيالْعَبْدِ يَكُونُ فِي الْمَاشِيَةِ ، وَالْحَائِطِ لَيْسَ عَلَيْهِ زَكَاةُ الْفِطْرِ ، مِنْ أَجْلِ أَنَّ الْحَائِطَ وَالْمَاشِيَةَ الَّذِي هُوَ فِيهَا ، إِنَّمَا صُدِّقَتْ بِهِ ""","","","","","Book of the Two Eid Prayers"
"5665","عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ،\" أَنَّهُ كَانَ يُزَكِّي ، أَوْ قَالَ : يُلْقِي عَنْ عُمَّالِ أَرْضِهِ ""","","","","","Book of the Two Eid Prayers"
"5666","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، قَالَ \" كَانَ ابْنُ عُمَرَيُؤَدِّي زَكَاةَ الْفِطْرِ بِالْمَدِينَةِ عَنْ رَقِيقِهِ الَّذِينَ يَعْمَلُونَ فِي أَرْضِهِ ، وَعَنْ رَقِيقِ امْرَأَتِهِ ، وَعَنْ كُلِّ إِنْسَانٍ يَعُولُهُ ""","","","","","Book of the Two Eid Prayers"
"5667","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ \" أَنَّهُ كَانَيُزَكِّي عَنْ رَقِيقِهِ الَّذِي فِي أَرْضِهِ وَمَاشِيَتِهِ ""","","","","","Book of the Two Eid Prayers"
"5668","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : لا أَعْلَمُهُ إِلا عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ \"هِيَ عَلَى الرِّعَاءِ ""","","","","","Book of the Two Eid Prayers"
"5669","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبِي ذِئْبٍ ، عَنْ يَزِيدَ بْنِ قُسْيَطٍ ، أَنَّهُ سَأَلَ ابْنَ الْمُسَيِّبِ ، وَعُرْوَةَ بْنَ الزُّبَيْرِ ، وَأَبَا سَلَمَةَ بْنَ عَبْدِ الرَّحْمَنِ : \"عَنْ رَقِيقِ الرَّجُلِ فِي مَاشِيَتِهِ ، فَقَالُوا : لِيُطْعِمْ عَنْهُمْ ""","","","","","Book of the Two Eid Prayers"
"5670","عَنْ رَجُلٍ ، مِنْ أَسْلَمَ ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللَّهِ ، عَنْ مَكْحُولٍ ، أَنَّ مُعَاذَ بْنَ جَبَلٍ ، وَابْنَ مَسْعُودٍ ، قَالا : \"لَيْسَ عَلَى عُمَّالِ الْحَرْثِ وَالرِّعَاعِ زَكَاةُ الْفِطْرِ \" ، وَقَالَ ابْنُ عُمَرَ : \" هِيَ عَلَى الرِّعَاءِ، أَيْ : عَلَى عُمَّالِ الرَّقِيقِ الْمَاشِيَةِ ""","","","","","Book of the Two Eid Prayers"
"5671","عَنْ مَعْمَرٍ ، عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ ، عَنْ نَافِعٍ ، قَالَ \" كَانَ ابْنُ عُمَرَيَطْرَحُ زَكَاةَ الْفِطْرِ ، عَنْ كُلِّ عَبْدٍ لَهُ حَاضِرٍ ، أَوْ غَائِبٍ ، أَوْ فِي مَزْرَعَةٍ حَتَّى لَعَلَّهُ أَنْ يَطْرَحَ ، عَنْ سِتِّينَ ، أَوْ سَبْعِينَ \"، قَالَ عَبْدُ الرَّزَّاقِ : وَعَلَى الأَعْرَابِ اللَّبَنُ ، يَعْنِي : فِي الزَّكَاةِ","","","","","Book of the Two Eid Prayers"
"5672","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَطَاءٌ ، أَنَّهُ سَمِعَ ابْنَ عَبَّاسٍ ، يَقُولُ : \"إِنِ اسْتَطَعْتُمْ ، فَأَلْقُوا زَكَاتَكُمْ أَمَامَ الصَّلاةِ ، أَوْ بَيْنَ يَدَيِ الصَّلاةِ ، يَعْنِي : صَلاةَ الْفِطْرِ ""","","","","","Book of the Two Eid Prayers"
"5673","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : مَتَى تَأْمُرُ بِطَعَامِكَ ؟ قَالَ \"أَغْدُو سَحَرًا ، فَآمُرُ بِهِ ، فَيُخْرَجُ بَعْدِي قَبْلَ الصَّلاةِ ""","","","","","Book of the Two Eid Prayers"
"5674","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ : قَالَ : سَمِعْنَا أَنَّهُ يُقَالُ : \"مُرْ بِطَعَامِكَ إِذَا خَرَجْتَ لِلصَّلاةِ ، فَلْيُنْطَلَقْ بِهِ ""","","","","","Book of the Two Eid Prayers"
"5675","عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، \" كَانَ ابْنُ عُمَرَيَبْعَثُ صَدَقَةَ رَمَضَانَ حِينَ يَجْلِسُ الَّذِينَ يَقْبِضُونَهَا ، وَذَلِكَ قَبْلَ الْفِطْرِ بِيَوْمٍ أَوْ يَوْمَيْنِ ""","","","","","Book of the Two Eid Prayers"
"5676","عَنْ عُبَيْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، قَالَ : \" إِنْ كَانَ ابْنُ عُمَرَيَبْعَثُ صَدَقَةَ رَمَضَانَ حِينَ يَجْلِسُ الَّذِينَ يَقْبِضُونَهَا ، وَذَلِكَ قَبْلَ الْفِطْرِ بِيَوْمٍ أَوْ يَوْمَيْنِ ""","","","","","Book of the Two Eid Prayers"
"5677","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، قَالَ : \" إِنْ كَانَ ابْنُ عُمَرَيُخْرِجُ زَكَاةَ الْفِطْرِ قَبْلَ أَنْ يَخْرُجَ إِلَى الْمُصَلَّى حِينَ يَجْلِسُ الَّذِينَ يَقْبِضُونَهَا ، وَذَلِكَ قَبْلَ الْفِطْرِ بِيَوْمٍ أَوْ يَوْمَيْنِ ""","","","","","Book of the Two Eid Prayers"
"5678","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ أَبِي سَلَمَةَ ، قَالَ \" كَانَيُؤْمَرُ أَنْ تُلْقَى الزَّكَاةُ قَبْلَ أَنْ يُخْرَجَ إِلَى الْمُصَلَّى ""","","","","","Book of the Two Eid Prayers"
"5679","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ \" لا بَأْسَ أَنْتُؤَدُّوا زَكَاةَ الْفِطْرِ قَبْلَهُ بِيَوْمٍ أَوْ يَوْمَيْنِ أَوْ بَعْدَ الْفِطْرِ بِيَوْمٍ أَوْ يَوْمَيْنِ \"، قَالَ : \" وَكَانَ يُخْرِجُهَا هُوَ قَبْلَ أَنْ يَغْدُوَ ""","","","","","Book of the Two Eid Prayers"
"5680","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ \" هَلْ فِي ذَلِكَ حَرَجٌ ،إِنْ أَخَّرْتُهَا حَتَّى تَكُونَ بَعْدَ الْفِطْرِ ؟ قَالَ : لا ""","","","","","Book of the Two Eid Prayers"
"5681","أَخْبَرَنَا عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عُبَيْدُ اللَّهِ بْنُ عُمَرَ ، قَالَ \" أَدْرَكْتُ سَالِمَ بْنَ عَبْدِ اللَّهِ وَغَيْرَهُ مِنْ عُلَمَائِنَا وَأَشْيَاخِنَا ،فَلَمْ يَكُونُوا يُخْرِجُونَهَا إِلا حِينَ يَغْدُو \"، وَقَدْ سَمِعْتُهُ مِنْ عُبَيْدِ اللَّهِ بْنِ عُمَرَ","","","","","Book of the Two Eid Prayers"
"5682","قَالَ : أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي مُوسَى بْنُ عُقْبَةَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَأَمَرَ بِزَكَاةِ الْفِطْرِ قَبْلَ خُرُوجِ النَّاسِ إِلَى الْمُصَلَّى ""","","","","","Book of the Two Eid Prayers"
"5683","عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ شِهَابٍ ، أَنَّهُ بَلَغَهُ : \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَامَفَأَمَرَ النَّاسَ أَنْ يُخْرِجُوهَا قَبْلَ أَنْ يَخْرُجُوا إِلَى الْمُصَلَّى سُنَّةً ""","","","","","Book of the Two Eid Prayers"
"5684","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ عِكْرِمَةَ ، قَالَ \" كَانَالنَّاسُ يُلْقُونَ زَكَاتَهُمْ ، وَيَأْكُلُونَ قَبْلَ أَنْ يَخْرُجُوا إِلَى الْمُصَلَّى ""","","","","","Book of the Two Eid Prayers"
"5685","عَنْ مَعْمَرٍ ، قَالَ : سُئِلَ الْحَسَنُ \" عَنْ زَكَاةِ الْفِطْرِ ،فَأَمَرَنَا بِإِخْرَاجِهَا ، قِيلَ : فِإِنَّهُمْ يَقْتَضُونَهَا ، قَالَ : فَلا تُبَلِّغُوهُمْ إِيَّاهَا ، وَلا تُنْعِمُوهُمْ عَيْنًا ""","","","","","Book of the Two Eid Prayers"
"5686","عَنِ الثَّوْرِيِّ ، وَابْنِ عُيَيْنَةَ \" أَنَّ أَبَا إِسْحَاقَ ، أَخْبَرَهُمَا ، أَنَّ عَمْرَو بْنَ شُرَحْبِيلَ كَانَيَجْمَعُ زَكَاةَ الْفِطْرِ فِي مَسْجِدِ حَيِّهِ ، ثُمَّ يَرْفَعُهَا إِلَى الرُّهْبَانِ \"، قَالَ الثَّوْرِيُّ : وَكَانَ غَيْرُهُ يُعْطِيهَا الْمُسْلِمِينَ","","","","","Book of the Two Eid Prayers"
"5687","عَنِ ابْنِ عُيَيْنَةَ ، قَالَ : \" كَانَ أَيُّوبُيَبْعَثُ بِزَكَاةِ الْفِطْرِ إِلَى جِيرَانِهِ فِي الأَطْبَاقِ ""","","","","","Book of the Two Eid Prayers"
"5688","عَنْ مَعْمَرٍ ، عَنْ قَتَادَة \" أَنَّهُ كَانَيُرَخِّصُ لِلنَّاسِ لا يَكُونُونَ قَرِيبًا مِنْ مَسْجِدِ الْجَمَاعَةِ بِالْبَصْرَةِ أَنْ يُعْطُوا زَكَاتَهُمْ زَكَاةَ الْفِطْرِ أَهْلَ الْحَاجَةِ مِنْ أَقَارِبِهِمْ \"، قُلْنَا لِعَبْدِ الرَّزَّاقِ : أَتَطْرَحُ أَنْتَ فِي مَسْجِدِ الْجَمَاعَةِ ؟ قَالَ : إِذَا كَانُوا لا يُخَزِّنُونَها فَنَعَمْ ، فَإِذَا عَلِمْتُ أَنَّهُمْ يُخَزِّنُونَهَا قَسَمْتُهَا فِي جِيرَانِي ، قُلْنَا لَهُ : فَكَانَ مَعْمَرٌ يَبْعَثُ بِهَا إِلَى الْمَسْجِدِ ، وَكَانُوا إذْ ذَاكَ لا يُخَزِّنُونَهَا","","","","","Book of the Two Eid Prayers"
"5689","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ \" كَانَيُسْتَحَبُّ لأَهْلِ الْبَادِيَةِ أَنْ يَخْرُجُوا يَوْمَ الْعِيدِ ، فَيَؤُمُّهُمْ أَحَدُهُمْ ""","","","","","Book of the Two Eid Prayers"
"5690","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ \"إِنْ شَاءَ أَهْلُ الْبَادِيَةِ لَمْ يُصَلُّوا صَلاةَ الْفِطْرِ ، إِلا فِي قَرْيَةٍ جَامِعَةٍ ""","","","","","Book of the Two Eid Prayers"
"5691","عَنْ رَجُلٍ ، مِنْ أَسْلَمَ ، عَنِ الْحَجَّاجِ بْنِ أَرْطَاةَ ، عَنِ الزُّهْرِيِّ ، قَالَ : بَعَثَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَى قُرَى عُرَيْنَةَ ، وَفَدَكَ ، وَيَنْبُعَ ، وَنَحْوِهَا مِنَ الْقُرَى مَسِيرَةَ ثَلاثَةِ أَيَّامٍ مِنَ الْمَدِينَةِ ، أَنْيُجَمِّعُوا وَيَشْهَدُوا الْعِيدَيْنِ","","","","","Book of the Two Eid Prayers"
"5692","عَنْ هُشَيْمٍ ، عَنْ عُبَيْدِ اللَّهِ بْنِ أَبِي بَكْرِ بْنِ أَنَسٍ ، عَنْ جَدِّهِ أَنَسِ بْنِ مَالِكٍ \" أَنَّهُ كَانَ يَكُونُ فِي مَنْزِلِهِ بِالزَّاوِيَةِ ،فَإِذَا لَمْ يَشْهَدِ الْعِيدَ بِالْبَصْرَةِ ، جَمَعَ أَهْلَهُ وَوَلَدَهُ وَمَوَالِيَهُ ، ثُمَّ يَأْمُرُ مَوْلاهُ عَبْدَ اللَّهِ بْنَ أَبِي عُتْبَةَ ، فَصَلَّى بِهِمْ رَكْعَتَيْنِ ""","","","","","Book of the Two Eid Prayers"
"5693","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَلِيُّ بْنُ أَبِي حُمَيْدٍ \" أَنَّ طَاوُسًا كَانَلا يَدَعُ جَارِيَةً لَهُ سَوْدَاءَ وَلا غَيْرَهَا إِلا أَمَرَهُنَّ ، فَيَخْضِبْنَ أَيْدِيَهُنَّ وَأَرْجُلَهُنَّ لِيَوْمِ الْفِطْرِ وَيَوْمِ الأَضْحَى ، يَقُولُ : يَوْمُ عِيدٍ ""","","","","","Book of the Two Eid Prayers"
"5694","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أُخْبِرْتُ ، \" أَنَّ أَزْوَاجَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَيَخْضِبْنَ بَعْدَ الْعِشَاءِ الآخِرَةِ إِلَى الصُّبْحِ ""","","","","","Book of the Two Eid Prayers"
"5695","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : سَأَلْتُ جَعْفَرَ بْنَ مُحَمَّدٍ ، فَقُلْتُ : بَلَغَنِي أَنَّكَ حَدَّثْتَ عَنْ أَبِيكَ \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَلْبِسُ لِكُلِّ عِيدَيْنِ بُرْدًا \" ، فَقَالَ : لَمْ أَقُلْ ذَلِكَ ، وَلَكِنِّي أُخْبِرْتُ عَنْ أَبِي ، أَنَّهُ قَالَ : \"لَبِسَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي حَجَّةِ الْوَدَاعِ يَوْمَ عَرَفَةَ حُلَّةً ، أَوْ بُرْدًا ""","","","","","Book of the Two Eid Prayers"
"5696","أَخْبَرَنَا أَبُو سَعِيدٍ أَحْمَدُ بْنُ مُحَمَّدِ بْنِ زِيَادِ بْنِ بِشْرٍ الأَعْرَابِيُّ ، قَالَ : حَدَّثَنَا أَبُو يَعْقُوبَ إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ قَالَ . قَالَ : أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : \"سُجُودُ الْقُرْآنِ عَشْرٌ : الأَعْرَافُ ، وَالنَّحْلُ ، وَالرَّعْدُ ، وَبَنِي إِسْرَائِيلَ ، وَمَرْيَمُ ، وَالْحَجُّ ، وَالْفُرْقَانُ ، وطس الْوُسْطَى ، و الم تَنْزِيلُ ، و حم السَّجْدَةَ \"، فَقُلْتُ : وَلَمْ يَكُنِ ابْنُ عَبَّاسٍ يَقُولُ فِي ص سَجْدَةٌ ؟ قَالَ : \" لا ""","","","","","Book of the Virtues of the Quran"
"5697","قَالَ : أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنَا عِكْرِمَةُ بْنُ خَالِدٍ ، أَنَّ سَعِيدَ بْنَ جُبَيْرٍ ، أَخْبَرَهُ \" أَنَّهُ سَمِعَ ابْنَ عَبَّاسٍ ، وَابْنَ عُمَرَ يَعُدَّانِكَمْ فِي الْقُرْآنِ مِنْ سَجْدَةٍ ، فَقَالا : الأَعْرَافُ ، وَالنَّحْلُ ، وَالرَّعْدُ ، وَبَنِي إِسْرَائِيلَ ، وَمَرْيَمُ ، وَالْحَجُّ أَوَّلُهَا ، وَالْفُرْقَانُ ، و طس ، و الم تَنْزِيلُ ، وَص ، وَحم السَّجْدَةَ ، إِحْدَى عَشْرَةَ ""","","","","","Book of the Virtues of the Quran"
"5698","عَنْ مَعْمَرٍ ، عَنْ أَبِي جَمْرَةَ الضُّبَعِيِّ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ ، يَقُولُ : \"فِي الْقُرْآنِ إِحْدَى عَشْرَةَ سَجْدَةً فَعَدَّهُنَّ \"، كَمَا ذَكَرَهُ ابْنُ جُرَيْجٍ ، عَنْ عِكْرِمَةَ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ","","","","","Book of the Virtues of the Quran"
"5699","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي سُلَيْمَانُ الأَحْوَلُ ، أَنَّ مُجَاهِدًا أَخْبَرَهُ ، أَنَّهُ سَأَلَ ابْنَ عَبَّاسٍ :\" أَفِي ص سُجُودٍ ؟ قَالَ : \" نَعَمْ ، ثُمَّ تَلا :  وَوَهَبْنَا لَهُ  حَتَّى بَلَغَ فَبِهُدَاهُمُ اقْتَدِهْ سورة الأنعام آية 84ـ90 \" ، قَالَ : هُوَ مِنْهُمْ","","","","","Book of the Virtues of the Quran"
"5700","وَقَالَ ابْنُ عَبَّاسٍ : \" رَأَيْتُ عُمَرَقَرَأَ ص عَلَى الْمِنْبَرِ ، فَنَزَلَ فَسَجَدَ فِيهَا ، ثُمَّ رَقِيَ عَلَى الْمِنْبَرِ ""","","","","","Book of the Virtues of the Quran"
"5701","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِيٍّ . وَذَكَرَهُ الثَّوْرِيُّ ، عَنْ عَاصِمٍ أَيْضًا ، عَنْ زِرِّ بْنِ حُبَيْشٍ ، عَنْ عَلِيٍّ ، قَالَ \"الْعَزَائِمُ أَرْبَعٌ : الم تَنْزِيلُ ، وَحم السَّجْدَةَ ، وَالنَّجْمُ ، وَاقْرَأْ بِاسْمِ رَبِّكَ الأَعْلَى الَّذِي خَلَقَ \"، قَالَ عَبْدُ الرَّزَّاقِ : وَأَنَا أَسْجُدُ فِي الْعَزَائِمِ كُلِّهَا ، يَعْنِي الْعَزَائِمَ : عُزِمَ عَلَيْكَ أَنْ تَسْجُدَ فِيهَا ، قَالَ أَبُو بَكْرٍ : وَأَنَا أَسْجُدُ فِيهَا ، وَفِي جَمِيعِ السُّجُودِ إِذَا كُنْتُ وَحْدِي","","","","","Book of the Virtues of the Quran"
"5702","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ السَّائِبِ بْنِ يَزِيدَ ، قَالَ \" رَأَيْتُ عُثْمَانَسَجَدَ فِي ص ""","","","","","Book of the Virtues of the Quran"
"5703","قَالَ : أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : \" رَأَيْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَسَجَدَ فِي ص ، وَلَيْسَتْ ص مِنَ الْعَزَائِمِ ""","","","","","Book of the Virtues of the Quran"
"5704","عَنِ الثَّوْرِيِّ ، عَنِ السُّدِّيِّ ، عَنْ أَبِي مَالِكٍ \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَقَرَأَ عَلَى الْمِنْبَرِ ، فَنَزَلَ فَسَجَدَ ""","","","","","Book of the Virtues of the Quran"
"5705","عَنْ إِسْرَائِيلَ ، عَنْ رَجُلٍ ، عَنْ أَبِي مَعْبَدٍ ، مَوْلَى ابْنِ عَبَّاسٍ ، قَالَ \" رَأَيْتُ ابْنَ عَبَّاسٍ ،سَجَدَ فِي ص ""","","","","","Book of the Virtues of the Quran"
"5706","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عُبَيْدِ اللَّهِ بْنِ أَبِي يَزِيدَ ، أَنَّهُ سَمِعَ ابْنَ عَبَّاسٍ ، سُئِلَ فِيص سَجْدَةٌ ؟ قَالَ : \" نَعَمْ ، أَوْلَئِكَ الَّذِينَ هَدَى اللَّهُ فَبِهُدَاهُمُ اقْتَدِهْ ""","","","","","Book of the Virtues of the Quran"
"5707","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَاصِمِ بْنِ سُلَيْمَانَ ، عَنْ بَكْرِ بْنِ عَبْدِ اللَّهِ بْنِ الْمُزَنِيِّ ، أَنَّ رَجُلا أَتَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : \" يَا رَسُولَ اللَّهِ ، رَأَيْتُ كَأَنَّرَجُلا يَكْتُبُ الْقُرْآنَ وَشَجَرَةٌ حِذَاءَهُ ، فَلَمَّا مَرَّ بِمَوْضِعِ السَّجْدَةِ الَّتِي فِي ص سَجَدَتْ ، وَقَالَتْ : اللَّهُمَّ أَحْدِثْ لِي بِهَا شُكْرًا ، وَأَعْظِمْ لِي بِهَا أَجْرًا ، وَاحْطُطْ بِهَا وِزْرًا ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : فَنَحْنُ أَحَقُّ مِنَ الشَّجَرَةِ ""","","","","","Book of the Virtues of the Quran"
"5708","عَنْ مَعْمَرٍ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، عَنْ أَبِيهِ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيسَجْدَةِ ص : \" سَجَدَهَا دَاوُدُ تَوْبَةً ، وَسَجَدْتُهَا شُكْرًا ""","","","","","Book of the Virtues of the Quran"
"5709","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ \" أَنَّ أَبَاهُ كَانَيَسْجُدُ فِي ص ""","","","","","Book of the Virtues of the Quran"
"5710","عَنِ ابْنِ عُيَيْنَةَ ، قَالَ : سَمِعْتُ عَبْدَةَ بْنَ أَبِي لُبَابَةَ ، يَقُولُ : سَمِعْتُ ابْنَ عُمَرَ ، يَقُولُ : \"فِي ص سَجْدَةٌ ""","","","","","Book of the Virtues of the Quran"
"5711","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ أَبِي الضُّحَى ، عَنْ مَسْرُوقٍ ، قَالَ : قَالَ عَبْدُ اللَّهِ بْنُ مَسْعُودٍ : \" إِنَّمَاهِيَ تَوْبَةُ نَبِيٍّ ذُكِرَتْ \" ، فَكَانَ لا يَسْجُدُ فِيهَا ، يَعْنِي ص","","","","","Book of the Virtues of the Quran"
"5712","عَنْ سَعِيدٍ الزُّبَيْدِيِّ ، عَنْ فِطْرٍ ، عَنْ مُجَاهِدٍ \" أَنَّ ابْنَ عَبَّاسٍ كَانَيَسْجُدُ فِي الآخِرَةِ مِنْ حم :  وَهُمْ لا يَسْأَمُونَ ""","","","","","Book of the Virtues of the Quran"
"5713","قَالَ : أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، عَنْ شَهْرِ بْنِ حَوْشَبٍ ، أَنَّ ابْنَ عَبَّاسٍ قَالَ لِرَجُلٍسَجَدَ فِي الأُولَى :  إِنْ كُنْتُمْ إِيَّاهُ تَعْبُدُونَ : عَجِلْتَ ""","","","","","Book of the Virtues of the Quran"
"5714","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبِي لَيْلَى ، عَنِ الْحَكَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ \" أَنَّهُ كَانَيَسْجُدُ فِي الآخِرَةِ ، وَهُمْ لا يَسْأَمُونَ ""","","","","","Book of the Virtues of the Quran"
"5715","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبِي لَيْلَى ، عَنْ طَلْحَةَ بْنِ مُصَرِّفٍ ، عَنْ إِبْرَاهِيمَ \" أَنَّهُ كَانَيَسْجُدُ فِيهَا وَهُمْ لا يَسْأَمُونَ ""","","","","","Book of the Virtues of the Quran"
"5716","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ \" أَنَّ الْحَسَنَ كَانَيَسْجُدُ فِي الأُولَى ، إِنْ كُنْتُمْ إِيَّاهُ تَعْبُدُونَ ""","","","","","Book of the Virtues of the Quran"
"5717","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، قَالَ \" سَمِعْتُهُ يَذْكُرُ عَنْ بَعْضِهِمْ أَنَّهُ كَانَيَسْجُدُ فِي الأُولَى إِنْ كُنْتُمْ إِيَّاهُ تَعْبُدُونَ ""","","","","","Book of the Virtues of the Quran"
"5718","عَنْ مَالِكٍ ، وَمَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عَبْدِ الرَّحْمَنِ الأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، \" أَنَّ عُمَرَسَجَدَ فِي النَّجْمِ ، قَامَ فَوَصَلَ إِلَيْهِا سُورَةً ""","","","","","Book of the Virtues of the Quran"
"5719","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ عِكْرِمَةَ بْنِ خَالِدٍ ، عَنِ الْمُطَّلِبِ بْنِ أَبِي وَدَاعَةَ ، قَالَ \" رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَسَجَدَ فِي النَّجْمِ ، فَسَجَدَ النَّاسُ مَعَهُ \"، قَالَ الْمُطَّلِبُ : وَلَمْ أَسْجُدْ مَعَهُمْ ، هُوَ يَوْمَئِذٍ مُشْرِكٌ ، قَالَ الْمُطَّلِبُ : فَلا أَدَعُ أَنْ أَسْجُدَ فِيهَا أَبَدًا ، وَبِهِ نَأْخُذُ","","","","","Book of the Virtues of the Quran"
"5720","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ التَّيْمِيِّ ، عَنْ حُصَيْنِ بْنِ سَبْرَةَ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ ، \" أَنَّهُقَرَأَ فِي الْفَجْرِ بِيُوسُفَ ، فَرَكَعَ ، ثُمَّ قَرَأَ فِي الثَّانِيَةُ بِالنَّجْمِ ، قَامَ فَسَجَدَ ، ثُمَّ قَرَأَ : إِذَا زُلْزِلَتِ الأَرْضُ زِلْزَالَهَا ""","","","","","Book of the Virtues of the Quran"
"5721","عَنِ الثَّوْرِيِّ ، عَنْ عِصَامٍ ، عَنْ زِرِّ بْنِ حُبَيْشٍ ، \" أَنَّ عَمَّارًاسَجَدَ فِي إِذَا السَّمَاءُ انْشَقَّتْ ""","","","","","Book of the Virtues of the Quran"
"5722","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنِ الأَسْوَدِ ، قَالَ : \" رَأَيْتُ عُمَرَ ، وَعَبْدَ اللَّهِ ،يَسْجُدَانِ فِي إِذَا السَّمَاءُ انْشَقَّتْ \"، ثُمَّ قَالَ : أَوْ أَحَدَهُمَا ، وَبِهِ نَأْخُذُ","","","","","Book of the Virtues of the Quran"
"5723","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، \" أَنَّ أَبَا هُرَيْرَةَ كَانَيَسْجُدُ فِي إِذَا السَّمَاءُ انْشَقَّتْ ""","","","","","Book of the Virtues of the Quran"
"5724","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، \" أَنَّ أَبَا هُرَيْرَةَ ، كَانَيَسْجُدُ فِيهَا ""","","","","","Book of the Virtues of the Quran"
"5725","وَقَالَ أَبُو هُرَيْرَةَ : \" رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَسْجُدُ فِيهَا ""","","","","","Book of the Virtues of the Quran"
"5726","أَخْبَرَنَا الثَّوْرِيُّ ، وَابْنُ جُرَيْجٍ ، عَنْ أَيُّوبَ ، عَنْ مُوسَى ، عَنْ عَطَاءِ بْنِ مِينَا ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : \"سَجَدْنَا مَعَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي إِذَا السَّمَاءُ انْشَقَّتْ ، وَ اقْرَأْ بِاسْمِ رَبِّكَ الَّذِي خَلَقَ""","","","","","Book of the Virtues of the Quran"
"5727","عَنْ إِسْرَائِيلَ ، عَنْ عِيسَى بْنِ أَبِي عَزَّةَ ، عَنْ عَامِرٍ الشَّعْبِيِّ ، قَالَ : \"أَسْجُدُ فِي إِذَا السَّمَاءُ انْشَقَّتْ ""","","","","","Book of the Virtues of the Quran"
"5728","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنَا أَبُو بَكْرِ بْنِ أَبِي مُلَيْكَةَ ، عَنْ عُثْمَانَ بْنِ عَبْدِ الرَّحْمَنِ التَّيْمِيِّ ، عَنْ رَبِيعَةَ بْنِ عَبْدِ اللَّهِ بْنِ الْهُدَيْرِ ، أَنَّهُ حَضَرَ عُمَرُ بْنُ الْخَطَّابِ يَوْمَ الْجُمُعَةِقَرَأَ عَلَى الْمِنْبَرِ سُورَةَ النَّحْلِ ، حَتَّى إِذَا جَاءَ السَّجْدَةُ ، نَزَلَ فَسَجَدَ ، وَسَجَدَ النَّاسُ مَعَهُ ، حَتَّى إِذَا كَانَتِ الْجُمُعَةُ الْقَابِلَةُ قَرَأَهَا ، حَتَّى إِذَا جَاءَ السَّجْدَةُ ، قَالَ : \" يَأَيُّهَا النَّاسُ ، إِنَّمَا نَمَرُّ بِالسَّجْدَةِ فَمَنْ سَجَدَ ، فَقَدْ أَصَابَ وَأَحْسَنَ ، وَمَنْ لَمْ يَسْجُدْ ، فَلا إِثْمَ عَلَيْهِ \" ، قَالَ : وَلَمْ يَسْجُدْ عُمَرُ","","","","","Book of the Virtues of the Quran"
"5729","قَالَ ابْنُ جُرَيْجٍ : وَزَادَنِي نَافِعٌ ، عَنِ ابْنِ عُمَرَ ، أَنَّهُ قَالَ :\" لَمْ يُفْرَضِ السُّجُودُ عَلَيْنَا إِلا أَنْ نَشَاءُ ""","","","","","Book of the Virtues of the Quran"
"5730","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، أَنَّ عُمَرَ ، وَابْنَ عُمَرَ ، كَانَايَسْجُدَانِ فِي الْحَجِّ سَجْدَتَيْنِ ، قَالَ : وَقَالَ ابْنُ عُمَرَ \" لَوْ سَجَدْتُ فِيهَا وَاحِدَةً كَانَتِ السَّجْدَةُ الآخِرَةُ أَحَبَّ إِلَيَّ \" ، قَالَ : وَقَالَ ابْنُ عُمَرَ : \" إِنَّ هَذِهِ السُّورَةَ فُضِّلَتْ بِسَجْدَتَيْنِ ""","","","","","Book of the Virtues of the Quran"
"5731","عَنْ مَالِكٍ ، عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ ، قَالَ \" رَأَيْتُ ابْنَ عُمَرَيَسْجُدُ فِي الْحَجِّ سَجْدَتَيْنِ ""","","","","","Book of the Virtues of the Quran"
"5732","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الأَعْلَى ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : \"فِي سُورَةِ الْحَجِّ الأُولَى عَزِيمَةٌ ، وَالآخِرَةُ تَعْلِيمٌ ، وَكَانَ لا يَسْجُدُ فِيهَا ""","","","","","Book of the Virtues of the Quran"
"5733","قَالَ : أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، \" أَنَّ ابْنَ عُمَرَ كَانَإِذَا قَرَأَ النَّجْمَ يَسْجُدُ فِيهَا ، وَهُوَ فِي الصَّلاةِ ، فَإِنْ لَمْ يَسْجُدْ رَكَعَ ""","","","","","Book of the Virtues of the Quran"
"5734","عَنِ الثَّوْرِيِّ ، عَنْ عَاصِمٍ ، عَنْ أَبِي الْعَالِيَةِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ \"فُضِّلَتْ سُورَةُ الْحَجِّ بِسَجْدَتَيْنِ ""","","","","","Book of the Virtues of the Quran"
"5735","عَنِ الثَّوْرِيِّ ، عَنْ سَعْدِ بْنِ إِبْرَاهِيمَ ، قَالَ : أَنْبَأَنِي مَنْ رَأَى عُمَرَ بِالْجَابِيَةِ ،سَجَدَ فِي الْحَجِّ مَرَّتَيْنِ ""","","","","","Book of the Virtues of the Quran"
"5736","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، \" أَنَّ ابْنَ عُمَرَ كَانَيَسْجُدُ فِي إِذَا السَّمَاءُ انْشَقَّتْ ""","","","","","Book of the Virtues of the Quran"
"5737","عَنِ ابْنِ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى ، قَالَ : حَدَّثَنِي نَافِعٌ ، \" أَنَّ ابْنَ عُمَرَ كَانَإِذَا قَرَأَ بِ النَّجْمِ سَجَدَ ، وَإِذَا قَرَأَ بِاسْمِ رَبِّكَ الَّذِي خَلَقَ فِي الصَّلاةِ كَبَّرَ وَرَكَعَ وَسَجَدَ ، وَإِذَا قَرَأَ بِهَا فِي غَيْرِ الصَّلاةِ سَجَدَ فِيهِمَا ""","","","","","Book of the Virtues of the Quran"
"5738","قَالَ : أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى ، قَالَ \"إِذَا سَجَدْتَ فِي سَجْدَةٍ ، فَلا تَرْكَعْ ، حَتَّى تَقْرَأَ بَعْدَهَا آيَاتٍ ""","","","","","Book of the Virtues of the Quran"
"5739","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءِ بْنِ يَسَارٍ ، أَنَّهُ سَأَلَ زَيْدَ بْنَ ثَابِتٍ عَنِالنَّجْمِ ، أَفِيهَا سَجْدَةٌ ؟ قَالَ زَيْدٌ : قَرَأْتُهَا عِنْدَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَلَمْ يَسْجُدْ","","","","","Book of the Virtues of the Quran"
"5740","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ \"لَيْسَ فِي الْمُفَصَّلِ سَجْدَةٌ \"، عَنْ مَعْمَرٍ ، عَنْ أَبِي جَمْرَةَ الضُّبَعِيِّ ، عَنِ ابْنِ عَبَّاسٍ مِثْلَهُ","","","","","Book of the Virtues of the Quran"
"5741","عَنْ مَعْمَرٍ ، عَمَّنْ ، سَمِعَ أَنَسًا ، وَالْحَسَنَ ، يَقُولانِ \"لَيْسَ فِي الْمُفَصَّلِ سَجْدَةٌ \"، عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ مِثْلَهُ","","","","","Book of the Virtues of the Quran"
"5742","عَمَّنْ ، سَمِعَ عِكْرِمَةَ ، يُحَدِّثُ ، قَالَ : \"سَجَدَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الْمُفَصَّلِ ، إِذْ كَانَ بِمَكَّةَ \" ، يَقُولُ : \" ثُمَّ لَمْ يَسْجُدْ بَعْدُ ""","","","","","Book of the Virtues of the Quran"
"5743","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : السُّجُودُ وَاجِبٌ ؟ قَالَ : لا ، بَلَغَنِي أَنَّ عُمَرَ بْنَ الْخَطَّابِ بَيْنَا هُوَيَقْرَأُ سُورَةً فِيهَا سَجْدَةٌ ، فَسَجَدَ مَنْ حَوْلَهُ ، فَقَالَ : \" لَوْلا أَنَّكُمْ سَجَدْتُمْ مَا سَجَدْتُ ، وَلَيْسَ فِي الصَّلاةِ ""","","","","","Book of the Virtues of the Quran"
"5744","عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ ، \" أَنَّ عُثْمَانَ ، مَرَّ بِقَاصٍّ فَقَرَأَ سَجْدَةً لِيَسْجُدَ مَعَهُ عُثْمَانُ ، فَقَالَ عُثْمَانُ : إِنَّمَاالسُّجُودُ عَلَى مَنِ اسْتَمَعَ \" ، ثُمَّ مَضَى وَلَمْ يَسْجُدْ، قَالَ الزُّهْرِيُّ : وَقَدْ كَانَ ابْنُ الْمُسَيِّبِ يَجْلِسُ فِي نَاحِيَةِ الْمَسْجِدِ ، وَيَقْرَأُ الْقَاصُّ السَّجْدَةَ ، فَلا يَسْجُدُ مَعَهُ ، وَيَقُولُ : إِنِّي لَمْ أَجْلِسْ لَهَا","","","","","Book of the Virtues of the Quran"
"5745","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ سُلَيْمِانَ بْنِ حَنْظَلَةَ ، قَالَ ،قَرَأْتُ عِنْدَ ابْنِ مَسْعُودٍ السَّجْدَةَ ، فَنَظَرْتُ إِلَيْهِ ، فَقَالَ : \" مَا تَنْظُرُ أَنْتَ قَرَأْتَهَا ، فَإِنْ سَجَدْتَ سَجَدْنَا ""","","","","","Book of the Virtues of the Quran"
"5746","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ \" إِنَّمَاالسَّجْدَةُ عَلَى مَنَ جَلَسَ لَهَا ، فَإِنْ مَرَرْتَ فَسَجَدُوا ، فَلَيْسَ عَلَيْكَ سُجُودٌ ""","","","","","Book of the Virtues of the Quran"
"5747","عَنِ الثَّوْرِيِّ ، عَنْ عَطَاءِ بْنِ السَّائِبِ ، عَنْ أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ ، قَالَ \" مَرَّ سَلْمَانُ عَلَى قَوْمٍ قُعُودٍ ،فَقَرَءُوا السَّجْدَةَ فَسَجَدُوا \"، فَقِيلَ لَهُ ، فَقَالَ : \" لَيْسَ لَهَا غَدَوْنَا ""","","","","","Book of the Virtues of the Quran"
"5748","عَنْ مَعْمَرٍ ، أَوْ غَيْرِهِ ، عَنْ قَتَادَةَ ، عَنْ مُطَرِّفِ بْنِ عَبْدِ اللَّهِ \" أَنَّ عِمْرَانَ بْنَ الْحُصَيْنِ ، مَرَّ بِقَاصٍّ ،فَقَرَأَ الْقَاصُّ سَجْدَةً ، فَمَضَى عِمْرَانُ وَلَمْ يَسْجُدْ مَعَهُ \" ، وَقَالَ : \" إِنَّمَا السَّجْدَةُ ، عَلَى مَنْ جَلَسَ لَهَا ""","","","","","Book of the Virtues of the Quran"
"5749","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَقْرَأُ عَلَيْنَا الْقُرْآنَ ، فَإِذَا مَرَّ بِسَجْدَةٍ كَبَّرَ وَسَجَدَ ، فَسَجَدْنَا مَعَهُ ""","","","","","Book of the Virtues of the Quran"
"5750","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، \" أَنَّ عُمَرَ ،قَرَأَ عَلَى الْمِنْبَرِ سُورَةً فِيهَا سَجْدَةٌ ، ثُمَّ نَزَلَ ، فَسَجَدَ ، وَسَجَدَ النَّاسُ مَعَهُ ، فَقَرَأَ فِي الْجُمُعَةِ الَّتِي تَلِيهَا تِلْكَ السُّورَةَ ، فَلَمَّا بَلَغَ قَرِيبًا مِنَ السَّجْدَةِ ، تَهَيَّأَ النَّاسُ لِلسُّجُودِ ، فَقَالَ : إِنَّهَا لَيْسَتْ عَلَيْنَا إِلا أَنْ نَشَاءَ ، فَقَرَأَهَا وَلَمْ يَسْجُدْ ""","","","","","Book of the Virtues of the Quran"
"5751","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ \"أَوَاجِبٌ السُّجُودُ فِي الصَّلاةِ ؟ فَقَالَ : لا ، فَقَالَ : إِذَا كَانَ وَاجِبًا عَلَيْكَ فِي الصَّلاةِ ، وَجَبَ عَلَيْكَ فِي الْقِرَاءَةِ ، قُلْتُ : أَيُّهُ أَحَبُّ إِلَيْكَ ؟ قَالَ : السُّجُودُ ""","","","","","Book of the Virtues of the Quran"
"5752","عَنْ مَعْمَرٍ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، قَالَ : قَرَأَ رَجُلٌ سُورَةً فِيهَا سَجْدَةٌ عِنْدَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا فَرَغَ ، قَالَ : يَا رَسُولَ اللَّهِ ،مَا فِي هَذِهِ السُّورَةِ سَجْدَةٌ ؟ قَالَ : \" بَلَى ، وَلَكِنَّكَ كُنْتَ إِمَامًا ، فَلَوْ سَجَدْتَ سَجَدْنَا \"، وَقَالَهُ ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ","","","","","Book of the Virtues of the Quran"
"5753","عَنْ مُحَمَّدِ بْنِ عَمَّارٍ ، وَغَيْرِ وَاحِدٍ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِيرِينَ ، قَالَ : سُئِلَتْ عَائِشَةُ عَنْسُجُودِ الْقُرْآنِ ، فَقَالَتْ : \" حَقٌّ لِلَّهِ تُؤَدُّونَهُ ، أَوْ تَطَوُّعٌ تَطَوَّعُونَهُ ، فَمَا مِنْ مُسْلِمٍ يَسْجُدُ لِلَّهِ سَجْدَةً ، إِلا رَفَعَهُ اللَّهُ بِهَا دَرَجَةً ، أَوْ حَطَّ عَنْهُ بِهَا خَطِيئَةً لَهُ ، أَوْ جَمَعَهُمَا لَهُ كِلَيْهِمَا \"، عَنْ يَحْيَى بْنِ الْعَلاءِ ، عَنْ زَيْدٍ مِثْلَهُ","","","","","Book of the Virtues of the Quran"
"5754","قَالَ : أَخْبَرَنَا الأَوْزَاعِيُّ ، عَنِ الْوَلِيدِ بْنِ هِشَامٍ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، قَالَ : قُلْتُ لِثَوْبَانَ حَدِّثْنِي بِحَدِيثٍ لَعَلَّ اللَّهَ يَنْفَعُنِي بِهِ ، قَالَ : قُلْتُ لَهُ ذَلِكَ ثَلاثًا ، فَقَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : \"مَا مِنْ عَبْدٍ يَسْجُدُ لِلَّهِ سَجْدَةً ، إِلا رَفَعَهُ اللَّهُ بِهَا دَرَجَةً ، وَحَطَّ عَنْهُ بِهَا خَطِيئَةً ""","","","","","Book of the Virtues of the Quran"
"5755","قَالَ : أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَبِي إِسْحَاقَ سَمِعْتُهُ ، يَقُولُ : قَالَ ابْنُ مَسْعُودٍ :\" إِذَا كَانَتِ السَّجْدَةُ آخِرَ السُّورَةِ ، فَارْكَعْ إِنْ شِئْتَ ، أَوِ اسْجُدْ ، فَإِنَّ السَّجْدَةَ مَعَ الرَّكْعَةِ \"، قُلْتُ : مَنْ حَدَّثَكَ هَذَا يَا أَبَا إِسْحَاقَ ؟ قَالَ : أَصْحَابُنَا عَلْقَمَةُ ، وَالأَسْوَدُ ، وَالرَّبِيعُ بْنُ خُثَيْمٍ","","","","","Book of the Virtues of the Quran"
"5756","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنِ الأَسْوَدِ ، عَنْ عَبْدِ اللَّهِ ، قَالَ : \"إِذَا كَانَتِ السَّجْدَةُ خَاتِمَةَ السُّورَةِ ، فَإِنْ شِئَتَ رَكَعْتَ ، وَإِنْ شِئَتَ سَجَدْتَ ""","","","","","Book of the Virtues of the Quran"
"5757","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، فِي رَجُلٍ سَمِعَ امْرَأَةً قَرَأَتْ سَجْدَةً ، قَالَ \"لا يَتَّخِذْهَا إِمَامًا ، وَلَكِنْ لِيَقْرَأْهَا ثُمَّ يَسْجُدْ ""","","","","","Book of the Virtues of the Quran"
"5758","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، قَالَ \"الأَعْرَافُ ، وَ بَنِي إِسْرَائِيلَ ، وَ اقْرَأْ بِاسْمِ رَبِّكَ ، وَ النَّجْمُ ، وَ إِذَا السَّمَاءُ انْشَقَّتْ ، إِنْ شَاءَ رَكَعَ ، وَإِنْ شَاءَ سَجَدَ ""","","","","","Book of the Virtues of the Quran"
"5759","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، قَالَ : لا أَعْلَمُ إِلا عَنِ ابْنِ مَسْعُودٍ ، قَالَ \"إِذَا مَرَرْتَ بِ النَّجْمِ ، وَ إِذَا السَّمَاءُ انْشَقَّتْ ، وَ اقْرَأْ بِاسْمِ رَبِّكَ الَّذِي خَلَقَ ، وَ بَنِي إِسْرَائِيلَ ، وَآخِرِ الأَعْرَافِ ، فَإِنْ شِئْتَ سَجَدْتَ ، ثُمَّ وَصَلْتَ بِهَا شَيْئًا مِنَ الْقُرْآنِ ، وَإِنْ شِئْتَ رَكَعْتَ ""","","","","","Book of the Virtues of the Quran"
"5760","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ \"إِذَا بَلَغْتَ السَّجْدَةَ ، فَإِنْ شِئْتَ جَعَلْتَهَا رَكْعَةً \"، قَالَ ابْنُ جُرَيْجٍ ، وَقَالَهُ ابْنُ طَاوُسٍ","","","","","Book of the Virtues of the Quran"
"5761","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ \" أَنَّ أَبَاهُ رُبَّمَا كَانَرَكَعَ فِي الم تَنْزِيلُ إِذَا بَلَغَ السَّجْدَةَ ، وَكَانَ لا يَدَعُهَا كُلَّ لَيْلَةٍ أَنْ يَقْرَأَ بِهَا ""","","","","","Book of the Virtues of the Quran"
"5762","عَنْ مَعْمَرٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ التَّيْمِيِّ ، عَنْ أَبِيهِ ، عَنْ أَبِي ذَرٍّ ، قَالَ : قُلْتُ : أَيْ رَسُولَ اللَّهِ ،أَيُّ مَسْجِدٍ وُضِعَ بِالأَرْضِ أَوَّلَ ؟ قَالَ : \" الْمَسْجِدُ الْحَرَامُ \" ، قَالَ : قُلْتُ : ثُمَّ أَيٌّ ؟ قَالَ : \" الْمَسْجِدُ الأَقْصَى \" ، قَالَ : قُلْتُ : فَكَمْ بَيْنَهُمَا ؟ قَالَ : \" أَرْبَعُونَ سَنَةً \" ، ثُمَّ قَالَ : \" حَيْثُ أَدْرَكَتْكَ الصَّلاةُ فَصَلِّ ، فَهُوَ مَسْجِدٌ \"، فَكَانَ التَّيْمِيُّ ، رُبَّمَا قَرَأَ فِي السَّجْدَةِ ، وَهُوَ يَمُرُّ ، فَسَجَدَ كَمَا هُوَ عَلَى الطَّرِيقِ","","","","","Book of the Virtues of the Quran"
"5763","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ \" فِيالرَّجُلِ يَقْرَأُ السَّجْدَةَ فِي الصَّلاةِ ، فَيَسْجُدُ فَيُضِيفُ إِلَيْهَا أُخْرَى \" ، قَالَ : \" إِذَا فَرَغَ سَجَدَ سَجْدَتَيِ السَّهْوِ ""","","","","","Book of the Virtues of the Quran"
"5764","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبِي لَيْلَى ، عَنْ عَطَاءٍ ، وَجَابِرٍ ، قَالا : \"إِذَا قَرَأْتَ السَّجْدَةَ حَوْلَ الْبَيْتِ ، فَاسْتَقْبِلِ الْبَيْتَ ، وَأَوْمِئْ إِيمَاءً ""","","","","","Book of the Virtues of the Quran"
"5765","عَنْ إِسْرَائِيلَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، عَنِ الأَسْوَدِ \" أَنَّهُ كَانَيَقْرَأُ السَّجْدَةَ ، وَهُوَ يَمْشِي فَيُومِئُ إِيمَاءً ""","","","","","Book of the Virtues of the Quran"
"5766","عَنْ إِسْرَائِيلَ ، عَنْ ثُوَيْرِ بْنِ أَبِي فَاخِتَةَ ، عَنْ أَبِيهِ ، قَالَ \"إِذَا قَرَأَ الإِمَامُ السَّجْدَةَ فَلَمْ يَسْجُدْ ، أَوْمَأَ مَنْ وَرَاءَهُ ""","","","","","Book of the Virtues of the Quran"
"5767","قَالَ : أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ \" عَنِ ابْنِ سِيرِينَ ، وَأَبِي قِلابَةَ ، كَانَاإِذَا قَرَءَا بِالسَّجْدَةِ يُكَبِّرَانِ إِذَا سَجَدَا ، وَيُسَلِّمَانِ إِذَا فَرَغَا ""","","","","","Book of the Virtues of the Quran"
"5768","عَنِ الثَّوْرِيِّ ، عَنِ الْحَكَمِ بْنِ عُتَيْبَةَ ، عَنْ أَبِي الأَحْوَصِ \" أَنَّهُ كَانَيُسَلِّمُ فِي السَّجْدَةِ ""","","","","","Book of the Virtues of the Quran"
"5769","عَنِ الثَّوْرِيِّ ، عَنْ عَطَاءِ بْنِ السَّائِبِ ، عَنْ أَبِي عَبْدِ الرَّحْمَنِ ، قَالَ \" كَانَيَقْرَأُ بِنَا وَنَحْنُ مُتَوجِّهُونَ إِلَى بَنِي سُلَيْمٍ إِلَى غَيْرِ الْقِبْلَةِ ، فَيمُرُّ بِالسَّجْدَةِ ، فَيُومِئُ إِيمَاءً ثُمَّ يُسَلِّمُ ""","","","","","Book of the Virtues of the Quran"
"5770","عَنِ الثَّوْرِيِّ ، عَنِ الْحَسَنِ بْنِ عُبَيْدِ اللَّهِ ، عَنْ إِبْرَاهِيمَ ، عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ ، قَالَ \"لَيْسَ فِي السُّجُودِ تَسْلِيمٌ ""","","","","","Book of the Virtues of the Quran"
"5771","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ شُرَحْبِيلَ ، عَنِ الْمُغِيرَةِ بْنِ حَكِيمٍ ، قَالَ : كُنْتُ مَعَ ابْنِ عُمَرَفَقَرَأَ قَاصٌّ بِسَجْدَةٍ بَعْدَ الصُّبْحِ ، فَصَاحَ عَلَيْهِ ابْنُ عُمَرَ فَسَجَدَ الْقَاصُّ ، وَلَمْ يَسْجُدِ ابْنُ عُمَرَ ، فَلَمَّا طَلَعَتِ الشَّمْسُ ، قَضَاهَا ابْنُ عُمَرَ ، يَقُولُ : سَجَدَهَا، وَقَالَ الثَّوْرِيُّ : \" تُقْضَى السَّجْدَةُ إِذَا سَمِعْتَهَا ، وَلَمْ تَسْجُدْهَا ""","","","","","Book of the Virtues of the Quran"
"5772","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ : \"إِذَا سَمِعْتَ السَّجْدَةَ وَأَنْتَ عَلَى غَيْرِ وُضُوءٍ ، فَتَيَمَّمْ ثُمَّ اسْجُدْ \" ، عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، قَالَ : سَمِعْتُ حَمَّادًا يُحَدِّثُ عَنْ إِبْرَاهِيمَ ، قَالَ : \" يَتَوَضَّأُ وَيَسْجُدُ ""","","","","","Book of the Virtues of the Quran"
"5773","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، قَالَ : \" كَانَ ابْنُ عُمَرَيُصِيحُ عَلَيْهِمْ إِذَا رَآهُمْ ، يَعْنِي الْقُصَّاصَ يَسْجُدُونَ بَعْدَ الصُّبْحِ \" ، قَالَ مَعْمَرٌ ، وَأَخْبَرَنِيهِ أَيُّوبُ ، عَنْ نَافِعٍ","","","","","Book of the Virtues of the Quran"
"5774","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ \"إِذَا سَمِعْتَ السَّجْدَةَ وَأَنْتَ تُصَلِّي ، فَاسْجُدْ ، فَإِنْ كُنْتَ رَاكِعًا ، أَوْ سَاجِدًا أَجْزَأَكَ مِنَ السَّجْدَةِ ""","","","","","Book of the Virtues of the Quran"
"5775","عَنْ مَعْمَرٍ ، عَنْ جَابِرٍ ، قَالَ : \"إِذَا سَمِعْتَ السَّجْدَةَ وَأَنْتَ فِي الصَّلاةِ فَاسْجُدْ ، إِلا أَنْ تَكُونَ سَاجِدًا ""","","","","","Book of the Virtues of the Quran"
"5776","عَنِ الثَّوْرِيِّ ، عَنْ لَيْثٍ ، عَنْ طَاوُسٍ ، قَالَ \"إِنَّ فِي الصَّلاةَ لَشُغْلا ""","","","","","Book of the Virtues of the Quran"
"5777","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِيرِينَ ، قَالَ \"لا تُدْخِلْ فِي صَلاتِكَ مَا لَيْسَ فِيهَا \"، قَالَ سُفْيَانُ : وَنَقُولُ : اقْضِهَا بَعْدُ","","","","","Book of the Virtues of the Quran"
"5778","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ \"أَيُكْرَهُ أَنْ يُحَزِّبَ الإِنْسَانُ بِسُورَةٍ قَبْلَ سُورَةٍ ؟ قَالَ : لا ""","","","","","Book of the Virtues of the Quran"
"5779","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي يُوسُفُ بْنُ مَاهَكَ ، قَالَ : إِنِّي عِنْدَ عَائِشَةَ ، إِذْ جَاءَهَا عِرَاقِيٌّ ، فَقَالَ : أَيُّ الْكَفَنِ خَيْرٌ ؟ فَقَالَتْ : \" وَيْحَكَ ، وَمَا يَضُرُّكُ ؟ \" قَالَ : يَا أُمَّ الْمُؤْمِنِينَ فَأَرِينِي مُصْحَفَكِ لِعَلِّيٍّ أُؤَلِّفُ الْقُرْآنَ عَلَيْهِ ، فَإِنَّا نَقْرَأُهُ غَيْرَ مُؤَلَّفٍ ، قَالَتْ : \"وَمَا يَضُرُّكَ أَيُّهُ قَرَأْتَ قَبْلُ ، إِنَّمَا أُنْزِلَ مِنْهُ سُورَةٌ مِنَ الْمُفَصَّلِ فِيهَا ذِكْرُ الْجَنَّةِ وَالنَّارِ ، حَتَّى إِذَا ثَابَ النَّاسُ إِلَى الإِسْلامِ نَزَلَ الْحَلالُ وَالْحُرَامُ ، وَلَوْ نَزَلَ أَوَّلَ شَيءٍ لا تَشْرَبُوا الْخَمْرَ ، لَقَالُوا : لا نَدَعُ الْخَمْرَ أَبَدًا ، وَلَوْ نَزَلَ لا تَقْرَبُوا النِّسَاءَ ، لَقَالُوا : لا نَدَعُ أَبَدًا ، لَقَدْ نَزَلَ بِمَكَّةَ وَإِنِّي لَجَارِيَةٌ أَلْعَبُ عَلَى مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ السَّاعَةُ أَدْهَى وَأَمَرُّ ، وَمَا نَزَلَتْ سُورَةُ الْبَقَرَةِ إِلا وَأَنَا عِنْدَهُ \" ، قَالَ : فَأَخْرَجَتْ لَهُ الْمُصْحَفَ ، فَأَمْلَتْ عَلَيْهِ آيَ السُّورِ","","","","","Book of the Virtues of the Quran"
"5780","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، أَوْ غَيْرِهِ ، قَالَ \" كَانَ ابْنُ سِيرِينَ ،يَقْرَأُ الْقُرْآنَ أَوْرَادًا ، ثُمَّ يُضِيفُ إِلَيْهَا سُورَةً أُخْرَى مِنَ الْقُرْآنِ ، حَتَّى كَانَ رُبَّمَا أَضَافَ إِلَيْهَا سُبْعَ الْقُرْآنِ ، وَكَانَ يَقْرَأُ الْقُرْآنَ فِي سَبْعٍ \"، قَالَ مَعْمَرٌ : وَكَانَ قَتَادَةُ يَقْرَأُهُ فِي سَبْعٍ","","","","","Book of the Virtues of the Quran"
"5781","عَنِ الثَّوْرِيِّ ، عَنْ حُصَيْنٍ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عُتْبَةَ ، قَالَ : \" كَانَ ابْنُ مَسْعُودٍ ،يَقْرَأُ الْقُرْآنَ حَتَّى كَانَ ، وَمَا يَسْتَعِينُ مِنَ النَّهَارِ إِلا بِيَسِيرٍ ""","","","","","Book of the Virtues of the Quran"
"5782","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ أَبِي الأَحْوَصِ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : \"مَنْ قَرَأَ الْقُرْآنَ فِي أَقَلِّ مِنْ ثَلاثٍ فَهُوَ رَاجِزٌ \"، عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ عَلِيِّ بْنِ بَذِيمَةَ ، عَنْ أَبِي عُبَيْدَةَ بْنِ عَبْدِ اللَّهِ ، عَنِ ابْنِ مَسْعُودٍ مِثْلَهُ","","","","","Book of the Virtues of the Quran"
"5783","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَةَ بْنِ عُمَيْرٍ ، عَنْ أَبِي الأَحْوَصِ ، قَالَ : قَالَ عَبْدُ اللَّهِ :\" لا تَقْرَءُوا الْقُرْآنَ فِي أَقَلِّ مِنْ ثَلاثٍ ، اقْرَءُوهُ فِي سَبْعٍ ، وَيُحَافِظُ الرَّجُلُ يَوْمًا وَلَيْلَةً عَلَى جُزْئِهِ ""","","","","","Book of the Virtues of the Quran"
"5784","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ ، عَنْ أَبِي الْمُهَلَّبِ ، قَالَ : سَمِعْتُ أُبَيَّ بْنَ كَعْبٍ :\" إِنَّا لَنَقْرَأُ أَوْ إِنِّي لأَقْرَؤُهُ فِي ثَمَانٍ ""","","","","","Book of the Virtues of the Quran"
"5785","عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنْ حَفْصَةَ بِنْتَ سِيرِينَ ، عَنْ أَبِي الْعَالِيَةِ : \" أَنَّ مُعَاذَ بْنَ جَبَلٍ ،كَرِهَ أَنْ يُقْرَأَ الْقُرْآنُ فِي أَقَلِّ مِنْ ثَلاثٍ ""","","","","","Book of the Virtues of the Quran"
"5786","عَنِ الثَّوْرِيِّ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ رَجُلٍ مِنَ الأَنْصَارِ ، عَنْ أَبِيهِ ، قَالَ : سَأَلْتُ زَيْدَ بْنَ ثَابِتٍ \" عَنِ الرَّجُلِيَقْرَأُ الْقُرْآنَ فِي سَبْعٍ \" ، فَقَالَ : \" حَسَنٌ ، وَلأَنْ أَقْرَأَهُ فِي خَمْسَ عَشْرَةَ ، أَوْ عِشْرِينَ أَحَبُّ إِلَيَّ ، أَقِفُ فِيهِ وَأَتَدَبَّرُ ""","","","","","Book of the Virtues of the Quran"
"5787","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ ابْنِ سِيرِينَ \" أَنَّ عُثْمَانَ كَانَيَقْرَأُ الْقُرْآنَ فِي رَكْعَةٍ يُحْيِي بِهَا لَيْلَةً \"، وَذَكَرَهُ هِشَامٌ ، عَنِ ابْنِ سِيرِينَ مِثْلَهُ","","","","","Book of the Virtues of the Quran"
"5788","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ سَعِيدِ ابْنِ جُبَيْرٍ ، أَخْبَرَهُ أَنَّهُ : \"قَرَأَ الْقُرْآنَ فِي الْكَعْبَةِ فِي رَكْعَةٍ ، وَقَرَأَ فِي الرَّكْعَةِ الأُخْرَى : قُلْ هُوَ اللَّهُ أَحَدٌ \"، وَقَالَ الثَّوْرِيُّ : لا بَأْسَ أَنْ تَقْرَأَهُ فِي لَيْلَةٍ ، إِذَا فَهِمْتَ حُرُوفَهُ","","","","","Book of the Virtues of the Quran"
"5789","عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، عَنِ الأَسْوَدِ \" أَنَّهُ كَانَيَخْتِمُ الْقُرْآنَ فِي لَيْلَتَيْنِ ، وَيَنَامُ مَا بَيْنَ الْمَغْرِبِ وَالْعِشَاءِ فِي رَمَضَانَ ""","","","","","Book of the Virtues of the Quran"
"5790","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ عِمْرَانَ ، عَنْ إِبْرَاهِيمَ \" أَنَّهُ كَانَيَقْرَأُ الْقُرْآنَ فِي رَمَضَانَ فِي كُلِّ ثَلاثٍ ، فَإِذَا دَخَلَتِ الْعَشْرُ قَرَأَهُ فِي لَيْلَتَيْنِ ، وَاغْتَسَلَ فِي كُلِّ لَيْلَةٍ ""","","","","","Book of the Virtues of the Quran"
"5791","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : سَمِعْتُ ابنَ أَبِي مُلَيْكَةَ يُحَدِّثُ ، عَنْ يَحْيَى بْنِ حَكِيمِ بْنِ صَفْوَانَ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرِو بْنِ الْعَاصِ ، قَالَ :جَمَعْتُ الْقُرْآنَ فَقَرَأْتُهُ فِي لَيْلَةٍ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنِّي أَفْرَقُ أَنْ يَطُولَ عَلَيْكَ الزَّمَانُ وَأَنْ تَمَلَّ ، اقْرَأْ بِهِ فِي شَهْرٍ \" ، قَالَ : قُلْتُ : يَا رَسُولَ اللَّهِ ، دَعْنِي أَسْتَمْتِعُ مِنْ قُوَّتِي ، وَمِنْ شَبَابِي ، قَالَ : \" اقْرَأْهُ فِي عِشْرِينَ \" ، قَالَ : أَيْ رَسُولَ اللَّهِ ، دَعْنِي أَسْتَمْتِعُ مِنْ قُوَّتِي ، وَشَبَابِي ، قَالَ : \" اقْرَأْهُ فِي عَشَرَةٍ \" ، قَالَ : أَيْ رَسُولَ اللَّهِ ، دَعْنِي أَسْتَمْتِعُ مِنْ قُوَّتِي ، وَمِنْ شَبَابِي ، قَالَ : \" اقْرَأْهُ فِي سَبْعٍ \" ، قُلْتُ : أَيْ رَسُولَ اللَّهِ ، دَعْنِي أَسْتَمْتِعُ مِنْ قُوَّتِي ، فَأَبَى","","","","","Book of the Virtues of the Quran"
"5792","أَخْبَرَنَا مَعْمَرٌ ، عَنْ سِمَاكِ بْنِ الْفَضْلِ ، عَنْ وَهْبِ بْنِ مُنَبِّهٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو ، أَنَّهُ سَأَلَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \"فِي كَمْ يُقْرَأُ الْقُرْآنُ ؟ \" ، قَالَ : \" فِي أَرْبَعِينَ \" ، قَالَ : فَإِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : \" فِي شَهْرٍ \" ، قَالَ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ : \" فِي خَمْسَ عَشْرَةَ \" ، ثُمَّ قَالَ : \" فِي عَشْرٍ \" ، ثُمَّ قَالَ : \" فِي سَبْعٍ \" ، لَمْ يَنْزِلْ مِنْ سَبْعٍ","","","","","Book of the Virtues of the Quran"
"5793","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، أَنَّ عَبْدَ اللَّهِ بْنَ عَمْرٍو ، سَأَلَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :فِي كَمْ يُقْرَأُ الْقُرْآنُ ؟ \" ، فَقَالَ : \" فِي شَهْرٍ \" ، فَقَالَ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ ، فَذَكَرَ مِثْلَ حَدِيثِ سِمَاكٍ حَتَّى انْتَهَى إِلَى ثَلاثٍ ، قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَنْ قَرَأَهُ فِيمَا دُونَ ثَلاثٍ لَمْ يَفْهَمْهُ \" ،، قَالَ مَعْمَرٌ : وَبَلَغَنِي أَنَّهُ مَنْ قَرَأَ الْقُرْآنَ فِي شَهْرٍ ، فَلَمْ يُسْرِعْ وَلَمْ يُبْطِئْ ، وَمَنْ قَرَأَهُ فِي عِشْرِينَ ، فَهُوَ كَالْجَوَادِ الْمُضَمَّرِ","","","","","Book of the Virtues of the Quran"
"5794","عَنْ رَجُلٍ ، عَنْ شُعْبَةَ ، عَنْ سَعِيدِ بْنِ أَبِي بُرْدَةَ . قَالَ : وَقَدْ ذَكَرَ مَعْمَرٌ بَعْضَهُ ، عَنْ سَعِيدِ بْنِ أَبِي بُرْدَةَ ، قَالَ : سَمِعْتُ أَبِي يُحَدِّثُ ، عَنْ أَبِي مُوسَى ، قَالَ : لَمَّا بَعَثَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، مُعَاذَ بْنَ جَبَلٍ ، وَأَبَا مُوسَى الأَشْعَرِيَّ ، إِلَى الْيَمَنِ ، فَقَالَ لَهُمَا : \"يَسِّرَا وَلا تُعَسِّرَا ، وَلا تَفْتَرِقَا ، وَتَطَاوَعَا ""","","","","","Book of the Virtues of the Quran"
"5795","قَالَ أَبُو مُوسَى : إِنَّ شَرَابًا يُصْنَعُ بِأَرْضِنَا مِنَ الْعَسَلِ ، يُقَالَ : الْبَتْعُ ، وَمِنَ الشَّعِيرِ ، يُقَالُ لَهُ : الْمَزْرُ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :\" كُلُّ مُسْكِرٍ حَرَامٌ ""","","","","","Book of the Virtues of the Quran"
"5796","قَالَ مُعَاذٌ لأَبِي مُوسَى :\" كَيْفَ تَقْرَأُ الْقُرْآنَ ؟ \" ، قَالَ : \" أَقْرَؤُهُ فِي صَلاتِي ، وَعَلَى رَاحِلَتِي وَمُضْطَجِعًا ، وَقَاعِدًا ، أَتَفَوَّقُهُ تَفَوُّقًا \" ، قَالَ مُعَاذٌ : \" لَكِنِّي أَنَامُ ، ثُمَّ أَقُومُ فَأَقْرَؤُهُ ، يَعْنِي : جُزْأَهُ ، فَأَحْتَسِبُ نَوْمَتِي ، كَمَا أَحْتَسِبُ قَوْمَتِي \" ، فَكَأَنَّ مُعَاذَ بْنَ جَبَلٍ فَضَلَ عَلَيْهِ","","","","","Book of the Virtues of the Quran"
"5797","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنْ مُحَمَّدِ بْنِ عَلِيٍّ ، قَالَ :مَرَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِرَجُلٍ نَغَّاشٍ ، يُقَالُ لَهُ : زَنِيمْ ، فَخَرَّ سَاجِدًا ، ثُمَّ رَفَعَ ، فَقَالَ : \" أَسْأَلُ اللَّهَ الْعَافِيَةَ ""","","","","","Book of the Virtues of the Quran"
"5798","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ كَعْبِ بْنِ مَالِكٍ ، عَنْ أَبِيهِ ، قَالَ : \"لَمَّا تَابَ اللَّهُ عَلَيْهِ ، فَنَزَلَتْ تَوْبَتُهُ خَرَّ سَاجِدًا ""","","","","","Book of the Virtues of the Quran"
"5799","قَالَ : أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ مُحَمَّدِ بْنِ قَيْسٍ ، عَنْ أَبِي مُوسَى الْهَمَذَانِيِّ ، قَالَ : كُنْتُ مَعَ عَلِيٍّ يَوْمَ النَّهْرَوَانِ ، فَقَالَ : \"الْتَمِسُوا ذَا الثُّدَيَّةِ \" ، فَالْتَمَسُوهُ ، فَجَعَلُوا لا يَجِدُونَهُ ، فَجَعَلَ يَعْرَقُ جَبِينُ عَلِيٍّ ، وَيَقُولُ : \" وَاللَّهِ مَا كَذَبْتُ ، وَلا كُذِّبْتُ فَالْتَمِسُوهُ \" ، قَالَ : فَوَجَدْنَاهُ فِي سَاقِيَةٍ ، أَوْ جَدْوَلٍ تَحْتَ قَتْلَى ، فَأُتِيَ بِهِ عَلِيٌّ ، فَخَرَّ سَاجِدًا","","","","","Book of the Virtues of the Quran"
"5800","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي عَوْنٍ ، قَالَ : \"سَجَدَ أَبُو بَكْرٍ حِينَ جَاءَهُ فَتْحُ الْيَمَامَةِ \". قَالَ : أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ أَبِي مُحَمَّدِ بْنِ عَلِيٍّ : أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خَرَجَ فَرَأَى رَجُلا نَغَّاشِيًّا ، وَالنَّغَّاشِيُّ الْقَصِيرُ ، ثُمَّ ذَكَرَ مِثْلَ حَدِيثِ الثَّوْرِيِّ عَنْ جَابِرٍ","","","","","Book of the Virtues of the Quran"
"5801","عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنِ الْحَسَنِ ، قَالَ \"لا تَتَوَسَّدُوا الْقُرْآنَ ، فَوَالَّذِي نَفْسِي بِيَدِهِ أَشَدُّ تَفَصِّيًا مِنَ الإِبِلِ الْمُعَقَّلَةِ ، أَوْ قَالَ : الْمَعْقُولَةِ إِلَى عَطَنِهَا ، وَالَّذِي نَفْسِي بِيَدِهِ مَا مِنْهُ آيَةٌ إِلا وَلَهَا ظَهْرٌ وَبَطْنٌ ، وَمَا فِيهِ حَرْفٌ ، إِلا وَلَهُ حَدٌّ وَلِكُلِّ حَدٍّ مَطْلَعٌ \"، فَحَدَّثْتُ بِهِ مَعْمَرًا ، قَالَ : \" امْحُهُ ، لا تُحَدِّثْ بِهِ أَحَدًا ""","","","","","Book of the Virtues of the Quran"
"5802","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ أَبِي وَائِلٍ ، عَنِ ابْنِ مَسْعُودٍ ، رَفَعَهُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \"تَعَاهَدُوا الْقُرْآنَ ، فَإِنَّهُ أَشَدُّ تَفَصِّيًا مِنْ صَدْرِ الرَّجُلِ مِنَ النَّعَمِ مِنْ عُقُلِهَا ، بِئْسَمَا لأَحَدِهِمْ ، أَنْ يَقُولَ : إِنِّي نَسِيتُ آيَةَ كَيْتَ وَكَيْتَ ، بَلْ هُوَ نُسِّيَ ""","","","","","Book of the Virtues of the Quran"
"5803","عَنْ مَعْمَرٍ ، عَنْ عَاصِمِ بْنِ بَهْدَلَةَ ، عَنْ أَبِي الضُّحَى ، أَوْ أَبِي وَائِلٍ ، عَنِ ابْنِ مَسْعُودٍ يَرْوِيهِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \"تَعَاهَدُوا الْقُرْآنَ فَإِنَّهُ وَحْشِيٌّ ، لَهُوَ أَشَدُّ تَفَصِّيًا مِنَ الإِبِلِ مِنْ عُقُلِهَا ، وَلا يَقُولَنَّ أَحَدُكُمْ إِنِّي نَسِيتُ آيَةَ كَيْتَ وَكَيْتَ ، بَلْ هُوَ نُسِّيَ ""","","","","","Book of the Virtues of the Quran"
"5804","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : حَدَّثَنِي عَبْدَةُ بْنُ أَبِي لُبَابَةَ ، أَنَّ شَقِيقَ بْنَ سَلَمَةَ ، قَالَ : سَمِعْتُ ابْنَ مَسْعُودٍ ، قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : \"بِئْسَمَا لِلرَّجُلِ وَالْمَرْأَةِ أَنْ يَقُولَ : نَسِيتُ سُورَةَ كَيْتَ وَكَيْتَ ، بَلْ هُوَ نُسِّيَ ""","","","","","Book of the Virtues of the Quran"
"5805","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الْكَرِيمِ أَبِي أُمَيَّةَ ، عَنْ طَلْقِ بْنِ حَبِيبٍ ، قَالَ \"مَنْ تَعَلَّمَ الْقُرْآنَ ثُمَّ نَسِيَهُ بِغَيْرِ عُذْرٍ ، حُطَّ عَنْهُ بِكُلِّ آيَةٍ دَرَجَةٌ ، وَجَاءَ مَخْصُومًا ""","","","","","Book of the Virtues of the Quran"
"5806","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"مَثَلُ الْقُرْآنِ إِذَا عَاهَدَ عَلَيْهِ صَاحِبُهُ يَقْرَؤُهُ بِاللَّيلِ وَالنَّهَارِ ، كَمَثَلِ رَجُلٍ لَهُ إِبِلٌ فَإِنْ عَقَلَهَا حَفِظَهَا ، وَإِنْ أَطْلَقَ عُقُلَهَا ذَهَبَتْ ، وَكَذَلِكَ صَاحِبُ الْقُرْآنِ \"، عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ","","","","","Book of the Virtues of the Quran"
"5807","عَنْ مَعْمَرٍ ، عَنْ أَبَانَ ، ذَكَرَهُ ، عَنْ بَعْضِهِمْ ، قَالَ \"مَا ذَنْبٌ يُوافِي بِهِ الْعَبْدُ يَوْمَ الْقِيَامَةِ بَعْدَمَا نَهَى اللَّهُ عَنْهُ ، أَعْظَمُ مِنْ أَنْ يَنْسَى سُورَةً كَانَ حَفِظَهَا ""","","","","","Book of the Virtues of the Quran"
"5808","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"لا حَسَدَ إِلا عَلَى اثْنَتَيْنِ : رَجُلٍ آتَاهُ اللَّهُ الْقُرْآنَ فَهُوَ يَقُومُ بِهِ آنَاءَ اللَّيْلِ وَالنَّهَارِ ، وَرَجُلٍ آتَاهُ اللَّهُ مَالا فَهُوَ يُنْفِقُ مِنْهُ ، يَعْنِي الصَّدَقَةَ ، وَمَا أَشْبَهَهَا آنَاءَ اللَّيْلِ وَالنَّهَارِ ""","","","","","Book of the Virtues of the Quran"
"5809","عَنْ مَعْمَرٍ ، عَنْ هِشَامٍ ، عَنْ أَبِيهِ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"يَرْحَمُ اللَّهُ فُلانًا رُبَّمَا ذَكَّرَنِي الآيَةَ وَالآيَاتِ الَّتِي قَدْ كُنْتُ نُسِّيتُهَا ""","","","","","Book of the Virtues of the Quran"
"5810","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي جَعْفَرُ بْنُ مُحَمَّدٍ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَقَرَأَ ذَاتَ لَيْلَةٍ حم عسق فَرَدَّدَهَا مِرَارًا حم عسق وَهُوَ فِي بَيْتِ مَيْمُونَةَ ، فَقَالَ : يَا مَيْمُونَةُ ، أَمَعَكِ حم عسق ؟ ، قَالَتْ : نَعَمْ ، قَالَ : فَأَقْرِينِيهَا ، فَلَقَدْ أُنْسِيتُ مَا بَيْنَ أَوَّلِهَا وَآخِرِهَا","","","","","Book of the Virtues of the Quran"
"5811","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : عَنْ رَجُلٍ ، عَنْ أَنَسٍ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \"عُرِضَتْ عَلَيَّ أُجُورُ أُمَّتِي حَتَّى الْقَذَاةَ ، أَوِ الْبَعْرَةَ يُخْرِجُهَا الإِنْسَانُ مِنَ الْمَسْجِدِ ، وَعُرِضَتْ عَلَيَّ ذُنُوبُ أُمَّتِي ، فَلَمْ أَرَ ذَنْبًا أَكْبَرَ مِنْ آيَةٍ أَوْ سُورَةٍ أُوتِيهَا الرَّجُلُ فَنَسِيَهَا ""","","","","","Book of the Virtues of the Quran"
"5812","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : وَبَلَغَنِي ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، أَنَّهُ قَالَ : \"لأَنْ تَخْتَلِفَ النَّيَازِكُ فِي صَدْرِي ، أَحَبُّ إِلَيَّ مِنْ أَنْ أُسْقِطِ مِنَ الْقُرْآنِ شَيْئًا ""","","","","","Book of the Virtues of the Quran"
"5813","قَالَ : أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ عَاصِمِ بْنِ بَهْدَلَةَ ، عَنْ زِرِّ بْنِ حُبَيْشٍ ، قَالَ : قَالَ عَبْدُ اللَّهِ بْنُ مَسْعُودٍ :\" أَدِيمُوا النَّظَرَ فِي الْمُصْحَفِ ، فَإِذَا اخْتَلَفْتُمْ فِي يَاءٍ وَتَاءٍ ، فَاجْعَلُوهَا ذَكِّرُونِيَ الْقُرْآنَ ""","","","","","Book of the Virtues of the Quran"
"5814","عَنِ الثَّوْرِيِّ ، عَنْ أَبِيهِ ، عَنِ الْمُسَيِّبِ بْنِ رَافِعٍ ، عَنْ شَدَّادِ بْنِ مَعْقِلٍ . قَالَ الثَّوْرِيُّ وَحَدَّثَنِي عَبْدُ الْعَزِيزِ بْنُ رُفَيْعٍ ، عَنْ شَدَّادٍ ، أَنَّ ابْنَ مَسْعُودٍ ، قَالَ \"لَيُنْتَزَعَنَّ هَذَا الْقُرْآنُ مِنْ بَيْنَ أَظْهُرِكُمْ \" ، قَالَ : قُلْتُ : يَا أَبَا عَبْدِ الرَّحْمَنِ ، كَيْفَ يُنْتَزَعُ ، وَقَدْ أَثْبَتْنَاهُ فِي صُدُورِنَا وَأَثْبَتْنَاهُ فِي مَصَاحِفِنَا ؟ قَالَ : \" يُسْرَى عَلَيْهِ فِي لَيْلَةٍ ، فَلا يَبْقَى فِي قَلْبِ عَبْدٍ مِنْهُ وَلا مُصْحَفٍ مِنْهُ شَيءٌ ، وَيُصْبِحُ النَّاسُ فُقَرَاءَ كَالْبَهَائِمِ ، ثُمَّ قَرَأَ عَبْدُ اللَّهِ :  وَلَئِنْ شِئْنَا لَنَذْهَبَنَّ بِالَّذِي أَوْحَيْنَا إِلَيْكَ ثُمَّ لا تَجِدُ لَكَ بِهِ عَلَيْنَا وَكِيلا ""","","","","","Book of the Virtues of the Quran"
"5815","عَنْ إِسْرَائِيلَ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ ، عَنْ شَدَّادِ بْنِ مَعْقِلٍ ، قَالَ : سَمِعْتُ ابْنَ مَسْعُودٍ ، يَقُولُ : \" إِنَّأَوَّلَ مَا تَفْقِدُونَ مِنْ دِينِكُمُ الأَمَانَةَ ، وَإِنَّ آخِرَ مَا يَبْقَى مِنْ دِينِكُمُ الصَّلاةُ ، وَلَيُصَلِّيَنَّ الْقَوْمُ الَّذِينَ لا دِينَ لَهُمْ ، وَلَيُنْتَزَعَنَّ الْقُرْآنُ مِنْ بَيْنَ أَظْهُرِكُمْ \" ، قَالُوا : يَا أَبَا عَبْدِ الرَّحْمَنِ ، أَلَسْنَا نَقْرَأُ الْقُرْآنَ ، وَقَدْ أَثْبَتْنَاهُ فِي مَصَاحِفِنَا ؟ قَالَ : \" يُسْرَى عَلَيْهِ لَيْلا ، فَيُذْهَبُ بِهِ مِنْ أَجْوَافِ الرِّجَالِ ، فَلا يَبْقَى مِنْهُ شَيءٌ ""","","","","","Book of the Virtues of the Quran"
"5816","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، أَنَّ رَجُلا جَاءَ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حِينَ أَصْبَحَ ، فَقَالَ : إِنَّهَاكَانَتْ مَعِي سُورَةٌ ، فَذَهَبْتُ لأَقْرَأَهَا فَمَا أَقْدِرُ عَلَيْهَا ، فَقَالَ لَهُ آخَرُ : وَأَنَا أَيْضًا كَانَتْ مَعِي فَمَا قَدَرْتُ عَلَيْهَا ، قَالَ : مَا أَدْرِي أَرَجُلانِ ، أَمْ ثَلاثَةٌ ، فَدَخَلُوا عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنَّهَا رُفِعَتْ فِي قُرْآنٍ رُفِعَ","","","","","Book of the Virtues of the Quran"
"5817","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ عَبَّادِ بْنِ جَعْفَرٍ ، أَنَّ وَفْدًا أَتَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمَكَّةَ ، فَسَأَلُوهُ أَنْ يُخَلِّيَهُمْ لِحَاجَتِهِمْ ، فَقَالَ : \"إِنِّي فَاتَنِي اللَّيْلَةَ جُزْئِيَ مِنَ الْقُرْآنِ ""","","","","","Book of the Virtues of the Quran"
"5818","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَمَّنْ سَمِعَ الْحَسَنَ ، يَقُولُ : \"هَذَا الْقُرْآنَ قَدْ قَرَأَهُ صِبْيَانٌ وَعَبِيدٌ لا عِلْمَ لَهُمْ بِتَأْوِيلِهِ ، وَلَمْ يَأْتُوا الأَمْرَ مِنْ قِبَلِ أَوَلِهِ \" ، وَقَالَ : \"  كِتَابٌ أَنْزَلْنَاهُ إِلَيْكَ مُبَارَكٌ لِيَدَّبَّرُوا آيَاتِهِ ، وَمَا تَدَبُّرُ آيَاتِهِ إِلا اتِّبَاعُهُ بِعِلْمِهِ ، وَاللَّهِ مَا هُوَ بِحِفْظِ حُرُوفِهِ وَإِضَاعَةِ حُدُودِهِ ، حَتَّى أَنَّ أَحَدَهُمْ ، لَيَقُولُ : وَاللَّهِ لَقَدْ قَرَأْتُ الْقُرْآنَ كُلَّهُ ، وَمَا أُسْقِطُ مِنْهُ حَرْفًا وَاحِدًا وَقَدْ أَسْقَطَهُ كُلَّهُ ، مَا تَرَى لَهُ فِي الْقُرْآنِ مِنْ خُلُقٍ وَلا عَمَلٍ ، وَحَتَّى أَنَّ أَحَدَهُمْ ، لَيَقُولُ : وَاللَّهِ إِنِّي لأَقْرَأُ السُّورَةَ فِي نَفَسٍ وَاحِدٍ ، وَاللَّهِ مَا هَؤُلاءِ بِالْقُرَّاءِ وَلا الْعُلَمَاءِ ، وَلا الْحُكَمَاءِ ، وَلا الْوَرَعَةِ ، وَمَتَى كَانَ الْقُرَّاءُ يَقُولُونَ مِثْلَ هَذَا ؟ لا كَثَّرَ اللَّهُ فِي الْمُسْلِمِينَ مِنْ هَؤُلاءِ ""","","","","","Book of the Virtues of the Quran"
"5819","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، قَالَ : قَالَ عَبْدُ اللَّهِ :لَيْسَ الْخَطَأُ أَنْ تَقْرَأَ بَعْضَ الْقُرْآنِ فِي بَعْضٍ ، وَلا أَنْ تَخْتِمَ آيَةَ غَفُورٍ رَحِيمٍ بِعَلِيمٍ حَكِيمٍ أَوْ بِعَزِيزٍ حَكِيمٍ ، وَلَكِنَّ الْخَطَأَ أَنْ تَقْرَأَ مَا لَيْسَ فِيهِ ، أَوْ تَخْتِمَ آيَةَ رَحْمَةٍ بِآيَةِ عَذَابٍ ""","","","","","Book of the Virtues of the Quran"
"5820","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنْ هَمَّامِ بْنِ الْحَارِثِ ، عَنْ أَبِي الدَّرْدَاءِ ، أَنَّهُ أَقْرَأَ رَجُلا : شَجَرَةَ الزَّقُّومِ { 43 } طَعَامُ الأَثِيمِ { 44 } ، قَالَ : فَقَالَ الرَّجُلُ : طَعَامُ الْيَتِيمِ ، قَالَ : فَقَالَ أَبُو الدَّرْدَاءِ : \" الْفَاجِرْ ""","","","","","Book of the Virtues of the Quran"
"5821","عَنِ الثَّوْرِيِّ ، عَنْ بَيَانٍ ، عَنْ حَكِيمِ بْنِ جَابِرٍ ، عَنْ أَبِي الدَّرْدَاءِ ، قَالَ \"أَقْرَأُ النَّاسِ لَهَذَا الْقُرْآنِ الْمُنَافِقُ ، لا يَذَرُ مِنْهُ أَلِفًا ، وَلا وَاوًا ، يَلُفُّهُ بِلِسَانٍ كَمَا تَلُفُّ الْبَقَرَةُ الْكَلأَ بِلِسَانِهَا ""","","","","","Book of the Virtues of the Quran"
"5822","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، قَالَ : قَالَ ابْنُ مَسْعُودٍ :إِذَا سَأَلَ أَحَدُكُمْ صَاحِبَهُ : كَيْفَ يَقْرَأُ آيَةَ كَذَا وَكَذَا ، فلَيْسَأَلْهُ عَمَّا قَبْلَهَا ""","","","","","Book of the Virtues of the Quran"
"5823","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَزِيدَ بْنِ أَبِي زِيَادٍ ، عَنْ عِيسَى بْنِ فَائِدٍ ، عَنْ سَعْدِ بْنِ عُبَادَةَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \"مَنْ تَعَلَّمَ الْقُرْآنَ ثُمَّ نَسِيَهُ ، لَقِيَ اللَّهَ أَجْذَمَ ""","","","","","Book of the Virtues of the Quran"
"5824","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنْ أَبِي النَّجُودِ ، عَنْ زِرِّ بْنِ حُبَيْشٍ ، قَالَ : قَالَ أُبَيُّ بْنُ كَعْبٍ :\" كَأَيِّنْ تَقْرَءُونَ سُورَةَ الأَحْزَابِ ؟ \" ، قَالَ : قُلْتُ : بِضْعًا وَثَمَانِينَ آيَةً ، قَالَ : \" لَقَدْ كُنَّا نَقْرَأُهَا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَحْوَ سُورَةِ الْبَقَرَةِ أَوْ هِيَ أَكْثَرُ ، وَلَقَدْ كُنَّا نَقْرَأُ فِيهَا آيَةَ الرَّجْمِ : الشَّيْخُ وَالشَّيْخَةُ ، فَارْجُمُوهُمَا أَلْبَتَّةَ نَكَالا مِنَ اللَّهِ ، وَاللَّهُ عَزِيزٌ حَكِيمٌ ""","","","","","Book of the Virtues of the Quran"
"5825","قَالَ : أَخْبَرَنَا مَعْمَرٌ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِي أُمَامَةَ قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"تَعَلَّمُوا الْقُرْآنَ ، فَإِنَّهُ شَافِعٌ لأَصْحَابِهِ يَوْمَ الْقِيَامَةِ ، وَتَعَلَّمُوا الْبَقَرَةَ وَآلَ عِمْرَانَ ، تَعَلَّمُوا الزَّهْرَاوَيْنِ فَإِنَّهُمَا يَأْتِيَانِ يَوْمَ الْقِيَامَةِ كَأَنَّهُمَا غَمَامَتَانِ ، أَوْ غَيَايَتَانِ ، أَوْ كَأَنَّهُمَا فِرْقَانِ مِنْ طَيْرٍ صَوَافٍ تُحَاجَّانِ عَنْ صَاحِبِهِمَا ، وَتَعَلَّمُوا الْبَقَرَةَ فَإِنَّ تَعَلُّمَهَا بَرَكَةٌ ، وَتَرْكُهَا حَسْرَةٌ ، وَلا يُطِيقُهَا الْبَطَلَةُ، يَعْنِي الْبَطَلَةَ : السَّحَرَةَ ""","","","","","Book of the Virtues of the Quran"
"5826","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، قَالَ : قَالَ ابْنُ مَسْعُودٍ :\" لَوْ قِيلَ لأَحَدِكُمْ لَوْ غَدَوْتَ إِلَى الْقَرْيَةِ ، كَانَ لَكَ أَرْبَعُ قَلائِصَ لَبَاتَ ، يَقُولُ : قَدْ آنَ لِي أَنْ أَغْدُوَ ، فَلَوْ أَنَّ أَحَدَكُمْ غَدَا فَتَعَلَّمَ آيَةً مِنْ كِتَابِ اللَّهِ لَكَانَتْ خَيْرًا لَهُ مِنْ أَرْبَعٍ ، وَأَرْبَعٍ ، وَأَرْبَعٍ ، حَتَّى عَدَّ شَيْئًا كَثِيرًا","","","","","Book of the Virtues of the Quran"
"5827","قَالَ أَبُو إِسْحَاقَ : وَأَخْبَرَنِي أَبُو عُبَيْدَةَ ، أَنَّ ابْنَ مَسْعُودٍ إِذَا أَصْبَحَ خَرَجَ أَتَاهُ النَّاسُ إِلَى دَارِهِ ، فَيَقُولُ : عَلَى مَكَانِكُمْ ، ثُمَّ يَمُرُّ بِالَّذِينَ يُقِرِئُهُمُ الْقُرْآنَ ، فَيَقُولُ : يَا فُلانُبِأَيِّ سُورَةٍ أَنْتَ ؟ فَيُخْبِرُونَهُ ، فَيَقُولُ : بِأَيِّ آيَةٍ ؟ فَيَفْتَحُ عَلَيْهِ الآيَةَ الَّتِي تَلِيهَا ، ثُمَّ يَقُولُ : تَعَلَّمْهَا ، فَإِنَّهَا خَيْرٌ لَكَ مِمَّا بَيْنَ السَّمَاءِ وَالأَرْضِ ، قَالَ : فَيَظُنُّ الرَّجُلُ أَنَّهَا لَيْسَتْ فِي الْقُرْآنِ آيَةٌ خَيْرٌ مِنْهَا ، ثُمَّ يَمُرُّ بِالآخَرِ ، فَيَقُولُ لَهُ مِثْلَ ذَلِكَ ، حَتَّى يَقُولَ لِذَلِكَ كُلِّهِمْ ""","","","","","Book of the Virtues of the Quran"
"5828","أَخْبَرَنَا ، عَنْ مَعْمَرٍ ، عَنْ عَبْدِ الْكَرِيمِ الْجَزْرِيِّ ، عَنْ أَبِي عُبَيْدَةَ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : \"مَنْ قَرَأَ الْقُرْآنَ ، فَلَهُ بِكُلِّ آيَةٍ عَشْرُ حَسَنَاتٍ ، لا أَقُولُ  الم عَشْرٌ ، وَلَكِنْ أَلِفٌ ، وَلامٌ ، وَمِيمٌ ، ثَلاثُونَ حَسَنَةً ""","","","","","Book of the Virtues of the Quran"
"5829","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : سَمِعْتُ ابْنَ أَبِي حُسَيْنٍ يَقُولُ : قَالَ عَبْدُ اللَّهِ بْنُ مَرْوَانَ \" إِنَّاللَّهَ اخْتَارَ الْكَلامَ ، فَاخْتَارَ الْقُرْآنَ ، فَاخْتَارَ مِنْهُ سُورَةَ الْبَقَرَةِ ، وَاخْتَارَ مِنْ سُورَةِ الْبَقَرَةِ آيَةَ الْكُرْسِيِّ ، وَاخْتَارَ الْبِلادَ فَاخْتَارَ الْحَرَمَ ، وَاخْتَارَ الْحَرَمَ فَاخْتَارَ الْمَسْجِدَ ، وَاخْتَارَ الْمَسْجِدَ فَاخْتَارَ مَوْضِعَ الْبَيْتِ ""","","","","","Book of the Virtues of the Quran"
"5830","عَنِ الثَّوْرِيِّ ، عَنْ عَلْقَمَةَ بْنِ مَرْثَدٍ ، عَنْ أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ ، عَنْ عُثْمَانَ بْنِ عَفَّانَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"أَفْضَلُكُمْ مَنْ تَعَلَّمَ الْقُرْآنَ وَعَلَّمَهُ ""","","","","","Book of the Virtues of the Quran"
"5831","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ ، عَنْ أَبِي الدَّرْدَاءِ ، أَنَّ رَجُلا ، قَالَ لَهُ : إِنَّ إِخْوَانَكَ مِنْ أَهْلِ الْكُوفَةِ يَقْرَءُونَ عَلَيْكَ السَّلام-َ ، قَالَ :\" وَأَنْتَ فَأَقْرِئْهُمُ السَّلامَ ، وَقُلْ لَهُمْ : فَلْيُعْطُوا الْقُرْآنَ بِخَزَائِمِهِمْ ، فَإِنَّهُ سَيَحْمِلُهُمْ عَلَى الْقَصْدِ وَالسَّهُوَلَةِ ، وَيُجَنِّبُهُمُ الْجَوْرَ وَالْحَزُونَةَ ، يَعْنِي : بِخَزَائِمِهِمْ ، يَعْنِي اجْعَلُوا الْقُرْآنَ مِثْلَ الْخِزَامِ فِي أَنْفِ أَحَدِكُمْ ، فَاتَّبِعُوهُ وَاعْمَلُوا بِهِ ""","","","","","Book of the Virtues of the Quran"
"5832","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"شَيَّبَتْنِي هُودٌ وَأَخَوَاتُهَا : سُورَةُ الْوَاقِعَةِ ، وَسُورَةُ الْقِيَامَةِ ، وَالْمُرْسَلاتِ ، وَ إِذَا الشَّمْسُ كُوِّرَتْ ، وَ إِذَا السَّمَاءُ انْشَقَّتْ ، وَ إِذَا السَّمَاءُ انْفَطَرَتْ \"، قَالَ : وَأَحْسِبُهُ ذَكَرَ سُورَةَ هُودٍ","","","","","Book of the Virtues of the Quran"
"5833","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ أَبِي الأَحْوَصِ ، قَالَ : قَالَ ابْنُ مَسْعُودٍ \" إِنَّهَذَا الْقُرْآنَ مَأْدُبَةُ اللَّهِ ، فَمَنِ اسْتَطَاعَ أَنْ يَتَعَلَّمَ مِنْهُ شَيْئًا فَلْيَفْعَلْ ، فَإِنَّ أَصْفَرَ الْبُيُوتِ مِنَ الْخَيْرِ الْبَيْتُ الَّذِي لَيْسَ فِيهِ مِنْ كِتَابِ اللَّهِ تَعَالَى شَيءٌ ، وَإِنَّ الْبَيْتَ الَّذِي لَيْسَ فِيهِ مِنْ كِتَابِ اللَّهِ شَيءٌ خَرِبٌ كَخَرَابِ الْبَيْتِ الَّذِي لا عَامِرَ لَهُ ، وَإِنَّ الشَّيْطَانَ يَخْرُجُ مِنَ الْبَيْتِ يَسْمَعُ سُورَةَ الْبَقَرَةِ تُقْرَأُ فِيهِ ""","","","","","Book of the Virtues of the Quran"
"5834","عَنْ مَعْمَرٍ ، عَنْ لَيْثٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"الْبَيْتُ الَّذِي يُقْرَأُ فِيهِ الْقُرْآنُ يَكْثُرُ خَيْرُهُ ، وَيُوَسَّعُ عَلَى أَهْلِهِ ، وَيَحْضُرُهُ الْمَلائِكَةُ ، وَيَهْجُرُهُ الشَّيَاطِينُ ، وَإِنَّ الْبَيْتَ الَّذِي لا يُقْرَأُ فِيهِ يُضَيَّقُ عَلَى أَهْلِهِ ، وَيَقِلُّ خَيْرُهُ ، وَيَهْجُرُهُ الْمَلائِكَةُ ، وَيَحْضُرُهُ الشَّيَاطِينُ ، وَإِنَّ الْبَيْتَ الَّذِي يُقْرَأُ فِيهِ الْقُرْآنُ وَيُثَوَّرُ فِيهِ ، يُضِيءُ لأَهْلِ السَّمَاءِ كَمَا يُضِيءُ النَّجْمُ الأَرْضَ ""","","","","","Book of the Virtues of the Quran"
"5835","قَالَ : ثُمَّ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :\" بَشِّرِ الْمَشَّائِينَ فِي الظُّلَمِ إِلَى الْمَسَاجِدِ بِنُورٍ مِنَ اللَّهِ يَوْمَ الْقِيَامَةِ \"، قَالَ مَعْمَرٌ : وَسَمِعْتُ رَجُلا مِنْ أَهْلِ الْمَدِينَةِ ، يَقُولُ : إِنَّ أَهْلَ السَّمَاءِ لَيَتَرَاءَوْنَ الْبَيْتَ الَّذِي يُقْرَأُ فِيهِ الْقُرْآنُ وَيُصَلَّى فِيهِ ، كَمَا يَتَرَاءَى أَهْلُ الدُّنْيَا الْكَوْكَبَ الَّذِي فِي السَّمَاءِ","","","","","Book of the Virtues of the Quran"
"5836","عَنْ عُمَرَ بْنِ رَاشِدٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، رَفَعَ الْحَدِيثَ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :سَيَقْرَأُ الْقُرْآنَ ثَلاثَةٌ : رَجُلٌ يَقْرَأُهُ ابْتِغَاءَ مَرْضَاتِ اللَّهِ وَرَجَاءَ ثَوَابِهِ مِنَ اللَّهِ فَذَلِكَ ثَوَابُهُ عَلَى اللَّهِ ، وَرَجُلٌ يَقْرَأُهُ رِيَاءً وَسُمْعَةً لِيَأْكُلَ بِهِ فِي الدُّنْيَا فَذَلِكَ عَلَيْهِ وَلا لَهُ ، وَرَجُلٌ يَقْرَأُهُ فَلا تُجَاوِزُ قِرَاءَتُهُ، أَوْ قَالَ : مِبْقَعَتَهُ تَرْقُوَتَهُ","","","","","Book of the Virtues of the Quran"
"5837","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ سَعِيدٍ الْجُرَيْرِيِّ ، عَنْ أَبِي السَّلِيلِ ، عَنْ عَبْدِ اللَّهِ بْنِ رَبَاحٍ ، عَنْ أُبَيِّ بْنِ كَعْبٍ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \"أَيُّ آيَةٍ فِي كِتَابِ اللَّهِ أَعْظَمُ ؟ \" فَقَالَ : اللَّهُ وَرَسُولُهُ أَعْلَمُ ، يُكَرِّرُهَا مِرَارًا ، ثُمَّ قَالَ أُبَيٌّ : آيَةُ الْكُرْسِيِّ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لِيَهْنِكَ الْعِلْمُ أَبَا الْمُنْذِرِ ، وَالَّذِي نَفْسِي بِيَدِهِ ، إِنَّ لَهَا لَلِسَانًا وَشَفَتَيْنِ ، تُقَدِّسَانِ لِلْمَلِكِ عِنْدَ سَاقِ الْعَرْشِ ""","","","","","Book of the Virtues of the Quran"
"5838","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، وَغَيْرِهِ ، عَنِ الشَّعْبِيِّ ، عَنْ مَسْرُوقٍ ، وَشُتَيْرِ بْنِ شَكَلٍ الْعَبْسِيِّ ، قَالا : جَلَسْنَا فِي الْمَسْجِدِ ، فَثَابَ إِلَيْهِمَا ، فَقَالَ أَحَدُهُمَا لِصَاحِبِهِ : إِنَّهُ لَمْ يُقْدِمْ إِلَيْنَا إِلا أَنَّا لَنُحَدِّثُهُمْ ، فَإِمَّا أَنْ تُحَدِّثُهُمْ فَأُصَدِّقُكَ ، وَإِمَّا أَنْ أُحَدِّثَهُمْ وَتُصَدِّقُنِي ، فَقَالَ أَحَدُهُمَا سَمِعْتُ عَبْدَ اللَّهِ ، يَقُولُ : \"أَعْظَمُ آيَةٍ فِي الْقُرْآنِ آيَةُ الْكُرْسِيِّ ""","","","","","Book of the Virtues of the Quran"
"5839","قَالَ الآخَرُ : صَدَقْتَ ، قَالَ الآخَرُ : سَمِعْتُ عَبْدَ اللَّهِ ، يَقُولُ :\" أَجْمَعُ آيَةٍ فِي الْقُرْآنِ  إِنَّ اللَّهَ يَأْمُرُ بِالْعَدْلِ وَالإِحْسَانِ \"، قَالَ : صَدَقْتَ","","","","","Book of the Virtues of the Quran"
"5840","وَسَمِعْتُهُ ، يَقُولُ :\" أَشَدُّ آيَةٍ فِي الْقُرْآنِ تَفْوِيضًا  وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مَخْرَجًا \"، قَالَ : قَالَ : صَدَقْتَ","","","","","Book of the Virtues of the Quran"
"5841","قَالَ : وَسَمِعْتُهُ ، يَقُولُ :\" أَكْبَرُ آيَةٍ فِي الْقُرْآنِ فَرَجًا  يَا عِبَادِيَ الَّذِينَ أَسْرَفُوا عَلَى أَنْفُسِهِمْ \"، قَالَ : صَدَقْتَ","","","","","Book of the Virtues of the Quran"
"5842","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَيْمُونٍ الأَوْدِيِّ ، قَالَ : قَالَ رَسُولُ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"قُلْ هُوَ اللَّهُ أَحَدٌ ، تَعْدِلُ ثُلُثَ الْقُرْآنِ ""","","","","","Book of the Virtues of the Quran"
"5843","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ \"قُلْ هُوَ اللَّهُ أَحَدٌ ، تَعْدِلُ ثُلُثَ الْقُرْآنِ ""","","","","","Book of the Virtues of the Quran"
"5844","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي أَبُو مُلَيْكَةَ أَنَّهُ سَمِعَ عُبَيْدَ بْنَ عُمَيْرٍ ، يَقُولُ : \"قُلْ هُوَ اللَّهُ أَحَدٌ ، تَعْدِلُ ثُلُثَ الْقُرْآنِ ""","","","","","Book of the Virtues of the Quran"
"5845","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَطَاءٌ ، أَنَّهُ بَلَغَهُ أَنَّ : \"قُلْ هُوَ اللَّهُ أَحَدٌ ، تَعْدِلُ ثُلُثَ الْقُرْآنِ ""","","","","","Book of the Virtues of the Quran"
"5846","عَنِ الثَّوْرِيِّ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، عَنْ هِلالِ بْنِ يَسَافٍ ، عَنْ أَبِي مَسْعُودٍ الأَنْصَارِيِّ ، قَالَ \"مَنْ قَرَأَ : قُلْ يَأَيُّهَا الْكَافِرُونَ فِي لَيْلَةٍ ، فَقَدْ أَكْثَرَ وَأَطْيَبَ ""","","","","","Book of the Virtues of the Quran"
"5847","عَنْ جَعْفَرٍ ، عَنْ هِشَامِ بْنِ مُسْلِمٍ ، قَالَ : سَمِعْتُ بَكْرَ بْنَ عَبْدِ اللَّهِ الْمُزَنِيَّ ، يَقُولُ : \"إِذَا زُلْزِلَتِ الأَرْضُ نِصْفُ الْقُرْآنِ ، وَ قُلْ يَأَيُّهَا الْكَافِرُونَ رُبْعُ الْقُرْآنِ ""","","","","","Book of the Virtues of the Quran"
"5848","عَنْ مَعْمَرٍ ، قَالَ : سَمِعْتُ رَجُلا ، يُحَدِّثُ : \" أَنَّلِكُلِّ شَيءٍ قَلْبًا ، وَقَلْبُ الْقُرْآنِ يس ، وَمَنْ قَرَأَهَا فَإِنَّهَا تَعْدِلُ الْقُرْآنَ ، أَوْ قَالَ : تَعْدِلُ قِرَاءَةَ الْقُرْآنِ كُلِّهِ ، وَمَنْ قَرَأَ : قُلْ يَأَيُّهَا الْكَافِرُونَ ، فَإِنَّهَا تَعْدِلُ رُبْعَ الْقُرْآنِ ، وَ إِذَا زُلْزِلَتِ شَطْرَ الْقُرْآنِ ""","","","","","Book of the Virtues of the Quran"
"5849","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، وَغَيْرِهِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، قَالَ : قَالَ عَبْدُ اللَّهِ : \" إِنَّالْقُرْآنَ شَافِعٌ وَمُشَفَّعٌ ، وَمَاحِلٌ مُصَدَّقٌ ، فَمَنْ جَعَلَهُ أَمَامَهُ قَادَهُ إِلَى الْجَنَّةِ ، وَمَنْ جَعَلَهُ خَلْفَهُ سَاقَهُ إِلَى النَّارِ ""","","","","","Book of the Virtues of the Quran"
"5850","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّهَذَا الْقُرْآنَ شَافِعٌ وَمُشَفَّعٌ ، وَصَادِقٌ مَاحِلٌ ""","","","","","Book of the Virtues of the Quran"
"5851","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : \"مَنِ اسْتَمَعَ آيَةً مِنْ كِتَابِ اللَّهِ ، كَانَتْ لَهُ نُورًا يَوْمَ الْقِيَامَةِ ""","","","","","Book of the Virtues of the Quran"
"5852","عَنْ مَعْمَرٍ ، عَنْ أَبَانَ ، عَنْ أَنَسٍ ، أَوْ عَنِ الْحَسَنِ ، قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"مَنِ اسْتَمَعَ إِلَى آيَةٍ مِنْ كِتَابِ اللَّهِ ، كَانَتْ لَهُ حَسَنَةٌ مُضَاعَفَةٌ ، وَمَنْ تَعَلَّمَ آيَةً مِنْ كِتَابِ اللَّهِ ، كَانَتْ لَهُ نُورًا يَوْمَ الْقِيَامَةِ ""","","","","","Book of the Virtues of the Quran"
"5853","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، قَالَ \" بَلَغَنَا أَنَّالْقُرْآنَ يَأْتِي يَوْمَ الْقِيَامَةِ فِي صُورَةِ الشَّاحِبِ الْمُنَافِرِ ، فَيَقُولُ لِصَاحِبِهِ : تَعْرِفُنِي ؟ فَيَقُولُ : مَنْ أَنْتَ ؟ فَيَقُولُ : أَنَا خَلِيلُكَ ، وَأَنَا ضَجِيعُكَ ، وَأَنَا شَفِيقُكَ ، وَأَنَا الَّذِي كُنْتُ أُسْهِرُ لَيْلَكَ ، وَأُنْصِبُ نَهَارَكَ ، وَأَزُولُ مَعَكَ حَيْثُمَا زُلْتَ ، كَانَ كُلُّ تَاجِرٍ قَدْ أَصَابَ مِنْ تِجَارَتِهِ ، وَأَنَا الْيَوْمَ لَكَ مِنْ وَرَاءِ كُلِّ تَاجِرٍ ، فَيُعْطَى الْمُلْكَ بِيَمِينِهِ ، وَالْخُلْدَ بِشِمَالِهِ ، وَيُوضَعُ تَاجُ الْوَقَارِ عَلَى رَأْسِهِ ، وَيُقَالَ لَهُ : اذْهَبْ فِي نَعِيمٍ مُقِيمٍ ، وَيُكْسَى أَبَوَاهُ حُلَّتَيْنِ لَمْ تَقُمْ بِهِمَا الدُّنْيَا ، فَيَقُولانِ : أَيُّ هَذَا وَلَمْ نَعْمَلْ لَهُ ؟ فَيَقُولُ : بِأَخْذِ ابْنِكُمَا الْقُرْآنَ ، ثُمَّ يُقَالُ : اقْرَأْ وَارْقَ ، فَمَنْ كَانَ يُرَتِّلُهُ فَبِحِسَابِ ذَلِكَ ، وَمَنْ يَهُذُّهُ فَبِحِسَابِ ذَلِكَ ""","","","","","Book of the Virtues of the Quran"
"5854","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ أَصْحَابِهِ ، قَالَ : قَالَ عَبْدُ اللَّهِ بْنُ مَسْعُودٍ :\" نِعْمَ كَنْزُ الصُّعْلُوكِ ، سُورَةُ آلِ عِمْرَانَ ، يَقُومُ مِنْ آخِرِ اللَّيْلِ ، فَيَقُومُ بِهَا ""","","","","","Book of the Virtues of the Quran"
"5855","قَالَ : وَقَالَ عَبْدُ اللَّهِ :\" مَنْ قَرَأَ آلَ عِمْرَانَ ، فَهُوَ غَنِيٌّ ""","","","","","Book of the Virtues of the Quran"
"5856","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، عَنْ زُرَارَةَ بْنِ أَوْفَى ، عَنْ عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"الْمَاهِرُ بِالْقُرْآنِ مَعَ السَّفَرَةِ الْكِرَامِ الْبَرَرَةِ ، وَالَّذِي يَقْرَأُهُ وَهُوَ عَلَيْهِ شَدِيدٌ فَلَهُ أَجْرَانِ اثْنَانِ ""","","","","","Book of the Virtues of the Quran"
"5857","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ إِبْرَاهِيمَ الْهَجَرِيِّ ، عَنْ أَبِي الأَحْوَصِ ، عَنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ ، قَالَ : \" إِنَّهَذَا الْقُرْآنَ مَأْدُبَةُ اللَّهِ ، فَتَعَلَّمُوا مِنْ مَأْدُبَتِهِ مَا اسْتَطَعْتُمْ ، إِنَّ هَذَا الْقُرْآنَ هُوَ حَبْلُ اللَّهِ الَّذِي أَمَرَ بِهِ ، وَهُوَ النُّورُ الْمُبِينُ وَالشِّفَاءُ النَّافِعُ ، عِصْمَةٌ لِمَنِ اعْتَصَمَ بِهِ ، وَنَجَاةٌ لِمَنْ تَمَسَّكَ بِهِ ، لا يَعْوَجُّ فَيُقَوَّمُ ، وَلا يَزُوغُ فَيُشَعَّبَ ، وَلا تَنْقَضِي عَجَائِبُهُ ، وَلا يَخْلَقُ عَنْ رَدٍّ ، اتْلُوهُ فَإِنَّ اللَّهَ يَأْجُرُكُمْ لِكُلِّ حَرْفٍ عَشْرَ حَسَنَاتٍ ، لَمْ أَقُلْ لَكُمْ : الم ، وَلَكِنْ أَلِفٌ حَرْفٌ ، وَلامٌ حَرْفٌ ، وَمِيمٌ حَرْفٌ ""","","","","","Book of the Virtues of the Quran"
"5858","عَنِ ابْنِ عُيَيْنَةَ ، قَالَ : حدَّثَنِي ابْنُ أَبِي لَبِيدٍ ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ : أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَبَعَثَ قَوْمًا ، وَأَمَّرَ عَلَيْهِمْ أَصْغَرَهُمْ ، فَذَكَرُوا ذَلِكَ ، فَقَالَ : \" إِنَّهُ أَكْثَرُكُمْ قُرْآنًا ، وَإِنَّمَا مَثَلُ صَاحِبِ الْقُرْآنِ كَجِرَابٍ فِيهِ مِسْكٌ ، إِنْ فَتَحْتَهُ ، أَوْ فُتِحَ فَاحَ رِيحُهُ ، وَإِنْ أُوكِيَ أُوكِيَ عَلَى طِيبٍ ""","","","","","Book of the Virtues of the Quran"
"5859","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ حَكِيمِ بْنِ جُبَيْرٍ ، عَنْ أَبِي صَالِحٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّلِكُلِّ شَيءٍ سَنَامًا ، وَسَنَامُ الْقُرْآنِ سُورَةُ الْبَقَرَةِ ، وَفِيهِ آيَةٌ سَيِّدَةُ الْقُرْآنِ آيَةُ الْكُرْسِيِّ ، لا تُقْرَأُ فِي بَيْتٍ وَفِيهِ شَيْطَانٌ ، إِلا خَرَجَ ""","","","","","Book of the Virtues of the Quran"
"5860","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، عَنْ أَبِي مَسْعُودٍ الأَنْصَارِيِّ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"مَنْ قَرَأَ بِالآيَتَيْنِ مِنْ آخِرِ سُورَةِ الْبَقَرَةِ كَفَتَاهُ \"، عَنِ ابْنِ عُيَيْنَةَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، عَنْ أَبِي مَسْعُودٍ الأَنْصَارِيِّ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ ، وَزَادَ قَالَ عَبْدُ الرَّحْمَنِ ، وَحَدَّثَنِي بِهِ عَلْقَمَةُ ، عَنْ أَبِي مَسْعُودٍ ، قَالَ : فَلَقِيتُ أَبَا مَسْعُودٍ فِي الطّوَافِ ، فَسَأَلْتُهُ عَنْهُ فَحَدَّثَنِي بِهِ وَهُوَ يَطُوفُ","","","","","Book of the Virtues of the Quran"
"5861","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ \"مَنْ قَرَأَ عَشْرَ آيَاتٍ مِنْ أَوَّلِ الْكَهْفِ ، عُصِمَ مِنْ فِتْنَةِ الدَّجَّالِ ، وَمَنْ قَرَأَ آخِرَهَا ، أَوْ قَالَ : قَرَأَهَا إِلَى آخِرِهَا ، كَانَتْ لَهُ نُورًا مِنْ قَرْنِهِ إِلَى قَدَمِهِ ""","","","","","Book of the Virtues of the Quran"
"5862","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي هَاشِمٍ الْوَاسِطِيِّ ، عَنْ أَبِي مِجْلَزٍ ، عَنْ قَيْسِ بْنِ عَبَّادٍ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيُّ ، قَالَ \"مَنْ تَوَضَّأَ ، ثُمَّ فَرَغَ مِنْ وُضُوئِهِ ، ثُمَّ قَالَ : سُبْحَانَكَ اللَّهُمَّ وَبِحَمْدِكَ ، أَشْهَدُ أَنْ لا إِلَهَ إِلا أَنْتَ ، أَسْتَغْفِرُكَ وَأَتُوبُ إِلَيْكَ ، خُتِمَ عَلَيْهَا بِخَاتَمٍ ، فَوُضِعَتْ تَحْتَ الْعَرْشِ ، فَلا تُكْسَرُ إِلَى يَوْمِ الْقِيَامَةِ ، وَمَنْ قَرَأَ سُورَةَ الْكَهْفِ كَمَا أُنْزِلَتْ ثُمَّ أَدْرَكَ الدَّجَّالَ ، لَمْ يُسَلَّطْ عَلَيْهِ ، وَلَمْ يَكُنْ لَهُ عَلَيْهِ سَبِيلٌ ، وَمَنْ قَرَأَ خَاتِمَةَ سُورَةِ الْكَهْفِ ، أَضَاءَ نُورُهُ مِنْ حَيْثُ قَرَأَهَا مَا بَيْنَهُ ، وَبَيْنَ مَكَّةَ ""","","","","","Book of the Virtues of the Quran"
"5863","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ أَبِي الأَحْوَصِ ، عَنِ ابْنِ مَسْعُودٍ :مَاتَ رَجُلٌ فَجَاءَتْهُ مَلائِكَةُ الْعَذَابِ ، فَقَعَدُوا عِنْدَ رَأْسِهِ ، فَقَالَ لا سَبِيلَ لَكُمْ عَلَيْهِ ، قَدْ كَانَ يَقْرَأُ لِي سُورَةَ الْمُلْكِ ، فَجَلَسُوا عِنْدَ رِجْلَيْهِ ، فَقَالَ لا سَبِيلَ لَكُمْ ، إِنَّهُ كَانَ يَقُومُ عَلَيْنَا يَقْرَأُ سُورَةَ الْمُلْكِ ، فَجَلَسُوا عِنْدَ بَطْنِهِ ، فَقَالَ : لا سَبِيلَ لَكُمْ عَلَيْهِ ، إِنَّهُ أَوْعَى فِيَّ سُورَةَ الْمُلْكِ ، فَسُمِّيَتِ الْمَانِعَةَ ""","","","","","Book of the Virtues of the Quran"
"5864","عَنِ الثَّوْرِيِّ ، عَنْ عَاصِمِ بْنِ أَبِي النَّجُودِ ، عَنْ زِرِّ بْنِ حُبَيْشٍ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ \"يُؤْتَى الرَّجُلُ فِي قَبْرِهِ ، فَتُؤْتَى رِجْلاهُ ، فَتَقُوَلانِ : لَيْسَ لَكُمْ عَلَى مَا قِبَلَنَا سَبِيلٌ ، قَدْ كَانَ يَقْرَأُ عَلَيْنَا سُورَةَ الْمُلْكِ ، ثُمَّ يُؤْتَى جَوْفُهُ ، فَيَقُولُ : لَيْسَ لَكُمْ عَلَيَّ سَبِيلٌ ، كَانَ قَدْ أَوْعَى فِيَّ سُورَةَ الْمُلْكِ ، ثُمَّ يُؤْتَى رَأْسُهُ ، فَيَقُولُ : لَيْسَ لَكُمْ عَلَى مَا قِبَلِي سَبِيلٌ ، كَانَ يَقْرَأُ بِي سُورَةَ الْمُلْكِ \"، قَالَ عَبْدُ الرَّزَّاقِ : \" وَهِيَ الْمَانِعَةُ ، تَمْنَعُ مِنْ عَذَابِ الْقَبْرِ ، وَهِيَ فِي التَّوْرَاةِ هَذِهِ سُورَةُ الْمُلْكِ ، وَمَنْ قَرَأَهَا فِي لَيْلَةٍ ، فَقَدْ أَكْثَرَ وَأَطْيَبَ ""","","","","","Book of the Virtues of the Quran"
"5865","عَنْ مَعْمَرٍ ، عَنْ أَبَانَ ، عَنْ شَهْرِ بْنِ حَوْشَبٍ ، عَنْ أَبِي الدَّرْدَاءِ ، قَالَ : \"مَنْ قَرَأَ فِي لَيْلَةٍ بِمِائَةِ آيَةٍ ، لَمْ تُحَاجِّهِ الْقُرْآنَ ""","","","","","Book of the Virtues of the Quran"
"5866","عَنْ مَعْمَرٍ ، عَنْ عَطَاءِ بْنِ السَّائِبِ ، عَنْ أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ ، قَالَ \"إِذَا كُنَّا نَتَعَلَّمُ الْعَشْرَ مِنَ الْقُرْآنِ ، لَمْ نَتَعَلَّمِ الْعَشْرَ الَّتِي بَعْدَهَا حَتَّى نَتَعَلَّمَ حَلالَهَا ، وَحَرَامَهَا ، وَأَمْرَهَا ، وَنَهْيَهَا ""","","","","","Book of the Virtues of the Quran"
"5867","عَنْ مَعْمَرٍ ، عَنْ شَهْرِ بْنِ حَوْشَبٍ ، عَنْ عَطَاءٍ الْخُرَاسَانِيِّ ، عَنِ ابْنِ عُمَرَ ، قَالَ \"مَنْ قَرَأَ فِي لَيْلَةٍ بِمِائَةِ آيَةٍ ، لَمْ يُكْتَبْ مِنَ الْغَافِلِينَ ، وَمَنْ قَرَأَ بِمِائَتَيْ آيَةٍ ، كُتِبَ لَهُ قُنُوتُ تِلْكَ اللَّيْلَةِ ، وَمَنْ قَرَأَ بِخَمْسِ مِائَةٍ إِلَى أَلْفٍ ، أَصْبَحَ لَهُ قِنْطَارٌ مِنَ الأَجْرِ \" ، قَالَ : فَسُئِلَ ابْنُ عُمَرَ ، كَمِ الْقِنْطَارُ ؟ فَقَالَ : \" سَبْعُونَ أَلْفًا \"، قَالَ عَمْرٌو ، وَسَمِعْتُ الزُّهْرِيَّ ، يَقُولُ : أَخْبَرَنِي مَنْ سَأَلَ كَعْبًا ، عَنْ قَوْلِ ابْنِ عُمَرَ هَذَا ، فَقَالَ كَعْبٌ : لَكِنِّي أَقُولُ مَنْ صَلَّى الْعَتَمَةَ لِوَقْتِهَا ، لَمْ يُكْتَبْ مِنَ الْغَافِلِينَ","","","","","Book of the Virtues of the Quran"
"5868","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَطَاءٌ \"أَنَّ رَجُلَيْنِ فِيمَا مَضَى ، كَانَ يَلْزَمُ أَحَدُهُمَا تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ ، فَجَادَلَتْ عَنْهُ حَتَّى نَجَا ، وَأَمَّا صَاحِبُ السَّجْدَةِ الصُّغْرَى ، فَانْقَسَمَتْ فِي قَبْرِهِ قِسْمَيْنِ : قِسْمٌ عِنْدَ رَأْسِهِ ، وَقِسْمٌ عِنْدَ رِجْلَيْهِ حَتَّى نَجَا ، فَسُمِّيَتِ الْمُنْقَسِمَةَ ""","","","","","Book of the Virtues of the Quran"
"5869","عَنِ ابْنِ جُرَيْجٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنْ عَاصِمِ بْنِ عُمَرَ ، \" أَنَّ عُمَرَ كَانَلا يَأْمُرُ بَنِيهِ بِتَعْلِيمِ الْقُرْآنِ ، إِنْ كَانَ أَحَدٌ مِنْكُمْ مُتَعَلِّمًا ، فَلْيَتَعَلَّمْ مِنَ الْمُفَصَّلِ فَإِنَّهُ أَيْسَرُ ""","","","","","Book of the Virtues of the Quran"
"5870","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ ، قَالَ \"آلَ حم دِيبَاجُ الْقُرْآنِ ""","","","","","Book of the Virtues of the Quran"
"5871","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"مَثَلُ الْقُرْآنِ إِذَا عَاهَدَ عَلَيْهِ صَاحِبُهُ ، فَدَعَا وَقَرَأَ آنَاءَ اللَّيْلِ وَأَطْرَافَ النَّهَارِ ، كَمَثَلِ رَجُلٍ لَهُ إِبِلٌ فَإِنْ عَقَلَهَا حَفِظَهَا ، وَإِنْ أَطْلَقَ عُقُلَهَا ذَهَبَتْ ، وَكَذَلِكَ صَاحِبُ الْقُرْآنِ ""","","","","","Book of the Virtues of the Quran"
"5872","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَطَاءِ بْنِ السَّائِبِ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ :\" مَنْ قَرَأَ الْقُرْآنَ ، فَاتَّبَعَ مَا فِيهِ ، هَدَاهُ اللَّهُ مِنَ الضَّلالَةِ فِي الدُّنْيَا ، وَوَقَاهُ يَوْمَ الْقِيَامَةِ الْحِسَابَ ، وَذَلِكَ أَنَّ اللَّهَ تَعَالَى يَقُولُ :  فَمَنِ اتَّبَعَ هُدَايَ فَلا يَضِلُّ وَلا يَشْقَى ""","","","","","Book of the Virtues of the Quran"
"5873","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْكَدِرِ ، قَالَ : خَرَجَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى قَوْمٍ يَقْرَءُونَ الْقُرْآنَ ، فَقَالَ : \"اقْرَءُوا فَكُلُّ كِتَابٍ لِلَّهِ ، قَبْلَ أَنْ يَأْتِيَ قَوْمٌ يُقِيمُونَهُ إِقَامَةَ الْقِدْحِ ، وَيَتَعَّجَّلُونَهُ وَلا يَتَأَجَّلُونَهُ ""","","","","","Book of the Virtues of the Quran"
"5874","عَنْ مَعْمَرِ بْنِ رَاشِدٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، قَالَ : أَمَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَصْحَابَهُ أَنْيَقْرَءُوا الم تَنْزِيلُ ، وَ تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ ، فَإِنَّهُمَا تَعْدِلُ كُلُّ آيَةٍ مِنْهُمَا سَبْعِينَ آيَةً مِنْ غَيْرِهِمَا ، وَمَنْ قَرَأَهُمَا بَعْدَ الْعِشَاءِ الآخِرَةِ ، كَانَتَا لَهُ مِثْلُهُمَا فِي لَيْلَةِ الْقَدْرِ ""","","","","","Book of the Virtues of the Quran"
"5875","عَنْ مَعْمَرٍ ، عَنْ سَعِيدِ الْجُرَيْرِيِّ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ خَطَبَ النَّاسَ ، فَقَالَ : \" لَقَدْأَتَى عَلَيَّ زَمَانٌ وَنَحْنُ نَرَى أَنَّ أَحَدًا لا يَتَعَلَّمُ كِتَابَ اللَّهِ تَعَالَى ، إِلا وَهُوَ يُرِيدُ بِهِ اللَّهَ ، حَتَّى إِذَا كَانَ هَاهُنَا بِأَخَرَةٍ ظَنَنْتُ أَنَّ نَاسًا يَتَعَلَّمُونَ الْقُرْآنَ ، وَهُمْ يُرِيدُونَ بِهِ النَّاسَ وَمَا عِنْدَهُمْ ، فَأَرِيدُوا اللَّهَ بِأَعْمَالِكُمْ وَقِرَاءَتِكُمْ ، فَإِنَّمَا كُنَّا نَعْرِفُكُمْ وَرَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِينَا ، وَالْوَحْيُ يَنْزِلُ ، وَيُنْبِئُنَا مِنْ أَخْبَارِكُمْ ، وَأَمَّا الْيَوْمَ فَإِنَّمَا أَعْرِفُكُمْ بِأَقْوَالِ كُمْ ، مَنْ أَعْلَنَ لَنَا خَيْرًا ظَنَنَّا بِهِ خَيْرًا ، وَأَحْبَبْنَاهُ عَلَيْهِ ، وَمَنْ أَعْلَنَ لَنَا شَرًّا ، ظَنَنَّا بِهِ شَرًّا ، وَأَبْغَضْنَاهُ عَلَيْهِ ، سَرَائِرُكُمْ فِيمَا بَيْنَكُمْ وَبَيْنَ اللَّهِ ""","","","","","Book of the Virtues of the Quran"
"5876","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَيَتَنَفَّسُ فِي الْحَمْدِ ، ثَلاثَ مَرَّاتٍ","","","","","Book of the Virtues of the Quran"
"5877","عَنْ يُونُسَ بْنِ سُلَيْمٍ الصَّنْعَانِيِّ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدٍ الْقَارِيِّ ، قَالَ : سَمِعْتُ عُمَرَ بْنَ الْخَطَّابِ ، يَقُولُ : كَانَ إِذَا نَزَلَ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْوَحْيُ ، سُمِعَ عِنْدَ وَجْهِهِ كَدَوِيِّ النَّحْلِ ، فَنَزَلَ عَلَيْهِ فَمَكَثْنَا سَاعَةً ، فَاسْتَقْبَلَ الْقِبْلَةَ ، وَرَفَعَ يَدَيْهِ ، وَقَالَ : \" اللَّهُمَّ زِدْنَا وَلا تَنْقُصْنَا ، وَأَكْرِمْنَا وَلا تُهِنَّا ، وَأَعْطِنَا وَلا تَحْرِمْنَا ، وَآثِرْنَا وَلا تُؤْثِرْ عَلَيْنَا ، وَارْضَ عَنَّا \" ، ثُمَّ قَالَ :\" أُنْزِلَ عَلَيَّ عَشْرُ آيَاتٍ ، مَنْ أَقَامَهُنَّ دَخَلَ الْجَنَّةَ ، ثُمَّ قَرَأَ عَلَيْنَا : قَدْ أَفْلَحَ الْمُؤْمِنُونَ حَتَّى خَتَمَ الْعَشْرَ ""","","","","","Book of the Virtues of the Quran"
"5878","عَنِ الثَّوْرِيِّ ، عَنْ سَعْدِ بْنِ إِبْرَاهِيمَ ، عَنْ رَجُلٍ مِنْ جُهَيْنَةَ ، عَنْ عُقْبَةَ بْنِ عَامِرٍ الْجُهَنِيِّ ، قَالَ : \" بَيْنَا أَسِيرُ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ،أُنْزِلَ عَلَيْهِ آيَاتٌ لَمْ أَسْمَعْ مِثْلَهُنَّ ، وَلَمْ أَرَ مِثْلَهُنَّ ، الْمُعَوِّذَتَيْنِ ""","","","","","Book of the Virtues of the Quran"
"5879","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ عَاصِمِ بْنِ أَبِي النَّجُودِ ، عَنْ زِرِّ بْنِ حُبَيْشٍ ، قَالَ : سَأَلْتُ أُبَيَّ بْنَ كَعْبٍ عَنِالْمُعَوِّذَتَيْنِ ، فَقَالَ : سَأَلْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْهُمَا ، فَقَالَ لِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" قِيلَ لِي \" ، فَقُلْتُ : قَالَ أَبِي : قَالَ لِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" فَنَحْنُ نَقُولُ ""","","","","","Book of the Virtues of the Quran"
"5880","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ \"أَكَانَ يُؤْمَرُ بِتَلْقِنَةِ الْمَرِيضِ إِذَا حَضَرَهُ الْمَوْتُ ؟ قَالَ : إِنِّي لأُحِبُّ ذَلِكَ ""","","","","","Book of Funerals"
"5881","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي مَنْصُورُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ أُمِّهِ صَفِيَّةُ ابْنَةُ شَيْبَةَ ، أَنَّهَا سَمِعَتْ عَائِشَةَ ، تَقُولُ : \"لا تَذْكُرُوا مَوْتَاكُمْ إِلا بِخَيْرٍ ، وَلَقِّنُوهُمْ شَهَادَةَ أَنْ لا إِلَهَ إِلا اللَّهُ ""","","","","","Book of Funerals"
"5882","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : حُدِّثْتُ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ ، أَنَّهُ قَالَ : \"احْضُرُوا مَوْتَاكُمْ ، فَأَلْزِمُوهُمْ لا إِلَهَ إِلا اللَّهُ ، وَأَغْمِضُوا أَعْيُنَهُمْ ، وَاقْرَءُوا عِنْدَهُمُ الْقُرْآنَ ""","","","","","Book of Funerals"
"5883","عَنْ مَعْمَرٍ ، عَنْ عُمَرَ بْنِ قَتَادَةَ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، قَالَ :كَانَ لأَبِي بَكْرٍ الصِّدِّيقِ ابْنٌ وَكَانَ فِيهِ بَعْضُ مَا لَمْ يَرْضَ أَبُو بَكْرٍ ، فَكَانَ يُحَقِّرُهُ لِذَلِكَ ، فَمَرِضَ ، فَدَخَلَ عَلَيْهِ أَبُوهُ ، فَقَالَ لَهُ الْغُلامُ : أُرْسِلُكَ إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِرِسَالَةٍ : أَبْلِغْهُ عَنِّي أَنِّي أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ ، وَأَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ ، فَانْطَلَقَ أَبُو بَكْرٍ ، حَتَّى دَخَلَ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَأَخْبَرَهُ بِذَلِكَ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : بَلِّغِ ابْنَكَ أَنَّ لَهُ الْجَنَّةَ ، قَالَ : فَخَرَجَ أَبُو بَكْرٍ ، فَلَقِيَهُ عُمَرُ فَأَخْبَرَهُ ، فَقَالَ لَهُ عُمَرُ : ارْجِعْ بِنَا إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، حَتَّى نَسْتَثْبِتَ مِنْهُ ، فَرَجَعَا إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَقَالَ لَهُ مِثْلَ هَذَا ، فَقَالَ عُمَرُ : يَا رَسُولَ اللَّهِ ، هَذَا لِلأَمْوَاتِ ، فَكَيْفَ الأَحْيَاءُ ؟ ، قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مِثْلُهُ ، وَمِثْلُهُ ، وَمِثْلُهُ حَتَّى عَدَّ بِضْعًا وَثَلاثِينَ مَرَّةً، قَالَ : وَأَشَارَ الْقَاسِمُ بِيَدِهِ أَرْبَعًا وَثَلاثِينَ","","","","","Book of Funerals"
"5884","عَنِ الثَّوْرِيِّ ، عَنْ حُصَيْنٍ ، وَمَنْصُورٍ ، أَوْ أَحَدِهِمَا ، عَنْ هِلالِ بْنِ يَسَافٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ \"مَنْ قَالَ عِنْدَ مَوْتِهِ : لا إِلَهَ إِلا اللَّهُ ، أَنْجَتْهُ يَوْمًا مِنَ الدَّهْرِ ، أَصَابَهُ قَبْلَ ذَلِكَ مَا أَصَابَهُ ""","","","","","Book of Funerals"
"5885","عَنِ الثَّوْرِيِّ ، عَنْ حُصَيْنٍ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَلْقَمَةَ ، قَالَ \"لَقِّنُونِي لا إِلَهَ إِلا اللَّهُ ، عِنْدَ مَوْتِي ، وَأَسْرِعُوا بِي إِلَى حُفْرَتِي ، وَلا تَنْعُونِي ، فَإِنِّي أَخَافُ أَنْ أَكُونَ كَنَعْيِ الْجَاهِلِيَّةِ ، فَإِذَا خَرَجَ الرِّجَالُ بِجِنَازَتِي ، فَأَغْلِقُوا الْبَابَ ، فَإِنَّهُ لا أَرَبَ لِي بِالنِّسَاءَ ""","","","","","Book of Funerals"
"5886","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، يَرْفَعُهُ ، قَالَ : \"لَقِّنُوا أَمْوَاتَكُمْ لا إِلَهَ إِلا اللَّهُ ""","","","","","Book of Funerals"
"5887","عَنْ مَعْمَرٍ ، عَنْ أَبَانَ ، عَمَّنْ حَدَّثَهُ ، أَنَّ ابْنَ مَسْعُودٍ ، قَالَ \"لَقِّنُوا أَمْوَاتَكُمْ لا إِلَهَ إِلا اللَّهُ ، فَإِنَّهَا تَهْدِمُ الْخَطَايَا \" ، فَقِيلَ لَهُ : كَيْفَ الْحَيُّ ؟ قَالَ : \" هِيَ أَهْدَمُ ، وَأَهْدَمُ ""","","","","","Book of Funerals"
"5888","عَنْ صَاحِبٍ لَهُمْ ، عَنْ شُعْبَةَ ، عَنْ أَبِي إِسْحَاقَ ، قَالَ : سَمِعْتُ الأَغَرَّ أَبَا مُسْلِمٍ يُحَدِّثُ عَنْ أَبِي هُرَيْرَةَ ، قَالَ \"خَمْسُ يُصَدِّقُ اللَّهُ بِهَا الْعَبْدَ إِذَا قَالَهُنَّ : إِذَا قَالَ لا إِلَهَ إِلا اللَّهُ وَاللَّهُ أَكْبَرُ ، قَالَ اللَّهُ : صَدَقَ عَبْدِي ، وَإِذَا قَالَ : لا إِلَهَ إِلا اللَّهُ وَالْحَمْدُ لِلَّهِ ، قَالَ اللَّهُ : صَدَقَ عَبْدِي ، وَإِذَا قَالَ : لا إِلَهَ إِلا اللَّهُ لا شَرِيكَ لَهُ ، قَالَ اللَّهُ : صَدَقَ عَبْدِي ، وَإِذَا قَالَ : لا إِلَهَ إِلا اللَّهُ وَحْدَهُ ، قَالَ : صَدَقَ عَبْدِي ، وَإِذَا قَالَ : لا إِلَهَ إِلا اللَّهُ لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ ، قَالَ : صَدَقَ عَبْدِي \"، قَالَ : فَلَقِيتُ شُعْبَةَ ، فَحَدَّثَنِي بِهَذَا عَنِ الأَغَرِّ ، عَنْ أَبِي هُرَيْرَةَ ، وَزَادَ فِيهِنَّ : مَنْ قَالَهُنَّ عِنْدَ مَوْتِهِ لَمْ تَمَسَّهُ النَّارُ ، قَالَ : عَبْدُ الرَّزَّاقِ ، وَقَدْ سَمِعْتُهُ أَنَا مِنْ عَبْدِ اللَّهِ بْنِ كَثِيرٍ ، عَنْ شُعْبَةَ بِإِسْنَادِهِ","","","","","Book of Funerals"
"5889","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ قَبِيصَةَ بْنِ ذُؤَيْبٍ ، قَالَ : دَخَلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى أَبِي سَلَمَةَ وَهُوَ مَرِيضٌ ، فَسَمِعَ بُكَاءً مِنْ وَرَاءِ حِجَابٍ ، قَالَ : \" إِنَّالْمَلائِكَةَ تَحْضُرُ الْمَيِّتَ ، فَتُؤَمِّنَ عَلَى مَا قَالَ أَهْلُهُ ، فَإِنَّ الْبَصَرَ يَشْخَصُ لِلرُّوحِ \" ، وَأَغْمَضَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَبَا سَلَمَةَ","","","","","Book of Funerals"
"5890","عَنِ الثَّوْرِيِّ ، عَنْ سُلَيْمَانَ التَّيْمِيِّ ، عَنْ بَكْرِ بْنِ عَبْدِ اللَّهِ الْمُزَنِيِّ ، قَالَ \"إِذَا أَغْمَضْتَ الْمَيِّتَ ، فَقُلْ : بِسْمِ اللَّهِ عَلَى وَفَاةِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَإِذَا حَمَلْتَ الْمَيِّتَ فَقُلْ : بِسْمِ اللَّهِ وَسَبِّحْ \" ، وَبِهِ نَأْخُذُ","","","","","Book of Funerals"
"5891","أَخْبَرَنَا عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنْ أُمِّ الَهُذَيْلِ ، عَنْ أُمِّ الْحَسَنِ ، عَنْ أُمِّ سَلَمَةَ ، أَنَّهَادُعِيَتْ إِلَى مَيِّتٍ يُنَازِعُ ، فَقَالَتْ لَهَا أُمُّ سَلَمَةَ : \" إِذَا حَضَرْتِيهِ ، فَقُولِي : السَّلامُ عَلَى الْمُرْسَلِينَ ، وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ \"، وَبِهِ نَأْخُذُ أَيْضًا","","","","","Book of Funerals"
"5892","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَلْقَمَةَ بْنِ قَيْسٍ ، حِينَ حَضَرَتْهُ الوَفَاةُ ، قَالَ \"لا تُؤْذِنُوا بِي أَحَدًا كَفِعْلِ الْجَاهِلِيَّةِ ""","","","","","Book of Funerals"
"5893","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي حَمْزَةَ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَلْقَمَةَ ، قَالَ \"إِذَا كَانَ مَنْ يَحْمِلُ الْجِنَازَةَ ، فَلا تُؤْذِنْ أَحَدًا مَخَافَةَ أَنْ يُقَالَ : مَا أَكْثَرَ مَنِ اتَّبَعَهُ ""","","","","","Book of Funerals"
"5894","عَنِ الثَّوْرِيِّ ، عَنْ عَاصِمِ بْنِ أَبِي كَثِيرٍ ، عَنْ أَبِي عُبَيْدَةَ بْنِ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ ، قَالَ \"لا تُؤْذِنُوا بِي أَحَدًا ، حَسْبِي مَنْ يَحْمِلُنِي إِلَى حُفْرَتِي ""","","","","","Book of Funerals"
"5895","عَنْ هِشَامٍ صَاحِبِ الدَّسْتُوَائِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ \"لا بَأْسَ إِذَا مَاتَ الرَّجُلُ أَنْ يُؤْذَنَ صَدِيقُهُ ، إِنَّمَا كَانُوا يَكْرَهُونَ أَنْ يُطَافَ بِهِ فِي الْمَجَالِسِ ، أَنْعِي فُلانًا كَفِعْلِ الْجَاهِلِيَّةِ ""","","","","","Book of Funerals"
"5896","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَنَسِ بْنِ مَالِكٍ ، قَالَ : \"نَعَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَصْحَابَ مُؤْتَةَ رَجُلا رَجُلا ، بَدَأَ بِزَيْدِ بْنِ حَارِثَةَ ، ثُمَّ جَعْفَرِ بْنِ أَبِي طَالِبٍ ، ثُمَّ قَالَ : عَبْدُ اللَّهِ بْنُ رَوَاحَةَ ، ثُمَّ قَالَ : فَأَخَذَ اللِّوَاءَ خَالِدُ بْنُ الْوَلِيدِ ، وَهُوَ سَيْفٌ مِنْ سُيوفِ اللَّهِ ""","","","","","Book of Funerals"
"5897","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ \"أَكَانَ يُؤْمَرُ بِالْمَرْءِ إِذَا حَضَرَهُ الْمَوْتُ أَنْ يُطَهَّرَ بِالْغُسْلَ ؟ \" ، قَالَ : \" إِنَّ ذَلِكَ لَحَسَنٌ ""","","","","","Book of Funerals"
"5898","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ حُرُوفَ الْمَيِّتِ إِلَى الْقِبْلَةِ حِينَ يَحِينُ فَوْضُهُ عَلَى شِقِّهِ الأَيْمَنِ ، أَسُنَّةٌ ذَلِكَ ؟ قَالَ \" سُبْحَانَ اللَّهِ ! مَا عَلِمْتُ مِنْ أَحَدٍ يَعْقِلُ تَرَكَ ذَلِكَ مِنْ مَيِّتِهِ ، وَاللَّهِ إِنَّالرَّجُلَ لَيُحْمَلُ فِرَاشُهُ حَتَّى يُحَرَّفَ بِهِ إِذَا لَمْ يَسْتَطِعْ ذَلِكَ ""","","","","","Book of Funerals"
"5899","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، قَالَ \"اسْتَقْبِلْ بِالْمَيِّتِ الْقِبْلَةَ \"، قَالَ سُفْيَانُ : يَعْنِي عَلَى يَمِينِهِ ، كَمَا يُوضَعُ فِي اللَّحْدِ","","","","","Book of Funerals"
"5900","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، قَالَ : سَأَلْتُ الشَّعْبِيَّ عَنِ الْمَيِّتِ يُوَجَّهُ لِلْقِبْلَةِ ؟ قَالَ \"إِنْ شِئْتَ فَوَجِّهْ ، وَإِنْ شِئْتَ فَلا تُوَجِّهْ ، لَكِنِ اجْعَلِ الْقَبْرَ إِلَى الْقِبْلَةِ ، قَبْرُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَقَبْرُ عُمَرَ ، وَقَبْرُ أَبِي بَكْرٍ إِلَى الْقِبْلَةِ ""","","","","","Book of Funerals"
"5901","عَنِ ابْنِ جُرَيْجٍ ، عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ \" أَنَّ إِنْسَانًا حِينَ حَضَرَ ابْنَ الْمُسَيِّبِ الْمَوْتُ وَهُوَ مُسْتَلْقٍ ، قَالَ :احْرِفُوهُ ، قَالَ : أَوَلَسْتُ عَلَيْهَا ؟ يَعْنِي أَنَّهُ عَلَى الْقِبْلَةِ ، وَإِنْ لَمْ يَكُنْ مُسْتَقْبِلَهَا لأَنَّهُ مُسْلِمٌ ""","","","","","Book of Funerals"
"5902","عَنْ مَعْمَرٍ وَالثَّوْرِيِّ ، عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ \" أَنَّ رَجُلا دَخَلَ عَلَى ابْنِ الْمُسَيِّبِ وَهُوَ شَاكٍ مُسْتَلْقٍ ، فَقَالَ :وَجِّهُوهُ لِلْقِبْلَةِ ، فَغَضِبَ سَعِيدٌ ، وَقَالَ : أَوَلَسْتُ إِلَى الْقِبْلَةِ ؟ ""","","","","","Book of Funerals"
"5903","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ \" أَنَّ الْبَرَاءَ بْنَ مَعْرُورٍ الأَنْصَارِيَّ لَمَّا حَضَرَهُ الْمَوْتُ ، قَالَ لأَهْلِهِ وَهُوَ بِالْمَدِينَةِ :اسْتَقْبِلُوا بِيَ الْكَعْبَةَ ""","","","","","Book of Funerals"
"5904","عَنْ هِشَامِ بْنِ حَسَّانَ ، سَمِعْتُهُ أَوْ بَلَغَنِي عَنْهُ ، قَالَ : سَمِعْتُ الْحَسَنَ ، يَقُولُ : \" إِنَّالْمَلائِكَةَ وَجَّهُوا آدَمَ حِينَ حَضَرَهُ الْمَوْتُ ، ثُمَّ غَمَّضُوهُ ""","","","","","Book of Funerals"
"5905","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ أَبِي وَائِلٍ ، عَنْ أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"إِذَا حَضَرْتُمُ الْمَيِّتَ أَوِ الْمَرِيضَ ، فَقُولُوا خَيْرًا ، فَإِنَّ الْمَلائِكَةَ يُؤَمِّنُونَ عَلَى مَا تَقُولُونَ ""","","","","","Book of Funerals"
"5906","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ ، قَالَ : دَخَلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى أَبِي سَلَمَةَ وَهُوَ مَرِيضٌ ، وَوَافَقَ دُخُولَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خُرُوجُ نَفْسِهِ ، فَسَمِعَ بُكَاءً ، فَقَالَ : \"لا تَدْعُوا عَلَى أَنْفُسِكُمْ إِلا بِخَيْرٍ ، فَإِنَّ الْمَلائِكَةَ تَحْضُرُ الْمَيِّتَ \" ، أَوْ قَالَ : \" أَهْلَ الْبَيْتِ ، فَيُؤَمِّنُوا عَلَى دُعَائِهِمْ \" ، ثُمَّ قَالَ : \" اللَّهُمَّ اغْفِرْ لَهُ ذُنُوبَهُ ، وَأَفْسِحْ لَهُ فِي قَبْرِهِ ، وَأَعْظِمْ نُورَهُ ، وَأَضِئْ لَهُ فِي قَبْرِهِ ، اللَّهُمَّ ارْفَعْ دَرَجَةَ أَبِي سَلَمَةَ فِي الْمَهْدِيِّينَ ، وَاخْلُفْهُ فِي عَقِبِهِ فِي الْغَابِرِينَ ، وَاغْفِرْ لَهُ رَبَّ الْعَالَمِينَ \" ، ثُمَّ قَالَ : \" إِنَّ الْبَصَرَ شَخَصٌ لِلرُّوحِ ، أَلَمْ تَرَوْا إِلَى شُخُوصِ عَيْنَيْهِ ؟ ""","","","","","Book of Funerals"
"5907","عَنِ الثَّوْرِيِّ ، عَنْ مُحَمَّدِ بْنِ قَيْسٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِي مُوسَى الأَشْعَرِيِّ ، قَالَ : \"إِذَا عَايَنَ الْمَرِيضُ الْمَلَكَ ذَهَبَتِ الْمَعْرِفَةُ، يَعْنِي مَعْرِفَةَ النَّاسِ ""","","","","","Book of Funerals"
"5908","عَنِ ابْنِ جُرَيْجٍ ، عَنِ الْعَلاءِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : أَخْبَرَنِي أَبِي ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ ، يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"أَلَمْ تَرَوُا الإِنْسَانَ إِذَا شَخَصَ ببَصَرِهِ ؟ \" ، قَالُوا : بَلَى ، قَالَ : \" فَذَلِكَ حِينَ يَتَّبِعُ بَصَرُهُ نَفْسَهُ ""","","","","","Book of Funerals"
"5909","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، قَالَ \" سُئِلَ الشَّعْبِيُّ عَنِالسَّيْفِ يُوضَعُ عَلَى بَطْنِ الْمَيِّتِ ، قَالَ : إِنَّمَا يُفْعَلُ لِئَلا يَنْتَفِخَ ، وَلا يَضُرُّكَ ، أَفَعَلْتَ أَمْ لا ، وَسُئِلَ عَنِ الْحِذَاءِ يُدْخَلُ بِهِ الْقَبْرَ ، قَالَ : إِنَّمَا يُكْرَهُ كَرَاهِيَةَ الزَّلَقِ \"، قَالَ عَبْدُ الرَّزَّاقِ : مَا أُحِبُّ أَنْ تَدْخُلَ بِالْحِذَاءِ الْقَبْرَ ، وَبِهِ نَأْخُذُ","","","","","Book of Funerals"
"5910","عَنْ مَالِكٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِيهِ \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، كَانَيُعَزِّي الْمُسْلِمِينَ فِي مَصَايِبِهِمْ ""","","","","","Book of Funerals"
"5911","عَنِ ابْنِ التَّيْمِيِّ ، عَنِ الْحَجَّاجِ ، قَالَ : حَدَّثَنِي أَبُو عَمْرَةَ ، شَيْخٌ مِنْ بَنِي تَمِيمٍ ، قَالَ : يُقَالُ \"مُعَزِّي الْمَصَائِبِ يُكْسَى رِدَاءً مِنْ إِيمَانٍ يَكُونُ لَهُ سِتْرًا مِنَ النَّارِ ""","","","","","Book of Funerals"
"5912","عَنْ عَبْدِ الرَّحْمَنِ بْنِ عُمَرَ ، قَالَ : حَدَّثَنِي عُثْمَانُ بْنُ الأَسْوَدِ أَنَّ أُمَيَّةَ بْنَ صَفْوَانَ ، أَخْبَرَهُ أَنَّهُ وَجَدَ صِحِيفَةً مَرْبُوطَةً بِقِرَابِ صَفْوَانَ أَوْ بِسَيْفِهِ ، وَإِذَا فِيهَا : هَذَا مَا سَأَلَ إِبْرَاهِيمُ رَبَّهُ : \" أَيْ رَبِّ ،مَا جَزَاءُ مَنْ يَبُلُّ الدَّمْعُ وَجْهَهُ مِنْ خَشْيَتِكَ ؟ قَالَ : صَلَوَاتِي ، فَقَالَ : فَمَا جَزَاءُ مَنْ يُصَبِّرُ الْحَزِينَ ابْتِغَاءً لِوَجْهِكَ ؟ قَالَ : أَكْسُوهُ ثِيَابًا مِنَ الإِيمَانِ يَتَبَوَّأُ بِهَا الْجَنَّةَ وَيَتَّقِي بِهَا النَّارَ ، قَالَ : فَمَا جَزَاءُ مَنْ يَسُدُّ الأَرْمَلَةَ ابْتِغَاءَ وَجْهِكَ ؟ قَالَ : وَمَا يَسُدُّ ؟ قَالَ : يَرْوِيهَا أُقِيمُهُ فِي ظِلِّي وَأُدْخِلُهُ جَنَّتِي ، قَالَ : فَمَا جَزَاءُ مَنْ تَبِعَ الْجِنَازَةَ ابْتِغَاءَ وَجْهِكَ ؟ قَالَ : يُصَلِّي مَلائِكَتِي عَلَى جَسَدِهِ وَيُشَيِّعُ رُوحَهُ ، قَالَ : وَكَانَ فِيهِ عِيَادَةُ الْمَرِيضِ فَنَسِيتُهَا \"، قَالَ : فَأَتَى يَحْيَى بْنُ جَعْدَةَ فَأَخَذَهَا مِنِّي","","","","","Book of Funerals"
"5913","عَنْ رَجُلٍ ، عَنْ طَلْحَةَ بْنِ عُبَيْدِ اللَّهِ بْنِ كَرِيرٍ ، عَنْ أَبِي عَبْدِ اللَّهِ السُّلَمِيِّ ، عَنْ عُلَمَائِهِمْ ، قَالَ \"مَنْ عَزَّى مُؤْمِنًا بِمُصِيبَةٍ دَخَلَتْ عَلَيْهِ ، كَسَاهُ اللَّهُ يَوْمَ الْقِيَامَةِ رِدَاءً يُحَبَّرُ بِهِ \"، قُلْنَا لِعَبْدِ الرَّزَّاقِ : وَكَيْفَ يُعَزَّى ؟ قَالَ : بَلَغَنِي أَنَّ الْحَسَنَ مَرَّ بِأَهْلِ مَيِّتٍ ، فَوَقَفَ عَلَيْهِمْ ، فَقَالَ : أَعْظَمَ اللَّهُ أَجْرَكُمْ ، وَغَفَرَ اللَّهُ لِصَاحِبِكُمْ ، ثُمَّ مَضَى وَلَمْ يَقْعُدْ ، قُلْنَا لَهُ : مَنْ يُعَزَّى ؟ قَالَ : يُعَزَّى كُلُّ حَزِينٍ ، فَقَدْ يَكُونُ الرَّجُلُ حَزِينًا لِصَاحِبِهِ ، وَأَخِيهِ أشَدَّ مِنْ حُزْنِ أَهْلِهِ عَلَيْهِ","","","","","Book of Funerals"
"5914","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ \"يُغَسَّلُ الْمَيِّتُ وِتْرًا ، ثَلاثًا ، أَوْ خَمْسًا ، أَوْ سَبْعًا ، كُلُّهُنَّ بِمَاءٍ وَسِدْرٍ فِي كُلِّ غَسْلَةٍ يُغْسَلُ رَأْسُهُ مَعَ سَائِرِ جَسَدِهِ \"، قَالَ : قُلْتُ : وَتُجْزِئُ وَاحِدَةٌ ؟ قَالَ : \" نَعَمْ ، إِنْ أَنْقَوْهُ ""","","","","","Book of Funerals"
"5915","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ \"يُغَسَّلُ الْمَيِّتُ وِتْرًا ""","","","","","Book of Funerals"
"5916","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ عَلِيِّ بْنِ الْحُسَيْنِ ، يُخْبِرُنَا ، قَالَ : \"غُسِّلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي قَمِيصٍ ، وَغُسِّلَ ثَلاثًا ، كُلُّهُنَّ بِمَاءٍ وَسِدْرٍ ، وَوَلِيَ عَلِيٌّ سَفْلَتَهُ ، وَالْفَضْلُ بْنُ عَبَّاسٍ ، يَحْتَضِنُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَالْعَبَّاسُ يَصُبُّ الْمَاءَ ، قَالَ : وَعَلِيٌّ يَغْسِلُ سَفْلَتَهُ ، وَيَقُولُ الْفَضْلُ لِعَلِيٍّ : أَرِحْنِي أَرِحْنِي ، قَطَعْتَ وَتِينِي ، إِنِّي لأَجِدُ شَيْئًا يَتَنَزَّلُ عَلَيَّ ، قَطَعْتَ وَتِينِي ، قَالَ : وَغُسِّلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ بِئْرٍ لِسَعْدِ بْنِ خُثَيْمَةَ ، يُقَالُ لَهَا : الْغَرْسُ بِقِبَا ، قَالَ : وَكَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لا يَغْسِلُ رَأْسَهُ إِلا بِسِدْرٍ، وَبِهِ نَأْخُذُ ، قَالَ : قُلْتُ لِعَبْدِ الرَّزَّاقِ : يُبْدَأُ بِالرَّأْسِ أَوْ بِاللِّحْيَةِ ؟ قَالَ : السُّنَّةُ لا شَكَّ ، يُبْدَأُ بِالرَّأْسِ ثُمَّ اللِّحْيَةِ ""","","","","","Book of Funerals"
"5917","أَخْبَرَنِي حُمَيْدٌ ، أَنَّ مَعْمَرًا أَخْبَرَهُ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ ، قَالَ : \"يُبْدَأُ بِالرَّأْسِ ، ثُمَّ اللِّحْيَةِ ، ثُمَّ الْمَيَامِنِ ، يَعْنِي غُسِّلَ ثَلاثَ مَرَّاتٍ بِمَاءٍ وَسِدْرٍ ثُمَّ بِمَاءٍ ، فَهِيَ وَاحِدَةٌ ، كُلُّ غَسْلَةٍ بِمَاءٍ وَسِدْرٍ ثُمَّ بِمَاءٍ ، فَهِيَ وَاحِدَةٌ ""","","","","","Book of Funerals"
"5918","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ :إِنْ كَانَ ذَا ضَفِيرَتَيْنِ مَضْفُورَتَيْنِ ؟ قَالَ \" تُنْشَرَانِ وَتُغْسَلانِ \" ، قُلْتُ : أَرَأَيْتَ السِّدْرَ لا بُدَّ مِنْهُ ؟ قَالَ : \" إِنَّكَ لَتُوجِبُ ، أَمَّا السِّدْرُ فَطَهُورٌ \" ، قُلْتُ : فَلَمْ يُوجَدْ سِدْرٌ فَيُؤْخَذُ خِطْمِيٌّ ؟ قَالَ : \" لا ، سَيُوجَدُ السِّدْرُ ""","","","","","Book of Funerals"
"5919","عَنِ ابْنِ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى ، قَالَ \"غُسْلُ الْمُتَوَفَّى ثَلاثُ مَرَّاتٍ ، فَمَنْ غَسَّلَ مَيِّتًا ، فَلْيُلْقِ عَلَى وَجْهِهِ ثَوْبًا ، ثُمَّ لِيَبْدَأْ فَلْيُوَضِّئْهُ وَلْيَغْسِلْ رَأْسَهُ ، فَإِذَا أَرَادَ أَنْ يَغْسِلَ مَذَاكِيرَهُ فَلا يُفْضِ إِلَيْهَا ، وَلَكِنْ لِيَأْخُذْ خِرْقَةً فَلْيُلْقِهَا عَلَى يَدِهِ ، ثُمَّ لِيُدْخِلْ يَدَهُ مِنْ تَحْتِ الثَّوْبِ ، وَلْيَمْسَحْ بَطْنَهُ ، حَتَّى يُخْرِجَ مِنْهُ الأَذَى ""","","","","","Book of Funerals"
"5920","عَنِ الثَّوْرِيِّ ، عَنِ الزُّبَيْرِ بْنِ عَدِيٍّ ، عَنْ إِبْرَاهِيمَ ، قَالَ فِي غُسْلِ الْمَيِّتِ \"الأُولَى بِمَاءٍ قَرَاحٍ ، وَيُوَضِّئُهُ وُضُوءَهُ لِلصَّلاةِ ، وَالثَّانِيَةُ بِمَاءٍ وَسِدْرٍ ، وَالثَّالِثَةُ بِمَاءٍ قَرَاحٍ ، وَيَتَتَبَّعْ مَسَاجِدَهُ بِالطِّيبِ ""","","","","","Book of Funerals"
"5921","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، قَالَ \" رَأَيْتُهُيُغَسِّلُ مَيِّتًا ، فَأَلْقَى عَلَى فَرْجِهِ خِرْقَةً ، وَعَلَى وَجْهِهِ خِرْقَةً أُخْرَى ، وَوَضَّأَهُ وُضُوءَ الصَّلاةِ ، ثُمَّ بَدَأَ بِمَيَامِنِهِ \"، قَالَ عَبْدُ الرَّزَّاقِ ، قَالَ مَعْمَرٌ : وَكَانَ قَتَادَةُ ، يَقُولُ : يَبْدَأُ بِمَيَامِنِهِ ، قَالَ : \" فَإِذَا أَرَادَ أَنْ يُؤَضِّئَهُ نَزَعَ الَّتِي عَلَى وَجْهِهِ ، فَأَمَّا الَّتِي عَلَى فَرْجِهِ فَلا يُحَرِّكْهَا ، وَلَكِنَّهُ يَضَعُ عَلَى يَدِهِ خِرْقَةً ، ثُمَّ يُدْخِلُهَا تَحْتَ الْخِرْقَةِ \" ، قَالَ عَبْدُ الرَّزَّاقِ : قَالَ مَعْمَرٌ : قَالَ أَيُّوبُ : \" وَإِذَا لَمْ يَجِدُوا سِدْرًا ، غَسَّلُوهُ بِالأُشْنَانِ إِذَا طَالَ مَرَضُهُ وَكَثُرَ ""","","","","","Book of Funerals"
"5922","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ ، قَالَ \"إِذَا طَالَ ضَنَى الْمَيِّتِ ، غُسِّلِ بِالأُشْنَانِ إِنْ شَاءُوا ""","","","","","Book of Funerals"
"5923","عَنِ الثَّوْرِيِّ ، وَمَعْمَرٍ ، عَنْ مَنْصُورٍ ، قَالَ : \" كَانَعَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَمِيصٌ فَنُودُوا أَنْ لا تَنْزِعُوهُ ""","","","","","Book of Funerals"
"5924","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ أَنَّهُ قَالَ : \" كَانَيُكْرَهُ أَنْ يُغَسَّلَ الْمَيِّتُ ، وَمَا بَيْنَهُ وَبَيْنَ السَّمَاءِ فَضَاءٌ ، حَتَّى يَكُونَ بَيْنَهَا وَبَيْنَهُ سِتْرٌ ""","","","","","Book of Funerals"
"5925","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ :أَيُكْرَهُ غَسْلُهُ عُرْيَانًا ؟ قَالَ \" لِمَ يُغَسَّلُ عُرْيَانٌ ؟ \" ، قُلْتُ : فَجُعِلَ عَلَيْهِ ثَوْبٌ مِمَّنْ عَلَيْهِ لا يُمَسُّ الثَّوْبُ ، وَيُغَسَّلُ مِنْ تَحْتِهِ، قَالَ : \" حَسْبُهُ ، وَقَدْ وُورِيَ حِينَئِذٍ ""","","","","","Book of Funerals"
"5926","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : حُدِّثْتُ ، عَنْ أُبَيِّ بْنِ كَعْبٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" كَانَآدَمُ رَجُلا أَشْعَرَ ، طُوَالا ، آدَمَ ، كَأَنَّهُ نَخْلَةٌ سَحُوقٌ ، وَإِنَّهُ لَمَّا حَضَرَهُ الْوَفَاةُ ، نَزَلَتِ الْمَلائِكَةُ بِحَنُوطِهِ وَكَفَنِهِ مِنَ الْجَنَّةِ ، فَلَمَّا مَاتَ غَسَّلُوهُ بِالْمَاءِ وَالسِّدْرِ ثَلاثًا ، وَجَعَلُوا فِي الثَّالِثَةِ كَافُورًا ، وَكَفَّنُوهُ فِي وِتْرِ ثِيَابٍ ، وَحَفَرُوا لَهُ لَحْدًا وَصَلَّوْا عَلَيْهِ \" ، وَقَالُوا : هَذِهِ سُنَّةُ وَلَدِ آدَمَ مِنْ بَعْدِهِ","","","","","Book of Funerals"
"5927","عَنِ ابْنِ جُرَيْجٍ ، عَنْ صَالِحٍ مَوْلَى التَّوْأَمةِ ، أَنَّهُ سَمِعَ ابْنَ عَبَّاسٍ ، يَقُولُ : \"غُسِّلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي قَمِيصٍ ، وَنَزَلَ فِي حُفْرَتِهِ عَلِيٌّ ، وَالْفَضْلُ بْنُ عَبَّاسٍ ، وَصَالِحُ بْنُ سَعْدَانَ ، مَوْلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","Book of Funerals"
"5928","عَنْ مَعْمَرٍ ، عَنْ ثَابِتٍ الْبُنَانِيِّ ، قَالَ \"نَزَلَتِ الْمَلائِكَةُ حِينَ حَضَرَ آدَمَ الْوَفَاةُ ، فَلَمَّا رَآهُمْ عَرَفَهُمْ ، فَقَبَضُوهُ ، وَغَسَّلُوهُ ، وَكَفَّنُوهُ ، وَصَلَّوْا عَلَيْهِ ، وَدَفَنُوهُ ، وَبَنُوهُ يَنْظُرُونَ ""","","","","","Book of Funerals"
"5929","وَقَالَ مَعْمَرٌ سَمِعْتُ غَيْرَ ثَابِتٍ ، يَقُولُ : \"هَذِهَ سُنَّةُ وَلَدِكَ ""","","","","","Book of Funerals"
"5930","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ فِي الْمَيِّتِ يُغْسَلُ ، قَالَ \"يُوضَعُ خِرْقَةٌ عَلَى وَجْهِهِ ، وَأُخْرَى عَلَى فَرْجِهِ ، فَإِذَا أَرَادَ أَنْ يُوَضِّئَهُ كَشَفَ الْخِرْقَةَ الَّتِي عَلَى وَجْهِهِ ، فَيُوَضِّئُهُ بِالْمَاءِ وُضُوءَهُ لِلصَّلَاةِ ، ثُمَّ يُغَسِّلُهُ بِالْمَاءِ وَالسِّدْرِ مَرَّتَيْنِ مِنْ رَأْسِهِ إِلَى قَدَمِهِ ، يَبْدَأُ بِمَيَامِنِهِ ، وَلا يَكْشِفُ الْخِرْقَةَ الَّتِي عَلَى فَرْجِهِ ، وَلَكِنَّهُ يَلُفُّ عَلَى يَدِهِ خِرْقَةً إِذَا أَرَادَ أَنْ يَغْسِلَ فَرْجَهُ ، فَيَغْسِلَ مَا تَحْتَ الْخِرْقَةِ الَّتِي عَلَى فَرْجِهِ بِمَاءٍ فِيهِ كَافُورٌ ، وَالْمَرْأَةُ كَذَلِكَ ، يَبْدَأُ بِلِحْيَةِ الْمَيِّتِ قَبْلَ رَأْسِهِ ""","","","","","Book of Funerals"
"5931","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، قَالَ \" رَأَيْتُهُغَسَّلَ مَيِّتًا فَجَفَّفَ رَأْسَهُ بِالْجمرِ ""","","","","","Book of Funerals"
"5932","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ أُمِّ عَطِيَّةَ ، قَالَتْ :تُوُفِّيَتْ بِنْتُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : \" اغْسِلْنَهَا ثَلاثًا ، أَوْ خَمْسًا ، أَوْ أَكَثْرَ مِنْ ذَلِكَ إِنْ رَأَيْتُنَّ ، وَاغْسِلْنَهَا بِمَاءٍ وَسِدْرٍ ، اجْعَلْنَ فِي الآخِرَةِ شَيْئًا مِنْ كَافُورٍ ، فَإِذَا فَرَغْتُنَّ فَآذِنَّنِي \" ، قَالَتْ : فَلَمَّا فَرَغْنَا آذَنَّاهُ ، فَأَلْقَى إِلَيْنَا حَقْوَةً ، فَقَالَ : \" أَشْعِرْنَهَا إِيَّاهُ \" ، قَالَتْ : جَعَلْنَا رَأْسَهَا ثَلاثَةَ قُرُونٍ ، وَأَرْسَلْنَاهُنَّ مِنْ خَلْفِهَا الْحَقْوُ إِزَارٌ غَلِيظٌ \"، عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنْ حَفْصَةَ بِنْتِ سِيرِينَ ، عَنْ أُمِّ عَطِيَّةَ الأَنْصَارِيَّةَ ، قَالَتْ : تُوُفِّيَتْ بِنْتُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ ذَكَرَ نَحْوَهُ عَنِ الثَّوْرِيِّ ، عَنْ هِشَامٍ ، عَنْ حَفْصَةَ ، عَنْ أُمِّ عَطِيَّةَ مِثْلَهُ","","","","","Book of Funerals"
"5933","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ \"الْمَرْأَةُ تُنْشَرُ رَأْسُهَا ، فَيُغْسَلُ مَعَهَا مَنْشُورًا مِنْ أَجْلِ الْغُسْلِ الَّذِي فِيهِ ؟ قَالَ : نَعَمْ ""","","","","","Book of Funerals"
"5934","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي أَيُّوبُ السِّخْتِيَانِيُّ ، أَنَّهُ سَمِعَ ابْنَ سِيرِينَ ، يَقُولُ : كَانَتِامْرَأَةٌ مِنَ الأَنْصَارِ ، يُقَالُ لَهَا : أُمُّ عَطِيَّةَ مِنَ اللاتِي بَايَعْنَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَدِمَتِ الْبَصْرَةَ تُبَادِرُ ابْنًا لَهَا ، فَلَمْ تُدْرِكْهُ، فَحَدَّثَتْنَا ثُمَّ ذَكَرَ نَحْوَ حَدِيثِ مَعْمَرٍ ، قَالَ ابْنُ جُرَيْجٍ : قُلْتُ لأَيُّوبَ : مَا قَوْلُهُ : \" أَشْعِرْنَهَا \" ، أَتُؤَزَّرُ بِهِ ؟ قَالَ : لا أُرَاهُ إِلا قَالَ : \" أَلْفِفْنَهَا فِيهِ \" ، قَالَ : \" وَكَذَلِكَ كَانَ ابْنُ سِيرِينَ يَأْمُرُ الْمَرْأَةَ أَنْ تُشْعِرَ لُفَافَةً وَلا تُؤَزِّرَ ""","","","","","Book of Funerals"
"5935","قَالَ ابْنُ جُرَيْجٍ : قَالَ أَيُّوبُ : سَمِعْتُ حَفْصَةَ بِنْتَ سِيرِينَ ، تَقُولُ : حَدَّثَتْنَا أُمُّ عَطِيَّةَ \" أَنَّهُنَّجَعَلْنَ رَأْسَ بِنْتِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ثَلاثَ قُرُونٍ \" ، قَالَتْ : \" نَقَضْنَهُ فَغَسَلْنَهُ فَجَعَلْنَهُ ثَلاثَ قُرُونٍ \"، قَالَ : نَعَمْ ، أَشْعَرْنَهَا فَوَضَعُوهُ مِمَّا يَلِي جَسَدَهَا","","","","","Book of Funerals"
"5936","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ ، قَالَ :الْتَمَسَ عَلِيٌّ مِنَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَا يُلْتَمَسُ مِنَ الْمَيِّتِ ، فَلَمْ يَجِدْ شَيْئًا ، فَقَالَ : \" بِأَبِي وَأُمِّي طَيِّبًا حَيًّا ، وَطَيِّبًا مَيِّتًا ""","","","","","Book of Funerals"
"5937","أَخْبَرَنَا ، عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ \"يُغَسَّلُ الْمَيِّتُ ثَلاثًا ، فَإِنْ خَرَجَ مِنْهُ شَيْءٌ بَعْدَ الثَّلاثِ غَسَّلُوهُ خَمْسًا ، فَإِنْ خَرَجَ مِنْهُ شَيْءٌ غُسِّلَ سَبْعًا \"، عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنِ ابْنِ سِيرِينَ مِثْلَهُ ، قَالَ هِشَامٌ : وَقَالَ الْحَسَنُ : \" يُغَسَّلُ ثَلاثًا ، فَإِنْ خَرَجَ شَيْءٌ ، غُسِلَ مَا خَرَجَ ، وَلَمْ يَزِدْ عَلَى الثَّلاثِ ""","","","","","Book of Funerals"
"5938","عَنِ ابْنِ جُرَيْجٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"مَنْ غَسَّلَ مَيِّتًا خَرَجَ مِنْ خَطِيئَتِهِ مِثْلَ يَوْمِ وَلَدَتْهُ أُمُّهُ \"، قَالَ ابْنُ جُرَيْجٍ : وَبَلَغَنِي ، عَنِ الشَّعْبِيِّ ، مِثْلَ ذَلِكَ إِلا أَنَّهُ زَادَ فِي قَوْلِهِ : \" مَنْ غَسَّلَ مَيِّتًا ثُمَّ لَمْ يُغْشِ عَلَيْهِ \" ، كُلُّ ذَلِكَ مِنَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَنْ غَسَّلَ مَيِّتًا ، خَرَجَ مِنْ خَطَايَاهُ كَيَوْمِ وَلَدَتْهُ أُمُّهُ ""","","","","","Book of Funerals"
"5939","عَنْ مَعْمَرٍ ، عَنْ لَيْثٍ ، عَنْ رَجُلٍ ، عَنْ مُعَاذِ بْنِ جَبَلٍ ، قَالَ : \"مَنْ غَسَّلَ مَيِّتًا وَأَدَّى فِيهِ الأَمَانَةَ ، كَانَ مِنْ ذُنُوبِهِ كَيَوْمِ وَلَدَتْهُ أُمُّهُ ""","","","","","Book of Funerals"
"5940","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي مَنْصُورُ بْنُ عَبْدِ الرَّحْمَنِ ، أَنَّهُ سَمِعَ يُوسُفَ الَّذِي كَانَ يَهُودِيًّا فَأَسْلَمَ ، يَقُولُ : \"فِي التَّوْرَاةِ ، مَنْ كَفَّنَ مَيِّتًا ، كَمَنْ كَفَلَ صَغِيرًا حَتَّى صَارَ كَبِيرًا ""","","","","","Book of Funerals"
"5941","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورِ ابْنِ صَفِيَّةَ ، عَنْ يُوسُفَ ، رَجُلٍ كَانَ مَعَ ابْنِ الزُّبَيْرِ نَجِدُهُ فِي كِتَابِ اللَّهِ \"مَثَلُ الَّذِي يُكَفِّنُ الْمَيِّتَ ، كَالَّذِي كَفَلَهُ صَغِيرًا حَتَّى مَاتَ ""","","","","","Book of Funerals"
"5942","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ : سُئِلَ ابْنُ عَبَّاسٍ :\" أَعَلَى مَنْ غَسَّلَ مَيِّتًا غُسْلٌ ؟ قَالَ : \" لا ، قَدْ إِذَنْ نَجَّسُوا صَاحِبَهُمْ ، وَلَكِنْ وُضُوءٌ ""","","","","","Book of Funerals"
"5943","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، أَنَّهُ سُئِلَ هَلْ يَغْتَسِلُ مَنْ غَسَّلَ الْمَيِّتَ ؟ قَالَ : \"إِنْ كَانَ نَجِسًا فَاغْتَسِلُوا ، وَإِلا فَإِنَّمَا يَكْفِي أَحَدَكُمُ الْوُضُوءُ ""","","","","","Book of Funerals"
"5944","عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنْ بَكْرِ بْنِ عَبْدِ اللَّهِ الْمُزَنِيِّ ، قَالَ : أَخْبَرَنِي عَلْقَمَةُ الْمُزَنِيُّ ، قَالَ :غَسَّلَ أَبَاكَ أَرْبَعٌ مِنْ أَصْحَابِ الشَّجْرَةِ ، فَمَا زَادُوا عَلَى أَنِ احْتَجَزُوا عَلَى ثِيَابِهِمْ ، فَلَمَّا فَرَغُوا تَوضَّئُوا ، وَصَلَّوْا عَلَيْهِ","","","","","Book of Funerals"
"5945","قَالَ : وَسَمِعْتُ أَبَا الشَّعْثَاءِ ، يَقُولُ : \"أَلا تَتَّقُونَ اللَّهَ ، تَغْتَسِلُونَ مِنْ مَوْتَاكُمْ ، أَأَنْجَاسٌ هُمْ ؟ ! ""","","","","","Book of Funerals"
"5946","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ الْجُعْفِيِّ ، عَنِ الشَّعْبِيِّ ، عَنْ عَلْقَمَةَ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ :\" إِنْ كَانَ نَجِسًا ، فَاغْتَسِلُوا ""","","","","","Book of Funerals"
"5947","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ مَسْعُودٍ ، وَعَائِشَةَ كَانَالا يَرَيَانِ عَلَى مَنْ غَسَّلَ مَيِّتًا غُسْلا ، وَقَالا : \" إِنْ كَانَ صَاحِبُكُمْ نَجِسًا ، فَاغْتَسِلُوا ""","","","","","Book of Funerals"
"5948","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ : \" أَغْتَسِلُ مِنَ الْمَيِّتِ ؟ قَالَ \" أَمُؤْمِنٌ هُوَ ؟ \" ، قُلْتُ : أَرْجُو ، قَالَ :\" فَتَمْسَحُ مِنَ الْمُؤْمِنِ ، وَلا تَغْتَسِلُ مِنْهُ ""","","","","","Book of Funerals"
"5949","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : \"إِذَا غَسَّلْتَ الْمَيِّتَ فَأَصَابَكَ مِنْهُ أَذًى فَاغْتَسِلْ ، وَإِلا إِنَّمَا يَكْفِيكَ الْوُضُوءُ ""","","","","","Book of Funerals"
"5950","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِيٍّ ، قَالَ : \"مَنْ غَسَّلَ مَيِّتًا ، فَلْيَغْتَسِلْ \"، وَبِهِ نَأْخُذُ عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، عَنِ الْحَارِثِ ، عَنْ عَلِيٍّ مِثْلَهُ","","","","","Book of Funerals"
"5951","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ رَجُلٍ ، يُقَالُ لَهُ : إِسْحَاقُ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"مَنْ غَسَّلَ مَيِّتًا ، فَلْيَغْتَسِلْ \"، وَبِهِ نَأْخُذُ","","","","","Book of Funerals"
"5952","عَنْ غَيْرِهِ ، عَنْ سُهَيْلِ بْنِ أَبِي صَالِحٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"مَنْ غَسَّلَ مَيِّتًا فَلْيَغْتَسِلْ ""","","","","","Book of Funerals"
"5953","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ ، قَالَ \"مَنْ غَسَّلَ مَيِّتًا فَلْيَغْتَسِلْ ، وَمَنْ دَلاهُ فِي حُفْرَتِهِ فَلْيَتَوَضَّأْ ""","","","","","Book of Funerals"
"5954","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي ابْنُ شِهَابٍ ، قَالَ \"السُّنَّةُ أَنْ يَغْتَسِلَ الَّذِي يَغْسِلُ الْمَيِّتَ ""","","","","","Book of Funerals"
"5955","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ \" أَنَّ ابْنَ سِيرِينَ كَانَإِذَا غَسَّلَ مَيِّتًا ، اغْتَسَلَ ""","","","","","Book of Funerals"
"5956","أَخْبَرَنَا : عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، \" أَنَّ ابْنَ عُمَرَحَنَّطَ سَعِيدَ بْنَ زَيْدٍ ، ثُمَّ صَلَّى عَلَيْهِ ، وَحَمَلَهُ ، ثُمَّ دَخَلَ الْمَسْجِدَ يُصَلِّي ، وَلَمْ يَتَوَضَّأْ \"، وَبِهِ يَأْخُذُ عَبْدُ الرَّزَّاقِ","","","","","Book of Funerals"
"5957","عَنْ مَالِكٍ ، عَنْ نَافِعٍ ، \" أَنَّ ابْنَ عُمَرَحَنَّطَ سَعِيدَ بْنَ زَيْدٍ ، وَحَمَلَهُ ، ثُمَّ دَخَلَ الْمَسْجِدَ يُصَلِّي وَلَمْ يَتَوَضَّأْ ""","","","","","Book of Funerals"
"5958","أَخْبَرَنَا عَبْدُ الرَّزَّاقِ ، قَالَ : أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ أَبِي مُلَيْكَةَ ، \" أَنَّ امْرَأَةَ أَبِي بَكْرٍغَسَّلَتْهُ حِينَ تُوُفِّيَ \"أَوْصَى بِذَلِكَ . عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنِ ابْنِ أَبِي مُلَيْكَةَ مِثْلَهُ","","","","","Book of Funerals"
"5959","عَنِ الثَّوْرِيِّ ، عَنْ إِبْرَاهِيمَ النَّخَعِيِّ ، \" أَنَّأَبَا بَكْرٍ غَسَّلَتْهُ امْرَأَتُهُ أَسْمَاءُ ، وَأَنَّ أَبَا مُوسَى الأَشْعَرِيَّ غَسَّلَتْهُ امْرَأَتُهُ أُمُّ عَبْدِ اللَّهِ \"، قَالَ الثَّوْرِيُّ : وَنَقُولُ نَحْنُ : \" لا يُغَسِّلُ الرَّجُلُ امْرَأَتَهُ ، لأَنَّهَا لَوْ شَاءَ تَزَوَّجَ أُخْتَهَا ، حِينَ مَاتَتْ \" ، وَنَقُولُ : \" تُغَسِّلُ الْمَرْأَةُ زَوْجَهَا ، لأَنَّهَا فِي عِدَّةٍ مِنْهُ ""","","","","","Book of Funerals"
"5960","أَخْبَرَنَا عَنِ الثَّوْرِيِّ ، قَالَ : سَمِعْتُ حَمَّادًا \"إِذَا مَاتَتِ الْمَرْأَةُ مَعَ الْقَوْمِ ، فَالْمَرْأَةُ تُغَسِّلُ زَوْجَهَا ، وَالرَّجُلُ امْرَأَتَهُ ""","","","","","Book of Funerals"
"5961","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ أَبِي الشَّعْثَاءِ ، قَالَ : \"الرَّجُلُ أَحَقُّ أَنْ يُغَسِّلَ امْرَأَتَهُ ، مِنْ أَخِيهَا ""","","","","","Book of Funerals"
"5962","عَنْ رَجُلٍ مِنْ أَسْلَمَ ، عَنْ دَاوُدِ بْنِ الْحُصَيْنِ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : \"أَحَقُّ النَّاسِ بغُسْلِ الْمَرْأَةِ وَالصَّلاةِ عَلَيْهَا زَوْجُهَا ""","","","","","Book of Funerals"
"5963","وَأَخْبَرَنِي عُمَارَةُ بْنُ مُهَاجِرٍ ، عَنْ أُمِّ جَعْفَرِ بِنْتِ مُحَمَّدٍ ، عَنْ جَدَّتِهَا أَسْمَاءَ بِنْتِ عُمَيْسٍ ، قَالَتْ : \"أَوْصَتْ فَاطِمَةُ إِذَا مَاتَتْ ، أَنْ لا يُغَسِّلَهَا إِلا أَنَا وَعَلِيٌّ، قَالَتْ : فغَسَّلْتُهَا أَنَا وَعَلِيٌّ ""","","","","","Book of Funerals"
"5964","عَنْ مَالِكٍ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ ، أَنَّ أَسْمَاءَ بِنْتَ عُمَيْسٍ امْرَأَةَ أَبِي بَكْرٍغَسَّلَتْهُ حِينَ تُوُفِّيَ ، ثُمَّ خَرَجَتْ ، فَسَأَلَتْ مَنْ بِحَضْرَتِهَا مِنَ الْمُهَاجِرِينَ ، فَقَالَتْ : \" إِنِّي صَائِمَةٌ ، وَإِنَّ هَذَا لَيَوْمٌ شَدِيدُ الْبَرْدِ ، فَهَلْ عَلَيَّ مِنْ غُسْلٍ ؟ \" قَالَ : \" لا ""","","","","","Book of Funerals"
"5965","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرٍو ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، عَنْ أَبِي بَكْرِ بْنِ حَفْصِ بْنِ سَعْدٍ ، قَالَ : \"أَمَرَ أَبُو بَكْرٍ امْرَأَتَهُ أَسْمَاءَ أَنْ تُغَسِّلَهُ وَكَانَتْ صَائِمَةً ، فَعَزَمَ عَلَيْهَا لِتُفْطِرَ ، فَدَعَتْ بِمَاءٍ قَبْلَ غُرُوبِ الشَّمْسِ ، فَشَرِبَتْ ، وَقَالَتْ : لا أُتْبِعُهُ الْيَوْمَ إِثْمًا فِي قَبْرِهِ ""","","","","","Book of Funerals"
"5966","أُخْبِرْنَا عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنِ الْحَسَنِ ، قَالَ : \"إِذَا مَاتَتِ الْمَرْأَةُ ، وَلَمْ يَجِدُوا امْرَأَةً تَغُسِّلُهَا ، غَسَّلَهَا زَوْجُهَا أَوِ ابْنُهَا ، وَإِنْ وَجَدُوا يَهُودِيَّةً ، أَوْ نَصْرَانِيَّةً ، غَسَّلَتْهَا ""","","","","","Book of Funerals"
"5967","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، قَالَ : أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ مُحَمَّدِ بْنِ عَقِيلِ بْنِ أَبِي طَالِبٍ ، \" أَنَّفَاطِمَةَ لَمَّا حَضَرَتْهَا الْوَفَاةُ ، أَمَرَتْ عَلِيًّا فَوَضَعَ لَهَا غُسْلا ، فَاغْتَسَلَتْ ، وَتَطَهَّرَتْ ، وَدَعَتْ ثِيَابَ أَكْفَانِهَا ، فَأُتِيَتْ بِثِيَابٍ غِلاظٍ فَلَبِسَتْهَا ، وَمَسَّتْ مِنَ الْحَنُوطِ ، ثُمَّ أَمَرَتْ عَلِيًّا أَنْ لا تُكْشَفَ إِذَا قَضَتْ ، وَأَنْ تُدْرَجَ كَمَا هِيَ فِي ثِيَابِهَا \"، قَالَ : فَقُلْتُ لَهُ : \" هَلْ عَلِمْتَ أَحَدًا فَعَلَ ذَلِكَ ؟ \" ، قَالَ : \" نَعَمْ ، كَثِيرُ بْنُ عَبَّاسٍ ، وَكَتَبَ فِي أَطْرَافِ أَكْفَانِهِ : شَهِدَ كَثِيرُ بْنُ عَبَّاسٍ أَنْ لا إِلَهَ إِلا اللَّهُ ""","","","","","Book of Funerals"
"5968","عَنْ مَعْمَرٍ ، قَالَ : سَأَلْتُ حَمَّادًا عَنِالرَّجُلِ يَمُوتُ بِأَرْضٍ فَلاةٍ ، قَالَ \" يُيَمَّمُ ، وَيُمْسَحُ وَجْهُهُ بِالصَّعِيدِ \"، قَالَهُ مَعْمَرٌ ، قَالَهُ حَمَّادٌ","","","","","Book of Funerals"
"5969","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ أَنَّ جَارِيَةً لِصَفِيَّةَ بِنْتِ أَبِي عُبَيْدٍ مَرِضَتْ مَعَهُمْ فِي سَفَرٍ ، فَقَالَ لَهَا نَافِعٌ : مَرِضَتْ وَلِيدَتُكِ مَعَنَا ، فَقَالَتْ صَفِيَّةُ \"أَرَأَيْتَ لَوْ مَاتَتْ ، كَيْفَ إِذًا صَنَعْتُمْ بِهَا ؟ \" ، قُلْتُ : لا أَدْرِي ، قَالَتْ : \" تُدْفَنُ كَمَا هِيَ \"، عَنْ مَعْمَرٍ ، عَمَّنْ سَمِعَ الْحَسَنَ ، قَالَ : تُدْفَنُ كَمَا هِيَ عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ : تُدْفَنُ كَمَا هِيَ","","","","","Book of Funerals"
"5970","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ ، قَالا : \"تُغَسَّلُ ، وَعَلَيْهَا الثِّيَابُ ""","","","","","Book of Funerals"
"5971","عَنْ مَعْمَرٍ وَالثَّوْرِيِّ ، عَنْ حَمَّادٍ ، قَالَ \"إِذَا مَاتَ الرَّجُلُ مَعَ النِّسَاءِ ، لَيْسَ فِيهِنَّ رَجُلٌ ، فَإِنَّهُ يُيَمَّمُ \"، وَبِهِ نَأْخُذُ عَنْ عُثْمَانَ بْنِ مَطَرٍ ، عَنْ سَعِيدٍ ، عَنْ أَبِي مَعْشَرٍ ، عَنْ إِبْرَاهِيمَ ، مِثْلَ قَوْلِ حَمَّادٍ : \" يُيَمَّمُ \" ، عَنْ عُثْمَانَ بْنِ مَطَرٍ ، عَنْ سَعِيدٍ ، عَنْ أَبِي مَعْشَرٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ : \" يُيَمَّمُ ""","","","","","Book of Funerals"
"5972","عَنْ أَبِي بَكْرِ بْنِ عَيَّاشٍ ، عَنْ مُحَمَّدٍ الزُّهْرِيِّ ، عَنْ مَكْحُولٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"إِذَا مَاتَ الرَّجُلُ مَعَ النِّسَاءِ ، وَالْمَرْأَةُ مَعَ الرِّجَالِ ، فَإِنَّهُمَا يُيَمَّمَانِ وَيُدْفَنَانِ ، وَهُمَا بِمَنْزِلَةِ مَنْ لَمْ يَجِدِ الْمَاءَ \"، وَبِهِ نَأْخُذُ","","","","","Book of Funerals"
"5973","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي ابْنُ أَبِي مُلَيْكَةَ ، عَنْ عَائِشَةَ ، قَالَتْ : \"إِذَا غَيَّبَنِي أَبُو عَمْرٍو ، وَدَلانِي فِي حُفْرَتِي فَهُوَ حُرٌّ ""","","","","","Book of Funerals"
"5974","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : حُدِّثْتُ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَحِينَ تُوُفِّيَتِ ابْنَتُهُ ، قَالَ : \" لِيَدْخُلِ الْقَبْرَ رَجُلانِ ، لَمْ يُقَارِفَا الْبَارِحةَ \" ، أَيْ لَمْ يَغْشَيَا النِّسَاءَ ، قَالَ : فَدَخَلَ رَجُلانِ أَحَدُهُمَا طَلْحَةُ بْنُ عَبْدِ اللَّهِ ، فَلَمَّا خَرَجَا مِنَ الْقَبْرِ ، قَالَ : \" الْحَقِي بِسَلَفِنَا عُثْمَانَ \"، قَالَ : زَعَمُوا أَنَّهَا امْرَأَةُ عُثْمَانَ بْنِ عَفَّانَ","","","","","Book of Funerals"
"5975","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ \" أَنَّ ابْنَ سِيرِينَ ، كَانَيُطَيِّبُ الْمَيِّتَ بِالسُّكِّ فِيهِ الْمِسْكُ ""","","","","","Book of Funerals"
"5976","عَنِ الثَّوْرِيِّ ، عَنْ سُلَيْمَانَ التَّيْمِيِّ ، وَخَالِدٍ الْحَذَّاءِ ، عَنِ ابْنِ سِيرِينَ ، قَالَ : سُئِلَ ابْنُ عُمَرَ عَنِالْمِسْكِ لِلْمَيِّتِ ، فَقَالَ \" أَوَلَيْسَ مِنْ أَطْيَبِ طِيبِكُمْ ؟ ""","","","","","Book of Funerals"
"5977","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ \" أَنَّهُ كَانَيُطَيِّبُ الْمَيِّتَ بِالْمِسْكِ ، يَذُرُّ عَلَيْهِ ذَرُورًا ""","","","","","Book of Funerals"
"5978","عَنْ مَعْمَرٍ ، عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ ، عَنْ نَافِعٍ ، قَالَ : \" كَانَ ابْنُ عُمَرَيَتَّبِعُ مَغَابِنَ الْمَيِّتِ ، وَمَرَافِقَهُ بِالْمِسْكِ ""","","","","","Book of Funerals"
"5979","عَنْ مَعْمَرٍ ، عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَطَاءِ بْنِ السَّائِبِ ، عَنِ الشَّعْبِيِّ ، قَالَ : كَانَ سَلْمَانُأَصَابَ مِسْكًا مِنْ بَلَنْجَرَ ، فَأَعْطَاهُ امْرَأَتَهُ تَرْفَعُهُ ، فَلَمَّا حُضِرَ ، قَالَ لَهَا : أَيْنَ الَّذِي كُنْتُ استَوْدَعْتُكِ ؟ قَالَتْ : هُوَ هَذَا ، فَأَتَتْهُ بِهِ ، قَالَ : \" رُشِّيهِ حَوْلِي ، فَإِنَّهُ يَأْتِينِي خَلْقٌ مِنْ خَلْقِ اللَّهِ ، لا يَأْكُلُونَ الطَّعَامَ ، وَلا يَشْرَبُونَ الشَّرَابَ ، يَجِدُونَ الرِّيحَ ""","","","","","Book of Funerals"
"5980","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ :أَيُكْرَهُ الْمِسْكُ حَنُوطًا ؟ قَالَ \" نَعَمْ \" ، قَالَ : قُلْتُ : فَالْعَنْبَرُ ؟ قَالَ : \" لا ، إِنَّمَا الْعَنْبَرُ وَالْمِسْكُ ، قَطْرَةُ دَابَّةٍ ""","","","","","Book of Funerals"
"5981","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ : قُلْتُ لَهُ : فَالْخَلُوقُ لِلْمَيِّتِ ؟ قَالَ \"ذَلِكَ صُفْرَةٌ ، وَقَدْ كَانَتِ الصُّفْرَةُ تُكْرَهُ ""","","","","","Book of Funerals"
"5982","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عُمَرُ بْنُ عَطَاءِ بْنِ أَبِي الْخُوَارِ ، أَنَّهُ سَمِعَ يَحْيَى بْنَ يَعْمَرَ يُخْبِرُ ، عَنْ رَجُلٍ أَخْبَرَهُ عَنْ عَمَّارِ بْنِ يَاسِرٍ ، أَنَّ عَمَّارًا ، قَالَ :تَخَلَّقْتُ بِخَلُوقٍ ، ثُمَّ أَتَيْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَانْتَهَرَنِي ، فَقَالَ : \" اذْهَبْ يَا ابْنَ أُمِّ عَمَّارٍ ، فَاغْسِلْهُ عَنْكَ \" ، قَالَ : \" فَرَجَعْتُ فَغَسَلْتُهُ عَنِّي ، ثُمَّ رَجَعْتُ إِلَيْهِ ، فَانْتَهَرَنِي أَيْضًا ، وَأَمَرَنِي أَنْ أَرْجِعَ ، فَأَغْتَسِلَ فَفَعَلْتُ ، ثُمَّ رَجَعْتُ إِلَيْهِ ، فَانْتَهَرَنِي ، وَأَمَرَنِي أَنْ أَرْجِعَ ، فَأَغْتَسِلَ ثَلاثًا ""","","","","","Book of Funerals"
"5983","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ :أَيُّ الْحِنَاطِ أَحَبُّ إِلَيْكَ ؟ قَالَ \" الْكَافُورُ \" ، قَالَ : قُلْتُ : فَأَيْنَ يُجْعَلُ مِنْهُ ؟ قَالَ : \" فِي مَرَاقِّهِ \" ، قُلْتُ لَهُ : فِي إِبِطِهِ ؟ قَالَ : \" نَعَمْ ، وَفِي مَرْجِعِ رِجْلَيْهِ ، وَفِي رُفْغَيْهِ ، وَمَرَاقِّهِ ، وَمَا هُنَالِكَ ، وَفِي فِيهِ ، وَأَنْفِهِ ، وَعَيْنَيْهِ ، وَأُذُنِهِ \" ، قُلْنَا : أَيَابِسٌ يُجْعَلُ الْكَافُورُ أَوْ يُبَلُّ بِمَاءٍ ؟ قَالَ : \" بَلْ يَابِسًا ""","","","","","Book of Funerals"
"5984","عَنِ الثَّوْرِيِّ ، عَنْ عَدِيٍّ ، عَنْ إِبْرَاهِيمَ ، قَالَ \"يَتَتَبَّعُ مَسَاجِدَهُ بِالطِّيبِ ""","","","","","Book of Funerals"
"5985","عَنِ الثَّوْرِيِّ ، قَالَ : \" بَلَغَنِي عَنْ إِبْرَاهِيمَ ، أَنَّهُ كَانَيَكْرَهُ الزَّعْفَرَانَ أَنْ يُجْعَلَ فِي شَيْءٍ مِنْ طِيبِ الْمَيِّتِ ""","","","","","Book of Funerals"
"5986","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، عَنْ حَكِيمِ بْنِ جَابِرٍ ، قَالَ : لَمَّا تُوُفِّيَ الأَشْعَثُ بْنُ قَيْسٍ ، قَالَ الْحَسَنُ بْنُ عَلِيٍّ : \"إِذَا غَسَّلْتُمُوهُ ، فَلا تُهَيِّجُوهُ حَتَّى تَأْتُونِي بِهِ ، فَلَمَّا فُرِغَ مِنْ غُسْلِهِ أُتِيَ بِهِ ، فَدَعَا بِكَافُورٍ ، فَوَضَّأَهُ بِهِ وَجَعَلَ عَلَى وَجْهِهِ ، وَفِي يَدَيْهِ وَرَأْسِهِ وَرِجْلَيْهِ \" ، ثُمَّ قَالَ : \" أَدْرِجُوهُ ""","","","","","Book of Funerals"
"5987","عَنْ مَعْمَرٍ \" أَنَّهُ رَأَى أَيُّوبَيَذُرُّ عَلَى الْمَيِّتِ وَلِحْيَتِهِ وَصَدْرِهِ ذَرِيرَةً ""","","","","","Book of Funerals"
"5988","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ \"النَّارُ يُتَّبَعُ بِهَا الْمَيِّتُ ، يَعْنِي الْمِجْمَرَةَ ، قَالَ : لا خَيْرَ فِي ذَلِكَ ، قَالَ : إِجْمَارُ ثِيَابِهِ ، قَالَ : حَسَنٌ لَيْسَ بِذَلِكَ بَأْسٌ ""","","","","","Book of Funerals"
"5989","عَنْ مَعْمَرٍ ، أَوِ ابْنِ جُرَيْجٍ ، الشَّكُّ مِنْ أَبِي سَعِيدٍ ، عَنْ هِشَامٍ ، عَنْ أَبِيهِ ، عَنْ أَسْمَاءَ بِنْتِ أَبِي بَكْرٍ ، أَنَّهَا قَالَتْ لأَهْلِهَا : \"أَجْمِرُوا ثِيَابِي إِذَا أَنَا مِتُّ ، ثُمَّ كَفِّنُونِي ، ثُمَّ حَنِّطُونِي ، وَلا تَذُرُّوا عَلَى كَفَنِي حِنَاطًا ""","","","","","Book of Funerals"
"5990","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ حَرْمَلَةَ ، قَالَ \" أَوْصَى ابْنُ الْمُسَيِّبِ أَهْلَهُ أَنْلا يَتَّبِعُوهُ بِمِجْمَرٍ ""","","","","","Book of Funerals"
"5991","عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِي ذِئْبٍ ، عَنْ سَعِيدٍ الْمَقْبُرِيِّ ، قَالَ : \" أَوْصَى أَبُو هُرَيْرَةَ أَهْلَهُ أَنْلا يَضْرِبُوا عَلَى قَبْرِهِ فُسْطَاطًا ، وَلا يَتَّبِعُوهُ بِمِجْمَرٍ ، وَأَنْ يُسْرِعُوا بِهِ ""","","","","","Book of Funerals"
"5992","عَنْ مَالِكٍ ، عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ ، \" أَنَّ أَبَا هُرَيْرَةَ ،نَهَى أَنْ يُتَّبَعَ بِنَارٍ بَعْدَ مَوْتِهِ ""","","","","","Book of Funerals"
"5993","عَنْ مَعْمَرٍ ، قَالَ \" لا أَعْلَمُ أَيُّوبَ إِلا كَانَيُجَفِّفُ رَأْسَ الْمَيِّتِ بِمِجْمَرٍ ""","","","","","Book of Funerals"
"5994","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ : \"غُسْلُ الْمَيِّتِ وِتْرٌ ، وَتَجْمِيرُهُ وِتْرٌ ، وَثِيَابُهُ وِتْرٌ \" ، وَكَانُوا يَقُولُونَ : لا تَكُونُ آخِرَ زَادِهِ نَارٌ تَتَّبِعُهُ إِلَى قَبْرِهِ ، وَيَدْخُلُ الْقَبْرَ كَمْ شَاءَ ، وَكَانَ يَكْرَهُ أَنْ تُسْبَقَ الْجِنَازَةُ ، وَأَنْ يَتَقَدَّمَ الرَّاكِبُ أَمَامَ الْجِنَازَةِ ، يَعْنِي يَقُولُ : \" نَارُ الْمِجْمَرَةِ ""","","","","","Book of Funerals"
"5995","عَنِ الثَّوْرِيِّ ، عَنْ إِبْرَاهِيمَ بْنِ الْمُهَاجِرِ ، وَمُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، قَالَ : كَانَ يَقُولُ : \" تُجَمَّرُ الثِّيَابُ قَبْلَ أَنْ تُلْبِسَهَا إِيَاهُ \" ، وَقَالَ إِبْرَاهِيمُ : \"لا تُجَمِّرُوا جَسَدَهُ ، وَلا تَحْتَ نَعْشِهِ ، وَلا يُدْنَى مِنْهُ شَيْءٌ مِنَ الْمَجْمَرِ ، إِلا أَنْ تُجَمَّرَ ثِيَابُهُ قَبْلَ أَنْ تُلْبِسَهُ ""","","","","","Book of Funerals"
"5996","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الأَعْلَى ، قَالَ : كُنْتُ مَعَ سَعِيدِ بْنِ جُبَيْرٍ ، وَهُوَيتَّبِعُ جِنَازَةً مَعَهَا مِجْمَرٌ يُتَّبَعُ بِهَا ، فَرَمَى بِهَا فَكَسَرَهَا ، وَقَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ ، يَقُولُ : \" لا تَشَبَّهُوا بِأَهْلِ الْكِتَابِ ""","","","","","Book of Funerals"
"5997","عَنِ ابْنِ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى ، قَالَ :إِذَا أُجْمِرَ الْمُتَوَفَّى ، فَلْيُبْدَأْ بِرَأْسِهِ حَتَّى تَبْلُغَ رِجْلَيْهِ ، وَتُجَمِّرُ وِتْرًا ، نُبِّئْتُ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَمَرَ بِذَلِكَ","","","","","Book of Funerals"
"5998","عَنِ ابْنِ التَّيْمِيِّ ، عَنِ الْقَاسِمِ بْنِ الْفَضْلِ ، قَالَ : أَخْبَرَنِي أَبُو حَيَّةَ الثَّقَفِيُّ ، قَالَ \" أَوْصَى مَعْقِلُ بْنُ يَسَارٍ عِنْدَ مَوْتِهِ أَنْلا يَقْرَبَ قَبَسًا ، يَعْنِي مِجْمَرَةً ، وَلا يُغَسَّلَ بِحَمِيمٍ ، وَيُصَلَّى عَلَيْهِ عِنْدَ قَبْرِهِ ""","","","","","Book of Funerals"
"5999","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، عَنْ حَنَشِ بْنِ الْمُعْتَمِرِ ، \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَأَبْصَرَ مَعَ امْرَأَةٍ مِجْمَرَةً عِنْدَ جِنَازَةٍ ، حِينَ أَرَادَ أَنْ يُصَلِّيَ عَلَيْهَا ، فَصَاحَ حَتَّى تَوَارَتْ فِي آجَامِ الْمَدِينَةِ ""","","","","","Book of Funerals"
"6000","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عَلِيِّ بْنِ حُسَيْنٍ ، قَالَ : \"كُفِّنَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي ثَلاثَةِ أَثْوَابٍ : أَحَدُهَا حِبَرَةٌ \"، قَالَ عَبْدُ الرَّزَّاقِ : وَهَذَا الْمُجْتَمَعُ عَلَيْهِ ، وَبِهِ نَأْخُذُ عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ شِهَابٍ ، عَنْ عَلِيِّ بْنِ حُسَيْنٍ مِثْلَهُ","","","","","Book of Funerals"
"6001","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ ، قَالَ : \"كُفِّنَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي رَيْطَتَيْنِ ، وَبُرْدٍ أَحْمَرَ ""","","","","","Book of Funerals"
"6002","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبِي لَيْلَى ، عَنِ الْحَكَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : \"كُفِّنَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي بُرْدَيْنِ أَبْيَضَيْنِ ، وَبُرْدٍ أَحْمَرَ ""","","","","","Book of Funerals"
"6003","عَنِ الثَّوْرِيِّ ، عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ ، عَنْ أَبِيهِ ، قَالَ : \"كُفِّنَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي ثَوْبَيْنِ صُحَارِيَّيْنِ ، وَثَوْبِ حِبَرَةٍ ""","","","","","Book of Funerals"
"6004","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ : \"كُفِّنَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي حُلَّةٍ يَمَانِيَّةٍ ، وَقَمِيصٍ ""","","","","","Book of Funerals"
"6005","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ عَلِيِّ بْنِ حُسَيْنٍ ، يَقُولُ : بلَغَنَا ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَكُفِّنَ فِي ثَلاثَةِ أَثْوَابٍ ، قِيلَ : مَا هُنَّ ؟ قَالَ : قَدِ اخْتَلَفُوا فِيهِنَّ ، مِنْهُنَّ قَمِيصٌ ، قُلْتُ : عِمَامَةٌ ؟ \" ، قَالَ : ثَوْبَانِ سِوَى الْقَمِيصِ، قَالَ عَبْدُ الرَّزَّاقِ : وَهُوَ الْقَمِيصُ الَّذِي غُسِّلَ فِيهِ","","","","","Book of Funerals"
"6006","عَنِ الثَّوْرِيِّ ، عَنْ يُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : \"كُفِّنَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي حُلَّةٍ وَقَمِيصٍ ، وَلُحِّدَ لَهُ \"، وَقَالَهُ مَعْمَرٌ ، عَنِ الْحَسَنِ","","","","","Book of Funerals"
"6007","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، قَالَتْ : \"كُفِّنَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي ثَلاثَةِ أَثْوَابٍ سَحُولِيَّةٍ بِيضٍ، يَعْنِي مِنْ ثِيَابِ السَّحُولِيِّ ""","","","","","Book of Funerals"
"6008","عَنِ الثَّوْرِيِّ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنْ عَائِشَةَ ، قَالَتْ : \"كُفِّنَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي ثَلاثَةِ أَثْوَابٍ سَحُولٍ كُرْسُفٍ بِيضٍ ، لَيْسَ فِيهَا قَمِيصٌ ، وَلا عِمَامَةٌ ""","","","","","Book of Funerals"
"6009","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، قَالَ : \"لُفَّ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي ثَوْبِ حِبَرَةٍ جُفِّفَ فِيهِ ، ثُمَّ نُزِعَ ، وَجُعِلَ مَكَانَهُ السَّحُولُ ، وَكَانَ الثَّوْبُ الْحِبِرَةُ لِعَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ \" ، فَقَالَ : لا أَلْبَسُ ثَوْبًا نَزَعَهُ اللَّهُ عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَبَدًا","","","","","Book of Funerals"
"6010","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي سَلَمَةَ ، عَنْ عَائِشَةَ ، \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَسُجِّيَ فِي ثَوْبِ حِبَرَةٍ ""","","","","","Book of Funerals"
"6011","عَنِ الثَّوْرِيِّ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ \" أَنَّ أَبَا بَكْرٍكُفِّنَ فِي ثَلاثَةِ أَثْوَابٍ ، وَصُلِّيَ عَلَيْهِ فِي الْمَسْجِدِ وَدُفِنَ لَيْلا ""","","","","","Book of Funerals"
"6012","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، قَالَ \" سَأَلَ أَبُو بَكْرٍ عَائِشَةَفِي كَمْ كُفِّنَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَتْ : فِي ثَلاثَةِ أَثْوَابٍ ، قَالَ : وَأَنَا كَفِّنُونِي فِي ثَلاثَةٍ : ثَوْبِي هَذَا ، وَبِهِ مَشَقٌّ ، مَعَ ثَوْبَيْنِ آخَرَيْنِ ، وَاغْسِلُوا ، لِثَوْبِهِ الَّذِي كَانَ يُلْبَسُ ، قَالَتْ عَائِشَةُ : أَلا نَشْتَرِي لَكَ جَدِيدًا ؟ فَقَالَ : لا ، الْحَيُّ أَحْوَجُ إِلَى الْجَدِيدِ ، إِنَّمَا هُوَ لِلْمُهْلَةِ ، أَيُّ يَوْمٍ مَاتَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَتْ : يَوْمَ الاثْنَيْنِ ، قَالَ : أَيُّ يَوْمٍ هَذَا ؟ قَالَتْ : يَوْمُ الاثْنَيْنِ ، قَالَ : إِنِّي لأَرْجُو إِلَى اللَّيْلِ ، فَتُوُفِّيَ حِينَ أَمْسَى ، وَدُفِنَ مِنْ لَيْلَتِهِ قَبْلَ أَنْ يُصْبِحَ ""","","","","","Book of Funerals"
"6013","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ : \"كُفِّنَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فِي حُلَّةٍ يَمَانِيَّةٍ وَقَمِيصٍ ""","","","","","Book of Funerals"
"6014","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ ، قَالَتْ : \" قَالَ أَبُو بَكْرٍ لِثَوْبَيْهِ اللَّذَيْنِ كَانَ يُمَرَّضُ فِيهِمَا :اغْسِلُوهُمَا ، وَكَفِّنُونِي فِيهِمَا ، فَقَالَتْ عَائِشَةُ : أَلا نَشْتَرِي لَكَ جَدِيدًا ، قَالَ : لا إِنَّ الْحَيَّ أَحْوَجُ إِلَى الْجَدِيدِ مِنَ الْمَيِّتِ ""","","","","","Book of Funerals"
"6015","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِيهِ ، \" أَنَّ أَبَا بَكْرٍكُفِّنَ فِي ثَلاثَةِ أَثْوَابٍ مُلاءَتَيْنِ مُمَصَّرَتَيْنِ ، وَثَوْبٍ كَانَ يَلْبَسُهُ \" ، وَقَالَ : \" الْحَيُّ أَحْوَجُ إِلَى الْجَدِيدِ ، إِنَّمَا هِيَ لِلْمُهْلَةِ ، يَعْنِي الصَّدِيدَ وَالْقَيْحَ ""","","","","","Book of Funerals"
"6016","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، \" أَنَّ ابْنَ عُمَرَ كَانَيُكَفِّنُ أَهْلَهُ فِي خَمْسَةِ أَثْوَابٍ ، مِنْهَا : عِمَامَةٌ ، وَقَمِيصٌ ، وَثَلاثُ لَفَالِفَ \"، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ مِثْلَهُ ، عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي نَافِعٌ ، عَنِ ابْنِ عُمَرَ نَحْوَهُ","","","","","Book of Funerals"
"6017","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، قَالَ \" كَانَ ابْنُ عُمَرَيُسْدِلُ طَرَفَ الْعِمَامَةِ عَلَى وَجْهِ الْمَيِّتِ ، ثُمَّ يَلُفُّ عَلَى رَأْسِهِ مِنْ تَحْتِ الذَّقْنِ ، ثُمَّ يَلْوِيهَا عَلَى رَأْسِهِ ، ثُمَّ يُسْدِلُ الطَّرَفَ الآخَرَ أَيْضًا عَلَى وَجْهِهِ \"، قُلْنَا لِعَبْدِ الرَّزَّاقِ : وَكَيْفَ ؟ قَالَ : أَرَانَا مَعْمَرٌ هَكَذَا يَضَعُ طَرَفَ الْعِمَامَةِ يُسْدِلُهَا عَلَى وَجْهِهِ ، ثُمَّ يَرُدُّ الَّذِي يُسْدِلُ عَلَى الْوَجْهِ إِلَى الْحَلْقِ ، ثُمَّ يَضَعُ الْعِمَامَةَ عَلَى الَّذِي يُسْدِلُ عَلَى الْوَجْهِ يَرُدُّ تَحْتَ الذَّقَنِ ، ثُمَّ يَلْوِيهَا عَلَى رَأْسِهِ ، ثُمَّ يُعِيدُ طَرَفَ الْعِمَامَةِ عَلَى جَبْهَتِهِ ، ثُمَّ يُسْدِلُ مَا بَقِيَ مِنْهَا عَلَى وَجْهِهِ أَيْضًا","","","","","Book of Funerals"
"6018","أُخْبِرْنَا عَنِ الثَّوْرِيِّ ، عَنْ عَاصِمِ بْنِ عَبْدِ اللَّهِ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ \" أَنَّ عُمَرَكُفِّنَ فِي ثَلاثَةِ أَثْوَابٍ ، ثَوْبَيْنِ سَحُولِيَّيْنِ ، وَثَوْبٍ كَانَ يَلْبَسُهُ ""","","","","","Book of Funerals"
"6019","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ ، قَالَ \" كَانَيُكَفِّنُ فِي وِتْرٍ قَمِيصٍ وَلُفَافَتَيْنِ ، يُلْبِسُ الْقَمِيصَ وَيَلُفُّ فِي اللُّفَافَتَيْنِ ، وَيَحْشُو الْكُرْسُفَ وَالذَّرِيرَةَ \"، قَالَ عَبْدُ الرَّزَّاقِ : قَالَ مَعْمَرٌ : وَلا أَعْلَمُنِي إِلا رَأَيْتُ أَيُّوبَ يَحْشُو الْكُرْسُفَ","","","","","Book of Funerals"
"6020","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، قَالَ : \"تُحَلُّ عَنِ الْمَيِّتِ الْعُقَدُ ""","","","","","Book of Funerals"
"6021","عَنِ ابْنِ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى ، قَالَ \"يُكَفَّنُ الْمَيِّتُ فِي وِتْرِ قَمِيصٍ وَلُفَافَتَيْنِ ، يُلْبَسُ الْقَمِيصُ ، وَتُبْسَطُ اللُّفَافَةُ عَلَى الأُخْرَى ، ثُمَّ يُدْرَجُ فِيهَا ، وَلا يَزَالُ عَلَيْهِ الْقَمِيصُ ""","","","","","Book of Funerals"
"6022","عَنْ مَالِكٍ ، عَنِ ابْنِ شِهَابٍ ، عَنْ حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرِو بْنِ الْعَاصِ ، قَالَ : \"الْمَيِّتُ يُقَمَّصُ ، وَيُؤَزَّرُ ، وَيُلَفُّ فِي الثَّالِثِ ، فَإِنْ لَمْ يَكُنْ إِلا ثَوْبٌ وَاحِدٌ لُفَّ فِيهِ ""","","","","","Book of Funerals"
"6023","عَنْ رَجُلٍ مِنْ أَهْلِ الْمَدِينَةِ ، عَنْ مُحَمَّدِ بْنِ أَبِي بَكْرٍ ، عَنْ مَوْلَى لأَبِي هُرَيْرَةَ ، قَالَ لأَهْلِهِ عِنْدَ مَوْتِهِ \" لا تُعَمِّمُونِي ، وَلا تُقَمِّصُونِي ، فَإِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَلَمْ يُعَمَّمْ ، وَلَمْ يُقَمَّصْ ""","","","","","Book of Funerals"
"6024","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قَالَ عَطَاءٌ \"لا يُؤَزَّرُ الْمَيِّتُ ، وَلا يُرَدَّى ، وَلَكِنْ يُلَفُّ فِيهَا لَفًّا ""","","","","","Book of Funerals"
"6025","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ \" أَنَّهُ كَانَيُكَفِّنُ الرَّجُلَ مِنْ أَهْلِهِ فِي ثَلاثَةِ أَثْوَابٍ لَيْسَ مِنْهُنَّ عِمَامَةٌ ""","","","","","Book of Funerals"
"6026","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ \"أَيُعَمَّمُ الْمَيِّتُ ؟ قَالَ : لا ، قُلْتُ : أَيُحْشَى الْكُرْسُفَ ؟ قَالَ : نَعَمْ ، لأَنْ لا يَتَفَجَّرَ مِنْهُ شَيْءٌ ""","","","","","Book of Funerals"
"6027","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، قَالَ \"كُفِّنَ حَمْزَةُ فِي ثَوْبٍ وَاحِدٍ \"، قَالَ عَبْدُ الرَّزَّاقِ : قَالَ مَعْمَرٌ : وَبَلَغَنِي أَنَّهُ كَانَ إِذَا خُمِّرَ رَأْسُهُ ، انْكَشَفَتْ رِجْلاهُ ، وَإِذَا خَمَّرْنَا رِجْلاهُ ، انْكَشَفَ رَأْسُهُ","","","","","Book of Funerals"
"6028","أُخْبِرْنَا ، عَنْ مَعْمَرٍ ، عَنْ عُثْمَانَ الْجَزْرِيِّ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ :\" قُتِلَ حَمْزَةُ يَوْمَ أُحُدٍ ، وَقُتِلَ مَعَهُ رَجُلٌ مِنَ الأَنْصَارِ ، فَجَاءَتْ صَفِيَّةُ ابْنَةُ عَبْدِ الْمُطَّلِبِ ، بِثَوْبَيْنِ لِتُكَفِّنَ بِهِمَا حَمْزَةَ ، فَلَمْ يَكُنْ لِلأَنْصَارِيِّ كَفَنٌ ، فَأَسْهَمَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَيْنَ الثَّوْبَيْنِ ، ثُمَّ كَفَّنَ كُلَّ وَاحِدٍ مِنْهُمَا فِي ثَوْبٍ ""","","","","","Book of Funerals"
"6029","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِي وَائِلٍ ، قَالَ : سَمِعْتُ خَبَّابَ بْنَ الأَرَتِّ ، يَقُولُ : \" إِنَّا هَاجَرْنَا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَبْتَغِي وَجْهَ اللَّهِ ، فَوَجَبَ أَجْرُنَا عَلَى اللَّهِ ، فَمِنَّا مَنْ مَضَى وَلَمْ يَأْكُلْ مِنْ أَجْرِهِ شَيْئًا ، مِنْهُمُالْمُصْعَبُ بْنُ عُمَيْرٍ قُتِلَ يَوْمَ أُحُدٍ ، وَتَرَكَ بُرْدَةً ، فَإِذَا جَعَلْنَاهَا عَلَى رِجْلَيْهِ بَدَا رَأْسَهُ ، وَإِذَا جَعَلْنَاهَا عَلَى رَأْسِهِ بَدَتْ رِجْلاهُ ، فَأَمَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِجَعْلِهَا عَلَى رَأْسِهِ ، وَيُجْعَلُ عَلَيْهَا شَيْءٌ مِنْ إِذْخِرٍ ، وَمِنَّا مَنْ أَيْنَعَتْ لَهُ ثَمَرَتُهُ فَهُوَ يُهْدِيهَا، يَعْنِي يَأْكُلُهَا ""","","","","","Book of Funerals"
"6030","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ : سَمِعْتُ عُبَيْدَ بْنَ عُمَيْرٍ ، يَقُولُ : وَقَدْ كَانَ الرَّجُلُ يُكَفَّنُ فِي ذَلِكَ الزَّمَانِ فِي ثَوْبٍ وَاحِدٍ ، إِنْ خُمِّرَ رَأْسُهُ انْكَشَفَتْ رِجْلاهُ ، وَإِنْ خُمِّرَتْ رِجْلَيْهِ انْكَشَفَ رَأْسُهُ ، قَالَ : وَأَمَرَ أَبُو بَكْرٍ إِمَّا عَائِشَةَ ، وَإِمَّا أَسْمَاءَ بِنْتَ عُمَيْسٍ ، بِأَنْتَغْسِلَ ثَوْبَيْنِ كَانَ يُمَرَّضُ فِيهِمَا ، فَقَالَتْ عَائِشَةُ : أَوَ ثِيَابًا جُدُدًا ، أَوْ أَمْثَلَ مِنْهَا ؟ قَالَ : الأَحْيَاءُ أَحَقُّ بِذَلِكَ ""","","","","","Book of Funerals"
"6031","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : مَاذَا بَلَغَكَ أَنَّهُ يُسْتَحَبُّ مِنْ كَفَنِ الْمَيِّتِ ؟ قَالَ : \"الْبَيَاضُ أَدْنَاهُ \" ، قُلْتُ : إِنِّي أَرَى النَّاسَ قَدْ عَلَّقُوا الْقَبَاطِيَ ، قَالَ مُحْدَثٌ : \" وَأَيْنَ الْقَبَاطِي مِنْ ذَلِكَ الزَّمَانِ ؟ أَرَهْوًا حَيًّا وَزَهْوًا مَيِّتًا ؟ ""","","","","","Book of Funerals"
"6032","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ ، عَنْ أَبِي الْمُهَلَّبِ ، عَنْ سَمُرَةَ بْنِ جُنْدُبٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"عَلَيْكُمْ بِهَذَا الْبَيَاضِ ، فَلْيَلْبَسْهُ أَحْيَاؤُكُمْ ، وَكَفِّنُوا فِيهِ مَوْتَاكُمْ ، فَإِنَّهُ مِنْ خِيَارِ ثِيَابِكُمْ ""","","","","","Book of Funerals"
"6033","عَنِ الثَّوْرِيِّ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، عَنْ مَيْمُونِ بْنِ أَبِي شَبِيبٍ ، عَنْ سَمُرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"الْبَسُوا الثِّيَابَ الْبِيضَ ، فَإِنَّهَا أَطْيَبُ وَأَطْهَرُ ، وَكَفِّنُوا فِيهَا مَوْتَاكُمْ ""","","","","","Book of Funerals"
"6034","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عُثْمَانَ بْنِ خُثَيْمٍ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، عَنِ ابْنِ عَبَّاسٍ ،\" الْبَسُوا مِنْ ثِيَابِكُمُ الْبَيَاضَ ، فَإِنَّهَا مِنْ خَيْرِ ثِيَابِكُمْ ، وَكَفِّنُوا فِيهَا مَوْتَاكُمْ ، وَمِنْ خَيْرِ أكْحَالِكُمُ الإِثْمِدُ ، فَإِنَّهُ يُنْبِتُ الشَّعْرَ ، وَيَجْلُو الْبَصَرَ \"، عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ خُثَيْمٍ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ","","","","","Book of Funerals"
"6035","وَأَخْبَرَنِي يَحْيَى بْنُ وَهْبٍ ، قَالَ : حَضَرْتُ جِنَازَةَ هَمَّامِ بْنِ مُنَبِّهٍ ، وَحَضَرَ ذَلِكَ عُمَرُ بْنُ عَبْدِ الْحَمِيدِ رَجُلٌ مِنْ وَلَدِ عُمَرَ بْنِ الْخطَّابِ ، وَهُوَ أَوَّلُ مَنْ كَانَ وَالِيًا لِبَنِي الْعَبَّاسِ ، وَلَمْ يُرَ مِثْلُهُ قَطُّ ، فَصَلَّى وَكَانَ عَلَى النَّعْشِ ثَوْبٌ ، فَأَرَادُوا أَنْ يَضَعُوهُ فِي قَبْرِهِ لِيُكَفَّنَ فِيهِ ، فَجَذَبَهُ ، وَقَالَ : \" إِنَّمَاكَفَنُهُ مَا أُخْرِجَ بِهِ مِنْ بَيْتِهِ عَلَيْهِ \" ، قَالَ : \" فَلَمْ يَتْرُكْهُمْ يُكَفِّنُونَهُ فِيهِ ""","","","","","Book of Funerals"
"6036","عَنِ ابْنِ جُرَيْجٍ ، عَنْ رَجُلٍ ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ أَنَّهُ حَضَرَ أَبَا سَعِيدٍ الْخُدْرِيَّ وَهُوَ يَمُوتُ ، فَقَالَ أَبُو سَعِيدٍ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : \" إِنَّالْمَيِّتَ يُبْعَثُ فِي ثِيَابِهِ الَّتِي قُبِضَ فِيهَا \"، ثُمَّ قَالَ أَبُو سَعِيدٍ : قَدْ أَوْصَيْتُ أَهْلِي أَنْ لا يَتْبَعُونِي بِنَارٍ ، وَلا يَضْرِبُوا عَلَى قَبْرِي فُسْطَاطَا ، وَاحْمِلُونِي عَلَى قَطِيفَةٍ أُرْجُوَانٍ","","","","","Book of Funerals"
"6037","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ رَجُلٍ ، قَالَ : لَمَّا مَاتَ أَبُو سَعِيدٍ الْخُدْرِيُّ جُعِلَتْ لَهُ قَطِيفَةٌ حَمْرَاءُ ، فَقَالَ رَجُلٌ : أَمَا إِنِّي قَدْ سَمِعْتُهُ يُحَدِّثُ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ رَأَى حُمْرَةً ، فَقَالَ : \"أَلا إِنَّ الْحُمْرَةَ غَلَبَتْ عَلَيْكُمْ ""","","","","","Book of Funerals"
"6038","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي إِبْرَاهِيمُ بْنُ إِسْمَاعِيلَ بْنِ مُجَمِّعٍ ، عَنْ عَمَّتِهِ بِنْتِ مُجَمِّعٍ ، عَنْ بِنْتِ أَبِي سَعِيدٍ الْخُدْرِيِّ أَنَّهُ قَالَ لابنِ عُمَرَ ، وَلأَنَسِ بْنِ مَالِكٍ ، وَلآخَرَ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \"لا يَغْلِبَنَّكُمْ بَنُو أَبِي سَعِيدٍ جِنَازَتِي ، وَاحْمِلُونِي عَلَى قَطِيفَةٍ قَيْصَرَانِيَّةٍ ، وَأَجْمِرُوا عَلَيَّ بِأُوقِيَّةِ مِجْمَرٍ ، وَكَفِّنُونِي فِي ثِيَابِي الَّتِي كُنْتُ أُصَلِّي فِيهَا ، وَاذْكُرُوا اللَّهَ ، وَلا تَضْرِبُوا عَلَيَّ فُسْطَاطًا ، وَلا تَتَّبِعُونِي بِنَارٍ وَفِي الْبَيْتِ قِبْطِيَّةٌ ، فَكَفِّنُونِي فِيهَا مَعَ ثِيَابِي ""","","","","","Book of Funerals"
"6039","عَنِ الثَّوْرِيِّ ، عَنْ عِمْرَانَ بْنِ أَبِي عَطَاءٍ ، قَالَ \" شَهِدْتُ مُحَمَّدَ بْنَ الْحَنَفِيَّةِ حِينَ مَاتَ ابْنُ عَبَّاسٍ بِالطَّائفِ ،كَبَّرَ أَرْبَعًا ، وَأَخَذَهُ مِنْ قِبَلِ الْقِبْلَةِ ، حَتَّى أَدْخَلَهُ قَبْرَهُ ، وَضَرَبَ عَلَيْهِ فُسْطَاطًا ثَلاثَةَ أَيَّامٍ ""","","","","","Book of Funerals"
"6040","عَنْ يَحْيَى بْنِ الْعَلاءِ ، عَنْ يَزِيدَ بْنِ عَبْدِ اللَّهِ بْنِ أُسَامَةَ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ بْنِ الْحَارِثِ التَّيْمِيِّ ، قَالَ \"أَوَّلُ فُسْطَاطٍ ضُرِبَ عَلَى قَبْرِ أَحَدٍ مِنَ الْمُسْلِمِينَ لَعَلَى قَبْرِ زَيْنَبَ بِنْتِ جَحْشٍ وَكَانَ يَوْمًا حَارًّا ""","","","","","Book of Funerals"
"6041","عَنِ الثَّوْرِيِّ ، عَنْ هِشَامٍ ، عَنِ ابْنِ سِيرِينَ ، قَالَ : كَانَ يُقَالُ \"مَنْ وَلِيَ أَخَاهُ ، فَلْيُحْسِنْ كَفَنَهُ ، وَإِنَّهُ بَلَغَنِي أَنَّهُمْ يَتَزَاوَرُونَ فِي أَكْفَانِهِمْ ""","","","","","Book of Funerals"
"6042","عَنِ ابْنِ جُرَيْجٍ ، وَغَيْرِهِ ، عَنْ صَفْوَانَ بْنِ سُلَيْمٍ ، قَالَ : أَمَرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْيُسْتَجَادَ الأَكْفَانُ","","","","","Book of Funerals"
"6043","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ صِلَةَ بْنِ زُفَرَ ، قَالَ : أَرْسَلَنِي حُذَيْفَةُ بْنُ الْيَمَانِ ، وَرَجُلا آخَرَ نَشْتَرِي لَهُ كَفَنَا ، فَاشْتَرَيْتُ لَهُ حُلَّةً حَمْرَاءَ جَيِّدَةً بِثَلاثِ مَائةِ دِرْهَمٍ ، فَلَمَّا أَتَيْنَاهُ ، قَالَ : أَرُونِي مَا اشْتَرَيْتُمْ فَأَرَيْنَاهُ ، فَقَالَ : \" رُدُّوهَا ،وَلا تُغَالُوا فِي الْكَفَنِ ، اشْتَرُوا لِي ثَوْبَيْنِ أَبْيَضَيْنِ نَقِيَّيْنِ ، فَإِنَّهُمَا لَنْ يُتْرَكَا عَلَيَّ إِلا قَلِيلا ، حَتَّى أُلْبَسَ خَيْرًا مِنْهُمَا ، أَوْ شَرًّا مِنْهُمَا ""","","","","","Book of Funerals"
"6044","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ مَيْسَرَةَ ، عَنِ النَّزَّالِ بْنِ سَبْرَةَ ، قَالَ : لَمَّا حُضِرَ حُذَيْفَةُ ، قَالَ حُذَيْفَةُ لأَبِي مَسْعُودٍ الأَنْصَارِيّ : \" أَيُّ اللَّيْلِ هَذَا ؟ \" قَالَ : السَّحَرُ الأَكْبَرُ ، قَالَ : \" عَائِذَا بِاللَّهِ مِنَ النَّارِ ،ابْتَاعُوا لِي ثَوْبَيْنِ ، وَلا تُغْلُوا عَلَيْكُمْ ، فَإِنْ يُرْضَى عَنْ صَاحِبِكُمْ يُلْبَسْ خَيْرًا مِنْهَا ، وَإِلا يُسْلَبْ سَلْبَا حَثِيثَا ، أَوْ قَالَ : سَرِيعًا ""","","","","","Book of Funerals"
"6045","وَأَخْبَرَنِي إِسْمَاعِيلُ ، عَنْ قَيْسٍ ، أَنَّ حُذَيْفَةَ ، قَالَ : \"إِنْ يُرْضَى عَنْ صَاحِبِكُمْ ، يُكْسَ خَيْرًا مِنْهَا ، وَإِلا تَرَامَى بِهِ أَرَاجِيهَا إِلَى يَوْمِ الْقِيَامَةِ ، يَعْنِي : النَّارَ ""","","","","","Book of Funerals"
"6046","أَخْبَرَنَا ، عَنْ بِشْرِ بْنِ رَافِعٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ أَبِي عُبَيْدَةَ بْنِ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ ، قَالَ : قَالَ ابْنُ مَسْعُودٍ :\" إِذَا أَنَا مِتُّ ، فَاشْتَرُوا لِي كَفَنَا بِثَلاثِينَ دِرْهَمًا \" ، قَالَ : وَكَانَ مُوَسَّعًا عَلَيْهِ ، وَقَالَ : \" لا ، لا تُؤْذِنُوا بِي أَحَدَا إِلا مَنْ يَحْمِلُنِي إِلَى حُفْرَتِي ""","","","","","Book of Funerals"
"6047","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : فِيكَمْ تُكَفَّنُ الْمَرْأَةُ ؟ قَالَ \" فِي ثَلاثَةِ أَثْوَابٍ ، وَثَوْبٍ فَوْقَهَا تُلَفُّ فِيهِ \" ، قُلْتُ : وَلا خِمَارَ ؟ قَالَ : \" لا ، وَلَكِنَّهَا تُجْمَعُ بِالْعَصَائِبِ ، إِنَّ لَهَا هَيْئَةً كَهَيْئَةِ الرَّجُلِ ""","","","","","Book of Funerals"
"6048","عَنِ ابْنِ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى ، قَالَ \"تُكَفَّنُ الْمَرْأَةُ فِي دِرْعِهَا ، وَخِمَارٍ ، وَلُفَافَةٍ تُدْرَجُ فِيهَا ""","","","","","Book of Funerals"
"6049","عَنْ مَعْمَرٍ ، عَمَّنْ سَمِعَ الْحَسَنَ ، يَقُولُ : \"تُكَفَّنُ الْمَرْأَةُ فِي خَمْسَةِ أَثْوَابٍ : دِرْعٌ ، وَخِمَارٌ ، وَثَلاثُ لَفَائِفَ ""","","","","","Book of Funerals"
"6050","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ : \"تُكَفَّنُ الْمَرْأَةُ فِي خَمْسَةِ أَثْوَابٍ : دِرْعٌ ، وَخِمَارٌ ، وَلُفَافٌ ، وَمِنْطَقٌ ، وَرِدَاءٌ ""","","","","","Book of Funerals"
