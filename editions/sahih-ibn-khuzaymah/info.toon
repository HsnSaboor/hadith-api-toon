"872","بَابُ تَطْوِيلِ الْقِرَاءَةِ فِي الْقِيَامِ الْأَوَّلِ وَالتَّقْصِيرِ فِي الْقِرَاءَةِ فِي الْقِيَامِ الثَّانِي عَنِ الْأَوَّلِپہلے","بَابُ تَطْوِيلِ الْقِرَاءَةِ فِي الْقِيَامِ الْأَوَّلِ وَالتَّقْصِيرِ فِي الْقِرَاءَةِ فِي الْقِيَامِ الثَّانِي عَنِ الْأَوَّلِپہلے","","","","","","","قیام میں طویل قراءت کرنے اور دوسرے قیام میں پہلے سے مختصر قراءت کرنے کا بیان","1378","1378","1378","1378"
"873","بَابُ الْجَهْرِ بِالْقِرَاءَةِ مِنْ صَلَاةِ كُسُوفِ الشَّمْسِسورج","بَابُ الْجَهْرِ بِالْقِرَاءَةِ مِنْ صَلَاةِ كُسُوفِ الشَّمْسِسورج","","","","","","","گرہن کی نماز میں بلند آواز سے قراءت کرنے کا بیان","1379","1379","1379","1379"
"874","بَابُ ذِكْرُ عَدَدِ الرُّكُوعِ فِي كُلِّ رَكْعَةٍ مِنْ صَلَاةِ الْكُسُوفِنمازِ","بَابُ ذِكْرُ عَدَدِ الرُّكُوعِ فِي كُلِّ رَكْعَةٍ مِنْ صَلَاةِ الْكُسُوفِنمازِ","","","","","","","کسوف کی ہر رکعت میں رکوع کی تعداد کا بیان","1380","1385","1380","1385"
"875","بَابُ التَّسْوِيَةِ بَيْنَ كُلِّ رُكُوعٍ وَبَيْنَ الْقِيَامِ الَّذِي قَبْلَهُ مِنْ صَلَاةِ الْكُسُوفِنماز","بَابُ التَّسْوِيَةِ بَيْنَ كُلِّ رُكُوعٍ وَبَيْنَ الْقِيَامِ الَّذِي قَبْلَهُ مِنْ صَلَاةِ الْكُسُوفِنماز","","","","","","","کسوف میں ہر رکوع کو اس سے پہلے قیام کے برابر کرنے کا بیان","1386","1386","1386","1386"
"876","بَابُ التَّكْبِيرِ لِلرُّكُوعِ وَالتَّحْمِيدِ عِنْدَ رَفْعِ الرَّأْسِ مِنَ الرُّكُوعِرکوع کرتے وقت   «اللهُ أَكْبَرُ»  کہنے اور رکوع سے سر اٹھاتے وقت   «سَمِعَ اللهُ لِمَنْ حَمِدَهُ، رَبَّنَا وَلَكَ الحَمْدُ»","بَابُ التَّكْبِيرِ لِلرُّكُوعِ وَالتَّحْمِيدِ عِنْدَ رَفْعِ الرَّأْسِ مِنَ الرُّكُوعِرکوع کرتے وقت   «اللهُ أَكْبَرُ»  کہنے اور رکوع سے سر اٹھاتے وقت   «سَمِعَ اللهُ لِمَنْ حَمِدَهُ، رَبَّنَا وَلَكَ الحَمْدُ»","","","","","","","کہنے کا بیان ”","1387","1387","1387","1387"
"877","بَابُ الدُّعَاءِ وَالتَّكْبِيرِ فِي الْقِيَامِ بَعْدَ رَفْعِ الرَّأْسِ مِنَ الرُّكُوعِ وَبَعْدَ قَوْلِ سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ فِي صَلَاةِ الْكُسُوفِنماز کسوف میں رکوع سے سر اٹھانے کے بعد اور   «سَمِعَ اللهُ لِمَنْ حَمِدَهُ»  کہنے کے بعد قیام کی حالت میں دعا مانگنے اور   «اللهُ أَكْبَر»","بَابُ الدُّعَاءِ وَالتَّكْبِيرِ فِي الْقِيَامِ بَعْدَ رَفْعِ الرَّأْسِ مِنَ الرُّكُوعِ وَبَعْدَ قَوْلِ سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ فِي صَلَاةِ الْكُسُوفِنماز کسوف میں رکوع سے سر اٹھانے کے بعد اور   «سَمِعَ اللهُ لِمَنْ حَمِدَهُ»  کہنے کے بعد قیام کی حالت میں دعا مانگنے اور   «اللهُ أَكْبَر»","","","","","","","کہنے کا بیان","1388","1388","1388","1388"
"878","بَابُ تَطْوِيلِ السُّجُودِ فِي صَلَاةِ الْكُسُوفِنماز","بَابُ تَطْوِيلِ السُّجُودِ فِي صَلَاةِ الْكُسُوفِنماز","","","","","","","کسوف میں طویل سجدے کرنے کا بیان","1389","1389","1389","1389"
"879","بَابُ تَقْصِيرِ السَّجْدَةِ الثَّانِيَةِ عَنِ الْأُولَى فِي صَلَاةِ الْكُسُوفِنماز","بَابُ تَقْصِيرِ السَّجْدَةِ الثَّانِيَةِ عَنِ الْأُولَى فِي صَلَاةِ الْكُسُوفِنماز","","","","","","","کسوف میں دوسرا سجدہ پہلے سے مختصر کرنا","1390","1391","1390","1391"
"880","بَابُ الْبُكَاءِ وَالدُّعَاءِ فِي السُّجُودِ فِي صَلَاةِ الْكُسُوفِنماز","بَابُ الْبُكَاءِ وَالدُّعَاءِ فِي السُّجُودِ فِي صَلَاةِ الْكُسُوفِنماز","","","","","","","کسوف کے سجدوں میں رونے اور دعا کرنے کا بیان","1392","1392","1392","1392"
"881","بَابُ طُولِ الْجُلُوسِ بَيْنَ السَّجْدَتَيْنِ فِي صَلَاةِ الْكُسُوفِنماز","بَابُ طُولِ الْجُلُوسِ بَيْنَ السَّجْدَتَيْنِ فِي صَلَاةِ الْكُسُوفِنماز","","","","","","","کسوف میں دو سجدوں کے درمیان طویل بیٹھنے کا بیان","1393","1393","1393","1393"
"882","بَابُ الدُّعَاءِ وَالرَّغْبَةِ إِلَى اللَّهِ فِي الْجُلُوسِ فِي آخِرِ صَلَاةِ الْكُسُوفِ حَتَّى تَنْجَلِيَ الشَّمْسُ إِذَا لَمْ يَكُنْ قَدِ انْجَلَتْ قَبْلُ.نماز","بَابُ الدُّعَاءِ وَالرَّغْبَةِ إِلَى اللَّهِ فِي الْجُلُوسِ فِي آخِرِ صَلَاةِ الْكُسُوفِ حَتَّى تَنْجَلِيَ الشَّمْسُ إِذَا لَمْ يَكُنْ قَدِ انْجَلَتْ قَبْلُ.نماز","","","","","","","کسوف کے آخر میں تشہد میں بیٹھ کر سورج روشن ہونے تک دعا کرنا اور اللہ تعالی کی طرف رغبت کا اظہار کرنا۔ جبکہ سورج اس سے پہلے (نماز کے دوران) روشن نہ ہوا ہو۔","1394","1394","1394","1394"
"883","بَابُ خُطْبَةِ الْإِمَامِ بَعْدَ صَلَاةِ الْكُسُوفِنماز","بَابُ خُطْبَةِ الْإِمَامِ بَعْدَ صَلَاةِ الْكُسُوفِنماز","","","","","","","کسوف کے بعد امام کا خطبہ دینا","1395","1396","1395","1396"
"884","بَابُ اسْتِحْبَابِ اسْتِحْدَاثِ التَّوْبَةِ عِنْدَ كُسُوفِ الشَّمْسِ، لِمَا سَبَقَ مِنَ الْمَرْءِ مِنَ الذُّنُوبِ وَالْخَطَايَاسورج گرہن کے وقت آدمی کا اپنے گزشتہ گناہوں اور خطاوَں","بَابُ اسْتِحْبَابِ اسْتِحْدَاثِ التَّوْبَةِ عِنْدَ كُسُوفِ الشَّمْسِ، لِمَا سَبَقَ مِنَ الْمَرْءِ مِنَ الذُّنُوبِ وَالْخَطَايَاسورج گرہن کے وقت آدمی کا اپنے گزشتہ گناہوں اور خطاوَں","","","","","","","سے توبہ کرنا مستحب ہے","1397","1397","1397","1397"
"885","بَابُ الْأَمْرِ بِالصَّدَقَةِ عِنْدَ كُسُوفِ الشَّمْسِسورج گرہن کے وقت صدقہ کرنے کے حُکم","بَابُ الْأَمْرِ بِالصَّدَقَةِ عِنْدَ كُسُوفِ الشَّمْسِسورج گرہن کے وقت صدقہ کرنے کے حُکم","","","","","","","کا بیان","1398","1400","1398","1400"
"886","بَابُ الْأَمْرِ بِالْعَتَاقَةِ فِي كُسُوفِ الشَّمْسِسورج","بَابُ الْأَمْرِ بِالْعَتَاقَةِ فِي كُسُوفِ الشَّمْسِسورج","","","","","","","گرہن کے وقت غلام آزاد کرنے کا بیان","1401","1401","1401","1401"
"887","بَابُ ذِكْرِ عِلَّةِ لِمَا تَنْكَسِفُ الشَّمْسُ إِذَا انْكَسَفَتْ، إِنْ صَحَّ الْخَبَرُ،سورج","بَابُ ذِكْرِ عِلَّةِ لِمَا تَنْكَسِفُ الشَّمْسُ إِذَا انْكَسَفَتْ، إِنْ صَحَّ الْخَبَرُ،سورج","","","","","","","کو گرہن لگنے کی علت و سبب کا بیان","1402","1404","1402","1404"
"888","بَابُ التَّوَاضُعِ وَالتَّبَذُّلِ وَالتَّخَشُّعِ وَالتَّضَرُّعِ عِنْدَ الْخُرُوجِ إِلَى الِاسْتِسْقَاءِ.نماز","بَابُ التَّوَاضُعِ وَالتَّبَذُّلِ وَالتَّخَشُّعِ وَالتَّضَرُّعِ عِنْدَ الْخُرُوجِ إِلَى الِاسْتِسْقَاءِ.نماز","","","","","","","استسقاء کے لئے جاتے ہوئے، عاجزی و انکساری اخیتار کرنے، سادہ لباس پہننے خشوع اور بے بسی و لاچاری کا اظہار کرنے کا بیان","1405","1405","1405","1405"
