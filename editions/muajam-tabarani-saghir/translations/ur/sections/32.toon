hadiths[63]{hadithnumber,text}:
"11714"," سیدہ عائشہ صدیقہ رضی اللہ عنہا نبی اکرم ﷽ کا یہ فرمان نقل کرتی ہیں :   """" میرے بعد نبوت میں سے صرف مبشرات باقی رہ گئے ہیں "" لوگوں نے عرض کی : یا رسول اللہ ! مبشرات کیا ہیں آ نبی اکرم ﷽ نے ارشاد فرمایا : "
"11715","عَنْ عُرْوَةَ بْنِ الزُّبَيْرِ قَالَ: «خَرَجَ عُمَرُ عَلَى النَّاسِ فَضَرَبَهُمْ عَلَى السَّجْدَتَيْنِ بَعْدَ الْعَصْرِ حَتَّى مَرَّ بِتَمِيمٍ الدَّارِيِّ فَقَالَ: لَا أَدَعُهُمَا، صَلَّيْتُهُمَا مَعَ مَنْ هُوَ خَيْرٌ مِنْكَ، رَسُولِ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ عُمَرُ: إِنَّ النَّاسَ لَوْ كَانُوا كَهَيْئَتِكَ لَمْ أُبَالِ».\nرَوَاهُ أَحْمَدُ وَهَذَا لَفْظُهُ، وَعُرْوَةُ لَمْ يَسْمَعْ مِنْ عُمَرَ، وَقَدْ رَوَاهُ الطَّبَرَانِيُّ وَرِجَالُهُ رِجَالُ الصَّحِيحِ فِي الْكَبِيرِ وَالْأَوْسَطِ."
"11716"," حضرت عبداللہ بن عباس رضی اللہ عنہما روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" نیک خواب "" نبوت کا چھیالیسواں جزء ہیں """"۔   یہ روایت امام ابویعلیٰ اور امام طبرانی نے نقل کی ہے اور اس کے رجال صحیح کے رجال ہیں ۔"
"11717"," سلیمان بن عریب "" حضرت ابوہریرہ رضی اللہ عنہ کا یہ بیان نقل کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" مومن شخص کے خواب "" اللہ تعالیٰ کی طرف سے خوشخبری ہوتے ہیں اور یہ نبوت کا چھیالیسواں جزء ہیں """"۔  راوی بیان کرتے ہیں : میں نے حضرت عبداللہ بن عباس رضی اللہ عنہما کو یہ حدیث بیان کی "" تو حضرت عبداللہ بن عباس رضی اللہ عنہما نے فرمایا : حضرت ء اس بن عبدالمطلب رضی اللہ عنہ نے یہ بات بیان کی ہے کہ نبی اکرم ﷽ نے ارشاد فرمایا ہے : "
"11718"," حضرت ابوہریرہ رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" جس نے مجھے خواب میں دیکھا "" اْس نے مجھے ہی دیکھا "" کیونکہ شیطان میری شکل اختیار نہیں کر سکتا ہے """"۔  ابن فضیل نامی راوی نے "" ایک مرتبہ یہ الفاظ نقل کیے ہیں :   † وہ میری صورت اختیار نہیں کر سکتا ہے """"۔   """" اور مومن بندے کا وہ خواب "" جو سچا اور نیک ہو "" وہ نبوت کا سترواں جزء ہے """"۔ "
"11719"," حضرت جابر رضی اللہ عنہ بیان کرتے ہیں : انہوں نے نبی اکرم ﷽ کو یہ ارشاد فرماتے ہوئے سنا ہے :   """" مومن شخص کا خواب """" نبوت کا ایک جزء ہے """"۔   یہ روایت امام احمد نے نقل کی ہے "" اس کی سند میں ایک راوی ابن لہیعہ ہے "" اس کی نقل کردہ حدیث حسن ہے "" اس میں ضعف پایا جاتا ہے ۔"
"11720","وَعَنْ أُمِّ سَلَمَةَ قَالَتْ: «صَلَّى رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - صَلَاةَ الْعَصْرِ ثُمَّ دَخَلَ بَيْتِي فَصَلَّى رَكْعَتَيْنِ فَقُلْتُ: يَا رَسُولَ اللَّهِ صَلَّيْتَ صَلَاةً لَمْ تَكُنْ تُصَلِّيهَا؟ قَالَ: """" قَدِمَ مَالٌ فَشَغَلَنِي عَنْ رَكْعَتَيْنِ كُنْتُ أَرْكِعُهُمَا بَعْدَ الظُّهْرِ فَصَلَّيْتُهُمَا الْآنَ """" فَقُلْتُ: يَا رَسُولَ اللَّهِ أَفَتَقْضِيهِمَا إِذَا فَاتَتَا؟ قَالَ: """" لَا» """".\nقُلْتُ: هُوَ فِي الصَّحِيحِ خَلَا قَوْلَهَا: أَفَتَقْضِيهِمَا إِذَا فَاتَتَا؟ قَالَ: """" لَا """".\nرَوَاهُ أَحْمَدُ وَابْنُ حِبَّانَ فِي صَحِيحِهِ، وَرِجَالُ أَحْمَدَ رِجَالُ الصَّحِيحِ."
"11721"," حضرت حذیفہ بن اسید رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" نبوت رخصت ہو گئی "" میرے بعد نبوت نہیں ہے "" صرف مبشرات ہونگے ، عرض کی گئی : مبشرات سے مراد کیا ہے آ نبی اکرم ﷽ نے ارشاد فرمایا : "
"11722"," حضرت سمرہ رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ ہم سے یہ فرماتے تھے :   """" ابوبکر خوابوں کی تعبیر کر لیتا ہے "" اور نیک خواب "" نبوت کا ایک حصہ ہیں """"۔   یہ روایت امام طبرانی اور امام بزار نے نقل کی ہے "" تاہم انہوں نے یہ الفاظ نقل کیے ہیں : † وہ خوابوں کی تاویل کر لیتا ہے """"۔ امام طبرانی کی سند میں ایسا راوی ہے "" جس سے میں واقف نہیں ہوں "" امام بزار کی سند ساقط ہے ۔"
"11723"," حضرت عبداللہ بن مسعود رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :"""" سچے خواب + راوی کو شک ہے "" شاید یہ الفاظ ہیں : , نیک خواب "" نبوت کے :9 اجزاء میں سے ایک جزء ہیں """"۔ یہ روایت امام طبرانی نے معجم کبیر اور معجم صغیر میں نقل کی ہے اور انہوں نے اس میں یہ الفاظ نقل کیے ہیں :"""" :3 اجزاء میں سے ایک جزء ہیں """"۔   یہ روایت امام بزار نے بھی نقل کی ہے "" معجم صغیر کے رجال صحیح کے رجال ہیں ۔"
"11724"," حضرت عبداللہ بن مسعود رضی اللہ عنہ بیان کرتے ہیں : نیک خواب "" نبوت کے ستر اجزاء میں سے ایک جزء ہیں "" اور سموم """" وہ چیز ہے "" جس کے ذریعے جنات کو پیدا کیا گیا "" یہ جہنم کے ستر اجزاء میں سے ایک جزء ہے اور تمہاری یہ + دنیاوی , آگ "" جہنم کی آگ کا سترواں حصہ ہے """"۔   یہ روایت امام طبرانی نے اپنے استاد عبداللہ بن محمد بن سعید بن ابومریم کے حوالے سے نقل کی ہے اور وہ ضعیف ہے ۔   اس روایت کے مختلف طرق ہیں ، جو اس سے پہلے مساجد کی طرف پیدل چل کر جانے اور ایک نماز کے بعد دوسری نماز کا انتظار کرنے سے متعلق باب میں گزر چکے ہیں ۔"
"11725","وَعَنْ سَمُرَةَ عَنِ النَّبِيِّ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - قَالَ: """" لَا تُصَلُّوا حِينَ تَطْلُعُ الشَّمْسُ وَلَا حِينَ تَسْقُطُ فَإِنَّهَا تَطْلُعُ بَيْنَ قَرْنَيِ الشَّيْطَانِ وَتَغْرُبُ بَيْنَ قَرْنَيِ الشَّيْطَانِ """".\nرَوَاهُ أَحْمَدُ وَالْبَزَّارُ وَالْطَبَرَانِيُّ فِي الْكَبِيرِ مِنْ طُرُقٍ بَعْضُهَا بِنَحْوِهِ، وَقَالَ فِي بَعْضِهَا: «كَانَ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَأْمُرُنَا أَنْ نُصَلِّيَ أَيَّ سَاعَةٍ شِئْنَا مِنَ اللَّيْلِ وَالنَّهَارِ غَيْرَ أَنَّهُ أَمَرَنَا أَنْ نَجْتَنِبَ طُلُوعَ الشَّمْسِ وَغُرُوبَهَا، وَقَالَ: """" إِنَّ الشَّيْطَانَ يَغِيبُ مَعَهَا حِينَ تَغِيبُ وَيَطْلُعُ مَعَهَا حِينَ تَطْلُعُ» """" وَرِجَالُ أَحْمَدَ ثِقَاتٌ."
"11726","ابو ہریرہ رضی اللہ عنہ سے، نبی ﷺ سے روایت ہے کہ آپ نے فرمایا: ""مومن بندے کی رؤیا نبوت کے چالیس حصوں میں سے ایک حصہ ہے۔"" میں نے کہا: صحیح میں اس کا حدیث ہے ""چھی اور چالیس اور پانچ اور چالیس"" حصے سے۔ اسے بزار نے روایا ہے، اور اس میں عبداللہ بن عیسی خزاز ہے، اور وہ ضعیف ہے۔"
"11727"," حضرت عوف بن مالک رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" مومن کا خواب "" نبوت کے چھیالیس اجزاء میں سے ایک جزء ہے """"۔   یہ روایت امام بزار نے نقل کی ہے "" اس کی سند میں ایک راوی یزید بن ابویزید ہے "" جو بسر بن ارطاۃ کا غلام ہے "" میں اس سے  واقف نہیں ہوں "" اس روایت کے بقیہ رجال صحیح کے رجال ہیں ۔"
"11728"," حضرت عبادہ بن صامت رضی اللہ عنہ نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :   """" مومن کا خواب ایسا کلام ہے "" جس کے ذریعے اْس کا پروردگار خواب میں بندے کے ساتھ کلام کرتا ہے """"۔   یہ روایت امام طبرانی نے نقل کی ہے اور اس کی سند میں ایسا راوی ہے "" جس سے میں واقف نہیں ہوں ۔   آگے چل کر "" اس نوعیت کی احادیث اس باب میں آئیں گی کہ جو شخص ایسا خواب دیکھے "" جو اْسے پسند ہو ۔"
"11729","ابن عمر رضی اللہ عنہ سے کہ رسول اللہ ﷺ نے فرمایا: ""سب سے بڑا جھوٹ وہ ہے جو اپنے باپ کے سوا کسی اور سے نسب جوڑے، اور سب سے بڑا جھوٹ وہ ہے جو اپنی آنکھوں سے وہ چیز دیکھنے کا دعویٰ کرے جو اس نے نہیں دیکھی، اور جس نے زمین کی حدوں کو بدلی۔"" اسے احمد نے روایا ہے، اور اس میں ابو عثمان عباس بن فضل بصری ہے اور وہ متروک ہے۔"
"11730","وَعَنْ عَبْدِ اللَّهِ بْنِ رَبَاحٍ عَنْ رَجُلٍ مِنْ أَصْحَابِ النَّبِيِّ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - «أَنَّ رَسُولَ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - صَلَّى الْعَصْرَ فَقَامَ رَجُلٌ يُصَلِّي فَرَآهُ عُمَرُ، فَقَالَ لَهُ اجْلِسْ، فَإِنَّمَا هَلَكَ أَهْلُ الْكِتَابِ أَنَّهُ لَمْ يَكُنْ لِصَلَاتِهِمْ فَضْلٌ.\nرَوَاهُ أَحْمَدُ وَأَبُو يَعْلَى، وَرِجَالُهُمَا رِجَالُ الصَّحِيحِ."
"11731"," حضرت ابوشریح خزاعی رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا : "
"11732"," حضرت عبداللہ بن عمر رضی اللہ عنہما نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :"""" نیک خواب "" نبوت کے ستر اجزاء میں سے ایک جزء ہیں "" جو شخص بھلائی کی بات دیکھے "" تو وہ اللہ تعالیٰ کی حمد بیان کرے اور اس کا ذکر کرے اور جو شخص اس کے علاوہ + یعنی کوئی ناگوار خواب , دیکھے "" تو وہ اپنے خواب کے شر سے "" اللہ کی پناہ مانگے "" اور اْس کا ذکر نہ کرے "" تو وہ خواب اْسے نقصان نہیں پہنچائے گا """"۔   یہ روایت امام احمد نے اور امام طبرانی نے معجم اوسط میں نقل کی ہے اور اس کے رجال صحیح کے رجال ہیں "" البتہ سلیمان بن دااد ہاشمی کا معاملہ مختلف ہے اور وہ ثقہ ہے ۔"
"11733"," حضرت عبداللہ بن عمرو رضی اللہ عنہ نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں + ارشاد باری تعالیٰ ہے : ,   """" ان لوگوں کے لئے دنیاوی زندگی میں خوشخبری ہے 1111111""""۔   نبی اکرم ﷽ نے ارشاد فرمایا : "
"11734"," سیدہ ام سلمہ رضی اللہ عنہما بیان کرتی ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" جب تم میں سے "" کوئی ایک شخص خواب میں وہ چیز دیکھے جسے وہ ناپسند کرے "" تو اسے اپنے بائیں طرف تین مرتبہ تھوک دینا چاہیے اور جو اْس نے دیکھا ہے "" اْس کے حوالے سے پناہ مانگنی چاہیے """"۔   یہ روایت امام احمد نے نقل کی ہے اور اس کے رجال ثقہ ہیں ۔"
"11735","وَعَنْ أَبِي أَسِيدٍ أَنَّهُ سَمِعَ رَسُولَ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ: """" «لَا صَلَاةَ بَعْدَ صَلَاةِ الْعَصْرِ» """".\nرَوَاهُ الطَّبَرَانِيُّ فِي الْكَبِيرِ، وَفِيهِ فَرْوَةُ بْنُ أَبِي فَرْوَةَ وَلَمْ أَجِدْ مَنْ ذَكَرَهُ، وَبَقِيَّةُ رِجَالِهِ ثِقَاتٌ."
"11736"," حضرت انس رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ کو اچھے خواب پسند تھے "" بعض اوقات آپ یہ دریافت کر لیتے تھے : کہ کیا تم میں سے کسی نے کوئی خواب دیکھا ہے آ راوی بیان کرتے ہیں : جب کسی شخص نے کوئی خواب دیکھا ہوتا تھا ، "
"11737"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں : انبیاء کا خواب "" وحی ہوتا ہے ۔   یہ روایت امام طبرانی نے اپنے استاد عبداللہ بن محمد بن ابومریم کے حوالے سے نقل کی ہے اور وہ ضعیف ہے "" اس روایت کے بقیہ رجال صحیح کے رجال ہیں ۔"
"11738"," عبدالرحمن بن عائش "" ایک صحابی کے حوالے سے یہ بات نقل کرتے ہیں : ایک دن نبی اکرم ﷽ ان لوگوں کے پاس تشریف لائے "" تو آپ کا مزاج خوشگوار تھا اور آپ کا چہرہ مبارک جگمگا رہا تھا "" ہم نے عرض کی : یا رسول اللہ ! ہم دیکھ رہے ہیں کہ آپ "
"11739"," حضرت عبدالرحمن بن عائش رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" میں نے اپنے پروردگار کو خوبصورت ترین شکل میں دیکھا "" اس نے فرمایا : اے محمد ! ملاء اعلیٰ کس چیز کے بارے میں بحث کر رہے ہیں آ میں نے عرض کی : اے میرے پروردگار ! تو زیادہ بہتر جانتا ہے "" تو اْس نے اپنا ہاتھ میرے دونوں کندھوں کے درمیان رکھا "" تو میں نے اْس کی ٹھنڈک اپنے سینے میں محسوس کی "" تو مجھے ان چیزوں کا علم ہو گیا "" جو کچھ آسمانوں میں اور زمین میں ہے اور پھر نبی اکرم ﷽ نے یہ آیت تلاوت کی :   """" اسی طرح ہم نے ابراہیم کو آسمانوں اور زمین کی بادشاہی دکھائی ، تاکہ وہ یقین رکھنے والوں میں ہو جائے 1111111""""۔ پھر پروردگار نے فرمایا : اے محمد ! املاء اعلیٰ کس چیز کے بارے میں بحث کر رہے ہیں آ میں نے عرض کی : کفاروں کے بارے میں "" اس نے دریافت کیا : وہ کیا چیزیں ہیں آ میں نے عرض کی : باجماعت نماز کی طرف پیدل چل کر جانا "" نماز کے علاوہ مساجد میں بیٹھے رہنا "" اور جس وقت طبیعت کو ناگوار ہو "" اْس وقت اچھی طرح وضو کرنا ۔  نبی اکرم ﷽ نے فرمایا : پروردگار نے ارشاد فرمایا : جو شخص ایسا کرے گا "" وہ بھلائی کے ساتھ زندہ رہے گا اور بھلائی کے ساتھ مرے گا "" اور اپنے گناہوں کے حوالے سے یوں ہو جائے گا "" جیسے اْس دن تھا "" جب اْس کی والدہ نے اسے جنم دیا تھا ۔ "
"11740","عَنْ وَاثِلَةَ قَالَ: «سَأَلَ سَائِلٌ رَسُولَ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ -: مَا بَالُ يَوْمِ الْجُمُعَةِ يُؤَذَّنُ فِيهَا بِالصَّلَاةِ نِصْفَ النَّهَارِ وَقَدْ نَهَيْتَ فِي سَائِرِ الْأَيَّامِ؟ فَقَالَ: """" إِنَّ اللَّهَ - عَزَّ وَجَلَّ - يُسَعِّرُ جَهَنَّمَ كُلَّ يَوْمٍ نِصْفَ النَّهَارِ وَيُخْبِيهَا يَوْمَ الْجُمُعَةِ» """".\nرَوَاهُ الطَّبَرَانِيُّ فِي الْكَبِيرِ، وَفِيهِ بَشِيرُ بْنُ عَوْنٍ قَالَ ابْنُ حِبَّانَ: رَوَى مِائَةَ حَدِيثٍ كُلُّهَا مَوْضُوعَةٌ."
"11741"," ایک روایت میں یہ الفاظ ہیں : خالد بن لجلاج بیان کرتے ہیں : میں نے حضرت عبدالرحمن بن عائش رضی اللہ عنہ کو یہ بیان کرتے ہوئے سنا ہے :"""" ایک دن صبح نبی اکرم ﷽ ہمارے پاس تشریف لائے 1111111"""" اس کے بعد راوی نے "" اس سے پہلے والی روایت کی مانند روایت نقل کی ہے ۔  یہ تمام روایات امام طبرانی نے نقل کی ہیں اور اس حدیث کے رجال جس میں یہ مذکور ہے کہ نبی اکرم ﷽ ہمارے پاس تشریف لائے "" وہ رجال ثقہ ہیں "" اسی طرح پہلی روایت کے رجال بھی ہیں اور درمیانی روایت میں ایک راوی معاویہ بن عمران حرمی ہے اور میں اْس سے واقف نہیں ہوں ۔   امام احمد بن حنبل سے "" حضرت عبدالرحمن بن عائش رضی اللہ عنہ کے نبی اکرم ﷽ سے یہ حدیث نقل کرنے کے بارے میں دریافت کیا گیا "" تو انہوں نے یہ بات ذکر کی کہ یہ درست ہے "" اس کا مفہوم یہی بنتا ہے ۔"
"11742"," حضرت ثوبان رضی اللہ عنہ بیان کرتے ہیں : ایک مرتبہ نبی اکرم ﷽ صبح کی نماز کے بعد "" ہمارے پاس تشریف لائے "" آپ ﷽ نے ارشاد فرمایا :   """" گزشتہ رات میرا پروردگار "" میرے پاس خوبصورت ترین شکل میں آیا اور اس نے فرمایا : اے محمد ! کیا تم جانتے ہو آ ملاء اعلیٰ کس چیز کے بارے میں بحث کر رہے ہیں آ میں نے عرض کی : جی نہیں ! راوی بیان کرتے ہیں : پھر آپ نے کچھ چیزیں ذکر کیں پھر فرمایا : میرے سامنے آسمان اور زمین کے درمیان موجود چیزیں ظاہر ہو گئیں "" نبی اکرم ﷽ فرماتے ہیں : تو میں نے عرض کی جی ہاں ! وہ کفاروں اور درجات کے بارے میں گفتگو کر رہے ہیں ، جہاں تک درجات کا تعلق ہے "" تو وہ کھانا کھلانا "" سلام پھیلانا اور رات کو اس وقت نماز ادا کرنا ہے "" جب لوگ سو رہے ہوں اور جہاں تک کفاروں کا تعلق ہے "" تو وہ باجماعت نماز کے لئے پیدل چل کر جانا "" طبیعت کو ناگوار گزرنے کے وقت اچھی طرح وضو کرنا اور نماز ادا کرنے لینے کے بعد مسجد میں بیٹھنا ہے "" پھر پروردگار نے فرمایا : اے محمد ! تم بولو سنا جائے گا "" تم مانگو "" تمہیں دیا جائے گا """"۔   نبی اکرم ﷽ فرماتے ہیں : میں نے عرض کی : تو مجھے تعلیم دے ! تو پروردگار نے فرمایا : تم یہ پڑھو : "
"11743"," حضرت عبداللہ بن عمر رضی اللہ عنہما بیان کرتے ہیں : نبی اکرم ﷽ کو صبح کی نماز کے لئے "" اپنے اصحاب کے پاس آنے میں تاخیر ہو گئی "" یہاں تک کہ لوگ یہ کہنے لگے کہ شاید سورج طلوع ہونے والا ہے "" پھر آپ تشریف لائے "" آپ نے ان لوگوں کو صبح کی نماز پڑھائی ، پھر آپ نے ارشاد فرمایا : تم لوگ اپنی اپنی جگہ پر بیٹھے رہو "" پھر آپ اْن کی طرف متوجہ ہوئے اور ان سے فرمایا : کیا تم لوگ یہ بات جانتے ہو کہ کس چیز نے مجھے تمہارے پاس آنے سے روکے رکھا آ لوگوں نے عرض کی : اللہ اور اس کا رسول زیادہ بہتر جانتے ہیں ، نبی اکرم ﷽ نے ارشاد فرمایا : میں نے اپنی جائے نماز پر "" نماز ادا کی "" پھر میرے کانوں پر بندش ڈال دی گئی + یعنی میری آنکھ لگ گئی یا میری توجہ دنیا سے ہٹ گئی , میرا پروردگار میرے پاس بہترین صورت میں آیا "" اْس نے فرمایا : اے محمد ! میں نے عرض کی : اے میرے پروردگار ! میں حاضر ہوں اور سعادت تیری طرف سے حاصل ہو سکتی ہے "" اس نے دریافت کیا : ملاء اعلیٰ کس چیز کے بارے میں گفتگو کر رہے ہیں آ میں نے عرض کی : اے میرے پروردگار ! میں نہیں جانتا ، پھر اْس نے اپنا ہاتھ میرے دونوں کندھوں کے درمیان رکھا "" یہاں تک کہ میں نے اْس کی ٹھنڈک اپنے سینے کے درمیان محسوس کی اور میں نے وہ چیز جان لی "" جس کے بارے میں اس نے مجھ سے پوچھا تھا ، پھر اس نے فرمایا : اے محمد ! میں نے عرض کی : میں حاضر ہوں "" اے میرے پروردگار ! اور سعادت مندی تیری طرف سے حاصل ہو سکتی ہے "" اس نے دریافت کیا : ملاء اعلیٰ کسی چیز کے بارے میں گفتگو کر رہے ہیں آ میں نے عرض کی : کفاروں کے بارے میں "" اور درجات کے بارے میں "" اس نے دریافت کیا : کفارات کیا ہیں آ اور درجات کیا ہیں آ میں نے عرض کی : کفارات یہ ہیں : طبیعت کو ناگوار گزرنے کے وقت اچھی طرح وضو کرنا "" باجماعت نماز کے لئے پیدل چل کر جانا اور نمازوں کے بعد مساجد میں بیٹھے رہنا "" اور جہاں تک درجات کا تعلق ہے "" تو وہ کھانا کھلانا "" پاکیزہ گفتگو کرنا اور رات کے وقت سجدے کرنا ہے "" جب لوگ سو رہے ہوں "" میرے پروردگار نے مجھ سے فرمایا : اے محمد ! تم مجھ سے مانگو ! میں نے عرض کی :"""" میں تجھ سے بھلائی کے کام سر انجام دینے "" منکرات کو ترک کرنے اور مسکینوں سے محبت کرنے کا سوال کرتا ہوں "" اور تجھ سے یہ چیز مانگتا ہوں "" کہ تو میری مغفرت کر دے اور تو مجھ پر رحم کر اور جب تو کسی قوم کے لئے کسی آزمائش کا ارادہ کرے "" تو مجھے ایسی حالت میں موت دینا کہ میں آزمائش سے محفوظ رہوں ۔   اے اللہ ! میں تجھ سے تیری محبت اور ایسے عمل کی محبت کا سوال کرتا ہوں ، جو مجھے تیری محبت کے قریب کر دے ۔   اے اللہ ! میں تجھ سے ایسے ایمان کا سوال کرتا ہوں کہ جو میرے دل میں یوں پیوست ہو جائے کہ میں یہ بات جان لوں کہ مجھے صرف وہی چیز نصیب ہو گی "" جو میرے نصیب میں لکھی ہوئی ہے اور اس چیز کے حوالے سے رضا مندی کا سوال کرتا ہوں ، جو تو نے میرے بارے میں فیصلہ دیا ہو """"۔   یہ روایت امام بزار نے نقل کی ہے اس کی سند میں ایک راوی سعید بن سنان ہے اور وہ ضعیف ہے ، بعض حضرات نے اسے "
"11744","حضرت ابوامامہ رضی اللہ عنہ نبی اکرم ﷺ کا یہ فرمان نقل کرتے ہیں : """" میرا پروردگار "" میرے پاس بہترین صورت میں آیا اس نے فرمایا : اے محمد ! میں نے عرض کی : میں حاضر ہوں اور سعادت مندی تیری طرف سے حاصل ہو سکتی ہے "" اس نے دریافت کیا : ملاؤ اعلیٰ کس چیز کے بارے میں گفتگو کر رہے ہیں ء میں نے عرض کی : مجھے نہیں معلوم "" تو اس نے اپنا ہاتھ میرے سینے کے درمیان رکھا ، تو میں نے اپنی جگہ پر موجود رہتے ہوئے "" اْس چیز کے بارے میں جان لیا "" جس کے بارے میں اس نے مجھ سے دریافت کیا تھا ، خواہ اس کا تعلق دنیا کے امور سے ہو "" یا آخرت سے ہو "" اس نے دریافت کیا : ملاؤ اعلیٰ کس چیز کے بارے میں بحث کر رہے ہیں ء تو میں نے عرض کی : درجات کے بارے میں اور کفارات کے بارے میں ، جہاں تک درجات کا تعلق ہے "" تو اس میں سردی کے موسم میں اچھی طرح وضو کرنا "" اور ایک نماز کے بعد دوسری نماز کا انتظار کرنا شامل ہے "" پروردگار نے فرمایا : تم نے سچ کہا ہے "" جو شخص ایسا کرے گا وہ بھلائی کے ساتھ زندہ رہے گا اور بھلائی کے ساتھ مرے گا اور اپنے گناہوں کے حوالے سے یوں ہو جائے گا "" جیسے اْس دن تھا "" جب اس کی والدہ نے اسے جنم دیا تھا ( نبی اکرم ﷺ نے فرمایا : ) جہاں تک کفارات کا تعلق ہے "" تو وہ کھانا کھلانا "" سلام پھیلانا "" پاکیزہ گفتگو کرنا اور رات کے وقت "" اْس وقت نماز ادا کرنا ہے "" جب لوگ سو رہے ہوں ، پھر نبی اکرم ﷺ نے کہا : """" اے اللہ ! میں تجھ سے یہ دعا مانگتا ہوں کہ میں نیکیاں کروں اور برائیاں ترک کر دوں اور مسکینوں سے محبت رکھوں اور مغفرت مانگتا ہوں ، اور یہ مانگتا ہوں کہ تو میری توبہ قبول فرما لے اور جب تو کسی قوم کو فتنے میں مبتلا کرنے کا ارادہ کرے "" تو مجھے ایسی حالت میں نجات دینا کہ میں فتنے سے محفوظ رہوں """"۔ یہ روایت امام طبرانی نے نقل کی ہے "" اس کی سند میں ایک راوی لیث بن ابوسلیم ہے اور وہ ضعیف ہونے کے باوجود حسن الحدیث ہے اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"11745"," حضرت ابی بن کعب رضی اللہ عنہ کی اہلیہ "" سیدہ ام طفیل رضی اللہ عنہا بیان کرتی ہیں : میں نے نبی اکرم ﷽ کو یہ ارشاد فرماتے  ہوئے سنا ہے :   """" میں نے اپنے پروردگار کو ایک نوجوان کی شکل میں خواب میں دیکھا ، جس کے بال بڑے تھے اس نے موزے پہنے ہوئے تھے "" اور اس پر سونے کے جوتے پہنے ہوئے تھے اور اس کے چہرے پر سونے کا فراش تھا 1111111"""" اس کے بعد راوی نے پوری حدیث ذکر کی ہے ۔   یہ روایت امام طبرانی نے نقل کی ہے "" ابن حبان کہتے ہیں :   یہ منکر حدیث ہے "" کیونکہ عمارہ بن عامر بن حزم انصاری نے سیدہ ام طفیل رضی اللہ عنہا سے سماع نہیں کیا ہے "" انہوں نے کتاب """" الثقات """" میں عمارہ نامی راوی کے حالات میں یہ بات ذکر کی ہے ۔"
"11746"," حضرت عبدالرحمن بن سمرہ رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ تشریف لائے "" آپ ﷽ نے ارشاد فرمایا :"""" میں نے گزشتہ رات حیران کن خواب دیکھا ہے "" میں نے اپنی امت کے ایک شخص کو دیکھا "" جسے فرشتوں نے گھیر لیا تھا ، پھر اس کا وضو اس کے پاس آیا اور اسے اس چیز سے بچا لیا "" میں نے اپنی امت کے ایک شخص کو دیکھا جس پر قبر کا عذاب مسلط کیا جا رہا تھا ، پھر اس کی نماز اس کے پاس آئی اور اس نے اس شخص کو اس عذاب سے بچا لیا "" میں نے اپنی امت کے ایک شخص کو دیکھا "" جسے شیاطین نے گھیر لیا تھا "" تو اللہ کا ذکر اس شخص کے پاس آیا "" تو اْس ذکر نے اس شخص کو ان شیاطین سے نجات دلوائی میں نے اپنی امت کے ایک شخص کو دیکھا ، جو پیاس کی شدت کی وجہ سے زبان باہر نکالے ہوئے تھا ، تو رمضان کا روزہ اس کے پاس آیا اور اس نے اسے پانی پلایا "" میں نے اپنی امت کے ایک شخص کو دیکھا جس کے آگے تاریکی تھی اور اس کے پیچھے تاریکی تھی اس کے دائیں طرف تاریکی تھی اس کے بائیں طرف تاریکی تھی اس کے اوپر تاریکی تھی اس کے نیچے تاریکی تھی "" تو اس کا حج اور اس کا عمرہ اس کے پاس آئے اور اْن دونوں نے اس شخص کو تاریکی سے نکال دیا "" میں نے اپنی امت کے ایک شخص کو دیکھا کہ ملک الموت اس کی روح قبض کرنے کے لئے "" اس کے پاس آیا "" تو صلہ رحمی اس شخص کے پاس آئی اور بولی : یہ شخص صلہ رحمی کرنے والا تھا ، تو اس نے ان کے ساتھ بات چیت کی "" اور انہوں نے اس کے ساتھ بات چیت کی "" تو وہ اْن کے ساتھ ہو گیا ۔ "
"11747"," حضرت جابر بن عبداللي رضی اللہ عنہما نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :"""" میں نے خواب میں دیکھا کہ جیسے میرے پاس کھجوروں کا گچھا آیا "" میں نے ایک کجھور کو اپنے منہ میں ڈالا "" تو میں نے اس میں ایسی گٹھلی پائی "" جس نے مجھے تکلیف پہنچائی "" تو میں نے اسے پھینک دیا "" پھر میں نے ایک اور کھجور لی اور اسے اپنے منہ میں ڈالا "" تو میں نے اس میں بھی گٹھلی پائی ، میں نے اسے بھی پھینک دیا "" پھر میں نے ایک اور کھجور لی "" میں نے اس میں بھی گٹھلی پائی "" تو میں نے اسے بھی پھینک دیا """"۔ "
"11748"," حضرت سمرہ بن جندب رضی اللہ عنہ بیان کرتے ہیں : ایک صاحب نے یہ بات بیان کی ہے : نبی اکرم ﷽ نے ارشاد فرمایا : "
"11749"," حضرت جعدہ رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے ایک شخص کو خواب میں دیکھا "" نبی اکرم ﷽ نے اسے پیغام بھیج کر بلوایا "" وہ آپ کے پاس آیا "" نبی اکرم ﷽ نے اسے خواب سنانا شروع کیا "" راوی کہتے ہیں : وہ ایک ایسا شخص تھا ، جس کا پیٹ بڑا تھا ، تو نبی اکرم ﷽ نے اپنی انگلی اس کے پیٹ پر لگاتے ہوئے کہا : کہ اگر یہ + یعنی پیٹ کی چربی "" یا موٹاپا , اس کے علاوہ کہیں اور ہوتا "" تو یہ تمہارے حق میں زیادہ بہتر تھا ۔   یہ روایت امام احمد نے نقل کی ہے اور اس کے رجال ثقہ ہیں ۔"
"11750"," حضرت انس رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :"""" میں نے خواب میں دیکھا کہ جیسے میری تلوار کی دھار ٹوٹ گئی ہے اور جیسے میں ایک دنبے کو پیچھے بٹھائے ہوئے ہوں "" تو میں نے اس کی یہ تعبیر کی ہے کہ میری تلوار کی دھار ٹوٹنے سے مراد "" میری قوم کا ایک شخص قتل ہو جائے گا "" اور میرے دنبے کو پیچھے بٹھانے سے مراد یہ ہے کہ میں دشمن کے ایک شخص کو قتل کروں گا """"۔  راوی کہتے ہیں : تو نبی اکرم ﷽ نے مشرکین کے علم بردار طلحہ بن ابوطلحہ کو قتل کیا اور حضرت حمزہ بن عبدالمطلب رضی اللہ عنہ شہید ہوئے ۔   یہ روایت امام بزار نے نقل کی ہے اور امام احمد نے اختصار کے ساتھ نقل کی ہے اس کی سند میں ایک راوی علی بن زید ہے اور وہ ثقہ ہے لیکن خراب حافظے کا مالک ہے ان دونوں روایات کے رجال ثقہ ہیں ۔"
"11751"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں : غزوہ بدر کے موقع پر "" نبی اکرم ﷽ نے اپنی تلوار """" ذالفقار """" نفل کے طور پر دی اور یہ وہی تلوار ہے کہ جس کے بارے میں آپ نے غزوہ احد کے موقع پر خواب میں دیکھا اور ارشاد فرمایا : کہ میں نے یہ دیکھا ہے کہ جیسے میری تلوار """" ذوالفقار """" کی دھار خراب ہو گئی ہے "" تو میں نے اس کی تعبیر یہ کی ہے کہ تم میں سے لوگ مارے جائیں گے اور میں نے خواب میں دیکھا کہ میں نے دنبے کو پیچھے بٹھایا ہوا ہے "" تو میں نے اس کی تعبیر یہ کی ہے کہ یہ دشمن کا دنبہ ہے اور میں نے خواب دیکھا کہ جیسے میں ایک محفوظ زرہ میں ہوں "" تو میں نے اس کی تعبیر یہ کی ہے کہ اس سے مراد مدینہ منورہ ہے اور میں نے گائے کو دیکھا کہ اْسے ذبح کیا گیا ہے "" تو اللہ کی قسم ! گائے کی تعبیر اچھی ہی ہو گی "" اللہ کی قسم ! گائے کی تعبیر اچھی ہی ہو گی ۔  راوی کہتے ہیں : تو اْسی طرح ہوا "" جس طرح نبی اکرم ﷽ نے ارشاد فرمایا تھا ۔   یہ روایت امام بزار نے نقل کی ہے اور امام طبرانی نے اس سیاق کے بغیر نقل کی ہے اس سے پہلے اس روایت کا ایک طریق غزوہ احد سے متعلق باب میں گزر چکا ہے اس روایت کی سند میں ایک راوی عبدالرحمن بن ابوزناد ہے اور وہ ضعیف ہے ۔"
"11752"," حضرت ابوسعید خدری رضی اللہ عنہ بیان کرتے ہیں : میں نے نبی اکرم ﷽ کو یہ ارشاد فرماتے ہوئے سنا ہے :   """" میں خواب میں "" شب قدر کو دیکھا ، پھر وہ مجھے بھلا دی گئی "" پھر میں نے اپنے ہاتھ میں سونے کے بنے ہوئے دو کنگن دیکھے "" مجھے وہ برے لگے "" میں نے ان کو پھونک ماری تو وہ اْڑ گئے میں نے اس کی یہ تعبیر کی ہے کہ اس سے مراد "" نبوت کے دو جھوٹے دعویدار ہیں ایک وہ جو یمن سے تعلق رکھتا ہے "" اور ایک وہ جو یمامہ سے تعلق رکھتا ہے """"۔ "
"11753"," حضرت عبداللہ بن عمر رضی اللہ عنہما بیان کرتے ہیں : "
"11754"," حضرت ابوقتادہ رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا : "
"11755","وَعَنْ عَبْدِ اللَّهِ بْنِ الزُّبَيْرِ قَالَ: قَالَ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ -: """" «مَا مِنْ صَلَاةٍ مَفْرُوضَةٍ إِلَّا وَبَيْنَ يَدَيْهَا رَكْعَتَانِ» """".\nرَوَاهُ الطَّبَرَانِيُّ فِي الْكَبِيرِ وَالْأَوْسَطِ، وَفِيهِ سُوِيدُ بْنُ عَبْدِ الْعَزِيزِ وَهُوَ ضَعِيفٌ."
"11756"," حضرت ابوقتادہ رضی اللہ عنہ "" نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں : "
"11757"," حضرت ابوسعید خدری رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" جس نے مجھے خواب میں دیکھا "" اْس نے مجھے ہی دیکھا "" کیونکہ شیطان "" میری "" یا کعبہ کی شکل اختیار نہیں کر سکتا """"۔   یہ روایت امام طبرانی نے معجم صغیر اور معجم اوسط میں نقل کی ہے "" اس کی سند میں ایک راوی محمد بن ابوسری ہے "" جسے یحییٰ بن معین اور دیگر حضرات نے ثقہ قرار دیا ہے "" اس میں کمزوری پائی جاتی ہے اس روایت کے بقیہ رجال صحیح کے رجال ہیں ۔"
"11758"," حضرت عبداللہ بن عمرو رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :"""" جس نے مجھے خواب میں دیکھا "" گویا اْس نے مجھے بیداری میں دیکھا + یعنی درحقیقت اْس نے مجھے ہی دیکھا ,   اور شیطان میری شکل اختیار نہیں کر سکتا ہے """"۔   یہ روایت امام طبرانی نے معجم اوسط اور معجم کبیر میں نقل کی ہے "" اور ان کی روایت کے الفاظ یہ ہیں :   """" جس نے مجھے خواب میں دیکھا "" تو گویا اْس نے مجھے بیداری میں دیکھا اور جس نے مجھے دیکھا "" اْس نے حق کو دیکھا کیونکہ شیطان میری شکل و صورت اختیار نہیں کر سکتا ہے """"۔  اس روایت کے رجال ثقہ ہیں ۔"
"11759"," حضرت ابوبکرہ رضی اللہ عنہ نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں : "
"11760","عَنْ أَنَسِ بْنِ مَالِكٍ «أَنَّهُ لَمْ يَرَ رَسُولَ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - صَلَّى الضُّحَى قَطُّ إِلَّا أَنْ يَخْرُجَ فِي سَفَرٍ أَوْ يَقْدِمَ مِنْ سَفَرٍ».\nرَوَاهُ أَحْمَدُ وَأَبُو يَعْلَى إِلَّا أَنَّهُ قَالَ: «كَانَ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - لَا يُصَلِّي الضُّحَى إِلَّا أَنْ يَقْدِمَ مِنْ سَفَرٍ أَوْ يَخْرُجَ» وَكَّلَاهُمَا رَوَاهُ عُبَيْدُ اللَّهِ بْنُ رَوَّاحَةَ قَالَ: حَدَّثَنِي أَنَسٌ.\nقُلْتُ: وَلَمْ أَجِدْ مَنْ ذَكَرَهُ، وَأَغْفَلَهُ الشَّرِيفُ."
"11761"," حضرت عبداللہ بن مسعود رضی اللہ عنہ فرماتے ہیں : جو شخص اللہ تعالیٰ کے رسول ﷽ کو + خواب میں , دیکھتا ہے تو یہ محض اس کا خیال نہیں ہوتا + بلکہ اس نے واقعی اللہ تعالیٰ کے رسول ﷽ کو دیکھا ہوتا ہے , ۔   یہ روایت امام طبرانی نے نقل کی ہے اور اس کے رجال ثقہ ہیں ۔"
"11762"," حضرت خزیمہ بن ثابت رضی اللہ عنہ بیان کرتے ہیں : میں نے خواب میں دیکھا کہ میں نبی اکرم ﷽ کی پیشانی پر سجدہ کر رہا ہوں ، میں نے نبی اکرم ﷽ کو اس بارے میں بتایا "" تو نبی اکرم ﷽ نے ارشاد فرمایا : "
"11763"," یہ روایت امام طبرانی نے نقل کی ہے "" تاہم اس میں ان کے یہ الفاظ ہیں : نبی اکرم ﷽ نے ان سے فرمایا :   """" تم بیٹھ کر سجدہ کرو اور اس طرح کرو "" جس طرح تم نے "
"11764"," ابن شہاب نے "" عمارہ بن خزیمہ بن ثابت انصاری کے حوالے سے "" یہ روایت نقل کی ہے : حضرت خزیمہ رضی اللہ عنہ وہ صحابی ہیں کہ جن کی گواہی کو "" نبی اکرم ﷽ نے دو آدمیوں کی گواہی کے برابر قرار دیا تھا ، ابن شہاب بیان کرتے ہیں : عمارہ بن خزیمہ نے ""  اپنے چچا کے حوالے سے "" یہ بات نقل کی ہے "" وہ نبی اکرم ﷽ کے صحابی ہیں "" وہ بیان کرتے ہیں :   حضرت خزیمہ بن ثابت رضی اللہ عنہ نے خواب میں یہ دیکھا کہ وہ نبی اکرم ﷽ کی پیشانی پر سجدہ کر رہے ہیں "" نبی اکرم ﷽ تشریف لائے تو انہوں نے نبی اکرم ﷽ کے سامنے یہ بات ذکر کی "" تو نبی اکرم ﷽ لیٹ گئے اور حضرت خزیمہ رضی اللہ عنہ نے نبی اکرم ﷽ کی پیشانی پر سجدہ کیا ۔   یہ روایت امام احمد نے "" اپنے استاد عامر بن صالح زبیری کے حوالے سے نقل کی ہے "" جسے امام احمد اور ابوحاتم نے ثقہ قرار دیا ہے اور ایک جماعت نے اسے ضعیف کہا ہے "" اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"11765","وَعَنْ أَبِي هُرَيْرَةَ قَالَ: «بَعَثَ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - بَعْثًا فَأَعْظَمُوا الْغَنِيمَةَ وَأَسْرَعُوا الْكَرَّةَ فَقَالَ رَجُلٌ: يَا رَسُولَ اللَّهِ مَا رَأَيْنَا بَعْثًا قَطُّ أَسْرَعَ كَرَّةً وَلَا أَعْظَمَ غَنِيمَةً مِنْ هَذَا الْبَعْثِ! فَقَالَ:» أَلَا أُخْبِرُكُمْ بِأَسْرَعَ كَرَّةً مِنْهُ وَأَعْظَمَ غَنِيمَةً؟ رَجُلٌ تَوَضَّأَ (فِي بَيْتِهِ) فَأَحْسَنَ الْوُضُوءَ ثُمَّ عَمَدَ إِلَى الْمَسْجِدِ فَصَلَّى فِيهِ الْغَدَاةَ ثُمَّ عَقَّبَ بِصَلَاةِ الضَّحْوَةِ فَقَدْ أَسْرَعَ وَأَعْظَمَ الْغَنِيمَةَ """".\nرَوَاهُ أَبُو يَعْلَى وَرِجَالُهُ رِجَالُ الصَّحِيحِ."
"11766"," مثنی بن سعید بیان کرتے ہیں : میں نے حضرت انس رضی اللہ عنہ کو یہ فرماتے ہوئے سنا ہے :   """" مجھے اکثر اوقات "" خواب میں اپنے خلیل ﷽ کی زیارت ہو جاتی ہے """"۔  راوی کہتے ہیں : جب حضرت انس رضی اللہ عنہ یہ بات بیان کرتے تھے "" تو اْن کی آنکھوں سے آنسو جاری ہو جاتے تھے ۔   یہ روایت امام احمد نے نقل کی ہے اور اس کے رجال صحیح کے رجال ہیں ۔"
"11767"," حضرت ابوہریرہ رضی اللہ عنہ "" نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں : "
"11768"," حضرت ابوطفیل رضی اللہ عنہ "" نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :   """" میں نے خواب میں سیاہ رنگ کی بکریاں دیکھیں ، جن کے پیچھے """" مٹیالے رنگ کی بکریاں تھیں ، میں نے ان کی تعبیر یہ کی ہے کہ سیاہ بکریوں سے مراد "" عرب ہیں اور مٹیالی بکریوں سے مراد "" عجمی ہیں """"۔   یہ روایت امام بزار نے نقل کی ہے اس کی سند میں ایک راوی علی بن زید ہے اور وہ ثقہ ہے اور خراب حافظے کا مالک ہے "" اس روایت کے بقیہ رجال صحیح کے رجال ہیں ۔"
"11769","ابو ہریرہ رضی اللہ عنہ سے، نبی ﷺ سے روایت ہے کہ آپ نے فرمایا: ""خواب میں دودھ فطرت ہے۔"" اسے بزار نے روایا ہے، اور اس میں محمد بن مروان ہے، اور وہ ثقتہ ہے، لیکن اس میں لين ہے، اور اس کے باقی رواة ثقات ہیں۔"
"11770","وَعَنِ النَّوَّاسِ بْنِ سَمْعَانَ قَالَ: سَمِعْتُ رَسُولَ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ: """" «قَالَ اللَّهُ - عَزَّ وَجَلَّ -: ابْنَ آدَمَ لَا تَعْجِزَنَّ مِنْ أَرْبَعِ رَكَعَاتٍ فِي أَوَّلِ النَّهَارِ أَكْفِكَ آخِرَهُ» """".\nرَوَاهُ الطَّبَرَانِيُّ فِي الْكَبِيرِ وَرِجَالُهُ ثِقَاتٌ."
"11771"," حضرت ابوبکرہ رضی اللہ عنہ "" نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں : "
"11772"," حضرت ابن زمیل جہنی رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ جب صبح کی نماز پڑھ لیتے تھے "" تو اپنی ٹانگ موڑ کر یہ ارشاد فرماتے تھے : + یعنی یہ پڑھتے تھے : ,   """" اللہ تعالیٰ کی ذات "" ہر عیب سے پاک ہے اور حمد "" اس کے لئے مخصوص ہے اور میں اللہ تعالیٰ سے مغفرت طلب کرتا ہوں "" بے شک وہ بہت زیادہ توبہ قبول کرنے والا ہے """"۔ "
"11773"," حضرت عبداللہ بن عمرو رضی اللہ عنہ بیان کرتے ہیں : میں نے خواب میں دیکھا کہ جیسے میری انگلیوں میں سے ایک میں گھی ہے اور دوسری میں شہد ہے اور میں ان دونوں کو چاٹ رہا ہوں "" اگلے دن میں نے اس کا ذکر "" نبی اکرم ﷽ سے کیا "" تو نبی اکرم ﷽ نے ارشاد فرمایا :"""" تم نے دو کتابوں کا علم حاصل کیا ہے "" تورات   اور قرآن مجید """"۔   راوی کہتے ہیں : انہوں نے یہ دونوں کتابیں پڑھی ہوئی تھیں "
"11774"," ذکریا بن ابراہیم بن عبداللہ بن مطیع "" اپنے والد کے حوالے سے "" اپنے دادا کا یہ بیان نقل کرتے ہیں :   """" حضرت مطیع بن اسود رضی اللہ عنہ نے خواب میں دیکھا کہ انہیں کھجوروں کا توڑا تحفے کے طور پر دیا گیا ہے "" انہوں نے نبی اکرم ﷽ کے سامنے اس بات کا ذکر کیا "" تو نبی اکرم ﷽ نے دریافت کیا : کیا تمہاری بیویوں میں سے کوئی حاملہ ہے آ   انہوں نے فرمایا : جی ہاں ! بنولیث سے تعلق رکھنے والی "
"11775"," حضرت ابوبکرہ رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے دریافت کیا : تم میں سے کسی نے کوئی + نمایاں قسم کا , خواب دیکھا ہے آ تو سیدہ عائشہ رضی اللہ عنہا نے عرض کی : یا رسول اللہ ! میں نے دیکھا کہ """" تین چاند """" اتر کر میرے حجرے میں آ گئے ہیں "" نبی اکرم ﷽ نے ان سے فرمایا : اگر تمہارا خواب سچ ہوا "" تو تمہارے گھر میں + راوی کہتے ہیں : میرا خیال ہے "" روایت میں یہ الفاظ بھی ہیں : , اہل جنت کے افضل ترین لوگ دفن ہوں گے "" راوی کہتے ہیں : پھر نبی اکرم ﷽ کا وصال ہوا "" تو آپ ﷽ + ان تینوں , چاندوں میں سب سے زیادہ فضیلت والے تھے "" پھر حضرت ابوبکر رضی اللہ عنہ کا انتقال ہوا "" پھر حضرت عمر رضی اللہ عنہ کا انتقال ہوا "" تو یہ حضرات "" سیدہ عائشہ رضی اللہ عنہا کے حجرے میں دفن ہوئے ۔   یہ روایت امام طبرانی نے نقل کی ہے "" اس کی سند میں ایک راوی عمر بن سعید ابح ہے اور وہ ضعیف ہے ۔"
"11776"," ایوب نے "" نافع کے حوالے سے "" حضرت عبداللہ بن عمر رضی اللہ عنہما سے "" یا شاید محمد بن سیرین کے حوالے سے "" سیدہ عائشہ رضی اللہ عنہا سے یہ روایت نقل کی ہے : انہوں نے یہ بات بیان کی ہے :   """" میں نے خواب میں دیکھا کہ جیسے تین چاند اتر کر میرے حجرے میں آ گئے ہیں ، تو حضرت ابوبکر رضی اللہ عنہ نے فرمایا : "
