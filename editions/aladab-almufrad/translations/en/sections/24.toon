hadiths[23]{hadithnumber,text}:
"421","'Abdullah said"
"422","Ibn 'Abbas said"
"423","Abu Hurayra reported that the Prophet"
"424","As 423"
"425","The Prophet"
"426","The Prophet"
"427","'Iyad ibn Himar said"
"428","'Iyad ibn Himar reported that the Messenger of Allah"
"429","Sa'id ibn Malik reported that the Prophet"
"430","Anas said"
"431","'Abdullah reported that the Prophet"
"432","Abu Dharr is reported as saying that he heard the Prophet"
"433","Abu Dharr states that he heard the Prophet"
"434","Sulayman ibn Surad"
"435","'Abdullah said"
"436","'A'isha said"
"437","Anas said"
"438","'Ali said. """"The Prophet"
"439","'Abdullah ibn 'Umar reported that the Messenger of Allah"
"440","'Abdullah ibn 'Umar reported that the Messenger of Allah"
"441","Abu Hurayra reported that the Prophet"
"442","Abu Hurayra reported that the Messenger of Allah"
"443","In commenting on the words of Allah Almighty"
