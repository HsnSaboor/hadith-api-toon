hadiths[count]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"15031","(۱۵۰۳۱) حدَّثَنَا مَعْنٌ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ لاَ یَقْرِنُ بَیْنَ السَّبُوعِ ، وَیُصَلِّی لِکُلِّ أُسْبُوعٍ رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 15031","","","كتاب الحج"
"15032","(۱۵۰۳۲) حدَّثَنَا مَعْنُ بْنُ عِیسَی، عَنْ ثَابِتِ بْنِ قَیْسٍ، قَالَ: رَأَیْتُ عِرَاکَ بْنَ مَالِکٍ یُصَلِّی عِنْدَ کُلِّ سُبُوعٍ رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 15032","","","كتاب الحج"
"15033","(۱۵۰۳۳) حدَّثَنَا حَفْصٌ، عَنْ عَمْرٍو، عَنِ الْحَسَنِ، قَالَ: لِکُلِّ سُبُوعٍ رَکْعَتَانِ، لاَ یُجْزِئُ مِنْہُمَا تَطَوُّعٌ، وَلاَ فَرِیضَۃٌ۔","","Musannaf Ibn Abi Shaybah 15033","","","كتاب الحج"
"15034","(۱۵۰۳۴) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : سُئِلَ عَطَائٌ عَنِ الصَّیْدِ یُؤْخَذُ فِی الْحِلِّ ، فَیُذْبَحُ فِی الْحَرَمِ ؟ فَقَالَ : کَانَ الْحَسَنُ بْنُ عَلِیٍّ ، وَعَائِشَۃُ ، وَابْنُ عُمَرَ یَکْرَہُونَہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 15034","","","كتاب الحج"
"15035","(۱۵۰۳۵) حدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ؛ أَنَّہُمَا کَانَ یَکْرَہَانِ أَنْ یُدْخَلَ الصَّیْدُ الْحَرَمَ ، ثُمَّ یُذْبَحَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 15035","","","كتاب الحج"
"15036","(۱۵۰۳۶) حدَّثَنَا أَبُو دَاوُدَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ أَنَّہُ لَمْ یَرَ بَأْسًا بِالصَّیْدِ یَصْطَادُہُ الْحَلاَلُ فِی الْحِلِّ ، أَنْ یَأْکُلَہُ الْحَلاَلُ فِی الْحَرَمِ ، قَالَ : کَانَ ابْنُ عَبَّاسٍ یَکْرَہُہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 15036","","","كتاب الحج"
"15037","(۱۵۰۳۷) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِالْہَدْیِ إذَا عَطِبَ أَنْ یَبِیعَہُ وَیَسْتَعِینَ بِثَمَنِہِ فِی ہَدْیٍ آخَرَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15037","","","كتاب الحج"
"15038","(۱۵۰۳۸) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّہُ قَالَ فِی رَجُلٍ لَبَّی بِعُمْرَۃٍ ، ثُمَّ وَقَعَ بِامْرَأَتِہِ قَبْلَ أَنْ یَقْضِیَ عُمْرَتَہُ ، قَالَ : یُعِیدُ عُمْرَۃً ، وَیُہْدِی بَدَنَۃً۔",": No Data Available","Musannaf Ibn Abi Shaybah 15038","","","كتاب الحج"
"15039","(۱۵۰۳۹) حدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ ؛ فِی رَجُلٍ أَہَلَّ بِعُمْرَۃٍ ، ثُمَّ وَقَعَ بِأَہْلِہِ قَبْلَ أَنْ یَطُوفَ بِالْبَیْتِ ، قَالَ : یَرْجِعُ إِلَی حَیْثُ أَحْرَمَ ، فَیُحْرِمُ مِنْ ثَمَّ ، وَیُہْرِیقُ دَمًا۔","","Musannaf Ibn Abi Shaybah 15039","","","كتاب الحج"
"15040","(۱۵۰۴۰) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا وَاقَعَ الْمُحْرِمُ بِعُمْرَۃٍ امْرَأَتَہُ ، وَہِیَ مُحْرِمَۃٌ بِعُمْرَۃٍ ، قَالَ : یُہْدِی فِی کُلِّ وَاحِدٍ مِنْہُمَا ہَدْیًا ، وَیَمْضِیَانِ لِعُمْرَتِہِمَا۔","","Musannaf Ibn Abi Shaybah 15040","","","كتاب الحج"
"15041","(۱۵۰۴۱) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ أَہَلَّ بِعُمْرَۃٍ ، ثُمَّ غَشِیَ امْرَأَتَہُ قَبْلَ أَنْ یَصِلَ إلَی الْبَیْتِ ؟ أَنَّہُ قَالَ : یَرْجِعَانِ إلَی حَدِّہِمَا فَیُہِلاَنِ بِعُمْرَۃٍ ، وَیَتَفَرَّقَانِ حَتَّی یَقْضِیَا الْعُمْرَۃَ ، وَعَلَیْہِمَا ہَدْیَانِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15041","","","كتاب الحج"
"15042","(۱۵۰۴۲) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ قَالاَ : عَلَیْہِ أَنْ یَرْجِعَ إلَی الْوَقْتِ ، فَیُہِلَّ بِعُمْرَۃٍ وَیُہْرِیقَ دَمًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15042","","","كتاب الحج"
"15043","(۱۵۰۴۳) حدَّثَنَا شَرِیکٌ ، عَنْ عَمَّارٍ ، عَنْ مُسْلِمٍ الْبَطِینِ ؛ أَنَّ الْحُسَیْنَ بْنَ عَلِیٍّ کَانَ إذَا أَحْرَمَ ادَّہَنَ بِالزَّیْتِ ، وَدَہَنَ أَصْحَابَہُ بِالطِّیبِ ، أَوْ بِدُہْنِ الطِّیبِ۔",": Hasan","Musannaf Ibn Abi Shaybah 15043","","","كتاب الحج"
"15044","(۱۵۰۴۴) حدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ بَعْضِ أَصْحَابِہِ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَدَّہِنُ بِالزَّیْتِ قَبْلَ أَنْ یُحْرِمَ۔",": Da'if","Musannaf Ibn Abi Shaybah 15044","","","كتاب الحج"
"15045","(۱۵۰۴۵) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَدَّہِنُ بِالزَّیْتِ عِنْدَ الإِحْرَامِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15045","","","كتاب الحج"
"15046","(۱۵۰۴۶) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا قَیْسٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَانَ یَدَّہِنُ عِنْدَ الإِحْرَامِ مِنَ الدَّبَّۃِ ، یَعْنِی بِالزَّیْتِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15046","","","كتاب الحج"
"15047","(۱۵۰۴۷) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ فَرْقَدٍ السَّبَخِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَدَّہِنُ بِالزَّیْتِ عِنْدَ الإِحْرَامِ ، غَیْرَ الْمُقَتَّتِ یَعْنِی المُطَیَّبَ۔ (احمد ۲۹۔ ابن خزیمۃ ۲۶۵۲)",": Da'if","Musannaf Ibn Abi Shaybah 15047","","","كتاب الحج"
"15048","(۱۵۰۴۸) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خَمْسٌ مِنَ الدَّوَابِّ ، لاَ جُنَاحَ عَلَی مَنْ قَتَلَہُنَّ وَہُوَ حَرَامٌ ؛ الْفَأْرَۃُ ، وَالْعَقْرَبُ ، وَالْغُرَابُ، وَالْحِدَأَۃُ ، وَالْکَلْبُ الْعَقُورُ۔ (بخاری ۱۸۲۶۔ مسلم ۷۶)",": Sahih","Musannaf Ibn Abi Shaybah 15048","","","كتاب الحج"
"15049","(۱۵۰۴۹) حدَّثَنَا سَلاَّمٌ أَبُو الأَحْوَصِ ، عَنْ زَیْدِ بْنِ جُبَیْرٍ ، قَالَ : سَأَلَ رَجُلٌ ابْنَ عُمَرَ : مَا یَقْتُلُ الْمُحْرِمُ مِنَ الدَّوَابِّ ؟ فَقَالَ : حَدَّثَتْنِی إِحْدَی نِسْوَۃِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، أَنَّہُ أَمَرَ بِقَتْلِ الْفَأْرَۃِ ، وَالْعَقْرَبِ ، وَالْکَلْبِ الْعَقُورِ ، وَالْحِدَأَۃِ ، وَالْغُرَابِ۔ (بخاری ۱۸۲۷۔ مسلم ۷۵)",": Sahih","Musannaf Ibn Abi Shaybah 15049","","","كتاب الحج"
"15050","(۱۵۰۵۰) حدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، قَالَ : قَالَ سَعِیدُ بْنُ الْمُسَیَّبِ : خَمْسٌ یَقْتُلُہُنَّ الْمُحْرِمُ ؛ الْعَقْرَبَ ، وَالْحَیَّۃَ ، وَالذِّئْبَ ، وَالْغُرَابَ ، وَالْکَلْبَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15050","","","كتاب الحج"
"15051","(۱۵۰۵۱) حدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : حدَّثَنَا عِمْرَانُ بْنُ حُدَیْرٍ ، عَنْ مِنْقَرٍ أَبِی بَشَامَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ بِقَتْلِ الأَفْعَی ، وَرَمْیِ الْحِدَإِ۔ قَالَ أَبُو عَبْدِ الرَّحْمَنِ : وَوَجَدْتُ فِی مَکَانٍ آخَرَ : بِشْرٍ أَبِی بشَامَۃَ ، بِہَذَا الإِسْنَادِ ، وَقَالَ : یَعْنِی الْمُحْرِمَ۔",": Da'if","Musannaf Ibn Abi Shaybah 15051","","","كتاب الحج"
"15052","(۱۵۰۵۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ : یَقْتُلُ الْمُحْرِمُ الْفَأْرَۃَ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 15052","","","كتاب الحج"
"15053","(۱۵۰۵۳) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الْقَاسِمِ ، قَالَ : یَقْتُلُ الْفُوَیْسِقَۃَ۔","","Musannaf Ibn Abi Shaybah 15053","","","كتاب الحج"
"15054","(۱۵۰۵۴) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، وَعَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالاَ : لاَ یَقْتُلُ الْمُحْرِمُ مِنَ السِّبَاعِ إِلاَّ مَا عَدَا عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 15054","","","كتاب الحج"
"15055","(۱۵۰۵۵) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : کُلُّ عَدُوٍّ عَدَا عَلَیْکَ فَاقْتُلْہُ وَأَنْتَ مُحْرِمٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15055","","","كتاب الحج"
"15056","(۱۵۰۵۶) حدَّثَنَا سَلاَّمٌ ، عَنْ مُخَارِقِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، قَالَ : مَرَرْتُ بِحَیَّاتٍ وَأَنَا مُحْرِمٌ ، فَقَتَلْتُہُنَّ بِعَصًا کَانَتْ مَعِی ، فَلَمَّا أَتَیْتُ عُمَرَ سَأَلْتُہُ عَنْ قَتْلِہِنَّ ؟ فَقَالَ : اُقْتُلْہُنَّ ، فَإِنَّہُنَّ عَدُوٌّ۔",": Sahih","Musannaf Ibn Abi Shaybah 15056","","","كتاب الحج"
"15057","(۱۵۰۵۷) حدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : سُئِلَ عُمَرُ عَنْ قَتْلِ الْحَیَّۃِ وَہُوَ مُحْرِمٌ؟ فَقَالَ : اُقْتُلُوہُنَّ۔",": Sahih","Musannaf Ibn Abi Shaybah 15057","","","كتاب الحج"
"15058","(۱۵۰۵۸) حدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ ، عَنْ نَافِعٍ ، قَالَ : کُنَّا مَعَ ابْنِ عُمَرَ وَنَحْنُ مُحْرِمُونَ فَرَأَیْنَا حَیَّۃً ، فَبَدَرَنَا سَالِمٌ فَقَتَلَہَا۔",": Hasan","Musannaf Ibn Abi Shaybah 15058","","","كتاب الحج"
"15059","(۱۵۰۵۹) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، عَنْ عَلِیٍّ ؛ فِی الضَّبُعِ إِذَا عَدَا عَلَی الْمُحْرِمِ فَلْیَقْتُلْہُ ، فَإِنْ قَتَلَہُ مِنْ قَبْلِ أَنْ یَعْدُوَ عَلَیْہِ ، فَعَلَیْہِ شَاۃٌ مُسِنَّۃٌ۔","","Musannaf Ibn Abi Shaybah 15059","","","كتاب الحج"
"15060","(۱۵۰۶۰) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنِ ابْنِ أَبِی نُعْمٍ ، عَنْ أَبِی سَعِیدٍ ؛ أَنَّہُ قَالَ : یَقْتُلُ الْمُحْرِمُ الْحَیَّۃَ ، وَالْعَقْرَبَ ، وَالسَّبُعَ الْعَادِی ، وَالْکَلْبَ الْعَقُورَ ، وَالْفَأْرَۃَ الْفُوَیْسِقَۃَ ، فَقِیلَ لَہُ : لِمَ قِیلَ الْفُوَیْسِقَۃُ ؟ فَقَالَ : لأَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اسْتَیْقَظَ بِہَا ، وَقَدْ أَخَذَتْ فَتِیلَۃً تُحْرِقُ بِہَا الْبَیْتَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15060","","","كتاب الحج"
"15061","(۱۵۰۶۱) حدَّثَنَا مَحْبُوبٌ ، عَنْ بُکَیْرِ بْنِ عَامِرٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یَقْتُلُ الْمُحْرِمُ الْفَأْرَۃَ ،وَالْغُرَابَ الْعَقْعَقَ۔","","Musannaf Ibn Abi Shaybah 15061","","","كتاب الحج"
"15062","(۱۵۰۶۲) حدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لِیَقْتُلِ الْمُحْرِمُ الْفَأْرَۃَ ، وَالْعَقْرَبَ ، وَالْحِدَأَ ، وَالْغُرَابَ ، وَالْکَلْبَ الْعَقُورَ۔\n(مسلم ۸۵۷۔ احمد ۶/۲۳۱)",": Sahih","Musannaf Ibn Abi Shaybah 15062","","","كتاب الحج"
"15063","(۱۵۰۶۳) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ بِنَحْوِہِ ، وَزَادَتْ : وَیَقْتُلُ الْحَیَّۃَ۔ (مسلم ۶۷۔ احمد ۹۷)",": Sahih","Musannaf Ibn Abi Shaybah 15063","","","كتاب الحج"
"15064","(۱۵۰۶۴) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ حَنْظَلَۃَ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ ، قَالَتْ : سَمِعْتُہُ یَقُولُ : خَمْسٌ فَوَاسِقُ ، فَاقْتُلُوہُنَّ فِی الْحَرَمِ ؛ الْحِدَأَ ، وَالْغُرَابَ ، وَالْکَلْبَ ، وَالْفَأْرَۃَ ، وَالْعَقْرَبَ۔ (مسلم ۶۶۔ احمد ۶/۲۰۹)",": Sahih","Musannaf Ibn Abi Shaybah 15064","","","كتاب الحج"
"15065","(۱۵۰۶۵) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَنْظَلَۃَ ، عَنِ الْقَاسِمِ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : لاَ جُنَاحَ عَلَیْکُمْ أَنْ تَقْتُلُوہُنَّ وَأَنْتُمْ حُرُمٌ۔",": Sahih","Musannaf Ibn Abi Shaybah 15065","","","كتاب الحج"
"15066","(۱۵۰۶۶) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ إِبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : أَمَرَنَا عُمَرُ بِقَتْلِ الْحَیَّۃِ ، وَالزَّنْبُورِ وَنَحْنُ مُحْرِمُونَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15066","","","كتاب الحج"
"15067","(۱۵۰۶۷) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ طَاوُوسٍ ، قَالَ : لاَ عَلَیْکَ أَنْ لاَ تُسَمِّیَ حَجًّا ، وَلاَ عُمْرَۃً ، تَکْفِیکَ النِّیَّۃُ۔","","Musannaf Ibn Abi Shaybah 15067","","","كتاب الحج"
"15068","(۱۵۰۶۸) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا أَرَدْتَ أَنْ تُحْرِمَ ، فَلاَ تَقُلْ شَیْئًا ، إِنَّمَا عَلَیْکَ مَا عَقَدْتَ عَلَیْہِ نِیَّتَکَ مِنْ حَجٍّ ، أَوْ عُمْرَۃٍ۔","","Musannaf Ibn Abi Shaybah 15068","","","كتاب الحج"
"15069","(۱۵۰۶۹) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : تَکْفِیکَ النِّیَّۃُ فِی الْحَجِّ وَالْعُمْرَۃِ ، إِذَا أَرَدْتَ أَنْ تُحْرِمَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15069","","","كتاب الحج"
"15070","(۱۵۰۷۰) حدَّثَنَا شَرِیکٌ ، عَنْ سَالِمٍ ، عَنْ سَعِیدٍ ، قَالَ : حجَجْتُ مَعَ نَاسٍ مِنْ أَصْحَابِ عَبْدِ اللہِ ، فَلَمْ یَکُونُوا یُسَمُّونَ حَتَّی یُشَارِفُوا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15070","","","كتاب الحج"
"15071","(۱۵۰۷۱) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَطَائٍ ، قَالَ : تُجْزِئُہُ النِّیَّۃُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15071","","","كتاب الحج"
"15072","(۱۵۰۷۲) حدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ سُئل عَن رَجُلٍ فَرَضَ الْحَجَّ وَالْعُمْرَۃَ ، غَیر أَنَّہُ لاَ یَتَکَلَّمُ بِہِمَا ؟ أَنَّہُ قَالَ : مَا أَرَادَ وَنَوَی ، وَکَانَ یَأْمُرُہُ أَن یُسَمِّی۔","","Musannaf Ibn Abi Shaybah 15072","","","كتاب الحج"
"15073","(۱۵۰۷۳) حدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ إِسْحَاقَ، مَوْلَی آلِ عُمَرَ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ، قَالَ: تَکْفِیہِ النِّیَّۃُ۔","","Musannaf Ibn Abi Shaybah 15073","","","كتاب الحج"
"15074","(۱۵۰۷۴) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : تَکْفِیہِ النِّیَّۃُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15074","","","كتاب الحج"
"15075","(۱۵۰۷۵) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، وَشَہْرٍ ، قَالاَ : لاَ بَأْسَ أَنْ یَغْسِلَ الْمُحْرِمُ ثِیَابَہُ ، وَیَأْمُرَ بِہَا ، وَیَکْرَہَانِ أَنْ یَغْسِلَہَا ہُوَ۔","","Musannaf Ibn Abi Shaybah 15075","","","كتاب الحج"
"15076","(۱۵۰۷۶) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ أَنْ یَغْتَسِلَ الْمُحْرِمُ ، وَیَغْسِلَ ثِیَابَہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 15076","","","كتاب الحج"
"15077","(۱۵۰۷۷) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَغْتَسِلَ الْمُحْرِمُ مِنْ غَیْرِ جَنَابَۃٍ ، وَیَغْسِلَ ثِیَابَہُ۔","","Musannaf Ibn Abi Shaybah 15077","","","كتاب الحج"
"15078","(۱۵۰۷۸) حدَّثَنَا وَکِیعٌ ، عَنْ طَلحَۃَ ، عن عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یَغْسِلَ الْمُحْرِمُ ثِیَابَہُ۔","","Musannaf Ibn Abi Shaybah 15078","","","كتاب الحج"
"15079","(۱۵۰۷۹) حدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مَنْصُورٍ ، عَنِ سَالِم ، عَنِ ابْنِ عُمَرَ ، قَالَ: إِنَّ اللَّہَ لاَ یَصْنَعُ بِدَرَنِکَ شَیْئًا۔",": Sahih","Musannaf Ibn Abi Shaybah 15079","","","كتاب الحج"
"15080","(۱۵۰۸۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ، قَالَ: لاَ بَأْسَ أَنْ یَغْتَسِلَ الْمُحْرِمُ، وَیَغْسِلَ ثِیَابَہُ۔",": Hasan","Musannaf Ibn Abi Shaybah 15080","","","كتاب الحج"
"15081","(۱۵۰۸۱) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ قَالَ : أَیَغْسِلُ الْمُحْرِمُ ثِیَابَہُ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 15081","","","كتاب الحج"
"15082","(۱۵۰۸۲) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : یَکْتَحِلُ الْمُحْرِمُ بِأَیِّ کُحْلٍ شَائَ ، مَا لَمْ یَکُنْ فِیہِ طِیبٌ۔",": Sahih","Musannaf Ibn Abi Shaybah 15082","","","كتاب الحج"
"15083","(۱۵۰۸۳) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَائِشَۃَ ابْنَۃِ طَلْحَۃَ ، عَنْ عَائِشَۃَ أُمِّ الْمُؤْمِنِینَ ؛ أَنَّہَا کَرِہَتْ لِلْمُحْرِمَۃِ أَنْ تَکْتَحِلَ بِالإِثْمِدِ۔","","Musannaf Ibn Abi Shaybah 15083","","","كتاب الحج"
"15084","(۱۵۰۸۴) حدَّثَنَا سَلاَّمٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الضَّحَّاکِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إِذَا رَمِدَ الْمُحْرِمُ فَلْیَکْتَحِلْ ، وَلاَ یَکْتَحِلُ بِشَیْئٍ فِیہِ طِیبٌ۔",": Sahih","Musannaf Ibn Abi Shaybah 15084","","","كتاب الحج"
"15085","(۱۵۰۸۵) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، قَالَ : قُلْتُ لِمُجَاہِدٍ : أَتَکْتَحِلُ الْمُحْرِمَۃُ بِالإِثْمِدِ ؟ قَالَ : لاَ ، قُلْتُ : إِنَّہُ لَیْسَ فِیہِ طِیبٌ ، قَالَ : إِنَّہُ فِیہِ زِینَۃٌ۔","","Musannaf Ibn Abi Shaybah 15085","","","كتاب الحج"
"15086","(۱۵۰۸۶) حدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الْعَزِیزِ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : تَلْبَسُ الْمُحْرِمَۃُ مَا شَائَتْ مِنَ الثِّیَابِ ، مِنْ شَرْقِیہَا وَغَرْبِیہَا ، وَلاَ تَکْتَحِلُ بِالإِثْمِدِ۔","","Musannaf Ibn Abi Shaybah 15086","","","كتاب الحج"
"15087","(۱۵۰۸۷) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ الْعَزِیزِ ، قَالَ سَأَلَتُ جَابِرَ بْنَ زَیْدٍ عَنِ الْمُحْرِمَۃ تَکْتَحِلُ بِالإِثْمِدِ ؟ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 15087","","","كتاب الحج"
"15088","(۱۵۰۸۸) حدَّثَنَا ابْنُ مَہْدِیٍّ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ إِبْرَاہِیمَ ، عَن قَتَادَۃَ ، قَالَ سَأَلَتِ امْرَأَۃٌ عَبْدَ الرَّحْمَن بْنَ أَبِی بَکْرٍ ، وَابْنَ عُمَرَ ، عَنِ امْرَأَۃٍ مُحْرِمَۃٍ اکْتَحَلَتْ بِالإِثْمِدِ ؟ فَأَمَرَہَا عَبْدُ الرَّحْمَنِ بْنُ أَبِی بَکْرٍ أَنْ تُہْرِیقَ دَمًا۔","","Musannaf Ibn Abi Shaybah 15088","","","كتاب الحج"
"15089","(۱۵۰۸۹) حدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ یَزِیدَ، عَنْ مُجَاہِدٍ، قَالَ: لاَ تَکْتَحِلُ إِلاَّ مِنْ رَمَدٍ ، وَلاَ تَکْتَحِلُ بِکُحْلٍ فِیہِ طِیْبٌ۔","","Musannaf Ibn Abi Shaybah 15089","","","كتاب الحج"
"15090","(۱۵۰۹۰) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَبْلُغُ الْوَقْتَ وَہُوَ مُغْمَی عَلَیْہِ ، قَالَ : یُلَبَّی عَنْہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15090","","","كتاب الحج"
"15091","(۱۵۰۹۱) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یُہَلُّ عَنْہُ ، یَعْنِی الْمُغْمَی عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 15091","","","كتاب الحج"
"15092","(۱۵۰۹۲) حدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّ عَلِیًّا رَأَی مَعَ بَعْضِ أَصْحَابِہِ دَاجِنًا مِنَ الصَّیْدِ وَہُمْ مُحْرِمُونَ ، فَلَمْ یَأْمُرْہُمْ بِإِرْسَالِہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15092","","","كتاب الحج"
"15093","(۱۵۰۹۳) حدَّثَنَا أَبُوبَکْرِ بْنُ عَیَّاشٍ، عَنْ لَیْثٍ، عَنْ مُجَاہِدٍ، قَالَ: إذَا أَحْرَمْتَ وَمَعَک شَیْئٌ مِنَ الصَّیْدِ، فَخَلِّ سَبِیلَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15093","","","كتاب الحج"
"15094","(۱۵۰۹۴) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، قَالَ : کُنَّا نَحُجُّ وَنَتْرُکُ عِنْدَ أَہْلِینَا أَشْیَائً مِنَ الصَّیْدِ ، مَا نُرْسِلُہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15094","","","كتاب الحج"
"15095","(۱۵۰۹۵) حدَّثَنَا حَفْصٌ ، قَالَ : سَأَلْتُ ابْنَ جُرَیْجٍ : مَا کَانَ عَطَائٌ یَقُولُ فِی الرَّجُلِ یَخْرُجُ ، وَقَدْ خَلَّفَ فِی مَنْزِلِہِ شَیْئًا مِنَ الصَّیْدِ ، فَیُصِیبُہُ شَیْئٌ ؟ قَالَ : یَضْمَنُ۔","","Musannaf Ibn Abi Shaybah 15095","","","كتاب الحج"
"15096","(۱۵۰۹۶) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ یَزِیدَ ، عَنْ حَسَنِ بْنِ مُسْلِمٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا أَحْرَمَ وَبِیَدِہِ شَیْئٌ مِنَ الصَّیْدِ ، فَلْیُرْسِلْہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 15096","","","كتاب الحج"
"15097","(۱۵۰۹۷) حدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَحْرَمَ وَفِی یَدِہِ طَیْرٌ فَلْیُرْسِلْہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15097","","","كتاب الحج"
"15098","(۱۵۰۹۸) حدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنْ إسْمَاعِیلَ ، عَنِ الْحَسَنِ ، قَالَ : الصَّبِیُّ إِنْ حَجَّ ، وَالْمَمْلُوکُ إِنْ حَجَّ ، وَالأَعْرَابِیُّ إِنْ حَجَّ ، ثُمَّ ہَاجَرَ الأَعْرَابِیُّ ، وَاحْتَلَمَ الصَّبِیُّ ، وَأُعْتِقَ الْعَبْدُ ، فَعَلَیْہِمُ الْحَجُّ۔","","Musannaf Ibn Abi Shaybah 15098","","","كتاب الحج"
"15099","(۱۵۰۹۹) حدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إِنْ حَجَّ الْمَمْلُوکُ کَذَا وَکَذَا ، ثُمَّ أُعْتِقَ فَعَلَیْہِ الْحَجُّ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15099","","","كتاب الحج"
"15100","(۱۵۱۰۰) حدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنْ إسْمَاعِیلَ ، عَنْ عَطَائٍ ، قَالَ : الصَّبِیُّ وَالْعَبْدُ عَلَیْہِمَا الْحَجُّ ، وَالأَعْرَابِیُّ یُجْزِیہِ حَجَّہُ ، لأَنَّ الْحَجَّ مَکْتُوبٌ عَلَیْہِ حَیْثُ کَانَ ، وَمَنْ حَجَّ مِنَ الأَعْرَابِ۔","","Musannaf Ibn Abi Shaybah 15100","","","كتاب الحج"
"15101","(۱۵۱۰۱) حدَّثَنَا وَکِیعٌ ، عَنْ یُونُسَ بْنِ أَبِی إِسْحَاقَ ، قَالَ : سَمِعْتُ شَیْخًا یُحَدِّثُ أَبَا إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ الْقُرَظِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنِّی أُرِیدُ أَنْ أُجَدِّدَ فِی صُدُورِ الْمُؤْمِنِینَ ، أَیُّمَا صَبِیٍّ حَجَّ بِہِ أَہْلُہُ ، ثُمَّ مَاتَ أَجْزَأَ عَنْہُ ، وَإِنْ أَدْرَکَ فَعَلَیْہِ الْحَجُّ ، وَأَیُّمَا مَمْلُوکٍ حَجَّ بِہِ أَہْلُہُ ، ثُمَّ مَاتَ أَجْزَأَ عَنْہُ ، وَإِنْ أُعْتِقَ فَعَلَیْہِ الْحَجُّ۔ (ابوداؤد ۱۳۴)",": Da'if","Musannaf Ibn Abi Shaybah 15101","","","كتاب الحج"
"15102","(۱۵۱۰۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إبْرَاہِیمَ ، وَمُحَمَّد ، ابْنَی عُقْبَۃ ، عَنْ کُرَیْبٍ ؛ أَنَّ امْرَأَۃً قَامَتْ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِصَبِیٍّ ، فَقَالَتْ : یَا رَسُولَ اللہِ ، أَلِہَذَا حَجٌّ ؟ قَالَ : نَعَمْ ، وَلَکِ أَجْرٌ۔","","Musannaf Ibn Abi Shaybah 15102","","","كتاب الحج"
"15103","(۱۵۱۰۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : الأَعْرَابِیُّ یُجْزِئُ عَنْہُ حَجُّہُ۔","","Musannaf Ibn Abi Shaybah 15103","","","كتاب الحج"
"15104","(۱۵۱۰۴) حدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : کَانَ یُقَالُ : حُجُّوا بِہِمْ صِغَارًا ، فَإِنْ مَاتُوا کَانُوا قَدْ حَجُّوا ، وَإِنْ عَاشُوا حَجُّوا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15104","","","كتاب الحج"
"15105","(۱۵۱۰۵) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی ظَبْیَانَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ احْفَظُوا عَنِّی ، وَلاَ تَقُولُوا : قَالَ ابْنُ عَبَّاسٍ : أَیُّمَا عَبْدٍ حَجَّ بِہِ أَہْلُہُ ، ثُمَّ أُعْتِقَ فَعَلَیْہِ الْحَجُّ ، وَأَیُّمَا صَبِیٍّ حَجَّ بِہِ أَہْلُہُ صَبِیًّا ، ثُمَّ أَدْرَکَ فَعَلَیْہِ حَجَّۃُ الرّجُلِ ، وَأَیُّمَا أَعْرَابِیٍّ حَجَّ أَعْرَابِیًّا ، ثُمَّ ہَاجَرَ فَعَلَیْہِ حَجَّۃُ الْمُہَاجِر۔ (ابن خزیمۃ ۳۰۵۰)",": Sahih","Musannaf Ibn Abi Shaybah 15105","","","كتاب الحج"
"15106","(۱۵۱۰۶) حدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانُوا یَرَوْنَ أَنَّ الْمَرْأَۃَ إِذَا حَجَّتْ وَفِی بَطْنِہَا وَلَدٌ ، أَنَّ لَہُ حَجًّا۔","","Musannaf Ibn Abi Shaybah 15106","","","كتاب الحج"
"15107","(۱۵۱۰۷) حدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ إبْرَاہِیمَ بْنِ نَافِعٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا حَجَّ وَہُوَ أَعْرَابِیٌّ أَجْزَأَتْ عَنْہُ مِنْ حَجَّۃِ الإِسْلاَمِ۔","","Musannaf Ibn Abi Shaybah 15107","","","كتاب الحج"
"15108","(۱۵۱۰۸) حدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ إبْرَاہِیمَ بْنِ عُقْبَۃَ ، عَنْ کُرَیْبٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ: لَقِیَ رَکْبًا بِالرَّوْحَائِ ، فَقَالَ : مَنِ الْقَوْمُ ؟ قَالُوا : الْمُسْلِمُونَ ، قَالُوا : مَنْ أَنْتَ ؟ قَالَ : رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَرَفَعَتِ امْرَأَۃٌ صَبِیًّا ، فَقَالَتْ : أَلِہَذَا حَجٌّ ؟ قَالَ : نَعَمْ ، وَلَکِ أَجْرٌ۔\n(مسلم ۴۰۹۔ ابوداؤد ۱۷۳۳)",": Sahih","Musannaf Ibn Abi Shaybah 15108","","","كتاب الحج"
"15109","(۱۵۱۰۹) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : یُجْزِئُ عَنِ الصَّغِیرِ حَجُّہُ حَتَّی یَکْبُرَ۔","","Musannaf Ibn Abi Shaybah 15109","","","كتاب الحج"
"15110","(۱۵۱۱۰) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُصْنَعُ بِالصَّبِیِّ فِی الإِحْرَامِ مَا یُصْنَعُ بِالرَّجُلِ ، وَیُتَّقَی عَلَیْہِ الطِّیبُ ، وَیُطَافُ بِہِ ، وَیُشْہَدُ بِہِ الْمَنَاسِکَ ، وَیُلَبَّی عَنْہُ۔","","Musannaf Ibn Abi Shaybah 15110","","","كتاب الحج"
"15111","(۱۵۱۱۱) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، مِثْلَہُ ، إِلاَّ اَنَّہُ قَالَ : لاَ یُصَلَّی عَنْہُ ، وَإِنْ شَاؤُوا قَمَّصُوہُ ، وَإِنْ شَاؤُوا لَمْ یُقَمِّصُوہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15111","","","كتاب الحج"
"15112","(۱۵۱۱۲) حدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ أَبِی إِسْحَاقَ ؛ أَنَّ أَبَا بَکْرٍ طَافَ بِابْنِ الزُّبَیْرِ فِی خِرْقَۃٍ۔","","Musannaf Ibn Abi Shaybah 15112","","","كتاب الحج"
"15113","(۱۵۱۱۳) حدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ (ح) وَعَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ؛ أَنَّہُمَا کَانَا یُجَرِّدَانِ الصِّبْیَانَ فِی الْحَجِّ ، وَیَطُوفَانِ بِہِمْ بَیْنَ الصَّفَا وَالْمَرْوَۃِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15113","","","كتاب الحج"
"15114","(۱۵۱۱۴) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یُجَنَّبُ الصَّبِیُّ فِی الإِحْرَامِ مَا یَجْتَنِبُ الْکَبِیرُ مِنَ الزِّینَۃِ وَالطِّیبِ۔","","Musannaf Ibn Abi Shaybah 15114","","","كتاب الحج"
"15115","(۱۵۱۱۵) حدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : حجَجْنَا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَلَبَّیْنَا عَنِ الْوِلْدَانِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15115","","","كتاب الحج"
"15116","(۱۵۱۱۶) حدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعُمَیْسِ ، عَنِ الْقَاسِمِ ؛ أَنَّہُ کَانَ یُحْرِمُ بِالصِّبْیَانِ ، وَیُجَرِّدُہُمْ عِنْدَ الإِہْلاَلِِ۔","","Musannaf Ibn Abi Shaybah 15116","","","كتاب الحج"
"15117","(۱۵۱۱۷) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : کَانَ عُرْوَۃُ یَحُجُّ بِصِبْیَانِہِ ، وَیُجَرِّدُہُمْ عِنْدَ الإِحْرَامِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15117","","","كتاب الحج"
"15118","(۱۵۱۱۸) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَوَکِیعٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَمَلَ مِنَ الْحَجَرِ إلَی الْحَجَرِ ثَلاَثًا ، وَمَشَی سَائِرَ ذَلِکَ ، إِلاَّ أَنَّ وَکِیعًا لَمْ یَقُلْ : سَائِرَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 15118","","","كتاب الحج"
"15119","(۱۵۱۱۹) حدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرِ بْنِ رَبِیعَۃَ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ رَمَلَ مَا بَیْنَ الْحَجَرِ إلَی الْحَجَرِ۔",": Hasan","Musannaf Ibn Abi Shaybah 15119","","","كتاب الحج"
"15120","(۱۵۱۲۰) حدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ ہِشَامٍ ؛ أَنَّ عُرْوَۃَ رَمَلَ مِنَ الْحَجَرِ إلَی الْحَجَرِ۔","","Musannaf Ibn Abi Shaybah 15120","","","كتاب الحج"
"15121","(۱۵۱۲۱) حدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ عَبْدِ الْعَزِیزِ ، عَنْ مَکْحُولٍ ؛ أَنَّہُ رَمَلَ مِنَ الْحَجَرِ إلَی الْحَجَرِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15121","","","كتاب الحج"
"15122","(۱۵۱۲۲) حدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، قَالَ : دَخَلْتُ مَعَ الْقَاسِمِ فَرَمَلَ ثَلاَثًا ، وَمَشَی مَا بَیْنَ الرُّکْنَیْنِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15122","","","كتاب الحج"
"15123","(۱۵۱۲۳) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ إذَا قَدِمَ مَکَّۃَ فِی حَجَّۃٍ ، أَوْ عُمْرَۃٍ رَمَلَ بِالْبَیْتِ ثَلاَثَۃَ أَطْوَافٍ ، وَمَشَی أَرْبَعًا ، وَیَقُولُ : ہَکَذَا رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَفْعَلُ۔ (بخاری ۱۶۱۷۔ مسلم ۲۳۱)",": Sahih","Musannaf Ibn Abi Shaybah 15123","","","كتاب الحج"
"15124","(۱۵۱۲۴) حدَّثَنَا وَکِیعٌ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ رَمَلَ مِنَ الْحَجَرِ إلَی الْحَجَرِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15124","","","كتاب الحج"
"15125","(۱۵۱۲۵) حدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَمَلَ ثَلاَثًا، وَمَشَی أَرْبَعًا۔",": Sahih","Musannaf Ibn Abi Shaybah 15125","","","كتاب الحج"
"15126","(۱۵۱۲۶) حدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرِ بْنِ رَبِیعَۃَ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ رَمَلَ مَا بَیْنَ الْحَجَرِ إلَی الْحَجَرِ۔",": Hasan","Musannaf Ibn Abi Shaybah 15126","","","كتاب الحج"
"15127","(۱۵۱۲۷) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ، أَنَّہُ رَمَلَ ثَلاَثًا وَمَشَی أَرْبَعًا۔",": Sahih","Musannaf Ibn Abi Shaybah 15127","","","كتاب الحج"
"15128","(۱۵۱۲۸) حدَّثَنَا وَکِیعٌ ، عَنْ فِطْرٍ ، عَنِ الْحَسَنِ بْنِ مُسْلِمٍ بْنِ یَنَّاق ، قَالَ : کُنْتُ أَرْمُلُ الثَّلاَثَۃَ مِنَ الْحَجَرِ إلَی الْحَجَرِ، فَأَتَی أَشْیَاخُنَا وَقَالُوا: اِمْشِ مَا بَیْنَ الرُّکْنَیْنِ، مِنْہُمْ سَعِیدُ بْنُ جُبَیْرٍ، وَطَاوُوسٌ، وَمُجَاہِدٌ، وَعَطَائٌ۔","","Musannaf Ibn Abi Shaybah 15128","","","كتاب الحج"
"15129","(۱۵۱۲۹) حدَّثَنَا إِسْحَاقُ الأَزْرَقُ ، عَنْ مُثَنَّی ، عَنْ طَاوُوسٍ ؛ أَنَّہُ کَانَ یَرْمُلُ مِنَ الْحَجَرِ إلَی الْحَجَرِ۔","","Musannaf Ibn Abi Shaybah 15129","","","كتاب الحج"
"15130","(۱۵۱۳۰) حدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا مَالِکُ بْنُ أَنَسٍ ، عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَمَلَ مِنَ الْحَجَرِ إلَی الْحَجَرِ۔ (مسلم ۸۸۶۔ احمد ۳/۳۴۰)",": Sahih","Musannaf Ibn Abi Shaybah 15130","","","كتاب الحج"
"15131","(۱۵۱۳۱) حدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ (ح) وَعَنْ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالاَ : مَنْ تَرَکَ طَوَافَ الصَّدْرِ فَعَلَیْہِ دَمٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15131","","","كتاب الحج"
"15132","(۱۵۱۳۲) حدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ قَالاَ : کَانَ عُمَرُ یَرُدُّ مَنْ خَرَجَ وَلَمْ یَکُنْ آخِرُ عَہْدِہِ بِالْبَیْتِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15132","","","كتاب الحج"
"15133","(۱۵۱۳۳) حدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ قَالاَ : مَنْ نَفَرَ وَلَمْ یُوَدِّعْ ، فَعَلَیْہِ دَمٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15133","","","كتاب الحج"
"15134","(۱۵۱۳۴) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا إذَا رَمَی الْجَمْرَۃَ أَنْ یَغْسِلَ بِالْخِطْمِیِّ قَبْلَ أَنْ یَحْلِقَہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 15134","","","كتاب الحج"
"15135","(۱۵۱۳۵) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا حَلَّ لَکَ الْحَلْقُ ، فَاغْسِلْ رَأْسَک بِمَا شِئْتَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15135","","","كتاب الحج"
"15136","(۱۵۱۳۶) حدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ جَابِرٍ، عَنْ أَبِی جَعْفَرٍ، قَالَ: لاَ بَأْسَ أَنْ یَغْسِلَ الْمُحْرِمُ رَأْسَہُ قَبْلَ أَنْ یَحْلِقَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15136","","","كتاب الحج"
"15137","(۱۵۱۳۷) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ ، قَالَ : سَأَلْتُُہُمْ : أَغْسِلُ رَأْسِی قَبْلَ أَنْ أَحْلِقَ ، إِنْ شَقَّ عَلَیَّ الْحَلْقُ ؟ قَالُوا : نَعَمْ ، وَإِنْ شِئْتَ غَسَلْتَہُ بِالْخِطْمِیِّ۔","","Musannaf Ibn Abi Shaybah 15137","","","كتاب الحج"
"15138","(۱۵۱۳۸) حدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنْ أَبِی الأَشْہَبِ جَعْفَرِ بْنِ حَیَّانٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَغْسِلَ الرَّجُلُ رَأْسَہُ بِالْخِطْمِیِّ قَبْلَ أَنْ یَحْلِقَہُ۔","","Musannaf Ibn Abi Shaybah 15138","","","كتاب الحج"
"15139","(۱۵۱۳۹) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ أَنَّہُ کَرِہَ أَنْ تَغْسِلَ الْمَرْأَۃُ رَأْسَہَا بِالْخِطْمِیِّ ، یَعْنِی إذَا أَرَادَتْ أَنْ تُقَصِّرَ۔","","Musannaf Ibn Abi Shaybah 15139","","","كتاب الحج"
"15140","(۱۵۱۴۰) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَغْسِلُ رَأْسَہُ بِالْخِطْمِیِّ قَبْلَ أَنْ یَحْلِقَہُ ، قَالَ : وَکَانَ عَطَائٌ یَکْرَہُہُ۔","","Musannaf Ibn Abi Shaybah 15140","","","كتاب الحج"
"15141","(۱۵۱۴۱) حدَّثَنَا سَلاَّمٌ أَبُو الأَحْوَصِ ، عَنِ الْعَلاَئِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عِکْرِمَۃَ ، قَالَ : قَالَ رَجُلٌ لابْنِ عَبَّاسٍ : أَیَرْکَبُ الرَّجُلُ الْبَدَنَۃَ ؟ قَالَ : غَیْرَ مُثْقِلٍ ، قَالَ : فَیَحْلُبُہَا ؟ قَالَ : غَیْرَ مُجْہِدٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 15141","","","كتاب الحج"
"15142","(۱۵۱۴۲) حدَّثَنَا أَبُو مَالِکٍ الْجَنْبِیُّ عَمْرُو بْنُ ہَاشِمٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَلِیٍّ ، قَالَ : یَرْکَبُ الرَّجُلُ بَدَنَتَہُ بِالْمَعْرُوفِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15142","","","كتاب الحج"
"15143","(۱۵۱۴۳) حدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا احْتَاجَ الرَّجُلُ إلَی الْبَدَنَۃِ فَلْیَرْکَبْہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15143","","","كتاب الحج"
"15144","(۱۵۱۴۴) حدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ عَبْدِ الْکَرِیمُ ، عَنْ عِکْرِمَۃَ ؛ فِی الْبَدَنَۃِ ، قَالَ : اِرْکَبْہَا غَیْرَ قَادِحٍ۔","","Musannaf Ibn Abi Shaybah 15144","","","كتاب الحج"
"15145","(۱۵۱۴۵) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ حُمَیْدٍ ، قَالَ : رَأَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلاً یَسُوقُ بَدَنَۃً ، فَقَالَ : ارْکَبْہَا ، قَالَ : إِنَّہَا بَدَنَۃً ، قَالَ : ارْکَبْہَا۔","","Musannaf Ibn Abi Shaybah 15145","","","كتاب الحج"
"15146","(۱۵۱۴۶) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ارْکَبُوا الْہَدْیَ بِالْمَعْرُوفِ ، حَتَّی تَجِدُوا ظَہْرًا۔ (مسلم ۹۶۱۔ ابوداؤد ۱۷۵۸)","","Musannaf Ibn Abi Shaybah 15146","","","كتاب الحج"
"15147","(۱۵۱۴۷) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنِ الْقَاسِمِ ، عَنْ مُجَاہِدٍ ؛ {لَکُمْ فِیہَا مَنَافِعُ إلَی أَجَلٍ مُّسَمًّی} ، قَالَ : فِی أَلْبَاَنَّہَا وَظُہُورِہَا ، وَفِی أَوْبَارِہَا حَتَّی تُسَمَّی بُدْنًا ، فَإِذَا سُمِّیَتْ بُدْنًا فَمَحِلُّہَا إلَی الْبَیْتِ الْعَتِیقِ۔","","Musannaf Ibn Abi Shaybah 15147","","","كتاب الحج"
"15148","(۱۵۱۴۸) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یَرْکَبُہَا وَیَحْمِلُ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 15148","","","كتاب الحج"
"15149","(۱۵۱۴۹) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : ارْکَبْہَا ، قَالَ : إِنَّہَا بَدَنَۃٌ ، قَالَ : ارْکَبْہَا غَیْرَ مَفْدُوحَۃٍ۔","","Musannaf Ibn Abi Shaybah 15149","","","كتاب الحج"
"15150","(۱۵۱۵۰) حدَّثَنَا عَبْدُ الصَّمَدِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ فِی الْبَدَنَۃِ ، قَالَ : إِذَا احْتَاجَ إِلَیْہَا سَائِقُہَا رَکِبَہَا غَیْرَ فَادِحٍ ، وَیَشْرَبُ فَضْلَ رَیّ وَلَدِہَا۔","","Musannaf Ibn Abi Shaybah 15150","","","كتاب الحج"
"15151","(۱۵۱۵۱) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الْبَدَنَۃِ إِنْ احْتَجْتَ إِلَی ظَہْرِہَا رَکِبْتَ ، وَحَمَلْتَ عَلَیْہَا بِالْمَعْرُوفِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15151","","","كتاب الحج"
"15152","(۱۵۱۵۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزِّنَادِ ، عَنِ الأَعْرَجِ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی رَجُلاً یَسُوقُ بَدَنَۃً ، فَقَالَ : ارْکَبْہَا ، قَالَ : إِنَّہَا بَدَنَۃٌ ، قَالَ : وَإِنْ کَانَتْ بَدَنَۃً۔\n(بخاری ۱۶۸۹۔ ابوداؤد ۱۷۵۷)",": Sahih","Musannaf Ibn Abi Shaybah 15152","","","كتاب الحج"
"15153","(۱۵۱۵۳) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ بُکَیْرِ بْنِ الأَخْنَسِ ، عَنْ أَنَسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی رَجُلاً یَسُوقُ بَدَنَۃً ، أَوْ ہَدِیَّۃً ، فَقَالَ : ارْکَبْہَا ، قَالَ : إِنَّہَا بَدَنَۃٌ ، أَوْ ہَدِیَّۃٌ ، قَالَ : وَإِنْ کَانَتْ۔\n(مسلم ۳۷۴۔ احمد ۳/۱۶۷)",": Sahih","Musannaf Ibn Abi Shaybah 15153","","","كتاب الحج"
"15154","(۱۵۱۵۴) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ عَجْلاَنَ مَوْلَی الْمُشْمَعِلِ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی رَجُلاً یَسُوقُ بَدَنَۃً ، فَقَالَ : ارْکَبْہَا ، قَالَ : إِنَّہَا بَدَنَۃٌ ، قَالَ ارْکَبْہَا وَیْحَکَ ، أَوْ وَیْلَکَ۔",": Hasan","Musannaf Ibn Abi Shaybah 15154","","","كتاب الحج"
"15155","(۱۵۱۵۵) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ ۔(ح) وَعَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ، قَالَ: إِنِ احْتَاجَ إِلَی اللَّبَنِ شَرِبَ، وَإِنِ احْتَاجَ إِلَی الرُّکُوبِ رَکِبَ، وَإِنِ احْتَاجَ إِلَی الصُّوفِ أَخَذَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15155","","","كتاب الحج"
"15156","(۱۵۱۵۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ عَطَائٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَخَّصَ لَہُمْ أَنْ یَرْکَبُوہَا ، إِذَا احْتَاجُوا إِلَیْہَا۔","","Musannaf Ibn Abi Shaybah 15156","","","كتاب الحج"
"15157","(۱۵۱۵۷) حدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ تَرْکَبِ الْبَدَنَۃَ ، وَلاَ تَحْمِلْ عَلَیْہَا إِلاَّ مِنْ أَمْرٍ لاَ تَجِدُ مِنْہُ بُدًّا ، وَلاَ تَشْرَبْ مِنْ لَبَنِہَا إِلاَّ أَنْ تُرْمِلَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15157","","","كتاب الحج"
"15158","(۱۵۱۵۸) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الْکَنُودِ ، عَنْ عَبْدِ اللہِ ؛ فِی الرَّجُلِ یَعْتِقُ أَمَتَہُ وَیَتَزَوَّجُہَا ، قَالَ : ہُوَ کَالرَّاکِبِ بَدَنَتَہُ۔",": Hasan","Musannaf Ibn Abi Shaybah 15158","","","كتاب الحج"
"15159","(۱۵۱۵۹) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : ارْکَبْہَا۔\n(بخاری ۱۶۹۰۔ احمد ۳/۲۳۱)",": Sahih","Musannaf Ibn Abi Shaybah 15159","","","كتاب الحج"
"15160","(۱۵۱۶۰) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : سُئِلَ ابْنُ عُمَرَ عَنِ الرَّجُلِ یَعْتِقُ أَمَتَہُ ، ثُمَّ یَتَزَوَّجُہَا ؟ قَالَ: ہُوَ کَالرَّاکِبِ بَدَنَتَہُ۔","","Musannaf Ibn Abi Shaybah 15160","","","كتاب الحج"
"15161","(۱۵۱۶۱) حدَّثَنَا إِسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ (ح) وَعَنْ أَیُّوبَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی رَجُلٍ وَقَعَ عَلَی امْرَأَتِہِ قَبْلَ أَنْ یَزُورَ الْبَیْتَ ، قَالَ : عَلَیْہِ دَمٌ۔",": Da'if","Musannaf Ibn Abi Shaybah 15161","","","كتاب الحج"
"15162","(۱۵۱۶۲) حدَّثَنَا وَکِیعٌ ، عَنْ دَاوُدَ ، عَنْ أَبِی الضُّحَی ، عَنْ عَلْقَمَۃَ ، قَالَ : إِذَا وَاقَعَ قَبْلَ أَنْ یَزُورَ فَعَلَیْہِ بَدَنَۃٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15162","","","كتاب الحج"
"15163","(۱۵۱۶۳) حدَّثَنَا سَلاَّمٌ ، عَنْ خُصَیْفٍ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ ؛ فِی الرَّجُلِ یَقْضِی الْمَنَاسِکَ کُلَّہَا إِلاَّ الطَّوَافَ بِالْبَیْتِ ، ثُمَّ وَقَعَ عَلَی أَہْلِہِ ، قَالاَ : عَلَیْہِ بَدَنَۃٌ ، وَتَمَّ حَجَّہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15163","","","كتاب الحج"
"15164","(۱۵۱۶۴) حدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ إِبْرَاہِیمَ، قَالَ: إِذَا وَاقَعَ قَبْلَ أَنْ یَزُورَ، فَعَلَیْہِ بَدَنَۃٌ، وَالْحَجُّ مِنْ قَابِلٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15164","","","كتاب الحج"
"15165","(۱۵۱۶۵) حدَّثَنَا ابْنُ فُضَیْلٍ ، وَسَلاَّمٌ ، عَنْ لَیْثٍ ، عَنْ حُمَیْدٍ ، قَالَ : جَائَ رَجُلٌ إِلَی ابْنِ عُمَرَ ، فَقَالَ : یَا أَبَا عَبْدِ الرَّحْمَن ، رَجُلٌ جَاہِلٌ بِالسُّنَّۃِ ، بَعِیدُ الشُّقَّۃِ ، قَلِیلُ ذَاتِ الْیَدِ ، قَضَیْتُ الْمَنَاسِکَ کُلَّہَا ، غَیْرَ أَنِّی لَمْ أَزُرِ الْبَیْتَ حَتَّی وَقَعْتُ عَلَی امْرَأَتِی ، فَقَالَ : بَدَنَۃٌ ، وَحَجٌّ مِنْ قَابِلٍ ، فَأَعَادَ عَلَیْہِ ثَلاَثَ مَرَّاتٍ ، کُلُّ ذَلِکَ یَقُولُ : بَدَنَۃٌ ، وَحَجٌّ مِنْ قَابِلٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 15165","","","كتاب الحج"
"15166","(۱۵۱۶۶) حدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ؛ فِی الَّذِی یَقَعُ عَلَی امْرَأَتِہِ قَبْلَ أَنْ یَزُورَ الْبَیْتَ ، قَالَ : عَلَیْہِ بَدَنَۃٌ۔","","Musannaf Ibn Abi Shaybah 15166","","","كتاب الحج"
"15167","(۱۵۱۶۷) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ عَطَائٍ ، قَالَ : سُئِلَ ابْنُ عَبَّاسٍ عَنْ رَجُلٍ وَقَعَ عَلَی امْرَأَتِہِ قَبْلَ أَنْ یَزُورَ الْبَیْتَ ؟ قَالَ : عَلَیْہِ وَعَلَی امْرَأَتِہِ بَدَنَۃٌ۔",": Sahih","Musannaf Ibn Abi Shaybah 15167","","","كتاب الحج"
"15168","(۱۵۱۶۸) حدَّثَنَا وَکِیعٌ، عَنْ حَسَنٍ، عَنْ جَابِرٍ، عَنْ أَبِی جَعْفَرٍ قَالَ: إِذَا وَاقَعَ قَبْلَ أَنْ یَزُورَ، فَعَلَیْہِ الْحَجَّ مِنْ قَابِلٍ۔","","Musannaf Ibn Abi Shaybah 15168","","","كتاب الحج"
"15169","(۱۵۱۶۹) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : عَلَیْہِ الْحَجُّ ، وَیُہْدِی۔",": Hasan","Musannaf Ibn Abi Shaybah 15169","","","كتاب الحج"
"15170","(۱۵۱۷۰) حدَّثَنَا أَبُو نُعَیْمٍ ، عَنِ ابْنِ أَبِی غَنِیَّۃَ ، عَنْ یَحْیَی بْنِ سَالِمٍ ، قَالَ : دَخَلْتُ أَنَا وَرَجُلٌ مِنْ بَنِی نَاجِیَۃَ عَلَی ابْنِ الْحَنَفِیَّۃِ ، فَقَالَ : رَجُلٌ قَضَی الْمَنَاسِکَ کُلَّہَا ، فَلَمَّا کَانَ یَوْمَ النَّحْرِ وَقَعَ عَلَی أَہْلِہِ قَبْلَ أَنْ یَزُورَ ، قَالَ : عَلَیْہِ بَدَنَۃٌ ، وَمَا قَالَ : عَلَیْہِ الْحَجُّ مِنْ قَابِلٍ۔","","Musannaf Ibn Abi Shaybah 15170","","","كتاب الحج"
"15171","(۱۵۱۷۱) حدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ؛ فِی الْمُحْرِمِ یُوَاقِعُ قَبْلَ أَنْ یَطُوفَ بِالْبَیْتِ ، قَالَ : یُتِمَّانِ حَجَّہُمَا ، وَیُہْرِیقُ کُلُّ وَاحِدٍ مِنْہُمَا دَمًا ، وَعَلَیْہِمَا الْحَجُّ مِنْ قَابِلٍ۔","","Musannaf Ibn Abi Shaybah 15171","","","كتاب الحج"
"15172","(۱۵۱۷۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یُہْرِیقُ دَمًا ، وَعَلَیْہِ الْحَجُّ مِنْ قَابِلٍ۔","","Musannaf Ibn Abi Shaybah 15172","","","كتاب الحج"
"15173","(۱۵۱۷۳) حدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدٍ ، عَنْ أَبِی بِشْرٍ ، عَنْ عَلِیِّ بْنِ عَبْدِ اللہِ الْبَارِقِیِّ ، عَنِ ابْنِ عُمَرَ ، قَالَ : عَلَیْہِ الْحَجُّ مِنْ قَابِلٍ ، قُلْتُ : وَإِنْ حَجَّ مِنْ عُمَانَ ؟ قَالَ : وَإِنْ حَجَّ مِنْ عُمَانَ۔","","Musannaf Ibn Abi Shaybah 15173","","","كتاب الحج"
"15174","(۱۵۱۷۴) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عِکْرِمَۃَ ، وَعَطَائٍ ؛ أَنَّہُمَا قَالاَ فِی الرَّجُلِ یَقَعُ عَلَی امْرَأَتِہِ قَبْلَ أَنْ یَزُورَ الْبَیْتَ ، قَالاَ : عَلَیْہِ بَدَنَۃٌ۔","","Musannaf Ibn Abi Shaybah 15174","","","كتاب الحج"
"15175","(۱۵۱۷۵) حدَّثَنَا وَکِیعٌ ، عَنْ مَالِکٍ ، عَنْ عَطَائٍ ، قَالَ : جَزُورٌ ، وَقَدْ تَمَّ حَجُّہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15175","","","كتاب الحج"
"15176","(۱۵۱۷۶) حدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، عَنْ عَطَائٍ ، قَالَ : لاَ تُقْمَلْ وَأَنْتَ مُحْرِمٌ۔","","Musannaf Ibn Abi Shaybah 15176","","","كتاب الحج"
"15177","(۱۵۱۷۷) حدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، قَالَ : یَحُکُّ رَأْسَہُ بِبَطْنِ أَنَامِلِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15177","","","كتاب الحج"
"15178","(۱۵۱۷۸) حدَّثَنَا عَبْدُ السَّلاَمُ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَحُکَّ الْمُحْرِمُ رَأْسَہُ حَکًّا رَفِیقًا۔","","Musannaf Ibn Abi Shaybah 15178","","","كتاب الحج"
"15179","(۱۵۱۷۹) حدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، قَالَ : سَأَلَنِی رَجُلٌ : أَحُکُّ رَأْسِی وَأَنَا مُحْرِمٌ ؟ قَالَ : إِنْ شِئْتَ ، قَالَ : إِنِّی حَکَکْتُہُ فَوَقَعَتْ مِنْہُ قَمْلَۃٌ ، فَطَلَبْتہَا فَلَمْ أَجِدْہَا ، قَالَ : ضَالَّۃٌ لاَ تُوجَدُ۔",": Sahih","Musannaf Ibn Abi Shaybah 15179","","","كتاب الحج"
"15180","(۱۵۱۸۰) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عُیَیْنَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ؛ أَنَّ رَجُلاً قَالَ لابْنِ عَبَّاسٍ وَہُوَ فِی الْحَجِّ وَہُوَ مُحْرِمٌ : أَحُکُّ رَأْسِی وَأَنَا مُحْرِمٌ ؟ فَجَمَعَ ابْنُ عَبَّاسٍ یَدَیْہِ جَمِیعًا ، فَحَکَّ بِہِمَا رَأْسَہُ ، وَقَالَ : أَمَّا أَنَا فَأَقُولُ ہَکذَا ، فَقَالَ لَہُ الرَّجُلُ : أَرَأَیْتَ إِنْ قَتَلْتُ قَمْلَۃً ؟ فَقَالَ : بَعُدْتَ ، وَمَا الْقَمْلَۃُ مَانِعَتِی مِنْ حَکِّ رَأْسِی ، وَمَا نُہِیتُمْ إِلاَّ عَنِ الصَّیْدِ۔","","Musannaf Ibn Abi Shaybah 15180","","","كتاب الحج"
"15181","(۱۵۱۸۱) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ؛ أَنَّہُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللہِ یَقُولُ : بِبَطْنِ أَنَامِلِہِ ، یَقُولُ فِی حَکِّ الْمُحْرِمِ رَأْسَہُ ، قَالَ : وَأَخْبَرَنِی مَنْ رَأَی عُمَرَ یَحُکَّ حَکًّا۔","","Musannaf Ibn Abi Shaybah 15181","","","كتاب الحج"
"15182","(۱۵۱۸۲) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الْمُحْرِمِ یَحُکُّ رَأْسَہُ ، قَالَ : نَعَمْ ، یَحُکُّہُ بِأَنَامِلِہِ۔","","Musannaf Ibn Abi Shaybah 15182","","","كتاب الحج"
"15183","(۱۵۱۸۳) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ إِبْرَاہِیمَ بْنِ مُہَاجِرٍ ، قَالَ : قُلْتُ لَہُ : سَمِعْتَ إِبْرَاہِیمَ لاَ یَرَی بَأْسًا أَنْ یَحُکَّ الْمُحْرِمُ رَأْسَہُ ؟ قَالَ : نَعَمْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15183","","","كتاب الحج"
"15184","(۱۵۱۸۴) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ یَحُکُّ رَأْسَہُ وَہُوَ مُحْرِمٌ ، فَتَفَطَّنْتُ فَإِذَا ہُوَ یَحُکُّہُ بِأَنَامِلِہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15184","","","كتاب الحج"
"15185","(۱۵۱۸۵) حدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ، عَنْ أَبِی إِسْحَاقَ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ، قَالَ: لاَ بَأْسَ أَنْ یَحُکَّ رَأْسَہُ وَہُوَ مُحْرِمٌ۔","","Musannaf Ibn Abi Shaybah 15185","","","كتاب الحج"
"15186","(۱۵۱۸۶) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَطَائٍ ، قَالَ : یَحُکَّہُ حَکًّا خَفِیفًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15186","","","كتاب الحج"
"15187","(۱۵۱۸۷) حدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ ، عَنْ لَیْثٍ ، عَنْ صَدَقَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ؛ فِی رَجُلٍ حَلَقَ قَبْلَ أَنْ یَنْحَرَ ، قَالَ: عَلَیْہِ الْفِدْیَۃُ ، قَالَ : فَسَأَلْتُ مُجَاہِدًا ، وَطَاوُوسًا ؟ فَقَالاَ : لَیْسَ عَلَیْہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 15187","","","كتاب الحج"
"15188","(۱۵۱۸۸) حدَّثَنَا سَلاَّمٌ ، عَنْ إِبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ قَدَّمَ شَیْئًا مِنْ حَجِّہِ ، أَوْ أَخَّرَہُ ، فَلْیُہْرِقْ لِذَلِکَ دَمًا۔",": Hasan","Musannaf Ibn Abi Shaybah 15188","","","كتاب الحج"
"15189","(۱۵۱۸۹) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : مَنْ قَدَّمَ مِنْ حَجِّہِ شَیْئًا قَبْلَ شَیْئٍ ، أَوْ حَلَقَ قَبْلَ أَنْ یَذْبَحَ ، فَعَلَیْہِ دَمٌ یُہْرِیقُہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15189","","","كتاب الحج"
"15190","(۱۵۱۹۰) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا حَلَقَ قَبْلَ أَنْ یَذْبَحَ ، أَہْرَاقَ لِذَلِکَ دَمًا ، ثُمَّ قَرَأَ : {وَلاَ تَحْلِقُوا رُؤُوسَکُمْ حَتَّی یَبْلُغَ الْہَدْیُ مَحِلَّہُ}۔",": No Data Available","Musannaf Ibn Abi Shaybah 15190","","","كتاب الحج"
"15191","(۱۵۱۹۱) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ : مَنْ أَحْدَثَ فِی حَجِّہِ شَیْئًا لاَ یَنْبَغِی ، ذَبَحَ لِذَلِکَ ذَبِیحَۃً۔",": No Data Available","Musannaf Ibn Abi Shaybah 15191","","","كتاب الحج"
"15192","(۱۵۱۹۲) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَدَّمَ مِنْ حَجِّہِ شَیْئًا مَکَانَ شَیْئٍ ، فَلاَ حَرَجَ۔",": Da'if","Musannaf Ibn Abi Shaybah 15192","","","كتاب الحج"
"15193","(۱۵۱۹۳) حدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ مِِِِِثْلَہُ۔\n(ابوداؤد ۱۹۳۲۔ احمد ۳/۳۲۶)",": Hasan","Musannaf Ibn Abi Shaybah 15193","","","كتاب الحج"
"15194","(۱۵۱۹۴) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عِیسَی بْنِ طَلْحَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ؛ إِنْ شَائَ اللَّہُ ، قَالَ : أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلٌ ، فَقَالَ : حَلَقْتُ قَبْلَ أَنْ أَذْبَحَ ؟ قَالَ : فَاذْبَحْ وَلاَ حَرَجَ ، قَالَ : ذَبَحْتُ قَبْلَ أَنْ أَرْمِیَ ؟ قَالَ : اِرْمِ وَلاَ حَرَجَ۔ (بخاری ۸۳۔ ترمذی ۹۱۶)",": Sahih","Musannaf Ibn Abi Shaybah 15194","","","كتاب الحج"
"15195","(۱۵۱۹۵) حدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَیَّاشٍ ، عَنْ زَیْدِ بْنِ عَلِیٍّ ، عَنْ أَبِیہِ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی رَافِعٍ، عَنْ عَلِیٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّ رَجُلاً أَتَاہُ ، فَقَالَ : أَفَضْتُ قَبْلَ أَنْ أَحْلِقَ، قَالَ : فَاحْلِقْ ، أَوْ قَصِّرْ وَلاَ حَرَجَ۔ (ترمذی ۸۸۵۔ احمد ۱/۷۶)",": Hasan","Musannaf Ibn Abi Shaybah 15195","","","كتاب الحج"
"15196","(۱۵۱۹۶) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ رَجُلاً سَأَلَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : رَمَیْتُ بَعْدَ مَا أَمْسَیْتُ ؟ قَالَ : لاَ حَرَجَ ، وَقَالَ : حَلَقْتُ قَبْلَ أَنْ أَنْحَرَ ؟ قَالَ : لاَ حَرَجَ۔\n(بخاری ۱۷۳۵۔ ابوداؤد ۱۹۷۶)",": Sahih","Musannaf Ibn Abi Shaybah 15196","","","كتاب الحج"
"15197","(۱۵۱۹۷) حدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ زِیَادِ بْنِ عِلاَقَۃَ ، عَنْ أُسَامَۃَ بْنِ شَرِیکٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سُئِلَ عَنْ رَجُلٍ حَلَقَ قَبْلَ أَنْ یَذْبَحَ ؟ قَالَ : لاَ حَرَجَ۔ (ابوداؤد ۲۰۰۸)",": Sahih","Musannaf Ibn Abi Shaybah 15197","","","كتاب الحج"
"15198","(۱۵۱۹۸) حدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا وُہَیْبٌ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سُئِلَ عَنِ الرَّجُلِ یَذْبَحُ قَبْلَ أَنْ یَحْلِقَ ؟ فَقَالَ : لاَ حَرَجَ۔ (بخاری ۱۷۳۴۔ مسلم ۹۵۰)",": Sahih","Musannaf Ibn Abi Shaybah 15198","","","كتاب الحج"
"15199","(۱۵۱۹۹) حدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سُئِلَ عَنِ التَّقْدِیمِ وَالتَّأْخِیرِ فِی الْحَجِّ ؟ فَقَالَ : لاَ حَرَجَ۔ (نسائی ۴۱۰۵۔ احمد ۳/۳۸۵)",": Sahih","Musannaf Ibn Abi Shaybah 15199","","","كتاب الحج"
"15200","(۱۵۲۰۰) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ جَمِیلِ بْنِ زَیْدٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ طَافَ بِالْبَیْتِ ثَلاَثَۃَ أَطْوَافٍ ، ثُمَّ قَعَدَ یَسْتَرِیحُ ، وَغُلاَمٌ لَہُ یَرُوِّحُ عَلَیْنَا ، ثُمَّ قَامَ فَبَنَی عَلَی طَوَافِہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15200","","","كتاب الحج"
"15201","(۱۵۲۰۱) حدَّثَنَا مُحَمَّدُ بْنُ مُیَسَّرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : أَسْتَرِیحُ فِی الطَّوَافِ فَأَجْلِسُ ؟ قَالَ : نَعَمْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15201","","","كتاب الحج"
"15202","(۱۵۲۰۲) حدَّثَنَا ابْنُ إِدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَسْتَرِیحَ الرَّجُلُ فِی سَعْیِہِ ، إِذَا طَافَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ مِنْ حَصْرٍ۔","","Musannaf Ibn Abi Shaybah 15202","","","كتاب الحج"
"15203","(۱۵۲۰۳) حدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ عَبْدِ الْکَرِیمِ الْجَزَرِیِّ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یَسْتَرِیحَ الرَّجُلُ بَیْنَ الصَّفَا وَالْمَرْوَۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15203","","","كتاب الحج"
"15204","(۱۵۲۰۴) حدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ أَبِی الْعَالِیَۃِ الْوَاسِطِیِّ ، قَالَ : رَأَیْتُ الْحَسَنَ یَسْتَرِیحُ بَیْنَہُمَا ، فَذَکَرْتُہُ لِمُجَاہِدٍ ، فَکَرِہَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15204","","","كتاب الحج"
"15205","(۱۵۲۰۵) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : عَرَّفَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْبُدْنِ الَّتِی کَانَ أَہْدَی۔","","Musannaf Ibn Abi Shaybah 15205","","","كتاب الحج"
"15206","(۱۵۲۰۶) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ ہَدْیَ إِلاَّ مَا قُلِّدَ وَأُشْعِرَ ، وَوُقِفَ بِہِ بِعَرَفَۃَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15206","","","كتاب الحج"
"15207","(۱۵۲۰۷) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ : حجَجْتُ مَعَ الأَسْوَدِ وَمَعَہُ ہَدْیٌ کَثِیرٌ ، فَدَخَلَ عَلَی عَائِشَۃَ فَسَأَلَہَا ؟ فَرَأَیْتُہُ خَلْفَہُ بِمِنًی لَمْ یُعَرِّف بِہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15207","","","كتاب الحج"
"15208","(۱۵۲۰۸) حدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، قَالَ : رَأَیْتُ الْقَاسِمَ یَسُوقُ بَدَنَتَہُ إِلَی الْمَوْقِفِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15208","","","كتاب الحج"
"15209","(۱۵۲۰۹) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ: أَرْسَلَ إِلَی عَائِشَۃَ ، فَسَأَلَہَا: أَیُعَرِّفُ بِالْبَدَنَۃِ ؟ قَالَ : فَقَالَتْ : نَعَمْ ، قَالَ : فَقَالَ : أَتُشْعَرُ ؟ قَالَ : فَقَالَتْ : إِنْ شِئْتَ ، إِنَّمَا أُشْعِرَتْ لِیُعْلَمَ أَنَّہَا بَدَنَۃٌ۔",": Sahih","Musannaf Ibn Abi Shaybah 15209","","","كتاب الحج"
"15210","(۱۵۲۱۰) حدَّثَنَا وَکِیعٌ ، عَنْ رَبَاحِ بْنِ أَبِی مَعْرُوفٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ شَائَ عَرَّفَ ، وَمَنْ شَائَ لَمْ یُعَرِّفْ ، إِنَّمَا کَانُوا یُعَرِّفُونَ مَخَافَۃَ السَّرَقِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15210","","","كتاب الحج"
"15211","(۱۵۲۱۱) حدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ تَرَکَ بَدَنَتَہُ بِمِنًی فَلَمْ یُعَرِّفْ بِہَا ، قَالَ : یُجْزِئُہُ ، وَکَانَ یُعْجِبُہُ أَنْ یُعَرِّفَ بِہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15211","","","كتاب الحج"
"15212","(۱۵۲۱۲) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَلْقَمَۃَ ، قَالَ : بَعَثَ مَعِی عَبْدُ اللہِ بِہَدْیِہِ ، فَقَالَ : إِذَا کَانَ عَشِیَّۃَ عَرَفَۃَ فَعَرِّفْ بِہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15212","","","كتاب الحج"
"15213","(۱۵۲۱۳) حدَّثَنَا أَبُو نُعَیْمٍ ، عَنْ حُسَیْنِ بْنِ عُقَیْلٍ ، عَنِ الضَّحَّاکِ ، قَالَ : مَنْ أَہْدَی ہَدْیًا فَکَانَ مَعَہُ عَرَّفَ بِہِ۔","","Musannaf Ibn Abi Shaybah 15213","","","كتاب الحج"
"15214","(۱۵۲۱۴) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عُمَرَ بْنِ مُحَمَّدٍ ، عَنْ سَالِمٍ ، قَالَ : أَحْرَمَ ابْنُ عُمَرَ بِعُمْرَۃٍ ، ثُمَّ سَارَ سَاعَۃً، ثُمَّ قَالَ : مَا الْحَجُّ وَالْعُمْرَۃُ إِلاَّ سَوَائٌ ، أُشْہِدُکُمْ أَنِّی قَدْ أَوْجَبْتُ مَعَہَا حَجَّۃً۔",": Sahih","Musannaf Ibn Abi Shaybah 15214","","","كتاب الحج"
"15215","(۱۵۲۱۵) حدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، عَنِ الْقَاسِمِ بْنِ نَافِعٍ ، عَنْ جَابِرٍ ، قَالَ : قَالَ لَہُ رَجُلٌ : إِنِّی جَرَّدْتُ الْحَجَّ ، أَفَأَضُمُّ إِلَیْہِ عُمْرَۃً ؟ قَالَ : نَعَمْ ، وَاذْبَحْ کَبْشًا۔",": Da'if","Musannaf Ibn Abi Shaybah 15215","","","كتاب الحج"
"15216","(۱۵۲۱۶) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ إِسْمَاعِیلَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یُضِیفُ الْحَجَّ إِلَی الْعُمْرَۃِ ، وَلاَ یُضِیفُ الْعُمْرَۃَ إِلَی الْحَجِّ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15216","","","كتاب الحج"
"15217","(۱۵۲۱۷) حدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ (ح) وَعَنْ عَطَائٍ ، وَطَاوُوسٍ ، أَوْ أَحَدِہِمَا ؛ فِی رَجُلٍ أَہَلَّ بِالْحَجِّ ، قَالاَ : إِنْ شَائَ جَعَلَ مَعَہُ عُمْرَۃً ، فَکَانَ قَارِنًا ، وَأَہْدَی ہَدْیًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15217","","","كتاب الحج"
"15218","(۱۵۲۱۸) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، وَعَطَائٍ ، وَنَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمَّا قَدِمَ مَکَّۃَ اسْتَلَمَ الْحَجَرَ الأَسْوَدَ وَالرُّکْنَ الْیَمَانِیَ ، وَلَمْ یَسْتَلِمْ غَیْرَہُمَا مِنَ الأَرْکَانِ۔ (طبرانی ۱۲)",": Sahih","Musannaf Ibn Abi Shaybah 15218","","","كتاب الحج"
"15219","(۱۵۲۱۹) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : أَدْرَکْتُ مَشْیَخَتَنَا ؛ ابْنَ عَبَّاسٍ ، وَجَابِرًا ، وَأَبَا ہُرَیْرَۃَ، وَعُبَیْدَ بْنَ عُمَیْرٍ ، لاَ یَسْتَلِمُونَ إِلاَّ الْحَجَرَ الأَسْوَدَ وَالرُّکْنَ ، لاَ یَسْتَلِمُونَ غَیْرَہُمَا مِنَ الأَرْکَانِ۔","","Musannaf Ibn Abi Shaybah 15219","","","كتاب الحج"
"15220","(۱۵۲۲۰) حدَّثَنَا أَبُو نُعَیْمٍ ، عَنْ إِسْرَائِیلَ ، عَنْ إِبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، قَالَ : رَأَیْتُ سُوَیْد بْنَ غَفَلَۃَ یَسْتَلِمُ أَرْکَانَ الْبَیْتِ کُلَّہَا۔","","Musannaf Ibn Abi Shaybah 15220","","","كتاب الحج"
"15221","(۱۵۲۲۱) حدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ یَعْلَی بْنِ أُمَیَّۃَ ، قَالَ : لَمَّا أَنْ حَجَّ عُمَرُ اسْتَلَمَ الرُّکْنَ ، وَکَانَ یَعْلَی بْنُ أُمَیَّۃَ یَسْتَلِمُ الأَرْکَانَ کُلَّہَا ، فَقَالَ لَہُ عُمَرُ : یَا یَعْلَی ، مَا تَفْعَلُ ؟ قَالَ : أَسْتَلِمُہَا کُلَّہَا، لأَنَّہُ لَیْسَ شَیْئٌ مِنَ الْبَیْتِ یُہْجَرُ ، قَالَ : فَقَالَ عُمَرُ : أَمَا رَأَیْتَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمْ یَسْتَلِمْ مِنْہَا إِلاَّ الْحَجَرَ ؟ قَالَ : بَلَی ، قَالَ : فَمَا لَکَ بِہِ أُسْوَۃً ؟ قَالَ : بَلَی۔ (طبرانی ۵۰۴۹)",": Da'if","Musannaf Ibn Abi Shaybah 15221","","","كتاب الحج"
"15222","(۱۵۲۲۲) حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ قَلَّ مَا یَتْرُکُ الْحَجَرَ الأَسْوَدَ وَالرُّکْنَ الْیَمَانِیَ ، إِلاَّ اسْتَلَمَہُمَا فِی الْوِتْرِ مِنْ طَوَافِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15222","","","كتاب الحج"
"15223","(۱۵۲۲۳) حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : الرُّکْنَانِ اللَّذَانِ یَلِیَانِ الْحَجَرَ لاَ یُسْتَلَمَانِ۔","","Musannaf Ibn Abi Shaybah 15223","","","كتاب الحج"
"15224","(۱۵۲۲۴) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ ابْنِ إِسْحَاقَ ، عَنْ یَحْیَی بْنِ عَبَّادِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ ؛ أَنَّہُ رَأَی مُعَاوِیَۃَ یَطُوفُ بِالْبَیْتِ فَاسْتَلَمَ الأَرْکَانَ کُلَّہَا ، وَقَالَ : إِنَّہُ لَیْسَ مِنْہُ شَیْئٌ مَہْجُورٌ۔","","Musannaf Ibn Abi Shaybah 15224","","","كتاب الحج"
"15225","(۱۵۲۲۵) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ ابْنِ إِسْحَاقَ ، عَنْ یَحْیَی بْنِ عَبَّادٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ رَأَی ابْنَ الزُّبَیْرِ فَعَلَہُ ، وَقَالَ : إِنَّہُ لَیْسَ مِنْہُ شَیْء مَہْجُورٌ۔","","Musannaf Ibn Abi Shaybah 15225","","","كتاب الحج"
"15226","(۱۵۲۲۶) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : لاَ یُتَّقَی مِنَ الْبَیْتِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 15226","","","كتاب الحج"
"15227","(۱۵۲۲۷) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَسْتَلِمُ الأَرْکَانَ کُلَّہَا ، یَخْتِمُ بِہَا ، وَیَلْزَقُ بَطْنَہُ وَظَہْرَہُ وَجَنْبَیْہِ بِالْبَیْتِ۔","","Musannaf Ibn Abi Shaybah 15227","","","كتاب الحج"
"15228","(۱۵۲۲۸) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ رَجَعَ إِلَی الْحَجَرِ فَاسْتَلَمَہُ ، یَعْنِی بَعْدَ الرَّکْعَتَیْنِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15228","","","كتاب الحج"
"15229","(۱۵۲۲۹) حدَّثَنَا حَاتِمٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَمَلَ ثَلاَثًا ، وَمَشَی أَرْبَعًا ، ثُمَّ أَتَی مَقَامَ إِبْرَاہِیمَ فَقَرَأَ : {وَاتَّخِذُوا مِنْ مَقَامِ إِبْرَاہِیمَ مُصَلًّی} فَجَعَلَ الْمَقَامَ بَیْنَہُ وَبَیْنَ الْبَیْتِ ، ثُمَّ رَجَعَ إِلَی الرُّکْنِ فَاسْتَلَمَہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 15229","","","كتاب الحج"
"15230","(۱۵۲۳۰) حدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ إِذَا صَلَّی الرَّکْعَتَیْنِ رَجَعَ إِلَی الْحَجَرِ فَاسْتَلَمَہُ ، أَوِ اسْتَقْبَلَہُ ، فَکَبَّرَ ، ثُمَّ خَرَجَ إِلَی الصَّفَا۔",": Da'if","Musannaf Ibn Abi Shaybah 15230","","","كتاب الحج"
"15231","(۱۵۲۳۱) حدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، قَالَ : رَأَیْتُہُ یَفْعَلُ ذَلِکَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15231","","","كتاب الحج"
"15232","(۱۵۲۳۲) حدَّثَنَا حُمَیْدٌ ، عَنْ حُسَیْنِ بْنِ عُقَیْلٍ ، عَنِ الضَّحَّاکِ ، قَالَ : إِذَا أَتَیْتَ الْبَیْتَ فَاسْتَلِمِ الْحَجَرَ إِنْ قَدَرْتَ عَلَیْہِ ، وَذَکَرْتَ اللَّہَ ، وَصَلَّیْتَ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ تُصَلِّی عِنْدَ الْمَقَامِ رَکْعَتَیْنِ ، أَوْ مَا شَائَ اللَّہُ ، ثُمَّ تَمْضِی تُجَاہَ وَجْہِکَ فَتَسْتَلِمُ الْحَجَرَ ، وَإِلاَّ فَاسْتَقْبِلْہُ وَذَکَرْتَ اللَّہَ ، ثُمَّ تَخْرُجُ إِلَی الصَّفَا۔",": Hasan","Musannaf Ibn Abi Shaybah 15232","","","كتاب الحج"
"15233","(۱۵۲۳۳) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَعُودُ إِلَی الْحَجَرِ فَیَسْتَلِمُہُ ، ثُمَّ یَخْرُجُ إِلَی الصَّفَا۔",": Sahih","Musannaf Ibn Abi Shaybah 15233","","","كتاب الحج"
"15234","(۱۵۲۳۴) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ بْنِ أَبِی سَارَۃَ ، قَالَ : رَأَیْتُ سَالِمًا طَافَ بِالْبَیْتِ ، ثُمَّ صَلَّی رَکْعَتَیْنِ خَلْفَ الْمَقَامِ ، ثُمَّ عَادَ إِلَی الْحَجَرِ فَاسْتَلَمَہُ ، ثُمَّ خَرَجَ إِلَی الصَّفَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15234","","","كتاب الحج"
"15235","(۱۵۲۳۵) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إِنْ شِئْتَ فَارْجِعْ إِلَی الْحَجَرِ بَعْدَ الرَّکْعَتَیْنِ ، وَإِنْ شِئْتَ فَلاَ تَرْجِعْ إِلَیْہِ۔","","Musannaf Ibn Abi Shaybah 15235","","","كتاب الحج"
"15236","(۱۵۲۳۶) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : جَائَتِ امْرَأَۃٌ إِلَی ابْنِ عَبَّاسٍ ، فَقَالَتْ : إِنَّ أُمِّی مَاتَتْ وَعَلَیْہَا حَجَّۃٌ ، فَأَقْضِیہَا عَنْہَا ؟ فَقَالَ ابْنُ عَبَّاسٍ : ہَلْ کَانَ عَلَی أُمِّکَ دَیْنٌ ؟ قَالَتْ : نَعَمْ : قَالَ : فَکَیْفَ صَنَعْتِ ؟ قَالَتْ : قَضَیْتُہُ عَنْہَا ، قَالَ ابْنُ عَبَّاسٍ : فَاللَّہُ خَیْرُ غُرَمَائِکِ۔","","Musannaf Ibn Abi Shaybah 15236","","","كتاب الحج"
"15237","(۱۵۲۳۷) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ النُّعْمَانِ بْنِ سَالِمٍ ، عَنْ عَمْرِو بْنِ أَوْسٍ ، عَنْ أَبِی رَزِینٍ الْعُقَیْلِیِّ ؛ أَنَّہُ أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، إِنَّ أَبِی شَیْخٌ کَبِیرٌ ، لاَ یَسْتَطِیعُ الْحَجَّ وَالْعُمْرَۃَ ، وَلاَ الظَّعْنَ ، قَالَ : حُجَّ عَنْ أَبِیکَ وَاعْتَمِرْ۔ (ترمذی ۹۳۰۔ احمد ۴/۱۱)",": Sahih","Musannaf Ibn Abi Shaybah 15237","","","كتاب الحج"
"15238","(۱۵۲۳۸) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : جَائَ رَجُلٌ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، إِنَّ أَبِی شَیْخٌ کَبِیرٌ لاَ یَسْتَطِیعُ الْحَجَّ ، أَفَأَحُجُّ عَنْہُ ؟ قَالَ : نَعَمْ ، فَحُجَّ عَنْ أَبِیکَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15238","","","كتاب الحج"
"15239","(۱۵۲۳۹) حدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، قَالَ فِی الشَّیْخِ الْکَبِیرِ ، قَالَ : یُجَہِّزُ رَجُلاً بِنَفَقَتِہِ ، فَیَحُجُّ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 15239","","","كتاب الحج"
"15240","(۱۵۲۴۰) حدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ ابْنَ الزُّبَیْرِ کَانَ یُقِیمُ بِمَکَّۃَ السِّنِینَ ، یُہِلُّ بِالْحَجِّ لِہِلاَلِ ذِی الْحِجَّۃِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15240","","","كتاب الحج"
"15241","(۱۵۲۴۱) حدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ لابْنِ عُمَرَ : قَدْ رُئِیَ الْہِلاَلُ ، فَأَہَلَّ مَکَانِہِ ہِلاَلُ ذِی الْحِجَّۃِ ، فَلَمَّا کَانَ فِی الْعَامِ الْمُقْبِلِ ، قِیلَ لَہُ : قَدْ رُئِیَ الْہِلاَلُ ، وَہُوَ فِی الْبَیْتِ ، فَنَزَعَ ثَوْبًا کَانَ عَلَیْہِ ، ثُمَّ أَہَلَّ ، فَلَمَّا کَانَ الْعَامُ الثَّالِثُ ، قِیلَ لَہُ : قَدْ رُئِیَ الْہِلاَلُ ، فَقَالَ : مَا أَنَا إِلاَّ رَجُلٌ مِنْ أَصْحَابِی ، أَصْنَعُ کَمَا یَصْنَعُونَ ، فَأَقَامَ حَلاَلاً حَتَّی کَانَ یَوْمُ التَّرْوِیَۃِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15241","","","كتاب الحج"
"15242","(۱۵۲۴۲) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عُمَرُ: یَا أَہْلَ مَکَّۃَ ، مَا لِی اَرَاکُمْ مُدَّہِنِینَ ، وَالْحَاجَّ شُعْثًا غُبْرًا ؟ إِذَا رَأَیْتُمْ ہِلاَلَ ذِی الْحِجَّۃِ فَأَہِلُّوا۔","","Musannaf Ibn Abi Shaybah 15242","","","كتاب الحج"
"15243","(۱۵۲۴۳) حدَّثَنَا أَبُونُعَیْمٍ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ، عَنْ قُزْعَۃَ الْبَاہِلِیِّ، عَنِ الْحَسَنِ؛ أَنَّہُ أَہَلَّ بِمَکَّۃَ حِینَ رَأَی الْہِلاَلَ۔","","Musannaf Ibn Abi Shaybah 15243","","","كتاب الحج"
"15244","(۱۵۲۴۴) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ عَطَائٍ ، قَالَ : قدِمَ ابْنُ عُمَرَ فَطَافَ ، ثُمَّ سَعَی ، ثُمَّ أَحَلَّ ، فَمَکَثَ أَرْبَعًا ، أَوْ خَمْسًا ، ثُمَّ أَہَلَّ بِالْحَجِّ فِی الْعَشْرِ ، ثُمَّ جَائَ مَرَّۃً أُخْرَی فَأَقَامَ حَلاَلاً ، حَتَّی إِذَا کَانَ یَوْمُ التَّرْوِیَۃِ ، أَہَلَّ بِالْحَجِّ حِینَ انْبَعَثَ بِہِ بَعِیرُہُ مُنْطَلِقًا إِلَی مِنًی ۔ قَالَ عطَائٌ : وَہُوَ أَحَبُّ إلَیْنَا۔",": Da'if","Musannaf Ibn Abi Shaybah 15244","","","كتاب الحج"
"15245","(۱۵۲۴۵) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَان ، عَنْ أَسْلَمَ ، عْن عَطَائٍ (ح) وَعَنِ عَطَائِ بْنِ السَّائِب ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : یُہِلُّ یَوْمَ التَّرْوِیَۃِ۔","","Musannaf Ibn Abi Shaybah 15245","","","كتاب الحج"
"15246","(۱۵۲۴۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّ إِہْلاَلَ ابْنِ عُمَرَ کَانَ آخِرَہُمَا یَوْمَ التَّرْوِیَۃِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15246","","","كتاب الحج"
"15247","(۱۵۲۴۷) حدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ رُبَّمَا طَافَ ، ثُمَّ صَلَّی الرَّکْعَتَیْنِ فِی جَوْفِ الْبَیْتِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15247","","","كتاب الحج"
"15248","(۱۵۲۴۸) حدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مُوسَی بْنِ عُقْبَۃَ ، عَنْ سَالِمٍ ، قَالَ : رَأَیْتُہُ یَطُوفُ ، ثُمَّ یَدْخُلُ الْبَیْتَ ، فَیُصَلِّی الرَّکْعَتَیْنِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15248","","","كتاب الحج"
"15249","(۱۵۲۴۹) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ ، عَنْ أَبِیہِ ، قَالَ : سُئِلَ أَبِی عَنِ الصَّلاَۃِ فِی الْکَعْبَۃِ ؟ فَقَالَ: صَلَّیْتُ مَعَ أَبِی ، حُسَیْنُ بْنِ عَلِیٍّ فِی الْکَعْبَۃِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15249","","","كتاب الحج"
"15250","(۱۵۲۵۰) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دَخَلَ الْکَعْبَۃَ ، وَأُسَامَۃُ بْنُ زَیْدٍ ، وَبِلالٌ ، وَعُثْمَانَ بْنُ طَلْحَۃَ ، فَمَکَثَ فِی الْبَیْتِ فَأَطَالَ ، ثُمَّ دَخَلَ ابْنُ عُمَرَ فِی إِثرِہِ أَوَّلَ النَّاسِ ، فَسَأَلْتُ بِلاَلاً : أَیْنَ صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : بَیْنَ الْعَمُودَیْنِ الْمُقَدَّمَیْنِ ، قَالَ : وَنَسِیتُ أَنْ أَسْأَلَہُ کَمْ صَلَّی ؟۔ (مسلم ۳۹۱۔ ابوداؤد ۲۰۱۸)",": Sahih","Musannaf Ibn Abi Shaybah 15250","","","كتاب الحج"
"15251","(۱۵۲۵۱) حدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عُثْمَانَ بْنِ طَلْحَۃَ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی الرَّکْعَتَیْنِ وجَاہَک حِینَ تَدْخُلَ۔(احمد ۳/۴۱۰۔ طیالسی ۱۳۶۵)","","Musannaf Ibn Abi Shaybah 15251","","","كتاب الحج"
"15252","(۱۵۲۵۲) حدَّثَنَا ابْنُ مُسْہِرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُصَلِّی یَوْمَ الصَّدَرِ الظُّہْرَ وَالْعَصْرَ ، وَالْمَغْرِبَ وَالْعِشَائَ بِالْحَصْبۃ ، حَتَّی یَأْتِیَ مِنْ آخِرِ اللَّیْلِ الْبَیْتَ۔","","Musannaf Ibn Abi Shaybah 15252","","","كتاب الحج"
"15253","(۱۵۲۵۳) حدَّثَنَا جَرِیرٌ ، عَنْ مُجَاہِدِ بْنِ رَاشِدٍ ، عَنْ سَعِیدِ بْنُ جُبَیْرٍ (ح) وَعَنْ عَطَائٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُمَا صَلَّیَا الظُّہْرَ یَوْمَ النَّفْرِ ، وَرَائَ الْعَقَبَۃِ۔","","Musannaf Ibn Abi Shaybah 15253","","","كتاب الحج"
"15254","(۱۵۲۵۴) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ؛ أَنَّ أَبَاہُ کَانَ یُصَلِّی الظُّہْرَ یَوْمَ النَّفْرِ بِمَکَّۃَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15254","","","كتاب الحج"
"15255","(۱۵۲۵۵) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ، عَنِ ابْنِ أَبِی لَیْلَی، عَنْ عَوْنِ بْنِ أَبِی جُحَیْفَۃَ، عَنْ أَبِیہِ، قَالَ: رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ النَّفْرِ بِالأَبْطَحِ ، فَأَذَّنَ بِلاَلٌ الظُّہْرَ ، ثُمَّ صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔",": Da'if","Musannaf Ibn Abi Shaybah 15255","","","كتاب الحج"
"15256","(۱۵۲۵۶) حدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ: مِنَ السُّنَّۃِ أَنْ یُصَلِّیَ الإِمَامُ یَوْمَ النَّفْرِ الظُّہْرَ بِالأَبْطَحِ۔","","Musannaf Ibn Abi Shaybah 15256","","","كتاب الحج"
"15257","(۱۵۲۵۷) حدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی إِلَی سُقْعِ الْبَیْتِ ، لَیْسَ بَیْنَہُ وَبَیْنَ الطَّوَافِ شَیْئٌ ، ثُمَّ أَبُو بَکْرٍ مِنْ بَعْدِہِ ، ثُمَّ عُمَرُ ، ثُمَّ إِنَّ عُمَرَ رَدَّہُ بَعْدُ إِلَی الْمِیقَاتِ۔","","Musannaf Ibn Abi Shaybah 15257","","","كتاب الحج"
"15258","(۱۵۲۵۸) حدَّثَنَا حَاتِمٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ، یَرْفَعُہُ ، قَالَ: إِنَّہُ أَتَی الْبَیْتَ فَاسْتَلَمَ الرُّکْنَ ، فَرَمَلَ ثَلاَثًا، وَمَشَی أَرْبَعًا ، ثُمَّ تَقَدَّمَ إِلَی مَقَامِ إِبْرَاہِیمَ فَقَرَأَ : {وَاِتَّخِذُوا مِنْ مَقَامِ إِبْرَاہِیمَ مُصَلًّی} ، فَجَعَلَ الْمَقَامَ بَیْنَہُ وَبَیْنَ الْبَیْتِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15258","","","كتاب الحج"
"15259","(۱۵۲۵۹) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : قرَأَ عَلْقَمَۃُ الْقُرْآنَ فِی لَیْلَۃٍ ، ثُمَّ طَافَ بِالْبَیْتِ أُسْبُوعًا ، ثُمَّ أَتَی الْمَقَامَ فَصَلَّی عِنْدَہُ۔","","Musannaf Ibn Abi Shaybah 15259","","","كتاب الحج"
"15260","(۱۵۲۶۰) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لَمْ یُرَخَّصْ فِی تَرْکِ الصَّلاَۃِ عِنْدَ الْمَقَامِ ، فَإِنْ لَمْ تَقْدِرْ عَلَیْہِ زَاحَمْتَ عَلَیْہِ حَتَّی تَقْدِرَ عَلَیْہِ ، أَوْ بِحِذَائہ ، وَلاَ بَأْسَ أَنْ یَکُونَ بَیْنَکَ وَبَیْنَہُ رِجَالٌ یُصَلُّونَ بَعْدَ أَنْ تَکُونَ بِحِیَالِہِ۔","","Musannaf Ibn Abi Shaybah 15260","","","كتاب الحج"
"15261","(۱۵۲۶۱) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یُعْجِبُہُ أَنْ یُصَلِّیَ رَکْعَتَیِ الطَّوَافِ خَلْفَ الْمَقَامِ ، وَلاَ یَرَی بَأْسًا إِنْ لَمْ یَفْعَلْ۔","","Musannaf Ibn Abi Shaybah 15261","","","كتاب الحج"
"15262","(۱۵۲۶۲) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَنْ عَامِرٍ ؛ أَنَّہُ سَمِعَ وَہْبَ بْنَ الأَجْدَعِ ، أَنَّہُ سَمِعَ عُمَرَ قَالَ : إِذَا قَدِمَ الرَّجُلُ حَاجًّا فَلْیَطُفْ بِالْبَیْتِ سَبْعًا ، ثُمَّ یُصَلِّ عِنْدَ الْمَقَامِ رَکْعَتَیْنِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15262","","","كتاب الحج"
"15263","(۱۵۲۶۳) حدَّثَنَا عَبْدَۃُ ، عَنْ صَالِحِ بْنِ حَیَّانَ ، قَالَ : طُفْتُ مَعَ أَنَسِ بْنِ مَالِکٍ الطَّوَافَ الأَوَّلَ ، فَلَمَّا فَرَغَ رَکَعَ رَکْعَتَیْنِ عِنْدَ الْمَقَامِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15263","","","كتاب الحج"
"15264","(۱۵۲۶۴) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ إِذَا فَرَغَ مِنْ طَوَافِہِ ، أَتَی الْمَقَامَ فَصَلَّی عِنْدَہُ رَکْعَتَیْنِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15264","","","كتاب الحج"
"15265","(۱۵۲۶۵) حدَّثَنَا حُمَیْدٌ ، عَنْ حُسَیْنِ بْنِ عُقَیْلٍ ، عَنِ الضَّحَّاکِ ، قَالَ : یُصَلِّی عِنْدَ الْمَقَامِ رَکْعَتَیْنِ ، أَوْ مَا شَائَ اللَّہُ۔",": Hasan","Musannaf Ibn Abi Shaybah 15265","","","كتاب الحج"
"15266","(۱۵۲۶۶) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ طَافَ ، ثُمَّ أَتَی الْمَقَامَ، فَصَلَّی عِنْدَہُ رَکْعَتَیْنِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15266","","","كتاب الحج"
"15267","(۱۵۲۶۷) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : صَلِّ رَکْعَتَیِ الطَّوَافِ فِی بَیْتک إِنْ شِئْتَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15267","","","كتاب الحج"
"15268","(۱۵۲۶۸) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی عَمَّارٍ ، قَالَ : رَأَیْتُ ابْنَ الزُّبَیْرِ طَافَ بِالْبَیْتِ ، ثُمَّ جَائَ یُصَلِّی وَالطَّوَافُ بَیْنَہُ وَبَیْنَ الْقِبْلَۃِ۔","","Musannaf Ibn Abi Shaybah 15268","","","كتاب الحج"
"15269","(۱۵۲۶۹) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ کَثِیرِ بْنِ کَثِیرٍ ، عَمَّنْ حَدَّثَہُ ، عَنْ جَدِّہِ ؛ أَنَّہُ رَأَی رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی مِمَّا یَلِی بَابَ بَنِی سَہْمٍ ، لَیْسَ بَیْنَہُ وَبَیْنَ الطَّوَافِ سُتْرَۃٌ ، وَالنَّاسُ یَمُرُّونَ بَیْنَ یَدَیْہِ۔\n(احمد ۶/۳۹۹۔ ابویعلی ۷۱۳۷)",": Da'if","Musannaf Ibn Abi Shaybah 15269","","","كتاب الحج"
"15270","(۱۵۲۷۰) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ کَثِیرِ بْنِ کَثِیرٍ ، عَنْ أَبِیہِ ، عَنِ الْمُطَّلِبِ بْنِ أَبِی وَدَاعَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ بِمثل حَدِیثِ ابْنِ عُیَیْنَۃَ۔ (احمد ۳۹۹۔ طبرانی ۶۸۷)","","Musannaf Ibn Abi Shaybah 15270","","","كتاب الحج"
"15271","(۱۵۲۷۱) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ بُکَیْرِ بْنِ عُتَیْقٍ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ جُبَیْرٍ یَقُولُ : الطَّوَافُ لِلْغُرَبَائِ أَحَبُّ إلَیَّ مِنَ الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 15271","","","كتاب الحج"
"15272","(۱۵۲۷۲) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی بَکْرِ بْنِ أَبِی مُوسَی ، قَالَ : سُئِلَ ابْنُ عَبَّاسٍ عَنِ الطَّوَافِ أَفْضَلُ، أَمِ الصَّلاَۃُ ؟ فَقَالَ : أَمَّا أَہْلُ مَکَّۃَ فَالصَّلاَۃُ ، وَأَمَّا أَہْلُ الأَمْصَارِ فَالطَّوَافُ۔","","Musannaf Ibn Abi Shaybah 15272","","","كتاب الحج"
"15273","(۱۵۲۷۳) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، قَالَ : سَأَلْتُ عَطَائً ؟ فَقَالَ : أَمَّا أَنْتُمْ فَالطَّوَافُ ، وَأَمَّا أَہْلُ مَکَّۃَ فَالصَّلاَۃُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15273","","","كتاب الحج"
"15274","(۱۵۲۷۴) حدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، قَالَ : سَمِعْتُ مُجَاہِدًا یَقُولُ : الصَّلاَۃُ لأَہْلِ مَکَّۃَ أَفْضَلُ۔","","Musannaf Ibn Abi Shaybah 15274","","","كتاب الحج"
"15275","(۱۵۲۷۵) حدَّثَنَا جَرِیرٌ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، قَالَ : سَمِعْتُ مُجَاہِدًا یَقُولُ : الصَّلاَۃُ لأَہْلِ مَکَّۃَ أَفْضَلُ ، وَالطَّوَافُ لأَہْلِ الآفَاقِ أَفْضَلُ۔","","Musannaf Ibn Abi Shaybah 15275","","","كتاب الحج"
"15276","(۱۵۲۷۶) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، قَالَ : قُلْتُ لَہُ : ہَلْ کَانَ أَبُوکَ یَرْفَعُ صَوْتَہُ بِالتَّلْبِیَۃِ ؟ قَالَ : بَیْنَ ذَلِکَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15276","","","كتاب الحج"
"15277","(۱۵۲۷۷) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ مَکْحُولٍ ، قَالَ : التَّلْبِیَۃُ شِعَارُ الْحَجِّ ، فَأَکْثِرُوا مِنَ التَّلْبِیَۃِ عِنْدَ کُلِّ شَرَفٍ ، وَفِی کُلِّ حِینٍ ، وَأَکْثِرُوا مِنَ التَّلْبِیَۃِ وَأَظْہِرُوہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15277","","","كتاب الحج"
"15278","(۱۵۲۷۸) حدَّثَنَا أَبُو نُعَیْمٍ ، عَنْ حَسَنِ بْنِ فُرَاتٍ ، قَالَ : قَالَ لَنَا ابْنُ أَبِی مُلَیْکَۃَ : أَمُحْرِمُونَ أَنْتُمْ ؟ قُلْنَا : نَعَمْ ، قَالَ : فَلَبُّوا۔","","Musannaf Ibn Abi Shaybah 15278","","","كتاب الحج"
"15279","(۱۵۲۷۹) حدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی الَّذِی یُلَبِّی ، قَالَ : یُسْمِعُ مَنْ یَلِیہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15279","","","كتاب الحج"
"15280","(۱۵۲۸۰) حدَّثَنَا الثَّقَفِیُّ، عَنْ أَیُّوبَ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ، قَالَ: سُئِلَ ابْنُ عَبَّاسٍ: مَا بَرُّ الْحَجِّ؟ قَالَ: الْعَجُّ ، وَالثَّجَّ۔",": Sahih","Musannaf Ibn Abi Shaybah 15280","","","كتاب الحج"
"15281","(۱۵۲۸۱) حدَّثَنَا سَہْلُ بْنُ یُوسُفَ، عَنْ حُمَیْدٍ، عَنْ بَکْرٍ، قَالَ: کُنْتُ مَعَ ابْنِ عُمَرَ فَلَبَّی حَتَّی أَسْمَعَ مَا بَیْنَ الْجَبَلَیْنِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15281","","","كتاب الحج"
"15282","(۱۵۲۸۲) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ یَعْقُوبَ بْنِ زَیْدٍ ، قَالَ : کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ یَبْلُغُونَ الرَّوْحَائَ ، حَتَّی تُبَحَّ أَصْوَاتُہُمْ مِنْ شِدَّۃِ تَلْبِیَتِہِمْ۔",": Da'if","Musannaf Ibn Abi Shaybah 15282","","","كتاب الحج"
"15283","(۱۵۲۸۳) حدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ حِزَامِ بْنِ ہِشَامٍ ، عَنْ أَبِیہِ ؛ أَنَّ عُمَرَ کَانَ یُلَبِّی عَلَی الصَّفَا وَالْمَرْوَۃِ ، وَیَشْتَدَّ صَوْتَہُ ، وَیُعْرَفُ صَوْتُہُ بِاللَّیْلِ ، وَلاَ یُرَی وَجْہُہُ۔",": Hasan","Musannaf Ibn Abi Shaybah 15283","","","كتاب الحج"
"15284","(۱۵۲۸۴) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی بَکْرٍ ، عَنْ خَلاَّدِ بْنِ السَّائِبِ ، عَنْ أَبِیہِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : جَائَنِی جِبْرِیلُ فَأَمَرَنِی أَنْ آمُرَ أَصْحَابِی یَرْفَعُونَ أَصْوَاتَہُمْ بِالإِہْلاَلِ۔ (ترمذی ۸۲۹۔ احمد ۴/۵۵)",": Sahih","Musannaf Ibn Abi Shaybah 15284","","","كتاب الحج"
"15285","(۱۵۲۸۵) حدَّثَنَا أَبُو نُعَیْمٍ ، عَنْ إِسْرَائِیلَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : ارْفَعُوا أَصْوَاتَکُمْ بِالتَّلْبِیَۃِ ۔ وَعَنِ ابْنِ الزُّبَیْرِ ، مِثْلُ ذَلِکَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15285","","","كتاب الحج"
"15286","(۱۵۲۸۶) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی لَبِیدٍ ، عَنِ الْمُطَّلِبِ بْنِ عَبْدِ اللہِ بْنِ حَنْطَبٍ ، عَنْ خَلاَّدِ بْنِ السَّائِبِ ، عَنْ زَیْدِ بْنِ خَالِدٍ الْجُہَنِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : جَائَنِی جِبْرِیلُ عَلَیْہِ السَّلاَمُ ، فَقَالَ : مُرْ أَصْحَابَکَ یَرْفَعُوا أَصْوَاتَہُمْ بِالتَّلْبِیَۃِ ، فَإِنَّہَا شِعَارُ الْحَجِّ۔\n(احمد ۵/۱۹۲۔ ابن حبان ۳۸۰۳)",": Sahih","Musannaf Ibn Abi Shaybah 15286","","","كتاب الحج"
"15287","(۱۵۲۸۷) حدَّثَنَا وَکِیعٌ ، عَنْ إِبْرَاہِیمَ بْنِ یَزِیدَ ، عَنْ مُحَمَّدِ بْنِ عَبَّادِ بْنِ جَعْفَرٍ الْمَخْزُومِیِّ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَفْضَلُ الْحَجِّ : الْعَجُّ وَالثَّجُّ۔\n الْعَجُّ : الْعَجِیجُ بِالتَّلْبِیَۃِ ، وَالثَّجُّ : نَحْرُ الْبُدْنِ۔ (ترمذی ۲۹۹۸)",": Da'if","Musannaf Ibn Abi Shaybah 15287","","","كتاب الحج"
"15288","(۱۵۲۸۸) حدَّثَنَا وَکِیعٌ ، عَنْ کَثِیرِ بْنِ زَیدٍ ، عَنِ الْمُطَّلِبِ بْنِ عَبْدِ اللہِ ، قَالَ : کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَرْفَعُونَ أَصْوَاتَہُمْ بِالتَّلْبِیَۃِ ، حَتَّی تُبَحَّ أَصْوَاتُہُمْ ، وَکَانُوا یَضْحَونَ لِلشَّمْسِ إِذَا أَحْرَمُوا۔",": Hasan","Musannaf Ibn Abi Shaybah 15288","","","كتاب الحج"
"15289","(۱۵۲۸۹) حدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، قَالَ: رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ یُوقِظُ أَنَاسًا مِنْ أَہْلِ الْیَمَنِ فِی الْمَسْجِدِ وَیَقُولُ: قُومُوا لَبُّوا ، فَإِنَّ زِینَۃَ الْحَجِّ التَّلْبِیَۃُ۔","","Musannaf Ibn Abi Shaybah 15289","","","كتاب الحج"
"15290","(۱۵۲۹۰) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ : زِینَۃُ الْحَجِّ التَّلْبِیَۃُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15290","","","كتاب الحج"
"15291","(۱۵۲۹۱) حدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَنْ مَنْصُورِ بْنِ أَبِی الأَسْوَدِ ، عَنِ الأَعْمَشِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، قَالَ : کَانَ ابْنُ الزُّبَیْرِ یَقُولُ : التَّلْبِیَۃُ زِینَۃُ الْحَجِّ۔","","Musannaf Ibn Abi Shaybah 15291","","","كتاب الحج"
"15292","(۱۵۲۹۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : شِعَارُ الْحَجِّ التَّلْبِیَۃُ۔","","Musannaf Ibn Abi Shaybah 15292","","","كتاب الحج"
"15293","(۱۵۲۹۳) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ ، قَالاَ : لَیْسَ عَلَی أَہْلِ مَکَّۃَ رَمَلٌ ، وَلاَ عَلَی مَنْ أَہَلَّ مِنْہَا ، إِلاَّ أَنْ یَجِیئَ أَحَدٌ مِنْ أَہْلِ مَکَّۃَ مِنْ خَارِجٍ۔","","Musannaf Ibn Abi Shaybah 15293","","","كتاب الحج"
"15294","(۱۵۲۹۴) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ لاَ یَرْمُلُ إِذَا أَہَلَّ مِنْ مَکَّۃَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15294","","","كتاب الحج"
"15295","(۱۵۲۹۵) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، قَالَ : أَہْلَلْنَا أَنَا وَبَکْرٌ مِنْ مَکَّۃَ ، فَطُفْنَا بِالْبَیْتِ وَرَمَلْنَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15295","","","كتاب الحج"
"15296","(۱۵۲۹۶) حدَّثَنَا الثَّقَفِیُّ ، عَنْ حَبِیبٍ ، قَالَ : سُئِلَ عَطَائٌ عَنِ الْمُجَاوِرِ إِذَا أہَلَّ مِنْ مَکَّۃَ ، ہَلْ یَسْعَی الأَشْوَاطَ الثَّلاَثَۃَ ؟ قَالَ : إِنَّہُمْ یَسْعَوْنَ ، فَأَمَّا ابْنُ عَبَّاسٍ ، فَإِنَّہُ قَالَ : إِنَّمَا ذَلِکَ عَلَی أَہْلِ الآفَاقِ۔","","Musannaf Ibn Abi Shaybah 15296","","","كتاب الحج"
"15297","(۱۵۲۹۷) حدَّثَنَا زَیْدُ بْنُ حُبَابٍ، عَنْ حَرْبِ بْنِ سُرَیْجٍ، أَوْ شُرَیْحٍ، عَنْ أَبِی جَعْفَرٍ، قَالَ: لَیْسَ عَلَی أَہْلِ مَکَّۃَ رَمَلٌ۔","","Musannaf Ibn Abi Shaybah 15297","","","كتاب الحج"
"15298","(۱۵۲۹۸) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : لاَ رَمَلَ یَوْمَ النَّحْرِ۔","","Musannaf Ibn Abi Shaybah 15298","","","كتاب الحج"
"15299","(۱۵۲۹۹) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ خُثَیْمٍ ، عَنْ مُجَاہِدٍ ، قَالَ : رَأَیْتُہُ یَرْمُلُ یَوْمَ النَّحْرِ۔","","Musannaf Ibn Abi Shaybah 15299","","","كتاب الحج"
"15300","(۱۵۳۰۰) حدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لَیْسَ فِی طَوَافِ النَّحْرِ رَمَلٌ۔","","Musannaf Ibn Abi Shaybah 15300","","","كتاب الحج"
"15301","(۱۵۳۰۱) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ إِسْمَاعِیلَ ، عَنْ وَبَرَۃَ بن عَبْدِ الرَّحْمَنِ ، قَالَ : ذُکِرَ لابْنِ عُمَرَ التَّلْبِیَۃُ یَوْمَ عَرَفَۃَ ، فَقَالَ : التَّکْبِیرُ أَحَبُّ إلَیَّ۔",": Sahih","Musannaf Ibn Abi Shaybah 15301","","","كتاب الحج"
"15302","(۱۵۳۰۲) حدَّثَنَا أَبُو نُعَیْمٍ، عَنْ مَعْمَرٍ، عَنْ أَبِی جَعْفَرٍ، أَنَّہُ قَالَ: اِقْطَعِ التَّلْبِیَۃَ إِذَا انْطَلَقْتَ إِلَی عَرَفَۃَ، وَکَبِّرْ وَہَلِّلْ۔","","Musannaf Ibn Abi Shaybah 15302","","","كتاب الحج"
"15303","(۱۵۳۰۳) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : کُنْتُ مَعَ ابْنِ مَسْعُودٍ بِعَرَفَۃَ فَلَبَّی ، فَقَالَ رَجُلٌ : مَنْ ہَذَا الْمُلَبِّی ، فِی ہَذَا الْیَوْمِ ؟ فَالْتَفَتَ إِلَیْہِ ابْنُ مَسْعُودٍ ، فَقَالَ : لَبَّیْکَ عَدَدَ التُّرَابِ لَبَّیْکَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15303","","","كتاب الحج"
"15304","(۱۵۳۰۴) حدَّثَنَا ابْنُ فُضَیْلٍ ، وَحَفْصٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ اللہ بْنِ أَبِی سَلَمَۃَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : غَدَوْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ مِنًی إِلَی عَرَفَاتٍ ، فَمِنَّا الْمُکَبِّرُ وَمِنَّا الْمُلَبِّی۔\n(ابوداؤد ۱۸۱۲۔ احمد ۲/۲۲)",": Sahih","Musannaf Ibn Abi Shaybah 15304","","","كتاب الحج"
"15305","(۱۵۳۰۵) حدَّثَنَا وَکِیعٌ ، عَنْ زِیَادِ بْنِ أَبِی مُسْلِمٍ ، قَالَ : سَمِعْتُ أَبَا الْعَالِیَۃِ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ بِعَرَفَۃَ یَقُولُ: لَبَّیْکَ اللَّہُمَّ لَبَّیْکَ۔",": Hasan","Musannaf Ibn Abi Shaybah 15305","","","كتاب الحج"
"15306","(۱۵۳۰۶) حدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ حَبِیبٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عنِ ابْنِ عَبَّاسٍ ، قَالَ : ذُکِرَ لَہُ أَنَّ مُعَاوِیَۃَ نَہَی عَنِ التَّلْبِیَۃِ ، فَجَائَ حَتَّی أَخَذَ بِعَمُودَیِ الْفُسْطَاطِ ، ثُمَّ لَبَّی ، ثُمَّ قَالَ : عَلِمَ أَنَّ عَلِیًّا کَانَ یُلَبِّی فِی ہَذَا الْیَوْمِ ، فَأَحَبَّ أَنْ یُخَالِفَہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 15306","","","كتاب الحج"
"15307","(۱۵۳۰۷) حدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ ، عَنْ إِبْرَاہِیمَ ، لَبَّی ابْنُ مَسْعُودٍ بِعَرَفَۃَ ، فَقِیلَ : مَنْ ہَذَا الْمُلَبِّی ؟ فَقِیلَ : ابْنُ مَسْعُودٍ ، فَسَکَتُوا۔","","Musannaf Ibn Abi Shaybah 15307","","","كتاب الحج"
"15308","(۱۵۳۰۸) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنْ عِکْرِمَۃَ بْنِ خَالِدٍ ، قَالَ : لَبَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ وَاقِفٌ بِعَرَفَاتٍ۔","","Musannaf Ibn Abi Shaybah 15308","","","كتاب الحج"
"15309","(۱۵۳۰۹) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی یَعْفُورٍ ، قَالَ : کُنْتُ أَسِیرُ مَعَ ابْنِ عُمَرَ ، وَابْنِ الْحَنَفِیَّۃِ مِنْ مِنًی إِلَی عَرَفَاتٍ ، فَکَانَ ابْنُ عُمَرَ یُکَبِّرُ ، وَکَانَ ابْنُ الْحَنَفِیَّۃِ یُلَبِّی۔",": Sahih","Musannaf Ibn Abi Shaybah 15309","","","كتاب الحج"
"15310","(۱۵۳۱۰) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ أَبی بَکْرٍ الثَّقَفِیِّ ، قَالَ : سَأَلْتُ أَنَسًا : کَیْفَ کُنْتُمْ تَصْنَعُونَ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : کَانَ یُلَبِّی الْمُلَبِّی فَلاَ یُنْکَرُ عَلَیْہِ ، وَیُکَبِّرُ الْمُکَبِّرُ فَلاَ یُنْکَرُ عَلَیْہِ۔ (بخاری ۹۷۰۔ مسلم ۹۳۳)",": Sahih","Musannaf Ibn Abi Shaybah 15310","","","كتاب الحج"
"15311","(۱۵۳۱۱) حدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ إِسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، وَعَطَائٍ ؛ أَنَّہُمَا کَانَ یُصَلِّیَانِ فِی الْمَسْجِدِ الْحَرَامِ ، وَیُلَبِّیَانِ بِالْحَجِّ إِذَا خَرَجَا مِنَ الْمَسْجِدِ ، وَیُؤَخِّرَانِ الطَّوَافَ۔","","Musannaf Ibn Abi Shaybah 15311","","","كتاب الحج"
"15312","(۱۵۳۱۲) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ عَبْدِ اللہِ بْنِ الْمُؤَمَّلِ ، قَالَ : رَأَیْتُ ابْنَ أَبِی مُلَیْکَۃَ طَافَ بِالْبَیْتِ وَبَیْنَ الصَّفَا وَالْمَرْوَۃِ ، قَبْلَ أَنْ یَخْرُجَ إِلَی مِنًی۔","","Musannaf Ibn Abi Shaybah 15312","","","كتاب الحج"
"15313","(۱۵۳۱۳) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ أَبِی سُفْیَانَ ، قَالَ : سَأَلْتُ سَالِمًا عَنِ الرَّجُلِ یُحْرِمُ بِالْحَجِّ یَطُوفُ قَبْلَ أَنْ یَخْرُجَ، أَوْ بَعْدَ مَا یَرْجِعُ ؟ قَالَ : ہُوَ مِثْلُ الدَّیْنِ ، مَا عَجَّلْتَ فَہُوَ خَیْرٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15313","","","كتاب الحج"
"15314","(۱۵۳۱۴) حدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ، قَالَ: سَأَلْتُ الْقَاسِمَ بْنَ مُحَمَّدٍ عَنْہُ؟ فَقَالَ: کُلَّ ذَلِکَ حَسَنٌ۔","","Musannaf Ibn Abi Shaybah 15314","","","كتاب الحج"
"15315","(۱۵۳۱۵) حدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ حَبِیبٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یَقُولُ : الطَّوَافُ بَیْنَ الصَّفَا وَالْمَرْوَۃِ لأَہْلِ مَکَّۃَ ، بَعْدَ أَنْ یَرْجِعُوا مِنْ مِنًی۔",": Hasan","Musannaf Ibn Abi Shaybah 15315","","","كتاب الحج"
"15316","(۱۵۳۱۶) حدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیِّ بْنِ حُسَیْنٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ الْفَضْلِ بْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمْ یَزَلْ یُلَبِّی حَتَّی رَمَی جَمْرَۃَ الْعَقَبَۃِ ، فَرَمَاہَا بِسَبْعِ حَصَیَاتٍ ، یُکَبِّرُ مَعَ کُلِّ حَصَاۃٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 15316","","","كتاب الحج"
"15317","(۱۵۳۱۷) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : رَمَی عَبْدُ اللہِ جَمْرَۃَ الْعَقَبَۃِ مِنْ بَطْنِ الْوَادِی ، یُکَبِّرُ مَعَ کُلِّ حَصَاۃٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 15317","","","كتاب الحج"
"15318","(۱۵۳۱۸) حدَّثَنَا مَحْبُوبٌ ، عَنْ أَبِی سَعِیدٍ الْخُلْقَانِیِّ ، قَالَ : رَأَیْتُ سَالِمَ بْنَ عَبْدِ اللَّہُ یَرْمِی جَمْرَۃَ الْعَقَبَۃِ مِنْ بَطْنِ الْوَادِی ، یُکَبِّرُ مَعَ کُلِّ حَصَاۃٍ تَکْبِیرَۃً۔","","Musannaf Ibn Abi Shaybah 15318","","","كتاب الحج"
"15319","(۱۵۳۱۹) حدَّثَنَا أَبُو عَاصِمٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی رَجُلٍ وَقَعَتْ مِنْہُ حَصَاتَانِ عِنْدَ الْجَمْرَۃِ ، قَالَ : یُکَبِّرُ مَعَ کُلِّ وَاحِدَۃٍ مِنْہُمَا تَکْبِیرَۃً۔","","Musannaf Ibn Abi Shaybah 15319","","","كتاب الحج"
"15320","(۱۵۳۲۰) حدَّثَنَا أَبُو عَاصِمٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُکَبِّرُ مَعَ کُلِّ حَصَاۃٍ تَکْبِیرَۃً۔","","Musannaf Ibn Abi Shaybah 15320","","","كتاب الحج"
"15321","(۱۵۳۲۱) حدَّثَنَا ابْنُ مُسْہِرٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ سُلَیْمَانَ بْنِ عَمْرِو بْنِ الأَحْوَص ، عَنْ أُمِّہِ ؛ أَنَّہَا رَأَتِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اسْتَبْطَنَ الْوَادِیَ ، فَرَمَی الْجَمْرَۃَ بِسَبْعِ حَصَیَاتٍ ، یُکَبِّرُ مَعَ کُلِّ حَصَاۃٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 15321","","","كتاب الحج"
"15322","(۱۵۳۲۲) حدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنِ الْقَاسِمِ؛ أَنَّہُ رَمَی جَمْرَۃَ الْعَقَبَۃِ، وَکَبَّرَ مَعَ کُلِّ حَصَاۃٍ۔","","Musannaf Ibn Abi Shaybah 15322","","","كتاب الحج"
"15323","(۱۵۳۲۳) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، أَنَّ جِبْرِیلَ عَلَیْہِ السَّلاَمُ أَعْطَی إبْرَاہِیمَ سَبْعَ حَصَیَاتٍ ، ثُمَّ انْطَلَقَا إلَی الْعَقَبَۃِ ، فَعَرَضَ لَہُمَا الشَّیْطَانُ ، فَقَالَ لَہُ : ارْمِ وَکَبِّرْ ، قَالَ : فَرَمَیَا وَکَبَّرَا مَعَ کُلِّ رَمْیَۃٍ ، حَتَّی أَفَلَ الشَّیْطَانُ ، ثُمَّ صَنَعَ مِثْلَ ذَلِکَ فِی الْجَمْرَتَیْنِ الأُخْریَیْنِ۔","","Musannaf Ibn Abi Shaybah 15323","","","كتاب الحج"
"15324","(۱۵۳۲۴) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَمْ یَکُنْ یُرَخِّصُ فِی تَرْکِ افْتِتَاحِ الْحَجَرِ الأَسْوَدِ ، وَیَخْتِمُ بِہِ فِی أَوَّلِ طَوَافٍ یَطُوفُہُ یَوْمَ النَّحْرِ وَیَوْمَ النَّفْرِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15324","","","كتاب الحج"
"15325","(۱۵۳۲۵) حدَّثَنَا أَبُو أُسَامَۃَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ؛ أَنَّہُ کَانَ یُعْجِبُہُ أَنْ یَسْتَلِمَ الْحَجَرَ حِینَ یَفْتَتِحُ، وَحِینَ یَخْتِمُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15325","","","كتاب الحج"
"15326","(۱۵۳۲۶) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ یَأْتِی الْحَجَرَ الأَسْوَدَ فَیَخْتِمُ بِہِ ، ثُمَّ یَأْتِی أَہْلَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15326","","","كتاب الحج"
"15327","(۱۵۳۲۷) حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، قَالَ : سَمِعْتُ ابْنَ سَابِطٍ یَقُولُ لِرَجُلٍ قَامَ یَطُوفُ ، وَأَرَادَ أَنْ یَسْتَلِمَ الرُّکْنَ الْیَمَانِی یَبْدَأُ بِہِ ، فَقَالَ ابْنُ سَابِطٍ : لاَ تَبْدَأَنَّ مِنْ أَوَّل مِنَ الأَسْوَدِ ، إذَا بَدَأْتَ فِی طَوَافِکَ۔","","Musannaf Ibn Abi Shaybah 15327","","","كتاب الحج"
"15328","(۱۵۳۲۸) حدَّثَنَا حُمَیْدٌ ، عَنْ حُسَیْنِ بْنِ عُقَیْلٍ ، عَنِ الضَّحَّاکِ ، أَنَّہُ قَالَ : تَسْتَلِمُ فِی کُلِّ مَرَّۃٍ إِنْ قَدَرْت عَلَیْہِ ، وَإِلاَّ افْتَتَحْت بِہِ وَخَتَمْت۔","","Musannaf Ibn Abi Shaybah 15328","","","كتاب الحج"
"15329","(۱۵۳۲۹) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : إنِ اسْتَطَعْتَ أَنْ تَسْتَلِمَ فِی کُلِّ طَوْفَۃٍ فَاسْتَلِمْہُ ، وَإِلاَّ فَإِذَا مَرَرْت بِہِ فَاسْتَقْبِلْہُ وَکَبِّر ، وَإِنْ شِئْتَ فَاسْتَفْتِحْ بِہِ وَاخْتِمْ۔","","Musannaf Ibn Abi Shaybah 15329","","","كتاب الحج"
"15330","(۱۵۳۳۰) حدَّثَنَا وَکِیعٌ ، عَنْ ہِلاَلِ بْنِ أَبِی مَیْمُونَۃَ ، قَالَ : رَأَیْتُ أَنَسًا یَطُوفُ فَإِذَا انْتَہَی إلَی الْحَجَرِ کَبَّرَ ، وَیَفْتَتِحُ بِہِ وَیَخْتِمُ بِہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15330","","","كتاب الحج"
"15331","(۱۵۳۳۱) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَدَأَ بِالْحَجَرِ الأَسْوَدِ ، وَرَمَلَ مِنَ الْحَجَرِ إلَی الْحَجَرِ۔","","Musannaf Ibn Abi Shaybah 15331","","","كتاب الحج"
"15332","(۱۵۳۳۲) حدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، عَنْ عَائِشَۃَ قَالَتْ : آذَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالرَّحِیلِ ، فَمَرَرْنَا بِالْبَیْتِ ، فَطَافَ بِہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ثُمَّ خَرَجَ قَبْلَ أَنْ یُصْبِحَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15332","","","كتاب الحج"
"15333","(۱۵۳۳۳) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا انْتَہَی الرَّجُلُ إِلَی الأَبْطَحِ فَلْیَضَعْ رَحْلَہُ ، ثُمَّ لْیَزُرِ الْبَیْتَ ، فَلْیَرْتَحِلْ عَنْہَا ، إِنْ شَائَ لَیْلاً ، وَإِنْ شَائَ نَہَارًا ، بَعْدَ أَنْ یَنْزِلَ فِیہِ وَیَضَعَ نَعْلَہُ۔","","Musannaf Ibn Abi Shaybah 15333","","","كتاب الحج"
"15334","(۱۵۳۳۴) حدَّثَنَا أَبُو مُطِیعٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یَفْرُغُ مِنْ کُلِّ شَیْئٍ لَہُ ، فَإِذَا لَمْ یَبْقَ لَہُ إِلاَّ الرُّکُوبُ رَکِبَ ، ثُمَّ طَافَ بِالْبَیْتِ ، ثُمَّ مَضَی۔","","Musannaf Ibn Abi Shaybah 15334","","","كتاب الحج"
"15335","(۱۵۳۳۵) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَبْنُوا حَوْلَ الْکَعْبَۃِ بِنَائً ، یُشْرِفُ عَلَیْہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15335","","","كتاب الحج"
"15336","(۱۵۳۳۶) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَبْنُوا بِنَائً عِنْدَ الصَّفَا وَالْمَرْوَۃِ وَیُطِیلُوہُ ، کَیْ یَبْدُوَ لَہُمُ الْبَیْتُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15336","","","كتاب الحج"
"15337","(۱۵۳۳۷) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ أَبِی أَوْفَی ، وَسَعِیدَ بْنَ جُبَیْرٍ یَقُولاَنِ : الْحَجُّ الأَکْبَرُ یَوْمُ النَّحْرِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15337","","","كتاب الحج"
"15338","(۱۵۳۳۸) حدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ الْوَلِیدِ الشَّنِّیِّ ، عَنْ شِہَابِ بْنِ عَبَّادٍ الْعَصَرِی ، عَنْ أَبِیہِ ، قَالَ : قَالَ عُمَرُ : الْحَجُّ الأَکْبَرُ یَوْمُ عَرَفَۃَ ، فَذَکَرْتُہُ لِسَعِیدِ بْنِ الْمُسَیَّبِ ، فَقَالَ : أُخْبِرک عَنِ ابْنِ عُمَرَ ، أَنَّ عُمَرَ قَالَ : الْحَجُّ الأَکْبَرُ یَوْمُ عَرَفَۃَ۔",": Da'if","Musannaf Ibn Abi Shaybah 15338","","","كتاب الحج"
"15339","(۱۵۳۳۹) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ مُحَمَّدًا عَنْ یَوْمِ الْحَجِّ الأَکْبَرِ ؟ فَقَالَ : کَانَ یَوْمًا وَافَقَ فِیہِ حَجَّ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَحَجَّ أَہْلِ الْمِلَلِ۔","","Musannaf Ibn Abi Shaybah 15339","","","كتاب الحج"
"15340","(۱۵۳۴۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : سَأَلْتُ عَبْدَ اللہِ بْنَ شَدَّادٍ عَنِ الْحَجِّ الأَکْبَرِ ؟ فَقَالَ : الْحَجُّ الأَکْبَرُ یَوْمُ النَّحْرِ۔","","Musannaf Ibn Abi Shaybah 15340","","","كتاب الحج"
"15341","(۱۵۳۴۱) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : یَوْمُ الْحَجُّ الأَکْبَرِ یَوْمُ النَّحْرِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15341","","","كتاب الحج"
"15342","(۱۵۳۴۲) حدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدٍ ، عَنِ الْحَکَمِ ، عَنْ یَحْیَی بْنِ الْجَزَّارِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ لَقِیَہُ رَجُلٌ یَوْمَ النَّحْرِ ، فَأَخَذَ بِلِجَامِہِ فَسَأَلَہُ عَنِ الْحَجِّ الأَکْبَرِ ؟ فَقَالَ : ہُوَ ہَذَا الْیَوْمُ۔",": Sahih","Musannaf Ibn Abi Shaybah 15342","","","كتاب الحج"
"15343","(۱۵۳۴۳) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ عَبْدِ اللہِ بْنِ سِنَانٍ ، قَالَ : حدَّثَنَا الْمُغِیرَۃُ بْنُ شُعْبَۃَ ، عَلَی بَعِیرٍ ، فَقَالَ : ہَذَا یَوْمُ النَّحْرِ ، وَہَذَا یَوْمُ الأَضْحَی ، وَہَذَا یَوْمُ الْحَجِّ الأَکْبَرِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15343","","","كتاب الحج"
"15344","(۱۵۳۴۴) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : الْحَجُّ الأَکْبَرُ یَوْمٌ یُہْرَاقُ فِیہِ الدَّمُ ، وَیَحِلَّ فِیہِ الْحَرَامُ۔","","Musannaf Ibn Abi Shaybah 15344","","","كتاب الحج"
"15345","(۱۵۳۴۵) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، وَسُفْیَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، وَعَیَّاشٍ الْعَامِرِیِّ ، أَنَّہُمَا سَمِعَا ابْنَ أَبِی أَوْفَی یَقُولُ : الْحَجُّ الأَکْبَرُ یَوْمُ النَّحْرِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15345","","","كتاب الحج"
"15346","(۱۵۳۴۶) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الْحَجُّ الأَکْبَرُ یَوْمُ النَّحْرِ۔","","Musannaf Ibn Abi Shaybah 15346","","","كتاب الحج"
"15347","(۱۵۳۴۷) حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی جُحَیْفَۃَ ، قَالَ : الْحَجُّ الأَکْبَرُ یَوْمُ النَّحْرِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15347","","","كتاب الحج"
"15348","(۱۵۳۴۸) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ یَزِیدَ بْنِ الأَصَمِّ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : سَأَلَہُ رَجُلٌ ، فَقَالَ : إنَّ أَبِی مَاتَ وَلَمْ یَحُجَّ قَطُّ ، أَفَأَحُجُّ عَنْہُ ؟ قَالَ : نَعَمْ ، فَإِنَّک إِنْ لَمْ تَزِدْہُ خَیْرًا ، لَمْ تَزِدْہُ شَرًّا۔",": Sahih","Musannaf Ibn Abi Shaybah 15348","","","كتاب الحج"
"15349","(۱۵۳۴۹) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ طَارِقٍ ، قَالَ : کُنْتُ جَالِسًا عِنْدَ سَعِیدِ بْنِ الْمُسَیَّبِ فَأَتَاہُ رَجُلٌ ، فَقَالَ : إِنَّ أَبِی کَانَ کَثِیرَ الْجِہَادِ وَلَمْ یَحُجَّ ، أَفَأَحُجُّ عَنْہُ ؟ فَقَالَ لَہُ سَعِیدٌ : قَدْ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَخَّصَ لِرَجُلٍ حَجَّ عَنْ أَبِیہِ ، وَہَلْ ہُوَ إِلاَّ دَیْنٌ ؟","","Musannaf Ibn Abi Shaybah 15349","","","كتاب الحج"
"15350","(۱۵۳۵۰) حدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ قُدَامَۃَ بْنِ عَبْدِ اللہِ الرُّؤَاسِیِّ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنْ أَخٍ لِی مَاتَ وَلَمْ یَحُجَّ قَطُّ ، أَفَأَحُجُّ عَنْہُ ؟ قَالَ : ہَلْ کَانَ تَرَکَ مِنْ وَلَدٍ ؟ قَالَ : قُلْتُ : لاَ ، إِلاَّ صَبِیًّا صَغِیرًا ، قَالَ : حُجَّ عَنْہُ ، فَإِنَّہُ لَوْ وَجَدَ رَسُولاً لَاَرْسَلَ إِلَیْک أَنْ عَجِّلْ بِہَا ، قُلْتُ : أَحُجُّ عَنْہُ مِنْ مَالِی ، أَوْ مِنْ مَالِہِ ؟ قَالَ : لاَ، بَلْ مِنْ مَالِہِ ۔ وَسَأَلْتُ إبْرَاہِیمَ عَنْہُ ؟ فَقَالَ : حُجَّ عَنْہُ ۔ قَالَ : وَسَأَلْتُ الضَّحَّاکَ ؟ فَقَالَ : حُجَّ عَنْہُ ، فَإِنَّ ذَلِکَ مُجْزِئٌ عَنْہُ ، وَحُجَّ مِنْ مَالِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15350","","","كتاب الحج"
"15351","(۱۵۳۵۱) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنْ رَجُلٍ یُقَالُ لَہُ : یُوسُفُ ، کَانَ یَکُونُ مَعَ ابْنِ الزُّبَیْرِ ، عَنْ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، قَالَ : جَائَ رَجُلٌ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، إِنَّ أَبِی مَاتَ وَلَمْ یَحُجَّ ، أَفَأَحُجُّ عَنْہُ ؟ قَالَ : أَنْتَ أَکْبَرُ وَلَدِہِ ؟ قَالَ : نَعَمْ ، قَالَ : فَحُجَّ عَنْ أَبِیکَ ، أَفَرَأَیْت لَوْ کَانَ عَلَی أَبِیکَ دَیْنٌ ، فَقَضَیْتَہُ ؟۔",": Da'if","Musannaf Ibn Abi Shaybah 15351","","","كتاب الحج"
"15352","(۱۵۳۵۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَسْلَمَ الْمُنْقِرِیِّ ، عَنْ عَطَائٍ ، قَالَ : یُحَجُّ عَنِ الْمَیِّتِ ، وَإِنْ لَمْ یُوصِ۔","","Musannaf Ibn Abi Shaybah 15352","","","كتاب الحج"
"15353","(۱۵۳۵۳) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ یَحُجُّ أَحَدٌ عَنْ أَحَدٍ، وَلاَ یَصمُ أَحَدٌ عَنْ أَحَدٍ۔",": Hasan","Musannaf Ibn Abi Shaybah 15353","","","كتاب الحج"
"15354","(۱۵۳۵۴) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یَحُجُّ أَحَدٌ عَنْ أَحَدٍ۔","","Musannaf Ibn Abi Shaybah 15354","","","كتاب الحج"
"15355","(۱۵۳۵۵) حدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، قَالَ : لاَ یَحُجُّ أَحَدٌ عَنْ أَحَدٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15355","","","كتاب الحج"
"15356","(۱۵۳۵۶) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یُقْضَی عَنِ الْمَیِّتِ حَجٌّ۔","","Musannaf Ibn Abi Shaybah 15356","","","كتاب الحج"
"15357","(۱۵۳۵۷) حدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لَوْ کُنْتُ أَنَا تَصَدَّقْت عَنْہُ ، وَأَہْدَیْت۔",": Da'if","Musannaf Ibn Abi Shaybah 15357","","","كتاب الحج"
"15358","(۱۵۳۵۸) حدَّثَنَا جرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن زِیَادِ بْنِ لَبِیدٍ ، قَالَ : قَالَ شُرَیْحٌ : إِذَا أَہْلَلْتَ بِعُمْرَۃٍ وَحَجَّۃٍ ، ثُمَّ قَدِمْتَ مَکَّۃَ ، فَلاَ یَحِلَّنَّ مِنْکَ حَرَامٌ إِلَی یَوْمِ النَّحْرِ ، فَإِنَّہُمْ سَیَقُولُونَ لَکَ : إِذَا طُفْتَ لِعُمْرَتِکَ وَحَجَّتِکَ فَأَحِلَّ ، فَلاَ تُطِعْہُمْ فِی ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 15358","","","كتاب الحج"
"15359","(۱۵۳۵۹) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ؛ أَنَّ الْحُسَیْنَ بْنَ عَلِیٍّ ، وَشُرَیْحًا قَرَنَا فَلَمْ یَحِلَّ وَاحِدٌ مِنْہُمَا إِحْرَامًا إِلَی یَوْمِ النَّحْرِ۔","","Musannaf Ibn Abi Shaybah 15359","","","كتاب الحج"
"15360","(۱۵۳۶۰) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مَنْصُورٍ ، عَنْ مَالِکِ بْنِ الْحَارِثِ ، عَنْ أَبِی نَصْرٍ ؛ أَنَّ عَلِیًّا ، قَالَ لَہُ : لَبِّ بِہِمَا جَمِیعًا ، فَإِذَا قَدِمْتَ مَکَّۃَ ، فَطُفْ لَہُمَا طَوَافَیْنِ ؛ طَوَافًا لِعُمْرَتِکَ ، وَطَوَافًا لِحَجَّتِکَ ، وَلاَ تُحِلَّنَّ مِنْکَ حَرَامًا دُونَ یَوْمِ النَّحْرِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15360","","","كتاب الحج"
"15361","(۱۵۳۶۱) حدَّثَنَا حَاتِمٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لِعَلِیٍّ : مَا قُلْتَ حِینَ فَرَضْتَ الْحَجَّ ؟ قَالَ : قُلْتُ : اللَّہُمَّ إِنِّی أُہِلُّ بِمَا أَہَلَّ بِہِ رَسُولُکَ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَإِنَّ مَعِی الْہَدْیَ ، فَلاَ یَحِلُّ مِنْکَ حَرَامٌ ، قَالَ : فَحَلَّ النَّاسُ کُلُّہُمْ وَقَصَّرُوا ، إِلاَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَمَنْ کَانَ مَعَہُ ہَدْیٌ۔",": Sahih","Musannaf Ibn Abi Shaybah 15361","","","كتاب الحج"
"15362","(۱۵۳۶۲) حدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ عُرْوَۃَ ؛ أَنَّ أَبَا بَکْرٍ وَعُمَرَ کَانَا یَقْدُمَانِ وَہُمَا مُہِلاَّنِ بِالْحَجِّ ، فَلاَ یَحِلُّ مِنْہُمَا حَرَامًا إِلَی یَوْمِ النَّحْرِ۔","","Musannaf Ibn Abi Shaybah 15362","","","كتاب الحج"
"15363","(۱۵۳۶۳) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَنْ أَحْرَمَ بِالْحَجِّ وَالْعُمْرَۃِ جَمِیعًا کَفَاہُ طَوَافٌ وَاحِدٌ ، وَلَمْ یَحِلَّ حَتَّی یَقْضِیَ حَجَّتَہُ ، وَیَحِلَّ مِنْہُمَا جَمِیعًا۔",": Sahih","Musannaf Ibn Abi Shaybah 15363","","","كتاب الحج"
"15364","(۱۵۳۶۴) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلٍ ، عَنْ أَبِی شُعْبَۃَ ، قَالَ : کُنْتُ بِجَنْبِ ابْنِ عُمَرَ بِعَرَفَۃَ ، وَإِنَّ رُکْبَتِی لَتَمَسُّ رُکْبَتَہُ ، أَوْ فَخِذِی تَمَسُّ فَخِذَہُ ، فَمَا سَمِعْتُہُ یَزِیدُ عَلَی ہَؤُلاَئِ الْکَلِمَاتِ ؛ لاَ إلَہَ لاَ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، حَتَّی أَفَاضَ مِنْ عَرَفَۃَ إلَی جَمْعٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 15364","","","كتاب الحج"
"15365","(۱۵۳۶۵) حدَّثَنَا حُمَیْدٌ ، عَنْ سَعِیدِ بْنِ السَّائِبِ ، عَنْ دَاوُدَ بْنِ أَبِی عاصِمٍ ، قَالَ : وَقَفْت مَعَ سَالِمِ بْنِ عَبْدِ اللہِ بِعَرَفَۃَ ، أَنْظُرُ کَیْفَ یَصْنَعُ ؟ ، فَکَانَ فِی الذِّکْرِ وَالدُّعَائِ حَتَّی أَفَاضَ النَّاسُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15365","","","كتاب الحج"
"15366","(۱۵۳۶۶) حدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ أَخِیہِ ، عَنْ عَلِیٍّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَکْثَرُ دُعَائِی ، وَدُعَائِ الأَنْبِیَائِ قَبْلِی بِعَرَفَۃَ ؛ لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ ، وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، اللَّہُمَّ اجْعَلْ فِی قَلْبِی نُورًا ، وَفِی سَمْعِی نُورًا ، وَفِی بَصَرِی نُورًا ، اللَّہُمَّ اشْرَحْ لِی صَدْرِی ، وَیَسِّرْ لِی أَمْرِی ، وَأَعُوذُ بِکَ مِنْ وَسْوَاسِ الصَّدْرِ ، وَشَتَاتِ الأَمْرِ ، وَفِتْنَۃِ الْقَبْرِ ، اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ شَرِّ مَا یَلِجُ فِی اللَّیْلِ ، وَشَرِّ مَا یَلِجُ فِی النَّہَارِ ، وَشَرِّ مَا تَہُبُّ بِہِ الرِّیَاحُ۔\n(ترمذی ۳۵۲۔ ابن خزیمۃ ۲۸۴۱)",": Da'if","Musannaf Ibn Abi Shaybah 15366","","","كتاب الحج"
"15367","(۱۵۳۶۷) حدَّثَنَا وَکِیعٌ ، عَنِ النَّضْرِ بْنِ عَرَبِیٍّ ، عَنِ ابْنِ أَبِی حُسَیْنٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: أَکْثَرُ دُعَائِی وَدُعَائِ الأَنْبِیَائِ قَبْلِی بِعَرَفَۃَ ؛ لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ ، بِیَدِہِ الْخَیْرُ ، یُحْیِی وَیُمِیتُ ، وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ۔","","Musannaf Ibn Abi Shaybah 15367","","","كتاب الحج"
"15368","(۱۵۳۶۸) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ رَجُلٍ ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، قَالَ : قُلْتُ لَہُ : مَا أَفْضَلُ مَا نَقُولُ فِی حَجِّنَا ؟ قَالَ : لاَ إلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ۔","","Musannaf Ibn Abi Shaybah 15368","","","كتاب الحج"
"15369","(۱۵۳۶۹) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ صَدَقَۃَ بْنِ یَسَارٍ ، قَالَ : سَأَلْتُ مُجَاہِدًا عَنْ قِرَائَۃِ الْقُرْآنِ ، أَفْضَلُ یَوْمَ عَرَفَۃَ ، أَوِ الذِّکْرِ ؟ قَالَ : لاَ ، بَلْ قِرَائَۃُ الْقُرْآنِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15369","","","كتاب الحج"
"15370","(۱۵۳۷۰) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ شَتْرٍ ، قَالَ : قُلْتُ لابْنِ الْحَنَفِیَّۃِ : مَا أَفْضَلُ مَا نَقُولُ فِی حَجِّنَا ؟ قَالَ : لاَ إلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ۔","","Musannaf Ibn Abi Shaybah 15370","","","كتاب الحج"
"15371","(۱۵۳۷۱) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ رَجُلٍ ، مِنْ بَکْرِ بْنِ وَائِلٍ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ ، قُلْتُ : إنَّا نُکْرِی فِی ہَذَا الْوَجْہِ للْحَجِّ ، وَإِنَّ أُنَاسًا یَزْعُمُونَ أَنْ لاَ حَجَّ لَنَا ، قَالَ : أَلَسْتُمْ تُلَبُّونَ ، وَتَطُوفُونَ بِالْبَیْتِ وَبَیْنَ الصَّفَا وَالْمَرْوَۃِ ، وَتَرْمُونَ الْجِمَارَ ، وَتَقِفُونَ بِالْمَوْقِفِ ؟ قَالُوا : بَلَی ، قَالَ : فَإِنَّکُمْ حُجَّاجٌ ، قَدْ جَائَ رَجُلٌ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَأَلَہُ عَنْ مِثْلِ الَّذِی سَأَلْتَنِی عَنْہُ فَلَمْ یُجِبْہُ حَتَّی نَزَلَتْ ہَذِہِ الآیَۃُ : {لَیْسَ عَلَیْکُمْ جُنَاحٌ أَنْ تَبْتَغُوا فَضْلاً مِنْ رَبِّکُمْ} فَدَعَاہُ فَقَرَأَہَا عَلَیْہِ ، ثُمَّ قَالَ : إِنَّکُمْ حُجَّاجٌ۔\n(ابوداؤد ۱۷۳۰۔ احمد ۲/۱۵۵)",": Da'if","Musannaf Ibn Abi Shaybah 15371","","","كتاب الحج"
"15372","(۱۵۳۷۲) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَتَاہُ رَجُلٌ ، فَقَالَ : إِنِّی أَکْرَیْتُ نَفْسِی مِنْ قَوْمٍ ، وَوَضَعْتُ عَنْہُمْ مِنْ أَجْرِی مِنْ أَجْلِ الْحَجِّ ، فَہَلْ یُجْزِئُ ذَلِکَ عَنِّی ؟ فَقَالَ ابْنُ عَبَّاسٍ : ہَذَا مِنَ الَّذِینَ قَالَ اللَّہُ تَعَالَی : {أُولَئِکَ لَہُمْ نَصِیبٌ مِمَّا کَسَبُوا وَاللَّہُ سَرِیعُ الْحِسَابِ}۔",": Sahih","Musannaf Ibn Abi Shaybah 15372","","","كتاب الحج"
"15373","(۱۵۳۷۳) حدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ سُئِلَ عَنِ الأَجِیرِ یُؤَاجِرُ نَفْسَہُ إِلَی مَکَّۃَ ، ثُمَّ یُوسِرُ ، قَالَ : یُجْزِئُ عَنْہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15373","","","كتاب الحج"
"15374","(۱۵۳۷۴) حدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ ؛ فِی التَّاجِرِ وَالْکَرِیِّ ، قَالُوا : یُجْزِئُہُمَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15374","","","كتاب الحج"
"15375","(۱۵۳۷۵) حدَّثَنَا وَکِیعٌ ، عَنِ الْحَسَنِ أَبِی طَالُوتَ ، عَنْ أَبِی السَّلِیلِ ، عَنِ ابْنِ عُمَرَ ؛ فِی الرَّجُلِ یُکْرِی نَفْسَہُ فِی الْحَجِّ ، قَالَ : یُجْزِئُہُ۔","","Musannaf Ibn Abi Shaybah 15375","","","كتاب الحج"
"15376","(۱۵۳۷۶) حدَّثَنَا أَبُو نُعَیْمٍ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، قَالَ : سَأَلْتُ مُجَاہِدًا عَنِ التَّاجِرِ ، وَالْکَرِیِّ ، وَالأَجِیرِ ؟ قَالَ : لاَ یُنْتَقَصُ الْکَرِیُّ مِنْ حَجِّہِ ، وَلاَ التَّاجِرُ مِنْ حَجِّہِ ، وَلاَ الأَجِیرُ مِنْ حَجِّہِ۔","","Musannaf Ibn Abi Shaybah 15376","","","كتاب الحج"
"15377","(۱۵۳۷۷) حدَّثَنَا أَبُو نُعَیْمٍ ، وَوَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : سَمِعْتُہُ وَسَأَلَہُ أَعْرَابِیٌّ ، فَقَالَ : إِنِّی أَکْرَیْتُ إِبِلاً وَأَنَا أُرِیدُ الْحَجَّ ، أَیُجْزِئُنِی ؟ قَالَ : لاَ ، وَلاَ کَرَامَۃَ۔","","Musannaf Ibn Abi Shaybah 15377","","","كتاب الحج"
"15378","(۱۵۳۷۸) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لاَ یُجْزِئُہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15378","","","كتاب الحج"
"15379","(۱۵۳۷۹) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی السَّلِیلِ ، قَالَ : قُلْتُ لِسَعِیدِ بْنِ الْمُسَیَّبِ : إِنَّ أُنَاسًا یَزْعُمُونَ، أَوْ مَنْ زَعَمَ مِنْہُمْ ، أَنَّ الْکَرِیَّ لاَ حَجَّ لَہُ ؟ قَالَ : بَلْ لَہُ حَجٌّ حَسَنٌ جَمِیلٌ ، إِنِ اتَّقَی اللَّہَ ، وَأَدَّی الأَمَانَۃَ ، وَأَحْسَنَ الصَّحَابَۃَ۔","","Musannaf Ibn Abi Shaybah 15379","","","كتاب الحج"
"15380","(۱۵۳۸۰) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ فِی قَوْلِہِ تعالی : {فَصِیَامُ ثَلاَثَۃِ أَیَّامٍ فِی الْحَجِّ} ، قَالَ : صُمْ قَبْلَ التَّرْوِیَۃِ بِیَوْمٍ ، وَیَوْمَ التَّرْوِیَۃِ ، وَیَوْمَ عَرَفَۃَ ، فَإِنْ فَاتَہُ الصَّوْمُ تَسَحَّرَ لَیْلَۃَ الْحَصبۃِ فَصَامُ ثَلاَثَۃَ أَیَّامٍ ، وَسَبْعَۃً إذَا رَجَعَ۔","","Musannaf Ibn Abi Shaybah 15380","","","كتاب الحج"
"15381","(۱۵۳۸۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، وَعِیَاضٌ ، وَجَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، وَمُجَاہِدٍ ، قَالاَ : آخِرُہَا یَوْمُ عَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 15381","","","كتاب الحج"
"15382","(۱۵۳۸۲) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ حَجَّاجٍ ، قَالَ : سَمِعْتُ أَبَا جَعْفَرٍ یَقُولُ : آخِرُہَا یَوْمُ عَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 15382","","","كتاب الحج"
"15383","(۱۵۳۸۳) حَدَّثَنَا ابْنُ مُبَارَکٍ، عَنْ حَجَّاجٍ، عَنْ عَطَائٍ، قَالَ: إِنْ شَائَ صَامَ أَوَّلَ الْعَشْرِ وَوَسَطَہَا، وَآخِرَہَا یَوْمَ عَرَفَۃَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15383","","","كتاب الحج"
"15384","(۱۵۳۸۴) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ حَجَّاجٍ ، عَنْ حبیب ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، مِثْلَ قَوْلِ عَطَائٍ۔","","Musannaf Ibn Abi Shaybah 15384","","","كتاب الحج"
"15385","(۱۵۳۸۵) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ حَجَّاجٍ ، عَنِ الْقَاسِمِ بْنِ نَافِعٍ ، عَنْ مُجَاہِدٍ ، قَالَ : آخِرُہَا یَوْمُ عَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 15385","","","كتاب الحج"
"15386","(۱۵۳۸۶) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ حَجَّاجٍ ، قَالَ : انْطَلَقْت أَنَا وَالْحَکَمُ إلَی أَبِی الْوَلِیدِ فَأَخْبَرَنَا ، أَنَّہُ سَمِعَ ابْنَ عُمَرَ یَقُولُ : آخِرُہَا یَوْمُ عَرَفَۃَ۔",": Hasan","Musannaf Ibn Abi Shaybah 15386","","","كتاب الحج"
"15387","(۱۵۳۸۷) حَدَّثَنَا ابْنُ مُسْہِرٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ فِی قَوْلِہِ تعالی : {فَصِیَامُ ثَلاَثَۃِ أَیَّامٍ فِی الْحَجِّ} قَالَ : قَبْلَ التَّرْوِیَۃِ یَوْمًا وَآخِرُہَا یَوْمُ عَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 15387","","","كتاب الحج"
"15388","(۱۵۳۸۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ مِثْلَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15388","","","كتاب الحج"
"15389","(۱۵۳۸۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، قَالَ : مَنْ لَمْ یَصُمْ قَبْلَ التَّرْوِیَۃِ بِیَوْمٍ ، ویَوْمَ التَّرْوِیَۃِ ، وَیَوْمَ عَرَفَۃَ ، فَاتَہُ الصَّوْمُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15389","","","كتاب الحج"
"15390","(۱۵۳۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ یُونُسَ بْنِ أَبِی إِسْحَاقَ ، عَنْ وَبَرَۃَ ، عَنِ ابْنِ عُمَرَ وَعُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ ابْنُ عُمَرَ : قبْلَ یَوْمِ التَّرْوِیَۃِ بِیَوْمٍ ، وَیَوْمَ التَّرْوِیَۃِ ، وَیَوْمَ عَرَفَۃَ ، وَقَالَ : عُبَیْدُ بْنُ عُمَیْرٍ : یَصُومُ أَیَّامَ التَّشْرِیقِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15390","","","كتاب الحج"
"15391","(۱۵۳۹۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ طَاوُوسٍ ، وَابْنِ طَاوُوس ، عَنْ أَبِیہِ : یَجْعَلُ الْمُتَمَتِّعُ آخِرَ صَوْمِہِ یَوْمَ عَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 15391","","","كتاب الحج"
"15392","(۱۵۳۹۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : {فَصِیَامُ ثَلاَثَۃِ أَیَّامٍ فِی الْحَجِّ} آخِرُہَا یَوْمُ عَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 15392","","","كتاب الحج"
"15393","(۱۵۳۹۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ وَحَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : آخِرُہَا یَوْمُ عَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 15393","","","كتاب الحج"
"15394","(۱۵۳۹۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُحْمَلُ الْمَرِیضُ إلَی الْجِمَارِ ، فَإِنَ اسْتَطَاعَ أَنْ یَرْمِیَ فَلْیَرْمِ ، وَإِنْ لَمْ یَسْتَطِعْ فَلْیُوضَعَ الْحَصَی فِی کَفِّہِ ، ثُمَّ یُرْمَی بِہَا مِنْ کَفِّہِ۔","","Musannaf Ibn Abi Shaybah 15394","","","كتاب الحج"
"15395","(۱۵۳۹۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُشْہَدُ بِالْمَرِیضِ الْمَنَاسِکُ کُلُّہَا ، وَیُطَافُ بِہِ عَلَی مَحْمِلٍ فَإِذَا رَمَی الْجِمَارَ وُضِعَ فِی کَفِّہِ ، ثُمَّ رُمِیَ بِہِ مِنْ کَفِّہِ۔","","Musannaf Ibn Abi Shaybah 15395","","","كتاب الحج"
"15396","(۱۵۳۹۶) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : یُرْمَی عَنْہُ۔","","Musannaf Ibn Abi Shaybah 15396","","","كتاب الحج"
"15397","(۱۵۳۹۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ تَحُجُّ الْمَرْأَۃُ إِلاَّ مَعَ ذِی مَحْرَمٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15397","","","كتاب الحج"
"15398","(۱۵۳۹۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ ابْنِ سِیرِینَ ، أنہ قَالَ : تَخْرُجُ فِی رُفْقَۃٍ فِیہَا رِجَالٌ وَنِسَائٌ۔","","Musannaf Ibn Abi Shaybah 15398","","","كتاب الحج"
"15399","(۱۵۳۹۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ قَالَ : تَحُجُّ مع رُفْقَۃٍ فِیہَا رِجَالٌ وَنِسَائٌ وَتَتَّخِذُ سُلَّمًا تَصْعَدُ عَلَیْہِ ، وَلاَ یَقْرَبُہَا الْکَرِی۔","","Musannaf Ibn Abi Shaybah 15399","","","كتاب الحج"
"15400","(۱۵۴۰۰) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ یَحْیَی بْنِ عَبَّادٍ أَبِی ہُبَیْرَۃَ ، قَالَ : کَتَبَتِ امْرَأَۃٌ مِنْ أَہْلِ الرَّیِّ إلَی إبْرَاہِیمَ ، إِنَّہَا مُوسِرَۃٌ وَلَیْسَ لَہَا بَعْلٌ ، وَلاَ مَحْرَمٌ ، وَلَمْ تَحُجَّ قَطُّ ، فَکَتَبَ إلَیْہَا إبْرَاہِیمُ : إنَّ ہَذَا مِنَ السَّبِیلِ الَّذِی ، قَالَ اللَّہُ وَلَیْسَ لَکِ مَحْرَمٌ ، فَلاَ تَحُجِّی إِلاَّ مَعَ بَعْلٍ ، أَوْ مَحْرَمٍ۔","","Musannaf Ibn Abi Shaybah 15400","","","كتاب الحج"
"15401","(۱۵۴۰۱) حَدَّثَنَا جَرِیرٌ ، عَنِ ابْنِ شُبْرُمَۃَ ، قَالَ : کَانَ الْحَسَنُ بْنُ أَبِی الْحَسَنِ یُرَخِّصُ لِلْمَرْأَۃِ الَّتِی لَمْ تَحُجَّ قَطُّ أَنْ تَحُجَّ مَعَ الْمَرْأَۃِ الَّتِی مَعَہَا مَحْرَمٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15401","","","كتاب الحج"
"15402","(۱۵۴۰۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تُسَافِرُ الْمَرْأَۃُ سَفَرًا یَکُونُ ثَلاَثَۃَ أَیَّامٍ فصاعدًا إِلاَّ مَعَ أمہا ، أَوِ ابْنِہَا ، أو أَبِیہَا ، أَوْ أَخِیہَا ، أَوْ زَوْجِہَا ، أَوْ ذِی مَحْرَمٍ۔ (ابوداؤد ۱۷۲۳۔ ترمذی ۱۱۶۹)",": Sahih","Musannaf Ibn Abi Shaybah 15402","","","كتاب الحج"
"15403","(۱۵۴۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، أَنَّہُ سُئِلَ عَنِ الْمَرْأَۃِ تُرِیدُ الْحَجَّ وَزَوْجُہَا غَائِبٌ بِخُرَاسَانَ ، فَقَالَ : إذَا کَانَتِ الْفَرِیضَۃُ وَکَانَ لَہَا مَحْرَمٌ فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 15403","","","كتاب الحج"
"15404","(۱۵۴۰۴) حَدَّثَنَا حُمَیْدٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : لاَ تَحُجُّ الْمَرْأَۃُ إِلاَّ مَعَ زَوْجٍ ، أَوْ ذِی مَحْرَمٍ۔","","Musannaf Ibn Abi Shaybah 15404","","","كتاب الحج"
"15405","(۱۵۴۰۵) حَدَّثَنَا حُمَیْدٍ ، عَنْ حَسَنٍ ، عَنْ عَلِیِّ بْنِ عَبْدِ الأَعْلَی ، قَالَ : سُئِلَ عکْرِمَۃُ ، عَنِ الْمَرْأَۃِ تَحُجُّ مَعَ غَیْرِ ذِی مَحْرَمٍ ، أَوْ زَوْجٍ ، فَقَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تُسَافِرَ الْمَرْأَۃُ فَوْقَ ثَلاَثَۃٍ إِلاَّ مَعَ ذِی مَحْرَمٍ ، فَکَیْفَ تَصْنَعُ بأُستہا۔","","Musannaf Ibn Abi Shaybah 15405","","","كتاب الحج"
"15406","(۱۵۴۰۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ تُسَافِرُ امْرَأَۃٌ فَوْقَ ثَلاَثَۃٍ إِلاَّ مَعَ ذِی مَحْرَمٍ۔ (بخاری ۱۰۸۷۔ مسلم ۷۱۳)",": Sahih","Musannaf Ibn Abi Shaybah 15406","","","كتاب الحج"
"15407","(۱۵۴۰۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی مَعْبَدٍ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ یَقُولُ سَمِعْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَخْطُبُ یَقُولُ : لاَ تُسَافِرُ امْرَأَۃٌ إِلاَّ مَعَ ذِی مَحْرَمٍ فَقَامَ رَجُلٌ ، فَقَالَ : یَا رَسُولَ اللہِ إنَّ امْرَأَتِی خَرَجَتْ حَاجَّۃً وَإِنِّی أُکتتبتُ فِی غَزْوَۃِ کَذَا وَکَذَا ، فَقَالَ : انْطَلِقْ فَحُجَّ مَعَ امْرَأَتِکَ۔\n(بخاری ۳۰۰۶۔ مسلم ۹۷۸)",": Sahih","Musannaf Ibn Abi Shaybah 15407","","","كتاب الحج"
"15408","(۱۵۴۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ یُونُسَ ، عَنِ الزُّہْرِیِّ ، قَالَ : ذُکِرَ عِنْدَ عَائِشَۃَ الْمَرْأَۃُ لاَ تُسَافِرُ إِلاَّ مَعَ ذِی مَحْرَمٍ ، فَقَالَتْ عَائِشَۃُ : لَیْسَ کُلُّ النِّسَائِ یَجِدُ مَحْرَمًا۔","","Musannaf Ibn Abi Shaybah 15408","","","كتاب الحج"
"15409","(۱۵۴۰۹) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ سَعِیدٍ الْمَقْبُرِیِّ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تُسَافِرُ امْرَأَۃٌ مَسِیرَۃَ یَوْمٍ تَامٍّ إِلاَّ مَعَ ذِی مَحْرَمٍ۔ (بخاری ۱۰۸۸۔ مسلم ۹۷۷)",": Sahih","Musannaf Ibn Abi Shaybah 15409","","","كتاب الحج"
"15410","(۱۵۴۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، قَالَ : ذُکِرَ لِعُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، امْرَأَۃٌ سَافَرَتْ مَعَ عَبْدِہَا فَکَرِہَ ذَلِکَ ، فَقِیلَ لَہُ : إِنَّہُ أَخُوہَا مِنَ الرَّضَاعَۃِ ، فَلَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 15410","","","كتاب الحج"
"15411","(۱۵۴۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یَعْقُوبَ ، عَنْ عَطَائٍ فِی الرَّجُلِ یُہِلُّ بِحَجَّتَیْنِ ، قَالَ : ہُوَ مُتَمَتِّعٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15411","","","كتاب الحج"
"15412","(۱۵۴۱۲) حَدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : عَلَیْہِ حَجَّۃٌ وَعُمْرَۃٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15412","","","كتاب الحج"
"15413","(۱۵۴۱۳) حَدَّثَنَا جَرِیرٌ ، عَنِ الرُّکَیْنِ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ لابْنِ الزُّبَیْرِ حِینَ سَقَطَتِ الشَّمْسُ : أَفِضْ۔",": Sahih","Musannaf Ibn Abi Shaybah 15413","","","كتاب الحج"
"15414","(۱۵۴۱۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، أَنَّ جِبْرِیلَ جَائَ إلَی إبْرَاہِیمَ فَوَقَفَ بِعَرَفَاتٍ حَتَّی إذَا کَانَ کَأَعْجَلِ مَا یُصَلِّی أَحَدٌ الْمَغْرِبَ دَفَعَ بِہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15414","","","كتاب الحج"
"15415","(۱۵۴۱۵) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوِہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15415","","","كتاب الحج"
"15416","(۱۵۴۱۶) حَدَّثَنَا یَحْیَی بْنُ أَبِی زَائِدَۃَ، عَنِ ابْنِ جُرَیْجٍ، قَالَ: أُخْبِرْت، عَنْ مُحَمَّدِ بْنِ قَیْسِ بْنِ مَخْرَمَۃَ بْنِ الْمُطَّلِبِ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَطَبَ بِعَرَفَۃَ ، فَقَالَ : أَمَّا بَعْدُ ، فَإِنَّ ہَذَا یَوْمُ الْحَجِّ الأَکْبَرِ ، وَإِنَّ أَہْلَ الْجَاہِلِیَّۃِ وَالأَوْثَانِ کَانُوا یَدْفَعُونَ فِی ہَذَا الْیَوْمِ قَبْلَ غُرُوبِ الشَّمْسِ حِینَ تُعتمُّ بِہَا الْجِبَالُ کَأَنَّہَا عَمَائِمُ الرِّجَالِ فِی وُجُوہِہِمْ ، وَإِنَّا نَدْفَعُ بَعْدَ غُرُوبِہَا ، فَلاَ تُعَجِّلُونَنَا ، ہَدْیُنَا مُخَالِفٌ ہَدْیَ أَہْلِ الشِّرْکِ وَالأَوْثَانِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15416","","","كتاب الحج"
"15417","(۱۵۴۱۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ أَنَّہُ سَمِعَ ابْنَ الزُّبَیْرِ یَقُولُ دَفْع الإِمَامُ مِنْ عَرَفَۃَ إذَا غَرَبَتِ الشَّمْسُ۔",": Sahih","Musannaf Ibn Abi Shaybah 15417","","","كتاب الحج"
"15418","(۱۵۴۱۸) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ یَرَی الدَّفْعَۃَ مِنْ عَرَفَۃَ إذَا تَبَیَّنَ اللَّیْلُ وَأَفْطَرَ الصَّائِمُ۔","","Musannaf Ibn Abi Shaybah 15418","","","كتاب الحج"
"15419","(۱۵۴۱۹) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَبِیہِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : وَقَفْت مَعَ عَبْدِ اللہِ وَعَلَی النَّاسِ عُثْمَانَ ، حَتَّی إذَا غَرَبَتِ الشَّمْسُ ، قَالَ : لَوْ أَنَّ أَمِیرَ الْمُؤْمِنِینَ أَفَاضَ السَّاعَۃَ أَصَابَ السُّنَّۃَ ، فَمَا کَانَ کَلاَمُہُ بِأَسْرَعَ مِنْ أَنْ أَفَاضَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15419","","","كتاب الحج"
"15420","(۱۵۴۲۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ إذَا دَخَلُوا مَکَّۃَ أَنْ لاَّ یَخْرُجُوا حَتَّی یَخْتِمُوا الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 15420","","","كتاب الحج"
"15421","(۱۵۴۲۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یُعْجِبُہُمْ إذَا قَدِمُوا مَکَّۃَ بِحَجٍّ ، أَوْ عُمْرَۃٍ أَلاَّ یَخْرُجُوا حَتَّی یَقْرَؤُوا مَا مَعَہُمْ مِنَ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 15421","","","كتاب الحج"
"15422","(۱۵۴۲۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : کَانَ یُحَبُّ ، أَوْ یَسْتَحِبُّ إذَا قَدِمَ شَیْئًا مِنْ ہَذِہِ الْمَسَاجِدِ ، أَنْ لاَ یَخْرُجَ حَتَّی یَقْرَأَ الْقُرْآنَ ، بِالْمَسْجِدِ الْحَرَامِ وَمَسْجِدِ الْمَدِینَۃِ ، وَمَسْجِدِ بَیْتِ الْمَقْدِسِ۔","","Musannaf Ibn Abi Shaybah 15422","","","كتاب الحج"
"15423","(۱۵۴۲۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، أَنَّہُ قَرَأَہُ یَعْنِی الْقُرْآنَ حَیْثُ قَدِمَ مَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 15423","","","كتاب الحج"
"15424","(۱۵۴۲۴) حَدَّثَنَا عَبَّاد بن العوام ، عَنْ یَحْیَی الْبَکَّائِ ، قَالَ : سَمِعَ : ابْنُ عُمَرَ رَجُلاً یَقْرَأُ وَہُوَ یَطُوفُ بِالْبَیْتِ فَنَہَاہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 15424","","","كتاب الحج"
"15425","(۱۵۴۲۵) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ یَکْرَہُ الْقِرَائَۃُ فِی العَشْر فِی الطَّوَافِ ، وَلَکِنْ یَذْکُرُ اللَّہَ وَیَحْمَدُہُ وَیُکَبِّرُہُ۔","","Musannaf Ibn Abi Shaybah 15425","","","كتاب الحج"
"15426","(۱۵۴۲۶) حَدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ ، قَالاَ : الْقِرَائَۃُ فِی الطَّوَافِ مُحْدَثٌ۔","","Musannaf Ibn Abi Shaybah 15426","","","كتاب الحج"
"15427","(۱۵۴۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إِبْرَاہِیمَ بن نَافِعٍ ، قَالَ : طُفْت مَعَ سَعِیدِ بْنِ جُبَیْرٍ وَکَانَ لاَ یَفْتُرُ مِنْ ذِکْرِ اللہِ۔","","Musannaf Ibn Abi Shaybah 15427","","","كتاب الحج"
"15428","(۱۵۴۲۸) حَدَّثَنَا حَفْصٌ، عَنْ حَجَّاجٍ، قَالَ: سَأَلْتُ عَطَائً، عَنِ الْقِرَائَۃِ فِی الطَّوَافِ حَوْلَ الْبَیْتِ، فَلَمْ یَرَ بِہَا بَأْسًا۔","","Musannaf Ibn Abi Shaybah 15428","","","كتاب الحج"
"15429","(۱۵۴۲۹) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، قَالَ : رَأَیْتُ أَصْحَابَنَا یَقْرَؤُونَ عَلَی مُجَاہِدٍ فِی الطَّوَافِ۔","","Musannaf Ibn Abi Shaybah 15429","","","كتاب الحج"
"15430","(۱۵۴۳۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ یَکْرَہُ القراء ۃ فِی الطَّوَافِ۔","","Musannaf Ibn Abi Shaybah 15430","","","كتاب الحج"
"15431","(۱۵۴۳۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، أَنَّہُ کَانَ مَعَ ابْنِ عُمَرَ ، فَأَتَی جَمْعًا فَصَلَّی الْمَغْرِبَ ، ثُمَّ الْتَفَتَ إلَیْنَا ، فَقَالَ : الصَّلاَۃُ جَامِعَۃٌ ، وَلَمْ یَتَجَوَّزْ بَیْنَہُمَا۔",": Sahih","Musannaf Ibn Abi Shaybah 15431","","","كتاب الحج"
"15432","(۱۵۴۳۲) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنِ الْحَکَمِ، عَنْ إِبْرَاہِیمَ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِید، قَالَ: حجَجْت مَعَ عَبْدِ اللہِ ، فَلَمَّا أَتَی جَمْعًا أَذَّنَ وَأَقَامَ فَصَلَّی الْمَغْرِبَ ثَلاَثًا ، ثُمَّ تَعَشَّی ، ثُمَّ أَذَّنَ وَأَقَامَ فَصَلَّی الْعِشَائَ رَکْعَتَیْنِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15432","","","كتاب الحج"
"15433","(۱۵۴۳۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، أَنَّ عُمَرَ صَنَعَ مِثْلَ صَنِیعِ ابْنِ مَسْعُودٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 15433","","","كتاب الحج"
"15434","(۱۵۴۳۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ ذِئْبٍ ، عَنْ إِبْرَاہِیمَ ، عَن سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَمَعَ بَیْنَہُمَا بِجَمْعٍ ، وَلَمْ یَتَطَوَّعْ بَیْنَہُمَا۔ (ابوداؤد ۱۹۲۱۔ مالک ۱۹۶)",": Sahih","Musannaf Ibn Abi Shaybah 15434","","","كتاب الحج"
"15435","(۱۵۴۳۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : دَخَلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْبَیْتَ وَعُثْمَانَ بْنُ طَلْحَۃَ وَبِلاَلٌ ، فَأَجَافُوا عَلَیْہِمُ الْبَابَ طَوِیلاً ، ثُمَّ فَتَحُوا ، فَکُنْت أَوَّلَ النَّاسِ دخل فَلَقِیت بِلاَلاً ، فَقُلْتُ : أَیْنَ صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : بَیْنَ الْعَمُودَیْنِ الْمُقَدَّمَیْنِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15435","","","كتاب الحج"
"15436","(۱۵۴۳۶) حَدَّثَنَا عَبْدَۃُ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی فِی الْبَیْتِ تُجَاہَہُ حِینَ دَخَلَہُ۔\n(مسلم ۳۹۱۔ ابن خزیمۃ ۳۰۱۷)","","Musannaf Ibn Abi Shaybah 15436","","","كتاب الحج"
"15437","(۱۵۴۳۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ لَہُ : أُصَلِّی فِی نَوَاحِی الْبَیْتِ ؟ قَالَ : نَعَمْ ، صَلِّ فِی أَیِّ نَوَاحِیہِ شِئْت۔","","Musannaf Ibn Abi Shaybah 15437","","","كتاب الحج"
"15438","(۱۵۴۳۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ مُجَاہِدٍ ، عَنْ صَفْوَانَ ، أَوِ ابْنِ صَفْوَانَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی فِی الْبَیْتِ رَکْعَتَیْنِ حِینَ دَخَلَہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 15438","","","كتاب الحج"
"15439","(۱۵۴۳۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ فِی بَیْضِ النَّعَامِ دِرْہَمٌ فِی کُلِّ بَیْضَۃٍ۔","","Musannaf Ibn Abi Shaybah 15439","","","كتاب الحج"
"15440","(۱۵۴۴۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ فِی بَیْضِ النَّعَامِ قِیمَتُہُ۔","","Musannaf Ibn Abi Shaybah 15440","","","كتاب الحج"
"15441","(۱۵۴۴۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ خُصَیْفٍ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : فِی بَیْضِ النَّعَامِ قِیمَتُہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 15441","","","كتاب الحج"
"15442","(۱۵۴۴۲) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ فِی بَیْضِ النَّعَامِ قِیمَتُہُ۔","","Musannaf Ibn Abi Shaybah 15442","","","كتاب الحج"
"15443","(۱۵۴۴۳) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ اللہِ بْنِ ذَکْوَانَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سُئِلَ عَنْ مُحْرِمٍ أَصَابَ بَیْضَ نَعَامٍ ، قَالَ : فَرَأَی عَلَیْہِ فِی کُلِّ بَیْضَۃٍ صِیَامُ یَوْمٍ ، أَوْ إطْعَامُ مِسْکِینٍ۔","","Musannaf Ibn Abi Shaybah 15443","","","كتاب الحج"
"15444","(۱۵۴۴۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزناد ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوٍ مِنْ حَدِیثِ حَفْصٍ ، عَنِ ابْنِ جُرَیْجٍ۔","","Musannaf Ibn Abi Shaybah 15444","","","كتاب الحج"
"15445","(۱۵۴۴۵) حَدَّثَنَا وَکِیعٌ ، وَابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عُمَرَ ، قَالَ فِی بَیْضِ النَّعَامِ قِیمَتُہُ۔","","Musannaf Ibn Abi Shaybah 15445","","","كتاب الحج"
"15446","(۱۵۴۴۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ طَلْحَۃَ بْنِ عُبَیْدِ اللہِ ، قَالَ : سَأَلْتُ طَاوُوسًا ، عَنْ بَیْضِ الْحَجَلِ یُصِیبُہُ الْمُحْرِمُ ، قَالَ فِیہِ قِیمَتُہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15446","","","كتاب الحج"
"15447","(۱۵۴۴۷) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ قَالَ فِی بَیْضِ النَّعَامِ أَشَارَ بِہِ رَجُلٌ حَرَامٌ لِحَلاَلٍ : صِیَامُ یَوْمٍ ، أَوْ إطْعَامُ مِسْکِینٍ۔","","Musannaf Ibn Abi Shaybah 15447","","","كتاب الحج"
"15448","(۱۵۴۴۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ فِی کُلِّ بَیْضَتَیْنِ دِرْہَمٌ وَفِی کُلِّ بَیْضَۃٍ نِصْفُ دِرْہَمٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 15448","","","كتاب الحج"
"15449","(۱۵۴۴۹) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، عَنْ عُمَرَ ، أَنَّہُ قَالَ فِی الْبَیْضِ قِیمَتُہُ۔","","Musannaf Ibn Abi Shaybah 15449","","","كتاب الحج"
"15450","(۱۵۴۵۰) حَدَّثَنَا عَبْدَۃُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ مَطَرٍ الْوَرَّاقِ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، أَنَّ رَجُلاً أَوْطَأَ بَعِیرَہُ بَیْضَ نَعَامٍ فَسَأَلَ عَلِیًّا ، فَقَالَ : عَلَیْک لِکُلِّ بَیْضَۃٍ ضرَابُ نَاقَتِہِ ، أَوْ جَنِین نَاقَۃِ ، فَانْطَلَقَ إلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَخْبَرَہُ بِمَا قَالَ : فَقَالَ : قَدْ قَالَ : مَا سَمِعْت ، وَعَلَیْکَ فِی کُلِّ بَیْضَۃٍ صِیَامُ یَوْمٍ ، أَوْ طَعَامُ مِسْکِینٍ۔ (احمد ۵/۵۸۔ بیہقی ۲۰۷)","","Musannaf Ibn Abi Shaybah 15450","","","كتاب الحج"
"15451","(۱۵۴۵۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : ثَمَنُہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15451","","","كتاب الحج"
"15452","(۱۵۴۵۲) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، قَالَ : صِیَامُ یَوْمٍ ، أَوْ طَعَامُ مِسْکِینٍ۔","","Musannaf Ibn Abi Shaybah 15452","","","كتاب الحج"
"15453","(۱۵۴۵۳) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ لاَحِقِ بْنِ حُمَیْدٍ ، عَنْ أَبِی عُبَیْدَۃَ ، أَنَّ ابْنَ مَسْعُودٍ ، قَالَ فِی ذَلِکَ : عَلَیْک لِکُلِّ بَیْضَۃٍ صِیَامُ یَوْمٍ ، أَوْ طَعَامُ مِسْکِینٍ۔","","Musannaf Ibn Abi Shaybah 15453","","","كتاب الحج"
"15454","(۱۵۴۵۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سألتُ الْحَکَمَ ، عَنْ بَیْضِ حَمَامِ الْحَرَمِ ، فَقَالَ : فِی بَیْضَۃٍ مُدٌّ مِنْ طَعَامٍ۔","","Musannaf Ibn Abi Shaybah 15454","","","كتاب الحج"
"15455","(۱۵۴۵۵) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَیُّوبَ السَّخْتِیَانِیِّ ، عَنْ عِکْرِمَۃَ ، أَنّ?? رَجُلاً جَائَ إلَیْہِ فَسَأَلَہُ ، عَنْ رَجُلٍ ذَبَحَ وَلَدَ بَدَنَتِہِ ، قَالَ : عَلَیْہِ دَمٌ۔","","Musannaf Ibn Abi Shaybah 15455","","","كتاب الحج"
"15456","(۱۵۴۵۶) حَدَّثَنَا أَبُو الْحَسَینِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُجَاہِدٍ ، قَالَ : عَلَیْہِ دَمٌ۔",": Hasan","Musannaf Ibn Abi Shaybah 15456","","","كتاب الحج"
"15457","(۱۵۴۵۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الْبَدَنَۃِ تُنْتِجُ ، قَالَ : یَحْمِلُہُ عَلَیْہَا ، فَإِنْ ذَبَحَہُ وَأَکَلَہُ ذَبَحَ مَکَانَہُ کَبْشًا۔","","Musannaf Ibn Abi Shaybah 15457","","","كتاب الحج"
"15458","(۱۵۴۵۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَحْمِلُ وَلَدَ الْبَدَنَۃِ عَلَیْہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 15458","","","كتاب الحج"
"15459","(۱۵۴۵۹) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : وَلَدُ الْبَدَنَۃِ یُنْحَرُ مَعَ أُمِّہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15459","","","كتاب الحج"
"15460","(۱۵۴۶۰) حَدَّثَنَا ابنُ فُضَیْل ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یَقُولُ : إذَا ذُبِحَتِ الْبَدَنَۃُ ذُبِحَ وَلَدُہَا مَعَہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15460","","","كتاب الحج"
"15461","(۱۵۴۶۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ فِی رَجُلٍ سَاقَ بَدَنَتَہُ فَوَضَعَتْ فِی الطَّرِیقِ فَلَمْ یَسْتَطِعْ أَنْ یَحْمِلَہُ ، قَالَ : یَصْنَعُ بِہِ مَا شَائَ ، فَإِذَا دَخَلَ مَکَّۃَ ذَبَحَ مَکَانَہُ کَبْشًا۔","","Musannaf Ibn Abi Shaybah 15461","","","كتاب الحج"
"15462","(۱۵۴۶۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : ہَلْ تَبْرَحُ مَوْقِفًا بِعَرَفَۃَ قَبْلَ الإِمَامِ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 15462","","","كتاب الحج"
"15463","(۱۵۴۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ خُثَیْمٍ ، عَنْ یُوسُفَ بْنِ مَاہَکٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ دَفَعَ قَبْلَ الإِمَامِ۔",": Hasan","Musannaf Ibn Abi Shaybah 15463","","","كتاب الحج"
"15464","(۱۵۴۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، قَالَ : أَفَاضَ صَاحِبٌ لَنَا قَبْلَ الإِمَامِ فَسَأَلْت مُجَاہِدًا ، فَقَالَ : یُہَرِیقُ دَمًا۔","","Musannaf Ibn Abi Shaybah 15464","","","كتاب الحج"
"15465","(۱۵۴۶۵) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا أَفَاضَ قَبْلَ الإِمَامِ فَعَلَیْہِ دَمٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15465","","","كتاب الحج"
"15466","(۱۵۴۶۶) حَدَّثَنَا سَلاَّمٌ أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی رَجُلٍ مَرَّ بِجَمْعٍ وَہُوَ لاَ یَرَی ، أَنَّ بِہَا مَوْقِفًا حَتَّی أَتَی مِنًی ، قَالَ : یُہَرِیقُ لِذَلِکَ دَمًا۔","","Musannaf Ibn Abi Shaybah 15466","","","كتاب الحج"
"15467","(۱۵۴۶۷) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی مَنْ جَہِلَ أَنْ یَبِیتَ بِجَمْعٍ ، قَالَ : یُہَرِیقُ دَمًا۔","","Musannaf Ibn Abi Shaybah 15467","","","كتاب الحج"
"15468","(۱۵۴۶۸) حَدَّثَنَا حَفْصٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَطَائٍ ، قَالَ سَمِعْتُہُ یَقُولُ : مَنْ رَہِقَ ، عَنْ جَمْعٍ فَلَمْ یَنْزِلْہَا أَہْرَاقَ لِذَلِکَ دَمًا۔","","Musannaf Ibn Abi Shaybah 15468","","","كتاب الحج"
"15469","(۱۵۴۶۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ سُفْیَانَ، عَنِ ابْنِ أَبِی السَّفَرِ، عَنِ الشَّعْبِیِّ، قَالَ: مَنْ لَمْ یَقِفْ بِجَمْعٍ جَعَلَہَا عُمْرَۃً۔","","Musannaf Ibn Abi Shaybah 15469","","","كتاب الحج"
"15470","(۱۵۴۷۰) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ، عَنْ عَمْرٍو، عَنِ الْحَسَنِ، قَالَ: مَنْ لَمْ یَقِفْ بِجَمْعٍ، فَلاَ حَجَّ لَہُ، وَیَحُجُّ مِنْ قَابِلٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15470","","","كتاب الحج"
"15471","(۱۵۴۷۱) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : جَزَائً وَاحِدًا۔","","Musannaf Ibn Abi Shaybah 15471","","","كتاب الحج"
"15472","(۱۵۴۷۲) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنِ الشَّعْبِیِّ ، قَالَ : جَزَائً ا وَاحِدًا۔","","Musannaf Ibn Abi Shaybah 15472","","","كتاب الحج"
"15473","(۱۵۴۷۳) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، قَالَ : إنِ اشْتَرَکُوا فَلَمْ یَفْدِہِ أَصْحَابُہُ فَعَلَیْہِ الْفِدَائُ کُلُّہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15473","","","كتاب الحج"
"15474","(۱۵۴۷۴) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوس ، وَمُجَاہِدٍ ، قَالُوا : جَزَائًا وَاحِدًا ، وَقَالَ : مُجَاہِدٌ : إِنْ أَکَلُوا مِنْہُ فَعَلَی کُلِّ وَاحِدٍ مِنْہُمْ جَزَائٌ۔","","Musannaf Ibn Abi Shaybah 15474","","","كتاب الحج"
"15475","(۱۵۴۷۵) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ سَالمٍ ، عَنْ سَعِیدٍ ، قَالَ : عَلَی کُلِّ وَاحِدٍ مِنْہُمْ جَزَائٌ۔","","Musannaf Ibn Abi Shaybah 15475","","","كتاب الحج"
"15476","(۱۵۴۷۶) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : عَلَی کُلِّ وَاحِدٍ مِنْہُمْ جَزَائً ا۔","","Musannaf Ibn Abi Shaybah 15476","","","كتاب الحج"
"15477","(۱۵۴۷۷) حَدَّثَنَا جَرِیرٌ عَنْ مُغِیرَۃَ ، وَابْنِ شُبْرُمَۃَ عَنِ الشَّعْبِیِّ ، قَالَ: إذَا اشْتَرَکُوا ، فَعَلَی کُلِّ وَاحِدٍ مِنْہُمْ جَزَائٌ۔","","Musannaf Ibn Abi Shaybah 15477","","","كتاب الحج"
"15478","(۱۵۴۷۸) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ إِنْ أَکَلاَ مِنْہُ فَعَلَی کُلِّ وَاحِدٍ مِنْہُمَا جَزَائً ا ، وَإِنْ لَمْ یَأْکُلاَ فَعَلَیْہِمَا جَزَائٌ وَاحِدٌ۔","","Musannaf Ibn Abi Shaybah 15478","","","كتاب الحج"
"15479","(۱۵۴۷۹) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، قَالَ : سَأَلْتُ أَبَا جَعْفَرٍ ، وَعَطَائٍ ، عَنِ الْقَوْمِ یَشْتَرِکُونَ فِی الصَّیْدِ وَہُمْ مُحْرِمُونَ ، فَقَالَ : جَزَائٌ وَاحِدٌ۔","","Musannaf Ibn Abi Shaybah 15479","","","كتاب الحج"
"15480","(۱۵۴۸۰) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا اشْتَرَکَ الرَّجُلاَنِ فِی الصَّیْدِ فَکَفَّارَۃٌ وَاحِدَۃٌ، وَإِنْ أَکَلاَ فَعَلَی کُلِّ وَاحِدٍ مِنْہُمَا جَزَائٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15480","","","كتاب الحج"
"15481","(۱۵۴۸۱) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ یُونس ، عَنِ الحَسَن ، قَالَ : عَلَی کُلِّ إِنسَان مِنْہُم جَزَائٌ۔",": Da'if","Musannaf Ibn Abi Shaybah 15481","","","كتاب الحج"
"15482","(۱۵۴۸۲) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَمَّنْ حَدَّثَہُ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ سُئِلَ عَنْ قَوْمٍ مِنَ الْمُشَاۃِ قَتَلُوا صَیْدًا ، قَالَ : عَلَیْہِمْ جَزَائٌ وَاحِدٌ۔",": Da'if","Musannaf Ibn Abi Shaybah 15482","","","كتاب الحج"
"15483","(۱۵۴۸۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : کَانَ یَقُولُ إذَا أَصَابَ اثْنَانِ صَیْدًا فَحُکُومَۃٌ وَاحِدَۃٌ عَلَیْہِمَا۔","","Musannaf Ibn Abi Shaybah 15483","","","كتاب الحج"
"15484","(۱۵۴۸۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ شُبْرُمَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : عَلَی کُلِّ إنْسَانٍ مِنْہُمْ جَزَائٌ ، وَقَالَ : حَمَّادٌ : یُجْزِئُہُمَا جَزَائٌ وَاحِدٌ ، قَالَ : فَأَخْبَرْت الْحَارِثَ بِالَّذِی قَالَ الشَّعْبِیُّ ، قَالَ : الْقَوْلُ مَا قَالَ حَمَّادُ۔","","Musannaf Ibn Abi Shaybah 15484","","","كتاب الحج"
"15485","(۱۵۴۸۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ فِی کُلِّ شَیْئٍ مِنَ الصَّیْدِ حُکُومَۃُ ذَوَی عَدْلٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15485","","","كتاب الحج"
"15486","(۱۵۴۸۶) حَدَّثَنَا ابْنُ أَبِی غنیۃ ، عَنْ أَبِیہِ ، عَنْ حَمَّادٍ ، قَالَ : کُلُّ شَیْئٍ یَصِیبہُ الْمُحْرِمُ مِنَ الصَّیْدِ فَفِیہِ حُکُومَۃُ ذَوَی عَدْلٍ۔","","Musannaf Ibn Abi Shaybah 15486","","","كتاب الحج"
"15487","(۱۵۴۸۷) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَذْبَحُ بِمِنًی ، وَلاَ یُصَلِّی الرَّکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 15487","","","كتاب الحج"
"15488","(۱۵۴۸۸) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ قَالَ : سَأَلَتْ عَطَائً ، قُلْتُ : إنَّ عَبْدَ الْکَرِیمِ ، قَالَ لِی ، بِمِنًی : لاَ تَذْبَحْ حَتَّی تُصَلِّی ، قَالَ : لَیْسَ ذَلِکَ عَلَی أَہْلِ مِنًی إنَّمَا عَلَی أَہْلِ الآفَاقِ ، وَسَأَلْت مُجَاہِدًا ، فَقَالَ لِی مِثْلَ ذَلِکَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15488","","","كتاب الحج"
"15489","(۱۵۴۸۹) حَدَّثَنَا حَفْصٌ ، عَنْ عَبْدِ الْمَلِکِ ، قَالَ : سَأَلْتُ عَطَائً قُلْتُ ، قَالَ لِی قَائِلٌ : صَلِّ الرَّکْعَتَیْنِ قَبْلَ أَنْ تَذْبَحَ ، فَقَالَ : لَیْسَ ذَلِکَ عَلَی أَہْلِ مِنًی ، إنَّمَا صَلاَتُہُمْ مَوْقِفُہُمْ بِجَمْعٍ۔","","Musannaf Ibn Abi Shaybah 15489","","","كتاب الحج"
"15490","(۱۵۴۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ مُجَاہِدٍ ، وَطَاوُوس ، وَعَطَائٍ وَسَالِمٍ وَالْقَاسِمِ ، قَالُوا : لاَ صَلاَۃَ بِمِنًی یَوْمَ النَّحْرِ۔","","Musannaf Ibn Abi Shaybah 15490","","","كتاب الحج"
"15491","(۱۵۴۹۱) حَدَّثَنَا حُمَیْدٌ ، عَنْ قَیْسٍ ، عَنْ جَابِرٍ ، عَنْ طَلْحَۃَ بْنِ عَبْدِ اللہِ ، عَنْ إبْرَاہِیمِ ، وَعَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ أَنَّہُمَا صَلَّیَا بِمِنًی یَوْمَ النَّحْرِ رَکْعَتَیْنِ قَبْلَ أَنْ یَنْحَرَا۔","","Musannaf Ibn Abi Shaybah 15491","","","كتاب الحج"
"15492","(۱۵۴۹۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنِ الْمُثَنَّی ، عَنْ عَمْرِو بْنِ شعیب ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ الرَّکْعَتَانِ وَاجِبَتَانِ عَلَی مَنْ نَحَرَ قَبْلَ أَنْ یَنْحَرَ ، وَمَنْ لَمْ یَنْحَرْ فَعَلَیْہِ أَنْ یَشْہَدَ منًی ، وَزَعَمَ أَنَّہُ لاَ یَسْجُدُ قَبْلَہُمَا فِی فِطْرٍ ، وَلاَ أَضْحَی۔","","Musannaf Ibn Abi Shaybah 15492","","","كتاب الحج"
"15493","(۱۵۴۹۳) حَدَّثَنَا عَبْدُ الأَعْلَی بن عبد الأعلی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ حَکِیمِ بْنِ حکِیمٍ ، عَنْ مَسْعُودِ بْنِ الْحَکَمِ ، عَنْ أُمِّہِ ، قَالَتْ : کَأَنِّی أَنْظُرُ إلَی عَلِیٍّ عَلَی بَغْلَۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَیَّامَ مِنًی وَہُوَ یُنَادِی : أَلاَ إِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إنَّہَا لَیْسَتْ بِأَیَّامِ صِیَامٍ ، إنَّہَا أَیَّامُ أَکْلٍ وَشُرْبٍ۔\n(احمد ۹۲۔ ابن خزیمۃ ۲۱۴۷)","","Musannaf Ibn Abi Shaybah 15493","","","كتاب الحج"
"15494","(۱۵۴۹۴) حَدَّثَنَا سَلاَّمٌ ، عَنْ إِبْرَاہِیمَ ، عَن أَبِی الشَّعْثَائِ ، قَالَ : کُنَّا جُلُوسًا مَعَ عَبْدِ اللہِ بْنِ عُمَرَ بِمِنًی ، فَأُتِینَا بِطَعَامٍ فَتَنَحَّی ابْنٌ لَہُ ، فَقَالَ : إنِّی صَائِمٌ ، فَقَالَ : اطْعَمْ فَإِنَّہَا أَیَّامُ أَکْلٍ وَشُرْبٍ ، قَالَ فَأَفْطَرَ۔",": Da'if","Musannaf Ibn Abi Shaybah 15494","","","كتاب الحج"
"15495","(۱۵۴۹۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : أَیَّامُ التَّشْرِیقِ أَیَّامُ طُعْمٍ وَذِکْرٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15495","","","كتاب الحج"
"15496","(۱۵۴۹۶) حَدَّثَنَا حَفْصٌ وَجَرِیرٌ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ ، عَن صَوْمِ أَیَّامِ التَّشْرِیقِ ، فَقَالَ : قَالَ مَسْرُوقٌ : ہُنَّ أَیَّامُ أَکْلٍ وَشُرْبٍ۔","","Musannaf Ibn Abi Shaybah 15496","","","كتاب الحج"
"15497","(۱۵۴۹۷) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعَثَ بُدَیْلَ بْنَ وَرْقَاء الْخُزَاعِیَّ عَلَی جَمَلٍ أَوْرَقَ یُنَادِی أَیَّامَ مِنًی ، إِنَّہَا أَیَّامُ أَکْلٍ وَشُرْبٍ۔ (طبرانی ۴۲۳)","","Musannaf Ibn Abi Shaybah 15497","","","كتاب الحج"
"15498","(۱۵۴۹۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، قَالَ : حدَّثَنِی رَجُلٌ مِنَ الأَنْصَارِ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ بَعَثَنِی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَیَّامَ التَّشْرِیقُ فَأَمَرَنِی أُنَادِیَ فِی النَّاسِ ، إِنَّہَا أَیَّامُ أَکْلٍ وَشُرْبٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 15498","","","كتاب الحج"
"15499","(۱۵۴۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ نَافِعِ بْنِ جُبَیْرٍ ، عَنْ بِشْرِ بْنِ سُحَیْمٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَطَبَ أَیَّامَ التَّشْرِیقِ ، فَقَالَ : إِنَّہُ لاَ یَدْخُلُ الْجَنَّۃَ إِلاَّ نَفْسٌ مُؤْمِنَۃٌ ، وَإِنَّ ہَذِہِ الأَیَّامَ أَیَّامُ أَکْلٍ وَشُرْبٍ۔ (احمد ۴/۳۳۵۔ دارمی ۱۷۶۶)",": Sahih","Musannaf Ibn Abi Shaybah 15499","","","كتاب الحج"
"15500","(۱۵۵۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ مُنْذِرِ بْنِ جَہْمٍ ، عَنْ عُمَرَ بْنِ خَلْدَۃَ الأَنْصَارِیِّ ، عَنْ أُمِّہِ ، قَالَتْ : بَعَثَ النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلِیًّا أَیَّامَ التَّشْرِیقِ یُنَادِی ، إِنَّہَا أَیَّامُ أَکْلٍ وَشُرْبٍ وَبِعَالٍ۔\n(عبد بن حمید ۱۵۶۲)",": Da'if","Musannaf Ibn Abi Shaybah 15500","","","كتاب الحج"
"15501","(۱۵۵۰۱) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَبْدِ الْمَلِکِ ، عن عطاء قَالَ : کُنَّا نَصُومُ أَیَّامَ التَّشْرِیقِ بِمِنًی ، ثُمَّ نُہِینَا عَنْہَا۔","","Musannaf Ibn Abi Shaybah 15501","","","كتاب الحج"
"15502","(۱۵۵۰۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ وَسَالِمٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنْ عَبْدِ اللہِ بْنِ حُذَافَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَہُ یُنَادِی أَیَّامَ التَّشْرِیقِ ، إِنَّہَا أَیَّامُ أَکْلٍ وَشُرْبٍ۔\n(نسائی ۲۸۷۶۔ احمد ۳/۴۵۰)","","Musannaf Ibn Abi Shaybah 15502","","","كتاب الحج"
"15503","(۱۵۵۰۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَیَّامُ التَّشْرِیقِ أَیَّامُ أَکْلٍ وَشُرْبٍ۔ (ابن ماجہ ۱۷۱۹۔ احمد ۲/۲۲۹)",": Hasan","Musannaf Ibn Abi Shaybah 15503","","","كتاب الحج"
"15504","(۱۵۵۰۴) حَدَّثَنَا عَبْدِ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدِ بن أَبِی الْمَلِیحِ ، قَالَ : أَیَّامُ التَّشْرِیقِ أَیَّامُ أَکْلٍ وَشُرْبٍ۔","","Musannaf Ibn Abi Shaybah 15504","","","كتاب الحج"
"15505","(۱۵۵۰۵) حَدَّثَنَا وَکِیعٍ ، عَنْ مُوسَی بْنِ عُلَیٍّ ، عَنْ أَبیہ ، عَنْ عُقْبَۃَ بْنِ عَامِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَوْمُ عَرَفَۃَ وَیَوْمُ النَّحْرِ وَأَیَّامُ التَّشْرِیقِ عِیدُ أَہْلِ الإِسْلاَمِ وہن أَیَّامُ أَکْلٍ وَشُرْبٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 15505","","","كتاب الحج"
"15506","(۱۵۵۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَنْ رَجُلٍ ، یُقَالَ لَہُ : عِیسَی ، أَنَّ عَلِیًّا رَخَّصَ لِلْمُحْرِمِ أَنْ یُقَرِّدَ بَعِیرَہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 15506","","","كتاب الحج"
"15507","(۱۵۵۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُجَاہِدٍ ، أَوْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ أَنْ یُقَرِّدَ الْمُحْرِمُ بَعِیرَہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 15507","","","كتاب الحج"
"15508","(۱۵۵۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یُقَرِّدَ الْمُحْرِمُ بَعِیرَہُ۔","","Musannaf Ibn Abi Shaybah 15508","","","كتاب الحج"
"15509","(۱۵۵۰۹) حَدَّثَنَا عَبَّادٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَن رَبِیعَۃَ بْنِ عَبْدِ اللہِ بْنِ ہُدَیْر ، قَالَ : رَأَیْتُ عُمَرَ بْنَ الْخَطَّابِ یُقَرِّدُ بَعِیرَہُ بِالسُّقْیَا وَہُوَ مُحْرِمٌ وَیَجْعَلُہُ فِی الطِّینِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15509","","","كتاب الحج"
"15510","(۱۵۵۱۰) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، قَالَ : سَأَلْتُ عَطَائً ، عَنِ الرَّجُلِ یُقَرِّدُ بَعِیرَہُ وَیُلْقِی عَنْہُ الدُّودَ ویحلمہ ، فَقَالَ : قَرِّدْ ، وَحَلِّمْ ، وَأَلْقِ الدُّودَ ، عَنْ بَعِیرِکَ۔","","Musannaf Ibn Abi Shaybah 15510","","","كتاب الحج"
"15511","(۱۵۵۱۱) حَدَّثَنَا سَلاَّمٌ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، قَالَ : قَالَ رَجُلٌ لِعَطَائٍ : أُقَرِّدُ بَعِیرِی وَأَنَا مُحْرِمٌ ؟ قَالَ : نَعَمْ ، قَدْ فَعَلَ ذَلِکَ ابْنُ عُمَرَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15511","","","كتاب الحج"
"15512","(۱۵۵۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ أَبِی الدَّرْدَائِ سألت : مُجَاہِدٌ ، عَنِ الْمُحْرِمِ یُقَرِّدُ بَعِیرَہُ ؟ قَالَ : لاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 15512","","","كتاب الحج"
"15513","(۱۵۵۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، أَنَّہُ کَرِہَ أَنْ یُقَرِّدَ بَعِیرَہُ۔","","Musannaf Ibn Abi Shaybah 15513","","","كتاب الحج"
"15514","(۱۵۵۱۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عِکْرِمَۃَ ، أَنَّہُ یَکْرَہُ أَنْ یُقَرِّدَ الْبَعِیرَ ، فَقَالَ ابْنُ عَبَّاسٍ : انْحَرْہَا ، قَالَ : فَنَحَرَہَا ، فَقَالَ : کَمْ قَتَلْت فِی جِلْدِہَا مِنْ قُرَادٍ ، أَوْ حَمْنَانَۃٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 15514","","","كتاب الحج"
"15515","(۱۵۵۱۵) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عُمَرَ ، عَنْ أَبِی الشَّعْثَائِ : الْمُحْرِمُ یُقَرِّدُ بَعِیرَہُ وَیَطْلِیہِ بِالْقَطِرَانِ۔","","Musannaf Ibn Abi Shaybah 15515","","","كتاب الحج"
"15516","(۱۵۵۱۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ وَیَزِیدُ بْنُ ہَارُونَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنْ عِکْرِمَۃَ، عَنِ ابْنِ عَبَّاسٍ؟ قَالَ: لاَ بَأْسَ بِہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15516","","","كتاب الحج"
"15517","(۱۵۵۱۷) حَدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنْ زَکَرِیَّا بْنِ إِسْحَاقَ ، قَالَ : حدَّثَنَا أَبُو الزُّبَیْرِ ، أَنَّہُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللہِ یَقُولُ : لاَ بَأْسَ أَنْ یُقَرِّدَ الْمُحْرِمُ بَعِیرَہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 15517","","","كتاب الحج"
"15518","(۱۵۵۱۸) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنِ ابْنِ حَرْمَلَۃَ ، قَالَ : قتَلْت قُرَادًا ، أَوْ حُنْظُبًا وَأَنَا مُحْرِمٌ ، فَقَالَ ابْنُ سَعِیدٍ: تَصَدَّقْ بتَمْرَۃٍ ، قَالَ : تَمْرَۃٌ خَیْرٌ مِنْہَا۔","","Musannaf Ibn Abi Shaybah 15518","","","كتاب الحج"
"15519","(۱۵۵۱۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنِ الْقَاسِمِ ، قَالَ : سَأَلْتُ رَجُلاً ، عَنِ الْقُرَادِ یُصِیبُہُ الْمُحْرِمُ ، فَقَالَ : تَمْرَۃٌ خَیْرٌ مِنْ قُرَادٍ ، بَلْ نِصْفُ تَمْرَۃٍ ، بَلْ نَوَاۃٌ خَیْرٌ مِنْ قُرَادٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15519","","","كتاب الحج"
"15520","(۱۵۵۲۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ صَاعِدِ بْنِ مُسْلِمٍ ، عَنِ الشَّعْبِیِّ فِی الْمُحْرِمِ یَقْتُلُ الْقُرَادَ ، قَالَ یُطْعِمُ کَفًّا مِنْ طَعَامِ حِنْطَۃٍ ، أَوْ دَقِیقٍ ، أَوْ تَمْرٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15520","","","كتاب الحج"
"15521","(۱۵۵۲۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی مَسْلَمَۃَ ، قَالَ : سَمِعْتُ عِکْرِمَۃَ ، سئل ، عَنْ مُحْرِمٍ قَتَلَ حَلَمَۃً ، قَالَ یَتَصَدَّقُ بِکِسْرَۃٍ۔","","Musannaf Ibn Abi Shaybah 15521","","","كتاب الحج"
"15522","(۱۵۵۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ یَحْکُمُ عَلَیْہِ فِی الْخَطَأِ وَالْعَمْدِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15522","","","كتاب الحج"
"15523","(۱۵۵۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْن جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ یُحْکَمُ عَلَیْہِ فِی الْخَطَأِ وَالْعَمْدِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15523","","","كتاب الحج"
"15524","(۱۵۵۲۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرو بْنِ مُرَّۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : إنَّمَا جُعِلَ الْجَزَائُ فِی الْعَمْدِ ، وَلَکِنْ غُلِّظَ عَلَیْہِمْ فِی الْخَطَأِ کَی یَتَّقُوا۔","","Musannaf Ibn Abi Shaybah 15524","","","كتاب الحج"
"15525","(۱۵۵۲۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : الْعَمْدُ وَالْخَطَأُ فِی الصَّیْدِ سَوَائٌ ، یُحْکَمُ عَلَیْہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15525","","","كتاب الحج"
"15526","(۱۵۵۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الْحَکَمِ ، أَنَّ عُمَرَ کَانَ کَتَبَ یحکم عَلَیْہِ فِی الْخَطَأِ وَالْعَمْدِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15526","","","كتاب الحج"
"15527","(۱۵۵۲۷) حَدَّثَنَا محبوب الْقَوَارِیرِیُّ ، عَنْ إبْرَاہِیمَ بْنِ طَہْمَانَ ، عَنْ جَابِرٍ ، عَنِ الْحَکَمِ ، عَنْ عُمَرَ مِثْلَہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 15527","","","كتاب الحج"
"15528","(۱۵۵۲۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ نُبِّئْت ، عَنْ مُجَاہِدٍ ، أَنَّہُ قَالَ : لاَ یُحْکَمُ عَلَی مَنْ أَصَابَ الصَّیْدَ مُتَعَمِّدًا ، إنَّمَا یُحْکَمُ عَلَی مَنْ أَصَابَ خَطَأً وَنُبِّئْت ، عَنْ طَاوُوسٍ ، أَنَّہُ قَالَ : لاَ یُحْکَمُ عَلَی مَنْ أَصَابَہُ خَطَأً ، إنَّمَا یُحْکَمُ عَلَی مَنْ أَصَابَہُ مُتَعَمِّدًا۔","","Musannaf Ibn Abi Shaybah 15528","","","كتاب الحج"
"15529","(۱۵۵۲۹) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ سَالِمٍ وَالْقَاسِمِ ، وَعَطَائٍ ، وَطَاوُوس ، وَمُجَاہِدٍ ، قَالُوا : إذَا أَصَابَ الْجَنَادِبَ وَالْعظَاء لَمْ یُحْکَمْ عَلَیْہِ خَطَأً ، وَإِنْ أَصَابَہُ مُتَعَمِّدًا حُکِمَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 15529","","","كتاب الحج"
"15530","(۱۵۵۳۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ حُسَیْنٍ، عَنْ قَتَادَۃَ، عَنْ أَبِی مَدَیْنَۃَ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: لَیْسَ عَلَیْہِ فِی الْخَطَأِ شَیْئٌ۔",": Da'if","Musannaf Ibn Abi Shaybah 15530","","","كتاب الحج"
"15531","(۱۵۵۳۱) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : الْخَطَأُ وَالْعَمْدُ فِی الصَّیْدِ سَوَائٌ ، یُحْکَمُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 15531","","","كتاب الحج"
"15532","(۱۵۵۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ یُونِس ، عن الحسن قَالَ : یُحْکَمُ عَلَیْہِ فِی الْخَطَأِ وَالْعَمْدِ۔","","Musannaf Ibn Abi Shaybah 15532","","","كتاب الحج"
"15533","(۱۵۵۳۳) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ ہِشَامٍ ، قَالَ : رَأَیْتُ الْحَسَنَ یَتَعَجَّلُ إلَی مِنًی قَبْلَ النَّاسِ بِیَوْمٍ ، وَرَأَیْت ہِشَامًا یَتَعَجَّلُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15533","","","كتاب الحج"
"15534","(۱۵۵۳۴) حَدَّثَنَا حَفْصٌ، عَنْ حَجَّاجٍ، قَالَ: سَأَلْتُ عَطَائً، عَنِ التَّعَجُّلِ إلَی مِنًی قَبْلَ التَّرْوِیَۃِ بِیَوْمٍ، فَلَمْ یَرَ بِذَلِکَ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 15534","","","كتاب الحج"
"15535","(۱۵۵۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبَانَ بْنِ عَبْدِ اللہِ ، قَالَ : سَأَلْتُ عَطَائً ، فَقَالَ : مِثْلَ ذَلِکَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15535","","","كتاب الحج"
"15536","(۱۵۵۳۶) حَدَّثَنَا معَنْ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، قَالَ : کُنْتُ أکون مَعَ سَالِمٍ ، وَمَعَ عَبْدِ اللہِ بْنِ عُبَیْدِ اللہِ فَلَمْ أَرَہُمَا غَسَلاَ حَصَی الْجِمَارِ۔","","Musannaf Ibn Abi Shaybah 15536","","","كتاب الحج"
"15537","(۱۵۵۳۷) حَدَّثَنَا عَبْدُالرَّزَّاقِ، عَنْ مَعْمَرٍ، قَالَ سَأَلَتِ الزُّہْرِیَّ أَغْسِلُ حصَی الْجِمَارِ؟ قَالَ: لاَ إِلاَّ أَنْ یَکُونَ فِیہِ قَذَرٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15537","","","كتاب الحج"
"15538","(۱۵۵۳۸) حَدَّثَنَا الْعَقَدِیُّ عَبْدُ الْمَلِکِ بْنُ عَمْرٍو ، عَنْ أَفْلَحَ ، قَالَ : کَانَ الْقَاسِمُ یَغْسِلُ حَصَی الْجِمَارِ وَیَأْخُذُہُ کَمَا ہُوَ فَیَرْمِی بِہِ۔","","Musannaf Ibn Abi Shaybah 15538","","","كتاب الحج"
"15539","(۱۵۵۳۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ مُوَرِّعِ بْنِ مُوسَی ، سَمِعَ شَیْخًا یُحَدِّثُ ، أَنَّہُ رَأَی سَعِیدَ بْنَ جُبَیْرٍ غَسَلَ حَصَی الْجِمَارِ۔","","Musannaf Ibn Abi Shaybah 15539","","","كتاب الحج"
"15540","(۱۵۵۴۰) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سَأَلْتُ عَطَائً ، فَقَالَ : لاَ تَغْسِلْہُ۔","","Musannaf Ibn Abi Shaybah 15540","","","كتاب الحج"
"15541","(۱۵۵۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ یَغْسِلُ حَصَی الْجِمَارِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15541","","","كتاب الحج"
"15542","(۱۵۵۴۲) حَدَّثَنَا معَنْ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبَانَ بْنِ عُثْمَانَ ، قَالَ : وَاللَّہِ ، إنَّ الصَّلاَۃَ لَتُقْضَی فَکَیْفَ لاَ یُقْضَی الرَّمْیُ۔","","Musannaf Ibn Abi Shaybah 15542","","","كتاب الحج"
"15543","(۱۵۵۴۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : دَعَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَاقَتِہ بِالْبَیْدَائِ فَرَکِبَہَا ، فَلَمَّا انْبَعَثَتْ بِہِ رَاحِلَتُہُ لَبَّی۔","","Musannaf Ibn Abi Shaybah 15543","","","كتاب الحج"
"15544","(۱۵۵۴۴) حَدَّثَنَا معَنْ ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، قَالَ : رَأَیْتُ الْقَاسِمَ بْنَ مُحَمَّدٍ أَہَلَّ حِینَ انْبَعَثَتْ بِہِ رَاحِلَتُہُ مِنْ فِنَائِ مَسْجِدِ ذِی الْحُلَیْفَۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15544","","","كتاب الحج"
"15545","(۱۵۵۴۵) حَدَّثَنَا معَنْ ، عَنْ خَالِدٍ ، أَنَّہُ رَأَی سَالِمًا فَعَلَ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 15545","","","كتاب الحج"
"15546","(۱۵۵۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی فِی مَسْجِدِ ذِی الْحُلَیْفَۃِ ، فَلَمَّا اسْتَوَتْ بِہِ رَاحِلَتُہُ بِفِنَائِ الْمَسْجِدِ أَہَلَّ۔ (مالک ۲۹)","","Musannaf Ibn Abi Shaybah 15546","","","كتاب الحج"
"15547","(۱۵۵۴۷) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ إذَا انْبَعَثَتْ بِہِ رَاحِلَتُہُ لَبَّی، وَکَانَتْ عَائِشَۃُ لاَ تُلَبِّی حَتَّی تَأْتِیَ الْبَیْدَائَ۔ (بخاری ۱۵۵۳۔ مسلم ۲۷)",": Hasan","Musannaf Ibn Abi Shaybah 15547","","","كتاب الحج"
"15548","(۱۵۵۴۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃَ ، قَالَ : کَانُوا یُحِبُّونَ التَّلْبِیَۃَ إذَا اسْتَوَی بَعِیرُہُ بِہِ قَائِمًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15548","","","كتاب الحج"
"15549","(۱۵۵۴۹) حَدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنٍ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ رَجَائٍ ، أنَّ عَلْقَمَۃَ کَانَ إذَا جَلَسَ عَلَی الرَّاحِلَۃِ أَخَذَ فِی التَّلْبِیَۃِ فَتَنْبَعِثُ بِہِ وَہُوَ یُلَبِّی۔","","Musannaf Ibn Abi Shaybah 15549","","","كتاب الحج"
"15550","(۱۵۵۵۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا وَضَعَ رِجْلَہُ فِی الْغَرْزِ وَانْبَعَثَتْ بِہِ رَاحِلَتُہُ قَائِمَۃً أَہَلَّ مِنْ ذِی الْحُلَیْفَۃِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15550","","","كتاب الحج"
"15551","(۱۵۵۵۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، أَنَّہُ کَرِہَ أَنْ تُرْمَی الْجِمَارُ لَیْلاً۔",": No Data Available","Musannaf Ibn Abi Shaybah 15551","","","كتاب الحج"
"15552","(۱۵۵۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، أَنَّہُ کَرِہَ رَمْیَ الْجِمَارِ بِاللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 15552","","","كتاب الحج"
"15553","(۱۵۵۵۳) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، أن أُمِّ سَلَمَۃَ ابْنَۃِ الْمُخْتَارِ کَانَتْ تَحْتَ ابْنٍ لِعَبْدِ اللہِ بْنِ عُمَرَ فَوَلَدَتْ بِالْمُزْدَلِفَۃِ فَتَخَلَّفَتْ مَعَہَا صَفِیَّۃُ ، فَلَمْ تَضَعْ لَیْلَتَہَا تِلْکَ وَمِنَ الْغَدِ ، ثُمَّ جَائَتَا مِنًی مِنَ اللَّیْلِ فَرَمَتَا الْجَمْرَۃَ فَلَمْ یُنْکِرْ ذَلِکَ عَلَیْہِمَا عَبْدُ اللہِ ، وَلَمْ یَأْمُرْہُمْ أَنْ تقضیا شَیْئًا۔",": Sahih","Musannaf Ibn Abi Shaybah 15553","","","كتاب الحج"
"15554","(۱۵۵۵۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ تُرْمَی الْجِمَارُ بِاللَّیْلِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15554","","","كتاب الحج"
"15555","(۱۵۵۵۵) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ سَابِطٍ ، قَالَ : کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْدَمُونَ حُجَّاجًا فَیَرعَونَ ظَہْرَہُمْ فَیَجِیئُونَ فَیَرْمُونَ بِاللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 15555","","","كتاب الحج"
"15556","(۱۵۵۵۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرٍو قَالَ : أَخْبَرَنِی مَنْ رَأَی بَعْضَ أَزْوَاجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَرْمِی مَغْربَان الشَّمْسُ غَرَبَتِ الشَّمْسُ ، أَوْ لَمْ تَغْرُبْ۔",": Da'if","Musannaf Ibn Abi Shaybah 15556","","","كتاب الحج"
"15557","(۱۵۵۵۷) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوس ، قَالَ : الْکَرِیُّ إذَا لَمْ یَجِدْ رَاعِیًا ، وَالرَّجُلُ إذَا کَانَ نَاسِیًا یَرْمِیَانِ الْجِمَارَ بِاللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 15557","","","كتاب الحج"
"15558","(۱۵۵۵۸) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : الرِّعَائُ یَرْمُونَ لَیْلاً ، وَلاَ یَبِیتُونَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15558","","","كتاب الحج"
"15559","(۱۵۵۵۹) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمْ یَزَلْ وَاقِفًا بِالْمُزْدَلِفَۃِ حَتَّی أَسْفَرَ جِدًّا ، فَدَفَعَ قَبْلَ أَنْ تَطْلُعَ الشَّمْسُ۔",": Sahih","Musannaf Ibn Abi Shaybah 15559","","","كتاب الحج"
"15560","(۱۵۵۶۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ سَمِعَ سَعِیدَ بْنَ عَبْدِ الرَّحْمَنِ بْنِ یَرْبُوعٍ یُخْبِرُ ، عَنْ جُبَیْرِ بْنِ الْحُوَیْرِثِ سَمِعَ أَبَا بَکْرٍ وَہُوَ وَاقِفٌ عَلَی قُزَحٍ وَہُوَ یَقُولُ : أَیُّہَا النَّاسُ أَصْبِحُوا ، أَیُّہَا النَّاسُ أَصْبِحُوا ، ثُمَّ دَفَعَ فَکَأَنِّی أَنْظُرُ إلَی فَخِذِہِ قَدَ انْکَشَفَتْ مِمَّا یُحَرِّشُ بَعِیرَہُ بِمِحْجَنِہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15560","","","كتاب الحج"
"15561","(۱۵۵۶۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ أَبِی الشَّعْثَائِ ، قَالَ : وَقْتُ الدَّفْعَۃِ مِنَ الْمُزْدَلِفَۃِ کَقَدْرِ صَلاَۃِ الْقَوْمِ مِنَ الْمُصْبِحِینَ بِصَلاَۃِ الصُّبْحِ حِینَ تُبْصِرُ الإِبِلُ مَوَاضِعَ أَخْفَافِہَا۔","","Musannaf Ibn Abi Shaybah 15561","","","كتاب الحج"
"15562","(۱۵۵۶۲) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : کَانَ أَہْلُ الْجَاہِلِیَّۃِ یَدْفَعُونَ مِنْ عَرَفَاتٍ قَبْلَ غُرُوبِ الشَّمْسِ ومن المزدلفۃ بعد طلوعہا فَأَخَّرَ اللَّہُ ہَذِہِ وَقَدَّمَ ہَذِہِ ، أَخَّرَ الَّتِی مِنْ عَرَفَۃَ إلَی غُرُوبِ الشَّمْسِ ، وَقَدَّمَ الَّتِی مِنْ مُزْدَلِفَۃَ قَبْلَ طُلُوعِ الشَّمْسِ۔","","Musannaf Ibn Abi Shaybah 15562","","","كتاب الحج"
"15563","(۱۵۵۶۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، قَالَ وَقَفَ ابْنُ الزُّبَیْرِ بِجَمْعٍ فأسفر ، فَقَالَ ابْنُ عُمَرَ : طُلُوعُ الشَّمْسِ تنتظر أَفِعْلَ الْجَاہِلِیَّۃِ ؟ فَدَفَعَ ابْنُ عُمَرَ ، وَدَفَعَ النَّاسُ بِدَفْعَتِہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15563","","","كتاب الحج"
"15564","(۱۵۵۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، أَنَّ عَبْدَ اللہِ أَفَاضَ مِنْ جَمْعٍ مِقْدَارَ صَلاَۃِ الْمُسْفِرِینَ بِصَلاَۃِ الْغَدَاۃِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15564","","","كتاب الحج"
"15565","(۱۵۵۶۵) حَدَّثَنَا ابْنُ نُمَیْرٍ وَیَزِیدُ بْنُ ہَارُونَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، قَالَ : سَمِعْتُ ابْنُ الزُّبَیْرِ یَقُولُ : إنَّ مِنْ سُنَّۃِ الْحَجِّ أَنْ یُصَلِّیَ ، ثُمَّ یَقِفَ بِالْمُزْدَلِفَۃِ بَعْدَ أَنْ یُصَلِّیَ الصُّبْحَ إذَا بَرَقَ الْفَجْرُ ، فَإِذَا أَسْفَرَ دَفَعَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15565","","","كتاب الحج"
"15566","(۱۵۵۶۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ قَالَ : قبْلَ طُلُوعِ الشَّمْسِ۔","","Musannaf Ibn Abi Shaybah 15566","","","كتاب الحج"
"15567","(۱۵۵۶۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَمرو، عَنِ ابْنُ الزُّبَیْرِ قَالَ: الدفعۃ مِن جمع طُلُوعِ الشَّمْسِ۔","","Musannaf Ibn Abi Shaybah 15567","","","كتاب الحج"
"15568","(۱۵۵۶۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابن طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ : قبْلَ طُلُوعِ الشَّمْسِ۔","","Musannaf Ibn Abi Shaybah 15568","","","كتاب الحج"
"15569","(۱۵۵۶۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ کَقَدْرِ صَلاَۃِ الصُّبْحِ لاَ مُعَجَّلَۃً، وَلاَ مُؤَخَّرَۃً۔","","Musannaf Ibn Abi Shaybah 15569","","","كتاب الحج"
"15570","(۱۵۵۷۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی زِیَادٍ ، عَنْ القَاسِمِ ، عَنْ عَائِشَۃَ ، قَالَتْ إنَّمَا جُعِلَ الطَّوَافُ بِالْبَیْتِ ، وَالسَّعْیُ بَیْنَ الصَّفَا وَالْمَرْوَۃِ لإِقَامَۃِ ذِکْرِ اللہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15570","","","كتاب الحج"
"15571","(۱۵۵۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی زِیَادٍ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ۔ (ابوداؤد ۱۸۸۳۔ احمد ۶/۱۳۹)",": Da'if","Musannaf Ibn Abi Shaybah 15571","","","كتاب الحج"
"15572","(۱۵۵۷۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ سُلَیْمَانَ بْنِ الْمُغِیرَۃِ القیسی ، عَنِ ابْنِ أَبِی نُعْمٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : مَا تُقُبِّلَ مِنْ حَصَی الْجِمَارِ رُفِعَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15572","","","كتاب الحج"
"15573","(۱۵۵۷۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ فِطْرٍ ، عَنْ أَبِی الطُّفَیْلِ ، قَالَ : قُلْتُ لابْنِ عَبَّاسٍ رَمَی فِی الْجَاہِلِیَّۃِ وَالإِسْلاَمِ ، فَقَالَ : مَا تُقُبِّلَ مِنْہُ رُفِعَ ، وَلولاَ ذَلِکَ کَانَ أَعْظَمَ مِنْ ثَبِیرٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 15573","","","كتاب الحج"
"15574","(۱۵۵۷۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّہُ قَالَ فِی الْہَدْیِ الْوَاجِبِ : لاَ یَأْکُلُ مِنْہُ وَعَلَیْہِ الجَزَاء ، وَقَالَ فِی التَّطَوُّعِ : یَأْکُلُ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 15574","","","كتاب الحج"
"15575","(۱۵۵۷۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ فِی رَجُلٍ سَاقَ بَدَنَۃً فَعَطِبَتْ ، قَالَ : یَأْکُلُ وَیُطْعِمُ وَیَتَصَدَّقُ لأَنَّ عَلَیْہِ الْبَدَلَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15575","","","كتاب الحج"
"15576","(۱۵۵۷۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ ، قَالَ : إذَا سَاقَ ہَدْیًا وَاجِبًا فَعَطِبَ أَکَلَ وَأَطْعَمَ ، وَعَلَیْہِ الْبَدَلُ۔",": Da'if","Musannaf Ibn Abi Shaybah 15576","","","كتاب الحج"
"15577","(۱۵۵۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : کُلْ وَأَبْدِلْ إذَا عَطِبَ الْہَدْیُ ، وَإِنْ کَانَ وَاجِبًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15577","","","كتاب الحج"
"15578","(۱۵۵۷۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَبِی التَّیَّاحِ ، عَنْ مُوسَی بْنِ سَلَمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعَثَ بِثَمَانِ عَشْرَۃَ بَدَنَۃً مَعَ رَجُلٍ فَأَمَرَہُ فِیہَا بِأَمْرِہِ فَانْطَلَقَ ، ثُمَّ رَجَعَ ، فَقَالَ لَہُ : أَرَأَیْت إِنْ أَزْحَفَ عَلَیْنَا مِنْہَا شیء ؟ قَالَ : انْحَرْہَا ، ثُمَّ اغْمِسْ نَعْلَہَا فِی دَمِہَا وَاجْعَلْہَا عَلَی صَفْحَتِہَا ، وَلاَ تَأْکُلْ مِنْہَا أَنْتَ ، وَلاَ أَحَدٌ مِنْ أَہل رُفْقَتِکَ۔ (مسلم ۹۶۲۔ ابوداؤد ۱۷۶۰)",": Sahih","Musannaf Ibn Abi Shaybah 15578","","","كتاب الحج"
"15579","(۱۵۵۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ نَاجِیَۃَ الْخُزَاعِیِّ ، قَالَ : قُلْتُ یَا رَسُولَ اللہِ ، کَیْفَ أَصْنَعُ بِمَا عَطِبَ مِنَ الْبُدْنِ ؟ قَالَ : انْحَرْہُ وَاغْمِسْ نَعْلَہُ فِی دَمِہِ وَخَلِّ بَیْنَ النَّاسِ وَبَیْنَہُ فَلْیَأْکُلُوہُ۔ \n(ابن ماجہ ۳۱۰۶۔ احمد ۴/۳۳۴)",": Sahih","Musannaf Ibn Abi Shaybah 15579","","","كتاب الحج"
"15580","(۱۵۵۸۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشرٍ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سِنَانِ بن سَلَمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ ذُؤَیْبَ الْخُزَاعِیَّ حَدَّثَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَبْعَثُ مَعَہُ بِالْبُدْنِ ، فَیَقُولُ : إذَا عَطِبَ مِنْہَا شَیْئٌ فَخَشِیت عَلَیْہِ مَوْتًا فَانْحَرْہَا ، ثُمَّ اغْمِسْ نَعْلَہَا فِی دَمِہَا ، ثُمَّ اضْرِبْ بِہَا عَلَی صَفْحَتِہَا ، وَلاَ تُطْعِمْ مِنْہَا أَحَدٌ مِنْ أَہْلِ رُفْقَتِکَ۔ (ابن ماجہ ۳۱۰۵۔ احمد ۴/۲۲۵)",": Sahih","Musannaf Ibn Abi Shaybah 15580","","","كتاب الحج"
"15581","(۱۵۵۸۱) حَدَّثَنَا عَبْدَۃُ ، عَنْ عُبَیْدِ اللہِ بن عُمَرَ ، عَنْ نَافِعٍ ، قَالَ : بَعَثَ مَعِی عَبْدُ اللہِ بِبَدَنَۃٍ تَطَوُّعًا ، فَعَطِبَ فِی الطَّرِیقِ ، فَنَحَرْتہَا فَتَصَدَّقْت مِنْہَا بِطَائِفَۃٍ وَرَجَعْت إلَیْہِ بِبَعْضِہَا فَأَکَلَ ، وَلَمْ یُبْدِلْ۔",": Sahih","Musannaf Ibn Abi Shaybah 15581","","","كتاب الحج"
"15582","(۱۵۵۸۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ ، قَالَ : إذَا سَاقَ ہَدْیًا تَطَوُّعًا فَعَطِبَ ؟ قَالَ : کُلْ وَأَطْعِمْ وَلَیْسَ عَلَیْکَ الْبَدَلُ۔",": Da'if","Musannaf Ibn Abi Shaybah 15582","","","كتاب الحج"
"15583","(۱۵۵۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : کُلْ مِنَ التَّطَوُّعِ وَالتَّمَتُّعِ وَہَدْیِ الإِحْصَارِ وَالنَّذْرِ إذَا لَمْ یُسَمَّ۔","","Musannaf Ibn Abi Shaybah 15583","","","كتاب الحج"
"15584","(۱۵۵۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ سالم ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : یُؤْکَلُ مِنَ التَّطَوُّعِ وَالتَّمَتُّعِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15584","","","كتاب الحج"
"15585","(۱۵۵۸۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الصَّدَقَۃُ تَطَوُّعًا ، وَالصَّلاَۃُ وَالصَّوْمُ وَالطَّوَافُ إِنْ شَائَ أَتَمَّ ، وَإِنْ شَائَ قَطَعَ۔",": Da'if","Musannaf Ibn Abi Shaybah 15585","","","كتاب الحج"
"15586","(۱۵۵۸۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ إسْمَاعِیلَ ، عَنِ الْحَسَنِ وَقَتَادَۃَ ، وَابْنِ سِیرِینَ فِی الرَّجُلِ یَفْتَتِحُ الطَّوَافَ تَطَوُّعًا ، ثُمَّ یَقْطَعُہُ ، قَالُوا : یَقْضِی طَوَافَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15586","","","كتاب الحج"
"15587","(۱۵۵۸۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا حَضَرَتْ صَلاَۃٌ مَکْتُوبَۃٌ وَأَنْتَ تَطُوفُ بِالْبَیْتِ فَاقْطَعْ طَوَافَک ، ثُمَّ صَلِّ ، ثُمَّ اقْضِ مَا بَقِیَ مِنْ طَوَافِک۔",": No Data Available","Musannaf Ibn Abi Shaybah 15587","","","كتاب الحج"
"15588","(۱۵۵۸۸) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوس ، وَمُجَاہِدٍ ، قَالُوا : إِنْ شِئْتَ فَاقْضِ مَا بَقِیَ ، وَإِنْ شِئْتَ فَاسْتَقْبِلْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15588","","","كتاب الحج"
"15589","(۱۵۵۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ حَنْظَلَۃَ ، عَنْ سَالِمٍ ، أَنَّہُ کَانَ یَطُوفُ بَیْنَ الصَّفَا وَالْمَرْوَۃِ فَأُقِیمَتِ الصَّلاَۃُ ، فَصَلَّی ، ثُمَّ رَجَعَ إلَی الصَّفَا وَالْمَرْوَۃِ فَأَتَمَّ مَا بَقِیَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15589","","","كتاب الحج"
"15590","(۱۵۵۹۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ شَیْخٍ مِنْ أَہْلِ مَکَّۃَ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ یَطُوفُ وَقَدْ أُقِیمَتِ الصَّلا??ۃُ فَدَخَلَ فِی الصَّلاَۃِ ، فَلَمَّا قَضَی الصَّلاَۃَ بَنَی عَلَی طَوَافِہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15590","","","كتاب الحج"
"15591","(۱۵۵۹۱) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ بَنَی عَلَی مَا بَقِیَ۔",": Da'if","Musannaf Ibn Abi Shaybah 15591","","","كتاب الحج"
"15592","(۱۵۵۹۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ رَجُلٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّہُ طَافَ خَمْسَۃَ أَشْوَاطٍ ، ثُمَّ أُقِیمَتِ الصَّلاَۃُ فَصَلَّی ، فَلَمَّا قَضَی صَلاَتَہُ بَنَی عَلَی مَا بَقِیَ مِنْ طَوَافِہِ ، وَصَلَّی رَکْعَتَیْنِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15592","","","كتاب الحج"
"15593","(۱۵۵۹۳) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ إبْرَاہِیمَ بْنِ إسْمَاعِیلَ بْنِ دِرْہمٍ ، قَالَ بَعَثَنِی مُجَاہِدٌ فِی حَاجَۃٍ وَأَنَا أَطُوفُ مَعَہُ بِالْبَیْتِ ، فَقُلْتُ لَہُ : إنِّی لَمْ أُتِمَّ طَوَافِی ، قَالَ : تَرْجِعُ فَتُتِمُّ۔","","Musannaf Ibn Abi Shaybah 15593","","","كتاب الحج"
"15594","(۱۵۵۹۴) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ تَعْرُضُ لَہُ الْحَاجَۃُ ، قَالَ : یَقْطَعُ طَوَافَہُ وَیَسْتَأْنِفُ۔","","Musannaf Ibn Abi Shaybah 15594","","","كتاب الحج"
"15595","(۱۵۵۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ طَاوُوسٍ ، أَنَّہُ کَانَ یَقْدُمُ عَرَفَۃَ فَیُعَارِضُ إلَی عَرَفَۃَ ، وَلاَ یَأْتِی الْبَیْتَ۔","","Musannaf Ibn Abi Shaybah 15595","","","كتاب الحج"
"15596","(۱۵۵۹۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ إسْمَاعِیلَ ، عَنِ الْحَسَنِ ، وَعَطَائٍ فِی الرَّجُلِ یَقْدُمُ مُفْرِدًا فَیَجِدُ النَّاسَ وُقُوفًا بِعَرَفَۃَ ، قَالاَ : یَقِفُ مَعَہُمْ ، فَإِذَا کَانَ یَوْمُ النَّحْرِ طَافَ طَوَافًا وَاحِدًا وَسَعَی بَیْنَ الصَّفَا وَالْمَرْوَۃِ ، فَأَجْزَأَہُ طَوَافُ الْقُدُومِ مِنْ طَوَافِ الزِّیَارَۃِ وَعَلَیْہِ طَوَافُ یَوْمِ النَّفْرِ حِینَ یُوَدِّعُ الْبَیْتَ۔","","Musannaf Ibn Abi Shaybah 15596","","","كتاب الحج"
"15597","(۱۵۵۹۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ أَبِی جَعْفَرٍ ، أَنَّہُ ، سُئِلَ عَنِ الَّذِی یَقْرِنُ ، قَالَ : أَحَبُّ إلَیَّ أَنْ یَسُوقَ الْہَدْیَ مِنْ حَیْثُ أَحْرَمَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15597","","","كتاب الحج"
"15598","(۱۵۵۹۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، أَنَّہُ سُئِلَ عَنْ رَجُلٍ قَرَنَ الْحَجَّ وَالْعُمْرَۃَ ، فَقَالَ : إِنْ شَائَ سَاقَ ، وَإِنْ شَائَ أَجْزَأَ عَنْہُ أَنْ یَبْتَاعَ مِنْ مَکَّۃَ شَاۃً۔","","Musannaf Ibn Abi Shaybah 15598","","","كتاب الحج"
"15599","(۱۵۵۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، أَنَّ شُرَیْحًا وَالْحُسَین بْنَ علِیٍّ قَرَنَا ، وَلَمْ یُہْدِیَا۔",": Hasan","Musannaf Ibn Abi Shaybah 15599","","","كتاب الحج"
"15600","(۱۵۶۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ فِطْرٍ ، عَنِ الْحَکَمِ ، قَالَ : مَا یُعْجِبُنِی القِرَانُ ، إِلاَّ أَنْ یَسُوقَ ، وَالْمُتَمَتِّعُ تُجْزِئُہُ شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 15600","","","كتاب الحج"
"15601","(۱۵۶۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ صَالِحٍ الْعُکْلِیِّ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ ، عَنِ القِرَانِ ، فَقَالَ : حَسَنٌ ، وبینہما مَا اسْتَیْسَرَا ، وَسَأَلْتُہُ ، عَنِ التَّمَتُّعِ ، فَقَالَ : حَسَنٌ ، وبینہما مَا اسْتَیْسَرَا ، وَسَأَلْتُہُ ، عَنِ التَّجْرِیدِ ، فَقَالَ : حَسَنٌ ، قُلْتُ : أَیُّہُا أَعْجَبُ إلَیْک ؟ قَالَ : التَّجْرِیدُ۔","","Musannaf Ibn Abi Shaybah 15601","","","كتاب الحج"
"15602","(۱۵۶۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ فِطْرٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : الْقَارِنُ وَالْمُتَمَتِّعُ تُجْزِئُہُمَا شَاۃٌ شَاۃٌ یَشْتَرِیَانِہِمَا مِنْ مَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 15602","","","كتاب الحج"
"15603","(۱۵۶۰۳) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ أَحَبُّ الأَشْیَائِ إلَیْہِ أَنْ یُحْرِمَ الْقَارِنُ إذَا سَاقَ ، وَإِنْ لَمْ یَسُقْ فَلاَ یُعْجِبُہُ۔","","Musannaf Ibn Abi Shaybah 15603","","","كتاب الحج"
"15604","(۱۵۶۰۴) حَدَّثَنَا حُمَیْدٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، قَالَ : حدَّثَنَا بَعْضُ أَصْحَابِنَا ، أَنَّہُ سَأَلَ جَابِرَ بْنَ عَبْدِ اللہِ ألہ أَنْ یَقْرِنَ بَیْنَ حَجَّۃٍ وَعُمْرَۃٍ بِغَیْرِ ہَدْیٍ ، فَقَالَ : مَا رَأَیْت أَحَدًا مِنَّا فَعَلَ ذَلِکَ۔",": Da'if","Musannaf Ibn Abi Shaybah 15604","","","كتاب الحج"
"15605","(۱۵۶۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ جَابِرِ عن عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، أَنَّہُ قَرَنَ وَاشْتَرَی ہَدْیَہُ مِنْ مَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 15605","","","كتاب الحج"
