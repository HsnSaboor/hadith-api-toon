hadiths[42]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"2441","حَدَّثَنَا مُوسَى بْنُ إِسْمَاعِيلَ ، حَدَّثَنَا هَمَّامٌ ، قَالَ : أَخْبَرَنِي قَتَادَةُ ، عَنْ صَف","Default: Sahih","Book 46"," Hadith 2","2441",""
"2442","حَدَّثَنَا يَحْيَى بْنُ بُكَيْرٍ ، حَدَّثَنَا اللَّيْثُ ، عَنْ عُقَيْلٍ ، عَنِ ابْنِ شِهَابٍ ، أَنَّ","Default: Sahih","Book 46"," Hadith 3","2442",""
"2443","حَدَّثَنَا عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا هُشَيْمٌ ، أَخْبَرَنَا عُبَيْدُ اللَّهِ بْنُ أ","Default: Sahih","Book 46"," Hadith 4","2443",""
"2444","حَدَّثَنَا مُسَدَّدٌ ، حَدَّثَنَا مُعْتَمِرٌ ، عَنْ حُمَيْدٍ ، عَنْ أَنَسٍ رَضِيَ اللَّهُ عَنْهُ ، ق","Default: Sahih","Book 46"," Hadith 5","2444",""
"2445","حَدَّثَنَا سَعِيدُ بْنُ الرَّبِيعِ ، حَدَّثَنَا شُعْبَةُ ، عَنِ الْأَشْعَثِ بْنِ سُلَيْمٍ ، قَالَ :","Default: Sahih","Book 46"," Hadith 6","2445",""
"2446","حَدَّثَنَا مُحَمَّدُ بْنُ الْعَلَاءِ ، حَدَّثَنَا أَبُو أُسَامَةَ ، عَنْ بُرَيْدٍ ، عَنْ أَبِي بُرْد","Default: Sahih","Book 46"," Hadith 7","2446",""
"2447","حَدَّثَنَا أَحْمَدُ بْنُ يُونُسَ ، حَدَّثَنَا عَبْدُ الْعَزِيزِ الْمَاجِشُونُ ، أَخْبَرَنَا عَبْدُ ا","Default: Sahih","takhreej: لقوله جل ذكره ‏ {‏ لا يحب الله الجهر بالسوء من القول إلا من ظلم وكان الله سميعا عليما‏}‏‏.‏ ‏ {‏ والذين إذا أصابهم البغى هم ينتصرون‏}‏‏.‏ قال إبراهيم كانوا يكرهون أن يستذلوا ،‏‏‏‏ ‏‏‏‏ فإذا قدروا عفوا‏.‏ لقوله تعالى ‏ {‏ إن تبدوا خيرا أو تخفوه أو تعفوا عن سوء فإن الله كان عفوا قديرا‏}‏ ‏ {‏ وجزاء سيئة سيئة مثلها فمن عفا وأصلح فأجره على الله إنه لا يحب الظالمين * ولمن انتصر بعد ظلمه فأولئك ما عليهم من سبيل * إنما السبيل على الذين يظلمون الناس ويبغون في الأرض بغير الحق أولئك لهم عذاب أليم * ولمن صبر وغفر إن ذلك لمن عزم الأمور‏}‏ ‏ {‏ وترى الظالمين لما رأوا العذاب يقولون هل إلى مرد من سبيل ‏}‏","2447","","Oppressions"
"2448","حَدَّثَنَا يَحْيَى بْنُ مُوسَى ، حَدَّثَنَا وَكِيعٌ ، حَدَّثَنَا زَكَرِيَّاءُ بْنُ إِسْحَاقَ الْمَكّ","Default: Sahih","Book 46"," Hadith 9","2448",""
"2449","حَدَّثَنَا آدَمُ بْنُ أَبِي إِيَاسٍ ، حَدَّثَنَا ابْنُ أَبِي ذِئْبٍ ، حَدَّثَنَا سَعِيدٌ الْمَقْبُرِ","Default: Sahih","Book 46"," Hadith 10","2449",""
"2450","حَدَّثَنَا مُحَمَّدٌ ، أَخْبَرَنَا عَبْدُ اللَّهِ ، أَخْبَرَنَا هِشَامُ بْنُ عُرْوَةَ ، عَنْ أَبِيهِ","Default: Sahih","Book 46"," Hadith 11","2450",""
"2451","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ ، أَخْبَرَنَا مَالِكٌ ، عَنْ أَبِي حَازِمِ بْنِ دِينَارٍ ، عَ","Default: Sahih","Book 46"," Hadith 12","2451",""
"2452","حَدَّثَنَا أَبُو الْيَمَانِ ، أَخْبَرَنَا شُعَيْبٌ ، عَنِ الزُّهْرِيِّ ، قَالَ : حَدَّثَنِي طَلْحَةُ","Default: Sahih","Book 46"," Hadith 13","2452",""
"2453","حَدَّثَنَا أَبُو مَعْمَرٍ ، حَدَّثَنَا عَبْدُ الْوَارِثِ ، حَدَّثَنَا حُسَيْنٌ ، عَنْ يَحْيَى بْنِ أ","Default: Sahih","Book 46"," Hadith 14","2453",""
"2454","حَدَّثَنَا مُسْلِمُ بْنُ إِبْرَاهِيمَ ، حَدَّثَنَا عَبْدُ اللَّهِ بْنُ الْمُبَارَكِ ، حَدَّثَنَا مُو","Default: Sahih","Book 46"," Hadith 15","2454",""
"2455","حَدَّثَنَا حَفْصُ بْنُ عُمَرَ ، حَدَّثَنَا شُعْبَةُ ، عَنْ جَبَلَةَ ، كُنَّا بِالْمَدِينَةِ فِي بَعْ","Default: Sahih","Book 46"," Hadith 16","2455",""
"2456","حَدَّثَنَا أَبُو النُّعْمَانِ ، حَدَّثَنَا أَبُو عَوَانَةَ ، عَنْ الْأَعْمَشِ ، عَنْ أَبِي وَائِلٍ ،","Default: Sahih","Book 46"," Hadith 17","2456",""
"2457","حَدَّثَنَا أَبُو عَاصِمٍ ، عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ أَبِي مُلَيْكَةَ ، عَنْ عَائِشَةَ رَضِيَ","Default: Sahih","Book 46"," Hadith 18","2457",""
"2458","حَدَّثَنَا عَبْدُ الْعَزِيزِ بْنُ عَبْدِ اللَّهِ ، قَالَ : حَدَّثَنِي إِبْرَاهِيمُ بْنُ سَعْدٍ ، عَن","Default: Sahih","Book 46"," Hadith 19","2458",""
"2459","حَدَّثَنَا بِشْرُ بْنُ خَالِدٍ ، أَخْبَرَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، عَنْ شُعْبَةَ ، عَنْ سُلَيْمَ","Default: Sahih","Book 46"," Hadith 20","2459",""
"2460","حَدَّثَنَا أَبُو الْيَمَانِ ، أَخْبَرَنَا شُعَيْبٌ ، عَنِ الزُّهْرِيِّ ، حَدَّثَنِي عُرْوَةُ ، أَنَّ","Default: Sahih","takhreej: وقال ابن سيرين يقاصه وقرأ ‏ {‏ وإن عاقبتم فعاقبوا بمثل ما عوقبتم به‏}‏","2460","","Oppressions"
"2461","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ ، حَدَّثَنَا اللَّيْثُ ، قَالَ : حَدَّثَنِي يَزِيدُ ، عَنْ أَ","Default: Sahih","Book 46"," Hadith 22","2461",""
"2462","حَدَّثَنَا يَحْيَى بْنُ سُلَيْمَانَ ، قَالَ : حَدَّثَنِي ابْنُ وَهْبٍ ، قَالَ : حَدَّثَنِي مَالِكٌ ،","Default: Sahih","takhreej: وجلس النبي صلى الله عليه وسلم وأصحابه في سقيفة بني ساعدة‏.‏","2462","","Oppressions"
"2463","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ ، عَنْ مَالِكٍ ، عَنِ ابْنِ شِهَابٍ ، عَنِ الْأَعْرَجِ ، ع","Default: Sahih","Book 46"," Hadith 24","2463",""
"2464","حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ أَبُو يَحْيَى ، أَخْبَرَنَا عَفَّانُ ، حَدَّثَنَا حَمَّا","Default: Sahih","Book 46"," Hadith 25","2464",""
"2465","حَدَّثَنَا مُعَاذُ بْنُ فَضَالَةَ ، حَدَّثَنَا أَبُو عُمَرَ حَفْصُ بْنُ مَيْسَرَةَ ، عَنْ زَيْدِ بْن","Default: Sahih","takhreej: وقالت عائشة فابتنى أبو بكر مسجدا بفناء داره ،‏‏‏‏ ‏‏‏‏ يصلي فيه ،‏‏‏‏ ‏‏‏‏ ويقرأ القرآن فيتقصف عليه نساء المشركين وأبناؤهم ،‏‏‏‏ ‏‏‏‏ يعجبون منه ،‏‏‏‏ ‏‏‏‏ والنبي صلى الله عليه وسلم يومئذ بمكة‏.‏","2465","","Oppressions"
"2466","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ ، عَنْ مَالِكٍ ، عَنْ سُمَيٍّ مَوْلَى أَبِي بَكْرٍ ، عَنْ","Default: Sahih","Book 46"," Hadith 27","2466",""
"2467","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مُحَمَّدٍ ، حَدَّثَنَا ابْنُ عُيَيْنَةَ ، عَنِ الزُّهْرِيِّ ، عَنْ عُ","Default: Sahih","takhreej: وقال همام عن أبي هريرة ـ رضى الله عنه ـ عن النبي صلى الله عليه وسلم ‏""‏ يميط الأذى عن الطريق صدقة ‏""‏‏.‏","2467","","Oppressions"
"2468","حَدَّثَنَا يَحْيَى بْنُ بُكَيْرٍ ، حَدَّثَنَا اللَّيْثُ ، عَنْ عُقَيْلٍ ، عَنِ ابْنِ شِهَابٍ ، قَالَ","Default: Sahih","Book 46"," Hadith 29","2468",""
"2469","حَدَّثَنَا ابْنُ سَلَامٍ ، حَدَّثَنَا الْفَزَارِيُّ ، عَنْ حُمَيْدٍ الطَّوِيلِ ، عَنْ أَنَسٍ رَضِيَ","Default: Sahih","Book 46"," Hadith 30","2469",""
"2470","حَدَّثَنَا مُسْلِمٌ ، حَدَّثَنَا أَبُو عَقِيلٍ ، حَدَّثَنَا أَبُو الْمُتَوَكِّلِ النَّاجِيُّ ، قَالَ","Default: Sahih","Book 46"," Hadith 31","2470",""
"2471","حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ ، عَنْ شُعْبَةَ ، عَنْ مَنْصُورٍ ، عَنْ أَبِي وَائِلٍ ، عَنْ حُذَ","Default: Sahih","Book 46"," Hadith 32","2471",""
"2472","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ ، أَخْبَرَنَا مَالِكٌ ، عَنْ سُمَيٍّ ، عَنْ أَبِي صَالِحٍ ، ع","Default: Sahih","Book 46"," Hadith 33","2472",""
"2473","حَدَّثَنَا مُوسَى بْنُ إِسْمَاعِيلَ ، حَدَّثَنَا جَرِيرُ بْنُ حَازِمٍ ، عَنْ الزُّبَيْرِ بْنِ خِرِّي","Default: Sahih","Book 46"," Hadith 34","2473",""
"2474","حَدَّثَنَا آدَمُ بْنُ أَبِي إِيَاسٍ ، حَدَّثَنَا شُعْبَةُ ، حَدَّثَنَا عَدِيُّ بْنُ ثَابِتٍ ، سَمِعْ","Default: Sahih","takhreej: وقال عبادة بايعنا النبي صلى الله عليه وسلم أن لا ننتهب‏.‏","2474","","Oppressions"
"2475","حَدَّثَنَا سَعِيدُ بْنُ عُفَيْرٍ ، قَالَ : حَدَّثَنِي اللَّيْثُ ، حَدَّثَنَا عُقَيْلٌ ، عَنِ ابْنِ ش","Default: Sahih","Book 46"," Hadith 36","2475",""
"2476","حَدَّثَنَا عَلِيُّ بْنُ عَبْدِ اللَّهِ ، حَدَّثَنَا سُفْيَانُ ، حَدَّثَنَا الزُّهْرِيُّ ، قَالَ : أَ","Default: Sahih","Book 46"," Hadith 37","2476",""
"2477","حَدَّثَنَا أَبُو عَاصِمٍ الضَّحَّاكُ بْنُ مَخْلَدٍ ، عَنْ يَزِيدَ بْنِ أَبِي عُبَيْدٍ ، عَنْ سَلَمَة","Default: Sahih","takhreej: فإن كسر صنما ،‏‏‏‏ ‏‏‏‏ أو صليبا ،‏‏‏‏ ‏‏‏‏ أو طنبورا ،‏‏‏‏ ‏‏‏‏ أو ما لا ينتفع بخشبه. وأتي شريح في طنبور كسر ،‏‏‏‏ ‏‏‏‏ فلم يقض فيه بشيء.","2477","","Oppressions"
"2478","حَدَّثَنَا عَلِيُّ بْنُ عَبْدِ اللَّهِ ، حَدَّثَنَا سُفْيَانُ ، حَدَّثَنَا ابْنُ أَبِي نَجِيحٍ ، عَن","Default: Sahih","Book 46"," Hadith 39","2478",""
"2479","حَدَّثَنَا إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ، حَدَّثَنَا أَنَسُ بْنُ عِيَاضٍ ، عَنْ عُبَيْدِ اللَّهِ بْ","Default: Sahih","Book 46"," Hadith 40","2479",""
"2480","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يَزِيدَ ، حَدَّثَنَا سَعِيدٌ هُوَ ابْنُ أَبِي أَيُّوبَ ، قَالَ : حَدّ","Default: Sahih","Book 46"," Hadith 41","2480",""
"2481","حَدَّثَنَا مُسَدَّدٌ ، حَدَّثَنَا يَحْيَى بْنُ سَعِيدٍ ، عَنْ حُمَيْدٍ ، عَنْ أَنَسٍ رَضِيَ اللَّهُ","Default: Sahih","Book 46"," Hadith 42","2481",""
"2482","حَدَّثَنَا مُسْلِمُ بْنُ إِبْرَاهِيمَ ، حَدَّثَنَا جَرِيرُ بْنُ حَازِمٍ ، عَنْ مُحَمَّدِ بْنِ سِيرِي","Default: Sahih","Book 46"," Hadith 43","2482",""
