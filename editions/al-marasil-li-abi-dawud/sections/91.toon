hadiths[9]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"458","91 - بَابُ [مَا جَاءَ]  فِي الْأَطْعِمَةِ  459  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ ثَوْرٍ ،  عَنْ  مَعْمَرٍ ، قَالَ :  قُلْتُ  لِلزُّهْرِيِّ :  مَا بَالُ الْأَعْمَى ذُكِرَ هَاهُنَا وَالْأَعْرَجِ وَالْمَرِيضِ  ، [فَحَدَّثَهُمْ عَمِّي]  عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ أَنَّ الْمُسْلِمِينَ كَانُوا إِذَا غَزَوْا         [1/324]      خَلَّفُوا زَمْنَاهُمْ ، وَكَانُوا يَدْفَعُونَ إِلَيْهِمْ مَفَاتِيحَ أَبْوَابِهِمْ ، وَيَقُولُونَ : قَدْ أَحْلَلْنَا لَكُمْ أَنْ تَأْكُلُوا مِمَّا فِي بُيُوتِنَا ، فَكَانُوا يَتَحَرَّجُونَ مِنْ ذَلِكَ ، يَقُولُونَ  : لَا نَدْخُلُهَا وَهُمْ غُيَّبٌ ، فَأُنْزِلَتْ هَذِهِ الْآيَةُ رُخْصَةً لَهُمْ  ( 16502 ) .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: فحدثني عن .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: ويقولون .","","Al-Marasil li-Abi Dawud 459","","عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن معمر بن راشد عن محمد بن ثور الصنعاني عن محمد بن عبيد بن حساب الغبري عن أبو داود السجستاني","باب ما جاء في الأطعمة"
"459","460  -  حَدَّثَنَا  حَجَّاجُ بْنُ أَبِي يَعْقُوبَ ،  حَدَّثَنَا  يَعْقُوبُ - يَعْنِي ابْنَ إِبْرَاهِيمَ -  حَدَّثَنِي  أَبِي  ،  عَنْ  صَالِحٍ .  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ، وَابْنِ الْمُسَيِّبِ ،  أَنَّهُ كَانَ رِجَالٌ مِنْ أَهْلِ الْعِلْمِ يُحَدِّثُونَ أَنَّمَا  أُنْزِلَتْ هَذِهِ الْآيَةُ :         {      لَيْسَ عَلَى الأَعْمَى حَرَجٌ         }      أَنَّ الْمُسْلِمِينَ كَانُوا يَرْغَبُونَ  -  يَعْنِي فِي النَّفِيرِ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - فِي  سَبِيلِ  اللهِ فَيُعْطُونَ مَفَاتِيحَهُمْ  ضَمْنَاهُمْ  ، وَيَقُولُونَ لَهُمْ : قَدْ أَحْلَلْنَا لَكُمْ  ، [ثُمَّ ذَكَرَ]  نَحْوَهُ وَأَتَمَّ مِنْهُ  ( 16502 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: نا .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: حدثني .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: الآية .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: يوعبون .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: فذكر .","","Al-Marasil li-Abi Dawud 460","","رجال من أهل العلم عن سعيد بن المسيب عن الزهري عن صالح بن كيسان الدوسي عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن حجاج يوسف الثقفي عن أبو داود السجستاني","باب ما جاء في الأطعمة"
"460","461  -  حَدَّثَنَا  زَيْدُ بْنُ أَخْزَمَ ،  حَدَّثَنَا  بِشْرُ بْنُ عُمَرَ ،  أَخْبَرَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  عَنِ  الزُّهْرِيِّ .         [1/325]      عَنْ  عَائِشَةَ  ، قَالَتْ :  [كَانَ الْمُسْلِمُونَ]  يَرْغَبُونَ  فَذَكَرَ نَحْوَهُ  ( 16502 ) .  قَالَ أَبُو دَاوُدَ :  وَالصَّحِيحُ  حَدِيثُ  يَعْقُوبَ  وَمَعْمَرٍ  .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: عن عروة عن عائشة .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: كان - يعني المسلمين .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: يوعبون .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: الصحيح .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: وهذا وهم .","","Al-Marasil li-Abi Dawud 461","","عائشة بنت أبي بكر الصديق عن الزهري عن صالح بن كيسان الدوسي عن إبراهيم بن سعد أبو إسحاق الزهري عن بشر بن عمر الزهراني عن زيد بن أخزم الطائي عن أبو داود السجستاني","باب ما جاء في الأطعمة"
"461","462  -  حَدَّثَنَا  ابْنُ الْمُصَفَّى ،  حَدَّثَنَا  بَقِيَّةُ ،  حَدَّثَنَا  ابْنُ ثَوْبَانَ .  عَنْ  أَبِيهِ  ،  سَأَلْتُ  مَكْحُولًا :  مَنْ أَحَقُّ النَّاسِ أَنْ يَؤُمَّهُمْ فِي الطَّعَامِ  ؟  قَالَ  مَكْحُولٌ  : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : الْإِمَامُ أَوْ رَبُّ الطَّعَامِ أَوْ خَيْرُهُمْ ، ثُمَّ قَالَ : مُدَّ يَدَكَ يَا  أَبَا عُبَيْدَةَ  ( 19461 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قال سألت .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: فقال .","","Al-Marasil li-Abi Dawud 462","","مكحول بن أبي مسلم عن ثابت بن ثوبان العبسي عن عبد الرحمن بن ثابت العنسي عن بقية بن الوليد عن محمد بن مصفى بن بهلول عن أبو داود السجستاني","باب ما جاء في الأطعمة"
"462","463  -  حَدَّثَنَا  مَحْمُودُ بْنُ خَالِدٍ ،  حَدَّثَنَا  الْوَلِيدُ ،  عَنْ  أَبِي عَمْرٍو .  حَدَّثَنِي  ثَابِتُ بْنُ ثَوْبَانَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ [بِمَعْنَاهُ ، قَالَ : ]  فَيَرَوْنَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمَئِذٍ كَانَ صَائِمًا  ( 19461 )  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: ""يؤم الناس ... "" بمعناه .","","Al-Marasil li-Abi Dawud 463","","ثابت بن ثوبان العبسي عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن محمود بن خالد بن أبي خالد السلمي عن أبو داود السجستاني","باب ما جاء في الأطعمة"
"463","464  - -  حَدَّثَنَا  إِسْحَاقُ بْنُ سُوَيْدٍ الرَّمْلِيُّ ،  حَدَّثَنَا  سَوَّارُ بْنُ عُمَارَةَ ،  حَدَّثَنِي  مَسَرَّةُ - يَعْنِي ابْنَ مَعْبَدٍ - .  [قَالَ : ]  حَدَّثَنِي  الزُّهْرِيُّ ، وَسُلَيْمَانُ بْنُ مُوسَى ، [قَالَا : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ]  :         [1/326]      لَا تَأْكُلُوا اللَّحْمَ  النِّيءَ  حَتَّى يَخْلُوَ  لَهُ ثَلَاثٌ ، أَوْ يَمَسَّهُ  النَّارُ  ( 18789 ) ( 19375 ) .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: أن رسول الله صلى الله عليه وسلم قال .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: تخلو .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: تمسه .","","Al-Marasil li-Abi Dawud 464","","سليمان بن موسى الأشدق عن مسرة بن معبد اللخمي عن سوار بن عمارة الربعي عن إسحاق بن إبراهيم البلوي عن أبو داود السجستاني","باب ما جاء في الأطعمة"
"464","465  -  حَدَّثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  [حَدَّثَنِي  عَبْدُ اللهِ بْنُ الْمُبَارَكِ]  ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  وَاصِلِ بْنِ أَبِي جَمِيلٍ .  عَنْ  مُجَاهِدٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَرِهَ مِنَ الشَّاةِ سَبْعًا  : الْمَثَانَةَ وَالْمَرَارَةَ وَالْغُدَّةَ وَالذَّكَرَ  وَالْحَيَاءَ  وَالْأُنْثَيَيْنِ  ( 19278 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: حدثني ابن المبارك .","","Al-Marasil li-Abi Dawud 465","","مجاهد بن جبر المخزومي عن واصل بن أبي جميل السلاماني عن أبو عمرو الأوزاعي عن عبد الله بن المبارك عن أحمد بن عبد الله اليربوعي عن أبو داود السجستاني","باب ما جاء في الأطعمة"
"465","466  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مَرْوَانَ بْنِ مُحَمَّدٍ الدِّمَشْقِيُّ ،  حَدَّثَنَا  أَبِي  ،  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  حَدَّثَنِي  عُمَرُ بْنُ مُحَمَّدٍ - [يَعْنِي]  الْعُمَرِيَّ - .  عَنْ  أَبِيهِ  ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَا يَأْكُلُ الْوَرِكَ  ، وَيَقُولُ : إِنَّ ظَاهِرَهَا نَسًا ، وَبَاطِنَهَا شَلًا  ( 19288 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قال نا .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قال نا .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قال نا .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .","","Al-Marasil li-Abi Dawud 466","","محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن محمد بن شعيب بن شابور القرشي عن مروان بن محمد الطاطري عن إبراهيم بن مروان الطاطري عن أبو داود السجستاني","باب ما جاء في الأطعمة"
"466","467  -  حَدَّثَنَا  مُسَدَّدٌ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَحْيَى بْنِ أَبِي كَثِيرٍ ،  [حَدَّثَنَا]         [1/327]      عَنْ  أَبِيهِ  ،  [عَنْ  رَجُلٍ]  مِنَ الْأَنْصَارِ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ أَكْلِ أُذُنَيِ الْقَلْبِ  ( 19619 ) .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قال حدثني رجل .","","Al-Marasil li-Abi Dawud 467","","رجل من الأنصار عن يحيى بن أبي كثير عن عبد الله بن يحيى بن أبي كثير اليمامي عن مسدد بن مسرهد عن أبو داود السجستاني","باب ما جاء في الأطعمة"
