hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"18037","(۱۸۰۳۷) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ ہِشَامِ بْنِ حُجَیْرٍ ، عَنْ طَاوُوسٍ قَالَ : طَلاَقُ السُّنَّۃِ أَنْ یُطَلِّقَ الرَّجُلُ امْرَأَتَہُ طَاہِرًا فِی غَیْرِ جِمَاعٍ ، ثُمَّ یَدَعَہَا حَتَّی تَنْقَضِیَ عِدَّتُہَا۔","","Musannaf Ibn Abi Shaybah 18037","","","كتاب الجنة"
"18038","(۱۸۰۳۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ الْحَذَّائِ ، عَنْ أَبِی قِلاَبَۃَ ؛ أَنَّہُ کَانَ یَقُولُ فِی طَلاَقِ السُّنَّۃِ : أَنْ یُطَلِّقَہَا وَاحِدَۃً ، ثُمَّ یَدَعَہَا حَتَّی تَبِینَ بِہَا۔","","Musannaf Ibn Abi Shaybah 18038","","","كتاب الجنة"
"18039","(۱۸۰۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ یَحْیَی بْنِ عَتِیقٍ ، عَنِ ابْنِ سِیرِینَ قَالَ : قَالَ عَلِیٌّ : لَوْ أَنَّ النَّاسَ أَصَابُوا حَدَّ الطَّلاَقِ ، مَا نَدِمَ رَجُلٌ عَلَی امْرَأَۃٍ ، یُطَلِّقُہَا وَاحِدَۃً ، ثُمَّ یَتْرُکُہَا حَتَّی تَحِیضَ ثَلاَثَ حِیَضٍ۔","","Musannaf Ibn Abi Shaybah 18039","","","كتاب الجنة"
"18040","(۱۸۰۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : کَانُوا یَسْتَحِبُّونَ أَنْ یُطَلِّقَہَا وَاحِدَۃً ، ثُمَّ یَتْرُکَہَا حَتَّی تَحِیضَ ثَلاَثَ حِیَضٍ۔","","Musannaf Ibn Abi Shaybah 18040","","","كتاب الجنة"
"18041","(۱۸۰۴۱) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٌ ؛ فِی طَلاَقِ السُّنَّۃِ قَالاَ : یُطَلِّقُ الرَّجُلُ امْرَأَتَہُ ، ثُمَّ یَدَعَہَا حَتَّی تَنْقَضِیَ عِدَّتُہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 18041","","","كتاب الجنة"
"18042","(۱۸۰۴۲) حَدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ ، عَنْ عَبْدِ الْحَکِیمِ بْنِ أَبِی فَرْوَۃَ ، قَالَ : سَمِعْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَقُولُ : مَا بَالُ رِجَالٍ یَقُولُ أَحَدُہُمْ لاِمْرَأَتِہِ : اذْہَبِی إلَی أَہْلِکِ ، فَیُطَلِّقُہَا فِی أَہْلِہَا ، فَنَہَی عَنْ ذَلِکَ أَشَدَّ النَّہْیِ ، قَالَ عَبْدُ الْحَکِیمِ : یَعْنِی بِذَلِکَ الْعِدَّۃَ۔","","Musannaf Ibn Abi Shaybah 18042","","","كتاب الجنة"
"18043","(۱۸۰۴۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ قَالَ : سُئِلَ جَابِرٌ عَنْ حَامِلٍ کَیْفَ تُطْلَقُ ؟ فَقَالَ : یُطَلِّقُہَا وَاحِدَۃً ، ثُمَّ یَدَعُہَا حَتَّی تَضَعَ۔","","Musannaf Ibn Abi Shaybah 18043","","","كتاب الجنة"
"18044","(۱۸۰۴۴) حَدَّثَنَا أَبُو بَکْرٍ الْحَنَفِیُّ ، عَنِ ابْنِ أَبِی ذِئْبٍ قَالَ : سَأَلْتُ عَنْ ذَلِکَ الزُّہْرِیَّ ؟ فَقَالَ : کُلُّ ذَلِکَ لَہَا وَقْتٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 18044","","","كتاب الجنة"
"18045","(۱۸۰۴۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ قَالاَ : إذَا کَانَتْ حَامِلاً طَلَّقَہَا مَتَی شَائَ۔","","Musannaf Ibn Abi Shaybah 18045","","","كتاب الجنة"
"18046","(۱۸۰۴۶) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ حَمَّادٍ قَالَ: کَانَ یَسْتَحِبُّ أَنْ یُطَلِّقَ الْحَامِلَ وَاحِدَۃً، ثُمَّ یَدَعَہَا حَتَّی تَضَعَ۔","No Data Available","Musannaf Ibn Abi Shaybah 18046","","","كتاب الجنة"
"18047","(۱۸۰۴۷) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ أَشْعَثَ ، عَنْ عَامِرٍ قَالَ : تُطْلَقُ الْحَامِلُ بِالأَہِلَّۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 18047","","","كتاب الجنة"
"18048","(۱۸۰۴۸) حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، عَنْ مَعْمَرٍ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ قَالَ : إذَا طَلَّقَ الرَّجُلُ امْرَأَتَہُ وَہِیَ حَائِضٌ ، فَلاَ تَعْتَدُّ بِہَا ، وَقَالَ الزُّہْرِیُّ وَقَتَادَۃُ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 18048","","","كتاب الجنة"
"18049","(۱۸۰۴۹) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ فِی الَّذِی یُطَلِّقُ امْرَأَتَہُ وَہِیَ حَائِضٌ ، قَالَ : لاَ تَعْتَدُّ بِتِلْکَ الْحَیْضَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 18049","","","كتاب الجنة"
"18050","(۱۸۰۵۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ قَالَ : إذَا طَلَّقَ الرَّجُلُ امْرَأَتَہُ وَہِیَ حَائِضٌ ، لَمْ تَعْتَدَّ بِتِلْکَ الْحَیْضَۃِ۔","","Musannaf Ibn Abi Shaybah 18050","","","كتاب الجنة"
"18051","(۱۸۰۵۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ لَیْثٍ، عَنْ طَاوُوسٍ قَالَ: إذَا طَلَّقَ الرَّجُلُ امْرَأَتَہُ وَہِیَ حَائِضٌ، لَمْ تَعْتَدَّ بِتِلْکَ الْحَیْضَۃِ۔","","Musannaf Ibn Abi Shaybah 18051","","","كتاب الجنة"
"18052","(۱۸۰۵۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ قَالَ : لاَ تَعْتَدُّ بِہَا","","Musannaf Ibn Abi Shaybah 18052","","","كتاب الجنة"
"18053","(۱۸۰۵۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، وَعَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : لاَ تَعْتَدُّ بِہَا۔","","Musannaf Ibn Abi Shaybah 18053","","","كتاب الجنة"
"18054","(۱۸۰۵۴) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ قَالَ : لاَ تَعْتَدُّ بِہَا۔","","Musannaf Ibn Abi Shaybah 18054","","","كتاب الجنة"
"18055","(۱۸۰۵۵) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ جَابِرٍ، عَنْ عَامِرٍ قَالَ: إذَا طَلَّقَہَا وَہِیَ حَائِضٌ، لَمْ تَعْتَدَّ بِتِلْکَ الْحَیْضَۃِ۔","","Musannaf Ibn Abi Shaybah 18055","","","كتاب الجنة"
"18056","(۱۸۰۵۶) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یُطَلِّقُ امْرَأَتَہُ سَاعَۃَ حَاضَتْ ، قَالَ : لاَ تَعْتَدُّ بِہَا۔","","Musannaf Ibn Abi Shaybah 18056","","","كتاب الجنة"
"18057","(۱۸۰۵۷) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ ہَمَّامٍ ، عَنْ مَالِکِ بْنِ دِینَارٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ قَالَ : لاَ تَعْتَدُّ بِتِلْکَ الْحَیْضَۃِ۔","","Musannaf Ibn Abi Shaybah 18057","","","كتاب الجنة"
"18058","(۱۸۰۵۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ ہَمَّامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدٍ ، وَخِلاَسٍ قَالاَ : لاَ تَعْتَدُّ بِتِلْکَ الْحَیْضَۃِ۔","","Musannaf Ibn Abi Shaybah 18058","","","كتاب الجنة"
"18059","(۱۸۰۵۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حُمَیْدِ بْنِ الأَسْوَدِ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ قَالَ : لاَ تَعْتَدُّ بِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 18059","","","كتاب الجنة"
"18060","(۱۸۰۶۰) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : ہُوَ قُرْئٌ مِنْ أَقْرَائِہَا۔","","Musannaf Ibn Abi Shaybah 18060","","","كتاب الجنة"
"18061","(۱۸۰۶۱) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : کَانَ یَقُولُ : تَعْتَدُّ بِتِلْکَ الْحَیْضَۃِ۔","","Musannaf Ibn Abi Shaybah 18061","","","كتاب الجنة"
"18062","(۱۸۰۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، قَالَ : قُلْتُ لابْنِ عُمَرَ : احْتَسَبْتَ بِہَا ؟ قَالَ : فَقَالَ : فَمَہْ ، یَعْنِی بِالتَّطْلِیقَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 18062","","","كتاب الجنة"
"18063","(۱۸۰۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ یُونُسَ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ طَلَّقَ امْرَأَتَہُ وَہِیَ حَائِضٌ ، فَقِیلَ لَہُ : احْتَسَبْتَ بِہَا ؟ یَعْنِی التَّطْلِیقَۃَ ، قَالَ : فَقَالَ : فَمَا یَمْنَعُنِی إِنْ کُنْتُ عَجَزْتُ وَاسْتَحْمَقْتُ ؟۔","Sahih","Musannaf Ibn Abi Shaybah 18063","","","كتاب الجنة"
"18064","(۱۸۰۶۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنِ الأَعْمَشِِ، عَنْ أَبِی إِسْحَاقَ، عَنْ أَبِی الأَحْوَصِ، عَنْ عَبْدِاللہِ قَالَ: إذَا أَرَادَ الرَّجُلُ أَنْ یُطَلِّقَہَا ثَلاَثًا لِلسُّنَّۃِ ، طَلَّقَہَا عِنْدَ کُلِّ طُہْرٍ وَاحِدَۃً ، وَتَعْتَدُّ بِحَیْضَۃٍ أُخْرَی عِنْدَ آخِرِ طَلاَقِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 18064","","","كتاب الجنة"
"18065","(۱۸۰۶۵) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، قَالَ : عَلَیْہَا حَیْضَۃٌ أُخْرَی بَعْدَ آخِرِ تَطْلِیقَۃٍ۔","","Musannaf Ibn Abi Shaybah 18065","","","كتاب الجنة"
"18066","(۱۸۰۶۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یُطَلِّقَ امْرَأَتَہُ عِنْدَ کُلِّ حَیْضَۃٍ ، وَإِنَّمَا یَفْعَلُ ذَلِکَ لِیُطَوِّلَ عَلَیْہَا ، فَإِذَا فَعَلَ ذَلِکَ ، فَعِدَّتُہَا مِنْ أَوَّلِ الْعِدَّۃِ مَا لَمْ یُرَاجِعْہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 18066","","","كتاب الجنة"
"18067","(۱۸۰۶۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ : إذَا طَلَّقَ الرَّجُلُ امْرَأَتَہُ فَمَکَثَتْ شَہْرًا ، ثُمَّ طَلَّقَہَا تَطْلِیقَۃً أُخْرَی ، فَإِنَّ عِدَّتَہَا مِنْ أَوَّلِ الطَّلاَقِ مَا لَمْ یُرَاجِعْہَا۔","","Musannaf Ibn Abi Shaybah 18067","","","كتاب الجنة"
"18068","(۱۸۰۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی الرَّجُلِ یُطَلِّقُ امْرَأَتَہُ عِنْدَ کُلِّ حَیْضَۃٍ تَطْلِیقَۃً ، قَالَ : تَعْتَدُّ مِنْ أَوَّلِ طَلاَقِہَا ، مَا لَمْ تَکُنْ مُرَاجَعَۃً۔","","Musannaf Ibn Abi Shaybah 18068","","","كتاب الجنة"
"18069","(۱۸۰۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، وَخَیْثَمَۃَ ؛ أَنَّہُمَا قَالاَ : کُلَّمَا حَاضَتْ وَقَعَتْ تَطْلِیقَۃٌ ، وَتَعْتَدُّ حَیْضَۃً أُخْرَی بَعْدَ الثَّلاَثِ ۔ قَالَ وَکِیعٌ : وَالنَّاسُ عَلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 18069","","","كتاب الجنة"
"18070","(۱۸۰۷۰) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، وَخِلاَسِ بْنِ عَمْرٍو ، أَنَّہُمَا قَالاَ : تَعْتَدُّ مِنْ آخِرِ طَلاَقِہَا ۔ قَالَ سَعِیدُ بْنُ الْمُسَیَّبِ : وَلاَ یُعْجِبُنَا ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 18070","","","كتاب الجنة"
"18071","(۱۸۰۷۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ، عَنْ عُبَیْدِ اللہِ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ أَشْہَدَ عَلَی رَجْعَۃِ صَفِیَّۃَ حِینَ رَاجَعَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 18071","","","كتاب الجنة"
"18072","(۱۸۰۷۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَہُ ثُمَّ رَاجَعَہَا ، فَیَجْہَلُ أَنْ یُشْہِدَ ؟ قَالَ : یُشْہِدُ إذَا عَلِمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 18072","","","كتاب الجنة"
"18073","(۱۸۰۷۳) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ عَامِرٍ ؛ فِی الرَّجُلِ یُطَلِّقُ امْرَأَتَہُ ثُمَّ یُجَامِعُہَا قَبْلَ أَنْ یُشْہِدَ عَلَی رَجْعَتِہَا ، قَالَ : کَیْفَ تَقُولُ یَا مُغِیرَۃُ فِی رَجُلٍ فَعَلَ بِامْرَأَۃِ قَوْمٍ لَیْسَ مِنْہَا بِسَبِیلٍ ؟۔","No Data Available","Musannaf Ibn Abi Shaybah 18073","","","كتاب الجنة"
"18074","(۱۸۰۷۴) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنْ خَالِدٍ النِّیْلِی ، عَنْ أَبِی مَعْشَرٍ، عَنْ إبْرَاہِیمَ؛ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ فَأَشْہَدَ، ثُمَّ رَاجَعَہَا وَلَمْ یُشْہِدْ ، قَالَ : لَمْ یَکُنْ یُکْرَہُ ذَلِکَ تَأَثُّمًا ، وَلَکِنْ کَانَ یُخَافُ أَنْ یَجْحَدَ۔","","Musannaf Ibn Abi Shaybah 18074","","","كتاب الجنة"
"18075","(۱۸۰۷۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یُطَلِّقُ امْرَأَتَہُ ثُمَّ یَغْشَاہَا وَلَمْ یُشْہِدْ ، قَالَ : غِشْیَانُہُ لَہَا مُرَاجَعَۃٌ ، فَلْیُشْہِدْ۔","","Musannaf Ibn Abi Shaybah 18075","","","كتاب الجنة"
"18076","(۱۸۰۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ (ح) وَعَنْ سَلَیْمَانَ التَّیْمِیِّ ، عَنْ طَاوُوسٍ ، قَالُوا : الْجِمَاعُ رَجْعَۃٌ فَلْیُشْہِدْ۔","No Data Available","Musannaf Ibn Abi Shaybah 18076","","","كتاب الجنة"
"18077","(۱۸۰۷۷) حَدَّثَنَا یَحْیَی بْنُ عَبْدِ الْمَلِکِ بْنِ أَبِی غَنِیَّۃَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ؛ فِی قَوْلِہِ : {وَأَشْہِدُوا ذَوَیْ عَدْلٍ مِنْکُمْ} قَالَ : أُمِرُوا أَنْ یُشْہِدُوا عِنْدَ الطَّلاَقِ وَالرَّجْعَۃِ۔","","Musannaf Ibn Abi Shaybah 18077","","","كتاب الجنة"
"18078","(۱۸۰۷۸) حَدَّثَنَا ابْنُ أَبِی غَنِیَّۃَ، عَنْ أَبِیہِ، عَنِ الْحَکَمِ؛ فِی رَجُلٍ یُرَاجِعُ امْرَأَتَہُ وَلاَ یُشْہِدُ، قَالَ: فَلْیُشْہِدْ عَلَی رَجْعَتِہَا۔","","Musannaf Ibn Abi Shaybah 18078","","","كتاب الجنة"
"18079","(۱۸۰۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : الْفُرْقَۃُ وَالرَّجْعَۃُ بِالشُّہُودِ۔","","Musannaf Ibn Abi Shaybah 18079","","","كتاب الجنة"
"18080","(۱۸۰۸۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ؛ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ ، فَحَنَثَ وَقَدْ غَشِیَہَا فِی عِدَّتِہَا ، وَقَدْ عَلِمَ بِذَلِکَ بَعْدَ انْقِضَائِ الْعِدَّۃِ ، قَالَ : غِشْیَانُہُ لَہَا مُرَاجَعَۃٌ۔","","Musannaf Ibn Abi Shaybah 18080","","","كتاب الجنة"
"18081","(۱۸۰۸۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ مِثل ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 18081","","","كتاب الجنة"
"18082","(۱۸۰۸۲) حدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ طَلَّقَ وَلَمْ یُشْہِدْ ، وَرَاجَعَ وَلَمْ یُشْہِدْ ؟ فَقَالَ : طَلَّقَ فِی غَیْرِ عِدَّۃٍ ، وَرَاجَعَ فِی غَیْرِ سُنَّۃٍ ، لِیُشْہِدْ عَلَی مَا صَنَعَ۔","Sahih","Musannaf Ibn Abi Shaybah 18082","","","كتاب الجنة"
"18083","(۱۸۰۸۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ : أَنَّہَا وَاحِدَۃٌ بَائِنَۃٌ ۔ وَہُوَ قَوْلُ قَتَادَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 18083","","","كتاب الجنة"
"18084","(۱۸۰۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ أَبِی الشَّعْثَائِ قَالَ : إذَا رَاجَعَ فِی نَفْسِہِ فَلَیْسَ بِشَیْئٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 18084","","","كتاب الجنة"
"18085","(۱۸۰۸۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ قَالَ : سُئِلَ عَنْ رَجُلٍ قَالَ لامْرَأَتِہِ : إِنْ دَخَلْتِ دَارَ فُلاَنٍ فَأَنْتِ طَالِقٌ ، فَدَخَلَتْ وَہُوَ لاَ یَشْعُرُ ، حَتَّی مَضَی لِذَلِکَ أَشْہُرٌ ؟ فَحَدَّثَنَا عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، وَسَعِیدٍ ، وَخِلاَسٍ قَالُوا : إذَا عَلِمَ أَشْہَدَ عَلَی مُرَاجَعَتِہَا۔","","Musannaf Ibn Abi Shaybah 18085","","","كتاب الجنة"
"18086","(۱۸۰۸۶) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ قَالَ : إِنْ دَخَلْتِ دَارَ فُلاَنٍ فَأَنْتِ طَالِقٌ وَاحِدَۃً، فَدَخَلَتْ وَہُوَ لاَ یَشْعُرُ ، قَالَ: إِنْ کَانَ غَشِیَہَا فِی الْعِدَّۃِ فَغِشْیَانُہُ لَہَا مُرَاجَعَۃٌ ، وَإِلاَّ فَقَدْ بَانَتْ مِنْہُ بِوَاحِدَۃٍ۔","","Musannaf Ibn Abi Shaybah 18086","","","كتاب الجنة"
"18087","(۱۸۰۸۷) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ وَاقِعِ بْنِ سَحْبَانَ قَالَ : سُئِلَ عِمْرَانُ بْنُ حُصَیْنٍ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَہُ ثَلاَثًا فِی مَجْلِسٍ ؟ قَالَ : أَثِمَ بِرَبِّہِ ، وَحُرِّمَتْ عَلَیْہِ امْرَأَتُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 18087","","","كتاب الجنة"
"18088","(۱۸۰۸۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِِ ، عَنْ مَالِکِ بْنِ الْحَارِثِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَتَاہُ رَجُلٌ فَقَالَ : إنَّ عَمِّی طَلَّقَ امْرَأَتَہُ ثَلاَثًا ، فَقَالَ : إنَّ عَمَّک عَصَی اللَّہَ ، فَأَنْدَمَہُ اللَّہُ ، فَلَمْ یَجْعَلْ لَہُ مَخْرَجًا۔","Sahih","Musannaf Ibn Abi Shaybah 18088","","","كتاب الجنة"
"18089","(۱۸۰۸۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ شَقِیقِ بْنِ أَبِی عَبْدِ اللہِ ، عَنْ أَنَسٍ قَالَ : کَانَ عُمَرُ إذَا أُتِیَ بِرَجُلٍ قَدْ طَلَّقَ امْرَأَتَہُ ثَلاَثًا فِی مَجْلِسٍ ، أَوْجَعَہُ ضَرْبًا ، وَفَرَّقَ بَیْنَہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 18089","","","كتاب الجنة"
"18090","(۱۸۰۹۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : قُلْتُ لِلْقَاسِمِ بْنِ مُحَمَّدٍ : الرَّجُلُ یُرِیدُ أَنْ یُطَلِّقَ امْرَأَتَہُ ثَلاَثًا ؟ قَالَ : یُطَلِّقُہَا فِی مَقَاعِدَ مُخْتَلِفَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 18090","","","كتاب الجنة"
"18091","(۱۸۰۹۱) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ أَشْعَثَ ، عَنْ نَافِعٍ قَالَ : قَالَ ابْنُ عُمَرَ : مَنْ طَلَّقَ امْرَأَتَہُ ثَلاَثًا ، فَقَدْ عَصَی رَبَّہُ ، وَبَانَتْ مِنْہُ امْرَأَتُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 18091","","","كتاب الجنة"
"18092","(۱۸۰۹۲) حَدَّثَنَا عَبْدُ الأَعْلَیْ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ فِی رَجُلٍ یُطَلِّقَ امْرَأَتَہُ ثَلاَثًا جَمِیعًا ، قَالَ : إنَّ فَعَلَ فَقَدْ عَصَی رَبَّہُ ، وَبَانَتْ مِنْہُ امْرَأَتُہُ۔","","Musannaf Ibn Abi Shaybah 18092","","","كتاب الجنة"
"18093","(۱۸۰۹۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانُوا یُنَکِّلُونَ مَنْ طَلَّقَ ثَلاَثًا فِی مَقْعَدٍ وَاحِدٍ۔","","Musannaf Ibn Abi Shaybah 18093","","","كتاب الجنة"
"18094","(۱۸۰۹۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ قَالَ : سُئِلَ مُحَمَّدٌ عَنِ الرَّجُلِ یُطَلِّقُ امْرَأَتَہُ ثَلاَثًا فِی مَقْعَدٍ وَاحِدٍ ؟ قَالَ : لاَ أَعْلَمُ بِذَلِکَ بَأْسًا ، قَدْ طَلَّقَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ امْرَأَتَہُ ثَلاَثًا ، فَلَمْ یُعَبْ ذَلِکَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 18094","","","كتاب الجنة"
"18095","(۱۸۰۹۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ قَالَ : کَانَ لاَ یَرَی بِذَلِکَ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 18095","","","كتاب الجنة"
"18096","(۱۸۰۹۶) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی السَّفَرِ ، عَنِ الشَّعْبِیِّ ؛ فِی رَجُلٍ أَرَادَ أَنْ تَبِینَ مِنْہُ امْرَأَتُہُ، قَالَ: یُطَلِّقُہَا ثَلاَثًا۔","No Data Available","Musannaf Ibn Abi Shaybah 18096","","","كتاب الجنة"
"18097","(۱۸۰۹۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : أَتَاہُ رَجُلٌ فَقَالَ : إنِّی طَلَّقْت امْرَأَتِی تِسْعَۃً وَتِسْعِینَ مَرَّۃً ؟ قَالَ : فَمَا قَالُوا لَکَ ؟ قَالَ : قَالُوا : قَدْ حُرِّمَتْ عَلَیْک ، قَالَ : فَقَالَ عَبْدُ اللہِ : لَقَدْ أَرَادُوا أَنْ یُبْقُوا عَلَیْک ، بَانَتْ مِنْک بِثَلاَثٍ وَسَائِرُہُنَّ عُدْوَانٌ۔","Sahih","Musannaf Ibn Abi Shaybah 18097","","","كتاب الجنة"
"18098","(۱۸۰۹۸) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَہُ مِئَۃَ تَطْلِیقَۃٍ ؟ قَالَ : حرَّمَتْہَا ثَلاَثٌ ، وَسَبْعَۃٌ وَتِسْعُونَ عُدْوَانٌ۔","Sahih","Musannaf Ibn Abi Shaybah 18098","","","كتاب الجنة"
"18099","(۱۸۰۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، وَالأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ ، قَالَ : جَائَ رَجُلٌ إلَی عَبْدِ اللہِ ، فَقَالَ : إنِّی طَلَّقْت امْرَأَتِی مِئَۃً ؟ فَقَالَ : بَانَتْ مِنْک بِثَلاَثٍ ، وَسَائِرُہُنَّ مَعْصِیَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 18099","","","كتاب الجنة"
"18100","(۱۸۱۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ زَیْدِ بْنِ وَہْبٍ ؛ أَنَّ رَجُلاً بَطَّالاً کَانَ بِالْمَدِینَۃِ طَلَّقَ امْرَأَتَہُ أَلْفًا ، فَرُفِعَ إلَی عُمَرَ فَقَالَ : إنَّمَا کُنْت أَلْعَبُ ، فَعَلاَ عُمَرُ رَأْسَہُ بِالدُّرَّۃِ ، وَفَرَّقَ بَیْنَہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 18100","","","كتاب الجنة"
"18101","(۱۸۱۰۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِِ ، عَنْ حَبِیبٍ ، قَالَ : جَائَ رَجُلٌ إلَی عَلِیٍّ ، فَقَالَ : إنِّی طَلَّقْتُ امْرَأَتِی أَلْفًا ؟ قَالَ : بَانَتْ مِنْک بِثَلاَثٍ ، وَاقْسِمْ سَائِرہُنَّ بَیْنَ نِسَائِک۔","","Musannaf Ibn Abi Shaybah 18101","","","كتاب الجنة"
"18102","(۱۸۱۰۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہَارُونَ بْنِ عَنْتَرَۃَ ، عَنْ أَبِیہِ ، قَالَ : کُنْتُ جَالِسًا عِنْدَ ابْنِ عَبَّاسٍ فَأَتَاہُ رَجُلٌ فَقَالَ : یَا ابْنَ عَبَّاسٍ ، إنَّہُ طَلَّقَ امْرَأَتَہُ مِئَۃَ مَرَّۃٍ ، وَإِنَّمَا قُلْتُہَا مَرَّۃً وَاحِدَۃً فَتَبِینُ مِنِّی بِثَلاَثٍ ، ہِیَ وَاحِدَۃٌ ؟ فَقَالَ : بَانَتْ مِنْک بِثَلاَثٍ ، وَعَلَیْک وِزْرُ سَبْعَۃٍ وَتِسْعِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 18102","","","كتاب الجنة"
"18103","(۱۸۱۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، قَالَ : حَدَّثَنِی عَمْرُو بْنُ مُرَّۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : جَائَ رَجُلٌ إلَی ابْنِ عَبَّاسٍ ، فَقَالَ : إنِّی طَلَّقْت امْرَأَتِی أَلْفًا ، أَوَ مِئَۃً ، قَالَ : بَانَتْ مِنْک بِثَلاَثٍ ، وَسَائِرُہُنَّ وِزْرٌ ، اتَّخَذْت آیَاتِ اللہِ ہُزُوًا۔","Sahih","Musannaf Ibn Abi Shaybah 18103","","","كتاب الجنة"
"18104","(۱۸۱۰۴) حَدَّثَنَا وَکِیعٌ ، وَالْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ مُعَاوِیَۃَ بْنِ أَبِی تِحْیَی قَالَ : جَائَ رَجُلٌ إلَی عُثْمَانَ فَقَالَ : إنِّی طَلَّقْت امْرَأَتِی مِئَۃً ، قَالَ : ثَلاَثٌ یُحَرِّمْنَہَا عَلَیْک ، وَسَبْعَۃٌ وَتِسْعُونَ عُدْوَانٌ۔","Da'if","Musannaf Ibn Abi Shaybah 18104","","","كتاب الجنة"
"18105","(۱۸۱۰۵) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنْ طَارِقٍ ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ؛ أَنَّہُ سَمِعَہُ یُحَدِّثُ عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَہُ مِئَۃً ؟ فَقَالَ : ثَلاَثٌ یُحَرِّمْنَہَا عَلَیْہِ ، وَسَبْعَۃٌ وَتِسْعُونَ فَضْلٌ۔","Sahih","Musannaf Ibn Abi Shaybah 18105","","","كتاب الجنة"
"18106","(۱۸۱۰۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ أَبِی مَعْشَرَ ، قَالَ : حدَّثَنَا سَعِیدٌ الْمَقْبُرِیُّ ، قَالَ : جَائَ رَجُلٌ إلَی عَبْدِ اللہِ بْنِ عُمَرَ وَأَنَا عِنْدَہُ ، فَقَالَ : یَا أَبَا عَبْدِ الرَّحْمَنِ ، إنَّہُ طَلَّقَ امْرَأَتَہُ مِئَۃَ مَرَّۃٍ ؟ قَالَ : بَانَتْ مِنْک بِثَلاَثٍ ، وَسَبْعَۃٌ وَتِسْعُونَ یُحَاسِبُک اللَّہُ بِہَا یَوْمَ الْقِیَامَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 18106","","","كتاب الجنة"
"18107","(۱۸۱۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ : قَالَ : إنِّی طَلَّقْتہَا مِئَۃً ؟ قَالَ : بَانَتْ مِنْک بِثَلاَثٍ ، وَسَائِرُہُنَّ إسْرَافٌ وَمَعْصِیَۃٌ۔","","Musannaf Ibn Abi Shaybah 18107","","","كتاب الجنة"
"18108","(۱۸۱۰۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الْفَضْلِ بْنِ دَلْہَمٍ ، عَنِ الْحَسَنِ ، قَالَ : جَائَ رَجُلٌ إلَی الْحَسَنِ ، فَقَالَ : إنِّی طَلَّقْت امْرَأَتِی أَلْفًا قَالَ : بَانَتْ مِنْک الْعَجُوزُ۔","","Musannaf Ibn Abi Shaybah 18108","","","كتاب الجنة"
"18109","(۱۸۱۰۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِِ ، عَنْ حَبِیبٍ ، عَنْ رَجُلٍ مِنْ أَہْلِ مَکَّۃَ ، قَالَ : جَائَ رَجُلٌ إلَی عَلِیٍّ فَقَالَ: إنِّی طَلَّقْت امْرَأَتِی أَلْفًا ؟ قَالَ : الثَّلاَثُ تُحَرِّمُہَا عَلَیْک ، وَاقْسِمْ سَائِرَہُنَّ بَیْنَ أَہْلِک۔","Da'if","Musannaf Ibn Abi Shaybah 18109","","","كتاب الجنة"
"18110","(۱۸۱۱۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ قَالَ : أَتَاہُ رَجُلٌ فَقَالَ: إنَّہُ کَانَ بَیْنِی وَبَیْنَ امْرَأَتِی کَلاَمٌ ، فَطَلَّقْتُہَا عَدَدَ النُّجُومِ ، قَالَ : تَکَلَّمْتَ بِالطَّلاَقِ ؟ قَالَ : نَعَمْ ، قَالَ : قَالَ عَبْدُ اللہِ : قَدْ بَیَّنَ اللَّہُ الطَّلاَقَ ، فَمَنْ أَخَذ بِہِ فَقَدْ بُیِّنَ لَہُ ، وَمَنْ لَبَّسَ عَلَی نَفْسِہِ جَعَلْنَا بِہِ لَبْسَہُ ، وَاللَّہِ لاَ تُلَبِّسُوا عَلَی أَنْفُسِکُمْ وَنَتَحَمَّلُہُ عَنْکُمْ ، ہُوَ کَمَا تَقُولُونَ ، ہُوَ کَمَا تَقُولُونَ۔","Sahih","Musannaf Ibn Abi Shaybah 18110","","","كتاب الجنة"
"18111","(۱۸۱۱۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ، قَالَ : لَوْ قَالَہَا لِنِسَائِ الْعَالَمِینَ بَعْدَ أَنْ یَمْلِکَہُنَّ ، کُنَّ عَلَیْہِ حَرَامًا۔","","Musannaf Ibn Abi Shaybah 18111","","","كتاب الجنة"
"18112","(۱۸۱۱۲) حدَّثَنَا إسْمَاعِیلُ بْنُ إبْرَاہِیمَ ، عَنْ أَیُّوبَ ، عَنْ عَمْرٍو ؛ سُئِلَ ابْنُ عَبَّاسٍ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَہُ عَدَدَ النُّجُومِ ؟ فَقَالَ : یَکْفِیہِ مِنْ ذَلِکَ رَأْسُ الْجَوْزَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 18112","","","كتاب الجنة"
"18113","(۱۸۱۱۳) حَدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ عَبْدِ الصَّمَدِ الْعَمِّیِّ ، عَنْ عَامِرٍ الأَحْوَلِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ طَلاَقَ إلاَّ بَعْدَ نِکَاحٍ۔ (ترمذی ۱۱۸۱۔ احمد ۲/۲۰۷)","Hasan","Musannaf Ibn Abi Shaybah 18113","","","كتاب الجنة"
"18114","(۱۸۱۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، عَمَّنْ سَمِعَ طَاوُوسًا یَقُولُ : قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ طَلاَقَ إلاَّ بَعْدَ نِکَاحٍ ، وَلاَ عِتْقَ قَبْلَ مِلْکٍ۔ (عبدالرزاق ۱۱۴۵۵)","Da'if","Musannaf Ibn Abi Shaybah 18114","","","كتاب الجنة"
"18115","(۱۸۱۱۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عنِ النَّزَّالِ ، عَنْ عَلِیٍّ ، قَالَ : لاَ طَلاَقَ إلاَّ مِنْ بَعْدِ النِّکَاحِ۔ (ابوداؤد ۲۸۶۵۔ عبدالرزاق ۱۱۴۵)","Da'if","Musannaf Ibn Abi Shaybah 18115","","","كتاب الجنة"
"18116","(۱۸۱۱۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ طَلاَقَ إلاَّ بَعْدَ نِکَاحِ ، وَلاَ عِتْقَ إلاَّ بَعْدَ مِلْکِ۔","Sahih","Musannaf Ibn Abi Shaybah 18116","","","كتاب الجنة"
"18117","(۱۸۱۱۷) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ ہِشَامِ بْنِ سَعْدٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ قَالَتْ : لاَ طَلاَقَ إلاَّ بَعْدَ نِکَاحٍ۔ وَقَالَ الزُّہْرِیُّ : إذَا وَقَعَ النِّکَاحُ وَقَعَ الطَّلاَقُ۔ (حاکم ۴۱۹)","No Data Available","Musannaf Ibn Abi Shaybah 18117","","","كتاب الجنة"
"18118","(۱۸۱۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَا أُبَالِی تَزَوَّجْتُہَا ، أَوْ وَضَعْتُ یَدِی عَلَی ہَذِہِ السَّارِیَۃِ ، یَعْنِی أَنَّہَا حَلاَلٌ۔","Sahih","Musannaf Ibn Abi Shaybah 18118","","","كتاب الجنة"
"18119","(۱۸۱۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ عَطَائٍ ، وَعَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، عَنْ جَابِرٍ ، رَفََعَہُ ؛ قَالَ : لاَ طَلاَقَ قَبْلَ نِکَاحٍ۔ (بیہقی ۳۱۹)","Sahih","Musannaf Ibn Abi Shaybah 18119","","","كتاب الجنة"
"18120","(۱۸۱۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّ مَرْوَانَ سَأَلَ عَنْہَا ابْنَ عَبَّاسٍ ؟ فَقَالَ : لاَ طَلاَقَ قَبْلَ نِکَاحٍ ، وَلاَ عِتْقَ قَبْلَ مِلْکٍ۔","Da'if","Musannaf Ibn Abi Shaybah 18120","","","كتاب الجنة"
"18121","(۱۸۱۲۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی رَجُلٍ قَالَ : یَوْمَ أَتَزَوَّجُ فُلاَنَۃً ، فَہِیَ طَالِقٌ ، قَالَ : لَیْسَ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 18121","","","كتاب الجنة"
"18122","(۱۸۱۲۲) حدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، قَالَ : سَأَلْتُ مَنْصُورًا عَنِ الرَّجُلِ تُذْکَرُ لَہُ الْمَرْأَۃُ ، فَیَقُولُ : یَوْمَ أَتَزَوَّجُہَا فَہِیَ طَالِقٌ ؟ قَالَ : کَانَ الْحَسَنُ لاَ یَرَاہُ طَلاَقًا۔","","Musannaf Ibn Abi Shaybah 18122","","","كتاب الجنة"
"18123","(۱۸۱۲۳) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَتَزَوَّجَ الَّتِی یَقُولَ : یَوْمَ أَتَزَوَّجُہَا فَہِیَ طَالِقٌ۔","","Musannaf Ibn Abi Shaybah 18123","","","كتاب الجنة"
"18124","(۱۸۱۲۴) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 18124","","","كتاب الجنة"
"18125","(۱۸۱۲۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ فِی الرَّجُلِ یَقُولُ : یَوْمَ أَتَزَوَّجُ فُلاَنَۃً فَہِیَ طَالِقٌ ، قَالَ : لَیْسَ بِشَیْئٍ ، إنَّمَا الطَّلاَقُ بَعْدَ النِّکَاحِ۔","","Musannaf Ibn Abi Shaybah 18125","","","كتاب الجنة"
"18126","(۱۸۱۲۶) حَدَّثَنَا وَکِیعٌ، عَنْ مُعَرِّفِ بْنِ وَاصِلٍ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ؛ أَنَّ عَلِیَّ بْنَ حُسَیْنٍ قَالَ: لاَ طَلاَقَ قَبْلَ نِکَاحٍ۔","","Musannaf Ibn Abi Shaybah 18126","","","كتاب الجنة"
"18127","(۱۸۱۲۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عَلِیِّ بْنِ حُسَیْنٍ ؛ أَنَّہُ قَالَ : لاَ طَلاَقَ إلاَّ بَعْدَ نِکَاحٍ۔","","Musannaf Ibn Abi Shaybah 18127","","","كتاب الجنة"
"18128","(۱۸۱۲۸) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : أَخْبَرَنِی عَبْدُ اللہِ بْنُ رِفَاعَۃَ الأَنْصَارِیُّ ، أَنَّہُ ذَکَرَ لِسَعِیدِ بْنِ الْمُسَیَّبِ أَنَّ رَجُلاً مِنَ الأَنْصَارِ ، قِیلَ لَہُ : ذُکِرَ لَنَا أَنَّک تَخْطُبُ فُلاَنَۃً ، امْرَأَۃً سَمَّوْہَا ، فَقَالَ الأَنْصَارِیُّ : ہِیَ طَالِقٌ إِنْ تَزَوَّجَہَا ، فَزَعَمَ عَبْدُ اللہِ أَنَّہُ سَأَلَ سَعِیدًا ؟ فَقَالَ : أَمَّا أَنَا فَلاَ أَرَاہُ شَیْئًا ، قَالَ یَحْیَی : وَبَلَغَنِی أَنَّ عُرْوَۃَ کَانَ یَقُولُ فِی ذَلِکَ مِثْلَ قَوْلِ سَعِیدٍ۔","","Musannaf Ibn Abi Shaybah 18128","","","كتاب الجنة"
"18129","(۱۸۱۲۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، وَوَکِیعٌ ، قَالاَ : حدَّثَنَا شُعْبَۃُ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ عَنْ شُرَیْحٍ ؛ قَالَ : لاَ طَلاَقَ إلاَّ بَعْدَ نِکَاحٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 18129","","","كتاب الجنة"
"18130","(۱۸۱۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مُعَرِّفٍ ، عَنْ عَمْرٍو ، عَنْ طَاوُوسٍ ؛ أَنَّہُ قَالَ : لاَ طَلاَقَ قَبْلَ نِکَاحٍ ، قَالَ : وَسَأَلْتُ الْقَاسِمَ بْنَ عَبْدِ الرَّحْمَنِ ؟ فَقَالَ : لَیْسَ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 18130","","","كتاب الجنة"
"18131","(۱۸۱۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مُعَرِّفِ بْنِ وَاصِلٍ ، عَنِ الْحَسَنِ بْنِ رَوَاحٍ الضَّبِّیِّ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ، وَمُجَاہِدًا ، وَعَطَائً عَنْ رَجُلٍ قَالَ : یَوْمَ أَتَزَوَّجُ فُلاَنَۃً فَہِیَ طَالِقٌ ؟ فَقَالُوا : لَیْسَ بِشَیْئٍ ، قَالَ : وَقَالَ سَعِیدٌ : أَیَکُونُ سَیْلٌ قَبْلَ مَطَرٍ ؟۔","","Musannaf Ibn Abi Shaybah 18131","","","كتاب الجنة"
"18132","(۱۸۱۳۲) حَدَّثَنَا قَبِیصَۃُ ، قَالَ : حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَنْ آدَمَ ، مَوْلَی خَالِدٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : قَالَ اللَّہُ تَعَالَی {یَا أَیُّہَا الَّذِینَ آمَنُوا إذَا نَکَحْتُمُ الْمُؤْمِنَاتِ ثُمَّ طَلَّقْتُمُوہُنَّ مِنْ قَبْلِ أَنْ تَمَسُّوہُنَّ} ، فَلاَ یَکُونُ طَلاَقٌ حَتَّی یَکُونَ نِکَاحٌ۔ (سعید بن منصور ۱۰۲۸)","Hasan","Musannaf Ibn Abi Shaybah 18132","","","كتاب الجنة"
"18133","(۱۸۱۳۳) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ، عَنْ أُسَامَۃَ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ، وَنَافِعِ بْنِ جُبَیْرٍ، قَالاَ: لاَ طَلاَقَ إلاَّ بَعْدَ نِکَاحٍ۔","","Musannaf Ibn Abi Shaybah 18133","","","كتاب الجنة"
"18134","(۱۸۱۳۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، وَأَبُو أُسَامَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : کَانَ سَالِمٌ ، وَقَاسِمٌ ، وَعُمَرُ بْنُ عَبْدِ الْعَزِیزِ ؛ یَرَوْنَہُ جَائِزًا عَلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 18134","","","كتاب الجنة"
"18135","(۱۸۱۳۵) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : یُکَفُّ عَنْہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 18135","","","كتاب الجنة"
"18136","(۱۸۱۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ (ح) وَعَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالاَ : إذَا وَقَّتَ وَقَعَ۔","No Data Available","Musannaf Ibn Abi Shaybah 18136","","","كتاب الجنة"
"18137","(۱۸۱۳۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ قَالَ لامْرَأَتِہِ : کُلُّ امْرَأَۃٍ أَتَزَوَّجُہَا عَلَیْک فَہِیَ طَالِقٌ ، قَالَ : فَکُلُّ امْرَأَۃٍ یَتَزَوَّجُہَا عَلَیْہَا ، فَہِیَ طَالِقٌ۔","","Musannaf Ibn Abi Shaybah 18137","","","كتاب الجنة"
"18138","(۱۸۱۳۸) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ حَبِیبِ بْنِ أَبِی مَرْزُوقٍ ، عَنْ عَطَائٍ قَالَ : إذَا الرَّجُلُ شَرَطَ لِلْمَرْأَۃِ عِنْدَ عَقْدِ النِّکَاحِ أَنَّ کُلَّ امْرَأَۃٍ یَتَزَوَّجُہَا عَلَیْہَا فَہِیَ طَالِقٌ ، وَکُلَّ سُرِّیَّۃٍ یَتَسَرَّی فَہِیَ حُرَّۃٌ ، جَازَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 18138","","","كتاب الجنة"
"18139","(۱۸۱۳۹) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ ہِشَامِ بْنِ سَعْدٍ ، قَالَ : قَالَ الزُّہْرِیُّ : إِذَا وَقَعَ النِّکَاحُ وَقَعَ الطَّلاَقُ۔","No Data Available","Musannaf Ibn Abi Shaybah 18139","","","كتاب الجنة"
"18140","(۱۸۱۴۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ؛ فِی رَجُلٍ قَالَ لامْرَأَتِہِ : کُلُّ امْرَأَۃٍ أَتَزَوَّجُہَا عَلَیْک فَہِیَ طَالِقٌ ، قَالَ : ہَذَا وَقْتٌ ہُوَ دَاخِلٌ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 18140","","","كتاب الجنة"
"18141","(۱۸۱۴۱) حدَّثَنَا حَفْصٌ ، عَنْ حَنْظَلَۃَ قَالَ : سُئِلَ الْقَاسِمُ ، وَسَالِمٌ عَنْ رَجُلٍ قَالَ : یَوْمَ أَتَزَوَّجُ فُلاَنَۃً فَہِیَ طَالِقٌ ؟ قَالاَ : ہِیَ کَمَا قَالَ۔","","Musannaf Ibn Abi Shaybah 18141","","","كتاب الجنة"
"18142","(۱۸۱۴۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، قَالَ : سَأَلْتُ الْقَاسِمَ عَنْ رَجُلٍ قَالَ : یَوْمَ أَتَزَوَّجُ فُلاَنَۃً فَہِیَ طَالِقٌ ؟ قَالَ : ہِیَ طَالِقٌ ، سُئِلَ عُمَرُ عَنْ رَجُلٍ قَالَ : یَوْمَ أَتَزَوَّجُ فُلاَنَۃً فَہِیَ عَلَیَّ کَظَہْرِ أُمِّی ؟ قَالَ : لاَ یَتَزَوَّجُہَا حَتَّی یُکَفِّرَ۔","","Musannaf Ibn Abi Shaybah 18142","","","كتاب الجنة"
"18143","(۱۸۱۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ؛ أَنَّہُ وَقَّتَ امْرَأَۃً إِنْ تَزَوَّجَہَا ، فَسَأَلَ ابْنَ مَسْعُودٍ ؟ فَقَالَ : أَعْلِمْہَا الطَّلاَقَ ثُمَّ تَزَوَّجْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 18143","","","كتاب الجنة"
"18144","(۱۸۱۴۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُمَرَ بْنِ حَمْزَۃَ ؛ أَنَّہُ سَأَلَ سَالِمًا ، وَالْقَاسِمَ ، وَأَبَا بَکْرِ بْنَ عَبْدِ الرَّحْمَنِ ، وَأَبَا بَکْرِ بْنَ عَمْرِو بْنِ حَزْمٍ ، وَعَبْدَ اللہِ بْنَ عَبْدِ الرَّحْمَنِ ، عَنْ رَجُلٍ قَالَ : یَوْمَ أَتَزَوَّجُ فُلاَنَۃً فَہِیَ طَالِقٌ اَلْبَتَّۃَ ؟ فَقَالُوا کُلُّہُمْ : لاَ یَتَزَوَّجُہَا۔","","Musannaf Ibn Abi Shaybah 18144","","","كتاب الجنة"
"18145","(۱۸۱۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ رَجُل ، عَنْ شُرَیْحٍ ؛ أَنَّ رَجُلاً سَأَلَہُ عَنْ رَجُلٍ قَالَ : یَوْمَ أَتَزَوَّجُ فُلاَنَۃً فَہِیَ طَالِقٌ ؟ فَقَالَ شُرَیْحٌ : إذَا سَمِعْتَ بَوَادِیَ النِّوْکَاء حُلَّ بِہ ، یَعْنِی أَنَّہَا طَالِقٌ۔","","Musannaf Ibn Abi Shaybah 18145","","","كتاب الجنة"
"18146","(۱۸۱۴۶) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ سُوَیْد بْنِ نَجِیحٍ الْکِنْدِیِّ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ عَنْ رَجُلٍ قَالَ : إِنْ تَزَوَّجْتُ فُلاَنَۃً فَہِیَ طَالِقٌ ، أَوْ یَوْمَ أَتَزَوَّجُ فُلاَنَۃً فَہِیَ طَالِقٌ ؟ قَالَ الشَّعْبِیُّ : ہُوَ کَمَا قَالَ ، فَقُلْتُ : إنَّ عِکْرِمَۃَ یَزْعُمُ أَنَّ الطَّلاَقَ بَعْدَ النِّکَاحِ ، فَقَالَ : جَرْمِزٌ مولی ابن عباس۔","","Musannaf Ibn Abi Shaybah 18146","","","كتاب الجنة"
"18147","(۱۸۱۴۷) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ قُدَامَۃَ ، قَالَ : قُلْتُ لِسَالِمِ بْنِ عَبْدِ اللہِ : رَجُلٌ قَالَ : کُلُّ امْرَأَۃٍ یَتَزَوَّجُہَا فَہِیَ طَالِقٌ ، وَکُلُّ جَارِیَۃٍ یَشْتَرِیہَا فَہِیَ حُرَّۃٌ ، فَقَالَ : أَمَّا أَنَا فَلَوْ کُنْتُ لَمْ أَنْکِحْ وَلَمْ أَتَسَرَّ۔","","Musannaf Ibn Abi Shaybah 18147","","","كتاب الجنة"
"18148","(۱۸۱۴۸) حدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ (ح) وَعَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالاَ : إذَا قَالَ کُلُّ فَلَیْسَ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 18148","","","كتاب الجنة"
"18149","(۱۸۱۴۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ ، وَمَکْحُولٍ ؛ فِی الرَّجُلِ یَقُولُ : کُلُّ امْرَأَۃٍ أَتَزَوَّجُہَا فَہِیَ طَالِقٌ ، أَنَّہُمَا کَانَا یُوجِبَانِ ذَلِکَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 18149","","","كتاب الجنة"
"18150","(۱۸۱۵۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عَبْدُ الْمَلِکِ بْنُ أَبِی سُلَیْمَانَ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنِ الرَّجُلِ یَقُولُ : کُلُّ امْرَأَۃٍ أَتَزَوَّجُہَا فَہِیَ طَالِقٌ ؟ قَالَ : کَیْفَ تُطَلِّقُ مَا لاَ تَمْلِکُ ؟ إنَّمَا الطَّلاَقُ بَعْدَ النِّکَاحِ۔","No Data Available","Musannaf Ibn Abi Shaybah 18150","","","كتاب الجنة"
"18151","(۱۸۱۵۱) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ مُطَرِّفٍ، عَنِ الْحَکَمِ، عَنِ ابْنِ عَبَّاسٍ، وَابْنِ مَسْعُودٍ، قَالاَ: فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ ثَلاَثًا قَبْلَ أَنْ یَدْخُلَ بِہَا ، لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 18151","","","كتاب الجنة"
"18152","(۱۸۱۵۲) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ قَالَ : إذَا طَلَّقَ الْبِکْرَ وَاحِدَۃً فَقَدْ بَتَّہَا ، وَإِذَا طَلَّقَہَا ثَلاَثًا لَمْ تَحِلَّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 18152","","","كتاب الجنة"
"18153","(۱۸۱۵۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ بُکَیْرِ بْنِ عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، قَالَ : کُنْتُ جَالِسًا عِنْدَ عَبْدِ اللہِ بْنِ عَمْرٍو ، فَسَأَلَہُ رَجُلٌ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَہُ بِکْرًا ثَلاَثًا ؟ قَالَ عَطَائٌ : فَقُلْتُ : ثَلاَثٌ فِی الْبِکْرِ وَاحِدَۃٌ ، وَقَالَ عَبْدُ اللہِ بْنُ عَمْرٍو : مَا یُدْرِیْکَ ؟ إنَّمَا أَنْتَ قَاصٍّ وَلَسْتَ بِمُفْتٍ ، الْوَاحِدَۃُ تُبَینُہَا وَالثَّلاَثُ تُحَرِّمُہَا حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 18153","","","كتاب الجنة"
"18154","(۱۸۱۵۴) حَدَّثَنَا عَبْدَۃُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ بُکَیْرِ بْنِ عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَنْ رَجُلٍ مِنَ الأَنْصَارِ یُقَالُ لَہُ : مُعَاوِیَۃُ ؛ أَنَّ ابْنَ عَبَّاسٍ ، وَأَبَا ہُرَیْرَۃَ ، وَعَائِشَۃَ قَالُوا : لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 18154","","","كتاب الجنة"
"18155","(۱۸۱۵۵) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنِ الْحَکَمِ ، عَنْ أَبِی سَعِیدٍ ؛ فِی الَّذِی یُطَلِّقُ امْرَأَتَہُ ثَلاَثًا قَبْلَ أَنْ یَدْخُلَ بِہَا ، فَقَالَ : لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 18155","","","كتاب الجنة"
"18156","(۱۸۱۵۶) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : سَمِعْتُ أُمَّ سَلَمَۃَ سُئِلَتْ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَہُ ثَلاَثًا قَبْلَ أَنْ یَدْخُلَ بِہَا ؟ فَقَالَتْ : لاَ تَحِلُّ لَہُ حَتَّی یَطَأَہَا غَیْرَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 18156","","","كتاب الجنة"
"18157","(۱۸۱۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَبْدِ اللہِ ، قَالَ : إذَا طَلَّقَہَا ثَلاَثًا قَبْلَ أَنْ یَدْخُلَ بِہَا، فَہِیَ بِمَنْزِلَۃِ الْمَدْخُولِ بِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 18157","","","كتاب الجنة"
"18158","(۱۸۱۵۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ؛ بِمِثْلِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 18158","","","كتاب الجنة"
"18159","(۱۸۱۵۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمْر ۔(ح) وَعَنْ مُحَمَّدِ بْنِ إیَاسِ بْنِ بُکَیْر ، عَنْ أَبِی ہُرَیْرَۃَ ، وَابْنِ عَبَّاسٍ ، وَعَائِشَۃَ ؛ فِی الرَّجُلِ یُطَلِّقُ امْرَأَتَہُ ثَلاَثًا قَبْلَ أَنْ یَدْخُلَ بِہَا ، قَالُوا: لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 18159","","","كتاب الجنة"
"18160","(۱۸۱۶۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ مَعقلٍ ؛ فِی رَجُلٍ یُطَلِّقُ امْرَأَتَہُ ثَلاَثًا قَبْلَ أَنْ یَدْخُلَ بِہَا ، قَالَ : لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 18160","","","كتاب الجنة"
"18161","(۱۸۱۶۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَتَزَوَّجُ الْمَرْأَۃَ فَیُطَلِّقُہَا ثَلاَثًا قَبْلَ أَنْ یَدْخُلَ بِہَا ، قَالَ : إِنْ قَالَ طَالِقٌ ثَلاَثًا ، کَلِمَۃً وَاحِدَۃً ، لَمْ تَحِلَّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ ، وَإِذَا طَلَّقَہَا ثَلاَثًا طَلاَقًا مُتَّصِلاً فَہُوَ کَذَلِکَ۔","","Musannaf Ibn Abi Shaybah 18161","","","كتاب الجنة"
"18162","(۱۸۱۶۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا طَلَّقَہَا ثَلاَثًا قَبْلَ أَنْ یَدْخُلَ بِہَا ، لَمْ تَحِلَّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 18162","","","كتاب الجنة"
"18163","(۱۸۱۶۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ ؛ فِی الرَّجُلِ یُطَلِّقُ امْرَأَتَہُ ثَلاَثًا قَبْلَ أَنْ یَدْخُلَ بِہَا ، قَالَ : لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 18163","","","كتاب الجنة"
"18164","(۱۸۱۶۴) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ مُحَمَّدٍ ، قَالَ : لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 18164","","","كتاب الجنة"
"18165","(۱۸۱۶۵) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ بُرْد ، عَنْ مَکْحُولٍ ؛ فِیمَنْ طَلَّقَ امْرَأَتَہُ قَبْلَ أَنْ یَدْخُلَ بِہَا ، إنَّہَا لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 18165","","","كتاب الجنة"
"18166","(۱۸۱۶۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ، عَنْ شَقِیقِ بْنِ أَبِی عَبْدِ اللہِ، عَنْ أَنَسٍ، قَالَ: لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 18166","","","كتاب الجنة"
"18167","(۱۸۱۶۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَسَعِیدِ بْنِ جُبَیْرٍ ، وَحُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالُوا : لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 18167","","","كتاب الجنة"
"18168","(۱۸۱۶۸) حدَّثَنَا عَبْدُ الأَعْلَی، عَنْ دَاوُدَ، عَنْ عَامِرٍ؛ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ ثَلاَثًا قَبْلَ أَنْ یَدْخُلَ بِہَا ، قَالَ: أَکْرَہُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 18168","","","كتاب الجنة"
"18169","(۱۸۱۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ إبْرَاہِیمَ ، عَنْ عَبِیدَۃَ (ح) وَعَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالاَ : إذَا طَلَّقَہَا ثَلاَثًا قَبْلَ أَنْ یَدْخُلَ بِہَا ، فَلاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 18169","","","كتاب الجنة"
"18170","(۱۸۱۷۰) حَدَّثَنَا ابْنُ عَیّاشٍ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَکَمِ ؛ فِی الرَّجُلِ یَقُولُ لامْرَأَتِہِ : أَنْتِ طَالِقٌ أَنْتِ طَ??لِقٌ ، أَنْتِ طَالِقٌ ، قَالَ : بَانَتْ بِالأُولَی وَالأُخْرَیَانِ لَیْسَ بِشَیْئٍ ، قَالَ : قُلْتُ : مَنْ یَقُولُ ہَذَا ؟ قَالَ : عَلِیٌّ ، وَزَیْدٌ ، وَغَیْرُہُمَا ، یَعْنِی قَبْلَ أَنْ یَدْخُلَ بِہَا۔","","Musannaf Ibn Abi Shaybah 18170","","","كتاب الجنة"
"18171","(۱۸۱۷۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا قَالَ لامْرَأَتِہِ قَبْلَ أَنْ یَدْخُلَ بِہَا أَنْتِ طَالِقٌ ، أَنْتِ طَالِقٌ ، أَنْتِ طَالِقٌ ، فَقَد بَانَتْ بِوَاحِدَۃٍ وَسَقَطَتِ اثْنَتَانِ۔","","Musannaf Ibn Abi Shaybah 18171","","","كتاب الجنة"
"18172","(۱۸۱۷۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْفُقَیْمِیِّ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا قَالَ قَبْلَ أَنْ یَدْخُلَ بِہَا أَنْتِ طَالِقٌ ، أَنْتِ طَالِقٌ ، أَنْتِ طَالِقٌ ، بَانَتْ بِالأُولَی ، وَالأُخْرَیَانِ لَیْسَ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 18172","","","كتاب الجنة"
"18173","(۱۸۱۷۳) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ ہَمَّام ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ، قَالَ : بَانَتْ بِالأُولَی۔","","Musannaf Ibn Abi Shaybah 18173","","","كتاب الجنة"
"18174","(۱۸۱۷۴) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، قَالاَ : بَانَتْ بِالأُولَی ، وَثِنْتَانِ لَیْسَتَا بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 18174","","","كتاب الجنة"
"18175","(۱۸۱۷۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا قَالَ لَہَا أَنْتِ طَالِقٌ ، أَنْتِ طَالِقٌ ، أَنْتِ طَالِقٌ ، قَبْلَ أَنْ یَدْخُلَ بِہَا ، فَقَدْ حُرِّمَتْ علیہ۔","","Musannaf Ibn Abi Shaybah 18175","","","كتاب الجنة"
"18176","(۱۸۱۷۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا طَلَّقَہَا ثَلاَثًا قَبْلَ أَنْ یَدْخُلَ بِہَا ، لَمْ تَحِلَّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ ، وَلَوْ قَالَہَا تَتْرَی بَانَتْ بِالأُولَی۔","Da'if","Musannaf Ibn Abi Shaybah 18176","","","كتاب الجنة"
"18177","(۱۸۱۷۷) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، وَعَطَائٍ ، أَنَّہُمَا قَالاَ : إذَا طَلَّقَ الرَّجُلُ امْرَأَتَہُ ثَلاَثًا قَبْلَ أَنْ یَدْخُلَ بِہَا ، فَہِیَ وَاحِدَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 18177","","","كتاب الجنة"
"18178","(۱۸۱۷۸) حَدَّثَنَا عَفَّانُ بْنُ مُسْلِمٍ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، قَالَ : حَدَّثَنَا أَیُّوبُ ؛ أَنَّ طَاوُوسًا قَالَ : جَائَ أَبُو الصَّہْبَائِ إلَی ابْنِ عَبَّاسٍ فَقَالَ لَہُ : ہَاتِ مِنْ ہُنْیَّاتِکَ : إنَّ الثَّلاَثَ کُنَّ یُحْسَبْنَ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَبِی بَکْرٍ وَصَدْرِ إمَارَۃِ عُمَرَ وَاحِدَۃً ، فَلَمَّا رَأَی عُمَرُ النَّاسَ قَدْ تَتَابَعُوا فِی الطَّلاَقِ ، فَأَجَازَہُنَّ عَلَیْہِ۔ (مسلم ۱۰۹۹۔ ابوداؤد ۲۱۹۲)","","Musannaf Ibn Abi Shaybah 18178","","","كتاب الجنة"
"18179","(۱۸۱۷۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ طَاوُوسٍ ، وَعَطَائٍ ، وَجَابِرِ بْنِ زَیْدٍ ؛ أَنَّہُمْ قَالُوا : إذَا طَلَّقَہَا ثَلاَثًا قَبْلَ أَنْ یَدْخُلَ بِہَا فَہِیَ وَاحِدَۃٌ۔","","Musannaf Ibn Abi Shaybah 18179","","","كتاب الجنة"
"18180","(۱۸۱۸۰) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبِ ، عَنْ مُغِیرَۃ ، عَنْ إبْرَاہِیمَ ؛ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ وَاحِدَۃً ، فَلَقِیَہُ رَجُلٌ فَیَقُولُ : طَلَّقْتَ امْرَأَتَکَ ؟ فَقَالَ : نَعَمْ ، ثُمَّ لَقِیَہُ آخَرُ ، فَقَالَ : طَلَّقْتَ ؟ قَالَ : نَعَمْ ، فَقَالَ : إِنْ کَانَ نَوَی الأُولَی فَہِیَ وَاحِدَۃٌ۔","","Musannaf Ibn Abi Shaybah 18180","","","كتاب الجنة"
"18181","(۱۸۱۸۱) حَدَّثَنَا شَرِیکٌ ، عَنِ الرَّجُلِ یُطَلِّقُ الْمَرْأَۃَ فَیَلْقَاہُ الرَّجُلُ ، فَیَقُولُ : طَلَّقْتَ ؟ فَیَقُولُ : نَعَمْ ، ثُمَّ یَلْقَاہُ آخَرُ فَیَقُولُ: طَلَّقْتَ؟ فَیَقُولُ: نَعَمْ ، فَحَدَّثَنَا عَنْ أَبِی إِسْحَاقَ، عَنِ ابْنِ مَعْقِل، والشَّعْبِیِّ قَالاَ: إذَا أَرَادَ الأُولَی فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 18181","","","كتاب الجنة"
"18182","(۱۸۱۸۲) حدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ فَلُقِیَ ، فَقِیلَ لَہُ : طَلَّقْتَ امْرَأَتَکَ؟ فَقَالَ: نَعَمْ، فَقِیلَ لَہُ: طَلَّقْتَ امْرَأَتَکَ؟ فَقَالَ: نَعَمْ ، فَرُفِعَ ذَلِکَ إلَی عُمَرَ بْنِ الْخَطَّابِ، فَقَالَ: مَا نَوَی۔","Hasan","Musannaf Ibn Abi Shaybah 18182","","","كتاب الجنة"
"18183","(۱۸۱۸۳) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ عَبْدِ رَبِّہِ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : سَأَلْتُہُ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَہُ تَطْلِیقَۃً، ثُمَّ طَلَّقَہَا أُخْرَی ، فَکَانَتَا اثْنَتَیْنِ ، ثُمَّ لَقِیَہُ رَجُلٌ ، فَقَالَ : طَلَّقْتَ امْرَأَتَکَ ؟ فَقَالَ : نَعَمْ ، قَالَ : فَقَالَ : إِنْ کَانَ إنَّمَا أَرَادَ مَا کَانَ طَلَّقَ ، فَلَیْسَ عَلَیْہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 18183","","","كتاب الجنة"
"18184","(۱۸۱۸۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ حَمَّادٍ ؛ فِی رَجُلٍ قَالَ لامْرَأَتِہِ : أَنْتِ طَالِقٌ فَقَالَتْ : أَیُّ شَیْئٍ تَقُولُ ؟ ، فَقَالَ : أَنْتِ طَالِقٌ الْبَتَّۃَ ، فَقَالَ حَمَّادٌ : إِنْ کَانَ أَرَادَ أَنْ یُفَہِّمَہَا فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 18184","","","كتاب الجنة"
"18185","(۱۸۱۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّاداً عَنِ الرَّجُلِ یَقُولُ لامْرَأَتِہِ : أَنْتِ طَالِقٌ ، أَنْتِ طَالِقُ ، أَنْتِ طَالِقٌ ؟ قَالاَ : ہِی ثَلاَثٌ ، إلاَّ أَنْ یَکُونَ نَوَی الأُولَی ، وَإِذَا قَالَ اعْتَدِّی ، فَمِثْلُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 18185","","","كتاب الجنة"
"18186","(۱۸۱۸۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عُقْبَۃَ بْنُ أَبِی العَیزَارِ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَہُ تَطْلِیقَۃً ، أَوْ تَطْلِیقَتَیْنِ ، فَسَأَلَہُ رَجُلٌ : طَلَّقْتَ امْرَأَتَکَ کَذَا وَکَذَا ، ثَلاَثًا ، أَوْ أَرْبَعًا ؟ فَقَالَ الرَّجُلُ : نَعَمْ ؟ قَالَ إبْرَاہِیمُ : بَانَتْ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 18186","","","كتاب الجنة"
"18187","(۱۸۱۸۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَقُولُ لامْرَأَتِہِ : أَنْتِ طَالِقٌ إلَی سَنَۃٍ ، قَالَ : یَقَعُ عَلَیْہَا یَوْمَ قَالَ۔","","Musannaf Ibn Abi Shaybah 18187","","","كتاب الجنة"
"18188","(۱۸۱۸۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّہُ کَانَ لاَ یُؤَجِّلُ فِی الطَّلاَقِ۔","","Musannaf Ibn Abi Shaybah 18188","","","كتاب الجنة"
"18189","(۱۸۱۸۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یُؤَجِّلُ فِی الطَّلاَقِ۔","","Musannaf Ibn Abi Shaybah 18189","","","كتاب الجنة"
"18190","(۱۸۱۹۰) حدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إذَا طَلَّقَ إلَی أَجَلٍ وَقَعَ۔","","Musannaf Ibn Abi Shaybah 18190","","","كتاب الجنة"
"18191","(۱۸۱۹۱) حدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ فُرَاتٍ ، عَنْ عَبْدِ الْکَرِیمِ ، قَالَ : کَانَ الزُّہْرِیُّ یَقُولُ : تَعْتَدُّ یَوْمَ قَالَ۔","","Musannaf Ibn Abi Shaybah 18191","","","كتاب الجنة"
"18192","(۱۸۱۹۲) حَدَّثَنَا ہُشَیْمٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ قَالَ: مَنْ وَقَّتَ فِی الطَّلاَقِ وَقْتًا، فَدَخَلَ ذَلِکَ الْوَقْتُ، وَقَعَ الطَّلاَقُ۔","","Musannaf Ibn Abi Shaybah 18192","","","كتاب الجنة"
"18193","(۱۸۱۹۳) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ، عَنْ عُبَیْدِ اللہِ بْنِ عُبَیْدٍ، عَنْ مَکْحُولٍ؛ أَنَّہُ کَانَ یَقُولُ: حتَّی یَجِیئَ الأَجَلُ۔","","Musannaf Ibn Abi Shaybah 18193","","","كتاب الجنة"
"18194","(۱۸۱۹۴) حَدَّثَنَا مُعَمَّرُ بْنُ سُلَیْمَانَ الرَّقِّیُّ ، عَنْ عَبْدِ اللہِ بْنِ بِشْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إلَی أَجَلہ۔","","Musannaf Ibn Abi Shaybah 18194","","","كتاب الجنة"
"18195","(۱۸۱۹۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرٍو ، قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ عَنْ رَجُلٍ قَالَ لامْرَأَتِہِ : إذَا أَہْلَلْتُ شَہْرَ کَذَا وَکَذَا ، فَامْرَأَتِی طَالِقٌ إلَی رَأْسِ السَّنَۃِ ؟ قَالَ : أرَی أَنَّہَا طَالِقٌ إلَی الأَجَلِ الَّذِی سَمَّی ، وَتَحِلُّ لَہُ فِیمَا دُونَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 18195","","","كتاب الجنة"
"18196","(۱۸۱۹۶) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ سَلَمَۃَ بْنِ نَبَاتَۃَ ، عَنْ أَبِی ذَرٍّ ؛ أَنَّہُ قَالَ لِغُلاَمٍ لَہُ : ہُوَ عَتِیقٌ إلَی الْحَوْلِ۔","Da'if","Musannaf Ibn Abi Shaybah 18196","","","كتاب الجنة"
"18197","(۱۸۱۹۷) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ؛ فِی رَجُلٍ قَالَ لامْرَأَتِہِ : اعْتَدِّی ، قَالَ : ہِیَ تَطْلِیقَۃٌ إذَا عَنَی الطَّلاَقَ۔","","Musannaf Ibn Abi Shaybah 18197","","","كتاب الجنة"
"18198","(۱۸۱۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ رَبِّہِ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : ہِیَ تَطْلِیقَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 18198","","","كتاب الجنة"
"18199","(۱۸۱۹۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : اعْتَدِّی وَاحِدَۃً۔","","Musannaf Ibn Abi Shaybah 18199","","","كتاب الجنة"
"18200","(۱۸۲۰۰) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : ہِیَ وَاحِدَۃٌ ، وَہُوَ أَحَقُّ بِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 18200","","","كتاب الجنة"
"18201","(۱۸۲۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ: سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنْ رَجُلٍ قَالَ لامْرَأَتِہِ: أَنْتِ طَالِقٌ ، أَنْتِ طَالِقٌ، أَنْتِ طَالِقٌ ، وَنَوَی الأُولَی ؟ قَالاَ : ہِیَ وَاحِدَۃٌ ، وَکَذَلِکَ إِذَا قَالَ اعتَدّی ، اعتَدّی۔","","Musannaf Ibn Abi Shaybah 18201","","","كتاب الجنة"
"18202","(۱۸۲۰۲) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، قَالاَ : إذَا قَالَ الرَّجُلُ لامْرَأَتِہِ : اعْتَدِّی ، اعْتَدِّی ، وَقَالَ : إنِّی نَوَیْت وَاحِدَۃً ، فَہِی وَاحِدَۃٌ۔","","Musannaf Ibn Abi Shaybah 18202","","","كتاب الجنة"
"18203","(۱۸۲۰۳) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ، عَنْ عَامِرٍ؛ فِی رَجُلٍ قَالَ لامْرَأَتِہِ: اعْتَدِّی ، اعْتَدِّی ، یَنْوِی ثَلاَثًا، قَالَ : ہِیَ وَاحِدَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 18203","","","كتاب الجنة"
"18204","(۱۸۲۰۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ؛ وَہُوَ قَوْلُ قَتَادَۃَ ، أَنَّہُمَا قَالاَ : إذَا قَالَ الرَّجُلُ لامْرَأَتِہِ : اعْتَدِّی ثَلاَثًا ، لَمْ تَحِلَّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 18204","","","كتاب الجنة"
"18205","(۱۸۲۰۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 18205","","","كتاب الجنة"
"18206","(۱۸۲۰۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، وَأَبِی حَرَّۃَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ قَالَ لامْرَأَتِہِ : أَنْتِ طَالِقٌ فَاعْتَدِّی ، قَالَ: ہِیَ وَاحِدَۃٌ ، وَإِذَا قَالَ : أَنْتِ طَالِقٌ وَاعْتَدِّی ، فَہِیَ اثْنَتَانِ۔","","Musannaf Ibn Abi Shaybah 18206","","","كتاب الجنة"
"18207","(۱۸۲۰۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ قَالَ : لاَ یَجُوزُ طَلاَقُ الْمَجْنُونِ۔","","Musannaf Ibn Abi Shaybah 18207","","","كتاب الجنة"
"18208","(۱۸۲۰۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : الْمَجْنُونُ لاَ یَجُوزُ طَلاَقُہُ۔","","Musannaf Ibn Abi Shaybah 18208","","","كتاب الجنة"
"18209","(۱۸۲۰۹) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبَانَ بْنِ عُثْمَانَ ، عَنْ عُثْمَانَ ، قَالَ : لَیْسَ لِمَجْنُونٍ وَلاَ لِسَکْرَانَ طَلاَقٌ۔","Sahih","Musannaf Ibn Abi Shaybah 18209","","","كتاب الجنة"
"18210","(۱۸۲۱۰) حدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ ہَارُونَ ، قَالَ : سَأَلْتُ ابْنَ سِیرِینَ عَنْ طَلاَقِ الْمَجْنُونِ ؟ فَقَالَ : لَیْسَ بِشَیْئٍ ، وَالسُّلْطَانُ یَنْظُرُ فِیہِ ، یُسْأَلُ الْبَیِّنَۃَ أَنَّہُ طَلَّقَ وَتُصْبِر یَمِینَہُ۔","","Musannaf Ibn Abi Shaybah 18210","","","كتاب الجنة"
"18211","(۱۸۲۱۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرٍو ، قَالَ : سُئِلَ جَابِرٌ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَہُ وَہُوَ مَجْنُونٌ ، حِینَ أَخَذَہُ جُنُونُہُ ؟ قَالَ : لاَ یَجُوزُ۔","No Data Available","Musannaf Ibn Abi Shaybah 18211","","","كتاب الجنة"
"18212","(۱۸۲۱۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ یَجُوزُ طَلاَقُ الْمَجْنُونِ إذَا أُخِذَ بِہِ ، فَإِذَا صَحَّ فَہُوَ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 18212","","","كتاب الجنة"
"18213","(۱۸۲۱۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنْ عَابِسِ بْنِ رَبِیعَۃَ ، عَنْ عَلِیٍّ ، قَالَ : کُلُّ طَلاَقٍ جَائِزٌ ، إلاَّ طَلاَقَ الْمَعْتُوہِ۔","Sahih","Musannaf Ibn Abi Shaybah 18213","","","كتاب الجنة"
"18214","(۱۸۲۱۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنْ عَابِسِ بْنِ رَبِیعَۃَ ، قَالَ : سَمِعْتُ عَلِیًّا یَقُولُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 18214","","","كتاب الجنة"
"18215","(۱۸۲۱۵) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَنْ أَبِی إِسْحَاقَ، عَنْ إبْرَاہِیمَ، قَالَ: قَالَ عَلِیٌّ: کُلُّ طَلاَقٍ جَائِزٌ، إلاَّ طَلاَقَ الْمَعْتُوہِ۔","","Musannaf Ibn Abi Shaybah 18215","","","كتاب الجنة"
"18216","(۱۸۲۱۶) حدَّثَنَا أَبُو بَکْرٍ الْحَنَفِیُّ ، عَنْ أُسَامَۃَ ، عَنْ نَافِعٍ ؛ أَنَّ الْمُجَبِّرَ بْنَ عَبْدِ الرَّحْمَنِ طَلَّقَ امْرَأَتَہُ ، وَہُوَ مَعْتُوہٌ ، فَأَمَرَہَا ابْنُ عُمَرَ أَنْ تَعْتَدَّ ، فَقِیلَ لَہُ : إنَّہُ مَعْتُوہٌ ، فَقَالَ : إنِّی لَمْ أَسْمَعِ اللَّہَ اسْتَثْنَی لِمَعْتُوہٍ طَلاَقًا ، وَلاَ غَیْرَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 18216","","","كتاب الجنة"
"18217","(۱۸۲۱۷) حدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَیْسَ لِمَعْتُوہٍ ، وَلاَ لِصَبِیٍّ طَلاَقٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 18217","","","كتاب الجنة"
"18218","(۱۸۲۱۸) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا طَلَّقَ الْمَعْتُوہُ فِی حَالِ إفَاقَتِہِ ، جَازَ۔","","Musannaf Ibn Abi Shaybah 18218","","","كتاب الجنة"
"18219","(۱۸۲۱۹) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : طَلاَقُہُ لَیْسَ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 18219","","","كتاب الجنة"
"18220","(۱۸۲۲۰) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی حَصِینٍ ، عَنْ شُرَیْحٍ ، قَالَ : لاَ یَجُوزُ طَلاَقُہُ۔","","Musannaf Ibn Abi Shaybah 18220","","","كتاب الجنة"
"18221","(۱۸۲۲۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : لاَ یَجُوزُ طَلاَقُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 18221","","","كتاب الجنة"
"18222","(۱۸۲۲۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لَیْسَ لَہُ طَلاَقٌ۔","","Musannaf Ibn Abi Shaybah 18222","","","كتاب الجنة"
"18223","(۱۸۲۲۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ : کُلُّ الطَّلاَقِ جَائِزٌ ، إلاَّ طَلاَقَ الْمَعْتُوہِ۔","","Musannaf Ibn Abi Shaybah 18223","","","كتاب الجنة"
"18224","(۱۸۲۲۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَیْسَ لِمَعْتُوہٍ طَلاَقٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 18224","","","كتاب الجنة"
"18225","(۱۸۲۲۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیِّبِ ؛ فِی الَّذِی بِہِ الْمَوْتَۃُ ، قَالَ : إذَا طَلَّقَ عِنْدَ أَخْذِہَا إِیَّاہُ فَلَیْسَ بِشَیْئٍ ، وَإِذَا أَفَاقَ فَطَلاَقُہُ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 18225","","","كتاب الجنة"
"18226","(۱۸۲۲۶) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 18226","","","كتاب الجنة"
"18227","(۱۸۲۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ ، عَنْ إبْرَاہِیمَ ، عَنِ الْحَسَنِ ؛ فِی الَّذِی تُصِیبُہُ الخَطْرَۃَ مِنَ الْجُنُونِ یُطَلِّقُ ، قَال الْحَسَنُ : لاَ یَلْزَمُہُ ، وَقَالَ قَتَادَۃُ : إذَا اشْتَرَی وَبَاعَ لَزِمَہُ ، وَإِذَا طَلَّقَ فِی حَالِ جُنُونِہِ لَمْ یَلْزَمْہُ۔","","Musannaf Ibn Abi Shaybah 18227","","","كتاب الجنة"
"18228","(۱۸۲۲۸) حَدَّثَنَا ابْنُ نُمَیْرٍ، عَنْ أَشْعَثَ، عَنِ الشَّعْبِیِّ؛ فِی الْمُصَابِ الَّذِی یُصِیبُہُ الْحَینُ قَالَ: طَلاَقُہُ وَعِتَاقُہُ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 18228","","","كتاب الجنة"
"18229","(۱۸۲۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْمُعْتَمِرِ، عَنْ قَتَادَۃَ ، قَالَ: الْجُنُونُ جُنُونَانِ، فَإِنْ کَانَ لاَ یُفِیقُ لَمْ یَجُزْ لَہُ طَلاَقٌ، وَإِنْ کَانَ یُفِیقُ فَطَلَّقَ فِی حَالِ إفَاقَتِہِ لَزِمَہُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 18229","","","كتاب الجنة"
"18230","(۱۸۲۳۰) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، قَالَ : وَجَدْنَا فِی کِتَابِ عَبْدِ اللہِ بْنِ عَمْرٍو ، عَنْ عَمْرٍو : إذَا عَبِثَ الْمَجْنُونُ بِامْرَأَتِہِ ، طَلَّقَ عَنْہُ وَلِیُّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 18230","","","كتاب الجنة"
"18231","(۱۸۲۳۱) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یُطَلِّقُ وَلِیُّ الْمُوَسْوِسِ ، وَلْیَنْتَظِرْ عَسَی أَنْ یُفِیقَ۔","","Musannaf Ibn Abi Shaybah 18231","","","كتاب الجنة"
"18232","(۱۸۲۳۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : طَلاَقُ الْمَعْتُوہِ الْمَغْلُوبِ عَلَی عَقْلِہِ لَیْسَ بِشَیْئٍ ، طَلاَقُہُ إلَی وَلِیِّہِ۔","","Musannaf Ibn Abi Shaybah 18232","","","كتاب الجنة"
"18233","(۱۸۲۳۳) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، قَالَ : کَتَبْتُ إلَی أَبِی قِلاَبَۃَ فِی امْرَأَۃٍ زَوْجُہَا مَجْنُونٌ ، لاَ یَرْجُون أَنْ یَبْرَأَ ، یُطَلِّقُ عَنْہُ وَلِیُّہُ ؟ فَکَتَبَ إلَیَّ : لاَ ، إِنَّہَا امْرَأَۃٌ ابْتَلاَہَا اللَّہُ بِالْبَلاَئِ ، فَلْتَصْبِرْ۔","","Musannaf Ibn Abi Shaybah 18233","","","كتاب الجنة"
"18234","(۱۸۲۳۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیّ ، قَالَ : لاَ یَجُوزُ عَلَیْہِ طَلاَقُ وَلِیِّہِ۔","","Musannaf Ibn Abi Shaybah 18234","","","كتاب الجنة"
"18235","(۱۸۲۳۵) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : کَتَبْتُ إلَی عُمَرَ فِی رَجُلٍ مَجْنُونٍ یُخَافُ أَنْ یَقْتُلَ امْرَأَتَہُ ، فَکَتَبَ إلَیَّ : أَنْ أَجِّلْہُ سَنَۃً یَتَدَاوَی۔","","Musannaf Ibn Abi Shaybah 18235","","","كتاب الجنة"
"18236","(۱۸۲۳۶) حَدَّثَنَا حَفْصٌ ، عَنْ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ یَجُوزُ طَلاَقُ الصَّبِیِّ۔","","Musannaf Ibn Abi Shaybah 18236","","","كتاب الجنة"
"18237","(۱۸۲۳۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ یَجُوزُ طَلاَقُ الصَّبِیِّ۔","","Musannaf Ibn Abi Shaybah 18237","","","كتاب الجنة"
"18238","(۱۸۲۳۸) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : إذَا عَقَلَ الصَّبِیُّ الصَّلاَۃَ وَالصَّوْمَ ، فَطَلاَقُہُ جَائِزٌ۔ قَالَ : وَقَالَ الْحَسَنُ : لاَ یَجُوزُ طَلاَقُہُ حَتَّی یَحْتَلِمَ۔","","Musannaf Ibn Abi Shaybah 18238","","","كتاب الجنة"
"18239","(۱۸۲۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَمَّامٍ ، عَنْ قَتَادَۃَ ، عَنْ إسْمَاعِیلَ بْنِ عِمْرَانَ الْعَنْزِیّ ، قَالَ : طَلَّقْتُ وَأَنَا غُلاَمٌ لَمْ أَحْتَلِمْ ، فَسَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ ؟ فَقَالَ : إذَا حَفِظْتِ الصَّلاَۃَ وَصُمْتَ رَمَضَانَ ، فَقَدْ جَازَ طَلاَقُکَ۔","","Musannaf Ibn Abi Shaybah 18239","","","كتاب الجنة"
"18240","(۱۸۲۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مَالِکٍ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ عَنْ غُلاَمٍ طَلَّقَ ثَلاَثًا ؟ فَقَالَ : مَا أُرَاہُ إِذًا عَقلَ أَنَّ الثَّلاَثَ تُبِینُ أَنْ یَجْتَمِعَا۔","","Musannaf Ibn Abi Shaybah 18240","","","كتاب الجنة"
"18241","(۱۸۲۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَمَّنْ سَمِعَ عَلِیًّا یَقُولُ : اُکْتُمُوا الصِّبْیَانَ النِّکَاحَ۔","Da'if","Musannaf Ibn Abi Shaybah 18241","","","كتاب الجنة"
"18242","(۱۸۲۴۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَشْعَثَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمٍ ، عَنْ عَلِیٍّ ؛ بِنَحْوِ حَدِیثِ وَکِیعٍ۔","Da'if","Musannaf Ibn Abi Shaybah 18242","","","كتاب الجنة"
"18243","(۱۸۲۴۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : اُکْتُمُوا الصِّبْیَانَ النِّکَاحَ ، وَقَالَ : کُل طَلاَقٍ جَائِزٌ، إلاَّ طَلاَقَ الْمُبَرْسَمِ وَالْمَعْتُوہِ۔","","Musannaf Ibn Abi Shaybah 18243","","","كتاب الجنة"
"18244","(۱۸۲۴۴) حَدَّثَنَا أَبوُ بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَیْسَ عِتْقُ الصَّبِیِّ ، وَلاَ نِکَاحُہُ ، وَلاَ شَیْئٌ مِنْ أَمْرِہِ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 18244","","","كتاب الجنة"
"18245","(۱۸۲۴۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنِ الْقَعْقَاعِ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ عَنْ طَلاَقِ الصَّبِیِّ ؟ قَالَ : النِّسَائُ کَثِیرٌ۔","","Musannaf Ibn Abi Shaybah 18245","","","كتاب الجنة"
"18246","(۱۸۲۴۶) حَدَّثَنَا وَکِیعٌ ، حدَّثَنَا سُفْیَانُ ، عَنِ الْقَعْقَاعِ ، عَنْ إبْرَاہِیمَ ؛ فِی طَلاَقِ الصَّبِیِّ قَالَ : لَیْسَ بِشَیْئٍ ، وَالنِّسَائُ کَثِیرٌ۔","","Musannaf Ibn Abi Shaybah 18246","","","كتاب الجنة"
"18247","(۱۸۲۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یُزَوِّجُونَہُمْ وَہُمْ صِغَارٌ ، وَیَکْتُمُونَہُمُ النِّکَاحَ مَخَافَۃَ أَنْ یَقَعَ الطَّلاَقُ عَلَی أَلْسِنَتِہِمْ۔ قَالَ سُفْیَانُ : فَإِذَا وَقَعَ لَمْ یَرَوْہُ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 18247","","","كتاب الجنة"
"18248","(۱۸۲۴۸) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، عَنْ مُصْعَبٍ ، عَنِ الشَّعْبِیِّ ؛ فِی طَلاَقِ الصَّبِیِّ : لَیْسَ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 18248","","","كتاب الجنة"
"18249","(۱۸۲۴۹) حدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنْ طَلاَقِ الصَّبِیِّ ؟ فَقَالاَ : لاَ یَجُوزُ۔","","Musannaf Ibn Abi Shaybah 18249","","","كتاب الجنة"
"18250","(۱۸۲۵۰) حَدَّثَنَا إِسْمَاعِیِلُ بْنُ عُلَیَّۃَ ، عَنْ یُونُس ، قَالَ : حدَثَنِیِ رَجُلٌ مِنْ أَہْلِ الشَّامِ ، لَمْ أَرَ بِہِ بَأْسًا ، قَالَ : کُنَّا فِی غَزَاۃٍ ، فَبَرْسَمَ صَاحِبٌ لَنَا ، فَطلَّّقَ امْرَأَتَہُ ثَلاثَا ، فَلَمَا أفَاَقَ قَالُوا لَہُ : قُلْتَ کَذَا وَکذَا ، قَالَ : مَاَ أَعْلَمَنِی ، قُلْتُ : مِنْ ہَذَا قَلِیلاً ، وَلاَ کَثِیِرًا ، وَمَا أَعْرِفْہُ ، فَرَکِبَ رَجُلٌ مِنَّا إِلی عُمَرَ بْنُ عَبْدِ العَزِیزِ فِی حَاجَۃٍ ، فلَمَّا قضَی حَاجتَہُ سَأَلَہُ عَنْ ذَلِکَ ، فَدَیَّنَہُ۔","","Musannaf Ibn Abi Shaybah 18250","","","كتاب الجنة"
"18251","(۱۸۲۵۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ یُونُسَ ، عَنْ مَیْمُونِ بْنِ مَہْرَانِ ، عَنْ عُمَرَ بْنِ عَبْدِ العَزِیزِ ؛ بِنَحْوِ حَدِیثِ ابْنِ عُلَیَّۃَ ، عَنْ یُونُس۔","No Data Available","Musannaf Ibn Abi Shaybah 18251","","","كتاب الجنة"
"18252","(۱۸۲۵۲) حَدَّثَنَا أَبوُ مُعَاویَۃَ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَم ، قَالَ : کَانَ یَقُولُ : طَلاَقُ الْمُبَرْسَمِ وَالْمَحْمومِ الَّذِی یَہْذِی ، ونِکَاحُ الْمَجْنُونِ لَیْسَ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 18252","","","كتاب الجنة"
"18253","(۱۸۲۵۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : لاَ یَجُوزُ طَلاَق الْمُبَرْسَمِ ، وَالْمَغْلُوبِ عَلَی عَقْلِہِ فِی مَرَضِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 18253","","","كتاب الجنة"
"18254","(۱۸۲۵۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ؛ فِی طَلاَقِ الْمُبَرْسَمِ الَّذِی یَہْذِی وَلاَ یَعْقِلُ ، مَا یَقُولُ ، قَالَ : لاَ طَلاَقَ لَہُ ، وَلاَ عِتَاقَ لَہُ مَا دَام عَلَی ذَلِک۔","","Musannaf Ibn Abi Shaybah 18254","","","كتاب الجنة"
"18255","(۱۸۲۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِر ، عَنْ عَامِرٍ (ح) وَعَنْ شَرِیکٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالاَ : لاَ یَجُوز طَلاَق الْمُبَرْسَمِ۔","No Data Available","Musannaf Ibn Abi Shaybah 18255","","","كتاب الجنة"
"18256","(۱۸۲۵۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ زُہَیْرٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : لاَ یَجُوزُ طَلاَق الْمُبَرْسَمِ ، أَوْ مَنْ نَزلَ بِہِ بَلائٌ فِی غَیر نَشْوَی۔","","Musannaf Ibn Abi Shaybah 18256","","","كتاب الجنة"
"18257","(۱۸۲۵۷) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ حَمَّادِ بْنِ زَیْدٍ، عَنْ أَیُّوبَ، قَالَ: کَتَبْتُ إِلَی أَبِی قِلاَبَۃَ أَسْأَلَہُ عَنْ طَلاَقِ الْمُبَرْسَمِ؟ فَکَتَبَ إِلَیَّ : إِنَّہُ مَا شَہِدَتْ بِہِ الشُّہُودُ إِنْ کَانَ یَعْقِلُ فَطَلاَقُہُ جَائِزٌ ، وَإِنْ کَانَ لاَ یَعْقِلُ فَطَلاَقُہُ لاَ یَجُوزُ۔","","Musannaf Ibn Abi Shaybah 18257","","","كتاب الجنة"
"18258","(۱۸۲۵۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : طَلاَقُ السَّکْرَانِ جَائِزٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 18258","","","كتاب الجنة"
"18259","(۱۸۲۵۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ قَالَ : طَلاَقُ النَّشْوَانِ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 18259","","","كتاب الجنة"
"18260","(۱۸۲۶۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ لاَ یُجِیزُ طَلاَقَ السَّکْرَانِ۔","","Musannaf Ibn Abi Shaybah 18260","","","كتاب الجنة"
"18261","(۱۸۲۶۱) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ، عَنْ أَیُّوبَ، عَنِ الْحَسَنِ، وَمُحَمَّدٍ، أَنَّہُمَا قَالاَ: طَلاَقُہُ جَائِزٌ، وَیُوجَعُ ظَہْرُہُ۔","","Musannaf Ibn Abi Shaybah 18261","","","كتاب الجنة"
